import Mathlib
import Submission.Work.Mori.ExactStrength

/-!
# `Work.Mori.noNontrivialHomToCircle`

The target of this file: for `X` a connected, second countable, non-compact complex
one-manifold (a non-compact Riemann surface), vanishing of `Hom(π₁(X,x), ℝ)` forces vanishing of
`Hom(π₁(X,x), ℝ / 2πℤ)`.

The mathematical content is the classical theorem of Johansson that the fundamental group of a
connected non-compact surface is *free*: a free group with no non-trivial real character is
trivial.

This file isolates the *group theoretic* part of the reduction, which is where the work below
lives, and reduces the surface-theoretic input to the torsion-freeness of the abelianization
`H₁(X;ℤ) = π₁(X,x)^{ab}` (the "abelian half" of Johansson's theorem).

## Contents

* `real_baer` — `ℝ` satisfies Baer's criterion as a `ℤ`-module, i.e. *any* additive homomorphism
  from a subgroup of an abelian group into `ℝ` extends to the whole group.  Equivalently `ℝ` is
  divisible, hence injective, as a `ℤ`-module.
* `exists_addMonoidHom_real_of_infinite_order` — an element of infinite order of an abelian group
  is detected by some homomorphism to `ℝ`.
* `subsingleton_of_subsingleton_hom_real_of_torsionFree` — a torsion-free abelian group with no
  non-trivial homomorphism to `ℝ` is trivial.
* `subsingleton_abelianization_iff` / `subsingleton_additive_fundamentalGroup_of_abelianization` —
  homs out of `π₁` into an abelian group are homs out of its abelianization.
* the target `noNontrivialHomToCircle`, assembled from these and from the surface-theoretic
  statement `Work.Mori.torsionFree_abelianization_riemannSurface`.
-/

open Module

namespace Work.Mori

noncomputable section

/-! ## `ℝ` is injective as a `ℤ`-module -/

/-- **Baer's criterion for `ℝ` over `ℤ`.**  Since `ℤ` is a principal ideal domain, an ideal
`I ⊆ ℤ` is generated by a single element `n`; if `n ≠ 0` a linear map `I →ₗ[ℤ] ℝ` is determined by
its value at `n`, and that value can be divided by `n` because `ℝ` is divisible. -/
theorem real_baer : Module.Baer ℤ ℝ := by
  intro I g
  obtain ⟨n, hn⟩ := Submodule.IsPrincipal.principal I
  by_cases hn0 : n = 0
  · -- the ideal is trivial and `g` vanishes on it
    subst hn0
    refine ⟨0, ?_⟩
    intro x hx
    have hxI : x ∈ I := hx
    rw [hn] at hxI
    have hx0 : x = 0 := by
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hxI
      simpa using ha.symm
    subst hx0
    rw [show (⟨0, hx⟩ : I) = 0 from Subtype.ext rfl]
    exact (map_zero g).symm
  · -- `n ≠ 0`: extend by `x ↦ x * (g n) / n`
    have hnmem : n ∈ I := by
      rw [hn]
      exact Submodule.mem_span_singleton_self n
    have hnR : ((n : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hn0
    let c : ℝ := g ⟨n, hnmem⟩ / (n : ℝ)
    let φ : ℤ →+ ℝ :=
      { toFun := fun x => (x : ℝ) * c
        map_zero' := by simp
        map_add' := by intro x y; push_cast; ring }
    refine ⟨φ.toIntLinearMap, ?_⟩
    intro x hx
    show (x : ℝ) * c = g ⟨x, hx⟩
    have hxI : x ∈ I := hx
    rw [hn] at hxI
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hxI
    have hxsub : (⟨x, hx⟩ : I) = a • (⟨n, hnmem⟩ : I) := by
      apply Subtype.ext
      simpa [smul_eq_mul] using ha.symm
    have hgx : g ⟨x, hx⟩ = ((a : ℤ) : ℝ) * g ⟨n, hnmem⟩ := by
      calc g ⟨x, hx⟩ = g (a • (⟨n, hnmem⟩ : I)) := by rw [hxsub]
        _ = a • g ⟨n, hnmem⟩ := map_zsmul g a _
        _ = ((a : ℤ) : ℝ) * g ⟨n, hnmem⟩ := by rw [zsmul_eq_mul]
    have hkey : (x : ℝ) = (a : ℝ) * (n : ℝ) := by
      have ha' : a * n = x := by simpa [smul_eq_mul] using ha
      rw [← ha', Int.cast_mul]
    rw [hgx, hkey]
    change (a : ℝ) * (n : ℝ) * (g ⟨n, hnmem⟩ / (n : ℝ)) = (a : ℝ) * g ⟨n, hnmem⟩
    field_simp


/-! ## Detection of infinite order by homomorphisms to `ℝ` -/

/-- For an additive group, `n • a ≠ 0` for all `n ≠ 0` upgrades to the same statement for
integer multiples. -/
theorem zsmul_ne_zero_of_nsmul_ne_zero {A : Type*} [AddCommGroup A] {a : A}
    (h : ∀ n : ℕ, n ≠ 0 → n • a ≠ 0) : ∀ k : ℤ, k ≠ 0 → k • a ≠ 0 := by
  intro k hk hk0
  rcases lt_or_ge k 0 with hkneg | hkpos
  · have hkn : (-k).natAbs ≠ 0 := by simpa using (neg_ne_zero.mpr hk)
    have hpos : (0 : ℤ) ≤ -k := by omega
    have h1 : (-k).natAbs • a = 0 := by
      have h2 : (((-k).natAbs : ℕ) : ℤ) • a = 0 := by
        rw [Int.natAbs_of_nonneg hpos, neg_zsmul, hk0, neg_zero]
      simpa using h2
    exact h (-k).natAbs hkn h1
  · have hkn : k.natAbs ≠ 0 := by simpa using hk
    have h1 : k.natAbs • a = 0 := by
      have h2 : (((k.natAbs : ℕ)) : ℤ) • a = 0 := by
        rw [Int.natAbs_of_nonneg hkpos]
        exact hk0
      simpa using h2
    exact h k.natAbs hkn h1

/-- **An element of infinite order of an abelian group is detected by a homomorphism to `ℝ`.**

The subgroup generated by such an element is a copy of `ℤ`; mapping it to `ℝ` by `1 ↦ 1` and
extending along Baer's criterion (`real_baer`) gives the homomorphism. -/
theorem exists_addMonoidHom_real_of_zsmul_ne_zero {A : Type*} [AddCommGroup A] {a : A}
    (hinf : ∀ k : ℤ, k ≠ 0 → k • a ≠ 0) : ∃ ψ : A →+ ℝ, ψ a ≠ 0 := by
  let f : ℤ →+ A :=
    { toFun := fun k => k • a
      map_zero' := zero_zsmul a
      map_add' := fun x y => add_zsmul a x y }
  have hf : Function.Injective f := by
    intro x y hxy
    have hxy' : x • a = y • a := hxy
    have h : (x - y) • a = 0 := by rw [sub_smul, hxy', sub_self]
    by_contra hne
    exact hinf (x - y) (sub_ne_zero.mpr hne) h
  obtain ⟨ψ, hψ⟩ := Module.Baer.extension_property_addMonoidHom real_baer f hf
    (Int.castAddHom ℝ)
  refine ⟨ψ, ?_⟩
  have h1 : ψ (f 1) = ((1 : ℤ) : ℝ) := congrArg (fun u : ℤ →+ ℝ => u 1) hψ
  have hfa : f 1 = a := by simp [f]
  rw [hfa] at h1
  rw [h1]
  norm_num

/-- **A torsion-free abelian group with no non-trivial homomorphism to `ℝ` is trivial.** -/
theorem subsingleton_of_subsingleton_hom_real {A : Type*} [AddCommGroup A]
    (htf : ∀ (a : A) (n : ℕ), n ≠ 0 → n • a = 0 → a = 0)
    (h : Subsingleton (A →+ ℝ)) : Subsingleton A := by
  refine ⟨fun a b => ?_⟩
  by_contra hne
  have hne' : a - b ≠ 0 := sub_ne_zero.mpr hne
  have hnf : ∀ n : ℕ, n ≠ 0 → n • (a - b) ≠ 0 := fun n hn hn0 =>
    hne' (htf (a - b) n hn hn0)
  obtain ⟨ψ, hψ⟩ := exists_addMonoidHom_real_of_zsmul_ne_zero
    (zsmul_ne_zero_of_nsmul_ne_zero hnf)
  have hzero : ψ = 0 := Subsingleton.elim _ _
  rw [hzero] at hψ
  simpa using hψ

end

end Work.Mori
