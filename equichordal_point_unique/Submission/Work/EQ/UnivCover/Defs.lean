import Mathlib

/-!
# The universal cover of a Riemann surface: definitions

This file sets up the universal cover `UC x₀` of a topological space `X` (based at `x₀`) as the
type of points together with a homotopy class of paths from `x₀` to them, topologised by the
"sheets" over *disc-like* sets (open, path connected, simply connected sets).

The topology is defined as the topology generated by the sheets; the fact that the sheets form a
*topological basis* needs the hypothesis `HasDiscBasis X` (which holds for a Riemann surface).

The main objects are

* `Work.EQ.UnivCover.IsDiscLike V` — open, path connected, simply connected `V ⊆ X`;
* `Work.EQ.UnivCover.UC x₀` — the total space of the universal cover;
* `Work.EQ.UnivCover.UC.sheet e V` — the sheet of the cover over `V` through `e`;
* `Work.EQ.UnivCover.UC.segPt γ t` — the "initial segment" point of the cover over `γ t`.

Names: everything is in the namespace `Work.EQ.UnivCover`.
-/

open _root_.Topology
open scoped Topology

namespace Work.EQ.UnivCover

variable {X : Type*} [TopologicalSpace X]

/-- A *disc-like* subset of `X`: open, path connected, and simply connected (every loop in `V` is
null-homotopic).  Chart balls of a Riemann surface are disc-like; conversely these are exactly the
sets over which the sheets of the universal cover are trivial. -/
structure IsDiscLike (V : Set X) : Prop where
  isOpen : IsOpen V
  path_connected : ∀ ⦃x : X⦄, x ∈ V → ∀ ⦃y : X⦄, y ∈ V → ∃ γ : Path x y, ∀ t, γ t ∈ V
  simply_connected : ∀ ⦃x : X⦄, (hx : x ∈ V) → ∀ γ : Path x x, (∀ t, γ t ∈ V) →
    γ.Homotopic (Path.refl x)

/-- The disc-like sets of `X` form a neighbourhood basis of the topology.  Holds for every
`ChartedSpace ℂ X` (chart balls are disc-like). -/
def HasDiscBasis (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ (x : X) (U : Set X), IsOpen U → x ∈ U → ∃ V : Set X, IsDiscLike V ∧ x ∈ V ∧ V ⊆ U

/-- A countable cover of `X` by disc-like sets. -/
def DiscCover (U : ℕ → Set X) : Prop := (∀ n, IsDiscLike (U n)) ∧ (⋃ n, U n) = Set.univ

/-- `segTo γ t` is the initial segment of `γ`, a path from the start point of `γ` to `γ t`. -/
noncomputable def segTo {a b : X} (γ : Path a b) (t : unitInterval) : Path a (γ t) where
  toFun u := γ (u * t)
  continuous_toFun := γ.continuous.comp (by fun_prop)
  source' := by simp
  target' := by simp

/-- `segBetween γ s t` is the part of `γ` between the times `s` and `t`, a path from `γ s` to
`γ t`. -/
noncomputable def segBetween {a b : X} (γ : Path a b) (s t : unitInterval) : Path (γ s) (γ t) :=
  (segTo γ s).symm.trans (segTo γ t)

@[simp] theorem segTo_one {a b : X} (γ : Path a b) : segTo γ 1 = γ.cast rfl γ.target := by
  ext s
  simp [segTo]

theorem segTo_zero {a b : X} (γ : Path a b) : segTo γ 0 = (Path.refl a).cast rfl γ.source := by
  ext s
  simp [segTo]

variable {x₀ : X}

/-- A point of the universal cover of `X` based at `x₀`: a point `pt` of `X` together with a
homotopy class of paths from `x₀` to `pt`. -/
structure UC (x₀ : X) where
  pt : X
  cls : Path.Homotopic.Quotient x₀ pt

namespace UC

/-- The base point of the cover: the constant loop at `x₀`. -/
def base (x₀ : X) : UC x₀ := ⟨x₀, Path.Homotopic.Quotient.refl x₀⟩

/-- The projection of the universal cover to `X`. -/
abbrev proj (e : UC x₀) : X := e.pt

@[simp] theorem proj_pt (e : UC x₀) : UC.proj e = e.pt := rfl

/-- The *sheet* of the cover over a set `V` through a point `e`: all points of the cover lying
over `V` whose class is obtained from that of `e` by appending a path in `V`. -/
def sheet (e : UC x₀) (V : Set X) : Set (UC x₀) :=
  { e' | e'.pt ∈ V ∧ ∃ δ : Path e.pt e'.pt, (∀ t, δ t ∈ V) ∧
      e'.cls = e.cls.trans (Path.Homotopic.Quotient.mk δ) }

variable {e e' : UC x₀} {V : Set X}

theorem mem_sheet_iff :
    e' ∈ sheet e V ↔ e'.pt ∈ V ∧ ∃ δ : Path e.pt e'.pt, (∀ t, δ t ∈ V) ∧
      e'.cls = e.cls.trans (Path.Homotopic.Quotient.mk δ) := Iff.rfl

@[simp] theorem proj_base (x₀ : X) : (base x₀).proj = x₀ := rfl

@[simp] theorem pt_base (x₀ : X) : (base x₀).pt = x₀ := rfl

@[simp] theorem cls_base (x₀ : X) : (base x₀).cls = Path.Homotopic.Quotient.refl x₀ := rfl

theorem self_mem_sheet (heV : e.pt ∈ V) : e ∈ sheet e V := by
  refine ⟨heV, Path.refl e.pt, fun t => ?_, ?_⟩
  · simpa using heV
  · rw [Path.Homotopic.Quotient.mk_refl, Path.Homotopic.Quotient.trans_refl]

/-- **Monotonicity of the sheets**: a sheet over a subset is contained in the sheet over the
bigger set. -/
theorem sheet_mono {V V' : Set X} {e : UC x₀} (hV : V ⊆ V') (he : e' ∈ sheet e V) :
    e' ∈ sheet e V' := by
  obtain ⟨hv, δ, hδ, hcls⟩ := he
  exact ⟨hV hv, δ, fun t => hV (hδ t), hcls⟩

end UC

/-- The family of all sheets of the universal cover; this generates the topology of the cover. -/
def UC.basis (x₀ : X) : Set (Set (UC x₀)) :=
  { S | ∃ e : UC x₀, ∃ V : Set X, IsDiscLike V ∧ e.pt ∈ V ∧ S = UC.sheet e V }

noncomputable instance UC.instTopologicalSpace (x₀ : X) : TopologicalSpace (UC x₀) :=
  TopologicalSpace.generateFrom (UC.basis x₀)

/-- The "initial segment" point of the universal cover over `γ t`: the class of the initial
segment of `γ`. -/
noncomputable def UC.segPt {x : X} (γ : Path x₀ x) (t : unitInterval) : UC x₀ :=
  ⟨γ t, Path.Homotopic.Quotient.mk (segTo γ t)⟩

@[simp] theorem UC.segPt_pt {x : X} (γ : Path x₀ x) (t : unitInterval) :
    (UC.segPt γ t).pt = γ t := rfl

@[simp] theorem UC.segPt_cls {x : X} (γ : Path x₀ x) (t : unitInterval) :
    (UC.segPt γ t).cls = Path.Homotopic.Quotient.mk (segTo γ t) := rfl

end Work.EQ.UnivCover
