import Mathlib
import Submission.Work.EQ.DefsCore

/-!
# The torus `ℂ*/λ^ℤ` attached to the resonance ratio `λ`

Rychlik's proof of Theorem 11 (and of Theorem 8) uses the complex torus `ℂ*/λ^ℤ` obtained by
quotienting the multiplicative group `ℂ* = ℂˣ` by the cyclic subgroup generated by `λ`
(`λ = eqLam a ∈ (0,1)` in the equichordal problem).  The quotient map `ℂ* → ℂ*/λ^ℤ` is the
"shift modulo `σ`" map: a continuous path in `H0` whose `ψ₁`-coordinate has a limit modulo
`λ^ℤ` has a limit in `ℂ*`.

Here the parameter `λ` is called `l` (the symbol `λ` is reserved in Lean).  This file only sets
up the definitions; the topological facts live in companion modules
(`Work.EQ.TorusZ_isDiscrete`, `Work.EQ.TorusZ_compactSpace`, ...).
-/

namespace Work.EQ

open Filter _root_.Topology

/-- The unit of `ℂˣ` attached to a real number `l`; at `l = 0` (which is never used) it is the
junk value `1`. -/
noncomputable def lamU (l : ℝ) : ℂˣ :=
  if h : (l : ℂ) = 0 then 1 else Units.mk0 (l : ℂ) h

@[simp] theorem lamU_coe {l : ℝ} (hl : l ≠ 0) : ((lamU l : ℂˣ) : ℂ) = l := by
  rw [lamU, dif_neg (Complex.ofReal_ne_zero.mpr hl)]
  exact Units.val_mk0 _

/-- **The torus `ℂ*/λ^ℤ`**: the quotient of the group of nonzero complex numbers by the cyclic
subgroup generated by `l`. -/
abbrev TorusZ (l : ℝ) : Type := ℂˣ ⧸ Subgroup.zpowers (lamU l)

/-- The closed annulus `{z : r₁ ≤ ‖z‖ ≤ r₂}` of `ℂˣ`: the "fundamental region" used to
normalise the `l^ℤ`-orbit of a path. -/
def annulus (r₁ r₂ : ℝ) : Set ℂˣ := {z | r₁ ≤ ‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖ ≤ r₂}

@[simp] theorem mem_annulus {r₁ r₂ : ℝ} {z : ℂˣ} :
    z ∈ annulus r₁ r₂ ↔ r₁ ≤ ‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖ ≤ r₂ := Iff.rfl

end Work.EQ
