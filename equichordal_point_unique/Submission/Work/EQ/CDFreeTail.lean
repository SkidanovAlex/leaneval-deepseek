import Mathlib
import Submission.Work.EQ.CycleDefs
import Submission.Work.EQ.DefsCore
import Submission.Work.EQ.la_tail_bounds_free

/-! # The tail bound used by the assembly `Work.EQ.CDFree`

`cdf_tail_bound` is the `Work.EQ.tail_bound_of_words`-shaped tail bound over an annulus,
derived from `Work.EQ.la_tail_bound_seq` by taking the family of regular components to be a single
component (so the sequential statement `c k → c₀` is instantiated at the constant sequence `c₀`).

The source is `Work.EQ.la_tail_bound_seq_free`
(`Submission/Work/EQ/la_tail_bounds_free.lean`), the proof recorded by the project lead in
`la_tail_bounds_new.md`, which rests on `Work.EQ.descendant_of_unbounded_tails` only.  Switching to
another source is a matter of changing the import and the call below (the canonical
`Work.EQ.la_tail_bound_seq`, `Work.EQ.la_tail_bound_value`, `Work.EQ.tail_bound_of_words`).

This module is handwritten and is *not* regenerated by `_recopy_free.sh`. -/

namespace Work.EQ

open Complex Filter _root_.Topology

namespace CDFree

/-- **The tail bound over an annulus in the shape used by the assembly** (the statement of
`Work.EQ.tail_bound_of_words` with the extra normalisation `‖c₀‖ ≤ 2ρ*` for the component's value),
derived from `Work.EQ.la_tail_bound_seq`. -/
theorem cdf_tail_bound {a : ℝ} (ha0 : 0 < a) (ha1 : a < 1) {h : ℂ → ℂ} {r : ℝ}
    (hh : IsStableGerm a h r) (hpos : 0 < rhoStar a h) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ (r₁ r₂ : ℝ),
      0 < r₁ → r₁ < r₂ → r₂ < δ → r₂ / r₁ > 1 / eqLam a →
      ∀ (S : Set ChainData) (c₀ : ℂ), IsRegComp a h S c₀ → ‖c₀‖ ≤ 2 * rhoStar a h →
        (∀ c' : ℂ, (∃ μ₁ ∈ CharSet a h, ∃ μ₂ ∈ CharSet a h, (μ₁ ≠ 1 ∨ μ₂ ≠ 1) ∧
            ∃ T : Set ChainData, IsRegComp a h T (c₀ * μ₁ * μ₂)) → False) →
        ∃ M : ℕ, ∀ q ∈ S, q.2.1 ∈ Ann r₁ r₂ →
          (∀ n : ℕ, M ≤ n → q.1 (n : ℤ) = germC a h (((eqLam a : ℝ) : ℂ) ^ n * q.2.1)) ∧
          (∀ n : ℕ, M ≤ n → q.1 (-(n : ℤ)) = ugermC a h (((eqLam a : ℝ) : ℂ) ^ n * q.2.2)) := by
  obtain ⟨δ, hδ, hmain⟩ := la_tail_bound_seq_free (a := a) (h := h) (r := r) ha0 ha1 hh hpos
  refine ⟨δ, hδ, ?_⟩
  intro r₁ r₂ hr₁ hr₂ hr₂δ hratio S c₀ hS hbound hnd
  obtain ⟨φ, -, M, hM⟩ := hmain r₁ r₂ hr₁ hr₂ hr₂δ hratio c₀
    (fun μ₁ hμ₁ μ₂ hμ₂ hne T hT => hnd (c₀ * μ₁ * μ₂) ⟨μ₁, hμ₁, μ₂, hμ₂, hne, T, hT⟩)
    (fun _ => S) (fun _ => c₀) (fun _ => hS) (fun _ => hbound) tendsto_const_nhds
  exact ⟨M, fun q hq hqA => hM 0 q hq hqA⟩

end CDFree

end Work.EQ
