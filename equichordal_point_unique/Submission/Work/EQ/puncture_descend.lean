import Mathlib
import Submission.Work.EQ.branchPt_germ_stabiliser
import Submission.Work.EQ.branchPt_descend
import Submission.Work.EQ.branchPt_descend_hsep

namespace Work.EQ

/-- Primitive descent of the puncture branch of the path-limit step.

Let `c w = germC a h (λ ^ n₁ * w)` be analytic on `ball u R`, let `σ : Fin (n₁ + m₁) → Bool` be an
admissible sign sequence whose branch `Work.EQ.branchPt a c u R σ` covers the punctured disc of
radius `ρ'` with points of the small unstable germ curve, and let `c` have injective second
coordinate near `u`.

Then the germ stabiliser of the branch is `μ_d` for some `d ∣ 2 ^ (n₁ + m₁)`, generated by a
primitive `d`-th root of unity `ω`, and the branch descends along it: there is a family
`β : ℂ → Fin (n₁ + m₁ + 1) → ℂ × ℂ` on the punctured disc of radius `(rhoFin')^d` with

* `β` analytic there and meromorphic at `0` in every coordinate,
* `β (t ^ d) = branchPt σ t` on the branch disc,
* the steps of `β` are regular pairs, and its last entry is `c (u + s ^ (2 ^ (n₁ + m₁) / d))`,
* the descent has trivial rotational collisions: for `ω' ^ (2 ^ (n₁ + m₁) / d) = 1`, `ω' ≠ 1` there
  is a punctured disc on which `β (ω' t) ≠ β t`,
* the germ-curve constraint transfers with radius `(ρ') ^ d ≤ (rhoFin') ^ d`: on
  `0 < ‖s‖ < (ρ') ^ d` the point `β s 0` lies on the unstable germ curve with a nonzero witness in
  `ball 0 ρY`.

Route: `Work.EQ.branchPt_germ_stabiliser` gives `d`, `ω`, the invariance of the branch under `ω` on
the whole branch disc (`Work.EQ.germInv_full`) and the maximality of `d`; then
`Work.EQ.branchPt_descend` gives `β` with its analyticity, meromorphy, descent identity,
regularity and last entry; `Work.EQ.branchPt_descend_hsep` gives the collision separation; and the
germ-curve constraint for `β` follows from the one for `σ` by substituting a `d`-th root
`s = t ^ d` with `‖t‖ = ‖s‖ ^ (1/d) < ρ'`, using `β s 0 = branchPt σ t 0`.  The radius `(ρ') ^ d`
(rather than `(rhoFin') ^ d`) is exactly what this substitution gives, since `hcurve` is only
available below `ρ'`. -/
theorem puncture_descend {a : ℝ} (ha0 : 0 < a) (ha1 : a < 1) {h : ℂ → ℂ} {r : ℝ}
    (hh : Work.EQ.IsStableGerm a h r) {n₁ m₁ : ℕ} {u : ℂ} {R : ℝ} (hR : 0 < R)
    (hc : AnalyticOnNhd ℂ (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w))
      (Metric.ball u R))
    (hinj : ∃ δ : ℝ, 0 < δ ∧ Set.InjOn (fun w : ℂ =>
      ((fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) w).2)
        (Metric.ball u δ))
    {σ : Fin (n₁ + m₁) → Bool} (hσ : Work.EQ.Adm a
      (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R σ)
    {ρY : ℝ} {ρ' : ℝ} (hρ'pos : 0 < ρ') (hρ'le : ρ' ≤ Work.EQ.rhoFin' a
      (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R (n₁ + m₁))
    (hcurve : ∀ t : ℂ, 0 < ‖t‖ → ‖t‖ < ρ' →
      ∃ w : ℂ, w ∈ Metric.ball (0 : ℂ) ρY ∧ w ≠ 0 ∧
        Work.EQ.ugermC a h w = Work.EQ.branchPt a
          (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R σ t 0) :
    ∃ (d : ℕ) (_ : 0 < d) (_ : d ∣ 2 ^ (n₁ + m₁)) (ω : ℂ) (_ : ω ^ d = 1)
      (_ : ∀ m : ℕ, 0 < m → m < d → ω ^ m ≠ 1)
      (β : ℂ → Fin (n₁ + m₁ + 1) → ℂ × ℂ),
      (∀ j, AnalyticOnNhd ℂ (fun s => β s j)
        (Metric.ball (0 : ℂ) ((Work.EQ.rhoFin' a
          (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R
          (n₁ + m₁)) ^ d) \ {0})) ∧
      (∀ j, MeromorphicAt (fun s => β s j) 0) ∧
      (∀ t : ℂ, 0 < ‖t‖ → ‖t‖ < Work.EQ.rhoFin' a
          (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R (n₁ + m₁) →
        β (t ^ d) = Work.EQ.branchPt a
          (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R σ t) ∧
      (∀ s : ℂ, 0 < ‖s‖ → ‖s‖ < (Work.EQ.rhoFin' a
          (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R
          (n₁ + m₁)) ^ d →
        ∀ j : Fin (n₁ + m₁), Work.EQ.RegPair a (β s (Fin.castSucc j)) (β s (Fin.succ j))) ∧
      (∀ s : ℂ, 0 < ‖s‖ → ‖s‖ < (Work.EQ.rhoFin' a
          (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R
          (n₁ + m₁)) ^ d →
        β s (Fin.last (n₁ + m₁)) = (fun w : ℂ => Work.EQ.germC a h
          (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) (u + s ^ (2 ^ (n₁ + m₁) / d))) ∧
      (∀ ω' : ℂ, ω' ^ (2 ^ (n₁ + m₁) / d) = 1 → ω' ≠ 1 →
        ∃ δ : ℝ, 0 < δ ∧ δ ≤ (Work.EQ.rhoFin' a
            (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) u R
            (n₁ + m₁)) ^ d ∧
          ∀ t : ℂ, 0 < ‖t‖ → ‖t‖ < δ → β (ω' * t) ≠ β t) ∧
      (∀ s : ℂ, 0 < ‖s‖ → ‖s‖ < ρ' ^ d →
        ∃ w : ℂ, w ∈ Metric.ball (0 : ℂ) ρY ∧ w ≠ 0 ∧ Work.EQ.ugermC a h w = β s 0) := by
  classical
  set c : ℂ → ℂ × ℂ :=
    (fun w : ℂ => Work.EQ.germC a h (((Work.EQ.eqLam a : ℝ) : ℂ) ^ n₁ * w)) with hcdef
  -- Germ stabiliser: `d`, a primitive `d`-th root `ω`, full-disc invariance, maximality.
  obtain ⟨d, hd, hdvd, ω, hω, hprim, hinv, hmax⟩ :=
    Work.EQ.branchPt_germ_stabiliser hR hc hinj hσ
  -- Descent of the branch along `t ↦ t ^ d`.
  obtain ⟨β, han, hmer, hβ, hreg, hlast⟩ :=
    Work.EQ.branchPt_descend hR hc hσ hd hdvd hω hprim hinv
  -- Separation of rotational collisions.
  have hsep :=
    Work.EQ.branchPt_descend_hsep hR hc hd hdvd hω hprim hmax hinv han hmer hβ
  refine ⟨d, hd, hdvd, ω, hω, hprim, β, han, hmer, hβ, hreg, hlast, hsep, ?_⟩
  -- Germ-curve constraint, transported to the smaller radius `(ρ') ^ d`.
  intro s hs0 hslt
  obtain ⟨t, htd, ht0, htlt⟩ :=
    bp_root_aux hd hρ'pos (norm_ne_zero_iff.mp hs0.ne') hslt
  have htρ : ‖t‖ < Work.EQ.rhoFin' a c u R (n₁ + m₁) := lt_of_lt_of_le htlt hρ'le
  obtain ⟨w, hwball, hwne, hweq⟩ := hcurve t ht0 htlt
  refine ⟨w, hwball, hwne, ?_⟩
  rw [hweq, ← htd]
  exact (congrArg (fun f : Fin (n₁ + m₁ + 1) → ℂ × ℂ => f 0) (hβ t ht0 htρ)).symm

end Work.EQ
