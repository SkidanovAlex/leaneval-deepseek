import Mathlib
import Submission.Work.Modulus.Defs

namespace Work.Modulus

open Set Topology
open scoped Topology

/-- **The conjugate graph map is continuous.**

Let `X` be a complex one-manifold, `B ⊆ X` open, `F` holomorphic on `B` with `Re F = h` on `B`.
Then the graph map `u ↦ (u, Im (F u))` is continuous from `B` (with the subspace topology
inherited from `X`) to `X × ℝ` equipped with the topology `Submission.conjTopology h` generated by
the conjugate graphs of `h`.

Indeed, the preimage of a generator `conjGraph B' G` is the set
`{y ∈ B ∩ B' | Im G y = Im F y}`, which is open because `G - F` is holomorphic on `B ∩ B'` with
identically vanishing real part, hence has locally constant imaginary part
(`Submission.isOpen_setOf_im_sub_eq`). -/
theorem continuous_conjGraphMap
    {X : Type*} [TopologicalSpace X] [ChartedSpace ℂ X]
    [IsManifold (modelWithCornersSelf ℂ ℂ) 1 X]
    {h : X → ℝ} {B : Set X} {F : X → ℂ}
    (hB : IsOpen B) (hF : Submission.HolomorphicOnX F B)
    (hre : ∀ x ∈ B, (F x).re = h x) :
    @Continuous B (X × ℝ) _ (Submission.conjTopology h)
      (fun u : B => ((u : X), (F u).im)) := by
  rw [Submission.conjTopology, continuous_generateFrom_iff]
  intro s hs
  obtain ⟨B', G, hB', hG, hreG, rfl⟩ := hs
  have hopen : IsOpen {y : X | y ∈ B ∩ B' ∧ (G y).im - (F y).im = 0} :=
    Submission.isOpen_setOf_im_sub_eq hB hF hre hB' hG hreG 0
  have hset : (fun u : B => ((u : X), (F u).im)) ⁻¹' Submission.conjGraph B' G
      = Subtype.val ⁻¹' {y : X | y ∈ B ∩ B' ∧ (G y).im - (F y).im = 0} := by
    ext u
    simp only [Set.mem_preimage, Submission.conjGraph, Set.mem_ofPred_eq, Set.mem_inter_iff,
      sub_eq_zero]
    constructor
    · rintro ⟨huB', hEq⟩
      exact ⟨⟨u.2, huB'⟩, hEq.symm⟩
    · rintro ⟨⟨_, huB'⟩, hEq⟩
      exact ⟨huB', hEq.symm⟩
  rw [hset]
  exact hopen.preimage continuous_subtype_val

end Work.Modulus
