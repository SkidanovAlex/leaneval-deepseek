/-! ## Two general continuity lemmas -/

/-- **Continuity into a topology generated by a family of sets**: it suffices that the preimages of
the generators are open. -/
theorem continuous_generateFrom_of_isOpen_preimage {α Y : Type*} [TopologicalSpace α]
    {S : Set (Set Y)} {f : α → Y} (h : ∀ s ∈ S, IsOpen (f ⁻¹' s)) :
    @Continuous α Y _ (TopologicalSpace.generateFrom S) f := by
  rw [continuous_def]
  intro T hT
  induction hT with
  | basic s hs => exact h s hs
  | univ => rw [Set.preimage_univ]; exact isOpen_univ
  | inter s t _ _ ihs iht => rw [Set.preimage_inter]; exact ihs.inter iht
  | sUnion S' _ ih =>
      rw [Set.preimage_sUnion]
      exact isOpen_biUnion (fun t ht => ih t ht)

/-- **Continuity in the first variable of a map on a product whose second factor is discrete.** -/
theorem continuous_prod_of_forall_snd {α β γ : Type*} [TopologicalSpace α] [TopologicalSpace β]
    [TopologicalSpace γ] [DiscreteTopology β] {f : α → β → γ}
    (h : ∀ b : β, Continuous (fun a : α => f a b)) :
    Continuous (fun p : α × β => f p.1 p.2) := by
  rw [continuous_iff_continuousAt]
  rintro ⟨a₀, b₀⟩
  refine ((h b₀).continuousAt.comp continuous_fst.continuousAt).congr ?_
  filter_upwards [(isOpen_univ.prod (isOpen_discrete ({b₀} : Set β))).mem_nhds
    ⟨Set.mem_univ a₀, Set.mem_singleton b₀⟩] with p hp
  simp only [Set.mem_prod, Set.mem_singleton_iff] at hp
  simp only [Function.comp_apply, hp.2]

/-! ## Rigidity of the branches of the modulus -/

/-- The derivative in the preferred chart of a constant multiple of a holomorphic function. -/
theorem chartDeriv_const_mul {Φ : X → ℂ} {x : X} (hΦ : Submission.HolomorphicOnXAt Φ x)
    (c : ℂ) :
    Work.SC.chartDeriv (fun y => c * Φ y) x = c * Work.SC.chartDeriv Φ x := by
  rw [Work.SC.chartDeriv, Work.SC.chartDeriv]
  have hfun : (fun y : X => c * Φ y) ∘ (chartAt ℂ x).symm
      = fun w : ℂ => c * (Φ ∘ (chartAt ℂ x).symm) w := rfl
  rw [hfun, deriv_const_mul c hΦ.differentiableAt]

/-- The chart derivative only depends on the germ of the function. -/
theorem chartDeriv_congr_of_eventuallyEq {Φ Ψ : X → ℂ} {y : X} (h : Φ =ᶠ[𝓝 y] Ψ) :
    Work.SC.chartDeriv Φ y = Work.SC.chartDeriv Ψ y := by
  rw [Work.SC.chartDeriv, Work.SC.chartDeriv]
  have hsymm : (chartAt ℂ y).symm ((chartAt ℂ y) y) = y :=
    (chartAt ℂ y).left_inv (mem_chart_source ℂ y)
  have hcont : Filter.Tendsto (chartAt ℂ y).symm (𝓝 ((chartAt ℂ y) y)) (𝓝 y) := by
    have h' : Filter.Tendsto (chartAt ℂ y).symm (𝓝 ((chartAt ℂ y) y))
        (𝓝 ((chartAt ℂ y).symm ((chartAt ℂ y) y))) :=
      (chartAt ℂ y).continuousAt_symm ((chartAt ℂ y).map_source (mem_chart_source ℂ y))
    rwa [hsymm] at h'
  have h' : (Φ ∘ (chartAt ℂ y).symm) =ᶠ[𝓝 ((chartAt ℂ y) y)] (Ψ ∘ (chartAt ℂ y).symm) := by
    filter_upwards [hcont.eventually h] with w hw
    exact hw
  exact h'.deriv_eq

/-- A branch of the modulus multiplied by a constant of modulus one is again a branch. -/
theorem isModulusBranch_const_mul {z₀ : X} {E : X → ℝ} {U : Set X} {Φ : X → ℂ}
    (hΦ : Work.SC.IsModulusBranch z₀ E U Φ) {c : ℂ} (hc : ‖c‖ = 1) :
    Work.SC.IsModulusBranch z₀ E U (fun y => c * Φ y) := by
  obtain ⟨hUo, hhol, hne, hmod⟩ := hΦ
  refine ⟨hUo, fun y hy => (hhol y hy).const_mul c, ?_, ?_⟩
  · intro y hy hy0 h
    rcases mul_eq_zero.mp h with h | h
    · rw [h, norm_zero] at hc
      linarith
    · exact hne y hy hy0 h
  · intro y hy hy0
    rw [norm_mul, hmod y hy hy0, hc, one_mul]

/-- **Two branches of the modulus are proportional near an off-pole common point.**  The ratio of
two branches is holomorphic there and has constant modulus one, hence is locally constant. -/
theorem exists_ratio_eventually_of_isModulusBranch_of_ne {z₀ : X} {E : X → ℝ} {U V : Set X}
    {Φ Ψ : X → ℂ} (hΦ : Work.SC.IsModulusBranch z₀ E U Φ)
    (hΨ : Work.SC.IsModulusBranch z₀ E V Ψ) {y : X} (hy : y ∈ U ∩ V) (hy0 : y ≠ z₀) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ Ψ =ᶠ[𝓝 y] (fun x => c * Φ x) := by
  have hdiv : Submission.HolomorphicOnXAt (fun x => Ψ x / Φ x) y := by
    rw [Submission.HolomorphicOnXAt]
    have h1 : Submission.HolomorphicOnXAt Ψ y := hΨ.holomorphic y hy.2
    have h2 : Submission.HolomorphicOnXAt Φ y := hΦ.holomorphic y hy.1
    have h3 : Φ y ≠ 0 := hΦ.ne_zero y hy.1 hy0
    rw [Submission.HolomorphicOnXAt] at h1 h2
    have h3' : (Φ ∘ (chartAt ℂ y).symm) ((chartAt ℂ y) y) ≠ 0 := by
      rw [Function.comp_apply, (chartAt ℂ y).left_inv (mem_chart_source ℂ y)]
      exact h3
    have heq : (fun x : X => Ψ x / Φ x) ∘ (chartAt ℂ y).symm =
        (Ψ ∘ (chartAt ℂ y).symm) / (Φ ∘ (chartAt ℂ y).symm) := rfl
    rw [heq]
    exact h1.div h2 h3'
  have hmem : ∀ᶠ x in 𝓝 y, x ∈ U ∩ V ∧ x ≠ z₀ := by
    filter_upwards [hΦ.1.mem_nhds hy.1, hΨ.1.mem_nhds hy.2,
      (isOpen_compl_singleton (x := z₀)).mem_nhds (by simpa using hy0)] with x hxU hxV hxz
    exact ⟨⟨hxU, hxV⟩, by simpa using hxz⟩
  have hnorm : ∀ᶠ x in 𝓝 y, ‖Ψ x / Φ x‖ = ‖Ψ y / Φ y‖ := by
    filter_upwards [hmem] with x hx
    rw [norm_div, norm_div, hΨ.norm_eq x hx.1.2 hx.2, hΦ.norm_eq x hx.1.1 hx.2,
      hΨ.norm_eq y hy.2 hy0, hΦ.norm_eq y hy.1 hy0]
    simp
  have hev := Submission.HolomorphicOnXAt.eventually_eq_const_of_eventually_norm_eq hdiv hnorm
  refine ⟨Ψ y / Φ y, ?_, ?_⟩
  · rw [norm_div, hΨ.norm_eq y hy.2 hy0, hΦ.norm_eq y hy.1 hy0, div_self (Real.exp_ne_zero _)]
  · have hΦne' : ∀ᶠ x in 𝓝 y, Φ x ≠ 0 := by
      filter_upwards [hmem] with x hx
      exact hΦ.ne_zero x hx.1.1 hx.2
    filter_upwards [hev, hΦne'] with x hx hxne
    rw [← hx, div_mul_cancel₀ _ hxne]

/-- **Two branches of the modulus are proportional near any common point, the pole included.**  Off
the pole this is the local constancy of the ratio; at the pole we work in the chart at `z₀`, where
the two branches are analytic on a common ball and agree with a constant multiple of one another
near a non-pole point of that ball, so that the identity theorem applies. -/
theorem exists_ratio_eventually_of_isModulusBranch_at_pole {z₀ : X} {E : X → ℝ} {U V : Set X}
    {Φ Ψ : X → ℂ} (hΦ : Work.SC.IsModulusBranch z₀ E U Φ)
    (hΨ : Work.SC.IsModulusBranch z₀ E V Ψ) (hy : z₀ ∈ U ∩ V) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ Ψ =ᶠ[𝓝 z₀] (fun x => c * Φ x) := by
  set c := chartAt ℂ z₀ with hc
  set a : ℂ := c z₀ with ha
  have hsrc : z₀ ∈ c.source := mem_chart_source ℂ z₀
  have haT : a ∈ c.target := by rw [ha]; exact c.map_source hsrc
  have hsymm : c.symm a = z₀ := by rw [ha]; exact c.left_inv hsrc
  -- a chart ball around the pole lying inside `U ∩ V`
  have hpre : c.symm ⁻¹' (U ∩ V) ∈ 𝓝 a := by
    have hW : U ∩ V ∈ 𝓝 (c.symm a) := by
      rw [hsymm]
      exact inter_mem (hΦ.1.mem_nhds hy.1) (hΨ.1.mem_nhds hy.2)
    exact (c.continuousAt_symm haT).preimage_mem_nhds hW
  obtain ⟨ρ, hρ, hρsub⟩ :=
    Metric.mem_nhds_iff.mp (inter_mem (c.open_target.mem_nhds haT) hpre)
  -- a point `w₁` of the ball, different from `a`
  set w₁ : ℂ := a + ((ρ / 2 : ℝ) : ℂ) with hw₁def
  have hw₁ : w₁ ∈ Metric.ball a ρ := by
    rw [Metric.mem_ball, dist_eq_norm, hw₁def]
    have h1 : a + ((ρ / 2 : ℝ) : ℂ) - a = ((ρ / 2 : ℝ) : ℂ) := by ring
    rw [h1, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]
    linarith
  have hw₁ne : w₁ ≠ a := by
    intro h
    have h' : ((ρ / 2 : ℝ) : ℂ) = 0 := by
      have := congrArg (fun z : ℂ => z - a) h
      simpa [hw₁def] using this
    have : ρ / 2 = 0 := Complex.ofReal_injective h'
    linarith
  have hw₁T : w₁ ∈ c.target := (hρsub hw₁).1
  have hw₁U : c.symm w₁ ∈ U := (hρsub hw₁).2.1
  have hw₁V : c.symm w₁ ∈ V := (hρsub hw₁).2.2
  have hw₁ne' : c.symm w₁ ≠ z₀ := by
    intro h
    have h2 : c (c.symm w₁) = c z₀ := by rw [h]
    rw [c.right_inv hw₁T] at h2
    rw [← ha] at h2
    exact hw₁ne h2
  -- the off-pole statement at `c.symm w₁`
  obtain ⟨c₀, hc₀norm, hc₀⟩ :=
    exists_ratio_eventually_of_isModulusBranch_of_ne hΦ hΨ ⟨hw₁U, hw₁V⟩ hw₁ne'
  refine ⟨c₀, hc₀norm, ?_⟩
  -- two analytic functions on the ball, equal near `w₁`, hence equal by the identity theorem
  have hfana : AnalyticOnNhd ℂ (fun w : ℂ => Ψ (c.symm w)) (Metric.ball a ρ) := by
    intro w hw
    have hwT : w ∈ c.target := (hρsub hw).1
    have hvs : c.symm w ∈ c.source := c.map_target hwT
    have h1 : Submission.HolomorphicOnXAt Ψ (c.symm w) := hΨ.holomorphic _ (hρsub hw).2.2
    have h2 := (Submission.HolomorphicOnXAt_iff_chart (f := Ψ) (x := c.symm w) (y := z₀) hvs).mp h1
    rwa [c.right_inv hwT] at h2
  have hgana : AnalyticOnNhd ℂ (fun w : ℂ => c₀ * Φ (c.symm w)) (Metric.ball a ρ) := by
    intro w hw
    have hwT : w ∈ c.target := (hρsub hw).1
    have hvs : c.symm w ∈ c.source := c.map_target hwT
    have h1 : Submission.HolomorphicOnXAt (fun z => c₀ * Φ z) (c.symm w) :=
      Submission.HolomorphicOnXAt.const_mul c₀ (hΦ.holomorphic _ (hρsub hw).2.1)
    have h2 := (Submission.HolomorphicOnXAt_iff_chart (f := fun z => c₀ * Φ z)
      (x := c.symm w) (y := z₀) hvs).mp h1
    rwa [c.right_inv hwT] at h2
  have heq : (fun w : ℂ => Ψ (c.symm w)) =ᶠ[𝓝 w₁] (fun w : ℂ => c₀ * Φ (c.symm w)) := by
    filter_upwards [(c.continuousAt_symm hw₁T).eventually hc₀] with w hw
    exact hw
  have hEqOn := AnalyticOnNhd.eqOn_of_preconnected_of_eventuallyEq hfana hgana
    (Metric.isPreconnected_ball) hw₁ heq
  -- the chart ball is a neighbourhood of the pole, and the two functions agree on it
  refine mem_of_superset ((Submission.chartBall_isOpen c a ρ).mem_nhds ?_) ?_
  · rw [Submission.mem_chartBall]
    exact ⟨hsrc, by rw [ha]; simpa using hρ⟩
  · intro x hx
    rw [Submission.mem_chartBall] at hx
    have h := hEqOn hx.2
    simp only [c.left_inv hx.1] at h
    exact h

/-- **Two branches of the modulus are proportional near any common point.** -/
theorem exists_ratio_eventually_of_isModulusBranch {z₀ : X} {E : X → ℝ} {U V : Set X}
    {Φ Ψ : X → ℂ} (hΦ : Work.SC.IsModulusBranch z₀ E U Φ)
    (hΨ : Work.SC.IsModulusBranch z₀ E V Ψ) {y : X} (hy : y ∈ U ∩ V) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ Ψ =ᶠ[𝓝 y] (fun x => c * Φ x) := by
  by_cases hy0 : y = z₀
  · subst hy0
    exact exists_ratio_eventually_of_isModulusBranch_at_pole hΦ hΨ hy
  · exact exists_ratio_eventually_of_isModulusBranch_of_ne hΦ hΨ hy hy0

/-- **The pair (value, chart derivative) of one branch is proportional to that of another at a
common point.** -/
theorem exists_pair_eq_of_isModulusBranch {z₀ : X} {E : X → ℝ} {U V : Set X} {Φ Ψ : X → ℂ}
    (hΦ : Work.SC.IsModulusBranch z₀ E U Φ) (hΨ : Work.SC.IsModulusBranch z₀ E V Ψ)
    {y : X} (hy : y ∈ U ∩ V) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ Ψ y = c * Φ y ∧
      Work.SC.chartDeriv Ψ y = c * Work.SC.chartDeriv Φ y := by
  obtain ⟨c, hc, hev⟩ := exists_ratio_eventually_of_isModulusBranch hΦ hΨ hy
  refine ⟨c, hc, hev.eq_of_nhds, ?_⟩
  rw [Work.SC.chartDeriv, Work.SC.chartDeriv]
  have hsymm : (chartAt ℂ y).symm ((chartAt ℂ y) y) = y :=
    (chartAt ℂ y).left_inv (mem_chart_source ℂ y)
  have hcont : Filter.Tendsto (chartAt ℂ y).symm (𝓝 ((chartAt ℂ y) y)) (𝓝 y) := by
    have h : Filter.Tendsto (chartAt ℂ y).symm (𝓝 ((chartAt ℂ y) y))
        (𝓝 ((chartAt ℂ y).symm ((chartAt ℂ y) y))) :=
      (chartAt ℂ y).continuousAt_symm ((chartAt ℂ y).map_source (mem_chart_source ℂ y))
    rwa [hsymm] at h
  have hev' : (Ψ ∘ (chartAt ℂ y).symm) =ᶠ[𝓝 ((chartAt ℂ y) y)]
      ((fun z => c * Φ z) ∘ (chartAt ℂ y).symm) := by
    filter_upwards [hcont.eventually hev] with w hw
    exact hw
  rw [hev'.deriv_eq]
  have hfun : ((fun z : X => c * Φ z) ∘ (chartAt ℂ y).symm)
      = fun w : ℂ => c * (Φ ∘ (chartAt ℂ y).symm) w := rfl
  rw [hfun, deriv_const_mul c (hΦ.holomorphic y hy.1).differentiableAt]

/-- The model pair `(Φ₀ y, Φ₀'(y))` is non-zero as soon as the value or the derivative is. -/
theorem normSq_model_pos {Φ₀ : X → ℂ} {y : X}
    (hnd : Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0) :
    0 < Complex.normSq (Φ₀ y) + Complex.normSq (Work.SC.chartDeriv Φ₀ y) := by
  rcases hnd with h | h
  · have : 0 < Complex.normSq (Φ₀ y) := by
      rw [Complex.normSq_eq_norm_sq]
      exact pow_pos (norm_pos_iff.mpr h) 2
    have := Complex.normSq_nonneg (Work.SC.chartDeriv Φ₀ y)
    linarith
  · have : 0 < Complex.normSq (Work.SC.chartDeriv Φ₀ y) := by
      rw [Complex.normSq_eq_norm_sq]
      exact pow_pos (norm_pos_iff.mpr h) 2
    have := Complex.normSq_nonneg (Φ₀ y)
    linarith

/-- **The unit coordinate of a pair `(ζ, d)` with respect to the model `(Φ₀ y, Φ₀'(y))`**: the
orthogonal projection of the pair onto the complex line spanned by the (non-zero) model pair.  For
a pair proportional to the model pair it recovers the constant of proportionality. -/
noncomputable def pairCoord (Φ₀ : X → ℂ) (y : X) (ζ d : ℂ) : ℂ :=
  (ζ * (starRingEnd ℂ) (Φ₀ y) + d * (starRingEnd ℂ) (Work.SC.chartDeriv Φ₀ y)) /
    ((Complex.normSq (Φ₀ y) + Complex.normSq (Work.SC.chartDeriv Φ₀ y) : ℝ) : ℂ)

/-- The coordinate of a pair proportional to the model pair is the constant of proportionality. -/
theorem pairCoord_smul {Φ₀ : X → ℂ} {y : X} (hnd : Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    (c : ℂ) :
    pairCoord Φ₀ y (c * Φ₀ y) (c * Work.SC.chartDeriv Φ₀ y) = c := by
  have hpos := normSq_model_pos hnd
  have hne : ((Complex.normSq (Φ₀ y) + Complex.normSq (Work.SC.chartDeriv Φ₀ y) : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt hpos)
  rw [pairCoord]
  have hnum : (c * Φ₀ y) * (starRingEnd ℂ) (Φ₀ y)
        + (c * Work.SC.chartDeriv Φ₀ y) * (starRingEnd ℂ) (Work.SC.chartDeriv Φ₀ y)
      = c * ((Complex.normSq (Φ₀ y) + Complex.normSq (Work.SC.chartDeriv Φ₀ y) : ℝ) : ℂ) := by
    rw [mul_assoc, mul_assoc, Complex.mul_conj, Complex.mul_conj, ← mul_add,
      Complex.ofReal_add]
  rw [hnum, mul_div_cancel_right₀ c hne]

/-! ## A model branch on a chart ball -/

/-- Chart balls are monotone in the radius. -/
theorem chartBall_subset_of_le {c : OpenPartialHomeomorph X ℂ} {a : ℂ} {ρ ρ' : ℝ} (h : ρ ≤ ρ') :
    Submission.chartBall c a ρ ⊆ Submission.chartBall c a ρ' := by
  intro y hy
  rw [Submission.mem_chartBall] at hy ⊢
  exact ⟨hy.1, Metric.ball_subset_ball h hy.2⟩

/-- **Chart balls form a neighbourhood basis.** -/
theorem exists_chartBall_subset_of_mem_nhds {U : Set X} {x : X} (hU : U ∈ 𝓝 x) :
    ∃ ρ : ℝ, 0 < ρ ∧ Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ ⊆ U := by
  have hsrc : x ∈ (chartAt ℂ x).source := mem_chart_source ℂ x
  have hcont : Filter.Tendsto (chartAt ℂ x).symm (𝓝 ((chartAt ℂ x) x)) (𝓝 x) := by
    have h : Filter.Tendsto (chartAt ℂ x).symm (𝓝 ((chartAt ℂ x) x))
        (𝓝 ((chartAt ℂ x).symm ((chartAt ℂ x) x))) :=
      (chartAt ℂ x).continuousAt_symm ((chartAt ℂ x).map_source hsrc)
    rwa [(chartAt ℂ x).left_inv hsrc] at h
  obtain ⟨ρ, hρ, hρsub⟩ := Metric.mem_nhds_iff.mp (hcont.eventually hU)
  refine ⟨ρ, hρ, ?_⟩
  intro y hy
  rw [Submission.mem_chartBall] at hy
  have h1 : (chartAt ℂ x).symm ((chartAt ℂ x) y) ∈ U := hρsub hy.2
  rwa [(chartAt ℂ x).left_inv hy.1] at h1

/-- A chart ball around `x` avoiding the pole `z₀` (for `x ≠ z₀`). -/
theorem exists_chartBall_avoiding {z₀ x : X} (hx : x ≠ z₀) :
    ∃ ρ : ℝ, 0 < ρ ∧ ∀ y ∈ Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ, y ≠ z₀ := by
  by_cases hsrc : z₀ ∈ (chartAt ℂ x).source
  · have hne : (chartAt ℂ x) x ≠ (chartAt ℂ x) z₀ := fun h =>
      hx ((chartAt ℂ x).injOn hsrc (mem_chart_source ℂ x) h.symm).symm
    refine ⟨dist ((chartAt ℂ x) x) ((chartAt ℂ x) z₀) / 2,
      div_pos (dist_pos.mpr hne) two_pos, ?_⟩
    intro y hy hyz
    rw [Submission.mem_chartBall] at hy
    have h1 : (chartAt ℂ x) y ∈
        Metric.ball ((chartAt ℂ x) x) (dist ((chartAt ℂ x) x) ((chartAt ℂ x) z₀) / 2) := hy.2
    rw [hyz] at h1
    rw [Metric.mem_ball, dist_comm] at h1
    linarith [div_pos (dist_pos.mpr hne) two_pos]
  · refine ⟨1, one_pos, ?_⟩
    intro y hy hyz
    subst hyz
    exact hsrc hy.1

/-- **A model branch on a chart ball around the pole.**  The branch has a simple zero at `z₀`, so
its derivative there does not vanish and detects the branch. -/
theorem exists_isModulusBranch_chartBall_at_pole {z₀ : X} {E : X → ℝ}
    (hE : Work.UnitGreen.IsUnitGreenFunctionAt z₀ E) :
    ∃ (ρ : ℝ) (Φ : X → ℂ), 0 < ρ ∧
      Work.SC.IsModulusBranch z₀ E (Submission.chartBall (chartAt ℂ z₀) ((chartAt ℂ z₀) z₀) ρ) Φ ∧
      (∀ y ∈ Submission.chartBall (chartAt ℂ z₀) ((chartAt ℂ z₀) z₀) ρ,
        Φ y ≠ 0 ∨ Work.SC.chartDeriv Φ y ≠ 0) := by
  obtain ⟨U, Φ, hbr, hU, hpole⟩ :=
    Aux.exists_isModulusBranch_at_pole_of_unitGreen (z₀ := z₀) hE
  obtain ⟨ρ, hρ, hρsub⟩ := exists_chartBall_subset_of_mem_nhds hU
  refine ⟨ρ, Φ, hρ, hbr.mono (Submission.chartBall_isOpen _ _ _) hρsub, ?_⟩
  intro y hy
  by_cases hy0 : y = z₀
  · right
    subst hy0
    exact Submission.phi_deriv_ne_zero_of_logPole hpole
  · exact Or.inl (hbr.ne_zero y (hρsub hy) hy0)

/-- **A model branch on a chart ball around a point different from the pole.** -/
theorem exists_isModulusBranch_chartBall_off_pole {z₀ x : X} {E : X → ℝ}
    (hE : Work.UnitGreen.IsUnitGreenFunctionAt z₀ E) (hxne : x ≠ z₀) :
    ∃ (ρ : ℝ) (Φ : X → ℂ), 0 < ρ ∧
      Work.SC.IsModulusBranch z₀ E (Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ) Φ ∧
      (∀ y ∈ Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ,
        Φ y ≠ 0 ∨ Work.SC.chartDeriv Φ y ≠ 0) := by
  obtain ⟨U, Φ, hbr, hU, -⟩ :=
    Aux.exists_isModulusBranch_of_ne_of_unitGreen (z₀ := z₀) hE hxne
  obtain ⟨ρ₁, hρ₁, hρ₁sub⟩ := exists_chartBall_subset_of_mem_nhds hU
  obtain ⟨ρ₂, hρ₂, hρ₂sub⟩ := exists_chartBall_avoiding (x := x) (z₀ := z₀) hxne
  refine ⟨min ρ₁ ρ₂, Φ, lt_min hρ₁ hρ₂, ?_, ?_⟩
  · refine hbr.mono (Submission.chartBall_isOpen _ _ _) ?_
    intro y hy
    exact hρ₁sub (chartBall_subset_of_le (min_le_left _ _) hy)
  · intro y hy
    exact Or.inl (hbr.ne_zero y
      (hρ₁sub (chartBall_subset_of_le (min_le_left _ _) hy))
      (hρ₂sub y (chartBall_subset_of_le (min_le_right _ _) hy)))

/-- **A model branch on a chart ball around any point.** -/
theorem exists_isModulusBranch_chartBall {z₀ : X} {E : X → ℝ}
    (hE : Work.UnitGreen.IsUnitGreenFunctionAt z₀ E) (x : X) :
    ∃ (ρ : ℝ) (Φ : X → ℂ), 0 < ρ ∧
      Work.SC.IsModulusBranch z₀ E (Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ) Φ ∧
      (∀ y ∈ Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ,
        Φ y ≠ 0 ∨ Work.SC.chartDeriv Φ y ≠ 0) := by
  rcases eq_or_ne x z₀ with rfl | hxne
  · exact exists_isModulusBranch_chartBall_at_pole hE
  · exact exists_isModulusBranch_chartBall_off_pole hE hxne

/-- **Two branches with the same value and the same chart derivative at a common point agree near
it**, provided the pair of one of them is non-zero at that point. -/
theorem eventually_eq_of_pair_eq_of_isModulusBranch {z₀ : X} {E : X → ℝ} {Φ Ψ : X → ℂ}
    {U V : Set X}
    (hΦ : Work.SC.IsModulusBranch z₀ E U Φ) (hΨ : Work.SC.IsModulusBranch z₀ E V Ψ)
    {y : X} (hy : y ∈ U ∩ V) (hnd : Φ y ≠ 0 ∨ Work.SC.chartDeriv Φ y ≠ 0)
    (h1 : Φ y = Ψ y) (h2 : Work.SC.chartDeriv Φ y = Work.SC.chartDeriv Ψ y) :
    Φ =ᶠ[𝓝 y] Ψ := by
  obtain ⟨c, -, hev⟩ := exists_ratio_eventually_of_isModulusBranch hΦ hΨ hy
  have hcv : Ψ y = c * Φ y := hev.eq_of_nhds
  have hcd : Work.SC.chartDeriv Ψ y = c * Work.SC.chartDeriv Φ y := by
    rw [chartDeriv_congr_of_eventuallyEq hev, chartDeriv_const_mul (hΦ.holomorphic y hy.1) c]
  have hc1 : c = 1 := by
    rcases hnd with h | h
    · have h0 : Φ y = c * Φ y := h1.trans hcv
      have : (1 : ℂ) * Φ y = c * Φ y := by rw [one_mul]; exact h0
      exact (mul_right_cancel₀ h this).symm
    · have h0 : Work.SC.chartDeriv Φ y = c * Work.SC.chartDeriv Φ y := h2.trans hcd
      have : (1 : ℂ) * Work.SC.chartDeriv Φ y = c * Work.SC.chartDeriv Φ y := by
        rw [one_mul]; exact h0
      exact (mul_right_cancel₀ h this).symm
  have hev' : Ψ =ᶠ[𝓝 y] Φ := by simpa [hc1] using hev
  exact hev'.symm

/-- **The set where two branches have the same value and the same chart derivative is open**: it is
the set where they agree as germs. -/
theorem isOpen_setOf_pair_eq_of_isModulusBranch {z₀ : X} {E : X → ℝ} {Φ Ψ : X → ℂ}
    {U V : Set X}
    (hΦ : Work.SC.IsModulusBranch z₀ E U Φ) (hΨ : Work.SC.IsModulusBranch z₀ E V Ψ)
    (hnd : ∀ y ∈ U, Φ y ≠ 0 ∨ Work.SC.chartDeriv Φ y ≠ 0) :
    IsOpen {y : X | y ∈ U ∩ V ∧ Φ y = Ψ y ∧
      Work.SC.chartDeriv Φ y = Work.SC.chartDeriv Ψ y} := by
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨hyUV, h1, h2⟩
  have hev := eventually_eq_of_pair_eq_of_isModulusBranch hΦ hΨ hyUV (hnd y hyUV.1) h1 h2
  have hW : {x : X | x ∈ U ∩ V ∧ Φ x = Ψ x} ∈ 𝓝 y := by
    filter_upwards [hev, hΦ.1.mem_nhds hyUV.1, hΨ.1.mem_nhds hyUV.2] with x hx hxU hxV
    exact ⟨⟨hxU, hxV⟩, hx⟩
  obtain ⟨W, hWsub, hWopen, hyW⟩ := mem_nhds_iff.mp hW
  refine Filter.mem_of_superset (hWopen.mem_nhds hyW) ?_
  intro x hxW
  refine ⟨(hWsub hxW).1, (hWsub hxW).2, ?_⟩
  refine chartDeriv_congr_of_eventuallyEq ?_
  exact Filter.mem_of_superset (hWopen.mem_nhds hxW) (fun z hz => (hWsub hz).2)


/-! ## The discrete circle of labels -/

/-- The unit circle, with the **discrete** topology: the fibre of the branch bundle over a point.
It is a type synonym so that the discrete topology is carried by the type. -/
structure DiscCircle where
  /-- The underlying complex number. -/
  val : ℂ
  /-- The element lies on the unit circle. -/
  norm_val : ‖val‖ = 1

namespace DiscCircle

instance instTopologicalSpace : TopologicalSpace DiscCircle := ⊥

instance instDiscreteTopology : DiscreteTopology DiscCircle := ⟨rfl⟩

/-- Extensionality for the discrete circle. -/
theorem ext_iff {a b : DiscCircle} (h : a.val = b.val) : a = b := by
  cases a; cases b; simp_all

/-- The number of a label determines the label. -/
theorem eq_iff {a b : DiscCircle} : a = b ↔ a.val = b.val := by
  constructor
  · intro h; rw [h]
  · exact ext_iff

end DiscCircle

/-! ## The label of a branch germ relative to a model branch -/

/-- The label of a point of the branch bundle relative to a model branch `Φ₀`: the constant of
proportionality, recovered from the pair (value, chart derivative) at the base point. -/
def branchLabel (Φ₀ : X → ℂ) (p : X × ℂ × ℂ) : ℂ :=
  pairCoord Φ₀ p.1 p.2.1 p.2.2

/-- The canonical point of `X × ℂ × ℂ` over `y` with label `c`: the point of the graph of `c Φ₀`. -/
def canonPt (Φ₀ : X → ℂ) (y : X) (c : ℂ) : X × ℂ × ℂ :=
  (y, c * Φ₀ y, Work.SC.chartDeriv (fun z => c * Φ₀ z) y)

/-- The canonical point over `y ∈ B` with label `c` lies in the branch bundle. -/
theorem canonPt_mem {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀) {y : X} (hy : y ∈ B) {c : ℂ} (hc : ‖c‖ = 1) :
    canonPt Φ₀ y c ∈ Work.SC.branchSet z₀ E :=
  ⟨B, fun z => c * Φ₀ z, isModulusBranch_const_mul hbr hc, hy, rfl, rfl⟩

/-- The label of the canonical point with label `c` is `c`. -/
theorem branchLabel_canonPt {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀) {y : X} (hy : y ∈ B)
    (hnd : Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0) (c : ℂ) :
    branchLabel Φ₀ (canonPt Φ₀ y c) = c := by
  show pairCoord Φ₀ y (c * Φ₀ y) (Work.SC.chartDeriv (fun z => c * Φ₀ z) y) = c
  rw [chartDeriv_const_mul (hbr.holomorphic y hy) c]
  exact pairCoord_smul hnd c

/-- **The pair (value, chart derivative) at a point of `B` determines the branch**: every point of
the bundle whose base point lies in the model chart ball lies on the graph of the branch
`branchLabel Φ₀ p · Φ₀`. -/
theorem canonPt_eq_of_mem_branchSet {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    {p : X × ℂ × ℂ} (hp : p ∈ Work.SC.branchSet z₀ E) (hpb : p.1 ∈ B) :
    p = canonPt Φ₀ p.1 (branchLabel Φ₀ p) := by
  obtain ⟨V, Ψ, hbrΨ, hyV, hval, hder⟩ := hp
  obtain ⟨c, hc, hcv, hcd⟩ := exists_pair_eq_of_isModulusBranch hbr hbrΨ ⟨hpb, hyV⟩
  have hv : p.2.1 = c * Φ₀ p.1 := hval.trans hcv
  have hd : p.2.2 = c * Work.SC.chartDeriv Φ₀ p.1 := hder.trans hcd
  have hco : branchLabel Φ₀ p = c := by
    show pairCoord Φ₀ p.1 p.2.1 p.2.2 = c
    rw [hv, hd]
    exact pairCoord_smul (hnd p.1 hpb) c
  have h2 : p.2.1 = branchLabel Φ₀ p * Φ₀ p.1 := by rw [hco]; exact hv
  have h3 : p.2.2 = Work.SC.chartDeriv (fun z => branchLabel Φ₀ p * Φ₀ z) p.1 := by
    rw [chartDeriv_const_mul (hbr.holomorphic p.1 hpb) (branchLabel Φ₀ p), hco]
    exact hd
  exact Prod.ext rfl (Prod.ext h2 h3)

/-- The label of any point of the bundle over `B` has modulus one. -/
theorem norm_branchLabel {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    {p : X × ℂ × ℂ} (hp : p ∈ Work.SC.branchSet z₀ E) (hpb : p.1 ∈ B) :
    ‖branchLabel Φ₀ p‖ = 1 := by
  obtain ⟨V, Ψ, hbrΨ, hyV, hval, hder⟩ := hp
  obtain ⟨c, hc, hcv, hcd⟩ := exists_pair_eq_of_isModulusBranch hbr hbrΨ ⟨hpb, hyV⟩
  have hv : p.2.1 = c * Φ₀ p.1 := hval.trans hcv
  have hd : p.2.2 = c * Work.SC.chartDeriv Φ₀ p.1 := hder.trans hcd
  have hco : branchLabel Φ₀ p = c := by
    show pairCoord Φ₀ p.1 p.2.1 p.2.2 = c
    rw [hv, hd]
    exact pairCoord_smul (hnd p.1 hpb) c
  rw [hco]; exact hc

/-! ## The sheet of a model branch -/

/-- The sheet of the branch `c Φ₀`: the points of the modulus bundle whose triple lies on the graph
of `c Φ₀` over the model chart ball `B`. -/
def sheet {z₀ : X} {E : X → ℝ} (Φ₀ : X → ℂ) (B : Set X) (c : ℂ) :
    Set (Work.SC.ModulusBundle z₀ E) :=
  Subtype.val ⁻¹' Work.SC.branchGraph B (fun z => c * Φ₀ z)

/-- Membership in a sheet, unfolded. -/
theorem mem_sheet_iff {z₀ : X} {E : X → ℝ} {Φ₀ : X → ℂ} {B : Set X} {c : ℂ}
    {p : Work.SC.ModulusBundle z₀ E} :
    p ∈ sheet Φ₀ B c ↔ p.1.1 ∈ B ∧ p.1.2.1 = c * Φ₀ p.1.1 ∧
      p.1.2.2 = Work.SC.chartDeriv (fun z => c * Φ₀ z) p.1.1 := by
  rw [sheet, Set.mem_preimage, Work.SC.mem_branchGraph_iff]

/-- The sheet of a branch is open in the bundle. -/
theorem sheet_isOpen {z₀ : X} {E : X → ℝ} {Φ₀ : X → ℂ} {B : Set X}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀) {c : ℂ} (hc : ‖c‖ = 1) :
    @IsOpen (Work.SC.ModulusBundle z₀ E) (Work.SC.modulusBundleTopology z₀ E)
      (sheet (z₀ := z₀) (E := E) Φ₀ B c) := by
  letI : TopologicalSpace (X × ℂ × ℂ) := Work.SC.branchTopology z₀ E
  exact (TopologicalSpace.isOpen_generateFrom_of_mem (g := Work.SC.branchFamily z₀ E)
    ⟨B, fun z => c * Φ₀ z, isModulusBranch_const_mul hbr hc, rfl⟩).preimage
    continuous_subtype_val

/-- On the sheet of `c Φ₀`, the label is `c`. -/
theorem branchLabel_eq_of_mem_sheet {z₀ : X} {E : X → ℝ} {Φ₀ : X → ℂ} {B : Set X}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0) {c : ℂ}
    {p : Work.SC.ModulusBundle z₀ E} (hp : p ∈ sheet Φ₀ B c) :
    branchLabel Φ₀ p.1 = c := by
  obtain ⟨h1, h2, h3⟩ := mem_sheet_iff.mp hp
  show pairCoord Φ₀ p.1.1 p.1.2.1 p.1.2.2 = c
  rw [h2, h3, chartDeriv_const_mul (hbr.holomorphic p.1.1 h1) c]
  exact pairCoord_smul (hnd p.1.1 h1) c

/-- Every point of the bundle over `B` lies on the sheet of its own label. -/
theorem mem_sheet_label {z₀ : X} {E : X → ℝ} {Φ₀ : X → ℂ} {B : Set X}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    {p : Work.SC.ModulusBundle z₀ E} (hp : p.1.1 ∈ B) :
    p ∈ sheet Φ₀ B (branchLabel Φ₀ p.1) := by
  have h := canonPt_eq_of_mem_branchSet hbr hnd p.2 hp
  have h2 : p.1.2.1 = (canonPt Φ₀ p.1.1 (branchLabel Φ₀ p.1)).2.1 :=
    congrArg (fun t : X × ℂ × ℂ => t.2.1) h
  have h3 : p.1.2.2 = (canonPt Φ₀ p.1.1 (branchLabel Φ₀ p.1)).2.2 :=
    congrArg (fun t : X × ℂ × ℂ => t.2.2) h
  rw [mem_sheet_iff]
  refine ⟨hp, ?_, ?_⟩
  · show p.1.2.1 = branchLabel Φ₀ p.1 * Φ₀ p.1.1
    exact h2
  · show p.1.2.2 = Work.SC.chartDeriv (fun z => branchLabel Φ₀ p.1 * Φ₀ z) p.1.1
    exact h3

/-! ## The bundle-level label -/

/-- The label of a point of the modulus bundle relative to a model branch. -/
def pointLabel {z₀ : X} {E : X → ℝ} (Φ₀ : X → ℂ) (p : Work.SC.ModulusBundle z₀ E) : ℂ :=
  branchLabel Φ₀ p.1

theorem norm_pointLabel {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    {p : Work.SC.ModulusBundle z₀ E} (hp : p.1.1 ∈ B) : ‖pointLabel Φ₀ p‖ = 1 :=
  norm_branchLabel hbr hnd p.2 hp

theorem pointLabel_eq_of_mem_sheet {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0) {c : ℂ}
    {p : Work.SC.ModulusBundle z₀ E} (hp : p ∈ sheet Φ₀ B c) : pointLabel Φ₀ p = c :=
  branchLabel_eq_of_mem_sheet hbr hnd hp

theorem mem_sheet_pointLabel {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    {p : Work.SC.ModulusBundle z₀ E} (hp : p.1.1 ∈ B) :
    p ∈ sheet Φ₀ B (pointLabel Φ₀ p) :=
  mem_sheet_label hbr hnd hp

theorem canonPt_eq_pointLabel {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0)
    {p : Work.SC.ModulusBundle z₀ E} (hp : p.1.1 ∈ B) :
    p.1 = canonPt Φ₀ p.1.1 (pointLabel Φ₀ p) :=
  canonPt_eq_of_mem_branchSet hbr hnd p.2 hp

theorem pointLabel_canonPt {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀) {y : X} (hy : y ∈ B)
    (hnd : Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0) {c : ℂ} (hc : ‖c‖ = 1) :
    pointLabel Φ₀ (⟨canonPt Φ₀ y c, canonPt_mem hbr hy hc⟩ : Work.SC.ModulusBundle z₀ E) = c :=
  branchLabel_canonPt hbr hy hnd c

/-! ## Continuity of the graph of a branch over the model chart ball -/

/-- **The graph of a branch over the chart ball is continuous.**  Continuity into the topology
generated by the graphs of the branches is exactly the openness of the set where two branches have
the same value and the same chart derivative. -/
theorem continuous_canonPt {z₀ : X} {E : X → ℝ} {B : Set X} {Φ₀ : X → ℂ}
    (hbr : Work.SC.IsModulusBranch z₀ E B Φ₀)
    (hnd : ∀ y ∈ B, Φ₀ y ≠ 0 ∨ Work.SC.chartDeriv Φ₀ y ≠ 0) {c : ℂ} (hc : ‖c‖ = 1) :
    @Continuous ↥B (Work.SC.ModulusBundle z₀ E) _ (Work.SC.modulusBundleTopology z₀ E)
      (fun y => (⟨canonPt Φ₀ y.1 c, canonPt_mem hbr y.2 hc⟩ : Work.SC.ModulusBundle z₀ E)) := by
  letI : TopologicalSpace (X × ℂ × ℂ) := Work.SC.branchTopology z₀ E
  have hcne : c ≠ 0 := by
    intro h
    rw [h, norm_zero] at hc
    norm_num at hc
  have hamb : @Continuous ↥B (X × ℂ × ℂ) _ (Work.SC.branchTopology z₀ E)
      (fun y => canonPt Φ₀ y.1 c) := by
    refine continuous_generateFrom_of_isOpen_preimage (S := Work.SC.branchFamily z₀ E) ?_
    rintro s ⟨V, Ψ, hbrΨ, rfl⟩
    have hset : (fun y : ↥B => canonPt Φ₀ y.1 c) ⁻¹' Work.SC.branchGraph V Ψ
        = Subtype.val ⁻¹' {z : X | z ∈ B ∩ V ∧ (fun z => c * Φ₀ z) z = Ψ z ∧
            Work.SC.chartDeriv (fun z => c * Φ₀ z) z = Work.SC.chartDeriv Ψ z} := by
      ext y
      simp only [Set.mem_preimage, Set.mem_ofPred_eq, Set.mem_inter_iff, canonPt,
        Work.SC.mem_branchGraph_iff]
      constructor
      · rintro ⟨hyV, hv, hd⟩
        exact ⟨⟨y.2, hyV⟩, hv, hd⟩
      · rintro ⟨⟨hyB, hyV⟩, hv, hd⟩
        exact ⟨hyV, hv, hd⟩
    rw [hset]
    refine (isOpen_setOf_pair_eq_of_isModulusBranch (isModulusBranch_const_mul hbr hc) hbrΨ
      ?_).preimage continuous_subtype_val
    intro z hz
    rcases hnd z hz with h | h
    · exact Or.inl (mul_ne_zero hcne h)
    · exact Or.inr (by
        rw [chartDeriv_const_mul (hbr.holomorphic z hz) c]
        exact mul_ne_zero hcne h)
  exact hamb.subtype_mk (fun y => canonPt_mem hbr y.2 hc)

end Aux

end Work.Modulus.BranchCovering
