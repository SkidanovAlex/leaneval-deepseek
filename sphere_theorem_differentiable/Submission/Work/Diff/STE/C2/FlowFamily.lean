/-
# Layer C2 (DeTurck pull-back): the family of diffeomorphisms generated by a flow

`Work.Diff.STE.C2.flowData` produces the two-parameter flow `Φ` of the field `-W` on `[0,τ]`.  This
file packages the time-`t` slice `x ↦ Φ 0 t x` as a `Diffeomorph I I M M ∞` (its inverse is
`x ↦ Φ t 0 x`), and records the elementary consequences that the pull-back step needs:

* `flowFam_one` : the family at time `0` is the identity;
* `flowFam_apply` : `flowFam s x = Φ 0 s x`;
* `flowFam_mfderiv` : `mfderiv (flowFam s) x = mfderiv (fun y ↦ Φ 0 s y) x`;
* `flowFam_fst_smooth` : the map `(s,x) ↦ flowFam s x` is jointly smooth on `Ico 0 τ ×ˢ univ`
  (as a map, i.e. `ContMDiffOn (𝓘(ℝ,ℝ).prod I) I ∞`);
* `flowFam_vel` : the velocity of `s ↦ flowFam s x` is `-W t (Φ 0 t x)`.
-/
import Mathlib
import Submission.Diff.ODE
import Submission.Work.Diff.STE.C2.Kit

set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

open LeanEval.Geometry.SphereTheorem Submission.Diff Submission.Diff.Alg
open scoped Manifold ContDiff Bundle Topology
open Bundle ContDiff Set VectorField CovariantDerivative Metric

namespace Work.Diff.STE.C2

variable
  {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
    [IsManifold I ∞ M]

/-! ## The flow at a fixed time, as a diffeomorphism -/

/-- The bijection underlying the flow at time `t`: `x ↦ Φ 0 t x`, with inverse `y ↦ Φ t 0 y`. -/
noncomputable def flowEquiv (Φ : ℝ → ℝ → M → M) (t : ℝ)
    (h1 : ∀ x : M, Φ t 0 (Φ 0 t x) = x) (h2 : ∀ y : M, Φ 0 t (Φ t 0 y) = y) : M ≃ M where
  toFun := fun x ↦ Φ 0 t x
  invFun := fun y ↦ Φ t 0 y
  left_inv := h1
  right_inv := h2

@[simp] theorem flowEquiv_apply (Φ : ℝ → ℝ → M → M) (t : ℝ)
    (h1 : ∀ x : M, Φ t 0 (Φ 0 t x) = x) (h2 : ∀ y : M, Φ 0 t (Φ t 0 y) = y) (x : M) :
    flowEquiv Φ t h1 h2 x = Φ 0 t x := rfl

@[simp] theorem flowEquiv_symm_apply (Φ : ℝ → ℝ → M → M) (t : ℝ)
    (h1 : ∀ x : M, Φ t 0 (Φ 0 t x) = x) (h2 : ∀ y : M, Φ 0 t (Φ t 0 y) = y) (y : M) :
    (flowEquiv Φ t h1 h2).symm y = Φ t 0 y := rfl

/-- **The flow at time `t` as a diffeomorphism.** -/
noncomputable def flowDiffeo (Φ : ℝ → ℝ → M → M) (t : ℝ)
    (hsm : ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ x : M, Φ t 0 (Φ 0 t x) = x) (h2 : ∀ y : M, Φ 0 t (Φ t 0 y) = y) : Diffeomorph I I M M (⊤ : ℕ∞) :=
  Diffeomorph.mk (flowEquiv Φ t h1 h2) hsm hinv

@[simp] theorem flowDiffeo_apply (Φ : ℝ → ℝ → M → M) (t : ℝ)
    (hsm : ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ x : M, Φ t 0 (Φ 0 t x) = x) (h2 : ∀ y : M, Φ 0 t (Φ t 0 y) = y) (x : M) :
    flowDiffeo Φ t hsm hinv h1 h2 x = Φ 0 t x := rfl

/-! ## The family of diffeomorphisms -/

/-- **The family of diffeomorphisms generated by the flow `Φ` on `[0,τ]`**: at time `t ∈ Icc 0 τ`
it is `x ↦ Φ 0 t x`, and outside that interval it is the identity (a junk value never used). -/
noncomputable def flowFam (Φ : ℝ → ℝ → M → M) (τ : ℝ)
    (hsm : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t 0 (Φ 0 t x) = x)
    (h2 : ∀ t ∈ Icc 0 τ, ∀ y : M, Φ 0 t (Φ t 0 y) = y) : ℝ → Diffeomorph I I M M (⊤ : ℕ∞) :=
  fun t ↦ if ht : t ∈ Icc 0 τ then flowDiffeo Φ t (hsm t ht) (hinv t ht) (h1 t ht) (h2 t ht)
    else Diffeomorph.mk (Equiv.refl M) contMDiff_id contMDiff_id

theorem flowFam_apply (Φ : ℝ → ℝ → M → M) (τ : ℝ)
    (hsm : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t 0 (Φ 0 t x) = x)
    (h2 : ∀ t ∈ Icc 0 τ, ∀ y : M, Φ 0 t (Φ t 0 y) = y)
    {t : ℝ} (ht : t ∈ Icc 0 τ) (x : M) :
    flowFam Φ τ hsm hinv h1 h2 t x = Φ 0 t x := by
  simp only [flowFam, dif_pos ht, flowDiffeo_apply]

theorem flowFam_coe (Φ : ℝ → ℝ → M → M) (τ : ℝ)
    (hsm : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t 0 (Φ 0 t x) = x)
    (h2 : ∀ t ∈ Icc 0 τ, ∀ y : M, Φ 0 t (Φ t 0 y) = y)
    {t : ℝ} (ht : t ∈ Icc 0 τ) :
    ((flowFam Φ τ hsm hinv h1 h2 t : Diffeomorph I I M M (⊤ : ℕ∞)) : M → M)
      = fun x : M ↦ Φ 0 t x :=
  funext (flowFam_apply Φ τ hsm hinv h1 h2 ht)

/-- The family at time `0` is the identity, so `(flowFam ... 0) x = x`. -/
theorem flowFam_zero_apply (Φ : ℝ → ℝ → M → M) (τ : ℝ) (hτ : 0 < τ)
    (hsm : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (hdiag : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t t x = x)
    (h1 : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t 0 (Φ 0 t x) = x)
    (h2 : ∀ t ∈ Icc 0 τ, ∀ y : M, Φ 0 t (Φ t 0 y) = y)
    (x : M) :
    flowFam Φ τ hsm hinv h1 h2 0 x = x := by
  rw [flowFam_apply Φ τ hsm hinv h1 h2 ⟨le_rfl, hτ.le⟩ x]
  exact hdiag 0 ⟨le_rfl, hτ.le⟩ x

/-! ## Joint smoothness of the family, and the velocity -/

/-- **The family `(t,x) ↦ flowFam t x` is jointly smooth on `Ico 0 τ ×ˢ univ`.** -/
theorem flowFam_jointSmooth (Φ : ℝ → ℝ → M → M) (τ : ℝ) (hτ : 0 < τ)
    (hsm : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t 0 (Φ 0 t x) = x)
    (h2 : ∀ t ∈ Icc 0 τ, ∀ y : M, Φ 0 t (Φ t 0 y) = y)
    (hΦ : ContMDiffOn (((modelWithCornersSelf ℝ ℝ).prod (modelWithCornersSelf ℝ ℝ)).prod I) I (⊤ : ℕ∞)
      (fun q : (ℝ × ℝ) × M ↦ Φ q.1.1 q.1.2 q.2) ((Icc 0 τ ×ˢ Icc 0 τ) ×ˢ univ)) :
    ContMDiffOn ((modelWithCornersSelf ℝ ℝ).prod I) I (⊤ : ℕ∞)
      (fun q : ℝ × M ↦ flowFam Φ τ hsm hinv h1 h2 q.1 q.2) (Ico 0 τ ×ˢ univ) := by
  have hbase : ContMDiffOn ((modelWithCornersSelf ℝ ℝ).prod I) I (⊤ : ℕ∞)
      (fun q : ℝ × M ↦ Φ 0 q.1 q.2) (Ico 0 τ ×ˢ univ) := by
    have hinner : ContMDiff ((modelWithCornersSelf ℝ ℝ).prod I)
        (((modelWithCornersSelf ℝ ℝ).prod (modelWithCornersSelf ℝ ℝ)).prod I) (⊤ : ℕ∞)
        (fun q : ℝ × M ↦ (((0 : ℝ), q.1), q.2)) :=
      ContMDiff.prodMk (ContMDiff.prodMk contMDiff_const contMDiff_fst) contMDiff_snd
    have hmaps : MapsTo (fun q : ℝ × M ↦ (((0 : ℝ), q.1), q.2)) (Ico 0 τ ×ˢ univ)
        ((Icc 0 τ ×ˢ Icc 0 τ) ×ˢ univ) := by
      rintro ⟨s, x⟩ hs
      have hs' : s ∈ Ico 0 τ := hs.1
      simp only [Set.mem_prod, Set.mem_univ, Set.mem_Icc]
      exact ⟨⟨⟨le_rfl, hτ.le⟩, ⟨hs'.1, le_of_lt hs'.2⟩⟩, trivial⟩
    exact hΦ.comp hinner.contMDiffOn hmaps
  refine hbase.congr (fun q hq => ?_)
  exact flowFam_apply Φ τ hsm hinv h1 h2 ⟨hq.1.1, hq.1.2.le⟩ q.2

/-- **The velocity of the flow family**: `s ↦ flowFam s x` has derivative `-W t (Φ 0 t x)`. -/
theorem flowFam_vel (Φ : ℝ → ℝ → M → M) (W : ℝ → (x : M) → TangentSpace I x) (τ : ℝ) (hτ : 0 < τ)
    (hsm : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ 0 t x))
    (hinv : ∀ t ∈ Icc 0 τ, ContMDiff I I (⊤ : ℕ∞) (fun x : M ↦ Φ t 0 x))
    (h1 : ∀ t ∈ Icc 0 τ, ∀ x : M, Φ t 0 (Φ 0 t x) = x)
    (h2 : ∀ t ∈ Icc 0 τ, ∀ y : M, Φ 0 t (Φ t 0 y) = y)
    (hvel : ∀ s ∈ Icc 0 τ, ∀ t ∈ Icc 0 τ, ∀ x : M,
      HasMFDerivWithinAt (modelWithCornersSelf ℝ ℝ) I (fun τ' ↦ Φ s τ' x) (Icc 0 τ) t
        ((1 : ℝ →L[ℝ] ℝ).smulRight (-(W t (Φ s t x)))))
    {t : ℝ} (ht : t ∈ Icc 0 τ) (x : M) :
    HasMFDerivWithinAt (modelWithCornersSelf ℝ ℝ) I (fun s ↦ flowFam Φ τ hsm hinv h1 h2 s x)
      (Ico 0 τ) t ((1 : ℝ →L[ℝ] ℝ).smulRight (-(W t (Φ 0 t x)))) := by
  have hmem : t ∈ Icc 0 τ := ht
  have hev : (fun s ↦ flowFam Φ τ hsm hinv h1 h2 s x)
      =ᶠ[𝓝[Ico 0 τ] t] (fun s ↦ Φ 0 s x) := by
    filter_upwards [self_mem_nhdsWithin] with s hs
    exact flowFam_apply Φ τ hsm hinv h1 h2 ⟨hs.1, hs.2.le⟩ x
  refine ((hvel 0 ⟨le_rfl, hτ.le⟩ t hmem x).mono Ico_subset_Icc_self).congr_of_eventuallyEq ?_ ?_
  · exact hev
  · rw [flowFam_apply Φ τ hsm hinv h1 h2 hmem x]

end Work.Diff.STE.C2
