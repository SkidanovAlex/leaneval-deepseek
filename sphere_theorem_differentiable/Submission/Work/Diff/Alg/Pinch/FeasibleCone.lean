import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The feasible cone of a convex set at a point

For a convex set `F` in a real normed space and a point `x ∈ F`, the *feasible cone* at `x` is the
set of directions along which one can move from `x` into `F` for a short time:

`feasibleCone F x = {d | ∃ s > 0, x + s • d ∈ F}`.

For convex `F ∋ x` this is a convex cone, and it coincides with the cone `⋃_{t ≥ 0} t • (F - x)`
generated by the difference set `F - x`.  The elementary properties proved here are used by
`Work.Diff.Alg.Pinch.mem_closure_feasibleCone_of_supporting` (the supporting-hyperplane condition
forces `Q x` into the *closed* feasible cone) and by
`Work.Diff.Alg.Pinch.infDist_add_smul_le_of_supporting` (a feasible direction gives a nearby point
of `F`, whence a bound on the distance of `x + h v` to `F`).
-/

namespace Work.Diff.Alg.Pinch

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The feasible cone of `F` at `x`: the directions `d` for which `x + s • d ∈ F` for some `s > 0`.
For convex `F` containing `x` this is the cone generated by `F - x`. -/
def feasibleCone (F : Set E) (x : E) : Set E :=
  {d : E | ∃ s : ℝ, 0 < s ∧ x + s • d ∈ F}

lemma mem_feasibleCone {F : Set E} {x d : E} :
    d ∈ feasibleCone F x ↔ ∃ s : ℝ, 0 < s ∧ x + s • d ∈ F := Iff.rfl

/-- `0` is a feasible direction at any point of `F`. -/
lemma zero_mem_feasibleCone {F : Set E} {x : E} (hx : x ∈ F) : (0 : E) ∈ feasibleCone F x :=
  ⟨1, one_pos, by simpa using hx⟩

/-- For `y ∈ F`, the direction `y - x` is feasible at `x`. -/
lemma sub_mem_feasibleCone {F : Set E} {x y : E} (hy : y ∈ F) : y - x ∈ feasibleCone F x :=
  ⟨1, one_pos, by simpa using hy⟩

/-- The feasible cone is closed under multiplication by nonnegative scalars. -/
lemma feasibleCone_smul_mem {F : Set E} {x d : E} (hx : x ∈ F) (hd : d ∈ feasibleCone F x)
    {c : ℝ} (hc : 0 ≤ c) : c • d ∈ feasibleCone F x := by
  rcases eq_or_lt_of_le hc with h | h
  · subst h
    simpa using zero_mem_feasibleCone hx
  · obtain ⟨s, hs, hsd⟩ := hd
    refine ⟨s / c, div_pos hs h, ?_⟩
    have hsc : s / c * c = s := by field_simp
    rw [smul_smul, hsc]
    exact hsd

/-- Scaling a feasible direction down keeps one inside `F`. -/
lemma feasibleCone_smul_le_mem {F : Set E} (hFcv : Convex ℝ F) {x d : E} (hx : x ∈ F)
    {s s' : ℝ} (hs' : 0 < s') (hs : 0 ≤ s) (hss' : s ≤ s') (hm : x + s' • d ∈ F) :
    x + s • d ∈ F := by
  have hc0 : 0 ≤ s / s' := div_nonneg hs hs'.le
  have hc1 : s / s' ≤ 1 := (div_le_one hs').mpr hss'
  have hid : x + s • d = (1 - s / s') • x + (s / s') • (x + s' • d) := by
    have h : s / s' * s' = s := by field_simp
    rw [smul_add, smul_smul, h]
    module
  rw [hid]
  exact hFcv hx hm (by linarith) hc0 (by ring)

/-- The feasible cone of a convex set is convex. -/
lemma convex_feasibleCone {F : Set E} (hFcv : Convex ℝ F) {x : E} (hx : x ∈ F) :
    Convex ℝ (feasibleCone F x) := by
  intro d1 hd1 d2 hd2 a b ha hb hab
  obtain ⟨s1, hs1, h1⟩ := hd1
  obtain ⟨s2, hs2, h2⟩ := hd2
  have hmin : 0 < min s1 s2 := lt_min hs1 hs2
  have h1' : x + min s1 s2 • d1 ∈ F :=
    feasibleCone_smul_le_mem hFcv hx hs1 hmin.le (min_le_left _ _) h1
  have h2' : x + min s1 s2 • d2 ∈ F :=
    feasibleCone_smul_le_mem hFcv hx hs2 hmin.le (min_le_right _ _) h2
  refine ⟨min s1 s2, hmin, ?_⟩
  have hid : a • (x + min s1 s2 • d1) + b • (x + min s1 s2 • d2)
      = x + min s1 s2 • (a • d1 + b • d2) := by
    have key : a • (x + min s1 s2 • d1) + b • (x + min s1 s2 • d2)
        = (a + b) • x + min s1 s2 • (a • d1 + b • d2) := by module
    rw [key, hab, one_smul]
  rw [← hid]
  exact hFcv h1' h2' ha hb hab

end Work.Diff.Alg.Pinch
