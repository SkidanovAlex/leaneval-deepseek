import Mathlib
import Submission.Work.DSMap.Map
import Submission.Work.DSPB1.Basic

/-!
# `p ∈ (ϖ_k)` for a perfectoid datum

For a perfectoid-datum `P : DSMap.PerfectoidData p C` the pseudo-uniformizer `ϖ_k` is a
`p`-power root tower of `ϖ_0`, and `ϖ_0 ^ p = p * v` for a unit `v` (`P.unit`).  Hence
`p = ϖ_0 ^ p * v⁻¹` lies in the principal ideal generated by `ϖ_0`, and since
`ϖ_0 = ϖ_k ^ (p ^ k)` the ideal `(ϖ_0)` is contained in `(ϖ_k)`; so `p ∈ (ϖ_k)` for every
level `k`.

This is the `PB1`-adjacent statement that the ideal `(ϖ_k)` is all of the "`p`-part" of `C`,
used to switch between the `p`-adic and the `ϖ`-adic topologies.
-/

namespace Work.DSPB1.Varpi

/-- `p` lies in the principal ideal generated by any pseudo-uniformizer `ϖ_k`. -/
theorem p_mem_span_varpi {p : ℕ} [Fact p.Prime] {C : Type*} [CommRing C]
    (P : DSMap.PerfectoidData p C) (k : ℕ) : (p : C) ∈ Ideal.span {P.ϖ k} := by
  obtain ⟨v, hv⟩ := P.unit
  have hp0 : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  -- `ϖ_0 = ϖ_k ^ (p ^ k)`, so `ϖ_k ∣ ϖ_0 ^ p`.
  have hroot : P.ϖ 0 = P.ϖ k ^ (p ^ k) := (Work.DSPB1.varpi_pow_iterate_zero P k).symm
  have hdiv : P.ϖ k ∣ P.ϖ 0 ^ p := by
    rw [hroot, ← pow_mul]
    exact dvd_pow_self _ (mul_ne_zero (pow_ne_zero _ hp0) hp0)
  have hpow : P.ϖ 0 ^ p ∈ Ideal.span {P.ϖ k} := Ideal.mem_span_singleton.mpr hdiv
  have hmem : P.ϖ 0 ^ p * ↑(v⁻¹) ∈ Ideal.span {P.ϖ k} :=
    Ideal.mul_mem_right (↑(v⁻¹)) _ hpow
  -- `p = ϖ_0 ^ p * v⁻¹` because `v` is a unit and `ϖ_0 ^ p = p * v`.
  have hp : (p : C) = P.ϖ 0 ^ p * ↑(v⁻¹) := by
    rw [hv, mul_assoc, Units.mul_inv, mul_one]
  rw [hp]
  exact hmem

end Work.DSPB1.Varpi
