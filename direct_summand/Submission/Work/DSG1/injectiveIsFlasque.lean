import Mathlib
import Submission.Work.DSG1.Basic

namespace Work.DSG1

open CategoryTheory AlgebraicGeometry Limits

universe u

/-!
# Injective sheaves of `O_X`-modules are flasque

The goal of this file is `Work.DSG1.injectiveIsFlasque`: an injective object of the category
`X.Modules = SheafOfModules X.ringCatSheaf` of sheaves of `O_X`-modules on a scheme `X` has
flasque (flabby) underlying sheaf of abelian groups, i.e. all its restriction maps
`M(U) ⟶ M(V)` (`V ≤ U`) are surjective.

## The mathematics

For `V ≤ U` open subsets of `X` and `s ∈ M(V)` one must produce `t ∈ M(U)` restricting to `s`.
The extension is obtained by testing the injectivity of `M` against a monomorphism of sheaves of
`O_X`-modules. Recall that an object `M` is injective precisely when every morphism `A ⟶ M`
with `A ↪ B` a monomorphism extends to `B ⟶ M`.

The relevant pair is `R_V ↪ R_U`, where `R_W` denotes the sheaf of `O_X`-modules obtained from the
structure sheaf by extension by zero from `W` (this is `j_!O_W` for the open immersion
`j : W ↪ X`). Its characteristic property is

`Hom_{O_X}(R_W, N) ≅ Γ(W, N)`   (`sectionsEquiv` below),

so that the restriction map `M(U) ⟶ M(V)` is (the `Hom`-functor applied to) the natural
comparison map `R_V ⟶ R_U`. Since `R_V ⟶ R_U` is a monomorphism and `M` is injective, every
element of `Hom(R_V, M) ≅ M(V)` extends to `Hom(R_U, M) ≅ M(U)`, which is exactly flasqueness.

## Implementation

Mathlib does not construct `j_!O_W`; we obtain it as
`R_W = PresheafOfModules.freeObj (yoneda.obj W)`, the free presheaf of `O_X`-modules generated by
the representable presheaf of sets `Hom(-, W)`. Its defining property is the composite

`Hom(R_W, N) ≃ (yoneda.obj W ⟶ N.presheaf) ≃ N.presheaf.obj (op W)`

of `PresheafOfModules.freeHomEquiv` (the free/forgetful adjunction, `freeAdjunction`) with the
Yoneda lemma for presheaves of types, see `sectionsEquiv`. (The comparison map is called
`restrMap`; note that the injectivity argument takes place in *presheaves* of modules — this is
legitimate because the forgetful functor `SheafOfModules R ⤳ PresheafOfModules R.obj` is a right
adjoint, hence preserves injective objects: Mathlib's `Adjunction.map_injective` applied to the
sheafification adjunction.)

The monomorphism `R_V ⟶ R_U` is `free.map (yoneda.map (homOfLE h))`: a monomorphism of presheaves
of *types* induces a monomorphism of free presheaves of modules because `free` is computed
componentwise by `ModuleCat.free`, and the free module functor sends injective maps of types to
injective maps of modules (the free module on a subset is a direct summand of the free module on
the superset). Everything reduces to `Finsupp.mapDomain_injective`.
-/

namespace InjectiveIsFlasqueAux

open Opposite TopologicalSpace

variable {X : Scheme.{u}}

/-- The free presheaf of `O_X`-modules on a presheaf of types. -/
noncomputable abbrev freeF : ((Opens X)ᵒᵖ ⥤ Type u) ⥤ PresheafOfModules.{u} X.ringCatSheaf.obj :=
  PresheafOfModules.free (R := X.ringCatSheaf.obj)

/-- The free `R`-module functor sends injective maps of types to injective maps of modules: the
free module on a subset is a direct summand of the free module on the whole set. -/
lemma free_map_injective {R : Type u} [Ring R] {α β : Type u} (f : α ⟶ β)
    (hf : Function.Injective (ConcreteCategory.hom f)) :
    Function.Injective ⇑(ConcreteCategory.hom ((ModuleCat.free R).map f)) := by
  have h : ⇑(ConcreteCategory.hom ((ModuleCat.free R).map f))
      = Finsupp.mapDomain (ConcreteCategory.hom f) := by
    funext m
    rw [show (ModuleCat.free R).map f
      = ModuleCat.ofHom (Finsupp.lmapDomain R R (ConcreteCategory.hom f)) from rfl]
    exact Finsupp.lmapDomain_apply R R (ConcreteCategory.hom f) m
  rw [h]
  exact Finsupp.mapDomain_injective hf

/-- A monomorphism of presheaves of types induces a monomorphism of the associated free presheaves
of modules. -/
lemma free_map_mono {F G : (Opens X)ᵒᵖ ⥤ Type u} (ψ : F ⟶ G)
    (hψ : ∀ W, Function.Injective (ConcreteCategory.hom (ψ.app W))) : Mono (freeF.map ψ) := by
  refine PresheafOfModules.mono_of_injective fun W => ?_
  exact free_map_injective (ψ.app W) (hψ W)

/-- The canonical comparison `R_V ⟶ R_U` for `V ≤ U` (extension by zero of the inclusion
`Hom(-,V) ⟶ Hom(-,U)`). -/
noncomputable def restrMap {U V : Opens X} (h : V ≤ U) :
    (freeF.obj (yoneda.obj V)) ⟶ (freeF.obj (yoneda.obj U)) :=
  freeF.map (yoneda.map (homOfLE h))

/-- The comparison `R_V ⟶ R_U` is a monomorphism (a map of presheaves of types induced by
`V ≤ U` is injective on every open). -/
lemma mono_restrMap {U V : Opens X} (h : V ≤ U) : Mono (restrMap h) := by
  refine free_map_mono _ fun W => ?_
  haveI : Subsingleton ((yoneda.obj V).obj W) := inferInstanceAs (Subsingleton (W.unop ⟶ V))
  exact fun a b _ => Subsingleton.elim a b

/-- **The universal property of `R_U`.** Morphisms from the free module `R_U` on the representable
presheaf `Hom(-,U)` to a presheaf of modules `A` are the sections of `A` over `U`. -/
noncomputable def sectionsEquiv (A : PresheafOfModules.{u} X.ringCatSheaf.obj) (U : Opens X) :
    (PresheafOfModules.freeObj (yoneda.obj U) ⟶ A) ≃ A.presheaf.obj (op U) :=
  PresheafOfModules.freeHomEquiv.trans yonedaEquiv

/-- Naturality of the universal property of the free module in the source representable. -/
lemma freeHomEquiv_naturality_left {F G : (Opens X)ᵒᵖ ⥤ Type u} (φ : F ⟶ G)
    {A : PresheafOfModules.{u} X.ringCatSheaf.obj} (f : PresheafOfModules.freeObj G ⟶ A) :
    PresheafOfModules.freeHomEquiv (freeF.map φ ≫ f) = φ ≫ PresheafOfModules.freeHomEquiv f := by
  rw [← PresheafOfModules.freeAdjunction_homEquiv, ← PresheafOfModules.freeAdjunction_homEquiv]
  exact Adjunction.homEquiv_naturality_left _ _ _

/-- Under `sectionsEquiv`, precomposition with the comparison map `R_V ⟶ R_U` is the restriction
map of sections from `U` to `V`. -/
lemma sectionsEquiv_naturality {A : PresheafOfModules.{u} X.ringCatSheaf.obj} {U V : Opens X}
    (h : V ≤ U) (f : PresheafOfModules.freeObj (yoneda.obj U) ⟶ A) :
    sectionsEquiv A V (restrMap h ≫ f) = A.presheaf.map (homOfLE h).op (sectionsEquiv A U f) := by
  change yonedaEquiv (PresheafOfModules.freeHomEquiv (freeF.map (yoneda.map (homOfLE h)) ≫ f))
      = A.presheaf.map (homOfLE h).op (yonedaEquiv (PresheafOfModules.freeHomEquiv f))
  rw [freeHomEquiv_naturality_left]
  exact (yonedaEquiv_naturality (PresheafOfModules.freeHomEquiv f) (homOfLE h)).symm

/-- The forgetful functor from sheaves of modules to presheaves of modules is a right adjoint (its
left adjoint is sheafification), so it preserves injective objects: an injective sheaf of modules
is injective as a presheaf of modules. -/
lemma injective_val (M : X.Modules) [Injective M] : Injective M.val :=
  (PresheafOfModules.sheafificationAdjunction (𝟙 X.ringCatSheaf.obj)).map_injective M ‹Injective M›

/-- **An injective sheaf of `O_X`-modules has surjective restrictions.** -/
lemma surjective_restriction (M : X.Modules) [Injective M] {U V : Opens X} (h : V ≤ U) :
    Function.Surjective (M.val.presheaf.map (homOfLE h).op) := by
  haveI hInj : Injective M.val := injective_val M
  haveI hmono : Mono (restrMap h) := mono_restrMap h
  intro s
  -- `s` is a section over `V`; it is the image of a map `R_V ⟶ M`, which extends along the
  -- monomorphism `R_V ⟶ R_U` because `M` is injective.
  let h' : PresheafOfModules.freeObj (yoneda.obj U) ⟶ M.val :=
    @Injective.factorThru _ _ _ _ _ hInj ((sectionsEquiv M.val V).symm s) (restrMap h) hmono
  refine ⟨sectionsEquiv M.val U h', ?_⟩
  have hcomp : restrMap h ≫ h' = (sectionsEquiv M.val V).symm s :=
    @Injective.comp_factorThru _ _ _ _ _ hInj ((sectionsEquiv M.val V).symm s) (restrMap h) hmono
  rw [← sectionsEquiv_naturality (A := M.val) h h']
  exact (congrArg (sectionsEquiv M.val V) hcomp).trans (Equiv.apply_symm_apply _ s)

end InjectiveIsFlasqueAux

/-- An injective sheaf of `O_X`-modules on a scheme has flasque (flabby) underlying sheaf of
abelian groups. -/
theorem injectiveIsFlasque (X : Scheme.{u}) (M : X.Modules) [Injective M] :
    TopCat.Presheaf.IsFlasque ((SheafOfModules.toSheaf X.ringCatSheaf).obj M).obj := by
  refine ⟨fun {U V} i => ?_⟩
  rw [show ((SheafOfModules.toSheaf X.ringCatSheaf).obj M).obj = M.val.presheaf from rfl]
  rw [AddCommGrpCat.epi_iff_surjective]
  -- A morphism of the opposite category is the opposite of the inclusion it corresponds to.
  have hi : i = (homOfLE (leOfHom i.unop)).op := by
    rw [← Quiver.Hom.op_unop i]
    exact congrArg Quiver.Hom.op (homOfLE_leOfHom i.unop)
  rw [hi]
  exact InjectiveIsFlasqueAux.surjective_restriction M (leOfHom i.unop)

end Work.DSG1
