import Mathlib

/-!
# Auxiliary lemmas for `Work.DSG1.injective_isFlasque`

`Work.DSG1.injective_isFlasque` states that an injective sheaf of `𝒪_X`-modules on a scheme has
flasque underlying sheaf of abelian groups.  The proof rests on two classical facts:

* the forgetful functor from sheaves of `𝒪_X`-modules to sheaves of abelian groups preserves
  injectives (because its left adjoint, the `𝒪_X`-linearization of a sheaf of abelian groups, is
  left exact), and
* an injective sheaf of abelian groups is flasque,

but it is convenient to prove a slightly stronger statement on the way: an injective object of the
category of *presheaves* of modules over a presheaf of rings is "flasque", in the sense that all
restriction maps are surjective.  This file collects the purely presheaf-theoretic input.

The main gadget is, for every object `X` of the site, the presheaf of modules `freeYonedaMod R X`,
free on the representable presheaf `yoneda.obj X.unop` (so that a morphism out of it into `M` is,
by construction of `PresheafOfModules.freeObj`, a section of `M` over `X`), together with the
canonical map `freeYonedaToUnit R X` to the unit presheaf of modules, sending the generator to `1`.
`mono_freeYonedaToUnit` shows that this map is a monomorphism.  Hence, for an injective presheaf of
modules `M'`, any section of `M'` over `X` is the restriction of a "global" element coming from a
morphism `unit R.obj ⟶ M'`; by the naturality of that morphism, restricting this element to any
`V` mapping to `X` recovers the section we started from (`surjective_restrict_of_injective`).

Nothing here is specific to schemes: `C` is a category all of whose Hom types are subsingletons
(this is what makes `freeYonedaToUnit` a monomorphism), `J` a Grothendieck topology on `C` and `R`
a sheaf of rings on `J`.
-/

open CategoryTheory AlgebraicGeometry Limits TopologicalSpace Opposite
open scoped CategoryTheory

universe u

set_option backward.isDefEq.respectTransparency false

namespace Work.DSG1

section PresheafAux

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasWeakSheafify J AddCommGrpCat.{u}]
variable [Sub : ∀ (A B : C), Subsingleton (A ⟶ B)]

/-! ### Two pointwise formulas for the free presheaf of modules -/

/-- The morphism of presheaves of types underlying `PresheafOfModules.freeHomEquiv`, pointwise. -/
lemma freeHomEquiv_app_freeMk {F : Cᵒᵖ ⥤ Type u} {G : PresheafOfModules.{u} R.obj}
    (ψ : PresheafOfModules.freeObj F ⟶ G) (W : Cᵒᵖ) (x : F.obj W) :
    (PresheafOfModules.freeHomEquiv ψ).app W x = ψ.app W (ModuleCat.freeMk x) := by
  rw [PresheafOfModules.freeHomEquiv]
  rfl

/-- `freeObjDesc` is the evaluation on the generator `freeMk x`. -/
lemma freeObjDesc_app_freeMk {F : Cᵒᵖ ⥤ Type u} {G : PresheafOfModules.{u} R.obj}
    (ψ : F ⟶ G.presheaf ⋙ forget Ab) (W : Cᵒᵖ) (x : F.obj W) :
    (PresheafOfModules.freeObjDesc ψ).app W (ModuleCat.freeMk x) = ψ.app W x := by
  have h := freeHomEquiv_app_freeMk (PresheafOfModules.freeObjDesc ψ) W x
  rw [show PresheafOfModules.freeHomEquiv (PresheafOfModules.freeObjDesc ψ) = ψ from
    Equiv.apply_symm_apply _ _] at h
  exact h.symm

/-! ### The unit presheaf of modules -/

/-- The element `1` of the unit presheaf of modules, with explicit coercions. -/
noncomputable abbrev unitOne (W : Cᵒᵖ) : ↥((PresheafOfModules.unit R.obj).obj W) :=
  ((1 : ↥(R.obj.obj W)) : ↥((PresheafOfModules.unit R.obj).obj W))

/-- The same element, in the spelling used for the underlying presheaf of abelian groups. -/
noncomputable abbrev unitOneForget (W : Cᵒᵖ) :
    ((PresheafOfModules.unit R.obj).presheaf ⋙ forget Ab).obj W :=
  ((1 : ↥(R.obj.obj W)) : ↥((PresheafOfModules.unit R.obj).obj W))

lemma unit_map_unitOne {X Y : Cᵒᵖ} (f : X ⟶ Y) :
    (PresheafOfModules.unit R.obj).map f (unitOne (R := R) X) = unitOne (R := R) Y :=
  PresheafOfModules.unit_map_one R.obj f

/-! ### The free module on a representable, and its map to the unit -/

/-- The presheaf of `R`-modules freely generated by the representable presheaf at `X`. -/
noncomputable abbrev freeYonedaMod (R : Sheaf J RingCat.{u}) (X : Cᵒᵖ) :
    PresheafOfModules.{u} R.obj :=
  PresheafOfModules.freeObj (yoneda.obj X.unop)

/-- The canonical morphism from the free module on the representable at `X` to the unit,
sending the generator to `1`. -/
noncomputable def freeYonedaToUnit (R : Sheaf J RingCat.{u}) (X : Cᵒᵖ) :
    freeYonedaMod R X ⟶ PresheafOfModules.unit R.obj :=
  PresheafOfModules.freeObjDesc
    ((yonedaEquiv (X := X.unop)
      (F := (PresheafOfModules.unit R.obj).presheaf ⋙ forget Ab)).symm
        (unitOneForget (R := R) X))

/-- The defining pointwise formula for `freeYonedaToUnit`: the generator goes to `1`. -/
lemma freeYonedaToUnit_app_freeMk (R : Sheaf J RingCat.{u}) (X : Cᵒᵖ) {W : Cᵒᵖ}
    (g : W.unop ⟶ X.unop) :
    (freeYonedaToUnit R X).app W (ModuleCat.freeMk g) = unitOne (R := R) W :=
  Eq.trans (freeObjDesc_app_freeMk (F := yoneda.obj X.unop) _ W g)
    (PresheafOfModules.unit_map_one R.obj g.op)

/-- A morphism of presheaves of modules is a monomorphism as soon as all its components are. -/
lemma mono_of_mono_app {C' : Type*} [Category C'] {R' : C'ᵒᵖ ⥤ RingCat.{u}}
    {P Q : PresheafOfModules.{u} R'} (φ : P ⟶ Q) (h : ∀ W, Mono (φ.app W)) : Mono φ where
  right_cancellation {Z} g h' eq := by
    refine PresheafOfModules.hom_ext (fun W => ?_)
    have hW := h W
    refine Mono.right_cancellation (f := φ.app W) (g.app W) (h'.app W) ?_
    have := congrArg (fun (t : Z ⟶ Q) => t.app W) eq
    simpa using this

/-- **The free module on a representable is a subobject of the unit.**  This uses that all Hom
types of the site are subsingletons: the components of `freeYonedaToUnit` are then the maps
`freeMk _ ↦ 1` on free modules on subsingleton types, which are injective. -/
lemma mono_freeYonedaToUnit (R : Sheaf J RingCat.{u}) (X : Cᵒᵖ) :
    Mono (freeYonedaToUnit R X) := by
  refine mono_of_mono_app _ (fun W => ?_)
  rw [ModuleCat.mono_iff_injective]
  intro x y hxy
  by_cases hn : Nonempty (W.unop ⟶ X.unop)
  · obtain ⟨a₀⟩ := hn
    -- a retraction of the component, sending `r` to `r • freeMk a₀`
    let r : (PresheafOfModules.unit R.obj).obj W ⟶ (freeYonedaMod R X).obj W :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton (↥(R.obj.obj W))
        (↥((freeYonedaMod R X).obj W)) (ModuleCat.freeMk a₀))
    have hr : (freeYonedaToUnit R X).app W ≫ r = 𝟙 _ := by
      apply ModuleCat.free_hom_ext
      intro a
      show r ((freeYonedaToUnit R X).app W (ModuleCat.freeMk a)) = ModuleCat.freeMk a
      refine Eq.trans (congrArg r (freeYonedaToUnit_app_freeMk R X a)) ?_
      have h1 : (ModuleCat.ofHom (LinearMap.toSpanSingleton (↥(R.obj.obj W))
          (↥((freeYonedaMod R X).obj W))
          (ModuleCat.freeMk (R := ↥(R.obj.obj W)) a₀)))
            (unitOne (R := R) W) = ModuleCat.freeMk (R := ↥(R.obj.obj W)) a₀ := by
        show (1 : ↥(R.obj.obj W)) • ModuleCat.freeMk (R := ↥(R.obj.obj W)) a₀ =
          ModuleCat.freeMk (R := ↥(R.obj.obj W)) a₀
        rw [one_smul]
      exact Eq.trans h1 (congrArg ModuleCat.freeMk (Subsingleton.elim a₀ a))
    have key : ∀ z, r ((freeYonedaToUnit R X).app W z) = z := by
      intro z
      have h := congrArg (fun (f : (freeYonedaMod R X).obj W ⟶ (freeYonedaMod R X).obj W) =>
        f z) hr
      simpa using h
    exact (key x).symm.trans ((congrArg r hxy).trans (key y))
  · haveI : IsEmpty (W.unop ⟶ X.unop) := ⟨fun a => hn ⟨a⟩⟩
    -- the domain is a free module on an empty type, hence a subsingleton
    haveI : Subsingleton ((freeYonedaMod R X).obj W) := by
      refine ⟨fun a b => ?_⟩
      have h : ∀ z : (freeYonedaMod R X).obj W, z = 0 := fun z => by
        apply Finsupp.ext
        intro y
        exact (IsEmpty.false y).elim
      rw [h a, h b]
    exact Subsingleton.elim x y

/-! ### Sections of an injective presheaf of modules -/

/-- Building a morphism out of `freeYonedaMod R X` from a section over `X`, and evaluating it on
the generator over `X`. -/
lemma xi_symm_apply {M' : PresheafOfModules.{u} R.obj} (X : Cᵒᵖ)
    (s : (M'.presheaf ⋙ forget Ab).obj X) :
    (PresheafOfModules.freeHomEquiv.symm
        ((yonedaEquiv (X := X.unop) (F := M'.presheaf ⋙ forget Ab)).symm s)).app X
      (ModuleCat.freeMk (𝟙 X.unop)) = s := by
  have h1 : (PresheafOfModules.freeHomEquiv.symm
        ((yonedaEquiv (X := X.unop) (F := M'.presheaf ⋙ forget Ab)).symm s)).app X
      (ModuleCat.freeMk (𝟙 X.unop)) =
      ((yonedaEquiv (X := X.unop) (F := M'.presheaf ⋙ forget Ab)).symm s).app X
        (𝟙 X.unop) :=
    freeObjDesc_app_freeMk (F := yoneda.obj X.unop) _ X (𝟙 X.unop)
  refine h1.trans ?_
  have h2 : ((yonedaEquiv (X := X.unop) (F := M'.presheaf ⋙ forget Ab)).symm s).app X
      (𝟙 X.unop) = s := by
    rw [show ((yonedaEquiv (X := X.unop) (F := M'.presheaf ⋙ forget Ab)).symm s).app X
        (𝟙 X.unop) = (M'.presheaf ⋙ forget Ab).map (𝟙 X.unop).op s from rfl]
    simp
  exact h2

/-- **A section of an injective presheaf of modules over `V` is the restriction of a
"unit" element.**  Formulated so that it directly gives the surjectivity of an arbitrary
restriction map `M'(U) ⟶ M'(V)`. -/
theorem surjective_restrict_of_injective (M' : PresheafOfModules.{u} R.obj) [Injective M']
    {U V : Cᵒᵖ} (i : U ⟶ V) (s : M'.obj V) :
    ∃ t : M'.obj U, M'.map i t = s := by
  let sv : (M'.presheaf ⋙ forget Ab).obj V := s
  let φ : freeYonedaMod R V ⟶ M' :=
    PresheafOfModules.freeHomEquiv.symm
      ((yonedaEquiv (X := V.unop) (F := M'.presheaf ⋙ forget Ab)).symm sv)
  have hφ : φ.app V (ModuleCat.freeMk (𝟙 V.unop)) = sv := xi_symm_apply (R := R) V sv
  haveI : Mono (freeYonedaToUnit R V) := mono_freeYonedaToUnit R V
  let h : PresheafOfModules.unit R.obj ⟶ M' :=
    Injective.factorThru φ (freeYonedaToUnit R V)
  have hh : freeYonedaToUnit R V ≫ h = φ :=
    Injective.comp_factorThru φ (freeYonedaToUnit R V)
  refine ⟨h.app U (unitOne (R := R) U), ?_⟩
  have hs : s = h.app V (unitOne (R := R) V) := by
    calc s = sv := rfl
      _ = φ.app V (ModuleCat.freeMk (𝟙 V.unop)) := hφ.symm
      _ = (freeYonedaToUnit R V ≫ h).app V (ModuleCat.freeMk (𝟙 V.unop)) :=
            congrArg (fun (g : freeYonedaMod R V ⟶ M') =>
              g.app V (ModuleCat.freeMk (𝟙 V.unop))) hh.symm
      _ = h.app V ((freeYonedaToUnit R V).app V (ModuleCat.freeMk (𝟙 V.unop))) := by
            rw [PresheafOfModules.comp_app]
            rfl
      _ = h.app V (unitOne (R := R) V) :=
            congrArg (h.app V) (freeYonedaToUnit_app_freeMk R V (𝟙 V.unop))
  rw [hs]
  exact (PresheafOfModules.naturality_apply h i (unitOne (R := R) U)).symm.trans
    (congrArg (h.app V) (unit_map_unitOne (R := R) i))

end PresheafAux

end Work.DSG1
