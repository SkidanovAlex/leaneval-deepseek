import Mathlib

namespace Work.DSM7p.Alg

universe a

/-- `I • ⊤` on a product of two modules is the product of the corresponding `I • ⊤` submodules. -/
theorem smul_top_prod {A : Type a} [CommRing A] {M : Type a} [AddCommGroup M] [Module A M]
    {N : Type a} [AddCommGroup N] [Module A N] (I : Ideal A) :
    (I • ⊤ : Submodule A (M × N)) =
      Submodule.prod (I • ⊤ : Submodule A M) (I • ⊤ : Submodule A N) := by
  refine le_antisymm ?_ ?_
  · -- The forward inclusion: `I • ⊤` is generated by `r • x` with `r ∈ I`, `x ∈ ⊤`,
    -- and each such element has both components in the respective `I • ⊤`.
    rw [Submodule.smul_le]
    rintro r hr n -
    rw [Submodule.mem_prod]
    exact ⟨Submodule.smul_mem_smul hr Submodule.mem_top,
      Submodule.smul_mem_smul hr Submodule.mem_top⟩
  · rintro x ⟨h1, h2⟩
    -- The backward inclusion: `x = (x.1, 0) + (0, x.2)`, and each summand lies in
    -- `I • ⊤` because the inclusions `M → M × N` and `N → M × N` are `A`-linear.
    have hx1 : (x.1, (0 : N)) ∈ (I • ⊤ : Submodule A (M × N)) :=
      Submodule.smul_induction_on h1
        (fun r hr m _ => by
          have : (r • m, (0 : N)) = r • (m, (0 : N)) := by simp
          rw [this]; exact Submodule.smul_mem_smul hr Submodule.mem_top)
        (fun a b ha hb => by
          have : (a + b, (0 : N)) = (a, (0 : N)) + (b, (0 : N)) := by simp
          rw [this]; exact Submodule.add_mem _ ha hb)
    have hx2 : ((0 : M), x.2) ∈ (I • ⊤ : Submodule A (M × N)) :=
      Submodule.smul_induction_on h2
        (fun r hr n _ => by
          have : ((0 : M), r • n) = r • ((0 : M), n) := by simp
          rw [this]; exact Submodule.smul_mem_smul hr Submodule.mem_top)
        (fun a b ha hb => by
          have : ((0 : M), a + b) = ((0 : M), a) + ((0 : M), b) := by simp
          rw [this]; exact Submodule.add_mem _ ha hb)
    have hsum : x = (x.1, (0 : N)) + ((0 : M), x.2) := by ext <;> simp
    rw [hsum]
    exact Submodule.add_mem _ hx1 hx2

end Work.DSM7p.Alg
