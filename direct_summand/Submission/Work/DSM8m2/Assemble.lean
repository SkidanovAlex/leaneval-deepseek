import Submission.Work.DSM8m.Presentation.exists_algHom_localization

/-!
# DSM8m2 — assembly: from the kernel statement to the monogenic presentation

This file is the scheme-free glue between the inputs of the area `DSM8m2` and the target of
`area_M8mpos`:

* `Work.DSM8m2.adjoinRoot_minpoly_injective` — the kernel statement
  `ker(aeval η) = (minpoly A η)` (delivered in
  `Submission/Work/DSM8m2/Algebra/ker_aeval_eq_span_minpoly.lean`, *without* integral closedness
  of `A`) makes `AdjoinRoot (minpoly A η) → L`, `T ↦ η` injective;
* `Work.DSM8m2.exists_algHom_away` — hence `φ : B →ₐ[A] L` factors through
  `B →ₐ[A] (AdjoinRoot (minpoly A η))[1/c]` as soon as a single `c` clears the denominators of all
  values of `φ` (this is `Presentation.exists_algHom_localization` applied with `F := minpoly A η`);
* `Work.DSM8m2.exists_algHom_target` — if moreover `c ∣ pg^m`, the localisation further maps to
  `(AdjoinRoot (minpoly A η))[1/pg]`, and the composite is an `A`-algebra map, i.e. satisfies the
  compatibility condition `θ' ∘ φU = algebraMap` of `area_M8mpos`.

None of the statements mentions `K = Frac A`: the concrete hypothesis needed is the kernel
statement of the second bullet, which the caller supplies from
`Work.DSM8m2.ker_aeval_eq_span_minpoly`. -/

open Polynomial

namespace Work.DSM8m2

universe u

/-- **Injectivity of `AdjoinRoot (minpoly A η) → L`** from the kernel statement.
If the kernel of `A[T] → L`, `T ↦ η`, is generated by `minpoly A η`, then
`A[T]/(minpoly A η) → L` is injective. -/
theorem adjoinRoot_minpoly_injective {A L : Type*} [CommRing A] [Field L] [Algebra A L] {η : L}
    (hker : RingHom.ker (Polynomial.aeval η).toRingHom = Ideal.span {minpoly A η}) :
    ∃ (Φ₀ : AdjoinRoot (minpoly A η) →+* L),
      (∀ P : Polynomial A, Φ₀ (AdjoinRoot.mk (minpoly A η) P) = Polynomial.aeval η P) ∧
        Function.Injective Φ₀ := by
  have haeval : Polynomial.eval₂ (algebraMap A L) η (minpoly A η) = 0 := by
    rw [← Polynomial.aeval_def]
    exact minpoly.aeval A η
  let Φ₀ : AdjoinRoot (minpoly A η) →+* L := AdjoinRoot.lift (algebraMap A L) η haeval
  have hΦ₀ : ∀ P : Polynomial A, Φ₀ (AdjoinRoot.mk (minpoly A η) P) = Polynomial.aeval η P := by
    intro P
    rw [AdjoinRoot.lift_mk, Polynomial.aeval_def]
  refine ⟨Φ₀, hΦ₀, ?_⟩
  intro x y hxy
  obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective x
  obtain ⟨Q, rfl⟩ := AdjoinRoot.mk_surjective y
  have hmem : P - Q ∈ RingHom.ker (Polynomial.aeval η).toRingHom := by
    have h : Polynomial.aeval η (P - Q) = 0 := by
      rw [map_sub, ← hΦ₀ P, ← hΦ₀ Q, hxy, sub_self]
    exact h
  rw [hker] at hmem
  have hdvd : minpoly A η ∣ P - Q := Ideal.mem_span_singleton.mp hmem
  exact AdjoinRoot.mk_eq_mk.mpr hdvd

section Factor

variable {A L B : Type*} [CommRing A] [Field L] [Algebra A L] [CommRing B] [Algebra A B]

/-- `φ : B →ₐ[A] L` factors through `B →ₐ[A] (AdjoinRoot (minpoly A η))[1/c]` whenever `c` clears
the denominators of all the values of `φ`. -/
theorem exists_algHom_away (φ : B →ₐ[A] L) (hφ : Function.Injective φ) {η : L}
    (hmonic : (minpoly A η).Monic)
    (hker : RingHom.ker (Polynomial.aeval η).toRingHom = Ideal.span {minpoly A η})
    (c : A) (hc : c ≠ 0)
    (hclear : ∀ b : B, ∃ (n : ℕ) (Q : Polynomial A),
      φ b * (algebraMap A L c) ^ n = Polynomial.aeval η Q) :
    ∃ (Ψ : B →ₐ[A] Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) c))
      (Φ : Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) c) →ₐ[A] L),
      Function.Injective Φ ∧ Φ.comp Ψ = φ := by
  obtain ⟨Φ₀, hΦ₀, hinj⟩ := adjoinRoot_minpoly_injective (A := A) (L := L) hker
  exact Work.DSM8m.Presentation.exists_algHom_localization φ hφ
    (minpoly A η) hmonic η Φ₀ hΦ₀ hinj c hc hclear

end Factor

section Target

variable {A L B : Type*} [CommRing A] [Field L] [Algebra A L] [CommRing B] [Algebra A B]

/-- **The monogenic presentation.**  If `c ≠ 0` clears the denominators of the values of `φ` and
`c ∣ pg^m`, then `φ` is dominated by an `A`-algebra map into `(AdjoinRoot (minpoly A η))[1/pg]`
satisfying the compatibility condition of `area_M8mpos`. -/
theorem exists_algHom_target (φ : B →ₐ[A] L) (hφ : Function.Injective φ) {η : L}
    (hmonic : (minpoly A η).Monic)
    (hker : RingHom.ker (Polynomial.aeval η).toRingHom = Ideal.span {minpoly A η})
    (c : A) (hc : c ≠ 0)
    (hclear : ∀ b : B, ∃ (n : ℕ) (Q : Polynomial A),
      φ b * (algebraMap A L c) ^ n = Polynomial.aeval η Q)
    (pg : A) (m : ℕ) (hdiv : c ∣ pg ^ m) :
    ∃ θ' : B →+* Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) pg),
      θ'.comp (algebraMap A B) =
        (algebraMap (AdjoinRoot (minpoly A η)) _).comp (algebraMap A (AdjoinRoot (minpoly A η))) := by
  obtain ⟨Ψ, -, -, -⟩ := exists_algHom_away (A := A) (L := L) (B := B) φ hφ hmonic hker c hc hclear
  -- the localisation `T_c → T_{pg}` exists because `c ∣ pg^m`
  have hbase : algebraMap A (AdjoinRoot (minpoly A η)) c ∣
      (algebraMap A (AdjoinRoot (minpoly A η)) pg) ^ m := by
    obtain ⟨k, hk⟩ := hdiv
    exact ⟨algebraMap A (AdjoinRoot (minpoly A η)) k, by rw [← map_pow, ← map_mul, hk]⟩
  have hdvd : (algebraMap (AdjoinRoot (minpoly A η))
        (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) pg))
        (algebraMap A (AdjoinRoot (minpoly A η)) c)) ∣
      ((algebraMap (AdjoinRoot (minpoly A η))
        (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) pg))
        (algebraMap A (AdjoinRoot (minpoly A η)) pg)) ^ m) := by
    have h := map_dvd (algebraMap (AdjoinRoot (minpoly A η))
      (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) pg))) hbase
    simpa only [map_pow] using h
  have hunit : IsUnit (algebraMap (AdjoinRoot (minpoly A η))
      (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) pg))
      (algebraMap A (AdjoinRoot (minpoly A η)) c)) :=
    isUnit_of_dvd_unit hdvd ((IsLocalization.Away.algebraMap_isUnit _).pow _)
  refine ⟨(IsLocalization.Away.lift (x := algebraMap A (AdjoinRoot (minpoly A η)) c)
      (g := algebraMap (AdjoinRoot (minpoly A η))
        (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) pg))) hunit).comp Ψ.toRingHom, ?_⟩
  refine RingHom.ext fun a => ?_
  simp only [RingHom.comp_apply]
  rw [show Ψ.toRingHom (algebraMap A B a) = algebraMap A
        (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) c)) a from
      AlgHom.commutes Ψ a,
    IsScalarTower.algebraMap_apply A (AdjoinRoot (minpoly A η))
      (Localization.Away (algebraMap A (AdjoinRoot (minpoly A η)) c)) a,
    IsLocalization.Away.lift_eq (algebraMap A (AdjoinRoot (minpoly A η)) c) hunit
      (algebraMap A (AdjoinRoot (minpoly A η)) a)]

end Target

end Work.DSM8m2
