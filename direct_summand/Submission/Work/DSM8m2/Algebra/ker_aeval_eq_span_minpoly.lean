import Mathlib

open Polynomial

namespace Work.DSM8m2.Algebra

/-- The kernel of `aeval η : A[X] → L` is generated by the minimal polynomial of `η` over `A`,
under the hypothesis that the minimal polynomial is stable under the base change `A → K`
(`K` being the fraction field of the domain `A`).  The proof evaluates in the fraction field `K`,
uses the field case (`minpoly.dvd`), and descends the resulting divisibility back to `A[X]`
via monic polynomial division and injectivity of `A → K`. -/
theorem ker_aeval_eq_span_minpoly {A K L : Type*} [CommRing A] [IsDomain A] [Field K]
    [Algebra A K] [IsFractionRing A K] [Field L] [Algebra A L] [Algebra K L]
    [IsScalarTower A K L] {η : L} (hint : IsIntegral A η)
    (hmap : (minpoly A η).map (algebraMap A K) = minpoly K η) :
    RingHom.ker (Polynomial.aeval η).toRingHom = Ideal.span {minpoly A η} := by
  apply le_antisymm
  · intro p hp
    rw [RingHom.mem_ker] at hp
    rw [Ideal.mem_span_singleton]
    -- `hmonic` and injectivity of the coefficient map `A → K`
    have hmonic : (minpoly A η).Monic := minpoly.monic hint
    have hf : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
    -- evaluating at `η` commutes with extension of scalars `A → K`
    have hK : (Polynomial.aeval (R := K) η) (p.map (algebraMap A K)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap K η p]; exact hp
    -- over the field `K`, the minimal polynomial divides every vanishing polynomial
    have hdvd : minpoly K η ∣ p.map (algebraMap A K) := minpoly.dvd K η hK
    rw [← hmap] at hdvd
    -- descend divisibility from `K[X]` to `A[X]` using monic polynomial division
    have hmod : (p %ₘ minpoly A η).map (algebraMap A K) = 0 := by
      rw [Polynomial.map_modByMonic (algebraMap A K) hmonic]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd (hmonic.map (algebraMap A K))).mpr hdvd
    have hpmod : p %ₘ minpoly A η = 0 := (Polynomial.map_eq_zero_iff hf).mp hmod
    exact (Polynomial.modByMonic_eq_zero_iff_dvd hmonic).mp hpmod
  · apply Ideal.span_le.mpr
    rw [Set.singleton_subset_iff]
    exact RingHom.mem_ker.mpr (minpoly.aeval A η)

end Work.DSM8m2.Algebra
