import Mathlib
import Submission.Work.DSFFP.Defs

set_option linter.style.haveILetI false

open TensorProduct Module

namespace Work.DSFFP

/-- If `M` is an `S`-module killed by the ideal `I` (i.e. `I • ⊤ = ⊥`), then for every `m : M`
and every `x ∈ I • ⊤ ⊆ T`, the simple tensor `m ⊗ₜ x` vanishes in `M ⊗[S] T`.

The point is that the linear map `t ↦ m ⊗ₜ t` kills `I • ⊤`, because `I • ⊤` is generated by
elements `r • t` with `r ∈ I`, and `m ⊗ₜ (r • t) = (r • m) ⊗ₜ t = 0`. -/
lemma tmul_eq_zero_of_mem_ideal_smul_top {S : Type*} [CommRing S] (I : Ideal S) {M : Type*}
    [AddCommGroup M] [Module S M] (hM : Module.IsTorsionBySet S M (I : Set S)) {T : Type*}
    [AddCommGroup T] [Module S T] (m : M) {x : T} (hx : x ∈ I • (⊤ : Submodule S T)) :
    m ⊗ₜ[S] x = 0 := by
  have hle : I • (⊤ : Submodule S T) ≤ LinearMap.ker (TensorProduct.mk S M T m) := by
    refine Submodule.smul_le.mpr (fun r hr t _ => ?_)
    show m ⊗ₜ[S] (r • t) = 0
    rw [← TensorProduct.smul_tmul r m t]
    have : r • m = 0 := hM (a := (⟨r, hr⟩ : I)) (x := m)
    rw [this, TensorProduct.zero_tmul]
  exact hle hx

/-- If `M` is an `S`-module killed by the ideal `I`, then tensoring with `M` kills the map
`T → T ⧸ I • ⊤`: the canonical map `M ⊗[S] T → M ⊗[S] (T ⧸ I • ⊤)` is injective. -/
lemma injective_lTensor_mkQ_of_ideal_smul_eq_bot {S : Type*} [CommRing S] (I : Ideal S)
    {M : Type*} [AddCommGroup M] [Module S M] (hM : Module.IsTorsionBySet S M (I : Set S))
    (T : Type*) [AddCommGroup T] [Module S T] :
    Function.Injective ((Submodule.mkQ (I • (⊤ : Submodule S T))).lTensor M) := by
  rw [← LinearMap.ker_eq_bot, lTensor_mkQ, LinearMap.range_eq_bot]
  apply TensorProduct.ext'
  intro m x
  simpa using tmul_eq_zero_of_mem_ideal_smul_top I hM m x.2

/-- If an `S`-module `Q` is killed by the ideal `I`, and the quotient `T ⧸ I • ⊤` is flat over `S ⧸ I` (`h2`), then every submodule inclusion `A ↪ Q` stays injective after `⊗[S] T`.  This is the case "both sides killed by `I`" of Stacks 10.99.8 (tag 051C), i.e. `Tor₁ˢ(N, T) = 0` for every `S ⧸ I`-module `N`, formulated elementarily.

PLAN for the prover.  For an `S`-module `N` with `I • ⊤ = ⊥` there is a natural `S`-linear isomorphism `N ⊗[S] T ≃ₗ[S] N ⊗[S ⧸ I] (T ⧸ I • ⊤)`: indeed `N ⊗[S] (S ⧸ I) ≃ₗ[S] N ⧸ I • ⊤ = N` (`TensorProduct.tensorQuotEquivQuotSMul`) and the associativity of `⊗` over the `S`-algebra `S ⧸ I` gives `N ⊗[S] T ≃ (N ⊗[S] (S ⧸ I)) ⊗[S ⧸ I] (T ⧸ I • ⊤)`.  Applying the isomorphism to `N = A` and to `N = Q` (both `S`-modules killed by `I`, with the induced `S ⧸ I`-module structures, which exist e.g. via `IsTorsionBySet.module`) turns the map `A ⊗[S] T → Q ⊗[S] T` into `A ⊗[S ⧸ I] (T ⧸ I • ⊤) → Q ⊗[S ⧸ I] (T ⧸ I • ⊤)`, the tensor of the injective `S ⧸ I`-linear map `A ↪ Q` with the flat `S ⧸ I`-module `T ⧸ I • ⊤`; that is injective by `Module.Flat.lTensor_preserves_injective_linearMap` (or `Module.Flat.rTensor_preserves_injective_linearMap`) applied to `h2`. -/
theorem tpure_of_flat_quot_top {S : Type _} [CommRing S] (I : Ideal S) {Q : Type _} [AddCommGroup Q]
    [Module S Q] (hQ : I • (⊤ : Submodule S Q) = ⊥) (A : Submodule S Q) (T : Type _)
    [AddCommGroup T] [Module S T]
    (h2 : Module.Flat (S ⧸ I) (T ⧸ (I • ⊤ : Submodule S T))) : Work.DSFFP.TPure T A.subtype := by
  -- `Q` and `A` are killed by `I`, so they carry `S ⧸ I`-module structures compatible with `S`.
  have hQts : Module.IsTorsionBySet S Q (I : Set S) := by
    intro x r
    have h : (r : S) • x ∈ I • (⊤ : Submodule S Q) := Submodule.smul_mem_smul r.2 Submodule.mem_top
    rw [hQ] at h
    simpa using h
  have hAts : Module.IsTorsionBySet S A (I : Set S) := by
    intro x r
    apply Subtype.ext
    show (r : S) • (x : Q) = 0
    have h : (r : S) • (x : Q) ∈ I • (⊤ : Submodule S Q) :=
      Submodule.smul_mem_smul r.2 Submodule.mem_top
    rw [hQ] at h
    simpa using h
  letI : Module (S ⧸ I) Q := hQts.module
  haveI htQ : IsScalarTower S (S ⧸ I) Q := Module.IsTorsionBySet.isScalarTower hQts
  letI : Module (S ⧸ I) A := hAts.module
  haveI htA : IsScalarTower S (S ⧸ I) A := Module.IsTorsionBySet.isScalarTower hAts
  -- the quotient `T ⧸ I • ⊤` is an `S ⧸ I`-module.
  have hTts : Module.IsTorsionBySet S (T ⧸ (I • ⊤ : Submodule S T)) (I : Set S) :=
    isTorsionBySet_quotient_ideal_smul T I
  haveI htT : IsScalarTower S (S ⧸ I) (T ⧸ (I • ⊤ : Submodule S T)) :=
    Module.IsTorsionBySet.isScalarTower hTts
  -- the inclusion `A ↪ Q` is `S ⧸ I`-linear.
  have hf' : ∀ (r : S ⧸ I) (x : A), (↑(r • x) : Q) = r • (↑x : Q) := by
    intro r x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective (I := I) r
    rw [Module.IsTorsionBySet.mk_smul hAts, Module.IsTorsionBySet.mk_smul hQts]
    exact Submodule.coe_smul a x
  let f' : A →ₗ[S ⧸ I] Q := { toFun := Subtype.val, map_add' := fun _ _ => rfl, map_smul' := hf' }
  have hflat : Function.Injective (LinearMap.rTensor (T ⧸ (I • ⊤ : Submodule S T)) f') :=
    Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective
  -- the change of rings `M ⊗[S] (T ⧸ I • ⊤) ≃ₗ[S] M ⊗[S ⧸ I] (T ⧸ I • ⊤)` for `M` killed by `I`.
  have hCS_A : CompatibleSMul S (S ⧸ I) A (T ⧸ (I • ⊤ : Submodule S T)) :=
    ⟨fun r m n => by
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective (I := I) r
      rw [Module.IsTorsionBySet.mk_smul hAts, Module.IsTorsionBySet.mk_smul hTts]
      exact TensorProduct.smul_tmul a m n⟩
  have hCS_Q : CompatibleSMul S (S ⧸ I) Q (T ⧸ (I • ⊤ : Submodule S T)) :=
    ⟨fun r m n => by
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective (I := I) r
      rw [Module.IsTorsionBySet.mk_smul hQts, Module.IsTorsionBySet.mk_smul hTts]
      exact TensorProduct.smul_tmul a m n⟩
  haveI := hCS_A
  haveI := hCS_Q
  let eA := TensorProduct.equivOfCompatibleSMul (R := S) (A := S ⧸ I) (S := S) A
    (T ⧸ (I • ⊤ : Submodule S T))
  let eQ := TensorProduct.equivOfCompatibleSMul (R := S) (A := S ⧸ I) (S := S) Q
    (T ⧸ (I • ⊤ : Submodule S T))
  -- `ε = (change of rings) ∘ (kill I • ⊤)`, an injective map on the `A`-side.
  let εA : A ⊗[S] T →ₗ[S] A ⊗[S ⧸ I] (T ⧸ (I • ⊤ : Submodule S T)) :=
    eA.symm.toLinearMap ∘ₗ LinearMap.lTensor A (Submodule.mkQ (I • ⊤ : Submodule S T))
  let εQ : Q ⊗[S] T →ₗ[S] Q ⊗[S ⧸ I] (T ⧸ (I • ⊤ : Submodule S T)) :=
    eQ.symm.toLinearMap ∘ₗ LinearMap.lTensor Q (Submodule.mkQ (I • ⊤ : Submodule S T))
  have hεA : Function.Injective εA :=
    eA.symm.injective.comp (injective_lTensor_mkQ_of_ideal_smul_eq_bot I hAts T)
  have hεA_tmul : ∀ (a : A) (t : T), εA (a ⊗ₜ[S] t) =
      a ⊗ₜ[S ⧸ I] (Submodule.Quotient.mk (p := (I • ⊤ : Submodule S T)) t) := fun _ _ => rfl
  have hεQ_tmul : ∀ (q : Q) (t : T), εQ (q ⊗ₜ[S] t) =
      q ⊗ₜ[S ⧸ I] (Submodule.Quotient.mk (p := (I • ⊤ : Submodule S T)) t) := fun _ _ => rfl
  -- naturality of `ε` in the module.
  have hnat : ∀ z : A ⊗[S] T,
      εQ ((LinearMap.rTensor T (Submodule.subtype A)) z) =
        (LinearMap.rTensor (T ⧸ (I • ⊤ : Submodule S T)) f') (εA z) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul a t =>
        rw [LinearMap.rTensor_tmul, hεA_tmul, hεQ_tmul, LinearMap.rTensor_tmul]
        rfl
    | add x y hx hy => simp only [map_add, hx, hy]
  -- conclude.
  show Function.Injective ((A.subtype).rTensor T)
  rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
  intro z hz
  rw [LinearMap.mem_ker] at hz
  have h1 : εQ ((LinearMap.rTensor T (Submodule.subtype A)) z) = 0 := by rw [hz, map_zero]
  rw [hnat z] at h1
  have h2' : εA z = 0 := hflat (a₁ := εA z) (a₂ := 0)
    (show (LinearMap.rTensor _ f') (εA z) = (LinearMap.rTensor _ f') 0 by simpa using h1)
  exact hεA (a₁ := z) (a₂ := 0) (by rw [h2']; simp)

end Work.DSFFP
