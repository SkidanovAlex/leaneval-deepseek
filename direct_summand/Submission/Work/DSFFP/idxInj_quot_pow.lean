import Mathlib
import Submission.Work.DSFFP.Defs
import Submission.Work.DSFFP.ker_lsmul_mk_pow_le

open scoped TensorProduct

namespace Work.DSFFP

universe u

/-- The annihilator of the submodule generated by `a` is the kernel of `lsmul a`. -/
theorem ann_span_singleton_eq {S : Type u} [CommRing S] (a : S) :
    (Ideal.span {a} : Submodule S S).annihilator = Ideal.torsionOf S S a := by
  rw [show (Ideal.span {a} : Submodule S S) = S ∙ a from rfl]
  exact Submodule.annihilator_span_singleton a

/-- **Injectivity criterion for `I ⊗ T → T` when `I = (a)` is principal.**  For a commutative ring
`S`, an element `a : S` and an `S`-module `T`, the canonical map `(a) ⊗[S] T → T`, `x ⊗ t ↦ x • t`,
is injective if and only if `ker (a · : T → T) ≤ ann_S(a) • ⊤`.

Proof sketch.  `(a) ≅ S ⧸ ann(a)` via `r ↦ r • a`, and `(S ⧸ ann(a)) ⊗[S] T ≅ T ⧸ ann(a) • ⊤`
(`TensorProduct.quotTensorEquivQuotSMul`); the map becomes `t mod ann(a) • ⊤ ↦ a • t`, which is
injective exactly when `ker (a ·) ≤ ann(a) • ⊤` (the reverse inclusion is automatic). -/
theorem idxInj_span_iff {S : Type u} [CommRing S] {T : Type u} [AddCommGroup T] [Module S T]
    (a : S) :
    IdxInj (Ideal.span {a}) T ↔
      LinearMap.ker (LinearMap.lsmul S T a) ≤
        ((Ideal.span {a} : Submodule S S).annihilator) • (⊤ : Submodule S T) := by
  have hI : (Ideal.span {a} : Submodule S S) = S ∙ a := rfl
  have hNt : (Ideal.span {a} : Submodule S S).annihilator = Ideal.torsionOf S S a :=
    ann_span_singleton_eq a
  -- `e : S ⧸ ann(a) ≃ₗ (a)`, the class of `r` mapping to `r • a`
  let e : (S ⧸ (Ideal.span {a} : Submodule S S).annihilator) ≃ₗ[S] (Ideal.span {a} : Submodule S S) :=
    (Submodule.quotEquivOfEq _ (Ideal.torsionOf S S a) hNt) ≪≫ₗ
      (Ideal.quotTorsionOfEquivSpanSingleton S S a) ≪≫ₗ
      (LinearEquiv.ofEq (S ∙ a) _ hI.symm)
  have he : ∀ r : S,
      (e ((Ideal.Quotient.mk ((Ideal.span {a} : Submodule S S).annihilator)) r) : S) = r • a := by
    intro r
    have h : (e (Submodule.Quotient.mk r) : S) = r • a := by
      simp only [e, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
        Ideal.quotTorsionOfEquivSpanSingleton_apply_mk, LinearEquiv.coe_ofEq_apply]
      simp
    exact h
  have heS : ∀ r : S, ((Ideal.span {a} : Submodule S S).subtype
      (e ((Ideal.Quotient.mk ((Ideal.span {a} : Submodule S S).annihilator)) r))) = r • a :=
    fun r => by simpa using he r
  -- `ann(a) • ⊤ ≤ ker (a ·)` is automatic
  have hK : (Ideal.span {a} : Submodule S S).annihilator • (⊤ : Submodule S T) ≤
      (LinearMap.lsmul S T a).ker := by
    rw [Submodule.smul_le]
    intro r hr m hm
    rw [LinearMap.mem_ker, LinearMap.lsmul_apply]
    have hr' : r • a = 0 :=
      (Submodule.mem_annihilator.mp hr) a (Submodule.mem_span_singleton_self a)
    rw [smul_comm a r m, ← smul_assoc r a m, hr', zero_smul]
  -- `K : T ⧸ ann(a) • ⊤ → T`, `m ↦ a • m`
  let K : T ⧸ ((Ideal.span {a} : Submodule S S).annihilator • (⊤ : Submodule S T)) →ₗ[S] T :=
    ((Ideal.span {a} : Submodule S S).annihilator • (⊤ : Submodule S T)).liftQ
      (LinearMap.lsmul S T a) hK
  have hKi : ∀ m : T, K (Submodule.Quotient.mk m) = a • m := by
    intro m
    simp only [K, Submodule.liftQ_apply, LinearMap.lsmul_apply]
  have hL : ∀ (r : S) (y : T),
      (TensorProduct.lift ((LinearMap.lsmul S T).comp (Ideal.span {a}).subtype))
        ((e.rTensor T) ((Ideal.Quotient.mk ((Ideal.span {a} : Submodule S S).annihilator)) r ⊗ₜ y))
      = (r • a) • y := by
    intro r y
    rw [LinearEquiv.rTensor_tmul, TensorProduct.lift.tmul, LinearMap.comp_apply,
      LinearMap.lsmul_apply, heS r]
  have hR : ∀ (r : S) (y : T),
      K ((TensorProduct.quotTensorEquivQuotSMul T ((Ideal.span {a} : Submodule S S).annihilator))
        ((Ideal.Quotient.mk ((Ideal.span {a} : Submodule S S).annihilator)) r ⊗ₜ y))
      = a • (r • y) := by
    intro r y
    rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, hKi]
  -- the key identity: `(a) ⊗ T → T` after `e.rTensor` is `K` after the standard iso
  have hcomp :
      (TensorProduct.lift ((LinearMap.lsmul S T).comp (Ideal.span {a}).subtype)).comp
          (e.rTensor T).toLinearMap
        = K.comp (TensorProduct.quotTensorEquivQuotSMul T
            ((Ideal.span {a} : Submodule S S).annihilator)).toLinearMap := by
    apply TensorProduct.ext'
    intro x y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    show (TensorProduct.lift ((LinearMap.lsmul S T).comp (Ideal.span {a}).subtype))
        ((e.rTensor T) ((Ideal.Quotient.mk ((Ideal.span {a} : Submodule S S).annihilator)) r ⊗ₜ y))
      = K ((TensorProduct.quotTensorEquivQuotSMul T ((Ideal.span {a} : Submodule S S).annihilator))
        ((Ideal.Quotient.mk ((Ideal.span {a} : Submodule S S).annihilator)) r ⊗ₜ y))
    rw [hL r y, hR r y, smul_assoc, smul_comm]
  have h2 : Function.Injective
        (TensorProduct.lift ((LinearMap.lsmul S T).comp (Ideal.span {a}).subtype))
      ↔ Function.Injective K := by
    have h1 : Function.Injective
        ((TensorProduct.lift ((LinearMap.lsmul S T).comp (Ideal.span {a}).subtype)).comp
          (e.rTensor T).toLinearMap)
        ↔ Function.Injective
          (TensorProduct.lift ((LinearMap.lsmul S T).comp (Ideal.span {a}).subtype)) :=
      Function.Injective.of_comp_iff' _ (e.rTensor T).bijective
    have h3 : Function.Injective
        (K.comp (TensorProduct.quotTensorEquivQuotSMul T
          ((Ideal.span {a} : Submodule S S).annihilator)).toLinearMap)
        ↔ Function.Injective K :=
      Function.Injective.of_comp_iff' _ (TensorProduct.quotTensorEquivQuotSMul T _).bijective
    rw [← h1, hcomp, h3]
  rw [IdxInj, h2, ← LinearMap.ker_eq_bot, Submodule.ker_liftQ,
    ← LinearMap.le_ker_iff_map (f := ((Ideal.span {a} : Submodule S S).annihilator •
      (⊤ : Submodule S T)).mkQ), Submodule.ker_mkQ]

/-- Hypothesis `h1` of the local flatness criterion for the FFP node: with `S = D ⧸ (p)ᵐ` and `T = D' ⧸ (p)ᵐD'` (as in `DSMap.Mix2.ff_mod_pow`), the canonical map `(p̄) ⊗[S] T → T` is injective, i.e. `IdxInj (Ideal.span {p̄}) T` where `p̄` is the image of `p` in `S`.  Only `p` being a non-zero-divisor in `D` and in `D'` is used. -/
theorem idxInj_quot_pow {D D' : Type _} [CommRing D] [CommRing D'] [Algebra D D'] (p : ℕ)
    (hD : IsSMulRegular D (p : D)) (hD' : IsSMulRegular D' (p : D')) (m : ℕ) :
    Work.DSFFP.IdxInj (Ideal.span {Ideal.Quotient.mk (Ideal.span {(p : D) ^ m}) (p : D)})
      (D' ⧸ (Ideal.span {(p : D) ^ m}).map (algebraMap D D')) := by
  refine (idxInj_span_iff (T := D' ⧸ (Ideal.span {(p : D) ^ m}).map (algebraMap D D'))
    (Ideal.Quotient.mk (Ideal.span {(p : D) ^ m}) (p : D))).mpr ?_
  exact ker_lsmul_mk_pow_le (p := (p : D)) (m := m) (by simpa using hD')

end Work.DSFFP
