import Mathlib
import Submission.Work.DSG2.Segre.Basic
import Submission.Work.DSG4c.ChartPushout.chartToPoly_surjective

/-!
# Surjectivity of the "all coordinates" chart map (area DSG2)

The `i`-th standard chart `Away (PGr A n) (X i)` of `ℙⁿ_A` is the spectrum of the coordinate
ring generated over `A` by the coordinates `X k / X i`, `k = 0,…,n`.  Consequently the `A`-algebra
map

`A[X₀,…,X_n] ⟶ Away (PGr A n) (X i),   X_k ↦ X_k / X_i`

is surjective.  This is the "unreduced" version of `chartToPoly_surjective`, which uses only the
variables `X_j` with `j ≠ i`.

The proof factors the map through the dehomogenization `dehomHom`, which sends the coordinate
`X i` to `1`; this dehomogenization is itself surjective, whence so is the composite.
-/

namespace Work.DSG2.Segre

universe u

open MvPolynomial

/-- The section of the dehomogenization `dehomHom`: the ring map `A[x_j : j ≠ i] → A[X₀,…,X_n]`
sending the variable `x_j` to `X_j`. -/
noncomputable def dehomSection (A : Type u) [CommRing A] (n : ℕ) (i : Fin (n+1)) :
    MvPolynomial (Work.DSG4c.ChartPushout.chartIdx n i) A →+* MvPolynomial (Fin (n+1)) A :=
  MvPolynomial.eval₂Hom (MvPolynomial.C : A →+* MvPolynomial (Fin (n+1)) A)
    (fun j => MvPolynomial.X j.1)

lemma dehomSection_C (A : Type u) [CommRing A] (n : ℕ) (i : Fin (n+1)) (a : A) :
    dehomSection A n i (MvPolynomial.C a) = MvPolynomial.C a :=
  MvPolynomial.eval₂Hom_C _ _ a

lemma dehomSection_X (A : Type u) [CommRing A] (n : ℕ) (i : Fin (n+1))
    (j : Work.DSG4c.ChartPushout.chartIdx n i) :
    dehomSection A n i (MvPolynomial.X j) = MvPolynomial.X j.1 :=
  MvPolynomial.eval₂Hom_X' _ _ j

/-- The dehomogenization `dehomHom` is a retraction: composing it with `dehomSection` gives the
identity. -/
lemma dehomHom_comp_section (A : Type u) [CommRing A] (n : ℕ) (i : Fin (n+1)) :
    (Work.DSG4c.ChartPushout.dehomHom A n i).comp (dehomSection A n i) = RingHom.id _ := by
  apply MvPolynomial.ringHom_ext
  · intro a
    rw [RingHom.comp_apply, RingHom.id_apply, dehomSection_C,
      Work.DSG4c.ChartPushout.dehomHom_C]
  · intro j
    rw [RingHom.comp_apply, RingHom.id_apply, dehomSection_X,
      Work.DSG4c.ChartPushout.dehomHom_X_of_ne A n i j.2]

/-- The dehomogenization `A[X₀,…,X_n] → A[x_j : j ≠ i]` (`X_i ↦ 1`, `X_j ↦ X_j`) is surjective:
its target is generated by the constants and the variables `X_j` with `j ≠ i`. -/
lemma dehomHom_surjective (A : Type u) [CommRing A] (n : ℕ) (i : Fin (n+1)) :
    Function.Surjective (Work.DSG4c.ChartPushout.dehomHom A n i) := by
  intro x
  refine ⟨dehomSection A n i x, ?_⟩
  have h := RingHom.congr_fun (dehomHom_comp_section A n i) x
  simpa using h

/-- **The `A`-algebra map `X_k ↦ X_k / X_i` from the full polynomial ring onto the `i`-th standard
chart of `ℙⁿ_A` is surjective.** -/
theorem chartElemAll_surjective (A : Type u) [CommRing A] (n : ℕ) (i : Fin (n+1)) :
    Function.Surjective (MvPolynomial.aeval (R := A)
      (fun k : Fin (n+1) => Work.DSG4c.ChartPushout.chartElemAll A n i k)).toRingHom := by
  set f : Fin (n+1) → Work.DSG4c.awayChart A n i :=
    fun k => Work.DSG4c.ChartPushout.chartElemAll A n i k with hf
  have hC : ∀ a : A, (MvPolynomial.aeval (R := A) f).toRingHom (MvPolynomial.C a)
      = Work.DSG4c.chartMap A n i a := fun a => MvPolynomial.aeval_C f a
  have hX : ∀ k : Fin (n+1), (MvPolynomial.aeval (R := A) f).toRingHom (MvPolynomial.X k)
      = Work.DSG4c.ChartPushout.chartElemAll A n i k := fun k => MvPolynomial.aeval_X f k
  -- The map above is the composite of the surjective dehomogenization `dehomHom` and the
  -- surjective dehomogenization map `chartToPoly` of `chartToPoly_surjective`.
  have hcomp : (Work.DSG4c.ChartPushout.chartToPoly A n i).comp
        (Work.DSG4c.ChartPushout.dehomHom A n i)
      = (MvPolynomial.aeval (R := A) f).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply, Work.DSG4c.ChartPushout.dehomHom_C,
        Work.DSG4c.ChartPushout.chartToPoly_C, hC]
    · intro k
      rw [RingHom.comp_apply, hX]
      by_cases hk : k = i
      · subst hk
        rw [Work.DSG4c.ChartPushout.dehomHom_X_self, map_one,
          Work.DSG4c.ChartPushout.chartElemAll_self]
      · rw [Work.DSG4c.ChartPushout.dehomHom_X_of_ne A n i hk,
          Work.DSG4c.ChartPushout.chartToPoly_X,
          Work.DSG4c.ChartPushout.chartElem_eq_chartElemAll]
  have hsurj : Function.Surjective ⇑((Work.DSG4c.ChartPushout.chartToPoly A n i).comp
      (Work.DSG4c.ChartPushout.dehomHom A n i)) := by
    intro y
    obtain ⟨q, hq⟩ := Work.DSG4c.ChartPushout.chartToPoly_surjective A n i y
    obtain ⟨p, rfl⟩ := dehomHom_surjective A n i q
    exact ⟨p, hq⟩
  rwa [hcomp] at hsurj

end Work.DSG2.Segre
