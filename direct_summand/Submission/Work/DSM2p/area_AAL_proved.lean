import Mathlib
import Submission.Work.DSM2p.Basic
import Submission.Work.DSM2p.AALvaln
-- Redirected copies of the delegated results (imports re-pointed to `AALvaln`, so no cycle):
import Submission.Work.DSM2p.AALcopy_approx_lem

/-!
# `Work.DSM2p.area_AAL_proved` — the analytic input of GAP 3 (Česnavičius–Scholze)

The vocabulary of this subproject lives in `Submission.Work.DSM2p.AALvaln` (continuous valuations,
the tilting facts and the glue between `R` and `R[1/ϖ 0]`); it is re-exported here by the import
above.  This file owns the deliverable theorem `area_AAL_proved`, assembled from
`Work.DSM2p.approx_lem` (the Česnavičius–Scholze estimate) and the subring form of `nilp_lem`.
-/

namespace Work.DSM2p

universe u

theorem area_AAL_proved (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R]
    (QR : DSMap.PerfectoidData p R) (P : R) (m : ℕ) :
    ∃ (Qr : ℕ → R) (t e : ℕ), (∀ j, Qr (j + 1) ^ p = Qr j) ∧
      (P - Qr 0) ^ (p ^ t) ∈ Ideal.span {QR.ϖ 0} ∧
      let L := Localization.Away (QR.ϖ 0)
      let u : L := IsLocalization.Away.invSelf (QR.ϖ 0) ^ m
      (algebraMap R L (P - Qr 0) * u) ^ (p ^ e) ∈
          (Algebra.adjoin R {algebraMap R L P * u}).toSubmodule.map
            (LinearMap.mulLeft R (algebraMap R L (QR.ϖ 0))) ∧
      (algebraMap R L (P - Qr 0) * u) ^ (p ^ e) ∈
          (Algebra.adjoin R {algebraMap R L (Qr 0) * u}).toSubmodule.map
            (LinearMap.mulLeft R (algebraMap R L (QR.ϖ 0))) := by sorry

/-! ## The reduction of `area_AAL_proved` to a *tilting-density* statement

The analysis of the target (recorded here for the record, since it is what the reduction below
formalises) is the following.

Write `L = R[1/ϖ 0]`, `u = (ϖ 0)⁻¹ᵐ ∈ L`, `δ = (P - Q)·u`, `A_P = R[P·u] ⊆ L`,
`A_Q = R[Q·u] ⊆ L`.  Then (for `R` a domain, and in general by the description of the
`R`-subalgebra generated by one element)

* clause (ii) `δ^{p^e} ∈ ϖ 0·A_P` is *equivalent* to `((P-Q)/P)^{p^e} ∈ ϖ 0·R`, i.e. to
  `(P - Q)^{p^e} ∈ ϖ 0·P^{p^e}·R`, and likewise clause (iii) to `(P - Q)^{p^e} ∈ ϖ 0·Q^{p^e}·R`.

So the target asks for a **`p`-power** exponent in ČS `nilp-lem`'s conclusion
`δ^N ∈ ϖ 0·A_P ∩ ϖ 0·A_Q` — a strictly stronger statement than CS's `(PQ-power)`, which only
produces *some* exponent `N` (and whose proof via `nilp_lem_subring` is available here:
`delta_lt_one_of_ball_P`/`delta_lt_one_of_ball_Q` below supply the valuation hypotheses, so
`nilp_lem_subring` yields the `∃ N` version outright).  Running a `p`-th power through
`nilp_lem_subring` one only gets exponents `N·p^k`; the set
`{n | δ^n ∈ ϖ 0·A}` is an additive submonoid of `ℕ` closed under `k ↦ p k`, so it contains a
`p`-power exactly when it contains one of the form `p^t`, and in the abstract setting of
`nilp_lem_subring` the `p`-power strengthening is simply **false** (for
`A = k[x,y]/(y²-x³) ⊆ A[1/x]`, `ϖ = x`, `a = y/x` one has `a^n ∈ ϖA ⇔ 2 ∣ n`, so no `3`-power
lies in `ϖA`).

What *is* enough — and this is what the reduction below proves — is the following
**tilting-density statement** `(TD)`: every `P` admits `c, d ∈ R` and a tiltable `Q` with
`(1 + ϖ 0·c)·d = 1` and `Q = P·(1 + ϖ 0·c)`, i.e. `Q` lies in the coset `P + ϖ 0·P·R = P(1 + ϖ 0R)`.
Indeed then, with `t = e = 0`:

* `P - Q = -ϖ 0·(P c) ∈ (ϖ 0)`;
* `δ = (P - Q)u = ϖ 0·(-(P c)·u)` with `-(P c)·u = -c·(P u) ∈ A_P`;
* `δ = ϖ 0·(-(d c)·(Q u))` because `P u = d·(Q u)` in `L` (from `Q = P(1+ϖ 0 c)` and
  `(1+ϖ 0 c)d = 1`), and `d c ∈ R ⊆ A_Q`.

`(TD)` is the form in which the Witt-vector description `R = W(R^♭)/(ξ)` of a perfectoid ring
proves the statement: every element of `W(R^♭)` is `[x]·(1 + p w)`, and reducing `p ≡ ξ + [ϖ♭]^p`
modulo `ξ` exhibits `R ∋ z = ♯(x)·(1 + ϖ 0·(ϖ 0^{p-1}w'))`.  It is *not* available from the
abstract axioms of `DSMap.PerfectoidData` alone, which is why the deliverable is not yet closed. -/

/-- **`(TD) ⟹ area_AAL_proved`, with `t = e = 0`.**  Hypothesis: every `P` admits `Q` in the
coset `P·(1 + ϖ 0·R)` that is tiltable.  Conclusion: the target `area_AAL_proved p R QR P m`. -/
theorem area_AAL_of_tilt_density (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R]
    (QR : DSMap.PerfectoidData p R)
    (hF : ∀ P : R, ∃ (Q c d : R), HasCompatPRoots p Q ∧ (1 + QR.ϖ 0 * c) * d = 1 ∧
      Q = P * (1 + QR.ϖ 0 * c))
    (P : R) (m : ℕ) :
    ∃ (Qr : ℕ → R) (t e : ℕ), (∀ j, Qr (j + 1) ^ p = Qr j) ∧
      (P - Qr 0) ^ (p ^ t) ∈ Ideal.span {QR.ϖ 0} ∧
      let L := Localization.Away (QR.ϖ 0)
      let u : L := IsLocalization.Away.invSelf (QR.ϖ 0) ^ m
      (algebraMap R L (P - Qr 0) * u) ^ (p ^ e) ∈
          (Algebra.adjoin R {algebraMap R L P * u}).toSubmodule.map
            (LinearMap.mulLeft R (algebraMap R L (QR.ϖ 0))) ∧
      (algebraMap R L (P - Qr 0) * u) ^ (p ^ e) ∈
          (Algebra.adjoin R {algebraMap R L (Qr 0) * u}).toSubmodule.map
            (LinearMap.mulLeft R (algebraMap R L (QR.ϖ 0))) := by
  obtain ⟨Q, c, d, hQtr, hcd, hQeq⟩ := hF P
  obtain ⟨r, hr0, hroot⟩ := hQtr
  have hQ' : Q = P + P * QR.ϖ 0 * c := by rw [hQeq]; ring
  have hPsub : P - Q = -(P * (QR.ϖ 0 * c)) := by rw [hQ']; ring
  have hdx : Q * d = P := by
    rw [hQ', show (P + P * QR.ϖ 0 * c) * d = P * ((1 + QR.ϖ 0 * c) * d) by ring, hcd, mul_one]
  -- `P` in terms of `Q`: `algebraMap P = algebraMap Q * algebraMap d`
  have hPd : algebraMap R (Localization.Away (QR.ϖ 0)) P
      = algebraMap R (Localization.Away (QR.ϖ 0)) Q * algebraMap R (Localization.Away (QR.ϖ 0)) d := by
    rw [← map_mul, hdx]
  -- the key identities: `(P - Q)` as `-ϖ 0` times an element of the two subalgebras
  have keyP : algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
      = -(algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0))
        * (algebraMap R (Localization.Away (QR.ϖ 0)) P
            * algebraMap R (Localization.Away (QR.ϖ 0)) c) := by
    rw [hPsub, map_neg, map_mul, map_mul]
    ring
  have keyQ : algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
      = -(algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0))
        * (algebraMap R (Localization.Away (QR.ϖ 0)) Q
            * algebraMap R (Localization.Away (QR.ϖ 0)) (d * c)) := by
    rw [keyP, hPd, mul_assoc, ← map_mul]
  refine ⟨r, 0, 0, hroot, ?_, ?_, ?_⟩
  · rw [hr0, pow_zero, pow_one, hPsub]
    rw [show -(P * (QR.ϖ 0 * c)) = (-(P * c)) * QR.ϖ 0 by ring]
    exact Ideal.mul_mem_left _ (-(P * c)) (Ideal.mem_span_singleton_self _)
  · rw [pow_zero, pow_one, hr0]
    set A : Subalgebra R (Localization.Away (QR.ϖ 0)) :=
      Algebra.adjoin R ({algebraMap R (Localization.Away (QR.ϖ 0)) P
        * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m} :
          Set (Localization.Away (QR.ϖ 0))) with hA
    have hgen : algebraMap R (Localization.Away (QR.ϖ 0)) P
        * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m ∈ A := by
      rw [hA]; exact Algebra.subset_adjoin (Set.mem_singleton _)
    have hy : -(algebraMap R (Localization.Away (QR.ϖ 0)) P
        * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m
        * algebraMap R (Localization.Away (QR.ϖ 0)) c) ∈ A :=
      A.neg_mem (A.mul_mem hgen (A.algebraMap_mem c))
    have heq : (LinearMap.mulLeft R (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)))
        (-(algebraMap R (Localization.Away (QR.ϖ 0)) P
          * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m
          * algebraMap R (Localization.Away (QR.ϖ 0)) c))
        = algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
          * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m := by
      rw [LinearMap.mulLeft_apply, keyP]; ring
    rw [← heq]
    exact Submodule.mem_map.mpr ⟨_, hy, rfl⟩
  · rw [pow_zero, pow_one, hr0]
    set A : Subalgebra R (Localization.Away (QR.ϖ 0)) :=
      Algebra.adjoin R ({algebraMap R (Localization.Away (QR.ϖ 0)) Q
        * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m} :
          Set (Localization.Away (QR.ϖ 0))) with hA
    have hgen : algebraMap R (Localization.Away (QR.ϖ 0)) Q
        * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m ∈ A := by
      rw [hA]; exact Algebra.subset_adjoin (Set.mem_singleton _)
    have hy : -(algebraMap R (Localization.Away (QR.ϖ 0)) (d * c)
        * (algebraMap R (Localization.Away (QR.ϖ 0)) Q
          * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m)) ∈ A :=
      A.neg_mem (A.mul_mem (A.algebraMap_mem (d * c)) hgen)
    have heq : (LinearMap.mulLeft R (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)))
        (-(algebraMap R (Localization.Away (QR.ϖ 0)) (d * c)
          * (algebraMap R (Localization.Away (QR.ϖ 0)) Q
            * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m)))
        = algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
          * IsLocalization.Away.invSelf (QR.ϖ 0) ^ m := by
      rw [LinearMap.mulLeft_apply, keyQ]; ring
    rw [← heq]
    exact Submodule.mem_map.mpr ⟨_, hy, rfl⟩

/-- **The tilt witness of `(P, m)`.**  Packaging `approx_lem` (the Česnavičius–Scholze estimate)
with its two consequences that clause (i) consumes: the element `Q := ξ.untilt` has a compatible
system of `p`-power roots (`untilt_hasCompatPRoots`), and `P - Q` has value `< 1` at every
continuous valuation of the unit ball of `R` (`diff_lt_one_of_estimate`). -/
theorem exists_tilt_witness {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) [Fact (¬ IsUnit (p : R))]
    [IsAdicComplete (Ideal.span {(p : R)}) R] (P : R) (m : ℕ) :
    ∃ Q : R, HasCompatPRoots p Q ∧
      (∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation R Γ₀),
        IsContinuousValuation (QR.ϖ 0) v → IsUnitBall v Set.univ → v (P - Q) < 1) := by
  obtain ⟨ξ, hξ⟩ := approx_lem QR P m
  exact ⟨PreTilt.untilt ξ, untilt_hasCompatPRoots ξ,
    diff_lt_one_of_estimate QR m hξ⟩

/-- **Clause (i)** of `area_AAL_proved`, conditional on the subring form of `nilp_lem` (the
hypothesis `hnilp`, whose shape is exactly `Work.DSM2p.nilp_lem_subring`).  The tilt witness
`exists_tilt_witness` gives `Q` with compatible `p`-power roots and value `< 1` for `P - Q` at every
continuous valuation of the unit ball; applying `nilp_lem` to the range subring of `algebraMap R L`
and pulling back along the injective `algebraMap R L` produces `(P - Q)^N ∈ (ϖ 0)`, and a `p`-power
of that exponent lands in the required form. -/
theorem clause_i {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) [Fact (¬ IsUnit (p : R))]
    [IsAdicComplete (Ideal.span {(p : R)}) R]
    (hnilp : ∀ (A : Subring (Localization.Away (QR.ϖ 0)))
      (hϖA : algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0) ∈ A)
      (hgen : ∀ z : Localization.Away (QR.ϖ 0), ∃ n : ℕ, ∃ a : A,
        z * (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) ^ n
          = (a : Localization.Away (QR.ϖ 0)))
      (a : Localization.Away (QR.ϖ 0)),
      (∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀]
        (v : Valuation (Localization.Away (QR.ϖ 0)) Γ₀),
        IsContinuousValuation (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) v →
          IsUnitBall v (A : Set (Localization.Away (QR.ϖ 0))) → v a < 1) →
      ∃ N : ℕ, ∃ x : A, (x : Localization.Away (QR.ϖ 0))
        * algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0) = a ^ N)
    (P : R) (m : ℕ) :
    ∃ (Q : R) (t : ℕ), HasCompatPRoots p Q ∧ (P - Q) ^ (p ^ t) ∈ Ideal.span {QR.ϖ 0} := by
  classical
  obtain ⟨Q, hQ, hlt⟩ := exists_tilt_witness QR P m
  -- the `< 1` hypothesis for the nilp application: restrict the valuations of `L` along `R → L`
  have hcond : ∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀]
      (v : Valuation (Localization.Away (QR.ϖ 0)) Γ₀),
      IsContinuousValuation (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) v →
        IsUnitBall v ((algebraMap R (Localization.Away (QR.ϖ 0))).range :
          Set (Localization.Away (QR.ϖ 0))) → v (algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)) < 1 := by
    intro Γ₀ _ v hv hball
    have hv' : IsContinuousValuation (QR.ϖ 0)
        (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) :=
      IsContinuousValuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) hv
    have hb' : IsUnitBall (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v)
        (Set.univ : Set R) :=
      IsUnitBall.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) (s := Set.univ)
        (by simpa using hball)
    have := hlt (Γ₀ := Γ₀) (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v)
      hv' hb'
    simpa [Valuation.precomp_apply] using this
  obtain ⟨N, x, hx⟩ := hnilp (algebraMap R (Localization.Away (QR.ϖ 0))).range
    ⟨QR.ϖ 0, rfl⟩ (generates_of_range QR) (algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)) hcond
  -- pull back along the injective `algebraMap R L`: `(P - Q)^N = r * ϖ 0`
  obtain ⟨r, hr⟩ := RingHom.mem_range.mp x.2
  have h2 : (P - Q) ^ N = r * (QR.ϖ 0) := by
    have h1 : algebraMap R (Localization.Away (QR.ϖ 0)) ((P - Q) ^ N)
        = algebraMap R (Localization.Away (QR.ϖ 0)) (r * (QR.ϖ 0)) := by
      rw [map_pow, map_mul, hr]
      exact hx.symm
    exact algebraMap_away_injective QR h1
  have hN : (P - Q) ^ N ∈ Ideal.span {QR.ϖ 0} := by
    rw [h2]
    exact Ideal.mul_mem_left (Ideal.span {QR.ϖ 0}) r (Ideal.mem_span_singleton_self _)
  -- raise to a `p`-power
  obtain ⟨t, ht⟩ : ∃ t : ℕ, N ≤ p ^ t := ⟨N + 1, by
    have h2' : (2 : ℕ) ≤ p := (Fact.out : p.Prime).two_le
    calc N ≤ 2 ^ N := le_of_lt (Nat.lt_two_pow_self)
      _ ≤ 2 ^ (N + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
      _ ≤ p ^ (N + 1) := Nat.pow_le_pow_left h2' (N + 1)⟩
  have hstep : (P - Q) ^ (p ^ t) = (P - Q) ^ (p ^ t - N) * (P - Q) ^ N := by
    rw [← pow_add]
    congr 1
    omega
  exact ⟨Q, t, hQ, by
    rw [hstep]
    exact Ideal.mul_mem_left (Ideal.span {QR.ϖ 0}) ((P - Q) ^ (p ^ t - N)) hN⟩

/-! ### Clauses (ii)/(iii): the bookkeeping of `u = invSelf (ϖ 0) ^ m`

In `L = R[1/ϖ 0]` the element `u := invSelf (ϖ 0) ^ m` is the inverse of `algebraMap (ϖ 0) ^ m`
(factored form and valuative form).  These two identities are what turn membership in `ϖ 0 · R[x]`
into the valuation inequalities of the Česnavičius–Scholze case analysis. -/

/-- `(algebraMap (ϖ 0)) ^ m * u = 1` in `L`. -/
theorem varpi_pow_mul_invSelf_pow {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) (m : ℕ) :
    (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) ^ m
      * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m = 1 := by
  rw [← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]

/-- Valuative form of `varpi_pow_mul_invSelf_pow`: `v u * v (algebraMap (ϖ 0)) ^ m = 1`. -/
theorem val_invSelf_pow {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) (m : ℕ) {Γ₀ : Type u}
    [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation (Localization.Away (QR.ϖ 0)) Γ₀) :
    v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m)
      * v (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) ^ m = 1 := by
  have hspec : IsLocalization.Away.invSelf (QR.ϖ 0)
      * algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0) = 1 := by
    rw [mul_comm, IsLocalization.Away.mul_invSelf]
  rw [map_pow, ← mul_pow, ← map_mul, hspec, map_one, one_pow]

/-- Powers of an element `≤ 1` of a linearly ordered monoid with zero are `≤ 1`. -/
theorem pow_le_one_of_le_one {Γ₀ : Type u} [LinearOrderedCommMonoidWithZero Γ₀] {a : Γ₀}
    (ha : a ≤ 1) : ∀ n : ℕ, a ^ n ≤ 1 := by
  intro n
  induction n with
  | zero => simp
  | succ k ih => rw [pow_succ]; exact le_trans (mul_le_mul' ih ha) (by simp)

/-- **Core of clause (ii).**  For a continuous valuation `v` of `L = R[1/ϖ 0]` with restriction `v'`
to `R` (given by `hv'`): if `v'` satisfies the estimate of `approx_lem`, has `v' (p) < 1`, is `≤ 1`
on the unit ball of `R`, and the subring `R[P·u]` forces `v' P ≤ v' (ϖ 0)^m`, then
`v (algebraMap (P - Q) · u) < 1`.  The case split is the Česnavičius–Scholze one: below
`v' Q ≤ v' (ϖ 0)^m` the estimate gives `v' (P - Q) ≤ v' (p) · v' (ϖ 0)^m < v' (ϖ 0)^m`; above it,
`v' (P - Q) ≤ v' (p) · v' Q < v' Q` forces `v' P = v' Q`, contradicting `v' P ≤ v' (ϖ 0)^m`. -/
theorem delta_lt_one_core {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) {P Q : R} {m : ℕ}
    {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀]
    (v : Valuation (Localization.Away (QR.ϖ 0)) Γ₀) (v' : Valuation R Γ₀)
    (hv' : ∀ x : R, v' x = v (algebraMap R (Localization.Away (QR.ϖ 0)) x))
    (hp1 : v' (p : R) < 1)
    (hest : v' (P - Q) ≤ v' (p : R) * max (v' Q) (v' (QR.ϖ 0) ^ (p * m)))
    (hballR : IsUnitBall v' Set.univ)
    (hP : v' P ≤ v' (QR.ϖ 0) ^ m) :
    v (algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
      * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) < 1 := by
  have hval : v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m)
      * v (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) ^ m = 1 :=
    val_invSelf_pow QR m v
  have hW : v' (QR.ϖ 0) = v (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) := hv' _
  have hpowm : v' (QR.ϖ 0) ^ (p * m) ≤ v' (QR.ϖ 0) ^ m := by
    have h1 : v' (QR.ϖ 0) ≤ 1 := hballR _ (Set.mem_univ _)
    calc v' (QR.ϖ 0) ^ (p * m) = v' (QR.ϖ 0) ^ m * v' (QR.ϖ 0) ^ (p * m - m) := by
          rw [← pow_add, Nat.add_sub_of_le (Nat.le_mul_of_pos_left m (Fact.out : p.Prime).pos)]
      _ ≤ v' (QR.ϖ 0) ^ m * 1 := mul_le_mul' le_rfl (pow_le_one_of_le_one h1 _)
      _ = v' (QR.ϖ 0) ^ m := mul_one _
  have key : v' (P - Q) * v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m)
      = v (algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
          * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) := by
    rw [map_mul, ← hv']
  by_cases hcase : v' Q ≤ v' (QR.ϖ 0) ^ m
  · -- `v' Q ≤ v' (ϖ 0)^m`: bound the `max` and apply the estimate
    have hmax : max (v' Q) (v' (QR.ϖ 0) ^ (p * m)) ≤ v' (QR.ϖ 0) ^ m := max_le hcase hpowm
    have h1 : v' (P - Q) ≤ v' (p : R) * v' (QR.ϖ 0) ^ m :=
      le_trans hest (mul_le_mul' le_rfl hmax)
    have hfin : v' (P - Q) * v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) < 1 := by
      calc v' (P - Q) * v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m)
          ≤ (v' (p : R) * v' (QR.ϖ 0) ^ m)
            * v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) := mul_le_mul' h1 le_rfl
        _ = v' (p : R) * (v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m)
              * v' (QR.ϖ 0) ^ m) := by
            rw [mul_assoc,
              mul_comm (v' (QR.ϖ 0) ^ m) (v ((IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m)),
              ← mul_assoc]
        _ = v' (p : R) := by rw [hW, hval, mul_one]
        _ < 1 := hp1
    rwa [key] at hfin
  · -- the opposite case is impossible: it forces `v' P = v' Q`
    exfalso
    have hlt0 : v' (QR.ϖ 0) ^ m < v' Q := not_le.mp hcase
    have hmax : max (v' Q) (v' (QR.ϖ 0) ^ (p * m)) = v' Q :=
      max_eq_left (le_trans hpowm (le_of_lt hlt0))
    have h1 : v' (P - Q) ≤ v' (p : R) * v' Q := by
      rw [hmax] at hest
      exact hest
    have hz : (0 : Γ₀) < v' Q :=
      lt_of_le_of_lt (zero_le' : (0 : Γ₀) ≤ v' (QR.ϖ 0) ^ (p * m))
        (lt_of_le_of_lt hpowm hlt0)
    have hlt : v' (P - Q) < v' Q :=
      calc v' (P - Q) ≤ v' (p : R) * v' Q := h1
        _ < 1 * v' Q := mul_lt_mul_of_pos_right hp1 hz
        _ = v' Q := one_mul _
    have hPeq : v' P = v' Q := by
      have h := v'.map_add_eq_of_lt_right hlt
      simpa [sub_add_cancel] using h
    exact (not_le.mpr hlt0) (hPeq ▸ hP)

/-- **Clause (ii), the `R[P·u]` case analysis**, assembled from `delta_lt_one_core`. -/
theorem delta_lt_one_of_ball_P {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) {P Q : R} (m : ℕ)
    (hest : ∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation R Γ₀),
      IsContinuousValuation (QR.ϖ 0) v → IsUnitBall v Set.univ →
        v (P - Q) ≤ v (p : R) * max (v Q) (v (QR.ϖ 0) ^ (p * m))) :
    ∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀]
      (v : Valuation (Localization.Away (QR.ϖ 0)) Γ₀),
      IsContinuousValuation (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) v →
      IsUnitBall v (((Algebra.adjoin R
        ({algebraMap R (Localization.Away (QR.ϖ 0)) P
          * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m} :
            Set (Localization.Away (QR.ϖ 0)))).toSubring) :
          Set (Localization.Away (QR.ϖ 0))) →
      v (algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
        * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) < 1 := by
  intro Γ₀ _ v hv hball
  have hv' : ∀ x : R, (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) x
      = v (algebraMap R (Localization.Away (QR.ϖ 0)) x) := fun x => rfl
  have hcont : IsContinuousValuation (QR.ϖ 0)
      (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) :=
    IsContinuousValuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) hv
  have hballR : IsUnitBall (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v)
      (Set.univ : Set R) := by
    refine IsUnitBall.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) (s := Set.univ) ?_
    rintro y ⟨r, -, rfl⟩
    exact hball (algebraMap R (Localization.Away (QR.ϖ 0)) r) (Subalgebra.algebraMap_mem _ r)
  -- the subring condition gives `v' P ≤ v' (ϖ 0)^m`
  have hP : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) P
      ≤ (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ m := by
    have hb : v (algebraMap R (Localization.Away (QR.ϖ 0)) P
        * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) ≤ 1 :=
      hball _ (Algebra.subset_adjoin (Set.mem_singleton _))
    rw [map_mul] at hb
    have hmul := mul_le_mul' hb
      (le_refl (v (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) ^ m))
    rw [mul_assoc, val_invSelf_pow QR m v, mul_one, one_mul] at hmul
    simpa [Valuation.precomp_apply] using hmul
  exact delta_lt_one_core QR v _ hv' (Valuation.map_p_lt_one QR _ hcont hballR)
    (hest _ hcont hballR) hballR hP

/-- Powers of `v (ϖ 0)` with a larger exponent are no larger, when `v (ϖ 0) ≤ 1`. -/
theorem pow_pmul_le_pow {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀]
    (v : Valuation R Γ₀) (h1 : v (QR.ϖ 0) ≤ 1) (m : ℕ) :
    v (QR.ϖ 0) ^ (p * m) ≤ v (QR.ϖ 0) ^ m := by
  calc v (QR.ϖ 0) ^ (p * m) = v (QR.ϖ 0) ^ m * v (QR.ϖ 0) ^ (p * m - m) := by
        rw [← pow_add, Nat.add_sub_of_le (Nat.le_mul_of_pos_left m (Fact.out : p.Prime).pos)]
    _ ≤ v (QR.ϖ 0) ^ m * 1 := mul_le_mul' le_rfl (pow_le_one_of_le_one h1 _)
    _ = v (QR.ϖ 0) ^ m := mul_one _

/-- **Clause (iii), the `R[Q·u]` case analysis** — the mirror of `delta_lt_one_of_ball_P`: here the
subring condition `≤ 1` on `R[Q·u]` forces `v'(Q) ≤ v'(ϖ 0)^m`, and the case split is on
`v'(P) ≤ v'(ϖ 0)^m`: if so, `delta_lt_one_core` applies verbatim; if not, the estimate gives
`v'(P - Q) ≤ v'(p)·v'(ϖ 0)^m ≤ v'(ϖ 0)^m < v'(P)`, so `v'(Q) = v'(P)`, contradicting
`v'(Q) ≤ v'(ϖ 0)^m`. -/
theorem delta_lt_one_of_ball_Q {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R]
    (QR : DSMap.PerfectoidData p R) {P Q : R} (m : ℕ)
    (hest : ∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation R Γ₀),
      IsContinuousValuation (QR.ϖ 0) v → IsUnitBall v Set.univ →
        v (P - Q) ≤ v (p : R) * max (v Q) (v (QR.ϖ 0) ^ (p * m))) :
    ∀ {Γ₀ : Type u} [LinearOrderedCommGroupWithZero Γ₀]
      (v : Valuation (Localization.Away (QR.ϖ 0)) Γ₀),
      IsContinuousValuation (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) v →
      IsUnitBall v (((Algebra.adjoin R
        ({algebraMap R (Localization.Away (QR.ϖ 0)) Q
          * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m} :
            Set (Localization.Away (QR.ϖ 0)))).toSubring) :
          Set (Localization.Away (QR.ϖ 0))) →
      v (algebraMap R (Localization.Away (QR.ϖ 0)) (P - Q)
        * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) < 1 := by
  intro Γ₀ _ v hv hball
  have hv' : ∀ x : R, (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) x
      = v (algebraMap R (Localization.Away (QR.ϖ 0)) x) := fun x => rfl
  have hcont : IsContinuousValuation (QR.ϖ 0)
      (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) :=
    IsContinuousValuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) hv
  have hballR : IsUnitBall (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v)
      (Set.univ : Set R) := by
    refine IsUnitBall.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) (s := Set.univ) ?_
    rintro y ⟨r, -, rfl⟩
    exact hball (algebraMap R (Localization.Away (QR.ϖ 0)) r) (Subalgebra.algebraMap_mem _ r)
  have hp1 : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (p : R) < 1 :=
    Valuation.map_p_lt_one QR _ hcont hballR
  have hest' := hest (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) hcont hballR
  -- the subring condition gives `v' Q ≤ v' (ϖ 0)^m`
  have hQ : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) Q
      ≤ (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ m := by
    have hb : v (algebraMap R (Localization.Away (QR.ϖ 0)) Q
        * (IsLocalization.Away.invSelf (QR.ϖ 0)) ^ m) ≤ 1 :=
      hball _ (Algebra.subset_adjoin (Set.mem_singleton _))
    rw [map_mul] at hb
    have hmul := mul_le_mul' hb
      (le_refl (v (algebraMap R (Localization.Away (QR.ϖ 0)) (QR.ϖ 0)) ^ m))
    rw [mul_assoc, val_invSelf_pow QR m v, mul_one, one_mul] at hmul
    simpa [Valuation.precomp_apply] using hmul
  by_cases hcase : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) P
      ≤ (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ m
  · exact delta_lt_one_core QR v _ hv' hp1 hest' hballR hcase
  · exfalso
    have hlt0 : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ m
        < (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) P := not_le.mp hcase
    have h1 : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0)
        ≤ 1 := hballR _ (Set.mem_univ _)
    have hpowm := pow_pmul_le_pow QR _ h1 m
    have hmax : max ((Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) Q)
        ((Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ (p * m))
        ≤ (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ m :=
      max_le hQ hpowm
    have h2 : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (P - Q)
        ≤ (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (QR.ϖ 0) ^ m :=
      le_trans (le_trans hest' (mul_le_mul' le_rfl hmax))
        (le_trans (mul_le_mul' (le_of_lt hp1) le_rfl) (by rw [one_mul]))
    have hlt : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (P - Q)
        < (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) P :=
      lt_of_le_of_lt h2 hlt0
    have hQeq : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) Q
        = (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) P := by
      have hlt' : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (Q - P)
          < (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) P := by
        have h1 : (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (Q - P)
            = (Valuation.precomp (algebraMap R (Localization.Away (QR.ϖ 0))) v) (P - Q) := by
          rw [show Q - P = -(P - Q) by ring, Valuation.map_neg]
        rw [h1]
        exact hlt
      exact Valuation.map_eq_of_sub_lt _ hlt'
    exact (not_le.mpr hlt0) (hQeq ▸ hQ)

end Work.DSM2p
