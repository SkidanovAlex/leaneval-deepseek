import Mathlib

namespace Work.DSM2p

/-- Auxiliary lemma (polynomial lifting modulo an ideal): if `φ : C →+* D` is surjective modulo an
ideal `K ⊆ D` (every `d : D` satisfies `d - φ c ∈ K` for some `c : C`), then every polynomial over
`D` is congruent modulo the ideal `K[X] = Ideal.map Polynomial.C K` of `D[X]` to the image of a
polynomial over `C`.

This is the "lift the coefficients of `r` modulo `(φ ϖ)^k`" step of the N5e descent argument. -/
theorem map_lift_of_surj_mod {C D : Type*} [CommRing C] [CommRing D] (φ : C →+* D) (K : Ideal D)
    (hsurj : ∀ d : D, ∃ c : C, d - φ c ∈ K) (p : Polynomial D) :
    ∃ q : Polynomial C, p - q.map φ ∈ Ideal.map (Polynomial.C : D →+* Polynomial D) K := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      obtain ⟨q₁, h₁⟩ := hp
      obtain ⟨q₂, h₂⟩ := hq
      refine ⟨q₁ + q₂, ?_⟩
      rw [Polynomial.map_add]
      have heq : p + q - (Polynomial.map φ q₁ + Polynomial.map φ q₂)
          = (p - Polynomial.map φ q₁) + (q - Polynomial.map φ q₂) := by ring
      rw [heq]
      exact Ideal.add_mem _ h₁ h₂
  | monomial n a =>
      obtain ⟨c, hc⟩ := hsurj a
      refine ⟨Polynomial.C c * Polynomial.X ^ n, ?_⟩
      have hmap : Polynomial.map φ (Polynomial.C c * Polynomial.X ^ n)
          = Polynomial.monomial n (φ c) := by
        rw [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
          Polynomial.C_mul_X_pow_eq_monomial]
      rw [hmap, ← Polynomial.C_mul_X_pow_eq_monomial,
        ← Polynomial.C_mul_X_pow_eq_monomial, ← sub_mul, ← Polynomial.C_sub]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hc)

/-- The ideal of a polynomial ring generated by a constant `C a` is the set of polynomials all of
whose coefficients lie in the ideal `(a)`, i.e. it is the push-forward of `(a)` along `C`. -/
theorem span_C_singleton_eq_map (R : Type*) [CommRing R] (a : R) :
    Ideal.span {Polynomial.C a} = Ideal.map (Polynomial.C : R →+* Polynomial R) (Ideal.span {a}) := by
  rw [Ideal.map_span, Set.image_singleton]

/-- **N5e (DESCENT).**  Let `φ : C →+* D` and `ϖ : C` be such that `φ` induces a bijection
`C/(ϖ^k) ≅ D/(φ ϖ)^k` (surjectivity is `hsurj`, injectivity is `hinj`).  Then for `f, g ∈ C[X]`,
if the image of `g` in `D[X]` lies in the ideal generated by `(φ ϖ)^k` and `f.map φ`, then `g`
lies in the ideal generated by `ϖ^k` and `f` in `C[X]`.

The proof is coefficientwise: write `g.map φ = x + (f.map φ) * s` with `x ∈ ((φ ϖ)^k)`, lift the
coefficients of `s` modulo `(φ ϖ)^k` using `hsurj` to get `q ∈ C[X]` with `s - q.map φ` in
`((φ ϖ)^k) D[X]`, so that `(g - f * q).map φ ∈ ((φ ϖ)^k) D[X]`; applying `hinj` to the coefficients
of `g - f * q` gives `g - f * q ∈ (ϖ^k) C[X]`, whence `g = (g - f * q) + f * q` lies in
`(ϖ^k) ⊔ (f)`. -/
theorem N5e_descent {C D : Type*} [CommRing C] [CommRing D] (φ : C →+* D) (ϖ : C) (k : ℕ)
    (hinj : ∀ c : C, φ c ∈ Ideal.span {φ ϖ ^ k} → c ∈ Ideal.span {ϖ ^ k})
    (hsurj : ∀ d : D, ∃ c : C, d - φ c ∈ Ideal.span {φ ϖ ^ k})
    (f g : Polynomial C)
    (hg : g.map φ ∈ Ideal.span {Polynomial.C (φ ϖ ^ k)} ⊔ Ideal.span {f.map φ}) :
    g ∈ Ideal.span {Polynomial.C (ϖ ^ k)} ⊔ Ideal.span {f} := by
  -- Rewrite the "constant ideals" as push-forwards of ideals of the coefficient rings.
  have keyD : Ideal.span {Polynomial.C (φ ϖ ^ k)}
      = Ideal.map (Polynomial.C : D →+* Polynomial D) (Ideal.span {φ ϖ ^ k}) :=
    span_C_singleton_eq_map D (φ ϖ ^ k)
  have keyC : Ideal.span {Polynomial.C (ϖ ^ k)}
      = Ideal.map (Polynomial.C : C →+* Polynomial C) (Ideal.span {ϖ ^ k}) :=
    span_C_singleton_eq_map C (ϖ ^ k)
  rw [keyD] at hg
  rw [keyC]
  -- Decompose `g.map φ = x + (f.map φ) * s`.
  obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp hg
  obtain ⟨s, hs⟩ := Ideal.mem_span_singleton.mp hy
  -- Lift `s` coefficientwise modulo `(φ ϖ)^k`.
  obtain ⟨q, hq⟩ := map_lift_of_surj_mod φ (Ideal.span {φ ϖ ^ k}) hsurj s
  -- Then `(g - f * q).map φ` is again in `(φ ϖ)^k D[X]`.
  have hmem : (g - f * q).map φ ∈
      Ideal.map (Polynomial.C : D →+* Polynomial D) (Ideal.span {φ ϖ ^ k}) := by
    have heq : (g - f * q).map φ = x + f.map φ * (s - q.map φ) := by
      rw [Polynomial.map_sub, Polynomial.map_mul, ← hxy, hs, mul_sub]
      ring
    rw [heq]
    exact Ideal.add_mem _ hx (Ideal.mul_mem_left _ _ hq)
  -- Descent of the coefficients, using `hinj` coefficientwise.
  have hmem2 : g - f * q ∈
      Ideal.map (Polynomial.C : C →+* Polynomial C) (Ideal.span {ϖ ^ k}) := by
    rw [Ideal.mem_map_C_iff]
    intro n
    refine hinj _ ?_
    rw [← Polynomial.coeff_map]
    exact Ideal.mem_map_C_iff.mp hmem n
  -- Finally `g = (g - f * q) + f * q` with `f * q ∈ (f)`.
  refine Submodule.mem_sup.mpr ⟨g - f * q, hmem2, f * q, ?_, ?_⟩
  · exact Ideal.mem_span_singleton.mpr ⟨q, rfl⟩
  · ring

end Work.DSM2p
