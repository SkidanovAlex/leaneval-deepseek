import Mathlib
import Submission.Work.DSM2p.AALvaln
import Submission.Work.DSM2p.nilp_sub_defs
import Submission.Work.DSM2p.nilp_sub_auxA
import Submission.Work.DSM2p.nilp_sub_gen
import Submission.Work.DSM2p.nilp_sub_auxB2

namespace Work.DSM2p

open scoped Classical

/-- A non-unit of a commutative ring lies in a prime ideal. -/
theorem exists_prime_of_not_isUnit {S : Type*} [CommRing S] {x : S} (hx : ¬ IsUnit x) :
    ∃ 𝔮 : Ideal S, 𝔮.IsPrime ∧ x ∈ 𝔮 := by
  have hproper : Ideal.span ({x} : Set S) ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact hx
  obtain ⟨𝔪, hmax, hle⟩ := Ideal.exists_le_maximal _ hproper
  exact ⟨𝔪, hmax.isPrime, hle (Ideal.subset_span (Set.mem_singleton x))⟩

/-- **`nilp-lem` (subring form).**  Let `B` be a commutative ring, `ϖ ∈ B` a nonzerodivisor,
`A ⊆ B` a subring containing `ϖ` such that `B = A[1/ϖ]` (the `hgen` hypothesis), and `a ∈ B`.
If `|a| < 1` for every continuous valuation `|·|` on `B` with `|A| ≤ 1`, then `a^N ∈ ϖA` for
some `N`.

The proof is by contraposition.  If `a^N ∉ ϖA` for all `N`, then

* either `ϖ` is a unit of `A[a⁻¹]`, in which case one clears `a`-denominators in `1 = σ·ϖ` and
  uses `hgen` (`nilp_sub_auxA`), or
* `ϖ` is a non-unit of `A[a⁻¹]`, so it lies in a prime `𝔮`; a prime of a subring of a ring whose
  ambient ring is generated by inverting that element gives a continuous valuation of the ambient
  ring (`nilp_sub_auxB2`), which is `≥ 1` at `a` and `≤ 1` on `A`, contradicting the
  hypothesis. -/
theorem nilp_lem_subring {B : Type*} [CommRing B] (ϖ : B) (hϖ : IsSMulRegular B ϖ)
    (A : Subring B) (hϖA : ϖ ∈ A)
    (hgen : ∀ z : B, ∃ n : ℕ, ∃ a : A, z * ϖ ^ n = (a : B)) (a : B)
    (h : ∀ {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation B Γ₀),
      IsContinuousValuation ϖ v → IsUnitBall v (A : Set B) → v a < 1) :
    ∃ N : ℕ, ∃ x : A, (x : B) * ϖ = a ^ N := by
  by_contra hcon
  set x₀ : awaySubring A a :=
    ⟨algebraMap B (Localization.Away a) ϖ, varpi_mem_awaySubring A a hϖA⟩ with hx₀
  by_cases hunit : IsUnit x₀
  · exact hcon (nilp_sub_auxA ϖ hϖ A hϖA hgen a hunit)
  · obtain ⟨𝔮, h𝔮prime, h𝔮mem⟩ := exists_prime_of_not_isUnit hunit
    -- a continuous valuation of `B[a⁻¹]` which is `< 1` at `ϖ` and `≤ 1` on `A[a⁻¹]`.
    obtain ⟨Γ₀, hΓ₀, v, hvball, hvlt, hvcont⟩ :=
      nilp_sub_auxB2 (awaySubring A a) 𝔮 h𝔮prime x₀ h𝔮mem
        (nilp_sub_gen A hϖA a hgen)
    letI := hΓ₀
    -- restrict it to `B`.
    set vB : Valuation B Γ₀ := v.comap (algebraMap B (Localization.Away a)) with hvB
    have hballB : IsUnitBall vB (A : Set B) := by
      intro b hb
      rw [hvB, Valuation.comap_apply]
      exact hvball _ (algebraMap_mem_awaySubring A a ⟨b, hb⟩)
    have hcontB : IsContinuousValuation ϖ vB := by
      intro γ hγ
      obtain ⟨n, hn⟩ := hvcont γ hγ
      exact ⟨n, by simpa [hvB, hx₀, Valuation.comap_apply] using hn⟩
    -- `1/a` lies in the unit ball, so `vB a ≥ 1`.
    have hinv : v (IsLocalization.Away.invSelf a) ≤ 1 :=
      hvball _ (invSelf_mem_awaySubring A a)
    have hmul : vB a * v (IsLocalization.Away.invSelf a) = 1 := by
      rw [hvB, Valuation.comap_apply, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    have hge : 1 ≤ vB a := by
      have hpos : 0 < v (IsLocalization.Away.invSelf a) := by
        by_contra h'
        have h0 : v (IsLocalization.Away.invSelf a) = 0 :=
          le_antisymm (not_lt.mp h') (zero_le : (0 : Γ₀) ≤ v (IsLocalization.Away.invSelf a))
        rw [h0, mul_zero] at hmul
        exact one_ne_zero hmul.symm
      have h' : v (IsLocalization.Away.invSelf a) * vB a = 1 := by rw [mul_comm]; exact hmul
      have hx : vB a = (v (IsLocalization.Away.invSelf a))⁻¹ := eq_inv_of_mul_eq_one_right h'
      rw [hx]
      exact (one_le_inv₀ hpos).mpr hinv
    exact absurd (h vB hcontB hballB) (not_lt.mpr hge)

end Work.DSM2p
