import Mathlib
import Submission.Work.DSM2p.CSCompletionPos_faithfullyFlat
import Submission.Work.DSM2p.CSIntegralClosurePos_quot_integral
import Submission.Work.DSM2p.ker_algebraMap_quot_le_maximal_via_model

/-!
# `Work.DSM2p.smul_top_ne_top_CSIntegralClosurePos`

For `A` a perfectoid ring (`P : DSMap.PerfectoidData p A`) and a maximal ideal `𝔪 ⊆ A` with
`p ∈ 𝔪`, the `A`-submodule `𝔪 • ⊤` of the `p`-integral closure
`A' = CSIntegralClosurePos A p (P.ϖ 0)` is proper.

## The argument

Write `ϖ := P.ϖ 0`, `A_∞ := CSAlgPos A p ϖ ⊆ Λ[1/ϖ]`, `I_∞ := CSIdealPos A p ϖ ⊆ A_∞` (the ideal
generated by the fractions `F(T_F)/ϖ^m`) and `J := I_∞·A' ⊆ A'` (`CSIdealPosExt`, see
`Submission/Work/DSM2p/SMulTopAux.lean`).

* `J ⊆ 𝔪A'`, because `I_∞ ⊆ ϖA_∞` (`CSIdealPos_le_map_span_varpi`) and `ϖ ∈ 𝔪`
  (`varpi_mem_of_isMaximal`: `ϖ ^ p = p · u` with `u` a unit and `𝔪` is prime).
* `A' ⧸ J` is *integral* over `A`: the image of `A_∞` in `A' ⧸ J` is the image of `Λ`, whose
  generators `X_{(F,n)}` become integral (`F(T_F) ∈ J`, resp. `(X_{(F,n)})^{p^n} = X_{(F,0)}`),
  and the subring `C' ⊆ Λ[1/ϖ]` of elements of `A'` with integral image is `p`-integrally closed
  and contains `A_∞`, so `A' = pIntClosure p A_∞ ≤ C'`
  (`Work.DSM2p.isIntegral_quot_CSIntegralClosurePos`).
* `ker (A → A' ⧸ J) ≤ 𝔪`
  (`Work.DSM2p.ker_algebraMap_quot_le_maximal_via_model`: the Česnavičius–Scholze model
  `Λ[1/ϖ] → K` into the algebraic closure of the residue field of a prime `𝔮 ⊆ 𝔪` with `p ∉ 𝔮`
  kills `J`, so `ker ≤ 𝔮 ≤ 𝔪`).

Hence the fibre of `A' ⧸ J` over the maximal ideal `𝔪` is nonzero
(`smul_top_ne_top_of_isIntegral_of_ker_le`: lying over), and since `A' ⧸ 𝔪A' ≅ (A' ⧸ J) ⧸ 𝔪(A' ⧸ J)`
(here `J ⊆ 𝔪A'` is used), the `A`-submodule `𝔪 • ⊤ ⊆ A'` is proper too.
-/

namespace Work.DSM2p

theorem smul_top_ne_top_CSIntegralClosurePos (p : ℕ) [Fact p.Prime] (A : Type*) [CommRing A] (P : DSMap.PerfectoidData p A) (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal) (hp : (p : A) ∈ 𝔪) : 𝔪 • (⊤ : Submodule A ↥(CSIntegralClosurePos A p (P.ϖ 0))) ≠ ⊤ := by
  set A' := ↥(CSIntegralClosurePos A p (P.ϖ 0)) with hA'
  set J := CSIdealPosExt A p (P.ϖ 0) with hJ
  have hp' : 0 < p := (Fact.out : p.Prime).pos
  -- `A' ⧸ J` is integral over `A`, with the kernel of `A → A' ⧸ J` inside `𝔪`, so its `𝔪`-fibre
  -- does not vanish
  haveI : Algebra.IsIntegral A (A' ⧸ J) := isIntegral_quot_CSIntegralClosurePos A p (P.ϖ 0) hp'
  have hker : RingHom.ker (algebraMap A (A' ⧸ J)) ≤ 𝔪 :=
    ker_algebraMap_quot_le_maximal_via_model p A P 𝔪 h𝔪 hp
  have hne : 𝔪 • (⊤ : Submodule A (A' ⧸ J)) ≠ ⊤ :=
    smul_top_ne_top_of_isIntegral_of_ker_le A (A' ⧸ J) 𝔪 h𝔪 hker
  -- `J ⊆ 𝔪A'`, so `A' ⧸ 𝔪A'` is the `𝔪`-fibre of `A' ⧸ J`
  have hJle : J ≤ Ideal.map (algebraMap A A') 𝔪 := CSIdealPosExt_le_map_maximal p A P 𝔪 h𝔪 hp
  intro htop
  have hmap : Ideal.map (algebraMap A A') 𝔪 = ⊤ := by
    have h := htop
    rw [Ideal.smul_top_eq_map] at h
    exact (Submodule.restrictScalars_eq_top_iff A _ _).mp h
  -- the image of `⊤ = 𝔪A'` in `A' ⧸ J` is the whole of `A' ⧸ J`
  have himg : Ideal.map (algebraMap A (A' ⧸ J)) 𝔪 = ⊤ := by
    have hcomp : algebraMap A (A' ⧸ J) = (Ideal.Quotient.mk J).comp (algebraMap A A') :=
      RingHom.ext fun a => rfl
    rw [hcomp, ← Ideal.map_map, hmap, Ideal.map_top]
  exact hne (by rw [Ideal.smul_top_eq_map, himg, Submodule.restrictScalars_top])

end Work.DSM2p
