import Mathlib
import Submission.Work.DSM2p.ConstructionPos
import Submission.Work.DSM2p.RootClosure
import Submission.Work.DSM2p.sum_pow_sub_mem
import Submission.Work.DSM2p.isFrobIsoMod

/-!
# Frobenius surjectivity of the root-system ring modulo `(ϖ ^ p)`

* `frobSurj_rootClosure` — for the root-system ring
  `Λ = rootClosure A p ι = A[X_{i,n}]/(X_{i,n+1}^p - X_{i,n})` of the Česnavičius–Scholze
  construction, the Frobenius `y ↦ y ^ p` is surjective modulo the ideal `(ϖ ^ p) Λ`
  generated by the image of `P.ϖ 0 ^ p`.
* `frobSurj_rootClosurePos` — its specialisation to `Λ = RootAlgPos A p = rootClosure A p 𝒫⁺`,
  the root-system ring of the positive-degree index set used by the construction of the cover
  (`ConstructionPos.lean`).

This is the `Λ`-level half of the input `(H1)` of `DESIGN.md`: the root-system ring is *generated*
by its variables, each of which has an honest `p`-th root (`rootClosure.X_pow`), so that modulo
`(ϖ ^ p)` every element is a `p`-th power.  The ingredients are

* `(p) = (ϖ ^ p)` in `Λ`, because `ϖ ^ p = p · v` with `v ∈ A ^×` (`P.unit`);
* constants are `p`-th powers modulo `(ϖ ^ p)` by `P.frobSurj` (`isFrobIsoMod`);
* `(x + y) ^ p ≡ x ^ p + y ^ p (mod ϖ ^ p)` (`sum_pow_sub_mem`);
* multiplying an element which is a `p`-th power modulo `(ϖ ^ p)` by a variable of `Λ`
  preserves the property, because the variable is an honest `p`-th power.

The root-system relations are crucially only used through `rootClosure.X_pow`, so the statement
holds for every index type `ι`, including the empty one (where it reduces to `P.frobSurj`).
-/

open scoped Classical

namespace Work.DSM2p

universe u

/-- **Frobenius surjectivity of the root-system ring modulo `(ϖ ^ p)`.**  For every index type
`ι`, every element of `Λ = rootClosure A p ι = A[X_{i,n}]/(X_{i,n+1} ^ p - X_{i,n})` is a `p`-th
power modulo the ideal `(ϖ ^ p)` generated by the image of `P.ϖ 0 ^ p`. -/
theorem frobSurj_rootClosure (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    (P : DSMap.PerfectoidData p A) (ι : Type u) :
    ∀ x : rootClosure A p ι, ∃ y : rootClosure A p ι,
      x - y ^ p ∈ Ideal.span {algebraMap A (rootClosure A p ι) (P.ϖ 0 ^ p)} := by
  intro x
  have hp : p.Prime := Fact.out
  -- `(p : Λ) ∈ (ϖ ^ p)`, because `ϖ ^ p = p · v` with `v` a unit of `A`.
  have hp_mem : (p : rootClosure A p ι) ∈
      Ideal.span {algebraMap A (rootClosure A p ι) (P.ϖ 0 ^ p)} := by
    obtain ⟨v, hv⟩ := P.unit
    have hmap : algebraMap A (rootClosure A p ι) (P.ϖ 0 ^ p)
        = (p : rootClosure A p ι) * algebraMap A (rootClosure A p ι) (↑v : A) := by
      rw [hv, map_mul, map_natCast]
    have hu : IsUnit (algebraMap A (rootClosure A p ι) (↑v : A)) :=
      IsUnit.map (algebraMap A (rootClosure A p ι)) v.isUnit
    rw [hmap, Ideal.span_singleton_mul_right_unit hu]
    exact Ideal.mem_span_singleton_self _
  -- the same statement with `algebraMap A Λ ϖ` in place of `algebraMap A Λ (ϖ ^ p)`
  have hp_mem' : (p : rootClosure A p ι) ∈
      Ideal.span {(algebraMap A (rootClosure A p ι) (P.ϖ 0)) ^ p} := by
    simpa only [map_pow] using hp_mem
  -- the Frobenius is additive modulo `(ϖ ^ p)`
  have hadd : ∀ a b : rootClosure A p ι, (a + b) ^ p - a ^ p - b ^ p ∈
      Ideal.span {algebraMap A (rootClosure A p ι) (P.ϖ 0 ^ p)} := by
    intro a b
    have h := sum_pow_sub_mem hp (algebraMap A (rootClosure A p ι) (P.ϖ 0)) hp_mem' a b
    simpa only [map_pow] using h
  -- the main claim, on representatives in `MvPolynomial (ι × ℕ) A`
  have key : ∀ q : MvPolynomial (ι × ℕ) A,
      ∃ y : rootClosure A p ι, Ideal.Quotient.mk (rootClosureIdeal A p ι) q - y ^ p ∈
        Ideal.span {algebraMap A (rootClosure A p ι) (P.ϖ 0 ^ p)} := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a =>
        -- constants: `P.frobSurj`
        obtain ⟨b, hb⟩ := P.frobSurj a
        have hb' : a - b ^ p ∈ Ideal.span {P.ϖ 0 ^ p} := by
          rw [← span_p_eq_span_varpi_pow P]; exact hb
        refine ⟨algebraMap A (rootClosure A p ι) b, ?_⟩
        have hmem : algebraMap A (rootClosure A p ι) (a - b ^ p) ∈
            Ideal.span {algebraMap A (rootClosure A p ι) (P.ϖ 0 ^ p)} := by
          have h := Ideal.mem_map_of_mem (algebraMap A (rootClosure A p ι)) hb'
          rwa [Ideal.map_span, Set.image_singleton] at h
        have h1 : (algebraMap A (rootClosure A p ι) b) ^ p
            = algebraMap A (rootClosure A p ι) (b ^ p) := by rw [map_pow]
        rw [show Ideal.Quotient.mk (rootClosureIdeal A p ι) (MvPolynomial.C a)
              = algebraMap A (rootClosure A p ι) a from rfl, h1, ← map_sub]
        exact hmem
    | add q₁ q₂ ih₁ ih₂ =>
        -- sums: `sum_pow_sub_mem`
        obtain ⟨y₁, hy₁⟩ := ih₁
        obtain ⟨y₂, hy₂⟩ := ih₂
        refine ⟨y₁ + y₂, ?_⟩
        have hkey : Ideal.Quotient.mk (rootClosureIdeal A p ι) (q₁ + q₂) - (y₁ + y₂) ^ p
            = (Ideal.Quotient.mk (rootClosureIdeal A p ι) q₁ - y₁ ^ p)
              + (Ideal.Quotient.mk (rootClosureIdeal A p ι) q₂ - y₂ ^ p)
              - ((y₁ + y₂) ^ p - y₁ ^ p - y₂ ^ p) := by
          rw [map_add]; ring
        rw [hkey]
        exact Ideal.sub_mem _ (Ideal.add_mem _ hy₁ hy₂) (hadd y₁ y₂)
    | mul_X q i ih =>
        -- multiplication by a variable: the variable is an honest `p`-th power
        obtain ⟨y, hy⟩ := ih
        refine ⟨y * Ideal.Quotient.mk (rootClosureIdeal A p ι)
            (MvPolynomial.X (i.1, i.2 + 1)), ?_⟩
        have hXi : Ideal.Quotient.mk (rootClosureIdeal A p ι) (MvPolynomial.X i)
            = (Ideal.Quotient.mk (rootClosureIdeal A p ι)
                (MvPolynomial.X (i.1, i.2 + 1))) ^ p := by
          have h := rootClosure.X_pow A p ι i.1 i.2
          simpa using h.symm
        have hkey : Ideal.Quotient.mk (rootClosureIdeal A p ι) (q * MvPolynomial.X i)
              - (y * Ideal.Quotient.mk (rootClosureIdeal A p ι)
                  (MvPolynomial.X (i.1, i.2 + 1))) ^ p
            = (Ideal.Quotient.mk (rootClosureIdeal A p ι) q - y ^ p)
              * (Ideal.Quotient.mk (rootClosureIdeal A p ι)
                  (MvPolynomial.X (i.1, i.2 + 1))) ^ p := by
          rw [map_mul, hXi]; ring
        rw [hkey]
        exact Ideal.mul_mem_right _ _ hy
  -- every element of `Λ` is the class of a polynomial
  obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective x
  rw [← hq]
  exact key q

/-- **Frobenius surjectivity of `Λ = RootAlgPos A p` modulo `(ϖ ^ p)`.** -/
theorem frobSurj_rootClosurePos (p : ℕ) [Fact p.Prime] (A : Type*) [CommRing A]
    (P : DSMap.PerfectoidData p A) :
    ∀ x : RootAlgPos A p, ∃ y : RootAlgPos A p,
      x - y ^ p ∈ Ideal.span {algebraMap A (RootAlgPos A p) (P.ϖ 0 ^ p)} :=
  frobSurj_rootClosure p A P (MonicPolysPos A)

end Work.DSM2p
