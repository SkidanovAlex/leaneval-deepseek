import Mathlib
import Submission.Work.DSM2p.LamOne

namespace Work.DSM2p

/-- `CSAlgOne` is generated by the image of `Λ` together with `F(T)/ϖ^m` for `m ≥ 1`, and the
latter family is exactly what the increasing union of the `Λ`-algebras `Λ[F(T)/ϖ^{m+1}]` sees. -/
theorem N8a_CSAlgOne_eq_iSup (A : Type*) [CommRing A] (p : ℕ) (ϖ : A) (F : Polynomial A) :
    CSAlgOne A p ϖ F = ⨆ m : ℕ,
      (Algebra.adjoin (Lam1 A p) {frac A p ϖ (Polynomial.aeval (T1 A p 0) F) (m + 1)}).toSubring := by
  apply le_antisymm
  · rw [CSAlgOne, Subring.closure_le]
    rintro x (hx | hx)
    · obtain ⟨r, rfl⟩ := hx
      exact (le_iSup (f := fun m : ℕ => (Algebra.adjoin (Lam1 A p)
        {frac A p ϖ (Polynomial.aeval (T1 A p 0) F) (m + 1)}).toSubring) 0)
        (by rw [Algebra.adjoin_eq_ring_closure]
            exact Subring.subset_closure (Set.mem_union_left _ ⟨r, rfl⟩))
    · obtain ⟨k, rfl⟩ := hx
      beta_reduce
      rcases k with _ | j
      · rw [show frac A p ϖ (Polynomial.aeval (T1 A p 0) F) 0
            = algebraMap (Lam1 A p) (Lam1Loc A p ϖ) (Polynomial.aeval (T1 A p 0) F)
            from by simp [frac]]
        exact (le_iSup (f := fun m : ℕ => (Algebra.adjoin (Lam1 A p)
          {frac A p ϖ (Polynomial.aeval (T1 A p 0) F) (m + 1)}).toSubring) 0)
          (by rw [Algebra.adjoin_eq_ring_closure]
              exact Subring.subset_closure
                (Set.mem_union_left _ ⟨Polynomial.aeval (T1 A p 0) F, rfl⟩))
      · exact (le_iSup (f := fun m : ℕ => (Algebra.adjoin (Lam1 A p)
          {frac A p ϖ (Polynomial.aeval (T1 A p 0) F) (m + 1)}).toSubring) j)
          (by rw [Algebra.adjoin_eq_ring_closure]
              exact Subring.subset_closure (Set.mem_union_right _ (Set.mem_singleton _)))
  · apply iSup_le
    intro m
    rw [Algebra.adjoin_eq_ring_closure, Subring.closure_le]
    rintro x (hx | hx)
    · obtain ⟨r, rfl⟩ := hx
      exact Subring.subset_closure (Set.mem_union_left _ ⟨r, rfl⟩)
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact frac_aeval_T1_zero_mem_CSAlgOne A p ϖ F (m + 1)

end Work.DSM2p
