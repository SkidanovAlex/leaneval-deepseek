import Mathlib
import Submission.Work.DSM2p.RootClosure

/-!
# Flatness of the `p`-th root closure of a polynomial algebra

The root-system ring `rootClosure A p ι = A[X_{i,n} | i ∈ ι, n ∈ ℕ]/(X_{i,n+1}^p - X_{i,n})`
(`RootClosure.lean`) is a *monoid algebra*, hence free and in particular flat over `A`.

The point is that the presentation of the ring is exactly a presentation of the *monoid* of
monomials: if `N = (ι × ℕ) →₀ ℕ` is the free commutative monoid on the variables and `C` is the
congruence on `N` generated by `p · e_{i,n+1} ~ e_{i,n}`, then

`rootClosure A p ι ≃ₐ[A] A[N ⧸ C]`,

where `A[N ⧸ C]` is the monoid algebra of the quotient monoid `N ⧸ C`.  Since the monoid algebra of
*any* monoid is free as a module (`MonoidAlgebra.basis`), and the relation `X_{i,n+1}^p = X_{i,n}`
of the quotient ring is precisely the relation of the monoid presentation, the two constructions
agree.  Both directions of the isomorphism are the universal properties of a quotient ring and of
a monoid algebra; no separate `p`-torsion-freeness or reduction argument is needed, and the
statement holds for every `p : ℕ` (in particular `p = 0`, where the quotient degenerates to `A`).

## Main result

* `rootClosure_flat` — `Module.Flat A (rootClosure A p ι)`.
-/

open scoped Classical

namespace Work.DSM2p

universe u

/-- The one-step relation of the presentation of the monoid of monomials of the `p`-th root
closure: the `(n+1)`-st root of the `i`-th variable, raised to the `p`-th power, is the `n`-th
root.  Here `N = (ι × ℕ) →₀ ℕ` is written multiplicatively as `Multiplicative N`, so that the
monoid algebra of a quotient of `N` is available. -/
noncomputable def rootClosureRel (p : ℕ) (ι : Type u)
    (a b : Multiplicative ((ι × ℕ) →₀ ℕ)) : Prop :=
  ∃ (i : ι) (n : ℕ),
    a = Multiplicative.ofAdd (p • Finsupp.single (i, n + 1) 1) ∧
    b = Multiplicative.ofAdd (Finsupp.single (i, n) 1)

/-- The congruence on `(ι × ℕ) →₀ ℕ` generated by the root relations `p · e_{i,n+1} ~ e_{i,n}`. -/
noncomputable def rootClosureCon (p : ℕ) (ι : Type u) :
    Con (Multiplicative ((ι × ℕ) →₀ ℕ)) :=
  conGen (rootClosureRel p ι)

/-- The monoid `⟨x_{i,n} | x_{i,n+1}^p = x_{i,n}⟩` presented by the root relations; its monoid
algebra is the root closure. -/
abbrev rootClosureMonoid (p : ℕ) (ι : Type u) : Type u := (rootClosureCon p ι).Quotient

set_option linter.style.haveILetI false in
theorem rootClosure_flat (A : Type u) [CommRing A] (p : ℕ) (ι : Type u) :
    Module.Flat A (rootClosure A p ι) := by
  classical
  -- the presenting monoid
  let C : Con (Multiplicative ((ι × ℕ) →₀ ℕ)) := rootClosureCon p ι
  let M := rootClosureMonoid p ι
  -- the monoid algebra of `M` is free, hence flat
  haveI : Module.Flat A (MonoidAlgebra A M) := Module.Flat.of_free
  -- `mono` : the monoid hom from the monomials to `A[M]`
  let mono : Multiplicative ((ι × ℕ) →₀ ℕ) →* MonoidAlgebra A M :=
    (MonoidAlgebra.of A M).comp C.mk'
  -- `f₀ : MvPolynomial (ι × ℕ) A →ₐ[A] A[M]`
  let f₀ : MvPolynomial (ι × ℕ) A →ₐ[A] MonoidAlgebra A M :=
    AddMonoidAlgebra.lift A (MonoidAlgebra A M) ((ι × ℕ) →₀ ℕ) mono
  have hf₀_mon : ∀ (s : (ι × ℕ) →₀ ℕ) (b : A),
      f₀ (MvPolynomial.monomial s b) = b • mono (Multiplicative.ofAdd s) :=
    fun s b => AddMonoidAlgebra.lift_single mono s b
  have mono_apply : ∀ x, mono x = MonoidAlgebra.single (C.mk' x) 1 :=
    fun x => MonoidAlgebra.of_apply A M x
  -- the value on the variables
  have hX : ∀ r : ι × ℕ, f₀ (MvPolynomial.X r) =
      MonoidAlgebra.single (C.mk' (Multiplicative.ofAdd (Finsupp.single r 1))) 1 := by
    intro r
    change f₀ (MvPolynomial.monomial (Finsupp.single r 1) 1) = _
    rw [hf₀_mon, one_smul, mono_apply]
  -- the defining relations land in the kernel
  have hgen : ∀ q : ι × ℕ,
      f₀ (MvPolynomial.X (q.1, q.2 + 1) ^ p - MvPolynomial.X q) = 0 := by
    intro q
    rw [map_sub, map_pow, hX (q.1, q.2 + 1), hX q]
    rw [MonoidAlgebra.single_pow]
    rw [show ((C.mk' (Multiplicative.ofAdd (Finsupp.single (q.1, q.2 + 1) 1)))^p : M) =
        C.mk' (Multiplicative.ofAdd (p • Finsupp.single (q.1, q.2 + 1) 1)) from by
      rw [← map_pow, ofAdd_nsmul]]
    rw [one_pow, sub_eq_zero]
    have hrel₀ : rootClosureRel p ι
        (Multiplicative.ofAdd (p • Finsupp.single (q.1, q.2 + 1) 1))
        (Multiplicative.ofAdd (Finsupp.single q 1)) := ⟨q.1, q.2, rfl, rfl⟩
    have hrel : C (Multiplicative.ofAdd (p • Finsupp.single (q.1, q.2 + 1) 1))
        (Multiplicative.ofAdd (Finsupp.single q 1)) :=
      ConGen.Rel.of (Multiplicative.ofAdd (p • Finsupp.single (q.1, q.2 + 1) 1))
        (Multiplicative.ofAdd (Finsupp.single q 1)) hrel₀
    have h2 : (Con.ker C.mk') (Multiplicative.ofAdd (p • Finsupp.single (q.1, q.2 + 1) 1))
        (Multiplicative.ofAdd (Finsupp.single q 1)) := by
      rw [Con.mk'_ker]; exact hrel
    rw [Con.ker_rel] at h2
    rw [h2]
  have hI : ∀ a ∈ rootClosureIdeal A p ι,
      (f₀ : MvPolynomial (ι × ℕ) A →+* MonoidAlgebra A M) a = 0 := by
    have hspan : rootClosureIdeal A p ι ≤
        RingHom.ker (f₀ : MvPolynomial (ι × ℕ) A →+* MonoidAlgebra A M) := by
      rw [rootClosureIdeal, Ideal.span_le]
      rintro _ ⟨q, rfl⟩
      exact RingHom.mem_ker.mpr (hgen q)
    exact fun a ha => RingHom.mem_ker.mp (hspan ha)
  -- `f : (MvPolynomial (ι × ℕ) A) ⧸ I →ₐ[A] A[M]`
  let f : MvPolynomial (ι × ℕ) A ⧸ rootClosureIdeal A p ι →ₐ[A] MonoidAlgebra A M :=
    Ideal.Quotient.liftₐ (rootClosureIdeal A p ι) f₀ hI
  have f_mk : ∀ x : MvPolynomial (ι × ℕ) A,
      f (Ideal.Quotient.mk (rootClosureIdeal A p ι) x) = f₀ x := fun x => by
    change (Ideal.Quotient.lift (rootClosureIdeal A p ι)
      (f₀ : MvPolynomial (ι × ℕ) A →+* MonoidAlgebra A M) hI) (Ideal.Quotient.mk _ x) = f₀ x
    rw [Ideal.Quotient.lift_mk]
    exact congrFun (AlgHom.coe_toRingHom f₀) x
  -- `h₀ : N →* (MvPolynomial (ι × ℕ) A) ⧸ I`, the monomial `n` goes to the class of `X ^ n`
  let h₀ : Multiplicative ((ι × ℕ) →₀ ℕ) →*
      (MvPolynomial (ι × ℕ) A ⧸ rootClosureIdeal A p ι) :=
    { toFun := fun x => Ideal.Quotient.mk (rootClosureIdeal A p ι)
        (MvPolynomial.monomial (Multiplicative.toAdd x) 1)
      map_one' := by
        show Ideal.Quotient.mk (rootClosureIdeal A p ι)
            (MvPolynomial.monomial
              (Multiplicative.toAdd (1 : Multiplicative ((ι × ℕ) →₀ ℕ))) 1) = 1
        rw [toAdd_one]
        show Ideal.Quotient.mk (rootClosureIdeal A p ι)
            (MvPolynomial.monomial (0 : (ι × ℕ) →₀ ℕ) 1) = 1
        rw [← MvPolynomial.one_def]
        rfl
      map_mul' := fun x y => by
        rw [toAdd_mul, ← map_mul, MvPolynomial.monomial_mul_monomial, mul_one] }
  have h₀_apply : ∀ x : Multiplicative ((ι × ℕ) →₀ ℕ), h₀ x =
      Ideal.Quotient.mk (rootClosureIdeal A p ι)
        (MvPolynomial.monomial (Multiplicative.toAdd x) 1) :=
    fun x => rfl
  -- `h₀` is constant on the classes of `C`
  have hH : C ≤ Con.ker h₀ := by
    rw [show C = conGen (rootClosureRel p ι) from rfl, Con.conGen_le]
    rintro a b ⟨i, n, ha, hb⟩
    rw [ha, hb]
    change h₀ (Multiplicative.ofAdd (p • Finsupp.single (i, n + 1) 1)) =
      h₀ (Multiplicative.ofAdd (Finsupp.single (i, n) 1))
    rw [show Multiplicative.ofAdd (p • Finsupp.single (i, n + 1) 1) =
        (Multiplicative.ofAdd (Finsupp.single (i, n + 1) 1)) ^ p from ofAdd_nsmul p _]
    rw [map_pow, h₀_apply, toAdd_ofAdd, h₀_apply, toAdd_ofAdd]
    change (Ideal.Quotient.mk (rootClosureIdeal A p ι) (MvPolynomial.X (i, n + 1)))^p =
      Ideal.Quotient.mk (rootClosureIdeal A p ι) (MvPolynomial.X (i, n))
    exact rootClosure.X_pow A p ι i n
  -- `h : M →* (MvPolynomial (ι × ℕ) A) ⧸ I` and `g : A[M] →ₐ[A] (MvPolynomial (ι × ℕ) A) ⧸ I`
  let h : M →* (MvPolynomial (ι × ℕ) A ⧸ rootClosureIdeal A p ι) := C.lift h₀ hH
  let g : MonoidAlgebra A M →ₐ[A] MvPolynomial (ι × ℕ) A ⧸ rootClosureIdeal A p ι :=
    MonoidAlgebra.lift A _ M h
  have g_single : ∀ (m : M) (b : A), g (MonoidAlgebra.single m b) = b • h m :=
    fun m b => MonoidAlgebra.lift_single h m b
  have h_mk' : ∀ y : Multiplicative ((ι × ℕ) →₀ ℕ), h (C.mk' y) = h₀ y :=
    fun y => Con.lift_mk' hH y
  -- `g ∘ f₀` is the quotient map
  have key : g.comp f₀ = Ideal.Quotient.mkₐ A (rootClosureIdeal A p ι) := by
    apply MvPolynomial.algHom_ext
    intro r
    rw [AlgHom.comp_apply, hX r, g_single, one_smul, h_mk', h₀_apply, toAdd_ofAdd]
    rw [Ideal.Quotient.mkₐ_eq_mk]
    rfl
  -- hence `g ∘ f = id`
  have hgf : g.comp f = AlgHom.id A (MvPolynomial (ι × ℕ) A ⧸ rootClosureIdeal A p ι) := by
    apply AlgHom.ext
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective (I := rootClosureIdeal A p ι) x
    rw [AlgHom.comp_apply, f_mk]
    simpa only [AlgHom.comp_apply, AlgHom.id_apply, Ideal.Quotient.mkₐ_eq_mk] using
      AlgHom.congr_fun key y
  -- and `f ∘ g = id`
  have hfg_pt : ∀ z : MonoidAlgebra A M, f (g z) = z := by
    intro z
    refine MonoidAlgebra.induction_on (motive := fun z => f (g z) = z) z ?_ ?_ ?_
    · intro m
      obtain ⟨y, rfl⟩ := Con.mk'_surjective (c := C) m
      rw [MonoidAlgebra.of_apply]
      rw [g_single, one_smul, h_mk', h₀_apply, f_mk, hf₀_mon, one_smul, mono_apply, ofAdd_toAdd]
    · intro a b ha hb
      rw [map_add, map_add, ha, hb]
    · intro r a ha
      rw [map_smul, map_smul, ha]
  have hfg : f.comp g = AlgHom.id A (MonoidAlgebra A M) := AlgHom.ext hfg_pt
  -- transfer flatness along the algebra equivalence
  exact Module.Flat.of_linearEquiv (AlgEquiv.ofAlgHom f g hfg hgf).toLinearEquiv

end Work.DSM2p
