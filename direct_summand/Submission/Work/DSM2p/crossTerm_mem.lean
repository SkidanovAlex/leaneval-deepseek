import Mathlib

/-!
# The cross terms of `(x + y) ^ p` in a subring, for `p` prime

For `p` prime, `(x + y) ^ p - x ^ p - y ^ p = p * h` where `h` is a polynomial in `x, y`
with *integer* coefficients (the binomial coefficients `p.choose k`, `0 < k < p`, are all
divisible by `p`).  Consequently, if `x` and `y` lie in a subring `S`, then so does the
cofactor `h`; equivalently `p * h ∈ p * S`.

This is Mathlib's `add_pow_prime_eq'`, which exhibits the cofactor explicitly as a finite
sum with coefficients `↑(p.choose k / p)` — no division by `p` in `R` is involved, so the
statement is valid in every characteristic (in particular `p = 0` in `R`, where the
cofactor may be taken to be `0`).

The point of isolating this is that it is exactly what makes
`{x | ∃ y ∈ R, x - y ^ p ∈ ϖ ^ p · R}` a *subring* for the tower of the
Česnavičius–Scholze `p-oid-rec` argument: the Frobenius is additive modulo the ideal
generated by `p`, with the cofactor staying inside the ring.
-/

namespace Work.DSM2p

/-- **The cross terms of `(x + y) ^ p` lie in `p * S`.**  For `p` prime and `x, y` in a
subring `S` of a commutative ring `R`, the element `(x + y) ^ p - x ^ p - y ^ p` is `p` times
an element of `S`. -/
theorem crossTerm_mem {R : Type*} [CommRing R] {p : ℕ} (hp : p.Prime) (S : Subring R) {x y : R}
    (hx : x ∈ S) (hy : y ∈ S) :
    ∃ h ∈ S, (x + y) ^ p - x ^ p - y ^ p = (p : R) * h := by
  have hcoeff : ∀ n : ℕ, (n : R) ∈ S := fun n => by
    simpa using S.intCast_mem (n : ℤ)
  refine ⟨∑ k ∈ Finset.Ioo 0 p, x ^ k * y ^ (p - k) * ↑(p.choose k / p : ℕ), ?_, ?_⟩
  · exact S.sum_mem fun k _ =>
      S.mul_mem (S.mul_mem (S.pow_mem hx k) (S.pow_mem hy (p - k))) (hcoeff _)
  · rw [add_pow_prime_eq' hp x y]
    ring

/-- `(-y) ^ (p ^ n) + y ^ (p ^ n)` is `p` times an element of `S`: it is `0` when `p` is odd
(and when `p = 2, n = 0`) and `2 * y ^ (2 ^ n)` when `p = 2`, `n ≥ 1`. -/
theorem neg_pow_add_pow_mem {R : Type*} [CommRing R] {p : ℕ} (hp : p.Prime) (S : Subring R)
    (n : ℕ) {y : R} (hy : y ∈ S) :
    ∃ h ∈ S, (-y) ^ (p ^ n) + y ^ (p ^ n) = (p : R) * h := by
  rcases hp.eq_two_or_odd with h2 | hodd
  · subst h2
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      exact ⟨0, S.zero_mem, by norm_num⟩
    · obtain ⟨m, hm⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.succ_pred_eq_of_pos hn).symm⟩
      subst hm
      refine ⟨y ^ (2 ^ (m + 1)), S.pow_mem hy _, ?_⟩
      rw [Even.neg_pow ⟨2 ^ m, by rw [Nat.pow_succ']; ring⟩]
      ring
  · refine ⟨0, S.zero_mem, ?_⟩
    rw [Odd.neg_pow (Odd.pow (Nat.odd_iff.mpr hodd))]
    ring

/-- **The `p ^ n`-th power version.**  For `p` prime and `x, y` in a subring `S`,
`(x - y) ^ (p ^ n) - x ^ (p ^ n) + y ^ (p ^ n)` is `p` times an element of `S`.  This is what
lets the cofactor of `(v₁ ^ p) ^ (p ^ m) = (v - ϖ ^ p c) ^ (p ^ m)` be kept inside the ring in
the induction step of the Česnavičius–Scholze tower. -/
theorem pow_sub_pow_mem {R : Type*} [CommRing R] {p : ℕ} (hp : p.Prime) (S : Subring R) (n : ℕ)
    {x y : R} (hx : x ∈ S) (hy : y ∈ S) :
    ∃ h ∈ S, (x - y) ^ (p ^ n) - x ^ p ^ n + y ^ p ^ n = (p : R) * h := by
  have hcoeff : ∀ m : ℕ, (m : R) ∈ S := fun m => by simpa using S.intCast_mem (m : ℤ)
  have hH : (∑ k ∈ Finset.Ioo 0 (p ^ n), x ^ k * (-y) ^ (p ^ n - k)
      * ↑((p ^ n).choose k / p : ℕ)) ∈ S :=
    S.sum_mem fun k _ => S.mul_mem
      (S.mul_mem (S.pow_mem hx k) (S.pow_mem (S.neg_mem hy) _)) (hcoeff _)
  have key : (x + -y) ^ (p ^ n)
      = x ^ (p ^ n) + (-y) ^ (p ^ n)
        + (p : R) * ∑ k ∈ Finset.Ioo 0 (p ^ n), x ^ k * (-y) ^ (p ^ n - k)
            * ↑((p ^ n).choose k / p : ℕ) := add_pow_prime_pow_eq' hp x (-y) n
  obtain ⟨h₁, hh₁, hh₁eq⟩ := neg_pow_add_pow_mem hp S n hy
  refine ⟨h₁ + ∑ k ∈ Finset.Ioo 0 (p ^ n), x ^ k * (-y) ^ (p ^ n - k)
      * ↑((p ^ n).choose k / p : ℕ), S.add_mem hh₁ hH, ?_⟩
  have hsub : x + -y = x - y := by ring
  rw [← hsub, key]
  linear_combination hh₁eq

end Work.DSM2p
