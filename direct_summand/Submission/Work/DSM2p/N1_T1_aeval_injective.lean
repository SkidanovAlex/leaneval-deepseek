import Mathlib
import Submission.Work.DSM2p.LamOne
import Submission.Work.DSM2p.N1_defs

/-!
# `Work.DSM2p.N1_T1_aeval_injective`

Let `Λ = Lam1 A p = A[T^{1/p^∞}]` and `T1 A p n = T^{1/p^n}`.  The node `N1` of the design
needs that `T^{1/p^n}` is *transcendental* over `A`, i.e. that

`Polynomial.aeval (T1 A p n) : A[X] → Λ`,   `X ↦ T^{1/p^n}`

is injective — a polynomial relation between the coefficients of `A` and `T^{1/p^n}` would have
to hold for *every* coefficient ring `A`.

## The argument

The ideal of relations is generated by `X_{m+1}^p - X_m`, so it suffices to exhibit an
`A`-algebra `B` with an element `u` such that

* the assignment `X_m ↦ p^{-m}` is a compatible system of `p`-th power roots in `B`
  (then the induced map `Λ ⟶ B` is well defined), and
* the powers of `u = p^{-n}` are pairwise distinct basis elements of `B` (then
  `Polynomial.aeval u` is injective).

The natural choice is the monoid algebra `B = A[ℚ]` of the *additive* monoid `ℚ`, in which
`AddMonoidAlgebra.of (Multiplicative.ofAdd x)` has `p`-th power
`AddMonoidAlgebra.of (Multiplicative.ofAdd (p • x))`; and `p • p^{-(m+1)} = p^{-m}`.  The
elements `single (d • p^{-n}) 1` for `d ∈ ℕ` are distinct basis vectors because `p^{-n} ≠ 0`
in `ℚ`.

## Main result

* `N1_T1_aeval_injective`.
-/

open scoped Classical

namespace Work.DSM2p

universe u

/-- **Step 1 (the witness computation).**  In the monoid algebra `A[ℚ]` of the additive monoid
`ℚ`, for `q ≠ 0` the powers of the basis element `of (ofAdd q)` are the *distinct* basis
elements `single (i • q) 1`; consequently `Polynomial.aeval (of (ofAdd q))` has trivial
kernel. -/
private lemma aeval_ofAdd_eq_zero (A : Type u) [CommRing A] (q : ℚ) (hq : q ≠ 0)
    (f : Polynomial A) :
    (Polynomial.aeval (AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd q)) :
      Polynomial A →ₐ[A] AddMonoidAlgebra A ℚ) f = 0 → f = 0 := by
  intro hf
  -- the powers of `of (ofAdd q)` are the distinct basis elements `single (i • q) 1`
  have hpow : ∀ i : ℕ,
      (AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd q) : AddMonoidAlgebra A ℚ) ^ i
        = AddMonoidAlgebra.single (i • q) (1 : A) := by
    intro i
    rw [← map_pow, ← ofAdd_nsmul, AddMonoidAlgebra.of_apply, toAdd_ofAdd]
  -- the value of `aeval` on a polynomial, expanded in the monomial basis
  have hsum : (Polynomial.aeval (AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd q)) :
        Polynomial A →ₐ[A] AddMonoidAlgebra A ℚ) f = ∑ i ∈ f.support,
        AddMonoidAlgebra.single (i • q) (Polynomial.coeff f i) := by
    conv_lhs => rw [Polynomial.as_sum_support f]
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Polynomial.aeval_monomial, ← Algebra.smul_def, hpow i, AddMonoidAlgebra.smul_single]
    simp
  -- consequently, on coefficients `aeval` is `Finsupp.mapDomain` along `i ↦ i • q`
  have hcoeff : ((Polynomial.aeval (AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd q)) :
        Polynomial A →ₐ[A] AddMonoidAlgebra A ℚ) f).coeff
      = Finsupp.mapDomain (fun i : ℕ => i • q) (Polynomial.coeff f) := by
    rw [hsum, AddMonoidAlgebra.coeff_sum]
    simp only [Finsupp.mapDomain, Finsupp.sum, AddMonoidAlgebra.coeff_single]
    exact Finset.sum_congr rfl fun i _ => rfl
  -- `i ↦ i • q` is injective for `q ≠ 0`
  have hqinj : Function.Injective fun i : ℕ => i • q := by
    intro i i' h
    have h' : (i : ℚ) * q = (i' : ℚ) * q := by simpa using h
    exact Nat.cast_injective (mul_right_cancel₀ hq h')
  -- extract the triviality of the kernel
  have h1 : Finsupp.mapDomain (fun i : ℕ => i • q) (Polynomial.coeff f) = 0 := by
    rw [← hcoeff, hf]; simp
  have h2 : Polynomial.coeff f = 0 := by
    rw [← Finsupp.mapDomain_zero (f := fun i : ℕ => i • q)] at h1
    exact Finsupp.mapDomain_injective hqinj h1
  have h3 : Polynomial.coeff f = Polynomial.coeff (0 : Polynomial A) := by
    rw [h2]; ext n; simp
  exact Polynomial.coeff_injective h3

theorem N1_T1_aeval_injective (A : Type*) [CommRing A] (p : ℕ) (hp : 1 < p) (n : ℕ) :
    Function.Injective (Polynomial.aeval (T1 A p n) : Polynomial A →ₐ[A] Lam1 A p) := by
  classical
  have hp0 : (p : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hq : ((p : ℚ))⁻¹ ^ n ≠ 0 := pow_ne_zero _ (inv_ne_zero hp0)
  -- the witness map `Φ : MvPolynomial (PUnit × ℕ) A →ₐ[A] A[ℚ]`, `X_{⋆,m} ↦ p^{-m}`
  set Φ : MvPolynomial (PUnit × ℕ) A →ₐ[A] AddMonoidAlgebra A ℚ :=
    MvPolynomial.aeval fun r : PUnit × ℕ =>
      AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd (((p : ℚ))⁻¹ ^ r.2)) with hΦ
  have hΦX : ∀ m : ℕ, Φ (MvPolynomial.X (PUnit.unit, m))
      = AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd (((p : ℚ))⁻¹ ^ m)) := by
    intro m
    rw [hΦ]
    exact MvPolynomial.aeval_X _ _
  -- `Φ` kills the ideal of relations `X_{m+1}^p - X_m`
  have hker : ∀ x ∈ rootClosureIdeal A p PUnit, Φ x = 0 := by
    have hgen : ∀ r : PUnit × ℕ,
        Φ (MvPolynomial.X (r.1, r.2 + 1) ^ p - MvPolynomial.X r) = 0 := by
      intro r
      have hrel : p • (((p : ℚ))⁻¹ ^ (r.2 + 1)) = ((p : ℚ))⁻¹ ^ r.2 := by
        rw [nsmul_eq_mul, pow_succ', ← mul_assoc, mul_inv_cancel₀ hp0, one_mul]
      rw [map_sub, map_pow, hΦX (r.2 + 1), hΦX r.2, ← map_pow, ← ofAdd_nsmul, hrel,
        sub_self]
    have hspan : rootClosureIdeal A p PUnit ≤
        RingHom.ker (Φ : MvPolynomial (PUnit × ℕ) A →+* AddMonoidAlgebra A ℚ) := by
      rw [rootClosureIdeal, Ideal.span_le]
      rintro _ ⟨r, rfl⟩
      exact RingHom.mem_ker.mpr (hgen r)
    intro x hx
    exact RingHom.mem_ker.mp (hspan hx)
  -- the composite `A[X] → Λ → A[ℚ]` is `aeval` at `p^{-n}`
  have hcomp : Φ.comp (Polynomial.aeval (MvPolynomial.X (PUnit.unit, n)))
      = Polynomial.aeval
          (AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd (((p : ℚ))⁻¹ ^ n))) := by
    apply Polynomial.algHom_ext
    simp only [AlgHom.comp_apply, Polynomial.aeval_X]
    exact hΦX n
  -- `aeval (T1 A p n)` is the quotient map composed with `aeval X_{⋆,n}`
  have hident : (Polynomial.aeval (T1 A p n) : Polynomial A →ₐ[A] Lam1 A p)
      = (Ideal.Quotient.mkₐ A (rootClosureIdeal A p PUnit)).comp
          (Polynomial.aeval (MvPolynomial.X (PUnit.unit, n))) := by
    apply Polynomial.algHom_ext
    simp [T1, Ideal.Quotient.mkₐ_eq_mk]
  -- trivial kernel of `aeval (T1 A p n)`
  have key : ∀ f : Polynomial A,
      (Polynomial.aeval (T1 A p n) : Polynomial A →ₐ[A] Lam1 A p) f = 0 → f = 0 := by
    intro f hf
    have hidentf : (Polynomial.aeval (T1 A p n) : Polynomial A →ₐ[A] Lam1 A p) f
        = Ideal.Quotient.mk (rootClosureIdeal A p PUnit)
            (Polynomial.aeval (MvPolynomial.X (PUnit.unit, n)) f) := by
      have h' := AlgHom.congr_fun hident f
      rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h'
      exact h'
    have hmk : Ideal.Quotient.mk (rootClosureIdeal A p PUnit)
        (Polynomial.aeval (MvPolynomial.X (PUnit.unit, n)) f) = 0 := by
      rw [← hidentf]; exact hf
    have hmem : Polynomial.aeval (MvPolynomial.X (PUnit.unit, n)) f ∈
        rootClosureIdeal A p PUnit := Ideal.Quotient.eq_zero_iff_mem.mp hmk
    have hΦ0 : Φ (Polynomial.aeval (MvPolynomial.X (PUnit.unit, n)) f) = 0 := hker _ hmem
    have h2 : (Polynomial.aeval
          (AddMonoidAlgebra.of A ℚ (Multiplicative.ofAdd (((p : ℚ))⁻¹ ^ n))) :
          Polynomial A →ₐ[A] AddMonoidAlgebra A ℚ) f = 0 := by
      have h' := AlgHom.congr_fun hcomp f
      rw [AlgHom.comp_apply] at h'
      rw [← h', hΦ0]
    exact aeval_ofAdd_eq_zero A (((p : ℚ))⁻¹ ^ n) hq f h2
  intro f g hfg
  exact sub_eq_zero.mp (key (f - g) (by rw [map_sub, hfg, sub_self]))

end Work.DSM2p
