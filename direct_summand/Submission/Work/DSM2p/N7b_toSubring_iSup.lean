import Mathlib

namespace Work.DSM2p

theorem N7b_toSubring_iSup {C L : Type*} [CommRing C] [CommRing L] [Algebra C L]
    (x : ℕ → L) (hmono : ∀ j, x j ∈ Algebra.adjoin C {x (j + 1)}) :
    (⨆ j, Algebra.adjoin C {x j}).toSubring = ⨆ j, (Algebra.adjoin C {x j}).toSubring := by
  -- The supremum of the subalgebras `Algebra.adjoin C {x j}` is `Algebra.adjoin C (Set.range x)`.
  have hsup : (⨆ j, Algebra.adjoin C {x j}) = Algebra.adjoin C (Set.range x) := by
    rw [← Algebra.adjoin_iUnion (s := fun j => ({x j} : Set L)), Set.iUnion_singleton_eq_range]
  -- Rewrite both sides: a subalgebra generated by `s` has underlying subring the
  -- subring generated by `algebraMap C L '' C ∪ s`.
  rw [hsup, Algebra.adjoin_eq_ring_closure]
  simp only [Algebra.adjoin_eq_ring_closure]
  -- The supremum of the subrings `Subring.closure (R0 ∪ {x j})` is the closure of their union.
  rw [← Subring.closure_iUnion]
  congr 1
  -- It remains to identify `R0 ∪ Set.range x` with `⋃ j, (R0 ∪ {x j})`.
  ext y
  simp only [Set.mem_union, Set.mem_range, Set.mem_iUnion, Set.mem_singleton_iff]
  constructor
  · rintro (h | ⟨j, hj⟩)
    · exact ⟨0, Or.inl h⟩
    · exact ⟨j, Or.inr hj.symm⟩
  · rintro ⟨j, h | h⟩
    · exact Or.inl h
    · exact Or.inr ⟨j, h.symm⟩

end Work.DSM2p
