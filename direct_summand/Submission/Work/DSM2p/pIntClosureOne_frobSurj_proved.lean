import Mathlib
import Submission.Work.DSM2p.One
import Submission.Work.DSM2p.LamOne
import Submission.Work.DSM2p.POidRec
import Submission.Work.DSM2p.POidRecStep
import Submission.Work.DSM2p.POidRecClosed
import Submission.Work.DSM2p.exists_eq_add_varpi_mul_of_pow_mem_CSAlgPos
import Submission.Work.DSM2p.N5a_PERFD_Lam1_Q
import Submission.Work.DSM2p.frobSurj_rootClosurePos
import Submission.Work.DSM2p.POidRecOne
import Submission.Work.DSM2p.exists_CSAlgOne_add_varpi_pow_mul_decomp
import Submission.Work.DSM2p.isFrobModROne_csTowerSupOne
import Submission.Work.DSM2p.csTowerSupOne_eq_CSIntegralClosureOne

/-!
# Frobenius surjectivity of `A'_F = CSIntegralClosureOne A p (P.ϖ 0) F` modulo `(ϖ ^ p)`

The target of this file is the one-polynomial instance `(H1)` of the Česnavičius–Scholze
`p-oid-rec` argument (arXiv:1912.10932, §"`p`-integral closedness of perfectoid rings"): every
element of the `p`-integral closure `A'_F = pIntClosure p (CSAlgOne A p ϖ F)` of the
construction ring `A_∞ = Λ[F(T)/ϖ^m]` inside `Λ[1/ϖ]` (`Λ = Lam1 A p = A[T^{1/p^∞}]`) is a
`p`-th power modulo the ideal generated by the image of `ϖ ^ p`.

This is the exact one-variable analogue of `exists_frob_of_CSIntegralClosurePos` (the
multi-variable case, whose proof is in `CSCompletionPos_frobSurj.lean` via
`POidRec`/`POidRecStep`/`POidRecClosed`), obtained by transcribing that development to
`Λ = rootClosure A p PUnit`:

* `POidRecOne` — the Česnavičius–Scholze tower `csTowerOne F` starting at `A_∞`, its union
  `csTowerSupOne F`, and the subring `frobSubROne F R` of elements congruent modulo `ϖ ^ p` to
  a `p`-th power of an element of `R` (with cofactor in `R ⊔ A_∞`);
* `exists_CSAlgOne_add_varpi_pow_mul_decomp` — `A_∞ = Λ + ϖ ^ p A_∞`;
* `isFrobModROne_csTowerSupOne` — the union `csTowerSupOne F` is Frobenius-surjective modulo
  `ϖ ^ p` (base case `A_∞` plus the tower step);
* `csTowerSupOne_eq_CSIntegralClosureOne` — `csTowerSupOne F = A'_F`.

The two remaining ingredients are pure bookkeeping: `ψ 0 = ϖ` inside `Λ[1/ϖ]`, and the coercion
of `algebraMap A A'_F a` into `Λ[1/ϖ]` is `algebraMap A (Λ[1/ϖ]) a`.
-/

open scoped Classical

namespace Work.DSM2p

/-- `ψ 0` is the image of `ϖ` under `A → Λ[1/ϖ]`. -/
theorem psiOne_zero_eq_algebraMap (A : Type*) [CommRing A] (p : ℕ) [Fact p.Prime]
    (P : DSMap.PerfectoidData p A) :
    psiOne (p := p) (A := A) (P := P) 0 = algebraMap A (Lam1Loc A p (P.ϖ 0)) (P.ϖ 0) := by
  rw [psiOne_zero]
  exact (IsScalarTower.algebraMap_apply A (Lam1 A p) (Lam1Loc A p (P.ϖ 0)) (P.ϖ 0)).symm

/-- The coercion of `algebraMap A A'_F a` into `Λ[1/ϖ]` is `algebraMap A (Λ[1/ϖ]) a`. -/
theorem coe_algebraMap_CSIntegralClosureOne (A : Type*) [CommRing A] (p : ℕ) [Fact p.Prime]
    (P : DSMap.PerfectoidData p A) (F : Polynomial A) (a : A) :
    ((algebraMap A ↥(CSIntegralClosureOne A p (P.ϖ 0) F) a :
        ↥(CSIntegralClosureOne A p (P.ϖ 0) F)) : Lam1Loc A p (P.ϖ 0))
      = algebraMap A (Lam1Loc A p (P.ϖ 0)) a := rfl

theorem pIntClosureOne_frobSurj_proved (A : Type*) [CommRing A] (p : ℕ) [Fact p.Prime]
    (P : DSMap.PerfectoidData p A) (F : Polynomial A) :
    ∀ x : ↥(CSIntegralClosureOne A p (P.ϖ 0) F), ∃ y : ↥(CSIntegralClosureOne A p (P.ϖ 0) F),
      x - y ^ p ∈ Ideal.span {algebraMap A ↥(CSIntegralClosureOne A p (P.ϖ 0) F) (P.ϖ 0 ^ p)} := by
  intro x
  -- `csTowerSupOne F = A'_F`, and every element of the union is a `p`-th power mod `ϖ ^ p`
  have hEq := csTowerSupOne_eq_CSIntegralClosureOne A p P F
  have hFrob := isFrobModROne_csTowerSupOne A p P F
  have hmem : ((x : ↥(CSIntegralClosureOne A p (P.ϖ 0) F)) : Lam1Loc A p (P.ϖ 0)) ∈
      csTowerSupOne (p := p) (A := A) (P := P) F := hEq.symm ▸ x.2
  obtain ⟨y, hy, c, hc, hxy⟩ := mem_frobSubROne.mp (hFrob hmem)
  -- the cofactor lands again in the union, which contains `A_∞`
  have hc' : c ∈ csTowerSupOne (p := p) (A := A) (P := P) F := by
    rwa [sup_eq_left.mpr (csTowerOne_zero_le_csTowerSupOne F)] at hc
  -- `ϖ ^ p`, viewed in `A'_F`, has underlying element `ψ 0 ^ p` in `Λ[1/ϖ]`
  have hcoeff : ((algebraMap A ↥(CSIntegralClosureOne A p (P.ϖ 0) F) (P.ϖ 0 ^ p) :
      ↥(CSIntegralClosureOne A p (P.ϖ 0) F)) : Lam1Loc A p (P.ϖ 0))
      = (psiOne (p := p) (A := A) (P := P) 0) ^ p := by
    rw [map_pow, Subring.coe_pow, coe_algebraMap_CSIntegralClosureOne, psiOne_zero_eq_algebraMap]
  refine ⟨⟨y, hEq ▸ hy⟩, Ideal.mem_span_singleton.mpr ⟨⟨c, hEq ▸ hc'⟩, ?_⟩⟩
  apply Subtype.ext
  simp only [AddSubgroupClass.coe_sub, Subring.coe_pow, Subring.coe_mul, hcoeff]
  exact hxy

end Work.DSM2p
