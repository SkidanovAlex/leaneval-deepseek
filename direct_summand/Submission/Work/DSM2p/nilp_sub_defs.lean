import Mathlib

/-!
# Auxiliary vocabulary for `Work.DSM2p.nilp_lem_subring`

`B` is a commutative ring, `A ⊆ B` a subring, `a ∈ B`.  This file sets up the subring

  `awaySubring A a ⊆ Localization.Away a`

generated by the image of `A` and `a⁻¹` — i.e. the ring `A[a⁻¹]` sitting inside `B[a⁻¹]`.
This is the ring whose primes witness that `ϖ` is not a unit, which is what the two auxiliary
lemmas (`nilp_sub_auxA`, `nilp_sub_auxB`) consume.
-/

noncomputable section

namespace Work.DSM2p

open scoped Classical

/-- `A[a⁻¹]` inside `B[a⁻¹]`: the subring generated by the image of `A` and the inverse of `a`. -/
def awaySubring {B : Type*} [CommRing B] (A : Subring B) (a : B) : Subring (Localization.Away a) :=
  Subring.closure (Set.range (fun x : A => algebraMap B (Localization.Away a) (x : B))
    ∪ {IsLocalization.Away.invSelf a})

theorem algebraMap_mem_awaySubring {B : Type*} [CommRing B] (A : Subring B) (a : B) (x : A) :
    algebraMap B (Localization.Away a) (x : B) ∈ awaySubring A a :=
  Subring.subset_closure (Or.inl ⟨x, rfl⟩)

theorem invSelf_mem_awaySubring {B : Type*} [CommRing B] (A : Subring B) (a : B) :
    IsLocalization.Away.invSelf a ∈ awaySubring A a :=
  Subring.subset_closure (Or.inr rfl)

theorem varpi_mem_awaySubring {B : Type*} [CommRing B] (A : Subring B) {ϖ : B} (a : B)
    (hϖA : ϖ ∈ A) : algebraMap B (Localization.Away a) ϖ ∈ awaySubring A a :=
  algebraMap_mem_awaySubring A a ⟨ϖ, hϖA⟩

end Work.DSM2p
