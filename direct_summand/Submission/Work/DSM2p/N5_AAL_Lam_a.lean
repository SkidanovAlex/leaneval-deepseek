import Mathlib
import Submission.Work.DSM2p.N5_helpers
import Submission.Work.DSM2p.N5b_mem_of_map_mem

namespace Work.DSM2p

/-- **Elementary step of `N5_AAL_Lam_a`.**  Let `φ : R →+* S` be a ring homomorphism,
`Qr : ℕ → S` a compatible system of `p`-th roots (`Qr (j+1) ^ p = Qr j`) and `qq : ℕ → R`
a family whose `φ`-images are congruent to `Qr` modulo the ideal generated by `φ z ^ K`.
Then `φ (qq (j+1) ^ p - qq j)` lies in the ideal generated by `φ (z ^ (m+1))`, provided
`m + 1 ≤ K`.

Indeed `φ (qq (j+1)) ^ p - Qr (j+1) ^ p` is divisible by `φ (qq (j+1)) - Qr (j+1)`, hence
lies in `(φ z ^ K)`, and `Qr (j+1) ^ p = Qr j`; adding `Qr j - φ (qq j)` yields
`φ (qq (j+1) ^ p - qq j)`.  Since `K ≥ m + 1`, the ideal `(φ z ^ K)` is contained in
`(φ (z ^ (m+1)))`. -/
theorem map_sub_pow_mem_span_of_le {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (p m K : ℕ) (hKm : m + 1 ≤ K) (z : R) (Qr : ℕ → S) (qq : ℕ → R)
    (hroot : ∀ j, Qr (j + 1) ^ p = Qr j)
    (hq : ∀ j, Qr j - φ (qq j) ∈ Ideal.span {φ z ^ K}) (j : ℕ) :
    φ (qq (j + 1) ^ p - qq j) ∈ Ideal.span {φ (z ^ (m + 1))} := by
  have h1 : Qr (j + 1) - φ (qq (j + 1)) ∈ Ideal.span {φ z ^ K} := hq (j + 1)
  have h2 : Qr j - φ (qq j) ∈ Ideal.span {φ z ^ K} := hq j
  have hb : φ z ^ K ∣ Qr (j + 1) - φ (qq (j + 1)) := Ideal.mem_span_singleton.mp h1
  have hdiv : φ z ^ K ∣ φ (qq (j + 1)) - Qr (j + 1) := by
    have h : φ z ^ K ∣ -(Qr (j + 1) - φ (qq (j + 1))) := dvd_neg.mpr hb
    rwa [neg_sub] at h
  have h3 : φ (qq (j + 1)) ^ p - Qr (j + 1) ^ p ∈ Ideal.span {φ z ^ K} :=
    Ideal.mem_span_singleton.mpr (dvd_trans hdiv (sub_dvd_pow_sub_pow _ _ p))
  have key : φ (qq (j + 1) ^ p - qq j) = (φ (qq (j + 1)) ^ p - Qr (j + 1) ^ p)
      + (Qr j - φ (qq j)) := by
    rw [map_sub, map_pow, hroot j]; ring
  have hstep : φ (qq (j + 1) ^ p - qq j) ∈ Ideal.span {φ z ^ K} := by
    rw [key]
    exact Ideal.add_mem _ h3 h2
  have hle : Ideal.span {φ z ^ K} ≤ Ideal.span {φ (z ^ (m + 1))} := by
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton, ← map_pow]
    exact map_dvd φ (pow_dvd_pow z hKm)
  exact hle hstep

theorem N5_AAL_Lam_a (A : Type*) [CommRing A] (p : ℕ) [Fact p.Prime]
    (P : DSMap.PerfectoidData p A) (m : ℕ)
    (Q : DSMap.PerfectoidData p (AdicCompletion (Ideal.span {(p : Lam1 A p)}) (Lam1 A p)))
    (hQ : ∀ k, Q.ϖ k = algebraMap A
      (AdicCompletion (Ideal.span {(p : Lam1 A p)}) (Lam1 A p)) (P.ϖ k))
    (Qr : ℕ → AdicCompletion (Ideal.span {(p : Lam1 A p)}) (Lam1 A p))
    (hroot : ∀ j, Qr (j + 1) ^ p = Qr j)
    (q : ℕ → Lam1 A p) (K : ℕ) (hK : m + 1 ≤ K)
    (hq : ∀ j, Qr j - algebraMap (Lam1 A p)
        (AdicCompletion (Ideal.span {(p : Lam1 A p)}) (Lam1 A p)) (q j) ∈
      Ideal.span {Q.ϖ 0 ^ K}) :
    ∀ j, q (j + 1) ^ p - q j ∈
      Ideal.span {algebraMap A (Lam1 A p) (P.ϖ 0 ^ (m + 1))} := by
  classical
  intro j
  have hp1 : 1 ≤ p := (Fact.out : p.Prime).one_le
  -- Abbreviations: `w = ϖ_0` in `Λ` and `B = Λ̂`, the `(p)`-adic completion of `Λ`.
  let w : Lam1 A p := algebraMap A (Lam1 A p) (P.ϖ 0)
  let B := AdicCompletion (Ideal.span {(p : Lam1 A p)}) (Lam1 A p)
  have hw : w = algebraMap A (Lam1 A p) (P.ϖ 0) := rfl
  -- `Q.ϖ 0` is the image of `w` in `B`.
  have hQ0 : Q.ϖ 0 = algebraMap (Lam1 A p) B w := by
    rw [hQ 0, hw, AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
      Algebra.algebraMap_self_apply]
  have hq' : ∀ i, Qr i - algebraMap (Lam1 A p) B (q i) ∈
      Ideal.span {algebraMap (Lam1 A p) B w ^ K} := by
    intro i
    have h := hq i
    rwa [hQ0] at h
  -- **Step 1.** The image in `B` of the element we care about lies in `(φ (w ^ (m+1)))`.
  have hstep : algebraMap (Lam1 A p) B (q (j + 1) ^ p - q j) ∈
      Ideal.span {algebraMap (Lam1 A p) B (w ^ (m + 1))} :=
    map_sub_pow_mem_span_of_le (algebraMap (Lam1 A p) B) p m K hK w Qr q hroot hq' j
  -- **Step 2.** Descend along `Λ → Λ̂` using `N5b_mem_of_map_mem`.
  obtain ⟨v, hv⟩ := P.unit
  have hπe : w ^ p = (p : Lam1 A p) * (Units.map (algebraMap A (Lam1 A p)) v : (Lam1 A p)ˣ) := by
    rw [hw]
    show (algebraMap A (Lam1 A p) (P.ϖ 0)) ^ p
      = (p : Lam1 A p) * algebraMap A (Lam1 A p) (v : A)
    rw [← map_pow, hv, map_mul, map_natCast]
  have hπ : IsSMulRegular (Lam1 A p) w := by
    rw [hw]; exact Lam1_varpi_regular A p P 0
  have hfin : q (j + 1) ^ p - q j ∈ Ideal.span {w ^ (m + 1)} :=
    N5b_mem_of_map_mem p w p (Units.map (algebraMap A (Lam1 A p)) v) hπe hp1 hπ
      (m + 1) (q (j + 1) ^ p - q j) hstep
  have hwpow : w ^ (m + 1) = algebraMap A (Lam1 A p) (P.ϖ 0 ^ (m + 1)) := by
    rw [hw, map_pow]
  rw [hwpow] at hfin
  exact hfin

end Work.DSM2p
