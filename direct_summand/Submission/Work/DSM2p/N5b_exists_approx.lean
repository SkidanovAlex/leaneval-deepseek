import Mathlib

namespace Work.DSM2p

/-- Approximation in an `I`-adic completion modulo `I ^ k`.

For a finitely generated ideal `J` of a commutative ring `R`, every element `z` of the `J`-adic
completion `AdicCompletion J R` is congruent modulo `J ^ k` (as an ideal of the completion, i.e.
inside `J ^ k • ⊤`) to the image of an element of `R`.

This is the surjectivity of `R → AdicCompletion J R ⧸ (J ^ k • ⊤)`, which follows from
`AdicCompletion.surjective_evalₐ` together with
`AdicCompletion.pow_smul_top_eq_ker_eval` (`J ^ k • ⊤ = ker (eval J R k)`). -/
lemma N5b_aux_exists_approx_mod {R : Type*} [CommRing R] (J : Ideal R) (hJ : J.FG) (k : ℕ)
    (z : AdicCompletion J R) :
    ∃ c : R, z - algebraMap R (AdicCompletion J R) c ∈
      J ^ k • (⊤ : Submodule R (AdicCompletion J R)) := by
  obtain ⟨c, hc⟩ : ∃ c : R, (J ^ k • (⊤ : Submodule R R)).mkQ c = z.val k :=
    Submodule.mkQ_surjective _ (z.val k)
  refine ⟨c, ?_⟩
  rw [AdicCompletion.pow_smul_top_eq_ker_eval (M := R) hJ, LinearMap.mem_ker,
    AdicCompletion.eval_apply, AdicCompletion.val_sub_apply]
  have hof : algebraMap R (AdicCompletion J R) c = AdicCompletion.of J R c := by
    rw [AdicCompletion.algebraMap_apply]; rfl
  rw [hof, AdicCompletion.of_apply, hc, sub_self]

/-- The `k`-th power of the principal ideal `(p)` inside the `(p)`-adic completion is contained in
the principal ideal generated by the image of `π ^ k`, when `π ^ e = p · u` with `e ≥ 1` and `u` a
unit.

Indeed `p ^ k = π ^ k · (π ^ (k * (e - 1)) · u ^ (-k))`, so `p ^ k` is a multiple of `π ^ k`; taking
the ideals generated in the completion gives the claim. -/
lemma N5b_aux_pow_smul_top_le_span {R : Type*} [CommRing R] (p : ℕ) (π : R) (e : ℕ) (u : Rˣ)
    (hπe : π ^ e = (p : R) * u) (he : 1 ≤ e) (k : ℕ) :
    ((Ideal.span {(p : R)}) ^ k • (⊤ : Submodule R (AdicCompletion (Ideal.span {(p : R)}) R))) ≤
      (Ideal.span {algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) (π ^ k)}).restrictScalars R := by
  have hp_eq : (p : R) = π ^ e * ((u⁻¹ : Rˣ) : R) := by
    rw [hπe, mul_assoc, Units.mul_inv, mul_one]
  have hek : e * k = k + k * (e - 1) := by
    have h1 : e = (e - 1) + 1 := (Nat.succ_pred_eq_of_pos (by omega)).symm
    conv_lhs => rw [h1]
    rw [add_mul, one_mul, mul_comm (e - 1) k, add_comm]
  have hpk : (p : R) ^ k = π ^ k * (π ^ (k * (e - 1)) * ((u⁻¹ : Rˣ) : R) ^ k) := by
    calc (p : R) ^ k = (π ^ e * ((u⁻¹ : Rˣ) : R)) ^ k := by rw [hp_eq]
      _ = (π ^ e) ^ k * ((u⁻¹ : Rˣ) : R) ^ k := by rw [mul_pow]
      _ = π ^ (e * k) * ((u⁻¹ : Rˣ) : R) ^ k := by rw [pow_mul]
      _ = π ^ (k + k * (e - 1)) * ((u⁻¹ : Rˣ) : R) ^ k := by rw [hek]
      _ = (π ^ k * π ^ (k * (e - 1))) * ((u⁻¹ : Rˣ) : R) ^ k := by rw [pow_add]
      _ = π ^ k * (π ^ (k * (e - 1)) * ((u⁻¹ : Rˣ) : R) ^ k) := by rw [mul_assoc]
  have hdvd : algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) (π ^ k) ∣
      algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) ((p : R) ^ k) := by
    refine ⟨algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R)
      (π ^ (k * (e - 1)) * ((u⁻¹ : Rˣ) : R) ^ k), ?_⟩
    rw [← map_mul, hpk]
  have hmap : Ideal.map (algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R))
        ((Ideal.span {(p : R)}) ^ k) =
      Ideal.span {algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) ((p : R) ^ k)} := by
    rw [Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton]
  rw [Ideal.smul_top_eq_map, hmap, Submodule.restrictScalars_le]
  exact (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_span_singleton.mpr hdvd)

theorem N5b_exists_approx {R : Type*} [CommRing R] (p : ℕ) (π : R) (e : ℕ) (u : Rˣ)
    (hπe : π ^ e = (p : R) * u) (he : 1 ≤ e) (k : ℕ)
    (z : AdicCompletion (Ideal.span {(p : R)}) R) :
    ∃ c : R, z - algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) c ∈
      Ideal.span {algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) (π ^ k)} := by
  obtain ⟨c, hc⟩ := N5b_aux_exists_approx_mod (Ideal.span {(p : R)}) ⟨{(p : R)}, by simp⟩ k z
  exact ⟨c, (Submodule.restrictScalars_mem R _ _).mp
    (N5b_aux_pow_smul_top_le_span p π e u hπe he k hc)⟩

end Work.DSM2p
