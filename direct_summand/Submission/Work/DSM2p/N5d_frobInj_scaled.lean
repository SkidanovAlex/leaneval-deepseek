import Mathlib
import Submission.Work.DSM2p.LamOne
import Submission.Work.DSM2p.PERFD_T
import Submission.Work.DSM2p.rootClosure_isSMulRegular
import Submission.Work.DSM2p.Lam1_frobInj

/-!
# N5d — *scaled* Frobenius injectivity in `Λ = A[T^{1/p^∞}]`

This is node **N5d** of the Česnavičius–Scholze single-polynomial design
(`sources/dsmap/direct_summand_m2p_h2_design.md`, §2): in `Λ = Lam1 A p = A[T^{1/p^∞}]`,

> `y ^ p ∈ (ϖ_k)  ⟹  y ∈ (ϖ_{k+1})`,

where `(ϖ_j)` denotes the ideal of `Λ` generated by `algebraMap A Λ (P.ϖ j)`.

## Proof

Write `ϖ j := algebraMap A (Lam1 A p) (P.ϖ j)`.  The root system
(`ϖ (j+1) ^ p = ϖ j`) gives `ϖ j ^ (p ^ j) = ϖ 0`, in particular

* `ϖ (k+1) ^ N = ϖ 0` and `ϖ (k+1) ^ p = ϖ k`, where `N := p ^ (k+1)`.

Since `ϖ 0 ^ p = p · u` with `u` a unit (`PerfectoidData.unit`) and `p` is a nonzerodivisor on
`Λ` (`rootClosure_isSMulRegular`), the element `ϖ 0` is a nonzerodivisor on `Λ`.

Given `hy : y ^ p ∈ (ϖ k)`, say `y ^ p = a · ϖ k`, put

* `u := ϖ (k+1) ^ (N - 1)`, `z := y * u`;

then `u * ϖ (k+1) = ϖ (k+1) ^ N = ϖ 0`, so

```
z ^ p = y ^ p * u ^ p = (a * ϖ (k+1) ^ p) * u ^ p = (u ^ p * ϖ (k+1) ^ p) * a
      = (u * ϖ (k+1)) ^ p * a = ϖ 0 ^ p * a = p · (u_unit * a) ∈ (p).
```

Frobenius injectivity modulo `p` for `Λ` (`Lam1_frobInj`) applied to `z` yields `z ∈ (ϖ 0)`, say
`z = b · ϖ 0`.  Multiplying by `ϖ (k+1)` gives

```
y * ϖ 0 = z * ϖ (k+1) = b * ϖ 0 * ϖ (k+1) = ϖ 0 * (b * ϖ (k+1)),
```

and cancelling the nonzerodivisor `ϖ 0` gives `y = b * ϖ (k+1) ∈ (ϖ (k+1))`. ∎

Note that no hypothesis on `k` is needed: the argument is uniform in `k` (for `k = 0` it is the
`hinjF` input of node N4 with `ϖ₁ = ϖ 1`).
-/

namespace Work.DSM2p

theorem N5d_frobInj_scaled (A : Type*) [CommRing A] (p : ℕ) [Fact p.Prime]
    (P : DSMap.PerfectoidData p A) (k : ℕ) (y : Lam1 A p)
    (hy : y ^ p ∈ Ideal.span {algebraMap A (Lam1 A p) (P.ϖ k)}) :
    y ∈ Ideal.span {algebraMap A (Lam1 A p) (P.ϖ (k + 1))} := by
  classical
  have hp : p.Prime := Fact.out
  have hp1 : 1 ≤ p := hp.one_le
  -- notation for the images of the pseudo-uniformizer in `Λ`
  let ϖ : ℕ → Lam1 A p := fun j => algebraMap A (Lam1 A p) (P.ϖ j)
  -- `Λ`-version of Frobenius injectivity modulo `p` (node N5a at `ι = PUnit`)
  have hfrob : ∀ z : Lam1 A p, z ^ p ∈ Ideal.span {(p : Lam1 A p)} → z ∈ Ideal.span {ϖ 0} := by
    intro z hz
    exact Lam1_frobInj A p P z hz
  have hy' : y ^ p ∈ Ideal.span {ϖ k} := hy
  have hroot : ∀ j, ϖ (j + 1) ^ p = ϖ j := by
    intro j
    show algebraMap A (Lam1 A p) (P.ϖ (j + 1)) ^ p = algebraMap A (Lam1 A p) (P.ϖ j)
    rw [← map_pow, P.root j]
  change y ∈ Ideal.span {ϖ (k + 1)}
  -- `p` is a nonzerodivisor on `Λ`
  have hpreg : IsSMulRegular (Lam1 A p) (p : Lam1 A p) :=
    rootClosure_isSMulRegular A p PUnit P.torsionFree
  -- `ϖ 0 ^ p = p · u` with `u` a unit, hence `ϖ 0` is a nonzerodivisor
  obtain ⟨v, hv⟩ := P.unit
  let vu : (Lam1 A p)ˣ := Units.map (algebraMap A (Lam1 A p)) v
  have hvp : ϖ 0 ^ p = (p : Lam1 A p) * (vu : Lam1 A p) := by
    show algebraMap A (Lam1 A p) (P.ϖ 0) ^ p = (p : Lam1 A p) * algebraMap A (Lam1 A p) (v : A)
    rw [← map_pow, hv, map_mul, map_natCast]
  have hreg0 : IsSMulRegular (Lam1 A p) (ϖ 0) := by
    have h1 : IsSMulRegular (Lam1 A p) (ϖ 0 ^ p) := by
      rw [hvp]
      exact hpreg.mul (IsUnit.isSMulRegular (Lam1 A p) (Units.isUnit vu))
    have h2 : ϖ 0 ^ p = ϖ 0 ^ (p - 1) * ϖ 0 := by
      rw [← pow_succ, Nat.sub_add_cancel hp1]
    intro x z hxz
    have hxz' : ϖ 0 * x = ϖ 0 * z := by simpa using hxz
    exact h1 (by
      calc ϖ 0 ^ p * x = (ϖ 0 ^ (p - 1) * ϖ 0) * x := by rw [h2]
        _ = ϖ 0 ^ (p - 1) * (ϖ 0 * x) := by rw [mul_assoc]
        _ = ϖ 0 ^ (p - 1) * (ϖ 0 * z) := by rw [hxz']
        _ = (ϖ 0 ^ (p - 1) * ϖ 0) * z := by rw [mul_assoc]
        _ = ϖ 0 ^ p * z := by rw [h2])
  -- the root system gives `ϖ j ^ (p ^ j) = ϖ 0`
  have hpoweq : ∀ j, ϖ j ^ (p ^ j) = ϖ 0 := by
    intro j
    induction j with
    | zero => rw [pow_zero, pow_one]
    | succ j ih => rw [Nat.pow_succ', pow_mul, hroot j, ih]
  obtain ⟨a, ha⟩ := (Ideal.mem_span_singleton' (x := y ^ p) (y := ϖ k)).mp hy'
  -- `N := p ^ (k+1)` so that `ϖ (k+1) ^ N = ϖ 0`
  set N : ℕ := p ^ (k + 1) with hN
  have hNpos : 1 ≤ N := by rw [hN]; exact one_le_pow₀ hp1
  have hcN : ϖ (k + 1) ^ N = ϖ 0 := by rw [hN]; exact hpoweq (k + 1)
  -- the scaling elements
  set u : Lam1 A p := ϖ (k + 1) ^ (N - 1) with hu
  have huc : u * ϖ (k + 1) = ϖ 0 := by
    rw [hu, ← pow_succ, Nat.sub_add_cancel hNpos, hcN]
  set z : Lam1 A p := y * u with hz
  have hucpow : u ^ p * ϖ (k + 1) ^ p = ϖ 0 ^ p := by rw [← mul_pow, huc]
  -- `z ^ p ∈ (p)`
  have hzpow : z ^ p = (p : Lam1 A p) * ((vu : Lam1 A p) * a) := by
    have h1 : z ^ p = ϖ 0 ^ p * a := by
      calc z ^ p = (y * u) ^ p := by rw [hz]
        _ = y ^ p * u ^ p := by rw [mul_pow]
        _ = (a * ϖ k) * u ^ p := by rw [← ha]
        _ = (a * ϖ (k + 1) ^ p) * u ^ p := by rw [← hroot k]
        _ = (u ^ p * ϖ (k + 1) ^ p) * a := by ac_rfl
        _ = ϖ 0 ^ p * a := by rw [hucpow]
    rw [h1, hvp, mul_assoc]
  have hzmem : z ∈ Ideal.span {ϖ 0} := by
    apply hfrob
    rw [hzpow]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self (p : Lam1 A p))
  obtain ⟨b, hb⟩ := (Ideal.mem_span_singleton' (x := z) (y := ϖ 0)).mp hzmem
  -- multiply by `ϖ (k+1)` and cancel `ϖ 0`
  have hkey : ϖ 0 * y = ϖ 0 * (b * ϖ (k + 1)) := by
    have h1 : z * ϖ (k + 1) = y * ϖ 0 := by rw [hz, mul_assoc, huc]
    calc ϖ 0 * y = y * ϖ 0 := by rw [mul_comm]
      _ = z * ϖ (k + 1) := h1.symm
      _ = (b * ϖ 0) * ϖ (k + 1) := by rw [← hb]
      _ = ϖ 0 * (b * ϖ (k + 1)) := by ac_rfl
  have hyb : y = b * ϖ (k + 1) := hreg0 hkey
  rw [hyb]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self (ϖ (k + 1)))

end Work.DSM2p
