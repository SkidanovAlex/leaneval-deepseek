import Submission.Work.DSM2p.Basic
import Submission.Work.DSM2p.RootClosure

/-!
# The Česnavičius–Scholze cover, positive-degree index set

The lead file `Submission/Work/DSMap/Mix2Fix.lean` repairs the root clause of `area_M2'` by
requiring `0 < F.natDegree`: the monic constant polynomial `F = 1` has no root `r` with
`aeval r 1 = 0` unless `1 = 0` in `B`, which contradicts faithful flatness over a nontrivial
`A ⧸ (p)`.  Accordingly the index set of the construction is here the set of *positive-degree*
monic polynomials:

* `MonicPolysPos A` — `{F : A[T] // F.Monic ∧ 0 < F.natDegree}`;
* `RootAlgPos A p = rootClosure A p (MonicPolysPos A)` — `Λ = A[T_F^{1/p^n}]`;
* `CSAlgPos A p ϖ ⊆ Λ[1/ϖ]` — `A_∞`, generated by `Λ` and the fractions `F(T_F)/ϖ^m`;
* `CSIntegralClosurePos A p ϖ = pIntClosure p (CSAlgPos A p ϖ)` — `A'`;
* `CSCompletionPos A p ϖ = AdicCompletion (span {p}) A'` — `B`, the candidate cover;
* `rootElementPos A p ϖ F` — the image of `T_F` in `B`.

Everything here is the same construction as in `Construction.lean`, run over the smaller index
set; the file is sorry-free.  The roots clause for this version is
`Work.DSM2p.rootElementPos_aeval` (delegated), and the two remaining inputs of the target are
`(H1)` (Frobenius surjectivity of `A'` mod `ϖ ^ p`) and `(H2)` (faithful flatness of `B ⁄ pB` over
`A ⁄ pA`); see `DESIGN.md`.
-/

open scoped Classical

namespace Work.DSM2p

universe u

/-- The index set of the repaired construction: monic polynomials of positive degree. -/
abbrev MonicPolysPos (A : Type u) [CommRing A] := { F : Polynomial A // F.Monic ∧ 0 < F.natDegree }

/-- `Λ = A[T_F^{1/p^n} | F ∈ 𝒫⁺, n ≥ 0]`. -/
abbrev RootAlgPos (A : Type u) [CommRing A] (p : ℕ) := rootClosure A p (MonicPolysPos A)

/-- The root variable `T_F` in `Λ`. -/
noncomputable def rootVarPos (A : Type u) [CommRing A] (p : ℕ) (F : MonicPolysPos A) :
    RootAlgPos A p :=
  Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A)) (MvPolynomial.X (F, 0))

/-- `Λ[1/ϖ]`. -/
abbrev RootAlgLocPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :=
  Localization.Away (algebraMap A (RootAlgPos A p) ϖ)

/-- `T_F` in `Λ[1/ϖ]`. -/
noncomputable def rootVarLocPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (F : MonicPolysPos A) :
    RootAlgLocPos A p ϖ :=
  algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ) (rootVarPos A p F)

/-- `A_∞ ⊆ Λ[1/ϖ]`: generated by `Λ` and the fractions `F(T_F)/ϖ^m`. -/
noncomputable def CSAlgPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Subring (RootAlgLocPos A p ϖ) :=
  Subring.closure (Set.range (algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)) ∪
    Set.range (fun q : MonicPolysPos A × ℕ =>
      algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)
          (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
        IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) ϖ) ^ q.2))

theorem rootVarLocPos_mem_CSAlgPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)
    (F : MonicPolysPos A) : rootVarLocPos A p ϖ F ∈ CSAlgPos A p ϖ :=
  Subring.subset_closure (Set.mem_union_left _ ⟨rootVarPos A p F, rfl⟩)

/-- `A'`: the `p`-integral closure of `A_∞` in `Λ[1/ϖ]`. -/
noncomputable def CSIntegralClosurePos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Subring (RootAlgLocPos A p ϖ) :=
  pIntClosure p (CSAlgPos A p ϖ)

theorem CSAlgPos_le_CSIntegralClosurePos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    CSAlgPos A p ϖ ≤ CSIntegralClosurePos A p ϖ :=
  le_pIntClosure p (CSAlgPos A p ϖ)

theorem CSIntegralClosurePos_isPIntegrallyClosed (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    IsPIntegrallyClosedIn p (CSIntegralClosurePos A p ϖ) :=
  pIntClosure_isPIntegrallyClosed p (CSAlgPos A p ϖ)

/-- `T_F` as an element of `A'`. -/
noncomputable def rootVarInClosurePos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)
    (F : MonicPolysPos A) : CSIntegralClosurePos A p ϖ :=
  ⟨rootVarLocPos A p ϖ F,
    CSAlgPos_le_CSIntegralClosurePos A p ϖ (rootVarLocPos_mem_CSAlgPos A p ϖ F)⟩

/-- `B`: the `p`-adic completion of `A'`. -/
abbrev CSCompletionPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :=
  AdicCompletion (Ideal.span {(p : CSIntegralClosurePos A p ϖ)}) (CSIntegralClosurePos A p ϖ)

/-- The image of `T_F` in `B`. -/
noncomputable def rootElementPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)
    (F : MonicPolysPos A) : CSCompletionPos A p ϖ :=
  algebraMap (CSIntegralClosurePos A p ϖ) (CSCompletionPos A p ϖ)
    (rootVarInClosurePos A p ϖ F)

/-- The structure map `A → Λ → Λ[1/ϖ]`. -/
noncomputable def AAlgHomLocPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    A →+* RootAlgLocPos A p ϖ :=
  (algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)).comp (algebraMap A (RootAlgPos A p))

theorem AAlgHomLocPos_mem_CSAlgPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (a : A) :
    AAlgHomLocPos A p ϖ a ∈ CSAlgPos A p ϖ :=
  Subring.subset_closure (Set.mem_union_left _ ⟨algebraMap A (RootAlgPos A p) a, rfl⟩)

/-- `A'` is an `A`-algebra. -/
noncomputable instance (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Algebra A (CSIntegralClosurePos A p ϖ) :=
  (RingHom.codRestrict (AAlgHomLocPos A p ϖ) _
    (fun a => CSAlgPos_le_CSIntegralClosurePos A p ϖ (AAlgHomLocPos_mem_CSAlgPos A p ϖ a))).toAlgebra

/-- The `A ⧸ (p)`-module structure on `B ⧸ pB` of the candidate cover.  Mathlib derives it from
the quotient algebra structure, but instance search does not find it for the concrete
abbreviation `CSCompletionPos`, so it is recorded explicitly here; this is what allows
`Module.FaithfullyFlat (A ⧸ (p)) (B ⧸ pB)` -- the third clause of `area_M2pos` -- to be stated
for the construction. -/
noncomputable instance (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Module (A ⧸ Ideal.span {(p : A)})
      (CSCompletionPos A p ϖ ⧸
        (Ideal.span {(p : A)}).map (algebraMap A (CSCompletionPos A p ϖ))) :=
  (inferInstance : Algebra _ _).toModule

theorem CSCompletionPos_isAdicComplete (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    IsAdicComplete (Ideal.span {(p : CSIntegralClosurePos A p ϖ)}) (CSCompletionPos A p ϖ) :=
  AdicCompletion.isAdicComplete (Submodule.fg_span_singleton (p : CSIntegralClosurePos A p ϖ))

end Work.DSM2p
