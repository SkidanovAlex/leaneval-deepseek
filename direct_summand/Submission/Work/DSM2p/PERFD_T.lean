/-! ## Auxiliary lemmas

We collect here the (general, reusable) ingredients of the proof. -/

/-- In a commutative ring, the `p`-th power of a finite sum differs from the sum of the `p`-th
powers of the summands by a multiple of `p` (Freshman's dream, modulo `p`). -/
theorem Finset_sum_pow_sub_sum_pow_mem {R : Type*} [CommRing R] {α : Type*} {p : ℕ}
    (hp : p.Prime) (s : Finset α) (u : α → R) :
    (∑ i ∈ s, u i) ^ p - ∑ i ∈ s, (u i) ^ p ∈ Ideal.span {(p : R)} := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [zero_pow hp.pos.ne']
  | insert a t ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp (u a) (∑ i ∈ t, u i)
    have h1 : (u a + ∑ i ∈ t, u i) ^ p - ((u a) ^ p + ∑ i ∈ t, u i ^ p)
        = ((∑ i ∈ t, u i) ^ p - ∑ i ∈ t, u i ^ p) + (u a * (∑ i ∈ t, u i) * r) * (p : R) := by
      rw [hr]; ring
    rw [h1]
    exact Ideal.add_mem _ ih
      (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self (p : R)))

/-- **The Frobenius expansion of a monoid algebra modulo `p`.**  Reducing a monoid algebra
modulo `p`, the `p`-th power map sends the basis element `m` to `m ^ p` and the coefficient `a`
to `a ^ p`. -/
theorem MonoidAlgebra_pow_sub_sum_single_pow_mem {A M : Type*} [CommRing A] [CommMonoid M]
    {p : ℕ} (hp : p.Prime) (y : MonoidAlgebra A M) :
    y ^ p - ∑ m ∈ y.coeff.support, MonoidAlgebra.single (m ^ p) ((y.coeff m) ^ p)
      ∈ Ideal.span {(p : MonoidAlgebra A M)} := by
  classical
  have h1 : (∑ m ∈ y.coeff.support, MonoidAlgebra.single m (y.coeff m)) = y :=
    MonoidAlgebra.sum_coeff_single y
  have h2 : (∑ m ∈ y.coeff.support, MonoidAlgebra.single (m ^ p) ((y.coeff m) ^ p))
      = ∑ m ∈ y.coeff.support, (MonoidAlgebra.single m (y.coeff m)) ^ p := by
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [MonoidAlgebra.single_pow]
  rw [show y ^ p - ∑ m ∈ y.coeff.support, MonoidAlgebra.single (m ^ p) ((y.coeff m) ^ p)
      = (∑ m ∈ y.coeff.support, MonoidAlgebra.single m (y.coeff m)) ^ p
          - ∑ m ∈ y.coeff.support, (MonoidAlgebra.single m (y.coeff m)) ^ p from by rw [h1, h2]]
  exact Finset_sum_pow_sub_sum_pow_mem hp _ _

/-- Evaluation at a point of a finite sum of finitely supported functions. -/
theorem Finsupp_finset_sum_apply {α ι N : Type*} [AddCommMonoid N] (s : Finset ι)
    (f : ι → α →₀ N) (a : α) : (∑ i ∈ s, f i) a = ∑ i ∈ s, (f i) a := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i t hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, Finsupp.add_apply, ih]

/-- If `z` lies in the ideal generated by a constant `a` of the coefficient ring, then every
coefficient of `z` lies in the ideal generated by `a`. -/
theorem MonoidAlgebra_coeff_mem_span_of_mem_span {A M : Type*} [CommRing A] [CommMonoid M]
    {a : A} {z : MonoidAlgebra A M} (hz : z ∈ Ideal.span {algebraMap A (MonoidAlgebra A M) a})
    (m : M) : z.coeff m ∈ Ideal.span {a} := by
  classical
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hz
  have hcoeff : z.coeff m = a * w.coeff m := by
    rw [hw]
    rw [show (algebraMap A (MonoidAlgebra A M) a) = MonoidAlgebra.single 1 a from by
      rw [MonoidAlgebra.coe_algebraMap]; rfl]
    rw [MonoidAlgebra.coeff_single_one_mul]
  rw [hcoeff]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self a)

/-- The "shift" endomorphism of the monoid of root monomials
`rootClosureMonoid p ι = ⟨x_{i,n} | x_{i,n+1}^p = x_{i,n}⟩`: it sends the generator `x_{i,n}` to
`x_{i,n+1}`, so that `σ m ^ p = m`.  (This is the inverse of the `p`-th power map, which is
therefore bijective.) -/
theorem rootClosureMonoid_shift (p : ℕ) (hp : 0 < p) (ι : Type u) :
    ∃ σ : rootClosureMonoid p ι →* rootClosureMonoid p ι,
      ∀ m : rootClosureMonoid p ι, (σ m) ^ p = m := by
  classical
  let C : Con (Multiplicative ((ι × ℕ) →₀ ℕ)) := rootClosureCon p ι
  let τ : ((ι × ℕ) →₀ ℕ) →+ ((ι × ℕ) →₀ ℕ) :=
    Finsupp.mapDomain.addMonoidHom (fun q : ι × ℕ => (q.1, q.2 + 1))
  let shift : Multiplicative ((ι × ℕ) →₀ ℕ) →* Multiplicative ((ι × ℕ) →₀ ℕ) :=
    { toFun := fun x => Multiplicative.ofAdd (τ x.toAdd)
      map_one' := by simp [τ]
      map_mul' := fun x y => by simp only [toAdd_mul, map_add, ofAdd_add] }
  have hshift_apply : ∀ v : (ι × ℕ) →₀ ℕ,
      shift (Multiplicative.ofAdd v) = Multiplicative.ofAdd (τ v) := fun v => rfl
  have hτ_single : ∀ (q : ι × ℕ) (b : ℕ),
      τ (Finsupp.single q b) = Finsupp.single (q.1, q.2 + 1) b := by
    intro q b
    simp only [τ, Finsupp.mapDomain.addMonoidHom_apply, Finsupp.mapDomain_single]
  -- the defining relations, raised to an arbitrary power
  have hpow : ∀ (a : ι × ℕ) (b : ℕ),
      C (Multiplicative.ofAdd (p • Finsupp.single (a.1, a.2 + 1) b))
        (Multiplicative.ofAdd (Finsupp.single a b)) := by
    intro a b
    induction b with
    | zero => simpa using C.refl 1
    | succ b ih =>
      have h1 : p • Finsupp.single (a.1, a.2 + 1) (b + 1)
          = p • Finsupp.single (a.1, a.2 + 1) b + p • Finsupp.single (a.1, a.2 + 1) 1 := by
        rw [Finsupp.single_add, smul_add]
      have h2 : Finsupp.single a (b + 1) = Finsupp.single a b + Finsupp.single a 1 :=
        Finsupp.single_add a b 1
      have hrel : rootClosureRel p ι (Multiplicative.ofAdd (p • Finsupp.single (a.1, a.2 + 1) 1))
          (Multiplicative.ofAdd (Finsupp.single a 1)) := ⟨a.1, a.2, rfl, rfl⟩
      rw [h1, h2, ofAdd_add, ofAdd_add]
      exact C.mul ih (ConGen.Rel.of _ _ hrel)
  -- the shifted element is a `p`-th root, on the level of `N`
  have hmain : ∀ v : (ι × ℕ) →₀ ℕ,
      C ((shift (Multiplicative.ofAdd v)) ^ p) (Multiplicative.ofAdd v) := by
    intro v
    refine Finsupp.induction v ?_ ?_
    · simpa using C.refl 1
    · intro a b f _ _ ih
      have hshift : shift (Multiplicative.ofAdd (Finsupp.single a b + f))
          = Multiplicative.ofAdd (Finsupp.single (a.1, a.2 + 1) b + τ f) := by
        rw [hshift_apply, map_add, hτ_single]
      have hτf : (shift (Multiplicative.ofAdd f)) ^ p = Multiplicative.ofAdd (p • τ f) := by
        rw [hshift_apply, ofAdd_nsmul]
      have ih' : C (Multiplicative.ofAdd (p • τ f)) (Multiplicative.ofAdd f) := by
        rwa [hτf] at ih
      rw [hshift, ← ofAdd_nsmul, smul_add, ofAdd_add, ofAdd_add]
      exact C.mul (hpow a b) ih'
  -- descend to the quotient
  have hkey : C ≤ Con.ker (C.mk'.comp shift) := by
    rw [show C = conGen (rootClosureRel p ι) from rfl, Con.conGen_le]
    rintro a b ⟨i, n, ha, hb⟩
    rw [ha, hb]
    change C.mk' (shift (Multiplicative.ofAdd (p • Finsupp.single (i, n + 1) 1)))
      = C.mk' (shift (Multiplicative.ofAdd (Finsupp.single (i, n) 1)))
    have h1 : shift (Multiplicative.ofAdd (p • Finsupp.single (i, n + 1) 1))
        = Multiplicative.ofAdd (p • Finsupp.single (i, n + 2) 1) := by
      rw [hshift_apply, map_nsmul, hτ_single]
    have h2 : shift (Multiplicative.ofAdd (Finsupp.single (i, n) 1))
        = Multiplicative.ofAdd (Finsupp.single (i, n + 1) 1) := by
      rw [hshift_apply, hτ_single]
    rw [h1, h2]
    refine (Con.eq (c := C)).mpr ?_
    apply ConGen.Rel.of
    exact ⟨i, n + 1, rfl, rfl⟩
  refine ⟨C.lift (C.mk'.comp shift) hkey, ?_⟩
  intro m
  obtain ⟨x, rfl⟩ := Con.mk'_surjective (c := C) m
  rw [Con.lift_mk']
  change (C.mk' (shift x)) ^ p = C.mk' x
  rw [← map_pow]
  refine (Con.eq (c := C)).mpr ?_
  simpa [ofAdd_toAdd] using hmain x.toAdd

/-- A monomial whose coefficient lies in `(a)` lies in the ideal generated by the constant `a`. -/
theorem MonoidAlgebra_single_mem_span_of_mem_span {A M : Type*} [CommRing A] [CommMonoid M]
    {a : A} {m : M} {c : A} (hc : c ∈ Ideal.span {a}) :
    MonoidAlgebra.single m c ∈ Ideal.span {algebraMap A (MonoidAlgebra A M) a} := by
  classical
  obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton.mp hc
  rw [MonoidAlgebra.single_eq_algebraMap_mul_of, map_mul, mul_assoc,
    ← MonoidAlgebra.single_eq_algebraMap_mul_of]
  exact Ideal.mul_mem_right (MonoidAlgebra.single m d) (Ideal.span {algebraMap A (MonoidAlgebra A M) a})
    (Ideal.mem_span_singleton_self _)

/-- **Frobenius surjectivity modulo `p` passes to monoid algebras.**  If every element of `A` is a
`p`-th power modulo `p`, and if the monoid `M` has a "`p`-th root" map `ρ` (so that `m ↦ m ^ p` is
surjective), then every element of `A[M]` is a `p`-th power modulo `p`. -/
theorem MonoidAlgebra_frobSurjMod {A M : Type*} [CommRing A] [CommMonoid M] {p : ℕ}
    (hp : p.Prime) (hA : ∀ a : A, ∃ b : A, a - b ^ p ∈ Ideal.span {(p : A)})
    (ρ : M →* M) (hρ : ∀ m : M, (ρ m) ^ p = m) (y : MonoidAlgebra A M) :
    ∃ w : MonoidAlgebra A M, y - w ^ p ∈ Ideal.span {(p : MonoidAlgebra A M)} := by
  classical
  choose b hb using hA
  refine ⟨∑ m ∈ y.coeff.support, MonoidAlgebra.single (ρ m) (b (y.coeff m)), ?_⟩
  have hy : (∑ m ∈ y.coeff.support, MonoidAlgebra.single m (y.coeff m)) = y :=
    MonoidAlgebra.sum_coeff_single y
  -- the first approximation of `y` by a `p`-th power: the `p`-th power of the candidate root
  have hstep1 : (∑ m ∈ y.coeff.support, MonoidAlgebra.single (ρ m) (b (y.coeff m))) ^ p
      - ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p)
      ∈ Ideal.span {(p : MonoidAlgebra A M)} := by
    have hmain := Finset_sum_pow_sub_sum_pow_mem hp y.coeff.support
      (fun m : M => MonoidAlgebra.single (ρ m) (b (y.coeff m)))
    have hcongr : (∑ m ∈ y.coeff.support, (MonoidAlgebra.single (ρ m) (b (y.coeff m))) ^ p)
        = ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p) := by
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [MonoidAlgebra.single_pow, hρ m]
    rwa [hcongr] at hmain
  -- the second: `y` itself against the coefficientwise `p`-th roots
  have hstep2 : y - ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p)
      ∈ Ideal.span {(p : MonoidAlgebra A M)} := by
    have hsingle : (∑ m ∈ y.coeff.support,
          MonoidAlgebra.single m (y.coeff m - (b (y.coeff m)) ^ p))
        = (∑ m ∈ y.coeff.support, MonoidAlgebra.single m (y.coeff m))
          - ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun m _ => ?_
      exact map_sub (MonoidAlgebra.singleAddHom m) _ _
    have hgoal : y - ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p)
        = ∑ m ∈ y.coeff.support,
            MonoidAlgebra.single m (y.coeff m - (b (y.coeff m)) ^ p) := by
      rw [hsingle, hy]
    rw [hgoal]
    refine Ideal.sum_mem _ fun m _ => ?_
    rw [show (p : MonoidAlgebra A M) = algebraMap A (MonoidAlgebra A M) (p : A) from
      (map_natCast (algebraMap A (MonoidAlgebra A M)) p).symm]
    exact MonoidAlgebra_single_mem_span_of_mem_span (hb (y.coeff m))
  rw [show y - (∑ m ∈ y.coeff.support, MonoidAlgebra.single (ρ m) (b (y.coeff m))) ^ p
      = (y - ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p))
        - ((∑ m ∈ y.coeff.support, MonoidAlgebra.single (ρ m) (b (y.coeff m))) ^ p
          - ∑ m ∈ y.coeff.support, MonoidAlgebra.single m ((b (y.coeff m)) ^ p)) from by ring]
  exact Ideal.sub_mem _ hstep2 hstep1

/-- **Frobenius injectivity modulo `p` passes to monoid algebras.**  If `m ↦ m ^ p` is injective on
`M` and if `a ^ p ∈ (p)` implies `a ∈ (ϖ)` in `A`, then `y ^ p ∈ (p)` implies `y ∈ (ϖ)` in
`A[M]`. -/
theorem MonoidAlgebra_frobInjMod {A M : Type*} [CommRing A] [CommMonoid M] {p : ℕ}
    (hp : p.Prime) (hinj : Function.Injective fun m : M => m ^ p) (ϖ : A)
    (hA : ∀ a : A, a ^ p ∈ Ideal.span {(p : A)} → a ∈ Ideal.span {ϖ})
    (y : MonoidAlgebra A M) (hy : y ^ p ∈ Ideal.span {(p : MonoidAlgebra A M)}) :
    y ∈ Ideal.span {algebraMap A (MonoidAlgebra A M) ϖ} := by
  classical
  -- the coefficientwise expansion of `y ^ p`, which therefore also lies in `(p)`
  have hS : (∑ m ∈ y.coeff.support, MonoidAlgebra.single (m ^ p) ((y.coeff m) ^ p))
      ∈ Ideal.span {(p : MonoidAlgebra A M)} := by
    have hexp := MonoidAlgebra_pow_sub_sum_single_pow_mem hp y
    rw [show (∑ m ∈ y.coeff.support, MonoidAlgebra.single (m ^ p) ((y.coeff m) ^ p))
        = y ^ p - (y ^ p - ∑ m ∈ y.coeff.support,
            MonoidAlgebra.single (m ^ p) ((y.coeff m) ^ p)) from by ring]
    exact Ideal.sub_mem _ hy hexp
  -- hence every coefficient of `y` raised to the power `p` lies in `(p)`
  have hcoef : ∀ m ∈ y.coeff.support, (y.coeff m) ^ p ∈ Ideal.span {(p : A)} := by
    intro m hm
    have h1 : (∑ m' ∈ y.coeff.support,
        MonoidAlgebra.single (m' ^ p) ((y.coeff m') ^ p)).coeff (m ^ p) ∈ Ideal.span {(p : A)} :=
      MonoidAlgebra_coeff_mem_span_of_mem_span (a := (p : A)) (by
        rw [show algebraMap A (MonoidAlgebra A M) (p : A) = (p : MonoidAlgebra A M) from
          map_natCast (algebraMap A (MonoidAlgebra A M)) p]
        exact hS) (m ^ p)
    have hcoe : (∑ m' ∈ y.coeff.support,
        MonoidAlgebra.single (m' ^ p) ((y.coeff m') ^ p)).coeff (m ^ p) = (y.coeff m) ^ p := by
      rw [MonoidAlgebra.coeff_sum, Finsupp_finset_sum_apply,
        Finset.sum_eq_single (M := A) m ?_ ?_]
      · rw [MonoidAlgebra.coeff_single, Finsupp.single_apply, if_pos rfl]
      · intro m' _ hne
        rw [MonoidAlgebra.coeff_single, Finsupp.single_apply,
          if_neg (fun h => hne (hinj h))]
      · intro hnot
        rw [MonoidAlgebra.coeff_single, Finsupp.single_apply, if_pos rfl,
          Finsupp.notMem_support_iff.mp hnot, zero_pow hp.pos.ne']
    rw [← hcoe]
    exact h1
  -- conclude coefficientwise
  have hy_exp : y = ∑ m ∈ y.coeff.support, MonoidAlgebra.single m (y.coeff m) :=
    (MonoidAlgebra.sum_coeff_single y).symm
  rw [hy_exp]
  refine Ideal.sum_mem _ fun m hm => ?_
  exact MonoidAlgebra_single_mem_span_of_mem_span (hA (y.coeff m) (hcoef m hm))

/-- The `p`-th power map on the monoid of root monomials is injective (it is inverted by the
shift `rootClosureMonoid_shift`). -/
theorem rootClosureMonoid_pow_injective (p : ℕ) (hp : 0 < p) (ι : Type u) :
    Function.Injective (fun m : rootClosureMonoid p ι => m ^ p) := by
  obtain ⟨σ, hσ⟩ := rootClosureMonoid_shift p hp ι
  intro m m' h
  have h2 : σ (m ^ p) = σ (m' ^ p) := congrArg σ h
  rw [map_pow, map_pow] at h2
  rw [hσ m, hσ m'] at h2
  exact h2

/-! ## The Frobenius facts for the root-system ring `Λ = RootAlg A p` -/

/-- **Frobenius surjectivity modulo `p` for `Λ = A[T_F^{1/p^n}]`.** -/
theorem rootAlg_frobSurj (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    (P : DSMap.PerfectoidData p A) :
    ∀ x : RootAlg A p, ∃ y : RootAlg A p, x - y ^ p ∈ Ideal.span {(p : RootAlg A p)} := by
  classical
  obtain ⟨e⟩ := rootClosure_algEquiv_monoidAlgebra A p (MonicPolys A)
  obtain ⟨σ, hσ⟩ := rootClosureMonoid_shift p (Fact.out : p.Prime).pos (MonicPolys A)
  intro x
  obtain ⟨w, hw⟩ :=
    MonoidAlgebra_frobSurjMod (Fact.out : p.Prime) (fun a => P.frobSurj a) σ hσ (e x)
  obtain ⟨u, hu⟩ := (Ideal.mem_span_singleton' (x := e x - w ^ p)
      (y := (p : MonoidAlgebra A (rootClosureMonoid p (MonicPolys A))))).mp hw
  refine ⟨e.symm w, ?_⟩
  have hx : x - (e.symm w) ^ p
      = e.symm (u * (p : MonoidAlgebra A (rootClosureMonoid p (MonicPolys A)))) := by
    rw [show x - (e.symm w) ^ p = e.symm (e x - w ^ p) from by
      simp only [map_sub, map_pow, AlgEquiv.symm_apply_apply], ← hu]
  rw [hx, map_mul, map_natCast]
  exact Ideal.mul_mem_left (Ideal.span {(p : RootAlg A p)}) (e.symm u)
    (Ideal.mem_span_singleton_self (p : RootAlg A p))

/-- **Frobenius injectivity modulo `p` for `Λ = A[T_F^{1/p^n}]`.** -/
theorem rootAlg_frobInj (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    (P : DSMap.PerfectoidData p A) :
    ∀ y : RootAlg A p, y ^ p ∈ Ideal.span {(p : RootAlg A p)} →
      y ∈ Ideal.span {algebraMap A (RootAlg A p) (P.ϖ 0)} := by
  classical
  obtain ⟨e⟩ := rootClosure_algEquiv_monoidAlgebra A p (MonicPolys A)
  obtain ⟨σ, hσ⟩ := rootClosureMonoid_shift p (Fact.out : p.Prime).pos (MonicPolys A)
  have hinj := rootClosureMonoid_pow_injective p (Fact.out : p.Prime).pos (MonicPolys A)
  intro y hy
  have hy' : (e y) ^ p ∈
      Ideal.span {(p : MonoidAlgebra A (rootClosureMonoid p (MonicPolys A)))} := by
    obtain ⟨u, hu⟩ := (Ideal.mem_span_singleton' (x := y ^ p) (y := (p : RootAlg A p))).mp hy
    rw [show (e y) ^ p = e (y ^ p) from (map_pow e y p).symm, ← hu, map_mul, map_natCast]
    exact Ideal.mul_mem_left _ _
      (Ideal.mem_span_singleton_self (p : MonoidAlgebra A (rootClosureMonoid p (MonicPolys A))))
  have hw : e y ∈ Ideal.span
      {algebraMap A (MonoidAlgebra A (rootClosureMonoid p (MonicPolys A))) (P.ϖ 0)} :=
    MonoidAlgebra_frobInjMod (Fact.out : p.Prime) hinj (P.ϖ 0) (fun a ha => P.frobInj a ha)
      (e y) hy'
  obtain ⟨u, hu⟩ := (Ideal.mem_span_singleton' (x := e y)
      (y := algebraMap A (MonoidAlgebra A (rootClosureMonoid p (MonicPolys A))) (P.ϖ 0))).mp hw
  have hu' : y = e.symm u * algebraMap A (RootAlg A p) (P.ϖ 0) :=
    calc y = e.symm (e y) := (AlgEquiv.symm_apply_apply e y).symm
      _ = e.symm (u * algebraMap A (MonoidAlgebra A (rootClosureMonoid p (MonicPolys A)))
            (P.ϖ 0)) := by rw [← hu]
      _ = e.symm u * e.symm (algebraMap A (MonoidAlgebra A (rootClosureMonoid p (MonicPolys A)))
            (P.ϖ 0)) := map_mul _ _ _
      _ = e.symm u * algebraMap A (RootAlg A p) (P.ϖ 0) := by rw [(e.symm).commutes (P.ϖ 0)]
  refine Ideal.mem_span_singleton'.mpr ⟨e.symm u, ?_⟩
  exact hu'.symm

/-! ## The Frobenius facts for the `p`-adic completion of `Λ` -/

/-- **Frobenius surjectivity modulo `p` survives `p`-adic completion.** -/
theorem adicCompletion_frobSurj {R : Type*} [CommRing R] {p : ℕ}
    (hp : IsSMulRegular R (p : R))
    (h : ∀ x : R, ∃ y : R, x - y ^ p ∈ Ideal.span {(p : R)}) :
    ∀ x : AdicCompletion (Ideal.span {(p : R)}) R,
      ∃ y : AdicCompletion (Ideal.span {(p : R)}) R,
        x - y ^ p ∈ Ideal.span {(p : AdicCompletion (Ideal.span {(p : R)}) R)} := by
  classical
  set I : Ideal R := Ideal.span {(p : R)} with hI
  have hker : RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom
      = Ideal.span {(p : AdicCompletion I R)} := by
    rw [AdicCompletion.ker_evalOneₐ_eq_map _ (Submodule.fg_span_singleton (p : R))]
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  have hcoe : ∀ b : R, (AdicCompletion.evalOneₐ I).toRingHom (algebraMap R (AdicCompletion I R) b)
      = Ideal.Quotient.mk I b := by
    intro b
    show AdicCompletion.evalOneₐ I (algebraMap R (AdicCompletion I R) b) = Ideal.Quotient.mk I b
    rw [AdicCompletion.algebraMap_apply]
    show AdicCompletion.evalOneₐ I (AdicCompletion.of I R (algebraMap R R b)) = Ideal.Quotient.mk I b
    rw [AdicCompletion.evalOneₐ_of]
    exact congrArg (Ideal.Quotient.mk I) (Algebra.algebraMap_self_apply b)
  intro x
  obtain ⟨a, ha⟩ : ∃ a : R, (AdicCompletion.evalOneₐ I).toRingHom x = Ideal.Quotient.mk I a := by
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (I := I) (AdicCompletion.evalOneₐ I x)
    exact ⟨a, ha.symm⟩
  obtain ⟨w, hw⟩ := h a
  refine ⟨algebraMap R (AdicCompletion I R) w, ?_⟩
  have hwq : Ideal.Quotient.mk I a = (Ideal.Quotient.mk I w) ^ p := by
    rw [← map_pow, Ideal.Quotient.eq]
    exact hw
  have hzero : (AdicCompletion.evalOneₐ I).toRingHom
      (x - (algebraMap R (AdicCompletion I R) w) ^ p) = 0 := by
    rw [map_sub, map_pow, hcoe w, ha, hwq, sub_self]
  rw [← hker, RingHom.mem_ker]
  exact hzero

/-- **Frobenius injectivity modulo `p` survives `p`-adic completion.** -/
theorem adicCompletion_frobInj {R : Type*} [CommRing R] {p : ℕ} (ϖ : R)
    (hp : IsSMulRegular R (p : R)) (hp0 : 0 < p)
    (hunit : ∃ v : Rˣ, ϖ ^ p = (p : R) * v)
    (h : ∀ x : R, x ^ p ∈ Ideal.span {(p : R)} → x ∈ Ideal.span {ϖ}) :
    ∀ x : AdicCompletion (Ideal.span {(p : R)}) R,
      x ^ p ∈ Ideal.span {(p : AdicCompletion (Ideal.span {(p : R)}) R)} →
        x ∈ Ideal.span {algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) ϖ} := by
  classical
  set I : Ideal R := Ideal.span {(p : R)} with hI
  have hker : RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom
      = Ideal.span {(p : AdicCompletion I R)} := by
    rw [AdicCompletion.ker_evalOneₐ_eq_map _ (Submodule.fg_span_singleton (p : R))]
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  have hcoe : ∀ b : R, (AdicCompletion.evalOneₐ I).toRingHom (algebraMap R (AdicCompletion I R) b)
      = Ideal.Quotient.mk I b := by
    intro b
    show AdicCompletion.evalOneₐ I (algebraMap R (AdicCompletion I R) b) = Ideal.Quotient.mk I b
    rw [AdicCompletion.algebraMap_apply]
    show AdicCompletion.evalOneₐ I (AdicCompletion.of I R (algebraMap R R b)) = Ideal.Quotient.mk I b
    rw [AdicCompletion.evalOneₐ_of]
    exact congrArg (Ideal.Quotient.mk I) (Algebra.algebraMap_self_apply b)
  have hmemb : ∀ b : R, algebraMap R (AdicCompletion I R) b
      ∈ Ideal.span {(p : AdicCompletion I R)} ↔ b ∈ I := by
    intro b
    rw [← hker, RingHom.mem_ker, hcoe b, Ideal.Quotient.eq_zero_iff_mem]
  intro x hx
  obtain ⟨a, ha⟩ : ∃ a : R, (AdicCompletion.evalOneₐ I).toRingHom x = Ideal.Quotient.mk I a := by
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (I := I) (AdicCompletion.evalOneₐ I x)
    exact ⟨a, ha.symm⟩
  have hmem : algebraMap R (AdicCompletion I R) a - x ∈ Ideal.span {(p : AdicCompletion I R)} := by
    rw [← hker, RingHom.mem_ker, map_sub, hcoe a, ha, sub_self]
  have hofap : (algebraMap R (AdicCompletion I R) a) ^ p
      ∈ Ideal.span {(p : AdicCompletion I R)} := by
    obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow (algebraMap R (AdicCompletion I R) a) x p
    rw [sub_eq_iff_eq_add'.mp hc]
    exact Ideal.add_mem _ hx (Ideal.mul_mem_right c _ hmem)
  have hap : a ^ p ∈ I := by
    refine (hmemb (a ^ p)).mp ?_
    rw [map_pow]
    exact hofap
  have ha_span : a ∈ Ideal.span {ϖ} := h a hap
  have hmem_span : algebraMap R (AdicCompletion I R) a
      ∈ Ideal.span {algebraMap R (AdicCompletion I R) ϖ} := by
    obtain ⟨y, hy⟩ := (Ideal.mem_span_singleton' (x := a) (y := ϖ)).mp ha_span
    rw [← hy, map_mul]
    exact Ideal.mul_mem_left (Ideal.span {algebraMap R (AdicCompletion I R) ϖ})
      (algebraMap R (AdicCompletion I R) y) (Ideal.mem_span_singleton_self _)
  have hple : Ideal.span {(p : AdicCompletion I R)}
      ≤ Ideal.span {algebraMap R (AdicCompletion I R) ϖ} := by
    obtain ⟨v, hv⟩ := hunit
    let u : (AdicCompletion I R)ˣ := Units.map (algebraMap R (AdicCompletion I R)) v
    have hcoe_u : (↑u : AdicCompletion I R) = algebraMap R (AdicCompletion I R) (v : R) := rfl
    have hpow : (algebraMap R (AdicCompletion I R) ϖ) ^ p
        = (p : AdicCompletion I R) * ↑u := by
      rw [hcoe_u, ← map_pow, hv, map_mul, map_natCast]
    have hp_eq' : (p : AdicCompletion I R) = (algebraMap R (AdicCompletion I R) ϖ) ^ p * ↑u⁻¹ := by
      rw [hpow, mul_assoc, Units.mul_inv, mul_one]
    have hpe : p - 1 + 1 = p := by omega
    have hp_eq : (p : AdicCompletion I R) = (algebraMap R (AdicCompletion I R) ϖ)
        * ((algebraMap R (AdicCompletion I R) ϖ) ^ (p - 1) * ↑u⁻¹) := by
      rw [hp_eq', ← mul_assoc, ← pow_succ', hpe]
    rw [Ideal.span_le]
    rintro z (rfl : z = (p : AdicCompletion I R))
    rw [hp_eq]
    exact Ideal.mul_mem_right ((algebraMap R (AdicCompletion I R) ϖ) ^ (p - 1) * ↑u⁻¹)
      (Ideal.span {algebraMap R (AdicCompletion I R) ϖ})
      (Ideal.mem_span_singleton_self _)
  rw [show x = algebraMap R (AdicCompletion I R) a
      - (algebraMap R (AdicCompletion I R) a - x) from
    (sub_sub_self (algebraMap R (AdicCompletion I R) a) x).symm]
  exact Ideal.sub_mem _ hmem_span (hple hmem)

/-! ## The perfectoid structure on the `p`-adic completion of `Λ` -/

theorem PERFD_T (p : ℕ) [Fact p.Prime] (A : Type*) [CommRing A] (P : DSMap.PerfectoidData p A) :
    ∃ Q : DSMap.PerfectoidData p
        (AdicCompletion (Ideal.span {(p : RootAlg A p)}) (RootAlg A p)),
      ∀ k, Q.ϖ k = algebraMap A (AdicCompletion (Ideal.span {(p : RootAlg A p)}) (RootAlg A p))
        (P.ϖ k) := by
  classical
  set B := AdicCompletion (Ideal.span {(p : RootAlg A p)}) (RootAlg A p) with hB
  have htors : IsSMulRegular (RootAlg A p) (p : RootAlg A p) :=
    rootClosure_isSMulRegular A p (MonicPolys A) P.torsionFree
  have hc : IsSMulRegular B (p : B) := adicCompletion_isSMulRegular htors
  have hcomplete : IsAdicComplete (Ideal.span {(p : B)}) B := by
    have hmap : (Ideal.span {(p : RootAlg A p)}).map (algebraMap (RootAlg A p) B)
        = Ideal.span {(p : B)} := by
      rw [Ideal.map_span, Set.image_singleton, map_natCast]
    rw [← hmap]
    exact (IsAdicComplete.map_algebraMap_iff (Ideal.span {(p : RootAlg A p)}) B).mpr
      (AdicCompletion.isAdicComplete (Submodule.fg_span_singleton (p : RootAlg A p)))
  have hunit : ∃ v : (RootAlg A p)ˣ, (algebraMap A (RootAlg A p) (P.ϖ 0)) ^ p
      = (p : RootAlg A p) * v := by
    obtain ⟨v, hv⟩ := P.unit
    refine ⟨Units.map (algebraMap A (RootAlg A p)) v, ?_⟩
    show (algebraMap A (RootAlg A p) (P.ϖ 0)) ^ p
      = (p : RootAlg A p) * algebraMap A (RootAlg A p) (v : A)
    rw [← map_pow, hv, map_mul, map_natCast]
  have hsurj := adicCompletion_frobSurj htors (rootAlg_frobSurj p A P)
  have hinj := adicCompletion_frobInj (algebraMap A (RootAlg A p) (P.ϖ 0)) htors
    (Fact.out : p.Prime).pos hunit (rootAlg_frobInj p A P)
  have hcompat : ∀ a : A, algebraMap (RootAlg A p) B (algebraMap A (RootAlg A p) a)
      = algebraMap A B a := by
    intro a
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
      Algebra.algebraMap_self_apply]
  refine ⟨{
    ϖ := fun k => algebraMap A B (P.ϖ k)
    root := ?_
    unit := ?_
    torsionFree := hc
    complete := hcomplete
    frobSurj := hsurj
    frobInj := ?_ }, ?_⟩
  · intro k
    show (algebraMap A B (P.ϖ (k + 1))) ^ p = algebraMap A B (P.ϖ k)
    rw [← map_pow, P.root k]
  · obtain ⟨v, hv⟩ := P.unit
    refine ⟨Units.map (algebraMap A B) v, ?_⟩
    show (algebraMap A B (P.ϖ 0)) ^ p = (p : B) * algebraMap A B (↑v : A)
    rw [← map_pow, hv, map_mul, map_natCast]
  · intro y hy
    rw [show Ideal.span {algebraMap A B (P.ϖ 0)}
        = Ideal.span {algebraMap (RootAlg A p) B (algebraMap A (RootAlg A p) (P.ϖ 0))} from by
      rw [hcompat]]
    exact hinj y hy
  · intro k
    rfl

end Work.DSM2p