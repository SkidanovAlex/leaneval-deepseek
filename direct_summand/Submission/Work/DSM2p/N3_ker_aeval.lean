import Mathlib
import Submission.Work.DSM2p.Basic

/-!
# `Work.DSM2p.N3_ker_aeval`

The kernel of the evaluation `C[X] → L`, `X ↦ x`, where `π ^ e * x = a` and `π` is a unit of `L`,
is the principal ideal generated by `π ^ e X - a`.

## The mathematics

Let `C → L` be an injective ring map, `π a : C`, `e ≥ 1`, `π` a unit of `L`, and `x : L` with
`π ^ e * x = a` in `L`.  Assume moreover that the image of `a` in `C ⧸ (π)` is a non-zero-divisor.
Then
`ker (aeval x) = (π ^ e X - a) ≤ C[X]`.

The inclusion `⊆` (the substantive direction) is proved as follows.

* Since `π` becomes a unit in the injective `C`-algebra `L`, it is a non-zero-divisor of `C`
  (`isSMulRegular_of_isUnit_algebraMap`).
* Write `I = (π ^ e X - a) ⊆ C[X]`, `M = C[X] ⧸ I` and `t = X mod I`.  Then `π ^ e t = a` in `M`.
  Consequently for every `f : C[X]` some power of `π` carries `f mod I` into the image of `C`:
  `∃ k c, (π mod I) ^ k * (f mod I) = C c mod I`
  (`exists_pow_mul_mk_eq`).  This is proved by `Polynomial.induction_on'`: for a monomial `b X ^ n`
  one takes `k = e * n` and `c = b * a ^ n`, and both `+` and the monomials are stable.
* Evaluating the relation in `L` through the quotient map `M → L` (which exists because
  `π ^ e X - a ↦ π ^ e x - a = 0`) shows that the scalar `c` above dies in `L`, hence is `0`:
  some power of `π` annihilates `f mod I` in `M`.
* Finally `π` is a non-zero-divisor of `M`: this is `isSMulRegular_quot_span_C_mul_X_sub`, proved
  by reducing `π * h ∈ I` modulo `π`.  Since `π ^ e ≡ 0` there (`e ≥ 1`), the relation becomes
  `h ≡ 0 mod π` multiplied by the regular element `a`, so `(C π) ∣ h`, and cancelling `π` (regular
  in `C[X]`) gives `h ∈ I`.  So `f mod I` is annihilated by a non-zero-divisor of `M` and vanishes.

## Main result

* `N3_ker_aeval` — the statement above, exactly as requested.
-/

namespace Work.DSM2p

/-- If `π` becomes a unit in an injective `C`-algebra `L`, then `π` is a non-zero-divisor of `C`. -/
theorem isSMulRegular_of_isUnit_algebraMap {C L : Type*} [CommRing C] [CommRing L] [Algebra C L]
    (hinj : Function.Injective (algebraMap C L)) {π : C} (h : IsUnit (algebraMap C L π)) :
    IsSMulRegular C π := by
  intro c d hcd
  simp only [smul_eq_mul] at hcd
  apply hinj
  have key : algebraMap C L π * algebraMap C L c = algebraMap C L π * algebraMap C L d := by
    rw [← map_mul, ← map_mul, hcd]
  exact h.mul_left_cancel key

/-- Reduction modulo `π` of a polynomial relation: if `C π * h ∈ (π ^ e X - a)` then already
`h ∈ (π ^ e X - a)`.

This is the statement that `π` is a non-zero-divisor in `C[X] ⧸ (π ^ e X - a)`; the hypothesis
`1 ≤ e` is what makes the reduction modulo `π` collapse the generator. -/
theorem mul_C_mem_span_implies_mem_span {C : Type*} [CommRing C] {π a : C} {e : ℕ} (he : 1 ≤ e)
    (hπ : IsSMulRegular C π)
    (ha : IsSMulRegular (C ⧸ Ideal.span {π}) (Ideal.Quotient.mk (Ideal.span {π}) a))
    {h : Polynomial C}
    (hh : Polynomial.C π * h ∈ Ideal.span {Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a}) :
    h ∈ Ideal.span {Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a} := by
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp hh
  set ρ : C →+* C ⧸ Ideal.span {π} := Ideal.Quotient.mk (Ideal.span {π}) with hρ
  have hρπ : ρ π = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton π))
  have hgmap : Polynomial.map ρ (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a)
      = - Polynomial.C (ρ a) := by
    rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X, Polynomial.map_C,
      map_pow, hρπ, zero_pow (by omega), Polynomial.C_0, zero_mul, zero_sub]
  have key0 : Polynomial.map ρ (q * (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a)) = 0 := by
    rw [hq, Polynomial.map_mul, Polynomial.map_C, hρπ, Polynomial.C_0, zero_mul]
  rw [Polynomial.map_mul, hgmap] at key0
  have key : Polynomial.C (ρ a) * Polynomial.map ρ q = 0 := by
    rw [mul_neg, neg_eq_zero] at key0
    rw [mul_comm]
    exact key0
  have hqzero : Polynomial.map ρ q = 0 := by
    have hsm : (ρ a) • Polynomial.map ρ q = (ρ a) • (0 : Polynomial (C ⧸ Ideal.span {π})) := by
      rw [Polynomial.smul_eq_C_mul, Polynomial.smul_eq_C_mul, key, mul_zero]
    exact ha.polynomial hsm
  have hqmem : q ∈ Ideal.span {Polynomial.C π} := by
    have h1 : q ∈ RingHom.ker (Polynomial.mapRingHom ρ) := by
      rw [RingHom.mem_ker, Polynomial.coe_mapRingHom]
      exact hqzero
    rw [Polynomial.ker_mapRingHom] at h1
    have hker : RingHom.ker ρ = Ideal.span {π} := by
      rw [hρ]; exact Ideal.mk_ker
    rw [hker, Ideal.map_span, Set.image_singleton] at h1
    exact h1
  obtain ⟨q₁, hq₁⟩ := Ideal.mem_span_singleton'.mp hqmem
  have hh' : h = q₁ * (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a) := by
    apply hπ.polynomial
    show π • h = π • (q₁ * (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a))
    rw [Polynomial.smul_eq_C_mul, Polynomial.smul_eq_C_mul]
    calc Polynomial.C π * h = q * (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a) := hq.symm
      _ = q₁ * Polynomial.C π * (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a) := by rw [hq₁]
      _ = Polynomial.C π * (q₁ * (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a)) := by ring
  rw [hh']
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))

/-- `π` is a non-zero-divisor in `C[X] ⧸ (π ^ e X - a)`. -/
theorem isSMulRegular_quot_span_C_mul_X_sub {C : Type*} [CommRing C] {π a : C} {e : ℕ}
    (he : 1 ≤ e) (hπ : IsSMulRegular C π)
    (ha : IsSMulRegular (C ⧸ Ideal.span {π}) (Ideal.Quotient.mk (Ideal.span {π}) a)) :
    IsSMulRegular (Polynomial C ⧸ Ideal.span {Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a})
      (Ideal.Quotient.mk (Ideal.span {Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a})
        (Polynomial.C π)) := by
  intro y z hyz
  obtain ⟨h₁, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨h₂, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [smul_eq_mul] at hyz
  rw [Ideal.Quotient.eq]
  refine mul_C_mem_span_implies_mem_span he hπ ha ?_
  have h0 : Ideal.Quotient.mk
      (Ideal.span {Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a})
      (Polynomial.C π * h₁ - Polynomial.C π * h₂) = 0 := by
    rw [map_sub, map_mul, map_mul, hyz, sub_self]
  have h1 := Ideal.Quotient.eq_zero_iff_mem.mp h0
  simpa [mul_sub] using h1

/-- Some power of `π` carries `f mod (π ^ e X - a)` into the image of `C`. -/
theorem exists_pow_mul_mk_eq {C : Type*} [CommRing C] (π a : C) (e : ℕ) (I : Ideal (Polynomial C))
    (hI : Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a ∈ I) (f : Polynomial C) :
    ∃ (k : ℕ) (c : C), (Ideal.Quotient.mk I (Polynomial.C π)) ^ k * Ideal.Quotient.mk I f
      = Ideal.Quotient.mk I (Polynomial.C c) := by
  classical
  have hC : ∀ (k : ℕ) (c : C), (Ideal.Quotient.mk I (Polynomial.C π)) ^ k
      * Ideal.Quotient.mk I (Polynomial.C c) = Ideal.Quotient.mk I (Polynomial.C (π ^ k * c)) := by
    intro k c
    rw [← map_pow, ← map_mul, ← Polynomial.C.map_pow, ← Polynomial.C.map_mul]
  have ht : (Ideal.Quotient.mk I (Polynomial.C π)) ^ e * Ideal.Quotient.mk I Polynomial.X
      = Ideal.Quotient.mk I (Polynomial.C a) := by
    have h0 : Ideal.Quotient.mk I (Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hI
    rw [map_sub, map_mul, map_pow, sub_eq_zero] at h0
    exact h0
  refine Polynomial.induction_on' f ?_ ?_
  · intro p q hp hq
    obtain ⟨kp, cp, hp'⟩ := hp
    obtain ⟨kq, cq, hq'⟩ := hq
    refine ⟨kp + kq, π ^ kq * cp + π ^ kp * cq, ?_⟩
    have e1 : (Ideal.Quotient.mk I (Polynomial.C π)) ^ (kp + kq) * Ideal.Quotient.mk I p
        = Ideal.Quotient.mk I (Polynomial.C (π ^ kq * cp)) := by
      rw [pow_add, mul_comm ((Ideal.Quotient.mk I (Polynomial.C π)) ^ kp), mul_assoc, hp', hC kq cp]
    have e2 : (Ideal.Quotient.mk I (Polynomial.C π)) ^ (kp + kq) * Ideal.Quotient.mk I q
        = Ideal.Quotient.mk I (Polynomial.C (π ^ kp * cq)) := by
      rw [pow_add, mul_assoc, hq', hC kp cq]
    rw [map_add, mul_add, e1, e2, ← map_add, ← Polynomial.C.map_add]
  · intro n b
    refine ⟨e * n, b * a ^ n, ?_⟩
    have hmono : Ideal.Quotient.mk I (Polynomial.monomial n b)
        = Ideal.Quotient.mk I (Polynomial.C b) * (Ideal.Quotient.mk I Polynomial.X) ^ n := by
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
    rw [hmono]
    have hpow : (Ideal.Quotient.mk I (Polynomial.C π)) ^ (e * n)
        * (Ideal.Quotient.mk I Polynomial.X) ^ n = Ideal.Quotient.mk I (Polynomial.C (a ^ n)) := by
      rw [pow_mul, ← mul_pow, ht, ← map_pow, ← Polynomial.C.map_pow]
    rw [← mul_assoc, mul_comm ((Ideal.Quotient.mk I (Polynomial.C π)) ^ (e * n)), mul_assoc,
      hpow, ← map_mul, ← Polynomial.C.map_mul]

theorem N3_ker_aeval {C L : Type*} [CommRing C] [CommRing L] [Algebra C L]
    (hinj : Function.Injective (algebraMap C L)) (π a : C) (e : ℕ) (he : 1 ≤ e)
    (hπL : IsUnit (algebraMap C L π))
    (ha : IsSMulRegular (C ⧸ Ideal.span {π}) (Ideal.Quotient.mk (Ideal.span {π}) a))
    (x : L) (hx : algebraMap C L (π ^ e) * x = algebraMap C L a) :
    RingHom.ker (Polynomial.aeval (R := C) x).toRingHom =
      Ideal.span {Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a} := by
  have hπreg : IsSMulRegular C π :=
    isSMulRegular_of_isUnit_algebraMap hinj hπL
  set g : Polynomial C := Polynomial.C (π ^ e) * Polynomial.X - Polynomial.C a with hg
  set I : Ideal (Polynomial C) := Ideal.span {g} with hI
  have hgI : g ∈ I := by rw [hI]; exact Ideal.subset_span (Set.mem_singleton g)
  have hψg : Polynomial.aeval (R := C) x g = 0 := by
    rw [hg]
    simp only [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X]
    exact sub_eq_zero.mpr hx
  have hspan : I ≤ RingHom.ker (Polynomial.aeval (R := C) x).toRingHom := by
    intro y hy
    rw [hI, Ideal.mem_span_singleton'] at hy
    obtain ⟨q, rfl⟩ := hy
    change Polynomial.aeval (R := C) x (q * g) = 0
    rw [map_mul, hψg, mul_zero]
  refine le_antisymm ?_ hspan
  intro f hf
  rw [RingHom.mem_ker] at hf
  change Polynomial.aeval (R := C) x f = 0 at hf
  obtain ⟨k, c, hkc⟩ := exists_pow_mul_mk_eq π a e I hgI f
  let barψ : Polynomial C ⧸ I →+* L :=
    Ideal.Quotient.lift I (Polynomial.aeval (R := C) x).toRingHom (fun y hy => hspan hy)
  have hbar : ∀ y : Polynomial C, barψ (Ideal.Quotient.mk I y) = Polynomial.aeval (R := C) x y :=
    fun y => Ideal.Quotient.lift_mk I _ _
  have hkey : (barψ (Ideal.Quotient.mk I (Polynomial.C π))) ^ k * barψ (Ideal.Quotient.mk I f)
      = barψ (Ideal.Quotient.mk I (Polynomial.C c)) := by
    rw [← map_pow, ← map_mul, hkc]
  simp only [hbar, Polynomial.aeval_C] at hkey
  rw [hf, mul_zero] at hkey
  have hc0 : c = 0 := by
    apply hinj
    simpa using hkey.symm
  have hzero : (Ideal.Quotient.mk I (Polynomial.C π)) ^ k * Ideal.Quotient.mk I f = 0 := by
    simp only [hkc, hc0, map_zero]
  have hreg := isSMulRegular_quot_span_C_mul_X_sub (π := π) (a := a) (e := e) he hπreg ha
  have hmk0 : Ideal.Quotient.mk I f = 0 := by
    have hsm : (Ideal.Quotient.mk I (Polynomial.C π)) ^ k • Ideal.Quotient.mk I f
        = (Ideal.Quotient.mk I (Polynomial.C π)) ^ k • (0 : Polynomial C ⧸ I) := by
      rw [smul_eq_mul, smul_eq_mul, hzero, mul_zero]
    exact hreg.pow k hsm
  rwa [Ideal.Quotient.eq_zero_iff_mem] at hmk0

end Work.DSM2p
