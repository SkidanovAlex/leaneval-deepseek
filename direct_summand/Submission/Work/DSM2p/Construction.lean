import Submission.Work.DSM2p.Basic
import Submission.Work.DSM2p.RootClosure

/-!
# The Česnavičius–Scholze cover: the construction interface

This module fixes the objects of the construction of André's flatness lemma in the form of
Česnavičius–Scholze (arXiv:1912.10932, proof of Theorem `Andre-lem`), specialised to the frozen
hypotheses of `DSMap.Mix.area_M2'`:

* `MonicPolys A` — the index set `𝒫` of monic polynomials of `A[T]`;
* `RootAlg A p = rootClosure A p 𝒫` — `Λ = A[T_F^{1/p^n}]`, the root-system ring
  (`RootClosure.lean`), which is `A`-flat and `p`-torsion-free;
* `RootAlgLoc A p ϖ = Λ[1/ϖ]`;
* `CSAlg A p ϖ ⊆ Λ[1/ϖ]` — `A_∞`, the subring generated by `Λ` and by the fractions
  `F(T_F)/ϖ^m` (`F ∈ 𝒫`, `m : ℕ`);
* `CSIntegralClosure A p ϖ = pIntClosure p (CSAlg A p ϖ)` — `A'`, the `p`-integral closure;
* `CSCompletion A p ϖ = AdicCompletion (span {p}) A'` — `B`, the `p`-adic completion.

`B` is the candidate cover of the frozen statement.  Since `I_∞ = (F(T_F)/ϖ^m)` is
`ϖ`-divisible and the `(p)`-adic and `(ϖ)`-adic topologies on `A'` agree (`ϖ ^ p = p · unit`),
`I_∞` already vanishes in `B`, so no quotient by `I_∞` is needed.

## Status

The *definitions* are complete and the file is sorry-free.  The properties of `B` that remain to
be proved are:

* `rootElement_aeval` — the images of the `T_F` are roots of the corresponding monic polynomials
  in `B` (delegated; this is the roots clause of the frozen statement, and its proof uses
  `adicCompletion_eq_zero_of_mem_pow`);
* `(H1)` `frobSurj` for `B` (ČS `p-oid-rec`) and `(H2)` faithful flatness of `B ⁄ pB` over
  `A ⁄ pA` (ČS ind-syntomicity, via the approximation lemma).  See `DESIGN.md`.
-/

open scoped Classical

namespace Work.DSM2p

universe u

/-- The index set `𝒫` of the construction: the monic polynomials of `A[T]`. -/
abbrev MonicPolys (A : Type u) [CommRing A] := { F : Polynomial A // F.Monic }

/-- `Λ = A[T_F^{1/p^n} | F ∈ 𝒫, n ≥ 0]`, the root-system ring of the construction. -/
abbrev RootAlg (A : Type u) [CommRing A] (p : ℕ) := rootClosure A p (MonicPolys A)

/-- The root variable `T_F`, i.e. the class of `X_{(F,0)}` in `Λ`. -/
noncomputable def rootVar (A : Type u) [CommRing A] (p : ℕ) (F : MonicPolys A) :
    RootAlg A p :=
  Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolys A)) (MvPolynomial.X (F, 0))

/-- `Λ[1/ϖ]`. -/
abbrev RootAlgLoc (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :=
  Localization.Away (algebraMap A (RootAlg A p) ϖ)

/-- `T_F` regarded as an element of `Λ[1/ϖ]`. -/
noncomputable def rootVarLoc (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (F : MonicPolys A) :
    RootAlgLoc A p ϖ :=
  algebraMap (RootAlg A p) (RootAlgLoc A p ϖ) (rootVar A p F)

/-- `A_∞ ⊆ Λ[1/ϖ]`: the subring generated by `Λ` and the fractions `F(T_F)/ϖ^m`. -/
noncomputable def CSAlg (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Subring (RootAlgLoc A p ϖ) :=
  Subring.closure (Set.range (algebraMap (RootAlg A p) (RootAlgLoc A p ϖ)) ∪
    Set.range (fun q : MonicPolys A × ℕ =>
      algebraMap (RootAlg A p) (RootAlgLoc A p ϖ) (Polynomial.aeval (rootVar A p q.1) q.1.1) *
        IsLocalization.Away.invSelf (algebraMap A (RootAlg A p) ϖ) ^ q.2))

theorem rootVarLoc_mem_CSAlg (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (F : MonicPolys A) :
    rootVarLoc A p ϖ F ∈ CSAlg A p ϖ :=
  Subring.subset_closure (Set.mem_union_left _ ⟨rootVar A p F, rfl⟩)

/-- `A'`: the `p`-integral closure of `A_∞` in `Λ[1/ϖ]` (ČS §`p-int-cl`). -/
noncomputable def CSIntegralClosure (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Subring (RootAlgLoc A p ϖ) :=
  pIntClosure p (CSAlg A p ϖ)

theorem CSAlg_le_CSIntegralClosure (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    CSAlg A p ϖ ≤ CSIntegralClosure A p ϖ :=
  le_pIntClosure p (CSAlg A p ϖ)

theorem CSIntegralClosure_isPIntegrallyClosed (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    IsPIntegrallyClosedIn p (CSIntegralClosure A p ϖ) :=
  pIntClosure_isPIntegrallyClosed p (CSAlg A p ϖ)

/-- `T_F` regarded as an element of `A'`. -/
noncomputable def rootVarInClosure (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)
    (F : MonicPolys A) : CSIntegralClosure A p ϖ :=
  ⟨rootVarLoc A p ϖ F, CSAlg_le_CSIntegralClosure A p ϖ (rootVarLoc_mem_CSAlg A p ϖ F)⟩

/-- `B`: the `p`-adic completion of `A'`, the candidate perfectoid cover. -/
abbrev CSCompletion (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :=
  AdicCompletion (Ideal.span {(p : CSIntegralClosure A p ϖ)}) (CSIntegralClosure A p ϖ)

/-- The image of `T_F` in the completion `B`. -/
noncomputable def rootElement (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (F : MonicPolys A) :
    CSCompletion A p ϖ :=
  algebraMap (CSIntegralClosure A p ϖ) (CSCompletion A p ϖ) (rootVarInClosure A p ϖ F)

/-- The structure map `A → Λ → Λ[1/ϖ]`. -/
noncomputable def AAlgHomLoc (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    A →+* RootAlgLoc A p ϖ :=
  (algebraMap (RootAlg A p) (RootAlgLoc A p ϖ)).comp (algebraMap A (RootAlg A p))

theorem AAlgHomLoc_mem_CSAlg (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (a : A) :
    AAlgHomLoc A p ϖ a ∈ CSAlg A p ϖ :=
  Subring.subset_closure (Set.mem_union_left _ ⟨algebraMap A (RootAlg A p) a, rfl⟩)

/-- `A'` is an `A`-algebra, with structure map `A → Λ → Λ[1/ϖ]`, whose image lies in
`A_∞ ≤ A'`. -/
noncomputable instance (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Algebra A (CSIntegralClosure A p ϖ) :=
  (RingHom.codRestrict (AAlgHomLoc A p ϖ) _
    (fun a => CSAlg_le_CSIntegralClosure A p ϖ (AAlgHomLoc_mem_CSAlg A p ϖ a))).toAlgebra

theorem CSCompletion_isAdicComplete (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    IsAdicComplete (Ideal.span {(p : CSIntegralClosure A p ϖ)}) (CSCompletion A p ϖ) :=
  AdicCompletion.isAdicComplete (Submodule.fg_span_singleton (p : CSIntegralClosure A p ϖ))

end Work.DSM2p
