import Submission.Work.DSM2p.CSIntegralClosurePos_quot_integral
import Submission.Work.DSM2p.nilp_prime_le_maximal

/-!
# `Work.DSM2p.ker_algebraMap_quot_le_maximal_assembly`

The assembly of the kernel estimate `ker (A → A' ⧸ J) ≤ 𝔪` from the two construction pieces:

* `Work.DSM2p.nilp_prime_le_maximal` — a prime `𝔮 ⊆ 𝔪` avoiding the non-zero-divisor `p`
  (already in the workspace);
* the model field `K` with `A → K` of kernel `𝔮`, in which `ϖ` is a unit and every
  `F ∈ 𝒫⁺ = MonicPolysPos A` has a compatible system of `p`-power roots
  (`Work.DSM2p.exists_model_field_of_prime`, delegated).

Given those data, `Λ = A[X_{(F,n)}] ⧸ (X_{(F,n+1)}^p - X_{(F,n)}) → K`, `X_{(F,n)} ↦ r F n`, is a
well-defined `A`-algebra map (it respects the relations), it extends to `Λ[1/ϖ]` (since `ϖ` maps to
a unit of `K`), and it annihilates `F(T_F) = aeval (T_F) F` for every `F ∈ 𝒫⁺`; hence it kills the
ideal `I_∞ ⊆ A_∞` generated by the fractions `F(T_F)/ϖ^m`, and therefore kills `J = I_∞·A'`.  So it
factors as `A' ⧸ J → K`, and the composite `A → A' ⧸ J → K` is `A → A ⧸ 𝔮 → K`, of kernel `𝔮 ≤ 𝔪`.
-/

open scoped Classical

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 1000000

namespace Work.DSM2p

universe u

noncomputable section

variable (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A] (P : DSMap.PerfectoidData p A)

/-- **The kernel estimate from the model field.**  Given a prime `𝔮 ≤ 𝔪` and an `A`-algebra `K`
which is a field with `ker (A → K) = 𝔮`, in which `ϖ` is a unit and in which every positive-degree
monic `F` has a compatible system of `p`-power roots, the kernel of `A → A' ⧸ J` is contained
in `𝔪`. -/
theorem ker_le_of_model_field (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal) (hp : (p : A) ∈ 𝔪)
    (𝔮 : Ideal A) (h𝔮le : 𝔮 ≤ 𝔪)
    (K : Type u) [Field K] [Algebra A K]
    (hkerK : RingHom.ker (algebraMap A K) = 𝔮)
    (hϖunit : IsUnit (algebraMap A K (P.ϖ 0)))
    (hroots : ∀ F : MonicPolysPos A, ∃ r : ℕ → K,
      (∀ n : ℕ, r (n + 1) ^ p = r n) ∧
      Polynomial.aeval (r 0) (F.1.map (algebraMap A K)) = 0) :
    RingHom.ker (algebraMap A
      (↥(CSIntegralClosurePos A p (P.ϖ 0)) ⧸ CSIdealPosExt A p (P.ϖ 0))) ≤ 𝔪 := by
  classical
  choose r hr using hroots
  -- the values of the variables `X_{(F,n)}`
  set ρ : MonicPolysPos A × ℕ → K := fun i => r i.1 i.2 with hρ
  have hρpow : ∀ i : MonicPolysPos A × ℕ, ρ (i.1, i.2 + 1) ^ p = ρ (i.1, i.2) :=
    fun i => (hr i.1).1 i.2
  have hρroot : ∀ F : MonicPolysPos A,
      Polynomial.aeval (ρ (F, 0)) (F.1.map (algebraMap A K)) = 0 := fun F => (hr F).2
  -- the map on the polynomial ring
  set ι : MvPolynomial (MonicPolysPos A × ℕ) A →+* K :=
    MvPolynomial.eval₂Hom (algebraMap A K) ρ with hι
  have hι_X : ∀ i : MonicPolysPos A × ℕ, ι (MvPolynomial.X i) = ρ i :=
    fun i => MvPolynomial.eval₂Hom_X' _ _ i
  have hι_C : ∀ a : A, ι (MvPolynomial.C a) = algebraMap A K a :=
    fun a => MvPolynomial.eval₂Hom_C _ _ a
  -- it respects the relations of `Λ`
  have hrel : ∀ (q : MvPolynomial (MonicPolysPos A × ℕ) A),
      q ∈ rootClosureIdeal A p (MonicPolysPos A) → ι q = 0 := by
    intro q hq
    have hle : rootClosureIdeal A p (MonicPolysPos A) ≤ RingHom.ker ι := by
      rw [rootClosureIdeal, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      show ι (MvPolynomial.X (j.1, j.2 + 1) ^ p - MvPolynomial.X j) = 0
      rw [map_sub, map_pow, hι_X, hι_X, hρpow j, sub_self]
    exact hle hq
  -- the induced map `Λ → K`
  set ψ : RootAlgPos A p →+* K :=
    Ideal.Quotient.lift (rootClosureIdeal A p (MonicPolysPos A)) ι hrel with hψ
  have hψ_apply : ∀ q : MvPolynomial (MonicPolysPos A × ℕ) A,
      ψ (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A)) q) = ι q :=
    fun q => Ideal.Quotient.lift_mk (rootClosureIdeal A p (MonicPolysPos A)) ι hrel (a := q)
  have hψ_rootVar : ∀ F : MonicPolysPos A, ψ (rootVarPos A p F) = ρ (F, 0) := by
    intro F
    rw [rootVarPos, hψ_apply, hι_X]
  have hψ_commutes : ∀ a : A,
      ψ (algebraMap A (RootAlgPos A p) a) = algebraMap A K a := by
    intro a
    rw [show algebraMap A (RootAlgPos A p) a
        = Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
          (algebraMap A (MvPolynomial (MonicPolysPos A × ℕ) A) a) from rfl,
      hψ_apply, MvPolynomial.algebraMap_eq, hι_C]
  -- the `A`-algebra structure on `ψ`
  set ψA : RootAlgPos A p →ₐ[A] K := { toRingHom := ψ, commutes' := hψ_commutes } with hψA
  have hψA_apply : ∀ l : RootAlgPos A p, ψA l = ψ l := fun l => rfl
  have hψA_aeval : ∀ F : MonicPolysPos A,
      ψA (Polynomial.aeval (rootVarPos A p F) F.1) = 0 := by
    intro F
    have h1 : Polynomial.aeval (ψA (rootVarPos A p F)) (F.1.map (algebraMap A K)) = 0 := by
      rw [hψA_apply, hψ_rootVar]
      exact hρroot F
    rw [← Polynomial.aeval_algHom_apply ψA (rootVarPos A p F) F.1,
      ← Polynomial.aeval_map_algebraMap (A := K) (x := ψA (rootVarPos A p F)) F.1]
    exact h1
  -- the localizing element and its image
  have hunit : IsUnit (ψ (algebraMap A (RootAlgPos A p) (P.ϖ 0))) := by
    rw [← hψA_apply, AlgHom.commutes ψA (P.ϖ 0)]
    exact hϖunit
  set ψhat : RootAlgLocPos A p (P.ϖ 0) →+* K :=
    IsLocalization.Away.lift (algebraMap A (RootAlgPos A p) (P.ϖ 0)) hunit with hψhat
  have hψhat_alg : ∀ l : RootAlgPos A p,
      ψhat (algebraMap (RootAlgPos A p) (RootAlgLocPos A p (P.ϖ 0)) l) = ψ l := by
    intro l
    rw [hψhat, IsLocalization.Away.lift_eq]
  -- the generators of `I_∞` are killed
  have hgen_kill : ∀ q : MonicPolysPos A × ℕ,
      ψhat (algebraMap (RootAlgPos A p) (RootAlgLocPos A p (P.ϖ 0))
              (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
            IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) (P.ϖ 0)) ^ q.2) = 0 := by
    intro q
    rw [map_mul, map_pow, hψhat_alg, ← hψA_apply, hψA_aeval q.1, zero_mul]
  -- the induced map `A' → K` and the vanishing on `J`
  set Φ₀ : ↥(CSIntegralClosurePos A p (P.ϖ 0)) →+* K :=
    ψhat.comp (CSIntegralClosurePos A p (P.ϖ 0)).subtype with hΦ₀
  have hΦ₀_apply : ∀ x : ↥(CSIntegralClosurePos A p (P.ϖ 0)),
      Φ₀ x = ψhat (x : RootAlgLocPos A p (P.ϖ 0)) := fun x => rfl
  have hJkill : ∀ x : ↥(CSIntegralClosurePos A p (P.ϖ 0)),
      x ∈ CSIdealPosExt A p (P.ϖ 0) → Φ₀ x = 0 := by
    intro x hx
    have hle : CSIdealPosExt A p (P.ϖ 0) ≤ RingHom.ker Φ₀ := by
      rw [CSIdealPosExt, Ideal.map_le_iff_le_comap, CSIdealPos, Ideal.span_le]
      rintro x ⟨q, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
      have hgen : CSAlgPos.toCSIntegralClosure A p (P.ϖ 0)
          ⟨algebraMap (RootAlgPos A p) (RootAlgLocPos A p (P.ϖ 0))
              (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
              IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) (P.ϖ 0)) ^ q.2,
            Subring.subset_closure (Set.mem_union_right _ ⟨q, rfl⟩)⟩
          = ⟨algebraMap (RootAlgPos A p) (RootAlgLocPos A p (P.ϖ 0))
              (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
              IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) (P.ϖ 0)) ^ q.2, _⟩ :=
        Subtype.ext rfl
      rw [hgen, hΦ₀_apply]
      exact hgen_kill q
    exact hle hx
  -- the induced map on the quotient
  set Φ : (↥(CSIntegralClosurePos A p (P.ϖ 0)) ⧸ CSIdealPosExt A p (P.ϖ 0)) →+* K :=
    Ideal.Quotient.lift (CSIdealPosExt A p (P.ϖ 0)) Φ₀ hJkill with hΦ
  -- the composite `A → A' ⧸ J → K` is `A → K`
  have hΦ_comp : ∀ a : A, Φ (algebraMap A _ a) = algebraMap A K a := by
    intro a
    rw [hΦ, show algebraMap A (↥(CSIntegralClosurePos A p (P.ϖ 0)) ⧸
          CSIdealPosExt A p (P.ϖ 0)) a
        = Ideal.Quotient.mk (CSIdealPosExt A p (P.ϖ 0))
            (algebraMap A ↥(CSIntegralClosurePos A p (P.ϖ 0)) a) from rfl,
      Ideal.Quotient.lift_mk (CSIdealPosExt A p (P.ϖ 0)) Φ₀ hJkill, hΦ₀_apply]
    show ψhat ((algebraMap A ↥(CSIntegralClosurePos A p (P.ϖ 0)) a :
      RootAlgLocPos A p (P.ϖ 0))) = algebraMap A K a
    rw [show (algebraMap A ↥(CSIntegralClosurePos A p (P.ϖ 0)) a :
          RootAlgLocPos A p (P.ϖ 0))
        = algebraMap A (RootAlgLocPos A p (P.ϖ 0)) a from rfl,
      IsScalarTower.algebraMap_apply A (RootAlgPos A p) (RootAlgLocPos A p (P.ϖ 0)) a,
      hψhat_alg, ← hψA_apply, AlgHom.commutes]
  -- conclusion
  intro a ha
  have hzero : algebraMap A K a = 0 := by
    rw [← hΦ_comp a, ha, map_zero]
  have hmem : a ∈ RingHom.ker (algebraMap A K) := hzero
  rw [hkerK] at hmem
  exact h𝔮le hmem

end

end Work.DSM2p
