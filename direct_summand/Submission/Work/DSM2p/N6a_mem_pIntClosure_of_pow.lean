import Mathlib
import Submission.Work.DSM2p.Basic

namespace Work.DSM2p

/-- **`p`-integral closure: an `N`-th root with `ϖ`-bounded denominator is `p`-integral.**

Let `V ≤ L` be a subring, `ϖ ∈ V`, `x ∈ L`, `N > 0`, and suppose that

* `ϖ ^ s * x ∈ V` (`x` has `ϖ`-power denominator bounded by `s`), and
* `x ^ N = ϖ * v` with `v ∈ V` (so `x ^ N ∈ V`).

Then `x` lies in the `p`-integral closure of `V`.

The mechanism is two-fold.  First, the two relations are read as a *monoid of exponents*:
`x ^ N ∈ V` and, by a `ϖ`-decimation using `x ^ N = ϖ * v`, also
`x ^ (1 + s * N) ∈ V` (this is the `k = s` case of `ϖ ^ (s - k) * x ^ (1 + k * N) ∈ V`).
Since `gcd (N, 1 + s * N) = 1`, the monoid generated by these two exponents is cofinite in `ℕ`;
in particular it contains `p ^ K` for `K` large, so `x ^ (p ^ K) ∈ V`.  Then `p`-integral
closedness of `pIntClosure p V` descends `x ^ (p ^ K)` down the `p`-power ladder to `x`. -/
theorem N6a_mem_pIntClosure_of_pow {L : Type*} [CommRing L] (p : ℕ) (hp : 1 < p)
    (V : Subring L) (ϖ : L) (hϖ : ϖ ∈ V) (x : L) (s N : ℕ) (hN : 0 < N)
    (hs : ϖ ^ s * x ∈ V) (hx : ∃ v ∈ V, x ^ N = ϖ * v) : x ∈ pIntClosure p V := by
  obtain ⟨v, hv, hxv⟩ := hx
  -- `x ^ N ∈ V`
  have hxN : x ^ N ∈ V := by rw [hxv]; exact V.mul_mem hϖ hv
  -- Step 1: `ϖ ^ (s - k) * x ^ (1 + k * N) ∈ V` for all `k ≤ s`; at `k = s` this is
  -- `x ^ (1 + s * N) ∈ V`.
  have hkey : ∀ k, k ≤ s → ϖ ^ (s - k) * x ^ (1 + k * N) ∈ V := by
    intro k
    induction k with
    | zero => intro _; simpa using hs
    | succ k ih =>
      intro hk
      have hle : k ≤ s := Nat.le_of_succ_le hk
      have ihn := ih hle
      have hsub : s - (k + 1) + 1 = s - k := by omega
      have hpow : ϖ ^ (s - (k + 1)) * ϖ = ϖ ^ (s - k) := by rw [← pow_succ, hsub]
      have h1 : x ^ (1 + (k + 1) * N) = x ^ (1 + k * N) * (ϖ * v) := by
        rw [show 1 + (k + 1) * N = (1 + k * N) + N by ring, pow_add, hxv]
      have h2 : ϖ ^ (s - (k + 1)) * x ^ (1 + (k + 1) * N)
          = (ϖ ^ (s - k) * x ^ (1 + k * N)) * v := by
        rw [h1, ← hpow]; ring
      rw [h2]
      exact V.mul_mem ihn hv
  have hxsN : x ^ (1 + s * N) ∈ V := by
    have h := hkey s le_rfl
    rwa [Nat.sub_self, pow_zero, one_mul] at h
  -- Step 2: `p`-power descent inside the (`p`-integrally closed) `p`-integral closure.
  have hmem : ∀ k : ℕ, x ^ (p ^ k) ∈ pIntClosure p V → x ∈ pIntClosure p V := by
    intro k
    induction k with
    | zero => intro h; simpa using h
    | succ k ih =>
      intro h
      apply ih
      apply pIntClosure_isPIntegrallyClosed p V
      have hh : (x ^ (p ^ k)) ^ p = x ^ (p ^ (k + 1)) := by rw [← pow_mul, pow_succ]
      rw [hh]; exact h
  -- Step 3: `p ^ K` lies in the monoid `⟨N, 1 + s * N⟩` of exponents `m` with `x ^ m ∈ V`.
  set K : ℕ := N * ((N - 1) * s) + N with hK
  have hpK : N * ((N - 1) * s) + N - 1 ≤ p ^ K := by
    have h1 : K ≤ 2 ^ K := le_of_lt Nat.lt_two_pow_self
    have hp2 : 2 ≤ p := hp
    have h2 : 2 ^ K ≤ p ^ K := Nat.pow_le_pow_left hp2 K
    have h3 : N * ((N - 1) * s) + N - 1 ≤ K := by rw [hK]; omega
    exact le_trans h3 (le_trans h1 h2)
  set q : ℕ := p ^ K / N with hq
  set r : ℕ := p ^ K % N with hr
  have hdec : N * q + r = p ^ K := by
    have h := Nat.div_add_mod (p ^ K) N
    rw [← hq, ← hr] at h
    exact h
  have hrle : r ≤ N - 1 := by
    have : r < N := by rw [hr]; exact Nat.mod_lt _ hN
    omega
  -- the `N`-adic quotient `q` of `p ^ K` dominates `r * s`
  have hrsq : r * s ≤ q := by
    have hA : N * ((N - 1) * s) ≤ p ^ K - (N - 1) := by omega
    have hB : p ^ K - (N - 1) ≤ N * q := by omega
    have hC : N * ((N - 1) * s) ≤ N * q := le_trans hA hB
    have hD : (N - 1) * s ≤ q := Nat.le_of_mul_le_mul_left hC hN
    exact le_trans (Nat.mul_le_mul_right s hrle) hD
  -- `p ^ K = (q - r * s) * N + (1 + s * N) * r` with non-negative coefficients
  have hrepr : N * (q - r * s) + (1 + s * N) * r = p ^ K := by
    have hmul : N * (q - r * s) = N * q - N * (r * s) := Nat.mul_sub_left_distrib N q (r * s)
    have hcomm : N * (r * s) = (r * s) * N := Nat.mul_comm N (r * s)
    have hdist : (1 + s * N) * r = r + (r * s) * N := by ring
    have hle : (r * s) * N ≤ N * q := by
      have h := Nat.mul_le_mul_right N hrsq
      rw [mul_comm q N] at h
      exact h
    rw [hmul, hcomm, hdist]
    omega
  have hxpk : x ^ (p ^ K) ∈ V := by
    have hpow : (x ^ N) ^ (q - r * s) * (x ^ (1 + s * N)) ^ r = x ^ (p ^ K) := by
      rw [← pow_mul, ← pow_mul, ← pow_add, hrepr]
    rw [← hpow]
    exact V.mul_mem (V.pow_mem hxN _) (V.pow_mem hxsN _)
  exact hmem K (le_pIntClosure p V hxpk)

end Work.DSM2p
