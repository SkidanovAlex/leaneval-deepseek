import Submission.Work.DSM2p.CSAlgPos_mod_varpi_flat_aux

/-!
# `Work.DSM2p.SMulTopAux` — the reduction of `smul_top_ne_top_CSIntegralClosurePos`

Vocabulary and the "easy" half of the proof of

`𝔪 • (⊤ : Submodule A ↥(CSIntegralClosurePos A p (P.ϖ 0))) ≠ ⊤`

for `A` a perfectoid ring (`P : DSMap.PerfectoidData p A`) and `𝔪` a maximal ideal of `A` with
`p ∈ 𝔪`.

Write `ϖ := P.ϖ 0`, `A_∞ := CSAlgPos A p ϖ ⊆ Λ[1/ϖ]`, `A' := CSIntegralClosurePos A p ϖ`
(the `p`-integral closure of `A_∞`), `I_∞ := CSIdealPos A p ϖ ⊆ A_∞` (the ideal generated by the
fractions `F(T_F)/ϖ^m`) and

`J := I_∞·A' = Ideal.map (A_∞ → A') I_∞ ⊆ A'`.

The mathematical content is that `A' ⧸ J` is *integral* over `A` while `J ⊆ 𝔪A'`, and that
`ker (A → A' ⧸ J) ⊆ 𝔪`; then, `A' ⧸ J` being integral over `A` with `A ⧸ 𝔪` a field of the right
kind, the fibre `(A' ⧸ J) ⊗[A] A ⧸ 𝔪 ≅ A' ⧸ 𝔪A'` is nonzero, so `𝔪A' ≠ A'`.

This file collects the definitions and the elementary reductions; the two substantive inputs are
`Work.DSM2p.isIntegral_quot_CSIntegralClosurePos` (integrality of `A' ⧸ J`) and
`Work.DSM2p.ker_algebraMap_quot_le_maximal` (the kernel estimate), in sibling files.

## A proof plan for `Work.DSM2p.ker_algebraMap_quot_le_maximal`

The statement is `ker (A → A' ⧸ J) ≤ 𝔪`, equivalently: if `a ∈ A` maps into `J` then `a ∈ 𝔪`.

1. **A prime `𝔮 ⊆ 𝔪` with `p ∉ 𝔮`.**  `p` is a non-zero-divisor of `A` (`P.torsionFree`), hence
   of the localization `A_𝔪`; a minimal prime `𝔭` of `A_𝔪` contains no non-zero-divisor
   (`notMem_nonZeroDivisors_of_mem_mem_minimalPrimes`,
   `Mathlib/RingTheory/Ideal/MinimalPrime/Localization.lean`), and a prime of `A_𝔪` contracts to a
   prime `𝔮 ⊆ 𝔪` (`a ∉ 𝔪` ⇒ `a` invertible in `A_𝔪` ⇒ `a ∉ 𝔮`), with `p ∉ 𝔮`.
2. **A model field `K`.**  Let `K = AlgebraicClosure (FractionRing (A ⧸ 𝔮))`, an `A`-algebra
   (field, algebraically closed), so `p ∉ 𝔮` gives `algebraMap A K p ≠ 0` and hence
   `algebraMap A K ϖ ≠ 0` (`ϖ ^ p = p · u`).  For every `F : MonicPolysPos A` choose a root of
   `F.1.map (algebraMap A K)` in `K` and then, by `Classical.choose` and `Nat.rec`, a compatible
   system `r F : ℕ → K`, `(r F (n+1)) ^ p = r F n`, `aeval (r F 0) (F.1.map _) = 0`.
3. **The homomorphism `Λ →+* K`.**  `X_{(F,n)} ↦ r F n` respects the relations
   `X_{(F,n+1)} ^ p = X_{(F,n)}` of `Λ = MvPolynomial (MonicPolysPos A × ℕ) A ⧸ rootClosureIdeal`,
   so it descends (`MvPolynomial.eval₂` + `Ideal.Quotient.lift`).  Since `ϖ ↦` a nonzero element of
   the field `K`, it extends to `ψ : Λ[1/ϖ] →+* K` (`IsLocalization.Away.lift`).
4. **`ψ` kills `J`.**  For `F ∈ 𝒫⁺` and `m : ℕ`, the generator `F(T_F)/ϖ^m` of `I_∞` maps to
   `aeval (r F 0) (F.1.map _) · ψ ϖ ^ (-m) = 0`; hence `ψ` kills `I_∞`, so it kills
   `J = I_∞ · A'` (`Ideal.map_le_iff_le_comap`).  Therefore `ψ` induces
   `A' ⧸ J →+* K`, and the composite `A → A' ⧸ J → K` is the composite `A → Λ[1/ϖ] → K`, i.e.
   `A → A ⧸ 𝔮 → K`, whose kernel is `𝔮`.  So `ker (A → A' ⧸ J) ≤ 𝔮 ≤ 𝔪`.
-/

open scoped Classical

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 1000000

namespace Work.DSM2p

universe u

/-- The inclusion `A_∞ = CSAlgPos A p ϖ → A' = CSIntegralClosurePos A p ϖ`, i.e. the map
`x ↦ ⟨x, _⟩` induced by `CSAlgPos_le_CSIntegralClosurePos`. -/
noncomputable def CSAlgPos.toCSIntegralClosure (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    ↥(CSAlgPos A p ϖ) →+* ↥(CSIntegralClosurePos A p ϖ) :=
  RingHom.codRestrict (CSAlgPos A p ϖ).subtype (CSIntegralClosurePos A p ϖ)
    (fun x => CSAlgPos_le_CSIntegralClosurePos A p ϖ x.2)

@[simp]
theorem CSAlgPos.toCSIntegralClosure_apply (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)
    (x : ↥(CSAlgPos A p ϖ)) :
    ((CSAlgPos.toCSIntegralClosure A p ϖ x : ↥(CSIntegralClosurePos A p ϖ)) :
        RootAlgLocPos A p ϖ)
      = (x : RootAlgLocPos A p ϖ) := rfl

/-- **The ideal `J = I_∞·A'`**: the extension of the Česnavičius–Scholze ideal `I_∞ ⊆ A_∞` to the
`p`-integral closure `A'`. -/
noncomputable def CSIdealPosExt (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    Ideal ↥(CSIntegralClosurePos A p ϖ) :=
  Ideal.map (CSAlgPos.toCSIntegralClosure A p ϖ) (CSIdealPos A p ϖ)

/-- **`ϖ ∈ 𝔪`.**  If `𝔪` is a maximal ideal of `A` containing `p` then it contains `P.ϖ 0`:
`ϖ ^ p = p · u` with `u` a unit, so `ϖ ^ p ∈ 𝔪` and `𝔪` is prime. -/
theorem varpi_mem_of_isMaximal (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    (P : DSMap.PerfectoidData p A) (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal) (hp : (p : A) ∈ 𝔪) :
    P.ϖ 0 ∈ 𝔪 := by
  obtain ⟨v, hv⟩ := P.unit
  have hmem : P.ϖ 0 ^ p ∈ 𝔪 := by
    rw [hv]
    exact Ideal.mul_mem_right _ _ hp
  exact h𝔪.isPrime.mem_of_pow_mem p hmem

/-- **`J ⊆ 𝔪A'`.**  `I_∞` is `ϖ`-divisible (`CSIdealPos_le_map_span_varpi`), so `J = I_∞A' ⊆
ϖA' ⊆ 𝔪A'` because `ϖ ∈ 𝔪`. -/
theorem CSIdealPosExt_le_map_maximal (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    (P : DSMap.PerfectoidData p A) (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal) (hp : (p : A) ∈ 𝔪) :
    CSIdealPosExt A p (P.ϖ 0) ≤
      Ideal.map (algebraMap A ↥(CSIntegralClosurePos A p (P.ϖ 0))) 𝔪 := by
  have hϖ : P.ϖ 0 ∈ 𝔪 := varpi_mem_of_isMaximal p A P 𝔪 h𝔪 hp
  have hcomp : (CSAlgPos.toCSIntegralClosure A p (P.ϖ 0)).comp
      (algebraMap A ↥(CSAlgPos A p (P.ϖ 0)))
      = algebraMap A ↥(CSIntegralClosurePos A p (P.ϖ 0)) := by
    ext a
    rfl
  have h1 : CSIdealPosExt A p (P.ϖ 0) ≤
      Ideal.map (CSAlgPos.toCSIntegralClosure A p (P.ϖ 0))
        (Ideal.map (algebraMap A ↥(CSAlgPos A p (P.ϖ 0))) (Ideal.span {P.ϖ 0})) :=
    Ideal.map_mono (CSIdealPos_le_map_span_varpi A p (P.ϖ 0))
  rw [Ideal.map_map, hcomp] at h1
  refine h1.trans ?_
  rw [Ideal.map_span, Set.image_singleton]
  exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.mem_map_of_mem _ hϖ))

/-- **Integral extensions have nonzero fibres over maximal ideals.**  If `S` is an integral
`R`-algebra whose structure map has kernel contained in the maximal ideal `𝔪`, then
`𝔪S ≠ S` — equivalently `𝔪 • ⊤ ≠ ⊤` in `S`.  This is the lying-over theorem: a prime `Q ⊆ S`
over `𝔪` contains `𝔪S` and is proper. -/
theorem smul_top_ne_top_of_isIntegral_of_ker_le (R S : Type u) [CommRing R] [CommRing S]
    [Algebra R S] [Algebra.IsIntegral R S] (𝔪 : Ideal R) (h𝔪 : 𝔪.IsMaximal)
    (hker : RingHom.ker (algebraMap R S) ≤ 𝔪) :
    𝔪 • (⊤ : Submodule R S) ≠ ⊤ := by
  intro htop
  have hmap : Ideal.map (algebraMap R S) 𝔪 = ⊤ := by
    have h := htop
    rw [Ideal.smul_top_eq_map] at h
    exact (Submodule.restrictScalars_eq_top_iff R _ _).mp h
  obtain ⟨Q, -, hQprime, hQunder⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral (R := R) (S := S) 𝔪 (⊥ : Ideal S)
      (by rw [Ideal.under, ← RingHom.ker_eq_comap_bot]; exact hker)
  have hle : Ideal.map (algebraMap R S) 𝔪 ≤ Q := by
    rw [← hQunder, Ideal.under, Ideal.map_le_iff_le_comap]
  exact hQprime.ne_top (top_le_iff.mp (hmap ▸ hle))

end Work.DSM2p
