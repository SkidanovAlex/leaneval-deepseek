import Submission.Work.DSM2p.SMulTopAux

/-!
# `Work.DSM2p.CSIntegralClosurePos_quot_integral`

**`A' ⧸ J` is integral over `A`.**

Notation: `Λ = RootAlgPos A p` (`= A[T_F^{1/p^n}]`), `L = Λ[1/ϖ] = RootAlgLocPos A p ϖ`,
`A_∞ = CSAlgPos A p ϖ ⊆ L`, `A' = CSIntegralClosurePos A p ϖ ⊆ L` (the `p`-integral closure of
`A_∞`), `I_∞ = CSIdealPos A p ϖ ⊆ A_∞` (the ideal generated by the fractions `F(T_F)/ϖ^m`) and
`J = CSIdealPosExt A p ϖ = I_∞·A' ⊆ A'`.

Every element of `A_∞` is a polynomial in the images of the variables `X_{(F,n)}` of `Λ` and in the
fractions `F(T_F)/ϖ^m`; the latter *vanish* in `A' ⧸ J`, while the former become integral over `A`,
because `F(T_F) ∈ J` (so the class of `T_F = X_{(F,0)}` is a root of the monic polynomial `F`) and
the class of `X_{(F,n)}` satisfies `(X_{(F,n)})^{p^n} = X_{(F,0)}`.  Hence the image of `Λ` in
`A' ⧸ J` consists of integral elements.

It follows that the subring `C' ⊆ L` of elements of `A'` whose image in `A' ⧸ J` is integral over `A`
contains `A_∞` and is `p`-integrally closed (as `A'` is), so `A' = pIntClosure p A_∞ ≤ C'`; that is,
*all* elements of `A' ⧸ J` are integral over `A`.
-/

open scoped Classical

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 1000000

namespace Work.DSM2p

universe u

noncomputable section

variable (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)

/-- The inclusion `Λ → A_∞` as an `A`-algebra map. -/
noncomputable def RootAlgPos.toCSAlgPosAlg :
    RootAlgPos A p →ₐ[A] ↥(CSAlgPos A p ϖ) :=
  { toRingHom := RootAlgPos.toCSAlgPos A p ϖ
    commutes' := fun a => RootAlgPos.toCSAlgPos_algebraMap' A p ϖ a }

/-- The inclusion `A_∞ → A'` as an `A`-algebra map. -/
noncomputable def CSAlgPos.toCSIntegralClosureAlg :
    ↥(CSAlgPos A p ϖ) →ₐ[A] ↥(CSIntegralClosurePos A p ϖ) :=
  { toRingHom := CSAlgPos.toCSIntegralClosure A p ϖ
    commutes' := fun a => by
      apply Subtype.ext
      rfl }

/-- The composite `A_∞ → A' ⧸ J`. -/
noncomputable def toQuotCSAlg :
    ↥(CSAlgPos A p ϖ) →ₐ[A] (↥(CSIntegralClosurePos A p ϖ) ⧸ CSIdealPosExt A p ϖ) :=
  (Ideal.Quotient.mkₐ A (CSIdealPosExt A p ϖ)).comp (CSAlgPos.toCSIntegralClosureAlg A p ϖ)

/-- The composite `Λ → A_∞ → A' ⧸ J`. -/
noncomputable def toQuotRoot :
    RootAlgPos A p →ₐ[A] (↥(CSIntegralClosurePos A p ϖ) ⧸ CSIdealPosExt A p ϖ) :=
  (toQuotCSAlg A p ϖ).comp (RootAlgPos.toCSAlgPosAlg A p ϖ)

/-- The composite `A[X_{(F,n)}] → Λ → A_∞ → A' ⧸ J`. -/
noncomputable def toQuotMv :
    MvPolynomial (MonicPolysPos A × ℕ) A →ₐ[A]
      (↥(CSIntegralClosurePos A p ϖ) ⧸ CSIdealPosExt A p ϖ) :=
  (toQuotRoot A p ϖ).comp (Ideal.Quotient.mkₐ A (rootClosureIdeal A p (MonicPolysPos A)))

theorem toQuotCSAlg_apply (x : ↥(CSAlgPos A p ϖ)) :
    toQuotCSAlg A p ϖ x = Ideal.Quotient.mk (CSIdealPosExt A p ϖ)
      (CSAlgPos.toCSIntegralClosure A p ϖ x) := rfl

/-- The element `aeval (T_F) F ∈ Λ` maps to the generator of `I_∞` of index `(F, 0)`. -/
theorem toCSAlgPos_aeval_rootVarPos_mem (F : MonicPolysPos A) :
    RootAlgPos.toCSAlgPos A p ϖ (Polynomial.aeval (rootVarPos A p F) F.1) ∈ CSIdealPos A p ϖ := by
  have he : RootAlgPos.toCSAlgPos A p ϖ (Polynomial.aeval (rootVarPos A p F) F.1) =
      (⟨algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)
          (Polynomial.aeval (rootVarPos A p F) F.1) *
          IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) ϖ) ^ (0 : ℕ),
        Subring.subset_closure (Set.mem_union_right _ ⟨(F, 0), rfl⟩)⟩ :
          ↥(CSAlgPos A p ϖ)) := by
    apply Subtype.ext
    rw [RootAlgPos.toCSAlgPos_apply]
    simp
  rw [he]
  exact Ideal.subset_span ⟨(F, 0), rfl⟩

theorem toQuotRoot_apply (l : RootAlgPos A p) :
    toQuotRoot A p ϖ l = Ideal.Quotient.mk (CSIdealPosExt A p ϖ)
      (CSAlgPos.toCSIntegralClosure A p ϖ (RootAlgPos.toCSAlgPos A p ϖ l)) := rfl

/-- **The class of `T_F` is a root of `F`.**  For `F ∈ 𝒫⁺` the element
`F(T_F) = aeval (T_F) F` lies in `I_∞`, hence in `J`, so its image in `A' ⧸ J` vanishes. -/
theorem aeval_rootVar_image_eq_zero (F : MonicPolysPos A) :
    Polynomial.aeval (toQuotRoot A p ϖ (rootVarPos A p F)) F.1 = 0 := by
  rw [Polynomial.aeval_algHom_apply (toQuotRoot A p ϖ) (rootVarPos A p F) F.1, toQuotRoot_apply,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mem_map_of_mem _ (toCSAlgPos_aeval_rootVarPos_mem A p ϖ F)

/-- **The class of `T_F` is integral over `A`.** -/
theorem isIntegral_toQuotRoot_rootVar (F : MonicPolysPos A) :
    IsIntegral A (toQuotRoot A p ϖ (rootVarPos A p F)) := by
  refine IsIntegral.of_aeval_monic (p := F.1) F.2.1 F.2.2.ne' ?_
  rw [aeval_rootVar_image_eq_zero]
  exact isIntegral_zero

/-- **The class of `X_{(F,0)}` is integral over `A`.** -/
theorem isIntegral_toQuotMv_X_zero (F : MonicPolysPos A) :
    IsIntegral A (toQuotMv A p ϖ (MvPolynomial.X (F, 0))) := by
  have hx : toQuotMv A p ϖ (MvPolynomial.X (F, 0)) = toQuotRoot A p ϖ (rootVarPos A p F) := rfl
  rw [hx]
  exact isIntegral_toQuotRoot_rootVar A p ϖ F

/-- **The relation `(X_{(F,n)})^{p^n} = X_{(F,0)}` in `Λ`**, iterated from `rootClosure.X_pow`. -/
theorem rootClosure_X_pow_pow (F : MonicPolysPos A) (n : ℕ) :
    (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
        (MvPolynomial.X (F, n))) ^ (p ^ n)
      = Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
        (MvPolynomial.X (F, 0)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hpow : (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
        (MvPolynomial.X (F, n + 1))) ^ p
        = Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
          (MvPolynomial.X (F, n)) :=
      rootClosure.X_pow A p (MonicPolysPos A) F n
    calc (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
          (MvPolynomial.X (F, n + 1))) ^ (p ^ (n + 1))
        = ((Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
          (MvPolynomial.X (F, n + 1))) ^ p) ^ (p ^ n) := by
          rw [pow_succ', pow_mul]
      _ = (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
          (MvPolynomial.X (F, n))) ^ (p ^ n) := by rw [hpow]
      _ = _ := ih

/-- **All the classes `X_{(F,n)}` are integral over `A`** (for `0 < p`). -/
theorem isIntegral_toQuotMv_X (hp : 0 < p) (F : MonicPolysPos A) (n : ℕ) :
    IsIntegral A (toQuotMv A p ϖ (MvPolynomial.X (F, n))) := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    exact isIntegral_toQuotMv_X_zero A p ϖ F
  · refine IsIntegral.of_pow (n := p ^ n) (Nat.pow_pos hp (n := n)) ?_
    have hrel := rootClosure_X_pow_pow A p F n
    have hX : toQuotMv A p ϖ (MvPolynomial.X (F, n)) =
        toQuotRoot A p ϖ (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A))
          (MvPolynomial.X (F, n))) := rfl
    rw [hX]
    have hmap := congrArg (toQuotRoot A p ϖ) hrel
    simp only [map_pow] at hmap
    rw [hmap]
    exact isIntegral_toQuotRoot_rootVar A p ϖ F

/-- **The image of `Λ` in `A' ⧸ J` consists of integral elements.** -/
theorem isIntegral_toQuotRoot (hp : 0 < p) (l : RootAlgPos A p) :
    IsIntegral A (toQuotRoot A p ϖ l) := by
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective (I := rootClosureIdeal A p (MonicPolysPos A)) l
  have hfac : toQuotRoot A p ϖ
      (Ideal.Quotient.mk (rootClosureIdeal A p (MonicPolysPos A)) q) = toQuotMv A p ϖ q := rfl
  rw [hfac]
  refine MvPolynomial.induction_on q (motive := fun q => IsIntegral A (toQuotMv A p ϖ q)) ?_ ?_ ?_
  · intro a
    rw [show toQuotMv A p ϖ (MvPolynomial.C a) =
      algebraMap A (↥(CSIntegralClosurePos A p ϖ) ⧸ CSIdealPosExt A p ϖ) a from
      (by simpa only [MvPolynomial.algebraMap_eq] using AlgHom.commutes (toQuotMv A p ϖ) a)]
    exact isIntegral_algebraMap
  · intro q₁ q₂ h₁ h₂
    rw [map_add]
    exact h₁.add h₂
  · intro q i h
    rw [map_mul]
    exact h.mul (isIntegral_toQuotMv_X A p ϖ hp i.1 i.2)

/-- **The image of `A_∞` in `A' ⧸ J` consists of integral elements.** -/
theorem isIntegral_toQuotCSAlg (hp : 0 < p) (x : ↥(CSAlgPos A p ϖ)) :
    IsIntegral A (toQuotCSAlg A p ϖ x) := by
  have key : ∀ (y : RootAlgLocPos A p ϖ) (hy : y ∈ CSAlgPos A p ϖ),
      IsIntegral A (toQuotCSAlg A p ϖ ⟨y, hy⟩) := by
    let S : Subring (RootAlgLocPos A p ϖ) :=
      { carrier := {y | ∃ hy : y ∈ CSAlgPos A p ϖ, IsIntegral A (toQuotCSAlg A p ϖ ⟨y, hy⟩)}
        mul_mem' := by
          rintro x y ⟨hx, hix⟩ ⟨hy, hiy⟩
          refine ⟨mul_mem hx hy, ?_⟩
          have he : (⟨x * y, mul_mem hx hy⟩ : ↥(CSAlgPos A p ϖ)) =
              ⟨x, hx⟩ * ⟨y, hy⟩ := Subtype.ext rfl
          rw [he, map_mul]
          exact hix.mul hiy
        one_mem' := ⟨one_mem _, by
          have he : (⟨(1 : RootAlgLocPos A p ϖ), one_mem _⟩ : ↥(CSAlgPos A p ϖ)) = 1 :=
            Subtype.ext rfl
          rw [he, map_one]
          exact isIntegral_one⟩
        add_mem' := by
          rintro x y ⟨hx, hix⟩ ⟨hy, hiy⟩
          refine ⟨add_mem hx hy, ?_⟩
          have he : (⟨x + y, add_mem hx hy⟩ : ↥(CSAlgPos A p ϖ)) = ⟨x, hx⟩ + ⟨y, hy⟩ :=
            Subtype.ext rfl
          rw [he, map_add]
          exact hix.add hiy
        zero_mem' := ⟨zero_mem _, by
          have he : (⟨(0 : RootAlgLocPos A p ϖ), zero_mem _⟩ : ↥(CSAlgPos A p ϖ)) = 0 :=
            Subtype.ext rfl
          rw [he, map_zero]
          exact isIntegral_zero⟩
        neg_mem' := by
          rintro x ⟨hx, hix⟩
          refine ⟨neg_mem hx, ?_⟩
          have he : (⟨-x, neg_mem hx⟩ : ↥(CSAlgPos A p ϖ)) = -⟨x, hx⟩ := Subtype.ext rfl
          rw [he, map_neg]
          exact hix.neg }
    have hgen : (Set.range (algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)) ∪
        Set.range (fun q : MonicPolysPos A × ℕ =>
          algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)
              (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
            IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) ϖ) ^ q.2)) ⊆
        (S : Set _) := by
      rintro y (⟨l, rfl⟩ | ⟨q, rfl⟩)
      · refine ⟨Subring.subset_closure (Set.mem_union_left _ ⟨l, rfl⟩), ?_⟩
        have he : (⟨algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ) l,
            Subring.subset_closure (Set.mem_union_left _ ⟨l, rfl⟩)⟩ :
              ↥(CSAlgPos A p ϖ)) = RootAlgPos.toCSAlgPos A p ϖ l := Subtype.ext rfl
        rw [he]
        exact isIntegral_toQuotRoot A p ϖ hp l
      · refine ⟨Subring.subset_closure (Set.mem_union_right _ ⟨q, rfl⟩), ?_⟩
        have hmem : (⟨algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)
              (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
              IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) ϖ) ^ q.2,
            Subring.subset_closure (Set.mem_union_right _ ⟨q, rfl⟩)⟩ :
              ↥(CSAlgPos A p ϖ)) ∈ CSIdealPos A p ϖ := Ideal.subset_span ⟨q, rfl⟩
        have hz : toQuotCSAlg A p ϖ (⟨algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)
              (Polynomial.aeval (rootVarPos A p q.1) q.1.1) *
              IsLocalization.Away.invSelf (algebraMap A (RootAlgPos A p) ϖ) ^ q.2,
            Subring.subset_closure (Set.mem_union_right _ ⟨q, rfl⟩)⟩ : ↥(CSAlgPos A p ϖ)) = 0 := by
          rw [toQuotCSAlg_apply, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_map_of_mem _ hmem
        rw [hz]
        exact isIntegral_zero
    intro y hy
    exact (Subring.closure_le.mpr hgen hy).2
  exact key x.1 x.2

/-- **The subring `C' ⊆ L` of elements of `A'` whose image in `A' ⧸ J` is integral over `A`.** -/
noncomputable def Cprime : Subring (RootAlgLocPos A p ϖ) :=
  { carrier := {x | ∃ hx : x ∈ CSIntegralClosurePos A p ϖ,
        IsIntegral A (Ideal.Quotient.mk (CSIdealPosExt A p ϖ)
          (⟨x, hx⟩ : ↥(CSIntegralClosurePos A p ϖ)))}
    mul_mem' := by
      rintro x y ⟨hx, hix⟩ ⟨hy, hiy⟩
      refine ⟨mul_mem hx hy, ?_⟩
      have he : (⟨x * y, mul_mem hx hy⟩ : ↥(CSIntegralClosurePos A p ϖ)) =
          ⟨x, hx⟩ * ⟨y, hy⟩ := Subtype.ext rfl
      rw [he, map_mul]
      exact hix.mul hiy
    one_mem' := ⟨one_mem _, by
      have he : (⟨(1 : RootAlgLocPos A p ϖ), one_mem _⟩ : ↥(CSIntegralClosurePos A p ϖ)) = 1 :=
        Subtype.ext rfl
      rw [he, map_one]
      exact isIntegral_one⟩
    add_mem' := by
      rintro x y ⟨hx, hix⟩ ⟨hy, hiy⟩
      refine ⟨add_mem hx hy, ?_⟩
      have he : (⟨x + y, add_mem hx hy⟩ : ↥(CSIntegralClosurePos A p ϖ)) =
          ⟨x, hx⟩ + ⟨y, hy⟩ := Subtype.ext rfl
      rw [he, map_add]
      exact hix.add hiy
    zero_mem' := ⟨zero_mem _, by
      have he : (⟨(0 : RootAlgLocPos A p ϖ), zero_mem _⟩ : ↥(CSIntegralClosurePos A p ϖ)) = 0 :=
        Subtype.ext rfl
      rw [he, map_zero]
      exact isIntegral_zero⟩
    neg_mem' := by
      rintro x ⟨hx, hix⟩
      refine ⟨neg_mem hx, ?_⟩
      have he : (⟨-x, neg_mem hx⟩ : ↥(CSIntegralClosurePos A p ϖ)) = -⟨x, hx⟩ := Subtype.ext rfl
      rw [he, map_neg]
      exact hix.neg }

/-- **`A_∞ ≤ C'`.** -/
theorem CSAlgPos_le_Cprime (hp : 0 < p) : CSAlgPos A p ϖ ≤ Cprime A p ϖ := by
  intro x hx
  refine ⟨CSAlgPos_le_CSIntegralClosurePos A p ϖ hx, ?_⟩
  have he : (⟨x, CSAlgPos_le_CSIntegralClosurePos A p ϖ hx⟩ : ↥(CSIntegralClosurePos A p ϖ)) =
      CSAlgPos.toCSIntegralClosure A p ϖ ⟨x, hx⟩ := Subtype.ext rfl
  rw [he]
  exact isIntegral_toQuotCSAlg A p ϖ hp ⟨x, hx⟩

/-- **`C'` is `p`-integrally closed in `L`.** -/
theorem isPIntegrallyClosedIn_Cprime (hp : 0 < p) :
    IsPIntegrallyClosedIn p (Cprime A p ϖ) := by
  intro z hz
  obtain ⟨hzp, hizp⟩ := hz
  have hzA' : z ∈ CSIntegralClosurePos A p ϖ :=
    CSIntegralClosurePos_isPIntegrallyClosed A p ϖ z hzp
  refine ⟨hzA', ?_⟩
  have he : (⟨z ^ p, hzp⟩ : ↥(CSIntegralClosurePos A p ϖ)) =
      (⟨z, hzA'⟩ : ↥(CSIntegralClosurePos A p ϖ)) ^ p := Subtype.ext rfl
  rw [he, map_pow] at hizp
  exact IsIntegral.of_pow hp hizp

/-- **`A' ⧸ J` is integral over `A`.** -/
theorem isIntegral_quot_CSIntegralClosurePos (hp : 0 < p) :
    Algebra.IsIntegral A (↥(CSIntegralClosurePos A p ϖ) ⧸ CSIdealPosExt A p ϖ) := by
  rw [Algebra.isIntegral_def]
  intro t
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective (I := CSIdealPosExt A p ϖ) t
  have hle : CSIntegralClosurePos A p ϖ ≤ Cprime A p ϖ :=
    pIntClosure_le (CSAlgPos_le_Cprime A p ϖ hp) (isPIntegrallyClosedIn_Cprime A p ϖ hp)
  obtain ⟨hy, hiy⟩ := hle y.2
  have he : (⟨y.1, hy⟩ : ↥(CSIntegralClosurePos A p ϖ)) = y := Subtype.ext rfl
  rwa [he] at hiy

end

end Work.DSM2p
