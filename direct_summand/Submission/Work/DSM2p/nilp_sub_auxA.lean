import Mathlib
import Submission.Work.DSM2p.nilp_sub_defs

/-!
# `Work.DSM2p.nilp_sub_auxA`

`nilp_sub_auxA` (statement untouched).  `B` a commutative ring, `ϖ ∈ B` a nonzerodivisor,
`A ⊆ B` a subring containing `ϖ` such that every element of `B` becomes an element of `A` after
multiplication by a power of `ϖ` (`hgen`), and `a ∈ B` such that `ϖ` is a unit of the subring
`A[a⁻¹] ⊆ B[a⁻¹]`.  Then some power of `a` is `ϖ` times an element of `A`.

Proof outline (mirroring the *proved* `Work.DSM2p.nilp_caseBp`, with the localization hypothesis
`B = A[ϖ⁻¹]` weakened to `hgen`):

* view `B` as an algebra over the subring `A`, so that `Localization.Away a` is an `A`-algebra via
  `A → B → Localization.Away a` and `awaySubring A a` is the subalgebra generated by `a⁻¹`;
* from the unit relation and `a = b₀ / ϖ^{n₀}` (here `hgen`, there `IsLocalization.Away.surj`)
  one obtains two polynomial identities, transported to `B` along `B → B[a⁻¹]` whose kernel is the
  `a`-torsion (`away_ker_torsion`): `a` is integral over `A`, and `a^K = ϖ · y` for some `y` in the
  `A`-subalgebra `A[a] ⊆ B`;
* integrality makes `A[a]` the span of the finitely many powers `a^j`, `j < deg G`, each of which
  has bounded denominator, so multiplication by a fixed power `ϖ^S` maps `A[a]` into the image of
  `A`;
* raising `a^K = ϖ·y` to the power `S+1` and using that bound gives `a^(K(S+1)) = ϖ·x`, `x ∈ A`.
-/

namespace Work.DSM2p

open scoped Classical

/-- The kernel of `B → B[a⁻¹]` is the `a`-torsion. -/
lemma away_ker_torsion {B : Type*} [CommRing B] (a e : B)
    (he : algebraMap B (Localization.Away a) e = 0) : ∃ n : ℕ, a ^ n * e = 0 := by
  have h1 : algebraMap B (Localization.Away a) e = algebraMap B (Localization.Away a) 0 := by
    simpa using he
  obtain ⟨cc, hcc⟩ :=
    (IsLocalization.eq_iff_exists (Submonoid.powers a) (Localization.Away a)).mp h1
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff (cc : B) a).mp cc.2
  exact ⟨n, by rw [hn]; simpa using hcc⟩

/-- Reversed-polynomial identity adapted to `Polynomial.aeval`
(compare `Polynomial.eval₂_reverse_mul_pow`). -/
lemma aeval_reverse_mul_pow_auxA {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]
    {x y : S} (hxy : x * y = 1) (hyx : y * x = 1) (f : Polynomial A) :
    Polynomial.aeval y f.reverse * x ^ f.natDegree = Polynomial.aeval x f := by
  let i : Invertible x := ⟨y, hyx, hxy⟩
  have h := Polynomial.eval₂_reverse_mul_pow (algebraMap A S) x f
  have hinv : @Invertible.invOf S _ _ x i = y := rfl
  rw [hinv] at h
  simpa only [Polynomial.aeval_def] using h

theorem nilp_sub_auxA {B : Type*} [CommRing B] (ϖ : B) (hϖ : IsSMulRegular B ϖ)
    (A : Subring B) (hϖA : ϖ ∈ A)
    (hgen : ∀ z : B, ∃ n : ℕ, ∃ c : A, z * ϖ ^ n = (c : B)) (a : B)
    (h : IsUnit (⟨algebraMap B (Localization.Away a) ϖ, varpi_mem_awaySubring A a hϖA⟩ : awaySubring A a)) :
    ∃ N : ℕ, ∃ x : A, (x : B) * ϖ = a ^ N := by
  classical
  letI : Algebra A B := (Subring.subtype A).toAlgebra
  set c : Localization.Away a := IsLocalization.Away.invSelf (S := Localization.Away a) a with hc
  set w : A := ⟨ϖ, hϖA⟩ with hw
  have hwB : (w : B) = ϖ := rfl
  have halg : ∀ x : A, algebraMap A B x = (x : B) := fun _ => rfl
  have hgen' : ∀ z : B, ∃ n : ℕ, ∃ d : A, z * (algebraMap A B w) ^ n = algebraMap A B d := by
    intro z
    obtain ⟨n, d, hd⟩ := hgen z
    exact ⟨n, d, hd⟩
  -- `awaySubring A a` is the `A`-subalgebra generated by `a⁻¹`
  have hrange : (Set.range (algebraMap A (Localization.Away a)))
      = Set.range (fun x : A => algebraMap B (Localization.Away a) (x : B)) := by
    apply congrArg Set.range
    funext x
    rw [IsScalarTower.algebraMap_apply A B (Localization.Away a) x]
    rfl
  have hset : ∀ z : Localization.Away a,
      z ∈ awaySubring A a ↔ z ∈ Algebra.adjoin A ({c} : Set (Localization.Away a)) := by
    intro z
    rw [Algebra.mem_adjoin_iff, hc, hrange]
    rfl
  -- the hypothesis, transported to the `Algebra.adjoin` form
  have h' : IsUnit (algebraMap A (Algebra.adjoin A ({c} : Set (Localization.Away a))) w) := by
    obtain ⟨v, hv⟩ := h
    have hvv : ((v : awaySubring A a) : Localization.Away a)
        = algebraMap B (Localization.Away a) ϖ := congrArg
      (fun z : awaySubring A a => (z : Localization.Away a)) hv
    have hv' : ((v : awaySubring A a) : Localization.Away a)
        = algebraMap A (Localization.Away a) w := by
      have h1 : algebraMap A (Localization.Away a) w
          = algebraMap B (Localization.Away a) ϖ := by
        rw [IsScalarTower.algebraMap_apply A B (Localization.Away a) w]
        rfl
      exact hvv.trans h1.symm
    refine isUnit_iff_exists.mpr ⟨⟨((↑(v⁻¹) : awaySubring A a) : Localization.Away a),
      (hset _).mp ((↑(v⁻¹) : awaySubring A a)).2⟩, ?_, ?_⟩
    · ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_one, Subalgebra.coe_algebraMap, ← hv']
      exact congrArg (fun z : awaySubring A a => (z : Localization.Away a)) (Units.mul_inv v)
    · ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_one, Subalgebra.coe_algebraMap, ← hv']
      exact congrArg (fun z : awaySubring A a => (z : Localization.Away a)) (Units.inv_mul v)
  -- ### First relation: `a` satisfies a monic polynomial equation over `A`
  have hmonic : ∃ (G : Polynomial A), G.Monic ∧ Polynomial.aeval a G = 0 := by
    set C : Subalgebra A (Localization.Away a) :=
      Algebra.adjoin A ({c} : Set (Localization.Away a)) with hC
    obtain ⟨v, hv⟩ := h'
    set u : C := ↑v⁻¹ with hu
    have hCsi : (algebraMap A C w) * u = 1 := by
      rw [hu, ← hv, Units.mul_inv]
    have hCsiD : (algebraMap A (Localization.Away a) w) * (u : Localization.Away a) = 1 := by
      have h3 : ((algebraMap A C w) * u : C) = 1 := hCsi
      have h4 := congrArg (fun z : C => (z : Localization.Away a)) h3
      rw [Subalgebra.coe_mul, Subalgebra.coe_one, Subalgebra.coe_algebraMap C w] at h4
      exact h4
    have hker : ∀ e : B, algebraMap B (Localization.Away a) e = 0 → ∃ n : ℕ, a ^ n * e = 0 :=
      fun e he => away_ker_torsion a e he
    obtain ⟨n₀, b₀, hb₀⟩ := hgen' a
    have hb₀' : algebraMap B (Localization.Away a) a
        * (algebraMap A (Localization.Away a) w) ^ n₀ = algebraMap A (Localization.Away a) b₀ := by
      have h := congrArg (algebraMap B (Localization.Away a)) hb₀
      simpa [map_mul, map_pow, IsScalarTower.algebraMap_apply A B (Localization.Away a)] using h
    have hmain : algebraMap B (Localization.Away a) a
        = algebraMap A (Localization.Away a) b₀ * (u : Localization.Away a) ^ n₀ := by
      have h4 := congrArg (· * (u : Localization.Away a) ^ n₀) hb₀'
      rw [mul_assoc, ← mul_pow, hCsiD, one_pow, mul_one] at h4
      exact h4
    have hāC : algebraMap B (Localization.Away a) a ∈ C := by
      rw [hmain]
      exact C.mul_mem (Subalgebra.algebraMap_mem C b₀) (C.pow_mem u.2 n₀)
    have hāR : algebraMap B (Localization.Away a) a ∈ (Polynomial.aeval (R := A) c).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval A c]
      exact hāC
    obtain ⟨p, hp⟩ := (Polynomial.aeval (R := A) c).mem_range.mp hāR
    have hcā : c * algebraMap B (Localization.Away a) a = 1 := by
      rw [hc, mul_comm]; exact IsLocalization.Away.mul_invSelf a
    have hāc : algebraMap B (Localization.Away a) a * c = 1 := by
      rw [hc]; exact IsLocalization.Away.mul_invSelf a
    have hD1 : Polynomial.aeval (algebraMap B (Localization.Away a) a)
        (Polynomial.X ^ (p.natDegree + 1) - p.reverse) = 0 := by
      have hrev := aeval_reverse_mul_pow_auxA (x := c) (y := algebraMap B (Localization.Away a) a)
        hcā hāc p
      rw [hp] at hrev
      have hcān : c ^ p.natDegree * (algebraMap B (Localization.Away a) a) ^ p.natDegree = 1 := by
        rw [← mul_pow, hcā, one_pow]
      have h4 : Polynomial.aeval (algebraMap B (Localization.Away a) a) p.reverse *
          (c ^ p.natDegree * (algebraMap B (Localization.Away a) a) ^ p.natDegree)
          = (algebraMap B (Localization.Away a) a) ^ (p.natDegree + 1) := by
        rw [← mul_assoc, hrev, pow_succ']
      have h5 : Polynomial.aeval (algebraMap B (Localization.Away a) a) p.reverse
          = (algebraMap B (Localization.Away a) a) ^ (p.natDegree + 1) := by
        rw [hcān, mul_one] at h4
        exact h4
      rw [map_sub, map_pow, Polynomial.aeval_X, h5, sub_self]
    have hB1 : algebraMap B (Localization.Away a)
        (Polynomial.aeval a (Polynomial.X ^ (p.natDegree + 1) - p.reverse)) = 0 := by
      rw [← Polynomial.aeval_algebraMap_apply (R := A) (Localization.Away a) a
        (Polynomial.X ^ (p.natDegree + 1) - p.reverse), hD1]
    obtain ⟨s, hs⟩ := hker _ hB1
    refine ⟨Polynomial.X ^ (s + p.natDegree + 1) - Polynomial.X ^ s * p.reverse, ?_, ?_⟩
    · have hd : p.reverse.degree ≤ ↑p.natDegree :=
        le_trans (Polynomial.degree_le_natDegree (p := p.reverse))
          (by exact_mod_cast Polynomial.reverse_natDegree_le p)
      apply Polynomial.monic_X_pow_sub
      calc (Polynomial.X ^ s * p.reverse).degree
          ≤ (Polynomial.X ^ s).degree + p.reverse.degree := Polynomial.degree_mul_le _ _
        _ ≤ ↑s + ↑p.natDegree := add_le_add (Polynomial.degree_X_pow_le s) hd
        _ = ↑(s + p.natDegree) := (WithBot.coe_add s p.natDegree).symm
        _ < ↑(s + p.natDegree + 1) := by exact_mod_cast Nat.lt_succ_self (s + p.natDegree)
    · have h2 : Polynomial.aeval a
          (Polynomial.X ^ s * (Polynomial.X ^ (p.natDegree + 1) - p.reverse)) = 0 := by
        rw [map_mul, map_pow, Polynomial.aeval_X, hs]
      rwa [mul_sub, ← pow_add] at h2
  -- ### Second relation: `a^K = ϖ * y` with `y ∈ A[a]`
  have hpow : ∃ (K : ℕ) (y : B), y ∈ Algebra.adjoin A ({a} : Set B)
      ∧ a ^ K = algebraMap A B w * y := by
    set C : Subalgebra A (Localization.Away a) :=
      Algebra.adjoin A ({c} : Set (Localization.Away a)) with hC
    obtain ⟨v, hv⟩ := h'
    set u : C := ↑v⁻¹ with hu
    have hCsi : (algebraMap A C w) * u = 1 := by
      rw [hu, ← hv, Units.mul_inv]
    have hCsiD : (algebraMap A (Localization.Away a) w) * (u : Localization.Away a) = 1 := by
      have h3 : ((algebraMap A C w) * u : C) = 1 := hCsi
      have h4 := congrArg (fun z : C => (z : Localization.Away a)) h3
      rw [Subalgebra.coe_mul, Subalgebra.coe_one, Subalgebra.coe_algebraMap C w] at h4
      exact h4
    have hker : ∀ e : B, algebraMap B (Localization.Away a) e = 0 → ∃ n : ℕ, a ^ n * e = 0 :=
      fun e he => away_ker_torsion a e he
    have huC : (u : Localization.Away a) ∈ (Polynomial.aeval (R := A) c).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval A c]
      exact u.2
    obtain ⟨q, hq⟩ := (Polynomial.aeval (R := A) c).mem_range.mp huC
    have hcā : c * algebraMap B (Localization.Away a) a = 1 := by
      rw [hc, mul_comm]; exact IsLocalization.Away.mul_invSelf a
    have hāc : algebraMap B (Localization.Away a) a * c = 1 := by
      rw [hc]; exact IsLocalization.Away.mul_invSelf a
    have hD2 : (algebraMap B (Localization.Away a) a) ^ q.natDegree
        = (algebraMap A (Localization.Away a) w) *
          Polynomial.aeval (algebraMap B (Localization.Away a) a) q.reverse := by
      have h1 := aeval_reverse_mul_pow_auxA (x := c) (y := algebraMap B (Localization.Away a) a)
        hcā hāc q
      rw [hq] at h1
      have h2 : c ^ q.natDegree * (algebraMap B (Localization.Away a) a) ^ q.natDegree = 1 := by
        rw [← mul_pow, hcā, one_pow]
      have h3 : (algebraMap A (Localization.Away a) w) *
          Polynomial.aeval (algebraMap B (Localization.Away a) a) q.reverse *
          (c ^ q.natDegree * (algebraMap B (Localization.Away a) a) ^ q.natDegree)
          = (algebraMap B (Localization.Away a) a) ^ q.natDegree := by
        rw [mul_assoc (algebraMap A (Localization.Away a) w),
          ← mul_assoc (Polynomial.aeval (algebraMap B (Localization.Away a) a) q.reverse),
          h1, ← mul_assoc (algebraMap A (Localization.Away a) w), hCsiD, one_mul]
      rw [h2, mul_one] at h3
      exact h3.symm
    have hB2 : algebraMap B (Localization.Away a)
        (a ^ q.natDegree - algebraMap A B w * Polynomial.aeval a q.reverse) = 0 := by
      rw [map_sub, map_mul, map_pow,
        ← Polynomial.aeval_algebraMap_apply (R := A) (Localization.Away a) a q.reverse,
        ← IsScalarTower.algebraMap_apply A B (Localization.Away a) w, hD2, sub_self]
    obtain ⟨s', hs'⟩ := hker _ hB2
    refine ⟨s' + q.natDegree, Polynomial.aeval a (Polynomial.X ^ s' * q.reverse), ?_, ?_⟩
    · rw [Algebra.adjoin_singleton_eq_range_aeval A a]
      exact (Polynomial.aeval a).mem_range.mpr ⟨Polynomial.X ^ s' * q.reverse, rfl⟩
    · have hs2 : a ^ s' * a ^ q.natDegree
          = a ^ s' * (algebraMap A B w * Polynomial.aeval a q.reverse) := by
        have h := hs'
        rw [mul_sub, sub_eq_zero] at h
        exact h
      rw [pow_add, hs2, map_mul, map_pow, Polynomial.aeval_X]
      ring
  -- ### Assembly
  obtain ⟨G, hGmonic, hGaeval⟩ := hmonic
  obtain ⟨K, y, hy, hyK⟩ := hpow
  obtain ⟨k, b₀, hb₀⟩ := hgen' a
  have hb₀' : (algebraMap A B w) ^ k * a = algebraMap A B b₀ := by
    rw [mul_comm]; exact hb₀
  set S : ℕ := k * G.natDegree with hS
  have hbound : ∀ z ∈ Algebra.adjoin A ({a} : Set B), ∃ x : A,
      (algebraMap A B w) ^ S * z = algebraMap A B x := by
    intro z hz
    have hspan := Submodule.span_range_natDegree_eq_adjoin hGmonic hGaeval
    have hz' : z ∈ Submodule.span A
        (↑(Finset.image (fun j => a ^ j) (Finset.range G.natDegree)) : Set B) := by
      rw [hspan]; exact hz
    refine Submodule.span_induction
      (p := fun z _ => ∃ x : A, (algebraMap A B w) ^ S * z = algebraMap A B x) ?_ ?_ ?_ ?_ hz'
    · rintro zc hc
      obtain ⟨j, hj, hjeq⟩ := by simpa using hc
      rw [← hjeq]
      refine ⟨w ^ (k * (G.natDegree - j)) * b₀ ^ j, ?_⟩
      have h1 : ((algebraMap A B w) ^ k) ^ j * a ^ j = algebraMap A B (b₀ ^ j) := by
        rw [← mul_pow, hb₀', map_pow]
      have hk : k * (G.natDegree - j) + k * j = k * G.natDegree := by
        rw [← Nat.mul_add, Nat.sub_add_cancel (le_of_lt hj)]
      calc (algebraMap A B w) ^ S * a ^ j
          = (algebraMap A B w) ^ (k * G.natDegree) * a ^ j := by rw [hS]
        _ = (algebraMap A B w) ^ (k * (G.natDegree - j) + k * j) * a ^ j := by rw [hk]
        _ = ((algebraMap A B w) ^ (k * (G.natDegree - j)) *
              ((algebraMap A B w) ^ k) ^ j) * a ^ j := by rw [← pow_mul, ← pow_add]
        _ = (algebraMap A B w) ^ (k * (G.natDegree - j)) *
              (((algebraMap A B w) ^ k) ^ j * a ^ j) := by rw [mul_assoc]
        _ = (algebraMap A B w) ^ (k * (G.natDegree - j)) * algebraMap A B (b₀ ^ j) := by rw [h1]
        _ = algebraMap A B (w ^ (k * (G.natDegree - j)) * b₀ ^ j) := by
              rw [map_mul, map_pow, map_pow]
    · exact ⟨0, by simp⟩
    · rintro x y _ _ ⟨x₁, hx₁⟩ ⟨y₁, hy₁⟩
      exact ⟨x₁ + y₁, by rw [mul_add, hx₁, hy₁, map_add]⟩
    · rintro cc x _ ⟨x₁, hx₁⟩
      refine ⟨cc * x₁, ?_⟩
      rw [Algebra.smul_def, map_mul, ← hx₁]
      ring
  obtain ⟨Sx, hSx⟩ := hbound (y ^ (S + 1)) ((Algebra.adjoin A ({a} : Set B)).pow_mem hy (S + 1))
  refine ⟨K * (S + 1), Sx, ?_⟩
  have hchain : a ^ (K * (S + 1)) = (algebraMap A B w) ^ S * (algebraMap A B w) * y ^ (S + 1) := by
    calc a ^ (K * (S + 1)) = (a ^ K) ^ (S + 1) := by rw [pow_mul]
      _ = (algebraMap A B w * y) ^ (S + 1) := by rw [hyK]
      _ = (algebraMap A B w) ^ (S + 1) * y ^ (S + 1) := by rw [mul_pow]
      _ = (algebraMap A B w) ^ S * (algebraMap A B w) * y ^ (S + 1) := by rw [pow_succ]
  have hrearr : (algebraMap A B w) ^ S * (algebraMap A B w) * y ^ (S + 1)
      = (algebraMap A B w) * ((algebraMap A B w) ^ S * y ^ (S + 1)) := by ring
  rw [hchain, hrearr, hSx, halg w, halg Sx, hwB]
  ring

end Work.DSM2p
