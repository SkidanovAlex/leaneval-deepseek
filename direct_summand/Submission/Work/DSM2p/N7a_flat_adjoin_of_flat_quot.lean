import Mathlib

namespace Work.DSM2p

/-- If the `C`-algebra generated by `x : L` is the quotient `C[t]/(f)` of the polynomial
ring by the kernel of `aeval x`, and that quotient is flat as an `A`-module, then the
subalgebra `C[x] ⊆ L` is flat as an `A`-module.

Indeed the first isomorphism theorem identifies `C[t]/(f)` with `C[x]` as `C`-algebras
(hence as `A`-algebras, since `A → C` and `A → C → L`), and flatness is invariant under
linear equivalence. -/
theorem N7a_flat_adjoin_of_flat_quot {A C L : Type*} [CommRing A] [CommRing C] [CommRing L]
    [Algebra A C] [Algebra C L] [Algebra A L] [IsScalarTower A C L]
    (x : L) (f : Polynomial C)
    (hker : RingHom.ker (Polynomial.aeval (R := C) x).toRingHom = Ideal.span {f})
    (hflat : Module.Flat A (Polynomial C ⧸ Ideal.span {f})) :
    Module.Flat A ↥(Algebra.adjoin C {x}) := by
  -- `aeval x` takes values in `C[x]` (its range is exactly the adjoin generated by `x`).
  have hmem : ∀ p : Polynomial C, (Polynomial.aeval (R := C) x) p ∈ Algebra.adjoin C {x} := by
    intro p
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact AlgHom.mem_range_self _ p
  let F : Polynomial C →ₐ[C] ↥(Algebra.adjoin C {x}) :=
    (Polynomial.aeval (R := C) x).codRestrict (Algebra.adjoin C {x}) hmem
  -- It is surjective onto `C[x]`, because `C[x]` is the range of `aeval x`.
  have hsurj : Function.Surjective F := by
    intro y
    obtain ⟨p, hp⟩ : ∃ p, (Polynomial.aeval (R := C) x) p = (y : L) := by
      apply (Polynomial.aeval (R := C) x).mem_range.mp
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact y.2
    exact ⟨p, Subtype.ext hp⟩
  -- Its kernel is the same as that of `aeval x`, hence `(f)`.
  have hkerF : RingHom.ker F.toRingHom = Ideal.span {f} := by
    rw [← hker]
    ext p
    rw [RingHom.mem_ker, RingHom.mem_ker]
    constructor
    · intro hp
      have := congrArg (Subtype.val) hp
      simpa [F] using this
    · intro hp
      exact Subtype.ext (by simpa [F] using hp)
  -- The first isomorphism theorem gives a `C`-algebra isomorphism `C[t]/(f) ≅ C[x]`.
  let e : (Polynomial C ⧸ Ideal.span {f}) ≃ₐ[C] ↥(Algebra.adjoin C {x}) :=
    (Ideal.quotientEquivAlgOfEq C hkerF.symm).trans (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  -- Any `C`-linear map between modules with a scalar tower `A → C` is `A`-linear.
  have eA : (Polynomial C ⧸ Ideal.span {f}) ≃ₗ[A] ↥(Algebra.adjoin C {x}) :=
    LinearEquiv.restrictScalars A e.toLinearEquiv
  exact (Module.Flat.equiv_iff eA).mp hflat

end Work.DSM2p
