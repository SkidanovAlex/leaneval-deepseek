import Mathlib

/-!
# `Work.DSM2p.N5b_mem_of_map_mem`

Let `R` be a commutative ring, `p : ℕ`, `π : R`, `u : Rˣ` with `π ^ e = p · u` and `e ≥ 1`.
Then the ideals `(p)` and `(π ^ e)` of `R` coincide, hence `(p) ^ k = (p ^ k)` is generated by
`π ^ (e * k)`, a multiple of `π ^ k`: that is, `(p) ^ k ≤ (π ^ k)`.

The lemma says that the canonical map `R → R̂` into the `(p)`-adic completion `R̂` reflects
membership in the principal ideal `(π ^ k)` along this comparison: if the image of `c` in `R̂`
lies in the ideal generated by the image of `π ^ k`, then already `c ∈ (π ^ k)`.

## Proof

Write `I := (p)`, `J := (π ^ k)`. Since `I ^ k ≤ J`, it suffices to show `c ∈ J + I ^ n` for
*every* `n`. For a fixed `n`, consider the ring homomorphism
`ψ : R̂ → R ⧸ (J + I ^ n)` obtained by projecting the completion to its `n`-th component
(`AdicCompletion.evalₐ I n`) and then passing to the quotient `R ⧸ I ^ n → R ⧸ (J + I ^ n)`.

* `ψ (of x) = (x mod J + I ^ n)`, because the composite `R → R ⧸ I ^ n → R ⧸ (J + I ^ n)` is the
  quotient map;
* `ψ` kills the image of `π ^ k`, since `π ^ k ∈ J`.

The hypothesis `hc` expresses the image of `c` in `R̂` as an `R̂`-multiple of the image of
`π ^ k`; applying the ring homomorphism `ψ` turns this into `(c mod J + I ^ n) = 0`, i.e.
`c ∈ J + I ^ n`.

Finally, taking `n = k` and using `I ^ k ≤ J` gives `c ∈ J + I ^ k = J`.

Note that `p` being a nonzerodivisor on `R` (that is, `IsSMulRegular R π`) is *not* needed: the
argument only uses that the `I`-adic filtration is coarser than the `J`-adic one in the sense
`I ^ k ≤ J`. The hypothesis is inherited from the source statement and is kept for compatibility.
-/

namespace Work.DSM2p

-- `hπ` is part of the fixed statement but is not needed for the proof (see the module docstring).
set_option linter.unusedVariables false in
theorem N5b_mem_of_map_mem {R : Type*} [CommRing R] (p : ℕ) (π : R) (e : ℕ) (u : Rˣ)
    (hπe : π ^ e = (p : R) * u) (he : 1 ≤ e) (hπ : IsSMulRegular R π) (k : ℕ) (c : R)
    (hc : algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) c ∈
      Ideal.span {algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R) (π ^ k)}) :
    c ∈ Ideal.span {π ^ k} := by
  set I : Ideal R := Ideal.span {(p : R)} with hI
  set J : Ideal R := Ideal.span {π ^ k} with hJ
  -- `p` and `π ^ e` differ by the unit `u⁻¹`.
  have hp_eq : (p : R) = π ^ e * ((u⁻¹ : Rˣ) : R) := by
    rw [hπe, mul_assoc, Units.mul_inv, mul_one]
  -- `I ^ k = (p ^ k) = (π ^ (e * k))` is contained in `J = (π ^ k)`.
  have hIk_le_J : I ^ k ≤ J := by
    rw [hI, Ideal.span_singleton_pow, hJ, Ideal.span_singleton_le_iff_mem,
      Ideal.mem_span_singleton]
    have hek : e * k = k + k * (e - 1) := by
      have h1 : e = (e - 1) + 1 := (Nat.succ_pred_eq_of_pos (by omega : 0 < e)).symm
      conv_lhs => rw [h1]
      rw [add_mul, one_mul, mul_comm (e - 1) k, add_comm]
    refine ⟨π ^ (k * (e - 1)) * ((u⁻¹ : Rˣ) : R) ^ k, ?_⟩
    calc (p : R) ^ k = (π ^ e * ((u⁻¹ : Rˣ) : R)) ^ k := by rw [hp_eq]
      _ = π ^ k * (π ^ (k * (e - 1)) * ((u⁻¹ : Rˣ) : R) ^ k) := by
            rw [mul_pow, ← pow_mul, hek, pow_add, mul_assoc]
  -- The key step: `c` lies in `J + I ^ n` for every `n`.
  have key : ∀ n : ℕ, c ∈ J ⊔ I ^ n := by
    intro n
    have hle : I ^ n ≤ J ⊔ I ^ n := le_sup_right
    have hof_c : algebraMap R (AdicCompletion I R) c = AdicCompletion.of I R c := by
      rw [AdicCompletion.algebraMap_apply]; rfl
    have hof_pi : algebraMap R (AdicCompletion I R) (π ^ k) = AdicCompletion.of I R (π ^ k) := by
      rw [AdicCompletion.algebraMap_apply]; rfl
    -- `hc` says that the image of `π ^ k` divides the image of `c` in `R̂`.
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hc
    -- The composite `R̂ → R ⧸ (J + I ^ n)` sends `of x` to the class of `x`.
    have h1 : (Ideal.Quotient.factor hle)
          (AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) c))
        = Ideal.Quotient.mk (J ⊔ I ^ n) c := by
      rw [hof_c, AdicCompletion.evalₐ_of, Ideal.Quotient.factor_mk]
    -- …and it kills the image of `π ^ k`.
    have h3 : (Ideal.Quotient.factor hle)
          (AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) (π ^ k))) = 0 := by
      rw [hof_pi, AdicCompletion.evalₐ_of, Ideal.Quotient.factor_mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_left (by rw [hJ]; exact Ideal.mem_span_singleton_self (π ^ k))
    have hzero : Ideal.Quotient.mk (J ⊔ I ^ n) c = 0 := by
      rw [← h1, hy, map_mul, map_mul, h3, zero_mul]
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hzero
  -- Specialise to `n = k`, where `J + I ^ k = J`.
  have hfin := key k
  rwa [sup_eq_left.mpr hIk_le_J] at hfin

end Work.DSM2p
