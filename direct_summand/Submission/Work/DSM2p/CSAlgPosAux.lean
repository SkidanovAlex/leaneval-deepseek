import Submission.Work.DSM2p.CSCompletionPos_faithfullyFlat
import Submission.Work.DSG4b.MvMonicAux

/-!
# Auxiliary definitions for `CSAlgPos_mod_varpi_flat`

This file collects the vocabulary of the target lemma `Work.DSM2p.CSAlgPos_mod_varpi_flat`
(the flatness of `A_∞ ⧸ ϖA_∞` over `A ⧸ (ϖ)`), so that the pieces of the proof can be stated
in terms of it.

## Main definitions

* `CSIdealZero A p` — the ideal `I₀ = (F(T_F) | F ∈ 𝒫⁺) ⊆ Λ` of `Λ = A[T_F^{1/p^n}]`: the image
  of the "root" ideal `I_∞ ⊆ A_∞` under the projection `A_∞ → A_∞/I_∞ ≅ Λ/I₀` (Česnavičius–
  Scholze, *Purity for flat cohomology*, arXiv:1912.10932, proof of `Andre-lem`).
* `RootAlgPos.toCSAlgPos` — the `A`-algebra map `Λ → A_∞` (the inclusion `Λ ⊆ A_∞`).
* `toCSAlgPosQuot` — the composite `Λ → A_∞ → A_∞ ⧸ I_∞`.
* `CSQuotT A p` — the flat `A`-algebra `A[T_F | F ∈ 𝒫⁺] ⧸ (F(T_F) | F ∈ 𝒫⁺)`;
* `CSQuotT2 A p` — its extension by `p`-th roots of the `T_F`, namely
  `CSQuotT A p [Z_F | F ∈ 𝒫⁺] ⧸ (Z_F ^ p - T_F | F ∈ 𝒫⁺)`.

The mathematical point (Česnavičius–Scholze, proof of `Andre-lem`) is that
`Λ ⧸ I₀ ≅ CSQuotT2 A p [X_{F,n}]/(X_{F,n+1} ^ p = X_{F,n})`, and that each of
`CSQuotT A p`, `CSQuotT2 A p` is flat over `A`.
-/

open scoped Classical

namespace Work.DSM2p

universe u

/-- **The ideal `I₀ ⊆ Λ`.**  `Λ = A[T_F^{1/p^n} | F ∈ 𝒫⁺]` and `I₀ = (F(T_F) | F ∈ 𝒫⁺)`:  the
ideal generated by evaluating every positive-degree monic polynomial `F ∈ A[T]` at the
corresponding root variable `T_F`.  This is the kernel of `Λ → A_∞ ⧸ I_∞`
(`Work.DSM2p.ker_toCSAlgPosQuot`). -/
noncomputable def CSIdealZero (A : Type u) [CommRing A] (p : ℕ) : Ideal (RootAlgPos A p) :=
  Ideal.span (Set.range fun F : MonicPolysPos A => Polynomial.aeval (rootVarPos A p F) F.1)

theorem aeval_rootVarPos_mem_CSIdealZero (A : Type u) [CommRing A] (p : ℕ)
    (F : MonicPolysPos A) :
    Polynomial.aeval (rootVarPos A p F) F.1 ∈ CSIdealZero A p :=
  Ideal.subset_span ⟨F, rfl⟩

/-- **The `A`-algebra map `Λ → A_∞`**, i.e. the inclusion `Λ ⊆ A_∞ ⊆ Λ[1/ϖ]`. -/
noncomputable def RootAlgPos.toCSAlgPos (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    RootAlgPos A p →+* ↥(CSAlgPos A p ϖ) :=
  RingHom.codRestrict (algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ)) (CSAlgPos A p ϖ)
    (fun l => Subring.subset_closure (Set.mem_union_left _ ⟨l, rfl⟩))

@[simp]
theorem RootAlgPos.toCSAlgPos_apply (A : Type u) [CommRing A] (p : ℕ) (ϖ : A)
    (l : RootAlgPos A p) :
    ((RootAlgPos.toCSAlgPos A p ϖ l : ↥(CSAlgPos A p ϖ)) : RootAlgLocPos A p ϖ)
      = algebraMap (RootAlgPos A p) (RootAlgLocPos A p ϖ) l := rfl

/-- The `A`-algebra structure on `A_∞` (recorded in `CSCompletionPos_faithfullyFlat`) makes
`RootAlgPos.toCSAlgPos` an `A`-algebra map.  Stated in the unfolded form in which it holds by
`rfl`. -/
theorem RootAlgPos.toCSAlgPos_algebraMap (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (a : A) :
    RootAlgPos.toCSAlgPos A p ϖ (algebraMap A (RootAlgPos A p) a)
      = ⟨AAlgHomLocPos A p ϖ a, AAlgHomLocPos_mem_CSAlgPos A p ϖ a⟩ := rfl

/-- The same, as an equality with the `A`-algebra structure map of `A_∞`. -/
theorem RootAlgPos.toCSAlgPos_algebraMap' (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) (a : A) :
    RootAlgPos.toCSAlgPos A p ϖ (algebraMap A (RootAlgPos A p) a)
      = algebraMap A ↥(CSAlgPos A p ϖ) a :=
  RootAlgPos.toCSAlgPos_algebraMap A p ϖ a

/-- The composite `Λ → A_∞ ⧸ I_∞`.  Its kernel is `I₀` (`Work.DSM2p.ker_toCSAlgPosQuot`) and it
is surjective (`Work.DSM2p.toCSAlgPosQuot_surjective`); this is the isomorphism
`Λ ⧸ I₀ ≅ A_∞ ⧸ I_∞` of Česnavičius–Scholze. -/
noncomputable def toCSAlgPosQuot (A : Type u) [CommRing A] (p : ℕ) (ϖ : A) :
    RootAlgPos A p →+* (↥(CSAlgPos A p ϖ) ⧸ CSIdealPos A p ϖ) :=
  (Ideal.Quotient.mk (CSIdealPos A p ϖ)).comp (RootAlgPos.toCSAlgPos A p ϖ)

/-- **The `A`-algebra `A[T_F | F ∈ 𝒫⁺] ⧸ (F(T_F) | F ∈ 𝒫⁺)`**, the "root-less" quotient of the
polynomial algebra.  It is flat over `A` by `Work.DSG4b.flat_mvPolynomial_quotient_monic_prime`.
-/
noncomputable abbrev CSQuotT (A : Type u) [CommRing A] (p : ℕ) : Type u :=
  MvPolynomial (MonicPolysPos A) A ⧸ DSG4b.MvMonicAux.qI (fun F : MonicPolysPos A => F.1)

/-- **The `A`-algebra `CSQuotT A p [Z_F | F ∈ 𝒫⁺] ⧸ (Z_F ^ p - T_F | F ∈ 𝒫⁺)`**: adjoining a
`p`-th root of each `T_F`.  It is flat over `A` as an iterated monic quotient. -/
noncomputable abbrev CSQuotT2 (A : Type u) [CommRing A] (p : ℕ) : Type u :=
  MvPolynomial (MonicPolysPos A) (CSQuotT A p) ⧸
    DSG4b.MvMonicAux.qI (fun F : MonicPolysPos A =>
      Polynomial.X ^ p - Polynomial.C (Ideal.Quotient.mk _ (MvPolynomial.X F)))

end Work.DSM2p
