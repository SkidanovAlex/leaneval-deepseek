import Mathlib

/-!
# `Work.DSM2p.N4c_frob_sum_monomial_sub_mem`

Node **N4c** of the H2 design: the "Frobenius defect modulo `p`" for a finite sum of
monomials in `C[X]`.

If `p` is a prime then for any finite family of monomials `i ↦ monomial i (a i)`,

`(∑ i ∈ s, monomial i (a i)) ^ p - ∑ i ∈ s, (monomial i (a i)) ^ p ∈ (C (p : C))`.

The reason is the freshman's-dream congruence: in the binomial expansion of `(∑ᵢ fᵢ)^p`
every *mixed* multinomial coefficient `p! / ∏ kᵢ!` is divisible by `p`, so modulo `p`
the `p`-th power of a sum is the sum of the `p`-th powers.  We prove the stronger
ring-theoretic statement — valid in *any* commutative ring — that

`(∑ i ∈ s, f i) ^ p - ∑ i ∈ s, (f i) ^ p ∈ (p : R)`,

and then specialise to `R = C[X]` and `f i = monomial i (a i)`, using
`(p : C[X]) = C (p : C)`.

The two-variable input is Mathlib's `exists_add_pow_prime_eq`
(`(x + y) ^ p = x ^ p + y ^ p + p * x * y * r`), whose existence reflects precisely the
divisibility of the intermediate binomial coefficients by `p`.
-/

namespace Work.DSM2p

/-- **Frobenius defect of a finite sum.**  For a prime `p`, in any commutative ring the
difference between the `p`-th power of a finite sum and the sum of the `p`-th powers is a
multiple of `p`, i.e. lies in the ideal generated by `(p : R)`. -/
theorem frob_sum_sub_mem {R : Type*} [CommRing R] (p : ℕ) (hp : p.Prime)
    {ι : Type*} (f : ι → R) (s : Finset ι) :
    (∑ i ∈ s, f i) ^ p - ∑ i ∈ s, (f i) ^ p ∈ Ideal.span {(p : R)} := by
  classical
  induction s using Finset.induction with
  | empty => simp [zero_pow hp.ne_zero]
  | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi]
      -- Peel off the new term and use the two-variable Frobenius defect `exists_add_pow_prime_eq`.
      obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp (∑ j ∈ s, f j) (f i)
      have key : (f i + ∑ j ∈ s, f j) ^ p - (f i ^ p + ∑ j ∈ s, (f j) ^ p)
          = ((∑ j ∈ s, f j) ^ p - ∑ j ∈ s, (f j) ^ p)
            + (p : R) * ((∑ j ∈ s, f j) * f i * r) := by
        rw [add_comm (f i), hr]; ring
      rw [key]
      exact Ideal.add_mem _ ih
        (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton (p : R))))

/-- The Frobenius defect of a finite sum of monomials in `C[X]` lies in `(C (p : C))`. -/
theorem N4c_frob_sum_monomial_sub_mem {C : Type*} [CommRing C] (p : ℕ) (hp : p.Prime)
    (s : Finset ℕ) (a : ℕ → C) :
    (∑ i ∈ s, Polynomial.monomial i (a i)) ^ p
      - ∑ i ∈ s, (Polynomial.monomial i (a i)) ^ p
      ∈ Ideal.span {Polynomial.C (p : C)} := by
  have h :=
    frob_sum_sub_mem (R := Polynomial C) p hp (fun i => Polynomial.monomial i (a i)) s
  have hC : Polynomial.C (p : C) = (p : Polynomial C) := map_natCast Polynomial.C p
  simpa only [hC] using h

end Work.DSM2p
