import Mathlib
import Submission.Work.DSM1p.Basic

/-!
# `mod_p`: reduction modulo `p` commutes with `p`-adic completion

For any commutative ring `E` and natural number `p`, the level-`1` coordinate projection of the
`p`-adic completion `E^ = AdicCompletion (span {p}) E`,

`evalOneₐ : E^ →+* E ⧸ span {p}`,

is surjective (`AdicCompletion.evalOneₐ_surjective`) with kernel the principal ideal generated by
`p` (`AdicCompletion.ker_evalOneₐ_eq_map`, the ideal `span {p}` being finitely generated).  The
first isomorphism theorem therefore identifies `E^ ⧸ (p)` with `E ⧸ (p)`:

`E^ ⧸ Ideal.span {p} ≃+* E ⧸ Ideal.span {p}`.

This is *independent of any torsion hypothesis* on `p`: the completion does not lose information
about `E ⧸ (p)`, because that quotient is the first layer of the adic filtration defining `E^`.

Applied to `E = R[a^{1/p^∞}]` (`Work.DSM1p.RootClosure R p a`) this is exactly the lemma `mod_p`
used in the mixed-characteristic construction of Bhatt (arXiv:1608.08882, §4).
-/

namespace Work.DSM1p.Completion

universe u

namespace AdicCompletionModP

/-- **Reduction modulo `p` of a `p`-adic completion.**  The level-`1` coordinate projection
`AdicCompletion (span {p}) E → E ⧸ span {p}` is surjective with kernel the principal ideal `(p)`;
the first isomorphism theorem identifies `E^ ⧸ (p)` with `E ⧸ (p)`. -/
theorem adicCompletion_quot_span (E : Type u) [CommRing E] (p : ℕ) :
    Nonempty (AdicCompletion (Ideal.span {(p : E)}) E ⧸
        Ideal.span {(p : AdicCompletion (Ideal.span {(p : E)}) E)} ≃+*
      E ⧸ Ideal.span {(p : E)}) := by
  set I : Ideal E := Ideal.span {(p : E)} with hI
  -- The ideal `span {p} ⊆ AdicCompletion I E` is the extension of `I`.
  have hFG : I.FG := ⟨{(p : E)}, by simp [I]⟩
  have hmap : Ideal.map (algebraMap E (AdicCompletion I E)) I =
      Ideal.span {(p : AdicCompletion I E)} := by
    rw [hI, Ideal.map_span]
    simp only [Set.image_singleton]
    rw [map_natCast]
  -- Kernel of the level-`1` projection.
  have hker : RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom =
      Ideal.span {(p : AdicCompletion I E)} := by
    rw [AdicCompletion.ker_evalOneₐ_eq_map I hFG, hmap]
  refine ⟨(Ideal.quotEquivOfEq hker.symm).trans ?_⟩
  exact RingHom.quotientKerEquivOfSurjective
    (f := (AdicCompletion.evalOneₐ I).toRingHom) (AdicCompletion.evalOneₐ_surjective I)

end AdicCompletionModP

open AdicCompletionModP

theorem mod_p (R : Type*) [CommRing R] (p : ℕ) (a : R)
    (hp : IsSMulRegular (Work.DSM1p.RootClosure R p a)
      (p : Work.DSM1p.RootClosure R p a)) :
    Nonempty (Work.DSM1p.RootClosureCompletion R p a ⧸
        Ideal.span {(p : Work.DSM1p.RootClosureCompletion R p a)} ≃+*
      Work.DSM1p.RootClosure R p a ⧸
        Ideal.span {(p : Work.DSM1p.RootClosure R p a)}) :=
  adicCompletion_quot_span (Work.DSM1p.RootClosure R p a) p

end Work.DSM1p.Completion
