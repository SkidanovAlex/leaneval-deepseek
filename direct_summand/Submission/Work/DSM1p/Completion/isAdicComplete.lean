import Mathlib
import Submission.Work.DSM1p.Basic

namespace Work.DSM1p.Completion

/-- `RootClosureCompletion R p a` is by definition the `p`-adic completion of the root closure
`R[a^{1/p^∞}]`, hence it is complete for the ideal generated by `p`. -/
theorem isAdicComplete (R : Type*) [CommRing R] (p : ℕ) (a : R) :
    IsAdicComplete (Ideal.span {(p : Work.DSM1p.RootClosureCompletion R p a)})
      (Work.DSM1p.RootClosureCompletion R p a) := by
  -- An adic completion is complete for the ideal it was completed along.
  have h := AdicCompletion.isAdicComplete_self (R := Work.DSM1p.RootClosure R p a)
    (I := Ideal.span {(p : Work.DSM1p.RootClosure R p a)}) (Submodule.fg_span_singleton _)
  -- The completion of `Ideal.span {p}` along itself is `Ideal.span {algebraMap p}`, and
  -- `algebraMap p = p` inside the completion.
  convert h using 2
  rw [Ideal.map_span, Set.image_singleton]
  exact congrArg (fun x : Work.DSM1p.RootClosureCompletion R p a => Ideal.span {x})
    (map_natCast (algebraMap (Work.DSM1p.RootClosure R p a)
      (Work.DSM1p.RootClosureCompletion R p a)) p).symm

end Work.DSM1p.Completion
