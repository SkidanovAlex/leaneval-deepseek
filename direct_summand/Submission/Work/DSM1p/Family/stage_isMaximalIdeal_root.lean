import Mathlib
import Submission.Work.DSM1p.Family
import Submission.Work.DSM1p.Family.flat_closure
import Submission.Work.DSM1p.Family.stage_finite_root
import Submission.Work.DSM1p.Family.stage_sub_algebraMap_mem_rootIdeal

/-!
# The maximal ideal of a stage of the multi-parameter root tower

Let `R` be a local ring and `x : Fin d → R` a system of generators of `IsLocalRing.maximalIdeal R`
(`Ideal.span (Set.range x) = 𝔪`).  For the `n`-th stage of the root tower

`A_n = FamTower R p x n = R[Z₁,…,Z_d] ⧸ (Z_i ^ (p^n) - x_i)`

this file proves **`stage_isMaximalIdeal_root`**: the maximal ideals of `A_n` are exactly the ideal
generated by the adjoined roots `Z_i = FamTower.root R p x n i`:

`I.IsMaximal ↔ I = Ideal.span (Set.range (FamTower.root R p x n))`.

In particular `A_n` is a *local* ring whose maximal ideal is the image of `(Z₁,…,Z_d)`.

## Proof

Write `ZI := Ideal.span (Set.range (FamTower.root R p x n))`.

* `map_maximalIdeal_le_rootIdeal`: `𝔪 A_n ⊆ ZI`, because `Z_i ^ (p^n) = x_i` and the `x_i`
  generate `𝔪` (the exponent `p ^ n` is nonzero by primality of `p`).
* `rootIdeal_isMaximal`: `ZI` is maximal.  The ring homomorphism
  `φ : A_n → R ⧸ 𝔪`, sending `Z_i ↦ 0` and `r ↦ r mod 𝔪`, kills `ZI`; since `R ⧸ 𝔪` is a field it
  shows `1 ∉ ZI`.  For the rest, `Ideal.isMaximal_iff` only asks that `ZI ≤ J` and `y ∈ J \ ZI`
  force `1 ∈ J`: by `stage_sub_algebraMap_mem_rootIdeal` (a delegated lemma in this directory)
  every `y` is congruent modulo `ZI` to a constant `algebraMap R _ r`; if that constant lay in
  `𝔪` then `y ∈ ZI` by `𝔪 A_n ⊆ ZI`, so `r` is a unit of `R`, hence `algebraMap R A_n r` is a unit
  of `A_n`, and then `algebraMap R A_n r = y - (y - algebraMap R A_n r) ∈ J`.
* for the converse, every maximal ideal `I` of `A_n` contains `ZI`: by `stage_finite_root` (also
  delegated here) `A_n` is a finite, hence integral, `R`-algebra, so `I` contracts to the maximal
  ideal `𝔪` of the local ring `R`; hence `algebraMap R A_n (x i) = (Z_i) ^ (p^n) ∈ I`, and since `I`
  is prime `Z_i ∈ I`.  As `ZI` is maximal, `I = ZI`.
-/

namespace Work.DSM1p.Family

set_option linter.style.haveILetI false

/-- **The structure map `R → A_n` carries `𝔪` into the ideal generated by the roots**, since each
root satisfies `Z_i ^ (p ^ n) = x_i` and the `x_i` generate `𝔪`. -/
theorem map_maximalIdeal_le_rootIdeal (R : Type*) [CommRing R] [IsLocalRing R] (p : ℕ)
    [Fact p.Prime] {d : ℕ} (x : Fin d → R)
    (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R) (n : ℕ) :
    Ideal.map (algebraMap R (Work.DSM1p.FamTower R p x n)) (IsLocalRing.maximalIdeal R) ≤
      Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) := by
  have hp : p ^ n ≠ 0 := pow_ne_zero n (Fact.out : p.Prime).ne_zero
  rw [← hx, Ideal.map_span, ← Set.range_comp]
  refine Ideal.span_le.mpr fun y hy => ?_
  obtain ⟨i, rfl⟩ := hy
  simp only [Function.comp_apply]
  rw [← Work.DSM1p.FamTower.root_pow R p x n i]
  exact Ideal.pow_le_self hp
    (Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) (p ^ n))

/-- **The ideal generated by the roots is maximal.** -/
theorem rootIdeal_isMaximal (R : Type*) [CommRing R] [IsLocalRing R] (p : ℕ) [Fact p.Prime]
    {d : ℕ} (x : Fin d → R) (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R) (n : ℕ) :
    (Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n))).IsMaximal := by
  classical
  have hp : p ^ n ≠ 0 := pow_ne_zero n (Fact.out : p.Prime).ne_zero
  have hmA := map_maximalIdeal_le_rootIdeal R p x hx n
  -- the reduction `R[Z] → R ⧸ 𝔪` sending every variable to `0`
  let φ₀ : MvPolynomial (Fin d) R →+* R ⧸ IsLocalRing.maximalIdeal R :=
    MvPolynomial.eval₂Hom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) fun _ => 0
  have hφ₀X : ∀ i, φ₀ (MvPolynomial.X i) = 0 := fun i => MvPolynomial.eval₂Hom_X' _ _ i
  have hφ₀C : ∀ a : R, φ₀ (MvPolynomial.C a) = Ideal.Quotient.mk _ a :=
    fun a => MvPolynomial.eval₂Hom_C _ _ a
  have hker : (Ideal.span (Set.range fun i : Fin d =>
      MvPolynomial.X i ^ (p ^ n) - MvPolynomial.C (x i))) ≤ RingHom.ker φ₀ := by
    rw [Ideal.span_le]
    rintro y ⟨i, rfl⟩
    have hxi : x i ∈ IsLocalRing.maximalIdeal R := hx ▸ Ideal.subset_span (Set.mem_range_self i)
    have hzero : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) (x i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hxi
    refine RingHom.mem_ker.mpr ?_
    show φ₀ (MvPolynomial.X i ^ (p ^ n) - MvPolynomial.C (x i)) = 0
    rw [map_sub, map_pow, hφ₀X i, hφ₀C (x i), hzero, zero_pow hp]
    simp
  let φ : Work.DSM1p.FamTower R p x n →+* R ⧸ IsLocalRing.maximalIdeal R :=
    Ideal.Quotient.lift _ φ₀ fun a ha => RingHom.mem_ker.mp (hker ha)
  have hφroot : ∀ i, φ (Work.DSM1p.FamTower.root R p x n i) = 0 := by
    intro i
    show φ (Ideal.Quotient.mk _ (MvPolynomial.X i)) = 0
    rw [Ideal.Quotient.lift_mk]
    exact hφ₀X i
  have hrootIdeal_ker :
      Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) ≤ RingHom.ker φ := by
    rw [Ideal.span_le]
    rintro y ⟨i, rfl⟩
    exact RingHom.mem_ker.mpr (hφroot i)
  haveI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
  have hone_ne : (1 : R ⧸ IsLocalRing.maximalIdeal R) ≠ 0 := one_ne_zero
  have hone_not_mem :
      (1 : Work.DSM1p.FamTower R p x n) ∉
        Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) := by
    intro h1
    have h2 : φ 1 = 0 := RingHom.mem_ker.mp (hrootIdeal_ker h1)
    rw [map_one] at h2
    exact hone_ne h2
  refine Ideal.isMaximal_iff.mpr ⟨hone_not_mem, ?_⟩
  intro J y hle hyI hyJ
  obtain ⟨r, hr⟩ := stage_sub_algebraMap_mem_rootIdeal R p x n y
  have hr_not_mem : r ∉ IsLocalRing.maximalIdeal R := by
    intro hrm
    refine hyI ?_
    have h1 : algebraMap R (Work.DSM1p.FamTower R p x n) r ∈
        Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) :=
      hmA (Ideal.mem_map_of_mem _ hrm)
    have h2 : y = algebraMap R (Work.DSM1p.FamTower R p x n) r +
        (y - algebraMap R (Work.DSM1p.FamTower R p x n) r) := by ring
    rw [h2]
    exact Ideal.add_mem _ h1 hr
  have halg : algebraMap R (Work.DSM1p.FamTower R p x n) r ∈ J := by
    have h2 : algebraMap R (Work.DSM1p.FamTower R p x n) r =
        y - (y - algebraMap R (Work.DSM1p.FamTower R p x n) r) := by ring
    rw [h2]
    exact J.sub_mem hyJ (hle hr)
  obtain ⟨v, hv⟩ := (IsLocalRing.notMem_maximalIdeal.mp hr_not_mem).map
    (algebraMap R (Work.DSM1p.FamTower R p x n))
  have h1 : (1 : Work.DSM1p.FamTower R p x n) =
      ↑v⁻¹ * algebraMap R (Work.DSM1p.FamTower R p x n) r := by
    rw [← hv]; simp
  rw [h1]
  exact J.mul_mem_left _ halg

/-- **The maximal ideals of the stage are exactly the ideal generated by the roots.** -/
theorem stage_isMaximalIdeal_root (R : Type*) [CommRing R] [IsLocalRing R] (p : ℕ) [Fact p.Prime]
    {d : ℕ} (x : Fin d → R) (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R)
    (n : ℕ) :
    ∀ I : Ideal (Work.DSM1p.FamTower R p x n),
      I.IsMaximal ↔ I = Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) := by
  intro I
  constructor
  · intro hI
    haveI : I.IsMaximal := hI
    have hfin : Module.Finite R (Work.DSM1p.FamTower R p x n) :=
      stage_finite_root R p x (Fact.out : p.Prime).ne_zero n
    haveI : Algebra.IsIntegral R (Work.DSM1p.FamTower R p x n) :=
      Algebra.IsIntegral.of_finite R _
    have hunder : I.under R = IsLocalRing.maximalIdeal R :=
      IsLocalRing.eq_maximalIdeal
        (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := R) I)
    have hrootmem : ∀ i, Work.DSM1p.FamTower.root R p x n i ∈ I := by
      intro i
      have h1 : x i ∈ I.under R := by
        rw [hunder]
        exact hx ▸ Ideal.subset_span (Set.mem_range_self i)
      have h2 : algebraMap R (Work.DSM1p.FamTower R p x n) (x i) ∈ I := h1
      rw [← Work.DSM1p.FamTower.root_pow R p x n i] at h2
      exact (Ideal.IsMaximal.isPrime hI).mem_of_pow_mem (p ^ n) h2
    exact ((rootIdeal_isMaximal R p x hx n).eq_of_le hI.ne_top
      (Ideal.span_le.mpr fun y hy => by obtain ⟨i, rfl⟩ := hy; exact hrootmem i)).symm
  · rintro rfl
    exact rootIdeal_isMaximal R p x hx n

end Work.DSM1p.Family
