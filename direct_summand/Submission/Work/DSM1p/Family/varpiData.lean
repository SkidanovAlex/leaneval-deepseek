/-!
# The pseudo-uniformizer `ϖ` of Bhatt's ring `A′` (`area_M1'`, node M1′)

For a complete regular local ring `R` of mixed characteristic with a system of parameters
`x : Fin d → R` generating `𝔪 = IsLocalRing.maximalIdeal R`, let

`A′ = FamCompletion R p x = (R[x₁^{1/p^∞}, …, x_d^{1/p^∞}])^{^}`

be the `p`-adic completion of the multi-parameter root closure (`Submission/Work/DSM1p/Family.lean`).
Assuming the shared node `SERHyp p` (the Cohen-free series lemma `area_SER`) and the Frobenius
surjectivity `hfrob` of `A′` modulo `p` (which is `Family.frobSurj`, itself derived from `SERHyp`),
the present theorem produces the **pseudo-uniformizer tower** of `A′`: a compatible system

`ϖ (k + 1) ^ p = ϖ k`,    `ϖ 0 ^ p = p * v` with `v` a unit,

i.e. the `ϖ`-component of `DSMap.PerfectoidData p A′` (see also the assembly
`Submission/Work/DSM1p/Assembly/Perfectoid.lean`, which consumes this theorem verbatim).

## Proof

* `perfect_residue_of_hfrob`: the hypothesis `hfrob` (Frobenius surjectivity modulo `p` of `A′`)
  forces the residue field `k = R ⧸ 𝔪` of `R` to be `p`-closed: `k = k ^ p`.  Indeed the reduction
  map `redHom : A ⧸ (p) → k` of `Family.maximalIdeal_smul_ne_top` (composed with the isomorphism
  `A′ ⧸ (p) ≃ A ⧸ (p)` for the root closure `A`, `Completion.AdicCompletionModP`) is a surjection
  of rings, so Frobenius surjectivity descends along it.  This is the "perfect residue field"
  hypothesis `hperf` required by the SER input.
* `hSER` applied to `S = R` (with `z = x` and `a = p`, legitimate because `p ∈ 𝔪`) then produces
  `g ∈ R[Z] ⧸ (Zᵢ ^ p - xᵢ)` with `g ^ p = p * (1 + h)` for some `h` in the ideal generated by the
  roots `Zᵢ`.  By `isUnit_one_add_of_mem_rootIdeal`, `1 + h` is a *unit* in the stage: the roots
  map into the Jacobson radical (they satisfy `Zᵢ ^ p = xᵢ ∈ 𝔪 B`, and `𝔪 B` lies in the radical
  because `R → B` is finite hence integral).  Pushing `g` forward to `A′` gives an element `g′`
  with `g′ ^ p = p * u`, `u` a unit.
* `exists_preTilt_coeff_zero` produces a tilt element `xt ∈ PreTilt A′ p` with
  `coeff 0 xt = g′ mod p`; then `ϖ k := untilt ((frobeniusEquiv _ p).symm ^[k] xt)` is a compatible
  system of `p`-th roots (Mathlib's `PreTilt.untilt_iterate_frobeniusEquiv_symm_pow`) with
  `ϖ 0 ≡ g′` modulo `p`, say `ϖ 0 = g′ + p c`.  Finally
  `(g′ + p c) ^ p = g′ ^ p + p ^ 2 S` (`pow_add_p_mul_sub_mem_sq`) `= p (1 + h′ + p S)`, and
  `1 + h′ + p S = (1 + h′) (1 + p S (1 + h′)⁻¹)` is a unit because `1 + h′` is, and because
  `(p) ⊆ jacobson ⊥` in a `p`-adically complete ring (`IsAdicComplete.le_jacobson_bot`).
-/

namespace Work.DSM1p.Family

open Work.DSM1p

universe u

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 1000000

/-! ## The `p`-th roots of a system of parameters, in the completion -/

variable (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (x : Fin d → R)

/-- The image in the completion `A′` of the `(n+1)`-st root of `x i`: the element
`FamClosure.rootTower R p x n i` of the root closure, pushed forward to `A′`. -/
noncomputable abbrev Aroot (n : ℕ) (i : Fin d) : Work.DSM1p.FamCompletion R p x :=
  Work.DSM1p.FamCompletion.of R p x (Work.DSM1p.FamClosure.rootTower R p x n i)

/-- **The defining relation of the root tower in `A′`**: the `(n+1)`-st root of `x i` has
`p ^ (n+1)`-st power equal to the image of `x i`. -/
theorem Aroot_pow (n : ℕ) (i : Fin d) :
    (Aroot R p x n i) ^ p ^ (n + 1) =
      algebraMap R (Work.DSM1p.FamCompletion R p x) (x i) := by
  have h1 : (Work.DSM1p.FamClosure.rootTower R p x n i) ^ p ^ (n + 1) =
      algebraMap R (Work.DSM1p.FamClosure R p x) (x i) := by
    rw [show Work.DSM1p.FamClosure.rootTower R p x n i =
        Work.DSM1p.FamClosure.of R p x (n + 1)
          (Work.DSM1p.FamTower.root R p x (n + 1) i) from rfl,
      ← map_pow, Work.DSM1p.FamTower.root_pow]
    exact of_algebraMap R p x (n + 1) (x i)
  show (Work.DSM1p.FamCompletion.of R p x
      (Work.DSM1p.FamClosure.rootTower R p x n i)) ^ p ^ (n + 1) = _
  rw [← map_pow, h1]
  rfl

/-- The `p`-th power of the first root is the image of `x i`. -/
theorem Aroot_zero_pow (i : Fin d) :
    (Aroot R p x 0 i) ^ p = algebraMap R (Work.DSM1p.FamCompletion R p x) (x i) := by
  have h := Aroot_pow R p x 0 i
  simpa using h

/-! ## The binomial congruence modulo `p ^ 2` -/

/-- If `b ^ 2 = 0` then only the first two terms of the binomial expansion survive. -/
theorem add_pow_eq_of_sq_eq_zero {A : Type*} [CommRing A] (a b : A) (hb : b ^ 2 = 0) (n : ℕ) :
    (a + b) ^ n = a ^ n + (n : A) * a ^ (n - 1) * b := by
  match n with
  | 0 => simp
  | 1 => simp
  | (m + 2) =>
    rw [add_pow]
    have key : ∀ i ∈ Finset.range (m + 2 + 1), i ∉ ({m + 1, m + 2} : Finset ℕ) →
        a ^ i * b ^ (m + 2 - i) * ((m + 2).choose i : A) = 0 := by
      intro i hi hi1
      simp only [Finset.mem_range] at hi
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hi1
      have hle : i ≤ m := by omega
      have hb' : b ^ (m + 2 - i) = 0 := by
        obtain ⟨j, hj⟩ : ∃ j, m + 2 - i = 2 + j := ⟨m - i, by omega⟩
        rw [hj, pow_add, hb, zero_mul]
      rw [hb', mul_zero, zero_mul]
    rw [← Finset.sum_subset
      (s₁ := ({m + 1, m + 2} : Finset ℕ)) (s₂ := Finset.range (m + 2 + 1))
      (f := fun i => a ^ i * b ^ (m + 2 - i) * ((m + 2).choose i : A))
      (fun i hi => by
        simp only [Finset.mem_insert, Finset.mem_singleton] at hi
        simp only [Finset.mem_range]
        rcases hi with rfl | rfl <;> omega) key]
    rw [Finset.sum_pair (by omega : m + 1 ≠ m + 2)]
    have hch : (m + 2).choose (m + 1) = m + 2 := by
      have h := Nat.choose_symm (show 1 ≤ m + 2 by omega)
      rw [show m + 2 - 1 = m + 1 from by omega] at h
      rw [h, Nat.choose_one_right]
    have h1 : m + 2 - (m + 1) = 1 := by omega
    have h2 : m + 2 - (m + 2) = 0 := by omega
    have h3 : m + 2 - 1 = m + 1 := by omega
    rw [h1, h2, h3, hch, Nat.choose_self, pow_one, pow_zero, mul_one, Nat.cast_one]
    push_cast
    ring

/-- **Binomial congruence**: `(x + p y) ^ p ≡ x ^ p` modulo `p ^ 2`. -/
theorem pow_add_p_mul_sub_mem_sq (R : Type u) [CommRing R] (p : ℕ) [Fact p.Prime] (x y : R) :
    (x + (p : R) * y) ^ p - x ^ p ∈ Ideal.span {((p : R) ^ 2)} := by
  let Q := R ⧸ Ideal.span {((p : R) ^ 2)}
  let q : R →+* Q := Ideal.Quotient.mk _
  have hp2 : (p : Q) ^ 2 = 0 := by
    rw [show (p : Q) = q (p : R) from (map_natCast q p).symm, ← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hb : ((p : Q) * q y) ^ 2 = 0 := by rw [mul_pow, hp2, zero_mul]
  have haux := add_pow_eq_of_sq_eq_zero (q x) ((p : Q) * q y) hb p
  have hz : (p : Q) * (q x) ^ (p - 1) * ((p : Q) * q y) = 0 := by
    calc (p : Q) * (q x) ^ (p - 1) * ((p : Q) * q y)
        = ((p : Q) * (p : Q)) * ((q x) ^ (p - 1) * q y) := by ring
      _ = 0 := by rw [← sq, hp2, zero_mul]
  have hx' : q (x + (p : R) * y) = q x + (p : Q) * q y := by
    rw [map_add, map_mul, map_natCast]
  have hfinal : q ((x + (p : R) * y) ^ p) = q (x ^ p) := by
    rw [map_pow, hx', haux, hz, add_zero, ← map_pow]
  exact Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, hfinal, sub_self])

/-! ## The first stage `R[Z] ⧸ (Zᵢ ^ p - xᵢ)` -/

/-- The first stage of the root tower, in the presentation `R[Z] ⧸ (Zᵢ ^ p - xᵢ)` of the SER
input (the same ring as `FamTower R p x 1`, but with the exponent written as `p`, matching the
conclusion of `SERHyp`). -/
noncomputable abbrev SerStage (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (x : Fin d → R) : Type u :=
  MvPolynomial (Fin d) R ⧸ Work.DSM1p.Family.stageIdeal p x

/-- The first stage of the root tower is a finite `R`-module (it is free on the reduced
monomials, `Family.mvPolyQuotFree`). -/
theorem finite_stage (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (x : Fin d → R) (hp : p ≠ 0) :
    Module.Finite R (SerStage R p x) := by
  haveI : Module.Free R (SerStage R p x) := Work.DSM1p.Family.mvPolyQuotFree R d p hp x
  have hsurj : Function.Surjective (Work.DSM1p.Family.stageMap (R := R) (d := d) p x) := by
    intro z
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine ⟨Work.DSM1p.Family.redShift p x hp ((AddMonoidAlgebra.coeffLinearEquiv R) r), ?_⟩
    rw [Work.DSM1p.Family.stageMap_apply]
    exact (Work.DSM1p.Family.mk_red p x hp r).symm
  exact Module.Finite.of_surjective (σ := RingHom.id R)
    (M := Work.DSM1p.Family.RedIdx d p →₀ R) (P := SerStage R p x)
    (f := Work.DSM1p.Family.stageMap (R := R) (d := d) p x) hsurj

/-- **`1 + h` is a unit in the first stage**, for `h` in the ideal generated by the adjoined
roots.  The roots `Zᵢ` satisfy `Zᵢ ^ p = xᵢ ∈ 𝔪 B`, and `R → B` is finite hence integral, so
`𝔪 B` lies in the Jacobson radical of `B` (the contraction of a maximal ideal of `B` is the
maximal ideal `𝔪` of the local ring `R`); as the radical is a radical ideal, every `Zᵢ`, and
therefore `h`, lies in the radical, whence `1 + h` is a unit. -/
theorem isUnit_one_add_of_mem_rootIdeal (R : Type u) [CommRing R] [IsLocalRing R] [Nontrivial R]
    (p : ℕ) [Fact p.Prime] {d : ℕ} (x : Fin d → R)
    (hx : ∀ i, x i ∈ IsLocalRing.maximalIdeal R)
    (h : SerStage R p x)
    (hh : h ∈ Ideal.span (Set.range fun i => Ideal.Quotient.mk _ (MvPolynomial.X i))) :
    IsUnit (1 + h) := by
  have hfin : Module.Finite R (SerStage R p x) := finite_stage R p x (Fact.out : p.Prime).ne_zero
  haveI : Algebra.IsIntegral R (SerStage R p x) := Algebra.IsIntegral.of_finite R _
  have hint : (algebraMap R (SerStage R p x)).IsIntegral := fun y =>
    Algebra.IsIntegral.isIntegral y
  have hmap_le : Ideal.map (algebraMap R (SerStage R p x)) (IsLocalRing.maximalIdeal R) ≤
      (⊥ : Ideal (SerStage R p x)).jacobson := by
    rw [Ideal.jacobson]
    refine le_sInf fun J hJ => ?_
    haveI : J.IsMaximal := hJ.2
    have hJm : (Ideal.comap (algebraMap R (SerStage R p x)) J).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint J
    have hc : Ideal.comap (algebraMap R (SerStage R p x)) J = IsLocalRing.maximalIdeal R :=
      IsLocalRing.eq_maximalIdeal hJm
    exact (Ideal.map_le_iff_le_comap).mpr (le_of_eq hc.symm)
  have hroot : ∀ i : Fin d, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈
      (⊥ : Ideal (SerStage R p x)).jacobson := by
    intro i
    have hrel : (Ideal.Quotient.mk (Work.DSM1p.Family.stageIdeal p x) (MvPolynomial.X i) :
        SerStage R p x) ^ p = algebraMap R (SerStage R p x) (x i) := by
      rw [← map_pow, show algebraMap R (SerStage R p x) (x i) =
        Ideal.Quotient.mk _ (MvPolynomial.C (x i)) from rfl, ← sub_eq_zero, ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
    refine (Ideal.isRadical_jacobson (⊥ : Ideal (SerStage R p x))) ⟨p, ?_⟩
    rw [hrel]
    exact hmap_le (Ideal.mem_map_of_mem _ (hx i))
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hh
  have hmem : h ∈ (⊥ : Ideal (SerStage R p x)).jacobson := by
    rw [← hc]
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hroot i)
  simpa [add_comm] using Ideal.mem_jacobson_bot.mp hmem 1

/-! ## From Frobenius surjectivity to a compatible system of `p`-th roots -/

/-- **Existence of a tilt element with prescribed zeroth coefficient.**  If `O` is `p`-adically
complete and Frobenius is surjective modulo `p`, then every element of `O` has a compatible
system of `p`-th roots modulo `p`, i.e. an element of `PreTilt O p` whose zeroth coefficient is
the class of the given element. -/
theorem exists_preTilt_coeff_zero {O : Type u} [CommRing O] (p : ℕ) [Fact p.Prime]
    [Fact (¬ IsUnit (p : O))] [IsAdicComplete (Ideal.span {(p : O)}) O]
    (hfrob : ∀ y : O, ∃ z : O, y - z ^ p ∈ Ideal.span {(p : O)}) (y : O) :
    ∃ xt : PreTilt O p,
      PreTilt.coeff 0 xt = Ideal.Quotient.mk (Ideal.span {(p : O)}) y := by
  have hstep : ∀ u : O ⧸ Ideal.span {(p : O)}, ∃ v : O ⧸ Ideal.span {(p : O)}, v ^ p = u := by
    intro u
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨z, hz⟩ := hfrob w
    refine ⟨Ideal.Quotient.mk _ z, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq]
    simpa [neg_sub] using neg_mem hz
  let step : (O ⧸ Ideal.span {(p : O)}) → (O ⧸ Ideal.span {(p : O)}) :=
    fun u => (hstep u).choose
  have step_spec : ∀ u, (step u) ^ p = u := fun u => (hstep u).choose_spec
  let yseq : ℕ → O ⧸ Ideal.span {(p : O)} := fun n => (step^[n]) (Ideal.Quotient.mk _ y)
  refine ⟨⟨yseq, ?_⟩, ?_⟩
  · intro n
    show (step^[n + 1]) (Ideal.Quotient.mk _ y) ^ p = (step^[n]) (Ideal.Quotient.mk _ y)
    rw [Function.iterate_succ_apply']
    exact step_spec _
  · rfl

/-! ## The residue field of a complete regular local ring is `p`-closed -/

/-- **The hypothesis `hfrob` forces the residue field to be `p`-closed.**  The reduction map
`A ⧸ (p) → R ⧸ 𝔪` of the root closure `A = R[xᵢ^{1/p^∞}]` is a surjective ring homomorphism
sending the roots to `0`, hence so is the composite `A′ ⧸ (p) ≃ A ⧸ (p) → R ⧸ 𝔪`; Frobenius
surjectivity modulo `p` of `A′` therefore descends to the residue field.  This gives the
"perfect residue field" hypothesis needed to apply `SERHyp` to `R` itself. -/
theorem perfect_residue_of_hfrob (R : Type u) [CommRing R] [IsRegularLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] (p : ℕ) [Fact p.Prime]
    (hpm : (p : R) ∈ IsLocalRing.maximalIdeal R) {d : ℕ} (x : Fin d → R)
    (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R)
    (hfrob : ∀ y : Work.DSM1p.FamCompletion R p x, ∃ z : Work.DSM1p.FamCompletion R p x,
      y - z ^ p ∈ Ideal.span {(p : Work.DSM1p.FamCompletion R p x)}) :
    ∀ y : R, ∃ μ : R, y - μ ^ p ∈ IsLocalRing.maximalIdeal R := by
  have hxmem : ∀ i : Fin d, x i ∈ IsLocalRing.maximalIdeal R :=
    fun i => hx ▸ Ideal.subset_span ⟨i, rfl⟩
  have hp0 : 0 < p := (Fact.out : p.Prime).pos
  set φ := Work.DSM1p.Family.redHom R p x (IsLocalRing.maximalIdeal R) hxmem hp0 with hφ
  have hφp : φ (p : Work.DSM1p.FamClosure R p x) = 0 := by
    rw [show (p : Work.DSM1p.FamClosure R p x) = algebraMap R _ (p : R) from
      (map_natCast (algebraMap R (Work.DSM1p.FamClosure R p x)) p).symm,
      Work.DSM1p.Family.redHom_algebraMap]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hpm
  set ψ := Ideal.Quotient.lift (Ideal.span {(p : Work.DSM1p.FamClosure R p x)}) φ
    (fun a ha => by
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
      rw [map_mul, hφp, zero_mul]) with hψ
  have hψmk : ∀ a : Work.DSM1p.FamClosure R p x,
      ψ (Ideal.Quotient.mk _ a) = φ a := fun a =>
    Ideal.Quotient.lift_mk (Ideal.span {(p : Work.DSM1p.FamClosure R p x)}) φ _ (a := a)
  have hψsurj : Function.Surjective ψ := by
    intro z
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨Ideal.Quotient.mk _ (algebraMap R (Work.DSM1p.FamClosure R p x) r),
      by rw [hψmk, Work.DSM1p.Family.redHom_algebraMap]⟩
  obtain ⟨e⟩ := Work.DSM1p.Completion.AdicCompletionModP.adicCompletion_quot_span
    (Work.DSM1p.FamClosure R p x) p
  set θ : Work.DSM1p.FamCompletion R p x ⧸ Ideal.span {(p : Work.DSM1p.FamCompletion R p x)} →+*
      R ⧸ IsLocalRing.maximalIdeal R := ψ.comp e.toRingHom with hθ
  have hθsurj : Function.Surjective θ := hψsurj.comp e.surjective
  have hfrobQ : ∀ u : Work.DSM1p.FamCompletion R p x ⧸
      Ideal.span {(p : Work.DSM1p.FamCompletion R p x)}, ∃ v, v ^ p = u := by
    intro u
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨z, hz⟩ := hfrob y
    refine ⟨Ideal.Quotient.mk _ z, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq]
    simpa using neg_mem hz
  have hres : ∀ w : R ⧸ IsLocalRing.maximalIdeal R, ∃ v, v ^ p = w := by
    intro w
    obtain ⟨u, hu⟩ := hθsurj w
    obtain ⟨v, hv⟩ := hfrobQ u
    exact ⟨θ v, by rw [← map_pow, hv, hu]⟩
  intro y
  obtain ⟨v, hv⟩ := hres (Ideal.Quotient.mk _ y)
  obtain ⟨μ, hμ⟩ := Ideal.Quotient.mk_surjective v
  refine ⟨μ, ?_⟩
  have h : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) (μ ^ p) =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) y := by
    rw [map_pow, hμ, hv]
  have h2 : μ ^ p - y ∈ IsLocalRing.maximalIdeal R := (Ideal.Quotient.eq).mp h
  simpa using neg_mem h2

/-! ## From the first stage to the completion -/

/-- The `R`-algebra map from the first stage `R[Z] ⧸ (Zᵢ ^ p - xᵢ)` to the completion `A′`,
sending `Zᵢ` to the `p`-th root `Aroot R p x 0 i` of `xᵢ`. -/
noncomputable def stageToCompletion (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (x : Fin d → R) :
    SerStage R p x →+* Work.DSM1p.FamCompletion R p x :=
  Ideal.Quotient.lift (Work.DSM1p.Family.stageIdeal p x)
    (MvPolynomial.eval₂Hom (algebraMap R (Work.DSM1p.FamCompletion R p x))
      (fun i => Aroot R p x 0 i))
    (by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp ha
      rw [map_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [map_mul]
      have h0 : MvPolynomial.eval₂Hom (algebraMap R (Work.DSM1p.FamCompletion R p x))
          (fun i => Aroot R p x 0 i)
          (MvPolynomial.X i ^ p - MvPolynomial.C (x i)) = 0 := by
        rw [map_sub, map_pow, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          Aroot_zero_pow, sub_self]
      rw [h0, mul_zero])

/-- `stageToCompletion` computed on a polynomial. -/
theorem stageToCompletion_mk (a : MvPolynomial (Fin d) R) :
    stageToCompletion R p x (Ideal.Quotient.mk _ a) =
      MvPolynomial.eval₂Hom (algebraMap R (Work.DSM1p.FamCompletion R p x))
        (fun i => Aroot R p x 0 i) a :=
  Ideal.Quotient.lift_mk _ _ _ (a := a)

/-- `stageToCompletion` restricts to the structure map `R → A′`. -/
theorem stageToCompletion_algebraMap (r : R) :
    stageToCompletion R p x (algebraMap R (SerStage R p x) r) =
      algebraMap R (Work.DSM1p.FamCompletion R p x) r := by
  rw [show algebraMap R (SerStage R p x) r = Ideal.Quotient.mk _ (MvPolynomial.C r) from rfl,
    stageToCompletion_mk, MvPolynomial.eval₂Hom_C]

/-- The `R`-module structure of the stage (coming from `Submodule.Quotient.instSMul'`) is
multiplication by the image of the scalar. -/
theorem stage_smul_eq (r : R) (a : SerStage R p x) :
    r • a = algebraMap R (SerStage R p x) r * a := by
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective a
  have h1 : r • (Ideal.Quotient.mk (Work.DSM1p.Family.stageIdeal p x) q) =
      Ideal.Quotient.mk (Work.DSM1p.Family.stageIdeal p x) (r • q) := by
    rw [← Ideal.Quotient.mk_eq_mk (I := Work.DSM1p.Family.stageIdeal p x) q,
      ← Ideal.Quotient.mk_eq_mk (I := Work.DSM1p.Family.stageIdeal p x) (r • q),
      Submodule.Quotient.mk_smul]
  rw [h1, MvPolynomial.smul_eq_C_mul q r, map_mul]
  rfl

/-! ## The pseudo-uniformizer tower -/

/-- `1 + h + q * S` is a unit whenever `1 + h` is a unit and `q` lies in the Jacobson radical. -/
theorem isUnit_one_add_add_of_mem_jacobson {A : Type*} [CommRing A] {q h S : A}
    (hq : q ∈ (⊥ : Ideal A).jacobson) (hh : IsUnit (1 + h)) : IsUnit (1 + h + q * S) := by
  obtain ⟨u, hu⟩ := hh
  have h1 : IsUnit (1 + q * (S * ↑u⁻¹)) := by
    have h := Ideal.mem_jacobson_bot.mp hq (S * ↑u⁻¹)
    rw [show (1 + q * (S * ↑u⁻¹)) = q * (S * ↑u⁻¹) + 1 from add_comm _ _]
    exact h
  have h2 : (1 + h + q * S) = ↑u * (1 + q * (S * ↑u⁻¹)) := by
    have h4 : (↑u : A) * (q * (S * ↑u⁻¹)) = q * S := by
      calc (↑u : A) * (q * (S * ↑u⁻¹)) = q * S * ((↑u : A) * ↑u⁻¹) := by ring
        _ = q * S * 1 := by rw [Units.mul_inv]
        _ = q * S := by ring
    rw [mul_add, mul_one, h4, hu]
  rw [h2]
  exact (Units.isUnit u).mul h1

/-- The bookkeeping of the last congruence: if `b ^ p = q * (1 + h)` then the `p`-th power of
`b + p c` is `q` times a unit, the correction being `q ^ 2 * S`. -/
theorem sq_mul_add_pow {A : Type*} [CommRing A] (p : ℕ) (q b h S : A) (hb : b ^ p = q * (1 + h)) :
    q ^ 2 * S + b ^ p = q * (1 + h + q * S) := by
  rw [hb]
  ring

theorem varpiData (R : Type u) [CommRing R] [IsRegularLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] (p : ℕ) [Fact p.Prime]
    (hSER : Work.DSM1p.SERHyp.{u} p)
    (hpm : (p : R) ∈ IsLocalRing.maximalIdeal R) {d : ℕ} (x : Fin d → R)
    (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R)
    (hfrob : ∀ y : Work.DSM1p.FamCompletion R p x, ∃ z : Work.DSM1p.FamCompletion R p x,
      y - z ^ p ∈ Ideal.span {(p : Work.DSM1p.FamCompletion R p x)}) :
    ∃ ϖ : ℕ → Work.DSM1p.FamCompletion R p x,
      (∀ k, ϖ (k + 1) ^ p = ϖ k) ∧
      (∃ v : (Work.DSM1p.FamCompletion R p x)ˣ, ϖ 0 ^ p =
        (p : Work.DSM1p.FamCompletion R p x) * v) := by
  by_cases htriv : Subsingleton (Work.DSM1p.FamCompletion R p x)
  · exact ⟨fun _ => 0, fun k => by rw [zero_pow (Fact.out : p.Prime).ne_zero],
      1, by rw [Units.val_one, mul_one]; exact Subsingleton.elim _ _⟩
  · haveI : Nontrivial (Work.DSM1p.FamCompletion R p x) :=
      not_subsingleton_iff_nontrivial.mp htriv
    haveI : IsAdicComplete (Ideal.span {(p : Work.DSM1p.FamCompletion R p x)})
        (Work.DSM1p.FamCompletion R p x) := isAdicComplete R p x
    have hxmem : ∀ i : Fin d, x i ∈ IsLocalRing.maximalIdeal R :=
      fun i => hx ▸ Ideal.subset_span ⟨i, rfl⟩
    -- the residue field is `p`-closed, so `SERHyp` applies to `R`
    have hperf : ∀ y : R, ∃ μ : R, y - μ ^ p ∈ IsLocalRing.maximalIdeal R :=
      perfect_residue_of_hfrob R p hpm x hx hfrob
    obtain ⟨b, hb, hbeq, hbmem⟩ := hSER R
      (inferInstanceAs (IsAdicComplete (IsLocalRing.maximalIdeal R) R)) hpm hperf x hx p
    have hbunit : IsUnit (1 + hb) :=
      isUnit_one_add_of_mem_rootIdeal R p x hxmem hb (hbmem hpm)
    -- push the SER output forward to `A′`
    have hbeq' : (stageToCompletion R p x b) ^ p =
        (p : Work.DSM1p.FamCompletion R p x) * (1 + stageToCompletion R p x hb) := by
      have h := congrArg (stageToCompletion R p x) hbeq
      simp only [map_pow, map_add, stage_smul_eq R p x, map_mul, map_natCast] at h
      rw [h, mul_add, mul_one]
    -- `p` is not a unit in `A′` (it is `p`-adically complete and nontrivial)
    have hnotunit : ¬ IsUnit (p : Work.DSM1p.FamCompletion R p x) := by
      intro hunit
      have htop : Ideal.span {(p : Work.DSM1p.FamCompletion R p x)} = ⊤ :=
        Ideal.span_singleton_eq_top.mpr hunit
      have hI : IsHausdorff (Ideal.span {(p : Work.DSM1p.FamCompletion R p x)})
          (Work.DSM1p.FamCompletion R p x) := (isAdicComplete R p x).toIsHausdorff
      have hmem : ∀ n, (1 : Work.DSM1p.FamCompletion R p x) ≡ 0
          [SMOD (Ideal.span {(p : Work.DSM1p.FamCompletion R p x)} ^ n •
            ⊤ : Submodule (Work.DSM1p.FamCompletion R p x)
              (Work.DSM1p.FamCompletion R p x))] := by
        intro n
        rw [htop, Ideal.top_pow]
        simp
      exact one_ne_zero (IsHausdorff.haus' 1 hmem)
    haveI : Fact (¬ IsUnit (p : Work.DSM1p.FamCompletion R p x)) := ⟨hnotunit⟩
    -- the tilt element and its untilt tower
    obtain ⟨xt, hxt⟩ := exists_preTilt_coeff_zero p hfrob (stageToCompletion R p x b)
    let ϖ : ℕ → Work.DSM1p.FamCompletion R p x := fun k =>
      PreTilt.untilt (((frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm)^[k]
        xt)
    have hϖtower : ∀ k, ϖ (k + 1) ^ p = ϖ k := by
      intro k
      have h := PreTilt.untilt_iterate_frobeniusEquiv_symm_pow
        (((frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm)^[k] xt) 1
      rw [pow_one] at h
      rw [show (frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm^[1]
          (((frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm)^[k] xt) =
          (frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm^[k + 1] xt
        from (Function.iterate_succ_apply' _ _ _).symm] at h
      exact h
    -- `ϖ 0 = g′ + p c`
    have hiter0 : (⇑(frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm)^[0] xt
        = xt := by
      rw [Function.iterate_zero]
      rfl
    have hcong : Ideal.Quotient.mk (Ideal.span {(p : Work.DSM1p.FamCompletion R p x)}) (ϖ 0) =
        Ideal.Quotient.mk (Ideal.span {(p : Work.DSM1p.FamCompletion R p x)})
          (stageToCompletion R p x b) := by
      rw [show ϖ 0 = PreTilt.untilt
        ((⇑(frobeniusEquiv (PreTilt (Work.DSM1p.FamCompletion R p x) p) p).symm)^[0] xt)
        from rfl, hiter0, PreTilt.mk_untilt_eq_coeff_zero, hxt]
    have hdiff : ϖ 0 - stageToCompletion R p x b ∈
        Ideal.span {(p : Work.DSM1p.FamCompletion R p x)} :=
      Ideal.Quotient.eq.mp hcong
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hdiff
    -- the `p`-th power of `ϖ 0`
    have hbsq : (ϖ 0) ^ p - (stageToCompletion R p x b) ^ p ∈
        Ideal.span {((p : Work.DSM1p.FamCompletion R p x) ^ 2)} := by
      rw [show ϖ 0 = stageToCompletion R p x b + (p : Work.DSM1p.FamCompletion R p x) * c by
        rw [← hc]; ring]
      exact pow_add_p_mul_sub_mem_sq _ p _ c
    obtain ⟨S, hS⟩ := Ideal.mem_span_singleton.mp hbsq
    have hϖpow : (ϖ 0) ^ p = (p : Work.DSM1p.FamCompletion R p x) *
        (1 + stageToCompletion R p x hb + (p : Work.DSM1p.FamCompletion R p x) * S) := by
      have h1 : (ϖ 0) ^ p = (p : Work.DSM1p.FamCompletion R p x) ^ 2 * S +
          (stageToCompletion R p x b) ^ p := eq_add_of_sub_eq hS
      rw [h1, sq_mul_add_pow p (p : Work.DSM1p.FamCompletion R p x)
        (stageToCompletion R p x b) (stageToCompletion R p x hb) S hbeq']
    -- the second factor is a unit
    have hpjac : (p : Work.DSM1p.FamCompletion R p x) ∈
        (⊥ : Ideal (Work.DSM1p.FamCompletion R p x)).jacobson :=
      IsAdicComplete.le_jacobson_bot
        (Ideal.span {(p : Work.DSM1p.FamCompletion R p x)})
        (Ideal.mem_span_singleton_self _)
    have hu : IsUnit (1 + stageToCompletion R p x hb) := by
      obtain ⟨u, hu⟩ := hbunit.map (stageToCompletion R p x)
      exact ⟨u, by rw [hu, map_add, map_one]⟩
    have hpq := isUnit_one_add_add_of_mem_jacobson (S := S) hpjac hu
    obtain ⟨v, hv⟩ := hpq
    refine ⟨ϖ, hϖtower, ⟨v, ?_⟩⟩
    exact hϖpow.trans (congrArg (fun y => (p : Work.DSM1p.FamCompletion R p x) * y) hv.symm)

end Work.DSM1p.Family
