import Mathlib
import Submission.Work.DSM1p.Family
import Submission.Work.DSNORM.Main
import Submission.Work.DSM1p.Family.torsionFree_completion
import Submission.Work.DSM1p.Family.torsionFree_closure
import Submission.Work.DSM1p.Family.stage_isMaximalIdeal_root
import Submission.Work.DSM1p.Family.le_ringKrullDim_stage
import Submission.Work.DSM1p.Family.stage_dvd_pow
import Submission.Work.DSM1p.Family.stepMap_injective
import Submission.Work.DSM1p.Family.closure_dvd_pow

/-!
# `p`-root-closedness of the `p`-adic completion of the root tower

The target of this file is `Work.DSM1p.Family.pRootClosedAway`: the ring
`A′ = (R[x₁^{1/p^∞}, …, x_d^{1/p^∞}])^{^}`, the `p`-adic completion of the root closure of a
complete regular local ring `R` of mixed characteristic `(0, p)` with algebraically closed residue
field, is `p`-root closed in `A′[1/p]`.

## Proof structure

* the **stages** `A_n = R[Z]/(Z_i^{p^n} - x_i)` of the root tower are regular local rings
  (locality from `stage_isMaximalIdeal_root`, dimension from `le_ringKrullDim_stage`, embedding
  dimension `≤ d` from `span_roots_spanFinrank_le`), hence integrally closed (`DSNORM`) and
  domains (`DSREG`); hence each stage is `p`-root closed (`stage_dvd_pow`);
* the closure `A_∞ = colim_n A_n` is then `p`-root closed (`closure_dvd_pow`);
* the reduction `A′ ⧸ p ^ N ≅ A_∞ ⧸ p ^ N` (`ker_evalₐ_eq_map`) transfers this to the
  `p`-adic completion (`completion_mem_range_of_pow_mem_range`).
-/
namespace Work.DSM1p.Family

universe u

/-- The kernel of the reduction map `A′ → A_∞ ⧸ I ^ N` is the ideal generated by `I ^ N`. -/
theorem ker_evalₐ_eq_map {A : Type*} [CommRing A] (I : Ideal A) (hFG : I.FG) (N : ℕ) :
    RingHom.ker (AdicCompletion.evalₐ I N).toRingHom =
      (I ^ N).map (algebraMap A (AdicCompletion I A)) := by
  have hle : I ^ N ≤ I ^ N • (⊤ : Submodule A A) := by rw [Ideal.smul_eq_mul, Ideal.mul_top]
  have hfac : ∀ y : AdicCompletion I A,
      Ideal.Quotient.factor hle ((AdicCompletion.evalₐ I N) y) = AdicCompletion.eval I A N y :=
    fun y => AdicCompletion.factor_evalₐ_eq_eval I y hle
  have hinj : Function.Injective (Ideal.Quotient.factor hle) := by
    rw [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker]
    exact Ideal.map_mk_eq_bot_of_le (by rw [Ideal.smul_eq_mul, Ideal.mul_top])
  have hmem : ∀ y : AdicCompletion I A, (AdicCompletion.evalₐ I N) y = 0 ↔
      y ∈ I ^ N • (⊤ : Submodule A (AdicCompletion I A)) := by
    intro y
    rw [AdicCompletion.pow_smul_top_eq_ker_eval (M := A) hFG, LinearMap.mem_ker]
    constructor
    · intro hy
      rw [← hfac y, hy, map_zero]
    · intro hy
      exact hinj (by rw [map_zero, hfac y, hy])
  have hset : ((I ^ N • (⊤ : Submodule A (AdicCompletion I A)) :
        Submodule A (AdicCompletion I A)) : Set (AdicCompletion I A))
      = ((I ^ N).map (algebraMap A (AdicCompletion I A)) : Set (AdicCompletion I A)) := by
    rw [Ideal.smul_top_eq_map, Ideal.coe_restrictScalars]
  ext y
  show (AdicCompletion.evalₐ I N) y = 0 ↔
    y ∈ (I ^ N).map (algebraMap A (AdicCompletion I A))
  have hiff : (y ∈ ((I ^ N • (⊤ : Submodule A (AdicCompletion I A)) :
        Submodule A (AdicCompletion I A)) : Set (AdicCompletion I A)))
      ↔ y ∈ ((I ^ N).map (algebraMap A (AdicCompletion I A)) : Set (AdicCompletion I A)) := by
    rw [hset]
  exact (hmem y).trans hiff

/-- The image of an element of the closure under the reduction `A_∞ → A_∞ ⧸ I ^ N`. -/
theorem evalₐ_algebraMap {A : Type*} [CommRing A] (I : Ideal A) (N : ℕ) (y : A) :
    (AdicCompletion.evalₐ I N) (algebraMap A (AdicCompletion I A) y)
      = Ideal.Quotient.mk (I ^ N) y :=
  AdicCompletion.evalₐ_of I N y

/-- The natural number `n` of the completion reduces to the class of `n`. -/
theorem evalₐ_natCast {A : Type*} [CommRing A] (I : Ideal A) (N n : ℕ) :
    (AdicCompletion.evalₐ I N) (n : AdicCompletion I A) = Ideal.Quotient.mk (I ^ N) (n : A) := by
  rw [show (n : AdicCompletion I A) = algebraMap A (AdicCompletion I A) (n : A) from
    (map_natCast (algebraMap A (AdicCompletion I A)) n).symm]
  exact evalₐ_algebraMap I N (n : A)

/-- **The transfer of `p`-root closedness to the `p`-adic completion.**

If the root closure `A_∞ = R[x^{1/p^∞}]` satisfies the divisibility form of `p`-root closedness
(`b ^ p ∈ (p ^ (k * p))` implies `b ∈ (p ^ k)`) and `p` is a non-zero-divisor of the
`p`-adic completion `A′`, then `A′` is `p`-root closed in `A′[1/p]`.

The proof reduces modulo `p ^ (k * p)`: the reduction `A′ ⧸ p ^ N ≅ A_∞ ⧸ p ^ N` lets one lift
`z = a / p ^ k` and `z ^ p` to elements `b`, `c₁` of `A_∞` with `b ^ p ≡ c₁ * p ^ (k * p)`
modulo `p ^ (k * p)`, so that `b` is divisible by `p ^ k` in `A_∞`; transporting back gives
`z = b / p ^ k ∈ A′`. -/
theorem completion_mem_range_of_pow_mem_range {R : Type u} [CommRing R] (p : ℕ) [Fact p.Prime]
    {d : ℕ} (x : Fin d → R)
    (hdiv : ∀ (b : FamClosure R p x) (k : ℕ),
      (∃ c : FamClosure R p x, b ^ p = (p : FamClosure R p x) ^ (k * p) * c) →
      ∃ w : FamClosure R p x, b = (p : FamClosure R p x) ^ k * w)
    (htf : IsSMulRegular (FamCompletion R p x) (p : FamCompletion R p x)) :
    ∀ z : Localization.Away (p : FamCompletion R p x),
      z ^ p ∈ (algebraMap (FamCompletion R p x)
        (Localization.Away (p : FamCompletion R p x))).range →
      z ∈ (algebraMap (FamCompletion R p x)
        (Localization.Away (p : FamCompletion R p x))).range := by
  intro z hz
  obtain ⟨c, hc⟩ := RingHom.mem_range.mp hz
  obtain ⟨a, s, hs⟩ := IsLocalization.exists_mk'_eq (Submonoid.powers (p : FamCompletion R p x)) z
  obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff (s : FamCompletion R p x)
    (p : FamCompletion R p x)).mp s.2
  -- the localization map is injective, `p` being a non-zero-divisor of `A′`
  have hinj : Function.Injective (algebraMap (FamCompletion R p x)
      (Localization.Away (p : FamCompletion R p x))) := by
    refine IsLocalization.injective (M := Submonoid.powers (p : FamCompletion R p x))
      (S := Localization.Away (p : FamCompletion R p x)) ?_
    intro y hy
    rw [Submonoid.mem_powers_iff] at hy
    obtain ⟨m, rfl⟩ := hy
    rw [mem_nonZeroDivisors_iff_left]
    intro t ht
    exact IsSMulRegular.pow m htf (by simpa [smul_eq_mul] using ht)
  -- the equation `a ^ p = c * p ^ (k * p)` in `A′`
  have key : a ^ p = c * (p : FamCompletion R p x) ^ (k * p) := by
    refine hinj ?_
    have hspec := IsLocalization.mk'_spec' (Localization.Away (p : FamCompletion R p x)) a s
    rw [hs] at hspec
    rw [show (s : FamCompletion R p x) = (p : FamCompletion R p x) ^ k from hk.symm] at hspec
    rw [map_pow] at hspec
    -- `hspec : algebraMap p ^ k * z = algebraMap a`
    calc (algebraMap (FamCompletion R p x) (Localization.Away (p : FamCompletion R p x)))
          (a ^ p)
        = (algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x)) a) ^ p := by rw [map_pow]
      _ = ((algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x))) (p : FamCompletion R p x) ^ k
            * z) ^ p := by rw [← hspec]
      _ = (algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x))) (p : FamCompletion R p x) ^ (k * p)
            * z ^ p := by rw [mul_pow, ← pow_mul]
      _ = (algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x))) (p : FamCompletion R p x) ^ (k * p)
            * (algebraMap (FamCompletion R p x)
              (Localization.Away (p : FamCompletion R p x))) c := by rw [← hc]
      _ = (algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x))) ((p : FamCompletion R p x) ^ (k * p))
            * (algebraMap (FamCompletion R p x)
              (Localization.Away (p : FamCompletion R p x))) c := by rw [map_pow]
      _ = (algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x)))
            ((p : FamCompletion R p x) ^ (k * p) * c) := by rw [map_mul]
      _ = (algebraMap (FamCompletion R p x)
            (Localization.Away (p : FamCompletion R p x)))
            (c * (p : FamCompletion R p x) ^ (k * p)) := by rw [mul_comm]
  -- the ideal and the reduction
  set I : Ideal (FamClosure R p x) := Ideal.span {(p : FamClosure R p x)} with hI
  have hFG : I.FG := ⟨{(p : FamClosure R p x)}, by simp [hI]⟩
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective
    ((AdicCompletion.evalₐ I (k * p)) a)
  obtain ⟨c₁, hc₁⟩ := Ideal.Quotient.mk_surjective
    ((AdicCompletion.evalₐ I (k * p)) c)
  -- the equation after reduction
  have hred : Ideal.Quotient.mk (I ^ (k * p)) (b ^ p)
      = Ideal.Quotient.mk (I ^ (k * p)) (c₁ * (p : FamClosure R p x) ^ (k * p)) := by
    have h3 := congrArg (AdicCompletion.evalₐ I (k * p)) key
    simp only [map_pow, map_mul] at h3
    rw [evalₐ_natCast] at h3
    rw [← hb, ← hc₁] at h3
    simpa using h3
  -- so `b ^ p` is divisible by `p ^ (k * p)` in `A_∞`
  have hmem : b ^ p - c₁ * (p : FamClosure R p x) ^ (k * p) ∈ I ^ (k * p) := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    rw [map_sub, hred, sub_self]
  have hmem' : b ^ p - c₁ * (p : FamClosure R p x) ^ (k * p)
      ∈ Ideal.span {((p : FamClosure R p x) ^ (k * p))} := by
    have h := hmem
    rw [hI, Ideal.span_singleton_pow] at h
    exact h
  obtain ⟨e, he⟩ := Ideal.mem_span_singleton.mp hmem'
  obtain ⟨w, hw⟩ := hdiv b k ⟨c₁ + e, by rw [mul_add, ← he]; ring⟩
  -- the lift of `a` modulo `p ^ (k * p)`
  have hker : a - algebraMap (FamClosure R p x) (FamCompletion R p x) b
      ∈ (I ^ (k * p)).map (algebraMap (FamClosure R p x) (FamCompletion R p x)) := by
    rw [← ker_evalₐ_eq_map I hFG (k * p)]
    show (AdicCompletion.evalₐ I (k * p))
      (a - algebraMap (FamClosure R p x) (FamCompletion R p x) b) = 0
    rw [map_sub, ← hb, evalₐ_algebraMap, sub_self]
  have hmem2 : a - algebraMap (FamClosure R p x) (FamCompletion R p x) b
      ∈ Ideal.span {((p : FamCompletion R p x) ^ (k * p))} := by
    have h := hker
    rw [hI, Ideal.span_singleton_pow, Ideal.map_span] at h
    simpa using h
  obtain ⟨e', he'⟩ := Ideal.mem_span_singleton.mp hmem2
  have hk_le : k ≤ k * p := Nat.le_mul_of_pos_right k (Fact.out : p.Prime).pos
  have ha'' : a = algebraMap (FamClosure R p x) (FamCompletion R p x) b
      + (p : FamCompletion R p x) ^ (k * p) * e' := by
    rw [← he']; ring
  have ha : a = (p : FamCompletion R p x) ^ k
      * (algebraMap (FamClosure R p x) (FamCompletion R p x) w
        + (p : FamCompletion R p x) ^ (k * p - k) * e') := by
    have h1 : algebraMap (FamClosure R p x) (FamCompletion R p x) b
        = (p : FamCompletion R p x) ^ k
          * algebraMap (FamClosure R p x) (FamCompletion R p x) w := by
      rw [hw, map_mul, map_pow, map_natCast]
    have h2 : (p : FamCompletion R p x) ^ k
        * ((p : FamCompletion R p x) ^ (k * p - k) * e')
        = (p : FamCompletion R p x) ^ (k * p) * e' := by
      rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hk_le]
    rw [ha'', h1, mul_add, h2]
  refine ⟨algebraMap (FamClosure R p x) (FamCompletion R p x) w
    + (p : FamCompletion R p x) ^ (k * p - k) * e', ?_⟩
  rw [← hs, show a = (s : FamCompletion R p x)
      * (algebraMap (FamClosure R p x) (FamCompletion R p x) w
        + (p : FamCompletion R p x) ^ (k * p - k) * e') from by
    rw [hk.symm]; exact ha]
  rw [IsLocalization.mk'_mul_cancel_left]

/-! ## The stages of the root tower are regular local rings -/

section Stage

variable {R : Type u} [CommRing R] (p : ℕ) {d : ℕ} (x : Fin d → R)

/-- Every stage of the root tower is a Noetherian ring. -/
instance stage_isNoetherianRing [IsNoetherianRing R] (n : ℕ) :
    IsNoetherianRing (FamTower R p x n) :=
  Ideal.Quotient.isNoetherianRing _

/-- The maximal ideal of a stage is generated by the `d` roots, so its embedding dimension is
at most `d`. -/
theorem span_roots_spanFinrank_le (n : ℕ) :
    (Ideal.span (Set.range (FamTower.root R p x n))).spanFinrank ≤ d := by
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
  rw [show Set.range (FamTower.root R p x n) = (FamTower.root R p x n) '' Set.univ from
    Set.image_univ.symm]
  refine (Set.ncard_image_le).trans ?_
  simp [Set.ncard_univ]

/-- A stage of the root tower has a unique maximal ideal, provided the roots generate the maximal
ideal of `R`. -/
theorem stage_existsUnique_maximal (n : ℕ)
    (hroot : ∀ I : Ideal (FamTower R p x n),
      I.IsMaximal ↔ I = Ideal.span (Set.range (FamTower.root R p x n))) :
    ∃! I : Ideal (FamTower R p x n), I.IsMaximal :=
  ⟨_, (hroot _).mpr rfl, fun I hI => (hroot I).mp hI⟩

/-- **The stages of the root tower are regular local rings.** -/
theorem stage_isRegularLocalRing [IsNoetherianRing R] (n : ℕ)
    (hroot : ∀ I : Ideal (FamTower R p x n),
      I.IsMaximal ↔ I = Ideal.span (Set.range (FamTower.root R p x n)))
    (hdim : (d : WithBot ℕ∞) ≤ ringKrullDim (FamTower R p x n)) :
    IsRegularLocalRing (FamTower R p x n) := by
  haveI : IsLocalRing (FamTower R p x n) :=
    IsLocalRing.of_unique_max_ideal (stage_existsUnique_maximal p x n hroot)
  have hmax := IsLocalRing.eq_maximalIdeal ((hroot _).mpr rfl)
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le (R := FamTower R p x n) ?_
  have h1 : ((Ideal.span (Set.range (FamTower.root R p x n))).spanFinrank : WithBot ℕ∞)
      ≤ (d : WithBot ℕ∞) := by
    exact_mod_cast span_roots_spanFinrank_le p x n
  rw [← hmax]
  exact h1.trans hdim

end Stage

/-! ## The target statement -/

/-- **`p`-root-closedness of the `p`-adic completion of the root tower.** -/
theorem pRootClosedAway (R : Type u) [CommRing R] [IsRegularLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] [IsAlgClosed (IsLocalRing.ResidueField R)]
    (p : ℕ) [Fact p.Prime] [CharZero R] [CharP (IsLocalRing.ResidueField R) p] {d : ℕ}
    (x : Fin d → R) (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R)
    (hd : ringKrullDim R = (d : WithBot ℕ∞)) :
    ∀ z : Localization.Away (p : Work.DSM1p.FamCompletion R p x),
      z ^ p ∈ (algebraMap (Work.DSM1p.FamCompletion R p x)
        (Localization.Away (p : Work.DSM1p.FamCompletion R p x))).range →
      z ∈ (algebraMap (Work.DSM1p.FamCompletion R p x)
        (Localization.Away (p : Work.DSM1p.FamCompletion R p x))).range := by
  haveI : IsDomain R := DSMap.area_REG_proved R
  have hp0 : (p : R) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero
  have hRreg : IsSMulRegular R p := by
    intro y z hyz
    change p • y = p • z at hyz
    rw [nsmul_eq_mul, nsmul_eq_mul] at hyz
    have h : (p : R) * (y - z) = 0 := by rw [mul_sub, hyz, sub_self]
    rcases mul_eq_zero.mp h with h' | h'
    · exact absurd h' hp0
    · exact sub_eq_zero.mp h'
  haveI : IsSMulRegular (FamClosure R p x) (p : FamClosure R p x) :=
    torsionFree_closure R p x hRreg
  have htf : IsSMulRegular (FamCompletion R p x) (p : FamCompletion R p x) :=
    torsionFree_completion R p x ‹IsSMulRegular (FamClosure R p x) (p : FamClosure R p x)›
  have hstage (n : ℕ) : IsRegularLocalRing (FamTower R p x n) :=
    stage_isRegularLocalRing p x n (stage_isMaximalIdeal_root R p x hx n)
      (le_ringKrullDim_stage R p x hd n)
  refine completion_mem_range_of_pow_mem_range p x ?_ htf
  refine closure_dvd_pow R p x (fun {m n} h => stepMap_injective R p x h) ?_
  intro n b k h
  haveI := hstage n
  exact stage_dvd_pow R p x hRreg n b k h

end Work.DSM1p.Family
