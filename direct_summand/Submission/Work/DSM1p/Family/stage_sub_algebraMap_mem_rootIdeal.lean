import Mathlib
import Submission.Work.DSM1p.Family.flat_closure

namespace Work.DSM1p.Family

open MvPolynomial

/-- Every element of a multivariable polynomial ring differs from its constant coefficient by an
element of the ideal generated by the variables.  (The "augmentation ideal" of `MvPolynomial`.) -/
lemma sub_C_constantCoeff_mem_span_X (R : Type*) [CommRing R] {d : ℕ}
    (f : MvPolynomial (Fin d) R) :
    f - MvPolynomial.C (MvPolynomial.constantCoeff f) ∈
      Ideal.span (Set.range (fun i => (MvPolynomial.X i : MvPolynomial (Fin d) R))) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have h : (p + q) - MvPolynomial.C (MvPolynomial.constantCoeff (p + q))
        = (p - MvPolynomial.C (MvPolynomial.constantCoeff p))
          + (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
      rw [map_add, map_add]; ring
    rw [h]
    exact Ideal.add_mem _ hp hq
  | mul_X p m hp =>
    have hc : MvPolynomial.constantCoeff (p * MvPolynomial.X m) = 0 := by
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero]
    rw [hc, map_zero, sub_zero]
    have hX : (MvPolynomial.X m : MvPolynomial (Fin d) R) ∈
        Ideal.span (Set.range (fun i => (MvPolynomial.X i : MvPolynomial (Fin d) R))) :=
      Ideal.subset_span ⟨m, rfl⟩
    have h : p * MvPolynomial.X m
        = MvPolynomial.X m * (p - MvPolynomial.C (MvPolynomial.constantCoeff p))
          + MvPolynomial.C (MvPolynomial.constantCoeff p) * MvPolynomial.X m := by ring
    rw [h]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hp) (Ideal.mul_mem_left _ _ hX)

/-- Every element of the `n`-th stage `R[Z] / (Z_i ^ p^n - x_i)` of the multi-parameter root tower
is the image of an element of `R` modulo the ideal generated by the roots `Z_i`. -/
theorem stage_sub_algebraMap_mem_rootIdeal (R : Type*) [CommRing R] (p : ℕ) {d : ℕ}
    (x : Fin d → R) (n : ℕ) (s : Work.DSM1p.FamTower R p x n) :
    ∃ r : R, s - algebraMap R (Work.DSM1p.FamTower R p x n) r ∈
      Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) := by
  classical
  let J : Ideal (MvPolynomial (Fin d) R) :=
    Ideal.span (Set.range fun i => (MvPolynomial.X i) ^ (p ^ n) - MvPolynomial.C (x i))
  obtain ⟨f, hf⟩ := Ideal.Quotient.mk_surjective (I := J) s
  refine ⟨MvPolynomial.constantCoeff f, ?_⟩
  have hmem := sub_C_constantCoeff_mem_span_X R f
  have h2 : Ideal.Quotient.mk J (f - MvPolynomial.C (MvPolynomial.constantCoeff f))
      = s - algebraMap R (Work.DSM1p.FamTower R p x n) (MvPolynomial.constantCoeff f) := by
    rw [map_sub, hf]
    rfl
  rw [← h2]
  have hmap : Ideal.map (Ideal.Quotient.mk J)
        (Ideal.span (Set.range (fun i => (MvPolynomial.X i : MvPolynomial (Fin d) R))))
      = Ideal.span (Set.range (Work.DSM1p.FamTower.root R p x n)) := by
    rw [Ideal.map_span]
    congr 1
    rw [← Set.range_comp]
    congr 1
  rw [← hmap]
  exact Ideal.mem_map_of_mem _ hmem

end Work.DSM1p.Family
