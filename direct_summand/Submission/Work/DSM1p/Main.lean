/-!
# DSM1p — mixed characteristic: Bhatt's perfectoid cover of a complete regular
  local ring (arXiv:1608.08882, Prop. 4.2)

Frozen target: `DSMap.Mix.area_M1'` of the read-only file `Submission/Work/DSMap/Mix.lean`
(node `M1'` of `sources/dsmap/direct_summand_mix_design.md`):

> `∃ B, CommRing B ∧ Algebra A B ∧ PerfectoidData p B ∧ Module.FaithfullyFlat A B`
> for `A` a complete regular local ring of mixed characteristic `(0, p)` with algebraically
> closed residue field.

## The proof (Cohen-free) — DELIVERED

The cover is the `p`-adic completion `A′ = Work.DSM1p.FamCompletion A p x` of
`A[x₁^{1/p^∞}, …, x_d^{1/p^∞}]`, where `x₁,…,x_d` is a regular system of parameters of `𝔪_A`
(`Assembly.exists_min_systemOfParameters`).  Nothing here uses the Cohen structure theorem of
`A`; the three Cohen-type inputs of Bhatt's original argument are replaced by the shared,
Cohen-free nodes of `sources/dsmap/direct_summand_gaps_1013.md` §2.2, which are imported proved:

* **the tower, flatness, faithful flatness** — `Basic`, `Family.lean`, `Root/*`, `Completion/*`,
  `Criterion/*`: the stages `A_n = A[Z]/(Z_i^{p^n} - x_i)`, the filtered colimit `A_∞`, its
  `p`-adic completion `A′`; torsion-freeness, `p`-adic completeness, contraction of `(p)`
  (`comap_span_p`), flatness mod `p`, and **Bhatt's flatness criterion**
  `Criterion.flat_of_flat_mod_pi` (Prop. 4.1) giving flatness (`Assembly.flat_mod_p_completion`)
  and faithful flatness (`Family.faithfullyFlat_completion`,
  `Assembly.maximalIdeal_smul_ne_top_*`) of `A → A′` — imported in `Main` as
  `Family.faithfullyFlat_completion`;
* **`frobSurj`** — `Family.frobSurj`: Frobenius is surjective mod `p`; the shared node `area_SER`
  is discharged with the proved `Work.DSSER.area_SER_proved`;
* **`ϖ`** — `Family.varpiData`: a pseudo-uniformizer with `ϖ^p = p · unit`, built from the tilt
  of `A′`; same `area_SER` input.  `ϖ 0` is a nonzerodivisor by `varpi_isSMulRegular` (no domain
  hypothesis);
* **`frobInj`** — `Family.frobInjAway` + `Family.pRootClosedAway`: the kernel of Frobenius on
  `A′/p` in the `Away (p)` localization is described by `ϖ`, from the shared node
  `DSMap.Gaps.area_NORM_proved`.

`area_M1'_proved` bundles the resulting `DSMap.PerfectoidData p A′` with the faithful flatness.
No almost purity is used.

The two theorems below (`faithfullyFlat_rootClosure`, `area_M1'_of_rootClosure`) are the earlier
one-parameter reductions kept for reuse; they are superseded by `area_M1'_proved` but still
proved and sorry-free.
-/

namespace Work.DSM1p

universe a

open Polynomial IsLocalRing

/-- **The flat half of Bhatt's Prop. 4.2, for a principal parameter.**

For `A` a complete regular local ring of mixed characteristic with `𝔪 = (π)`, the `p`-adic
completion of `A[π^{1/p^∞}]` is faithfully flat over `A`, *given* that it is flat (the flatness
itself is `Assembly.flat_completion`, whose proof is Bhatt's flatness criterion applied to the
explicitly constructed cover). -/
theorem faithfullyFlat_rootClosure (A : Type a) [CommRing A] [IsRegularLocalRing A]
    (p : ℕ) [Fact p.Prime] (π : A)
    (hπ : Ideal.span {π} = IsLocalRing.maximalIdeal A)
    (hp𝔪 : (p : A) ∈ IsLocalRing.maximalIdeal A)
    (hflat : Module.Flat A (RootClosureCompletion A p π)) :
    Module.FaithfullyFlat A (RootClosureCompletion A p π) where
  toFlat := hflat
  submodule_ne_top m hm := by
    rw [IsLocalRing.eq_maximalIdeal hm]
    exact Assembly.maximalIdeal_smul_ne_top_completion A p
      (Fact.out : p.Prime).pos hp𝔪 π (by rw [← hπ]; exact Ideal.subset_span (Set.mem_singleton π))

/-- **`area_M1'` for a principal maximal ideal.**

If the maximal ideal of `A` is generated by a single element `π` and the explicit ring
`A[π^{1/p^∞}]^{^}` carries a perfectoid structure, then the frozen statement `DSMap.Mix.area_M1'`
holds.  The faithful flatness is proved here (`faithfullyFlat_rootClosure`); the perfectoid
structure on the explicit ring is the input that Bhatt's Cohen-structure argument supplies. -/
theorem area_M1'_of_rootClosure (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] [IsAlgClosed (ResidueField A)] (p : ℕ) [Fact p.Prime]
    [CharZero A] [CharP (ResidueField A) p] (π : A)
    (hπ : Ideal.span {π} = IsLocalRing.maximalIdeal A)
    (hflat : Module.Flat A (RootClosureCompletion A p π))
    (P : DSMap.PerfectoidData p (RootClosureCompletion A p π)) :
    ∃ (B : Type a) (_ : CommRing B) (_ : Algebra A B) (_ : DSMap.PerfectoidData p B),
      Module.FaithfullyFlat A B := by
  have hp𝔪 : (p : A) ∈ IsLocalRing.maximalIdeal A := by
    have hz : (p : ResidueField A) = 0 := CharP.cast_eq_zero (ResidueField A) p
    have hz' : IsLocalRing.residue A (p : A) = 0 := by simpa using hz
    exact (IsLocalRing.residue_eq_zero_iff (p : A)).mp hz'
  exact ⟨RootClosureCompletion A p π, inferInstance, inferInstance, P,
    faithfullyFlat_rootClosure A p π hπ hp𝔪 hflat⟩

/-- **The deliverable**: `area_M1'`.  A complete regular local ring of mixed characteristic
`(0, p)` with algebraically closed residue field admits a faithfully flat perfectoid cover. -/
theorem area_M1'_proved (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] [IsAlgClosed (ResidueField A)] (p : ℕ) [Fact p.Prime]
    [CharZero A] [CharP (ResidueField A) p] :
    ∃ (B : Type a) (_ : CommRing B) (_ : Algebra A B) (_ : DSMap.PerfectoidData p B),
      Module.FaithfullyFlat A B := by
  -- a *regular* system of parameters
  obtain ⟨d, x, hx, hd⟩ := Assembly.exists_min_systemOfParameters A
  haveI : IsDomain A := DSMap.area_REG_proved A
  have hp0 : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  have hp𝔪 : (p : A) ∈ maximalIdeal A := by
    have hz : (p : ResidueField A) = 0 := CharP.cast_eq_zero (ResidueField A) p
    have hz' : IsLocalRing.residue A (p : A) = 0 := by simpa using hz
    exact (IsLocalRing.residue_eq_zero_iff (p : A)).mp hz'
  have hperf : ∀ y : A, ∃ μ : A, y - μ ^ p ∈ maximalIdeal A :=
    exists_root_sub_mem_maximalIdeal A ‹IsAlgClosed (ResidueField A)› p
  have hpreg : IsSMulRegular A p := by
    intro y z hyz
    change p • y = p • z at hyz
    rw [nsmul_eq_mul, nsmul_eq_mul] at hyz
    have h : (p : A) * (y - z) = 0 := by rw [mul_sub, hyz, sub_self]
    rcases mul_eq_zero.mp h with h' | h'
    · exact absurd h' (Nat.cast_ne_zero.mpr hp0)
    · exact sub_eq_zero.mp h'
  have hx𝔪 : ∀ i, x i ∈ maximalIdeal A := by
    intro i
    rw [← hx]
    exact Ideal.subset_span ⟨i, rfl⟩
  -- faithful flatness of the cover
  have hFF : Module.FaithfullyFlat A (FamCompletion A p x) :=
    Family.faithfullyFlat_completion A p hp0 hpreg hp𝔪 x hx𝔪
  -- the perfectoid structure
  haveI : IsSMulRegular (FamClosure A p x) (p : FamClosure A p x) :=
    Family.torsionFree_closure A p x hpreg
  have htf : IsSMulRegular (FamCompletion A p x) (p : FamCompletion A p x) :=
    Family.torsionFree_completion A p x ‹IsSMulRegular (FamClosure A p x) (p : FamClosure A p x)›
  have hfrob : ∀ y : FamCompletion A p x, ∃ z : FamCompletion A p x,
      y - z ^ p ∈ Ideal.span {(p : FamCompletion A p x)} :=
    Family.frobSurj A p
      (fun S _ _ _ hR hpm hperf e z hz y =>
        @Work.DSSER.area_SER_proved p _ S _ _ _ hR hpm hperf e z hz y)
      ‹IsAdicComplete (maximalIdeal A) A› hp𝔪 hperf x hx
  obtain ⟨ϖ, hϖ, hunit⟩ := Family.varpiData A p
    (fun S _ _ _ hR hpm hperf e z hz y =>
      @Work.DSSER.area_SER_proved p _ S _ _ _ hR hpm hperf e z hz y)
    hp𝔪 x hx hfrob
  refine ⟨FamCompletion A p x, inferInstance, inferInstance, ?_, hFF⟩
  refine ⟨ϖ, hϖ, hunit, htf, Family.isAdicComplete A p x, hfrob, ?_⟩
  exact Family.frobInjAway A p hp𝔪 x hx htf ϖ hϖ hunit
    (Family.pRootClosedAway A p x hx hd.symm)


end Work.DSM1p

/-! ## The deliverable, under the name the frozen interface uses -/

namespace DSMap.Mix
universe a

open IsLocalRing

/-- **`area_M1'_proved`**: the frozen statement `DSMap.Mix.area_M1'`, proved (Cohen-free route of
`sources/dsmap/direct_summand_gaps_1013.md` §2.2, with the shared nodes `area_SER` and `area_NORM`
discharged by `Work.DSSER.area_SER_proved` and `DSMap.Gaps.area_NORM_proved`). -/
theorem area_M1'_proved (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] [IsAlgClosed (ResidueField A)] (p : ℕ) [Fact p.Prime]
    [CharZero A] [CharP (ResidueField A) p] :
    ∃ (B : Type a) (_ : CommRing B) (_ : Algebra A B) (_ : PerfectoidData p B),
      Module.FaithfullyFlat A B :=
  Work.DSM1p.area_M1'_proved A p

/-- the type of `area_M1'_proved` is the frozen type of `area_M1'` -/
example : type_of% (@area_M1'_proved.{a}) = type_of% (@area_M1'.{a}) := rfl

end DSMap.Mix
