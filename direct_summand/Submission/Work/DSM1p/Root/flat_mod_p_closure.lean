import Mathlib
import Submission.Work.DSM1p.Basic
import Submission.Work.DSM1p.Root.flat_closure

/-!
# Flatness of the root closure modulo `p`

Let `S = R[a^{1/p^∞}]` be the root closure of `a ∈ R` (`Work.DSM1p.RootClosure`), and let
`I = (p) ⊆ S` be the ideal generated by `p`.  Bhatt's flatness criterion
(`Work.DSM1p.Criterion.flat_of_flat_mod_pi`, Prop. 4.1 of arXiv:1608.08882) needs the reduction
`S/pS` to be flat over `R/(pS ∩ R)`, where `pS ∩ R = I.comap (algebraMap R S)` is the preimage
of `I` in `R`.

The point is that this is *formal* once one knows that `S` is flat over `R`: for any ideal
`J ⊆ R` the base change `S ⧸ J·S` is flat over `R ⧸ J`, and here `J·S = I` by construction of
`J = I.comap`.  We record the general statement as `flat_quot_comap` (its ingredient
`flat_quot_map` is `Module.Flat.baseChange` transported along
`Algebra.TensorProduct.quotIdealMapEquivQuotTensor`), and apply it with `J` the preimage of
`(p)` and the flatness of `S` supplied by `flat_closure`.

## Main results

* `flat_quot_map` : if `R → B` is flat and `J ⊆ R`, then `B ⧸ J·B` is flat over `R ⧸ J`.
* `flat_quot_comap` : under the additional hypothesis `(I.comap) · B = I`, the same holds for
  `B ⧸ I` over `R ⧸ I.comap`.
* `flat_mod_p_closure` : `R[a^{1/p^∞}]/p` is flat over `R ⧸ (p R[a^{1/p^∞}] ∩ R)`.
-/

namespace Work.DSM1p.Root

open TensorProduct

/-- **Base change of a flat algebra.** If `B` is a flat `R`-algebra and `J ⊆ R` an ideal, then
`B ⧸ J·B = (R ⧸ J) ⊗[R] B` is flat over `R ⧸ J`. -/
theorem flat_quot_map (R B : Type*) [CommRing R] [CommRing B] [Algebra R B] (J : Ideal R)
    [Module.Flat R B] :
    Module.Flat (R ⧸ J) (B ⧸ J.map (algebraMap R B)) :=
  Module.Flat.of_linearEquiv
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B J).toLinearEquiv

/-- **Flatness of the quotient by the preimage ideal.** Let `B` be a flat `R`-algebra and `I ⊆ B`
an ideal with `(I.comap (algebraMap R B)) · B = I` (i.e. `I` is generated by the elements of
`R` that it contains).  Then `B ⧸ I` is flat over `R ⧸ I.comap (algebraMap R B)`. -/
theorem flat_quot_comap (R B : Type*) [CommRing R] [CommRing B] [Algebra R B]
    (I : Ideal B) (h : (I.comap (algebraMap R B)).map (algebraMap R B) = I) [Module.Flat R B] :
    Module.Flat (R ⧸ I.comap (algebraMap R B)) (B ⧸ I) := by
  set J : Ideal R := I.comap (algebraMap R B) with hJ
  haveI : Module.Flat (R ⧸ J) (B ⧸ J.map (algebraMap R B)) := flat_quot_map R B J
  have hsurj : Function.Surjective (algebraMap R (R ⧸ J)) := by
    rw [Ideal.Quotient.algebraMap_eq]
    exact Ideal.Quotient.mk_surjective
  exact Module.Flat.of_linearEquiv
    ((Ideal.quotientEquivAlgOfEq R h).symm.toLinearEquiv.extendScalarsOfSurjective hsurj)

theorem flat_mod_p_closure (R : Type*) [CommRing R] (p : ℕ) (a : R) (hp : p ≠ 0) :
    Module.Flat (R ⧸ (Ideal.span {(p : Work.DSM1p.RootClosure R p a)}).comap
        (algebraMap R (Work.DSM1p.RootClosure R p a)))
      (Work.DSM1p.RootClosure R p a ⧸
        Ideal.span {(p : Work.DSM1p.RootClosure R p a)}) := by
  haveI : Module.Flat R (Work.DSM1p.RootClosure R p a) := flat_closure R p a hp
  refine flat_quot_comap R (Work.DSM1p.RootClosure R p a)
    (Ideal.span {(p : Work.DSM1p.RootClosure R p a)}) ?_
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have hp' : algebraMap R (Work.DSM1p.RootClosure R p a) (p : R)
        = (p : Work.DSM1p.RootClosure R p a) := map_natCast _ _
    rw [← hp']
    exact Ideal.mem_map_of_mem (algebraMap R (Work.DSM1p.RootClosure R p a))
      (Ideal.mem_comap.mpr (Ideal.subset_span (Set.mem_singleton _)))

end Work.DSM1p.Root
