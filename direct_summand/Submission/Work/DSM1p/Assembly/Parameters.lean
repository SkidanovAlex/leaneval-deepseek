import Submission.Work.DSM1p.Family

/-!
# DSM1p — a regular system of parameters, and the perfect-residue hypothesis

Two small inputs of the assembly of `area_M1'_proved`: the existence of a finite family generating
the maximal ideal of a Noetherian local ring, and the fact that an algebraically closed residue
field is perfect (which is the `hperf` hypothesis of `DSMap.Gaps.area_SER`).
-/

namespace Work.DSM1p

universe u

open IsLocalRing

/-- **A regular system of parameters exists** (no regularity is needed for this): in a Noetherian
local ring the maximal ideal is finitely generated, hence generated by a family `x : Fin d → A`. -/
theorem exists_fin_span_eq_maximalIdeal (A : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] :
    ∃ (d : ℕ) (x : Fin d → A), Ideal.span (Set.range x) = IsLocalRing.maximalIdeal A := by
  obtain ⟨n, s, hs⟩ := (Submodule.fg_iff_exists_fin_generating_family
    (N := IsLocalRing.maximalIdeal A)).mp (Ideal.fg_of_isNoetherianRing _)
  exact ⟨n, s, hs⟩

/-- **Perfect residue field**: an algebraically closed residue field is perfect, so every element
of `A` is a `p`-th power modulo the maximal ideal.  This is the `hperf` hypothesis of
`DSMap.Gaps.area_SER`. -/
theorem exists_root_sub_mem_maximalIdeal (A : Type u) [CommRing A] [IsLocalRing A]
    (h : IsAlgClosed (ResidueField A)) (p : ℕ) [Fact p.Prime] :
    ∀ y : A, ∃ μ : A, y - μ ^ p ∈ IsLocalRing.maximalIdeal A := by
  intro y
  have hp0 : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  obtain ⟨c, hc⟩ := IsAlgClosed.exists_root (Polynomial.X ^ p - Polynomial.C (IsLocalRing.residue A y))
    (by
      rw [Polynomial.degree_X_pow_sub_C (Nat.pos_of_ne_zero hp0)]
      exact_mod_cast hp0)
  rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_C, sub_eq_zero] at hc
  obtain ⟨μ, hμ⟩ := IsLocalRing.residue_surjective c
  refine ⟨μ, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, hμ, hc, sub_self]

end Work.DSM1p
