import Mathlib
import Submission.Work.DSF1.Sheaf.CechStruct
import Submission.Work.DSF1.Sheaf.exists_pow_smul_mem_of_forall_smul_pow_mem

namespace Work.DSF1.Sheaf

universe u

/-- **Power clearing for a single vector** (universe-polymorphic form of
`exists_pow_smul_mem_of_forall_smul_pow_mem`).

Fix a submodule `B ⊆ M`, a vector `s : M` and a *root* `g` of the ideal generated by a family
`f : ι → R`, in the sense that some power of `g` lies in `Ideal.span (Set.range f)`.  If for
every `i` the element `f i` kills `s` modulo `B` up to the `k i`-th power
(`f i ^ k i • s ∈ B`), then some power of `g` also kills `s` modulo `B`.

The proof packages the multipliers annihilating `s` modulo `B` as the ideal
`J = {a : R | a • s ∈ B} = ker (R → M, 1 ↦ s)`, i.e. the preimage of `B` under the linear map
`R → M` sending `1` to `s`.  Each generator `f i` lies in the radical of `J` precisely because
`(f i) ^ (k i) ∈ J`, hence `Ideal.span (Set.range f) ≤ J.radical` since `J.radical` is an ideal.
As `g ^ N` lies in that span, `g ^ N ∈ J.radical`, which by definition means
`(g ^ N) ^ m = g ^ (N * m) ∈ J` for some `m`, i.e. `g ^ (N * m) • s ∈ B`. -/
theorem exists_pow_smul_mem_of_forall_smul_pow_mem_u {R : Type u} [CommRing R] {ι : Type u}
    {M : Type u} [AddCommGroup M] [Module R M] (B : Submodule R M) (s : M) (f : ι → R)
    (k : ι → ℕ) (g : R) (hJ : ∀ i, f i ^ k i • s ∈ B)
    (hg : ∃ N, g ^ N ∈ Ideal.span (Set.range f)) :
    ∃ M', g ^ M' • s ∈ B := by
  -- `J` is the ideal of elements of `R` sending `s` into `B`.
  set J : Ideal R := Submodule.comap (LinearMap.toSpanSingleton R M s) B with hJdef
  have hJmem : ∀ a : R, a ∈ J ↔ a • s ∈ B := by
    intro a
    rw [hJdef, Submodule.mem_comap, LinearMap.toSpanSingleton_apply]
  -- Every generator `f i` lies in the radical of `J`.
  have hfi : ∀ i, f i ∈ J.radical := fun i =>
    Ideal.mem_radical_iff.mpr ⟨k i, (hJmem (f i ^ k i)).mpr (hJ i)⟩
  have hspan : Ideal.span (Set.range f) ≤ J.radical := by
    rw [Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact hfi i
  obtain ⟨N, hN⟩ := hg
  obtain ⟨m, hm⟩ := Ideal.mem_radical_iff.mp (hspan hN)
  refine ⟨N * m, ?_⟩
  rw [← pow_mul] at hm
  exact (hJmem _).mp hm

end Work.DSF1.Sheaf
