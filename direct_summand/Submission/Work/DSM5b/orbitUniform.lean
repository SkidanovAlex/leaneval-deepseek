import Mathlib
import Submission.Work.DSM5b.PerfComplexDefs
import Submission.Work.DSM5b.H0Defs
import Submission.Work.DSM5b.Basic
import Submission.Work.DSM5b.phiPC_properties
import Submission.Work.DSM5b.rootKillTransport
import Submission.Work.DSM5b.rootKillingFromZeroRoot
import Submission.Work.DSM5b.orbitKill
import Submission.Work.DSM5b.perfSupportKillingOfFinite
import Submission.Work.DSM5b.honestCohomologyFinite

/-!
# `Work.DSM5b.orbitUniform` — the uniform `T`-bound along the `φ`-orbit of a cycle

Let `R` be perfect of characteristic `p`, `t : ι → R` finite, `T ∈ R`, `t j₀ = T ^ e`, and let
`PCX p t ·`/`PCd p t ·` be the explicit perfected chart Čech complex
(`Submission.Work.DSM5b.PerfComplexDefs.lean`).

**The node of this file.**  Every positive-degree cycle `z` of `PCX p t ·` admits a *single*
exponent `N` bounding the killing of its whole `p`-power orbit:

    ∃ N, ∀ E, T ^ N • phiPow p t (n+1) E z ∈ LinearMap.range (PCd p t n).

This is the hypothesis of the orbit criterion `Work.DSM5b.orbitKill_of_uniformOrbit`, which turns
it into root killing of `PCX p t ·` at every level, and hence (via
`Work.DSM5b.rootKillingFromZeroRoot`) into `ϖ k`-killing of the perfected chart Čech complex of
the node M5b.

## Structure of the file

* `perfSupportKilling` — the *large* `E` part: some `E₀` and a single `N` with
  `T ^ N • φ^E z ∈ range (PCd p t n)` for all `E ≥ E₀`.  This is the genuinely mathematical input;
  its proof (see the docstring below) is "support over a finitely generated subring + Noetherian
  uniform honest killing", and it is *not* yet available in the workspace.
* `killExp_le_killExp_phi` — the elementary monotonicity `T ^ N • φ u ∈ B ⟹ T ^ N • u ∈ B`
  (for `u` a positive-degree element of the perfected complex), proved here from the semilinearity
  of `ψ` (`Work.DSM5b.Work.DSM5b.psi_smul`) and the identity `psi_phiPC`.
* `orbitUniform` — the node itself, obtained from `perfSupportKilling` by pushing the finitely many
  levels `E < E₀` back up to `E₀` with the monotonicity (induction on `E₀ - E`).

## Route to `perfSupportKilling`

1. **Support.**  Each component `z τ` of the cycle lies in the perfected chart ring
   `perfChartRing p t (tupRng τ)`, i.e. is a finite polynomial expression with coefficients in `R`
   in finitely many of the generators `y` with `y ^ (p ^ e) ∈ chartRing t (tupRng τ)`.  Hence there
   are finitely many elements `c : Fin m → R` such that, for `R₀ := Subring.closure (range t ∪
   {T} ∪ range c)`, all the components of `z` lie in the honest chart rings *over* `R₀` (read
   inside `R`'s chart localisations); this is the lemma `Work.DSM5b.perfSupport`.
2. **Noetherian case over `R₀`.**  `R₀` is generated by finitely many elements of the
   characteristic-`p` ring `R`, hence is a quotient of the polynomial ring `𝔽_p[X_1,…,X_m]`, hence
   Noetherian.  So `Work.DSM5b.honestKillCoordNoeth` applies over `↥R₀`: some `T ^ N₀` kills every
   positive-degree cycle of the honest chart complex of `(R₀, t)`.
3. **Transport.**  The honest chart complex over `↥R₀` maps to the subcomplex of `PCX p t ·` of
   the "`R₀`-generated" chart rings, by a chain map (compatible with the differentials because both
   are alternating sums of restriction maps between localisations of `↥R₀ → R`).  Hence the
   relations `T ^ N₀ • w = PCd (…)` hold in `PCX p t ·` as well.
4. **Large `E`.**  The elements `φ ^ E z` for `E ≫ 0` are honest over `R₀` (step 1), so step 3
   gives the claimed uniform bound with `N := N₀`.
-/

namespace Work.DSM5b

open Work.DSM5b.Work.DSM5b

universe a

variable (p : ℕ) [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p] [PerfectRing R p]
  {ι : Type a} [Finite ι] [DecidableEq ι] (t : ι → R)

/-- **The large-`E` uniform bound.**  For every positive-degree cycle `z` of the explicit perfected
chart Čech complex, the killed-ness of its `p`-power orbit `E ↦ φ^E z` is uniform in `E` for `E`
large:

    ∃ E₀ N, ∀ E ≥ E₀, T ^ N • phiPow p t (n+1) E z ∈ range (PCd p t n).

Proof route: `Work.DSM5b.perfSupport` produces a finitely generated (hence Noetherian) subring
`R₀ ⊆ R` carrying `t` and `T` such that the components of `φ ^ E z` are honest chart elements over
`R₀` for `E ≫ 0`; `Work.DSM5b.honestKillCoordNoeth` over `↥R₀` bounds the killing of *all* honest
cycles by one exponent; and the honest chart complex of `↥R₀` embeds as a subcomplex of
`PCX p t ·`. -/
theorem perfSupportKilling (T : R) (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = T ^ e) (n : ℕ)
    (z : PCX p t (n + 1)) (hz : PCd p t (n + 1) z = 0) :
    ∃ E₀ N : ℕ, ∀ E : ℕ, E₀ ≤ E →
      T ^ N • phiPow p t (n + 1) E z ∈ LinearMap.range (PCd p t n) :=
  perfSupportKillingOfFinite p t T j₀ e hj₀
    (fun A _ _ u _ _ _ _ q => honestCohomologyFinite u q) n z hz

/-- **Monotonicity of the killing exponent along the `φ`-orbit.**  For a positive-degree element
`u` of the perfected complex, a power of `T` that kills `φ u = u ^ p` also kills `u`.

Proof: apply the root map `ψ` (`Work.DSM5b.Work.DSM5b.psi`) to the relation `T ^ N • u ^ p = PCd y`.
By semilinearity `ψ (T ^ N • u ^ p) = (T ^ (1/p)) ^ N • u` (`psi_smul`, `psi_phiPC`), and `ψ`
commutes with `PCd` (`psi_PCd`); multiplying the resulting relation by the integral element
`(T ^ (1/p)) ^ ((p-1) * N)` produces `T ^ N • u ∈ range (PCd p t n)`. -/
theorem killExp_le_killExp_phi (T : R) (n : ℕ) (N : ℕ) (u : PCX p t (n + 1))
    (h : T ^ N • phiPC p t (n + 1) u ∈ LinearMap.range (PCd p t n)) :
    T ^ N • u ∈ LinearMap.range (PCd p t n) := by
  obtain ⟨y, hy⟩ := h
  -- apply the root map
  have key : (((frobeniusEquiv R p).symm) T) ^ N • u
      = PCd p t n (Work.DSM5b.Work.DSM5b.psi p t n y) := by
    have h2 := congrArg (Work.DSM5b.Work.DSM5b.psi p t (n + 1)) hy.symm
    rw [Work.DSM5b.Work.DSM5b.psi_smul, Work.DSM5b.Work.DSM5b.psi_phiPC,
      Work.DSM5b.Work.DSM5b.psi_PCd, map_pow] at h2
    exact h2
  have hpow : ((frobeniusEquiv R p).symm) T ^ p = T := by
    rw [← frobeniusEquiv_def]
    exact frobenius_apply_frobeniusEquiv_symm R p T
  have harith : (p - 1) * N + N = p * N := by
    calc (p - 1) * N + N = (p - 1) * N + 1 * N := by rw [one_mul]
      _ = ((p - 1) + 1) * N := by rw [add_mul]
      _ = p * N := by rw [Nat.sub_add_cancel (Fact.out : p.Prime).one_le]
  refine ⟨((frobeniusEquiv R p).symm) T ^ ((p - 1) * N)
    • Work.DSM5b.Work.DSM5b.psi p t n y, ?_⟩
  rw [map_smul, ← key, ← mul_smul, ← pow_add, harith, pow_mul, hpow]

/-- **Uniformity of the `T`-bound along the whole `φ`-orbit.**  From the large-`E` bound
(`perfSupportKilling`) one gets the same bound for *all* `E`, by pushing the finitely many small
levels up to `E₀` with `killExp_le_killExp_phi`. -/
theorem orbitUniform (T : R) (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = T ^ e) :
    ∀ (n : ℕ) (z : PCX p t (n + 1)), PCd p t (n + 1) z = 0 →
      ∃ N : ℕ, ∀ E : ℕ, T ^ N • phiPow p t (n + 1) E z ∈ LinearMap.range (PCd p t n) := by
  intro n z hz
  obtain ⟨E₀, N, hN⟩ := perfSupportKilling p t T j₀ e hj₀ n z hz
  refine ⟨N, fun E => ?_⟩
  -- push the small levels up to `E₀`
  have key : ∀ d : ℕ, ∀ E : ℕ, E + d = E₀ →
      T ^ N • phiPow p t (n + 1) E z ∈ LinearMap.range (PCd p t n) := by
    intro d
    induction d with
    | zero =>
      intro E hE
      have hEE : E = E₀ := by omega
      rw [hEE]
      exact hN E₀ le_rfl
    | succ d ih =>
      intro E hE
      have h1 : T ^ N • phiPow p t (n + 1) (E + 1) z ∈ LinearMap.range (PCd p t n) :=
        ih (E + 1) (by omega)
      rw [phiPow_succ] at h1
      exact killExp_le_killExp_phi p t T n N (phiPow p t (n + 1) E z) h1
  by_cases h : E ≤ E₀
  · exact key (E₀ - E) E (by omega)
  · exact hN E (by omega)

end Work.DSM5b
