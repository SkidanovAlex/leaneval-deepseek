import Mathlib

namespace Work.DSM5b

/-- Saturation lemma: if `t ∈ C` and `u` is a left inverse of `t` (`u * t = 1`),
then every element of the `R`-subalgebra generated by `C` and `u` becomes an
element of `C` after multiplication by a sufficiently high power of `t`.

The proof uses `Algebra.adjoin_induction` with the predicate
`fun x _ => ∃ J, t ^ J * x ∈ C`; it is closed under `algebraMap`, `+` (take the
max of the exponents) and `*` (take the sum of the exponents). -/
theorem adjoinUnitMulMem {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (C : Subalgebra R A) {u t : A} (ht : t ∈ C) (hut : u * t = 1)
    {y : A} (hy : y ∈ Algebra.adjoin R (↑C ∪ {u})) :
    ∃ J : ℕ, t ^ J * y ∈ C := by
  -- Monotonicity in the exponent: if `t ^ J * x ∈ C` then so is `t ^ K * x` for `K ≥ J`.
  have mono : ∀ {x : A} {J K : ℕ}, t ^ J * x ∈ C → J ≤ K → t ^ K * x ∈ C := by
    intro x J K h hJK
    have : t ^ K * x = t ^ (K - J) * (t ^ J * x) := by
      rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hJK]
    rw [this]
    exact C.mul_mem (C.pow_mem ht _) h
  have key : ∀ x ∈ Algebra.adjoin R (↑C ∪ {u}), ∃ J : ℕ, t ^ J * x ∈ C := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
        rcases hz with hzC | hzu
        · exact ⟨0, by simpa using hzC⟩
        · -- `z = u`: one power of `t` suffices, since `t * u = 1 ∈ C`.
          have hzu' : z = u := by simpa using hzu
          refine ⟨1, ?_⟩
          rw [hzu', pow_one, show t * u = 1 by rw [mul_comm]; exact hut]
          exact C.one_mem
    | algebraMap r =>
        exact ⟨0, by simp⟩
    | add a b _ _ iha ihb =>
        obtain ⟨J, hJ⟩ := iha
        obtain ⟨K, hK⟩ := ihb
        refine ⟨max J K, ?_⟩
        rw [mul_add]
        exact C.add_mem (mono hJ (Nat.le_max_left _ _)) (mono hK (Nat.le_max_right _ _))
    | mul a b _ _ iha ihb =>
        obtain ⟨J, hJ⟩ := iha
        obtain ⟨K, hK⟩ := ihb
        refine ⟨J + K, ?_⟩
        rw [show t ^ (J + K) * (a * b) = (t ^ J * a) * (t ^ K * b) by rw [pow_add]; ring]
        exact C.mul_mem hJ hK
  exact key y hy

end Work.DSM5b
