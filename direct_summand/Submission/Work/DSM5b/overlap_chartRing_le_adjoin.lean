import Mathlib
import Submission.Work.DSM5b.CycleDefs
import Submission.Work.DSM5b.chartRing_gen_mul_eq

namespace Work.DSM5b

open DSMap DSMap.Mix2

universe a

/-- **The overlap chart is generated by the `i`-chart together with `t i / t j`.**

File `Submission/Work/DSM5b/overlap_chartRing_le_adjoin.lean`, namespace `Work.DSM5b` (with
`universe a`); suggested imports: `Submission.Work.DSM5b.CycleDefs`,
`Submission.Work.DSM5b.chartRing_gen_mul_eq`.

Let `R` be a commutative ring, `t : ι → R`, `W_i = Localization.Away (tS t {i})`,
`W_ij = Localization.Away (tS t ({i} ∪ {j}))` and `chartRing t S ⊆ W_S` the blowup chart ring
`Algebra.adjoin R (chartGens t S)`, with `locRes t hST : W_i →ₐ[R] W_ij` the localisation map for
`hST : {i} ⊆ {i} ∪ {j}`.  If `w ∈ W_ij` satisfies `w * algebraMap R W_ij (t j)
= algebraMap R W_ij (t i)` (i.e. `w = t i / t j`), then the overlap chart ring is generated over `R`
by the image of the `i`-chart and by `w`.

Route: it suffices (`Algebra.adjoin_le_iff`) to show that every generator
`g ∈ chartGens t ({i} ∪ {j})` lies in `A := Algebra.adjoin R (Aij ∪ {w})`, where
`Aij := (chartRing t {i}).map (locRes t hST)`.  A generator comes with `m ∈ {i} ∪ {j}` and `k : ι`
with `g * algebraMap R W_ij (t m) = algebraMap R W_ij (t k)`.
* If `m = i`: use `Work.DSM5b.chartRing_gen_mul_eq t i k` to get `a ∈ chartRing t {i}` with
  `(a : W_i) * algebraMap R W_i (t i) = algebraMap R W_i (t k)`; then `locRes t hST a ∈ Aij` and
  `locRes t hST a * algebraMap R W_ij (t i) = algebraMap R W_ij (t k)
  = g * algebraMap R W_ij (t i)`; since `algebraMap R W_ij (t i)` is a unit in `W_ij` (`i ∈ {i} ∪ {j}`
  gives `t i ∣ tS t ({i} ∪ {j})`, use `IsLocalization.Away.isUnit_of_dvd` and
  `IsUnit.mul_right_cancel`), this gives `locRes t hST a = g`.
* If `m ≠ i` then `m = j`; the same `a` gives `g = (locRes t hST a) * w`: both sides times the unit
  `algebraMap R W_ij (t j)` agree, because `w * algebraMap R W_ij (t j) = algebraMap R W_ij (t i)`
  (`hw`) and `locRes t hST a * algebraMap R W_ij (t i) = algebraMap R W_ij (t k)`.

Do not use the frozen sorried declarations of `DSMap.Mix2`. -/
theorem overlap_chartRing_le_adjoin {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]
    (t : ι → R) (i j : ι)
    {w : Localization.Away (DSMap.Mix2.tS t ({i} ∪ {j}))}
    (hw : w * algebraMap R (Localization.Away (DSMap.Mix2.tS t ({i} ∪ {j}))) (t j)
        = algebraMap R (Localization.Away (DSMap.Mix2.tS t ({i} ∪ {j}))) (t i)) :
    DSMap.Mix2.chartRing t ({i} ∪ {j})
      ≤ Algebra.adjoin R (((DSMap.Mix2.chartRing t {i}).map
            (DSMap.Mix2.locRes t (Finset.subset_union_left : ({i} : Finset ι) ⊆ {i} ∪ {j}))
          : Set (Localization.Away (DSMap.Mix2.tS t ({i} ∪ {j})))) ∪ {w}) := by
  set hST : ({i} : Finset ι) ⊆ {i} ∪ {j} := Finset.subset_union_left
  have hunit_i : IsUnit (algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t i)) :=
    IsLocalization.Away.isUnit_of_dvd (tS t ({i} ∪ {j})) (r := t i)
      (Finset.dvd_prod_of_mem t (Finset.mem_union_left _ (Finset.mem_singleton_self i)))
  have hunit_j : IsUnit (algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t j)) :=
    IsLocalization.Away.isUnit_of_dvd (tS t ({i} ∪ {j})) (r := t j)
      (Finset.dvd_prod_of_mem t (Finset.mem_union_right _ (Finset.mem_singleton_self j)))
  change Algebra.adjoin R (chartGens t ({i} ∪ {j}))
    ≤ Algebra.adjoin R (((chartRing t {i}).map (locRes t hST) : Set
        (Localization.Away (tS t ({i} ∪ {j})))) ∪ {w})
  rw [Algebra.adjoin_le_iff]
  intro g hg
  obtain ⟨m, hm, k, hk⟩ := hg
  obtain ⟨u, hu⟩ := chartRing_gen_mul_eq (R := R) t i k
  have hkey : locRes t hST (u : Localization.Away (tS t {i}))
        * algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t i)
      = algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t k) := by
    have h2 := congrArg (locRes t hST) hu
    simpa only [map_mul, AlgHom.commutes] using h2
  have hu_mem : locRes t hST (u : Localization.Away (tS t {i}))
      ∈ Algebra.adjoin R (((chartRing t {i}).map (locRes t hST) : Set
          (Localization.Away (tS t ({i} ∪ {j})))) ∪ {w}) :=
    Algebra.subset_adjoin (Or.inl (Subalgebra.mem_map.mpr ⟨u, u.2, rfl⟩))
  have hw_mem : w ∈ Algebra.adjoin R (((chartRing t {i}).map (locRes t hST) : Set
      (Localization.Away (tS t ({i} ∪ {j})))) ∪ {w}) :=
    Algebra.subset_adjoin (Or.inr (Set.mem_singleton w))
  by_cases hmi : m = i
  · have hgen : g * algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t i)
        = algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t k) := by
      simpa [hmi] using hk
    have hga : g = locRes t hST (u : Localization.Away (tS t {i})) := by
      apply IsUnit.mul_right_cancel hunit_i
      rw [hgen, hkey]
    rw [hga]
    exact hu_mem
  · have hmj : m = j := by
      rcases Finset.mem_union.mp hm with h | h
      · exact absurd (Finset.mem_singleton.mp h) hmi
      · exact Finset.mem_singleton.mp h
    have hgen : g * algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t j)
        = algebraMap R (Localization.Away (tS t ({i} ∪ {j}))) (t k) := by
      simpa [hmj] using hk
    have hga : g = locRes t hST (u : Localization.Away (tS t {i})) * w := by
      apply IsUnit.mul_right_cancel hunit_j
      rw [hgen, mul_assoc, hw, hkey]
    rw [hga]
    exact Subalgebra.mul_mem _ hu_mem hw_mem

end Work.DSM5b
