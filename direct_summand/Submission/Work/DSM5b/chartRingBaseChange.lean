import Mathlib
import Submission.Work.DSM5b.honestKillFlat
import Submission.Work.DSM5b.H0Defs

/-!
# Base change of the blowup chart ring `R₀[J/t_S] → R[J/t_S]`

Let `R₀ → R` be a ring homomorphism (`Algebra R₀ R`), `t : ι → R₀` a family of elements and
`S : Finset ι`.  Write `b i = algebraMap R₀ R (t i)` for the base-changed family,
`R₀_{t_S} = Localization.Away (tS t S)`, `R_{t_S} = Localization.Away (tS b S)` and
`locBC t S : R₀_{t_S} →ₐ[R₀] R_{t_S}` for the base-change map of the two localisations
(`Work.DSM5b.locBC`).  The claim proved here is that the blowup chart ring over `R` is generated,
as an `R`-module, by the image of the chart ring over `R₀`:

`x ∈ R[J/t_S]  ↔  x ∈ R-span (locBC '' R₀[J/t_S])`.

This is the `chartRing` case of the base-change comparison recorded in the header of
`Submission/Work/DSM5b/honestKillFlat.lean` (item 1 of "What remains" there).

The proof has two ingredients.

* `chartGens_baseChange` — the **generators** base change: a generator of the chart of the
  base-changed family is `y` with `y * algebraMap (b i) = algebraMap (b k)` for some `i ∈ S`; then
  `algebraMap (b i)` is a *unit* of `R_{t_S}` (it divides the inverted denominator `∏_{j∈S} b j`),
  so `y = algebraMap (b k) * (algebraMap (b i))⁻¹`, and this is the image under `locBC` of the
  over-`R₀` generator `(t k)/(t i)` of `R₀[J/t_S]` (which is constructed with the unit
  `algebraMap (t i)` of `R₀_{t_S}` and is characterised by exactly the same equation).  The reverse
  inclusion is `Work.DSM5b.locBC_chartGens`.  Hence
  `chartGens b S = locBC t S '' chartGens t S` and, since `chartRing` is *defined* as the adjoin of
  `chartGens`,
  `(chartRing t S).map (locBC t S) = Algebra.adjoin R₀ (locBC t S '' chartGens t S)`
  (`AlgHom.map_adjoin`, used in the theorem below).
* `span_adjoin_eq_adjoin_of_tower` — the general algebra fact that for a tower `A → B → M` and
  `Z ⊆ M`, the `B`-span of the `A`-subalgebra generated by `Z` is the `B`-subalgebra generated by
  `Z`.

Both statements are general-purpose and are kept as named lemmas.
-/

namespace Work.DSM5b

universe a u v w

/-- For an algebra tower `A → B → M` and a subset `Z ⊆ M`, the `B`-span of the `A`-subalgebra
generated by `Z` is the `B`-subalgebra generated by `Z`, viewed as a `B`-submodule of `M`.

(The `⊇` direction only uses that a `B`-subalgebra contains the image of `A`; for the `⊆` direction
one uses that `Z` generates the `A`-adjoin, so its `B`-span is closed under multiplication:
`span B ↑(adjoin A Z) ⊇ adjoin B (↑(adjoin A Z)) = adjoin B Z`.) -/
theorem span_adjoin_eq_adjoin_of_tower {A : Type u} {B : Type v} {M : Type w}
    [CommRing A] [CommRing B] [CommRing M] [Algebra A B] [Algebra B M] [Algebra A M]
    [IsScalarTower A B M] (Z : Set M) :
    Submodule.span B (↑(Algebra.adjoin A Z) : Set M) = Subalgebra.toSubmodule (Algebra.adjoin B Z) := by
  have hAZ : (Algebra.adjoin A Z : Set M) ⊆ (Algebra.adjoin B Z : Set M) := by
    change (Subsemiring.closure (Set.range (algebraMap A M) ∪ Z) : Set M) ⊆
      (Subsemiring.closure (Set.range (algebraMap B M) ∪ Z) : Set M)
    intro x hx
    refine Subsemiring.closure_mono ?_ hx
    rintro y (hy | hy)
    · obtain ⟨c, rfl⟩ := hy
      refine Or.inl ⟨algebraMap A B c, ?_⟩
      rw [IsScalarTower.algebraMap_eq A B M]
      rfl
    · exact Or.inr hy
  refine le_antisymm ?_ ?_
  · rw [Submodule.span_le]
    exact hAZ
  · rw [← Algebra.adjoin_adjoin_of_tower A Z, Algebra.adjoin_eq_span, Submodule.span_le]
    intro x hx
    exact Submodule.subset_span (Submonoid.closure_le.mpr (fun y hy => hy) hx)

section BaseChange
variable {R₀ : Type a} [CommRing R₀] {R : Type a} [CommRing R] [Algebra R₀ R]
variable {ι : Type a} [DecidableEq ι]

/-- **The generators of the blowup chart base change.**  For `b = fun i => algebraMap R₀ R (t i)`,
a fraction `t_k / t_i` of the chart of `t` over `R₀` (`i ∈ S`, `k` arbitrary) maps under `locBC` to
the corresponding fraction of the chart of `b` over `R`, and conversely every generator of
`chartGens b S` is such an image; so the two sets of generators are in bijection along `locBC`. -/
lemma chartGens_baseChange (t : ι → R₀) (S : Finset ι) :
    DSMap.Mix2.chartGens (fun i => algebraMap R₀ R (t i)) S
      = Work.DSM5b.locBC (R := R) t S '' DSMap.Mix2.chartGens t S := by
  ext x
  constructor
  · rintro ⟨i, hi, k, hk⟩
    obtain ⟨u, hu⟩ := Work.DSM5b.isUnit_algebraMap_mem_self t S hi
    let y : Localization.Away (DSMap.Mix2.tS t S) := algebraMap R₀ _ (t k) * ↑u⁻¹
    have hyeq : y * algebraMap R₀ (Localization.Away (DSMap.Mix2.tS t S)) (t i)
        = algebraMap R₀ (Localization.Away (DSMap.Mix2.tS t S)) (t k) := by
      change algebraMap R₀ (Localization.Away (DSMap.Mix2.tS t S)) (t k) * ↑u⁻¹
          * algebraMap R₀ (Localization.Away (DSMap.Mix2.tS t S)) (t i)
        = algebraMap R₀ (Localization.Away (DSMap.Mix2.tS t S)) (t k)
      rw [mul_assoc, ← hu, Units.inv_mul, mul_one]
    have hy : y ∈ DSMap.Mix2.chartGens t S := ⟨i, hi, k, hyeq⟩
    refine ⟨y, hy, ?_⟩
    have hunit : IsUnit (algebraMap R (Localization.Away
        (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S))
        ((fun i => algebraMap R₀ R (t i)) i)) := Work.DSM5b.isUnit_algebraMap_mem t S hi
    refine IsUnit.mul_right_cancel hunit ?_
    have h1 := congrArg (Work.DSM5b.locBC (R := R) t S) hyeq
    simp only [map_mul, Work.DSM5b.locBC_algebraMap] at h1
    rw [hk]
    rw [← IsScalarTower.algebraMap_apply R₀ R
        (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)) (t i),
      ← IsScalarTower.algebraMap_apply R₀ R
        (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)) (t k)]
    exact h1
  · rintro ⟨y, hy, rfl⟩
    exact Work.DSM5b.locBC_chartGens t S hy

end BaseChange

theorem chartRingBaseChange {R₀ : Type a} [CommRing R₀] {R : Type a} [CommRing R] [Algebra R₀ R] {ι : Type a} [DecidableEq ι] (t : ι → R₀) (S : Finset ι) (x : Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)) :
    (x ∈ DSMap.Mix2.chartRing (fun i => algebraMap R₀ R (t i)) S) ↔
      (x ∈ Submodule.span R (((DSMap.Mix2.chartRing t S).map (Work.DSM5b.locBC (R := R) t S) : Set _))) := by
  have hmap : ((DSMap.Mix2.chartRing t S).map (Work.DSM5b.locBC (R := R) t S) :
      Set (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)))
      = ↑(Algebra.adjoin R₀
        (Work.DSM5b.locBC (R := R) t S '' DSMap.Mix2.chartGens t S)) := by
    rw [DSMap.Mix2.chartRing, AlgHom.map_adjoin]
  rw [hmap, DSMap.Mix2.chartRing, chartGens_baseChange (R := R) t S,
    span_adjoin_eq_adjoin_of_tower (A := R₀) (B := R)
      (Z := Work.DSM5b.locBC (R := R) t S '' DSMap.Mix2.chartGens t S)]
  simp

end Work.DSM5b
