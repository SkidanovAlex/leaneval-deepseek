/-
# The graded-module structure of the Rees module

The Rees module `reesM t = ⨁_d J^d` (realised inside `R[u]` as the range of `reesPhi t`, see
`Submission/Work/DSM5b/HCF/ReesDefs.lean`) carries the grading `reesGr t d = {c u^d : c ∈ J^d}`.
Here we record the compatibility of the `R[X_0,…,X_{n-1}]`-action with this grading and the fact
that the Rees module is generated by `1` over `R[X_0,…,X_{n-1}]` (hence finitely generated).
-/
import Mathlib
import Submission.Work.DSM5b.HCF.ReesDefs

open MvPolynomial Polynomial

namespace Work.DSM5b.HCF

universe u

variable {R : Type u} [CommRing R] {n : ℕ}

/-- **The Rees module is a graded module**: multiplying an element of the `j`-th piece by a form
of degree `i` lands in the `(i+j)`-th piece. -/
theorem reesGr_gradedSMul (t : Fin n → R) :
    SetLike.GradedSMul (Work.DSCOH.homSub R n) (reesGr t) where
  smul_mem := by
    intro i j ai fj hai hfj
    obtain ⟨f, hf, hfe⟩ := mem_reesGr.mp hfj
    refine mem_reesGr.mpr ⟨ai * f, SetLike.mul_mem_graded hai hf, ?_⟩
    show reesPhi t (ai * f) = (ai • fj).1
    rw [reesM_smul_coe, map_mul, hfe]

attribute [instance] reesGr_gradedSMul

/-- **The Rees module is generated by `1` over `R[X_0,…,X_{n-1}]`**, hence is a finitely generated
module: the evaluation map `f ↦ f • 1` is surjective onto the range of the Rees map. -/
theorem reesM_finite (t : Fin n → R) :
    Module.Finite (Work.DSCOH.Poly R n) (↥(reesM t)) := by
  refine Module.Finite.of_surjective
    ({ toFun := fun f => f • reesGen t
       map_add' := fun f g => by
         rw [add_smul]
       map_smul' := fun a f => by
         rw [smul_assoc, RingHom.id_apply] } : Work.DSCOH.Poly R n →ₗ[Work.DSCOH.Poly R n]
        ↥(reesM t)) ?_
  intro x
  obtain ⟨f, hf⟩ := mem_reesM.mp x.2
  refine ⟨f, Subtype.ext ?_⟩
  show reesPhi t f * (reesGen t).1 = x.1
  rw [reesGen_coe, mul_one, hf]

end Work.DSM5b.HCF
