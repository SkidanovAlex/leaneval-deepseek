import Mathlib
import Submission.Work.DSM5b.HCF.ReesGraded
import Submission.Work.DSM5b.H0Defs
import Submission.Work.DSCOH.resAt_degZero
import Submission.Work.DSM5b.HCF.reesDegZeroAux
import Submission.Work.DSM5b.HCF.reesDegZeroMap
namespace Work.DSM5b.HCF

universe u

section Natural

variable {n : ℕ} {R : Type u} [CommRing R] (t : Fin n → R)
open DSMap DSMap.Mix DSMap.Mix2

/-- **Naturality of the value map with respect to the restriction maps.** -/
lemma chiC_natural {S T : Finset (ULift.{u} (Fin n))} (hST : S ⊆ T)
    (x : ↥(Work.DSCOH.degZero (A := R) (n := n) (M := ↥(reesM t)) (reesGr t)
      (S.image ULift.down))) :
    chiC t T ⟨Work.DSCOH.resAt (A := R) (n := n) (M := ↥(reesM t))
        (Finset.image_subset_image (f := ULift.down) hST) x.1,
      Work.DSCOH.resAt_degZero (A := R) (n := n) (M := ↥(reesM t)) (ℳ := reesGr t)
        (Finset.image_subset_image (f := ULift.down) hST) x.1 x.2⟩ =
      Work.DSM5b.rhoH (tU t) hST (chiC t S x) := by
  obtain ⟨k, m, hm, hx⟩ := Work.DSCOH.degZero_exists_repr (A := R) (n := n)
    (M := ↥(reesM t)) (reesGr t) (S.image ULift.down) x.2
  have hres : (Work.DSCOH.resAt (A := R) (n := n) (M := ↥(reesM t))
      (Finset.image_subset_image (f := ULift.down) hST) x.1) =
      Work.DSCOH.divPow (A := R) (n := n) (M := ↥(reesM t)) (T.image ULift.down) k
        (Work.DSCOH.toLoc (A := R) (n := n) (M := ↥(reesM t)) (T.image ULift.down)
          ((Work.DSCOH.monomial (A := R) (T.image ULift.down \ S.image ULift.down)) ^ k • m)) := by
    rw [hx, Work.DSCOH.resAt_divPow_toLoc]
  have hmemT : ((Work.DSCOH.monomial (A := R) (T.image ULift.down \ S.image ULift.down)) ^ k) • m
      ∈ reesGr t (k * (T.image ULift.down).card) := by
    have h1 : ((Work.DSCOH.monomial (A := R) (T.image ULift.down \ S.image ULift.down)) ^ k)
        ∈ Work.DSCOH.homSub R n (k * (T.image ULift.down \ S.image ULift.down).card) := by
      rw [Work.DSCOH.homSub]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (isHomog_monomial_pow _ k)
    have h2 := SetLike.GradedSMul.smul_mem h1 hm
    rwa [show k * (T.image ULift.down \ S.image ULift.down).card +ᵥ k * (S.image ULift.down).card
        = k * (T.image ULift.down).card from by
      rw [vadd_eq_add, ← Nat.mul_add,
        Finset.card_sdiff_add_card_eq_card (Finset.image_subset_image (f := ULift.down) hST)]] at h2
  apply Subtype.ext
  rw [chiC_coe, Work.DSM5b.rhoH_coe, chiC_coe, chiR_apply_mk t T _ hmemT hres,
    chiR_apply_mk t S x hm hx]
  have hnum : reesEps R
      (((Work.DSCOH.monomial (A := R) (T.image ULift.down \ S.image ULift.down)) ^ k • m).1)
      = (DSMap.Mix2.tS (tU t) (T \ S)) ^ k * reesEps R m.1 := by
    rw [Work.DSM5b.HCF.reesM_smul_coe, map_mul, reesEps_reesPhi_monomial_pow, tS_tU t,
      image_sdiff_down S T]
  rw [hnum]
  rw [show DSMap.Mix2.locRes (tU t) hST (chartVal t S k (reesEps R m.1)) =
      IsLocalization.mk' (chartLoc t T)
        (reesEps R m.1 * (DSMap.Mix2.tS (tU t) (T \ S)) ^ k)
        ⟨(DSMap.Mix2.tS (tU t) T) ^ k, Submonoid.pow_mem _ (Submonoid.mem_powers _) k⟩ from
    Work.DSM5b.HCF.locRes_away_mk (tU t) hST (reesEps R m.1) k]
  rw [chartVal]
  congr 1
  ring

end Natural

/-- **The degree-zero part of the chart localisation of the Rees module is the chart ring of the
blow-up.**  `R` is a commutative ring, `t : Fin n → R`, `J = reesJ t = Ideal.span (Set.range t)`,
`reesM t = range (reesPhi t) ⊆ R[u]` (`X_i ↦ t_i u`) with its grading `reesGr t d = {c u^d : c ∈ J^d}`
and its `R[X_0,…,X_{n-1}]`-module structure.  For every finite subset `S ⊆ ULift.{u} (Fin n)`
there is an `R`-linear isomorphism between the degree-zero part of the chart localisation of the
Rees module at `S.image ULift.down` and the chart ring
`R[J/t_S] = Work.DSM5b.chartRing (fun i => t i.down) S ⊆ R_{t_S}` (the `R`-subalgebra generated by
the fractions `t_i/t_j`), and these isomorphisms are compatible with the restriction maps
`Work.DSCOH.resAt` on the left and `Work.DSM5b.rhoH` on the right.

Route (mimics `Work.DSEQP.DZA.gf_degzero_away`/`toAway` in the workspace, which does the same for
`M = A[x_0,…,x_N]` and states the result for `HomogeneousLocalization.Away`):
* a representative of `x ∈ degZero (reesGr t) S'` is `m / X_S^k` with `m ∈ reesGr t (k · |S'|)`, i.e.
  `m = C c * X^{k|S|}` with `c ∈ J^{k|S|}` (`degZero_exists_repr` + the description of the pieces);
  define the value of `x` to be `c/t_S^k` in `Localization.Away (tS t S)`;
* well-definedness: if two representatives represent the same element of the localisation, then
  `u • (X_S^{k'} • m - X_S^k • m') = 0` for some `u ∈ subS S` (`LocalizedModule.mk_eq`); writing
  `u = ∏ X_i^{e_i}` (`lmb_subS_eq_xpow`) and taking the `u^{...}`-coefficient in `R[u]` gives
  `∏ t_i^{e_i} · (t_S^{k'}c - t_S^k c') = 0`, hence `t_S^N (t_S^{k'}c - t_S^k c') = 0` with
  `N = ∑ e_i`, i.e. equal fractions in `R_{t_S}`;
* the map is injective (a vanishing fraction is killed by a power of `t_S`, hence the corresponding
  localised element is zero) and its image is the subalgebra spanned by the `c/t_S^k`, which
  coincides with `chartRing t' S` generated by the fractions `t_k/t_i`;
* naturality is a computation on representatives using `Work.DSCOH.resAt_divPow_toLoc` and the
  compatibility of `rhoH` with the localisation maps. -/
theorem reesDegZero {n : ℕ} {R : Type u} [CommRing R] (t : Fin n → R) :
    ∃ e : ∀ S : Finset (ULift.{u} (Fin n)),
      ↥(Work.DSCOH.degZero (A := R) (n := n) (M := ↥(Work.DSM5b.HCF.reesM t))
          (Work.DSM5b.HCF.reesGr t) (S.image ULift.down)) ≃ₗ[R]
        ↥(DSMap.Mix2.chartRing (fun i : ULift.{u} (Fin n) => t i.down) S),
      ∀ (S T : Finset (ULift.{u} (Fin n))) (hST : S ⊆ T)
        (x : ↥(Work.DSCOH.degZero (A := R) (n := n) (M := ↥(Work.DSM5b.HCF.reesM t))
          (Work.DSM5b.HCF.reesGr t) (S.image ULift.down))),
        e T ⟨Work.DSCOH.resAt (A := R) (n := n) (M := ↥(Work.DSM5b.HCF.reesM t))
            (Finset.image_subset_image (f := ULift.down) hST) x.1,
          Work.DSCOH.resAt_degZero (A := R) (n := n) (M := ↥(Work.DSM5b.HCF.reesM t))
            (ℳ := Work.DSM5b.HCF.reesGr t) (Finset.image_subset_image (f := ULift.down) hST)
            x.1 x.2⟩ =
          Work.DSM5b.rhoH (fun i : ULift.{u} (Fin n) => t i.down) hST (e S x) := by
  refine ⟨fun S => LinearEquiv.ofBijective (chiC t S)
    ⟨chiC_injective t S, chiC_surjective t S⟩, ?_⟩
  intro S T hST x
  exact chiC_natural t hST x

end Work.DSM5b.HCF
