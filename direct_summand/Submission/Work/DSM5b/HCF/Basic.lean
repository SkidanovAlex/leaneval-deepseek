import Mathlib
import Submission.Work.DSM5b.H0Defs
import Submission.Work.DSM5b.HCd_comp

/-!
# HCF — the honest (tuple-indexed) Čech complex of a *coefficient system*

The target `Work.DSM5b.honestCohomologyFinite` concerns the honest chart Čech complex in
coordinates, `HCX t m = ∀ τ : Fin (m+1) → ι, chartRing t (tupRng τ)`, together with its
differential `HCd`.  The mathematical content is that this (unnormalised) Čech complex of the
chart cover of `Bl_J (Spec R)` has finitely generated cohomology in positive degrees.

To compare it with the *normalised* (subset-indexed, alternating) complex — whose cohomology is
known to be finitely generated by `Work.DSCOH.chartCech_finite_vanishing` — it is convenient to
work with an abstract *coefficient system*: a functor from the poset of finite subsets of `ι` to
`R`-modules.  The chart rings `chartRing t S` together with `rhoH` form the main example; the
quotient systems arising in the induction are further examples.

This file contains

* `Work.DSM5b.CoeffSys` — the structure of a coefficient system;
* `Work.DSM5b.chartCoeff` — the chart-ring coefficient system;
* `Work.DSM5b.CoeffSys.Htc`, `CoeffSys.htcD` — the tuple complex and its differential;
* `CoeffSys.htcD_comp` — `d² = 0`.
-/

namespace Work.DSM5b

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2

universe a

variable {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]

/-- A **coefficient system** on the finite subsets of `ι`: an `R`-module `M S` for every
`S : Finset ι`, together with functorial restriction maps `res h : M S →ₗ[R] M T` for `h : S ⊆ T`. -/
structure CoeffSys (R : Type a) [CommRing R] (ι : Type a) [DecidableEq ι] where
  M : Finset ι → Type a
  [inst₁ : ∀ S, AddCommGroup (M S)]
  [inst₂ : ∀ S, Module R (M S)]
  res : ∀ ⦃S T : Finset ι⦄, S ⊆ T → M S →ₗ[R] M T
  res_self : ∀ S, res (le_refl S) = LinearMap.id
  res_comp : ∀ ⦃S T V : Finset ι⦄ (h₁ : S ⊆ T) (h₂ : T ⊆ V),
    (res h₂).comp (res h₁) = res (h₁.trans h₂)

attribute [instance] CoeffSys.inst₁ CoeffSys.inst₂

namespace CoeffSys

variable (𝒜 : CoeffSys R ι)

lemma res_self_apply {S : Finset ι} (x : 𝒜.M S) : 𝒜.res (le_refl S) x = x := by
  rw [𝒜.res_self S]; rfl

lemma res_comp_apply {S T V : Finset ι} (h₁ : S ⊆ T) (h₂ : T ⊆ V) (x : 𝒜.M S) :
    𝒜.res h₂ (𝒜.res h₁ x) = 𝒜.res (h₁.trans h₂) x := by
  rw [← LinearMap.comp_apply, 𝒜.res_comp]

/-- The restriction maps depend on the inclusion only through the inclusion (proof irrelevance). -/
lemma res_congr {S T : Finset ι} {h h' : S ⊆ T} (x : 𝒜.M S) : 𝒜.res h x = 𝒜.res h' x := by
  rw [Subsingleton.elim h h']

variable {𝒜}

/-- The `q`-th term of the honest (tuple-indexed, unnormalised) Čech complex of a coefficient
system: the product, over all tuples `τ : Fin (q+1) → ι`, of the coefficients at the range. -/
abbrev Htc (m : ℕ) : Type a := ∀ τ : Fin (m + 1) → ι, 𝒜.M (tupRng τ)

/-- The differential of the honest tuple complex. -/
noncomputable def htcD (m : ℕ) : 𝒜.Htc m →ₗ[R] 𝒜.Htc (m + 1) where
  toFun z := fun τ => ∑ i : Fin (m + 2),
    ((-1 : R) ^ ((i : ℕ))) • 𝒜.res (tupRng_del_subset i τ) (z (tupDel i τ))
  map_add' z z' := by
    funext τ
    simp only [Pi.add_apply, map_add, smul_add, Finset.sum_add_distrib]
  map_smul' r z := by
    funext τ
    simp only [Pi.smul_apply, RingHom.id_apply, map_smul, smul_comm _ r, Finset.smul_sum]

@[simp] lemma htcD_apply (m : ℕ) (z : 𝒜.Htc m) (τ : Fin (m + 2) → ι) :
    𝒜.htcD m z τ = ∑ i : Fin (m + 2),
      ((-1 : R) ^ ((i : ℕ))) • 𝒜.res (tupRng_del_subset i τ) (z (tupDel i τ)) := rfl

/-- The summand of the double sum `∑_i ∑_j …` indexed by a pair of deleted coordinates. -/
noncomputable def htcHdTerm {m : ℕ} (τ : Fin (m + 3) → ι) (z : 𝒜.Htc m)
    (p : Fin (m + 3) × Fin (m + 2)) : 𝒜.M (tupRng τ) :=
  (-1 : R) ^ ((p.1 : ℕ) + (p.2 : ℕ)) •
    (𝒜.res (tupRng_del_subset p.1 τ)) ((𝒜.res (tupRng_del_subset p.2 (tupDel p.1 τ)))
      (z (tupDel p.2 (tupDel p.1 τ))))

/-- A restriction of `z` at a tuple depends only on the tuple, not on the proof of the
inclusion of its range. -/
lemma htc_res_del_congr {m : ℕ} {S : Finset ι} {A B : Fin (m + 1) → ι} (hAB : A = B)
    (z : 𝒜.Htc m) {hA : tupRng A ⊆ S} {hB : tupRng B ⊆ S} :
    𝒜.res hA (z A) = 𝒜.res hB (z B) := by
  cases hAB
  exact 𝒜.res_congr (z A)

/-- The value of the summand is insensitive to the order in which the two coordinates are
deleted. -/
lemma htcHdTerm_eq {m : ℕ} (τ : Fin (m + 3) → ι) (z : 𝒜.Htc m)
    (i : Fin (m + 3)) (j : Fin (m + 2)) :
    (𝒜.res (tupRng_del_subset i τ)) ((𝒜.res (tupRng_del_subset j (tupDel i τ)))
        (z (tupDel j (tupDel i τ))))
      = (𝒜.res (tupRng_del_subset (i.succAbove j) τ))
          ((𝒜.res (tupRng_del_subset (j.predAbove i) (tupDel (i.succAbove j) τ)))
          (z (tupDel (j.predAbove i) (tupDel (i.succAbove j) τ)))) := by
  rw [𝒜.res_comp_apply, 𝒜.res_comp_apply]
  exact htc_res_del_congr (HCd_tupDel_swap i j τ) z

/-- **`d² = 0`** for the honest tuple complex of a coefficient system.  The proof is the standard
cosimplicial computation: the double sum over the index pair `(i, j)` of deleted coordinates is
paired by the fixed-point-free involution `(i,j) ↦ (i.succAbove j, j.predAbove i)` whose two
terms carry opposite signs. -/
theorem htcD_comp (m : ℕ) : (𝒜.htcD (m + 1)).comp (𝒜.htcD m) = 0 := by
  classical
  apply LinearMap.ext
  intro z
  funext τ
  rw [LinearMap.comp_apply, LinearMap.zero_apply]
  rw [htcD_apply]
  have hinner : ∀ i : Fin (m + 3),
      (𝒜.res (tupRng_del_subset i τ)) (𝒜.htcD m z (tupDel i τ))
        = ∑ j : Fin (m + 2), (-1 : R) ^ (j : ℕ) •
            (𝒜.res (tupRng_del_subset i τ)) ((𝒜.res (tupRng_del_subset j (tupDel i τ)))
              (z (tupDel j (tupDel i τ)))) := by
    intro i
    rw [htcD_apply, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, 𝒜.res_comp_apply]
  trans ∑ i : Fin (m + 3), ∑ j : Fin (m + 2), 𝒜.htcHdTerm τ z (i, j)
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [hinner i, Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← mul_smul, ← pow_add]
    simp only [htcHdTerm]
  · rw [← Fintype.sum_prod_type]
    refine Finset.sum_involution (s := (Finset.univ : Finset (Fin (m + 3) × Fin (m + 2))))
      (g := fun p _ => (p.1.succAbove p.2, p.2.predAbove p.1)) ?_ ?_ ?_ ?_
    · rintro ⟨i, j⟩ -
      show 𝒜.htcHdTerm τ z (i, j) + 𝒜.htcHdTerm τ z (i.succAbove j, j.predAbove i) = 0
      simp only [htcHdTerm]
      rw [htcHdTerm_eq τ z i j]
      rw [← add_smul, HCd_sign_pair (R := R) i j, zero_smul]
    · rintro ⟨i, j⟩ - _ h
      exact Fin.succAbove_ne i j (congrArg Prod.fst h)
    · intro p _
      exact Finset.mem_univ _
    · rintro ⟨i, j⟩ -
      show ((i.succAbove j).succAbove (j.predAbove i), (j.predAbove i).predAbove (i.succAbove j))
        = (i, j)
      rw [Fin.succAbove_succAbove_predAbove i j, Fin.predAbove_predAbove_succAbove i j]

end CoeffSys

/-- The **chart-ring coefficient system**: `S ↦ chartRing t S`, with the restriction maps `rhoH`. -/
noncomputable def chartCoeff (t : ι → R) : CoeffSys R ι where
  M := fun S => chartRing t S
  res := fun {_ _} h => (rhoH t h).toLinearMap
  res_self := by
    intro S
    ext x
    simp only [AlgHom.toLinearMap_apply, LinearMap.id_apply, rhoH_coe]
    exact DFunLike.congr_fun
      (locRes_eq t (le_refl S) (AlgHom.id R (Localization.Away (tS t S)))).symm x.1
  res_comp := by
    intro S T V h₁ h₂
    ext x
    simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, rhoH_coe]
    exact congrArg Subtype.val (HCd_rhoH_comp (t := t) h₁ h₂ x)

end Work.DSM5b
