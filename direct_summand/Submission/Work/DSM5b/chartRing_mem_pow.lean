import Mathlib
import Submission.Work.DSM5b.CycleDefs

/-!
# DSM5b — the chart ring consists of fractions `a / t_S ^ n` with `a ∈ J ^ n`

Let `R` be a commutative ring, `t : ι → R` a family of elements, `J = (t_i)` the ideal they
generate and `S : Finset ι`.  Write `t_S = ∏_{i∈S} t_i` and

`R[J/t_S] ⊆ R_{t_S}`

for the blowup chart ring `DSMap.Mix2.chartRing t S`, i.e. the `R`-subalgebra of
`Localization.Away (tS t S)` generated by the fractions `t_k / t_i` (`i ∈ S`).

The content of this file is that every element of the chart ring is of the form `a / t_S ^ n`
with `a ∈ J ^ n`:

`∀ z ∈ R[J/t_S], ∃ n a, a ∈ J ^ n ∧ z = a / t_S ^ n`   (i.e. `z · t_S ^ n = a` in `R_{t_S}`).

This is the elementary description of the degree-`0` part of the localised Rees algebra: the
generators `t_k / t_i` satisfy `(t_k / t_i) · t_S = t_k · ∏_{j ∈ S \ {i}} t_j ∈ J`, and the
property `z · t_S ^ n ∈ J ^ n` is closed under multiplication and — thanks to `t_S ∈ J` when
`S ≠ ∅` — under addition with `n := n₁ + n₂`.  The degenerate case `S = ∅` is handled
separately: then `chartGens t ∅ = ∅` and `chartRing t ∅ = ⊥`.
-/

namespace Work.DSM5b

open DSMap DSMap.Mix2

universe a

theorem chartRing_mem_pow {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]
    (t : ι → R) (S : Finset ι) (z : ↥(DSMap.Mix2.chartRing t S)) :
    ∃ (n : ℕ) (a : R), a ∈ (Ideal.span (Set.range t)) ^ n ∧
      algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) a =
        (algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) (DSMap.Mix2.tS t S)) ^ n *
          (z : Localization.Away (DSMap.Mix2.tS t S)) := by
  classical
  by_cases hS : S = ∅
  · -- degenerate chart: `chartRing t ∅ = ⊥`
    subst hS
    have hgens : DSMap.Mix2.chartGens t (∅ : Finset ι) = ∅ := by
      ext x
      simp [DSMap.Mix2.chartGens]
    have hbot : DSMap.Mix2.chartRing t (∅ : Finset ι) = ⊥ := by
      rw [show DSMap.Mix2.chartRing t (∅ : Finset ι)
          = Algebra.adjoin R (DSMap.Mix2.chartGens t (∅ : Finset ι)) from rfl,
        hgens, Algebra.adjoin_empty]
    have hz : (z : Localization.Away (DSMap.Mix2.tS t (∅ : Finset ι))) ∈
        (⊥ : Subalgebra R (Localization.Away (DSMap.Mix2.tS t (∅ : Finset ι)))) :=
      hbot ▸ z.2
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hz
    refine ⟨0, a, ?_, ?_⟩
    · rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
    · rw [pow_zero, one_mul]; exact ha
  · -- nondegenerate chart: `t_S ∈ J`
    have htS_mem : DSMap.Mix2.tS t S ∈ Ideal.span (Set.range t) := by
      obtain ⟨i₀, hi₀⟩ := Finset.nonempty_iff_ne_empty.mpr hS
      change ∏ x ∈ S, t x ∈ Ideal.span (Set.range t)
      rw [← Finset.mul_prod_erase S t hi₀]
      exact Ideal.mul_mem_right _
        (Ideal.span (Set.range t))
        (Ideal.subset_span (show t i₀ ∈ Set.range t from ⟨i₀, rfl⟩))
    -- the induction: `z · t_S ^ n ∈ J ^ n`
    have key : ∀ x : Localization.Away (DSMap.Mix2.tS t S),
        x ∈ Algebra.adjoin R (DSMap.Mix2.chartGens t S) →
        ∃ n : ℕ, ∃ a : R, a ∈ (Ideal.span (Set.range t)) ^ n ∧
          algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) a =
            (algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) (DSMap.Mix2.tS t S)) ^ n * x := by
      intro x hx
      refine Algebra.adjoin_induction
        (p := fun x _ => ∃ n : ℕ, ∃ a : R, a ∈ (Ideal.span (Set.range t)) ^ n ∧
          algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) a =
            (algebraMap R (Localization.Away (DSMap.Mix2.tS t S))
              (DSMap.Mix2.tS t S)) ^ n * x)
        ?_ ?_ ?_ ?_ hx
      · -- generators `t_k / t_i` (the relation `y * A(t i) = A(t k)`)
        rintro y ⟨i, hi, k, hk⟩
        let P : R := ∏ j ∈ S.erase i, t j
        have hτ : DSMap.Mix2.tS t S = t i * P := (Finset.mul_prod_erase S t hi).symm
        have hAτ : algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) (DSMap.Mix2.tS t S)
            = algebraMap R (Localization.Away (DSMap.Mix2.tS t S)) (t i * P) :=
          congrArg (algebraMap R (Localization.Away (DSMap.Mix2.tS t S))) hτ
        refine ⟨1, t k * P, ?_, ?_⟩
        · rw [pow_one]
          exact Ideal.mul_mem_right P (Ideal.span (Set.range t))
            (Ideal.subset_span (show t k ∈ Set.range t from ⟨k, rfl⟩))
        · rw [pow_one, map_mul, ← hk, hAτ, map_mul]
          ring
      · -- the image of `R`
        intro r
        refine ⟨0, r, ?_, ?_⟩
        · rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
        · rw [pow_zero, one_mul]
      · -- sums: `(x + y) · t_S ^ (n + m) = a t_S ^ m + b t_S ^ n`
        rintro x y _ _ ⟨n, a, ha, hxa⟩ ⟨m, b, hb, hyb⟩
        refine ⟨n + m, a * DSMap.Mix2.tS t S ^ m + b * DSMap.Mix2.tS t S ^ n, ?_, ?_⟩
        · rw [pow_add]
          refine Ideal.add_mem _
            (Ideal.mul_mem_mul ha (Ideal.pow_mem_pow htS_mem m)) ?_
          rw [mul_comm ((Ideal.span (Set.range t)) ^ n) ((Ideal.span (Set.range t)) ^ m)]
          exact Ideal.mul_mem_mul hb (Ideal.pow_mem_pow htS_mem n)
        · simp only [map_add, map_mul, map_pow, hxa, hyb, pow_add]
          ring
      · -- products
        rintro x y _ _ ⟨n, a, ha, hxa⟩ ⟨m, b, hb, hyb⟩
        refine ⟨n + m, a * b, ?_, ?_⟩
        · rw [pow_add]
          exact Ideal.mul_mem_mul ha hb
        · simp only [map_mul, hxa, hyb, pow_add]
          ring
    exact key z.1 z.2

end Work.DSM5b
