import Mathlib
import Submission.Work.DSM5b.Basic
import Submission.Work.DSM5b.perfChartRing_pow_p_mem_iff

/-!
# `Work.DSM5b.perfSupport` — finite support of an element of the perfected chart ring

Let `R` be a commutative ring of characteristic a prime `p`, `t : ι → R`, `T : R`, `S : Finset ι`,
`A = R_{t_S} = Localization.Away (tS t S)`, and

* `chartRing t S = R[J/t_S] ⊆ A` the honest blowup chart ring generated by `chartGens t S`
  (the fractions `t_i / t_j`, characterised by `x * t_j = t_i`),
* `perfChartRing p t S = Algebra.adjoin R {y | ∃ e, y ^ (p ^ e) ∈ chartRing t S}` its perfection
  inside `A`.

**Statement.**  Every `x ∈ perfChartRing p t S` has a finite support over `R`: there are finitely
many elements `c : Fin m → R` and an exponent `E` such that, for all `E' ≥ E`, the `p ^ E'`-th power
of `x` lies in the honest chart ring *over* the subring `R₀ = Subring.closure (range t ∪ {T} ∪
range c)`:

`x ^ (p ^ E') ∈ Algebra.adjoin R₀ (chartGens t S)`.

**Proof.**  In characteristic `p` the `p`-th power map is additive (`add_pow_p_localization`, and
`(p : A) = 0`), so the set `{y | ∃ e, y ^ (p ^ e) ∈ chartRing t S} = perfChartGens p t S` is an
`R`-subalgebra (`Work.DSM5b.perfChartGens_add'`, `Work.DSM5b.perfChartGens_mul`); hence
`z ↦ ∃ E, z ^ (p ^ E) ∈ chartRing t S` holds throughout `perfChartRing p t S`
(`Work.DSM5b.mem_perfChartRing_iff` for the generators, `adjoin_induction` for the algebra
operations).  So for some `E` the element `x ^ (p ^ E)` lies in the honest chart ring
`chartRing t S = Algebra.adjoin R (chartGens t S)`.

It remains to extract a *finite* set of `R`-coefficients witnessing this membership.  That is the
elementary "support" lemma `subring_support`: for any `u : Set R` and any `z` in the
`R`-subalgebra of `A` generated by a set `s`, there is a finite set `c ⊆ R` with

`z ∈ Subring.closure ((algebraMap R A) '' Subring.closure (u ∪ c) ∪ s)`

— i.e. `z` already lies in the subalgebra generated by `s` over the *finitely generated* subring
`Subring.closure (u ∪ c)`.  It is proved by `Subring.closure_induction`, the only non-trivial steps
being the union of the two coefficient sets in the sum/product cases.  Applying it with
`s = chartGens t S`, `u = range t ∪ {T}` and `z = x ^ (p ^ E)`, and re-indexing the resulting finset
by a `Fin m` (`exists_fin_range_eq`), produces the claimed `c`.  The membership then transports to
`Algebra.adjoin (↥R₀) (chartGens t S)` over the subring `R₀ = Subring.closure (range t ∪ {T} ∪
range c)` because the two carriers — `Subring.closure` of `(algebraMap R A) '' R₀ ∪ chartGens` on
the one hand, and the carrier of the `R₀`-adjoin on the other — agree: both involve the same
algebra map `algebraMap R A`, restricted along `R₀ ↪ R` (`Algebra.mem_adjoin_iff`).  Finally
`x ^ (p ^ E') = (x ^ (p ^ E)) ^ (p ^ (E' - E))` for `E' ≥ E`, and subrings are closed under powers.
-/

namespace Work.DSM5b

universe a

/-- **Finite support of an element of an `R`-adjoin.**  If `z` lies in the `R`-subalgebra of `A`
generated by `s` and `u ⊆ R`, then `z` lies already in the subalgebra generated by `s` over the
finitely generated subring `Subring.closure (u ∪ c)`, for some finite `c ⊆ R`.

Everything is phrased at the level of `Subring.closure` (rather than of `Subalgebra` over a
subring base) so that no interplay between the two `Algebra` structures on `A` is needed. -/
theorem subring_support {R A : Type a} [CommRing R] [CommRing A] [Algebra R A]
    (u : Set R) (s : Set A) (z : A)
    (hz : z ∈ Subring.closure (Set.range (algebraMap R A) ∪ s)) :
    ∃ c : Finset R, z ∈ Subring.closure
      ((algebraMap R A) '' ((Subring.closure (u ∪ (c : Set R))) : Set R) ∪ s) := by
  classical
  -- monotonicity of the coefficient subring in the finset of coefficients
  have mono : ∀ {c c' : Finset R}, c ⊆ c' →
      Subring.closure ((algebraMap R A) '' ((Subring.closure (u ∪ (c : Set R))) : Set R) ∪ s)
        ≤ Subring.closure
            ((algebraMap R A) '' ((Subring.closure (u ∪ (c' : Set R))) : Set R) ∪ s) := by
    intro c c' hcc
    refine Subring.closure_mono ?_
    refine Set.union_subset_union_left _ (Set.image_mono ?_)
    exact Subring.closure_mono (Set.union_subset_union_right u (Finset.coe_subset.mpr hcc))
  refine Subring.closure_induction (p := fun y _ => ∃ c : Finset R, y ∈ Subring.closure
      ((algebraMap R A) '' ((Subring.closure (u ∪ (c : Set R))) : Set R) ∪ s)) ?_ ?_ ?_ ?_ ?_ ?_
    hz
  · -- generators: an `R`-multiple needs one coefficient, an element of `s` none
    intro y hy
    rcases hy with ⟨r, rfl⟩ | hys
    · refine ⟨{r}, Subring.subset_closure (Or.inl ⟨r, ?_, rfl⟩)⟩
      exact Subring.subset_closure (Set.mem_union_right _ (by simp))
    · exact ⟨∅, Subring.subset_closure (Or.inr hys)⟩
  · exact ⟨∅, Subring.zero_mem _⟩
  · exact ⟨∅, Subring.one_mem _⟩
  · -- sums: union the coefficient sets
    intro x y hx hy ihx ihy
    obtain ⟨c₁, h₁⟩ := ihx
    obtain ⟨c₂, h₂⟩ := ihy
    exact ⟨c₁ ∪ c₂, Subring.add_mem _ (mono Finset.subset_union_left h₁)
      (mono Finset.subset_union_right h₂)⟩
  · -- negatives
    intro x hx ihx
    obtain ⟨c₁, h₁⟩ := ihx
    exact ⟨c₁, Subring.neg_mem _ h₁⟩
  · -- products
    intro x y hx hy ihx ihy
    obtain ⟨c₁, h₁⟩ := ihx
    obtain ⟨c₂, h₂⟩ := ihy
    exact ⟨c₁ ∪ c₂, Subring.mul_mem _ (mono Finset.subset_union_left h₁)
      (mono Finset.subset_union_right h₂)⟩

/-- A finset is the range of a function out of a finite type. -/
lemma exists_fin_range_eq {R : Type a} (c : Finset R) :
    ∃ (m : ℕ) (f : Fin m → R), Set.range f = (c : Set R) := by
  let e := Finset.equivFinOfCardEq (s := c) (rfl : c.card = c.card)
  refine ⟨c.card, fun i => (e.symm i : R), ?_⟩
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact (e.symm i).2
  · intro hx
    refine ⟨e ⟨x, hx⟩, ?_⟩
    show ((e.symm (e ⟨x, hx⟩)) : R) = x
    rw [Equiv.symm_apply_apply]

theorem perfSupport (p : ℕ) [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p]
    {ι : Type a} [DecidableEq ι] (t : ι → R) (T : R) (S : Finset ι)
    (x : Localization.Away (DSMap.Mix2.tS t S))
    (hx : x ∈ DSMap.Mix2.perfChartRing p t S) :
    ∃ (m : ℕ) (c : Fin m → R) (E : ℕ), ∀ E' : ℕ, E ≤ E' →
      x ^ (p ^ E') ∈ Algebra.adjoin
        (Subring.closure (Set.range t ∪ {T} ∪ Set.range c)) (DSMap.Mix2.chartGens t S) := by
  classical
  -- Step 1: some `p`-power of `x` is an honest chart element.
  obtain ⟨E, hE⟩ := (mem_perfChartRing_iff p t S (y := x)).mp hx
  change x ^ (p ^ E) ∈ Algebra.adjoin R (DSMap.Mix2.chartGens t S) at hE
  rw [Algebra.mem_adjoin_iff] at hE
  -- Step 2: finite support of that honest chart element, over `Subring.closure (range t ∪ {T})`.
  obtain ⟨d, hd⟩ := subring_support (Set.range t ∪ {T}) (DSMap.Mix2.chartGens t S) (x ^ (p ^ E)) hE
  -- Step 3: re-index the finset `d` by a `Fin m`.
  obtain ⟨m, c, hc⟩ := exists_fin_range_eq d
  refine ⟨m, c, E, fun E' hE' => ?_⟩
  rw [hc]
  -- The carriers of the `R₀`-adjoin and of the `Subring.closure` of `coefficients ∪ chartGens`
  -- agree, since both algebra maps restrict the same map `R → A`.
  have hrange : Set.range (algebraMap (↥(Subring.closure (Set.range t ∪ {T} ∪ (d : Set R))))
      (Localization.Away (DSMap.Mix2.tS t S)))
      = (algebraMap R (Localization.Away (DSMap.Mix2.tS t S))) ''
          ((Subring.closure (Set.range t ∪ {T} ∪ (d : Set R))) : Set R) := by
    ext a
    constructor
    · rintro ⟨r, rfl⟩
      exact ⟨(r : R), r.2, rfl⟩
    · rintro ⟨r, hr, rfl⟩
      exact ⟨⟨r, hr⟩, rfl⟩
  rw [Algebra.mem_adjoin_iff, hrange]
  have hpow : (x ^ (p ^ E)) ^ (p ^ (E' - E)) = x ^ (p ^ E') := by
    rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hE']
  rw [← hpow]
  exact Subring.pow_mem _ hd _

end Work.DSM5b
