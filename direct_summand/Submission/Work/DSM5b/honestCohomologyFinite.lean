import Mathlib
import Submission.Work.DSM5b.H0Defs
import Submission.Work.DSM5b.HCd_comp
import Submission.Work.DSCOH.chartCech_finite_vanishing
import Submission.Work.DSM5b.HCF.Comparison
import Submission.Work.DSM5b.HCF.stcChartCoeff_ulift_finite
import Submission.Work.DSM5b.HCF.htcComplex_reindex
import Submission.Work.DSM5b.HCF.exists_spanning_cycles

namespace Work.DSM5b

universe a

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2

/-- Finite generation transfers backwards along an isomorphism of `R`-modules. -/
theorem moduleFinite_of_iso {R : Type a} [CommRing R] {P Q : ModuleCat.{a} R} (e : P ≅ Q)
    (h : Module.Finite R P) : Module.Finite R Q := by
  haveI := h
  exact Module.Finite.of_surjective e.hom.hom
    (CategoryTheory.ConcreteCategory.bijective_of_isIso e.hom).2

/-- **Finite generation of the honest chart Čech cohomology.**  The cohomology of the honest tuple
complex `hcComplex (chartCoeff t)` of the chart coefficient system is a finitely generated
`R`-module in every degree, for `R` Noetherian and `ι` finite.

Route.  Let `ι' = ULift (Fin (Fintype.card ι))` and let `t'` be `t` transported along an
equivalence `e : ι ≃ ι'`.  The sorted (increasing tuple) complex of the chart system
`S ↦ chartRing t' S` is the alternating chart Čech complex of the Rees module of the ideal
`J = (t'_i)`, so its cohomology is finitely generated by
`Work.DSCOH.chartCech_finite_vanishing` (the bridge is
`Work.DSM5b.HCF.stcChartCoeff_ulift_finite`); the honest complex has the same cohomology
(`Work.DSM5b.HCF.toStc_quasiIso`, via the size filtration and the computation of the
surjection-complex cohomology `Work.DSM5b.HCF.surj_cohomology`); and the honest complex of `t` is
isomorphic to that of `t'` by reindexing (`Work.DSM5b.htcComplex_reindex`). -/
theorem htcChartCoeff_homology_finite {R : Type a} [CommRing R] [IsNoetherianRing R]
    {ι : Type a} [Fintype ι] [DecidableEq ι] (t : ι → R) (m : ℕ) :
    Module.Finite R ((htcComplex (chartCoeff t)).homology m) := by
  classical
  let n : ℕ := Fintype.card ι
  let e : ι ≃ ULift.{a} (Fin n) := (Fintype.equivFin ι).trans Equiv.ulift.symm
  let t' : ULift.{a} (Fin n) → R := fun i => t (e.symm i)
  let t'' : Fin n → R := fun a => t' (Equiv.ulift.symm a)
  have hfun2 : (fun i : ULift.{a} (Fin n) => t'' i.down) = t' := by
    funext i
    show t' (Equiv.ulift.symm i.down) = t' i
    rw [show Equiv.ulift.symm i.down = i from by simp]
  -- the sorted complex of the lifted system has finite cohomology (bridge to the DSCOH area)
  have hsort : Module.Finite R ((stcComplex (chartCoeff t')).homology m) := by
    have h := HCF.stcChartCoeff_ulift_finite n R t'' m
    rwa [hfun2] at h
  -- the comparison map is a quasi-isomorphism
  haveI : QuasiIso (toStcHom (chartCoeff t')) := HCF.toStc_quasiIso (chartCoeff t')
  have hhon : Module.Finite R ((htcComplex (chartCoeff t')).homology m) :=
    moduleFinite_of_iso
      (asIso (HomologicalComplex.homologyMap (toStcHom (chartCoeff t')) m)).symm hsort
  -- reindexing along `e`
  have hfun : (fun i : ι => t' (e i)) = t := funext fun i => by simp [t']
  obtain ⟨iso⟩ := HCF.htcComplex_reindex e R t'
  rw [hfun] at iso
  exact moduleFinite_of_iso
    ((HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.up ℕ) m).mapIso iso).symm hhon

/-- **Finiteness of the honest chart Čech cohomology.**  `R` is Noetherian, `t : ι → R` finite,
`HCX t m = ∀ τ : Fin (m+1) → ι, chartRing t (tupRng τ)` and `HCd t m` are the coordinates of the
honest chart Čech complex (`Submission/Work/DSM5b/H0Defs.lean`).  Claim: the cohomology in degree
`q+1` is a finitely generated `R`-module, in the form: there are finitely many cycles `f i` whose
classes span the cohomology modulo boundaries.

Suggested routes (the reviewer confirms the statement is true and that finite generation of
`H^q(Bl_J(Spec R), 𝒪)` is exactly the group-theoretic content):
* **Route A (DSCOH).**  `Work.DSCOH.chartCech_finite_vanishing` gives finite generation of the
  cohomology of the *alternating, subset-indexed* chart Čech complex `Work.DSCOH.chartCech ℳ` of a
  finitely generated graded module over `Poly R n` (and vanishing above `n`).  The honest complex
  here is the *unnormalized* (tuples with repetitions) Čech complex of the same chart cover, so it
  is quasi-isomorphic to it (the degenerate-part comparison, i.e. Dold–Kan normalization for the
  cosimplicial object); one then needs the graded module `M = ⊕_{d} J^d` (`J = (t_i)`) with
  `Poly R (#ι)`-action `X_i ↦ (mult by t_i)`, whose `degZero ℳ S` is `chartRing t S`.
* **Route B (elementary induction on the number of charts).**  The complex `Ĉ` with terms
  `∏_{τ : Fin(m+1) → ι} chartRing t (tupRng τ ∪ {j₀})` (for any fixed `j₀ : ι`) has the honest
  contraction `h : Ĉ^m → Ĉ^{m-1}`, `(hy) τ := y (tupIns j₀ τ)`, with `HCd ∘ h + h ∘ HCd = id` in
  positive degrees (one checks `(tupIns j₀ τ) ∘ δ^0 = τ` and that
  `tupIns j₀ (τ ∘ δ^i) = (tupIns j₀ τ) ∘ δ^{i+1}`), so `Ĉ` is acyclic in positive degrees; the
  quotient `Ĉ/C` is the honest complex of the smaller index set `ι \ {j₀}` with coefficient system
  `S ↦ chartRing t (S ∪ {j₀}) / chartRing t S`, and the long exact sequence reduces the claim for
  `ι` to the claim for `ι \ {j₀}` (one also needs the "collapsed" coefficient system
  `S ↦ chartRing t (S ∪ {j₀})` to have the same property, by the same argument).  The base cases
  (`ι` empty or a singleton) are immediate.  Route B is purely elementary homological algebra and
  reuses only the (proved) functoriality of `locRes`/`rhoH` for the contraction identity. -/
theorem honestCohomologyFinite {R : Type a} [CommRing R] [IsNoetherianRing R] {ι : Type a}
    [Finite ι] [DecidableEq ι] (t : ι → R) (q : ℕ) :
    ∃ (k : ℕ) (f : Fin k → HCX t (q + 1)),
      (∀ i, HCd t (q + 1) (f i) = 0) ∧
      ∀ z : HCX t (q + 1), HCd t (q + 1) z = 0 →
        ∃ c : Fin k → R, ∃ y : HCX t q, z = (∑ i, c i • f i) + HCd t q y := by
  classical
  haveI : Fintype ι := Fintype.ofFinite ι
  have hfin : Module.Finite R ((htcComplex (chartCoeff t)).homology (q + 1)) :=
    htcChartCoeff_homology_finite t (q + 1)
  obtain ⟨k, f, hf, hspan⟩ := HCF.exists_spanning_cycles (chartCoeff t) q hfin
  exact ⟨k, f, hf, hspan⟩

end Work.DSM5b
