import Mathlib
import Submission.Work.DSM5b.PerfComplexDefs
import Submission.Work.DSM5b.H0Defs
import Submission.Work.DSM5b.rootKillTransport
import Submission.Work.DSM5b.locBCRing
import Submission.Work.DSM5b.hCdBaseChange
import Submission.Work.DSM5b.chartRingBaseChange
import Submission.Work.DSM5b.HCXbFacts

/-!
# `Work.DSM5b.subringKillTransportN` — transport of a *fixed* killing exponent from a subring

Let `R` be a perfect ring of characteristic the prime `p`, `R₀ ⊆ R` a subring, `t : ι → R` a family
with values in `R₀`, `T ∈ R₀`, `t j₀ = T ^ e`, and let

`hkill : ∀ n z, HCd z = 0 → T ^ N • z ∈ range (HCd n)`

be the *uniform honest killing* over the subring `R₀` (the honest chart Čech complex `HCX`/`HCd`
read over `R₀`), with the killing exponent `N` fixed.

The theorem transports this statement to the *perfected* complex `PCX p t ·` of `R` for cochains `w`
which are *already* honest over `R₀`: `hw` says that each component of `w` lies in the `R₀`-algebra
generated by the chart generators `chartGens t (tupRng τ)`.

The transport is the base change `R₀[J/t_S] → R[J/t_S]` of the chart rings (`Work.DSM5b.locBC`,
restricted to the chart rings by `Work.DSM5b.locBCRing` and extended componentwise to the complexes
by `Work.DSM5b.HCXb`):

* the base change `locBC` is injective (the localisation of the injective map `R₀ ↪ R`), so the
  lift `z` of `w` to `HCX` over `R₀` is again a cycle, and `hkill` applies to it, giving
  `T₀ ^ N • z = HCd t₀ m y`;
* `HCXb` commutes with the differentials (`Work.DSM5b.hCdBaseChange`) and the honest complex sits
  inside the perfected one via a chain map (`Work.DSM5b.iota`, `PCd_iota`), so pushing the equation
  forward gives `T ^ N • w = PCd p t m (iota (HCXb y))`.

Everything here is `R₀`-linear, and the scalar `T ^ N ∈ R₀` becomes `T ^ N ∈ R` under the base
change, which is why the *same* exponent `N` survives.

The main work is done in the auxiliary theorem `subringKillGeneral`, which is stated for a general
ring homomorphism `R₀ → R` with the *base-changed* family `fun i => algebraMap R₀ R (t i)` as the
family over `R` (so that all the localisations are over the same ring and no type-transport along
`tS (algebraMap ∘ t) = tS t` is needed); the requested statement follows by the definitional
identity `algebraMap R₀ R ⟨t i, ht i⟩ = t i`.
-/

namespace Work.DSM5b

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2

set_option maxHeartbeats 1600000

universe a

section Helpers

variable {R₀ : Type a} [CommRing R₀] {R : Type a} [CommRing R] [Algebra R₀ R]
variable {ι : Type a} [DecidableEq ι]

/-- **The `R₀`-algebra generated by the chart generators is the base change of the chart ring.**
For `b = fun i => algebraMap R₀ R (t i)` the base-changed family, the `R₀`-subalgebra of the
`R`-localisation generated by `chartGens b S` is exactly the image of the honest chart ring
`chartRing t S` under the base-change map `locBC`:

`Algebra.adjoin R₀ (chartGens b S) = (chartRing t S).map (locBC t S)`.

This says that the hypothesis `hw` of `subringKillTransportN` is precisely the assertion that `w`
lies in the *image* of the honest-`R₀` complex. -/
lemma subringKillN_adjoin_chartGens_eq_map (t : ι → R₀) (S : Finset ι) :
    Algebra.adjoin R₀ (DSMap.Mix2.chartGens (fun i => algebraMap R₀ R (t i)) S)
      = (DSMap.Mix2.chartRing t S).map (Work.DSM5b.locBC (R := R) t S) := by
  have h : (DSMap.Mix2.chartRing t S).map (Work.DSM5b.locBC (R := R) t S)
      = Algebra.adjoin R₀ (Work.DSM5b.locBC (R := R) t S '' DSMap.Mix2.chartGens t S) := by
    rw [DSMap.Mix2.chartRing, AlgHom.map_adjoin]
  rw [h, chartGens_baseChange]

/-- **The base change of the chart localisations is injective.**  `locBC t S` is the localisation at
`Submonoid.powers (tS t S)` of the (injective) map `algebraMap R₀ R`, so it is injective: if
`f : R₀ → R` is injective then so is `S⁻¹f`. -/
lemma subringKillN_locBC_injective (t : ι → R₀) (S : Finset ι) (hg : Function.Injective (algebraMap R₀ R)) :
    Function.Injective (Work.DSM5b.locBC (R := R) t S) := by
  haveI : IsLocalization (Submonoid.map (algebraMap R₀ R) (Submonoid.powers (DSMap.Mix2.tS t S)))
      (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)) := by
    rw [Submonoid.map_powers, ← Work.DSM5b.tS_algebraMap t S]
    infer_instance
  have hmap : (IsLocalization.map
        (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S))
        (algebraMap R₀ R) (Submonoid.le_comap_map (Submonoid.powers (DSMap.Mix2.tS t S))) :
      Localization.Away (DSMap.Mix2.tS t S) →+*
        Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S))
      = (Work.DSM5b.locBC (R := R) t S).toRingHom := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (DSMap.Mix2.tS t S))
    rw [IsLocalization.map_comp]
    ext r
    simp only [RingHom.comp_apply]
    change (algebraMap R (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)))
        (algebraMap R₀ R r)
      = Work.DSM5b.locBC (R := R) t S (algebraMap R₀ (Localization.Away (DSMap.Mix2.tS t S)) r)
    rw [Work.DSM5b.locBC_algebraMap]
    exact (IsScalarTower.algebraMap_apply R₀ R
      (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)) r).symm
  have hkey : Function.Injective (IsLocalization.map
      (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S))
      (algebraMap R₀ R) (Submonoid.le_comap_map (Submonoid.powers (DSMap.Mix2.tS t S)))) :=
    IsLocalization.map_injective_of_injective (Submonoid.powers (DSMap.Mix2.tS t S))
      (Localization.Away (DSMap.Mix2.tS t S))
      (Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) S)) hg
  rw [hmap] at hkey
  exact hkey

/-- **The base-change map of the honest complexes is injective.**  Componentwise this is
`subringKillN_locBC_injective`. -/
lemma subringKillN_HCXb_injective (t : ι → R₀) (m : ℕ) (hg : Function.Injective (algebraMap R₀ R)) :
    Function.Injective (Work.DSM5b.HCXb (R := R) t m) := by
  intro z z' h
  funext σ
  apply Subtype.ext
  have hσ : Work.DSM5b.HCXb (R := R) t m z σ = Work.DSM5b.HCXb (R := R) t m z' σ :=
    congrFun h σ
  rw [Work.DSM5b.HCXb_apply, Work.DSM5b.HCXb_apply] at hσ
  have h2 := congrArg (fun y : DSMap.Mix2.chartRing (fun i => algebraMap R₀ R (t i)) (tupRng σ) =>
    (y : Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (tupRng σ)))) hσ
  simp only [Work.DSM5b.locBCRing_coe] at h2
  exact subringKillN_locBC_injective t (tupRng σ) hg h2

end Helpers

section General

variable {R₀ : Type a} [CommRing R₀] {R : Type a} [CommRing R] [Algebra R₀ R]
variable {ι : Type a} [DecidableEq ι]

section Honest

variable (p : ℕ) [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p] [PerfectRing R p]
  {ι : Type a} [DecidableEq ι] (t : ι → R)

/-- The honest chart complex read inside the perfected one, componentwise.  (`Work.DSM5b.iota`
does the same but carries an unused `[Finite ι]` hypothesis, which the present statement does not
have.) -/
noncomputable def subringKillN_iota (m : ℕ) : Work.DSM5b.HCX t m →ₗ[R] Work.DSM5b.PCX p t m where
  toFun w := fun τ => ⟨(w τ : Localization.Away (DSMap.Mix2.tS t (Work.DSM5b.tupRng τ))),
    chartRing_le_perfChartRing p t (Work.DSM5b.tupRng τ) (w τ).2⟩
  map_add' w w' := by funext τ; apply Subtype.ext; simp
  map_smul' r w := by funext τ; apply Subtype.ext; simp

/-- The honest inclusion into the perfected complex is injective. -/
lemma subringKillN_iota_injective (m : ℕ) {w w' : Work.DSM5b.HCX t m}
    (h : subringKillN_iota p t m w = subringKillN_iota p t m w') : w = w' := by
  funext τ
  have hτ : ((subringKillN_iota p t m) w) τ = ((subringKillN_iota p t m) w') τ := congrFun h τ
  exact Subtype.ext (congrArg (fun z : ↥(perfChartRing p t (Work.DSM5b.tupRng τ)) =>
    (z : Localization.Away (DSMap.Mix2.tS t (Work.DSM5b.tupRng τ)))) hτ)

/-- `Work.DSM5b.rho_coe` without the unused `[Finite ι]` hypothesis (it is `rfl`). -/
lemma subringKillN_rho_coe (t : ι → R) {S T : Finset ι} (h : S ⊆ T) (x : ↥(perfChartRing p t S)) :
    ((rho p t h) x : Localization.Away (DSMap.Mix2.tS t T))
      = locRes t h (x : Localization.Away (DSMap.Mix2.tS t S)) := rfl

/-- The honest inclusion is a chain map.  (The proof unfolds `PCd`/`HCd` by hand rather than
using `Work.DSM5b.PCd_apply`/`Work.DSM5b.rho_coe`, which carry an unused `[Finite ι]`.) -/
lemma subringKillN_PCd_iota (m : ℕ) (w : Work.DSM5b.HCX t m) :
    Work.DSM5b.PCd p t m (subringKillN_iota p t m w)
      = subringKillN_iota p t (m + 1) (Work.DSM5b.HCd t m w) := by
  funext τ
  apply Subtype.ext
  simp only [Work.DSM5b.PCd, Work.DSM5b.HCd, subringKillN_iota, LinearMap.coe_mk,
    AddHom.coe_mk, AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_smul, subringKillN_rho_coe, rhoH_coe]

end Honest

/-- **The transport in the base-changed world.**  This is the mathematical content of
`subringKillTransportN`, stated for a general ring homomorphism `R₀ → R` and with the family over
`R` written as the base change `b = fun i => algebraMap R₀ R (t i)` of a family `t : ι → R₀`.

Writing the `R`-family this way keeps every localisation in the statement over the *same* ring `R`
(as in `chartRingBaseChange`), so no transport across the definitional identity
`tS (algebraMap ∘ t) = tS t` is needed; the requested statement is the specialisation
`t i := ⟨t i, ht i⟩` composed with that identity. -/
theorem subringKillGeneral (p : ℕ) [Fact p.Prime] {R₀ : Type a} [CommRing R₀]
    {R : Type a} [CommRing R] [Algebra R₀ R] [CharP R p] [PerfectRing R p]
    {ι : Type a} [DecidableEq ι] (t : ι → R₀) (T : R₀) (j₀ : ι) (e : ℕ)
    (hj₀ : t j₀ = T ^ e) (N : ℕ)
    (hkill : ∀ (n : ℕ) (z : Work.DSM5b.HCX t (n + 1)),
      Work.DSM5b.HCd t (n + 1) z = 0 → T ^ N • z ∈ LinearMap.range (Work.DSM5b.HCd t n))
    (hginj : Function.Injective (algebraMap R₀ R))
    (m : ℕ) (w : Work.DSM5b.PCX p (fun i => algebraMap R₀ R (t i)) (m + 1))
    (hw : ∀ τ : Fin (m + 2) → ι,
      (w τ : Localization.Away
          (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ))) ∈
        Algebra.adjoin R₀
          (DSMap.Mix2.chartGens (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ)))
    (hcyc : Work.DSM5b.PCd p (fun i => algebraMap R₀ R (t i)) (m + 1) w = 0) :
    (algebraMap R₀ R T) ^ N • w ∈
      LinearMap.range (Work.DSM5b.PCd p (fun i => algebraMap R₀ R (t i)) m) := by
  classical
  -- Step 1: `w` is the base change of an honest `R₀`-cochain `w₀`.
  have himage : ∀ τ : Fin (m + 2) → ι, ∃ y : DSMap.Mix2.chartRing t (Work.DSM5b.tupRng τ),
      (Work.DSM5b.locBC (R := R) t (Work.DSM5b.tupRng τ)
          (y : Localization.Away (DSMap.Mix2.tS t (Work.DSM5b.tupRng τ))) :
        Localization.Away
          (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ)))
        = (w τ : Localization.Away
          (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ))) := by
    intro τ
    have hmem : (w τ : Localization.Away
          (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ))) ∈
        (DSMap.Mix2.chartRing t (Work.DSM5b.tupRng τ)).map
          (Work.DSM5b.locBC (R := R) t (Work.DSM5b.tupRng τ)) := by
      rw [← subringKillN_adjoin_chartGens_eq_map (R := R) t (Work.DSM5b.tupRng τ)]
      exact hw τ
    rw [Subalgebra.mem_map] at hmem
    obtain ⟨y, hy, hyeq⟩ := hmem
    exact ⟨⟨y, hy⟩, hyeq⟩
  let w₀ : Work.DSM5b.HCX t (m + 1) := fun τ => Classical.choose (himage τ)
  have hw₀ : subringKillN_iota p (fun i => algebraMap R₀ R (t i)) (m + 1)
      (Work.DSM5b.HCXb (R := R) t (m + 1) w₀) = w := by
    funext τ
    apply Subtype.ext
    change ((Work.DSM5b.HCXb (R := R) t (m + 1) w₀) τ :
        Localization.Away (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ)))
      = (w τ : Localization.Away
          (DSMap.Mix2.tS (fun i => algebraMap R₀ R (t i)) (Work.DSM5b.tupRng τ)))
    rw [Work.DSM5b.HCXb_apply, Work.DSM5b.locBCRing_coe]
    exact Classical.choose_spec (himage τ)
  -- Step 2: the lift `w₀` is again a cycle.
  have hcyc₀ : Work.DSM5b.HCd t (m + 1) w₀ = 0 := by
    have h1 : Work.DSM5b.PCd p (fun i => algebraMap R₀ R (t i)) (m + 1)
        (subringKillN_iota p (fun i => algebraMap R₀ R (t i)) (m + 1)
          (Work.DSM5b.HCXb (R := R) t (m + 1) w₀)) = 0 := by rw [hw₀, hcyc]
    rw [subringKillN_PCd_iota] at h1
    rw [hCdBaseChange (R := R) t (m + 1) w₀] at h1
    have h2 : Work.DSM5b.HCXb (R := R) t (m + 2) (Work.DSM5b.HCd t (m + 1) w₀) = 0 :=
      subringKillN_iota_injective p (fun i => algebraMap R₀ R (t i)) (m + 2) h1
    exact subringKillN_HCXb_injective t (m + 2) hginj (by rw [h2, map_zero])
  -- Step 3: apply the honest killing hypothesis over `R₀`.
  obtain ⟨y₀, hy₀⟩ := hkill m w₀ hcyc₀
  -- Step 4: push the equation forward along the two chain maps.
  refine ⟨subringKillN_iota p (fun i => algebraMap R₀ R (t i)) m
      (Work.DSM5b.HCXb (R := R) t m y₀), ?_⟩
  rw [subringKillN_PCd_iota, hCdBaseChange, hy₀]
  rw [map_smul]
  rw [show T ^ N • (Work.DSM5b.HCXb (R := R) t (m + 1) w₀) = (algebraMap R₀ R T) ^ N •
      (Work.DSM5b.HCXb (R := R) t (m + 1) w₀) from by
        rw [← IsScalarTower.algebraMap_smul R (T ^ N), map_pow]]
  rw [map_smul, hw₀]

end General

theorem subringKillTransportN (p : ℕ) [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p]
    [PerfectRing R p] {ι : Type a} [DecidableEq ι] (t : ι → R) (T : R) (R₀ : Subring R)
    (ht : ∀ i, t i ∈ R₀) (hT : T ∈ R₀) (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = T ^ e) (N : ℕ)
    (hkill : ∀ (n : ℕ) (z : Work.DSM5b.HCX (fun i => (⟨t i, ht i⟩ : R₀)) (n + 1)),
      Work.DSM5b.HCd (fun i => (⟨t i, ht i⟩ : R₀)) (n + 1) z = 0 →
        (⟨T, hT⟩ : R₀) ^ N • z ∈
          LinearMap.range (Work.DSM5b.HCd (fun i => (⟨t i, ht i⟩ : R₀)) n))
    (m : ℕ) (w : Work.DSM5b.PCX p t (m + 1))
    (hw : ∀ τ : Fin (m + 2) → ι,
      (w τ : Localization.Away (DSMap.Mix2.tS t (Work.DSM5b.tupRng τ))) ∈
        Algebra.adjoin R₀ (DSMap.Mix2.chartGens t (Work.DSM5b.tupRng τ)))
    (hcyc : Work.DSM5b.PCd p t (m + 1) w = 0) :
    T ^ N • w ∈ LinearMap.range (Work.DSM5b.PCd p t m) := by
  have hj₀' : (fun i => (⟨t i, ht i⟩ : R₀)) j₀ = (⟨T, hT⟩ : R₀) ^ e := by
    show (⟨t j₀, ht j₀⟩ : R₀) = (⟨T, hT⟩ : R₀) ^ e
    exact Subtype.ext (by simpa using hj₀)
  exact subringKillGeneral (R₀ := R₀) (R := R) p (fun i => (⟨t i, ht i⟩ : R₀))
    (⟨T, hT⟩ : R₀) j₀ e hj₀' N hkill (fun a b hab => Subtype.ext hab) m w hw hcyc

end Work.DSM5b
