import Mathlib
import Submission.Work.DSM5b.awayComplex
import Submission.Work.DSM5b.adjoinUnitMulMem

/-!
# `Submission.Work.DSM5b.awayInDenominator`

Denominator clearing for the `T`-localised chart ring.

`B = Localization.Away (T * tS t S) = R[1/(T · t_S)]` is the localisation of the honest chart ring
`A_S = chartRing t S ⊆ R_{t_S}` at `T` (`Work.DSM5b.awayIn_adjoin_top`), so for every `y ∈ B` there
is `k : ℕ` and `c ∈ chartRing t S` with `awayIn t T S c = T ^ k · y`
(`Work.DSM5b.awayIn_denominator`).

The key point is `T ^ e = t j₀`: since `T` is a unit in `B`, so is the image of `t j₀` — which is
exactly a chart generator in the `j₀`-direction, and this is what forces the localised chart ring
to be all of `B`.
-/

namespace Work.DSM5b

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2

universe a

/-- The generators of the localised chart ring lie in the image of the honest chart ring: if
`x · A(t i) = A(t k)` with `i ∈ S` then `x = A(t k) · A(t i)⁻¹` is the image of the chart generator
`t k / t i ∈ chartGens t S`. -/
lemma awayIn_set_subset_map {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]
    (t : ι → R) (T : R) (S : Finset ι)
    (x : Localization.Away (T * tS t S))
    (hx : ∃ i ∈ S, ∃ k : ι, x * algebraMap R (Localization.Away (T * tS t S)) (t i)
        = algebraMap R (Localization.Away (T * tS t S)) (t k)) :
    x ∈ (chartRing t S).map (awayIn t T S) := by
  obtain ⟨i, hi, k, hk⟩ := hx
  obtain ⟨w, hw⟩ : ∃ w : (Localization.Away (tS t S))ˣ,
      (w : Localization.Away (tS t S)) = algebraMap R (Localization.Away (tS t S)) (t i) :=
    ⟨(IsLocalization.Away.isUnit_of_dvd (tS t S) (Finset.dvd_prod_of_mem t hi)).unit,
      (IsLocalization.Away.isUnit_of_dvd (tS t S) (Finset.dvd_prod_of_mem t hi)).unit_spec⟩
  refine Subalgebra.mem_map.mpr ⟨algebraMap R (Localization.Away (tS t S)) (t k) * ↑(w⁻¹), ?_, ?_⟩
  · rw [chartRing]
    apply Algebra.subset_adjoin
    refine ⟨i, hi, k, ?_⟩
    rw [mul_assoc, ← hw, Units.inv_mul, mul_one]
  · rw [map_mul,
      show awayIn t T S (algebraMap R (Localization.Away (tS t S)) (t k))
        = algebraMap R (Localization.Away (T * tS t S)) (t k) from
        liftAway_algebraMap (dvd_mul_left (tS t S) T) (t k)]
    have hwA : awayIn t T S (↑w) = algebraMap R (Localization.Away (T * tS t S)) (t i) := by
      rw [hw]
      exact liftAway_algebraMap (dvd_mul_left (tS t S) T) (t i)
    have hwinv : awayIn t T S (↑(w⁻¹)) * algebraMap R (Localization.Away (T * tS t S)) (t i) = 1 := by
      rw [← hwA, ← map_mul, Units.inv_mul, map_one]
    calc algebraMap R (Localization.Away (T * tS t S)) (t k) * awayIn t T S (↑(w⁻¹))
        = (x * algebraMap R (Localization.Away (T * tS t S)) (t i)) * awayIn t T S (↑(w⁻¹)) := by
          rw [hk]
      _ = x * (algebraMap R (Localization.Away (T * tS t S)) (t i) * awayIn t T S (↑(w⁻¹))) := by
          rw [mul_assoc]
      _ = x * 1 := by
          rw [mul_comm (algebraMap R (Localization.Away (T * tS t S)) (t i)) (awayIn t T S (↑(w⁻¹))),
            hwinv]
      _ = x := mul_one x

/-- **The localised chart ring is everything.**  In `B = R[1/(T · t_S)]` the `R`-subalgebra
generated by the image of the honest chart ring `chartRing t S` and by `T⁻¹` is all of `B`.

Since `T` is a unit of `B` and `T ^ e = t j₀`, the image of `t j₀` is a unit of `B`; the chart
generator `A(t j₀) · A(t i)⁻¹` therefore exhibits `A(t i)⁻¹` as `u ^ e · A(t j₀) · A(t i)⁻¹` with
`u = T⁻¹`, so all the `A(t i)⁻¹` (`i ∈ S`) lie in the adjoin; their product is `A(t_S)⁻¹`, whence
`(T · t_S)⁻¹ ∈ A`, and `B = R[(T · t_S)⁻¹]` is generated by `R` and that inverse. -/
theorem awayIn_adjoin_top {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]
    (t : ι → R) (T : R) (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = T ^ e) (S : Finset ι) :
    Algebra.adjoin R (↑((chartRing t S).map (awayIn t T S)) ∪
      {IsLocalization.Away.invSelf (T * tS t S)
        * algebraMap R (Localization.Away (T * tS t S)) (tS t S)}) = ⊤ := by
  classical
  set w : Localization.Away (T * tS t S) := IsLocalization.Away.invSelf (T * tS t S) with hw
  set u : Localization.Away (T * tS t S) :=
    w * algebraMap R (Localization.Away (T * tS t S)) (tS t S) with hu
  set A : Subalgebra R (Localization.Away (T * tS t S)) :=
    Algebra.adjoin R (↑((chartRing t S).map (awayIn t T S)) ∪ {u}) with hA
  have huA : u ∈ A := Algebra.subset_adjoin (Or.inr rfl)
  have hCA : ∀ x ∈ (chartRing t S).map (awayIn t T S), x ∈ A :=
    fun x hx => Algebra.subset_adjoin (Or.inl hx)
  have hsetA : ∀ x : Localization.Away (T * tS t S),
      (∃ i ∈ S, ∃ k : ι, x * algebraMap R _ (t i) = algebraMap R _ (t k)) → x ∈ A :=
    fun x hx => hCA x (awayIn_set_subset_map t T S x hx)
  have hw1 : algebraMap R (Localization.Away (T * tS t S)) (T * tS t S) * w = 1 := by
    rw [hw]
    exact IsLocalization.Away.mul_invSelf (T * tS t S)
  have hwT : w * algebraMap R (Localization.Away (T * tS t S)) (T * tS t S) = 1 := by
    rw [mul_comm w (algebraMap R (Localization.Away (T * tS t S)) (T * tS t S))]
    exact hw1
  have huT : u * algebraMap R (Localization.Away (T * tS t S)) T = 1 := by
    rw [hu, mul_assoc, ← map_mul, mul_comm (tS t S) T]
    exact hwT
  -- inverses of the images of the `t i`, `i ∈ S`
  have hti : ∀ i ∈ S, ∃ vi : Localization.Away (T * tS t S),
      vi * algebraMap R _ (t i) = 1 ∧ vi ∈ A := by
    intro i hi
    obtain ⟨k0, hk0⟩ : ∃ k0 : R, tS t S = t i * k0 := by
      refine ⟨∏ j ∈ S.erase i, t j, ?_⟩
      rw [tS, ← Finset.prod_erase_mul _ _ hi, mul_comm]
    have hdiv : t i ∣ T * tS t S := ⟨T * k0, by rw [hk0]; ring⟩
    set ui : IsUnit (algebraMap R (Localization.Away (T * tS t S)) (t i)) :=
      IsLocalization.Away.isUnit_of_dvd (T * tS t S) hdiv with hui
    have hspeci : (ui.unit : Localization.Away (T * tS t S))
        = algebraMap R (Localization.Away (T * tS t S)) (t i) := ui.unit_spec
    have hvi1 : (↑(ui.unit⁻¹) : Localization.Away (T * tS t S))
        * algebraMap R (Localization.Away (T * tS t S)) (t i) = 1 := by
      have := Units.inv_mul ui.unit
      rwa [hspeci] at this
    refine ⟨↑(ui.unit⁻¹), hvi1, ?_⟩
    · set g₀ : Localization.Away (T * tS t S) :=
          algebraMap R (Localization.Away (T * tS t S)) (t j₀)
            * (↑(ui.unit⁻¹) : Localization.Away (T * tS t S)) with hg₀
      have hgen : ∃ i ∈ S, ∃ k : ι,
          g₀ * algebraMap R (Localization.Away (T * tS t S)) (t i)
            = algebraMap R (Localization.Away (T * tS t S)) (t k) := by
        refine ⟨i, hi, j₀, ?_⟩
        rw [hg₀, mul_assoc, hvi1, mul_one]
      have hTj : algebraMap R (Localization.Away (T * tS t S)) (t j₀)
          = (algebraMap R (Localization.Away (T * tS t S)) T) ^ e := by rw [hj₀, map_pow]
      have hvi : (↑(ui.unit⁻¹) : Localization.Away (T * tS t S)) = u ^ e * g₀ := by
        rw [hg₀, hTj, ← mul_assoc, ← mul_pow, huT, one_pow, one_mul]
      rw [hvi]
      exact A.mul_mem (A.pow_mem huA e) (hsetA g₀ hgen)
  -- the inverse of the image of `tS t S`
  have hV : ∃ V : Localization.Away (T * tS t S), V ∈ A ∧ V * algebraMap R _ (tS t S) = 1 := by
    have hprod : algebraMap R (Localization.Away (T * tS t S)) (tS t S)
        = ∏ i ∈ S, algebraMap R _ (t i) := by rw [tS, map_prod]
    let vf : ι → Localization.Away (T * tS t S) :=
      fun i => if h : i ∈ S then Classical.choose (hti i h) else 1
    have hv1 : ∀ i (h : i ∈ S), vf i * algebraMap R _ (t i) = 1 := by
      intro i h
      dsimp only [vf]
      rw [dif_pos h]
      exact (Classical.choose_spec (hti i h)).1
    have hv2 : ∀ i (h : i ∈ S), vf i ∈ A := by
      intro i h
      dsimp only [vf]
      rw [dif_pos h]
      exact (Classical.choose_spec (hti i h)).2
    refine ⟨∏ i ∈ S, vf i, A.prod_mem (fun i hi => hv2 i hi), ?_⟩
    rw [hprod, ← Finset.prod_mul_distrib]
    exact Finset.prod_eq_one (fun i hi => hv1 i hi)
  -- `(T · t_S)⁻¹ ∈ A`
  have hwA : w ∈ A := by
    obtain ⟨V, hVA, hV1⟩ := hV
    have hwEq : w = u * V := by
      rw [hu, mul_assoc, mul_comm (algebraMap R (Localization.Away (T * tS t S)) (tS t S)) V,
        hV1, mul_one]
    rw [hwEq]
    exact A.mul_mem huA hVA
  have htop : A = ⊤ := by
    apply le_antisymm le_top
    intro y _
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (T * tS t S) y
    have hwn : ((algebraMap R (Localization.Away (T * tS t S)) (T * tS t S)) ^ n) * w ^ n = 1 := by
      rw [← mul_pow, mul_comm (algebraMap R (Localization.Away (T * tS t S)) (T * tS t S)) w, hwT,
        one_pow]
    have hy : y = algebraMap R (Localization.Away (T * tS t S)) a * w ^ n := by
      have h := congrArg (fun z => z * w ^ n) ha
      simp only [mul_assoc] at h
      rw [hwn, mul_one] at h
      exact h
    rw [hy]
    exact A.mul_mem (A.algebraMap_mem a) (A.pow_mem hwA n)
  change A = ⊤
  exact htop

/-- **Denominator clearing.**  Every element of `B = R[1/(T · t_S)]` is `T ^ (-k)` times the image
of an element of the honest chart ring `chartRing t S`. -/
theorem awayIn_denominator {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]
    (t : ι → R) (T : R) (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = T ^ e) (S : Finset ι)
    (y : Localization.Away (T * tS t S)) :
    ∃ (k : ℕ) (c : ↥(chartRing t S)),
      awayIn t T S (c : Localization.Away (tS t S))
        = (algebraMap R (Localization.Away (T * tS t S)) T) ^ k * y := by
  set u : Localization.Away (T * tS t S) :=
    IsLocalization.Away.invSelf (T * tS t S)
      * algebraMap R (Localization.Away (T * tS t S)) (tS t S) with hu
  have hadj : Algebra.adjoin R (↑((chartRing t S).map (awayIn t T S)) ∪ {u}) = ⊤ :=
    awayIn_adjoin_top t T j₀ e hj₀ S
  have hy : y ∈ Algebra.adjoin R (↑((chartRing t S).map (awayIn t T S)) ∪ {u}) := by
    rw [hadj]; trivial
  have htC : algebraMap R (Localization.Away (T * tS t S)) T
      ∈ (chartRing t S).map (awayIn t T S) :=
    Subalgebra.algebraMap_mem _ T
  have hut : u * algebraMap R (Localization.Away (T * tS t S)) T = 1 := by
    rw [hu, mul_assoc, ← map_mul, mul_comm (tS t S) T]
    rw [mul_comm (IsLocalization.Away.invSelf (T * tS t S))
      (algebraMap R (Localization.Away (T * tS t S)) (T * tS t S))]
    exact IsLocalization.Away.mul_invSelf (T * tS t S)
  obtain ⟨J, hJ⟩ := adjoinUnitMulMem ((chartRing t S).map (awayIn t T S)) htC hut hy
  obtain ⟨c, hc, hcy⟩ := Subalgebra.mem_map.mp hJ
  exact ⟨J, ⟨c, hc⟩, hcy⟩

end Work.DSM5b
