import Mathlib
import Submission.Work.DSMap.Map

/-!
# DSPB2 — perfectoid mod-`p` / tilt identification: vocabulary and elementary algebra

This is the *bottom layer* of the DSPB2 subproject: the vocabulary shared by every later file.
The target is the frozen statement `DSMap.Mix.perfectoid_modp_tilt`, i.e. Bhatt–Morrow–Scholze's
identification of `C ⧸ (p)` with `C♭ ⧸ (ϖ♭)^p` (BMS1 Lemma 3.5 / Lemma 3.10).

The whole development takes place over a `DSMap.PerfectoidData p C`, i.e. an integral perfectoid
ring in the `ϖ^p = p·unit` convention with a chosen compatible system of `p`-power roots `P.ϖ`.

## Main definitions

* `Work.DSPB2.Red p C` — the residue ring `C ⧸ (p)` (definitionally Mathlib's `ModP C p`).
* `Work.DSPB2.Tilt p C` — the tilt (definitionally Mathlib's `PreTilt C p`).

## Main results of this file

* `span_varpi_pow_eq_span_p` — `(ϖ 0 ^ p) = (p)`.
* `p_mem_span_varpi` — `ϖ 0 ∣ p`.
* `isSMulRegular_varpi` — `ϖ 0` is a nonzerodivisor.
* `frobenius_red_surjective` — the Frobenius of `C ⧸ (p)` is surjective.
* `pow_p_eq_zero_mem_span_varpi` — the `p`-th power map on `C ⧸ (p)` has kernel `(ϖ 0)`.
* `pth_root_mem` — the "unique `p`-th root modulo `(ϖ)`" computation used everywhere below.
-/

set_option linter.unusedSectionVars false

namespace Work.DSPB2

universe a

open Ideal

/-- The mod-`p` residue ring `C ⧸ (p)` of `C`. -/
abbrev Red (p : ℕ) (C : Type a) [CommRing C] : Type a := C ⧸ Ideal.span {(p : C)}

/-- The tilt of `C`: Mathlib's `PreTilt C p`, the perfection of `C ⧸ (p)`. -/
abbrev Tilt (p : ℕ) (C : Type a) [CommRing C] : Type a := PreTilt C p

/-! ### Elementary algebra of `ϖ 0` -/

theorem span_varpi_pow_eq_span_p (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) :
    Ideal.span {P.ϖ 0 ^ p} = Ideal.span {(p : C)} := by
  obtain ⟨v, hv⟩ := P.unit
  rw [hv, Ideal.span_singleton_mul_right_unit (Units.isUnit v) (p : C)]

theorem p_mem_span_varpi (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) : (p : C) ∈ Ideal.span {P.ϖ 0} := by
  obtain ⟨v, hv⟩ := P.unit
  have h1 : P.ϖ 0 ^ p * ↑v⁻¹ = (p : C) := by rw [hv, mul_assoc, Units.mul_inv, mul_one]
  refine Ideal.mem_span_singleton'.mpr ⟨↑v⁻¹ * P.ϖ 0 ^ (p - 1), ?_⟩
  have hp1 : p - 1 + 1 = p := Nat.succ_pred_eq_of_pos (Fact.out : Nat.Prime p).pos
  rw [mul_assoc, ← pow_succ, hp1, ← h1, mul_comm (P.ϖ 0 ^ p) (↑v⁻¹)]

/-- `ϖ 0` is a nonzerodivisor (because `ϖ 0 ^ p = p * unit` and `p` is one). -/
theorem isSMulRegular_varpi (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) : IsSMulRegular C (P.ϖ 0) := by
  obtain ⟨v, hv⟩ := P.unit
  have h2 : IsSMulRegular C (P.ϖ 0 ^ p) := by
    rw [hv]; exact P.torsionFree.mul (IsUnit.isSMulRegular C v.isUnit)
  exact (IsSMulRegular.pow_iff (Fact.out : Nat.Prime p).pos).mp h2

/-- Any `p`-power root of `ϖ 0` is a nonzerodivisor. -/
theorem isSMulRegular_of_pow_eq_varpi (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) (τ : C) (n : ℕ) (h : τ ^ p ^ n = P.ϖ 0) :
    IsSMulRegular C τ := by
  have h1 : IsSMulRegular C (τ ^ p ^ n) := h ▸ isSMulRegular_varpi p C P
  exact (IsSMulRegular.pow_iff (pow_pos (Fact.out : Nat.Prime p).pos n)).mp h1

/-! ### The Frobenius of `C ⧸ (p)` -/

theorem frobenius_red_surjective (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) [Fact ¬IsUnit (p : C)] :
    Function.Surjective (frobenius (ModP C p) p) := by
  intro z
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨y, hy⟩ := DSMap.PerfectoidData.frobSurj P x
  refine ⟨Ideal.Quotient.mk _ y, ?_⟩
  rw [frobenius_def, ← map_pow, Ideal.Quotient.eq]
  simpa using neg_mem hy

/-- The kernel of the `p`-th power map on `C ⧸ (p)` is generated by the class of `ϖ 0`. -/
theorem pow_p_eq_zero_mem_span_varpi (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) [Fact ¬IsUnit (p : C)] (z : ModP C p) (hz : z ^ p = 0) :
    z ∈ Ideal.span {Ideal.Quotient.mk (Ideal.span {(p : C)}) (P.ϖ 0)} := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  have hx' : x ^ p ∈ Ideal.span {(p : C)} := by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hz
    exact hz
  have h2 : x ∈ Ideal.span {P.ϖ 0} := DSMap.PerfectoidData.frobInj P x hx'
  have h3 := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {(p : C)})) h2
  rwa [Ideal.map_span, Set.image_singleton] at h3

/-- **Unique `p`-th root modulo `(ϖ)`.**  If `z ^ p = U ^ p * c` in `C ⧸ (p)` and the kernel of
Frobenius lies in `(m)` with `m ∈ (U)`, then `z ∈ (U)`.  Concretely, `m` will be the class of
`ϖ 0`, and `U` the `n`-th level of `ϖ♭`. -/
theorem pth_root_mem (p : ℕ) [Fact p.Prime] (C : Type a) [CommRing C]
    (P : DSMap.PerfectoidData p C) [Fact ¬IsUnit (p : C)]
    {m U z : ModP C p}
    (hm : ∀ a : ModP C p, a ^ p = 0 → a ∈ Ideal.span {m}) (hmU : m ∈ Ideal.span {U})
    (hz : z ^ p ∈ Ideal.span {U ^ p}) : z ∈ Ideal.span {U} := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hz
  have hc' : z ^ p = U ^ p * c := by rw [← hc, mul_comm]
  obtain ⟨w, hw⟩ := frobenius_red_surjective p C P c
  have hw' : c = w ^ p := hw.symm
  have h1 : (z - U * w) ^ p = 0 := by
    rw [sub_pow_char, hc', hw', mul_pow]
    ring
  have h2 : z - U * w ∈ Ideal.span {m} := hm _ h1
  have h3 : Ideal.span {m} ≤ Ideal.span {U} :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmU)
  have h4 : U * w ∈ Ideal.span {U} := Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self U)
  have h5 : z - U * w + U * w ∈ Ideal.span {U} := Ideal.add_mem _ (h3 h2) h4
  rwa [sub_add_cancel] at h5

end Work.DSPB2
