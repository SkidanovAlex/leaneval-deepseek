import Mathlib
import Submission.Work.DSMap.Map
import Submission.Work.DSEQ0.ChartCover

namespace Work.DSEQ0

/-! **The standard chart cover of `ℙᴺ_A`, pulled back along a closed immersion, is a finite
affine cover.**

For `i : X ⟶ ℙᴺ_A` a closed immersion, the opens `Work.DSEQ0.chartCover A N i` (the pullbacks of
the charts `D₊(X_t)`, `t : Fin (N+1)`) are affine and cover `X`.

* affineness: `AlgebraicGeometry.Proj.isAffineOpen_basicOpen` (with `MvPolynomial.X t` homogeneous
  of degree `1`) together with `IsAffineHom.isAffine_preimage`, using the instance
  `[IsClosedImmersion i] → IsAffineHom i`;
* covering: `AlgebraicGeometry.Proj.iSup_basicOpen_eq_top` applied to the family of the variables
  (their span contains the irrelevant ideal — proved in this workspace, e.g.
  `Work.DSG2.Segre.irrelevant_le_span_X`), pulled back along `i` (preimages commute with `iSup`:
  `Scheme.Hom.iSup_preimage_eq_top`). -/

open CategoryTheory AlgebraicGeometry MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

universe a

/-- The irrelevant ideal of the graded polynomial ring `A[X₀,…,X_N]` (graded by total degree) is
contained in the ideal generated by the coordinates: every homogeneous element of positive degree
is a sum of monomials of positive degree, and such a monomial is divisible by some coordinate. -/
lemma irrelevant_toIdeal_le_span_X (A : Type a) [CommRing A] (N : ℕ) :
    (HomogeneousIdeal.irrelevant (DSMap.PGr A N)).toIdeal ≤
      Ideal.span (Set.range (fun i : Fin (N + 1) =>
        (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) A))) := by
  rw [show Ideal.span (Set.range (fun i : Fin (N + 1) =>
        (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) A))) =
      MvPolynomial.idealOfVars (Fin (N + 1)) A from rfl]
  rw [HomogeneousIdeal.toIdeal_irrelevant_le]
  intro i hi x hx
  change x ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A i at hx
  change x ∈ MvPolynomial.idealOfVars (Fin (N + 1)) A
  rw [← pow_one (MvPolynomial.idealOfVars (Fin (N + 1)) A)]
  rw [MvPolynomial.mem_pow_idealOfVars_iff']
  intro y hy
  obtain rfl : y = 0 := by rw [← Finsupp.degree_eq_zero_iff]; omega
  exact (MvPolynomial.mem_homogeneousSubmodule i x).mp hx |>.coeff_eq_zero (by simp; omega)

/-- The charts `D₊(X_t)` of `ℙᴺ_A` cover it. -/
lemma iSup_basicOpen_X_eq_top (A : Type a) [CommRing A] (N : ℕ) :
    (⨆ t : Fin (N + 1),
      Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X t : MvPolynomial (Fin (N + 1)) A)) = ⊤ :=
  Proj.iSup_basicOpen_eq_top (DSMap.PGr A N) (fun t : Fin (N + 1) => MvPolynomial.X t)
    (irrelevant_toIdeal_le_span_X A N)

theorem chartCover_facts {A : Type a} [CommRing A] (N : ℕ)
    {X : AlgebraicGeometry.Scheme.{a}} (i : X ⟶ DSMap.PSpace A N)
    [AlgebraicGeometry.IsClosedImmersion i] :
    (∀ t : ULift.{a} (Fin (N + 1)),
        AlgebraicGeometry.IsAffineOpen (Work.DSEQ0.chartCover A N i t)) ∧
      (⨆ t : ULift.{a} (Fin (N + 1)), Work.DSEQ0.chartCover A N i t) = ⊤ := by
  constructor
  · -- Affineness: `chartCover` is the preimage of the affine chart `D₊(X_t)`, and a closed
    -- immersion is affine, hence pulls affine opens back to affine opens.
    intro t
    exact IsAffineOpen.preimage
      (Proj.isAffineOpen_basicOpen (DSMap.PGr A N) (MvPolynomial.X t.down)
        (MvPolynomial.isHomogeneous_X A t.down) one_pos) i
  · -- Covering: the charts of `ℙᴺ_A` cover it, and preimages commute with `iSup`.
    change (⨆ t : ULift.{a} (Fin (N + 1)),
        i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X t.down)) = ⊤
    rw [iSup_ulift]
    exact i.iSup_preimage_eq_top (iSup_basicOpen_X_eq_top A N)

end Work.DSEQ0
