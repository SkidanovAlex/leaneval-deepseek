import Mathlib
import Submission.Work.DSEQ0.comp_d_apply
import Submission.Work.DSCOH.sum_product_swap_eq_zero
import Submission.Work.DSCOH.sum_attach_erase_eq_sum_product

/-!
# `Work.DSEQ0.ChartCompare` — the alternating (subset) Čech complex and its comparison with `cechZ`

For a finite family of opens `U : ι → X.Opens` of a scheme `X` over `A`, this file defines

* `SubCech U`, the *alternating* (or subset-indexed) Čech complex: in degree `q` it is the
  product, over the `(q+1)`-element subsets `S ⊆ ι`, of the sections `Γ(X, ⋂_{i ∈ S} U i)`, with
  the alternating Čech differential `(dc)_T = Σ_{i ∈ T} (-1)^{#{j ∈ T : j < i}} c_{T∖i}`;
* `subMap`, the comparison map `cech A X f U ⟶ SubCech U` given on the `S`-component by the
  evaluation at the *increasing* enumeration of `S`.

The comparison map is a quasi-isomorphism (`Work.DSEQ0.subMap_quasiIso`): the image-size
filtration reduces the statement to the sharp form of the surjection-complex vanishing
(`Work.DSEQ0.surjCech_top`), which says that the `(|S|-1)`-st cohomology of the surjection
complex on `S` is one-dimensional, generated by the alternating class attached to the increasing
enumeration.

This isolates the purely combinatorial content of the "normalisation" step of
`Work.DSEQ0.cechZ_chartCover_homology_finite` from the geometric bridge
(`SubCech (chartCover A N i) ≅ chartCech ℳ`).
-/

open CategoryTheory AlgebraicGeometry Limits Opposite
open scoped Simplicial BigOperators

namespace Work.DSEQ0

universe u

variable {A : Type u} [CommRing A] {X : Scheme.{u}} {ι : Type u} {f : X ⟶ Spec (.of A)}

section SignLemma

/-- The two signs attached to an ordered pair of distinct elements of a finset sum to zero.
(Generalisation of `Work.DSCOH.negOne_pow_card_filter_erase` from `Fin n` to an arbitrary
linear order.) -/
theorem negOne_pow_card_filter_erase_gen {α : Type*} [LinearOrder α] {T : Finset α} {i j : α}
    (hi : i ∈ T) (hj : j ∈ T) (hij : i ≠ j) :
    ((-1 : ℤ) ^ (T.filter (fun k => k < i)).card) *
        ((-1 : ℤ) ^ ((T.erase i).filter (fun k => k < j)).card)
      + ((-1 : ℤ) ^ (T.filter (fun k => k < j)).card) *
        ((-1 : ℤ) ^ ((T.erase j).filter (fun k => k < i)).card) = 0 := by
  have sign_key : ∀ a b : ℕ, 1 ≤ b →
      (-1 : ℤ) ^ a * (-1) ^ (b - 1) + (-1) ^ b * (-1) ^ a = 0 := by
    intro a b hb
    obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
    have h1 : b' + 1 - 1 = b' := by omega
    rw [h1, pow_succ]
    ring
  rcases lt_or_gt_of_ne hij with h | h
  · have hiB : i ∈ T.filter (fun k => k < j) := Finset.mem_filter.mpr ⟨hi, h⟩
    have hjA : j ∉ T.filter (fun k => k < i) := by
      intro hm; exact (not_lt.mpr h.le) (Finset.mem_filter.mp hm).2
    have hC1 : ((T.erase i).filter (fun k => k < j)).card
        = (T.filter (fun k => k < j)).card - 1 := by
      rw [Finset.filter_erase]; exact Finset.card_erase_of_mem hiB
    have hC2 : ((T.erase j).filter (fun k => k < i)).card
        = (T.filter (fun k => k < i)).card := by
      rw [Finset.filter_erase, Finset.erase_eq_of_notMem hjA]
    rw [hC1, hC2]
    exact sign_key _ _ (Finset.card_pos.mpr ⟨i, hiB⟩)
  · have hjA : j ∈ T.filter (fun k => k < i) := Finset.mem_filter.mpr ⟨hj, h⟩
    have hiB : i ∉ T.filter (fun k => k < j) := by
      intro hm; exact (not_lt.mpr h.le) (Finset.mem_filter.mp hm).2
    have hC1 : ((T.erase i).filter (fun k => k < j)).card
        = (T.filter (fun k => k < j)).card := by
      rw [Finset.filter_erase, Finset.erase_eq_of_notMem hiB]
    have hC2 : ((T.erase j).filter (fun k => k < i)).card
        = (T.filter (fun k => k < i)).card - 1 := by
      rw [Finset.filter_erase]; exact Finset.card_erase_of_mem hjA
    rw [hC1, hC2, add_comm]
    exact sign_key _ _ (Finset.card_pos.mpr ⟨j, hjA⟩)


end SignLemma

section Res

/-- `res` is insensitive to the proof of the inclusion. -/
theorem res_congr (U : ι → X.Opens) (S T : Set ι) (h h' : S ⊆ T) :
    res A X f U S T h = res A X f U S T h' := by
  unfold res
  congr 1

/-- Composition rule for `res`. -/
theorem res_comp_apply (U : ι → X.Opens) {S T V : Set ι} (h : S ⊆ T) (h' : T ⊆ V)
    (h'' : S ⊆ V) :
    res A X f U S V h'' = res A X f U S T h ≫ res A X f U T V h' := by
  rw [res_comp, res_congr (A := A) (X := X) (f := f) U S V (h.trans h') h'']

end Res

section Terms

variable [LinearOrder ι]

/-- The `q`-th term of the alternating Čech complex: the product over the `(q+1)`-element
subsets `S` of the coefficient module `Γ(X, ⋂_{i ∈ S} U i)`. -/
abbrev SubCechTerm (U : ι → X.Opens) (q : ℕ) : Type u :=
  ∀ S : {S : Finset ι // S.card = q + 1}, coeff A X f U (↑S.1 : Set ι)

/-- The `T`-component of the alternating Čech differential. -/
noncomputable def subCechDiffComp (U : ι → X.Opens) (q : ℕ)
    (T : {S : Finset ι // S.card = q + 1 + 1}) :
    SubCechTerm (A := A) (X := X) (f := f) U q →ₗ[A] coeff A X f U (↑T.1 : Set ι) :=
  ∑ i ∈ T.1.attach,
    (-1 : ℤ) ^ ((T.1.filter fun j => j < i.1)).card •
      ((res A X f U (↑(T.1.erase i.1) : Set ι) (↑T.1 : Set ι)
          (Finset.coe_subset.mpr (Finset.erase_subset i.1 T.1))).hom.comp
        (LinearMap.proj (R := A)
          (φ := fun S : {S : Finset ι // S.card = q + 1} => coeff A X f U (↑S.1 : Set ι))
          ⟨T.1.erase i.1, by rw [Finset.card_erase_of_mem i.2]; omega⟩))

/-- The alternating Čech differential. -/
noncomputable def subCechDiff (U : ι → X.Opens) (q : ℕ) :
    SubCechTerm (A := A) (X := X) (f := f) U q →ₗ[A]
      SubCechTerm (A := A) (X := X) (f := f) U (q + 1) :=
  LinearMap.pi (R := A) fun T => subCechDiffComp (A := A) (X := X) (f := f) U q T

/-- Heterogeneous equality of the values of a dependent function at equal arguments. -/
theorem heq_apply_of_eq {α : Type*} {β : α → Type*} {a b : α} (h : a = b)
    (g : (i : α) → β i) : HEq (g a) (g b) := by
  subst h
  rfl

/-- The two composite restrictions collapse to a single one. -/
theorem res_res_apply (U : ι → X.Opens) {S T V : Set ι} (h : S ⊆ T) (h' : T ⊆ V)
    (y : coeff A X f U S) :
    (res A X f U T V h').hom ((res A X f U S T h).hom y)
      = (res A X f U S V (h.trans h')).hom y := by
  rw [← res_comp (A := A) (X := X) (f := f) U h h', ModuleCat.hom_comp]
  rfl

/-- Two restrictions with equal sources agree. -/
theorem res_eq_of_eq (U : ι → X.Opens) {S S' T : Set ι} (hS : S = S') (h : S ⊆ T)
    (h' : S' ⊆ T) {y : coeff A X f U S} {y' : coeff A X f U S'} (hy : HEq y y') :
    (res A X f U S T h).hom y = (res A X f U S' T h').hom y' := by
  subst hS
  rw [eq_of_heq hy]

/-- **The alternating Čech differential squares to zero.** -/
theorem subCechDiff_comp (U : ι → X.Opens) (q : ℕ) :
    (subCechDiff (A := A) (X := X) (f := f) U (q + 1)).comp
      (subCechDiff (A := A) (X := X) (f := f) U q) = 0 := by
  apply LinearMap.ext; intro x
  funext T
  simp only [LinearMap.comp_apply, LinearMap.zero_apply]
  simp only [subCechDiff, LinearMap.pi_apply, subCechDiffComp, LinearMap.sum_apply,
    LinearMap.smul_apply, LinearMap.comp_apply, Pi.zero_apply, LinearMap.proj_apply]
  simp only [map_sum, map_zsmul, Finset.smul_sum, smul_smul, res_res_apply]
  let pairCoeff : ι → ι → ℤ := fun i j =>
    (-1 : ℤ) ^ ((T.1.filter (fun k => k < i)).card) *
      (-1 : ℤ) ^ (((T.1.erase i).filter (fun k => k < j)).card)
  let G : (i : ι) → i ∈ T.1 → (j : ι) → j ∈ T.1.erase i → coeff A X f U (↑T.1 : Set ι) :=
    fun i hi j hj => pairCoeff i j •
      (res A X f U (↑((T.1.erase i).erase j) : Set ι) (↑T.1 : Set ι)
        ((Finset.coe_subset.mpr (Finset.erase_subset j (T.1.erase i))).trans
          (Finset.coe_subset.mpr (Finset.erase_subset i T.1)))).hom
        (x ⟨(T.1.erase i).erase j, by
          rw [Finset.card_erase_of_mem hj, Finset.card_erase_of_mem hi]; omega⟩)
  let pairFun : ι × ι → coeff A X f U (↑T.1 : Set ι) := fun p =>
    if h : p.1 ∈ T.1 ∧ p.2 ∈ T.1.erase p.1 then G p.1 h.1 p.2 h.2 else 0
  rw [Work.DSCOH.sum_attach_erase_eq_sum_product (G := G)]
  show ∑ p ∈ T.1 ×ˢ T.1, pairFun p = 0
  have hdiag : ∀ i ∈ T.1, pairFun (i, i) = 0 := by
    intro i hi
    show (if h : i ∈ T.1 ∧ i ∈ T.1.erase i then G i h.1 i h.2 else 0) = 0
    rw [dite_eq_right]
    rintro ⟨-, h2⟩
    exact (Finset.mem_erase.mp h2).1 rfl
  have hswap : ∀ p ∈ T.1 ×ˢ T.1, pairFun p.swap = - pairFun p := by
    rintro ⟨i, j⟩ hp
    have hi : i ∈ T.1 := (Finset.mem_product.mp hp).1
    have hj : j ∈ T.1 := (Finset.mem_product.mp hp).2
    show pairFun (j, i) = - pairFun (i, j)
    by_cases hij : i = j
    · subst hij
      rw [hdiag i hi, neg_zero]
    · have hgi : i ∈ T.1 ∧ j ∈ T.1.erase i := ⟨hi, Finset.mem_erase.mpr ⟨Ne.symm hij, hj⟩⟩
      have hgj : j ∈ T.1 ∧ i ∈ T.1.erase j := ⟨hj, Finset.mem_erase.mpr ⟨hij, hi⟩⟩
      show (if h : j ∈ T.1 ∧ i ∈ T.1.erase j then G j h.1 i h.2 else 0) =
        - (if h : i ∈ T.1 ∧ j ∈ T.1.erase i then G i h.1 j h.2 else 0)
      rw [dite_eq_left hgj, dite_eq_left hgi]
      have hset : (T.1.erase j).erase i = (T.1.erase i).erase j :=
        (Finset.erase_right_comm (a := i) (b := j)).symm
      have hsub1 : (↑((T.1.erase j).erase i) : Set ι) ⊆ (↑T.1 : Set ι) :=
        (Finset.coe_subset.mpr (Finset.erase_subset i (T.1.erase j))).trans
          (Finset.coe_subset.mpr (Finset.erase_subset j T.1))
      have hsub2 : (↑((T.1.erase i).erase j) : Set ι) ⊆ (↑T.1 : Set ι) :=
        (Finset.coe_subset.mpr (Finset.erase_subset j (T.1.erase i))).trans
          (Finset.coe_subset.mpr (Finset.erase_subset i T.1))
      have hval : (res A X f U (↑((T.1.erase j).erase i) : Set ι) (↑T.1 : Set ι) hsub1).hom
            (x ⟨(T.1.erase j).erase i, by
              rw [Finset.card_erase_of_mem hgj.2, Finset.card_erase_of_mem hgj.1]; omega⟩)
          = (res A X f U (↑((T.1.erase i).erase j) : Set ι) (↑T.1 : Set ι) hsub2).hom
            (x ⟨(T.1.erase i).erase j, by
              rw [Finset.card_erase_of_mem hgi.2, Finset.card_erase_of_mem hgi.1]; omega⟩) :=
        res_eq_of_eq (A := A) (X := X) (f := f) U (S := (↑((T.1.erase j).erase i) : Set ι))
          (S' := (↑((T.1.erase i).erase j) : Set ι)) (by rw [hset]) hsub1 hsub2
          (heq_apply_of_eq (Subtype.ext hset) x)
      have hcoe : pairCoeff j i + pairCoeff i j = 0 := by
        simp only [pairCoeff]
        exact negOne_pow_card_filter_erase_gen hj hi (Ne.symm hij)
      rw [show G j hgj.1 i hgj.2 = pairCoeff j i •
            (res A X f U (↑((T.1.erase j).erase i) : Set ι) (↑T.1 : Set ι) hsub1).hom
              (x ⟨(T.1.erase j).erase i, by
                rw [Finset.card_erase_of_mem hgj.2, Finset.card_erase_of_mem hgj.1]; omega⟩)
            from rfl,
          show G i hgi.1 j hgi.2 = pairCoeff i j •
            (res A X f U (↑((T.1.erase i).erase j) : Set ι) (↑T.1 : Set ι) hsub2).hom
              (x ⟨(T.1.erase i).erase j, by
                rw [Finset.card_erase_of_mem hgi.2, Finset.card_erase_of_mem hgi.1]; omega⟩)
            from rfl,
          hval, eq_neg_of_add_eq_zero_right hcoe, neg_smul, neg_neg]
  exact Work.DSCOH.sum_product_swap_eq_zero T.1 pairFun hswap hdiag

/-- **The alternating Čech complex** of a family of opens. -/
noncomputable def SubCech (U : ι → X.Opens) : CochainComplex (ModuleCat A) ℕ :=
  CochainComplex.of (fun q => ModuleCat.of A (SubCechTerm (A := A) (X := X) (f := f) U q))
    (fun q => ModuleCat.ofHom (subCechDiff (A := A) (X := X) (f := f) U q))
    (fun q => by
      rw [← ModuleCat.ofHom_comp, subCechDiff_comp]
      exact ModuleCat.ofHom_zero)

/-- The `S`-component of the comparison map: the evaluation at the increasing enumeration
of the subset `S`. -/
noncomputable def subProj (U : ι → X.Opens) (q : ℕ)
    (S : {S : Finset ι // S.card = q + 1}) :
    (DSMap.cech A X f U).X q ⟶ coeff A X f U (↑S.1 : Set ι) :=
  comp A X f U q (fun i => (S.1.orderEmbOfFin S.2 i : ι)) ≫
    eqToHom (congrArg (coeff A X f U)
      (Finset.range_orderEmbOfFin S.1 S.2 :
        Set.range (fun i : Fin (q + 1) => (S.1.orderEmbOfFin S.2 i : ι)) = (↑S.1 : Set ι)))

/-- **The comparison map** `cech A X f U ⟶ SubCech U`: on the `S`-component it evaluates at the
increasing enumeration of `S`. -/
noncomputable def subMap (U : ι → X.Opens) (q : ℕ) :
    (DSMap.cech A X f U).X q ⟶ ModuleCat.of A (SubCechTerm (A := A) (X := X) (f := f) U q) :=
  ModuleCat.ofHom (LinearMap.pi (R := A) fun S => (subProj (A := A) (X := X) (f := f) U q S).hom)

end Terms

end Work.DSEQ0
