import Mathlib
import Submission.Work.DSMap.Map
import Submission.Work.DSEQ0.ChartCover
import Submission.Work.DSEQ0.ChartCompare
import Submission.Work.DSCOH.chartCech_finite_vanishing
import Submission.Work.DSEQ0.surjCech_vanishing
import Submission.Work.DSEQ0.subMap_quasiIso
import Submission.Work.DSEQ0.subCech_chartCover_chartCech

namespace Work.DSEQ0

/-! **Coherence of the Cech complex of the standard chart cover of a projective scheme.**

For `A` Noetherian, `N : ℕ` and a closed immersion `i : X ⟶ ℙᴺ_A = DSMap.PSpace A N` (so `X` is
a closed subscheme of projective space over `A`), the (unnormalised) Cech complex of the
structure sheaf of `X` with respect to the chart cover
`Work.DSEQ0.chartCover A N i` (the opens `X ∩ D₊(X_t)`, `t : Fin (N+1)`) has finitely generated
homology over `A`, vanishing above some degree.

Route.  Two pieces are needed, both stated independently of this one and worth delegating
separately if desired:

* **Bridge.**  Exhibit a finitely generated graded `S = A[X₀,…,X_N]`-module whose degree-zero
  chart localisations `Work.DSCOH.degZero ℳ S` are the chart rings `Γ(X, ⋂_{t∈S} chartCover t)`,
  compatibly with the restriction maps, so that the increasing-tuple Cech complex of the chart
  cover of `X` is `Work.DSCOH.chartCech ℳ`.  The homogeneous ideal is obtained by saturating the
  ideal generated by the "cleared" chart equations: for the chart `t`, the kernel
  `I_t ⊆ Γ(D₊(X_t), O_{ℙ^N})` of the restriction along `i` (`Scheme.Hom.app_surjective` with
  `IsClosedImmersion.isAffineHom` and `Proj.isAffineOpen_basicOpen`); the chart rings of `X` are
  then the degree-zero parts of the localisation of `S/I` at the monomial `X_S`.
* **Normalisation.**  `Work.DSCOH.chartCech` is indexed by subsets (increasing tuples), while
  `DSMap.cechZ` is indexed by *all* tuples; for a coefficient system whose value on a tuple
  depends only on its image set the two have the same homology (image-size filtration +
  `Work.DSEQ0.surjCech_vanishing`, which already proves the vanishing of the *surjection*
  complexes above their size; alternatively the Dold–Kan normalisation of the Cech cosimplicial
  object).

With the bridge and the normalisation, `Work.DSCOH.chartCech_finite_vanishing` (available,
axiom-clean) gives the conclusion. -/

universe a

section IsoTransfer

/-- Transfer of `Module.Finite` backwards along an isomorphism of `A`-modules. -/
theorem moduleFinite_of_iso {A : Type a} [CommRing A] {P Q : ModuleCat.{a} A} (e : P ≅ Q)
    (h : Module.Finite A P) : Module.Finite A Q := by
  haveI := h
  exact Module.Finite.of_surjective e.hom.hom
    (CategoryTheory.ConcreteCategory.bijective_of_isIso e.hom).2

/-- Transfer of `IsZero` along an isomorphism. -/
theorem isZero_of_iso {A : Type a} [CommRing A] {P Q : ModuleCat.{a} A} (e : P ≅ Q)
    (h : CategoryTheory.Limits.IsZero P) : CategoryTheory.Limits.IsZero Q :=
  e.isZero_iff.mp h

end IsoTransfer

theorem cechZ_chartCover_homology_finite {A : Type a} [CommRing A] [IsNoetherianRing A]
    (N : ℕ) (X : AlgebraicGeometry.Scheme.{a}) (i : X ⟶ DSMap.PSpace A N)
    [AlgebraicGeometry.IsClosedImmersion i] :
    ∃ M : ℤ, ∀ q : ℤ,
      Module.Finite A ((DSMap.cechZ A X (Work.DSEQ0.chartCoverToSpec A N i)
          (Work.DSEQ0.chartCover A N i)).homology q) ∧
      (M < q → CategoryTheory.Limits.IsZero ((DSMap.cechZ A X (Work.DSEQ0.chartCoverToSpec A N i)
          (Work.DSEQ0.chartCover A N i)).homology q)) := by
  -- The bridge: the alternating Čech complex of the chart cover is the chart Čech complex of a
  -- finitely generated graded module over `A[X₀,…,X_N]`.
  obtain ⟨M, h1, h2, h3, h4, ℳ, h5, h6, h7, hbr⟩ := subCech_chartCover_chartCech A N X i
  letI := h1; letI := h2; letI := h3; letI := h4; letI := h5; letI := h6; letI := h7
  -- Serre finiteness and vanishing for the chart Čech complex of a finitely generated graded
  -- module.
  obtain ⟨hfin, hvan⟩ := Work.DSCOH.chartCech_finite_vanishing (A := A) (n := N + 1) (M := M) ℳ
  -- The normalisation: the unordered and the alternating Čech complexes of the chart cover have
  -- the same homology.
  have hcmp : ∀ q : ℕ,
      Nonempty ((DSMap.cech A X (chartCoverToSpec A N i) (chartCover A N i)).homology q
        ≅ (SubCech (A := A) (X := X) (f := chartCoverToSpec A N i)
            (chartCover A N i)).homology q) :=
    fun q => subMap_quasiIso (A := A) (X := X) (f := chartCoverToSpec A N i)
      (chartCover A N i) q
  have hfinSub : ∀ n : ℕ, Module.Finite A
      ((SubCech (A := A) (X := X) (f := chartCoverToSpec A N i) (chartCover A N i)).homology n) :=
    fun n => (hbr n).elim fun e => moduleFinite_of_iso e.symm (hfin n)
  have hfinc : ∀ n : ℕ, Module.Finite A
      ((DSMap.cech A X (chartCoverToSpec A N i) (chartCover A N i)).homology n) :=
    fun n => (hcmp n).elim fun e => moduleFinite_of_iso e.symm (hfinSub n)
  have hvanc : ∀ n : ℕ, N + 1 < n → CategoryTheory.Limits.IsZero
      ((DSMap.cech A X (chartCoverToSpec A N i) (chartCover A N i)).homology n) :=
    fun n hn => (hcmp n).elim fun e => isZero_of_iso e.symm
      ((hbr n).elim fun e' => isZero_of_iso e'.symm (hvan n hn))
  refine ⟨(N : ℤ) + 1, fun q => ⟨?_, ?_⟩⟩
  · -- finiteness: negative degrees are zero, non-negative degrees reduce to `cech`
    rcases lt_or_ge q 0 with hq | hq
    · rw [show DSMap.cechZ A X (chartCoverToSpec A N i) (chartCover A N i)
          = (DSMap.cech A X (chartCoverToSpec A N i) (chartCover A N i)).extend
            ComplexShape.embeddingUpNat from rfl]
      exact Work.DSCOH.moduleFinite_of_isZero (CochainComplex.isZero_of_isGE _ 0 q hq)
    · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hq
      exact moduleFinite_of_iso (HomologicalComplex.extendHomologyIso
        (DSMap.cech A X (chartCoverToSpec A N i) (chartCover A N i))
        ComplexShape.embeddingUpNat rfl).symm (hfinc n)
  · -- vanishing above `N + 1`
    intro hq
    obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : (0 : ℤ) ≤ q)
    exact isZero_of_iso (HomologicalComplex.extendHomologyIso
      (DSMap.cech A X (chartCoverToSpec A N i) (chartCover A N i))
      ComplexShape.embeddingUpNat rfl).symm (hvanc n (by exact_mod_cast hq))

end Work.DSEQ0