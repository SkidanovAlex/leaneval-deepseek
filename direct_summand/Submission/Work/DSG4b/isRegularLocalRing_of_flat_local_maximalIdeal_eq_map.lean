import Mathlib
import Submission.Work.DSG4b.flat_local_le_ringKrullDim

/-!
# DSG4b — bookkeeping: a flat local extension generated by the base maximal ideal is regular

Let `R` be a regular local ring and `f : R →+* B` a flat local homomorphism to a local ring `B`
whose maximal ideal is generated by the images of a *minimal* generating family `s` of `𝔪_R`
(i.e. `s.card = spanFinrank 𝔪_R` and `span s = 𝔪_R`).  Then `B` is again a regular local ring.

Indeed `spanFinrank 𝔪_B ≤ s.card = spanFinrank 𝔪_R = ringKrullDim R ≤ ringKrullDim B`: the first
inequality because `𝔪_B` is spanned by the `s.card` images of the elements of `s`
(`Submodule.spanFinrank_span_le_ncard_of_finite`), the equality is regularity of `R`, and the last
inequality is `Work.DSG4b.flat_local_le_ringKrullDim` (going-down for flat local maps).  Together
with `ringKrullDim_le_spanFinrank_maximalIdeal` this forces `spanFinrank 𝔪_B = ringKrullDim B`,
i.e. regularity.

This is exactly the bookkeeping needed for the `𝔪`-adic completion of a residue-field enlargement:
the completion keeps the maximal ideal generated by the `dim R` generators of `𝔪_R`, so the
completion of the enlargement is regular local.
-/

namespace Work.DSG4b

universe u

open IsLocalRing

/-- A flat local extension of a regular local ring whose maximal ideal is spanned by the images of
a minimal generating family of the base maximal ideal is regular local. -/
theorem isRegularLocalRing_of_flat_local_maximalIdeal_eq_span {R B : Type u} [CommRing R]
    [IsRegularLocalRing R] [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (f : R →+* B)
    [IsLocalHom f] (hf : f.Flat) (s : Finset R)
    (hspan : Ideal.span (s : Set R) = maximalIdeal R)
    (hcard : s.card = (maximalIdeal R).spanFinrank)
    (hmax : maximalIdeal B = Ideal.span ((s : Set R).image f)) : IsRegularLocalRing B := by
  letI : Algebra R B := f.toAlgebra
  haveI : Module.Flat R B := hf
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le B ?_
  have h2 : (maximalIdeal B).spanFinrank ≤ (maximalIdeal R).spanFinrank := by
    rw [hmax, ← hcard]
    calc (Submodule.span B (f '' (s : Set R))).spanFinrank
        ≤ (f '' (s : Set R)).ncard :=
          Submodule.spanFinrank_span_le_ncard_of_finite ((Finset.finite_toSet s).image f)
      _ ≤ (s : Set R).ncard := Set.ncard_image_le (Finset.finite_toSet s)
      _ = s.card := Set.ncard_coe_finset s
  have h3 : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) = ringKrullDim R :=
    (isRegularLocalRing_iff R).mp (inferInstance : IsRegularLocalRing R)
  have h4 : ringKrullDim R ≤ ringKrullDim B := flat_local_le_ringKrullDim f hf
  calc ((maximalIdeal B).spanFinrank : WithBot ℕ∞)
      ≤ ((maximalIdeal R).spanFinrank : WithBot ℕ∞) := by exact_mod_cast h2
    _ = ringKrullDim R := h3
    _ ≤ ringKrullDim B := h4

end Work.DSG4b
