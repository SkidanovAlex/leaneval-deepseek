import Mathlib

/-!
# The Rees ideal of an ideal with respect to `I`

For ideals `I`, `J` of a commutative ring `A` we define the *Rees ideal* of `J` with respect to `I`

`𝔍 = ⨁_k (J ∩ I^k) X^k ⊆ A[IX] ⊆ A[X]`,

i.e. the `reesAlgebra I`-ideal of `A[X]` consisting of those polynomials (with coefficients in the
Rees algebra) all of whose `k`-th coefficients lie in `J ⊓ I^k`.

This is the object used in the proof that the `I`-adic completion of a Noetherian ring is
Noetherian (Stacks 05GH, EGA 0_I 7.3.6): for a complete and separated `A` with `gr_I(A)` Noetherian,
`gr(𝔍) = 𝔍/(𝔍 ∩ I·A[IX])` is an ideal of the Noetherian ring `gr_I(A)`, hence finitely generated,
which provides the finitely many elements of `J` exhibiting `J` as finitely generated.
-/

namespace Work.DSG4b

open Polynomial

variable {A : Type*} [CommRing A]

/-- The *Rees ideal* of `J` with respect to `I`: the ideal of the Rees algebra `A[IX]` generated by
the monomials `a X^k` with `a ∈ J ⊓ I^k`, i.e. the `A[IX]`-submodule `⨁_k (J ∩ I^k) X^k` of `A[X]`.

It is an ideal of `A[IX]` (but *not* of `A[X]`: multiplying by `X` sends the coefficient in degree
`k` into `I^{k+1} ≤ I^k`). -/
def reesIdealOf (I J : Ideal A) : Ideal (reesAlgebra I) where
  carrier := {p | ∀ k, (p : Polynomial A).coeff k ∈ J ⊓ I ^ k}
  add_mem' := by
    intro p q hp hq k
    rw [Subalgebra.coe_add, Polynomial.coeff_add]
    exact add_mem (hp k) (hq k)
  zero_mem' := by
    intro k
    rw [Subalgebra.coe_zero, Polynomial.coeff_zero]
    exact zero_mem _
  smul_mem' := by
    intro c p hp k
    change ((c * p : reesAlgebra I) : Polynomial A).coeff k ∈ J ⊓ I ^ k
    have hc : ∀ i, (c : Polynomial A).coeff i ∈ I ^ i := (mem_reesAlgebra_iff I _).mp c.2
    rw [Subalgebra.coe_mul, Polynomial.coeff_mul]
    refine Submodule.sum_mem _ ?_
    rintro ⟨i, j⟩ hij
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
    subst hij
    refine ⟨J.mul_mem_left _ (hp j).1, ?_⟩
    rw [pow_add]
    exact Ideal.mul_mem_mul (hc i) (hp j).2

variable (I J : Ideal A)

theorem mem_reesIdealOf {p : reesAlgebra I} :
    p ∈ reesIdealOf I J ↔ ∀ k, (p : Polynomial A).coeff k ∈ J ⊓ I ^ k := Iff.rfl

theorem coeff_mem_of_mem_reesIdealOf {p : reesAlgebra I} (hp : p ∈ reesIdealOf I J) (k : ℕ) :
    (p : Polynomial A).coeff k ∈ J ⊓ I ^ k := hp k

/-- The `k`-th homogeneous component of an element of the Rees ideal again lies in the Rees
ideal. -/
theorem monomial_coeff_mem_reesIdealOf {p : reesAlgebra I} (hp : p ∈ reesIdealOf I J) (k : ℕ) :
    (⟨Polynomial.monomial k ((p : Polynomial A).coeff k),
        reesAlgebra.monomial_mem.mpr (hp k).2⟩ : reesAlgebra I) ∈ reesIdealOf I J := by
  rw [mem_reesIdealOf]
  intro l
  change (Polynomial.monomial k ((p : Polynomial A).coeff k)).coeff l ∈ J ⊓ I ^ l
  rw [Polynomial.coeff_monomial]
  split_ifs with h
  · rw [← h]; exact hp k
  · exact zero_mem _

theorem monomial_mem_reesIdealOf {k : ℕ} {a : A} (ha : a ∈ J ⊓ I ^ k) :
    (⟨Polynomial.monomial k a, reesAlgebra.monomial_mem.mpr (show a ∈ I ^ k from ha.2)⟩ :
      reesAlgebra I) ∈ reesIdealOf I J := by
  rw [mem_reesIdealOf]
  intro l
  change (Polynomial.monomial k a).coeff l ∈ J ⊓ I ^ l
  rw [Polynomial.coeff_monomial]
  split_ifs with h
  · rw [← h]; exact ha
  · exact zero_mem _

theorem monomial_mem_reesIdealOf_iff {k : ℕ} {a : A} (ha : a ∈ I ^ k) :
    (⟨Polynomial.monomial k a, reesAlgebra.monomial_mem.mpr ha⟩ : reesAlgebra I) ∈
        reesIdealOf I J ↔
      a ∈ J := by
  constructor
  · intro h
    have := coeff_mem_of_mem_reesIdealOf I J h k
    change (Polynomial.monomial k a).coeff k ∈ J ⊓ I ^ k at this
    rw [Polynomial.coeff_monomial, ite_eq_left rfl] at this
    exact this.1
  · intro h
    exact monomial_mem_reesIdealOf I J ⟨h, ha⟩

end Work.DSG4b
