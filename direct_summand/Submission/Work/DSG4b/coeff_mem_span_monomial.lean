import Mathlib

/-!
# The `n`-th coefficient of an element of the span of monomials

`reesAlgebra I` is the Rees algebra `A[IX] ⊆ A[X]`.  Its `n`-th coefficient functional sends an
element `r` to `r.coeff n ∈ I ^ n`.

Fix a family of generators `g j ∈ I ^ (d j)` and consider the ideal of `A[IX]` generated by the
monomials `g j * X ^ (d j)`.  For `k` in that ideal we produce coefficients `a j ∈ I ^ (n - d j)`
such that the `n`-th coefficient of `k` is `∑ j, a j * g j`: writing `k = ∑ j, c j * (g j X ^ dj)`
with `c j ∈ A[IX]`, the `j`-th term has `n`-th coefficient `c j.coeff (n - dj) * g j` when
`dj ≤ n` and `0` otherwise, and the coefficient of a Rees algebra element in degree `n - dj` lies in
`I ^ (n - dj)` (which is `⊤` when `dj > n`, so the choice `a j = 0` is allowed there).
-/

namespace Work.DSG4b

/-- The `n`-th coefficient of `p * (monomial d r)`, a two-line consequence of
`Polynomial.coeff_mul_X_pow'`. -/
private lemma coeff_mul_monomial_aux {A : Type*} [CommRing A] (p : Polynomial A) (n d : ℕ)
    (r : A) : (p * Polynomial.monomial d r).coeff n = if d ≤ n then p.coeff (n - d) * r else 0 := by
  rw [← Polynomial.C_mul_X_pow_eq_monomial, ← mul_assoc, Polynomial.coeff_mul_X_pow']
  simp

theorem coeff_mem_span_monomial {A : Type*} [CommRing A] {I : Ideal A}
    {ι : Type*} [Fintype ι] {g : ι → A} {d : ι → ℕ} (hmem : ∀ j, g j ∈ I ^ (d j))
    {n : ℕ} {k : reesAlgebra I}
    (hk : k ∈ Ideal.span (Set.range fun j => (⟨Polynomial.monomial (d j) (g j),
        reesAlgebra.monomial_mem.mpr (hmem j)⟩ : reesAlgebra I))) :
    ∃ a : ι → A, (∀ j, a j ∈ I ^ (n - d j)) ∧ (k : Polynomial A).coeff n = ∑ j, a j * g j := by
  let m : ι → reesAlgebra I := fun j =>
    ⟨Polynomial.monomial (d j) (g j), reesAlgebra.monomial_mem.mpr (hmem j)⟩
  have hk' : k ∈ Ideal.span (Set.range m) := hk
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hk'
  refine ⟨fun j => if d j ≤ n then (c j : Polynomial A).coeff (n - d j) else 0, ?_, ?_⟩
  · -- the coefficients of a Rees algebra element in degree `n - d j` lie in `I ^ (n - d j)`
    intro j
    by_cases h : d j ≤ n
    · simp only [h, ite_true]
      exact (mem_reesAlgebra_iff I _).mp (c j).2 (n - d j)
    · -- here `d j > n`, so `n - d j = 0` and `I ^ (n - d j) = ⊤`
      simp only [h, ite_false]
      rw [show n - d j = 0 from Nat.sub_eq_zero_of_le (le_of_lt (lt_of_not_ge h))]
      simp
  · -- the `n`-th coefficient of `k = ∑ j, c j * m j`
    rw [← hc]
    rw [show ((∑ i, c i * m i : reesAlgebra I) : Polynomial A)
        = ∑ i, (c i : Polynomial A) * Polynomial.monomial (d i) (g i) by simp [m]]
    rw [show (∑ i, (c i : Polynomial A) * Polynomial.monomial (d i) (g i)).coeff n
        = ∑ i, ((c i : Polynomial A) * Polynomial.monomial (d i) (g i)).coeff n by simp]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [coeff_mul_monomial_aux]
    by_cases h : d i ≤ n
    · simp [h]
    · simp [h]

end Work.DSG4b
