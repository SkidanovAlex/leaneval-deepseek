import Mathlib
import Submission.Work.DSG4b.GonfDefs

/-!
# DSG4b, `uRingKey` — the fibre of the `U`-part

`Work.DSG4b.uRing S = S[X_α : α ∈ K] ⧸ ((uPoly S α)(X_α))` (`K = AlgebraicClosure L`,
`L = ResidueField S`) is flat over `S` (`Work.DSG4b.uRing_flat`) and evaluates onto `K`
(`Work.DSG4b.uEv S`, `X_α ↦ α`).

This file builds the **fibre** of the `U`-part over a local ring `R` mapping to `S` with
`𝔪_R S = 𝔪_S`, that is the quotient `A ⧸ 𝔪_R A`:

* `uFibre S = L[X_α : α ∈ K] ⧸ ((minpoly L α)(X_α))`,
* `uFibreEval S : uFibre S →+* K`, `X_α ↦ α`, and its `L`-algebra structure `uFibreEvalAlg`,
* `uRed S : uRing S →+* uFibre S`, the reduction of the coefficients along `IsLocalRing.residue S`,
* `uEv S = (uFibreEval S).comp (uRed S)` (`uEv_eq_uFibreEval_comp_uRed`), and `uRed S` is
  surjective (`uRed_surjective`).

The final fact — that `ker (uRed S)` is the ideal generated by `𝔪_R`, equivalently that
`A ⧸ 𝔪_R A ≅ uFibre S` — is `uRed_ker_eq_aux` below (the same statement is also proved
independently in `Submission/Work/DSG4b/uRingKey/uRed_ker_eq.lean`); it is the input to
`Work.DSG4b.uRingKey.uRing_ker_exists_mul_mem`.

Two general ring-theoretic lemmas used both here and there:

* `comap_span_range_eq_sup_ker`: for surjective `f`, the preimage of the ideal generated by the
  images `f (g i)` is generated by the `g i` together with `ker f`;
* `ker_map_C`: the kernel of `MvPolynomial.map f` is the ideal generated by the coefficients
  in `ker f`.
-/

universe a b c

namespace Work.DSG4b.uRingKey

/-! ## General ring-theoretic lemmas -/

/-- The preimage under a surjective ring hom `f` of the ideal generated by the images `f (g i)` is
generated by the `g i` together with `ker f`. -/
lemma comap_span_range_eq_sup_ker {A : Type a} {B : Type b} [CommRing A] [CommRing B]
    (f : A →+* B) (hf : Function.Surjective f) {ι : Type c} (g : ι → A) :
    (Ideal.span (Set.range fun i => f (g i))).comap f
      = Ideal.span (Set.range g) ⊔ RingHom.ker f := by
  have hspan : Ideal.span (Set.range fun i => f (g i))
      = Ideal.map f (Ideal.span (Set.range g)) := by
    rw [Ideal.map_span]
    congr 1
    ext x
    simp
  rw [hspan]
  ext p
  rw [Ideal.mem_comap, Ideal.mem_map_iff_of_surjective f hf]
  constructor
  · rintro ⟨x, hx, hxp⟩
    refine Submodule.mem_sup.mpr ⟨x, hx, p - x, ?_, ?_⟩
    · rw [RingHom.mem_ker, map_sub, hxp, sub_self]
    · rw [add_comm]; exact sub_add_cancel p x
  · intro hp
    obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp hp
    exact ⟨x, hx, by rw [← hxy, map_add, RingHom.mem_ker.mp hy, add_zero]⟩

/-- The kernel of `MvPolynomial.map f` is the ideal generated by the coefficients in `ker f`. -/
lemma ker_map_C {R : Type a} {S : Type b} [CommRing R] [CommRing S] {σ : Type c}
    (f : R →+* S) :
    RingHom.ker (MvPolynomial.map f)
      = (RingHom.ker f).map (MvPolynomial.C : R →+* MvPolynomial σ R) := by
  ext p
  rw [RingHom.mem_ker]
  constructor
  · intro hp
    have hcoeff : ∀ m : σ →₀ ℕ, p.coeff m ∈ RingHom.ker f := by
      intro m
      rw [RingHom.mem_ker, ← MvPolynomial.coeff_map f p m, hp]
      simp
    rw [MvPolynomial.as_sum p]
    refine Ideal.sum_mem _ fun v _ => ?_
    rw [MvPolynomial.monomial_eq]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem MvPolynomial.C (hcoeff v))
  · intro hp
    have hgen : ∀ x ∈ RingHom.ker f,
        MvPolynomial.map f ((MvPolynomial.C : R →+* MvPolynomial σ R) x) = 0 := by
      intro x hx
      rw [MvPolynomial.map_C, RingHom.mem_ker.mp hx, map_zero]
    have hle : (RingHom.ker f).map (MvPolynomial.C : R →+* MvPolynomial σ R)
        ≤ RingHom.ker (MvPolynomial.map f) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact RingHom.mem_ker.mpr (hgen x hx)
    exact RingHom.mem_ker.mp (hle hp)

/-- A polynomial whose coefficients are mapped along `f` is evaluated by first mapping the
coefficients: `p.eval₂ (C ∘ f) x = (p.map f).aeval x`. -/
lemma eval₂_C_comp_eq_map_aeval {S' : Type a} {L' : Type b} [CommSemiring S'] [CommSemiring L']
    {σ : Type c} (f : S' →+* L') (p : Polynomial S') (x : MvPolynomial σ L') :
    p.eval₂ (MvPolynomial.C.comp f) x = (p.map f).aeval x := by
  rw [Polynomial.aeval_def, show algebraMap L' (MvPolynomial σ L') = MvPolynomial.C from
    MvPolynomial.algebraMap_eq L' σ, Polynomial.eval₂_map]

/-! ## The fibre of the `U`-part -/

section Fibre

variable (S : Type a) [CommRing S] [IsLocalRing S]

/-- The algebraic closure `K = AlgebraicClosure L` of the residue field `L` of `S`; this is the
variable type of `Work.DSG4b.uRing S`. -/
abbrev uClosure : Type a := AlgebraicClosure (IsLocalRing.ResidueField S)

/-- The ideal of relations of the fibre: `(minpoly L α)(X_α)` for `α ∈ K`. -/
noncomputable abbrev uFibreRel : Ideal (MvPolynomial (uClosure S) (IsLocalRing.ResidueField S)) :=
  Ideal.span (Set.range fun α : uClosure S =>
    (minpoly (IsLocalRing.ResidueField S) α).aeval (MvPolynomial.X α))

/-- The fibre `L[X_α : α ∈ K] ⧸ ((minpoly L α)(X_α))` of the `U`-part: the quotient of
`Work.DSG4b.uRing S` by the ideal generated by the maximal ideal of the base ring. -/
noncomputable abbrev uFibre : Type a :=
  MvPolynomial (uClosure S) (IsLocalRing.ResidueField S) ⧸ uFibreRel S

/-- The `L`-algebra map `L[X_α : α ∈ K] →+* K`, `X_α ↦ α`, used to define the evaluation of the
fibre. -/
noncomputable def uFibreEvalPoly :
    MvPolynomial (uClosure S) (IsLocalRing.ResidueField S) →+* uClosure S :=
  MvPolynomial.eval₂Hom (algebraMap (IsLocalRing.ResidueField S) (uClosure S)) (fun α => α)

lemma uFibreEvalPoly_aeval (α : uClosure S) :
    uFibreEvalPoly S ((minpoly (IsLocalRing.ResidueField S) α).aeval (MvPolynomial.X α)) = 0 := by
  rw [uFibreEvalPoly, Work.DSG4b.eval₂Hom_aeval_X]
  simpa only [Polynomial.aeval_def] using minpoly.aeval (IsLocalRing.ResidueField S) α

/-- The evaluation `uFibre S →+* K` of the fibre, `X_α ↦ α`. -/
noncomputable def uFibreEval : uFibre S →+* uClosure S :=
  Ideal.Quotient.lift (uFibreRel S) (uFibreEvalPoly S) (by
    have hle : uFibreRel S ≤ RingHom.ker (uFibreEvalPoly S) := by
      refine Ideal.span_le.mpr ?_
      rintro x ⟨α, rfl⟩
      exact RingHom.mem_ker.mpr (uFibreEvalPoly_aeval S α)
    intro x hx
    exact RingHom.mem_ker.mp (hle hx))

@[simp]
lemma uFibreEval_mk (p : MvPolynomial (uClosure S) (IsLocalRing.ResidueField S)) :
    uFibreEval S (Ideal.Quotient.mk (uFibreRel S) p) = uFibreEvalPoly S p := by
  rw [uFibreEval, Ideal.Quotient.lift_mk]

@[simp]
lemma uFibreEval_mk_C (l : IsLocalRing.ResidueField S) :
    uFibreEval S (Ideal.Quotient.mk (uFibreRel S) (MvPolynomial.C l)) =
      algebraMap (IsLocalRing.ResidueField S) (uClosure S) l := by
  rw [uFibreEval_mk, uFibreEvalPoly, MvPolynomial.eval₂Hom_C]

@[simp]
lemma uFibreEval_mk_X (α : uClosure S) :
    uFibreEval S (Ideal.Quotient.mk (uFibreRel S) (MvPolynomial.X α)) = α := by
  rw [uFibreEval_mk, uFibreEvalPoly, MvPolynomial.eval₂Hom_X']

lemma uFibreEval_algebraMap (l : IsLocalRing.ResidueField S) :
    uFibreEval S (algebraMap (IsLocalRing.ResidueField S) (uFibre S) l) =
      algebraMap (IsLocalRing.ResidueField S) (uClosure S) l := by
  rw [show algebraMap (IsLocalRing.ResidueField S) (uFibre S) l
      = Ideal.Quotient.mk (uFibreRel S) (MvPolynomial.C l) from by
    rw [← Ideal.Quotient.mk_comp_algebraMap (IsLocalRing.ResidueField S) (uFibreRel S),
      RingHom.comp_apply,
      show algebraMap (IsLocalRing.ResidueField S)
        (MvPolynomial (uClosure S) (IsLocalRing.ResidueField S))
        = MvPolynomial.C from MvPolynomial.algebraMap_eq _ _]]
  exact uFibreEval_mk_C S l

/-- `uFibreEval S` as an `L`-algebra map. -/
noncomputable def uFibreEvalAlg : uFibre S →ₐ[IsLocalRing.ResidueField S] uClosure S :=
  { toRingHom := uFibreEval S
    commutes' := fun l => uFibreEval_algebraMap S l }

@[simp]
lemma uFibreEvalAlg_mk_X (α : uClosure S) :
    uFibreEvalAlg S (Ideal.Quotient.mk (uFibreRel S) (MvPolynomial.X α)) = α :=
  uFibreEval_mk_X S α

/-- The reduction `S[X_α] →+* uFibre S` of the coefficients along `IsLocalRing.residue S`. -/
noncomputable def uRedPoly : MvPolynomial (uClosure S) S →+* uFibre S :=
  (Ideal.Quotient.mk (uFibreRel S)).comp (MvPolynomial.map (IsLocalRing.residue S))

/-- Reducing the coefficients of the relation `(uPoly S α)(X_α)` along the residue map gives the
minimal polynomial relation `(minpoly L α)(X_α)` of the fibre. -/
lemma uMap_aeval (α : uClosure S) :
    MvPolynomial.map (IsLocalRing.residue S) ((uPoly S α).aeval (MvPolynomial.X α)) =
      (minpoly (IsLocalRing.ResidueField S) α).aeval (MvPolynomial.X α) := by
  rw [MvPolynomial.map_eq_eval₂Hom_C_comp, Work.DSG4b.eval₂Hom_aeval_X,
    eval₂_C_comp_eq_map_aeval, uPoly_map]

/-- The residue of the lifted minimal polynomial is the minimal polynomial, so the relation
`(uPoly S α)(X_α)` dies in the fibre. -/
lemma uRedPoly_aeval (α : uClosure S) :
    uRedPoly S ((uPoly S α).aeval (MvPolynomial.X α)) = 0 := by
  rw [uRedPoly, RingHom.comp_apply, uMap_aeval]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨α, rfl⟩)

/-- The reduction of the `U`-part onto its fibre: `uRing S →+* uFibre S`. -/
noncomputable def uRed : uRing S →+* uFibre S :=
  Ideal.Quotient.lift (RFAux.qI (uPoly S)) (uRedPoly S) (by
    have hle : RFAux.qI (uPoly S) ≤ RingHom.ker (uRedPoly S) := by
      rw [RFAux.qI, Ideal.span_le]
      rintro x ⟨α, rfl⟩
      exact RingHom.mem_ker.mpr (uRedPoly_aeval S α)
    intro x hx
    exact RingHom.mem_ker.mp (hle hx))

@[simp]
lemma uRed_mk (p : MvPolynomial (uClosure S) S) :
    uRed S (Ideal.Quotient.mk (RFAux.qI (uPoly S)) p) = uRedPoly S p := by
  rw [uRed, Ideal.Quotient.lift_mk]

@[simp]
lemma uRed_uVar (α : uClosure S) :
    uRed S (uVar S α) = Ideal.Quotient.mk (uFibreRel S) (MvPolynomial.X α) := by
  rw [uVar, uRed_mk, uRedPoly, RingHom.comp_apply, MvPolynomial.map_X]

@[simp]
lemma uRed_uRingAlg (s : S) :
    uRed S (uRingAlg S s)
      = Ideal.Quotient.mk (uFibreRel S) (MvPolynomial.C (IsLocalRing.residue S s)) := by
  rw [uRingAlg, RingHom.comp_apply, uRed_mk, uRedPoly, RingHom.comp_apply, MvPolynomial.map_C]

lemma uRed_surjective : Function.Surjective (uRed S) := by
  intro y
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨p, rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective q
  exact ⟨Ideal.Quotient.mk (RFAux.qI (uPoly S)) p, by rw [uRed_mk, uRedPoly, RingHom.comp_apply]⟩

/-- The two evaluations agree: `uEv S = (uFibreEval S).comp (uRed S)`. -/
lemma uEv_eq_uFibreEval_comp_uRed : uEv S = (uFibreEval S).comp (uRed S) := by
  have hcomp : (uRed S).comp (Ideal.Quotient.mk (RFAux.qI (uPoly S))) = uRedPoly S := by
    apply RingHom.ext
    intro p
    exact uRed_mk S p
  refine Ideal.Quotient.ringHom_ext ?_
  rw [RingHom.comp_assoc, hcomp]
  refine MvPolynomial.ringHom_ext ?_ ?_
  · intro s
    simp only [RingHom.comp_apply, uRedPoly, MvPolynomial.map_C, uEv,
      Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, uFibreEval_mk_C]
  · intro α
    simp only [RingHom.comp_apply, uRedPoly, MvPolynomial.map_X, uEv,
      Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', uFibreEval_mk_X]

/-- **The fibre of the `U`-part is `uRing S ⧸ 𝔪_R uRing S`.**  Let `R` be a local ring and `S` a
local `R`-algebra with `𝔪_R S = 𝔪_S` (`hmax`).  Then the kernel of the reduction
`uRed S : uRing S →+* uFibre S` is exactly the ideal generated by `𝔪_R`.

`(uRed S).comp (mk (RFAux.qI (uPoly S))) = uRedPoly S` is the coefficient reduction, so by
`RingHom.comap_ker` and `Ideal.map_comap_of_surjective` the kernel of `uRed S` is the image of
`ker (uRedPoly S)` under `mk (RFAux.qI (uPoly S))`; the latter is
`comap ψ (uFibreRel S)` for `ψ = MvPolynomial.map (IsLocalRing.residue S)`
(`RingHom.comap_ker` + `Ideal.mk_ker`), which is `RFAux.qI (uPoly S) ⊔ ker ψ` by
`comap_span_range_eq_sup_ker` and `uMap_aeval`; `ker_map_C` and `IsLocalRing.ker_residue` identify
`ker ψ = (𝔪_S).map MvPolynomial.C`, and mapping along `mk (RFAux.qI (uPoly S))` kills
`RFAux.qI (uPoly S)` and turns `mk.comp MvPolynomial.C` into `uRingAlg S`.  Finally `hmax` and
`Ideal.map_map` replace `𝔪_S` by `(𝔪_R).map φ`. -/
theorem uRed_ker_eq_aux (R : Type a) [CommRing R] [IsLocalRing R] (S : Type a) [CommRing S]
    [IsLocalRing S] (φ : R →+* S)
    (hmax : (IsLocalRing.maximalIdeal R).map φ = IsLocalRing.maximalIdeal S) :
    RingHom.ker (uRed S) = (IsLocalRing.maximalIdeal R).map ((uRingAlg S).comp φ) := by
  have hcomp : (uRed S).comp (Ideal.Quotient.mk (RFAux.qI (uPoly S))) = uRedPoly S := by
    apply RingHom.ext
    intro p
    exact uRed_mk S p
  -- Step 1: `ker (uRed S) = mk (ker (uRedPoly S))`
  have h1 : RingHom.ker (uRed S) = Ideal.map (Ideal.Quotient.mk (RFAux.qI (uPoly S)))
      (RingHom.ker (uRedPoly S)) := by
    have hc : Ideal.comap (Ideal.Quotient.mk (RFAux.qI (uPoly S))) (RingHom.ker (uRed S))
        = RingHom.ker (uRedPoly S) := by
      rw [← hcomp, RingHom.comap_ker]
    rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk (RFAux.qI (uPoly S)))
      Ideal.Quotient.mk_surjective (RingHom.ker (uRed S)), hc]
  -- Step 2: `ker (uRedPoly S) = comap (map (residue S)) (uFibreRel S)`
  have h2 : RingHom.ker (uRedPoly S)
      = Ideal.comap (MvPolynomial.map (IsLocalRing.residue S)) (uFibreRel S) := by
    rw [uRedPoly, ← RingHom.comap_ker (Ideal.Quotient.mk (uFibreRel S))
      (MvPolynomial.map (IsLocalRing.residue S)), Ideal.mk_ker]
  -- Step 3: the fibre relations are the images of the lifted relations
  have hrange : Set.range (fun α : uClosure S =>
        MvPolynomial.map (IsLocalRing.residue S) ((uPoly S α).aeval (MvPolynomial.X α)))
      = Set.range (fun α : uClosure S =>
        (minpoly (IsLocalRing.ResidueField S) α).aeval (MvPolynomial.X α)) := by
    ext x
    constructor
    · rintro ⟨α, rfl⟩
      exact ⟨α, (uMap_aeval S α).symm⟩
    · rintro ⟨α, rfl⟩
      exact ⟨α, uMap_aeval S α⟩
  have h3 : Ideal.comap (MvPolynomial.map (IsLocalRing.residue S)) (uFibreRel S)
      = RFAux.qI (uPoly S) ⊔ RingHom.ker (MvPolynomial.map (IsLocalRing.residue S)) := by
    have huFibreRel : uFibreRel S = Ideal.span (Set.range fun α : uClosure S =>
        MvPolynomial.map (IsLocalRing.residue S) ((uPoly S α).aeval (MvPolynomial.X α))) :=
      congrArg Ideal.span hrange.symm
    rw [huFibreRel,
      comap_span_range_eq_sup_ker (MvPolynomial.map (IsLocalRing.residue S))
        (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective),
      RFAux.qI]
  -- Step 4: `ker (map (residue S)) = 𝔪_S · S[X]`
  have h4 : RingHom.ker (MvPolynomial.map (IsLocalRing.residue S))
      = (IsLocalRing.maximalIdeal S).map
        (MvPolynomial.C : S →+* MvPolynomial (uClosure S) S) := by
    rw [ker_map_C, IsLocalRing.ker_residue]
  rw [h1, h2, h3, h4]
  -- Step 5: the ideal juggling
  have hqI : Ideal.map (Ideal.Quotient.mk (RFAux.qI (uPoly S))) (RFAux.qI (uPoly S)) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker (Ideal.Quotient.mk (RFAux.qI (uPoly S))), Ideal.mk_ker]
  rw [Ideal.map_sup, hqI, bot_sup_eq, Ideal.map_map, ← hmax, Ideal.map_map, uRingAlg]

end Fibre

end Work.DSG4b.uRingKey
