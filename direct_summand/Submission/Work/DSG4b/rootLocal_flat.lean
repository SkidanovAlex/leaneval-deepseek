import Mathlib
import Submission.Work.DSG4b.Root
import Submission.Work.DSG4b.RootLift

/-!
# `rootLocal_flat`

The root local ring `Work.DSG4b.rootLocal R` of the residue-field enlargement is flat over `R`.

The root presentation `rootRing R = MvPolynomial K R ⧸ relIdeal R` is `MvPolynomial K R` modulo
the ideal generated by the monic (in the single variable `X s`) polynomials `minPolyLift R s`
evaluated at `X s`.  The auxiliary development below (`RFAux.flat_quotient_monic`) shows that such
a quotient is flat over `R`; localisation at a prime is flat over the base ring
(`IsLocalization.flat`) and flatness is transitive, which gives the statement.
-/

namespace Work.DSG4b

namespace RFAux

open MvPolynomial Polynomial

variable {R : Type*} [CommRing R] {σ : Type*}

/-- The ideal generated by the family of monic polynomials evaluated at the matching variable. -/
noncomputable def qI (f : σ → Polynomial R) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun s => (f s).aeval (MvPolynomial.X s))

/-- Span of the monomials `X^m` with `m s < d s` for all `s`. -/
noncomputable def qVd (d : σ → ℕ) : Submodule R (MvPolynomial σ R) :=
  Submodule.span R (Set.range fun m : {m : σ →₀ ℕ // ∀ s, m s < d s} =>
    (MvPolynomial.monomial m.1 1 : MvPolynomial σ R))

/-- Span of the monomials `X^m` with `m` supported in `t` and `m s < d s` for `s ∈ t`. -/
noncomputable def qVt (d : σ → ℕ) (t : Finset σ) : Submodule R (MvPolynomial σ R) :=
  Submodule.span R (Set.range fun m : {m : σ →₀ ℕ // m.support ⊆ t ∧ ∀ s ∈ t, m s < d s} =>
    (MvPolynomial.monomial m.1 1 : MvPolynomial σ R))

/-- Span of `X s ^ i` for `i < d s`. -/
noncomputable def qW (d : σ → ℕ) (s : σ) : Submodule R (MvPolynomial σ R) :=
  Submodule.span R (Set.range fun i : {i : ℕ // i < d s} =>
    (MvPolynomial.X s ^ (i : ℕ) : MvPolynomial σ R))

/-- Reduction of the monomial `X^k` in the variable `s` modulo `f s`. -/
noncomputable def redFactor (f : σ → Polynomial R) (s : σ) (k : ℕ) : MvPolynomial σ R :=
  ((Polynomial.X ^ k) %ₘ (f s)).aeval (MvPolynomial.X s)

/-- Reduction of a monomial `X^m`. -/
noncomputable def red (f : σ → Polynomial R) (m : σ →₀ ℕ) : MvPolynomial σ R :=
  ∏ s ∈ m.support, redFactor f s (m s)

/-- The `R`-linear "normal form" map, defined on monomials by `red`. -/
noncomputable def redLin (f : σ → Polynomial R) : MvPolynomial σ R →ₗ[R] MvPolynomial σ R :=
  (Finsupp.linearCombination R (red f)).comp (AddMonoidAlgebra.coeffLinearEquiv R).toLinearMap

/-- A module with at most one element is flat. -/
lemma flat_of_subsingleton {S : Type*} [CommRing S] {N : Type*} [AddCommMonoid N] [Module S N]
    [Subsingleton N] : Module.Flat S N :=
  Module.Flat.of_retract (0 : N →ₗ[S] S) (0 : S →ₗ[S] N) (by ext x; exact Subsingleton.elim _ _)

section QVt

variable {d : σ → ℕ}

lemma qVt_one (hd : ∀ s, 1 ≤ d s) (t : Finset σ) : (1 : MvPolynomial σ R) ∈ qVt d t := by
  refine Submodule.subset_span ⟨⟨0, ?_, ?_⟩, ?_⟩
  · simp
  · intro s _; exact hd s
  · simp

lemma qVt_le_qVd (hd : ∀ s, 1 ≤ d s) (t : Finset σ) :
    (qVt d t : Submodule R (MvPolynomial σ R)) ≤ qVd d := by
  rw [qVt, qVd, Submodule.span_le]
  rintro x ⟨⟨m, hm1, hm2⟩, rfl⟩
  refine Submodule.subset_span ⟨⟨m, ?_⟩, rfl⟩
  intro s
  by_cases hs : s ∈ t
  · exact hm2 s hs
  · have h0 : m s = 0 := by
      by_contra h
      exact hs (hm1 (by simpa using h))
    rw [h0]; exact hd s

end QVt

section Mul

variable {d : σ → ℕ}

lemma qVt_mul_qW_le [DecidableEq σ] {t : Finset σ} {s : σ} (hs : s ∉ t) :
    (qVt d t : Submodule R (MvPolynomial σ R)) * qW d s ≤ qVt d (insert s t) := by
  rw [qVt, qW, Submodule.span_mul_span, Submodule.span_le]
  rintro x ⟨y, hy, z, hz, rfl⟩
  obtain ⟨⟨m, hm1, hm2⟩, rfl⟩ := hy
  obtain ⟨⟨i, hi⟩, rfl⟩ := hz
  show MvPolynomial.monomial m 1 * (MvPolynomial.X s ^ i) ∈ qVt d (insert s t)
  rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul_monomial, mul_one]
  refine Submodule.subset_span ⟨⟨m + Finsupp.single s i, ?_, ?_⟩, rfl⟩
  · intro u hu
    have hu' : u ∈ m.support ∪ (Finsupp.single s i).support := Finsupp.support_add hu
    rcases Finset.mem_union.mp hu' with hu | hu
    · exact Finset.mem_insert_of_mem (hm1 hu)
    · rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hu)]
      exact Finset.mem_insert_self s t
  · intro u hu
    rw [Finsupp.add_apply]
    rcases Finset.mem_insert.mp hu with hsu | hu
    · rw [hsu]
      have h0 : m s = 0 := by
        by_contra h
        exact hs (hm1 (by simpa using h))
      rw [h0, Finsupp.single_eq_same, zero_add]; exact hi
    · have h1 : Finsupp.single s i u = 0 :=
        Finsupp.single_eq_of_ne (fun hsu => hs (hsu ▸ hu))
      rw [h1, add_zero]; exact hm2 u hu

end Mul

section Red

variable {f : σ → Polynomial R}

lemma one_le_natDegree_of_ne_one {s : σ} (hmono : (f s).Monic) (hne : f s ≠ 1) :
    1 ≤ (f s).natDegree := by
  have h := (Polynomial.Monic.natDegree_pos hmono).mpr hne
  omega

lemma redFactor_zero [Nontrivial R] {t : σ} (hmono : (f t).Monic) (hne : f t ≠ 1) :
    redFactor f t 0 = 1 := by
  have hle : 1 ≤ (f t).natDegree := one_le_natDegree_of_ne_one hmono hne
  have hdeg : Polynomial.degree (1 : Polynomial R) < Polynomial.degree (f t) := by
    rw [Polynomial.degree_one, Polynomial.degree_eq_natDegree hmono.ne_zero]
    exact WithBot.coe_lt_coe.mpr hle
  have h2 : ((Polynomial.X ^ 0 : Polynomial R) %ₘ (f t)) = 1 := by
    rw [pow_zero, (Polynomial.modByMonic_eq_self_iff hmono).mpr hdeg]
  rw [redFactor, h2]
  simp

lemma redFactor_mem_qW {d : σ → ℕ} (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1)
    (hds : ∀ s, (f s).natDegree ≤ d s) (s : σ) (k : ℕ) :
    redFactor f s k ∈ qW d s := by
  rw [redFactor, Polynomial.aeval_eq_sum_range]
  refine Submodule.sum_mem _ fun i hi => ?_
  rw [Finset.mem_range] at hi
  have hlt : i < d s :=
    lt_of_le_of_lt (Nat.lt_succ_iff.mp hi)
      (lt_of_lt_of_le (Polynomial.natDegree_modByMonic_lt _ (hmono s) (hne s)) (hds s))
  have hmem : (MvPolynomial.X s ^ i : MvPolynomial σ R) ∈ qW d s :=
    Submodule.subset_span ⟨⟨i, hlt⟩, rfl⟩
  exact Submodule.smul_mem _ (((Polynomial.X ^ k) %ₘ (f s)).coeff i) hmem

lemma X_pow_sub_redFactor_mem_qI (s : σ) (k : ℕ) :
    (MvPolynomial.X s ^ k : MvPolynomial σ R) - redFactor f s k ∈ qI f := by
  have h2 : (Polynomial.X ^ k : Polynomial R) - (Polynomial.X ^ k) %ₘ (f s)
      = (f s) * ((Polynomial.X ^ k) /ₘ (f s)) := by
    rw [Polynomial.modByMonic_eq_sub_mul_div]; ring
  have h3 := congrArg (⇑(Polynomial.aeval (MvPolynomial.X s) :
    Polynomial R →ₐ[R] MvPolynomial σ R)) h2
  simp only [map_sub, map_mul, Polynomial.aeval_X_pow] at h3
  have hrf : redFactor f s k = (Polynomial.aeval (MvPolynomial.X s) :
      Polynomial R →ₐ[R] MvPolynomial σ R) ((Polynomial.X ^ k) %ₘ (f s)) := rfl
  rw [hrf, h3]
  exact Ideal.mul_mem_right _ (qI f) (Submodule.subset_span ⟨s, rfl⟩)

lemma prod_sub_prod_mem {ι : Type*} (t : Finset ι) (A B : ι → MvPolynomial σ R)
    (J : Ideal (MvPolynomial σ R)) (h : ∀ i ∈ t, A i - B i ∈ J) :
    (∏ i ∈ t, A i) - (∏ i ∈ t, B i) ∈ J := by
  classical
  induction t using Finset.induction_on with
  | empty => simp
  | insert i t' hi ih =>
    rw [Finset.prod_insert hi, Finset.prod_insert hi]
    have hA : A i - B i ∈ J := h i (Finset.mem_insert_self i t')
    have hB : (∏ j ∈ t', A j) - (∏ j ∈ t', B j) ∈ J :=
      ih (fun j hj => h j (Finset.mem_insert_of_mem hj))
    have hsplit : A i * (∏ j ∈ t', A j) - B i * (∏ j ∈ t', B j)
        = A i * ((∏ j ∈ t', A j) - (∏ j ∈ t', B j))
          + (A i - B i) * (∏ j ∈ t', B j) := by ring
    rw [hsplit]
    exact J.add_mem (J.mul_mem_left _ hB) (J.mul_mem_right _ hA)

end Red

section Span

variable {f : σ → Polynomial R}

lemma monomial_sub_red_mem_qI (m : σ →₀ ℕ) :
    (MvPolynomial.monomial m 1 : MvPolynomial σ R) - red f m ∈ qI f := by
  have hmono : (MvPolynomial.monomial m 1 : MvPolynomial σ R)
      = ∏ s ∈ m.support, (MvPolynomial.X s ^ (m s) : MvPolynomial σ R) :=
    MvPolynomial.prod_X_pow_eq_monomial.symm
  rw [hmono]
  exact prod_sub_prod_mem m.support (fun s => (MvPolynomial.X s ^ (m s) : MvPolynomial σ R))
    (fun s => redFactor f s (m s)) (qI f) (fun s _ => X_pow_sub_redFactor_mem_qI s (m s))

lemma red_mem_qVt (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1)
    (m : σ →₀ ℕ) :
    red f m ∈ qVt (fun s => (f s).natDegree) m.support := by
  classical
  have hd : ∀ s, 1 ≤ (f s).natDegree := fun s => one_le_natDegree_of_ne_one (hmono s) (hne s)
  have h : ∀ t : Finset σ, (∏ s ∈ t, redFactor f s (m s)) ∈ qVt (fun s => (f s).natDegree) t := by
    intro t
    induction t using Finset.induction_on with
    | empty => simpa using qVt_one hd ∅
    | insert s t' hs ih =>
      have h1 : redFactor f s (m s) ∈ qW (fun s => (f s).natDegree) s :=
        redFactor_mem_qW hmono hne (fun _ => le_refl _) s (m s)
      rw [Finset.prod_insert hs, mul_comm (redFactor f s (m s))]
      exact qVt_mul_qW_le hs (Submodule.mul_mem_mul ih h1)
  exact h m.support

lemma red_mem_qVd (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1)
    (m : σ →₀ ℕ) : red f m ∈ qVd (fun s => (f s).natDegree) := by
  have hd : ∀ s, 1 ≤ (f s).natDegree := fun s => one_le_natDegree_of_ne_one (hmono s) (hne s)
  exact qVt_le_qVd hd m.support (red_mem_qVt hmono hne m)

end Span

section Lin

variable {f : σ → Polynomial R}

lemma redLin_monomial (m : σ →₀ ℕ) (c : R) :
    redLin f (MvPolynomial.monomial m c) = c • red f m := by
  simp only [redLin, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap]
  rw [show (⇑(AddMonoidAlgebra.coeffLinearEquiv R)) (MvPolynomial.monomial m c)
      = Finsupp.single m c from rfl]
  exact Finsupp.linearCombination_single R c m

lemma redLin_mem_qVd (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1) (x : MvPolynomial σ R) :
    redLin f x ∈ qVd (fun s => (f s).natDegree) := by
  refine MvPolynomial.induction_on' x ?_ ?_
  · intro u a
    rw [redLin_monomial]
    exact Submodule.smul_mem (qVd (fun s => (f s).natDegree)) a (red_mem_qVd hmono hne u)
  · intro p q hp hq
    rw [map_add]
    exact Submodule.add_mem _ hp hq

lemma sub_redLin_mem_qI (x : MvPolynomial σ R) : x - redLin f x ∈ qI f := by
  refine MvPolynomial.induction_on' x ?_ ?_
  · intro u a
    have hc : (MvPolynomial.monomial u a : MvPolynomial σ R)
        = a • (MvPolynomial.monomial u 1 : MvPolynomial σ R) := by
      rw [MvPolynomial.smul_monomial]; simp
    rw [redLin_monomial, hc, ← smul_sub, Algebra.smul_def, MvPolynomial.algebraMap_eq]
    exact Ideal.mul_mem_left (qI f) (MvPolynomial.C a) (monomial_sub_red_mem_qI u)
  · intro p q hp hq
    have hsplit : (p + q) - redLin f (p + q)
        = (p - redLin f p) + (q - redLin f q) := by
      rw [map_add]; ring
    rw [hsplit]
    exact add_mem hp hq

end Lin

section Red2

variable {f : σ → Polynomial R}

/-- Reduction of `X^u * X_s^k`: only the `s`-factor is affected. -/
lemma red_add_single [Nontrivial R] [DecidableEq σ] (hmono : ∀ s, (f s).Monic)
    (hne : ∀ s, f s ≠ 1)
    (u : σ →₀ ℕ) (s : σ) (k : ℕ) :
    red f (u + Finsupp.single s k) =
      (∏ t ∈ u.support.erase s, redFactor f t (u t)) * redFactor f s (u s + k) := by
  classical
  rw [red]
  have hsub : (u + Finsupp.single s k).support ⊆ insert s (u.support.erase s) := by
    intro t ht
    have ht' : u t ≠ 0 ∨ Finsupp.single s k t ≠ 0 := by
      have h1 := Finsupp.mem_support_iff.mp ht
      rw [Finsupp.add_apply] at h1
      rcases Nat.add_pos_iff_pos_or_pos.mp (Nat.pos_of_ne_zero h1) with h | h
      · exact Or.inl (Nat.pos_iff_ne_zero.mp h)
      · exact Or.inr (Nat.pos_iff_ne_zero.mp h)
    rcases ht' with h | h
    · rcases eq_or_ne t s with rfl | hts
      · exact Finset.mem_insert_self _ _
      · exact Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨hts, Finsupp.mem_support_iff.mpr h⟩)
    · by_cases hts : t = s
      · rw [hts]
        exact Finset.mem_insert_self s _
      · exact absurd (Finsupp.single_eq_of_ne hts) h
  have h1 : (∏ t ∈ (u + Finsupp.single s k).support,
        redFactor f t ((u + Finsupp.single s k) t))
      = ∏ t ∈ insert s (u.support.erase s), redFactor f t ((u + Finsupp.single s k) t) := by
    refine Finset.prod_subset hsub fun t _ htn => ?_
    have hzero : (u + Finsupp.single s k) t = 0 := by
      by_contra hc
      exact htn (Finsupp.mem_support_iff.mpr hc)
    rw [hzero, redFactor_zero (hmono t) (hne t)]
  rw [h1, Finset.prod_insert (by simp : s ∉ u.support.erase s)]
  have hprod : (∏ t ∈ u.support.erase s, redFactor f t ((u + Finsupp.single s k) t))
      = ∏ t ∈ u.support.erase s, redFactor f t (u t) := by
    refine Finset.prod_congr rfl fun t ht => ?_
    rw [Finsupp.add_apply, Finsupp.single_eq_of_ne (Finset.mem_erase.mp ht).1, add_zero]
  have hs : ((u + Finsupp.single s k) s) = u s + k := by
    rw [Finsupp.add_apply, Finsupp.single_eq_same]
  rw [hprod, hs, mul_comm]

/-- Reduction of a single monomial. -/
lemma red_single [Nontrivial R] (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1)
    (s : σ) (k : ℕ) : red f (Finsupp.single s k) = redFactor f s k := by
  classical
  have h := red_add_single hmono hne (0 : σ →₀ ℕ) s k
  simpa using h

end Red2

section Main

variable {f : σ → Polynomial R}

/-- The `s`-shifted reduction of `f s` vanishes. -/
lemma sum_coeff_redFactor_shift (hmono : ∀ s, (f s).Monic) (s : σ) (k : ℕ) :
    (∑ i ∈ Finset.range ((f s).natDegree + 1),
      (f s).coeff i • redFactor f s (k + i)) = 0 := by
  have h1 : (∑ i ∈ Finset.range ((f s).natDegree + 1),
      (f s).coeff i • (Polynomial.X ^ i : Polynomial R)) = f s := by
    conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow (f s)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Algebra.smul_def, ← Polynomial.C_eq_algebraMap]
  have hX : (∑ i ∈ Finset.range ((f s).natDegree + 1),
      (f s).coeff i • (Polynomial.X ^ (k + i) : Polynomial R))
      = Polynomial.X ^ k * f s := by
    have h2 : (∑ i ∈ Finset.range ((f s).natDegree + 1),
        (f s).coeff i • (Polynomial.X ^ (k + i) : Polynomial R))
        = Polynomial.X ^ k * (∑ i ∈ Finset.range ((f s).natDegree + 1),
            (f s).coeff i • (Polynomial.X ^ i : Polynomial R)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def, Algebra.smul_def, ← Polynomial.C_eq_algebraMap, pow_add]
      ring
    rw [h2, h1]
  have hmod : (∑ i ∈ Finset.range ((f s).natDegree + 1),
      (f s).coeff i • ((Polynomial.X ^ (k + i)) %ₘ (f s))) = 0 := by
    have hterm : ∀ i, (f s).coeff i • ((Polynomial.X ^ (k + i)) %ₘ (f s))
        = (Polynomial.modByMonicHom (f s))
            ((f s).coeff i • (Polynomial.X ^ (k + i) : Polynomial R)) :=
      fun i => by rw [map_smul, Polynomial.modByMonicHom_apply]
    rw [Finset.sum_congr rfl (fun i _ => hterm i), ← map_sum, hX,
      Polynomial.modByMonicHom_apply, Polynomial.modByMonic_eq_zero_iff_dvd (hmono s)]
    exact ⟨Polynomial.X ^ k, mul_comm _ _⟩
  calc (∑ i ∈ Finset.range ((f s).natDegree + 1), (f s).coeff i • redFactor f s (k + i))
      = ∑ i ∈ Finset.range ((f s).natDegree + 1),
          (f s).coeff i • (((Polynomial.X ^ (k + i)) %ₘ (f s)).aeval (MvPolynomial.X s)) := by
        simp only [redFactor]
    _ = (∑ i ∈ Finset.range ((f s).natDegree + 1),
          (f s).coeff i • ((Polynomial.X ^ (k + i)) %ₘ (f s))).aeval (MvPolynomial.X s) := by
        simp only [map_sum, map_smul]
    _ = 0 := by rw [hmod, map_zero]

/-- `redLin` kills multiples of the relation `(f s).aeval (X s)`. -/
lemma redLin_mul_aeval [Nontrivial R] (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1)
    (a : MvPolynomial σ R) (s : σ) :
    redLin f (a * (f s).aeval (MvPolynomial.X s)) = 0 := by
  classical
  induction a using MvPolynomial.induction_on' with
  | monomial u c =>
      have hsum : (∑ i ∈ Finset.range ((f s).natDegree + 1),
          (f s).coeff i • red f (u + Finsupp.single s i)) = 0 := by
        have h3 : (∑ i ∈ Finset.range ((f s).natDegree + 1),
            (f s).coeff i • red f (u + Finsupp.single s i))
            = ∑ i ∈ Finset.range ((f s).natDegree + 1),
              (f s).coeff i • ((∏ t ∈ u.support.erase s, redFactor f t (u t)) *
                redFactor f s (u s + i)) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [red_add_single hmono hne u s i]
        rw [h3]
        have h4 : (∑ i ∈ Finset.range ((f s).natDegree + 1),
            (f s).coeff i • ((∏ t ∈ u.support.erase s, redFactor f t (u t)) *
              redFactor f s (u s + i)))
            = (∏ t ∈ u.support.erase s, redFactor f t (u t)) *
              (∑ i ∈ Finset.range ((f s).natDegree + 1),
                (f s).coeff i • redFactor f s (u s + i)) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [mul_smul_comm]
        rw [h4, sum_coeff_redFactor_shift hmono s (u s), mul_zero]
      have hdecomp : (MvPolynomial.monomial u c : MvPolynomial σ R) *
            (f s).aeval (MvPolynomial.X s)
          = ∑ i ∈ Finset.range ((f s).natDegree + 1),
              (f s).coeff i • (MvPolynomial.monomial (u + Finsupp.single s i) c) := by
        rw [Polynomial.aeval_eq_sum_range, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [mul_smul_comm, MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul_monomial,
          mul_one]
      rw [hdecomp, map_sum]
      rw [show (∑ i ∈ Finset.range ((f s).natDegree + 1),
          redLin f ((f s).coeff i • MvPolynomial.monomial (u + Finsupp.single s i) c))
          = c • (∑ i ∈ Finset.range ((f s).natDegree + 1),
              (f s).coeff i • red f (u + Finsupp.single s i)) from by
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_smul, redLin_monomial, smul_comm]]
      rw [hsum, smul_zero]
  | add p q hp hq =>
      rw [add_mul, map_add, hp, hq, add_zero]

end Main

section Assembly

variable {f : σ → Polynomial R}

/-- `redLin` kills the ideal generated by the relations. -/
lemma redLin_mem_ker_qI [Nontrivial R] (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1) :
    (qI f : Set (MvPolynomial σ R)) ⊆ {x | redLin f x = 0} := by
  classical
  have hmain : ∀ y ∈ Submodule.span (MvPolynomial σ R)
      (Set.range fun s => (f s).aeval (MvPolynomial.X s)),
      ∀ a : MvPolynomial σ R, redLin f (a * y) = 0 := by
    intro y hy
    refine Submodule.span_induction (R := MvPolynomial σ R)
      (p := fun y _ => ∀ a : MvPolynomial σ R, redLin f (a * y) = 0) ?_ ?_ ?_ ?_ hy
    · rintro w ⟨s, rfl⟩ a
      exact redLin_mul_aeval hmono hne a s
    · intro a; rw [mul_zero, map_zero]
    · intro x y _ _ hpx hpy a
      rw [mul_add, map_add, hpx a, hpy a, zero_add]
    · intro b x _ hpx a
      rw [show a * (b • x) = (a * b) * x by rw [smul_eq_mul, mul_assoc]]
      exact hpx (a * b)
  intro x hx
  simpa using hmain x hx 1

theorem flat_of_monic [Nontrivial R] (hmono : ∀ s, (f s).Monic) (hne : ∀ s, f s ≠ 1) :
    Module.Flat R (MvPolynomial σ R ⧸ qI f) := by
  classical
  have hsub := redLin_mem_ker_qI hmono hne
  let J : Submodule R (MvPolynomial σ R) := Submodule.restrictScalars R (qI f)
  have hker : J ≤ (redLin f).ker := by
    intro x hx
    exact hsub hx
  let i : (MvPolynomial σ R ⧸ J) →ₗ[R] MvPolynomial σ R := J.liftQ (redLin f) hker
  let r : MvPolynomial σ R →ₗ[R] (MvPolynomial σ R ⧸ J) := J.mkQ
  have hri : r.comp i = LinearMap.id := by
    apply LinearMap.ext
    intro z
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective J z
    show r (i (J.mkQ y)) = J.mkQ y
    rw [show i (J.mkQ y) = redLin f y from
        Submodule.liftQ_apply (p := J) (f := redLin f) (h := hker) (x := y),
      show r y = J.mkQ y from rfl]
    rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
    have hy := sub_redLin_mem_qI (f := f) y
    rw [← neg_sub]
    exact neg_mem hy
  exact Module.Flat.of_retract i r hri

/-- If `f : σ → R[X]` is a family of monic polynomials, then `MvPolynomial σ R` modulo the ideal
generated by the relations `(f s).aeval (X s)` is flat over `R`. -/
theorem flat_quotient_monic (f : σ → Polynomial R) (hf : ∀ s, (f s).Monic) :
    Module.Flat R (MvPolynomial σ R ⧸ qI f) := by
  classical
  by_cases hR : Nontrivial R
  · haveI := hR
    by_cases h1 : ∃ s, f s = 1
    · obtain ⟨s, hs⟩ := h1
      have hmem : (1 : MvPolynomial σ R) ∈ qI f := by
        refine Submodule.subset_span ?_
        exact ⟨s, by simp [hs]⟩
      have htop : qI f = ⊤ := by
        rw [Submodule.eq_top_iff']
        intro x
        have hx : x = x * 1 := (mul_one x).symm
        rw [hx]
        exact Ideal.mul_mem_left (qI f) x hmem
      haveI : Subsingleton (MvPolynomial σ R ⧸ qI f) :=
        Ideal.Quotient.subsingleton_iff.mpr htop
      exact flat_of_subsingleton
    · push_neg at h1
      exact flat_of_monic hf h1
  · haveI : Subsingleton R := not_nontrivial_iff_subsingleton.mp hR
    haveI : Subsingleton (MvPolynomial σ R) := inferInstance
    have hmem : (1 : MvPolynomial σ R) ∈ qI f := by
      rw [Subsingleton.elim (1 : MvPolynomial σ R) 0]
      exact Submodule.zero_mem _
    have htop : qI f = ⊤ := by
      rw [Submodule.eq_top_iff']
      intro x
      have hx : x = x * 1 := (mul_one x).symm
      rw [hx]
      exact Ideal.mul_mem_left (qI f) x hmem
    haveI : Subsingleton (MvPolynomial σ R ⧸ qI f) :=
      Ideal.Quotient.subsingleton_iff.mpr htop
    exact flat_of_subsingleton

end Assembly

end RFAux

universe u

/-- The root local ring `Work.DSG4b.rootLocal R` of the residue-field enlargement is flat over
`R`.

Proof plan: the "root presentation" `rootRing R = MvPolynomial K R ⧸ relIdeal R` is the quotient
of the polynomial ring `MvPolynomial K R` by the ideal generated by the monic (in the single
variable `X s`) polynomials `Work.DSG4b.minPolyLift R s` evaluated at `X s`, so it is flat over
`R` by `Work.DSG4b.flat_mvPolynomial_quotient_monic` applied to `f := Work.DSG4b.minPolyLift R`
(monic by `Work.DSG4b.minPolyLift_monic`); localisation is flat over the base ring
(`IsLocalization.flat`), and flatness is transitive. -/
theorem rootLocal_flat (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    Module.Flat R (Work.DSG4b.rootLocal R) := by
  have hroot : Module.Flat R (rootRing R) :=
    RFAux.flat_quotient_monic (minPolyLift R) (minPolyLift_monic R)
  haveI := hroot
  have hloc : Module.Flat (rootRing R) (rootLocal R) :=
    IsLocalization.flat (rootLocal R) (rootKer R).primeCompl
  exact Module.Flat.trans R (rootRing R) (rootLocal R)

end Work.DSG4b
