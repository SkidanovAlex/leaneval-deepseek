import Mathlib
import Submission.Work.DSG4b.Defs
import Submission.Work.DSG4b.AdicNoetherianGraded

/-!
# Stacks 05GH without the Noetherian hypothesis on `R`

If `R ⧸ I` is Noetherian and `I` is finitely generated, then the `I`-adic completion `R̂` of `R`
is a Noetherian ring.  Note that no hypothesis is made on `R` itself: the point is that `R̂` is
determined by the quotients `R ⧸ I ^ n`, and everything needed for the graded descent
(`Work.DSG4b.isNoetherianRing_of_isAdicComplete_graded`) is already visible modulo `I`.

The argument (Stacks 05GH): write `A = R̂ = AdicCompletion I R` and `J = I A ⊆ A` for the ideal
generated by the image of `I`.

* `J` is finitely generated (image of the finitely generated `I`), and `A ⧸ J ≃+* R ⧸ I` because
  `RingHom.ker (AdicCompletion.evalOneₐ I) = J` (`AdicCompletion.ker_evalOneₐ_eq_map`), so `A ⧸ J`
  is Noetherian.
* Hence the associated graded ring `gr_J(A) = reesAlgebra J ⧸ J·reesAlgebra J` is Noetherian
  (Mathlib's `isNoetherianRing_reesAlgebra_quotient`).
* `A` is `J`-adically complete (`AdicCompletion.isAdicComplete_self`), so the graded descent
  applies and `A` is Noetherian.
-/

namespace Work.DSG4b

universe u

/-- Sub-step of `Work.DSG4b.adicCompletion_noetherian_of_noetherian_quotient`: the quotient of the
`I`-adic completion of `R` by the ideal generated by the image of `I` is Noetherian, given only
that `I` is finitely generated and `R ⧸ I` is Noetherian.  (This is
`Work.DSG4b.isNoetherianRing_quotient_adicCompletion` with the hypothesis `IsNoetherianRing R`
replaced by `I.FG`.) -/
theorem isNoetherianRing_quotient_adicCompletion_of_fg {R : Type u} [CommRing R] (I : Ideal R)
    (hI : I.FG) [IsNoetherianRing (R ⧸ I)] :
    IsNoetherianRing
      (AdicCompletion I R ⧸ Ideal.map (algebraMap R (AdicCompletion I R)) I) := by
  have hker : RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom =
      Ideal.map (algebraMap R (AdicCompletion I R)) I :=
    AdicCompletion.ker_evalOneₐ_eq_map I hI
  -- `R̂ ⧸ I R̂ ≃+* R ⧸ I` via `evalOneₐ`, whose kernel is `I R̂`.
  refine isNoetherianRing_of_ringEquiv (R ⧸ I)
    (((Ideal.quotEquivOfEq hker.symm).trans
      (RingHom.quotientKerEquivOfSurjective
        (f := (AdicCompletion.evalOneₐ I).toRingHom)
        (AdicCompletion.evalOneₐ_surjective I))).symm)

/-- **Stacks 05GH.** If `R ⧸ I` is Noetherian and `I` is finitely generated, then the
`I`-adic completion of `R` is a Noetherian ring.  (No hypothesis that `R` itself is
Noetherian.)  This generalises `Work.DSG4b.isNoetherianRing_adicCompletion`, which is
the case where `R` is Noetherian. -/
theorem adicCompletion_noetherian_of_noetherian_quotient (R : Type u) [CommRing R]
    (I : Ideal R) (hI : I.FG) [IsNoetherianRing (R ⧸ I)] :
    IsNoetherianRing (AdicCompletion I R) := by
  let J : Ideal (AdicCompletion I R) := Ideal.map (algebraMap R (AdicCompletion I R)) I
  have hJ : J.FG := hI.map _
  have : IsNoetherianRing (AdicCompletion I R ⧸ J) :=
    isNoetherianRing_quotient_adicCompletion_of_fg I hI
  -- The associated graded ring of `R̂` along `J = I R̂` is Noetherian.
  have hgr : IsNoetherianRing
      (reesAlgebra J ⧸ Ideal.map (algebraMap (AdicCompletion I R) (reesAlgebra J)) J) :=
    isNoetherianRing_reesAlgebra_quotient (I := J) hJ
  exact isNoetherianRing_of_isAdicComplete_graded J
    (AdicCompletion.isAdicComplete_self I hI) hgr

end Work.DSG4b
