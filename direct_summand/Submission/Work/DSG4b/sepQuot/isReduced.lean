import Mathlib

/-!
# Separable min-poly quotients are reduced

Let `L` be a field and `f : ι → L[X]` a family of separable polynomials.  We show that the quotient
of `MvPolynomial ι L` by the ideal generated by the `f i (X i)` (one variable `X i` per polynomial)
is reduced.

The proof has three parts.

* `finiteCase`: for a *finite* index type `σ` the quotient is reduced.  Equivalently it is (formally)
  unramified over `L`: its module of Kähler differentials vanishes because
  `d (f i (X i)) = f i'(X i) · dX i` and `f i'(X i)` is a unit modulo `f i (X i)` (Bezout, using
  separability).  A finite type unramified algebra over a field is reduced
  (`Algebra.FormallyUnramified.isReduced_of_field`).
* `existsFinsetSpan` reduces membership in `Ideal.span (Set.range g)` to a finite sub-family.
* `mem_of_mem_map_rename` is the descent step along `MvPolynomial.rename Subtype.val`, using the
  retraction `MvPolynomial.killCompl`.

The main theorem then proves that the defining ideal is radical by restricting a putative
nilpotent to finitely many variables and applying `finiteCase` there.
-/

namespace Work.DSG4b.sepQuot

open Polynomial MvPolynomial

set_option linter.style.haveILetI false

/-- The ideal of the polynomial ring in the variables of a finset `s` generated by the `f i (X i)`
is carried by `MvPolynomial.rename Subtype.val` to the ideal generated by the corresponding
elements in the ambient polynomial ring. -/
theorem mapRenameSpan (k : Type*) [CommRing k] {ι : Type*} (s : Finset ι)
    (f : ι → Polynomial k) :
    Ideal.map (MvPolynomial.rename (Subtype.val : ↥s → ι))
        (Ideal.span (Set.range (fun i : ↥s =>
          (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s k)))) =
      Ideal.span (Set.range (fun i : ↥s =>
        (f (i : ι)).aeval (MvPolynomial.X (i : ι) : MvPolynomial ι k))) := by
  have hcomp : (MvPolynomial.rename (Subtype.val : ↥s → ι)) ∘
      (fun i : ↥s => (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s k)) =
      (fun i : ↥s => (f (i : ι)).aeval (MvPolynomial.X (i : ι) : MvPolynomial ι k)) := by
    funext i
    rw [Function.comp_apply, ← Polynomial.aeval_algHom_apply
      (MvPolynomial.rename (Subtype.val : ↥s → ι)) (MvPolynomial.X i) (f i),
      MvPolynomial.rename_X]
  rw [Ideal.map_span, ← Set.range_comp, hcomp]

/-- Every element of `Ideal.span (Set.range g)` in a polynomial ring lies in the ideal generated by
the `g i` for `i` in a suitable finite set. -/
theorem existsFinsetSpan (k : Type*) [CommSemiring k] {ι : Type*} (g : ι → MvPolynomial ι k)
    (x : MvPolynomial ι k) (hx : x ∈ Ideal.span (Set.range g)) :
    ∃ t : Finset ι, x ∈ Ideal.span (Set.range (fun i : ↥t => g (i : ι))) := by
  classical
  obtain ⟨c, hc⟩ := (Finsupp.mem_ideal_span_range_iff_exists_finsupp (v := g)).mp hx
  refine ⟨c.support, ?_⟩
  rw [← hc]
  refine Submodule.sum_mem _ fun i hi => ?_
  exact Ideal.mul_mem_left _ _ (Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩)

/-- Descent along `rename Subtype.val` using the retraction `killCompl`: if the image of `z` under
`rename` lies in the extension of the ideal `J`, then `z ∈ J`. -/
theorem mem_of_mem_map_rename (L : Type*) [Field L] {ι : Type*} (s : Finset ι)
    (J : Ideal (MvPolynomial ↥s L)) (z : MvPolynomial ↥s L)
    (hz : MvPolynomial.rename (Subtype.val : ↥s → ι) z ∈
      Ideal.map (MvPolynomial.rename (Subtype.val : ↥s → ι)) J) :
    z ∈ J := by
  let F : MvPolynomial ↥s L →ₐ[L] MvPolynomial ι L := MvPolynomial.rename Subtype.val
  let ρ : MvPolynomial ι L →ₐ[L] MvPolynomial ↥s L :=
    MvPolynomial.killCompl (R := L) (f := (Subtype.val : ↥s → ι)) Subtype.val_injective
  have hρF : ∀ p, ρ (F p) = p := fun p => MvPolynomial.killCompl_rename_app _ p
  have hz'' : F z ∈ Submodule.span (MvPolynomial ι L) (F '' (J : Set (MvPolynomial ↥s L))) := hz
  obtain ⟨c, hc, hsum⟩ := Submodule.mem_span_set.mp hz''
  have hsum' : F z = ∑ m ∈ c.support, c m • m := hsum.symm
  have hz1 : z = ρ (∑ m ∈ c.support, c m • m) := by
    rw [← hsum']
    exact (hρF z).symm
  rw [hz1, map_sum]
  refine Submodule.sum_mem _ fun m hm => ?_
  obtain ⟨y, hyJ, hyf⟩ := hc (Finset.mem_coe.mpr hm)
  have hρm : ρ m = y := by rw [← hyf]; exact hρF y
  rw [smul_eq_mul, map_mul, hρm]
  exact Ideal.mul_mem_left _ _ hyJ

/-- **Finite case.**  Let `L` be a field and `σ` a finite index type.  For a family
`f : σ → L[X]` of separable polynomials the quotient of `MvPolynomial σ L` by the ideal generated
by the `f i (X i)` is reduced. -/
theorem finiteCase (L : Type*) [Field L] (σ : Type*) [Fintype σ] (f : σ → Polynomial L)
    (hf : ∀ i, (f i).Separable) :
    IsReduced (MvPolynomial σ L ⧸ Ideal.span (Set.range (fun i : σ =>
      (f i).aeval (MvPolynomial.X i : MvPolynomial σ L)))) := by
  haveI : Algebra.FormallyUnramified L
      (MvPolynomial σ L ⧸ Ideal.span (Set.range (fun i : σ =>
        (f i).aeval (MvPolynomial.X i : MvPolynomial σ L)))) := by
    rw [Algebra.formallyUnramified_iff]
    set I : Ideal (MvPolynomial σ L) := Ideal.span (Set.range (fun i : σ =>
        (f i).aeval (MvPolynomial.X i : MvPolynomial σ L))) with hI
    let g : σ → MvPolynomial σ L := fun i => (f i).aeval (MvPolynomial.X i)
    let φ : MvPolynomial σ L →ₐ[L] (MvPolynomial σ L ⧸ I) := Ideal.Quotient.mkₐ L I
    have hgmem (i : σ) : g i ∈ I := by
      rw [hI]; exact Ideal.subset_span ⟨i, rfl⟩
    have hφg (i : σ) : φ (g i) = 0 := by
      change Ideal.Quotient.mk I (g i) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact hgmem i
    have hx0 (i : σ) : Polynomial.aeval (φ (MvPolynomial.X i)) (f i) = 0 := by
      rw [Polynomial.aeval_algHom_apply φ (MvPolynomial.X i) (f i)]
      exact hφg i
    have hunit (i : σ) : IsUnit (algebraMap (MvPolynomial σ L) (MvPolynomial σ L ⧸ I)
        (Polynomial.aeval (MvPolynomial.X i) (Polynomial.derivative (f i)))) := by
      obtain ⟨a, b, hab⟩ := (Polynomial.separable_def' (f i)).mp (hf i)
      have hbez : Polynomial.aeval (φ (MvPolynomial.X i)) (a * f i) +
          Polynomial.aeval (φ (MvPolynomial.X i)) (b * Polynomial.derivative (f i)) = 1 := by
        rw [← Polynomial.aeval_add, hab, Polynomial.aeval_one]
      rw [Polynomial.aeval_mul, Polynomial.aeval_mul, hx0 i] at hbez
      simp only [mul_zero, zero_add] at hbez
      have hu : IsUnit (Polynomial.aeval (φ (MvPolynomial.X i)) (Polynomial.derivative (f i))) :=
        IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact hbez)
      rw [Polynomial.aeval_algHom_apply φ (MvPolynomial.X i) (Polynomial.derivative (f i))] at hu
      rw [Ideal.Quotient.algebraMap_eq]
      exact hu
    have hzero (i : σ) : KaehlerDifferential.map L L (MvPolynomial σ L) (MvPolynomial σ L ⧸ I)
        (KaehlerDifferential.D L (MvPolynomial σ L) (MvPolynomial.X i)) = 0 := by
      have h1 : KaehlerDifferential.D L (MvPolynomial σ L) (g i) =
          Polynomial.aeval (MvPolynomial.X i) (Polynomial.derivative (f i)) •
            KaehlerDifferential.D L (MvPolynomial σ L) (MvPolynomial.X i) :=
        Derivation.comp_aeval_eq (MvPolynomial.X i)
          (KaehlerDifferential.D L (MvPolynomial σ L)) (f i)
      have h2 : KaehlerDifferential.map L L (MvPolynomial σ L) (MvPolynomial σ L ⧸ I)
          (KaehlerDifferential.D L (MvPolynomial σ L) (g i)) = 0 := by
        rw [KaehlerDifferential.map_D]
        have h0 : algebraMap (MvPolynomial σ L) (MvPolynomial σ L ⧸ I) (g i) = 0 := by
          rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
          exact hgmem i
        rw [h0, map_zero]
      rw [h1, LinearMap.map_smul] at h2
      exact (hunit i).smul_eq_zero.mp (by simpa only [IsScalarTower.algebraMap_smul] using h2)
    have hsurj : Function.Surjective (KaehlerDifferential.map L L (MvPolynomial σ L)
        (MvPolynomial σ L ⧸ I)) := by
      apply KaehlerDifferential.map_surjective_of_surjective
      rw [Ideal.Quotient.algebraMap_eq]
      exact Ideal.Quotient.mk_surjective
    refine ⟨fun y₁ y₂ => ?_⟩
    have h1 : ∀ z : Ω[MvPolynomial σ L⁄L],
        KaehlerDifferential.map L L (MvPolynomial σ L) (MvPolynomial σ L ⧸ I) z = 0 := by
      intro z
      rw [← Module.Basis.sum_repr (KaehlerDifferential.mvPolynomialBasis L σ) z, map_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [map_smul, KaehlerDifferential.mvPolynomialBasis_apply, hzero i, smul_zero]
    obtain ⟨z₁, rfl⟩ := hsurj y₁
    obtain ⟨z₂, rfl⟩ := hsurj y₂
    rw [h1 z₁, h1 z₂]
  exact Algebra.FormallyUnramified.isReduced_of_field L _

/-- **Separable min-poly quotients are reduced.**  Let `L` be a field and `f : ι → L[X]` a family of
separable polynomials.  Then the quotient of `MvPolynomial ι L` by the ideal generated by the
`f i` (one variable per polynomial) is reduced (indeed it is a filtered colimit of finite products
of fields). -/
theorem isReduced (L : Type*) [Field L] (ι : Type*) (f : ι → Polynomial L)
    (hf : ∀ i, (f i).Separable) :
    IsReduced (MvPolynomial ι L ⧸ Ideal.span (Set.range (fun i : ι =>
      (f i).aeval (MvPolynomial.X i : MvPolynomial ι L)))) := by
  classical
  rw [← Ideal.isRadical_iff_quotient_reduced]
  rw [Ideal.IsRadical]
  intro p hp
  rw [Ideal.mem_radical_iff] at hp
  obtain ⟨n, hn⟩ := hp
  obtain ⟨t, ht⟩ := existsFinsetSpan L
    (fun i : ι => (f i).aeval (MvPolynomial.X i : MvPolynomial ι L)) (p ^ n) hn
  obtain ⟨s₀, q₀, hq₀⟩ := MvPolynomial.exists_finset_rename p
  set s : Finset ι := s₀ ∪ t with hs
  let incl : ↥s₀ → ↥s := fun i => ⟨i.1, by rw [hs]; exact Finset.mem_union_left t i.2⟩
  let q : MvPolynomial ↥s L := MvPolynomial.rename incl q₀
  have hq : p = MvPolynomial.rename (Subtype.val : ↥s → ι) q := by
    dsimp only [q]
    rw [hq₀, MvPolynomial.rename_rename]
    congr 1
  have ht' : p ^ n ∈ Ideal.span (Set.range (fun i : ↥s =>
      (f (i : ι)).aeval (MvPolynomial.X (i : ι) : MvPolynomial ι L))) := by
    refine Ideal.span_mono ?_ ht
    rintro x ⟨i, rfl⟩
    exact ⟨⟨i.1, by rw [hs]; exact Finset.mem_union_right s₀ i.2⟩, rfl⟩
  have hzmem : MvPolynomial.rename (Subtype.val : ↥s → ι) (q ^ n) ∈
      Ideal.map (MvPolynomial.rename (Subtype.val : ↥s → ι))
        (Ideal.span (Set.range (fun i : ↥s =>
          (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s L)))) := by
    rw [mapRenameSpan L s f, map_pow, ← hq]
    exact ht'
  have hqn : q ^ n ∈ Ideal.span (Set.range (fun i : ↥s =>
      (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s L))) :=
    mem_of_mem_map_rename L s
      (Ideal.span (Set.range (fun i : ↥s =>
        (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s L)))) (q ^ n) hzmem
  have hred := finiteCase L ↥s (fun i : ↥s => f (i : ι)) (fun i : ↥s => hf (i : ι))
  have hrad : (Ideal.span (Set.range (fun i : ↥s =>
      (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s L)))).IsRadical :=
    (Ideal.isRadical_iff_quotient_reduced _).mpr hred
  have hqJ : q ∈ Ideal.span (Set.range (fun i : ↥s =>
      (f i).aeval (MvPolynomial.X i : MvPolynomial ↥s L))) := by
    rw [Ideal.IsRadical] at hrad
    exact hrad (Ideal.mem_radical_iff.mpr ⟨n, hqn⟩)
  have hmem : MvPolynomial.rename (Subtype.val : ↥s → ι) q ∈
      Ideal.span (Set.range (fun i : ↥s =>
        (f (i : ι)).aeval (MvPolynomial.X (i : ι) : MvPolynomial ι L))) := by
    rw [← mapRenameSpan L s f]
    exact Ideal.mem_map_of_mem _ hqJ
  rw [hq]
  refine Ideal.span_mono ?_ hmem
  rintro x ⟨i, rfl⟩
  exact ⟨(i : ι), rfl⟩

end Work.DSG4b.sepQuot
