import Mathlib
import Submission.Work.DSM1p.Assembly.flat_completion
import Submission.Work.DSM1p.Root.flat_closure

namespace Work.DSG4b.KerTensor

universe u

/-- **The `n`-th quotient of the adic completion of a flat local algebra is flat.**

Let `R` be a Noetherian local ring, `A` a local `R`-algebra which is flat over `R` and whose
maximal ideal is generated by the image of `𝔪_R` (`𝔪_A = 𝔪_R · A`).  Then for every `n` the
`R ⧸ 𝔪_R ^ n`-module
`AdicCompletion 𝔪_A A ⧸ (𝔪_R ^ n) · AdicCompletion 𝔪_A A` is flat, where
`AdicCompletion 𝔪_A A` is regarded as an `R`-algebra.

Indeed `AdicCompletion 𝔪_A A ⧸ 𝔪_A ^ n · AdicCompletion 𝔪_A A ≅ A ⧸ 𝔪_A ^ n A = A ⧸ 𝔪_R ^ n A`
(`AdicCompletion.pow_smul_top_eq_ker_eval` together with surjectivity of `AdicCompletion.eval`,
using `𝔪_A ^ n = (𝔪_R ^ n).map (algebraMap R A)`), and this is flat over `R ⧸ 𝔪_R ^ n` because `A`
is flat over `R` and `A ⧸ 𝔪_R ^ n A ≅ (R ⧸ 𝔪_R ^ n) ⊗[R] A`. -/
theorem quot_map_adicCompletion_flat {R A : Type u} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [CommRing A] [IsLocalRing A] [Algebra R A]
    [IsLocalHom (algebraMap R A)]
    (hmax : IsLocalRing.maximalIdeal A = (IsLocalRing.maximalIdeal R).map (algebraMap R A))
    (hflatA : Module.Flat R A) (n : ℕ) :
    Module.Flat (R ⧸ (IsLocalRing.maximalIdeal R) ^ n)
      ((AdicCompletion (IsLocalRing.maximalIdeal A) A) ⧸
        ((IsLocalRing.maximalIdeal R) ^ n).map
          (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal A) A))) := by
  -- Abbreviate the ideals appearing in the statement.
  set 𝔪 : Ideal R := IsLocalRing.maximalIdeal R with h𝔪
  set I : Ideal A := IsLocalRing.maximalIdeal A with hI
  set J : Ideal R := 𝔪 ^ n with hJ
  set Q : Ideal A := J.map (algebraMap R A) with hQ
  -- `𝔪_A ^ n = (𝔪_R ^ n) · A`.
  have hIn : I ^ n = Q := by
    rw [hmax, ← Ideal.map_pow, ← hJ]
  -- `𝔪_A` is finitely generated, since it is the image of the finitely generated `𝔪_R`.
  have hIFG : I.FG := by
    rw [hmax]
    exact (Ideal.fg_of_isNoetherianRing 𝔪).map (algebraMap R A)
  -- The kernel of the `n`-th coordinate projection of the completion is `𝔪_A ^ n · C`.
  have hker := Work.DSM1p.Assembly.ker_evalₐ_eq_map I hIFG n
  -- The ideal we quotient by is also `𝔪_A ^ n · C`.
  have hPC : J.map (algebraMap R (AdicCompletion I A))
      = (I ^ n).map (algebraMap A (AdicCompletion I A)) := by
    rw [hIn, hQ, Ideal.map_map]
    rfl
  -- The `A`-algebra hom `C → A ⧸ 𝔪_R ^ n A` induced by the `n`-th coordinate projection.
  let Φ : AdicCompletion I A →ₐ[A] A ⧸ Q :=
    ((Ideal.quotientEquivAlgOfEq A hIn).toAlgHom).comp (AdicCompletion.evalₐ I n)
  have hsurj : Function.Surjective Φ :=
    (Ideal.quotientEquivAlgOfEq A hIn).surjective.comp (AdicCompletion.surjective_evalₐ I n)
  have hkerΦ : RingHom.ker Φ = J.map (algebraMap R (AdicCompletion I A)) := by
    rw [hPC, ← hker]
    ext x
    simp only [RingHom.mem_ker]
    constructor
    · intro h
      change (Ideal.quotientEquivAlgOfEq A hIn) ((AdicCompletion.evalₐ I n) x) = 0 at h
      have h' : (Ideal.quotientEquivAlgOfEq A hIn) ((AdicCompletion.evalₐ I n) x)
          = (Ideal.quotientEquivAlgOfEq A hIn) 0 := by rw [map_zero]; exact h
      exact (Ideal.quotientEquivAlgOfEq A hIn).injective h'
    · intro h
      change (Ideal.quotientEquivAlgOfEq A hIn) ((AdicCompletion.evalₐ I n) x) = 0
      have h' : (AdicCompletion.evalₐ I n) x = 0 := h
      rw [h', map_zero]
  -- The `A`-algebra identification `C ⧸ 𝔪_R ^ n C ≃ A ⧸ 𝔪_R ^ n A`.
  let eA : (AdicCompletion I A ⧸ J.map (algebraMap R (AdicCompletion I A))) ≃ₐ[A] (A ⧸ Q) :=
    (Ideal.quotientEquivAlgOfEq A hkerΦ).symm.trans (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  -- `A ⧸ 𝔪_R ^ n A` is flat over `R ⧸ 𝔪_R ^ n` (base change of the flat algebra `A`).
  have hflatY : Module.Flat (R ⧸ J) (A ⧸ Q) := by
    have : Module.Flat R A := hflatA
    exact Work.DSM1p.Root.flat_quot_map R A J
  have : Module.Flat (R ⧸ J) (A ⧸ Q) := hflatY
  -- It remains to see that `eA` is `R ⧸ 𝔪_R ^ n`-linear, i.e. a `R ⧸ 𝔪_R ^ n`-algebra equiv.
  refine Module.Flat.of_linearEquiv (M := A ⧸ Q) ?_
  refine AlgEquiv.toLinearEquiv ?_
  refine AlgEquiv.ofRingEquiv (f := eA.toRingEquiv) ?_
  intro r
  induction r using Quotient.inductionOn with
  | _ a =>
    simp only [AlgEquiv.coe_toRingEquiv]
    show eA (algebraMap (R ⧸ J) (AdicCompletion I A ⧸ J.map (algebraMap R (AdicCompletion I A)))
            (Ideal.Quotient.mk J a))
        = algebraMap (R ⧸ J) (A ⧸ Q) (Ideal.Quotient.mk J a)
    -- Both structure maps factor through `A`.
    have h1 : algebraMap (R ⧸ J) (AdicCompletion I A ⧸ J.map (algebraMap R (AdicCompletion I A)))
          (Ideal.Quotient.mk J a)
        = algebraMap A (AdicCompletion I A ⧸ J.map (algebraMap R (AdicCompletion I A)))
          (algebraMap R A a) := by
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
      rfl
    have h2 : algebraMap A (A ⧸ Q) (algebraMap R A a)
        = algebraMap (R ⧸ J) (A ⧸ Q) (Ideal.Quotient.mk J a) := by
      rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.algebraMap_quotient_map_quotient]
    rw [h1, eA.commutes, h2]

end Work.DSG4b.KerTensor
