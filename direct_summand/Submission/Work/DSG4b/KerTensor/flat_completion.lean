import Mathlib
import Submission.Work.DSG4b.KerTensor.assembly
import Submission.Work.DSG4b.KerTensor.elementwise_artin_rees
import Submission.Work.DSG4b.KerTensor.quot_map_adicCompletion_flat
import Submission.Work.DSG4b.KerTensor.syzygy_mod_pow

/-!
# The adic completion of a flat local algebra is flat over the base

`Work.DSG4b.KerTensor.flat_adicCompletion_maximalIdeal`: if `R` is a Noetherian local ring, `A` a
local `R`-algebra which is flat over `R` and whose maximal ideal is generated by the image of
`𝔪_R` (`𝔪_A = 𝔪_R · A`), then `AdicCompletion 𝔪_A A` is flat over `R`.

The proof puts the machinery of `Work.DSG4b.KerTensor.assembly` (an adaptation of Bhatt's
Proposition 4.1, flat part, to an arbitrary ideal) to work with `I := 𝔪_R` and
`B := AdicCompletion 𝔪_A A`, regarded as an `R`-algebra (`AdicCompletion.Algebra`).  The three
inputs of the assembly are:

* `quot_map_adicCompletion_flat` — `B ⧸ 𝔪_R ^ n B` is flat over `R ⧸ 𝔪_R ^ n` for every `n`;
* `elementwise_artin_rees` — elementwise Artin–Rees for `𝔪_R`;
* `syzygy_mod_pow` — syzygies modulo `𝔪_R ^ n` with Artin–Rees loss.

Completeness of `B` for the ideal `𝔪_R · B` is transported from
`AdicCompletion.isAdicComplete` (which gives `𝔪_A`-adic completeness of `B` as an `A`-module)
along `IsAdicComplete.map_algebraMap_iff`, twice.
-/

namespace Work.DSG4b.KerTensor

universe u

open TensorProduct

/-- **The `𝔪`-adic completion of a flat local `R`-algebra is flat over `R`.** -/
theorem flat_adicCompletion_maximalIdeal {R A : Type u} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    (hflatA : Module.Flat R A)
    (hmax : IsLocalRing.maximalIdeal A = (IsLocalRing.maximalIdeal R).map (algebraMap R A)) :
    Module.Flat R (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
  have hfg : (IsLocalRing.maximalIdeal A).FG := by
    rw [hmax]
    exact (IsLocalRing.maximalIdeal R).fg_of_isNoetherianRing.map _
  haveI hcompA : IsAdicComplete (IsLocalRing.maximalIdeal A)
      (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    AdicCompletion.isAdicComplete hfg
  haveI hcompR : IsAdicComplete (IsLocalRing.maximalIdeal R)
      (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    (IsAdicComplete.map_algebraMap_iff (IsLocalRing.maximalIdeal R)
      (AdicCompletion (IsLocalRing.maximalIdeal A) A) (S := A)).mp (hmax ▸ hcompA)
  haveI hcompB : IsAdicComplete ((IsLocalRing.maximalIdeal R).map
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal A) A)))
      (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    (IsAdicComplete.map_algebraMap_iff (IsLocalRing.maximalIdeal R)
      (AdicCompletion (IsLocalRing.maximalIdeal A) A)).mpr hcompR
  exact flat_of_flat_mod_base_general (IsLocalRing.maximalIdeal R)
    (fun n => quot_map_adicCompletion_flat hmax hflatA n)
    (fun g => elementwise_artin_rees (IsLocalRing.maximalIdeal R) g)
    (fun g c hc hfl => syzygy_mod_pow (IsLocalRing.maximalIdeal R) g c hc hfl)

end Work.DSG4b.KerTensor
