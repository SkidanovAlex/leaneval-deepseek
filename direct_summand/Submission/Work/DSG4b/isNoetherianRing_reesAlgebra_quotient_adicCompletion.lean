import Mathlib

/-!
# `Work.DSG4b.isNoetherianRing_reesAlgebra_quotient_adicCompletion`

Let `R` be a Noetherian ring, `I ⊆ R` a finitely generated ideal, `R̂ = AdicCompletion I R` and
`J = I R̂ ⊆ R̂`.  We show that the Rees algebra of `J` modulo the ideal generated by `J` is
Noetherian.  That quotient is the ring `⨁ₙ Jⁿ/Jⁿ⁺¹` (the associated graded ring of `R̂` along `J`),
which appears in the Rees-algebra formulation of Artin–Rees.

Mathlib's `isNoetherianRing_reesAlgebra_quotient` reduces this (for a general ring `S` and ideal
`I ⊆ S`) to the Noetherianness of `S ⧸ I` together with `I.FG`.  Applied to `S = R̂` and `I = J` it
therefore suffices to know that `R̂ ⧸ J` is Noetherian.  That quotient is *not* the hard statement
"the adic completion of a Noetherian ring is Noetherian"
(`Work.DSG4b.isNoetherianRing_adicCompletion`): `R̂ ⧸ J ≃+* R ⧸ I` via `AdicCompletion.evalOneₐ`,
whose kernel is `J` by `AdicCompletion.ker_evalOneₐ_eq_map`.  Since `R ⧸ I` is Noetherian, so is
`R̂ ⧸ J`.
-/

namespace Work.DSG4b

theorem isNoetherianRing_reesAlgebra_quotient_adicCompletion {R : Type*} [CommRing R]
    [IsNoetherianRing R] (I : Ideal R) (hI : I.FG) :
    IsNoetherianRing (reesAlgebra (Ideal.map (algebraMap R (AdicCompletion I R)) I) ⧸
      Ideal.map (algebraMap (AdicCompletion I R)
        (reesAlgebra (Ideal.map (algebraMap R (AdicCompletion I R)) I)))
        (Ideal.map (algebraMap R (AdicCompletion I R)) I)) := by
  -- The kernel of the surjection `evalOneₐ : AdicCompletion I R →+* R ⧸ I` is the ideal generated
  -- by `I`; hence `R̂ ⧸ I R̂ ≃+* R ⧸ I` is Noetherian because `R ⧸ I` is.
  have hker := AdicCompletion.ker_evalOneₐ_eq_map I hI
  have : IsNoetherianRing
      (AdicCompletion I R ⧸ Ideal.map (algebraMap R (AdicCompletion I R)) I) :=
    isNoetherianRing_of_ringEquiv (R ⧸ I)
      (((Ideal.quotEquivOfEq hker.symm).trans
        (RingHom.quotientKerEquivOfSurjective (f := (AdicCompletion.evalOneₐ I).toRingHom)
          (AdicCompletion.evalOneₐ_surjective I))).symm)
  -- Mathlib: the Rees algebra of `J` modulo `J` is Noetherian as soon as `R̂ ⧸ J` is and `J` is f.g.
  exact isNoetherianRing_reesAlgebra_quotient (hI.map _)

end Work.DSG4b
