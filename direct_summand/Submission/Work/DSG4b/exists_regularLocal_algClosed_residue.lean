/-!
# DSG4b — residue-field enlargement: proof architecture

This file proves the target statement (bottom of the file).  The ingredients, and where they live:

* `Submission/Work/DSG4b/gonf_residue_enlargement.lean`: the *residue-field enlargement* for a
  Noetherian local ring `R`: a flat local `R`-algebra `A` with `maximalIdeal A = (maximalIdeal R).A`
  and algebraically closed residue field (the frozen node `DSMap.Gaps.gonf_residue`).  This is
  where the Cohen-free construction (p-basis tower for the perfect closure + one localisation for
  the separable closure) lives.
* `Submission/Work/DSG4b/ker_tensor_maximalIdeal_completion.lean`: `Tor₁^R(κ, Â) = 0` for the
  `𝔪`-adic completion `Â` of `A`; this is the *only* place where flatness of the completion (which
  is not Noetherian-a-priori) is paid for.
* `Submission/Work/DSG4b/localCriterionOfFlatness.lean`: Stacks 00MK, the local criterion of
  flatness; together with the previous item it gives `Module.Flat R Â`.
* `Submission/Work/DSG4b/adicCompletion_noetherian_of_noetherian_quotient.lean`: Stacks 05GH, the
  `𝔪`-adic completion of `A` is Noetherian.
* `Submission/Work/DSG4b/isRegularLocalRing_of_flat_local_maximalIdeal_eq_map.lean`: bookkeeping:
  a flat local extension of a regular local ring whose maximal ideal is generated by the images of
  a minimal generating family of the base maximal ideal is again regular local.

The upshot: `B := AdicCompletion 𝔪_A A` is a Noetherian flat local `R`-algebra with
`maximalIdeal B = (maximalIdeal R)·B` and residue field `ResidueField A` (algebraically closed),
hence a regular local ring by the bookkeeping lemma.

Design notes (the classical proof uses the Cohen structure theorem, which is not in Mathlib, so the
construction has to be intrinsic).

Step 1 (completion).  `R̂ := AdicCompletion (maximalIdeal R) R` is flat over `R`
(`AdicCompletion.flat_of_isNoetherian`), complete (`AdicCompletion.isAdicComplete_of_fg`), local
with `maximalIdeal R̂ = (maximalIdeal R).map (algebraMap R R̂)`, the same residue field
(`AdicCompletion.residueField_map_bijective`) and the same `spanFinrank`
(`AdicCompletion.spanFinrank_maximalIdeal_eq`).  But here we do not need to assume `R` complete
first: the enlargement is built directly over `R`.

Step 2 (residue field enlargement) is the crux and lives in
`Submission/Work/DSG4b/gonf_residue_enlargement.lean`.  Put `k = ResidueField R`,
`K = AlgebraicClosure k`.  A Cohen-free route is a *filtered colimit* of finite flat local
`R`-algebras whose residue fields run over the finite subextensions of `K/k`; the docstring of that
file records the details (including the two pitfalls: purely inseparable steps need a `p`-basis
tower instead of minimal polynomials, and redundant generators have to be factored out by a
localisation).

Step 3 (the completion).  `B := AdicCompletion 𝔪_A A` is Noetherian (05GH: `A ⧸ 𝔪_A = K` is a
field and `𝔪_A = (maximalIdeal R)·A` is finitely generated), local with residue field `K`
(Mathlib's `AdicCompletion.isLocalRing_of_fg` / `residueField_map_bijective_of_fg`), and flat over
`R` (00MK, whose hypothesis `Tor₁^R(κ, B) = ker (𝔪 ⊗[R] B → B) = 0` is the delegated lemma
`Work.DSG4b.ker_tensor_maximalIdeal_completion`).

Step 4 (bookkeeping).  `spanFinrank 𝔪_B ≤ spanFinrank 𝔪_R = ringKrullDim R ≤ ringKrullDim B`
(the last inequality is `Work.DSG4b.flat_local_le_ringKrullDim`), so `B` is regular local.
-/

namespace Work.DSG4b

universe u

open IsLocalRing

/-- **Česnavičius, *Purity for the Brauer group*, Lemma 5.1 (EGA 0_III 10.3.1), local case.**
Every regular local ring `R` admits a flat local `R`-algebra `B` which is a regular local ring with
algebraically closed residue field.  This is the residue-field enlargement, i.e. the mathematical
content of the frozen `DSMap.area_G4b_gonflement` in the local case;
`Submission/Work/DSG4b/Main.lean` recovers the frozen statement from it by localising
(`Work.DSG4b.isGonflement_of_localization`) and completing `B` at its maximal ideal.

See the module docstring for the architecture: the residue-field enlargement
(`Work.DSG4b.gonf_residue_enlargement`), the `𝔪`-adic completion, flatness of that completion
(`Work.DSG4b.ker_tensor_maximalIdeal_completion` + the local criterion of flatness 00MK),
Noetherianness (05GH) and the `dim`/`spanFinrank` bookkeeping. -/
theorem exists_regularLocal_algClosed_residue (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    ∃ (B : Type u) (_ : CommRing B) (_ : IsRegularLocalRing B) (ψ : R →+* B),
      ψ.Flat ∧ IsLocalHom ψ ∧ IsAlgClosed (IsLocalRing.ResidueField B) := by
  -- ## Step 1: the residue-field enlargement
  obtain ⟨A, hCommA, hLocalA, ψ, hflatψ, hmaxψ, halgA⟩ := Work.DSG4b.gonf_residue_enlargement R
  letI : CommRing A := hCommA
  letI : IsLocalRing A := hLocalA
  -- `ψ` is a local homomorphism: it maps the maximal ideal onto the maximal ideal
  have hlocψ : IsLocalHom ψ := by
    refine ⟨fun x hx => ?_⟩
    rw [← IsLocalRing.notMem_maximalIdeal] at hx ⊢
    intro hxm
    exact hx (hmaxψ ▸ Ideal.mem_map_of_mem ψ hxm)
  letI : Algebra R A := ψ.toAlgebra
  have hmax : IsLocalRing.maximalIdeal A = (IsLocalRing.maximalIdeal R).map (algebraMap R A) := by
    rw [RingHom.algebraMap_toAlgebra]; exact hmaxψ.symm
  -- `𝔪_A` is finitely generated and `A ⧸ 𝔪_A` is a field (indeed the algebraically closed `K`)
  have hfgA : (IsLocalRing.maximalIdeal A).FG := by
    rw [hmax]
    exact (Ideal.fg_of_isNoetherianRing (IsLocalRing.maximalIdeal R)).map (algebraMap R A)
  haveI : IsNoetherianRing (IsLocalRing.ResidueField A) := inferInstance
  haveI : IsNoetherianRing (A ⧸ IsLocalRing.maximalIdeal A) :=
    ‹IsNoetherianRing (IsLocalRing.ResidueField A)›
  -- ## Step 2: complete `A` at its maximal ideal
  let B := AdicCompletion (IsLocalRing.maximalIdeal A) A
  haveI : IsNoetherianRing B :=
    adicCompletion_noetherian_of_noetherian_quotient A (IsLocalRing.maximalIdeal A) hfgA
  haveI : IsLocalRing B := AdicCompletion.isLocalRing_of_fg (R := A) hfgA
  haveI : IsLocalHom (algebraMap A B) :=
    AdicCompletion.algebraMap_isLocalHom_of_fg (R := A) hfgA
  have hmaxB : IsLocalRing.maximalIdeal B = (IsLocalRing.maximalIdeal A).map (algebraMap A B) :=
    AdicCompletion.maximalIdeal_eq_map_of_fg (R := A) hfgA
  haveI : IsAdicComplete (IsLocalRing.maximalIdeal B) B :=
    AdicCompletion.isAdicComplete_of_fg (R := A) hfgA
  -- the `R`-algebra structure on `B` is the canonical one (`Algebra R (AdicCompletion 𝔪_A A)`)
  haveI : IsLocalHom (algebraMap R B) := RingHom.isLocalHom_comp (algebraMap A B) (algebraMap R A)
  -- ## Step 3: `B` is flat over `R`
  have hflatB : Module.Flat R B :=
    localCriterionOfFlatnessPrime (R := R) (S := B) (M := B)
      (ker_tensor_maximalIdeal_completion (R := R) (A := A) hflatψ hmax)
  -- ## Step 4: the residue field of `B` is that of `A`, hence algebraically closed
  have hresB : IsAlgClosed (IsLocalRing.ResidueField B) := by
    have hbij := AdicCompletion.residueField_map_bijective_of_fg (R := A) hfgA
    haveI : IsAlgClosed (IsLocalRing.ResidueField A) := halgA
    exact IsAlgClosed.of_ringEquiv (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)
      (RingEquiv.ofBijective (IsLocalRing.ResidueField.map (algebraMap A B)) hbij)
  -- ## Step 5: `B` is regular local (bookkeeping)
  have hfgR : (IsLocalRing.maximalIdeal R).FG := Ideal.fg_of_isNoetherianRing _
  obtain ⟨s, hcard, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank (p := IsLocalRing.maximalIdeal R) hfgR
  have hmaxB' : IsLocalRing.maximalIdeal B = Ideal.span ((s : Set R).image (algebraMap R B)) := by
    have h4 : (IsLocalRing.maximalIdeal A).map (algebraMap A B)
        = ((IsLocalRing.maximalIdeal R).map (algebraMap R A)).map (algebraMap A B) :=
      congrArg (fun J : Ideal A => J.map (algebraMap A B)) hmax
    have hcomp : (algebraMap A B).comp (algebraMap R A) = algebraMap R B := by
      ext r n
      exact IsScalarTower.algebraMap_apply R A (A ⧸ (IsLocalRing.maximalIdeal A) ^ n • (⊤ : Ideal A)) r
    rw [hmaxB, h4, Ideal.map_map, hcomp, ← hspan, Ideal.map_span]
  have hregB : IsRegularLocalRing B :=
    isRegularLocalRing_of_flat_local_maximalIdeal_eq_span (algebraMap R B) hflatB s hspan hcard hmaxB'
  exact ⟨B, inferInstance, hregB, algebraMap R B, hflatB, inferInstance, hresB⟩

end Work.DSG4b
