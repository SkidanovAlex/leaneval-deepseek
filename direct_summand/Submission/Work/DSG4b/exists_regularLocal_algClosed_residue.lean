import Mathlib
import Submission.Work.DSG4b.Defs
import Submission.Work.DSG4b.Root
import Submission.Work.DSG4b.RootLift
import Submission.Work.DSG4b.flat_local_le_ringKrullDim
import Submission.Work.DSG4b.isRegularLocalRing_of_flat_local_maximalIdeal_eq_map
import Submission.Work.DSG4b.adicCompletion_noetherian_of_noetherian_quotient
import Submission.Work.DSG4b.localCriterionOfFlatnessPrime
