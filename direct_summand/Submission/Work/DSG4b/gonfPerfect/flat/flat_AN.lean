import Mathlib
import Submission.Work.DSG4b.gonfPerfect.Basic

namespace Work.DSG4b.gonfPerfect.flat

/-- The `N`-th stage `AN D N` is the quotient of `MvPolynomial D.pB R` by the ideal generated by
the monic polynomials `T^{p^N} - b̃_j`, hence flat over `R`. -/
theorem flat_AN (R : Type*) [CommRing R] [IsLocalRing R] (p : ℕ) [Fact p.Prime] [CharP (IsLocalRing.ResidueField R) p] (D : PData R p) (N : ℕ) : Module.Flat R (D.AN N) := by
  have hmono : ∀ b : D.pB, (D.fN N b).Monic := fun b =>
    Polynomial.monic_X_pow_sub_C (D.lift b)
      (pow_ne_zero N (Nat.Prime.ne_zero (Fact.out : p.Prime)))
  exact RFAux.flat_quotient_monic (D.fN N) hmono

end Work.DSG4b.gonfPerfect.flat
