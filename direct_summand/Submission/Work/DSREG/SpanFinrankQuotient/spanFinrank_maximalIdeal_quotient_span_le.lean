import Mathlib
import Submission.Work.DSREG.Defs

/-!
# Span rank of the maximal ideal modulo a minimal generator

This file proves `Work.DSREG.SpanFinrankQuotient.spanFinrank_maximalIdeal_quotient_span_le`:
in a Noetherian local ring `R` whose maximal ideal `m` can be generated by at most `n + 1`
elements, and for an element `x ∈ m \ m²` (i.e. a *minimal* generator of `m`), the image of `m`
in `R ⧸ (x)` can be generated by at most `n` elements, i.e.
`(m.map (Ideal.Quotient.mk (span {x}))).spanFinrank ≤ n`.

The key ingredient is the elementary "removal of a minimal generator" lemma
`exists_finset_card_le_pred_span_sup_singleton`, proved below: if `I = span s` for a finite
set `s` and `x ∈ I \ m·m` then some element `g0 ∈ s` can be thrown away, the remaining
generators together with `x` still generating `I`. Indeed writing `x` as a finite
`R`-linear combination of the elements of `s`, some coefficient is a unit (otherwise
`x ∈ m·m`), which lets us solve for the corresponding generator.
-/

open Submodule

namespace Work.DSREG.SpanFinrankQuotient

/-- **Removing a minimal generator.** Let `R` be a local ring with maximal ideal `m`, let
`I ≤ m` be an ideal which is spanned by a finite set `s ⊆ R`, and let `x ∈ I` be such that
`x ∉ m · m`. Then `I` is already generated by `x` together with all but one element of `s`;
more precisely, there is `t ⊆ s` with `t.card ≤ s.card - 1` and
`I ≤ span t ⊔ span {x}`.

The proof writes `x = ∑ l i • i` as a finite linear combination of the elements of `s`.
If every coefficient lay in `m`, then since `s ⊆ I ⊆ m` we would get `x ∈ m · m`, contrary to
the hypothesis; so some coefficient `l i0` is a unit, and the corresponding generator
`g0 = i0` can be expressed via `x` and the remaining generators. -/
lemma exists_finset_card_le_pred_span_sup_singleton (R : Type*) [CommRing R] [IsLocalRing R]
    {I : Ideal R} (hI : I ≤ IsLocalRing.maximalIdeal R) (s : Finset R)
    (hs : Ideal.span (s : Set R) = I) {x : R} (hx : x ∈ I)
    (hx2 : x ∉ IsLocalRing.maximalIdeal R * IsLocalRing.maximalIdeal R) :
    ∃ t : Finset R, t ⊆ s ∧ t.card ≤ s.card - 1 ∧
      I ≤ Ideal.span (t : Set R) ⊔ Ideal.span {x} := by
  classical
  rw [← hs] at hx
  -- Write `x` as a finite `R`-linear combination of the elements of `s`.
  obtain ⟨l, hl⟩ := (Finsupp.mem_span_iff_linearCombination R (s : Set R) x).mp hx
  rw [Finsupp.linearCombination_apply] at hl
  -- Some coefficient of that combination is a unit.
  have hex : ∃ i ∈ l.support, IsUnit (l i) := by
    by_contra hcon
    push Not at hcon
    apply hx2
    rw [← hl, Finsupp.sum]
    apply Ideal.sum_mem
    intro i hi
    rw [smul_eq_mul]
    exact Ideal.mul_mem_mul ((IsLocalRing.mem_maximalIdeal (l i)).2 (hcon i hi))
      (hI (hs ▸ Submodule.subset_span (i.2)))
  obtain ⟨i0, hi0, hu⟩ := hex
  refine ⟨s.erase (i0 : R), Finset.erase_subset _ _, ?_, ?_⟩
  · rw [Finset.card_erase_of_mem (Finset.mem_coe.mp i0.2)]
  · -- `g0 = ↑i0` is in `span (s.erase g0) ⊔ span {x}`.
    let T : Ideal R := Ideal.span ((s.erase (i0 : R) : Finset R) : Set R)
    let W : Ideal R := T ⊔ Ideal.span {x}
    have hxT : x - (l i0) • (i0 : R) ∈ T := by
      have h1 : ∀ i ∈ l.support.erase i0, (l i) • (i : R) ∈ T := by
        intro i hi
        rw [Finset.mem_erase] at hi
        obtain ⟨hne, hmem⟩ := hi
        have hit : (i : R) ∈ ((s.erase (i0 : R) : Finset R) : Set R) := by
          rw [Finset.mem_coe, Finset.mem_erase]
          exact ⟨fun hcontra => hne (Subtype.ext hcontra), Finset.mem_coe.mp i.2⟩
        rw [smul_eq_mul]
        exact Ideal.mul_mem_left T (l i) (Submodule.subset_span hit)
      have h2 : x = (l i0) • (i0 : R) + ∑ i ∈ l.support.erase i0, (l i) • (i : R) := by
        rw [← hl, Finsupp.sum, add_comm, Finset.sum_erase_add _ _ hi0]
      rw [h2, add_sub_cancel_left]
      exact Ideal.sum_mem T h1
    have hux : (l i0) • (i0 : R) ∈ W := by
      have h1 : (l i0) • (i0 : R) = x - (x - (l i0) • (i0 : R)) := by abel
      rw [h1]
      exact W.sub_mem (Ideal.mem_sup_right (Submodule.subset_span (Set.mem_singleton x)))
        (Submodule.mem_sup_left hxT)
    have hg0 : (i0 : R) ∈ W := by
      have hvu : (↑(hu.unit)⁻¹ : R) * (l i0) = 1 := by
        have := Units.inv_mul hu.unit
        rw [IsUnit.unit_spec hu] at this
        exact this
      have hthis : (i0 : R) = (↑(hu.unit)⁻¹ : R) * ((l i0) • (i0 : R)) := by
        rw [smul_eq_mul, ← mul_assoc, hvu, one_mul]
      rw [hthis]
      exact Ideal.mul_mem_left W _ hux
    rw [← hs]
    apply Submodule.span_le.mpr
    intro y hy
    by_cases hyi : y = (i0 : R)
    · subst hyi; exact hg0
    · have : y ∈ ((s.erase (i0 : R) : Finset R) : Set R) := by
        rw [Finset.mem_coe, Finset.mem_erase]
        exact ⟨hyi, Finset.mem_coe.mp hy⟩
      exact Submodule.mem_sup_left (Submodule.subset_span this)

theorem spanFinrank_maximalIdeal_quotient_span_le (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (x : R) (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hx2 : x ∉ IsLocalRing.maximalIdeal R ^ 2) (n : ℕ)
    (h : (IsLocalRing.maximalIdeal R).spanFinrank ≤ n + 1) :
    ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x}))).spanFinrank ≤ n := by
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  -- `m` is finitely generated, with a generating finset of minimal cardinality.
  have hmfg : m.FG := Ideal.fg_of_isNoetherianRing m
  obtain ⟨s, hscard, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hmfg
  have hx2' : x ∉ m * m := by rw [← pow_two]; exact hx2
  -- Remove a minimal generator: `m` is generated by `x` and `t ⊆ s`, `t.card ≤ s.card - 1`.
  obtain ⟨t, ht_sub, htcard, htle⟩ :=
    exists_finset_card_le_pred_span_sup_singleton R le_rfl s hsspan hx hx2'
  set π := Ideal.Quotient.mk (Ideal.span {x}) with hπ
  -- `m = span t ⊔ span {x}`.
  have hspan_eq : m = Ideal.span (t : Set R) ⊔ Ideal.span {x} := by
    refine le_antisymm htle (sup_le ?_ ?_)
    · rw [Submodule.span_le]; intro y hy
      have hy' : y ∈ t := Finset.mem_coe.mp hy
      exact hsspan ▸ Submodule.subset_span (Finset.mem_coe.mpr (ht_sub hy'))
    · rw [Submodule.span_le]; intro y hy
      rw [Set.mem_singleton_iff] at hy; rw [hy]; exact hx
  -- Pushing to `R ⧸ (x)`, the generator `x` becomes `0`, so `m.map π = span (π '' t)`.
  have hmap : m.map π = Ideal.span (π '' (t : Set R)) := by
    rw [hspan_eq, Ideal.map_sup, Ideal.map_span, Ideal.map_span, Set.image_singleton]
    have hx0 : π x = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Submodule.subset_span (Set.mem_singleton x))
    rw [hx0]
    simp
  have hsle : s.card ≤ n + 1 := by rw [hscard]; exact h
  calc (m.map π).spanFinrank = (Ideal.span (π '' (t : Set R))).spanFinrank := by rw [hmap]
    _ ≤ (π '' (t : Set R)).ncard :=
        Submodule.spanFinrank_span_le_ncard_of_finite (t.finite_toSet.image π)
    _ ≤ (t : Set R).ncard := Set.ncard_image_le t.finite_toSet
    _ = t.card := Set.ncard_coe_finset t
    _ ≤ s.card - 1 := htcard
    _ ≤ n := by omega

end Work.DSREG.SpanFinrankQuotient
