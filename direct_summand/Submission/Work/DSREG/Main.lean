import Mathlib
import Submission.Work.DSREG.Defs
import Submission.Work.DSREG.QuotDim
import Submission.Work.DSREG.SpanFinrankQuotient.spanFinrank_maximalIdeal_quotient_span_le
import Submission.Work.DSREG.PrimeDimQuot.exists_isPrime_ringKrullDim_quotient_eq
import Submission.Work.DSREG.DomainIdealBot.eq_bot_of_ringKrullDim_quotient_eq
import Submission.Work.DSREG.QuotQuotDim.ringKrullDim_quotient_le_quotQuot_add_one
import Submission.Work.DSREG.IteratePow.le_iInf_pow_span_singleton_of_notMem

/-!
# DSREG (main): regular local rings are domains

The main theorem of the area is `DSMap.area_REG_proved`: a regular local ring is a domain.

## Proof outline

`IsRegularLocalRing R` means `R` is Noetherian local and
`(maximalIdeal R).spanFinrank = ringKrullDim R`.  We prove the stronger statement

`Work.DSREG.isDomain_of_spanFinrank_maximalIdeal_le_of_ringKrullDim_eq`:

a Noetherian local ring `S` with `(maximalIdeal S).spanFinrank ≤ n` and `ringKrullDim S = n`
is a domain, by induction on `n`.

Induction step (`n ↦ n + 1`): since `dim S = n + 1 > 0`, we have `m ≠ m²` and we may pick
`x ∈ m \ m²`.  The quotient `S' = S ⧸ (x)` is again Noetherian local and

* `spanFinrank (maximalIdeal S') ≤ n` (the number of generators drops by one), and
* `ringKrullDim S' = n` (upper bound from `dim ≤ spanFinrank (maximalIdeal)`, lower bound from
  `dim S ≤ dim S' + 1`),

so `S'` is a domain by induction.

If `S` were not a domain, `⊥` is not prime, so by
`exists_isPrime_ringKrullDim_quotient_eq` there is a prime `p ≠ ⊥` with `dim (S ⧸ p) = dim S`.
Writing `q` for the image of `p` in `S'`, the double-quotient dimension inequality shows
`dim (S' ⧸ q) ≥ dim (S ⧸ p) - 1 = n = dim S'`; as `S' ⧸ q` is a quotient of the domain `S'` of
dimension `n`, we get `dim (S' ⧸ q) = n = dim S'`, so `q = ⊥` (a nonzero ideal of a domain has
smaller quotient dimension).  Hence `p ≤ (x)`.  If `x ∈ p` then `p = (x)` and
`dim (S ⧸ p) = dim S' = n ≠ n + 1`, contradiction.  If `x ∉ p`, then primality and the iteration
lemma give `p ⊆ ⋂ₖ (x)^k ⊆ ⋂ₖ m^k = ⊥` (Krull intersection), so `p = ⊥`, contradiction.
-/

namespace Work.DSREG

open IsLocalRing

universe u

/-- **Main induction.** A Noetherian local ring whose maximal ideal can be generated by at most `n`
elements and whose Krull dimension is `n` is a domain. -/
theorem isDomain_of_spanFinrank_maximalIdeal_le_of_ringKrullDim_eq (n : ℕ) :
    ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S],
      (maximalIdeal S).spanFinrank ≤ n → ringKrullDim S = ((n : ℕ) : WithBot ℕ∞) → IsDomain S := by
  induction n with
  | zero =>
      intro S _ _ _ hspan _
      have hm : maximalIdeal S = ⊥ := by
        rw [← Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian (maximalIdeal S))]
        omega
      have hfield : IsField S := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm
      exact IsField.isDomain hfield
  | succ n ih =>
      intro S _ _ _ hspan hdim
      -- `m ≠ m²`, so pick `x ∈ m \ m²`
      have hdim_ne_zero : ringKrullDim S ≠ 0 := by
        rw [hdim]
        exact_mod_cast Nat.succ_ne_zero n
      have hsq : maximalIdeal S ^ 2 < maximalIdeal S :=
        IsLocalRing.maximalIdeal_sq_lt_of_ringKrullDim_ne_zero hdim_ne_zero
      obtain ⟨x, hxm, hxm2⟩ : ∃ x : S, x ∈ maximalIdeal S ∧ x ∉ maximalIdeal S ^ 2 := by
        by_contra h
        push Not at h
        exact absurd (le_antisymm (le_of_lt hsq) h) (ne_of_lt hsq)
      -- the quotient `S ⧸ (x)`
      have hnt : Nontrivial (S ⧸ Ideal.span {x}) := nontrivial_quotient_span_singleton hxm
      have hmax : maximalIdeal (S ⧸ Ideal.span {x})
          = (maximalIdeal S).map (Ideal.Quotient.mk (Ideal.span {x})) :=
        maximalIdeal_quotient_span_singleton S x
      -- its maximal ideal needs one fewer generator
      have hspan' : (maximalIdeal (S ⧸ Ideal.span {x})).spanFinrank ≤ n := by
        rw [hmax]
        exact SpanFinrankQuotient.spanFinrank_maximalIdeal_quotient_span_le S x hxm hxm2 n hspan
      -- and its Krull dimension is `n`
      have hdim_ge : ((n : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (S ⧸ Ideal.span {x}) :=
        natCast_le_of_succ_le_add_one (n := n) (by
          rw [← hdim]
          exact ringKrullDim_le_quotient_span_add_one S x hxm)
      have hdim_le : ringKrullDim (S ⧸ Ideal.span {x}) ≤ ((n : ℕ) : WithBot ℕ∞) := by
        refine le_trans (ringKrullDim_le_spanFinrank_maximalIdeal (R := S ⧸ Ideal.span {x})) ?_
        exact_mod_cast hspan'
      have hS' : ringKrullDim (S ⧸ Ideal.span {x}) = ((n : ℕ) : WithBot ℕ∞) :=
        le_antisymm hdim_le hdim_ge
      have hdom' : IsDomain (S ⧸ Ideal.span {x}) := ih _ hspan' hS'
      -- final step: `S` is a domain
      by_contra hSdom
      obtain ⟨p, hp, hpdim⟩ :=
        PrimeDimQuot.exists_isPrime_ringKrullDim_quotient_eq S (Nat.succ n) hdim
      have hp_prime : p.IsPrime := hp
      have hp_ne_bot : p ≠ ⊥ := by
        intro hbot
        have hbp : (⊥ : Ideal S).IsPrime := hbot ▸ hp_prime
        exact hSdom (IsDomain.of_bot_isPrime S)
      have hSp : ringKrullDim (S ⧸ p) = ((n + 1 : ℕ) : WithBot ℕ∞) := by
        rw [hpdim, hdim]
      -- `x ∉ p`
      have hx_notin_p : x ∉ p := by
        intro hxp
        have hle : Ideal.span {x} ≤ p := (Submodule.span_singleton_le_iff_mem x p).mpr hxp
        have h2 : ringKrullDim (S ⧸ p) ≤ ringKrullDim (S ⧸ Ideal.span {x}) :=
          ringKrullDim_le_of_surjective (Ideal.Quotient.factor hle)
            (Ideal.Quotient.factor_surjective hle)
        have h3 : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((n : ℕ) : WithBot ℕ∞) := by
          rw [← hSp, ← hS']
          exact h2
        have h3' : (((n : ℕ) : WithBot ℕ∞) + 1) ≤ ((n : ℕ) : WithBot ℕ∞) := by
          simpa using h3
        exact absurd (ENat.WithBot.add_one_le_natCast_iff.mp h3') (lt_irrefl _)
      -- the image `q` of `p` in `S ⧸ (x)` has full quotient dimension
      set q : Ideal (S ⧸ Ideal.span {x}) := p.map (Ideal.Quotient.mk (Ideal.span {x})) with hq
      have hdim_q : ringKrullDim ((S ⧸ Ideal.span {x}) ⧸ q) = ((n : ℕ) : WithBot ℕ∞) := by
        refine le_antisymm ?_ ?_
        · exact le_trans (ringKrullDim_quotient_le q) (le_of_eq hS')
        · rw [hq]
          have h1 := QuotQuotDim.ringKrullDim_quotient_le_quotQuot_add_one S p x hxm
          exact natCast_le_of_succ_le_add_one (n := n) (by rw [← hSp]; exact h1)
      -- a nonzero ideal of a domain has smaller quotient dimension, so `q = ⊥`
      have hq_bot : q = ⊥ :=
        DomainIdealBot.eq_bot_of_ringKrullDim_quotient_eq (S ⧸ Ideal.span {x}) q n hS' hdim_q
      have hp_le : p ≤ Ideal.span {x} := by
        have h := (Ideal.map_eq_bot_iff_le_ker (f := Ideal.Quotient.mk (Ideal.span {x}))).mp
          (by rw [← hq]; exact hq_bot)
        rwa [Ideal.mk_ker] at h
      -- hence `p = ⊥` by Krull's intersection theorem
      have hp_bot : p = ⊥ := by
        refine le_bot_iff.mp ?_
        calc p ≤ ⨅ k : ℕ, (Ideal.span {x}) ^ k :=
              IteratePow.le_iInf_pow_span_singleton_of_notMem hx_notin_p hp_le
          _ ≤ ⨅ k : ℕ, (maximalIdeal S) ^ k := by
              refine le_iInf fun k => le_trans (iInf_le _ k) ?_
              gcongr
              exact (Submodule.span_singleton_le_iff_mem x (maximalIdeal S)).mpr hxm
          _ = ⊥ := Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal S).ne_top
      exact hp_ne_bot hp_bot

/-- A regular local ring is a domain. -/
theorem isDomain_of_isRegularLocalRing (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    IsDomain R := by
  exact isDomain_of_spanFinrank_maximalIdeal_le_of_ringKrullDim_eq (maximalIdeal R).spanFinrank R
    le_rfl (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).symm

/-- A local ring that is regular (Localizations of `IsRegularRing` at the maximal ideal being
regular local) is a domain. -/
theorem isDomain_of_isRegularRing_of_isLocalRing (R : Type u) [CommRing R] [IsLocalRing R]
    [IsRegularRing R] : IsDomain R := by
  have hreg : IsRegularLocalRing R := IsRegularLocalRing.of_isRegularRing_of_isLocalRing R
  exact isDomain_of_isRegularLocalRing R

/-- Restatement of the defining property: for a regular local ring the dimension and the number of
generators of the maximal ideal agree. -/
theorem ringKrullDim_eq_spanFinrank_maximalIdeal_of_isRegularLocalRing (R : Type u) [CommRing R]
    [IsRegularLocalRing R] : ringKrullDim R = ((maximalIdeal R).spanFinrank : WithBot ℕ∞) :=
  (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).symm

end Work.DSREG

namespace DSMap

universe a

/-- **REG**: regular local rings are domains (same statement as the frozen `DSMap.area_REG`). -/
theorem area_REG_proved (R : Type a) [CommRing R] [IsRegularLocalRing R] : IsDomain R :=
  Work.DSREG.isDomain_of_isRegularLocalRing R

end DSMap
