import Mathlib
import Submission.Work.DSM4p.Chart
import Submission.Work.DSM4p.chartCokernel

/-!
# DSM4p — the characteristic-`p` cokernel estimate (`CokerP`, Route U)

This module proves `Work.DSM4p.cokerP`, the characteristic-`p` cokernel estimate of Bhatt,
*The direct summand conjecture and its derived variant*, arXiv:1608.08882, Theorem 3.1(2),
in the form used by the review of the `DSM4p` design (`direct_summand_m4p_design_REVIEW.md`,
Route U, node `CokerP`).

For a commutative ring `R` with two compatible systems `G`, `T` of `p`-power roots and the
chart levels `chartLevel hG T n ⊆ R[1/G 0]` generated by `x_k(n) = T k^n / G k`
(`Submission/Work/DSM4p/Chart.lean`), the statement is: for every `k, N` and every
`r ∈ chartLevel hG T (N + p^(k+1))` there are `b ∈ R` and `s ∈ chartLevel hG T N` with

  `G k · r = b + (T 0)^p · s`

in the ambient ring `R[1/G 0]`.  The constant `p^(k+1)` is the characteristic-`p`
counterpart of the uniform constant `retC p k m = p^(k+1)·m` of the cokernel clause of
`IsQRETp`: at `m = 1` the congruence of `Work.DSM4p.ChartCokernel` becomes an exact identity
because `p = 0`.

## The proof

Everything is a computation on the generators `x_k(n) = T k^n / G k`.

* `Work.DSM4p.chartGen_eq_root_pow` / `Work.DSM4p.prod_chartGen_pow_eq` collapse an arbitrary
  monomial `∏_j x_j(n)^{μ_j}` to a single generator power `x_J(n)^I` with `J = max (supp μ)`
  and `I = ∑_j μ_j · p^{J-j}` (the iterated root relation `x_j = x_{j+1}^p`);
* `Work.DSM4p.cokerP_mono` is the *two-case monomial computation*: with `c := p^(k+1)`, the
  element `G k · x_J(N+c)^I` is, up to an error in `R`, equal to `(T 0)^p · (something in
  level N)` or lies in `R`:
  - if `I·p^k < p^J` ("Bhatt's second case"), then necessarily `k < J` and
    `G k · x_J(N+c)^I = G J^{p^{J-k}-I} · T J^{(N+c)I} ∈ R` (the fractional power
    `G 0^{1/p^k - I/p^J} = G J^{p^{J-k}-I}` is a genuine power);
  - if `I·p^k ≥ p^J` ("Bhatt's first case"), then `(N+c)I/p^J ≥ p`, so writing
    `m := cI - p^{J+1}` one has `T J^{cI} = (T 0)^p · T J^m` and hence
    `G k · x_J(N+c)^I = (T 0)^p · (G k · T J^m · x_J(N)^I)`, with the second factor in
    `chartLevel N` because `x_J(N)^I` is a power of a generator and `G k · T J^m ∈ R`.
* summing the finitely many per-monomial decompositions over the polynomial expansion of `r`
  (`Work.DSM4p.chartLevel_mem_aeval_range`) yields the claim.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open CategoryTheory AlgebraicGeometry IsLocalRing Limits

namespace Work.DSM4p

universe a

open DSMap DSMap.Mix DSMap.Mix2

section Monomial

variable {p : ℕ} [Fact p.Prime] {R : Type a} [CommRing R]

/-- The **two-case monomial computation** of the characteristic-`p` cokernel estimate
(Bhatt, arXiv:1608.08882, proof of Theorem 3.1(2)).  For arbitrary indices `J`, `I` and a
coefficient `b0 : R`, the element `G k · b0 · x_J(N + p^(k+1))^I` decomposes as
`b + (T 0)^p · s` with `b ∈ R` and `s ∈ chartLevel hG T N`.

The two cases are `I·p^k < p^J` (the fractional power of `G 0` is a genuine power, so the
element is in `R`) and `I·p^k ≥ p^J` (the `T`-exponent `(N + p^(k+1))·I/p^J` is at least `p`,
so a factor `(T 0)^p = T J^{p^{J+1}}` can be taken out). -/
theorem cokerP_mono {G T : ℕ → R} (hG : IsRootSystem p G) (hT : IsRootSystem p T)
    (k N J I : ℕ) (b0 : R) :
    ∃ b : R, ∃ s ∈ chartLevel hG T N,
      algebraMap R (ChartAmbient G) (G k) *
          (algebraMap R (ChartAmbient G) b0 * (chartGen hG T (N + p ^ (k + 1)) J) ^ I) =
        algebraMap R (ChartAmbient G) b +
          algebraMap R (ChartAmbient G) (T 0 ^ p) * s := by
  rcases Nat.eq_zero_or_pos I with hI0 | hIpos
  · subst hI0
    refine ⟨b0 * G k, 0, Subalgebra.zero_mem _, ?_⟩
    simp [mul_comm]
  · by_cases hcase : I * p ^ k < p ^ J
    · -- ## Bhatt's second case : `I·p^k < p^J`, the element is in `R`
      have hkJ : k ≤ J := by
        by_contra h
        have h1 : p ^ J < p ^ k := Nat.pow_lt_pow_right (Fact.out : p.Prime).one_lt (not_le.mp h)
        have h2 : p ^ k ≤ I * p ^ k := by
          calc p ^ k = 1 * p ^ k := (one_mul _).symm
            _ ≤ I * p ^ k := Nat.mul_le_mul_right _ hIpos
        exact absurd hcase (not_lt.mpr (le_trans h1.le h2))
      have hIle : I ≤ p ^ (J - k) := by
        have h3 : p ^ J = p ^ (J - k) * p ^ k := by
          rw [← pow_add, Nat.sub_add_cancel hkJ]
        rw [h3] at hcase
        exact le_of_lt (lt_of_mul_lt_mul_right hcase (Nat.zero_le _))
      have hunit : chartUnit hG k * (chartUnit hG J ^ I)⁻¹ =
          chartUnit hG J ^ (p ^ (J - k) - I) := by
        rw [← mul_right_cancel_iff (a := chartUnit hG J ^ I)]
        rw [mul_assoc, inv_mul_cancel, mul_one,
          mul_comm (chartUnit hG J ^ (p ^ (J - k) - I)) (chartUnit hG J ^ I),
          ← pow_add, Nat.add_sub_cancel' hIle]
        exact (chartUnit_pow_pow hG hkJ).symm
      have hkey : algebraMap R (ChartAmbient G) (G k) * ↑((chartUnit hG J ^ I)⁻¹) =
          algebraMap R (ChartAmbient G) (G J ^ (p ^ (J - k) - I)) := by
        rw [← chartUnit_val hG k, ← Units.val_mul, hunit, Units.val_pow_eq_pow_val,
          chartUnit_val, ← map_pow]
      refine ⟨b0 * G J ^ (p ^ (J - k) - I) * T J ^ ((N + p ^ (k + 1)) * I), 0,
        Subalgebra.zero_mem _, ?_⟩
      rw [mul_zero, add_zero]
      have hL : algebraMap R (ChartAmbient G) (G k) *
            (algebraMap R (ChartAmbient G) b0 * (chartGen hG T (N + p ^ (k + 1)) J) ^ I)
          = algebraMap R (ChartAmbient G) b0 *
              algebraMap R (ChartAmbient G) (T J ^ ((N + p ^ (k + 1)) * I)) *
              (algebraMap R (ChartAmbient G) (G k) * ↑((chartUnit hG J ^ I)⁻¹)) := by
        rw [chartGen_pow_eq hG T (N + p ^ (k + 1)) J I]
        ring
      rw [hL, hkey, ← map_mul, ← map_mul]
      congr 1
      ring
    · -- ## Bhatt's first case : `I·p^k ≥ p^J`, the element is `(T 0)^p` times level `N`
      have hge : p ^ J ≤ I * p ^ k := le_of_not_gt hcase
      have hle : p ^ (J + 1) ≤ p ^ (k + 1) * I := by
        calc p ^ (J + 1) = p * p ^ J := by rw [pow_succ']
          _ ≤ p * (I * p ^ k) := Nat.mul_le_mul_left p hge
          _ = I * (p * p ^ k) := by ring
          _ = I * p ^ (k + 1) := by rw [← pow_succ']
          _ = p ^ (k + 1) * I := by ring
      set m : ℕ := p ^ (k + 1) * I - p ^ (J + 1) with hmdef
      have hT0 : T J ^ p ^ J = T 0 := rootSystem_pow_pow hT (Nat.zero_le J)
      have hT0p : T J ^ p ^ (J + 1) = T 0 ^ p := by
        rw [show p ^ (J + 1) = p ^ J * p from (pow_succ p J).symm, pow_mul, hT0]
      have hm_eq : m + p ^ (J + 1) = p ^ (k + 1) * I := by
        rw [hmdef, Nat.sub_add_cancel hle]
      have htJ : T J ^ (p ^ (k + 1) * I) = T 0 ^ p * T J ^ m := by
        rw [← hm_eq, pow_add, hT0p, mul_comm]
      refine ⟨0, algebraMap R (ChartAmbient G) (b0 * G k * T J ^ m) * (chartGen hG T N J) ^ I,
        Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
          (Subalgebra.pow_mem _ (chartGen_mem hG T N J) I), ?_⟩
      rw [map_zero, zero_add]
      rw [chartGen_pow_add_level hG T N (p ^ (k + 1)) J I]
      rw [show algebraMap R (ChartAmbient G) (G k) * (algebraMap R (ChartAmbient G) b0 *
              (algebraMap R (ChartAmbient G) (T J ^ ((p ^ (k + 1)) * I)) *
                (chartGen hG T N J) ^ I))
            = (algebraMap R (ChartAmbient G) (G k) * algebraMap R (ChartAmbient G) b0 *
                algebraMap R (ChartAmbient G) (T J ^ ((p ^ (k + 1)) * I))) *
                (chartGen hG T N J) ^ I
            from by ring,
          show algebraMap R (ChartAmbient G) (T 0 ^ p) *
              (algebraMap R (ChartAmbient G) (b0 * G k * T J ^ m) * (chartGen hG T N J) ^ I)
            = (algebraMap R (ChartAmbient G) (T 0 ^ p) *
                algebraMap R (ChartAmbient G) (b0 * G k * T J ^ m)) *
                (chartGen hG T N J) ^ I
            from by ring]
      congr 1
      rw [← map_mul, ← map_mul, ← map_mul, htJ]
      congr 1
      ring

end Monomial

/-- The characteristic-`p` cokernel estimate: every element of the `(N + p^(k+1))`-st chart
level is, after multiplication by `G k`, a base element plus `(T 0)^p` times an element of the
`N`-th level.  This is Bhatt's Theorem 3.1(2) at `m = 1` in characteristic `p`, where the
congruence modulo `p` of `Work.DSM4p.ChartCokernel` degenerates to an identity. -/
theorem cokerP {p : ℕ} [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p] [PerfectRing R p]
    {G T : ℕ → R} (hG : Work.DSM4p.IsRootSystem p G) (hT : Work.DSM4p.IsRootSystem p T)
    (k N : ℕ) (r : Work.DSM4p.chartRing hG T (N + p ^ (k + 1))) :
    ∃ b : R, ∃ s ∈ Work.DSM4p.chartLevel hG T N,
      algebraMap R (Work.DSM4p.ChartAmbient G) (G k) * (r : Work.DSM4p.ChartAmbient G) =
        algebraMap R (Work.DSM4p.ChartAmbient G) b +
          algebraMap R (Work.DSM4p.ChartAmbient G) (T 0 ^ p) * s := by
  obtain ⟨P, hP⟩ := chartLevel_mem_aeval_range hG T (N + p ^ (k + 1)) r
  choose bb ss hss hdec using fun μ : ℕ →₀ ℕ =>
    cokerP_mono hG hT k N (μ.support.sup id)
      (∑ j ∈ μ.support, μ j * p ^ (μ.support.sup id - j)) (P.coeff μ)
  refine ⟨∑ μ ∈ P.support, bb μ, ∑ μ ∈ P.support, ss μ,
    Subalgebra.sum_mem _ (fun μ _ => hss μ), ?_⟩
  have hexp : (r : ChartAmbient G) =
      ∑ μ ∈ P.support, algebraMap R (ChartAmbient G) (P.coeff μ) *
        ∏ j ∈ μ.support, (chartGen hG T (N + p ^ (k + 1)) j) ^ (μ j) := by
    conv_lhs => rw [← hP, MvPolynomial.as_sum P]
    rw [map_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [MvPolynomial.aeval_monomial]
    rfl
  calc algebraMap R (ChartAmbient G) (G k) * (r : ChartAmbient G)
      = algebraMap R (ChartAmbient G) (G k) * ∑ μ ∈ P.support,
          (algebraMap R (ChartAmbient G) (P.coeff μ) *
            ∏ j ∈ μ.support, (chartGen hG T (N + p ^ (k + 1)) j) ^ (μ j)) := by
        rw [hexp]
    _ = ∑ μ ∈ P.support, algebraMap R (ChartAmbient G) (G k) *
          (algebraMap R (ChartAmbient G) (P.coeff μ) *
            ∏ j ∈ μ.support, (chartGen hG T (N + p ^ (k + 1)) j) ^ (μ j)) := by
        rw [Finset.mul_sum]
    _ = ∑ μ ∈ P.support, (algebraMap R (ChartAmbient G) (bb μ) +
          algebraMap R (ChartAmbient G) (T 0 ^ p) * ss μ) := by
        refine Finset.sum_congr rfl fun μ _ => ?_
        rw [prod_chartGen_pow_eq G hG T hT (N + p ^ (k + 1)) μ (μ.support.sup id)
              (fun j hj => Finset.le_sup (f := id) hj),
            hdec μ]
    _ = algebraMap R (ChartAmbient G) (∑ μ ∈ P.support, bb μ) +
          algebraMap R (ChartAmbient G) (T 0 ^ p) * (∑ μ ∈ P.support, ss μ) := by
        rw [map_sum, Finset.mul_sum, Finset.sum_add_distrib]

end Work.DSM4p
