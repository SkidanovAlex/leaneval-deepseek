import Mathlib

namespace Work.DSM4p

/-- The Teichmüller map on a perfect ring `R` of characteristic `p` is additive modulo `p`:
for any finite family `x : ι → R`, the difference `[Σ xᵢ] - Σ [xᵢ]` lies in the ideal
`(p) ⊆ 𝕎 R` generated by the prime `p`.

Since `R` is perfect of characteristic `p`, the ideal `(p)` is exactly the kernel of the
zeroth-coefficient (constant coefficient) map `constantCoeff : 𝕎 R →+* R`, and
`constantCoeff [r] = r`. Applying `constantCoeff` therefore sends the difference to
`Σ xᵢ - Σ xᵢ = 0`. -/
theorem teichmuller_sum_sub_mem_span_p {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R]
    [CharP R p] [PerfectRing R p] {ι : Type*} (s : Finset ι) (x : ι → R) :
    WittVector.teichmuller p (∑ i ∈ s, x i) - ∑ i ∈ s, WittVector.teichmuller p (x i) ∈
      Ideal.span {(p : WittVector p R)} := by
  rw [← WittVector.ker_constantCoeff, RingHom.mem_ker]
  have hcc : ∀ r : R, WittVector.constantCoeff (WittVector.teichmuller p r) = r := fun r => by
    rw [WittVector.constantCoeff_apply, WittVector.teichmuller_coeff_zero]
  simp only [map_sub, map_sum, hcc]
  abel

end Work.DSM4p
