import Mathlib
import Submission.Work.DSM4p.chartComp_modPow

/-!
# DSM4p — Frobenius surjectivity modulo `p` survives `p`-adic completion

If the Frobenius map `x ↦ x ^ p` is surjective on `E ⧸ (p)` (equivalently: for every `x : E`
there is `y : E` with `x - y ^ p ∈ (p)`), then it is surjective on
`AdicCompletion (p) E ⧸ (p)` as well.

The proof is the standard one: `AdicCompletion.evalOneₐ : Â → E ⧸ (p)` is surjective with
kernel `(p) · Â` (the ideal generated by `p` in the completion), so a Frobenius preimage mod `p`
in `E` lifts to a Frobenius preimage mod `p` in `Â`.
-/

namespace Work.DSM4p

universe a

theorem adicCompletion_frobSurj {E : Type a} [CommRing E] (p : ℕ)
    (hsurj : ∀ x : E, ∃ y, x - y ^ p ∈ Ideal.span {(p : E)}) :
    ∀ x : AdicCompletion (Ideal.span {(p : E)}) E,
      ∃ y, x - y ^ p ∈ Ideal.span {(p : AdicCompletion (Ideal.span {(p : E)}) E)} := by
  classical
  set I : Ideal E := Ideal.span {(p : E)} with hI
  have hker : RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom
      = Ideal.span {(p : AdicCompletion I E)} := by
    rw [AdicCompletion.ker_evalOneₐ_eq_map I (Submodule.fg_span_singleton (p : E)),
      Ideal.map_span, Set.image_singleton, map_natCast]
  have hcoe : ∀ b : E, (AdicCompletion.evalOneₐ I).toRingHom (algebraMap E (AdicCompletion I E) b)
      = Ideal.Quotient.mk I b := by
    intro b
    show AdicCompletion.evalOneₐ I (algebraMap E (AdicCompletion I E) b) = Ideal.Quotient.mk I b
    rw [AdicCompletion.algebraMap_apply]
    show AdicCompletion.evalOneₐ I (AdicCompletion.of I E (algebraMap E E b)) = Ideal.Quotient.mk I b
    rw [AdicCompletion.evalOneₐ_of]
    exact congrArg (Ideal.Quotient.mk I) (Algebra.algebraMap_self_apply b)
  intro x
  obtain ⟨a, ha⟩ : ∃ a : E, (AdicCompletion.evalOneₐ I).toRingHom x = Ideal.Quotient.mk I a := by
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (I := I) (AdicCompletion.evalOneₐ I x)
    exact ⟨a, ha.symm⟩
  obtain ⟨w, hw⟩ := hsurj a
  refine ⟨algebraMap E (AdicCompletion I E) w, ?_⟩
  have hwq : Ideal.Quotient.mk I a = (Ideal.Quotient.mk I w) ^ p := by
    rw [← map_pow, Ideal.Quotient.eq]
    exact hw
  have hzero : (AdicCompletion.evalOneₐ I).toRingHom
      (x - (algebraMap E (AdicCompletion I E) w) ^ p) = 0 := by
    rw [map_sub, map_pow, hcoe w, ha, hwq, sub_self]
  rw [← hker, RingHom.mem_ker]
  exact hzero

end Work.DSM4p
