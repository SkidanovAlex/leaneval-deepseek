import Mathlib
import Submission.Work.DSM4p.Plan
import Submission.Work.DSM4p.Lvl
import Submission.Work.DSM4p.lvlP_charP
import Submission.Work.DSM5c.ChartComparison

/-!
# DSM4p — the Teichmüller dictionary at the level `lvl Q hgr N`

This is step **(2)** of the Route U plan (`Submission/Work/DSM4p/Plan.lean`), the statement
`Work.DSM4p.lvl_teich_mem_span_p`:

for `B` a commutative ring, `p` prime with `[Fact ¬IsUnit (p : B)]` and
`[IsAdicComplete (Ideal.span {(p : B)}) B]`, `Q : DSMap.PerfectoidData p B`, `hgr : IsRootSystem p gr`
with `gr 0 ≠ 0`, and `N : ℕ`, one has for every `r : lvlP Q hgr N`

  `untiltOf.mk φ ([r]) ∈ (p : lvl Q hgr N)  ↔  r ∈ (φ (ϖ♭))^p`

where `φ := algebraMap B♭ (lvlP Q hgr N)`, `B♭ := PreTilt B p`, `ϖ♭ := DSM5c.tiltVarpi Q`
(the `0`-th entry of the tilted `ϖ`-system: `tiltTower_zero`) and `[r]` is the Teichmüller lift.

## The proof

`lvl Q hgr N = untiltOf (lvlP Q hgr N) φ = 𝕎R ⧸ J`, where `R := lvlP Q hgr N`,
`φ : B♭ →+* R` and `J := 𝕎R · 𝕎(φ)(ker θ_B)` is the ideal generated by the image of the base's
theta-kernel.  Since `untiltOf.mk φ` is the quotient map and `(p : ⧸J) = mk (p : 𝕎R)`
(`map_natCast`), the general membership criterion for a surjection

  `f x ∈ (f a) ↔ x ∈ (a) ⊔ ker f`  (`Work.DSM4p.mem_span_singleton_of_surjective`)

together with `RingHom.ker (Ideal.Quotient.mk J) = J` (`Ideal.mk_ker`) turns the left-hand side
into `𝕎[r] ∈ (p : 𝕎R) ⊔ J`.  The chart-level description of the theta-kernel modulo `p`
(`Work.DSM5c.mem_span_p_sup_map_ker_fontaineTheta`, valid because `R` is perfect of
characteristic `p`: `chartLevel_perfect` and `lvlP_charP`) identifies this with
`constantCoeff 𝕎[r] ∈ (φ (ϖ♭))^p`, and `constantCoeff 𝕎[r] = r`
(`WittVector.constantCoeff_apply`, `WittVector.teichmuller_coeff_zero`). -/

set_option linter.style.haveILetI false

namespace Work.DSM4p

universe a

/-- **Membership criterion for a principal ideal along a surjection**: for a surjective ring
homomorphism `f : R →+* S` and `a x : R`, the class `f x` lies in the principal ideal generated by
`f a` exactly when `x` lies in the ideal `(a) ⊔ ker f` generated by `a` and the kernel of `f`.

(`(f a)` is `f '' (a)` spanned, i.e. `Ideal.map f (Ideal.span {a})`; pulling back along the
surjection `f` computes `(map f (span {a})).comap f = span {a} ⊔ ker f`.) -/
lemma mem_span_singleton_of_surjective {R S : Type*} [Ring R] [Ring S] (f : R →+* S)
    (hf : Function.Surjective f) (a x : R) :
    f x ∈ Ideal.span {f a} ↔ x ∈ Ideal.span {a} ⊔ RingHom.ker f := by
  have hm : Ideal.span {f a} = Ideal.map f (Ideal.span {a}) := by
    rw [Ideal.map_span]; simp
  rw [hm, ← Ideal.mem_comap, Ideal.comap_map_of_surjective f hf, RingHom.ker_eq_comap_bot]

theorem lvl_teich_mem_span_p {p : ℕ} [Fact p.Prime] {B : Type a} [CommRing B]
    [Fact (¬ IsUnit (p : B))] [IsAdicComplete (Ideal.span {(p : B)}) B]
    (Q : DSMap.PerfectoidData p B) {gr : ℕ → B} (hgr : Work.DSM4p.IsRootSystem p gr)
    (hgr0 : gr 0 ≠ 0) (N : ℕ) (r : Work.DSM4p.lvlP Q hgr N) :
    (Work.DSM5c.untiltOf.mk (p := p) (W := B) (algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N))
        (WittVector.teichmuller p r) ∈ Ideal.span {((p : Work.DSM4p.lvl Q hgr N))}) ↔
      r ∈ Ideal.span {((algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N)
        (Work.DSM5c.tiltVarpi Q)) ^ p)} := by
  -- `θ_B` is onto (integral perfectoidness of `B`, `Q : PerfectoidData p B`).
  have hθ : Function.Surjective (WittVector.fontaineTheta (p := p) (R := B)) :=
    Work.DSM4p.surjective_fontaineTheta Q
  -- The characteristic-`p` chart level `R := lvlP Q hgr N` is perfect of characteristic `p`
  -- (the two hypotheses of the chart-level theta-kernel description).
  haveI hchar : CharP (Work.DSM4p.lvlP Q hgr N) p := Work.DSM4p.lvlP_charP Q hgr hgr0 N
  haveI hperf : PerfectRing (Work.DSM4p.lvlP Q hgr N) p :=
    Work.DSM4p.chartLevel_perfect (Work.DSM4p.tiltTower_isRootSystem gr hgr)
      (Work.DSM4p.tiltTower_isRootSystem Q.ϖ Q.root) N
  -- `untiltOf.mk φ : 𝕎R ↠ untiltOf R φ` is the quotient map, hence onto.
  have hsurj : Function.Surjective (Work.DSM5c.untiltOf.mk (p := p) (W := B)
      (algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N))) := Ideal.Quotient.mk_surjective
  -- its kernel is the ideal `J` defining the untilt.
  have hker : RingHom.ker (Work.DSM5c.untiltOf.mk (p := p) (W := B)
      (algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N)))
      = Ideal.span ((WittVector.map (algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N))) ''
        ((RingHom.ker (WittVector.fontaineTheta (p := p) (R := B)) :
          Set (WittVector p (PreTilt B p))))) :=
    Ideal.mk_ker
  -- `p` in the untilt is the class of `p` in `𝕎R`.
  have hp : (p : Work.DSM4p.lvl Q hgr N) = Work.DSM5c.untiltOf.mk (p := p) (W := B)
      (algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N))
      (p : WittVector p (Work.DSM4p.lvlP Q hgr N)) := (map_natCast _ p).symm
  -- Rewrite the left-hand side as a membership in `(p : 𝕎R) ⊔ J`, then apply the chart-level
  -- theta-kernel description at `x := 𝕎[r]` and read off its constant coefficient.
  rw [hp, mem_span_singleton_of_surjective _ hsurj, hker,
    Work.DSM5c.mem_span_p_sup_map_ker_fontaineTheta Q hθ
      (algebraMap (PreTilt B p) (Work.DSM4p.lvlP Q hgr N)) (WittVector.teichmuller p r),
    WittVector.constantCoeff_apply, WittVector.teichmuller_coeff_zero]

end Work.DSM4p
