import Submission.Work.DSMap.Mix2
import Submission.Work.DSM4p.Basic

/-!
# DSM4p — the chart model of the Riemann extension levels

This module sets up the *levels* of the Riemann extension tower of the node
`DSMap.Mix2.area_M4p` (Bhatt, arXiv:1608.08882, §3) as concrete, computable objects: the
`B`-subalgebra

  `chartLevel hgr ϖ n := B[ϖ_k^n / g_k : k ∈ ℕ] ⊆ B[1/g]`,  `g = gr 0`,

of the localisation `B[1/g]` at `g = gr 0`, where `gr : ℕ → B` is a compatible system of
`p`-power roots (so `gr k = g^{1/p^k}` is invertible in `B[1/g]`) and `ϖ : ℕ → B` is a
compatible system of the pseudo-uniformiser.

This is Bhatt's presentation ring `A[u_n^{1/p^∞}] / (u_n g)^{1/p^k} = ϖ_k^n` — with the
division by `g_k` carried out *for real* inside `B[1/g]` rather than imposed as a relation.
Working in `B[1/g]` has the advantage that the elements are honest elements of a ring and all
the arithmetic of *fractional powers* (`g^{1/p^k - e}`, `ϖ_0^{(n+c)e}`) is available, which is
exactly what Bhatt's two-case computation in the proof of Theorem 3.1 uses; a *quotient* of
the polynomial ring by the relations `x_k g_k = ϖ_k^n` is not p-torsion-free in general (for
`gr k = ϖ_k`, `n = 1`, the relation gives `ϖ_0 (x_0 - 1) = 0`, hence `p (x_0 - 1) = 0`),
so the model has to be the localisation, not the quotient.

## Contents

* `Work.DSM4p.ChartAmbient`, `chartUnit`, `chartGen`, `chartLevel` — the vocabulary;
* `chartGen_mem`, `chartGen_mul_gr` — membership and the defining relation `x_k g_k = ϖ_k^n`;
* `chartGen_level_succ` — the transition identity `x_k(n+1) = ϖ_k · x_k(n)`, whence
  `chartLevel (n+1) ≤ chartLevel n`: the tower `D n := chartLevel n` maps down as
  `tr n := Subalgebra.inclusion` (this is `Work.DSM4p.chartTower`);
* `chartGen_succ_pow` — the root relation `x_k(n) = x_{k+1}(n)^p`.

The quantitative content (the divisibility `g ∣ p^n` and Bhatt's kernel/cokernel estimates)
is in `Submission/Work/DSM4p/chartMono_estimate.lean`, `chartTower_cokernel.lean` and
`chartCokernel.lean`.
-/

set_option linter.style.haveILetI false

open CategoryTheory AlgebraicGeometry IsLocalRing Limits

namespace Work.DSM4p

universe a

open DSMap DSMap.Mix DSMap.Mix2

section Chart

variable {p : ℕ} [Fact p.Prime] {B : Type a} [CommRing B]

/-- The ambient ring `B[1/g]` of the chart model, where `g = gr 0`. -/
abbrev ChartAmbient (gr : ℕ → B) : Type a := Localization.Away (gr 0)

/-- `gr k = g^{1/p^k}` is a unit of `B[1/g]`, since its `p^k`-th power is `g`. -/
theorem isUnit_algebraMap_gr {gr : ℕ → B} (hgr : IsRootSystem p gr) (k : ℕ) :
    IsUnit (algebraMap B (ChartAmbient gr) (gr k)) := by
  refine (isUnit_pow_iff (pow_ne_zero k (Fact.out : p.Prime).ne_zero)).mp ?_
  have h : (algebraMap B (ChartAmbient gr) (gr k)) ^ (p ^ k) =
      algebraMap B (ChartAmbient gr) (gr 0) := by
    rw [← map_pow, hgr.pow_pow_zero k]
  rw [h]
  exact IsLocalization.Away.algebraMap_isUnit (gr 0)

/-- `gr k` as a unit of `B[1/g]`. -/
noncomputable def chartUnit {gr : ℕ → B} (hgr : IsRootSystem p gr) (k : ℕ) :
    (ChartAmbient gr)ˣ :=
  (isUnit_algebraMap_gr hgr k).unit

@[simp] theorem chartUnit_val {gr : ℕ → B} (hgr : IsRootSystem p gr) (k : ℕ) :
    ((chartUnit hgr k : (ChartAmbient gr)ˣ) : ChartAmbient gr) =
      algebraMap B (ChartAmbient gr) (gr k) :=
  IsUnit.unit_spec _

/-- The chart generator `x_k = ϖ_k^n / g_k ∈ B[1/g]`. -/
noncomputable def chartGen {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n k : ℕ) :
    ChartAmbient gr :=
  ((chartUnit hgr k)⁻¹ : (ChartAmbient gr)ˣ) * algebraMap B (ChartAmbient gr) (ϖ k ^ n)

/-- The `n`-th chart level: the `B`-subalgebra of `B[1/g]` generated by the `x_k`. -/
noncomputable def chartLevel {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n : ℕ) :
    Subalgebra B (ChartAmbient gr) :=
  Algebra.adjoin B (Set.range (chartGen hgr ϖ n))

/-- Each generator lies in the level it generates. -/
theorem chartGen_mem {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n k : ℕ) :
    chartGen hgr ϖ n k ∈ chartLevel hgr ϖ n :=
  Algebra.subset_adjoin (Set.mem_range_self k)

/-- The defining relation of the chart generators, with the unit on the left. -/
theorem chartUnit_mul_chartGen {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n k : ℕ) :
    (chartUnit hgr k : ChartAmbient gr) * chartGen hgr ϖ n k =
      algebraMap B (ChartAmbient gr) (ϖ k ^ n) := by
  rw [chartGen]
  rw [← mul_assoc, Units.mul_inv, one_mul]

/-- The defining relation of the chart generators, in the form `g_k · x_k = ϖ_k^n`. -/
theorem chartGen_mul_gr {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n k : ℕ) :
    algebraMap B (ChartAmbient gr) (gr k) * chartGen hgr ϖ n k =
      algebraMap B (ChartAmbient gr) (ϖ k ^ n) := by
  rw [← chartUnit_val hgr k, chartUnit_mul_chartGen hgr ϖ n k]

/-- The defining relation of the chart generators, in the form `x_k · g_k = ϖ_k^n`. -/
theorem chartGen_mul_gr' {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n k : ℕ) :
    chartGen hgr ϖ n k * algebraMap B (ChartAmbient gr) (gr k) =
      algebraMap B (ChartAmbient gr) (ϖ k ^ n) := by
  rw [mul_comm, chartGen_mul_gr hgr ϖ n k]

/-- The transition identity: `x_k (n+1) = ϖ_k · x_k n`. -/
theorem chartGen_level_succ {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n k : ℕ) :
    chartGen hgr ϖ (n + 1) k = algebraMap B (ChartAmbient gr) (ϖ k) * chartGen hgr ϖ n k := by
  rw [chartGen, chartGen, pow_succ, map_mul]
  ring

/-- The levels are decreasing (as subalgebras): level `n+1` is contained in level `n`.  This
is the tower structure `D (n+1) → D n`. -/
theorem chartLevel_antitone {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n : ℕ) :
    chartLevel hgr ϖ (n + 1) ≤ chartLevel hgr ϖ n := by
  rw [chartLevel, chartLevel, Algebra.adjoin_le_iff]
  rintro _ ⟨k, rfl⟩
  rw [chartGen_level_succ hgr ϖ n k]
  exact mul_mem (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin (Set.mem_range_self k))

/-- The root relation: `x_k (n) = x_{k+1}(n) ^ p`. -/
theorem chartGen_succ_pow {gr ϖ : ℕ → B} (hgr : IsRootSystem p gr) (hϖ : IsRootSystem p ϖ)
    (n k : ℕ) : chartGen hgr ϖ n k = chartGen hgr ϖ n (k + 1) ^ p := by
  have hu : (chartUnit hgr k : ChartAmbient gr) =
      ((chartUnit hgr (k + 1) : (ChartAmbient gr)ˣ) : ChartAmbient gr) ^ p := by
    rw [chartUnit_val, chartUnit_val, ← map_pow, hgr k]
  have key : (chartGen hgr ϖ n (k + 1) * (chartUnit hgr (k + 1) : ChartAmbient gr)) ^ p =
      algebraMap B (ChartAmbient gr) (ϖ k ^ n) := by
    rw [chartUnit_val, chartGen_mul_gr' hgr ϖ n (k + 1), ← map_pow]
    congr 1
    rw [← hϖ k, ← pow_mul, ← pow_mul, Nat.mul_comm]
  have hmain : chartGen hgr ϖ n (k + 1) ^ p * (chartUnit hgr k : ChartAmbient gr) =
      chartGen hgr ϖ n k * (chartUnit hgr k : ChartAmbient gr) := by
    rw [hu, ← mul_pow, key, ← hu]
    simp only [chartUnit_val]
    exact (chartGen_mul_gr' hgr ϖ n k).symm
  have h' := congrArg (fun z : ChartAmbient gr =>
      z * ((chartUnit hgr k)⁻¹ : (ChartAmbient gr)ˣ)) hmain
  simpa only [mul_assoc, Units.mul_inv, mul_one] using h'.symm


/-- Every element of the `n`-th chart level is the value of a polynomial in the generators
`x_k` (`MvPolynomial.aeval`).  This is the bridge used to pass from the monomial estimates to
arbitrary elements of the level. -/
theorem chartLevel_mem_aeval_range {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n : ℕ)
    (y : chartLevel hgr ϖ n) :
    ∃ P : MvPolynomial ℕ B, MvPolynomial.aeval (chartGen hgr ϖ n) P = (y : ChartAmbient gr) :=
  Algebra.exists_mvPolynomial_aeval_eq_of_mem_adjoin
    (S := Set.range (chartGen hgr ϖ n)) (f := chartGen hgr ϖ n)
    (by rintro _ ⟨k, rfl⟩; exact ⟨k, rfl⟩) y.2

/-- The `c`-fold transition on the generators: `x_k (n+c) = ϖ_k^c · x_k (n)`, the `c`-fold
composite of `chartGen_level_succ`. -/
theorem chartGen_add_level {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n c k : ℕ) :
    chartGen hgr ϖ (n + c) k = algebraMap B (ChartAmbient gr) (ϖ k ^ c) * chartGen hgr ϖ n k := by
  induction c with
  | zero => simp
  | succ c ih =>
    rw [Nat.add_succ, chartGen_level_succ, ih, ← mul_assoc, ← map_mul, mul_comm (ϖ k),
      ← pow_succ]

/-- Powers of the `c`-fold transition: `x_k (n+c)^I = ϖ_k^{cI} · x_k(n)^I`. -/
theorem chartGen_pow_add_level {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B)
    (n c k I : ℕ) :
    chartGen hgr ϖ (n + c) k ^ I =
      algebraMap B (ChartAmbient gr) (ϖ k ^ (c * I)) * chartGen hgr ϖ n k ^ I := by
  rw [chartGen_add_level hgr ϖ n c k, mul_pow, ← map_pow, ← pow_mul]

/-- The `n`-th chart level, as a ring: the type of the level of the Riemann extension tower. -/
abbrev chartRing {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n : ℕ) : Type a :=
  chartLevel hgr ϖ n

/-- The transition map `D (n+1) → D n` of the chart tower: the inclusion of the levels,
which realises `x_k (n+1) = ϖ_k · x_k (n)` on the generators. -/
noncomputable def chartTr {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B) (n : ℕ) :
    chartRing hgr ϖ (n + 1) →ₐ[B] chartRing hgr ϖ n :=
  Subalgebra.inclusion (chartLevel_antitone hgr ϖ n)

end Chart

end Work.DSM4p
