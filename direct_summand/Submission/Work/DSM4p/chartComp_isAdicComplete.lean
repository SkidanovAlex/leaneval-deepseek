import Mathlib
import Submission.Work.DSM4p.Completion

/-!
# DSM4p — `p`-adic completeness of the completed chart levels

This module proves item 1 of the list in `Submission/Work/DSM4p/Completion.lean`: every
completed chart level `chartComp hgr Q n` — the `p`-adic completion
`AdicCompletion (span {p}) (chartRing hgr Q.ϖ n)` of Bhatt's chart level
`B[u_n^{1/p^∞}]` — is complete for the adic topology defined by the principal ideal
generated by `p`.

The mathematical content is exactly Mathlib's `AdicCompletion.isAdicComplete`: a completion
of a module at a finitely generated ideal is adically complete, and `span {p}` is generated
by one element. The only bookkeeping needed is the identification
`span {p} = (span {p}).map (algebraMap _ _)` in the completion, i.e. that the structural
map sends the ideal we completed at to the ideal generated by the image of `p`; this is
`map_natCast` together with `Ideal.map_span`.
-/

namespace Work.DSM4p

universe a

/-- The `n`-th completed chart level of the Riemann extension tower is complete for the
`p`-adic topology: `chartComp hgr Q n` is the completion of `chartRing hgr Q.ϖ n` at the
principal ideal `(p)`, and completions at finitely generated ideals are adically complete. -/
theorem chartComp_isAdicComplete {p : ℕ} [Fact p.Prime] {B : Type a} [CommRing B] {gr : ℕ → B}
    (hgr : Work.DSM4p.IsRootSystem p gr) (Q : DSMap.PerfectoidData p B) (n : ℕ) :
    IsAdicComplete (Ideal.span {((p : Work.DSM4p.chartComp hgr Q n))})
      (Work.DSM4p.chartComp hgr Q n) := by
  -- `(p)` in the chart ring is a principal ideal, hence finitely generated.
  have hfg : (Ideal.span {(p : chartRing hgr Q.ϖ n)}).FG := Submodule.fg_span_singleton _
  -- hence the completion at it is adically complete (`AdicCompletion.isAdicComplete`) ...
  have hcomp : IsAdicComplete (Ideal.span {(p : chartRing hgr Q.ϖ n)}) (chartComp hgr Q n) :=
    AdicCompletion.isAdicComplete hfg
  -- ... and the ideal we completed at is exactly the ideal generated by the image of `p`.
  have key : Ideal.span {(p : chartComp hgr Q n)}
      = (Ideal.span {(p : chartRing hgr Q.ϖ n)}).map
          (algebraMap (chartRing hgr Q.ϖ n) (chartComp hgr Q n)) := by
    rw [Ideal.map_span, Set.image_singleton,
      ← map_natCast (algebraMap (chartRing hgr Q.ϖ n) (chartComp hgr Q n)) p]
  rw [key]
  exact (IsAdicComplete.map_algebraMap_iff _ _).mpr hcomp

end Work.DSM4p
