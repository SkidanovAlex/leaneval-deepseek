import Mathlib

/-!
# `Work.DSM4p.adicCompletion_kernel_clause`

The "kernel clause" of the reduction to the `p`-adic completion: membership modulo `p ^ m` of an
element `x : B` (after push-forward to `E (n + c)`) can be *tested* in the `p`-adic completion
`AdicCompletion (p) (E (n + c))`.  Concretely, if `hk` decides, at the level of `E (n + c)`, whether
`ϖ k * gr k * x ∈ (p ^ m)`, then the same conclusion follows from the *a priori* weaker hypothesis
that the image of `x` in the completion lies in `(p ^ m)`.

The mathematical content is the standard fact that the natural map

  `E → A := AdicCompletion (p) E`

inducing `A / (p ^ m) A ≅ E / (p ^ m)`, i.e. the `m`-th evaluation
`AdicCompletion.evalₐ (p) m : A →ₐ[E] E ⧸ (p ^ m)` has kernel exactly `(p ^ m)` and its composite
with `algebraMap E A` is the quotient map.  Hence an element of `A` that is divisible by `p ^ m`
must come from an element of `E` that is divisible by `p ^ m`.
-/

namespace Work.DSM4p

universe a

/-- Auxiliary fact: if `x : R` maps into the ideal generated by the `m`-th power of `p` inside the
`I`-adic completion, then `x ∈ I ^ m`.  This is the kernel computation for
`AdicCompletion.evalₐ I m`. -/
lemma AdicCompletion.mem_pow_of_of_mem_span_pow {R : Type*} [CommRing R] (I : Ideal R) {p m : ℕ}
    (hp : (p : R) ∈ I) {x : R}
    (h : AdicCompletion.of I R x ∈ Ideal.span {(AdicCompletion.of I R (p : R)) ^ m}) :
    x ∈ I ^ m := by
  have hpw : (p : R) ^ m ∈ I ^ m := Ideal.pow_mem_pow hp m
  -- the `m`-th evaluation kills `(of p) ^ m`
  have hθp : (AdicCompletion.evalₐ I m) ((AdicCompletion.of I R (p : R)) ^ m) = 0 := by
    rw [map_pow, AdicCompletion.evalₐ_of, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact hpw
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp h
  have hθ : (AdicCompletion.evalₐ I m) (AdicCompletion.of I R x) = 0 := by
    rw [hc, map_mul, hθp, zero_mul]
  rw [AdicCompletion.evalₐ_of] at hθ
  exact Ideal.Quotient.eq_zero_iff_mem.mp hθ

/-- The kernel clause at a single level: an element of `B` whose image in the `p`-adic completion of
`R` lies in the ideal generated by `p ^ m` already lies in `(p ^ m)` as an ideal of `R`. -/
lemma adicCompletion_kernel_clause_aux {B : Type a} [CommRing B] {R : Type a} [CommRing R]
    [Algebra B R] {p m : ℕ} {x : B}
    (hx : algebraMap B (AdicCompletion (Ideal.span {(p : R)}) R) x ∈
        Ideal.span {((p : AdicCompletion (Ideal.span {(p : R)}) R)) ^ m}) :
    algebraMap B R x ∈ Ideal.span {((p : R)) ^ m} := by
  have hcoe : algebraMap B (AdicCompletion (Ideal.span {(p : R)}) R) x
      = AdicCompletion.of (Ideal.span {(p : R)}) R (algebraMap B R x) :=
    AdicCompletion.algebraMap_apply (Ideal.span {(p : R)}) x
  have hpcoe : (p : AdicCompletion (Ideal.span {(p : R)}) R)
      = AdicCompletion.of (Ideal.span {(p : R)}) R (p : R) := by
    rw [← map_natCast (algebraMap R (AdicCompletion (Ideal.span {(p : R)}) R)) p,
      AdicCompletion.algebraMap_apply]
    rfl
  rw [hcoe, hpcoe] at hx
  have hmem := AdicCompletion.mem_pow_of_of_mem_span_pow (R := R) (Ideal.span {(p : R)})
    (Ideal.subset_span (Set.mem_singleton (p : R))) hx
  rwa [Ideal.span_singleton_pow] at hmem

theorem adicCompletion_kernel_clause {p : ℕ} {B : Type a} [CommRing B]
    {E : ℕ → Type a} [∀ n, CommRing (E n)] [∀ n, Algebra B (E n)]
    {ϖ gr : ℕ → B} {m k c : ℕ}
    (hk : ∀ n (x : B), algebraMap B (E (n + c)) x ∈ Ideal.span {((p : E (n + c))) ^ m} →
        ϖ k * gr k * x ∈ Ideal.span {(p : B) ^ m}) :
    ∀ n (x : B),
      algebraMap B (AdicCompletion (Ideal.span {((p : E (n + c)))}) (E (n + c))) x ∈
        Ideal.span {((p : AdicCompletion (Ideal.span {((p : E (n + c)))}) (E (n + c)))) ^ m} →
      ϖ k * gr k * x ∈ Ideal.span {(p : B) ^ m} := by
  intro n x hx
  exact hk n x (adicCompletion_kernel_clause_aux hx)

end Work.DSM4p
