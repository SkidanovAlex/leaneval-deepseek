import Mathlib
import Submission.Work.DSM4p.Chart
import Submission.Work.DSM4p.chartGen_root_pow

/-!
# Every element of a chart level is a polynomial in a single generator

The `N`-th chart level `chartLevel hgr ϖ N` of the Riemann extension tower
(`Submission/Work/DSM4p/Chart.lean`) is the `B`-subalgebra of `B[1/g]` generated by *all* the
generators `x_k = ϖ_k^N / g_k`, `k ∈ ℕ`.  This module shows that, nevertheless, every one of
its elements is a polynomial in a *single* generator `x_κ`, for `κ` as large as one pleases.

The reason is the root relation `x_k = x_{k+1}^p` (`chartGen_succ_pow`, iterated in
`chartGen_root_pow`): the generator of lower index is a `p`-power of the generator of higher
index, i.e. `x_k = x_κ^{p^{κ-k}}` for `k ≤ κ`.  Hence the subalgebras `B[x_κ]` form an
increasing chain, and any *given* element of the level involves only finitely many generators,
all of which can be pushed into one sufficiently large `B[x_κ]`.

## Contents

* `adjoin_chartGen_mono` — monotonicity of the chain `B[x_K]`;
* `exists_mem_adjoin_chartGen_singleton` — every element of the level lies in some `B[x_K]`;
* `chartLevel_exists_aeval` — the polynomial form, in a single generator of arbitrarily large
  index.
-/

set_option linter.style.haveILetI false

namespace Work.DSM4p

universe a

section Chart

variable {p : ℕ} [Fact p.Prime] {B : Type a} [CommRing B]

/-- Monotonicity of the single-generator subalgebras: `B[x_{K₁}] ⊆ B[x_{K₂}]` for `K₁ ≤ K₂`.
This is the root relation `x_{K₁} = x_{K₂}^{p^{K₂-K₁}}`. -/
theorem adjoin_chartGen_mono {gr : ℕ → B} (hgr : IsRootSystem p gr) (ϖ : ℕ → B)
    (hϖ : IsRootSystem p ϖ) (n : ℕ) :
    ∀ K₁ K₂ : ℕ, K₁ ≤ K₂ →
      Algebra.adjoin B ({chartGen hgr ϖ n K₁} : Set (ChartAmbient gr)) ≤
        Algebra.adjoin B ({chartGen hgr ϖ n K₂} : Set (ChartAmbient gr)) := by
  intro K₁ K₂ h
  rw [Algebra.adjoin_le_iff]
  rintro w hw
  rw [Set.mem_singleton_iff] at hw
  rw [hw, chartGen_root_pow gr hgr ϖ hϖ n K₁ K₂ h]
  exact pow_mem (Algebra.subset_adjoin (Set.mem_singleton _)) _

/-- Every element of the `n`-th chart level lies in the subalgebra generated by a *single*
generator `x_K`, for some `K : ℕ`. -/
theorem exists_mem_adjoin_chartGen_singleton {gr : ℕ → B} (hgr : IsRootSystem p gr)
    (ϖ : ℕ → B) (hϖ : IsRootSystem p ϖ) (n : ℕ) (z : ChartAmbient gr)
    (hz : z ∈ Algebra.adjoin B (Set.range (chartGen hgr ϖ n))) :
    ∃ K : ℕ, z ∈ Algebra.adjoin B ({chartGen hgr ϖ n K} : Set (ChartAmbient gr)) := by
  have hmono := adjoin_chartGen_mono hgr ϖ hϖ n
  -- the union of the chain of single-generator subalgebras is a subalgebra
  let T : Subalgebra B (ChartAmbient gr) :=
    { carrier := {w | ∃ K, w ∈ Algebra.adjoin B ({chartGen hgr ϖ n K} : Set (ChartAmbient gr))}
      mul_mem' := by
        rintro x y ⟨K₁, h₁⟩ ⟨K₂, h₂⟩
        exact ⟨max K₁ K₂, mul_mem (hmono K₁ _ (le_max_left _ _) h₁)
          (hmono K₂ _ (le_max_right _ _) h₂)⟩
      add_mem' := by
        rintro x y ⟨K₁, h₁⟩ ⟨K₂, h₂⟩
        exact ⟨max K₁ K₂, add_mem (hmono K₁ _ (le_max_left _ _) h₁)
          (hmono K₂ _ (le_max_right _ _) h₂)⟩
      algebraMap_mem' := by
        intro b
        exact ⟨0, Subalgebra.algebraMap_mem _ b⟩ }
  have hle : Algebra.adjoin B (Set.range (chartGen hgr ϖ n)) ≤ T := by
    rw [Algebra.adjoin_le_iff]
    rintro w ⟨K, rfl⟩
    exact ⟨K, Algebra.subset_adjoin (Set.mem_singleton _)⟩
  exact hle hz

end Chart

theorem chartLevel_exists_aeval {p : ℕ} [Fact p.Prime] {R : Type a} [CommRing R]
    {G T : ℕ → R} (hG : Work.DSM4p.IsRootSystem p G) (hT : Work.DSM4p.IsRootSystem p T)
    {N : ℕ} (κ₀ : ℕ) (y : Work.DSM4p.chartLevel hG T N) :
    ∃ κ ≥ κ₀, ∃ P : Polynomial R,
      (y : Work.DSM4p.ChartAmbient G) = Polynomial.aeval (Work.DSM4p.chartGen hG T N κ) P := by
  obtain ⟨K, hK⟩ :=
    exists_mem_adjoin_chartGen_singleton hG T hT N (y : ChartAmbient G) y.2
  refine ⟨max K κ₀, le_max_right _ _, ?_⟩
  obtain ⟨P, hP⟩ := Algebra.adjoin_mem_exists_aeval R (chartGen hG T N (max K κ₀))
    (adjoin_chartGen_mono hG T hT N K (max K κ₀) (le_max_left _ _) hK)
  exact ⟨P, hP.symm⟩

end Work.DSM4p
