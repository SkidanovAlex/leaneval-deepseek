import Mathlib
import Submission.Work.DSMap.Mix2

/-!
# The cokernel clause of `IsQRETp` passes to the `p`-adic completion

`DSMap.Mix2.IsQRETp p B ϖ gr D tr` asks, among other things, that for the pro-system
`{B/p^m → D_n/p^m}` the cokernels be uniformly almost zero: for every `m`, `k` there is `c`
with

`∀ n (y : D (n+c)), ∃ x : B, (ϖ_k g_k) · tr_{n+c → n}(y) ≡ x  (mod p^m)`.

This file proves that the *same* clause holds for the tower of `p`-adic completions
`D'_n = AdicCompletion (p) (D n)`, with the transition maps `tr' : D'_{n+1} → D'_n` being any
`B`-algebra maps compatible with the structure maps `of : D_{n+1} → D'_{n+1}`,
`of : D_n → D'_n` (hypothesis `htr'`) — i.e. `Work.DSM4p.isQRETp_adicCompletion`'s cokernel half.

The argument (nothing about the specific tower is used beyond `htr'`):

* Mathlib's `AdicCompletion.pow_smul_top_eq_ker_eval` (finitely generated `I`) identifies the
  ideal `(p^m)` of the completion with the kernel of the `m`-th projection
  `eval m : Â → E/(p^m)`;
* since `eval m` is *surjective*, the class of `y ∈ Â_{n+c}` has a lift `y₀ ∈ E (n+c)`, i.e.
  `y - of y₀ ∈ (p^m) Â_{n+c}`;
* every `B`-algebra homomorphism such as `iterTr tr' n c` maps `(p^m)` into `(p^m)` (it fixes
  `p = algebraMap B _ p`), so `iterTr tr' n c y ≡ iterTr tr' n c (of y₀)` modulo `(p^m)` in
  `Â_n`, and by the compatibility `htr'` the latter is `of (iterTr tr n c y₀)`;
* the finitary hypothesis `hc` at `y₀` concludes.
-/

namespace Work.DSM4p

universe a

open DSMap DSMap.Mix

/-- In the `(p)`-adic completion of `E`, the ideal generated by `(p : Â)^m` is exactly the kernel
of the `m`-th projection `Â → E ⧸ (p^m)`.  (For `I` finitely generated this is Mathlib's
`AdicCompletion.pow_smul_top_eq_ker_eval`; here `I = Ideal.span {p}` is principal.) -/
private lemma key_span {E : Type a} [CommRing E] (p m : ℕ)
    (z : AdicCompletion (Ideal.span {(p : E)}) E) :
    z ∈ Ideal.span {((p : AdicCompletion (Ideal.span {(p : E)}) E)) ^ m} ↔
      AdicCompletion.eval (Ideal.span {(p : E)}) E m z = 0 := by
  have hfg : (Ideal.span {(p : E)} : Ideal E).FG := Submodule.fg_span (Set.finite_singleton _)
  have hsmul : (Ideal.span {(p : E)} : Ideal E) ^ m •
      (⊤ : Submodule E (AdicCompletion (Ideal.span {(p : E)}) E)) =
      (Ideal.span {((p : AdicCompletion (Ideal.span {(p : E)}) E)) ^ m}).restrictScalars E := by
    rw [Ideal.smul_top_eq_map, Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton,
      map_pow, map_natCast]
  change z ∈ (Submodule.restrictScalars E
    (Ideal.span {((p : AdicCompletion (Ideal.span {(p : E)}) E)) ^ m})) ↔ _
  rw [← hsmul, AdicCompletion.pow_smul_top_eq_ker_eval (I := Ideal.span {(p : E)}) (M := E) hfg,
    LinearMap.mem_ker]

/-- The defining recursion of `DSMap.Mix.iterTr` in applied form (the companion of
`Work.DSM4p.iterTr_succ_apply` of `Submission/Work/DSM4p/Basic.lean`). -/
private lemma iterTr_succ_apply' {B : Type a} [CommRing B] {D : ℕ → Type a} [∀ n, CommRing (D n)]
    [∀ n, Algebra B (D n)] (tr : ∀ n, D (n + 1) →ₐ[B] D n) (n c : ℕ) (y : D (n + (c + 1))) :
    DSMap.Mix.iterTr tr n (c + 1) y = DSMap.Mix.iterTr tr n c (tr (n + c) y) := rfl

/-- A ring homomorphism commutes with `p`, hence maps the principal ideal `(p^m)` into `(p^m)`. -/
private lemma algebraMap_mem_span_pow {E R : Type a} [CommRing E] [CommRing R] [Algebra E R]
    (p m : ℕ) (t : E) (ht : t ∈ Ideal.span {((p : E)) ^ m}) :
    algebraMap E R t ∈ Ideal.span {((p : R)) ^ m} := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp ht
  rw [hc, map_mul, map_pow, map_natCast]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton.mpr (dvd_refl _))

/-- A single transition of the completed tower preserves the ideal `(p^m)`: it is a `B`-algebra
homomorphism, so it fixes the image of `p`. -/
private lemma tr'_mem_span_pow {p m : ℕ} {B : Type a} [CommRing B] {E : ℕ → Type a}
    [∀ n, CommRing (E n)] [∀ n, Algebra B (E n)]
    (tr' : ∀ n, AdicCompletion (Ideal.span {((p : E (n + 1)))}) (E (n + 1)) →ₐ[B]
        AdicCompletion (Ideal.span {((p : E n))}) (E n)) (n : ℕ)
    (z : AdicCompletion (Ideal.span {((p : E (n + 1)))}) (E (n + 1)))
    (hz : z ∈ Ideal.span {((p : AdicCompletion (Ideal.span {((p : E (n + 1)))}) (E (n + 1)))) ^ m}) :
    tr' n z ∈ Ideal.span {((p : AdicCompletion (Ideal.span {((p : E n))}) (E n))) ^ m} := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hz
  rw [hc, map_mul, map_pow, map_natCast]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton.mpr (dvd_refl _))

/-- Iterating: the `c`-fold transition `iterTr tr' n c` preserves the ideal `(p^m)`. -/
private lemma iterTr_mem_span_pow {p : ℕ} {B : Type a} [CommRing B] {E : ℕ → Type a}
    [∀ n, CommRing (E n)] [∀ n, Algebra B (E n)]
    (tr' : ∀ n, AdicCompletion (Ideal.span {((p : E (n + 1)))}) (E (n + 1)) →ₐ[B]
        AdicCompletion (Ideal.span {((p : E n))}) (E n)) (m : ℕ) :
    ∀ (n c : ℕ) (z : AdicCompletion (Ideal.span {((p : E (n + c)))}) (E (n + c))),
      z ∈ Ideal.span {((p : AdicCompletion (Ideal.span {((p : E (n + c)))}) (E (n + c)))) ^ m} →
      DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c z ∈
        Ideal.span {((p : AdicCompletion (Ideal.span {((p : E n))}) (E n))) ^ m} := by
  intro n c
  induction c with
  | zero => intro z hz; exact hz
  | succ c ih =>
    intro z hz
    rw [iterTr_succ_apply' (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr']
    refine ih (tr' (n + c) z) ?_
    exact tr'_mem_span_pow tr' (n + c) z hz

/-- The compatibility of `iterTr` with the canonical maps `of`, iterated from the one-step
hypothesis `htr'`. -/
private lemma iterTr_of {p : ℕ} {B : Type a} [CommRing B] {E : ℕ → Type a}
    [∀ n, CommRing (E n)] [∀ n, Algebra B (E n)]
    (tr : ∀ n, E (n + 1) →ₐ[B] E n)
    (tr' : ∀ n, AdicCompletion (Ideal.span {((p : E (n + 1)))}) (E (n + 1)) →ₐ[B]
        AdicCompletion (Ideal.span {((p : E n))}) (E n))
    (htr' : ∀ (n : ℕ) (y : E (n + 1)),
        tr' n (AdicCompletion.of (Ideal.span {((p : E (n+1)))}) (E (n+1)) y)
          = AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (tr n y))
    (n c : ℕ) (y : E (n + c)) :
    DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c
        (AdicCompletion.of (Ideal.span {((p : E (n + c)))}) (E (n + c)) y)
      = AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (DSMap.Mix.iterTr tr n c y) := by
  induction c with
  | zero => rfl
  | succ c ih =>
    rw [iterTr_succ_apply' (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr',
      iterTr_succ_apply' (D := E) tr]
    have hkey : tr' (n + c)
          (AdicCompletion.of (Ideal.span {((p : E (n + (c + 1))))}) (E (n + (c + 1))) y)
        = AdicCompletion.of (Ideal.span {((p : E (n + c)))}) (E (n + c)) (tr (n + c) y) :=
      htr' (n + c) y
    rw [hkey]
    exact ih (tr (n + c) y)

theorem adicCompletion_cokernel_clause {p : ℕ} {B : Type a} [CommRing B]
    {E : ℕ → Type a} [∀ n, CommRing (E n)] [∀ n, Algebra B (E n)]
    {ϖ gr : ℕ → B} (tr : ∀ n, E (n + 1) →ₐ[B] E n)
    (tr' : ∀ n, AdicCompletion (Ideal.span {((p : E (n + 1)))}) (E (n + 1)) →ₐ[B]
        AdicCompletion (Ideal.span {((p : E n))}) (E n))
    (htr' : ∀ (n : ℕ) (y : E (n + 1)),
        tr' n (AdicCompletion.of (Ideal.span {((p : E (n+1)))}) (E (n+1)) y)
          = AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (tr n y))
    {m k c : ℕ}
    (hc : ∀ n (y : E (n + c)), ∃ x : B,
        algebraMap B (E n) (ϖ k * gr k) * DSMap.Mix.iterTr tr n c y - algebraMap B (E n) x ∈
          Ideal.span {((p : E n)) ^ m}) :
    ∀ n (y : AdicCompletion (Ideal.span {((p : E (n + c)))}) (E (n + c))), ∃ x : B,
      algebraMap B (AdicCompletion (Ideal.span {((p : E n))}) (E n)) (ϖ k * gr k) *
          DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c y
        - algebraMap B (AdicCompletion (Ideal.span {((p : E n))}) (E n)) x ∈
          Ideal.span {((p : AdicCompletion (Ideal.span {((p : E n))}) (E n))) ^ m} := by
  intro n y
  -- Choose a lift `y₀ ∈ E (n+c)` of the class of `y ∈ Â (n+c)`; `eval m` is surjective.
  obtain ⟨y₀, hy₀⟩ := Submodule.mkQ_surjective
    ((Ideal.span {((p : E (n + c)))}) ^ m • (⊤ : Submodule (E (n + c)) (E (n + c))))
    (AdicCompletion.eval (Ideal.span {((p : E (n + c)))}) (E (n + c)) m y)
  have hofy₀ : AdicCompletion.eval (Ideal.span {((p : E (n + c)))}) (E (n + c)) m
      (AdicCompletion.of (Ideal.span {((p : E (n + c)))}) (E (n + c)) y₀)
      = AdicCompletion.eval (Ideal.span {((p : E (n + c)))}) (E (n + c)) m y := by
    rw [AdicCompletion.eval_of]
    exact hy₀
  -- hence `y - of y₀ ∈ (p^m)`
  have hmem : y - AdicCompletion.of (Ideal.span {((p : E (n + c)))}) (E (n + c)) y₀ ∈
      Ideal.span {((p : AdicCompletion (Ideal.span {((p : E (n + c)))}) (E (n + c)))) ^ m} := by
    rw [key_span]
    rw [map_sub, hofy₀, sub_self]
  -- and this survives the transitions of the completed tower
  have hTmem := iterTr_mem_span_pow tr' m n c _ hmem
  have hTsub : DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n))
          tr' n c y
      - DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c
          (AdicCompletion.of (Ideal.span {((p : E (n + c)))}) (E (n + c)) y₀) ∈
      Ideal.span {((p : AdicCompletion (Ideal.span {((p : E n))}) (E n))) ^ m} := by
    have h := hTmem
    rwa [map_sub] at h
  have hTof := iterTr_of tr tr' htr' n c y₀
  obtain ⟨x, hx⟩ := hc n y₀
  refine ⟨x, ?_⟩
  rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply]
  have hof_eq : ∀ t : E n, AdicCompletion.of (Ideal.span {((p : E n))}) (E n) t =
      algebraMap (E n) (AdicCompletion (Ideal.span {((p : E n))}) (E n)) t := fun t => by
    rw [AdicCompletion.algebraMap_apply]
    rfl
  -- split the difference as `(of a)·(T y - T (of y₀)) + ((of a)·(T (of y₀)) - of bx)`
  have hsplit : AdicCompletion.of (Ideal.span {((p : E n))}) (E n)
          (algebraMap B (E n) (ϖ k * gr k)) *
        DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c y
      - AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (algebraMap B (E n) x)
      = AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (algebraMap B (E n) (ϖ k * gr k)) *
          (DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c y
            - DSMap.Mix.iterTr (D := fun n => AdicCompletion (Ideal.span {((p : E n))}) (E n)) tr' n c
                (AdicCompletion.of (Ideal.span {((p : E (n + c)))}) (E (n + c)) y₀))
        + (AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (algebraMap B (E n) (ϖ k * gr k)) *
              AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (DSMap.Mix.iterTr tr n c y₀)
            - AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (algebraMap B (E n) x)) := by
    rw [hTof]
    ring
  rw [hsplit]
  refine Ideal.add_mem _ ?_ ?_
  · exact Ideal.mul_mem_left _ _ hTsub
  · have h2 : AdicCompletion.of (Ideal.span {((p : E n))}) (E n)
            (algebraMap B (E n) (ϖ k * gr k)) *
          AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (DSMap.Mix.iterTr tr n c y₀)
        - AdicCompletion.of (Ideal.span {((p : E n))}) (E n) (algebraMap B (E n) x)
        = algebraMap (E n) (AdicCompletion (Ideal.span {((p : E n))}) (E n))
            (algebraMap B (E n) (ϖ k * gr k) * DSMap.Mix.iterTr tr n c y₀ -
              algebraMap B (E n) x) := by
      rw [hof_eq, hof_eq, hof_eq, ← map_mul, ← map_sub]
    rw [h2]
    exact algebraMap_mem_span_pow p m _ hx

end Work.DSM4p
