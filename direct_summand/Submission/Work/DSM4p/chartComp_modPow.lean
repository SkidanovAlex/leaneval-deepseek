import Mathlib
import Submission.Work.DSM4p.Completion

/-!
# DSM4p — the completed level modulo `p ^ m` agrees with the chart level modulo `p ^ m`

The `n`-th level of the Riemann extension tower is `chartComp hgr Q n`, the `p`-adic
completion of the chart level `chartRing hgr Q.ϖ n` (see `DSM4p/Completion.lean`).  This
module provides the comparison

  `chartComp hgr Q n ⧸ (p) ^ m ≃+* chartRing hgr Q.ϖ n ⧸ (p) ^ m`,

i.e. the completed level only differs from the algebraic chart level by the `p`-adic
topology: quotienting by `p ^ m` gives back the chart level modulo `p ^ m`.

This is the standard fact `Â / I ^ m ≅ A / I ^ m` for the `I`-adic completion `Â` of a ring
`A` (with `I` finitely generated): the evaluation map
`AdicCompletion.evalₐ I m : AdicCompletion I A →ₐ[A] A ⧸ I ^ m` is surjective, and its
kernel is exactly `I ^ m · Â` (`AdicCompletion.pow_smul_top_eq_ker_eval`), which is the ideal
generated by `p ^ m` in the completion.

## Contents

* `Work.DSM4p.ker_evalₐ_eq_pow` — the kernel of `AdicCompletion.evalₐ I m` is the `m`-th power
  of the ideal generated by (the image of) `I` in the completion (for `I` finitely generated);
* `Work.DSM4p.chartComp_modPow` — the comparison of the completed level with the chart level
  modulo `p ^ m`.
-/

set_option linter.style.haveILetI false

open CategoryTheory AlgebraicGeometry IsLocalRing Limits

namespace Work.DSM4p

universe a

open DSMap DSMap.Mix DSMap.Mix2

/-- For the `I`-adic completion `AdicCompletion I A` of a ring `A` with `I` finitely generated,
the kernel of the evaluation map `AdicCompletion.evalₐ I m : AdicCompletion I A → A ⧸ I ^ m` is
the `m`-th power of the ideal generated by the image of `I` in the completion. -/
theorem ker_evalₐ_eq_pow (A : Type*) [CommRing A] (I : Ideal A) (hI : I.FG) (m : ℕ) :
    RingHom.ker (AdicCompletion.evalₐ I m).toRingHom =
      (Ideal.map (algebraMap A (AdicCompletion I A)) I)^m := by
  ext x
  trans x ∈ (AdicCompletion.eval I A m).ker
  · -- `evalₐ` differs from `eval` by the (bijective) quotient map between equal ideals
    have eq : (I ^ m • ⊤ : Ideal A) = I^m := by ext y; simp
    have hinj : Function.Injective (Ideal.Quotient.factor (le_of_eq eq)) := by
      simpa [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker]
        using Ideal.map_mk_eq_bot_of_le (le_of_eq eq.symm)
    simpa [← AdicCompletion.factor_eval_eq_evalₐ (n := m) (x := x) (I := I) (h := le_of_eq eq)]
      using (map_eq_zero_iff (Ideal.Quotient.factor (le_of_eq eq)) hinj)
  · -- the kernel of `eval` is `I ^ m • ⊤ = I ^ m · Â`
    rw [← AdicCompletion.pow_smul_top_eq_ker_eval (I := I) (M := A) (n := m) hI,
      Ideal.smul_top_eq_map, Ideal.map_pow]
    simp

/-- The completed level `chartComp hgr Q n` modulo `p ^ m` agrees with the chart level
`chartRing hgr Q.ϖ n` modulo `p ^ m`. -/
theorem chartComp_modPow {p : ℕ} [Fact p.Prime] {B : Type a} [CommRing B] {gr : ℕ → B}
    (hgr : Work.DSM4p.IsRootSystem p gr) (Q : DSMap.PerfectoidData p B) (n m : ℕ) :
    Nonempty ((Work.DSM4p.chartComp hgr Q n) ⧸
        (Ideal.span {((p : Work.DSM4p.chartComp hgr Q n))}) ^ m ≃+*
      Work.DSM4p.chartRing hgr Q.ϖ n ⧸
        (Ideal.span {((p : Work.DSM4p.chartRing hgr Q.ϖ n))}) ^ m) := by
  have hFG : (Ideal.span {(p : chartRing hgr Q.ϖ n)}).FG :=
    Submodule.fg_span_singleton (p : chartRing hgr Q.ϖ n)
  -- the ideal generated by `p` in the completion is the image of the ideal generated by `p`
  have hmap : Ideal.map (algebraMap (chartRing hgr Q.ϖ n)
        (AdicCompletion (Ideal.span {(p : chartRing hgr Q.ϖ n)}) (chartRing hgr Q.ϖ n)))
        (Ideal.span {(p : chartRing hgr Q.ϖ n)})
      = Ideal.span {(p : AdicCompletion (Ideal.span {(p : chartRing hgr Q.ϖ n)})
          (chartRing hgr Q.ϖ n))} := by
    rw [Ideal.map_span, Set.image_singleton]
    congr 1
  have hker : (Ideal.span {(p : AdicCompletion (Ideal.span {(p : chartRing hgr Q.ϖ n)})
          (chartRing hgr Q.ϖ n))})^m
      = RingHom.ker (AdicCompletion.evalₐ (Ideal.span {(p : chartRing hgr Q.ϖ n)}) m).toRingHom := by
    rw [hmap.symm]
    exact (ker_evalₐ_eq_pow (chartRing hgr Q.ϖ n) (Ideal.span {(p : chartRing hgr Q.ϖ n)})
      hFG m).symm
  refine ⟨(Ideal.quotientEquivAlgOfEq (chartRing hgr Q.ϖ n) hker).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (AdicCompletion.surjective_evalₐ (Ideal.span {(p : chartRing hgr Q.ϖ n)}) m)) |>.toRingEquiv⟩

end Work.DSM4p
