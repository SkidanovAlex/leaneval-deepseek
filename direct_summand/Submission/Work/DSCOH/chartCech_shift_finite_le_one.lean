import Mathlib
import Submission.Work.DSCOH.ShiftToolkit
import Submission.Work.DSCOH.homology_zero_finite

/-!
# Finiteness of the chart Čech cohomology of `S(-d)` in low dimension

For `n ≤ 1` the chart Čech complex of the shifted free module `S(-d) = A[X₀,…,X_{n-1}](-d)` is
concentrated in degree `0` (all its terms in degrees `≥ 1` are products over an empty index type),
and its degree-`0` term is a subsingleton for `n = 0` and the cyclic `A`-module generated by
`1/X₀^d` for `n = 1`.  Hence both surviving cohomology groups `H⁰` and `H^{n-1} = H⁰` are finitely
generated `A`-modules, which is the statement proved here.

This is the low-dimensional case of `Work.DSCOH.chartCech_shift_finite` (Serre's computation of
the cohomology of `O(-d)` on projective space).
-/

namespace Work.DSCOH

variable {A : Type*} [CommRing A] {n : ℕ}

/-! ### Auxiliary facts -/

/-- For `n ≤ q` the `q`-th Čech term is a product over an empty index type, hence a
subsingleton. -/
lemma cechTerm_subsingleton_le {M : Type*} [AddCommGroup M] [Module A M] [Module (Poly A n) M]
    [IsScalarTower A (Poly A n) M] (ℳ : ℕ → Submodule A M) {q : ℕ} (h : n ≤ q) :
    Subsingleton (CechTerm (A := A) (n := n) (M := M) ℳ q) := by
  refine ⟨fun f g => funext fun S => absurd S.2 (by
    intro hc
    have h1 : S.1.card ≤ n := by simpa using Finset.card_le_univ S.1
    omega)⟩

/-- In `Fin 1 →₀ ℕ`, the unique element of degree `j` is the generator of weight `j`. -/
lemma set_finsupp_degree_fin_one (j : ℕ) :
    {d : Fin 1 →₀ ℕ | d.degree = j} = {Finsupp.single 0 j} := by
  refine Set.ext fun d => ?_
  constructor
  · intro hd
    rw [Set.mem_singleton_iff]
    refine Finsupp.ext fun i => ?_
    have hi : i = 0 := Subsingleton.elim i 0
    rw [hi, Finsupp.single_eq_same]
    have hdeg : d.degree = d 0 := by
      rw [Finsupp.degree_eq_sum, Fin.sum_univ_one]
    rw [← hdeg]
    exact hd
  · intro hd
    rw [Set.mem_singleton_iff] at hd
    rw [hd]
    simp

/-- In one variable, the degree-`j` homogeneous part of `A[X₀]` is the cyclic `A`-module
generated by `X₀^j`. -/
lemma homSub_fin_one_eq (j : ℕ) :
    homSub A 1 j = Submodule.span A {(MvPolynomial.X 0 : Poly A 1) ^ j} := by
  rw [homSub, MvPolynomial.homogeneousSubmodule_eq_finsupp_supported (Fin 1) A j,
    AddMonoidAlgebra.supported_eq_span_single A]
  rw [set_finsupp_degree_fin_one (j := j), Set.image_singleton]
  rw [show AddMonoidAlgebra.single (Finsupp.single 0 j) (1 : A) =
      (MvPolynomial.X 0 : Poly A 1) ^ j from
    (MvPolynomial.single_eq_monomial (Finsupp.single 0 j) (1 : A)).trans
      MvPolynomial.X_pow_eq_monomial.symm]

/-! ### The unique chart of the affine line -/

/-- The degree-zero part of the localization of `S(-d) = A[X₀](-d)` at `X₀` is the cyclic
`A`-module generated by `1/X₀^d`; in particular it is finitely generated. -/
lemma finite_degZero_fin_one (d : ℕ) :
    Module.Finite A (degZero (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d) ({0} : Finset (Fin 1))) := by
  let w : locAt (A := A) (M := Poly A 1) ({0} : Finset (Fin 1)) :=
    (divPow (A := A) (M := Poly A 1) ({0} : Finset (Fin 1)) d)
      (toLoc (A := A) (M := Poly A 1) ({0} : Finset (Fin 1)) (1 : Poly A 1))
  have heq : degZero (A := A) (n := 1) (M := Poly A 1) (shift (A := A) (n := 1) d)
        ({0} : Finset (Fin 1)) = Submodule.span A {w} := by
    refine le_antisymm ?_ ?_
    · refine iSup_le fun k => ?_
      intro x hx
      obtain ⟨m, hm, rfl⟩ := Submodule.mem_map.mp hx
      simp only [Finset.card_singleton, mul_one] at hm
      by_cases hk : d ≤ k
      · rw [shift_of_le hk] at hm
        rw [homSub_fin_one_eq (A := A) (k - d)] at hm
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hm
        simp only [LinearMap.comp_apply, map_smul]
        refine Submodule.smul_mem _ c ?_
        have hkey : (divPow (A := A) (M := Poly A 1) ({0} : Finset (Fin 1)) k)
            (toLoc (A := A) (M := Poly A 1) ({0} : Finset (Fin 1))
              ((MvPolynomial.X 0 : Poly A 1) ^ (k - d))) =
            (divPow (A := A) (M := Poly A 1) ({0} : Finset (Fin 1)) d)
              (toLoc (A := A) (M := Poly A 1) ({0} : Finset (Fin 1)) (1 : Poly A 1)) := by
          have hmono : monomial (A := A) ({0} : Finset (Fin 1)) =
              (MvPolynomial.X 0 : Poly A 1) := by
            simp [monomial, Var]
          have h := divPow_toLoc_smul_monomial_pow (A := A) (n := 1)
            (S := ({0} : Finset (Fin 1))) (k := d) (j := k - d) (m := (1 : Poly A 1))
          rw [Nat.add_sub_cancel' hk, hmono, mul_one] at h
          rw [← h]
        rw [hkey]
        exact Submodule.subset_span (Set.mem_singleton _)
      · rw [shift_of_not_le hk, Submodule.mem_bot] at hm
        rw [hm]
        simp
    · rw [Submodule.span_le]
      intro x hx
      have hxu : x = w := Set.mem_singleton_iff.mp hx
      rw [hxu]
      refine Submodule.mem_iSup_of_mem d (Submodule.mem_map.mpr ⟨1, ?_, rfl⟩)
      simp only [Finset.card_singleton, mul_one]
      rw [shift_of_le le_rfl, Nat.sub_self, homSub, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_one (Fin 1) A
  rw [heq]
  exact Module.Finite.iff_fg.mpr (Submodule.fg_span (Set.finite_singleton w))

/-- The degree-zero part of the zero-th Čech term of `S(-d)` over `A[X₀]` is finite (the only
chart is `S = {0}`). -/
lemma finite_cechTerm_zero_fin_one (d : ℕ) :
    Module.Finite A (CechTerm (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d) 0) := by
  have : ∀ S : {S : Finset (Fin 1) // S.card = 0 + 1},
      Module.Finite A (degZero (A := A) (n := 1) (M := Poly A 1)
        (shift (A := A) (n := 1) d) S.1) := fun S => by
    have huniv : S.1 = Finset.univ := Finset.eq_univ_of_card S.1 (by simpa using S.2)
    rw [huniv, show (Finset.univ : Finset (Fin 1)) = ({0} : Finset (Fin 1)) from rfl]
    exact finite_degZero_fin_one (A := A) d
  exact Module.Finite.pi

/-- The zero-th Čech term of `S(-d)` over `A` is finite: it is the empty product, hence the
zero module. -/
lemma finite_cechTerm_zero_fin_zero (d : ℕ) :
    Module.Finite A (CechTerm (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d) 0) := by
  have : ∀ S : {S : Finset (Fin 0) // S.card = 0 + 1},
      Module.Finite A (degZero (A := A) (n := 0) (M := Poly A 0)
        (shift (A := A) (n := 0) d) S.1) := fun S => absurd S.2 (by
          intro hc
          have h1 : S.1.card ≤ 0 := by simpa using Finset.card_le_univ S.1
          omega)
  exact Module.Finite.pi

/-! ### The homology in degree zero -/

/-- Finiteness of `H⁰` of the chart Čech complex of `S(-d)` over `A[X₀]`. -/
lemma homology_zero_finite_fin_one (d : ℕ)
    [SetLike.GradedSMul (homSub A 1) (shift (A := A) (n := 1) d)] :
    Module.Finite A ((chartCech (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d)).homology 0) := by
  refine homology_zero_finite _ ?_
  have hsX : Subsingleton (↥((chartCech (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d)).X 1)) := by
    show Subsingleton (CechTerm (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d) 1)
    exact cechTerm_subsingleton_le (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d) (q := 1) le_rfl
  have hmX : Module.Finite A (↥((chartCech (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d)).X 0)) := by
    show Module.Finite A (CechTerm (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d) 0)
    exact finite_cechTerm_zero_fin_one (A := A) d
  have hzero : ((chartCech (A := A) (n := 1) (M := Poly A 1)
      (shift (A := A) (n := 1) d)).d 0 1).hom = 0 := by
    ext x
    exact Subsingleton.elim _ _
  rw [hzero, LinearMap.ker_zero]
  exact Module.Finite.iff_fg.mpr hmX.fg_top

/-- Finiteness of `H⁰` of the chart Čech complex of `S(-d)` over `A`. -/
lemma homology_zero_finite_fin_zero (d : ℕ)
    [SetLike.GradedSMul (homSub A 0) (shift (A := A) (n := 0) d)] :
    Module.Finite A ((chartCech (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d)).homology 0) := by
  refine homology_zero_finite _ ?_
  have hsX : Subsingleton (↥((chartCech (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d)).X 1)) := by
    show Subsingleton (CechTerm (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d) 1)
    exact cechTerm_subsingleton_le (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d) (q := 1) (by norm_num)
  have hmX : Module.Finite A (↥((chartCech (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d)).X 0)) := by
    show Module.Finite A (CechTerm (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d) 0)
    exact finite_cechTerm_zero_fin_zero (A := A) d
  have hzero : ((chartCech (A := A) (n := 0) (M := Poly A 0)
      (shift (A := A) (n := 0) d)).d 0 1).hom = 0 := by
    ext x
    exact Subsingleton.elim _ _
  rw [hzero, LinearMap.ker_zero]
  exact Module.Finite.iff_fg.mpr hmX.fg_top

/-! ### The theorem -/

theorem chartCech_shift_finite_le_one {A : Type*} [CommRing A] {n : ℕ} (d : ℕ)
    [SetLike.GradedSMul (homSub A n) (shift (A := A) (n := n) d)] (hn : n ≤ 1) :
    Module.Finite A ((chartCech (A := A) (n := n) (M := Poly A n)
        (shift (A := A) (n := n) d)).homology 0) ∧
      Module.Finite A ((chartCech (A := A) (n := n) (M := Poly A n)
        (shift (A := A) (n := n) d)).homology (n - 1)) := by
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · subst h0
    have h := homology_zero_finite_fin_zero (A := A) d
    have hsub : (0 : ℕ) - 1 = 0 := by simp
    rw [hsub]
    exact ⟨h, h⟩
  · have hn1 : n = 1 := by omega
    subst hn1
    have h := homology_zero_finite_fin_one (A := A) d
    have hsub : (1 : ℕ) - 1 = 0 := by simp
    rw [hsub]
    exact ⟨h, h⟩

end Work.DSCOH
