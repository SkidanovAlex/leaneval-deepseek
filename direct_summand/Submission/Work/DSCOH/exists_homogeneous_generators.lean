import Mathlib
import Submission.Work.DSCOH.Basic

/-!
# Finitely generated graded modules over `A[X₀,…,X_{n-1}]` are generated by
   finitely many *homogeneous* elements

Let `M` be a module over the polynomial ring `A[X₀,…,X_{n-1}]` (`Poly A n`) which is
internally graded by `ℳ : ℕ → Submodule A M` (`DirectSum.Decomposition ℳ`), compatible with
the standard grading of `A[X₀,…,X_{n-1}]` (`SetLike.GradedSMul (homSub A n) ℳ`).

If `M` is finitely generated as a `Poly A n`-module, then it admits a finite generating family
consisting of homogeneous elements `g i ∈ ℳ (d i)`.

The proof is the standard one: take finitely many generators, split each of them into its
homogeneous components via the decomposition, and observe that the original generators are
(finite) sums of these components, hence the components generate `M`.
-/

namespace Work.DSCOH

theorem exists_homogeneous_generators {A : Type*} [CommRing A] {n : ℕ}
    {M : Type*} [AddCommGroup M] [Module A M] [Module (Poly A n) M] [IsScalarTower A (Poly A n) M]
    (ℳ : ℕ → Submodule A M) [DirectSum.Decomposition ℳ] [SetLike.GradedSMul (homSub A n) ℳ]
    [Module.Finite (Poly A n) M] :
    ∃ (k : ℕ) (g : Fin k → M) (d : Fin k → ℕ), (∀ i, g i ∈ ℳ (d i)) ∧
      Submodule.span (Poly A n) (Set.range g) = ⊤ := by
  classical
  -- A finite generating family of `M` as a `Poly A n`-module.
  obtain ⟨n', s, hs⟩ := Module.Finite.exists_fin (R := Poly A n) (M := M)
  -- The finite set of pairs `(d, m)` where `m ∈ ℳ d` is a homogeneous component of one of the
  -- generators `s j`.
  let T : Finset (ℕ × M) :=
    Finset.univ.biUnion fun j : Fin n' =>
      (DirectSum.decompose ℳ (s j)).support.image
        fun i => (i, ((DirectSum.decompose ℳ (s j)) i : M))
  -- Every element of `T` is homogeneous of the recorded degree.
  have hT : ∀ p ∈ T, p.2 ∈ ℳ p.1 := by
    intro p hp
    rw [Finset.mem_biUnion] at hp
    obtain ⟨j, -, hp⟩ := hp
    rw [Finset.mem_image] at hp
    obtain ⟨i, -, hpi⟩ := hp
    have hp' : p = (i, ((DirectSum.decompose ℳ (s j)) i : M)) := hpi.symm
    rw [hp']
    exact (DirectSum.decompose ℳ (s j) i).2
  -- The homogeneous components generate `M` as a `Poly A n`-module.
  have hspan' : Submodule.span (Poly A n) (Set.range s) ≤
      Submodule.span (Poly A n) ((T.image (fun p : ℕ × M => p.2) : Finset M) : Set M) := by
    rw [Submodule.span_le]
    rintro x ⟨j, rfl⟩
    have hsum := DirectSum.sum_support_decompose ℳ (s j)
    rw [← hsum]
    refine Submodule.sum_mem _ fun i hi => Submodule.subset_span ?_
    rw [Finset.mem_coe, Finset.mem_image]
    exact ⟨(i, ((DirectSum.decompose ℳ (s j)) i : M)),
      Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, Finset.mem_image.mpr ⟨i, hi, rfl⟩⟩, rfl⟩
  have hspan : Submodule.span (Poly A n) ((T.image (fun p : ℕ × M => p.2) : Finset M) : Set M) = ⊤ := by
    rw [hs] at hspan'
    exact top_le_iff.mp hspan'
  -- Enumerate the finite set `T` by `Fin T.card`.
  refine ⟨T.card, (fun i : Fin T.card => (T.equivFin.symm i).1.2),
    (fun i : Fin T.card => (T.equivFin.symm i).1.1), ?_, ?_⟩
  · intro i
    exact hT _ (T.equivFin.symm i).2
  · have hrange : Set.range (fun i : Fin T.card => (T.equivFin.symm i).1.2)
        = ((T.image (fun p : ℕ × M => p.2) : Finset M) : Set M) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact Finset.mem_coe.mpr
          (Finset.mem_image.mpr ⟨(T.equivFin.symm i).1, (T.equivFin.symm i).2, rfl⟩)
      · intro hy
        rw [Finset.mem_coe, Finset.mem_image] at hy
        obtain ⟨p, hp, hpy⟩ := hy
        refine ⟨T.equivFin ⟨p, hp⟩, ?_⟩
        simp only [Equiv.symm_apply_apply]
        exact hpy
    rw [hrange]
    exact hspan

end Work.DSCOH
