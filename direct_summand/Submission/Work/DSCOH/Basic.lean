/-
Area DSCOH (curric-46) — coherence of projective cohomology.

This file contains the *vocabulary* of the area: the polynomial ring `A[x₀,…,x_{n-1}]` with its
standard grading, its localizations at products of variables (the chart rings involved in the
standard affine cover of `ℙⁿ`), and the "degree zero part" of the localization of a graded
module, which is the module of sections of the associated quasi-coherent sheaf over a chart.

The results of the area (Serre-type finiteness of the degree-zero Čech complex of a finitely
generated graded module over the polynomial ring, and its use for `DSMap.area_COH`) are stated
and proved in the other files of this directory.
-/
import Mathlib

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Work.DSCOH

variable {A : Type*} [CommRing A] {n : ℕ}

/-- `A[X₀,…,X_{n-1}]` with its standard `ℕ`-grading by total degree. -/
abbrev Poly (A : Type*) [CommRing A] (n : ℕ) := MvPolynomial (Fin n) A

/-- The `d`-th graded piece of the standard grading of `A[X₀,…,X_{n-1}]`. -/
abbrev homSub (A : Type*) [CommRing A] (n : ℕ) (d : ℕ) : Submodule A (Poly A n) :=
  MvPolynomial.homogeneousSubmodule (Fin n) A d

/-- The `i`-th variable of `A[X₀,…,X_{n-1}]`. -/
noncomputable abbrev Var (i : Fin n) : Poly A n := MvPolynomial.X i

/-- The monomial `∏_{i ∈ S} Xᵢ`, of total degree `S.card`. -/
noncomputable def monomial (S : Finset (Fin n)) : Poly A n := ∏ i ∈ S, Var (A := A) i

/-- The submonoid of `A[X₀,…,X_{n-1}]` generated by the variables indexed by `S`; the
localization at it is the chart ring of the open set `D₊(∏_{i∈S} Xᵢ)` of `ℙⁿ`. -/
noncomputable def subS (S : Finset (Fin n)) : Submonoid (Poly A n) :=
  Submonoid.closure (Var (A := A) '' (S : Set (Fin n)))

lemma mem_subS (S : Finset (Fin n)) (i : Fin n) (hi : i ∈ S) :
    Var (A := A) i ∈ subS (A := A) S :=
  Submonoid.subset_closure ⟨i, hi, rfl⟩

lemma monomial_mem (S : Finset (Fin n)) :
    monomial (A := A) S ∈ subS (A := A) S := by
  rw [monomial]
  exact Submonoid.prod_mem _ fun i hi => mem_subS S i hi

lemma subS_mono {S T : Finset (Fin n)} (h : S ⊆ T) :
    subS (A := A) S ≤ subS (A := A) T :=
  Submonoid.closure_mono (Set.image_mono h)

variable {M : Type*} [AddCommGroup M] [Module A M] [Module (Poly A n) M]
  [IsScalarTower A (Poly A n) M]

/-- The localization of `M` inverting the variables indexed by `S`.  For a graded module `M`
this is the module of sections of the associated sheaf over the affine chart `D₊(∏_{i∈S} Xᵢ)`,
up to the degree-zero part taken in `degZero`. -/
abbrev locAt (S : Finset (Fin n)) : Type _ := LocalizedModule (subS (A := A) S) M

/-- The `A`-linear map `M → M[1/X_S]`, `m ↦ m/1`. -/
noncomputable def toLoc (S : Finset (Fin n)) : M →ₗ[A] locAt (A := A) (M := M) S :=
  (LocalizedModule.mkLinearMap (subS (A := A) S) M).restrictScalars A

/-- Division by `(∏_{i∈S} Xᵢ)^k` on the localization at `S`. -/
noncomputable def divPow (S : Finset (Fin n)) (k : ℕ) :
    locAt (A := A) (M := M) S →ₗ[A] locAt (A := A) (M := M) S :=
  (LocalizedModule.divBy (⟨monomial (A := A) S ^ k,
    Submonoid.pow_mem (subS (A := A) S) (monomial_mem S) k⟩ : subS (A := A) S)).restrictScalars A

/-- **The degree-zero part of the localization at a chart.**  If `M = ⨁_d M_d` is ℕ-graded,
`(M[1/X_S])_0` is generated by the elements `m/X_S^k` with `m ∈ M_{k·|S|}`; this is the
`A`-submodule of `M[1/X_S]` spanned by these. -/
noncomputable def degZero (ℳ : ℕ → Submodule A M) (S : Finset (Fin n)) :
    Submodule A (locAt (A := A) (M := M) S) :=
  ⨆ k : ℕ, Submodule.map ((divPow (A := A) (M := M) S k).comp (toLoc (A := A) (M := M) S))
    (ℳ (k * S.card))

/-- The structure map `M[1/X_S] → M[1/X_T]` for `S ⊆ T` (inverting more elements), induced by
the inclusion of submonoids. -/
noncomputable def resAt {S T : Finset (Fin n)} (h : S ⊆ T) :
    locAt (A := A) (M := M) S →ₗ[Poly A n] locAt (A := A) (M := M) T :=
  LocalizedModule.liftOfLE (subS (A := A) S) (subS (A := A) T) (subS_mono h)

variable {N : Type*} [AddCommGroup N] [Module A N] [Module (Poly A n) N]
  [IsScalarTower A (Poly A n) N]

/-- The map induced on chart localizations by a linear map of graded modules. -/
noncomputable def locMapOf (φ : M →ₗ[Poly A n] N) (S : Finset (Fin n)) :
    locAt (A := A) (M := M) S →ₗ[Poly A n] locAt (A := A) (M := N) S :=
  IsLocalizedModule.map (subS (A := A) S) (LocalizedModule.mkLinearMap (subS (A := A) S) M)
    (LocalizedModule.mkLinearMap (subS (A := A) S) N) φ

/-- The map induced by `φ` between the degree-zero parts of the chart localizations.  The proof
of compatibility with the degree-zero parts is supplied explicitly (it is
`Work.DSCOH.degZero_locMapOf` in the graded case). -/
noncomputable def degZeroMapOf (ℳ : ℕ → Submodule A M) (𝒩 : ℕ → Submodule A N)
    (φ : M →ₗ[Poly A n] N) (S : Finset (Fin n))
    (h : ∀ x ∈ degZero (A := A) ℳ S, locMapOf (A := A) φ S x ∈ degZero (A := A) 𝒩 S) :
    degZero (A := A) ℳ S →ₗ[A] degZero (A := A) 𝒩 S :=
  (((locMapOf (A := A) (M := M) φ S).restrictScalars A).domRestrict (degZero (A := A) ℳ S)).codRestrict
    _ (fun x => h x.1 x.2)

/-- Restriction of a linear map between chart localizations to the degree-zero parts, given
compatibility with the degree-zero parts (it is `Work.DSCOH.resAt_degZero` for the restriction
maps `resAt` in the graded case). -/
noncomputable def degPartRestrict (ℳ : ℕ → Submodule A M) {S T : Finset (Fin n)}
    (ψ : locAt (A := A) (M := M) S →ₗ[Poly A n] locAt (A := A) (M := M) T)
    (h : ∀ x ∈ degZero (A := A) ℳ S, ψ x ∈ degZero (A := A) ℳ T) :
    degZero (A := A) ℳ S →ₗ[A] degZero (A := A) ℳ T :=
  ((ψ.restrictScalars A).domRestrict (degZero (A := A) ℳ S)).codRestrict _
    (fun x => h x.1 x.2)

end Work.DSCOH
