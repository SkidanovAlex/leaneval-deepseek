import Mathlib
import Submission.Work.DSCOH.Basic

namespace Work.DSCOH

/-- Each variable `Xᵢ` is a regular element of `A[X₀,…,X_{n-1}]`. -/
lemma isRegular_var {A : Type*} [CommRing A] {n : ℕ} (i : Fin n) :
    IsRegular (Var (A := A) i) :=
  MvPolynomial.isRegular_X

/-- The unit of `A[X₀,…,X_{n-1}]` is regular. -/
lemma isRegular_one_poly {A : Type*} [CommRing A] {n : ℕ} :
    IsRegular (1 : Poly A n) :=
  isRegular_one

/-- **Elements of `subS S` are regular.**  `subS S` is the submonoid generated by the variables
`Xᵢ` (`i ∈ S`); each of these is a non-zero-divisor, and a product of non-zero-divisors is a
non-zero-divisor, so the same holds for every element of the submonoid. -/
theorem isRegular_of_mem_subS {A : Type*} [CommRing A] {n : ℕ} {S : Finset (Fin n)}
    {u : Poly A n} (hu : u ∈ subS (A := A) S) : IsRegular u := by
  induction hu using Submonoid.closure_induction with
  | mem x hx =>
      rcases hx with ⟨i, -, rfl⟩
      exact MvPolynomial.isRegular_X
  | one => exact isRegular_one
  | mul x y _ _ ihx ihy => exact ihx.mul ihy

end Work.DSCOH
