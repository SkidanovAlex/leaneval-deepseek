import Mathlib
import Submission.Work.DSM5c.Lp.LpDefs

/-!
# DSM5c — the kernel of the mod-`p` comparison `D_S → L_S`

`Work.DSM5c.Lp.chartCmpRingHom` (`Submission/Work/DSM5c/Lp/LpDefs.lean`) is the ring homomorphism

  `D_S = untiltOf R_S φ_S →+* L_S = R_S ⧸ (φ_S (ϖ♭) ^ p)`,   `[y] ↦ [constantCoeff y]`,

which realizes the mod-`p` comparison of the chart layer (transport step 5 of `NOTES.md` §20.2).
This file identifies its kernel with the submodule `(p) · ⊤ ⊆ D_S`:

* `Work.DSM5c.Lp.chartCmpRingHom_eq_zero_iff` —
  `chartCmpRingHom x = 0 ↔ x ∈ (p) · ⊤`;

the general-purpose input about `I • ⊤` for a principal `I` is
`Work.DSM5c.Lp.mem_span_singleton_smul_top_iff` (`Ideal.smul_top_eq_map`).

## The proof

Let `y : 𝕎 R_S` be a representative of `x` (`Ideal.Quotient.mk_surjective`), so that
`chartCmpRingHom x = mk_L (constantCoeff y)` (`chartCmpRingHom_mk`).  The chart-level mod-`p`
comparison `Work.DSM5c.mem_span_p_sup_map_ker_fontaineTheta`
(`Submission/Work/DSM5c/ChartComparison.lean`) states

  `y ∈ (p) ⊔ 𝕎(φ_S)(ker θ_W) ↔ constantCoeff y ∈ (φ_S (ϖ♭) ^ p)`,

and the ideal `𝕎(φ_S)(ker θ_W)` is exactly the one cut out by `untiltOf`, so the right-hand side is
`chartCmpRingHom x = 0` and the left-hand side becomes `x ∈ (p) · D_S`.  The identification of
`(p) · ⊤` with the ideal generated by `algebraMap W D_S (p : W)` is
`mem_span_singleton_smul_top_iff`; the element `algebraMap W D_S (p : W)` is the class of
`(p : 𝕎 R_S)` (`untiltOf.algebraMap_fontaineTheta`), and it is killed by the comparison because
`constantCoeff (p : 𝕎 R_S) = (p : R_S) = 0` in the characteristic-`p` ring `R_S`.
-/

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 800000
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.DSM5c.Lp

universe a

/-- **`I • ⊤` for a principal ideal of scalars.**  In a commutative `W'`-algebra `D`, the submodule
`(p) · ⊤` generated by the scalar `p` is the ideal generated by its image `algebraMap W' D p`.

This is the translation between the ideal form `(p) ⊆ D` of the ring `D` (in which the kernel
identification `chartCmpRingHom_eq_zero_iff` is proved) and the `W`-submodule form `(p) · ⊤` in which
the statement of the frozen node is phrased. -/
theorem mem_span_singleton_smul_top_iff {W' D : Type a} [CommRing W'] [CommRing D] [Algebra W' D]
    (p : W') (x : D) :
    x ∈ Ideal.span {p} • (⊤ : Submodule W' D) ↔ x ∈ Ideal.span {algebraMap W' D p} := by
  rw [Ideal.smul_top_eq_map, Ideal.map_span]
  simp

/-- **The kernel of the mod-`p` comparison `D_S →+* L_S` is `(p) · ⊤`.**  The comparison ring
homomorphism `chartCmpRingHom` (the `0`-th Witt coordinate on `D_S = untiltOf R_S φ_S`) vanishes on
an element `x` of the chart untilt exactly on the submodule generated by `p`; equivalently it is the
`W`-linear surjection `D_S ⧸ (p) · ⊤ ≅ L_S` of the M5c transport (`NOTES.md` §20.2 step 5). -/
theorem chartCmpRingHom_eq_zero_iff {p : ℕ} [Fact p.Prime] {W : Type a} [CommRing W]
    [Fact ¬IsUnit (p : W)] [IsAdicComplete (Ideal.span {(p : W)}) W] {ι : Type a} [DecidableEq ι]
    (Q : DSMap.PerfectoidData p W)
    (hθ : Function.Surjective (WittVector.fontaineTheta (p := p) (R := W)))
    (t : ι → W) (tr : ι → ℕ → W) (htr0 : ∀ i, tr i 0 = t i)
    (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ) (S : Finset ι)
    [CharP (Work.DSM5c.tiltChart Q t tr htr0 htr j₀ e S) p]
    [PerfectRing (Work.DSM5c.tiltChart Q t tr htr0 htr j₀ e S) p]
    (x : Work.DSM5c.untiltOf (Work.DSM5c.tiltChart Q t tr htr0 htr j₀ e S)
      (Work.DSM5c.chartPhi Q t tr htr0 htr j₀ e S)) :
    letI := Work.DSM5c.chartDAlg Q hθ t tr htr0 htr j₀ e S
    Work.DSM5c.Lp.chartCmpRingHom Q hθ t tr htr0 htr j₀ e S x = 0 ↔
      x ∈ Work.DSM5c.Lp.chartDpTop Q hθ t tr htr0 htr j₀ e S := by
  letI := Work.DSM5c.chartDAlg Q hθ t tr htr0 htr j₀ e S
  rw [mem_chartDpTop]
  have h1 : WittVector.fontaineTheta (p := p) (R := W)
      (p : WittVector p (PreTilt W p)) = (p : W) := map_natCast _ _
  have h2 : WittVector.map (chartPhi Q t tr htr0 htr j₀ e S)
      (p : WittVector p (PreTilt W p)) =
        (p : WittVector p (tiltChart Q t tr htr0 htr j₀ e S)) := map_natCast _ _
  have hmkp : (Ideal.Quotient.mk (chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S)
        (p : WittVector p (tiltChart Q t tr htr0 htr j₀ e S)))
      = algebraMap W (untiltOf (tiltChart Q t tr htr0 htr j₀ e S)
          (chartPhi Q t tr htr0 htr j₀ e S)) (p : W) := by
    change (untiltOf.mk (p := p) (W := W) (chartPhi Q t tr htr0 htr j₀ e S)
        (p : WittVector p (tiltChart Q t tr htr0 htr j₀ e S)))
      = untiltOf.algebraMap hθ (chartPhi Q t tr htr0 htr j₀ e S) (p : W)
    rw [← h2, ← h1]
    exact (untiltOf.algebraMap_fontaineTheta (p := p) (W := W) hθ
      (chartPhi Q t tr htr0 htr j₀ e S) (p : WittVector p (PreTilt W p))).symm
  have hp_zero : chartCmpRingHom Q hθ t tr htr0 htr j₀ e S
      (algebraMap W (untiltOf (tiltChart Q t tr htr0 htr j₀ e S)
        (chartPhi Q t tr htr0 htr j₀ e S)) (p : W)) = 0 := by
    rw [← hmkp, chartCmpRingHom_mk]
    have hcc : WittVector.constantCoeff
        (p : WittVector p (tiltChart Q t tr htr0 htr j₀ e S)) = 0 := by
      rw [map_natCast]
      exact CharP.cast_eq_zero _ _
    rw [hcc, map_zero]
  constructor
  · intro hx
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
      (I := chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S) x
    have hcc : WittVector.constantCoeff y ∈ chartLIdeal Q t tr htr0 htr j₀ e S := by
      have hx' : chartCmpRingHom Q hθ t tr htr0 htr j₀ e S
          (Ideal.Quotient.mk (chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S) y) = 0 := by
        rw [hy]; exact hx
      rw [chartCmpRingHom_mk] at hx'
      exact Ideal.Quotient.eq_zero_iff_mem.mp hx'
    have hmem : y ∈ Ideal.span
          {(p : WittVector p (tiltChart Q t tr htr0 htr j₀ e S))} ⊔
        chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S :=
      (mem_span_p_sup_map_ker_fontaineTheta Q hθ
        (chartPhi Q t tr htr0 htr j₀ e S) y).mpr (by simpa [chartLIdeal_def] using hcc)
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ha
    have hxa : x = Ideal.Quotient.mk (chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S) a := by
      rw [← hy, show y = a + b from hab.symm, map_add,
        show Ideal.Quotient.mk (chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S) b = 0 from
          Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero]
    have hmap : x ∈ Ideal.map (Ideal.Quotient.mk (chartUntiltIdeal Q hθ t tr htr0 htr j₀ e S))
        (Ideal.span {(p : WittVector p (tiltChart Q t tr htr0 htr j₀ e S))}) := by
      rw [hxa]
      exact Ideal.mem_map_of_mem _ ha
    rw [Ideal.map_span, Set.image_singleton] at hmap
    rw [hmkp] at hmap
    exact (mem_span_singleton_smul_top_iff (p : W) x).mpr hmap
  · intro hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp
      ((mem_span_singleton_smul_top_iff (p : W) x).mp hx)
    rw [← hc, map_mul, hp_zero, mul_zero]

end Work.DSM5c.Lp
