import Mathlib
import Submission.Work.DSM5c.Lp.ChartLpR
import Submission.Work.DSM5c.Lp.ker_Pi_map_span
import Submission.Work.DSM5c.Lp.surjective_Pi_map
import Submission.Work.DSM5c.Devissage.almostAcyc_of_surjective_kernel_v2

/-!
# DSM5c/Lp — the termwise quotient `perfChartPresheaf ⟶ chartLpR`

The perfected tilted chart presheaf `S ↦ R_S` maps naturally onto the mod-`p` chart presheaf
`chartLpR : S ↦ R_S ⧸ (φ_S(ϖ♭)^p)` (the quotient by the ideal generated by `(ϖ♭)^p`).  This file
constructs that natural transformation, its coaugmentation image, and identifies the kernel of the
induced chain map of Čech complexes with `((ϖ♭)^p) · ⊤`, so that the mod-`⊥` almost acyclicity of the
characteristic-`p` input descends to `Č(chartLpR)` modulo `((ϖ♭)^p)` (the form in which the transport
consumes it).
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000
set_option allowUnsafeReducibility true

attribute [local reducible] Work.DSM5c.chartTiltGen Work.DSM5c.tiltChart
  Work.DSM5c.Lp.chartLpRObj Work.DSM5c.Lp.chartLpROfHom
  DSMap.Mix2.perfChartRing DSMap.Mix2.perfChartPresheaf DSMap.Mix2.locPresheaf

namespace Work.DSM5c.Lp

universe a

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2
open CategoryTheory.Limits Opposite

variable {p : ℕ} [Fact p.Prime] {W : Type a} [CommRing W] [Fact ¬IsUnit (p : W)]
  [IsAdicComplete (Ideal.span {(p : W)}) W] {ι : Type a} [DecidableEq ι]

/-- The tilt shadow of the principal ideal `((ϖ♭)^p)` at a chart. -/
theorem smul_top_eq_chartLIdeal (Q : DSMap.PerfectoidData p W) (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ)
    (S : Finset ι) :
    Ideal.span {(Work.DSM5c.tiltVarpi Q) ^ p} • (⊤ : Submodule (PreTilt W p)
        (tiltChart Q t tr htr0 htr j₀ e S)) =
      (chartLIdeal Q t tr htr0 htr j₀ e S).restrictScalars (PreTilt W p) := by
  rw [Ideal.smul_top_eq_map, Ideal.map_span, chartLIdeal_def]
  congr 1
  rw [Set.image_singleton, map_pow]
  rfl

/-- **Saturation of a principal `I • ⊤` along a surjection with that kernel.**  (The general form, for
an arbitrary principal ideal, of `Work.DSM5c.Devissage.mem_span_singleton_smul_top_of_map_mem`.) -/
lemma sat_of_ker {R : Type} [CommRing R] {M : Type} [AddCommGroup M] [Module R M]
    {N : Type} [AddCommGroup N] [Module R N] (g : M →ₗ[R] N) (hg : Function.Surjective g)
    (r : R) (hker : ∀ x : M, g x = 0 ↔ x ∈ Ideal.span {r} • (⊤ : Submodule R M))
    (x : M) (hx : g x ∈ Ideal.span {r} • (⊤ : Submodule R N)) :
    x ∈ Ideal.span {r} • (⊤ : Submodule R M) := by
  obtain ⟨v, hv⟩ := (Work.DSM5c.mem_span_singleton_smul_top (W := R) r (g x)).mp hx
  obtain ⟨v', hv'⟩ := hg v
  have hzero : g (x - r • v') = 0 := by
    rw [map_sub, map_smul, hv', hv, sub_self]
  have hmem : x - r • v' ∈ Ideal.span {r} • (⊤ : Submodule R M) := (hker _).mp hzero
  have hx' : x = (x - r • v') + r • v' := by abel
  rw [hx']
  exact Submodule.add_mem _ hmem
    (Submodule.smul_mem_smul (Ideal.mem_span_singleton_self r) Submodule.mem_top)

/-- **The quotient natural transformation `perfChartPresheaf ⟶ chartLpR`.** -/
noncomputable def perfChartToLpR (Q : DSMap.PerfectoidData p W) (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ) :
    perfChartPresheaf p (chartTiltGen Q t tr htr0 htr j₀ e) ⟶
      chartLpR Q t tr htr0 htr j₀ e where
  app S := ModuleCat.ofHom (Ideal.Quotient.mkₐ (PreTilt W p)
    ((chartLIdeal Q t tr htr0 htr j₀ e S.unop.unop).comap (RingHom.id _))).toLinearMap
  naturality {S T} f := by
    haveI hT : CommRing ↥((perfChartPresheaf p (chartTiltGen Q t tr htr0 htr j₀ e)).obj T) :=
      inferInstanceAs (CommRing ↥(tiltChart Q t tr htr0 htr j₀ e T.unop.unop))
    haveI hS : CommRing ↥((perfChartPresheaf p (chartTiltGen Q t tr htr0 htr j₀ e)).obj S) :=
      inferInstanceAs (CommRing ↥(tiltChart Q t tr htr0 htr j₀ e S.unop.unop))
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    show Ideal.Quotient.mk _ (((perfChartPresheaf p
        (chartTiltGen Q t tr htr0 htr j₀ e)).map f) x) =
      chartLMap Q t tr htr0 htr j₀ e (leOfHom f.unop.unop) (Ideal.Quotient.mk _ x)
    rw [chartLMap_mk]
    exact congrArg (Ideal.Quotient.mk _) (Subtype.ext rfl)

/-- The component of the quotient map on classes. -/
theorem perfChartToLpR_app_mk (Q : DSMap.PerfectoidData p W) (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ)
    (S : (Finset ι)ᵒᵖᵒᵖ)
    (y : ↥((perfChartPresheaf p (chartTiltGen Q t tr htr0 htr j₀ e)).obj S)) :
    (perfChartToLpR Q t tr htr0 htr j₀ e).app S y = Ideal.Quotient.mk _ y :=
  rfl

/-- The component of the quotient map is surjective. -/
theorem perfChartToLpR_app_surjective (Q : DSMap.PerfectoidData p W) (t : ι → W)
    (tr : ι → ℕ → W) (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k)
    (j₀ : ι) (e : ℕ) (S : (Finset ι)ᵒᵖᵒᵖ) :
    Function.Surjective ((perfChartToLpR Q t tr htr0 htr j₀ e).app S).hom :=
  Ideal.Quotient.mk_surjective

/-- The kernel of the component of the quotient map is `((ϖ♭)^p) · ⊤`. -/
theorem perfChartToLpR_app_ker (Q : DSMap.PerfectoidData p W) (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ)
    (S : (Finset ι)ᵒᵖᵒᵖ) :
    LinearMap.ker ((perfChartToLpR Q t tr htr0 htr j₀ e).app S).hom =
      Ideal.span {(Work.DSM5c.tiltVarpi Q) ^ p} •
        (⊤ : Submodule (PreTilt W p) ↥((perfChartPresheaf p
          (chartTiltGen Q t tr htr0 htr j₀ e)).obj S)) := by
  ext x
  show Ideal.Quotient.mk _ x = 0 ↔ _
  rw [Ideal.Quotient.eq_zero_iff_mem]
  show x ∈ (chartLIdeal Q t tr htr0 htr j₀ e S.unop.unop).comap (RingHom.id _) ↔ _
  rw [Ideal.mem_comap]
  show x ∈ chartLIdeal Q t tr htr0 htr j₀ e S.unop.unop ↔ _
  rw [smul_top_eq_chartLIdeal Q t tr htr0 htr j₀ e S.unop.unop]
  rfl

/-- **The coaugmentation of `Č(chartLpR)`**, defined as the image of the perfected chart
coaugmentation under the quotient map. -/
noncomputable def chartLpRCoaug (Q : DSMap.PerfectoidData p W) (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ) :
    ModuleCat.of (PreTilt W p) (PreTilt W p) ⟶
      ((cechComplexFunctor (chartIdx ι)).obj (chartLpR Q t tr htr0 htr j₀ e)).X 0 :=
  perfChartCoaug p (chartTiltGen Q t tr htr0 htr j₀ e) ≫
    ((cechComplexFunctor (chartIdx ι)).map (perfChartToLpR Q t tr htr0 htr j₀ e)).f 0

end Work.DSM5c.Lp
