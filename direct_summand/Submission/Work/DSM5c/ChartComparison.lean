import Submission.Work.DSM5c.Charts
import Submission.Work.DSPB2.Main

/-!
# DSM5c — the mod-`p` comparison for the perfectoid charts (PB2, 𝕎-level)

This file proves the algebraic input that the whole M5c transport rests on: the **description of the
kernel of Fontaine's theta map modulo `p`**.

Mathlib's `WittVector.fontaineTheta : 𝕎 W♭ →+* W` is surjective, and `PB2`
(`DSMap.Mix.perfectoid_modp_tilt_proved`, proved in `Submission/Work/DSPB2`) says that the induced
map `W ⧸ (p) → W♭ ⧸ (ϖ♭) ^ p` is an isomorphism.  Equivalently, on the Witt-vector level:

  `x ∈ (p) ⊔ ker θ  ↔  constantCoeff x ∈ (ϖ♭) ^ p`.

This is the form in which the comparison is used for the charts: for **any** `W♭`-algebra `φ : W♭ → R`
with `R` perfect of characteristic `p`, the ideal `I := 𝕎R · 𝕎(φ)(ker θ)` generated by the base's
theta-kernel satisfies

  `x ∈ (p) ⊔ I  ↔  constantCoeff x ∈ (φ (ϖ♭) ^ p)`

(`mem_span_p_sup_map_ker_fontaineTheta`), whence
`(untiltOf R φ) ⧸ (p) ≅ R ⧸ (φ (ϖ♭) ^ p)`.

## Contents

* `Work.DSM5c.wittVector_constantCoeff_map` — naturality of `constantCoeff` (a gap in Mathlib);
* `Work.DSM5c.mem_span_p_sup_ker_fontaineTheta` — the base statement;
* `Work.DSM5c.mem_span_p_sup_map_ker_fontaineTheta` — the chart statement;
* `Work.DSM5c.ker_fontaineTheta_image_constantCoeff` — the image of the ideal under
  `constantCoeff` is exactly `(φ (ϖ♭) ^ p)`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

namespace Work.DSM5c

universe a

open WittVector
open DSMap

variable {p : ℕ} [Fact p.Prime] {W : Type a} [CommRing W]

/-- **Naturality of `constantCoeff`** (`x ↦ x.coeff 0`) with respect to `WittVector.map`: a gap in
Mathlib's Witt-vector API.  Both sides are the `0`-th coefficient of the image. -/
theorem wittVector_constantCoeff_map {A B : Type a} [CommRing A] [CommRing B] (f : A →+* B)
    (x : WittVector p A) :
    WittVector.constantCoeff (WittVector.map f x) = f (WittVector.constantCoeff x) := by
  rw [WittVector.constantCoeff_apply, WittVector.constantCoeff_apply, WittVector.map_coeff]

/-- The `0`-th coefficient of a Teichmüller lift is the element itself, in `constantCoeff` form. -/
theorem constantCoeff_teichmuller' {A : Type a} [CommRing A] (r : A) :
    WittVector.constantCoeff (WittVector.teichmuller p r) = r := by
  rw [WittVector.constantCoeff_apply, WittVector.teichmuller_coeff_zero]

/-- `constantCoeff` of the integer `p` vanishes in a ring of characteristic `p`. -/
theorem constantCoeff_p_eq_zero {A : Type a} [CommRing A] [CharP A p] :
    WittVector.constantCoeff (p : WittVector p A) = 0 := by
  rw [map_natCast (WittVector.constantCoeff (p := p) (R := A)) p, CharP.cast_eq_zero]

section Base

variable [Fact ¬IsUnit (p : W)] [IsAdicComplete (Ideal.span {(p : W)}) W]

/-- **The kernel of Fontaine's theta map, modulo `p`.**  For an integral perfectoid ring `W`, an
element `x` of `𝕎 W♭` lies in the ideal generated by `p` and by `ker θ` if and only if its
`constantCoeff` lies in `(ϖ♭) ^ p`.

This is `PB2` (`DSMap.Mix.perfectoid_modp_tilt_proved`) transported to the Witt-vector level: the
quotient of `𝕎 W♭` by that ideal is `W ⧸ (p)`, and `constantCoeff` realizes the mod-`p` tilt
identification `W ⧸ (p) ≅ W♭ ⧸ (ϖ♭) ^ p`. -/
theorem mem_span_p_sup_ker_fontaineTheta (Q : PerfectoidData p W)
    (hθ : Function.Surjective (WittVector.fontaineTheta (p := p) (R := W)))
    (x : WittVector p (PreTilt W p)) :
    x ∈ Ideal.span {(p : WittVector p (PreTilt W p))} ⊔
        RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) ↔
      WittVector.constantCoeff x ∈ Ideal.span {tiltVarpi Q ^ p} := by
  have hϖ : PreTilt.untilt (tiltVarpi Q) = Q.ϖ 0 := by
    rw [tiltVarpi_eq_varpiTilt]
    exact Work.DSPB1.varpiTilt_untilt Q
  -- an element of `ker θ` has its `0`-th coefficient in `(ϖ♭) ^ p`
  have hker : ∀ y : WittVector p (PreTilt W p),
      WittVector.fontaineTheta (p := p) (R := W) y = 0 →
        WittVector.constantCoeff y ∈ Ideal.span {tiltVarpi Q ^ p} := by
    intro y hy
    have h0 : PreTilt.coeff 0 (y.coeff 0) = 0 := by
      have hmk := WittVector.mk_fontaineTheta (p := p) (R := W) y
      rw [hy, map_zero] at hmk
      exact hmk.symm
    have := Work.DSPB2.mem_span_varpi_pow_of_coeff_zero_eq_zero p W Q (tiltVarpi Q)
      (y.coeff 0) hϖ h0
    simpa [WittVector.constantCoeff_apply] using this
  -- conversely, an element of `(p)` has vanishing `constantCoeff`
  have hmem_p : ∀ y : WittVector p (PreTilt W p),
      y ∈ Ideal.span {(p : WittVector p (PreTilt W p))} →
        WittVector.constantCoeff y = 0 := by
    intro y hy
    rw [WittVector.constantCoeff_apply]
    exact (WittVector.mem_span_p_iff_coeff_zero_eq_zero y).mp hy
  constructor
  · intro hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add, hmem_p a ha, zero_add]
    exact hker b (RingHom.mem_ker.mp hb)
  · intro hx
    -- `constantCoeff x = (ϖ♭)^p * b`
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hx
    -- `[ϖ♭^p] ∈ (p) ⊔ ker θ`
    obtain ⟨v, hv⟩ := Q.unit
    have hξ : WittVector.teichmuller p (tiltVarpi Q) ^ p ∈
        Ideal.span {(p : WittVector p (PreTilt W p))} ⊔
          RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) := by
      obtain ⟨z, hz⟩ := hθ (v : W)
      have hθtel : WittVector.fontaineTheta (p := p) (R := W)
          (WittVector.teichmuller p (tiltVarpi Q) ^ p) = (p : W) * (v : W) := by
        rw [map_pow, WittVector.fontaineTheta_teichmuller, hϖ, hv]
      have hθpz : WittVector.fontaineTheta (p := p) (R := W)
          ((p : WittVector p (PreTilt W p)) * z) = (p : W) * (v : W) := by
        rw [map_mul, hz, map_natCast]
      refine Submodule.mem_sup.mpr ⟨(p : WittVector p (PreTilt W p)) * z,
        Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _),
        WittVector.teichmuller p (tiltVarpi Q) ^ p - (p : WittVector p (PreTilt W p)) * z,
        RingHom.mem_ker.mpr (by rw [map_sub, hθtel, hθpz, sub_self]), by abel⟩
    -- `x - [constantCoeff x] ∈ (p)`
    have hdiff : x - WittVector.teichmuller p (WittVector.constantCoeff x) ∈
        Ideal.span {(p : WittVector p (PreTilt W p))} ⊔
          RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) := by
      refine Submodule.mem_sup.mpr ⟨x - WittVector.teichmuller p (WittVector.constantCoeff x),
        ?_, 0, Submodule.zero_mem _, by simp⟩
      have : x - WittVector.teichmuller p (WittVector.constantCoeff x) ∈
          Ideal.span {(p : WittVector p (PreTilt W p))} := by
        rw [← WittVector.ker_constantCoeff]
        rw [RingHom.mem_ker, map_sub, constantCoeff_teichmuller', sub_self]
      exact this
    have hte : WittVector.teichmuller p (WittVector.constantCoeff x) =
        WittVector.teichmuller p (tiltVarpi Q) ^ p * WittVector.teichmuller p b := by
      rw [hb, map_mul, map_pow]
    have h2 : WittVector.teichmuller p (WittVector.constantCoeff x) ∈
        Ideal.span {(p : WittVector p (PreTilt W p))} ⊔
          RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) := by
      rw [hte]
      exact Ideal.mul_mem_right _ _ hξ
    have hx' : x = (x - WittVector.teichmuller p (WittVector.constantCoeff x)) +
        WittVector.teichmuller p (WittVector.constantCoeff x) := by abel
    obtain ⟨a₁, ha₁, b₁, hb₁, hab₁⟩ := Submodule.mem_sup.mp hdiff
    obtain ⟨a₂, ha₂, b₂, hb₂, hab₂⟩ := Submodule.mem_sup.mp h2
    rw [hx']
    refine Submodule.mem_sup.mpr ⟨a₁ + a₂, Ideal.add_mem _ ha₁ ha₂, b₁ + b₂,
      Ideal.add_mem _ hb₁ hb₂, ?_⟩
    rw [← hab₁, ← hab₂]
    abel

end Base

/-! ## The chart level

For a `W♭`-algebra `φ : W♭ →+* R` with `R` perfect of characteristic `p`, the same description holds
for the ideal generated by the *base's* theta-kernel inside `𝕎 R`:
`x ∈ (p) ⊔ 𝕎R · 𝕎(φ)(ker θ) ↔ constantCoeff x ∈ (φ (ϖ♭) ^ p)`.

This is the form in which the comparison is consumed: taking `R = R_S` the perfected tilted chart and
`φ = φ_S`, it identifies the mod-`p` reduction of the untilt `D_S = untiltOf R_S φ_S` with
`R_S ⧸ (φ_S (ϖ♭) ^ p)`. -/

section Chart

variable [Fact ¬IsUnit (p : W)] [IsAdicComplete (Ideal.span {(p : W)}) W]
variable {R : Type a} [CommRing R] [CharP R p] [PerfectRing R p]

/-- **The chart-level description of the theta-kernel modulo `p`.** -/
theorem mem_span_p_sup_map_ker_fontaineTheta (Q : PerfectoidData p W)
    (hθ : Function.Surjective (WittVector.fontaineTheta (p := p) (R := W)))
    (φ : PreTilt W p →+* R) (x : WittVector p R) :
    x ∈ Ideal.span {(p : WittVector p R)} ⊔
        Ideal.span ((WittVector.map φ) ''
          ((RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) :
            Set (WittVector p (PreTilt W p))))) ↔
      WittVector.constantCoeff x ∈ Ideal.span {φ (tiltVarpi Q) ^ p} := by
  classical
  set J : Ideal (WittVector p R) :=
    Ideal.span ((WittVector.map φ) ''
      ((RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) :
        Set (WittVector p (PreTilt W p))))) with hJ
  -- generators of `J` have `constantCoeff` in `(φ (ϖ♭) ^ p)`
  have hgen : ∀ k ∈ RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)),
      WittVector.constantCoeff (WittVector.map φ k) ∈ Ideal.span {φ (tiltVarpi Q) ^ p} := by
    intro k hk
    rw [wittVector_constantCoeff_map]
    have hk' : k ∈ Ideal.span {(p : WittVector p (PreTilt W p))} ⊔
        RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) :=
      Submodule.mem_sup.mpr ⟨0, Submodule.zero_mem _, k, hk, by simp⟩
    have hmem := (mem_span_p_sup_ker_fontaineTheta (W := W) Q hθ k).mp hk'
    exact Ideal.mem_span_singleton'.mpr (by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
      exact ⟨φ c, by rw [← map_pow, ← map_mul, hc]⟩)
  have hJle : J ≤ Ideal.comap (WittVector.constantCoeff (p := p) (R := R))
      (Ideal.span {φ (tiltVarpi Q) ^ p}) := by
    rw [hJ]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨k, hk, rfl⟩
    exact hgen k hk
  -- an element of `(p)` has vanishing `constantCoeff`
  have hmem_p : ∀ y : WittVector p R, y ∈ Ideal.span {(p : WittVector p R)} →
      WittVector.constantCoeff y = 0 := by
    intro y hy
    rw [WittVector.constantCoeff_apply]
    exact (WittVector.mem_span_p_iff_coeff_zero_eq_zero y).mp hy
  constructor
  · intro hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add, hmem_p a ha, zero_add]
    exact hJle hb
  · intro hx
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hx
    -- `[ϖ♭^p] ∈ (p) ⊔ 𝕎W♭·ker θ`
    have hξ : WittVector.teichmuller p (tiltVarpi Q ^ p) ∈
        Ideal.span {(p : WittVector p (PreTilt W p))} ⊔
          RingHom.ker (WittVector.fontaineTheta (p := p) (R := W)) := by
      have : WittVector.constantCoeff (WittVector.teichmuller p (tiltVarpi Q ^ p)) ∈
          Ideal.span {tiltVarpi Q ^ p} := by
        rw [constantCoeff_teichmuller']
        exact Ideal.mem_span_singleton_self _
      exact (mem_span_p_sup_ker_fontaineTheta (W := W) Q hθ _).mpr this
    obtain ⟨a, ha, k, hk, hak⟩ := Submodule.mem_sup.mp hξ
    -- `𝕎(φ) [ϖ♭^p] = p · 𝕎(φ) a + 𝕎(φ) k ∈ (p) ⊔ J`
    have hmap : WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) ∈
        Ideal.span {(p : WittVector p R)} ⊔ J := by
      have h1 : WittVector.map φ a ∈ Ideal.span {(p : WittVector p R)} := by
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp ha
        rw [hc, map_mul, map_natCast]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      have h2 : WittVector.map φ k ∈ J := by
        rw [hJ]
        exact Ideal.subset_span ⟨k, hk, rfl⟩
      have hsum : WittVector.map φ a + WittVector.map φ k =
          WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) := by
        rw [← map_add, hak]
      exact Submodule.mem_sup.mpr ⟨_, h1, _, h2, hsum⟩
    -- `w := 𝕎(φ)[ϖ♭^p] · [b]` lies in `(p) ⊔ J` and has the same `constantCoeff` as `x`
    have hw : WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) *
        WittVector.teichmuller p b ∈ Ideal.span {(p : WittVector p R)} ⊔ J :=
      Ideal.mul_mem_right _ _ hmap
    have hccw : WittVector.constantCoeff (WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) *
        WittVector.teichmuller p b) = WittVector.constantCoeff x := by
      rw [map_mul, wittVector_constantCoeff_map, constantCoeff_teichmuller',
        constantCoeff_teichmuller', map_pow, mul_comm (φ (tiltVarpi Q) ^ p) b]
      exact hb
    have hdiff : x - WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) *
        WittVector.teichmuller p b ∈ Ideal.span {(p : WittVector p R)} := by
      rw [← WittVector.ker_constantCoeff, RingHom.mem_ker, map_sub, hccw, sub_self]
    have hdiff' : x - WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) *
        WittVector.teichmuller p b ∈ Ideal.span {(p : WittVector p R)} ⊔ J :=
      (show Ideal.span {(p : WittVector p R)} ≤ Ideal.span {(p : WittVector p R)} ⊔ J from
        le_sup_left) hdiff
    obtain ⟨a₁, ha₁, b₁, hb₁, hab₁⟩ := Submodule.mem_sup.mp hdiff'
    obtain ⟨a₂, ha₂, b₂, hb₂, hab₂⟩ := Submodule.mem_sup.mp hw
    refine Submodule.mem_sup.mpr ⟨a₁ + a₂, Ideal.add_mem _ ha₁ ha₂, b₁ + b₂,
      Ideal.add_mem _ hb₁ hb₂, ?_⟩
    calc (a₁ + a₂) + (b₁ + b₂) = (a₁ + b₁) + (a₂ + b₂) := by abel
      _ = (x - WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) *
            WittVector.teichmuller p b) +
          WittVector.map φ (WittVector.teichmuller p (tiltVarpi Q ^ p)) *
            WittVector.teichmuller p b := by rw [hab₁, hab₂]
      _ = x := by abel

end Chart

end Work.DSM5c
