import Mathlib
import Submission.Work.DSMap.Mix2
import Submission.Work.DSM5b.perfChartRing_pow_p_mem_iff
import Submission.Work.DSM5b.frobenius_injective_away

/-!
# Perfectness of the perfected chart rings `R[J/t_S]^{perf}` (M5c, chart layer)

Let `R` be a commutative ring of characteristic the prime `p` which is *perfect* (Frobenius
`x ↦ x ^ p` is bijective), `t : ι → R` a family and `S : Finset ι`.  With `J = (t_i)` and
`t_S = ∏_{i ∈ S} t_i`, the **perfected chart ring** `R[J/t_S]^{perf}` is the `R`-subalgebra of
`R_{t_S} = Localization.Away (t_S)` generated by all `x` with `x ^ (p ^ e) ∈ chartRing t S` for
some `e`; it is the `R`-algebra of the chart `⋂_{i ∈ S} D₊(t_i T)` of `Bl_J(Spec R)` after
perfection (`DSMap.Mix2.perfChartRing`).

The main theorem of this file is that this subalgebra is again perfect for the same prime `p`:

* the `p`-th power map is **injective** there because the ambient localisation `R_{t_S}` is reduced
  (`Work.DSM5b.frobenius_injective_away`);
* it is **surjective** because every element of the perfected chart has a `p`-th root *in the
  ambient localisation* (`Work.DSM5b.perfChartRing_pow_p_mem_iff` turns such a root back into an
  element of the chart).

The one algebraic input which Mathlib does not yet have is that a localisation `R[1/f]` of a perfect
ring of characteristic `p` is again perfect; `away_pow_surjective` below supplies the missing
surjectivity of Frobenius on such a localisation (the injectivity companion is
`Work.DSM5b.frobenius_injective_away`).

Route for `away_pow_surjective`: let `σ := (frobeniusEquiv R p).symm : R ≃+* R` be a choice of
`p`-th roots.  The composite `R → R[1/f]`, `r ↦ algebraMap (σ r)`, sends `f` to an element whose
`p`-th power is `algebraMap f`, hence to a *unit* (a `p`-th root of a unit is a unit), so the
universal property of the localisation (`IsLocalization.Away.lift`) extends it to a ring
endomorphism `ψ` of `R[1/f]`.  The ring endomorphism `z ↦ z ^ p` of `R[1/f]` exists because
`(p : R[1/f]) = 0` (Freshman's dream), and it agrees with the identity after `ψ` on `algebraMap R`,
so `powHom.comp ψ = RingHom.id` by `IsLocalization.ringHom_ext`.  Hence `ψ y` is a `p`-th root of
`y`.  Only `(p : R[1/f]) = 0` is used, never a `CharP` instance on the localisation: this is what
makes the argument work for every `f`, including `f = 0`, where the localisation is trivial.
-/

namespace Work.DSM5c.Charts

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2

universe a

/-- **A localisation of a perfect ring of characteristic `p` has `p`-th roots**: for every
`y : Localization.Away f` there is `x : Localization.Away f` with `x ^ p = y`, i.e. the `p`-th power
map is surjective on `R[1/f]`.  (Note that no `ExpChar`/`CharP` instance is available on the
localisation `R[1/f]`, so this cannot be phrased as `Surjective (frobenius _ p)`.) -/
theorem away_pow_surjective_of_perfect (p : ℕ) [Fact p.Prime] {R : Type a} [CommRing R]
    [CharP R p] [PerfectRing R p] (f : R) (y : Localization.Away f) :
    ∃ x : Localization.Away f, x ^ p = y := by
  have hp : p.Prime := Fact.out
  -- `p = 0` in the localisation
  have hp0 : (p : Localization.Away f) = 0 := by
    rw [← map_natCast (algebraMap R (Localization.Away f)) p, CharP.cast_eq_zero R p, map_zero]
  -- the `p`-th power map is a ring endomorphism of the localisation (Freshman's dream)
  let powHom : Localization.Away f →+* Localization.Away f :=
    { toFun := fun z => z ^ p
      map_one' := one_pow p
      map_mul' := fun a b => mul_pow a b p
      map_zero' := zero_pow hp.pos.ne'
      map_add' := fun a b => by
        rw [add_pow_prime_eq hp a b, hp0]
        ring }
  -- a choice of `p`-th roots in `R`
  let σ : R →+* R := (frobeniusEquiv R p).symm.toRingHom
  have hσ : ∀ r : R, σ r ^ p = r := fun r => frobeniusEquiv_symm_pow_p R p r
  -- ... whose composite with `algebraMap` sends `f` to a unit
  have hgunit : IsUnit (((algebraMap R (Localization.Away f)).comp σ) f) := by
    have h1 : (((algebraMap R (Localization.Away f)).comp σ) f) ^ p =
        algebraMap R (Localization.Away f) f := by
      rw [RingHom.comp_apply, ← map_pow, hσ]
    have h2 : IsUnit ((((algebraMap R (Localization.Away f)).comp σ) f) ^ p) := by
      rw [h1]
      exact IsLocalization.Away.algebraMap_isUnit f
    exact (isUnit_pow_iff (M := Localization.Away f) hp.ne_zero).mp h2
  -- so it extends to a ring endomorphism `ψ` of the localisation
  let ψ : Localization.Away f →+* Localization.Away f :=
    IsLocalization.Away.lift (S := Localization.Away f) (P := Localization.Away f) f
      (g := (algebraMap R (Localization.Away f)).comp σ) hgunit
  have hψ : ∀ r : R, (ψ (algebraMap R (Localization.Away f) r)) ^ p =
      algebraMap R (Localization.Away f) r := by
    intro r
    have h := IsLocalization.Away.lift_eq (S := Localization.Away f) (P := Localization.Away f) f
      (g := (algebraMap R (Localization.Away f)).comp σ) hgunit r
    rw [h, RingHom.comp_apply, ← map_pow, hσ]
  -- `ψ` is a section of the `p`-th power map
  have hΦ : powHom.comp ψ = RingHom.id (Localization.Away f) := by
    refine IsLocalization.ringHom_ext (Submonoid.powers f) ?_
    ext r
    show (ψ (algebraMap R (Localization.Away f) r)) ^ p = algebraMap R (Localization.Away f) r
    exact hψ r
  exact ⟨ψ y, congrFun (congrArg DFunLike.coe hΦ) y⟩

/-- **The perfected chart rings are perfect.**  For `R` perfect of characteristic the prime `p`,
the `R`-subalgebra `perfChartRing p t S ⊆ R_{t_S}` (the perfection of the blowup chart
`chartRing t S = R[J/t_S]`, `J = (t_i)`) is again a perfect ring for the same prime `p`. -/
theorem perfChartRing_perfect (p : ℕ) [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p]
    [PerfectRing R p] {ι : Type a} [DecidableEq ι] (t : ι → R) (S : Finset ι) :
    PerfectRing (perfChartRing p t S) p := by
  refine ⟨⟨?_, ?_⟩⟩
  · -- injectivity: the ambient localisation is reduced
    intro x y h
    apply Subtype.ext
    exact Work.DSM5b.frobenius_injective_away p (tS t S)
      (by simpa using congrArg Subtype.val h)
  · -- surjectivity: take a `p`-th root in the localisation, then use that the chart is closed
    -- under `p`-th roots
    intro y
    obtain ⟨x, hx⟩ := away_pow_surjective_of_perfect p (tS t S) (y : Localization.Away (tS t S))
    refine ⟨⟨x, ?_⟩, Subtype.ext ?_⟩
    · exact (Work.DSM5b.perfChartRing_pow_p_mem_iff p t S x).mp (by rw [hx]; exact y.2)
    · exact hx

end Work.DSM5c.Charts
