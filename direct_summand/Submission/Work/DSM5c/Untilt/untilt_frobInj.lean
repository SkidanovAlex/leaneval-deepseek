import Mathlib
import Submission.Work.DSM5c.Untilt.Basic
import Submission.Work.DSM5c.Untilt.untilt_quot_p_equiv

/-!
# Frobenius injectivity mod `p` for the untilt

For `R` a perfect ring of characteristic `p` and `w ∈ R`, the untilt
`untilt p R w = 𝕎 R ⧸ (ξ)`, `ξ = [w] - p`, has mod-`p` Frobenius injectivity:

  `y ^ p ∈ (p)  →  y ∈ (ϖ)`,   `ϖ = ♯ (w ^ (1/p))`,

i.e. the field `frobInj` of `PerfectoidData p (untilt p R w)` (with `ϖ = ♯(w^(1/p))`, whose `p`-th
power is `♯ w = p`).

## The argument

The whole discussion takes place in the Witt ring `𝕎 R`, where no quotient by `ξ` is involved.
Write `t := (frobeniusEquiv R p).symm w`, so `t ^ p = w`; then `[t] ^ p = [w] = ξ + p`, and the
ideal generated by `ξ` and `p` is the same as the ideal generated by `[w]` and `p`
(`span_xi_sup_span_p_eq`).

Let `Y ∈ 𝕎 R` lift `y`.  From `y ^ p ∈ (p)` we get `mk (Y ^ p) = mk p · b`, i.e.
`Y ^ p - p · B ∈ (ξ)` for a lift `B` of `b`.  Writing `Y ^ p = ξ · e + p · B` and applying the
constant coefficient homomorphism `cc : 𝕎 R → R` (whose kernel is `(p)`, and which sends `ξ` to
`w`) yields

  `s ^ p = w · cc e`,   `s := cc Y`,

so `s ^ p ∈ (w) = (t ^ p)`.  Since in a perfect ring `p`-th powers are inverted by *taking* `p`-th
roots — `x ↦ x ^ p` is a bijection, hence `s ^ p = t ^ p · c` gives `s = t · c ^ (1/p)` — we get
`s ∈ (t)`, say `s = t · d`.  Lifting `d` to `D ∈ 𝕎 R` gives `Y - [t] · D ∈ ker cc = (p)`, so
`Y = [t] · D + p · E`, and reducing modulo `ξ` (where `mk p = mk [w] = (mk [t]) ^ p`) exhibits `y`
as an element of `(mk [t])`.  No reducedness, no domain hypothesis and no `w`-adic completeness of
`R` is used: the only input is that Frobenius is a *bijection* of the perfect ring `R`.
-/

set_option linter.unusedSectionVars false

namespace Work.DSM5c.Untilt

universe a

open WittVector

variable {p : ℕ} [Fact p.Prime] {R : Type a} [CommRing R] [CharP R p] [PerfectRing R p]

/-- **`p`-th roots in a perfect ring.**  If `s ^ p ∈ (t ^ p)`, say `s ^ p = t ^ p · c`, then taking
`p`-th roots of both sides (`x ↦ x ^ p` is a bijection of `R`) gives `s = t · c ^ (1/p) ∈ (t)`. -/
theorem mem_span_singleton_of_pow_mem_pow {t s : R} (h : s ^ p ∈ Ideal.span {t ^ p}) :
    s ∈ Ideal.span {t} := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp h
  obtain ⟨d, hd⟩ := (PerfectRing.bijective_frobenius (p := p) (R := R)).2 c
  have hd' : d ^ p = c := hd
  refine Ideal.mem_span_singleton.mpr ⟨d, ?_⟩
  have hsd : s ^ p = (t * d) ^ p := by rw [mul_pow, hd', hc]
  exact (PerfectRing.bijective_frobenius (p := p) (R := R)).1 hsd

/-- `ξ = [w] - p` and `[w]` generate the same ideal modulo `p`: the ideals `(ξ) + (p)` and
`([w]) + (p)` of `𝕎 R` coincide. -/
theorem span_xi_sup_span_p_eq (w : R) :
    Ideal.span {Work.DSM5c.xi p R w} ⊔ Ideal.span {(p : WittVector p R)} =
      Ideal.span {WittVector.teichmuller p w} ⊔ Ideal.span {(p : WittVector p R)} := by
  apply le_antisymm <;> rw [sup_le_iff]
  · refine ⟨?_, le_sup_right⟩
    rw [Ideal.span_singleton_le_iff_mem,
      show Work.DSM5c.xi p R w = WittVector.teichmuller p w - (p : WittVector p R) from rfl]
    exact sub_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _)))
      (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _)))
  · refine ⟨?_, le_sup_right⟩
    rw [Ideal.span_singleton_le_iff_mem,
      show WittVector.teichmuller p w = Work.DSM5c.xi p R w + (p : WittVector p R) from by
        rw [Work.DSM5c.xi]; abel]
    exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _)))
      (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _)))

/-- **Frobenius injectivity mod `p` for the untilt.**  If `y ^ p` is divisible by `p` in the untilt
`untilt p R w`, then `y` is divisible by the image of `♯ (w ^ (1/p))` (whose `p`-th power is the
image of `♯ w = p`). -/
theorem untilt_frobInj (p : ℕ) [Fact p.Prime] (R : Type a) [CommRing R] [CharP R p] [PerfectRing R p] (w : R) (y : Work.DSM5c.untilt p R w) (hy : y ^ p ∈ Ideal.span {(p : Work.DSM5c.untilt p R w)}) :
    y ∈ Ideal.span {Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) (WittVector.teichmuller p ((⇑(frobeniusEquiv R p).symm) w))} := by
  classical
  set t : R := (⇑(frobeniusEquiv R p).symm) w with ht
  -- `t` is a `p`-th root of `w`
  have htw : t ^ p = w := by
    rw [ht, ← _root_.frobenius_def, ← _root_.frobeniusEquiv_apply,
      RingEquiv.apply_symm_apply]
  -- `p = ♯ w` holds in the untilt
  have hpmk : (p : Work.DSM5c.untilt p R w) =
      Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) (p : WittVector p R) :=
    (map_natCast (Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w})) p).symm
  obtain ⟨Y, rfl⟩ := Ideal.Quotient.mk_surjective y
  -- the hypothesis, transported to `𝕎 R`
  have hmem : (Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) Y) ^ p ∈
      Ideal.span {Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) (p : WittVector p R)} := by
    rw [← hpmk]
    exact hy
  -- write `Y ^ p = ξ * e + p * B` modulo `ξ`
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hmem
  obtain ⟨B, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hker : Y ^ p - (p : WittVector p R) * B ∈
      Ideal.span {Work.DSM5c.xi p R w} := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow, hb, sub_self]
  obtain ⟨e, he⟩ := Ideal.mem_span_singleton.mp hker
  have heq : Y ^ p = Work.DSM5c.xi p R w * e + (p : WittVector p R) * B := by
    rw [← he]; ring
  -- constant coefficients: `(cc Y) ^ p = w * cc e`, i.e. `(cc Y) ^ p ∈ (w) = (t ^ p)`
  have hcc : WittVector.constantCoeff (Y ^ p) = w * WittVector.constantCoeff e := by
    rw [heq, map_add, map_mul, map_mul, Work.DSM5c.constantCoeff_xi, constantCoeff_p,
      zero_mul, add_zero]
  have hs : (WittVector.constantCoeff Y) ^ p ∈ Ideal.span {t ^ p} := by
    rw [htw, ← map_pow, hcc]
    exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
  -- take `p`-th roots in the perfect ring `R`: `cc Y = t * d`
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp (mem_span_singleton_of_pow_mem_pow hs)
  -- lift `d` to `𝕎 R` and conclude `Y = [t] * D + p * E`
  obtain ⟨D, hD⟩ := WittVector.constantCoeff_surjective p (R := R) d
  have hker2 : Y - WittVector.teichmuller p t * D ∈ Ideal.span {(p : WittVector p R)} := by
    rw [← WittVector.ker_constantCoeff (p := p) (k := R), RingHom.mem_ker, map_sub, map_mul,
      constantCoeff_teichmuller, hD, hd, sub_self]
  obtain ⟨E, hE⟩ := Ideal.mem_span_singleton.mp hker2
  have hYeq : Y = WittVector.teichmuller p t * D + (p : WittVector p R) * E := by
    rw [← hE]; ring
  -- reduce modulo `ξ`, where `mk p = mk [w] = (mk [t]) ^ p`
  rw [hYeq, map_add, map_mul, map_mul]
  refine add_mem (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))) ?_
  have h1 : Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) (p : WittVector p R) =
      (Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w})
        (WittVector.teichmuller p t)) ^ p := by
    have hteich : WittVector.teichmuller p w = (WittVector.teichmuller p t) ^ p := by
      rw [← htw, map_pow]
    have hp_eq : Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) (p : WittVector p R) =
        Ideal.Quotient.mk (Ideal.span {Work.DSM5c.xi p R w}) (WittVector.teichmuller p w) := by
      have h := Untilt.mk_p_eq_mk_teichmuller (p := p) (R := R) w
      simpa only [Untilt.mk] using h
    rw [hp_eq, hteich, map_pow]
  rw [h1]
  exact Ideal.mul_mem_right _ _
    (Ideal.pow_mem_of_mem _ (Ideal.subset_span (Set.mem_singleton _)) p
      (Fact.out : p.Prime).pos)

end Work.DSM5c.Untilt
