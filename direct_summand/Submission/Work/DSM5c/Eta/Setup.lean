import Mathlib
import Submission.Work.DSM5c.ChartFunctor
import Submission.Work.DSM5c.ChartLp
import Submission.Work.DSPB2.Main

/-!
# DSM5c / Eta — setup for the chart map `η : chartPresheaf t ⟶ Dp`

This file fixes the vocabulary of the construction of the chart map of the M5c node (gap G1 of
`Submission/Work/DSM5c/NOTES.md` §20.3).  Write `A_S := chartRing t S ⊆ W_{t_S}` for the honest
chart ring and `D_S := untiltOf (tiltChart Q t tr … S) (chartPhi … S)` for the chart untilt.  The
construction goes through the localisation of `D_S` at the element

  `vS S := untiltOf.algebraMap hθ (chartPhi … S) (tS t S)`

(the image of the chart denominator `t_S = ∏_{i ∈ S} t_i ∈ W`), because the honest chart ring
`A_S ⊆ W_{t_S}` is generated by the fractions `t_k/t_i` and the localisation map `W_{t_S} →+* D_S`
does not exist (the `t_i` are not units in `D_S`); the localisation `W_{t_S} → D_S[1/v_S]` exists
because `♯(u_S)` is inverted there, and its image on `A_S` lands in the image of `D_S → D_S[1/v_S]`.

## Contents

* `Work.DSM5c.Eta.DS` — the chart untilt `D_S`;
* `Work.DSM5c.Eta.vS`, `Work.DSM5c.Eta.DSloc` — the localisation element and the localisation;
* `Work.DSM5c.Eta.teich` — the Teichmüller/`♯` map `R_S → D_S`;
* `Work.DSM5c.Eta.gLoc` — the localisation map `W_{t_S} →+* D_S[1/v_S]`;
* `Work.DSM5c.Eta.locD` — the localisation map `D_S →+* D_S[1/v_S]`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

namespace Work.DSM5c.Eta

open CategoryTheory DSMap DSMap.Mix DSMap.Mix2

universe a

section Setup

variable {p : ℕ} [Fact p.Prime] {W : Type a} [CommRing W] [Fact ¬IsUnit (p : W)]
  [IsAdicComplete (Ideal.span {(p : W)}) W] {ι : Type a} [DecidableEq ι]
  (Q : PerfectoidData p W)
  (hθ : Function.Surjective (WittVector.fontaineTheta (p := p) (R := W)))
  (t : ι → W) (tr : ι → ℕ → W) (htr0 : ∀ i, tr i 0 = t i)
  (htr : ∀ i k, tr i (k + 1) ^ p = tr i k) (j₀ : ι) (e : ℕ)

/-- **The perfected tilted chart** `R_S` of the M5c data, as a bundled type. -/
abbrev tiltChart' (S : Finset ι) : Type a := ↥(tiltChart Q t tr htr0 htr j₀ e S)

/-- **The chart untilt** `D_S = untiltOf R_S φ_S`. -/
abbrev DS (S : Finset ι) : Type a :=
  untiltOf (tiltChart Q t tr htr0 htr j₀ e S) (chartPhi Q t tr htr0 htr j₀ e S)

/-- The `W`-algebra structure of `D_S` (`Work.DSM5c.chartDAlg`). -/
noncomputable def DSalg (S : Finset ι) : Algebra W (DS Q t tr htr0 htr j₀ e S) :=
  chartDAlg Q hθ t tr htr0 htr j₀ e S

/-- **The localisation element** `v_S = ♯(u_S)` of the chart untilt `D_S`: the image of the honest
chart denominator `t_S = ∏_{i ∈ S} t_i ∈ W`. -/
noncomputable def vS (S : Finset ι) : DS Q t tr htr0 htr j₀ e S :=
  untiltOf.algebraMap hθ (chartPhi Q t tr htr0 htr j₀ e S) (tS t S)

/-- **The localisation `D_S[1/v_S]`** of the chart untilt. -/
abbrev DSloc (S : Finset ι) : Type a :=
  Localization.Away (vS Q hθ t tr htr0 htr j₀ e S)

/-- The `W`-algebra structure of `D_S[1/v_S]`, transported from `D_S`. -/
noncomputable def DSlocAlg (S : Finset ι) : Algebra W (DSloc Q hθ t tr htr0 htr j₀ e S) :=
  letI := DSalg Q hθ t tr htr0 htr j₀ e S
  ((algebraMap (DS Q t tr htr0 htr j₀ e S)
      (DSloc Q hθ t tr htr0 htr j₀ e S)).comp
    (algebraMap W (DS Q t tr htr0 htr j₀ e S))).toAlgebra

/-- The localisation map `D_S →+* D_S[1/v_S]`. -/
noncomputable def locD (S : Finset ι) :
    DS Q t tr htr0 htr j₀ e S →+* DSloc Q hθ t tr htr0 htr j₀ e S :=
  algebraMap _ _

/-- **The `♯`/Teichmüller map** on the perfected tilted chart: `y ↦ [y] mod I_S`.  It is only
multiplicative (Teichmüller is not additive), hence not a `RingHom`. -/
noncomputable def teich (S : Finset ι) :
    tiltChart' Q t tr htr0 htr j₀ e S → DS Q t tr htr0 htr j₀ e S :=
  fun y => untiltOf.mk (chartPhi Q t tr htr0 htr j₀ e S) (WittVector.teichmuller p y)

/-- The unit `u_i` inside the localisation `W♭_{tS u S}`, for `i ∈ S`. -/
noncomputable def unitU (S : Finset ι) (i : ι) (hi : i ∈ S) :
    (Localization.Away (tS (chartTiltGen Q t tr htr0 htr j₀ e) S))ˣ :=
  (IsLocalization.Away.isUnit_of_dvd (tS (chartTiltGen Q t tr htr0 htr j₀ e) S)
    (Finset.dvd_prod_of_mem (chartTiltGen Q t tr htr0 htr j₀ e) hi)).unit

/-- The defining property of `unitU`. -/
theorem unitU_spec (S : Finset ι) (i : ι) (hi : i ∈ S) :
    ((unitU Q t tr htr0 htr j₀ e S i hi :
        (Localization.Away (tS (chartTiltGen Q t tr htr0 htr j₀ e) S))ˣ) :
      Localization.Away (tS (chartTiltGen Q t tr htr0 htr j₀ e) S)) =
      algebraMap (PreTilt W p) _ (chartTiltGen Q t tr htr0 htr j₀ e i) := by
  rw [unitU]
  exact (IsLocalization.Away.isUnit_of_dvd (tS (chartTiltGen Q t tr htr0 htr j₀ e) S)
    (Finset.dvd_prod_of_mem (chartTiltGen Q t tr htr0 htr j₀ e) hi)).unit_spec

/-- **The tilted chart fraction** `u_k/u_i ∈ R_S` (`u = chartTiltGen Q t tr htr0 htr j₀ e`), for
`i ∈ S`: the image in the perfected tilted chart of the localisation fraction
`algebraMap W♭ _ (u k) * (algebraMap W♭ _ (u i))⁻¹` (which is legitimate since `u i ∣ tS u S`). -/
noncomputable def fracU (S : Finset ι) (i k : ι) (hi : i ∈ S) :
    tiltChart' Q t tr htr0 htr j₀ e S :=
  ⟨algebraMap (PreTilt W p) (Localization.Away (tS (chartTiltGen Q t tr htr0 htr j₀ e) S))
      (chartTiltGen Q t tr htr0 htr j₀ e k) * ↑((unitU Q t tr htr0 htr j₀ e S i hi)⁻¹),
    (show (chartRing (chartTiltGen Q t tr htr0 htr j₀ e) S) ≤
        tiltChart Q t tr htr0 htr j₀ e S from
      Algebra.adjoin_mono (fun x hx => ⟨0, by
        have h1 : x ∈ chartRing (chartTiltGen Q t tr htr0 htr j₀ e) S := by
          rw [chartRing]
          exact Algebra.subset_adjoin hx
        simpa only [pow_zero, pow_one] using h1⟩))
      (show _ ∈ chartRing (chartTiltGen Q t tr htr0 htr j₀ e) S from by
        rw [chartRing]
        exact Algebra.subset_adjoin (show _ ∈ chartGens (chartTiltGen Q t tr htr0 htr j₀ e) S from
          ⟨i, hi, k, by rw [mul_assoc, ← unitU_spec Q t tr htr0 htr j₀ e S i hi,
            Units.inv_mul, mul_one]⟩))⟩

/-- The unit `t_i` inside the honest chart localisation `W_{t_S}`, for `i ∈ S`. -/
noncomputable def unitT (S : Finset ι) (i : ι) (hi : i ∈ S) :
    (Localization.Away (tS t S))ˣ :=
  (IsLocalization.Away.isUnit_of_dvd (tS t S) (Finset.dvd_prod_of_mem t hi)).unit

/-- The defining property of `unitT`. -/
theorem unitT_spec (S : Finset ι) (i : ι) (hi : i ∈ S) :
    ((unitT t S i hi : (Localization.Away (tS t S))ˣ) :
      Localization.Away (tS t S)) = algebraMap W _ (t i) := by
  rw [unitT]
  exact (IsLocalization.Away.isUnit_of_dvd (tS t S) (Finset.dvd_prod_of_mem t hi)).unit_spec

/-- **The honest chart fraction** `t_j/t_i ∈ W_{t_S}`, for `i ∈ S`. -/
noncomputable def fracT (S : Finset ι) (i j : ι) (hi : i ∈ S) :
    Localization.Away (tS t S) :=
  algebraMap W _ (t j) * ↑((unitT t S i hi)⁻¹)

/-- The defining property of `fracT`: it satisfies the chart-generator equation. -/
theorem fracT_spec (S : Finset ι) (i j : ι) (hi : i ∈ S) :
    fracT t S i j hi * algebraMap W _ (t i) = algebraMap W _ (t j) := by
  have hu : ((unitT t S i hi : (Localization.Away (tS t S))ˣ) :
      Localization.Away (tS t S)) = algebraMap W _ (t i) := unitT_spec t S i hi
  simp only [fracT, mul_assoc, ← hu, Units.inv_mul, mul_one]

/-- **The localisation map** `W_{t_S} →+* D_S[1/v_S]`: the map from the honest chart localisation
into the localisation of the chart untilt, sending `algebraMap W _ w` to the image of the
`W`-algebra structure of `D_S`.  It exists because `v_S` is (the image of) `algebraMap W _ (tS t S)`
and hence a unit in `D_S[1/v_S]`. -/
noncomputable def gLoc (S : Finset ι) :
    Localization.Away (tS t S) →+* DSloc Q hθ t tr htr0 htr j₀ e S :=
  letI := DSlocAlg Q hθ t tr htr0 htr j₀ e S
  IsLocalization.Away.lift (tS t S) (g := algebraMap W _)
    (by
      have h : algebraMap W (DSloc Q hθ t tr htr0 htr j₀ e S) (tS t S) =
          algebraMap (DS Q t tr htr0 htr j₀ e S)
            (DSloc Q hθ t tr htr0 htr j₀ e S) (vS Q hθ t tr htr0 htr j₀ e S) := rfl
      rw [h]
      exact IsLocalization.Away.algebraMap_isUnit _)

end Setup

end Work.DSM5c.Eta
