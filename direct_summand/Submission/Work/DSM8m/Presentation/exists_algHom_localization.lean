import Mathlib

/-!
# Lifting an `A`-algebra map through a monogenic localization

This is the pure commutative-algebra step of the M8m presentation argument: a map
`φ : B →ₐ[A] L` into a field whose values become polynomial expressions in `θ` after
inverting a fixed `c` factors through the localization `(A[X]/F)[1/c]` of the ring
generated by `θ`, provided `A[X]/F ↪ L` is injective and `F` is monic.

Informally: `Φ₀ : A[X]/F ↪ L` identifies `A[X]/F` with `A[θ] ⊆ L`.  The hypothesis `h`
says that every `φ b` lies in `A[θ][1/c]`, so `φ` factors through the subring
`A[θ][1/c] = image((A[X]/F)[1/c] → L)`.  The only point needing a real argument is that
`c` is invertible in `L`, i.e. that `A → L` is injective: if `a ∈ A` died in `L`, then
`C a ∈ ker(aeval θ) = ker(mk F) = (F)`, and since `F` is monic (and `F ≠ 1`, as
`A[X]/(1) = 0` cannot embed into a field) this forces `a = 0`.

## Main result

* `Work.DSM8m.Presentation.exists_algHom_localization`
-/

open Polynomial

namespace Work.DSM8m.Presentation

theorem exists_algHom_localization {A L : Type*} [CommRing A] [Field L] [Algebra A L]
    {B : Type*} [CommRing B] [Algebra A B] (φ : B →ₐ[A] L) (hφ : Function.Injective φ)
    (F : Polynomial A) (hF : F.Monic) (θ : L) (Φ₀ : AdjoinRoot F →+* L)
    (hΦ₀ : ∀ P : Polynomial A, Φ₀ (AdjoinRoot.mk F P) = Polynomial.aeval θ P)
    (hinj : Function.Injective Φ₀)
    (c : A) (hc : c ≠ 0)
    (h : ∀ b : B, ∃ (n : ℕ) (P : Polynomial A),
      φ b * (algebraMap A L c) ^ n = Polynomial.aeval θ P) :
    ∃ (Ψ : B →ₐ[A] Localization.Away (algebraMap A (AdjoinRoot F) c))
      (Φ : Localization.Away (algebraMap A (AdjoinRoot F) c) →ₐ[A] L),
      Function.Injective Φ ∧ Φ.comp Ψ = φ := by
  -- ## Step 1. `Φ₀` is a map of `A`-algebras.
  have hΦ₀C : ∀ a : A, Φ₀ (algebraMap A (AdjoinRoot F) a) = algebraMap A L a := by
    intro a
    rw [AdjoinRoot.algebraMap_eq, ← AdjoinRoot.mk_C, hΦ₀, Polynomial.aeval_C]
  -- ## Step 2. `F` is not the constant polynomial `1`.
  -- Otherwise `AdjoinRoot F = A[X]/(1) = 0`, which cannot embed into the field `L`.
  have hF1 : F ≠ 1 := by
    intro hF1
    subst hF1
    haveI : Subsingleton (AdjoinRoot (1 : Polynomial A)) := by
      rw [AdjoinRoot, Ideal.Quotient.subsingleton_iff]
      exact Ideal.span_singleton_eq_top.mpr isUnit_one
    have h01 : (0 : L) = 1 := by
      calc (0 : L) = Φ₀ 0 := (map_zero Φ₀).symm
        _ = Φ₀ 1 := congrArg Φ₀ (Subsingleton.elim (0 : AdjoinRoot (1 : Polynomial A)) 1)
        _ = 1 := map_one Φ₀
    exact zero_ne_one h01
  -- ## Step 3. `A → L` is injective.
  -- `C a ∈ ker (aeval θ) = ker (mk F) = (F)`, and a monic `F ≠ 1` divides no nonzero
  -- constant polynomial.
  have hCinj : ∀ a : A, algebraMap A L a = 0 → a = 0 := by
    intro a ha
    have hFpos : 0 < F.natDegree := hF.natDegree_pos.mpr hF1
    have h1 : AdjoinRoot.mk F (Polynomial.C a) = 0 := by
      apply hinj
      rw [hΦ₀, Polynomial.aeval_C, ha, map_zero]
    have h2 : F ∣ Polynomial.C a := by
      have h3 : AdjoinRoot.mk F (Polynomial.C a) = AdjoinRoot.mk F 0 := by rw [h1, map_zero]
      simpa using (AdjoinRoot.mk_eq_mk (f := F)).mp h3
    obtain ⟨G, hG⟩ := h2
    have hG0 : G = 0 := by
      by_contra hGne
      have hle : F.leadingCoeff * G.leadingCoeff ≠ 0 := by
        rw [hF.leadingCoeff, one_mul]
        exact Polynomial.leadingCoeff_ne_zero.mpr hGne
      have hnd := Polynomial.natDegree_mul' (p := F) (q := G) hle
      rw [← hG, Polynomial.natDegree_C] at hnd
      omega
    rw [hG0, mul_zero] at hG
    exact Polynomial.C_eq_zero.mp hG
  have hcL : algebraMap A L c ≠ 0 := fun h0 => hc (hCinj c h0)
  -- ## Step 4. The localized map `Φ : (A[X]/F)[1/c] →ₐ[A] L`.
  let s : AdjoinRoot F := algebraMap A (AdjoinRoot F) c
  let Φ₀a : AdjoinRoot F →ₐ[A] L := AlgHom.mk Φ₀ hΦ₀C
  have hs : Φ₀a s = algebraMap A L c := hΦ₀C c
  have hunit : IsUnit (Φ₀a s) := by rw [hs]; exact isUnit_iff_ne_zero.mpr hcL
  let Φ : Localization.Away s →ₐ[A] L := IsLocalization.Away.liftAlgHom s hunit
  have hΦalg : ∀ y : AdjoinRoot F,
      Φ (algebraMap (AdjoinRoot F) (Localization.Away s) y) = Φ₀ y := by
    intro y
    exact IsLocalization.Away.lift_eq (x := s) hunit y
  -- `Φ` is injective: it is the localization of the injective map `Φ₀` at an element
  -- whose image in the field `L` is nonzero.
  have hΦinj : Function.Injective Φ := by
    intro x y hxy
    have hz : Φ (x - y) = 0 := by rw [map_sub, hxy, sub_self]
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj s (x - y)
    have ha' : Φ (algebraMap (AdjoinRoot F) (Localization.Away s) a) = 0 := by
      rw [← ha, map_mul, hz, zero_mul]
    have ha0 : a = 0 := by
      refine hinj ?_
      rw [← hΦalg a, ha', map_zero]
    rw [ha0, map_zero] at ha
    obtain ⟨u, hu⟩ := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away s) s
    have hxu : (x - y) * ↑u ^ n = 0 := by rw [hu]; exact ha
    have h2 : (x - y) * ↑(u ^ n) = 0 := by simpa using hxu
    have h3 : x - y = 0 := (Units.mul_left_eq_zero (u ^ n)).mp h2
    exact sub_eq_zero.mp h3
  -- ## Step 5. Every `φ b` lies in the image of `Φ`, by the hypothesis `h`.
  have hrange : ∀ b : B, φ b ∈ Set.range (fun t : Localization.Away s => Φ t) := by
    intro b
    obtain ⟨n, P, hb⟩ := h b
    have hy : s ^ n ∈ Submonoid.powers s := ⟨n, rfl⟩
    refine ⟨IsLocalization.mk' (Localization.Away s) (M := Submonoid.powers s)
      (AdjoinRoot.mk F P) ⟨s ^ n, hy⟩, ?_⟩
    have hspec := IsLocalization.mk'_spec (Localization.Away s) (M := Submonoid.powers s)
      (AdjoinRoot.mk F P) ⟨s ^ n, hy⟩
    have hkey := congrArg (fun z => Φ z) hspec
    simp only [map_mul, hΦalg] at hkey
    rw [map_pow, hΦ₀C, hΦ₀] at hkey
    exact mul_right_cancel₀ (pow_ne_zero n hcL) (by rw [hkey, hb])
  -- ## Step 6. Assemble `Ψ` out of the inverse of `Φ` on its image.
  let Ψfun : B → Localization.Away s := fun b => Classical.choose (hrange b)
  have hΨfun : ∀ b : B, Φ (Ψfun b) = φ b := fun b => Classical.choose_spec (hrange b)
  have huniq : ∀ (b : B) (t : Localization.Away s), Φ t = φ b → t = Ψfun b :=
    fun b t ht => hΦinj (by rw [ht, hΨfun])
  let ψ : B →+* Localization.Away s :=
    { toFun := Ψfun
      map_one' := (huniq 1 1 (by rw [map_one, map_one])).symm
      map_mul' := fun a b =>
        (huniq (a * b) (Ψfun a * Ψfun b) (by rw [map_mul, hΨfun, hΨfun, map_mul])).symm
      map_zero' := (huniq 0 0 (by rw [map_zero, map_zero])).symm
      map_add' := fun a b =>
        (huniq (a + b) (Ψfun a + Ψfun b) (by rw [map_add, hΨfun, hΨfun, map_add])).symm }
  let Ψ : B →ₐ[A] Localization.Away s :=
    AlgHom.mk ψ (fun a => by
      show Ψfun (algebraMap A B a) = algebraMap A (Localization.Away s) a
      exact (huniq (algebraMap A B a) (algebraMap A (Localization.Away s) a)
        (by rw [AlgHom.commutes, AlgHom.commutes])).symm)
  exact ⟨Ψ, Φ, hΦinj, AlgHom.ext fun b => hΨfun b⟩

end Work.DSM8m.Presentation
