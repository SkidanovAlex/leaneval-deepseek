import Mathlib

/-!
# `A[θ]` has fraction field `K(θ)` when `K = Frac A`

Let `A` be a commutative ring with fraction field `K`, and `A ⊆ K ⊆ L` a tower of algebras with
`L` a field.  If `L = K[θ]` (i.e. `Algebra.adjoin K {θ} = ⊤`), then the `A`-subalgebra
`A[θ] ⊆ L` generated by `θ` also has `L` as its field of fractions.

Indeed, an element of `L = K[θ]` is `p(θ)` for some `p ∈ K[X]`; each coefficient of `p` is a
fraction of two elements of `A`, and a *single* non-zero-divisor `s ∈ A` clears all denominators
simultaneously (there are only finitely many nonzero coefficients).  Then
`p(θ) = q(θ) / s` with `q ∈ A[X]` and `s ∈ A`.

The elementary clearing-denominators statement is `exists_polynomial_clear_denom`.
-/

namespace Work.DSM8m.Presentation

/-- Clearing denominators of a polynomial over `K = Frac A`: there is a non-zero-divisor
`s ∈ A` and a polynomial `q ∈ A[X]` such that `q` maps to `C s * p` under `A[X] → K[X]`.

This is proved by induction on the polynomial: the constant/monomial case uses
`IsLocalization.surj` for `K = A[(nonZeroDivisors A)⁻¹]`, and the additive case multiplies the
two denominators. -/
lemma exists_polynomial_clear_denom {A K : Type*} [CommRing A] [Field K] [Algebra A K]
    [IsFractionRing A K] (p : Polynomial K) :
    ∃ s : A, s ∈ nonZeroDivisors A ∧
      ∃ q : Polynomial A,
        Polynomial.map (algebraMap A K) q = Polynomial.C (algebraMap A K s) * p := by
  refine Polynomial.induction_on' p ?_ ?_
  · intro p q hp hq
    obtain ⟨s₁, hs₁, q₁, h₁⟩ := hp
    obtain ⟨s₂, hs₂, q₂, h₂⟩ := hq
    refine ⟨s₁ * s₂, mul_mem hs₁ hs₂, Polynomial.C s₂ * q₁ + Polynomial.C s₁ * q₂, ?_⟩
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C]
    rw [h₁, h₂, map_mul, Polynomial.C_mul]
    ring
  · intro n a
    obtain ⟨⟨c, d⟩, hcd⟩ := IsLocalization.surj (nonZeroDivisors A) a
    refine ⟨(d : A), d.2, Polynomial.monomial n c, ?_⟩
    rw [Polynomial.map_monomial, Polynomial.C_mul_monomial, mul_comm (algebraMap A K (d : A)) a,
      hcd]

theorem isFractionRing_adjoin_singleton {A K L : Type*} [CommRing A] [Field K] [Algebra A K]
    [IsFractionRing A K] [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (θ : L) (hθK : Algebra.adjoin K ({θ} : Set L) = ⊤) :
    IsFractionRing (Algebra.adjoin A ({θ} : Set L)) L := by
  refine IsFractionRing.of_field (Algebra.adjoin A ({θ} : Set L)) L ?_
  intro z
  -- `z ∈ K[θ] = ⊤`, hence `z = p(θ)` for some `p ∈ K[X]`
  have hz : z ∈ (Polynomial.aeval (R := K) θ).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval K θ, hθK]
    trivial
  obtain ⟨p, rfl⟩ := hz
  -- clear the denominators of `p` with a single non-zero-divisor `s ∈ A`
  obtain ⟨s, hs, q, hq⟩ := exists_polynomial_clear_denom (A := A) (K := K) p
  have hxB : Polynomial.aeval θ q ∈ Algebra.adjoin A ({θ} : Set L) := by
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨q, rfl⟩
  have hyB : algebraMap A L s ∈ Algebra.adjoin A ({θ} : Set L) :=
    Subalgebra.algebraMap_mem _ s
  refine ⟨⟨Polynomial.aeval θ q, hxB⟩, ⟨algebraMap A L s, hyB⟩, ?_⟩
  -- the denominator `algebraMap A L s` is nonzero
  have hneK : algebraMap A K s ≠ 0 := by
    have hn : Nontrivial A := Module.nontrivial A K
    exact IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
  have hneL : algebraMap A L s ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply A K L]
    exact fun h => hneK (FaithfulSMul.algebraMap_injective K L (by simpa using h))
  -- `q(θ) = p(θ) * algebraMap A L s`
  have key : (Polynomial.aeval θ q : L) = Polynomial.aeval θ p * algebraMap A L s := by
    rw [Polynomial.aeval_eq_aeval_map (IsScalarTower.algebraMap_eq A K L).symm, hq,
      Polynomial.aeval_mul, Polynomial.aeval_C, ← IsScalarTower.algebraMap_apply A K L, mul_comm]
  change Polynomial.aeval θ p = (Polynomial.aeval θ q : L) / (algebraMap A L s : L)
  rw [key, mul_div_cancel_right₀ _ hneL]

end Work.DSM8m.Presentation
