import Mathlib
import Submission.Work.DSM2b.sqZero_descent
import Submission.Work.DSM2b.flat_congr
import Submission.Work.DSM2b.lsmul_lift_injective_quot_pow
import Submission.Work.DSM2b.flat_quot_pow_transport

/-!
# Dévissage: `B ⧸ πB` flat over `R ⧸ π` implies `B ⧸ πⁿB` flat over `R ⧸ πⁿ`

Step (1) of the proof of Bhatt's Proposition 4.1 (`Bhatt, On the direct summand conjecture and its
derived variant`, arXiv:1608.08882; Bhatt–Morrow–Scholze, Lemma 4.30 / Remark 4.31).

Let `R` be a commutative ring, `π ∈ R` a nonzerodivisor, `B` an `R`-algebra on which `π` is a
nonzerodivisor, and suppose `B ⧸ πB` is flat over `R ⧸ π`.  Then `B ⧸ πⁿB` is flat over `R ⧸ πⁿ`
for every `n`.

The proof is a dévissage along the square-zero extensions
`R ⧸ π^{n+1} ↠ R ⧸ πⁿ` (kernel `πⁿ R ⧸ π^{n+1}R`, of square zero):

* `flat_of_flat_mod_sqZero_v2` (`Submission.Work.DSM2b.sqZero_descent`): square-zero descent for
  flatness;
* `lsmul_lift_injective_quot_pow`: in the situation `A = R ⧸ π^{n+1}`, `M = B ⧸ π^{n+1}B`,
  `I = (πⁿ)` the map `I ⊗ M → M` is injective;
* `flat_quot_pow_transport` (using `flat_congr`): transports the induction hypothesis
  `Flat (R ⧸ πⁿ) (B ⧸ πⁿB)` to the form `Flat (A ⧸ I) (M ⧸ I • ⊤)` needed by the descent lemma.

The `n = 0` case is degenerate (`B ⧸ ⊤` is the zero module) and the base case `n = 1` is the
hypothesis transported along `Ideal.quotEquivOfEq`.
-/

open scoped TensorProduct

namespace Work.DSM2b

universe u

/-- A subsingleton module is flat: the only relations are trivial. -/
private lemma flat_of_subsingleton {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    [Subsingleton M] : Module.Flat R M := by
  rw [Module.Flat.iff_forall_isTrivialRelation]
  intro l f x hx
  exact ⟨0, fun _ => Fin.elim0, Fin.elim0, fun i => Subsingleton.elim _ _, fun j => Fin.elim0 j⟩

/-- In `R ⧸ (π ^ (n+1))`, the ideal generated by the class of `π ^ n` has square zero, for
`n ≥ 1`. -/
private lemma sq_span_quot {R : Type u} [CommRing R] (π : R) {n : ℕ} (hn : 1 ≤ n) :
    ((Ideal.span {π ^ n}).map (Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}))) ^ 2 = ⊥ := by
  have h1 : (Ideal.span {π ^ n}).map (Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}))
      = Ideal.span {Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}) (π ^ n)} := by
    rw [Ideal.map_span]
    simp
  rw [h1, Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot, ← map_pow,
    Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, ← pow_mul]
  exact pow_dvd_pow π (by omega)

/-- The `n = 1` base case: flatness of `B ⧸ πB` over `R ⧸ π` transported to `B ⧸ π ^ 1 B` over
`R ⧸ π ^ 1` along the canonical ring and module identifications. -/
private lemma flat_pow_one {R B : Type u} [CommRing R] [CommRing B] [Algebra R B] (π : R)
    (h : Module.Flat (R ⧸ Ideal.span {π}) (B ⧸ (Ideal.span {π}).map (algebraMap R B))) :
    Module.Flat (R ⧸ Ideal.span {π ^ 1}) (B ⧸ (Ideal.span {π ^ 1}).map (algebraMap R B)) := by
  refine flat_congr
    (R := R ⧸ Ideal.span {π}) (S := R ⧸ Ideal.span {π ^ 1})
    (M := B ⧸ (Ideal.span {π}).map (algebraMap R B))
    (N := B ⧸ (Ideal.span {π ^ 1}).map (algebraMap R B))
    (e := Ideal.quotEquivOfEq (by simp))
    (f := (Ideal.quotEquivOfEq (R := B) (I := (Ideal.span {π}).map (algebraMap R B))
             (J := (Ideal.span {π ^ 1}).map (algebraMap R B)) (by simp)).toAddEquiv) ?_ h
  intro r m
  refine Submodule.Quotient.induction_on (R := R) (M := R) (Ideal.span {π} : Submodule R R) r ?_
  intro z
  refine Submodule.Quotient.induction_on (R := B) (M := B)
    ((Ideal.span {π}).map (algebraMap R B)) m ?_
  intro w
  rw [show ∀ {I J : Ideal B} (hh : I = J),
      ⇑((Ideal.quotEquivOfEq hh).toAddEquiv) = ⇑(Ideal.quotEquivOfEq hh) from fun hh => rfl]
  simp only [Ideal.Quotient.mk_eq_mk, Ideal.Quotient.mk_smul_mk_quotient_map_quotient,
    Ideal.quotEquivOfEq_mk]

/-- **Dévissage.**  If `B ⧸ πB` is flat over `R ⧸ π` then `B ⧸ πⁿB` is flat over `R ⧸ πⁿ`. -/
theorem flat_mod_pow_v2 {R B : Type u} [CommRing R] (π : R)
    (hπ : IsSMulRegular R π) [CommRing B] [Algebra R B]
    (hBπ : IsSMulRegular B (algebraMap R B π))
    (h : Module.Flat (R ⧸ Ideal.span {π}) (B ⧸ (Ideal.span {π}).map (algebraMap R B))) (n : ℕ) :
    Module.Flat (R ⧸ Ideal.span {π ^ n}) (B ⧸ (Ideal.span {π ^ n}).map (algebraMap R B)) := by
  have key : ∀ m : ℕ,
      Module.Flat (R ⧸ Ideal.span {π ^ (m + 1)})
        (B ⧸ (Ideal.span {π ^ (m + 1)}).map (algebraMap R B)) := by
    intro m
    induction m with
    | zero => exact flat_pow_one π h
    | succ k ih =>
        have hI : ((Ideal.span {π ^ (k + 1)}).map
            (Ideal.Quotient.mk (Ideal.span {π ^ (k + 2)}))) ^ 2 = ⊥ :=
          sq_span_quot π (Nat.succ_le_succ (Nat.zero_le k))
        have hα := lsmul_lift_injective_quot_pow (R := R) (B := B) π hBπ (k + 1)
        have hβ := flat_quot_pow_transport (R := R) (B := B) π (k + 1) ih
        exact flat_of_flat_mod_sqZero_v2 _ hI hα hβ
  match n with
  | 0 =>
      haveI : Subsingleton (B ⧸ (Ideal.span {π ^ 0}).map (algebraMap R B)) :=
        Submodule.Quotient.subsingleton_iff.mpr (by
          rw [pow_zero, Ideal.span_singleton_one, Ideal.map_top])
      exact flat_of_subsingleton
  | (m + 1) => simpa using key m

end Work.DSM2b
