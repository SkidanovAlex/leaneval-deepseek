import Mathlib

namespace Work.DSM2b

open scoped TensorProduct

universe u

/-- **Element form of `Ideal.span {e} ⊗ M`.**  Since `Ideal.span {e}` is generated as an
`R`-module by `e`, every element of `Ideal.span {e} ⊗[R] M` is a simple tensor `e ⊗ₜ m`. -/
lemma exists_eq_tmul_span_singleton {R M : Type*} [CommRing R] [AddCommMonoid M] [Module R M]
    (e : R) (x : (Ideal.span {e}) ⊗[R] M) :
    ∃ m : M, x = (⟨e, Ideal.mem_span_singleton_self e⟩ : Ideal.span {e}) ⊗ₜ[R] m := by
  induction x using TensorProduct.inductionOn with
  | tmul y m =>
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp y.2
      refine ⟨a • m, ?_⟩
      have hy : y = a • (⟨e, Ideal.mem_span_singleton_self e⟩ : Ideal.span {e}) := by
        ext
        simp [ha, mul_comm]
      rw [hy, TensorProduct.smul_tmul]
  | add x y hx hy =>
      obtain ⟨m, hm⟩ := hx
      obtain ⟨m', hm'⟩ := hy
      exact ⟨m + m', by rw [hm, hm', TensorProduct.tmul_add]⟩

/-- **Kernel form.**  Let `e, p ∈ R` with `e * p = 0` and suppose that every `m : M` killed by `e`
is divisible by `p` (`m = p • m'`).  Then the multiplication map `Ideal.span {e} ⊗[R] M → M`,
`i ⊗ m ↦ i • m`, has trivial kernel: `e ⊗ₜ m = 0` whenever `e • m = 0`, because `m = p • m'` and
`e ⊗ₜ (p • m') = (e * p) ⊗ₜ m' = 0`. -/
lemma lift_lsmul_subtype_eq_zero {R M : Type*} [CommRing R] [AddCommMonoid M] [Module R M]
    (e p : R) (hp : e * p = 0)
    (hker : ∀ m : M, e • m = 0 → ∃ m' : M, p • m' = m) :
    ∀ x : (Ideal.span {e}) ⊗[R] M,
      TensorProduct.lift ((LinearMap.lsmul R M).comp (Ideal.span {e}).subtype) x = 0 → x = 0 := by
  intro x hx
  obtain ⟨m, rfl⟩ := exists_eq_tmul_span_singleton e x
  simp only [TensorProduct.lift.tmul, LinearMap.comp_apply, LinearMap.lsmul_apply,
    Submodule.subtype_apply] at hx
  obtain ⟨m', hm'⟩ := hker m hx
  rw [← hm']
  rw [← TensorProduct.smul_tmul p (⟨e, Ideal.mem_span_singleton_self e⟩ : Ideal.span {e}) m']
  have hzero : p • (⟨e, Ideal.mem_span_singleton_self e⟩ : Ideal.span {e}) = 0 := by
    ext
    simpa [smul_eq_mul, mul_comm] using hp
  rw [hzero, TensorProduct.zero_tmul]

/-- **Injectivity form.**  Amalgamation of `lift_lsmul_subtype_eq_zero` with the obvious
injectivity criterion for an additive map between groups: replace `x` by `x - y`. -/
lemma lift_lsmul_subtype_injective {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (e p : R) (hp : e * p = 0)
    (hker : ∀ m : M, e • m = 0 → ∃ m' : M, p • m' = m) :
    Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul R M).comp (Ideal.span {e}).subtype)) := by
  intro x y hxy
  have h0 : TensorProduct.lift ((LinearMap.lsmul R M).comp (Ideal.span {e}).subtype) (x - y) = 0 := by
    rw [map_sub, hxy, sub_self]
  have h1 := lift_lsmul_subtype_eq_zero e p hp hker (x - y) h0
  rwa [sub_eq_zero] at h1

/-- Let `R` be a commutative ring, `π : R`, `B` an `R`-algebra on which `π` is a nonzerodivisor.
Put `A := R ⧸ (π ^ (n+1))`, `M := B ⧸ (π ^ (n+1)) • B` (an `A`-module) and let `I ⊆ A` be the ideal
generated by the class of `π ^ n`.  Then the natural map `I ⊗[A] M → M`, `i ⊗ m ↦ i • m`, is
injective.

Write `e := π ^ n ∈ A` and `𝔞 := ann_A (e)`, so `I = A · e ≅ A ⧸ 𝔞` and `I ⊗[A] M ≅ M ⧸ 𝔞 M` with
the map becoming `m mod 𝔞M ↦ e · m`.  One has `π ∈ 𝔞` (as `π · π ^ n = π ^ {n+1} = 0` in `A`), hence
`π M ⊆ 𝔞 M`; and `ker (e ·) = π M` because `π` is a nonzerodivisor on `B`.  Hence the map is
injective.  (`n = 0` gives `I = ⊤` and the map `A ⊗[A] M ≅ M`, a bijection.)  Useful API:
`TensorProduct.quotTensorEquivQuotSMul`, `Ideal.Quotient.mk`, `Submodule.Quotient`,
`TensorProduct.lift`, `LinearMap.lsmul`, `Submodule.subtype`, `IsSMulRegular`. -/
theorem lsmul_lift_injective_quot_pow {R B : Type u} [CommRing R] (π : R) [CommRing B]
    [Algebra R B] (hBπ : IsSMulRegular B (algebraMap R B π)) (n : ℕ) :
    let A := R ⧸ Ideal.span {π ^ (n + 1)}
    let M := B ⧸ (Ideal.span {π ^ (n + 1)}).map (algebraMap R B)
    let I : Ideal A := (Ideal.span {π ^ n}).map (Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}))
    Function.Injective (TensorProduct.lift ((LinearMap.lsmul A M).comp I.subtype)) := by
  have key : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul (R ⧸ Ideal.span {π ^ (n + 1)})
        (B ⧸ (Ideal.span {π ^ (n + 1)}).map (algebraMap R B))).comp
        ((Ideal.span {π ^ n}).map (Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}))).subtype)) := by
    -- `I = A · e` with `e = π ^ n`, so we may apply the general criterion with `e = π ^ n`,
    -- `p = π`; the only input is that `π ^ n · m = 0` forces `m = π • m'`, which is exactly
    -- `π`-torsion-freeness of `B` after lifting `m` to `B`.
    rw [Ideal.map_span, Set.image_singleton]
    refine lift_lsmul_subtype_injective (Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}) (π ^ n))
      (Ideal.Quotient.mk (Ideal.span {π ^ (n + 1)}) π) ?_ ?_
    · -- `π ^ n · π = π ^ (n+1) = 0` in `A`
      rw [← map_mul, ← pow_succ]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self (π ^ (n + 1)))
    · -- `ker (π ^ n ·) ⊆ π • ⊤`, by lifting to `B` and cancelling `π ^ n`
      intro m hm
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective m
      have h1 : Ideal.Quotient.mk (Ideal.map (algebraMap R B) (Ideal.span {π ^ (n + 1)}))
          (algebraMap R B (π ^ n) * b) = 0 := by
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_quotient_map_quotient, ← map_mul] at hm
        exact hm
      have h2 : algebraMap R B (π ^ n) * b ∈
          Ideal.map (algebraMap R B) (Ideal.span {π ^ (n + 1)}) :=
        Ideal.Quotient.eq_zero_iff_mem.mp h1
      rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton] at h2
      obtain ⟨c, hc⟩ := h2
      have hreg : IsSMulRegular B (algebraMap R B (π ^ n)) := by
        simpa [map_pow] using hBπ.pow n
      have hb : b = algebraMap R B π * c := by
        apply hreg
        calc algebraMap R B (π ^ n) • b
            = algebraMap R B (π ^ n) * b := by rw [smul_eq_mul]
          _ = algebraMap R B (π ^ (n + 1)) * c := hc
          _ = (algebraMap R B (π ^ n) * algebraMap R B π) * c := by rw [pow_succ, map_mul]
          _ = algebraMap R B (π ^ n) * (algebraMap R B π * c) := by rw [mul_assoc]
          _ = algebraMap R B (π ^ n) • (algebraMap R B π * c) := by rw [smul_eq_mul]
      exact ⟨Ideal.Quotient.mk _ c, by rw [hb]; simp⟩
  exact key

end Work.DSM2b
