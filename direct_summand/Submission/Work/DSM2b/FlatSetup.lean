import Mathlib

/-!
# Coordinate vocabulary for Bhatt's Proposition 4.1 (flat part)

`DSM2b/flat_of_flat_mod_base` proves: if `R` is Noetherian, `π` is a nonzerodivisor on `R` and on
the `R`-algebra `B`, `B` is `π`-adically complete, and `R/π → B/πB` is flat, then `R → B` is flat.

The proof works on the standard free modules `Fin k → R` and `Fin k → B`.  This file collects the
ingredients that only concern the *base change of coordinate maps*:

* `coeffMap` : the componentwise extension of scalars `R^k → B^k`;
* `spanBase S` : the `B`-submodule of `B^k` generated by the image of `S ⊆ R^k`; this is the image
  of `S ⊗[R] B → B^k` under `R^k ⊗[R] B ≅ B^k`;
* `coordBase g` : the base change of `g : R^k → R^m` to `B`, `y ↦ (∑ j, algebraMap (g e_j i) * y j)`;
* `linComb w`, `linCombB w` : the linear form `x ↦ ∑ i, w i * x i` over `R` and over `B`.

The main structural lemmas are the naturality statements
`coordBase g (coeffMap x) = coeffMap (g x)` and `linCombB w (coeffMap x) = algebraMap (linComb w x)`,
the annihilation `spanBase (ker g) ≤ ker (coordBase g)`, and the comparison with the tensor product
notions `LinearMap.lTensor B` and `TensorProduct.piScalarRight`.
-/

namespace Work.DSM2b

universe u

open TensorProduct

variable {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]

/-! ## Definitions -/

/-- Componentwise extension of scalars `R^k →ₗ[R] B^k`. -/
noncomputable def coeffMap {k : ℕ} : (Fin k → R) →ₗ[R] (Fin k → B) where
  toFun x i := algebraMap R B (x i)
  map_add' x y := by ext i; simp
  map_smul' r x := by
    ext i
    simp [Algebra.smul_def, map_mul]

@[simp]
lemma coeffMap_apply {k : ℕ} (x : Fin k → R) (i : Fin k) :
    coeffMap (B := B) x i = algebraMap R B (x i) := rfl

/-- The `B`-submodule of `B^k` generated by the image of `S ⊆ R^k`.  It is the image of the
natural map `S ⊗[R] B → B^k`, i.e. of `B ⊗ S → B ⊗ R^k` under `B ⊗ R^k ≅ B^k`. -/
noncomputable def spanBase {k : ℕ} (S : Submodule R (Fin k → R)) : Submodule B (Fin k → B) :=
  Submodule.span B (coeffMap (B := B) '' (S : Set (Fin k → R)))

@[simp]
lemma mem_spanBase {k : ℕ} {S : Submodule R (Fin k → R)} {y : Fin k → B} :
    y ∈ spanBase (B := B) S ↔
      y ∈ Submodule.span B (coeffMap (B := B) '' (S : Set (Fin k → R))) := Iff.rfl

/-- The base change to `B` of a linear map `g : R^k → R^m` between coordinate modules. -/
noncomputable def coordBase {k m : ℕ} (g : (Fin k → R) →ₗ[R] (Fin m → R)) :
    (Fin k → B) →ₗ[B] (Fin m → B) where
  toFun y i := ∑ j, algebraMap R B ((g (Pi.single j 1)) i) * y j
  map_add' y z := by
    ext i
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' b y := by
    ext i
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring

@[simp]
lemma coordBase_apply {k m : ℕ} (g : (Fin k → R) →ₗ[R] (Fin m → R)) (y : Fin k → B)
    (i : Fin m) : coordBase g y i = ∑ j, algebraMap R B ((g (Pi.single j 1)) i) * y j := rfl

/-- The linear form with coefficients `w`. -/
noncomputable def linComb {k : ℕ} (w : Fin k → R) : (Fin k → R) →ₗ[R] R where
  toFun x := ∑ i, w i * x i
  map_add' x y := by
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' r x := by
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring

@[simp]
lemma linComb_apply {k : ℕ} (w x : Fin k → R) : linComb w x = ∑ i, w i * x i := rfl

/-- The `B`-linear form with coefficients `w` (scalars pushed forward). -/
noncomputable def linCombB {k : ℕ} (w : Fin k → R) : (Fin k → B) →ₗ[B] B where
  toFun y := ∑ i, algebraMap R B (w i) * y i
  map_add' y z := by
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' b y := by
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring

@[simp]
lemma linCombB_apply {k : ℕ} (w : Fin k → R) (y : Fin k → B) :
    linCombB (B := B) w y = ∑ i, algebraMap R B (w i) * y i := rfl

/-! ## Basic lemmas -/

lemma sum_single_smul_eq {k : ℕ} (x : Fin k → R) :
    (∑ j, x j • (Pi.single j 1 : Fin k → R)) = x := by
  ext p
  simp only [Finset.sum_apply, Pi.smul_apply]
  rw [Finset.sum_eq_single p]
  · simp
  · intro q _ hqp
    simp [Pi.single_eq_of_ne (Ne.symm hqp)]
  · intro hp
    simp at hp

lemma apply_eq_sum_single {k : ℕ} (a : (Fin k → R) →ₗ[R] R) (x : Fin k → R) :
    a x = ∑ j, a (Pi.single j 1) * x j := by
  conv_lhs => rw [← sum_single_smul_eq x]
  simp only [map_sum, map_smul, smul_eq_mul]
  exact Finset.sum_congr rfl fun j _ => by ring

lemma apply_eq_sum_single_fin {k m : ℕ} (g : (Fin k → R) →ₗ[R] (Fin m → R)) (x : Fin k → R)
    (i : Fin m) : (g x) i = ∑ j, (g (Pi.single j 1)) i * x j := by
  have h := apply_eq_sum_single ((LinearMap.proj (φ := fun _ : Fin m => R) i).comp g) x
  simpa using h

/-- `a : R^k → R` is the linear combination with the coefficients `a (Pi.single i 1)`. -/
lemma linComb_apply_single {k : ℕ} (a : (Fin k → R) →ₗ[R] R) :
    linComb (fun i => a (Pi.single i 1)) = a := by
  refine LinearMap.ext fun x => ?_
  rw [linComb_apply, apply_eq_sum_single a x]

/-- Naturality of the base change on the image of `R^k`. -/
lemma coordBase_coeffMap {k m : ℕ} (g : (Fin k → R) →ₗ[R] (Fin m → R)) (x : Fin k → R) :
    coordBase (B := B) g (coeffMap x) = coeffMap (B := B) (g x) := by
  ext i
  rw [coordBase_apply]
  simp only [coeffMap_apply]
  have h : ∀ j : Fin k, algebraMap R B ((g (Pi.single j 1)) i) * algebraMap R B (x j)
      = algebraMap R B ((g (Pi.single j 1)) i * x j) := fun j => (map_mul _ _ _).symm
  simp only [h, ← map_sum, apply_eq_sum_single_fin g x i]

/-- `coordBase` of the identity map is `coeffMap`. -/
lemma coordBase_id {k : ℕ} :
    coordBase (B := B) (LinearMap.id : (Fin k → R) →ₗ[R] (Fin k → R)) = coeffMap (B := B) := by
  refine LinearMap.ext fun y => funext fun i => ?_
  rw [coordBase_apply, coeffMap_apply]
  simp only [LinearMap.id_coe, id_eq]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    rw [Pi.single_eq_of_ne (Ne.symm hji), map_zero, zero_mul]
  · intro hi
    simp at hi

/-- Naturality of `linCombB`. -/
lemma linCombB_coeffMap {k : ℕ} (w : Fin k → R) (x : Fin k → R) :
    linCombB (B := B) w (coeffMap x) = algebraMap R B (linComb w x) := by
  simp only [linCombB_apply, coeffMap_apply, linComb_apply]
  have h : ∀ i : Fin k, algebraMap R B (w i) * algebraMap R B (x i)
      = algebraMap R B (w i * x i) := fun i => (map_mul _ _ _).symm
  simp only [h, ← map_sum]

/-- The base change of `g` kills the `B`-span of `ker g`. -/
lemma spanBase_ker_le_ker_coordBase {k m : ℕ} (g : (Fin k → R) →ₗ[R] (Fin m → R)) :
    spanBase (B := B) (LinearMap.ker g) ≤ LinearMap.ker (coordBase (B := B) g) := by
  rw [spanBase, Submodule.span_le]
  rintro y ⟨s, hs, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, coordBase_coeffMap, LinearMap.mem_ker.mp hs]
  simp

/-- The `B ⊗ R^k ≅ B^k` identification sends the componentwise image of `x` to `1 ⊗ x`. -/
lemma piScalarRight_symm_coeffMap {k : ℕ} (x : Fin k → R) :
    (TensorProduct.piScalarRight R B B (Fin k)).symm (coeffMap (B := B) x) = 1 ⊗ₜ[R] x := by
  rw [LinearEquiv.symm_apply_eq, TensorProduct.piScalarRight_apply,
    TensorProduct.piScalarRightHom_tmul]
  ext i
  rw [coeffMap_apply, Algebra.smul_def, mul_one]

/-- The image of `S ⊗[R] B → B^k` spans `spanBase S`: every element of `spanBase S` is the image
under `B ⊗ R^k ≅ B^k` of an element of the range of `S.subtype.lTensor B`. -/
lemma exists_map_of_mem_spanBase' {k : ℕ} (S : Submodule R (Fin k → R))
    {y : Fin k → B} (hy : y ∈ spanBase (B := B) S) :
    ∃ t : B ⊗[R] S,
      AlgebraTensorModule.map (LinearMap.id : B →ₗ[B] B) S.subtype t =
        (TensorProduct.piScalarRight R B B (Fin k)).symm y := by
  rw [spanBase] at hy
  refine Submodule.span_induction
    (p := fun y _ => ∃ t : B ⊗[R] S,
      AlgebraTensorModule.map (LinearMap.id : B →ₗ[B] B) S.subtype t =
        (TensorProduct.piScalarRight R B B (Fin k)).symm y) ?_ ?_ ?_ ?_ hy
  · rintro y ⟨s, hs, rfl⟩
    refine ⟨(1 : B) ⊗ₜ[R] (⟨s, hs⟩ : S), ?_⟩
    rw [AlgebraTensorModule.map_tmul, piScalarRight_symm_coeffMap]
    rfl
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨tx, hx⟩ ⟨ty, hy⟩
    exact ⟨tx + ty, by rw [map_add, hx, hy, map_add]⟩
  · rintro c x _ ⟨tx, hx⟩
    exact ⟨c • tx, by rw [map_smul, hx, map_smul]⟩

/-- The image of `ker g ⊗[R] B → B^k` spans `spanBase (ker g)`: every element of
`spanBase (ker g)` is the image under `B ⊗ R^k ≅ B^k` of an element of the range of
`(ker g).subtype.lTensor B`.  This is the direction of the identification needed to descend from
`B^k` back to the tensor product. -/
lemma exists_map_of_mem_spanBase {k m : ℕ} (g : (Fin k → R) →ₗ[R] (Fin m → R))
    {y : Fin k → B} (hy : y ∈ spanBase (B := B) (LinearMap.ker g)) :
    ∃ t : B ⊗[R] (LinearMap.ker g),
      AlgebraTensorModule.map (LinearMap.id : B →ₗ[B] B) (LinearMap.ker g).subtype t =
        (TensorProduct.piScalarRight R B B (Fin k)).symm y := by
  rw [spanBase] at hy
  refine Submodule.span_induction
    (p := fun y _ => ∃ t : B ⊗[R] (LinearMap.ker g),
      AlgebraTensorModule.map (LinearMap.id : B →ₗ[B] B) (LinearMap.ker g).subtype t =
        (TensorProduct.piScalarRight R B B (Fin k)).symm y) ?_ ?_ ?_ ?_ hy
  · rintro y ⟨s, hs, rfl⟩
    refine ⟨(1 : B) ⊗ₜ[R] (⟨s, hs⟩ : LinearMap.ker g), ?_⟩
    rw [AlgebraTensorModule.map_tmul, piScalarRight_symm_coeffMap]
    rfl
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨tx, hx⟩ ⟨ty, hy⟩
    exact ⟨tx + ty, by rw [map_add, hx, hy, map_add]⟩
  · rintro c x _ ⟨tx, hx⟩
    exact ⟨c • tx, by rw [map_smul, hx, map_smul]⟩

/-- Comparison of the base change of `linComb w` with `linCombB w` under the canonical
isomorphism `B ⊗[R] R^k ≅ B^k`. -/
lemma rid_lTensor_linComb_eq {k : ℕ} (w : Fin k → R) (t : B ⊗[R] (Fin k → R)) :
    TensorProduct.rid R B (LinearMap.lTensor B (linComb w) t) =
      linCombB (B := B) w (TensorProduct.piScalarRight R B B (Fin k) t) := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]
  | tmul b x =>
      rw [LinearMap.lTensor_tmul, TensorProduct.piScalarRight_apply,
        TensorProduct.piScalarRightHom_tmul, TensorProduct.rid_tmul, linCombB_apply,
        linComb_apply, Algebra.smul_def]
      have h : ∀ j : Fin k, algebraMap R B (w j) * (x j • b)
          = algebraMap R B (w j * x j) * b := fun j => by
        rw [map_mul, Algebra.smul_def, mul_assoc]
      rw [Finset.sum_congr rfl (fun j _ => h j), ← Finset.sum_mul, ← map_sum]

section General

variable {S M : Type u} [CommRing S] [CommRing M] [Algebra S M]

/-- The base change `LinearMap.lTensor M g` of a coordinate map `g` is, under the canonical
identification `M ⊗[S] S^k ≅ M^k`, exactly the base changed coordinate map `coordBase g`. -/
lemma piScalarRight_lTensor_coordBase {k m : ℕ} (g : (Fin k → S) →ₗ[S] (Fin m → S))
    (t : M ⊗[S] (Fin k → S)) :
    TensorProduct.piScalarRight S M M (Fin m) (LinearMap.lTensor M g t) =
      coordBase (R := S) (B := M) g (TensorProduct.piScalarRight S M M (Fin k) t) := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | tmul c x =>
      rw [LinearMap.lTensor_tmul]
      simp only [TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul]
      ext i
      rw [coordBase_apply, apply_eq_sum_single_fin g x i, Finset.sum_smul]
      exact Finset.sum_congr rfl fun j _ => by
        simp only [Algebra.smul_def, map_mul, mul_assoc]

end General

section Naturality

variable {C : Type u} [CommRing C] [Algebra R C]

/-- Naturality of `coordBase` under an `R`-algebra map `χ : B →ₐ[R] C`. -/
lemma map_coordBase {k m : ℕ} (χ : B →ₐ[R] C) (g : (Fin k → R) →ₗ[R] (Fin m → R))
    (y : Fin k → B) :
    (fun i => χ (coordBase (B := B) g y i)) =
      coordBase (B := C) g (fun j => χ (y j)) := by
  ext i
  rw [coordBase_apply, coordBase_apply]
  simp only [map_sum, map_mul, AlgHom.commutes]

end Naturality

end Work.DSM2b
