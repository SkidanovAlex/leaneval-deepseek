import Mathlib
import Submission.Work.DSMap.Mix2
import Submission.Work.DSG2.ChartRingDefs
import Submission.Work.DSG1.Basic
import Submission.Work.DSCHART.Phi_surjective_univ

/-!
# DSCHART — the chart ring of `X ∩ D₊(x_j)` is generated by the coordinate functions

The chart coordinate functions `x_k/x_j` are the sections `DSMap.Mix2.xiSec i j k ∈ Γ(X, U_j)`
of `U_j = DSMap.Mix2.chartCover i ⟨j⟩ = i ⁻¹ᵁ D₊(x_j) ⊆ ℙᴺ_A`.  The deliverable
`Work.DSCHART.xiSec_surjective` states that the `A`-algebra map

`A[x₀,…,x_N] ⟶ Γ(X, U_j)`,  `x_k ↦ x_k/x_j`,  `a ↦ a`

given by `MvPolynomial.eval₂ (DSMap.phiU A X f U_j) (xiSec i j ·)` is surjective.

For the proof: `Γ(D₊(x_j), 𝒪)` is the chart ring `Away (PGr A N) (x_j)` of `ℙᴺ_A`, which is
generated over `A` by the `x_k/x_j` (`Work.DSG2.Phi_surjective`), while the closed immersion
`i : X ↪ ℙᴺ_A` makes `i.app (D₊(x_j))` surjective onto `Γ(X, U_j)` because `D₊(x_j)` is affine
(`Scheme.Hom.app_surjective`).  The ingredients are:

* the compatibility of the structure maps, `phiU_comp` (and its consequence
  `phiU_pspace_toSpec_eq_awayToSection`, identifying the structure map of `ℙᴺ_A` on the chart
  with `awayToSection ∘ AtoAway`);
* the surjectivity of the chart ring map, `Work.DSCHART.Phi_surjective_univ` (the
  universe-generalised version of the pinned `Work.DSG2.Phi_surjective`).
-/

namespace Work.DSCHART

attribute [local instance] MvPolynomial.gradedAlgebra
open CategoryTheory AlgebraicGeometry
universe u


theorem AtoA0_eq_algebraMap {A : Type u} [CommRing A] (N : ℕ) :
    Work.DSG2.AtoA0 A N = algebraMap A ↥(DSMap.PGr A N 0) := by
  ext a
  rfl

set_option backward.isDefEq.respectTransparency false in
theorem phi_specMap {A R : Type u} [CommRing A] [CommRing R] (ψ : A →+* R) :
    DSMap.phi A (Spec (CommRingCat.of R)) (Spec.map (CommRingCat.ofHom ψ))
      = ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom).comp ψ := by
  rw [DSMap.phi]
  suffices h : ((ΓSpec.adjunction.homEquiv (Spec (CommRingCat.of R)) (Opposite.op (CommRingCat.of A))).symm
      (Spec.map (CommRingCat.ofHom ψ))).unop
      = CommRingCat.ofHom ψ ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).inv by
    rw [h, CommRingCat.hom_comp]
    rfl
  have hT := ΓSpecIso_inv_ΓSpec_adjunction_homEquiv (X := Spec (CommRingCat.of R))
    (B := CommRingCat.of A)
    (φ := ((ΓSpec.adjunction.homEquiv (Spec (CommRingCat.of R)) (Opposite.op (CommRingCat.of A))).symm
      (Spec.map (CommRingCat.ofHom ψ))).unop)
  rw [Quiver.Hom.op_unop, Equiv.apply_symm_apply] at hT
  rw [← hT, ← Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ψ)]

set_option backward.isDefEq.respectTransparency false in
theorem chartRestrict_ι_topIso {A : Type u} [CommRing A] {N : ℕ} (j : Fin (N+1)) :
    (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)).ι.appTop ≫
      (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)).topIso.hom
    = (DSMap.PSpace A N).presheaf.map
        (homOfLE (le_top : Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j) ≤ (⊤ : (DSMap.PSpace A N).Opens))).op := by
  simp only [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
  rw [← Functor.map_comp]
  congr 1

set_option backward.isDefEq.respectTransparency false in
theorem chartCover_ι_eq {A : Type u} [CommRing A] {N : ℕ} (j : Fin (N+1)) :
    (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)).ι
      = (Proj.basicOpenIsoSpec (DSMap.PGr A N) (MvPolynomial.X j)
          (DSMap.Mix2.X_mem_PGr j) (by norm_num)).hom
        ≫ Proj.awayι (DSMap.PGr A N) (MvPolynomial.X j) (DSMap.Mix2.X_mem_PGr j) (by norm_num) := by
  rw [← Proj.basicOpenIsoSpec_inv_ι (DSMap.PGr A N) (MvPolynomial.X j)
    (DSMap.Mix2.X_mem_PGr j) (by norm_num), Iso.hom_inv_id_assoc]

set_option backward.isDefEq.respectTransparency false in
theorem basicOpenToSpec_appTop_comp_topIso {A : Type u} [CommRing A] {N : ℕ} (j : Fin (N+1)) :
    Scheme.Hom.appTop (Proj.basicOpenToSpec (DSMap.PGr A N) (MvPolynomial.X j))
        ≫ (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)).topIso.hom
      = (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (DSMap.PGr A N)
            (MvPolynomial.X j)))).hom
        ≫ Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j) := by
  rw [show Scheme.Hom.appTop (Proj.basicOpenToSpec (DSMap.PGr A N) (MvPolynomial.X j))
      = (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (DSMap.PGr A N)
            (MvPolynomial.X j)))).hom
        ≫ Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)
        ≫ (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)).topIso.inv
      from Proj.basicOpenToSpec_app_top (DSMap.PGr A N) (MvPolynomial.X j)]
  simp only [Category.assoc]
  rw [Iso.inv_hom_id, Category.comp_id]

set_option backward.isDefEq.respectTransparency false in
theorem toSpecZero_appTop_comp_awayι_appTop {A : Type u} [CommRing A] {N : ℕ} (j : Fin (N+1)) :
    Scheme.Hom.appTop (Proj.toSpecZero (DSMap.PGr A N))
        ≫ Scheme.Hom.appTop (Proj.awayι (DSMap.PGr A N) (MvPolynomial.X j)
            (DSMap.Mix2.X_mem_PGr j) (by norm_num))
      = (Scheme.ΓSpecIso (CommRingCat.of ↥(DSMap.PGr A N 0))).hom
        ≫ CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom (DSMap.PGr A N)
            (Submonoid.powers (MvPolynomial.X j)))
        ≫ (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (DSMap.PGr A N)
            (MvPolynomial.X j)))).inv := by
  rw [← Scheme.Hom.comp_appTop, Proj.awayι_toSpecZero (DSMap.PGr A N) (MvPolynomial.X j)
    (DSMap.Mix2.X_mem_PGr j) (by norm_num)]
  refine Eq.symm ?_
  calc (Scheme.ΓSpecIso (CommRingCat.of ↥(DSMap.PGr A N 0))).hom
        ≫ (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom (DSMap.PGr A N)
            (Submonoid.powers (MvPolynomial.X j)))
          ≫ (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (DSMap.PGr A N)
            (MvPolynomial.X j)))).inv)
      = (Scheme.ΓSpecIso (CommRingCat.of ↥(DSMap.PGr A N 0))).hom
        ≫ ((Scheme.ΓSpecIso (CommRingCat.of ↥(DSMap.PGr A N 0))).inv
          ≫ Scheme.Hom.appTop (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (DSMap.PGr A N) (Submonoid.powers (MvPolynomial.X j)))))) := by
        rw [Scheme.ΓSpecIso_inv_naturality]
    _ = Scheme.Hom.appTop (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (DSMap.PGr A N) (Submonoid.powers (MvPolynomial.X j))))) := by
        rw [Iso.hom_inv_id_assoc]

set_option backward.isDefEq.respectTransparency false in
theorem chartRestrict_eq_awayToSection {A : Type u} [CommRing A] {N : ℕ} (j : Fin (N+1)) :
    (DSMap.PSpace A N).presheaf.map
        (homOfLE (le_top : Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j) ≤ (⊤ : (DSMap.PSpace A N).Opens))).op
      = Scheme.Hom.appTop (Proj.awayι (DSMap.PGr A N) (MvPolynomial.X j)
            (DSMap.Mix2.X_mem_PGr j) (by norm_num))
        ≫ ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (DSMap.PGr A N)
              (MvPolynomial.X j)))).hom ≫ Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)) := by
  rw [← chartRestrict_ι_topIso (A := A) (N := N) j, chartCover_ι_eq (A := A) (N := N) j,
    Proj.basicOpenIsoSpec_hom, Scheme.Hom.comp_appTop, Category.assoc, basicOpenToSpec_appTop_comp_topIso]

set_option backward.isDefEq.respectTransparency false in
theorem phiU_pspace_toSpec_eq_awayToSection {A : Type u} [CommRing A] (N : ℕ) (j : Fin (N+1)) :
    DSMap.phiU A (DSMap.PSpace A N) (DSMap.PSpace.toSpec A N)
        (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))
      = ((Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)).hom).comp
          (Work.DSG2.AtoAway A N j) := by
  have hphi : DSMap.phi A (DSMap.PSpace A N) (DSMap.PSpace.toSpec A N)
      = ((Scheme.Hom.appTop (Proj.toSpecZero (DSMap.PGr A N))).hom).comp
          (((Scheme.ΓSpecIso (CommRingCat.of ↥(DSMap.PGr A N 0))).inv.hom).comp
            (algebraMap A ↥(DSMap.PGr A N 0))) := by
    rw [DSMap.PSpace.toSpec, Work.DSG1.phi_comp, Work.DSG1.gammaMap]
    rw [phi_specMap (algebraMap A ↥(DSMap.PGr A N 0))]
  have hrest := congrArg CommRingCat.Hom.hom (chartRestrict_eq_awayToSection (A := A) (N := N) j)
  have happ0 := congrArg CommRingCat.Hom.hom (toSpecZero_appTop_comp_awayι_appTop (A := A) (N := N) j)
  apply RingHom.ext
  intro a
  rw [RingHom.comp_apply, DSMap.phiU, RingHom.comp_apply, hphi]
  simp only [RingHom.comp_apply]
  rw [hrest]
  simp only [CommRingCat.hom_comp, RingHom.comp_apply]
  have happ := DFunLike.congr_fun happ0 ((Scheme.ΓSpecIso (CommRingCat.of ↥(DSMap.PGr A N 0))).inv.hom
        (algebraMap A ↥(DSMap.PGr A N 0) a))
  rw [CommRingCat.hom_comp] at happ
  rw [RingHom.comp_apply] at happ
  rw [CommRingCat.hom_comp] at happ
  rw [RingHom.comp_apply] at happ
  rw [CommRingCat.hom_comp] at happ
  rw [RingHom.comp_apply] at happ
  rw [CommRingCat.hom_ofHom] at happ
  rw [happ]
  rw [Iso.inv_hom_id_apply, Iso.inv_hom_id_apply]
  congr 1

/-- **Compatibility of the structure maps of `X' ⟶ X ⟶ Spec A` with restriction.**

For `f : X ⟶ Spec A`, `g : X' ⟶ X` and an open `U ⊆ X`, the structure map
`A →+* Γ(X', g ⁻¹ᵁ U)` of the composite `g ≫ f` is the structure map of `f`, restricted to `U`
and then pulled back along `g`. -/
theorem phiU_comp {A : Type u} [CommRing A] {X X' : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) (g : X' ⟶ X) (U : X.Opens) :
    DSMap.phiU A X' (g ≫ f) (g ⁻¹ᵁ U) = (g.app U).hom.comp (DSMap.phiU A X f U) := by
  have hcomp : (Scheme.Hom.app g (⊤ : X.Opens)) ≫
        X'.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ U ≤ ⊤)).op
      = X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ Scheme.Hom.app g U := by
    rw [Scheme.Hom.naturality (f := g) (i := (homOfLE (le_top : U ≤ ⊤)).op)]
    congr 1
  ext a
  rw [DSMap.phiU]
  show (X'.presheaf.map (homOfLE le_top).op).hom (DSMap.phi A X' (g ≫ f) a) = _
  rw [Work.DSG1.phi_comp]
  show (X'.presheaf.map (homOfLE le_top).op).hom ((Scheme.Hom.app g ⊤).hom (DSMap.phi A X f a))
    = (g.app U).hom ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (DSMap.phi A X f a))
  change ((Scheme.Hom.app g ⊤) ≫ X'.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ U ≤ ⊤)).op).hom
      (DSMap.phi A X f a) = _
  rw [hcomp]
  rfl


/-- **The chart ring of `X ∩ D₊(x_j)` is generated by the coordinate functions `x_k/x_j`.**

The map `MvPolynomial.eval₂ (phiU A X f U_j) (xiSec i j ·) : A[x₀,…,x_N] ⟶ Γ(X, U_j)` sends the
variable `x_k` to the section `x_k/x_j` and the constants `A` to the constants of `𝒪_X`; the
claim is that this `A`-algebra map is surjective.

`ℙᴺ_A` is covered by the standard affine charts; on `D₊(x_j)` the structure map of `ℙᴺ_A` is
`awayToSection ∘ AtoAway`, and `Γ(ℙᴺ_A, D₊(x_j)) ≅ Away (PGr A N) (x_j)` is generated over `A`
by the fractions `x_k/x_j` (`Work.DSG2.Phi_surjective`).  Since `i` is a closed immersion and
`D₊(x_j)` is affine, `i.app D₊(x_j)` is surjective, so the images `xiSec i j k` generate
`Γ(X, U_j) = Γ(X, i ⁻¹ᵁ D₊(x_j))` as an `A`-algebra. -/
theorem xiSec_surjective {A : Type*} [CommRing A] {X : Scheme} {N : ℕ}
    (f : X ⟶ Spec (.of A)) (i : X ⟶ DSMap.PSpace A N) (hi : IsClosedImmersion i)
    (hif : i ≫ DSMap.PSpace.toSpec A N = f) (j : Fin (N + 1)) :
    Function.Surjective fun p : MvPolynomial (Fin (N + 1)) A =>
      MvPolynomial.eval₂ (DSMap.phiU A X f (DSMap.Mix2.chartCover i ⟨j⟩))
        (fun k : Fin (N + 1) => DSMap.Mix2.xiSec i j k) p := by
  haveI : IsClosedImmersion i := hi
  -- `chartCover i ⟨j⟩` and the explicit preimage `i ⁻¹ᵁ D₊(x_j)` are definitionally equal;
  -- rewriting the statement into the latter form makes all subsequent unifications syntactic.
  show Function.Surjective fun p : MvPolynomial (Fin (N + 1)) A =>
      MvPolynomial.eval₂ (DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)))
        (fun k : Fin (N + 1) => DSMap.Mix2.xiSec i j k) p
  -- the two inputs:
  -- * `hL`: the structure map of `ℙᴺ_A` on the chart `D₊(x_j)` is `awayToSection ∘ AtoAway`;
  -- * `hPhi`: the chart ring `Away (PGr A N) (X j)` is generated by the `x_k/x_j`.
  have hL : DSMap.phiU A (DSMap.PSpace A N) (DSMap.PSpace.toSpec A N)
      (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))
      = ((Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)).hom).comp
          (Work.DSG2.AtoAway A N j) :=
    phiU_pspace_toSpec_eq_awayToSection N j
  have hPhi : Function.Surjective (Work.DSG2.Phi A N j) := Phi_surjective_univ N j
  -- the structure map of `X` over `U_j` is the pullback of that of `ℙᴺ_A`
  have h1 : DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))
      = ((i.app (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))).hom).comp
          (DSMap.phiU A (DSMap.PSpace A N) (DSMap.PSpace.toSpec A N)
            (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))) := by
    rw [← hif]
    exact phiU_comp (A := A) (X := DSMap.PSpace A N) (X' := X)
      (DSMap.PSpace.toSpec A N) i (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))
  let g : Fin (N + 1) → Γ(X, i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)) :=
    fun k => DSMap.Mix2.xiSec i j k
  let ψR : MvPolynomial (Fin (N + 1)) A →+*
      HomogeneousLocalization.Away (DSMap.PGr A N) (MvPolynomial.X j) :=
    MvPolynomial.eval₂Hom (Work.DSG2.AtoAway A N j)
      (fun k : Fin (N + 1) => HomogeneousLocalization.Away.mk (DSMap.PGr A N)
        (DSMap.Mix2.X_mem_PGr j) 1 (MvPolynomial.X k) (by rw [one_smul]; exact DSMap.Mix2.X_mem_PGr k))
  let ρ : HomogeneousLocalization.Away (DSMap.PGr A N) (MvPolynomial.X j) →+*
      Γ(X, i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)) :=
    ((i.app (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))).hom).comp
      ((Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)).hom)
  -- `ψR` is surjective, by `Phi_surjective_univ`
  have hψR : Function.Surjective ψR := by
    change Function.Surjective (MvPolynomial.eval₂Hom (Work.DSG2.AtoAway A N j)
      (fun k : Fin (N + 1) => HomogeneousLocalization.Away.mk (DSMap.PGr A N)
        (DSMap.Mix2.X_mem_PGr j) 1 (MvPolynomial.X k) (by rw [one_smul]; exact DSMap.Mix2.X_mem_PGr k)))
    refine Function.Surjective.of_comp (g := MvPolynomial.eval₂Hom MvPolynomial.C
      (fun m : Fin N => MvPolynomial.X (j.succAbove m))) ?_
    have hcomp : ((MvPolynomial.eval₂Hom (Work.DSG2.AtoAway A N j)
        (fun k : Fin (N + 1) => HomogeneousLocalization.Away.mk (DSMap.PGr A N)
          (DSMap.Mix2.X_mem_PGr j) 1 (MvPolynomial.X k)
          (by rw [one_smul]; exact DSMap.Mix2.X_mem_PGr k))).comp
          (MvPolynomial.eval₂Hom MvPolynomial.C (fun m : Fin N => MvPolynomial.X (j.succAbove m))))
        = Work.DSG2.Phi A N j := by
      refine MvPolynomial.ringHom_ext (fun a => ?_) (fun m => ?_)
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, Work.DSG2.Phi]
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [Work.DSG2.Phi, MvPolynomial.eval₂Hom_X', Work.DSG2.e]
    rw [show (MvPolynomial.eval₂Hom (Work.DSG2.AtoAway A N j)
        (fun k : Fin (N + 1) => HomogeneousLocalization.Away.mk (DSMap.PGr A N)
          (DSMap.Mix2.X_mem_PGr j) 1 (MvPolynomial.X k)
          (by rw [one_smul]; exact DSMap.Mix2.X_mem_PGr k)) ∘
          (MvPolynomial.eval₂Hom MvPolynomial.C (fun m : Fin N => MvPolynomial.X (j.succAbove m))))
        = ⇑(Work.DSG2.Phi A N j) from congrArg DFunLike.coe hcomp]
    exact hPhi
  -- `ρ` is surjective: it is `i.app D₊(x_j)` (surjective, closed immersion into an affine open)
  -- composed with the isomorphism `awayToSection`.
  have hρ : Function.Surjective ρ := by
    change Function.Surjective ((((i.app (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))).hom).comp
      ((Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)).hom)))
    have h1' : Function.Surjective ⇑(i.app (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))) :=
      Scheme.Hom.app_surjective i (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))
        (Proj.isAffineOpen_basicOpen (DSMap.PGr A N) (MvPolynomial.X j)
          (DSMap.Mix2.X_mem_PGr j) (by norm_num))
    haveI : IsIso (Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)) := by
      rw [← Proj.basicOpenIsoAway_hom (DSMap.PGr A N) (MvPolynomial.X j)
        (DSMap.Mix2.X_mem_PGr j) (by norm_num)]
      exact (Proj.basicOpenIsoAway (DSMap.PGr A N) (MvPolynomial.X j)
        (DSMap.Mix2.X_mem_PGr j) (by norm_num)).isIso_hom
    have h2' : Function.Surjective ⇑(Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)) :=
      (ConcreteCategory.bijective_of_isIso (Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j))).2
    exact h1'.comp h2'
  -- the identification of the two ring maps on generators
  have hE : (MvPolynomial.eval₂Hom
        (DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))) g)
      = ρ.comp ψR := by
    apply RingHom.ext
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.eval₂Hom_C]
      show DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)) a
        = ρ (ψR (MvPolynomial.C a))
      rw [show ψR (MvPolynomial.C a) = Work.DSG2.AtoAway A N j a from MvPolynomial.eval₂Hom_C _ _ a]
      show DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)) a
        = ((i.app (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))).hom)
            (((Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)).hom) (Work.DSG2.AtoAway A N j a))
      rw [h1, hL]
      rfl
    | add p q hp hq => rw [map_add, map_add, hp, hq]
    | mul_X p n hp =>
      rw [map_mul, map_mul, hp]
      congr 1
      show (MvPolynomial.eval₂Hom
        (DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))) g)
        (MvPolynomial.X n) = ρ (ψR (MvPolynomial.X n))
      rw [MvPolynomial.eval₂Hom_X']
      show g n = ρ (ψR (MvPolynomial.X n))
      rw [show ψR (MvPolynomial.X n) = HomogeneousLocalization.Away.mk (DSMap.PGr A N)
          (DSMap.Mix2.X_mem_PGr j) 1 (MvPolynomial.X n)
          (by rw [one_smul]; exact DSMap.Mix2.X_mem_PGr n)
        from MvPolynomial.eval₂Hom_X' _ _ n]
      show (fun k => DSMap.Mix2.xiSec i j k) n
        = ((i.app (Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j))).hom)
          (((Proj.awayToSection (DSMap.PGr A N) (MvPolynomial.X j)).hom)
            (HomogeneousLocalization.Away.mk (DSMap.PGr A N) (DSMap.Mix2.X_mem_PGr j) 1
              (MvPolynomial.X n) (by rw [one_smul]; exact DSMap.Mix2.X_mem_PGr n)))
      rfl
  rw [show (fun p : MvPolynomial (Fin (N + 1)) A => MvPolynomial.eval₂
        (DSMap.phiU A X f (i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)))
        (fun k : Fin (N + 1) => DSMap.Mix2.xiSec i j k) p)
