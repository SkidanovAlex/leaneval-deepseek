import Mathlib
import Submission.Work.DSG4c.Basic

namespace Work.DSG4c.ProjBaseChange

attribute [local instance] MvPolynomial.gradedAlgebra
open CategoryTheory AlgebraicGeometry Limits MvPolynomial
universe u
/-! ## Auxiliary lemmas -/

/-- The irrelevant ideal of the graded polynomial ring `A[x₀,…,x_N]` (graded by total degree) is
contained in the ideal generated by the coordinate functions `X i`: every monomial of positive
degree is divisible by some coordinate, and every positive-degree homogeneous polynomial is a
sum of such monomials. -/
theorem irrelevant_toIdeal_le_span_X (A : Type u) [CommRing A] (N : ℕ) :
    (HomogeneousIdeal.irrelevant (DSMap.PGr A N)).toIdeal ≤
      Ideal.span (Set.range (fun i : Fin (N+1) =>
        (MvPolynomial.X i : MvPolynomial (Fin (N+1)) A))) := by
  rw [show Ideal.span (Set.range (fun i : Fin (N+1) =>
        (MvPolynomial.X i : MvPolynomial (Fin (N+1)) A))) =
      MvPolynomial.idealOfVars (Fin (N+1)) A from rfl]
  rw [HomogeneousIdeal.toIdeal_irrelevant_le]
  intro i hi x hx
  change x ∈ MvPolynomial.homogeneousSubmodule (Fin (N+1)) A i at hx
  change x ∈ MvPolynomial.idealOfVars (Fin (N+1)) A
  rw [← pow_one (MvPolynomial.idealOfVars (Fin (N+1)) A)]
  rw [mem_pow_idealOfVars_iff']
  intro y hy
  obtain rfl : y = 0 := by rw [← Finsupp.degree_eq_zero_iff]; omega
  exact (mem_homogeneousSubmodule i x).mp hx |>.coeff_eq_zero (by simp; omega)

/-- The `i`-th standard chart of `ℙᴺ_{A'}` is the preimage of the `i`-th standard chart of `ℙᴺ_A`
under the base change morphism; the corresponding square is a pullback because both vertical maps
are open immersions with matching ranges (`Proj.map_preimage_basicOpen`). -/
theorem isPullback_chartιT_chartι_baseChangeMap (A A' : Type u) [CommRing A] [CommRing A']
    (ψ : A →+* A') (N : ℕ) (i : Fin (N+1)) :
    IsPullback (Spec.map (CommRingCat.ofHom (awayMapChart A A' ψ N i)))
      (chartιT A A' ψ N i) (chartι A N i) (baseChangeMap A A' ψ N) := by
  refine IsOpenImmersion.isPullback (U := Spec ↧(awayChartT A A' ψ N i))
    (V := Spec ↧(awayChart A N i))
    (Spec.map (CommRingCat.ofHom (awayMapChart A A' ψ N i)))
    (chartιT A A' ψ N i) (chartι A N i) (baseChangeMap A A' ψ N) ?_ ?_
  · exact chartιT_comp_baseChangeMap A A' ψ N i
  · have h1 : Scheme.Hom.opensRange (chartι A N i) =
        Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X i) :=
      Proj.opensRange_awayι (DSMap.PGr A N) (MvPolynomial.X i) (X_mem A N i) one_pos
    have h2 : Scheme.Hom.opensRange (chartιT A A' ψ N i) =
        Proj.basicOpen (DSMap.PGr A' N) ((coeffExt A A' ψ N) (MvPolynomial.X i)) :=
      Proj.opensRange_awayι (DSMap.PGr A' N) ((coeffExt A A' ψ N) (MvPolynomial.X i))
        ((coeffExt A A' ψ N).2 (X_mem A N i)) one_pos
    rw [h1, h2, baseChangeMap, Proj.map_preimage_basicOpen]

/-- **Base change commutes with `ℙᴺ`**: if the chart squares are pushouts then
`ℙᴺ_{A'} = ℙᴺ_A ×_{Spec A} Spec A'`.  (Equivalently, the base change morphism
`ℙᴺ_{A'} ⟶ ℙᴺ_A` exhibits `ℙᴺ_{A'}` as the fibre product over `Spec A`.)

Proof: apply `Scheme.isPullback_of_openCover` to the affine open cover of `ℙᴺ_A` by the charts
`chartι A N i` (`Proj.affineOpenCoverOfIrrelevantLESpan`, the irrelevant ideal being spanned by
the coordinates).  Over each chart the local square is identified with the Spec-level chart square
`IsPullback (Spec.map (awayMapChart)) (Spec.map (chartMapT)) (Spec.map (chartMap)) (Spec.map ψ)`,
which is a pullback by `isPullback_SpecMap_of_isPushout` applied to `hchart i`; the identification
is the isomorphism `Spec (Away (PGr A' N) (coeffExt ψ (X i))) ≅
pullback (chartι A N i) (baseChangeMap A A' ψ N)` whose existence is
`isPullback_chartιT_chartι_baseChangeMap`, together with `chartι_comp_toSpec` and
`chartιT_comp_toSpec`. -/
theorem isPullback_baseChangeMap_of_chartPushout (A A' : Type u) [CommRing A] [CommRing A']
    (ψ : A →+* A') (N : ℕ)
    (hchart : ∀ i : Fin (N+1), IsPushout (CommRingCat.ofHom ψ)
      (CommRingCat.ofHom (Work.DSG4c.chartMap A N i))
      (CommRingCat.ofHom (Work.DSG4c.chartMapT A A' ψ N i))
      (CommRingCat.ofHom (Work.DSG4c.awayMapChart A A' ψ N i))) :
    IsPullback (Work.DSG4c.baseChangeMap A A' ψ N) (DSMap.PSpace.toSpec A' N)
      (DSMap.PSpace.toSpec A N) (Spec.map (CommRingCat.ofHom ψ)) := by
  -- The affine open cover of `ℙᴺ_A` by its standard charts.
  let 𝒰 : (DSMap.PSpace A N).OpenCover :=
    (Proj.affineOpenCoverOfIrrelevantLESpan (DSMap.PGr A N) (fun i : Fin (N+1) => MvPolynomial.X i)
      (fun i => X_mem A N i) (fun _ => one_pos) (irrelevant_toIdeal_le_span_X A N)).openCover
  refine Scheme.isPullback_of_openCover _ _ _ _ 𝒰 ?_
  -- Rewrite the local condition in terms of the standard chart `chartι A N i`.
  change ∀ i : Fin (N+1), IsPullback (pullback.snd (baseChangeMap A A' ψ N) (chartι A N i))
    (pullback.fst (baseChangeMap A A' ψ N) (chartι A N i) ≫ DSMap.PSpace.toSpec A' N)
    (chartι A N i ≫ DSMap.PSpace.toSpec A N) (Spec.map (CommRingCat.ofHom ψ))
  intro i
  -- The affine chart square is cartesian because the ring square is a pushout.
  have S2 : IsPullback (Spec.map (CommRingCat.ofHom (awayMapChart A A' ψ N i)))
      (Spec.map (CommRingCat.ofHom (chartMapT A A' ψ N i)))
      (Spec.map (CommRingCat.ofHom (chartMap A N i))) (Spec.map (CommRingCat.ofHom ψ)) :=
    (isPullback_SpecMap_of_isPushout _ _ _ _ (hchart i)).flip
  -- Transport it along the isomorphism identifying the chart of `ℙᴺ_{A'}` with the pullback along
  -- the chart inclusion.
  refine IsPullback.of_iso S2
    ((isPullback_chartιT_chartι_baseChangeMap A A' ψ N i).isoPullback ≪≫
      (pullbackSymmetry (baseChangeMap A A' ψ N) (chartι A N i)).symm)
    (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp only [Iso.refl_hom, Category.comp_id, Iso.trans_hom, Iso.symm_hom, Category.assoc,
      pullbackSymmetry_inv_comp_snd, IsPullback.isoPullback_hom_fst]
  · rw [Iso.refl_hom, Category.comp_id]
    simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
    rw [← Category.assoc ((pullbackSymmetry (baseChangeMap A A' ψ N)
          (chartι A N i)).inv)
        (pullback.fst (baseChangeMap A A' ψ N) (chartι A N i)) (DSMap.PSpace.toSpec A' N)]
    rw [pullbackSymmetry_inv_comp_fst, IsPullback.isoPullback_hom_snd_assoc]
    exact (chartιT_comp_toSpec A A' ψ N i).symm
  · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp, chartι_comp_toSpec]
  · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]

end Work.DSG4c.ProjBaseChange
