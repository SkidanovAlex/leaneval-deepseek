import Mathlib
import Submission.Work.DSG4c.ChartPushout.Defs

namespace Work.DSG4c.ChartPushout

universe u

/-- Over the degree-zero part `PGr A N 0` of the polynomial ring, the standard
coordinates `X k` generate `A[x₀,…,x_N]` as an algebra.  The constants `C a` all
already lie in `PGr A N 0` (the degree-zero piece is the submodule generated by
`1`), so adding the variables generates everything. -/
theorem algebra_adjoin_range_X (A : Type u) [CommRing A] (N : ℕ) :
    Algebra.adjoin (DSMap.PGr A N 0)
      (Set.range (fun k : Fin (N+1) => (MvPolynomial.X k : MvPolynomial (Fin (N+1)) A))) = ⊤ := by
  rw [eq_top_iff]
  intro p _
  refine MvPolynomial.induction_on p ?_ ?_ ?_
  · intro a
    have hmem : (MvPolynomial.C a : MvPolynomial (Fin (N+1)) A) ∈ DSMap.PGr A N 0 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_C (Fin (N+1)) a
    exact Subalgebra.algebraMap_mem (Algebra.adjoin (DSMap.PGr A N 0)
      (Set.range (fun k : Fin (N+1) => (MvPolynomial.X k : MvPolynomial (Fin (N+1)) A))))
      ⟨MvPolynomial.C a, hmem⟩
  · intro p q hp hq; exact add_mem hp hq
  · intro p n hp
    exact mul_mem hp (Algebra.subset_adjoin (Set.mem_range_self n))

end Work.DSG4c.ChartPushout
