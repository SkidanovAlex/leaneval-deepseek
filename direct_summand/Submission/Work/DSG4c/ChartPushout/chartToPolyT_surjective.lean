import Mathlib
import Submission.Work.DSG4c.ChartPushout.DefsT
import Submission.Work.DSG4c.ChartPushout.prod_chartElemAllT
import Submission.Work.DSG4c.ChartPushout.algebra_adjoin_range_X

/-!
# The chart ring `Away (PGr A' N) (X i)` is generated by the coordinates `X j / X i`

This file proves `Work.DSG4c.ChartPushout.chartToPolyT_surjective`: dehomogenization
`A'[x_j : j ≠ i] → Away (PGr A' N) (coeffExt ψ (X i))`, `x_j ↦ X_j / X_i`, is onto.

The route is the affine-chart generation statement of the homogeneous localization:
`HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top` says that `Away 𝒜 f` is generated,
over its degree-zero part `𝒜 0`, by the homogeneous fractions
`(∏ k, X k ^ m k) / f ^ (∑ k, m k)`.  The source `A[x₀,…,x_N]` is generated over its degree
zero part by the variables (`algebra_adjoin_range_X`), and each of the above generators is the
image under `chartToPolyT` of the corresponding monomial (`prod_chartElemAllT`), while the
degree-zero part `𝒜 0 = A'` is the image of the constants.  Hence every element of the chart
ring is a value of `chartToPolyT`.
-/

open CategoryTheory AlgebraicGeometry Limits MvPolynomial

namespace Work.DSG4c.ChartPushout

universe u

variable (A A' : Type u) [CommRing A] [CommRing A'] (ψ : A →+* A') (N : ℕ) (i : Fin (N+1))

/-- `X_i / X_i = 1` in the chart ring. -/
lemma chartElemAllT_self : chartElemAllT A A' ψ N i i = 1 := by
  apply HomogeneousLocalization.val_injective (𝒜 := DSMap.PGr A' N)
    (x := Submonoid.powers ((coeffExt A A' ψ N) (MvPolynomial.X i)))
  rw [chartElemAllT, HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
  simp [coeffExt_X_of A A' ψ N i]

/-- The coordinate `X_k / X_i` is the image of the (affine) variable `x_k` under dehomogenization;
for `k = i` the corresponding variable is `1` (there is no coordinate `x_i`). -/
lemma chartToPolyT_gen (k : Fin (N+1)) :
    chartToPolyT A A' ψ N i (if h : k = i then 1 else MvPolynomial.X ⟨k, h⟩) =
      chartElemAllT A A' ψ N i k := by
  by_cases h : k = i
  · rw [dif_pos h, h, chartElemAllT_self A A' ψ N i, map_one]
  · rw [dif_neg h, chartToPolyT_X, chartElemT_eq_chartElemAllT]

/-- The homogeneous fraction `(∏ k, X k ^ m k) / f ^ (∑ k, m k)` is the product of the
coordinates `X_k / X_i`, with the convention that the `i`-th factor is `1`. -/
lemma awayMk_prod_eq_prod_chartElemAllT (a : ℕ) (ai : Fin (N+1) → ℕ)
    (hai : (∑ k, ai k • (1 : ℕ)) = a • (1 : ℕ))
    (hmem : (∏ k, MvPolynomial.X k ^ ai k) ∈ DSMap.PGr A' N (a • 1)) :
    HomogeneousLocalization.Away.mk (DSMap.PGr A' N) ((coeffExt A A' ψ N).2 (X_mem A N i))
        a (∏ k, MvPolynomial.X k ^ ai k) hmem =
      ∏ k, chartElemAllT A A' ψ N i k ^ (ai k) := by
  have hsum : (∑ k, ai k) = a := by simpa [nsmul_eq_mul] using hai
  subst hsum
  rw [prod_chartElemAllT A A' ψ N i ai _]

/-- `prod_chartElemAllT` read as a statement about `chartToPolyT`. -/
lemma prod_chartElemAllT_chartToPolyT (ai : Fin (N+1) → ℕ) :
    (∏ k, chartElemAllT A A' ψ N i k ^ (ai k)) =
      chartToPolyT A A' ψ N i (∏ k, (if h : k = i then (1 : MvPolynomial (chartIdx N i) A')
        else MvPolynomial.X ⟨k, h⟩) ^ (ai k)) := by
  rw [map_prod]
  refine Finset.prod_congr rfl fun k _ => ?_
  rw [map_pow, chartToPolyT_gen A A' ψ N i k]

/-- The degree-zero part of `A'[x₀,…,x_N]` consists of the constants. -/
lemma algebraMap_degreeZero_eq_C (a : A') :
    ((algebraMap A' (DSMap.PGr A' N 0)) a : MvPolynomial (Fin (N+1)) A') = MvPolynomial.C a := by
  rw [Algebra.algebraMap_eq_smul_one]
  simp [MvPolynomial.smul_eq_C_mul]

/-- The degree-zero part of the chart ring is the image of the constants under `chartToPolyT`. -/
lemma fromZeroRingHom_C_eq_chartMapT (a : A')
    (h : (MvPolynomial.C a : MvPolynomial (Fin (N+1)) A') ∈ DSMap.PGr A' N 0) :
    HomogeneousLocalization.fromZeroRingHom (DSMap.PGr A' N)
        (Submonoid.powers ((coeffExt A A' ψ N) (MvPolynomial.X i))) ⟨MvPolynomial.C a, h⟩ =
      chartMapT A A' ψ N i a := by
  rw [chartMapT, RingHom.comp_apply]
  rw [show ((algebraMap A' (DSMap.PGr A' N 0)) a : ↥(DSMap.PGr A' N 0)) =
      ⟨MvPolynomial.C a, h⟩ from Subtype.ext (algebraMap_degreeZero_eq_C A' N a)]

/-- Every element of the degree-zero part of the chart ring is a value of `chartToPolyT`. -/
lemma fromZeroRingHom_mem_range (c : ↥(DSMap.PGr A' N 0)) :
    ∃ p : MvPolynomial (chartIdx N i) A',
      chartToPolyT A A' ψ N i p =
        HomogeneousLocalization.fromZeroRingHom (DSMap.PGr A' N)
          (Submonoid.powers ((coeffExt A A' ψ N) (MvPolynomial.X i))) c := by
  obtain ⟨a, ha⟩ : ∃ a : A', (c : MvPolynomial (Fin (N+1)) A') = MvPolynomial.C a := by
    have h : (c : MvPolynomial (Fin (N+1)) A') ∈
        MvPolynomial.homogeneousSubmodule (Fin (N+1)) A' 0 := c.2
    rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at h
    obtain ⟨a, ha⟩ := h
    exact ⟨a, by rw [← ha]; rfl⟩
  refine ⟨MvPolynomial.C a, ?_⟩
  rw [chartToPolyT_C]
  rw [show c = ⟨MvPolynomial.C a, ha ▸ c.2⟩ from Subtype.ext ha]
  exact (fromZeroRingHom_C_eq_chartMapT A A' ψ N i a _).symm

/-- **Dehomogenization of the `i`-th standard chart of `ℙᴺ` is surjective.**
`A'[x_j : j ≠ i] → Away (PGr A' N) (coeffExt ψ (X i))`, `x_j ↦ X_j / X_i`, is onto: the chart
ring is generated over the degree-zero part by the homogeneous fractions
`(∏ k, X k ^ m k) / (X i) ^ (∑ k, m k)`, each of which is the image of a monomial. -/
theorem chartToPolyT_surjective (A A' : Type u) [CommRing A] [CommRing A'] (ψ : A →+* A')
    (N : ℕ) (i : Fin (N+1)) :
    Function.Surjective (Work.DSG4c.ChartPushout.chartToPolyT A A' ψ N i) := by
  have hadj := HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top
      (𝒜 := DSMap.PGr A' N) (f := (coeffExt A A' ψ N) (MvPolynomial.X i)) (d := 1)
      ((coeffExt A A' ψ N).2 (X_mem A N i))
      (Fin (N+1)) (fun k => MvPolynomial.X k) (algebra_adjoin_range_X A' N) (fun _ => 1)
      (fun k => X_mem A' N k)
  intro z
  have hz : z ∈ (⊤ : Subalgebra (↥(DSMap.PGr A' N 0)) (awayChartT A A' ψ N i)) := trivial
  rw [← hadj] at hz
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_ofPred_eq] at hx
    obtain ⟨a, ai, hai, hle, rfl⟩ := hx
    refine ⟨∏ k, (if h : k = i then (1 : MvPolynomial (chartIdx N i) A')
      else MvPolynomial.X ⟨k, h⟩) ^ (ai k), ?_⟩
    rw [awayMk_prod_eq_prod_chartElemAllT A A' ψ N i a ai hai _,
      prod_chartElemAllT_chartToPolyT A A' ψ N i ai]
  | algebraMap r =>
    rw [HomogeneousLocalization.algebraMap_eq]
    exact fromZeroRingHom_mem_range A A' ψ N i r
  | add x y hx hy ihx ihy =>
    obtain ⟨p, hp⟩ := ihx
    obtain ⟨q, hq⟩ := ihy
    exact ⟨p + q, by rw [map_add, hp, hq]⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨p, hp⟩ := ihx
    obtain ⟨q, hq⟩ := ihy
    exact ⟨p * q, by rw [map_mul, hp, hq]⟩

end Work.DSG4c.ChartPushout
