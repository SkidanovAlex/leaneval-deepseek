# DSEQP: the equal characteristic `p` route to the direct summand theorem

This is the base module of the `DSEQP` area (equal characteristic `p` case of
`#direct_summand`, frozen area statement `DSMap.area_EQP`).  It sets up the two
notions the whole area is organised around:

* `Work.DSEQP.AlmostZero` : almost mathematics in the shape used in positive
  characteristic.  The "almost" ideal is generated by a sequence `t : ℕ → R` of
  `p^e`-th roots of a fixed element of the ring `R` (in the applications `R` is the
  perfection `A^{1/p^∞}` of `A` and `t e = g^{1/p^e}`).  A module is almost zero when
  every `t e` acts trivially on it.  This is exactly the statement "the obstruction is
  killed by `g^{1/p^e}` for all `e`" that the Frobenius/perfection argument produces.

* `Work.DSEQP.evalIdeal` : for a commutative `A`-algebra `B`, the image of the
  evaluation-at-`1` map `Hom_A(B, A) → A`.  It is the precise obstruction to `A` being
  a direct summand of `B`: `1 ∈ evalIdeal A B` iff there is an `A`-linear retraction
  `B → A`.

The main theorem of the area is `Work.DSEQP.area_EQP_proved` in `DSEQP/Main.lean`.
-/
import Mathlib

open scoped TensorProduct

namespace Work.DSEQP

universe u v w

/-! ## 1. Almost mathematics with respect to a tower of `p`-power roots -/

section Almost

variable {R : Type u} [CommRing R]

/-- **Almost zero.**  A module `M` over `R` is *almost zero* with respect to the
sequence `t : ℕ → R` if every `t e` acts as zero on `M`.

In the intended application `R = A^{1/p^∞}` is the perfection of a ring `A` of
characteristic `p` and `t e = g^{1/p^e}` is a compatible system of `p`-th roots of an
element `g ∈ A`; "almost zero" then means "killed by `g^{1/p^e}` for every `e`". -/
def AlmostZero (t : ℕ → R) (M : Type v) [AddCommGroup M] [Module R M] : Prop :=
  ∀ e : ℕ, ∀ m : M, t e • m = 0

variable {t : ℕ → R} {M : Type v} [AddCommGroup M] [Module R M]

theorem almostZero_iff_forall_mem_annihilator :
    AlmostZero t M ↔ ∀ e, t e ∈ Module.annihilator R M := by
  constructor
  · intro h e
    rw [Module.mem_annihilator]
    exact h e
  · intro h e m
    exact Module.mem_annihilator.mp (h e) m

theorem almostZero_iff_span_le_annihilator :
    AlmostZero t M ↔ Ideal.span (Set.range t) ≤ Module.annihilator R M := by
  rw [almostZero_iff_forall_mem_annihilator]
  constructor
  · intro h
    rw [Ideal.span_le]
    rintro x ⟨e, rfl⟩
    exact h e
  · intro h e
    exact h (Ideal.subset_span ⟨e, rfl⟩)

protected theorem AlmostZero.subsingleton (h : AlmostZero t M)
    (h1 : (1 : R) ∈ Ideal.span (Set.range t)) : Subsingleton M :=
  have h0 : (1 : R) ∈ Module.annihilator R M :=
    (almostZero_iff_span_le_annihilator.mp h) h1
  ⟨fun m n => by
    have hmn : (1 : R) • (m - n) = 0 := Module.mem_annihilator.mp h0 _
    exact sub_eq_zero.mp (by simpa using hmn)⟩

theorem AlmostZero.mono {t' : ℕ → R} (h : AlmostZero t M)
    (ht : ∀ e, t' e ∈ Ideal.span (Set.range t)) : AlmostZero t' M := by
  have hle : Ideal.span (Set.range t) ≤ Module.annihilator R M := by
    rw [Ideal.span_le]
    rintro x ⟨k, rfl⟩
    exact (almostZero_iff_forall_mem_annihilator.mp h) k
  intro e m
  exact Module.mem_annihilator.mp (hle (ht e)) m

theorem AlmostZero.submodule (h : AlmostZero t M) (p : Submodule R M) : AlmostZero t p :=
  fun e m => Subtype.ext (h e m.1)

theorem AlmostZero.quotient (h : AlmostZero t M) (p : Submodule R M) :
    AlmostZero t (M ⧸ p) := by
  intro e x
  induction x using Submodule.Quotient.induction_on p with
  | _ m =>
    rw [← Submodule.Quotient.mk_smul, h e m, Submodule.Quotient.mk_eq_zero]
    exact Submodule.zero_mem _

theorem AlmostZero.of_linearEquiv {M' : Type v} [AddCommGroup M'] [Module R M']
    (e : M ≃ₗ[R] M') (h : AlmostZero t M) : AlmostZero t M' := by
  intro k m
  have h0 : e.symm (t k • m) = 0 := by
    rw [map_smul, h k (e.symm m)]
  exact e.symm.injective (by simpa using h0)

section Tensor

variable {N : Type w} [AddCommGroup N] [Module R N]

/-- An almost zero module stays almost zero after tensoring. -/
theorem AlmostZero.tensorProduct (h : AlmostZero t M) : AlmostZero t (M ⊗[R] N) := by
  intro e x
  induction x using TensorProduct.inductionOn with
  | tmul m n => rw [TensorProduct.smul_tmul', h e m, TensorProduct.zero_tmul]
  | add x y hx hy => rw [smul_add, hx, hy, add_zero]


end Tensor

end Almost

/-! ## 2. The evaluation ideal of a commutative algebra -/

section EvalIdeal

variable (A : Type u) [CommRing A] (B : Type v) [CommRing B] [Algebra A B]

/-- The **evaluation ideal** of a commutative `A`-algebra `B`: the image of the
evaluation-at-`1` map `Hom_A(B, A) → A`, `s ↦ s 1`.

`1 ∈ evalIdeal A B` iff `A` is a direct summand of `B` as an `A`-module. -/
noncomputable def evalIdeal : Ideal A :=
  LinearMap.range (LinearMap.applyₗ (1 : B) : (B →ₗ[A] A) →ₗ[A] A)

theorem mem_evalIdeal_iff {a : A} :
    a ∈ evalIdeal A B ↔ ∃ s : B →ₗ[A] A, s 1 = a :=
  LinearMap.mem_range

theorem one_mem_evalIdeal_iff :
    (1 : A) ∈ evalIdeal A B ↔ ∃ s : B →ₗ[A] A, s 1 = 1 :=
  mem_evalIdeal_iff A B

theorem evalIdeal_ne_bot_iff :
    evalIdeal A B ≠ ⊥ ↔ ∃ s : B →ₗ[A] A, s 1 ≠ 0 := by
  rw [Submodule.ne_bot_iff]
  constructor
  · rintro ⟨a, ha, ha0⟩
    obtain ⟨s, rfl⟩ := mem_evalIdeal_iff A B |>.1 ha
    exact ⟨s, ha0⟩
  · rintro ⟨s, hs⟩
    exact ⟨s 1, (mem_evalIdeal_iff A B).2 ⟨s, rfl⟩, hs⟩

/-- **Splitting criterion.**  `A` is a direct summand of the `A`-module `B` (equivalently,
the unit `A → B` admits an `A`-linear retraction) iff the evaluation ideal is all of `A`. -/
theorem splitting_of_one_mem_evalIdeal (h : (1 : A) ∈ evalIdeal A B) :
    ∃ π : B →ₗ[A] A, π 1 = 1 :=
  one_mem_evalIdeal_iff A B |>.1 h

/-- An `A`-linear retraction of the unit of `B` gives a splitting of `A` off `B`. -/
theorem retraction_of_eval (π : B →ₗ[A] A) (hπ : π 1 = 1) :
    π ∘ₗ Algebra.linearMap A B = 1 :=
  LinearMap.ext fun a => by
    simp [LinearMap.comp_apply, Algebra.algebraMap_eq_smul_one, hπ]

end EvalIdeal

/-! ## 3. Splinters -/

/-- `A` is a *splinter* (affine form): every finite faithful `A`-algebra `B` admits an
`A`-linear retraction `B → A`.  This is the conclusion of the direct summand conjecture
for the ring `A`. -/
def IsSplinter (A : Type u) [CommRing A] : Prop :=
  ∀ (B : Type u) [CommRing B] [Algebra A B] [Module.Finite A B],
    Function.Injective (algebraMap A B) → (1 : A) ∈ evalIdeal A B

theorem isSplinter_iff_retraction (A : Type u) [CommRing A] :
    IsSplinter A ↔ ∀ (B : Type u) [CommRing B] [Algebra A B] [Module.Finite A B],
      Function.Injective (algebraMap A B) → ∃ π : B →ₗ[A] A, π 1 = 1 := by
  constructor
  · intro h B _ _ _ hB
    exact splitting_of_one_mem_evalIdeal A B (h B hB)
  · intro h B _ _ _ hB
    obtain ⟨π, hπ⟩ := h B hB
    exact one_mem_evalIdeal_iff A B |>.2 ⟨π, hπ⟩

end Work.DSEQP
