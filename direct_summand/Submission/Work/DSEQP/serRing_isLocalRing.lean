import Mathlib
import Submission.Work.DSSER.Basic
import Submission.Work.DSSER.moduleFinite_serRing

/-!
# `R[Z]/(Z_i ^ p - z_i)` is a local ring

Let `R` be a local ring whose maximal ideal is generated by `z : Fin d → R`, let `p > 0`, and put

`S := R[Z]/(Z_i ^ p - z_i) = Work.DSSER.serRing R p z`,  `serIdeal := (Z) = Work.DSSER.serIdeal p z`.

This file proves that `S` is a local ring (`Work.DSEQP.serRing_isLocalRing`), namely that its
unique maximal ideal is `serIdeal = (Z_1, …, Z_d)`.

The argument is elementary and self-contained:

* `𝔪 · S ⊆ serIdeal`: because `Z_i ^ p = z_i` and the `z_i` generate `𝔪` (`DSSER.serZ_pow`).
* Reduction modulo `serIdeal` is `R ⧸ 𝔪`: every element of `S` is a polynomial in the `Z_i`, and it
  differs from its constant term by an element of `(Z)` (`sub_C_coeff_zero_mem_idealOfVars` and
  `map_idealOfVars_eq_serIdeal`), so each element of `S` is congruent to a constant modulo
  `serIdeal`.  The reduction `R[X] → R ⧸ 𝔪`, `X_i ↦ 0` kills `serRel` as well as `(Z)`, which
  shows `1 ∉ (Z)`.
* Hence an element `x ∉ (Z)` is congruent mod `(Z)` to a unit of `R`, so it is congruent to a unit
  of `S`; this is exactly what `Ideal.isMaximal_iff` needs: no proper ideal strictly contains `(Z)`.
* Finally `S` is a finite (hence integral) `R`-algebra, so every maximal ideal of `S` contracts to
  `𝔪`; such an ideal contains `serZ i ^ p = z_i` for all `i` and hence contains `serZ i`, so it
  contains `(Z)`.  As `(Z)` is maximal, `(Z)` is the unique maximal ideal of `S`.
-/

universe u

namespace Work.DSEQP

open IsLocalRing

set_option linter.style.haveILetI false

section Aux

variable {R : Type u} [CommRing R] {p d : ℕ} {z : Fin d → R}

/-- A polynomial differs from its constant term by an element of the ideal generated by the
variables. -/
theorem sub_C_coeff_zero_mem_idealOfVars (f : MvPolynomial (Fin d) R) :
    f - MvPolynomial.C (f.coeff 0) ∈ MvPolynomial.idealOfVars (Fin d) R := by
  rw [MvPolynomial.idealOfVars, ← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  by_contra h
  simp only [Set.mem_univ, not_exists] at h
  have hm0 : m = 0 := Finsupp.ext (fun i => by simpa using h i)
  have hzero : (f - MvPolynomial.C (f.coeff 0)).coeff 0 = 0 := by
    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_zero_C, sub_self]
  exact (MvPolynomial.mem_support_iff.mp (hm0 ▸ hm)) hzero

/-- Reduction modulo `serIdeal = (Z)` turns the ideal generated by the variables into `serIdeal`:
`R[X] → S = R[X]/(Z_i ^ p - z_i)` sends `X_i` to `serZ i`. -/
theorem map_idealOfVars_eq_serIdeal (p : ℕ) (z : Fin d → R) :
    Ideal.map (Ideal.Quotient.mk (Work.DSSER.serRel R p z))
        (MvPolynomial.idealOfVars (Fin d) R) = Work.DSSER.serIdeal p z := by
  rw [MvPolynomial.idealOfVars, Work.DSSER.serIdeal, Ideal.map_span, ← Set.range_comp]
  rfl

/-- Every element of `S = R[Z]/(Z_i ^ p - z_i)` is congruent to a constant modulo `serIdeal`. -/
theorem exists_sub_algebraMap_mem_serIdeal (p : ℕ) (z : Fin d → R)
    (s : Work.DSSER.serRing R p z) :
    ∃ r : R, s - algebraMap R (Work.DSSER.serRing R p z) r ∈ Work.DSSER.serIdeal p z := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective (I := Work.DSSER.serRel R p z) s
  refine ⟨f.coeff 0, ?_⟩
  have hw : f - MvPolynomial.C (f.coeff 0) ∈ MvPolynomial.idealOfVars (Fin d) R :=
    sub_C_coeff_zero_mem_idealOfVars f
  have hmem : Ideal.Quotient.mk (Work.DSSER.serRel R p z) (f - MvPolynomial.C (f.coeff 0))
      ∈ Work.DSSER.serIdeal p z := by
    rw [← map_idealOfVars_eq_serIdeal (R := R) p z]
    exact Ideal.mem_map_of_mem _ hw
  rwa [map_sub, MvPolynomial.C_eq_algebraMap, Ideal.Quotient.mk_algebraMap] at hmem

/-- The image of the maximal ideal of `R` in `S` is contained in `serIdeal = (Z)`. -/
theorem map_maximalIdeal_le_serIdeal [IsLocalRing R] (p : ℕ) (hp : 0 < p) (z : Fin d → R)
    (hz : Ideal.span (Set.range z) = maximalIdeal R) :
    Ideal.map (algebraMap R (Work.DSSER.serRing R p z)) (maximalIdeal R)
      ≤ Work.DSSER.serIdeal p z := by
  rw [← hz, Ideal.map_span, ← Set.range_comp]
  refine Ideal.span_le.mpr fun x hx => ?_
  obtain ⟨i, rfl⟩ := hx
  simp only [Function.comp_apply]
  rw [← Work.DSSER.serZ_pow (p := p) (z := z) i]
  exact Ideal.pow_le_self hp.ne' (Ideal.pow_mem_pow (Work.DSSER.serZ_mem_serIdeal i) p)

end Aux

theorem serRing_isLocalRing (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (p : ℕ) (hp : 0 < p) {d : ℕ} (z : Fin d → R)
    (hz : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal R) :
    IsLocalRing (Work.DSSER.serRing R p z) := by
  classical
  have hmS := map_maximalIdeal_le_serIdeal (R := R) p hp z hz
  -- ## The reduction `S → R ⧸ 𝔪` killing `(Z)`, which shows that `(Z)` is proper
  let φ₀ : MvPolynomial (Fin d) R →+* R ⧸ IsLocalRing.maximalIdeal R :=
    MvPolynomial.eval₂Hom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) fun _ => 0
  have hφ₀X : ∀ i, φ₀ (MvPolynomial.X i) = 0 := fun i => MvPolynomial.eval₂Hom_X' _ _ i
  have hφ₀C : ∀ a : R, φ₀ (MvPolynomial.C a)
      = Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) a := fun a => MvPolynomial.eval₂Hom_C _ _ a
  have hserRel : Work.DSSER.serRel R p z ≤ RingHom.ker φ₀ := by
    rw [Work.DSSER.serRel, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    have hzi : z i ∈ IsLocalRing.maximalIdeal R := hz ▸ Ideal.subset_span (Set.mem_range_self i)
    have hzero : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) (z i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hzi
    refine RingHom.mem_ker.mpr ?_
    show φ₀ (MvPolynomial.X i ^ p - MvPolynomial.C (z i)) = 0
    rw [map_sub, map_pow, hφ₀X i, hφ₀C (z i), hzero, zero_pow hp.ne']
    simp
  let φ : Work.DSSER.serRing R p z →+* R ⧸ IsLocalRing.maximalIdeal R :=
    Ideal.Quotient.lift (Work.DSSER.serRel R p z) φ₀ fun a ha => (RingHom.mem_ker.mp (hserRel ha))
  have hφZ : ∀ i, φ (Work.DSSER.serZ p z i) = 0 := by
    intro i
    show φ (Ideal.Quotient.mk (Work.DSSER.serRel R p z) (MvPolynomial.X i)) = 0
    rw [Ideal.Quotient.lift_mk]
    exact hφ₀X i
  have hserIdeal_ker : Work.DSSER.serIdeal p z ≤ RingHom.ker φ := by
    rw [Work.DSSER.serIdeal, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact RingHom.mem_ker.mpr (hφZ i)
  haveI : Field (R ⧸ IsLocalRing.maximalIdeal R) :=
    Ideal.Quotient.field (IsLocalRing.maximalIdeal R)
  have hone_ne : (1 : R ⧸ IsLocalRing.maximalIdeal R) ≠ 0 := one_ne_zero
  have hone_not_mem : (1 : Work.DSSER.serRing R p z) ∉ Work.DSSER.serIdeal p z := by
    intro h1
    have h2 : φ 1 = 0 := RingHom.mem_ker.mp (hserIdeal_ker h1)
    rw [map_one] at h2
    exact hone_ne h2
  -- ## `serIdeal` is maximal: modulo it, everything is congruent to a constant
  have hmax : (Work.DSSER.serIdeal p z).IsMaximal := by
    refine Ideal.isMaximal_iff.mpr ⟨hone_not_mem, ?_⟩
    intro J x hle hxI hxJ
    obtain ⟨r, hr⟩ := exists_sub_algebraMap_mem_serIdeal (R := R) p z x
    have hr_not_mem : r ∉ IsLocalRing.maximalIdeal R := by
      intro hrm
      refine hxI ?_
      have h1 : algebraMap R (Work.DSSER.serRing R p z) r ∈ Work.DSSER.serIdeal p z :=
        hmS (Ideal.mem_map_of_mem _ hrm)
      have h2 : x = algebraMap R (Work.DSSER.serRing R p z) r
          + (x - algebraMap R (Work.DSSER.serRing R p z) r) := by ring
      rw [h2]
      exact Ideal.add_mem _ h1 hr
    have halg : algebraMap R (Work.DSSER.serRing R p z) r ∈ J := by
      have h2 : algebraMap R (Work.DSSER.serRing R p z) r
          = x - (x - algebraMap R (Work.DSSER.serRing R p z) r) := by ring
      rw [h2]
      exact J.sub_mem hxJ (hle hr)
    obtain ⟨u, hu⟩ := (IsLocalRing.notMem_maximalIdeal.mp hr_not_mem).map
      (algebraMap R (Work.DSSER.serRing R p z))
    have h1 : (1 : Work.DSSER.serRing R p z)
        = ↑u⁻¹ * algebraMap R (Work.DSSER.serRing R p z) r := by
      rw [← hu]; simp
    rw [h1]
    exact J.mul_mem_left _ halg
  -- ## `serIdeal` is the only maximal ideal
  refine IsLocalRing.of_unique_max_ideal ⟨Work.DSSER.serIdeal p z, hmax, fun J hJ => ?_⟩
  haveI : Module.Finite R (Work.DSSER.serRing R p z) := Work.DSSER.moduleFinite_serRing R p hp z
  haveI : Algebra.IsIntegral R (Work.DSSER.serRing R p z) := inferInstance
  haveI : J.IsMaximal := hJ
  have hJm : J.under R = IsLocalRing.maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := R)
        (S := Work.DSSER.serRing R p z) J)
  have hzmem : ∀ i, Work.DSSER.serZ p z i ∈ J := by
    intro i
    have h1 : z i ∈ J.under R := by
      rw [hJm]
      exact hz ▸ Ideal.subset_span (Set.mem_range_self i)
    have h2 : algebraMap R (Work.DSSER.serRing R p z) (z i) ∈ J := h1
    rw [← Work.DSSER.serZ_pow (p := p) (z := z) i] at h2
    exact (Ideal.IsMaximal.isPrime hJ).mem_of_pow_mem p h2
  have hle : Work.DSSER.serIdeal p z ≤ J := by
    rw [Work.DSSER.serIdeal, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact hzmem i
  exact (hmax.eq_of_le hJ.ne_top hle).symm

end Work.DSEQP
