# Kunz's theorem for complete regular local rings with perfect residue field (area `KUNZ`)

This file proves `Work.DSEQP.area_KUNZ_proved`: for a complete regular local ring `A` of
characteristic `p` with **perfect residue field**, the Frobenius endomorphism `x ↦ x ^ p` is flat.

## The argument (no Cohen structure theorem, no Hilbert-function input)

Let `𝔪` be the maximal ideal of `A`, `d = spanFinrank 𝔪` (so `d = ringKrullDim A` since `A` is
regular, and `𝔪` is generated by `d` elements `z : Fin d → A`), and let

`R' := A[Z₁,…,Z_d]/(Z_i ^ p - z_i) = Work.DSSER.serRing A p z`,

the `p`-th root ring of the series lemma `Work.DSSER.area_SER_proved` (`DSSER`).

* By `SER` in characteristic `p`, every `x : A` is a `p`-th power in `R'` (the `p · h` term
  vanishes), i.e. `ψ (b) ^ p = x ^ p` for `ψ` the ring map `R' → A`, `Z_i ↦ z_i`, `a ↦ a ^ p`.
  Since `A` is a domain of characteristic `p`, `y ^ p = x ^ p` forces `y = x`, so `ψ` is
  **surjective**.
* `ψ` is surjective onto `A` of dimension `d`, so `ringKrullDim R' ≥ d`; and
  `ringKrullDim R' ≤ spanFinrank (maximalIdeal R') ≤ d` because the maximal ideal of the local
  ring `R'` is `(Z₁,…,Z_d)`. Hence `ringKrullDim R' = d = spanFinrank (maximalIdeal R')`:
  `R'` is a **regular local ring**, and therefore a **domain** by `DSMap.area_REG_proved`.
* `ker ψ` is an ideal of the domain `R'` with `ringKrullDim (R' ⧸ ker ψ) = ringKrullDim A = d`;
  by `Work.DSREG.DomainIdealBot.eq_bot_of_ringKrullDim_quotient_eq` it is `⊥`. So `ψ` is a ring
  isomorphism.
* Finally `R'` is a **free** `A`-module (division by the monic relations `Z_i ^ p - z_i`), so
  `ψ` exhibits `frobenius A p = ψ ∘ (algebraMap A R')` as a composite of flat ring maps:
  `algebraMap A R'` is flat because `R'` is free over `A`, and `ψ` is flat because it is
  bijective. Hence `(frobenius A p).Flat`.

The three facts about the ring `R'` used above (freeness over `A`, locality, maximality of the
ideal `(Z)`) are proved in the companion files `serRing_free.lean`,
`serRing_isLocalRing.lean` and `serIdeal_isMaximal.lean`.
-/
import Mathlib
import Submission.Work.DSSER.Main
import Submission.Work.DSREG.Main
import Submission.Work.DSREG.DomainIdealBot.eq_bot_of_ringKrullDim_quotient_eq
import Submission.Work.DSEQP.serIdeal_isMaximal
import Submission.Work.DSEQP.serRing_isLocalRing
import Submission.Work.DSEQP.serRing_free

set_option linter.style.haveILetI false

open MvPolynomial IsLocalRing

namespace Work.DSEQP

universe a

/-- **Area `KUNZ`, assembly.**  The main proof of `area_KUNZ_proved`, taking as hypotheses the
three ring-theoretic facts about the `p`-th root ring `R' = A[Z]/(Z_i ^ p - z_i)` that are proved
in the companion files (freeness over `A`, locality, maximality of the ideal `(Z)`). -/
theorem area_KUNZ_aux (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (IsLocalRing.maximalIdeal A) A] [PerfectField (IsLocalRing.ResidueField A)]
    (p : ℕ) [Fact p.Prime] [CharP A p]
    (hLoc : ∀ {d : ℕ} (z : Fin d → A), 0 < p →
      Ideal.span (Set.range z) = IsLocalRing.maximalIdeal A →
      IsLocalRing (Work.DSSER.serRing A p z))
    (hMax : ∀ {d : ℕ} (z : Fin d → A), 0 < p →
      Ideal.span (Set.range z) = IsLocalRing.maximalIdeal A →
      (Work.DSSER.serIdeal p z).IsMaximal)
    (hFree : ∀ {d : ℕ} (z : Fin d → A), 0 < p →
      Module.Free A (Work.DSSER.serRing A p z)) :
    (frobenius A p).Flat := by
  classical
  -- `A` is a domain, by DSREG (regular local rings are domains)
  haveI hdomA : IsDomain A := DSMap.area_REG_proved A
  have hp0 : 0 < p := (Fact.out : p.Prime).pos
  -- a regular system of parameters `z : Fin d → A`
  set d : ℕ := (IsLocalRing.maximalIdeal A).spanFinrank with hd_def
  have hds : (d : WithBot ℕ∞) = ringKrullDim A := by
    rw [hd_def]
    exact IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  obtain ⟨s, hs_card, hs_span⟩ :=
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A)).exists_span_finset_card_eq_spanFinrank
  let z : Fin d → A := fun i => ((Finset.equivFinOfCardEq hs_card).symm i : A)
  have hzrange : Set.range z = (s : Set A) := by
    ext x; constructor
    · rintro ⟨i, rfl⟩; exact ((Finset.equivFinOfCardEq hs_card).symm i).2
    · intro hx
      exact ⟨Finset.equivFinOfCardEq hs_card ⟨x, hx⟩, by simp [z]⟩
  have hz : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal A := by
    rw [hzrange]; exact hs_span
  -- the ring hom `ψ : A[Z]/(Z_i ^ p - z_i) → A`, `Z_i ↦ z i`, `a ↦ a ^ p`
  let φ : MvPolynomial (Fin d) A →+* A := MvPolynomial.eval₂Hom (frobenius A p) z
  have hφZ : ∀ i, φ (MvPolynomial.X i) = z i := fun i => MvPolynomial.eval₂Hom_X' _ _ i
  have hφC : ∀ a, φ (MvPolynomial.C a) = a ^ p := fun a => by
    rw [MvPolynomial.eval₂Hom_C, frobenius_def]
  have hφrel : Work.DSSER.serRel A p z ≤ RingHom.ker φ := by
    rw [Work.DSSER.serRel, Ideal.span_le]
    rintro f ⟨i, rfl⟩
    show φ (MvPolynomial.X i ^ p - MvPolynomial.C (z i)) = 0
    rw [map_sub, map_pow, hφZ, hφC, sub_self]
  let ψ : Work.DSSER.serRing A p z →+* A :=
    Ideal.Quotient.lift (Work.DSSER.serRel A p z) φ (fun a ha => RingHom.mem_ker.mp (hφrel ha))
  have hψZ : ∀ i, ψ (Work.DSSER.serZ p z i) = z i := by
    intro i; rw [Work.DSSER.serZ, Ideal.Quotient.lift_mk]; exact hφZ i
  have hψC : ∀ a, ψ (algebraMap A (Work.DSSER.serRing A p z) a) = a ^ p := by
    intro a
    have h1 : algebraMap A (Work.DSSER.serRing A p z) a
        = Ideal.Quotient.mk (Work.DSSER.serRel A p z) (MvPolynomial.C a) := by
      rw [MvPolynomial.C_eq_algebraMap]
      exact (Ideal.Quotient.mk_algebraMap A (Work.DSSER.serRel A p z) a).symm
    rw [h1, Ideal.Quotient.lift_mk]
    exact hφC a
  -- the residue field is perfect: it has characteristic `p`
  haveI hcharK : CharP (IsLocalRing.ResidueField A) p :=
    CharP.of_ringHom_of_ne_zero (IsLocalRing.residue A) p (Nat.Prime.ne_zero Fact.out)
  have hperf : ∀ x : A, ∃ μ : A, x - μ ^ p ∈ IsLocalRing.maximalIdeal A := by
    intro x
    haveI : PerfectRing (IsLocalRing.ResidueField A) p := PerfectField.toPerfectRing p
    obtain ⟨ν, hν⟩ := (PerfectRing.bijective_frobenius (R := IsLocalRing.ResidueField A) (p := p)).2
      (IsLocalRing.residue A x)
    obtain ⟨μ, hμ⟩ := IsLocalRing.residue_surjective ν
    refine ⟨μ, ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, hμ]
    exact sub_eq_zero.mpr hν.symm
  -- `ψ` is surjective: `SER` produces a `p`-th root of `x` in `R'`
  have hψsurj : Function.Surjective ψ := by
    intro x
    obtain ⟨b, h, hb, -⟩ := Work.DSSER.area_SER_proved p A
      (by rw [CharP.cast_eq_zero]; exact zero_mem _) hperf z hz x
    set b' : Work.DSSER.serRing A p z := b with hb'def
    set h' : Work.DSSER.serRing A p z := h with hh'def
    have hb' : b' ^ p = algebraMap A (Work.DSSER.serRing A p z) x + (p : A) • h' := by
      rw [hb'def, hh'def]; exact hb
    have hbp : b' ^ p = algebraMap A (Work.DSSER.serRing A p z) x := by
      rw [hb', CharP.cast_eq_zero A p, zero_smul, add_zero]
    refine ⟨b', ?_⟩
    have h1 : (ψ b') ^ p = x ^ p := by
      rw [← map_pow ψ b' p, hbp, hψC x]
    have h2 : ψ b' - x = 0 := by
      have h3 : (ψ b' - x) ^ p = 0 := by rw [sub_pow_char, h1, sub_self]
      exact (pow_eq_zero_iff (Nat.Prime.ne_zero Fact.out)).mp h3
    exact sub_eq_zero.mp h2
  -- dimension bookkeeping: `R'` is a regular local ring of dimension `d`
  haveI hlocRing : IsLocalRing (Work.DSSER.serRing A p z) := hLoc z hp0 hz
  have hmax : IsLocalRing.maximalIdeal (Work.DSSER.serRing A p z) = Work.DSSER.serIdeal p z :=
    (IsLocalRing.eq_maximalIdeal (hMax z hp0 hz)).symm
  have hspan_le : (IsLocalRing.maximalIdeal (Work.DSSER.serRing A p z)).spanFinrank ≤ d := by
    rw [hmax, Work.DSSER.serIdeal]
    refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)) ?_
    have heq : Set.range (Work.DSSER.serZ p z) = ↑(Finset.univ.image (Work.DSSER.serZ p z)) := by
      ext y; simp
    rw [heq, Set.ncard_coe_finset]
    calc (Finset.univ.image (Work.DSSER.serZ p z)).card
        ≤ (Finset.univ : Finset (Fin d)).card := Finset.card_image_le
      _ = d := by simp
  have hdim_le : ringKrullDim (Work.DSSER.serRing A p z) ≤ (d : WithBot ℕ∞) :=
    le_trans (ringKrullDim_le_spanFinrank_maximalIdeal _) (by exact_mod_cast hspan_le)
  have hdim_ge : (d : WithBot ℕ∞) ≤ ringKrullDim (Work.DSSER.serRing A p z) := by
    rw [hds]
    exact ringKrullDim_le_of_surjective ψ hψsurj
  have hdim_eq : ringKrullDim (Work.DSSER.serRing A p z) = (d : WithBot ℕ∞) :=
    le_antisymm hdim_le hdim_ge
  haveI hreg : IsRegularLocalRing (Work.DSSER.serRing A p z) :=
    IsRegularLocalRing.of_spanFinrank_maximalIdeal_le (R := Work.DSSER.serRing A p z) (by
      rw [hdim_eq]; exact_mod_cast hspan_le)
  haveI hdomR : IsDomain (Work.DSSER.serRing A p z) := DSMap.area_REG_proved _
  -- `ker ψ = ⊥`
  have hI : RingHom.ker ψ = ⊥ := by
    refine Work.DSREG.DomainIdealBot.eq_bot_of_ringKrullDim_quotient_eq _ (RingHom.ker ψ) d
      hdim_eq ?_
    rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective (f := ψ) hψsurj)]
    exact hds.symm
  have hψinj : Function.Injective ψ := (RingHom.injective_iff_ker_eq_bot ψ).mpr hI
  -- conclude: `frobenius = ψ ∘ algebraMap` is a composite of flat maps
  haveI hfreeRing : Module.Free A (Work.DSSER.serRing A p z) := hFree z hp0
  have hC : (algebraMap A (Work.DSSER.serRing A p z)).Flat :=
    RingHom.flat_algebraMap_iff.mpr (Module.Flat.of_free)
  have hψflat : ψ.Flat := RingHom.Flat.of_bijective ⟨hψinj, hψsurj⟩
  have hcomp : (ψ.comp (algebraMap A (Work.DSSER.serRing A p z))).Flat := hC.comp hψflat
  have heq : ψ.comp (algebraMap A (Work.DSSER.serRing A p z)) = frobenius A p := by
    ext a; exact hψC a
  rwa [heq] at hcomp

/-- **Kunz's theorem** (`area_KUNZ`): the Frobenius of a complete regular local ring of
characteristic `p` with perfect residue field is flat. -/
theorem area_KUNZ_proved (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)] (p : ℕ) [Fact p.Prime]
    [CharP A p] : (frobenius A p).Flat :=
  area_KUNZ_aux A p
    (fun {d} z hp hz => serRing_isLocalRing A p hp z hz)
    (fun {d} z hp hz => serIdeal_isMaximal A p hp z hz)
    (fun {d} z hp => serRing_free A p hp z)

end Work.DSEQP
