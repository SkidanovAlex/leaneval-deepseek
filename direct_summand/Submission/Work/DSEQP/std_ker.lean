/-
DSEQP: the standard-form map `std` vanishes on the ideal of relations `serRel`.

`serRel R p z` is the ideal `(X i ^ p - C (z i))_i` of `MvPolynomial (Fin d) R`.  The map
`std R p z` (`BoxDefs.lean`) is the `R`-linear "standard form" which reads off, from a
polynomial, the coefficients of its normal form on the box monomials `Z^u`; on a monomial it
reduces the exponents modulo `p` and replaces `X i ^ p` by `z i`.

The proof has three steps.

* On a monomial times a *single* generator, `std` vanishes:
  `std (monomial v e * (X k ^ p - C (z k))) = 0`.  Multiplication by `X k ^ p` shifts the
  exponent vector by `single k p`, which does not change the residues modulo `p` and increases
  the quotient `v k / p` by `1`; hence the two sides of the relation have the same standard form
  (`std_mul_gen_monomial`).
* By `R`-linearity and `MvPolynomial.as_sum`, the same holds for an arbitrary polynomial `a` in
  place of the monomial (`std_mul_gen`).
* The ideal `serRel` generated by the finitely many `f k = X k ^ p - C (z k)` is exactly the set
  of finite sums `∑ k, c k * f k` (`Ideal.mem_span_range_iff_exists_fun`), so by linearity again
  `std` vanishes on all of `serRel` (`std_ker`).
-/
import Mathlib
import Submission.Work.DSEQP.BoxDefs
import Submission.Work.DSEQP.StdBasic
import Submission.Work.DSSER.Basic

namespace Work.DSEQP

open MvPolynomial

/-- `std` kills `monomial v e * (X k ^ p - C (z k))` (the monomial case of `std_mul_gen`). -/
theorem std_mul_gen_monomial (R : Type*) [CommRing R] (p : ℕ) (hp : 0 < p) {d : ℕ}
    (z : Fin d → R) (v : Fin d →₀ ℕ) (e : R) (k : Fin d) :
    std R p z (MvPolynomial.monomial v e * (MvPolynomial.X k ^ p - MvPolynomial.C (z k))) = 0 := by
  have hone : (MvPolynomial.monomial v e : MvPolynomial (Fin d) R)
      = e • MvPolynomial.monomial v 1 := by
    rw [← MvPolynomial.C_mul', MvPolynomial.C_mul_monomial, mul_one]
  have hX : MvPolynomial.monomial v e * MvPolynomial.X k ^ p
      = e • MvPolynomial.monomial (v + Finsupp.single k p) 1 := by
    rw [hone, smul_mul_assoc,
      ← MvPolynomial.monomial_add_single (s := v) (n := k) (e := p) (a := 1)]
  have hC : MvPolynomial.monomial v e * MvPolynomial.C (z k)
      = e • MvPolynomial.monomial v (z k) := by
    rw [hone, smul_mul_assoc, MvPolynomial.C_apply, MvPolynomial.monomial_mul_monomial,
      add_zero, one_mul]
  have hmod : ∀ j, (v + Finsupp.single k p) j % p = v j % p := by
    intro j
    rw [Finsupp.add_apply, Finsupp.single_apply]
    by_cases hj : k = j
    · rw [if_pos hj, Nat.add_mod_right]
    · rw [if_neg hj, add_zero]
  have hdivfunc : (fun j => (v + Finsupp.single k p) j / p) = (fun j => v j / p) + Pi.single k 1 := by
    funext j
    rw [Pi.add_apply, Finsupp.add_apply, Finsupp.single_apply, Pi.single_apply]
    by_cases hj : k = j
    · rw [if_pos hj, if_pos hj.symm]
      have h1 : (v j + 1 * p) / p = v j / p + 1 := Nat.add_mul_div_right (v j) 1 hp
      rw [one_mul] at h1
      exact h1
    · rw [if_neg hj, if_neg (fun h => hj h.symm), add_zero, add_zero]
  have hF : (fun u : Fin d → Fin p => if ∀ i, (v + Finsupp.single k p) i % p = (u i : ℕ)
        then Work.DSSER.zMono z (fun i => (v + Finsupp.single k p) i / p) else 0)
      = (z k) • (fun u : Fin d → Fin p => if ∀ i, v i % p = (u i : ℕ)
        then Work.DSSER.zMono z (fun i => v i / p) else 0) := by
    funext u
    rw [Pi.smul_apply, smul_eq_mul, hdivfunc, Work.DSSER.zMono_add_single]
    have hcond : (∀ i, (v + Finsupp.single k p) i % p = (u i : ℕ)) ↔ (∀ i, v i % p = (u i : ℕ)) :=
      forall_congr' fun i => by rw [hmod i]
    by_cases h : ∀ i, v i % p = (u i : ℕ)
    · rw [if_pos (hcond.mpr h), if_pos h, mul_comm]
    · rw [if_neg (fun hh => h (hcond.mp hh)), if_neg h, mul_zero]
  rw [mul_sub, map_sub, hX, hC, map_smul, map_smul, std_monomial, std_monomial]
  rw [hF, one_smul, sub_self]

/-- `std` kills `a * (X k ^ p - C (z k))` for every `a`: multiplying the relation by an
arbitrary polynomial does not move it out of the kernel of `std`. -/
theorem std_mul_gen (R : Type*) [CommRing R] (p : ℕ) (hp : 0 < p) {d : ℕ} (z : Fin d → R)
    (a : MvPolynomial (Fin d) R) (k : Fin d) :
    std R p z (a * (MvPolynomial.X k ^ p - MvPolynomial.C (z k))) = 0 := by
  conv_lhs => rw [MvPolynomial.as_sum a]
  rw [Finset.sum_mul, map_sum]
  exact Finset.sum_eq_zero fun v _ => std_mul_gen_monomial R p hp z v (a.coeff v) k

/-- `std` vanishes on the ideal `serRel p z = (X i ^ p - z i)_i`: every element of the ideal is a
finite sum `∑ k, c k * (X k ^ p - C (z k))`. -/
theorem std_ker (R : Type*) [CommRing R] (p : ℕ) (hp : 0 < p) {d : ℕ} (z : Fin d → R)
    {x : MvPolynomial (Fin d) R} (hx : x ∈ Work.DSSER.serRel R p z) : Work.DSEQP.std R p z x = 0 := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx
  rw [← hc, map_sum]
  exact Finset.sum_eq_zero fun k _ => std_mul_gen R p hp z (c k) k

end Work.DSEQP
