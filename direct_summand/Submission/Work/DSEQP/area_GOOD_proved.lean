import Mathlib
import Submission.Work.DSMap.Gaps
import Submission.Work.DSG3.Basic

/-!
# `area_GOOD`: a good coordinate for a generically finite projective cover

`Work.DSEQP.area_GOOD_proved` is the (characteristic-free) statement `DSMap.Gaps.area_GOOD`:
for `A` a Noetherian domain, `X` integral, `f : X ⟶ Spec A` proper, surjective, generically
finite and projective, there is `g ≠ 0`, an embedding `i : X ↪ ℙᴺ_A` over `A` and a coordinate
`j` such that `f⁻¹ D(g)` is contained in the chart `X ∩ D₊(x_j)`.

The proof is the one recorded in the design note `direct_summand_gaps_1013.md`.
`IsGenFinite` gives `g₀ ≠ 0` with `f` finite over `D(g₀)`.  Since `X` is integral, its generic
point `η` exists and `f η` is the generic point of `Spec A`; since `f` is finite over `D(g₀)`,
the fibre `f ⁻¹' {η}` is *discrete* (the fibre of a finite morphism is Artinian), and it is
irreducible (it contains `η`), hence a single point, namely `η`.  That point lies in some chart
`D₊(x_j)` of the given projective embedding.  The complement `Z` of that chart is closed, so
`f '' Z` is closed (properness), and it does not contain the generic point of `Spec A`; hence it
is contained in `V(g)` for some `g ≠ 0`, and `f⁻¹ D(g) ⊆ X ∖ Z` is contained in the chart.
-/

universe a

open CategoryTheory AlgebraicGeometry

namespace Work.DSEQP

open DSMap DSMap.Mix2

section Topology

/-- In a topological space, a discrete subset containing a generic point is a singleton.
(Any `x ∈ S` is isolated in `S` by an open `u`; since `x ∈ closure {y} = ⊤`, the open `u` meets
`{y}`, so `y ∈ u`, and `y ∈ u ∩ S = {x}`.) -/
theorem eq_of_mem_of_isDiscrete_of_closure_eq_univ {X : Type*} [TopologicalSpace X] {S : Set X}
    {y x : X} (hd : _root_.IsDiscrete S) (hy : y ∈ S) (hcl : closure ({y} : Set X) = ⊤)
    (hx : x ∈ S) : x = y := by
  obtain ⟨u, huopen, hu⟩ := (isDiscrete_iff_forall_mem_exists_isOpen.mp hd) x hx
  have hxmem : x ∈ u ∩ S := by rw [hu]; exact rfl
  have hxu : x ∈ u := hxmem.1
  have hxcl : x ∈ closure ({y} : Set X) := by rw [hcl]; trivial
  obtain ⟨w, hwu, hwy⟩ := (mem_closure_iff.mp hxcl) u huopen hxu
  rw [Set.mem_singleton_iff] at hwy
  have hyu : y ∈ u := hwy ▸ hwu
  have hyx : y = x := by
    have : y ∈ u ∩ S := ⟨hyu, hy⟩
    rw [hu] at this
    exact this
  exact hyx.symm

/-- A surjective morphism from an irreducible scheme sends the generic point to the generic point
of `Spec A` (`A` a domain). -/
theorem map_genericPoint_eq_genericPointOfSpec {A : Type*} [CommRing A] [IsDomain A]
    (X : Scheme) [IrreducibleSpace X] (f : X ⟶ Spec (.of A)) (hs : Function.Surjective f) :
    f (genericPoint X) = DSMap.genericPointOfSpec A := by
  refine IsGenericPoint.eq ?_ (DSMap.isGenericPoint_genericPointOfSpec A)
  have h1 : IsGenericPoint (f (genericPoint (↥X))) (closure (f '' (Set.univ : Set ↥X))) :=
    (genericPoint_spec (↥X)).image f.continuous
  rw [Set.image_univ, hs.range_eq, closure_univ] at h1
  exact h1

end Topology

section SchemeAux

attribute [local instance] MvPolynomial.gradedAlgebra

/-- A homogeneous element of positive degree of a polynomial ring lies in the ideal generated by
the variables. -/
theorem mem_span_X_of_mem_homogeneousSubmodule_pos {A : Type*} [CommRing A] {N : ℕ} {n : ℕ}
    (hn : 0 < n) {f : MvPolynomial (Fin (N + 1)) A}
    (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A n) :
    f ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) A)) := by
  have h : f ∈ MvPolynomial.idealOfVars (Fin (N + 1)) A ^ 1 := by
    rw [MvPolynomial.mem_pow_idealOfVars_iff']
    intro d hd
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp hf |>.coeff_eq_zero (by omega)
  simpa [MvPolynomial.idealOfVars, pow_one] using h

/-- The standard charts `D₊(x_j)` cover the projective space `ℙᴺ_A`: the image of any point under
any morphism `i : X ⟶ ℙᴺ_A` lies in one of them. -/
theorem good_projChart (A : Type*) [CommRing A] (N : ℕ) {X : Scheme} (i : X ⟶ DSMap.PSpace A N)
    (p : X) : ∃ j : Fin (N + 1), p ∈ DSMap.Mix2.chartCover i ⟨j⟩ := by
  have hcover : (⨆ j : Fin (N + 1),
      Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)) = ⊤ := by
    refine Proj.iSup_basicOpen_eq_top (DSMap.PGr A N)
      (f := fun j : Fin (N + 1) => MvPolynomial.X j) ?_
    rw [HomogeneousIdeal.irrelevant_eq_span]
    refine Ideal.span_le.mpr ?_
    rintro x hx
    simp only [Set.mem_iUnion, SetLike.mem_coe] at hx
    obtain ⟨n, hn, hx⟩ := hx
    exact mem_span_X_of_mem_homogeneousSubmodule_pos hn hx
  have hx : i p ∈ (⨆ j : Fin (N + 1),
      Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)) := by rw [hcover]; trivial
  obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  refine ⟨j, ?_⟩
  show p ∈ i ⁻¹ᵁ Proj.basicOpen (DSMap.PGr A N) (MvPolynomial.X j)
  rw [Scheme.Hom.mem_preimage]
  exact hj

set_option backward.isDefEq.respectTransparency false in
/-- A finite morphism restricted to an open `V ∋ y` has a discrete fibre over `y`. -/
theorem good_isDiscrete_preimage_singleton {X Y : Scheme} (f : X ⟶ Y) (V : Y.Opens) {y : Y}
    (hy : y ∈ V) (hfin : IsFinite (f ∣_ V)) : _root_.IsDiscrete (f ⁻¹' {y}) := by
  haveI : IsFinite (f ∣_ V) := hfin
  have hd : _root_.IsDiscrete ((f ∣_ V) ⁻¹' {(⟨y, hy⟩ : ↥V)}) :=
    Scheme.Hom.isDiscrete_preimage_singleton (f ∣_ V) ⟨y, hy⟩
  have himg : ⇑(f ⁻¹ᵁ V).ι '' ((f ∣_ V) ⁻¹' {(⟨y, hy⟩ : ↥V)}) = f ⁻¹' {y} := by
    ext z
    constructor
    · rintro ⟨w, hw, rfl⟩
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      have key : V.ι ((f ∣_ V) w) = f ((f ⁻¹ᵁ V).ι w) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι]
      rw [← key, hw, Scheme.Opens.ι_apply]
    · intro hz
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hz
      have hzV : z ∈ f ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hz]; exact hy
      refine ⟨⟨z, hzV⟩, ?_, rfl⟩
      refine Subtype.ext ?_
      show ((f ∣_ V) (⟨z, hzV⟩ : ↥(f ⁻¹ᵁ V))).1 = y
      rw [AlgebraicGeometry.morphismRestrict_base_coe]
      exact hz
  rw [← himg]
  exact hd.image (Scheme.Hom.isOpenEmbedding (f ⁻¹ᵁ V).ι).isEmbedding.isInducing

end SchemeAux

theorem area_GOOD_proved (A : Type a) [CommRing A] [IsDomain A] [IsNoetherianRing A] (X : Scheme.{a})
    [IsIntegral X] (f : X ⟶ Spec (.of A)) [IsProper f] (hs : Function.Surjective f)
    (hg : IsGenFinite A f) (hp : IsProjOver A f) :
    ∃ (g : A) (N : ℕ) (i : X ⟶ PSpace A N) (j : Fin (N + 1)),
      g ≠ 0 ∧ IsClosedImmersion i ∧ i ≫ PSpace.toSpec A N = f ∧
      f ⁻¹ᵁ (PrimeSpectrum.basicOpen g : (Spec (.of A)).Opens) ≤ chartCover i ⟨j⟩ := by
  obtain ⟨g₀, hg₀, hfin⟩ := hg
  obtain ⟨N, i, hi, hif⟩ := hp
  have hηmem : genericPointOfSpec A ∈ (PrimeSpectrum.basicOpen g₀ : (Spec (.of A)).Opens) :=
    (mem_basicOpen_genericPointOfSpec A).mpr hg₀
  have hdisc : _root_.IsDiscrete (f ⁻¹' {genericPointOfSpec A}) :=
    good_isDiscrete_preimage_singleton f (PrimeSpectrum.basicOpen g₀) hηmem hfin
  have hfη : f (genericPoint (↥X)) = genericPointOfSpec A :=
    map_genericPoint_eq_genericPointOfSpec X f hs
  have hcl : closure ({genericPoint (↥X)} : Set ↥X) = ⊤ := genericPoint_closure _
  obtain ⟨j, hj⟩ := good_projChart A N i (genericPoint (↥X))
  have hZcl : IsClosed ((chartCover i ⟨j⟩ : Set ↥X))ᶜ :=
    (chartCover i ⟨j⟩).isOpen.isClosed_compl
  have hnotmem : genericPointOfSpec A ∉ f '' ((chartCover i ⟨j⟩ : Set ↥X))ᶜ := by
    rintro ⟨z, hz, hzf⟩
    have hzeq : z = genericPoint (↥X) :=
      eq_of_mem_of_isDiscrete_of_closure_eq_univ hdisc
        (by rw [Set.mem_preimage, Set.mem_singleton_iff]; exact hfη) hcl hzf
    exact hz (by rw [hzeq]; exact hj)
  have himcl : IsClosed (f '' ((chartCover i ⟨j⟩ : Set ↥X))ᶜ) :=
    f.isClosedMap _ hZcl
  obtain ⟨g, hgne, hgle⟩ := exists_ne_zero_basicOpen_subset (A := A)
    (U := ⟨(f '' ((chartCover i ⟨j⟩ : Set ↥X))ᶜ)ᶜ, himcl.isOpen_compl⟩) hnotmem
  refine ⟨g, N, i, j, hgne, hi, hif, ?_⟩
  intro x hx
  have hfx : f x ∈ ((f '' ((chartCover i ⟨j⟩ : Set ↥X))ᶜ)ᶜ : Set (Spec (.of A))) := hgle hx
  by_contra hxc
  exact hfx ⟨x, hxc, rfl⟩

end Work.DSEQP
