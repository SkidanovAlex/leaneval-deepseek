import Mathlib
import Submission.Work.DSSER.Basic

/-!
# The ideal `(Z)` of `R[Z]/(Z_i^p - z_i)` is maximal

Let `R` be a local ring, `p > 0`, and `z : Fin d → R` a family generating the maximal ideal
`𝔪`.  In the ring `R' = R[Z]/(Z_i^p - z_i)` (`Work.DSSER.serRing`), let `serIdeal = (Z)` be the
ideal generated by the images of the variables (`Work.DSSER.serIdeal`).

The reduction `R[Z] → R/𝔪`, `Z_i ↦ 0`, `r ↦ r mod 𝔪` factors through `R'` (each relation
`Z_i^p - z_i` maps to `-z_i ∈ 𝔪`), and its kernel is exactly `(Z)`: the ideal `(Z)` kills all
variables, and on the other side `z_i = Z_i^p` modulo the relations, so the whole maximal ideal
`𝔪 = (z_i)` of `R` is absorbed into `(Z)`.  Hence `R'/(Z) ≃ R/𝔪` is a field and `(Z)` is
maximal.
-/

namespace Work.DSEQP

open MvPolynomial

/-- In a multivariate polynomial ring, `x` differs from its constant term `C (constantCoeff x)`
by an element of the ideal generated by the variables. -/
theorem sub_C_constantCoeff_mem_span_X {R : Type*} [CommRing R] {σ : Type*}
    (x : MvPolynomial σ R) :
    x - MvPolynomial.C (MvPolynomial.constantCoeff x) ∈
      Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) := by
  set J : Ideal (MvPolynomial σ R) :=
    Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) with hJ
  have key : ∀ x : MvPolynomial σ R,
      x - MvPolynomial.C (MvPolynomial.constantCoeff x) ∈ J := by
    intro x
    induction x using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have h : (p + q) - MvPolynomial.C (MvPolynomial.constantCoeff (p + q))
          = (p - MvPolynomial.C (MvPolynomial.constantCoeff p))
            + (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [h]; exact J.add_mem hp hq
    | mul_X p n hp =>
      have h : p * MvPolynomial.X n
            - MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n))
          = (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) * MvPolynomial.X n
            + MvPolynomial.C (MvPolynomial.constantCoeff p) * MvPolynomial.X n := by
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]; ring
      rw [h]
      exact J.add_mem (J.mul_mem_right (MvPolynomial.X n) hp)
        (J.mul_mem_left (MvPolynomial.C (MvPolynomial.constantCoeff p))
          (Ideal.subset_span (Set.mem_range_self n)))
  exact key x

theorem serIdeal_isMaximal (R : Type*) [CommRing R] [IsLocalRing R] (p : ℕ) (hp : 0 < p)
    {d : ℕ} (z : Fin d → R) (hz : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal R) :
    (Work.DSSER.serIdeal p z).IsMaximal := by
  -- The reduction `R[Z] → R/𝔪`, `Z_i ↦ 0`, `r ↦ r mod 𝔪`, i.e. `residue ∘ constantCoeff`.
  let Φ : MvPolynomial (Fin d) R →+* IsLocalRing.ResidueField R :=
    (IsLocalRing.residue R).comp MvPolynomial.constantCoeff
  -- Each relation `Z_i^p - z_i` is killed: its constant term is `-z_i ∈ 𝔪`.
  have hΦ_serRel : ∀ a ∈ Work.DSSER.serRel R p z, Φ a = 0 := by
    intro a ha
    have ha' : a ∈ Ideal.span (Set.range (fun i : Fin d =>
        MvPolynomial.X i ^ p - MvPolynomial.C (z i))) := by
      simpa only [Work.DSSER.serRel] using ha
    have hle : Ideal.span (Set.range (fun i : Fin d =>
        MvPolynomial.X i ^ p - MvPolynomial.C (z i))) ≤ RingHom.ker Φ := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      have hzi : z i ∈ IsLocalRing.maximalIdeal R := by
        rw [← hz]; exact Ideal.subset_span (Set.mem_range_self i)
      have hcc : MvPolynomial.constantCoeff
          (MvPolynomial.X i ^ p - MvPolynomial.C (z i)) = -(z i) := by
        rw [map_sub, map_pow, MvPolynomial.constantCoeff_C, MvPolynomial.constantCoeff_X,
          zero_pow hp.ne', zero_sub]
      refine RingHom.mem_ker.mpr ?_
      simp only [Φ, RingHom.comp_apply, hcc]
      rw [IsLocalRing.residue_eq_zero_iff]
      exact (IsLocalRing.maximalIdeal R).neg_mem hzi
    exact RingHom.mem_ker.mp (hle ha')
  -- The induced map on the quotient.
  let Φbar : Work.DSSER.serRing R p z →+* IsLocalRing.ResidueField R :=
    Ideal.Quotient.lift (Work.DSSER.serRel R p z) Φ hΦ_serRel
  have hΦbar_mk : ∀ x, Φbar (Ideal.Quotient.mk (Work.DSSER.serRel R p z) x) = Φ x :=
    fun x => rfl
  -- `(Z) ≤ ker Φbar`.
  have h1 : Work.DSSER.serIdeal p z ≤ RingHom.ker Φbar := by
    rw [Work.DSSER.serIdeal]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    refine RingHom.mem_ker.mpr ?_
    change Φbar (Ideal.Quotient.mk (Work.DSSER.serRel R p z) (MvPolynomial.X i)) = 0
    rw [hΦbar_mk]
    simp only [Φ, RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
  -- `z_i = Z_i^p` modulo the relations, so `mk (C (z_i)) ∈ (Z)`.
  have hK : ∀ i : Fin d, Ideal.Quotient.mk (Work.DSSER.serRel R p z)
      (MvPolynomial.C (z i)) ∈ Work.DSSER.serIdeal p z := by
    intro i
    have hrel : MvPolynomial.X i ^ p - MvPolynomial.C (z i) ∈ Work.DSSER.serRel R p z :=
      show MvPolynomial.X i ^ p - MvPolynomial.C (z i) ∈
        Ideal.span (Set.range (fun i : Fin d => MvPolynomial.X i ^ p - MvPolynomial.C (z i)))
        from Ideal.subset_span (Set.mem_range_self i)
    have hzero := Ideal.Quotient.eq_zero_iff_mem.mpr hrel
    rw [map_sub, map_pow] at hzero
    have heq : Ideal.Quotient.mk (Work.DSSER.serRel R p z) (MvPolynomial.C (z i))
        = (Work.DSSER.serZ p z i) ^ p := by
      rw [sub_eq_zero] at hzero
      rw [← hzero]
    rw [heq]
    exact (Work.DSSER.serIdeal p z).pow_le_self hp.ne'
      ((Work.DSSER.serIdeal p z).pow_mem_pow (Work.DSSER.serZ_mem_serIdeal i) p)
  -- hence `mk (C c) ∈ (Z)` for every `c ∈ 𝔪 = (z_i)`.
  have hC_mem : ∀ c ∈ IsLocalRing.maximalIdeal R,
      Ideal.Quotient.mk (Work.DSSER.serRel R p z) (MvPolynomial.C c) ∈ Work.DSSER.serIdeal p z := by
    intro c hc
    have hc' : c ∈ Ideal.span (Set.range z) := by rw [hz]; exact hc
    have hmem : c ∈ Ideal.comap
        ((Ideal.Quotient.mk (Work.DSSER.serRel R p z)).comp MvPolynomial.C)
        (Work.DSSER.serIdeal p z) :=
      (Ideal.span_le.mpr (fun _ hx => by
        obtain ⟨i, rfl⟩ := hx
        exact hK i)) hc'
    exact hmem
  -- `ker Φbar ≤ (Z)`.
  have h2 : RingHom.ker Φbar ≤ Work.DSSER.serIdeal p z := by
    intro y hy
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hx : Φ x = 0 := by
      have h : Φbar (Ideal.Quotient.mk (Work.DSSER.serRel R p z) x) = 0 :=
        RingHom.mem_ker.mp hy
      rw [hΦbar_mk] at h
      exact h
    have hc : MvPolynomial.constantCoeff x ∈ IsLocalRing.maximalIdeal R := by
      have h := hx
      simp only [Φ, RingHom.comp_apply] at h
      rwa [IsLocalRing.residue_eq_zero_iff] at h
    have hsplit : x = MvPolynomial.C (MvPolynomial.constantCoeff x)
        + (x - MvPolynomial.C (MvPolynomial.constantCoeff x)) := by ring
    rw [hsplit, map_add]
    refine (Work.DSSER.serIdeal p z).add_mem (hC_mem _ hc) ?_
    have hmem : x - MvPolynomial.C (MvPolynomial.constantCoeff x) ∈
        Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) R)) :=
      sub_C_constantCoeff_mem_span_X x
    have hmap : Ideal.map (Ideal.Quotient.mk (Work.DSSER.serRel R p z))
        (Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) R)))
        = Work.DSSER.serIdeal p z := by
      rw [Ideal.map_span, Work.DSSER.serIdeal]
      congr 1
      ext w
      constructor
      · rintro ⟨u, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨MvPolynomial.X i, ⟨i, rfl⟩, rfl⟩
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ hmem
  have hker : RingHom.ker Φbar = Work.DSSER.serIdeal p z := le_antisymm h2 h1
  -- `Φbar` is surjective onto the residue field, so its kernel is maximal.
  have hsurj : Function.Surjective Φbar := by
    intro r
    obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective r
    refine ⟨Ideal.Quotient.mk (Work.DSSER.serRel R p z) (MvPolynomial.C a), ?_⟩
    rw [hΦbar_mk]
    simp only [Φ, RingHom.comp_apply, MvPolynomial.constantCoeff_C]
    exact ha
  have hfin : (RingHom.ker Φbar).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective Φbar hsurj
  rw [hker] at hfin
  exact hfin

end Work.DSEQP
