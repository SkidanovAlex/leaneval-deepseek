import Mathlib
import Submission.Work.DSEQP.Basic
import Submission.Work.DSEQP.dualTensorHom_surjective

namespace Work.DSEQP

/-- **Base change of the evaluation ideal.**  For a finite algebra `B` over a Noetherian ring `A`
and a flat `A`-algebra `S`, the evaluation ideal of `B` base changed to `S` is generated by the
values `s 1` of `A`-linear maps `s : B →ₗ[A] S`.

The non-trivial inclusion is: every `A`-linear map `B →ₗ[A] S` evaluates `1` into
`(evalIdeal A B) · S`.  This holds because `B` is finitely presented over `A` (Noetherian and
finite) while `S` is flat, so the canonical map `(B →ₗ[A] A) ⊗[A] S → (B →ₗ[A] S)` is surjective
(`dualTensorHom_surjective`). -/
theorem evalIdeal_baseChange (A S B : Type*) [CommRing A] [CommRing S] [Algebra A S]
    [CommRing B] [Algebra A B] [IsNoetherianRing A] [Module.Finite A B] [Module.Flat A S] :
    Ideal.span (Set.range fun s : B →ₗ[A] S => s 1) = (evalIdeal A B).map (algebraMap A S) := by
  have hfp : Module.FinitePresentation A B :=
    Module.finitePresentation_of_finite (R := A) (M := B)
  refine le_antisymm ?_ ?_
  · -- `⊆`: every value `s 1` comes from a tensor, hence lies in the extension of `evalIdeal`.
    rw [Ideal.span_le]
    rintro x ⟨s, rfl⟩
    change s 1 ∈ (evalIdeal A B).map (algebraMap A S)
    obtain ⟨w, hw⟩ := dualTensorHom_surjective A B S s
    rw [← hw]
    clear hw s
    induction w using TensorProduct.inductionOn with
    | tmul f t =>
      rw [dualTensorHom_apply]
      have h1 : f 1 ∈ evalIdeal A B := (mem_evalIdeal_iff A B).2 ⟨f, rfl⟩
      have h2 : algebraMap A S (f 1) ∈ (evalIdeal A B).map (algebraMap A S) :=
        Ideal.mem_map_of_mem (algebraMap A S) h1
      have h3 : algebraMap A S (f 1) * t ∈ (evalIdeal A B).map (algebraMap A S) :=
        Ideal.mul_mem_right t _ h2
      rwa [Algebra.smul_def]
    | add x y hx hy =>
      rw [map_add, LinearMap.add_apply]
      exact Ideal.add_mem _ hx hy
  · -- `⊇`: an element `f 1` of the evaluation ideal extends along `A → S`.
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap]
    obtain ⟨t, rfl⟩ := (mem_evalIdeal_iff A B).1 ha
    exact Ideal.subset_span ⟨(Algebra.linearMap A S) ∘ₗ t, by simp⟩

end Work.DSEQP
