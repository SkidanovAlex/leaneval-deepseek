/-! ## V1: the pro-uniform quantitative Riemann extension predicate (replaces `Mix.IsQRET`) -/

/-- Bhatt Thm 3.1(2) + Rmk 3.2, pro form with one uniform `c` for kernels and cokernels:
for all `m k` there is `c` with `ker(B/pᵐ → D_{n+c}/pᵐ)` killed by `ϖ_k g_k` and the `c`-fold
transition of `coker(B/pᵐ → D_{n+c}/pᵐ) → coker(B/pᵐ → D_n/pᵐ)` killed by `ϖ_k g_k`, for every `n`. -/
def IsQRETp (p : ℕ) (B : Type a) [CommRing B] (ϖ gr : ℕ → B) (D : ℕ → Type a)
    [∀ n, CommRing (D n)] [∀ n, Algebra B (D n)] (tr : ∀ n, D (n + 1) →ₐ[B] D n) : Prop :=
  ∀ m k : ℕ, ∃ c : ℕ,
    (∀ n (x : B), algebraMap B (D (n + c)) x ∈ Ideal.span {((p : D (n + c))) ^ m} →
        ϖ k * gr k * x ∈ Ideal.span {(p : B) ^ m}) ∧
    (∀ n (y : D (n + c)), ∃ x : B,
        algebraMap B (D n) (ϖ k * gr k) * iterTr tr n c y - algebraMap B (D n) x ∈
          Ideal.span {(p : D n) ^ m})

/-! ## V2: finite free model of `RΓ(X,𝒪)` for a GIVEN finite affine cover (replaces
`Mix.IsFinFreeModel`, whose cover was existential) -/

def IsFinFreeModelU (A : Type a) [CommRing A] (X : Scheme.{a}) (f : X ⟶ Spec (.of A))
    {ι : Type a} (U : ι → X.Opens) (P : CochainComplex (ModuleCat.{a} A) ℤ)
    (ε : ModuleCat.of A A ⟶ P.X 0) : Prop :=
  IsBddFinFree P ∧ (∀ k, ε ≫ P.d 0 k = 0) ∧
    ∃ φ : P ⟶ cechZ A X f U, QuasiIso φ ∧
      ε ≫ φ.f 0 ≫ ((cech A X f U).extendXIso ComplexShape.embeddingUpNat (i := 0) rfl).hom =
        coaug0 A X f U

/-! ## V3: blowup charts `W[J/t_S] ⊂ W_{t_S}` and their Čech complex (no schemes, no Rees algebra)

`J = (t_i)_{i ∈ ι}`.  For `S : Finset ι`, `chartRing t S` is the `W`-subalgebra of `W_{t_S}`,
`t_S = ∏_{i∈S} t_i`, generated by the fractions `t_k / t_i` (`i ∈ S`); it is `Γ` of
`⋂_{i∈S} D₊(t_i T) ⊂ Bl_J(Spec W)`.  The Čech index category is `(Finset ι)ᵒᵖ` (products = unions),
the cover is `i ↦ {i}`, and the complex is Mathlib's `cechComplexFunctor` — the same construction
(and sign conventions) as `DSMap.cech`. -/

section Chart
variable {W : Type a} [CommRing W] {ι : Type a} [DecidableEq ι]

def tS (t : ι → W) (S : Finset ι) : W := ∏ i ∈ S, t i

lemma tS_dvd (t : ι → W) {S T : Finset ι} (h : S ⊆ T) : tS t S ∣ tS t T :=
  Finset.prod_dvd_prod_of_subset _ _ _ h

/-- the localisation map `W_{t_S} → W_{t_T}` for `S ⊆ T`. -/
noncomputable def locRes (t : ι → W) {S T : Finset ι} (h : S ⊆ T) :
    Localization.Away (tS t S) →ₐ[W] Localization.Away (tS t T) :=
  IsLocalization.Away.liftAlgHom (tS t S) (f := Algebra.ofId W _)
    (isUnit_of_dvd_unit (map_dvd _ (tS_dvd t h))
      (IsLocalization.Away.algebraMap_isUnit (tS t T)))

lemma locRes_eq (t : ι → W) {S T : Finset ι} (h : S ⊆ T)
    (φ : Localization.Away (tS t S) →ₐ[W] Localization.Away (tS t T)) : φ = locRes t h :=
  (IsLocalization.algHom_subsingleton (Submonoid.powers (tS t S))).elim _ _

/-- the fractions `t_k / t_i`, `i ∈ S` (characterised by `x · t_i = t_k`; `t_i` is a unit). -/
def chartGens (t : ι → W) (S : Finset ι) : Set (Localization.Away (tS t S)) :=
  {x | ∃ i ∈ S, ∃ k, x * algebraMap W _ (t i) = algebraMap W _ (t k)}

/-- the blowup chart ring `W[J/t_S] ⊂ W_{t_S}`. -/
noncomputable def chartRing (t : ι → W) (S : Finset ι) :
    Subalgebra W (Localization.Away (tS t S)) :=
  Algebra.adjoin W (chartGens t S)

lemma chartRing_map_le (t : ι → W) {S T : Finset ι} (h : S ⊆ T) :
    (chartRing t S).map (locRes t h) ≤ chartRing t T := by
  rw [chartRing, AlgHom.map_adjoin]
  apply Algebra.adjoin_mono
  rintro _ ⟨x, ⟨i, hi, k, hx⟩, rfl⟩
  refine ⟨i, h hi, k, ?_⟩
  have := congrArg (locRes t h) hx
  simpa only [map_mul, AlgHom.commutes] using this

/-- a family of subalgebras `G S ⊂ W_{t_S}` stable under the localisation maps, as a presheaf of
`W`-modules on the Čech index category `(Finset ι)ᵒᵖ`. -/
noncomputable def locPresheaf (t : ι → W) (G : ∀ S, Subalgebra W (Localization.Away (tS t S)))
    (hG : ∀ S T (h : S ⊆ T), (G S).map (locRes t h) ≤ G T) :
    (Finset ι)ᵒᵖᵒᵖ ⥤ ModuleCat.{a} W where
  obj S := ModuleCat.of W (G S.unop.unop)
  map {S T} f := ModuleCat.ofHom
    (((locRes t (leOfHom f.unop.unop)).comp (G S.unop.unop).val).codRestrict (G T.unop.unop)
      (fun x => hG _ _ (leOfHom f.unop.unop) ⟨x.1, x.2, rfl⟩)).toLinearMap
  map_id S := by
    ext x
    exact (DFunLike.congr_fun (locRes_eq t (subset_refl S.unop.unop) (AlgHom.id W _)) x.1).symm
  map_comp {S T V} f g := by
    ext x
    exact DFunLike.congr_fun (locRes_eq t ((leOfHom f.unop.unop).trans (leOfHom g.unop.unop))
      ((locRes t (leOfHom g.unop.unop)).comp (locRes t (leOfHom f.unop.unop)))).symm x.1

noncomputable def chartPresheaf (t : ι → W) : (Finset ι)ᵒᵖᵒᵖ ⥤ ModuleCat.{a} W :=
  locPresheaf t (chartRing t) (fun _ _ h => chartRing_map_le t h)

/-- the Čech index family `i ↦ {i}` -/
def chartIdx (ι : Type a) [DecidableEq ι] : ι → (Finset ι)ᵒᵖ := fun i => op {i}

/-- Čech complex of the chart cover of `Bl_J(W)` (non-alternating, Mathlib conventions). -/
noncomputable abbrev chartCech (t : ι → W) : CochainComplex (ModuleCat.{a} W) ℕ :=
  (cechComplexFunctor (chartIdx ι)).obj (chartPresheaf t)

noncomputable abbrev chartCechZ (t : ι → W) : CochainComplex (ModuleCat.{a} W) ℤ :=
  (chartCech t).extend ComplexShape.embeddingUpNat

/-- coaugmentation `W → ∏ᵢ W[J/t_i]` -/
noncomputable def chartCoaugW (t : ι → W) : ModuleCat.of W W ⟶ (chartCech t).X 0 :=
  Pi.lift fun _ => ModuleCat.ofHom (Algebra.linearMap W _)

end Chart

section ChartA
variable {A W : Type a} [CommRing A] [CommRing W] {ι : Type a} [DecidableEq ι]

/-- `ψ : A → W` as an `A`-linear map into the restriction of scalars of `W`. -/
noncomputable def unitA (ψ : A →+* W) :
    ModuleCat.of A A ⟶ (ModuleCat.restrictScalars ψ).obj (ModuleCat.of W W) :=
  ModuleCat.ofHom (Y := (ModuleCat.restrictScalars ψ).obj (ModuleCat.of W W))
    { toFun := ψ
      map_add' := map_add ψ
      map_smul' := fun r x => by
        simp only [smul_eq_mul, map_mul, RingHom.id_apply, ]
        rfl }

/-- the chart Čech complex as a complex of `A`-modules (restriction of scalars along `ψ`). -/
noncomputable abbrev chartCechA (ψ : A →+* W) (t : ι → W) : CochainComplex (ModuleCat.{a} A) ℤ :=
  ((ModuleCat.restrictScalars ψ).mapHomologicalComplex _).obj (chartCechZ t)

noncomputable def chartCoaugA (ψ : A →+* W) (t : ι → W) :
    ModuleCat.of A A ⟶ (ModuleCat.restrictScalars ψ).obj ((chartCech t).X 0) :=
  unitA ψ ≫ (ModuleCat.restrictScalars ψ).map (chartCoaugW t)

end ChartA

/-! ## V4: almost acyclicity mod `I` of a coaugmented complex (termwise quotient) -/

/-- `W/I → K/IK` (termwise) is an almost quasi-isomorphism w.r.t. `(ϖ_k)`: almost injective and
almost surjective on `H⁰`, and `Hᵠ(K/IK)` almost zero for `q ≥ 1`. -/
def AlmostAcyc {W : Type a} [CommRing W] (ϖ : ℕ → W) (I : Ideal W)
    (K : CochainComplex (ModuleCat.{a} W) ℕ) (e : ModuleCat.of W W ⟶ K.X 0) : Prop :=
  (∀ w : W, e.hom w ∈ I • (⊤ : Submodule W (K.X 0)) → ∀ k, ϖ k * w ∈ I) ∧
  (∀ z : K.X 0, (K.d 0 1).hom z ∈ I • (⊤ : Submodule W (K.X 1)) →
      ∀ k, ∃ w : W, ϖ k • z - e.hom w ∈ I • (⊤ : Submodule W (K.X 0))) ∧
  (∀ (q : ℕ) (z : K.X (q + 1)),
      (K.d (q + 1) (q + 2)).hom z ∈ I • (⊤ : Submodule W (K.X (q + 2))) →
      ∀ k, ∃ y : K.X q, ϖ k • z - (K.d q (q + 1)).hom y ∈ I • (⊤ : Submodule W (K.X (q + 1))))

/-! ## V5: perfected charts in characteristic `p` (for M5b) -/

section PerfChart
variable (p : ℕ) {R : Type a} [CommRing R] {ι : Type a} [DecidableEq ι]

/-- the perfection of `R[J/t_S]` inside `R_{t_S}` (`R` perfect): adjoin all `x` with
`x^{p^e} ∈ R[J/t_S]`. -/
noncomputable def perfChartRing (t : ι → R) (S : Finset ι) :
    Subalgebra R (Localization.Away (tS t S)) :=
  Algebra.adjoin R {x | ∃ e : ℕ, x ^ (p ^ e) ∈ chartRing t S}

lemma perfChartRing_map_le (t : ι → R) {S T : Finset ι} (h : S ⊆ T) :
    (perfChartRing p t S).map (locRes t h) ≤ perfChartRing p t T := by
  rw [perfChartRing, AlgHom.map_adjoin]
  apply Algebra.adjoin_mono
  rintro _ ⟨x, ⟨e, hx⟩, rfl⟩
  exact ⟨e, by rw [← map_pow]; exact chartRing_map_le t h ⟨_, hx, rfl⟩⟩

noncomputable def perfChartPresheaf (t : ι → R) : (Finset ι)ᵒᵖᵒᵖ ⥤ ModuleCat.{a} R :=
  locPresheaf t (perfChartRing p t) (fun _ _ h => perfChartRing_map_le p t h)

noncomputable def perfChartCoaug (t : ι → R) :
    ModuleCat.of R R ⟶ ((cechComplexFunctor (chartIdx ι)).obj (perfChartPresheaf p t)).X 0 :=
  Pi.lift fun _ => ModuleCat.ofHom (Algebra.linearMap R _)

end PerfChart

/-! ## V6: the chart cover of `X ⊂ ℙᴺ_A` and the sections `x_k / x_j` -/

section Proj
variable {A : Type a} [CommRing A] {X : Scheme.{a}} {N : ℕ}

lemma X_mem_PGr (k : Fin (N + 1)) :
    (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) A) ∈ PGr A N 1 :=
  (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X _ _)

/-- `U_k = X ∩ D₊(x_k)` -/
noncomputable def chartCover (i : X ⟶ PSpace A N) : ULift.{a} (Fin (N + 1)) → X.Opens :=
  fun k => i ⁻¹ᵁ Proj.basicOpen (PGr A N) (MvPolynomial.X k.down)

/-- the section `x_k / x_j ∈ Γ(X, U_j)` -/
noncomputable def xiSec (i : X ⟶ PSpace A N) (j k : Fin (N + 1)) : Γ(X, chartCover i ⟨j⟩) :=
  (i.app (Proj.basicOpen (PGr A N) (MvPolynomial.X j))).hom
    ((Proj.awayToSection (PGr A N) (MvPolynomial.X j)).hom
      (HomogeneousLocalization.Away.mk (PGr A N) (X_mem_PGr j) 1 (MvPolynomial.X k)
        (by rw [one_smul]; exact X_mem_PGr k)))

end Proj

/-! ## Nodes (sorried interfaces) -/

/-- **FFP** faithful flatness mod `p` gives it mod `pᵐ` (both sides `p`-torsion-free; local
flatness criterion for the nilpotent ideal `(p)/(pᵐ)`, `Tor₁ = 0` by torsion-freeness). -/
theorem ff_mod_pow (p : ℕ) {D D' : Type a} [CommRing D] [CommRing D'] [Algebra D D']
    (hD : IsSMulRegular D (p : D)) (hD' : IsSMulRegular D' (p : D'))
    (h : Module.FaithfullyFlat (D ⧸ Ideal.span {(p : D)})
      (D' ⧸ (Ideal.span {(p : D)}).map (algebraMap D D'))) (m : ℕ) :
    Module.FaithfullyFlat (D ⧸ Ideal.span {(p : D) ^ m})
      (D' ⧸ (Ideal.span {(p : D) ^ m}).map (algebraMap D D')) := sorry

/-- **ROOTS** (M2' iterated finitely often): compatible `p`-power roots of finitely many elements
after a perfectoid extension faithfully flat mod `p`. -/
theorem area_ROOTS (p : ℕ) [Fact p.Prime] (W : Type a) [CommRing W] (Q : PerfectoidData p W)
    {ι : Type a} [Finite ι] (t : ι → W) :
    ∃ (W' : Type a) (_ : CommRing W') (_ : Algebra W W') (Q' : PerfectoidData p W'),
      (∀ k, Q'.ϖ k = algebraMap W W' (Q.ϖ k)) ∧
      Module.FaithfullyFlat (W ⧸ Ideal.span {(p : W)})
        (W' ⧸ (Ideal.span {(p : W)}).map (algebraMap W W')) ∧
      ∃ tr : ι → ℕ → W', (∀ i, tr i 0 = algebraMap W W' (t i)) ∧
        ∀ i k, tr i (k + 1) ^ p = tr i k := sorry

/-- **DEN** common denominators in `W[1/p]`, normalised to `ϖ₀^{pe} = (p·v)^e`. -/
theorem exists_chart_gens (p : ℕ) [Fact p.Prime] (W : Type a) [CommRing W]
    (Q : PerfectoidData p W) {ι : Type a} [Finite ι] (s : ι → Localization.Away (p : W)) :
    ∃ (e : ℕ) (t : ι → W), ∀ k,
      algebraMap W _ (t k) = algebraMap W _ (Q.ϖ 0 ^ (p * e)) * s k := sorry

/-- (proved) `ϖ₀` is a unit in `W[1/p]`. -/
theorem isUnit_varpi_pow (p : ℕ) [Fact p.Prime] {W : Type a} [CommRing W]
    (Q : PerfectoidData p W) (e : ℕ) :
    IsUnit (algebraMap W (Localization.Away (p : W)) (Q.ϖ 0 ^ e)) := by
  obtain ⟨v, hv⟩ := Q.unit
  have h1 : IsUnit (algebraMap W (Localization.Away (p : W)) (Q.ϖ 0) ^ p) := by
    rw [← map_pow, hv, map_mul]
    exact (IsLocalization.Away.algebraMap_isUnit _).mul (v.isUnit.map _)
  rw [map_pow]
  exact ((isUnit_pow_iff (Fact.out : p.Prime).ne_zero).mp h1).pow e

/-- **CHA** the chart cover is a finite affine cover. -/
theorem chartCover_affine {A : Type a} [CommRing A] {X : Scheme.{a}} {N : ℕ}
    (i : X ⟶ PSpace A N) (hi : IsClosedImmersion i) (k) : IsAffineOpen (chartCover i k) := sorry

theorem chartCover_iSup {A : Type a} [CommRing A] {X : Scheme.{a}} {N : ℕ}
    (i : X ⟶ PSpace A N) : ⨆ k, chartCover i k = ⊤ := sorry

/-- **MX0U** (F1 + COH + pseudo-coherence): for EVERY finite affine cover `U` of a projective `X`
over Noetherian `A` there is a finite free model of `RΓ(X,𝒪)` mapping to `Č(U)`. Shared with G4a. -/
theorem area_MX0U (A : Type a) [CommRing A] [IsNoetherianRing A] (X : Scheme.{a})
    (f : X ⟶ Spec (.of A)) [IsProper f] (hp : IsProjOver A f) {ι : Type a} [Finite ι]
    (U : ι → X.Opens) (hU : ∀ i, IsAffineOpen (U i)) (hcov : ⨆ i, U i = ⊤) :
    ∃ (P : CochainComplex (ModuleCat.{a} A) ℤ) (ε : ModuleCat.of A A ⟶ P.X 0),
      IsFinFreeModelU A X f U P ε := sorry

/-- **MX0bU** bridge (F1): an honest splitting of a model gives `DSplit`. -/
theorem area_MX0bU (A : Type a) [CommRing A] (X : Scheme.{a}) (f : X ⟶ Spec (.of A))
    [IsProper f] {ι : Type a} [Finite ι] (U : ι → X.Opens) (hU : ∀ i, IsAffineOpen (U i))
    (hcov : ⨆ i, U i = ⊤) (P : CochainComplex (ModuleCat.{a} A) ℤ)
    (ε : ModuleCat.of A A ⟶ P.X 0) (hP : IsFinFreeModelU A X f U P ε)
    (h : ModSplit P ε (RingHom.id A) ⊥ 1) : DSplit.{a, b, c} A X f := sorry

/-- **M8m** generic monogenicity + good coordinate: `g ∉ (p)`, a projective embedding, a
coordinate `x_j`, a monic `F ∈ A[T]`, and an `A`-algebra map `Γ(X, X ∩ D₊(x_j)) → A[T]/(F)[1/pg]`
(restriction to `X_{D(pg)} ⊂ X ∩ D₊(x_j)` composed with `Γ(X_{D(pg)}) = Γ(X,𝒪)[1/pg] ≅ A[θ][1/pg]`). -/
theorem area_M8m (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] (p : ℕ) [Fact p.Prime] [CharZero A]
    [CharP (ResidueField A) p] (X : Scheme.{a}) [IsIntegral X] (f : X ⟶ Spec (.of A))
    [IsProper f] (hs : Function.Surjective f) (hg : IsGenFinite A f) (hp : IsProjOver A f) :
    ∃ (g : A) (N : ℕ) (i : X ⟶ PSpace A N) (j : Fin (N + 1)) (F : Polynomial A)
      (θ : Γ(X, chartCover i ⟨j⟩) →+*
        Localization.Away (algebraMap A (AdjoinRoot F) ((p : A) * g))),
      g ∉ Ideal.span {(p : A)} ∧ IsClosedImmersion i ∧ i ≫ PSpace.toSpec A N = f ∧ F.Monic ∧
      θ.comp (phiU A X f (chartCover i ⟨j⟩)) =
        (algebraMap (AdjoinRoot F) _).comp (algebraMap A (AdjoinRoot F)) := sorry

/-- **SEC** (point-to-blowup): a `W[1/p]`-point of `X ∩ D₊(x_j)` (`W` `p`-torsion-free) with
homogeneous coordinates `[t₀ : … : t_N]`, `t_k ∈ W`, `t_j` a unit in `W[1/p]`, gives chart maps
`Γ(X ∩ D₊(x_S)) → W[J/t_S]`, `x_k/x_i ↦ t_k/t_i`, i.e. a chain map `Č(X, U) → Č(Bl_J W)`
compatible with the coaugmentations (`J = (t_k)`; no strict transform, no closure argument). -/
theorem area_SEC (p : ℕ) [Fact p.Prime] (A : Type a) [CommRing A] (X : Scheme.{a})
    (f : X ⟶ Spec (.of A)) (N : ℕ) (i : X ⟶ PSpace A N) (hi : IsClosedImmersion i)
    (hif : i ≫ PSpace.toSpec A N = f) (j : Fin (N + 1))
    (W : Type a) [CommRing W] (hW : IsSMulRegular W (p : W)) (ψ : A →+* W)
    (θ : Γ(X, chartCover i ⟨j⟩) →+* Localization.Away (p : W))
    (hθ : θ.comp (phiU A X f (chartCover i ⟨j⟩)) = (algebraMap W _).comp ψ)
    (t : ULift.{a} (Fin (N + 1)) → W)
    (ht : IsUnit (algebraMap W (Localization.Away (p : W)) (t ⟨j⟩)))
    (htθ : ∀ k, k ≠ j → algebraMap W (Localization.Away (p : W)) (t ⟨k⟩) =
      algebraMap W _ (t ⟨j⟩) * θ (xiSec i j k)) :
    ∃ χ : cechZ A X f (chartCover i) ⟶ chartCechA ψ t,
      coaug0 A X f (chartCover i) ≫
        ((cech A X f (chartCover i)).extendXIso ComplexShape.embeddingUpNat (i := 0) rfl).inv ≫
          χ.f 0 ≫ (ModuleCat.restrictScalars ψ).map
            ((chartCech t).extendXIso ComplexShape.embeddingUpNat (i := 0) rfl).hom =
        chartCoaugA ψ t := sorry

/-- **M5b** char-`p` blowup almost acyclicity: `R` perfect, `J = (t_i) ∋ Tᵉ` (as a generator);
`R → Č(perfected charts of Bl_J R)` is a `T^{1/p^∞}`-almost quasi-isomorphism. -/
theorem area_M5b (p : ℕ) [Fact p.Prime] (R : Type a) [CommRing R] [CharP R p] [PerfectRing R p]
    {ι : Type a} [Finite ι] [DecidableEq ι] (t : ι → R) (T : R) (j₀ : ι) (e : ℕ)
    (hj₀ : t j₀ = T ^ e) :
    AlmostAcyc (fun k => (frobeniusEquiv R p).symm^[k] T) ⊥
      ((cechComplexFunctor (chartIdx ι)).obj (perfChartPresheaf p t)) (perfChartCoaug p t) :=
  sorry

/-- **M5c** perfectoid chart domination (M5b on `W♭` + untilting, PB2/PB3): the chart presheaf
maps to a presheaf `D` (the untilted completed perfected charts) whose coaugmented Čech complex is
almost acyclic mod every `pᵐ`.  `t_i` have compatible `p`-power roots; one generator is `ϖ₀ᵉ`. -/
theorem area_M5c (p : ℕ) [Fact p.Prime] (W : Type a) [CommRing W] (QW : PerfectoidData p W)
    {ι : Type a} [Finite ι] [DecidableEq ι] (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k)
    (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = QW.ϖ 0 ^ e) :
    ∃ (Dp : (Finset ι)ᵒᵖᵒᵖ ⥤ ModuleCat.{a} W) (η : chartPresheaf t ⟶ Dp),
      ∀ m, AlmostAcyc QW.ϖ (Ideal.span {(p : W) ^ m})
        ((cechComplexFunctor (chartIdx ι)).obj Dp)
        (chartCoaugW t ≫ ((cechComplexFunctor (chartIdx ι)).map η).f 0) := sorry

/-- **AMR** (homological algebra): if a coaugmented complex `K` is almost acyclic mod `I`, then
every bounded-above finite free `P` with a chain map to `K` compatible with the units has
`ModSplit` with every value `ϖ_k` (derived argument: `Hom_D(P⊗W, –)` only sees a bounded
truncation of the cone, which is killed by `ϖ_{k'}^L`; the `H⁰`-ambiguity is killed by `ϖ_k`). -/
theorem modSplit_of_almostAcyc (p : ℕ) [Fact p.Prime] {A W : Type a} [CommRing A] [CommRing W]
    (ψ : A →+* W) (ϖ : ℕ → W) (hϖ : ∀ k, ϖ (k + 1) ^ p = ϖ k) (I : Ideal W)
    (K : CochainComplex (ModuleCat.{a} W) ℕ) (eK : ModuleCat.of W W ⟶ K.X 0)
    (hK : AlmostAcyc ϖ I K eK) (P : CochainComplex (ModuleCat.{a} A) ℤ) (hP : IsBddFinFree P)
    (ε : ModuleCat.of A A ⟶ P.X 0) (hε : ∀ k, ε ≫ P.d 0 k = 0)
    (ρ : P ⟶ ((ModuleCat.restrictScalars ψ).mapHomologicalComplex _).obj
      (K.extend ComplexShape.embeddingUpNat))
    (hρ : ε ≫ ρ.f 0 ≫ (ModuleCat.restrictScalars ψ).map
      (K.extendXIso ComplexShape.embeddingUpNat (i := 0) rfl).hom =
        unitA ψ ≫ (ModuleCat.restrictScalars ψ).map eK) :
    ∀ k, ModSplit P ε ψ I (ϖ k) := sorry

/-- **M5d** (proved from M5c + AMR) blowup charts are almost split: a chain map from a finite free
`P` to the chart Čech complex of `Bl_J W` (`W` perfectoid, `t_i` with `p`-power roots, one
generator `= ϖ₀ᵉ`) yields `ModSplit` mod every `pᵐ` with every value `ϖ_k`. -/
theorem area_M5d (p : ℕ) [Fact p.Prime] (W : Type a) [CommRing W] (QW : PerfectoidData p W)
    {ι : Type a} [Finite ι] [DecidableEq ι] (t : ι → W) (tr : ι → ℕ → W)
    (htr0 : ∀ i, tr i 0 = t i) (htr : ∀ i k, tr i (k + 1) ^ p = tr i k)
    (j₀ : ι) (e : ℕ) (hj₀ : t j₀ = QW.ϖ 0 ^ e)
    {A : Type a} [CommRing A] (ψ : A →+* W) (P : CochainComplex (ModuleCat.{a} A) ℤ)
    (hP : IsBddFinFree P) (ε : ModuleCat.of A A ⟶ P.X 0) (hε : ∀ k, ε ≫ P.d 0 k = 0)
    (ρ : P ⟶ chartCechA ψ t)
    (hρ : ε ≫ ρ.f 0 ≫ (ModuleCat.restrictScalars ψ).map
      ((chartCech t).extendXIso ComplexShape.embeddingUpNat (i := 0) rfl).hom =
        chartCoaugA ψ t) :
    ∀ m k, ModSplit P ε ψ (Ideal.span {(p : W) ^ m}) (QW.ϖ k) := by
  obtain ⟨Dp, η, hD⟩ := area_M5c p W QW t tr htr0 htr j₀ e hj₀
  intro m k
  let φ := (cechComplexFunctor (chartIdx ι)).map η
  refine modSplit_of_almostAcyc p ψ QW.ϖ QW.root _ _ _ (hD m) P hP ε hε
    (ρ ≫ ((ModuleCat.restrictScalars ψ).mapHomologicalComplex _).map
      (HomologicalComplex.extendMap φ ComplexShape.embeddingUpNat : chartCechZ t ⟶ _)) ?_ k
  rw [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
    HomologicalComplex.extendMap_f φ ComplexShape.embeddingUpNat (i := 0) (i' := 0) rfl]
  simp only [Functor.map_comp, Category.assoc]
  erw [Iso.inv_hom_id_map, Category.comp_id]
  refine ((reassoc_of% hρ) ((ModuleCat.restrictScalars ψ).map (φ.f 0))).trans ?_
  rw [chartCoaugA, Category.assoc]

/-- **M4p** quantitative Riemann extension (Bhatt Thm 3.1 + Rmk 3.2) against the pro `IsQRETp`. -/
theorem area_M4p (p : ℕ) [Fact p.Prime] (B : Type a) [CommRing B] (Q : PerfectoidData p B)
    (gr : ℕ → B) (hgr : ∀ k, gr (k + 1) ^ p = gr k) :
    ∃ (D : ℕ → Type a) (_ : ∀ n, CommRing (D n)) (_ : ∀ n, Algebra B (D n))
      (QD : ∀ n, PerfectoidData p (D n)) (tr : ∀ n, D (n + 1) →ₐ[B] D n),
      (∀ n k, (QD n).ϖ k = algebraMap B (D n) (Q.ϖ k)) ∧
      (∀ n, ∃ y : D n, algebraMap B (D n) (gr 0) * y = (p : D n) ^ n) ∧
      IsQRETp p B Q.ϖ gr D tr := sorry

/-- **M7p** (Bhatt Thm 4.4/5.1 assembly, model level) against the pro `IsQRETp`. -/
theorem area_M7p (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] (p : ℕ) [Fact p.Prime] [CharZero A]
    [CharP (ResidueField A) p] (P : CochainComplex (ModuleCat.{a} A) ℤ)
    (ε : ModuleCat.of A A ⟶ P.X 0) (hP : IsBddFinFree P) (hε : ∀ k, ε ≫ P.d 0 k = 0)
    (B : Type a) [CommRing B] [Algebra A B] (Q : PerfectoidData p B) [Module.FaithfullyFlat A B]
    (g : A) (hg : g ∉ Ideal.span {(p : A)}) (gr : ℕ → B) (hgr0 : gr 0 = algebraMap A B g)
    (hgr : ∀ k, gr (k + 1) ^ p = gr k) (D : ℕ → Type a) [∀ n, CommRing (D n)]
    [∀ n, Algebra B (D n)] (QD : ∀ n, PerfectoidData p (D n)) (tr : ∀ n, D (n + 1) →ₐ[B] D n)
    (hQD : ∀ n k, (QD n).ϖ k = algebraMap B (D n) (Q.ϖ k)) (hq : IsQRETp p B Q.ϖ gr D tr)
    (hsplit : ∀ n m k, ModSplit P ε ((algebraMap B (D n)).comp (algebraMap A B))
      (Ideal.span {(p : D n) ^ m}) ((QD n).ϖ k)) :
    ModSplit P ε (RingHom.id A) ⊥ 1 := sorry

/-! ## M6G: the almost-purity-free M6N glue (proved from the nodes) -/

/-- descent of `ModSplit` mod `pᵐ` along a perfectoid extension faithfully flat mod `p`. -/
theorem modSplit_descent_p (p : ℕ) {A : Type a} [CommRing A]
    (P : CochainComplex (ModuleCat.{a} A) ℤ) (hP : IsBddFinFree P) (ε : ModuleCat.of A A ⟶ P.X 0)
    (hε : ∀ k, ε ≫ P.d 0 k = 0) {D D' : Type a} [CommRing D] [CommRing D'] [Algebra D D']
    (ψ : A →+* D) (hD : IsSMulRegular D (p : D)) (hD' : IsSMulRegular D' (p : D'))
    (hff : Module.FaithfullyFlat (D ⧸ Ideal.span {(p : D)})
      (D' ⧸ (Ideal.span {(p : D)}).map (algebraMap D D'))) (m : ℕ) (c : D)
    (h : ModSplit P ε ((algebraMap D D').comp ψ) (Ideal.span {(p : D') ^ m})
      (algebraMap D D' c)) :
    ModSplit P ε ψ (Ideal.span {(p : D) ^ m}) c := by
  refine modSplit_descent P hP ε hε ψ _ (ff_mod_pow p hD hD' hff m) c ?_
  rwa [Ideal.map_span, Set.image_singleton, map_pow, map_natCast]

theorem area_M6G (p : ℕ) [Fact p.Prime] (A : Type a) [CommRing A] (X : Scheme.{a})
    (f : X ⟶ Spec (.of A)) (g : A) (N : ℕ) (i : X ⟶ PSpace A N) (j : Fin (N + 1))
    (F : Polynomial A)
    (θ : Γ(X, chartCover i ⟨j⟩) →+*
      Localization.Away (algebraMap A (AdjoinRoot F) ((p : A) * g)))
    (hi : IsClosedImmersion i) (hif : i ≫ PSpace.toSpec A N = f) (hF : F.Monic)
    (hθ : θ.comp (phiU A X f (chartCover i ⟨j⟩)) =
      (algebraMap (AdjoinRoot F) _).comp (algebraMap A (AdjoinRoot F)))
    (P : CochainComplex (ModuleCat.{a} A) ℤ) (ε : ModuleCat.of A A ⟶ P.X 0)
    (hP : IsFinFreeModelU A X f (chartCover i) P ε)
    (D : Type a) [CommRing D] (QD : PerfectoidData p D) (ψ : A →+* D) (n : ℕ)
    (hdiv : ψ g ∣ (p : D) ^ n) :
    ∀ m k, ModSplit P ε ψ (Ideal.span {(p : D) ^ m}) (QD.ϖ k) := by
  intro m k
  obtain ⟨hP1, hP2, φ, -, hφ⟩ := hP
  -- 1. André on `D` for `F`: a root `r 0 ∈ W₁`
  obtain ⟨W₁, _, _, Q₁, hQ₁, hFF₁, hroot₁⟩ := area_M2' p D QD
  obtain ⟨r, hr0, -⟩ := hroot₁ (F.map ψ) (hF.map ψ)
  let ψ₁ : A →+* W₁ := (algebraMap D W₁).comp ψ
  have hFr : F.eval₂ ψ₁ (r 0) = 0 := by
    rw [Polynomial.aeval_def, Polynomial.eval₂_map] at hr0; exact hr0
  let L₀ : AdjoinRoot F →+* W₁ := AdjoinRoot.lift ψ₁ (r 0) hFr
  have hL₀ : ∀ x : A, L₀ (algebraMap A (AdjoinRoot F) x) = ψ₁ x := fun x => by
    rw [AdjoinRoot.algebraMap_eq]; exact AdjoinRoot.lift_of hFr
  have hu₁ : IsUnit (((algebraMap W₁ (Localization.Away (p : W₁))).comp L₀)
      (algebraMap A (AdjoinRoot F) ((p : A) * g))) := by
    rw [RingHom.comp_apply, hL₀, map_mul, map_mul, map_natCast]
    refine (IsLocalization.Away.algebraMap_isUnit _).mul ?_
    obtain ⟨y, hy⟩ := hdiv
    refine isUnit_of_dvd_unit ⟨algebraMap W₁ _ (algebraMap D W₁ y), ?_⟩
      ((IsLocalization.Away.algebraMap_isUnit (p : W₁)).pow n)
    change _ = algebraMap W₁ _ (algebraMap D W₁ (ψ g)) * _
    rw [← map_mul, ← map_mul, ← hy]
    simp
  let L₁ : Localization.Away (algebraMap A (AdjoinRoot F) ((p : A) * g)) →+*
      Localization.Away (p : W₁) := IsLocalization.Away.lift _ hu₁
  let θ₁ := L₁.comp θ
  -- 2. homogeneous coordinates `t₁ ∈ W₁` of the point, normalised `t₁ j = ϖ₀^{pe}`
  obtain ⟨e, t₀, ht₀⟩ := exists_chart_gens p W₁ Q₁
    (fun k : ULift.{a} (Fin (N + 1)) => θ₁ (xiSec i j k.down))
  let t₁ : ULift.{a} (Fin (N + 1)) → W₁ := Function.update t₀ ⟨j⟩ (Q₁.ϖ 0 ^ (p * e))
  have ht₁j : t₁ ⟨j⟩ = Q₁.ϖ 0 ^ (p * e) := Function.update_self _ _ _
  -- 3. roots of the `t₁ k` in a second André extension `W₂`
  obtain ⟨W₂, _, _, Q₂, hQ₂, hFF₂, tr, htr0, htr⟩ := area_ROOTS p W₁ Q₁ t₁
  let ψ₂ : A →+* W₂ := (algebraMap W₁ W₂).comp ψ₁
  let t₂ : ULift.{a} (Fin (N + 1)) → W₂ := fun k => algebraMap W₁ W₂ (t₁ k)
  have hu₂ : IsUnit (((algebraMap W₂ (Localization.Away (p : W₂))).comp (algebraMap W₁ W₂))
      (p : W₁)) := by
    rw [RingHom.comp_apply, map_natCast]; exact IsLocalization.Away.algebraMap_isUnit _
  let L₂ : Localization.Away (p : W₁) →+* Localization.Away (p : W₂) :=
    IsLocalization.Away.lift _ hu₂
  have hL₂ : ∀ x : W₁, L₂ (algebraMap W₁ _ x) = algebraMap W₂ _ (algebraMap W₁ W₂ x) :=
    fun x => IsLocalization.Away.lift_eq _ hu₂ x
  let θ₂ := L₂.comp θ₁
  have hθ₂ : θ₂.comp (phiU A X f (chartCover i ⟨j⟩)) = (algebraMap W₂ _).comp ψ₂ := by
    ext x
    have := congrArg (fun φ => φ x) hθ
    simp only [RingHom.comp_apply] at this ⊢
    change L₂ (L₁ (θ _)) = _
    rw [this, IsLocalization.Away.lift_eq, RingHom.comp_apply, hL₀, hL₂]
    rfl
  have ht₂j : t₂ ⟨j⟩ = Q₂.ϖ 0 ^ (p * e) := by
    change algebraMap W₁ W₂ (t₁ ⟨j⟩) = _; rw [ht₁j, map_pow, hQ₂]
  have hθ₂k : ∀ k, k ≠ j → algebraMap W₂ (Localization.Away (p : W₂)) (t₂ ⟨k⟩) =
      algebraMap W₂ _ (t₂ ⟨j⟩) * θ₂ (xiSec i j k) := by
    intro k hk
    have hne : (⟨k⟩ : ULift.{a} (Fin (N + 1))) ≠ ⟨j⟩ := fun h => hk (congrArg ULift.down h)
    have h1 : t₁ ⟨k⟩ = t₀ ⟨k⟩ := Function.update_of_ne hne _ _
    change algebraMap W₂ _ (algebraMap W₁ W₂ (t₁ ⟨k⟩)) =
      algebraMap W₂ _ (algebraMap W₁ W₂ (t₁ ⟨j⟩)) * L₂ (θ₁ (xiSec i j k))
    rw [← hL₂, ← hL₂, ← map_mul, h1, ht₁j, ht₀ ⟨k⟩]
  -- 4. the chart chain map (SEC) and blowup almost splitting (M5d) over `W₂`
  obtain ⟨χ, hχ⟩ := area_SEC p A X f N i hi hif j W₂ Q₂.torsionFree ψ₂ θ₂ hθ₂ t₂
    (by rw [ht₂j]; exact isUnit_varpi_pow p Q₂ _) hθ₂k
  have h5 := area_M5d p W₂ Q₂ t₂ tr htr0 htr ⟨j⟩ (p * e) ht₂j ψ₂ P hP1 ε hP2 (φ ≫ χ) (by
    have hφ' : ε ≫ φ.f 0 = coaug0 A X f (chartCover i) ≫
        ((cech A X f (chartCover i)).extendXIso ComplexShape.embeddingUpNat (i := 0) rfl).inv := by
      apply (Iso.eq_comp_inv _).2
      exact (Category.assoc _ _ _).trans hφ
    rw [HomologicalComplex.comp_f, Category.assoc, ← Category.assoc ε, hφ']
    exact (Category.assoc _ _ _).trans hχ) m k
  -- 5. descend `W₂ → W₁ → D` (AM2 + FFP)
  have h6 : ModSplit P ε ψ₁ (Ideal.span {(p : W₁) ^ m}) (Q₁.ϖ k) := by
    refine modSplit_descent_p p P hP1 ε hP2 ψ₁ Q₁.torsionFree Q₂.torsionFree hFF₂ m _ ?_
    rw [← hQ₂]; exact h5
  refine modSplit_descent_p p P hP1 ε hP2 ψ QD.torsionFree Q₁.torsionFree hFF₁ m _ ?_
  rw [← hQ₁]; exact h6

/-! ## Assembly of `area_MIX` from the MIX2 node set -/

theorem area_MIX2 (A : Type a) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] [IsAlgClosed (ResidueField A)] (p : ℕ) [Fact p.Prime]
    [CharZero A] [CharP (ResidueField A) p] (X : Scheme.{a}) [IsIntegral X]
    (f : X ⟶ Spec (.of A)) [IsProper f] (hs : Function.Surjective f) (hg : IsGenFinite A f)
    (hp : IsProjOver A f) :
    DSplit.{a, b, c} A X f := by
  have : IsDomain A := area_REG A
  obtain ⟨g, N, i, j, F, θ, hgp, hi, hif, hF, hθ⟩ := area_M8m A p X f hs hg hp
  obtain ⟨P, ε, hP⟩ := area_MX0U A X f hp (chartCover i) (chartCover_affine i hi)
    (chartCover_iSup i)
  refine area_MX0bU A X f (chartCover i) (chartCover_affine i hi) (chartCover_iSup i) P ε hP ?_
  obtain ⟨B₁, _, _, P₁, hFF₁⟩ := area_M1' A p
  obtain ⟨B₂, _, _, Q₂, -, hFF₁₂, hroots⟩ := area_M2' p B₁ P₁
  let _ : Algebra A B₂ := ((algebraMap B₁ B₂).comp (algebraMap A B₁)).toAlgebra
  have : IsScalarTower A B₁ B₂ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have : Module.FaithfullyFlat A B₂ := area_M2b A p B₁ B₂ Q₂ hFF₁₂
  obtain ⟨r, hr0, hr⟩ := hroots (Polynomial.X - Polynomial.C (algebraMap A B₁ g))
    (Polynomial.monic_X_sub_C _)
  have hr0' : r 0 = algebraMap A B₂ g := by
    simp only [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at hr0
    rw [hr0]; rfl
  obtain ⟨D, _, _, QD, tr, hQD, hdiv, hq⟩ := area_M4p p B₂ Q₂ r hr
  refine area_M7p A p P ε hP.1 hP.2.1 B₂ Q₂ g hgp r hr0' hr D QD tr hQD hq ?_
  intro n m k
  refine area_M6G p A X f g N i j F θ hi hif hF hθ P ε hP (D n) (QD n) _ n ?_ m k
  obtain ⟨y, hy⟩ := hdiv n
  refine ⟨y, ?_⟩
  rw [← hy, RingHom.comp_apply, ← hr0']

end DSMap.Mix2

/-- the MIX2 assembly has exactly `area_MIX`'s statement -/
example : @DSMap.Mix2.area_MIX2 = @DSMap.area_MIX := rfl
