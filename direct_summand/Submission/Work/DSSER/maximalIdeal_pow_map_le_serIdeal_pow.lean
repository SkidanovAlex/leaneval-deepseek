import Mathlib
import Submission.Work.DSSER.Basic
import Submission.Work.DSSER.IdealPow

universe u

namespace Work.DSSER

open IsLocalRing

/-- `𝔪^n R' ≤ (Z)^n` in `R' = R[Z]/(Z_i^p - z_i)` (for `p > 0`).
Route: `maximalIdeal_pow_eq_span` writes `𝔪^n = span {z^w : |w| = n}`; its image in `R'` is generated by
`Z^(p·w)` (`Basic.serZpow_p_mul`), and `Z^(p·w) ∈ (Z)^(p·n) ≤ (Z)^n` (`Basic.serZpow_mem_pow`,
`Ideal.pow_le_pow_right`). -/
theorem maximalIdeal_pow_map_le_serIdeal_pow (R : Type u) [CommRing R] [IsLocalRing R] (p : ℕ)
    (hp : 0 < p) {d : ℕ} (z : Fin d → R) (hm : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal R)
    (n : ℕ) :
    Ideal.map (algebraMap R (Work.DSSER.serRing R p z)) (IsLocalRing.maximalIdeal R ^ n) ≤
      Work.DSSER.serIdeal p z ^ n := by
  rw [maximalIdeal_pow_eq_span R z hm n, Ideal.map_span]
  refine Ideal.span_le.mpr ?_
  rintro a ⟨b, ⟨w, hw, rfl⟩, rfl⟩
  rw [show algebraMap R (serRing R p z) (zMono z w) = serZpow p z (fun i => p * w i) from
    (serZpow_p_mul (p := p) (z := z) w).symm]
  have hle : n ≤ ∑ i, p * w i := by
    rw [← hw]
    exact Finset.sum_le_sum fun i _ => Nat.le_mul_of_pos_left (w i) hp
  exact (Ideal.pow_le_pow_right hle) (serZpow_mem_pow (p := p) (z := z) (w := fun i => p * w i))

end Work.DSSER
