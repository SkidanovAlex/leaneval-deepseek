/-
DSSER: the series lemma (SER) — Frobenius surjectivity modulo `p` after adjoining `p`-th roots of a
set of generators of the maximal ideal.

This is the file the lead consumer imports: `Work.DSSER.area_SER_proved`, whose statement is the
frozen `DSMap.Gaps.area_SER`.
-/
import Submission.Work.DSSER.Basic
import Submission.Work.DSSER.Words
import Submission.Work.DSSER.Cross
import Submission.Work.DSSER.IdealPow
import Submission.Work.DSSER.exists_expansion
import Submission.Work.DSSER.moduleFinite_serRing
import Submission.Work.DSSER.isAdicComplete_of_finite
import Submission.Work.DSSER.isAdicComplete_maximalIdeal_serRing
import Submission.Work.DSSER.maximalIdeal_pow_map_le_serIdeal_pow
import Submission.Work.DSSER.exists_limit_of_cauchy_serIdeal
import Submission.Work.DSSER.eq_zero_of_forall_mem_serIdeal_pow
import Submission.Work.DSMap.Gaps

universe u

namespace Work.DSSER

open MvPolynomial IsLocalRing

variable {R : Type u} [CommRing R]

/-- **The series lemma (SER).**  Let `R` be a complete Noetherian local ring with `p ∈ 𝔪`, whose
residue field is perfect in the elementary form `R = R^p + 𝔪`, and let `z : Fin d → R` generate `𝔪`.
Then in `R' = R[Z]/(Z_i^p - z_i)` every `x ∈ R` is a `p`-th power modulo `p`, and if `x ∈ 𝔪` the
correction can be taken in the ideal `(Z)` generated by the `Z_i`. -/
theorem area_SER_proved (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R]
    (hpm : (p : R) ∈ maximalIdeal R) (hperf : ∀ x : R, ∃ μ : R, x - μ ^ p ∈ maximalIdeal R)
    {d : ℕ} (z : Fin d → R) (hz : Ideal.span (Set.range z) = maximalIdeal R) (x : R) :
    ∃ b h : MvPolynomial (Fin d) R ⧸
        Ideal.span (Set.range fun i => MvPolynomial.X i ^ p - MvPolynomial.C (z i)),
      b ^ p = algebraMap R _ x + (p : R) • h ∧
      (x ∈ maximalIdeal R → h ∈ Ideal.span (Set.range fun i => Ideal.Quotient.mk _
        (MvPolynomial.X i))) := by
  classical
  have hp : 0 < p := (Fact.out : p.Prime).pos
  -- the `𝔪`-adic digit expansion of `x`
  obtain ⟨μ, r, hr, hexp⟩ := exists_expansion R p hp z hz hperf x
  -- the corresponding elements of `R'`
  let F : (Fin d → ℕ) → serRing R p z := fun w => algebraMap R _ (μ w) * serZpow p z w
  let bN : ℕ → serRing R p z := fun N => ((wordList d N).map F).sum
  let hN : ℕ → serRing R p z := fun N => crossElt p ((wordList d N).map F)
  have hFpow : ∀ w, F w ^ p = algebraMap R (serRing R p z) (μ w ^ p * zMono z w) := by
    intro w
    rw [show F w = algebraMap R (serRing R p z) (μ w) * serZpow p z w from rfl, mul_pow,
      ← map_pow, serZpow_pow, ← map_mul]
  -- the `p`-th power of `bN N` in closed form
  have hkey : ∀ N, bN N ^ p = algebraMap R (serRing R p z) x -
      algebraMap R (serRing R p z) (r N) + (p : serRing R p z) * hN N := by
    intro N
    have h := crossElt_sum_pow (S := serRing R p z) p ((wordList d N).map F)
    have hmap : (((wordList d N).map F).map (fun a => a ^ p)).sum =
        algebraMap R (serRing R p z) (((wordList d N).map
          (fun w => μ w ^ p * zMono z w)).sum) := by
      rw [List.map_map]
      trans (List.map (algebraMap R (serRing R p z))
        ((wordList d N).map (fun w => μ w ^ p * zMono z w))).sum
      · congr 1
        rw [List.map_map]
        exact List.map_congr_left fun w _ => hFpow w
      · exact (map_list_sum (algebraMap R (serRing R p z)) _).symm
    have htel : ((wordList d N).map (fun w => μ w ^ p * zMono z w)).sum = x - r N := by
      have := hexp N
      rw [this, add_sub_cancel_right]
    rw [h, hmap, htel, map_sub]
  -- the sequence `bN` is `(Z)`-adically Cauchy
  have hbNcauchy : ∀ M N, M ≤ N → bN M - bN N ∈ serIdeal p z ^ M := by
    intro M N hMN
    have hsplit : (wordList d N).map F = (wordList d M).map F ++
        (wordRest d M N).map F := by
      rw [wordList_eq_append hMN, List.map_append]
    have hmem : ∀ a ∈ (wordRest d M N).map F, a ∈ serIdeal p z ^ M := by
      intro a ha
      obtain ⟨w, hw, rfl⟩ := List.mem_map.mp ha
      show algebraMap R (serRing R p z) (μ w) * serZpow p z w ∈ serIdeal p z ^ M
      exact (serIdeal p z ^ M).mul_mem_left (algebraMap R (serRing R p z) (μ w))
        (serZpow_mem_pow_of_le w (mem_wordRest hMN hw))
    show ((wordList d M).map F).sum - ((wordList d N).map F).sum ∈ serIdeal p z ^ M
    rw [hsplit, List.sum_append]
    rw [show ((wordList d M).map F).sum - (((wordList d M).map F).sum +
      ((wordRest d M N).map F).sum) = -((wordRest d M N).map F).sum from by ring]
    exact neg_mem (list_sum_mem _ hmem)
  -- the sequence `hN` is `(Z)`-adically Cauchy
  have hhNcauchy : ∀ M N, M ≤ N → hN M - hN N ∈ serIdeal p z ^ M := by
    intro M N hMN
    have hsplit : (wordList d N).map F = (wordList d M).map F ++
        (wordRest d M N).map F := by
      rw [wordList_eq_append hMN, List.map_append]
    have hmem : ∀ a ∈ (wordRest d M N).map F, a ∈ serIdeal p z ^ M := by
      intro a ha
      obtain ⟨w, hw, rfl⟩ := List.mem_map.mp ha
      show algebraMap R (serRing R p z) (μ w) * serZpow p z w ∈ serIdeal p z ^ M
      exact (serIdeal p z ^ M).mul_mem_left (algebraMap R (serRing R p z) (μ w))
        (serZpow_mem_pow_of_le w (mem_wordRest hMN hw))
    have h := crossElt_append_sub_mem (S := serRing R p z) p (serIdeal p z ^ M)
      (l₁ := (wordList d M).map F) (l₂ := (wordRest d M N).map F) hmem
    show crossElt p ((wordList d M).map F) - crossElt p ((wordList d N).map F) ∈
      serIdeal p z ^ M
    rw [hsplit, ← neg_sub]
    exact neg_mem h
  -- the limits
  obtain ⟨b, hb⟩ := exists_limit_of_cauchy_serIdeal R p hp z hz bN hbNcauchy
  obtain ⟨h, hh⟩ := exists_limit_of_cauchy_serIdeal R p hp z hz hN hhNcauchy
  -- every `hN N` lies in `(Z)`
  have hNmem : ∀ N, hN N ∈ serIdeal p z := by
    intro N
    rcases Nat.eq_zero_or_pos N with hN0 | hNpos
    · subst hN0
      show (0 : serRing R p z) ∈ serIdeal p z
      exact Ideal.zero_mem _
    · have hsplit : (wordList d N).map F = (wordList d 1).map F ++
          (wordRest d 1 N).map F := by
        rw [wordList_eq_append hNpos, List.map_append]
      have hmem : ∀ a ∈ (wordRest d 1 N).map F, a ∈ serIdeal p z := by
        intro a ha
        obtain ⟨w, hw, rfl⟩ := List.mem_map.mp ha
        show algebraMap R (serRing R p z) (μ w) * serZpow p z w ∈ serIdeal p z
        refine (serIdeal p z).mul_mem_left (algebraMap R (serRing R p z) (μ w)) ?_
        have h1 := serZpow_mem_pow_of_le (p := p) (z := z) w (mem_wordRest hNpos hw)
        rwa [Submodule.pow_one] at h1
      have h := crossElt_append_sub_mem (S := serRing R p z) p (serIdeal p z)
        (l₁ := (wordList d 1).map F) (l₂ := (wordRest d 1 N).map F) hmem
      have h0 : crossElt p ((wordList d 1).map F) = 0 := by
        simp only [wordList_one, List.map_cons, List.map_nil, crossElt_singleton]
      show crossElt p ((wordList d N).map F) ∈ serIdeal p z
      rw [hsplit]
      rw [h0, sub_zero] at h
      exact h
  -- hence the limit lies in `(Z)`
  have hmem : h ∈ serIdeal p z := by
    have h1 : hN 1 - h ∈ serIdeal p z := by
      have := hh 1
      rwa [Submodule.pow_one] at this
    have h2 : h = hN 1 - (hN 1 - h) := by ring
    rw [h2]
    exact Ideal.sub_mem _ (hNmem 1) h1
  -- the final identity
  have hfinal : b ^ p - (algebraMap R (serRing R p z) x +
      (p : serRing R p z) * h) = 0 := by
    refine eq_zero_of_forall_mem_serIdeal_pow R p hp z hz (y := _) fun n => ?_
    have h1 : bN n ^ p - b ^ p ∈ serIdeal p z ^ n := by
      obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow (bN n) b p
      rw [hc]
      exact (serIdeal p z ^ n).mul_mem_right c (hb n)
    have h2 : (p : serRing R p z) * hN n - (p : serRing R p z) * h ∈ serIdeal p z ^ n := by
      rw [← mul_sub]
      exact (serIdeal p z ^ n).mul_mem_left (p : serRing R p z) (hh n)
    have h3 : algebraMap R (serRing R p z) (r n) ∈ serIdeal p z ^ n :=
      maximalIdeal_pow_map_le_serIdeal_pow R p hp z hz n (Ideal.mem_map_of_mem _ (hr n))
    have hdecomp : b ^ p - (algebraMap R (serRing R p z) x + (p : serRing R p z) * h) =
        -(bN n ^ p - b ^ p) - algebraMap R (serRing R p z) (r n) +
        ((p : serRing R p z) * hN n - (p : serRing R p z) * h) := by
      rw [hkey n]; ring
    rw [hdecomp]
    exact Ideal.add_mem _ (Ideal.sub_mem _ (neg_mem h1) h3) h2
  refine ⟨b, h, ?_, fun _ => hmem⟩
  have hb' : b ^ p = algebraMap R (serRing R p z) x + (p : serRing R p z) * h := by
    rw [sub_eq_zero] at hfinal
    exact hfinal
  have hsmul : (p : R) • h = (p : serRing R p z) * h :=
    (Algebra.smul_def (p : R) h).trans (by rw [map_natCast])
  exact hb'.trans (congrArg (fun t => algebraMap R (serRing R p z) x + t) hsmul.symm)

end Work.DSSER

/-- the statement delivered here has exactly the type of the frozen node `DSMap.Gaps.area_SER` -/
example : @Work.DSSER.area_SER_proved = @DSMap.Gaps.area_SER := rfl
