/-
DSSER: powers of the maximal ideal, generated by monomials.

If `𝔪 = (z₁, …, z_d)`, then `𝔪^n` is spanned by the monomials `z^w` of total degree `n`
(`Work.DSSER.maximalIdeal_pow_eq_span`), and likewise `(Z)^n` in `R[Z]/(Z_i^p - z_i)`
(`Work.DSSER.serIdeal_pow_eq_span`).
-/
import Submission.Work.DSSER.Basic

universe u v

namespace Work.DSSER

open MvPolynomial IsLocalRing

theorem maximalIdeal_pow_eq_span (R : Type u) [CommRing R] [IsLocalRing R] {d : ℕ} (z : Fin d → R)
    (hm : Ideal.span (Set.range z) = maximalIdeal R) (n : ℕ) :
    maximalIdeal R ^ n = Ideal.span {a : R | ∃ w : Fin d → ℕ, (∑ i, w i = n) ∧ a = zMono z w} := by
  classical
  rw [← hm]
  refine le_antisymm ?_ ?_
  · induction n with
    | zero =>
      rw [Submodule.pow_zero, Ideal.one_eq_top]
      refine le_of_eq ((Ideal.eq_top_iff_one _).mpr ?_).symm
      refine Ideal.subset_span ⟨0, ?_, ?_⟩
      · exact Finset.sum_eq_zero (fun i _ => rfl)
      · exact zMono_zero.symm
    | succ n ih =>
      have hpow : (Ideal.span (Set.range z) : Ideal R) ^ (n + 1) =
          Ideal.span (Set.range z) ^ n * Ideal.span (Set.range z) := by
        rw [Ideal.IsTwoSided.pow_succ, Ideal.mul_comm]
      rw [hpow]
      refine le_trans (Ideal.mul_mono_left ih) ?_
      rw [Ideal.span_mul_span]
      refine Ideal.span_le.mpr ?_
      rintro a ⟨b, ⟨w, hw, rfl⟩, c, ⟨i, rfl⟩, rfl⟩
      refine Ideal.subset_span ⟨w + Pi.single (M := fun _ : Fin d => ℕ) i 1, ?_, ?_⟩
      · simp only [Pi.add_apply, Finset.sum_add_distrib]
        rw [Fintype.sum_eq_single (f := fun x => Pi.single (M := fun _ : Fin d => ℕ) i 1 x) i
          (fun j hj => Pi.single_eq_of_ne hj 1)]
        simp [Pi.single_eq_same, hw]
      · exact (zMono_add_single (z := z) w i).symm
  · refine Ideal.span_le.mpr ?_
    rintro a ⟨w, hw, rfl⟩
    rw [hm, ← hw]
    exact zMono_mem_pow hm w

theorem serIdeal_pow_eq_span (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (z : Fin d → R) (m : ℕ) :
    serIdeal p z ^ m = Ideal.span {a : serRing R p z |
      ∃ w : Fin d → ℕ, (∑ i, w i = m) ∧ a = serZpow p z w} := by
  classical
  refine le_antisymm ?_ ?_
  · induction m with
    | zero =>
      rw [Submodule.pow_zero, Ideal.one_eq_top]
      refine le_of_eq ((Ideal.eq_top_iff_one _).mpr ?_).symm
      refine Ideal.subset_span ⟨0, ?_, ?_⟩
      · exact Finset.sum_eq_zero (fun i _ => rfl)
      · exact serZpow_zero.symm
    | succ m ih =>
      have hpow : serIdeal p z ^ (m + 1) = serIdeal p z ^ m * serIdeal p z := by
        rw [Ideal.IsTwoSided.pow_succ, Ideal.mul_comm]
      rw [hpow]
      refine le_trans (Ideal.mul_mono_left ih) ?_
      rw [serIdeal, Ideal.span_mul_span]
      refine Ideal.span_le.mpr ?_
      rintro a ⟨b, ⟨w, hw, rfl⟩, c, ⟨i, rfl⟩, rfl⟩
      refine Ideal.subset_span ⟨w + Pi.single (M := fun _ : Fin d => ℕ) i 1, ?_, ?_⟩
      · simp only [Pi.add_apply, Finset.sum_add_distrib]
        rw [Fintype.sum_eq_single (f := fun x => Pi.single (M := fun _ : Fin d => ℕ) i 1 x) i
          (fun j hj => Pi.single_eq_of_ne hj 1)]
        simp [Pi.single_eq_same, hw]
      · exact (serZpow_add_single (p := p) (z := z) w i).symm
  · refine Ideal.span_le.mpr ?_
    rintro a ⟨w, hw, rfl⟩
    rw [← hw]
    exact serZpow_mem_pow w

end Work.DSSER
