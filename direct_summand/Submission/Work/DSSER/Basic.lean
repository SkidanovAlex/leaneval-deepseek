/-
DSSER: the series lemma (SER) — Frobenius surjectivity modulo p after adjoining
p-th roots of a set of generators of the maximal ideal.

Definitions and elementary API for the ring `R' = R[Z]/(Z_i^p - z_i)`.
-/
import Mathlib

/-!
# The ring `R[Z]/(Z_i^p - z_i)`

This file sets up the ring `R' := R[Z₁,…,Z_d]/(Z_i^p - z_i)` in which the series lemma lives,
together with the images `serZ i` of the variables, the ideal `serIdeal = (Z)` they generate,
and the monomials `zMono z w` (in `R`) and `serZpow p z w` (in `R'`).

Main results:

* `Work.DSSER.serZ_pow`: `Z_i^p = z_i` in `R'`.
* `Work.DSSER.serZpow_div_mod`: the digit decomposition `Z^w = Z^(w mod p) * z^(w / p)`.
* `Work.DSSER.serZpow_mem_pow`: `Z^w ∈ (Z)^(|w|)`.
* `Work.DSSER.zMono_mem_pow`: `z^w ∈ 𝔪^(|w|)`.
-/

universe u v

namespace Work.DSSER

open MvPolynomial IsLocalRing

variable {R : Type u} [CommRing R]

/-- The ideal of relations `(Z_i^p - z_i)_i` in `MvPolynomial (Fin d) R`. -/
noncomputable def serRel (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (z : Fin d → R) :
    Ideal (MvPolynomial (Fin d) R) :=
  Ideal.span (Set.range fun i => MvPolynomial.X i ^ p - MvPolynomial.C (z i))

/-- The ring `R' = R[Z]/(Z_i^p - z_i)` of the series lemma. -/
noncomputable abbrev serRing (R : Type u) [CommRing R] (p : ℕ) {d : ℕ} (z : Fin d → R) : Type u :=
  MvPolynomial (Fin d) R ⧸ serRel R p z

/-- The image of the variable `X i` in `serRing R p z`. -/
noncomputable abbrev serZ (p : ℕ) {d : ℕ} (z : Fin d → R) (i : Fin d) : serRing R p z :=
  Ideal.Quotient.mk (serRel R p z) (MvPolynomial.X i)

/-- The ideal `(Z)` of `serRing` generated by the `Z i`. -/
noncomputable def serIdeal (p : ℕ) {d : ℕ} (z : Fin d → R) : Ideal (serRing R p z) :=
  Ideal.span (Set.range (serZ p z))

/-- The monomial `Z^w` in `R'`. -/
noncomputable def serZpow (p : ℕ) {d : ℕ} (z : Fin d → R) (w : Fin d → ℕ) : serRing R p z :=
  ∏ i, serZ p z i ^ w i

/-- The monomial `z^w` in `R`. -/
noncomputable def zMono {d : ℕ} (z : Fin d → R) (w : Fin d → ℕ) : R :=
  ∏ i, z i ^ w i

section

variable {p d : ℕ} {z : Fin d → R}

theorem serZ_mem_serIdeal (i : Fin d) : serZ p z i ∈ serIdeal p z :=
  Ideal.subset_span (Set.mem_range_self i)

/-- `Z_i^p = z_i` in `R'`. -/
theorem serZ_pow (i : Fin d) : serZ p z i ^ p = algebraMap R (serRing R p z) (z i) := by
  have hmem : MvPolynomial.X i ^ p - MvPolynomial.C (z i) ∈ serRel R p z :=
    Ideal.subset_span ⟨i, rfl⟩
  have h : (Ideal.Quotient.mk (serRel R p z) (MvPolynomial.X i ^ p)) =
      Ideal.Quotient.mk (serRel R p z) (MvPolynomial.C (z i)) := by
    have h0 : Ideal.Quotient.mk (serRel R p z)
        (MvPolynomial.X i ^ p - MvPolynomial.C (z i)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [map_sub, sub_eq_zero] at h0
    exact h0
  rw [← map_pow, h]
  rw [MvPolynomial.C_eq_algebraMap, Ideal.Quotient.mk_algebraMap]

theorem serZpow_zero : serZpow p z (fun _ => 0) = 1 := by
  simp only [serZpow, Pi.zero_apply, pow_zero, Finset.prod_const_one]

theorem zMono_zero : zMono z (fun _ => 0) = 1 := by
  simp only [zMono, Pi.zero_apply, pow_zero, Finset.prod_const_one]

theorem serZpow_add (w v : Fin d → ℕ) :
    serZpow p z (w + v) = serZpow p z w * serZpow p z v := by
  simp only [serZpow, Pi.add_apply, pow_add, Finset.prod_mul_distrib]

theorem zMono_add (w v : Fin d → ℕ) : zMono z (w + v) = zMono z w * zMono z v := by
  simp only [zMono, Pi.add_apply, pow_add, Finset.prod_mul_distrib]

theorem sum_add_single (w : Fin d → ℕ) (i : Fin d) :
    ∑ j, (w + Pi.single (M := fun _ : Fin d => ℕ) i 1) j = (∑ j, w j) + 1 := by
  simp only [Pi.add_apply, Finset.sum_add_distrib]
  rw [Fintype.sum_eq_single (f := fun x => Pi.single (M := fun _ : Fin d => ℕ) i 1 x) i
    (fun j hj => Pi.single_eq_of_ne hj 1)]
  simp [Pi.single_eq_same]

theorem zMono_add_single (w : Fin d → ℕ) (i : Fin d) :
    zMono z (w + Pi.single (M := fun _ : Fin d => ℕ) i 1) = zMono z w * z i := by
  rw [zMono_add]
  congr 1
  simp only [zMono]
  rw [Finset.prod_eq_single i (fun j _ hj => by rw [Pi.single_eq_of_ne hj, pow_zero]) (by simp),
    Pi.single_eq_same, pow_one]

theorem serZpow_add_single (w : Fin d → ℕ) (i : Fin d) :
    serZpow p z (w + Pi.single (M := fun _ : Fin d => ℕ) i 1) = serZpow p z w * serZ p z i := by
  rw [serZpow_add]
  congr 1
  rw [serZpow, Finset.prod_eq_single i
    (fun j _ hj => by rw [Pi.single_eq_of_ne hj, pow_zero]) (by simp),
    Pi.single_eq_same, pow_one]

/-- The digit decomposition: `Z^w = Z^(w mod p) · z^(w / p)`. -/
theorem serZpow_div_mod (w : Fin d → ℕ) :
    serZpow p z w = serZpow p z (fun i => w i % p) *
      algebraMap R (serRing R p z) (zMono z (fun i => w i / p)) := by
  have hw : w = (fun i => w i % p) + (fun i => p * (w i / p)) := by
    funext i
    simp [Nat.mod_add_div]
  conv_lhs => rw [hw]
  rw [serZpow_add, zMono]
  congr 1
  rw [serZpow]
  trans ∏ i, algebraMap R (serRing R p z) (z i ^ (w i / p))
  · exact Finset.prod_congr rfl fun i _ => by rw [pow_mul, serZ_pow, map_pow]
  · exact (map_prod (algebraMap R (serRing R p z)) (fun i => z i ^ (w i / p))
      Finset.univ).symm

/-- `Z^(p·v) = z^v` in `R'`. -/
theorem serZpow_p_mul (v : Fin d → ℕ) :
    serZpow p z (fun i => p * v i) = algebraMap R (serRing R p z) (zMono z v) := by
  rw [serZpow]
  trans ∏ i, algebraMap R (serRing R p z) (z i ^ v i)
  · exact Finset.prod_congr rfl fun i _ => by rw [pow_mul, serZ_pow, map_pow]
  · simp only [zMono]
    exact (map_prod (algebraMap R (serRing R p z)) (fun i => z i ^ v i) Finset.univ).symm

/-- A product of elements lying in `I ^ (n i)` lies in `I ^ (∑ n i)`. -/
theorem finset_prod_mem_pow {S : Type v} [CommRing S] {I : Ideal S} {ι : Type*}
    (s : Finset ι) {f : ι → S} {n : ι → ℕ} (h : ∀ i ∈ s, f i ∈ I ^ n i) :
    ∏ i ∈ s, f i ∈ I ^ (∑ i ∈ s, n i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, Ideal.IsTwoSided.pow_add]
    exact Ideal.mul_mem_mul (h a (Finset.mem_insert_self a s))
      (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- `z^w ∈ 𝔪^(|w|)` when the `z i` generate the maximal ideal. -/
theorem zMono_mem_pow [IsLocalRing R] (hm : Ideal.span (Set.range z) = maximalIdeal R)
    (w : Fin d → ℕ) : zMono z w ∈ maximalIdeal R ^ (∑ i, w i) := by
  simp only [zMono]
  refine finset_prod_mem_pow Finset.univ (f := fun i => z i ^ w i) (n := w) fun i _ => ?_
  exact Ideal.pow_mem_pow (hm ▸ Ideal.subset_span (Set.mem_range_self i)) (w i)

/-- `Z^w ∈ (Z)^(|w|)`. -/
theorem serZpow_mem_pow (w : Fin d → ℕ) :
    serZpow p z w ∈ serIdeal p z ^ (∑ i, w i) := by
  simp only [serZpow]
  refine finset_prod_mem_pow Finset.univ (f := fun i => serZ p z i ^ w i) (n := w) fun i _ => ?_
  exact Ideal.pow_mem_pow (serZ_mem_serIdeal i) (w i)

/-- If every element of a list of words has degree at least `n`, each monomial `Z^w` lies
in `(Z)^n`. -/
theorem serZpow_mem_pow_of_le (w : Fin d → ℕ) {n : ℕ} (h : n ≤ ∑ i, w i) :
    serZpow p z w ∈ serIdeal p z ^ n :=
  Ideal.pow_le_pow_right h (serZpow_mem_pow w)

/-- `(Z^w)^p = z^w`; the `p`-th power of a monomial is the corresponding monomial in `R`. -/
theorem serZpow_pow (w : Fin d → ℕ) :
    serZpow p z w ^ p = algebraMap R (serRing R p z) (zMono z w) := by
  rw [show serZpow p z w = ∏ i, serZ p z i ^ w i from rfl, ← Finset.prod_pow]
  trans ∏ i, algebraMap R (serRing R p z) (z i ^ w i)
  · exact Finset.prod_congr rfl fun i _ => by rw [← pow_mul, Nat.mul_comm, pow_mul, serZ_pow, map_pow]
  · simp only [zMono]
    exact (map_prod (algebraMap R (serRing R p z)) (fun i => z i ^ w i) Finset.univ).symm

end

/-! ## The set of words, enumerated by degree -/

/-- The words `w : Fin d → ℕ` of degree exactly `N`, as a list.  The order inside the block is
irrelevant; only the block structure matters. -/
noncomputable def wordBlk (d N : ℕ) : List (Fin d → ℕ) :=
  (((Fintype.piFinset (fun _ : Fin d => Finset.range (N + 1))).filter
    (fun w => ∑ i, w i = N))).val.toList

/-- The words of degree `< N`, listed block by block in increasing degree. -/
noncomputable def wordList (d N : ℕ) : List (Fin d → ℕ) := (List.range N).flatMap (wordBlk d)

/-- The words of degree in `[M, N)`, listed block by block. -/
noncomputable def wordRest (d M N : ℕ) : List (Fin d → ℕ) :=
  ((List.range (N - M)).map (fun k => M + k)).flatMap (wordBlk d)

/-- The words of degree `< N`, as a finset. -/
noncomputable def wordFinset (d N : ℕ) : Finset (Fin d → ℕ) :=
  (Fintype.piFinset (fun _ : Fin d => Finset.range N)).filter (fun w => ∑ i, w i < N)

theorem mem_wordFinset {d N : ℕ} {w : Fin d → ℕ} : w ∈ wordFinset d N ↔ ∑ i, w i < N := by
  simp only [wordFinset, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_range]
  constructor
  · rintro ⟨-, h⟩; exact h
  · intro h
    exact ⟨fun i => lt_of_le_of_lt (Finset.single_le_sum (f := w) (fun i _ => Nat.zero_le _)
      (Finset.mem_univ i)) h, h⟩

theorem mem_wordBlk {d N : ℕ} {w : Fin d → ℕ} : w ∈ wordBlk d N ↔ ∑ i, w i = N := by
  simp only [wordBlk, Multiset.mem_toList, Finset.mem_val, Finset.mem_filter,
    Fintype.mem_piFinset, Finset.mem_range]
  constructor
  · rintro ⟨-, h⟩; exact h
  · intro h
    refine ⟨fun i => ?_, h⟩
    have := Finset.single_le_sum (f := w) (fun i _ => Nat.zero_le _) (Finset.mem_univ i)
    omega

theorem wordBlk_nodup (d N : ℕ) : (wordBlk d N).Nodup := by
  simp only [wordBlk]
  rw [← Multiset.coe_nodup, Multiset.coe_toList]
  exact (Finset.filter _ _).nodup

/-! ## The `p`-divided cross term of a list -/

/-- One step of the cross-term fold. -/
noncomputable def crossStep (p : ℕ) {S : Type v} [CommRing S] (acc : S × S) (a : S) : S × S :=
  (acc.1 + a, acc.2 + ∑ i ∈ Finset.range (p - 1),
      ((p.choose (i + 1) / p : ℕ) : S) * acc.1 ^ (i + 1) * a ^ (p - (i + 1)))

/-- The `p`-divided cross term of a list `l` relative to a starting sum `S0`. -/
noncomputable def crossAux (p : ℕ) {S : Type v} [CommRing S] (S0 : S) (l : List S) : S :=
  (l.foldl (crossStep p) (S0, 0)).2

/-- The `p`-divided cross term of a list `l`: the element `h` with
`(l.sum)^p = (l.map (·^p)).sum + p * h`. -/
noncomputable def crossElt (p : ℕ) {S : Type v} [CommRing S] (l : List S) : S :=
  crossAux p 0 l

theorem crossElt_singleton (p : ℕ) {S : Type v} [CommRing S] (a : S) : crossElt p [a] = 0 := by
  simp only [crossElt, crossAux, List.foldl_cons, List.foldl_nil, crossStep]
  rw [zero_add]
  refine Finset.sum_eq_zero fun i hi => ?_
  simp [zero_pow (Nat.succ_ne_zero i)]

/-- A sum of elements of a submodule lies in the submodule. -/
theorem list_sum_mem {S : Type v} [CommRing S] (I : Ideal S) {l : List S}
    (h : ∀ a ∈ l, a ∈ I) : l.sum ∈ I := by
  induction l with
  | nil => exact I.zero_mem
  | cons a l ih =>
    simpa using I.add_mem (h a (List.mem_cons_self ..))
      (ih fun b hb => h b (List.mem_cons_of_mem _ hb))

end Work.DSSER
