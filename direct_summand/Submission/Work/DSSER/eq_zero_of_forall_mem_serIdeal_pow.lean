import Mathlib
import Submission.Work.DSSER.Basic
import Submission.Work.DSSER.IdealPow
import Submission.Work.DSSER.moduleFinite_serRing

/-!
# The `(Z)`-adic topology on `R[Z]/(Z_i^p - z_i)` is Hausdorff

This file proves that an element of `R' = R[Z]/(Z_i^p - z_i)` which lies in every power of the ideal
`(Z)` generated by the variables must vanish (`R` Noetherian local, `𝔪 = (z)` generated by the `z i`,
`0 < p`).

The mathematical content is the comparison of the `(Z)`-adic and the `𝔪`-adic filtrations:
`(Z)^(p·(n+d)) ≤ 𝔪^n R'`, whence an element lying in all `(Z)^n` lies in all `𝔪^n R'`, and for the
finite `R`-module `R'` Krull's intersection theorem (`Ideal.iInf_pow_smul_eq_bot_of_isLocalRing`)
forces it to be `0`.

The comparison `(Z)^(p·(n+d)) ≤ 𝔪^n R'` is proved here (as `serIdeal_pow_le_map_maximalIdeal_pow`)
since it is the only input of the argument; it is the digit-decomposition/counting step: a monomial
`Z^w` with `|w| = p (n+d)` is `Z^(w mod p) · z^(w / p)` (`serZpow_div_mod`) and the counting lemma
`Σ (w i / p) ≥ n` (from `Σ (w i % p) ≤ (p-1) d`) puts `z^(w / p)` in `𝔪^n`.
-/

universe u

namespace Work.DSSER

open MvPolynomial IsLocalRing

/-- Counting lemma.  If a word `w` of `d` natural numbers satisfies `Σ i, w i = p (n + d)`, then
`Σ i, w i / p ≥ n` (for `p > 0`): the discarded remainders amount to at most `(p-1) d`. -/
private theorem sum_div_ge_of_sum_eq {d : ℕ} (p n : ℕ) (hp : 0 < p) (w : Fin d → ℕ)
    (hw : ∑ i, w i = p * (n + d)) : n ≤ ∑ i, w i / p := by
  have hdecomp : p * (∑ i, w i / p) + ∑ i, w i % p = ∑ i, w i := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => Nat.div_add_mod (w i) p
  have hmod : ∑ i, w i % p ≤ d * (p - 1) := by
    calc ∑ i, w i % p ≤ ∑ _i : Fin d, (p - 1) :=
          Finset.sum_le_sum fun i _ => Nat.le_sub_one_of_lt (Nat.mod_lt (w i) hp)
      _ = d * (p - 1) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_id]
  have hmain : p * (n + d) ≤ p * (∑ i, w i / p) + d * (p - 1) := by
    rw [← hw, ← hdecomp]
    exact add_le_add_right hmod _
  have hfin : p * n + d * p ≤ p * (∑ i, w i / p) + d * p := by
    calc p * n + d * p = p * n + p * d := by rw [Nat.mul_comm d p]
      _ = p * (n + d) := by ring
      _ ≤ p * (∑ i, w i / p) + d * (p - 1) := hmain
      _ ≤ p * (∑ i, w i / p) + d * p :=
          add_le_add_right (Nat.mul_le_mul_left d (Nat.pred_le p)) _
  exact Nat.le_of_mul_le_mul_left (Nat.add_le_add_iff_right.mp hfin) hp

/-- `(Z)^(p(n+d)) ≤ 𝔪^n R'` in `R' = R[Z]/(Z_i^p - z_i)` (`p > 0`, `d` = number of variables).

Route: `serIdeal_pow_eq_span` writes `(Z)^(p(n+d))` as the span of the monomials `Z^w` with
`|w| = p (n+d)`, so it suffices that each such `Z^w` lies in `𝔪^n R'`: write `w i = p (w i / p) +
w i % p`, use `serZpow_div_mod` and `zMono_mem_pow` together with the counting lemma
`sum_div_ge_of_sum_eq`. -/
private theorem serIdeal_pow_le_map_maximalIdeal_pow (R : Type u) [CommRing R] [IsLocalRing R]
    (p : ℕ) (hp : 0 < p) {d : ℕ} (z : Fin d → R)
    (hm : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal R) (n : ℕ) :
    serIdeal p z ^ (p * (n + d)) ≤
      Ideal.map (algebraMap R (serRing R p z)) (IsLocalRing.maximalIdeal R ^ n) := by
  rw [serIdeal_pow_eq_span R p z (p * (n + d))]
  refine Ideal.span_le.mpr ?_
  rintro a ⟨w, hw, rfl⟩
  have hle : n ≤ ∑ i, w i / p := sum_div_ge_of_sum_eq p n hp w hw
  have hzmono : zMono z (fun i => w i / p) ∈ IsLocalRing.maximalIdeal R ^ n :=
    Ideal.pow_le_pow_right hle (zMono_mem_pow hm (fun i => w i / p))
  rw [serZpow_div_mod]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem (algebraMap R (serRing R p z)) hzmono)

/-- The `(Z)`-adic topology on `R' = R[Z]/(Z_i^p - z_i)` is Hausdorff: an element lying in every power
of `(Z)` is `0` (`R` Noetherian local, `𝔪 = (z)`, `0 < p`).

Route: `(Z)^(p(k+d)) ≤ 𝔪^k R'` (`serIdeal_pow_le_maximalIdeal_pow_map`), so `y ∈ 𝔪^k R'` for all `k`;
`IsHausdorff.of_le_jacobson` for the finite `R`-module `R'` (`moduleFinite_serRing`) finishes. -/
theorem eq_zero_of_forall_mem_serIdeal_pow (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (p : ℕ) (hp : 0 < p) {d : ℕ} (z : Fin d → R)
    (hm : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal R) {y : Work.DSSER.serRing R p z}
    (h : ∀ n, y ∈ Work.DSSER.serIdeal p z ^ n) : y = 0 := by
  -- `R'` is a finite `R`-module, since every `Z i` is integral over `R` (`Z i ^ p = z i`).
  haveI : Module.Finite R (serRing R p z) := moduleFinite_serRing R p hp z
  -- The hypothesis puts `y` in every `𝔪^k R'` (the image of `𝔪^k` in `R'`).
  have hy : y ∈ (⨅ k : ℕ, IsLocalRing.maximalIdeal R ^ k • (⊤ : Submodule R (serRing R p z))) := by
    rw [Submodule.mem_iInf]
    intro k
    have h1 : y ∈ serIdeal p z ^ (p * (k + d)) := h (p * (k + d))
    have h2 : y ∈ Ideal.map (algebraMap R (serRing R p z)) (IsLocalRing.maximalIdeal R ^ k) :=
      serIdeal_pow_le_map_maximalIdeal_pow R p hp z hm k h1
    rwa [Ideal.smul_top_eq_map]
  -- Krull's intersection theorem for the Noetherian local ring `R` acting on the finite module `R'`.
  have hbot : (⨅ k : ℕ, IsLocalRing.maximalIdeal R ^ k • (⊤ : Submodule R (serRing R p z))) = ⊥ :=
    Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (Ideal.IsMaximal.ne_top (IsLocalRing.maximalIdeal.isMaximal R))
  rw [hbot] at hy
  simpa using hy

end Work.DSSER
