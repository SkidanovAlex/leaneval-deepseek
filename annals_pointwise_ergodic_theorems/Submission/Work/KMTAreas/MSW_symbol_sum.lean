/-
# The Ionescu–Wainger symbol over the single-torsion set `(1/Q)ℤ/ℤ`

This module computes the Ionescu–Wainger symbol `iwSymbolSet (iwDenomFreqs {Q}) (periodize φ)`
attached to the *single* denominator `Q`: it is the plain `Q`-term sum

`ξ ↦ ∑_{a < Q} (periodize φ) (ξ - a/Q)`.

`iwDenomFreqs {Q}` is, by definition, the image of `{0, 1, …, Q-1}` under `a ↦ a/Q` in `ℝ/ℤ`
(`Work.KMTAreas.iwDenomFreqs`), so this is `Finset.sum_image` applied to the map `a ↦ a/Q`, the
only mathematical input being that `a ↦ a/Q` is injective on `{0, …, Q-1}` — i.e. that
`(a - b)/Q ∈ ℤ` with `|a - b| < Q` forces `a = b`.  That is proved here by reducing the equality
in `ℝ/ℤ` to an equality in `ℝ` via the representatives `Ico 0 1`
(`AddCircle.coe_eq_coe_iff_of_mem_Ico`).

This is the formal statement of the elementary identity used when the Ionescu–Wainger height
`l` is `0` (only the frequency `0` matters) or, more generally, when the frequency set is the
single torsion subgroup generated by `1/Q`.
-/
import Mathlib
import Submission.Work.KMTAreas.MSW_defs

set_option autoImplicit false

namespace Work.KMTAreas


/-- **Injectivity of `a ↦ a/Q` on `{0, …, Q-1}` inside `ℝ/ℤ`.**

If `a, b < Q` and `a/Q = b/Q` in the frequency circle `ℝ/ℤ`, then `a = b`.  Indeed both `a/Q`
and `b/Q` lie in `Ico 0 1`, and the equality in `ℝ/ℤ` of two elements of `Ico 0 1` is an equality
in `ℝ`; cancelling `Q ≠ 0` gives `a = b`. -/
private theorem div_nat_injOn_range {Q : ℕ} (hQ : 1 ≤ Q) {a b : ℕ}
    (ha : a < Q) (hb : b < Q)
    (h : (((a : ℝ) / (Q : ℝ) : ℝ) : Work.Analysis.IonescuWainger.Circle) =
        (((b : ℝ) / (Q : ℝ) : ℝ) : Work.Analysis.IonescuWainger.Circle)) : a = b := by
  have hQpos : (0 : ℝ) < (Q : ℝ) := by exact_mod_cast (Nat.lt_of_lt_of_le Nat.zero_lt_one hQ)
  have ha0 : (0 : ℝ) ≤ (a : ℝ) := Nat.cast_nonneg a
  have hb0 : (0 : ℝ) ≤ (b : ℝ) := Nat.cast_nonneg b
  have haQ : (a : ℝ) < (Q : ℝ) := by exact_mod_cast ha
  have hbQ : (b : ℝ) < (Q : ℝ) := by exact_mod_cast hb
  have hmem_a : (a : ℝ) / (Q : ℝ) ∈ Set.Ico (0 : ℝ) (0 + 1) := by
    refine ⟨div_nonneg ha0 hQpos.le, ?_⟩
    rw [zero_add, div_lt_one hQpos]
    exact haQ
  have hmem_b : (b : ℝ) / (Q : ℝ) ∈ Set.Ico (0 : ℝ) (0 + 1) := by
    refine ⟨div_nonneg hb0 hQpos.le, ?_⟩
    rw [zero_add, div_lt_one hQpos]
    exact hbQ
  have h' : (a : ℝ) / (Q : ℝ) = (b : ℝ) / (Q : ℝ) :=
    (AddCircle.coe_eq_coe_iff_of_mem_Ico (a := (0 : ℝ)) (p := (1 : ℝ)) hmem_a hmem_b).mp h
  have : (a : ℝ) = (b : ℝ) := by
    field_simp at h'
    linarith [h']
  exact Nat.cast_injective this

/-- The single-torsion frequency set `(1/Q)ℤ/ℤ` is the image of `{0, …, Q-1}` under `a ↦ a/Q`. -/
private theorem iwDenomFreqs_singleton (Q : ℕ) :
    iwDenomFreqs {Q}
      = (Finset.range Q).image (fun a : ℕ => (((a : ℝ) / (Q : ℝ) : ℝ) : Work.Analysis.IonescuWainger.Circle)) := by
  rw [iwDenomFreqs, Finset.singleton_biUnion]

/-- **The Ionescu–Wainger symbol of the single-torsion set `{1/Q}` is the `Q`-term sum of the
translates of the periodised symbol.** -/
theorem MSW_symbol_sum (Q : ℕ) (hQ : 1 ≤ Q) (φ : ℝ → ℂ) :
    Work.Analysis.IonescuWainger.iwSymbolSet (iwDenomFreqs {Q})
        (Work.Analysis.IonescuWainger.periodize φ)
      = fun t => Finset.sum (Finset.range Q)
          (fun a => Work.Analysis.IonescuWainger.periodize φ
            (t - (((a : ℝ) / (Q : ℝ) : ℝ) : Work.Analysis.IonescuWainger.Circle))) := by
  funext t
  rw [Work.Analysis.IonescuWainger.iwSymbolSet_apply, iwDenomFreqs_singleton Q,
    Finset.sum_image (fun a ha b hb hab =>
      div_nat_injOn_range hQ (Finset.mem_range.mp ha) (Finset.mem_range.mp hb) hab)]

end Work.KMTAreas
