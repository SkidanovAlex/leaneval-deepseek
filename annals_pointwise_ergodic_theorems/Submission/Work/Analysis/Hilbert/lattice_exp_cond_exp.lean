import Mathlib
import Submission.Work.Analysis.Hilbert.lattice_exp_average

/-!
# The shifted lattice average is a conditional expectation

This file proves `lattice_exp_cond_exp`: for `g : ℤ → ℝ` integrable w.r.t. the counting measure on
`ℤ`, the atom average `latticeExpR k τ g` is a version of the conditional expectation
`condExp (latticeSpan k τ) count g`, where `latticeSpan k τ` is the σ-algebra generated by the
`τ`-shifted dyadic lattice of scale `2^k`.

Together with `lattice_exp_average` (the `τ`-averaging identity) this shows that the triangular
(Fejér) smoothing `triConv k g` is, for each `k`, the average of the conditional expectations
`E[g | latticeSpan k τ]` over a complete residue system of shifts `τ`.  Since the lattices coarsen
as `k` grows, `k ↦ latticeExp k τ g` is a reverse martingale, and reversing the index turns it into
an honest `condExp`-martingale to which Lépingle's inequality applies.

The proof of the identification is the standard one for finite atoms: `latticeExpR k τ g` is
constant on the atoms of `latticeSpan k τ` (so it is strongly measurable for that σ-algebra), and
its integral over any `m`-measurable set of finite counting measure agrees with that of `g` — the
σ-algebra is generated by the atoms, so such a set is a finite union of atoms, and on each atom the
atom average integrates to the same thing as `g` itself.
-/

open Finset MeasureTheory
open scoped BigOperators ENNReal

namespace Work.Analysis.Hilbert

noncomputable section

variable (k : ℕ) (τ : ℤ)

/-! ## Atoms of the shifted lattice -/

lemma latticeBase_mem_coset (n : ℤ) : ∃ m : ℤ, latticeBase k τ n = -τ + (2:ℤ)^k * m :=
  ⟨(n + τ) / (2:ℤ)^k, by rw [latticeBase]⟩

/-- Uniqueness of the lattice point of the coset `-τ + 2^kℤ` in an interval of length `2^k`. -/
lemma latticeBase_eq_of_mem {b y : ℤ} (hb : ∃ m : ℤ, b = -τ + (2:ℤ)^k * m)
    (h1 : b ≤ y) (h2 : y < b + (2:ℤ)^k) : latticeBase k τ y = b := by
  obtain ⟨m, hm⟩ := hb
  obtain ⟨m', hm'⟩ := latticeBase_mem_coset k τ y
  have hbpos : (0:ℤ) < (2:ℤ)^k := by positivity
  have hle := latticeBase_le k τ y
  have hlt := lt_latticeBase_add k τ y
  have hdiff : |b - latticeBase k τ y| < (2:ℤ)^k := by
    rw [abs_lt]
    constructor <;> linarith
  have hdvd : b - latticeBase k τ y = (2:ℤ)^k * (m - m') := by rw [hm, hm']; ring
  rw [hdvd, abs_mul, abs_of_pos hbpos] at hdiff
  have hmm : |m - m'| < 1 := lt_of_mul_lt_mul_left (by simpa using hdiff) hbpos.le
  have hzero : m - m' = 0 := by
    rw [abs_lt] at hmm
    omega
  have hm_eq : m = m' := by omega
  rw [hm', hm, hm_eq]

lemma latticeBase_eq_iff {b : ℤ} (hb : ∃ m : ℤ, b = -τ + (2:ℤ)^k * m) (y : ℤ) :
    latticeBase k τ y = b ↔ b ≤ y ∧ y < b + (2:ℤ)^k := by
  constructor
  · intro h
    rw [← h]
    exact ⟨latticeBase_le k τ y, lt_latticeBase_add k τ y⟩
  · rintro ⟨h1, h2⟩
    exact latticeBase_eq_of_mem k τ hb h1 h2

/-- The atom of `latticeSpan k τ` containing a lattice point `b` is the interval `[b, b+2^k)`. -/
lemma fiber_eq_Ico {b : ℤ} (hb : ∃ m : ℤ, b = -τ + (2:ℤ)^k * m) :
    {x : ℤ | latticeBase k τ x = b} = Set.Ico b (b + (2:ℤ)^k) := by
  ext x
  rw [Set.mem_ofPred_eq, Set.mem_Ico, latticeBase_eq_iff k τ hb x]

/-! ## `latticeExpR` factors through the atom map -/

/-- The atom average is `ψ ∘ (latticeBase k τ)` for the explicit `ψ`. -/
def latticePsi (g : ℤ → ℝ) (b : ℤ) : ℝ := ((2:ℝ)^k)⁻¹ * ∑ d ∈ Finset.range (2^k), g (b + d)

lemma latticeExpR_eq_comp (g : ℤ → ℝ) : latticeExpR k τ g = latticePsi k g ∘ latticeBase k τ := by
  funext n
  rw [Function.comp_apply, latticeExpR, latticePsi]


/-! ## `latticeExpR` is measurable for the lattice σ-algebra -/

lemma measurable_latticeExpR (g : ℤ → ℝ) :
    Measurable[latticeSpan k τ] (latticeExpR k τ g) := by
  rw [latticeExpR_eq_comp k τ g, latticeSpan]
  refine measurable_iff_comap_le.mpr ?_
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono le_top

lemma aestronglyMeasurable_latticeExpR (g : ℤ → ℝ) :
    AEStronglyMeasurable[latticeSpan k τ] (latticeExpR k τ g) Measure.count :=
  (measurable_latticeExpR k τ g).aestronglyMeasurable

/-! ## The trimmed counting measure is σ-finite -/

lemma measurableSet_lattice_preimage (T : Set ℤ) :
    MeasurableSet[latticeSpan k τ] ((latticeBase k τ) ⁻¹' T) :=
  MeasurableSpace.measurableSet_comap.mpr ⟨T, trivial, rfl⟩

/-- On every bounded interval the `τ`-shifted lattice σ-algebra carries finite counting measure. -/
lemma trim_count_lt_top (n : ℕ) :
    (Measure.count.trim (show latticeSpan k τ ≤ (⊤ : MeasurableSpace ℤ) from le_top))
        ((latticeBase k τ) ⁻¹' Set.Icc (-(n:ℤ)) (n:ℤ)) < ⊤ := by
  have hm : latticeSpan k τ ≤ (⊤ : MeasurableSpace ℤ) := le_top
  rw [MeasureTheory.trim_measurableSet_eq hm (measurableSet_lattice_preimage k τ _)]
  refine (Measure.count_apply_lt_top).mpr (Set.Finite.subset
    (Set.finite_Icc (-(n:ℤ)) ((n:ℤ) + (2:ℤ)^k)) ?_)
  intro x hx
  simp only [Set.mem_preimage, Set.mem_Icc] at hx ⊢
  have h1 := latticeBase_le k τ x
  have h2 := lt_latticeBase_add k τ x
  constructor <;> omega

lemma iUnion_lattice_preimage_Icc :
    (⋃ n : ℕ, (latticeBase k τ) ⁻¹' Set.Icc (-(n:ℤ)) (n:ℤ)) = Set.univ := by
  ext x
  simp only [Set.mem_iUnion, Set.mem_preimage, Set.mem_Icc, Set.mem_univ, iff_true]
  refine ⟨(latticeBase k τ x).natAbs, ?_, ?_⟩ <;> omega

instance sigmaFinite_trim_count_lattice :
    SigmaFinite (Measure.count.trim (show latticeSpan k τ ≤ (⊤ : MeasurableSpace ℤ) from le_top)) :=
  ⟨⟨Measure.FiniteSpanningSetsIn.mk
      (fun n : ℕ => (latticeBase k τ) ⁻¹' Set.Icc (-(n:ℤ)) (n:ℤ))
      (fun _ => Set.mem_univ _)
      (fun n => trim_count_lt_top k τ n)
      (iUnion_lattice_preimage_Icc k τ)⟩⟩

/-! ## `m`-measurable sets are unions of atoms -/

/-- A set measurable for the lattice σ-algebra is a union of atoms: it is the preimage of its
image under the atom map. -/
lemma latticeSpan_eq_preimage_image {s : Set ℤ} (hs : MeasurableSet[latticeSpan k τ] s) :
    s = (latticeBase k τ) ⁻¹' ((latticeBase k τ) '' s) := by
  obtain ⟨T, -, hT⟩ := MeasurableSpace.measurableSet_comap.mp hs
  rw [← hT]
  ext x
  constructor
  · intro hx
    exact ⟨x, hx, rfl⟩
  · rintro ⟨y, hy, hyx⟩
    rw [Set.mem_preimage] at hy ⊢
    rw [← hyx]
    exact hy

/-! ## Integrability on finite unions of atoms -/

/-- On a finite set, the atom average is integrable for the counting measure. -/
lemma integrableOn_latticeExpR_of_finite (g : ℤ → ℝ) {s : Set ℤ} (hsf : s.Finite) :
    IntegrableOn (latticeExpR k τ g) s (Measure.count : Measure ℤ) := by
  have hmeas : AEStronglyMeasurable (latticeExpR k τ g) ((Measure.count : Measure ℤ).restrict s) :=
    Measurable.aestronglyMeasurable
      (Measurable.mono (measurable_latticeExpR k τ g) le_top le_rfl)
  have hbdd : ∀ᵐ x ∂((Measure.count : Measure ℤ).restrict s),
      ‖latticeExpR k τ g x‖ ≤ ∑ x ∈ hsf.toFinset, ‖latticeExpR k τ g x‖ := by
    refine Filter.Eventually.mono
      (MeasureTheory.self_mem_ae_restrict (μ := (Measure.count : Measure ℤ))
        (show MeasurableSet (s : Set ℤ) from trivial)) (fun x hx => ?_)
    exact Finset.single_le_sum (fun y _ => norm_nonneg _) (hsf.mem_toFinset.mpr hx)
  exact MeasureTheory.IntegrableOn.of_bound
    ((Measure.count_apply_lt_top).mpr hsf) hmeas _ hbdd

/-! ## The sum identity on a finite union of atoms -/

/-- Summing `g` over an atom `[b, b+2^k)` is summing over the canonical block. -/
lemma sum_Ico_eq_sum_range' (b : ℤ) (g : ℤ → ℝ) :
    ∑ x ∈ Finset.Ico b (b + (2:ℤ)^k), g x = ∑ d ∈ Finset.range (2^k), g (b + d) := by
  have hpow : (2:ℤ)^k = ((2^k : ℕ) : ℤ) := (Nat.cast_pow 2 k).symm
  refine Finset.sum_nbij' (fun x : ℤ => (x - b).toNat) (fun d : ℕ => b + (d:ℤ)) ?_ ?_ ?_ ?_ ?_
  · intro x hx
    obtain ⟨h0, h1⟩ := Finset.mem_Ico.mp hx
    rw [Finset.mem_range, Int.toNat_lt (by omega : (0:ℤ) ≤ x - b)]
    linarith [h1, hpow]
  · intro d hd
    rw [Finset.mem_range] at hd
    rw [Finset.mem_Ico]
    refine ⟨by omega, ?_⟩
    have : (d : ℤ) < (2:ℤ)^k := by exact_mod_cast hd
    linarith
  · intro x hx
    obtain ⟨h0, -⟩ := Finset.mem_Ico.mp hx
    show b + ((x - b).toNat : ℤ) = x
    rw [Int.toNat_of_nonneg (by omega : (0:ℤ) ≤ x - b)]
    ring
  · intro d _
    show (b + (d:ℤ) - b).toNat = d
    rw [add_sub_cancel_left]
    exact Int.toNat_natCast d
  · intro x hx
    obtain ⟨h0, -⟩ := Finset.mem_Ico.mp hx
    show g x = g (b + ((x - b).toNat : ℤ))
    rw [Int.toNat_of_nonneg (by omega : (0:ℤ) ≤ x - b)]
    ring_nf

/-- The fibre of the atom map over a base point, inside a union of atoms, is the whole atom. -/
lemma filter_latticeBase_eq_Ico {sf : Finset ℤ} {S : Set ℤ} (hS : (sf : Set ℤ) = S)
    (hs : MeasurableSet[latticeSpan k τ] S) {b : ℤ} (hb : b ∈ sf.image (latticeBase k τ)) :
    sf.filter (fun x => latticeBase k τ x = b) = Finset.Ico b (b + (2:ℤ)^k) := by
  classical
  obtain ⟨x₀, hx₀, rfl⟩ := Finset.mem_image.mp hb
  have hcoset : ∃ m : ℤ, latticeBase k τ x₀ = -τ + (2:ℤ)^k * m := latticeBase_mem_coset k τ x₀
  have hpre : ∀ y : ℤ, y ∈ S ↔ latticeBase k τ y ∈ (latticeBase k τ) '' S := by
    intro y
    conv_lhs => rw [latticeSpan_eq_preimage_image k τ hs]
    rw [Set.mem_preimage]
  ext x
  rw [Finset.mem_filter, Finset.mem_Ico]
  constructor
  · rintro ⟨-, h2⟩
    exact (latticeBase_eq_iff k τ hcoset x).mp h2
  · intro hx
    refine ⟨?_, (latticeBase_eq_iff k τ hcoset x).mpr hx⟩
    refine hS.symm.le ?_
    rw [hpre x]
    have hxb : latticeBase k τ x = latticeBase k τ x₀ :=
      (latticeBase_eq_iff k τ hcoset x).mpr hx
    rw [hxb]
    exact (hpre x₀).mp (hS.le hx₀)

/-- On a measurable set of finite counting measure, the atom average integrates like `g`. -/
lemma setIntegral_latticeExpR_eq (g : ℤ → ℝ) (hg : Integrable g (Measure.count : Measure ℤ))
    {S : Set ℤ} (hs : MeasurableSet[latticeSpan k τ] S) (hsf : S.Finite) :
    ∫ x in S, latticeExpR k τ g x ∂(Measure.count : Measure ℤ)
      = ∫ x in S, g x ∂(Measure.count : Measure ℤ) := by
  classical
  set sf := hsf.toFinset with hsfdef
  have hS : (sf : Set ℤ) = S := hsf.coe_toFinset
  have hInt_h : IntegrableOn (latticeExpR k τ g) (sf : Set ℤ) (Measure.count : Measure ℤ) := by
    rw [hS]; exact integrableOn_latticeExpR_of_finite k τ g hsf
  have hInt_g : IntegrableOn g (sf : Set ℤ) (Measure.count : Measure ℤ) := by
    rw [hS]; exact hg.integrableOn
  have e1 : ∫ x in S, latticeExpR k τ g x ∂(Measure.count : Measure ℤ)
      = ∑ x ∈ sf, latticeExpR k τ g x := by
    rw [← hS, MeasureTheory.setIntegral_finset sf hInt_h]
    simp [MeasureTheory.Measure.count_singleton]
  have e2 : ∫ x in S, g x ∂(Measure.count : Measure ℤ) = ∑ x ∈ sf, g x := by
    rw [← hS, MeasureTheory.setIntegral_finset sf hInt_g]
    simp [MeasureTheory.Measure.count_singleton]
  rw [e1, e2]
  have hmap : ∀ i ∈ sf, latticeBase k τ i ∈ sf.image (latticeBase k τ) :=
    fun i hi => Finset.mem_image_of_mem _ hi
  have hfib1 := Finset.sum_fiberwise_of_maps_to (s := sf) (t := sf.image (latticeBase k τ))
    (g := latticeBase k τ) hmap (fun x => latticeExpR k τ g x)
  have hfib2 := Finset.sum_fiberwise_of_maps_to (s := sf) (t := sf.image (latticeBase k τ))
    (g := latticeBase k τ) hmap (fun x => g x)
  rw [← hfib1, ← hfib2]
  refine Finset.sum_congr rfl fun b hb => ?_
  obtain ⟨x₀, -, hx₀⟩ := Finset.mem_image.mp hb
  have hcoset : ∃ m : ℤ, b = -τ + (2:ℤ)^k * m := by
    obtain ⟨m, hm⟩ := latticeBase_mem_coset k τ x₀
    exact ⟨m, by rw [← hx₀]; exact hm⟩
  rw [filter_latticeBase_eq_Ico k τ hS hs hb]
  rw [show ∑ x ∈ Finset.Ico b (b + (2:ℤ)^k), latticeExpR k τ g x
      = ∑ _x ∈ Finset.Ico b (b + (2:ℤ)^k), latticePsi k g b from
      Finset.sum_congr rfl fun x hx => by
        show ((2:ℝ)^k)⁻¹ * ∑ d ∈ Finset.range (2^k), g (latticeBase k τ x + d) = latticePsi k g b
        rw [latticePsi, (latticeBase_eq_iff k τ hcoset x).mpr (Finset.mem_Ico.mp hx)]]
  have hcard : ((2:ℤ)^k).toNat = 2^k := by
    rw [show (2:ℤ)^k = ((2:ℕ)^k : ℤ) by push_cast; ring]
    exact Int.toNat_natCast _
  have hk : ((2:ℝ)^k) ≠ 0 := pow_ne_zero _ (by norm_num)
  rw [Finset.sum_const, Int.card_Ico, add_sub_cancel_left, hcard, sum_Ico_eq_sum_range']
  rw [nsmul_eq_mul, latticePsi, Nat.cast_pow]
  exact mul_inv_cancel_left₀ hk _

/-- **The atom average is a version of the conditional expectation.** -/
theorem lattice_exp_cond_exp (g : ℤ → ℝ)
    (hg : Integrable g (Measure.count : Measure ℤ)) :
    (latticeExpR k τ g) =ᵐ[Measure.count]
      MeasureTheory.condExp (latticeSpan k τ) (Measure.count : Measure ℤ) g := by
  have hm : latticeSpan k τ ≤ (⊤ : MeasurableSpace ℤ) := le_top
  refine MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hm hg ?_ ?_ ?_
  · intro s _ hs_lt
    exact integrableOn_latticeExpR_of_finite k τ g ((Measure.count_apply_lt_top).mp hs_lt)
  · intro s hs_m hs_lt
    exact setIntegral_latticeExpR_eq k τ g hg hs_m ((Measure.count_apply_lt_top).mp hs_lt)
  · exact aestronglyMeasurable_latticeExpR k τ g

end
