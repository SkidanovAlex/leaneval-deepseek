import Mathlib
import Submission.Work.Analysis.Hilbert.shift_lattice_kernel_identity

/-!
# The shifted-dyadic lattice conditional expectations and the pieces of the truncation walk

This file sets up the vocabulary of the **martingale (conditional-expectation) representation of the
Fejér low-pass operators** used in the "engine" route to
`Work.Analysis.Hilbert.hilbert_var_dyad_sq`.

* `latticeBase k τ n` — the left endpoint of the atom of the `τ`-shifted dyadic lattice of scale
  `2^k` containing `n`, i.e. of `[base, base + 2^k) ∋ n`.  For fixed `τ` these lattices are
  *nested* in `k` (coarsening), so `(latticeSpan k τ)_k` is a *decreasing* family of σ-algebras and
  `k ↦ latticeExp k τ g` is a reverse martingale; reversing the index `k ↦ K - k` turns it into an
  honest `condExp`-martingale, to which the tree's Lépingle inequality applies.
* `latticeExp k τ g n` — the average of `g` over that atom: the conditional expectation of `g`
  w.r.t. `latticeSpan k τ`.
* `latticeSpan k τ` — the σ-algebra generated by the atoms.
* `triConv k g` — the convolution with the triangular (Fejér) kernel `triKernel k`.

The two facts tying them together (proved in the sibling files) are

* `latticeExp_average` : `∑_{τ ∈ [0,2^K)} latticeExp k τ g n = 2^K · triConv k g n` for `k ≤ K`
  (the `τ`-average of the shifted lattices is the triangular smoothing), and
* `latticeExp_condExp` : `latticeExp k τ g =ᵐ[count] condExp (latticeSpan k τ) count g`.
-/

open Finset
open scoped BigOperators

namespace Work.Analysis.Hilbert

noncomputable section

/-! ## The atom map -/

/-- The left endpoint of the atom of the `τ`-shifted dyadic lattice of scale `2^k` containing `n`:
the unique `b ∈ -τ + 2^kℤ` with `b ≤ n < b + 2^k`. -/
def latticeBase (k : ℕ) (τ : ℤ) (n : ℤ) : ℤ :=
  -τ + (2:ℤ)^k * ((n + τ) / (2:ℤ)^k)

/-- The conditional expectation of `g` w.r.t. the `τ`-shifted dyadic lattice of scale `2^k`:
the average of `g` over the atom of `n`. -/
def latticeExp (k : ℕ) (τ : ℤ) (g : ℤ → ℂ) (n : ℤ) : ℂ :=
  ((2:ℂ)^k)⁻¹ * ∑ d ∈ Finset.range (2^k), g (latticeBase k τ n + d)

/-- The σ-algebra of the `τ`-shifted dyadic lattice of scale `2^k`. -/
def latticeSpan (k : ℕ) (τ : ℤ) : MeasurableSpace ℤ :=
  MeasurableSpace.comap (latticeBase k τ) ⊤

/-- The convolution with the triangular (Fejér) kernel at scale `2^k`. -/
def triConv (k : ℕ) (g : ℤ → ℂ) (n : ℤ) : ℂ :=
  ∑ d ∈ Finset.Icc (-((2:ℤ)^k)) ((2:ℤ)^k), (triKernel k d : ℂ) * g (n - d)

/-! ## Elementary properties of the atom map -/

lemma latticeBase_le (k : ℕ) (τ n : ℤ) : latticeBase k τ n ≤ n := by
  have hb : (2:ℤ)^k ≠ 0 := by positivity
  have h1 : ((n + τ) / (2:ℤ)^k) * (2:ℤ)^k ≤ n + τ := Int.ediv_mul_le _ hb
  unfold latticeBase
  nlinarith [h1]

lemma lt_latticeBase_add (k : ℕ) (τ n : ℤ) : n < latticeBase k τ n + (2:ℤ)^k := by
  have hb : (0:ℤ) < (2:ℤ)^k := by positivity
  have h1 : (n + τ) % (2:ℤ)^k < (2:ℤ)^k := Int.emod_lt_of_pos _ hb
  have h2 : (n + τ) / (2:ℤ)^k * (2:ℤ)^k + (n + τ) % (2:ℤ)^k = n + τ :=
    Int.ediv_mul_add_emod _ _
  unfold latticeBase
  nlinarith [h1, h2]

/-- The offset of `n` inside its atom is the nonnegative remainder of `n + τ` modulo `2^k`. -/
lemma sub_latticeBase (k : ℕ) (τ n : ℤ) :
    n - latticeBase k τ n = (n + τ) % (2:ℤ)^k := by
  have h2 : (n + τ) / (2:ℤ)^k * (2:ℤ)^k + (n + τ) % (2:ℤ)^k = n + τ :=
    Int.ediv_mul_add_emod _ _
  unfold latticeBase
  nlinarith [h2]

lemma sub_latticeBase_nonneg (k : ℕ) (τ n : ℤ) : 0 ≤ n - latticeBase k τ n := by
  rw [sub_latticeBase]; exact Int.emod_nonneg _ (by positivity)

lemma sub_latticeBase_lt (k : ℕ) (τ n : ℤ) :
    n - latticeBase k τ n < (2:ℤ)^k := by
  rw [sub_latticeBase]; exact Int.emod_lt_of_pos _ (by positivity)

/-- The atom map is periodic in the shift, with period `2^k`. -/
lemma latticeBase_shift_period (k : ℕ) (τ : ℤ) (m : ℤ) (n : ℤ) :
    latticeBase k (τ + (2:ℤ)^k * m) n = latticeBase k τ n := by
  have hb : (2:ℤ)^k ≠ 0 := by positivity
  have hdiv : (n + (τ + (2:ℤ)^k * m)) / (2:ℤ)^k
      = (n + τ) / (2:ℤ)^k + m := by
    rw [show n + (τ + (2:ℤ)^k * m) = (n + τ) + (2:ℤ)^k * m by ring]
    exact Int.add_mul_ediv_left (n + τ) m hb
  unfold latticeBase
  rw [hdiv]
  ring

/-- The atom map only depends on the shift modulo `2^k`. -/
lemma latticeBase_shift_emod (k : ℕ) (τ : ℤ) (n : ℤ) :
    latticeBase k (τ % (2:ℤ)^k) n = latticeBase k τ n := by
  have h1 : τ = τ % (2:ℤ)^k + (2:ℤ)^k * (τ / (2:ℤ)^k) := by
    have := Int.ediv_mul_add_emod τ ((2:ℤ)^k)
    linarith [this]
  conv_rhs => rw [h1]
  exact (latticeBase_shift_period k (τ % (2:ℤ)^k) (τ / (2:ℤ)^k) n).symm

/-- At scale `1` the atoms are the singletons: the atom map is the identity. -/
lemma latticeBase_zero (τ n : ℤ) : latticeBase 0 τ n = n := by
  unfold latticeBase
  norm_num

/-- At scale `1` the conditional expectation is the identity. -/
lemma latticeExp_zero (τ : ℤ) (g : ℤ → ℂ) (n : ℤ) : latticeExp 0 τ g n = g n := by
  simp [latticeExp, latticeBase_zero]



/-- The coarse atom map factors through the fine one. -/
lemma latticeBase_succ_factor (k : ℕ) (τ n : ℤ) :
    latticeBase (k+1) τ n
      = -τ + (2:ℤ)^(k+1) * ((latticeBase k τ n + τ) / (2:ℤ)^(k+1)) := by
  have hfk : latticeBase k τ n + τ = (2:ℤ)^k * ((n + τ) / (2:ℤ)^k) := by
    unfold latticeBase; ring
  have h2 : (2:ℤ)^(k+1) = (2:ℤ)^k * 2 := by ring
  have hcomp : ((n + τ) / (2:ℤ)^k) / 2 = (n + τ) / (2:ℤ)^(k+1) := by
    rw [Int.ediv_ediv_of_nonneg (x := n + τ) (y := (2:ℤ)^k) (z := 2) (by positivity), ← h2]
  have hdiv : ((2:ℤ)^k * ((n + τ) / (2:ℤ)^k)) / (2:ℤ)^(k+1)
      = ((n + τ) / (2:ℤ)^k) / 2 := by
    rw [h2]
    exact Int.mul_ediv_mul_of_pos _ _ (by positivity : (0:ℤ) < (2:ℤ)^k)
  rw [hfk, hdiv, hcomp]
  unfold latticeBase
  ring

/-- The σ-algebras of the shifted dyadic lattices are antitone in the scale: the coarse lattice
σ-algebra is contained in the fine one. -/
theorem latticeSpan_succ_le (k : ℕ) (τ : ℤ) : latticeSpan (k+1) τ ≤ latticeSpan k τ := by
  have hfac : latticeBase (k+1) τ
      = (fun x : ℤ => -τ + (2:ℤ)^(k+1) * ((x + τ) / (2:ℤ)^(k+1))) ∘ (latticeBase k τ) := by
    funext n; exact latticeBase_succ_factor k τ n
  rw [latticeSpan, hfac, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono le_top

/-- The σ-algebras of the shifted dyadic lattices are antitone in the scale. -/
theorem latticeSpan_anti {k l : ℕ} (h : k ≤ l) (τ : ℤ) :
    latticeSpan l τ ≤ latticeSpan k τ :=
  Nat.le_induction le_rfl (fun n _ ih => le_trans (latticeSpan_succ_le n τ) ih) l h

/-! ## The real-valued conditional expectation -/

/-- The conditional expectation of a real-valued `g` w.r.t. the `τ`-shifted dyadic lattice of
scale `2^k`: the average of `g` over the atom of `n`. -/
def latticeExpR (k : ℕ) (τ : ℤ) (g : ℤ → ℝ) (n : ℤ) : ℝ :=
  ((2:ℝ)^k)⁻¹ * ∑ d ∈ Finset.range (2^k), g (latticeBase k τ n + d)

lemma latticeExp_re (k : ℕ) (τ : ℤ) (g : ℤ → ℂ) (n : ℤ) :
    (latticeExp k τ g n).re = latticeExpR k τ (fun m => (g m).re) n := by
  unfold latticeExp latticeExpR
  have hcoe : ((2:ℂ)^k)⁻¹ = Complex.ofReal (((2:ℝ)^k)⁻¹) := (cast_inv_pow k).symm
  rw [hcoe, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
  congr 1
  exact map_sum Complex.reCLM _ _

lemma latticeExp_im (k : ℕ) (τ : ℤ) (g : ℤ → ℂ) (n : ℤ) :
    (latticeExp k τ g n).im = latticeExpR k τ (fun m => (g m).im) n := by
  unfold latticeExp latticeExpR
  have hcoe : ((2:ℂ)^k)⁻¹ = Complex.ofReal (((2:ℝ)^k)⁻¹) := (cast_inv_pow k).symm
  rw [hcoe, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
  congr 1
  exact map_sum Complex.imCLM _ _

/-! ## Periodicity of the lattice conditional expectation in the shift -/

lemma latticeExp_shift_period (k : ℕ) (τ : ℤ) (m : ℤ) (g : ℤ → ℂ) (n : ℤ) :
    latticeExp k (τ + (2:ℤ)^k * m) g n = latticeExp k τ g n := by
  unfold latticeExp
  rw [latticeBase_shift_period]

end

end Work.Analysis.Hilbert
