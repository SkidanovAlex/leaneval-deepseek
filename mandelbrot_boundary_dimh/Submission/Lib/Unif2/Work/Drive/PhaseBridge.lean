import Mathlib
import Submission.Lib.Unif2.Work.Drive.PhaseBridgeDefs

open LeanEval.Geometry
open scoped Manifold ContDiff Topology
open Filter Set Classical
noncomputable section
namespace Work.Drive

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

/-- **Continuity of the bridge** from the fibre product of the conjugate étale space of `E` and the
logarithmic étale space of `Θ` into the phase cover.

`phaseFiberProdTopology z₀ E Θ` is the subspace topology of the product of the conjugate étale
topology `Work.Modulus.greenConjTopology z₀ E` on `Punct z₀ × ℝ` with the topology of the
logarithmic étale space `LogSp Θ`, and `phaseBridge z₀ Θ` sends `((u,t),(u,w))` to
`(u.1, t + w.im)`.

Proof sketch.  The phase topology is generated by the graphs `phaseGraph V lam` of the phase
branches, so by `continuous_generateFrom_iff` it suffices to show that the preimage of each
`phaseGraph V lam` is open; use `isOpen_iff_mem_nhds`.  At a point `p₀` of the preimage, let
`y := (p₀.1.1.1 : Punct z₀).1 : X`; the membership says `y ∈ V` and
`p₀.1.1.2 + (p₀.1.2.1.2).im = lam y`, and `y ≠ z₀`.  The local representation of the phase branch
`lam` at `y` (the `∀ y ∈ V, y ≠ z₀ → ∃ W F w, ...` field of `IsPhaseBranch`) supplies an open
`W ∋ y`, a holomorphic `F` on `W` with `Re F = E` and a continuous `w` on `W` with
`exp (w z) = Θ z`, such that `lam z = (F z).im + (w z).im` on `W`.  Replace `F` by
`F + ((p₀.1.1.2 - (F y).im : ℂ) * I)` and `w` by `w - n·(2π I)` where
`w y = p₀.1.2.1.2 + n·2πI` (`Complex.exp_eq_exp_iff_exists_int`), so that the new pair has
`(F' y).im = p₀.1.1.2` and `Im (w' y) = (p₀.1.2.1.2).im`; then `lam' := (F' ·).im + (w' ·).im` is a
phase branch on `W` with `lam' y = lam y`, so `lam' = lam` eventually near `y`
(`Work.Drive.phaseBranch_sub_eventuallyEq`), and we may shrink to an open `W₂ ∋ y` with
`lam' = lam` on `W₂` and `W₂ ⊆ W`.  The required neighbourhood of `p₀` is then cut out by
`p.1 ∈ conjGraph {u | u.1 ∈ W₂} (fun u => F' u.1)` — open in `greenConjTopology z₀ E` by
`Submission.isOpen_conjGraph` and `Work.Drive.holomorphicOnX_punctured_of_holomorphicOnX` — and by
`p.2 ∈ {l | l.1.1.1 ∈ W₂ ∧ l.1.2 = w' l.1.1.1}` — open by `Work.Drive.isOpen_logSheet`.  Note that
`F'` must be added as a constant multiple of `I` (`Submission.holomorphicOnX_add_const'`), and the
`F`/`w` produced by the phase branch are only available at `y ≠ z₀`. -/
theorem PhaseBridge {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X]
    [SecondCountableTopology X] [ChartedSpace ℂ X]
    [IsManifold (modelWithCornersSelf ℂ ℂ) 1 X]
    {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} :
    @Continuous ↥(Work.Drive.phaseFiberProd z₀ Θ) (X × ℝ)
      (Work.Drive.phaseFiberProdTopology z₀ E Θ) (Work.Drive.phaseTopology z₀ E Θ)
      (Work.Drive.phaseBridge z₀ Θ) := by
  rw [phaseTopology, continuous_generateFrom_iff]
  intro S hS
  obtain ⟨V, lam, hbr, rfl⟩ := hS
  rw [@isOpen_iff_mem_nhds _ (phaseFiberProdTopology z₀ E Θ)]
  intro p₀ hp₀
  simp only [Set.mem_preimage, phaseGraph, Set.mem_ofPred_eq] at hp₀
  letI : TopologicalSpace (Punct z₀ × ℝ) := Work.Modulus.greenConjTopology z₀ E
  have hy0 : (p₀.1.1.1.1 : X) ≠ z₀ := p₀.1.1.1.2
  have hV : (p₀.1.1.1.1 : X) ∈ V := hp₀.1
  have hval : p₀.1.1.2 + (p₀.1.2.1.2).im = lam p₀.1.1.1.1 := hp₀.2
  obtain ⟨W, F, w, hWo, hyW, hWV, hFhol, hFre, hwcont, hwexp, hlam⟩ :=
    hbr.2.2 (p₀.1.1.1.1) hV hy0
  have hweq : Complex.exp (w (p₀.1.1.1.1)) = Complex.exp (p₀.1.2.1.2) := by
    rw [hwexp _ hyW, p₀.1.2.2, p₀.2]
  obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.mp hweq
  set cF : ℂ := ((p₀.1.1.2 - (F (p₀.1.1.1.1)).im : ℝ) : ℂ) * Complex.I with hcF
  set cw : ℂ := (n : ℂ) * (2 * Real.pi * Complex.I) with hcw
  set F' : X → ℂ := fun z => F z + cF with hF'def
  set w' : X → ℂ := fun z => w z - cw with hw'def
  set lam' : X → ℝ := fun z => (F' z).im + (w' z).im with hlam'def
  have hcFre : cF.re = 0 := by rw [hcF]; simp [Complex.mul_re]
  have hcFim : cF.im = p₀.1.1.2 - (F (p₀.1.1.1.1)).im := by rw [hcF]; simp [Complex.mul_im]
  have hF'y : (F' (p₀.1.1.1.1)).im = p₀.1.1.2 := by
    rw [hF'def]; simp only [Complex.add_im]; rw [hcFim]; ring
  have hw'y : w' (p₀.1.1.1.1) = p₀.1.2.1.2 := by
    rw [hw'def]; simp only; rw [hn]; ring
  have hF'hol : Submission.HolomorphicOnX F' W := by
    rw [hF'def]
    exact hFhol.add (Submission.holomorphicOnX_const cF)
  have hF're : ∀ z ∈ W, (F' z).re = E z := by
    intro z hz
    rw [hF'def]
    simp only [Complex.add_re, hcFre, add_zero]
    exact hFre z hz
  have hw'cont : ContinuousOn w' W := by
    rw [hw'def]
    exact hwcont.sub continuousOn_const
  have hw'exp : ∀ z ∈ W, Complex.exp (w' z) = Θ z := by
    intro z hz
    rw [hw'def, Complex.exp_sub, hwexp z hz, hcw, Complex.exp_int_mul_two_pi_mul_I, div_one]
  have hbr' : IsPhaseBranch z₀ E Θ W lam' := by
    refine ⟨hWo, ?_, ?_⟩
    · rw [hlam'def]
      exact (Complex.continuous_im.comp_continuousOn
          (fun z hz => ((hF'hol z hz).continuousAt).continuousWithinAt)).add
        (Complex.continuous_im.comp_continuousOn hw'cont)
    · intro y' hy' hy'0
      exact ⟨W, F', w', hWo, hy', Subset.rfl, hF'hol, hF're, hw'cont, hw'exp,
        fun z hz => rfl⟩
  have hev : ∀ᶠ z in 𝓝 (p₀.1.1.1.1 : X), lam' z = lam z := by
    have h := phaseBranch_sub_eventuallyEq hbr' hbr hyW hV hy0
    have h0 : lam' (p₀.1.1.1.1) = lam (p₀.1.1.1.1) := by
      have h1 : lam' (p₀.1.1.1.1) = (F' (p₀.1.1.1.1)).im + (w' (p₀.1.1.1.1)).im := rfl
      rw [h1, hF'y, hw'y]
      exact hval
    filter_upwards [h] with z hz
    rw [h0, sub_self] at hz
    exact sub_eq_zero.mp hz
  obtain ⟨W₂, hW₂sub, hW₂o, hyW₂⟩ := mem_nhds_iff.mp hev
  set S₂ : Set X := W₂ ∩ W with hS₂
  have hS₂o : IsOpen S₂ := hW₂o.inter hWo
  have hyS₂ : (p₀.1.1.1.1 : X) ∈ S₂ := ⟨hyW₂, hyW⟩
  have hS₂eq : ∀ z ∈ S₂, lam' z = lam z := fun z hz => hW₂sub hz.1
  have hS₂W : S₂ ⊆ W := Set.inter_subset_right
  set A : Set (Punct z₀ × ℝ) :=
    Submission.conjGraph {u : Punct z₀ | u.1 ∈ S₂} (fun u => F' u.1) with hAdef
  set B : Set (LogSp (z₀ := z₀) Θ) := {l | l.1.1.1 ∈ S₂ ∧ l.1.2 = w' l.1.1.1} with hBdef
  have hA : IsOpen A := by
    rw [hAdef]
    refine Submission.isOpen_conjGraph ?_ ?_ ?_
    · exact hS₂o.preimage continuous_subtype_val
    · exact holomorphicOnX_punctured_of_holomorphicOnX (F := F') (W := S₂) (hF'hol.mono hS₂W)
    · intro u hu
      exact hF're u.1 (hS₂W hu)
  have hB : IsOpen B := by
    rw [hBdef]
    exact isOpen_logSheet hS₂o (hw'cont.mono hS₂W) (fun x hx => hw'exp x (hS₂W hx))
  have hNopen : @IsOpen _ (phaseFiberProdTopology z₀ E Θ) (Subtype.val ⁻¹' (A ×ˢ B)) := by
    rw [phaseFiberProdTopology]
    exact isOpen_induced_iff.mpr ⟨A ×ˢ B, hA.prod hB, rfl⟩
  have hp₀N : p₀ ∈ Subtype.val ⁻¹' (A ×ˢ B) := by
    refine ⟨?_, ?_⟩
    · rw [hAdef]
      exact ⟨hyS₂, hF'y.symm⟩
    · rw [hBdef]
      refine ⟨?_, ?_⟩
      · show p₀.1.2.1.1.1 ∈ S₂
        rw [← p₀.2]
        exact hyS₂
      · show p₀.1.2.1.2 = w' p₀.1.2.1.1.1
        rw [← hw'y, p₀.2]
  have hmem : Subtype.val ⁻¹' (A ×ˢ B) ∈ 𝓝 p₀ :=
    @IsOpen.mem_nhds _ (phaseFiberProdTopology z₀ E Θ) _ _ hNopen hp₀N
  have hsub : Subtype.val ⁻¹' (A ×ˢ B) ⊆ phaseBridge z₀ Θ ⁻¹' phaseGraph V lam := by
    intro q hq
    rw [hAdef] at hq
    rw [hBdef] at hq
    obtain ⟨hqy, hqt⟩ := hq.1
    obtain ⟨hqy', hqw⟩ := hq.2
    have hq2 : q.1.2.1.1 = q.1.1.1 := q.2.symm
    refine ⟨hWV (hS₂W hqy), ?_⟩
    show q.1.1.2 + (q.1.2.1.2).im = lam q.1.1.1.1
    rw [hqt, hqw, hq2]
    exact hS₂eq _ hqy
  exact Filter.mem_of_superset hmem hsub

end Work.Drive
end
