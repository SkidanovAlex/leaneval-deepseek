import Submission.Lib.Unif2.UnifDeps
import Submission.Lib.Unif2.GreenInterface
import Submission.Lib.Unif2.Holomorphic

/-!
# The multivalued modulus of a Green function: branches and their monodromy

This module sets up the vocabulary for the step of the hyperbolic case of uniformization in which
the **simple connectivity of `X`** is used: the multivalued function `exp (-(E + iE*))` associated
with a Green function `E` of `X` has a single-valued branch, because the monodromy of the
"modulus bundle" over the simply connected surface `X` is trivial.

Given `E : X → ℝ` with a Green-function pole at `z₀` (`Submission.HasGreenFunctionE`), the
classical construction is

* `Φ = exp (-(E + iE*))`, where `E*` is a local harmonic conjugate of `-E`;

it is well defined *locally* at every point of `X` (including `z₀`, where the pole of `E` and the
simple zero of `Φ` are resolved by the coordinate), but only *multivalued* globally: two local
branches differ by a constant of modulus one, and the ambiguity is the monodromy of the bundle of
branches, a flat `U(1)`-bundle over `X`.

The definitions below materialise that bundle as a covering space of `X`:

* `Work.SC.IsModulusBranch z₀ E U Φ` — `Φ` is a holomorphic branch of the modulus on `U`:
  holomorphic, non-zero and of modulus `exp (-E)` off `z₀`;
* `Work.SC.chartDeriv Φ x` — the derivative of `Φ` in the preferred chart at `x`.  This extra
  datum is what distinguishes the branches *at the pole* (all of them vanish at `z₀`, but their
  derivatives differ by a unit);
* `Work.SC.branchSet z₀ E ⊆ X × ℂ × ℂ` — the set of triples `(x, Φ x, chartDeriv Φ x)` coming from
  a branch, with the topology `Work.SC.branchTopology z₀ E` generated by the graphs of the
  branches.  The projection `Work.SC.branchProj` to `X` is a covering map
  (`Work.SC.isCoveringMap_branchProj`), and since `X` is simply connected its monodromy is trivial,
  which is what produces a *global* branch and hence the holomorphic modulus.
-/

open LeanEval.Geometry
open scoped Manifold ContDiff Topology

set_option linter.unusedSectionVars false

noncomputable section

open Filter Set
open Classical

namespace Work.SC

variable {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X]
  [SecondCountableTopology X] [ChartedSpace ℂ X]
  [IsManifold (modelWithCornersSelf ℂ ℂ) 1 X]

/-- **A local holomorphic branch of the modulus `exp (-E)` of a Green function.**  `Φ` is
holomorphic on the open set `U`, has modulus `exp (-E)` off the pole `z₀`, and does not vanish
there (so that it is a unit times `exp (-(F + iF*))` for a local conjugate `F`).  At `z₀` itself no
condition is imposed here; the branches produced by the Green function have a simple zero there
(`Submission.HasLogPoleAt`). -/
def IsModulusBranch (z₀ : X) (E : X → ℝ) (U : Set X) (Φ : X → ℂ) : Prop :=
  IsOpen U ∧ Submission.HolomorphicOnX Φ U ∧
    (∀ x ∈ U, x ≠ z₀ → Φ x ≠ 0) ∧
    (∀ x ∈ U, x ≠ z₀ → ‖Φ x‖ = Real.exp (-(E x)))

/-- A branch is holomorphic. -/
theorem IsModulusBranch.holomorphic {z₀ : X} {E : X → ℝ} {U : Set X} {Φ : X → ℂ}
    (h : IsModulusBranch z₀ E U Φ) : Submission.HolomorphicOnX Φ U := h.2.1

/-- A branch does not vanish off the pole. -/
theorem IsModulusBranch.ne_zero {z₀ : X} {E : X → ℝ} {U : Set X} {Φ : X → ℂ}
    (h : IsModulusBranch z₀ E U Φ) : ∀ x ∈ U, x ≠ z₀ → Φ x ≠ 0 := h.2.2.1

/-- The modulus of a branch is `exp (-E)`. -/
theorem IsModulusBranch.norm_eq {z₀ : X} {E : X → ℝ} {U : Set X} {Φ : X → ℂ}
    (h : IsModulusBranch z₀ E U Φ) : ∀ x ∈ U, x ≠ z₀ → ‖Φ x‖ = Real.exp (-(E x)) := h.2.2.2

/-- A branch restricts to any smaller open set. -/
theorem IsModulusBranch.mono {z₀ : X} {E : X → ℝ} {U V : Set X} {Φ : X → ℂ}
    (h : IsModulusBranch z₀ E U Φ) (hV : IsOpen V) (hVU : V ⊆ U) :
    IsModulusBranch z₀ E V Φ :=
  ⟨hV, h.holomorphic.mono hVU, fun x hx hz => h.ne_zero x (hVU hx) hz,
    fun x hx hz => h.norm_eq x (hVU hx) hz⟩

/-- **The derivative of `Φ` in the preferred chart at `x`.**  It is used (only) to separate the
branches of the modulus over the pole `z₀`, where all branches vanish; everywhere else the value
already determines the branch. -/
def chartDeriv (Φ : X → ℂ) (x : X) : ℂ :=
  deriv (Φ ∘ (chartAt ℂ x).symm) ((chartAt ℂ x) x)

/-- The graph of a branch, as a subset of `X × ℂ × ℂ`: the points `(x, Φ x, Φ'(x))`. -/
def branchGraph (U : Set X) (Φ : X → ℂ) : Set (X × ℂ × ℂ) :=
  {p | p.1 ∈ U ∧ p.2.1 = Φ p.1 ∧ p.2.2 = chartDeriv Φ p.1}

/-- The family of graphs of the local branches: the generating family for the topology of the
modulus bundle. -/
def branchFamily (z₀ : X) (E : X → ℝ) : Set (Set (X × ℂ × ℂ)) :=
  {S | ∃ (U : Set X) (Φ : X → ℂ), IsModulusBranch z₀ E U Φ ∧ S = branchGraph U Φ}

/-- The topology of the modulus bundle: generated by the graphs of the local branches. -/
def branchTopology (z₀ : X) (E : X → ℝ) : TopologicalSpace (X × ℂ × ℂ) :=
  TopologicalSpace.generateFrom (branchFamily z₀ E)

/-- The total space of the modulus bundle: the triples `(x, Φ x, Φ'(x))` realised by a local
branch of the modulus at `x`. -/
def branchSet (z₀ : X) (E : X → ℝ) : Set (X × ℂ × ℂ) :=
  {p | ∃ (U : Set X) (Φ : X → ℂ), IsModulusBranch z₀ E U Φ ∧ p ∈ branchGraph U Φ}

/-- The modulus bundle: the total space `Work.SC.branchSet`, with the topology induced by
`Work.SC.branchTopology`. -/
abbrev ModulusBundle (z₀ : X) (E : X → ℝ) : Type _ := ↥(branchSet z₀ E)

/-- The topology of the modulus bundle: the subspace topology induced by
`Work.SC.branchTopology`. -/
def modulusBundleTopology (z₀ : X) (E : X → ℝ) : TopologicalSpace (ModulusBundle z₀ E) :=
  (branchTopology z₀ E).induced Subtype.val

/-- The projection of the modulus bundle to `X`. -/
def branchProj (z₀ : X) (E : X → ℝ) : ModulusBundle z₀ E → X := fun p => p.1.1

/-- A point of the bundle comes from a branch; this is the local branch through it. -/
theorem branchSet.exists_branch {z₀ : X} {E : X → ℝ} {p : X × ℂ × ℂ}
    (hp : p ∈ branchSet z₀ E) :
    ∃ (U : Set X) (Φ : X → ℂ), IsModulusBranch z₀ E U Φ ∧ p ∈ branchGraph U Φ := hp

/-- The branch through a point of the bundle, evaluated at its base point, is the second
coordinate. -/
theorem mem_branchGraph_iff {U : Set X} {Φ : X → ℂ} {p : X × ℂ × ℂ} :
    p ∈ branchGraph U Φ ↔ p.1 ∈ U ∧ p.2.1 = Φ p.1 ∧ p.2.2 = chartDeriv Φ p.1 := Iff.rfl

end Work.SC
