import Mathlib
import Submission.Work.Pert.Basic
import Submission.Work.Pert.Setup
import Submission.Work.Pert.Qm_slice
import Submission.Work.Pert.nearTranslation_F0
import Submission.Work.Interfaces.Parabolic
import Submission.Work.PertCrux.norm_log_preimage_sub_tau0_le

/-!
# `Work.PertCrux.exists_tauC_preimage_gate`

The perturbed chart of Shishikura (A.1.5),

  `τ_C σ α w = σ / (1 - exp (-2πi α w))`  (`Work.Pert.tauC`),

is a universal cover of `ℂ ∖ {0, σ}` whose deck group is generated by `w ↦ w - 1/α`; its fibres are
the cosets `w₀ + (1/α)ℤ`.  This file produces, for a point `p` of the range, the point of the
*unsigned gate* `Qp Ξ' α = Qreg (some Ξ') (some (-Ξ' + 1/α))` of §4.2 lying in the fibre of `p`,
and compares it with the *unperturbed* chart `τ₀ p = -1/p`:

  `∃ ζ ∈ Qp Ξ' α, τ_C σ α ζ = p ∧ ‖ζ - τ₀ p‖ ≤ 64 (‖u₀-1‖ + ‖α‖‖τ₀ p‖) ‖τ₀ p‖`.

The explicit representative is the principal-branch one, `ζ = -log (1 - σ/p) / (2πiα)`, which is a
preimage of `p` because `exp (log z) = z` (`exp_log`) — no branch bookkeeping is needed.  Writing
`σ u₀ = 1 - exp (2πiα)` (Lemma A.1.2) and `q = 1/p`, the deviation is

  `ζ - τ₀ p = q (a + σ)/a - (log (1 - σq/u₀) + σq/u₀)/a`,  `a = 2πiα`,

i.e. a first-order term `q (u₀-1)/u₀ - q a/(2u₀)` of size `≲ (‖u₀-1‖ + ‖α‖‖q‖)‖q‖`, plus the
quadratic log remainder, controlled by `‖σ q/u₀‖ ≤ 1/2` (which is where `64‖α‖‖τ₀p‖ ≤ 1` enters).
That estimate is `Work.PertCrux.norm_log_preimage_sub_tau0_le` (proved in the sibling file).

Two small structural facts are proved here:

* `‖α‖ ≤ 1/64` from the admissibility `QAdm (some Ξ') (some (-Ξ' + 1/α))` with `Ξ' ≥ 1 + 64π`
  (so `a = 2πiα` is small, and `log` is a genuine local inverse of `exp` on the relevant disc);
* `1 ≤ ‖τ₀ p‖` from the *room* hypothesis: the gate `Qp Ξ' α` forces `Re z + |Im z| > Ξ' ≥ 1 + 64π`,
  and the centre of the (positive radius) ball belongs to it, so `2‖τ₀ p‖ > Ξ' > 2`.

The room hypothesis gives the membership in `Qp Ξ' α` of the whole ball around `τ₀ p`; since the
estimate above is *strictly* smaller than the radius (48 < 64 and the product is positive), the
witness lies in the ball, hence in the gate.
-/

namespace Work.PertCrux

namespace Gate

open Complex

set_option linter.unusedVariables false

/-- `‖τ₀ p‖ = ‖1/p‖`. -/
theorem norm_tau0_eq (p : ℂ) : ‖MandelDim.tau0 p‖ = ‖1 / p‖ := by simp [MandelDim.tau0]

/-- The principal preimage of `p` under the perturbed chart `τ_C`:
`τ_C σ α (-log (1 - σ/p)/(2πiα)) = p` (valid for `σ ≠ 0`, `α ≠ 0`, `p ≠ 0`, `p ≠ σ`). -/
theorem tauC_log_preimage {σ α p : ℂ} (hσ : σ ≠ 0) (hα : α ≠ 0) (hp : p ≠ 0) (hσp : σ ≠ p) :
    Work.Pert.tauC σ α (-(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α)) = p := by
  have hz : 1 - σ / p ≠ 0 := by
    intro h
    have h1 : σ / p = 1 := (sub_eq_zero.mp h).symm
    rw [div_eq_one_iff_eq hp] at h1
    exact hσp h1
  have hkey : -(2 * Real.pi * Complex.I * α * (-(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α)))
      = Complex.log (1 - σ / p) := by
    have ha0 : (2 * Real.pi * Complex.I * α) ≠ 0 := by
      simp [Complex.ext_iff, Real.pi_ne_zero, hα]
    field_simp
  rw [Work.Pert.tauC, hkey, Complex.exp_log hz,
    show 1 - (1 - σ / p) = σ / p from by ring]
  field_simp

/-- `Ξ' ≥ 1 + 64π` and `QAdm (some Ξ') (some (-Ξ' + 1/α))` force `‖α‖ ≤ 1/64`
(indeed `Re (1/α) > 2Ξ' + 4 > 128π`). -/
theorem norm_alpha_le_of_QAdm {Ξ' : ℝ} (hΞ' : 1 + 64 * Real.pi ≤ Ξ') {α : ℂ}
    (hadm : MandelDim.QAdm (some (Ξ' : ℂ)) (some (-(Ξ' : ℂ) + 1 / α))) : ‖α‖ ≤ 1 / 64 := by
  have h := hadm (Ξ' : ℂ) (by simp) (-(Ξ' : ℂ) + 1 / α) (by simp)
  rw [Complex.ofReal_re] at h
  simp only [Complex.add_re, Complex.neg_re, Complex.ofReal_re] at h
  have h2 : 2 * Ξ' + 4 < (1 / α).re := by linarith
  have h3 : 2 * Ξ' + 4 < ‖1 / α‖ := lt_of_lt_of_le h2 (Complex.re_le_norm _)
  have hpow : ‖1 / α‖ = ‖α‖⁻¹ := by simp [one_div]
  rw [hpow] at h3
  have h4 : (64 : ℝ) < ‖α‖⁻¹ := by nlinarith [h3, Real.pi_gt_three]
  have hpos : 0 < ‖α‖ := by
    rcases eq_or_ne α 0 with h' | h'
    · subst h'; rw [norm_zero, inv_zero] at h4; linarith
    · exact norm_pos_iff.mpr h'
  have h5 : (64 : ℝ) * ‖α‖ < 1 := by
    have hh := mul_lt_mul_of_pos_right h4 hpos
    rwa [inv_mul_cancel₀ (ne_of_gt hpos)] at hh
  exact le_of_lt ((lt_div_iff₀ (by norm_num : (0:ℝ) < 64)).mpr (by linarith))

/-- The gate forces `‖τ₀ p‖ ≥ 1`: the ball has positive radius, so its centre `τ₀ p` lies in
`Qp Ξ' α`, whose first vertex condition is `Re z + |Im z| > Ξ' ≥ 1 + 64π > 2`, while
`Re z + |Im z| ≤ 2 ‖z‖`. -/
theorem one_le_norm_tau0_of_room {Ξ' : ℝ} (hΞ' : 1 + 64 * Real.pi ≤ Ξ')
    {σ α u0 p : ℂ} (hα : α ≠ 0) (hp : p ≠ 0) (hu1 : ‖u0 - 1‖ ≤ 1 / 2) (hα64 : ‖α‖ ≤ 1 / 64)
    (hroom : Metric.ball (MandelDim.tau0 p)
        (64 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖)
      ⊆ Work.Pert.Qp Ξ' α) :
    1 ≤ ‖MandelDim.tau0 p‖ := by
  have ht0 : 0 < ‖MandelDim.tau0 p‖ := by
    rw [MandelDim.tau0, norm_div, norm_neg, norm_one]
    exact div_pos one_pos (norm_pos_iff.mpr hp)
  have hR : 0 < 64 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖ := by
    have h1 : 0 < ‖α‖ * ‖MandelDim.tau0 p‖ := mul_pos (norm_pos_iff.mpr hα) ht0
    nlinarith [norm_nonneg (u0 - 1), h1]
  have hmem := hroom (Metric.mem_ball.mpr (by rw [dist_self]; exact hR))
  rw [Work.Pert.Qp, MandelDim.Qreg, Set.mem_ofPred_eq] at hmem
  have h1 := hmem.1 (Ξ' : ℂ) (by simp)
  simp only [Complex.sub_re, Complex.sub_im, Complex.ofReal_re, Complex.ofReal_im, sub_zero] at h1
  have h2 : Ξ' < (MandelDim.tau0 p).re + |(MandelDim.tau0 p).im| := by linarith
  have h3 : (MandelDim.tau0 p).re + |(MandelDim.tau0 p).im| ≤ 2 * ‖MandelDim.tau0 p‖ := by
    have h4 := Complex.re_le_norm (MandelDim.tau0 p)
    have h5 := Complex.abs_im_le_norm (MandelDim.tau0 p)
    linarith
  have h6 : (2 : ℝ) ≤ Ξ' := by nlinarith [hΞ', Real.pi_gt_three]
  linarith

end Gate

/-- **The gate preimage of `p` under `τ_C`.**  Under the normalisation `1 - σ u₀ = exp (2πiα)`
(Lemma A.1.2), for every `p ≠ 0, σ` small enough (`64‖α‖‖τ₀p‖ ≤ 1`) whose `τ₀ p = -1/p` has the
gate `Qp Ξ' α` around it (the *room* hypothesis), the fibre `τ_C^{-1}(p)` meets `Qp Ξ' α` within
distance `64 (‖u₀-1‖ + ‖α‖‖τ₀ p‖) ‖τ₀ p‖` of `τ₀ p`. -/
theorem exists_tauC_preimage_gate {Ξ' : ℝ} (hΞ' : 1 + 64 * Real.pi ≤ Ξ')
    {σ α u0 p : ℂ} (hu0 : 1 / 2 ≤ ‖u0‖) (hu1 : ‖u0 - 1‖ ≤ 1 / 2)
    (hnorm : 1 - σ * u0 = Complex.exp (2 * Real.pi * Complex.I * α))
    (hσ : σ ≠ 0) (hinf : MandelDim.InF1 α)
    (hadm : MandelDim.QAdm (some (Ξ' : ℂ)) (some (-(Ξ' : ℂ) + 1 / α)))
    (hp : p ≠ 0) (hps : p ≠ σ)
    (hsmall : 64 * ‖α‖ * ‖MandelDim.tau0 p‖ ≤ 1)
    (hroom : Metric.ball (MandelDim.tau0 p)
        (64 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖)
      ⊆ Work.Pert.Qp Ξ' α) :
    ∃ ζ ∈ Work.Pert.Qp Ξ' α,
      Work.Pert.tauC σ α ζ = p ∧
      ‖ζ - MandelDim.tau0 p‖
        ≤ 64 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖ := by
  have hα : α ≠ 0 := by
    rintro rfl
    simp [MandelDim.InF1] at hinf
  have hα64 : ‖α‖ ≤ 1 / 64 := Gate.norm_alpha_le_of_QAdm hΞ' hadm
  have ht0 : 0 < ‖MandelDim.tau0 p‖ := by
    rw [MandelDim.tau0, norm_div, norm_neg, norm_one]
    exact div_pos one_pos (norm_pos_iff.mpr hp)
  have ht : 1 ≤ ‖MandelDim.tau0 p‖ := Gate.one_le_norm_tau0_of_room (σ := σ) hΞ' hα hp hu1 hα64 hroom
  have hnorm' : σ * u0 = 1 - Complex.exp (2 * Real.pi * Complex.I * α) := by
    rw [← hnorm]; ring
  have hsmall' : 64 * ‖α‖ * ‖1 / p‖ ≤ 1 := by
    rw [Gate.norm_tau0_eq p] at hsmall; exact hsmall
  have ht' : 1 ≤ ‖1 / p‖ := by rw [Gate.norm_tau0_eq p] at ht; exact ht
  have hcore := Work.PertCrux.norm_log_preimage_sub_tau0_le hα hu0 hσ hp hps.symm hnorm' hα64
    hsmall' ht'
  have hbound : ‖-(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α) - MandelDim.tau0 p‖
      ≤ 48 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖ := by
    have h1 : -(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α) - MandelDim.tau0 p
        = -(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α) + 1 / p := by
      rw [MandelDim.tau0]; ring
    rw [h1, Gate.norm_tau0_eq p]
    exact hcore
  have hAB : 0 < (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖ := by
    have h1 : 0 < ‖α‖ * ‖MandelDim.tau0 p‖ := mul_pos (norm_pos_iff.mpr hα) ht0
    nlinarith [norm_nonneg (u0 - 1), h1]
  have hstrict : ‖-(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α) - MandelDim.tau0 p‖
      < 64 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖ := by
    have h2 : 48 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖
        < 64 * (‖u0 - 1‖ + ‖α‖ * ‖MandelDim.tau0 p‖) * ‖MandelDim.tau0 p‖ := by
      nlinarith [hAB]
    linarith [hbound, h2]
  exact ⟨-(Complex.log (1 - σ / p)) / (2 * Real.pi * Complex.I * α),
    hroom (Metric.mem_ball.mpr (by rw [dist_eq_norm]; exact hstrict)),
    Gate.tauC_log_preimage hσ hα hp hps.symm,
    le_of_lt hstrict⟩

end Work.PertCrux
