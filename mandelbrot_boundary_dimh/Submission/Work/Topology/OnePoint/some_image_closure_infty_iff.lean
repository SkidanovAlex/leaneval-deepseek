import Mathlib

namespace Work.Topology.OnePoint

open Set Filter

/-- For `S ⊆ ℂ`, the extra point `∞` of the one-point compactification lies in the closure of
`OnePoint.some '' S` exactly when `S` is unbounded.

Suggested proof: `OnePoint.hasBasis_nhds_infty` says the neighbourhoods of `∞` are generated by
`(↑) '' sᶜ ∪ {∞}` with `s` closed and compact; as `∞ ∉ (↑) '' S`, the point `∞` lies in
`closure ((↑) '' S)` iff `(↑) '' sᶜ` meets `(↑) '' S` for every closed compact `s`, iff `S` is not
contained in any compact set. Over `ℂ` a set is contained in a compact set iff it is bounded
(`Metric.isBounded_iff`, `Bornology.IsBounded.isCompact_closure`, `isCompact_iff_isClosed_bounded`),
and closed balls in `ℂ` are compact. -/
theorem some_image_closure_infty_iff {S : Set ℂ} :
    OnePoint.infty ∈ closure ((OnePoint.some '' S : Set (OnePoint ℂ))) ↔
      ¬ Bornology.IsBounded S := by
  -- `∞` lies in the closure of `(↑) '' S` iff `S` meets the complement of every closed compact set,
  -- i.e. iff `S` is contained in no closed compact set.
  have key : (OnePoint.infty ∈ closure ((OnePoint.some '' S : Set (OnePoint ℂ))) ↔
      ∀ s : Set ℂ, IsClosed s → IsCompact s → ¬ S ⊆ s) := by
    rw [mem_closure_iff_nhds]
    constructor
    · intro h s hs₁ hs₂ hSsub
      have hmem : (OnePoint.some '' sᶜ : Set (OnePoint ℂ)) ∪ {OnePoint.infty} ∈
          nhds OnePoint.infty :=
        OnePoint.hasBasis_nhds_infty.mem_of_mem ⟨hs₁, hs₂⟩
      obtain ⟨x, hx⟩ := h _ hmem
      rw [Set.mem_inter_iff] at hx
      obtain ⟨y, hyS, hyx⟩ := hx.2
      rcases hx.1 with hx1 | hx1
      · obtain ⟨z, hzs, hzx⟩ := hx1
        have hyz : y = z := by
          rw [← OnePoint.coe_eq_coe]
          rw [hyx, hzx]
        exact hzs (hyz ▸ hSsub hyS)
      · rw [hx1] at hyx
        exact OnePoint.coe_ne_infty y hyx
    · intro h t ht
      obtain ⟨s, ⟨hs₁, hs₂⟩, hst⟩ := OnePoint.hasBasis_nhds_infty.mem_iff.mp ht
      obtain ⟨y, hyS, hys⟩ := Set.not_subset.mp (h s hs₁ hs₂)
      exact ⟨OnePoint.some y, hst (Or.inl ⟨y, hys, rfl⟩), ⟨y, hyS, rfl⟩⟩
  rw [key]
  -- Over the proper metric space `ℂ`, "contained in a closed compact set" is "bounded".
  constructor
  · intro h hbdd
    exact h (closure S) isClosed_closure (Bornology.IsBounded.isCompact_closure hbdd)
      subset_closure
  · intro h s _ hs₂ hSsub
    exact h ((IsCompact.isBounded hs₂).subset hSsub)

end Work.Topology.OnePoint
