import Mathlib
import Submission.Work.Interfaces.Parabolic

/-!
# PERT area: the perturbed coordinate `τ_f`, its lift `F_f` and the deck translation `T_f`.

Language layer of the PERT area (Shishikura §4.2 and Lemma A.1.7).  For a perturbation
`f z = z + z (z - σ) u z` (Lemma A.1.2: `σ = σ(f)` is the second fixed point, `u` holomorphic and
nonvanishing) we have

* `tauC σ α w = σ / (1 - exp(-2πi α w))`, the universal cover `ℂ → ℂ ∖ {0, σ}` of (A.1.5),
  whose deck group is generated by `Tt α w = w - 1/α`;
* `sfun u σ α w = σ u(τ w)/(1 + τ w u(τ w))` and `liftF u σ α w = w + log(1 - sfun)/(2πi α)`,
  the lift `F_f` of `f` (A.1.6).

Proved here: the periodicity of `τ_f`, the description of its fibres (`w ↦ w + k/α`), hence its
injectivity on sets of diameter `< 1/|α|`.  The identities `τ_f ∘ F_f = f ∘ τ_f` (the Abel
relation, (A.1.7)(iii)) and `F_f ∘ T_f = T_f ∘ F_f` are delegated (`Work.Pert.abel`) since they
are pure algebra on top of these definitions; the analytic estimates (A.1.7)(ii) and §4.2
(4.2.1)-(4.2.5) are stated against these definitions in the sibling files.
-/

namespace Work.Pert

open MandelDim Complex

noncomputable section

/-- Shishikura (A.1.5): `τ_f(w) = σ / (1 - exp(-2πi α w))`, the universal cover
`ℂ → ℂ ∖ {0, σ}` whose deck group is generated by `T_f`. -/
def tauC (σ α w : ℂ) : ℂ := σ / (1 - Complex.exp (-(2 * Real.pi * I * α * w)))

/-- `T_f(w) = w - 1/α`: the deck translation of `τ_f` (A.1.7(i)). -/
def Tt (α w : ℂ) : ℂ := w - 1 / α

/-- The quantity `s = σ u(z)/(1 + z u(z))`, `z = τ_f(w)`, of (A.1.7)(iii). -/
def sfun (u : ℂ → ℂ) (σ α w : ℂ) : ℂ :=
  σ * u (tauC σ α w) / (1 + tauC σ α w * u (tauC σ α w))

/-- Shishikura (A.1.6): the lift `F_f(w) = w + log(1 - s)/(2πi α)` of the perturbed germ. -/
def liftF (u : ℂ → ℂ) (σ α w : ℂ) : ℂ :=
  w + (1 / (2 * Real.pi * I * α)) * Complex.log (1 - sfun u σ α w)

/-- The elementary equation `e^{-2πi α z} = (τ_f z - σ)/τ_f z`. -/
theorem exp_eq_tauC (σ α w : ℂ) (hσ : σ ≠ 0)
    (hE : Complex.exp (-(2 * Real.pi * I * α * w)) ≠ 1) :
    Complex.exp (-(2 * Real.pi * I * α * w)) = (tauC σ α w - σ) / tauC σ α w := by
  have h1 : (1 : ℂ) - Complex.exp (-(2 * Real.pi * I * α * w)) ≠ 0 := by
    intro h
    rw [sub_eq_zero] at h
    exact hE h.symm
  have h2 : tauC σ α w ≠ 0 := by
    rw [tauC, div_ne_zero_iff]
    exact ⟨hσ, h1⟩
  rw [tauC]
  field_simp
  ring

/-- `τ_f` is periodic with period `1/α`. -/
theorem tauC_add_period (σ α w : ℂ) (hα : α ≠ 0) :
    tauC σ α (w + 1 / α) = tauC σ α w := by
  unfold tauC
  have h2 : α * (w + 1 / α) = α * w + 1 := by
    rw [mul_add, one_div, mul_inv_cancel₀ hα]
  have harg : -(2 * Real.pi * I * α * (w + 1 / α))
      = -(2 * Real.pi * I * α * w) + (-1 : ℤ) * (2 * Real.pi * I) := by
    rw [show (2 * Real.pi * I * α * (w + 1 / α)) = 2 * Real.pi * I * (α * (w + 1 / α)) from by ring,
      h2]
    push_cast
    ring
  rw [harg, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

/-- Two points with the same `τ_f`-image differ by a lattice vector `k/α`. -/
theorem tauC_eq_iff (σ α x y : ℂ) (hσ : σ ≠ 0) (hα : α ≠ 0)
    (hxy : tauC σ α x = tauC σ α y) : ∃ k : ℤ, x = y + k / α := by
  simp only [tauC] at hxy
  set Ex := Complex.exp (-(2 * Real.pi * I * α * x)) with hEx
  set Ey := Complex.exp (-(2 * Real.pi * I * α * y)) with hEy
  have key : Ex = Ey := by
    by_cases hx : (1 : ℂ) - Ex = 0
    · have h1 : (1 : ℂ) - Ey = 0 := by
        have h0 : σ / (1 - Ex) = 0 := by rw [hx, div_zero]
        rw [hxy] at h0
        rcases div_eq_zero_iff.mp h0 with h2 | h2
        · exact absurd h2 hσ
        · exact h2
      rw [sub_eq_zero] at hx h1
      rw [← hx, ← h1]
    · have hy : (1 : ℂ) - Ey ≠ 0 := by
        intro hy
        have h0 : σ / (1 - Ey) = 0 := by rw [hy, div_zero]
        rw [← hxy] at h0
        rcases div_eq_zero_iff.mp h0 with h2 | h2
        · exact absurd h2 hσ
        · exact absurd h2 hx
      have h3 := mul_left_cancel₀ hσ (show σ * (1 - Ey) = σ * (1 - Ex) from
        (div_eq_div_iff hx hy).mp hxy)
      linear_combination h3
  obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.mp key
  refine ⟨-n, ?_⟩
  have h2 : (2 * Real.pi * I : ℂ) * (α * (y - x) - (n : ℂ)) = 0 := by
    linear_combination hn
  have h3 : α * (y - x) - (n : ℂ) = 0 := by
    rcases mul_eq_zero.mp h2 with h | h
    · exact absurd h (by simp [Complex.ext_iff, Real.pi_ne_zero])
    · exact h
  have h4 : α * (y - x) = (n : ℂ) := by linear_combination h3
  have h5 : y - x = (n : ℂ) / α := by
    rw [eq_div_iff hα]
    linear_combination h4
  have h6 : x = y + (-(n : ℂ)) / α := by linear_combination (-1) * h5
  simpa [Int.cast_neg] using h6

/-- `τ_f` is injective on pairs at distance `< 1/|α|`. -/
theorem tauC_inj_of_dist_lt (σ α x y : ℂ) (hσ : σ ≠ 0) (hα : α ≠ 0)
    (h : ‖x - y‖ < 1 / ‖α‖) (hxy : tauC σ α x = tauC σ α y) : x = y := by
  obtain ⟨k, hk⟩ := tauC_eq_iff σ α x y hσ hα hxy
  have hsub : x - y = (k : ℂ) / α := by rw [hk]; ring
  have hk' : ‖((k : ℂ) / α)‖ < 1 / ‖α‖ := by rw [← hsub]; exact h
  rw [norm_div] at hk'
  have hαpos : 0 < ‖α‖ := norm_pos_iff.mpr hα
  have h2 : ‖(k : ℂ)‖ < 1 := (div_lt_div_iff_of_pos_right hαpos).mp hk'
  have h3 : k = 0 := by
    by_contra hk0
    have : (1 : ℝ) ≤ |(k : ℝ)| := by
      have := Int.one_le_abs hk0
      exact_mod_cast this
    have hnorm : ‖(k : ℂ)‖ = |(k : ℝ)| := by simp
    rw [hnorm] at h2
    linarith
  rw [h3] at hk
  simpa using hk

/-- `τ_f` is periodic with period `1/α`, in the form in which the deck translation `T_f` acts. -/
theorem tauC_sub_period (σ α w : ℂ) (hα : α ≠ 0) :
    tauC σ α (w - 1 / α) = tauC σ α w := by
  have h := tauC_add_period σ α (w - 1 / α) hα
  rw [sub_add_cancel] at h
  exact h.symm

/-- The auxiliary quantity `s = σu(τ)/(1+τu(τ))` is periodic with period `1/α`. -/
theorem sfun_add_period (u : ℂ → ℂ) (σ α w : ℂ) (hα : α ≠ 0) :
    sfun u σ α (w + 1 / α) = sfun u σ α w := by
  simp only [sfun, tauC_add_period σ α w hα]

theorem sfun_sub_period (u : ℂ → ℂ) (σ α w : ℂ) (hα : α ≠ 0) :
    sfun u σ α (w - 1 / α) = sfun u σ α w := by
  simp only [sfun, tauC_sub_period σ α w hα]

/-- The Abel relation `τ_f ∘ F_f = f ∘ τ_f` in the form of `Work.Pert.abel`, together with the
deck equivariance `F_f (T_f w) = T_f (F_f w)`, is what makes `φ_f ∘ R̃_f = φ_f` exact. -/
theorem liftF_sub_period (u : ℂ → ℂ) (σ α w : ℂ) (hα : α ≠ 0) :
    liftF u σ α (w - 1 / α) = liftF u σ α w - 1 / α := by
  unfold liftF
  rw [sfun_sub_period u σ α w hα]
  ring

/-- `exp (2πi · rotOf f) = deriv f 0`, i.e. the rotation number `rotOf f` is the `α` of
`f'(0) = e^{2πiα}` (used to convert the normalisation `1 - σu(0) = exp (2πiα)` of the gate
estimates into `1 - σu(0) = f'(0)`). -/
theorem exp_rotOf (f : ℂ → ℂ) (h : deriv f 0 ≠ 0) :
    Complex.exp (2 * Real.pi * I * rotOf f) = deriv f 0 := by
  rw [rotOf, mul_div_cancel₀ _ (by simp [Complex.ext_iff, Real.pi_ne_zero] : (2 : ℂ) * Real.pi * I ≠ 0),
    Complex.exp_log h]

end

end Work.Pert
