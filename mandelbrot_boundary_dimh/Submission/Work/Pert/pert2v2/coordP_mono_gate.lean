import Mathlib
import Submission.Work.Pert.MaxDom
import Submission.Work.Pert.AsmDefs
import Submission.Work.Pert.coordP_level_eq

/-!
# PERT · `Work.Pert.pert2v2.coordP_mono_gate`: the coordinate is monotone in the gate

`coordP f Df τ Φ Q = φ_f` is defined on the maximal domain
`DphiP f Df τ Φ Q = {w | ∃ n, w - n ∈ Φ '' Q ∧ ∀ j < n, f^[j] (seedP τ Φ Q (w - n)) ∈ Df}`
(Shishikura A.3/A.4), where the seed value `seedP τ Φ Q x = τ (invOn Φ Q x)` uses a chosen preimage
**in `Q`**.  This lemma says that enlarging the gate `Q ⊆ Q'` does not change either the domain (on
the smaller one) or the value, *provided* `Φ` is injective on `Q'` and the level structure of `Q'`
is generated by the lift `F` in the sense of `hOrb`:

* `hab`: one step of `F` inside `Q'` raises the `Φ`-level by `1`;
* `hτF`: `τ ∘ F = f ∘ τ` on `Q'`;
* `hOrb`: two points of `Q'` whose `Φ`-values differ by an integer `k` are related by `F^[k]`, the
  walk staying in `Q'`.

Under these, `DphiP … Q ⊆ DphiP … Q'` — the only obstruction is the chosen preimage `invOn Φ Q`
versus `invOn Φ Q'`, which injectivity on `Q'` settles — and the values agree: the minimal level
`mIdxP` of `w` in the larger gate may be *smaller*, but `hOrb` upgrades the extra levels to iterates
of `f` and the two values coincide.
-/

namespace Work.Pert.pert2v2

open Work.Pert

theorem coordP_mono_gate {f : ℂ → ℂ} {Df : Set ℂ} {F τ Φ : ℂ → ℂ} {Q Q' : Set ℂ}
    (hsub : Q ⊆ Q') (hinj : Set.InjOn Φ Q')
    (hab : ∀ z ∈ Q', F z ∈ Q' → Φ (F z) = Φ z + 1)
    (hτF : ∀ z ∈ Q', τ (F z) = f (τ z))
    (hOrb : ∀ z ∈ Q', ∀ z' ∈ Q', ∀ k : ℕ, Φ z' = Φ z + (k : ℂ) →
      (∀ j : ℕ, j ≤ k → F^[j] z ∈ Q') ∧ F^[k] z = z')
    {w : ℂ} (hw : w ∈ Work.Pert.DphiP f Df τ Φ Q) :
    w ∈ Work.Pert.DphiP f Df τ Φ Q' ∧
      Work.Pert.coordP f Df τ Φ Q w = Work.Pert.coordP f Df τ Φ Q' w := by
  classical
  have hinjQ : Set.InjOn Φ Q := hinj.mono hsub
  -- **Step 1.** The seed value is the same for the two gates, on the smaller gate image: both
  -- chosen preimages lie in `Q'`, where `Φ` is injective.
  have hseed : ∀ x ∈ Φ '' Q, seedP τ Φ Q x = seedP τ Φ Q' x := by
    rintro x ⟨ζ, hζ, rfl⟩
    exact (seedP_eq_of_mem' hinjQ ⟨ζ, hζ, rfl⟩ hζ rfl).trans
      (seedP_eq_of_mem' hinj ⟨ζ, hsub hζ, rfl⟩ (hsub hζ) rfl).symm
  -- **Step 2.** Hence `GoodP` is monotone: a level admissible for `Q` is admissible for `Q'`.
  have hwQ : GoodP f Df τ Φ Q w := hw
  have hwQ' : GoodP f Df τ Φ Q' w := by
    obtain ⟨n, hn, horb⟩ := hwQ
    exact ⟨n, Set.image_mono hsub hn, fun j hj => by rw [← hseed _ hn]; exact horb j hj⟩
  refine ⟨hwQ', ?_⟩
  -- **Step 3.** The value.  Write `n₀`/`n₁` for the minimal levels of `w` in `Q`/`Q'` and let
  -- `ζ₀`/`z₁` be the corresponding preimages; the seed identification gives
  -- `φ_Q(w) = f^[n₀] (τ ζ₀)` and `φ_{Q'}(w) = f^[n₁] (τ z₁)`.
  obtain ⟨h₀mem, h₀spec⟩ := mIdxP_spec hwQ
  obtain ⟨h₁mem, _⟩ := mIdxP_spec hwQ'
  have hle : mIdxP f Df τ Φ Q' w ≤ mIdxP f Df τ Φ Q w := by
    refine mIdxP_le hwQ' ⟨Set.image_mono hsub h₀mem, fun j hj => ?_⟩
    rw [← hseed _ h₀mem]
    exact h₀spec j hj
  have h₀mem' := h₀mem
  have h₁mem' := h₁mem
  obtain ⟨ζ₀, hζ₀Q, hζ₀Φ⟩ := h₀mem
  obtain ⟨z₁, hz₁Q, hz₁Φ⟩ := h₁mem
  have hcoord₀ : coordP f Df τ Φ Q w = f^[mIdxP f Df τ Φ Q w] (τ ζ₀) := by
    rw [coordP_self, seedP_eq_of_mem' hinjQ h₀mem' hζ₀Q hζ₀Φ]
  have hcoord₁ : coordP f Df τ Φ Q' w = f^[mIdxP f Df τ Φ Q' w] (τ z₁) := by
    rw [coordP_self, seedP_eq_of_mem' hinj h₁mem' hz₁Q hz₁Φ]
  -- **Step 4.** `z₁` is exactly `F^[n₀ - n₁] ζ₀` (`hOrb`), and `τ` intertwines `F` with `f`.
  have hΦshift : Φ z₁ = Φ ζ₀ +
      ((mIdxP f Df τ Φ Q w - mIdxP f Df τ Φ Q' w : ℕ) : ℂ) := by
    rw [hz₁Φ, hζ₀Φ, Nat.cast_sub hle]
    ring
  have hτz₁ : τ z₁
      = f^[(mIdxP f Df τ Φ Q w - mIdxP f Df τ Φ Q' w : ℕ)] (τ ζ₀) :=
    tau_eq_iterate_of_shift hτF hOrb (hsub hζ₀Q) hz₁Q hΦshift
  rw [hcoord₀, hcoord₁, hτz₁, ← Function.iterate_add_apply, Nat.add_sub_of_le hle]

end Work.Pert.pert2v2
