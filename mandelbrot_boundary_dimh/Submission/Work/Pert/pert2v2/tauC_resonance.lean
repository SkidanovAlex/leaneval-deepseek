import Mathlib
import Submission.Work.Pert.Basic
import Submission.Work.Pert.pert2v2.tauC_left_cone

/-!
# `Work.Pert.pert2v2.tauC_resonance` — the resonance of the low-band level bookkeeping, named

## The resonance

In `Rlow_phi_translate_lt` the two compared values are both `f^[N]`-preimages of the landing value
`y = τ_f u` (`N = mₓ − l`, `u = Tt α ζ` the crux's gate point).  Through the parabolic coordinate
(`f ∘ τ = τ ∘ F`, `F` a near-translation) the preimages correspond to the solutions of
`F^[N] w = u`, so the *petal* preimage is `τ(w_N)` with `w_N ≈ u − N`.  In the Möbius model this
reads `z = y/(1 + N a₂ y)`, which degenerates exactly when

  `1 + N a₂ y = 0`  ⟺  `y = −1/(N a₂)`  ⟺  `τ u = τ N`  ⟺  `u − N ∈ (1/α)ℤ`,

the last equivalence because the fibres of `τ` are the cosets of `(1/α)ℤ` (`tauC_fibre` below).
This is the **resonance**: the resonance point `z_* := N + (1/α)ℤ` is named, and the landing value
is the *explicit* `τ_f N`.

**Correction of the session-42 note §10.2.**  That note claimed that at the resonance the petal
preimage "jumps to an absolute constant `O(1)`" (a root of `−1/(a₂ z) + b log z + c = 0`).  That is
an artefact of the Möbius model, which is invalid near its own pole: the true `f^[N]` is entire and
its injectivity radius carries the `log N/N` correction
`q_N = 1 + (1 − Re(b/a²))·(log N)/N` (`NOTES_injOn_iterate_ball_sharp_FALSE.md`).  There is no
escape to an `O(1)` point: the resonance is **not** a special case.  `y = τ_f N` is a value like any
other, `tauC_left_cone` applied at the *real* point `N` (`tauC_cone_at_nat` below) puts it in the
left cone, and the sharp injectivity ball of `injOn_iterate_ball_sharp_v2` covers the preimage.

## Contents

* `tauC_add_int_div` — the `(1/α)ℤ`-periodicity of `τ_f` (the deck group of the universal cover);
* `tauC_fibre` — conversely, equal `τ_f`-values differ by an element of `(1/α)ℤ` (no junk cases);
* `tauC_resonance` — the resonance identifies `τ_f u` with the explicit `τ_f N`;
* `tauC_cone_at_nat` — the resonance value lies in the left cone (`tauC_left_cone` at `w = N`).
-/

namespace Work.Pert.pert2v2

open Work.Pert Complex

noncomputable section

/-- **The `(1/α)ℤ`-periodicity of `τ_f`.**  `τ_f (w + k/α) = τ_f w`: the deck group of the
universal cover `τ_f : ℂ → ℂ ∖ {0, σ}` is generated by `w ↦ w − 1/α`. -/
theorem tauC_add_int_div (σ α : ℂ) (hα : α ≠ 0) (k : ℤ) (w : ℂ) :
    Work.Pert.tauC σ α (w + (k : ℂ) / α) = Work.Pert.tauC σ α w := by
  have hαk : α * ((k : ℂ) / α) = (k : ℂ) := mul_div_cancel₀ _ hα
  have hsplit : 2 * Real.pi * Complex.I * α * (w + (k : ℂ) / α)
      = 2 * Real.pi * Complex.I * α * w + 2 * Real.pi * Complex.I * (k : ℂ) := by
    have h1 : α * (w + (k : ℂ) / α) = α * w + (k : ℂ) := by rw [mul_add, hαk]
    rw [show 2 * Real.pi * Complex.I * α * (w + (k : ℂ) / α)
        = 2 * Real.pi * Complex.I * (α * (w + (k : ℂ) / α)) by ring, h1]
    ring
  have harg : -(2 * Real.pi * Complex.I * α * (w + (k : ℂ) / α))
      = -(2 * Real.pi * Complex.I * α * w) - 2 * Real.pi * Complex.I * (k : ℂ) := by
    rw [hsplit]; ring
  have hexp1 : Complex.exp (2 * Real.pi * Complex.I * (k : ℂ)) = 1 := by
    rw [show 2 * Real.pi * Complex.I * (k : ℂ) = (k : ℂ) * (2 * Real.pi * Complex.I) by ring]
    exact Complex.exp_int_mul_two_pi_mul_I k
  rw [Work.Pert.tauC, Work.Pert.tauC, harg, Complex.exp_sub, hexp1, div_one]

/-- **The fibres of `τ_f` are the cosets of `(1/α)ℤ`.**  If two `τ_f`-values agree and the first
denominator does not vanish, then the arguments differ by an element of `(1/α)ℤ`. -/
theorem tauC_fibre {σ α z z' : ℂ} (hσ : σ ≠ 0) (hα : α ≠ 0)
    (hz : 1 - Complex.exp (-(2 * Real.pi * Complex.I * α * z)) ≠ 0)
    (h : Work.Pert.tauC σ α z = Work.Pert.tauC σ α z') :
    ∃ k : ℤ, z - z' = (k : ℂ) / α := by
  -- the second denominator is nonzero as well (otherwise `τ_f z' = 0 ≠ τ_f z`)
  have hz' : 1 - Complex.exp (-(2 * Real.pi * Complex.I * α * z')) ≠ 0 := by
    intro hzero
    have h2 : Work.Pert.tauC σ α z = 0 := by
      rw [h, Work.Pert.tauC, hzero, div_zero]
    rw [Work.Pert.tauC, div_eq_zero_iff] at h2
    exact h2.elim (fun h0 => hσ h0) (fun hd => hz hd)
  -- cancel `σ` and the denominators
  have h1 : σ / (1 - Complex.exp (-(2 * Real.pi * Complex.I * α * z)))
      = σ / (1 - Complex.exp (-(2 * Real.pi * Complex.I * α * z'))) := by
    simpa only [Work.Pert.tauC] using h
  rw [div_eq_div_iff hz hz'] at h1
  have hexp : Complex.exp (-(2 * Real.pi * Complex.I * α * z))
      = Complex.exp (-(2 * Real.pi * Complex.I * α * z')) := by
    have h3 : (1 : ℂ) - Complex.exp (-(2 * Real.pi * Complex.I * α * z'))
        = 1 - Complex.exp (-(2 * Real.pi * Complex.I * α * z)) :=
      mul_left_cancel₀ hσ h1
    have h5 : -(Complex.exp (-(2 * Real.pi * Complex.I * α * z')))
        = -(Complex.exp (-(2 * Real.pi * Complex.I * α * z))) := by
      have h6 := congrArg (fun t : ℂ => t - 1) h3
      simpa using h6
    exact (neg_inj.mp h5).symm
  -- exponentiate the difference and read off the lattice element
  have hq : Complex.exp (-(2 * Real.pi * Complex.I * α * z)
      - (-(2 * Real.pi * Complex.I * α * z'))) = 1 := by
    rw [Complex.exp_sub, hexp, div_self (Complex.exp_ne_zero _)]
  obtain ⟨m, hm⟩ := Complex.exp_eq_one_iff.mp hq
  refine ⟨-m, ?_⟩
  have hne : (2 * Real.pi * Complex.I : ℂ) ≠ 0 := by
    refine mul_ne_zero (mul_ne_zero (by norm_num) ?_) Complex.I_ne_zero
    exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hl : -(2 * Real.pi * Complex.I * α * z) - (-(2 * Real.pi * Complex.I * α * z'))
      = (-(2 * Real.pi * Complex.I)) * (α * (z - z')) := by ring
  rw [hl] at hm
  have hm2 : α * (z - z') = -(m : ℂ) := by
    refine mul_left_cancel₀ (neg_ne_zero.mpr hne) ?_
    rw [hm]
    ring
  have hgoal : α * (z - z') = (((-m : ℤ)) : ℂ) := by
    simpa using hm2
  rw [eq_div_iff hα, mul_comm]
  exact hgoal

/-- **The resonance.**  If the crux's gate point `u` satisfies `u = N + k/α`, then the landing value
is the *explicit* `τ_f N = σ/(1 - exp (-2πiαN))`, and the resonance point is `N + (1/α)ℤ`. -/
theorem tauC_resonance {σ α u : ℂ} {N : ℕ} (hα : α ≠ 0)
    (hres : ∃ k : ℤ, u = (N : ℂ) + (k : ℂ) / α) :
    Work.Pert.tauC σ α u = Work.Pert.tauC σ α (N : ℂ) := by
  obtain ⟨k, rfl⟩ := hres
  exact tauC_add_int_div σ α hα k (N : ℂ)

/-- **The resonance value lies in the left cone.**  `tauC_left_cone` applied at the *real* point
`N`: at the resonance the landing value `τ_f N` is at least `120°` away from the positive real
axis, exactly as for a generic band value — the resonance needs no special argument. -/
theorem tauC_cone_at_nat {u : ℂ → ℂ} {σ α : ℂ} {N : ℕ}
    (hnorm : 1 - σ * u 0 = Complex.exp (2 * Real.pi * Complex.I * α))
    (hu0 : ‖u 0 - 1‖ ≤ 1 / 16)
    (hα : 2 * Real.pi * ‖α‖ * (‖(N : ℂ)‖ + 1) ≤ 1 / 32)
    (hN : 1 ≤ (N : ℝ)) :
    (Work.Pert.tauC σ α (N : ℂ)).re ≤ 0 ∧
      ‖Work.Pert.tauC σ α (N : ℂ)‖ ≤ -2 * (Work.Pert.tauC σ α (N : ℂ)).re :=
  tauC_left_cone (u := u) (σ := σ) (α := α) (w := (N : ℂ)) hnorm hu0 hα
    (by simpa using hN) (by simp; positivity)

end

end Work.Pert.pert2v2
