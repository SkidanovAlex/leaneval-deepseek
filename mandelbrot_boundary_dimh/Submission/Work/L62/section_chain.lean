import Mathlib
import Submission.Work.Interfaces.Parabolic

/-!
# `Work.L62.section_chain` — the chain of discs generated by a section of `ĥ = Ẽ - β`

Adding to `Submission/Work/L62/chain.lean` (the `IsChain` bundle of Shishikura's Lemma 6.2) the
purely *topological* step of the construction: once one has a holomorphic section
`σ` of `ĥ = d.E - β` over the upper horn `hd.Bu` (`ĥ (σ w) = w` for `w ∈ Bu`, `σ` mapping `Bu`
into itself), then from a single open connected piece `W₁ ⊆ Bu` whose `ĥ`-image `W₀` is taken
injectively, one gets a whole (forward-indexed) chain

`W 0 = W₀`, `W 1 = W₁`, `W (j+2) = σ '' W (j+1)`,

of open connected sets with `W (j+1) ⊆ Bu` and `ĥ : W (j+1) → W j` a bijection.

Since `ĥ ∘ σ = id` on `Bu` and `σ` is a *right* inverse, every element of `W (j+1) = σ '' W j`
(`j ≥ 1`) is of the form `σ a` with `a ∈ W j`; hence `ĥ` is injective on `W (j+1)` without any
global injectivity assumption on `ĥ`.  The only geometric input is the open mapping theorem for
holomorphic functions (`AnalyticOnNhd.is_constant_or_isOpen`): applied to `ĥ` on `W₁` (which is
injective there by hypothesis) it gives that `W₀ = ĥ '' W₁` is open, and applied to `σ` on the
`W j` (where `σ` is injective because `ĥ ∘ σ = id`) it gives that the `W (j+1)` are open.

Note that `W₁ = σ '' W₀` need *not* hold (`W₀ = ĥ '' W₁` may leave `Bu`); this is why the chain is
defined with `W 1 = W₁` given and the recursion started only from `W₁` onwards.
-/

namespace Work.L62

open MandelDim Set Filter Topology

noncomputable section

/-- **The open mapping theorem in the form used below.**  An injective holomorphic function on an
open preconnected set of `ℂ` is open on that set.  (`AnalyticOnNhd.is_constant_or_isOpen` gives
the result unless `f` is constant; injectivity together with `IsOpen` on a nonempty `U` rules the
constant case out, since then `U` would be an open singleton.) -/
theorem isOpen_image_of_analyticOnNhd_of_injOn {f : ℂ → ℂ} {U : Set ℂ}
    (hUo : IsOpen U) (hUn : U.Nonempty) (hUc : IsPreconnected U)
    (hA : AnalyticOnNhd ℂ f U) (hinj : Set.InjOn f U) : IsOpen (f '' U) := by
  rcases hA.is_constant_or_isOpen hUc with ⟨w, hw⟩ | h
  · obtain ⟨z₀, hz₀⟩ := hUn
    have hUeq : U = {z₀} :=
      Set.eq_singleton_iff_nonempty_unique_mem.mpr
        ⟨⟨z₀, hz₀⟩, fun x hx => hinj hx hz₀ (by rw [hw x hx, hw z₀ hz₀])⟩
    rw [hUeq] at hUo
    exact (not_isOpen_singleton z₀ hUo).elim
  · exact h U Subset.rfl hUo

/-- **Chain of discs generated by a section of the lifted horn map.**  With `d : ParabData g₀ D`
and its horn data `hd`, let `σ` be a holomorphic section of `ĥ = d.E - β` over the upper horn
`hd.Bu` (a right inverse, mapping `Bu` into itself), and let `W₁ ⊆ Bu` be open and connected with
`ĥ : W₁ → W₀` injective onto `W₀`.  Then there is a chain `W : ℕ → Set ℂ` of open connected sets
with `W 0 = W₀`, `W 1 = W₁`, `W (j+1) ⊆ Bu`, and `ĥ` a bijection `W (j+1) → W j` for every `j`. -/
theorem section_chain {g₀ : ℂ → ℂ} {D : Set ℂ} (d : MandelDim.ParabData g₀ D) (hd : MandelDim.HornData d)
    {β : ℂ} {σ : ℂ → ℂ}
    (hσdiff : DifferentiableOn ℂ σ hd.Bu) (hσmem : ∀ w ∈ hd.Bu, σ w ∈ hd.Bu)
    (hσsec : ∀ w ∈ hd.Bu, d.E (σ w) - β = w)
    {W₀ W₁ : Set ℂ} (hW₁sub : W₁ ⊆ hd.Bu) (hW₁o : IsOpen W₁) (hW₁c : IsConnected W₁)
    (hWimg : (fun w => d.E w - β) '' W₁ = W₀)
    (hWinj : Set.InjOn (fun w => d.E w - β) W₁) :
    ∃ W : ℕ → Set ℂ, W 0 = W₀ ∧ W 1 = W₁ ∧
      (∀ j, IsOpen (W j) ∧ IsConnected (W j)) ∧
      (∀ j, W (j+1) ⊆ hd.Bu) ∧
      (∀ j, Set.InjOn (fun w => d.E w - β) (W (j+1)) ∧
        (fun w => d.E w - β) '' W (j+1) = W j) := by
  -- `d.E` is holomorphic on `d.DE = φ⁻¹(basin)`, hence on the horn `Bu`
  have hDE : DifferentiableOn ℂ d.E d.DE := by
    have h := d.Φ_holo.comp (d.φ_holo.mono (show d.DE ⊆ d.Dφ from fun w hw => hw.1))
      (show Set.MapsTo d.φ d.DE (MandelDim.ParabolicBasin g₀ D) from fun w hw => hw.2)
    exact h
  have hEdiff : DifferentiableOn ℂ d.E hd.Bu := hDE.mono (fun w hw => hd.sub (Or.inl hw))
  have hHdiff : DifferentiableOn ℂ (fun w => d.E w - β) hd.Bu := hEdiff.sub_const β
  -- the section is injective: `ĥ (σ u) = u`
  have hσinj : Set.InjOn σ hd.Bu := by
    intro u hu v hv huv
    rw [← hσsec u hu, ← hσsec v hv, huv]
  -- `W₀ = ĥ '' W₁` is open and connected
  have hW₀o : IsOpen W₀ := by
    have h : IsOpen ((fun w => d.E w - β) '' W₁) :=
      isOpen_image_of_analyticOnNhd_of_injOn hW₁o hW₁c.nonempty hW₁c.isPreconnected
        ((hHdiff.mono hW₁sub).analyticOnNhd hW₁o) hWinj
    rwa [hWimg] at h
  have hW₀c : IsConnected W₀ := by
    rw [← hWimg]
    exact hW₁c.image _ (hHdiff.continuousOn.mono hW₁sub)
  -- the chain: `W 0 = W₀`, `W 1 = W₁` and `W (k+2) = σ '' W (k+1)`
  let W : ℕ → Set ℂ := Nat.rec W₀ (fun k (_ : Set ℂ) => (fun S : Set ℂ => σ '' S)^[k] W₁)
  have hW0 : W 0 = W₀ := rfl
  have hW1 : W 1 = W₁ := rfl
  have hWiter : ∀ k, W (Nat.succ k) = (fun S : Set ℂ => σ '' S)^[k] W₁ := fun k => rfl
  have hWstep : ∀ k, W (Nat.succ (Nat.succ k)) = σ '' W (Nat.succ k) := by
    intro k
    rw [hWiter (Nat.succ k), Function.iterate_succ_apply', hWiter k]
  -- one step of the chain preserves openness, connectedness and membership in `Bu`
  have hstep : ∀ S : Set ℂ, S ⊆ hd.Bu → IsOpen S → IsConnected S →
      IsOpen (σ '' S) ∧ IsConnected (σ '' S) ∧ σ '' S ⊆ hd.Bu := by
    intro S hSsub hSo hSc
    exact ⟨isOpen_image_of_analyticOnNhd_of_injOn hSo hSc.nonempty hSc.isPreconnected
             ((hσdiff.mono hSsub).analyticOnNhd hSo) (hσinj.mono hSsub),
           hSc.image σ ((hσdiff.mono hSsub).continuousOn),
           fun x hx => by rcases hx with ⟨w, hw, rfl⟩; exact hσmem w (hSsub hw)⟩
  -- hence for every `k`, `W (k+1)` is open, connected and contained in `Bu`
  have hP : ∀ k, IsOpen (W (Nat.succ k)) ∧ IsConnected (W (Nat.succ k)) ∧ W (Nat.succ k) ⊆ hd.Bu := by
    intro k
    induction k with
    | zero => exact ⟨hW₁o, hW₁c, hW₁sub⟩
    | succ k ih =>
        rw [hWstep k]
        exact hstep (W (Nat.succ k)) ih.2.2 ih.1 ih.2.1
  refine ⟨W, hW0, hW1, ?_, ?_, ?_⟩
  · intro j
    cases j with
    | zero => exact ⟨hW₀o, hW₀c⟩
    | succ k => exact ⟨(hP k).1, (hP k).2.1⟩
  · intro j
    exact (hP j).2.2
  · intro j
    cases j with
    | zero => exact ⟨hWinj, hWimg⟩
    | succ k =>
        have hsub : W (Nat.succ k) ⊆ hd.Bu := (hP k).2.2
        have hgoal : Set.InjOn (fun w => d.E w - β) (σ '' W (Nat.succ k)) ∧
            (fun w => d.E w - β) '' (σ '' W (Nat.succ k)) = W (Nat.succ k) := by
          refine ⟨?_, ?_⟩
          · -- injectivity: write both points as `σ a`, `σ b` with `a b ∈ W (k+1)`
            intro y₁ hy₁ y₂ hy₂ heq
            rcases hy₁ with ⟨a, ha, rfl⟩
            rcases hy₂ with ⟨b, hb, rfl⟩
            have hab : a = b := by
              rw [← hσsec a (hsub ha), ← hσsec b (hsub hb)]
              exact heq
            rw [hab]
          · -- image: `ĥ (σ a) = a` for `a ∈ W (k+1)`
            rw [← Set.image_comp]
            have himg : (fun w => (fun u => d.E u - β) (σ w)) '' W (Nat.succ k) = W (Nat.succ k) := by
              rw [Set.image_congr (fun w hw => hσsec w (hsub hw))]
              exact Set.image_id _
            exact himg
        rw [hWstep k]
        exact hgoal

end

end Work.L62
