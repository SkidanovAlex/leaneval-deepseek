import Mathlib.Probability.Independence.Basic

set_option autoImplicit false

namespace Commons.Probability.Independence

open MeasureTheory ProbabilityTheory
open scoped BigOperators

/-- A set which is measurable with respect to the σ-algebra generated by a constant map
is either empty or the whole space. -/
private lemma measurableSet_comap_const_iff {α β : Type*} [MeasurableSpace β] (c : β) (A : Set α) :
    MeasurableSet[(inferInstance : MeasurableSpace β).comap (fun _ : α => c)] A ↔ A = ∅ ∨ A = Set.univ := by
  rw [MeasurableSpace.comap_const]
  exact MeasurableSpace.measurableSet_bot_iff

/-- The intersection over a finite set of indices of a sum type splits into the intersection
over the left part and the intersection over the right part. -/
private lemma iInter_sum_split {ι κ Ω : Type*} (s : Finset (ι ⊕ κ)) (f' : ι ⊕ κ → Set Ω) :
    (⋂ i ∈ s, f' i) =
      (⋂ i ∈ s.toLeft, f' (Sum.inl i)) ∩ (⋂ j ∈ s.toRight, f' (Sum.inr j)) := by
  classical
  ext x; simp only [Set.mem_iInter, Set.mem_inter_iff]
  constructor
  · intro hx
    constructor
    · intro i hi
      exact hx (Sum.inl i) (by simpa [Finset.mem_toLeft] using hi)
    · intro j hj
      exact hx (Sum.inr j) (by simpa [Finset.mem_toRight] using hj)
  · intro hx i hi
    rw [← Finset.toLeft_disjSum_toRight (u := s)] at hi
    rcases (Finset.mem_disjSum.mp hi) with ⟨a, ha, rfl⟩ | ⟨b, hb, rfl⟩
    · exact hx.1 a ha
    · exact hx.2 b hb

/-- If all the right components of a family of sets are the whole space, the intersection
over the disjoint union reduces to the intersection over the left part. -/
private lemma iInter_sum_left {ι κ Ω : Type*} (s : Finset (ι ⊕ κ)) (f' : ι ⊕ κ → Set Ω)
    (h : ∀ j ∈ s.toRight, f' (Sum.inr j) = Set.univ) :
    (⋂ i ∈ s, f' i) = ⋂ i ∈ s.toLeft, f' (Sum.inl i) := by
  classical
  rw [iInter_sum_split s f']
  have hright : (⋂ j ∈ s.toRight, f' (Sum.inr j)) = Set.univ := by
    ext x; simp only [Set.mem_univ, Set.mem_iInter, iff_true]
    intro j hj
    rw [h j hj]
    trivial
  rw [hright, Set.inter_univ]

/-- Adding a family of constant random variables to an independent family preserves
independence: if `(X i)` is an independent family of real random variables, then the family
which agrees with `X` on `ι` and is constantly `0` on `κ` is independent as well. -/
theorem iIndepFun_elim_const {ι κ Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [MeasureTheory.IsProbabilityMeasure P] (X : ι → Ω → ℝ)
    (hX : ProbabilityTheory.iIndepFun X P) :
    ProbabilityTheory.iIndepFun
      (fun s : ι ⊕ κ => Sum.elim X (fun _ : κ => fun _ : Ω => (0 : ℝ)) s) P := by
  classical
  rw [ProbabilityTheory.iIndepFun_iff
    (m := fun _ : ι ⊕ κ => (inferInstance : MeasurableSpace ℝ))
    (f := Sum.elim X (fun _ : κ => fun _ : Ω => (0 : ℝ))) P]
  intro s f' hmeas
  by_cases hz : ∃ j : κ, j ∈ s.toRight ∧ f' (Sum.inr j) = (∅ : Set Ω)
  · rcases hz with ⟨j, hjSR, hf0⟩
    have hset : (⋂ i ∈ s, f' i) = (∅ : Set Ω) := by
      ext x
      simp only [Set.mem_empty_iff_false, Set.mem_iInter, iff_false]
      intro hx
      have hmem : Sum.inr j ∈ s := by simpa [Finset.mem_toRight] using hjSR
      have hx0 : x ∈ f' (Sum.inr j) := hx (Sum.inr j) hmem
      rw [hf0] at hx0
      exact hx0
    have hP0 : P (f' (Sum.inr j)) = 0 := by rw [hf0]; simp
    have hmem : Sum.inr j ∈ s := by simpa [Finset.mem_toRight] using hjSR
    have hprod0 : (∏ i ∈ s, P (f' i)) = 0 := by
      exact Finset.prod_eq_zero hmem hP0
    rw [hset, hprod0]
    simp
  · have huniv : ∀ j ∈ s.toRight, f' (Sum.inr j) = Set.univ := by
      intro j hjSR
      have hmem : Sum.inr j ∈ s := by simpa [Finset.mem_toRight] using hjSR
      have hm := hmeas (Sum.inr j) hmem
      rw [Sum.elim_inr] at hm
      have hmeasj : MeasurableSet[(inferInstance : MeasurableSpace ℝ).comap (fun _ : Ω => (0 : ℝ))]
          (f' (Sum.inr j)) := hm
      have hc := (measurableSet_comap_const_iff (0 : ℝ) (f' (Sum.inr j))).mp hmeasj
      rcases hc with h | h
      · exact False.elim (hz ⟨j, hjSR, h⟩)
      · exact h
    have hleft : (⋂ i ∈ s, f' i) = ⋂ i ∈ s.toLeft, f' (Sum.inl i) :=
      iInter_sum_left s f' huniv
    have hprod : (∏ i ∈ s, P (f' i)) = ∏ i ∈ s.toLeft, P (f' (Sum.inl i)) := by
      rw [Finset.prod_sum_eq_prod_toLeft_mul_prod_toRight s (fun i : ι ⊕ κ => P (f' i))]
      have hright : (∏ j ∈ s.toRight, P (f' (Sum.inr j))) = 1 := by
        apply Finset.prod_eq_one
        intro j hjSR
        rw [huniv j hjSR]
        simp
      rw [hright, mul_one]
    rw [hleft, hprod]
    exact hX.meas_biInter (S := s.toLeft) (s := fun i : ι => f' (Sum.inl i)) (by
      intro i hiSL
      have hmem : Sum.inl i ∈ s := by simpa [Finset.mem_toLeft] using hiSL
      have hm := hmeas (Sum.inl i) hmem
      rw [Sum.elim_inl] at hm
      exact hm)

end Commons.Probability.Independence