import Mathlib
import Submission.Work.Modular.presentedGroup_equiv_PSL

namespace Work.GroupTheory

noncomputable section

open Matrix Matrix.SpecialLinearGroup

/-!
## The presentation `SL(2,ℤ) = ⟨S, T | S ^ 4 = 1, S ^ 2 = (S * T) ^ 3⟩`

We build the abstract presented group `PresSL` and the canonical map onto `SL(2,ℤ)`, and prove
that it is an isomorphism.  Injectivity is obtained by comparison with `PSL(2,ℤ)`: the element
`c = S ^ 2 = (S * T) ^ 3` of `PresSL` is central of order two, and `PresSL / ⟨c⟩` is the classical
presentation `⟨S, T | S ^ 2 = (S * T) ^ 3 = 1⟩` of `PSL(2,ℤ)` (established in
`Submission.Work.Modular.presentedGroup_equiv_PSL`).
-/

/-- The relators `S ^ 4` and `S ^ 2 * (S * T) ^ (-3)` of the classical presentation of
`SL(2, ℤ)`. -/
def relSL : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ (4 : ℕ),
    FreeGroup.of 0 ^ (2 : ℕ) * ((FreeGroup.of 0 * FreeGroup.of 1) ^ (3 : ℕ))⁻¹}

/-- The abstract group `⟨S, T | S ^ 4 = 1, S ^ 2 = (S * T) ^ 3⟩`. -/
abbrev PresSL : Type := PresentedGroup relSL

/-- The generator `S` of `PresSL`. -/
def pgS : PresSL := PresentedGroup.of (0 : Fin 2)

/-- The generator `T` of `PresSL`. -/
def pgT : PresSL := PresentedGroup.of (1 : Fin 2)

theorem pgS_pow_four : pgS ^ 4 = 1 := by
  have h : FreeGroup.of (0 : Fin 2) ^ (4 : ℕ) ∈ relSL := by simp [relSL]
  simpa [pgS, PresentedGroup.of] using PresentedGroup.one_of_mem h

theorem pgS_sq_mul_inv : pgS ^ 2 * ((pgS * pgT) ^ 3)⁻¹ = 1 := by
  have h : FreeGroup.of (0 : Fin 2) ^ (2 : ℕ) *
      ((FreeGroup.of 0 * FreeGroup.of 1) ^ (3 : ℕ))⁻¹ ∈ relSL := by simp [relSL]
  simpa [pgS, pgT, PresentedGroup.of, map_mul, map_pow, map_inv] using
    PresentedGroup.one_of_mem h

theorem pgS_sq_eq : pgS ^ 2 = (pgS * pgT) ^ 3 := by
  have h := pgS_sq_mul_inv
  rwa [mul_inv_eq_one] at h

/-- The images of the two generators in `SL(2, ℤ)`. -/
def gens : Fin 2 → Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  fun i => if i = 0 then ModularGroup.S else ModularGroup.T

theorem gens_zero : gens 0 = ModularGroup.S := by simp [gens]
theorem gens_one : gens 1 = ModularGroup.T := by simp [gens]

theorem phi_rel (r : FreeGroup (Fin 2)) (hr : r ∈ relSL) : FreeGroup.lift gens r = 1 := by
  rw [relSL, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with h | h
  · rw [h]
    show FreeGroup.lift gens (FreeGroup.of (0 : Fin 2) ^ (4 : ℕ)) = 1
    rw [map_pow, FreeGroup.lift_apply_of, gens_zero]
    decide
  · rw [h]
    show FreeGroup.lift gens (FreeGroup.of (0 : Fin 2) ^ (2 : ℕ) *
      ((FreeGroup.of (0 : Fin 2) * FreeGroup.of (1 : Fin 2)) ^ (3 : ℕ))⁻¹) = 1
    rw [map_mul, map_pow, map_inv, map_pow, map_mul, FreeGroup.lift_apply_of,
      FreeGroup.lift_apply_of, gens_zero, gens_one]
    rw [mul_inv_eq_one]
    decide

/-- The canonical map `⟨S, T | S ^ 4 = 1, S ^ 2 = (S * T) ^ 3⟩ →* SL(2, ℤ)`. -/
def phi : PresSL →* Matrix.SpecialLinearGroup (Fin 2) ℤ := PresentedGroup.toGroup phi_rel

theorem phi_pgS : phi pgS = ModularGroup.S := by
  rw [phi, pgS, PresentedGroup.toGroup.of, gens_zero]

theorem phi_pgT : phi pgT = ModularGroup.T := by
  rw [phi, pgT, PresentedGroup.toGroup.of, gens_one]

theorem phi_range_eq_top : phi.range = ⊤ := by
  rw [eq_top_iff, ← SpecialLinearGroup.SL2Z_generators, Subgroup.closure_le]
  intro x hx
  rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact ⟨pgS, phi_pgS⟩
  · exact ⟨pgT, phi_pgT⟩

theorem phi_surjective : Function.Surjective phi := by
  intro x
  have h : x ∈ phi.range := by rw [phi_range_eq_top]; exact Subgroup.mem_top x
  exact h

/-! ### The central element `c = S ^ 2 = (S * T) ^ 3` -/

/-- The element `c = S ^ 2 = (S * T) ^ 3` of `PresSL`. -/
def c : PresSL := pgS ^ 2

theorem c_eq : c = (pgS * pgT) ^ 3 := pgS_sq_eq

theorem c_mul_self : c * c = 1 := by
  have h : c * c = pgS ^ 4 := by rw [c]; group
  rw [h, pgS_pow_four]

theorem c_inv : c⁻¹ = c := inv_eq_of_mul_eq_one_right c_mul_self

/-- The subgroup generated by the two generators. -/
theorem closure_pgS_pgT : Subgroup.closure ({pgS, pgT} : Set PresSL) = ⊤ := by
  have h := PresentedGroup.closure_range_of relSL
  have hrange : Set.range (PresentedGroup.of : Fin 2 → PresSL) = {pgS, pgT} := by
    ext x
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff, pgS, pgT]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i
      · exact Or.inl rfl
      · exact Or.inr rfl
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  rwa [hrange] at h

theorem closure_pgS_pgST : Subgroup.closure ({pgS, pgS * pgT} : Set PresSL) = ⊤ := by
  have hT : pgT ∈ Subgroup.closure ({pgS, pgS * pgT} : Set PresSL) := by
    have hx : pgS⁻¹ ∈ Subgroup.closure ({pgS, pgS * pgT} : Set PresSL) :=
      Subgroup.inv_mem _ (Subgroup.subset_closure (by simp))
    have hy : pgS * pgT ∈ Subgroup.closure ({pgS, pgS * pgT} : Set PresSL) :=
      Subgroup.subset_closure (by simp)
    have h := Subgroup.mul_mem _ hx hy
    rwa [show pgS⁻¹ * (pgS * pgT) = pgT from by group] at h
  rw [eq_top_iff, ← closure_pgS_pgT, Subgroup.closure_le]
  intro y hy
  rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
  rcases hy with rfl | rfl
  · exact Subgroup.subset_closure (by simp)
  · exact hT

theorem c_comm (x : PresSL) : x * c = c * x := by
  have hle : Subgroup.closure ({pgS, pgS * pgT} : Set PresSL) ≤
      Subgroup.centralizer ({c} : Set PresSL) := by
    rw [Subgroup.closure_le]
    intro y hy
    change y ∈ Subgroup.centralizer ({c} : Set PresSL)
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    rw [Set.mem_singleton_iff] at hb
    subst hb
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with rfl | rfl
    · show c * pgS = pgS * c
      rw [c, ← pow_succ, ← pow_succ']
    · show c * (pgS * pgT) = (pgS * pgT) * c
      rw [c_eq, ← pow_succ, ← pow_succ']
  have hx : x ∈ Subgroup.centralizer ({c} : Set PresSL) :=
    hle (by rw [closure_pgS_pgST]; exact Subgroup.mem_top x)
  rw [Subgroup.mem_centralizer_iff] at hx
  exact (hx c (Set.mem_singleton c)).symm

theorem c_conj (g : PresSL) : g * c * g⁻¹ = c := by
  rw [c_comm g, mul_assoc, mul_inv_cancel, mul_one]

theorem closure_c_mem (n : PresSL) (hn : n ∈ Subgroup.closure ({c} : Set PresSL)) :
    n = 1 ∨ n = c := by
  induction hn using Subgroup.closure_induction with
  | mem y hy => rw [Set.mem_singleton_iff] at hy; exact Or.inr hy
  | one => exact Or.inl rfl
  | mul a b ha hb iha ihb =>
      rcases iha with rfl | rfl <;> rcases ihb with rfl | rfl <;> simp [c_mul_self]
  | inv a ha iha => rcases iha with rfl | rfl <;> simp [c_inv]

instance instNormalClosureC : (Subgroup.closure ({c} : Set PresSL)).Normal where
  conj_mem := by
    intro n hn g
    rcases closure_c_mem n hn with h | h
    · subst h; simp
    · subst h; rw [c_conj g]; exact Subgroup.subset_closure (Set.mem_singleton c)

theorem normalClosure_c_eq :
    Subgroup.normalClosure ({c} : Set PresSL) = Subgroup.closure ({c} : Set PresSL) :=
  le_antisymm (Subgroup.normalClosure_le_normal Subgroup.subset_closure)
    Subgroup.closure_le_normalClosure

/-! ### Comparison with `PSL(2, ℤ)` -/

/-- The composite `PresSL →* PSL(2,ℤ)`. -/
def phiPSL : PresSL →* Matrix.ProjectiveSpecialLinearGroup (Fin 2) ℤ :=
  Work.Modular.PresGroup.psl.comp phi

theorem phiPSL_pgS : phiPSL pgS = Work.Modular.PresGroup.psl ModularGroup.S := by
  rw [phiPSL, MonoidHom.comp_apply, phi_pgS]

theorem phiPSL_pgT : phiPSL pgT = Work.Modular.PresGroup.psl ModularGroup.T := by
  rw [phiPSL, MonoidHom.comp_apply, phi_pgT]

theorem phi_c : phi c = -1 := by
  rw [c, map_pow, phi_pgS]
  decide

theorem phiPSL_c : phiPSL c = 1 := by
  rw [phiPSL, MonoidHom.comp_apply, phi_c, Work.Modular.PresGroup.psl_neg_one]

/-- The normal closure of `c` in `PresSL`. -/
abbrev N : Subgroup PresSL := Subgroup.normalClosure ({c} : Set PresSL)

theorem hN : N ≤ phiPSL.ker := by
  apply Subgroup.normalClosure_le_normal
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact MonoidHom.mem_ker.mpr phiPSL_c

/-- The quotient map `PresSL → PresSL ⧸ N`. -/
abbrev qN : PresSL →* PresSL ⧸ N := QuotientGroup.mk' N

theorem qN_ker : qN.ker = N := by
  rw [show qN = QuotientGroup.mk' N from rfl]
  exact QuotientGroup.ker_mk' N

theorem qN_eq_one_iff (x : PresSL) : qN x = 1 ↔ x ∈ N := by
  rw [← MonoidHom.mem_ker, qN_ker]

/-- The induced map `PresSL ⧸ N →* PSL(2,ℤ)`. -/
abbrev psi : PresSL ⧸ N →* Matrix.ProjectiveSpecialLinearGroup (Fin 2) ℤ :=
  QuotientGroup.lift N phiPSL hN

theorem psi_qN (x : PresSL) : psi (qN x) = phiPSL x :=
  DFunLike.congr_fun (QuotientGroup.lift_comp_mk' N phiPSL hN) x

theorem psi_comp_qN : psi.comp qN = phiPSL := by
  apply MonoidHom.ext
  intro x
  rw [MonoidHom.comp_apply]
  exact psi_qN x

/-- The two generators of `Γ` mapped into `PresSL ⧸ N`. -/
def jF : Fin 2 → PresSL ⧸ N := Fin.cases (qN pgS) (fun _ => qN pgT)

theorem jF_zero : jF 0 = qN pgS := rfl
theorem jF_one : jF 1 = qN pgT := rfl

theorem j_rel (r : FreeGroup (Fin 2)) (hr : r ∈ Work.Modular.presentedRels) :
    FreeGroup.lift jF r = 1 := by
  rw [Work.Modular.presentedRels, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with h | h
  · rw [h]
    show FreeGroup.lift jF (FreeGroup.of (0 : Fin 2) ^ (2 : ℕ)) = 1
    rw [map_pow, FreeGroup.lift_apply_of, jF_zero]
    rw [← map_pow]
    change qN c = 1
    exact (qN_eq_one_iff c).mpr (Subgroup.subset_normalClosure (Set.mem_singleton c))
  · rw [h]
    show FreeGroup.lift jF ((FreeGroup.of (0 : Fin 2) * FreeGroup.of (1 : Fin 2)) ^ (3 : ℕ)) = 1
    rw [map_pow, map_mul, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of, jF_zero, jF_one]
    rw [← map_mul, ← map_pow]
    rw [show (pgS * pgT) ^ 3 = c from c_eq.symm]
    exact (qN_eq_one_iff c).mpr (Subgroup.subset_normalClosure (Set.mem_singleton c))

/-- The map `Γ = ⟨S, T | S² = (ST)³ = 1⟩ →* PresSL ⧸ N` on generators. -/
def j : Work.Modular.Gamma →* PresSL ⧸ N := PresentedGroup.toGroup j_rel

theorem j_genS : j Work.Modular.genS = qN pgS := by
  show PresentedGroup.toGroup j_rel (PresentedGroup.of (0 : Fin 2)) = qN pgS
  rw [PresentedGroup.toGroup.of, jF_zero]

theorem j_genT : j Work.Modular.genT = qN pgT := by
  show PresentedGroup.toGroup j_rel (PresentedGroup.of (1 : Fin 2)) = qN pgT
  rw [PresentedGroup.toGroup.of, jF_one]

/-- The classical isomorphism `Γ ≃* PSL(2,ℤ)`. -/
def eEquiv : Work.Modular.Gamma ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) ℤ :=
  Work.Modular.PresGroup.gammaEquivFP.trans Work.Modular.PresGroup.PsiEquiv

theorem e_genS : eEquiv Work.Modular.genS = Work.Modular.PresGroup.psl ModularGroup.S := by
  have h1 : Work.Modular.PresGroup.gammaEquivFP Work.Modular.genS
      = Work.Modular.PresGroup.gC2 := Work.Modular.PresGroup.toFree_genS
  change Work.Modular.PresGroup.PsiEquiv
      (Work.Modular.PresGroup.gammaEquivFP Work.Modular.genS)
      = Work.Modular.PresGroup.psl ModularGroup.S
  rw [h1]
  change Work.Modular.PresGroup.Psi Work.Modular.PresGroup.gC2 = _
  rw [Work.Modular.PresGroup.Psi_gC2']

theorem e_genT : eEquiv Work.Modular.genT = Work.Modular.PresGroup.psl ModularGroup.T := by
  have h1 : Work.Modular.PresGroup.gammaEquivFP Work.Modular.genT
      = Work.Modular.PresGroup.gC2 * Work.Modular.PresGroup.gC3 :=
    Work.Modular.PresGroup.toFree_genT
  change Work.Modular.PresGroup.PsiEquiv
      (Work.Modular.PresGroup.gammaEquivFP Work.Modular.genT)
      = Work.Modular.PresGroup.psl ModularGroup.T
  rw [h1]
  change Work.Modular.PresGroup.Psi
      (Work.Modular.PresGroup.gC2 * Work.Modular.PresGroup.gC3) = _
  rw [map_mul, Work.Modular.PresGroup.Psi_gC2', Work.Modular.PresGroup.Psi_gC3', ← map_mul]
  rw [show (ModularGroup.S * (ModularGroup.S * ModularGroup.T) :
      Matrix.SpecialLinearGroup (Fin 2) ℤ) = -ModularGroup.T from by decide]
  exact Work.Modular.PresGroup.psl_neg ModularGroup.T

theorem psi_comp_j : psi.comp j = eEquiv := by
  apply PresentedGroup.ext
  intro x
  fin_cases x
  · show psi (j Work.Modular.genS) = eEquiv Work.Modular.genS
    rw [j_genS, psi_qN, phiPSL_pgS, e_genS]
  · show psi (j Work.Modular.genT) = eEquiv Work.Modular.genT
    rw [j_genT, psi_qN, phiPSL_pgT, e_genT]

theorem j_surjective : Function.Surjective j := by
  intro z
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N z
  have hy : y ∈ Subgroup.closure ({pgS, pgT} : Set PresSL) := by
    rw [closure_pgS_pgT]; exact Subgroup.mem_top y
  have hle : Subgroup.closure ({pgS, pgT} : Set PresSL) ≤ (j.range).comap qN := by
    rw [Subgroup.closure_le]
    intro w hw
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    rcases hw with rfl | rfl
    · change qN pgS ∈ j.range
      exact ⟨Work.Modular.genS, j_genS⟩
    · change qN pgT ∈ j.range
      exact ⟨Work.Modular.genT, j_genT⟩
  have h : y ∈ (j.range).comap qN := hle hy
  rwa [Subgroup.mem_comap] at h

theorem psi_injective : Function.Injective psi := by
  intro a b hab
  obtain ⟨a', rfl⟩ := j_surjective a
  obtain ⟨b', rfl⟩ := j_surjective b
  have ha : psi (j a') = eEquiv a' := DFunLike.congr_fun psi_comp_j a'
  have hb : psi (j b') = eEquiv b' := DFunLike.congr_fun psi_comp_j b'
  have heq : eEquiv a' = eEquiv b' := by
    rw [← ha, ← hb]
    exact hab
  exact congrArg j (eEquiv.injective heq)

theorem ker_phiPSL : phiPSL.ker = N := by
  apply le_antisymm
  · intro x hx
    have hx' : phiPSL x = 1 := MonoidHom.mem_ker.mp hx
    have h1 : psi (qN x) = 1 := by rw [psi_qN, hx']
    have h2 : qN x = 1 := psi_injective (by rw [h1, map_one])
    exact (qN_eq_one_iff x).mp h2
  · intro x hx
    have h1 : qN x = 1 := (qN_eq_one_iff x).mpr hx
    rw [MonoidHom.mem_ker, ← psi_qN, h1, map_one]

theorem phi_ker_trivial (x : PresSL) (hx : phi x = 1) : x = 1 := by
  have hx1 : x ∈ phiPSL.ker := by
    rw [MonoidHom.mem_ker, phiPSL, MonoidHom.comp_apply, hx, map_one]
  have hx2 : x ∈ N := by rw [← ker_phiPSL]; exact hx1
  have hx3 : x ∈ Subgroup.closure ({c} : Set PresSL) := by
    rw [← normalClosure_c_eq]
    exact hx2
  rcases closure_c_mem x hx3 with h | h
  · exact h
  · exfalso
    rw [h, phi_c] at hx
    exact absurd hx (by decide)

theorem phi_injective : Function.Injective phi := by
  intro a b hab
  have h : phi (a * b⁻¹) = 1 := by rw [map_mul, hab, map_inv, mul_inv_cancel]
  have h1 := phi_ker_trivial (a * b⁻¹) h
  rwa [mul_inv_eq_one] at h1

/-- **The classical presentation of `SL(2, ℤ)`**: the canonical map from
`⟨S, T | S ^ 4 = 1, S ^ 2 = (S * T) ^ 3⟩` to `SL(2, ℤ)` is an isomorphism. -/
def phiEquiv : PresSL ≃* Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  MulEquiv.ofBijective phi ⟨phi_injective, phi_surjective⟩

/-! ### The universal property -/

/-- The universal property of the classical presentation, for group targets. -/
theorem SL2Z_lift_group (G : Type*) [Group G] (s t : G) (hs : s ^ 4 = 1)
    (hst : s ^ 2 = (s * t) ^ 3) :
    ∃ f : Matrix.SpecialLinearGroup (Fin 2) ℤ →* G,
      f ModularGroup.S = s ∧ f ModularGroup.T = t := by
  let gensG : Fin 2 → G := fun i => if i = 0 then s else t
  have gensG_zero : gensG 0 = s := by simp [gensG]
  have gensG_one : gensG 1 = t := by simp [gensG]
  have hrel : ∀ r ∈ relSL, FreeGroup.lift gensG r = 1 := by
    intro r hr
    rw [relSL, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
    rcases hr with h | h
    · rw [h]
      show FreeGroup.lift gensG (FreeGroup.of (0 : Fin 2) ^ (4 : ℕ)) = 1
      rw [map_pow, FreeGroup.lift_apply_of, gensG_zero]
      exact hs
    · rw [h]
      show FreeGroup.lift gensG (FreeGroup.of (0 : Fin 2) ^ (2 : ℕ) *
        ((FreeGroup.of (0 : Fin 2) * FreeGroup.of (1 : Fin 2)) ^ (3 : ℕ))⁻¹) = 1
      simp only [map_mul, map_pow, map_inv, FreeGroup.lift_apply_of, gensG_zero, gensG_one]
      rw [mul_inv_eq_one]
      exact hst
  let g : PresSL →* G := PresentedGroup.toGroup hrel
  have gS : g pgS = s := by
    change PresentedGroup.toGroup hrel pgS = s
    rw [pgS, PresentedGroup.toGroup.of]
    exact gensG_zero
  have gT : g pgT = t := by
    change PresentedGroup.toGroup hrel pgT = t
    rw [pgT, PresentedGroup.toGroup.of]
    exact gensG_one
  refine ⟨g.comp phiEquiv.symm, ?_, ?_⟩
  · rw [MonoidHom.comp_apply]
    have h : (↑phiEquiv.symm : Matrix.SpecialLinearGroup (Fin 2) ℤ →* PresSL)
        ModularGroup.S = pgS := by
      rw [← phi_pgS]
      exact MulEquiv.symm_apply_apply phiEquiv pgS
    rw [h, gS]
  · rw [MonoidHom.comp_apply]
    have h : (↑phiEquiv.symm : Matrix.SpecialLinearGroup (Fin 2) ℤ →* PresSL)
        ModularGroup.T = pgT := by
      rw [← phi_pgT]
      exact MulEquiv.symm_apply_apply phiEquiv pgT
    rw [h, gT]

end

/-! ### The universal property for monoid targets -/

/-- For any monoid `X` and elements `s t : X` satisfying the two relations `s ^ 4 = 1` and
`s ^ 2 = (s * t) ^ 3` of the standard presentation
`SL(2,ℤ) = ⟨S, T | S ^ 4 = 1, S ^ 2 = (S * T) ^ 3⟩`, there is a monoid homomorphism
`SL(2,ℤ) →* X` sending `S` to `s` and `T` to `t`.  This is the universal property of the
classical presentation of `SL(2,ℤ)` (equivalently: `SL(2,ℤ) = ℤ/4 *_{ℤ/2} ℤ/6` is the
amalgamated product of `⟨S⟩` and `⟨S * T⟩` over their intersection `⟨S^2⟩`).  The relator
`(S * T) ^ 6 = 1` is derivable: `(S*T)^6 = (S^2)^2 = S^4 = 1`. -/
theorem SL2Z_lift {X : Type*} [Monoid X] (s t : X) (hs : s ^ 4 = 1)
    (hst : s ^ 2 = (s * t) ^ 3) :
    ∃ f : Matrix.SpecialLinearGroup (Fin 2) ℤ →* X,
      f ModularGroup.S = s ∧ f ModularGroup.T = t := by
  have hs1 : s * s ^ 3 = 1 := by rw [← pow_succ']; exact hs
  have hs2 : s ^ 3 * s = 1 := by rw [← pow_succ]; exact hs
  have hu3 : (s * t) ^ 3 = s ^ 2 := hst.symm
  have hu6 : (s * t) ^ 6 = 1 := by
    calc (s * t) ^ 6 = ((s * t) ^ 3) ^ 2 := by
          rw [show (6 : ℕ) = 3 * 2 from rfl, pow_mul]
      _ = (s ^ 2) ^ 2 := by rw [hu3]
      _ = s ^ 4 := by rw [← pow_mul]
      _ = 1 := hs
  have hu1 : (s * t) * ((s * t) ^ 2 * s ^ 2) = 1 := by
    calc (s * t) * ((s * t) ^ 2 * s ^ 2)
        = ((s * t) * (s * t) ^ 2) * s ^ 2 := by rw [← mul_assoc]
      _ = (s * t) ^ 3 * s ^ 2 := by rw [← pow_succ']
      _ = s ^ 2 * s ^ 2 := by rw [hu3]
      _ = s ^ (2 + 2) := by rw [← pow_add]
      _ = 1 := hs
  have hu2 : ((s * t) ^ 2 * s ^ 2) * (s * t) = 1 := by
    calc ((s * t) ^ 2 * s ^ 2) * (s * t)
        = (s * t) ^ 2 * (s ^ 2 * (s * t)) := by rw [mul_assoc]
      _ = (s * t) ^ 2 * ((s * t) ^ 3 * (s * t)) := by rw [← hu3]
      _ = (s * t) ^ 2 * (s * t) ^ 4 := by rw [← pow_succ]
      _ = (s * t) ^ (2 + 4) := by rw [← pow_add]
      _ = 1 := hu6
  have ht_eq : t = s ^ 3 * (s * t) := by
    rw [← mul_assoc, ← pow_succ, hs, one_mul]
  let sp : Xˣ := ⟨s, s ^ 3, hs1, hs2⟩
  let up : Xˣ := ⟨s * t, (s * t) ^ 2 * s ^ 2, hu1, hu2⟩
  let tp : Xˣ := sp ^ 3 * up
  have hsp : (sp : X) = s := rfl
  have hup : (up : X) = s * t := rfl
  have htp : (tp : X) = t := by
    change ((sp ^ 3 * up : Xˣ) : X) = t
    rw [Units.val_mul, Units.val_pow_eq_pow_val, hsp, hup]
    exact ht_eq.symm
  have h4 : sp ^ 4 = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, hsp, Units.val_one]
    exact hs
  have hrel : sp ^ 2 = (sp * tp) ^ 3 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, Units.val_mul, hsp, htp]
    exact hst
  obtain ⟨f', hf'S, hf'T⟩ := SL2Z_lift_group Xˣ sp tp h4 hrel
  refine ⟨(Units.coeHom X).comp f', ?_, ?_⟩
  · rw [MonoidHom.comp_apply, hf'S]
    exact hsp
  · rw [MonoidHom.comp_apply, hf'T]
    exact htp

end Work.GroupTheory
