import Mathlib
import Submission.Work.FunctionalEquations.Gap
import Submission.Work.FunctionalEquations.FourierExpansion
import Submission.Work.FunctionalEquations.FourierGaussian
import Submission.Work.FunctionalEquations.SummableSchwartzBasisSmul
import Submission.Work.FunctionalEquations.SlashFactorMul
import Submission.Work.FunctionalEquations.SummableExpansionTerms
import Submission.Work.Summability.exists_schwartz_tsum

/-!
# The third functional equation for the Fourier expansions, `k₀` general

This file proves that the pair `(𝓕_x F̃, 𝓕_x F)`, where `𝓕_x F` and `𝓕_x F̃` are the
Dirichlet series with the *Fourier transforms* of the coefficients given by the expansions
(`Work.FE.fourierExpansionGen`, `Work.FE.fourierExpansionTildeGen`), satisfies the
Poisson-summation functional equation

`𝓕_x F̃(τ,x) + (i/τ)^{n/2} 𝓕_x F(-1/τ,x) = exp (π i τ ‖x‖²)`

of CKMRV Theorem 3.1 (v) whenever `Im τ > 0`.

The mathematical content is the paper's Section 8 step "apply `𝓕_x` to the functional
equations": the functional equation for `(F, F̃)` at `-1/τ` reads

`F(-1/τ,x) + (i/(-1/τ))^{n/2} F̃(τ,x) = exp (-π i ‖x‖²/τ)`,

and applying the Fourier transform in `x` turns `F(-1/τ,·)` into the Dirichlet series
`fourierExpansionGen (-1/τ)` and `F̃(τ,·)` into `fourierExpansionTildeGen τ`, while the
Gaussian transforms into `(i/(-1/τ))^{n/2} exp (π i τ ‖x‖²)`; multiplying by the slash
factor `(i/τ)^{n/2}` and using `slashFactor n τ * slashFactor n (-1/τ) = 1`
(`Work.FunctionalEquations.SlashFactorMul`) gives the identity.

The technical input is that the Dirichlet series of the expansions converge *in the
Schwartz space* and that their Fourier transforms are the corresponding series of Fourier
transforms.  That is `exists_schwartz_of_expansionData` below:
`Work.FunctionalEquations.SummableSchwartzBasisSmul` turns the polynomial growth of the
radial seminorms of the coefficients (the last field of `ExpansionDataGen`) into
summability of all Schwartz seminorms of the terms, `Work.Summability.exists_schwartz_tsum`
produces the sum, and continuity of the Fourier transform and of evaluation at a point
gives the values and the transform.

## Main result

* `Work.FunctionalEquations.FourierExpansionFunctionalEquation`
-/

namespace Work.FunctionalEquations

open LeanEval.Analysis.CKMRVInterpolation Work.Core Work.FE Filter Topology
open scoped FourierTransform SchwartzMap

noncomputable section

/-- Evaluation at a point, as a continuous linear functional on the complex Schwartz
space (the Schwartz topology is generated by the seminorms, and
`‖f y‖ ≤ seminorm 0 0 f`). -/
def schwartzEvalCLM {n : ℕ} [NeZero n] (y : E n) : 𝓢(E n, ℂ) →L[ℂ] ℂ :=
  SchwartzMap.mkCLMtoNormedSpace (fun f => f y)
    (by intro f g; rw [add_apply])
    (by intro a f; simp only [smul_apply, smul_eq_mul, RingHom.id_apply])
    ⟨{(0, 0)}, 1, zero_le_one, fun f => by
      rw [Finset.sup_singleton, one_mul]
      exact SchwartzMap.norm_le_seminorm ℂ f y⟩

@[simp] lemma schwartzEvalCLM_apply {n : ℕ} [NeZero n] (y : E n) (f : 𝓢(E n, ℂ)) :
    schwartzEvalCLM y f = f y := rfl

/-- The Dirichlet term has norm `t ^ m` with `t = exp (-2 π Im τ)`. -/
lemma norm_dirichletTerm_pow (m : ℕ) (τ : ℂ) :
    ‖dirichletTerm m τ‖ = Real.exp (-(2 * Real.pi * τ.im)) ^ m := by
  rw [normDirichletTermAux, ← Real.exp_nat_mul]
  congr 1
  ring

/-- **A Dirichlet series with polynomially growing Schwartz coefficients converges in the
Schwartz space, and its Fourier transform is the corresponding series of Fourier
transforms.**

Given a coefficient family `c : Set.Ici k₀ → ℂ` with `‖c m‖ ≤ K (m+1)^N`, the family
`m ↦ (c m * e^{2π i m τ}) • basis (m,j)` is summable in the Schwartz space (exponential
decay beats polynomial growth), and for its sum `H`:

* the values of `H` are the pointwise series, and
* the values of `𝓕 H` are the pointwise series of the Fourier transforms
  `∑_m c_m e^{2π i m τ} (𝓕 (basis (m,j))) y`. -/
lemma exists_schwartz_dirichletSeries {n : ℕ} [NeZero n] {k₀ : ℕ}
    (basis : SampleIdx k₀ → RSch n)
    (hgrowth : ∀ k ℓ : ℕ, ∃ C : ℝ, ∃ N : ℕ, 0 ≤ C ∧
      ∀ (m : Set.Ici k₀) (j : Fin 4) (x : E n),
        ‖x‖ ^ k * ‖radialDeriv ℓ (⇑(basis (m, j)).1) x‖ ≤ C * ((m.1 : ℝ) + 1) ^ N)
    (j : Fin 4) (τ : ℂ) (hτ : 0 < τ.im) {K : ℝ} {N : ℕ} (hK : 0 ≤ K)
    (c : Set.Ici k₀ → ℂ) (hc : ∀ m : Set.Ici k₀, ‖c m‖ ≤ K * ((m.1 : ℝ) + 1) ^ N) :
    ∃ H : 𝓢(E n, ℂ),
      (∀ x, H x = ∑' m : Set.Ici k₀, c m * dirichletTerm m.1 τ * (basis (m, j)).1 x) ∧
      (∀ y, (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ)) H) y
        = ∑' m : Set.Ici k₀, c m * dirichletTerm m.1 τ
            * (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ)) (basis (m, j)).1) y) := by
  set t : ℝ := Real.exp (-(2 * Real.pi * τ.im)) with ht
  have ht0 : 0 ≤ t := (Real.exp_pos _).le
  have ht1 : t < 1 := by
    rw [ht, Real.exp_lt_one_iff]
    nlinarith [Real.pi_pos, hτ]
  have hcd : ∀ m : Set.Ici k₀,
      ‖c m * dirichletTerm m.1 τ‖ ≤ K * ((m.1 : ℝ) + 1) ^ N * t ^ (m.1) := by
    intro m
    rw [norm_mul, norm_dirichletTerm_pow]
    exact mul_le_mul_of_nonneg_right (hc m) (pow_nonneg ht0 _)
  have hsum : ∀ k l : ℕ, Summable fun m : Set.Ici k₀ =>
      (SchwartzMap.seminorm ℂ k l) ((c m * dirichletTerm m.1 τ) • (basis (m, j)).1) :=
    SummableSchwartzBasisSmul basis hgrowth hK ht0 ht1 hcd j
  refine ⟨Work.Summability.schwartzSum _ hsum, ?_, ?_⟩
  · intro x
    rw [Work.Summability.schwartzSum_apply]
    exact tsum_congr fun m => by rw [smul_apply, smul_eq_mul]
  · intro y
    have hHas : HasSum (fun m : Set.Ici k₀ => (c m * dirichletTerm m.1 τ) • (basis (m, j)).1)
        (Work.Summability.schwartzSum _ hsum) := Work.Summability.hasSum_schwartzSum _ hsum
    have h1 : HasSum (fun m : Set.Ici k₀ => FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ))
          ((c m * dirichletTerm m.1 τ) • (basis (m, j)).1))
        (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ)) (Work.Summability.schwartzSum _ hsum)) :=
      hHas.map _ (map_continuous _)
    have h2 := h1.map (schwartzEvalCLM y) (schwartzEvalCLM y).continuous
    have hcomp : (⇑(schwartzEvalCLM y) ∘ fun m : Set.Ici k₀ =>
        FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ))
          ((c m * dirichletTerm m.1 τ) • (basis (m, j)).1))
        = fun m => (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ))
          ((c m * dirichletTerm m.1 τ) • (basis (m, j)).1)) y :=
      funext fun m => by simp
    rw [hcomp] at h2
    rw [schwartzEvalCLM_apply] at h2
    rw [← h2.tsum_eq]
    exact tsum_congr fun m => by
      rw [map_smul, smul_apply, smul_eq_mul]

/-- **The expansions of `F` and `F̃` are Schwartz functions whose Fourier transforms are
the Dirichlet series `fourierExpansionGen`, `fourierExpansionTildeGen`.**

For `Im τ > 0` there are Schwartz functions `G`, `Gt` with `G x = F(τ,x)`,
`Gt x = F̃(τ,x)` for all `x`, and `(𝓕 G) y = fourierExpansionGen k₀ basis τ y`,
`(𝓕 Gt) y = fourierExpansionTildeGen k₀ basis τ y` for all `y`. -/
lemma exists_schwartz_of_expansionData {n : ℕ} [NeZero n] {k₀ : ℕ}
    (S : FunctionalEquationSolution n) (basis : SampleIdx k₀ → RSch n)
    (hExp : ExpansionDataGen n k₀ S basis) (τ : ℂ) (hτ : 0 < τ.im) :
    ∃ G Gt : 𝓢(E n, ℂ),
      (∀ x, G x = S.F τ x) ∧ (∀ x, Gt x = S.Ftilde τ x) ∧
      (∀ y, (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ)) G) y = fourierExpansionGen k₀ basis τ y) ∧
      (∀ y, (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ)) Gt) y
        = fourierExpansionTildeGen k₀ basis τ y) := by
  obtain ⟨hF, hFt, hD, hDt, hG⟩ := hExp
  obtain ⟨H0, hH0v, hH0f⟩ := exists_schwartz_dirichletSeries basis hG 0 τ hτ (K := 1) (N := 0)
    zero_le_one (fun _ => 1) (fun m => by simp)
  obtain ⟨H1, hH1v, hH1f⟩ := exists_schwartz_dirichletSeries basis hG 1 τ hτ (K := 1) (N := 0)
    zero_le_one (fun _ => 1) (fun m => by simp)
  obtain ⟨H2, hH2v, hH2f⟩ := exists_schwartz_dirichletSeries basis hG 2 τ hτ (K := 1) (N := 1)
    zero_le_one (fun m => (rate m.1 : ℂ)) (fun m => by
      have h0 : 0 ≤ rate m.1 := Real.sqrt_nonneg _
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0, pow_one, one_mul]
      exact rate_le_add_one m.1)
  obtain ⟨H3, hH3v, hH3f⟩ := exists_schwartz_dirichletSeries basis hG 3 τ hτ (K := 1) (N := 1)
    zero_le_one (fun m => (rate m.1 : ℂ)) (fun m => by
      have h0 : 0 ≤ rate m.1 := Real.sqrt_nonneg _
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0, pow_one, one_mul]
      exact rate_le_add_one m.1)
  refine ⟨H0 + (2 * (Real.pi : ℂ) * Complex.I * τ) • H2,
          H1 + (2 * (Real.pi : ℂ) * Complex.I * τ) • H3, ?_, ?_, ?_, ?_⟩
  · intro x
    rw [add_apply, smul_apply, smul_eq_mul, hH0v x, hH2v x, hF τ x hτ]
    congr 1
    · exact tsum_congr fun m => by ring
    · congr 1
      exact tsum_congr fun m => by ring
  · intro x
    rw [add_apply, smul_apply, smul_eq_mul, hH1v x, hH3v x, hFt τ x hτ]
    congr 1
    · exact tsum_congr fun m => by ring
    · congr 1
      exact tsum_congr fun m => by ring
  · intro y
    rw [map_add, map_smul, add_apply, smul_apply, smul_eq_mul, hH0f y, hH2f y, fourierExpansionGen]
    congr 1
    · exact tsum_congr fun m => by ring
    · congr 1
      exact tsum_congr fun m => by ring
  · intro y
    rw [map_add, map_smul, add_apply, smul_apply, smul_eq_mul, hH1f y, hH3f y, fourierExpansionTildeGen]
    congr 1
    · exact tsum_congr fun m => by ring
    · congr 1
      exact tsum_congr fun m => by ring

/-- `-1 / τ` is in the upper half plane when `τ` is. -/
lemma neg_one_div_im_pos {τ : ℂ} (hτ : 0 < τ.im) : 0 < (-1 / τ).im := by
  have hτ0 : τ ≠ 0 := by intro h; rw [h] at hτ; simp at hτ
  have h1 : (-1 / τ) = -(τ⁻¹) := by rw [div_eq_mul_inv]; ring
  rw [h1, Complex.neg_im, Complex.inv_im]
  have h2 : 0 < Complex.normSq τ := Complex.normSq_pos.mpr hτ0
  have h4 : 0 < τ.im / Complex.normSq τ := div_pos hτ h2
  simpa only [neg_div, neg_neg] using h4

/-- The modular involution is an involution: `-1 / (-1 / τ) = τ`. -/
lemma neg_one_div_neg_one_div (τ : ℂ) : -1 / (-1 / τ) = τ := by
  field_simp

/-- The Fourier transform of the Gaussian with parameter `-1/τ`, in terms of the slash
factor at `-1/τ`. -/
lemma fourier_gaussianFun_neg_inv {n : ℕ} [NeZero n] {τ : ℂ} (hτ : 0 < τ.im) (x : E n) :
    (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ))
        (Work.Core.gaussianSchwartz n (-1 / τ) (neg_one_div_im_pos hτ))) x
      = slashFactor n (-1 / τ) * Work.Core.gaussianFun n τ x := by
  rw [Work.Core.fourier_gaussianSchwartz n (-1 / τ) (neg_one_div_im_pos hτ) x,
    neg_one_div_neg_one_div τ]
  rfl

/-- **The functional equation for the Fourier expansions.**

For every solution `S` of the functional equations whose generating functions carry the
expansions `ExpansionDataGen`, the Dirichlet series obtained from the expansions by
transforming the coefficients satisfies the third functional equation: for `Im τ > 0`,

`𝓕_x F̃(τ,x) + (i/τ)^{n/2} 𝓕_x F(-1/τ,x) = exp (π i τ ‖x‖²)`.

This is the third conjunct of the paper's Section 8 statement that the Fourier transform
in `x` exchanges `F` and `F̃` while preserving the functional equations. -/
theorem FourierExpansionFunctionalEquation {n : ℕ} [NeZero n] {k₀ : ℕ}
    (S : FunctionalEquationSolution n) (basis : SampleIdx k₀ → RSch n)
    (hExp : ExpansionDataGen n k₀ S basis) :
    ∀ (τ : ℂ) (x : E n), 0 < τ.im →
      fourierExpansionTildeGen k₀ basis τ x
        + slashFactor n τ * fourierExpansionGen k₀ basis (-1 / τ) x
      = Work.Core.gaussianFun n τ x := by
  intro τ x hτ
  obtain ⟨G, Gt, -, hGtv, -, hGtf⟩ := exists_schwartz_of_expansionData S basis hExp τ hτ
  obtain ⟨G', -, hG'v, -, hG'f, -⟩ :=
    exists_schwartz_of_expansionData S basis hExp (-1 / τ) (neg_one_div_im_pos hτ)
  -- the functional equation for `(F, F̃)` at `-1/τ`, where `-1/(-1/τ) = τ`
  have hFE : ∀ z : E n, G' z + slashFactor n (-1 / τ) * Gt z
      = Work.Core.gaussianFun n (-1 / τ) z := by
    intro z
    have h := S.functional_equation (-1 / τ) z (neg_one_div_im_pos hτ)
    rw [neg_one_div_neg_one_div τ] at h
    rw [hG'v z, hGtv z]
    exact h
  -- the same identity between Schwartz functions
  have hEq : G' + (slashFactor n (-1 / τ)) • Gt
      = Work.Core.gaussianSchwartz n (-1 / τ) (neg_one_div_im_pos hτ) := by
    ext z
    simp only [add_apply, smul_apply, smul_eq_mul, Work.Core.gaussianSchwartz_apply]
    exact hFE z
  -- apply the Fourier transform and evaluate at `x`
  have hEq2 := congrArg (FourierTransform.fourierCLM ℂ (𝓢(E n, ℂ))) hEq
  rw [map_add, map_smul] at hEq2
  have hEq3 := congrArg (fun (f : 𝓢(E n, ℂ)) => f x) hEq2
  simp only [add_apply, smul_apply, smul_eq_mul] at hEq3
  rw [hG'f x, hGtf x, fourier_gaussianFun_neg_inv hτ x] at hEq3
  -- multiply by the slash factor at `τ` and use `(i/τ)^{n/2} (i/(-1/τ))^{n/2} = 1`
  have h5 := congrArg (fun z : ℂ => slashFactor n τ * z) hEq3
  rw [mul_add, ← mul_assoc, ← mul_assoc, SlashFactorMul (n := n) hτ, one_mul, one_mul] at h5
  exact (add_comm _ _).trans h5

end

end Work.FunctionalEquations
