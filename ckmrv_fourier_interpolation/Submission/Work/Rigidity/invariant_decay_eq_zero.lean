/-
# The weight-twelve rigidity lemma for `T`-invariant functions

This file proves `Work.Rigidity.invariant_decay_eq_zero`: a holomorphic function `f : ℍ → ℂ`
which is invariant under translation by `1`, satisfies the weight-twelve transformation law
`τ^{-12} f(-1/τ) = f τ` for `S`, and decays like `o(e^{-2π Im τ})` in the strip
`-1 ≤ Re τ ≤ 1`, vanishes identically.

This is the `ε = +1`, `k = 12`, `c = 1` instance of the paper's `lem:noPsolutions`
(CKMRV, *Universal optimality of the E8 and Leech lattices and interpolation formulas*,
Ann. of Math. 196 (2022)), in the special case in which `f` is annihilated by `T - 1`
rather than by `(T - 1)²`.

The proof has three steps.

* Since `f` is `1`-periodic and holomorphic, `S`-invariance together with `T`-invariance
  makes `f` a level-one modular form of weight `12` (`Work.Modular.modularForm_of_slash_invariant`,
  with `SL(2, ℤ)` generated by `S` and `T`).  The strip decay gives boundedness at `i∞`,
  using periodicity to reduce an arbitrary point of large imaginary part to one in the
  strip `-1 ≤ Re τ ≤ 1`.
* The `q`-expansion coefficients `a₀`, `a₁` of `f` at the cusp are written as period
  integrals (`UpperHalfPlane.qExpansion_coeff_eq_intervalIntegral`) along the horizontal
  line `Im = t`; the decay bound gives `‖a_n‖ ≤ φ t · e^{2π(n-1)t}` for every `t > 0`,
  which for `n = 0, 1` tends to `0` as `t → ∞`.  Hence `a₀ = a₁ = 0`.
* The Sturm bound for level-one modular forms
  (`ModularForm.sturm_bound_levelOne_nat`) then forces `f = 0`.
-/
import Mathlib
import Submission.Work.Rigidity.Basic
import Submission.Work.Rigidity.Diff
import Submission.Work.Modular.modularForm_of_slash_invariant

namespace Work.Rigidity

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle Topology

open Filter

noncomputable section

/-! ## Translating by integers -/

/-- Invariance under translation by a natural number, from invariance under `τ ↦ τ + 1`. -/
lemma vadd_nat_eq_of_vadd_one {f : ℍ → ℂ} (hT : ∀ τ : ℍ, f ((1 : ℝ) +ᵥ τ) = f τ)
    (n : ℕ) (τ : ℍ) : f ((n : ℝ) +ᵥ τ) = f τ := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [show (((n + 1 : ℕ) : ℝ)) +ᵥ τ = (1 : ℝ) +ᵥ ((n : ℝ) +ᵥ τ) by
      ext; simp [UpperHalfPlane.coe_vadd]; ring]
    rw [hT, ih]

/-- Invariance under translation by an integer. -/
lemma vadd_int_eq_of_vadd_one {f : ℍ → ℂ} (hT : ∀ τ : ℍ, f ((1 : ℝ) +ᵥ τ) = f τ)
    (m : ℤ) (τ : ℍ) : f ((m : ℝ) +ᵥ τ) = f τ := by
  rcases m with m | m
  · exact vadd_nat_eq_of_vadd_one hT m τ
  · have hcast : ((Int.negSucc m : ℤ) : ℝ) = -(((m + 1 : ℕ)) : ℝ) := by push_cast; ring
    rw [hcast]
    have hv : (((m + 1 : ℕ) : ℝ) +ᵥ ((-(((m + 1 : ℕ)) : ℝ)) +ᵥ τ) : ℍ) = τ := by
      rw [← add_vadd]; norm_num
    have h := vadd_nat_eq_of_vadd_one hT (m + 1) ((-(((m + 1 : ℕ)) : ℝ)) +ᵥ τ)
    rw [hv] at h
    exact h.symm

/-! ## Boundedness at the cusp from the strip decay -/

/-- The strip decay condition of `StripDecay c` (for `c ≥ 0`) together with invariance under
translation by `1` implies boundedness at `i∞`: an arbitrary point of large imaginary part is
translated by an integer so as to lie in the strip `-1 ≤ Re τ ≤ 1`. -/
lemma isBoundedAtImInfty_of_stripDecay {c : ℝ} (hc : 0 ≤ c) {f : ℍ → ℂ}
    (hT : ∀ τ : ℍ, f ((1 : ℝ) +ᵥ τ) = f τ) (hd : StripDecay c f) :
    IsBoundedAtImInfty f := by
  obtain ⟨φ, hφ, hφ'⟩ := hd
  obtain ⟨A₀, hA₀⟩ : ∃ A : ℝ, ∀ y ≥ A, φ y ≤ 1 := by
    have h1 : ∀ᶠ y in atTop, φ y ≤ 1 := by
      filter_upwards [hφ.eventually (Metric.ball_mem_nhds (0 : ℝ) one_pos)] with y hy
      have hy' : |φ y| < 1 := by simpa [Real.dist_eq, Real.norm_eq_abs] using hy
      exact (abs_lt.mp hy').2.le
    exact eventually_atTop.mp h1
  rw [isBoundedAtImInfty_iff]
  refine ⟨1, max A₀ 0, fun z hz => ?_⟩
  set n : ℤ := ⌊z.re⌋ with hn
  have hzre : z.re - (n : ℝ) = Int.fract z.re := by
    rw [hn, Int.self_sub_floor]
  have hfloor_le : (n : ℝ) ≤ z.re := by rw [hn]; exact Int.floor_le z.re
  have hfloor_lt : z.re < (n : ℝ) + 1 := by rw [hn]; exact Int.lt_floor_add_one z.re
  set σ : ℍ := ((-(n : ℝ)) +ᵥ z) with hσ
  have hσre : σ.re = z.re - (n : ℝ) := by rw [hσ, re_vadd]; ring
  have hσim : σ.im = z.im := by rw [hσ, im_vadd]
  have hin : InStrip σ := by
    refine ⟨?_, ?_⟩
    · rw [hσre]; linarith
    · rw [hσre]; linarith
  have hσim_ge : max A₀ 0 ≤ σ.im := by rw [hσim]; exact hz
  have hφσ : φ σ.im ≤ 1 := hA₀ σ.im (le_trans (le_max_left _ _) hσim_ge)
  have hσpos : 0 < σ.im := by rw [hσim]; exact z.im_pos
  have hexp : Real.exp (-(2 * Real.pi * c * σ.im)) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    have h0 : 0 ≤ σ.im := le_trans (le_max_right _ _) hσim_ge
    have : 0 ≤ 2 * Real.pi * c * σ.im := by positivity
    linarith
  have hfz : f z = f σ := by
    have h := vadd_int_eq_of_vadd_one hT (-n) z
    have hcast : ((-n : ℤ) : ℝ) = -(n : ℝ) := by push_cast; ring
    rw [hcast] at h
    rw [hσ]
    exact h.symm
  calc ‖f z‖ = ‖f σ‖ := by rw [hfz]
    _ ≤ φ σ.im * Real.exp (-(2 * Real.pi * c * σ.im)) := hφ' σ hin
    _ ≤ 1 * 1 := mul_le_mul hφσ hexp (Real.exp_nonneg _) zero_le_one
    _ = 1 := by norm_num

/-! ## The main theorem -/

theorem invariant_decay_eq_zero {f : ℍ → ℂ} (hhol : MDiff f)
    (hT : ∀ τ : ℍ, f ((1 : ℝ) +ᵥ τ) = f τ)
    (hS : ∀ τ : ℍ, (τ : ℂ) ^ (-12 : ℤ) * f (ModularGroup.S • τ) = f τ)
    (hd : Work.Rigidity.StripDecay 1 f) : f = 0 := by
  obtain ⟨φ, hφ, hφ'⟩ := hd
  -- The two generating slash relations.
  have hTslash : f ∣[(12 : ℤ)] ModularGroup.T = f := by
    funext z
    rw [ModularForm.slash_action_eq'_iff]
    have h10 : ((ModularGroup.T : SL(2, ℤ)) 1 0 : ℂ) = 0 := by simp [ModularGroup.coe_T]
    have h11 : ((ModularGroup.T : SL(2, ℤ)) 1 1 : ℂ) = 1 := by simp [ModularGroup.coe_T]
    rw [h10, h11, zero_mul, zero_add, _root_.one_zpow, one_mul,
      UpperHalfPlane.modular_T_smul]
    exact hT z
  have hSslash : f ∣[(12 : ℤ)] ModularGroup.S = f := by
    funext z
    rw [ModularForm.slash_action_eq'_iff]
    have h10 : ((ModularGroup.S : SL(2, ℤ)) 1 0 : ℂ) = 1 := by simp [ModularGroup.coe_S]
    have h11 : ((ModularGroup.S : SL(2, ℤ)) 1 1 : ℂ) = 0 := by simp [ModularGroup.coe_S]
    rw [h10, h11, one_mul, add_zero, ← hS z, ← mul_assoc,
      ← zpow_add₀ (coe_ne_zero z)]
    norm_num
  have hper : ∀ γ : SL(2, ℤ), f ∣[(12 : ℤ)] γ = f :=
    SlashInvariantForm.slash_action_generators_SL2Z hSslash hTslash
  -- `f` is a level-one modular form of weight `12`.
  have hbdd : IsBoundedAtImInfty f :=
    isBoundedAtImInfty_of_stripDecay zero_le_one hT ⟨φ, hφ, hφ'⟩
  obtain ⟨g, hg⟩ := Work.Modular.modularForm_of_slash_invariant (k := 12) hper hhol hbdd
  -- Bound on the `q`-expansion coefficients along the line `Im = t`.
  have hcol : ∀ (n : ℕ) (t : ℝ), 0 < t →
      ‖(UpperHalfPlane.qExpansion 1 (⇑g)).coeff n‖ ≤
        φ t * Real.exp (2 * Real.pi * (n : ℝ) * t) * Real.exp (-(2 * Real.pi * t)) := by
    intro n t ht
    rw [ModularFormClass.qExpansion_coeff_eq_intervalIntegral g one_pos
      one_mem_strictPeriods_SL n ht]
    simp only [Complex.ofReal_one, div_one, one_mul]
    refine le_trans (intervalIntegral.norm_integral_le_of_norm_le_const fun u hu => ?_)
      (le_of_eq (by rw [sub_zero, abs_one, mul_one] : _ = _))
    rw [Set.uIoc_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hu
    have hu1 : 0 < u := hu.1
    have hu2 : u ≤ 1 := hu.2
    have hzim : (((u : ℂ) + (t : ℂ) * Complex.I)).im = t := by
      simp [Complex.add_im, Complex.mul_im]
    have hzre : (((u : ℂ) + (t : ℂ) * Complex.I)).re = u := by
      simp [Complex.add_re, Complex.mul_re]
    set w : ℍ := ⟨(u : ℂ) + (t : ℂ) * Complex.I,
      by rw [hzim]; exact ht⟩ with hw
    have hwim : w.im = t := by rw [hw]; exact hzim
    have hwre : w.re = u := by rw [hw]; exact hzre
    have hstrip : InStrip w := ⟨by rw [hwre]; linarith, by rw [hwre]; linarith⟩
    have hgw : ‖g w‖ ≤ φ t * Real.exp (-(2 * Real.pi * t)) := by
      have h1 : ‖f w‖ ≤ φ w.im * Real.exp (-(2 * Real.pi * 1 * w.im)) := hφ' w hstrip
      rw [← hg] at h1
      calc ‖g w‖ ≤ φ w.im * Real.exp (-(2 * Real.pi * 1 * w.im)) := h1
        _ = φ t * Real.exp (-(2 * Real.pi * t)) := by rw [hwim]; ring_nf
    have hq : ‖1 / (Function.Periodic.qParam 1 ((u : ℂ) + (t : ℂ) * Complex.I)) ^ n‖ =
        Real.exp (2 * Real.pi * (n : ℝ) * t) := by
      rw [norm_div, norm_one, norm_pow, Function.Periodic.norm_qParam]
      simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
        Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, div_one]
      rw [← Real.exp_nat_mul, one_div, ← Real.exp_neg]
      congr 1
      ring
    rw [norm_mul, hq]
    calc Real.exp (2 * Real.pi * (n : ℝ) * t) * ‖g w‖
        ≤ Real.exp (2 * Real.pi * (n : ℝ) * t) * (φ t * Real.exp (-(2 * Real.pi * t))) :=
          mul_le_mul_of_nonneg_left hgw (Real.exp_nonneg _)
      _ = φ t * Real.exp (2 * Real.pi * (n : ℝ) * t) * Real.exp (-(2 * Real.pi * t)) := by
          ring
  -- The zeroth and first coefficients vanish.
  have hlim0 : Tendsto
      (fun t : ℝ => φ t * Real.exp (2 * Real.pi * ((0 : ℕ) : ℝ) * t) *
        Real.exp (-(2 * Real.pi * t))) atTop (𝓝 0) := by
    have hexp : Tendsto (fun t : ℝ => Real.exp (-(2 * Real.pi * t))) atTop (𝓝 0) := by
      have harg : Tendsto (fun t : ℝ => -(2 * Real.pi * t)) atTop atBot := by
        rw [tendsto_atBot]
        intro b
        filter_upwards [eventually_ge_atTop (max 0 (-b / (2 * Real.pi)))] with t htb
        have hb : -b / (2 * Real.pi) ≤ t := le_trans (le_max_right _ _) htb
        have hmul : 2 * Real.pi * (-b / (2 * Real.pi)) ≤ 2 * Real.pi * t :=
          mul_le_mul_of_nonneg_left hb (by positivity)
        have hsimp : 2 * Real.pi * (-b / (2 * Real.pi)) = -b := by
          field_simp
        rw [hsimp] at hmul
        linarith
      exact Real.tendsto_exp_atBot.comp harg
    have hmid : Tendsto
        (fun t : ℝ => φ t * Real.exp (2 * Real.pi * ((0 : ℕ) : ℝ) * t)) atTop (𝓝 0) := by
      have h1 : Tendsto (fun t : ℝ => Real.exp (2 * Real.pi * ((0 : ℕ) : ℝ) * t))
          atTop (𝓝 1) := by simp
      simpa using hφ.mul h1
    have := hmid.mul hexp
    simpa using this
  have hc0 : (UpperHalfPlane.qExpansion 1 (⇑g)).coeff 0 = 0 := by
    have hle : ‖(UpperHalfPlane.qExpansion 1 (⇑g)).coeff 0‖ ≤ 0 := by
      refine le_of_tendsto_of_tendsto tendsto_const_nhds hlim0 ?_
      filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht
      exact hcol 0 t ht
    exact norm_eq_zero.mp (le_antisymm hle (norm_nonneg _))
  have hc1 : (UpperHalfPlane.qExpansion 1 (⇑g)).coeff 1 = 0 := by
    have hC : ∀ t : ℝ,
        φ t * Real.exp (2 * Real.pi * ((1 : ℕ) : ℝ) * t) * Real.exp (-(2 * Real.pi * t)) =
          φ t := by
      intro t
      have harg : 2 * Real.pi * ((1 : ℕ) : ℝ) * t + -(2 * Real.pi * t) = 0 := by ring
      rw [mul_assoc, ← Real.exp_add, harg, Real.exp_zero, mul_one]
    have hle : ‖(UpperHalfPlane.qExpansion 1 (⇑g)).coeff 1‖ ≤ 0 := by
      have hlim : Tendsto
          (fun t : ℝ => φ t * Real.exp (2 * Real.pi * ((1 : ℕ) : ℝ) * t) *
            Real.exp (-(2 * Real.pi * t))) atTop (𝓝 0) := by
        simpa only [hC] using hφ
      refine le_of_tendsto_of_tendsto tendsto_const_nhds hlim ?_
      filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht
      exact hcol 1 t ht
    exact norm_eq_zero.mp (le_antisymm hle (norm_nonneg _))
  -- Sturm bound.
  have horder : (1 : ℕ∞) < (UpperHalfPlane.qExpansion 1 (⇑g)).order := by
    have h2 : ((2 : ℕ) : ℕ∞) ≤ (UpperHalfPlane.qExpansion 1 (⇑g)).order :=
      PowerSeries.nat_le_order _ 2 (by
        intro i hi
        interval_cases i
        · exact hc0
        · exact hc1)
    exact lt_of_lt_of_le (by norm_num) h2
  have hg0 : g = 0 := ModularForm.sturm_bound_levelOne_nat (k := 12) (by simpa using horder)
  rw [← hg, hg0]
  simp

end

end Work.Rigidity
