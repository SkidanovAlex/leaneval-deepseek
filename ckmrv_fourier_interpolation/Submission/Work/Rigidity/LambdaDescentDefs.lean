/-
# The Hauptmodul property of the modular lambda function

This file records, as a `Prop`-valued definition, the classical fact that
`λ = θ₁₀⁴/θ₀₀⁴ = Work.Kernels.lambdaFun` is a Hauptmodul for `Γ(2)`: every holomorphic
`Γ(2)`-invariant function on `ℍ` factors through `λ` by a function holomorphic away from
`{0,1}`.  The point of the definition is that the factorization statement can then be
delegated without notation friction.
-/
import Mathlib
import Submission.Work.Kernels.Classical

noncomputable section

open UpperHalfPlane ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle Topology

namespace Work.Rigidity

/-- **The Hauptmodul property of `λ`.**  Every holomorphic `Γ(2)`-invariant function `F` on
`ℍ` is `R ∘ λ` for a function `R : ℂ → ℂ` which is holomorphic off `{0,1}`. -/
def LambdaDescent : Prop :=
  ∀ F : ℍ → ℂ, MDiff F →
    (∀ γ ∈ CongruenceSubgroup.Gamma 2, ∀ τ : ℍ, F (γ • τ) = F τ) →
    ∃ R : ℂ → ℂ, DifferentiableOn ℂ R {z : ℂ | z ≠ 0 ∧ z ≠ 1} ∧
      ∀ τ : ℍ, F τ = R (Work.Kernels.lambdaFun τ)

end Work.Rigidity

namespace Work.Rigidity

/-- `Γ(2)` (the principal congruence subgroup of level two) is generated by the two
parabolic elements `T²` and `S T² S` together with `-I = S²`.  (The two parabolics alone
generate the index-two subgroup `Γ(2) ∩ SL(2,ℤ)_{≡1 mod 4}`; the central `-I` is needed.) -/
def Gamma2Generators : Prop :=
  CongruenceSubgroup.Gamma 2 = Subgroup.closure
    ({ModularGroup.T * ModularGroup.T,
      ModularGroup.S * (ModularGroup.T * ModularGroup.T) * ModularGroup.S,
      ModularGroup.S * ModularGroup.S} : Set SL(2,ℤ))

end Work.Rigidity

namespace Work.Rigidity

/-- Near the cusp `i∞`, the modular lambda function `λ = θ₁₀⁴/θ₀₀⁴` is a local
biholomorphism onto a punctured neighbourhood of `0`: the image of the region `Im τ > 1`
contains a punctured disc around `0`. -/
def LambdaLocalSurjective : Prop :=
  ∃ δ : ℝ, 0 < δ ∧ ∀ w : ℂ, w ≠ 0 → ‖w‖ < δ →
    ∃ τ : ℍ, 1 < τ.im ∧ Work.Kernels.lambdaFun τ = w

end Work.Rigidity

namespace Work.Rigidity

/-- **The weight-zero rigidity core.** A holomorphic function on `ℍ` which is invariant under
translation by `1`, satisfies the weight-zero trace relation
`F τ + F (S • τ) + F (S • (τ+1)) = 0` and decays like `o(e^{-2π Im τ})` at the cusp vanishes.
This is the paper's `lem:noPsolutions` in the weight-zero normalisation (the
`(T-I)²`/`S`-eigenfunction conditions having been replaced by the three-term trace relation). -/
def TraceZeroCore : Prop :=
  ∀ F : ℍ → ℂ, MDiff F →
    (∀ τ : ℍ, F ((1 : ℝ) +ᵥ τ) = F τ) →
    (∀ τ : ℍ, F τ + F (ModularGroup.S • τ) + F (ModularGroup.S • ((1 : ℝ) +ᵥ τ)) = 0) →
    (∃ C : ℝ, 0 ≤ C ∧ ∀ τ : ℍ, 1 ≤ τ.im → ‖F τ‖ ≤ C * Real.exp (-(2 * Real.pi * τ.im))) →
    F = 0

end Work.Rigidity
