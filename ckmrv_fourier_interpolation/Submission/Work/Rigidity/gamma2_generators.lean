/-
# The generators of `Γ(2)`

This file proves that the principal congruence subgroup `Γ(2)` of `SL(2, ℤ)` is generated by
the two elements `T²` and `S T² S` together with the central element `S² = -I`.

The proof is a Euclidean descent.  An element `g = [[a, b], [c, d]]` of `Γ(2)` has `a, d` odd
and `b, c` even, while right multiplication by `[[1, 2k], [0, 1]]` (resp. `[[1, 0], [2k, 1]]`)
acts on the bottom row by `(c, d) ↦ (c + 2kd, d)` (resp. `(c, d) ↦ (c, d + 2kc)`) and preserves
the parities.  Choosing `k` so that `|c + 2kd| < |d|` and then `k'` so that `|d + 2k'c'| < |c'|`
makes `max(|c|, |d|)` strictly decrease, so the descent terminates with `c = 0`.  In that case
`ad = 1` forces `g = ±[[1, 2m], [0, 1]]`, which lies in the subgroup generated by the three
given matrices.
-/
import Mathlib
import Submission.Work.Rigidity.LambdaDescentDefs

noncomputable section

open Matrix ModularGroup
open scoped MatrixGroups

namespace Work.Rigidity

/-- The subgroup of `SL(2, ℤ)` generated by `T²`, `S T² S` and `S² = -I`. -/
def Gamma2GenSubgroup : Subgroup SL(2,ℤ) :=
  Subgroup.closure ({T * T, S * (T * T) * S, S * S} : Set SL(2,ℤ))

/-- The "translation" matrix `[[1, 2k], [0, 1]]` as an element of `SL(2, ℤ)`. -/
def eA (k : ℤ) : SL(2,ℤ) := ⟨!![1, 2*k; 0, 1], by simp [Matrix.det_fin_two_of]⟩

/-- The "shear" matrix `[[1, 0], [2k, 1]]` as an element of `SL(2, ℤ)`. -/
def eB (k : ℤ) : SL(2,ℤ) := ⟨!![1, 0; 2*k, 1], by simp [Matrix.det_fin_two_of]⟩

section GroupStructure

lemma eA_mul (j k : ℤ) : eA j * eA k = eA (j + k) := by
  apply Subtype.ext; rw [Matrix.SpecialLinearGroup.coe_mul]; ext i l
  fin_cases i <;> fin_cases l <;> simp [eA] <;> ring

lemma eB_mul (j k : ℤ) : eB j * eB k = eB (j + k) := by
  apply Subtype.ext; rw [Matrix.SpecialLinearGroup.coe_mul]; ext i l
  fin_cases i <;> fin_cases l <;> simp [eB] <;> ring

lemma eA_zero : eA 0 = 1 := by
  apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;> simp [eA]

lemma eB_zero : eB 0 = 1 := by
  apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;> simp [eB]

lemma eA_one : eA 1 = (T * T : SL(2,ℤ)) := by
  apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;>
    simp [eA, Matrix.SpecialLinearGroup.coe_mul, Matrix.two_mul_expl, ModularGroup.coe_T]

lemma eB_neg_one : eB (-1) = (-1 : SL(2,ℤ)) * (S * (T * T) * S) := by
  apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;>
    simp [eB, Matrix.SpecialLinearGroup.coe_mul, Matrix.two_mul_expl, ModularGroup.coe_T,
      ModularGroup.coe_S, Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]

/-- `S² = -I` in `SL(2, ℤ)`. -/
lemma SS_eq_neg_one : (S * S : SL(2,ℤ)) = -1 := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul, ModularGroup.S_mul_S_eq,
    Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]

/-- The central element `-I` lies in the subgroup generated by the three given matrices. -/
lemma negOne_mem : (-1 : SL(2,ℤ)) ∈ Gamma2GenSubgroup := by
  rw [← SS_eq_neg_one]
  exact Subgroup.subset_closure (by simp)

lemma eA_mem (k : ℤ) : eA k ∈ Gamma2GenSubgroup := by
  have h1 : eA 1 ∈ Gamma2GenSubgroup := by
    rw [eA_one]; exact Subgroup.subset_closure (by simp)
  have hm1 : eA (-1) ∈ Gamma2GenSubgroup := by
    have h : eA 1 * eA (-1) = 1 := by rw [eA_mul, add_neg_cancel, eA_zero]
    rw [eq_inv_of_mul_eq_one_right h]; exact inv_mem h1
  induction k using Int.induction_on with
  | zero => rw [eA_zero]; exact one_mem Gamma2GenSubgroup
  | succ n ih => rw [show ((n:ℤ) + 1) = (n:ℤ) + 1 from rfl, ← eA_mul]; exact mul_mem ih h1
  | pred n ih => rw [show (-(n:ℤ) - 1) = -(n:ℤ) + (-1) from rfl, ← eA_mul]; exact mul_mem ih hm1

lemma eB_mem (k : ℤ) : eB k ∈ Gamma2GenSubgroup := by
  have hm1 : eB (-1) ∈ Gamma2GenSubgroup := by
    rw [eB_neg_one]
    exact mul_mem negOne_mem (Subgroup.subset_closure (by simp))
  have h1 : eB 1 ∈ Gamma2GenSubgroup := by
    have h : eB (-1) * eB 1 = 1 := by rw [eB_mul, neg_add_cancel, eB_zero]
    rw [eq_inv_of_mul_eq_one_right h]; exact inv_mem hm1
  induction k using Int.induction_on with
  | zero => rw [eB_zero]; exact one_mem Gamma2GenSubgroup
  | succ n ih => rw [show ((n:ℤ) + 1) = (n:ℤ) + 1 from rfl, ← eB_mul]; exact mul_mem ih h1
  | pred n ih => rw [show (-(n:ℤ) - 1) = -(n:ℤ) + (-1) from rfl, ← eB_mul]; exact mul_mem ih hm1

end GroupStructure

section GammaMembership

/-- `[[1, 2k], [0, 1]]` lies in `Γ(2)`. -/
lemma eA_mem_Gamma (k : ℤ) : eA k ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [eA]
  · show ((2*k : ℤ) : ZMod 2) = 0
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_mul_right 2 k
  · simp [eA]
  · simp [eA]

/-- `[[1, 0], [2k, 1]]` lies in `Γ(2)`. -/
lemma eB_mem_Gamma (k : ℤ) : eB k ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [eB]
  · simp [eB]
  · show ((2*k : ℤ) : ZMod 2) = 0
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact dvd_mul_right 2 k
  · simp [eB]

/-- `-I` lies in `Γ(2)`. -/
lemma negOne_mem_Gamma : (-1 : SL(2,ℤ)) ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

/-- `T²` lies in `Γ(2)`. -/
lemma TT_mem_Gamma : (T * T : SL(2,ℤ)) ∈ CongruenceSubgroup.Gamma 2 := by
  rw [← eA_one]; exact eA_mem_Gamma 1

/-- `S T² S` lies in `Γ(2)`. -/
lemma STS_mem_Gamma : (S * (T * T) * S : SL(2,ℤ)) ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

/-- `S²` lies in `Γ(2)`. -/
lemma SS_mem_Gamma : (S * S : SL(2,ℤ)) ∈ CongruenceSubgroup.Gamma 2 := by
  rw [SS_eq_neg_one]; exact negOne_mem_Gamma

end GammaMembership

section RowOperations

/-- Right multiplication by `[[1, 0], [2k, 1]]` changes the bottom left entry to `c + 2kd`. -/
lemma mul_eB_apply_10 (g : SL(2,ℤ)) (k : ℤ) :
    (g * eB k) 1 0 = g 1 0 + 2*k*(g 1 1) := by
  rw [Matrix.SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (g : Matrix (Fin 2) (Fin 2) ℤ) (eB k : Matrix (Fin 2) (Fin 2) ℤ)).2.2.1]
  simp [eB]; ring

/-- Right multiplication by `[[1, 0], [2k, 1]]` preserves the bottom right entry. -/
lemma mul_eB_apply_11 (g : SL(2,ℤ)) (k : ℤ) : (g * eB k) 1 1 = g 1 1 := by
  rw [Matrix.SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (g : Matrix (Fin 2) (Fin 2) ℤ) (eB k : Matrix (Fin 2) (Fin 2) ℤ)).2.2.2]
  simp [eB]

/-- Right multiplication by `[[1, 2k], [0, 1]]` preserves the bottom left entry. -/
lemma mul_eA_apply_10 (g : SL(2,ℤ)) (k : ℤ) : (g * eA k) 1 0 = g 1 0 := by
  rw [Matrix.SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (g : Matrix (Fin 2) (Fin 2) ℤ) (eA k : Matrix (Fin 2) (Fin 2) ℤ)).2.2.1]
  simp [eA]

/-- Right multiplication by `[[1, 2k], [0, 1]]` changes the bottom right entry to `d + 2kc`. -/
lemma mul_eA_apply_11 (g : SL(2,ℤ)) (k : ℤ) :
    (g * eA k) 1 1 = g 1 1 + 2*k*(g 1 0) := by
  rw [Matrix.SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (g : Matrix (Fin 2) (Fin 2) ℤ) (eA k : Matrix (Fin 2) (Fin 2) ℤ)).2.2.2]
  simp [eA]; ring

end RowOperations

/-- If `g ∈ Γ(2)` has vanishing bottom left entry then `g = ±[[1, 2m], [0, 1]]`, hence lies in
the subgroup generated by `T²`, `S T² S` and `S²`. -/
lemma mem_Gamma2GenSubgroup_of_apply_10_eq_zero (g : SL(2,ℤ))
    (hg : g ∈ CongruenceSubgroup.Gamma 2) (h : g 1 0 = 0) : g ∈ Gamma2GenSubgroup := by
  have hmem := (CongruenceSubgroup.Gamma_mem (N := 2)).mp hg
  have hb : ((g 0 1 : ℤ) : ZMod 2) = 0 := hmem.2.1
  obtain ⟨m, hm⟩ : ∃ m : ℤ, g 0 1 = 2 * m := by
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at hb; exact hb
  have hdet : g 0 0 * g 1 1 = 1 := by
    have h2 := g.2
    rw [Matrix.det_fin_two] at h2
    rw [h, mul_zero, sub_zero] at h2
    exact h2
  rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hdet with ⟨ha, hd⟩ | ⟨ha, hd⟩
  · have hg' : g = eA m := by
      apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;> simp [eA, ha, hd, hm, h]
    rw [hg']; exact eA_mem m
  · have hg' : g = (-1 : SL(2,ℤ)) * eA (-m) := by
      apply Subtype.ext
      rw [Matrix.SpecialLinearGroup.coe_mul]
      ext i j; fin_cases i <;> fin_cases j <;>
        simp [eA, Matrix.two_mul_expl, Matrix.SpecialLinearGroup.coe_neg,
          Matrix.SpecialLinearGroup.coe_one, ha, hd, hm, h]
    rw [hg']; exact mul_mem negOne_mem (eA_mem (-m))

section Arithmetic

/-- If `c` and `m` have opposite parities and `m > 0`, then some element `c + 2km` of the
arithmetic progression has absolute value strictly smaller than `m`. -/
lemma exists_k_abs_lt' {c m : ℤ} (hm : 0 < m) (hpar : (2:ℤ) ∣ c ↔ ¬ (2:ℤ) ∣ m) :
    ∃ k : ℤ, |c + 2*k*m| < m := by
  have h2m : 0 < 2*m := by linarith
  have hr0 : 0 ≤ c % (2*m) := Int.emod_nonneg c (by linarith)
  have hrlt : c % (2*m) < 2*m := Int.emod_lt_of_pos c h2m
  have hcr : c % (2*m) = c - (2*m) * (c / (2*m)) := by
    have h := Int.emod_add_mul_ediv c (2*m)
    linarith
  have hpr : (2:ℤ) ∣ c % (2*m) ↔ (2:ℤ) ∣ c := by
    constructor
    · intro h
      have : c = (c % (2*m)) + 2 * (m * (c/(2*m))) := by rw [hcr]; ring
      rw [this]
      exact dvd_add h ⟨m * (c/(2*m)), by ring⟩
    · intro h
      rw [hcr]
      exact dvd_sub h ⟨m * (c/(2*m)), by ring⟩
  have hrne : c % (2*m) ≠ m := by
    intro h
    have h1 : (2:ℤ) ∣ m ↔ ¬ (2:ℤ) ∣ m := (h ▸ hpr).trans hpar
    by_cases h2 : (2:ℤ) ∣ m
    · exact h1.mp h2 h2
    · exact h2 (h1.mpr h2)
  rcases lt_or_ge (c % (2*m)) m with hcase | hcase
  · refine ⟨-(c/(2*m)), ?_⟩
    rw [show c + 2*(-(c/(2*m)))*m = c % (2*m) from by rw [hcr]; ring]
    rw [abs_of_nonneg hr0]; exact hcase
  · have hgt : m < c % (2*m) := lt_of_le_of_ne hcase (Ne.symm hrne)
    refine ⟨-(c/(2*m)) - 1, ?_⟩
    rw [show c + 2*(-(c/(2*m)) - 1)*m = c % (2*m) - 2*m from by rw [hcr]; ring]
    rw [abs_of_neg (by linarith)]
    linarith

/-- If `c` and `d` have opposite parities and `d ≠ 0`, then some element `c + 2kd` of the
arithmetic progression has `natAbs` strictly smaller than that of `d`. -/
lemma exists_k_natAbs_lt_of_ne_parity {c d : ℤ} (hd0 : d ≠ 0)
    (hpar : ((2:ℤ) ∣ c ∧ ¬ (2:ℤ) ∣ d) ∨ (¬ (2:ℤ) ∣ c ∧ (2:ℤ) ∣ d)) :
    ∃ k : ℤ, (c + 2*k*d).natAbs < d.natAbs := by
  have hiff : (2:ℤ) ∣ c ↔ ¬ (2:ℤ) ∣ d := by
    rcases hpar with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨fun _ => h2, fun _ => h1⟩
    · exact ⟨fun h => absurd h h1, fun h => absurd h2 h⟩
  have hm : 0 < |d| := abs_pos.mpr hd0
  have hiff' : (2:ℤ) ∣ c ↔ ¬ (2:ℤ) ∣ |d| := by
    rcases abs_choice d with h | h
    · rw [h]; exact hiff
    · rw [h, show ((2:ℤ) ∣ -d) ↔ (2:ℤ) ∣ d from dvd_neg]; exact hiff
  obtain ⟨k, hk⟩ := exists_k_abs_lt' hm hiff'
  have key : ((c + 2*k*|d|).natAbs : ℤ) < (d.natAbs : ℤ) := by
    rw [Int.natCast_natAbs, Int.natCast_natAbs]; exact hk
  rcases lt_trichotomy d 0 with h | h | h
  · refine ⟨-k, ?_⟩
    rw [show c + 2*(-k)*d = c + 2*k*|d| from by rw [abs_of_neg h]; ring]
    exact_mod_cast key
  · exact absurd h hd0
  · refine ⟨k, ?_⟩
    rw [show c + 2*k*d = c + 2*k*|d| from by rw [abs_of_pos h]]
    exact_mod_cast key

end Arithmetic

section Descent

/-- Every element of `Γ(2)` lies in the subgroup generated by `T²`, `S T² S` and `S²`. -/
theorem mem_Gamma2GenSubgroup_of_mem_Gamma (g : SL(2,ℤ))
    (hg : g ∈ CongruenceSubgroup.Gamma 2) : g ∈ Gamma2GenSubgroup := by
  have key : ∀ n : ℕ, ∀ g : SL(2,ℤ), g ∈ CongruenceSubgroup.Gamma 2 →
      (g 1 0).natAbs ≤ n → (g 1 1).natAbs ≤ n → g ∈ Gamma2GenSubgroup := by
    intro n
    induction n with
    | zero =>
      intro g hg hc hd
      exfalso
      have hmem := (CongruenceSubgroup.Gamma_mem (N := 2)).mp hg
      have hd1 : ((g 1 1 : ℤ) : ZMod 2) = 1 := hmem.2.2.2
      have hd0 : g 1 1 = 0 := Int.natAbs_eq_zero.mp (Nat.le_zero.mp hd)
      rw [hd0] at hd1
      exact absurd hd1 (by decide)
    | succ n ih =>
      intro g hg hc hd
      have hmem := (CongruenceSubgroup.Gamma_mem (N := 2)).mp hg
      have hc0 : ((g 1 0 : ℤ) : ZMod 2) = 0 := hmem.2.2.1
      have hd1 : ((g 1 1 : ℤ) : ZMod 2) = 1 := hmem.2.2.2
      by_cases hcz : g 1 0 = 0
      · exact mem_Gamma2GenSubgroup_of_apply_10_eq_zero g hg hcz
      · have h2c : (2:ℤ) ∣ g 1 0 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mp hc0
        have h2d : ¬ (2:ℤ) ∣ g 1 1 := by
          intro h
          have h0 : ((g 1 1 : ℤ) : ZMod 2) = 0 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mpr h
          rw [h0] at hd1
          exact absurd hd1 (by decide)
        have hd0 : g 1 1 ≠ 0 := fun h => h2d (by rw [h]; exact dvd_zero 2)
        obtain ⟨k, hk⟩ := exists_k_natAbs_lt_of_ne_parity (c := g 1 0) (d := g 1 1) hd0
          (Or.inl ⟨h2c, h2d⟩)
        have hB : (g * eB k) ∈ CongruenceSubgroup.Gamma 2 := mul_mem hg (eB_mem_Gamma k)
        have hB10 : (g * eB k) 1 0 = g 1 0 + 2*k*(g 1 1) := mul_eB_apply_10 g k
        have hB11 : (g * eB k) 1 1 = g 1 1 := mul_eB_apply_11 g k
        have hlt1 : ((g * eB k) 1 0).natAbs < ((g * eB k) 1 1).natAbs := by
          rw [hB10, hB11]; exact hk
        by_cases hcz1 : (g * eB k) 1 0 = 0
        · have hmem1 : (g * eB k) ∈ Gamma2GenSubgroup :=
            mem_Gamma2GenSubgroup_of_apply_10_eq_zero _ hB hcz1
          have hgg : g = (g * eB k) * (eB k)⁻¹ := by group
          rw [hgg]
          exact mul_mem hmem1 (inv_mem (eB_mem k))
        · have hmem1 := (CongruenceSubgroup.Gamma_mem (N := 2)).mp hB
          have h2c1 : (2:ℤ) ∣ (g * eB k) 1 0 :=
            (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mp hmem1.2.2.1
          have h2d1 : ¬ (2:ℤ) ∣ (g * eB k) 1 1 := by
            intro h
            have h0 : (((g * eB k) 1 1 : ℤ) : ZMod 2) = 0 :=
              (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mpr h
            rw [h0] at hmem1
            exact absurd hmem1.2.2.2 (by decide)
          have hd10 : (g * eB k) 1 1 ≠ 0 := fun h => h2d1 (by rw [h]; exact dvd_zero 2)
          obtain ⟨k', hk'⟩ := exists_k_natAbs_lt_of_ne_parity (c := (g * eB k) 1 1)
            (d := (g * eB k) 1 0) hcz1 (Or.inr ⟨h2d1, h2c1⟩)
          have hA : ((g * eB k) * eA k') ∈ CongruenceSubgroup.Gamma 2 :=
            mul_mem hB (eA_mem_Gamma k')
          have hA10 : ((g * eB k) * eA k') 1 0 = (g * eB k) 1 0 := mul_eA_apply_10 _ k'
          have hA11 : ((g * eB k) * eA k') 1 1
              = (g * eB k) 1 1 + 2*k'*((g * eB k) 1 0) := mul_eA_apply_11 _ k'
          have hB11le : ((g * eB k) 1 1).natAbs ≤ n + 1 := by rw [hB11]; exact hd
          have hb1' : ((g * eB k) 1 0).natAbs ≤ n := by omega
          have hb1 : (((g * eB k) * eA k') 1 0).natAbs ≤ n := by rw [hA10]; exact hb1'
          have hb2 : (((g * eB k) * eA k') 1 1).natAbs ≤ n := by rw [hA11]; omega
          have hmem2 := ih ((g * eB k) * eA k') hA hb1 hb2
          have hgg : g = (((g * eB k) * eA k') * (eA k')⁻¹) * (eB k)⁻¹ := by group
          rw [hgg]
          exact mul_mem (mul_mem hmem2 (inv_mem (eA_mem k'))) (inv_mem (eB_mem k))
  exact key (max (g 1 0).natAbs (g 1 1).natAbs) g hg (le_max_left _ _) (le_max_right _ _)

end Descent

theorem gamma2_generators : Work.Rigidity.Gamma2Generators := by
  show CongruenceSubgroup.Gamma 2 = Gamma2GenSubgroup
  refine le_antisymm ?_ ?_
  · intro g hg
    exact mem_Gamma2GenSubgroup_of_mem_Gamma g hg
  · rw [Gamma2GenSubgroup, Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact TT_mem_Gamma
    · exact STS_mem_Gamma
    · exact SS_mem_Gamma

end Work.Rigidity
