/-! ## Slash and cusp preliminaries -/

/-- `Γ(2)` is normal in `SL(2, ℤ)`, so the slash of a `Γ(2)`-invariant function by any `g` is
again `Γ(2)`-invariant. -/
lemma slash_gamma_invariant {D : UpperHalfPlane → Complex}
    (hΓ : ∀ γ ∈ CongruenceSubgroup.Gamma 2, D ∣[(12 : ℤ)] γ = D)
    (g : SL(2, ℤ)) {δ : SL(2, ℤ)} (hδ : δ ∈ CongruenceSubgroup.Gamma 2) :
    (D ∣[(12 : ℤ)] g) ∣[(12 : ℤ)] δ = D ∣[(12 : ℤ)] g := by
  rw [← SlashAction.slash_mul]
  have hconj : g * δ * g⁻¹ ∈ CongruenceSubgroup.Gamma 2 :=
    (CongruenceSubgroup.Gamma_normal 2).conj_mem δ hδ g
  have hgg : g * δ = (g * δ * g⁻¹) * g := by group
  rw [hgg, SlashAction.slash_mul, hΓ _ hconj]

lemma T_mul_T_mem_Gamma2 : ModularGroup.T * ModularGroup.T ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

/-- The "norm" element `δ` with `S * T * S = T * (S * T) * δ`. -/
def normDelta : SL(2, ℤ) := ⟨!![-1, 0; 2, -1], by simp [Matrix.det_fin_two_of]⟩

lemma normDelta_mem_Gamma2 : normDelta ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

lemma S_mul_T_mul_S_eq : ModularGroup.S * ModularGroup.T * ModularGroup.S
    = ModularGroup.T * (ModularGroup.S * ModularGroup.T) * normDelta := by
  decide


/-- Every element of `Γ(2)` lies in the subgroup generated by `T ^ 2`, `S T ^ 2 S` and `S ^ 2`. -/
lemma mem_Gamma2GenSubgroup {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma 2) :
    γ ∈ Gamma2GenSubgroup :=
  (show CongruenceSubgroup.Gamma 2 = Gamma2GenSubgroup from gamma2_generators) ▸ hγ

/-- **Vanishing with a vanishing `q`-expansion tail.**  If `F` is `1`-periodic, holomorphic and
bounded at `i∞` and decays like `exp (-2π m Im τ)` for all sufficiently large `Im τ`, then the
first `m` coefficients of its `q`-expansion vanish.  (The proof uses the decay only along the
horizontal lines `Im τ = t`, `t → ∞`, so an *eventual* decay hypothesis suffices.) -/
theorem expDecayCoeffZero_eventually {F : UpperHalfPlane → Complex} {A₀ C : ℝ} (hC : 0 ≤ C)
    {m : ℕ} (hper : Function.Periodic (fun w : ℂ => F (UpperHalfPlane.ofComplex w)) 1)
    (hfhol : MDiff F) (hbdd : UpperHalfPlane.IsBoundedAtImInfty F)
    (hdec : ∀ τ : UpperHalfPlane, A₀ ≤ τ.im →
      ‖F τ‖ ≤ C * Real.exp (-(2 * Real.pi * (m : ℝ) * τ.im))) :
    ∀ n : ℕ, n < m → (UpperHalfPlane.qExpansion 1 F).coeff n = 0 := by
  have hA : 0 < max A₀ 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  intro n hn
  have hcol : ∀ t : ℝ, max A₀ 1 ≤ t →
      ‖(UpperHalfPlane.qExpansion 1 F).coeff n‖ ≤
        C * Real.exp (-(2 * Real.pi * ((m : ℝ) - n) * t)) := by
    intro t ht
    have ht0 : 0 < t := lt_of_lt_of_le hA ht
    have hmain := UpperHalfPlane.qExpansion_coeff_eq_intervalIntegral (h := 1) one_pos hper
      hfhol hbdd n ht0
    rw [hmain]
    simp only [one_div, Complex.ofReal_one, inv_one, one_mul]
    refine le_trans (intervalIntegral.norm_integral_le_of_norm_le_const
      (C := C * Real.exp (-(2 * Real.pi * ((m : ℝ) - n) * t))) ?_) ?_
    · intro u _
      have hzim : ((u : ℂ) + (t : ℂ) * ((UpperHalfPlane.I : UpperHalfPlane) : ℂ)).im = t := by
        simp [Complex.add_im, Complex.mul_im]
      set τ : ℍ := ⟨(u : ℂ) + (t : ℂ) * ((UpperHalfPlane.I : UpperHalfPlane) : ℂ),
        by rw [hzim]; exact ht0⟩ with hτdef
      have hτim : τ.im = t := by rw [hτdef]; exact hzim
      have hqpow : ‖Function.Periodic.qParam 1 ((u : ℂ) + (t : ℂ) *
            ((UpperHalfPlane.I : UpperHalfPlane) : ℂ)) ^ n‖
          = Real.exp (-(2 * Real.pi * (n : ℝ) * t)) := by
        rw [norm_pow, Function.Periodic.norm_qParam, hzim, div_one, ← Real.exp_nat_mul]
        congr 1
        ring
      have hqnorm : ‖(Function.Periodic.qParam 1 ((u : ℂ) + (t : ℂ) *
            ((UpperHalfPlane.I : UpperHalfPlane) : ℂ)) ^ n)⁻¹‖
          = Real.exp (2 * Real.pi * (n : ℝ) * t) := by
        rw [norm_inv, hqpow, ← Real.exp_neg]
        congr 1
        ring
      rw [norm_mul, hqnorm]
      calc Real.exp (2 * Real.pi * (n : ℝ) * t) * ‖F τ‖
          ≤ Real.exp (2 * Real.pi * (n : ℝ) * t) *
              (C * Real.exp (-(2 * Real.pi * (m : ℝ) * τ.im))) := by
            apply mul_le_mul_of_nonneg_left (hdec τ ?_) (Real.exp_nonneg _)
            rw [hτim]; exact le_trans (le_max_left _ _) ht
        _ = C * (Real.exp (2 * Real.pi * (n : ℝ) * t) *
              Real.exp (-(2 * Real.pi * (m : ℝ) * t))) := by
            rw [hτim]; ring
        _ = C * Real.exp (2 * Real.pi * (n : ℝ) * t + -(2 * Real.pi * (m : ℝ) * t)) := by
            rw [Real.exp_add]
        _ = C * Real.exp (-(2 * Real.pi * ((m : ℝ) - n) * t)) := by
            congr 1
            ring_nf
    · simp
  have hlim : Tendsto (fun t : ℝ => C * Real.exp (-(2 * Real.pi * ((m : ℝ) - n) * t)))
      atTop (𝓝 0) := by
    have hcoef : -(2 * Real.pi * ((m : ℝ) - n)) < 0 := by
      have h : (0 : ℝ) < (m : ℝ) - n := by
        have h' : (n : ℝ) < (m : ℝ) := by exact_mod_cast hn
        linarith
      have : (0 : ℝ) < 2 * Real.pi * ((m : ℝ) - n) := by positivity
      linarith
    have hexp : Tendsto (fun t : ℝ => Real.exp (-(2 * Real.pi * ((m : ℝ) - n)) * t))
        atTop (𝓝 0) := by
      rw [Real.tendsto_exp_comp_nhds_zero]
      have h := (Filter.tendsto_const_mul_atBot_of_neg
        (r := -(2 * Real.pi * ((m : ℝ) - n))) hcoef).mpr (Filter.tendsto_id)
      refine h.congr (fun t => ?_)
      simp only [id_eq]
    have h3 : Tendsto (fun t : ℝ => C * Real.exp (-(2 * Real.pi * ((m : ℝ) - n)) * t))
        atTop (𝓝 0) := by
      simpa using hexp.const_mul C
    refine h3.congr (fun t => ?_)
    congr 1
    ring_nf
  have hle : ‖(UpperHalfPlane.qExpansion 1 F).coeff n‖ ≤ 0 :=
    le_of_tendsto_of_tendsto tendsto_const_nhds hlim
      (eventually_atTop.mpr ⟨max A₀ 1, fun t ht => hcol t ht⟩)
  exact norm_eq_zero.mp (le_antisymm hle (norm_nonneg _))

/-! ## The four generating functions lie in `M₁₂(H)` -/

section FourForms

/-- The slash action of `SL(2, ℤ)` on the level-one Eisenstein series `E₄` is trivial. -/
lemma E4Fun_slash (γ : SL(2, ℤ)) : Work.Kernels.E4Fun ∣[(4 : ℤ)] γ = Work.Kernels.E4Fun := by
  rw [ModularForm.SL_slash]
  exact SlashInvariantFormClass.slash_action_eq (ModularForm.E₄) (γ : GL (Fin 2) ℝ)
    (MonoidHom.mem_range.mpr ⟨γ, rfl⟩)

/-- The slash action of `SL(2, ℤ)` on the level-one Eisenstein series `E₆` is trivial. -/
lemma E6Fun_slash (γ : SL(2, ℤ)) : Work.Kernels.E6Fun ∣[(6 : ℤ)] γ = Work.Kernels.E6Fun := by
  rw [ModularForm.SL_slash]
  exact SlashInvariantFormClass.slash_action_eq (ModularForm.E₆) (γ : GL (Fin 2) ℝ)
    (MonoidHom.mem_range.mpr ⟨γ, rfl⟩)

/-- At even weight, `-1 ∈ SL(2, ℤ)` acts trivially (weight `2`). -/
lemma slash_neg_one_two (F : UpperHalfPlane → Complex) :
    F ∣[(2 : ℤ)] (-1 : SL(2, ℤ)) = F := by
  funext τ
  rw [Work.Kernels.slash_apply']
  have h1 : ((-1 : SL(2, ℤ)) • τ : UpperHalfPlane) = τ := by
    apply UpperHalfPlane.ext
    simp
  have h2 : Work.Kernels.jFun (-1 : SL(2, ℤ)) (τ : ℂ) = -1 := by
    rw [Work.Kernels.jFun_apply]
    simp
  rw [h1, h2]
  norm_num

/-- `ξ₂ = U + W ∈ 𝒫`. -/
lemma xi2Fun_InP : Work.Kernels.InP Work.Kernels.xi2Fun := by
  have h : Work.Kernels.xi2Fun = Work.Kernels.UFun + Work.Kernels.WFun := rfl
  rw [h]
  exact (Work.Kernels.ClassicalFacts.theta00Fun_mem_InP.pow 4).add
    (Work.Kernels.ClassicalFacts.theta01Fun_mem_InP.pow 4)

/-- `V² ∈ 𝒫`. -/
lemma V2_InP : Work.Kernels.InP (fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2) :=
  (Work.Kernels.ClassicalFacts.theta10Fun_mem_InP.pow 4).pow 2

/-- The generators of `Γ(2)` fix `U`, `V` and `W`. -/
lemma theta_generators_fixed (δ : SL(2, ℤ)) (hδ : δ ∈ Gamma2GenSubgroup) :
    Work.Kernels.UFun ∣[(2 : ℤ)] δ = Work.Kernels.UFun ∧
    Work.Kernels.VFun ∣[(2 : ℤ)] δ = Work.Kernels.VFun ∧
    Work.Kernels.WFun ∣[(2 : ℤ)] δ = Work.Kernels.WFun := by
  have hgen : ∀ g ∈ ({ModularGroup.T * ModularGroup.T,
      ModularGroup.S * (ModularGroup.T * ModularGroup.T) * ModularGroup.S,
      ModularGroup.S * ModularGroup.S} : Set SL(2, ℤ)),
      Work.Kernels.UFun ∣[(2 : ℤ)] g = Work.Kernels.UFun ∧
      Work.Kernels.VFun ∣[(2 : ℤ)] g = Work.Kernels.VFun ∧
      Work.Kernels.WFun ∣[(2 : ℤ)] g = Work.Kernels.WFun := by
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl | rfl
    · -- `T²`
      refine ⟨?_, ?_, ?_⟩ <;>
        simp only [SlashAction.slash_mul, Work.Kernels.TildeFacts.Kzb.UFun_slash_T,
          Work.Kernels.TildeFacts.Kzb.WFun_slash_T, Work.Kernels.TildeFacts.Kzb.VFun_slash_T,
          SlashAction.neg_slash, Pi.neg_apply, neg_neg]
    · -- `S T² S`
      refine ⟨?_, ?_, ?_⟩ <;>
        simp only [SlashAction.slash_mul, Work.Kernels.TildeFacts.Kzb.UFun_slash_S,
          Work.Kernels.TildeFacts.Kzb.WFun_slash_S, Work.Kernels.TildeFacts.Kzb.VFun_slash_S,
          Work.Kernels.TildeFacts.Kzb.UFun_slash_T, Work.Kernels.TildeFacts.Kzb.WFun_slash_T,
          Work.Kernels.TildeFacts.Kzb.VFun_slash_T, SlashAction.neg_slash, Pi.neg_apply, neg_neg]
    · -- `S² = -1`
      refine ⟨?_, ?_, ?_⟩ <;>
        rw [show ModularGroup.S * ModularGroup.S = (-1 : SL(2, ℤ)) from S_mul_S, slash_neg_one_two]
  refine Subgroup.closure_induction hgen (by simp) ?_ ?_ hδ
  · intro x y hx hy ihx ihy
    obtain ⟨a1, a2, a3⟩ := ihx
    obtain ⟨b1, b2, b3⟩ := ihy
    refine ⟨?_, ?_, ?_⟩
    · rw [SlashAction.slash_mul, a1, b1]
    · rw [SlashAction.slash_mul, a2, b2]
    · rw [SlashAction.slash_mul, a3, b3]
  · intro x hx ih
    obtain ⟨a1, a2, a3⟩ := ih
    have key : ∀ F : UpperHalfPlane → Complex,
        F ∣[(2 : ℤ)] x = F → F ∣[(2 : ℤ)] x⁻¹ = F := by
      intro F hF
      have h := congrArg (fun G : UpperHalfPlane → Complex => G ∣[(2 : ℤ)] x⁻¹) hF
      rw [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one] at h
      exact h.symm
    exact ⟨key _ a1, key _ a2, key _ a3⟩

/-- The weight-`2` form `ξ₂ = U + W` is `Γ(2)`-invariant. -/
lemma xi2Fun_gamma2 (γ : SL(2, ℤ)) (hγ : γ ∈ CongruenceSubgroup.Gamma 2) :
    Work.Kernels.xi2Fun ∣[(2 : ℤ)] γ = Work.Kernels.xi2Fun := by
  have h := theta_generators_fixed γ (mem_Gamma2GenSubgroup hγ)
  rw [show Work.Kernels.xi2Fun = Work.Kernels.UFun + Work.Kernels.WFun from rfl,
    SlashAction.add_slash, h.1, h.2.2]

/-- The weight-`4` form `V²` is `Γ(2)`-invariant. -/
lemma V2_gamma2 (γ : SL(2, ℤ)) (hγ : γ ∈ CongruenceSubgroup.Gamma 2) :
    (fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2) ∣[(4 : ℤ)] γ
      = fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2 := by
  have h := (theta_generators_fixed γ (mem_Gamma2GenSubgroup hγ)).2.1
  have hsq : (fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2)
      = Work.Kernels.VFun * Work.Kernels.VFun := by
    funext τ
    simp only [Pi.mul_apply]
    ring
  funext τ
  rw [hsq, show (4 : ℤ) = 2 + 2 from by norm_num, mul_slash_apply, h]
  ring

/-- `ξ₂` is `T`-invariant. -/
lemma xi2Fun_T : Work.Kernels.xi2Fun ∣[(2 : ℤ)] ModularGroup.T = Work.Kernels.xi2Fun := by
  funext τ
  rw [slash_T_apply, Work.Kernels.KernelFacts.xi2Fun_vadd_one]

/-- `V²` is `T`-invariant. -/
lemma V2_T : (fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2) ∣[(4 : ℤ)] ModularGroup.T
    = fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2 := by
  have hsq : (fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2)
      = Work.Kernels.VFun * Work.Kernels.VFun := by
    funext τ
    simp only [Pi.mul_apply]
    ring
  have key : (Work.Kernels.VFun * Work.Kernels.VFun) ∣[(4 : ℤ)] ModularGroup.T
      = (Work.Kernels.VFun ∣[(2 : ℤ)] ModularGroup.T)
        * (Work.Kernels.VFun ∣[(2 : ℤ)] ModularGroup.T) := by
    rw [show (4 : ℤ) = 2 + 2 from by norm_num, mul_slash]
  rw [hsq, key, Work.Kernels.TildeFacts.Kzb.VFun_slash_T]
  have hfinal : (-Work.Kernels.VFun) * (-Work.Kernels.VFun)
      = Work.Kernels.VFun * Work.Kernels.VFun := by
    funext τ
    simp only [Pi.neg_apply, Pi.mul_apply]
    ring
  rw [hfinal]

/-- Boundedness at all cusps follows from moderate growth and `Γ(2)`-invariance. -/
theorem boundedAtImInfty_slash_of_InP_gamma2 {P : UpperHalfPlane → Complex}
    (hP : Work.Kernels.InP P)
    (hΓ : ∀ γ ∈ CongruenceSubgroup.Gamma 2, P ∣[(12 : ℤ)] γ = P) :
    ∀ γ : SL(2, ℤ), UpperHalfPlane.IsBoundedAtImInfty (P ∣[(12 : ℤ)] γ) := by
  intro g
  have hPg : Work.Kernels.InP (P ∣[(12 : ℤ)] g) := hP.slash 12 g
  have hconj : (g * (ModularGroup.T * ModularGroup.T) * g⁻¹) ∈ CongruenceSubgroup.Gamma 2 :=
    (CongruenceSubgroup.Gamma_normal 2).conj_mem _ T_mul_T_mem_Gamma2 g
  have hshift : (P ∣[(12 : ℤ)] g) ∣[(12 : ℤ)] (ModularGroup.T * ModularGroup.T)
      = P ∣[(12 : ℤ)] g := by
    have hgg : g * (ModularGroup.T * ModularGroup.T)
        = (g * (ModularGroup.T * ModularGroup.T) * g⁻¹) * g := by group
    rw [← SlashAction.slash_mul, hgg, SlashAction.slash_mul, hΓ _ hconj]
  have hper2 : ∀ τ : UpperHalfPlane,
      (P ∣[(12 : ℤ)] g) ((2 : ℝ) +ᵥ τ) = (P ∣[(12 : ℤ)] g) τ := by
    intro τ
    have h := congrFun hshift τ
    rw [SlashAction.slash_mul, slash_T_apply, slash_T_apply] at h
    rw [← Work.Kernels.vadd_one_add_one] at h
    exact h
  exact BoundedAtImInftyPeriodicInP (by norm_num) hPg hper2

/-- `E₄³ ∈ M₁₂(H)`. -/
theorem IsM12H_E4_cube :
    IsM12H (fun τ : UpperHalfPlane => Work.Kernels.E4Fun τ ^ 3) := by
  have hInP : Work.Kernels.InP (fun τ : UpperHalfPlane => Work.Kernels.E4Fun τ ^ 3) :=
    Work.Kernels.ClassicalFacts.E4Fun_mem_InP.pow 3
  have hprod : (fun τ : UpperHalfPlane => Work.Kernels.E4Fun τ ^ 3)
      = Work.Kernels.E4Fun * Work.Kernels.E4Fun * Work.Kernels.E4Fun := by
    funext τ
    simp only [Pi.mul_apply]
    ring
  have hslash : ∀ γ : SL(2, ℤ),
      (fun τ : UpperHalfPlane => Work.Kernels.E4Fun τ ^ 3) ∣[(12 : ℤ)] γ
        = fun τ : UpperHalfPlane => Work.Kernels.E4Fun τ ^ 3 := by
    intro γ
    funext τ
    rw [hprod, show (12 : ℤ) = 4 + 4 + 4 from by norm_num, mul3_slash_apply,
      E4Fun_slash γ]
    ring
  exact ⟨hInP, fun γ _ => hslash γ, boundedAtImInfty_slash_of_InP_gamma2 hInP
    (fun γ _ => hslash γ), hslash ModularGroup.T⟩

/-- `E₆² ∈ M₁₂(H)`. -/
theorem IsM12H_E6_sq :
    IsM12H (fun τ : UpperHalfPlane => Work.Kernels.E6Fun τ ^ 2) := by
  have hInP : Work.Kernels.InP (fun τ : UpperHalfPlane => Work.Kernels.E6Fun τ ^ 2) :=
    Work.Kernels.ClassicalFacts.E6Fun_mem_InP.pow 2
  have hprod : (fun τ : UpperHalfPlane => Work.Kernels.E6Fun τ ^ 2)
      = Work.Kernels.E6Fun * Work.Kernels.E6Fun := by
    funext τ
    simp only [Pi.mul_apply]
    ring
  have hslash : ∀ γ : SL(2, ℤ),
      (fun τ : UpperHalfPlane => Work.Kernels.E6Fun τ ^ 2) ∣[(12 : ℤ)] γ
        = fun τ : UpperHalfPlane => Work.Kernels.E6Fun τ ^ 2 := by
    intro γ
    funext τ
    rw [hprod, show (12 : ℤ) = 6 + 6 from by norm_num, mul_slash_apply, E6Fun_slash γ]
    ring
  exact ⟨hInP, fun γ _ => hslash γ, boundedAtImInfty_slash_of_InP_gamma2 hInP
    (fun γ _ => hslash γ), hslash ModularGroup.T⟩

/-- `ξ₂E₄E₆ ∈ M₁₂(H)`. -/
theorem IsM12H_xi2E4E6 : IsM12H (fun τ : UpperHalfPlane =>
    Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ) := by
  have hInP : Work.Kernels.InP (fun τ : UpperHalfPlane =>
      Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ) :=
    Work.Kernels.InP.mul (Work.Kernels.InP.mul xi2Fun_InP
      Work.Kernels.ClassicalFacts.E4Fun_mem_InP) Work.Kernels.ClassicalFacts.E6Fun_mem_InP
  have hprod : (fun τ : UpperHalfPlane =>
      Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ)
      = Work.Kernels.xi2Fun * Work.Kernels.E4Fun * Work.Kernels.E6Fun := rfl
  have hΓ : ∀ γ ∈ CongruenceSubgroup.Gamma 2, (fun τ : UpperHalfPlane =>
      Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ) ∣[(12 : ℤ)] γ
      = fun τ : UpperHalfPlane =>
        Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ := by
    intro γ hγ
    funext τ
    rw [hprod, show (12 : ℤ) = 2 + 4 + 6 from by norm_num, mul3_slash_apply,
      xi2Fun_gamma2 γ hγ, E4Fun_slash γ, E6Fun_slash γ]
  have hT : (fun τ : UpperHalfPlane =>
      Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ) ∣[(12 : ℤ)]
        ModularGroup.T = fun τ : UpperHalfPlane =>
        Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ := by
    funext τ
    rw [hprod, show (12 : ℤ) = 2 + 4 + 6 from by norm_num, mul3_slash_apply,
      xi2Fun_T, E4Fun_slash ModularGroup.T, E6Fun_slash ModularGroup.T]
  exact ⟨hInP, hΓ, boundedAtImInfty_slash_of_InP_gamma2 hInP hΓ, hT⟩

/-- `V²E₄² ∈ M₁₂(H)`. -/
theorem IsM12H_V2E4sq : IsM12H (fun τ : UpperHalfPlane =>
    Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) := by
  have hInP : Work.Kernels.InP (fun τ : UpperHalfPlane =>
      Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) :=
    Work.Kernels.InP.mul V2_InP (Work.Kernels.ClassicalFacts.E4Fun_mem_InP.pow 2)
  have hprod : (fun τ : UpperHalfPlane =>
      Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2)
      = (fun τ : UpperHalfPlane => Work.Kernels.VFun τ ^ 2)
        * (Work.Kernels.E4Fun * Work.Kernels.E4Fun) := by
    funext τ
    simp only [Pi.mul_apply]
    ring
  have hΓ : ∀ γ ∈ CongruenceSubgroup.Gamma 2, (fun τ : UpperHalfPlane =>
      Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) ∣[(12 : ℤ)] γ
      = fun τ : UpperHalfPlane =>
        Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2 := by
    intro γ hγ
    funext τ
    rw [hprod, show (12 : ℤ) = 4 + (4 + 4) from by norm_num, mul_slash_apply,
      mul_slash_apply, E4Fun_slash γ, V2_gamma2 γ hγ]
    ring
  have hT : (fun τ : UpperHalfPlane =>
      Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) ∣[(12 : ℤ)] ModularGroup.T
      = fun τ : UpperHalfPlane =>
        Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2 := by
    funext τ
    rw [hprod, show (12 : ℤ) = 4 + (4 + 4) from by norm_num, mul_slash_apply,
      mul_slash_apply, E4Fun_slash ModularGroup.T, V2_T]
    ring
  exact ⟨hInP, hΓ, boundedAtImInfty_slash_of_InP_gamma2 hInP hΓ, hT⟩

end FourForms



/-! ## The dimension bound -/

/-- **The dimension bound.**  A `T`-invariant `Γ(2)`-invariant weight-`12` form of moderate
growth bounded at all cusps whose first four `q`-expansion coefficients vanish is zero. -/
theorem M12H_eq_zero_of_coeff_zero (D : UpperHalfPlane → Complex) (hD : IsM12H D)
    (hcoeff : ∀ n : ℕ, n < 4 → (UpperHalfPlane.qExpansion 1 D).coeff n = 0) : D = 0 := by
  have hP : Work.Kernels.InP D := hD.1
  have hΓ : ∀ γ ∈ CongruenceSubgroup.Gamma 2, D ∣[(12 : ℤ)] γ = D := hD.2.1
  have hbdd : ∀ γ : SL(2, ℤ), UpperHalfPlane.IsBoundedAtImInfty (D ∣[(12 : ℤ)] γ) := hD.2.2.1
  have hT : D ∣[(12 : ℤ)] ModularGroup.T = D := hD.2.2.2
  -- the two conjugates of `D`
  set Z : UpperHalfPlane → Complex := D ∣[(12 : ℤ)] ModularGroup.S with hZ
  set Y : UpperHalfPlane → Complex := D ∣[(12 : ℤ)] (ModularGroup.S * ModularGroup.T) with hY
  have hZS : Z ∣[(12 : ℤ)] ModularGroup.S = D := by
    rw [hZ, ← SlashAction.slash_mul, S_mul_S, slash_neg_one_twelve]
  have hZT : Z ∣[(12 : ℤ)] ModularGroup.T = Y := by
    rw [hZ, hY, ← SlashAction.slash_mul]
  have hYT : Y ∣[(12 : ℤ)] ModularGroup.T = Z := by
    have h1 : Y ∣[(12 : ℤ)] ModularGroup.T
        = D ∣[(12 : ℤ)] (ModularGroup.S * (ModularGroup.T * ModularGroup.T)) := by
      rw [hY, ← SlashAction.slash_mul]
      congr 1
      group
    rw [h1, SlashAction.slash_mul, slash_gamma_invariant hΓ ModularGroup.S T_mul_T_mem_Gamma2, hZ]
  have hYS : Y ∣[(12 : ℤ)] ModularGroup.S = Y := by
    have key : Y ∣[(12 : ℤ)] ModularGroup.S
        = ((D ∣[(12 : ℤ)] ModularGroup.T) ∣[(12 : ℤ)] (ModularGroup.S * ModularGroup.T))
          ∣[(12 : ℤ)] normDelta := by
      rw [hY, ← SlashAction.slash_mul, S_mul_T_mul_S_eq]
      simp only [SlashAction.slash_mul]
    rw [key, hT, slash_gamma_invariant hΓ (ModularGroup.S * ModularGroup.T) normDelta_mem_Gamma2,
      ← hY]
  -- the norm of `D` over the cosets of `⟨T⟩`
  set G : UpperHalfPlane → Complex := D * Z * Y with hG
  have hZmdiff : MDiff Z := hP.1.slash 12 (ModularGroup.S : GL (Fin 2) ℝ)
  have hYmdiff : MDiff Y :=
    hP.1.slash 12 (((ModularGroup.S * ModularGroup.T : SL(2, ℤ)) : GL (Fin 2) ℝ))
  have hGmdiff : MDiff G := by
    rw [hG]
    exact (hP.1.mul hZmdiff).mul hYmdiff
  have hGS : G ∣[(36 : ℤ)] ModularGroup.S = G := by
    rw [hG, show (36 : ℤ) = 12 + 12 + 12 from by norm_num, mul3_slash, ← hZ, hZS, hYS]
    ring
  have hGT : G ∣[(36 : ℤ)] ModularGroup.T = G := by
    rw [hG, show (36 : ℤ) = 12 + 12 + 12 from by norm_num, mul3_slash, hT, hZT, hYT]
    ring
  have hGinv : ∀ γ : SL(2, ℤ), G ∣[(36 : ℤ)] γ = G := by
    let H : Subgroup SL(2, ℤ) :=
      { carrier := {γ | G ∣[(36 : ℤ)] γ = G}
        one_mem' := SlashAction.slash_one 36 G
        mul_mem' := by
          intro a b ha hb
          simp only [Set.mem_ofPred_eq] at ha hb ⊢
          rw [SlashAction.slash_mul, ha, hb]
        inv_mem' := by
          intro a ha
          simp only [Set.mem_ofPred_eq] at ha ⊢
          have h := congrArg (fun F : UpperHalfPlane → Complex => F ∣[(36 : ℤ)] a⁻¹) ha
          rw [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one] at h
          exact h.symm }
    have hle : Subgroup.closure ({ModularGroup.S, ModularGroup.T} : Set SL(2, ℤ)) ≤ H := by
      refine (Subgroup.closure_le H).mpr ?_
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact hGS
      · exact hGT
    rw [SpecialLinearGroup.SL2Z_generators] at hle
    intro γ
    exact hle (Subgroup.mem_top γ)
  have hGper : Function.Periodic (fun w : ℂ => G (UpperHalfPlane.ofComplex w)) 1 :=
    periodic_one_of_vadd_one (fun τ => by
      have h := congrFun hGT τ
      rwa [slash_T_apply] at h)
  -- the eventual decay of `G` like `q ^ 4`
  obtain ⟨A₀, B₀, hB₀, hdecD⟩ := decay_of_qExpansion_coeff_zero hD.periodic hD.mdiff hD.bdd_infty
    hcoeff
  obtain ⟨MZ, AZ, hZbd⟩ := isBoundedAtImInfty_iff.mp (hbdd ModularGroup.S)
  obtain ⟨MY, AY, hYbd⟩ := isBoundedAtImInfty_iff.mp (hbdd (ModularGroup.S * ModularGroup.T))
  have hC : 0 ≤ B₀ * max MZ 0 * max MY 0 :=
    mul_nonneg (mul_nonneg hB₀ (le_max_right _ _)) (le_max_right _ _)
  have hdecG : ∀ τ : UpperHalfPlane, max (max A₀ AZ) AY ≤ τ.im →
      ‖G τ‖ ≤ (B₀ * max MZ 0 * max MY 0) * Real.exp (-(2 * Real.pi * (4 : ℝ) * τ.im)) := by
    intro τ hτ
    have h1 : A₀ ≤ τ.im := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hτ
    have h2 : AZ ≤ τ.im := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hτ
    have h3 : AY ≤ τ.im := le_trans (le_max_right _ _) hτ
    rw [hG]
    simp only [Pi.mul_apply]
    have hZ' : ‖Z τ‖ ≤ max MZ 0 := le_trans (hZbd τ h2) (le_max_left _ _)
    have hY' : ‖Y τ‖ ≤ max MY 0 := le_trans (hYbd τ h3) (le_max_left _ _)
    have hD' : ‖D τ‖ ≤ B₀ * Real.exp (-(2 * Real.pi * (4 : ℝ) * τ.im)) := hdecD τ h1
    calc ‖D τ * Z τ * Y τ‖ = ‖D τ‖ * ‖Z τ‖ * ‖Y τ‖ := by rw [norm_mul, norm_mul]
      _ ≤ (B₀ * Real.exp (-(2 * Real.pi * (4 : ℝ) * τ.im))) * (max MZ 0) * (max MY 0) := by
          refine mul_le_mul (mul_le_mul hD' hZ' (norm_nonneg _) ?_) hY' (norm_nonneg _) ?_
          · exact mul_nonneg hB₀ (Real.exp_nonneg _)
          · exact mul_nonneg (mul_nonneg hB₀ (Real.exp_nonneg _)) (le_max_right _ _)
      _ = (B₀ * max MZ 0 * max MY 0) * Real.exp (-(2 * Real.pi * (4 : ℝ) * τ.im)) := by ring
  have hGbdd : UpperHalfPlane.IsBoundedAtImInfty G := by
    refine isBoundedAtImInfty_iff.mpr
      ⟨B₀ * max MZ 0 * max MY 0, max (max (max A₀ AZ) AY) 1, fun τ hτ => ?_⟩
    have h1 : max (max A₀ AZ) AY ≤ τ.im := le_trans (le_max_left _ _) hτ
    have h2 : (1 : ℝ) ≤ τ.im := le_trans (le_max_right _ _) hτ
    refine le_trans (hdecG τ h1) (mul_le_of_le_one_right hC ?_)
    rw [Real.exp_le_one_iff]
    nlinarith [Real.pi_pos, h2]
  have hcoeffG : ∀ n : ℕ, n < 4 → (UpperHalfPlane.qExpansion 1 G).coeff n = 0 :=
    expDecayCoeffZero_eventually hC hGper hGmdiff hGbdd hdecG
  -- `G` is a level-one modular form of weight `36`, hence vanishes by the Sturm bound
  obtain ⟨g, hg⟩ := Work.Modular.modularForm_of_slash_invariant (k := 36) hGinv hGmdiff hGbdd
  have hg0 : g = 0 := by
    refine ModularForm.sturm_bound_levelOne (f := g) ?_
    have h4 : (4 : ℕ∞) ≤ (qExpansion 1 ⇑g).order := by
      rw [hg]
      exact PowerSeries.nat_le_order _ 4 (fun i hi => hcoeffG i hi)
    have h34 : ((3 : ℕ∞)) < (4 : ℕ∞) := by norm_num
    refine lt_of_lt_of_le h34 (le_trans h4 (le_of_eq ?_))
    norm_num
  have hG0 : G = 0 := by rw [← hg, hg0]; rfl
  -- finally `D = 0`, since `G` is a product of three holomorphic functions
  have hZY : D * Z = 0 ∨ Y = 0 :=
    mdiff_mul_eq_zero (hP.1.mul hZmdiff) hYmdiff (fun τ => by
      have h := congrFun hG0 τ
      rw [hG] at h
      simpa using h)
  rcases hZY with hDZ | hY0
  · rcases mdiff_mul_eq_zero hP.1 hZmdiff (fun τ => congrFun hDZ τ) with hD0 | hZ0
    · exact hD0
    · rw [← hZS, hZ0, SlashAction.zero_slash]
  · have hD0 : D = 0 := by
      have h1 : (D ∣[(12 : ℤ)] (ModularGroup.S * ModularGroup.T))
          ∣[(12 : ℤ)] (ModularGroup.S * ModularGroup.T)⁻¹ = D := by
        rw [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one]
      rw [← h1, ← hY, hY0, SlashAction.zero_slash]
    exact hD0



/-! ## Independence of the four generating functions

The relation `a E₄³ + b E₆² + c ξ₂E₄E₆ + d V²E₄² = 0` is rewritten, using `U = V + W`,
`E₄ = U² - UV + V²`, `E₆ = (1/2)(U+V)(2U-V)(U-2V)` and `ξ₂ = 2U - V`, as the vanishing of a
*homogeneous polynomial of degree `6`* in `(U, V)`.  Dehomogenising with `λ = V/U` (which tends
to `0` at the cusp and never vanishes) gives a polynomial relation `Q(λ τ) = 0`; hence `Q`
vanishes identically, and evaluating at `0, 1, 2, 3` gives four independent linear conditions on
`a, b, c, d`. -/

/-- `λ = V/U → 0` at the cusp `i∞`. -/
lemma lambdaFun_tendsto_zero :
    Tendsto Work.Kernels.lambdaFun UpperHalfPlane.atImInfty (nhds 0) := by
  have hq : Tendsto (fun τ : UpperHalfPlane => Function.Periodic.qParam 2 (τ : ℂ))
      UpperHalfPlane.atImInfty (nhds 0) :=
    ((Function.Periodic.qParam_tendsto (by norm_num : (0 : ℝ) < 2)).comp
      UpperHalfPlane.tendsto_coe_atImInfty).mono_right nhdsWithin_le_nhds
  have h := hq.mul lambdaFun_div_qParam_tendsto
  rw [zero_mul] at h
  refine h.congr' ?_
  filter_upwards with τ
  rw [mul_div_cancel₀]
  exact Function.Periodic.qParam_ne_zero _

/-- `W = U - V`. -/
lemma WFun_eq_sub (τ : UpperHalfPlane) :
    Work.Kernels.WFun τ = Work.Kernels.UFun τ - Work.Kernels.VFun τ := by
  rw [Work.Kernels.TildeFacts.theta_quartic τ]
  ring

/-- `E₄ = U² - UV + V²`. -/
lemma E4Fun_eq_UV (τ : UpperHalfPlane) : Work.Kernels.E4Fun τ
    = (Work.Kernels.UFun τ) ^ 2 - Work.Kernels.UFun τ * Work.Kernels.VFun τ
      + (Work.Kernels.VFun τ) ^ 2 := by
  rw [Work.Residues.KMinusT_E4Fun_eq_theta τ, WFun_eq_sub τ]
  ring

/-- `E₆ = (1/2)(U + V)(2U - V)(U - 2V)`. -/
lemma E6Fun_eq_UV (τ : UpperHalfPlane) : Work.Kernels.E6Fun τ = (1 / 2)
    * ((Work.Kernels.UFun τ + Work.Kernels.VFun τ)
      * (2 * Work.Kernels.UFun τ - Work.Kernels.VFun τ)
      * (Work.Kernels.UFun τ - 2 * Work.Kernels.VFun τ)) := by
  rw [Work.Kernels.TildeFacts.E6Fun_eq_theta τ, WFun_eq_sub τ]
  ring

/-- `ξ₂ = 2U - V`. -/
lemma xi2Fun_eq_UV (τ : UpperHalfPlane) :
    Work.Kernels.xi2Fun τ = 2 * Work.Kernels.UFun τ - Work.Kernels.VFun τ := by
  rw [show Work.Kernels.xi2Fun τ = Work.Kernels.UFun τ + Work.Kernels.WFun τ from rfl,
    WFun_eq_sub τ]
  ring

/-- The homogeneous sextic relation in `(U, V)`. -/
def Rpoly (a b c d : ℂ) (u v : ℂ) : ℂ :=
  a * (u ^ 2 - u * v + v ^ 2) ^ 3
    + b * ((1 / 2) * (u + v) * (2 * u - v) * (u - 2 * v)) ^ 2
    + c * ((2 * u - v) * (u ^ 2 - u * v + v ^ 2)
        * ((1 / 2) * (u + v) * (2 * u - v) * (u - 2 * v)))
    + d * (v ^ 2 * (u ^ 2 - u * v + v ^ 2) ^ 2)

/-- The dehomogenisation of `Rpoly` at `u = 1`. -/
def Qpoly (a b c d : ℂ) (s : ℂ) : ℂ :=
  a * (1 - s + s ^ 2) ^ 3
    + b * ((1 / 2) * (1 + s) * (2 - s) * (1 - 2 * s)) ^ 2
    + c * ((2 - s) * (1 - s + s ^ 2) * ((1 / 2) * (1 + s) * (2 - s) * (1 - 2 * s)))
    + d * (s ^ 2 * (1 - s + s ^ 2) ^ 2)

lemma Rpoly_dehomog (a b c d : ℂ) (u v : ℂ) (hu : u ≠ 0) :
    Rpoly a b c d u v = u ^ 6 * Qpoly a b c d (v / u) := by
  simp only [Rpoly, Qpoly]
  field_simp
  try ring

/-- **The four weight-twelve functions `E₄³`, `E₆²`, `ξ₂E₄E₆`, `V²E₄²` are linearly
independent.** -/
theorem four_forms_linear_independent (a b c d : ℂ)
    (h : ∀ τ : UpperHalfPlane,
      a * Work.Kernels.E4Fun τ ^ 3 + b * Work.Kernels.E6Fun τ ^ 2
        + c * (Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ)
        + d * (Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) = 0) :
    a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0 := by
  -- the relation becomes the vanishing of the homogeneous polynomial `Rpoly` at `(U, V)`
  have hR : ∀ τ : UpperHalfPlane,
      Rpoly a b c d (Work.Kernels.UFun τ) (Work.Kernels.VFun τ) = 0 := by
    intro τ
    have hτ := h τ
    rw [E4Fun_eq_UV τ, E6Fun_eq_UV τ, xi2Fun_eq_UV τ] at hτ
    simp only [Rpoly]
    linear_combination hτ
  -- dehomogenising: `Qpoly (λ τ) = 0`
  have hQ0 : ∀ τ : UpperHalfPlane, Qpoly a b c d (Work.Kernels.lambdaFun τ) = 0 := by
    intro τ
    have h1 : (Work.Kernels.UFun τ) ^ 6 * Qpoly a b c d (Work.Kernels.lambdaFun τ) = 0 := by
      rw [← Rpoly_dehomog a b c d (Work.Kernels.UFun τ) (Work.Kernels.VFun τ)
        (UFun_ne_zero τ)]
      exact hR τ
    exact (mul_eq_zero.mp h1).resolve_left (pow_ne_zero 6 (UFun_ne_zero τ))
  -- `Qpoly` is a polynomial function, hence vanishes identically
  let R : Polynomial ℂ := Polynomial.C a * (1 - Polynomial.X + Polynomial.X ^ 2) ^ 3
    + Polynomial.C b * (Polynomial.C (1 / 2) * (1 + Polynomial.X) * (2 - Polynomial.X)
        * (1 - 2 * Polynomial.X)) ^ 2
    + Polynomial.C c * ((2 - Polynomial.X) * (1 - Polynomial.X + Polynomial.X ^ 2)
        * (Polynomial.C (1 / 2) * (1 + Polynomial.X) * (2 - Polynomial.X)
          * (1 - 2 * Polynomial.X)))
    + Polynomial.C d * (Polynomial.X ^ 2 * (1 - Polynomial.X + Polynomial.X ^ 2) ^ 2)
  have hRQ : ∀ s : ℂ, R.eval s = Qpoly a b c d s := by
    intro s
    simp only [R, Qpoly, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_one,
      Polynomial.eval_ofNat]
    try ring
  have hR0 : R = 0 :=
    polynomial_eq_zero_of_tendsto_zero (fun τ => lambdaFun_ne_zero τ) lambdaFun_tendsto_zero
      (fun τ => by rw [hRQ]; exact hQ0 τ)
  have hQzero : ∀ s : ℂ, Qpoly a b c d s = 0 := by
    intro s
    rw [← hRQ, hR0]
    simp
  -- four evaluations of `Qpoly`
  have e0 : a + b + 2 * c = 0 := by
    have h0 := hQzero 0
    simp only [Qpoly] at h0
    norm_num at h0
    linear_combination h0
  have e1 : a + b - c + d = 0 := by
    have h1 := hQzero 1
    simp only [Qpoly] at h1
    norm_num at h1
    linear_combination h1
  have e2 : 27 * a + 36 * d = 0 := by
    have h2 := hQzero 2
    simp only [Qpoly] at h2
    norm_num at h2
    linear_combination h2
  have e3 : 343 * a + 100 * b - 70 * c + 441 * d = 0 := by
    have h3 := hQzero 3
    simp only [Qpoly] at h3
    norm_num at h3
    linear_combination h3
  have hd : d = 3 * c := by linear_combination e1 - e0
  have ha : a = -4 * c := by
    have h : 27 * a + 108 * c = 0 := by linear_combination e2 - 36 * hd
    linear_combination (1 / 27 : ℂ) * h
  have hb : b = 2 * c := by linear_combination e0 - ha
  have hc : c = 0 := by
    have h : 81 * c = 0 := by linear_combination e3 - 343 * ha - 100 * hb - 441 * hd
    linear_combination (1 / 81 : ℂ) * h
  exact ⟨by rw [ha, hc]; ring, by rw [hb, hc]; ring, hc, by rw [hd, hc]; ring⟩


/-! ## The assembly: `M₁₂(H)` is spanned by the four functions -/

/-- The four generating functions of the statement, indexed by `Fin 4`. -/
def F4 : Fin 4 → (UpperHalfPlane → ℂ)
  | 0 => fun τ => Work.Kernels.E4Fun τ ^ 3
  | 1 => fun τ => Work.Kernels.E6Fun τ ^ 2
  | 2 => fun τ => Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ
  | 3 => fun τ => Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2

@[simp] lemma F4_zero : F4 0 = fun τ : UpperHalfPlane => Work.Kernels.E4Fun τ ^ 3 := rfl
@[simp] lemma F4_one : F4 1 = fun τ : UpperHalfPlane => Work.Kernels.E6Fun τ ^ 2 := rfl
@[simp] lemma F4_two : F4 2 = fun τ : UpperHalfPlane =>
    Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ := rfl
@[simp] lemma F4_three : F4 3 = fun τ : UpperHalfPlane =>
    Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2 := rfl

lemma F4_mem : ∀ j : Fin 4, IsM12H (F4 j) := by
  intro j
  fin_cases j
  · simpa using IsM12H_E4_cube
  · simpa using IsM12H_E6_sq
  · simpa using IsM12H_xi2E4E6
  · simpa using IsM12H_V2E4sq

/-- The first four `q`-expansion coefficients. -/
def coeffFun (E : UpperHalfPlane → ℂ) : Fin 4 → ℂ :=
  fun i => (UpperHalfPlane.qExpansion 1 E).coeff i

lemma coeffFun_add {E E' : UpperHalfPlane → ℂ} (hE : IsM12H E) (hE' : IsM12H E') :
    coeffFun (E + E') = coeffFun E + coeffFun E' := by
  funext i
  simp only [coeffFun, Pi.add_apply]
  exact coeff_add hE hE' i

lemma coeffFun_smul (c : ℂ) {E : UpperHalfPlane → ℂ} (hE : IsM12H E) :
    coeffFun (c • E) = c • coeffFun E := by
  funext i
  simp only [coeffFun, Pi.smul_apply, smul_eq_mul]
  exact coeff_smul hE c i

lemma IsM12H.sum_F4 (w : Fin 4 → ℂ) : IsM12H (∑ j, w j • F4 j) :=
  IsM12H.sum _ (fun j _ => (F4_mem j).smul (w j))

lemma coeffFun_sum (w : Fin 4 → ℂ) (s : Finset (Fin 4)) :
    coeffFun (∑ j ∈ s, w j • F4 j) = ∑ j ∈ s, w j • coeffFun (F4 j) := by
  classical
  induction s using Finset.induction_on with
  | empty => funext i; simp [coeffFun, UpperHalfPlane.qExpansion_zero]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha,
      coeffFun_add ((F4_mem a).smul (w a)) (IsM12H.sum s (fun j _ => (F4_mem j).smul (w j))),
      coeffFun_smul (w a) (F4_mem a), ih]

/-- The linear map sending `w : ℂ⁴` to the first four `q`-expansion coefficients of
`∑ j, w j • F4 j`. -/
def Phi : (Fin 4 → ℂ) →ₗ[ℂ] (Fin 4 → ℂ) where
  toFun w := coeffFun (∑ j, w j • F4 j)
  map_add' w w' := by
    have hsum : (∑ j, (w + w') j • F4 j)
        = (∑ j, w j • F4 j) + (∑ j, w' j • F4 j) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => by rw [Pi.add_apply, add_smul])
    have hmem : IsM12H ((∑ j, w j • F4 j) + (∑ j, w' j • F4 j)) :=
      (IsM12H.sum_F4 w).add (IsM12H.sum_F4 w')
    rw [hsum, coeffFun_add (IsM12H.sum_F4 w) (IsM12H.sum_F4 w'),
      coeffFun_sum w Finset.univ, coeffFun_sum w' Finset.univ]
    try rfl
  map_smul' c w := by
    have hsum : (∑ j, (c • w) j • F4 j) = c • (∑ j, w j • F4 j) := by
      rw [Finset.smul_sum]
      exact Finset.sum_congr rfl (fun j _ => by rw [Pi.smul_apply, smul_assoc])
    rw [hsum, coeffFun_smul c (IsM12H.sum_F4 w), coeffFun_sum w Finset.univ]
    try rfl

/-
# The weight-`12` space of `T`-invariant `Γ(2)`-modular forms

`D : ℍ → ℂ` is a holomorphic function of moderate growth (`InP`), invariant under the
weight-`12` slash action of `Γ(2)`, bounded at every cusp, and invariant under `T`.  Then
`D` lies in the `4`-dimensional space spanned by `E₄³`, `E₆²`, `ξ₂ E₄ E₆`, `V² E₄²`.

## Proof

Write `H = ⟨Γ(2), T⟩ = Γ₀(2)` (index `3` in `SL(2,ℤ)`), so `D ∈ M₁₂(H)`.

1. **Dimension bound** (`M12H_eq_zero_of_coeff_zero`).  A `D` as above with `ord_∞(D) ≥ 4`
   vanishes: the product `N = D · (D ∣[12] S) · (D ∣[12] (S * T))` over the three cosets of
   `⟨T⟩` in `⟨S, T⟩` is `SL(2,ℤ)`-invariant of weight `36` (the product over a coset system is
   invariant, and `Γ(2)` is normal), hence a level-one modular form of weight `36`.  Its first
   four `q`-expansion coefficients vanish because `D` decays like `q⁴`
   (`decay_of_qExpansion_coeff_zero`) while the two conjugates are bounded at `i∞`
   (`boundedAtImInfty_slash_of_InP_gamma2`), and the Sturm bound for level one
   (`ModularForm.sturm_bound_levelOne`, with `36 / 12 = 3 < 4`) then gives `N = 0`, whence
   `D = 0`.
2. **Identification.**  The four functions are `T`- and `Γ(2)`-invariant weight-`12`
   holomorphic and cusp-bounded (`IsM12H_E4_cube`, …, `IsM12H_V2E4sq`) and linearly
   independent (`four_forms_linear_independent`), so with `dim M₁₂(H) ≤ 4` they span it. -/

/-- **The weight-`12` `T`-invariant `Γ(2)`-modular forms are spanned by `E₄³, E₆², ξ₂E₄E₆,
V²E₄²`.** -/
theorem M12HSpan (D : UpperHalfPlane → Complex) (hD : Work.Kernels.InP D)
    (hΓ : ∀ γ ∈ CongruenceSubgroup.Gamma 2, SlashAction.map (12 : ℤ) γ D = D)
    (hbdd : ∀ γ : Matrix.SpecialLinearGroup (Fin 2) ℤ,
      UpperHalfPlane.IsBoundedAtImInfty (SlashAction.map (12 : ℤ) γ D))
    (hT : SlashAction.map (12 : ℤ) ModularGroup.T D = D) :
    ∃ a b c d : Complex, ∀ τ : UpperHalfPlane,
      D τ = a * Work.Kernels.E4Fun τ ^ 3 + b * Work.Kernels.E6Fun τ ^ 2
        + c * (Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ)
        + d * (Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) := by
  have hD' : IsM12H D := ⟨hD, hΓ, hbdd, hT⟩
  have hker : ∀ w : Fin 4 → ℂ, Phi w = 0 → w = 0 := by
    intro w hw
    have hmem : IsM12H (∑ j, w j • F4 j) := IsM12H.sum_F4 w
    have hzero : (∑ j, w j • F4 j) = 0 := by
      refine M12H_eq_zero_of_coeff_zero _ hmem (fun n hn => ?_)
      have h := congrFun hw ⟨n, hn⟩
      simpa [Phi, coeffFun] using h
    have hrel : ∀ τ : UpperHalfPlane,
        w 0 * Work.Kernels.E4Fun τ ^ 3 + w 1 * Work.Kernels.E6Fun τ ^ 2
          + w 2 * (Work.Kernels.xi2Fun τ * Work.Kernels.E4Fun τ * Work.Kernels.E6Fun τ)
          + w 3 * (Work.Kernels.VFun τ ^ 2 * Work.Kernels.E4Fun τ ^ 2) = 0 := by
      intro τ
      have h := congrFun hzero τ
      rw [Fin.sum_univ_four] at h
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, F4_zero, F4_one,
        F4_two, F4_three] at h
      linear_combination h
    obtain ⟨h0, h1, h2, h3⟩ := four_forms_linear_independent (w 0) (w 1) (w 2) (w 3) hrel
    funext j
    fin_cases j <;> assumption
  have hinj : Function.Injective Phi := fun w w' hww => by
    have hzero : Phi (w - w') = 0 := by rw [map_sub, hww, sub_self]
    exact sub_eq_zero.mp (hker (w - w') hzero)
  obtain ⟨w, hw⟩ := LinearMap.surjective_of_injective hinj (coeffFun D)
  refine ⟨w 0, w 1, w 2, w 3, fun τ => ?_⟩
  have hdiff : (∑ j, w j • F4 j) - D = 0 := by
    refine M12H_eq_zero_of_coeff_zero _ ((IsM12H.sum_F4 w).sub hD') (fun n hn => ?_)
    have hcoeff : (UpperHalfPlane.qExpansion 1 (∑ j, w j • F4 j)).coeff n
        = (UpperHalfPlane.qExpansion 1 D).coeff n := by
      have h := congrFun hw ⟨n, hn⟩
      simpa [Phi, coeffFun] using h
    rw [show (∑ j, w j • F4 j) - D = (∑ j, w j • F4 j) + (-D) from rfl,
      coeff_add (IsM12H.sum_F4 w) hD'.neg, coeff_neg hD' n, hcoeff]
    ring
  have hDE : D = ∑ j, w j • F4 j := (sub_eq_zero.mp hdiff).symm
  rw [hDE, Fin.sum_univ_four]
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, F4_zero, F4_one, F4_two, F4_three]

end

end Work.Rigidity
