/-
# The space `M₁₂(⟨Γ(2), T⟩)`

This file fixes the predicate `Work.Rigidity.IsM12H` used in
`Submission/Work/Rigidity/M12HSpan.lean`: a function `D : ℍ → ℂ` lies in `IsM12H` when

* `D ∈ 𝒫 = Work.Kernels.InP` (holomorphic of moderate growth),
* `D` is invariant under the weight-`12` slash action of `Γ(2)`,
* every slash `D ∣[12] γ` (`γ ∈ SL(2,ℤ)`) is bounded at the cusp `i∞` (i.e. `D` is bounded at
  every cusp), and
* `D` is invariant under the weight-`12` slash action of `T` (i.e. `1`-periodic).

The group generated by `Γ(2)` and `T` is `Γ₀(2)`, so `IsM12H` is the space denoted `M₁₂(H)`
with `H = Γ₀(2)` in the rigidity chapter of CKMRV.
-/
import Mathlib
import Submission.Work.Kernels.Classical

noncomputable section

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle

namespace Work.Rigidity

/-- `IsM12H D`: `D` is a weight-`12` `Γ(2)`-invariant, `T`-invariant function of moderate
growth, bounded at every cusp. -/
def IsM12H (D : UpperHalfPlane → Complex) : Prop :=
  Work.Kernels.InP D ∧
  (∀ γ ∈ CongruenceSubgroup.Gamma 2, D ∣[(12 : ℤ)] γ = D) ∧
  (∀ γ : SL(2, ℤ), UpperHalfPlane.IsBoundedAtImInfty (D ∣[(12 : ℤ)] γ)) ∧
  D ∣[(12 : ℤ)] ModularGroup.T = D

section Basic

variable {D E : UpperHalfPlane → Complex}

/-- The slash action of `T` is the shift `τ ↦ τ + 1` (any weight). -/
lemma slash_T_apply (k : ℤ) (F : UpperHalfPlane → Complex) (τ : UpperHalfPlane) :
    (F ∣[k] ModularGroup.T) τ = F ((1 : ℝ) +ᵥ τ) := by
  rw [Work.Kernels.slash_apply', Work.Kernels.jFun_apply, UpperHalfPlane.modular_T_smul]
  have h10 : ((ModularGroup.T : SL(2, ℤ)) 1 0 : ℂ) = 0 := by simp [ModularGroup.coe_T]
  have h11 : ((ModularGroup.T : SL(2, ℤ)) 1 1 : ℂ) = 1 := by simp [ModularGroup.coe_T]
  rw [h10, h11, zero_mul, zero_add, _root_.one_zpow, mul_one]

/-- Invariance of `F` under translation by `1` gives `Function.Periodic (F ∘ ofComplex) 1`. -/
lemma periodic_one_of_vadd_one {F : UpperHalfPlane → Complex}
    (h : ∀ τ : UpperHalfPlane, F ((1 : ℝ) +ᵥ τ) = F τ) :
    Function.Periodic (fun w : ℂ => F (UpperHalfPlane.ofComplex w)) 1 := by
  intro w
  change F (UpperHalfPlane.ofComplex (w + 1)) = F (UpperHalfPlane.ofComplex w)
  by_cases hw : 0 < w.im
  · have h2 : 0 < (w + 1).im := by simpa using hw
    rw [ofComplex_apply_of_im_pos hw, ofComplex_apply_of_im_pos h2]
    convert h ⟨w, hw⟩ using 2
    apply UpperHalfPlane.ext
    simp only [UpperHalfPlane.coe_vadd, Complex.ofReal_one]
    ring
  · have hw' : w.im ≤ 0 := not_lt.mp hw
    have h2 : (w + 1).im ≤ 0 := by simpa using hw'
    rw [ofComplex_apply_eq_of_im_nonpos h2 hw']

lemma IsM12H.mdiff (hD : IsM12H D) : MDiff D := hD.1.1

/-- An element of `M₁₂(H)` is `1`-periodic. -/
lemma IsM12H.periodic (hD : IsM12H D) :
    Function.Periodic (fun w : ℂ => D (UpperHalfPlane.ofComplex w)) 1 :=
  periodic_one_of_vadd_one (fun τ => by
    have h := congrFun hD.2.2.2 τ
    rwa [slash_T_apply] at h)

lemma IsM12H.bdd_infty (hD : IsM12H D) : UpperHalfPlane.IsBoundedAtImInfty D := by
  have h := hD.2.2.1 1
  rwa [SlashAction.slash_one] at h

/-- The `q`-expansion of an element of `M₁₂(H)` is analytic at the cusp. -/
lemma IsM12H.analyticAt_cuspFunction (hD : IsM12H D) :
    AnalyticAt ℂ (UpperHalfPlane.cuspFunction 1 D) 0 :=
  UpperHalfPlane.analyticAt_cuspFunction_zero one_pos hD.periodic hD.mdiff hD.bdd_infty

lemma IsM12H.zero : IsM12H (0 : UpperHalfPlane → Complex) := by
  refine ⟨Work.Kernels.InP.zero, ?_, ?_, ?_⟩
  · intro γ _
    simp
  · intro γ
    rw [SlashAction.zero_slash]
    exact zero_form_isBoundedAtImInfty
  · simp

lemma IsM12H.neg (hD : IsM12H D) : IsM12H (-D) := by
  refine ⟨hD.1.neg, ?_, ?_, ?_⟩
  · intro γ hγ
    rw [SlashAction.neg_slash, hD.2.1 γ hγ]
  · intro γ
    rw [SlashAction.neg_slash]
    exact (hD.2.2.1 γ).neg
  · rw [SlashAction.neg_slash, hD.2.2.2]

lemma IsM12H.add (hD : IsM12H D) (hE : IsM12H E) : IsM12H (D + E) := by
  refine ⟨hD.1.add hE.1, ?_, ?_, ?_⟩
  · intro γ hγ
    rw [SlashAction.add_slash, hD.2.1 γ hγ, hE.2.1 γ hγ]
  · intro γ
    rw [SlashAction.add_slash]
    obtain ⟨M₁, A₁, h₁⟩ := isBoundedAtImInfty_iff.mp (hD.2.2.1 γ)
    obtain ⟨M₂, A₂, h₂⟩ := isBoundedAtImInfty_iff.mp (hE.2.2.1 γ)
    refine isBoundedAtImInfty_iff.mpr ⟨M₁ + M₂, max A₁ A₂, fun z hz => ?_⟩
    rw [Pi.add_apply]
    exact le_trans (norm_add_le _ _)
      (add_le_add (h₁ z (le_trans (le_max_left _ _) hz))
        (h₂ z (le_trans (le_max_right _ _) hz)))
  · rw [SlashAction.add_slash, hD.2.2.2, hE.2.2.2]

lemma IsM12H.sub (hD : IsM12H D) (hE : IsM12H E) : IsM12H (D - E) := by
  have h : D - E = D + (-E) := rfl
  rw [h]
  exact hD.add hE.neg

lemma IsM12H.smul (hD : IsM12H D) (c : ℂ) : IsM12H (c • D) := by
  refine ⟨hD.1.const_mul c, ?_, ?_, ?_⟩
  · intro γ hγ
    rw [ModularForm.SL_smul_slash, hD.2.1 γ hγ]
  · intro γ
    rw [ModularForm.SL_smul_slash]
    obtain ⟨M, A, hM⟩ := isBoundedAtImInfty_iff.mp (hD.2.2.1 γ)
    refine isBoundedAtImInfty_iff.mpr ⟨‖c‖ * M, A, fun z hz => ?_⟩
    rw [Pi.smul_apply, norm_smul]
    exact mul_le_mul_of_nonneg_left (hM z hz) (norm_nonneg _)
  · rw [ModularForm.SL_smul_slash, hD.2.2.2]

lemma IsM12H.sum {ι : Type*} (s : Finset ι) {F : ι → UpperHalfPlane → Complex}
    (h : ∀ i ∈ s, IsM12H (F i)) : IsM12H (∑ i ∈ s, F i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using IsM12H.zero
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact (h a (Finset.mem_insert_self a s)).add
      (ih fun i hi => h i (Finset.mem_insert_of_mem hi))


/-- The slash action is multiplicative on pointwise products, the weights adding. -/
lemma mul_slash (k l : ℤ) (γ : SL(2, ℤ)) (F G : UpperHalfPlane → Complex) :
    (F * G) ∣[k + l] γ = (F ∣[k] γ) * (G ∣[l] γ) := by
  funext τ
  simp only [Pi.mul_apply, ModularForm.SL_slash_apply]
  rw [show (-(k + l)) = -k + -l by ring,
    zpow_add₀ (UpperHalfPlane.denom_ne_zero _ _)]
  ring


/-- Slash of a product of three functions, the weights adding. -/
lemma mul3_slash (k l m : ℤ) (γ : SL(2, ℤ)) (F G H : UpperHalfPlane → Complex) :
    (F * G * H) ∣[k + l + m] γ = (F ∣[k] γ) * (G ∣[l] γ) * (H ∣[m] γ) := by
  rw [mul_slash (k + l) m, mul_slash k l]

/-- Powers of a slash: `(F ^ n) ∣[n * k] γ = (F ∣[k] γ) ^ n`. -/
lemma pow_slash (k : ℤ) (γ : SL(2, ℤ)) (F : UpperHalfPlane → Complex) :
    ∀ n : ℕ, (F ^ n) ∣[((n : ℤ) * k)] γ = (F ∣[k] γ) ^ n
  | 0 => by simpa using ModularForm.is_invariant_one γ
  | (n + 1) => by
      have hcast : (((n + 1 : ℕ) : ℤ) * k) = (n : ℤ) * k + k := by push_cast; ring
      rw [hcast, pow_succ, mul_slash, pow_slash k γ F n, pow_succ]

/-- At even weight, `-1 ∈ SL(2, ℤ)` acts trivially. -/
lemma slash_neg_one_twelve (F : UpperHalfPlane → Complex) :
    F ∣[(12 : ℤ)] (-1 : SL(2, ℤ)) = F := by
  funext τ
  rw [Work.Kernels.slash_apply']
  have h1 : ((-1 : SL(2, ℤ)) • τ : UpperHalfPlane) = τ := by
    apply UpperHalfPlane.ext
    simp
  have h2 : Work.Kernels.jFun (-1 : SL(2, ℤ)) (τ : ℂ) = -1 := by
    rw [Work.Kernels.jFun_apply]
    simp
  rw [h1, h2]
  norm_num

/-- `S * S = -1` in `SL(2, ℤ)`. -/
lemma S_mul_S : ModularGroup.S * ModularGroup.S = (-1 : SL(2, ℤ)) := by decide


/-- The upper half plane `{z : ℂ | 0 < z.im}` is convex. -/
lemma convex_im_pos : Convex ℝ {z : ℂ | 0 < z.im} := by
  intro x hx y hy a b ha hb hab
  simp only [Set.mem_ofPred_eq] at hx hy ⊢
  simp only [Complex.add_im, Complex.smul_im, smul_eq_mul]
  rcases eq_or_lt_of_le ha with h | h
  · have hb1 : 1 ≤ b := by linarith
    have h2 : 0 < b * y.im := mul_pos (lt_of_lt_of_le zero_lt_one hb1) hy
    have h1 : 0 ≤ a * x.im := mul_nonneg ha hx.le
    linarith
  · have h1 : 0 < a * x.im := mul_pos h hx
    have h2 : 0 ≤ b * y.im := mul_nonneg hb hy.le
    linarith

/-- **A pointwise product of holomorphic functions on `ℍ` which vanishes identically has a
vanishing factor.**  (The ring of holomorphic functions on `ℍ` is a domain.) -/
theorem mdiff_mul_eq_zero {f g : UpperHalfPlane → Complex} (hf : MDiff f) (hg : MDiff g)
    (h : ∀ τ : UpperHalfPlane, f τ * g τ = 0) : f = 0 ∨ g = 0 := by
  set U : Set ℂ := {z | 0 < z.im} with hUdef
  have hUopen : IsOpen U := isOpen_lt continuous_const Complex.continuous_im
  have hpre : IsPreconnected U := convex_im_pos.isPreconnected
  have hF : AnalyticOnNhd ℂ (fun z : ℂ => f (UpperHalfPlane.ofComplex z)) U :=
    ((UpperHalfPlane.mdifferentiable_iff).mp hf).analyticOnNhd hUopen
  have hG : AnalyticOnNhd ℂ (fun z : ℂ => g (UpperHalfPlane.ofComplex z)) U :=
    ((UpperHalfPlane.mdifferentiable_iff).mp hg).analyticOnNhd hUopen
  have hfg : ∀ z ∈ U, f (UpperHalfPlane.ofComplex z) * g (UpperHalfPlane.ofComplex z) = 0 :=
    fun z _ => h _
  rcases AnalyticOnNhd.eq_zero_or_eq_zero_of_mul_eq_zero hF hG hfg hpre with h1 | h1
  · left
    funext τ
    simpa [UpperHalfPlane.ofComplex_apply] using h1 (τ : ℂ) τ.im_pos
  · right
    funext τ
    simpa [UpperHalfPlane.ofComplex_apply] using h1 (τ : ℂ) τ.im_pos


/-- **A polynomial function that vanishes on the values of a nonvanishing function tending to
`0` at `i∞` is identically zero.**  (Induction on the degree: the value at `0` is a limit, so it
vanishes; divide by `X` and repeat.) -/
theorem polynomial_eq_zero_of_tendsto_zero {lam : UpperHalfPlane → Complex} {R : Polynomial ℂ}
    (hne : ∀ τ : UpperHalfPlane, lam τ ≠ 0)
    (ht : Filter.Tendsto lam UpperHalfPlane.atImInfty (nhds 0))
    (hR : ∀ τ : UpperHalfPlane, R.eval (lam τ) = 0) : R = 0 := by
  -- the value at `0` is a limit of values of `R` along `atImInfty`
  have hstep : ∀ S : Polynomial ℂ, (∀ τ : UpperHalfPlane, S.eval (lam τ) = 0) → S.eval 0 = 0 := by
    intro S hS
    have h1 : Filter.Tendsto (fun τ : UpperHalfPlane => S.eval (lam τ)) UpperHalfPlane.atImInfty
        (nhds (S.eval 0)) :=
      ((Polynomial.continuous S).tendsto 0).comp ht
    have h2 : Filter.Tendsto (fun τ : UpperHalfPlane => S.eval (lam τ)) UpperHalfPlane.atImInfty
        (nhds 0) := by
      simpa only [hS] using tendsto_const_nhds
    exact tendsto_nhds_unique h1 h2
  suffices ∀ n : ℕ, ∀ R : Polynomial ℂ, R.natDegree = n →
      (∀ τ : UpperHalfPlane, R.eval (lam τ) = 0) → R = 0 by
    exact this R.natDegree R rfl hR
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro R hdeg hR
    rcases eq_or_ne R 0 with h0 | h0
    · exact h0
    · have hdvd : Polynomial.X ∣ R := by
        rw [show (Polynomial.X : Polynomial ℂ) = Polynomial.X - Polynomial.C 0 by simp,
          Polynomial.dvd_iff_isRoot]
        exact hstep R hR
      obtain ⟨R₁, hR₁⟩ := hdvd
      have hne1 : R₁ ≠ 0 := by
        intro h
        rw [h, mul_zero] at hR₁
        exact h0 hR₁
      have hdeg1 : R₁.natDegree < n := by
        have : R.natDegree = R₁.natDegree + 1 := by
          rw [hR₁, Polynomial.natDegree_X_mul hne1]
        omega
      have hR1z : R₁ = 0 := by
        refine ih R₁.natDegree hdeg1 R₁ rfl ?_
        intro τ
        have hτ := hR τ
        rw [hR₁, Polynomial.eval_mul, Polynomial.eval_X] at hτ
        exact (mul_eq_zero.mp hτ).resolve_left (hne τ)
      rw [hR₁, hR1z, mul_zero]


/-- Pointwise version of `mul_slash`. -/
lemma mul_slash_apply (k l : ℤ) (γ : SL(2, ℤ)) (F G : UpperHalfPlane → Complex) (τ : UpperHalfPlane) :
    ((F * G) ∣[k + l] γ) τ = ((F ∣[k] γ) τ) * ((G ∣[l] γ) τ) := by
  rw [mul_slash]
  rfl

/-- Pointwise version of `mul3_slash`. -/
lemma mul3_slash_apply (k l m : ℤ) (γ : SL(2, ℤ)) (F G H : UpperHalfPlane → Complex)
    (τ : UpperHalfPlane) :
    ((F * G * H) ∣[k + l + m] γ) τ = ((F ∣[k] γ) τ) * ((G ∣[l] γ) τ) * ((H ∣[m] γ) τ) := by
  rw [mul3_slash]
  rfl

/-- The `q`-expansion coefficient functionals are additive on `M₁₂(H)`. -/
lemma coeff_add (hD : IsM12H D) (hE : IsM12H E) (n : ℕ) :
    (UpperHalfPlane.qExpansion 1 (D + E)).coeff n
      = (UpperHalfPlane.qExpansion 1 D).coeff n + (UpperHalfPlane.qExpansion 1 E).coeff n := by
  rw [UpperHalfPlane.qExpansion_add hD.analyticAt_cuspFunction hE.analyticAt_cuspFunction]
  simp


/-- The `q`-expansion coefficient functionals are `ℂ`-linear on `M₁₂(H)`. -/
lemma coeff_smul (hD : IsM12H D) (c : ℂ) (n : ℕ) :
    (UpperHalfPlane.qExpansion 1 (c • D)).coeff n
      = c * (UpperHalfPlane.qExpansion 1 D).coeff n := by
  rw [UpperHalfPlane.qExpansion_smul hD.analyticAt_cuspFunction c]
  simp

lemma coeff_neg (hD : IsM12H D) (n : ℕ) :
    (UpperHalfPlane.qExpansion 1 (-D)).coeff n = -((UpperHalfPlane.qExpansion 1 D).coeff n) := by
  have h := coeff_smul hD (-1 : ℂ) n
  simpa using h

lemma coeff_sub (hD : IsM12H D) (hE : IsM12H E) (n : ℕ) :
    (UpperHalfPlane.qExpansion 1 (D - E)).coeff n
      = (UpperHalfPlane.qExpansion 1 D).coeff n - (UpperHalfPlane.qExpansion 1 E).coeff n := by
  rw [sub_eq_add_neg, coeff_add hD hE.neg n, coeff_neg hE n]
  ring


end Basic

end Work.Rigidity
