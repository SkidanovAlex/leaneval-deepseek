import Mathlib
import Submission.Work.FreeProduct.Basic
import Submission.Work.FreeProduct.Length
import Submission.Work.FreeProduct.Tools
import Submission.Work.FreeProduct.Bridge
import Submission.Work.FreeProduct.Canonical
import Submission.Work.FreeProduct.Decomp
import Submission.Work.FreeProduct.LengthFacts
import Submission.Work.FreeProduct.ClaimL3
import Submission.Work.FreeProduct.orbit_corollary
import Submission.Work.FreeProduct.T_zpow_injective

/-!
# `(T - 1) ℂ[FP] ∩ μ ℂ[FP] = 0`

The goal of this file is `Work.FreeProduct.claim_L3`:

  `(Y - 1) * (TT - 1) * u = 0  →  u = 0`   in `ℂ[ℤ/2 ∗ ℤ/3]`.

Equivalently: no nonzero element of the left ideal generated by `T - 1` is annihilated by
`Y - 1`; i.e. `(T - 1) ℂ[FP] ∩ μ ℂ[FP] = 0` where `μ = 1 + y + y²` (the fixed space of left
multiplication by `y`).

The proof follows CKMRV Proposition 3.1 (case `ℐ_-`):

* `v = (T - 1) u` is fixed by left multiplication by `y`, hence `v = μ w` for some `w` whose
  support consists of elements which are `1` or start with `x` (`XF`),
* if `v ≠ 0` then `w ≠ 0`; take `γ₀` of maximal length in the support of `w` and look at the
  element `y γ₀`: its coefficient in `v = μ w` is the coefficient of `γ₀` in `w` (the other
  contributions would involve elements starting with `y` or `y²`, which are not in the support
  of `w`), and all other elements of the `⟨T⟩`-orbit of `y γ₀` are longer than every element of
  the support of `v`.  Then `orbit_corollary` (the discrete integral of `T - 1`) gives a
  contradiction.
* Hence `v = 0`, and `T - 1` is injective on `ℂ[FP]`, so `u = 0`.
-/

namespace Work.FreeProduct

open Work.Modular.PresGroup
open scoped MonoidAlgebra

noncomputable section

/-! ## Part 1: words and lengths -/

/-- The length of a single letter of `FP` is `1`. -/
theorem elen_letter (a : Letter) (ha : a.2 ≠ 1) :
    elen ((Monoid.CoprodI.of a.2 : FP)) = 1 := by
  have h1 : (Monoid.CoprodI.Word.empty : W).fstIdx ≠ some a.1 := by
    rw [fstIdx_empty]; exact fun h => nomatch h
  have hprod : (Monoid.CoprodI.Word.cons a.2 Monoid.CoprodI.Word.empty h1 ha).prod
      = Monoid.CoprodI.of a.2 := by
    rw [Monoid.CoprodI.Word.prod_cons, Monoid.CoprodI.Word.prod_empty, mul_one]
  have heq : Monoid.CoprodI.Word.equiv (Monoid.CoprodI.of a.2)
      = Monoid.CoprodI.Word.cons a.2 Monoid.CoprodI.Word.empty h1 ha :=
    eq_of_prod_eq (by rw [prod_equiv]; exact hprod)
  rw [elen, heq, wlen]
  rfl

theorem elen_x : elen (x : FP) = 1 := by
  rw [← of_Lx]; exact elen_letter Lx Lx_ne_one

theorem elen_y : elen (y : FP) = 1 := by
  rw [← of_Ly]; exact elen_letter Ly Ly_ne_one

theorem elen_y2 : elen (y2 : FP) = 1 := by
  rw [← of_Ly2]; exact elen_letter Ly2 Ly2_ne_one

/-- `y⁻¹ = y²`. -/
theorem y2_inv : (y2 : FP)⁻¹ = y := inv_eq_of_mul_eq_one_right y2_mul_y

/-- Prepending `y` to a word which is `1` or starts with `x`. -/
theorem toList_y_mul_of_XF {γ : FP} (h : XF γ) :
    (Monoid.CoprodI.Word.equiv (y * γ)).toList
      = ⟨true, Ly.2⟩ :: (Monoid.CoprodI.Word.equiv γ).toList := by
  rw [equiv_mul]
  exact toList_smul_of_fstIdx_ne (i := true) Ly.2 _ Ly_ne_one h

/-- Prepending `y²` to a word which is `1` or starts with `x`. -/
theorem toList_y2_mul_of_XF {γ : FP} (h : XF γ) :
    (Monoid.CoprodI.Word.equiv (y2 * γ)).toList
      = ⟨true, Ly2.2⟩ :: (Monoid.CoprodI.Word.equiv γ).toList := by
  rw [← of_Ly2, equiv_mul]
  exact toList_smul_of_fstIdx_ne (i := true) Ly2.2 _ Ly2_ne_one h

theorem elen_y_mul_of_XF {γ : FP} (h : XF γ) : elen (y * γ) = elen γ + 1 := by
  rw [elen, wlen, toList_y_mul_of_XF h]
  rfl

theorem elen_y2_mul_of_XF {γ : FP} (h : XF γ) : elen (y2 * γ) = elen γ + 1 := by
  rw [elen, wlen, toList_y2_mul_of_XF h]
  rfl

/-- `y * γ` is not `1` or starting with `x`. -/
theorem not_XF_y_mul {γ : FP} (h : XF γ) : ¬ XF (y * γ) := by
  rw [XF]
  have h1 : (Monoid.CoprodI.Word.equiv (y * γ)).fstIdx = some true := by
    rw [Monoid.CoprodI.Word.fstIdx, toList_y_mul_of_XF h]
    rfl
  rw [h1]
  exact fun hh => nomatch hh

/-- `y² * γ` is not `1` or starting with `x`. -/
theorem not_XF_y2_mul {γ : FP} (h : XF γ) : ¬ XF (y2 * γ) := by
  rw [XF]
  have h1 : (Monoid.CoprodI.Word.equiv (y2 * γ)).fstIdx = some true := by
    rw [Monoid.CoprodI.Word.fstIdx, toList_y2_mul_of_XF h]
    rfl
  rw [h1]
  exact fun hh => nomatch hh

/-- `y * γ` does not start with `x`. -/
theorem NX_y_mul_of_XF {γ : FP} (h : XF γ) : NX (y * γ) := by
  rw [NX, Monoid.CoprodI.Word.fstIdx, toList_y_mul_of_XF h]
  simp

/-- `y² * γ` does not start with `x`. -/
theorem NX_y2_mul_of_XF {γ : FP} (h : XF γ) : NX (y2 * γ) := by
  rw [NX, Monoid.CoprodI.Word.fstIdx, toList_y2_mul_of_XF h]
  simp

/-- If `γ` does not start with `x`, then `x * γ` does not start with a `ℤ/3`-letter. -/
theorem XF_x_mul_of_NX {γ : FP} (h : NX γ) : XF (x * γ) :=
  XF_of_startsLx (startsLx_x_mul h)

/-! ## Iterating `T` and `T⁻¹` -/

theorem T_pow_mul_startsLx (k : ℕ) {z : FP} (h : StartsLx z) :
    StartsLx (T ^ k * z) := by
  induction k with
  | zero => simpa using h
  | succ k ih => rw [pow_succ', mul_assoc]; exact T_mul_startsLx ih

theorem elen_T_pow_mul_of_startsLx (k : ℕ) {z : FP} (h : StartsLx z) :
    elen (T ^ k * z) = elen z + 2 * k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', mul_assoc, T_mul_elen (T_pow_mul_startsLx k h), ih]
    omega

theorem Tinv_pow_mul_startsLy2 (k : ℕ) {z : FP} (h : StartsLy2 z) :
    StartsLy2 ((T⁻¹) ^ k * z) := by
  induction k with
  | zero => simpa using h
  | succ k ih => rw [pow_succ', mul_assoc]; exact Tinv_mul_startsLy2 ih

theorem elen_Tinv_pow_mul_of_startsLy2 (k : ℕ) {z : FP} (h : StartsLy2 z) :
    elen ((T⁻¹) ^ k * z) = elen z + 2 * k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', mul_assoc, Tinv_mul_elen (Tinv_pow_mul_startsLy2 k h), ih]
    omega

/-! ## The two seeds: `T * y * γ` and `T⁻¹ * y * γ` -/

theorem toList_T_mul_y_mul_of_XF {γ : FP} (h : XF γ) :
    (Monoid.CoprodI.Word.equiv (T * (y * γ))).toList
      = [⟨false, Lx.2⟩, ⟨true, Ly2.2⟩] ++ (Monoid.CoprodI.Word.equiv γ).toList := by
  have h1 : T * (y * γ) = x * (y2 * γ) := by
    rw [T_eq, mul_assoc]
    congr 1
    rw [← mul_assoc, y2, pow_two]
  rw [h1, toList_x_mul (NX_y2_mul_of_XF h), toList_y2_mul_of_XF h]
  rfl

theorem startsLx_T_mul_y_mul_of_XF {γ : FP} (h : XF γ) : StartsLx (T * (y * γ)) := by
  rw [StartsLx, toList_T_mul_y_mul_of_XF h]
  rfl

theorem elen_T_mul_y_mul_of_XF {γ : FP} (h : XF γ) : elen (T * (y * γ)) = elen γ + 2 := by
  rw [elen, wlen, toList_T_mul_y_mul_of_XF h]
  simp [elen, wlen]

theorem toList_Tinv_mul_y_mul_of_XF {γ : FP} (h : XF γ) :
    (Monoid.CoprodI.Word.equiv (T⁻¹ * (y * γ))).toList
      = [⟨true, Ly2.2⟩, ⟨false, Lx.2⟩, ⟨true, Ly.2⟩]
        ++ (Monoid.CoprodI.Word.equiv γ).toList := by
  have h1 : T⁻¹ * (y * γ) = y2 * (x * (y * γ)) := by rw [Tinv_eq, mul_assoc]
  have hx := toList_x_mul (NX_y_mul_of_XF h)
  have h2 : (Monoid.CoprodI.Word.equiv (y2 * (x * (y * γ)))).toList
      = ⟨true, Ly2.2⟩ :: (Monoid.CoprodI.Word.equiv (x * (y * γ))).toList :=
    toList_y2_mul_of_XF (XF_x_mul_of_NX (NX_y_mul_of_XF h))
  rw [h1, h2, hx, toList_y_mul_of_XF h]
  rfl

theorem startsLy2_Tinv_mul_y_mul_of_XF {γ : FP} (h : XF γ) : StartsLy2 (T⁻¹ * (y * γ)) := by
  rw [StartsLy2, toList_Tinv_mul_y_mul_of_XF h]
  rfl

theorem elen_Tinv_mul_y_mul_of_XF {γ : FP} (h : XF γ) :
    elen (T⁻¹ * (y * γ)) = elen γ + 3 := by
  rw [elen, wlen, toList_Tinv_mul_y_mul_of_XF h]
  simp [elen, wlen]

theorem split_T_pow_mul (m : ℕ) (hm : 1 ≤ m) (z : FP) :
    T ^ m * z = T ^ (m - 1) * (T * z) := by
  have h1 : m = (m - 1) + 1 := by omega
  calc T ^ m * z = T ^ ((m - 1) + 1) * z := by conv_lhs => rw [h1]
    _ = (T ^ (m - 1) * T) * z := by rw [pow_succ]
    _ = T ^ (m - 1) * (T * z) := by rw [mul_assoc]

theorem split_Tinv_pow_mul (m : ℕ) (hm : 1 ≤ m) (z : FP) :
    (T⁻¹) ^ m * z = (T⁻¹) ^ (m - 1) * (T⁻¹ * z) := by
  have h1 : m = (m - 1) + 1 := by omega
  calc (T⁻¹) ^ m * z = (T⁻¹) ^ ((m - 1) + 1) * z := by conv_lhs => rw [h1]
    _ = ((T⁻¹) ^ (m - 1) * T⁻¹) * z := by rw [pow_succ]
    _ = (T⁻¹) ^ (m - 1) * (T⁻¹ * z) := by rw [mul_assoc]

/-- **The orbit of `y γ` leaves the support.**  If `n ≠ 0` and `γ` is `1` or starts with `x`,
then `Tⁿ (y γ)` is strictly longer than `y γ`. -/
theorem elen_T_zpow_mul_y_mul_of_XF {n : ℤ} (hn : n ≠ 0) {γ : FP} (h : XF γ) :
    elen γ + 1 < elen (T ^ n * (y * γ)) := by
  rcases lt_or_gt_of_ne hn.symm with hpos | hneg
  · -- 0 < n
    set m := n.toNat with hm
    have hcast : ((m : ℤ)) = n := by
      rw [hm]; exact Int.toNat_of_nonneg (by omega)
    have hm1 : 1 ≤ m := by omega
    have hT : T ^ n = T ^ m := by rw [← hcast, zpow_natCast]
    rw [hT, split_T_pow_mul m hm1 (y * γ),
      elen_T_pow_mul_of_startsLx (m - 1) (startsLx_T_mul_y_mul_of_XF h),
      elen_T_mul_y_mul_of_XF h]
    omega
  · -- n < 0
    set m := (-n).toNat with hm
    have hcast : ((m : ℤ)) = -n := by
      rw [hm]; exact Int.toNat_of_nonneg (by omega)
    have hm1 : 1 ≤ m := by omega
    have hT : T ^ n = (T⁻¹) ^ m := by
      have hnm : n = -((m : ℤ)) := by omega
      rw [hnm, zpow_neg, zpow_natCast, inv_pow]
    rw [hT, split_Tinv_pow_mul m hm1 (y * γ),
      elen_Tinv_pow_mul_of_startsLy2 (m - 1) (startsLy2_Tinv_mul_y_mul_of_XF h),
      elen_Tinv_mul_y_mul_of_XF h]
    omega


/-! ## Part 2: the group algebra computations -/

/-- A nonzero group algebra element has nonempty (coeff) support. -/
theorem support_nonempty_of_ne_zero {w : RR} (h : w ≠ 0) :
    (MonoidAlgebra.coeff w).support.Nonempty :=
  Finsupp.support_nonempty_iff.mpr fun h0 => h (MonoidAlgebra.coeff_eq_zero.mp h0)

/-- The expansion of `μ * w = (1 + y + y²) w`. -/
theorem coeff_MU_mul (w : RR) (δ : FP) :
    MonoidAlgebra.coeff (MU * w) δ =
      MonoidAlgebra.coeff w δ + MonoidAlgebra.coeff (Y * w) δ
        + MonoidAlgebra.coeff (Y2 * w) δ := by
  rw [MU, add_mul, add_mul, one_mul, MonoidAlgebra.coeff_add, MonoidAlgebra.coeff_add,
    Finsupp.add_apply, Finsupp.add_apply]

/-- **The leading coefficient of `μ w`.**  If the support of `w` consists of elements which are
`1` or start with `x`, then the coefficient of `y γ₀` in `μ w` is the coefficient of `γ₀` in
`w`: the other two summands of `μ w` contribute at `y γ₀` only through elements of the support
of `w` of the form `y γ₀` or `y² γ₀`, which start with a `ℤ/3`-letter. -/
theorem coeff_MU_mul_y_mul_of_mem {w : RR}
    (hX : ∀ γ ∈ (MonoidAlgebra.coeff w).support, XF γ) {γ₀ : FP}
    (hγ₀ : γ₀ ∈ (MonoidAlgebra.coeff w).support) :
    MonoidAlgebra.coeff (MU * w) (y * γ₀) = MonoidAlgebra.coeff w γ₀ := by
  rw [coeff_MU_mul w (y * γ₀)]
  have hY : MonoidAlgebra.coeff (Y * w) (y * γ₀) = MonoidAlgebra.coeff w γ₀ := by
    rw [show (Y : RR) = MonoidAlgebra.of ℂ FP y from rfl, coeff_of_mul y (y * γ₀) w,
      show y⁻¹ * (y * γ₀) = γ₀ from by group]
  have hY2 : MonoidAlgebra.coeff (Y2 * w) (y * γ₀) = 0 := by
    rw [show (Y2 : RR) = MonoidAlgebra.of ℂ FP y2 from rfl, coeff_of_mul y2 (y * γ₀) w,
      show y2⁻¹ * (y * γ₀) = y2 * γ₀ from by rw [y2_inv, y2, pow_two]; group]
    by_contra hc
    exact (not_XF_y2_mul (hX γ₀ hγ₀)) (hX (y2 * γ₀) (Finsupp.mem_support_iff.mpr hc))
  have h0 : MonoidAlgebra.coeff w (y * γ₀) = 0 := by
    by_contra hc
    exact (not_XF_y_mul (hX γ₀ hγ₀)) (hX (y * γ₀) (Finsupp.mem_support_iff.mpr hc))
  rw [hY, hY2, h0]
  ring

/-- **Length bound for the support of `μ w`.**  If every element of the support of `w` has length
at most `ℓ`, then every element of the support of `μ w` has length at most `ℓ + 1`. -/
theorem elen_le_of_mem_support_MU_mul {w : RR} {ℓ : ℕ}
    (hℓ : ∀ γ ∈ (MonoidAlgebra.coeff w).support, elen γ ≤ ℓ) :
    ∀ δ ∈ (MonoidAlgebra.coeff (MU * w)).support, elen δ ≤ ℓ + 1 := by
  intro δ hδ
  have hdecomp : MU * w = w + (Y * w + Y2 * w) := by
    rw [MU, add_mul, add_mul, one_mul]; abel
  rw [hdecomp] at hδ
  rcases Finset.mem_union.mp (Finsupp.support_add hδ) with hδ | hδ
  · exact le_trans (hℓ δ hδ) (by omega)
  · rcases Finset.mem_union.mp (Finsupp.support_add hδ) with hδ | hδ
    · -- the `Y * w` summand
      have hc : MonoidAlgebra.coeff (Y * w) δ ≠ 0 := Finsupp.mem_support_iff.mp hδ
      rw [show (Y : RR) = MonoidAlgebra.of ℂ FP y from rfl, coeff_of_mul y δ w] at hc
      have hγ : y⁻¹ * δ ∈ (MonoidAlgebra.coeff w).support := Finsupp.mem_support_iff.mpr hc
      have hδeq : δ = y * (y⁻¹ * δ) := by group
      have h2 : elen (y⁻¹ * δ) ≤ ℓ := hℓ _ hγ
      calc elen δ = elen (y * (y⁻¹ * δ)) := congrArg elen hδeq
        _ ≤ elen y + elen (y⁻¹ * δ) := elen_mul_le _ _
        _ ≤ ℓ + 1 := by rw [elen_y]; omega
    · -- the `Y2 * w` summand
      have hc : MonoidAlgebra.coeff (Y2 * w) δ ≠ 0 := Finsupp.mem_support_iff.mp hδ
      rw [show (Y2 : RR) = MonoidAlgebra.of ℂ FP y2 from rfl, coeff_of_mul y2 δ w] at hc
      have hγ : y2⁻¹ * δ ∈ (MonoidAlgebra.coeff w).support := Finsupp.mem_support_iff.mpr hc
      have hδeq : δ = y2 * (y2⁻¹ * δ) := by group
      have h2 : elen (y2⁻¹ * δ) ≤ ℓ := hℓ _ hγ
      calc elen δ = elen (y2 * (y2⁻¹ * δ)) := congrArg elen hδeq
        _ ≤ elen y2 + elen (y2⁻¹ * δ) := elen_mul_le _ _
        _ ≤ ℓ + 1 := by rw [elen_y2]; omega

/-- **Canonical form of the fixed space of left multiplication by `y`.**  If `Y v = v` then `v`
is `μ w` for some `w` whose support consists of elements which are `1` or start with `x`. -/
theorem exists_MU_mul_eq_of_Y_mul_self {v : RR} (hv : Y * v = v) :
    ∃ w : RR, MU * w = v ∧ ∀ γ ∈ (MonoidAlgebra.coeff w).support, XF γ := by
  have hY2 : Y2 * v = v := by rw [← Y_mul_Y, mul_assoc, hv, hv]
  have h3 : MU * v = v + v + v := by rw [MU, add_mul, add_mul, one_mul, hv, hY2]
  have h3' : v + v + v = (3 : ℂ) • v := by
    rw [show (3 : ℂ) = 2 + 1 by norm_num, add_smul, one_smul, two_smul]
  obtain ⟨w, hw, hX⟩ := exists_MU_canonical ((1 / 3 : ℂ) • v)
  refine ⟨w, ?_, hX⟩
  rw [hw, mul_smul_comm, h3, h3',
    show (1 / 3 : ℂ) = (3 : ℂ)⁻¹ by norm_num]
  exact inv_smul_smul₀ (by norm_num : (3 : ℂ) ≠ 0) v

/-- **The orbit witness.**  If `v = μ w` with `w ≠ 0` and the support of `w` consists of
elements which are `1` or start with `x`, then some `δ` has nonzero coefficient in `v` and all
its nonzero `⟨T⟩`-translates have zero coefficient: the orbit of `δ` meets the support of `v`
only at `δ`.

Namely, take `γ₀` of maximal length in the support of `w` and `δ = y γ₀`. -/
theorem exists_orbit_witness_of_MU_mul {v w : RR} (hw : MU * w = v) (hne : w ≠ 0)
    (hX : ∀ γ ∈ (MonoidAlgebra.coeff w).support, XF γ) :
    ∃ δ : FP, MonoidAlgebra.coeff v δ ≠ 0 ∧
      ∀ n : ℤ, n ≠ 0 → MonoidAlgebra.coeff v (T ^ n * δ) = 0 := by
  obtain ⟨γ₀, hγ₀mem, hγ₀max⟩ := Finset.exists_max_image (MonoidAlgebra.coeff w).support
    (fun γ => elen γ) (support_nonempty_of_ne_zero hne)
  refine ⟨y * γ₀, ?_, ?_⟩
  · rw [← hw, coeff_MU_mul_y_mul_of_mem hX hγ₀mem]
    exact Finsupp.mem_support_iff.mp hγ₀mem
  · intro n hn
    by_contra hc
    have hmem : T ^ n * (y * γ₀) ∈ (MonoidAlgebra.coeff (MU * w)).support := by
      rw [hw]
      exact Finsupp.mem_support_iff.mpr hc
    have hbound : elen (T ^ n * (y * γ₀)) ≤ elen γ₀ + 1 :=
      elen_le_of_mem_support_MU_mul (w := w) (ℓ := elen γ₀)
        (fun γ hγ => hγ₀max γ hγ) _ hmem
    have hlen : elen γ₀ + 1 < elen (T ^ n * (y * γ₀)) :=
      elen_T_zpow_mul_y_mul_of_XF hn (hX γ₀ hγ₀mem)
    omega

/-- **`T - 1` is injective on the group algebra.**  If `(T - 1) u = 0` then the support of `u`
is invariant under left multiplication by `T`, hence infinite if `u ≠ 0`, contradicting finite
support. -/
theorem TT_sub_one_eq_zero {u : RR} (h : (TT - 1) * u = 0) : u = 0 := by
  by_contra hne
  have htu : MonoidAlgebra.of ℂ FP T * u = u := by
    have h' : (MonoidAlgebra.of ℂ FP T - 1) * u = 0 := h
    rw [sub_mul, one_mul] at h'
    exact sub_eq_zero.mp h'
  obtain ⟨γ, hγ⟩ := support_nonempty_of_ne_zero hne
  have key : ∀ δ : FP, δ ∈ (MonoidAlgebra.coeff u).support →
      T * δ ∈ (MonoidAlgebra.coeff u).support := by
    intro δ hδ
    have h1 : MonoidAlgebra.coeff (MonoidAlgebra.of ℂ FP T * u) (T * δ)
        = MonoidAlgebra.coeff u δ := by
      rw [coeff_of_mul T (T * δ) u, show T⁻¹ * (T * δ) = δ from by group]
    have h2 : MonoidAlgebra.coeff u (T * δ) = MonoidAlgebra.coeff u δ := by
      rw [← h1, htu]
    exact Finsupp.mem_support_iff.mpr (by rw [h2]; exact Finsupp.mem_support_iff.mp hδ)
  have hmem : ∀ n : ℕ, T ^ n * γ ∈ (MonoidAlgebra.coeff u).support := by
    intro n
    induction n with
    | zero => simpa using hγ
    | succ n ih => rw [pow_succ', mul_assoc]; exact key _ ih
  have hinj : Function.Injective (fun n : ℕ => T ^ n * γ) := by
    intro m n hmn
    have h2 : T ^ m = T ^ n := mul_right_cancel hmn
    have h3 : (T ^ (m : ℤ)) = (T ^ (n : ℤ)) := by rw [zpow_natCast, zpow_natCast]; exact h2
    have h4 : (m : ℤ) = (n : ℤ) := T_zpow_injective h3
    exact_mod_cast h4
  refine Set.infinite_range_of_injective hinj ?_
  exact ((MonoidAlgebra.coeff u).support.finite_toSet).subset (fun x hx => by
    obtain ⟨n, rfl⟩ := hx
    exact hmem n)

/-! ## Part 3: the main theorem -/

theorem claim_L3 (u : MonoidAlgebra ℂ Work.Modular.PresGroup.FP)
    (h : (Work.FreeProduct.Y - 1) * (Work.FreeProduct.TT - 1) * u = 0) : u = 0 := by
  set v : RR := (TT - 1) * u with hv
  have hYv : Y * v = v := by
    have h' : (Y - 1) * v = 0 := by rw [hv, ← mul_assoc]; exact h
    rw [sub_mul, one_mul] at h'
    exact sub_eq_zero.mp h'
  by_contra hu
  have hvne : v ≠ 0 := by
    intro h0
    exact hu (TT_sub_one_eq_zero (by simpa [hv] using h0))
  obtain ⟨w, hw, hX⟩ := exists_MU_mul_eq_of_Y_mul_self hYv
  have hwne : w ≠ 0 := by
    intro h0
    exact hvne (by rw [← hw, h0, mul_zero])
  obtain ⟨δ, hδne, hrest⟩ := exists_orbit_witness_of_MU_mul hw hwne hX
  exact orbit_corollary (u := u) (w := v) (γ := δ) (c := MonoidAlgebra.coeff v δ)
    T_zpow_injective (by rw [hv]; rfl) rfl hδne hrest

end

end Work.FreeProduct
