/-
# The `𝓘̃₊`-annihilation of `K_+^{(d)}` in the `z` variable

CKMRV (Cohn--Kumar--Miller--Radchenko--Viazovska, Ann. of Math. 196 (2022)),
Proposition 4.6 (`prop:Kpmslashtilde`), asserts

  `K_±^{(d)}(τ, ·) ∣^z_{2-d/2} r = 0`   for all `r ∈ 𝓘̃_±`.

The ideal `𝓘̃₊` is generated by `T - 2I + T⁻¹ - 2S` and by `I - STS`.  This file proves the
first of these two statements for `K_+^{(d)}`, `d = 8, 24`, i.e.

  `TildeA 1 (2 - d/2) (fun z ↦ K_+^{(d)}(τ,z)) = 0`.

The argument decomposes `K_+^{(d)}(τ,z) = ∑_m c_m(z) φ̃_m(z)` with

  `c_m(z) = ∑_i φ_i(τ) Υ_+^{(d)}(τ,z)_{im}`   (`Work.Kernels.TildeFacts.KPlusCol`),

the point of the decomposition being that each `c_m` transforms as a modular form in `z` of
weight `4 - d/2 - 2m`:

* `c_m(z+1) = c_m(z)` (`KPlusCol_vadd_one`), and
* `c_m(S·z) = z^{4-d/2-2m} c_m(z)` (`KPlusCol_S_smul`),

while `φ̃_m` (`Work.Kernels.phitVec`) is annihilated by `T - 2I + T⁻¹ - 2S` in its own weight
`2m - 2` (`phitVec_tildeA`).  Since the two weights sum to `k = 2 - d/2`, the product
`∑_m c_m φ̃_m` is annihilated as well (`TildeA_mul_of`).
-/
import Mathlib
import Submission.Work.Kernels.TildeOps
import Submission.Work.Kernels.Kernels
import Submission.Work.Kernels.KernelEquations
import Submission.Work.Kernels.PhiAnnihilation
import Submission.Work.Kernels.KernelFacts.KPlusCoeff_slash_S
import Submission.Work.Kernels.KernelFacts.KPlus_T2
import Submission.Work.Kernels.KernelFacts.fk_slash

noncomputable section

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle

namespace Work.Kernels.TildeFacts

open Work.Kernels

/-! ## Elementary facts about `E₂|₂S` -/

lemma E2S_eq (z : ℍ) : E2S z = E2Fun z - 6 * Complex.I / ((Real.pi : ℂ) * (z : ℂ)) := by
  rw [E2S, KernelFacts.kpc_slash_S_apply, E2Fun_S_smul]
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  have hpi : (Real.pi : ℂ) ≠ 0 := by simpa using Real.pi_ne_zero
  field_simp

lemma E2S_S_smul (z : ℍ) : E2S (ModularGroup.S • z) = (z : ℂ) ^ 2 * E2Fun z := by
  rw [E2S, KernelFacts.kpc_slash_S_apply]
  rw [show ModularGroup.S • (ModularGroup.S • z) = z from by
        apply UpperHalfPlane.ext
        rw [S_smul_coe, S_smul_coe]
        have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
        field_simp]
  rw [S_smul_coe]
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  field_simp

lemma E2Fun_vadd_neg_one (z : ℍ) : E2Fun ((-1 : ℝ) +ᵥ z) = E2Fun z := by
  have h1 : (1 : ℝ) +ᵥ ((-1 : ℝ) +ᵥ z) = z := by
    apply UpperHalfPlane.ext
    rw [UpperHalfPlane.coe_vadd, UpperHalfPlane.coe_vadd]
    norm_num
  have h2 := E2Fun_vadd_one ((-1 : ℝ) +ᵥ z)
  rw [h1] at h2
  exact h2.symm

/-- The auxiliary function `G(z) = zE₂(z) - 6i/π = z(E₂|₂S)(z)`; the three basis functions
`φ̃_0, φ̃_1, φ̃_2` are `z²`, `z·G(z)`, `G(z)²`. -/
def Gt (z : ℍ) : ℂ := (z : ℂ) * E2Fun z - 6 * Complex.I / (Real.pi : ℂ)

lemma Gt_eq_E2S (z : ℍ) : Gt z = (z : ℂ) * E2S z := by
  rw [Gt, E2S_eq]
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  have hpi : (Real.pi : ℂ) ≠ 0 := by simpa using Real.pi_ne_zero
  field_simp

/-! ## The basis function `φ̃_m` written through `Gt` -/

lemma phitVec_zero (z : ℍ) : phitVec z 0 = (z : ℂ) ^ 2 := by
  simp [phitVec]

lemma phitVec_one (z : ℍ) : phitVec z 1 = (z : ℂ) * Gt z := by
  rw [show phitVec z 1 = (z : ℂ) ^ 2 * E2S z from by simp [phitVec], Gt_eq_E2S]
  ring

lemma phitVec_two (z : ℍ) : phitVec z 2 = Gt z ^ 2 := by
  rw [show phitVec z 2 = (z : ℂ) ^ 2 * E2S z ^ 2 from by simp [phitVec], Gt_eq_E2S]
  ring

/-! ## `T - 2I + T⁻¹ - 2S` annihilates each `φ̃_m` in its own weight -/

lemma TildeA_z_sq : TildeA 1 (-2) (fun z : ℍ => (z : ℂ) ^ 2) = 0 := by
  ext z
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  simp only [TildeA, Pi.zero_apply]
  rw [KernelFacts.kpc_slash_S_apply, S_smul_coe]
  rw [UpperHalfPlane.coe_vadd, UpperHalfPlane.coe_vadd]
  norm_num
  field_simp
  ring

lemma TildeA_z_mulGt : TildeA 1 0 (fun z : ℍ => (z : ℂ) * Gt z) = 0 := by
  ext z
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  have h1 : E2Fun ((-1 : ℝ) +ᵥ z) = E2Fun z := E2Fun_vadd_neg_one z
  simp only [TildeA, Pi.zero_apply, Gt, KernelFacts.kpc_slash_S_apply, S_smul_coe,
    UpperHalfPlane.coe_vadd, E2Fun_vadd_one, h1, E2Fun_S_smul]
  norm_num
  field_simp
  ring

lemma TildeA_Gt_sq : TildeA 1 2 (fun z : ℍ => Gt z ^ 2) = 0 := by
  ext z
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  have h1 : E2Fun ((-1 : ℝ) +ᵥ z) = E2Fun z := E2Fun_vadd_neg_one z
  simp only [TildeA, Pi.zero_apply, Gt, KernelFacts.kpc_slash_S_apply, S_smul_coe,
    UpperHalfPlane.coe_vadd, E2Fun_vadd_one, h1, E2Fun_S_smul]
  norm_num
  field_simp
  ring

/-- `T - 2I + T⁻¹ - 2S` annihilates `φ̃_m` in the weight `2m - 2`. -/
lemma phitVec_tildeA (m : Fin 3) :
    TildeA 1 (2 * ((m : ℕ) : ℤ) - 2) (fun z : ℍ => phitVec z m) = 0 := by
  have hm : m = 0 ∨ m = 1 ∨ m = 2 := by fin_cases m <;> simp
  rcases hm with rfl | rfl | rfl
  · have hw : (2 : ℤ) * (((0 : Fin 3) : ℕ) : ℤ) - 2 = (-2 : ℤ) := by norm_num
    rw [show (fun z : ℍ => phitVec z 0) = (fun z : ℍ => (z : ℂ) ^ 2) from funext phitVec_zero, hw]
    exact TildeA_z_sq
  · have hw : (2 : ℤ) * (((1 : Fin 3) : ℕ) : ℤ) - 2 = (0 : ℤ) := by norm_num
    rw [show (fun z : ℍ => phitVec z 1) = (fun z : ℍ => (z : ℂ) * Gt z) from funext phitVec_one, hw]
    exact TildeA_z_mulGt
  · have hw : (2 : ℤ) * (((2 : Fin 3) : ℕ) : ℤ) - 2 = (2 : ℤ) := by norm_num
    rw [show (fun z : ℍ => phitVec z 2) = (fun z : ℍ => Gt z ^ 2) from funext phitVec_two, hw]
    exact TildeA_Gt_sq

/-! ## Additivity and the product rule for `TildeA` -/

lemma TildeA_add (ε k : ℤ) (F G : ℍ → ℂ) :
    TildeA ε k (F + G) = TildeA ε k F + TildeA ε k G := by
  ext z
  simp only [TildeA, Pi.add_apply, SlashAction.add_slash]
  ring

lemma TildeA_zero (ε k : ℤ) : TildeA ε k (0 : ℍ → ℂ) = 0 := by
  ext z
  simp only [TildeA, Pi.zero_apply]
  rw [SlashAction.zero_slash]
  simp

lemma TildeA_sum {ι : Type*} (ε k : ℤ) (s : Finset ι) (F : ι → ℍ → ℂ) :
    TildeA ε k (∑ i ∈ s, F i) = ∑ i ∈ s, TildeA ε k (F i) := by
  classical
  induction s using Finset.induction with
  | empty => rw [Finset.sum_empty, Finset.sum_empty, TildeA_zero]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, TildeA_add, ih]

/-- If `G` is `T`-invariant, `G ∣[k₁] S = G`, and `T - 2I + T⁻¹ - 2S` kills `H` in weight
`k₂`, then it kills `G·H` in weight `k₁ + k₂`. -/
lemma TildeA_mul_of (ε : ℤ) (k k₁ k₂ : ℤ) (hk : k₁ + k₂ = k) (G H : ℍ → ℂ)
    (hG : ∀ z : ℍ, G ((1 : ℝ) +ᵥ z) = G z) (hGs : G ∣[k₁] ModularGroup.S = G)
    (hH : TildeA ε k₂ H = 0) :
    TildeA ε k (G * H) = 0 := by
  ext z
  have hH' := congr_fun hH z
  simp only [TildeA, Pi.zero_apply] at hH'
  have hgm1 : G ((-1 : ℝ) +ᵥ z) = G z := by
    have h1 : (1 : ℝ) +ᵥ ((-1 : ℝ) +ᵥ z) = z := by
      apply UpperHalfPlane.ext
      rw [UpperHalfPlane.coe_vadd, UpperHalfPlane.coe_vadd]; norm_num
    have h2 := hG ((-1 : ℝ) +ᵥ z)
    rw [h1] at h2
    exact h2.symm
  simp only [TildeA, Pi.zero_apply, Pi.mul_apply]
  rw [← hk, mul_slash_SL2, Pi.mul_apply, hG z, hgm1, congr_fun hGs z]
  linear_combination (G z) * hH'

/-! ## Matrix entries of products of diagonal matrices -/

lemma PiMat_mul_mul_entry (a : Fin 3 → ℤ) (M X : Matrix (Fin 3) (Fin 3) ℂ) (τ : ℍ)
    (i m : Fin 3) :
    (PiMat a τ * M * X) i m = fk (a i) τ * (M * X) i m := by
  rw [Matrix.mul_apply, Matrix.mul_apply, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [PiMat, Matrix.diagonal_mul]
  ring

lemma PiMat_mul_PiMat_entry (a b : Fin 3 → ℤ) (M : Matrix (Fin 3) (Fin 3) ℂ) (τ z : ℍ)
    (i m : Fin 3) :
    (PiMat a τ * M * PiMat b z) i m = fk (a i) τ * M i m * fk (b m) z := by
  rw [PiMat_mul_mul_entry]
  rw [show PiMat b z = Matrix.diagonal (fun j => fk (b j) z) from rfl, Matrix.mul_diagonal]
  ring

lemma PiMat_mul_diagonal_entry (a : Fin 3 → ℤ) (M : Matrix (Fin 3) (Fin 3) ℂ) (g : Fin 3 → ℂ)
    (τ : ℍ) (i m : Fin 3) :
    (PiMat a τ * M * Matrix.diagonal g) i m = fk (a i) τ * M i m * g m := by
  rw [PiMat_mul_mul_entry, Matrix.mul_diagonal]
  ring

/-! ## The transformation laws of `Υ_+^{(d)}` in the `z` variable -/

lemma UpsilonPlus_vadd_one_z (d : ℕ) (τ : ℍ) (i m : Fin 3) (z : ℍ) :
    UpsilonPlus d τ ((1 : ℝ) +ᵥ z) i m = UpsilonPlus d τ z i m := by
  simp only [UpsilonPlus]
  split_ifs <;>
    simp only [KernelFacts.PiMat_vadd_one, KernelFacts.jInvariantFun_vadd_one,
      KernelFacts.DeltaFun_vadd_one]

lemma UpsilonPlus_S_z (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : ℍ) (i m : Fin 3) (z : ℍ) :
    UpsilonPlus d τ (ModularGroup.S • z) i m
      = (z : ℂ) ^ (4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) * UpsilonPlus d τ z i m := by
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  rcases hd with rfl | rfl
  · have hΔ := KernelFacts.kpc_smul_S_of_slash KernelFacts.kpc_Delta_slash_S z
    have hJ := KernelFacts.kpc_jInvariant_S z
    have hPi := KernelFacts.kpc_PiMat_S (![12, 10, 8] : Fin 3 → ℤ) z
    simp only [UpsilonPlus, reduceIte]
    rw [hΔ, hJ, hPi]
    simp only [Matrix.smul_apply, smul_eq_mul]
    have hb : ((![12, 10, 8] : Fin 3 → ℤ) m : ℤ) = 12 - 2 * ((m : ℕ) : ℤ) := by
      fin_cases m <;> norm_num
    have hD : Matrix.diagonal (fun j => (z : ℂ) ^ ((![12, 10, 8] : Fin 3 → ℤ) j)) *
          PiMat ![12, 10, 8] z
        = Matrix.diagonal (fun j => (z : ℂ) ^ ((![12, 10, 8] : Fin 3 → ℤ) j) *
            fk ((![12, 10, 8] : Fin 3 → ℤ) j) z) := by
      rw [show PiMat ![12, 10, 8] z
            = Matrix.diagonal (fun j => fk ((![12, 10, 8] : Fin 3 → ℤ) j) z) from rfl]
      rw [Matrix.diagonal_mul_diagonal]
    rw [hD, PiMat_mul_diagonal_entry, PiMat_mul_PiMat_entry]
    have hw : (4 : ℤ) - ((8 : ℕ) : ℤ) / 2 - 2 * ((m : ℕ) : ℤ) = -2 * ((m : ℕ) : ℤ) := by
      norm_num
    rw [hw]
    have hC : (36 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * ((z : ℂ) ^ (12 : ℤ) * DeltaFun z) *
          (jInvariantFun τ - jInvariantFun z))⁻¹
        = (z : ℂ) ^ (-12 : ℤ) * (36 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * DeltaFun z *
          (jInvariantFun τ - jInvariantFun z))⁻¹ := by
      rw [show (36 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I *
            ((z : ℂ) ^ (12 : ℤ) * DeltaFun z) * (jInvariantFun τ - jInvariantFun z))
          = (36 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * DeltaFun z *
            (jInvariantFun τ - jInvariantFun z)) * (z : ℂ) ^ (12 : ℤ) from by ring]
      rw [show (z : ℂ) ^ (-12 : ℤ) = ((z : ℂ) ^ (12 : ℤ))⁻¹ from by rw [_root_.zpow_neg]]
      rw [_root_.mul_inv_rev]
    rw [hC]
    have hzpow : (z : ℂ) ^ (-12 : ℤ) * (z : ℂ) ^ ((![12, 10, 8] : Fin 3 → ℤ) m)
        = (z : ℂ) ^ (-2 * ((m : ℕ) : ℤ)) := by
      rw [← zpow_add₀ hz]; congr 1; rw [hb]; ring
    rw [show (z : ℂ) ^ (-12 : ℤ) * (36 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * DeltaFun z *
          (jInvariantFun τ - jInvariantFun z))⁻¹ *
          (fk ((![6, 4, 2] : Fin 3 → ℤ) i) τ *
            !![jInvariantFun τ - jInvariantFun z, 0, 1;
              -2 * (jInvariantFun τ - jInvariantFun z), -2, 0; 1, 0, 0] i m *
            ((z : ℂ) ^ ((![12, 10, 8] : Fin 3 → ℤ) m) * fk ((![12, 10, 8] : Fin 3 → ℤ) m) z))
        = ((z : ℂ) ^ (-12 : ℤ) * (z : ℂ) ^ ((![12, 10, 8] : Fin 3 → ℤ) m)) *
          ((36 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * DeltaFun z *
            (jInvariantFun τ - jInvariantFun z))⁻¹ *
          (fk ((![6, 4, 2] : Fin 3 → ℤ) i) τ *
            !![jInvariantFun τ - jInvariantFun z, 0, 1;
              -2 * (jInvariantFun τ - jInvariantFun z), -2, 0; 1, 0, 0] i m *
            fk ((![12, 10, 8] : Fin 3 → ℤ) m) z)) from by ring]
    rw [hzpow]
  · have hΔ := KernelFacts.kpc_smul_S_of_slash KernelFacts.kpc_Delta_slash_S z
    have hJ := KernelFacts.kpc_jInvariant_S z
    have hPi := KernelFacts.kpc_PiMat_S (![4, 2, 0] : Fin 3 → ℤ) z
    simp only [UpsilonPlus, reduceIte, if_neg (show ¬((24 : ℕ) = 8) by decide)]
    rw [hΔ]
    simp only [hJ]
    rw [hPi]
    simp only [Matrix.smul_apply, smul_eq_mul]
    have hb : ((![4, 2, 0] : Fin 3 → ℤ) m : ℤ) = 4 - 2 * ((m : ℕ) : ℤ) := by
      fin_cases m <;> norm_num
    have hD : Matrix.diagonal (fun j => (z : ℂ) ^ ((![4, 2, 0] : Fin 3 → ℤ) j)) *
          PiMat ![4, 2, 0] z
        = Matrix.diagonal (fun j => (z : ℂ) ^ ((![4, 2, 0] : Fin 3 → ℤ) j) *
            fk ((![4, 2, 0] : Fin 3 → ℤ) j) z) := by
      rw [show PiMat ![4, 2, 0] z
            = Matrix.diagonal (fun j => fk ((![4, 2, 0] : Fin 3 → ℤ) j) z) from rfl]
      rw [Matrix.diagonal_mul_diagonal]
    rw [hD, PiMat_mul_diagonal_entry, PiMat_mul_PiMat_entry]
    have hw : (4 : ℤ) - ((24 : ℕ) : ℤ) / 2 - 2 * ((m : ℕ) : ℤ) = -8 - 2 * ((m : ℕ) : ℤ) := by
      norm_num
    rw [hw]
    have hC : (36 * c1728 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I *
          ((z : ℂ) ^ (12 : ℤ) * DeltaFun z))⁻¹
        = (z : ℂ) ^ (-12 : ℤ) * (36 * c1728 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I *
          DeltaFun z)⁻¹ := by
      rw [show (36 * c1728 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I *
            ((z : ℂ) ^ (12 : ℤ) * DeltaFun z))
          = (36 * c1728 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * DeltaFun z) *
            (z : ℂ) ^ (12 : ℤ) from by ring]
      rw [show (z : ℂ) ^ (-12 : ℤ) = ((z : ℂ) ^ (12 : ℤ))⁻¹ from by rw [_root_.zpow_neg]]
      rw [_root_.mul_inv_rev]
    rw [hC]
    have hzpow : (z : ℂ) ^ (-12 : ℤ) * (z : ℂ) ^ ((![4, 2, 0] : Fin 3 → ℤ) m)
        = (z : ℂ) ^ (-8 - 2 * ((m : ℕ) : ℤ)) := by
      rw [← zpow_add₀ hz]; congr 1; rw [hb]; ring
    rw [show (z : ℂ) ^ (-12 : ℤ) * (36 * c1728 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I *
          DeltaFun z)⁻¹ *
          (fk ((![14, 12, 10] : Fin 3 → ℤ) i) τ *
            !![6, 0, c1728 * (jInvariantFun τ - jInvariantFun z)⁻¹ - 6;
              -12 * jInvariantFun τ + 5 * c1728, -2 * c1728 * (jInvariantFun τ - jInvariantFun z)⁻¹,
                12 * jInvariantFun τ - 7 * c1728;
              c1728 * (jInvariantFun τ - jInvariantFun z)⁻¹ + 6, 0, -6] i m *
            ((z : ℂ) ^ ((![4, 2, 0] : Fin 3 → ℤ) m) * fk ((![4, 2, 0] : Fin 3 → ℤ) m) z))
        = ((z : ℂ) ^ (-12 : ℤ) * (z : ℂ) ^ ((![4, 2, 0] : Fin 3 → ℤ) m)) *
          ((36 * c1728 * (Real.pi : ℂ) ^ (-2 : ℤ) * Complex.I * DeltaFun z)⁻¹ *
          (fk ((![14, 12, 10] : Fin 3 → ℤ) i) τ *
            !![6, 0, c1728 * (jInvariantFun τ - jInvariantFun z)⁻¹ - 6;
              -12 * jInvariantFun τ + 5 * c1728, -2 * c1728 * (jInvariantFun τ - jInvariantFun z)⁻¹,
                12 * jInvariantFun τ - 7 * c1728;
              c1728 * (jInvariantFun τ - jInvariantFun z)⁻¹ + 6, 0, -6] i m *
            fk ((![4, 2, 0] : Fin 3 → ℤ) m) z)) from by ring]
    rw [hzpow]

/-! ## The `m`-th column coefficient of `K_+^{(d)}(τ, ·)` -/

/-- `c_m^{τ}(z) = ∑_i φ_i(τ) Υ_+^{(d)}(τ,z)_{im}`, the coefficient of `φ̃_m(z)` in
`K_+^{(d)}(τ,z)`. -/
def KPlusCol (d : ℕ) (τ : ℍ) (m : Fin 3) : ℍ → ℂ :=
  fun z => ∑ i : Fin 3, phiVec τ i * UpsilonPlus d τ z i m

lemma KPlus_colsum (d : ℕ) (τ z : ℍ) :
    KPlus d τ z = ∑ m : Fin 3, KPlusCol d τ m z * phitVec z m := by
  simp only [KPlus, KPlusCol]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun m _ => ?_)
  rw [Finset.sum_mul]

lemma KPlusCol_vadd_one (d : ℕ) (τ : ℍ) (m : Fin 3) (z : ℍ) :
    KPlusCol d τ m ((1 : ℝ) +ᵥ z) = KPlusCol d τ m z := by
  simp only [KPlusCol]
  exact Finset.sum_congr rfl (fun i _ => by rw [UpsilonPlus_vadd_one_z])

lemma KPlusCol_S_smul (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : ℍ) (m : Fin 3) (z : ℍ) :
    KPlusCol d τ m (ModularGroup.S • z)
      = (z : ℂ) ^ (4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) * KPlusCol d τ m z := by
  simp only [KPlusCol, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [UpsilonPlus_S_z d hd τ i m z]
  ring

lemma KPlusCol_slash_S (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : ℍ) (m : Fin 3) :
    KPlusCol d τ m ∣[(4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ))] ModularGroup.S = KPlusCol d τ m := by
  ext z
  rw [KernelFacts.kpc_slash_S_apply, KPlusCol_S_smul d hd τ m z]
  have hz : (z : ℂ) ≠ 0 := KernelFacts.kpc_tau_ne_zero z
  have h1 : (z : ℂ) ^ (4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) *
      (z : ℂ) ^ (-(4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ))) = 1 := by
    rw [← zpow_add₀ hz, add_neg_cancel, zpow_zero]
  rw [show (z : ℂ) ^ (4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) * KPlusCol d τ m z *
        (z : ℂ) ^ (-(4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)))
      = ((z : ℂ) ^ (4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) *
        (z : ℂ) ^ (-(4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)))) * KPlusCol d τ m z from by ring,
      h1, one_mul]

/-! ## The main theorem -/

theorem KPlus_z_tildeA (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : UpperHalfPlane) :
    Work.Kernels.TildeA 1 (2 - (d : ℤ) / 2) (fun z : UpperHalfPlane => Work.Kernels.KPlus d τ z) = 0 := by
  have hdecomp : (fun z : ℍ => KPlus d τ z)
      = ∑ m : Fin 3, (fun z : ℍ => KPlusCol d τ m z * phitVec z m) := by
    funext z
    simp only [Finset.sum_apply]
    exact KPlus_colsum d τ z
  rw [hdecomp, TildeA_sum]
  refine Finset.sum_eq_zero (fun m _ => ?_)
  exact TildeA_mul_of 1 (2 - (d : ℤ) / 2) (4 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ))
    (2 * ((m : ℕ) : ℤ) - 2) (by ring) (KPlusCol d τ m) (fun z => phitVec z m)
    (fun z => KPlusCol_vadd_one d τ m z) (KPlusCol_slash_S d hd τ m) (phitVec_tildeA m)

end Work.Kernels.TildeFacts
