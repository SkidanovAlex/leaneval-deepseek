/-
# The `𝓘̃₋`-annihilation of `K_-^{(d)}` in the `z` variable

CKMRV (Cohn--Kumar--Miller--Radchenko--Viazovska, Ann. of Math. 196 (2022)),
Proposition 4.6 (`prop:Kpmslashtilde`), asserts

  `K_±^{(d)}(τ, ·) ∣^z_{2-d/2} r = 0`   for all `r ∈ 𝓘̃_±`.

The ideal `𝓘̃₋` is generated by `T - 2I + T⁻¹ + 2S` and by `I + STS`.  This file proves the
first of these two statements for `K_-^{(d)}`, `d = 8, 24`, i.e.

  `TildeA (-1) (2 - d/2) (fun z ↦ K_-^{(d)}(τ,z)) = 0`.

The argument decomposes `K_-^{(d)}(τ,z) = ∑_m c_m(z) ψ̃_m(z)` with

  `c_m(z) = ∑_i ψ_i(τ) Υ_-^{(d)}(τ,z)_{im}`   (`Work.Kernels.TildeFacts.KMinusCol`),

the point of the decomposition being that each `c_m` transforms as a modular form in `z` of
weight `2 - d/2 - 2m`:

* `c_m(z+1) = c_m(z)` (`KMinusCol_vadd_one_kza`), and
* `c_m(S·z) = z^{2-d/2-2m} c_m(z)` (`KMinusCol_S_smul_kza`),

while `ψ̃_m` (`Work.Kernels.psitVec`) is annihilated by `T - 2I + T⁻¹ + 2S` in its own weight
`2m` (`psitVec_tildeA_kza`).  Since the two weights sum to `k = 2 - d/2`, the product
`∑_m c_m ψ̃_m` is annihilated as well (`kza_mul_of`).
-/
import Mathlib
import Submission.Work.Kernels.TildeOps
import Submission.Work.Kernels.Kernels
import Submission.Work.Kernels.KernelEquations
import Submission.Work.Kernels.PhiAnnihilation
import Submission.Work.Kernels.KernelSlash
import Submission.Work.Kernels.KernelFacts.KMinus_T2
import Submission.Work.Kernels.TildeFacts.theta_quartic
import Submission.Work.Kernels.TildeFacts.UpsilonMinus_vadd_one_z
import Submission.Work.Kernels.TildeFacts.UpsilonMinus_S_z

noncomputable section

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle

namespace Work.Kernels.TildeFacts

open Work.Kernels

/-! ## `z ↦ z + 1` and `z ↦ -1/z` for the three reductions -/

lemma kza_vadd_neg_one_add_one (z : ℍ) : (1 : ℝ) +ᵥ ((-1 : ℝ) +ᵥ z) = z := by
  apply UpperHalfPlane.ext
  rw [UpperHalfPlane.coe_vadd, UpperHalfPlane.coe_vadd]
  norm_num

lemma kza_zpow_neg_four (z : ℂ) : z ^ (-4 : ℤ) = (z ^ 4)⁻¹ := by
  rw [show (-4 : ℤ) = -(4 : ℤ) from rfl, _root_.zpow_neg]
  norm_num

/-! ## The two `T`-laws of `𝓛` -/

lemma kza_L_vadd_neg_one (ℓ : LogLambdaData) (z : ℍ) :
    ℓ.L ((-1 : ℝ) +ᵥ z) = ℓ.L z - ℓ.L_S z - (Real.pi : ℂ) * Complex.I := by
  have h1 : (1 : ℝ) +ᵥ ((-1 : ℝ) +ᵥ z) = z := kza_vadd_neg_one_add_one z
  have h := KernelFacts.L_vadd_one ℓ ((-1 : ℝ) +ᵥ z)
  rw [h1] at h
  have h2 := KernelFacts.L_S_vadd_one ℓ ((-1 : ℝ) +ᵥ z)
  rw [h1] at h2
  linear_combination -h + h2

/-! ## The annihilation of the three components of `ψ̃ = (𝓛, W, U² - V²)` -/

lemma kza_L_tildeA (ℓ : LogLambdaData) :
    TildeA (-1) 0 (fun z : ℍ => ℓ.L z) = 0 := by
  ext z
  have h1 := KernelFacts.L_vadd_one ℓ z
  have h2 := kza_L_vadd_neg_one ℓ z
  have h3 : ((fun w : ℍ => ℓ.L w) ∣[(0 : ℤ)] ModularGroup.S) z = ℓ.L_S z := by
    rw [show (fun w : ℍ => ℓ.L w) = ℓ.L from rfl]
    exact congr_fun ℓ.slash_S z
  simp only [TildeA, Pi.zero_apply]
  rw [h1, h2, h3]
  push_cast
  ring

lemma kza_W_tildeA (_ℓ : LogLambdaData) :
    TildeA (-1) 2 (fun z : ℍ => WFun z) = 0 := by
  ext z
  have h1 : WFun ((1 : ℝ) +ᵥ z) = UFun z := KernelFacts.WFun_vadd_one z
  have h2 : WFun ((-1 : ℝ) +ᵥ z) = UFun z := by
    have hh := KernelFacts.UFun_vadd_one ((-1 : ℝ) +ᵥ z)
    rw [kza_vadd_neg_one_add_one] at hh
    exact hh.symm
  have h3 : ((fun z : ℍ => WFun z) ∣[(2 : ℤ)] ModularGroup.S) z = - VFun z := by
    rw [slash_S_apply, KernelFacts.WFun_S_smul z, KernelFacts.zpow_neg_two]
    have hz : (z : ℂ) ≠ 0 := coe_tau_ne_zero z
    field_simp
  simp only [TildeA, Pi.zero_apply]
  rw [h1, h2, h3]
  push_cast
  rw [theta_quartic z]
  ring

lemma kza_U2V2_tildeA (_ℓ : LogLambdaData) :
    TildeA (-1) 4 (fun z : ℍ => UFun z ^ 2 - VFun z ^ 2) = 0 := by
  ext z
  have h1 : UFun ((1 : ℝ) +ᵥ z) = WFun z := KernelFacts.UFun_vadd_one z
  have h2 : VFun ((1 : ℝ) +ᵥ z) = - VFun z := KernelFacts.VFun_vadd_one z
  have h3 : UFun ((-1 : ℝ) +ᵥ z) = WFun z := by
    have hh := KernelFacts.WFun_vadd_one ((-1 : ℝ) +ᵥ z)
    rw [kza_vadd_neg_one_add_one] at hh
    exact hh.symm
  have h4 : VFun ((-1 : ℝ) +ᵥ z) = - VFun z := by
    have hh := KernelFacts.VFun_vadd_one ((-1 : ℝ) +ᵥ z)
    rw [kza_vadd_neg_one_add_one] at hh
    linear_combination hh
  have h5 : ((fun z : ℍ => UFun z ^ 2 - VFun z ^ 2) ∣[(4 : ℤ)] ModularGroup.S) z
      = UFun z ^ 2 - WFun z ^ 2 := by
    rw [slash_S_apply, KernelFacts.UFun_S_smul z, KernelFacts.VFun_S_smul_km z,
      kza_zpow_neg_four]
    have hz : (z : ℂ) ≠ 0 := coe_tau_ne_zero z
    field_simp
  simp only [TildeA, Pi.zero_apply]
  rw [h1, h2, h3, h4, h5]
  push_cast
  ring

/-- `T - 2I + T⁻¹ + 2S` annihilates each component `ψ̃_m` of `ψ̃ = (𝓛, W, U²-V²)` in the
weight `2m` (CKMRV Proposition 4.5). -/
lemma psitVec_tildeA_kza (ℓ : LogLambdaData) (m : Fin 3) :
    TildeA (-1) (2 * ((m : ℕ) : ℤ)) (fun z : ℍ => psitVec ℓ z m) = 0 := by
  have hm : m = 0 ∨ m = 1 ∨ m = 2 := by fin_cases m <;> simp
  rcases hm with rfl | rfl | rfl
  · have hw : (2 : ℤ) * (((0 : Fin 3) : ℕ) : ℤ) = (0 : ℤ) := by norm_num
    rw [show (fun z : ℍ => psitVec ℓ z 0) = (fun z : ℍ => ℓ.L z) from by
      funext z; simp [psitVec], hw]
    exact kza_L_tildeA ℓ
  · have hw : (2 : ℤ) * (((1 : Fin 3) : ℕ) : ℤ) = (2 : ℤ) := by norm_num
    rw [show (fun z : ℍ => psitVec ℓ z 1) = (fun z : ℍ => WFun z) from by
      funext z; simp [psitVec], hw]
    exact kza_W_tildeA ℓ
  · have hw : (2 : ℤ) * (((2 : Fin 3) : ℕ) : ℤ) = (4 : ℤ) := by norm_num
    rw [show (fun z : ℍ => psitVec ℓ z 2) = (fun z : ℍ => UFun z ^ 2 - VFun z ^ 2) from by
      funext z; simp [psitVec], hw]
    exact kza_U2V2_tildeA ℓ

/-! ## Additivity and the product rule for `TildeA` -/

lemma kza_add (ε k : ℤ) (F G : ℍ → ℂ) :
    TildeA ε k (F + G) = TildeA ε k F + TildeA ε k G := by
  ext z
  simp only [TildeA, Pi.add_apply, SlashAction.add_slash]
  ring

lemma kza_zero (ε k : ℤ) : TildeA ε k (0 : ℍ → ℂ) = 0 := by
  ext z
  simp only [TildeA, Pi.zero_apply]
  rw [SlashAction.zero_slash]
  simp

lemma kza_sum {ι : Type*} (ε k : ℤ) (s : Finset ι) (F : ι → ℍ → ℂ) :
    TildeA ε k (∑ i ∈ s, F i) = ∑ i ∈ s, TildeA ε k (F i) := by
  classical
  induction s using Finset.induction with
  | empty => rw [Finset.sum_empty, Finset.sum_empty, kza_zero]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, kza_add, ih]

/-- If `G` is `T`-invariant, `G ∣[k₁] S = G`, and `T - 2I + T⁻¹ + 2S` kills `H` in weight
`k₂`, then it kills `G·H` in weight `k₁ + k₂`. -/
lemma kza_mul_of (ε : ℤ) (k k₁ k₂ : ℤ) (hk : k₁ + k₂ = k) (G H : ℍ → ℂ)
    (hG : ∀ z : ℍ, G ((1 : ℝ) +ᵥ z) = G z) (hGs : G ∣[k₁] ModularGroup.S = G)
    (hH : TildeA ε k₂ H = 0) :
    TildeA ε k (G * H) = 0 := by
  ext z
  have hH' := congr_fun hH z
  simp only [TildeA, Pi.zero_apply] at hH'
  have hgm1 : G ((-1 : ℝ) +ᵥ z) = G z := by
    have h1 : (1 : ℝ) +ᵥ ((-1 : ℝ) +ᵥ z) = z := kza_vadd_neg_one_add_one z
    have h2 := hG ((-1 : ℝ) +ᵥ z)
    rw [h1] at h2
    exact h2.symm
  simp only [TildeA, Pi.zero_apply, Pi.mul_apply]
  rw [← hk, mul_slash_SL2, Pi.mul_apply, hG z, hgm1, congr_fun hGs z]
  linear_combination (G z) * hH'

/-! ## The `m`-th column coefficient of `K_-^{(d)}(τ, ·)` -/

/-- `c_m^{τ}(z) = ∑_i ψ_i(τ) Υ_-^{(d)}(τ,z)_{im}`, the coefficient of `ψ̃_m(z)` in
`K_-^{(d)}(τ,z)`. -/
def KMinusCol (ℓ : LogLambdaData) (d : ℕ) (τ : ℍ) (m : Fin 3) : ℍ → ℂ :=
  fun z => ∑ i : Fin 3, psiVec ℓ τ i * UpsilonMinus d τ z i m

lemma KMinus_colsum_kza (ℓ : LogLambdaData) (d : ℕ) (τ z : ℍ) :
    KMinus ℓ d τ z = ∑ m : Fin 3, KMinusCol ℓ d τ m z * psitVec ℓ z m := by
  simp only [KMinus, KMinusCol]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun m _ => ?_)
  rw [Finset.sum_mul]

lemma KMinusCol_vadd_one_kza (ℓ : LogLambdaData) (d : ℕ) (τ : ℍ) (m : Fin 3) (z : ℍ) :
    KMinusCol ℓ d τ m ((1 : ℝ) +ᵥ z) = KMinusCol ℓ d τ m z := by
  simp only [KMinusCol]
  exact Finset.sum_congr rfl (fun i _ => by rw [UpsilonMinus_vadd_one_z])

lemma KMinusCol_S_smul_kza (ℓ : LogLambdaData) (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : ℍ)
    (m : Fin 3) (z : ℍ) :
    KMinusCol ℓ d τ m (ModularGroup.S • z)
      = (z : ℂ) ^ (2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) * KMinusCol ℓ d τ m z := by
  simp only [KMinusCol, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [UpsilonMinus_S_z d hd τ i m z]
  ring

lemma KMinusCol_slash_S_kza (ℓ : LogLambdaData) (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : ℍ)
    (m : Fin 3) :
    KMinusCol ℓ d τ m ∣[(2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ))] ModularGroup.S
      = KMinusCol ℓ d τ m := by
  ext z
  rw [slash_S_apply, KMinusCol_S_smul_kza ℓ d hd τ m z]
  have hz : (z : ℂ) ≠ 0 := coe_tau_ne_zero z
  have h1 : (z : ℂ) ^ (2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) *
      (z : ℂ) ^ (-(2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ))) = 1 := by
    rw [← zpow_add₀ hz, add_neg_cancel, zpow_zero]
  rw [show (z : ℂ) ^ (2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) * KMinusCol ℓ d τ m z *
        (z : ℂ) ^ (-(2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)))
      = ((z : ℂ) ^ (2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)) *
        (z : ℂ) ^ (-(2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ)))) * KMinusCol ℓ d τ m z from by ring,
      h1, one_mul]

/-! ## The main theorem -/

theorem KMinus_z_tildeA (ℓ : Work.Kernels.LogLambdaData) (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : UpperHalfPlane) :
    Work.Kernels.TildeA (-1) (2 - (d : ℤ) / 2) (fun z : UpperHalfPlane => Work.Kernels.KMinus ℓ d τ z) = 0 := by
  have hdecomp : (fun z : ℍ => KMinus ℓ d τ z)
      = ∑ m : Fin 3, (fun z : ℍ => KMinusCol ℓ d τ m z * psitVec ℓ z m) := by
    funext z
    simp only [Finset.sum_apply]
    exact KMinus_colsum_kza ℓ d τ z
  rw [hdecomp, kza_sum]
  refine Finset.sum_eq_zero (fun m _ => ?_)
  exact kza_mul_of (-1) (2 - (d : ℤ) / 2) (2 - (d : ℤ) / 2 - 2 * ((m : ℕ) : ℤ))
    (2 * ((m : ℕ) : ℤ)) (by ring) (KMinusCol ℓ d τ m) (fun z => psitVec ℓ z m)
    (fun z => KMinusCol_vadd_one_kza ℓ d τ m z) (KMinusCol_slash_S_kza ℓ d hd τ m)
    (psitVec_tildeA_kza ℓ m)

end Work.Kernels.TildeFacts
