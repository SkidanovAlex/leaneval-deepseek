/-
# The `z`-functional equation `K_-^{(d)}(τ,·) |^z_{2-d/2} (I + STS) = 0`

CKMRV (Cohn--Kumar--Miller--Radchenko--Viazovska, Ann. of Math. 196 (2022)) Proposition
`prop:Kpmslashtilde` states that the kernels `K_±^{(d)}` constructed in Theorem 4.9 satisfy
`K_±(τ,z) |^z_{2-d/2} r = 0` for all `r ∈ 𝓘̃_±`.  The right ideal `𝓘̃_-` is generated by
`T - 2I + T⁻¹ + 2S` and by `I + STS`; this file proves the annihilation by the second
generator `I + STS` in the `z` variable, i.e.

  `TildeB (-1) (2 - d/2) (fun z ↦ K_-^{(d)}(τ,z)) = 0`.

Writing `σ = STS ∈ SL(2,ℤ)` (so `σ • z = z/(1-z)`), the statement says
`(K_-^{(d)}(τ,·)) ∣[2-d/2] σ = -(K_-^{(d)}(τ,·))`.

The proof is termwise.  For fixed `i j : Fin 3`,
`z ↦ Υ_-^{(d)}(τ,z)_{ij} ψ̃_j(z)` equals a `z`-constant multiple of `F τ i j * G ℓ j`, where

* `F τ i j = (fun z ↦ A^{(d)}(τ,z)_{ij}) * H τ`, whose two factors are `σ`-invariant of
  weight `0` and `-12` respectively (`A^{(d)}` is the numerator matrix of `Υ_-^{(d)}` and
  `H τ z = (Δ(z)(j(τ)-j(z)))⁻¹`), and
* `G ℓ j = fk (w_j) · ψ̃_j`, which is *anti*-invariant of weight `b_j + 2j = 14 - d/2`
  because `fk k` is modular of weight `k` and `ψ̃_0 = 𝓛`, `ψ̃_2 = W`, `ψ̃_4 = U² - V²`
  satisfy `ψ̃_j(σz) = -(j(σ,z))^{2j} ψ̃_j(z)`.

Since `-12 + (b_j + 2j) = -12 + 14 - d/2 = 2 - d/2`, the product `F τ i j * G ℓ j` is also
anti-invariant, hence annihilated by `TildeB (-1) (2 - d/2)`; summing over `i` and `j`
gives the result.
-/
import Mathlib
import Submission.Work.Kernels.TildeOps
import Submission.Work.Kernels.Kernels
import Submission.Work.Kernels.KernelEquations
import Submission.Work.Kernels.PhiAnnihilation
import Submission.Work.Kernels.KernelFacts.psi2_T2
import Submission.Work.Kernels.KernelFacts.KPlus_S_add
import Submission.Work.Kernels.KernelSlash
import Submission.Work.Kernels.KernelFacts.KMinus_T2

namespace Work.Kernels.TildeFacts

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle

noncomputable section

/- The helper declarations of this file, in a dedicated namespace to avoid clashing with
other files in `Work.Kernels.TildeFacts`. -/
namespace Kzb

/-- The element `σ = S·T·S` of `SL(2,ℤ)`; its slash action is the Möbius map
`z ↦ z/(1-z)`, with factor of automorphy `j(σ,z) = z - 1`. -/
abbrev sig : SL(2,ℤ) := ModularGroup.S * ModularGroup.T * ModularGroup.S

/-! ## Elementary lemmas on the slash action -/

lemma tau_ne_zero (τ : ℍ) : (τ : ℂ) ≠ 0 := fun h =>
  τ.im_ne_zero (by rw [← coe_im τ, h]; simp)

lemma jFun_sig (z : ℂ) : Work.Kernels.jFun sig z = z - 1 := by
  rw [Work.Kernels.jFun_apply]
  have h10 : ((sig : SL(2,ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 1 := by decide
  have h11 : ((sig : SL(2,ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = -1 := by decide
  rw [h10, h11]
  push_cast
  ring

lemma jFun_sig_ne_zero (z : ℍ) : Work.Kernels.jFun sig (z : ℂ) ≠ 0 := by
  rw [jFun_sig]
  intro h
  have : (z : ℂ) = 1 := by linear_combination h
  exact z.im_ne_zero (by rw [← coe_im z, this]; simp)

lemma slash_S_eq (k : ℤ) (F : ℍ → ℂ) :
    F ∣[k] ModularGroup.S = fun τ => F (ModularGroup.S • τ) * (τ : ℂ) ^ (-k) := by
  funext τ; rw [Work.Kernels.slash_S_apply]

lemma slash_T_eq (k : ℤ) (F : ℍ → ℂ) :
    F ∣[k] ModularGroup.T = fun τ => F ((1 : ℝ) +ᵥ τ) := by
  funext τ; rw [Work.Kernels.slash_T_apply]

/-- The inverse of a slashed function is the slash of the inverse in the opposite weight. -/
lemma inv_slash_pt (k : ℤ) (γ : SL(2,ℤ)) (F : ℍ → ℂ) (z : ℍ) :
    ((fun z => (F z)⁻¹) ∣[k] γ) z = ((F ∣[-k] γ) z)⁻¹ := by
  rw [Work.Kernels.slash_apply', Work.Kernels.slash_apply', _root_.mul_inv_rev, neg_neg,
    _root_.zpow_neg]
  ring

/-- A function which is `γ`-invariant of weight `k` satisfies `F(γ•z) = j(γ,z)^k F(z)`. -/
lemma smul_of_slash {k : ℤ} {γ : SL(2,ℤ)} {F : ℍ → ℂ} (hF : F ∣[k] γ = F) (z : ℍ) :
    F (γ • z) = (Work.Kernels.jFun γ (z : ℂ)) ^ k * F z := by
  have h := congr_fun hF z
  rw [Work.Kernels.slash_apply'] at h
  have hτ : Work.Kernels.jFun γ (z : ℂ) ≠ 0 := Work.Kernels.jFun_ne_zero γ z
  calc F (γ • z) = F (γ • z) * 1 := by rw [mul_one]
    _ = F (γ • z) * ((Work.Kernels.jFun γ (z:ℂ)) ^ (-k) * (Work.Kernels.jFun γ (z:ℂ)) ^ k) := by
          rw [← zpow_add₀ hτ, neg_add_cancel, zpow_zero]
    _ = (F (γ • z) * (Work.Kernels.jFun γ (z:ℂ)) ^ (-k)) * (Work.Kernels.jFun γ (z:ℂ)) ^ k := by
          ring
    _ = F z * (Work.Kernels.jFun γ (z:ℂ)) ^ k := by rw [h]
    _ = (Work.Kernels.jFun γ (z:ℂ)) ^ k * F z := by ring

/-- The product of two `γ`-invariant functions is `γ`-invariant in the sum of the weights. -/
lemma slash_mul_inv {k₁ k₂ : ℤ} {γ : SL(2,ℤ)} {f g : ℍ → ℂ}
    (hf : f ∣[k₁] γ = f) (hg : g ∣[k₂] γ = g) : (f * g) ∣[k₁ + k₂] γ = f * g := by
  rw [ModularForm.mul_slash_SL2, hf, hg]

/-- The quotient of two `γ`-invariant functions is `γ`-invariant in the difference of the
weights. -/
lemma slash_div_inv {k₁ k₂ : ℤ} {γ : SL(2,ℤ)} {f g : ℍ → ℂ}
    (hf : f ∣[k₁] γ = f) (hg : g ∣[k₂] γ = g) : (f / g) ∣[k₁ - k₂] γ = f / g := by
  rw [ModularForm.div_slash_SL2, hf, hg]

/-! ## Elementary linearity of `TildeB` -/

/-- `TildeB ε k` is additive in the function variable. -/
lemma tildeB_add (ε k : ℤ) (F G : ℍ → ℂ) :
    TildeB ε k (F + G) = TildeB ε k F + TildeB ε k G := by
  funext τ
  simp only [TildeB, Pi.add_apply, SlashAction.add_slash]
  ring

/-- `TildeB ε k` is `ℂ`-homogeneous in the function variable. -/
lemma tildeB_smul (ε k : ℤ) (c : ℂ) (F : ℍ → ℂ) :
    TildeB ε k (c • F) = c • TildeB ε k F := by
  funext z
  simp only [TildeB, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  rw [SL_smul_slash]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

lemma tildeB_zero (ε k : ℤ) : TildeB ε k (0 : ℍ → ℂ) = 0 := by
  funext τ
  simp [TildeB, SlashAction.zero_slash]

/-- `TildeB (-1) k` commutes with finite sums. -/
lemma tildeB_sum {ι : Type*} (s : Finset ι) (F : ι → ℍ → ℂ) (k : ℤ) :
    TildeB (-1) k (∑ i ∈ s, F i) = ∑ i ∈ s, TildeB (-1) k (F i) := by
  classical
  induction s using Finset.induction with
  | empty => rw [Finset.sum_empty, Finset.sum_empty]; exact tildeB_zero _ _
  | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, tildeB_add, ih]

/-- If `F ∣[k] σ = -F` then `TildeB (-1) k F = 0`. -/
lemma tildeB_eq_zero_of_slash_neg {k : ℤ} {F : ℍ → ℂ}
    (h : F ∣[k] sig = -F) : TildeB (-1) k F = 0 := by
  funext τ
  simp only [TildeB, Pi.zero_apply]
  have hτ := congr_fun h τ
  simp only [Pi.neg_apply] at hτ
  rw [hτ]
  ring

/-- If `F` is `σ`-invariant of weight `k₁` and `G` is anti-invariant of weight `k₂`, then
`F * G` is anti-invariant of weight `k₁ + k₂`, so `TildeB (-1) (k₁+k₂) (F*G) = 0`. -/
lemma tildeB_mul_eq_zero {k₁ k₂ : ℤ} {F G : ℍ → ℂ}
    (hF : F ∣[k₁] sig = F) (hG : G ∣[k₂] sig = -G) :
    TildeB (-1) (k₁ + k₂) (F * G) = 0 := by
  apply tildeB_eq_zero_of_slash_neg
  rw [ModularForm.mul_slash_SL2, hF, hG]
  funext z
  simp only [Pi.mul_apply, Pi.neg_apply]
  ring

/-! ## The transformation laws of `U, V, W, 𝓛, f_k, j` under `σ` -/

lemma UFun_slash_S : Work.Kernels.UFun ∣[(2:ℤ)] ModularGroup.S = - Work.Kernels.UFun := by
  rw [slash_S_eq]
  simp only [Work.Kernels.KernelFacts.UFun_S_smul]
  funext τ
  rw [Work.Kernels.KernelFacts.zpow_neg_two]
  simp only [Pi.neg_apply]
  have hτ := tau_ne_zero τ
  field_simp

lemma UFun_slash_T : Work.Kernels.UFun ∣[(2:ℤ)] ModularGroup.T = Work.Kernels.WFun := by
  rw [slash_T_eq]
  simp only [Work.Kernels.KernelFacts.UFun_vadd_one]

lemma WFun_slash_T : Work.Kernels.WFun ∣[(2:ℤ)] ModularGroup.T = Work.Kernels.UFun := by
  rw [slash_T_eq]
  simp only [Work.Kernels.KernelFacts.WFun_vadd_one]

lemma WFun_slash_S : Work.Kernels.WFun ∣[(2:ℤ)] ModularGroup.S = - Work.Kernels.VFun := by
  rw [slash_S_eq]
  simp only [Work.Kernels.KernelFacts.WFun_S_smul]
  funext τ
  rw [Work.Kernels.KernelFacts.zpow_neg_two]
  simp only [Pi.neg_apply]
  have hτ := tau_ne_zero τ
  field_simp

lemma VFun_slash_T : Work.Kernels.VFun ∣[(2:ℤ)] ModularGroup.T = - Work.Kernels.VFun := by
  rw [slash_T_eq]
  simp only [Work.Kernels.KernelFacts.VFun_vadd_one]
  rfl

lemma VFun_slash_S : Work.Kernels.VFun ∣[(2:ℤ)] ModularGroup.S = - Work.Kernels.WFun := by
  rw [slash_S_eq]
  simp only [Work.Kernels.KernelFacts.VFun_S_smul_km]
  funext τ
  rw [Work.Kernels.KernelFacts.zpow_neg_two]
  simp only [Pi.neg_apply]
  have hτ := tau_ne_zero τ
  field_simp

lemma UFun_slash_sigma : Work.Kernels.UFun ∣[(2:ℤ)] sig = Work.Kernels.VFun := by
  rw [show sig = (ModularGroup.S * ModularGroup.T) * ModularGroup.S from rfl,
    SlashAction.slash_mul, SlashAction.slash_mul]
  simp only [UFun_slash_S, SlashAction.neg_slash, UFun_slash_T, WFun_slash_S]
  simp

lemma VFun_slash_sigma : Work.Kernels.VFun ∣[(2:ℤ)] sig = Work.Kernels.UFun := by
  rw [show sig = (ModularGroup.S * ModularGroup.T) * ModularGroup.S from rfl,
    SlashAction.slash_mul, SlashAction.slash_mul]
  simp only [VFun_slash_S, SlashAction.neg_slash, WFun_slash_T, UFun_slash_S]
  simp

lemma WFun_slash_sigma : Work.Kernels.WFun ∣[(2:ℤ)] sig = - Work.Kernels.WFun := by
  rw [show sig = (ModularGroup.S * ModularGroup.T) * ModularGroup.S from rfl,
    SlashAction.slash_mul, SlashAction.slash_mul]
  simp only [WFun_slash_S, SlashAction.neg_slash, VFun_slash_T, VFun_slash_S]
  simp

/-- `U² - V²` is anti-invariant of weight `4` under `σ`. -/
lemma U2V2_slash_sigma :
    (fun z => Work.Kernels.UFun z ^ 2 - Work.Kernels.VFun z ^ 2) ∣[(4:ℤ)] sig
      = -(fun z => Work.Kernels.UFun z ^ 2 - Work.Kernels.VFun z ^ 2) := by
  have hfun : (fun z => Work.Kernels.UFun z ^ 2 - Work.Kernels.VFun z ^ 2)
      = Work.Kernels.UFun * Work.Kernels.UFun - Work.Kernels.VFun * Work.Kernels.VFun := by
    funext z; simp only [Pi.sub_apply, Pi.mul_apply, pow_two]
  rw [hfun]
  have huu : (Work.Kernels.UFun * Work.Kernels.UFun) ∣[(4:ℤ)] sig
      = Work.Kernels.VFun * Work.Kernels.VFun := by
    rw [show (4:ℤ) = 2 + 2 from rfl, ModularForm.mul_slash_SL2, UFun_slash_sigma]
  have hvv : (Work.Kernels.VFun * Work.Kernels.VFun) ∣[(4:ℤ)] sig
      = Work.Kernels.UFun * Work.Kernels.UFun := by
    rw [show (4:ℤ) = 2 + 2 from rfl, ModularForm.mul_slash_SL2, VFun_slash_sigma]
  rw [sub_eq_add_neg, SlashAction.add_slash, SlashAction.neg_slash, huu, hvv]
  funext z
  simp only [Pi.add_apply, Pi.neg_apply, Pi.sub_apply, Pi.mul_apply]
  ring

/-- `𝓛` is anti-invariant of weight `0` under `σ`. -/
lemma L_slash_sigma (ℓ : Work.Kernels.LogLambdaData) :
    ℓ.L ∣[(0:ℤ)] sig = - ℓ.L := by
  have h2 : ℓ.L_S ∣[(0:ℤ)] ModularGroup.T = - ℓ.L_S := by
    funext τ; simpa using ℓ.slash_T_S τ
  rw [show sig = (ModularGroup.S * ModularGroup.T) * ModularGroup.S from rfl,
    SlashAction.slash_mul, SlashAction.slash_mul]
  simp only [ℓ.slash_S, h2, SlashAction.neg_slash, ℓ.slash_S_S]

/-- Each component of `ψ̃ = (𝓛, W, U² - V²)` is anti-invariant of weight `2j` under `σ`. -/
lemma psitVec_slash_sigma (ℓ : Work.Kernels.LogLambdaData) (j : Fin 3) :
    (fun z => Work.Kernels.psitVec ℓ z j) ∣[2 * (((j : ℕ) : ℤ))] sig
      = -(fun z => Work.Kernels.psitVec ℓ z j) := by
  have h0 := L_slash_sigma ℓ
  fin_cases j
  · simpa [Work.Kernels.psitVec] using h0
  · simpa [Work.Kernels.psitVec] using WFun_slash_sigma
  · simpa [Work.Kernels.psitVec] using U2V2_slash_sigma

/-! ## The modularity of `f_k` and of `j` under `σ` -/

lemma E4Fun_slash_sigma : Work.Kernels.E4Fun ∣[(4:ℤ)] sig = Work.Kernels.E4Fun :=
  SlashInvariantForm.slash_action_eqn (ModularForm.E₄) (Matrix.SpecialLinearGroup.mapGL ℝ sig)
    (MonoidHom.mem_range.mpr ⟨sig, rfl⟩)

lemma E6Fun_slash_sigma : Work.Kernels.E6Fun ∣[(6:ℤ)] sig = Work.Kernels.E6Fun :=
  SlashInvariantForm.slash_action_eqn (ModularForm.E₆) (Matrix.SpecialLinearGroup.mapGL ℝ sig)
    (MonoidHom.mem_range.mpr ⟨sig, rfl⟩)

lemma DeltaFun_slash_sigma : Work.Kernels.DeltaFun ∣[(12:ℤ)] sig = Work.Kernels.DeltaFun :=
  SlashInvariantForm.slash_action_eqn (CuspForm.discriminant) (Matrix.SpecialLinearGroup.mapGL ℝ sig)
    (MonoidHom.mem_range.mpr ⟨sig, rfl⟩)

lemma E8Fun_slash_sigma : Work.Kernels.E8Fun ∣[(8:ℤ)] sig = Work.Kernels.E8Fun := by
  have h : Work.Kernels.E8Fun = Work.Kernels.E4Fun * Work.Kernels.E4Fun := by
    funext τ; simp [Work.Kernels.E8Fun, pow_two]
  rw [h]
  exact slash_mul_inv (k₁ := 4) (k₂ := 4) E4Fun_slash_sigma E4Fun_slash_sigma

lemma E10Fun_slash_sigma : Work.Kernels.E10Fun ∣[(10:ℤ)] sig = Work.Kernels.E10Fun := by
  have h : Work.Kernels.E10Fun = Work.Kernels.E4Fun * Work.Kernels.E6Fun := by
    funext τ; simp [Work.Kernels.E10Fun]
  rw [h]
  exact slash_mul_inv (k₁ := 4) (k₂ := 6) E4Fun_slash_sigma E6Fun_slash_sigma

lemma E14Fun_slash_sigma : Work.Kernels.E14Fun ∣[(14:ℤ)] sig = Work.Kernels.E14Fun := by
  have h : Work.Kernels.E14Fun = Work.Kernels.E8Fun * Work.Kernels.E6Fun := by
    funext τ; simp [Work.Kernels.E14Fun, Work.Kernels.E8Fun, pow_two]
  rw [h]
  exact slash_mul_inv (k₁ := 8) (k₂ := 6) E8Fun_slash_sigma E6Fun_slash_sigma

lemma E10DivDelta_slash_sigma :
    (Work.Kernels.E10Fun / Work.Kernels.DeltaFun) ∣[(-2:ℤ)] sig
      = Work.Kernels.E10Fun / Work.Kernels.DeltaFun :=
  slash_div_inv (k₁ := 10) (k₂ := 12) E10Fun_slash_sigma DeltaFun_slash_sigma

lemma E14DivDelta_slash_sigma :
    (Work.Kernels.E14Fun / Work.Kernels.DeltaFun) ∣[(2:ℤ)] sig
      = Work.Kernels.E14Fun / Work.Kernels.DeltaFun :=
  slash_div_inv (k₁ := 14) (k₂ := 12) E14Fun_slash_sigma DeltaFun_slash_sigma

lemma fk_slash_sigma (k : ℤ)
    (hk : k = -2 ∨ k = 0 ∨ k = 2 ∨ k = 4 ∨ k = 6 ∨ k = 8 ∨ k = 10 ∨ k = 12 ∨ k = 14) :
    Work.Kernels.fk k ∣[k] sig = Work.Kernels.fk k := by
  rcases hk with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [Work.Kernels.KernelFacts.fk_neg_two]; exact E10DivDelta_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_zero]; exact ModularForm.is_invariant_one sig
  · rw [Work.Kernels.KernelFacts.fk_two]; exact E14DivDelta_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_four]; exact E4Fun_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_six]; exact E6Fun_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_eight]; exact E8Fun_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_ten]; exact E10Fun_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_twelve]; exact DeltaFun_slash_sigma
  · rw [Work.Kernels.KernelFacts.fk_fourteen]; exact E14Fun_slash_sigma

lemma jInvariantFun_slash_sigma :
    Work.Kernels.jInvariantFun ∣[(0:ℤ)] sig = Work.Kernels.jInvariantFun := by
  have h : Work.Kernels.jInvariantFun
      = (Work.Kernels.E4Fun * Work.Kernels.E4Fun * Work.Kernels.E4Fun) / Work.Kernels.DeltaFun := by
    funext τ; simp only [Work.Kernels.jInvariantFun, Pi.div_apply, Pi.mul_apply]; ring
  rw [h]
  have h8 : (Work.Kernels.E4Fun * Work.Kernels.E4Fun) ∣[(8:ℤ)] sig
      = Work.Kernels.E4Fun * Work.Kernels.E4Fun :=
    slash_mul_inv (k₁ := 4) (k₂ := 4) E4Fun_slash_sigma E4Fun_slash_sigma
  have h12 : (Work.Kernels.E4Fun * Work.Kernels.E4Fun * Work.Kernels.E4Fun) ∣[(12:ℤ)] sig
      = Work.Kernels.E4Fun * Work.Kernels.E4Fun * Work.Kernels.E4Fun :=
    slash_mul_inv (k₁ := 8) (k₂ := 4) h8 E4Fun_slash_sigma
  exact slash_div_inv (k₁ := 12) (k₂ := 12) h12 DeltaFun_slash_sigma

lemma jInvariantFun_smul_sigma (z : ℍ) :
    Work.Kernels.jInvariantFun (sig • z) = Work.Kernels.jInvariantFun z := by
  have h := congr_fun jInvariantFun_slash_sigma z
  rw [Work.Kernels.slash_apply'] at h
  simpa using h

def C0 : ℂ := (2 * c1728 * (Real.pi : ℂ))⁻¹
def Jfun (τ : ℍ) : ℍ → ℂ := fun z => jInvariantFun τ - jInvariantFun z
def Hfun (τ : ℍ) : ℍ → ℂ := fun z => (DeltaFun z * Jfun τ z)⁻¹
def AMat8 (τ : ℍ) : Matrix (Fin 3) (Fin 3) ℂ :=
  !![ -2*c1728, 0, 0; 0, 1, -1; 0, c1728 - jInvariantFun τ, jInvariantFun τ]
def AMat24 (τ z : ℍ) : Matrix (Fin 3) (Fin 3) ℂ :=
  !![ -2*c1728, -2*c1728*(jInvariantFun τ - jInvariantFun z), 0;
      0, jInvariantFun τ + 2*(jInvariantFun τ - jInvariantFun z), -1;
      0, c1728 - 2*(jInvariantFun τ - jInvariantFun z) - jInvariantFun τ, 1]
abbrev v8 : Fin 3 → ℤ := ![4, 2, 0]
abbrev w8 : Fin 3 → ℤ := ![10, 8, 6]
abbrev v24 : Fin 3 → ℤ := ![12, 10, 8]
abbrev w24 : Fin 3 → ℤ := ![2, 0, -2]
def Gfun (ℓ : LogLambdaData) (b : ℤ) (j : Fin 3) : ℍ → ℂ := fun z => fk b z * psitVec ℓ z j
def F8 (τ : ℍ) (i j : Fin 3) : ℍ → ℂ := (fun _ : ℍ => AMat8 τ i j) * Hfun τ
def F24 (τ : ℍ) (i j : Fin 3) : ℍ → ℂ := (fun z => AMat24 τ z i j) * Hfun τ

lemma Jfun_slash (τ : ℍ) : Jfun τ ∣[(0:ℤ)] sig = Jfun τ := by
  have h1 : (fun _ : ℍ => jInvariantFun τ) ∣[(0:ℤ)] sig = (fun _ : ℍ => jInvariantFun τ) := by
    funext z; rw [Work.Kernels.slash_apply']; simp
  have hdec : Jfun τ = (fun _ : ℍ => jInvariantFun τ) + (- jInvariantFun) := by
    funext z; simp only [Jfun, Pi.add_apply, Pi.neg_apply]; ring
  rw [hdec, SlashAction.add_slash, h1, SlashAction.neg_slash, jInvariantFun_slash_sigma]

lemma Hfun_slash (τ : ℍ) : Hfun τ ∣[(-12:ℤ)] sig = Hfun τ := by
  have hJ : Jfun τ ∣[(0:ℤ)] sig = Jfun τ := Jfun_slash τ
  have hD : (DeltaFun * Jfun τ) ∣[(12:ℤ)] sig = DeltaFun * Jfun τ :=
    slash_mul_inv (k₁ := 12) (k₂ := 0) DeltaFun_slash_sigma hJ
  have hH : Hfun τ = (fun z => ((DeltaFun * Jfun τ) z)⁻¹) := by
    funext z; simp [Hfun, Pi.mul_apply]
  rw [hH]
  funext z
  rw [inv_slash_pt (k := (-12:ℤ)) (γ := sig) (F := DeltaFun * Jfun τ)]
  rw [show ((-(-12) : ℤ)) = 12 from rfl, hD]

lemma AMat8_entry_slash (τ : ℍ) (i j : Fin 3) :
    (fun _ : ℍ => AMat8 τ i j) ∣[(0:ℤ)] sig = fun _ : ℍ => AMat8 τ i j := by
  funext z; rw [Work.Kernels.slash_apply']; simp

lemma AMat24_entry_slash (τ : ℍ) (i j : Fin 3) :
    (fun z => AMat24 τ z i j) ∣[(0:ℤ)] sig = fun z => AMat24 τ z i j := by
  funext z
  rw [Work.Kernels.slash_apply']
  simp only [neg_zero, zpow_zero, mul_one]
  have hj : jInvariantFun (sig • z) = jInvariantFun z := jInvariantFun_smul_sigma z
  show AMat24 τ (sig • z) i j = AMat24 τ z i j
  dsimp only [AMat24]
  rw [hj]

lemma Gfun_slash (ℓ : LogLambdaData) (b : ℤ)
    (hb : b = -2 ∨ b = 0 ∨ b = 2 ∨ b = 4 ∨ b = 6 ∨ b = 8 ∨ b = 10 ∨ b = 12 ∨ b = 14)
    (j : Fin 3) (w : ℤ) (hw : b + 2 * (((j : ℕ) : ℤ)) = w) :
    Gfun ℓ b j ∣[w] sig = -(Gfun ℓ b j) := by
  have h1 : fk b ∣[b] sig = fk b := fk_slash_sigma b hb
  have h2 := psitVec_slash_sigma ℓ j
  have h : (fk b * (fun z => psitVec ℓ z j)) ∣[b + 2 * (((j:ℕ):ℤ))] sig
      = fk b * (-(fun z => psitVec ℓ z j)) := by
    rw [ModularForm.mul_slash_SL2, h1, h2]
  have hG : Gfun ℓ b j = fk b * (fun z => psitVec ℓ z j) := rfl
  rw [hw] at h
  rw [hG, h]
  funext z
  simp only [Pi.mul_apply, Pi.neg_apply]
  ring

lemma UpsilonMinus_eight_eq (τ z : ℍ) :
    UpsilonMinus 8 τ z
      = (2 * c1728 * (Real.pi : ℂ) * DeltaFun z * (jInvariantFun τ - jInvariantFun z))⁻¹ •
          (PiMat ![4,2,0] τ * AMat8 τ * PiMat ![10,8,6] z) := by
  simp only [UpsilonMinus, reduceIte, AMat8]

lemma UpsilonMinus_twentyfour_eq (τ z : ℍ) :
    UpsilonMinus 24 τ z
      = (2 * c1728 * (Real.pi : ℂ) * DeltaFun z * (jInvariantFun τ - jInvariantFun z))⁻¹ •
          (PiMat ![12,10,8] τ * AMat24 τ z * PiMat ![2,0,-2] z) := by
  simp only [UpsilonMinus, reduceIte]
  simp only [if_neg (show ¬((24 : ℕ) = 8) by decide), AMat24]

lemma UpsilonMinus_eight_entry (τ z : ℍ) (i j : Fin 3) :
    UpsilonMinus 8 τ z i j = C0 * fk (v8 i) τ * AMat8 τ i j * Hfun τ z * fk (w8 j) z := by
  rw [UpsilonMinus_eight_eq]
  simp only [Matrix.smul_apply, smul_eq_mul, PiMat, Matrix.diagonal_mul, Matrix.mul_diagonal,
    v8, w8, C0, Hfun, Jfun]
  rw [show (2 * c1728 * (Real.pi : ℂ) * DeltaFun z * (jInvariantFun τ - jInvariantFun z))
      = (2 * c1728 * (Real.pi : ℂ)) * (DeltaFun z * (jInvariantFun τ - jInvariantFun z))
      from by ring, _root_.mul_inv_rev]
  ring

lemma UpsilonMinus_twentyfour_entry (τ z : ℍ) (i j : Fin 3) :
    UpsilonMinus 24 τ z i j = C0 * fk (v24 i) τ * AMat24 τ z i j * Hfun τ z * fk (w24 j) z := by
  rw [UpsilonMinus_twentyfour_eq]
  simp only [Matrix.smul_apply, smul_eq_mul, PiMat, Matrix.diagonal_mul, Matrix.mul_diagonal,
    v24, w24, C0, Hfun, Jfun]
  rw [show (2 * c1728 * (Real.pi : ℂ) * DeltaFun z * (jInvariantFun τ - jInvariantFun z))
      = (2 * c1728 * (Real.pi : ℂ)) * (DeltaFun z * (jInvariantFun τ - jInvariantFun z))
      from by ring, _root_.mul_inv_rev]
  ring

lemma F8_slash (τ : ℍ) (i j : Fin 3) : F8 τ i j ∣[(-12:ℤ)] sig = F8 τ i j := by
  have h := slash_mul_inv (k₁ := (0:ℤ)) (k₂ := (-12:ℤ)) (f := fun _ : ℍ => AMat8 τ i j)
    (g := Hfun τ) (AMat8_entry_slash τ i j) (Hfun_slash τ)
  rwa [show F8 τ i j = (fun _ : ℍ => AMat8 τ i j) * Hfun τ from rfl]

lemma F24_slash (τ : ℍ) (i j : Fin 3) : F24 τ i j ∣[(-12:ℤ)] sig = F24 τ i j := by
  have h := slash_mul_inv (k₁ := (0:ℤ)) (k₂ := (-12:ℤ)) (f := fun z => AMat24 τ z i j)
    (g := Hfun τ) (AMat24_entry_slash τ i j) (Hfun_slash τ)
  rwa [show F24 τ i j = (fun z => AMat24 τ z i j) * Hfun τ from rfl]

lemma term_eight_eq (ℓ : LogLambdaData) (τ : ℍ) (i j : Fin 3) :
    (fun z => UpsilonMinus 8 τ z i j * psitVec ℓ z j)
      = (C0 * fk (v8 i) τ) • (F8 τ i j * Gfun ℓ (w8 j) j) := by
  funext z
  rw [UpsilonMinus_eight_entry]
  simp only [F8, Gfun, Hfun, Jfun, Pi.mul_apply, Pi.smul_apply, smul_eq_mul]
  ring

lemma term_twentyfour_eq (ℓ : LogLambdaData) (τ : ℍ) (i j : Fin 3) :
    (fun z => UpsilonMinus 24 τ z i j * psitVec ℓ z j)
      = (C0 * fk (v24 i) τ) • (F24 τ i j * Gfun ℓ (w24 j) j) := by
  funext z
  rw [UpsilonMinus_twentyfour_entry]
  simp only [F24, Gfun, Hfun, Jfun, Pi.mul_apply, Pi.smul_apply, smul_eq_mul]
  ring


/-! ## The two cases `d = 8` and `d = 24` -/

lemma Gfun_slash_eight (ℓ : Work.Kernels.LogLambdaData) (j : Fin 3) :
    Gfun ℓ (w8 j) j ∣[(10:ℤ)] sig = -(Gfun ℓ (w8 j) j) := by
  apply Gfun_slash
  · fin_cases j <;> decide
  · fin_cases j <;> decide

lemma Gfun_slash_twentyfour (ℓ : Work.Kernels.LogLambdaData) (j : Fin 3) :
    Gfun ℓ (w24 j) j ∣[(2:ℤ)] sig = -(Gfun ℓ (w24 j) j) := by
  apply Gfun_slash
  · fin_cases j <;> decide
  · fin_cases j <;> decide

theorem key_eight (ℓ : Work.Kernels.LogLambdaData) (τ : ℍ) :
    TildeB (-1) (-2) (fun z : ℍ => KMinus ℓ 8 τ z) = 0 := by
  have hK : (fun z : ℍ => KMinus ℓ 8 τ z)
      = ∑ i : Fin 3, ∑ j : Fin 3,
          (psiVec ℓ τ i) • (fun z : ℍ => UpsilonMinus 8 τ z i j * psitVec ℓ z j) := by
    funext z
    simp only [KMinus, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  rw [hK, tildeB_sum]
  refine Finset.sum_eq_zero (fun i _ => ?_)
  rw [tildeB_sum]
  refine Finset.sum_eq_zero (fun j _ => ?_)
  rw [tildeB_smul, term_eight_eq ℓ τ i j, tildeB_smul]
  have h0 : TildeB (-1) ((-12:ℤ) + 10) (F8 τ i j * Gfun ℓ (w8 j) j) = 0 :=
    tildeB_mul_eq_zero (F8_slash τ i j) (Gfun_slash_eight ℓ j)
  rw [show ((-12 : ℤ) + 10) = (-2 : ℤ) from by norm_num] at h0
  rw [h0]
  simp

theorem key_twentyfour (ℓ : Work.Kernels.LogLambdaData) (τ : ℍ) :
    TildeB (-1) (-10) (fun z : ℍ => KMinus ℓ 24 τ z) = 0 := by
  have hK : (fun z : ℍ => KMinus ℓ 24 τ z)
      = ∑ i : Fin 3, ∑ j : Fin 3,
          (psiVec ℓ τ i) • (fun z : ℍ => UpsilonMinus 24 τ z i j * psitVec ℓ z j) := by
    funext z
    simp only [KMinus, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  rw [hK, tildeB_sum]
  refine Finset.sum_eq_zero (fun i _ => ?_)
  rw [tildeB_sum]
  refine Finset.sum_eq_zero (fun j _ => ?_)
  rw [tildeB_smul, term_twentyfour_eq ℓ τ i j, tildeB_smul]
  have h0 : TildeB (-1) ((-12:ℤ) + 2) (F24 τ i j * Gfun ℓ (w24 j) j) = 0 :=
    tildeB_mul_eq_zero (F24_slash τ i j) (Gfun_slash_twentyfour ℓ j)
  rw [show ((-12 : ℤ) + 2) = (-10 : ℤ) from by norm_num] at h0
  rw [h0]
  simp

theorem KMinus_z_tildeB_aux (ℓ : Work.Kernels.LogLambdaData) (d : ℕ) (hd : d = 8 ∨ d = 24)
    (k : ℤ) (hk : k = 2 - (d : ℤ) / 2) (τ : UpperHalfPlane) :
    Work.Kernels.TildeB (-1) k (fun z : UpperHalfPlane => Work.Kernels.KMinus ℓ d τ z) = 0 := by
  rcases hd with rfl | rfl
  · have hkk : k = (-2 : ℤ) := by rw [hk]; norm_num
    rw [hkk]; exact key_eight ℓ τ
  · have hkk : k = (-10 : ℤ) := by rw [hk]; norm_num
    rw [hkk]; exact key_twentyfour ℓ τ

end Kzb

theorem KMinus_z_tildeB (ℓ : Work.Kernels.LogLambdaData) (d : ℕ) (hd : d = 8 ∨ d = 24) (τ : UpperHalfPlane) :
    Work.Kernels.TildeB (-1) (2 - (d : ℤ) / 2) (fun z : UpperHalfPlane => Work.Kernels.KMinus ℓ d τ z) = 0 :=
  Kzb.KMinus_z_tildeB_aux ℓ d hd (2 - (d : ℤ) / 2) rfl τ

end

end Work.Kernels.TildeFacts
