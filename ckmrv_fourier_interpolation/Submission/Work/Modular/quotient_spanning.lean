import Mathlib
import Submission.Work.Modular.GroupAlgebra

/-!
# The images of `1, T, TS, S, ST, STS` span `ℂ[Γ]/I`

This file proves `Work.Modular.quotient_spanning`: every element of the group algebra `ℂ[Γ]` of
`Γ = ⟨S, T | S² = (ST)³ = 1⟩` is congruent, modulo the right ideal
`I = (T - 1)² ℂ[Γ] + S (T - 1)² ℂ[Γ]`, to a linear combination of the six elements
`1, T, TS, S, ST, STS` (paper, Proposition 3.3).

The mathematical content is the following.  Let `genSet` be the union of the six elements and of
the generating set of `I`, and let `P = ℂ[genSet] = B + I` be its span.  Then

* `P` contains `1`;
* `P` is closed under right multiplication by `S` and by `T`:
  - right multiplication by `S` permutes the six elements (using `S² = 1`), and preserves the
    generating set of `I` since the generators already contain an arbitrary right factor;
  - right multiplication by `T` preserves the generating set of `I` for the same reason, and
    maps the six elements into `P`; this is the only place where the relation `(ST)³ = 1` is
    used, through the two identities `T S T = S T⁻¹ S` and `(S T)² = T⁻¹ S` together with
    `T⁻¹ ≡ 2 - T` modulo `I` (which follows from `T² = 2T - 1 + (T - 1)²`).

Since `Γ` is generated by `S` and `T` as a monoid (both generators have inverses that are
positive words: `S⁻¹ = S` and `T⁻¹ = S T S T S`), every element of `ℂ[Γ]` lies in
`P = B + I`.  Passing to the quotient `ℂ[Γ]/I` shows that the six images span it.
-/

namespace Work.Modular

open Work.Modular
open scoped MonoidAlgebra

noncomputable section

/-- `T⁻¹` as an element of the group algebra (notation `tR⁻¹` is not available because `ℂ[Γ]`
carries no `Inv` instance). -/
private abbrev tRi : GroupRing := MonoidAlgebra.of ℂ Gamma genT⁻¹

private lemma sR_sq' : sR * sR = 1 := by simpa [pow_two] using sR_sq

private lemma tR_mul_tRi : tR * tRi = 1 := by
  show MonoidAlgebra.of ℂ Gamma genT * MonoidAlgebra.of ℂ Gamma genT⁻¹ = 1
  rw [← map_mul, mul_inv_cancel, map_one]

private lemma tRi_mul_tR : tRi * tR = 1 := by
  show MonoidAlgebra.of ℂ Gamma genT⁻¹ * MonoidAlgebra.of ℂ Gamma genT = 1
  rw [← map_mul, inv_mul_cancel, map_one]

private def uS : GroupRingˣ := ⟨sR, sR, sR_sq', sR_sq'⟩

private def uT : GroupRingˣ := ⟨tR, tRi, tR_mul_tRi, tRi_mul_tR⟩

private lemma u_hcube : ((uS * uT) ^ 3 : GroupRingˣ) = 1 := by
  apply Units.ext
  simp only [Units.val_pow_eq_pow_val, Units.val_mul, Units.val_one, uS, uT]
  simpa [pow_succ] using sR_mul_tR_cube

private lemma u_hsq : ((uS * uT) * (uS * uT) ^ 2 : GroupRingˣ) = 1 := by
  rw [← pow_succ', u_hcube]

private lemma u_sq_inv : ((uS * uT) ^ 2 : GroupRingˣ) = (uS * uT)⁻¹ :=
  eq_inv_of_mul_eq_one_right u_hsq

private lemma u_hSS : (uS * uS : GroupRingˣ) = 1 := by
  apply Units.ext
  simp [uS, sR_sq']

private lemma uS_inv : (uS⁻¹ : GroupRingˣ) = uS := inv_eq_of_mul_eq_one_right u_hSS

private lemma u_tst_b : (uS * (uS * uT)^2 : GroupRingˣ) = uT * uS * uT := by
  simp only [pow_two, ← mul_assoc, u_hSS, one_mul]

/-- `T S T = S T⁻¹ S` among the units of `ℂ[Γ]`. -/
private lemma u_tst : (uT * uS * uT : GroupRingˣ) = uS * uT⁻¹ * uS := by
  rw [← u_tst_b, u_sq_inv, mul_inv_rev, ← mul_assoc, uS_inv]

/-- `(S T)² = T⁻¹ S` among the units of `ℂ[Γ]`. -/
private lemma u_stst : ((uS * uT) ^ 2 : GroupRingˣ) = uT⁻¹ * uS := by
  rw [u_sq_inv, mul_inv_rev, uS_inv]

private lemma coe_uT_inv : ((uT⁻¹ : GroupRingˣ) : GroupRing) = tRi := by
  have h : tR * ((uT⁻¹ : GroupRingˣ) : GroupRing) = 1 := Units.val_inv uT
  calc ((uT⁻¹ : GroupRingˣ) : GroupRing) = 1 * ((uT⁻¹ : GroupRingˣ) : GroupRing) := by
        rw [one_mul]
    _ = (tRi * tR) * ((uT⁻¹ : GroupRingˣ) : GroupRing) := by rw [tRi_mul_tR]
    _ = tRi * (tR * ((uT⁻¹ : GroupRingˣ) : GroupRing)) := by rw [mul_assoc]
    _ = tRi * 1 := by rw [h]
    _ = tRi := by rw [mul_one]

/-- `T S T = S T⁻¹ S` in the group algebra, from `(S T)³ = 1`. -/
private lemma tst : tR * sR * tR = sR * tRi * sR := by
  have h := congrArg (fun u : GroupRingˣ => (u : GroupRing)) u_tst
  simpa [uS, uT, coe_uT_inv] using h

/-- `(S T)² = T⁻¹ S` in the group algebra, from `(S T)³ = 1`. -/
private lemma stst : sR * tR * sR * tR = tRi * sR := by
  have h := congrArg (fun u : GroupRingˣ => (u : GroupRing)) u_stst
  simpa [uS, uT, coe_uT_inv, pow_two, mul_assoc] using h

/-- `T⁻¹ ≡ 2 - T` modulo `I`: precisely, `(T - 1)² T⁻¹ = T⁻¹ - 2 + T`. -/
private lemma sq_mul_tRi : (tR - 1)^2 * tRi = tRi - 2 + tR := by
  have key : (tR - 1)^2 * tRi = tR * (tR * tRi) - 2 * (tR * tRi) + tRi := by noncomm_ring
  rw [key, tR_mul_tRi, mul_one, mul_one]
  abel

/-- The central constant `2` is fixed by conjugation with `S`. -/
private lemma sR_center_2 : (sR * 2) * sR = 2 := by
  have h : (sR * 2) * sR = 2 * (sR * sR) := by noncomm_ring
  rw [h, sR_sq', mul_one]

/-! ## The six right multiplications by `T` -/

private lemma diff0 : (basisElem 0 : GroupRing) * tR = basisElem 1 + 0 := by
  rw [show basisElem 0 = (1:GroupRing) from by simp [basisElem],
      show basisElem 1 = tR from by simp [basisElem]]
  simp

/-- `T · T = (2 T - 1) + (T - 1)²`. -/
private lemma diff1 : (basisElem 1 : GroupRing) * tR
    = ((2:ℂ) • basisElem 1 - basisElem 0) + (tR - 1)^2 := by
  rw [show basisElem 1 = tR from by simp [basisElem],
      show basisElem 0 = (1:GroupRing) from by simp [basisElem],
      Algebra.smul_def, map_ofNat]
  noncomm_ring

/-- `(T S) T = (2 - S T S) + S (T - 1)² T⁻¹ S`, using `T S T = S T⁻¹ S`. -/
private lemma diff2 : (basisElem 2 : GroupRing) * tR
    = ((2:ℂ) • basisElem 0 - basisElem 5) + sR * ((tR - 1)^2 * tRi) * sR := by
  have h1 : sR * (tRi - 2 + tR) * sR = sR * tRi * sR - 2 + sR * tR * sR := by
    have h2 : sR * (tRi - 2 + tR) * sR = sR * tRi * sR - (sR * 2) * sR + sR * tR * sR := by
      noncomm_ring
    rw [h2, sR_center_2]
  rw [show basisElem 2 = tR * sR from by simp [basisElem],
      show basisElem 0 = (1:GroupRing) from by simp [basisElem],
      show basisElem 5 = sR * tR * sR from by simp [basisElem],
      Algebra.smul_def, map_ofNat, mul_one, tst, sq_mul_tRi, h1]
  abel

private lemma diff3 : (basisElem 3 : GroupRing) * tR = basisElem 4 + 0 := by
  rw [show basisElem 3 = sR from by simp [basisElem],
      show basisElem 4 = sR * tR from by simp [basisElem]]
  simp

/-- `(S T) T = (2 S T - S) + S (T - 1)²`. -/
private lemma diff4 : (basisElem 4 : GroupRing) * tR
    = ((2:ℂ) • basisElem 4 - basisElem 3) + sR * (tR - 1)^2 := by
  rw [show basisElem 4 = sR * tR from by simp [basisElem],
      show basisElem 3 = sR from by simp [basisElem],
      Algebra.smul_def, map_ofNat]
  noncomm_ring

/-- `(S T S) T = (2 S - T S) + (T - 1)² T⁻¹ S`, using `(S T)² = T⁻¹ S`. -/
private lemma diff5 : (basisElem 5 : GroupRing) * tR
    = ((2:ℂ) • basisElem 3 - basisElem 2) + ((tR - 1)^2 * tRi) * sR := by
  rw [show basisElem 5 = sR * tR * sR from by simp [basisElem],
      show basisElem 3 = sR from by simp [basisElem],
      show basisElem 2 = tR * sR from by simp [basisElem],
      Algebra.smul_def, map_ofNat, stst, sq_mul_tRi]
  noncomm_ring

/-! ## The submodule `P = B + I` -/

/-- The generating set `I` of the right ideal `idealI`. -/
private def Igen : Set GroupRing := {y : GroupRing |
  (∃ r : GroupRing, y = (tR - 1) ^ 2 * r) ∨ (∃ r : GroupRing, y = sR * (tR - 1) ^ 2 * r)}

/-- The six elements together with the generating set of `I`. -/
private def genSet : Set GroupRing := Set.range basisElem ∪ Igen

/-- `B`, the `ℂ`-span of the six elements `1, T, TS, S, ST, STS`. -/
private abbrev B : Submodule ℂ GroupRing := Submodule.span ℂ (Set.range basisElem)

/-- `P = B + I`, presented as the span of `genSet`. -/
private abbrev P : Submodule ℂ GroupRing := Submodule.span ℂ genSet

private lemma mem_B (i : Fin 6) : basisElem i ∈ B := Submodule.subset_span ⟨i, rfl⟩

private lemma mem_B_smul (c : ℂ) (i : Fin 6) : c • basisElem i ∈ B :=
  Submodule.smul_mem _ _ (mem_B i)

private lemma mem_P_B {x : GroupRing} (h : x ∈ B) : x ∈ P :=
  (Submodule.span_mono (Set.subset_union_left : Set.range basisElem ⊆ genSet)) h

private lemma mem_P_I {x : GroupRing} (h : x ∈ idealI) : x ∈ P :=
  (Submodule.span_mono (Set.subset_union_right : Igen ⊆ genSet)) h

private lemma gen_e : (tR - 1)^2 ∈ idealI :=
  Submodule.subset_span (Or.inl ⟨1, (mul_one _).symm⟩)

private lemma gen_se : sR * (tR - 1)^2 ∈ idealI :=
  Submodule.subset_span (Or.inr ⟨1, (mul_one _).symm⟩)

private lemma mem_genSet_1 (a : GroupRing) : (tR - 1)^2 * a ∈ genSet :=
  Or.inr (Or.inl ⟨a, rfl⟩)

private lemma mem_genSet_2 (a : GroupRing) : sR * (tR - 1)^2 * a ∈ genSet :=
  Or.inr (Or.inr ⟨a, rfl⟩)

/-- Right multiplication by `S` permutes the six elements. -/
private lemma basisElem_mul_sR_mem (i : Fin 6) : basisElem i * sR ∈ B := by
  fin_cases i
  · exact Submodule.subset_span ⟨3, by simp [basisElem]⟩
  · exact Submodule.subset_span ⟨2, by simp [basisElem]⟩
  · exact Submodule.subset_span ⟨1, by simp [basisElem]; rw [mul_assoc, sR_sq', mul_one]⟩
  · exact Submodule.subset_span ⟨0, by simp [basisElem, sR_sq']⟩
  · exact Submodule.subset_span ⟨5, by simp [basisElem]⟩
  · exact Submodule.subset_span ⟨4, by simp [basisElem]; rw [mul_assoc, sR_sq', mul_one]⟩

/-- Right multiplication by `T` maps the six elements into `B + I`. -/
private lemma basisElem_mul_tR_mem (i : Fin 6) : basisElem i * tR ∈ P := by
  fin_cases i
  · exact show basisElem 0 * tR ∈ P from by
      rw [diff0]
      exact Submodule.add_mem _ (mem_P_B (mem_B 1)) (mem_P_I (Submodule.zero_mem _))
  · exact show basisElem 1 * tR ∈ P from by
      rw [diff1]
      exact Submodule.add_mem _ (mem_P_B (Submodule.sub_mem _ (mem_B_smul 2 1) (mem_B 0)))
        (mem_P_I gen_e)
  · exact show basisElem 2 * tR ∈ P from by
      rw [diff2]
      refine Submodule.add_mem _ (mem_P_B (Submodule.sub_mem _ (mem_B_smul 2 0) (mem_B 5))) ?_
      rw [show sR * ((tR - 1)^2 * tRi) * sR = (sR * (tR - 1)^2) * (tRi * sR) from by
        noncomm_ring]
      exact mem_P_I (Submodule.subset_span (Or.inr ⟨tRi * sR, rfl⟩))
  · exact show basisElem 3 * tR ∈ P from by
      rw [diff3]
      exact Submodule.add_mem _ (mem_P_B (mem_B 4)) (mem_P_I (Submodule.zero_mem _))
  · exact show basisElem 4 * tR ∈ P from by
      rw [diff4]
      exact Submodule.add_mem _ (mem_P_B (Submodule.sub_mem _ (mem_B_smul 2 4) (mem_B 3)))
        (mem_P_I gen_se)
  · exact show basisElem 5 * tR ∈ P from by
      rw [diff5]
      refine Submodule.add_mem _ (mem_P_B (Submodule.sub_mem _ (mem_B_smul 2 3) (mem_B 2))) ?_
      rw [show ((tR - 1)^2 * tRi) * sR = (tR - 1)^2 * (tRi * sR) from by rw [mul_assoc]]
      exact mem_P_I (Submodule.subset_span (Or.inl ⟨tRi * sR, rfl⟩))

/-- `P` is closed under right multiplication by `S`. -/
private lemma P_mul_sR {x : GroupRing} (hx : x ∈ P) : x * sR ∈ P := by
  refine Submodule.span_induction (p := fun y (_ : y ∈ Submodule.span ℂ genSet) => y * sR ∈ P)
    ?_ ?_ ?_ ?_ hx
  · intro g hg
    rcases hg with ⟨i, rfl⟩ | (⟨a, rfl⟩ | ⟨a, rfl⟩)
    · exact mem_P_B (basisElem_mul_sR_mem i)
    · rw [mul_assoc]
      exact Submodule.subset_span (mem_genSet_1 (a * sR))
    · rw [mul_assoc]
      exact Submodule.subset_span (mem_genSet_2 (a * sR))
  · simp
  · intro y z hy hz ihy ihz
    rw [add_mul]
    exact Submodule.add_mem _ ihy ihz
  · intro a y hy ihy
    rw [smul_mul_assoc]
    exact Submodule.smul_mem _ a ihy

/-- `P` is closed under right multiplication by `T`. -/
private lemma P_mul_tR {x : GroupRing} (hx : x ∈ P) : x * tR ∈ P := by
  refine Submodule.span_induction (p := fun y (_ : y ∈ Submodule.span ℂ genSet) => y * tR ∈ P)
    ?_ ?_ ?_ ?_ hx
  · intro g hg
    rcases hg with ⟨i, rfl⟩ | (⟨a, rfl⟩ | ⟨a, rfl⟩)
    · exact basisElem_mul_tR_mem i
    · rw [mul_assoc]
      exact Submodule.subset_span (mem_genSet_1 (a * tR))
    · rw [mul_assoc]
      exact Submodule.subset_span (mem_genSet_2 (a * tR))
  · simp
  · intro y z hy hz ihy ihz
    rw [add_mul]
    exact Submodule.add_mem _ ihy ihz
  · intro a y hy ihy
    rw [smul_mul_assoc]
    exact Submodule.smul_mem _ a ihy

/-! ## `Γ` is generated as a monoid by `S` and `T` -/

private lemma genS_inv : genS⁻¹ = genS := by
  have h : genS * genS = 1 := by simpa [pow_two] using genS_sq
  exact inv_eq_of_mul_eq_one_right h

private lemma genT_mul_genS_cube : (genT * genS)^3 = 1 := by
  have key : (genT * genS)^3 = genT * (genS * genT)^3 * genT⁻¹ := by
    simp only [pow_three]; group
  rw [key, genS_mul_genT_cube, mul_one, mul_inv_cancel]

/-- `T⁻¹ = S T S T S` in `Γ`: `T` has infinite order, but its inverse is still a positive word
in the generators. -/
private lemma genT_inv : genT⁻¹ = genS * genT * genS * genT * genS := by
  have key : (genS * genT * genS * genT * genS) * genT = (genS * genT)^3 := by
    simp only [pow_three]; group
  have h : (genS * genT * genS * genT * genS) * genT = 1 := by rw [key, genS_mul_genT_cube]
  have h4 : (genS * genT * genS * genT * genS)⁻¹ = genT := inv_eq_of_mul_eq_one_right h
  have h5 := congrArg (fun x : Gamma => x⁻¹) h4.symm
  simpa [inv_inv] using h5

private lemma mk_of_mem (a : Fin 2) :
    (PresentedGroup.mk presentedRels) (FreeGroup.of a) ∈
      Submonoid.closure ({genS, genT} : Set Gamma) := by
  fin_cases a
  · exact Submonoid.subset_closure (Or.inl rfl)
  · exact Submonoid.subset_closure (Or.inr rfl)

private lemma mk_inv_mem (a : Fin 2) :
    (PresentedGroup.mk presentedRels) ((FreeGroup.of a)⁻¹) ∈
      Submonoid.closure ({genS, genT} : Set Gamma) := by
  fin_cases a
  · change (PresentedGroup.mk presentedRels) ((FreeGroup.of (0:Fin 2))⁻¹) ∈ _
    rw [show (PresentedGroup.mk presentedRels) ((FreeGroup.of (0:Fin 2))⁻¹) = genS from by
      rw [map_inv]; show genS⁻¹ = genS; exact genS_inv]
    exact Submonoid.subset_closure (Or.inl rfl)
  · change (PresentedGroup.mk presentedRels) ((FreeGroup.of (1:Fin 2))⁻¹) ∈ _
    rw [show (PresentedGroup.mk presentedRels) ((FreeGroup.of (1:Fin 2))⁻¹)
          = genS * genT * genS * genT * genS from by
      rw [map_inv]; show genT⁻¹ = genS * genT * genS * genT * genS; exact genT_inv]
    exact Submonoid.mul_mem _ (Submonoid.mul_mem _ (Submonoid.mul_mem _ (Submonoid.mul_mem _
      (Submonoid.subset_closure (Or.inl rfl)) (Submonoid.subset_closure (Or.inr rfl)))
      (Submonoid.subset_closure (Or.inl rfl))) (Submonoid.subset_closure (Or.inr rfl)))
      (Submonoid.subset_closure (Or.inl rfl))

/-- `Γ` is generated as a monoid by `S` and `T`. -/
private lemma closure_top : Submonoid.closure ({genS, genT} : Set Gamma) = ⊤ := by
  rw [Submonoid.eq_top_iff']
  intro γ
  induction γ using PresentedGroup.induction_on with
  | H z =>
    induction z using FreeGroup.induction_on with
    | one => exact Submonoid.one_mem _
    | of a => exact mk_of_mem a
    | inv_of a ih => exact mk_inv_mem a
    | mul y z ihy ihz => exact Submonoid.mul_mem _ ihy ihz

/-! ## Every element of the group algebra lies in `P = B + I` -/

private lemma one_mem_P : (1 : GroupRing) ∈ P := by
  have h : (1 : GroupRing) = basisElem 0 := by simp [basisElem]
  rw [h]
  exact mem_P_B (mem_B 0)

private lemma of_mem_P (γ : Gamma) :
    ∀ x : GroupRing, x ∈ P → x * MonoidAlgebra.of ℂ Gamma γ ∈ P := by
  have hγ : γ ∈ Submonoid.closure ({genS, genT} : Set Gamma) := by
    rw [closure_top]; exact Submonoid.mem_top γ
  refine Submonoid.closure_induction
    (motive := fun γ (_ : γ ∈ Submonoid.closure ({genS, genT} : Set Gamma)) =>
      ∀ x : GroupRing, x ∈ P → x * MonoidAlgebra.of ℂ Gamma γ ∈ P) ?_ ?_ ?_ hγ
  · rintro y (rfl | rfl)
    · intro x hx
      simpa [sR] using P_mul_sR hx
    · intro x hx
      simpa [tR] using P_mul_tR hx
  · intro x hx
    rw [map_one, mul_one]
    exact hx
  · intro y z hy hz ihy ihz x hx
    have h1 : x * MonoidAlgebra.of ℂ Gamma y ∈ P := ihy x hx
    have h2 : (x * MonoidAlgebra.of ℂ Gamma y) * MonoidAlgebra.of ℂ Gamma z ∈ P := ihz _ h1
    rw [map_mul, ← mul_assoc]
    exact h2

private lemma P_eq_top : (P : Submodule ℂ GroupRing) = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro r
  refine MonoidAlgebra.induction_on (motive := fun y => y ∈ P) r ?_ ?_ ?_
  · intro γ
    simpa using of_mem_P γ 1 one_mem_P
  · intro x y hx hy
    exact Submodule.add_mem _ hx hy
  · intro c x hx
    exact Submodule.smul_mem _ c hx

/-- The images of `1, T, TS, S, ST, STS` span `ℂ[Γ]/I`: every element of the group algebra is
congruent modulo `I` to a linear combination of these six. -/
theorem quotient_spanning (r : GroupRing) :
    ∃ c : Fin 6 → ℂ, Submodule.mkQ idealI r = ∑ i, c i • Submodule.mkQ idealI (basisElem i) := by
  have hsup : (P : Submodule ℂ GroupRing) = B ⊔ idealI :=
    Submodule.span_union (Set.range basisElem) Igen
  have hr : r ∈ B ⊔ idealI := by
    rw [← hsup, P_eq_top]
    exact Submodule.mem_top
  obtain ⟨b, hb, i, hi, hbi⟩ := Submodule.mem_sup.mp hr
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hb
  refine ⟨c, ?_⟩
  have key : Submodule.mkQ idealI r = Submodule.mkQ idealI b := by
    rw [← hbi, map_add]
    have hi' : Submodule.mkQ idealI i = 0 := by
      rw [Submodule.mkQ_apply]
      exact (Submodule.Quotient.mk_eq_zero idealI).mpr hi
    rw [hi', add_zero]
  rw [key, ← hc, map_sum]
  refine Finset.sum_congr rfl ?_
  intro j _
  rw [map_smul]

end

end Work.Modular
