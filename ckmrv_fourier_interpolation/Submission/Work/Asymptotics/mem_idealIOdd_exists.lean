/-
# Describing elements of the odd-weight defect ideal `𝓘_odd` in normal form

`𝓘_odd = (T-I)²R + S(T-I)²R + (1+z)R` (`Work.Asymptotics.idealIOdd`) is a sum of the
right ideal `𝓘 = (T-I)²R + S(T-I)²R` (`Work.Kernels.IdealI`) and of the collapse ideal
`(1+z)R` (`Work.Asymptotics.augIdealOdd`), where `z = -I`.

The point of this file is that *every* element of the two-sided ideal `(1+z)R` can be
written as a **single right multiple** `(1+z) * C`: the element `z` is central, hence so is
`1 + z`, and therefore a generator `r (1+z) s` of `augIdealOdd` equals `(1+z) (r s)`.
Elements of the span are then handled by the closure properties of the set of right
multiples.

Consequently every `ξ ∈ 𝓘_odd` has the normal form

  `ξ = (T-I)² A + S (T-I)² B + (1+z) C`,

which is exactly the shape in which the propagation argument of CKMRV needs it: the action
of `𝓘_odd` on a function of odd weight is read off from the two defects `(T-I)²F`,
`S(T-I)²F` and the collapsed generator `1+z` (which acts by `0`, see
`Work.Asymptotics.slash_one_add_Rneg`).
-/
import Mathlib
import Submission.Work.Asymptotics.OddIdeal
import Submission.Work.Asymptotics.PropagateMpDefs
import Submission.Work.Residues.Basic

namespace Work.Asymptotics

open Work.Kernels

/-- `1 + z`, `z = -I`, is central in `R = ℂ[SL(2,ℤ)]`, because `z` is. -/
lemma Rneg_add_one_comm (r : R) : r * (Rneg + 1) = (Rneg + 1) * r := by
  rw [mul_add, add_mul, mul_one, one_mul, Work.Residues.mul_Rneg r]

/-- Every element of the two-sided ideal `(1+z)R` is a right multiple of `1+z`
(equivalently, `augIdealOdd` is the principal right ideal generated by `1+z`). -/
lemma mem_augIdealOdd_exists {y : R} (hy : y ∈ augIdealOdd) :
    ∃ C : R, y = (Rneg + 1) * C := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨r, s, rfl⟩ := hz
    refine ⟨r * s, ?_⟩
    rw [Rneg_add_one_comm r, mul_assoc]
  | zero => exact ⟨0, by rw [mul_zero]⟩
  | add y z hyz hyz' ihy ihz =>
    obtain ⟨c, hc⟩ := ihy
    obtain ⟨d, hd⟩ := ihz
    exact ⟨c + d, by rw [hc, hd, mul_add]⟩
  | smul a y hy' ihy =>
    obtain ⟨c, hc⟩ := ihy
    exact ⟨a • c, by rw [hc, Algebra.mul_smul_comm]⟩

/-- **Normal form of an element of `𝓘_odd`.**  Every `ξ ∈ (T-I)²R + S(T-I)²R + (1+z)R` can
be written as `(T-I)² A + S(T-I)² B + (1+z) C`. -/
theorem mem_idealIOdd_exists {ξ : Work.Kernels.R} (hξ : ξ ∈ Work.Asymptotics.idealIOdd) :
    ∃ A B C : Work.Kernels.R,
      ξ = (Work.Kernels.R_T - 1) ^ 2 * A +
          Work.Kernels.R_S * (Work.Kernels.R_T - 1) ^ 2 * B +
          (Work.Asymptotics.Rneg + 1) * C := by
  obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp hξ
  obtain ⟨a, b, ha⟩ := Work.Kernels.mem_span2.mp hx
  obtain ⟨c, hc⟩ := mem_augIdealOdd_exists hy
  exact ⟨a, b, c, by rw [← hxy, ha, hc]⟩

end Work.Asymptotics
