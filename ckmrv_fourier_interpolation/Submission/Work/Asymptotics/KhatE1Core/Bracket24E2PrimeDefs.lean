/-- The `E(z)²`-coefficient bound for the corrected coefficient. -/
def Bracket24E2Bound' (ℓ : Work.Kernels.LogLambdaData) : Prop :=
  ∃ C N M : ℝ, 0 < C ∧ 0 ≤ N ∧ 0 ≤ M ∧
    ∀ (τ z : UpperHalfPlane) (t : ℝ), Work.Asymptotics.Funnel τ → τ.im + 1 ≤ t →
      0 ≤ z.re → z.re ≤ 1 → z.im = t →
      ‖Bracket24E2' ℓ τ z‖
        ≤ C * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N * (1 + t) ^ M

/-- The tail bound: everything except the `E(z)²`-coefficient term is one power of
`‖q(τ)‖` smaller. -/
def Bracket24Tail' (ℓ : Work.Kernels.LogLambdaData) : Prop :=
  ∃ C N M : ℝ, 0 < C ∧ 0 ≤ N ∧ 0 ≤ M ∧
    ∀ (τ z : UpperHalfPlane) (t : ℝ), Work.Asymptotics.Funnel τ → τ.im + 1 ≤ t →
      0 ≤ z.re → z.re ≤ 1 → z.im = t →
      ‖Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z
          - (Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z‖
        ≤ C * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N * (1 + t) ^ M
            * Real.exp (-(2 * Real.pi * t))

/-- **The reduction** (the analogue of the proved `KhatE1.Bracket24ClearedBound_of_pieces`,
now with the correct `E(z)²`-coefficient, so that it is not vacuous). -/
theorem Bracket24SharpClearedRaw_of_pieces' (ℓ : Work.Kernels.LogLambdaData)
    (h2 : Bracket24E2Bound' ℓ) (htail : Bracket24Tail' ℓ) : Bracket24SharpClearedRaw ℓ := by
  obtain ⟨C1, N1, M1, hC1, hN1, hM1, h1⟩ := h2
  obtain ⟨C2, N2, M2, hC2, hN2, hM2, h2'⟩ := htail
  refine ⟨C1 + C2, max N1 N2, max M1 M2, by linarith, le_trans hN1 (le_max_left _ _),
    le_trans hM1 (le_max_left _ _), ?_⟩
  intro τ z t hF ht hz0 hz1 hzim
  have hE0 : (0 : ℝ) ≤ Real.exp (-(2 * Real.pi * t)) := (Real.exp_pos _).le
  have hs1 : (1 : ℝ) ≤ Work.Kernels.scale τ := Work.Kernels.one_le_scale τ
  have hs0 : (0 : ℝ) ≤ Work.Kernels.scale τ := le_trans zero_le_one hs1
  have ht1 : (1 : ℝ) ≤ (1 : ℝ) + t := by have := hF.2; linarith
  have ht0 : (0 : ℝ) ≤ 1 + t := le_trans zero_le_one ht1
  have hq0 : (0 : ℝ) ≤ ‖Work.Kernels.qParamFun τ‖ := norm_nonneg _
  have he2 : ‖(Work.Residues.Ept z) ^ 2‖ = Real.exp (-(2 * Real.pi * t)) := by
    rw [norm_pow, Work.Residues.norm_Ept, hzim]
    rw [show Real.exp (-(Real.pi * t)) ^ 2 = Real.exp (-(2 * Real.pi * t)) by
      rw [sq, ← Real.exp_add]; congr 1; ring]
  have mono : ∀ C' : ℝ, 0 ≤ C' → ∀ N M : ℝ, N ≤ max N1 N2 → M ≤ max M1 M2 →
      C' * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N * (1 + t) ^ M
          * Real.exp (-(2 * Real.pi * t))
        ≤ C' * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ (max N1 N2)
            * (1 + t) ^ (max M1 M2) * Real.exp (-(2 * Real.pi * t)) := by
    intro C' hC' N M hN hM
    have hN' : (Work.Kernels.scale τ) ^ N ≤ (Work.Kernels.scale τ) ^ (max N1 N2) :=
      Real.rpow_le_rpow_of_exponent_le hs1 hN
    have hM' : (1 + t) ^ M ≤ (1 + t) ^ (max M1 M2) :=
      Real.rpow_le_rpow_of_exponent_le ht1 hM
    have h3 : (0 : ℝ) ≤ C' * ‖Work.Kernels.qParamFun τ‖ := mul_nonneg hC' hq0
    have h4 : (0 : ℝ) ≤ C' * ‖Work.Kernels.qParamFun τ‖
        * (Work.Kernels.scale τ) ^ (max N1 N2) :=
      mul_nonneg h3 (Real.rpow_nonneg hs0 _)
    have h5 : (0 : ℝ) ≤ (1 + t) ^ M * Real.exp (-(2 * Real.pi * t)) :=
      mul_nonneg (Real.rpow_nonneg ht0 _) hE0
    calc C' * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N * (1 + t) ^ M
          * Real.exp (-(2 * Real.pi * t))
        = (C' * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N)
            * ((1 + t) ^ M * Real.exp (-(2 * Real.pi * t))) := by ring
      _ ≤ (C' * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ (max N1 N2))
            * ((1 + t) ^ (max M1 M2) * Real.exp (-(2 * Real.pi * t))) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hN' h3) (mul_le_mul hM' le_rfl hE0
            (Real.rpow_nonneg ht0 _)) h5 h4
      _ = C' * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ (max N1 N2)
            * (1 + t) ^ (max M1 M2) * Real.exp (-(2 * Real.pi * t)) := by ring
  have h1' := h1 τ z t hF ht hz0 hz1 hzim
  have h2'' := h2' τ z t hF ht hz0 hz1 hzim
  have hA : ‖(Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z‖
      ≤ C1 * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ (max N1 N2)
          * (1 + t) ^ (max M1 M2) * Real.exp (-(2 * Real.pi * t)) := by
    rw [norm_mul, he2]
    calc Real.exp (-(2 * Real.pi * t)) * ‖Bracket24E2' ℓ τ z‖
        ≤ Real.exp (-(2 * Real.pi * t))
            * (C1 * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N1
                * (1 + t) ^ M1) := mul_le_mul_of_nonneg_left h1' hE0
      _ = C1 * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ N1 * (1 + t) ^ M1
            * Real.exp (-(2 * Real.pi * t)) := by ring
      _ ≤ _ := mono C1 hC1.le N1 M1 (le_max_left _ _) (le_max_left _ _)
  have hB : ‖Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z
        - (Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z‖
      ≤ C2 * ‖Work.Kernels.qParamFun τ‖ * (Work.Kernels.scale τ) ^ (max N1 N2)
          * (1 + t) ^ (max M1 M2) * Real.exp (-(2 * Real.pi * t)) :=
    le_trans h2'' (mono C2 hC2.le N2 M2 (le_max_right _ _) (le_max_right _ _))
  have htri : ‖Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z‖
      ≤ ‖Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z
            - (Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z‖
          + ‖(Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z‖ := by
    have h := norm_add_le (Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z
        - (Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z)
      ((Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z)
    have heq : Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z
        - (Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z
        + (Work.Residues.Ept z) ^ 2 * Bracket24E2' ℓ τ z
        = Work.Asymptotics.Compact.Sh τ z * Work.Asymptotics.KhatE1.Bracket24 ℓ τ z := by ring
    rwa [heq] at h
  refine le_trans (le_trans htri (add_le_add hB hA)) (le_of_eq ?_)
  ring


end Work.Asymptotics.KhatE1Core
