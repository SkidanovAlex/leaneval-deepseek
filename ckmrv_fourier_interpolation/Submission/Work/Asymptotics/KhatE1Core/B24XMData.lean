/-- `Xtrunc` with the `𝓛`-truncation `LT` extended by `-(48/5)E^5`. -/
def Xtrunc2X (ℓ : Work.Kernels.LogLambdaData) (τ z : ℍ) : ℂ :=
  Xtrunc ℓ τ z
    + ((3456 : ℂ) * (Real.pi : ℂ))⁻¹
        * (invDeltaT z * (3456 * Work.Kernels.DeltaFun τ * E14T z
            * ((48 : ℂ) / 5) * (Ept z) ^ 5))

