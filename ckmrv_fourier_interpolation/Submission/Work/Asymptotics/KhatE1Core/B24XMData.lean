/-- **The exact `E(z)`-decomposition of `Xtrunc2X` up to order `5`.** -/
theorem Xtrunc2X_decomp (ℓ : Work.Kernels.LogLambdaData) (τ z : ℍ) :
    Xtrunc2X ℓ τ z - Bracket24E2' ℓ τ z * (Ept z) ^ 2
        - Work.Asymptotics.KhatE1.Bracket24E3 ℓ τ z * (Ept z) ^ 3
        - Bracket24B4 ℓ τ z * (Ept z) ^ 4
        - Work.Asymptotics.KhatE1.Bracket24E5 ℓ τ z * (Ept z) ^ 5
      = (Ept z) ^ 4 * XR4X ℓ τ z + (Ept z) ^ 6 * XWX ℓ τ z := by
  have hE : (Ept z) ≠ 0 := by rw [Ept]; exact Complex.exp_ne_zero _
  have hΔ : Work.Kernels.DeltaFun τ ≠ 0 := Work.Kernels.ClassicalFacts.DeltaFun_ne_zero τ
  have hq : Work.Kernels.qParamFun z ≠ 0 := Work.Asymptotics.qParamFun_ne_zero' z
  have hI : Complex.I ≠ 0 := Complex.I_ne_zero
  have hπ : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  have hz : (z : ℂ) ≠ 0 := UpperHalfPlane.ne_zero z
  simp only [Xtrunc2X, Xtrunc, XR4X, XWX, Bracket24E2', Bracket24B4,
    Work.Asymptotics.KhatE1.Bracket24E3, Work.Asymptotics.KhatE1.Bracket24E5,
    KPlus24GroupT, brMinusT, ShT, A24T,
    Sm1T, Sm2T, Sm3T, Sm4T, Sm5T, PhiT, PfunT, UfunT, VfunT,
    Tq, Te, E4T, E6T, E8T, E10T, E14T, DeltaT, invDeltaT, invE4T, invE4cubeT, E2ST, WT,
    D2T, LT, jzT, d1T, Work.Asymptotics.K24F.c,
    Work.Asymptotics.K24F.Phiref, Work.Asymptotics.K24F.Pref, Work.Asymptotics.K24F.Q1,
    Work.Asymptotics.K24F.P1, Work.Asymptotics.K24F.Th0, Work.Asymptotics.K24F.Uref,
    Work.Asymptotics.K24F.r0, Work.Asymptotics.K24F.r1, Work.Asymptotics.K24F.r2,
    Work.Asymptotics.K24F.R0, Work.Asymptotics.K24F.S0,
    Work.Asymptotics.KhatE1.S0z,
    Work.Asymptotics.Compact.Xc, Work.Asymptotics.Compact.C24, Work.Asymptotics.Compact.B24,
    Work.Asymptotics.Compact.phi1, Work.Asymptotics.Compact.phi2t,
    Work.Asymptotics.E1combo24, Work.Asymptotics.KhatE1.Am24,
    Work.Kernels.E8Fun, Work.Kernels.E10Fun, Work.Kernels.E14Fun,
    Work.Asymptotics.K24F.qParamFun_eq_Ept_sq',
    Complex.I_sq, Complex.I_mul_I, zpow_neg, zpow_neg_one, pow_one, inv_pow]
  rw [Work.Asymptotics.Compact.br0_24]
  simp only [Work.Asymptotics.Compact.Nf, Work.Asymptotics.Compact.Mf,
    Work.Asymptotics.Compact.einv2, inv_pow, Work.Kernels.E8Fun, Work.Kernels.E10Fun,
    Work.Kernels.E14Fun, Work.Asymptotics.Compact.Xc]
  field_simp
  ring_nf
  simp only [Complex.I_sq, Complex.I_pow_three, Complex.I_pow_four]
  ring

/-! ## The `K₋`-part of `Xtrunc2X`, with the `𝓛`-correction bundled in -/

/-- The `K₋`-half of `Xtrunc2X`: `(3456π)⁻¹(brMinusT + ShT·br0 - ShT·E·(E1combo24+Am24))`
together with the `𝓛`-correction `(3456π)⁻¹·invDeltaT·3456·Δ(τ)·E14T·(48/5)·E⁵` that upgrades
the truncation `LT` of `𝓛(z)` to its fifth order `LT5 = LT - (48/5)E⁵`. -/
noncomputable def XMinusT (ℓ : Work.Kernels.LogLambdaData) (τ z : ℍ) : ℂ :=
  ((3456 : ℂ) * (Real.pi : ℂ))⁻¹
    * (brMinusT ℓ τ z + ShT τ z * Work.Asymptotics.Compact.br0 24 ℓ τ z
        - ShT τ z * Ept z * (Work.Asymptotics.E1combo24 ℓ τ + Work.Asymptotics.KhatE1.Am24 ℓ τ)
        + invDeltaT z * (3456 * Work.Kernels.DeltaFun τ * E14T z
            * ((48 : ℂ) / 5) * (Ept z) ^ 5))

theorem Xtrunc2X_eq (ℓ : Work.Kernels.LogLambdaData) (τ z : ℍ) :
    Xtrunc2X ℓ τ z = KPlus24GroupT τ z + XMinusT ℓ τ z := by
  rw [Xtrunc2X, Xtrunc, XMinusT]; ring

end

