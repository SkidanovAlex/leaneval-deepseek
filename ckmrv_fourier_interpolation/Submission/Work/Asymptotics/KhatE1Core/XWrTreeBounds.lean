/-! ## Raw statements -/

/-- **`\|XR4t\|` is `O((scale τ)^N (1+t)^M)`.** -/
theorem XR4t_bound (ℓ : Work.Kernels.LogLambdaData) :
    ∃ C N M : ℝ, 0 < C ∧ 0 ≤ N ∧ 0 ≤ M ∧
      ∀ (τ z : UpperHalfPlane) (t : ℝ), Work.Asymptotics.Funnel τ → τ.im + 1 ≤ t →
        0 ≤ z.re → z.re ≤ 1 → z.im = t →
        ‖XR4t_all ℓ τ z‖ ≤ C * (Work.Kernels.scale τ) ^ N * (1 + t) ^ M := by
  obtain ⟨C, N, M, hC, hN, hM, hb⟩ := BoundQ_XR4t_all ℓ
  refine ⟨C, N, M, hC, hN, hM, fun τ z t hF ht hz0 hz1 hzim => ?_⟩
  have h := hb τ z t hF ht hz0 hz1 hzim
  simpa only [zpow_zero, mul_one] using h

/-- **`\|XWt\|` is `O(‖q(τ)‖⁻¹ (scale τ)^N (1+t)^M)`.** -/
theorem XWt_bound (ℓ : Work.Kernels.LogLambdaData) :
    ∃ C N M : ℝ, 0 < C ∧ 0 ≤ N ∧ 0 ≤ M ∧
      ∀ (τ z : UpperHalfPlane) (t : ℝ), Work.Asymptotics.Funnel τ → τ.im + 1 ≤ t →
        0 ≤ z.re → z.re ≤ 1 → z.im = t →
        ‖XWt_all ℓ τ z‖ ≤ C * (‖Work.Kernels.qParamFun τ‖)⁻¹ * (Work.Kernels.scale τ) ^ N
          * (1 + t) ^ M := by
  obtain ⟨C, N, M, hC, hN, hM, hb⟩ := BoundQ_XWt_all ℓ
  refine ⟨C, N, M, hC, hN, hM, fun τ z t hF ht hz0 hz1 hzim => ?_⟩
  have h := hb τ z t hF ht hz0 hz1 hzim
  rw [show ‖Work.Kernels.qParamFun τ‖ ^ (-1 : ℤ) = (‖Work.Kernels.qParamFun τ‖)⁻¹
      from zpow_neg_one _] at h
  simpa only [mul_assoc] using h

/-! ## The glue to `Bracket24XtruncRing`

`XR4t_all`/`XWt_all` are *verbatim copies* of the definitions of `XR4`/`XW` in
`KhatE1Core/Bracket24XtruncRing.lean`.  As soon as that module compiles, the two glue lemmas are
`rfl`:

```
theorem XR4_eq_XR4t (ℓ : Work.Kernels.LogLambdaData) (τ z : ℍ) :
    XR4 ℓ τ z = XR4t_all ℓ τ z := rfl

theorem XW_eq_XWt (ℓ : Work.Kernels.LogLambdaData) (τ z : ℍ) :
    XW ℓ τ z = XWt_all ℓ τ z := rfl
```

(If the sibling regenerates `XR4`/`XW`, re-run `_genxw4.py` in the workspace root: it re-parses
the definitions from `Bracket24XtruncRing.lean` and re-emits `XWrTreeDefs.lean`,
`XWrTreeBounds.lean` with the matching tree cut, so the glue stays `rfl`.)
-/

end

