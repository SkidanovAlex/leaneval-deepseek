    ) ((min ((min ((min ((min ((-1 : ℤ)) ((-1 : ℤ)))) ((min ((-1 : ℤ)) ((-1 : ℤ)))))) ((min ((min ((-1 : ℤ)) ((0 : ℤ)))) ((min ((-1 : ℤ)) ((0 : ℤ)))))))) ((min ((min ((min ((0 : ℤ)) ((-1 : ℤ)))) ((min ((0 : ℤ)) ((-1 : ℤ)))))) ((min ((min ((0 : ℤ)) ((0 : ℤ)))) ((min ((0 : ℤ)) ((0 : ℤ)))))))))) := ((((((((BoundQ_XWt_c1 ℓ).add (BoundQ_XWt_c2 ℓ))).add (((BoundQ_XWt_c3 ℓ).add (BoundQ_XWt_c4 ℓ))))).add (((((BoundQ_XWt_c5 ℓ).add (BoundQ_XWt_c6 ℓ))).add (((BoundQ_XWt_c7 ℓ).add (BoundQ_XWt_c8 ℓ))))))).add (((((((BoundQ_XWt_c9 ℓ).add (BoundQ_XWt_c10 ℓ))).add (((BoundQ_XWt_c11 ℓ).add (BoundQ_XWt_c12 ℓ))))).add (((((BoundQ_XWt_c13 ℓ).add (BoundQ_XWt_c14 ℓ))).add (((BoundQ_XWt_c15 ℓ).add (BoundQ_XWt_c16 ℓ))))))))
