/-! ## Assembly from the cluster bounds -/

/-- **`XR4` at its natural weight.** -/
theorem BoundQ_XR4t_all (ℓ : Work.Kernels.LogLambdaData) :
    BoundQ (fun τ z => XR4t_all ℓ τ z) (0 : ℤ) := by
  have h : BoundQ (fun τ z =>
    ((XR4t_c1 ℓ τ z) + (XR4t_c2 ℓ τ z))
    ) ((min ((0 : ℤ)) ((0 : ℤ)))) := ((BoundQ_XR4t_c1 ℓ).add (BoundQ_XR4t_c2 ℓ))
  exact (h.mono (by decide)).congr (fun τ z => (XR4t_all_eq ℓ τ z).symm)

