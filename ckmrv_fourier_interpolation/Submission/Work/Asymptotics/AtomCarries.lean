/-
# The carries of the four atoms of the reduction

The reduction of `γ ∈ SL(2,ℤ)` modulo `𝓘 = Kernels.IdealI ⊔ (z-1)R` uses the four atoms
`T`, `T⁻¹`, `S` and `z = Rneg = -1`.  This file records the *carries* of the first row
`rowDiff (of μ) i` for these atoms: elements `a, b, c ∈ R` with

  `(T - 1)² a + S (T - 1)² b + (z - 1) c = rowDiff (of μ) i`.

The data is generated by the cocycle law from the four row-`0` identities below, and is the base
case of the recursion that produces the carries of an arbitrary group element.
-/
import Mathlib
import Submission.Work.Asymptotics.CarryDefs
import Submission.Work.Asymptotics.PeelWord
import Submission.Work.Residues.IdealImRowDiffAll

set_option maxHeartbeats 800000

noncomputable section

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle Topology

namespace Work.Asymptotics

open Work.Kernels

/-- The four atoms of the reduction. -/
def atomSet : Finset SL(2,ℤ) :=
  {ModularGroup.T, ModularGroup.T⁻¹, ModularGroup.S, -1}

/-- `(T - 1)² a + S (T - 1)² b + (z - 1) c` as an element of `R`. -/
def carryComb (a b c : R) : R :=
  (R_T - 1) ^ 2 * a + R_S * (R_T - 1) ^ 2 * b + (Work.Residues.Rneg - 1) * c

lemma carryComb_add (a b c a' b' c' : R) :
    carryComb (a + a') (b + b') (c + c') = carryComb a b c + carryComb a' b' c' := by
  simp only [carryComb]; noncomm_ring

lemma carryComb_smul (x : ℂ) (a b c : R) :
    carryComb (x • a) (x • b) (x • c) = x • carryComb a b c := by
  simp only [carryComb, mul_smul_comm, smul_add]

/-- The row-`0` error of `T` vanishes: the reduction of `T` is exact. -/
lemma rowDiff_T_zero : Work.Residues.rowDiff (MonoidAlgebra.of ℂ SL(2,ℤ) ModularGroup.T) 0 = 0 := by
  rw [show MonoidAlgebra.of ℂ SL(2,ℤ) ModularGroup.T = Work.Residues.M6 1 from rfl,
    Work.Residues.rowDiff]
  have hsum : (∑ j, (Work.Residues.sigmaR (Work.Residues.M6 1)) 0 j • Work.Residues.M6 j)
      = Work.Residues.M6 1 := by
    rw [Finset.sum_eq_single (1 : Fin 6)]
    · simp [Work.Residues.sigmaR_R_T, Work.Modular.sigmaT]
    · intro b _ hb
      fin_cases b <;> simp_all [Work.Residues.sigmaR_R_T, Work.Modular.sigmaT]
    · intro h; exact absurd (Finset.mem_univ (1 : Fin 6)) h
  rw [hsum, show Work.Residues.M6 0 = 1 from rfl, one_mul, sub_self]

/-- The row-`0` error of `S` vanishes. -/
lemma rowDiff_S_zero : Work.Residues.rowDiff (MonoidAlgebra.of ℂ SL(2,ℤ) ModularGroup.S) 0 = 0 := by
  rw [show MonoidAlgebra.of ℂ SL(2,ℤ) ModularGroup.S = Work.Residues.M6 3 from rfl,
    Work.Residues.rowDiff]
  have hsum : (∑ j, (Work.Residues.sigmaR (Work.Residues.M6 3)) 0 j • Work.Residues.M6 j)
      = Work.Residues.M6 3 := by
    rw [Finset.sum_eq_single (3 : Fin 6)]
    · simp [Work.Residues.sigmaR_R_S, Work.Modular.sigmaS]
    · intro b _ hb
      fin_cases b <;> simp_all [Work.Residues.sigmaR_R_S, Work.Modular.sigmaS]
    · intro h; exact absurd (Finset.mem_univ (3 : Fin 6)) h
  rw [hsum, show Work.Residues.M6 0 = 1 from rfl, one_mul, sub_self]

end Work.Asymptotics
