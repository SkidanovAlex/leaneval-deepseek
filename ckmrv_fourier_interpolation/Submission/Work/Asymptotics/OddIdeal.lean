/-
# The odd-weight defect ideal `𝓘_odd = (T-I)²R + S(T-I)²R + (1+z)R`

For an **even** weight `k` the slash action of `SL(2,ℤ)` on functions on `ℍ` descends to
`PSL(2,ℤ)`, equivalently `z = -I` acts by `+1`; the CKMRV propagation argument
(Proposition 3.2(1)) then runs with the ideal `𝓘 = (T-I)²R + S(T-I)²R + (z-1)R` of
`R = ℂ[SL(2,ℤ)]` (`Work.Residues.idealI`), whose elements have an action on `f` that is
computed from the two defects `(T-I)²f` and `S(T-I)²f` because `(z-1)` acts by `0`.

For an **odd** weight `k` the element `(z-1)` acts by multiplication by `-2`, whereas
`1 + z` acts by `0`.  The corresponding ideal is therefore

  `𝓘_odd = (T-I)²R + S(T-I)²R + (1+z)R`,

and the two defect generators have exactly the same computable action.  This file introduces
that ideal, together with the basic closure properties and the fact that `1 + z` acts by zero
at odd weight (`slash_one_add_Rneg`).
-/
import Mathlib
import Submission.Work.Kernels.GroupAlgebra
import Submission.Work.Kernels.AlgebraFacts.slash_mul
import Submission.Work.Kernels.SlashDefs
import Submission.Work.Asymptotics.DomainTiling

noncomputable section

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle

namespace Work.Asymptotics

open Work.Kernels

/-- The group algebra element attached to a matrix `γ ∈ SL(2,ℤ)`. -/
abbrev ofSL (γ : SL(2,ℤ)) : R := MonoidAlgebra.single γ 1

/-- The six elements `1, T⁻¹, STS, S, ST⁻¹, TS` of `R`, i.e. the images of `Work.Asymptotics.Mp`
in the group algebra.  For odd weight these are the natural "state" elements: the propagation
argument of CKMRV Proposition 3.2(1) reads the extension off the six functions `f|M'_i` and the
two defects, using the reduction `γ ≡ Σᵢ cᵢ M'_i (mod 𝓘_odd)`. -/
def MpElem (i : Fin 6) : R := MonoidAlgebra.single (Work.Asymptotics.Mp i) 1

@[simp] lemma MpElem_apply (i : Fin 6) :
    MpElem i = MonoidAlgebra.single (Work.Asymptotics.Mp i) (1 : ℂ) := rfl

/-- The element `z = -I` of `R = ℂ[SL(2,ℤ)]`. -/
abbrev Rneg : R := MonoidAlgebra.single (-1 : SL(2,ℤ)) 1

/-- The two-sided ideal `(1+z)R` of `R = ℂ[SL(2,ℤ)]` generated by `1 + z`.  This is the
odd-weight analogue of `Work.Residues.augIdeal = (z-1)R`. -/
def augIdealOdd : Submodule ℂ R :=
  Submodule.span ℂ {x : R | ∃ r s : R, x = r * (Rneg + 1) * s}

lemma Rneg_add_one_mem_augIdealOdd : Rneg + 1 ∈ augIdealOdd :=
  Submodule.subset_span ⟨1, 1, by simp⟩

/-- Right multiplication preserves `(1+z)R`. -/
lemma augIdealOdd_mul_mem {x : R} (hx : x ∈ augIdealOdd) (r : R) : x * r ∈ augIdealOdd := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, b, rfl⟩ := hy
    exact Submodule.subset_span ⟨a, b * r, by rw [mul_assoc]⟩
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add y z _ _ hy hz => rw [add_mul]; exact Submodule.add_mem _ hy hz
  | smul c y _ hy => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c hy

/-- The odd-weight defect ideal `𝓘_odd = (T-I)²R + S(T-I)²R + (1+z)R`. -/
def idealIOdd : Submodule ℂ R := Work.Kernels.IdealI ⊔ augIdealOdd

lemma IdealI_le_idealIOdd : Work.Kernels.IdealI ≤ idealIOdd := le_sup_left
lemma augIdealOdd_le_idealIOdd : augIdealOdd ≤ idealIOdd := le_sup_right

/-- `𝓘_odd` is closed under right multiplication. -/
lemma idealIOdd_mul_mem {x : R} (hx : x ∈ idealIOdd) (r : R) : x * r ∈ idealIOdd := by
  obtain ⟨a, ha, c, hc, rfl⟩ := Submodule.mem_sup.mp hx
  rw [add_mul]
  refine Submodule.add_mem _ (IdealI_le_idealIOdd ?_) (augIdealOdd_le_idealIOdd ?_)
  · obtain ⟨u, v, rfl⟩ := Work.Kernels.mem_span2.mp ha
    exact Work.Kernels.mem_span2.mpr ⟨u * r, v * r, by rw [add_mul, mul_assoc, mul_assoc]⟩
  · exact augIdealOdd_mul_mem hc r

/-- `z = -I` acts on functions of weight `k` by `(-1)^k`. -/
lemma slash_Rneg (k : ℤ) (F : ℍ → ℂ) : slash k Rneg F = fun τ => F τ * ((-1 : ℂ) ^ (-k)) := by
  rw [show Rneg = MonoidAlgebra.single (-1 : SL(2,ℤ)) 1 from rfl, slash_single]
  ext τ
  rw [one_smul, slash_apply']
  have hfix : (-1 : SL(2,ℤ)) • τ = τ := by
    rw [ModularGroup.SL_neg_smul]; simp
  rw [hfix, jFun_apply]
  norm_num [Matrix.neg_apply]

/-- **The generator `1 + z` acts by zero at odd weight.**  `z = -I` acts by `(-1)^k` on
functions of weight `k`; for odd `k` this is `-1`, so `1 + z` acts by `0`. -/
theorem slash_one_add_Rneg (k : ℤ) (hk : Odd k) (F : ℍ → ℂ) :
    slash k (Rneg + 1) F = 0 := by
  obtain ⟨m, hm⟩ := hk
  have hk1 : ((-1 : ℂ) ^ k) = -1 := by
    rw [hm, show ((2 : ℤ) * m + 1) = 2 * m + 1 from rfl,
      zpow_add₀ (show (-1 : ℂ) ≠ 0 by norm_num) (2 * m) 1,
      zpow_mul ((-1 : ℂ)) (2 : ℤ) m, zpow_two ((-1 : ℂ))]
    norm_num
  have hk2 : ((-1 : ℂ) ^ (-k)) = -1 := by
    rw [_root_.zpow_neg, hk1]
    norm_num
  rw [add_comm, slash_add, slash_one, slash_Rneg]
  ext τ
  simp only [Pi.add_apply, Pi.zero_apply]
  rw [hk2]
  ring

end Work.Asymptotics
