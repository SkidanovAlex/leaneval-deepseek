import Mathlib

namespace Work.Interpolation

open scoped FourierTransform SchwartzMap

/-- The Fourier transform on the Schwartz space is continuous for the Schwartz
seminorm topology: each seminorm of the Fourier transform of `f` is bounded by a
single one of the finitely many Schwartz seminorms of `f`.

This is a direct consequence of the fact that the Schwartz topology is generated
by `schwartzSeminormFamily` (`schwartz_withSeminorms`) and of the general fact
that a continuous seminorm on a space with a generating seminorm family is
controlled by finitely many seminorms of that family
(`Seminorm.bound_of_continuous`). -/
lemma fourier_seminorm_bound (n : ℕ) [NeZero n] (k l : ℕ) :
    ∃ s : Finset (ℕ × ℕ), ∃ C : ℝ, 0 ≤ C ∧ ∀ f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      (SchwartzMap.seminorm ℂ k l) (FourierTransform.fourierCLM ℂ (𝓢(EuclideanSpace ℝ (Fin n), ℂ)) f)
        ≤ C * s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin n)) ℂ) f := by
  -- The Schwartz topology is generated by the family of Schwartz seminorms.
  have hp : WithSeminorms (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin n)) ℂ) :=
    schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin n)) ℂ
  -- Hence each Schwartz seminorm is continuous.
  have hs : Continuous (SchwartzMap.seminorm ℂ k l : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) → ℝ) := by
    have h := hp.continuous_seminorm (k, l)
    simpa using h
  -- The composite seminorm `f ↦ (seminorm k l) (𝓕 f)` is continuous, since `𝓕` is a
  -- continuous linear map.
  have hq : Continuous ((SchwartzMap.seminorm ℂ k l).comp
      (FourierTransform.fourierCLM ℂ (𝓢(EuclideanSpace ℝ (Fin n), ℂ))).toLinearMap) := by
    rw [Seminorm.coe_comp]
    exact hs.comp (FourierTransform.fourierCLM ℂ (𝓢(EuclideanSpace ℝ (Fin n), ℂ))).continuous
  -- A continuous seminorm is bounded by finitely many seminorms of the generating family.
  obtain ⟨s, C, _hCne, hle⟩ :=
    Seminorm.bound_of_continuous hp ((SchwartzMap.seminorm ℂ k l).comp
      (FourierTransform.fourierCLM ℂ (𝓢(EuclideanSpace ℝ (Fin n), ℂ))).toLinearMap) hq
  refine ⟨s, (C : ℝ), C.coe_nonneg, ?_⟩
  intro f
  have h := Seminorm.le_def.mp hle f
  rw [Seminorm.comp_apply] at h
  calc (SchwartzMap.seminorm ℂ k l) (FourierTransform.fourierCLM ℂ (𝓢(EuclideanSpace ℝ (Fin n), ℂ)) f)
      ≤ (C • s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin n)) ℂ)) f := h
    _ = (C : ℝ) * s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin n)) ℂ) f := by
        rw [smul_apply, NNReal.smul_def, smul_eq_mul]

end Work.Interpolation
