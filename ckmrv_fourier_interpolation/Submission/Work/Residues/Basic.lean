/-
# The ideals `𝓘`, `𝓘_±` of CKMRV and the collapse ideal `(z - 1)R`

CKMRV (Cohn--Kumar--Miller--Radchenko--Viazovska, Ann. of Math. 196 (2022)) work with the
group algebra `R = ℂ[PSL(2,ℤ)]`, or equivalently with `ℂ[SL(2,ℤ)]` modulo the relation
`-I = 1` (the weights occurring in the paper are even, so `-I` acts trivially on functions
on `ℍ`).  The kernels of `Work.Kernels` live in `ℂ[SL(2,ℤ)]`, so this chapter works there
and adjoins the extra generator `z - 1`, `z = -I ∈ SL(2,ℤ)`:

  `𝓘   = (T-I)²R + S(T-I)²R + (z-1)R`,
  `𝓘_± = (S±I)R + (T-I)²R + (z-1)R`,

where the first two summands are `Work.Kernels.IdealI`, `Work.Kernels.IdealIp` and
`Work.Kernels.IdealIm`.

## Main definitions

* `Work.Residues.Rneg` : the element `z = -I` of `R`.
* `Work.Residues.augIdeal` : the two-sided ideal `(z - 1)R`.
* `Work.Residues.idealI`, `idealIp`, `idealIm` : the ideals above.
* `Work.Residues.M6`, `Work.Residues.M3` : the elements `1, T, TS, S, ST, STS` and
  `1, T, TS`, whose images are the bases of `R/𝓘` and `R/𝓘_±` (paper Proposition 3.8).

## Main results

* `Work.Residues.idealI_eq_idealIp_inf_idealIm` : `𝓘 = 𝓘_+ ⊓ 𝓘_-`.
* `Work.Residues.R_S_sub_one_mul_mem_idealI` and `R_S_add_one_mul_mem_idealI` : the
  `ε`-eigenvector action `(S - εI)·𝓘_ε ⊆ 𝓘`.
* `Work.Residues.slash_Rneg_sub_one` : at even weight `(z-1)` acts by zero.
-/
import Mathlib
import Submission.Work.Kernels.GroupAlgebra

noncomputable section

set_option maxHeartbeats 1000000

open UpperHalfPlane ModularForm ModularGroup Matrix
open scoped MatrixGroups ModularForm Modular Manifold Bundle

namespace Work.Residues

open Work.Kernels

/-! ## The element `z = -I` and the collapse ideal `(z - 1)R` -/

/-- The element `z = -I` of `R = ℂ[SL(2,ℤ)]`.  Since the weights occurring in the paper are
even, `z` acts trivially on functions on `ℍ`; `𝓘` and `𝓘_±` below are the preimages of the
paper's ideals under the projection `ℂ[SL(2,ℤ)] → ℂ[PSL(2,ℤ)]`. -/
abbrev Rneg : R := MonoidAlgebra.single (-1 : SL(2,ℤ)) 1

lemma Rneg_eq_of : Rneg = MonoidAlgebra.of ℂ SL(2,ℤ) (-1 : SL(2,ℤ)) := rfl

@[simp] lemma Rneg_mul_Rneg : Rneg * Rneg = (1 : R) := by
  rw [Rneg, MonoidAlgebra.single_mul_single, neg_mul, one_mul, neg_neg, MonoidAlgebra.one_def]
  norm_num

/-- `z = -I` is central in `R`. -/
lemma Rneg_comm (r : R) : Rneg * r = r * Rneg := by
  induction r using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [mul_add, add_mul, hx, hy]
  | single γ c =>
    rw [Rneg, MonoidAlgebra.single_mul_single, MonoidAlgebra.single_mul_single]
    rw [show (-1 : SL(2,ℤ)) * γ = γ * (-1) by rw [neg_mul, mul_neg, one_mul, mul_one]]
    simp

lemma mul_Rneg (r : R) : r * Rneg = Rneg * r := (Rneg_comm r).symm

/-- The two-sided ideal `(z - 1)R` generated by `z - 1 = -I - 1`.  Its quotient is
`ℂ[PSL(2,ℤ)]`, and it is contained in every ideal that kills functions of even weight
under the slash action. -/
def augIdeal : Submodule ℂ R :=
  Submodule.span ℂ {x : R | ∃ r s : R, x = r * (Rneg - 1) * s}

lemma Rneg_sub_one_mem_augIdeal : Rneg - 1 ∈ augIdeal :=
  Submodule.subset_span ⟨1, 1, by simp⟩

lemma mul_mem_augIdeal_left {x : R} (hx : x ∈ augIdeal) (r : R) : r * x ∈ augIdeal := by
  refine Submodule.span_induction (p := fun y _ => r * y ∈ augIdeal) ?_ ?_ ?_ ?_ hx
  · rintro y ⟨a, b, rfl⟩
    exact Submodule.subset_span ⟨r * a, b, by simp only [mul_assoc]⟩
  · rw [mul_zero]; exact Submodule.zero_mem _
  · intro y z _ _ hy hz; rw [mul_add]; exact Submodule.add_mem _ hy hz
  · intro c y _ hy; rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy

lemma mul_mem_augIdeal_right {x : R} (hx : x ∈ augIdeal) (r : R) : x * r ∈ augIdeal := by
  refine Submodule.span_induction (p := fun y _ => y * r ∈ augIdeal) ?_ ?_ ?_ ?_ hx
  · rintro y ⟨a, b, rfl⟩
    exact Submodule.subset_span ⟨a, b * r, by rw [mul_assoc]⟩
  · rw [zero_mul]; exact Submodule.zero_mem _
  · intro y z _ _ hy hz; rw [add_mul]; exact Submodule.add_mem _ hy hz
  · intro c y _ hy; rw [smul_mul_assoc]; exact Submodule.smul_mem _ c hy

lemma mul_Rneg_sub_one_mem (r : R) : r * (Rneg - 1) ∈ augIdeal :=
  Submodule.subset_span ⟨r, 1, by rw [mul_one]⟩

lemma Rneg_sub_one_mul_mem (r : R) : (Rneg - 1) * r ∈ augIdeal :=
  Submodule.subset_span ⟨1, r, by rw [one_mul]⟩

/-! ## The ideals `𝓘`, `𝓘_±` -/

/-- `𝓘 = (T-I)²R + S(T-I)²R + (z-1)R`. -/
def idealI : Submodule ℂ R := Work.Kernels.IdealI ⊔ augIdeal

/-- `𝓘_+ = (S+I)R + (T-I)²R + (z-1)R`. -/
def idealIp : Submodule ℂ R := Work.Kernels.IdealIp ⊔ augIdeal

/-- `𝓘_- = (S-I)R + (T-I)²R + (z-1)R`. -/
def idealIm : Submodule ℂ R := Work.Kernels.IdealIm ⊔ augIdeal

lemma IdealI_le_idealI : Work.Kernels.IdealI ≤ idealI := le_sup_left

lemma IdealIp_le_idealIp : Work.Kernels.IdealIp ≤ idealIp := le_sup_left

lemma IdealIm_le_idealIm : Work.Kernels.IdealIm ≤ idealIm := le_sup_left

lemma augIdeal_le_idealI : augIdeal ≤ idealI := le_sup_right

lemma augIdeal_le_idealIp : augIdeal ≤ idealIp := le_sup_right

lemma augIdeal_le_idealIm : augIdeal ≤ idealIm := le_sup_right

lemma idealI_le_idealIp : idealI ≤ idealIp :=
  sup_le (le_trans Work.Kernels.IdealI_le_IdealIp le_sup_left) le_sup_right

lemma idealI_le_idealIm : idealI ≤ idealIm :=
  sup_le (le_trans Work.Kernels.IdealI_le_IdealIm le_sup_left) le_sup_right

/-! ## The elements `1, T, TS, S, ST, STS` and `1, T, TS` -/

/-- The six elements `1, T, TS, S, ST, STS` of `R` (paper (3.11)). -/
def M6 : Fin 6 → R := ![1, R_T, R_T * R_S, R_S, R_S * R_T, R_S * R_T * R_S]

/-- The three elements `1, T, TS` of `R`; their images are a basis of `R/𝓘_±`
(paper Proposition 3.8(2)). -/
def M3 : Fin 3 → R := ![1, R_T, R_T * R_S]

@[simp] lemma M3_zero : M3 0 = (1 : R) := rfl
@[simp] lemma M3_one : M3 1 = R_T := rfl
@[simp] lemma M3_two : M3 2 = R_T * R_S := rfl

@[simp] lemma M6_zero : M6 0 = (1 : R) := rfl
@[simp] lemma M6_one : M6 1 = R_T := rfl
@[simp] lemma M6_two : M6 2 = R_T * R_S := rfl
@[simp] lemma M6_three : M6 3 = R_S := rfl
@[simp] lemma M6_four : M6 4 = R_S * R_T := rfl
@[simp] lemma M6_five : M6 5 = R_S * R_T * R_S := rfl

/-! ## The generators of `𝓘` and `𝓘_±` -/

lemma gen_T2_mem_IdealI (q : R) : (R_T - 1) ^ 2 * q ∈ Work.Kernels.IdealI :=
  ⟨q, 0, by rw [mul_zero, add_zero]⟩

lemma gen_S_T2_mem_IdealI (q : R) : R_S * (R_T - 1) ^ 2 * q ∈ Work.Kernels.IdealI :=
  ⟨0, q, by rw [mul_zero, zero_add]⟩

lemma gen_S_add_mem_IdealIp (q : R) : (R_S + 1) * q ∈ Work.Kernels.IdealIp :=
  ⟨q, 0, by rw [mul_zero, add_zero]⟩

lemma gen_T2_mem_IdealIp (q : R) : (R_T - 1) ^ 2 * q ∈ Work.Kernels.IdealIp :=
  ⟨0, q, by rw [mul_zero, zero_add]⟩

lemma gen_S_sub_mem_IdealIm (q : R) : (R_S - 1) * q ∈ Work.Kernels.IdealIm :=
  ⟨q, 0, by rw [mul_zero, add_zero]⟩

lemma gen_T2_mem_IdealIm (q : R) : (R_T - 1) ^ 2 * q ∈ Work.Kernels.IdealIm :=
  ⟨0, q, by rw [mul_zero, zero_add]⟩

lemma gen_S_mul_T2_mem_IdealIm (q : R) : R_S * (R_T - 1) ^ 2 * q ∈ Work.Kernels.IdealIm := by
  have e : R_S * (R_T - 1) ^ 2 * q
      = (R_S - 1) * ((R_T - 1) ^ 2 * q) + (R_T - 1) ^ 2 * q := by
    rw [sub_mul, one_mul, mul_assoc]
    abel
  rw [e]
  exact Submodule.add_mem _ ⟨(R_T - 1) ^ 2 * q, 0, by rw [mul_zero, add_zero]⟩
    ⟨0, q, by rw [mul_zero, zero_add]⟩

/-! ## The `ε`-eigenvector action `(S - εI)·𝓘_ε ⊆ 𝓘`

The two computations are `(S - I)(S + I) = z - 1` (which lies in `𝓘`) and
`(S - εI)(T - I)² r = S(T-I)²r - ε(T-I)²r ∈ 𝓘`. -/

lemma R_S_mul_R_S_eq : R_S * R_S = Rneg := by
  rw [R_S, Rneg, MonoidAlgebra.single_mul_single]
  congr 1
  · exact (show (ModularGroup.S * ModularGroup.S : SL(2,ℤ)) = -1 from by decide)
  · norm_num

lemma R_S_sub_one_mul_R_S_add_one : (R_S - 1) * (R_S + 1) = Rneg - 1 := by
  have e : (R_S - 1) * (R_S + 1) = R_S * R_S - 1 := by noncomm_ring
  rw [e, R_S_mul_R_S_eq]

lemma R_S_add_one_mul_R_S_sub_one : (R_S + 1) * (R_S - 1) = Rneg - 1 := by
  have e : (R_S + 1) * (R_S - 1) = R_S * R_S - 1 := by noncomm_ring
  rw [e, R_S_mul_R_S_eq]

/-- `(S - I)(T-I)²q ∈ 𝓘`. -/
lemma R_S_sub_one_mul_gen_I {q : R} :
    (R_S - 1) * ((R_T - 1) ^ 2 * q) ∈ idealI := by
  rw [sub_mul, one_mul]
  refine Submodule.sub_mem _ ?_ ?_
  · rw [← mul_assoc]; exact IdealI_le_idealI (gen_S_T2_mem_IdealI q)
  · exact IdealI_le_idealI (gen_T2_mem_IdealI q)

/-- `(S + I)(T-I)²q ∈ 𝓘`. -/
lemma R_S_add_one_mul_gen_I {q : R} :
    (R_S + 1) * ((R_T - 1) ^ 2 * q) ∈ idealI := by
  rw [add_mul, one_mul]
  refine Submodule.add_mem _ ?_ ?_
  · rw [← mul_assoc]; exact IdealI_le_idealI (gen_S_T2_mem_IdealI q)
  · exact IdealI_le_idealI (gen_T2_mem_IdealI q)

/-- `(S - I)·𝓘_+ ⊆ 𝓘`. -/
lemma R_S_sub_one_mul_mem_idealI {x : R} (hx : x ∈ idealIp) : (R_S - 1) * x ∈ idealI := by
  obtain ⟨a, ha, c, hc, rfl⟩ := Submodule.mem_sup.mp hx
  obtain ⟨p, q, hp⟩ := Work.Kernels.mem_span2.mp ha
  rw [hp]
  simp only [mul_add]
  refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_
  · rw [← mul_assoc, R_S_sub_one_mul_R_S_add_one]
    exact augIdeal_le_idealI (Rneg_sub_one_mul_mem p)
  · exact R_S_sub_one_mul_gen_I
  · exact augIdeal_le_idealI (mul_mem_augIdeal_left hc (R_S - 1))

/-- `(S + I)·𝓘_- ⊆ 𝓘`. -/
lemma R_S_add_one_mul_mem_idealI {x : R} (hx : x ∈ idealIm) : (R_S + 1) * x ∈ idealI := by
  obtain ⟨a, ha, c, hc, rfl⟩ := Submodule.mem_sup.mp hx
  obtain ⟨p, q, hp⟩ := Work.Kernels.mem_span2.mp ha
  rw [hp]
  simp only [mul_add]
  refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_
  · rw [← mul_assoc, R_S_add_one_mul_R_S_sub_one]
    exact augIdeal_le_idealI (Rneg_sub_one_mul_mem p)
  · exact R_S_add_one_mul_gen_I
  · exact augIdeal_le_idealI (mul_mem_augIdeal_left hc (R_S + 1))

/-- **`𝓘_+ ∩ 𝓘_- = 𝓘`** (paper Proposition 3.8, first paragraph).  If `x` lies in both ideals,
then `(S - I)x` and `(S + I)x` lie in `𝓘`, hence so does their difference `2x`. -/
lemma idealI_eq_idealIp_inf_idealIm : idealI = idealIp ⊓ idealIm := by
  refine le_antisymm ?_ ?_
  · intro x hx
    exact ⟨idealI_le_idealIp hx, idealI_le_idealIm hx⟩
  · intro x hx
    obtain ⟨h1, h2⟩ := Submodule.mem_inf.mp hx
    have hsub : (R_S + 1) * x - (R_S - 1) * x ∈ idealI :=
      Submodule.sub_mem _ (R_S_add_one_mul_mem_idealI h2) (R_S_sub_one_mul_mem_idealI h1)
    have e : (R_S + 1) * x - (R_S - 1) * x = (2 : ℂ) • x := by
      rw [Algebra.smul_def, map_ofNat]
      noncomm_ring
    have h2x : (2 : ℂ) • x ∈ idealI := by rwa [e] at hsub
    have hfin : ((2 : ℂ)⁻¹ • ((2 : ℂ) • x)) ∈ idealI := Submodule.smul_mem _ _ h2x
    rwa [smul_smul, inv_mul_cancel₀ (by norm_num : (2:ℂ) ≠ 0), one_smul] at hfin

end Work.Residues
