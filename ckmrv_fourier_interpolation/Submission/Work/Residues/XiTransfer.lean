/-
# The transfer `ℂ[SL(2,ℤ)] → ℂ[Γ] ≅ ℂ[PSL(2,ℤ)]`

CKMRV's kernels live in `R = ℂ[SL(2,ℤ)]` (`Work.Kernels.R`), while the group algebra that
acts on functions on `ℍ` is `ℂ[PSL(2,ℤ)]`, realised in this development as `ℂ[Γ]`
(`Work.Modular.GroupRing`) for the abstract presentation `Γ = ⟨S, T | S² = (ST)³ = 1⟩`.

This file sets up the algebra homomorphism

  `Xi : R →ₐ[ℂ] ℂ[Γ]`

induced by the composite `SL(2,ℤ) → PSL(2,ℤ) ≅ Γ`, proves that it kills the ideal
`augIdeal = (z - 1)R`, `z = -I`, and — the key point — that it kills *nothing else*:

* `Xi_ker` : `LinearMap.ker Xi = augIdeal`.

The proof of `LinearMap.ker Xi ≤ augIdeal` uses an explicit set-theoretic section of the
quotient map: `sec δ` is a lift of `δ`, and every `γ ∈ SL(2,ℤ)` satisfies
`γ = sec (toGamma γ)` or `γ = - sec (toGamma γ)` (the kernel of `SL(2,ℤ) →* PSL(2,ℤ)` is
`{±1}`, the centre).  Consequently `single γ 1 - single (sec (toGamma γ)) 1` is a multiple of
`z - 1`, and a general element `x` differs from `∑ c_δ • single (sec δ) 1` by an element of
`augIdeal`; if `Xi x = 0` this last combination is `0`.
-/
import Mathlib
import Submission.Work.Residues.Basic
import Submission.Work.Modular.quotient_basis
import Submission.Work.Modular.finrank_quotient_PSL

noncomputable section

open scoped MonoidAlgebra MatrixGroups
open Matrix ModularGroup

namespace Work.Residues

open Work.Kernels

/-! ## The map `SL(2,ℤ) → PSL(2,ℤ)` and the transfer to `ℂ[Γ]` -/

/-- The quotient map `SL(2, ℤ) → PSL(2, ℤ)`. -/
def toPSL : SL(2, ℤ) →* PSL(2, ℤ) :=
  QuotientGroup.mk' (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) ℤ))

/-- The composite `SL(2, ℤ) → PSL(2, ℤ) ≅ Γ`, where `Γ = ⟨S, T | S² = (ST)³ = 1⟩` is the
abstract presentation used for `PSL(2, ℤ)` in this development. -/
def toGamma : SL(2, ℤ) →* Work.Modular.Gamma :=
  Work.Modular.pslQuotEquiv.symm.toMonoidHom.comp toPSL

/-- The algebra homomorphism `R = ℂ[SL(2,ℤ)] → ℂ[Γ]` induced by `toGamma`.  Its kernel is the
ideal `(z - 1)R` generated by `z - 1 = -I - 1`, so it factors through `R ⧸ augIdeal`. -/
def Xi : R →ₐ[ℂ] Work.Modular.GroupRing :=
  MonoidAlgebra.mapDomainAlgHom ℂ ℂ toGamma

lemma toGamma_S : toGamma ModularGroup.S = Work.Modular.genS := by
  simp only [toGamma, MonoidHom.comp_apply]
  change Work.Modular.pslQuotEquiv.symm (toPSL ModularGroup.S) = Work.Modular.genS
  rw [show toPSL ModularGroup.S = Work.Modular.pslS from rfl, ← Work.Modular.pslQuotEquiv_genS,
    MulEquiv.symm_apply_apply]

lemma toGamma_T : toGamma ModularGroup.T = Work.Modular.genT := by
  simp only [toGamma, MonoidHom.comp_apply]
  change Work.Modular.pslQuotEquiv.symm (toPSL ModularGroup.T) = Work.Modular.genT
  rw [show toPSL ModularGroup.T = Work.Modular.pslT from rfl, ← Work.Modular.pslQuotEquiv_genT,
    MulEquiv.symm_apply_apply]

/-! ## `z = -I` is killed -/

lemma scalar_neg_one_eq :
    (Matrix.scalar (Fin 2)) (-1 : ℤ) = ((-1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) := by
  rw [show (-1 : ℤ) = -(1 : ℤ) by ring, map_neg, map_one,
    Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]

lemma toPSL_neg_one : toPSL (-1 : SL(2, ℤ)) = 1 := by
  change (QuotientGroup.mk (-1 : SL(2, ℤ)) : PSL(2, ℤ)) = 1
  rw [QuotientGroup.eq_one_iff (-1 : SL(2, ℤ))]
  exact Matrix.SpecialLinearGroup.mem_center_iff.mpr ⟨-1, by norm_num, scalar_neg_one_eq⟩

lemma toGamma_neg_one : toGamma (-1 : SL(2, ℤ)) = 1 := by
  simp only [toGamma, MonoidHom.comp_apply, toPSL_neg_one, map_one]

lemma neg_one_mul_SL (x : SL(2, ℤ)) : (-1 : SL(2, ℤ)) * x = -x := by
  refine Subtype.ext ?_
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_neg,
    Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]
  simp

lemma mul_neg_one_SL (x : SL(2, ℤ)) : x * (-1 : SL(2, ℤ)) = -x := by
  refine Subtype.ext ?_
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_neg,
    Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]
  simp

lemma single_neg_eq (x : SL(2, ℤ)) :
    MonoidAlgebra.single (-x) (1 : ℂ) = MonoidAlgebra.single x 1 * Rneg := by
  rw [Rneg, MonoidAlgebra.single_mul_single, mul_neg_one_SL, mul_one]

/-! ## Elementary values of `Xi` -/

@[simp]
lemma Xi_of (γ : SL(2, ℤ)) :
    Xi (MonoidAlgebra.of ℂ SL(2, ℤ) γ) = MonoidAlgebra.of ℂ Work.Modular.Gamma (toGamma γ) := by
  simp [Xi, MonoidAlgebra.mapDomainAlgHom_apply, MonoidAlgebra.of_apply,
    MonoidAlgebra.mapDomain_single]

lemma Xi_R_T : Xi R_T = Work.Modular.tR := by
  rw [show R_T = MonoidAlgebra.of ℂ SL(2, ℤ) ModularGroup.T from rfl, Xi_of, toGamma_T]
  rfl

lemma Xi_R_S : Xi R_S = Work.Modular.sR := by
  rw [show R_S = MonoidAlgebra.of ℂ SL(2, ℤ) ModularGroup.S from rfl, Xi_of, toGamma_S]
  rfl

lemma Xi_Rneg : Xi Rneg = 1 := by
  rw [Rneg, show MonoidAlgebra.single (-1 : SL(2, ℤ)) (1 : ℂ)
      = MonoidAlgebra.of ℂ SL(2, ℤ) (-1 : SL(2, ℤ)) from rfl, Xi_of, toGamma_neg_one,
    map_one]

lemma Xi_M6 : ∀ i : Fin 6, Xi (M6 i) = Work.Modular.basisElem i := by
  intro i
  fin_cases i
  · show Xi 1 = (1 : Work.Modular.GroupRing)
    rw [map_one]
  · show Xi R_T = Work.Modular.tR
    exact Xi_R_T
  · show Xi (R_T * R_S) = Work.Modular.tR * Work.Modular.sR
    rw [map_mul, Xi_R_T, Xi_R_S]
  · show Xi R_S = Work.Modular.sR
    exact Xi_R_S
  · show Xi (R_S * R_T) = Work.Modular.sR * Work.Modular.tR
    rw [map_mul, Xi_R_S, Xi_R_T]
  · show Xi (R_S * R_T * R_S) = Work.Modular.sR * Work.Modular.tR * Work.Modular.sR
    rw [map_mul, map_mul, Xi_R_S, Xi_R_T]

lemma augIdeal_le_ker_Xi : augIdeal ≤ LinearMap.ker Xi.toLinearMap := by
  refine Submodule.span_le.mpr ?_
  rintro x ⟨r, s, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker]
  change Xi (r * (Rneg - 1) * s) = 0
  rw [map_mul, map_mul, map_sub, Xi_Rneg, map_one, sub_self]
  simp

/-! ## The kernel is exactly `(z - 1)R` -/

/-- The kernel of `SL(2,ℤ) →* PSL(2,ℤ)` is the centre `{±1}`: an element of `SL(2,ℤ)` of
order dividing `2` is a scalar matrix with scalar square `1`, i.e. `±I`. -/
lemma ker_toGamma_le (γ : SL(2, ℤ)) (h : toGamma γ = 1) : γ = 1 ∨ γ = -1 := by
  have h1 : toPSL γ = 1 := by
    have := congrArg Work.Modular.pslQuotEquiv h
    simpa [toGamma, MonoidHom.comp_apply] using this
  have h2 : (γ : PSL(2, ℤ)) = 1 := by
    change (QuotientGroup.mk γ : PSL(2, ℤ)) = 1
    rw [QuotientGroup.eq_one_iff γ]
    change (QuotientGroup.mk γ : PSL(2, ℤ)) = 1 at h1
    rwa [QuotientGroup.eq_one_iff γ] at h1
  obtain ⟨r, hr, hsc⟩ :=
    Matrix.SpecialLinearGroup.mem_center_iff.mp (QuotientGroup.eq_one_iff γ |>.mp h2)
  rcases sq_eq_one_iff.mp hr with rfl | rfl
  · left
    refine Subtype.ext ?_
    simpa using hsc.symm
  · right
    refine Subtype.ext ?_
    rw [← hsc, scalar_neg_one_eq]

lemma toGamma_surjective : Function.Surjective toGamma :=
  Work.Modular.pslQuotEquiv.symm.surjective.comp (QuotientGroup.mk'_surjective _)

/-- A (non-multiplicative) section of `SL(2,ℤ) →* Γ`. -/
def sec (δ : Work.Modular.Gamma) : SL(2, ℤ) := Classical.choose (toGamma_surjective δ)

lemma toGamma_sec (δ : Work.Modular.Gamma) : toGamma (sec δ) = δ :=
  Classical.choose_spec (toGamma_surjective δ)

/-- Every `γ : SL(2,ℤ)` is either the chosen lift of its class or its negative. -/
lemma eq_sec_or_eq_neg_sec (γ : SL(2, ℤ)) :
    γ = sec (toGamma γ) ∨ γ = - sec (toGamma γ) := by
  have h : toGamma (γ * (sec (toGamma γ))⁻¹) = 1 := by
    rw [map_mul, map_inv, toGamma_sec, mul_inv_cancel]
  rcases ker_toGamma_le _ h with h1 | h1
  · left
    calc γ = (γ * (sec (toGamma γ))⁻¹) * sec (toGamma γ) := by
          rw [mul_assoc, inv_mul_cancel, mul_one]
      _ = 1 * sec (toGamma γ) := by rw [h1]
      _ = sec (toGamma γ) := by rw [one_mul]
  · right
    calc γ = (γ * (sec (toGamma γ))⁻¹) * sec (toGamma γ) := by
          rw [mul_assoc, inv_mul_cancel, mul_one]
      _ = (-1 : SL(2, ℤ)) * sec (toGamma γ) := by rw [h1]
      _ = - sec (toGamma γ) := neg_one_mul_SL _

/-- If `γ` equals the chosen lift `s` of its own class, the two monomials coincide. -/
lemma single_sub_mem_of_eq {γ s : SL(2, ℤ)} (h : γ = s) :
    MonoidAlgebra.single γ (1 : ℂ) - MonoidAlgebra.single s 1 ∈ augIdeal := by
  rw [h, sub_self]
  exact Submodule.zero_mem _

/-- If `γ` is minus the chosen lift `s` of its own class, the difference of the two monomials
is `single s 1 * (z - 1)`. -/
lemma single_sub_mem_of_eq_neg {γ s : SL(2, ℤ)} (h : γ = -s) :
    MonoidAlgebra.single γ (1 : ℂ) - MonoidAlgebra.single s 1 ∈ augIdeal := by
  rw [h, single_neg_eq]
  have heq : MonoidAlgebra.single s 1 * Rneg - MonoidAlgebra.single s 1
      = MonoidAlgebra.single s 1 * (Rneg - 1) := by
    noncomm_ring
  rw [heq]
  exact mul_mem_augIdeal_left Rneg_sub_one_mem_augIdeal _

lemma single_sub_sec_mem (γ : SL(2, ℤ)) :
    MonoidAlgebra.single γ (1 : ℂ) - MonoidAlgebra.single (sec (toGamma γ)) 1 ∈ augIdeal := by
  rcases eq_sec_or_eq_neg_sec γ with h | h
  · exact single_sub_mem_of_eq h
  · exact single_sub_mem_of_eq_neg h

/-! ## The "tautological" section as a linear map -/

/-- Coefficients as a linear map (the `ℂ`-linear structure of `ℂ[Γ]` is that of the free
module on `Γ`). -/
def coeffLinear : Work.Modular.GroupRing →ₗ[ℂ] (Work.Modular.Gamma →₀ ℂ) where
  toFun := MonoidAlgebra.coeff
  map_add' := fun x y => MonoidAlgebra.coeff_add x y
  map_smul' := fun c x => MonoidAlgebra.coeff_smul c x

/-- The linear map sending `δ ∈ Γ` to the chosen lift `single (sec δ) 1 ∈ R`. -/
def Tat : Work.Modular.GroupRing →ₗ[ℂ] R :=
  (Finsupp.linearCombination ℂ
    (fun δ : Work.Modular.Gamma => MonoidAlgebra.single (sec δ) (1 : ℂ))).comp coeffLinear

lemma Tat_single (δ : Work.Modular.Gamma) (c : ℂ) :
    Tat (MonoidAlgebra.single δ c) = c • MonoidAlgebra.single (sec δ) 1 := by
  rw [Tat, LinearMap.comp_apply]
  change (Finsupp.linearCombination ℂ
      (fun δ : Work.Modular.Gamma => MonoidAlgebra.single (sec δ) (1 : ℂ)))
      (MonoidAlgebra.coeff (MonoidAlgebra.single δ c)) = c • MonoidAlgebra.single (sec δ) 1
  rw [MonoidAlgebra.coeff_single, Finsupp.linearCombination_single]

lemma Tat_of (δ : Work.Modular.Gamma) :
    Tat (MonoidAlgebra.of ℂ Work.Modular.Gamma δ) = MonoidAlgebra.single (sec δ) 1 := by
  rw [MonoidAlgebra.of_apply, Tat_single, one_smul]

/-- An element of `R` differs from the chosen lift of its image in `ℂ[Γ]` by an element of
`augIdeal`. -/
lemma sub_Tat_Xi_mem (x : R) : x - Tat (Xi x) ∈ augIdeal := by
  induction x using MonoidAlgebra.induction_on with
  | of γ =>
      rw [Xi_of, Tat_of, MonoidAlgebra.of_apply]
      exact single_sub_sec_mem γ
  | add x y hx hy =>
      rw [show x + y - Tat (Xi (x + y)) = (x - Tat (Xi x)) + (y - Tat (Xi y)) by
        rw [map_add, map_add]; abel]
      exact Submodule.add_mem _ hx hy
  | smul c x hx =>
      rw [map_smul, map_smul, ← smul_sub]
      exact Submodule.smul_mem _ c hx

lemma ker_Xi_le_augIdeal : LinearMap.ker Xi.toLinearMap ≤ augIdeal := by
  intro x hx
  have hx0 : Xi x = 0 := LinearMap.mem_ker.mp hx
  have h := sub_Tat_Xi_mem x
  rw [hx0, map_zero, sub_zero] at h
  exact h

/-- **The collapse `z = -I` is the only relation imposed by `ℂ[SL(2,ℤ)] → ℂ[PSL(2,ℤ)]`.** -/
theorem Xi_ker : LinearMap.ker Xi.toLinearMap = augIdeal :=
  le_antisymm ker_Xi_le_augIdeal augIdeal_le_ker_Xi

end Work.Residues
