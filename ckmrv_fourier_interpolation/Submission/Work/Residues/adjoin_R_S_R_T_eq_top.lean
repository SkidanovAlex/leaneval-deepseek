import Mathlib
import Submission.Work.Residues.IdealImDefs

open scoped MatrixGroups
open Work.Kernels

namespace Work.Residues

/-- `R = ℂ[SL(2,ℤ)]` is generated as a `ℂ`-algebra by the group-algebra elements `S` and
`T`: since `Subgroup.closure {ModularGroup.S, ModularGroup.T} = ⊤`
(`Work.Modular.SL2Z_closure_S_T`), every `γ : SL(2,ℤ)` is a product of `S`, `T` and their
inverses, and `S⁻¹ = S^3`, `T⁻¹ = S*T*S*T*S^3` are positive words in `S`, `T`. -/
theorem adjoin_R_S_R_T_eq_top :
    Algebra.adjoin ℂ ({Work.Kernels.R_S, Work.Kernels.R_T} : Set Work.Kernels.R) = ⊤ := by
  let A : Subalgebra ℂ R := Algebra.adjoin ℂ ({R_S, R_T} : Set R)
  have hgen : ∀ g : SL(2,ℤ), (MonoidAlgebra.single g (1 : ℂ) : R) ∈ A := by
    intro g
    -- For every `g` in the subgroup generated by `S` and `T` we show simultaneously that
    -- `single g 1` and `single g⁻¹ 1` lie in `A`; the inverse part is what lets the subgroup
    -- induction close.
    have key : ∀ g : SL(2,ℤ),
        g ∈ Subgroup.closure ({ModularGroup.S, ModularGroup.T} : Set (SL(2,ℤ))) →
        ((MonoidAlgebra.single g (1 : ℂ) : R) ∈ A) ∧
          ((MonoidAlgebra.single g⁻¹ (1 : ℂ) : R) ∈ A) := by
      intro g hg
      refine Subgroup.closure_induction (p := fun g _ =>
        ((MonoidAlgebra.single g (1 : ℂ) : R) ∈ A) ∧
          ((MonoidAlgebra.single g⁻¹ (1 : ℂ) : R) ∈ A)) ?mem ?one ?mul ?inv hg
      · -- the two generators
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl
        · -- `x = S`
          refine ⟨?_, ?_⟩
          · exact Algebra.subset_adjoin (by simp)
          · rw [show (ModularGroup.S⁻¹ : SL(2,ℤ)) = ModularGroup.S ^ 3 from by decide]
            have hS3 : (MonoidAlgebra.single (ModularGroup.S ^ 3) (1 : ℂ) : R) =
                (MonoidAlgebra.single ModularGroup.S (1 : ℂ)) ^ 3 := by
              rw [MonoidAlgebra.single_pow]; simp
            rw [hS3]
            exact A.pow_mem (Algebra.subset_adjoin (by simp)) 3
        · -- `x = T`
          refine ⟨?_, ?_⟩
          · exact Algebra.subset_adjoin (by simp)
          · rw [show (ModularGroup.T⁻¹ : SL(2,ℤ)) =
                ModularGroup.S * ModularGroup.T * ModularGroup.S * ModularGroup.T * ModularGroup.S ^ 3
                from by decide]
            rw [show (MonoidAlgebra.single
                  (ModularGroup.S * ModularGroup.T * ModularGroup.S * ModularGroup.T * ModularGroup.S ^ 3)
                  (1 : ℂ) : R)
                = (MonoidAlgebra.of ℂ (SL(2,ℤ)) ModularGroup.S) *
                    (MonoidAlgebra.of ℂ (SL(2,ℤ)) ModularGroup.T) *
                    (MonoidAlgebra.of ℂ (SL(2,ℤ)) ModularGroup.S) *
                    (MonoidAlgebra.of ℂ (SL(2,ℤ)) ModularGroup.T) *
                    (MonoidAlgebra.of ℂ (SL(2,ℤ)) ModularGroup.S) ^ 3 from by
              rw [← MonoidAlgebra.of_apply, map_mul, map_mul, map_mul, map_mul, map_pow]]
            exact A.mul_mem (A.mul_mem (A.mul_mem (A.mul_mem
              (Algebra.subset_adjoin (by simp)) (Algebra.subset_adjoin (by simp)))
              (Algebra.subset_adjoin (by simp))) (Algebra.subset_adjoin (by simp)))
              (A.pow_mem (Algebra.subset_adjoin (by simp)) 3)
      · refine ⟨?_, ?_⟩
        · rw [← MonoidAlgebra.one_def]; exact A.one_mem
        · rw [inv_one, ← MonoidAlgebra.one_def]; exact A.one_mem
      · intro x y hx hy hpx hpy
        refine ⟨?_, ?_⟩
        · have h := A.mul_mem hpx.1 hpy.1
          rw [MonoidAlgebra.single_mul_single, one_mul] at h
          exact h
        · rw [mul_inv_rev]
          have h := A.mul_mem hpy.2 hpx.2
          rw [MonoidAlgebra.single_mul_single, one_mul] at h
          exact h
      · intro x hx hpx
        exact ⟨hpx.2, by simpa using hpx.1⟩
    exact (key g (by rw [Work.Modular.SL2Z_closure_S_T]; exact Subgroup.mem_top g)).1
  refine eq_top_iff.mpr (fun x _ => ?_)
  exact MonoidAlgebra.induction_on x (fun m => by rw [MonoidAlgebra.of_apply]; exact hgen m)
    (fun a b ha hb => A.add_mem ha hb) (fun r a ha => A.smul_mem ha r)

end Work.Residues
