import Mathlib

/-!
# The disk model of `ℝP²` and the linking form of the disk

This file starts the chapter that the chain route to Hugelmeyer's order theory still needs: the
**mod-2 intersection form of `ℝP²` is `(1)`** — the "deep step" of
`Submission/Work/Drive/CHAIN_ROUTE_REDUCTION.md` §3–§4, written there as `(SURF)`.

## The dictionary

`ℝP²` is the quotient of the closed unit disk `D̄ ⊂ ℝ²` by the antipodal identification
`z ~ -z` (`z ∈ ∂D̄`); `ProjDisk` below is that quotient and `projDisk` the quotient map.  Cutting
`ℝP²` open along the projective line `L = ∂D̄/∼` turns it into the disk, and the dictionary for the
chains is:

| in `ℝP²` | in the disk |
| --- | --- |
| a 1-chain transverse to `L` | a finite system of arcs, each running from `z` to `-z` with `z ∈ ∂D̄`, and otherwise strictly inside the disk |
| the pairing `⟨A, L⟩` (number of crossings of `A` with the projective line) | the number `k_A` of arcs of the system |
| the intersection number `#(A ⋔ B)` of two such chains | the number of crossing pairs `(s,t)`, `s ∈ (0,1)`, `t ∈ (0,1)`, with `a s = b t` |

Two facts give `(SURF)`:

* **`chord_crossing_parity`** (file `Submission/Work/Drive/Surf/ChordParity.lean`) — *two* arcs of
  that shape (the chords `z ↦ -z`) cross an odd number of times.  This is the classical fact that two
  chords of a disk whose endpoints interlace meet oddly; the endpoints of `a` (`z_A`, `-z_A`) and of
  `b` (`z_B`, `-z_B`) always interlace, since `-` is a half-turn.  A proof: deform both chords to the
  straight chords `t ↦ (1 - 2t) • z` through the origin.  The number of crossings mod 2 is invariant
  under such a deformation — the zeros of the difference map `(s,t,τ) ↦ a_τ s - b t` on the
  three-box `[0,1]³` form a compact 1-manifold whose boundary lies on the `τ = 0` and `τ = 1` faces
  (the `s`- and `t`-faces are empty by the separation hypothesis), so the two end counts have the
  same parity: this is `Work.Drive.even_ncard_meetD_add_meetN` together with the labelling lemma
  `Work.Drive.even_sum_ncard_labelMeet` of `Submission/Work/Drive/bdry_label_parity.lean`.  The
  straight case has the single crossing at the origin (`straightChord_meet` below).
* **`surf_intersection_form`** (`Submission/Work/Drive/Surf/ChainForm.lean`) — the general form, by
  additivity over the arcs of the two systems: a system with `k_A` arcs against a system with `k_B`
  arcs has `k_A k_B` crossings, i.e.

  `#(A ⋔ B) ≡ ⟨A,L⟩ · ⟨B,L⟩  (mod 2)`,

  which is exactly `(SURF)`: the intersection form of `ℝP²` is the identity, i.e.
  `H₁(ℝP²; ℤ/2) ≅ ℤ/2` generated by the line with `⟨L,L⟩ = 1`.
-/

namespace Work.Drive

open scoped Topology

noncomputable section

/-! ## The plane, its determinant and the disk model

The plane is `EuclideanSpace ℝ (Fin 2)` — the same type as `Tgt 2 = EuclideanSpace ℝ (Fin 2)` of the
intersection chapter (`Submission/Work/Drive/BoxParityDefs.lean`), so that a proof below can use the
`ParityProp` engine of `Submission/Work/Drive/parity_tools_defs.lean` directly. -/

/-- The determinant (two-dimensional cross product) of two plane vectors. -/
def det2 (u v : EuclideanSpace ℝ (Fin 2)) : ℝ := u 0 * v 1 - u 1 * v 0

lemma det2_skew (u v : EuclideanSpace ℝ (Fin 2)) : det2 u v = - det2 v u := by
  simp only [det2]; ring

lemma det2_self (u : EuclideanSpace ℝ (Fin 2)) : det2 u u = 0 := by
  simp only [det2]; ring

lemma smul_apply' (r : ℝ) (u : EuclideanSpace ℝ (Fin 2)) (i : Fin 2) :
    (r • u) i = r * u i := by simp

lemma det2_smul_left (r : ℝ) (u v : EuclideanSpace ℝ (Fin 2)) :
    det2 (r • u) v = r * det2 u v := by
  simp only [det2]
  rw [smul_apply', smul_apply']
  ring

lemma det2_smul_right (r : ℝ) (u v : EuclideanSpace ℝ (Fin 2)) :
    det2 u (r • v) = r * det2 u v := by
  simp only [det2]
  rw [smul_apply', smul_apply']
  ring

/-- The closed unit disk of the plane, the model of the projective plane after the antipodal
identification of its boundary circle. -/
def unitDisk : Set (EuclideanSpace ℝ (Fin 2)) := {x | ‖x‖ ≤ 1}

/-- The bounding circle of the disk model: the projective line of `ℝP²`. -/
def unitCircle : Set (EuclideanSpace ℝ (Fin 2)) := {x | ‖x‖ = 1}

/-- The antipodal map, the involution whose orbits make up the projective plane. -/
def antipode : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := Neg.neg

@[simp] lemma antipode_apply (x : EuclideanSpace ℝ (Fin 2)) : antipode x = -x := rfl

lemma antipode_involutive : Function.Involutive antipode := fun x => by simp [antipode]

lemma antipode_injective : Function.Injective antipode := antipode_involutive.injective

lemma two_smul_eq_zero_iff (x : EuclideanSpace ℝ (Fin 2)) : x + x = 0 ↔ x = 0 := by
  rw [← two_smul ℝ x, smul_eq_zero]
  exact or_iff_right (by norm_num)

lemma antipode_eq_self_iff (x : EuclideanSpace ℝ (Fin 2)) : antipode x = x ↔ x = 0 := by
  simp only [antipode_apply, neg_eq_iff_add_eq_zero, two_smul_eq_zero_iff]

/-- The antipodal map is fixed-point free off the origin. -/
lemma antipode_ne_self {x : EuclideanSpace ℝ (Fin 2)} (hx : x ≠ 0) : antipode x ≠ x := by
  intro h
  exact hx ((antipode_eq_self_iff x).mp h)

@[simp] lemma norm_antipode (x : EuclideanSpace ℝ (Fin 2)) : ‖antipode x‖ = ‖x‖ := by
  simp [antipode]

lemma antipode_mem_circle {x : EuclideanSpace ℝ (Fin 2)} (hx : x ∈ unitCircle) :
    antipode x ∈ unitCircle := by
  simpa only [unitCircle, Set.mem_ofPred_eq, norm_antipode] using hx

lemma antipode_mem_disk {x : EuclideanSpace ℝ (Fin 2)} (hx : x ∈ unitDisk) :
    antipode x ∈ unitDisk := by
  simpa only [unitDisk, Set.mem_ofPred_eq, norm_antipode] using hx

lemma unitDisk_eq_closedBall : unitDisk = Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) 1 := by
  ext x
  simp [unitDisk, Metric.mem_closedBall, dist_eq_norm]

lemma convex_unitDisk : Convex ℝ unitDisk := by
  rw [unitDisk_eq_closedBall]
  exact convex_closedBall 0 1

lemma unitCircle_nonempty : (unitCircle : Set (EuclideanSpace ℝ (Fin 2))).Nonempty :=
  ⟨EuclideanSpace.single 0 1, by simp [unitCircle]⟩

/-- The relation on the disk generating the projective plane: identify antipodal boundary points. -/
def projRel (x y : EuclideanSpace ℝ (Fin 2)) : Prop :=
  x = y ∨ (x ∈ unitCircle ∧ y = antipode x)

lemma projRel_refl (x : EuclideanSpace ℝ (Fin 2)) : projRel x x := Or.inl rfl

lemma projRel_symm {x y : EuclideanSpace ℝ (Fin 2)} (h : projRel x y) : projRel y x := by
  rcases h with h | ⟨hx, rfl⟩
  · exact Or.inl h.symm
  · refine Or.inr ⟨antipode_mem_circle hx, ?_⟩
    simp

lemma projRel_trans {x y z : EuclideanSpace ℝ (Fin 2)} (hxy : projRel x y)
    (hyz : projRel y z) : projRel x z := by
  rcases hxy with hyx | ⟨hx, hy⟩
  · subst hyx; exact hyz
  · subst hy
    rcases hyz with hzy | ⟨-, hz⟩
    · subst hzy; exact Or.inr ⟨hx, rfl⟩
    · refine Or.inl ?_
      rw [hz]
      simp

/-- The setoid of the disk model of the projective plane. -/
def projSetoid : Setoid (EuclideanSpace ℝ (Fin 2)) where
  r := projRel
  iseqv := ⟨projRel_refl, projRel_symm, projRel_trans⟩

/-- **The projective plane**, as the disk with antipodal boundary points identified. -/
def ProjDisk := Quotient projSetoid

/-- The quotient map `D̄ → ℝP²`. -/
def projDisk : EuclideanSpace ℝ (Fin 2) → ProjDisk := Quotient.mk''

lemma projDisk_antipode_of_mem_circle {x : EuclideanSpace ℝ (Fin 2)} (hx : x ∈ unitCircle) :
    projDisk (antipode x) = projDisk x :=
  Quotient.sound (Or.inr ⟨antipode_mem_circle hx, by simp⟩)

/-! ## Chords of the disk and their crossings

A *chord* is the disk-model picture of a 1-chain `A ⊂ ℝP²` crossing the projective line `L`
transversely once: a `C¹` arc from a boundary point `z` to its antipode `-z`, strictly inside the
disk otherwise.  Two chords meet in the disk exactly where the corresponding chains meet in `ℝP²`. -/

/-- **A chord of the disk**: a `C¹` arc from `z = a 0 ∈ ∂D̄` to `-z = a 1`, strictly inside the disk
away from its endpoints. -/
def IsChord (a : ℝ → EuclideanSpace ℝ (Fin 2)) : Prop :=
  ContDiff ℝ 1 a ∧
    (∀ t : ℝ, a (t + 1) = antipode (a t)) ∧
    (∀ t : ℝ, t ∈ Set.Ioo (0 : ℝ) 1 → a t ∈ unitDisk) ∧
    a 0 ∈ unitCircle

lemma IsChord.contDiff {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) : ContDiff ℝ 1 a := h.1

lemma IsChord.continuous {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) : Continuous a :=
  h.contDiff.continuous

lemma IsChord.periodic {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) :
    ∀ t : ℝ, a (t + 1) = antipode (a t) := h.2.1

lemma IsChord.inside {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) :
    ∀ t : ℝ, t ∈ Set.Ioo (0 : ℝ) 1 → a t ∈ unitDisk := h.2.2.1

lemma IsChord.start {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) : a 0 ∈ unitCircle :=
  h.2.2.2

lemma IsChord.end {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) : a 1 ∈ unitCircle := by
  have h1 : a (0 + 1) = antipode (a 0) := h.periodic 0
  rw [zero_add] at h1
  rw [h1]
  exact antipode_mem_circle h.start

lemma IsChord.mem_disk {a : ℝ → EuclideanSpace ℝ (Fin 2)} (h : IsChord a) :
    ∀ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 → a t ∈ unitDisk := by
  intro t ht
  rcases eq_or_lt_of_le ht.1 with rfl | hlt
  · simpa only [unitDisk, Set.mem_ofPred_eq] using (le_of_eq h.start : ‖a 0‖ ≤ 1)
  rcases eq_or_lt_of_le ht.2 with rfl | hlt'
  · simpa only [unitDisk, Set.mem_ofPred_eq] using (le_of_eq h.end : ‖a 1‖ ≤ 1)
  · exact h.inside t ⟨hlt, hlt'⟩

/-- The straight chord through the origin with endpoint `z`: the image of `t ↦ cos (π t) • z` is
the segment from `z` to `-z`.  (The cosine is the anti-periodic parametrisation of that segment:
`cos (π (t + 1)) = -cos (π t)`.) -/
def straightChord (z : EuclideanSpace ℝ (Fin 2)) : ℝ → EuclideanSpace ℝ (Fin 2) :=
  fun t => Real.cos (Real.pi * t) • z

lemma straightChord_zero (z : EuclideanSpace ℝ (Fin 2)) : straightChord z 0 = z := by
  simp [straightChord]

lemma straightChord_one (z : EuclideanSpace ℝ (Fin 2)) : straightChord z 1 = -z := by
  simp only [straightChord, mul_one, Real.cos_pi]
  rw [neg_smul, one_smul]

lemma straightChord_half (z : EuclideanSpace ℝ (Fin 2)) : straightChord z (1 / 2) = 0 := by
  simp only [straightChord, mul_one_div, Real.cos_pi_div_two, zero_smul]

lemma straightChord_periodic (z : EuclideanSpace ℝ (Fin 2)) (t : ℝ) :
    straightChord z (t + 1) = antipode (straightChord z t) := by
  have h : Real.pi * (t + 1) = Real.pi * t + Real.pi := by ring
  rw [straightChord, straightChord, h, Real.cos_add_pi, antipode_apply, neg_smul]

lemma straightChord_norm (z : EuclideanSpace ℝ (Fin 2)) (hz : ‖z‖ = 1) (t : ℝ) :
    ‖straightChord z t‖ = |Real.cos (Real.pi * t)| := by
  rw [straightChord, norm_smul, hz, mul_one, Real.norm_eq_abs]

lemma straightChord_isChord {z : EuclideanSpace ℝ (Fin 2)} (hz : z ∈ unitCircle) :
    IsChord (straightChord z) := by
  have hz1 : ‖z‖ = 1 := hz
  refine ⟨?_, straightChord_periodic z, ?_, by simpa [straightChord_zero] using hz⟩
  · exact (Real.contDiff_cos.comp (contDiff_const.mul contDiff_id)).smul contDiff_const
  · intro t ht
    rw [unitDisk, Set.mem_ofPred_eq, straightChord_norm z hz1 t, abs_le]
    exact ⟨Real.neg_one_le_cos _, Real.cos_le_one _⟩

/-- The solutions of `cos (π x) = 0` in the open unit interval: only `1/2`. -/
lemma cos_pi_mul_eq_zero_of_mem_Ioo {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1)
    (hcos : Real.cos (Real.pi * x) = 0) : x = 1 / 2 := by
  obtain ⟨k, hk⟩ := Real.cos_eq_zero_iff.mp hcos
  have hkx : x = (2 * (k : ℝ) + 1) / 2 := by
    field_simp at hk ⊢
    linarith
  have hk0 : k = 0 := by
    have h1 : (0 : ℝ) < 2 * (k : ℝ) + 1 := by linarith [hkx ▸ hx.1]
    have h2 : 2 * (k : ℝ) + 1 < 2 := by linarith [hkx ▸ hx.2]
    have hk1 : ((-1 : ℤ) : ℝ) < (k : ℝ) := by push_cast; linarith
    have hk2 : (k : ℝ) < ((1 : ℤ) : ℝ) := by push_cast; linarith
    have hk3 : (-1 : ℤ) < k := by exact_mod_cast hk1
    have hk4 : k < 1 := by exact_mod_cast hk2
    omega
  rw [hk0] at hkx
  norm_num at hkx
  exact hkx

/-- The crossings of two chords inside the disk: the pairs `(s,t) ∈ (0,1)²` with `a s = b t`.
This is the mod-2 intersection number of the two 1-chains in `ℝP²` (see the module docstring). -/
def chordMeet (a b : ℝ → EuclideanSpace ℝ (Fin 2)) : Set (ℝ × ℝ) :=
  {p | p.1 ∈ Set.Ioo (0 : ℝ) 1 ∧ p.2 ∈ Set.Ioo (0 : ℝ) 1 ∧ a p.1 = b p.2}

/-- The points of `ℝP²` that came from the boundary circle: the projective line `L`.

**Renamed from `projLine` (2026-09-24, node `Work.Drive.parityCore_of_isSmoothEmbedding`)** so that
this module can be imported together with `Submission.Work.Drive.ProjectiveDefs`, which declares its
own `Work.Drive.projLine` (the linear model, `Set (Projectivization ℝ V)`); two declarations of the
same name make the two import closures incompatible, and the transport of `(SURF)` to the capped
planes needs both.  Nothing referred to the old name.  See
`Submission/Work/Drive/IMPORT_CLASH_STATUS.md`. -/
def projLineDisk : Set ProjDisk := Set.range (fun x : {x : EuclideanSpace ℝ (Fin 2) // x ∈ unitCircle} =>
  projDisk x.1)

/-- The projection to `ℝP²` identifies exactly the equal points and the antipodal pairs of the
boundary circle. -/
lemma projDisk_eq_iff (x y : EuclideanSpace ℝ (Fin 2)) :
    projDisk x = projDisk y ↔ x = y ∨ (x ∈ unitCircle ∧ y = antipode x) :=
  ⟨fun h => Quotient.exact h, fun h => Quotient.sound h⟩

lemma projDisk_eq_self_of_not_mem_circle {x y : EuclideanSpace ℝ (Fin 2)}
    (hx : x ∉ unitCircle) (h : projDisk x = projDisk y) : x = y := by
  rcases (projDisk_eq_iff x y).mp h with h' | ⟨hx', -⟩
  · exact h'
  · exact absurd hx' hx

/-- The points of the projective line `L` met by a finite system of chords: the projections of the
endpoints.  In the language of the chapter this set is the intersection of the 1-chain with the
projective line, so its cardinality is the pairing `⟨A, L⟩` of the chain with the line. -/
def chainMeetsLine {ι : Type*} (A : ι → ℝ → EuclideanSpace ℝ (Fin 2)) : Set ProjDisk :=
  Set.range fun i => projDisk (A i 0)

/-- **The pairing with the projective line is the number of arcs.**  For a finite system of chords
whose endpoints are distinct and pairwise non-antipodal, the chain meets the projective line in
exactly one point per chord. -/
lemma ncard_chainMeetsLine {ι : Type*} [Fintype ι]
    (A : ι → ℝ → EuclideanSpace ℝ (Fin 2))
    (h : ∀ i k : ι, A i 0 = A k 0 ∨ A i 0 = antipode (A k 0) → i = k) :
    (chainMeetsLine A).ncard = Fintype.card ι := by
  have hinj : Function.Injective fun i => projDisk (A i 0) := by
    intro i k hik
    rcases (projDisk_eq_iff (A i 0) (A k 0)).mp hik with h' | ⟨-, h'⟩
    · exact h i k (Or.inl h')
    · exact (h k i (Or.inr h')).symm
  rw [chainMeetsLine, Set.ncard_range_of_injective hinj]
  simp

/-- The crossings of two finite systems of chords: the tuples `((i,s),(j,t))` with `s, t ∈ (0,1)` and
`A i s = B j t`.  This is the mod-2 intersection number of the two 1-chains of `ℝP²` when the
systems are finite families of chords in general position. -/
def chordMeetAll {ι κ : Type*} (A : ι → ℝ → EuclideanSpace ℝ (Fin 2))
    (B : κ → ℝ → EuclideanSpace ℝ (Fin 2)) : Set ((ι × ℝ) × (κ × ℝ)) :=
  {p | p.1.2 ∈ Set.Ioo (0 : ℝ) 1 ∧ p.2.2 ∈ Set.Ioo (0 : ℝ) 1 ∧ A p.1.1 p.1.2 = B p.2.1 p.2.2}

/-- The block of `chordMeetAll A B` belonging to the pair `(i,j)` of chords; it is a copy of
`chordMeet (A i) (B j)`. -/
def chordMeetBlock {ι κ : Type*} (A : ι → ℝ → EuclideanSpace ℝ (Fin 2))
    (B : κ → ℝ → EuclideanSpace ℝ (Fin 2)) (i : ι) (j : κ) : Set ((ι × ℝ) × (κ × ℝ)) :=
  {p | p.1.1 = i ∧ p.2.1 = j ∧
    p.1.2 ∈ Set.Ioo (0 : ℝ) 1 ∧ p.2.2 ∈ Set.Ioo (0 : ℝ) 1 ∧ A i p.1.2 = B j p.2.2}

lemma chordMeetBlock_subset {ι κ : Type*} (A : ι → ℝ → EuclideanSpace ℝ (Fin 2))
    (B : κ → ℝ → EuclideanSpace ℝ (Fin 2)) (i : ι) (j : κ) :
    chordMeetBlock A B i j ⊆ chordMeetAll A B := by
  rintro ⟨⟨i', s⟩, ⟨j', t⟩⟩ ⟨rfl, rfl, hs, ht, heq⟩
  exact ⟨hs, ht, heq⟩

/-- The blocks are pairwise disjoint: a point of `chordMeetAll` determines its pair of chords. -/
lemma chordMeetBlock_disjoint {ι κ : Type*} (A : ι → ℝ → EuclideanSpace ℝ (Fin 2))
    (B : κ → ℝ → EuclideanSpace ℝ (Fin 2)) {i i' : ι} {j j' : κ}
    (h : (i, j) ≠ (i', j')) : Disjoint (chordMeetBlock A B i j) (chordMeetBlock A B i' j') := by
  rw [Set.disjoint_left]
  rintro ⟨⟨i'', s⟩, ⟨j'', t⟩⟩ ⟨h1, h2, -⟩ ⟨h1', h2', -⟩
  exact h (by simp only [Prod.mk.injEq]; exact ⟨h1.symm.trans h1', h2.symm.trans h2'⟩)

lemma chordMeetAll_subset_iUnion {ι κ : Type*} (A : ι → ℝ → EuclideanSpace ℝ (Fin 2))
    (B : κ → ℝ → EuclideanSpace ℝ (Fin 2)) :
    chordMeetAll A B ⊆ ⋃ (i : ι) (j : κ), chordMeetBlock A B i j := by
  rintro ⟨⟨i, s⟩, ⟨j, t⟩⟩ ⟨hs, ht, heq⟩
  exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨j, rfl, rfl, hs, ht, heq⟩⟩

/-- Two straight chords through the origin with non-parallel endpoints meet exactly once, at the
origin.  This is the base case of `chord_crossing_parity`. -/
lemma straightChord_meet {z w : EuclideanSpace ℝ (Fin 2)} (hzw : det2 z w ≠ 0) :
    chordMeet (straightChord z) (straightChord w) = {(1 / 2, 1 / 2)} := by
  ext p
  constructor
  · rintro ⟨h1, h2, heq⟩
    rw [Set.mem_singleton_iff, Prod.mk.injEq]
    simp only [straightChord] at heq
    have hs : Real.cos (Real.pi * p.1) = 0 := by
      have h := congrArg (fun v => det2 v w) heq
      simp only [det2_smul_left, det2_self, mul_zero] at h
      exact (mul_eq_zero.mp h).resolve_right hzw
    have ht : Real.cos (Real.pi * p.2) = 0 := by
      have h := congrArg (fun v => det2 z v) heq
      simp only [det2_smul_right, det2_self, mul_zero] at h
      exact (mul_eq_zero.mp h.symm).resolve_right hzw
    exact ⟨cos_pi_mul_eq_zero_of_mem_Ioo h1 hs, cos_pi_mul_eq_zero_of_mem_Ioo h2 ht⟩
  · intro hp
    rw [Set.mem_singleton_iff] at hp
    subst hp
    refine ⟨by norm_num, by norm_num, ?_⟩
    rw [straightChord_half, straightChord_half]

end

end Work.Drive
