/-
Bridge between the curvature set of the packing generated by the family
quadruple famQuad t (a TransformationGroup orbit, which also allows coordinate
permutations) and the values of the Apollonian-group orbit `orbitOf (famQuad t)`.

Main result: `curvatureSet (famPacking t) = famOrbitValues t`, so square
exclusion over the S-orbit (`FamAssembly.no_square_fam_orbit`) transfers to
`curvatureSet (famPacking t)`.

(Family analogue of TGBridge.lean.)
-/
import Submission.Apollo.FamAssembly
import Submission.Apollo.Defs
import Submission.Apollo.Relabel
import Submission.Apollo.TGBridge
import Mathlib.Tactic
import Mathlib.Data.Int.Basic
import Mathlib.Data.Int.ModEq
import Mathlib.Data.Nat.Basic
import Mathlib.Data.Nat.Prime.Defs
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Permutation
import Mathlib.Data.Fin.VecNotation
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.NumberTheory.LegendreSymbol.JacobiSymbol
import Mathlib.Logic.Equiv.Defs
import Mathlib.Logic.Equiv.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Set.Function
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fin.Basic
set_option autoImplicit false
open LocalGlobalApollonianCirclePackings
open Matrix
open scoped Pointwise
namespace Apollo

/-- every TransformationGroup image of famQuad t is a permutation of an
Apollonian image: g • famQuad t = (a • famQuad t) ∘ σ. -/
theorem fam_tg_reduce (t : ℕ) (g : GL (Fin 4) ℤ) (hg : g ∈ TransformationGroup) :
    ∃ a : GL (Fin 4) ℤ, a ∈ ApollonianGroup ∧
      ∃ σ : Equiv.Perm (Fin 4), g • famQuad t = (a • famQuad t) ∘ σ := by
  rw [tg_eq_closure] at hg
  refine (Subgroup.closure_induction_left
    (s := (↑ApollonianGroup ∪ ↑Hsub : Set (GL (Fin 4) ℤ)))
    (p := fun h _ => ∃ a : GL (Fin 4) ℤ, a ∈ ApollonianGroup ∧
      ∃ σ : Equiv.Perm (Fin 4), h • famQuad t = (a • famQuad t) ∘ σ) ?base ?mul ?inv (x := g) hg)
  · refine ⟨1, one_mem ApollonianGroup, 1, ?_⟩
    simp
  · intro x hx y hy ih
    rcases hx with hxA | hxH
    · rcases ih with ⟨a, ha, σ, hEq⟩
      have hperm := apollonian_perm x hxA σ (a • famQuad t)
      rcases hperm with ⟨b, hb, hbEq⟩
      refine ⟨b * a, Subgroup.mul_mem ApollonianGroup hb ha, σ, ?_⟩
      calc
        (x * y) • famQuad t = x • (y • famQuad t) := by rw [mul_smul]
        _ = x • ((a • famQuad t) ∘ σ) := by rw [hEq]
        _ = (b • (a • famQuad t)) ∘ σ := hbEq
        _ = ((b * a) • famQuad t) ∘ σ := by rw [mul_smul]
    · rcases (Hsub_mem_iff x).1 hxH with ⟨τ, rfl⟩
      rcases ih with ⟨a, ha, σ, hEq⟩
      refine ⟨a, ha, (τ.symm).trans σ, ?_⟩
      calc
        ((permMatrixHom.toHomUnits τ : GL (Fin 4) ℤ) * y) • famQuad t
            = (permMatrixHom.toHomUnits τ : GL (Fin 4) ℤ) • (y • famQuad t) := by rw [mul_smul]
        _ = (permMatrixHom.toHomUnits τ : GL (Fin 4) ℤ) • ((a • famQuad t) ∘ σ) := by rw [hEq]
        _ = ((a • famQuad t) ∘ σ) ∘ τ.symm := perm_smul_comp τ ((a • famQuad t) ∘ σ)
        _ = (a • famQuad t) ∘ ((τ.symm).trans σ) := by rfl
  · intro x hx y hy ih
    rcases hx with hxA | hxH
    · have hxAi : x⁻¹ ∈ ApollonianGroup := inv_mem hxA
      rcases ih with ⟨a, ha, σ, hEq⟩
      rcases apollonian_perm x⁻¹ hxAi σ (a • famQuad t) with ⟨b, hb, hbEq⟩
      refine ⟨b * a, Subgroup.mul_mem ApollonianGroup hb ha, σ, ?_⟩
      calc
        (x⁻¹ * y) • famQuad t = x⁻¹ • (y • famQuad t) := by rw [mul_smul]
        _ = x⁻¹ • ((a • famQuad t) ∘ σ) := by rw [hEq]
        _ = (b • (a • famQuad t)) ∘ σ := hbEq
        _ = ((b * a) • famQuad t) ∘ σ := by rw [mul_smul]
    · rcases (Hsub_mem_iff x).1 hxH with ⟨τ, hxτ⟩
      rcases ih with ⟨a, ha, σ, hEq⟩
      refine ⟨a, ha, τ.trans σ, ?_⟩
      calc
        (x⁻¹ * y) • famQuad t = x⁻¹ • (y • famQuad t) := by rw [mul_smul]
        _ = x⁻¹ • ((a • famQuad t) ∘ σ) := by rw [hEq]
        _ = ((a • famQuad t) ∘ σ) ∘ τ := by
          rw [hxτ]
          rw [perm_inv]
          rw [perm_smul_comp]
          rfl
        _ = (a • famQuad t) ∘ (τ.trans σ) := by rfl

/-- the set of values of the S-orbit of the family quadruple. -/
def famOrbitValues (t : ℕ) : Set ℤ := {x | ∃ v ∈ orbitOf (famQuad t), x ∈ Set.range v}

/-- every value of a TransformationGroup image of famQuad t is a family-orbit
value. -/
theorem fam_tg_value_mem (t : ℕ) (g : GL (Fin 4) ℤ) (hg : g ∈ TransformationGroup)
    (x : ℤ) : x ∈ Set.range (g • famQuad t) → x ∈ famOrbitValues t := by
  intro hx
  rcases fam_tg_reduce t g hg with ⟨a, ha, σ, hEq⟩
  rcases hx with ⟨i, hi⟩
  refine ⟨a • famQuad t, ?_, σ i, ?_⟩
  · rw [orbitOf]
    exact ⟨a, ha, rfl⟩
  · rw [← hi]
    change ((a • famQuad t) ∘ σ) i = (g • famQuad t) i
    exact congrArg (fun w : Fin 4 → ℤ => w i) hEq.symm

/-- The curvature set of the packing of famQuad t is exactly the set of all
family-orbit values. -/
theorem fam_curvatureSet_eq (t : ℕ) : curvatureSet (famPacking t) = famOrbitValues t := by
  ext x
  constructor
  · intro hx
    rw [curvatureSet] at hx
    rw [Set.mem_iUnion₂] at hx
    rcases hx with ⟨v, hv, hxr⟩
    rcases (Set.mem_range.mp hxr) with ⟨i, hxi⟩
    have hmk : Quotient.mk'' v = famPacking t := (MulAction.orbitRel.Quotient.mem_orbit).1 hv
    have hrel : (MulAction.orbitRel TransformationGroup integralPrimitiveDescartesQuadruple).r v
        ⟨famQuad t, famQuad_mem t⟩ := by
      exact Quotient.exact (by simpa [famPacking] using hmk)
    have hmem : v ∈ MulAction.orbit TransformationGroup ⟨famQuad t, famQuad_mem t⟩ :=
      (MulAction.orbitRel_apply.mp hrel)
    rcases hmem with ⟨g, hg_eq⟩
    have hvec : v.1 = (g : GL (Fin 4) ℤ) • famQuad t := by
      rw [← hg_eq]
      rfl
    have hx2 : x ∈ Set.range ((g : GL (Fin 4) ℤ) • famQuad t) := by
      rw [← hvec]
      exact ⟨i, hxi⟩
    exact fam_tg_value_mem t (g : GL (Fin 4) ℤ) g.2 x hx2
  · intro hx
    rcases hx with ⟨w, hw, i, rfl⟩
    rcases hw with ⟨a, ha, hwEq⟩
    have haTG : a ∈ TransformationGroup := ap_le_tg ha
    let g : TransformationGroup := ⟨a, haTG⟩
    let v : integralPrimitiveDescartesQuadruple := g • ⟨famQuad t, famQuad_mem t⟩
    rw [curvatureSet]
    rw [Set.mem_iUnion₂]
    refine ⟨v, ?_, ?_⟩
    · dsimp [famPacking]
      rw [MulAction.mem_orbit_iff]
      refine ⟨g, ?_⟩
      rfl
    · refine ⟨i, ?_⟩
      have hsub : v.1 = a • famQuad t := by
        dsimp [v, g]
        rfl
      rw [hsub, hwEq]

/-- no square curvature occurs in the packing generated by the family
quadruple. -/
theorem fam_no_square_curvature (t : ℕ) : ∀ n : ℤ, n ^ 2 ∉ curvatureSet (famPacking t) := by
  intro n hn
  rw [fam_curvatureSet_eq t] at hn
  exact no_square_fam_orbit t n hn

end Apollo
