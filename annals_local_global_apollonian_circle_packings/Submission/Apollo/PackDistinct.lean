/-
P1 distinctness framework: the packing generated by the family quadruple.
  * orbitOf / of_orbitOf_apply: move-closure induction for an arbitrary base;
  * famPacking t: the packing (TransformationGroup orbit) of famQuad t;
  * famPacking_has_a: famA t is a curvature of the packing (the base quadruple
    is in its own orbit);
  * fam_orbit_admissible: every orbit value is ≡ one of {0,5,8,12,20,21} mod 24
    and satisfies the parity/residue invariant Qpred (closed under S-moves).
Still open (next): the analytic bound fam_coord_bound (3·(v i) ≤ 2S − famA t for
orbit quadruples), which closes the invariant "all packing values ≥ famA t" and
then yields injectivity of t ↦ famPacking t (see Work/PackDistinct_dev.lean).
-/
import Submission.Apollo.PackFamily
import Submission.Apollo.Mod24
import Submission.Apollo.Structure
import Submission.Apollo.TGBridge
import ChallengeDeps
import Mathlib.Tactic
import Mathlib.Algebra.GCDMonoid.Finset
set_option autoImplicit false
open scoped Pointwise
open LocalGlobalApollonianCirclePackings
namespace Apollo

/-- S-orbit of an arbitrary base quadruple. -/
def orbitOf (w0 : Fin 4 → ℤ) : Set (Fin 4 → ℤ) := {v | ∃ g ∈ ApollonianGroup, v = g • w0}

/-- move-closure induction for an arbitrary base. -/
theorem of_orbitOf_apply {w0 : Fin 4 → ℤ} {P : (Fin 4 → ℤ) → Prop} (hP : P w0)
    (hS : ∀ i : Fin 4, ∀ w : Fin 4 → ℤ, P w → P (gen i • w)) :
    ∀ v ∈ orbitOf w0, P v := by
  intro v hv
  rcases hv with ⟨g, hg, rfl⟩
  rw [apollonianGroup_eq_closure] at hg
  refine
    (Subgroup.closure_induction_left (s := gens)
      (p := fun g _ => ∀ w : Fin 4 → ℤ, P w → P (g • w))
      ?one ?mulL ?invC (x := g) hg) w0 hP
  · intro w hw
    simpa using hw
  · intro x hx y hy ih w hw
    rcases hx with ⟨i, rfl⟩
    have hyw : P (y • w) := ih w hw
    simpa [mul_smul] using hS i (y • w) hyw
  · intro x hx y hy ih w hw
    rcases hx with ⟨i, rfl⟩
    have hyw : P (y • w) := ih w hw
    simpa [gen_inv i, mul_smul] using hS i (y • w) hyw

/-- the base quadruple is in its own S-orbit. -/
lemma orbitOf_self (w0 : Fin 4 → ℤ) : w0 ∈ orbitOf w0 := by
  refine ⟨1, ?_, by simp⟩
  rw [apollonianGroup_eq_closure]
  exact Subgroup.one_mem _

/-- the packing generated by the family quadruple. -/
def famPacking (t : ℕ) : PrimitiveApollonianCirclePacking :=
  Quotient.mk'' ⟨famQuad t, famQuad_mem t⟩

/-- the base negative value famA t is a curvature of the packing. -/
lemma famPacking_has_a (t : ℕ) : famA t ∈ curvatureSet (famPacking t) := by
  rw [curvatureSet]
  rw [Set.mem_iUnion₂]
  refine ⟨(⟨famQuad t, famQuad_mem t⟩ : integralPrimitiveDescartesQuadruple), ?_, ?_⟩
  · exact (MulAction.orbitRel.Quotient.mem_orbit).2 (by rfl)
  · refine ⟨(0 : Fin 4), ?_⟩
    simp [famQuad]


/-- integer emod equality transfers to ZMod. -/
lemma zmod24_of_emod (x r : ℤ) (h : x % 24 = r) : (x : ZMod 24) = (r : ZMod 24) := by
  have h1 : x = 24 * (x / 24) + r := by omega
  have hx : x - r = 24 * (x / 24) := by omega
  have hd : (24 : ℤ) ∣ x - r := ⟨x / 24, hx⟩
  have hz : ((x - r : ℤ) : ZMod 24) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (x - r) 24).2 hd
  rw [Int.cast_sub] at hz
  exact sub_eq_zero.mp hz

private lemma famA_A24 (t : ℕ) : A24 ((famA t : ZMod 24)) := by
  unfold A24
  rw [zmod24_of_emod (famA t) 5 (famA_mod24 t)]
  norm_num
private lemma famB_A24 (t : ℕ) : A24 ((famB t : ZMod 24)) := by
  unfold A24
  rw [zmod24_of_emod (famB t) 21 (famB_mod24 t)]
  norm_num
private lemma famC_A24 (t : ℕ) : A24 ((famC t : ZMod 24)) := by
  unfold A24
  rw [zmod24_of_emod (famC t) 8 (famC_mod24 t)]
  norm_num
private lemma famD_A24 (t : ℕ) : A24 ((famD t : ZMod 24)) := by
  unfold A24
  rw [zmod24_of_emod (famD t) 12 (famD_mod24 t)]
  norm_num


/-- which family coordinates are odd (residue-wise). -/
private lemma fam_oddRes_iff (t : ℕ) (i : Fin 4) :
    oddRes ((famQuad t i : ZMod 24)) ↔ i = 0 ∨ i = 1 := by
  fin_cases i
  · constructor
    · intro _; left; rfl
    · intro _
      change oddRes ((famQuad t (0 : Fin 4) : ZMod 24))
      change oddRes ((famA t : ZMod 24))
      have hA : (famA t : ZMod 24) = 5 := zmod24_of_emod (famA t) 5 (famA_mod24 t)
      rw [hA]
      decide
  · constructor
    · intro _; right; rfl
    · intro _
      change oddRes ((famB t : ZMod 24))
      have hB : (famB t : ZMod 24) = 21 := zmod24_of_emod (famB t) 21 (famB_mod24 t)
      rw [hB]
      decide
  · constructor
    · intro h
      exfalso
      change oddRes ((famQuad t (2 : Fin 4) : ZMod 24)) at h
      change oddRes ((famC t : ZMod 24)) at h
      have hC : (famC t : ZMod 24) = 8 := zmod24_of_emod (famC t) 8 (famC_mod24 t)
      rw [hC] at h
      exact (by decide : ¬ oddRes (8 : ZMod 24)) h
    · intro h
      rcases h with h | h
      · exfalso; exact (by decide : ¬ (2 : Fin 4) = 0) h
      · exfalso; exact (by decide : ¬ (2 : Fin 4) = 1) h
  · constructor
    · intro h
      exfalso
      change oddRes ((famQuad t (3 : Fin 4) : ZMod 24)) at h
      change oddRes ((famD t : ZMod 24)) at h
      have hD : (famD t : ZMod 24) = 12 := zmod24_of_emod (famD t) 12 (famD_mod24 t)
      rw [hD] at h
      exact (by decide : ¬ oddRes (12 : ZMod 24)) h
    · intro h
      rcases h with h | h
      · exfalso; exact (by decide : ¬ (3 : Fin 4) = 0) h
      · exfalso; exact (by decide : ¬ (3 : Fin 4) = 1) h


/-- the base quadruple satisfies the mod-24 invariant Qpred. -/
lemma fam_Qpred_base (t : ℕ) : Qpred (toZ24 (famQuad t)) := by
  constructor
  · intro i
    fin_cases i <;> simp [famQuad]
    · exact famA_A24 t
    · exact famB_A24 t
    · exact famC_A24 t
    · exact famD_A24 t
  · constructor
    · change ((∑ i : Fin 4, (famQuad t i : ZMod 24)) ^ 2 =
        2 * ∑ i : Fin 4, (famQuad t i : ZMod 24) ^ 2)
      have h := congrArg (fun y : ℤ => (y : ZMod 24)) (fam_descartes t)
      simpa using h
    · have hA : (famA t : ZMod 24) = 5 := zmod24_of_emod (famA t) 5 (famA_mod24 t)
      have hB : (famB t : ZMod 24) = 21 := zmod24_of_emod (famB t) 21 (famB_mod24 t)
      have hC : (famC t : ZMod 24) = 8 := zmod24_of_emod (famC t) 8 (famC_mod24 t)
      have hD : (famD t : ZMod 24) = 12 := zmod24_of_emod (famD t) 12 (famD_mod24 t)
      change (Finset.univ.filter (fun i : Fin 4 => oddRes ((famQuad t i : ZMod 24)))).card = 2
      have hset : (Finset.univ.filter (fun i : Fin 4 => oddRes ((famQuad t i : ZMod 24)))) =
          ({0, 1} : Finset (Fin 4)) := by
        apply Finset.ext
        intro i
        rw [Finset.mem_filter]
        rw [fam_oddRes_iff t i]
        simp
      rw [hset]
      norm_num


/-- every quadruple in the family orbit satisfies the mod-24 invariant Qpred. -/
theorem fam_orbit_Qpred (t : ℕ) (v : Fin 4 → ℤ) (hv : v ∈ orbitOf (famQuad t)) :
    Qpred (toZ24 v) := by
  refine of_orbitOf_apply (w0 := famQuad t) (P := fun w => Qpred (toZ24 w)) ?hP ?hS v hv
  · exact fam_Qpred_base t
  · intro i w hw
    rw [toZ24_gen]
    exact Qpred_S i (toZ24 w) hw

end Apollo
