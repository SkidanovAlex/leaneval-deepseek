import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Permutation
import Mathlib.Data.Fin.VecNotation
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.NumberTheory.LegendreSymbol.JacobiSymbol
import Mathlib.Logic.Equiv.Defs
import Mathlib.Logic.Equiv.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Set.Function
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fin.Basic
set_option autoImplicit false
open scoped Pointwise
open LocalGlobalApollonianCirclePackings

namespace Apollo

/-- An occurrence of a circle: a Descartes quadruple and a coordinate. -/
abbrev Occ : Type := (Fin 4 → ℤ) × Fin 4

/-- An occurrence is valid when its quadruple lies in the Apollonian orbit. -/
def valid (o : Occ) : Prop := o.1 ∈ apOrbit

/-- the curvature of the circle at an occurrence. -/
def ovalue (o : Occ) : ℤ := o.1 o.2

/-- Two occurrences are tangent when they co-occur in the same Descartes
quadruple at two different coordinates. -/
def tangent (o₁ o₂ : Occ) : Prop := o₁.1 = o₂.1 ∧ o₁.2 ≠ o₂.2

/-- Generating step for "same circle": an S-move that does not touch the
circle's coordinate leaves the circle at that coordinate unchanged. -/
def replaceStep (o₁ o₂ : Occ) : Prop :=
  ∃ w : Fin 4 → ℤ, ∃ i j : Fin 4, i ≠ j ∧ o₁ = (w, j) ∧ o₂ = (gen i • w, j)

/-- Two occurrences carry the same circle iff they are related by the
equivalence relation generated by `replaceStep`. -/
def sameCircle (o₁ o₂ : Occ) : Prop := Relation.EqvGen replaceStep o₁ o₂

/-- The connection relation: tangent steps or same-circle identifications. -/
def connStep (o₁ o₂ : Occ) : Prop := tangent o₁ o₂ ∨ sameCircle o₁ o₂

/-- Connectivity in the circle graph (on occurrences). -/
def conn (o₁ o₂ : Occ) : Prop := Relation.ReflTransGen connStep o₁ o₂

/-- values of co-occurring circles are coprime. -/
def coprimeValues (o₁ o₂ : Occ) : Prop := (ovalue o₁).gcd (ovalue o₂) = 1

/-- a coprime tangent step, or a same-circle identification. -/
def copathStep (o₁ o₂ : Occ) : Prop :=
  (tangent o₁ o₂ ∧ coprimeValues o₁ o₂) ∨ sameCircle o₁ o₂

/-- coprime path: same-circle identifications interleaved with coprime
tangency steps. -/
def copath (o₁ o₂ : Occ) : Prop := Relation.ReflTransGen copathStep o₁ o₂

/-- the root quadruple is valid at every coordinate. -/
lemma valid_q0v (i : Fin 4) : valid (q0v, i) := by
  dsimp [valid]
  exact q0v_mem_apOrbit

/-- validity is preserved by the S-moves. -/
lemma valid_move (w : Fin 4 → ℤ) (hw : w ∈ apOrbit) (i : Fin 4) :
    valid (gen i • w, i) := by
  dsimp [valid]
  exact gen_smul_mem_apOrbit w hw i

/-- An S-move at coordinate i leaves the value at every other coordinate
unchanged; hence `replaceStep` preserves the value of an occurrence. -/
lemma replaceStep_value {o₁ o₂ : Occ} (h : replaceStep o₁ o₂) : ovalue o₁ = ovalue o₂ := by
  rcases h with ⟨w, i, j, hne, rfl, rfl⟩
  dsimp [ovalue]
  exact (other_coord_eq w i j hne.symm).symm

/-- a function respecting the generating step respects the generated
equivalence relation. -/
lemma eqvGen_preserves {α : Type} {f : Occ → α}
    (hstep : ∀ o₁ o₂ : Occ, replaceStep o₁ o₂ → f o₁ = f o₂)
    {o₁ o₂ : Occ} (h : sameCircle o₁ o₂) : f o₁ = f o₂ := by
  induction h with
  | rel a b hrel => exact hstep a b hrel
  | refl a => rfl
  | symm a b h ih => exact ih.symm
  | trans a b c h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The curvature of a circle is well-defined: same-circle occurrences have
the same value. -/
theorem sameCircle_value {o₁ o₂ : Occ} (h : sameCircle o₁ o₂) : ovalue o₁ = ovalue o₂ :=
  eqvGen_preserves (fun o₁ o₂ h => replaceStep_value h) h

/-- tangency within a quadruple. -/
lemma tangent_self {w : Fin 4 → ℤ} {i j : Fin 4} (hne : i ≠ j) : tangent (w, i) (w, j) := by
  dsimp [tangent]
  exact ⟨rfl, hne⟩

/-- a circle at coordinate j of w is the same circle at coordinate j of a
quadruple obtained by moving a different coordinate. -/
lemma sameCircle_move {w : Fin 4 → ℤ} (i j : Fin 4) (hne : i ≠ j) :
    sameCircle (w, j) (gen i • w, j) := by
  exact Relation.EqvGen.rel (w, j) (gen i • w, j) ⟨w, i, j, hne, rfl, rfl⟩

/-- the reverse direction of `sameCircle_move`. -/
lemma sameCircle_move' {w : Fin 4 → ℤ} (i j : Fin 4) (hne : i ≠ j) :
    sameCircle (gen i • w, j) (w, j) := by
  exact Relation.EqvGen.symm (w, j) (gen i • w, j) (sameCircle_move i j hne)

/-- occurrences of the same Descartes quadruple are connected. -/
lemma tangent_conn {o₁ o₂ : Occ} (h : tangent o₁ o₂) : conn o₁ o₂ :=
  Relation.ReflTransGen.tail Relation.ReflTransGen.refl (Or.inl h)

/-- same-circle occurrences are connected. -/
lemma sameCircle_conn {o₁ o₂ : Occ} (h : sameCircle o₁ o₂) : conn o₁ o₂ :=
  Relation.ReflTransGen.tail Relation.ReflTransGen.refl (Or.inr h)

/-- tangency is symmetric. -/
lemma tangent_symm {o₁ o₂ : Occ} (h : tangent o₁ o₂) : tangent o₂ o₁ :=
  ⟨h.1.symm, h.2.symm⟩

/-- the connection step is symmetric. -/
lemma connStep_symm {o₁ o₂ : Occ} (h : connStep o₁ o₂) : connStep o₂ o₁ := by
  rcases h with h | h
  · exact Or.inl (tangent_symm h)
  · exact Or.inr (Relation.EqvGen.symm o₁ o₂ h)

/-- connectivity is symmetric. -/
theorem conn_symm {o₁ o₂ : Occ} (h : conn o₁ o₂) : conn o₂ o₁ := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hprev hstep ih =>
      exact Relation.ReflTransGen.trans
        (Relation.ReflTransGen.tail Relation.ReflTransGen.refl (connStep_symm hstep)) ih

/-- the new circle created by an S-move is tangent to the surviving circles,
which are the same circles as in the old quadruple; so the occurrence graph
steps from the new circle back to an old occurrence. -/
lemma new_circle_reaches_old (w : Fin 4 → ℤ) (i j : Fin 4) (hji : j ≠ i) :
    conn (gen i • w, i) (w, j) := by
  -- (gen i • w, i) tangent (gen i • w, j) [needs i ≠ j]
  -- then sameCircle (gen i • w, j) (w, j)
  apply Relation.ReflTransGen.trans (b := (gen i • w, j))
  · exact tangent_conn (tangent_self (i := i) (j := j) hji.symm)
  · exact sameCircle_conn (sameCircle_move' i j hji.symm)

/-- The circle graph is connected: every valid occurrence is connected to the
occurrence (q0v, 0) of the root quadruple. -/
theorem occ_conn_base (o : Occ) (ho : valid o) : conn o (q0v, 0) := by
  -- prove by induction over the move word generating o.1
  let P : (Fin 4 → ℤ) → Prop := fun w => ∀ i : Fin 4, conn (w, i) (q0v, 0)
  have hP : P q0v := by
    intro i
    by_cases hi : i = 0
    · subst i
      exact Relation.ReflTransGen.refl
    · exact tangent_conn (tangent_self (w := q0v) (i := i) (j := 0) hi)
  have hS : ∀ i : Fin 4, ∀ w : Fin 4 → ℤ, P w → P (gen i • w) := by
    intro i w hw k
    by_cases hki : k = i
    · -- the new circle at coordinate i: step to an old circle and use hw
      subst k
      rcases (exists_ne i : ∃ j : Fin 4, j ≠ i) with ⟨j, hji⟩
      apply Relation.ReflTransGen.trans (b := (w, j))
      · exact new_circle_reaches_old w i j hji
      · exact hw j
    · -- a surviving circle: identify with the old occurrence and use hw
      have hik : i ≠ k := by
        intro hik
        exact hki hik.symm
      apply Relation.ReflTransGen.trans (b := (w, k))
      · exact sameCircle_conn (sameCircle_move' i k hik)
      · exact hw k
  have hall := of_closure_apply (P := P) hP hS o.1 ho
  exact hall o.2

/-- any two valid occurrences are connected. -/
theorem occ_conn_valid (o₁ o₂ : Occ) (h₁ : valid o₁) (h₂ : valid o₂) : conn o₁ o₂ := by
  apply Relation.ReflTransGen.trans (b := (q0v, 0))
  · exact occ_conn_base o₁ h₁
  · exact conn_symm (occ_conn_base o₂ h₂)


/-- walking a crack family at indices σ 2 and σ 3 never moves the circle at an
index j that is neither σ 2 nor σ 3: the occurrence (v, j) persists to
(relabelCrack σ v n, j). -/
theorem sameCircle_relabelCrack (σ : Equiv.Perm (Fin 4)) (v : Fin 4 → ℤ) (n : ℕ)
    (j : Fin 4) (hj2 : j ≠ σ 2) (hj3 : j ≠ σ 3) :
    sameCircle (v, j) (relabelCrack σ v n, j) := by
  induction n with
  | zero =>
      change sameCircle (v, j) (v, j)
      exact Relation.EqvGen.refl (v, j)
  | succ n ih =>
      rw [relabelCrack]
      have h2 : sameCircle (relabelCrack σ v n, j) (gen (σ 2) • relabelCrack σ v n, j) :=
        Relation.EqvGen.rel _ _ ⟨relabelCrack σ v n, σ 2, j, hj2.symm, rfl, rfl⟩
      have h3 : sameCircle (gen (σ 2) • relabelCrack σ v n, j)
          (gen (σ 3) • (gen (σ 2) • relabelCrack σ v n), j) :=
        Relation.EqvGen.rel _ _ ⟨gen (σ 2) • relabelCrack σ v n, σ 3, j, hj3.symm, rfl, rfl⟩
      have hpath : sameCircle (v, j) (gen (σ 2) • relabelCrack σ v n, j) :=
        Relation.EqvGen.trans (x := (v, j)) (y := (relabelCrack σ v n, j))
          (z := (gen (σ 2) • relabelCrack σ v n, j)) ih h2
      exact Relation.EqvGen.trans (x := (v, j))
        (y := (gen (σ 2) • relabelCrack σ v n, j))
        (z := (gen (σ 3) • (gen (σ 2) • relabelCrack σ v n), j)) hpath h3

end Apollo
