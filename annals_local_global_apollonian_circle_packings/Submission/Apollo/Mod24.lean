/-
Congruence structure modulo 24 of the Descartes quadruples in the packing
generated by (-3,5,8,8).
-/
import Submission.Apollo.Defs
import Mathlib.Tactic
import Mathlib.Data.Int.Basic
import Mathlib.Data.Int.ModEq
import Mathlib.Data.Nat.Basic
import Mathlib.Data.Nat.Prime.Defs
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Permutation
import Mathlib.Data.Fin.VecNotation
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.NumberTheory.LegendreSymbol.JacobiSymbol
import Mathlib.Logic.Equiv.Defs
import Mathlib.Logic.Equiv.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Set.Function
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fin.Basic
set_option autoImplicit false

open LocalGlobalApollonianCirclePackings
open scoped Pointwise

namespace Apollo

abbrev Q4 : Type := Fin 4 → ZMod 24

abbrev descartesMod24 (v : Q4) : Prop := ((∑ i, v i : ZMod 24) ^ 2 = 2 * ∑ i, (v i)^2)

abbrev oddRes (r : ZMod 24) : Prop := r.val % 2 = 1

abbrev twoOdd (v : Q4) : Prop := (Finset.univ.filter (fun i : Fin 4 => oddRes (v i))).card = 2

abbrev A24 (r : ZMod 24) : Prop := r = 0 ∨ r = 5 ∨ r = 8 ∨ r = 12 ∨ r = 20 ∨ r = 21

abbrev coordsOk (v : Q4) : Prop := ∀ i, A24 (v i)

/-- The invariant that is (computably) closed under all S-moves and holds at the
base quadruple: Descartes equation, coordinates admissible, exactly two odds. -/
abbrev Qpred (v : Q4) : Prop := coordsOk v ∧ descartesMod24 v ∧ twoOdd v

/-- Reduction of a vector to residues mod 24. -/
def toZ24 (v : Fin 4 → ℤ) : Q4 := fun i => (v i : ZMod 24)

-- S-move on residues (coordinate i changed)
def Smod (i : Fin 4) (v : Q4) : Q4 :=
  fun j => if j = i then -(v i) + 2 * ∑ k, (if k = i then 0 else v k) else v j

lemma gen_smul_apply (i j : Fin 4) (v : Fin 4 → ℤ) :
    (gen i • v) j = if j = i then -(v i) + 2 * (∑ k : Fin 4, if k = i then 0 else v k) else v j := by
  fin_cases i <;> fin_cases j <;>
    simp [gen, LocalGlobalApollonianCirclePackings.GeneralLinearGroup.smul_def,
      Matrix.mulVec_eq_sum, Fin.sum_univ_four] <;> ring

-- moving commutes with reduction
lemma toZ24_gen (i : Fin 4) (v : Fin 4 → ℤ) : toZ24 (gen i • v) = Smod i (toZ24 v) := by
  ext j
  change ((gen i • v) j : ZMod 24) = Smod i (toZ24 v) j
  rw [gen_smul_apply]
  by_cases hji : j = i
  · simp [toZ24, Smod, hji]
  · simp [toZ24, Smod, hji]

-- base quadruple satisfies Qpred
lemma Qpred_base : Qpred (toZ24 q0v) := by
  decide

-- admissible residues, as a finite subtype (6 elements)
abbrev AllowVal : Type := {r : ZMod 24 // A24 r}

/-- computable decidability of Qpred (by unfolding; helps `decide` below). -/
local instance (v : Q4) : Decidable (Qpred v) := by
  unfold Qpred coordsOk descartesMod24 twoOdd oddRes A24
  infer_instance

-- Kernel computation of S-move closure over admissible residue patterns
-- only (6^4 patterns instead of 24^4).
set_option maxRecDepth 1000000 in
lemma qpred_smod_closed :
    ∀ (i : Fin 4) (g : Fin 4 → AllowVal),
      twoOdd (fun j => (g j).1) → descartesMod24 (fun j => (g j).1) →
        Qpred (Smod i (fun j => (g j).1)) := by
  decide

-- closure under moves
lemma Qpred_S (i : Fin 4) (v : Q4) (hv : Qpred v) : Qpred (Smod i v) := by
  rcases hv with ⟨hcoord, hdesc, htwo⟩
  have hc := qpred_smod_closed i (fun k : Fin 4 => ⟨v k, hcoord k⟩) htwo hdesc
  simpa using hc

/-- Every Descartes quadruple in the Apollonian orbit reduces to an element of Qpred. -/
theorem orbit_Qpred (v : Fin 4 → ℤ) (hv : v ∈ apOrbit) : Qpred (toZ24 v) := by
  refine of_closure_apply (P := fun w => Qpred (toZ24 w)) ?hP ?hS v hv
  · exact Qpred_base
  · intro i w hw
    rw [toZ24_gen]
    exact Qpred_S i (toZ24 w) hw

-- elementary conversion lemmas between ZMod equality and integer congruence
lemma zmod24_eq_iff_modEq (x : ℤ) (r : ℕ) :
    ((x : ZMod 24) = (r : ZMod 24)) ↔ x ≡ (r : ℤ) [ZMOD (24 : ℤ)] := by
  exact ZMod.intCast_eq_intCast_iff x r 24

/-- Every coordinate value in the packing is congruent to one of 0,5,8,12,20,21
modulo 24. -/
theorem value_mod24 (v : Fin 4 → ℤ) (hv : v ∈ apOrbit) (i : Fin 4) :
    ∃ r ∈ ({0, 5, 8, 12, 20, 21} : Finset ℕ), v i ≡ (r : ℤ) [ZMOD (24 : ℤ)] := by
  have hq := orbit_Qpred v hv
  have hr := hq.1 i
  rcases hr with h | h | h | h | h | h
  · refine ⟨0, by simp, ?_⟩
    simpa using (zmod24_eq_iff_modEq (v i) 0).1 h
  · refine ⟨5, by simp, ?_⟩
    simpa using (zmod24_eq_iff_modEq (v i) 5).1 h
  · refine ⟨8, by simp, ?_⟩
    simpa using (zmod24_eq_iff_modEq (v i) 8).1 h
  · refine ⟨12, by simp, ?_⟩
    simpa using (zmod24_eq_iff_modEq (v i) 12).1 h
  · refine ⟨20, by simp, ?_⟩
    simpa using (zmod24_eq_iff_modEq (v i) 20).1 h
  · refine ⟨21, by simp, ?_⟩
    simpa using (zmod24_eq_iff_modEq (v i) 21).1 h

-- convert a mod 24 congruence into an explicit linear equation
lemma modEq24_eq {x : ℤ} {r : ℕ} (h : x ≡ (r : ℤ) [ZMOD (24 : ℤ)]) :
    ∃ k : ℤ, x = (r : ℤ) + 24 * k := by
  rw [Int.modEq_iff_dvd] at h
  rcases h with ⟨k, hk⟩
  use -k
  omega

/-- Odd coordinates are ≡ 1 mod 4. -/
theorem odd_value_eq_one_mod4 (v : Fin 4 → ℤ) (hv : v ∈ apOrbit) (i : Fin 4)
    (hodd : ¬ 2 ∣ v i) : ∃ k : ℤ, v i = 1 + 4 * k := by
  rcases value_mod24 v hv i with ⟨r, hr, hm⟩
  rcases modEq24_eq hm with ⟨k, hk⟩
  simp at hr
  rcases hr with hr | hr | hr | hr | hr | hr <;> subst r
  · exfalso; exact hodd ⟨12 * k, by omega⟩
  · use 1 + 6 * k; omega
  · exfalso; exact hodd ⟨4 + 12 * k, by omega⟩
  · exfalso; exact hodd ⟨6 + 12 * k, by omega⟩
  · exfalso; exact hodd ⟨10 + 12 * k, by omega⟩
  · use 5 + 6 * k; omega

/-- Even coordinates are ≡ 0 mod 4. -/
theorem even_value_eq_zero_mod4 (v : Fin 4 → ℤ) (hv : v ∈ apOrbit) (i : Fin 4)
    (heven : 2 ∣ v i) : ∃ k : ℤ, v i = 0 + 4 * k := by
  rcases value_mod24 v hv i with ⟨r, hr, hm⟩
  rcases modEq24_eq hm with ⟨k, hk⟩
  simp at hr
  rcases hr with hr | hr | hr | hr | hr | hr <;> subst r
  · use 6 * k; omega
  · exfalso
    have hn : ¬ 2 ∣ v i := by omega
    exact hn heven
  · use 2 + 6 * k; omega
  · use 3 + 6 * k; omega
  · use 5 + 6 * k; omega
  · exfalso
    have hn : ¬ 2 ∣ v i := by omega
    exact hn heven

/-- Odd coordinates are ≡ 5 mod 8. -/
theorem odd_value_eq_five_mod8 (v : Fin 4 → ℤ) (hv : v ∈ apOrbit) (i : Fin 4)
    (hodd : ¬ 2 ∣ v i) : ∃ k : ℤ, v i = 5 + 8 * k := by
  rcases value_mod24 v hv i with ⟨r, hr, hm⟩
  rcases modEq24_eq hm with ⟨k, hk⟩
  simp at hr
  rcases hr with hr | hr | hr | hr | hr | hr <;> subst r
  · exfalso; exact hodd ⟨12 * k, by omega⟩
  · use 3 * k; omega
  · exfalso; exact hodd ⟨4 + 12 * k, by omega⟩
  · exfalso; exact hodd ⟨6 + 12 * k, by omega⟩
  · exfalso; exact hodd ⟨10 + 12 * k, by omega⟩
  · use 2 + 3 * k; omega

end Apollo
