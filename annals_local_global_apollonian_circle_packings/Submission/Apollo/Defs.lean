/-
Definitions for the formal proof of Theorem 1.6:
The Apollonian circle packing generated by (-3,5,8,8) has no square curvatures.

We work with the orbit of the base quadruple under the Apollonian group
(generated by the reflections S₁..S₄).  Permutations of coordinates do not
change the set of coordinate values, so the formal `curvatureSet` (which uses
the larger TransformationGroup orbit) has the same values as this orbit.
-/
import ChallengeDeps
import Mathlib.Tactic
import Mathlib.Data.Int.Basic
import Mathlib.Data.Int.ModEq
import Mathlib.Data.Nat.Basic
import Mathlib.Data.Nat.Prime.Defs
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Permutation
import Mathlib.Data.Fin.VecNotation
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.NumberTheory.LegendreSymbol.JacobiSymbol
import Mathlib.Logic.Equiv.Defs
import Mathlib.Logic.Equiv.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Set.Function
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fin.Basic
set_option autoImplicit false

open LocalGlobalApollonianCirclePackings
open scoped Pointwise

namespace Apollo

-- base quadruple as a raw vector
def q0v : Fin 4 → ℤ := ![-3, 5, 8, 8]

-- the orbit of q0v under the Apollonian group (S-moves only)
def apOrbit : Set (Fin 4 → ℤ) := {v | ∃ g ∈ ApollonianGroup, v = g • q0v}

-- All four coordinate values over the Apollonian orbit.
def apValues : Set ℤ := {x | ∃ v ∈ apOrbit, x ∈ Set.range v}

-- The generators S₁..S₄ indexed by Fin 4
def gen (i : Fin 4) : GL (Fin 4) ℤ :=
  match i with
  | ⟨0, _⟩ => S₁
  | ⟨1, _⟩ => S₂
  | ⟨2, _⟩ => S₃
  | ⟨3, _⟩ => S₄

-- the set of generators
def gens : Set (GL (Fin 4) ℤ) := {g | ∃ i, g = gen i}

lemma gens_eq : gens = {S₁, S₂, S₃, S₄} := by
  ext g
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp [gen]
  · intro hg
    rcases hg with rfl | rfl | rfl | rfl
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
    · exact ⟨2, rfl⟩
    · exact ⟨3, rfl⟩

lemma apollonianGroup_eq_closure : ApollonianGroup = Subgroup.closure gens := by
  rw [ApollonianGroup, gens_eq]

-- each generator is an involution, hence its own inverse
lemma gen_inv (i : Fin 4) : (gen i)⁻¹ = gen i := by
  apply Units.ext
  fin_cases i <;> simp [gen]

/-- Move-closure lemma: a property that holds at the base and is closed under
all S-moves holds everywhere on the Apollonian orbit. -/
theorem of_closure_apply {P : (Fin 4 → ℤ) → Prop} (hP : P q0v)
    (hS : ∀ i : Fin 4, ∀ w : Fin 4 → ℤ, P w → P (gen i • w)) :
    ∀ v ∈ apOrbit, P v := by
  intro v hv
  rcases hv with ⟨g, hg, rfl⟩
  rw [apollonianGroup_eq_closure] at hg
  refine
    (Subgroup.closure_induction_left (s := gens)
      (p := fun g _ => ∀ w : Fin 4 → ℤ, P w → P (g • w))
      ?one ?mulL ?invC (x := g) hg) q0v hP
  · -- p 1 : the identity action does nothing
    intro w hw
    simpa using hw
  · -- p (x * y) from p y, x ∈ gens
    intro x hx y hy ih w hw
    rcases hx with ⟨i, rfl⟩
    have hyw : P (y • w) := ih w hw
    simpa [mul_smul] using hS i (y • w) hyw
  · -- p (x⁻¹ * y) from p y, x ∈ gens
    intro x hx y hy ih w hw
    rcases hx with ⟨i, rfl⟩
    have hyw : P (y • w) := ih w hw
    simpa [gen_inv i, mul_smul] using hS i (y • w) hyw

/-- The base quadruple is in the orbit. -/
lemma q0v_mem_apOrbit : q0v ∈ apOrbit := by
  refine ⟨1, ?_, ?_⟩
  · exact one_mem ApollonianGroup
  · simp

-- value set contains all coordinates of orbit quadruples iff...
lemma mem_apValues_iff {x : ℤ} : x ∈ apValues ↔ ∃ v ∈ apOrbit, ∃ i : Fin 4, v i = x := by
  constructor
  · rintro ⟨v, hv, ⟨i, rfl⟩⟩
    exact ⟨v, hv, i, rfl⟩
  · rintro ⟨v, hv, i, rfl⟩
    exact ⟨v, hv, i, rfl⟩

end Apollo
