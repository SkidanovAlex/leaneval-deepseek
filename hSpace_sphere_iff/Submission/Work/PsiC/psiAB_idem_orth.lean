import Mathlib
import Submission.Work.PsiC.psi23_defs
import Submission.Work.KT.PsiC.CycProj
import Submission.Work.KT.PsiC.FramePerm3
import Submission.Work.KT.PsiC.FramePerm
import Submission.Work.PsiC.rest_cancel

/-!
# `Work.PsiC.psiAB_idem_orth`

The two summands of the `gamB`-projector at `lam * eps`,

* `psiA p eps lam = U_λ · V_λ · H_ε` (the *diagonal* part, where `U_λ`, `V_λ` are the `λ`-spectral
  projectors of the two commuting order-three permutations `uB`, `vB`, and `H_ε = h_ε(sB)`),
* `psiB p eps lam = Q2m_λ · H_ε` (the *off-diagonal* part `U_{λω}V_{λω²} + U_{λω²}V_{λω}`),

are orthogonal idempotents.

The proof is a purely algebraic computation in the subring generated by the permutation matrices of
`uB`, `vB` and `sB`.  Writing `u = uB`, `v = vB`, `s = sB` (as matrices) one has `u³ = v³ = 1`,
`uv = vu`, `s² = 1` and `s u s = v`, `s v s = u` (`Submission/Work/PsiC/rest_cancel.lean`).  Hence

* `E = U_λ V_λ` is the joint `(λ,λ)`-projector of the commuting pair `(u,v)`; it is idempotent and,
  because `s` swaps the two `λ`-eigenparts of `u` and `v`, invariant under conjugation by `s`,
  hence commutes with every polynomial in `s`, in particular with `H_ε`;
* `F = U_{λω}V_{λω²} + U_{λω²}V_{λω}` is a sum of two orthogonal idempotents, is likewise
  `s`-invariant (conjugation by `s` interchanges its two summands), hence commutes with `H_ε`;
* `E F = F E = 0`, since the `u`-eigenparts at `λ` and at `λω`, `λω²` are orthogonal (and likewise
  for the `v`-eigenparts at `λ` and `λω²`, `λω`).

The last step is the general observation (`PsiABIdemAux.orth_idem_prod`) that products of two
orthogonal idempotents `E`, `F` with an idempotent `H` commuting with both are again orthogonal
idempotents.
-/

namespace Work.PsiC

open Matrix
open Work.KT
open Work.KT.PsiC

noncomputable section

namespace PsiABIdemAux

/-! ## A general ring identity -/

section GeneralRing

variable {R : Type} [Ring R]

/-- If `E` and `F` are orthogonal idempotents and `H` is an idempotent commuting with both, then
`E * H` and `F * H` are orthogonal idempotents. -/
theorem orth_idem_prod {E F H : R} (hE : E * E = E) (hF : F * F = F) (hH : H * H = H)
    (hEF : E * F = 0) (hFE : F * E = 0) (hEH : E * H = H * E) (hFH : F * H = H * F) :
    (E * H) * (E * H) = E * H ∧ (F * H) * (F * H) = F * H ∧
      (E * H) * (F * H) = 0 ∧ (F * H) * (E * H) = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc (E * H) * (E * H) = E * (H * E) * H := by noncomm_ring
      _ = E * (E * H) * H := by rw [hEH]
      _ = (E * E) * (H * H) := by noncomm_ring
      _ = E * H := by rw [hE, hH]
  · calc (F * H) * (F * H) = F * (H * F) * H := by noncomm_ring
      _ = F * (F * H) * H := by rw [hFH]
      _ = (F * F) * (H * H) := by noncomm_ring
      _ = F * H := by rw [hF, hH]
  · calc (E * H) * (F * H) = E * (H * F) * H := by noncomm_ring
      _ = E * (F * H) * H := by rw [hFH]
      _ = (E * F) * (H * H) := by noncomm_ring
      _ = 0 := by rw [hEF, zero_mul]
  · calc (F * H) * (E * H) = F * (H * E) * H := by noncomm_ring
      _ = F * (E * H) * H := by rw [hEH]
      _ = (F * E) * (H * H) := by noncomm_ring
      _ = 0 := by rw [hFE, zero_mul]

end GeneralRing

/-! ## Cube-root-of-unity arithmetic -/

/-- `ω² ≠ 1` for the primitive cube root `ω`. -/
theorem omega_sq_ne_one : omega ^ 2 ≠ (1 : ℂ) := by
  intro h
  have h3 : omega = 1 := by
    have h' := omega_pow_three
    rw [pow_succ, h, one_mul] at h'
    exact h'
  exact omega_ne_one' h3

/-- `λ ≠ λ ω` when `λ³ = 1`. -/
theorem lam_ne_lam_omega (lam : ℂ) (hlam : lam ^ 3 = 1) : lam ≠ lam * omega := by
  intro h
  have hl0 : lam ≠ 0 := by intro h0; rw [h0] at hlam; norm_num at hlam
  have h' : lam * omega = lam * 1 := by rw [mul_one]; exact h.symm
  exact omega_ne_one' (mul_left_cancel₀ hl0 h')

/-- `λ ≠ λ ω²` when `λ³ = 1`. -/
theorem lam_ne_lam_omega_sq (lam : ℂ) (hlam : lam ^ 3 = 1) : lam ≠ lam * omega ^ 2 := by
  intro h
  have hl0 : lam ≠ 0 := by intro h0; rw [h0] at hlam; norm_num at hlam
  have h' : lam * omega ^ 2 = lam * 1 := by rw [mul_one]; exact h.symm
  exact omega_sq_ne_one (mul_left_cancel₀ hl0 h')

end PsiABIdemAux

open PsiABIdemAux

theorem psiAB_idem_orth (A : Type) [Ring A] [Algebra ℂ A] (hA : ∀ x y : A, x * y = y * x)
    (p : Work.KT.Mat A) (eps lam : ℂ) (heps : eps ^ 2 = 1) (hlam : lam ^ 3 = 1) :
    Work.PsiC.psiA p eps lam * Work.PsiC.psiA p eps lam = Work.PsiC.psiA p eps lam ∧
      Work.PsiC.psiB p eps lam * Work.PsiC.psiB p eps lam = Work.PsiC.psiB p eps lam ∧
      Work.PsiC.psiA p eps lam * Work.PsiC.psiB p eps lam = 0 ∧
      Work.PsiC.psiB p eps lam * Work.PsiC.psiA p eps lam = 0 := by
  set U : Matrix (IB p.1) (IB p.1) A := cycProj (A := A) (uB p.1) lam with hU
  set V : Matrix (IB p.1) (IB p.1) A := cycProj (A := A) (vB p.1) lam with hV
  set Q1 : Matrix (IB p.1) (IB p.1) A := cycProj (A := A) (uB p.1) (lam * omega) with hQ1
  set Q2 : Matrix (IB p.1) (IB p.1) A := cycProj (A := A) (vB p.1) (lam * omega ^ 2) with hQ2
  set R1 : Matrix (IB p.1) (IB p.1) A := cycProj (A := A) (uB p.1) (lam * omega ^ 2) with hR1
  set R2 : Matrix (IB p.1) (IB p.1) A := cycProj (A := A) (vB p.1) (lam * omega) with hR2
  set s : Matrix (IB p.1) (IB p.1) A := (sB p.1).permMatrix A with hs
  set E : Matrix (IB p.1) (IB p.1) A := U * V with hE
  set F : Matrix (IB p.1) (IB p.1) A := Q1 * Q2 + R1 * R2 with hF
  set H : Matrix (IB p.1) (IB p.1) A := halfProj (A := A) eps (sB p.1) with hH
  -- cube facts
  have huc : uB p.1 * uB p.1 * uB p.1 = 1 := uB_cube p.1
  have hvc : vB p.1 * vB p.1 * vB p.1 = 1 := vB_cube p.1
  have hs2 : s * s = 1 := by
    rw [hs, ← Matrix.permMatrix_mul, sB_mul_self, Matrix.permMatrix_one]
  -- idempotency of the individual projectors
  have hUidem : U * U = U := by
    rw [hU]; exact cycProj_idem (A := A) (uB p.1) lam huc hlam
  have hVidem : V * V = V := by
    rw [hV]; exact cycProj_idem (A := A) (vB p.1) lam hvc hlam
  have hQ1idem : Q1 * Q1 = Q1 := by
    rw [hQ1]; exact cycProj_idem (A := A) (uB p.1) (lam * omega) huc
      (cube_lam_omega lam hlam)
  have hQ2idem : Q2 * Q2 = Q2 := by
    rw [hQ2]; exact cycProj_idem (A := A) (vB p.1) (lam * omega ^ 2) hvc
      (cube_lam_omega_sq lam hlam)
  have hR1idem : R1 * R1 = R1 := by
    rw [hR1]; exact cycProj_idem (A := A) (uB p.1) (lam * omega ^ 2) huc
      (cube_lam_omega_sq lam hlam)
  have hR2idem : R2 * R2 = R2 := by
    rw [hR2]; exact cycProj_idem (A := A) (vB p.1) (lam * omega) hvc
      (cube_lam_omega lam hlam)
  -- commutation of a `uB`-projector with a `vB`-projector
  have hUV : U * V = V * U := by
    rw [hU, hV]; exact cycProj_uB_mul_vB hA p.1 lam lam
  have hQ1Q2 : Q1 * Q2 = Q2 * Q1 := by
    rw [hQ1, hQ2]; exact cycProj_uB_mul_vB hA p.1 (lam * omega) (lam * omega ^ 2)
  have hR1R2 : R1 * R2 = R2 * R1 := by
    rw [hR1, hR2]; exact cycProj_uB_mul_vB hA p.1 (lam * omega ^ 2) (lam * omega)
  have hQ2R1 : Q2 * R1 = R1 * Q2 := by
    rw [hQ2, hR1]
    exact (cycProj_uB_mul_vB hA p.1 (lam * omega ^ 2) (lam * omega ^ 2)).symm
  have hR2Q1 : R2 * Q1 = Q1 * R2 := by
    rw [hR2, hQ1]
    exact (cycProj_uB_mul_vB hA p.1 (lam * omega) (lam * omega)).symm
  have hVQ1 : V * Q1 = Q1 * V := by
    rw [hV, hQ1]; exact (cycProj_uB_mul_vB hA p.1 (lam * omega) lam).symm
  have hVR1 : V * R1 = R1 * V := by
    rw [hV, hR1]; exact (cycProj_uB_mul_vB hA p.1 (lam * omega ^ 2) lam).symm
  have hQ2U : Q2 * U = U * Q2 := by
    rw [hQ2, hU]; exact (cycProj_uB_mul_vB hA p.1 lam (lam * omega ^ 2)).symm
  have hR2U : R2 * U = U * R2 := by
    rw [hR2, hU]; exact (cycProj_uB_mul_vB hA p.1 lam (lam * omega)).symm
  -- orthogonality of projectors of one permutation at distinct scalars
  have hneω : lam * omega ≠ lam * omega ^ 2 := lam_omega_ne_lam_omega_sq lam hlam
  have hne1 : lam ≠ lam * omega := lam_ne_lam_omega lam hlam
  have hne2 : lam ≠ lam * omega ^ 2 := lam_ne_lam_omega_sq lam hlam
  have hQ1R1 : Q1 * R1 = 0 := by
    rw [hQ1, hR1]
    exact cycProj_orth (A := A) (uB p.1) (lam * omega) (lam * omega ^ 2) huc
      (cube_lam_omega lam hlam) (cube_lam_omega_sq lam hlam) hneω
  have hR1Q1 : R1 * Q1 = 0 := by
    rw [hR1, hQ1]
    exact cycProj_orth (A := A) (uB p.1) (lam * omega ^ 2) (lam * omega) huc
      (cube_lam_omega_sq lam hlam) (cube_lam_omega lam hlam) hneω.symm
  have hQ2R2 : Q2 * R2 = 0 := by
    rw [hQ2, hR2]
    exact cycProj_orth (A := A) (vB p.1) (lam * omega ^ 2) (lam * omega) hvc
      (cube_lam_omega_sq lam hlam) (cube_lam_omega lam hlam) hneω.symm
  have hR2Q2 : R2 * Q2 = 0 := by
    rw [hR2, hQ2]
    exact cycProj_orth (A := A) (vB p.1) (lam * omega) (lam * omega ^ 2) hvc
      (cube_lam_omega lam hlam) (cube_lam_omega_sq lam hlam) hneω
  have hUQ1 : U * Q1 = 0 := by
    rw [hU, hQ1]
    exact cycProj_orth (A := A) (uB p.1) lam (lam * omega) huc hlam
      (cube_lam_omega lam hlam) hne1
  have hUR1 : U * R1 = 0 := by
    rw [hU, hR1]
    exact cycProj_orth (A := A) (uB p.1) lam (lam * omega ^ 2) huc hlam
      (cube_lam_omega_sq lam hlam) hne2
  have hQ1U : Q1 * U = 0 := by
    rw [hQ1, hU]
    exact cycProj_orth (A := A) (uB p.1) (lam * omega) lam huc
      (cube_lam_omega lam hlam) hlam hne1.symm
  have hR1U : R1 * U = 0 := by
    rw [hR1, hU]
    exact cycProj_orth (A := A) (uB p.1) (lam * omega ^ 2) lam huc
      (cube_lam_omega_sq lam hlam) hlam hne2.symm
  -- `E` is idempotent
  have hEidem : E * E = E := by
    rw [hE]
    calc (U * V) * (U * V) = U * (V * U) * V := by noncomm_ring
      _ = U * (U * V) * V := by rw [hUV]
      _ = (U * U) * (V * V) := by noncomm_ring
      _ = U * V := by rw [hUidem, hVidem]
  -- `F` is idempotent
  have hAm_idem : (Q1 * Q2) * (Q1 * Q2) = Q1 * Q2 := by
    calc (Q1 * Q2) * (Q1 * Q2) = Q1 * (Q2 * Q1) * Q2 := by noncomm_ring
      _ = Q1 * (Q1 * Q2) * Q2 := by rw [hQ1Q2]
      _ = (Q1 * Q1) * (Q2 * Q2) := by noncomm_ring
      _ = Q1 * Q2 := by rw [hQ1idem, hQ2idem]
  have hBm_idem : (R1 * R2) * (R1 * R2) = R1 * R2 := by
    calc (R1 * R2) * (R1 * R2) = R1 * (R2 * R1) * R2 := by noncomm_ring
      _ = R1 * (R1 * R2) * R2 := by rw [hR1R2]
      _ = (R1 * R1) * (R2 * R2) := by noncomm_ring
      _ = R1 * R2 := by rw [hR1idem, hR2idem]
  have hAmBm : (Q1 * Q2) * (R1 * R2) = 0 := by
    calc (Q1 * Q2) * (R1 * R2) = Q1 * (Q2 * R1) * R2 := by noncomm_ring
      _ = Q1 * (R1 * Q2) * R2 := by rw [hQ2R1]
      _ = (Q1 * R1) * (Q2 * R2) := by noncomm_ring
      _ = 0 := by rw [hQ1R1, hQ2R2, zero_mul]
  have hBmAm : (R1 * R2) * (Q1 * Q2) = 0 := by
    calc (R1 * R2) * (Q1 * Q2) = R1 * (R2 * Q1) * Q2 := by noncomm_ring
      _ = R1 * (Q1 * R2) * Q2 := by rw [hR2Q1]
      _ = (R1 * Q1) * (R2 * Q2) := by noncomm_ring
      _ = 0 := by rw [hR1Q1, hR2Q2, zero_mul]
  have hFidem : F * F = F := by
    rw [hF]
    have hexp : (Q1 * Q2 + R1 * R2) * (Q1 * Q2 + R1 * R2) =
        (Q1 * Q2) * (Q1 * Q2) + (Q1 * Q2) * (R1 * R2) +
          (R1 * R2) * (Q1 * Q2) + (R1 * R2) * (R1 * R2) := by noncomm_ring
    rw [hexp, hAm_idem, hAmBm, hBmAm, hBm_idem]
    abel
  -- `H` is idempotent
  have hHidem : H * H = H := by
    rw [hH]; exact halfProj_idem (A := A) (sB p.1) eps (sB_mul_self p.1) heps
  -- conjugation by `s` interchanges the two eigenparts
  have hsUs : s * U * s = V := by
    rw [hs, hU, hV, conj_cycProj_perm (A := A) (uB p.1) (sB p.1) (sB_mul_self p.1) lam,
      sB_conj_uB p.1]
  have hsVs : s * V * s = U := by
    rw [hs, hV, hU, conj_cycProj_perm (A := A) (vB p.1) (sB p.1) (sB_mul_self p.1) lam,
      sB_conj_vB p.1]
  have hsQ1s : s * Q1 * s = R2 := by
    rw [hs, hQ1, hR2, conj_cycProj_perm (A := A) (uB p.1) (sB p.1) (sB_mul_self p.1)
      (lam * omega), sB_conj_uB p.1]
  have hsQ2s : s * Q2 * s = R1 := by
    rw [hs, hQ2, hR1, conj_cycProj_perm (A := A) (vB p.1) (sB p.1) (sB_mul_self p.1)
      (lam * omega ^ 2), sB_conj_vB p.1]
  have hsR1s : s * R1 * s = Q2 := by
    rw [hs, hR1, hQ2, conj_cycProj_perm (A := A) (uB p.1) (sB p.1) (sB_mul_self p.1)
      (lam * omega ^ 2), sB_conj_uB p.1]
  have hsR2s : s * R2 * s = Q1 := by
    rw [hs, hR2, hQ1, conj_cycProj_perm (A := A) (vB p.1) (sB p.1) (sB_mul_self p.1)
      (lam * omega), sB_conj_vB p.1]
  -- `E` and `F` are invariant under conjugation by `s`
  have hsEs : s * E * s = E := by
    rw [hE]
    calc s * (U * V) * s = (s * U * s) * (s * V * s) := conj_mul' s U V hs2
      _ = V * U := by rw [hsUs, hsVs]
      _ = U * V := hUV.symm
  have hsFs : s * F * s = F := by
    rw [hF]
    have hexp : s * (Q1 * Q2 + R1 * R2) * s = s * (Q1 * Q2) * s + s * (R1 * R2) * s := by
      noncomm_ring
    rw [hexp, conj_mul' s Q1 Q2 hs2, conj_mul' s R1 R2 hs2, hsQ1s, hsQ2s, hsR1s, hsR2s,
      ← hR1R2, ← hQ1Q2, add_comm]
  -- hence `E`, `F` commute with `H`
  have hEs : E * s = s * E := by
    calc E * s = (s * s) * E * s := by rw [hs2, one_mul]
      _ = s * (s * E * s) := by noncomm_ring
      _ = s * E := by rw [hsEs]
  have hFs : F * s = s * F := by
    calc F * s = (s * s) * F * s := by rw [hs2, one_mul]
      _ = s * (s * F * s) := by noncomm_ring
      _ = s * F := by rw [hsFs]
  have hEH : E * H = H * E := by
    rw [hH]; exact halfProj_comm_of hA (sB p.1) eps E hEs
  have hFH : F * H = H * F := by
    rw [hH]; exact halfProj_comm_of hA (sB p.1) eps F hFs
  -- `E` and `F` are orthogonal
  have hEF : E * F = 0 := by
    rw [hE, hF]
    have h1 : U * V * (Q1 * Q2) = 0 := by
      calc U * V * (Q1 * Q2) = U * (V * Q1) * Q2 := by noncomm_ring
        _ = U * (Q1 * V) * Q2 := by rw [hVQ1]
        _ = (U * Q1) * (V * Q2) := by noncomm_ring
        _ = 0 := by rw [hUQ1, zero_mul]
    have h2 : U * V * (R1 * R2) = 0 := by
      calc U * V * (R1 * R2) = U * (V * R1) * R2 := by noncomm_ring
        _ = U * (R1 * V) * R2 := by rw [hVR1]
        _ = (U * R1) * (V * R2) := by noncomm_ring
        _ = 0 := by rw [hUR1, zero_mul]
    rw [mul_add, h1, h2, add_zero]
  have hFE : F * E = 0 := by
    rw [hE, hF]
    have h1 : (Q1 * Q2) * (U * V) = 0 := by
      calc (Q1 * Q2) * (U * V) = Q1 * (Q2 * U) * V := by noncomm_ring
        _ = Q1 * (U * Q2) * V := by rw [hQ2U]
        _ = (Q1 * U) * (Q2 * V) := by noncomm_ring
        _ = 0 := by rw [hQ1U, zero_mul]
    have h2 : (R1 * R2) * (U * V) = 0 := by
      calc (R1 * R2) * (U * V) = R1 * (R2 * U) * V := by noncomm_ring
        _ = R1 * (U * R2) * V := by rw [hR2U]
        _ = (R1 * U) * (R2 * V) := by noncomm_ring
        _ = 0 := by rw [hR1U, zero_mul]
    rw [add_mul, h1, h2, add_zero]
  -- assembly
  obtain ⟨k1, k2, k3, k4⟩ := orth_idem_prod hEidem hFidem hHidem hEF hFE hEH hFH
  have hpsiA : Work.PsiC.psiA p eps lam = E * H := rfl
  have hpsiB : Work.PsiC.psiB p eps lam = F * H := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hpsiA]; exact k1
  · rw [hpsiB]; exact k2
  · rw [hpsiA, hpsiB]; exact k3
  · rw [hpsiB, hpsiA]; exact k4

end

end Work.PsiC
