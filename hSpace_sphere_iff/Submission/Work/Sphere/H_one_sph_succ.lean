# `H¹(S^{n+2}; ℚ) = 0`

The first cohomology of `S^{n+2}` with rational coefficients vanishes, for every `n`: this is the
degree `1` case of the connectedness of the spheres of dimension `≥ 2`.

The computation is done with the two-cap Mayer–Vietoris machine of
`Submission/Work/Sphere/Suspension.lean`.  For `S := smallC (n+1)` the two pieces `A = capAsub`
and `B = capBsub` of the two-cap cover are acyclic in positive degrees, so

`H¹(S) = ker (mvAlphaH S A B 1) = range (mvConnecting S A B hAB 0)`.

The connecting map of degree `0` is the map `H⁰(A ⊓ B) ⟶ H¹(S)`, and by exactness at
`H⁰(A ⊓ B)` its kernel is `range (mvBetaH S A B 0)`, the submodule generated by differences
`x| - y|` of restrictions of degree `0` classes from the two caps.  This map is surjective —
`H⁰(A ⊓ B)` is one dimensional because `A ⊓ B` is the doubly punctured sphere, which is homotopy
equivalent to `S^{n+1}`, a path connected space (`PathConnectedSpace (Sph (n+1))`), while the
restriction of the class of the constant `1`-cochain is a nonzero class on `A ⊓ B` — so
`mvConnecting S A B hAB 0 = 0` and `H¹(S) = 0`.  Finally `H¹(S^{n+2}) ≅ H¹(S)` by the
small-simplex theorem.

The two inputs supplied by colleagues are `Work.Sphere.pathConnected_sph` (spheres of dimension
`≥ 1` are path connected) and `Work.Sphere.nonempty_capAsub_inf_capBsub_zero` (the intersection
of the two pieces of the cover has a `0`-simplex, so that the class of `1` there is nonzero).
-/
import Mathlib
import Submission.Work.Sphere.Suspension
import Submission.Work.Cohomology.H_zero_connected
import Submission.Work.Cohomology.H_zero_two_points
import Submission.Work.Cohomology.mvAlphaH_ker_eq_range
import Submission.Work.Cohomology.mvBetaH_ker_eq_range
import Submission.Work.Cohomology.mvConnecting_ker_eq_range
import Submission.Work.Sphere.pathConnected_sph
import Submission.Work.Sphere.nonempty_capAsub_inf_capBsub_zero

open CategoryTheory Simplicial Opposite

namespace Work.Sphere

open Submission.Cohomology
open Submission.Sphere

noncomputable section

set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency.types false
set_option linter.style.haveILetI false

/-! ## Elementary facts about the constant `1`-cochain -/

/-- The constant `1`-cochain of a simplicial set is a degree `0` cocycle. -/
lemma oneCochain_mem_cycles (S : SSet.{0}) :
    (1 : Cochain S ℚ 0) ∈ cycles S ℚ 0 := by
  rw [mem_cycles_iff]
  ext σ
  rw [Submission.Cohomology.coboundary_apply, Fin.sum_univ_two]
  simp

/-- Pullback of cochains sends the constant `1`-cochain to the constant `1`-cochain. -/
lemma pullbackCo_oneCochain {S T : SSet.{0}} (f : S ⟶ T) :
    pullbackCo ℚ f (1 : Cochain T ℚ 0) = (1 : Cochain S ℚ 0) := by
  ext σ; rfl

/-- The pullback on cohomology sends the class of `1` to the class of `1`. -/
lemma H_map_oneCochain {S T : SSet.{0}} (f : S ⟶ T) :
    H.map ℚ f 0 (H.mk (1 : Cochain T ℚ 0) (oneCochain_mem_cycles T)) =
      H.mk (1 : Cochain S ℚ 0) (oneCochain_mem_cycles S) := by
  rw [H.map_mk, H.mk_eq_mk_iff, pullbackCo_oneCochain, sub_self]
  exact Submodule.zero_mem _

/-- On a simplicial set with a `0`-simplex, the class of the constant `1`-cochain is nonzero: in
degree `0` there are no boundaries, so the class of a cocycle vanishes exactly when the cocycle
does, and a constant nonzero function on a nonempty set is nonzero. -/
lemma H_mk_oneCochain_ne_zero_of (S : SSet.{0}) (h : Nonempty (S.obj (op ⦋0⦌)))
    (hcyc : (1 : Cochain S ℚ 0) ∈ cycles S ℚ 0) :
    H.mk (1 : Cochain S ℚ 0) hcyc ≠ 0 := by
  intro h0
  obtain ⟨σ⟩ := h
  have hb : (1 : Cochain S ℚ 0) ∈ boundaries S ℚ 0 :=
    (Work.Cohomology.Hmk_eq_zero_iff (1 : Cochain S ℚ 0) hcyc).mp h0
  rw [show boundaries S ℚ 0 = ⊥ from rfl, Submodule.mem_bot] at hb
  have := congrFun hb σ
  simp at this

/-- The class of the constant `1`-cochain is nonzero on a simplicial set with a `0`-simplex. -/
lemma H_mk_oneCochain_ne_zero (S : SSet.{0}) (h : Nonempty (S.obj (op ⦋0⦌))) :
    H.mk (1 : Cochain S ℚ 0) (oneCochain_mem_cycles S) ≠ 0 :=
  H_mk_oneCochain_ne_zero_of S h _

/-! ## A nonzero map into a one dimensional space is surjective -/

/-- A nonzero `ℚ`-linear map whose target is isomorphic to `ℚ` is surjective: its range is a
nonzero submodule of a one dimensional space, and every submodule of `ℚ` containing a nonzero
element is everything. -/
lemma surjective_of_ne_zero_equiv_rat {M V : Type*} [AddCommGroup M] [Module ℚ M]
    [AddCommGroup V] [Module ℚ V] (Ψ : V ≃ₗ[ℚ] ℚ) {f : M →ₗ[ℚ] V} (hf : f ≠ 0) :
    Function.Surjective f := by
  have hx0 : ∃ x₀, f x₀ ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hf (LinearMap.ext h)
  obtain ⟨x₀, hx₀⟩ := hx0
  have hΨ : Ψ (f x₀) ≠ 0 := fun h => hx₀ (Ψ.injective (by rw [h, map_zero]))
  intro y
  refine ⟨((Ψ (f x₀))⁻¹ * Ψ y) • x₀, ?_⟩
  apply Ψ.injective
  rw [map_smul, map_smul, smul_eq_mul]
  field_simp

/-! ## `H⁰` of the intersection of the two pieces of the cover -/

/-- The `0`-th cohomology of the intersection `A ⊓ B` of the two pieces of the two-cap cover of
`Sph (n+1)`, for `n ≥ 1`, is one dimensional: the intersection is the doubly punctured sphere,
which is homotopy equivalent to `Sph n`, a path connected space. -/
theorem H_zero_capAsub_inf_capBsub (n : ℕ) [PathConnectedSpace (Submission.Sphere.Sph n)] :
    Nonempty (H (capAsub n ⊓ capBsub n : (smallC n).Subcomplex) ℚ 0 ≃ₗ[ℚ] ℚ) := by
  let e1 : H (capAsub n ⊓ capBsub n : (smallC n).Subcomplex) ℚ 0 ≃ₗ[ℚ]
      H (capCsub n) ℚ 0 := capCIso n 0
  let e2 : H (capCsub n) ℚ 0 ≃ₗ[ℚ] H (singIn (Sph (n+1)) (DPset n)) ℚ 0 := capPrimeIso n 0
  let e3 : H (singIn (Sph (n+1)) (DPset n)) ℚ 0 ≃ₗ[ℚ]
      H (TopCat.toSSet.obj (TopCat.of (DPtype n))) ℚ 0 := dpSpaceIso n 0
  let e4 : H (TopCat.toSSet.obj (TopCat.of (DPtype n))) ℚ 0 ≃ₗ[ℚ] H (singSph n) ℚ 0 :=
    dpSphereIso n 0
  exact ⟨e1.trans (e2.trans (e3.trans (e4.trans
    (Classical.choice (Work.Cohomology.H_zero_connected (Sph n))))))⟩

/-! ## The degree `0` map `mvBetaH` is surjective -/

/-- **The degree `0` `mvBetaH` of the two-cap cover of `S^{n+2}` is surjective.**  The
restriction `H⁰(capAsub) → H⁰(capAsub ⊓ capBsub)` of the class of the constant `1`-cochain is the
class of `1` on the intersection, which is nonzero; since the target is one dimensional, this
restriction is surjective, and `mvBetaH S A B 0 (x, 0) = x|`. -/
theorem mvBetaH_zero_surjective (n : ℕ) :
    Function.Surjective (mvBetaH (smallC (n+1)) (capAsub (n+1)) (capBsub (n+1)) 0) := by
  haveI : PathConnectedSpace (Submission.Sphere.Sph (n+1)) :=
    pathConnected_sph (n+1) (by omega)
  obtain ⟨Ψ⟩ := H_zero_capAsub_inf_capBsub (n+1)
  have hne : (H.map ℚ (SSet.Subcomplex.homOfLE (inf_le_left :
      (capAsub (n+1) ⊓ capBsub (n+1) : (smallC (n+1)).Subcomplex) ≤ capAsub (n+1))) 0)
      (H.mk (1 : Cochain (capAsub (n+1)) ℚ 0) (oneCochain_mem_cycles _)) ≠ 0 := by
    rw [H_map_oneCochain]
    exact H_mk_oneCochain_ne_zero_of _ (nonempty_capAsub_inf_capBsub_zero n) _
  have hsurj : Function.Surjective (H.map ℚ (SSet.Subcomplex.homOfLE (inf_le_left :
      (capAsub (n+1) ⊓ capBsub (n+1) : (smallC (n+1)).Subcomplex) ≤ capAsub (n+1))) 0) :=
    surjective_of_ne_zero_equiv_rat Ψ (fun h => hne (by rw [h]; simp))
  intro y
  obtain ⟨x, hx⟩ := hsurj y
  refine ⟨(x, 0), ?_⟩
  rw [mvBetaH_apply, hx, map_zero, sub_zero]

/-! ## `H¹` of the small complex of the two-cap cover of `S^{n+2}` vanishes -/

/-- The first cohomology of the small complex of the two-cap cover of `S^{n+2}` vanishes. -/
theorem subsingleton_H_one_smallC (n : ℕ) :
    Subsingleton (H (smallC (n+1)) ℚ 1) := by
  have hsubA : Subsingleton (H (capAsub (n+1)) ℚ 1) :=
    subsingleton_H_capAsub (n+1) 1 (by norm_num)
  have hsubB : Subsingleton (H (capBsub (n+1)) ℚ 1) :=
    subsingleton_H_capBsub (n+1) 1 (by norm_num)
  -- the two pieces are acyclic in degree `1`, so `mvAlphaH` vanishes in degree `1`
  have hzero : mvAlphaH (smallC (n+1)) (capAsub (n+1)) (capBsub (n+1)) 1 = 0 :=
    LinearMap.ext fun z => Prod.ext (hsubA.elim _ _) (hsubB.elim _ _)
  have hker : LinearMap.ker (mvAlphaH (smallC (n+1)) (capAsub (n+1))
      (capBsub (n+1)) 1) = ⊤ := by
    rw [hzero, LinearMap.ker_zero]
  -- hence `H¹` is the range of the connecting map of degree `0`, which vanishes
  have hconn : mvConnecting (smallC (n+1)) (capAsub (n+1)) (capBsub (n+1))
      (capAsub_sup_capBsub (n+1)) 0 = 0 := by
    rw [← LinearMap.ker_eq_top, Work.Cohomology.mvConnecting_ker_eq_range]
    exact LinearMap.range_eq_top.mpr (mvBetaH_zero_surjective n)
  refine ⟨fun x y => ?_⟩
  have hxy : x - y ∈ LinearMap.ker (mvAlphaH (smallC (n+1)) (capAsub (n+1))
      (capBsub (n+1)) 1) := by
    rw [hker]; trivial
  rw [Work.Cohomology.mvAlphaH_ker_eq_range (smallC (n+1)) (capAsub (n+1))
    (capBsub (n+1)) (capAsub_sup_capBsub (n+1)) 0, hconn, LinearMap.range_zero,
    Submodule.mem_bot] at hxy
  exact sub_eq_zero.mp hxy

/-! ## The target -/

theorem H_one_sph_succ (n : ℕ) :
    Subsingleton (Submission.Cohomology.H (Submission.Sphere.singSph (n + 2)) ℚ 1) := by
  have hsmall : Subsingleton (H (smallC (n+1)) ℚ 1) := subsingleton_H_one_smallC n
  have e := smallSphereIso (n+1) 1
  have h : Subsingleton (H (singSph ((n+1)+1)) ℚ 1) :=
    ⟨fun x y => by
      have hxy : e.symm x = e.symm y := Subsingleton.elim _ _
      calc x = e (e.symm x) := (e.apply_symm_apply x).symm
        _ = e (e.symm y) := by rw [hxy]
        _ = y := e.apply_symm_apply y⟩
  exact h

end

end Work.Sphere
