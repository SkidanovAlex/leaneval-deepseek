open Matrix

/-- **Bott periodicity on `S²`** (the base case of `ball_K` in dimension two): the reduced group
`K̃(D²/S¹) = K̃(S²)` is infinite cyclic, generated by the Bott class, and the Adams operations act
on it by `ψ² H = 2 H`, `ψ³ H = 3 H`.

Route: `fund_product` with `X = PUnit` gives `K(S²) ≅ ℤ·1 ⊕ ℤ·[hopf]`; the explicit collapse
`D² → S²`, `z ↦ (π·sinc(π‖z‖)·z₀, π·sinc(π‖z‖)·z₁, cos(π‖z‖))` (continuous, surjective, constant
on the unit circle and injective off it) identifies `C(S²,ℂ)` with
`Kpair (EuclideanSpace ℝ (Fin 2))` and carries `hopfIdem` to an explicit idempotent of `Kpair`.
The eigenvalue `ψ² H = 2 H` is the identity `[hopf]² + 1 = 2[hopf]`, i.e. `H ⊗ H ⊕ 1 ≅ H ⊕ H`,
which follows by factoring `H² ⊕ 1 ≅ (H̄ ⊗ H) ⊕ H² ≅ H ⊗ (H̄ ⊕ H) ≅ H ⊗ ℂ² ≅ H ⊕ H` using the
quaternionic structure of `ℂ²` (`J(z,w) = (-w̄, z̄)`, giving `ℂ² ≅ H ⊕ H̄`) and the Hermitian
metric (`H ⊗ H̄ ≅ 1`). -/
theorem ballK_dim2 (y0W : Ball (EuclideanSpace ℝ (Fin 2)))
    (hy0W : y0W ∈ bdry (EuclideanSpace ℝ (Fin 2))) :
    ∃ H : K0 (Kpair (EuclideanSpace ℝ (Fin 2))),
      K0.mapA (augPair (EuclideanSpace ℝ (Fin 2)) y0W) H = 0 ∧
      (∀ k : ℤ, k • H = 0 → k = 0) ∧
      (∀ z, K0.mapA (augPair (EuclideanSpace ℝ (Fin 2)) y0W) z = 0 → ∃ k : ℤ, z = k • H) ∧
      (∀ ψ : K0 (Kpair (EuclideanSpace ℝ (Fin 2))) →+ K0 (Kpair (EuclideanSpace ℝ (Fin 2))),
        IsPsi2 ψ → ψ H = 2 • H) ∧
      (∀ ψ : K0 (Kpair (EuclideanSpace ℝ (Fin 2))) →+ K0 (Kpair (EuclideanSpace ℝ (Fin 2))),
        IsPsi3 ψ → ψ H = 3 • H) :=
  D2.ballK_dim2_aux y0W hy0W
    (Classical.choose (D2.mZero_descent y0W hy0W))
    (Classical.choose_spec (D2.mZero_descent y0W hy0W))

end

end Work.KT
