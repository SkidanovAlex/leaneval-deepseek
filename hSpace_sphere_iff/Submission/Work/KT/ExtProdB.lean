import Mathlib
import Submission.Work.KT.Defs

/-!
# Auxiliaries for the reduced external product (`Work.KT.ext_product`)

This file contains

* small facts about `K₀` as defined in `Submission/Work/KT/Defs.lean`
  (classes of idempotents, block sums, Murray–von Neumann equivalence,
  determination of additive maps on classes of idempotents);
* the wedge algebra `C(S^a ∨ S^b) ≅ C(S^a) ×_ℂ C(S^b)` together with the
  restriction map `prodAlg V W → wedgeAlg` and the identification of the
  fibre of the constants with `Kpair (V × W)`.
-/

namespace Work.KT

open Matrix

noncomputable section

/-! ## Elementary facts about `K₀` -/

section K0Facts

variable {R S : Type} [Ring R] [Ring S]

/-- The basic block-sum relation of `K₀`. -/
lemma ep_rel_block {p q : Mat R} (hp : p.IsIdem) (hq : q.IsIdem) :
    FreeAbelianGroup.of (p.sum q) - FreeAbelianGroup.of p - FreeAbelianGroup.of q ∈ K0Rel R :=
  AddSubgroup.subset_closure (Or.inl (Or.inl ⟨p, q, hp, hq, rfl⟩))

/-- Two matrices whose difference lies in `K0Rel` have the same class. -/
lemma ep_cls_eq_of_sub_mem {p q : Mat R}
    (h : FreeAbelianGroup.of p - FreeAbelianGroup.of q ∈ K0Rel R) : cls p = cls q := by
  rw [cls, cls, QuotientAddGroup.eq_iff_sub_mem]
  exact h

/-- The class of a block sum is the sum of the classes. -/
lemma ep_cls_sum (p q : Mat R) (hp : p.IsIdem) (hq : q.IsIdem) :
    cls (p.sum q) = cls p + cls q := by
  have hmem : FreeAbelianGroup.of (p.sum q)
      - (FreeAbelianGroup.of p + FreeAbelianGroup.of q) ∈ K0Rel R := by
    rw [← sub_sub]
    exact ep_rel_block hp hq
  simp only [cls]
  rw [show (QuotientAddGroup.mk (FreeAbelianGroup.of p) : K0 R)
        + QuotientAddGroup.mk (FreeAbelianGroup.of q)
      = QuotientAddGroup.mk (FreeAbelianGroup.of p + FreeAbelianGroup.of q) from
    (QuotientAddGroup.mk_add _ _ _).symm]
  exact QuotientAddGroup.eq_iff_sub_mem.mpr hmem

/-- Murray–von Neumann equivalent idempotents have the same class. -/
lemma ep_cls_of_mvn (p q : Mat R) (hp : p.IsIdem) (hq : q.IsIdem) (h : p.MvN q) :
    cls p = cls q :=
  ep_cls_eq_of_sub_mem (p := p) (q := q)
    (AddSubgroup.subset_closure (Or.inl (Or.inr ⟨p, q, hp, hq, h, rfl⟩)))

/-- A non-idempotent matrix has zero class. -/
lemma ep_cls_of_not_idem (p : Mat R) (h : ¬ p.IsIdem) : cls p = 0 := by
  rw [cls, QuotientAddGroup.eq_zero_iff]
  exact AddSubgroup.subset_closure (Or.inr ⟨p, h, rfl⟩)

/-- The class of a matrix under a ring homomorphism is given by `mapCls`. -/
lemma ep_map_cls (φ : R →+* S) (p : Mat R) : K0.map φ (cls p) = mapCls φ p := by
  rw [K0.map, cls]
  rw [QuotientAddGroup.lift_mk', FreeAbelianGroup.lift_apply_of]

/-- On idempotents, `K₀` of a ring map is computed entrywise. -/
lemma ep_map_cls_idem (φ : R →+* S) (p : Mat R) (hp : p.IsIdem) :
    K0.map φ (cls p) = cls (p.map φ) := by
  rw [ep_map_cls, mapCls, if_pos hp]

end K0Facts

section Span

variable {R : Type} [Ring R]

/-- Every element of `K₀` is in the subgroup generated by classes of idempotents. -/
lemma ep_mem_closure_cls (x : K0 R) :
    x ∈ AddSubgroup.closure (Set.range fun p : {p : Mat R // p.IsIdem} => cls p.val) := by
  set S : AddSubgroup (K0 R) :=
    AddSubgroup.closure (Set.range fun p : {p : Mat R // p.IsIdem} => cls p.val)
  have hgen : ∀ p : {p : Mat R // p.IsIdem}, cls p.val ∈ S := fun p =>
    AddSubgroup.subset_closure ⟨p, rfl⟩
  have key : ∀ w : FreeAbelianGroup (Mat R), (QuotientAddGroup.mk' (K0Rel R)) w ∈ S := by
    intro w
    induction w using FreeAbelianGroup.induction_on with
    | zero => exact S.zero_mem
    | of p =>
        by_cases hp : p.IsIdem
        · rw [show (QuotientAddGroup.mk' (K0Rel R)) (FreeAbelianGroup.of p) = cls p from rfl]
          exact hgen ⟨p, hp⟩
        · rw [show (QuotientAddGroup.mk' (K0Rel R)) (FreeAbelianGroup.of p) = cls p from rfl,
            ep_cls_of_not_idem p hp]
          exact S.zero_mem
    | neg p ih =>
        rw [map_neg]
        exact S.neg_mem ih
    | add p q ihp ihq =>
        rw [map_add]
        exact S.add_mem ihp ihq
  obtain ⟨w, hw⟩ := QuotientAddGroup.mk_surjective x
  rw [← hw]
  exact key w

/-- Additive maps on `K₀` are determined by their values on classes of idempotents. -/
lemma ep_hom_ext_cls {M : Type} [AddCommGroup M] (f g : K0 R →+ M)
    (h : ∀ p : Mat R, p.IsIdem → f (cls p) = g (cls p)) : f = g := by
  refine AddMonoidHom.ext (fun x => ?_)
  have hx := ep_mem_closure_cls x
  refine AddSubgroup.closure_induction
    (p := fun y _ => f y = g y) (fun z hz => ?_) ?_ (fun a b _ _ iha ihb => ?_)
    (fun a _ iha => ?_) hx
  · obtain ⟨p, rfl⟩ := hz
    exact h p.val p.property
  · simp
  · simp [iha, ihb]
  · simp [iha]

end Span

/-! ## The wedge algebra `C(S^a ∨ S^b)` -/

section Wedge

variable (V W : Type) [NormedAddCommGroup V] [NormedAddCommGroup W]

/-- The point `(x, y)` of the product of the two balls. -/
def ballProd (x : Ball V) (y : Ball W) : Ball (V × W) :=
  ⟨((x : V), (y : W)), by
    rw [mem_closedBall_zero_iff, Prod.norm_def]
    exact max_le (mem_closedBall_zero_iff.mp x.2) (mem_closedBall_zero_iff.mp y.2)⟩

@[simp] lemma ballProd_coe (x : Ball V) (y : Ball W) :
    (ballProd V W x y : V × W) = ((x : V), (y : W)) := rfl

lemma norm_ballProd (x : Ball V) (y : Ball W) :
    ‖(ballProd V W x y : V × W)‖ = max ‖(x : V)‖ ‖(y : W)‖ := Prod.norm_def _

@[simp] lemma prFst_ballProd (x : Ball V) (y : Ball W) :
    prFst V W (ballProd V W x y) = x := Subtype.ext rfl

@[simp] lemma prSnd_ballProd (x : Ball V) (y : Ball W) :
    prSnd V W (ballProd V W x y) = y := Subtype.ext rfl

/-- First coordinate of a point of `D_V × D_W` as a point of `D_V`. -/
def ballFstOf (p : Ball (V × W)) : Ball V :=
  ⟨p.1.1, mem_closedBall_zero_iff.mpr
    ((norm_fst_le (p.1 : V × W)).trans (mem_closedBall_zero_iff.mp p.2))⟩

/-- Second coordinate of a point of `D_V × D_W` as a point of `D_W`. -/
def ballSndOf (p : Ball (V × W)) : Ball W :=
  ⟨p.1.2, mem_closedBall_zero_iff.mpr
    ((norm_snd_le (p.1 : V × W)).trans (mem_closedBall_zero_iff.mp p.2))⟩

@[simp] lemma ballFstOf_coe (p : Ball (V × W)) : (ballFstOf V W p : V) = p.1.1 := rfl

@[simp] lemma ballSndOf_coe (p : Ball (V × W)) : (ballSndOf V W p : W) = p.1.2 := rfl

lemma continuous_ballProdMap (y : Ball W) :
    Continuous fun z : Ball V => ballProd V W z y := by
  apply Continuous.subtype_mk
  fun_prop

lemma continuous_ballProdMap' (x : Ball V) :
    Continuous fun z : Ball W => ballProd V W x z := by
  apply Continuous.subtype_mk
  fun_prop

/-- The continuous map `x ↦ (x, y)`. -/
def ballProdMapFst (y : Ball W) : C(Ball V, Ball (V × W)) where
  toFun := fun x => ballProd V W x y
  continuous_toFun := continuous_ballProdMap V W y

/-- The continuous map `y ↦ (x, y)`. -/
def ballProdMapSnd (x : Ball V) : C(Ball W, Ball (V × W)) where
  toFun := fun y => ballProd V W x y
  continuous_toFun := continuous_ballProdMap' V W x

/-- The wedge `S^a ∨ S^b`, realised as the fibre product `C(S^a) ×_ℂ C(S^b)` over the
augmentations. -/
def wedgeAlg (y0V : Ball V) (y0W : Ball W) : Subalgebra ℂ (Kpair V × Kpair W) where
  carrier := {z | augPair V y0V z.1 = augPair W y0W z.2}
  mul_mem' := by
    rintro z z' hz hz'
    have hz1 : augPair V y0V z.1 = augPair W y0W z.2 := hz
    have hz1' : augPair V y0V z'.1 = augPair W y0W z'.2 := hz'
    show augPair V y0V (z.1 * z'.1) = augPair W y0W (z.2 * z'.2)
    rw [map_mul, map_mul, hz1, hz1']
  add_mem' := by
    rintro z z' hz hz'
    have hz1 : augPair V y0V z.1 = augPair W y0W z.2 := hz
    have hz1' : augPair V y0V z'.1 = augPair W y0W z'.2 := hz'
    show augPair V y0V (z.1 + z'.1) = augPair W y0W (z.2 + z'.2)
    rw [map_add, map_add, hz1, hz1']
  algebraMap_mem' := by
    intro c
    show augPair V y0V (algebraMap ℂ (Kpair V × Kpair W) c).1
      = augPair W y0W (algebraMap ℂ (Kpair V × Kpair W) c).2
    rw [show (algebraMap ℂ (Kpair V × Kpair W) c).1 = algebraMap ℂ (Kpair V) c from rfl]
    rw [show (algebraMap ℂ (Kpair V × Kpair W) c).2 = algebraMap ℂ (Kpair W) c from rfl]
    simp

/-- Pull back a function on `D_V × D_W` along `x ↦ (x, y)`. -/
def prodSliceFst (y0W : Ball W) : prodAlg V W →ₐ[ℂ] C(Ball V, ℂ) :=
  (pullAlg (ballProdMapFst V W y0W)).comp (prodAlg V W).val

/-- Pull back a function on `D_V × D_W` along `y ↦ (x, y)`. -/
def prodSliceSnd (y0V : Ball V) : prodAlg V W →ₐ[ℂ] C(Ball W, ℂ) :=
  (pullAlg (ballProdMapSnd V W y0V)).comp (prodAlg V W).val

/-- First component of the restriction to the wedge (a function on `D_V`). -/
def wedgeFst (y0W : Ball W) : prodAlg V W →ₐ[ℂ] Kpair V :=
  AlgHom.codRestrict (prodSliceFst V W y0W) (Kpair V) (by
    intro F x hx x' hx'
    exact (F.2).1 (ballProd V W x y0W) (ballProd V W x' y0W) hx hx' rfl)

/-- Second component of the restriction to the wedge (a function on `D_W`). -/
def wedgeSnd (y0V : Ball V) : prodAlg V W →ₐ[ℂ] Kpair W :=
  AlgHom.codRestrict (prodSliceSnd V W y0V) (Kpair W) (by
    intro F y hy y' hy'
    exact (F.2).2 (ballProd V W y0V y) (ballProd V W y0V y') hy hy' rfl)

/-- Restriction `C(S^a × S^b) → C(S^a ∨ S^b)`. -/
def wedgeProj (y0V : Ball V) (y0W : Ball W) : prodAlg V W →ₐ[ℂ] wedgeAlg V W y0V y0W :=
  AlgHom.codRestrict (AlgHom.prod (wedgeFst V W y0W) (wedgeSnd V W y0V))
    (wedgeAlg V W y0V y0W) (by
      intro F
      show augPair V y0V (wedgeFst V W y0W F) = augPair W y0W (wedgeSnd V W y0V F)
      rfl)

@[simp] lemma wedgeProj_val (y0V : Ball V) (y0W : Ball W) (F : prodAlg V W) :
    (wedgeProj V W y0V y0W F).1 = (wedgeFst V W y0W F, wedgeSnd V W y0V F) := rfl

/-- First projection of the fibre product. -/
def wedgePr₁ (y0V : Ball V) (y0W : Ball W) : wedgeAlg V W y0V y0W →ₐ[ℂ] Kpair V :=
  (AlgHom.fst ℂ (Kpair V) (Kpair W)).comp (wedgeAlg V W y0V y0W).val

/-- Second projection of the fibre product. -/
def wedgePr₂ (y0V : Ball V) (y0W : Ball W) : wedgeAlg V W y0V y0W →ₐ[ℂ] Kpair W :=
  (AlgHom.snd ℂ (Kpair V) (Kpair W)).comp (wedgeAlg V W y0V y0W).val

@[simp] lemma wedgePr₁_apply (y0V : Ball V) (y0W : Ball W) (z : wedgeAlg V W y0V y0W) :
    wedgePr₁ V W y0V y0W z = z.1.1 := rfl

@[simp] lemma wedgePr₂_apply (y0V : Ball V) (y0W : Ball W) (z : wedgeAlg V W y0V y0W) :
    wedgePr₂ V W y0V y0W z = z.1.2 := rfl

/-- The compatibility satisfied by elements of the fibre product. -/
lemma wedgePr₁_aug (y0V : Ball V) (y0W : Ball W) (z : wedgeAlg V W y0V y0W) :
    augPair V y0V (wedgePr₁ V W y0V y0W z) = augPair W y0W (wedgePr₂ V W y0V y0W z) :=
  z.2

end Wedge

/-! ## Surjectivity of the restriction to the wedge -/

section WedgeSurj

variable (V W : Type) [NormedAddCommGroup V] [NormedAddCommGroup W]

theorem wedgeProj_exists (y0V : Ball V) (y0W : Ball W) (g : Kpair V) (h : Kpair W)
    (hab : augPair V y0V g = augPair W y0W h) :
    ∃ F : prodAlg V W, wedgeProj V W y0V y0W F = ⟨(g, h), hab⟩ := by
  have hab' : (g : C(Ball V, ℂ)) y0V = (h : C(Ball W, ℂ)) y0W := hab
  refine ⟨⟨(pullAlg (prFst V W)) (g : C(Ball V, ℂ))
      + (pullAlg (prSnd V W)) (h : C(Ball W, ℂ))
      - ContinuousMap.const _ ((g : C(Ball V, ℂ)) y0V), ?_, ?_⟩, ?_⟩
  · rintro z z' h1 h2 h3
    have hz : prSnd V W z = prSnd V W z' := Subtype.ext h3
    have hg : (g : C(Ball V, ℂ)) (prFst V W z) = (g : C(Ball V, ℂ)) (prFst V W z') :=
      (g.2) (prFst V W z) h1 (prFst V W z') h2
    simp only [ContinuousMap.add_apply, ContinuousMap.sub_apply, ContinuousMap.const_apply,
      ContinuousMap.comp_apply, pullAlg, StarAlgHom.coe_toAlgHom,
      ContinuousMap.compStarAlgHom'_apply]
    rw [hz, hg]
  · rintro z z' h1 h2 h3
    have hz : prFst V W z = prFst V W z' := Subtype.ext h3
    have hh : (h : C(Ball W, ℂ)) (prSnd V W z) = (h : C(Ball W, ℂ)) (prSnd V W z') :=
      (h.2) (prSnd V W z) h1 (prSnd V W z') h2
    simp only [ContinuousMap.add_apply, ContinuousMap.sub_apply, ContinuousMap.const_apply,
      ContinuousMap.comp_apply, pullAlg, StarAlgHom.coe_toAlgHom,
      ContinuousMap.compStarAlgHom'_apply]
    rw [hz, hh]
  · refine Subtype.ext (Prod.ext ?_ ?_)
    · apply Subtype.ext
      apply ContinuousMap.ext
      intro x
      show (pullAlg (prFst V W)) (g : C(Ball V, ℂ)) (ballProd V W x y0W)
        + (pullAlg (prSnd V W)) (h : C(Ball W, ℂ)) (ballProd V W x y0W)
        - ContinuousMap.const _ ((g : C(Ball V, ℂ)) y0V) (ballProd V W x y0W)
        = (g : C(Ball V, ℂ)) x
      simp only [ContinuousMap.add_apply, ContinuousMap.sub_apply, ContinuousMap.const_apply,
        ContinuousMap.comp_apply, pullAlg, StarAlgHom.coe_toAlgHom,
        ContinuousMap.compStarAlgHom'_apply, ballProd_coe, prFst_ballProd, prSnd_ballProd]
      rw [← hab']
      ring
    · apply Subtype.ext
      apply ContinuousMap.ext
      intro y
      show (pullAlg (prFst V W)) (g : C(Ball V, ℂ)) (ballProd V W y0V y)
        + (pullAlg (prSnd V W)) (h : C(Ball W, ℂ)) (ballProd V W y0V y)
        - ContinuousMap.const _ ((g : C(Ball V, ℂ)) y0V) (ballProd V W y0V y)
        = (h : C(Ball W, ℂ)) y
      simp only [ContinuousMap.add_apply, ContinuousMap.sub_apply, ContinuousMap.const_apply,
        ContinuousMap.comp_apply, pullAlg, StarAlgHom.coe_toAlgHom,
        ContinuousMap.compStarAlgHom'_apply, ballProd_coe, prFst_ballProd,
        prSnd_ballProd]
      ring

theorem wedgeProj_surjective (y0V : Ball V) (y0W : Ball W) :
    Function.Surjective (wedgeProj V W y0V y0W) := by
  rintro ⟨⟨g, h⟩, hab⟩
  exact wedgeProj_exists V W y0V y0W g h hab

end WedgeSurj

/-! ## The restriction of functions on the product and the smash inclusion -/

section Smash

variable (V W : Type) [NormedAddCommGroup V] [NormedAddCommGroup W]

lemma wedgeFst_smashIncl (y0W : Ball W) (hW : y0W ∈ bdry W)
    (y0 : Ball (V × W)) (hy0 : y0 ∈ bdry (V × W)) (g : Kpair (V × W)) :
    wedgeFst V W y0W (smashIncl V W g) = algebraMap ℂ (Kpair V) (augPair (V × W) y0 g) := by
  apply Subtype.ext
  apply ContinuousMap.ext
  intro x
  have hx : ‖(x : V)‖ ≤ 1 := mem_closedBall_zero_iff.mp x.2
  have hbd : ballProd V W x y0W ∈ bdry (V × W) := by
    show ‖(ballProd V W x y0W : V × W)‖ = 1
    rw [norm_ballProd, hW, max_eq_right hx]
  show (smashIncl V W g : C(Ball (V × W), ℂ)) (ballProd V W x y0W)
    = (algebraMap ℂ (Kpair V) (augPair (V × W) y0 g) : C(Ball V, ℂ)) x
  rw [show (smashIncl V W g : C(Ball (V × W), ℂ)) = (g : C(Ball (V × W), ℂ)) from rfl]
  rw [show (algebraMap ℂ (Kpair V) (augPair (V × W) y0 g) : C(Ball V, ℂ))
      = ContinuousMap.const (Ball V) (augPair (V × W) y0 g) from rfl]
  rw [ContinuousMap.const_apply]
  exact (g.2) (ballProd V W x y0W) hbd y0 hy0

lemma wedgeSnd_smashIncl (y0V : Ball V) (hV : y0V ∈ bdry V)
    (y0 : Ball (V × W)) (hy0 : y0 ∈ bdry (V × W)) (g : Kpair (V × W)) :
    wedgeSnd V W y0V (smashIncl V W g) = algebraMap ℂ (Kpair W) (augPair (V × W) y0 g) := by
  apply Subtype.ext
  apply ContinuousMap.ext
  intro y
  have hy : ‖(y : W)‖ ≤ 1 := mem_closedBall_zero_iff.mp y.2
  have hbd : ballProd V W y0V y ∈ bdry (V × W) := by
    show ‖(ballProd V W y0V y : V × W)‖ = 1
    rw [norm_ballProd, hV, max_eq_left hy]
  show (smashIncl V W g : C(Ball (V × W), ℂ)) (ballProd V W y0V y)
    = (algebraMap ℂ (Kpair W) (augPair (V × W) y0 g) : C(Ball W, ℂ)) y
  rw [show (smashIncl V W g : C(Ball (V × W), ℂ)) = (g : C(Ball (V × W), ℂ)) from rfl]
  rw [show (algebraMap ℂ (Kpair W) (augPair (V × W) y0 g) : C(Ball W, ℂ))
      = ContinuousMap.const (Ball W) (augPair (V × W) y0 g) from rfl]
  rw [ContinuousMap.const_apply]
  exact (g.2) (ballProd V W y0V y) hbd y0 hy0

theorem wedgeProj_smashIncl (y0V : Ball V) (hV : y0V ∈ bdry V) (y0W : Ball W) (hW : y0W ∈ bdry W)
    (y0 : Ball (V × W)) (hy0 : y0 ∈ bdry (V × W)) (g : Kpair (V × W)) :
    wedgeProj V W y0V y0W (smashIncl V W g) = algebraMap ℂ (wedgeAlg V W y0V y0W) (augPair (V × W) y0 g) := by
  apply Subtype.ext
  apply Prod.ext
  · show wedgeFst V W y0W (smashIncl V W g) = algebraMap ℂ (Kpair V) (augPair (V × W) y0 g)
    exact wedgeFst_smashIncl V W y0W hW y0 hy0 g
  · show wedgeSnd V W y0V (smashIncl V W g) = algebraMap ℂ (Kpair W) (augPair (V × W) y0 g)
    exact wedgeSnd_smashIncl V W y0V hV y0 hy0 g

lemma smashIncl_injective : Function.Injective (smashIncl V W) := by
  intro a b hab
  refine Subtype.ext ?_
  show ((smashIncl V W a : prodAlg V W) : C(Ball (V × W), ℂ))
      = ((smashIncl V W b : prodAlg V W) : C(Ball (V × W), ℂ))
  rw [hab]

/-- The fibre of the constants of the restriction to the wedge is exactly the image of the
smash inclusion. -/
theorem mem_range_smashIncl_iff (y0V : Ball V) (hV : y0V ∈ bdry V)
    (y0W : Ball W) (hW : y0W ∈ bdry W) (y0 : Ball (V × W)) (hy0 : y0 ∈ bdry (V × W))
    (F : prodAlg V W) :
    F ∈ (smashIncl V W).range ↔
      ∃ c : ℂ, wedgeProj V W y0V y0W F = algebraMap ℂ (wedgeAlg V W y0V y0W) c := by
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨augPair (V × W) y0 g, wedgeProj_smashIncl V W y0V hV y0W hW y0 hy0 g⟩
  · rintro ⟨c, hc⟩
    have hF1 : wedgeFst V W y0W F = algebraMap ℂ (Kpair V) c := by
      have h := congrArg (fun z : wedgeAlg V W y0V y0W => z.1.1) hc
      simpa using h
    have hF2 : wedgeSnd V W y0V F = algebraMap ℂ (Kpair W) c := by
      have h := congrArg (fun z : wedgeAlg V W y0V y0W => z.1.2) hc
      simpa using h
    have hcol : ∀ x : Ball V, (F : C(Ball (V × W), ℂ)) (ballProd V W x y0W) = c := by
      intro x
      have h := congrArg (fun u : Kpair V => ((u : C(Ball V, ℂ)) x)) hF1
      rw [show ((wedgeFst V W y0W F : Kpair V) : C(Ball V, ℂ)) x
          = (F : C(Ball (V × W), ℂ)) (ballProd V W x y0W) from rfl] at h
      exact h
    have hrow : ∀ y : Ball W, (F : C(Ball (V × W), ℂ)) (ballProd V W y0V y) = c := by
      intro y
      have h := congrArg (fun u : Kpair W => ((u : C(Ball W, ℂ)) y)) hF2
      rw [show ((wedgeSnd V W y0V F : Kpair W) : C(Ball W, ℂ)) y
          = (F : C(Ball (V × W), ℂ)) (ballProd V W y0V y) from rfl] at h
      exact h
    refine ⟨⟨(F : C(Ball (V × W), ℂ)), ?_⟩, ?_⟩
    · intro z hz z' hz'
      have key : ∀ p : Ball (V × W), p ∈ bdry (V × W) →
          (F : C(Ball (V × W), ℂ)) p = c := by
        intro p hp
        have hp' : ‖(p : V × W)‖ = 1 := hp
        rw [Prod.norm_def] at hp'
        rcases max_eq_iff.mp hp' with ⟨h1, -⟩ | ⟨h2, -⟩
        · have hFx : (F : C(Ball (V × W), ℂ)) p
              = (F : C(Ball (V × W), ℂ)) (ballProd V W y0V (ballSndOf V W p)) :=
            (F.2).1 p (ballProd V W y0V (ballSndOf V W p)) h1 hV rfl
          rw [hFx, hrow (ballSndOf V W p)]
        · have hFy : (F : C(Ball (V × W), ℂ)) p
              = (F : C(Ball (V × W), ℂ)) (ballProd V W (ballFstOf V W p) y0W) :=
            (F.2).2 p (ballProd V W (ballFstOf V W p) y0W) h2 hW rfl
          rw [hFy, hcol (ballFstOf V W p)]
      rw [key z hz, key z' hz']
    · show ((smashIncl V W) ⟨(F : C(Ball (V × W), ℂ)), _⟩ : prodAlg V W) = F
      apply Subtype.ext
      rfl

end Smash

/-! ## The two inclusions of the wedge and the fibre of the constants -/

section Incl

variable (V W : Type) [NormedAddCommGroup V] [NormedAddCommGroup W]

/-- The first inclusion `C(S^a) → C(S^a ∨ S^b)`. -/
def wedgeIncl₁ (y0V : Ball V) (y0W : Ball W) : Kpair V →ₐ[ℂ] wedgeAlg V W y0V y0W :=
  (wedgeProj V W y0V y0W).comp (pullFst V W)

/-- The second inclusion `C(S^b) → C(S^a ∨ S^b)`. -/
def wedgeIncl₂ (y0V : Ball V) (y0W : Ball W) : Kpair W →ₐ[ℂ] wedgeAlg V W y0V y0W :=
  (wedgeProj V W y0V y0W).comp (pullSnd V W)

lemma wedgeFst_pullFst (y0W : Ball W) (g : Kpair V) :
    wedgeFst V W y0W (pullFst V W g) = g := by
  apply Subtype.ext
  apply ContinuousMap.ext
  intro x
  show (prodSliceFst V W y0W (pullFst V W g)) x = (g : C(Ball V, ℂ)) x
  rw [show (prodSliceFst V W y0W (pullFst V W g)) x
      = (pullFst V W g : C(Ball (V × W), ℂ)) (ballProd V W x y0W) from rfl]
  rw [show (pullFst V W g : C(Ball (V × W), ℂ)) (ballProd V W x y0W)
      = (g : C(Ball V, ℂ)) (prFst V W (ballProd V W x y0W)) from rfl]
  rw [prFst_ballProd]

lemma wedgeSnd_pullSnd (y0V : Ball V) (g : Kpair W) :
    wedgeSnd V W y0V (pullSnd V W g) = g := by
  apply Subtype.ext
  apply ContinuousMap.ext
  intro y
  show (prodSliceSnd V W y0V (pullSnd V W g)) y = (g : C(Ball W, ℂ)) y
  rw [show (prodSliceSnd V W y0V (pullSnd V W g)) y
      = (pullSnd V W g : C(Ball (V × W), ℂ)) (ballProd V W y0V y) from rfl]
  rw [show (pullSnd V W g : C(Ball (V × W), ℂ)) (ballProd V W y0V y)
      = (g : C(Ball W, ℂ)) (prSnd V W (ballProd V W y0V y)) from rfl]
  rw [prSnd_ballProd]

lemma wedgeSnd_pullFst (y0V : Ball V) (y0W : Ball W) (g : Kpair V) :
    wedgeSnd V W y0V (pullFst V W g) = algebraMap ℂ (Kpair W) (augPair V y0V g) := by
  apply Subtype.ext
  apply ContinuousMap.ext
  intro y
  show (prodSliceSnd V W y0V (pullFst V W g)) y
    = (algebraMap ℂ (Kpair W) (augPair V y0V g) : C(Ball W, ℂ)) y
  rw [show (prodSliceSnd V W y0V (pullFst V W g)) y
      = (pullFst V W g : C(Ball (V × W), ℂ)) (ballProd V W y0V y) from rfl]
  rw [show (pullFst V W g : C(Ball (V × W), ℂ)) (ballProd V W y0V y)
      = (g : C(Ball V, ℂ)) (prFst V W (ballProd V W y0V y)) from rfl]
  rw [prFst_ballProd]
  rfl

lemma wedgeFst_pullSnd (y0V : Ball V) (y0W : Ball W) (g : Kpair W) :
    wedgeFst V W y0W (pullSnd V W g) = algebraMap ℂ (Kpair V) (augPair W y0W g) := by
  apply Subtype.ext
  apply ContinuousMap.ext
  intro x
  show (prodSliceFst V W y0W (pullSnd V W g)) x
    = (algebraMap ℂ (Kpair V) (augPair W y0W g) : C(Ball V, ℂ)) x
  rw [show (prodSliceFst V W y0W (pullSnd V W g)) x
      = (pullSnd V W g : C(Ball (V × W), ℂ)) (ballProd V W x y0W) from rfl]
  rw [show (pullSnd V W g : C(Ball (V × W), ℂ)) (ballProd V W x y0W)
      = (g : C(Ball W, ℂ)) (prSnd V W (ballProd V W x y0W)) from rfl]
  rw [prSnd_ballProd]
  rfl

theorem wedgePr₁_comp_incl₁ (y0V : Ball V) (y0W : Ball W) :
    (wedgePr₁ V W y0V y0W).comp (wedgeIncl₁ V W y0V y0W) = AlgHom.id ℂ (Kpair V) := by
  apply AlgHom.ext
  intro g
  exact wedgeFst_pullFst V W y0W g

theorem wedgePr₂_comp_incl₂ (y0V : Ball V) (y0W : Ball W) :
    (wedgePr₂ V W y0V y0W).comp (wedgeIncl₂ V W y0V y0W) = AlgHom.id ℂ (Kpair W) := by
  apply AlgHom.ext
  intro g
  exact wedgeSnd_pullSnd V W y0V g

theorem wedgePr₂_comp_incl₁ (y0V : Ball V) (y0W : Ball W) :
    (wedgePr₂ V W y0V y0W).comp (wedgeIncl₁ V W y0V y0W)
      = (Algebra.ofId ℂ (Kpair W)).comp (augPair V y0V) := by
  apply AlgHom.ext
  intro g
  exact wedgeSnd_pullFst V W y0V y0W g

theorem wedgePr₁_comp_incl₂ (y0V : Ball V) (y0W : Ball W) :
    (wedgePr₁ V W y0V y0W).comp (wedgeIncl₂ V W y0V y0W)
      = (Algebra.ofId ℂ (Kpair V)).comp (augPair W y0W) := by
  apply AlgHom.ext
  intro g
  exact wedgeFst_pullSnd V W y0V y0W g

lemma wedgePr₁_surjective (y0V : Ball V) (y0W : Ball W) :
    Function.Surjective (wedgePr₁ V W y0V y0W) := by
  intro g
  refine ⟨wedgeIncl₁ V W y0V y0W g, ?_⟩
  have h := congrArg (fun f : Kpair V →ₐ[ℂ] Kpair V => f g) (wedgePr₁_comp_incl₁ V W y0V y0W)
  simpa using h

/-- The fibre of the constants of the first projection: `C(S^a) × ℂ ⊆ C(S^a ∨ S^b)`. -/
def wedgeC (y0V : Ball V) (y0W : Ball W) : Subalgebra ℂ (wedgeAlg V W y0V y0W) where
  carrier := {z | ∃ c : ℂ, wedgePr₁ V W y0V y0W z = algebraMap ℂ (Kpair V) c}
  mul_mem' := by
    rintro z z' ⟨c, hc⟩ ⟨c', hc'⟩
    exact ⟨c * c', by simp only [map_mul, hc, hc']⟩
  add_mem' := by
    rintro z z' ⟨c, hc⟩ ⟨c', hc'⟩
    exact ⟨c + c', by simp only [map_add, hc, hc']⟩
  algebraMap_mem' := by
    intro c
    exact ⟨c, by simp⟩

/-- The second projection restricted to `wedgeC`, an isomorphism onto `C(S^b)`. -/
def wedgeCpr₂ (y0V : Ball V) (y0W : Ball W) : wedgeC V W y0V y0W →ₐ[ℂ] Kpair W :=
  (wedgePr₂ V W y0V y0W).comp (wedgeC V W y0V y0W).val

/-- Its inverse. -/
def wedgeCincl (y0V : Ball V) (y0W : Ball W) : Kpair W →ₐ[ℂ] wedgeC V W y0V y0W :=
  AlgHom.codRestrict
    (AlgHom.codRestrict
      (AlgHom.prod ((Algebra.ofId ℂ (Kpair V)).comp (augPair W y0W)) (AlgHom.id ℂ (Kpair W)))
      (wedgeAlg V W y0V y0W) (by
        intro h
        show augPair V y0V (algebraMap ℂ (Kpair V) (augPair W y0W h))
          = augPair W y0W ((AlgHom.id ℂ (Kpair W)) h)
        simp))
    (wedgeC V W y0V y0W) (by
      intro h
      refine ⟨augPair W y0W h, ?_⟩
      show wedgePr₁ V W y0V y0W _ = algebraMap ℂ (Kpair V) (augPair W y0W h)
      rfl)

theorem wedgeCpr₂_comp_incl (y0V : Ball V) (y0W : Ball W) :
    (wedgeCpr₂ V W y0V y0W).comp (wedgeCincl V W y0V y0W) = AlgHom.id ℂ (Kpair W) := by
  apply AlgHom.ext
  intro h
  rfl

theorem wedgeCincl_comp_cpr₂ (y0V : Ball V) (y0W : Ball W) :
    (wedgeCincl V W y0V y0W).comp (wedgeCpr₂ V W y0V y0W) = AlgHom.id ℂ (wedgeC V W y0V y0W) := by
  apply AlgHom.ext
  intro u
  obtain ⟨c, hc⟩ := u.2
  apply Subtype.ext
  apply Subtype.ext
  apply Prod.ext
  · show algebraMap ℂ (Kpair V) (augPair W y0W (wedgePr₂ V W y0V y0W u))
      = wedgePr₁ V W y0V y0W u
    rw [← wedgePr₁_aug V W y0V y0W u, hc]
    simp
  · rfl

/-- Augmentation of the fibre of the constants: evaluation on the second factor. -/
def wedgeCε (y0V : Ball V) (y0W : Ball W) : wedgeC V W y0V y0W →ₐ[ℂ] ℂ :=
  (augPair W y0W).comp (wedgeCpr₂ V W y0V y0W)

lemma wedgeC_eps_prop (y0V : Ball V) (y0W : Ball W) (u : wedgeC V W y0V y0W) :
    wedgePr₁ V W y0V y0W u = algebraMap ℂ (Kpair V) (wedgeCε V W y0V y0W u) := by
  obtain ⟨c, hc⟩ := u.2
  rw [hc]
  show algebraMap ℂ (Kpair V) c
    = algebraMap ℂ (Kpair V) (augPair W y0W (wedgePr₂ V W y0V y0W u))
  rw [← wedgePr₁_aug V W y0V y0W u, hc]
  simp

end Incl

end

