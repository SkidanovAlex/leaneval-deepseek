import Mathlib
import Submission.Work.KT.Defs
import Submission.Work.KT.Psi.Basic

/-!
# `Work.KT.Psi.OrbitBasic` — free orbits and the spectral projector of a cyclic action

Let `M` be a `ℂ`-algebra (in the applications `M` is the matrix ring `Matrix (Fin N) (Fin N) A`
for a commutative `A`), `g : M` an element of order dividing `k`, and `λ : ℂ` a `k`-th root of
unity.  We write

* `qg lam g = λ⁻¹ • g`,
* `geoSum lam g k = 1 + q + q² + … + q^{k-1}` (a geometric series, `q = qg lam g`),
* `orbitSpec lam g k = k⁻¹ • geoSum lam g k` (the spectral projector of the cyclic action `g`
  onto the `λ`-eigenspace, written in the "unreduced" product form; the statement form of the
  main lemma writes it as `k⁻¹ • Σ_j (λ⁻¹)^j • g^j`),
* `orbSum g F k = Σ_{i<k} g^i · F · g^{k-i}` (the orbit sum of `F`; if `g` is unitary and the
  conjugates `g^i F g^{-i}` are pairwise orthogonal this is the projection onto their sum).

Mathematically: `q^k = 1`, hence `geoSum` is `(1 - q)⁻¹(1 - q^k)` in the appropriate sense and
`geoSum · q = geoSum` by telescoping (`Finset.sum_range_sub`).  Then
`geoSum · geoSum = k · geoSum`, so `orbitSpec` is idempotent, and `g` acts on `orbitSpec` by `λ`
on either side.
-/

namespace Work.KT.Psi

open Matrix Finset

noncomputable section

variable {M : Type} [Ring M] [Algebra ℂ M]

/-- `λ⁻¹ • g`: the `λ`-twisted generator. -/
def qg (lam : ℂ) (g : M) : M := lam⁻¹ • g

/-- The geometric sum `1 + q + … + q^{k-1}` for `q = qg lam g`. -/
def geoSum (lam : ℂ) (g : M) (k : ℕ) : M := ∑ j ∈ Finset.range k, qg lam g ^ j

/-- The spectral projector of the cyclic action generated by `g`, in product form. -/
def orbitSpec (lam : ℂ) (g : M) (k : ℕ) : M := ((k : ℂ)⁻¹) • geoSum lam g k

/-- The orbit sum `Σ_{i<k} g^i · F · g^{k-i}`. -/
def orbSum (g F : M) (k : ℕ) : M := ∑ i ∈ Finset.range k, g ^ i * F * g ^ (k - i)

/-! ## The geometric sum -/

lemma qg_pow (lam : ℂ) (g : M) (j : ℕ) : qg lam g ^ j = (lam⁻¹) ^ j • g ^ j := by
  rw [qg, smul_pow]

lemma qg_pow_eq_one {lam : ℂ} {g : M} {k : ℕ} (hg : g ^ k = 1) (hlam : lam ^ k = 1) :
    qg lam g ^ k = 1 := by
  rw [qg_pow, hg, inv_pow, hlam, inv_one, one_smul]

/-- Telescoping: `geoSum · (q - 1) = q^k - 1`. -/
lemma geoSum_mul_sub (lam : ℂ) (g : M) (k : ℕ) :
    geoSum lam g k * (qg lam g - 1) = qg lam g ^ k - 1 := by
  have h : ∀ j : ℕ, qg lam g ^ j * (qg lam g - 1) = qg lam g ^ (j + 1) - qg lam g ^ j := by
    intro j; rw [mul_sub, mul_one, ← pow_succ]
  rw [geoSum, Finset.sum_mul]
  simp only [h]
  rw [Finset.sum_range_sub, pow_zero]

/-- Telescoping: `(q - 1) · geoSum = q^k - 1`. -/
lemma sub_mul_geoSum (lam : ℂ) (g : M) (k : ℕ) :
    (qg lam g - 1) * geoSum lam g k = qg lam g ^ k - 1 := by
  have h : ∀ j : ℕ, (qg lam g - 1) * qg lam g ^ j = qg lam g ^ (j + 1) - qg lam g ^ j := by
    intro j; rw [sub_mul, one_mul, ← pow_succ']
  rw [geoSum, Finset.mul_sum]
  simp only [h]
  rw [Finset.sum_range_sub, pow_zero]

lemma geoSum_mul_qg {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) :
    geoSum lam g k * qg lam g = geoSum lam g k := by
  have h0 := geoSum_mul_sub lam g k
  rw [h, sub_self] at h0
  have h1 : geoSum lam g k * qg lam g - geoSum lam g k * 1 = 0 := by
    rw [← mul_sub]; exact h0
  simpa using sub_eq_zero.mp h1

lemma qg_mul_geoSum {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) :
    qg lam g * geoSum lam g k = geoSum lam g k := by
  have h0 := sub_mul_geoSum lam g k
  rw [h, sub_self] at h0
  have h1 : qg lam g * geoSum lam g k - 1 * geoSum lam g k = 0 := by
    rw [← sub_mul]; exact h0
  simpa using sub_eq_zero.mp h1

lemma pow_mul_geoSum {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) (j : ℕ) :
    qg lam g ^ j * geoSum lam g k = geoSum lam g k := by
  induction j with
  | zero => rw [pow_zero, one_mul]
  | succ j ih => rw [pow_succ, mul_assoc, qg_mul_geoSum h, ih]

lemma geoSum_mul_pow {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) (j : ℕ) :
    geoSum lam g k * qg lam g ^ j = geoSum lam g k := by
  induction j with
  | zero => rw [pow_zero, mul_one]
  | succ j ih => rw [pow_succ, ← mul_assoc, ih, geoSum_mul_qg h]

lemma geoSum_sq {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) :
    geoSum lam g k * geoSum lam g k = algebraMap ℂ M (k : ℂ) * geoSum lam g k := by
  have h2 : ∀ j : ℕ, qg lam g ^ j * geoSum lam g k = geoSum lam g k := pow_mul_geoSum h
  have key : (∑ i ∈ Finset.range k, qg lam g ^ i) * geoSum lam g k =
      algebraMap ℂ M (k : ℂ) * geoSum lam g k := by
    rw [Finset.sum_mul]
    rw [Finset.sum_congr rfl (fun i _ => h2 i)]
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, map_natCast]
  exact key

/-- `λ` is invertible as soon as `λ^k = 1` with `k > 0`. -/
lemma ne_zero_of_pow_eq_one {lam : ℂ} {k : ℕ} (hk : 0 < k) (hlam : lam ^ k = 1) : lam ≠ 0 :=
  fun hc => by rw [hc, zero_pow hk.ne'] at hlam; exact zero_ne_one hlam

lemma g_eq_smul_qg {lam : ℂ} {g : M} {k : ℕ} (hk : 0 < k) (hlam : lam ^ k = 1) :
    g = lam • qg lam g := by
  rw [qg, smul_smul, mul_inv_cancel₀ (ne_zero_of_pow_eq_one hk hlam), one_smul]

/-! ## The spectral projector -/

lemma orbitSpec_idem {lam : ℂ} {g : M} {k : ℕ} (hk : 0 < k) (h : qg lam g ^ k = 1) :
    orbitSpec lam g k * orbitSpec lam g k = orbitSpec lam g k := by
  have hne : (k : ℂ) ≠ 0 := by exact_mod_cast Nat.pos_iff_ne_zero.mp hk
  have hkk : ((k : ℂ)⁻¹) * ((k : ℂ)⁻¹) * (k : ℂ) = ((k : ℂ)⁻¹) := by
    rw [mul_assoc, inv_mul_cancel₀ hne, mul_one]
  simp only [orbitSpec]
  rw [smul_mul_assoc, mul_smul_comm ((k : ℂ)⁻¹) (geoSum lam g k) (geoSum lam g k), smul_smul,
    geoSum_sq h, ← Algebra.smul_def (k : ℂ) (geoSum lam g k), smul_smul, hkk]

lemma orbitSpec_mul_qg {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) :
    orbitSpec lam g k * qg lam g = orbitSpec lam g k := by
  rw [orbitSpec, smul_mul_assoc ((k : ℂ)⁻¹) (geoSum lam g k) (qg lam g), geoSum_mul_qg h,
    ← orbitSpec]

lemma qg_mul_orbitSpec {lam : ℂ} {g : M} {k : ℕ} (h : qg lam g ^ k = 1) :
    qg lam g * orbitSpec lam g k = orbitSpec lam g k := by
  rw [orbitSpec, mul_smul_comm ((k : ℂ)⁻¹) (qg lam g) (geoSum lam g k), qg_mul_geoSum h,
    ← orbitSpec]

/-- `g` acts on the spectral projector by `λ` on the right. -/
lemma orbitSpec_mul_g {lam : ℂ} {g : M} {k : ℕ} (hk : 0 < k) (hlam : lam ^ k = 1)
    (h : qg lam g ^ k = 1) :
    orbitSpec lam g k * g = algebraMap ℂ M lam * orbitSpec lam g k := by
  calc orbitSpec lam g k * g = orbitSpec lam g k * (lam • qg lam g) :=
        congrArg (fun x => orbitSpec lam g k * x) (g_eq_smul_qg hk hlam)
    _ = lam • (orbitSpec lam g k * qg lam g) := by
        rw [mul_smul_comm lam (orbitSpec lam g k) (qg lam g)]
    _ = lam • orbitSpec lam g k := by rw [orbitSpec_mul_qg h]
    _ = algebraMap ℂ M lam * orbitSpec lam g k := by rw [Algebra.smul_def]

/-- `g` acts on the spectral projector by `λ` on the left. -/
lemma g_mul_orbitSpec {lam : ℂ} {g : M} {k : ℕ} (hk : 0 < k) (hlam : lam ^ k = 1)
    (h : qg lam g ^ k = 1) :
    g * orbitSpec lam g k = algebraMap ℂ M lam * orbitSpec lam g k := by
  calc g * orbitSpec lam g k = (lam • qg lam g) * orbitSpec lam g k :=
        congrArg (fun x => x * orbitSpec lam g k) (g_eq_smul_qg hk hlam)
    _ = lam • (qg lam g * orbitSpec lam g k) := by
        rw [smul_mul_assoc lam (qg lam g) (orbitSpec lam g k)]
    _ = lam • orbitSpec lam g k := by rw [qg_mul_orbitSpec h]
    _ = algebraMap ℂ M lam * orbitSpec lam g k := by rw [Algebra.smul_def]

lemma orbitSpec_mul_g_pow {lam : ℂ} {g : M} {k : ℕ} (hk : 0 < k) (hlam : lam ^ k = 1)
    (h : qg lam g ^ k = 1) (m : ℕ) :
    orbitSpec lam g k * g ^ m = algebraMap ℂ M (lam ^ m) * orbitSpec lam g k := by
  induction m with
  | zero => rw [pow_zero, mul_one, pow_zero, map_one, one_mul]
  | succ m ih =>
      rw [pow_succ, ← mul_assoc, ih, mul_assoc, orbitSpec_mul_g hk hlam h, ← mul_assoc, ← map_mul,
        pow_succ]

lemma g_pow_mul_orbitSpec {lam : ℂ} {g : M} {k : ℕ} (hk : 0 < k) (hlam : lam ^ k = 1)
    (h : qg lam g ^ k = 1) (m : ℕ) :
    g ^ m * orbitSpec lam g k = algebraMap ℂ M (lam ^ m) * orbitSpec lam g k := by
  induction m with
  | zero => rw [pow_zero, one_mul, pow_zero, map_one, one_mul]
  | succ m ih =>
      rw [pow_succ', mul_assoc, ih, ← mul_assoc, ← Algebra.commutes (lam ^ m) g, mul_assoc,
        g_mul_orbitSpec hk hlam h, ← mul_assoc, ← map_mul, pow_succ]

/-- The spectral projector commutes with everything that commutes with `g`. -/
lemma orbitSpec_comm_of {lam : ℂ} {g X : M} {k : ℕ} (h : g * X = X * g) :
    orbitSpec lam g k * X = X * orbitSpec lam g k := by
  have hq : qg lam g * X = X * qg lam g := by
    rw [qg, smul_mul_assoc, h, ← mul_smul_comm]
  have hpow : ∀ j : ℕ, qg lam g ^ j * X = X * qg lam g ^ j := by
    intro j
    induction j with
    | zero => rw [pow_zero, one_mul, mul_one]
    | succ j ih => rw [pow_succ, mul_assoc, hq, ← mul_assoc, ih, mul_assoc]
  have key : geoSum lam g k * X = X * geoSum lam g k := by
    rw [geoSum, Finset.sum_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun j _ => hpow j)
  rw [orbitSpec, smul_mul_assoc ((k : ℂ)⁻¹) (geoSum lam g k) X,
    mul_smul_comm ((k : ℂ)⁻¹) X (geoSum lam g k), key]

end

end Work.KT.Psi
