import Mathlib
import Submission.Work.KT.Defs
import Submission.Work.KT.Fund.Laurent
import Submission.Work.KT.Fund.Segment
import Submission.Work.KT.Fund.laurent_dense

namespace Work.KT.Fund

open Matrix

noncomputable section

/-- Every invertible matrix over `C(X × S¹, ℂ)` (`X` compact Hausdorff, `S¹ = Sph ℂ`) is homotopic through invertible matrices to the image of a matrix `P` of Laurent polynomials with coefficients in `C(X, ℂ)` whose image under `laurentMap` is again invertible.  Route: the Laurent polynomials are dense (Stone–Weierstrass for the star-subalgebra generated by the pullbacks along `X × S¹ → X`, by `z` and by `z̄ = z⁻¹`); approximate `u` entrywise by `P.map (laurentMap X)` with error `< 1/‖u⁻¹‖`; then `P.map (laurentMap X)` is a unit, and `(1-t) u + t · P.map (laurentMap X)` is invertible for all `t ∈ [0,1]` (Neumann series for `u⁻¹` times the error).  Note: `P` itself need not be a unit of the Laurent polynomial ring. -/
theorem laurent_approx (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] (n : ℕ)
    (u : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ)) (hu : IsUnit u) :
    ∃ P : Matrix (Fin n) (Fin n) (LaurentPolynomial C(X, ℂ)),
      IsUnit (P.map (laurentMap X)) ∧
      ∃ H : Matrix (Fin n) (Fin n) C((X × Sph ℂ) × unitInterval, ℂ),
        IsUnit H ∧
        (∀ (i j : Fin n) (x : X) (s : Sph ℂ), H i j ((x, s), 0) = u i j (x, s)) ∧
        (∀ (i j : Fin n) (x : X) (s : Sph ℂ),
          H i j ((x, s), 1) = P.map (laurentMap X) i j (x, s)) := by
  classical
  set w : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ) := (hu.unit⁻¹).val with hwdef
  set M : NNReal := mNorm n w with hMdef
  set δ : NNReal := (M + 1)⁻¹ * ((n : NNReal) + 1)⁻¹ with hδdef
  have hδpos : (0 : ℝ) < (δ : ℝ) := by
    have h : (0 : NNReal) < δ := by rw [hδdef]; positivity
    exact_mod_cast h
  -- approximate `u` entrywise by a Laurent polynomial matrix
  have happrox : ∀ i j : Fin n, ∃ p : LaurentPolynomial C(X, ℂ),
      ‖u i j - laurentMap X p‖ < (δ : ℝ) :=
    fun i j => laurent_dense X (u i j) (δ : ℝ) hδpos
  obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin n) (Fin n) (LaurentPolynomial C(X, ℂ)),
      ∀ i j : Fin n, ‖u i j - laurentMap X (P i j)‖ < (δ : ℝ) :=
    ⟨fun i j => Classical.choose (happrox i j),
      fun i j => Classical.choose_spec (happrox i j)⟩
  set V : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ) := P.map (laurentMap X) with hVdef
  -- the error is small in the `ℓ∞` operator norm
  have hbound : mNorm n (u - V) ≤ (M + 1)⁻¹ := by
    refine Finset.sup_le fun i _ => ?_
    have h1 : ∀ j : Fin n, ‖(u - V) i j‖₊ ≤ δ := by
      intro j
      rw [← NNReal.coe_le_coe, hVdef]
      simpa [Matrix.sub_apply, coe_nnnorm, Matrix.map_apply] using (hP i j).le
    have h2 : (n : NNReal) * ((n : NNReal) + 1)⁻¹ ≤ 1 := by
      calc (n : NNReal) * ((n : NNReal) + 1)⁻¹
          ≤ ((n : NNReal) + 1) * ((n : NNReal) + 1)⁻¹ := by gcongr; exact le_add_of_nonneg_right (by positivity)
        _ = 1 := mul_inv_cancel₀ (by positivity)
    calc ∑ j, ‖(u - V) i j‖₊ ≤ ∑ j, δ := Finset.sum_le_sum fun j _ => h1 j
      _ = (n : NNReal) * δ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ = (M + 1)⁻¹ * ((n : NNReal) * ((n : NNReal) + 1)⁻¹) := by rw [hδdef]; ring
      _ ≤ (M + 1)⁻¹ * 1 := by gcongr
      _ = (M + 1)⁻¹ := mul_one _
  have hlt : mNorm n (u - V) * M < 1 := by
    have hM1 : M * (M + 1)⁻¹ < 1 := by
      rw [← div_eq_mul_inv, div_lt_one (by positivity)]
      exact lt_add_one M
    calc mNorm n (u - V) * M ≤ (M + 1)⁻¹ * M := by gcongr
      _ = M * (M + 1)⁻¹ := by ring
      _ < 1 := hM1
  have hV_unit : IsUnit V := by
    refine isUnit_of_mNorm_sub_lt_one hu ?_
    rw [← hwdef, ← hMdef]
    exact hlt
  have hH_unit : IsUnit (seg u V) := by
    refine isUnit_seg u V hu ?_
    rw [← hwdef, ← hMdef]
    exact hlt
  exact ⟨P, hVdef ▸ hV_unit, seg u V, hH_unit,
    fun i j x s => seg_apply_zero u V i j (x, s),
    fun i j x s => by rw [seg_apply_one, hVdef]⟩

end

end Work.KT.Fund
