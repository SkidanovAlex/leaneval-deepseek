import Mathlib
import Submission.Work.KT.Defs
import Submission.Work.KT.Fund.Laurent

/-!
# `Work.KT.Fund.laurent_dense` — Laurent polynomials are dense in `C(X × S¹, ℂ)`

For `X` compact Hausdorff, the image of `laurentMap X : C(X,ℂ)[T;T⁻¹] → C(X × S¹, ℂ)` is dense
for the sup norm.  The proof uses complex Stone–Weierstrass on the star subalgebra generated by
the pullbacks along `X × S¹ → X`, by `z` and by `z̄ = z⁻¹`; every element of that star subalgebra
already lies in the image of `laurentMap X`.
-/

namespace Work.KT.Fund

noncomputable section

variable (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X]

/-- The Laurent polynomials with coefficients in `C(X, ℂ)` (coefficients pulled back along the
projection `X × S¹ → X`, `T` specialised at the coordinate `z` of `S¹`) are dense in
`C(X × S¹, ℂ)` for the sup norm. -/
theorem laurent_dense (f : C(X × Sph ℂ, ℂ)) (ε : ℝ) (hε : 0 < ε) :
    ∃ p : LaurentPolynomial C(X, ℂ), ‖f - laurentMap X p‖ < ε := by
  classical
  set z : C(X × Sph ℂ, ℂ) := (zUnit X : C(X × Sph ℂ, ℂ)) with hz
  set zinv : C(X × Sph ℂ, ℂ) :=
    (((zUnit X)⁻¹ : (C(X × Sph ℂ, ℂ))ˣ) : C(X × Sph ℂ, ℂ)) with hzinv
  set G : Set C(X × Sph ℂ, ℂ) :=
    Set.range (pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X))) ∪ {z} ∪ {zinv} with hG
  set A : StarSubalgebra ℂ C(X × Sph ℂ, ℂ) := StarAlgebra.adjoin ℂ G with hA
  have hnorm : ∀ s : Sph ℂ, ‖((s : ℂ))‖ = 1 := fun s => mem_sphere_zero_iff_norm.mp s.2
  have hpull : ∀ (a : C(X, ℂ)) (y : X × Sph ℂ),
      pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X)) a y = a y.1 := by
    intro a y; simp [pullAlg]
  have hstar_pull : ∀ a : C(X, ℂ),
      star (pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X)) a)
        = pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X)) (star a) :=
    fun a => (map_star
      (ContinuousMap.compStarAlgHom' ℂ ℂ (ContinuousMap.fst : C(X × Sph ℂ, X))) a).symm
  have hstar_z : star z = zinv := by
    rw [hz, hzinv]
    ext y
    rw [ContinuousMap.star_apply, zUnit_apply]
    rw [show (((zUnit X)⁻¹ : (C(X × Sph ℂ, ℂ))ˣ) : C(X × Sph ℂ, ℂ)) y
        = (((y.2 : Sph ℂ) : ℂ))⁻¹ from rfl]
    rw [RCLike.star_def]
    exact (RCLike.inv_eq_conj (K := ℂ) (hnorm y.2)).symm
  have hmem_gen : ∀ x ∈ G, x ∈ Set.range (laurentMap X) ∧ star x ∈ Set.range (laurentMap X) := by
    intro x hx
    rw [hG] at hx
    simp only [Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx
    rcases hx with (⟨a, rfl⟩ | rfl) | rfl
    · exact ⟨⟨LaurentPolynomial.C a, by rw [laurentMap_C]⟩,
        ⟨LaurentPolynomial.C (star a), by rw [laurentMap_C, hstar_pull]⟩⟩
    · exact ⟨⟨LaurentPolynomial.T 1, by rw [laurentMap_T, hz, zpow_one]⟩,
        ⟨LaurentPolynomial.T (-1), by rw [hstar_z, laurentMap_T, zpow_neg_one, hzinv]⟩⟩
    · exact ⟨⟨LaurentPolynomial.T (-1), by rw [laurentMap_T, zpow_neg_one, hzinv]⟩,
        ⟨LaurentPolynomial.T 1, by rw [← hstar_z, star_star, laurentMap_T, zpow_one, hz]⟩⟩
  have hA_le : ∀ x ∈ A, x ∈ Set.range (laurentMap X) ∧ star x ∈ Set.range (laurentMap X) := by
    intro x hx
    rw [hA] at hx
    refine StarAlgebra.adjoin_induction (mem := fun y hy => hmem_gen y hy)
      (algebraMap := fun r => ?_) (add := fun y y' _ _ ihy ihy' => ?_)
      (mul := fun y y' _ _ ihy ihy' => ?_) (star := fun y _ ihy => ?_) hx
    · refine ⟨⟨LaurentPolynomial.C (ContinuousMap.const X r), ?_⟩,
        ⟨LaurentPolynomial.C (ContinuousMap.const X (star r)), ?_⟩⟩
      · rw [laurentMap_C]; ext y; simp [pullAlg]
      · rw [laurentMap_C]; ext y; simp [pullAlg]
    · obtain ⟨⟨p, hp⟩, ⟨p', hp'⟩⟩ := ihy
      obtain ⟨⟨q, hq⟩, ⟨q', hq'⟩⟩ := ihy'
      exact ⟨⟨p + q, by rw [map_add, hp, hq]⟩,
        ⟨p' + q', by rw [map_add, star_add, ← hp', ← hq']⟩⟩
    · obtain ⟨⟨p, hp⟩, ⟨p', hp'⟩⟩ := ihy
      obtain ⟨⟨q, hq⟩, ⟨q', hq'⟩⟩ := ihy'
      refine ⟨⟨p * q, by rw [map_mul, hp, hq]⟩, ⟨p' * q', ?_⟩⟩
      rw [map_mul, star_mul, ← hq', ← hp']
      exact mul_comm _ _
    · exact ⟨ihy.2, by rw [star_star]; exact ihy.1⟩
  have hsub : (A : Set C(X × Sph ℂ, ℂ)) ⊆ Set.range (laurentMap X) := fun x hx => (hA_le x hx).1
  have hsep : A.SeparatesPoints := by
    intro y₁ y₂ hy
    obtain ⟨x₁, s₁⟩ := y₁
    obtain ⟨x₂, s₂⟩ := y₂
    by_cases hx : x₁ = x₂
    · subst hx
      have hs : s₁ ≠ s₂ := fun h => hy (by rw [h])
      refine ⟨⇑z, ⟨z, ?_, rfl⟩, ?_⟩
      · rw [hA]; exact StarAlgebra.subset_adjoin ℂ G (by rw [hG]; simp)
      · rw [hz]; simp only [zUnit_apply]
        exact fun h => hs (Subtype.ext h)
    · obtain ⟨g, hg1, hg2, -⟩ :=
        exists_continuous_zero_one_of_isClosed (isClosed_singleton : IsClosed ({x₁} : Set X))
          (isClosed_singleton : IsClosed ({x₂} : Set X))
          (Set.disjoint_singleton.mpr hx)
      let a : C(X, ℂ) := ⟨fun x => (g x : ℂ), Complex.continuous_ofReal.comp g.continuous⟩
      refine ⟨⇑(pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X)) a), ⟨_, ?_, rfl⟩, ?_⟩
      · rw [hA]
        exact StarAlgebra.subset_adjoin ℂ G (by
          rw [hG]; exact Or.inl (Or.inl ⟨a, rfl⟩))
      · intro h
        rw [hpull, hpull] at h
        have h1 : g x₁ = 0 := hg1 (by simp)
        have h2 : g x₂ = 1 := hg2 (by simp)
        change a x₁ = a x₂ at h
        simp only [a, ContinuousMap.coe_mk] at h
        rw [h1, h2] at h
        norm_num at h
  have htop : A.topologicalClosure = ⊤ :=
    ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints A hsep
  have hcl : closure (A : Set C(X × Sph ℂ, ℂ)) = ⊤ := by
    rw [← StarSubalgebra.topologicalClosure_coe A, htop]; rfl
  have hmem : f ∈ closure (Set.range (laurentMap X)) :=
    closure_mono hsub (by rw [hcl]; exact Set.mem_univ f)
  obtain ⟨g, hg, hgd⟩ := Metric.mem_closure_iff.mp hmem ε hε
  obtain ⟨p, rfl⟩ := hg
  exact ⟨p, by simpa [dist_eq_norm] using hgd⟩

end

end Work.KT.Fund
