/-!
# `Work.KT.EG.kappaRedDefs` — the vocabulary of the clutching reduction `kappa_reduce`

The target of `Submission/Work/KT/EG/kappa_reduce.lean` is Hatcher's reduction (D) of
`Submission/Work/KT/Fund/NOTES_kappa.md`:

  `κ(u) - [1_n] = μ (s b) (γ - [1])`  for some `b : K0 C(X, ℂ)`,

where `κ` is the clutched class `Work.KT.Fund.kappa`, `s = fst*` is the pull-back along
`X × S² → X` and `γ = snd* (cls hopfIdem)`.

This file collects the notation and the elementary consequences of the definitions that the
ingredients of the reduction share:

* `redK X n u = κ(u) - [1_n]`, the reduced clutched class;
* `bottZ X = κ(z) - [1]`, the Bott class generated by the coordinate unit `z`;
* `fstStar X`, `gammaHopf X`, `betaHopf X = gammaHopf X - [1]` (the class called `β` in the
  target statement);
* `polyMap X : C(X)[T] → C(X × S¹, ℂ)`, evaluation of a *polynomial* in the coordinate `z`
  (the Laurent version is `Work.KT.laurentMap`).
-/

namespace Work.KT.EG

open _root_.Matrix

set_option linter.unusedSectionVars false

noncomputable section

variable (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X]

/-- The **reduced clutched class** of a unit `u` over `C(X × S¹, ℂ)`: `κ(u) - [1_n]`. -/
def redK (n : ℕ) (u : (Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ))ˣ) : K0 C(X × S2, ℂ) :=
  Work.KT.Fund.kappa X n u - cls (Mat.one C(X × S2, ℂ) n)

/-- The **Bott class in the clutching model**: `κ(z) - [1]`, where `z` is the coordinate unit of
the circle. -/
def bottZ : K0 C(X × S2, ℂ) := redK X 1 (Work.KT.Fund.zUnitMat X)

/-- The pull-back `s := fst* : K(X) → K(X × S²)`. -/
def fstStar : K0 C(X, ℂ) →+ K0 C(X × S2, ℂ) :=
  K0.mapA (A := C(X, ℂ)) (B := C(X × S2, ℂ)) (pullAlg (ContinuousMap.fst : C(X × S2, X)))

/-- `γ := snd* (cls hopfIdem)`, the Hopf class over `X × S²`. -/
def gammaHopf : K0 C(X × S2, ℂ) :=
  K0.mapA (A := C(S2, ℂ)) (B := C(X × S2, ℂ))
    (pullAlg (ContinuousMap.snd : C(X × S2, S2))) (cls hopfIdem)

/-- `β := γ - [1]`, the Bott class appearing in the statement of `kappa_reduce`. -/
def betaHopf : K0 C(X × S2, ℂ) := gammaHopf X - cls (Mat.one C(X × S2, ℂ) 1)

/-- The `ℂ`-algebra map `C(X)[T] → C(X × S¹, ℂ)` sending `T` to the coordinate unit `z` (the
polynomial analogue of `Work.KT.laurentMap`). -/
def polyMap : Polynomial C(X, ℂ) →+* C(X × Sph ℂ, ℂ) :=
  Polynomial.eval₂RingHom (pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X))).toRingHom (zUnit X)

variable {X}

@[simp] lemma polyMap_C (a : C(X, ℂ)) :
    polyMap X (Polynomial.C a) =
      pullAlg (ContinuousMap.fst : C(X × Sph ℂ, X)) a :=
  Polynomial.eval₂_C _ _

@[simp] lemma polyMap_X : polyMap X Polynomial.X = (zUnit X : C(X × Sph ℂ, ℂ)) :=
  Polynomial.eval₂_X _ _

/-- `Work.KT.laurentMap` of `Polynomial.toLaurent` is `polyMap`. -/
lemma laurentMap_toLaurent (q : Polynomial C(X, ℂ)) :
    laurentMap X (Polynomial.toLaurent q) = polyMap X q := by
  have h : (laurentMap X).comp (Polynomial.toLaurent (R := C(X, ℂ))) = polyMap X := by
    refine Polynomial.ringHom_ext (fun a => ?_) ?_
    · rw [RingHom.comp_apply, Polynomial.toLaurent_C, Work.KT.laurentMap_C, polyMap_C]
    · rw [RingHom.comp_apply, Polynomial.toLaurent_X, Work.KT.laurentMap_T, polyMap_X,
        zpow_one]
  exact congrFun (congrArg DFunLike.coe h) q

section Basic

variable (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X]

/-- `redK` of the trivial unit vanishes. -/
@[simp] lemma redK_one (n : ℕ) :
    redK X n (1 : (Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ))ˣ) = 0 := by
  rw [redK, Work.KT.Fund.kappa_one X n, sub_self]

/-- `[1_{n+k}] = [1_n] + [1_k]` in `K₀`. -/
lemma cls_one_add (R : Type) [Ring R] (n k : ℕ) :
    cls (Mat.one R (n + k)) = cls (Mat.one R n) + cls (Mat.one R k) := by
  rw [← Work.KT.Mat.one_sum R n k,
    cls_sum (Work.KT.Mat.one_idem R n) (Work.KT.Mat.one_idem R k)]

/-- **Additivity of `redK` over block sums.** -/
lemma redK_add {n k : ℕ}
    (u : (Matrix (Fin (n + k)) (Fin (n + k)) C(X × Sph ℂ, ℂ))ˣ)
    (u₁ : (Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ))ˣ)
    (u₂ : (Matrix (Fin k) (Fin k) C(X × Sph ℂ, ℂ))ˣ)
    (h : (u : Matrix (Fin (n + k)) (Fin (n + k)) C(X × Sph ℂ, ℂ))
      = Matrix.reindex finSumFinEquiv finSumFinEquiv
          (Matrix.fromBlocks (u₁ : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ)) 0 0
            (u₂ : Matrix (Fin k) (Fin k) C(X × Sph ℂ, ℂ)))) :
    redK X (n + k) u = redK X n u₁ + redK X k u₂ := by
  rw [redK, redK, redK, Work.KT.Fund.kappa_add X n k u u₁ u₂ h,
    cls_one_add (C(X × S2, ℂ)) n k]
  abel

/-- `s` sends the class of the trivial bundle to the class of the trivial bundle. -/
lemma fstStar_cls_one (n : ℕ) :
    fstStar X (cls (Mat.one C(X, ℂ) n)) = cls (Mat.one C(X × S2, ℂ) n) := by
  unfold fstStar
  rw [Work.KT.K0.map_cls _ (Work.KT.Mat.one_idem C(X, ℂ) n)]
  congr 1
  unfold Mat.map Mat.one
  rw [Matrix.map_one _ (map_zero _) (map_one _)]

end Basic

section Product

variable {A : Type} [Ring A]

/-- Two products with the defining property of the `K₀`-product agree. -/
theorem IsK0Mul.eq_of {μ μ0 : K0 A →+ K0 A →+ K0 A}
    (hμ : IsK0Mul μ) (hμ0 : IsK0Mul μ0) : μ = μ0 := by
  have hgen : ∀ p q : Mat A, p.IsIdem → q.IsIdem →
      μ (cls p) (cls q) = μ0 (cls p) (cls q) :=
    fun p q hp hq => by rw [hμ p q, hμ0 p q, mulCls_of_idem hp hq]
  have hinner : ∀ x : K0 A, ∀ q : Mat A, q.IsIdem → μ x (cls q) = μ0 x (cls q) := by
    intro x q hq
    have h : AddMonoidHom.flip μ (cls q) = AddMonoidHom.flip μ0 (cls q) := by
      refine k0_ext_cls fun p => ?_
      by_cases hp : p.IsIdem
      · simpa only [AddMonoidHom.flip_apply] using hgen p q hp hq
      · simp only [AddMonoidHom.flip_apply, cls_eq_zero_of_not_idem p hp, map_zero]
    exact congrFun (congrArg DFunLike.coe h) x
  refine AddMonoidHom.ext fun x => k0_ext_cls fun q => ?_
  by_cases hq : q.IsIdem
  · exact hinner x q hq
  · rw [cls_eq_zero_of_not_idem q hq, map_zero, map_zero]

/-- Two products with the defining property of the `K₀`-product agree. -/
theorem IsK0Mul.eq (hcomm : ∀ x y : A, x * y = y * x)
    {μ μ' : K0 A →+ K0 A →+ K0 A} (hμ : IsK0Mul μ) (hμ' : IsK0Mul μ') : μ = μ' := by
  obtain ⟨μ0, hμ0, -, -, -⟩ := Work.KT.k0_basic.1 A hcomm
  rw [IsK0Mul.eq_of hμ hμ0, IsK0Mul.eq_of hμ' hμ0]

/-- The right unit law for a product with the defining property of the `K₀`-product. -/
theorem IsK0Mul.one_right (hcomm : ∀ x y : A, x * y = y * x)
    {μ : K0 A →+ K0 A →+ K0 A} (hμ : IsK0Mul μ) (x : K0 A) :
    μ x (cls (Mat.one A 1)) = x := by
  obtain ⟨μ0, hμ0, hcomm0, -, hunit0⟩ := Work.KT.k0_basic.1 A hcomm
  rw [IsK0Mul.eq hcomm hμ hμ0, hcomm0 x (cls (Mat.one A 1)), hunit0 x]

end Product

section Bott

variable (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X]

/-- Multiplication with the Bott class `β` in the `μ`-product: `μ a β = μ a γ - a`. -/
lemma mu_betaHopf {μ : K0 C(X × S2, ℂ) →+ K0 C(X × S2, ℂ) →+ K0 C(X × S2, ℂ)}
    (hμ : IsK0Mul μ) (a : K0 C(X × S2, ℂ)) :
    μ a (betaHopf X) = μ a (gammaHopf X) - a := by
  rw [betaHopf, map_sub,
    IsK0Mul.one_right (fun x y : C(X × S2, ℂ) => mul_comm x y) hμ a]

/-- The left unit law for a product with the defining property of the `K₀`-product. -/
theorem IsK0Mul.one_left {A : Type} [Ring A] (hcomm : ∀ x y : A, x * y = y * x)
    {μ : K0 A →+ K0 A →+ K0 A} (hμ : IsK0Mul μ) (x : K0 A) :
    μ (cls (Mat.one A 1)) x = x := by
  obtain ⟨μ0, hμ0, -, -, hunit0⟩ := Work.KT.k0_basic.1 A hcomm
  rw [IsK0Mul.eq hcomm hμ hμ0, hunit0 x]

end Bott

section Transport

variable (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X]

/-- The swap `((x,t),z) ↦ ((x,z),t)` of the two factors of `(X × I) × S¹`. -/
def swapCm : C((X × unitInterval) × Sph ℂ, (X × Sph ℂ) × unitInterval) where
  toFun p := ((p.1.1, p.2), p.1.2)
  continuous_toFun := by fun_prop

/-- Pull-back of functions on `(X × S¹) × I` along the swap to `(X × I) × S¹`. -/
def swapHom : C((X × Sph ℂ) × unitInterval, ℂ) →+* C((X × unitInterval) × Sph ℂ, ℂ) :=
  (pullAlg (swapCm X)).toRingHom

@[simp] lemma swapHom_apply (f : C((X × Sph ℂ) × unitInterval, ℂ))
    (p : (X × unitInterval) × Sph ℂ) : swapHom X f p = f ((p.1.1, p.2), p.1.2) := rfl

/-- **Homotopy invariance of `κ` in the shape produced by `Fund.laurent_approx`.**  The
approximating homotopy of `Work.KT.Fund.laurent_approx` lives on `(X × S¹) × I`, while
`Work.KT.Fund.kappa_homotopic` wants a unit over `C((X × I) × S¹, ℂ)`; this transports it along the
swap and phrases the two end slices by their entries. -/
theorem kappa_homotopic_transport (n : ℕ)
    (u v : (Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ))ˣ)
    (H : Matrix (Fin n) (Fin n) C((X × Sph ℂ) × unitInterval, ℂ)) (hH : IsUnit H)
    (h0 : ∀ (i j : Fin n) (x : X) (s : Sph ℂ), H i j ((x, s), 0) = u i j (x, s))
    (h1 : ∀ (i j : Fin n) (x : X) (s : Sph ℂ), H i j ((x, s), 1) = v i j (x, s)) :
    Work.KT.Fund.kappa X n u = Work.KT.Fund.kappa X n v := by
  let H' : (Matrix (Fin n) (Fin n) C((X × unitInterval) × Sph ℂ, ℂ))ˣ :=
    { val := H.map (swapHom X)
      inv := ((hH.unit⁻¹ : (Matrix (Fin n) (Fin n) C((X × Sph ℂ) × unitInterval, ℂ))ˣ) :
          Matrix (Fin n) (Fin n) C((X × Sph ℂ) × unitInterval, ℂ)).map (swapHom X)
      val_inv := by
        rw [← Matrix.map_mul, hH.mul_val_inv, Matrix.map_one _ (map_zero _) (map_one _)]
      inv_val := by
        rw [← Matrix.map_mul, hH.val_inv_mul, Matrix.map_one _ (map_zero _) (map_one _)] }
  refine Work.KT.Fund.kappa_homotopic X n u v H' ?_ ?_
  · ext i j : 1
    refine ContinuousMap.ext fun p => ?_
    show H i j ((p.1, p.2), 0) = u i j p
    exact h0 i j p.1 p.2
  · ext i j : 1
    refine ContinuousMap.ext fun p => ?_
    show H i j ((p.1, p.2), 1) = v i j p
    exact h1 i j p.1 p.2

end Transport

end

end Work.KT.EG
