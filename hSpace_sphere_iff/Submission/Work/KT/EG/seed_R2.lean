import Mathlib
import Submission.Work.KT.Defs
import Submission.Work.KT.K0map.map_comp
import Submission.Work.KT.K0map.map_id
import Submission.Work.KT.ExtGen.pairIso_of_linearEquiv
import Submission.Work.KT.ballK_dim2

/-!
# The reduced `K`-theory of `S²` is infinite cyclic

`Work.KT.EG.seed_R2`: the base case of Bott periodicity in dimension two,
`K̃(D_{R2}/S_{R2}) = ℤ`, generated by the Bott class.  This is the *seed* of the dimension
induction of `Work.KT.ball_K` that `Work.KT.ext_generator` consumes.

Route.  The dimension-two base case is available for the model disc algebra `Kpair ℝ²`
(`Work.KT.ballK_dim2`, itself assembled from the elementary invariants of `Work.KT.D2`: the
rank and the winding number `D2.mZero`, so it does not use the fundamental product).  The target
is the statement for `Kpair R2 = C(D_{R2}/S_{R2})`, and the two are related by the
change-of-norm algebra isomorphism `ExtGen.pairIsoEV ExtGen.r2LinEquiv` of the unit balls of
`R2 = ℝ × ℝ` (sup norm) and `ℝ²` (Euclidean norm) — the radial normalisation `phiBall` maps
`bdry R2` onto `bdry ℝ²`.  The generator data (reduced, of infinite order, generating the reduced
group) is transported along that isomorphism by `transport_seed`, using the augmentation
compatibility `ExtGen.pairIsoEV_aug` and base-point independence of the augmentation on the
boundary.

The statement must not be changed: it is exactly `Submission.Work.KT.ext_generator`'s `Seed`.
-/

namespace Work.KT.EG

open Work.KT

noncomputable section

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 1600000

/-! ## Functoriality of `K₀` on classes -/

lemma mapA_comp {A B C : Type} [Ring A] [Ring B] [Ring C]
    [Algebra ℂ A] [Algebra ℂ B] [Algebra ℂ C] (φ : A →ₐ[ℂ] B) (ψ : B →ₐ[ℂ] C) :
    K0.mapA (ψ.comp φ) = (K0.mapA ψ).comp (K0.mapA φ) := by
  have h : (ψ.comp φ).toRingHom = ψ.toRingHom.comp φ.toRingHom := rfl
  rw [K0.mapA, K0.mapA, K0.mapA, h, K0map.map_comp]

lemma mapA_id {A : Type} [Ring A] [Algebra ℂ A] :
    K0.mapA (AlgHom.id ℂ A) = AddMonoidHom.id (K0 A) :=
  K0map.map_id A

lemma mapA_comp_apply {A B C : Type} [Ring A] [Ring B] [Ring C]
    [Algebra ℂ A] [Algebra ℂ B] [Algebra ℂ C] (φ : A →ₐ[ℂ] B) (ψ : B →ₐ[ℂ] C)
    (x : K0 A) : K0.mapA ψ (K0.mapA φ x) = K0.mapA (ψ.comp φ) x := by
  rw [mapA_comp φ ψ]; rfl

lemma mapA_id_apply {A : Type} [Ring A] [Algebra ℂ A] (x : K0 A) :
    K0.mapA (AlgHom.id ℂ A) x = x := by rw [mapA_id]; rfl

lemma mapA_of_leftInv {A B : Type} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (φ : A →ₐ[ℂ] B) (ψ : B →ₐ[ℂ] A) (h : ψ.comp φ = AlgHom.id ℂ A) (x : K0 A) :
    K0.mapA ψ (K0.mapA φ x) = x := by rw [mapA_comp_apply φ ψ x, h, mapA_id_apply]

lemma mapA_of_rightInv {A B : Type} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (φ : A →ₐ[ℂ] B) (ψ : B →ₐ[ℂ] A) (h : φ.comp ψ = AlgHom.id ℂ B) (y : K0 B) :
    K0.mapA φ (K0.mapA ψ y) = y := by rw [mapA_comp_apply ψ φ y, h, mapA_id_apply]

/-! ## Transport of the generator data along an augmentation-compatible algebra isomorphism -/

/-- Reversed augmentation compatibility: if `εB ∘ E = εA` then `εA ∘ E⁻¹ = εB`. -/
lemma aug_symm {A B : Type} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (E : A ≃ₐ[ℂ] B) (εA : A →ₐ[ℂ] ℂ) (εB : B →ₐ[ℂ] ℂ)
    (h : εB.comp E.toAlgHom = εA) : εA.comp E.symm.toAlgHom = εB := by
  have ht : E.toAlgHom.comp E.symm.toAlgHom = AlgHom.id ℂ B := by
    apply AlgHom.ext; intro x; exact E.apply_symm_apply x
  rw [← h, AlgHom.comp_assoc, ht, AlgHom.comp_id]

/-- The generator data of the reduced group transports along an augmentation-compatible algebra
isomorphism. -/
lemma transport_seed {A B : Type} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (E : A ≃ₐ[ℂ] B) (εA : A →ₐ[ℂ] ℂ) (εB : B →ₐ[ℂ] ℂ) (hε : εB.comp E.toAlgHom = εA)
    {g : K0 A} (hgred : K0.mapA εA g = 0) (hginf : ∀ n : ℤ, n • g = 0 → n = 0)
    (hggen : ∀ z, K0.mapA εA z = 0 → ∃ n : ℤ, z = n • g) :
    ∃ g' : K0 B, K0.mapA εB g' = 0 ∧ (∀ n : ℤ, n • g' = 0 → n = 0) ∧
      (∀ z, K0.mapA εB z = 0 → ∃ n : ℤ, z = n • g') := by
  have hs : E.symm.toAlgHom.comp E.toAlgHom = AlgHom.id ℂ A := by
    apply AlgHom.ext; intro x; exact E.symm_apply_apply x
  have ht : E.toAlgHom.comp E.symm.toAlgHom = AlgHom.id ℂ B := by
    apply AlgHom.ext; intro x; exact E.apply_symm_apply x
  have hε' : εA.comp E.symm.toAlgHom = εB := aug_symm E εA εB hε
  refine ⟨K0.mapA E.toAlgHom g, ?_, ?_, ?_⟩
  · rw [mapA_comp_apply E.toAlgHom εB g, hε]; exact hgred
  · intro n hn
    apply hginf n
    have h1 : K0.mapA E.symm.toAlgHom (n • K0.mapA E.toAlgHom g) = n • g := by
      rw [map_zsmul, mapA_of_leftInv E.toAlgHom E.symm.toAlgHom hs g]
    rw [hn, map_zero] at h1
    exact h1.symm
  · intro z hz
    have hz' : K0.mapA εA (K0.mapA E.symm.toAlgHom z) = 0 := by
      rw [mapA_comp_apply E.symm.toAlgHom εA z, hε', hz]
    obtain ⟨n, hn⟩ := hggen _ hz'
    refine ⟨n, ?_⟩
    rw [← mapA_of_rightInv E.toAlgHom E.symm.toAlgHom ht z, hn, map_zsmul]

/-! ## The change of norm `R2 ≃ₗ ℝ²` -/

/-- The identity-as-a-linear-equivalence `ℝ × ℝ ≃ₗ ℝ²` (the source carries the sup norm and the
target the Euclidean norm; the equivalence itself is norm-ignorant).  Same as
`Work.KT.ExtGen.r2LinEquiv`, copied here so that this file does not depend on the (mid-assembly)
module `Work.KT.ExtGen.Kpair_R2_iso_C_S2`. -/
def seedR2Equiv : R2 ≃ₗ[ℝ] Euc 2 :=
  (LinearEquiv.finTwoArrow ℝ ℝ).symm.trans (EuclideanSpace.equiv (Fin 2) ℝ).symm.toLinearEquiv

/-! ## The base case -/

theorem seed_R2 (y0R : Ball R2) (hR : y0R ∈ bdry R2) :
    ∃ b : K0 (Kpair R2), K0.mapA (augPair R2 y0R) b = 0 ∧
      (∀ n : ℤ, n • b = 0 → n = 0) ∧
      (∀ z : K0 (Kpair R2), K0.mapA (augPair R2 y0R) z = 0 → ∃ n : ℤ, z = n • b) := by
  -- the base point of `ℝ²` corresponding to `y0R` under the radial normalisation
  let y0W : Ball (Euc 2) := ExtGen.phiBall seedR2Equiv y0R
  have hy0W : y0W ∈ bdry (Euc 2) := ExtGen.phiBall_mem_bdry seedR2Equiv hR
  -- the dimension-two base case of Bott periodicity for the model disc algebra `Kpair ℝ²`
  obtain ⟨H, hHred, hHinf, hHgen, -, -⟩ := ballK_dim2 y0W hy0W
  -- augmentation compatibility of the change-of-norm isomorphism
  have haugE : (augPair (Euc 2) y0W).comp (ExtGen.pairIsoEV seedR2Equiv).toAlgHom
      = augPair R2 y0R := by
    rw [ExtGen.pairIsoEV_aug seedR2Equiv y0W]
    congr 1
    exact ExtGen.psiBall_phiBall seedR2Equiv y0R
  let hEsymm : Kpair (Euc 2) ≃ₐ[ℂ] Kpair R2 := (ExtGen.pairIsoEV seedR2Equiv).symm
  have haugE' : (augPair R2 y0R).comp hEsymm.toAlgHom = augPair (Euc 2) y0W :=
    aug_symm (A := Kpair R2) (B := Kpair (Euc 2))
      (ExtGen.pairIsoEV seedR2Equiv) (augPair R2 y0R) (augPair (Euc 2) y0W) haugE
  exact transport_seed (A := Kpair (Euc 2)) (B := Kpair R2) hEsymm (augPair (Euc 2) y0W)
    (augPair R2 y0R) haugE' hHred hHinf hHgen

end

end Work.KT.EG
