import Mathlib
import Submission.Work.KT.Defs

/-!
# Framework for `Work.KT.psi_comm`

Foundations used by the proof that `ψ²` and `ψ³` commute on `K₀` of a commutative `ℂ`-algebra:

* elementary `K₀` lemmas (`cls` of Murray–von Neumann equivalent idempotents, additivity for
  orthogonal idempotents, vanishing on non-idempotents, generation by the classes of matrices);
* invariance of `cls` under reindexing a matrix by a permutation of its index set;
* multiplicativity of the (reindexed) Kronecker product `kronMat`;
* the "position permutation" calculus on a tensor power `Fin k → Fin n`: the operator `tensP p k`
  (the `k`-fold tensor power of `p`), the digit permutation matrices `D σ`, and the basic lemmas
  (`tensP` is multiplicative and idempotent, `D` is a homomorphism, `tensP` commutes with `D`).
-/

namespace Work.KT.PsiC

open Matrix

noncomputable section

variable {A : Type} [Ring A]

/-! ## Elementary `K₀` lemmas -/

/-- Idempotents that are Murray–von Neumann equivalent have the same class. -/
theorem cls_of_mvN {p q : Mat A} (hp : p.IsIdem) (hq : q.IsIdem) (h : p.MvN q) :
    cls p = cls q := by
  have hmem : FreeAbelianGroup.of p - FreeAbelianGroup.of q ∈ K0Rel A :=
    AddSubgroup.subset_closure (Or.inl (Or.inr ⟨p, q, hp, hq, h, rfl⟩))
  unfold cls
  rw [QuotientAddGroup.eq_iff_sub_mem]
  simpa using hmem

/-- Non-idempotent matrices have zero class. -/
theorem cls_of_not_idem {p : Mat A} (hp : ¬ p.IsIdem) : cls p = 0 := by
  have hmem : FreeAbelianGroup.of p ∈ K0Rel A :=
    AddSubgroup.subset_closure (Or.inr ⟨p, hp, rfl⟩)
  unfold cls
  rw [QuotientAddGroup.eq_zero_iff]
  simpa using hmem

/-- The class of a block sum is the sum of the classes. -/
theorem cls_sum' {p q : Mat A} (hp : p.IsIdem) (hq : q.IsIdem) :
    cls (p.sum q) = cls p + cls q := by
  have hmem : FreeAbelianGroup.of (p.sum q) - FreeAbelianGroup.of p - FreeAbelianGroup.of q ∈
      K0Rel A :=
    AddSubgroup.subset_closure (Or.inl (Or.inl ⟨p, q, hp, hq, rfl⟩))
  have hzero : cls (p.sum q) - (cls p + cls q) = 0 := by
    unfold cls
    rw [← QuotientAddGroup.mk_add, ← QuotientAddGroup.mk_sub, QuotientAddGroup.eq_zero_iff]
    simpa [sub_sub] using hmem
  exact sub_eq_zero.mp hzero

/-- The class is generated by the classes of matrices. -/
theorem cls_closure_top : AddSubgroup.closure (Set.range (cls : Mat A → K0 A)) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  refine QuotientAddGroup.induction_on x ?_
  intro a
  suffices key : (QuotientAddGroup.mk a : K0 A) ∈
      AddSubgroup.closure (Set.range (cls : Mat A → K0 A)) from key
  refine FreeAbelianGroup.induction_on a ?_ ?_ ?_ ?_
  · simpa using AddSubgroup.zero_mem
      (AddSubgroup.closure (Set.range (cls : Mat A → K0 A)) : AddSubgroup (K0 A))
  · intro p; exact AddSubgroup.subset_closure ⟨p, rfl⟩
  · intro p hp; simpa using AddSubgroup.neg_mem _ hp
  · intro p q hp hq; simpa using AddSubgroup.add_mem _ hp hq

/-- Two additive maps out of `K₀` agreeing on the classes of matrices are equal. -/
theorem addHom_ext_cls {M : Type} [AddCommGroup M] {f g : K0 A →+ M}
    (h : ∀ p : Mat A, f (cls p) = g (cls p)) : f = g := by
  refine AddMonoidHom.ext (fun x => ?_)
  have hmem : x ∈ AddSubgroup.closure (Set.range (cls : Mat A → K0 A)) := by
    rw [cls_closure_top]; trivial
  exact AddSubgroup.closure_induction (p := fun y _ => f y = g y)
    (fun y hy => by obtain ⟨p, rfl⟩ := hy; exact h p)
    (by simp)
    (fun a b _ _ iha ihb => by simp [map_add, iha, ihb])
    (fun a _ iha => by simp [map_neg, iha])
    hmem

/-! ## Reindexing -/

/-- The rectangular permutation matrix of `τ : Fin n ≃ Fin n'`. -/
def pmat (A : Type) [Ring A] {n n' : ℕ} (τ : Fin n ≃ Fin n') : Matrix (Fin n') (Fin n) A :=
  fun i j => if τ j = i then 1 else 0

theorem pmat_mul_rect (A : Type) [Ring A] {n n' m : ℕ} (τ : Fin n ≃ Fin n')
    (Y : Matrix (Fin n) (Fin m) A) : pmat A τ * Y = Y.submatrix τ.symm id := by
  ext i j
  simp only [Matrix.mul_apply, pmat, Matrix.submatrix_apply, id_eq]
  rw [Finset.sum_eq_single (τ.symm i)]
  · rw [if_pos (τ.apply_symm_apply i), one_mul]
  · intro b _ hb
    rw [if_neg (fun h => hb ((Equiv.eq_symm_apply τ).mpr h)), zero_mul]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem rect_mul_pmat (A : Type) [Ring A] {n n' m : ℕ} (τ : Fin n ≃ Fin n')
    (Z : Matrix (Fin m) (Fin n') A) : Z * pmat A τ = Z.submatrix id τ := by
  ext i j
  simp only [Matrix.mul_apply, pmat, Matrix.submatrix_apply, id_eq]
  rw [Finset.sum_eq_single (τ j)]
  · rw [if_pos rfl, mul_one]
  · intro b _ hb; rw [if_neg (fun h => hb h.symm), mul_zero]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem rect_mul_pmat_trans (A : Type) [Ring A] {n m : ℕ} {n' : ℕ} (τ : Fin n ≃ Fin n')
    (Z : Matrix (Fin m) (Fin n) A) : Z * (pmat A τ)ᵀ = Z.submatrix id τ.symm := by
  ext i j
  simp only [Matrix.mul_apply, pmat, Matrix.transpose_apply, Matrix.submatrix_apply, id_eq]
  rw [Finset.sum_eq_single (τ.symm j)]
  · rw [if_pos (τ.apply_symm_apply j), mul_one]
  · intro b _ hb
    rw [if_neg (fun h => hb ((Equiv.eq_symm_apply τ).mpr h)), mul_zero]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem pmat_trans_mul (A : Type) [Ring A] {n n' : ℕ} (τ : Fin n ≃ Fin n') :
    (pmat A τ)ᵀ * pmat A τ = 1 := by
  rw [rect_mul_pmat A τ (pmat A τ)ᵀ]
  ext i j
  simp only [Matrix.submatrix_apply, Matrix.transpose_apply, pmat, Matrix.one_apply, id_eq]
  by_cases h : i = j
  · subst h; simp
  · rw [if_neg (fun hh => h (τ.injective hh)), if_neg h]

theorem pmat_mul_pmat_trans (A : Type) [Ring A] {n n' : ℕ} (τ : Fin n ≃ Fin n')
    (X : Matrix (Fin n) (Fin n) A) :
    pmat A τ * X * (pmat A τ)ᵀ = Matrix.reindex τ τ X := by
  rw [pmat_mul_rect, rect_mul_pmat_trans]; rfl

theorem reindex_mul_self {ι κ : Type} [Fintype ι] [Fintype κ] (e : ι ≃ κ)
    (X : Matrix ι ι A) :
    Matrix.reindex e e (X * X) = Matrix.reindex e e X * Matrix.reindex e e X :=
  map_mul (Matrix.reindexRingEquiv A e) X X

/-- Reassociation of a product of four rectangular matrices. -/
theorem mul_assoc4 {a b c d e : Type} [Fintype b] [Fintype c] [Fintype d]
    (X : Matrix a b A) (Y : Matrix b c A) (Z : Matrix c d A) (W : Matrix d e A) :
    X * Y * (Z * W) = X * (Y * Z) * W := by
  rw [Matrix.mul_assoc X Y (Z * W), ← Matrix.mul_assoc Y Z W, ← Matrix.mul_assoc X (Y * Z) W]

/-- `cls` is invariant under reindexing a square matrix by a permutation of `Fin n`. -/
theorem cls_reindex {n n' : ℕ} (X : Matrix (Fin n) (Fin n) A) (hX : X * X = X)
    (τ : Fin n ≃ Fin n') : cls (⟨n, X⟩ : Mat A) = cls ⟨n', Matrix.reindex τ τ X⟩ := by
  have hY : Matrix.reindex τ τ X * Matrix.reindex τ τ X = Matrix.reindex τ τ X := by
    rw [← reindex_mul_self τ X, hX]
  have hb : X * (pmat A τ)ᵀ * (pmat A τ * X) = X := by
    rw [mul_assoc4, pmat_trans_mul, Matrix.mul_one, hX]
  have ha : pmat A τ * X * (X * (pmat A τ)ᵀ) = Matrix.reindex τ τ X := by
    rw [mul_assoc4, hX, pmat_mul_pmat_trans]
  exact cls_of_mvN hX hY ⟨pmat A τ * X, X * (pmat A τ)ᵀ, hb, ha⟩

/-- Conjugating by a permutation matrix does not change the class. -/
theorem cls_conj_perm {n : ℕ} (X : Matrix (Fin n) (Fin n) A) (hX : X * X = X)
    (τ : Equiv.Perm (Fin n)) :
    cls ⟨n, X⟩ = cls ⟨n, Matrix.reindex τ τ X⟩ := cls_reindex X hX τ

/-! ## Kronecker products -/

theorem kronMat_apply {n m : ℕ} (M : Matrix (Fin n) (Fin n) A) (N : Matrix (Fin m) (Fin m) A)
    (i i' : Fin n) (j j' : Fin m) :
    kronMat M N (finProdFinEquiv (i, j)) (finProdFinEquiv (i', j')) = M i i' * N j j' := by
  simp [kronMat, Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.kroneckerMap_apply]

/-! ## The tensor-position calculus -/

variable {A : Type} [Ring A]

theorem permMatrix_apply' {ι : Type} [DecidableEq ι] (σ : Equiv.Perm ι) (i j : ι) :
    (σ.permMatrix A) i j = if σ i = j then 1 else 0 := by
  rw [Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply]
  simp

/-- The permutation of the tensor index `Fin k → Fin n` induced by a permutation `σ` of the `k`
tensor positions: `a ↦ a ∘ σ⁻¹`. -/
def dperm {n k : ℕ} (σ : Equiv.Perm (Fin k)) : Equiv.Perm (Fin k → Fin n) where
  toFun a := a ∘ σ.symm
  invFun a := a ∘ σ
  left_inv a := by funext i; simp
  right_inv a := by funext i; simp

theorem dperm_trans {n k : ℕ} (σ τ : Equiv.Perm (Fin k)) :
    (dperm (n := n) (σ.trans τ)) = (dperm (n := n) σ).trans (dperm (n := n) τ) := by
  ext a i; simp [dperm, Equiv.trans_apply]

/-- The matrix of the position permutation `σ` acting on the `k`-fold tensor power. -/
def D (A : Type) [Ring A] {n k : ℕ} (σ : Equiv.Perm (Fin k)) :
    Matrix (Fin k → Fin n) (Fin k → Fin n) A :=
  (dperm σ).permMatrix A

theorem D_apply {n k : ℕ} (σ : Equiv.Perm (Fin k)) (a b : Fin k → Fin n) :
    D A σ a b = if a ∘ σ.symm = b then 1 else 0 := by
  rw [D, permMatrix_apply']; rfl

theorem mul_D_apply {n k : ℕ} (M : Matrix (Fin k → Fin n) (Fin k → Fin n) A)
    (σ : Equiv.Perm (Fin k)) (a b : Fin k → Fin n) :
    ((M * D A σ : Matrix (Fin k → Fin n) (Fin k → Fin n) A)) a b = M a (b ∘ σ) := by
  rw [Matrix.mul_apply]
  rw [Finset.sum_eq_single (b ∘ σ)]
  · rw [D_apply, if_pos (by funext i; simp), mul_one]
  · intro c _ hc
    rw [D_apply, if_neg (fun h => hc (by
      funext i
      simpa [Equiv.symm_apply_apply] using congrFun h (σ i))), mul_zero]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem D_mul_apply {n k : ℕ} (M : Matrix (Fin k → Fin n) (Fin k → Fin n) A)
    (σ : Equiv.Perm (Fin k)) (a b : Fin k → Fin n) :
    ((D A σ * M : Matrix (Fin k → Fin n) (Fin k → Fin n) A)) a b = M (a ∘ σ.symm) b := by
  rw [Matrix.mul_apply]
  rw [Finset.sum_eq_single (a ∘ σ.symm)]
  · rw [D_apply, if_pos rfl, one_mul]
  · intro c _ hc
    rw [D_apply, if_neg (fun h => hc h.symm), zero_mul]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem D_mul {n k : ℕ} (σ τ : Equiv.Perm (Fin k)) :
    D A (n := n) σ * D A (n := n) τ = D A (n := n) (σ.trans τ) := by
  rw [D, D, D, ← Matrix.permMatrix_mul (R := A) (dperm τ) (dperm σ)]
  congr 1

theorem D_mul_inv {n k : ℕ} (σ : Equiv.Perm (Fin k)) :
    D A (n := n) σ * D A (n := n) σ.symm = 1 := by
  ext a b
  rw [mul_D_apply, D_apply, Matrix.one_apply]
  by_cases h : a ∘ σ.symm = b ∘ σ.symm
  · have hab : a = b := funext fun i => by
      simpa [Equiv.symm_apply_apply] using congrFun h (σ i)
    rw [if_pos h, if_pos hab]
  · have hab : a ≠ b := fun hh => h (by rw [hh])
    rw [if_neg h, if_neg hab]

/-- The `k`-fold tensor power of a matrix, on the tensor index type `Fin k → Fin n`. -/
def tensP (p : Mat A) (k : ℕ) : Matrix (Fin k → Fin p.1) (Fin k → Fin p.1) A :=
  fun a b => (List.ofFn fun i => p.2 (a i) (b i)).prod

theorem tensP_mul {n : ℕ} (hA : ∀ x y : A, x * y = y * x) (M N : Matrix (Fin n) (Fin n) A)
    (k : ℕ) :
    tensP (⟨n, M⟩ : Mat A) k * tensP (⟨n, N⟩ : Mat A) k = tensP (⟨n, M * N⟩ : Mat A) k := by
  letI : CommRing A := { ‹Ring A› with mul_comm := hA }
  ext a b
  rw [Matrix.mul_apply]
  simp only [tensP, List.prod_ofFn]
  rw [Finset.sum_congr rfl (fun x _ => (Finset.prod_mul_distrib).symm)]
  have hpi : Fintype.piFinset (fun _ : Fin k => (Finset.univ : Finset (Fin n))) = Finset.univ := by
    ext f; simp
  rw [show (∏ i, (M * N) (a i) (b i)) = ∏ i, ∑ j, M (a i) j * N j (b i) from
    Finset.prod_congr rfl (fun i _ => Matrix.mul_apply)]
  rw [Finset.prod_univ_sum (fun _ => Finset.univ) (fun i j => M (a i) j * N j (b i)), hpi]

theorem tensP_idem {p : Mat A} (hA : ∀ x y : A, x * y = y * x) (hp : p.IsIdem) (k : ℕ) :
    tensP p k * tensP p k = tensP p k := by
  rw [tensP_mul hA p.2 p.2, hp]

theorem tensP_comm_D {p : Mat A} (hA : ∀ x y : A, x * y = y * x) (k : ℕ)
    (σ : Equiv.Perm (Fin k)) :
    tensP p k * D A σ = D A σ * tensP p k := by
  letI : CommRing A := { ‹Ring A› with mul_comm := hA }
  ext a b
  rw [mul_D_apply, D_mul_apply]
  simp only [tensP, List.prod_ofFn]
  exact (Fintype.prod_equiv σ.symm (fun i => p.2 (a (σ.symm i)) (b i))
    (fun i => p.2 (a i) (b (σ i))) (fun i => by simp)).symm

end

end Work.KT.PsiC

