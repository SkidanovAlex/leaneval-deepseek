import Mathlib
import Submission.Work.KT.D2.mZero

namespace Work.KT.D2

open Matrix

/-! ## Conjugation invariance of the winding invariant `mZero`

The reduced group `K̃(D²/S¹) ≅ K̃(S²) ≅ ℤ` is generated by the Bott class; the invariant
`Work.KT.D2.mZero` extracts the winding number of a trivialising loop of an idempotent matrix over
`Kpair ℝ²`.  Here we show that `mZero` only depends on the Murray–von Neumann class of the
idempotent, in the elementary form in which it is needed for `Work.KT.D2.mZero_mvN`: conjugation by
a unit `c` with inverse `c'` does not change `mZero`.

The strategy is the universal property `Work.KT.D2.mZero_eq`.  If `Q = c P c'` with `c c' = 1` and
`c' c = 1`, the family
`u x = (bval c) · trivU P x · (toCM c' x)`  (with `bval c = c(y0)`) is a continuous family of units
on the disc satisfying `u x · Q(x) = Q(y0) · u x`, so `mZero Q` is the winding of its boundary loop.
On the boundary `u` reduces to `(bval c) · trivU P · (bval c')`, which is a conjugate of the
trivialising loop of `P`, and conjugation by the inverse units `bval c`, `bval c'` leaves the
determinant `det (e · γ · e + (1 - e))` unchanged. -/

/-- `bval` is multiplicative. -/
lemma bval_mul_conj (y0 : Ball (Euc 2)) (n : ℕ)
    (M M' : Matrix (Fin n) (Fin n) (Kpair (Euc 2))) :
    bval n y0 (M * M') = bval n y0 M * bval n y0 M' := by
  show (M * M').map (augPair (Euc 2) y0).toRingHom
    = M.map (augPair (Euc 2) y0).toRingHom * M'.map _
  rw [Matrix.map_mul]

/-- `bval` sends the identity to the identity. -/
lemma bval_one_conj (y0 : Ball (Euc 2)) (n : ℕ) :
    bval n y0 (1 : Matrix (Fin n) (Fin n) (Kpair (Euc 2))) = 1 := by
  show (1 : Matrix (Fin n) (Fin n) (Kpair (Euc 2))).map
    (augPair (Euc 2) y0).toRingHom = 1
  exact Matrix.map_one _ (map_zero _) (map_one _)

theorem mZero_conj (y0 : Work.KT.Ball (EuclideanSpace ℝ (Fin 2)))
    (hy0 : y0 ∈ Work.KT.bdry (EuclideanSpace ℝ (Fin 2))) (N : ℕ)
    (P : Matrix (Fin N) (Fin N) (Work.KT.Kpair (EuclideanSpace ℝ (Fin 2))))
    (hP : P * P = P)
    (c c' : Matrix (Fin N) (Fin N) (Work.KT.Kpair (EuclideanSpace ℝ (Fin 2))))
    (hcc : c * c' = 1) (hc'c : c' * c = 1) :
    Work.KT.D2.mZero y0 hy0 (⟨N, c * P * c'⟩ :
        Work.KT.Mat (Work.KT.Kpair (EuclideanSpace ℝ (Fin 2))))
      = Work.KT.D2.mZero y0 hy0 (⟨N, P⟩ :
        Work.KT.Mat (Work.KT.Kpair (EuclideanSpace ℝ (Fin 2)))) := by
  let Qm : Matrix (Fin N) (Fin N) (Work.KT.Kpair (Work.KT.Euc 2)) := c * P * c'
  have hQidem : Work.KT.Mat.IsIdem
      (⟨N, Qm⟩ : Work.KT.Mat (Work.KT.Kpair (Work.KT.Euc 2))) := by
    show Qm * Qm = Qm
    show (c * P * c') * (c * P * c') = c * P * c'
    rw [show (c * P * c') * (c * P * c') = c * P * (c' * c) * P * c' by noncomm_ring,
      hc'c, Matrix.mul_one, show c * P * P * c' = c * (P * P) * c' by noncomm_ring, hP]
  let PP : Work.KT.Mat (Work.KT.Kpair (Work.KT.Euc 2)) := ⟨N, P⟩
  let trivP : C(Ball (Euc 2), Matrix (Fin N) (Fin N) ℂ) := trivU y0 PP hP
  let trivPv : C(Ball (Euc 2), Matrix (Fin N) (Fin N) ℂ) := trivV y0 PP hP
  let Bc : Matrix (Fin N) (Fin N) ℂ := bval N y0 c
  let Bc' : Matrix (Fin N) (Fin N) ℂ := bval N y0 c'
  let BP : Matrix (Fin N) (Fin N) ℂ := bval N y0 P
  have hBcBc' : Bc * Bc' = 1 := by rw [← bval_mul_conj, hcc, bval_one_conj]
  have hBc'Bc : Bc' * Bc = 1 := by rw [← bval_mul_conj, hc'c, bval_one_conj]
  have hbvalQ : bval N y0 Qm = Bc * BP * Bc' := by
    show bval N y0 (c * P * c') = Bc * BP * Bc'
    rw [bval_mul_conj, bval_mul_conj]
  let u : C(Ball (Euc 2), Matrix (Fin N) (Fin N) ℂ) :=
    ContinuousMap.const _ Bc * trivP * toCM N c'
  let v : C(Ball (Euc 2), Matrix (Fin N) (Fin N) ℂ) :=
    toCM N c * trivPv * ContinuousMap.const _ Bc'
  have hu_app : ∀ x, u x = Bc * trivP x * toCM N c' x := fun x => rfl
  have hv_app : ∀ x, v x = toCM N c x * trivPv x * Bc' := fun x => rfl
  have hu : ∀ x, u x * v x = 1 := by
    intro x
    rw [hu_app x, hv_app x]
    calc Bc * trivP x * toCM N c' x * (toCM N c x * trivPv x * Bc')
        = Bc * trivP x * (toCM N c' x * toCM N c x) * trivPv x * Bc' := by noncomm_ring
      _ = Bc * trivP x * (toCM N (c' * c) x) * trivPv x * Bc' := by rw [toCM_mul_apply]
      _ = Bc * trivP x * (1 : Matrix (Fin N) (Fin N) ℂ) * trivPv x * Bc' := by
            rw [hc'c, toCM_one_apply]
      _ = Bc * (trivP x * trivPv x) * Bc' := by noncomm_ring
      _ = Bc * 1 * Bc' := by rw [(trivU_spec y0 PP hP).1 x]
      _ = 1 := by rw [Matrix.mul_one, hBcBc']
  have hv : ∀ x, v x * u x = 1 := by
    intro x
    rw [hu_app x, hv_app x]
    calc toCM N c x * trivPv x * Bc' * (Bc * trivP x * toCM N c' x)
        = toCM N c x * trivPv x * (Bc' * Bc) * trivP x * toCM N c' x := by noncomm_ring
      _ = toCM N c x * trivPv x * (1 : Matrix (Fin N) (Fin N) ℂ) * trivP x * toCM N c' x := by
            rw [hBc'Bc]
      _ = toCM N c x * (trivPv x * trivP x) * toCM N c' x := by noncomm_ring
      _ = toCM N c x * 1 * toCM N c' x := by rw [(trivU_spec y0 PP hP).2.1 x]
      _ = toCM N (c * c') x := by rw [toCM_mul_apply, Matrix.mul_one]
      _ = 1 := by rw [hcc, toCM_one_apply]
  have hQx : ∀ x, toCM N Qm x = toCM N c x * toCM N P x * toCM N c' x := by
    intro x
    show toCM N (c * P * c') x = _
    rw [show c * P * c' = (c * P) * c' from rfl, toCM_mul_apply, toCM_mul_apply]
  have hC'C : ∀ x, toCM N c' x * toCM N c x = 1 := by
    intro x
    rw [← toCM_mul_apply, hc'c, toCM_one_apply]
  have hL : ∀ x, Bc * trivP x * toCM N c' x * (toCM N c x * toCM N P x * toCM N c' x)
      = Bc * BP * trivP x * toCM N c' x := by
    intro x
    rw [show Bc * trivP x * toCM N c' x * (toCM N c x * toCM N P x * toCM N c' x)
        = Bc * trivP x * (toCM N c' x * toCM N c x) * toCM N P x * toCM N c' x from by
          noncomm_ring]
    rw [hC'C x, Matrix.mul_one]
    rw [show Bc * trivP x * toCM N P x * toCM N c' x
        = Bc * (trivP x * toCM N P x) * toCM N c' x from by noncomm_ring]
    rw [(trivU_spec y0 PP hP).2.2 x]
    noncomm_ring
  have hR : ∀ x, Bc * BP * Bc' * (Bc * trivP x * toCM N c' x)
      = Bc * BP * trivP x * toCM N c' x := by
    intro x
    rw [show Bc * BP * Bc' * (Bc * trivP x * toCM N c' x)
        = Bc * BP * (Bc' * Bc) * trivP x * toCM N c' x from by noncomm_ring]
    rw [hBc'Bc, Matrix.mul_one]
  have hconj : ∀ x, u x * toCM N Qm x = bval N y0 Qm * u x := by
    intro x
    rw [hu_app x, hQx x, hbvalQ]
    exact (hL x).trans (hR x).symm
  have hu_bdry : ∀ x : Sph (Euc 2), u (inBall x) = Bc * trivP (inBall x) * Bc' := by
    intro x
    rw [hu_app (inBall x), toCM_inBall N c' y0 hy0 x]
  have hkey : ∀ x : Sph (Euc 2),
      bval N y0 Qm * u (inBall x) * bval N y0 Qm + (1 - bval N y0 Qm)
      = Bc * (BP * trivP (inBall x) * BP + (1 - BP)) * Bc' := by
    intro x
    have hL1 : bval N y0 Qm * u (inBall x) * bval N y0 Qm + (1 - bval N y0 Qm)
        = Bc * BP * trivP (inBall x) * BP * Bc' + (1 - Bc * BP * Bc') := by
      rw [hbvalQ, hu_bdry x]
      rw [show (Bc * BP * Bc') * (Bc * trivP (inBall x) * Bc') * (Bc * BP * Bc')
            + (1 - Bc * BP * Bc')
          = Bc * BP * (Bc' * Bc) * trivP (inBall x) * (Bc' * Bc) * BP * Bc'
            + (1 - Bc * BP * Bc') from by noncomm_ring,
          hBc'Bc, mul_one, mul_one]
    have hL2 : Bc * (BP * trivP (inBall x) * BP + (1 - BP)) * Bc'
        = Bc * BP * trivP (inBall x) * BP * Bc' + (1 - Bc * BP * Bc') := by
      rw [show Bc * (BP * trivP (inBall x) * BP + (1 - BP)) * Bc'
          = Bc * BP * trivP (inBall x) * BP * Bc' + (Bc * Bc' - Bc * BP * Bc') from by
            noncomm_ring,
          hBcBc']
    exact hL1.trans hL2.symm
  have hdet_conj : ∀ M : Matrix (Fin N) (Fin N) ℂ,
      Matrix.det (Bc * M * Bc') = Matrix.det M := by
    intro M
    have hdB : Matrix.det Bc * Matrix.det Bc' = 1 := by
      rw [← Matrix.det_mul, hBcBc', Matrix.det_one]
    rw [Matrix.det_mul, Matrix.det_mul]
    calc Matrix.det Bc * Matrix.det M * Matrix.det Bc'
        = Matrix.det M * (Matrix.det Bc * Matrix.det Bc') := by ring
      _ = Matrix.det M := by rw [hdB, mul_one]
  have hP' : ∀ x, Matrix.det (bval N y0 P * trivP (inBall x) * bval N y0 P
      + (1 - bval N y0 P)) ≠ 0 := trivU_blk_det y0 hy0 PP hP
  have h : ∀ x : Sph (Euc 2),
      Matrix.det (bval N y0 Qm * u (inBall x) * bval N y0 Qm + (1 - bval N y0 Qm)) ≠ 0 := by
    intro x
    rw [hkey x, hdet_conj]
    exact hP' x
  have hfun : wlmDet N (bval N y0 Qm) (u.comp inBallCM)
      = wlmDet N (bval N y0 P) (trivP.comp inBallCM) := by
    apply ContinuousMap.ext
    intro x
    show Matrix.det (bval N y0 Qm * u (inBall x) * bval N y0 Qm + (1 - bval N y0 Qm))
        = Matrix.det (bval N y0 P * trivP (inBall x) * bval N y0 P + (1 - bval N y0 P))
    rw [hkey x, hdet_conj]
  have hA := mZero_eq y0 hy0 (⟨N, Qm⟩ : Work.KT.Mat (Work.KT.Kpair (Work.KT.Euc 2)))
    hQidem u v hu hv hconj h
  rw [← hA]
  calc windLoop N (bval N y0 Qm) (u.comp inBallCM) h
      = degNZ (wlmDet N (bval N y0 Qm) (u.comp inBallCM)) h := windLoop_eq_degNZ _ _ _ _
    _ = degNZ (wlmDet N (bval N y0 P) (trivP.comp inBallCM)) hP' :=
        wlmDegNZcongr hfun h hP'
    _ = windLoop N (bval N y0 P) (trivP.comp inBallCM) hP' :=
        (windLoop_eq_degNZ _ _ _ _).symm
    _ = mZero y0 hy0 PP := (mZero_of_idem y0 hy0 PP hP).symm

end Work.KT.D2
