import Mathlib
import Submission.Work.KT.D2.Winding
import Submission.Work.KT.D2.blk_det_ne_zero
import Submission.Work.KT.D2.windLoop_gauge

/-!
# `Work.KT.D2.mZero` — the winding invariant of an idempotent over `D²/S¹`

`K̃(D²/S¹) = K̃(S²)` is generated by the Bott class `PA`: the class of an idempotent matrix over
`Kpair ℝ²` is determined by two integers, its rank at the boundary point `y0` and the winding of
the boundary loop of a trivialising family of units.

This file defines the winding invariant `Work.KT.D2.mZero`.  For an idempotent `P`, a family
`trivU y0 P hP` of units over the closed disc conjugates `P` to the constant idempotent
`bval P = P(y0)`; its restriction to the boundary circle is therefore a loop in the stabiliser of
the idempotent `e := bval P`, and `mZero` is the winding of the determinant of its restriction to
`im e` (`Work.KT.D2.windLoop`).

The main structural facts about `mZero` (its universal property `mZero_eq`, additivity, invariance
under Murray–von Neumann equivalence, and its descent to `K₀`) are proved in the companion files.
-/

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

namespace Work.KT.D2

open Matrix
open Classical

noncomputable section

/-! ## 1. Determinant families -/

/-- The determinant of a continuous loop of matrices, as a continuous complex loop. -/
def detCM {n : ℕ} (γ : C(Sph (Euc 2), Matrix (Fin n) (Fin n) ℂ)) : C(Sph (Euc 2), ℂ) :=
  ⟨fun x => Matrix.det (γ x), γ.continuous.matrix_det⟩

@[simp] lemma detCM_apply {n : ℕ} (γ : C(Sph (Euc 2), Matrix (Fin n) (Fin n) ℂ))
    (x : Sph (Euc 2)) : detCM γ x = Matrix.det (γ x) := rfl

/-- The determinant of a continuous family of matrices on the closed disc. -/
def detCMBall {n : ℕ} (γ : C(Ball (Euc 2), Matrix (Fin n) (Fin n) ℂ)) : C(Ball (Euc 2), ℂ) :=
  ⟨fun x => Matrix.det (γ x), γ.continuous.matrix_det⟩

@[simp] lemma detCMBall_apply {n : ℕ} (γ : C(Ball (Euc 2), Matrix (Fin n) (Fin n) ℂ))
    (x : Ball (Euc 2)) : detCMBall γ x = Matrix.det (γ x) := rfl

/-- A constant nowhere-zero complex loop has winding zero. -/
lemma degNZ_const (c : ℂ) (hc : c ≠ 0) :
    degNZ (ContinuousMap.const (Sph (Euc 2)) c) (fun _ => hc) = 0 := by
  have hf : ∀ x : Sph (Euc 2),
      (ContinuousMap.const (Sph (Euc 2)) c : C(Sph (Euc 2), ℂ)) x ≠ 0 := fun _ => hc
  change degNZ (ContinuousMap.const (Sph (Euc 2)) c : C(Sph (Euc 2), ℂ)) hf = 0
  refine (degNZ_zero_iff _ hf).mpr ?_
  refine ⟨(ContinuousMap.const (Sph (Euc 2)) (Complex.log c) : C(Sph (Euc 2), ℂ)), ?_⟩
  intro x
  show Complex.exp (Complex.log c) = c
  rw [Complex.exp_log hc]

/-- The constant loop `1` has winding zero. -/
lemma degNZ_one :
    degNZ (1 : C(Sph (Euc 2), ℂ)) (fun _ => one_ne_zero) = 0 := by
  have hf : ∀ x : Sph (Euc 2), (1 : C(Sph (Euc 2), ℂ)) x ≠ 0 := fun _ => one_ne_zero
  change degNZ (1 : C(Sph (Euc 2), ℂ)) hf = 0
  exact degNZ_const 1 one_ne_zero

/-! ## 2. The winding invariant -/

/-- On the boundary circle the chosen trivialisation of `P` commutes with the boundary value of
`P`. -/
lemma trivU_inBall_comm (y0 : Ball (Euc 2)) (hy0 : y0 ∈ bdry (Euc 2))
    (P : Mat (Kpair (Euc 2))) (hP : P.IsIdem) (x : Sph (Euc 2)) :
    trivU y0 P hP (inBall x) * bval P.1 y0 P.2
      = bval P.1 y0 P.2 * trivU y0 P hP (inBall x) := by
  have h := (trivU_spec y0 P hP).2.2 (inBall x)
  rwa [toCM_inBall P.1 P.2 y0 hy0 x] at h

/-- The restriction of the chosen trivialisation of `P` to `im (bval P)` is invertible on the
boundary circle. -/
lemma trivU_blk_det (y0 : Ball (Euc 2)) (hy0 : y0 ∈ bdry (Euc 2))
    (P : Mat (Kpair (Euc 2))) (hP : P.IsIdem) :
    ∀ x : Sph (Euc 2), Matrix.det (bval P.1 y0 P.2 * trivU y0 P hP (inBall x)
      * bval P.1 y0 P.2 + (1 - bval P.1 y0 P.2)) ≠ 0 :=
  fun x => blk_det_ne_zero (n := P.1) (bval P.1 y0 P.2) (trivU y0 P hP (inBall x))
    (trivV y0 P hP (inBall x)) (bval_idem P.1 y0 P.2 hP)
    (trivU_inBall_comm y0 hy0 P hP x)
    ((trivU_spec y0 P hP).1 (inBall x)) ((trivU_spec y0 P hP).2.1 (inBall x))

/-- The winding invariant of a matrix over `Kpair ℝ²`: for an idempotent `P` it is the winding of
the boundary loop of a trivialising family, restricted to `im (P y0)`, and it is `0` on
non-idempotents. -/
noncomputable def mZero (y0 : Ball (Euc 2)) (hy0 : y0 ∈ bdry (Euc 2))
    (P : Mat (Kpair (Euc 2))) : ℤ :=
  if hP : P.IsIdem then
    windLoop P.1 (bval P.1 y0 P.2) ((trivU y0 P hP).comp inBallCM) (trivU_blk_det y0 hy0 P hP)
  else 0

theorem mZero_of_idem (y0 : Ball (Euc 2)) (hy0 : y0 ∈ bdry (Euc 2))
    (P : Mat (Kpair (Euc 2))) (hP : P.IsIdem) :
    mZero y0 hy0 P = windLoop P.1 (bval P.1 y0 P.2) ((trivU y0 P hP).comp inBallCM)
      (trivU_blk_det y0 hy0 P hP) := dif_pos hP

theorem mZero_of_not_idem (y0 : Ball (Euc 2)) (hy0 : y0 ∈ bdry (Euc 2))
    (P : Mat (Kpair (Euc 2))) (hP : ¬ P.IsIdem) : mZero y0 hy0 P = 0 := dif_neg hP

/-- `windLoop` does not depend on the proof that the block determinant is nowhere zero. -/
lemma windLoop_proof_irrel {n : ℕ} (e : Matrix (Fin n) (Fin n) ℂ)
    (γ : C(Sph (Euc 2), Matrix (Fin n) (Fin n) ℂ))
    (h h' : ∀ x, Matrix.det (e * γ x * e + (1 - e)) ≠ 0) :
    windLoop n e γ h = windLoop n e γ h' := by
  unfold windLoop
  exact degNZ_proof_irrel _ h h'


/-! ## 3. The universal property of `mZero` -/

/-- Any disc-family of units that trivialises `P` to its boundary value computes `mZero`: the
winding of its boundary loop is `mZero y0 hy0 P`. -/
theorem mZero_eq (y0 : Ball (Euc 2)) (hy0 : y0 ∈ bdry (Euc 2))
    (P : Mat (Kpair (Euc 2))) (hP : P.IsIdem)
    (u v : C(Ball (Euc 2), Matrix (Fin P.1) (Fin P.1) ℂ))
    (huv : ∀ x, u x * v x = 1) (hvu : ∀ x, v x * u x = 1)
    (hconj : ∀ x, u x * toCM P.1 P.2 x = bval P.1 y0 P.2 * u x)
    (h : ∀ x, Matrix.det (bval P.1 y0 P.2 * u (inBall x) * bval P.1 y0 P.2
      + (1 - bval P.1 y0 P.2)) ≠ 0) :
    windLoop P.1 (bval P.1 y0 P.2) (u.comp inBallCM) h = mZero y0 hy0 P := by
  have hU := trivU_spec y0 P hP
  -- the gauge `w = u * trivV` commutes with the boundary value of `P` on the disc
  have hwcomm : ∀ x : Ball (Euc 2), (u * trivV y0 P hP) x * bval P.1 y0 P.2
      = bval P.1 y0 P.2 * (u * trivV y0 P hP) x := by
    intro x
    have h1 : u x * toCM P.1 P.2 x = bval P.1 y0 P.2 * u x := hconj x
    have he : bval P.1 y0 P.2
        = trivU y0 P hP x * toCM P.1 P.2 x * trivV y0 P hP x := by
      rw [hU.2.2 x, Matrix.mul_assoc, hU.1 x, Matrix.mul_one]
    have hVe : trivV y0 P hP x * bval P.1 y0 P.2
        = toCM P.1 P.2 x * trivV y0 P hP x := by
      calc trivV y0 P hP x * bval P.1 y0 P.2
          = trivV y0 P hP x * (trivU y0 P hP x * toCM P.1 P.2 x * trivV y0 P hP x) := by
              rw [he]
        _ = (trivV y0 P hP x * trivU y0 P hP x) * toCM P.1 P.2 x * trivV y0 P hP x := by
              noncomm_ring
        _ = toCM P.1 P.2 x * trivV y0 P hP x := by rw [hU.2.1 x, Matrix.one_mul]
    show u x * trivV y0 P hP x * bval P.1 y0 P.2
      = bval P.1 y0 P.2 * (u x * trivV y0 P hP x)
    calc u x * trivV y0 P hP x * bval P.1 y0 P.2
        = u x * (trivV y0 P hP x * bval P.1 y0 P.2) := by noncomm_ring
      _ = u x * (toCM P.1 P.2 x * trivV y0 P hP x) := by rw [hVe]
      _ = (u x * toCM P.1 P.2 x) * trivV y0 P hP x := by noncomm_ring
      _ = (bval P.1 y0 P.2 * u x) * trivV y0 P hP x := by rw [h1]
      _ = bval P.1 y0 P.2 * (u x * trivV y0 P hP x) := by noncomm_ring
  -- `w` is invertible, with two-sided inverse `w' = trivU * v`
  have hwinv : ∃ w' : C(Ball (Euc 2), Matrix (Fin P.1) (Fin P.1) ℂ),
      (∀ x, (u * trivV y0 P hP) x * w' x = 1) ∧
      (∀ x, w' x * (u * trivV y0 P hP) x = 1) :=
    ⟨trivU y0 P hP * v, fun x => by
        show u x * trivV y0 P hP x * (trivU y0 P hP x * v x) = 1
        calc u x * trivV y0 P hP x * (trivU y0 P hP x * v x)
            = u x * (trivV y0 P hP x * trivU y0 P hP x) * v x := by noncomm_ring
          _ = 1 := by rw [hU.2.1 x, Matrix.mul_one, huv x],
      fun x => by
        show (trivU y0 P hP x * v x) * (u x * trivV y0 P hP x) = 1
        calc (trivU y0 P hP x * v x) * (u x * trivV y0 P hP x)
            = trivU y0 P hP x * (v x * u x) * trivV y0 P hP x := by noncomm_ring
          _ = 1 := by rw [hvu x, Matrix.mul_one, hU.1 x]⟩
  have hcomm_γ : ∀ x : Sph (Euc 2), (trivU y0 P hP).comp inBallCM x * bval P.1 y0 P.2
      = bval P.1 y0 P.2 * (trivU y0 P hP).comp inBallCM x :=
    fun x => trivU_inBall_comm y0 hy0 P hP x
  have hcomm_γ' : ∀ x : Sph (Euc 2), (u.comp inBallCM) x * bval P.1 y0 P.2
      = bval P.1 y0 P.2 * (u.comp inBallCM) x := by
    intro x
    have hc := hconj (inBall x)
    rw [toCM_inBall P.1 P.2 y0 hy0 x] at hc
    simpa using hc
  have hgw : ∀ x : Sph (Euc 2), (u.comp inBallCM) x
      = (u * trivV y0 P hP) (inBall x) * (trivU y0 P hP).comp inBallCM x := by
    intro x
    show u (inBall x) = u (inBall x) * trivV y0 P hP (inBall x) * trivU y0 P hP (inBall x)
    rw [Matrix.mul_assoc, hU.2.1 (inBall x), Matrix.mul_one]
  rw [mZero_of_idem y0 hy0 P hP]
  exact windLoop_gauge (n := P.1) (e := bval P.1 y0 P.2) (he := bval_idem P.1 y0 P.2 hP)
    ((trivU y0 P hP).comp inBallCM) (u.comp inBallCM) hcomm_γ hcomm_γ'
    (u * trivV y0 P hP) hwcomm hwinv hgw (trivU_blk_det y0 hy0 P hP) h

end

end Work.KT.D2
