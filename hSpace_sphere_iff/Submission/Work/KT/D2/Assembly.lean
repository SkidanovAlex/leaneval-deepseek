import Mathlib
import Submission.Work.KT.Basic
import Submission.Work.KT.D2.Basic
import Submission.Work.KT.D2.mZero
import Submission.Work.KT.D2.mZero_one
import Submission.Work.KT.D2.mZero_H_ne_zero
import Submission.Work.KT.D2.Inject
import Submission.Work.KT.D2.InjK0
import Submission.Work.KT.D2.int_addSubgroup_eq_zmultiples
import Submission.Work.KT.psi_exists
import Submission.Work.KT.hk_k0_eq_diff

/-!
# `Work.KT.D2.Assembly` — the dimension-two Bott periodicity statement

The reduced group `K̃(D²/S¹) = K̃(S²)` is infinite cyclic, generated by the Bott class: the kernel
of the augmentation is exactly the cyclic subgroup generated by an element `H'` with non-zero
winding invariant, and the Adams operations act on it by `2` and `3`.

The winding invariant `mZero` descends to a homomorphism `m : K₀(Kpair ℝ²) → ℤ`; together with
the augmented rank it separates classes (`Work.KT.D2.eq_zero_of_rank_mZero`).  Hence `m` is
injective on the kernel `K` of the augmentation, whose image is a cyclic subgroup of `ℤ`.
-/

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

namespace Work.KT.D2

open Matrix
open Classical

noncomputable section

/-- **Dimension two.** The kernel of the augmentation of `K₀(Kpair ℝ²)` is infinite cyclic,
generated by an element with non-zero winding invariant, on which the Adams operations `ψ²`, `ψ³`
act by `2` and `3`. -/
theorem ballK_dim2_aux (y0W : Ball (Euc 2)) (hy0W : y0W ∈ bdry (Euc 2))
    (m : K0 (Kpair (Euc 2)) →+ ℤ)
    (hm : ∀ P : Mat (Kpair (Euc 2)), m (cls P) = mZero y0W hy0W P) :
    ∃ H' : K0 (Kpair (Euc 2)),
      K0.mapA (augPair (Euc 2) y0W) H' = 0 ∧
      (∀ k : ℤ, k • H' = 0 → k = 0) ∧
      (∀ z, K0.mapA (augPair (Euc 2) y0W) z = 0 → ∃ k : ℤ, z = k • H') ∧
      (∀ ψ : K0 (Kpair (Euc 2)) →+ K0 (Kpair (Euc 2)), IsPsi2 ψ → ψ H' = 2 • H') ∧
      (∀ ψ : K0 (Kpair (Euc 2)) →+ K0 (Kpair (Euc 2)), IsPsi3 ψ → ψ H' = 3 • H') := by
  -- the Bott class lies in the kernel of the augmentation and has non-zero winding
  have hHaug : K0.mapA (augPair (Euc 2) y0W) H = 0 := H_aug y0W hy0W
  have hmDH : m H = mZero y0W hy0W PA := by
    have h1 : m H = m (cls PA) - m (cls (Mat.one (Kpair (Euc 2)) 1)) := by
      rw [H, map_sub]
    rw [h1, hm PA, hm (Mat.one (Kpair (Euc 2)) 1), mZero_one y0W hy0W 1, sub_zero]
  have hmDHne : m H ≠ 0 := by rw [hmDH]; exact mZero_H_ne_zero y0W hy0W
  -- the kernel of the augmentation
  set K : AddSubgroup (K0 (Kpair (Euc 2))) := (K0.mapA (augPair (Euc 2) y0W)).ker with hKdef
  have hHK : H ∈ K := hHaug
  -- the image of `m` on the kernel is cyclic
  obtain ⟨g, hg⟩ := int_addSubgroup_eq_zmultiples (K.map m)
  have hgmem : m H ∈ AddSubgroup.zmultiples g := by
    rw [← hg]
    exact ⟨H, hHK, rfl⟩
  have hgne : g ≠ 0 := by
    intro h0
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hgmem
    rw [h0, smul_zero] at hk
    exact hmDHne hk.symm
  have hgK : g ∈ K.map m := by
    rw [hg]
    exact AddSubgroup.mem_zmultiples_iff.mpr ⟨1, one_smul ℤ g⟩
  obtain ⟨H', hH'K, hH'm⟩ := AddSubgroup.mem_map.mp hgK
  have hH'aug : K0.mapA (augPair (Euc 2) y0W) H' = 0 := hH'K
  -- the kernel is generated by `H'`
  have hKeq : K = AddSubgroup.zmultiples H' := by
    refine le_antisymm ?_ ?_
    · intro z hz
      have hz' : K0.mapA (augPair (Euc 2) y0W) z = 0 := hz
      have hzm : m z ∈ AddSubgroup.zmultiples g := by
        rw [← hg]
        exact ⟨z, hz, rfl⟩
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hzm
      have hzero : z - k • H' = 0 := by
        refine eq_zero_of_rank_mZero y0W hy0W m hm (z - k • H') ?_ ?_
        · have h1 : K0.mapA (augPair (Euc 2) y0W) (z - k • H') = 0 := by
            rw [map_sub, map_zsmul, hz', hH'aug, smul_zero, sub_zero]
          rw [h1, map_zero]
        · rw [map_sub, map_zsmul, hH'm, hk, sub_self]
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨k, (sub_eq_zero.mp hzero).symm⟩
    · rw [AddSubgroup.zmultiples_le]
      exact hH'K
  refine ⟨H', hH'aug, ?_, ?_, ?_, ?_⟩
  · -- non-torsion
    intro k hk
    have hmk : m (k • H') = 0 := by rw [hk, map_zero]
    rw [map_zsmul, hH'm] at hmk
    rw [zsmul_eq_mul] at hmk
    have hmul : k * g = 0 := by simpa using hmk
    rcases mul_eq_zero.mp hmul with h | h
    · exact h
    · exact absurd h hgne
  · -- generation
    intro z hz
    have hzK : z ∈ K := hz
    have hzgen : z ∈ AddSubgroup.zmultiples H' := by rw [← hKeq]; exact hzK
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hzgen
    exact ⟨k, hk.symm⟩
  · -- ψ²
    intro ψ hψ
    obtain ⟨ψB, hψB⟩ := psi2_exists (A := ℂ) (fun x y => mul_comm x y)
    have hψaug : K0.mapA (augPair (Euc 2) y0W) (ψ H') = 0 := by
      rw [psi2_nat (augPair (Euc 2) y0W) (fun x y => mul_comm x y) ψ ψB hψ hψB H',
        hH'aug, map_zero]
    obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (by rw [← hKeq]; exact hψaug)
    obtain ⟨j', hj'⟩ := AddSubgroup.mem_zmultiples_iff.mp (by rw [← hKeq]; exact hHK)
    have hj'ne : j' ≠ 0 := by
      intro h0
      have hzero : H = 0 := by rw [← hj', h0, zero_smul]
      exact hmDHne (by rw [hzero, map_zero])
    have hDHmem : m H = j' * g := by
      rw [← hj', map_zsmul, hH'm]
      simp [zsmul_eq_mul]
    have hmψ : m (ψ H') = j * g := by
      rw [← hj, map_zsmul, hH'm]
      simp [zsmul_eq_mul]
    have harith : j' * (j * g) = 2 * (j' * g) := by
      have hmeq : m (ψ H) = m (2 • H) := by rw [psi_on_H.1 ψ hψ]
      have lhs : m (ψ H) = j' * (j * g) := by
        rw [← hj', map_zsmul, map_zsmul, hmψ]
        simp [zsmul_eq_mul]
      have rhs : m (2 • H) = 2 * (j' * g) := by
        rw [map_nsmul, hDHmem]
        simp [nsmul_eq_mul]
      exact lhs.symm.trans (hmeq.trans rhs)
    have h1 : j' * j = 2 * j' := by
      refine mul_right_cancel₀ hgne ?_
      rw [mul_assoc j' j g, mul_assoc 2 j' g]
      exact harith
    have h1' : j' * j = j' * 2 := by rw [mul_comm 2 j'] at h1; exact h1
    have hj2 : j = 2 := mul_left_cancel₀ hj'ne h1'
    -- conclude by injectivity of the (rank, winding) invariants
    have hmem : ψ H' - 2 • H' ∈ K := by
      show K0.mapA (augPair (Euc 2) y0W) (ψ H' - 2 • H') = 0
      rw [map_sub, map_nsmul, hψaug, hH'aug, smul_zero, sub_zero]
    have hmzero : m (ψ H' - 2 • H') = 0 := by
      rw [map_sub, map_nsmul, hmψ, hH'm, hj2]
      simp [nsmul_eq_mul]
    have hzero := eq_zero_of_rank_mZero y0W hy0W m hm (ψ H' - 2 • H') (by rw [hmem, map_zero]) hmzero
    exact sub_eq_zero.mp hzero
  · -- ψ³
    intro ψ hψ
    obtain ⟨ψB, hψB⟩ := psi3_exists (A := ℂ) (fun x y => mul_comm x y)
    have hψaug : K0.mapA (augPair (Euc 2) y0W) (ψ H') = 0 := by
      rw [psi3_nat (augPair (Euc 2) y0W) (fun x y => mul_comm x y) ψ ψB hψ hψB H',
        hH'aug, map_zero]
    obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (by rw [← hKeq]; exact hψaug)
    obtain ⟨j', hj'⟩ := AddSubgroup.mem_zmultiples_iff.mp (by rw [← hKeq]; exact hHK)
    have hj'ne : j' ≠ 0 := by
      intro h0
      have hzero : H = 0 := by rw [← hj', h0, zero_smul]
      exact hmDHne (by rw [hzero, map_zero])
    have hDHmem : m H = j' * g := by
      rw [← hj', map_zsmul, hH'm]
      simp [zsmul_eq_mul]
    have hmψ : m (ψ H') = j * g := by
      rw [← hj, map_zsmul, hH'm]
      simp [zsmul_eq_mul]
    have harith : j' * (j * g) = 3 * (j' * g) := by
      have hmeq : m (ψ H) = m (3 • H) := by rw [psi_on_H.2 ψ hψ]
      have lhs : m (ψ H) = j' * (j * g) := by
        rw [← hj', map_zsmul, map_zsmul, hmψ]
        simp [zsmul_eq_mul]
      have rhs : m (3 • H) = 3 * (j' * g) := by
        rw [map_nsmul, hDHmem]
        simp [nsmul_eq_mul]
      exact lhs.symm.trans (hmeq.trans rhs)
    have h1 : j' * j = 3 * j' := by
      refine mul_right_cancel₀ hgne ?_
      rw [mul_assoc j' j g, mul_assoc 3 j' g]
      exact harith
    have h1' : j' * j = j' * 3 := by rw [mul_comm 3 j'] at h1; exact h1
    have hj3 : j = 3 := mul_left_cancel₀ hj'ne h1'
    -- conclude by injectivity of the (rank, winding) invariants
    have hmem : ψ H' - 3 • H' ∈ K := by
      show K0.mapA (augPair (Euc 2) y0W) (ψ H' - 3 • H') = 0
      rw [map_sub, map_nsmul, hψaug, hH'aug, smul_zero, sub_zero]
    have hmzero : m (ψ H' - 3 • H') = 0 := by
      rw [map_sub, map_nsmul, hmψ, hH'm, hj3]
      simp [nsmul_eq_mul]
    have hzero := eq_zero_of_rank_mZero y0W hy0W m hm (ψ H' - 3 • H') (by rw [hmem, map_zero]) hmzero
    exact sub_eq_zero.mp hzero

end

end Work.KT.D2
