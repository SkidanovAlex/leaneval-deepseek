import Mathlib

namespace Work.KT.D2

/-- Every additive subgroup of `ℤ` is generated by a single element, i.e. it is
`AddSubgroup.zmultiples g` for some `g : ℤ`. -/
theorem int_addSubgroup_eq_zmultiples (K : AddSubgroup ℤ) :
    ∃ g : ℤ, K = AddSubgroup.zmultiples g := by
  obtain ⟨a, ha⟩ := Int.subgroup_cyclic K
  exact ⟨a, by rw [ha, AddSubgroup.zmultiples_eq_closure]⟩

end Work.KT.D2
