import Mathlib
import Submission.Work.KT.Fund.Laurent
import Submission.Work.KT.Bott.LauDefs
import Submission.Work.KT.isUnit_one_sub_of_matNorm_lt_one
import Submission.Work.KT.Bott.laurent_dense
import Submission.Work.KT.Bott.seg_unit

/-!
# `Work.KT.Bott.laurent_approx` — Laurent approximation of invertible matrices over `C(X × S¹, ℂ)`

Every invertible square matrix `u` over `C(X × S¹, ℂ)` (`X` compact Hausdorff, `S¹ = Sph ℂ`) is
homotopic through invertible matrices to the image of a matrix `P` of Laurent polynomials with
coefficients in `C(X, ℂ)`.  Route: Laurent polynomials are dense in `C(X × S¹, ℂ)`
(`Work.KT.Bott.laurent_dense`, Stone–Weierstrass for the star-subalgebra generated by the
pullbacks along `X × S¹ → X`, by `z` and by `z̄ = z⁻¹`); approximate `u` entrywise by
`P.map (laurentMap X)` with error small enough that `mNorm (u - P.map (laurentMap X)) * mNorm u⁻¹ < 1`;
then the Neumann series criterion `Work.KT.isUnit_one_sub_of_matNorm_lt_one` shows both
`P.map (laurentMap X)` and every matrix on the straight line from `u` to it are invertible
(`Work.KT.Bott.seg_unit`).
-/

namespace Work.KT.Bott

open Matrix

/-- If every entry of `M` is small in the `ℓ∞` norm (`‖M i j‖ < δ/(n+1)`) then `mNorm n M < δ`. -/
lemma mNorm_lt_of_entry_lt {R : Type*} [NormedRing R] (n : ℕ) (M : Matrix (Fin n) (Fin n) R)
    (δ : NNReal) (hδ : 0 < δ) (h : ∀ i j, ‖M i j‖₊ < δ / (n + 1)) : LauDefs.mNorm n M < δ := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    simpa [LauDefs.mNorm] using hδ
  · haveI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hn
    rw [LauDefs.mNorm, Finset.sup_lt_iff hδ]
    intro i _
    calc ∑ j, ‖M i j‖₊ < ∑ _j : Fin n, (δ / (↑n + 1)) :=
          Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun j _ => h i j
      _ = n * (δ / (n + 1)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ δ := by
          have h1 : (n : NNReal) / (n + 1) ≤ 1 := by
            rw [div_le_one (by positivity)]
            exact_mod_cast Nat.le_succ n
          calc n * (δ / (n + 1)) = ((n : NNReal) / (n + 1)) * δ := by ring
            _ ≤ 1 * δ := mul_le_mul_of_nonneg_right h1 (zero_le)
            _ = δ := one_mul δ

/-- `(σ+1)⁻¹ * σ < 1` in `ℝ≥0`. -/
lemma inv_add_one_mul_lt_one (σ : NNReal) : (σ + 1)⁻¹ * σ < 1 := by
  have hpos : (0 : NNReal) < (σ + 1)⁻¹ := by
    rw [inv_pos]
    positivity
  have h : (σ + 1)⁻¹ * σ < (σ + 1)⁻¹ * (σ + 1) :=
    mul_lt_mul_of_pos_left (lt_add_one σ) hpos
  rwa [inv_mul_cancel₀ (by positivity : σ + 1 ≠ 0)] at h

/-- Entrywise Laurent approximation of a matrix: for every `δ > 0` there is a matrix `P` of
Laurent polynomials with coefficients in `C(X, ℂ)` whose image under `laurentMap X` is within `δ`
of `u` in the `ℓ∞` operator norm. -/
theorem mat_approx (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] (n : ℕ)
    (u : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ)) (δ : NNReal)
    (hδ : 0 < δ) :
    ∃ P : Matrix (Fin n) (Fin n) (LaurentPolynomial C(X, ℂ)),
      LauDefs.mNorm n (u - P.map (laurentMap X)) < δ := by
  have hδ' : (0 : ℝ) < (δ : ℝ) := by exact_mod_cast hδ
  have hε : (0 : ℝ) < (δ : ℝ) / ((n : ℝ) + 1) := by positivity
  choose p hp using fun i j => laurent_dense X (u i j) ((δ : ℝ) / ((n : ℝ) + 1)) hε
  let P : Matrix (Fin n) (Fin n) (LaurentPolynomial C(X, ℂ)) := fun i j => p i j
  refine ⟨P, ?_⟩
  refine mNorm_lt_of_entry_lt n _ δ hδ fun i j => ?_
  have hPij : P i j = p i j := rfl
  have hentry : (u - P.map (laurentMap X)) i j = u i j - laurentMap X (p i j) := by
    simp [Matrix.map_apply, hPij]
  have hεeq : ((δ / (n + 1) : NNReal) : ℝ) = (δ : ℝ) / ((n : ℝ) + 1) := by
    push_cast
    ring
  rw [hentry, ← NNReal.coe_lt_coe, hεeq]
  change ‖u i j - laurentMap X (p i j)‖ < (δ : ℝ) / ((n : ℝ) + 1)
  rw [norm_sub_rev]
  exact hp i j

/-- Every invertible matrix over `C(X × S¹, ℂ)` (`X` compact Hausdorff, `S¹ = Sph ℂ`) is homotopic
through invertible matrices to the image of a matrix `P` of Laurent polynomials with coefficients
in `C(X, ℂ)`. -/
theorem laurent_approx (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] (n : ℕ)
    (u : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ)) (hu : IsUnit u) :
    ∃ P : Matrix (Fin n) (Fin n) (LaurentPolynomial C(X, ℂ)),
      IsUnit (P.map (laurentMap X)) ∧
      ∃ H : Matrix (Fin n) (Fin n) C((X × Sph ℂ) × unitInterval, ℂ),
        IsUnit H ∧
        (∀ (i j : Fin n) (x : X) (s : Sph ℂ), H i j ((x, s), 0) = u i j (x, s)) ∧
        (∀ (i j : Fin n) (x : X) (s : Sph ℂ),
          H i j ((x, s), 1) = P.map (laurentMap X) i j (x, s)) := by
  set A : Matrix (Fin n) (Fin n) C(X × Sph ℂ, ℂ) := (hu.unit⁻¹).val with hA
  have h1 : u * A = 1 := by
    rw [hA]
    simpa [IsUnit.unit_spec] using hu.unit.mul_inv
  have h2 : A * u = 1 := by
    rw [hA]
    simpa [IsUnit.unit_spec] using hu.unit.inv_mul
  set σ : NNReal := LauDefs.mNorm n A with hσ
  obtain ⟨P, hP⟩ := mat_approx X n u ((σ + 1)⁻¹) (by rw [inv_pos]; positivity)
  have hb : LauDefs.mNorm n (u - P.map (laurentMap X)) * LauDefs.mNorm n A < 1 := by
    rw [← hσ]
    exact lt_of_le_of_lt
      (mul_le_mul_of_nonneg_right (le_of_lt hP) (zero_le)) (inv_add_one_mul_lt_one σ)
  obtain ⟨hV, hH⟩ := seg_unit n u (P.map (laurentMap X)) A h1 h2 hb
  exact ⟨P, hV, LauDefs.seg u (P.map (laurentMap X)), hH,
    fun i j x s => LauDefs.seg_apply_zero u (P.map (laurentMap X)) i j (x, s),
    fun i j x s => LauDefs.seg_apply_one u (P.map (laurentMap X)) i j (x, s)⟩

end Work.KT.Bott
