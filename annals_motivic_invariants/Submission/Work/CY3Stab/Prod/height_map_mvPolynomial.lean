/-!
# `Work.CY3Stab.Prod.height_map_mvPolynomial`

Let `A` be a Noetherian domain and `𝔭 ≤ A` a prime ideal of height one.  For any type `n` of
variables, the extension `𝔭 · A[X_i]` of `𝔭` to the polynomial ring `MvPolynomial n A` is again a
prime ideal of height one.

## Mathematical content

* `A → MvPolynomial n A` is free (hence flat), so it is a domain extension and
  `𝔭 · A[X_i]` is the kernel of the reduction `A[X_i] → (A ⧸ 𝔭)[X_i]`
  (`map_algebraMap_eq_ker`); the quotient is a polynomial ring over the domain `A ⧸ 𝔭`, so
  `𝔭 · A[X_i]` is prime and contracts back to `𝔭` (`isPrime_map_algebraMap`,
  `comap_map_algebraMap_eq`).
* The **lower bound** `1 ≤ ht (𝔭 · A[X_i])` always holds: `⊥ < 𝔭 · A[X_i]` because `𝔭 ≠ ⊥`
  (`Ideal.ne_bot_of_height_eq_one`) and `A → MvPolynomial n A` is injective.
* For the **upper bound** one uses Matsumura's height formula
  `Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown` in the Noetherian case.  Since
  `MvPolynomial n A` need *not* be Noetherian when `n` is infinite, the general case is reduced to
  the finite-index case: any prime `q ⊊ 𝔭 · A[X_i]` involves only finitely many variables, so
  it can be restricted to the sub-polynomial-ring `MvPolynomial s A` generated by the (finite) set
  `s` of variables occurring in an element of `q` (`MvPolynomial.supported`,
  `MvPolynomial.supported_eq_range_rename`); there the height formula applies, and since `q` does
  not contract to `𝔭` it must be `⊥`.  Hence the primes below `𝔭 · A[X_i]` are exactly `⊥` and
  `𝔭 · A[X_i]` itself.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.CY3Stab.Prod

open MvPolynomial

section Basic

variable {A : Type} [CommRing A]

/-- The ideal of `MvPolynomial σ A` generated by `𝔭` is the kernel of the reduction
`MvPolynomial σ A → MvPolynomial σ (A ⧸ 𝔭)`: a polynomial is congruent to zero modulo `𝔭` exactly
when all of its coefficients lie in `𝔭`. -/
theorem map_algebraMap_eq_ker (𝔭 : Ideal A) (σ : Type) :
    𝔭.map (algebraMap A (MvPolynomial σ A))
      = RingHom.ker (MvPolynomial.map (Ideal.Quotient.mk 𝔭)) := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, MvPolynomial.algebraMap_eq, MvPolynomial.map_C]
    simp [Ideal.Quotient.eq_zero_iff_mem, ha]
  · intro f hf
    rw [RingHom.mem_ker] at hf
    have hcoeff : ∀ m : σ →₀ ℕ, f.coeff m ∈ 𝔭 := by
      intro m
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← MvPolynomial.coeff_map]
      exact congrArg (fun g => g.coeff m) hf
    rw [MvPolynomial.as_sum f]
    refine Ideal.sum_mem _ fun m _ => ?_
    rw [← mul_one (f.coeff m), ← MvPolynomial.C_mul_monomial]
    refine Ideal.mul_mem_right _ _ ?_
    have h := Ideal.mem_map_of_mem (algebraMap A (MvPolynomial σ A)) (hcoeff m)
    rwa [MvPolynomial.algebraMap_eq] at h

/-- The extension of a prime ideal `𝔭` of `A` to `MvPolynomial σ A` is prime: the cokernel is the
polynomial ring over the domain `A ⧸ 𝔭`. -/
theorem isPrime_map_algebraMap {𝔭 : Ideal A} (h𝔭 : 𝔭.IsPrime) (σ : Type) :
    (𝔭.map (algebraMap A (MvPolynomial σ A))).IsPrime := by
  rw [map_algebraMap_eq_ker]
  haveI : IsDomain (A ⧸ 𝔭) := Ideal.Quotient.isDomain 𝔭
  haveI : IsDomain (MvPolynomial σ (A ⧸ 𝔭)) := inferInstance
  rw [Ideal.isPrime_iff]
  refine ⟨RingHom.ker_ne_top _, fun {x y} hxy => ?_⟩
  rw [RingHom.mem_ker] at hxy ⊢
  rw [map_mul, mul_eq_zero] at hxy
  exact hxy.imp id id

/-- The extension `𝔭 · A[X_i]` contracts back to `𝔭`. -/
theorem comap_map_algebraMap_eq (𝔭 : Ideal A) (σ : Type) :
    (𝔭.map (algebraMap A (MvPolynomial σ A))).comap (algebraMap A (MvPolynomial σ A)) = 𝔭 := by
  ext a
  rw [Ideal.mem_comap, map_algebraMap_eq_ker, RingHom.mem_ker, MvPolynomial.algebraMap_eq,
    MvPolynomial.map_C]
  constructor
  · intro h
    rw [← map_zero MvPolynomial.C] at h
    exact Ideal.Quotient.eq_zero_iff_mem.mp ((MvPolynomial.C_injective σ (A ⧸ 𝔭)) h)
  · intro h
    simp [Ideal.Quotient.eq_zero_iff_mem.mpr h]

/-- Contracting the extension of `𝔭` along a `rename` of variables is the extension of `𝔭` in the
smaller polynomial ring. -/
theorem comap_rename_map_algebraMap {σ τ : Type} (𝔭 : Ideal A) (i : σ → τ)
    (hi : Function.Injective i) :
    (𝔭.map (algebraMap A (MvPolynomial τ A))).comap (MvPolynomial.rename i)
      = 𝔭.map (algebraMap A (MvPolynomial σ A)) := by
  rw [map_algebraMap_eq_ker (𝔭 := 𝔭) (σ := τ), map_algebraMap_eq_ker (𝔭 := 𝔭) (σ := σ)]
  ext x
  rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker, MvPolynomial.map_rename,
    ← map_zero (MvPolynomial.rename (R := A ⧸ 𝔭) i),
    (MvPolynomial.rename_injective (R := A ⧸ 𝔭) i hi).eq_iff]

/-- **Matsumura's formula in the finite case.**  If `σ` is finite, then `MvPolynomial σ A` is
Noetherian over the Noetherian ring `A`, so Matsumura's height formula
`Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown` applies to `P = 𝔭 · A[X_i]`: the height of
`P` is `ht 𝔭` plus the height of the image of `P` in the fibre `(A ⧸ 𝔭)[X_i]`, which is zero. -/
theorem height_map_algebraMap_mvPolynomial_of_finite {𝔭 : Ideal A} [IsNoetherianRing A]
    (h𝔭 : 𝔭.IsPrime) (h1 : 𝔭.height = 1) (σ : Type) [Finite σ] :
    (𝔭.map (algebraMap A (MvPolynomial σ A))).height = 1 := by
  haveI := h𝔭
  haveI : IsNoetherianRing (MvPolynomial σ A) := inferInstance
  have hP : (𝔭.map (algebraMap A (MvPolynomial σ A))).IsPrime := isPrime_map_algebraMap h𝔭 σ
  haveI := hP
  have hLies : (𝔭.map (algebraMap A (MvPolynomial σ A))).LiesOver 𝔭 :=
    ⟨(comap_map_algebraMap_eq 𝔭 σ).symm⟩
  haveI := hLies
  have hheight := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown 𝔭
    (𝔭.map (algebraMap A (MvPolynomial σ A)))
  rw [h1, Ideal.map_quotient_self, Ideal.height_bot, add_zero] at hheight
  exact hheight

/-- A prime ideal strictly below a height one prime of a domain is `⊥`. -/
theorem eq_bot_of_lt_of_height_eq_one {𝔭 J : Ideal A} [IsDomain A]
    (h𝔭 : 𝔭.IsPrime) (h1 : 𝔭.height = 1) (hJ : J.IsPrime) (hlt : J < 𝔭) : J = ⊥ := by
  haveI := h𝔭
  haveI := hJ
  have hlt1 : J.height < (1 : ℕ∞) :=
    (Ideal.height_le_iff (p := 𝔭) (n := 1)).mp h1.le J hJ hlt
  rw [Order.lt_one_iff] at hlt1
  exact Ideal.height_eq_zero_iff_eq_bot.mp hlt1

/-- **Key reduction step.**  A prime `q` of `MvPolynomial n A` strictly contained in the extension
of a height one prime `𝔭` is `⊥`.  The proof restricts `q` to the sub-polynomial-ring generated by
the finitely many variables occurring in a non-zero element of `q`; there the finite case
`height_map_algebraMap_mvPolynomial_of_finite` bounds the height of the extension of `𝔭` by one,
while `q` does not contract to `𝔭` (it contracts to `⊥`), so its restriction – being a prime
strictly below the extension of `𝔭` in the smaller ring – must be `⊥`. -/
theorem eq_bot_of_le_map_algebraMap_of_ne {𝔭 : Ideal A} [IsDomain A] [IsNoetherianRing A]
    (h𝔭 : 𝔭.IsPrime) (h1 : 𝔭.height = 1) (n : Type) (q : Ideal (MvPolynomial n A))
    (hq : q.IsPrime) (hle : q ≤ 𝔭.map (algebraMap A (MvPolynomial n A)))
    (hne : q ≠ 𝔭.map (algebraMap A (MvPolynomial n A))) : q = ⊥ := by
  haveI := hq
  by_contra hqbot
  have h𝔭bot : 𝔭 ≠ ⊥ := Ideal.ne_bot_of_height_eq_one h1
  -- `q` contracts to `⊥` in `A`.
  have hqA : q.comap (algebraMap A (MvPolynomial n A)) = ⊥ := by
    refine eq_bot_of_lt_of_height_eq_one h𝔭 h1 (Ideal.comap_isPrime _ q) ?_
    rw [lt_iff_le_and_ne]
    refine ⟨(Ideal.comap_mono hle).trans (le_of_eq (comap_map_algebraMap_eq 𝔭 n)), ?_⟩
    intro h
    exact hne (le_antisymm hle (Ideal.map_le_iff_le_comap.mpr (h ▸ le_rfl)))
  obtain ⟨f, hfq, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hqbot
  -- `f` involves only finitely many variables.
  let s : Set n := ↑f.vars
  haveI : Finite s := (Finset.finite_toSet f.vars).to_subtype
  let ρ : MvPolynomial s A →ₐ[A] MvPolynomial n A := MvPolynomial.rename Subtype.val
  have hfs : f ∈ ρ.range := by
    rw [← MvPolynomial.supported_eq_range_rename s]
    exact MvPolynomial.mem_supported_vars f
  obtain ⟨g, hg⟩ := hfs
  let q' : Ideal (MvPolynomial s A) := q.comap ρ
  have hq's : q'.IsPrime := Ideal.comap_isPrime ρ q
  haveI := hq's
  have hgq' : g ∈ q' := Ideal.mem_comap.mpr (hg ▸ hfq)
  have hg0 : g ≠ 0 := fun h => hf0 (by rw [← hg, h, map_zero])
  have hq'bot : q' ≠ ⊥ := by
    intro h
    rw [h] at hgq'
    exact hg0 (by simpa using hgq')
  have hle' : q' ≤ 𝔭.map (algebraMap A (MvPolynomial s A)) := by
    intro x hx
    rw [← comap_rename_map_algebraMap 𝔭 Subtype.val Subtype.val_injective]
    exact Ideal.mem_comap.mpr (hle (Ideal.mem_comap.mp hx))
  have hqA' : q'.comap (algebraMap A (MvPolynomial s A)) = ⊥ := by
    rw [eq_bot_iff]
    intro a ha
    rw [Ideal.mem_bot]
    have h1' : algebraMap A (MvPolynomial n A) a ∈ q := by
      have h2' : ρ (algebraMap A (MvPolynomial s A) a) ∈ q :=
        Ideal.mem_comap.mp (Ideal.mem_comap.mp ha)
      simpa [ρ, MvPolynomial.algebraMap_eq] using h2'
    exact Ideal.mem_bot.mp (hqA ▸ Ideal.mem_comap.mpr h1')
  have hne' : q' ≠ 𝔭.map (algebraMap A (MvPolynomial s A)) := by
    intro h
    have hc : (⊥ : Ideal A) = 𝔭 := by rw [← hqA', h, comap_map_algebraMap_eq 𝔭 s]
    exact h𝔭bot hc.symm
  have hfin := height_map_algebraMap_mvPolynomial_of_finite h𝔭 h1 s
  haveI : (𝔭.map (algebraMap A (MvPolynomial s A))).IsPrime := isPrime_map_algebraMap h𝔭 s
  have hlt : q' < 𝔭.map (algebraMap A (MvPolynomial s A)) := lt_of_le_of_ne hle' hne'
  have hq'0 : q'.height = 0 := by
    have hle1 : (𝔭.map (algebraMap A (MvPolynomial s A))).height ≤ ((1 : ℕ) : ℕ∞) := by
      rw [hfin]; norm_num
    have hlt1 := (Ideal.height_le_iff (p := 𝔭.map (algebraMap A (MvPolynomial s A)))
      (n := 1)).mp hle1 q' hq's hlt
    exact Order.lt_one_iff.mp hlt1
  haveI : IsDomain (MvPolynomial s A) := inferInstance
  exact hq'bot (Ideal.height_eq_zero_iff_eq_bot.mp hq'0)

end Basic

/-- Let `A` be a Noetherian domain and `𝔭` a prime ideal of height one.  Then for any set of
variables `n`, the extension of `𝔭` to `MvPolynomial n A` is again a prime ideal of height one. -/
theorem height_map_mvPolynomial {A : Type} [CommRing A] [IsDomain A] [IsNoetherianRing A]
    (𝔭 : Ideal A) (h𝔭 : 𝔭.IsPrime) (h1 : 𝔭.height = 1) (n : Type) :
    (𝔭.map (algebraMap A (MvPolynomial n A))).height = 1 := by
  haveI := h𝔭
  refine le_antisymm ?_ ?_
  · -- every prime strictly below `𝔭 · A[X_i]` is `⊥`.
    haveI : (𝔭.map (algebraMap A (MvPolynomial n A))).IsPrime := isPrime_map_algebraMap h𝔭 n
    refine (Ideal.height_le_iff (p := 𝔭.map (algebraMap A (MvPolynomial n A))) (n := 1)).mpr ?_
    intro q hq hlt
    rw [eq_bot_of_le_map_algebraMap_of_ne h𝔭 h1 n q hq hlt.le (ne_of_lt hlt), Ideal.height_bot]
    exact zero_lt_one
  · -- `1 ≤ ht (𝔭 · A[X_i])` since `⊥ < 𝔭 · A[X_i]` and both are prime.
    haveI : (⊥ : Ideal (MvPolynomial n A)).IsPrime := Ideal.isPrime_bot
    haveI : (𝔭.map (algebraMap A (MvPolynomial n A))).IsPrime := isPrime_map_algebraMap h𝔭 n
    have hPbot : (𝔭.map (algebraMap A (MvPolynomial n A))) ≠ ⊥ := by
      intro h
      refine Ideal.ne_bot_of_height_eq_one h1 ?_
      rw [eq_bot_iff]
      intro a ha
      have hmem : algebraMap A (MvPolynomial n A) a
          ∈ (𝔭.map (algebraMap A (MvPolynomial n A))) := Ideal.mem_map_of_mem _ ha
      rw [h, Ideal.mem_bot] at hmem
      rw [MvPolynomial.algebraMap_eq, ← map_zero MvPolynomial.C] at hmem
      exact (MvPolynomial.C_injective n A) hmem
    have hlt : (⊥ : Ideal (MvPolynomial n A)) < 𝔭.map (algebraMap A (MvPolynomial n A)) :=
      bot_lt_iff_ne_bot.mpr hPbot
    have hheight := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    rw [Ideal.height_bot, zero_add] at hheight
    exact hheight

end Work.CY3Stab.Prod
