import Mathlib

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

namespace Work.CY3Stab.Prod

/-- If `A` is a faithfully flat `B`-algebra (both `CommRing`, `A` nontrivial), then the elements
of the fraction field `KB` of `B` whose image under `st : KB →+* KA` lies in the image of `A` in
`KA` are themselves in the image of `B` — i.e. `A ∩ Frac(B) = B` inside `KA`.

Proof route: write `t * algebraMap B KB y = algebraMap B KB x` with `y ∈ nonZeroDivisors B`
(`IsLocalization.surj`); from `h` obtain `a : A` with `algebraMap A KA a = st t`, apply `st` and
`hst`, use injectivity of `algebraMap A KA` (`IsFractionRing.injective`) to get
`algebraMap B A x = algebraMap B A y * a` in `A`, hence `x ∈ (Ideal.span {y}).comap (algebraMap B A)`;
`Ideal.comap_map_eq_self_of_faithfullyFlat`
(`Mathlib/RingTheory/Flat/FaithfullyFlat/Algebra.lean`) then gives `x ∈ Ideal.span {y}`, say
`x = y * c`, and cancelling `algebraMap B KB y ≠ 0` in `KB` gives `t = algebraMap B KB c`. -/
theorem exists_algebraMap_eq_of_algebraMap_comp_eq
    {B A KB KA : Type} [CommRing B] [CommRing A] [Field KB] [Field KA]
    [Algebra B KB] [IsFractionRing B KB] [Algebra A KA] [IsFractionRing A KA]
    [Algebra B A] [Module.FaithfullyFlat B A] [Nontrivial A]
    (st : KB →+* KA)
    (hst : ∀ b : B, st (algebraMap B KB b) = algebraMap A KA (algebraMap B A b))
    (t : KB) (h : ∃ a : A, algebraMap A KA a = st t) : ∃ b : B, algebraMap B KB b = t := by
  rcases h with ⟨a, ha⟩
  -- Write `t` as a fraction `x / y` with `y ∈ nonZeroDivisors B`.
  obtain ⟨⟨x, y⟩, hxy⟩ := IsLocalization.surj (nonZeroDivisors B) t
  -- Apply `st` and rewrite using `ha` and `hst`.
  have h1 : st t * st (algebraMap B KB (↑y)) = st (algebraMap B KB x) := by
    rw [← map_mul, hxy]
  have h2 : algebraMap A KA (a * algebraMap B A (↑y)) = algebraMap A KA (algebraMap B A x) := by
    rw [← ha, hst, hst, ← map_mul] at h1
    exact h1
  -- Injectivity of `algebraMap A KA` gives the relation in `A`.
  have h3 : a * algebraMap B A (↑y) = algebraMap B A x := IsFractionRing.injective A KA h2
  -- Hence `x` lies in the contraction of the ideal generated by `algebraMap B A y`.
  have hmem : x ∈ (Ideal.span {algebraMap B A (↑y)} : Ideal A).comap (algebraMap B A) := by
    rw [Ideal.mem_comap, ← h3, Ideal.mem_span_singleton]
    exact ⟨a, by ring⟩
  have hspan : (Ideal.span {(↑y : B)} : Ideal B).map (algebraMap B A)
      = Ideal.span {algebraMap B A (↑y)} := by
    rw [Ideal.map_span, Set.image_singleton]
  -- Faithful flatness lets us contract the extension back.
  have hxmem : x ∈ (Ideal.span {(↑y : B)} : Ideal B) := by
    rw [← hspan] at hmem
    rwa [Ideal.comap_map_eq_self_of_faithfullyFlat (Ideal.span {(↑y : B)})] at hmem
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hxmem
  refine ⟨c, ?_⟩
  -- Cancel the nonzero image of `y` in the field `KB`.
  have hy0 : algebraMap B KB (↑y) ≠ 0 :=
    (IsLocalization.map_units KB y).ne_zero
  rw [hc, map_mul] at hxy
  have heq : t * algebraMap B KB (↑y) = algebraMap B KB c * algebraMap B KB (↑y) := by
    rw [hxy]; exact mul_comm _ _
  exact (mul_right_cancel₀ hy0 heq).symm

end Work.CY3Stab.Prod
