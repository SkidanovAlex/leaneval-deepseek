/-!
# `totient m ≤ [ℚ(ζ_m) : ℚ]` for a cyclotomic extension of a number field

For any number field `K` and any `m ≠ 0`, the `m`-th cyclotomic extension `CyclotomicField m K`
(defined in Mathlib as the splitting field over `K` of `cyclotomic m K`) has `ℚ`-dimension at
least `Nat.totient m`.

Indeed `CyclotomicField m K` is a cyclotomic extension of `K`, so it contains a primitive `m`-th
root of unity `ζ`.  Then `ℚ⟮ζ⟯ ⊆ CyclotomicField m K` and `ℚ⟮ζ⟯` is a cyclotomic extension of `ℚ`,
so `[ℚ⟮ζ⟯ : ℚ] = m.totient` because `cyclotomic m ℚ` is irreducible.  Taking `ℚ`-dimensions gives
the claim.

The `ℚ`-dimension of `CyclotomicField m K` is exactly `m.totient * [K : ℚ]`; the statement below
only needs the easy inequality.
-/

namespace Work.TorsorExistence

theorem totient_le_finrank_rat_cyclotomicField {K : Type*} [Field K] [NumberField K]
    (m : ℕ) [NeZero m] :
    Nat.totient m ≤ Module.finrank ℚ (CyclotomicField m K) := by
  -- A primitive `m`-th root of unity inside the cyclotomic extension of `K`.
  have hζ : IsPrimitiveRoot (IsCyclotomicExtension.zeta m K (CyclotomicField m K)) m :=
    IsCyclotomicExtension.zeta_spec m K (CyclotomicField m K)
  -- `ℚ`-dimension of the subfield generated by a primitive `m`-th root of unity is `m.totient`.
  have key := IsPrimitiveRoot.lcm_totient_le_finrank (K := ℚ) (L := CyclotomicField m K)
      (x := IsCyclotomicExtension.zeta m K (CyclotomicField m K))
      (y := IsCyclotomicExtension.zeta m K (CyclotomicField m K)) hζ hζ
      (by rw [Nat.lcm_self]; exact Polynomial.cyclotomic.irreducible_rat (NeZero.pos m))
  simpa [Nat.lcm_self] using key

end Work.TorsorExistence
