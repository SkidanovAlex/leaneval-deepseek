namespace Work.TorsorExistence

universe u

/-- A Galois extension of degree `5` is cyclic: its Galois group has `5` elements, so it is a
group of prime order, hence generated by any non-identity element.  Applied with `L` itself as
the top field, this produces a `CyclicExtension 𝕜 5`. -/
theorem nonempty_cyclicExtension_of_isGalois_finrank_five {𝕜 L : Type u} [Field 𝕜] [Field L]
    [Algebra 𝕜 L] [FiniteDimensional 𝕜 L] [IsGalois 𝕜 L] (h : Module.finrank 𝕜 L = 5) :
    Nonempty (CyclicExtension 𝕜 5) := by
  -- The Galois group of `L/𝕜` has `5` elements.
  have hcard : Nat.card (L ≃ₐ[𝕜] L) = 5 := by
    rw [IsGalois.card_aut_eq_finrank 𝕜 L, h]
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  -- A group of prime order is cyclic; take a generator.
  haveI : IsCyclic (L ≃ₐ[𝕜] L) := isCyclic_of_prime_card hcard
  obtain ⟨gen, hgen⟩ := IsCyclic.exists_generator (α := L ≃ₐ[𝕜] L)
  refine ⟨{ L := L
            finrank_eq := h
            gen := gen
            gen_generator := ?_
            orderOf_gen := ?_ }⟩
  · intro g
    have hmem : g ∈ Submonoid.powers gen :=
      (isOfFinOrder_of_finite gen).mem_powers_iff_mem_zpowers.mpr (hgen g)
    obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff g gen).mp hmem
    exact ⟨k, hk.symm⟩
  · rw [orderOf_eq_card_of_forall_mem_zpowers hgen, hcard]

end Work.TorsorExistence
