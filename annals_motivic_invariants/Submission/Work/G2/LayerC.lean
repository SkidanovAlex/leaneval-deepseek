/-- **The `ℤ`-model of Layer 3 of `thm:CY3`.**  Extends the `ℤ`-model of Layer 2
(`Work.G2.CY3ZModel`) by the `K`-triviality and Picard-rank-one facts about the two centres, the
two cubic self-intersections `14` and `42`, the `ℙ¹`-bundle bridge, and the two transports to
`𝔸⁵`, in each case base-change-uniformly in `𝕜`. -/
structure CY3DatumZ extends CY3ZModel where
  /-- **Named input** (`lem-nSBG2`, adjunction): the first centre is `K`-trivial. -/
  isKTrivial_bc : ∀ (𝕜 : Type) [Field 𝕜], Work.CY3.IsKTrivial 𝕜 (baseChangeZ 𝕜 ZZ)
  /-- **Named input**: the second centre is `K`-trivial. -/
  isKTrivial_bc' : ∀ (𝕜 : Type) [Field 𝕜], Work.CY3.IsKTrivial 𝕜 (baseChangeZ 𝕜 ZZ')
  /-- **Named input** (`lem-nSBG2` + Grothendieck–Lefschetz): the first centre has Picard rank
  one. -/
  picardOne_bc : ∀ (𝕜 : Type) [Field 𝕜], Work.CY3.PicardRankOne 𝕜 (baseChangeZ 𝕜 ZZ)
  /-- **Named input**: the second centre has Picard rank one. -/
  picardOne_bc' : ∀ (𝕜 : Type) [Field 𝕜], Work.CY3.PicardRankOne 𝕜 (baseChangeZ 𝕜 ZZ')
  /- **The two cubic self-intersections `c₁(M_𝕜|_Z)³ = 14`, `c₁(M'_𝕜|_{Z'})³ = 42`** (paper
  `lem-nSBG2`, `[IMOUG2]`: `c₁(M_𝕜|_Z)³ = c₁(M_ℤ)³·Z_ℤ` and `c₁(M'_𝕜|_{Z'})³ = c₁(M'_ℤ)³·Z'_ℤ`)
  are **not** fields of the model: they are computations in the intersection theory of the two
  individual centres, so they can only be hypotheses about the cubic input `C` that the *consumer*
  supplies.  See `Work.G2.CY3DatumZ.notIso`, whose two hypotheses `hZ`, `hZ'` are exactly these
  values, and `Submission/Work/Wire123/NOTES.md` §18–§19 for the decision record.  (An earlier
  version of this structure carried them as `∀ (𝕜) (C : CubicInput 𝕜), C.cubic … = 14`; quantified
  over *every* `C` they are refutable — the constant-zero `CubicInput` gives `0 = 14` — see
  `Work.Wire123.not_legacyCubicZ` / `G2Vacuous.lean` for the record of that shape.) -/
  /-- **Named input (the `ℙ¹`-bundle bridge)**: the exceptional divisor `y` of `ψ⁻¹` is birational
  to `ℙ¹ × Z`, and `x` to `ℙ¹ × Z'` (paper `lemma:L-link` (2) with `m = m' = 2`, and (L3) for the
  irreducibility of the exceptional divisors); hence a `𝕜`-isomorphism of the function fields of
  the two exceptional divisors forces `Z` and `Z'` to be stably birational
  (`Work.CY3.CY3Data.bridge_of_models` discharges this field from the geometric models). -/
  bridge_bc : ∀ (𝕜 : Type) [Field 𝕜],
    ResEquiv 𝕜 (link 𝕜).y (link 𝕜).x →
      Work.CY3.StablyBirational 𝕜 (baseChangeZ 𝕜 ZZ) (baseChangeZ 𝕜 ZZ')
  /-- **Named input (F1)**: the exceptional divisor `y_𝕜` of the link is a `ℙ¹`-bundle over the
  first centre `Z_𝕜 = Z(p_*σ)`, i.e. `κ(y_𝕜) ≅ RatFunc (κ(Z_𝕜))` (paper `lemma:L-link` (2) with
  `m = m' = 2`, and (L3) for the irreducibility of the exceptional divisor).  This is the field
  `Work.CY3.CY3Data.p1Bundle_y`; it is the same clause as the K3 area's
  `Work.K3Inputs.LinkCore.y_cylinder`. -/
  p1Bundle_bc : ∀ (𝕜 : Type) [Field 𝕜],
    Work.K3Inputs.IsP1BundleOver 𝕜 (link 𝕜).y (baseChangeZ 𝕜 ZZ)
  /-- **Named input (F1)**: the exceptional divisor `x_𝕜` of the link is a `ℙ¹`-bundle over the
  second centre `Z'_𝕜`.  This is the field `Work.CY3.CY3Data.p1Bundle_x`. -/
  p1Bundle_bc' : ∀ (𝕜 : Type) [Field 𝕜],
    Work.K3Inputs.IsP1BundleOver 𝕜 (link 𝕜).x (baseChangeZ 𝕜 ZZ')
  /-- **Named input (strong rationality of the two `G₂`-Grassmannians, at the base point)**: a
  birational identification `ε_𝕜 : 𝔸⁵ ⇢ G_𝕜/P_𝕜` over `𝕜` and a birational identification
  `δ_𝕜 : G_𝕜/P'_𝕜 ⇢ 𝔸⁵` over `𝕜`, both with vanishing coefficient at the base point `y_𝕜` of the
  link.  See `Submission/Work/CY3/NOTES.md` §3.1 for why these transports are inputs and not a
  consequence of strong rationality: between `𝔸ⁿ` and a projective variety no transport can have
  all its coefficients zero, so only the vanishing at the base point is required. -/
  transports_bc : ∀ (𝕜 : Type) [Field 𝕜],
    ∃ (ε : (Work.CY3.Affine 𝕜 5).BirationalMap (baseChangeZ 𝕜 GP))
      (δ : (baseChangeZ 𝕜 GP').BirationalMap (Work.CY3.Affine 𝕜 5)),
      (ε.IsOver (Spec (.of 𝕜))) ∧ (δ.IsOver (Spec (.of 𝕜))) ∧
        cInv 𝕜 (link 𝕜).y ε = 0 ∧ cInv 𝕜 (link 𝕜).y δ = 0

namespace CY3DatumZ

variable (M : CY3DatumZ)

/-- **The two centres of the `𝕜`-link are not isomorphic over `𝕜`** (paper `lem-nSBG2`): proved
from the two cubic self-intersections `14` and `42` of the model and the named input `CubicInput`
(isomorphism-invariance of `c₁(M)³`), through the arithmetic `14 ≠ 42`
(`Work.G2.not_isoOver_of_cubic`).

The `notIso` field of `Work.CY3.CY3Input` *is* this statement, so no separate named input is
needed for it. -/
theorem notIso (𝕜 : Type) [Field 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42) :
    ¬ Work.CY3.IsoOver 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ') :=
  not_isoOver_of_cubic C hZ hZ'

/-- **The `𝕜`-datum of the CY3 L-link**, `Work.CY3.CY3Data 𝕜`, from the `ℤ`-model.

The model of `Z_𝕜 × ℙ¹` is `G_𝕜/P'_𝕜` with base point the exceptional divisor `y_𝕜` itself, whose
function field is `κ(Z)(t)` by construction; the two transports are the model's, so that the
transported Cremona map has the same coefficient as `ψ_𝕜` (`Work.CY3.CY3Data.cInv_toBirationalMap_eq`). -/
def toCY3Data (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] : Work.CY3.CY3Data 𝕜 where
  toCY3Section := M.toCY3Section 𝕜
  isKTrivial_Z := M.isKTrivial_bc 𝕜
  isKTrivial_Z' := M.isKTrivial_bc' 𝕜
  picardOne_Z := M.picardOne_bc 𝕜
  picardOne_Z' := M.picardOne_bc' 𝕜
  ZW := baseChangeZ 𝕜 M.GP'
  overZW := @Variety.over 𝕜 _ (baseChangeZ 𝕜 M.GP') (instVarietyZ 𝕜 M.GP')
  z₀ := (M.link 𝕜).y
  resEquiv_y :=
    @Work.Motivic.ResEquiv.refl 𝕜 _ (baseChangeZ 𝕜 M.GP')
      (@Variety.over 𝕜 _ (baseChangeZ 𝕜 M.GP') (instVarietyZ 𝕜 M.GP')) (M.link 𝕜).y
  bridge := M.bridge_bc 𝕜
  p1Bundle_y := M.p1Bundle_bc 𝕜
  p1Bundle_x := M.p1Bundle_bc' 𝕜
  eps := (M.transports_bc 𝕜).choose
  isOverEps := (M.transports_bc 𝕜).choose_spec.choose_spec.1
  delta := (M.transports_bc 𝕜).choose_spec.choose
  isOverDelta := (M.transports_bc 𝕜).choose_spec.choose_spec.2.1
  cInv_eps := (M.transports_bc 𝕜).choose_spec.choose_spec.2.2.1
  cInv_delta := (M.transports_bc 𝕜).choose_spec.choose_spec.2.2.2

/-- **The input of the CY3 chapter**: `Work.CY3.CY3Input 𝕜`, i.e. the geometric datum of the
`G₂`-Grassmannian L-link together with the non-isomorphism of its two centres.  This is the
conclusion of the construction of `thm:CY3`; the CY3 chapter proves Theorem 1.2 (3) of the
challenge from it. -/
def toCY3Input (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42) :
    Work.CY3.CY3Input 𝕜 where
  data := M.toCY3Data 𝕜
  notIso := M.notIso 𝕜 C hZ hZ'

/-- **The CY3 L-link of the model**: `Work.CY3.CY3Link 𝕜`, i.e. the geometric datum together with
the non-triviality input `κ(y) ≇ κ(x)` (which `Work.G2.CY3DatumZ.notIso` and Totaro's input
produce, `Work.CY3.CY3Data.not_resEquiv_yx_of_totaro`).  Its invariant coefficient is exactly `1`
(`Work.G2.CY3DatumZ.inv_eq_one`). -/
def toCY3Link (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (T : Work.CY3.TotaroInputAt 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    Work.CY3.CY3Link 𝕜 :=
  (M.toCY3Data 𝕜).toCY3Link T (M.notIso 𝕜 C hZ hZ')

/-- **The CY3 L-link of the model, with Totaro's theorem *at the pair* of the two centres** (the
per-pair form `Work.CY3.TotaroInputAt`, consistent where the universal `Work.CY3.TotaroInput` is
refutable — `Work.Wire123.not_totaroInput`).  It is the form the repair of
`Submission/Work/Wire123/PATCH.md` routes the chain through; after the lead's sign-off
(`Submission/Work/Wire123/INVENTORY.md`) the *main* member `Work.G2.CY3DatumZ.toCY3Link` also
takes the per-pair input, so the two agree (up to the pair orientation, `Work.Wire123.ReScope`). -/
def toCY3LinkOfSep (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (hsep : ¬ Work.CY3.StablyBirational 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    Work.CY3.CY3Link 𝕜 where
  toCY3Data := M.toCY3Data 𝕜
  not_resEquiv_yx := fun hres => hsep ((M.toCY3Data 𝕜).bridge hres)

/-- **The invariant coefficient of the model's link map `ψ_𝕜` itself** (before the transport to
`𝔸⁵`), with base point the exceptional divisor `y_𝕜`: `cInv 𝕜 y_𝕜 ψ_𝕜 = 1`.  This is the paper's
`c(ψ) = [ℙ¹ × Z_𝕜] − [ℙ¹ × Z'_𝕜]` evaluated at `[κ(Z)(t)]`, and it is a *proved* statement about
the model (`Work.CY3.CY3Link.invAtY_eq_one`), with no transport involved. -/
theorem cInv_psi (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (T : Work.CY3.TotaroInputAt 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    cInv 𝕜 (M.toCY3Link 𝕜 C hZ hZ' T).y (M.toCY3Link 𝕜 C hZ hZ' T).psi = 1 :=
  Work.CY3.CY3Link.invAtY_eq_one _

/-- The two centres of the CY3 datum are not stably birational (paper `lem-nSBG2` + Totaro's
`cor-CYnSB`), in the form in which the `W`-stabilisation of the link uses it. -/
theorem not_stablyBirational (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (T : Work.CY3.TotaroInputAt 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    ¬ Work.CY3.StablyBirational 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ') :=
  Work.CY3.CY3Input.not_stablyBirational 𝕜 (M.toCY3Input 𝕜 C hZ hZ') T

/-- **The pair form of the previous theorem**: from the separation of the two centres *at the pair*
(the per-pair statement `Work.CY3.TotaroInputAt`, i.e. `lem-nSBG2` + `cor-CYnSB` for the two
`K`-trivial threefolds of Picard rank one), rather than from the universal — and refutable —
`Work.CY3.TotaroInput`. -/
theorem not_stablyBirational_of_sep (𝕜 : Type) [Field 𝕜] [Infinite 𝕜]
    (hsep : ¬ Work.CY3.StablyBirational 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    ¬ Work.CY3.StablyBirational 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ') := hsep

/-- **The invariant coefficient of the model's link is exactly `1`.**

This is the end-to-end statement of the `G₂`-area: the `𝕜`-data built from the `ℤ`-model
(`Work.G2.CY3DatumZ.toCY3Data`), together with the non-isomorphism of the two centres proved from
`14 ≠ 42` (`Work.G2.CY3DatumZ.notIso`), makes the CY3 chapter's L-link (`Work.CY3.CY3Data.toCY3Link`)
motivically non-trivial: its `[κ(Z)(t)]`-coefficient, an element of `Cr 𝕜 5 = Bir(𝔸⁵/𝕜)`, is `1`
(`Work.CY3.CY3Link.inv_eq_one`).  Nothing here is assumed beyond the `ℤ`-model, the cubic input and
Totaro's input. -/
theorem inv_eq_one (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (T : Work.CY3.TotaroInputAt 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    ((M.toCY3Data 𝕜).toCY3Link T (M.notIso 𝕜 C hZ hZ')).inv = 1 :=
  Work.CY3.CY3Link.inv_eq_one _

/-- **The coefficient of the model's link is `1`, with the pair form of Totaro's input**: the link
is built by `toCY3LinkOfSep` from the per-pair separation, and its invariant coefficient (an element
of `Cr 𝕜 5 = Bir(𝔸⁵/𝕜)`) is exactly `1`, i.e. non-zero. -/
theorem inv_eq_one_of_sep (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (hsep : ¬ Work.CY3.StablyBirational 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    (M.toCY3LinkOfSep 𝕜 C hZ hZ' hsep).inv = 1 :=
  Work.CY3.CY3Link.inv_eq_one _

end CY3DatumZ

/-! ## The challenge-level statement

The `G₂`-area delivers Theorem 1.2 (3) of the challenge for every `n ≥ 5` from the `ℤ`-model, the
isomorphism-invariance of the cubic self-intersection (`Work.G2.CubicInput`), Totaro's input and
the stabilisation input. -/

/-- **Theorem 1.2 (3) of the challenge, at `n = 5`**: over every infinite field, `Cr₅(𝕜)` is not
generated by pseudo-regularizable elements, from the `ℤ`-model of the `G₂`-Grassmannian L-link, the
cubic input, and Totaro's input. -/
theorem not_gen_of_G2_infiniteField_five (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (M : CY3DatumZ)
    (C : CubicInput 𝕜) (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14)
    (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (T : Work.CY3.TotaroInputAt 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ')) :
    ¬ GenByPseudoRegularizable 𝕜 5 :=
  Work.CY3.not_gen_of_CY3_infiniteField_five 𝕜 (M.toCY3Input 𝕜 C hZ hZ') T

/-- **Theorem 1.2 (3) of the challenge for `n ≥ 5`**, from the `n = 5` statement and the
stabilisation input of the CY3 chapter. -/
theorem not_gen_of_G2_infiniteField {n : ℕ} (hn : 5 ≤ n) (𝕜 : Type) [Field 𝕜] [Infinite 𝕜]
    (M : CY3DatumZ) (C : CubicInput 𝕜)
    (hZ : C.cubic (baseChangeZ 𝕜 M.ZZ) = 14) (hZ' : C.cubic (baseChangeZ 𝕜 M.ZZ') = 42)
    (T : Work.CY3.TotaroInputAt 𝕜 (baseChangeZ 𝕜 M.ZZ) (baseChangeZ 𝕜 M.ZZ'))
    (S : Work.CY3.CY3Stabilisation 𝕜 n) : ¬ GenByPseudoRegularizable 𝕜 n :=
  Work.CY3.not_gen_of_CY3_infiniteField hn 𝕜 (M.toCY3Input 𝕜 C hZ hZ') T S

end

end Work.G2
