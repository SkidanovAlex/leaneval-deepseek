-- The chart presentation of the AS (Artin-Schreier) twisted Klein curve, generic in the base
-- field `K`: the function field of the chart `y0 = 1` of the twisted Klein curve
-- `C_g = V(kleinPAS a b g)` is the AS twist field `twistFieldAS D g` (the `K`-subfield of
-- `OmA K D` generated by the AS Lagrange coordinate ratios `asTwY D g j / asTwY D g 0`).
-- This is the `RatFunc 𝕜 ↦ K` fork of `Work.MotAS.ASZChartPresentation_gen`
-- (`Submission/Work/MotAS/ASZChartPresentation.lean`), whose route is
-- `asChartPresentation_of_ker` (`MotAS/ASZChartSetup.lean`) followed by
-- `asChartKernelLe_of_aux` (`MotAS/asChartKernelLe.lean`) with the two inputs
-- `kerAevalKleinPAS_gen` (`MotAS/kerAevalKleinPAS_gen.lean`) and `asChartHomogenise`
-- (`MotAS/asChartHomogenisation.lean`); all of these are stated over `RatFunc 𝕜` and must be ported
-- to an arbitrary `𝕜`-algebra field `K`.  Needed for the generic K6 node
-- `Work.MotC5N3.ASZTwistDiv2` (at class `2 * g`).
theorem ASZChartPresentationGen (K : Type) [Field K] [CharP K 5] {𝕜 : Type} [Field 𝕜]
    [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (hD : Work.MotV5.KleinData.ASGood D) (g : K) :
    Nonempty (FractionRing (MvPolynomial (Fin 5) K ⧸
        Work.MotAS.asChartIdeal (Work.MotC5N3.aK K D) (Work.MotC5N3.bK K D) g) ≃ₐ[K]
      ↥(Work.MotC5N3.twistFieldAS D g)) := by
  haveI : CharP 𝕜 5 := charP_of_algebra_charP (𝕜 := 𝕜) (K := K)
  refine asChartPresentation_of_ker_A D hD.1 g ?_
  refine asChartKernelLe_of_aux_A D hD g (fun n F hF hF0 => ?_) (asChartHomogeniseA D hD g)
  exact kerAevalKleinPASGenAlt K D hD g n F hF hF0

end Work.MotC5N3
