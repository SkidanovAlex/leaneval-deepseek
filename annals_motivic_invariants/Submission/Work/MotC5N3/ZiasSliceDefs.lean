import Mathlib
import Submission.Work.MotAS.ASResidual
import Submission.Work.MotAS.ASRulV2.CertData

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# The `X 2 = 1` slice of the AS residual curve and its cleared certificate expression

For `K` a field of characteristic `5` and `a b g : K`, `Work.MotAS.ZIAS a b g` is the ideal of
`K[X 0, X 1, X 2]` generated by the five cubics `zcubAS a b g k = kleinRAS a b g ![1,X0,X1,X2,0] k`
of the AS residual curve (`ASResidual.lean`).

This file fixes the vocabulary for the *slice* at `X 2 = 1` and for the *cleared* graph
certificate of `Submission/Work/MotAS/ASRulV2/CertData.lean`:

* `slicePhi` — the `K`-algebra map `K[X0,X1,X2] → K[X0,X1]` with `X 0 ↦ X 0`, `X 1 ↦ X 1`,
  `X 2 ↦ 1` (so `Ideal.map slicePhi (ZIAS a b g) ≠ ⊤` is equivalent to
  `ZIAS a b g ⊔ (X 2 - 1) ≠ ⊤`, by `ASRulV2.zias_shift_reduce`);
* `slice a b g k = slicePhi (zcubAS a b g k)` — the `k`-th slice generator;
* `sliceCertExpr a b g k` — the cleared graph certificate expression
  `Ac ^ 3 · f_k(Ccert / Ac, X 1)`, written without denominators by clearing `Ac`:
  `∑_{j<4} [X 0 ^ j] f_k · Ccert ^ j · Ac ^ (3 - j)`.
-/

set_option autoImplicit false

namespace Work.MotC5N3

open MvPolynomial

/-- The slice substitution `X 2 ↦ 1`: the `K`-algebra map `K[X0,X1,X2] → K[X0,X1]` sending
`X 0 ↦ X 0`, `X 1 ↦ X 1` and `X 2 ↦ 1`. -/
noncomputable def slicePhi (K : Type*) [CommRing K] :
    MvPolynomial (Fin 3) K →ₐ[K] MvPolynomial (Fin 2) K :=
  MvPolynomial.aeval (fun i : Fin 3 =>
    (![MvPolynomial.X 0, MvPolynomial.X 1, (1 : MvPolynomial (Fin 2) K)] :
      Fin 3 → MvPolynomial (Fin 2) K) i)

section CommRing

variable {K : Type*} [CommRing K]

@[simp] theorem slicePhi_X0 : slicePhi K (MvPolynomial.X 0) = MvPolynomial.X 0 := by
  simp [slicePhi]

@[simp] theorem slicePhi_X1 : slicePhi K (MvPolynomial.X 1) = MvPolynomial.X 1 := by
  simp [slicePhi]

@[simp] theorem slicePhi_X2 : slicePhi K (MvPolynomial.X 2) = 1 := by
  simp [slicePhi]

end CommRing

section Field

variable {K : Type*} [Field K]

/-- The `X 2 = 1` slice of the AS residual curve: the `k`-th cubic `zcubAS a b g k` evaluated at
`X 2 = 1`. -/
noncomputable def slice (a b g : K) (k : Fin 5) : MvPolynomial (Fin 2) K :=
  slicePhi K (Work.MotAS.zcubAS a b g k)

/-- The `X 0 ^ j`-coefficient of a slice generator, as a polynomial in `X 1`. -/
noncomputable def sliceCoeff (a b g : K) (k : Fin 5) (j : ℕ) : Polynomial K :=
  ∑ i ∈ Finset.range 4,
    Polynomial.C ((slice a b g k).coeff
        (Finsupp.single (0 : Fin 2) j + Finsupp.single (1 : Fin 2) i))
      * Polynomial.X ^ i

/-- The cleared graph certificate expression of `CertData`: the `X 0 ^ j`-coefficient of the `k`-th
slice generator (a polynomial in `X 1`), multiplied by `Ccert ^ j · Ac ^ (3 - j)` and summed over
`j < 4`.  It is `Ac ^ 3 · f_k(Ccert / Ac, X 1)` written without denominators. -/
noncomputable def sliceCertExpr (a b g : K) (k : Fin 5) : Polynomial K :=
  ∑ j ∈ Finset.range 4,
    sliceCoeff a b g k j
      * (Work.MotAS.ASRulV2.Cert.Ccert a b g) ^ j
      * Polynomial.C ((Work.MotAS.ASRulV2.Cert.Ac a b g) ^ (3 - j))

end Field

end Work.MotC5N3
