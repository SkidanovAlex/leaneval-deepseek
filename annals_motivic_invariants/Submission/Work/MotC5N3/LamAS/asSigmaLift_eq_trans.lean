open WeierstrassCurve WeierstrassCurve.Affine

/-- `Work.MotV.genX` and `Work.MotC2.genX` are the same element of the function field. -/
theorem genX_bridge {L : Type} [Field L] (E : WeierstrassCurve L) :
    Work.MotV.genX E = Work.MotC2.genX E := by
  rw [Work.MotV.genX, Work.MotC2.genX, Work.MotC2.coordX_eq_mk]

/-- `Work.MotV.genY` and `Work.MotC2.genY` are the same element of the function field. -/
theorem genY_bridge {L : Type} [Field L] (E : WeierstrassCurve L) :
    Work.MotV.genY E = Work.MotC2.genY E := by
  rw [Work.MotV.genY, Work.MotC2.genY, Work.MotC2.coordY_eq_mk]

/-- **A reflection of an elliptic curve is an involution.**  For the function field `L(E)` of an
elliptic Weierstrass curve, `τ_Q ∘ [-1]` is the pullback of the reflection `P ↦ Q - P`, hence has
order `2`. -/
theorem transAlgEquiv_mul_negAlgEquiv_sq {L : Type} [Field L] [DecidableEq L]
    (E : WeierstrassCurve L) [E.IsElliptic] (Q : E.toAffine.Point) :
    (Work.MotC2.transAlgEquiv E Q * Work.MotC2.negAlgEquiv E) ^ 2 = 1 := by
  rw [pow_two]
  calc Work.MotC2.transAlgEquiv E Q * Work.MotC2.negAlgEquiv E *
        (Work.MotC2.transAlgEquiv E Q * Work.MotC2.negAlgEquiv E)
      = Work.MotC2.transAlgEquiv E Q *
          (Work.MotC2.negAlgEquiv E * Work.MotC2.transAlgEquiv E Q) *
          Work.MotC2.negAlgEquiv E := by group
    _ = Work.MotC2.transAlgEquiv E Q *
          (Work.MotC2.transAlgEquiv E (-Q) * Work.MotC2.negAlgEquiv E) *
          Work.MotC2.negAlgEquiv E := by
      rw [Work.MotC2.negAlgEquiv_mul_transAlgEquiv]
    _ = (Work.MotC2.transAlgEquiv E Q * Work.MotC2.transAlgEquiv E (-Q)) *
          (Work.MotC2.negAlgEquiv E * Work.MotC2.negAlgEquiv E) := by
      group
    _ = 1 := by
      rw [← Work.MotC2.transAlgEquiv_add, add_neg_cancel, Work.MotC2.transAlgEquiv_zero,
        Work.MotC2.negAlgEquiv_mul_self, mul_one]

/-- **`(σS')^5 = 1`.**  The lift of the projective fifth-torsion shift `σS` to `M = L(E)` inherits
the order of `σS`: `asIota (σS'^5 x) = σS^5 (asIota x) = asIota x` and `asIota` is injective. -/
theorem asSigmaLift_pow_five_eq_one (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D) (f₁ f₂ : K)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (hσS : Work.MotC5N3.KleinData.ShiftOf D σS)
    [DecidableEq ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
    [_hEll : (Work.MotC5N3.LamAS.asE2 D f₁ f₂).IsElliptic]
    (σS' : Work.MotC5N3.LamAS.asML D f₁ f₂ ≃ₐ[↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
      Work.MotC5N3.LamAS.asML D f₁ f₂)
    (hσS' : ∀ x : Work.MotC5N3.LamAS.asML D f₁ f₂,
      Work.MotC5N3.LamAS.asIota D f₁ f₂ (σS' x) =
        σS (Work.MotC5N3.LamAS.asIota D f₁ f₂ x)) :
    σS' ^ 5 = 1 := by
  have hpow : ∀ n (x : Work.MotC5N3.LamAS.asML D f₁ f₂),
      Work.MotC5N3.LamAS.asIota D f₁ f₂ ((σS'^n) x)
        = (σS^n) (Work.MotC5N3.LamAS.asIota D f₁ f₂ x) := by
    intro n
    induction n with
    | zero => intro x; simp
    | succ n ih =>
      intro x
      rw [pow_succ, AlgEquiv.mul_apply, ih, pow_succ, AlgEquiv.mul_apply, hσS' x]
  refine AlgEquiv.ext (fun x => ?_)
  have h := hpow 5 x
  rw [Work.MotC5N3.Nodes.shiftOf_pow_five_eq_one 𝕜 D hD σS hσS] at h
  exact Work.MotC5N3.LamAS.asIota_injective D f₁ f₂ (by simpa using h)

open WeierstrassCurve WeierstrassCurve.Affine in
/-- **`σS' ≠ 1`.**  If the lift of `σS` to `M = L(E)` were the identity, then `σS` would fix the
image of `asIota`, hence in particular `x` and `y`, hence (the function field being generated by
them) `σS = 1`, contradicting `GenAux_sigmaS_ne_one_on_kleinField`. -/
theorem asSigmaLift_ne_one (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D) (f₁ f₂ : K)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (hσS : Work.MotC5N3.KleinData.ShiftOf D σS)
    [DecidableEq ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
    [_hEll : (Work.MotC5N3.LamAS.asE2 D f₁ f₂).IsElliptic]
    (σS' : Work.MotC5N3.LamAS.asML D f₁ f₂ ≃ₐ[↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
      Work.MotC5N3.LamAS.asML D f₁ f₂)
    (hσS' : ∀ x : Work.MotC5N3.LamAS.asML D f₁ f₂,
      Work.MotC5N3.LamAS.asIota D f₁ f₂ (σS' x) =
        σS (Work.MotC5N3.LamAS.asIota D f₁ f₂ x)) :
    σS' ≠ 1 := by
  intro h1
  have hσS1 : σS = 1 := by
    refine Work.MotC2.funcAlgEquiv_ext_genX_genY (D.E.baseChange (Work.MotC5N3.KbA K)) σS 1 ?_ ?_
    · have h0 := hσS' (Work.MotV.genX (Work.MotC5N3.LamAS.asE2 D f₁ f₂))
      rw [h1, AlgEquiv.one_apply, Work.MotC5N3.LamAS.asIota_genX] at h0
      rw [genX_bridge (D.E.baseChange (Work.MotC5N3.KbA K))] at h0
      exact h0.symm
    · have h0 := hσS' (Work.MotV.genY (Work.MotC5N3.LamAS.asE2 D f₁ f₂))
      rw [h1, AlgEquiv.one_apply, Work.MotC5N3.LamAS.asIota_genY] at h0
      rw [genY_bridge (D.E.baseChange (Work.MotC5N3.KbA K))] at h0
      exact h0.symm
  obtain ⟨z, -, hzne⟩ := Work.MotC5N3.GenAux_sigmaS_ne_one_on_kleinField 𝕜 D hD.1 σS hσS
  rw [hσS1] at hzne
  simp at hzne

/-- The lift `σS'` to `M = L(E)` of the projective fifth-torsion shift `σS` (with `ShiftOf D σS`) is the translation by a nonzero `L`-rational `5`-torsion point of `E_L`. -/
theorem asSigmaLift_eq_trans (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D) (f₁ f₂ : K)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (hσS : Work.MotC5N3.KleinData.ShiftOf D σS)
    [DecidableEq ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
    [hEll : (Work.MotC5N3.LamAS.asE2 D f₁ f₂).IsElliptic]
    (σS' : Work.MotC5N3.LamAS.asML D f₁ f₂ ≃ₐ[↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
      Work.MotC5N3.LamAS.asML D f₁ f₂)
    (hσS' : ∀ x : Work.MotC5N3.LamAS.asML D f₁ f₂,
      Work.MotC5N3.LamAS.asIota D f₁ f₂ (σS' x) =
        σS (Work.MotC5N3.LamAS.asIota D f₁ f₂ x)) :
    ∃ T : (Work.MotC5N3.LamAS.asE2 D f₁ f₂).toAffine.Point,
      σS' = Work.MotC2.transAlgEquiv (Work.MotC5N3.LamAS.asE2 D f₁ f₂) T ∧
        (5 : ℕ) • T = 0 ∧ T ≠ 0 := by
  classical
  have hpow5 := asSigmaLift_pow_five_eq_one 𝕜 D hD f₁ f₂ σS hσS σS' hσS'
  have hne1 := asSigmaLift_ne_one 𝕜 D hD f₁ f₂ σS hσS σS' hσS'
  -- the classification of `L`-automorphisms of `M = L(E)`
  obtain ⟨Q, ε, hQε⟩ := Work.MotC5N3.LamAS.asML_c2 𝕜 D hD f₁ f₂ σS'
  fin_cases ε
  · -- `σS' = τ_Q` is a translation
    have hQ : σS' = Work.MotC2.transAlgEquiv (Work.MotC5N3.LamAS.asE2 D f₁ f₂) Q := by
      rw [hQε]
      simp
    refine ⟨Q, hQ, ?_, ?_⟩
    · refine Work.MotV5.Nodes.five_nsmul_eq_zero_of_transAlgEquiv_pow_eq_one
        (Work.MotC5N3.LamAS.asE2 D f₁ f₂) Q ?_
      rw [← hQ]
      exact hpow5
    · intro hQ0
      exact hne1 (by rw [hQ, hQ0, Work.MotC2.transAlgEquiv_zero])
  · -- `σS' = τ_Q ∘ [-1]` is an involution of order dividing `5`, hence trivial
    exfalso
    have hQ : σS' = Work.MotC2.transAlgEquiv (Work.MotC5N3.LamAS.asE2 D f₁ f₂) Q *
        Work.MotC2.negAlgEquiv (Work.MotC5N3.LamAS.asE2 D f₁ f₂) := by
      rw [hQε]
      simp
    have hsq : σS' ^ 2 = 1 := by
      rw [hQ]
      exact transAlgEquiv_mul_negAlgEquiv_sq (Work.MotC5N3.LamAS.asE2 D f₁ f₂) Q
    have hlast : σS' ^ 5 = σS' := by
      rw [show (5 : ℕ) = 2 * 2 + 1 by norm_num, pow_add, pow_mul, hsq]
      simp
    rw [hlast] at hpow5
    exact hne1 hpow5

end Work.MotC5N3.LamAS