/-- If `σ` fixes `asRoot g` then the coefficient action of `σ` fixes `asFieldL D g` pointwise. -/
private theorem coeffAction_fixes_asFieldL {𝕜 : Type} [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5]
    (D : Work.MotV.KleinData 𝕜) (g : K)
    (σ : Work.MotC5N3.KbA K ≃ₐ[K] Work.MotC5N3.KbA K)
    (hσ : σ (Work.MotC5N3.asRoot g) = Work.MotC5N3.asRoot g) :
    ∀ x ∈ Work.MotC5N3.asFieldL D g, Work.MotV5.coeffAction D.E σ x = x := by
  set S : IntermediateField (K) (Work.MotC5N3.OmA K D) :=
    { carrier := {x | Work.MotV5.coeffAction D.E σ x = x}
      zero_mem' := by simp
      one_mem' := by simp
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [map_add, ha, hb]
      mul_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [map_mul, ha, hb]
      inv_mem' := fun {a} ha => by
        simp only [Set.mem_setOf_eq] at ha ⊢
        rw [map_inv₀, ha]
      algebraMap_mem' := fun c => by
        show Work.MotV5.coeffAction D.E σ (algebraMap (K) (Work.MotC5N3.OmA K D) c)
          = algebraMap (K) (Work.MotC5N3.OmA K D) c
        rw [IsScalarTower.algebraMap_apply (K) (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) c,
          Work.MotV5.coeffAction_algebraMap, AlgEquiv.commutes] } with hSdef
  have h1 : Work.MotC5N3.kleinField K D ≤ S := fun x hx =>
    coeffAction_fixes_kleinField D σ x hx
  have h2 : IntermediateField.adjoin (K)
      {algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)} ≤ S := by
    rw [IntermediateField.adjoin_le_iff]
    rintro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    show Work.MotV5.coeffAction D.E σ
        (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g))
      = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)
    rw [Work.MotV5.coeffAction_algebraMap, hσ]
  intro x hx
  rw [Work.MotC5N3.asFieldL] at hx
  exact (sup_le h1 h2) hx

/-- **(P) The twisted Galois action fixes the twist field.**  NOTE: `Submission/Work/MotV5/LamAS/asPsi_aux.lean`
(`Work.MotC5N3.LamAS.asML_algEquiv_ext`, `asCoeff_one`, `asCoeff_mul`, `asCoeff_pow`, `asIota_pow`,
`asIota_coeffAction`, `coeffAction_fixes_kleinField`, `tau_eq_coeffAction_on_Omega`, `asExtend`,
`asRestrict`) already contains the support lemmas for this proof, and the root-level scratch file
`_asf_work.lean` (read it!) contains a proof of the generalisation `asPsi_fixes_asF_test` that is
complete except for ONE final `sorry`; copy it and finish that step.

Route.  For `x ∈ asF`: `z := asIota x` satisfies `z ∈ asFieldL D g` and
`asTwistAction D τ σS z = z`.  Put `k := (asShift D f₁ f₂ g W hW γ : Fin 5)` (so `γ W = W + k`,
`asShift_spec`), let `σL := asRestrict f₁ f₂ σ : Gal(L/K)` be the restriction of `σ` (it preserves
`L` because `σ W = W + 1` and every `K`-automorphism sends a root of `X⁵-X-h` to another root,
`root_eq_asRoot_add`), and put `γ' := γ * (σL ^ k)⁻¹`, so that `γ' W = W` (`_asf_work.lean` proves
this, and also `γ' (asRoot g) = asRoot g`).

Then: (i) `asCoeff γ' x = x`, because `asIota (asCoeff γ' x) = coeffAction γ̃' (z)` for a lift `γ̃'`
(`asIota_coeffAction`), and `coeffAction` fixes `Work.MotC5N3.kleinField K D` pointwise
(`coeffAction_fixes_kleinField`) and sends `algebraMap W` to `algebraMap (γ' W) = algebraMap W`
(`coeffAction_algebraMap`), hence fixes `asFieldL D g = Work.MotC5N3.kleinField K D ⊔ K(W)` pointwise.
(ii) `γ = γ' * σL^k`, so `asPsi γ x = σS'^k (asCoeff γ' (asCoeff (σL^k) x)) = σS'^k (asCoeff (σL^k) x)`.
(iii) `asCoeff (σL^k) x = σS'^{-k} x`: apply `asIota` to both sides; by `asIota_coeffAction` the left
side becomes `coeffAction γ̃ (z)` for a lift `γ̃` of `σL^k`, which equals `τ^k z`
(`tau_eq_coeffAction_on_Omega`, using `h.hτ`, `h.hτk`, `asML_algEquiv_ext`); the right side becomes
`σS^{-k} (z)` by `asIota_pow` + `hσS'`; and `τ^k z = σS^{-k} z` because `z` is fixed by the cyclic
group generated by `asTwistAction D τ σS = σS ∘ τ` and `σS`, `τ` commute.  Hence
`asPsi γ x = σS'^k (σS'^{-k} x) = x`. -/
theorem asPsi_fixes_asF (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D) (f₁ f₂ g : K)
    (τ : Work.MotC5N3.OmA K D ≃ₐ[K] Work.MotC5N3.OmA K D)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (σ : Work.MotC5N3.KbA K ≃ₐ[K] Work.MotC5N3.KbA K)
    (h : Work.MotC5N3.ASTwistData 𝕜 D g τ σS σ) (hg : g = f₁ ∨ g = f₂)
    (hRange : (Work.MotC5N3.LamAS.asIota D f₁ f₂).fieldRange =
      Work.MotC5N3.kleinField K D ⊔ Work.MotC5N3.LamAS.LImage D
        (Work.MotC5N3.LamAS.asL2 f₁ f₂))
    (σS' : Work.MotC5N3.LamAS.asML D f₁ f₂ ≃ₐ[↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)]
      Work.MotC5N3.LamAS.asML D f₁ f₂)
    (hσS' : ∀ x : Work.MotC5N3.LamAS.asML D f₁ f₂,
      Work.MotC5N3.LamAS.asIota D f₁ f₂ (σS' x) =
        σS (Work.MotC5N3.LamAS.asIota D f₁ f₂ x))
    (hcomm : ∀ (γ : ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂) ≃ₐ[K]
        ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)) (x : Work.MotC5N3.LamAS.asML D f₁ f₂),
      σS' (Work.MotC5N3.LamAS.asCoeff D f₁ f₂ γ x) =
        Work.MotC5N3.LamAS.asCoeff D f₁ f₂ γ (σS' x))
    (W : ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂))
    (hW : W ^ 5 - W = algebraMap (K) ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂) g)
    (γ : ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂) ≃ₐ[K]
      ↥(Work.MotC5N3.LamAS.asL2 f₁ f₂)) :
    ∀ x ∈ Work.MotC5N3.LamAS.asF D f₁ f₂ g τ σS,
      Work.MotC5N3.LamAS.asPsi D f₁ f₂ g σS' W hW γ x = x := by
  intro x hx
  -- ## unpacking the hypothesis `x ∈ asF`
  rw [asF] at hx
  have hxT : asIota D f₁ f₂ x ∈ Work.MotC5N3.asTwistFieldTrue D g τ σS := hx
  rw [Work.MotC5N3.asTwistFieldTrue, IntermediateField.mem_inf] at hxT
  obtain ⟨hxF, hxL⟩ := hxT
  have hfix : Work.MotC5N3.asTwistAction D τ σS (asIota D f₁ f₂ x) = asIota D f₁ f₂ x :=
    (IntermediateField.mem_fixedField_iff
      (Subgroup.zpowers (Work.MotC5N3.asTwistAction D τ σS)) _).mp
      hxF (Work.MotC5N3.asTwistAction D τ σS) (Subgroup.mem_zpowers _)
  -- ## unfolding `asPsi` and abstracting the Artin–Schreier shift `k = χ(γ)`
  apply asIota_injective D f₁ f₂
  rw [asPsi, AlgEquiv.mul_apply, AlgEquiv.restrictScalars_apply]
  generalize hk : ((asShift D f₁ f₂ g W hW γ : Fin 5) : ℕ) = k
  -- ## the restriction `σL` of `σ` to `L`
  obtain ⟨σL, hσL⟩ := asRestrict f₁ f₂ σ
  have hσLs : ∀ l : ↥(asL2 f₁ f₂),
      σ (l : Work.MotC5N3.KbA K) = (σL l : Work.MotC5N3.KbA K) := fun l => (hσL l).symm
  -- ## the `K`-level lift `σS'K` of `σS'` and the composite `Φ = σS'K ∘ asCoeff σL`
  set σS'K : asML D f₁ f₂ ≃ₐ[K] asML D f₁ f₂ :=
    σS'.restrictScalars (K) with hσS'K
  set Φ : asML D f₁ f₂ ≃ₐ[K] asML D f₁ f₂ :=
    σS'K * asCoeff D f₁ f₂ σL with hΦdef
  have hΦapply : ∀ y : asML D f₁ f₂, Φ y = σS' (asCoeff D f₁ f₂ σL y) := by
    intro y
    rw [hΦdef, AlgEquiv.mul_apply, hσS'K, AlgEquiv.restrictScalars_apply]
  have hΦimg : ∀ y : asML D f₁ f₂,
      asIota D f₁ f₂ (Φ y) = Work.MotC5N3.asTwistAction D τ σS (asIota D f₁ f₂ y) := by
    intro y
    have hmem : asIota D f₁ f₂ y ∈
        Work.MotC5N3.kleinField K D ⊔ LImage D (asL2 f₁ f₂) := by
      rw [← hRange]
      exact AlgHom.mem_fieldRange.mpr ⟨y, rfl⟩
    have h3 : Work.MotV5.coeffAction D.E σ (asIota D f₁ f₂ y) = τ (asIota D f₁ f₂ y) :=
      (tau_eq_coeffAction_on_Omega D f₁ f₂ σ τ h.hτ h.hτk (asIota D f₁ f₂ y) hmem).symm
    rw [hΦapply y, hσS' _, asIota_coeffAction D f₁ f₂ σL σ hσLs y, h3]
    rw [Work.MotC5N3.asTwistAction, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
  -- ## the elementary commutation facts
  have hcommσL : ∀ z : asML D f₁ f₂,
      σS' (asCoeff D f₁ f₂ σL z) = asCoeff D f₁ f₂ σL (σS' z) := hcomm σL
  have hcommK : ∀ (δ : ↥(asL2 f₁ f₂) ≃ₐ[K] ↥(asL2 f₁ f₂))
      (z : asML D f₁ f₂),
      σS'K (asCoeff D f₁ f₂ δ z) = asCoeff D f₁ f₂ δ (σS'K z) := by
    intro δ z
    rw [hσS'K, AlgEquiv.restrictScalars_apply]
    exact hcomm δ z
  have hcommute : Commute σS'K (asCoeff D f₁ f₂ σL) := by
    rw [Commute]
    refine AlgEquiv.ext (fun z => ?_)
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply]
    exact hcommK σL z
  have hcpow : ∀ (δ : ↥(asL2 f₁ f₂) ≃ₐ[K] ↥(asL2 f₁ f₂))
      (n : ℕ) (z : asML D f₁ f₂),
      (σS'K ^ n) (asCoeff D f₁ f₂ δ z) = asCoeff D f₁ f₂ δ ((σS'K ^ n) z) := by
    intro δ n z
    have hc : Commute σS'K (asCoeff D f₁ f₂ δ) := by
      rw [Commute]
      exact AlgEquiv.ext (fun w => hcommK δ w)
    have h2 := congrArg (fun e : asML D f₁ f₂ ≃ₐ[K] asML D f₁ f₂ => e z)
      (hc.pow_left n)
    simpa only [AlgEquiv.mul_apply] using h2
  have hSS : ∀ y : asML D f₁ f₂, σS' y = σS'K y := by
    intro y
    rw [hσS'K, AlgEquiv.restrictScalars_apply]
  have hSSpow : ∀ (n : ℕ) (y : asML D f₁ f₂), (σS' ^ n) y = (σS'K ^ n) y := by
    intro n
    induction n with
    | zero => intro y; simp
    | succ n ih =>
      intro y
      rw [pow_succ, AlgEquiv.mul_apply, pow_succ, AlgEquiv.mul_apply, ih, hSS]
  have hΦpow : ∀ n : ℕ,
      asIota D f₁ f₂ ((Φ ^ n) x) =
        (Work.MotC5N3.asTwistAction D τ σS ^ n) (asIota D f₁ f₂ x) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', AlgEquiv.mul_apply, hΦimg, ih, pow_succ', AlgEquiv.mul_apply]
  have hΦcomm : ∀ n : ℕ, (σS'K ^ n) ((asCoeff D f₁ f₂ σL ^ n) x) = (Φ ^ n) x := by
    intro n
    rw [hΦdef, hcommute.mul_pow n, AlgEquiv.mul_apply]
  have hfixk : ∀ n : ℕ,
      (Work.MotC5N3.asTwistAction D τ σS ^ n) (asIota D f₁ f₂ x) = asIota D f₁ f₂ x := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih]
      exact hfix
  -- ## `W = asRoot g + j` in `L`
  have hWKb : (W : Work.MotC5N3.KbA K) ^ 5 - (W : Work.MotC5N3.KbA K)
      = algebraMap (K) (Work.MotC5N3.KbA K) g := by
    have h2 : ((W ^ 5 - W : ↥(asL2 f₁ f₂)) : Work.MotC5N3.KbA K)
        = ((algebraMap (K) ↥(asL2 f₁ f₂) g :
            ↥(asL2 f₁ f₂)) : Work.MotC5N3.KbA K) :=
      congrArg (fun z : ↥(asL2 f₁ f₂) => (z : Work.MotC5N3.KbA K)) hW
    push_cast at h2
    exact h2
  obtain ⟨j, hj⟩ := Work.MotC5N3.LamAS.root_eq_asRoot_add g hWKb
  have hj' : (W : Work.MotC5N3.KbA K) = Work.MotC5N3.asRoot g + ((j : Fin 5) : Work.MotC5N3.KbA K) := by
    rw [hj]
    push_cast
    first | refl_ring1 | ring
  -- ## `σL W = W + 1`, its powers, and the action of `γ'`
  have hσLW : σL W = W + 1 := by
    apply Subtype.ext
    push_cast
    rw [hσL, hj', map_add, h.hσ, map_natCast]
    first | refl_ring1 | ring
  have hWk : ∀ n : ℕ, (σL ^ n) W = W + (n : ↥(asL2 f₁ f₂)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, map_add, hσLW, map_natCast]
      push_cast
      first | refl_ring1 | ring
  have hWk_inv : ((σL ^ k)⁻¹) W = W - (k : ↥(asL2 f₁ f₂)) := by
    have h1 : (σL ^ k) (W - (k : ↥(asL2 f₁ f₂))) = W := by
      rw [map_sub, hWk k, map_natCast]
      first | refl_ring1 | ring
    apply (σL ^ k).injective
    rw [show (σL ^ k) (((σL ^ k)⁻¹) W) = W from
      AlgEquiv.apply_symm_apply (σL ^ k) W, h1]
  set γ' : ↥(asL2 f₁ f₂) ≃ₐ[K] ↥(asL2 f₁ f₂) :=
    γ * (σL ^ k)⁻¹ with hγ'def
  have hshiftcast : algebraMap ℤ ↥(asL2 f₁ f₂)
      (((asShift D f₁ f₂ g W hW γ : Fin 5) : ℤ)) = (k : ↥(asL2 f₁ f₂)) := by
    rw [← hk]
    push_cast
    first | refl_ring1 | ring
  have hγ'W : γ' W = W := by
    rw [hγ'def, AlgEquiv.mul_apply, hWk_inv, map_sub, map_natCast,
      asShift_spec D f₁ f₂ g W hW γ, hshiftcast]
    first | refl_ring1 | ring
  have hgmem : Work.MotC5N3.asRoot g ∈ asL2 f₁ f₂ := by
    rcases hg with hg | hg
    · rw [hg]; exact asRoot_mem_asL2_left f₁ f₂
    · rw [hg]; exact asRoot_mem_asL2_right f₁ f₂
  have hγ'root : γ' ⟨Work.MotC5N3.asRoot g, hgmem⟩ = ⟨Work.MotC5N3.asRoot g, hgmem⟩ := by
    have hρW : (⟨Work.MotC5N3.asRoot g, hgmem⟩ : ↥(asL2 f₁ f₂))
        = W - ((j : Fin 5) : ↥(asL2 f₁ f₂)) := by
      apply Subtype.ext
      push_cast
      rw [hj']
      first | refl_ring1 | ring
    rw [hρW, map_sub, hγ'W, map_natCast]
  -- ## the extension `σγ'` of `γ'` and the fact that it fixes `asFieldL D g`
  obtain ⟨σγ', hσγ'⟩ := asExtend f₁ f₂ γ'
  have hσγ'root : σγ' (Work.MotC5N3.asRoot g) = Work.MotC5N3.asRoot g := by
    have h1 := hσγ' ⟨Work.MotC5N3.asRoot g, hgmem⟩
    rw [hγ'root] at h1
    exact h1
  have hfx : Work.MotV5.coeffAction D.E σγ' (asIota D f₁ f₂ x) = asIota D f₁ f₂ x :=
    coeffAction_fixes_asFieldL D g σγ' hσγ'root (asIota D f₁ f₂ x) hxL
  -- ## the decomposition of `ψ_γ`
  have hγdecomp : γ = γ' * σL ^ k := by
    rw [hγ'def]
    group
  have hAcx : asCoeff D f₁ f₂ γ x = asCoeff D f₁ f₂ γ' ((asCoeff D f₁ f₂ σL ^ k) x) := by
    rw [hγdecomp, asCoeff_mul, asCoeff_pow, AlgEquiv.mul_apply]
  -- ## the final chain
  rw [hSSpow k (asCoeff D f₁ f₂ γ x)]
  calc asIota D f₁ f₂ ((σS'K ^ k) (asCoeff D f₁ f₂ γ x))
      = asIota D f₁ f₂ ((σS'K ^ k)
          (asCoeff D f₁ f₂ γ' ((asCoeff D f₁ f₂ σL ^ k) x))) := by rw [hAcx]
    _ = asIota D f₁ f₂ (asCoeff D f₁ f₂ γ'
          ((σS'K ^ k) ((asCoeff D f₁ f₂ σL ^ k) x))) := by rw [hcpow γ' k]
    _ = asIota D f₁ f₂ (asCoeff D f₁ f₂ γ' ((Φ ^ k) x)) := by rw [hΦcomm k]
    _ = Work.MotV5.coeffAction D.E σγ' (asIota D f₁ f₂ ((Φ ^ k) x)) :=
        asIota_coeffAction D f₁ f₂ γ' σγ' hσγ' ((Φ ^ k) x)
    _ = Work.MotV5.coeffAction D.E σγ'
          ((Work.MotC5N3.asTwistAction D τ σS ^ k) (asIota D f₁ f₂ x)) := by rw [hΦpow k]
    _ = Work.MotV5.coeffAction D.E σγ' (asIota D f₁ f₂ x) := by rw [hfixk k]
    _ = asIota D f₁ f₂ x := hfx

end Work.MotC5N3.LamAS.FixPsi