/-!
# `Work.MotC5N3.Ruling` — the ruling presentation of the target AS divisor over a general `K`

The `RatFunc 𝕜 ↦ K` forks of the four `RatFunc 𝕜`-hardwired definitions of
`Submission/Work/MotAS/SdualAS2Defs.lean`: `asY0` (the generic point of the twisted Klein curve),
`asPhi2` (the chart parametrisation of the ruling line), `asTheta2` (the presentation) and `asR2`
(its range).  Everything they consume (`asRuleQW`, `asRuleQA`, `asRuleQB`, `asTanQ`, `asIdx`,
`asPolarP`, `kleinPAS`, `kleinRAS`, `kleinSecDualAS`) is already generic in the coordinates
`(a, b, g)` in `Submission/Work/MotAS/{SdualAS2Defs,ASData}.lean`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.MotC5N3

open MvPolynomial

variable {𝕜 : Type} [Field 𝕜] [CharP 𝕜 5]
variable {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5]

/-! ## §0 The chart-2 vocabulary

The `RatFunc 𝕜 ↦ K` forks of the abbreviations `as2A, as2a, as2b, as2g, as2c, asW2` of
`Submission/Work/MotV5/ASLocal/asTheta2_fracTop_of.lean`; they make the statements of the chart-2
chain readable. -/

/-- The fraction field of the AS twist field. -/
noncomputable abbrev as2A (D : Work.MotV.KleinData 𝕜) (g : K) : Type :=
  RatFunc ↥(twistFieldAS D g)

/-- The Klein parameter `a`, pushed into `as2A D g`. -/
noncomputable abbrev as2a (D : Work.MotV.KleinData 𝕜) (g : K) : as2A D g :=
  algebraMap 𝕜 (as2A D g) D.a

/-- The Klein parameter `b`, pushed into `as2A D g`. -/
noncomputable abbrev as2b (D : Work.MotV.KleinData 𝕜) (g : K) : as2A D g :=
  algebraMap 𝕜 (as2A D g) D.b

/-- The AS class `g`, pushed into `as2A D g`. -/
noncomputable abbrev as2g (D : Work.MotV.KleinData 𝕜) (g : K) : as2A D g :=
  algebraMap K (as2A D g) g

/-- **The generic point of the twisted Klein curve** as a point of `twistFieldAS D g`: the
projective point `(1, y₁/y₀, y₂/y₀, y₃/y₀, y₄/y₀)` of the AS Galois-coordinate Klein curve. -/
noncomputable def asY0 (D : Work.MotV.KleinData 𝕜) (g : K) : Fin 5 → ↥(twistFieldAS D g) :=
  fun j => ⟨asTwY D g j / asTwY D g 0,
    IntermediateField.subset_adjoin K (Set.range fun j => asTwY D g j / asTwY D g 0)
      (Set.mem_range_self j)⟩

/-- The generic point of the twisted Klein curve, seen in `as2A D g`. -/
noncomputable abbrev as2c (D : Work.MotV.KleinData 𝕜) (g : K) : Fin 5 → as2A D g :=
  fun j => algebraMap ↥(twistFieldAS D g) (as2A D g) (asY0 D g j)

/-- The ruling point of the corrected chart over the generic curve point. -/
noncomputable abbrev asW2 (D : Work.MotV.KleinData 𝕜) (g : K) : Fin 5 → as2A D g :=
  Work.MotAS.asRuleQW (as2a D g) (as2b D g) (as2g D g) (as2c D g) (RatFunc.X : as2A D g)

/-- **The ruling parametrisation of the corrected AS target divisor**: the chart coordinates of the
ruling line `ℓ_c` over the generic curve point, with ruling parameter `t = RatFunc.X`. -/
noncomputable def asPhi2 (D : Work.MotV.KleinData 𝕜) (g : K) :
    Fin 3 → RatFunc ↥(twistFieldAS D g) :=
  fun j => asW2 D g (Work.MotAS.asIdx j) / asW2 D g 0

/-- **The presentation of the corrected AS target divisor.** -/
noncomputable def asTheta2 (D : Work.MotV.KleinData 𝕜) (g : K) :
    MvPolynomial (Fin 3) K →ₐ[K] RatFunc ↥(twistFieldAS D g) :=
  MvPolynomial.aeval (asPhi2 D g)

/-- The subalgebra of `RatFunc ↥(twistFieldAS D g)` generated by the chart coordinates. -/
noncomputable def asR2 (D : Work.MotV.KleinData 𝕜) (g : K) :
    Subalgebra K (RatFunc ↥(twistFieldAS D g)) :=
  Algebra.adjoin K (Set.range (asPhi2 D g))

/-- The range of `asTheta2` is the subalgebra `asR2`. -/
theorem asTheta2_range (D : Work.MotV.KleinData 𝕜) (g : K) :
    (asTheta2 D g).range = asR2 D g := by
  have h := MvPolynomial.aeval_range (R := K)
    (S₁ := RatFunc ↥(twistFieldAS D g)) (σ := Fin 3) (asPhi2 D g)
  simpa only [asTheta2, asR2] using h

end Work.MotC5N3
