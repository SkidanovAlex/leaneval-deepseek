/-!
# `twistFieldAS_eq`: the explicit AS twist field is the fixed field of the twisted action

Node **AS-EQ** of the subproject `Submission/Work/MotC5N3` — the `RatFunc 𝕜 ↦ K` fork of
`Work.MotAS.twistFieldAS_eq` (`Submission/Work/MotAS/twistFieldAS_eq.lean`).

For a Klein datum `D : Work.MotV.KleinData 𝕜` with `ASGood D`, an arbitrary `𝕜`-algebra field `K`
of characteristic `5`, an Artin–Schreier parameter `g : K` and `ASTwistData` on the twisted action
`σ' = asTwistAction D τ σS = σS ∘ τ`, the field

`twistFieldAS D g = K(y_j / y_0)`,  `y = (asM (asRoot g))⁻¹ · κ`,

generated by the *projectively normalised* Galois coordinates, coincides with the fixed-field twist
`asTwistFieldTrue D g τ σS = Fix(σ') ⊓ L(E)` of `Submission/Work/MotC5N3/Defs.lean`.

The two steps are

* `⊆`: `σ'(y_j) = c y_j` for a single scalar `c ≠ 0` (the Lagrange coordinates are the eigenvectors
  of the twisted action) — so the ratios `y_j/y_0` are `σ'`-invariant; and `y_j/y_0 ∈ L(E)` since,
  by the explicit Lagrange formula, `y_j = Σ_i (δ_{j0} - (w+i)^{4-j}) κ_i` with the coefficients
  lying in `K⟮asRoot g⟯ ⊆ L(E)`;
* `⊇`: `asRoot g` separates `asTwistFieldTrue` from `asFieldL` (`hneL`), and from
  `κ_i = y_0 Σ_j (w+i)^j (y_j/y_0)` (which uses `y_0 ≠ 0`) one gets
  `asFieldL = twistFieldAS ⊔ K⟮asRoot g⟯`, whence
  `[asFieldL : twistFieldAS] ≤ 5 = [asFieldL : asTwistFieldTrue]`
  (`GenAux_asTwistFieldTrue_finrank_and_isSeparable`) and the two fields coincide.

The key auxiliary input is `y_0 ≠ 0`: `y_0 = Σ_i (1 - (w+i)^4) κ_i` and the Klein coordinates are
`KbA K`-linearly independent (`Work.MotTDG.kleinCoord_linearIndependent`, which rests on
`D.Good.spans`), so `y_0 = 0` would give `(w+i)^4 = 1` for all `i ∈ Fin 5`; summing over the five
nodes, the two identities `Σ_i (w+i)^4 = 4` and `Σ_i 1 = 5` then contradict `CharP 𝕜 5`.

The Lagrange-matrix identities used here are the ones forked in `Submission/Work/MotC5N3/ASMinv.lean`
(`Work.MotC5N3.asM_mul_asMinv`, `Work.MotC5N3.asMinv_mul_asM`); the base-field-independent matrix
facts `asM w * asMinv w = 1` and `asMinv w * asM w = 1` are shared with `Work.MotAS`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 4000000

namespace Work.MotC5N3

open WeierstrassCurve WeierstrassCurve.Affine
open scoped Matrix

variable {𝕜 : Type} [Field 𝕜] [CharP 𝕜 5]
variable {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5]

lemma five_eq_zero_KbA (K : Type) [Field K] [CharP K 5] : (5 : KbA K) = 0 :=
  CharP.cast_eq_zero _ _

lemma five_eq_zero_OmA (𝕜 : Type) [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5]
    (D : Work.MotV.KleinData 𝕜) : (5 : OmA K D) = 0 := by
  have h : ((5 : ℕ) : OmA K D) = 0 := by
    rw [← map_natCast (algebraMap (KbA K) (OmA K D)) 5, CharP.cast_eq_zero (KbA K) 5,
      map_zero]
  exact h

/-- Casting natural numbers into the function field: congruent naturals give equal elements. -/
lemma natCast_OmA_eq_of_modEq (D : Work.MotV.KleinData 𝕜) {m n : ℕ} (h : m ≡ n [MOD 5]) :
    ((m : ℕ) : OmA K D) = ((n : ℕ) : OmA K D) := by
  have h' : ((m : ℕ) : KbA K) = ((n : ℕ) : KbA K) :=
    CharP.natCast_eq_natCast' (KbA K) 5 h
  have h2 := congrArg (algebraMap (KbA K) (OmA K D)) h'
  simpa only [map_natCast] using h2

/-! ## §1 The Lagrange coordinates `y = asM(w)⁻¹ κ` -/

section Lagrange

variable (D : Work.MotV.KleinData 𝕜) (g : K)

/-- The Artin–Schreier root `w = asRoot g`, as a constant of the function field `OmA K D`. -/
noncomputable def asOM : OmA K D :=
  algebraMap (KbA K) (OmA K D) (asRoot g)

/-- The Klein coordinates, as a vector over the function field.

The Artin–Schreier parameter `g` is carried along (unused) so that the base field `K` is
determined by the arguments of `asKap`: without it, the elaborated result type `OmA K D` would
force instance search for the (noncomputable) `Algebra 𝕜 (KbA K)` on an undetermined `K` and
fail at uses whose expected type is not yet known. -/
noncomputable def asKap (_g : K) : Fin 5 → OmA K D :=
  fun i => Work.MotV.kleinCoord D (KbA K) i

/-- `asM w` pushed forward to the function field: its `(i,j)` entry is `(asOM + i)^j`. -/
noncomputable def asMO : Matrix (Fin 5) (Fin 5) (OmA K D) :=
  (Work.MotAS.asM (asRoot g)).map (algebraMap (KbA K) (OmA K D))

/-- `asMinv w` pushed forward to the function field: the Lagrange coefficient matrix. -/
noncomputable def asNO : Matrix (Fin 5) (Fin 5) (OmA K D) :=
  (Work.MotAS.asMinv (asRoot g)).map (algebraMap (KbA K) (OmA K D))

/-- `asM (w+1)`, pushed forward: its `(i,j)` entry is `(asOM + 1 + i)^j`. -/
noncomputable def asMO1 : Matrix (Fin 5) (Fin 5) (OmA K D) :=
  (Work.MotAS.asM (asRoot g + 1)).map (algebraMap (KbA K) (OmA K D))

/-- `asMinv (w+1)`, pushed forward. -/
noncomputable def asNO1 : Matrix (Fin 5) (Fin 5) (OmA K D) :=
  (Work.MotAS.asMinv (asRoot g + 1)).map (algebraMap (KbA K) (OmA K D))

lemma asMO_apply (i j : Fin 5) : asMO D g i j = (asOM D g + (i : ℕ)) ^ (j : ℕ) := by
  simp [asMO, asOM, Work.MotAS.asM, Matrix.map_apply]

/-- The entries of the Lagrange matrix, evaluated in the function field. -/
lemma asNO_apply (j i : Fin 5) :
    asNO D g j i = (if (j : ℕ) = 0 then 1 else 0) - (asOM D g + (i : ℕ)) ^ (4 - (j : ℕ)) := by
  have h : asNO D g j i = algebraMap (KbA K) (OmA K D)
      ((if (j : ℕ) = 0 then (1 : KbA K) else 0)
        - (asRoot g + (i : ℕ)) ^ (4 - (j : ℕ))) := rfl
  rw [h]
  by_cases hj : (j : ℕ) = 0
  · rw [if_pos hj, if_pos hj, map_sub, map_pow, map_add, map_natCast, map_one]
    simp [asOM]
  · rw [if_neg hj, if_neg hj, map_sub, map_pow, map_add, map_natCast, map_zero]
    simp [asOM]

lemma natCast_mem_asFieldL (n : ℕ) : ((n : ℕ) : OmA K D) ∈ asFieldL D g := by
  have h := IntermediateField.algebraMap_mem (asFieldL D g) ((n : ℕ) : K)
  simpa only [map_natCast] using h

/-- The Klein coordinates are `KbA K`-linearly independent (from `D.Good.spans`).  The
intermediate `he'` is needed because the elaborated type of the hypothesis of
`Work.MotTDG.kleinCoord_linearIndependent` mentions `algebraMap 𝕜 (KbA K)` (an instance that is
not a local hypothesis here), and elaborating it directly against the expected type leaves the
base field `K` undetermined. -/
lemma kleinCoord_linearIndependent_KbA (hD : D.Good) :
    LinearIndependent (KbA K) (Work.MotV.kleinCoord D (KbA K)) := by
  obtain ⟨e, he⟩ := hD.spans
  have he' : ∀ m : Fin 5, Work.MotV.kleinBas D (KbA K) m =
      ∑ i, algebraMap (KbA K) (OmA K D) (algebraMap 𝕜 (KbA K) (e m i)) *
        Work.MotV.kleinCoord D (KbA K) i := fun m => he (KbA K) m
  exact Work.MotTDG.kleinCoord_linearIndependent D (KbA K) e he'

lemma asOM_mem_adjoin_asOM : asOM D g ∈ IntermediateField.adjoin K {asOM D g} :=
  IntermediateField.subset_adjoin K ({asOM D g} : Set (OmA K D))
    (Set.mem_singleton (asOM D g))

lemma asOM_mem_asFieldL : asOM D g ∈ asFieldL D g := by
  rw [asFieldL]
  have hsub : IntermediateField.adjoin K {asOM D g}
      ≤ kleinField K D ⊔ IntermediateField.adjoin K {asOM D g} := le_sup_right
  exact hsub (asOM_mem_adjoin_asOM D g)

/-- The Lagrange coefficients lie in `L(E) = asFieldL D g`. -/
lemma asNO_mem_asFieldL (j i : Fin 5) : asNO D g j i ∈ asFieldL D g := by
  have hw : asOM D g ∈ asFieldL D g := asOM_mem_asFieldL D g
  have hnat : ((i : ℕ) : OmA K D) ∈ asFieldL D g := natCast_mem_asFieldL D g i
  rw [asNO_apply]
  by_cases hj : (j : ℕ) = 0
  · rw [if_pos hj]
    exact sub_mem (one_mem _) (pow_mem (add_mem hw hnat) _)
  · rw [if_neg hj]
    exact sub_mem (zero_mem _) (pow_mem (add_mem hw hnat) _)

/-- The `0`-th row of the Lagrange matrix. -/
lemma asNO_zero_apply (i : Fin 5) :
    asNO D g 0 i = 1 - (asOM D g + (i : ℕ)) ^ 4 := by
  rw [asNO_apply]
  norm_num

lemma asMO1_apply (i j : Fin 5) : asMO1 D g i j = (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ) := by
  simp [asMO1, asOM, Work.MotAS.asM, Matrix.map_apply]

lemma map_one_matrix :
    ((1 : Matrix (Fin 5) (Fin 5) (KbA K)).map
      (algebraMap (KbA K) (OmA K D))) = 1 := by
  ext i j
  by_cases h : i = j <;> simp [Matrix.one_apply, h]

lemma asMO_mul_asNO : asMO D g * asNO D g = 1 := by
  rw [asMO, asNO, ← Matrix.map_mul,
    Work.MotC5N3.asM_mul_asMinv (five_eq_zero_KbA K) (asRoot g)]
  exact map_one_matrix D

lemma asNO_mul_asMO : asNO D g * asMO D g = 1 := by
  rw [asMO, asNO, ← Matrix.map_mul,
    Work.MotC5N3.asMinv_mul_asM (five_eq_zero_KbA K) (asRoot g)]
  exact map_one_matrix D

lemma asMO1_mul_asNO1 : asMO1 D g * asNO1 D g = 1 := by
  rw [asMO1, asNO1, ← Matrix.map_mul,
    Work.MotC5N3.asM_mul_asMinv (five_eq_zero_KbA K) (asRoot g + 1)]
  exact map_one_matrix D

lemma asNO1_mul_asMO1 : asNO1 D g * asMO1 D g = 1 := by
  rw [asMO1, asNO1, ← Matrix.map_mul,
    Work.MotC5N3.asMinv_mul_asM (five_eq_zero_KbA K) (asRoot g + 1)]
  exact map_one_matrix D

/-- The defining Lagrange identity: `asTwY = (asM w)⁻¹ · κ = asMinv w · κ`. -/
lemma asTwY_eq_mulVec : asTwY D g = asNO D g *ᵥ asKap D g := by
  have hinv : (Work.MotAS.asM (asRoot g))⁻¹ = Work.MotAS.asMinv (asRoot g) :=
    Matrix.inv_eq_right_inv
      (Work.MotC5N3.asM_mul_asMinv (five_eq_zero_KbA K) (asRoot g))
  funext j
  simp only [asTwY, asKap, asNO, Work.MotAS.asMinv, Matrix.map_apply, Matrix.mulVec,
    dotProduct, hinv]

/-- `asM w · y = κ`. -/
lemma asMO_mulVec_asTwY : asMO D g *ᵥ asTwY D g = asKap D g := by
  rw [asTwY_eq_mulVec, Matrix.mulVec_mulVec, asMO_mul_asNO, Matrix.one_mulVec]

/-- `asM w` acts injectively on coefficient vectors. -/
lemma asNO_mulVec_asMO_mulVec (v : Fin 5 → OmA K D) :
    asNO D g *ᵥ (asMO D g *ᵥ v) = v := by
  rw [Matrix.mulVec_mulVec, asNO_mul_asMO, Matrix.one_mulVec]

lemma asMO_mulVec_injective : Function.Injective (asMO D g).mulVec := by
  intro v w h
  have h1 := congrArg (fun z => asNO D g *ᵥ z) h
  simpa only [asNO_mulVec_asMO_mulVec] using h1

lemma asNO1_mulVec_asMO1_mulVec (v : Fin 5 → OmA K D) :
    asNO1 D g *ᵥ (asMO1 D g *ᵥ v) = v := by
  rw [Matrix.mulVec_mulVec, asNO1_mul_asMO1, Matrix.one_mulVec]

lemma asMO1_mulVec_injective : Function.Injective (asMO1 D g).mulVec := by
  intro v w h
  have h1 := congrArg (fun z => asNO1 D g *ᵥ z) h
  simpa only [asNO1_mulVec_asMO1_mulVec] using h1

/-- The node `w+1+i` is the node `w+(i+1)`: the index arithmetic of the cyclic shift. -/
lemma asOM_add_one_add (i : Fin 5) :
    asOM D g + ((i + 1 : Fin 5) : ℕ) = asOM D g + 1 + (i : ℕ) := by
  have hmod : ((i + 1 : Fin 5) : ℕ) ≡ ((i : ℕ) + 1) [MOD 5] := by
    rw [Fin.val_add]
    norm_num
    exact Nat.mod_modEq ((i : ℕ) + 1) 5
  have h : asOM D g + (((i + 1 : Fin 5) : ℕ) : OmA K D)
      = asOM D g + (((i : ℕ) + 1 : ℕ) : OmA K D) := by
    rw [natCast_OmA_eq_of_modEq D hmod]
  rw [h]
  push_cast
  refl_ring1

/-- The shift relation between `asM w` and `asM (w+1)`: `asMO (i+1) j = asMO1 i j`. -/
lemma asMO_shift (i j : Fin 5) : asMO D g (i + 1) j = asMO1 D g i j := by
  rw [asMO_apply, asMO1_apply, asOM_add_one_add D g i]

/-! ## §2 `y_0 ≠ 0` -/

/-- The explicit value of the `0`-th Lagrange coordinate:
`y_0 = Σ_i (1 - (w+i)^4) κ_i`. -/
lemma asTwY_zero_eq :
    asTwY D g 0 = ∑ i : Fin 5, (1 - (asOM D g + (i : ℕ)) ^ 4) * asKap D g i := by
  rw [asTwY_eq_mulVec]
  simp only [Matrix.mulVec, dotProduct]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [asNO_zero_apply]

/-- The sum of the fourth powers of the five Artin–Schreier conjugates. -/
lemma sum_five_pow_four {R : Type*} [CommRing R] (h5 : (5 : R) = 0) (w : R) :
    ∑ i : Fin 5, (w + (i : ℕ)) ^ 4 = 4 := by
  rw [Fin.sum_univ_five]
  norm_num
  ring_nf
  linear_combination (norm := refl_ring1 (mod := 5))

/-- **`y_0 ≠ 0`**: the `0`-th Lagrange coordinate does not vanish, so the projective normalisation
`y_j/y_0` is legitimate. -/
lemma asTwY_zero_ne_zero (hD : D.Good) : asTwY D g 0 ≠ 0 := by
  intro hzero
  have hsum : ∑ i : Fin 5, (1 - (asRoot g + (i : ℕ)) ^ 4) • asKap D g i = 0 := by
    have hcongr : (∑ i : Fin 5, (1 - (asRoot g + (i : ℕ)) ^ 4) • asKap D g i)
        = ∑ i : Fin 5, (1 - (asOM D g + (i : ℕ)) ^ 4) * asKap D g i := by
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [asOM, asKap, map_sub, map_one, map_add, map_pow, map_natCast, Algebra.smul_def]
    rw [hcongr, ← asTwY_zero_eq D g, hzero]
  obtain ⟨e, he⟩ := hD.spans
  have hind : LinearIndependent (KbA K) (Work.MotV.kleinCoord D (KbA K)) :=
    kleinCoord_linearIndependent_KbA D hD
  rw [Fintype.linearIndependent_iff] at hind
  have hall : ∀ i : Fin 5, (asRoot g + (i : ℕ)) ^ 4 = 1 := by
    intro i
    have h1 := hind (fun i => 1 - (asRoot g + (i : ℕ)) ^ 4) hsum i
    linear_combination (norm := refl_ring1) -h1
  have h4 : ∑ i : Fin 5, (asRoot g + (i : ℕ)) ^ 4 = (4 : KbA K) :=
    sum_five_pow_four (five_eq_zero_KbA K) (asRoot g)
  have h5 : ∑ i : Fin 5, (asRoot g + (i : ℕ)) ^ 4 = (5 : KbA K) := by
    simp [hall]
  have h45 : (4 : KbA K) = (5 : KbA K) := h4.symm.trans h5
  have h1 : (1 : KbA K) = 0 := by
    have h : (5 : KbA K) - (4 : KbA K) = 0 := by
      rw [← h45, sub_self]
    rw [show (5 : KbA K) - (4 : KbA K) = 1 by norm_num] at h
    exact h
  exact one_ne_zero h1

end Lagrange

/-! ## §3 The twisted action on the Lagrange coordinates -/

section Twist

/-- The twisted Artin–Schreier action `σ' = σS ∘ τ`. -/
noncomputable def asSig (D : Work.MotV.KleinData 𝕜)
    (τ : OmA K D ≃ₐ[K] OmA K D)
    (σS : OmA K D ≃ₐ[KbA K] OmA K D) :
    OmA K D ≃ₐ[K] OmA K D :=
  asTwistAction D τ σS

variable (D : Work.MotV.KleinData 𝕜) (g : K)
  (τ : OmA K D ≃ₐ[K] OmA K D)
  (σS : OmA K D ≃ₐ[KbA K] OmA K D)
  (σ : KbA K ≃ₐ[K] KbA K)

lemma asSig_apply (x : OmA K D) : asSig D τ σS x = σS (τ x) := rfl

/-- `σ' (asRoot g) = asRoot g + 1`. -/
lemma asSig_asOM (h : ASTwistData 𝕜 D g τ σS σ) :
    asSig D τ σS (asOM D g) = asOM D g + 1 := by
  rw [asSig_apply]
  change σS (τ (algebraMap (KbA K) (OmA K D) (asRoot g)))
    = asOM D g + 1
  rw [h.hτ, h.hσ]
  simp [asOM]

/-- The Klein coordinates are nonzero. -/
lemma asKap_ne_zero (hD : D.Good) (i : Fin 5) : asKap D g i ≠ 0 := by
  exact (kleinCoord_linearIndependent_KbA D hD).ne_zero i

/-- `σ'` permutes the Klein coordinates projectively: `σ'(κ_i)/σ'(κ_0) = κ_{i+1}/κ_1`. -/
lemma asSig_asKap_ratio (h : ASTwistData 𝕜 D g τ σS σ) (i : Fin 5) :
    asSig D τ σS (asKap D g i) / asSig D τ σS (asKap D g 0) = asKap D g (i + 1) / asKap D g 1 := by
  obtain ⟨lam, hlamne, hlam⟩ := h.hσS
  rw [asSig_apply, asSig_apply]
  have h1 : σS (τ (asKap D g i)) / σS (τ (asKap D g 0))
      = σS (τ (asKap D g i) / τ (asKap D g 0)) := (map_div₀ σS _ _).symm
  rw [h1]
  have h2 : τ (asKap D g i) / τ (asKap D g 0) = τ (asKap D g i / asKap D g 0) :=
    (map_div₀ τ _ _).symm
  rw [h2]
  simp only [asKap]
  rw [h.hτk _ (IntermediateField.subset_adjoin _ _ (Set.mem_range_self i))]
  rw [map_div₀, hlam i, hlam 0]
  norm_num
  field_simp

/-- `σ'` acts on the Klein coordinates by the shift, up to the global scalar `σ'(κ_0)/κ_1`. -/
lemma asSig_asKap (h : ASTwistData 𝕜 D g τ σS σ) (hD : D.Good) (i : Fin 5) :
    asSig D τ σS (asKap D g i)
      = (asSig D τ σS (asKap D g 0) / asKap D g 1) * asKap D g (i + 1) := by
  have h1 : asKap D g 1 ≠ 0 := asKap_ne_zero D g hD 1
  have hσ0 : asSig D τ σS (asKap D g 0) ≠ 0 := by
    simpa using (asSig D τ σS).injective.ne (asKap_ne_zero D g hD 0)
  have h := asSig_asKap_ratio D g τ σS σ h i
  field_simp at h
  field_simp
  linear_combination (norm := refl_ring1) h

/-- Applying `σ'` to the interpolation equation at the node `w + i`. -/
lemma asSig_eval (h : ASTwistData 𝕜 D g τ σS σ) (i : Fin 5) :
    asSig D τ σS (∑ j : Fin 5, (asOM D g + (i : ℕ)) ^ (j : ℕ) * asTwY D g j)
      = ∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ) * asSig D τ σS (asTwY D g j) := by
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_mul, map_pow, map_add, map_natCast, asSig_asOM D g τ σS σ h]

/-- The `i`-th Lagrange interpolation equation: `Σ_j (w+i)^j y_j = κ_i`. -/
lemma asTwY_interp (i : Fin 5) :
    (∑ j : Fin 5, (asOM D g + (i : ℕ)) ^ (j : ℕ) * asTwY D g j) = asKap D g i := by
  have h1 := congrFun (asMO_mulVec_asTwY D g) i
  simpa only [Matrix.mulVec, dotProduct, asMO_apply] using h1

/-- **The Lagrange coordinates are eigenvectors of the twisted action**: `σ'(y_j) = c y_j` for the
single scalar `c = σ'(κ_0)/κ_1`. -/
lemma asSig_asTwY (h : ASTwistData 𝕜 D g τ σS σ) (hD : D.Good) (j : Fin 5) :
    asSig D τ σS (asTwY D g j)
      = (asSig D τ σS (asKap D g 0) / asKap D g 1) * asTwY D g j := by
  set c : OmA K D := asSig D τ σS (asKap D g 0) / asKap D g 1 with hc
  have hker : ∀ i : Fin 5, (∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ)
      * (asSig D τ σS (asTwY D g j) - c * asTwY D g j)) = 0 := by
    intro i
    have h2 : (∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ)
        * asSig D τ σS (asTwY D g j)) = c * asKap D g (i + 1) := by
      rw [← asSig_eval D g τ σS σ h, asTwY_interp D g,
        asSig_asKap D g τ σS σ h hD i, hc]
    have h3 : c * asKap D g (i + 1)
        = ∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ) * (c * asTwY D g j) := by
      rw [← asTwY_interp D g (i + 1), Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [asOM_add_one_add D g i]
      refl_ring1
    have hsub : (∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ)
          * (asSig D τ σS (asTwY D g j) - c * asTwY D g j))
        = (∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ) * asSig D τ σS (asTwY D g j))
          - (∑ j : Fin 5, (asOM D g + 1 + (i : ℕ)) ^ (j : ℕ) * (c * asTwY D g j)) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      refl_ring1
    rw [hsub, h2, h3, sub_self]
  have hz : (fun j : Fin 5 => asSig D τ σS (asTwY D g j) - c * asTwY D g j) = 0 := by
    refine asMO1_mulVec_injective D g ?_
    rw [Matrix.mulVec_zero]
    funext i
    simpa only [Matrix.mulVec, dotProduct, asMO1_apply, Pi.zero_apply] using hker i
  have hj := congrFun hz j
  rw [Pi.zero_apply, sub_eq_zero] at hj
  rw [hj, hc]

end Twist

/-! ## §4 The two inclusions -/

section Incl

variable (D : Work.MotV.KleinData 𝕜) (g : K)
  (τ : OmA K D ≃ₐ[K] OmA K D)
  (σS : OmA K D ≃ₐ[KbA K] OmA K D)
  (σ : KbA K ≃ₐ[K] KbA K)

/-- The projective Lagrange coordinates `y_j/y_0` — the generators of `twistFieldAS`. -/
noncomputable def asR (j : Fin 5) : OmA K D := asTwY D g j / asTwY D g 0

/-- The homogeneous form of the Lagrange coordinates: `y_j = κ_0 · asA j`. -/
noncomputable def asA (j : Fin 5) : OmA K D :=
  ∑ i : Fin 5, asNO D g j i * (asKap D g i / asKap D g 0)

/-- The compositum `twistFieldAS ⊔ K⟮asRoot g⟯`. -/
noncomputable def asFW : IntermediateField K (OmA K D) :=
  twistFieldAS D g ⊔ IntermediateField.adjoin K {asOM D g}

lemma asR_mem : ∀ j, asR D g j ∈ twistFieldAS D g := by
  intro j
  exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self j)

lemma asTwY_eq_mul_asA (hD : D.Good) : ∀ j, asTwY D g j = asKap D g 0 * asA D g j := by
  have h0 : asKap D g 0 ≠ 0 := hD.coord0_ne (KbA K)
  intro j
  rw [asTwY_eq_mulVec, asA, Finset.mul_sum]
  simp only [Matrix.mulVec, dotProduct]
  refine Finset.sum_congr rfl fun i _ => ?_
  field_simp

/-- The `0`-th homogeneous coordinate is nonzero. -/
lemma asA_zero_ne_zero (hD : D.Good) : asA D g 0 ≠ 0 := by
  intro h
  have hy0 : asTwY D g 0 ≠ 0 := asTwY_zero_ne_zero D g hD
  rw [asTwY_eq_mul_asA D g hD 0, h, mul_zero] at hy0
  exact hy0 rfl

/-- The projective coordinates are ratios of the homogeneous ones. -/
lemma asR_eq_div (hD : D.Good) (j : Fin 5) :
    asR D g j = asA D g j / asA D g 0 := by
  have h0 : asKap D g 0 ≠ 0 := hD.coord0_ne (KbA K)
  have hA0 : asA D g 0 ≠ 0 := asA_zero_ne_zero D g hD
  rw [asR, asTwY_eq_mul_asA D g hD j, asTwY_eq_mul_asA D g hD 0]
  field_simp

/-- `y_j/y_0 ∈ L(E) = asFieldL D g`. -/
lemma asR_mem_asFieldL (hD : D.Good) (j : Fin 5) : asR D g j ∈ asFieldL D g := by
  have hx : ∀ i : Fin 5, asKap D g i / asKap D g 0 ∈ kleinField K D :=
    fun i => IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)
  have hle : kleinField K D ≤ asFieldL D g := le_sup_left
  have hNO : ∀ i : Fin 5, asNO D g j i ∈ asFieldL D g := asNO_mem_asFieldL D g j
  have hA : asA D g j ∈ asFieldL D g :=
    sum_mem fun i _ => mul_mem (hNO i) (hle (hx i))
  have hA0 : asA D g 0 ∈ asFieldL D g :=
    sum_mem fun i _ => mul_mem (asNO_mem_asFieldL D g 0 i) (hle (hx i))
  rw [asR_eq_div D g hD j]
  exact div_mem hA hA0

end Incl

section Main

variable (D : Work.MotV.KleinData 𝕜) (g : K)
  (τ : OmA K D ≃ₐ[K] OmA K D)
  (σS : OmA K D ≃ₐ[KbA K] OmA K D)
  (σ : KbA K ≃ₐ[K] KbA K)

/-- The Klein ratios as rational functions of `asRoot g` and the projective Lagrange coordinates. -/
lemma asKap_div_eq (hD : D.Good) (i : Fin 5) :
    asKap D g i / asKap D g 0
      = (∑ j : Fin 5, (asOM D g + (i : ℕ)) ^ (j : ℕ) * asR D g j)
        / (∑ j : Fin 5, (asOM D g + (0 : ℕ)) ^ (j : ℕ) * asR D g j) := by
  have hy0 : asTwY D g 0 ≠ 0 := asTwY_zero_ne_zero D g hD
  have hyj : ∀ j, asTwY D g j = asTwY D g 0 * asR D g j := by
    intro j
    rw [asR]
    field_simp
  have hnum : asKap D g i
      = asTwY D g 0 * (∑ j : Fin 5, (asOM D g + (i : ℕ)) ^ (j : ℕ) * asR D g j) := by
    rw [← asTwY_interp D g i, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hyj j]
    refl_ring1
  have hden : asKap D g 0
      = asTwY D g 0 * (∑ j : Fin 5, (asOM D g + (0 : ℕ)) ^ (j : ℕ) * asR D g j) := by
    rw [← asTwY_interp D g 0]
    simp only [Fin.val_zero, Nat.cast_zero, add_zero]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hyj j]
    refl_ring1
  rw [hnum, hden]
  field_simp

lemma asKap_div_mem (hD : D.Good) (i : Fin 5) : asKap D g i / asKap D g 0 ∈ asFW D g := by
  have hw : asOM D g ∈ asFW D g := by
    have hsub : IntermediateField.adjoin K {asOM D g} ≤ asFW D g := le_sup_right
    exact hsub (asOM_mem_adjoin_asOM D g)
  have hnat : ∀ n : ℕ, ((n : ℕ) : OmA K D) ∈ asFW D g := by
    intro n
    have h := IntermediateField.algebraMap_mem (asFW D g) ((n : ℕ) : K)
    simpa only [map_natCast] using h
  have hr : ∀ j, asR D g j ∈ asFW D g := by
    intro j
    exact (show twistFieldAS D g ≤ asFW D g from le_sup_left) (asR_mem D g j)
  have hsum : ∀ i : Fin 5,
      (∑ j : Fin 5, (asOM D g + (i : ℕ)) ^ (j : ℕ) * asR D g j) ∈ asFW D g :=
    fun i => sum_mem fun j _ => mul_mem (pow_mem (add_mem hw (hnat i)) _) (hr j)
  rw [asKap_div_eq D g hD i]
  exact div_mem (hsum i) (hsum 0)

lemma kleinField_le_asFW (hD : D.Good) : kleinField K D ≤ asFW D g := by
  rw [kleinField, IntermediateField.adjoin_le_iff]
  rintro x ⟨i, rfl⟩
  exact asKap_div_mem D g hD i

/-- The Lagrange coordinates `y_j/y_0` lie in `L(E) = asFieldL D g`. -/
lemma twistFieldAS_le_asFieldL (hD : D.Good) :
    twistFieldAS D g ≤ asFieldL D g := by
  rw [twistFieldAS, IntermediateField.adjoin_le_iff]
  rintro x ⟨j, rfl⟩
  exact asR_mem_asFieldL D g hD j

lemma twistFieldAS_le_asTwistFieldFix (h : ASTwistData 𝕜 D g τ σS σ) (hD : D.Good) :
    twistFieldAS D g ≤ asTwistFieldFix D τ σS := by
  rw [twistFieldAS, IntermediateField.adjoin_le_iff]
  rintro x ⟨j, rfl⟩
  change asTwY D g j / asTwY D g 0 ∈ asTwistFieldFix D τ σS
  rw [asTwistFieldFix, IntermediateField.mem_fixedField_iff]
  intro f hf
  have hσ0 : asSig D τ σS (asKap D g 0) ≠ 0 := by
    simpa using (asSig D τ σS).injective.ne (asKap_ne_zero D g hD 0)
  have hk1 : asKap D g 1 ≠ 0 := asKap_ne_zero D g hD 1
  have hy0 : asTwY D g 0 ≠ 0 := asTwY_zero_ne_zero D g hD
  have hc : asSig D τ σS (asKap D g 0) / asKap D g 1 ≠ 0 := div_ne_zero hσ0 hk1
  have hfix : asSig D τ σS (asTwY D g j / asTwY D g 0) = asTwY D g j / asTwY D g 0 := by
    rw [map_div₀, asSig_asTwY D g τ σS σ h hD j, asSig_asTwY D g τ σS σ h hD 0]
    field_simp
  have hstab : asSig D τ σS ∈ MulAction.stabilizer
      (OmA K D ≃ₐ[K] OmA K D) (asTwY D g j / asTwY D g 0) :=
    (MulAction.mem_stabilizer_iff).mpr (by simpa [AlgEquiv.smul_def] using hfix)
  have hmem := (Subgroup.zpowers_le (g := asSig D τ σS)).mpr hstab hf
  simpa [AlgEquiv.smul_def] using (MulAction.mem_stabilizer_iff).mp hmem

lemma twistFieldAS_le_asTwistFieldTrue (h : ASTwistData 𝕜 D g τ σS σ)
    (hD : D.Good) :
    twistFieldAS D g ≤ asTwistFieldTrue D g τ σS := by
  rw [asTwistFieldTrue]
  exact le_inf (twistFieldAS_le_asTwistFieldFix D g τ σS σ h hD)
    (twistFieldAS_le_asFieldL D g hD)

/-- The key identity: `L(E) = K(y_j/y_0) ⊔ K⟮asRoot g⟯`. -/
lemma asFieldL_eq_asFW (hD : D.Good) :
    asFieldL D g = asFW D g := by
  refine le_antisymm ?_ ?_
  · rw [asFieldL]
    exact sup_le (kleinField_le_asFW D g hD) le_sup_right
  · refine sup_le (twistFieldAS_le_asFieldL D g hD) ?_
    rw [asFieldL]
    exact le_sup_right

lemma asFW_eq_restrict :
    asFW D g = IntermediateField.restrictScalars K
      (IntermediateField.adjoin ↥(twistFieldAS D g) {asOM D g}) := by
  refine le_antisymm ?_ ?_
  · refine sup_le ?_ ?_
    · intro x hx
      have h := IntermediateField.algebraMap_mem
        (IntermediateField.adjoin ↥(twistFieldAS D g) {asOM D g})
        (⟨x, hx⟩ : ↥(twistFieldAS D g))
      simpa using h
    · refine IntermediateField.adjoin_le_iff.mpr ?_
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
  · have hleF : twistFieldAS D g ≤ asFW D g := le_sup_left
    have hX : IntermediateField.adjoin ↥(twistFieldAS D g) {asOM D g} ≤
        IntermediateField.extendScalars hleF := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      have hsub : IntermediateField.adjoin K {asOM D g} ≤ asFW D g := le_sup_right
      exact hsub (asOM_mem_adjoin_asOM D g)
    intro x hx
    exact hX hx

/-- `asFieldL` as the simple extension of the twist field by `asRoot g`. -/
lemma asFieldL_eq_restrict (hD : D.Good) :
    asFieldL D g = IntermediateField.restrictScalars K
      (IntermediateField.adjoin ↥(twistFieldAS D g) {asOM D g}) := by
  rw [asFieldL_eq_asFW D g hD, asFW_eq_restrict D g]

/-! ## §6 The degree computation -/

/-- The Artin–Schreier polynomial of `asRoot g` over the twist field. -/
noncomputable def asOMpoly : Polynomial ↥(twistFieldAS D g) :=
  Polynomial.X ^ 5 - Polynomial.X
    - Polynomial.C (algebraMap K ↥(twistFieldAS D g) g)

lemma asOMpoly_monic : (asOMpoly D g).Monic := by
  have hpoly : asOMpoly D g = (Polynomial.X ^ 5
      - Polynomial.C (algebraMap K ↥(twistFieldAS D g) g) :
        Polynomial ↥(twistFieldAS D g)) - Polynomial.X := by
    simp only [asOMpoly]
    refl_ring1
  rw [hpoly]
  refine (Polynomial.monic_X_pow_sub_C _ (by norm_num : (5 : ℕ) ≠ 0)).sub_of_left ?_
  rw [Polynomial.degree_X, Polynomial.degree_X_pow_sub_C (by norm_num : 0 < 5) _]
  norm_num

lemma asOMpoly_ne_zero : asOMpoly D g ≠ 0 := (asOMpoly_monic D g).ne_zero

lemma asOMpoly_aeval : Polynomial.aeval (asOM D g) (asOMpoly D g) = 0 := by
  have h1 : asOM D g ^ 5 - asOM D g = algebraMap K (OmA K D) g := by
    have h := asRoot_spec g
    simp only [asOM]
    rw [← map_pow (algebraMap (KbA K) (OmA K D)) (asRoot g) 5, ← map_sub, h,
      IsScalarTower.algebraMap_apply K (KbA K) (OmA K D) g]
  have h2 : algebraMap ↥(twistFieldAS D g) (OmA K D)
      (algebraMap K ↥(twistFieldAS D g) g)
      = algebraMap K (OmA K D) g :=
    IsScalarTower.algebraMap_apply K ↥(twistFieldAS D g) (OmA K D) g
  rw [asOMpoly, Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_sub,
    Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C, h2, h1, sub_self]

lemma asOM_isIntegral : IsIntegral ↥(twistFieldAS D g) (asOM D g) :=
  ⟨asOMpoly D g, asOMpoly_monic D g, asOMpoly_aeval D g⟩

lemma minpoly_asOM_natDegree_le_five :
    (minpoly ↥(twistFieldAS D g) (asOM D g)).natDegree ≤ 5 := by
  have hdvd : minpoly ↥(twistFieldAS D g) (asOM D g) ∣ asOMpoly D g :=
    minpoly.dvd _ _ (asOMpoly_aeval D g)
  have hdeg : (asOMpoly D g).natDegree = 5 := by
    unfold asOMpoly
    compute_degree!
  calc (minpoly ↥(twistFieldAS D g) (asOM D g)).natDegree ≤ (asOMpoly D g).natDegree :=
        Polynomial.natDegree_le_of_dvd hdvd (asOMpoly_ne_zero D g)
    _ = 5 := hdeg

lemma minpoly_asOM_natDegree_pos :
    1 ≤ (minpoly ↥(twistFieldAS D g) (asOM D g)).natDegree := by
  have hmon : (minpoly ↥(twistFieldAS D g) (asOM D g)).Monic :=
    minpoly.monic (asOM_isIntegral D g)
  have hne1 : minpoly ↥(twistFieldAS D g) (asOM D g) ≠ 1 := by
    intro h1
    have h := minpoly.aeval ↥(twistFieldAS D g) (asOM D g)
    rw [h1, Polynomial.aeval_one] at h
    exact one_ne_zero h
  by_contra h
  rw [Nat.not_le] at h
  have h0 : (minpoly ↥(twistFieldAS D g) (asOM D g)).natDegree = 0 := by omega
  have hle : (minpoly ↥(twistFieldAS D g) (asOM D g)).degree ≤ 0 := by
    rw [← Polynomial.natDegree_eq_zero_iff_degree_le_zero]
    exact h0
  exact hne1 ((hmon.degree_le_zero_iff_eq_one).mp hle)

end Main

/-- **G-EQ** (node AS-EQ at a general base field `K`): the explicit AS twist field
`twistFieldAS D g = K(y_j/y_0)` — Galois coordinates `y = asM(asRoot g)⁻¹ κ`, the model of
`Submission/Work/MotC5N3/Defs.lean` — coincides with the fixed field
`asTwistFieldTrue D g τ σS = Fix(σ') ⊓ L(E)` of the twisted Artin–Schreier action
`σ' = asTwistAction D τ σS`, for *every* `ASTwistData` bundle over the general base field.

This is the `RatFunc 𝕜 ↦ K` fork of `Work.MotAS.twistFieldAS_eq`
(`Submission/Work/MotAS/twistFieldAS_eq.lean`), whose base field is `RatFunc 𝕜` and whose twisted
action is `Work.MotV5.asTwistAction`; here `K` is an arbitrary `𝕜`-algebra field of
characteristic `5` and `OmA K D = K̄(E)`.  The two inclusions of the source argument transpose
verbatim: `⊆` from `σ'(y_j) = c y_j` for a single scalar `c ≠ 0` (Lagrange coordinates are
eigenvectors of `σ'`), `⊇` from `asFieldL = twistFieldAS ⊔ K⟮asRoot g⟯` together with
`[asFieldL : twistFieldAS] ≤ 5 = [asFieldL : asTwistFieldTrue]`.

Support files to fork from `Submission/Work/MotAS/` into namespace `Work.MotC5N3` (see
`Submission/Work/MotC5N3/port.py` for the calibrated textual port, and `Work.MotC5N3.TwistField.*`
for the WP1 forks already done): `TwistField.lean` (`asM`, `asOM`, `asNO`, `asKap`, `asA`, `asFW`,
`asR`, `asMinv`, `asMO`), `asMinv_mul_asM.lean`, `ASMinv.lean`, `asM_mul_asMinv.lean`,
`twistFieldAS_eq.lean` itself, plus the generic imports `Submission.Work.MotTDG.Setup` (for
`kleinCoord_linearIndependent`) and `Submission.Work.MotV5.relfinrank_eq_natDegree_minpoly`.
The Lagrange-matrix identities (`asMO_mul_asNO = 1`, `asTwY_eq_mulVec`, `asTwY_zero_ne_zero`,
`asSig_asTwY`) must be forked too — they are not yet present under `Work.MotC5N3`.

Deliverable: forked module(s) implementing this in namespace `Work.MotC5N3`, in particular the file
`Submission/Work/MotC5N3/twistFieldAS_eq.lean`, sorry-free and axiom-clean
(`[propext, Classical.choice, Quot.sound]`). -/
theorem twistFieldAS_eq (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K]
    [CharP K 5] (D : Work.MotV.KleinData 𝕜) (hD : Work.MotV5.KleinData.ASGood D) (g : K)
    (τ : Work.MotC5N3.OmA K D ≃ₐ[K] Work.MotC5N3.OmA K D)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (σ : Work.MotC5N3.KbA K ≃ₐ[K] Work.MotC5N3.KbA K)
    (h : Work.MotC5N3.ASTwistData 𝕜 D g τ σS σ) :
    Work.MotC5N3.twistFieldAS D g = Work.MotC5N3.asTwistFieldTrue D g τ σS := by
  have hG : D.Good := hD.1
  refine le_antisymm (twistFieldAS_le_asTwistFieldTrue D g τ σS σ h hG) ?_
  set T : IntermediateField K (OmA K D) :=
    asTwistFieldTrue D g τ σS with hT
  set F : IntermediateField K (OmA K D) := twistFieldAS D g with hF
  have hFT : F ≤ T := twistFieldAS_le_asTwistFieldTrue D g τ σS σ h hG
  have hTL : T ≤ asFieldL D g := asTwistFieldTrue_le_asFieldL D g τ σS
  have hFL : F ≤ asFieldL D g := twistFieldAS_le_asFieldL D g hG
  have hTrel : T.relfinrank (asFieldL D g) = 5 :=
    (GenAux_asTwistFieldTrue_finrank_and_isSeparable 𝕜 D g τ σS
      h.h5L h.hneL h.hpres).1
  have hB : asFieldL D g = IntermediateField.restrictScalars K
      (IntermediateField.adjoin ↥F {asOM D g}) := asFieldL_eq_restrict D g hG
  have hdeg : F.relfinrank (asFieldL D g) = (minpoly ↥F (asOM D g)).natDegree :=
    Work.MotV5.relfinrank_eq_natDegree_minpoly hFL hB (asOM_isIntegral D g)
  have hle5 : F.relfinrank (asFieldL D g) ≤ 5 := by
    rw [hdeg]
    exact minpoly_asOM_natDegree_le_five D g
  have hpos : 1 ≤ F.relfinrank (asFieldL D g) := by
    rw [hdeg]
    exact minpoly_asOM_natDegree_pos D g
  have htower : F.relfinrank T * T.relfinrank (asFieldL D g)
      = F.relfinrank (asFieldL D g) :=
    IntermediateField.relfinrank_mul_relfinrank hFT hTL
  rw [hTrel] at htower
  have hk1 : F.relfinrank T ≤ 1 := by omega
  have hk0 : 1 ≤ F.relfinrank T := by omega
  have hkr : F.relfinrank T = 1 := le_antisymm hk1 hk0
  exact IntermediateField.relfinrank_eq_one_iff.mp hkr

end Work.MotC5N3
