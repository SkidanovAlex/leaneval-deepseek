import Mathlib
import Submission.Work.MotC5N3.Defs
import Submission.Work.MotV5.Defs
import Submission.Work.MotV.Defs

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# The Artin–Schreier twisted Klein coordinates (general base field `K`)

Port of the definition `Work.MotV5.asTwCoord` of `Submission/Work/MotV5/Defs.lean` to an arbitrary
base field `K` of characteristic `5` in place of `K = 𝕜(t)`.

The `j`-th twisted coordinate is the coefficient of `T^j` in the Lagrange interpolation polynomial
of the Klein ratios `x_i = κ_i/κ_0` at the Galois-conjugate nodes `W + i`, `W = asRoot g`:

  `y_j = -∑_i x_i ((W + i)^{4-j} - δ_{j,0})`.

Its interpolation identity is `Work.MotC5N3.asCoord_asTwCoord`.
-/

set_option autoImplicit false

namespace Work.MotC5N3
noncomputable section

/-- The Artin–Schreier twist of the Klein point: the coefficients of the interpolation polynomial
of `x = κ_i/κ_0` through the Galois-conjugate nodes `W + i`, i.e. the `K`-rational coordinates of
the twisted curve `C^AS_g`. -/
def asTwCoord {𝕜 : Type} [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K]
    (D : Work.MotV.KleinData 𝕜) (g : K)
    (j : Fin 5) : OmA K D :=
  -∑ i : Fin 5, (Work.MotV.kleinCoord D (KbA K) i / Work.MotV.kleinCoord D (KbA K) 0) *
    ((algebraMap (KbA K) (OmA K D) (asRoot g) + ((i : ℕ) : OmA K D)) ^ (4 - (j : ℕ)) -
      (if (j : ℕ) = 0 then 1 else 0))

/-- **The AS twist field** `K(C^AS_g)`: the `K`-subfield of `K̄(E)` generated by the twisted Klein
coordinates (the interpolation model of the definition of `Work.MotV5.asTwistField`). -/
def asTwistField {𝕜 : Type} [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K]
    (D : Work.MotV.KleinData 𝕜) (g : K) : IntermediateField K (OmA K D) :=
  IntermediateField.adjoin K (Set.range (asTwCoord D g))

end
end Work.MotC5N3
