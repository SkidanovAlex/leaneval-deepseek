variable {𝕜 : Type} [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5]

/-- The general construction of `ASTwistData` from the coefficient action and the shift. -/
theorem asTwistData_of (D : Work.MotV.KleinData 𝕜) (hD : D.Good) (g : K)
    (τ : Work.MotC5N3.OmA K D ≃ₐ[K] Work.MotC5N3.OmA K D)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (σ : Work.MotC5N3.KbA K ≃ₐ[K] Work.MotC5N3.KbA K)
    (hτ : ∀ c : Work.MotC5N3.KbA K, τ (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) c)
      = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (σ c))
    (hτκ : ∀ i : Fin 5, τ (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i)
      = Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i)
    (hσ : σ (Work.MotC5N3.asRoot g) = Work.MotC5N3.asRoot g + 1)
    (hσS : Work.MotC5N3.KleinData.ShiftOf D σS) :
    Work.MotC5N3.ASTwistData 𝕜 D g τ σS σ := by
  obtain ⟨lam, hlam, hshift⟩ := hσS
  have hσS' : Work.MotC5N3.KleinData.ShiftOf D σS := ⟨lam, hlam, hshift⟩
  haveI hch : CharP (Work.MotC5N3.KbA K) 5 :=
    charP_of_injective_algebraMap (algebraMap 𝕜 (Work.MotC5N3.KbA K)).injective 5
  have hκ0 : Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 ≠ 0 := hD.coord0_ne (Work.MotC5N3.KbA K)
  have h01 : ((0 : Fin 5) + 1) = 1 := by decide
  set ψ : Work.MotC5N3.OmA K D ≃ₐ[K] Work.MotC5N3.OmA K D :=
    Work.MotC5N3.asTwistAction D τ σS with hψ
  set r : Fin 5 → Work.MotC5N3.OmA K D := fun i =>
    Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0
    with hr
  have hr_apply : ∀ i : Fin 5, r i = Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i
      / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 := fun i => rfl
  -- ## elementary facts
  have hψalg : ∀ c : Work.MotC5N3.KbA K,
      ψ (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) c)
        = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (σ c) := by
    intro c
    rw [hψ, Work.MotC5N3.asTwistAction, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply,
      hτ c]
    exact σS.commutes (σ c)
  have hσpow : ∀ n : ℕ, (σ ^ n) (Work.MotC5N3.asRoot g) = Work.MotC5N3.asRoot g + n := by
    intro n
    induction n with
    | zero => simp
    | succ m ih =>
        rw [pow_succ, AlgEquiv.mul_apply, hσ, map_add, map_one, ih]
        push_cast
        first | refl_ring1 | ring
  have hσ5 : (σ ^ 5) (Work.MotC5N3.asRoot g) = Work.MotC5N3.asRoot g := by
    rw [hσpow 5, CharP.cast_eq_zero (Work.MotC5N3.KbA K) 5, add_zero]
  have hψalgpow : ∀ n : ℕ, ∀ c : Work.MotC5N3.KbA K,
      (ψ ^ n) (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) c)
        = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) ((σ ^ n) c) := by
    intro n
    induction n with
    | zero => intro c; simp
    | succ m ih =>
        intro c
        rw [pow_succ', AlgEquiv.mul_apply, ih, hψalg, pow_succ', AlgEquiv.mul_apply]
  have hψW : (ψ ^ 5) (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g))
      = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g) := by
    rw [hψalgpow 5, hσ5]
  -- ## `ψ` on the Klein coordinates
  have hψκ : ∀ j : Fin 5, ψ (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) j)
      = lam * Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) (j + 1) := by
    intro j
    rw [hψ, Work.MotC5N3.asTwistAction, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply,
      hτκ j, hshift j]
  -- ## `τ` fixes the geometric part `K(E)`
  have hτklein : ∀ x ∈ Work.MotC5N3.kleinField K D, τ x = x := by
    have hle : Work.MotC5N3.kleinField K D
        ≤ IntermediateField.fixedField (Subgroup.zpowers (τ ^ 1)) := by
      rw [Work.MotC5N3.kleinField, IntermediateField.adjoin_le_iff]
      rintro x ⟨i, rfl⟩
      refine (mem_fixedField_zpowers_pow τ 1 _).mpr ?_
      rw [pow_one]
      show τ (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i
          / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0)
        = Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i
          / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0
      rw [map_div₀, hτκ i, hτκ 0]
    intro x hx
    have h' := hle hx
    have h2 := (mem_fixedField_zpowers_pow τ 1 x).mp h'
    simpa [pow_one] using h2
  -- ## the scalar `Λ k` with `ψ^k κ_i = Λ k * κ_{i+k}`
  let Λ : ℕ → Work.MotC5N3.OmA K D :=
    fun k => Nat.rec (1 : Work.MotC5N3.OmA K D) (fun _ acc => ψ acc * lam) k
  have hΛ0 : Λ 0 = 1 := rfl
  have hΛsucc : ∀ k : ℕ, Λ (k + 1) = ψ (Λ k) * lam := fun k => rfl
  have hΛne : ∀ k : ℕ, Λ k ≠ 0 := by
    intro k
    induction k with
    | zero => rw [hΛ0]; exact one_ne_zero
    | succ m ih =>
        rw [hΛsucc]
        exact mul_ne_zero (fun hh => ih (ψ.injective (by simpa using hh))) hlam
  have hΛκ : ∀ k : ℕ, ∀ i : Fin 5,
      (ψ ^ k) (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i)
        = Λ k * Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) (i + k • (1 : Fin 5)) := by
    intro k
    induction k with
    | zero => intro i; simp [hΛ0]
    | succ m ih =>
        intro i
        rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, hψκ, hΛsucc, succ_nsmul, mul_assoc,
          add_assoc]
  have h5smul : (5 : ℕ) • (1 : Fin 5) = 0 := by decide
  -- ## `asFieldL D g` as a single adjoin
  have hgen : Work.MotC5N3.asFieldL D g
      = IntermediateField.adjoin (K)
          (Set.range r ∪ {algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)}) := by
    have h1 : Work.MotC5N3.asFieldL D g
        = IntermediateField.adjoin (K) (Set.range r)
          ⊔ IntermediateField.adjoin (K)
              {algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)} := rfl
    rw [h1, IntermediateField.adjoin_union]
  have hWmem : algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)
      ∈ Work.MotC5N3.asFieldL D g := by
    rw [hgen]
    exact IntermediateField.subset_adjoin _ _ (Or.inr (Set.mem_singleton _))
  -- ## `ψ ^ 5` fixes `asFieldL`
  have h5Lψ : ∀ x ∈ Work.MotC5N3.asFieldL D g, (ψ ^ 5) x = x := by
    have hle : Work.MotC5N3.asFieldL D g
        ≤ IntermediateField.fixedField (Subgroup.zpowers (ψ ^ 5)) := by
      rw [hgen, IntermediateField.adjoin_le_iff]
      rintro x (hx | hx)
      · obtain ⟨i, rfl⟩ := hx
        refine (mem_fixedField_zpowers_pow ψ 5 (r i)).mpr ?_
        have key : (ψ ^ 5) (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i
              / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0)
            = Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i
              / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 := by
          rw [map_div₀, hΛκ 5 i, hΛκ 5 0, h5smul, add_zero, add_zero]
          exact mul_div_mul_left _ _ (hΛne 5)
        simpa only [hr_apply i] using key
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact (mem_fixedField_zpowers_pow ψ 5 _).mpr hψW
    intro x hx
    exact (mem_fixedField_zpowers_pow ψ 5 x).mp (hle hx)
  -- ## `ψ` preserves `asFieldL`
  have hψr : ∀ i : Fin 5, ψ (r i) = r (i + 1) / r 1 := by
    intro i
    rw [hr_apply i, hr_apply (i + 1), hr_apply 1]
    rw [hψ, Work.MotC5N3.asTwistAction, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply,
      map_div₀]
    rw [hτκ i, hτκ 0]
    rw [map_div₀, hshift i, hshift 0, h01]
    rw [mul_div_mul_left _ _ hlam]
    field_simp
  have hpresψ : ∀ x ∈ Work.MotC5N3.asFieldL D g, ψ x ∈ Work.MotC5N3.asFieldL D g := by
    have hmap : IntermediateField.map ψ.toAlgHom (Work.MotC5N3.asFieldL D g)
        ≤ Work.MotC5N3.asFieldL D g := by
      rw [hgen, IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
      rintro y ⟨x, hx, rfl⟩
      rcases hx with hx | hx
      · obtain ⟨i, rfl⟩ := hx
        show ψ (r i) ∈ IntermediateField.adjoin (K)
          (Set.range r ∪ {algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)})
        rw [hψr i]
        exact div_mem (IntermediateField.subset_adjoin _ _ (Or.inl ⟨i + 1, rfl⟩))
          (IntermediateField.subset_adjoin _ _ (Or.inl ⟨1, rfl⟩))
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        show ψ (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g))
          ∈ IntermediateField.adjoin (K)
            (Set.range r ∪ {algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g)})
        have h1 : ψ (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g))
            = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g) + 1 := by
          rw [hψalg, hσ, map_add, map_one]
        rw [h1]
        exact IntermediateField.add_mem _
          (IntermediateField.subset_adjoin _ _ (Or.inr (Set.mem_singleton _)))
          (IntermediateField.one_mem _)
    intro x hx
    exact hmap ((IntermediateField.mem_map (f := ψ.toAlgHom) (S := Work.MotC5N3.asFieldL D g)).mpr
      ⟨x, hx, rfl⟩)
  -- ## `ψ` is nontrivial on `asFieldL`
  have hneLψ : ∃ x ∈ Work.MotC5N3.asFieldL D g, ψ x ≠ x := by
    refine ⟨algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g), hWmem, ?_⟩
    have h1 : ψ (algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g))
        = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g) + 1 := by
      rw [hψalg, hσ, map_add, map_one]
    rw [h1]
    intro hcon
    have h2 : algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g) + 1
        = algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (Work.MotC5N3.asRoot g) + 0 := by
      rw [add_zero]
      exact hcon
    exact one_ne_zero (add_left_cancel h2)
  refine ⟨hτ, hτklein, hσ, hσS', ?_, ?_, ?_⟩
  · intro x hx
    rw [← hψ]
    exact h5Lψ x hx
  · obtain ⟨x, hx, hne⟩ := hneLψ
    exact ⟨x, hx, fun h => hne (by rwa [← hψ] at h)⟩
  · intro x hx
    rw [← hψ]
    exact hpresψ x hx

end

/-- **Node ASData — the canonical twisting data.**  From the proved existence nodes, the
`Work.MotC5N3.ASTwistData` bundles of the two classes of the Artin–Schreier link are available: there
are `τ, τ₂ : Work.MotC5N3.OmA K D ≃ₐ[K] Work.MotC5N3.OmA K D`, a single projective fifth-torsion shift
`σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D` (extracted from `hsh : Work.MotC5N3.KleinData.ShiftCompatProj K D`) and Artin–Schreier
generators `σ, σ₂ : Work.MotC5N3.KbA K ≃ₐ[K] Work.MotC5N3.KbA K` with `ASTwistData 𝕜 D (fAS 𝕜) τ σS σ` and
`ASTwistData 𝕜 D (2 • fAS 𝕜) τ₂ σS σ₂`.

Route.  Take `σ` with `σ (asRoot (fAS 𝕜)) = asRoot (fAS 𝕜) + 1` (node `Work.MotV5.asAut_Kb`, which
needs `fAS 𝕜 ∉ ℘(K)`; in this directory `Submission/Work/MotV5/CensusAux/fAS_notMem_pe.lean`
proves it), and `σ₂` with `σ₂ (asRoot (2 • fAS 𝕜)) = asRoot (2 • fAS 𝕜) + 1` — the canonical choice
is `σ₂ = σ ^ 3`: writing `asRoot (2 • fAS 𝕜) = 2 * asRoot (fAS 𝕜) + i` for some `i ∈ 𝔽₅` (the two
roots of `X⁵ - X - 2 • fAS 𝕜` differ by an element of the prime field; see
`Submission/Work/MotV5/LinkCertASAux.lean`), one has
`σ ^ 3 (2W + i) = 2 (W + 3) + i = (2W + i) + 1` because `6 = 1` in characteristic `5`.  Then
`τ = coeffAction D.E σ` and `τ₂ = coeffAction D.E σ₂` (node `Work.MotC5N3.coeffAut`, supplying `hτ`
and `hτk` — the coefficient action of a `K`-automorphism fixes the geometric part `K(E)`, whose
Klein coordinates have coefficients in `𝕜`); `σS` is the automorphism from `hsh` (node
`Work.MotV5.exists_kleinData_shiftProj` proves `∃ D, ASGood D ∧ ShiftCompatProj D`).

The remaining fields: `hσS` is the shift property, from `hsh`; `h5L` — `(τ.trans (σS.restrictScalars
_)) ^ 5` fixes `asFieldL D g` pointwise — holds because `σS` permutes the Klein coordinates with a
scalar and hence `σS ^ 5` fixes `Work.MotC5N3.kleinField K D` pointwise (`KleinData.Generates`), while `τ` fixes
`Work.MotC5N3.kleinField K D` and `σ ^ 5 (asRoot g) = asRoot g + 5 = asRoot g` fixes `K(asRoot g)`; `hneL` and
`hpres` follow from `σ (asRoot g) = asRoot g + 1` and from `σS`, `τ` preserving the two summands of
`asFieldL D g`.  The two bundles share `σS`.

## Implemented route (this file)

`Work.MotV5.Nodes.asTwistData_of` proves `ASTwistData 𝕜 D g τ σS σ` from *general* hypotheses
(`hτ : τ` acts on the constants by `σ`; `hτκ : τ` fixes the Klein coordinates, hence `Work.MotC5N3.kleinField K D`
pointwise; `hσ : σ (asRoot g) = asRoot g + 1`; and `hσS : ShiftOf D σS`), and the node is the two
instances `g = fAS 𝕜` and `g = 2 • fAS 𝕜`.  For the two Artin–Schreier generators we use
`Work.MotV5.asAut_Kb` directly for both classes — the class `2 • fAS 𝕜` is not in `℘(K)`
because `℘(3u) = 3 * ℘(u)`, so `2 • fAS 𝕜 ∈ ℘` would give `fAS 𝕜 = 3 * (2 • fAS 𝕜) ∈ ℘`.  This
avoids the `asRoot (2 • fAS) = 2 * asRoot (fAS) + i` computation of `LinkCertASAux.lean` (whose
import is therefore not needed here).
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

The five non-immediate fields are proved as follows, writing `ψ = asTwistAction D τ σS` and
`r i = kleinCoord D (Work.MotC5N3.KbA K) i / kleinCoord D (Work.MotC5N3.KbA K) 0`:

* `h5L` follows from `asFieldL D g = adjoin (ratios ∪ {asRoot g})` (`hgen`) once one knows that
  `ψ ^ 5` fixes both kinds of generators.  For a ratio one computes `ψ κ_i = λ * κ_{i+1}`
  (`KleinData.ShiftOf` and `τ κ_i = κ_i`), hence `ψ ^ k κ_i = Λ k * κ_{i + k}` for the recursively
  defined scalar `Λ 0 = 1`, `Λ (k+1) = ψ (Λ k) * λ`; then `ψ ^ 5 κ_i = Λ 5 * κ_i` so
  `ψ ^ 5 (κ_i / κ_0) = κ_i / κ_0` (no `κ_i ≠ 0` for `i ≠ 0` is needed: the scalar cancels).  For
  `asRoot g` one has `ψ ^ n (algebraMap c) = algebraMap (σ ^ n c)` and `σ ^ n (asRoot g) =
  asRoot g + n`, so `σ ^ 5 (asRoot g) = asRoot g` because `5 = 0`.
* `hneL` witnesses `asRoot g`, which is moved by `ψ` to `asRoot g + 1`.
* `hpres` uses `map ψ.toAlgHom (asFieldL D g) ≤ asFieldL D g`, which reduces (via `hgen`,
  `IntermediateField.adjoin_map` and `IntermediateField.adjoin_le_iff`) to the two memberships
  `ψ (r i) = r (i+1) / r 1 ∈ Work.MotC5N3.kleinField K D` and `ψ (asRoot g) = asRoot g + 1`.

Note that the hypothesis `D.Good` is used only through `coord0_ne` (`kleinCoord D (Work.MotC5N3.KbA K) 0 ≠ 0`,
for the ratio computation); `hsh` supplies both `σS` and `hσS`.-/
theorem exists_ASData (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] {K : Type} [Field K] [Algebra 𝕜 K] [CharP K 5] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D) (hsh : Work.MotC5N3.KleinData.ShiftCompatProj K D) (g : K) (hg : ¬ ∃ u : K, u ^ 5 - u = g) :
    ∃ (τ τ₂ : Work.MotC5N3.OmA K D ≃ₐ[K] Work.MotC5N3.OmA K D)
      (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
      (σ σ₂ : Work.MotC5N3.KbA K ≃ₐ[K] Work.MotC5N3.KbA K),
      Work.MotC5N3.ASTwistData 𝕜 D (g) τ σS σ ∧
      Work.MotC5N3.ASTwistData 𝕜 D (2 • g) τ₂ σS σ₂ := by
  obtain ⟨σS, lam, hlam, hshift⟩ := hsh
  have hσS : Work.MotC5N3.KleinData.ShiftOf D σS := ⟨lam, hlam, hshift⟩
  obtain ⟨σ, hσ⟩ := Work.MotC5N3.asAut_Kb 𝕜 (g)
    (hg)
  have hg2 : ¬ ∃ u : K, u ^ 5 - u = 2 • g := by
    rintro ⟨u, hu⟩
    refine hg ⟨3 * u, ?_⟩
    have h3 : (3 : K) ^ 5 = 3 := by
      rw [show (3 : K) ^ 5 = ((243 : ℕ) : K) by norm_num,
        CharP.cast_eq_mod (K) 5 243]
      norm_num
    have h6 : (3 : K) * 2 = 1 := by
      rw [show (3 : K) * 2 = ((6 : ℕ) : K) by norm_num,
        CharP.cast_eq_mod (K) 5 6]
      norm_num
    have h2 : (2 : ℕ) • g = 2 * g := by
      rw [two_nsmul]; ring
    calc (3 * u) ^ 5 - 3 * u = 3 * (u ^ 5 - u) := by rw [mul_pow, h3]; ring
      _ = 3 * (2 • g) := by rw [hu]
      _ = 3 * (2 * g) := by rw [h2]
      _ = (3 * 2) * g := by ring
      _ = 1 * g := by rw [h6]
      _ = g := by ring
  obtain ⟨σ₂, hσ₂⟩ := Work.MotC5N3.asAut_Kb 𝕜 (2 • g) hg2
  obtain ⟨τ, hτ, hτκ⟩ := Work.MotC5N3.coeffAut 𝕜 D σ
  obtain ⟨τ₂, hτ₂, hτ₂κ⟩ := Work.MotC5N3.coeffAut 𝕜 D σ₂
  exact ⟨τ, τ₂, σS, σ, σ₂,
    asTwistData_of D hD.1 (g) τ σS σ hτ hτκ hσ hσS,
    asTwistData_of D hD.1 (2 • g) τ₂ σS σ₂ hτ₂ hτ₂κ hσ₂ hσS⟩

end Work.MotC5N3.Nodes