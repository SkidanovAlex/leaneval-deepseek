/-- Membership in the fixed field of the cyclic group generated by `ψ ^ n`. -/
theorem mem_fixedField_zpowers_pow {F E : Type*} [Field F] [Field E] [Algebra F E]
    (ψ : E ≃ₐ[F] E) (n : ℕ) (x : E) :
    x ∈ IntermediateField.fixedField (Subgroup.zpowers (ψ ^ n)) ↔ (ψ ^ n) x = x := by
  rw [IntermediateField.mem_fixedField_iff]
  constructor
  · intro h
    exact h _ (Subgroup.mem_zpowers _)
  · intro h f hf
    have hstab : Subgroup.zpowers (ψ ^ n) ≤ MulAction.stabilizer (E ≃ₐ[F] E) x :=
      Subgroup.zpowers_le.mpr (by
        rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
        exact h)
    have h' := hstab hf
    rwa [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def] at h'

