namespace Work.MotC5N3.Nodes
/-- **The projective shift has order dividing `5`.**

For AS-good Klein data `D` (`D.Good`, `Nonconstant`, `Generates`, `a² - ab - b² ≠ 0`) and a
projective fifth-torsion shift `σS` (`σS κ_i = λ κ_{i+1}` with `λ ≠ 0`,
`KleinData.ShiftOf D σS`), the fifth power of `σS` is the identity of `Work.MotC5N3.OmA K D`.

Proof route.  Write `κ i := kleinCoord D (Work.MotC5N3.KbA K) i` and let `σ := σS.restrictScalars (K)`,
which is the *same function* as `σS` (`AlgEquiv.restrictScalars_apply`); hence `σS^n = σ^n` as
functions, by induction (`hpow` below).

1. (`GenAux_sigmaS_pow_five_kleinField`, already proved) `σ^5` fixes `Work.MotC5N3.kleinField K D` pointwise.  Its
   proof is the heart of the matter: iterating the shift relation gives a scalar `μ` with
   `(σS^5) (κ i) = μ * κ i` for every `i` with `μ ≠ 0` (the `κ i` all transform with the *same*
   scalar because `cyc^5 = id`), so `σS^5` fixes the ratios `κ i / κ 0`.
2. By `KleinData.Generates D` at `L = Work.MotC5N3.KbA K` the ratios `κ i / κ 0` generate `Work.MotC5N3.OmA K D` as a
   `Work.MotC5N3.KbA K`-algebra.  Since `σS^5` is `Work.MotC5N3.KbA K`-linear and its fixed points form the intermediate field
   `IntermediateField.fixedField (Subgroup.zpowers (σS^5))`, the generating ratios being fixed
   forces everything to be fixed, i.e. `σS^5 = 1`.

The intermediate field `fixedField` is closed under *all* integer powers (`Subgroup.zpowers`), which
is why the helper `zpow_apply_eq_self_of_apply_eq_self` is used: it is enough to know
`(σS^5) z = z`, then `(σS^5)^n z = z` for every `n : ℤ`, so `z` lies in the fixed field of the
subgroup generated by `σS^5`. -/
theorem shiftOf_pow_five_eq_one (𝕜 : Type) [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D)
    (σS : Work.MotC5N3.OmA K D ≃ₐ[Work.MotC5N3.KbA K] Work.MotC5N3.OmA K D)
    (hσS : Work.MotC5N3.KleinData.ShiftOf D σS) : σS ^ 5 = 1 := by
  obtain ⟨hGood, -, hGen, -⟩ := hD
  -- `σ^5` fixes `K(E)`, where `σ` is the `K`-restriction of `σS`
  have hfix := Work.MotC5N3.GenAux_sigmaS_pow_five_kleinField 𝕜 D hGood σS hσS
  -- `restrictScalars` does not change the underlying function, so the two powers agree
  have hpow : ∀ n (x : Work.MotC5N3.OmA K D),
      ((σS.restrictScalars (K))^n) x = (σS^n) x := by
    intro n
    induction n with
    | zero => intro x; simp
    | succ n ih =>
      intro x
      rw [pow_succ', AlgEquiv.mul_apply, ih, pow_succ', AlgEquiv.mul_apply,
        AlgEquiv.restrictScalars_apply]
  -- the Klein ratios generate `Work.MotC5N3.OmA K D` over `Work.MotC5N3.KbA K`
  have hgen : IntermediateField.adjoin (Work.MotC5N3.KbA K)
      (Set.range (fun i : Fin 5 => Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i /
        Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0)) = ⊤ := hGen (Work.MotC5N3.KbA K)
  -- hence all of `Work.MotC5N3.OmA K D` is fixed by `σS^5`
  have htop : (⊤ : IntermediateField (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D)) ≤
      IntermediateField.fixedField (Subgroup.zpowers (σS ^ 5)) := by
    rw [← hgen, IntermediateField.adjoin_le_iff]
    rintro z ⟨i, rfl⟩
    show (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i /
        Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0) ∈
      IntermediateField.fixedField (Subgroup.zpowers (σS ^ 5))
    rw [IntermediateField.mem_fixedField_iff]
    intro f hf
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hf
    rw [← hn]
    refine Work.MotC5N3.zpow_apply_eq_self_of_apply_eq_self (σS^5)
      (Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i /
        Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0) ?_ n
    have hmem : Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i /
        Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 ∈ Work.MotC5N3.kleinField K D :=
      IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
    rw [← hpow 5]
    exact hfix _ hmem
  -- a `Work.MotC5N3.KbA K`-automorphism fixing everything is `1`
  ext z
  exact (IntermediateField.mem_fixedField_iff (Subgroup.zpowers (σS^5)) z).mp
    (htop trivial) (σS^5) (Subgroup.mem_zpowers _)

end Work.MotC5N3.Nodes