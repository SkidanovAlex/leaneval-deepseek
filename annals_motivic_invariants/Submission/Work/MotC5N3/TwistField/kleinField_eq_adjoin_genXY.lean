import Mathlib
import Submission.Work.MotC5N3.Defs
import Submission.Work.MotV5.Defs
import Submission.Work.MotV.Defs
import Submission.Work.MotK.KleinData

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# `K(E) = K(x, y)` for the Klein model: `Work.MotC5N3.kleinField K D = K̄⟮genX, genY⟯`

`Work.MotC5N3.kleinField K D` is the `K`-subfield of `Work.MotC5N3.OmA K D = K̄(E)` generated by the Klein
ratios `κ_i/κ_0`, while `IntermediateField.adjoin (K) {x, y}` is the function field of the
Weierstrass model `E` (its `K`-form).  Both are models of the function field of the Klein
curve, and this file identifies them.

* `Work.MotC5N3.kleinField K D ≤ K⟮x, y⟯` is formal: each `κ_i` is by definition a `𝕜`-linear combination of
  `1, x, y, x², x·y`, hence lies in `K⟮x, y⟯`, and `Good.coord0_ne` makes `κ_0` invertible there.
* `K⟮x, y⟯ ≤ Work.MotC5N3.kleinField K D`: `Good.spans` gives `1 = Σ_i e_{0i} κ_i`, `x = Σ_i e_{1i} κ_i` and
  `y = Σ_i e_{2i} κ_i`.  Factoring `κ_i = (κ_i/κ_0) · κ_0` out of these sums and writing
  `s m = Σ_i e_{mi} (κ_i/κ_0) ∈ Work.MotC5N3.kleinField K D` gives `1 = s 0 · κ_0`, hence `κ_0 = (s 0)⁻¹` lies
  in `Work.MotC5N3.kleinField K D`; then `x = s 1 · κ_0` and `y = s 2 · κ_0` do as well.

Only `Good.spans` and `Good.coord0_ne` are used; the statement holds in every characteristic.
-/

set_option autoImplicit false

namespace Work.MotC5N3
open Work.MotV5
open WeierstrassCurve WeierstrassCurve.Affine

/-- The scalar `algebraMap 𝕜 (Work.MotC5N3.OmA K D) c` agrees whether it is written through the intermediate
fields `K` or `Work.MotC5N3.KbA K = AlgebraicClosure (K)`. -/
private lemma algebraMap_scalar_eq {𝕜 : Type} [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (c : 𝕜) :
    algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) (algebraMap 𝕜 (Work.MotC5N3.KbA K) c) =
      algebraMap (K) (Work.MotC5N3.OmA K D) (algebraMap 𝕜 (K) c) := by
  rw [← IsScalarTower.algebraMap_apply 𝕜 (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D) c,
    ← IsScalarTower.algebraMap_apply 𝕜 (K) (Work.MotC5N3.OmA K D) c]

/-- Each element `1, x, y, x², x·y` of the Weierstrass basis `kleinBas` lies in any subfield of
`Work.MotC5N3.OmA K D` containing `x` and `y`. -/
private lemma kleinBas_mem {𝕜 : Type} [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜)
    (B : IntermediateField (K) (Work.MotC5N3.OmA K D))
    (hx : Work.MotV.genX (D.E.baseChange (Work.MotC5N3.KbA K)) ∈ B)
    (hy : Work.MotV.genY (D.E.baseChange (Work.MotC5N3.KbA K)) ∈ B) (m : Fin 5) :
    Work.MotV.kleinBas D (Work.MotC5N3.KbA K) m ∈ B := by
  fin_cases m
  · exact one_mem B
  · exact hx
  · exact hy
  · exact pow_mem hx 2
  · exact mul_mem hx hy

/-- Each Klein coordinate `κ_i` is a `𝕜`-linear combination of `1, x, y, x², x·y`, hence lies in
any subfield of `Work.MotC5N3.OmA K D` containing `x` and `y`. -/
private lemma kleinCoord_mem {𝕜 : Type} [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜)
    (B : IntermediateField (K) (Work.MotC5N3.OmA K D))
    (hx : Work.MotV.genX (D.E.baseChange (Work.MotC5N3.KbA K)) ∈ B)
    (hy : Work.MotV.genY (D.E.baseChange (Work.MotC5N3.KbA K)) ∈ B) (i : Fin 5) :
    Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i ∈ B := by
  rw [Work.MotV.kleinCoord_eq_sum]
  refine IntermediateField.sum_mem B (fun m _ => ?_)
  refine mul_mem ?_ ?_
  · rw [algebraMap_scalar_eq D]
    exact IntermediateField.algebraMap_mem B _
  · exact kleinBas_mem D B hx hy m

/-- The field generated over `K = K` by the Klein ratios `κ_i/κ_0` equals the function
field `K⟮x, y⟯` of the Weierstrass model in `Work.MotC5N3.OmA K D = K̄(E)`. -/
theorem kleinField_eq_adjoin_genXY (𝕜 : Type) [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (hD : D.Good) :
    Work.MotC5N3.kleinField K D
      = IntermediateField.adjoin (K)
          ({Work.MotV.genX (D.E.baseChange (Work.MotC5N3.KbA K)),
            Work.MotV.genY (D.E.baseChange (Work.MotC5N3.KbA K))} : Set (Work.MotC5N3.OmA K D)) := by
  classical
  obtain ⟨e, he⟩ := hD.spans
  let r : Fin 5 → Work.MotC5N3.OmA K D := fun i =>
    Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) i / Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0
  let s : Fin 5 → Work.MotC5N3.OmA K D := fun m =>
    ∑ i, algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D)
        (algebraMap 𝕜 (Work.MotC5N3.KbA K) (e m i)) * r i
  have h0 : Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 ≠ 0 := hD.coord0_ne (Work.MotC5N3.KbA K)
  have hr : ∀ i, r i ∈ Work.MotC5N3.kleinField K D := fun i =>
    IntermediateField.subset_adjoin (K)
      (Set.range (fun j : Fin 5 => Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) j /
        Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0)) (Set.mem_range_self i)
  have hc : ∀ m i, algebraMap (Work.MotC5N3.KbA K) (Work.MotC5N3.OmA K D)
      (algebraMap 𝕜 (Work.MotC5N3.KbA K) (e m i)) ∈ Work.MotC5N3.kleinField K D := by
    intro m i
    rw [algebraMap_scalar_eq D]
    exact IntermediateField.algebraMap_mem _ _
  have hs : ∀ m, s m ∈ Work.MotC5N3.kleinField K D := by
    intro m
    refine IntermediateField.sum_mem _ (fun i _ => ?_)
    exact mul_mem (hc m i) (hr i)
  -- `spans`, with the coordinates `κ_i = (κ_i/κ_0) · κ_0` factored out
  have hbase : ∀ m, Work.MotV.kleinBas D (Work.MotC5N3.KbA K) m =
      s m * Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 := by
    intro m
    rw [he (Work.MotC5N3.KbA K) m]
    simp only [s, r]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [mul_assoc, div_mul_cancel₀ _ h0]
  -- from `1 = kleinBas 0 = s 0 · κ_0` we get `κ_0 = (s 0)⁻¹`
  have hκ0 : Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 ∈ Work.MotC5N3.kleinField K D := by
    have h1 : s 0 * Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 = 1 := by
      rw [← hbase 0]
      rfl
    have h1' : Work.MotV.kleinCoord D (Work.MotC5N3.KbA K) 0 = (s 0)⁻¹ :=
      eq_inv_of_mul_eq_one_right h1
    rw [h1']
    exact inv_mem (hs 0)
  have hx : Work.MotV.genX (D.E.baseChange (Work.MotC5N3.KbA K)) ∈ Work.MotC5N3.kleinField K D := by
    rw [show Work.MotV.genX (D.E.baseChange (Work.MotC5N3.KbA K)) =
        Work.MotV.kleinBas D (Work.MotC5N3.KbA K) 1 from rfl, hbase 1]
    exact mul_mem (hs 1) hκ0
  have hy : Work.MotV.genY (D.E.baseChange (Work.MotC5N3.KbA K)) ∈ Work.MotC5N3.kleinField K D := by
    rw [show Work.MotV.genY (D.E.baseChange (Work.MotC5N3.KbA K)) =
        Work.MotV.kleinBas D (Work.MotC5N3.KbA K) 2 from rfl, hbase 2]
    exact mul_mem (hs 2) hκ0
  refine le_antisymm ?_ ?_
  · -- `Work.MotC5N3.kleinField K D ≤ K⟮x, y⟯`
    rw [Work.MotC5N3.kleinField, IntermediateField.adjoin_le_iff]
    rintro z ⟨i, rfl⟩
    exact div_mem
      (kleinCoord_mem D _ (IntermediateField.subset_adjoin _ _ (by simp))
        (IntermediateField.subset_adjoin _ _ (by simp)) i)
      (kleinCoord_mem D _ (IntermediateField.subset_adjoin _ _ (by simp))
        (IntermediateField.subset_adjoin _ _ (by simp)) 0)
  · -- `K⟮x, y⟯ ≤ Work.MotC5N3.kleinField K D`
    rw [IntermediateField.adjoin_le_iff]
    rintro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact hx
    · exact hy

end Work.MotC5N3