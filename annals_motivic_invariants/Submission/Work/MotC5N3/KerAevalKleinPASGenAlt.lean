/-!
# `Work.MotC5N3.kerAevalKleinPASGenAlt` — the transported Klein kernel statement over a general `K`

The `RatFunc 𝕜 ↦ K` fork of `Work.MotAS.kerAevalKleinPAS_gen`
(`Submission/Work/MotAS/kerAevalKleinPAS_gen.lean`), transcribed with
`Kb 𝕜 ↦ KbA K = AlgebraicClosure K`, `Om D ↦ OmA K D`, `MotV5.asRoot g ↦ MotC5N3.asRoot g`.
The three generic local bricks (`asTransportP_mv_A`, `aevalAsMAevalAsMinv_A`,
`aeval_asM_twIdeal_subset_A`) live in `Submission/Work/MotC5N3/ASLocalGen.lean`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 4000000

namespace Work.MotC5N3

open MvPolynomial

/-- **The transported ("AS", characteristic `5`) Klein kernel statement, in every degree over an
arbitrary `𝕜`-algebra field `K`.**  Let `D` be Klein data over `𝕜` with
`Work.MotV5.KleinData.ASGood D`, `g : K`, and let `F : MvPolynomial (Fin 5) K` be homogeneous of
degree `n` and vanish after the substitution `X i ↦ asTwY D g i`.  Then `F` lies in the ideal
generated by the five transported Pfaffians `Work.MotAS.kleinPASm (aK K D) (bK K D) g`. -/
theorem kerAevalKleinPASGenAlt (K : Type) [Field K] [CharP K 5] {𝕜 : Type} [Field 𝕜] [CharP 𝕜 5]
    [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (hD : Work.MotV5.KleinData.ASGood D) (g : K)
    (n : ℕ) (F : MvPolynomial (Fin 5) K)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin 5) K n)
    (hF0 : MvPolynomial.aeval (asTwY D g) F = 0) :
    F ∈ Ideal.span (Set.range (Work.MotAS.kleinPASm (aK K D) (bK K D) g)) := by
  classical
  have hFhom : F.IsHomogeneous n := (MvPolynomial.mem_homogeneousSubmodule n F).mp hF
  -- ### Step 1: base change and substitutions
  set a₀ : KbA K := algebraMap 𝕜 (KbA K) D.a with ha₀
  set b₀ : KbA K := algebraMap 𝕜 (KbA K) D.b with hb₀
  let ψ : Fin 5 → MvPolynomial (Fin 5) (KbA K) := fun j =>
    ∑ i, MvPolynomial.C (Work.MotAS.asMinv (asRoot g) j i) * MvPolynomial.X i
  let G : MvPolynomial (Fin 5) (KbA K) :=
    MvPolynomial.map (algebraMap K (KbA K)) F
  let F' : MvPolynomial (Fin 5) (KbA K) := MvPolynomial.aeval ψ G
  -- ### Step 2: `aeval asKap F' = 0`
  have hasKap : MvPolynomial.aeval (asKap D g) F' = 0 := by
    have hψi : ∀ i, MvPolynomial.aeval (asKap D g) (ψ i) = asTwY D g i := by
      intro i
      have h1 : MvPolynomial.aeval (asKap D g) (ψ i)
          = ∑ j : Fin 5, algebraMap (KbA K) (OmA K D)
              (Work.MotAS.asMinv (asRoot g) i j) * asKap D g j := by
        simp only [ψ, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
      have h2 : (∑ j : Fin 5, algebraMap (KbA K) (OmA K D)
              (Work.MotAS.asMinv (asRoot g) i j) * asKap D g j)
          = ((asNO D g).mulVec (asKap D g)) i := by
        simp only [asNO, Matrix.mulVec, dotProduct, Matrix.map_apply]
      rw [h1, h2, ← asTwY_eq_mulVec]
    have hcomb : MvPolynomial.aeval (asKap D g) F'
        = MvPolynomial.aeval (asTwY D g) G := by
      show MvPolynomial.aeval (asKap D g) (MvPolynomial.aeval ψ G)
        = MvPolynomial.aeval (asTwY D g) G
      rw [MvPolynomial.comp_aeval_apply]
      rw [show (fun i => MvPolynomial.aeval (asKap D g) (ψ i))
        = asTwY D g from funext hψi]
    rw [hcomb]
    show MvPolynomial.aeval (asTwY D g) G = 0
    rw [show G = MvPolynomial.map (algebraMap K (KbA K)) F from rfl,
      MvPolynomial.aeval_map_algebraMap (KbA K) (asTwY D g) F, hF0]
  -- ### Step 3: homogeneity of `F'`
  have hGhom : G.IsHomogeneous n := by
    show (MvPolynomial.map (algebraMap K (KbA K)) F).IsHomogeneous n
    exact hFhom.map _
  have hψhom : ∀ i, (ψ i).IsHomogeneous 1 := by
    intro i
    exact MvPolynomial.IsHomogeneous.sum Finset.univ (fun j =>
      MvPolynomial.C (Work.MotAS.asMinv (asRoot g) i j) * MvPolynomial.X j) 1
      (fun j _ => (MvPolynomial.isHomogeneous_X (R := KbA K) j).C_mul _)
  have hF'hom : F'.IsHomogeneous n := by
    show (MvPolynomial.aeval ψ G).IsHomogeneous n
    exact Work.MotV5.ASLocal.isHomogeneous_aeval_linear G n hGhom ψ hψhom
  have hF'homem : F' ∈ MvPolynomial.homogeneousSubmodule (Fin 5) (KbA K) n :=
    (MvPolynomial.mem_homogeneousSubmodule (R := KbA K) n F').mpr hF'hom
  -- ### Step 4: the split Klein kernel statement over the algebraic closure
  have hF'ideal : F' ∈ Work.MotK.TwRuling.kleinKerIdeal (KbA K) a₀ b₀ := by
    have h := Work.MotAS.kleinKer_mem_v2 𝕜 D hD.1 (KbA K) n F' hF'homem hasKap
    rw [← ha₀, ← hb₀] at h
    exact h
  -- ### Step 5: the degree-`n` part of the ideal
  have hF'tw : F' ∈ Submodule.span (KbA K)
      (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2} =>
        Work.MotK.kleinP (MvPolynomial.C a₀) (MvPolynomial.C b₀)
          (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1)) :=
    Work.MotAS.mem_span_mul_monomial_of_mem_ideal_span
      (fun k => Work.MotK.kleinP (MvPolynomial.C a₀) (MvPolynomial.C b₀)
        (fun i => MvPolynomial.X i) k)
      (fun k => Work.MotAS.isHomogeneous_kleinP_X a₀ b₀ k) hF'hom hF'ideal
  -- ### Step 6: transport back with `χ`
  have hG : G ∈ Submodule.span (KbA K)
      (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2} =>
        Work.MotAS.kleinPASm (algebraMap 𝕜 (KbA K) D.a)
          (algebraMap 𝕜 (KbA K) D.b)
          (algebraMap K (KbA K) g) q.1 * MvPolynomial.monomial q.2.1 1)) := by
    have hχ : MvPolynomial.aeval (fun i : Fin 5 => ∑ l : Fin 5,
        MvPolynomial.C (Work.MotAS.asM (asRoot g) i l) * MvPolynomial.X l) F' = G :=
      aevalAsMAevalAsMinv_A (asRoot g) G
    rw [← hχ]
    exact aeval_asM_twIdeal_subset_A D g n (by simpa only [aK, bK, ha₀, hb₀] using hF'tw)
  -- ### Step 7: descend along `K → KbA K`
  set S : Set (MvPolynomial (Fin 5) K) :=
    Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2} =>
      Work.MotAS.kleinPASm (aK K D) (bK K D) g q.1 *
        MvPolynomial.monomial q.2.1 1) with hS
  have hset_pt : ∀ q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2},
      MvPolynomial.map (algebraMap K (KbA K))
        (Work.MotAS.kleinPASm (aK K D) (bK K D) g q.1 *
          MvPolynomial.monomial q.2.1 1)
      = Work.MotAS.kleinPASm (algebraMap 𝕜 (KbA K) D.a)
          (algebraMap 𝕜 (KbA K) D.b)
          (algebraMap K (KbA K) g) q.1 *
        MvPolynomial.monomial q.2.1 1 := by
    intro q
    have hpf : MvPolynomial.map (algebraMap K (KbA K))
        (Work.MotAS.kleinPASm (aK K D) (bK K D) g q.1)
        = Work.MotAS.kleinPASm (algebraMap 𝕜 (KbA K) D.a)
            (algebraMap 𝕜 (KbA K) D.b)
            (algebraMap K (KbA K) g) q.1 := by
      simp only [Work.MotAS.kleinPASm]
      rw [Work.MotV5.ASLocal.map_kleinPAS_poly]
      simp only [aK, bK,
        IsScalarTower.algebraMap_apply 𝕜 K (KbA K) D.a,
        IsScalarTower.algebraMap_apply 𝕜 K (KbA K) D.b]
    rw [map_mul, hpf, MvPolynomial.map_monomial, map_one]
  have hset : MvPolynomial.map (algebraMap K (KbA K)) '' S
      = Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2} =>
        Work.MotAS.kleinPASm (algebraMap 𝕜 (KbA K) D.a)
          (algebraMap 𝕜 (KbA K) D.b)
          (algebraMap K (KbA K) g) q.1 * MvPolynomial.monomial q.2.1 1) := by
    rw [hS, ← Set.range_comp]
    congr 1
    funext q
    exact hset_pt q
  have hG_map : G ∈ Submodule.span (KbA K)
      (MvPolynomial.map (algebraMap K (KbA K)) '' S) := by
    rw [hset]
    exact hG
  have hFspan : F ∈ Submodule.span K S :=
    Work.MotV5.ASLocal.mem_span_of_map_mem_span (S := S) (x := F) hG_map
  -- ### Step 8: conclude membership in the ideal
  have hmem : ∀ x ∈ Submodule.span K S,
      x ∈ (Ideal.span (Set.range (Work.MotAS.kleinPASm (aK K D) (bK K D) g)) :
        Set (MvPolynomial (Fin 5) K)) := by
    intro x hx
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
    · rintro y ⟨q, rfl⟩
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨q.1, rfl⟩)
    · exact Ideal.zero_mem _
    · intro a b _ _ ha hb
      exact Ideal.add_mem _ ha hb
    · intro c a _ ha
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ ha
  exact hmem F hFspan

end Work.MotC5N3
