/-!
# `Work.MotC5N3.ASZPrimeness.syz_cert` — the certificate `P ∈ (D0, R0²)`

For `K` a field of characteristic `5` and `a b g : K` with `a² - ab - b² ≠ 0`, the eliminant
`P = ASZElim.P a b g` of the AS residual plane model lies in the ideal generated by the graph
coefficient `D0 = ASZGC.D0 a b g` and the square of the second graph coefficient
`R0 = ASZGC.R0 a b g`:

  `P = e·D0 + f·R0²`  for explicit `e, f`.

## Proof

Three inputs, all already in the workspace:

* **(det)** `ASZQuadDet_ident` (`Work.MotAS.ASRulV2M`): in the `ziasGraph` normalisation,
  `β²·Rg² - Lt·Rg·Dg + At·Dg² = P·(C cq · X 0)` with `cq = -a¹⁵ - a¹⁰b⁵ - 2a⁵b¹⁰ + 2b¹⁵`,
  which transports along `ziasGraphD0_eq`/`ziasGraphR_eq` (`Work.MotC5N3.ASZRadicalIsPrime`) to
  the `ASZGC` normalisation.  Dividing by the (non-zero) scalar `cq` gives
  `P·X₀ = C cq⁻¹·(C β²·R0² - Lt·R0·D0 + At·D0²)`.
* **(h1)** `D0_decomp` (`Work.MotC5N3.ASZPrimeness.ann_eq_aux`): `D0 = C d0 + X₀·M0` with
  `d0 = -(2(a+2b)⁶) ≠ 0` (from `a² - ab - b² = (a+2b)(a-3b) + 5b²`), so
  `C d0⁻¹·D0 + (-C d0⁻¹·M0)·X₀ = 1`.
* **(cq)** `cq = -(a + 2b)¹⁵`, hence `cq ≠ 0`.

Then `P = P·1 = P·(A'D0 + B'X₀) = P·A'·D0 + B'·(P·X₀)`, and substituting `P·X₀` from (det)
exhibits `P` as a combination of `D0` and `R0²`.
-/

set_option maxHeartbeats 4000000

namespace Work.MotC5N3.ASZPrimeness

theorem syz_cert (K : Type) [Field K] [CharP K 5] (a b g : K)
    (ha : a ^ 2 - a * b - b ^ 2 ≠ 0) (hg : ¬ ∃ c : K, c ^ 5 - c = g) :
    ∃ e f : MvPolynomial (Fin 2) K,
      Work.MotAS.ASZElim.P a b g
        = e * Work.MotAS.ASZGC.D0 a b g + f * (Work.MotAS.ASZGC.R0 a b g) ^ 2 := by
  have h5 : (5 : K) = 0 := CharP.cast_eq_zero K 5
  have h2b : a + 2 * b ≠ 0 := by
    intro h
    apply ha
    have hfac : a ^ 2 - a * b - b ^ 2 = (a + 2 * b) * (a - 3 * b) + 5 * b ^ 2 := by ring
    rw [h, zero_mul, zero_add] at hfac
    rw [hfac, h5, zero_mul]
  have h2ne : (2 : K) ≠ 0 := by
    intro h2
    have h52 : (5 : K) = (2 : K) * 2 + 1 := by ring
    rw [h52] at h5
    rw [h2, zero_mul, zero_add] at h5
    exact one_ne_zero h5
  obtain ⟨P, hP⟩ : ∃ P : MvPolynomial (Fin 2) K, P = Work.MotAS.ASZElim.P a b g := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D : MvPolynomial (Fin 2) K, D = Work.MotAS.ASZGC.D0 a b g := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : MvPolynomial (Fin 2) K, R = Work.MotAS.ASZGC.R0 a b g := ⟨_, rfl⟩
  obtain ⟨β2, hβ2⟩ : ∃ β2 : K, β2 = Work.MotAS.aszQuBeta a b ^ 2 := ⟨_, rfl⟩
  obtain ⟨Lt, hLt⟩ : ∃ Lt : MvPolynomial (Fin 2) K, Lt = Work.MotAS.aszQuLt a b g := ⟨_, rfl⟩
  obtain ⟨At, hAt⟩ : ∃ At : MvPolynomial (Fin 2) K, At = Work.MotAS.aszQuAt a b g := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : MvPolynomial (Fin 2) K,
      M = Work.MotC5N3.ASZPrimeness.M0 K a b g := ⟨_, rfl⟩
  obtain ⟨cq, hcq'⟩ : ∃ cq : K,
      cq = -a ^ 15 - a ^ 10 * b ^ 5 - 2 * a ^ 5 * b ^ 10 + 2 * b ^ 15 := ⟨_, rfl⟩
  obtain ⟨d0, hd0'⟩ : ∃ d0 : K, d0 = -(2 * (a + 2 * b) ^ 6) := ⟨_, rfl⟩
  have hd0 : d0 ≠ 0 := by
    rw [hd0']
    exact neg_ne_zero.mpr (mul_ne_zero h2ne (pow_ne_zero 6 h2b))
  have hcq0 : (-a ^ 15 - a ^ 10 * b ^ 5 - 2 * a ^ 5 * b ^ 10 + 2 * b ^ 15 : K) ≠ 0 := by
    have heq : (-a ^ 15 - a ^ 10 * b ^ 5 - 2 * a ^ 5 * b ^ 10 + 2 * b ^ 15 : K)
        = -((a + 2 * b) ^ 15) := by
      have hkey : (-a ^ 15 - a ^ 10 * b ^ 5 - 2 * a ^ 5 * b ^ 10 + 2 * b ^ 15 : K)
          + (a + 2 * b) ^ 15 = 0 := by
        have h : (-a ^ 15 - a ^ 10 * b ^ 5 - 2 * a ^ 5 * b ^ 10 + 2 * b ^ 15 : K)
            + (a + 2 * b) ^ 15
            = 5 * (6 * a ^ 14 * b + 84 * a ^ 13 * b ^ 2 + 728 * a ^ 12 * b ^ 3
                + 4368 * a ^ 11 * b ^ 4 + 19219 * a ^ 10 * b ^ 5 + 64064 * a ^ 9 * b ^ 6
                + 164736 * a ^ 8 * b ^ 7 + 329472 * a ^ 7 * b ^ 8 + 512512 * a ^ 6 * b ^ 9
                + 615014 * a ^ 5 * b ^ 10 + 559104 * a ^ 4 * b ^ 11 + 372736 * a ^ 3 * b ^ 12
                + 172032 * a ^ 2 * b ^ 13 + 49152 * a * b ^ 14 + 6554 * b ^ 15) := by ring
        rw [h5, zero_mul] at h
        exact h
      exact eq_neg_of_add_eq_zero_left hkey
    rw [heq]
    exact neg_ne_zero.mpr (pow_ne_zero 15 h2b)
  have hcq : cq ≠ 0 := by
    rw [← hcq'] at hcq0
    exact hcq0
  -- the `X 0`-decomposition of `D`
  have hdec : D = MvPolynomial.C d0 + MvPolynomial.X 0 * M := by
    rw [hD, Work.MotC5N3.ASZPrimeness.D0_decomp K a b g, ← hd0', ← hM]
  have hCd : MvPolynomial.C (d0⁻¹) * MvPolynomial.C d0 = (1 : MvPolynomial (Fin 2) K) := by
    rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hd0, MvPolynomial.C_1]
  -- (h1) : `1` is an explicit combination of `D` and `X 0`
  have h1 : MvPolynomial.C (d0⁻¹) * D + (-(MvPolynomial.C (d0⁻¹)) * M)
      * MvPolynomial.X 0 = 1 := by
    rw [hdec, mul_add, hCd]
    first | refl_ring1 | ring
  -- the determinant identity, transported to the `ASZGC` normalisation
  have hdet : MvPolynomial.C β2 * R ^ 2 - Lt * R * D + At * D ^ 2
      = P * (MvPolynomial.C cq * MvPolynomial.X 0) := by
    have h := Work.MotAS.ASRulV2M.aszQuadDet_ident K a b g
    rw [Work.MotC5N3.ziasGraphD0_eq K a b g, Work.MotC5N3.ziasGraphR_eq K a b g] at h
    rw [← hP, ← hD, ← hR, ← hβ2, ← hLt, ← hAt, ← hcq'] at h
    exact h
  have hCc : MvPolynomial.C (cq⁻¹) * MvPolynomial.C cq = (1 : MvPolynomial (Fin 2) K) := by
    rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hcq, MvPolynomial.C_1]
  have hX0 : P * MvPolynomial.X 0
      = MvPolynomial.C (cq⁻¹) * (MvPolynomial.C β2 * R ^ 2 - Lt * R * D + At * D ^ 2) := by
    have hh := congrArg (fun z : MvPolynomial (Fin 2) K => MvPolynomial.C (cq⁻¹) * z) hdet
    rw [hh]
    rw [show MvPolynomial.C (cq⁻¹) * (P * (MvPolynomial.C cq * MvPolynomial.X 0))
          = (MvPolynomial.C (cq⁻¹) * MvPolynomial.C cq) * (P * MvPolynomial.X 0) from by ring,
      hCc, one_mul]
  refine ⟨P * MvPolynomial.C (d0⁻¹)
        - (-(MvPolynomial.C (d0⁻¹)) * M) * MvPolynomial.C (cq⁻¹) * Lt * R
        + (-(MvPolynomial.C (d0⁻¹)) * M) * MvPolynomial.C (cq⁻¹) * At * D,
      (-(MvPolynomial.C (d0⁻¹)) * M) * MvPolynomial.C (cq⁻¹) * MvPolynomial.C β2, ?_⟩
  rw [← hP, ← hD, ← hR]
  have hBX : P * ((-(MvPolynomial.C (d0⁻¹)) * M) * MvPolynomial.X 0)
      = (-(MvPolynomial.C (d0⁻¹)) * M)
          * (MvPolynomial.C (cq⁻¹)
              * (MvPolynomial.C β2 * R ^ 2 - Lt * R * D + At * D ^ 2)) := by
    rw [← mul_assoc, mul_comm P (-(MvPolynomial.C (d0⁻¹)) * M), mul_assoc, hX0]
  have hmain : P = P * (MvPolynomial.C (d0⁻¹) * D
      + (-(MvPolynomial.C (d0⁻¹)) * M) * MvPolynomial.X 0) := by
    rw [h1, mul_one]
  conv_lhs => rw [hmain, mul_add]
  rw [hBX]
  first | refl_ring1 | ring

end Work.MotC5N3.ASZPrimeness
