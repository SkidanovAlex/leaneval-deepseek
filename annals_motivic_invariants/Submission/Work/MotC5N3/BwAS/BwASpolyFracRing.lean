namespace Work.MotC5N3.BwAS

open Work.MotAS

open MvPolynomial

variable {K : Type} [Field K] [CharP K 5]

/-! ## §0. The dehomogenised parts and the parametrisation -/

/-- Dehomogenisation of `bwASQ a b g` at `X 2 = 1`: `γ·V² − d²·U − 2ed` (with `U = X 0`,
`V = X 1`). -/
noncomputable def bwASQ2 (a b : K) : MvPolynomial (Fin 2) K :=
  C (asGam a b) * (X 1) ^ 2 - C ((asDel a b) ^ 2) * X 0 - C (2 * asEps a b * asDel a b)

/-- Dehomogenisation of `bwASR a b g` at `X 2 = 1`. -/
noncomputable def bwASR2 (a b g : K) : MvPolynomial (Fin 2) K :=
  C (asGam a b) * (X 0) ^ 2 * X 1 - C (asEps a b * asDel a b) * X 0 * X 1
    - C (2 * asEps a b * asDel a b) * (X 1) ^ 3 + C (asGam a b) * X 1
    - C (g * (asDel a b) ^ 2)

/-- The coordinate `U` of the parametrising plane, inside `Frac K[U,V]`. -/
noncomputable def asU : FractionRing (MvPolynomial (Fin 2) K) :=
  algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (X 0)

/-- The coordinate `V` of the parametrising plane, inside `Frac K[U,V]`. -/
noncomputable def bwASV : FractionRing (MvPolynomial (Fin 2) K) :=
  algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (X 1)

/-- `Q̃`, the image of the dehomogenised `bwASQ` in `Frac K[U,V]`. -/
noncomputable def asQtilde (a b : K) : FractionRing (MvPolynomial (Fin 2) K) :=
  algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (bwASQ2 a b)

/-- `R̃`, the image of the dehomogenised `bwASR` in `Frac K[U,V]`. -/
noncomputable def asRtilde (a b g : K) : FractionRing (MvPolynomial (Fin 2) K) :=
  algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (bwASR2 a b g)

/-- **The graph parametrisation** `θ = thetaAS a b g : K[X₀,X₁,X₂] →ₐ[K] Frac K[U,V]` with
`X₀ ↦ −U·Q̃/R̃`, `X₁ ↦ −V·Q̃/R̃`, `X₂ ↦ −Q̃/R̃`. -/
noncomputable def thetaAS (a b g : K) : MvPolynomial (Fin 3) K →ₐ[K]
    FractionRing (MvPolynomial (Fin 2) K) :=
  MvPolynomial.aeval (fun i : Fin 3 =>
    ![-(asU * asQtilde a b / asRtilde a b g),
      -(bwASV * asQtilde a b / asRtilde a b g),
      -(asQtilde a b / asRtilde a b g)] i)

/-! ## §1. Non-vanishing of the dehomogenised parts -/

/-- `bwASQ2` at `(U,V) = (0,0)`. -/
theorem aeval_zero_asQ2 (a b : K) :
    MvPolynomial.aeval (fun _ : Fin 2 => (0 : K)) (bwASQ2 a b) = -(2 * asEps a b * asDel a b) := by
  simp only [bwASQ2, asGam, asDel, asEps]
  simp only [map_sub, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
    Algebra.algebraMap_self_apply]
  ring_nf

/-- `bwASQ2` at `(U,V) = (1,0)`. -/
theorem aeval_one_zero_asQ2 (a b : K) :
    MvPolynomial.aeval (fun i : Fin 2 => (![(1 : K), 0] : Fin 2 → K) i) (bwASQ2 a b)
      = -(asDel a b) ^ 2 - 2 * asEps a b * asDel a b := by
  simp only [bwASQ2, asGam, asDel, asEps]
  simp only [map_sub, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
    Algebra.algebraMap_self_apply]
  norm_num

/-- `bwASR2` at `(U,V) = (0,0)`. -/
theorem aeval_zero_bwASR2 (a b g : K) :
    MvPolynomial.aeval (fun _ : Fin 2 => (0 : K)) (bwASR2 a b g) = -(g * (asDel a b) ^ 2) := by
  simp only [bwASR2, asGam, asDel, asEps]
  simp only [map_sub, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
    Algebra.algebraMap_self_apply]
  ring_nf

/-- `bwASQ2 ≠ 0`: the two evaluations at `(0,0)` and `(1,0)` are `−2ed` and `−d² − 2ed`; if both
vanished then `d = 0`. -/
theorem asQ2_ne_zero (a b : K) (hd : asDel a b ≠ 0) : bwASQ2 a b ≠ 0 := by
  intro h
  have h0 : MvPolynomial.aeval (fun _ : Fin 2 => (0 : K)) (bwASQ2 a b) = 0 := by rw [h, map_zero]
  have h1 : MvPolynomial.aeval (fun i : Fin 2 => (![(1 : K), 0] : Fin 2 → K) i) (bwASQ2 a b)
      = 0 := by rw [h, map_zero]
  rw [aeval_zero_asQ2] at h0
  rw [aeval_one_zero_asQ2] at h1
  simp only [asDel, asEps] at h0 h1
  ring_nf at h0 h1
  have h2 : -(a ^ 2 - a * b - b ^ 2) ^ 2 = 0 := by linear_combination h1 - h0
  exact asDel_sq_ne_zero a b hd (neg_eq_zero.mp h2)

/-- `bwASR2 ≠ 0`: its value at `(0,0)` is `−g·d² ≠ 0`. -/
theorem bwASR2_ne_zero (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) : bwASR2 a b g ≠ 0 := by
  intro h
  have h0 : MvPolynomial.aeval (fun _ : Fin 2 => (0 : K)) (bwASR2 a b g) = 0 := by rw [h, map_zero]
  rw [aeval_zero_bwASR2] at h0
  simp only [asDel] at h0
  ring_nf at h0
  have h2 : -(g * (a ^ 2 - a * b - b ^ 2) ^ 2) = 0 := by linear_combination h0
  exact (mul_ne_zero hg (pow_ne_zero 2 hd)) (neg_eq_zero.mp h2)

theorem asQtilde_ne_zero (a b : K) (hd : asDel a b ≠ 0) : asQtilde a b ≠ 0 := fun h =>
  asQ2_ne_zero a b hd (IsFractionRing.injective (MvPolynomial (Fin 2) K)
    (FractionRing (MvPolynomial (Fin 2) K)) (by rw [← asQtilde, h, map_zero]))

theorem asRtilde_ne_zero (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) : asRtilde a b g ≠ 0 :=
  fun h => bwASR2_ne_zero a b g hd hg (IsFractionRing.injective (MvPolynomial (Fin 2) K)
    (FractionRing (MvPolynomial (Fin 2) K)) (by rw [← asRtilde, h, map_zero]))

/-! ## §1'. Dehomogenisation identities -/

section Dehomog

/-- **Dehomogenisation of `bwASQ`**: at `(x₀,x₁,x₂)` with `x₂ ≠ 0` its value is `x₂²` times the
value of `bwASQ2` at `(x₀/x₂, x₁/x₂)`. -/
theorem aeval_bwASQ_dehomog {L : Type*} [Field L] [Algebra K L] (a b g : K) (x0 x1 x2 : L)
    (hx2 : x2 ≠ 0) :
    MvPolynomial.aeval (fun i : Fin 3 => ![x0, x1, x2] i) (bwASQ a b g)
      = x2 ^ 2 * MvPolynomial.aeval (fun i : Fin 2 => ![x0 / x2, x1 / x2] i) (bwASQ2 a b) := by
  simp only [bwASQ, bwASQ2, asGam, asDel, asEps]
  simp only [map_sub, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons]
  field_simp

/-- **Dehomogenisation of `bwASR`**: at `(x₀,x₁,x₂)` with `x₂ ≠ 0` its value is `x₂³` times the
value of `bwASR2` at `(x₀/x₂, x₁/x₂)`. -/
theorem aeval_bwASR_dehomog {L : Type*} [Field L] [Algebra K L] (a b g : K) (x0 x1 x2 : L)
    (hx2 : x2 ≠ 0) :
    MvPolynomial.aeval (fun i : Fin 3 => ![x0, x1, x2] i) (bwASR a b g)
      = x2 ^ 3 * MvPolynomial.aeval (fun i : Fin 2 => ![x0 / x2, x1 / x2] i) (bwASR2 a b g) := by
  simp only [bwASR, bwASR2, asGam, asDel, asEps]
  simp only [map_sub, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons]
  field_simp

end Dehomog

/-! ## §2. The value of `θ` on the generators, and `θ(p) = 0` -/

theorem thetaAS_X0 (a b g : K) :
    thetaAS a b g (X 0) = -(asU * asQtilde a b / asRtilde a b g) := by
  rw [thetaAS, MvPolynomial.aeval_X]
  simp [Matrix.cons_val_zero]

theorem thetaAS_X1 (a b g : K) :
    thetaAS a b g (X 1) = -(bwASV * asQtilde a b / asRtilde a b g) := by
  rw [thetaAS, MvPolynomial.aeval_X]
  simp [Matrix.cons_val_one]

theorem thetaAS_X2 (a b g : K) : thetaAS a b g (X 2) = -(asQtilde a b / asRtilde a b g) := by
  rw [thetaAS, MvPolynomial.aeval_X]
  simp [Matrix.cons_val_two]

theorem thetaAS_X2_ne_zero (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    thetaAS a b g (X 2) ≠ 0 := by
  rw [thetaAS_X2]
  exact neg_ne_zero.mpr (div_ne_zero (asQtilde_ne_zero a b hd) (asRtilde_ne_zero a b g hd hg))

theorem thetaAS_X0_eq (a b g : K) :
    thetaAS a b g (X 0) = asU * thetaAS a b g (X 2) := by
  rw [thetaAS_X0, thetaAS_X2, mul_div_assoc]
  first | refl_ring1 | ring

theorem thetaAS_X1_eq (a b g : K) :
    thetaAS a b g (X 1) = bwASV * thetaAS a b g (X 2) := by
  rw [thetaAS_X1, thetaAS_X2, mul_div_assoc]
  first | refl_ring1 | ring

/-- The evaluation of the constant-coefficient map: `aeval (algebraMap ∘ X) F = algebraMap F`. -/
theorem aeval_algebraMap_bwASV (F : MvPolynomial (Fin 2) K) :
    MvPolynomial.aeval (fun i : Fin 2 =>
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (X i)) F
      = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) F := by
  have h : MvPolynomial.aeval (fun i : Fin 2 =>
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (X i))
      = IsScalarTower.toAlgHom K (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X, IsScalarTower.toAlgHom_apply]
  rw [h]
  rfl

/-- `θ` is the evaluation at `(θ X₀, θ X₁, θ X₂)`. -/
theorem thetaAS_eq_aeval (a b g : K) :
    thetaAS a b g = MvPolynomial.aeval (fun i : Fin 3 =>
      ![thetaAS a b g (X 0), thetaAS a b g (X 1), thetaAS a b g (X 2)] i) := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [MvPolynomial.aeval_X]
  fin_cases i <;> simp [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two]

/-- The dehomogenisation in the form needed below. -/
theorem aeval_div_eq (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    MvPolynomial.aeval (fun i : Fin 2 =>
      ![thetaAS a b g (X 0) / thetaAS a b g (X 2),
        thetaAS a b g (X 1) / thetaAS a b g (X 2)] i) (bwASQ2 a b) = asQtilde a b := by
  have h2 := thetaAS_X2_ne_zero a b g hd hg
  have h0 : thetaAS a b g (X 0) / thetaAS a b g (X 2) = asU := by
    rw [thetaAS_X0_eq, mul_div_cancel_right₀ _ h2]
  have h1 : thetaAS a b g (X 1) / thetaAS a b g (X 2) = bwASV := by
    rw [thetaAS_X1_eq, mul_div_cancel_right₀ _ h2]
  rw [h0, h1]
  rw [show (fun i : Fin 2 => ![asU, bwASV] i) = (fun i : Fin 2 =>
    algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (X i)) from by
      funext i; fin_cases i <;> rfl]
  exact aeval_algebraMap_bwASV (bwASQ2 a b)

theorem aeval_div_eq_R (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    MvPolynomial.aeval (fun i : Fin 2 =>
      ![thetaAS a b g (X 0) / thetaAS a b g (X 2),
        thetaAS a b g (X 1) / thetaAS a b g (X 2)] i) (bwASR2 a b g) = asRtilde a b g := by
  have h2 := thetaAS_X2_ne_zero a b g hd hg
  have h0 : thetaAS a b g (X 0) / thetaAS a b g (X 2) = asU := by
    rw [thetaAS_X0_eq, mul_div_cancel_right₀ _ h2]
  have h1 : thetaAS a b g (X 1) / thetaAS a b g (X 2) = bwASV := by
    rw [thetaAS_X1_eq, mul_div_cancel_right₀ _ h2]
  rw [h0, h1]
  rw [show (fun i : Fin 2 => ![asU, bwASV] i) = (fun i : Fin 2 =>
    algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (X i)) from by
      funext i; fin_cases i <;> rfl]
  exact aeval_algebraMap_bwASV (bwASR2 a b g)

/-- `θ F` is the evaluation at `(θ X₀, θ X₁, θ X₂)`. -/
theorem thetaAS_aeval_apply (a b g : K) (F : MvPolynomial (Fin 3) K) :
    thetaAS a b g F = MvPolynomial.aeval (fun i : Fin 3 =>
      ![thetaAS a b g (X 0), thetaAS a b g (X 1), thetaAS a b g (X 2)] i) F :=
  congrFun (congrArg DFunLike.coe (thetaAS_eq_aeval a b g)) F

theorem thetaAS_bwASQ (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    thetaAS a b g (bwASQ a b g) = (thetaAS a b g (X 2)) ^ 2 * asQtilde a b := by
  have h2 := thetaAS_X2_ne_zero a b g hd hg
  rw [thetaAS_aeval_apply, aeval_bwASQ_dehomog a b g _ _ _ h2, aeval_div_eq a b g hd hg]

theorem thetaAS_bwASR (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    thetaAS a b g (bwASR a b g) = (thetaAS a b g (X 2)) ^ 3 * asRtilde a b g := by
  have h2 := thetaAS_X2_ne_zero a b g hd hg
  rw [thetaAS_aeval_apply, aeval_bwASR_dehomog a b g _ _ _ h2, aeval_div_eq_R a b g hd hg]

/-- **§2.**  The parametrisation kills the cubic `bwASpoly a b g`. -/
theorem thetaAS_bwASpoly (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    thetaAS a b g (bwASpoly a b g) = 0 := by
  have hQ := thetaAS_bwASQ a b g hd hg
  have hR := thetaAS_bwASR a b g hd hg
  rw [bwASpoly, map_add, hQ, hR, thetaAS_X2]
  field_simp
  first | refl_ring1 | ring

/-! ## §3. The fraction field of the range of `θ` is `K(U,V)` -/

/-- The subfield of `Frac K[U,V]` generated over `K` by `U = X 0` and `V = X 1` is everything:
every element of `Frac K[U,V]` is a quotient of two polynomials in `U`, `V`.

(The proof is the same as that of the private lemma `closure_algebraMap_union_X_eq_top` of
`Submission/Work/MotK/TGen/FwVec4FracRange.lean`.) -/
private theorem closure_algebraMap_union_X_eq_top (K : Type) [Field K] :
    Subfield.closure (Set.range (algebraMap K (FractionRing (MvPolynomial (Fin 2) K))) ∪
      ({algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 0),
        algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 1)} : Set (FractionRing (MvPolynomial (Fin 2) K)))) = ⊤ := by
  set T : Subfield (FractionRing (MvPolynomial (Fin 2) K)) :=
    Subfield.closure (Set.range (algebraMap K (FractionRing (MvPolynomial (Fin 2) K))) ∪
      ({algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 0),
        algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 1)} : Set (FractionRing (MvPolynomial (Fin 2) K)))) with hT
  have hmemK : ∀ k : K, algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ T := by
    intro k
    rw [hT]
    exact Subfield.subset_closure (Or.inl ⟨k, rfl⟩)
  have hmemX : ∀ i : Fin 2,
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (MvPolynomial.X i) ∈ T := by
    intro i
    rw [hT]
    fin_cases i <;> exact Subfield.subset_closure (Or.inr (by simp))
  have hmem : ∀ a : MvPolynomial (Fin 2) K,
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) a ∈ T := by
    intro a
    refine MvPolynomial.induction_on a (motive := fun a =>
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) a ∈ T)
      ?_ ?_ ?_
    · intro c
      rw [MvPolynomial.C_eq_algebraMap,
        ← IsScalarTower.algebraMap_apply K (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K)) c]
      exact hmemK c
    · intro p q hp hq
      rw [map_add]
      exact T.add_mem hp hq
    · intro p n hp
      rw [map_mul]
      exact T.mul_mem hp (hmemX n)
  rw [eq_top_iff]
  intro z _
  obtain ⟨x, hx⟩ := IsLocalization.surj (nonZeroDivisors (MvPolynomial (Fin 2) K)) z
  have hne : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
      (x.2 : MvPolynomial (Fin 2) K) ≠ 0 := by
    intro h0
    refine (mem_nonZeroDivisors_iff_ne_zero.mp x.2.2) ?_
    exact IsFractionRing.injective (MvPolynomial (Fin 2) K)
      (FractionRing (MvPolynomial (Fin 2) K)) (by rw [h0, map_zero])
  have hz : z = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) x.1
      * (algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (x.2 : MvPolynomial (Fin 2) K))⁻¹ := by
    rw [← hx, mul_assoc, mul_inv_cancel₀ hne, mul_one]
  rw [hz]
  exact T.mul_mem (hmem x.1) (T.inv_mem (hmem (x.2 : MvPolynomial (Fin 2) K)))

/-- **§3.**  The fraction field of the range of the graph parametrisation is `K(U,V)`: `U` and `V`
are quotients of elements of the range (`thetaAS_X0_eq`), so the subfield generated by the range
contains `U`, `V` and `K` — hence is everything, by `closure_algebraMap_union_X_eq_top`. -/
theorem range_fractionRing (a b g : K) (hd : asDel a b ≠ 0) (hg : g ≠ 0) :
    Nonempty (FractionRing (thetaAS a b g).range ≃ₐ[K] RatFunc (RatFunc K)) := by
  have hx2 : thetaAS a b g (X 2) ≠ 0 := thetaAS_X2_ne_zero a b g hd hg
  have hgen : Subfield.closure (Set.range (algebraMap (thetaAS a b g).range
      (FractionRing (MvPolynomial (Fin 2) K)))) = ⊤ := by
    set T : Subfield (FractionRing (MvPolynomial (Fin 2) K)) :=
      Subfield.closure (Set.range (algebraMap (thetaAS a b g).range
        (FractionRing (MvPolynomial (Fin 2) K)))) with hT
    have mem_range : ∀ y : (thetaAS a b g).range,
        ((y : FractionRing (MvPolynomial (Fin 2) K)) ∈ T) := by
      intro y
      rw [hT]
      exact Subfield.subset_closure ⟨y, rfl⟩
    have hU : asU ∈ T := by
      have heq : asU = thetaAS a b g (X 0) * (thetaAS a b g (X 2))⁻¹ := by
        rw [thetaAS_X0_eq, mul_assoc, mul_inv_cancel₀ hx2, mul_one]
      rw [heq]
      exact T.mul_mem (mem_range ⟨_, ⟨X 0, rfl⟩⟩) (T.inv_mem (mem_range ⟨_, ⟨X 2, rfl⟩⟩))
    have hV : bwASV ∈ T := by
      have heq : bwASV = thetaAS a b g (X 1) * (thetaAS a b g (X 2))⁻¹ := by
        rw [thetaAS_X1_eq, mul_assoc, mul_inv_cancel₀ hx2, mul_one]
      rw [heq]
      exact T.mul_mem (mem_range ⟨_, ⟨X 1, rfl⟩⟩) (T.inv_mem (mem_range ⟨_, ⟨X 2, rfl⟩⟩))
    have hKm : ∀ k : K, algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ T := by
      intro k
      have hr : algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k
          ∈ (thetaAS a b g).range :=
        ⟨MvPolynomial.C k, by
          rw [MvPolynomial.C_eq_algebraMap]
          exact AlgHom.commutes (thetaAS a b g) k⟩
      exact mem_range ⟨_, hr⟩
    refine le_antisymm le_top ?_
    rw [← closure_algebraMap_union_X_eq_top K]
    refine Subfield.closure_le.mpr ?_
    rintro x (hx | hx)
    · obtain ⟨k, rfl⟩ := hx
      exact hKm k
    · rw [Set.mem_insert_iff] at hx
      rcases hx with rfl | hx
      · exact hU
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact hV
  haveI : IsFractionRing (thetaAS a b g).range (FractionRing (MvPolynomial (Fin 2) K)) :=
    Work.MotK.CensusBridge.isFractionRing_of_subfield_closure_range _ hgen
  exact ⟨(AlgEquiv.restrictScalars K (IsLocalization.algEquiv
    (nonZeroDivisors (thetaAS a b g).range) (FractionRing (thetaAS a b g).range)
    (FractionRing (MvPolynomial (Fin 2) K)))).trans
    (Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo K).some⟩

/-! ## §4-§6. Heights and assembly -/

theorem bwASpoly_fractionRing {K : Type} [Field K] [CharP K 5] (a b g : K)
    (hd : a ^ 2 - a * b - b ^ 2 ≠ 0) (hg : g ≠ 0)
    (hprime : (Ideal.span {bwASpoly a b g} : Ideal (MvPolynomial (Fin 3) K)).IsPrime) :
    Nonempty (FractionRing (MvPolynomial (Fin 3) K ⧸ Ideal.span {bwASpoly a b g}) ≃ₐ[K]
      RatFunc (RatFunc K)) := by
  classical
  have hd' : asDel a b ≠ 0 := hd
  have hθp : thetaAS a b g (bwASpoly a b g) = 0 := thetaAS_bwASpoly a b g hd' hg
  obtain ⟨eR⟩ := range_fractionRing (K := K) a b g hd' hg
  -- the transcendence degree of the residue field of `ker θ`
  haveI : (RingHom.ker (thetaAS a b g)).IsPrime := RingHom.ker_isPrime _
  have htr : Algebra.trdeg K
      (FractionRing (MvPolynomial (Fin 3) K ⧸ RingHom.ker (thetaAS a b g))) = 2 := by
    obtain ⟨e1⟩ := Work.CrauderKatz.BlowUp.fractionRing_algEquiv_of_algEquiv
      (Ideal.quotientKerEquivRange (thetaAS a b g))
    have h1 : Algebra.trdeg K (FractionRing (MvPolynomial (Fin 3) K
          ⧸ RingHom.ker (thetaAS a b g)))
        = Algebra.trdeg K (FractionRing (thetaAS a b g).range) := AlgEquiv.trdeg_eq e1
    have h2 : Algebra.trdeg K (FractionRing (thetaAS a b g).range) = 2 := by
      rw [AlgEquiv.trdeg_eq eR, Work.MotK.TGen.trdeg_ratFunc_ratFunc_eq_two K]
    rw [h1, h2]
  -- the height of `ker θ`
  have hker : (RingHom.ker (thetaAS a b g)).height = 1 :=
    Work.MotK.CensusBridge.height_eq_one_of_trdeg_eq_two K _ htr
  -- `(p)` is a height-one prime contained in `ker θ`
  have hp0 : bwASpoly a b g ≠ 0 := bwASpoly_ne_zero a b g hd' hg
  have hpprime : (Ideal.span {bwASpoly a b g} :
      Ideal (MvPolynomial (Fin 3) K)).IsPrime := hprime
  have hheight : Ideal.height (Ideal.span {bwASpoly a b g} :
      Ideal (MvPolynomial (Fin 3) K)) = 1 :=
    Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_iff_ne_zero.mpr hp0)
      (fun hunit => Ideal.IsPrime.ne_top hprime (Ideal.span_singleton_eq_top.mpr hunit))
  have hle : Ideal.span {bwASpoly a b g} ≤ RingHom.ker (thetaAS a b g) := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
    exact hθp
  have hkereq : RingHom.ker (thetaAS a b g) = Ideal.span {bwASpoly a b g} := by
    refine le_antisymm ?_ hle
    by_contra hne
    have hlt : Ideal.span {bwASpoly a b g} < RingHom.ker (thetaAS a b g) :=
      lt_of_le_of_ne hle (fun heq => hne (le_of_eq heq.symm))
    have hstep := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    rw [hheight, hker] at hstep
    exact absurd hstep (by norm_num)
  rw [← hkereq]
  obtain ⟨e1⟩ := Work.CrauderKatz.BlowUp.fractionRing_algEquiv_of_algEquiv
    (Ideal.quotientKerEquivRange (thetaAS a b g))
  exact ⟨e1.trans eR⟩

end Work.MotC5N3.BwAS
