/-!
# `Work.MotC5N3` — the Artin–Schreier twist over an ARBITRARY base field `K`

Generic (`K` in place of `RatFunc 𝕜`) versions of the definitions of
`Submission/Work/MotV5/Defs.lean`, `…/MotV5/ASTwistData.lean` and `…/MotAS/TwistField.lean`.
Klein data stay over `𝕜` (`D : Work.MotV.KleinData 𝕜`) and the base field is any `𝕜`-algebra
field `K`; route V is the special case `K = RatFunc 𝕜`, the `n = 3` route uses `𝕜 = K`.

This is the port target of the design file `MOTIVIC_CHAR5_N3_LEAD.md` (there, namespace
`Work.MotASG`); the declarations are named identically to the `MotV5`/`MotAS` ones.

Naming: `K` is implicit wherever it is determined by `g : K` or by an automorphism, and explicit
in `KbA`, `OmA`, `kleinField`, `ShiftCompatProj`.

## Interface

* `KbA K = AlgebraicClosure K`, `OmA K D = K̄(E)` for a Klein datum `D`;
* `asPoly g`, `asRoot g`, `asRoot_spec` — a root of `X⁵ - X - g` in `K̄`;
* `asTwistAction D τ σS`, `asTwistFieldFix D τ σS`, `kleinField K D`, `asFieldL D g`,
  `asTwistFieldTrue D g τ σS` — the twisted action and its fixed field;
* `KleinData.ShiftOf D σS`, `KleinData.ShiftCompatProj K D` — the (scaled) fifth-torsion shift;
* `ASTwistData 𝕜 D g τ σS σ` — the standing hypotheses of the AS branch;
* `asTwY D g j`, `twistFieldAS D g` — the explicit Galois-coordinate model.
-/

set_option autoImplicit false
open WeierstrassCurve WeierstrassCurve.Affine

namespace Work.MotC5N3
noncomputable section

/-- `K̄`, the algebraic closure of the base field (replaces `Work.MotV.Kb 𝕜`). -/
abbrev KbA (K : Type) [Field K] : Type := AlgebraicClosure K

/-- `K̄(E)` (replaces `Work.MotV.Om D`). -/
abbrev OmA {𝕜 : Type} [Field 𝕜] (K : Type) [Field K] [Algebra 𝕜 K]
    (D : Work.MotV.KleinData 𝕜) : Type :=
  Affine.FunctionField (D.E.baseChange (KbA K))

/-- `X⁵ - X - g` over `K̄`. -/
def asPoly {K : Type} [Field K] (g : K) : Polynomial (KbA K) :=
  (Polynomial.X : Polynomial (KbA K)) ^ 5 - (Polynomial.X : Polynomial (KbA K))
    - Polynomial.C (algebraMap K (KbA K) g)

theorem asPoly_degree_ne_zero {K : Type} [Field K] (g : K) : (asPoly g).degree ≠ 0 := by
  have h : (asPoly g).natDegree = 5 := by unfold asPoly; compute_degree!
  have hne : asPoly g ≠ 0 := by
    intro h0; rw [h0, Polynomial.natDegree_zero] at h; exact absurd h (by norm_num)
  rw [Polynomial.degree_eq_natDegree hne, h]; norm_num

/-- A root of `X⁵ - X - g` in `K̄`. -/
def asRoot {K : Type} [Field K] (g : K) : KbA K :=
  Classical.choose (IsAlgClosed.exists_root (asPoly g) (asPoly_degree_ne_zero g))

theorem asRoot_spec {K : Type} [Field K] (g : K) :
    asRoot g ^ 5 - asRoot g = algebraMap K (KbA K) g := by
  have h2 : (asPoly g).IsRoot (asRoot g) :=
    Classical.choose_spec (IsAlgClosed.exists_root (asPoly g) (asPoly_degree_ne_zero g))
  have h3 : (asPoly g).eval (asRoot g) = 0 := h2
  simp only [asPoly, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_C] at h3
  linear_combination (norm := first | refl_ring1 | ring1) h3

variable {𝕜 : Type} [Field 𝕜]

/-- The twisted action `σ' = τ ∘ σS` (replaces `Work.MotV5.asTwistAction`). -/
def asTwistAction {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜)
    (τ : OmA K D ≃ₐ[K] OmA K D) (σS : OmA K D ≃ₐ[KbA K] OmA K D) : OmA K D ≃ₐ[K] OmA K D :=
  τ.trans (σS.restrictScalars K)

/-- The fixed field of the cyclic group generated by the twisted action. -/
def asTwistFieldFix {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜)
    (τ : OmA K D ≃ₐ[K] OmA K D) (σS : OmA K D ≃ₐ[KbA K] OmA K D) :
    IntermediateField K (OmA K D) :=
  IntermediateField.fixedField (Subgroup.zpowers (asTwistAction D τ σS))

/-- `K(E) ⊆ K̄(E)`. -/
def kleinField (K : Type) [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) :
    IntermediateField K (OmA K D) :=
  IntermediateField.adjoin K
    (Set.range (fun i : Fin 5 => Work.MotV.kleinCoord D (KbA K) i /
      Work.MotV.kleinCoord D (KbA K) 0))

/-- `L(E) = K(E) ⊔ K(asRoot g)`. -/
def asFieldL {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (g : K) :
    IntermediateField K (OmA K D) :=
  kleinField K D ⊔ IntermediateField.adjoin K {algebraMap (KbA K) (OmA K D) (asRoot g)}

/-- **The AS twist field** `L(E)^{σ'}` (replaces `Work.MotV5.asTwistFieldTrue`). -/
def asTwistFieldTrue {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (g : K)
    (τ : OmA K D ≃ₐ[K] OmA K D) (σS : OmA K D ≃ₐ[KbA K] OmA K D) :
    IntermediateField K (OmA K D) :=
  asTwistFieldFix D τ σS ⊓ asFieldL D g

/-- The projective shift condition for a *given* `K̄`-automorphism `σS`. -/
def KleinData.ShiftOf {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜)
    (σS : OmA K D ≃ₐ[KbA K] OmA K D) : Prop :=
  ∃ lam : OmA K D, lam ≠ 0 ∧ ∀ i : Fin 5,
    σS (Work.MotV.kleinCoord D (KbA K) i) = lam * Work.MotV.kleinCoord D (KbA K) (i + 1)

/-- Existence of a `K̄`-automorphism satisfying the projective shift condition. -/
def KleinData.ShiftCompatProj (K : Type) [Field K] [Algebra 𝕜 K]
    (D : Work.MotV.KleinData 𝕜) : Prop :=
  ∃ σS : OmA K D ≃ₐ[KbA K] OmA K D, KleinData.ShiftOf D σS

/-- The standing hypotheses (replaces `Work.MotV5.ASTwistData`; same fields). -/
structure ASTwistData (𝕜 : Type) [Field 𝕜] {K : Type} [Field K] [Algebra 𝕜 K]
    (D : Work.MotV.KleinData 𝕜) (g : K)
    (τ : OmA K D ≃ₐ[K] OmA K D) (σS : OmA K D ≃ₐ[KbA K] OmA K D)
    (σ : KbA K ≃ₐ[K] KbA K) : Prop where
  hτ : ∀ c : KbA K, τ (algebraMap (KbA K) (OmA K D) c) = algebraMap (KbA K) (OmA K D) (σ c)
  hτk : ∀ x : OmA K D, x ∈ kleinField K D → τ x = x
  hσ : σ (asRoot g) = asRoot g + 1
  hσS : KleinData.ShiftOf D σS
  h5L : ∀ x ∈ asFieldL D g, ((asTwistAction D τ σS) ^ 5) x = x
  hneL : ∃ x ∈ asFieldL D g, asTwistAction D τ σS x ≠ x
  hpres : ∀ x ∈ asFieldL D g, asTwistAction D τ σS x ∈ asFieldL D g

/-- Galois coordinates `y = asM(asRoot g)⁻¹ κ` (replaces `Work.MotAS.asTwY`). -/
def asTwY {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (g : K) (j : Fin 5) :
    OmA K D :=
  ∑ i, algebraMap (KbA K) (OmA K D) ((Work.MotAS.asM (asRoot g))⁻¹ j i) *
    Work.MotV.kleinCoord D (KbA K) i

/-- **The explicit AS twist field** `K(y_j/y_0)` (replaces `Work.MotAS.twistFieldAS`). -/
def twistFieldAS {K : Type} [Field K] [Algebra 𝕜 K] (D : Work.MotV.KleinData 𝕜) (g : K) :
    IntermediateField K (OmA K D) :=
  IntermediateField.adjoin K (Set.range fun j => asTwY D g j / asTwY D g 0)

end
end Work.MotC5N3
