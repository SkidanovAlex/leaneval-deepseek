/-!
# `Work.MotT.map_AM2`: the base-change map identifies the two-root twist fields

`M = ML2 D h₁ h₂ hk = L(E)` is the function field of the Klein model base changed to the two-root
Kummer field `L = K(ζ, w₁, w₂)` (`wᵢ = ⁵√hᵢ`), and `iota2 D h₁ h₂ hk : M →ₐ[K] K̄(E)` is the
base-change map of function fields along `L ⊆ K̄` (`functionField_baseChange_map`).

The two `K`-subfields `AM21 = K(C_{h₁})` and `AM22 = K(C_{h₂})` of `M` are the `K`-subalgebras
generated by the twisted Klein coordinates `yM21`, `yM22`, and `twistFieldTK D hᵢ` is the same
`K`-algebra of `K̄(E)` generated by the twisted coordinates `twCoordK D hᵢ`.  The theorem says that
`iota2` carries each of them onto the corresponding twist field:

`(AM21).map iota2 = twistFieldTK D h₁` and `(AM22).map iota2 = twistFieldTK D h₂`.

The mathematical content is the element-level functoriality of the twisted coordinates
(`map_AM2_iota2_yM21`, `map_AM2_iota2_yM22`): `iota2` sends a base constant `l ∈ L` to `l ∈ K̄`, is
the identity on `genX`/`genY`, and hence sends `kleinCoord D L i` to `kleinCoord D K̄ i` and the
element `wᵢ ∈ L` to `root5K hᵢ ∈ K̄`, so `yM21 i ↦ twCoordK D h₁ i`.  The passage from the
element-level statement to the fields is `IntermediateField.adjoin_le_iff` /
`IntermediateField.map_le_iff_le_comap` in both directions, as in the one-root analogue
`Work.MotT.map_AM` (`Submission/Work/MotT/twistFieldTK_descent.lean`).
-/

namespace Work.MotT

noncomputable section

open WeierstrassCurve WeierstrassCurve.Affine

/-! ## §1 The defining properties of `iota2` -/

theorem map_AM2_iota2_spec {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) :
    (∀ l : ↥(KummerField2 K h₁ h₂ hk),
        iota2 D h₁ h₂ hk (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l) =
          algebraMap (KbK K) (OmK D) l) ∧
      iota2 D h₁ h₂ hk (Work.MotV.genX (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))) =
        Work.MotV.genX (D.E.baseChange (KbK K)) ∧
      iota2 D h₁ h₂ hk (Work.MotV.genY (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))) =
        Work.MotV.genY (D.E.baseChange (KbK K)) ∧
      Function.Injective (iota2 D h₁ h₂ hk) := by
  have h := Classical.choose_spec (functionField_baseChange_map K D.E
    ↥(KummerField2 K h₁ h₂ hk) (KbK K)
    (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (KbK K)))
  exact ⟨fun l => h.1 l, h.2.1, h.2.2.1, h.2.2.2 (fun a b hab => Subtype.ext hab)⟩

theorem map_AM2_iota2_algebraMap {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (l : ↥(KummerField2 K h₁ h₂ hk)) :
    iota2 D h₁ h₂ hk (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l) =
      algebraMap (KbK K) (OmK D) l :=
  (map_AM2_iota2_spec D h₁ h₂ hk).1 l

theorem map_AM2_iota2_genX {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) :
    iota2 D h₁ h₂ hk (Work.MotV.genX (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))) =
      Work.MotV.genX (D.E.baseChange (KbK K)) := (map_AM2_iota2_spec D h₁ h₂ hk).2.1

theorem map_AM2_iota2_genY {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) :
    iota2 D h₁ h₂ hk (Work.MotV.genY (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))) =
      Work.MotV.genY (D.E.baseChange (KbK K)) := (map_AM2_iota2_spec D h₁ h₂ hk).2.2.1

/-! ## §2 `iota2` on the Klein coordinates -/

/-- `iota2` sends the Klein coordinates over `L = K(ζ, w₁, w₂)` to those over `K̄`. -/
theorem map_AM2_iota2_kleinCoord {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (i : Fin 5) :
    iota2 D h₁ h₂ hk (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i) =
      Work.MotV.kleinCoord D (KbK K) i := by
  rw [Work.MotV.kleinCoord_eq_sum, Work.MotV.kleinCoord_eq_sum]
  simp only [map_sum, map_mul]
  refine Finset.sum_congr rfl fun m _ => ?_
  congr 1
  · rw [map_AM2_iota2_algebraMap]
    exact congrArg (algebraMap (KbK K) (OmK D))
      (IsScalarTower.algebraMap_apply K ↥(KummerField2 K h₁ h₂ hk) (KbK K) (D.coord i m)).symm
  · rw [Work.MotV.kleinBas, Work.MotV.kleinBas]
    fin_cases m <;>
      simp only [Matrix.cons_val_zero, Matrix.cons_val_succ, Matrix.head_cons, Matrix.tail_cons,
        Fin.isValue, Fin.succ_zero_eq_one, Fin.reduceFinMk, Matrix.cons_val_fin_one]
    · simp
    · exact map_AM2_iota2_genX D h₁ h₂ hk
    · exact map_AM2_iota2_genY D h₁ h₂ hk
    · simp [map_AM2_iota2_genX D h₁ h₂ hk]
    · simp [map_AM2_iota2_genX D h₁ h₂ hk, map_AM2_iota2_genY D h₁ h₂ hk]

/-! ## §3 `iota2` on the twisted coordinates -/

/-- The element-level statement for the twist parameter `h₁`. -/
theorem map_AM2_iota2_yM21 {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (i : Fin 5) :
    iota2 D h₁ h₂ hk (yM21 D h₁ h₂ hk i) = twCoordK D h₁ i := by
  rw [yM21, twCoordK, wK]
  simp only [map_mul, map_inv₀, map_pow, map_div₀]
  rw [map_AM2_iota2_algebraMap, map_AM2_iota2_kleinCoord, map_AM2_iota2_kleinCoord]
  rfl

/-- The element-level statement for the twist parameter `h₂`. -/
theorem map_AM2_iota2_yM22 {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (i : Fin 5) :
    iota2 D h₁ h₂ hk (yM22 D h₁ h₂ hk i) = twCoordK D h₂ i := by
  rw [yM22, twCoordK, wK]
  simp only [map_mul, map_inv₀, map_pow, map_div₀]
  rw [map_AM2_iota2_algebraMap, map_AM2_iota2_kleinCoord, map_AM2_iota2_kleinCoord]
  rfl

/-! ## §4 The theorem -/

theorem map_AM2 {K : Type} [Field K] (D : Work.MotV.KleinData K) (h₁ h₂ : K) (hk : ringChar K ≠ 5) :
    (AM21 D h₁ h₂ hk).map (iota2 D h₁ h₂ hk) = twistFieldTK D h₁ ∧
      (AM22 D h₁ h₂ hk).map (iota2 D h₁ h₂ hk) = twistFieldTK D h₂ := by
  constructor
  · apply le_antisymm
    · rw [AM21, IntermediateField.map_le_iff_le_comap, IntermediateField.adjoin_le_iff]
      rintro x ⟨i, rfl⟩
      show iota2 D h₁ h₂ hk (yM21 D h₁ h₂ hk i) ∈ twistFieldTK D h₁
      rw [map_AM2_iota2_yM21]
      exact IntermediateField.subset_adjoin K _ ⟨i, rfl⟩
    · rw [twistFieldTK, IntermediateField.adjoin_le_iff]
      rintro x ⟨i, rfl⟩
      rw [AM21, ← map_AM2_iota2_yM21 D h₁ h₂ hk i]
      exact ⟨yM21 D h₁ h₂ hk i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩, rfl⟩
  · apply le_antisymm
    · rw [AM22, IntermediateField.map_le_iff_le_comap, IntermediateField.adjoin_le_iff]
      rintro x ⟨i, rfl⟩
      show iota2 D h₁ h₂ hk (yM22 D h₁ h₂ hk i) ∈ twistFieldTK D h₂
      rw [map_AM2_iota2_yM22]
      exact IntermediateField.subset_adjoin K _ ⟨i, rfl⟩
    · rw [twistFieldTK, IntermediateField.adjoin_le_iff]
      rintro x ⟨i, rfl⟩
      rw [AM22, ← map_AM2_iota2_yM22 D h₁ h₂ hk i]
      exact ⟨yM22 D h₁ h₂ hk i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩, rfl⟩

end

end Work.MotT
