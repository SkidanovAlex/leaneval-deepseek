import Mathlib

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

open scoped TensorProduct

namespace Work.MotT

/-- **Linear disjointness plus generation identifies the tensor product with the ambient field,
in the `L`-linear form needed to push it through further base changes.**  Declare it in namespace
`Work.MotT`.

Let `A` be an intermediate field of `E/F` and `L/F` an *algebraic* field extension equipped with an
`F`-algebra map into `E`, such that `A` is linearly disjoint from `L` over `F` and `A` together with
the image of `L` generates `E`.  Then the multiplication map `L ⊗_F A → E` is an `L`-algebra
isomorphism (where `L ⊗_F A` carries the `L`-algebra structure of its first factor).

This is the companion of `Work.MotT.tensorProduct_algEquiv_of_linearDisjoint` (the same statement
with `↥A ⊗_F L` and `≃ₐ[F]`); the `L`-linear form is what makes the isomorphism usable inside a
further tensor product over `L`.

Route.  `A.LinearDisjoint L` is the injectivity of the multiplication map
`Subalgebra.mulMap A.toSubalgebra (IsScalarTower.toAlgHom F L E).range`, and this map is `L`-linear
when written as `L ⊗_F ↥A → E` (the `L`-action is on the first factor); its range is `⊤` by `hsup`
(using `Algebra.IsAlgebraic F L` so that the field compositum and the subalgebra generated by `A`
and the image of `L` agree, `IntermediateField.sup_toSubalgebra_of_isAlgebraic_right`).  Then
`AlgEquiv.ofBijective` finishes. -/
theorem tensorProduct_algEquiv_of_linearDisjointL {F E : Type*} [Field F] [Field E] [Algebra F E]
    (A : IntermediateField F E) (L : Type*) [Field L] [Algebra F L] [Algebra L E]
    [IsScalarTower F L E] [Algebra.IsAlgebraic F L] (hLI : A.LinearDisjoint L)
    (hsup : A ⊔ (IsScalarTower.toAlgHom F L E).fieldRange = ⊤) :
    Nonempty (TensorProduct F L ↥A ≃ₐ[L] E) := by
  let Lrf : IntermediateField F E := (IsScalarTower.toAlgHom F L E).fieldRange
  have halg : Algebra.IsAlgebraic F ↥Lrf :=
    (AlgEquiv.isAlgebraic_iff (AlgEquiv.ofInjectiveField (IsScalarTower.toAlgHom F L E))).mp
      (inferInstance : Algebra.IsAlgebraic F L)
  let f : TensorProduct F L ↥A →ₐ[L] E :=
    Algebra.TensorProduct.productLeftAlgHom (Algebra.ofId L E) A.val
  have hfield : IsField (TensorProduct F L ↥A) :=
    MulEquiv.isField (hLI.isField_of_isAlgebraic (Or.inr (inferInstance : Algebra.IsAlgebraic F L)))
      (Algebra.TensorProduct.comm F L ↥A).toMulEquiv
  have hinj : Function.Injective f := by
    have hker : ∀ x, f x = 0 → x = 0 := by
      intro x hx
      by_contra hx0
      obtain ⟨y, hy⟩ := hfield.mul_inv_cancel hx0
      have h1 : f (x * y) = 1 := by rw [hy]; exact f.map_one
      have h2 : f x * f y = 1 := by rw [← map_mul f x y, h1]
      rw [hx, zero_mul] at h2
      exact one_ne_zero h2.symm
    intro x y hxy
    have h := hker (x - y) (by rw [map_sub, hxy, sub_self])
    rwa [sub_eq_zero] at h
  have hsurj : Function.Surjective f := by
    rw [← AlgHom.range_eq_top]
    apply Subalgebra.restrictScalars_injective F
    rw [Subalgebra.restrictScalars_top, eq_top_iff]
    have h1 : (⊤ : Subalgebra F E) = A.toSubalgebra ⊔ Lrf.toSubalgebra := by
      rw [← @IntermediateField.sup_toSubalgebra_of_isAlgebraic_right F E _ _ _ A Lrf halg, hsup]
      rfl
    rw [h1]
    apply sup_le
    · intro a ha
      rw [Subalgebra.mem_restrictScalars]
      exact ⟨1 ⊗ₜ[F] ⟨a, (IntermediateField.mem_toSubalgebra A a).mp ha⟩, by simp [f]⟩
    · intro l hl
      rw [Subalgebra.mem_restrictScalars]
      obtain ⟨t, ht⟩ := hl
      have ht' : algebraMap L E t = l := by simpa using ht
      exact ⟨t ⊗ₜ[F] (1 : ↥A), by simp [f, ht']⟩
  exact ⟨AlgEquiv.ofBijective f ⟨hinj, hsurj⟩⟩

end Work.MotT
