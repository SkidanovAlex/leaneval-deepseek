/-!
# The coefficient action conjugates translations into the Galois action on points

Let `K` be a field, `L / K` a field extension, `W` a Weierstrass curve over `K` and
`E = W.baseChange L` its base change to `L`.  Write `M = L(E) = FunctionField E` for the function
field, `x = genX E`, `y = genY E` for its two coordinates and `τ_R = transAlgEquiv E R` for the
pullback of the translation by a point `R` of `E` (`Work.MotC2.Translation`), whose effect on the
generic point is given by the addition formulae: `τ_R x = transX E R`, `τ_R y = transY E R`.

A `K`-algebra automorphism `g` of `M` acting on the constants by `σ : L ≃ₐ[K] L` and fixing `x`
and `y` — the *coefficient action* of `σ` — commutes with translation, the translation by `R`
being replaced by the translation by the Galois translate `Point.map σ R` of `R`:

`g (τ_R z) = τ_{σ R} (g z)` for all `z ∈ M`.

The proof is a direct computation with the addition formulae (`addX`, `addY`, `slope`), which are
universal expressions in the coordinates of `R` and the coefficients of `W`, and are therefore
carried by `g` to the same expression with `σ` applied to the coordinates of `R`; since `g` is a
`K`-algebra homomorphism fixing the coefficients of `W` (which come from `K`), this is exactly
`Point.map σ`.  Both sides are `K`-algebra endomorphisms of `M` agreeing on the image of `L` and on
`x`, `y`, and `M = L(x, y)` is generated by `x, y` over `L`
(`Work.MotC.adjoin_genX_genY_eq_top`), so the two sides are equal.

The case at hand is `K` the base field, `L = KummerField2 K h₁ h₂ hk` and
`g = AM2_coeffAut D hD h₁ h₂ hk γ` the coefficient action of `γ ∈ Aut_K(L)` on
`M = ML2 D h₁ h₂ hk` (`Work.MotT.coeffAlgEquiv`, `Work.MotT.AM2_coeffAut_spec`): this is the
`coeff_τ` compatibility axiom needed by the T4 arithmetic step (LAM).
-/

open WeierstrassCurve WeierstrassCurve.Affine
open Work.MotC2

-- `transX` and `transY` are defined using the *specific* `DecidableEq (Func E)` instance
-- `Work.MotC2.instDecEqFunc`; re-registering it locally makes the `slope` terms written below
-- syntactically identical to those produced by `Work.MotC2.transX_some`/`transY_some`.
attribute [local instance] Work.MotC2.instDecEqFunc

namespace Work.MotT

noncomputable section

variable {K : Type} [Field K] {L : Type} [Field L] [Algebra K L]

/-! ## §1 Two `K`-algebra homomorphisms agreeing on `L`, `x` and `y` are equal -/

/-- Two `K`-algebra endomorphisms of the function field `L(E)` of the base change `E = W⁄L` which
agree on the constants `L` and on the two coordinates `x`, `y` of the generic point are equal: the
equalizer is an `L`-subfield containing `L`, `x` and `y`, hence everything, because
`L(x, y) = L(E)` (`Work.MotC.adjoin_genX_genY_eq_top`). -/
theorem ext_of_genX_genY_algebraMap (W : WeierstrassCurve K) [DecidableEq L]
    {F G : FunctionField (W.baseChange L) →ₐ[K] FunctionField (W.baseChange L)}
    (hL : ∀ l : L, F (algebraMap L _ l) = G (algebraMap L _ l))
    (hx : F (genX (W.baseChange L)) = G (genX (W.baseChange L)))
    (hy : F (genY (W.baseChange L)) = G (genY (W.baseChange L))) : F = G := by
  let Φ : IntermediateField L (FunctionField (W.baseChange L)) :=
  { carrier := {z | F z = G z}
    zero_mem' := by show F 0 = G 0; simp
    one_mem' := by show F 1 = G 1; simp
    add_mem' := fun {x y} hx hy => by
      have hx' : F x = G x := hx
      have hy' : F y = G y := hy
      show F (x + y) = G (x + y)
      rw [map_add, map_add, hx', hy']
    mul_mem' := fun {x y} hx hy => by
      have hx' : F x = G x := hx
      have hy' : F y = G y := hy
      show F (x * y) = G (x * y)
      rw [map_mul, map_mul, hx', hy']
    algebraMap_mem' := fun l => by
      show F (algebraMap L (FunctionField (W.baseChange L)) l)
        = G (algebraMap L (FunctionField (W.baseChange L)) l)
      exact hL l
    inv_mem' := fun x hx => by
      have hx' : F x = G x := hx
      show F x⁻¹ = G x⁻¹
      rw [map_inv₀, map_inv₀, hx'] }
  have htop : IntermediateField.adjoin L ({Work.MotC.C6.genX (W.baseChange L),
      Work.MotC.C6.genY (W.baseChange L)} : Set (FunctionField (W.baseChange L))) ≤ Φ := by
    rw [IntermediateField.adjoin_le_iff]
    rintro z (rfl | rfl)
    · exact hx
    · exact hy
  rw [Work.MotC.adjoin_genX_genY_eq_top (W.baseChange L)] at htop
  exact AlgHom.ext fun z => htop trivial

/-! ## §2 The addition formulae are carried along by the coefficient action -/

/-- **The `X`-coordinate of the translated generic point is carried along by the coefficient
action**: `g (transX E R) = transX E (Point.map σ R)`. -/
theorem map_transX (W : WeierstrassCurve K) [DecidableEq L]
    [instEll : (W.baseChange L).IsElliptic]
    (σ : L ≃ₐ[K] L) (g : FunctionField (W.baseChange L) ≃ₐ[K] FunctionField (W.baseChange L))
    (hgL : ∀ l : L, g (algebraMap L _ l) = algebraMap L _ (σ l))
    (hgX : g (genX (W.baseChange L)) = genX (W.baseChange L))
    (hgY : g (genY (W.baseChange L)) = genY (W.baseChange L)) :
    ∀ R : (W.baseChange L).toAffine.Point,
      g (transX (W.baseChange L) R) =
        transX (W.baseChange L) (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R) := by
  intro R
  cases R with
  | zero =>
    have h0 : (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom) Point.zero
        = Point.zero := Point.map_zero _
    rw [h0, transX_zero]
    exact hgX
  | some a b h =>
    have hc1 : g ((baseE (W.baseChange L)).a₁) = (baseE (W.baseChange L)).a₁ := by
      rw [show (baseE (W.baseChange L)).a₁
            = algebraMap L (Func (W.baseChange L)) ((W.baseChange L).a₁) from rfl, hgL]
      rw [show (W.baseChange L).a₁ = algebraMap K L W.a₁ from rfl, σ.commutes]
    have hc2 : g ((baseE (W.baseChange L)).a₂) = (baseE (W.baseChange L)).a₂ := by
      rw [show (baseE (W.baseChange L)).a₂
            = algebraMap L (Func (W.baseChange L)) ((W.baseChange L).a₂) from rfl, hgL]
      rw [show (W.baseChange L).a₂ = algebraMap K L W.a₂ from rfl, σ.commutes]
    rw [Point.map_some, transX_some, transX_some]
    rw [slope_of_X_ne (genX_ne_algebraMap (W.baseChange L) a),
        slope_of_X_ne (genX_ne_algebraMap (W.baseChange L) (σ.toAlgHom a))]
    simp only [WeierstrassCurve.Affine.addX, map_add, map_sub, map_mul, map_pow, map_div₀]
    rw [hc1, hc2, hgX, hgY, hgL a, hgL b]
    simp only [AlgEquiv.toAlgHom_apply]

/-- **The `Y`-coordinate of the translated generic point is carried along by the coefficient
action**: `g (transY E R) = transY E (Point.map σ R)`. -/
theorem map_transY (W : WeierstrassCurve K) [DecidableEq L]
    [instEll : (W.baseChange L).IsElliptic]
    (σ : L ≃ₐ[K] L) (g : FunctionField (W.baseChange L) ≃ₐ[K] FunctionField (W.baseChange L))
    (hgL : ∀ l : L, g (algebraMap L _ l) = algebraMap L _ (σ l))
    (hgX : g (genX (W.baseChange L)) = genX (W.baseChange L))
    (hgY : g (genY (W.baseChange L)) = genY (W.baseChange L)) :
    ∀ R : (W.baseChange L).toAffine.Point,
      g (transY (W.baseChange L) R) =
        transY (W.baseChange L) (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R) := by
  intro R
  cases R with
  | zero =>
    have h0 : (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom) Point.zero
        = Point.zero := Point.map_zero _
    rw [h0, transY_zero]
    exact hgY
  | some a b h =>
    have hc1 : g ((baseE (W.baseChange L)).a₁) = (baseE (W.baseChange L)).a₁ := by
      rw [show (baseE (W.baseChange L)).a₁
            = algebraMap L (Func (W.baseChange L)) ((W.baseChange L).a₁) from rfl, hgL]
      rw [show (W.baseChange L).a₁ = algebraMap K L W.a₁ from rfl, σ.commutes]
    have hc2 : g ((baseE (W.baseChange L)).a₂) = (baseE (W.baseChange L)).a₂ := by
      rw [show (baseE (W.baseChange L)).a₂
            = algebraMap L (Func (W.baseChange L)) ((W.baseChange L).a₂) from rfl, hgL]
      rw [show (W.baseChange L).a₂ = algebraMap K L W.a₂ from rfl, σ.commutes]
    have hc3 : g ((baseE (W.baseChange L)).a₃) = (baseE (W.baseChange L)).a₃ := by
      rw [show (baseE (W.baseChange L)).a₃
            = algebraMap L (Func (W.baseChange L)) ((W.baseChange L).a₃) from rfl, hgL]
      rw [show (W.baseChange L).a₃ = algebraMap K L W.a₃ from rfl, σ.commutes]
    rw [Point.map_some, transY_some, transY_some]
    rw [slope_of_X_ne (genX_ne_algebraMap (W.baseChange L) a),
        slope_of_X_ne (genX_ne_algebraMap (W.baseChange L) (σ.toAlgHom a))]
    simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negY,
      WeierstrassCurve.Affine.negAddY, WeierstrassCurve.Affine.addX, map_add, map_sub,
      map_mul, map_pow, map_div₀, map_neg]
    rw [hc1, hc2, hc3, hgX, hgY, hgL a, hgL b]
    simp only [AlgEquiv.toAlgHom_apply]

/-! ## §3 The main compatiblity -/

/-- **The coefficient action conjugates translations into the Galois action on points.**
For a Weierstrass curve `W` over `K`, a `K`-algebra automorphism `σ` of `L` acting on the
constants of `M = L(W⁄L)` by `σ` and fixing `x, y`
(`g (algebraMap L M l) = algebraMap L M (σ l)`, `g x = x`, `g y = y`), one has
`g (τ_R z) = τ_{σ R} (g z)` for all `z`, where `σ R = Point.map σ.toAlgHom R` is the Galois
translate of `R`.  Both sides are `K`-algebra endomorphisms of `M` agreeing on `L`, `x` and `y`,
which by `ext_of_genX_genY_algebraMap` finishes the proof after the computation with the addition
formulae (`map_transX`, `map_transY`). -/
theorem transAlgEquiv_comp_of_genXY (W : WeierstrassCurve K) [DecidableEq L]
    [instEll : (W.baseChange L).IsElliptic]
    (σ : L ≃ₐ[K] L) (g : FunctionField (W.baseChange L) ≃ₐ[K] FunctionField (W.baseChange L))
    (hgL : ∀ l : L, g (algebraMap L _ l) = algebraMap L _ (σ l))
    (hgX : g (genX (W.baseChange L)) = genX (W.baseChange L))
    (hgY : g (genY (W.baseChange L)) = genY (W.baseChange L))
    (R : (W.baseChange L).toAffine.Point) :
    ∀ x, g (transAlgEquiv (W.baseChange L) R x) =
      transAlgEquiv (W.baseChange L)
        (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R) (g x) := by
  have hFG : g.toAlgHom.comp ((transAlgEquiv (W.baseChange L) R).toAlgHom.restrictScalars K) =
      ((transAlgEquiv (W.baseChange L)
        (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R)).toAlgHom.restrictScalars
          K).comp g.toAlgHom := by
    refine ext_of_genX_genY_algebraMap W (fun l => ?_) ?_ ?_
    · show g (transAlgEquiv (W.baseChange L) R
          (algebraMap L (FunctionField (W.baseChange L)) l)) =
        transAlgEquiv (W.baseChange L)
          (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R)
          (g (algebraMap L (FunctionField (W.baseChange L)) l))
      rw [(transAlgEquiv (W.baseChange L) R).commutes l, hgL l,
        (transAlgEquiv (W.baseChange L)
          (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R)).commutes (σ l)]
    · show g (transAlgEquiv (W.baseChange L) R (genX (W.baseChange L))) =
        transAlgEquiv (W.baseChange L)
          (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R)
          (g (genX (W.baseChange L)))
      rw [transAlgEquiv_apply, phi_genX, hgX, transAlgEquiv_apply, phi_genX]
      exact map_transX W σ g hgL hgX hgY R
    · show g (transAlgEquiv (W.baseChange L) R (genY (W.baseChange L))) =
        transAlgEquiv (W.baseChange L)
          (Point.map (W' := W) (S := K) (F := L) (K := L) σ.toAlgHom R)
          (g (genY (W.baseChange L)))
      rw [transAlgEquiv_apply, phi_genY, hgY, transAlgEquiv_apply, phi_genY]
      exact map_transY W σ g hgL hgX hgY R
  intro x
  exact AlgHom.congr_fun hFG x

end

/-- **The coefficient action conjugates translations into the Galois action on points.**

Let `L = KummerField2 K h₁ h₂ hk`, `M = ML2 D h₁ h₂ hk = L(E)`, and let
`γ̃ = AM2_coeffAut D hD h₁ h₂ hk γ` be the *coefficient action* of `γ ∈ Aut_K(L)` on `M`: the
`K`-algebra automorphism acting on the constants `L` by `γ` and fixing `genX`, `genY`
(`Work.MotT.coeffAlgEquiv`, `Work.MotT.AM2_coeffAut_spec`).  Then conjugating a translation `τ_R`
by `γ̃` gives the translation by the Galois translate `γR` of the point `R`:

`γ̃ (τ_R x) = τ_{γR} (γ̃ x)` for all `x ∈ M`, i.e. `γ̃ * τ_R = τ_{γR} * γ̃`.

This is the "`coeff_τ`" compatibility axiom that the T4 arithmetic step (LAM) needs, exactly as
`Work.MotC.TransData.coeff_τ` is used by `Work.MotC.torsor_step`.

Route.  Both sides define `K`-algebra automorphisms of `M`; it suffices to check them on `genX`,
`genY` and `L`, which generate `M` as a `K`-field (the latter by
`Work.MotC.adjoin_genX_genY_eq_top`; the two sides agree on `L` because both act on constants by
conjugating `γ` with `γ`).  `τ_R` is *built from the addition formulas*: by
`Work.MotC2.transAlgEquiv_apply` / `Work.MotC2.phi_genX` / `Work.MotC2.phi_genY` one has
`τ_R (genX) = transX E R` and `τ_R (genY) = transY E R`, and `transX`, `transY` are the explicit
expressions `Work.MotC2.addX ... (Work.MotC2.slope ...)` in `genX, genY` and the *constants*
`algebraMap L _ x_R, algebraMap L _ y_R` of `R` (see `Work.MotC2.transX_some`,
`Work.MotC2.transY_some`).  Since `γ̃` is a `K`-algebra homomorphism fixing `genX`, `genY` and
sending `algebraMap L _ l ↦ algebraMap L _ (γ l)` (`AM2_coeffAut_spec`), it carries that
expression to the same expression with `x_R, y_R` replaced by `γ x_R, γ y_R`, i.e. to
`transX E (Point.map γ.toAlgHom R)`.  A convenient formalisation goes through
`Work.MotC2.plugHom` and `WeierstrassCurve.Affine.CoordinateRing.map`: `CoordinateRing.map
γ.toRingHom` is the coefficient action on the coordinate ring (`coeffAlgEquivAux` in
`Submission/Work/MotT/coeffAlgEquiv.lean`), while `Work.MotC2.phiT E R` is `plugHom` at the point
`(transX E R, transY E R)` of the base-changed curve, so the claim reduces to the commutativity of
`CoordinateRing.map` with `plugHom`.

`restrictScalars` note: `γ̃` is only `K`-linear while `transAlgEquiv` is `L`-linear, so the
composition is stated pointwise (equivalently
`γ̃ * τ_R.restrictScalars K = τ_{γR}.restrictScalars K * γ̃`). -/
theorem coeffAut_conj_trans {K : Type} [Field K] (D : Work.MotV.KleinData K) (hD : D.Good)
    (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    [instDec : DecidableEq ↥(KummerField2 K h₁ h₂ hk)]
    [instEll : (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk)).IsElliptic]
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk))
    (R : (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk)).toAffine.Point) :
    ∀ x : ML2 D h₁ h₂ hk,
      AM2_coeffAut D hD h₁ h₂ hk γ
          (Work.MotC2.transAlgEquiv (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk)) R x) =
        Work.MotC2.transAlgEquiv (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))
            (WeierstrassCurve.Affine.Point.map (W' := D.E) (S := K)
              (F := ↥(KummerField2 K h₁ h₂ hk)) (K := ↥(KummerField2 K h₁ h₂ hk)) γ.toAlgHom R)
            (AM2_coeffAut D hD h₁ h₂ hk γ x) := by
  intro x
  exact transAlgEquiv_comp_of_genXY (D.E) γ (AM2_coeffAut D hD h₁ h₂ hk γ)
    (AM2_coeffAut_spec D hD h₁ h₂ hk γ).1
    (AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.1
    (AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.2 R x

end Work.MotT
