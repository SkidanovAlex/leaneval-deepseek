/-!
# The Kummer field `L = K(ζ, w)` and the function field over it

Vocabulary shared by the nodes of the T-route (`twistFieldTK_descent`): the Kummer field
`L = K(ζ, w) ⊆ K̄` generated by a primitive fifth root of unity and a fifth root of `h`, its image
`L(E) ⊆ K̄(E)` described by the corresponding intermediate field inside `OmK D`, and the twisted
Klein coordinates in the function field over `L`.

* `zeta5K hk` is a primitive fifth root of unity in `K̄ = KbK K` (`ringChar K ≠ 5`).
* `KummerField h hk = K(ζ, w) ⊆ K̄`.
* `KE` is `K(x, y) ⊆ K̄(E)`, the base field of the curve inside the function field.
* `LE = L · 1` and `LEr = L · K(x,y)` are the images of `L` and of `L(E)` in `K̄(E)`.
* `ML = L(E)`, the function field of the base-changed curve over the field `L` itself,
  `wL` the element `w ∈ L`, and `yM` the twisted Klein coordinates inside `ML`.
-/

namespace Work.MotT

noncomputable section

open WeierstrassCurve WeierstrassCurve.Affine

variable {K : Type} [Field K]

/-! ## §1 A primitive fifth root of unity in the algebraic closure -/

/-- There is a primitive fifth root of unity in the algebraic closure of a field of characteristic
`≠ 5`. -/
theorem exists_primitiveRoot_fiveK (K : Type) [Field K] (hk : ringChar K ≠ 5) :
    ∃ ζ : KbK K, IsPrimitiveRoot ζ 5 := by
  have h5K : (5 : K) ≠ 0 := by
    intro h0
    have hdvd : ringChar K ∣ 5 := (CharP.cast_eq_zero_iff K (ringChar K) 5).mp h0
    rcases CharP.char_is_prime_or_zero K (ringChar K) with hp | hz
    · rcases (by norm_num : Nat.Prime 5).eq_one_or_self_of_dvd (ringChar K) hdvd with h | h
      · exact hp.ne_one h
      · exact hk h
    · haveI : CharZero K := (CharP.charP_zero_iff_charZero K).mp (ringChar.eq_iff.mp hz)
      exact (Nat.cast_ne_zero.mpr (by norm_num : (5 : ℕ) ≠ 0)) h0
  have h5Ω : (5 : KbK K) ≠ 0 := by
    intro h0
    exact h5K ((algebraMap K (KbK K)).injective (by rw [map_ofNat, h0, map_zero]))
  haveI : NeZero (5 : KbK K) := ⟨h5Ω⟩
  have hdeg : (Polynomial.cyclotomic 5 (KbK K)).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]; norm_num
  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic 5 (KbK K)) hdeg
  exact ⟨ζ, Polynomial.isRoot_cyclotomic_iff.mp hζ⟩

/-- A chosen primitive fifth root of unity in `K̄ = KbK K`. -/
def zeta5K (K : Type) [Field K] (hk : ringChar K ≠ 5) : KbK K :=
  Classical.choose (exists_primitiveRoot_fiveK K hk)

/-- The defining property of `zeta5K`. -/
theorem zeta5K_isPrimitiveRoot (K : Type) [Field K] (hk : ringChar K ≠ 5) :
    IsPrimitiveRoot (zeta5K K hk) 5 :=
  Classical.choose_spec (exists_primitiveRoot_fiveK K hk)

/-! ## §2 The Kummer field `L = K(ζ, w) ⊆ K̄` -/

/-- **`L = K(ζ, w)`**: the Kummer field generated by a primitive fifth root of unity and a fifth
root of the twist parameter. -/
def KummerField (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) : IntermediateField K (KbK K) :=
  IntermediateField.adjoin K ({zeta5K K hk, root5K h} : Set (KbK K))

theorem zeta5K_mem_KummerField (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) :
    zeta5K K hk ∈ KummerField K h hk :=
  IntermediateField.subset_adjoin K _ (by simp [KummerField])

theorem root5K_mem_KummerField (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) :
    root5K h ∈ KummerField K h hk :=
  IntermediateField.subset_adjoin K _ (by simp [KummerField])

/-- The element `w` (a fifth root of `h`) as an element of `L = K(ζ, w)`. -/
def wL (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) : ↥(KummerField K h hk) :=
  ⟨root5K h, root5K_mem_KummerField K h hk⟩

/-- The primitive root of unity as an element of `L`. -/
def zL (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) : ↥(KummerField K h hk) :=
  ⟨zeta5K K hk, zeta5K_mem_KummerField K h hk⟩

theorem wL_pow_five (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) :
    (wL K h hk) ^ 5 = algebraMap K ↥(KummerField K h hk) h := by
  apply Subtype.ext
  show root5K h ^ 5 = algebraMap K (KbK K) h
  exact root5K_spec h

theorem zL_isPrimitiveRoot (K : Type) [Field K] (h : K) (hk : ringChar K ≠ 5) :
    IsPrimitiveRoot (zL K h hk) 5 := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hζ := zeta5K_isPrimitiveRoot K hk
  rw [IsPrimitiveRoot.iff_orderOf]
  refine orderOf_eq_prime ?_ ?_
  · apply Subtype.ext
    show (zeta5K K hk) ^ 5 = 1
    exact hζ.pow_eq_one
  · intro h1
    exact hζ.ne_one (by norm_num) (congrArg Subtype.val h1)

/-! ## §3 The images in the function field `K̄(E)` -/

variable (D : Work.MotV.KleinData K)

/-- `K(x, y) ⊆ K̄(E)`. -/
def KE : IntermediateField K (OmK D) :=
  IntermediateField.adjoin K
    {Work.MotV.genX (D.E.baseChange (KbK K)), Work.MotV.genY (D.E.baseChange (KbK K))}

/-- The image `L · 1 ⊆ K̄(E)` of the Kummer field. -/
def LE (h : K) (hk : ringChar K ≠ 5) : IntermediateField K (OmK D) :=
  IntermediateField.map (IsScalarTower.toAlgHom K (KbK K) (OmK D)) (KummerField K h hk)

/-- `L(E) = L · K(x,y) ⊆ K̄(E)`. -/
def LEr (h : K) (hk : ringChar K ≠ 5) : IntermediateField K (OmK D) :=
  LE D h hk ⊔ KE D

theorem genX_mem_KE : Work.MotV.genX (D.E.baseChange (KbK K)) ∈ KE D :=
  IntermediateField.subset_adjoin K _ (by simp [KE])

theorem genY_mem_KE : Work.MotV.genY (D.E.baseChange (KbK K)) ∈ KE D :=
  IntermediateField.subset_adjoin K _ (by simp [KE])

theorem KE_le_LEr (h : K) (hk : ringChar K ≠ 5) : KE D ≤ LEr D h hk := le_sup_right

theorem wK_mem_LE (h : K) (hk : ringChar K ≠ 5) : wK D h ∈ LE D h hk := by
  refine (IntermediateField.mem_map (KummerField K h hk)).mpr ⟨root5K h, root5K_mem_KummerField K h hk, ?_⟩
  rfl

theorem wK_mem_LEr (h : K) (hk : ringChar K ≠ 5) : wK D h ∈ LEr D h hk :=
  (le_sup_left : LE D h hk ≤ LEr D h hk) (wK_mem_LE D h hk)

theorem kleinCoord_div_mem_KE (i : Fin 5) :
    Work.MotV.kleinCoord D (KbK K) i / Work.MotV.kleinCoord D (KbK K) 0 ∈ KE D := by
  have h0 : Work.MotV.kleinCoord D (KbK K) 0 ∈ KE D := by
    rw [Work.MotV.kleinCoord_eq_sum]
    refine Subalgebra.sum_mem _ fun m _ => Subalgebra.mul_mem _ ?_ ?_
    · exact Subalgebra.algebraMap_mem _ _
    · rw [Work.MotV.kleinBas]
      fin_cases m <;> simp only [Matrix.cons_val_fin_one, Matrix.cons_val_zero,
        Matrix.cons_val_succ, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.succ_zero_eq_one,
        Fin.reduceFinMk]
      · exact one_mem _
      · exact genX_mem_KE D
      · exact genY_mem_KE D
      · exact pow_mem (genX_mem_KE D) _
      · exact mul_mem (genX_mem_KE D) (genY_mem_KE D)
  have hi : Work.MotV.kleinCoord D (KbK K) i ∈ KE D := by
    rw [Work.MotV.kleinCoord_eq_sum]
    refine Subalgebra.sum_mem _ fun m _ => Subalgebra.mul_mem _ ?_ ?_
    · exact Subalgebra.algebraMap_mem _ _
    · rw [Work.MotV.kleinBas]
      fin_cases m <;> simp only [Matrix.cons_val_fin_one, Matrix.cons_val_zero,
        Matrix.cons_val_succ, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.succ_zero_eq_one,
        Fin.reduceFinMk]
      · exact one_mem _
      · exact genX_mem_KE D
      · exact genY_mem_KE D
      · exact pow_mem (genX_mem_KE D) _
      · exact mul_mem (genX_mem_KE D) (genY_mem_KE D)
  exact div_mem hi h0

theorem twCoordK_mem_LEr (h : K) (hk : ringChar K ≠ 5) (hh : h ≠ 0) (i : Fin 5) :
    twCoordK D h i ∈ LEr D h hk := by
  have hw : (wK D h)⁻¹ ∈ LEr D h hk := inv_mem (wK_mem_LEr D h hk)
  have hpow : (wK D h)⁻¹ ^ (i : ℕ) ∈ LEr D h hk := pow_mem hw _
  have : Work.MotV.kleinCoord D (KbK K) i / Work.MotV.kleinCoord D (KbK K) 0 ∈ LEr D h hk :=
    (le_sup_right : KE D ≤ LEr D h hk) (kleinCoord_div_mem_KE D i)
  exact mul_mem hpow this

theorem twistFieldTK_le_LEr (h : K) (hk : ringChar K ≠ 5) (hh : h ≠ 0) :
    twistFieldTK D h ≤ LEr D h hk := by
  rw [twistFieldTK, IntermediateField.adjoin_le_iff]
  rintro x ⟨i, rfl⟩
  exact twCoordK_mem_LEr D h hk hh i

/-! ## §4 The function field `M = L(E)` over `L` and its twisted coordinates -/

/-- **`M = L(E)`**: the function field of the curve base changed to the Kummer field `L`. -/
abbrev ML (D : Work.MotV.KleinData K) (h : K) (hk : ringChar K ≠ 5) : Type :=
  FunctionField (D.E.baseChange ↥(KummerField K h hk))

/-- The twisted Klein coordinates of the T-twist inside `M = L(E)`. -/
def yM (D : Work.MotV.KleinData K) (h : K) (hk : ringChar K ≠ 5) (i : Fin 5) :
    ML D h hk :=
  (algebraMap ↥(KummerField K h hk) (ML D h hk) (wL K h hk))⁻¹ ^ (i : ℕ) *
    (Work.MotV.kleinCoord D ↥(KummerField K h hk) i /
      Work.MotV.kleinCoord D ↥(KummerField K h hk) 0)

/-- The `K`-twist field inside `M = L(E)`. -/
def AM (D : Work.MotV.KleinData K) (h : K) (hk : ringChar K ≠ 5) :
    IntermediateField K (ML D h hk) :=
  IntermediateField.adjoin K (Set.range (yM D h hk))

end

end Work.MotT
