open Polynomial

namespace Work.MotT

/-- **The Galois layer of the T-route.**  Let `K` be a field of characteristic `≠ 5`, `h ∈ Kˣ`, `ζ` a
primitive fifth root of unity in `K̄ = AlgebraicClosure K` and `w = root5K h` a chosen fifth root of
`h`.  Then `L = K(ζ, w) ⊆ K̄` is finite over `K` and `L/K` is Galois, so that
`L^{Aut_K(L)} = K` and `Nat.card (L ≃ₐ[K] L) = [L : K]` (`IsGalois.tfae`).

Route.  `L = K(ζ, w)` is **the splitting field over `K` of the separable polynomial
`p = X ^ 5 - C h`**: `p` is separable since `h ≠ 0` and `ringChar K ≠ 5`
(`Polynomial.separable_X_pow_sub_C`), and the roots of `p` in `K̄` are exactly the `ζ ^ i * w`
(`i < 5`) — indeed every root `y` satisfies `(y / w) ^ 5 = 1`, so `y / w` is a fifth root of unity
and hence a power of `ζ` (`IsPrimitiveRoot.eq_pow_of_pow_eq_one`); conversely `ζ = (ζ * w) / w`
with `ζ * w` and `w` both roots of `p`, so `ζ` lies in the field generated by the roots.  Hence
`p.IsSplittingField K L` (`IntermediateField.adjoin_rootSet_isSplittingField` together with the
equality of the two intermediate fields), which gives `FiniteDimensional` by
`Polynomial.IsSplittingField.finiteDimensional` and `IsGalois` by
`IsGalois.of_separable_splitting_field`.  Both listed hypotheses are used (`hh` also through
`Work.MotT.root5K_ne_zero`). -/
theorem isGalois_adjoin_root5 (K : Type) [Field K] (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0)
    (ζ : Work.MotT.KbK K) (hζ : IsPrimitiveRoot ζ 5) :
    FiniteDimensional K ↥(IntermediateField.adjoin K
        ({ζ, Work.MotT.root5K h} : Set (Work.MotT.KbK K))) ∧
      IsGalois K ↥(IntermediateField.adjoin K
        ({ζ, Work.MotT.root5K h} : Set (Work.MotT.KbK K))) := by
  -- char `K ≠ 5` gives `5 ≠ 0` in `K`
  have h5K : (5 : K) ≠ 0 := by
    intro h0
    have hdvd : ringChar K ∣ 5 := (CharP.cast_eq_zero_iff K (ringChar K) 5).mp h0
    rcases CharP.char_is_prime_or_zero K (ringChar K) with hp | hz
    · rcases (by norm_num : Nat.Prime 5).eq_one_or_self_of_dvd (ringChar K) hdvd with h' | h'
      · exact hp.ne_one h'
      · exact hk h'
    · haveI : CharZero K := (CharP.charP_zero_iff_charZero K).mp (ringChar.eq_iff.mp hz)
      exact (Nat.cast_ne_zero.mpr (by norm_num : (5 : ℕ) ≠ 0)) h0
  have hsep : (X ^ 5 - C h : K[X]).Separable := Polynomial.separable_X_pow_sub_C h h5K hh
  have hsplit : ((X ^ 5 - C h : K[X]).map (algebraMap K (KbK K))).Splits := IsAlgClosed.splits _
  -- `w = root5K h` and `ζ * w` are roots of `X ^ 5 - C h`
  have hw_mem : root5K h ∈ (X ^ 5 - C h : K[X]).rootSet (KbK K) := by
    rw [Polynomial.Monic.mem_rootSet (Polynomial.monic_X_pow_sub_C h (by norm_num))]
    simp [root5K_spec h]
  have hζw_mem : ζ * root5K h ∈ (X ^ 5 - C h : K[X]).rootSet (KbK K) := by
    rw [Polynomial.Monic.mem_rootSet (Polynomial.monic_X_pow_sub_C h (by norm_num))]
    have h5 : (ζ * root5K h) ^ 5 = algebraMap K (KbK K) h := by
      rw [mul_pow, hζ.pow_eq_one, one_mul, root5K_spec h]
    simp [h5]
  -- every root of `X ^ 5 - C h` lies in `K(ζ, w)`
  have hB : ∀ x ∈ (X ^ 5 - C h : K[X]).rootSet (KbK K),
      x ∈ (IntermediateField.adjoin K ({ζ, root5K h} : Set (KbK K)) : Set (KbK K)) := by
    intro x hx
    have halg_ne : algebraMap K (KbK K) h ≠ 0 := by
      simpa using (algebraMap K (KbK K)).injective.ne hh
    have hx5 : x ^ 5 = algebraMap K (KbK K) h := by
      have := Polynomial.aeval_eq_zero_of_mem_rootSet hx
      simpa [Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] using this
    have hu : (x * (root5K h)⁻¹) ^ 5 = 1 := by
      rw [mul_pow, inv_pow, hx5, root5K_spec h, mul_inv_cancel₀ halg_ne]
    obtain ⟨i, -, hi⟩ := hζ.eq_pow_of_pow_eq_one hu
    have hxeq : x = ζ ^ i * root5K h := by
      rw [hi, mul_assoc, inv_mul_cancel₀ (root5K_ne_zero hh), mul_one]
    rw [hxeq]
    exact mul_mem (pow_mem (IntermediateField.subset_adjoin K _ (by simp)) i)
      (IntermediateField.subset_adjoin K _ (by simp))
  -- conversely `ζ` and `w` lie in the field generated by the roots of `X ^ 5 - C h`
  have h1 : IntermediateField.adjoin K ({ζ, root5K h} : Set (KbK K)) ≤
      IntermediateField.adjoin K ((X ^ 5 - C h : K[X]).rootSet (KbK K)) := by
    rw [IntermediateField.adjoin_le_iff]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with hx | hx
    · rw [hx]
      have hzw := IntermediateField.subset_adjoin K _ hζw_mem
      have hw := IntermediateField.subset_adjoin K _ hw_mem
      have hdiv : ζ * root5K h / root5K h ∈
          IntermediateField.adjoin K ((X ^ 5 - C h : K[X]).rootSet (KbK K)) := div_mem hzw hw
      rwa [mul_div_cancel_right₀ _ (root5K_ne_zero hh)] at hdiv
    · rw [hx]
      exact IntermediateField.subset_adjoin K _ hw_mem
  have h2 : IntermediateField.adjoin K ((X ^ 5 - C h : K[X]).rootSet (KbK K)) ≤
      IntermediateField.adjoin K ({ζ, root5K h} : Set (KbK K)) := by
    rw [IntermediateField.adjoin_le_iff]
    exact hB
  have hEq : IntermediateField.adjoin K ({ζ, root5K h} : Set (KbK K)) =
      IntermediateField.adjoin K ((X ^ 5 - C h : K[X]).rootSet (KbK K)) := le_antisymm h1 h2
  -- `L` is the splitting field of `X ^ 5 - C h` over `K`
  haveI hsf : (X ^ 5 - C h : K[X]).IsSplittingField K
      ↥(IntermediateField.adjoin K ({ζ, root5K h} : Set (KbK K))) := by
    rw [IntermediateField.isSplittingField_iff]
    exact ⟨IntermediateField.splits_of_splits hsplit hB, hEq⟩
  exact ⟨Polynomial.IsSplittingField.finiteDimensional _ (X ^ 5 - C h : K[X]),
    IsGalois.of_separable_splitting_field hsep⟩

end Work.MotT
