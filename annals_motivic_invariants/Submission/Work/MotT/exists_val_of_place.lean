namespace Work.MotT

/-- **T11a.** A place of the function field over the constants gives a normalized `ℤ`-valued
valuation: `P.R` is a discrete valuation ring with fraction field `K` and maximal ideal generated by
the uniformizer `π`, hence `IsLocalRing.maximalIdeal P.R` is a `HeightOneSpectrum`, and its
`IsDedekindDomain.HeightOneSpectrum.valuation K` takes the value `vOne` at `π` (the `intValuation`
of a generator is `ofAdd (-1)`).  Declare it in namespace `Work.MotT` so that its full name is
`Work.MotT.exists_val_of_place`. -/
theorem exists_val_of_place {𝔽 K : Type} [Field 𝔽] [Field K] [Algebra 𝔽 K]
    (P : Work.FFResidual.FunctionFieldPlace 𝔽 K) :
    ∃ v : Valuation K (WithZero (Multiplicative ℤ)),
      v (algebraMap P.R K P.π) = Work.MotT.vOne := by
  -- The maximal ideal of the DVR is a height-one prime, and the associated adic valuation on `K`
  -- sends a generator to `ofAdd (-1)`.
  refine ⟨(IsDiscreteValuationRing.maximalIdeal P.R).valuation K, ?_⟩
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
    IsDedekindDomain.HeightOneSpectrum.intValuation_singleton _ P.pi_ne_zero P.isUniformizer]
  rfl

end Work.MotT
