open scoped TensorProduct

namespace Work.MotT

/-- **Linear disjointness plus generation identifies the tensor product with the ambient field.**
Let `A` be an intermediate field of `E/F`, `L/F` an *algebraic* field extension of `F` (the
algebraicity is what makes the field compositum coincide with the subalgebra generated by `A` and
the image of `L`) equipped with an `F`-algebra map into `E`, such that `A` is linearly disjoint from
`L` over `F` and `A` together with the image of `L` generates `E`.  Then the multiplication map
`↥A ⊗_F L → E` is an `F`-algebra isomorphism.

Route.  `A.LinearDisjoint L` is by definition the injectivity of `Subalgebra.mulMap A.toSubalgebra
(IsScalarTower.toAlgHom F L E).range` (`Subalgebra.linearDisjoint_iff_injective`), whose range is
the subalgebra generated by `A` and the image of `L`; and the image of `L` is algebraic over `A`, so
this subalgebra is a field and equals the compositum `A ⊔ fieldRange = ⊤` by `hsup`
(`IntermediateField.sup_toSubalgebra_of_isAlgebraic_right` and
`Subalgebra.sup_toIntermediateField`-style lemmas).  Hence the multiplication map is bijective and
`AlgEquiv.ofBijective` finishes. -/
theorem tensorProduct_algEquiv_of_linearDisjoint {F E : Type*} [Field F] [Field E] [Algebra F E]
    (A : IntermediateField F E) (L : Type*) [Field L] [Algebra F L] [Algebra L E]
    [IsScalarTower F L E] [Algebra.IsAlgebraic F L] (hLI : A.LinearDisjoint L)
    (hsup : A ⊔ (IsScalarTower.toAlgHom F L E).fieldRange = ⊤) :
    Nonempty (TensorProduct F (↥A) L ≃ₐ[F] E) := by
  classical
  -- The structure map `L → E` (an injective algebra homomorphism, `L` being a field).
  let f : L →ₐ[F] E := IsScalarTower.toAlgHom F L E
  -- Linear disjointness is, by definition, the injectivity of the multiplication map
  -- `↥A ⊗[F] (range of f) → E`.
  have hLI' : A.toSubalgebra.LinearDisjoint f.range := hLI
  have hinj₀ : Function.Injective (A.toSubalgebra.mulMap f.range) :=
    Subalgebra.linearDisjoint_iff_injective.mp hLI'
  have hf_inj : Function.Injective f := fun x y h => RingHom.injective (f : L →+* E) h
  -- `L ≃ range f`, and the induced isomorphism of tensor products.
  let he : L ≃ₐ[F] ↥(f.range) := AlgEquiv.ofInjective f hf_inj
  let e : TensorProduct F (↥A) L ≃ₐ[F] TensorProduct F ↥(A.toSubalgebra) ↥(f.range) :=
    Algebra.TensorProduct.congr (AlgEquiv.refl) he
  -- The multiplication map of the statement.
  let φ : TensorProduct F (↥A) L →ₐ[F] E := Algebra.TensorProduct.productMap A.val f
  have hφ_tmul : ∀ (a : ↥A) (l : L), φ (a ⊗ₜ[F] l) = (a : E) * f l := by
    intro a l
    simp only [φ, Algebra.TensorProduct.productMap_apply_tmul]
    rfl
  have he_tmul : ∀ (a : ↥A) (l : L),
      e (a ⊗ₜ[F] l) =
        TensorProduct.tmul F (AlgEquiv.refl (R := F) a : ↥(A.toSubalgebra)) (he l) := by
    intro a l
    rw [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
    rfl
  -- `φ` is the multiplication map of `A` with the range of `f`, precomposed with `e`.
  have hcomp : φ = (A.toSubalgebra.mulMap f.range).comp e.toAlgHom := by
    refine Algebra.TensorProduct.ext' fun a l => ?_
    change φ (a ⊗ₜ[F] l) = (A.toSubalgebra.mulMap f.range) (e (a ⊗ₜ[F] l))
    rw [he_tmul, Subalgebra.mulMap_tmul, AlgEquiv.ofInjective_apply, hφ_tmul]
    have h1 : (AlgEquiv.refl (R := F) a : ↥(A.toSubalgebra)) = a := by simp
    rw [h1]
  have hφa : ∀ a : ↥A, φ (a ⊗ₜ[F] (1 : L)) = (a : E) := by
    intro a; rw [hφ_tmul, map_one, mul_one]
  have hφl : ∀ l : L, φ ((1 : ↥A) ⊗ₜ[F] l) = f l := by
    intro l; rw [hφ_tmul]; simp
  have hinj : Function.Injective φ := by
    rw [hcomp]; exact hinj₀.comp e.injective
  -- `range f` is algebraic over `F` (`L` is), so the compositum of intermediate fields
  -- coincides with the compositum of the corresponding subalgebras.
  letI : Algebra.IsAlgebraic F ↥f.fieldRange :=
    f.equivFieldRange.isAlgebraic_iff.mp ‹Algebra.IsAlgebraic F L›
  have hrange : A.toSubalgebra ⊔ f.range = ⊤ := by
    have h1 : A.toSubalgebra ⊔ f.range = (A ⊔ f.fieldRange).toSubalgebra := by
      rw [IntermediateField.sup_toSubalgebra_of_isAlgebraic_right A f.fieldRange,
        AlgHom.fieldRange_toSubalgebra]
    rw [h1, hsup]
    exact IntermediateField.top_toSubalgebra
  -- The range of `φ` contains `A` and the image of `L`, hence is everything by `hsup`.
  have hφrange : φ.range = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← hrange]
    refine sup_le ?_ ?_
    · intro x hx
      rw [AlgHom.mem_range]
      exact ⟨⟨x, hx⟩ ⊗ₜ[F] (1 : L), by simpa using hφa ⟨x, hx⟩⟩
    · intro y hy
      rw [AlgHom.mem_range] at hy ⊢
      obtain ⟨l, rfl⟩ := hy
      exact ⟨(1 : ↥A) ⊗ₜ[F] l, hφl l⟩
  exact ⟨AlgEquiv.ofBijective φ ⟨hinj, (AlgHom.range_eq_top φ).mp hφrange⟩⟩

end Work.MotT
