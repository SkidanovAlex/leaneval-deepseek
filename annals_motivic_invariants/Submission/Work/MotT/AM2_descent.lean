/-!
# `Work.MotT.AM2_descent`: the two-root descent of the T-twist fields

Let `L = KummerField2 K h₁ h₂ hk = K(ζ, w₁, w₂) ⊆ K̄` be the two-root Kummer field and
`M = ML2 D h₁ h₂ hk = L(E)` the function field of the Klein model base changed to `L`.  The two
`K`-subfields `AM21 = K(C_{h₁})` and `AM22 = K(C_{h₂})` of `M` are the `K`-subalgebras generated by
the twisted Klein coordinates `yM21`, `yM22`.

This file proves that each of them is a `K`-form of `M` over `L`:

* `AM21.LinearDisjoint L` and `AM21 ⊔ L = M` (and the same for `AM22`).

The proof is the Artin/Speiser descent of `Submission/Work/MotT/fixedField_descent_finite.lean`
applied to the two-root field:  the twisted Galois action `γ ↦ τ_{c(γ)} ∘ γ̃` of `Gal(L/K)` on `M`
fixes the twisted coordinates, so its fixed field `Φ` contains `AM2i`;  Artin gives
`Φ.LinearDisjoint L` and `Φ ⊔ L = M`, whence the claim for `AM2i`.  All the twisted-action
machinery below is stated for a *general* `w ∈ L` with `w ^ 5 = h`, and is then instantiated at
`w = wL1` (twist parameter `h₁`) and `w = wL2` (twist parameter `h₂`).

The one-root analogue (with `L = K(ζ, w)`) is `Submission/Work/MotT/twistFieldTK_descent.lean`.
-/

namespace Work.MotT

noncomputable section

open WeierstrassCurve WeierstrassCurve.Affine

variable {K : Type} [Field K]

/-! ## §1 The twisted Klein coordinate for a general fifth root `w`, and the twisted action -/

/-- The twisted Klein coordinate `w^{-i} κ_i/κ_0` of the T-twist for a general fifth root `w` of
the twist parameter.  For `w = wL1` this is `yM21`, for `w = wL2` it is `yM22`. -/
def AM2_yM (D : Work.MotV.KleinData K) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (w : ↥(KummerField2 K h₁ h₂ hk)) (i : Fin 5) : ML2 D h₁ h₂ hk :=
  (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) w)⁻¹ ^ (i : ℕ) *
    (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
      Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0)

/-- The diagonal automorphism of `M = L(E)` given by `Good.T_diag` (`L ∋ ζ`). -/
def AM2_sigma (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5) :
    ML2 D h₁ h₂ hk ≃ₐ[↥(KummerField2 K h₁ h₂ hk)] ML2 D h₁ h₂ hk :=
  Classical.choose (hD.T_diag ↥(KummerField2 K h₁ h₂ hk) (zL2 K h₁ h₂ hk)
    (zL2_isPrimitiveRoot K h₁ h₂ hk))

theorem AM2_sigma_kleinCoord (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (i : Fin 5) :
    AM2_sigma D hD h₁ h₂ hk
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) =
      (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (zL2 K h₁ h₂ hk)) ^ (i : ℕ) *
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) :=
  Classical.choose_spec (hD.T_diag ↥(KummerField2 K h₁ h₂ hk) (zL2 K h₁ h₂ hk)
    (zL2_isPrimitiveRoot K h₁ h₂ hk)) i

/-- The diagonal automorphism, as a `K`-algebra automorphism of `M`. -/
def AM2_sigmaK (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5) :
    ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk :=
  (AM2_sigma D hD h₁ h₂ hk).restrictScalars K

theorem AM2_sigmaK_apply (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (x : ML2 D h₁ h₂ hk) :
    AM2_sigmaK D hD h₁ h₂ hk x = AM2_sigma D hD h₁ h₂ hk x := rfl

theorem AM2_sigmaK_kleinCoord (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (i : Fin 5) :
    AM2_sigmaK D hD h₁ h₂ hk
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) =
      (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (zL2 K h₁ h₂ hk)) ^ (i : ℕ) *
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) := by
  rw [AM2_sigmaK_apply]
  exact AM2_sigma_kleinCoord D hD h₁ h₂ hk i

/-- The coefficient action of `Aut_K(L)` on `M = L(E)`. -/
def AM2_coeffAut (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk :=
  Classical.choose (coeffAlgEquiv K D.E ↥(KummerField2 K h₁ h₂ hk) γ)

theorem AM2_coeffAut_spec (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    (∀ l : ↥(KummerField2 K h₁ h₂ hk),
        AM2_coeffAut D hD h₁ h₂ hk γ
            (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l) =
          algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (γ l)) ∧
      AM2_coeffAut D hD h₁ h₂ hk γ
          (Work.MotV.genX (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))) =
        Work.MotV.genX (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk)) ∧
      AM2_coeffAut D hD h₁ h₂ hk γ
          (Work.MotV.genY (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk))) =
        Work.MotV.genY (D.E.baseChange ↥(KummerField2 K h₁ h₂ hk)) :=
  Classical.choose_spec (coeffAlgEquiv K D.E ↥(KummerField2 K h₁ h₂ hk) γ)

theorem AM2_coeffAut_kleinBas (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) (m : Fin 5) :
    AM2_coeffAut D hD h₁ h₂ hk γ (Work.MotV.kleinBas D ↥(KummerField2 K h₁ h₂ hk) m) =
      Work.MotV.kleinBas D ↥(KummerField2 K h₁ h₂ hk) m := by
  rw [Work.MotV.kleinBas]
  fin_cases m <;>
    simp only [Matrix.cons_val_zero, Matrix.cons_val_succ, Matrix.head_cons, Matrix.tail_cons,
      Fin.isValue, Fin.succ_zero_eq_one, Fin.reduceFinMk, Matrix.cons_val_fin_one]
  · simp
  · exact (AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.1
  · exact (AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.2
  · simp [(AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.1]
  · simp [(AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.1, (AM2_coeffAut_spec D hD h₁ h₂ hk γ).2.2]

theorem AM2_coeffAut_kleinCoord (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) (i : Fin 5) :
    AM2_coeffAut D hD h₁ h₂ hk γ
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i) =
      Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i := by
  conv_lhs => rw [Work.MotV.kleinCoord_eq_sum]
  conv_rhs => rw [Work.MotV.kleinCoord_eq_sum]
  simp only [map_sum, map_mul]
  refine Finset.sum_congr rfl fun m _ => ?_
  congr 1
  · rw [(AM2_coeffAut_spec D hD h₁ h₂ hk γ).1, γ.commutes (D.coord i m)]
  · exact AM2_coeffAut_kleinBas D hD h₁ h₂ hk γ m

theorem AM2_coeffAut_yM (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk))
    (w : ↥(KummerField2 K h₁ h₂ hk)) (i : Fin 5) :
    AM2_coeffAut D hD h₁ h₂ hk γ (AM2_yM D h₁ h₂ hk w i) =
      (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (γ w))⁻¹ ^ (i : ℕ) *
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) := by
  rw [AM2_yM]
  simp only [map_mul, map_inv₀, map_pow, map_div₀]
  rw [(AM2_coeffAut_spec D hD h₁ h₂ hk γ).1]
  simp only [AM2_coeffAut_kleinCoord D hD h₁ h₂ hk γ]

/-! ## §2 The Kummer cocycle of `w` and the twisted action -/

/-- `c(γ) = γ(w)/w`, the Kummer cocycle of the fifth root `w` of the twist parameter. -/
def AM2_cK (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (w : ↥(KummerField2 K h₁ h₂ hk))
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    ↥(KummerField2 K h₁ h₂ hk) :=
  γ w / w

theorem AM2_cK_pow_five (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    (AM2_cK D hD h₁ h₂ hk w γ) ^ 5 = 1 := by
  have hne : algebraMap K ↥(KummerField2 K h₁ h₂ hk) h ≠ 0 := fun h0 =>
    hh ((algebraMap K ↥(KummerField2 K h₁ h₂ hk)).injective (by rw [h0, map_zero]))
  have hγ : (γ w) ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h := by
    rw [← map_pow, hw]
    exact γ.commutes h
  rw [AM2_cK, div_pow, hγ, hw, div_self hne]

/-- The exponent `m` with `ζ ^ m = c(γ)`. -/
def AM2_mK (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) : ℕ :=
  Classical.choose
    (IsPrimitiveRoot.eq_pow_of_pow_eq_one (zL2_isPrimitiveRoot K h₁ h₂ hk)
      (AM2_cK_pow_five D hD h₁ h₂ hk h hh w hw γ))

theorem AM2_zL_pow_mK (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    (zL2 K h₁ h₂ hk) ^ (AM2_mK D hD h₁ h₂ hk h hh w hw γ) =
      AM2_cK D hD h₁ h₂ hk w γ :=
  (Classical.choose_spec
    (IsPrimitiveRoot.eq_pow_of_pow_eq_one (zL2_isPrimitiveRoot K h₁ h₂ hk)
      (AM2_cK_pow_five D hD h₁ h₂ hk h hh w hw γ))).2

/-- **The twisted action** `γ ↦ τ_{c(γ)} ∘ γ̃` of `Aut_K(L)` on `M = L(E)`. -/
def AM2_rhoFun (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk :=
  (AM2_sigmaK D hD h₁ h₂ hk) ^ (AM2_mK D hD h₁ h₂ hk h hh w hw γ) *
    AM2_coeffAut D hD h₁ h₂ hk γ

theorem AM2_sigmaK_pow_algebraMap (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (m : ℕ) (l : ↥(KummerField2 K h₁ h₂ hk)) :
    ((AM2_sigmaK D hD h₁ h₂ hk) ^ m)
        (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l) =
      algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, AlgEquiv.mul_apply, AM2_sigmaK_apply, (AM2_sigma D hD h₁ h₂ hk).commutes l, ih]

theorem AM2_sigmaK_pow_ratio (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (m : ℕ) (i : Fin 5) :
    ((AM2_sigmaK D hD h₁ h₂ hk) ^ m)
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) =
      (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (zL2 K h₁ h₂ hk)) ^
          ((i : ℕ) * m) *
        (Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) i /
          Work.MotV.kleinCoord D ↥(KummerField2 K h₁ h₂ hk) 0) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, AlgEquiv.mul_apply, AM2_sigmaK_kleinCoord D hD h₁ h₂ hk i, map_mul, map_pow,
      AM2_sigmaK_pow_algebraMap D hD h₁ h₂ hk m (zL2 K h₁ h₂ hk), ih, ← mul_assoc, ← pow_add,
      Nat.mul_succ, Nat.add_comm]

theorem AM2_rhoFun_algebraMap (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk))
    (l : ↥(KummerField2 K h₁ h₂ hk)) :
    AM2_rhoFun D hD h₁ h₂ hk h hh w hw γ
        (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l) =
      algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (γ l) := by
  rw [AM2_rhoFun, AlgEquiv.mul_apply, (AM2_coeffAut_spec D hD h₁ h₂ hk γ).1]
  exact AM2_sigmaK_pow_algebraMap D hD h₁ h₂ hk _ _

theorem AM2_rhoFun_yM (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) (i : Fin 5) :
    AM2_rhoFun D hD h₁ h₂ hk h hh w hw γ (AM2_yM D h₁ h₂ hk w i) =
      AM2_yM D h₁ h₂ hk w i := by
  have hw0 : w ≠ 0 := by
    intro h0
    have h5 : w ^ 5 = 0 := by rw [h0]; exact zero_pow (by norm_num)
    rw [hw] at h5
    exact hh ((algebraMap K ↥(KummerField2 K h₁ h₂ hk)).injective (by rw [h5, map_zero]))
  have hγw0 : γ w ≠ 0 := by
    intro h0
    refine hw0 ?_
    have h1 := congrArg (fun z => γ.symm z) h0
    rwa [AlgEquiv.symm_apply_apply, map_zero] at h1
  have hkeyL : (γ w)⁻¹ ^ (i : ℕ) *
      (zL2 K h₁ h₂ hk) ^ ((i : ℕ) * AM2_mK D hD h₁ h₂ hk h hh w hw γ) = w⁻¹ ^ (i : ℕ) := by
    have hc := AM2_zL_pow_mK D hD h₁ h₂ hk h hh w hw γ
    rw [AM2_cK] at hc
    rw [mul_comm (i : ℕ) (AM2_mK D hD h₁ h₂ hk h hh w hw γ), pow_mul, hc, div_pow, div_eq_mul_inv,
      inv_pow, inv_pow, ← mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hγw0), one_mul]
  have hkey : (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (γ w))⁻¹ ^ (i : ℕ) *
      (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) (zL2 K h₁ h₂ hk)) ^
          ((i : ℕ) * AM2_mK D hD h₁ h₂ hk h hh w hw γ) =
      (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) w)⁻¹ ^ (i : ℕ) := by
    have h := congrArg (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)) hkeyL
    simpa only [map_mul, map_pow, map_inv₀] using h
  rw [AM2_rhoFun, AlgEquiv.mul_apply, AM2_coeffAut_yM, AM2_yM, map_mul, map_pow, map_inv₀,
    AM2_sigmaK_pow_algebraMap D hD h₁ h₂ hk (AM2_mK D hD h₁ h₂ hk h hh w hw γ) (γ w),
    AM2_sigmaK_pow_ratio D hD h₁ h₂ hk (AM2_mK D hD h₁ h₂ hk h hh w hw γ) i, ← mul_assoc, hkey]

/-! ## §3 Generation, uniqueness, and the twisted action as a group homomorphism -/

theorem AM2_adjoin_union_eq_sup (D : Work.MotV.KleinData K) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (S T : Set (ML2 D h₁ h₂ hk)) :
    IntermediateField.adjoin K (S ∪ T) =
      IntermediateField.adjoin K S ⊔ IntermediateField.adjoin K T := by
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro x (hx | hx)
    · exact (le_sup_left : IntermediateField.adjoin K S ≤ _) (IntermediateField.subset_adjoin K _ hx)
    · exact (le_sup_right : IntermediateField.adjoin K T ≤ _) (IntermediateField.subset_adjoin K _ hx)
  · refine sup_le ?_ ?_
    · rw [IntermediateField.adjoin_le_iff]
      intro x hx
      exact IntermediateField.subset_adjoin K _ (Or.inl hx)
    · rw [IntermediateField.adjoin_le_iff]
      intro x hx
      exact IntermediateField.subset_adjoin K _ (Or.inr hx)

theorem AM2_fieldRange_eq_adjoin (D : Work.MotV.KleinData K) (h₁ h₂ : K) (hk : ringChar K ≠ 5) :
    (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)).fieldRange =
      IntermediateField.adjoin K
        (Set.range (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk))) := by
  refine le_antisymm ?_ ?_
  · intro x hx
    rw [AlgHom.mem_fieldRange] at hx
    obtain ⟨l, rfl⟩ := hx
    exact IntermediateField.subset_adjoin K _ ⟨l, (IsScalarTower.toAlgHom_apply K _ _ l).symm⟩
  · rw [IntermediateField.adjoin_le_iff]
    rintro x ⟨l, rfl⟩
    exact AlgHom.mem_fieldRange.mpr ⟨l, rfl⟩

/-- `M = L(y_i)`: the twisted coordinates together with the constants generate `M`. -/
theorem AM2_hgen (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    IntermediateField.adjoin K
        (Set.range (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)) ∪
          Set.range (AM2_yM D h₁ h₂ hk w)) = ⊤ := by
  have htw := twistField_generate (D := D) (hD := hD) (h := h) (hh := hh) (w := w) (hw := hw)
  rw [AM2_adjoin_union_eq_sup, ← AM2_fieldRange_eq_adjoin, sup_comm]
  exact htw

theorem AM2_le_fixedField_zpowers (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (v : ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk) {S : Set (ML2 D h₁ h₂ hk)}
    (hS : ∀ s ∈ S, v s = s) :
    IntermediateField.adjoin K S ≤ IntermediateField.fixedField (Subgroup.zpowers v) := by
  rw [IntermediateField.adjoin_le_iff]
  intro s hs
  refine (IntermediateField.mem_fixedField_iff (Subgroup.zpowers v) s).mpr ?_
  intro f hf
  have hstab : Subgroup.zpowers v ≤ MulAction.stabilizer (ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk) s :=
    Subgroup.zpowers_le.mpr ((MulAction.mem_stabilizer_iff).mpr (hS s hs))
  exact (MulAction.mem_stabilizer_iff).mp (hstab hf)

/-- Two `K`-algebra automorphisms of `M` agreeing on the constants `L` and on the twisted
coordinates of `w` are equal. -/
theorem AM2_algEquiv_ext (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (f g : ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk)
    (hL : ∀ l : ↥(KummerField2 K h₁ h₂ hk),
      f (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l) =
        g (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk) l))
    (hy : ∀ i, f (AM2_yM D h₁ h₂ hk w i) = g (AM2_yM D h₁ h₂ hk w i)) : f = g := by
  have hS : ∀ s ∈ (Set.range (algebraMap ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)) ∪
      Set.range (AM2_yM D h₁ h₂ hk w)), (g⁻¹ * f) s = s := by
    rintro s (⟨l, rfl⟩ | ⟨i, rfl⟩)
    · rw [AlgEquiv.mul_apply, hL l]
      exact g.symm_apply_apply _
    · rw [AlgEquiv.mul_apply, hy i]
      exact g.symm_apply_apply _
  have htop := AM2_le_fixedField_zpowers D hD h₁ h₂ hk h hh w hw (g⁻¹ * f) hS
  rw [AM2_hgen D hD h₁ h₂ hk h hh w hw] at htop
  ext x
  have hx : (g⁻¹ * f) x = x :=
    (IntermediateField.mem_fixedField_iff _ x).mp (htop trivial) _
      (Subgroup.mem_zpowers (g⁻¹ * f))
  calc f x = g (g⁻¹ (f x)) := (AlgEquiv.apply_symm_apply g (f x)).symm
    _ = g ((g⁻¹ * f) x) := by rw [AlgEquiv.mul_apply]
    _ = g x := by rw [hx]

theorem AM2_rhoFun_one (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    AM2_rhoFun D hD h₁ h₂ hk h hh w hw 1 = 1 := by
  refine AM2_algEquiv_ext D hD h₁ h₂ hk h hh w hw _ _ (fun l => ?_) (fun i => ?_)
  · rw [AM2_rhoFun_algebraMap]
    simp
  · rw [AM2_rhoFun_yM]
    simp

theorem AM2_rhoFun_mul (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h)
    (γ δ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)) :
    AM2_rhoFun D hD h₁ h₂ hk h hh w hw (γ * δ) =
      AM2_rhoFun D hD h₁ h₂ hk h hh w hw γ * AM2_rhoFun D hD h₁ h₂ hk h hh w hw δ := by
  refine AM2_algEquiv_ext D hD h₁ h₂ hk h hh w hw _ _ (fun l => ?_) (fun i => ?_)
  · rw [AlgEquiv.mul_apply, AM2_rhoFun_algebraMap, AM2_rhoFun_algebraMap, AM2_rhoFun_algebraMap,
      AlgEquiv.mul_apply]
  · rw [AlgEquiv.mul_apply, AM2_rhoFun_yM, AM2_rhoFun_yM, AM2_rhoFun_yM]

/-- The twisted action as a group homomorphism `Gal(L/K) → Aut_K(M)`. -/
def AM2_rho (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    ↥(⊤ : Subgroup (↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk))) →*
      (ML2 D h₁ h₂ hk ≃ₐ[K] ML2 D h₁ h₂ hk) where
  toFun γ := AM2_rhoFun D hD h₁ h₂ hk h hh w hw (γ : _)
  map_one' := AM2_rhoFun_one D hD h₁ h₂ hk h hh w hw
  map_mul' γ δ := AM2_rhoFun_mul D hD h₁ h₂ hk h hh w hw _ _

/-! ## §4 The descent -/

theorem AM2_hfix (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5) :
    ∀ l : ↥(KummerField2 K h₁ h₂ hk),
      (∀ γ : ↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk), γ l = l) →
      ∃ c : K, algebraMap K ↥(KummerField2 K h₁ h₂ hk) c = l := by
  haveI : FiniteDimensional K ↥(KummerField2 K h₁ h₂ hk) :=
    (isGalois_KummerField2 K h₁ h₂ hk).1
  haveI : IsGalois K ↥(KummerField2 K h₁ h₂ hk) :=
    (isGalois_KummerField2 K h₁ h₂ hk).2
  intro l hl
  refine IntermediateField.mem_bot.mp ((IsGalois.mem_bot_iff_fixed l).mpr ?_)
  intro f
  exact hl f

theorem AM2_fixedField_descent_rho (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    (IntermediateField.fixedField (AM2_rho D hD h₁ h₂ hk h hh w hw).range).LinearDisjoint
        ↥(KummerField2 K h₁ h₂ hk) ∧
      IntermediateField.fixedField (AM2_rho D hD h₁ h₂ hk h hh w hw).range ⊔
        (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)).fieldRange =
        ⊤ := by
  classical
  haveI : FiniteDimensional K ↥(KummerField2 K h₁ h₂ hk) :=
    (isGalois_KummerField2 K h₁ h₂ hk).1
  haveI : IsGalois K ↥(KummerField2 K h₁ h₂ hk) :=
    (isGalois_KummerField2 K h₁ h₂ hk).2
  haveI : Fintype ↥(⊤ : Subgroup (↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K]
      ↥(KummerField2 K h₁ h₂ hk))) := Subtype.fintype _
  exact fixedField_descent_finite (𝕜 := K) (L := ↥(KummerField2 K h₁ h₂ hk))
    (M := ML2 D h₁ h₂ hk)
    (⊤ : Subgroup (↥(KummerField2 K h₁ h₂ hk) ≃ₐ[K] ↥(KummerField2 K h₁ h₂ hk)))
    (fun l hl => AM2_hfix D hD h₁ h₂ hk l (fun γ => hl ⟨γ, Subgroup.mem_top γ⟩))
    (AM2_rho D hD h₁ h₂ hk h hh w hw)
    (fun γ l => AM2_rhoFun_algebraMap D hD h₁ h₂ hk h hh w hw (γ : _) l)

theorem AM2_le_fixedField (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    IntermediateField.adjoin K (Set.range (AM2_yM D h₁ h₂ hk w)) ≤
      IntermediateField.fixedField (AM2_rho D hD h₁ h₂ hk h hh w hw).range := by
  rw [IntermediateField.adjoin_le_iff]
  rintro x ⟨i, rfl⟩
  refine (IntermediateField.mem_fixedField_iff (AM2_rho D hD h₁ h₂ hk h hh w hw).range _).mpr ?_
  intro f hf
  obtain ⟨γ, rfl⟩ := MonoidHom.mem_range.mp hf
  exact AM2_rhoFun_yM D hD h₁ h₂ hk h hh w hw (γ : _) i

theorem AM2_linearDisjoint (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    (IntermediateField.adjoin K (Set.range (AM2_yM D h₁ h₂ hk w))).LinearDisjoint
      ↥(KummerField2 K h₁ h₂ hk) :=
  IntermediateField.LinearDisjoint.of_le_left
    (AM2_fixedField_descent_rho D hD h₁ h₂ hk h hh w hw).1
    (AM2_le_fixedField D hD h₁ h₂ hk h hh w hw)

theorem AM2_sup_eq_top (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K)
    (hk : ringChar K ≠ 5) (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    IntermediateField.adjoin K (Set.range (AM2_yM D h₁ h₂ hk w)) ⊔
      (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)).fieldRange =
      ⊤ :=
  twistField_generate (D := D) (hD := hD) (h := h) (hh := hh) (w := w) (hw := hw)

/-- **The two-root descent, for a general fifth root `w` of the twist parameter.** -/
theorem AM2_key (D : Work.MotV.KleinData K) (hD : D.Good) (h₁ h₂ : K) (hk : ringChar K ≠ 5)
    (h : K) (hh : h ≠ 0) (w : ↥(KummerField2 K h₁ h₂ hk))
    (hw : w ^ 5 = algebraMap K ↥(KummerField2 K h₁ h₂ hk) h) :
    (IntermediateField.adjoin K (Set.range (AM2_yM D h₁ h₂ hk w))).LinearDisjoint
        ↥(KummerField2 K h₁ h₂ hk) ∧
      IntermediateField.adjoin K (Set.range (AM2_yM D h₁ h₂ hk w)) ⊔
        (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)).fieldRange =
        ⊤ :=
  ⟨AM2_linearDisjoint D hD h₁ h₂ hk h hh w hw, AM2_sup_eq_top D hD h₁ h₂ hk h hh w hw⟩

end

theorem AM2_descent {K : Type} [Field K] (D : Work.MotV.KleinData K) (hD : D.Good) {h₁ h₂ : K}
    (h₁0 : h₁ ≠ 0) (h₂0 : h₂ ≠ 0) (hk : ringChar K ≠ 5) :
    ((AM21 D h₁ h₂ hk).LinearDisjoint ↥(KummerField2 K h₁ h₂ hk) ∧
        AM21 D h₁ h₂ hk ⊔
          (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)).fieldRange = ⊤) ∧
      ((AM22 D h₁ h₂ hk).LinearDisjoint ↥(KummerField2 K h₁ h₂ hk) ∧
        AM22 D h₁ h₂ hk ⊔
          (IsScalarTower.toAlgHom K ↥(KummerField2 K h₁ h₂ hk) (ML2 D h₁ h₂ hk)).fieldRange = ⊤) := by
  have h1 := AM2_key D hD h₁ h₂ hk h₁ h₁0 (wL1 K h₁ h₂ hk) (wL1_pow_five K h₁ h₂ hk)
  have h2 := AM2_key D hD h₁ h₂ hk h₂ h₂0 (wL2 K h₁ h₂ hk) (wL2_pow_five K h₁ h₂ hk)
  exact ⟨h1, h2⟩

end Work.MotT
