open IsLocalRing

/-- **Integral elements of the valuation ring have value `≤ 1`** (no finiteness hypothesis): every
element of the integral closure of `v.valuationSubring` in `L` has `w`-value `≤ 1`, because the
valuation ring of `w` is integrally closed in `L` and contains the image of `v.valuationSubring`. -/
theorem integralClosure_le_valuationSubring' {F L : Type*} [Field F] [Field L] [Algebra F L]
    (v : Valuation F (WithZero (Multiplicative ℤ)))
    (w : Valuation L (WithZero (Multiplicative ℤ)))
    (hsub : ∀ x : F, w (algebraMap F L x) ≤ 1 ↔ v x ≤ 1) :
    (integralClosure ↥(v.valuationSubring) L).toSubring ≤ w.valuationSubring.toSubring := by
  haveI : IsIntegrallyClosedIn w.valuationSubring.toSubring L :=
    inferInstanceAs (IsIntegrallyClosedIn w.valuationSubring L)
  rw [Subring.integralClosure_le_iff]
  intro r
  show w (algebraMap ↥(v.valuationSubring) L r) ≤ 1
  rw [IsScalarTower.algebraMap_apply ↥(v.valuationSubring) F L]
  exact (hsub (r : F)).mpr r.2

/-- **Transfer of "`m_A` generates the maximal ideal" between two localizations.**

Let `A → B` be a ring extension, `P` a prime of `B`, and `S`, `Q` two localizations of `B` at
`P` (e.g. `Localization.AtPrime P` and the subalgebra `B[Pᶜ]` of a fraction field).  If the
maximal ideal of `S` is generated by the image of an ideal `p ⊆ A`, then the same holds in `Q`. -/
theorem map_maximalIdeal_eq_of_atPrime {A B S Q : Type*} [CommRing A] [CommRing B] [CommRing S]
    [CommRing Q] [Algebra A B] [Algebra B S] [Algebra B Q] [Algebra A S] [IsScalarTower A B S]
    (P : Ideal B) [P.IsPrime]
    [IsLocalization.AtPrime S P] [IsLocalization.AtPrime Q P] [IsLocalRing S] [IsLocalRing Q]
    (p : Ideal A) (h : Ideal.map (algebraMap A S) p = IsLocalRing.maximalIdeal S) :
    Ideal.map ((algebraMap B Q).comp (algebraMap A B)) p = Ideal.map (algebraMap B Q) P := by
  let e : S ≃ₐ[B] Q := IsLocalization.algEquiv P.primeCompl S Q
  have h1 : Ideal.map (algebraMap B Q) P = IsLocalRing.maximalIdeal Q :=
    IsLocalization.AtPrime.map_eq_maximalIdeal P Q
  have h2 : Ideal.map (e : S →+* Q) (IsLocalRing.maximalIdeal S) = IsLocalRing.maximalIdeal Q :=
    IsLocalRing.map_ringEquiv_maximalIdeal (e : S ≃+* Q)
  have hcompA : (e : S →+* Q).comp (algebraMap A S) = (algebraMap B Q).comp (algebraMap A B) := by
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply, IsScalarTower.algebraMap_apply A B S]
    exact e.commutes (algebraMap A B a)
  calc Ideal.map ((algebraMap B Q).comp (algebraMap A B)) p
      = Ideal.map ((e : S →+* Q).comp (algebraMap A S)) p := by rw [← hcompA]
    _ = Ideal.map (e : S →+* Q) (Ideal.map (algebraMap A S) p) := (Ideal.map_map _ _).symm
    _ = Ideal.map (e : S →+* Q) (IsLocalRing.maximalIdeal S) := by rw [h]
    _ = IsLocalRing.maximalIdeal Q := h2
    _ = Ideal.map (algebraMap B Q) P := h1.symm

/-- **Values on an ideal generated by `φ`-images of `m` are dominated by the gauge `W`.**

Let `w` be a valuation of a field `L`, `ι : Q →+* L` a ring hom whose image lies in the unit ball
`{y | w y ≤ 1}`, `φ : A →+* Q` a ring hom and `m ⊆ A` an ideal.  If the gauge `W : A → Γ`
dominates the values of the `φ`-images of the elements of `m` (and is nonnegative at `0`), then
every element of the ideal generated by `φ '' m` in `Q` has `w`-value dominated by `W a` for some
`a ∈ m`. -/
theorem exists_le_of_mem_ideal_map {Γ L A Q : Type*} [Field L] [CommRing A] [CommRing Q]
    [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (ι : Q →+* L) (φ : A →+* Q)
    (m : Ideal A) (W : A → Γ) (hQ : ∀ y : Q, w (ι y) ≤ 1) (hW0 : (0 : Γ) ≤ W 0)
    (hW : ∀ a : A, w (ι (φ a)) ≤ W a) :
    ∀ y ∈ Ideal.map φ m, ∃ a ∈ m, w (ι y) ≤ W a := by
  intro y hy
  revert hy
  refine Submodule.span_induction (p := fun x _ => ∃ a ∈ m, w (ι x) ≤ W a) ?_ ?_ ?_ ?_
  · rintro x ⟨a, ha, rfl⟩
    exact ⟨a, ha, hW a⟩
  · exact ⟨0, m.zero_mem, by simpa using hW0⟩
  · rintro x y _ _ ⟨a, ha, hxa⟩ ⟨b, hb, hyb⟩
    rcases le_total (W a) (W b) with h | h
    · refine ⟨b, hb, ?_⟩
      rw [map_add]
      exact le_trans (le_trans (Valuation.map_add w (ι x) (ι y)) (max_le_max hxa hyb))
        (le_of_eq (max_eq_right h))
    · refine ⟨a, ha, ?_⟩
      rw [map_add]
      exact le_trans (le_trans (Valuation.map_add w (ι x) (ι y)) (max_le_max hxa hyb))
        (le_of_eq (max_eq_left h))
  · rintro c x _ ⟨a, ha, hxa⟩
    refine ⟨a, ha, ?_⟩
    show w (ι (c * x)) ≤ W a
    rw [map_mul, Valuation.map_mul]
    calc w (ι c) * w (ι x) ≤ 1 * w (ι x) := mul_le_mul_of_nonneg_right (hQ c) zero_le
      _ = w (ι x) := one_mul _
      _ ≤ W a := hxa

/-- Ramification index `1` computes the value group: if the prime `P` of the integral closure of
the valuation ring of `v` in `L` has `P.ramificationIdx = 1` (equivalently `m_A · O_w = m_w`, where
`O_w` is the valuation ring of `w`, identified with the localization of the integral closure at `P`
by `hbridge`), then every element of `L` of `w`-value `< 1` is dominated by an element of the
subfield `F` of value `< 1`. -/
theorem localPole_of_ramificationIdx_eq_one {F L : Type*} [Field F] [Field L] [Algebra F L]
    (v : Valuation F (WithZero (Multiplicative ℤ)))
    (w : Valuation L (WithZero (Multiplicative ℤ)))
    (hsub : ∀ x : F, w (algebraMap F L x) ≤ 1 ↔ v x ≤ 1)
    (P : Ideal ↥(integralClosure ↥(v.valuationSubring) L)) [P.IsPrime]
    [P.LiesOver (IsLocalRing.maximalIdeal ↥(v.valuationSubring))]
    (hP : P.primeCompl ≤ nonZeroDivisors ↥(integralClosure ↥(v.valuationSubring) L))
    [IsFractionRing ↥(integralClosure ↥(v.valuationSubring) L) L]
    (hbridge : w.valuationSubring.toSubring
      = (Localization.subalgebra.ofField L P.primeCompl hP).toSubring)
    (hram : P.ramificationIdx ↥(v.valuationSubring) = 1) :
    ∀ x : L, w x < 1 →
      ∃ a : F, w (algebraMap F L a) < 1 ∧ w x ≤ w (algebraMap F L a) := by
  classical
  -- the local ring structure on the localization `B[Pᶜ] ⊆ L`
  haveI hQloc : IsLocalRing ↥(Localization.subalgebra.ofField L P.primeCompl hP) :=
    IsLocalization.AtPrime.isLocalRing ↥(Localization.subalgebra.ofField L P.primeCompl hP) P
  -- every element of `B[Pᶜ]` lies in the valuation ring of `w`
  have hQle : ∀ y : ↥(Localization.subalgebra.ofField L P.primeCompl hP),
      w (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L y) ≤ 1 := by
    intro y
    have hyV : algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L y
        ∈ (Localization.subalgebra.ofField L P.primeCompl hP).toSubring :=
      Subalgebra.mem_toSubring.mpr y.2
    have hyW : algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L y
        ∈ w.valuationSubring.toSubring := by
      rw [hbridge]; exact hyV
    exact (Valuation.mem_valuationSubring_iff w _).mp
      ((ValuationSubring.mem_toSubring w.valuationSubring _).mp hyW)
  -- the maximal ideal of the localization is the image of `P`
  have hQmax : Ideal.map (algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
      ↥(Localization.subalgebra.ofField L P.primeCompl hP)) P
      = IsLocalRing.maximalIdeal ↥(Localization.subalgebra.ofField L P.primeCompl hP) :=
    IsLocalization.AtPrime.map_eq_maximalIdeal P
      ↥(Localization.subalgebra.ofField L P.primeCompl hP)
  -- ramification index `1` identifies the two maximal ideals
  have hmaxS : Ideal.map (algebraMap ↥(v.valuationSubring) (Localization.AtPrime P))
      (IsLocalRing.maximalIdeal ↥(v.valuationSubring))
      = IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
    Work.MotV5.Nodes.UEPR.map_maximalIdeal_eq_of_ramificationIdx_eq_one
      (IsLocalRing.maximalIdeal ↥(v.valuationSubring)) P hram
  have hmap : Ideal.map ((algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
        ↥(Localization.subalgebra.ofField L P.primeCompl hP)).comp
        (algebraMap ↥(v.valuationSubring) ↥(integralClosure ↥(v.valuationSubring) L)))
      (IsLocalRing.maximalIdeal ↥(v.valuationSubring))
      = Ideal.map (algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
        ↥(Localization.subalgebra.ofField L P.primeCompl hP)) P :=
    map_maximalIdeal_eq_of_atPrime (A := ↥(v.valuationSubring))
      (B := ↥(integralClosure ↥(v.valuationSubring) L))
      (S := Localization.AtPrime P)
      (Q := ↥(Localization.subalgebra.ofField L P.primeCompl hP)) P
      (p := IsLocalRing.maximalIdeal ↥(v.valuationSubring)) hmaxS
  -- the gauge on the base valuation ring
  have hW : ∀ a : ↥(v.valuationSubring),
      w (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L
        (algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
          ↥(Localization.subalgebra.ofField L P.primeCompl hP)
          (algebraMap ↥(v.valuationSubring) ↥(integralClosure ↥(v.valuationSubring) L) a)))
      ≤ w (algebraMap F L (a : F)) := by
    intro a
    have h1 : algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L
        (algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
          ↥(Localization.subalgebra.ofField L P.primeCompl hP)
          (algebraMap ↥(v.valuationSubring) ↥(integralClosure ↥(v.valuationSubring) L) a))
        = algebraMap ↥(v.valuationSubring) L a :=
      (IsScalarTower.algebraMap_apply ↥(integralClosure ↥(v.valuationSubring) L)
          ↥(Localization.subalgebra.ofField L P.primeCompl hP) L
          (algebraMap ↥(v.valuationSubring) ↥(integralClosure ↥(v.valuationSubring) L) a)).trans
        (IsScalarTower.algebraMap_apply ↥(v.valuationSubring)
          ↥(integralClosure ↥(v.valuationSubring) L) L a)
    have h2 : algebraMap ↥(v.valuationSubring) L a = algebraMap F L (a : F) :=
      (IsScalarTower.algebraMap_apply ↥(v.valuationSubring) F L a).symm
    exact le_of_eq (congrArg w (h1.trans h2))
  intro x hx
  -- `x` lies in the localization
  have hxV : x ∈ Localization.subalgebra.ofField L P.primeCompl hP := by
    rw [← Subalgebra.mem_toSubring, ← hbridge]
    exact (ValuationSubring.mem_toSubring w.valuationSubring x).mpr
      ((Valuation.mem_valuationSubring_iff w x).mpr (le_of_lt hx))
  -- and its class is a nonunit of the local ring `B[Pᶜ]`
  have hxQmax : (⟨x, hxV⟩ : ↥(Localization.subalgebra.ofField L P.primeCompl hP))
      ∈ IsLocalRing.maximalIdeal ↥(Localization.subalgebra.ofField L P.primeCompl hP) := by
    rintro ⟨u, hu⟩
    have hxu : (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L) (u :
        ↥(Localization.subalgebra.ofField L P.primeCompl hP)) = x := by
      rw [hu]
      simp
    have huinv_le : w (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L
        ((u⁻¹ : (↥(Localization.subalgebra.ofField L P.primeCompl hP))ˣ) :
          ↥(Localization.subalgebra.ofField L P.primeCompl hP))) ≤ 1 := hQle _
    have hmul : w x * w (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L
        ((u⁻¹ : (↥(Localization.subalgebra.ofField L P.primeCompl hP))ˣ) :
          ↥(Localization.subalgebra.ofField L P.primeCompl hP))) = 1 := by
      have h1 : (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L)
          ((u : ↥(Localization.subalgebra.ofField L P.primeCompl hP)) *
            ((u⁻¹ : (↥(Localization.subalgebra.ofField L P.primeCompl hP))ˣ) :
              ↥(Localization.subalgebra.ofField L P.primeCompl hP)))
          = (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L) 1 := by
        rw [show (u : ↥(Localization.subalgebra.ofField L P.primeCompl hP)) *
            ((u⁻¹ : (↥(Localization.subalgebra.ofField L P.primeCompl hP))ˣ) :
              ↥(Localization.subalgebra.ofField L P.primeCompl hP)) = 1 by simp]
      rw [map_mul, map_one] at h1
      rw [← Valuation.map_mul, ← hxu, h1, Valuation.map_one]
    have hlt : w x * w (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L
        ((u⁻¹ : (↥(Localization.subalgebra.ofField L P.primeCompl hP))ˣ) :
          ↥(Localization.subalgebra.ofField L P.primeCompl hP))) < 1 :=
      lt_of_le_of_lt (mul_le_of_le_one_right zero_le huinv_le) hx
    rw [hmul] at hlt
    exact lt_irrefl 1 hlt
  -- so it lies in the ideal generated by `m_A`
  have hxkey : (⟨x, hxV⟩ : ↥(Localization.subalgebra.ofField L P.primeCompl hP)) ∈
      Ideal.map ((algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
          ↥(Localization.subalgebra.ofField L P.primeCompl hP)).comp
          (algebraMap ↥(v.valuationSubring) ↥(integralClosure ↥(v.valuationSubring) L)))
        (IsLocalRing.maximalIdeal ↥(v.valuationSubring)) := by
    rw [hmap, hQmax]
    exact hxQmax
  -- apply the key lemma
  obtain ⟨a, ha, hle⟩ := exists_le_of_mem_ideal_map (Γ := WithZero (Multiplicative ℤ))
    (L := L) (A := ↥(v.valuationSubring))
    (Q := ↥(Localization.subalgebra.ofField L P.primeCompl hP))
    w (algebraMap ↥(Localization.subalgebra.ofField L P.primeCompl hP) L)
    ((algebraMap ↥(integralClosure ↥(v.valuationSubring) L)
        ↥(Localization.subalgebra.ofField L P.primeCompl hP)).comp
        (algebraMap ↥(v.valuationSubring) ↥(integralClosure ↥(v.valuationSubring) L)))
    (IsLocalRing.maximalIdeal ↥(v.valuationSubring))
    (fun a : ↥(v.valuationSubring) => w (algebraMap F L (a : F)))
    hQle (by simp) hW ⟨x, hxV⟩ hxkey
  refine ⟨(a : F), ?_, ?_⟩
  · exact (Work.MotV5.Nodes.UEPR.lt_one_iff v w hsub (a : F)).mpr
      ((Valuation.mem_maximalIdeal_iff (v := v)).mp ha)
  · simpa using hle

end Work.MotV5.RigAS.ValuationAux
