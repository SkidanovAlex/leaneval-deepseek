namespace Work.MotV5.RigAS.ValuationAux

open scoped WithZero

/-! ## Auxiliary facts about the exponential and logarithm of `ℤᵐ⁰`

A `ℤᵐ⁰ = WithZero (Multiplicative ℤ)`-valued valuation is most easily manipulated through the
additive logarithm `WithZero.log`, which turns the multiplicative value group into `ℤ`.  The two
lemmas below translate the order conditions `x < 1` and `1 < x` into sign conditions on the
logarithm. -/

private lemma lt_one_iff_log_neg {x : ℤᵐ⁰} (hx : x ≠ 0) : x < 1 ↔ x.log < 0 := by
  rw [← WithZero.exp_lt_one_iff (a := x.log), WithZero.exp_log hx]

private lemma one_lt_iff_log_pos {x : ℤᵐ⁰} (hx : x ≠ 0) : 1 < x ↔ 0 < x.log := by
  rw [← WithZero.one_lt_exp_iff (a := x.log), WithZero.exp_log hx]

/-- If every value `< 1` of a `ℤᐟ⁰`-valued valuation `w` on `L` is dominated by the value of an
element of the subfield `F` (also of value `< 1`), then every value of `w` on `L^×` is the value of
an element of `F^×`.

The hypothesis is the "local value gap" statement; the conclusion is that the value group of `w`
is generated by the values on `F`.  The proof is a strong induction on the `w`-poles: replacing `x`
by `x / a` strictly decreases the "pole order" of the value, so the descent terminates. -/
theorem val_mem_of_localPole {F L : Type*} [Field F] [Field L] [Algebra F L]
    (w : Valuation L (WithZero (Multiplicative ℤ)))
    (hI : ∀ x : L, w x < 1 →
      ∃ a : F, w (algebraMap F L a) < 1 ∧ w x ≤ w (algebraMap F L a)) :
    ∀ x : L, x ≠ 0 → ∃ y : F, y ≠ 0 ∧ w (algebraMap F L y) = w x := by
  -- The logarithm of the valuation turns the multiplicative value group into `ℤ`, so that a pole
  -- `w x < 1` becomes `(w x).log < 0`: the *pole order* is `-(w x).log ∈ ℕ`.
  -- We first settle the descent for poles, by strong induction on the pole order.
  have key : ∀ n : ℕ, ∀ x : L, x ≠ 0 → w x < 1 → -(w x).log = (n : ℤ) →
      ∃ y : F, y ≠ 0 ∧ w (algebraMap F L y) = w x := by
    intro n
    refine Nat.strongRecOn n (fun n ih x hx hlt hlog => ?_)
    obtain ⟨a, ha_lt, hle⟩ := hI x hlt
    have hxA : w x ≠ 0 := (Valuation.ne_zero_iff w).mpr hx
    -- the dominating element `a` cannot be zero, since `w x ≠ 0`
    have hA : w (algebraMap F L a) ≠ 0 := by
      intro h0
      exact hxA (le_antisymm (h0 ▸ hle) zero_le)
    have ha0 : a ≠ 0 := fun h => hA (by rw [h, map_zero, Valuation.map_zero])
    have hA0 : algebraMap F L a ≠ 0 := (Valuation.ne_zero_iff w).mp hA
    rcases eq_or_lt_of_le hle with heq | hlt2
    · -- the value is already attained on `F`
      exact ⟨a, ha0, heq.symm⟩
    · -- otherwise divide by `a`: the pole order strictly decreases
      have hlogx : (w x).log = -(n : ℤ) := by linarith [hlog]
      have hlogA : (w (algebraMap F L a)).log < 0 := (lt_one_iff_log_neg hA).mp ha_lt
      have hloglt : (w x).log < (w (algebraMap F L a)).log :=
        (WithZero.log_lt_log hxA hA).mpr hlt2
      have hx' : x / algebraMap F L a ≠ 0 := div_ne_zero hx hA0
      have hx'v : w (x / algebraMap F L a) ≠ 0 := (Valuation.ne_zero_iff w).mpr hx'
      have hlog' : (w (x / algebraMap F L a)).log =
          (w x).log - (w (algebraMap F L a)).log := by
        rw [Valuation.map_div, WithZero.log_div hxA hA]
      have hneg' : (w (x / algebraMap F L a)).log < 0 := by
        rw [hlog']; linarith
      have hlt' : w (x / algebraMap F L a) < 1 := (lt_one_iff_log_neg hx'v).mpr hneg'
      -- the new pole order `m` is strictly smaller than `n`
      have hpos : (0 : ℤ) < (n : ℤ) + (w (algebraMap F L a)).log := by linarith
      have hltn : (n : ℤ) + (w (algebraMap F L a)).log < (n : ℤ) := by linarith
      obtain ⟨m, hm⟩ : ∃ m : ℕ, (m : ℤ) = (n : ℤ) + (w (algebraMap F L a)).log :=
        ⟨_, Int.toNat_of_nonneg (le_of_lt hpos)⟩
      have hm_lt : m < n := by
        have : (m : ℤ) < (n : ℤ) := by rw [hm]; exact hltn
        omega
      have hlogueq : -(w (x / algebraMap F L a)).log = (m : ℤ) := by
        rw [hlog', hlogx, hm]; ring
      obtain ⟨y', hy'ne, hy'eq⟩ := ih m hm_lt (x / algebraMap F L a) hx' hlt' hlogueq
      refine ⟨y' * a, mul_ne_zero hy'ne ha0, ?_⟩
      rw [map_mul, Valuation.map_mul, hy'eq, ← Valuation.map_mul, div_mul_cancel₀ x hA0]
  -- every element with a pole at `w` is now handled
  have pole : ∀ z : L, z ≠ 0 → w z < 1 → ∃ y : F, y ≠ 0 ∧ w (algebraMap F L y) = w z := by
    intro z hz hlt
    have hz0 : w z ≠ 0 := (Valuation.ne_zero_iff w).mpr hz
    have hneg : (w z).log < 0 := (lt_one_iff_log_neg hz0).mp hlt
    refine key (-(w z).log).toNat z hz hlt ?_
    rw [Int.toNat_of_nonneg (by linarith : (0 : ℤ) ≤ -(w z).log)]
  intro x hx
  rcases lt_trichotomy (w x) 1 with h | h | h
  · exact pole x hx h
  · -- `x` is a unit: the value `1` is attained by `1 ∈ F`
    exact ⟨1, one_ne_zero, by rw [map_one, Valuation.map_one, h]⟩
  · -- `x` is a zero of `w`: apply the pole case to `x⁻¹`
    have hx0 : w x ≠ 0 := ne_of_gt (lt_trans zero_lt_one h)
    have hxlog : 0 < (w x).log := (one_lt_iff_log_pos hx0).mp h
    have hltinv : w x⁻¹ < 1 := by
      refine (lt_one_iff_log_neg ((Valuation.ne_zero_iff w).mpr (inv_ne_zero hx))).mpr ?_
      rw [Valuation.map_inv, WithZero.log_inv]
      linarith
    obtain ⟨y, hy, hyeq⟩ := pole x⁻¹ (inv_ne_zero hx) hltinv
    refine ⟨y⁻¹, inv_ne_zero hy, ?_⟩
    have h1 : algebraMap F L y⁻¹ = (algebraMap F L y)⁻¹ := map_inv₀ (algebraMap F L) y
    rw [h1, Valuation.map_inv, hyeq, Valuation.map_inv, inv_inv]

end Work.MotV5.RigAS.ValuationAux
