namespace Work.MotV5.RigAS

theorem kleinField_le_twistFieldTrue (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5]
    (D : Work.MotV.KleinData 𝕜) (g : RatFunc 𝕜)
    (τ : Work.MotV.Om D ≃ₐ[RatFunc 𝕜] Work.MotV.Om D)
    (σS : Work.MotV.Om D ≃ₐ[Work.MotV.Kb 𝕜] Work.MotV.Om D)
    (σ : Work.MotV.Kb 𝕜 ≃ₐ[RatFunc 𝕜] Work.MotV.Kb 𝕜)
    (h : Work.MotV5.ASTwistData 𝕜 D g τ σS σ)
    {x : Work.MotV.Om D} (hx : x ∈ Work.MotV5.kleinField D) (hfix : σS x = x) :
    x ∈ Work.MotV5.asTwistFieldTrue D g τ σS := by
  -- The twisted action `σ' = asTwistAction D τ σS` fixes `x`: `τ` fixes the geometric part
  -- `K(E) = kleinField D` pointwise (`h.hτk`), and `σS x = x` by hypothesis.
  have hmem : Work.MotV5.asTwistAction D τ σS x = x := by
    simp only [Work.MotV5.asTwistAction, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
    rw [h.hτk x hx, hfix]
  refine ⟨?_, ?_⟩
  · -- `x` lies in the fixed field of the cyclic group generated by `σ'`.
    change x ∈ IntermediateField.fixedField
      (Subgroup.zpowers (Work.MotV5.asTwistAction D τ σS))
    rw [IntermediateField.mem_fixedField_iff]
    intro f hf
    have hzp : Subgroup.zpowers (Work.MotV5.asTwistAction D τ σS) ≤
        MulAction.stabilizer (Work.MotV.Om D ≃ₐ[RatFunc 𝕜] Work.MotV.Om D) x := by
      rw [Subgroup.zpowers_le, MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
      exact hmem
    have hfx : f • x = x := hzp hf
    simpa only [AlgEquiv.smul_def] using hfx
  · -- `K(E) ≤ L(E) = asFieldL D g`.
    exact (le_sup_left : Work.MotV5.kleinField D ≤ _) hx

end Work.MotV5.RigAS
