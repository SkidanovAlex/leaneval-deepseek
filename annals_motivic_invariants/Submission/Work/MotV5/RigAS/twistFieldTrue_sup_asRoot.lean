/-!
# `asTwistFieldTrue ⊔ K(asRoot g) = asFieldL D g`

The corrected Artin–Schreier twist field of the characteristic-`5` branch is
`asTwistFieldTrue D g τ σS = asTwistFieldFix D τ σS ⊓ asFieldL D g`, the fixed field of the twisted
action `A = asTwistAction D τ σS` inside `L(E) = asFieldL D g`.  The present file proves that
together with the Artin–Schreier root it generates all of `L(E)`:

`asTwistFieldTrue D g τ σS ⊔ K(asRoot g) = asFieldL D g`,

the relative version (inside `L(E)`) of the ambient statement `asTwistFieldFix_descent`
(`asTwistFieldFix ⊔ K(asRoot g) = ⊤`).  Note that the ambient statement cannot be used directly:
it needs the artificial hypothesis `(asTwistAction D τ σS)^5 = 1` *on all of* `K̄(E)`, which is
inconsistent with `ASTwistData.hτ` (see the docstring of `ASTwistData`); `ASTwistData` only gives
`A^5 = 1` on the stable subfield `L(E)`.

The proof is pure field theory, with the hypotheses of `ASTwistData` used as follows:

* `A` preserves `L(E)` (`hpres`) and `A^5` acts trivially on it (`h5L`), while `A` is nontrivial
  there (`hneL`);
* the Artin–Schreier root `w = asRoot g` is fixed by `A` up to the shift `A w = w + 1`
  (from `hτ`, `hσ` and the `Kb 𝕜`-linearity of `σS`), so `K⟮w⟯ ⊆ L(E)` is not contained in
  the fixed field of `A`.

Then `M := L(E)^{⟨A⟩}`, and the Artin–Schreier subfield `K⟮w⟯ ⊆ L(E)` is not contained in `M`, so
`M ⊔ K⟮w⟯ = L(E)`: `L(E)/M` has degree the prime `5` by Artin's theorem, applied to the
*restriction* `A|L(E)` of `A` (which is a ring automorphism of `L(E)` of order `5`).
-/

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option linter.style.haveILetI false

namespace Work.MotV5.RigAS

open IntermediateField

/-! ## §1 Two elementary lemmas on group actions -/

section Generic

variable {M X : Type*} [Group M] [MulAction M X]

/-- If a group element fixes `x`, so do all of its integer powers. -/
lemma zpow_smul_eq_self_of_smul_eq_self (f : M) (x : X) (h1 : f • x = x) :
    ∀ n : ℤ, (f ^ n) • x = x := by
  have hnat : ∀ n : ℕ, (f ^ n) • x = x := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ', mul_smul, ih, h1]
  intro n
  rcases Int.eq_nat_or_neg n with ⟨m, hn | hn⟩
  · rw [hn, zpow_natCast]; exact hnat m
  · rw [hn, zpow_neg, zpow_natCast]
    rw [show (f ^ m)⁻¹ • x = (f ^ m)⁻¹ • ((f ^ m) • x) from by rw [hnat m], inv_smul_smul]

/-- `x` is fixed by the cyclic subgroup generated by `f` iff it is fixed by `f`. -/
lemma mem_zpowers_smul_iff (f : M) (x : X) :
    (∀ g ∈ Subgroup.zpowers f, g • x = x) ↔ f • x = x := by
  constructor
  · intro h; exact h f (Subgroup.mem_zpowers f)
  · intro h1 g hg
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    exact zpow_smul_eq_self_of_smul_eq_self f x h1 n

end Generic

/-! ## §2 The restriction of an automorphism to a stable subfield

Everything in this section is pure field theory: `K ⊆ L' ⊆ E` with `L'` stable under the
`K`-automorphism `A` of `E`, such that `A^5` is the identity on `L'`.  We build the restricted
ring automorphism `A|L'` of `L'`, note that it has order `5` when `A` is nontrivial on `L'`, and
identify its fixed points with `L' ∩ E^{⟨A⟩}`. -/

section Restrict

variable {K E : Type*} [Field K] [Field E] [Algebra K E]

/-- The restriction of `A` to the stable intermediate field `L'`, as a ring homomorphism. -/
noncomputable def restrictRingHom (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') : ↥L' →+* ↥L' where
  toFun x := ⟨A x, hpres x x.2⟩
  map_one' := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)

lemma restrictRingHom_apply_coe (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (x : ↥L') :
    ((restrictRingHom L' A hpres x : ↥L') : E) = A x := rfl

lemma restrictRingHom_pow_coe (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (n : ℕ) (x : ↥L') :
    (((restrictRingHom L' A hpres)^n) x : E) = (A^n) x := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', RingHom.mul_def, RingHom.comp_apply, restrictRingHom_apply_coe, ih,
      pow_succ', AlgEquiv.mul_apply]

lemma restrictRingHom_pow_five_apply (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x) (x : ↥L') :
    ((restrictRingHom L' A hpres)^5) x = x := by
  apply Subtype.ext
  rw [restrictRingHom_pow_coe]
  exact h5 x.1 x.2

/-- The restriction of `A` to the stable intermediate field `L'`, as a ring automorphism. -/
noncomputable def restrictRingEquiv (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x) : ↥L' ≃+* ↥L' :=
  RingEquiv.ofBijective (restrictRingHom L' A hpres) (by
    rw [Function.bijective_iff_has_inverse]
    refine ⟨⇑((restrictRingHom L' A hpres)^4), fun x => ?_, fun x => ?_⟩
    · have h := restrictRingHom_pow_five_apply L' A hpres h5 x
      rw [pow_succ, RingHom.mul_def, RingHom.comp_apply] at h
      exact h
    · have h := restrictRingHom_pow_five_apply L' A hpres h5 x
      rw [pow_succ', RingHom.mul_def, RingHom.comp_apply] at h
      exact h)

lemma restrictRingEquiv_apply_coe (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x) (x : ↥L') :
    ((restrictRingEquiv L' A hpres h5 x : ↥L') : E) = A x := rfl

lemma restrictRingEquiv_pow_five_eq_one (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x) :
    (restrictRingEquiv L' A hpres h5) ^ 5 = 1 := by
  have h : ∀ x : ↥L', ((restrictRingEquiv L' A hpres h5) ^ 5) x = x :=
    fun x => restrictRingHom_pow_five_apply L' A hpres h5 x
  ext x
  rw [h x]
  simp

lemma restrictRingEquiv_ne_one (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x)
    (hne : ∃ x ∈ L', A x ≠ x) : restrictRingEquiv L' A hpres h5 ≠ 1 := by
  intro h
  obtain ⟨x, hx, hne⟩ := hne
  have h2 : restrictRingEquiv L' A hpres h5 ⟨x, hx⟩ = ⟨x, hx⟩ := by rw [h]; rfl
  apply hne
  have h4 := congrArg (fun z : ↥L' => (z : E)) h2
  rwa [restrictRingEquiv_apply_coe] at h4

/-- The fixed points of the restriction `A|L'` are exactly the elements of `L'` fixed by `A`:
`(L')^{⟨A|L'⟩} = L' ∩ E^{⟨A⟩}`. -/
theorem fixedField_subfield_restrict_eq (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x) :
    FixedPoints.subfield (Subgroup.zpowers (restrictRingEquiv L' A hpres h5)) ↥L' =
      (IntermediateField.restrict (F := IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L')
        (E := L') inf_le_right).toSubfield := by
  ext x
  have key1 : (x ∈ FixedPoints.subfield
      (Subgroup.zpowers (restrictRingEquiv L' A hpres h5)) ↥L') ↔
      (∀ m : ↥(Subgroup.zpowers (restrictRingEquiv L' A hpres h5)), m • x = x) :=
    MulAction.mem_fixedPoints
  have key2 : x ∈ (IntermediateField.restrict
        (F := IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L')
        (E := L') inf_le_right).toSubfield ↔
      x.1 ∈ IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L' :=
    IntermediateField.mem_restrict inf_le_right x
  have hxL : (x : E) ∈ L' := x.2
  have hL : (x ∈ FixedPoints.subfield
      (Subgroup.zpowers (restrictRingEquiv L' A hpres h5)) ↥L') ↔ A x.1 = x.1 := by
    rw [key1, Subtype.forall]
    refine Iff.trans (show (∀ (a : ↥L' ≃+* ↥L')
        (b : a ∈ Subgroup.zpowers (restrictRingEquiv L' A hpres h5)),
        (⟨a, b⟩ : ↥(Subgroup.zpowers (restrictRingEquiv L' A hpres h5))) • x = x) ↔
        (∀ g ∈ Subgroup.zpowers (restrictRingEquiv L' A hpres h5), g • x = x) from Iff.rfl) ?_
    rw [mem_zpowers_smul_iff]
    refine ⟨fun h => ?_, fun h => Subtype.ext h⟩
    have h2 : (restrictRingEquiv L' A hpres h5 x : ↥L') = x := h
    have h4 := congrArg (fun z : ↥L' => (z : E)) h2
    rwa [restrictRingEquiv_apply_coe] at h4
  have hR : (x ∈ (IntermediateField.restrict
        (F := IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L')
        (E := L') inf_le_right).toSubfield) ↔ A x.1 = x.1 := by
    have hm : (x.1 ∈ IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L') ↔
        x.1 ∈ IntermediateField.fixedField (Subgroup.zpowers A) := by
      rw [IntermediateField.mem_inf]; exact ⟨fun h => h.1, fun h => ⟨h, hxL⟩⟩
    rw [key2, hm, IntermediateField.mem_fixedField_iff]
    constructor
    · intro h
      have h1 : A • (x : E) = (x : E) := h A (Subgroup.mem_zpowers A)
      rwa [AlgEquiv.smul_def] at h1
    · intro h f hf
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hf
      simpa using zpow_smul_eq_self_of_smul_eq_self A (x : E) h n
  rw [hL, hR]

/-- Artin's theorem for the restriction: if `A` has order `5` on the stable field `L'`, then the
fixed field of `A|L'` has degree `5` in `L'`. -/
lemma finrank_fixedField_subfield_eq_five (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x)
    (hne : ∃ x ∈ L', A x ≠ x) :
    Module.finrank
      ↥(FixedPoints.subfield (Subgroup.zpowers (restrictRingEquiv L' A hpres h5)) ↥L') ↥L' = 5 := by
  set A' := restrictRingEquiv L' A hpres h5 with hA'
  have hpow : A' ^ 5 = 1 := by rw [hA']; exact restrictRingEquiv_pow_five_eq_one L' A hpres h5
  have hne' : A' ≠ 1 := by rw [hA']; exact restrictRingEquiv_ne_one L' A hpres h5 hne
  have hf : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have horder : orderOf A' = 5 := orderOf_eq_prime (p := 5) (hp := hf) hpow hne'
  have hfin : Finite ↥(Subgroup.zpowers A') :=
    finite_zpowers.mpr (isOfFinOrder_iff_pow_eq_one.mpr ⟨5, by norm_num, hpow⟩)
  haveI : Fintype ↥(Subgroup.zpowers A') := Fintype.ofFinite _
  have hcard : Fintype.card ↥(Subgroup.zpowers A') = 5 := by
    rw [← Nat.card_eq_fintype_card, Nat.card_zpowers, horder]
  rw [show (5 : ℕ) = Fintype.card ↥(Subgroup.zpowers A') from hcard.symm]
  exact FixedPoints.finrank_eq_card (Subgroup.zpowers A') ↥L'

/-- The compositum of a degree-`5` fixed field with a subfield not contained in it is everything:
the abstract form of the conclusion, with the degree hypothesis on an abstract subfield `S` whose
carrier coincides with the fixed field.  (`Subfield.extendScalars` turns the compositum into an
intermediate field of `L'` over `S`, which is simple by primality of the degree, so it is `⊥` or
`⊤`; it is not `⊥` because it contains an element outside `S`.) -/
theorem sup_eq_top_of_finrank_five (L' : IntermediateField K E) (S : Subfield ↥L')
    (M' R' : IntermediateField K ↥L') (hS : S = M'.toSubfield)
    (hdeg : Module.finrank ↥S ↥L' = 5) (w' : ↥L')
    (hw' : w' ∈ M' ⊔ R') (hw'nS : w' ∉ S) : M' ⊔ R' = ⊤ := by
  haveI : IsSimpleOrder (IntermediateField ↥S ↥L') :=
    IntermediateField.isSimpleOrder_of_finrank_prime ↥S ↥L' (by rw [hdeg]; norm_num)
  have hSle : S ≤ (M' ⊔ R').toSubfield := by
    intro x hx
    rw [hS] at hx
    exact (le_sup_left : M' ≤ M' ⊔ R') (show x ∈ M' from hx)
  have hnotbot : Subfield.extendScalars hSle ≠ ⊥ := by
    intro hbot
    have hmem : w' ∈ Subfield.extendScalars hSle := hw'
    rw [hbot] at hmem
    obtain ⟨y, hy⟩ := IntermediateField.mem_bot.mp hmem
    exact hw'nS (hy.symm ▸ y.2)
  rcases eq_bot_or_eq_top (Subfield.extendScalars hSle) with hbot | htop
  · exact absurd hbot hnotbot
  · refine le_antisymm le_top fun y _ => ?_
    have h1 : y ∈ (Subfield.extendScalars hSle : IntermediateField ↥S ↥L') := by
      rw [htop]; trivial
    exact h1

/-- **Main field-theoretic statement.**  Let `L'` be stable under the `K`-automorphism `A` of `E`,
with `A^5 = 1` on `L'`, `A` nontrivial on `L'` and `A w = w + 1` for some `w ∈ L'`.  Then
`(E^{⟨A⟩} ∩ L') ⊔ K⟮w⟯ = L'`. -/
theorem sup_inf_fixedField_adjoin_eq (L' : IntermediateField K E) (A : E ≃ₐ[K] E)
    (hpres : ∀ x ∈ L', A x ∈ L') (h5 : ∀ x ∈ L', (A ^ 5) x = x)
    (hne : ∃ x ∈ L', A x ≠ x) (w : E) (hw : w ∈ L') (hAw : A w = w + 1) :
    (IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L') ⊔
        IntermediateField.adjoin K {w} = L' := by
  set M := IntermediateField.fixedField (Subgroup.zpowers A) ⊓ L' with hMdef
  have hM : M ≤ L' := by rw [hMdef]; exact inf_le_right
  set R := IntermediateField.adjoin K {w} with hRdef
  have hR : R ≤ L' := by
    rw [hRdef, IntermediateField.adjoin_le_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    exact hy ▸ hw
  set M' := IntermediateField.restrict (F := M) (E := L') hM with hM'def
  set R' := IntermediateField.restrict (F := R) (E := L') hR with hR'def
  set S := FixedPoints.subfield (Subgroup.zpowers (restrictRingEquiv L' A hpres h5)) ↥L'
    with hSdef
  have hS : S = M'.toSubfield := fixedField_subfield_restrict_eq L' A hpres h5
  have hSdeg : Module.finrank ↥S ↥L' = 5 := finrank_fixedField_subfield_eq_five L' A hpres h5 hne
  set w' : ↥L' := ⟨w, hw⟩ with hw'def
  have hw'R : w' ∈ R' := by
    rw [hR'def, IntermediateField.mem_restrict]
    exact IntermediateField.subset_adjoin K {w} (Set.mem_singleton w)
  have hw'X : w' ∈ M' ⊔ R' := (le_sup_right : R' ≤ M' ⊔ R') hw'R
  have hw'notS : w' ∉ S := by
    intro hmem
    rw [hS, hM'def] at hmem
    have hm2 : (w : E) ∈ M := (IntermediateField.mem_restrict hM w').mp hmem
    rw [hMdef, IntermediateField.mem_inf] at hm2
    obtain ⟨hm3, -⟩ := hm2
    rw [IntermediateField.mem_fixedField_iff] at hm3
    have h2 : A w = w := hm3 A (Subgroup.mem_zpowers A)
    rw [hAw] at h2
    have h3 : (1 : E) = 0 := add_left_cancel (a := w) (by simpa using h2)
    exact one_ne_zero h3
  have hsup : M' ⊔ R' = ⊤ := sup_eq_top_of_finrank_five L' S M' R' hS hSdeg w' hw'X hw'notS
  have hlift : IntermediateField.lift (F := L') (M' ⊔ R') =
      IntermediateField.lift (F := L') ⊤ := by rw [hsup]
  rw [hM'def, hR'def] at hlift
  rw [IntermediateField.lift_sup, IntermediateField.lift_restrict, IntermediateField.lift_restrict,
    IntermediateField.lift_top] at hlift
  exact hlift

end Restrict

/-! ## §3 The node -/

theorem twistFieldTrue_sup_asRoot (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] (D : Work.MotV.KleinData 𝕜)
    (g : RatFunc 𝕜)
    (τ : Work.MotV.Om D ≃ₐ[RatFunc 𝕜] Work.MotV.Om D)
    (σS : Work.MotV.Om D ≃ₐ[Work.MotV.Kb 𝕜] Work.MotV.Om D)
    (σ : Work.MotV.Kb 𝕜 ≃ₐ[RatFunc 𝕜] Work.MotV.Kb 𝕜)
    (h : Work.MotV5.ASTwistData 𝕜 D g τ σS σ) :
    Work.MotV5.asTwistFieldTrue D g τ σS
      ⊔ IntermediateField.adjoin (RatFunc 𝕜)
          {algebraMap (Work.MotV.Kb 𝕜) (Work.MotV.Om D) (Work.MotV5.asRoot g)}
      = Work.MotV5.asFieldL D g := by
  -- the Artin–Schreier root, as an element of the ambient function field
  have hw : algebraMap (Work.MotV.Kb 𝕜) (Work.MotV.Om D) (Work.MotV5.asRoot g) ∈
      Work.MotV5.asFieldL D g := by
    show _ ∈ Work.MotV5.kleinField D ⊔ _
    exact (le_sup_right : _ ≤ Work.MotV5.kleinField D ⊔ _)
      (IntermediateField.subset_adjoin _ _ (Set.mem_singleton _))
  -- the twisted action shifts it by `1`
  have hAw : Work.MotV5.asTwistAction D τ σS
      (algebraMap (Work.MotV.Kb 𝕜) (Work.MotV.Om D) (Work.MotV5.asRoot g))
      = algebraMap (Work.MotV.Kb 𝕜) (Work.MotV.Om D) (Work.MotV5.asRoot g) + 1 := by
    rw [Work.MotV5.asTwistAction, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
    rw [h.hτ, AlgEquiv.commutes, h.hσ, map_add, map_one]
  exact sup_inf_fixedField_adjoin_eq (Work.MotV5.asFieldL D g) (Work.MotV5.asTwistAction D τ σS)
    h.hpres h.h5L h.hneL (algebraMap (Work.MotV.Kb 𝕜) (Work.MotV.Om D) (Work.MotV5.asRoot g))
    hw hAw

end Work.MotV5.RigAS
