namespace Work.MotV5.Nodes

/-- **The projective shift has order dividing `5`.**

For AS-good Klein data `D` (`D.Good`, `Nonconstant`, `Generates`, `a² - ab - b² ≠ 0`) and a
projective fifth-torsion shift `σS` (`σS κ_i = λ κ_{i+1}` with `λ ≠ 0`,
`KleinData.ShiftOf D σS`), the fifth power of `σS` is the identity of `Om D`.

Proof route.  Write `κ i := kleinCoord D (Kb 𝕜) i` and let `σ := σS.restrictScalars (RatFunc 𝕜)`,
which is the *same function* as `σS` (`AlgEquiv.restrictScalars_apply`); hence `σS^n = σ^n` as
functions, by induction (`hpow` below).

1. (`GenAux_sigmaS_pow_five_kleinField`, already proved) `σ^5` fixes `kleinField D` pointwise.  Its
   proof is the heart of the matter: iterating the shift relation gives a scalar `μ` with
   `(σS^5) (κ i) = μ * κ i` for every `i` with `μ ≠ 0` (the `κ i` all transform with the *same*
   scalar because `cyc^5 = id`), so `σS^5` fixes the ratios `κ i / κ 0`.
2. By `KleinData.Generates D` at `L = Kb 𝕜` the ratios `κ i / κ 0` generate `Om D` as a
   `Kb 𝕜`-algebra.  Since `σS^5` is `Kb 𝕜`-linear and its fixed points form the intermediate field
   `IntermediateField.fixedField (Subgroup.zpowers (σS^5))`, the generating ratios being fixed
   forces everything to be fixed, i.e. `σS^5 = 1`.

The intermediate field `fixedField` is closed under *all* integer powers (`Subgroup.zpowers`), which
is why the helper `zpow_apply_eq_self_of_apply_eq_self` is used: it is enough to know
`(σS^5) z = z`, then `(σS^5)^n z = z` for every `n : ℤ`, so `z` lies in the fixed field of the
subgroup generated by `σS^5`. -/
theorem shiftOf_pow_five_eq_one (𝕜 : Type) [Field 𝕜] (D : Work.MotV.KleinData 𝕜)
    (hD : Work.MotV5.KleinData.ASGood D)
    (σS : Work.MotV.Om D ≃ₐ[Work.MotV.Kb 𝕜] Work.MotV.Om D)
    (hσS : Work.MotV5.KleinData.ShiftOf D σS) : σS ^ 5 = 1 := by
  obtain ⟨hGood, -, hGen, -⟩ := hD
  -- `σ^5` fixes `K(E)`, where `σ` is the `RatFunc 𝕜`-restriction of `σS`
  have hfix := Work.MotV5.GenAux_sigmaS_pow_five_kleinField 𝕜 D hGood σS hσS
  -- `restrictScalars` does not change the underlying function, so the two powers agree
  have hpow : ∀ n (x : Work.MotV.Om D),
      ((σS.restrictScalars (RatFunc 𝕜))^n) x = (σS^n) x := by
    intro n
    induction n with
    | zero => intro x; simp
    | succ n ih =>
      intro x
      rw [pow_succ', AlgEquiv.mul_apply, ih, pow_succ', AlgEquiv.mul_apply,
        AlgEquiv.restrictScalars_apply]
  -- the Klein ratios generate `Om D` over `Kb 𝕜`
  have hgen : IntermediateField.adjoin (Work.MotV.Kb 𝕜)
      (Set.range (fun i : Fin 5 => Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) i /
        Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) 0)) = ⊤ := hGen (Work.MotV.Kb 𝕜)
  -- hence all of `Om D` is fixed by `σS^5`
  have htop : (⊤ : IntermediateField (Work.MotV.Kb 𝕜) (Work.MotV.Om D)) ≤
      IntermediateField.fixedField (Subgroup.zpowers (σS ^ 5)) := by
    rw [← hgen, IntermediateField.adjoin_le_iff]
    rintro z ⟨i, rfl⟩
    show (Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) i /
        Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) 0) ∈
      IntermediateField.fixedField (Subgroup.zpowers (σS ^ 5))
    rw [IntermediateField.mem_fixedField_iff]
    intro f hf
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hf
    rw [← hn]
    refine Work.MotV5.zpow_apply_eq_self_of_apply_eq_self (σS^5)
      (Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) i /
        Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) 0) ?_ n
    have hmem : Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) i /
        Work.MotV.kleinCoord D (Work.MotV.Kb 𝕜) 0 ∈ Work.MotV5.kleinField D :=
      IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
    rw [← hpow 5]
    exact hfix _ hmem
  -- a `Kb 𝕜`-automorphism fixing everything is `1`
  ext z
  exact (IntermediateField.mem_fixedField_iff (Subgroup.zpowers (σS^5)) z).mp
    (htop trivial) (σS^5) (Subgroup.mem_zpowers _)

end Work.MotV5.Nodes
