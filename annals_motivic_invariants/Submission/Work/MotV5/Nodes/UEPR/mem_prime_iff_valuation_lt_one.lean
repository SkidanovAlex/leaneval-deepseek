namespace Work.MotV5.Nodes.UEPR

open Localization

/-- **When is the class of `x ∈ B` a unit in the localization `B[Pᶜ] ⊆ Ω`?**

For a domain `B` with fraction field `Ω`, a prime `P ⊆ B` and `P.primeCompl ≤ B⁰`, the element
`algebraMap B Ω x`, viewed as an element of the subalgebra `Localization.subalgebra.ofField Ω
P.primeCompl` (i.e. of the localization `B[Pᶜ]` inside `Ω`), is a unit if and only if `x ∉ P`.

The forward implication is the mathematical content: `B[Pᶜ]` is generated by `B` and the inverses
of the elements of `Pᶜ`, so if `x` were a unit there, `1 = x·(a/s)` would force `x·a = s ∉ P`, which
is impossible for `x ∈ P` and `P` prime.  Concretely we use the description
`mem_ofField_iff'` of the elements of `B[Pᶜ]` as `a * s⁻¹`. -/
theorem isUnit_algebraMap_ofField_iff {B Ω : Type*} [CommRing B] [IsDomain B] [Field Ω]
    [Algebra B Ω] [IsFractionRing B Ω] (P : Ideal B) [P.IsPrime]
    (hS : P.primeCompl ≤ nonZeroDivisors B) (x : B) :
    IsUnit (⟨algebraMap B Ω x,
        Subalgebra.algebraMap_mem (Localization.subalgebra.ofField Ω P.primeCompl hS) x⟩ :
        ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) ↔ x ∉ P := by
  have hinj : Function.Injective (algebraMap B Ω) := IsFractionRing.injective B Ω
  constructor
  · rintro ⟨u, hu⟩
    by_contra hxP
    have hcoe : ((u : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω)
        = algebraMap B Ω x :=
      congrArg (fun z : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS) => (z : Ω)) hu
    have hmul : algebraMap B Ω x *
        ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω) = 1 := by
      have h1 : (↑u : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) * ↑(u⁻¹) = 1 :=
        Units.mul_inv u
      have h2 := congrArg
        (fun z : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS) => (z : Ω)) h1
      rw [Subalgebra.coe_mul, hcoe] at h2
      simpa using h2
    obtain ⟨a, s, hs, hw⟩ :=
      (mem_ofField_iff' P.primeCompl hS
        ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω)).mp
        (↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)).2
    have hsne : algebraMap B Ω s ≠ 0 := by
      intro h
      have hs0 : s = 0 := hinj (by rw [h, map_zero])
      exact (Ideal.mem_primeCompl_iff.mp hs) (hs0 ▸ zero_mem P)
    have hmul2 : algebraMap B Ω x * (algebraMap B Ω a * (algebraMap B Ω s)⁻¹) = 1 := by
      rw [← hw]; exact hmul
    have hkey : algebraMap B Ω x * algebraMap B Ω a = algebraMap B Ω s := by
      have h3 := congrArg (fun t => t * algebraMap B Ω s) hmul2
      simp only [one_mul] at h3
      rw [mul_assoc, mul_assoc, inv_mul_cancel₀ hsne, mul_one] at h3
      exact h3
    have hxa : x * a = s := hinj (by rw [map_mul]; exact hkey)
    exact (Ideal.mem_primeCompl_iff.mp hs) (by rw [← hxa]; exact Ideal.mul_mem_right a P hxP)
  · intro hx
    have hx0 : x ≠ 0 := by rintro rfl; exact hx (zero_mem P)
    have hxmap : algebraMap B Ω x ≠ 0 := fun h => hx0 (hinj (by rw [h, map_zero]))
    have hmem : (algebraMap B Ω x)⁻¹ ∈ Localization.subalgebra.ofField Ω P.primeCompl hS := by
      rw [mem_ofField_iff' P.primeCompl hS]
      exact ⟨1, x, Ideal.mem_primeCompl_iff.mpr hx, by simp⟩
    refine isUnit_iff_exists.mpr ⟨⟨(algebraMap B Ω x)⁻¹, hmem⟩, ?_, ?_⟩
    · apply Subtype.ext
      simp only [Subalgebra.coe_mul, Subalgebra.coe_one]
      exact mul_inv_cancel₀ hxmap
    · apply Subtype.ext
      simp only [Subalgebra.coe_mul, Subalgebra.coe_one]
      exact inv_mul_cancel₀ hxmap

/-- **The prime is cut out by the valuation.**

Let `B` be a domain with fraction field `Ω`, `P ⊆ B` a prime with `P.primeCompl ≤ B⁰`, and let `w`
be a valuation on `Ω` whose valuation ring is the image of the localization `B[Pᶜ] ⊆ Ω` (this is
the `hbridge` hypothesis, the "the valuation ring is the local ring at `P`" statement). Then `P` is
the centre of `w` on `B`: for every `x ∈ B`,

  `x ∈ P ↔ w (algebraMap B Ω x) < 1`.

Equivalently, `P` is the contraction of the maximal ideal of the valuation ring.

The two implications are proved through the intermediate ring `L = B[Pᶜ] ⊆ Ω`, whose elements are
described by `mem_ofField_iff'` and whose units among the elements `algebraMap B Ω x` are
characterised by `isUnit_algebraMap_ofField_iff`:

* if `x ∉ P` then `algebraMap B Ω x` is a unit of `L = w.valuationSubring`, so both it and its
  inverse have valuation `≤ 1`, and their product is `1`; hence `w (algebraMap B Ω x) = 1`;
* if `x ∈ P` and `w (algebraMap B Ω x) = 1`, then `(algebraMap B Ω x)⁻¹` lies in the valuation
  ring `= L`, so `algebraMap B Ω x` would be a unit of `L`, contradicting the previous lemma. -/
theorem mem_prime_iff_valuation_lt_one {B Ω Γ : Type*} [CommRing B] [IsDomain B] [Field Ω]
    [Algebra B Ω] [IsFractionRing B Ω] [LinearOrderedCommGroupWithZero Γ]
    (w : Valuation Ω Γ) (P : Ideal B) [P.IsPrime] (hS : P.primeCompl ≤ nonZeroDivisors B)
    (hbridge : w.valuationSubring.toSubring =
      (Localization.subalgebra.ofField Ω P.primeCompl hS).toSubring) :
    ∀ x : B, x ∈ P ↔ w (algebraMap B Ω x) < 1 := by
  intro x
  have hxL : algebraMap B Ω x ∈ Localization.subalgebra.ofField Ω P.primeCompl hS :=
    Subalgebra.algebraMap_mem _ x
  have hxW : algebraMap B Ω x ∈ w.valuationSubring.toSubring := by
    rw [hbridge, Subalgebra.mem_toSubring]; exact hxL
  have hle : w (algebraMap B Ω x) ≤ 1 :=
    (Valuation.mem_valuationSubring_iff w _).mp ((ValuationSubring.mem_toSubring _ _).mp hxW)
  constructor
  · intro hxP
    by_contra hge
    rw [not_lt] at hge
    have hEq : w (algebraMap B Ω x) = 1 := le_antisymm hle hge
    have hxmap0 : algebraMap B Ω x ≠ 0 := by
      intro h
      rw [h, Valuation.map_zero] at hEq
      exact one_ne_zero hEq.symm
    have hmemW : (algebraMap B Ω x)⁻¹ ∈ w.valuationSubring.toSubring := by
      rw [ValuationSubring.mem_toSubring, Valuation.mem_valuationSubring_iff, Valuation.map_inv,
        hEq, inv_one]
    rw [hbridge, Subalgebra.mem_toSubring] at hmemW
    have hunit : IsUnit (⟨algebraMap B Ω x,
        Subalgebra.algebraMap_mem (Localization.subalgebra.ofField Ω P.primeCompl hS) x⟩ :
        ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) := by
      refine isUnit_iff_exists.mpr ⟨⟨(algebraMap B Ω x)⁻¹, hmemW⟩, ?_, ?_⟩
      · apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_one]
        exact mul_inv_cancel₀ hxmap0
      · apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_one]
        exact inv_mul_cancel₀ hxmap0
    exact (isUnit_algebraMap_ofField_iff P hS x).mp hunit hxP
  · intro hlt
    by_contra hxP
    have hunit := (isUnit_algebraMap_ofField_iff (Ω := Ω) P hS x).mpr hxP
    rcases hunit with ⟨u, hu⟩
    have hmul : algebraMap B Ω x *
        ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω) = 1 := by
      have h1 : (↑u : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) * ↑(u⁻¹) = 1 :=
        Units.mul_inv u
      have h2 := congrArg
        (fun z : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS) => (z : Ω)) h1
      rw [Subalgebra.coe_mul, hu] at h2
      simpa using h2
    have hleinv : w ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω) ≤ 1 := by
      have hW : ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω) ∈
          w.valuationSubring.toSubring := by
        rw [hbridge, Subalgebra.mem_toSubring]
        exact (↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)).2
      exact (Valuation.mem_valuationSubring_iff w _).mp ((ValuationSubring.mem_toSubring _ _).mp hW)
    have hab : w ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω) *
        w (algebraMap B Ω x) = 1 := by
      rw [← Valuation.map_mul, mul_comm, hmul, Valuation.map_one]
    have h4 : w ((↑(u⁻¹) : ↥(Localization.subalgebra.ofField Ω P.primeCompl hS)) : Ω) *
        w (algebraMap B Ω x) ≤ 1 * w (algebraMap B Ω x) :=
      mul_le_mul_of_nonneg_right hleinv zero_le
    rw [one_mul, hab] at h4
    exact absurd h4 (not_le.mpr hlt)

end Work.MotV5.Nodes.UEPR
