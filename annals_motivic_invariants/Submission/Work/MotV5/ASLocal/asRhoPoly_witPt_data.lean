  2 * a ^(22:ℕ) * g + 2 * a ^(21:ℕ) * b * g + a ^(20:ℕ) * b ^(2:ℕ) * g + a ^(17:ℕ) * b ^(5:ℕ) * g + a ^(16:ℕ) * b ^(6:ℕ) * g + 3 * a ^(15:ℕ) * b ^(7:ℕ) * g + 3 * a ^(12:ℕ) * b ^(10:ℕ) * g + 3 * a ^(11:ℕ) * b ^(11:ℕ) * g + 4 * a ^(10:ℕ) * b ^(12:ℕ) * g + 4 * a ^(7:ℕ) * b ^(15:ℕ) * g + 4 * a ^(6:ℕ) * b ^(16:ℕ) * g + 2 * a ^(5:ℕ) * b ^(17:ℕ) * g + 2 * a ^(2:ℕ) * b ^(20:ℕ) * g + 2 * a * b ^(21:ℕ) * g + b ^(22:ℕ) * g + 2 * a ^(21:ℕ) * b + 4 * a ^(20:ℕ) * b ^(2:ℕ) + 3 * a ^(19:ℕ) * b ^(3:ℕ) + 4 * a ^(18:ℕ) * b ^(4:ℕ) + 2 * a ^(17:ℕ) * b ^(5:ℕ) + 2 * a ^(16:ℕ) * b ^(6:ℕ) + 3 * a ^(14:ℕ) * b ^(8:ℕ) + 4 * a ^(13:ℕ) * b ^(9:ℕ) + 2 * a ^(12:ℕ) * b ^(10:ℕ) + 4 * a ^(11:ℕ) * b ^(11:ℕ) + 4 * a ^(10:ℕ) * b ^(12:ℕ) + a ^(9:ℕ) * b ^(13:ℕ) + 3 * a ^(8:ℕ) * b ^(14:ℕ) + 4 * a ^(7:ℕ) * b ^(15:ℕ) + a ^(6:ℕ) * b ^(16:ℕ) + 4 * a ^(5:ℕ) * b ^(17:ℕ) + 4 * a ^(4:ℕ) * b ^(18:ℕ) + 2 * a ^(3:ℕ) * b ^(19:ℕ) + a ^(2:ℕ) * b ^(20:ℕ) + 3 * b ^(22:ℕ)

/-- The `13`-th coefficient of the quotient `QP`. -/
noncomputable def asQ13 {K : Type} [CommRing K] (a b g : K) : K :=
  2 * a ^(22:ℕ) * g + 3 * a ^(21:ℕ) * b * g + 3 * a ^(20:ℕ) * b ^(2:ℕ) * g + a ^(17:ℕ) * b ^(5:ℕ) * g + 4 * a ^(16:ℕ) * b ^(6:ℕ) * g + 4 * a ^(15:ℕ) * b ^(7:ℕ) * g + 3 * a ^(12:ℕ) * b ^(10:ℕ) * g + 2 * a ^(11:ℕ) * b ^(11:ℕ) * g + 2 * a ^(10:ℕ) * b ^(12:ℕ) * g + 4 * a ^(7:ℕ) * b ^(15:ℕ) * g + a ^(6:ℕ) * b ^(16:ℕ) * g + a ^(5:ℕ) * b ^(17:ℕ) * g + 2 * a ^(2:ℕ) * b ^(20:ℕ) * g + 3 * a * b ^(21:ℕ) * g + 3 * b ^(22:ℕ) * g + 3 * a ^(21:ℕ) * b + a ^(19:ℕ) * b ^(3:ℕ) + 3 * a ^(18:ℕ) * b ^(4:ℕ) + 4 * a ^(17:ℕ) * b ^(5:ℕ) + a ^(16:ℕ) * b ^(6:ℕ) + a ^(15:ℕ) * b ^(7:ℕ) + a ^(14:ℕ) * b ^(8:ℕ) + 3 * a ^(13:ℕ) * b ^(9:ℕ) + 4 * a ^(12:ℕ) * b ^(10:ℕ) + 4 * a ^(11:ℕ) * b ^(11:ℕ) + a ^(10:ℕ) * b ^(12:ℕ) + 2 * a ^(9:ℕ) * b ^(13:ℕ) + a ^(8:ℕ) * b ^(14:ℕ) + 3 * a ^(7:ℕ) * b ^(15:ℕ) + 2 * a ^(5:ℕ) * b ^(17:ℕ) + 3 * a ^(4:ℕ) * b ^(18:ℕ) + 4 * a ^(3:ℕ) * b ^(19:ℕ) + 2 * a ^(2:ℕ) * b ^(20:ℕ) + 4 * a * b ^(21:ℕ) + 3 * b ^(22:ℕ)

/-- The remainder of the value of `asRhoPoly` at `witPt a b` modulo `X ^ 5 - X - C g`. -/
noncomputable def PhiP {K : Type} [CommRing K] (a b g : K) : Polynomial K :=
  Polynomial.C (asN0 a b g)
  + Polynomial.C (asN1 a b g) * Polynomial.X ^(1:ℕ)
  + Polynomial.C (asN2 a b g) * Polynomial.X ^(2:ℕ)
  + Polynomial.C (asN3 a b g) * Polynomial.X ^(3:ℕ)
  + Polynomial.C (asN4 a b g) * Polynomial.X ^(4:ℕ)

/-- The quotient of the value of `asRhoPoly` at `witPt a b` by `X ^ 5 - X - C g`. -/
noncomputable def QP {K : Type} [CommRing K] (a b g : K) : Polynomial K :=
  Polynomial.C (asQ0 a b g)
  + Polynomial.C (asQ1 a b g) * Polynomial.X ^(1:ℕ)
  + Polynomial.C (asQ2 a b g) * Polynomial.X ^(2:ℕ)
  + Polynomial.C (asQ3 a b g) * Polynomial.X ^(3:ℕ)
  + Polynomial.C (asQ4 a b g) * Polynomial.X ^(4:ℕ)
  + Polynomial.C (asQ5 a b g) * Polynomial.X ^(5:ℕ)
  + Polynomial.C (asQ6 a b g) * Polynomial.X ^(6:ℕ)
  + Polynomial.C (asQ7 a b g) * Polynomial.X ^(7:ℕ)
  + Polynomial.C (asQ8 a b g) * Polynomial.X ^(8:ℕ)
  + Polynomial.C (asQ9 a b g) * Polynomial.X ^(9:ℕ)
  + Polynomial.C (asQ10 a b g) * Polynomial.X ^(10:ℕ)
  + Polynomial.C (asQ11 a b g) * Polynomial.X ^(11:ℕ)
  + Polynomial.C (asQ12 a b g) * Polynomial.X ^(12:ℕ)
  + Polynomial.C (asQ13 a b g) * Polynomial.X ^(13:ℕ)


/-- **Bézout certificate.** The five remainder coefficients generate `(a - 3b) ^ 14 * b ^ 10`. -/
theorem bezout {K : Type} [Field K] [CharP K 5] (a b g : K) :
    asW0 a b g * asN0 a b g + asW1 a b g * asN1 a b g + asW2 a b g * asN2 a b g
      + asW3 a b g * asN3 a b g + asW4 a b g * asN4 a b g = (a - 3 * b) ^(14:ℕ) * b ^(10:ℕ) := by
  simp only [asW0, asW1, asW2, asW3, asW4, asN0, asN1, asN2, asN3, asN4]
  all_goals refl_ring1 (mod := 5)

/-- `PhiP` has degree at most `4`. -/
theorem PhiP_natDegree {K : Type} [CommRing K] (a b g : K) :
    (PhiP a b g).natDegree ≤ 4 := by
  rw [PhiP]
  apply le_trans (Polynomial.natDegree_add_le _ _)
  apply max_le
  · apply le_trans (Polynomial.natDegree_add_le _ _)
    apply max_le
    · apply le_trans (Polynomial.natDegree_add_le _ _)
      apply max_le
      · apply le_trans (Polynomial.natDegree_add_le _ _)
        apply max_le
        · simp [Polynomial.natDegree_C]
        · exact le_trans (Polynomial.natDegree_C_mul_X_pow_le (asN1 a b g) 1) (by norm_num)
      · exact le_trans (Polynomial.natDegree_C_mul_X_pow_le (asN2 a b g) 2) (by norm_num)
    · exact le_trans (Polynomial.natDegree_C_mul_X_pow_le (asN3 a b g) 3) (by norm_num)
  · exact le_trans (Polynomial.natDegree_C_mul_X_pow_le (asN4 a b g) 4) (by norm_num)

