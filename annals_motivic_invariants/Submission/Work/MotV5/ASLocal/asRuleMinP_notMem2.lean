/-!
# `Work.MotAS.asRuleMinP_notMem2`

The AS ruling minor `asRuleMinP a b g` is not in the ideal generated by the five AS Pfaffians
`kleinPASm a b g`, for `a b ≠ 0` and `a² - ab - b² ≠ 0`.

## Proof

`Work.MotAS.witPt a b : Fin 5 → Polynomial K` is (the `K[X]`-form of) a point of the AS Klein
curve: `asM(w) · witPt = (a,0,-a,-b,b)` for `w` a root of `X⁵ - X - g`, whence the five values
`kleinPAS a b g (witPt a b) k` all lie in the ideal `(X⁵ - X - g)` (`Work.MotAS.witPfaff`), while
the value of the minor does not (`Work.MotAS.witValue`):

`asRuleMinP a b g (witPt a b) = (X⁵ - X - g)·witH + witPhi`, and the `X²`-coefficient of the
remainder `witPhi` is `3·a·b·(a⁵-3b⁵)² ≠ 0` (a nonzero `X²`-coefficient means `witPhi ≠ 0`, and
`a⁵ = 3b⁵` would force `a = 3b`, hence `a² - ab - b² = 0`).

Applying `MvPolynomial.aeval (witPt a b)` to a representation of `asRuleMinP a b g` as a
combination of the five Pfaffians would then exhibit a nonzero multiple of the monic polynomial
`X⁵ - X - g` in `Polynomial K` of degree `< 5`, which is impossible.
-/

set_option maxHeartbeats 4000000
set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxRecDepth 100000

namespace Work.MotV5.ASLocal

open Work.MotAS

open MvPolynomial Polynomial

variable {K : Type} [Field K] [CharP K 5]

/-- The `X²`-coefficient of the remainder `witPhi`. -/
theorem witPhi_coeff_two (a b g : K) :
    (witPhi a b g).coeff 2 = 3 * a * b * (a ^ 5 - 3 * b ^ 5) ^ 2 := by
  have h5 : (5 : K) = 0 := CharP.cast_eq_zero K 5
  have hcoeff : (witPhi a b g).coeff 2 = 3 * a ^ 11 * b + 2 * a ^ 6 * b ^ 6 + 2 * a * b ^ 11 := by
    simp only [witPhi, Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul,
      Polynomial.coeff_X_pow, Polynomial.coeff_one, mul_one, mul_zero, add_zero, zero_add]
    norm_num
  have key : 3 * a ^ 11 * b + 2 * a ^ 6 * b ^ 6 + 2 * a * b ^ 11 - 3 * a * b * (a ^ 5 - 3 * b ^ 5) ^ 2
      = 5 * (4 * a ^ 6 * b ^ 6 - 5 * a * b ^ 11) := by ring
  rw [hcoeff, ← sub_eq_zero, key, h5]
  simp

/-- In characteristic `5`, `(a - 3b)⁵ = a⁵ - 3b⁵`. -/
theorem sub_three_pow (a b : K) : (a - 3 * b) ^ 5 = a ^ 5 - 3 * b ^ 5 := by
  have h5 : (5 : K) = 0 := CharP.cast_eq_zero K 5
  have key : (a - 3 * b) ^ 5 - (a ^ 5 - 3 * b ^ 5)
      = 5 * (-3 * a ^ 4 * b + 18 * a ^ 3 * b ^ 2 - 54 * a ^ 2 * b ^ 3 + 81 * a * b ^ 4
        - 48 * b ^ 5) := by ring
  rw [← sub_eq_zero, key, h5]
  first | refl_ring1 | ring

/-- `3 ≠ 0` in characteristic `5`. -/
theorem three_ne_zero (K : Type) [Field K] [CharP K 5] : (3 : K) ≠ 0 := by
  intro h
  have h' : ((3 : ℕ) : K) = 0 := h
  rw [CharP.cast_eq_zero_iff K 5] at h'
  norm_num at h'

/-- `witPhi` does not vanish under the standing nondegeneracy hypotheses. -/
theorem witPhi_ne_zero (a b g : K) (ha : a ≠ 0) (hb : b ≠ 0)
    (hd : a ^ 2 - a * b - b ^ 2 ≠ 0) : witPhi a b g ≠ 0 := by
  intro h
  have h2 : 3 * a * b * (a ^ 5 - 3 * b ^ 5) ^ 2 = 0 := by
    rw [← witPhi_coeff_two a b g, h, Polynomial.coeff_zero]
  have hab : a - 3 * b ≠ 0 := by
    intro h3
    apply hd
    have h4 : a = 3 * b := sub_eq_zero.mp h3
    rw [h4]
    ring_nf
    rw [show (5 : K) = 0 from CharP.cast_eq_zero K 5]
    first | refl_ring1 | ring
  have h5b : a ^ 5 - 3 * b ^ 5 ≠ 0 := by
    intro h5
    exact hab (pow_eq_zero_iff (by norm_num : (5 : ℕ) ≠ 0) |>.mp (by rw [sub_three_pow]; exact h5))
  exact mul_ne_zero (mul_ne_zero (mul_ne_zero (three_ne_zero K) ha) hb) (pow_ne_zero 2 h5b) h2

/-- The requested theorem. -/
theorem asRuleMinP_notMem2 (K : Type) [Field K] [CharP K 5] (a b g : K)
    (ha : a ≠ 0) (hb : b ≠ 0) (hd : a ^ 2 - a * b - b ^ 2 ≠ 0) :
    Work.MotAS.asRuleMinP a b g ∉ Ideal.span (Set.range (Work.MotAS.kleinPASm a b g)) := by
  intro hmem
  obtain ⟨q, hq⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have h1 : (∑ i : Fin 5, MvPolynomial.aeval (witPt a b) (q i)
        * ((Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g) * witHk i a b g))
      = (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g) * witH a b g + witPhi a b g := by
    have h := congrArg (MvPolynomial.aeval (witPt a b)) hq
    rw [map_sum] at h
    simp only [map_mul] at h
    rw [witValue K a b g] at h
    simp only [witPfaff K a b g] at h
    exact h
  have h2 : (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g)
      * (∑ i : Fin 5, MvPolynomial.aeval (witPt a b) (q i) * witHk i a b g)
      = (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g) * witH a b g + witPhi a b g := by
    rw [← h1, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  have hdvd : (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g) ∣ witPhi a b g := by
    refine ⟨(∑ i : Fin 5, MvPolynomial.aeval (witPt a b) (q i) * witHk i a b g) - witH a b g, ?_⟩
    rw [show (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g)
          * ((∑ i : Fin 5, MvPolynomial.aeval (witPt a b) (q i) * witHk i a b g) - witH a b g)
        = (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g)
            * (∑ i : Fin 5, MvPolynomial.aeval (witPt a b) (q i) * witHk i a b g)
          - (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g) * witH a b g from by ring,
      h2]
    first | refl_ring1 | ring
  have hfdeg : (Polynomial.X ^ 5 - Polynomial.X - Polynomial.C g : Polynomial K).natDegree = 5 := by
    compute_degree!
  have hpdeg : (witPhi a b g).natDegree ≤ 2 := by
    rw [witPhi]
    compute_degree!
  exact witPhi_ne_zero a b g ha hb hd
    (Polynomial.eq_zero_of_dvd_of_natDegree_lt hdvd (by omega))

end Work.MotV5.ASLocal
