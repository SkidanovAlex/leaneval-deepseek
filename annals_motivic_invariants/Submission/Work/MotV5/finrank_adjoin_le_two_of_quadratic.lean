namespace Work.MotV5

/-- If `y` satisfies a monic quadratic relation `y ^ 2 + α * y + β = 0` over `K`,
then the field `K(y)` generated by `y` has degree at most `2` over `K`. -/
theorem finrank_adjoin_le_two_of_quadratic {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    (y : Ω) (α β : K) (h : y ^ 2 + algebraMap K Ω α * y + algebraMap K Ω β = 0) :
    Module.finrank K ↥(IntermediateField.adjoin K ({y} : Set Ω)) ≤ 2 := by
  -- The monic witness polynomial `X ^ 2 + C α * X + C β`.
  set p : Polynomial K := Polynomial.X ^ 2 + Polynomial.C α * Polynomial.X + Polynomial.C β with hp
  have hmonic : p.Monic := by
    rw [hp]; monicity!
  -- `y` is a root of `p`.
  have hroot : Polynomial.aeval y p = 0 := by
    rw [hp]
    simp only [map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    exact h
  have hint : IsIntegral K y := ⟨p, hmonic, hroot⟩
  -- `[K(y) : K] = natDegree (minpoly K y)`, and `minpoly K y ∣ p`.
  rw [IntermediateField.adjoin.finrank hint]
  calc (minpoly K y).natDegree ≤ p.natDegree :=
        Polynomial.natDegree_le_of_dvd (minpoly.dvd K y hroot) hmonic.ne_zero
    _ ≤ 2 := by rw [hp]; compute_degree

end Work.MotV5
