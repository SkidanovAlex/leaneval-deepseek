namespace Work.MotV5

/-- The local ring `infPlace E` of the point at infinity of an elliptic Weierstrass curve `E` over a
field `N` is a rational place of `N(E)/N`.

`IsRatPlace` asks for two things: a discrete valuation ring structure on `↥(infPlace E)` together
with the identification of its residue field with `N`, and the fact that `N(E)` is the fraction
field of `↥(infPlace E)`.  Both are proved in `Work.MotC2.InfPlaceCore`:

* `InfPlaceCore.instIsDiscreteValuationRing` — `↥(infPlace E)` is a DVR (Noetherian local domain,
  not a field, with principal maximal ideal generated by `y/x²`);
* `InfPlaceCore.residue_field` — the canonical map `N → ↥(infPlace E) ⧸ 𝔪` is bijective;
* `InfPlaceCore.frac_field` — every `f ∈ N(E)` is a quotient `s₁ / s₂` of elements of
  `infPlace E`. -/
theorem infPlace_ratPlace {N : Type*} [Field N] (E : WeierstrassCurve N) [E.IsElliptic] :
    Work.MotC2.IsRatPlace E (Work.MotC2.infPlace E) :=
  ⟨⟨Work.MotC2.InfPlaceCore.instIsDiscreteValuationRing E,
      Work.MotC2.InfPlaceCore.residue_field E⟩,
    Work.MotC2.InfPlaceCore.frac_field E⟩

end Work.MotV5
