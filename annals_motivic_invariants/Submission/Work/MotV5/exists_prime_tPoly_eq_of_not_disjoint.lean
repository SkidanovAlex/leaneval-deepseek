namespace Work.MotV5

/-- **A height-one prime of `𝕜[t,x₁,x₂,x₃]` meeting the `t`-axis is generated by a vertical
hypersurface.**

If `p` is a prime ideal of `𝕜[t,x₁,x₂,x₃]` of height one containing some nonzero polynomial in `t`
alone (hypothesis `h`), then `p = (g(t))` for a prime `g ∈ 𝕜[t]`.

The `t`-polynomials lying in `p` form a nonzero prime ideal `I = p.comap (t ↦ X 0)` of the PID
`𝕜[t]`; since `𝕜[t]` is a UFD, `I` contains a prime element `g` (`g ≠ 0` because `I ≠ ⊥`).  The
image `g(X 0)` is prime in `𝕜[x₀,…,x₃]` (`Work.MotA.prime_aeval_X0`), and a height-one prime
containing a prime element is generated by it (`Ideal.eq_span_singleton_of_height_eq_one`). -/
theorem exists_prime_tPoly_eq_of_not_disjoint (𝕜 : Type) [Field 𝕜]
    (p : Ideal (MvPolynomial (Fin 4) 𝕜)) [p.IsPrime] (hp1 : p.height = 1)
    (h : ¬ Disjoint (((nonZeroDivisors (Polynomial 𝕜)).map (Work.MotA.tPoly 𝕜 3) :
        Set (MvPolynomial (Fin 4) 𝕜))) (p : Set (MvPolynomial (Fin 4) 𝕜))) :
    ∃ q : Polynomial 𝕜, Prime q ∧
      p = Ideal.span {(Work.MotA.tPoly 𝕜 3 q : MvPolynomial (Fin 4) 𝕜)} := by
  -- `h` produces a `t`-polynomial `tPoly q` lying in `p`, with `q ≠ 0`.
  obtain ⟨s, hs, hsp⟩ := Set.not_disjoint_iff.mp h
  rw [SetLike.mem_coe, Submonoid.mem_map] at hs
  obtain ⟨q, hq, hqs⟩ := hs
  have hq0 : q ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hq
  -- The `t`-polynomials inside `p`: a nonzero prime ideal of the PID `𝕜[t]`.
  have hIprime : (Ideal.comap (Work.MotA.tPoly 𝕜 3) p).IsPrime := Ideal.comap_isPrime _ p
  have hqI : q ∈ Ideal.comap (Work.MotA.tPoly 𝕜 3) p := by
    rw [Ideal.mem_comap, hqs]
    exact hsp
  have hIne : Ideal.comap (Work.MotA.tPoly 𝕜 3) p ≠ ⊥ := fun hbot =>
    hq0 (by simpa [hbot] using hqI)
  -- A UFD: a nonzero prime ideal contains a prime element.
  obtain ⟨g, hgI, hgprime⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot hIprime hIne
  refine ⟨g, hgprime, ?_⟩
  -- `g(X 0)` lies in `p` and is a prime element of `𝕜[x₀,…,x₃]`.
  have hgtp : (Work.MotA.tPoly 𝕜 3 g : MvPolynomial (Fin 4) 𝕜) ∈ p := by
    rw [Ideal.mem_comap] at hgI
    exact hgI
  have hprime : Prime (Work.MotA.tPoly 𝕜 3 g : MvPolynomial (Fin 4) 𝕜) := by
    simpa [Work.MotA.tPoly] using Work.MotA.prime_aeval_X0 𝕜 3 g hgprime
  -- A height-one prime containing a prime element is generated by that element.
  exact Ideal.eq_span_singleton_of_height_eq_one hp1 hgtp hprime

end Work.MotV5
