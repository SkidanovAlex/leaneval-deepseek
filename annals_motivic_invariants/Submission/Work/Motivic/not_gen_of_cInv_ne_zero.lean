/-! # `not_gen_of_cInv_ne_zero`

A single Cremona transformation with nonzero invariant coefficient obstructs generation of
`Crₙ(𝕜)` by pseudo-regularizable elements.

The invariant coefficient `cInv 𝕜 z` is additive on `Cr 𝕜 n` (specialise the general groupoid
additivity `cInv_add` of the Lin–Shinder invariant to birational self-maps of affine space) and
kills pseudo-regularizable elements (`cInv_eq_zero_of_pseudoReg`).  Hence it is a monoid
homomorphism `Cr 𝕜 n →* Multiplicative ℤ` whose kernel contains the subgroup generated by the
pseudo-regularizable elements.  If that subgroup were everything, the coefficient would vanish
identically, contradicting the existence of a nonzero coefficient.
-/

namespace Work.Motivic

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme MotivicInvariants

/-- The `[κ(z)]`-coefficient of the Lin–Shinder invariant, packaged as a monoid homomorphism
`Cr 𝕜 n →* Multiplicative ℤ`.  Additivity is the affine-space specialisation of `cInv_add`. -/
noncomputable def cInvHom (𝕜 : Type) [Field 𝕜] (n : ℕ) {Z : Scheme.{0}}
    [Z.Over (Spec (.of 𝕜))] (z : Z) :
    Cr 𝕜 n →* Multiplicative ℤ where
  toFun f :=
    Multiplicative.ofAdd
      (cInv 𝕜 z (f : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))))
  map_one' := by
    have hs : BirationalMap.symm (1 : BirationalMap 𝔸(Fin n; Spec (.of 𝕜))
        𝔸(Fin n; Spec (.of 𝕜))) = 1 := by
      change (1 : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜)))⁻¹ = 1
      exact inv_one
    have h1 : cInv 𝕜 z ((1 : Cr 𝕜 n) :
        BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))) = 0 := by
      rw [Subgroup.coe_one, cInv, hs, sub_self]
    rw [h1]
    rfl
  map_mul' := by
    intro f g
    haveI hf : (f : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))).IsOver
        (Spec (.of 𝕜)) := f.2
    haveI hg : (g : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))).IsOver
        (Spec (.of 𝕜)) := g.2
    have hcoe : ((f * g : Cr 𝕜 n) :
        BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))) =
        (f : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))).trans
          (g : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))) := by
      rw [Subgroup.coe_mul]
      rfl
    rw [hcoe, cInv_add (𝕜 := 𝕜) z
      (f : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜)))
      (g : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜)))]
    rfl

/-- A single Cremona transformation with nonzero invariant coefficient obstructs generation by
pseudo-regularizable elements. -/
theorem not_gen_of_cInv_ne_zero (𝕜 : Type) [Field 𝕜] (n : ℕ)
    (h : ∃ (Z : Scheme.{0}) (_ : Z.Over (Spec (.of 𝕜))) (z : Z) (f : Cr 𝕜 n),
      cInv 𝕜 z (f : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜))) ≠ 0) :
    ¬ GenByPseudoRegularizable 𝕜 n := by
  obtain ⟨Z, hZover, z, f, hf⟩ := h
  letI := hZover
  intro hgen
  have hker : Subgroup.closure {g : Cr 𝕜 n | g.1.IsPseudoRegularizable 𝕜} ≤
      (cInvHom 𝕜 n z).ker := by
    rw [Subgroup.closure_le]
    intro g hg
    refine MonoidHom.mem_ker.mpr ?_
    show Multiplicative.ofAdd
      (cInv 𝕜 z (g : BirationalMap 𝔸(Fin n; Spec (.of 𝕜)) 𝔸(Fin n; Spec (.of 𝕜)))) = 1
    rw [cInv_eq_zero_of_pseudoReg 𝕜 n z g hg]
    rfl
  have htop : (⊤ : Subgroup (Cr 𝕜 n)) ≤ (cInvHom 𝕜 n z).ker := hgen ▸ hker
  have hmem : f ∈ (cInvHom 𝕜 n z).ker := htop (Subgroup.mem_top f)
  rw [MonoidHom.mem_ker] at hmem
  exact hf (by simpa using Multiplicative.ofAdd.injective hmem)

end Work.Motivic
