/-!
# The generic point of a Weierstrass curve generates its function field

For a Weierstrass curve `W` over a field `L` with affine coordinate ring
`R = L[W] = L[X, Y]/(W)` and function field `K = L(W) = Frac R`, the two coordinates
`x = [X]`, `y = [Y]` of the generic point (see `Work.MotC.C6.genX`, `Work.MotC.C6.genY`)
generate `K` over `L`:

`L(x, y) = K`.

The proof: every element of `R` is `p + q * y` with `p q ∈ L[X]`, hence its image in `K`
lies in the subfield generated by `x` and `y`; and `K` is the fraction field of `R`, so it
is generated by the image of `R` (`IsFractionRing.closure_range_algebraMap`).
-/

open WeierstrassCurve WeierstrassCurve.Affine Polynomial
open scoped Polynomial.Bivariate

namespace Work.MotC

theorem adjoin_genX_genY_eq_top {L : Type} [Field L] (W : WeierstrassCurve L) :
    IntermediateField.adjoin L {Work.MotC.C6.genX W, Work.MotC.C6.genY W} = ⊤ := by
  set F : IntermediateField L (WeierstrassCurve.Affine.FunctionField W) :=
    IntermediateField.adjoin L ({Work.MotC.C6.genX W, Work.MotC.C6.genY W} : Set _) with hF
  have hx : Work.MotC.C6.genX W ∈ F := by
    rw [hF]; exact IntermediateField.subset_adjoin L _ (by simp)
  have hy : Work.MotC.C6.genY W ∈ F := by
    rw [hF]; exact IntermediateField.subset_adjoin L _ (by simp)
  -- The image of `L[X]` in `K` is contained in the field generated by `x` (and hence by `x, y`).
  have hLX : ∀ p : L[X], algebraMap L[X] (FunctionField W) p ∈ F := by
    intro p
    have hφX : IsScalarTower.toAlgHom L L[X] (FunctionField W) Polynomial.X = C6.genX W := by
      change algebraMap L[X] (FunctionField W) Polynomial.X = C6.genX W
      rw [IsScalarTower.algebraMap_apply L[X] (CoordinateRing W) (FunctionField W)]
      rw [show algebraMap L[X] (CoordinateRing W) Polynomial.X
          = CoordinateRing.mk W (Polynomial.C Polynomial.X) from by
        rw [AdjoinRoot.algebraMap_eq]
        exact (AdjoinRoot.mk_C (f := WeierstrassCurve.Affine.polynomial W) Polynomial.X).symm]
      rfl
    have hφ : IsScalarTower.toAlgHom L L[X] (FunctionField W)
        = (aeval (C6.genX W) : L[X] →ₐ[L] (FunctionField W)) := by
      apply Polynomial.algHom_ext
      rw [Polynomial.aeval_X]
      exact hφX
    have hmem : (aeval (C6.genX W) : L[X] →ₐ[L] (FunctionField W)) p
        ∈ (aeval (C6.genX W) : L[X] →ₐ[L] (FunctionField W)).range := ⟨p, rfl⟩
    rw [← Algebra.adjoin_singleton_eq_range_aeval L (C6.genX W)] at hmem
    rw [← hφ] at hmem
    have hsub : Algebra.adjoin L ({C6.genX W} : Set (FunctionField W)) ≤ F.toSubalgebra :=
      Algebra.adjoin_le (by
        intro z hz
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact hx)
    have := hsub hmem
    simpa [IsScalarTower.coe_toAlgHom] using this
  have hcoe : ∀ p : L[X], CoordinateRing.mk W (Polynomial.C p)
      = algebraMap L[X] (CoordinateRing W) p := fun p => by
    rw [AdjoinRoot.algebraMap_eq]
    exact (AdjoinRoot.mk_C (f := WeierstrassCurve.Affine.polynomial W) p).symm
  -- The image of the coordinate ring `R = L[W]` in `K` lies in `F`.
  have hR : ∀ r : CoordinateRing W, algebraMap (CoordinateRing W) (FunctionField W) r ∈ F := by
    intro r
    obtain ⟨p, q, hpq⟩ := CoordinateRing.exists_smul_basis_eq (W' := W) r
    have h1 : ∀ p : L[X], algebraMap (CoordinateRing W) (FunctionField W) (p • (1 : CoordinateRing W))
        = algebraMap L[X] (FunctionField W) p := fun p => by
      rw [CoordinateRing.smul, mul_one, hcoe p]
      rw [← IsScalarTower.algebraMap_apply L[X] (CoordinateRing W) (FunctionField W)]
    have hX : CoordinateRing.mk W (Y : L[X][Y])
        = AdjoinRoot.root (WeierstrassCurve.Affine.polynomial W) := by
      rw [AdjoinRoot.mk_X]
    have h2 : ∀ q : L[X], algebraMap (CoordinateRing W) (FunctionField W)
          (q • CoordinateRing.mk W (Y : L[X][Y]))
        = algebraMap L[X] (FunctionField W) q * C6.genY W := fun q => by
      rw [CoordinateRing.smul, map_mul, hcoe q]
      rw [← IsScalarTower.algebraMap_apply L[X] (CoordinateRing W) (FunctionField W)]
      rw [hX]
      rfl
    rw [← hpq, map_add, h1 p, h2 q]
    exact add_mem (hLX p) (mul_mem (hLX q) hy)
  -- `K` is the fraction field of (the image of) `R`.
  rw [eq_top_iff]
  intro k _
  obtain ⟨a, b, hb, hk⟩ := IsFractionRing.div_surjective (CoordinateRing W) k
  rw [← hk]
  exact div_mem (hR a) (hR b)

end Work.MotC
