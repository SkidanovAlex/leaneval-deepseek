import Mathlib
import Submission.Work.TorsorExistence.Defs

set_option linter.unusedVariables false -- v435-speed

/-!
# Transport of order-five automorphisms along a linearly disjoint compositum

The target `Work.MotC.exists_algEquiv_fixedField` is the descent step of the twisted-function-field
chapter `Work.MotC`.  Let `Cyc : CyclicExtension 𝕜 5` be a cyclic quintic extension `L/𝕜` with
generator `gen`, and let `K` be a field with `𝕜 → L → K` (a tower).  Let `α, β : K ≃ₐ[𝕜] K` be
order-five automorphisms, neither equal to `1`, which both act on the constants `L` through
`gen`.  Write `F = K^{⟨α⟩}` and `F' = K^{⟨β⟩}` for their fixed fields, and let `B` be the image of
`L` in `K`.  Given a `𝕜`-algebra isomorphism `θ : F ≃ₐ[𝕜] F'`, we construct an `L`-algebra
automorphism `Θ` of `K` which extends `θ` and intertwines `α` with `β`, i.e. `Θ α = β Θ`.

The construction is the natural one: `F` and `L` are linearly disjoint with compositum `K`
(`fixedField_descent_two`), so `K ≅ F ⊗[𝕜] L`, and `Θ` is `θ ⊗ id` transferred to `K`.  The
intertwining `Θ α = β Θ` is then checked by noting that `Θ α Θ⁻¹` and `β` are both `𝕜`-algebra
automorphisms of `K` which fix `F'` pointwise and act as `gen` on `L`; since `K` is generated by
`F' ∪ L` (i.e. `F' ⊔ L = ⊤`), they coincide.

The only field-theoretic input is the Galois descent of the fixed field of an order-five
automorphism which acts as a generator on the cyclic quintic constants.  This is proved here
directly, by two elementary degree counts:

* `F` and `K` satisfy `[K : F] = 5` (Artin's theorem, `FixedPoints.finrank_eq_card`, which needs
  no finiteness assumption on `K/𝕜`);
* hence `[F·L : F]` divides `5` and is `≠ 1` (as `L ⊄ F`), so it is `5`, and `F·L = K`;
* the multiplication map `F ⊗[𝕜] L → K` is therefore a surjection between `F`-vector spaces of
  dimension `[L : 𝕜] = 5 = [K : F]`, hence injective: `F` and `L` are linearly disjoint.
-/

set_option linter.style.haveILetI false

open IntermediateField

namespace Work.MotC

/-- **Linear disjointness from a dimension count.**  Let `A`, `B` be intermediate fields of
`K/𝕜` whose compositum is everything, and suppose that `[K : A] = [B : 𝕜]` with `B/𝕜` finite.
Then the multiplication map `A ⊗[𝕜] B → K` is an `A`-linear surjection between `A`-vector spaces
of the same finite dimension, hence injective: `A` and `B` are linearly disjoint over `𝕜`.

(Note that `A` need not be finite over `𝕜`; only the "small" factor `B` is assumed finite.) -/
theorem linearDisjoint_of_finrank_eq {S : Type*} [Field S] {K : Type*} [Field K] [Algebra S K]
    (A B : IntermediateField S K) (hAB : A.toSubalgebra ⊔ B.toSubalgebra = ⊤)
    (hfin : Module.finrank ↥A K = Module.finrank S ↥B) [FiniteDimensional S ↥B] :
    A.LinearDisjoint B := by
  rw [IntermediateField.linearDisjoint_iff']
  let m : AlgHom ↥A (TensorProduct S ↥A ↥B) K :=
    Algebra.TensorProduct.productLeftAlgHom (Algebra.ofId ↥A K) B.val
  have hm : (m : TensorProduct S ↥A ↥B → K) =
      (A.toSubalgebra.mulMap B.toSubalgebra : TensorProduct S ↥A ↥B → K) := by
    ext x
    induction x using TensorProduct.induction_on with
    | zero => simp [m]
    | add x y hx hy => simp [map_add, hx, hy]
    | tmul a b => exact (Subalgebra.mulMap_tmul A.toSubalgebra B.toSubalgebra a b).symm
  rw [Subalgebra.linearDisjoint_iff_injective, ← hm]
  have hm' : ∀ z, m z = A.toSubalgebra.mulMap B.toSubalgebra z := fun z => congrFun hm z
  haveI : Nontrivial ↥B := ⟨⟨1, B.one_mem⟩, ⟨0, B.zero_mem⟩, by simp⟩
  have hpos : 0 < Module.finrank S ↥B := Module.finrank_pos_iff.mpr inferInstance
  haveI : FiniteDimensional ↥A (TensorProduct S ↥A ↥B) :=
    Module.finite_of_finrank_pos (by rw [Module.finrank_baseChange]; exact hpos)
  haveI : FiniteDimensional ↥A K :=
    Module.finite_of_finrank_pos (by rw [hfin]; exact hpos)
  refine (LinearMap.injective_iff_surjective_of_finrank_eq_finrank ?_).mpr ?_
  · show Module.finrank ↥A (TensorProduct S ↥A ↥B) = Module.finrank ↥A K
    rw [Module.finrank_baseChange, hfin]
  · intro x
    have hsurj : Function.Surjective (A.toSubalgebra.mulMap B.toSubalgebra) := by
      rw [← AlgHom.range_eq_top, Subalgebra.mulMap_range]
      exact hAB
    obtain ⟨y, hy⟩ := hsurj x
    exact ⟨y, (hm' y).symm ▸ hy⟩

/-- **Galois descent for an order-five automorphism** acting as the generator on the cyclic
quintic constants `L`: the fixed field `F = K^{⟨α⟩}` is linearly disjoint from `L` over `𝕜`, and
`F · L = K`. -/
theorem fixedField_descent_two {𝕜 : Type} [Field 𝕜]
    (Cyc : Work.TorsorExistence.CyclicExtension 𝕜 5)
    (K : Type*) [Field K] [Algebra 𝕜 K] [Algebra Cyc.L K] [IsScalarTower 𝕜 Cyc.L K]
    (α : K ≃ₐ[𝕜] K) (h5 : α ^ 5 = 1) (hne : α ≠ 1)
    (hαL : ∀ l : Cyc.L, α (algebraMap Cyc.L K l) = algebraMap Cyc.L K (Cyc.gen l)) :
    (IntermediateField.fixedField (Subgroup.zpowers α)).LinearDisjoint Cyc.L ∧
      (IntermediateField.fixedField (Subgroup.zpowers α) ⊔
          (IsScalarTower.toAlgHom 𝕜 Cyc.L K).fieldRange = ⊤) := by
  set F : IntermediateField 𝕜 K := IntermediateField.fixedField (Subgroup.zpowers α) with hF
  set B : IntermediateField 𝕜 K := (IsScalarTower.toAlgHom 𝕜 Cyc.L K).fieldRange with hB
  have hxF : Module.finrank ↥F K = 5 := by
    have hfin : IsOfFinOrder α := isOfFinOrder_iff_pow_eq_one.mpr ⟨5, by norm_num, h5⟩
    haveI : Fintype ↥(Subgroup.zpowers α) :=
      Fintype.ofEquiv (Fin (orderOf α)) (finEquivZPowers hfin)
    have hord : orderOf α = 5 := by
      haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
      exact orderOf_eq_prime h5 hne
    have hcard : Fintype.card ↥(Subgroup.zpowers α) = 5 := by
      rw [← Nat.card_eq_fintype_card, Nat.card_zpowers, hord]
    rw [hF, ← hcard]
    exact FixedPoints.finrank_eq_card ↥(Subgroup.zpowers α) K
  have hgen : Cyc.gen ≠ 1 := by
    intro h
    have h5' := Cyc.orderOf_gen
    rw [h, orderOf_one] at h5'
    norm_num at h5'
  have hBF : ¬ (B ≤ F) := by
    intro hle
    obtain ⟨l, hl⟩ : ∃ l : Cyc.L, Cyc.gen l ≠ l := by
      by_contra h
      push_neg at h
      exact hgen (AlgEquiv.ext h)
    have hmem : algebraMap Cyc.L K l ∈ F := by
      rw [hF]
      exact hle (show algebraMap Cyc.L K l ∈ B from ⟨l, rfl⟩)
    have hfix : α (algebraMap Cyc.L K l) = algebraMap Cyc.L K l := by
      rw [hF, IntermediateField.mem_fixedField_iff] at hmem
      exact hmem α (Subgroup.mem_zpowers α)
    rw [hαL l] at hfix
    exact hl ((algebraMap Cyc.L K).injective hfix)
  have hrel : F.relfinrank (F ⊔ B) * Module.finrank ↥(F ⊔ B) K = 5 := by
    rw [IntermediateField.relfinrank_mul_finrank_top le_sup_left, hxF]
  have hdvd : F.relfinrank (F ⊔ B) ∣ 5 := by
    rw [← hxF]; exact IntermediateField.relfinrank_dvd_finrank_top_of_le le_sup_left
  have hne1 : F.relfinrank (F ⊔ B) ≠ 1 := by
    intro h1
    exact hBF (le_sup_right.trans (IntermediateField.relfinrank_eq_one_iff.mp h1))
  have hrel5 : F.relfinrank (F ⊔ B) = 5 := by
    rcases Nat.Prime.eq_one_or_self_of_dvd (by norm_num : Nat.Prime 5) _ hdvd with h | h
    · exact absurd h hne1
    · exact h
  have hEK : Module.finrank ↥(F ⊔ B) K = 1 := by
    rw [hrel5] at hrel; omega
  have hEtop : F ⊔ B = ⊤ := IntermediateField.finrank_eq_one_iff_eq_top.mp hEK
  have hBfin : Module.finrank 𝕜 ↥B = 5 := by
    rw [hB, ← (AlgHom.equivFieldRange (IsScalarTower.toAlgHom 𝕜 Cyc.L K)).toLinearEquiv.finrank_eq,
      Cyc.finrank_eq]
  haveI : FiniteDimensional 𝕜 ↥B := Module.finite_of_finrank_pos (by rw [hBfin]; norm_num)
  have hABs : F.toSubalgebra ⊔ B.toSubalgebra = ⊤ := by
    rw [← IntermediateField.sup_toSubalgebra_of_isAlgebraic_right (E1 := F) (E2 := B),
      hEtop, IntermediateField.top_toSubalgebra]
  have hdj : F.LinearDisjoint B := by
    refine linearDisjoint_of_finrank_eq F B hABs ?_
    rw [hxF, hBfin]
  constructor
  · have hdj' : F.toSubalgebra.LinearDisjoint (IsScalarTower.toAlgHom 𝕜 Cyc.L K).range := by
      rw [IntermediateField.linearDisjoint_iff'] at hdj
      rwa [hB, AlgHom.fieldRange_toSubalgebra] at hdj
    exact hdj'
  · rw [hF, hB] at hEtop ⊢
    exact hEtop

/-- Given order-five automorphisms `α`, `β` of `K/𝕜` which act as the generator of the cyclic
quintic extension `L/𝕜` on the constants, and a `𝕜`-isomorphism `θ` between their fixed fields,
there is an `L`-algebra automorphism `Θ` of `K` extending `θ` and intertwining `α` and `β`. -/
theorem exists_algEquiv_fixedField {𝕜 : Type} [Field 𝕜]
    (Cyc : Work.TorsorExistence.CyclicExtension 𝕜 5)
    (K : Type*) [Field K] [Algebra 𝕜 K] [Algebra Cyc.L K] [IsScalarTower 𝕜 Cyc.L K]
    (α β : K ≃ₐ[𝕜] K) (hα5 : α ^ 5 = 1) (hβ5 : β ^ 5 = 1) (hαne : α ≠ 1) (hβne : β ≠ 1)
    (hαL : ∀ l : Cyc.L, α (algebraMap Cyc.L K l) = algebraMap Cyc.L K (Cyc.gen l))
    (hβL : ∀ l : Cyc.L, β (algebraMap Cyc.L K l) = algebraMap Cyc.L K (Cyc.gen l))
    (θ : ↥(IntermediateField.fixedField (Subgroup.zpowers α)) ≃ₐ[𝕜]
         ↥(IntermediateField.fixedField (Subgroup.zpowers β))) :
    ∃ Θ : K ≃ₐ[Cyc.L] K,
      (∀ a : ↥(IntermediateField.fixedField (Subgroup.zpowers α)), Θ (a : K) = (θ a : K)) ∧
      (∀ x : K, Θ (α x) = β (Θ x)) := by
  let F : IntermediateField 𝕜 K := IntermediateField.fixedField (Subgroup.zpowers α)
  let F' : IntermediateField 𝕜 K := IntermediateField.fixedField (Subgroup.zpowers β)
  let B : IntermediateField 𝕜 K := (IsScalarTower.toAlgHom 𝕜 Cyc.L K).fieldRange
  obtain ⟨hαdj, hαsup⟩ := fixedField_descent_two Cyc K α hα5 hαne hαL
  obtain ⟨hβdj, hβsup⟩ := fixedField_descent_two Cyc K β hβ5 hβne hβL
  have hαdj' : F.toSubalgebra.LinearDisjoint B.toSubalgebra := hαdj
  have hβdj' : F'.toSubalgebra.LinearDisjoint B.toSubalgebra := hβdj
  have hBfin : Module.finrank 𝕜 ↥B = 5 := by
    show Module.finrank 𝕜 ↥((IsScalarTower.toAlgHom 𝕜 Cyc.L K).fieldRange) = 5
    rw [← (AlgHom.equivFieldRange (IsScalarTower.toAlgHom 𝕜 Cyc.L K)).toLinearEquiv.finrank_eq,
      Cyc.finrank_eq]
  haveI : FiniteDimensional 𝕜 ↥B := Module.finite_of_finrank_pos (by rw [hBfin]; norm_num)
  have hαsup' : F.toSubalgebra ⊔ B.toSubalgebra = ⊤ := by
    rw [← IntermediateField.sup_toSubalgebra_of_isAlgebraic_right (E1 := F) (E2 := B)]
    exact (congrArg (fun E : IntermediateField 𝕜 K => E.toSubalgebra) hαsup).trans
      IntermediateField.top_toSubalgebra
  have hβsup' : F'.toSubalgebra ⊔ B.toSubalgebra = ⊤ := by
    rw [← IntermediateField.sup_toSubalgebra_of_isAlgebraic_right (E1 := F') (E2 := B)]
    exact (congrArg (fun E : IntermediateField 𝕜 K => E.toSubalgebra) hβsup).trans
      IntermediateField.top_toSubalgebra
  -- the two tensor-product descriptions of `K`
  let θ' : ↥(F.toSubalgebra) ≃ₐ[𝕜] ↥(F'.toSubalgebra) := θ
  let eα : TensorProduct 𝕜 ↥(F.toSubalgebra) ↥(B.toSubalgebra) ≃ₐ[𝕜] K :=
    (Subalgebra.LinearDisjoint.mulMap hαdj').trans
      ((Subalgebra.equivOfEq _ _ hαsup').trans Subalgebra.topEquiv)
  let eβ : TensorProduct 𝕜 ↥(F'.toSubalgebra) ↥(B.toSubalgebra) ≃ₐ[𝕜] K :=
    (Subalgebra.LinearDisjoint.mulMap hβdj').trans
      ((Subalgebra.equivOfEq _ _ hβsup').trans Subalgebra.topEquiv)
  let g : TensorProduct 𝕜 ↥(F.toSubalgebra) ↥(B.toSubalgebra) ≃ₐ[𝕜]
      TensorProduct 𝕜 ↥(F'.toSubalgebra) ↥(B.toSubalgebra) :=
    Algebra.TensorProduct.congr θ' (AlgEquiv.refl : ↥(B.toSubalgebra) ≃ₐ[𝕜] ↥(B.toSubalgebra))
  let Θ₀ : K ≃ₐ[𝕜] K := eα.symm.trans (g.trans eβ)
  have hαmul : ∀ (a : ↥(F.toSubalgebra)) (b : ↥(B.toSubalgebra)),
      eα (a ⊗ₜ[𝕜] b) = (a : K) * (b : K) := by
    intro a b
    simp only [eα, AlgEquiv.trans_apply]
    exact Subalgebra.LinearDisjoint.val_mulMap_tmul hαdj' a b
  have hβmul : ∀ (a : ↥(F'.toSubalgebra)) (b : ↥(B.toSubalgebra)),
      eβ (a ⊗ₜ[𝕜] b) = (a : K) * (b : K) := by
    intro a b
    simp only [eβ, AlgEquiv.trans_apply]
    exact Subalgebra.LinearDisjoint.val_mulMap_tmul hβdj' a b
  have gmul : ∀ (a : ↥(F.toSubalgebra)) (b : ↥(B.toSubalgebra)),
      g (a ⊗ₜ[𝕜] b) = θ' a ⊗ₜ[𝕜] b := by
    intro a b
    rw [show g (a ⊗ₜ[𝕜] b)
        = Algebra.TensorProduct.map (θ' : ↥(F.toSubalgebra) →ₐ[𝕜] ↥(F'.toSubalgebra))
            (AlgEquiv.refl : ↥(B.toSubalgebra) ≃ₐ[𝕜] ↥(B.toSubalgebra)) (a ⊗ₜ[𝕜] b) from rfl,
      Algebra.TensorProduct.map_tmul]
    rfl
  have hmemB : ∀ l : Cyc.L, algebraMap Cyc.L K l ∈ B.toSubalgebra := by
    intro l
    exact ⟨l, rfl⟩
  -- `Θ₀` fixes the constants `L`
  have keyB : ∀ b : ↥(B.toSubalgebra), Θ₀ (b : K) = (b : K) := by
    intro b
    have h1 : eα (1 ⊗ₜ[𝕜] b) = (b : K) := by simpa using hαmul (1 : ↥(F.toSubalgebra)) b
    have h2 : eα.symm (b : K) = 1 ⊗ₜ[𝕜] b := eα.symm_apply_eq.mpr h1.symm
    have h3 : g (1 ⊗ₜ[𝕜] b) = 1 ⊗ₜ[𝕜] b := by simpa using gmul (1 : ↥(F.toSubalgebra)) b
    have h4 : eβ (1 ⊗ₜ[𝕜] b) = (b : K) := by simpa using hβmul (1 : ↥(F'.toSubalgebra)) b
    simp only [Θ₀, AlgEquiv.trans_apply, h2, h3, h4]
  -- `Θ₀` extends `θ`
  have keyF : ∀ a : ↥(F.toSubalgebra), Θ₀ (a : K) = (θ' a : K) := by
    intro a
    have h1 : eα (a ⊗ₜ[𝕜] 1) = (a : K) := by simpa using hαmul a (1 : ↥(B.toSubalgebra))
    have h2 : eα.symm (a : K) = a ⊗ₜ[𝕜] 1 := eα.symm_apply_eq.mpr h1.symm
    have h3 : g (a ⊗ₜ[𝕜] 1) = θ' a ⊗ₜ[𝕜] 1 := by simpa using gmul a (1 : ↥(B.toSubalgebra))
    have h4 : eβ (θ' a ⊗ₜ[𝕜] 1) = (θ' a : K) := by
      simpa using hβmul (θ' a) (1 : ↥(B.toSubalgebra))
    simp only [Θ₀, AlgEquiv.trans_apply, h2, h3, h4]
  -- `Θ₀` intertwines `α` and `β`
  have key3 : ∀ x : K, Θ₀ (α x) = β (Θ₀ x) := by
    let φ : K →ₐ[𝕜] K := Θ₀.toAlgHom.comp (α.toAlgHom.comp Θ₀.symm.toAlgHom)
    have hle : F'.toSubalgebra ⊔ B.toSubalgebra ≤ φ.equalizer β.toAlgHom := by
      apply sup_le
      · intro y hy
        rw [AlgHom.mem_equalizer]
        obtain ⟨a, ha⟩ : ∃ a : ↥F, (θ a : K) = y := ⟨θ.symm ⟨y, hy⟩, by simp⟩
        have hβy : β y = y := by
          have hy' : y ∈ IntermediateField.fixedField (Subgroup.zpowers β) := hy
          rw [IntermediateField.mem_fixedField_iff] at hy'
          exact hy' β (Subgroup.mem_zpowers β)
        have haF : α (a : K) = (a : K) := by
          have ha' : (a : K) ∈ IntermediateField.fixedField (Subgroup.zpowers α) := a.2
          rw [IntermediateField.mem_fixedField_iff] at ha'
          exact ha' α (Subgroup.mem_zpowers α)
        have hsymm : Θ₀.symm y = (a : K) :=
          Θ₀.symm_apply_eq.mpr (by rw [keyF a]; exact ha.symm)
        show φ y = β y
        rw [hβy]
        show φ y = y
        simp only [φ, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
        rw [hsymm, haF, keyF a, ha]
      · intro b hb
        rw [AlgHom.mem_equalizer]
        have hb' : b ∈ (IsScalarTower.toAlgHom 𝕜 Cyc.L K).fieldRange := hb
        obtain ⟨l, hl⟩ := AlgHom.mem_fieldRange.mp hb'
        have hbsym : Θ₀.symm b = b := Θ₀.symm_apply_eq.mpr (by rw [keyB ⟨b, hb⟩])
        have hαb : α b = algebraMap Cyc.L K (Cyc.gen l) := by rw [← hl]; exact hαL l
        have hΘ : Θ₀ (algebraMap Cyc.L K (Cyc.gen l)) = algebraMap Cyc.L K (Cyc.gen l) :=
          keyB ⟨algebraMap Cyc.L K (Cyc.gen l), hmemB (Cyc.gen l)⟩
        have hβb : β b = algebraMap Cyc.L K (Cyc.gen l) := by rw [← hl]; exact hβL l
        show φ b = β b
        simp only [φ, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
        rw [hbsym, hαb, hΘ, hβb]
    rw [hβsup'] at hle
    have htop : φ.equalizer β.toAlgHom = ⊤ := le_antisymm le_top hle
    have heq : φ = β.toAlgHom := AlgHom.equalizer_eq_top.mp htop
    intro y
    have h1 : φ (Θ₀ y) = β (Θ₀ y) := DFunLike.congr_fun heq (Θ₀ y)
    have h2 : φ (Θ₀ y) = Θ₀ (α y) := by
      simp only [φ, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [AlgEquiv.symm_apply_apply]
    rwa [h2] at h1
  -- package `Θ₀` as an `L`-algebra automorphism
  let Θ : K ≃ₐ[Cyc.L] K :=
    AlgEquiv.ofRingEquiv (f := Θ₀.toRingEquiv) (fun l => keyB ⟨algebraMap Cyc.L K l, hmemB l⟩)
  have hΘ : ∀ y : K, Θ y = Θ₀ y := by
    intro y
    simp only [Θ, AlgEquiv.ofRingEquiv_apply, AlgEquiv.coe_ringEquiv]
  exact ⟨Θ, fun a => by rw [hΘ]; exact keyF a, fun x => by rw [hΘ, hΘ]; exact key3 x⟩

end Work.MotC
