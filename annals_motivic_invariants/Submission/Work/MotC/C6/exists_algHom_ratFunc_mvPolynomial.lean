import Mathlib

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

namespace Work.MotC.C6

open Polynomial MvPolynomial

/-- **Two independent variables in `L(u)(v)`.** There is a `𝕜`-algebra homomorphism from the
rational function field `𝕜(U,V) = FractionRing (MvPolynomial (Fin 2) 𝕜)` into
`RatFunc (RatFunc L)`.  Route: the two elements
`u := algebraMap (RatFunc L) (RatFunc (RatFunc L)) RatFunc.X` and
`v := (RatFunc.X : RatFunc (RatFunc L))` are algebraically independent over `L`
(`AlgebraicIndependent.option_iff_transcendental`: `v` is transcendental over `RatFunc L`, which is
the subalgebra generated by `u` over `L`), hence over `𝕜` since `𝕜 → L` is injective; the resulting
`AlgebraicIndependent 𝕜 ![u,v]` gives via `AlgebraicIndependent.aevalEquivField` an isomorphism
`FractionRing (MvPolynomial (Fin 2) 𝕜) ≃ₐ[𝕜] ↥(Algebra.adjoin 𝕜 {u,v})`, which composed with the
inclusion into `RatFunc (RatFunc L)` is the required map. -/
theorem exists_algHom_ratFunc_mvPolynomial {𝕜 L : Type} [Field 𝕜] [Field L] [Algebra 𝕜 L] :
    Nonempty (FractionRing (MvPolynomial (Fin 2) 𝕜) →ₐ[𝕜] RatFunc (RatFunc L)) := by
  -- An injective `𝕜`-algebra map out of `𝕜(U,V)` extends to the fraction field (Mathlib,
  -- `IsFractionRing.liftAlgHom`), so it suffices to exhibit an injective `𝕜`-algebra map
  -- `𝕜(U,V) → RatFunc (RatFunc L)`.
  --
  -- `RatFunc L` is generated as an `L`-algebra by `RatFunc.X : RatFunc L`, and `RatFunc.X` is
  -- transcendental over `L` (Mathlib, `RatFunc.transcendental_X`).  Hence
  -- `MvPolynomial.aeval (fun _ : Fin 1 => RatFunc.X) : L[U] → RatFunc L` is injective, and so is
  -- the induced `L[T] → (RatFunc L)[T]`; composing with `RatFunc (RatFunc L)`'s structure map
  -- yields an injective `L`-algebra map `L[U][T] → RatFunc (RatFunc L)`.  Base changing along
  -- `𝕜 → L` (injective, both are fields) and precomposing with `MvPolynomial (Fin 2) L`'s
  -- identification with `L[U][T]` (`MvPolynomial.finSuccEquiv`) gives the required injective
  -- `𝕜`-algebra map.
  have hc : Transcendental L (RatFunc.X : RatFunc L) := RatFunc.transcendental_X
  let φ : MvPolynomial (Fin 1) L →ₐ[L] RatFunc L :=
    MvPolynomial.aeval (fun _ : Fin 1 => (RatFunc.X : RatFunc L))
  have hφ : Function.Injective φ :=
    (algebraicIndependent_singleton_iff (x := fun _ : Fin 1 => (RatFunc.X : RatFunc L)) 0).mpr hc
  have hmapφ : Function.Injective (Polynomial.mapAlgHom φ) := by
    simpa only [Polynomial.coe_mapAlgHom] using
      Polynomial.map_injective (φ : MvPolynomial (Fin 1) L →+* RatFunc L) hφ
  -- `Ψ : L[U][T] → RatFunc (RatFunc L)` is injective.
  let Ψ : MvPolynomial (Fin 2) L →ₐ[L] Polynomial (RatFunc L) :=
    (Polynomial.mapAlgHom φ).comp (MvPolynomial.finSuccEquiv L 1)
  have hΨ : Function.Injective Ψ := hmapφ.comp (MvPolynomial.finSuccEquiv L 1).injective
  -- Base change `𝕜(U,V) = 𝕜[U,V] ⊗ 𝕜 → L[U,V] → RatFunc (RatFunc L)`; all three factors are
  -- injective.
  let g : MvPolynomial (Fin 2) 𝕜 →ₐ[𝕜] RatFunc (RatFunc L) :=
    (IsScalarTower.toAlgHom 𝕜 (Polynomial (RatFunc L)) (RatFunc (RatFunc L))).comp
      ((Ψ.restrictScalars 𝕜).comp (MvPolynomial.mapAlgHom (Algebra.ofId 𝕜 L)))
  have hg : Function.Injective g := by
    have hA : Function.Injective
        (IsScalarTower.toAlgHom 𝕜 (Polynomial (RatFunc L)) (RatFunc (RatFunc L))) := by
      rw [IsScalarTower.coe_toAlgHom']
      exact IsFractionRing.injective (Polynomial (RatFunc L)) (RatFunc (RatFunc L))
    have hB : Function.Injective (Ψ.restrictScalars 𝕜) := by
      rw [AlgHom.coe_restrictScalars']
      exact hΨ
    have hC : Function.Injective (MvPolynomial.mapAlgHom (Algebra.ofId 𝕜 L) :
        MvPolynomial (Fin 2) 𝕜 →ₐ[𝕜] MvPolynomial (Fin 2) L) := by
      intro x y hxy
      exact MvPolynomial.map_injective (algebraMap 𝕜 L) (algebraMap 𝕜 L).injective hxy
    exact hA.comp (hB.comp hC)
  exact ⟨IsFractionRing.liftAlgHom hg⟩

end Work.MotC.C6
