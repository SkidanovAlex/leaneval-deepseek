# The local ring of an affine rational point of an elliptic curve is a rational place

This file proves `Work.MotC2.AffPlace`: for an elliptic Weierstrass curve `E` over a field `L` and a
nonsingular affine point `(a, b)`, the `L`-subalgebra `affPlaceAt E a b ⊆ L(E)` generated by the
coordinate ring and the inverses of the elements outside `⟨x - a, y - b⟩` is the local ring of the
rational place `(a, b)`: a discrete valuation ring whose residue field is `L`.  Moreover its
elements are exactly the fractions `r / g` with `g ∉ ⟨x - a, y - b⟩`.

## Tags

elliptic curve, function field, place, discrete valuation ring
-/

import Mathlib
import Submission.Work.MotC2.Defs
import Submission.Work.MotC2.Relations
import Submission.Work.MotC2.AffPlaceSetup
import Submission.Work.MotC2.AffPlaceMaxIdealPrincipal
import Submission.Work.MotC2.AffPlaceResidueField

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

open Polynomial WeierstrassCurve.Affine

set_option maxHeartbeats 1000000

namespace Work.MotC2

variable {L : Type*} [Field L]

/-- The image of `x - a` in `↥(affPlaceAt E a b)` is nonzero. -/
lemma affPlaceAt_algebraMap_XClass_ne_zero (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.XClass E a) ≠ 0 := by
  intro h0
  have h1 : algebraMap (Coord E) (Func E) (CoordinateRing.XClass E a) = 0 := by
    rw [← affPlaceAt_algebraMap_val E a b (CoordinateRing.XClass E a), h0]
    rfl
  exact CoordinateRing.XClass_ne_zero (W' := E) a
    (IsFractionRing.injective (Coord E) (Func E) (by simpa using h1))

/-- The maximal ideal of `↥(affPlaceAt E a b)` is not zero. -/
lemma affPlaceAt_maximalIdeal_ne_bot (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] : IsLocalRing.maximalIdeal ↥(affPlaceAt E a b) ≠ ⊥ := by
  intro hbot
  have hmem := affPlaceAt_XClass_mem_maximalIdeal E a b
  rw [hbot] at hmem
  exact affPlaceAt_algebraMap_XClass_ne_zero E a b hmem

/-- `↥(affPlaceAt E a b)` is not a field. -/
lemma affPlaceAt_not_isField (E : WeierstrassCurve L) (a b : L) [IsNonsingularPoint E a b] :
    ¬ IsField ↥(affPlaceAt E a b) := by
  rw [IsLocalRing.isField_iff_maximalIdeal_eq]
  exact affPlaceAt_maximalIdeal_ne_bot E a b

/-- `↥(affPlaceAt E a b)` is a discrete valuation ring. -/
lemma affPlaceAt_isDiscreteValuationRing (E : WeierstrassCurve L) [E.IsElliptic] (a b : L)
    [IsNonsingularPoint E a b] : IsDiscreteValuationRing ↥(affPlaceAt E a b) := by
  have hprincipal : (IsLocalRing.maximalIdeal ↥(affPlaceAt E a b)).IsPrincipal :=
    AffPlaceMaxIdealPrincipal L E a b
  have hiff : (IsLocalRing.maximalIdeal ↥(affPlaceAt E a b)).IsPrincipal ↔
      IsDiscreteValuationRing ↥(affPlaceAt E a b) :=
    (IsDiscreteValuationRing.TFAE ↥(affPlaceAt E a b) (affPlaceAt_not_isField E a b)).out 5 1
  exact hiff.mp hprincipal

/-- Every element of the function field is a ratio of two elements of `affPlaceAt E a b`. -/
lemma affPlaceAt_fraction_field (E : WeierstrassCurve L) (a b : L) :
    ∀ f : Func E, ∃ s₁ s₂ : ↥(affPlaceAt E a b),
      (s₂ : Func E) ≠ 0 ∧ f * (s₂ : Func E) = (s₁ : Func E) := by
  intro f
  obtain ⟨x, hx⟩ := IsLocalization.surj (nonZeroDivisors (Coord E)) f
  refine ⟨⟨algebraMap (Coord E) (Func E) x.1, algebraMap_mem_affPlaceAt E a b x.1⟩,
    ⟨algebraMap (Coord E) (Func E) (x.2 : Coord E), algebraMap_mem_affPlaceAt E a b x.2⟩,
    ?_, ?_⟩
  · intro h0
    have h1 : (x.2 : Coord E) = 0 := by
      refine IsFractionRing.injective (Coord E) (Func E) ?_
      rw [map_zero]
      simpa using h0
    exact (mem_nonZeroDivisors_iff_ne_zero.mp x.2.property) h1
  · exact hx

/-
GUIDANCE.  `affPlaceAt E a b = Algebra.adjoin L (range (algebraMap (Coord E) (Func E)) ∪
{ (algebraMap (Coord E) (Func E) r)⁻¹ | r ∉ CoordinateRing.XYIdeal E a (C b) })` is the
localization of `Coord E` at the maximal ideal `I = ⟨x - a, y - b⟩` (maximal because
`CoordinateRing.quotientXYIdealEquiv h` gives `Coord E ⧸ I ≃ₐ[L] L`).

Second conjunct: `←` is immediate; `→` follows since every generator is of the form `r/g` with
`g ∉ I`, and sums/products of such stay in that form (multiply out, using that `I` is prime).

First conjunct: `S = affPlaceAt E a b` is a local ring with maximal ideal generated by the image of
`x - a` (or of `y - b`, whichever is a local parameter at `(a,b)`): expand the Weierstrass
polynomial around `(a, b)`, `0 = W_X(a,b)(x-a) + W_Y(a,b)(y-b) + Q`, with `Q ∈ (x-a, y-b)²`, and use
`Nonsingular E a b` to solve for one of `x - a`, `y - b` as a unit multiple of the other; hence
`𝔪_S` is principal.  `S` is Noetherian (localization of a finitely generated `L`-algebra), local,
a domain, not a field, so `IsDiscreteValuationRing.TFAE` (item 4: principal maximal ideal) applies.
The residue field is `L` because the images of `x` and `y` in `S ⧸ 𝔪_S` are `a` and `b`: the
canonical map `L → S ⧸ 𝔪_S` is bijective (`IsRatPlace`).
-/
theorem AffPlace (L : Type*) [Field L] (E : WeierstrassCurve L) [E.IsElliptic] (a b : L)
    (h : WeierstrassCurve.Affine.Nonsingular E a b) :
    Work.MotC2.IsRatPlace E (Work.MotC2.affPlaceAt E a b) ∧
    (∀ f : Work.MotC2.Func E, f ∈ Work.MotC2.affPlaceAt E a b ↔
      ∃ r g : Work.MotC2.Coord E,
        g ∉ WeierstrassCurve.Affine.CoordinateRing.XYIdeal E a (Polynomial.C b) ∧
        f * algebraMap (Work.MotC2.Coord E) (Work.MotC2.Func E) g =
          algebraMap (Work.MotC2.Coord E) (Work.MotC2.Func E) r) := by
  haveI : IsNonsingularPoint E a b := ⟨h⟩
  refine ⟨⟨⟨affPlaceAt_isDiscreteValuationRing E a b, AffPlaceResidueField L E a b⟩,
    affPlaceAt_fraction_field E a b⟩, ?_⟩
  intro f
  exact affPlaceAt_mem_iff E a b f

end Work.MotC2
