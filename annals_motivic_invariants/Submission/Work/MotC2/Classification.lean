variable {L : Type*} [Field L]

/-! ## Integrality and integral closedness -/

/-- A rational place is integrally closed in `L(E)`: an element of `L(E)` integral over `S`
belongs to `S`. -/
lemma mem_of_isIntegral {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    (hS : IsRatPlace E S) {f : Func E} (hf : IsIntegral S f) : f ∈ S := by
  obtain ⟨⟨hDVR, -⟩, hfrac⟩ := hS
  haveI : IsFractionRing S (Func E) := isFractionRing_of_forall_mul_eq hfrac
  letI : IsDiscreteValuationRing S := hDVR
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (K := Func E)).mp hf
  rw [← hy]
  exact y.2

/-- `genY E` is integral over any `L`-subalgebra of `L(E)` containing `genX E`. -/
lemma isIntegral_genY_of_mem {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    (hx : genX E ∈ S) : IsIntegral S (genY E) :=
  isIntegral_of_quadratic S
    (algebraMap L (Func E) E.a₁ * genX E + algebraMap L (Func E) E.a₃)
    (-((genX E) ^ 3 + algebraMap L (Func E) E.a₂ * (genX E) ^ 2 +
      algebraMap L (Func E) E.a₄ * genX E + algebraMap L (Func E) E.a₆))
    (add_mem (mul_mem (Subalgebra.algebraMap_mem _ _) hx) (Subalgebra.algebraMap_mem _ _))
    (neg_mem (add_mem (add_mem (add_mem
      (pow_mem hx 3)
      (mul_mem (Subalgebra.algebraMap_mem _ _) (pow_mem hx 2)))
      (mul_mem (Subalgebra.algebraMap_mem _ _) hx))
      (Subalgebra.algebraMap_mem _ _)))
    (by linear_combination genY_sq_relation E)

/-- `infW E` is integral over any `L`-subalgebra of `L(E)` containing `infU E`. -/
lemma isIntegral_infW_of_mem {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    (hu : infU E ∈ S) : IsIntegral S (infW E) :=
  isIntegral_of_quadratic S
    (algebraMap L (Func E) E.a₁ * infU E + algebraMap L (Func E) E.a₃ * (infU E) ^ 2)
    (-(infU E + algebraMap L (Func E) E.a₂ * (infU E) ^ 2 +
      algebraMap L (Func E) E.a₄ * (infU E) ^ 3 +
      algebraMap L (Func E) E.a₆ * (infU E) ^ 4))
    (add_mem (mul_mem (Subalgebra.algebraMap_mem _ _) hu)
      (mul_mem (Subalgebra.algebraMap_mem _ _) (pow_mem hu 2)))
    (neg_mem (add_mem (add_mem (add_mem hu
      (mul_mem (Subalgebra.algebraMap_mem _ _) (pow_mem hu 2)))
      (mul_mem (Subalgebra.algebraMap_mem _ _) (pow_mem hu 3)))
      (mul_mem (Subalgebra.algebraMap_mem _ _) (pow_mem hu 4))))
    (by linear_combination infW_sq_relation E)

/-- The affine coordinate ring `L[x,y] ⊆ L(E)` is the `L`-subalgebra generated by the two
coordinates `x = genX E` and `y = genY E`. -/
lemma affRing_eq_adjoin_genX_genY (E : WeierstrassCurve L) :
    affRing E = Algebra.adjoin L ({genX E, genY E} : Set (Func E)) := by
  refine le_antisymm ?_ ?_
  · rw [affRing]
    refine Algebra.adjoin_le_iff.mpr ?_
    rintro y ⟨r, rfl⟩
    have hle : Algebra.adjoin L ({coordX E, coordY E} : Set (Coord E)) ≤
        Subalgebra.comap (IsScalarTower.toAlgHom L (Coord E) (Func E))
          (Algebra.adjoin L ({genX E, genY E} : Set (Func E))) := by
      refine Algebra.adjoin_le_iff.mpr ?_
      rintro x (rfl | rfl)
      · exact Algebra.subset_adjoin (Or.inl rfl)
      · exact Algebra.subset_adjoin (Or.inr rfl)
    exact hle (by rw [adjoin_coordX_coordY]; trivial)
  · refine Algebra.adjoin_le_iff.mpr ?_
    rintro y (rfl | rfl)
    · exact Algebra.subset_adjoin ⟨coordX E, rfl⟩
    · exact Algebra.subset_adjoin ⟨coordY E, rfl⟩

/-- If `genX E ∈ S` then the whole affine coordinate ring `L[x,y]` is contained in `S`. -/
lemma affRing_le_of_genX_mem {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    (hS : IsRatPlace E S) (hx : genX E ∈ S) : affRing E ≤ S := by
  have hy : genY E ∈ S := mem_of_isIntegral hS (isIntegral_genY_of_mem hx)
  rw [affRing_eq_adjoin_genX_genY E]
  refine Algebra.adjoin_le_iff.mpr ?_
  intro x hx'
  rcases hx' with rfl | rfl
  · exact hx
  · exact hy

/-- The local ring at infinity is a rational place: it is a discrete valuation ring
(`InfPlaceCore.instIsDiscreteValuationRing`), its residue field is `L`
(`InfPlaceCore.residue_field`) and `L(E)` is its fraction field (`InfPlaceCore.frac_field`). -/
lemma isRatPlace_infPlace (E : WeierstrassCurve L) [E.IsElliptic] :
    IsRatPlace E (infPlace E) :=
  ⟨⟨InfPlaceCore.instIsDiscreteValuationRing E, InfPlaceCore.residue_field E⟩,
    InfPlaceCore.frac_field E⟩

/-! ## The valuation dichotomy and the unit criterion -/

/-- For a rational place `S` and `x : L(E)`, either `x ∈ S` or `x⁻¹ ∈ S`. -/
lemma mem_or_inv_mem_of_isRatPlace {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    (hS : IsRatPlace E S) (x : Func E) : x ∈ S ∨ x⁻¹ ∈ S := by
  obtain ⟨⟨hDVR, -⟩, hfrac⟩ := hS
  letI : IsDiscreteValuationRing S := hDVR
  haveI : ValuationRing S := inferInstance
  by_cases hx : x = 0
  · exact Or.inl (hx ▸ S.zero_mem)
  · exact mem_or_inv_mem_of_preValuationRing S hfrac hx

/-- An element of a rational place outside its maximal ideal is a unit, so its inverse (taken in
`L(E)`) still lies in `S`. -/
lemma inv_mem_of_notMem_maximalIdeal {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    [IsLocalRing S] (f : Func E) (hf : f ∈ S)
    (h : (⟨f, hf⟩ : S) ∉ IsLocalRing.maximalIdeal S) : f⁻¹ ∈ S := by
  obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp h
  have hcoe : (((u : Sˣ) : S) : Func E) = f := by rw [hu]
  have hval : (((u⁻¹ : Sˣ) : S) : Func E) = f⁻¹ := by
    rw [subalgebra_coe_unit_inv S u, hcoe]
  rw [← hval]
  exact ((u⁻¹ : Sˣ) : S).2

end

/-
NOTE: the earlier negative review of this statement was caused by a bug in the definition of
`infPlace`, now fixed (it is the localization of the chart ring at `(1/x, y/x²)`), and by
`IsRatPlace`, which now also records that the fraction field of the subalgebra is `L(E)`.

Route, for a rational place `S` (`IsRatPlace E S`): `S` is a discrete valuation ring, hence a
valuation ring, so for the element `x = genX E` we have `x ∈ S` or `x⁻¹ ∈ S`.

* If `x ∈ S`: `y = genY E` is integral over `L[x]` (`Integral`), and `S` is integrally closed, so
  `L[x,y] ⊆ S`, i.e. `affRing E ≤ S`.  Then the prime `𝔮 = {r : Coord E | algebraMap r ∈ 𝔪_S}` of
  `Coord E` is non-zero (otherwise all non-zero elements of `Coord E` are units of `S`, so
  `S ≅ L(E)` as a ring, contradicting `𝔪_S ≠ ⊥`), hence maximal with
  `Coord E ⧸ 𝔮 ↪ S ⧸ 𝔪_S = L` and `L ≤ Coord E ⧸ 𝔮`, so `Coord E ⧸ 𝔮 ≅ L`; thus
  `𝔮 = XYIdeal E a (C b)` for some `a b : L` with `Nonsingular E a b` (`quotientXYIdealEquiv`,
  `equation_iff_nonsingular`), i.e. `𝔮 = ⟨x - a, y - b⟩`.  Then `affPlaceAt E a b ≤ S` (inverses of
  elements outside `𝔮` are units of `S`), and both are rational places, so `S = affPlaceAt E a b` by
  `DVRMaximal`.
* If `x ∉ S`: then `u = 1/x ∈ S`; `w = y/x²` is integral over `L[u]` (`Integral`) and `S` is
  integrally closed, so `infCoordRing E ≤ S`; `u ∉ Sˣ` (else `x ∈ S`), so `u ∈ 𝔪_S`, and then
  `w ∈ 𝔪_S` because `w² = u·h` with `h ∈ infCoordRing E ⊆ S`; hence `infIdeal E ≤ 𝔪_S`, so
  `infPlace E ≤ S` (inverses of the elements outside `infIdeal E` are units of `S`), and both are
  rational places, so `S = infPlace E` by `DVRMaximal`.
-/
theorem Classification (L : Type*) [Field L] (E : WeierstrassCurve L) [E.IsElliptic]
    (S : Subalgebra L (Work.MotC2.Func E)) (hS : Work.MotC2.IsRatPlace E S) :
    S = Work.MotC2.infPlace E ∨
      ∃ a b : L, WeierstrassCurve.Affine.Nonsingular E a b ∧ S = Work.MotC2.affPlaceAt E a b := by
  obtain ⟨⟨hDVR, hres⟩, hfrac⟩ := hS
  letI : IsDiscreteValuationRing S := hDVR
  by_cases hx : genX E ∈ S
  · -- The affine case: `x ∈ S`, so `S` is the local ring of an affine rational point.
    right
    have hle_aff : affRing E ≤ S := affRing_le_of_genX_mem ⟨⟨hDVR, hres⟩, hfrac⟩ hx
    let e : L ≃ₐ[L] (S ⧸ IsLocalRing.maximalIdeal S) :=
      AlgEquiv.ofBijective
        ((Ideal.Quotient.mkₐ L (IsLocalRing.maximalIdeal S)).comp (Algebra.ofId L S)) hres
    let Φ : Coord E →ₐ[L] S :=
      (IsScalarTower.toAlgHom L (Coord E) (Func E)).codRestrict S
        (fun r => hle_aff (Algebra.subset_adjoin ⟨r, rfl⟩))
    let φ : Coord E →ₐ[L] L :=
      e.symm.toAlgHom.comp ((Ideal.Quotient.mkₐ L (IsLocalRing.maximalIdeal S)).comp Φ)
    have hEq : WeierstrassCurve.Affine.Equation E (φ (coordX E)) (φ (coordY E)) := by
      rw [equation_iff]
      have h := congrArg (φ : Coord E → L) (coordY_sq_relation E)
      have hc : ∀ c : L, φ (algebraMap L (Coord E) c) = c := by
        intro c
        rw [AlgHom.commutes]
        exact Algebra.algebraMap_self_apply c
      simp only [map_add, map_mul, map_pow, hc] at h
      linear_combination (norm := first | refl_ring1 | ring1) h
    have hns : WeierstrassCurve.Affine.Nonsingular E (φ (coordX E)) (φ (coordY E)) :=
      WeierstrassCurve.Affine.equation_iff_nonsingular.mp hEq
    have hker : RingHom.ker (φ : Coord E →+* L) =
        CoordinateRing.XYIdeal E (φ (coordX E)) (Polynomial.C (φ (coordY E))) :=
      Work.MotC2Cls.ker_eq_XYIdeal E φ
    have hle_place : affPlaceAt E (φ (coordX E)) (φ (coordY E)) ≤ S := by
      rw [affPlaceAt]
      refine Algebra.adjoin_le_iff.mpr ?_
      rintro y (hy | hy)
      · obtain ⟨r, rfl⟩ := hy
        exact hle_aff (Algebra.subset_adjoin ⟨r, rfl⟩)
      · obtain ⟨r, hr, rfl⟩ := hy
        have hne0 : (Φ r) ∉ IsLocalRing.maximalIdeal S := by
          intro hmem
          apply hr
          rw [← hker, RingHom.mem_ker]
          show e.symm (Ideal.Quotient.mk (IsLocalRing.maximalIdeal S) (Φ r)) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
        have hinv : ((Φ r : S) : Func E)⁻¹ ∈ S :=
          inv_mem_of_notMem_maximalIdeal (S := S) (E := E) (f := (Φ r : Func E)) (Φ r).2 hne0
        show (algebraMap (Coord E) (Func E) r)⁻¹ ∈ S
        exact hinv
    refine ⟨φ (coordX E), φ (coordY E), hns, ?_⟩
    exact (DVRMaximal L E (affPlaceAt E (φ (coordX E)) (φ (coordY E))) S
      (AffPlace L E (φ (coordX E)) (φ (coordY E)) hns).1 ⟨⟨hDVR, hres⟩, hfrac⟩ hle_place).symm
  · -- The case at infinity: `x ∉ S`, so `S` is the local ring of the point at infinity.
    left
    have hle_inf : infPlace E ≤ S :=
      Work.MotC2Cls.infPlace_le_of_notMem_genX E S ⟨⟨hDVR, hres⟩, hfrac⟩ hx
    exact (DVRMaximal L E (infPlace E) S (isRatPlace_infPlace E) ⟨⟨hDVR, hres⟩, hfrac⟩
      hle_inf).symm

end Work.MotC2
