open Polynomial WeierstrassCurve.Affine

variable {L : Type*} [Field L]

/-! ## `x·w²` and `y·w³` are regular at the point at infinity

Both are elements of the chart-at-infinity coordinate ring `L[u, w]` (`u = 1/x`, `w = y/x²`):
`x·w² = 1 + a₂u + a₄u² + a₆u³ - (a₁ + a₃u)w` by `genX_mul_infW_sq`, and
`y·w³ = (x·w²)²` because `y = w·x²`.  Hence both lie in `infCoordRing E ⊆ infPlace E`. -/

private lemma infW_mem_infPlace (E : WeierstrassCurve L) : infW E ∈ infPlace E :=
  Algebra.subset_adjoin (Or.inl (Algebra.subset_adjoin (by simp)))

private lemma infU_mem_infPlace (E : WeierstrassCurve L) : infU E ∈ infPlace E :=
  Algebra.subset_adjoin (Or.inl (Algebra.subset_adjoin (by simp)))

/-- The chart element `h = 1 + a₂u + a₄u² + a₆u³ - (a₁ + a₃u)w` of the point at infinity. -/
private noncomputable def infAux (E : WeierstrassCurve L) : Func E :=
  1 + algebraMap L (Func E) E.a₂ * infU E + algebraMap L (Func E) E.a₄ * infU E ^ 2 +
    algebraMap L (Func E) E.a₆ * infU E ^ 3 -
    (algebraMap L (Func E) E.a₁ + algebraMap L (Func E) E.a₃ * infU E) * infW E

private lemma infAux_mem_infCoordRing (E : WeierstrassCurve L) : infAux E ∈ infCoordRing E := by
  have hu : infU E ∈ infCoordRing E := Algebra.subset_adjoin (by simp)
  have hw : infW E ∈ infCoordRing E := Algebra.subset_adjoin (by simp)
  exact Subalgebra.sub_mem _ (Subalgebra.add_mem _ (Subalgebra.add_mem _ (Subalgebra.add_mem _
    (Subalgebra.one_mem _) (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hu))
    (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Subalgebra.pow_mem _ hu 2)))
    (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Subalgebra.pow_mem _ hu 3)))
    (Subalgebra.mul_mem _ (Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hu)) hw)

/-- `x·w²` is the chart element `h = infAux E`: the Weierstrass relation at infinity multiplied by
`x`. -/
private lemma genX_mul_infW_sq_eq_infAux (E : WeierstrassCurve L) :
    genX E * (infW E) ^ 2 = infAux E := genX_mul_infW_sq E

private lemma genX_mul_infW_sq_mem_infPlace (E : WeierstrassCurve L) :
    genX E * (infW E) ^ 2 ∈ infPlace E := by
  have h : infAux E ∈ infPlace E :=
    Algebra.subset_adjoin (Or.inl (infAux_mem_infCoordRing E))
  rwa [← genX_mul_infW_sq_eq_infAux E] at h

/-- `y·w³ = (x·w²)²`, since `y = w·x²`. -/
private lemma genY_mul_infW_cube_eq (E : WeierstrassCurve L) :
    genY E * (infW E) ^ 3 = (genX E * (infW E) ^ 2) ^ 2 := by
  rw [genY_eq_infW_mul E]
  first | refl_ring1 | ring

private lemma genY_mul_infW_cube_mem_infPlace (E : WeierstrassCurve L) :
    genY E * (infW E) ^ 3 ∈ infPlace E := by
  rw [genY_mul_infW_cube_eq E]
  exact pow_mem (genX_mul_infW_sq_mem_infPlace E) 2

/-! ## Elementary identities for the factor `w·(Θ w)⁻¹` -/

private lemma sq_mul_sq_inv {K : Type*} [Field K] (B w : K) (hB : B ≠ 0) :
    B ^ 2 * (w * B⁻¹) ^ 2 = w ^ 2 := by
  have h : B * B⁻¹ = 1 := mul_inv_cancel₀ hB
  calc B ^ 2 * (w * B⁻¹) ^ 2 = (B * B⁻¹) ^ 2 * w ^ 2 := by ring
    _ = w ^ 2 := by rw [h]; ring

private lemma cube_mul_cube_inv {K : Type*} [Field K] (B w : K) (hB : B ≠ 0) :
    B ^ 3 * (w * B⁻¹) ^ 3 = w ^ 3 := by
  have h : B * B⁻¹ = 1 := mul_inv_cancel₀ hB
  calc B ^ 3 * (w * B⁻¹) ^ 3 = (B * B⁻¹) ^ 3 * w ^ 3 := by ring
    _ = w ^ 3 := by rw [h]; ring

/-- If `a = b * c` and `b ≠ 0`, then `a * b⁻¹ = c`. -/
private lemma mul_inv_eq_of_eq_mul {K : Type*} [Field K] {a b c : K} (h : a = b * c)
    (hb : b ≠ 0) : a * b⁻¹ = c := by
  rw [h, mul_assoc, mul_comm c b⁻¹, ← mul_assoc, mul_inv_cancel₀ hb, one_mul]

/-! ## `infW E` is a uniformizer of the local ring `infPlace E`

`Work.MotC2.PoleAux` (a self-contained copy of the localization theory of the chart ring
`infCoordRing E = L[u, w]`, cf. `Submission/Work/MotC2/PoleAux.lean`) provides the localization
structure: `↥(infPlace E)` is the localization of `infCoordRing E` at the maximal ideal
`⟨u, w⟩ = PoleAux.infIdealR E`, so its maximal ideal is `⟨u, w⟩·↥(infPlace E)`.  The Weierstrass
relation at infinity gives `w² = u·h` with `h = infAux E = 1 + a₂u + a₄u² + a₆u³ - (a₁ + a₃u)w`,
and `h` is congruent to `1` modulo `⟨u, w⟩`, hence is a unit of `↥(infPlace E)`; therefore
`u = w·(w·h⁻¹)` lies in the ideal generated by `w`, and the maximal ideal is `⟨w⟩`.  Consequently
every non-unit of `↥(infPlace E)` — in particular every `f ∈ infPlace E` that is not invertible
inside `infPlace E` — is `infW E` times an element of `infPlace E`. -/

/-- The action of the chart-at-infinity coordinate ring on `L(E)` is multiplication. -/
private lemma smul_coe_mul (E : WeierstrassCurve L) (a : infCoordRing E) (x : Func E) :
    a • x = (a : Func E) * x := by
  rw [Subalgebra.smul_def, Algebra.smul_def]
  simp

/-- The Weierstrass relation at infinity, solved for `w²`: `u·h = w²` with
`h = infAux E`. -/
private lemma infU_mul_infAux (E : WeierstrassCurve L) : infU E * infAux E = (infW E) ^ 2 := by
  have h := infW_sq_relation E
  rw [infAux]
  linear_combination (norm := first | refl_ring1 | ring1) -h

/-- `h = infAux E` is not in the maximal ideal `⟨u, w⟩` of the chart ring, since
`h - 1 = a₂u + a₄u² + a₆u³ - (a₁ + a₃u)w` lies in `⟨u, w⟩` and `1` does not. -/
private lemma infAux_notMem_infIdealR (E : WeierstrassCurve L) :
    (⟨infAux E, infAux_mem_infCoordRing E⟩ : infCoordRing E) ∉ PoleAux.infIdealR E := by
  intro hmem
  have hmem' : infAux E ∈ infIdeal E :=
    (PoleAux.mem_infIdealR_iff E (⟨infAux E, infAux_mem_infCoordRing E⟩ : infCoordRing E)).mpr hmem
  -- `h - 1` is a combination of `u` and `w`, with coefficients in the chart ring
  have hu : infU E ∈ infCoordRing E := PoleAux.infU_mem_infCoordRing E
  have hcoef : (algebraMap L (Func E) E.a₂ + algebraMap L (Func E) E.a₄ * infU E +
      algebraMap L (Func E) E.a₆ * infU E ^ 2) ∈ infCoordRing E :=
    Subalgebra.add_mem _ (Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hu))
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Subalgebra.pow_mem _ hu 2))
  have hcoef2 : (-(algebraMap L (Func E) E.a₁ + algebraMap L (Func E) E.a₃ * infU E)) ∈
      infCoordRing E :=
    Subalgebra.neg_mem _ (Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hu))
  have hsub : infAux E - 1 ∈ infIdeal E := by
    rw [infIdeal, Submodule.mem_span_pair]
    refine ⟨⟨_, hcoef⟩, ⟨_, hcoef2⟩, ?_⟩
    rw [smul_coe_mul, smul_coe_mul, infAux]
    first | refl_ring1 | ring
  have h1 : (1 : Func E) ∈ infIdeal E := by
    have := sub_mem hmem' hsub
    simpa using this
  exact PoleAux.one_notMem_infIdealR E ((PoleAux.mem_infIdealR_iff E (1 : infCoordRing E)).mp h1)

/-- **The dichotomy in the local ring of the point at infinity**: an element of `infPlace E` is
either invertible inside `infPlace E`, or is `infW E` times an element of `infPlace E`. -/
theorem infPlace_dichotomy (L : Type*) [Field L] (E : WeierstrassCurve L) [E.IsElliptic]
    (f : Work.MotC2.Func E) (hf : f ∈ Work.MotC2.infPlace E) :
    (∃ g : Work.MotC2.Func E, g ∈ Work.MotC2.infPlace E ∧ f * g = 1) ∨
      ∃ g : Work.MotC2.Func E, g ∈ Work.MotC2.infPlace E ∧ f = Work.MotC2.infW E * g := by
  by_cases hunit : ∃ g : Func E, g ∈ infPlace E ∧ f * g = 1
  · exact Or.inl hunit
  · refine Or.inr ?_
    haveI : IsLocalRing ↥(infPlace E) :=
      IsLocalization.AtPrime.isLocalRing ↥(infPlace E) (PoleAux.infIdealR E)
    have hu : infU E ∈ infCoordRing E := PoleAux.infU_mem_infCoordRing E
    have hw : infW E ∈ infCoordRing E := PoleAux.infW_mem_infCoordRing E
    have hwmem : infW E ∈ infPlace E := PoleAux.mem_infPlace_of_mem E ⟨infW E, hw⟩
    -- `h` is a unit of the localization
    have hh : ((⟨infAux E, infAux_mem_infCoordRing E⟩ : infCoordRing E) : Func E)⁻¹ ∈
        infPlace E := PoleAux.inv_mem_infPlace_of_notMem E (infAux_notMem_infIdealR E)
    have hh0 : infAux E ≠ 0 := by
      intro h0
      refine infAux_notMem_infIdealR E ?_
      have hone : (⟨infAux E, infAux_mem_infCoordRing E⟩ : infCoordRing E) = 0 := by
        apply Subtype.ext
        simpa using h0
      rw [hone]
      exact (PoleAux.infIdealR E).zero_mem
    -- `u = w * (w * h⁻¹)` in `↥(infPlace E)`
    have hurel : (algebraMap (infCoordRing E) ↥(infPlace E) ⟨infU E, hu⟩ : ↥(infPlace E)) =
        (⟨infW E, hwmem⟩ : ↥(infPlace E)) * ((⟨infW E, hwmem⟩ : ↥(infPlace E)) *
          (⟨(infAux E)⁻¹, hh⟩ : ↥(infPlace E))) := by
      apply Subtype.ext
      show infU E = infW E * (infW E * (infAux E)⁻¹)
      rw [show infW E * (infW E * (infAux E)⁻¹) = (infW E) ^ 2 * (infAux E)⁻¹ from by ring,
        ← infU_mul_infAux E, mul_assoc, mul_inv_cancel₀ hh0, mul_one]
    -- the maximal ideal of `↥(infPlace E)` is generated by `w`
    have hmax : IsLocalRing.maximalIdeal ↥(infPlace E) =
        Ideal.span {(⟨infW E, hwmem⟩ : ↥(infPlace E))} := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (PoleAux.infIdealR E) ↥(infPlace E),
        PoleAux.infIdealR_eq_span, Ideal.map_span, Set.image_pair]
      refine le_antisymm ?_ ?_
      · refine Ideal.span_le.mpr ?_
        rintro z (rfl | rfl)
        · rw [hurel]
          exact Ideal.mem_span_singleton.mpr
            ⟨(⟨infW E, hwmem⟩ : ↥(infPlace E)) * (⟨(infAux E)⁻¹, hh⟩ : ↥(infPlace E)),
              by ring⟩
        · exact Ideal.subset_span (Set.mem_singleton _)
      · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
        exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    -- a non-unit lies in the maximal ideal, hence is a multiple of `w`
    have hfmem : (⟨f, hf⟩ : ↥(infPlace E)) ∈ IsLocalRing.maximalIdeal ↥(infPlace E) := by
      rw [IsLocalRing.mem_maximalIdeal]
      rintro ⟨g, hg⟩
      refine hunit ⟨((g⁻¹ : (↥(infPlace E))ˣ) : ↥(infPlace E)),
        ((g⁻¹ : (↥(infPlace E))ˣ) : ↥(infPlace E)).2, ?_⟩
      have h1 : (⟨f, hf⟩ : ↥(infPlace E)) * ((g⁻¹ : (↥(infPlace E))ˣ) : ↥(infPlace E)) = 1 := by
        rw [← hg, Units.mul_inv]
      simpa using congrArg (fun z : ↥(infPlace E) => (z : Func E)) h1
    rw [hmax] at hfmem
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hfmem
    refine ⟨(a : Func E), a.2, ?_⟩
    have h2 : (a : Func E) * infW E = f := by
      have h := congrArg (fun z : ↥(infPlace E) => (z : Func E)) ha
      simpa only [smul_eq_mul, Subalgebra.coe_mul, SetLike.coe_eq_coe] using h
    rw [← h2, mul_comm]

/-! ## The main argument

Given that the non-units of the local ring `R = infPlace E` are the multiples of `w = infW E`, the
regularity at `O` of `Θ(x)·w²` and `Θ(y)·w³` follows for any `L`-algebra automorphism `Θ` of `L(E)`
mapping `R` onto itself: `x·w²` and `y·w³` lie in `R`, hence so do their `Θ`-images, and the factor
`w·(Θ w)⁻¹` converting one into the other is regular at `O`: either `w` is a unit of `R` (and then so
is `Θ w`, with `(Θ w)⁻¹ = Θ(w⁻¹)`), or `Θ⁻¹(w)` is a non-unit of `R`, hence `Θ⁻¹(w) = w·g` and
`w·(Θ w)⁻¹ = Θ(g) ∈ R`. -/

private theorem poleCond_aux (E : WeierstrassCurve L) [E.IsElliptic]
    (hDich : ∀ f : Func E, f ∈ infPlace E →
      (¬ ∃ g : Func E, g ∈ infPlace E ∧ f * g = 1) →
      ∃ g : Func E, g ∈ infPlace E ∧ f = infW E * g)
    (Θ : Func E ≃ₐ[L] Func E)
    (hO : Subalgebra.map Θ.toAlgHom (infPlace E) = infPlace E) :
    Θ (genX E) * (infW E) ^ 2 ∈ infPlace E ∧
      Θ (genY E) * (infW E) ^ 3 ∈ infPlace E := by
  -- `Θ` maps `infPlace E` onto itself, in both directions
  have hiff : ∀ x : Func E, Θ x ∈ infPlace E ↔ x ∈ infPlace E := by
    intro x
    constructor
    · intro hx
      have hx' : Θ x ∈ Subalgebra.map Θ.toAlgHom (infPlace E) := by rw [hO]; exact hx
      obtain ⟨y, hy, hyx⟩ := Subalgebra.mem_map.mp hx'
      have hyx' : y = x := Θ.injective hyx
      rwa [hyx'] at hy
    · intro hx
      exact hO.le (Subalgebra.mem_map.mpr ⟨x, hx, rfl⟩)
  have hΘ : ∀ x : Func E, x ∈ infPlace E → Θ x ∈ infPlace E := fun x hx => (hiff x).mpr hx
  have hΘ' : ∀ x : Func E, x ∈ infPlace E → Θ.symm x ∈ infPlace E := fun x hx =>
    (hiff (Θ.symm x)).mp (by simpa using hx)
  by_cases hw0 : infW E = 0
  · -- then the two elements are `0`, which is regular
    constructor <;> rw [hw0] <;> simp
  · have hΘw0 : Θ (infW E) ≠ 0 := fun h => hw0 (Θ.injective (h.trans (map_zero Θ).symm))
    -- the factor `w * (Θ w)⁻¹` is regular at `O`
    have hratio : infW E * (Θ (infW E))⁻¹ ∈ infPlace E := by
      by_cases hunit : ∃ g : Func E, g ∈ infPlace E ∧ Θ.symm (infW E) * g = 1
      · -- `w` is a unit of `infPlace E`, hence so is `Θ w`, with `(Θ w)⁻¹ = Θ(w⁻¹)`
        obtain ⟨g, hg, hg1⟩ := hunit
        have h1 : infW E * Θ g = 1 := by
          have h := congrArg (fun z : Func E => Θ z) hg1
          simpa using h
        have hwinv : (infW E)⁻¹ ∈ infPlace E := by
          have h2 : (infW E)⁻¹ = Θ g := inv_eq_of_mul_eq_one_right h1
          rw [h2]
          exact hΘ g hg
        have hΘwinv : (Θ (infW E))⁻¹ ∈ infPlace E := by
          rw [← map_inv₀ Θ (infW E)]
          exact hΘ _ hwinv
        exact Subalgebra.mul_mem _ (infW_mem_infPlace E) hΘwinv
      · -- `Θ⁻¹ w` is a non-unit of `infPlace E`, hence a multiple of `w`
        obtain ⟨g, hg, hge⟩ := hDich (Θ.symm (infW E)) (hΘ' _ (infW_mem_infPlace E)) hunit
        have h2 : infW E = Θ (infW E) * Θ g := by
          have h := congrArg (fun z : Func E => Θ z) hge
          simpa using h
        rw [mul_inv_eq_of_eq_mul h2 hΘw0]
        exact hΘ g hg
    constructor
    · have hmem : genX E * (infW E) ^ 2 ∈ infPlace E := genX_mul_infW_sq_mem_infPlace E
      have hkey : Θ (genX E) * (infW E) ^ 2 =
          Θ (genX E * (infW E) ^ 2) * (infW E * (Θ (infW E))⁻¹) ^ 2 := by
        rw [map_mul, map_pow, mul_assoc, sq_mul_sq_inv (Θ (infW E)) (infW E) hΘw0]
      rw [hkey]
      exact Subalgebra.mul_mem _ (hΘ _ hmem) (Subalgebra.pow_mem _ hratio 2)
    · have hmem : genY E * (infW E) ^ 3 ∈ infPlace E := genY_mul_infW_cube_mem_infPlace E
      have hkey : Θ (genY E) * (infW E) ^ 3 =
          Θ (genY E * (infW E) ^ 3) * (infW E * (Θ (infW E))⁻¹) ^ 3 := by
        rw [map_mul, map_pow, mul_assoc, cube_mul_cube_inv (Θ (infW E)) (infW E) hΘw0]
      rw [hkey]
      exact Subalgebra.mul_mem _ (hΘ _ hmem) (Subalgebra.pow_mem _ hratio 3)

/-- If an `L`-algebra automorphism `Θ` of `L(E)` maps the local ring `infPlace E` of the point at
infinity onto itself, then `Θ(x)·w²` and `Θ(y)·w³` are regular at `O`.  Indeed `x·w²` and `y·w³`
are regular at `O`, `Θ` restricts to an automorphism of `infPlace E`, and `Θ(w) = w·v` for a unit
`v` of `infPlace E` (since `w` generates the maximal ideal there), so
`Θ(x)·w² = Θ(x·w²)·v⁻²` and `Θ(y)·w³ = Θ(y·w³)·v⁻³` lie in `infPlace E`. -/
theorem PoleCond (L : Type*) [Field L] (E : WeierstrassCurve L) [E.IsElliptic]
    (Θ : Work.MotC2.Func E ≃ₐ[L] Work.MotC2.Func E)
    (hO : Subalgebra.map Θ.toAlgHom (Work.MotC2.infPlace E) = Work.MotC2.infPlace E) :
    Θ (Work.MotC2.genX E) * (Work.MotC2.infW E) ^ 2 ∈ Work.MotC2.infPlace E ∧
    Θ (Work.MotC2.genY E) * (Work.MotC2.infW E) ^ 3 ∈ Work.MotC2.infPlace E :=
  poleCond_aux E (fun f hf h => (infPlace_dichotomy L E f hf).resolve_left h) Θ hO

end Work.MotC2
