open Polynomial WeierstrassCurve.Affine

namespace Work.MotC2

/-
GUIDANCE.  `S := affPlaceAt E a b ⊆ Func E = L(E)` is the localization of the affine coordinate
ring `A := Coord E` at the maximal ideal `I := affPlaceIdeal E a b = ⟨x - a, y - b⟩`
(module `Submission.Work.MotC2.AffPlaceSetup` provides `IsNonsingularPoint`, the instances
`IsLocalization.AtPrime ↥S I`, `IsLocalRing ↥S`, `IsNoetherianRing ↥S`, the identification
`affPlaceAt_maximalIdeal_eq : 𝔪 = Ideal.span {x - a, y - b}` as elements of `↥S`, and
`affPlaceAt_coordY_sq_relation`, `affPlaceAt_equation`, `affPlaceAt_algebraMap_XClass`,
`affPlaceAt_algebraMap_YClass`, `isUnit_one_add_of_mem_maximalIdeal`,
`isUnit_algebraMap_affPlaceAt_of_ne_zero`).

Write `x' := algebraMap (Coord E) ↥S (coordX E)`, `y' := algebraMap (Coord E) ↥S (coordY E)`,
`α := algebraMap L ↥S a`, `β := algebraMap L ↥S b`, `X' := algebraMap (Coord E) ↥S (XClass E a)`,
`Y' := algebraMap (Coord E) ↥S (YClass E (C b))`, so `X' = x' - α`, `Y' = y' - β`
(`affPlaceAt_algebraMap_XClass`, `affPlaceAt_algebraMap_YClass`).

`CoordinateRing.XYIdeal` is `span {XClass E a, YClass E (C b)}`, so `affPlaceAt_maximalIdeal_eq`
gives `𝔪 = Ideal.span {X', Y'} = Ideal.span {X'} ⊔ Ideal.span {Y'}`.

Taylor expansion: from `affPlaceAt_coordY_sq_relation` and `affPlaceAt_equation`, a `ring` /
`linear_combination` computation in `↥S` gives
  `Y' * (Y' + A₁ * X' + (2*β + A₁*α + A₃)) = X' * ((3*α + A₂)*X' + X'^2 - (A₁*β - (3*α^2 + 2*A₂*α + A₄)))`
where `Aᵢ := algebraMap L ↥S E.aᵢ`.

`h.nonsingular.2` says `evalEval a b (polynomialX E) ≠ 0 ∨ evalEval a b (polynomialY E) ≠ 0`,
i.e. by `evalEval_polynomialX`/`evalEval_polynomialY`
`(E.a₁*b - (3*a^2 + 2*E.a₂*a + E.a₄) ≠ 0) ∨ (2*b + E.a₁*a + E.a₃ ≠ 0)`, and
`algebraMap L ↥S` of a nonzero scalar is a unit (`isUnit_algebraMap_affPlaceAt_of_ne_zero`).
* If `2*b + E.a₁*a + E.a₃ ≠ 0` the left factor `U := Y' + A₁*X' + Wᵧ` is `(unit) + m` with
  `m ∈ 𝔪`, hence a unit (`isUnit_one_add_of_mem_maximalIdeal`); conclude
  `Y' = X' * (V * U⁻¹) ∈ Ideal.span {X'}`, whence `𝔪 = Ideal.span {X'}`.
* Otherwise `V` is a unit, `X' ∈ Ideal.span {Y'}` and `𝔪 = Ideal.span {Y'}`.
In both cases `𝔪 = Ideal.span {ϖ}`, so `Submodule.IsPrincipal 𝔪` follows by `rw [h]` and
`inferInstance` (`Ideal.span {x}` is principal).
-/

/-! ## Auxiliary lemmas -/

/-- Taylor expansion of the Weierstrass relation around a solution of the equation, in any
commutative ring.  If `x, y` and `a, b` both satisfy the Weierstrass equation determined by
`A₁, …, A₆`, then expanding the difference of the two relations around `(a, b)` gives
`(y - b) * ((y - b) + A₁ * (x - a) + (2b + A₁a + A₃)) =
  (x - a) * ((3a + A₂) * (x - a) + (x - a)² + (3a² + 2A₂a + A₄ - A₁b))`. -/
lemma taylor_identity {R : Type*} [CommRing R] (x y a b A₁ A₂ A₃ A₄ A₆ : R)
    (h1 : y ^ 2 + (A₁ * x + A₃) * y = x ^ 3 + A₂ * x ^ 2 + A₄ * x + A₆)
    (h2 : b ^ 2 + A₁ * a * b + A₃ * b = a ^ 3 + A₂ * a ^ 2 + A₄ * a + A₆) :
    (y - b) * ((y - b) + A₁ * (x - a) + (2 * b + A₁ * a + A₃)) =
      (x - a) * ((3 * a + A₂) * (x - a) + (x - a) ^ 2 +
        (3 * a ^ 2 + 2 * A₂ * a + A₄ - A₁ * b)) := by
  linear_combination (norm := first | refl_ring1 | ring1) h1 - h2

/-- In a local ring, a unit plus an element of the maximal ideal is a unit. -/
lemma isUnit_add_mem_maximalIdeal {R : Type*} [CommRing R] [IsLocalRing R] {u m : R}
    (hu : IsUnit u) (hm : m ∈ IsLocalRing.maximalIdeal R) : IsUnit (u + m) := by
  rw [← IsLocalRing.notMem_maximalIdeal]
  intro hh
  exact (IsLocalRing.notMem_maximalIdeal.mpr hu) (by
    have := sub_mem hh hm
    simpa using this)

/-- If `Y * U = X * V` and `U` is a unit, then `Y` lies in the ideal generated by `X`, hence the
ideal generated by `X` and `Y` is generated by `X` alone. -/
lemma span_pair_eq_left_of_isUnit {R : Type*} [CommRing R] {X Y U V : R}
    (hUV : Y * U = X * V) (hU : IsUnit U) :
    Ideal.span ({X, Y} : Set R) = Ideal.span ({X} : Set R) := by
  obtain ⟨u, rfl⟩ := hU
  have h5 : Y = X * (V * (↑(u⁻¹) : R)) := by
    calc Y = Y * 1 := (mul_one Y).symm
      _ = Y * ((↑(u⁻¹) : R) * ↑u) := by rw [Units.inv_mul]
      _ = (Y * ↑u) * (↑(u⁻¹) : R) := by ring
      _ = (X * V) * (↑(u⁻¹) : R) := by rw [hUV]
      _ = X * (V * (↑(u⁻¹) : R)) := by ring
  have hY : Y ∈ Ideal.span ({X} : Set R) := by
    rw [Submodule.mem_span_singleton]
    exact ⟨V * (↑(u⁻¹) : R), by rw [smul_eq_mul, mul_comm]; exact h5.symm⟩
  rw [show ({X, Y} : Set R) = insert X {Y} from rfl, Ideal.span_insert, sup_eq_left]
  exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hY)

/-- If `Y * U = X * V` and `V` is a unit, then `X` lies in the ideal generated by `Y`, hence the
ideal generated by `X` and `Y` is generated by `Y` alone. -/
lemma span_pair_eq_right_of_isUnit {R : Type*} [CommRing R] {X Y U V : R}
    (hUV : Y * U = X * V) (hV : IsUnit V) :
    Ideal.span ({X, Y} : Set R) = Ideal.span ({Y} : Set R) := by
  obtain ⟨v, rfl⟩ := hV
  have h5 : X = Y * (U * (↑(v⁻¹) : R)) := by
    calc X = X * 1 := (mul_one X).symm
      _ = X * ((↑(v⁻¹) : R) * ↑v) := by rw [Units.inv_mul]
      _ = (X * ↑v) * (↑(v⁻¹) : R) := by ring
      _ = (Y * U) * (↑(v⁻¹) : R) := by rw [← hUV]
      _ = Y * (U * (↑(v⁻¹) : R)) := by ring
  have hX : X ∈ Ideal.span ({Y} : Set R) := by
    rw [Submodule.mem_span_singleton]
    exact ⟨U * (↑(v⁻¹) : R), by rw [smul_eq_mul, mul_comm]; exact h5.symm⟩
  rw [show ({X, Y} : Set R) = insert X {Y} from rfl, Ideal.span_insert, sup_eq_right]
  exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hX)

/-- The maximal ideal of the local ring `affPlaceAt E a b` of a nonsingular affine point of an
elliptic curve is principal: at a nonsingular point one of the two coordinates is a local
parameter. -/
theorem AffPlaceMaxIdealPrincipal (L : Type*) [Field L] (E : WeierstrassCurve L) [E.IsElliptic]
    (a b : L) [h : Work.MotC2.IsNonsingularPoint E a b] :
    (IsLocalRing.maximalIdeal ↥(Work.MotC2.affPlaceAt E a b)).IsPrincipal := by
  set S : Subalgebra L (Func E) := affPlaceAt E a b with hS
  have hns : E.a₁ * b - (3 * a ^ 2 + 2 * E.a₂ * a + E.a₄) ≠ 0 ∨
      2 * b + E.a₁ * a + E.a₃ ≠ 0 := by
    have hh := h.nonsingular.2
    rwa [WeierstrassCurve.Affine.evalEval_polynomialX,
      WeierstrassCurve.Affine.evalEval_polynomialY] at hh
  set X' : ↥S := algebraMap (Coord E) ↥S (CoordinateRing.XClass E a)
  set Y' : ↥S := algebraMap (Coord E) ↥S (CoordinateRing.YClass E (Polynomial.C b))
  set α : ↥S := algebraMap L ↥S a
  set β : ↥S := algebraMap L ↥S b
  set A₁ : ↥S := algebraMap L ↥S E.a₁
  set A₂ : ↥S := algebraMap L ↥S E.a₂
  set A₃ : ↥S := algebraMap L ↥S E.a₃
  set A₄ : ↥S := algebraMap L ↥S E.a₄
  set A₆ : ↥S := algebraMap L ↥S E.a₆
  have hX'eq : X' = algebraMap (Coord E) ↥S (coordX E) - α := affPlaceAt_algebraMap_XClass E a b
  have hY'eq : Y' = algebraMap (Coord E) ↥S (coordY E) - β := affPlaceAt_algebraMap_YClass E a b
  have hm : IsLocalRing.maximalIdeal ↥S = Ideal.span ({X', Y'} : Set ↥S) := by
    rw [affPlaceAt_maximalIdeal_eq]
  have hX'mem : X' ∈ IsLocalRing.maximalIdeal ↥S := affPlaceAt_XClass_mem_maximalIdeal E a b
  have hY'mem : Y' ∈ IsLocalRing.maximalIdeal ↥S := affPlaceAt_YClass_mem_maximalIdeal E a b
  have htay : Y' * (Y' + A₁ * X' + (2 * β + A₁ * α + A₃)) =
      X' * ((3 * α + A₂) * X' + X' ^ 2 + (3 * α ^ 2 + 2 * A₂ * α + A₄ - A₁ * β)) := by
    have h1 := affPlaceAt_coordY_sq_relation E a b
    have h2 := affPlaceAt_equation E a b
    have ht := taylor_identity (x := algebraMap (Coord E) ↥S (coordX E))
      (y := algebraMap (Coord E) ↥S (coordY E))
      (a := α) (b := β) (A₁ := A₁) (A₂ := A₂) (A₃ := A₃) (A₄ := A₄) (A₆ := A₆) h1 h2
    rw [← hX'eq, ← hY'eq] at ht
    exact ht
  rcases hns with hx | hy
  · -- the `x`-derivative does not vanish: `Y'` is a local parameter
    have hx' : 3 * a ^ 2 + 2 * E.a₂ * a + E.a₄ - E.a₁ * b ≠ 0 := by
      intro h0
      exact hx (by linear_combination -h0)
    have hWx : algebraMap L ↥S (3 * a ^ 2 + 2 * E.a₂ * a + E.a₄ - E.a₁ * b) =
        3 * α ^ 2 + 2 * A₂ * α + A₄ - A₁ * β := by
      simp only [map_sub, map_add, map_mul, map_pow, map_ofNat]
      rfl
    have hV : IsUnit ((3 * α + A₂) * X' + X' ^ 2 + (3 * α ^ 2 + 2 * A₂ * α + A₄ - A₁ * β)) := by
      have hmem : (3 * α + A₂) * X' + X' ^ 2 ∈ IsLocalRing.maximalIdeal ↥S :=
        add_mem (Ideal.mul_mem_left _ _ hX'mem) (Ideal.pow_mem_of_mem _ hX'mem 2 (by norm_num))
      have hunit := isUnit_algebraMap_affPlaceAt_of_ne_zero E a b hx'
      have h3 := isUnit_add_mem_maximalIdeal hunit hmem
      rwa [hWx, add_comm] at h3
    refine ⟨Y', ?_⟩
    rw [hm, span_pair_eq_right_of_isUnit (hUV := htay) hV]
  · -- the `y`-derivative does not vanish: `X'` is a local parameter
    have hWy : algebraMap L ↥S (2 * b + E.a₁ * a + E.a₃) = 2 * β + A₁ * α + A₃ := by
      simp only [map_add, map_mul, map_ofNat]
      rfl
    have hU : IsUnit (Y' + A₁ * X' + (2 * β + A₁ * α + A₃)) := by
      have hmem : Y' + A₁ * X' ∈ IsLocalRing.maximalIdeal ↥S :=
        add_mem hY'mem (Ideal.mul_mem_left _ _ hX'mem)
      have hunit := isUnit_algebraMap_affPlaceAt_of_ne_zero E a b hy
      have h3 := isUnit_add_mem_maximalIdeal hunit hmem
      rwa [hWy, add_comm] at h3
    refine ⟨X', ?_⟩
    rw [hm, span_pair_eq_left_of_isUnit (hUV := htay) hU]

end Work.MotC2
