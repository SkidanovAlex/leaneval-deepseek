# The local ring of an affine point of an elliptic curve: setup

This file sets up the vocabulary needed to prove `Work.MotC2.AffPlace`: the subalgebra
`affPlaceAt E a b ⊆ L(E)` is the localization of the affine coordinate ring `L[X,Y]/(W_E)` at the
maximal ideal `⟨x - a, y - b⟩`.

## Main results

* `Work.MotC2.affPlaceAt_mem_iff`: the membership description of `affPlaceAt E a b` as fractions
  `r / g` with `g ∉ ⟨x - a, y - b⟩`.
* `Work.MotC2.instIsLocalizationAffPlaceAt`: `↥(affPlaceAt E a b)` is the localization of `Coord E`
  at the prime ideal `affPlaceIdeal E a b`.
* `Work.MotC2.affPlaceAt_maximalIdeal_eq`: its maximal ideal is generated by the images of
  `x - a` and `y - b`.

## Tags

elliptic curve, function field, local ring, place
-/

import Mathlib
import Submission.Work.MotC2.Defs
import Submission.Work.MotC2.Relations

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

open Polynomial WeierstrassCurve.Affine

set_option maxHeartbeats 1000000

namespace Work.MotC2

variable {L : Type*} [Field L]

/-! ## The point hypothesis, as a typeclass -/

/-- Nonsingularity of an affine point of a Weierstrass curve, packaged as a typeclass so that the
instances expressing that `affPlaceAt E a b` is the local ring of a rational point can be found by
typeclass search. -/
class IsNonsingularPoint (E : WeierstrassCurve L) (a b : L) : Prop where
  nonsingular : WeierstrassCurve.Affine.Nonsingular E a b

lemma IsNonsingularPoint.of_nonsingular {E : WeierstrassCurve L} {a b : L}
    (h : WeierstrassCurve.Affine.Nonsingular E a b) : IsNonsingularPoint E a b := ⟨h⟩

/-! ## The ideal `⟨x - a, y - b⟩` -/

/-- The ideal `⟨x - a, y - b⟩` of the affine coordinate ring `L[X,Y]/(W_E)`. -/
noncomputable abbrev affPlaceIdeal (E : WeierstrassCurve L) (a b : L) : Ideal (Coord E) :=
  CoordinateRing.XYIdeal E a (Polynomial.C b)

/-- The generating set of the `L`-subalgebra `affPlaceAt E a b ⊆ L(E)`. -/
noncomputable def affPlaceGens (E : WeierstrassCurve L) (a b : L) : Set (Func E) :=
  Set.range (algebraMap (Coord E) (Func E)) ∪
    ((fun r => (algebraMap (Coord E) (Func E) r)⁻¹) '' {r : Coord E | r ∉ affPlaceIdeal E a b})

lemma affPlaceAt_eq_adjoin (E : WeierstrassCurve L) (a b : L) :
    affPlaceAt E a b = Algebra.adjoin L (affPlaceGens E a b) := rfl

lemma algebraMap_mem_affPlaceAt (E : WeierstrassCurve L) (a b : L) (r : Coord E) :
    algebraMap (Coord E) (Func E) r ∈ affPlaceAt E a b :=
  Algebra.subset_adjoin (Set.mem_union_left _ ⟨r, rfl⟩)

lemma inv_algebraMap_mem_affPlaceAt (E : WeierstrassCurve L) (a b : L) {r : Coord E}
    (hr : r ∉ affPlaceIdeal E a b) :
    (algebraMap (Coord E) (Func E) r)⁻¹ ∈ affPlaceAt E a b :=
  Algebra.subset_adjoin (Set.mem_union_right _ ⟨r, hr, rfl⟩)

/-- The class of `x - a` in the coordinate ring is `coordX - a`. -/
lemma XClass_eq_coordX_sub (E : WeierstrassCurve L) (a : L) :
    CoordinateRing.XClass E a = coordX E - algebraMap L (Coord E) a := by
  rw [CoordinateRing.XClass, coordX_eq_mk]
  rw [show (Polynomial.C (Polynomial.X - Polynomial.C a) : (L[X])[X]) =
      Polynomial.C Polynomial.X - Polynomial.C (Polynomial.C a) from Polynomial.C_sub]
  rw [map_sub, ← coordX_eq_mk]
  exact sub_right_inj.mpr rfl

/-- The class of `y - b` in the coordinate ring is `coordY - b`. -/
lemma YClass_eq_coordY_sub (E : WeierstrassCurve L) (b : L) :
    CoordinateRing.YClass E (Polynomial.C b) = coordY E - algebraMap L (Coord E) b := by
  rw [CoordinateRing.YClass, map_sub, ← coordY_eq_mk]
  exact sub_right_inj.mpr rfl

lemma XClass_mem_affPlaceIdeal (E : WeierstrassCurve L) (a b : L) :
    CoordinateRing.XClass E a ∈ affPlaceIdeal E a b :=
  Ideal.subset_span (Set.mem_insert _ _)

lemma YClass_mem_affPlaceIdeal (E : WeierstrassCurve L) (a b : L) :
    CoordinateRing.YClass E (Polynomial.C b) ∈ affPlaceIdeal E a b :=
  Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-! ## The ideal `⟨x - a, y - b⟩` is maximal -/

lemma affPlaceIdeal_isMaximal (E : WeierstrassCurve L) (a b : L) [h : IsNonsingularPoint E a b] :
    (affPlaceIdeal E a b).IsMaximal := by
  have hh : Polynomial.eval a (Polynomial.eval (Polynomial.C b)
      (WeierstrassCurve.Affine.polynomial E)) = 0 := h.nonsingular.1
  refine Ideal.isMaximal_iff.mpr ⟨?_, ?_⟩
  · intro h1
    have h0 : (Ideal.Quotient.mk (affPlaceIdeal E a b) (1 : Coord E)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr h1
    have h2 := congrArg (CoordinateRing.quotientXYIdealEquiv (W' := E) hh) h0
    simp only [map_one, map_zero] at h2
    exact one_ne_zero h2
  · intro J x hIJ hxI hxJ
    set φ := CoordinateRing.quotientXYIdealEquiv (W' := E) hh with hφ
    set q := Ideal.Quotient.mk (affPlaceIdeal E a b) x with hq
    have hqne : φ q ≠ 0 := by
      intro h0
      have h1 : q = 0 := by
        have h2 := congrArg φ.symm h0
        rwa [AlgEquiv.symm_apply_apply, map_zero] at h2
      rw [hq] at h1
      exact hxI (Ideal.Quotient.eq_zero_iff_mem.mp h1)
    obtain ⟨y₀, hy₀⟩ := Ideal.Quotient.mk_surjective (φ.symm ((φ q)⁻¹))
    have hkey : q * φ.symm ((φ q)⁻¹) = 1 := by
      nth_rewrite 1 [show q = φ.symm (φ q) from (AlgEquiv.symm_apply_apply φ q).symm]
      rw [← map_mul, mul_inv_cancel₀ hqne, map_one]
    have hmem : x * y₀ - 1 ∈ affPlaceIdeal E a b := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one, hy₀, hkey, sub_self]
    rw [show (1 : Coord E) = x * y₀ - (x * y₀ - 1) by ring]
    exact J.sub_mem (J.mul_mem_right y₀ hxJ) (hIJ hmem)

instance instIsMaximalAffPlaceIdeal (E : WeierstrassCurve L) (a b : L) [IsNonsingularPoint E a b] :
    (affPlaceIdeal E a b).IsMaximal :=
  affPlaceIdeal_isMaximal E a b

instance instIsPrimeAffPlaceIdeal (E : WeierstrassCurve L) (a b : L) [IsNonsingularPoint E a b] :
    (affPlaceIdeal E a b).IsPrime :=
  (affPlaceIdeal_isMaximal E a b).isPrime

/-! ## The membership description of `affPlaceAt E a b` -/

lemma affPlaceAt_mem_iff (E : WeierstrassCurve L) (a b : L) [h : IsNonsingularPoint E a b]
    (f : Func E) :
    f ∈ affPlaceAt E a b ↔ ∃ r g : Coord E, g ∉ affPlaceIdeal E a b ∧
      f * algebraMap (Coord E) (Func E) g = algebraMap (Coord E) (Func E) r := by
  have hprime : (affPlaceIdeal E a b).IsPrime := instIsPrimeAffPlaceIdeal E a b
  have h1I : (1 : Coord E) ∉ affPlaceIdeal E a b := fun h1 =>
    hprime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  constructor
  · intro hf
    have key : ∀ x ∈ Algebra.adjoin L (affPlaceGens E a b : Set (Func E)),
        ∃ r g : Coord E, g ∉ affPlaceIdeal E a b ∧
          x * algebraMap (Coord E) (Func E) g = algebraMap (Coord E) (Func E) r := by
      intro x hx
      refine Algebra.adjoin_induction (R := L) (A := Func E) (s := affPlaceGens E a b)
        (p := fun x _ => ∃ r g : Coord E, g ∉ affPlaceIdeal E a b ∧
          x * algebraMap (Coord E) (Func E) g = algebraMap (Coord E) (Func E) r) ?_ ?_ ?_ ?_ hx
      · intro y hy
        rcases hy with ⟨r, rfl⟩ | ⟨r, hr, rfl⟩
        · exact ⟨r, 1, h1I, by rw [map_one, mul_one]⟩
        · refine ⟨1, r, hr, ?_⟩
          have hr0 : r ≠ 0 := fun h0 => hr (h0.symm ▸ (affPlaceIdeal E a b).zero_mem)
          have hne : algebraMap (Coord E) (Func E) r ≠ 0 := fun h0 =>
            hr0 (IsFractionRing.injective (Coord E) (Func E) (by simpa using h0))
          rw [map_one, inv_mul_cancel₀ hne]
      · intro c
        refine ⟨algebraMap L (Coord E) c, 1, h1I, ?_⟩
        rw [map_one, mul_one]
        exact (IsScalarTower.algebraMap_apply L (Coord E) (Func E) c).symm
      · intro y z hy hz ihy ihz
        obtain ⟨r₁, g₁, hg₁, he₁⟩ := ihy
        obtain ⟨r₂, g₂, hg₂, he₂⟩ := ihz
        refine ⟨r₁ * g₂ + r₂ * g₁, g₁ * g₂, ?_, ?_⟩
        · intro hcon
          rcases hprime.mem_or_mem hcon with hc | hc
          · exact hg₁ hc
          · exact hg₂ hc
        · calc (y + z) * algebraMap (Coord E) (Func E) (g₁ * g₂)
              = y * algebraMap (Coord E) (Func E) g₁ * algebraMap (Coord E) (Func E) g₂ +
                z * algebraMap (Coord E) (Func E) g₂ * algebraMap (Coord E) (Func E) g₁ := by
                  rw [map_mul]; ring
            _ = algebraMap (Coord E) (Func E) r₁ * algebraMap (Coord E) (Func E) g₂ +
                algebraMap (Coord E) (Func E) r₂ * algebraMap (Coord E) (Func E) g₁ := by
                  rw [he₁, he₂]
            _ = algebraMap (Coord E) (Func E) (r₁ * g₂) +
                algebraMap (Coord E) (Func E) (r₂ * g₁) := by rw [map_mul, map_mul]
            _ = algebraMap (Coord E) (Func E) (r₁ * g₂ + r₂ * g₁) := by rw [map_add]
      · intro y z hy hz ihy ihz
        obtain ⟨r₁, g₁, hg₁, he₁⟩ := ihy
        obtain ⟨r₂, g₂, hg₂, he₂⟩ := ihz
        refine ⟨r₁ * r₂, g₁ * g₂, ?_, ?_⟩
        · intro hcon
          rcases hprime.mem_or_mem hcon with hc | hc
          · exact hg₁ hc
          · exact hg₂ hc
        · calc (y * z) * algebraMap (Coord E) (Func E) (g₁ * g₂)
              = y * algebraMap (Coord E) (Func E) g₁ *
                (z * algebraMap (Coord E) (Func E) g₂) := by rw [map_mul]; ring
            _ = algebraMap (Coord E) (Func E) r₁ * algebraMap (Coord E) (Func E) r₂ := by
                  rw [he₁, he₂]
            _ = algebraMap (Coord E) (Func E) (r₁ * r₂) := (map_mul (algebraMap (Coord E) (Func E))
                  r₁ r₂).symm
    have hf' : f ∈ Algebra.adjoin L (affPlaceGens E a b : Set (Func E)) :=
      affPlaceAt_eq_adjoin E a b ▸ hf
    exact key f hf'
  · rintro ⟨r, g, hg, heq⟩
    have hg0 : g ≠ 0 := fun h0 => hg (h0.symm ▸ (affPlaceIdeal E a b).zero_mem)
    have hφg : algebraMap (Coord E) (Func E) g ≠ 0 := fun h0 =>
      hg0 (IsFractionRing.injective (Coord E) (Func E) (by simpa using h0))
    have hval : algebraMap (Coord E) (Func E) r * (algebraMap (Coord E) (Func E) g)⁻¹ = f := by
      rw [← heq, mul_assoc, mul_inv_cancel₀ hφg, mul_one]
    rw [← hval]
    exact mul_mem (algebraMap_mem_affPlaceAt E a b r) (inv_algebraMap_mem_affPlaceAt E a b hg)

/-! ## `affPlaceAt E a b` is the localization of `Coord E` at `⟨x - a, y - b⟩` -/

/-- The `L`-algebra map `L[X,Y]/(W_E) → ↥(affPlaceAt E a b)`. -/
noncomputable def affPlaceAtAlgHom (E : WeierstrassCurve L) (a b : L) :
    Coord E →ₐ[L] ↥(affPlaceAt E a b) :=
  (IsScalarTower.toAlgHom L (Coord E) (Func E)).codRestrict (affPlaceAt E a b) fun r =>
    algebraMap_mem_affPlaceAt E a b r

/-- The canonical `Coord E`-algebra structure on `↥(affPlaceAt E a b)`. -/
noncomputable instance instAlgebraAffPlaceAt (E : WeierstrassCurve L) (a b : L) :
    Algebra (Coord E) ↥(affPlaceAt E a b) :=
  (affPlaceAtAlgHom E a b).toRingHom.toAlgebra

lemma affPlaceAt_algebraMap_val (E : WeierstrassCurve L) (a b : L) (r : Coord E) :
    ((algebraMap (Coord E) ↥(affPlaceAt E a b)) r : Func E) =
      algebraMap (Coord E) (Func E) r := rfl

/-- `↥(affPlaceAt E a b)` is the localization of the affine coordinate ring at the maximal ideal
`⟨x - a, y - b⟩`. -/
noncomputable instance instIsLocalizationAffPlaceAt (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    IsLocalization.AtPrime ↥(affPlaceAt E a b) (affPlaceIdeal E a b) where
  map_units := fun y => by
    obtain ⟨g, hg⟩ := y
    have hmem : (algebraMap (Coord E) (Func E) g)⁻¹ ∈ affPlaceAt E a b :=
      inv_algebraMap_mem_affPlaceAt E a b hg
    have hg0 : g ≠ 0 := fun h0 => hg (h0.symm ▸ (affPlaceIdeal E a b).zero_mem)
    have hne : algebraMap (Coord E) (Func E) g ≠ 0 := fun h0 =>
      hg0 (IsFractionRing.injective (Coord E) (Func E) (by simpa using h0))
    refine isUnit_iff_exists_inv.mpr ⟨⟨(algebraMap (Coord E) (Func E) g)⁻¹, hmem⟩, ?_⟩
    apply Subtype.ext
    change algebraMap (Coord E) (Func E) g * (algebraMap (Coord E) (Func E) g)⁻¹ = 1
    rw [mul_inv_cancel₀ hne]
  surj := fun z => by
    obtain ⟨r, g, hg, hh⟩ := (affPlaceAt_mem_iff E a b z.1).mp z.2
    refine ⟨(r, ⟨g, hg⟩), ?_⟩
    apply Subtype.ext
    change (z : Func E) * algebraMap (Coord E) (Func E) g = algebraMap (Coord E) (Func E) r
    exact hh
  exists_of_eq := fun {x y} hxy => by
    refine ⟨1, ?_⟩
    have hval : algebraMap (Coord E) (Func E) x = algebraMap (Coord E) (Func E) y := by
      have h := congrArg (fun w : ↥(affPlaceAt E a b) => (w : Func E)) hxy
      simpa only [affPlaceAt_algebraMap_val] using h
    have hxy' : x = y := IsFractionRing.injective (Coord E) (Func E) hval
    simp only [Submonoid.coe_one, one_mul, hxy']

/-- The localization at a prime ideal of a Noetherian ring is Noetherian. -/
noncomputable instance instIsNoetherianRingAffPlaceAt (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] : IsNoetherianRing ↥(affPlaceAt E a b) :=
  IsLocalization.isNoetherianRing (affPlaceIdeal E a b).primeCompl ↥(affPlaceAt E a b)
    (inferInstance : IsNoetherianRing (Coord E))

/-- The localization at a prime ideal is a local ring. -/
noncomputable instance instIsLocalRingAffPlaceAt (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] : IsLocalRing ↥(affPlaceAt E a b) :=
  IsLocalization.AtPrime.isLocalRing ↥(affPlaceAt E a b) (affPlaceIdeal E a b)

/-- The maximal ideal of the localization is the extension of `⟨x - a, y - b⟩`. -/
lemma affPlaceAt_maximalIdeal_eq_map (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    IsLocalRing.maximalIdeal ↥(affPlaceAt E a b) =
      Ideal.map (algebraMap (Coord E) ↥(affPlaceAt E a b)) (affPlaceIdeal E a b) :=
  (IsLocalization.AtPrime.map_eq_maximalIdeal (affPlaceIdeal E a b)
    ↥(affPlaceAt E a b)).symm

/-- The maximal ideal of `↥(affPlaceAt E a b)` is generated by the images of `x - a` and
`y - b`. -/
lemma affPlaceAt_maximalIdeal_eq (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    IsLocalRing.maximalIdeal ↥(affPlaceAt E a b) =
      Ideal.span {algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.XClass E a),
        algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.YClass E (Polynomial.C b))} := by
  rw [affPlaceAt_maximalIdeal_eq_map, affPlaceIdeal, CoordinateRing.XYIdeal, Ideal.map_span,
    Set.image_pair]

lemma affPlaceAt_XClass_mem_maximalIdeal (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.XClass E a) ∈
      IsLocalRing.maximalIdeal ↥(affPlaceAt E a b) := by
  rw [affPlaceAt_maximalIdeal_eq]
  exact Ideal.subset_span (Set.mem_insert _ _)

lemma affPlaceAt_YClass_mem_maximalIdeal (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.YClass E (Polynomial.C b)) ∈
      IsLocalRing.maximalIdeal ↥(affPlaceAt E a b) := by
  rw [affPlaceAt_maximalIdeal_eq]
  exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-! ## Complements on the structure maps -/

lemma affPlaceAt_algebraMap_val_L (E : WeierstrassCurve L) (a b : L) (c : L) :
    ((algebraMap L ↥(affPlaceAt E a b)) c : Func E) = algebraMap L (Func E) c := rfl

/-- The two structure maps to `↥(affPlaceAt E a b)` are compatible. -/
@[simp]
lemma affPlaceAt_algebraMap_algebraMap (E : WeierstrassCurve L) (a b : L) (c : L) :
    algebraMap (Coord E) ↥(affPlaceAt E a b) (algebraMap L (Coord E) c) =
      algebraMap L ↥(affPlaceAt E a b) c := by
  apply Subtype.ext
  rw [affPlaceAt_algebraMap_val, affPlaceAt_algebraMap_val_L]
  exact IsScalarTower.algebraMap_apply L (Coord E) (Func E) c

/-- A nonzero scalar of `L` is a unit of `↥(affPlaceAt E a b)`. -/
lemma isUnit_algebraMap_affPlaceAt_of_ne_zero (E : WeierstrassCurve L) (a b : L) {c : L}
    (hc : c ≠ 0) : IsUnit (algebraMap L ↥(affPlaceAt E a b) c) :=
  ⟨⟨algebraMap L ↥(affPlaceAt E a b) c, algebraMap L ↥(affPlaceAt E a b) c⁻¹,
      by rw [← map_mul, mul_inv_cancel₀ hc, map_one],
      by rw [← map_mul, inv_mul_cancel₀ hc, map_one]⟩, rfl⟩

/-- `1 + m` is a unit for `m` in the maximal ideal of a local ring. -/
lemma isUnit_one_add_of_mem_maximalIdeal {R : Type*} [CommRing R] [IsLocalRing R] {m : R}
    (hm : m ∈ IsLocalRing.maximalIdeal R) : IsUnit (1 + m) := by
  rw [← IsLocalRing.notMem_maximalIdeal]
  intro h
  have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
    have := sub_mem h hm
    simpa [add_sub_cancel_right] using this
  exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1

/-- The Weierstrass relation in the localization of the coordinate ring at `⟨x - a, y - b⟩`. -/
lemma affPlaceAt_coordY_sq_relation (E : WeierstrassCurve L) (a b : L)
    [IsNonsingularPoint E a b] :
    (algebraMap (Coord E) ↥(affPlaceAt E a b) (coordY E)) ^ 2 +
        (algebraMap L ↥(affPlaceAt E a b) E.a₁ *
            algebraMap (Coord E) ↥(affPlaceAt E a b) (coordX E) +
          algebraMap L ↥(affPlaceAt E a b) E.a₃) *
          algebraMap (Coord E) ↥(affPlaceAt E a b) (coordY E) =
      (algebraMap (Coord E) ↥(affPlaceAt E a b) (coordX E)) ^ 3 +
        algebraMap L ↥(affPlaceAt E a b) E.a₂ *
          (algebraMap (Coord E) ↥(affPlaceAt E a b) (coordX E)) ^ 2 +
        algebraMap L ↥(affPlaceAt E a b) E.a₄ *
          algebraMap (Coord E) ↥(affPlaceAt E a b) (coordX E) +
        algebraMap L ↥(affPlaceAt E a b) E.a₆ := by
  have h := congrArg (algebraMap (Coord E) ↥(affPlaceAt E a b)) (coordY_sq_relation E)
  simpa only [map_add, map_mul, map_pow, affPlaceAt_algebraMap_algebraMap] using h

/-- The Weierstrass equation at `(a, b)` in the localization. -/
lemma affPlaceAt_equation (E : WeierstrassCurve L) (a b : L) [h : IsNonsingularPoint E a b] :
    (algebraMap L ↥(affPlaceAt E a b) b) ^ 2 +
        algebraMap L ↥(affPlaceAt E a b) E.a₁ * algebraMap L ↥(affPlaceAt E a b) a *
          algebraMap L ↥(affPlaceAt E a b) b +
        algebraMap L ↥(affPlaceAt E a b) E.a₃ * algebraMap L ↥(affPlaceAt E a b) b =
      (algebraMap L ↥(affPlaceAt E a b) a) ^ 3 +
        algebraMap L ↥(affPlaceAt E a b) E.a₂ *
          (algebraMap L ↥(affPlaceAt E a b) a) ^ 2 +
        algebraMap L ↥(affPlaceAt E a b) E.a₄ * algebraMap L ↥(affPlaceAt E a b) a +
        algebraMap L ↥(affPlaceAt E a b) E.a₆ := by
  have h := congrArg (algebraMap L ↥(affPlaceAt E a b))
    ((equation_iff (W := E) a b).mp h.nonsingular.1)
  simpa only [map_add, map_mul, map_pow] using h

/-- `XClass a` maps to `x - a` in the localization. -/
lemma affPlaceAt_algebraMap_XClass (E : WeierstrassCurve L) (a b : L) :
    algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.XClass E a) =
      algebraMap (Coord E) ↥(affPlaceAt E a b) (coordX E) - algebraMap L ↥(affPlaceAt E a b) a := by
  rw [XClass_eq_coordX_sub, map_sub, affPlaceAt_algebraMap_algebraMap]

/-- `YClass (C b)` maps to `y - b` in the localization. -/
lemma affPlaceAt_algebraMap_YClass (E : WeierstrassCurve L) (a b : L) :
    algebraMap (Coord E) ↥(affPlaceAt E a b) (CoordinateRing.YClass E (Polynomial.C b)) =
      algebraMap (Coord E) ↥(affPlaceAt E a b) (coordY E) - algebraMap L ↥(affPlaceAt E a b) b := by
  rw [YClass_eq_coordY_sub, map_sub, affPlaceAt_algebraMap_algebraMap]

end Work.MotC2
