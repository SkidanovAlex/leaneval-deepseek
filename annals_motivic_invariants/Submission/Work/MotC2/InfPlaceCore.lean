/-- `u = 1/x` as an element of the chart ring `infCoordRing E`. -/
noncomputable def U (E : WeierstrassCurve L) : infCoordRing E :=
  ⟨infU E, infU_mem_infCoordRing E⟩

/-- `w = y/x²` as an element of the chart ring `infCoordRing E`. -/
noncomputable def W (E : WeierstrassCurve L) : infCoordRing E :=
  ⟨infW E, infW_mem_infCoordRing E⟩

/-- The unit `h = 1 + a₂u + a₄u² + a₆u³` of the chart ring. -/
noncomputable def H (E : WeierstrassCurve L) : infCoordRing E :=
  1 + algebraMap L (infCoordRing E) E.a₂ * U E +
    algebraMap L (infCoordRing E) E.a₄ * (U E) ^ 2 +
      algebraMap L (infCoordRing E) E.a₆ * (U E) ^ 3

/-- The element `α = w + a₁u + a₃u²` of the chart ring. -/
noncomputable def Alpha (E : WeierstrassCurve L) : infCoordRing E :=
  W E + algebraMap L (infCoordRing E) E.a₁ * U E +
    algebraMap L (infCoordRing E) E.a₃ * (U E) ^ 2

@[simp] lemma coe_U (E : WeierstrassCurve L) : (U E : Func E) = infU E := rfl
@[simp] lemma coe_W (E : WeierstrassCurve L) : (W E : Func E) = infW E := rfl

lemma coe_H (E : WeierstrassCurve L) : (H E : Func E) =
    1 + algebraMap L (Func E) E.a₂ * infU E + algebraMap L (Func E) E.a₄ * (infU E) ^ 2 +
      algebraMap L (Func E) E.a₆ * (infU E) ^ 3 := by
  simp only [H, U, Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_one,
    Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply L (infCoordRing E) (Func E)]

lemma coe_Alpha (E : WeierstrassCurve L) : (Alpha E : Func E) =
    infW E + algebraMap L (Func E) E.a₁ * infU E + algebraMap L (Func E) E.a₃ * (infU E) ^ 2 := by
  simp only [Alpha, W, U, Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow,
    Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply L (infCoordRing E) (Func E)]

/-- The chart relation in the form `u·h = w·α`. -/
lemma coe_U_mul_H_eq (E : WeierstrassCurve L) :
    (U E : Func E) * (H E : Func E) = (W E : Func E) * (Alpha E : Func E) := by
  have h := infW_sq_relation E
  rw [coe_U, coe_W, coe_H, coe_Alpha]
  linear_combination (norm := refl_ring1) -h

/-- The chart relation `u·h = w·α` in the chart ring. -/
lemma U_mul_H_eq (E : WeierstrassCurve L) : U E * H E = W E * Alpha E :=
  Subtype.ext (coe_U_mul_H_eq E)

lemma H_sub_one_mem (E : WeierstrassCurve L) : H E - 1 ∈ infIdealR E := by
  have hU : U E ∈ infIdealR E := Ideal.subset_span (Set.mem_insert _ _)
  have : H E - 1 = algebraMap L (infCoordRing E) E.a₂ * U E +
      algebraMap L (infCoordRing E) E.a₄ * (U E) ^ 2 +
        algebraMap L (infCoordRing E) E.a₆ * (U E) ^ 3 := by
    rw [H]; ring
  have hU2 : (U E) ^ 2 ∈ infIdealR E := by
    rw [pow_two]; exact Ideal.mul_mem_left _ _ hU
  have hU3 : (U E) ^ 3 ∈ infIdealR E := by
    rw [pow_three]; exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hU)
  rw [this]
  exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hU)
    (Ideal.mul_mem_left _ _ hU2)) (Ideal.mul_mem_left _ _ hU3)

lemma H_notMem (E : WeierstrassCurve L) : H E ∉ infIdealR E := by
  intro hH
  have h1 : (1 : infCoordRing E) ∈ infIdealR E := by
    have h := sub_mem hH (H_sub_one_mem E)
    rwa [sub_sub_cancel] at h
  exact one_notMem_infIdealR E h1

lemma isUnit_algebraMap_H (E : WeierstrassCurve L) :
    IsUnit (algebraMap (infCoordRing E) ↥(infPlace E) (H E)) :=
  (IsLocalization.AtPrime.isUnit_to_map_iff ↥(infPlace E) (infIdealR E) (H E)).mpr
    (H_notMem E)

/-- In the local ring at infinity, `u = w · α · h⁻¹`. -/
lemma algebraMap_U_eq_W_mul (E : WeierstrassCurve L) :
    algebraMap (infCoordRing E) ↥(infPlace E) (U E) =
      algebraMap (infCoordRing E) ↥(infPlace E) (W E) *
        (algebraMap (infCoordRing E) ↥(infPlace E) (Alpha E) *
          ↑((isUnit_algebraMap_H E).unit⁻¹)) := by
  have hrel : algebraMap (infCoordRing E) ↥(infPlace E) (U E) *
      algebraMap (infCoordRing E) ↥(infPlace E) (H E) =
      algebraMap (infCoordRing E) ↥(infPlace E) (W E) *
        algebraMap (infCoordRing E) ↥(infPlace E) (Alpha E) := by
    rw [← map_mul, ← map_mul, U_mul_H_eq]
  have hunit : algebraMap (infCoordRing E) ↥(infPlace E) (H E) *
      ↑((isUnit_algebraMap_H E).unit⁻¹) = 1 :=
    IsUnit.mul_val_inv _
  calc algebraMap (infCoordRing E) ↥(infPlace E) (U E)
      = algebraMap (infCoordRing E) ↥(infPlace E) (U E) *
          (algebraMap (infCoordRing E) ↥(infPlace E) (H E) *
            ↑((isUnit_algebraMap_H E).unit⁻¹)) := by rw [hunit, mul_one]
    _ = (algebraMap (infCoordRing E) ↥(infPlace E) (U E) *
          algebraMap (infCoordRing E) ↥(infPlace E) (H E)) *
            ↑((isUnit_algebraMap_H E).unit⁻¹) := by ring
    _ = (algebraMap (infCoordRing E) ↥(infPlace E) (W E) *
          algebraMap (infCoordRing E) ↥(infPlace E) (Alpha E)) *
            ↑((isUnit_algebraMap_H E).unit⁻¹) := by rw [hrel]
    _ = algebraMap (infCoordRing E) ↥(infPlace E) (W E) *
          (algebraMap (infCoordRing E) ↥(infPlace E) (Alpha E) *
            ↑((isUnit_algebraMap_H E).unit⁻¹)) := by ring

/-- **The maximal ideal of the local ring at infinity is generated by `w = y/x²`.** -/
theorem maxIdeal_eq_span (E : WeierstrassCurve L) :
    IsLocalRing.maximalIdeal ↥(infPlace E) =
      Ideal.span {algebraMap (infCoordRing E) ↥(infPlace E) (W E)} := by
  have hspan : Ideal.span {algebraMap (infCoordRing E) ↥(infPlace E) (U E),
      algebraMap (infCoordRing E) ↥(infPlace E) (W E)} =
      Ideal.span {algebraMap (infCoordRing E) ↥(infPlace E) (W E)} := by
    refine le_antisymm ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · rw [algebraMap_U_eq_W_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))
      · exact Ideal.subset_span (Set.mem_singleton _)
    · exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem _ rfl))
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (infIdealR E) ↥(infPlace E)]
  rw [infIdealR, Ideal.map_span, Set.image_pair]
  exact hspan

lemma infU_ne_zero (E : WeierstrassCurve L) : infU E ≠ 0 := by
  intro h
  have h1 := infU_mul_genX E
  rw [h, zero_mul] at h1
  exact one_ne_zero h1.symm

/-- The maximal ideal of the local ring at infinity is not bot: it contains the image of `u = 1/x`,
which is nonzero. -/
lemma maxIdeal_ne_bot (E : WeierstrassCurve L) :
    IsLocalRing.maximalIdeal ↥(infPlace E) ≠ ⊥ := by
  intro hbot
  have hmem : algebraMap (infCoordRing E) ↥(infPlace E) (U E) ∈
      IsLocalRing.maximalIdeal ↥(infPlace E) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (infIdealR E) ↥(infPlace E)]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_insert _ _))
  rw [hbot, Ideal.mem_bot] at hmem
  have hU0 : (U E : Func E) = 0 := by
    have h := congrArg (fun z : ↥(infPlace E) => (z : Func E)) hmem
    simpa [infPlace_algebraMap_val, coe_U] using h
  exact infU_ne_zero E hU0

/-- **`↥(infPlace E)` is a discrete valuation ring**: it is a Noetherian local domain which is not a
field and whose maximal ideal is principal. -/
noncomputable instance instIsDiscreteValuationRing (E : WeierstrassCurve L) :
    IsDiscreteValuationRing ↥(infPlace E) :=
  have hfield : ¬ IsField ↥(infPlace E) := fun hf =>
    maxIdeal_ne_bot E (IsLocalRing.isField_iff_maximalIdeal_eq.mp hf)
  ((IsDiscreteValuationRing.TFAE ↥(infPlace E) hfield).out 5 1).mp
    (Submodule.IsPrincipal.mk ⟨algebraMap (infCoordRing E) ↥(infPlace E) (W E),
      (maxIdeal_eq_span E).trans rfl⟩)

/-- The image of `w` in the local ring at infinity lies in the maximal ideal, so it is not a unit. -/
lemma not_isUnit_algebraMap_W (E : WeierstrassCurve L) :
    ¬ IsUnit (algebraMap (infCoordRing E) ↥(infPlace E) (W E)) := by
  intro hunit
  have hmem : algebraMap (infCoordRing E) ↥(infPlace E) (W E) ∈
      IsLocalRing.maximalIdeal ↥(infPlace E) := by
    rw [maxIdeal_eq_span E]
    exact Ideal.subset_span (Set.mem_singleton _)
  exact (IsLocalRing.mem_maximalIdeal _).mp hmem hunit

/-- `w = y/x²` is not a unit of the local ring at infinity. -/
theorem infW_not_unit (E : WeierstrassCurve L) :
    ¬ ∃ g ∈ infPlace E, infW E * g = 1 := by
  rintro ⟨g, hg, hg1⟩
  apply not_isUnit_algebraMap_W E
  refine isUnit_iff_exists_inv.mpr ⟨⟨g, hg⟩, ?_⟩
  apply Subtype.ext
  change (W E : Func E) * g = 1
  rw [coe_W, hg1]

/-- Every non-unit of the local ring at infinity is a multiple of `w = y/x²`. -/
theorem infW_mul_of_not_unit (E : WeierstrassCurve L) (f : Func E) (hf : f ∈ infPlace E)
    (h : ¬ ∃ g ∈ infPlace E, f * g = 1) :
    ∃ g : Func E, g ∈ infPlace E ∧ f = infW E * g := by
  have hnotunit : ¬ IsUnit (⟨f, hf⟩ : ↥(infPlace E)) := by
    intro hu
    obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hu
    refine h ⟨(v : Func E), v.2, ?_⟩
    have := congrArg (fun z : ↥(infPlace E) => (z : Func E)) hv
    simpa using this
  have hmem : (⟨f, hf⟩ : ↥(infPlace E)) ∈ IsLocalRing.maximalIdeal ↥(infPlace E) :=
    (IsLocalRing.mem_maximalIdeal _).mpr hnotunit
  rw [maxIdeal_eq_span E] at hmem
  obtain ⟨g, hg⟩ := Submodule.mem_span_singleton.mp hmem
  refine ⟨(g : Func E), g.2, ?_⟩
  have h1 : g * algebraMap (infCoordRing E) ↥(infPlace E) (W E) = ⟨f, hf⟩ := by
    simpa using hg
  have h2 := congrArg (fun z : ↥(infPlace E) => (z : Func E)) h1
  rw [Subalgebra.coe_mul, infPlace_algebraMap_val, coe_W] at h2
  simpa [mul_comm] using h2.symm

/-! ## `L(E)` is the fraction field of `infPlace E` -/

lemma infU_mem_infPlace (E : WeierstrassCurve L) : infU E ∈ infPlace E :=
  mem_infPlace_of_mem E ⟨infU E, infU_mem_infCoordRing E⟩

lemma infW_mem_infPlace (E : WeierstrassCurve L) : infW E ∈ infPlace E :=
  mem_infPlace_of_mem E ⟨infW E, infW_mem_infCoordRing E⟩

/-- Every element of the affine coordinate ring `L[x,y]` is a fraction of two elements of the local
ring at infinity. -/
lemma affRing_frac (E : WeierstrassCurve L) {f : Func E} (hf : f ∈ affRing E) :
    ∃ a b : ↥(infPlace E), (b : Func E) ≠ 0 ∧ f * (b : Func E) = (a : Func E) := by
  rw [affRing_eq_adjoin L E] at hf
  induction hf using Algebra.adjoin_induction with
  | mem x hx =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · refine ⟨1, ⟨infU E, infU_mem_infPlace E⟩, infU_ne_zero E, ?_⟩
        rw [Subalgebra.coe_one]
        show genX E * infU E = 1
        rw [mul_comm]
        exact infU_mul_genX E
      · refine ⟨⟨infW E, infW_mem_infPlace E⟩,
          ⟨(infU E) ^ 2, pow_mem (infU_mem_infPlace E) 2⟩, pow_ne_zero 2 (infU_ne_zero E), ?_⟩
        show genY E * (infU E) ^ 2 = infW E
        rw [infW, infU]
        field_simp
  | algebraMap c =>
      refine ⟨algebraMap L ↥(infPlace E) c, 1, one_ne_zero, ?_⟩
      rw [Subalgebra.coe_one, mul_one, Subalgebra.coe_algebraMap]
  | add x y hx hy ihx ihy =>
      obtain ⟨a₁, b₁, hb₁, h₁⟩ := ihx
      obtain ⟨a₂, b₂, hb₂, h₂⟩ := ihy
      refine ⟨a₁ * b₂ + a₂ * b₁, b₁ * b₂, ?_, ?_⟩
      · rw [Subalgebra.coe_mul]
        exact mul_ne_zero hb₁ hb₂
      · simp only [Subalgebra.coe_add, Subalgebra.coe_mul]
        calc (x + y) * ((b₁ : Func E) * (b₂ : Func E))
            = (x * (b₁ : Func E)) * (b₂ : Func E) + (y * (b₂ : Func E)) * (b₁ : Func E) := by ring
          _ = (a₁ : Func E) * (b₂ : Func E) + (a₂ : Func E) * (b₁ : Func E) := by rw [h₁, h₂]
  | mul x y hx hy ihx ihy =>
      obtain ⟨a₁, b₁, hb₁, h₁⟩ := ihx
      obtain ⟨a₂, b₂, hb₂, h₂⟩ := ihy
      refine ⟨a₁ * a₂, b₁ * b₂, ?_, ?_⟩
      · rw [Subalgebra.coe_mul]
        exact mul_ne_zero hb₁ hb₂
      · simp only [Subalgebra.coe_mul]
        calc x * y * ((b₁ : Func E) * (b₂ : Func E))
            = (x * (b₁ : Func E)) * (y * (b₂ : Func E)) := by ring
          _ = (a₁ : Func E) * (a₂ : Func E) := by rw [h₁, h₂]

/-- **`L(E)` is the fraction field of the local ring at infinity**: every element of `L(E)` is a
quotient of two elements of `infPlace E`. -/
theorem frac_field (E : WeierstrassCurve L) (f : Func E) :
    ∃ s₁ s₂ : ↥(infPlace E), (s₂ : Func E) ≠ 0 ∧ f * (s₂ : Func E) = (s₁ : Func E) := by
  obtain ⟨p, q, hq, hpq⟩ := IsFractionRing.div_surjective (Coord E) (K := Func E) f
  obtain ⟨a₁, b₁, hb₁, h₁⟩ := affRing_frac E (Algebra.subset_adjoin (Set.mem_range_self p))
  obtain ⟨a₂, b₂, hb₂, h₂⟩ := affRing_frac E (Algebra.subset_adjoin (Set.mem_range_self q))
  have hqne : q ≠ 0 := by
    intro h0
    exact one_ne_zero ((mem_nonZeroDivisors_iff.mp hq).2 1 (by rw [h0, mul_zero]))
  have hq0 : (algebraMap (Coord E) (Func E) q : Func E) ≠ 0 :=
    fun h0 => hqne (IsFractionRing.injective (Coord E) (Func E) (by simpa using h0))
  have ha₂0 : (a₂ : Func E) ≠ 0 := by
    intro h0
    have hz : (algebraMap (Coord E) (Func E) q : Func E) * (b₂ : Func E) = 0 := by rw [h₂, h0]
    rcases mul_eq_zero.mp hz with h | h
    · exact hq0 h
    · exact hb₂ h
  have hpq' : f * (algebraMap (Coord E) (Func E) q) = algebraMap (Coord E) (Func E) p := by
    rw [← hpq, div_mul_cancel₀ _ hq0]
  have key : f * ((a₂ : Func E) * (b₁ : Func E)) = (a₁ : Func E) * (b₂ : Func E) := by
    calc f * ((a₂ : Func E) * (b₁ : Func E))
        = f * ((algebraMap (Coord E) (Func E) q : Func E) * (b₂ : Func E)) *
            (b₁ : Func E) := by rw [h₂]; ring
      _ = (f * (algebraMap (Coord E) (Func E) q : Func E)) *
            ((b₂ : Func E) * (b₁ : Func E)) := by ring
      _ = (algebraMap (Coord E) (Func E) p : Func E) *
            ((b₂ : Func E) * (b₁ : Func E)) := by rw [hpq']
      _ = ((algebraMap (Coord E) (Func E) p : Func E) * (b₁ : Func E)) *
            (b₂ : Func E) := by ring
      _ = (a₁ : Func E) * (b₂ : Func E) := by rw [h₁]
  refine ⟨a₁ * b₂, a₂ * b₁, ?_, ?_⟩
  · rw [Subalgebra.coe_mul]
    exact mul_ne_zero ha₂0 hb₁
  · simp only [Subalgebra.coe_mul]
    exact key

/-! ## The residue field of the local ring at infinity is `L` -/

/-- The structure map `L → ↥(infPlace E)` agrees with the composite `L → infCoordRing E → ↥(infPlace E)`. -/
lemma algebraMap_L_eq (E : WeierstrassCurve L) (c : L) :
    algebraMap L ↥(infPlace E) c =
      algebraMap (infCoordRing E) ↥(infPlace E) (algebraMap L (infCoordRing E) c) := by
  apply Subtype.ext
  rw [Subalgebra.coe_algebraMap, infPlace_algebraMap_val]
  exact (IsScalarTower.algebraMap_apply L (infCoordRing E) (Func E) c).symm

/-- Elements of the chart ring which differ by an element of the maximal ideal have the same image
in the residue field of the local ring at infinity. -/
lemma mk_eq_mk_of_sub_mem (E : WeierstrassCurve L) {x y : infCoordRing E}
    (h : x - y ∈ infIdealR E) :
    Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
        (algebraMap (infCoordRing E) ↥(infPlace E) x) =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
        (algebraMap (infCoordRing E) ↥(infPlace E) y) := by
  have hmem : algebraMap (infCoordRing E) ↥(infPlace E) (x - y) ∈
      IsLocalRing.maximalIdeal ↥(infPlace E) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (infIdealR E) ↥(infPlace E)]
    exact Ideal.mem_map_of_mem _ h
  rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, ← map_sub]
  exact hmem

/-- **The residue field of the local ring at infinity is `L`.** -/
theorem residue_field (E : WeierstrassCurve L) :
    Function.Bijective fun c : L =>
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
        (algebraMap L ↥(infPlace E) c) := by
  refine ⟨?_, ?_⟩
  · intro a b hab
    have hab' : Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
        (algebraMap L ↥(infPlace E) a) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
          (algebraMap L ↥(infPlace E) b) := hab
    by_contra hne
    have hd0 : a - b ≠ 0 := sub_ne_zero.mpr hne
    have h1 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
        (algebraMap L ↥(infPlace E) (a - b)) = 0 := by
      rw [map_sub, map_sub, hab', sub_self]
    have h2 : algebraMap L ↥(infPlace E) (a - b) ∈
        IsLocalRing.maximalIdeal ↥(infPlace E) := by
      rwa [Ideal.Quotient.eq_zero_iff_mem] at h1
    have hunit : IsUnit (algebraMap L ↥(infPlace E) (a - b)) :=
      IsUnit.map _ ((isUnit_iff_ne_zero).mpr hd0)
    exact (IsLocalRing.mem_maximalIdeal _).mp h2 hunit
  · intro z
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨a, b, hb, hab⟩ := (infPlace_mem_iff E x.1).mp x.2
    obtain ⟨c, hc⟩ := exists_algebraMap_sub_mem_infIdealR E a
    obtain ⟨c', hc'⟩ := exists_algebraMap_sub_mem_infIdealR E b
    have hc'ne : c' ≠ 0 := by
      intro h0
      rw [h0, map_zero, sub_zero] at hc'
      exact hb hc'
    refine ⟨c * c'⁻¹, ?_⟩
    have hx : x * algebraMap (infCoordRing E) ↥(infPlace E) b =
        algebraMap (infCoordRing E) ↥(infPlace E) a := by
      apply Subtype.ext
      change (x : Func E) * (b : Func E) = (a : Func E)
      exact hab
    have huv : algebraMap L ↥(infPlace E) c' * algebraMap L ↥(infPlace E) c'⁻¹ = 1 := by
      rw [← map_mul, mul_inv_cancel₀ hc'ne, map_one]
    have h2 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E)) x *
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
          (algebraMap L ↥(infPlace E) c') =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
          (algebraMap L ↥(infPlace E) c) := by
      have hq : Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E)) x *
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
            (algebraMap (infCoordRing E) ↥(infPlace E) b) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
            (algebraMap (infCoordRing E) ↥(infPlace E) a) := by
        rw [← map_mul, hx]
      rw [mk_eq_mk_of_sub_mem E hc', ← algebraMap_L_eq E c',
        mk_eq_mk_of_sub_mem E hc, ← algebraMap_L_eq E c] at hq
      exact hq
    have hvu : Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
        (algebraMap L ↥(infPlace E) c') *
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
          (algebraMap L ↥(infPlace E) c'⁻¹) = 1 := by
      rw [← map_mul, huv, map_one]
    have hgoal : Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E)) x =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
          (algebraMap L ↥(infPlace E) (c * c'⁻¹)) := by
      calc Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E)) x
        = Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E)) x *
            (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
                (algebraMap L ↥(infPlace E) c') *
              Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
                (algebraMap L ↥(infPlace E) c'⁻¹)) := by rw [hvu, mul_one]
      _ = (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E)) x *
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
              (algebraMap L ↥(infPlace E) c')) *
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
              (algebraMap L ↥(infPlace E) c'⁻¹) := by ring
      _ = Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
            (algebraMap L ↥(infPlace E) c) *
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
              (algebraMap L ↥(infPlace E) c'⁻¹) := by rw [h2]
      _ = Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
            (algebraMap L ↥(infPlace E) c * algebraMap L ↥(infPlace E) c'⁻¹) := by
            rw [map_mul]
      _ = Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥(infPlace E))
            (algebraMap L ↥(infPlace E) (c * c'⁻¹)) := by
            congr 1
            rw [map_mul]
    exact hgoal.symm

end Work.MotC2.InfPlaceCore
