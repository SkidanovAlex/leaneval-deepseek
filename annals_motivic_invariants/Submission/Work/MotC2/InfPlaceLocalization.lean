open Polynomial WeierstrassCurve.Affine

namespace Work.MotC2.InfLoc

variable {L : Type*} [Field L]

/-- The chart-at-infinity coordinate ring is contained in the local ring at infinity. -/
lemma infCoordRing_le_infPlace (E : WeierstrassCurve L) : infCoordRing E ≤ infPlace E :=
  fun x hx => InfAux.mem_infPlace_of_mem E ⟨x, hx⟩

/-- The inclusion `L[1/x, y/x²] → ↥(infPlace E)`. -/
noncomputable def ringHom (E : WeierstrassCurve L) :
    infCoordRing E →+* ↥(infPlace E) where
  toFun r := ⟨(r : Func E), InfAux.mem_infPlace_of_mem E r⟩
  map_one' := Subtype.ext rfl
  map_mul' a b := Subtype.ext rfl
  map_zero' := Subtype.ext rfl
  map_add' a b := Subtype.ext rfl

lemma ringHom_apply_val (E : WeierstrassCurve L) (r : infCoordRing E) :
    (((ringHom E) r : ↥(infPlace E)) : Func E) = (r : Func E) := rfl

/-- The canonical `infCoordRing E`-algebra structure on `↥(infPlace E)`. -/
noncomputable instance instAlgebraInfLoc (E : WeierstrassCurve L) :
    Algebra (infCoordRing E) ↥(infPlace E) :=
  (ringHom E).toAlgebra

lemma algebraMap_val (E : WeierstrassCurve L) (r : infCoordRing E) :
    ((algebraMap (infCoordRing E) ↥(infPlace E)) r : Func E) = (r : Func E) := rfl

/-- `↥(infPlace E)` is the localization of the chart ring at the maximal ideal `⟨1/x, y/x²⟩`. -/
noncomputable instance instIsLocalizationInfLoc (E : WeierstrassCurve L) :
    IsLocalization.AtPrime ↥(infPlace E) (InfAux.infIdealR E) where
  map_units := fun y => by
    obtain ⟨r, hr⟩ := y
    have hmem : ((r : Func E))⁻¹ ∈ infPlace E := InfAux.inv_mem_infPlace_of_notMem E hr
    refine isUnit_iff_exists_inv.mpr ⟨⟨((r : Func E))⁻¹, hmem⟩, ?_⟩
    apply Subtype.ext
    change (r : Func E) * (r : Func E)⁻¹ = 1
    have hr0 : (r : Func E) ≠ 0 := fun h0 =>
      hr ((InfAux.mem_infIdealR_iff E r).mp (by
        show (r : Func E) ∈ infIdeal E
        rw [h0]
        exact Submodule.zero_mem _))
    rw [mul_inv_cancel₀ hr0]
  surj := fun z => by
    obtain ⟨a, b, hb, hh⟩ := (InfAux.infPlace_mem_iff E z.1).mp z.2
    refine ⟨(a, ⟨b, hb⟩), ?_⟩
    apply Subtype.ext
    change (z : Func E) * (b : Func E) = (a : Func E)
    exact hh
  exists_of_eq := fun {x y} hxy => by
    refine ⟨1, ?_⟩
    have hval : (x : Func E) = (y : Func E) := by
      have h := congrArg (fun w : ↥(infPlace E) => (w : Func E)) hxy
      simpa only [algebraMap_val] using h
    show (1 : infCoordRing E) * x = (1 : infCoordRing E) * y
    rw [one_mul, one_mul]
    exact Subtype.ext hval

/-- The localization of a Noetherian ring is Noetherian. -/
noncomputable instance instIsNoetherianRingInfLoc (E : WeierstrassCurve L) :
    IsNoetherianRing ↥(infPlace E) :=
  IsLocalization.isNoetherianRing (InfAux.infIdealR E).primeCompl ↥(infPlace E)
    (isNoetherianRing_infCoordRing L E)

/-- A localization at a prime is a local ring. -/
noncomputable instance instIsLocalRingInfLoc (E : WeierstrassCurve L) :
    IsLocalRing ↥(infPlace E) :=
  IsLocalization.AtPrime.isLocalRing ↥(infPlace E) (InfAux.infIdealR E)

/-- The maximal ideal of the localization is the extension of `⟨1/x, y/x²⟩`. -/
lemma maximalIdeal_eq_map (E : WeierstrassCurve L) :
    IsLocalRing.maximalIdeal ↥(infPlace E) =
      Ideal.map (algebraMap (infCoordRing E) ↥(infPlace E)) (InfAux.infIdealR E) :=
  (IsLocalization.AtPrime.map_eq_maximalIdeal (InfAux.infIdealR E) ↥(infPlace E)).symm

/-- `1/x` as an element of the chart ring. -/
noncomputable def u (E : WeierstrassCurve L) : infCoordRing E :=
  ⟨infU E, InfAux.infU_mem_infCoordRing E⟩

/-- `y/x²` as an element of the chart ring. -/
noncomputable def w (E : WeierstrassCurve L) : infCoordRing E :=
  ⟨infW E, InfAux.infW_mem_infCoordRing E⟩

@[simp] lemma u_val (E : WeierstrassCurve L) : ((u E : infCoordRing E) : Func E) = infU E := rfl
@[simp] lemma w_val (E : WeierstrassCurve L) : ((w E : infCoordRing E) : Func E) = infW E := rfl

lemma infIdealR_eq_span (E : WeierstrassCurve L) :
    InfAux.infIdealR E = Ideal.span {u E, w E} := rfl

/-- The maximal ideal is generated by the images of `1/x` and `y/x²`. -/
lemma maximalIdeal_eq_span (E : WeierstrassCurve L) :
    IsLocalRing.maximalIdeal ↥(infPlace E) =
      Ideal.span {algebraMap (infCoordRing E) ↥(infPlace E) (u E),
        algebraMap (infCoordRing E) ↥(infPlace E) (w E)} := by
  rw [maximalIdeal_eq_map, infIdealR_eq_span, Ideal.map_span, Set.image_pair]

lemma algebraMap_u_mem_maximalIdeal (E : WeierstrassCurve L) :
    algebraMap (infCoordRing E) ↥(infPlace E) (u E) ∈ IsLocalRing.maximalIdeal ↥(infPlace E) := by
  rw [maximalIdeal_eq_span]
  exact Ideal.subset_span (Set.mem_insert _ _)

lemma algebraMap_w_mem_maximalIdeal (E : WeierstrassCurve L) :
    algebraMap (infCoordRing E) ↥(infPlace E) (w E) ∈ IsLocalRing.maximalIdeal ↥(infPlace E) := by
  rw [maximalIdeal_eq_span]
  exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

lemma algebraMap_u_val (E : WeierstrassCurve L) :
    ((algebraMap (infCoordRing E) ↥(infPlace E) (u E) : ↥(infPlace E)) : Func E) = infU E := rfl

lemma algebraMap_w_val (E : WeierstrassCurve L) :
    ((algebraMap (infCoordRing E) ↥(infPlace E) (w E) : ↥(infPlace E)) : Func E) = infW E := rfl

/-! ## The image of the coordinate ring in the chart at infinity

The function field `L(E)` is the fraction field of `L[x,y] = Coord E`, and in the chart at infinity
one has `x = u⁻¹` and `y = w u⁻²` with `u = 1/x = infU E` and `w = y/x² = infW E`.  Hence the image
of `Coord E` is contained in the `L`-subalgebra of `L(E)` generated by `u`, `w` and `u⁻¹`, which is
a subalgebra of the fraction field of `infPlace E`. -/

/-- The affine coordinate ring is generated over `L` by the classes of `X` and `Y`. -/
lemma adjoin_coordX_coordY (E : WeierstrassCurve L) :
    Algebra.adjoin L ({coordX E, coordY E} : Set (Coord E)) = ⊤ := by
  rw [eq_top_iff]
  rintro r -
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective (g := polynomial E) r
  have hof : ∀ a : L[X], AdjoinRoot.of (polynomial E) a ∈
      Algebra.adjoin L ({coordX E, coordY E} : Set (Coord E)) := by
    intro a
    induction a using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | monomial n c =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        refine mul_mem ?_ (pow_mem ?_ n)
        · rw [of_poly_C]
          exact Subalgebra.algebraMap_mem _ c
        · rw [of_poly_X, algebraMap_X_eq_coordX]
          exact Algebra.subset_adjoin (by simp)
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | monomial n a =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
      refine mul_mem (hof a) (pow_mem ?_ n)
      exact Algebra.subset_adjoin (Or.inr rfl)

lemma genX_eq_inv_infU (E : WeierstrassCurve L) : genX E = (infU E)⁻¹ := by
  rw [infU, inv_inv]

lemma genY_eq_infW_mul_inv_sq (E : WeierstrassCurve L) :
    genY E = infW E * ((infU E) ^ 2)⁻¹ := by
  rw [genY_eq_infW_mul, genX_eq_inv_infU, inv_pow]

/-- The image in `L(E)` of an element of the coordinate ring lies in the `L`-subalgebra generated
by `u = 1/x`, `w = y/x²` and `u⁻¹ = x`. -/
lemma algebraMap_coord_mem (E : WeierstrassCurve L) (r : Coord E) :
    algebraMap (Coord E) (Func E) r ∈
      Algebra.adjoin L ({infU E, infW E, (infU E)⁻¹} : Set (Func E)) := by
  have hx : algebraMap (Coord E) (Func E) (coordX E) = (infU E)⁻¹ := by
    rw [show algebraMap (Coord E) (Func E) (coordX E) = genX E from rfl, genX_eq_inv_infU]
  have hy : algebraMap (Coord E) (Func E) (coordY E) = infW E * ((infU E) ^ 2)⁻¹ := by
    rw [show algebraMap (Coord E) (Func E) (coordY E) = genY E from rfl, genY_eq_infW_mul_inv_sq]
  have hr : r ∈ Algebra.adjoin L ({coordX E, coordY E} : Set (Coord E)) := by
    rw [adjoin_coordX_coordY E]
    trivial
  have hle : Algebra.adjoin L ({coordX E, coordY E} : Set (Coord E)) ≤
      (Algebra.adjoin L ({infU E, infW E, (infU E)⁻¹} : Set (Func E))).comap
        (IsScalarTower.toAlgHom L (Coord E) (Func E)) := by
    rw [Algebra.adjoin_le_iff]
    rintro z hz
    show z ∈ (Algebra.adjoin L ({infU E, infW E, (infU E)⁻¹} : Set (Func E))).comap
      (IsScalarTower.toAlgHom L (Coord E) (Func E))
    rw [Subalgebra.mem_comap, IsScalarTower.toAlgHom_apply]
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · rw [hx]
      exact Algebra.subset_adjoin (by simp)
    · rw [hy]
      have h1 : (infU E)⁻¹ ∈ Algebra.adjoin L ({infU E, infW E, (infU E)⁻¹} : Set (Func E)) :=
        Algebra.subset_adjoin (by simp)
      refine mul_mem (Algebra.subset_adjoin (by simp)) ?_
      rw [← inv_pow]
      exact pow_mem h1 2
  have hfin := hle hr
  rw [Subalgebra.mem_comap, IsScalarTower.toAlgHom_apply] at hfin
  exact hfin

/-- The local ring at infinity is not a field (the element `1/x` is a nonzero non-unit). -/
lemma not_isField (E : WeierstrassCurve L) : ¬ IsField ↥(infPlace E) := by
  rw [IsLocalRing.isField_iff_maximalIdeal_eq]
  intro hbot
  have hmem := algebraMap_u_mem_maximalIdeal E
  rw [hbot] at hmem
  have h0 : algebraMap (infCoordRing E) ↥(infPlace E) (u E) = 0 := hmem
  have h1 : (infU E : Func E) = 0 := by
    rw [← algebraMap_u_val E, h0]
    rfl
  exact (inv_ne_zero (genX_ne_zero E)) h1

lemma infU_ne_zero (E : WeierstrassCurve L) : infU E ≠ 0 := by
  intro h
  have h1 := infU_mul_genX E
  rw [h, zero_mul] at h1
  exact one_ne_zero h1.symm

lemma infU_mem_infPlace (E : WeierstrassCurve L) : infU E ∈ infPlace E :=
  InfAux.mem_infPlace_of_mem E (u E)

lemma infW_mem_infPlace (E : WeierstrassCurve L) : infW E ∈ infPlace E :=
  InfAux.mem_infPlace_of_mem E (w E)

end Work.MotC2.InfLoc
