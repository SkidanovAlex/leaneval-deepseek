# The function field of an elliptic curve: interface

This file sets up the vocabulary of the `Work.MotC2` chapter, whose target is
`Work.MotC2.aut_functionField`: for an elliptic Weierstrass curve `E` over a field `L` with
`j(E) ≠ 0, 1728`, every `L`-algebra automorphism of the function field `L(E)` is a translation
composed with `±1`.

## Main definitions

* `Coord E` is the affine coordinate ring `L[X, Y]/(W_E)`, `Func E` its fraction field `L(E)`.
* `genX`, `genY` are the classes of `X` and `Y` in `L(E)`; they satisfy the Weierstrass relation
  (`genX_genY_relation`).
* `baseE E` is `E` with coefficients pushed forward to `L(E)`.
* `infU = 1/x`, `infW = y/x²` are coordinates of the chart at infinity, satisfying
  `infU_infW_relation`.
* `infPlace` is the `L`-subalgebra generated by `infU` and `infW`: the local ring of the point at
  infinity `O`.
* `affPlaceAt E a b` is the local ring of the affine rational point `(a, b)`, realized as the
  `L`-subalgebra of `L(E)` generated by the coordinate ring and the inverses of the elements
  outside the maximal ideal `⟨x - a, y - b⟩`.
* `plugHom u v h` is the `L`-algebra homomorphism `L[X,Y]/(W_E) → F` attached to a point
  `(u, v)` of `E` over an `L`-field `F`.
* `IsRatPlace S` says that the `L`-subalgebra `S ⊆ L(E)` is the local ring of a rational place of
  `L(E)/L`: a discrete valuation ring whose residue field is `L` (via the structure map).

## Tags

elliptic curve, function field, place, automorphism
-/

import Mathlib
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

open Polynomial WeierstrassCurve.Affine

namespace Work.MotC2

variable {L : Type*} [Field L]

/-- The affine coordinate ring `L[X, Y]/(W_E)` of a Weierstrass curve. -/
abbrev Coord (E : WeierstrassCurve L) : Type _ := CoordinateRing E

/-- The function field `L(E)` of a Weierstrass curve. -/
abbrev Func (E : WeierstrassCurve L) : Type _ := FunctionField E

/-- The class of `X` in `L[X, Y]/(W_E)`. -/
noncomputable def coordX (E : WeierstrassCurve L) : Coord E :=
  AdjoinRoot.of (polynomial E) Polynomial.X

/-- The class of `Y` in `L[X, Y]/(W_E)`. -/
noncomputable def coordY (E : WeierstrassCurve L) : Coord E :=
  AdjoinRoot.root (polynomial E)

lemma coordX_eq_mk (E : WeierstrassCurve L) :
    coordX E = CoordinateRing.mk E (Polynomial.C Polynomial.X) := by
  rw [coordX, CoordinateRing.mk, AdjoinRoot.mk_C]

lemma coordY_eq_mk (E : WeierstrassCurve L) : coordY E = CoordinateRing.mk E Polynomial.X := by
  rw [coordY, CoordinateRing.mk, AdjoinRoot.mk_X]

/-- The `of`-image of a constant polynomial is the corresponding scalar. -/
lemma of_poly_C (p : (L[X])[X]) (a : L) :
    AdjoinRoot.of p (Polynomial.C a) = algebraMap L (AdjoinRoot p) a := by
  rw [AdjoinRoot.of, RingHom.comp_apply, AdjoinRoot.mk_C]
  exact IsScalarTower.algebraMap_apply L (L[X]) (AdjoinRoot p) a

/-- The `of`-image of `X`. -/
lemma of_poly_X (p : (L[X])[X]) :
    AdjoinRoot.of p (Polynomial.X : L[X]) = algebraMap (L[X]) (AdjoinRoot p) Polynomial.X := by
  rw [AdjoinRoot.algebraMap_eq]

lemma algebraMap_X_eq_coordX (E : WeierstrassCurve L) :
    algebraMap (L[X]) (Coord E) Polynomial.X = coordX E := by
  rw [coordX, AdjoinRoot.algebraMap_eq]

/-- The coordinate `x` of the function field `L(E)`. -/
noncomputable def genX (E : WeierstrassCurve L) : Func E :=
  algebraMap (Coord E) (Func E) (coordX E)

/-- The coordinate `y` of the function field `L(E)`. -/
noncomputable def genY (E : WeierstrassCurve L) : Func E :=
  algebraMap (Coord E) (Func E) (coordY E)

/-- `E` with its coefficients pushed forward to `L(E)`. -/
noncomputable abbrev baseE (E : WeierstrassCurve L) : WeierstrassCurve (Func E) :=
  E.map (algebraMap L (Func E))

/-- The chart-at-infinity coordinate `1/x`. -/
noncomputable def infU (E : WeierstrassCurve L) : Func E := (genX E)⁻¹

/-- The chart-at-infinity coordinate `y/x²`. -/
noncomputable def infW (E : WeierstrassCurve L) : Func E := genY E / (genX E) ^ 2

/-- The coordinate ring of the chart at infinity: the `L`-subalgebra generated by the coordinates
`1/x` and `y/x²`.  This is the affine coordinate ring of the open chart `x ≠ 0`, not a local ring. -/
noncomputable def infCoordRing (E : WeierstrassCurve L) : Subalgebra L (Func E) :=
  Algebra.adjoin L ({infU E, infW E} : Set (Func E))

/-- The maximal ideal `(1/x, y/x²)` of the chart-at-infinity coordinate ring `infCoordRing E`,
viewed as an `infCoordRing E`-submodule of `L(E)`. -/
noncomputable def infIdeal (E : WeierstrassCurve L) : Submodule (infCoordRing E) (Func E) :=
  Submodule.span (infCoordRing E) ({infU E, infW E} : Set (Func E))

/-- The local ring of the point at infinity: the localization of the chart-at-infinity coordinate
ring `L[1/x, y/x²]` at its maximal ideal `(1/x, y/x²)`, i.e. the `L`-subalgebra of `L(E)`
generated by the chart ring and the inverses of the elements outside that maximal ideal.  This is
the ring of functions regular at `O`. -/
noncomputable def infPlace (E : WeierstrassCurve L) : Subalgebra L (Func E) :=
  Algebra.adjoin L (↑(infCoordRing E) ∪
    ((fun r => r⁻¹) '' {r : Func E | r ∈ infCoordRing E ∧ r ∉ infIdeal E}))

/-- The affine coordinate ring `L[x, y] = Coord E`, viewed as an `L`-subalgebra of `L(E)`. -/
noncomputable def affRing (E : WeierstrassCurve L) : Subalgebra L (Func E) :=
  Algebra.adjoin L (Set.range (algebraMap (Coord E) (Func E)))

/-- The local ring of the affine rational point `(a, b)`: the `L`-subalgebra of `L(E)` generated
by the coordinate ring and the inverses of the elements outside the maximal ideal
`⟨x - a, y - b⟩`. -/
noncomputable def affPlaceAt (E : WeierstrassCurve L) (a b : L) : Subalgebra L (Func E) :=
  Algebra.adjoin L (Set.range (algebraMap (Coord E) (Func E)) ∪
    ((fun r => (algebraMap (Coord E) (Func E) r)⁻¹) ''
      {r : Coord E | r ∉ CoordinateRing.XYIdeal E a (Polynomial.C b)}))

/-- A rational place of `L(E)/L`: a discrete valuation ring `S ⊆ L(E)` containing `L` whose residue
field is `L` (via the structure map) and which generates `L(E)`, so that `S` is the local ring of an
`L`-rational point of the projective curve. -/
def IsRatPlace (E : WeierstrassCurve L) (S : Subalgebra L (Func E)) : Prop :=
  (∃ _ : IsDiscreteValuationRing S,
    Function.Bijective fun c : L =>
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal S) (algebraMap L S c)) ∧
  (∀ f : Func E, ∃ s₁ : S, ∃ s₂ : S, (s₂ : Func E) ≠ 0 ∧ f * (s₂ : Func E) = (s₁ : Func E))

/-! ## The Weierstrass relation and the chart at infinity -/

lemma genX_ne_zero (E : WeierstrassCurve L) : genX E ≠ 0 := by
  intro h
  have h' : CoordinateRing.mk E (Polynomial.C Polynomial.X) = 0 :=
    IsFractionRing.injective (Coord E) (Func E) (by simpa [genX, coordX_eq_mk] using h)
  exact CoordinateRing.XClass_ne_zero (W' := E) 0 (by
    rw [CoordinateRing.XClass]
    simpa using h')

lemma infU_mul_genX (E : WeierstrassCurve L) : infU E * genX E = 1 :=
  inv_mul_cancel₀ (genX_ne_zero E)

lemma genY_eq_infW_mul (E : WeierstrassCurve L) : genY E = infW E * (genX E) ^ 2 := by
  rw [infW, div_mul_cancel₀ _ (pow_ne_zero 2 (genX_ne_zero E))]

/-! ## The evaluation homomorphism at a point -/

section Plug

variable {F : Type*} [Field F] [Algebra L F]

/-- For a point `(u, v)` of `E` over an `L`-field `F` the `L`-algebra homomorphism
`L[X, Y]/(W_E) → F` with `X ↦ u`, `Y ↦ v`. -/
noncomputable def plugHom (E : WeierstrassCurve L) (u v : F)
    (h : Equation (E.map (algebraMap L F)) u v) : Coord E →ₐ[L] F :=
  AdjoinRoot.liftAlgHom (polynomial E) (Polynomial.aeval u) v (by
    rw [Equation, evalEval_polynomial] at h
    simp only [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂, WeierstrassCurve.map_a₃,
      WeierstrassCurve.map_a₄, WeierstrassCurve.map_a₆] at h
    rw [WeierstrassCurve.Affine.polynomial]
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
      Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C, map_add, map_mul, map_pow,
      AlgHom.coe_toRingHom, Polynomial.aeval_X, Polynomial.aeval_C] at h ⊢
    linear_combination (norm := first | refl_ring1 | ring1) h)

@[simp]
lemma plugHom_coordY (E : WeierstrassCurve L) (u v : F)
    (h : Equation (E.map (algebraMap L F)) u v) : plugHom E u v h (coordY E) = v := by
  unfold coordY plugHom
  rw [AdjoinRoot.liftAlgHom_root]

@[simp]
lemma plugHom_coordX (E : WeierstrassCurve L) (u v : F)
    (h : Equation (E.map (algebraMap L F)) u v) : plugHom E u v h (coordX E) = u := by
  unfold coordX plugHom
  rw [AdjoinRoot.liftAlgHom_of, Polynomial.aeval_X]

end Plug

end Work.MotC2
