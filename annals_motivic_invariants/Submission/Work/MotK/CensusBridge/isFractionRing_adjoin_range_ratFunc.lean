namespace Work.MotK.CensusBridge

/-- If `R ⊆ L` is a subalgebra of a field such that the subfield generated by (the image of) `R`
inside `L` is everything, then `L` is a fraction ring of `R`.

Indeed, `Subfield.mem_closure_iff` writes every element of `Subfield.closure s` as `y / z` with
`y`, `z` in the subring generated by `s`; here that subring is `R` itself. -/
lemma isFractionRing_of_subfield_closure_range {K L : Type} [Field K] [Field L] [Algebra K L]
    (R : Subalgebra K L) (h : Subfield.closure (Set.range (algebraMap R L)) = ⊤) :
    IsFractionRing R L := by
  refine IsFractionRing.of_field R L fun z => ?_
  have hz : z ∈ Subfield.closure (Set.range (algebraMap R L)) := by
    rw [h]; exact Subfield.mem_top z
  rw [Subfield.mem_closure_iff] at hz
  obtain ⟨y, hy, w, hw, hyw⟩ := hz
  -- the subring generated by the image of `R` is `R` itself
  have hclos : Subring.closure (Set.range (algebraMap R L)) = R.toSubring := by
    refine le_antisymm ?_ ?_
    · rw [Subring.closure_le]
      rintro x ⟨r, rfl⟩
      exact Subalgebra.mem_toSubring.mpr r.2
    · intro x hx
      exact Subring.subset_closure ⟨⟨x, Subalgebra.mem_toSubring.mp hx⟩, rfl⟩
  have hyR : y ∈ R := Subalgebra.mem_toSubring.mp (by rw [← hclos]; exact hy)
  have hwR : w ∈ R := Subalgebra.mem_toSubring.mp (by rw [← hclos]; exact hw)
  exact ⟨⟨y, hyR⟩, ⟨w, hwR⟩, by simpa using hyw.symm⟩

/-- **`RatFunc A` is the fraction field of the `K`-subalgebra generated by `X`, `s`, `β`.**

Let `K ⊆ A` be a field extension and `s β : A` with `A = K⟮s, β⟯`.  Then the subalgebra
`R := Algebra.adjoin K {RatFunc.X, s, β} ⊆ RatFunc A` (images in `RatFunc A`) has fraction field
`RatFunc A`.  Equivalently `RatFunc A` is a localisation of `R`, which lets a principal-ideal
presentation of `R` be read off at the level of fraction fields.

## Route

Use `IsFractionRing.of_field`, whose input is that every `z : RatFunc A` is a quotient
`algebraMap R _ x / algebraMap R _ y` of two elements of `R`.  For that it suffices to show that
every element of `RatFunc A` lies in the subfield `S := Subfield.closure (Set.range (algebraMap R _))`
(inside `RatFunc A`), because `S` is then a field generated by the image of `R`, so each of its
elements is a quotient of two elements of the subring it generates.

* `(RatFunc.X : RatFunc A) ∈ S` since it is the image of the element `RatFunc.X ∈ R`.
* `algebraMap A (RatFunc A) a ∈ S` for every `a : A`: `hgen` writes `a ∈ K⟮s,β⟯`, and
  `IntermediateField.adjoin_map`/`adjoin_le_iff` turn this into
  `algebraMap A (RatFunc A) a ∈ K⟮algebraMap s, algebraMap β⟯ ⊆ S`.
* Hence `S ⊇` the `A`-adjoin of `RatFunc.X`, which is `⊤` by `RatFunc.adjoin_X`
  (`A⟮(RatFunc.X : RatFunc A)⟯ = ⊤`); more precisely, `IntermediateField.adjoin A {RatFunc.X}` is
  contained in `IntermediateField.adjoin K (Set.range v)` (with `v = ![X, s, β]`), the latter being
  contained in `S`, and `RatFunc.adjoin_X` gives `⊤`.

The only bookkeeping is the identification of the `A`-adjoin with the `K`-adjoin of the range of
`v` (`IntermediateField.restrictScalars_adjoin`, `IntermediateField.adjoin_adjoin_right`). -/
theorem isFractionRing_adjoin_range_ratFunc {K A : Type} [Field K] [Field A] [Algebra K A]
    (s β : A) (hgen : IntermediateField.adjoin K ({s, β} : Set A) = ⊤) :
    IsFractionRing (Algebra.adjoin K (Set.range (fun i : Fin 3 =>
      (![(RatFunc.X : RatFunc A), (algebraMap A (RatFunc A)) s,
        (algebraMap A (RatFunc A)) β]) i))) (RatFunc A) := by
  set v : Fin 3 → RatFunc A :=
    ![(RatFunc.X : RatFunc A), (algebraMap A (RatFunc A)) s, (algebraMap A (RatFunc A)) β] with hv
  set R : Subalgebra K (RatFunc A) := Algebra.adjoin K (Set.range v) with hR
  have hv0 : v 0 = (RatFunc.X : RatFunc A) := by rw [hv]; rfl
  have hv1 : v 1 = algebraMap A (RatFunc A) s := by rw [hv]; rfl
  have hv2 : v 2 = algebraMap A (RatFunc A) β := by rw [hv]; rfl
  have hv_mem : ∀ i, v i ∈ R := fun i => by
    rw [hR]; exact Algebra.subset_adjoin (Set.mem_range_self i)
  refine isFractionRing_of_subfield_closure_range R ?_
  set S : Subfield (RatFunc A) := Subfield.closure (Set.range (algebraMap R (RatFunc A))) with hS
  -- the three generators of `R` lie in `S`
  have memS : ∀ i : Fin 3, v i ∈ S := fun i =>
    (Subfield.subset_closure (s := Set.range (algebraMap R (RatFunc A))))
      ⟨⟨v i, hv_mem i⟩, rfl⟩
  have hX : (RatFunc.X : RatFunc A) ∈ S := by
    have := memS 0
    rwa [hv0] at this
  have hs_mem : algebraMap A (RatFunc A) s ∈ S := by
    have := memS 1
    rwa [hv1] at this
  have hβ_mem : algebraMap A (RatFunc A) β ∈ S := by
    have := memS 2
    rwa [hv2] at this
  -- the image of the base field `K`
  have hK : ∀ k : K, algebraMap K (RatFunc A) k ∈ S := fun k =>
    (Subfield.subset_closure (s := Set.range (algebraMap R (RatFunc A))))
      ⟨⟨algebraMap K (RatFunc A) k, Subalgebra.algebraMap_mem R k⟩, rfl⟩
  -- `K⟮s, β⟯ ⊆ S`
  have hM_le : (IntermediateField.adjoin K
      ({algebraMap A (RatFunc A) s, algebraMap A (RatFunc A) β} : Set (RatFunc A))).toSubfield
      ≤ S := by
    change Subfield.closure (Set.range (algebraMap K (RatFunc A)) ∪
      ({algebraMap A (RatFunc A) s, algebraMap A (RatFunc A) β} : Set (RatFunc A))) ≤ S
    rw [Subfield.closure_le]
    rintro x (hx | hx)
    · obtain ⟨k, rfl⟩ := hx; exact hK k
    · rw [Set.mem_insert_iff] at hx
      rcases hx with rfl | hx
      · exact hs_mem
      · rw [Set.mem_singleton_iff] at hx; subst hx; exact hβ_mem
  -- every element of the image of `A` in `RatFunc A` lies in `K⟮s, β⟯` (via `hgen`)
  have hrange_le_M : Set.range (algebraMap A (RatFunc A)) ⊆
      ((IntermediateField.adjoin K
        ({algebraMap A (RatFunc A) s, algebraMap A (RatFunc A) β} : Set (RatFunc A))) :
        Set (RatFunc A)) := by
    rintro x ⟨a, rfl⟩
    let ι : A →ₐ[K] RatFunc A := (Algebra.ofId A (RatFunc A)).restrictScalars K
    have hmap : IntermediateField.map ι (IntermediateField.adjoin K ({s, β} : Set A)) =
        IntermediateField.adjoin K
          ({algebraMap A (RatFunc A) s, algebraMap A (RatFunc A) β} : Set (RatFunc A)) := by
      rw [IntermediateField.adjoin_map K ({s, β} : Set A) ι, Set.image_pair]
      rfl
    have ha : a ∈ IntermediateField.adjoin K ({s, β} : Set A) := by
      rw [hgen]; exact Subfield.mem_top a
    have hthis : ι a ∈ IntermediateField.map ι (IntermediateField.adjoin K ({s, β} : Set A)) :=
      (IntermediateField.mem_map (IntermediateField.adjoin K ({s, β} : Set A))).mpr
        ⟨a, ha, rfl⟩
    rw [hmap] at hthis
    exact hthis
  have hA : ∀ a : A, algebraMap A (RatFunc A) a ∈ S := fun a => hM_le (hrange_le_M ⟨a, rfl⟩)
  -- so `S` is a subfield of `RatFunc A` over `A`, containing `RatFunc.X` and all of `A`
  have htopA : S.toIntermediateField hA = ⊤ := by
    rw [eq_top_iff]
    rw [show (⊤ : IntermediateField A (RatFunc A)) =
      IntermediateField.adjoin A ({(RatFunc.X : RatFunc A)} : Set (RatFunc A)) from
        (RatFunc.adjoin_X (K := A)).symm]
    rw [IntermediateField.adjoin_le_iff]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact hX
  -- hence `S = ⊤`
  have hScoeeq : (S : Set (RatFunc A)) = Set.univ := by
    rw [← Subfield.coe_toIntermediateField S hA, htopA, IntermediateField.coe_top]
  rw [eq_top_iff]
  intro x _
  show x ∈ (S : Set (RatFunc A))
  rw [hScoeeq]
  trivial

end Work.MotK.CensusBridge
