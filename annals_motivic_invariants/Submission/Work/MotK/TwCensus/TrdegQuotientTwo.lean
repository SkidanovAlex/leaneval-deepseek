import Mathlib
import Submission.Work.MotV.trdeg_fractionRing_mvPolynomial

set_option linter.unusedVariables false -- v435-speed

set_option linter.style.haveILetI false

namespace Work.MotK.TwCensus

open MvPolynomial

/-- A non-zero prime ideal of `K[X,Y]` cuts out a curve: the residue field of the quotient
has transcendence degree at most one over `K`.

The proof runs entirely through the *ring* `A = K[X,Y]/q` (rather than its fraction field):
`A` is generated as a `K`-algebra by the two classes `x, y` of `X` and `Y`, so
`Algebra.IsAlgebraic.trdeg_le_cardinalMk` gives `trdeg K A ≤ 2`.  If the degree were `2`, then
`Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite` would make `![x,y]`
a transcendence basis, hence algebraically independent; but any non-zero `f ∈ q` yields the
non-trivial relation `aeval ![x,y] f = 0`.  Hence `trdeg K A ≤ 1`, and the passage to the
fraction field changes nothing (`IsFractionRing.isAlgebraic` + `trdeg_add_eq`). -/
theorem TrdegQuotientTwo (K : Type) [Field K] (q : Ideal (MvPolynomial (Fin 2) K)) [q.IsPrime]
    (hq : q ≠ ⊥) :
    Algebra.trdeg K (FractionRing (MvPolynomial (Fin 2) K ⧸ q)) ≤ 1 := by
  let A := MvPolynomial (Fin 2) K ⧸ q
  -- the two generators of `A` as a `K`-algebra
  let v : Fin 2 → A := fun i => Ideal.Quotient.mk q (MvPolynomial.X i)
  -- `A` is generated by `v 0` and `v 1`
  have hgen : Algebra.adjoin K (Set.range v) = ⊤ := by
    have hrange : Set.range v = (Ideal.Quotient.mkₐ K q) '' Set.range MvPolynomial.X := by
      ext a
      constructor
      · rintro ⟨i, rfl⟩; exact ⟨MvPolynomial.X i, ⟨i, rfl⟩, rfl⟩
      · rintro ⟨p, ⟨i, rfl⟩, rfl⟩; exact ⟨i, rfl⟩
    rw [hrange, ← AlgHom.map_adjoin, MvPolynomial.adjoin_range_X, Algebra.map_top]
    exact (AlgHom.range_eq_top (Ideal.Quotient.mkₐ K q)).mpr (Ideal.Quotient.mkₐ_surjective K q)
  -- hence `A` is algebraic over the subalgebra it generates (which is everything)
  haveI hinst : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range v)) A := by
    rw [hgen]
    exact ⟨fun a => ⟨Polynomial.X - Polynomial.C ⟨a, by simp⟩,
      by simp [Polynomial.X_sub_C_ne_zero], by simp⟩⟩
  -- so `trdeg K A ≤ #(range v) = 2`
  have hle2 : Algebra.trdeg K A ≤ 2 := by
    have h := Algebra.IsAlgebraic.trdeg_le_cardinalMk K (Set.range v)
    have h2 : Cardinal.mk ↥(Set.range v) ≤ 2 := by
      calc Cardinal.mk ↥(Set.range v) ≤ Cardinal.mk (Fin 2) := Cardinal.mk_range_le
        _ = 2 := by simp
    exact h.trans h2
  -- the fraction field is algebraic over `A`, so it has the same transcendence degree
  have htr : Algebra.trdeg K (FractionRing A) = Algebra.trdeg K A := by
    haveI : Algebra.IsAlgebraic A (FractionRing A) := Work.MotV.isAlgebraic_fractionRing_self A
    have h := trdeg_add_eq K A (A := FractionRing A)
    have h0 : Algebra.trdeg A (FractionRing A) = 0 := trdeg_eq_zero
    rw [h0, add_zero] at h
    exact h.symm
  rw [htr]
  -- it remains to rule out `trdeg K A = 2`
  by_contra hcon
  rw [not_le] at hcon
  have h2 : (2 : Cardinal) ≤ Algebra.trdeg K A := by
    have hh := Cardinal.natCast_add_one_le_iff (n := 1) (c := Algebra.trdeg K A) |>.mpr hcon
    simpa [Nat.cast_one, one_add_one_eq_two] using hh
  have hbasis : IsTranscendenceBasis K v :=
    Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite K v (by simpa using h2)
  have hinj : Function.Injective (MvPolynomial.aeval v) :=
    algebraicIndependent_iff_injective_aeval.mp hbasis.1
  -- a non-zero element of `q` gives a non-trivial algebraic relation among `v 0, v 1`
  obtain ⟨f, hfq, hfne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq
  have haeval : MvPolynomial.aeval v = Ideal.Quotient.mkₐ K q := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X]
    rw [Ideal.Quotient.mkₐ_eq_mk]
  have h0 : MvPolynomial.aeval v f = 0 := by
    rw [haeval, Ideal.Quotient.mkₐ_eq_mk]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hfq
  exact hfne (hinj (by simpa using h0))

end Work.MotK.TwCensus
