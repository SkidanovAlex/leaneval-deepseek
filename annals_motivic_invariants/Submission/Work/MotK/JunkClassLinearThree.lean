/-!
# `Work.MotK.JunkClassLinearThree`

A degree-one hypersurface of `𝔸³_K` — the height-one prime `(ℓ)` generated by a polynomial `ℓ` of
total degree one over a field `K` — is a *junk* divisor in the sense of `Work.MotV.JunkClass`: its
residue field is the rational surface `K(x,y) = RatFunc (RatFunc K)`.

The algebraic content is that cutting out one linear form from `K[X₀,X₁,X₂]` leaves a polynomial
ring in two variables:

* `Work.MotK.renameQuotientTransport` transports the quotient `K[X₀,X₁,X₂]/(ℓ)` along a permutation
  of the variables, so that a variable with nonzero coefficient can be moved to `X₀`;
* `Work.MotK.linearFormQuotient` is the elimination lemma: if `f` has total degree `≤ 1` and its
  coefficient at `X₀` is nonzero, then `K[X₀,…,Xₙ]/(f) ≅ₐ[K] K[X₁,…,Xₙ]`.  Its proof splits off
  `X₀` with `MvPolynomial.finSuccEquiv` (turning `f` into `C a * X + C b` with `a` a unit) and
  collapses `R[X]/(C a * X + C b) ≅ R`.
* the fraction fields are then `Work.CrauderKatz.BlowUp.fractionRing_algEquiv_of_algEquiv` and
  `Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo`, and
  `Work.MotK.junkClass_of_resF_ratFunc_ratFunc` (together with the geometric-ruledness
  `Work.MotK.ratFunc_geometricallyRuled` of the rational function field) concludes.

The two finSuccEquiv coefficients computations and the two general lemmas about polynomial
quotients / coefficients of degree-one polynomials live in `Submission/Work/MotK/JunkLinAux/`.

The lemma is stated for `Work.MotV.JunkClass` and `Work.MotA.polySpec` only, so the file imports
`Submission.Work.MotV.Defs` rather than any particular link-certificate file; the junk criterion
itself is reproduced below in self-contained form.
-/

namespace Work.MotK

/-- **The rational function field `K(t)` is geometrically ruled over `K`.**  The identity embedding
`RatFunc K →ₐ[K] RatFunc K` is non-constant at `RatFunc.X`: `RatFunc.X` is not in the image of the
constants, because `RatFunc.intDegree_C = 0 ≠ 1 = RatFunc.intDegree_X`.

This is the junk criterion for the rational divisors: it instantiates
`Work.MotV.GeomRuled K F₀ = ∃ M, ∃ ι : F₀ →ₐ[K] RatFunc M, ∃ x, ∀ c : M, algebraMap M _ c ≠ ι x`
with `F₀ = M = K(t)`. -/
theorem ratFunc_geometricallyRuled (K : Type) [Field K] : Work.MotV.GeomRuled K (RatFunc K) := by
  refine ⟨K, inferInstance, inferInstance, AlgHom.id K (RatFunc K), RatFunc.X, ?_⟩
  intro c hc
  have h2 : (RatFunc.C c : RatFunc K) = RatFunc.X := by
    simpa [RatFunc.algebraMap_eq_C] using hc
  have hdeg := congrArg (RatFunc.intDegree (K := K)) h2
  rw [RatFunc.intDegree_C, RatFunc.intDegree_X] at hdeg
  exact one_ne_zero hdeg.symm

/-- **A divisor with residue field `K(t)(z)` is junk.**  A codimension-one point of `𝔸ⁿ_K` whose
residue field is `RatFunc (RatFunc K)` — the rational surface `𝔸¹ × 𝔸¹` over `K` — satisfies
`Work.MotV.JunkClass`: take `F₀ = RatFunc K` and use `Work.MotK.ratFunc_geometricallyRuled`. -/
theorem junkClass_of_resF_ratFunc_ratFunc (K : Type) [Field K] {n : ℕ}
    (x : Work.MotA.polySpec K n)
    (hx : Nonempty (Work.MotV.resF K x ≃ₐ[K] RatFunc (RatFunc K))) :
    Work.MotV.JunkClass K x :=
  ⟨RatFunc K, inferInstance, inferInstance, ratFunc_geometricallyRuled K, hx⟩

/-- **Elimination of a variable with a nonzero linear coefficient.**  If `f : K[X₀,…,Xₙ]` has total
degree `≤ 1` and the coefficient of `X₀` in `f` is nonzero (so `f = a·X₀ + g(X₁,…,Xₙ)` with
`a ≠ 0`, hence a unit), then the quotient of `K[X₀,…,Xₙ]` by `(f)` is a polynomial ring on the
remaining `n` variables.

Route: `MvPolynomial.finSuccEquiv K n` identifies `K[X₀,…,Xₙ]` with `K[X₁,…,Xₙ][X]`, sending `X₀`
to `X`; the image of `f` has `natDegree ≤ 1`
(`Work.MotK.JunkLinAux.finSuccEquiv_natDegree_le_one`) and its `X`-coefficient is the constant
reflecting the coefficient of `X₀`
(`Work.MotK.JunkLinAux.finSuccEquiv_coeff_one`), which is a unit; then
`Work.MotK.JunkLinAux.quotient_span_of_natDegree_le_one` collapses the quotient, and
`Ideal.quotientEquivAlg` transports it back along `finSuccEquiv`. -/
lemma linearFormQuotient {K : Type} [Field K] {n : ℕ} (f : MvPolynomial (Fin (n + 1)) K)
    (hf : f.totalDegree ≤ 1) (h0 : f.coeff (Finsupp.single 0 1) ≠ 0) :
    Nonempty ((MvPolynomial (Fin (n + 1)) K ⧸ Ideal.span {f}) ≃ₐ[K] MvPolynomial (Fin n) K) := by
  have hndt : (MvPolynomial.finSuccEquiv K n f).natDegree ≤ 1 :=
    JunkLinAux.finSuccEquiv_natDegree_le_one f hf
  have hcoeff : (MvPolynomial.finSuccEquiv K n f).coeff 1
      = MvPolynomial.C (f.coeff (Finsupp.single 0 1)) :=
    JunkLinAux.finSuccEquiv_coeff_one f hf
  have hunit : IsUnit ((MvPolynomial.finSuccEquiv K n f).coeff 1) := by
    rw [hcoeff]
    exact IsUnit.map MvPolynomial.C (isUnit_iff_ne_zero.mpr h0)
  obtain ⟨e⟩ := JunkLinAux.quotient_span_of_natDegree_le_one
    (MvPolynomial.finSuccEquiv K n f) hndt hunit
  have hmap : Ideal.span {MvPolynomial.finSuccEquiv K n f}
      = Ideal.map (↑(MvPolynomial.finSuccEquiv K n)) (Ideal.span {f}) := by
    rw [Ideal.map_span, Set.image_singleton]
  exact ⟨(Ideal.quotientEquivAlg _ _ (MvPolynomial.finSuccEquiv K n) hmap).trans
    (AlgEquiv.restrictScalars K e)⟩

/-- **Transport of the quotient along a permutation of the variables.**  For any `f` and any
permutation of the coordinates, `K[X₀,X₁,X₂]/(f) ≅ K[X₀,X₁,X₂]/(σ f)`; here the permutation is the
transposition `Equiv.swap 0 i`, used to move a variable with nonzero coefficient into position
`0` before applying `linearFormQuotient`. -/
lemma renameQuotientTransport {K : Type} [Field K] (f : MvPolynomial (Fin 3) K) (i : Fin 3) :
    Nonempty ((MvPolynomial (Fin 3) K ⧸ Ideal.span {f}) ≃ₐ[K]
      (MvPolynomial (Fin 3) K ⧸ Ideal.span {MvPolynomial.rename (Equiv.swap 0 i) f})) := by
  refine ⟨Ideal.quotientEquivAlg (Ideal.span {f})
    (Ideal.span {MvPolynomial.rename (Equiv.swap 0 i) f})
    (MvPolynomial.renameEquiv K (Equiv.swap 0 i)) ?_⟩
  rw [Ideal.map_span, Set.image_singleton]
  congr 1

theorem JunkClassLinearThree {K : Type} [Field K] (ℓ : MvPolynomial (Fin 3) K)
    (hℓ : ℓ.totalDegree = 1)
    (h : (Ideal.span {ℓ} : Ideal (MvPolynomial (Fin 3) K)).IsPrime) :
    Work.MotV.JunkClass K ⟨Ideal.span {ℓ}, h⟩ := by
  refine junkClass_of_resF_ratFunc_ratFunc K ⟨Ideal.span {ℓ}, h⟩ ?_
  -- some coefficient of a single variable is nonzero
  obtain ⟨i, hi⟩ := JunkLinAux.exists_coeff_single_of_totalDegree_eq_one ℓ hℓ
  -- move that variable into position `0` by a transposition
  have hcoeff : (MvPolynomial.rename (Equiv.swap 0 i) ℓ).coeff (Finsupp.single 0 1) ≠ 0 := by
    have hmaps : (Finsupp.single i 1 : Fin 3 →₀ ℕ).mapDomain (Equiv.swap 0 i)
        = Finsupp.single 0 1 := by
      rw [Finsupp.mapDomain_single]
      congr 1
      exact Equiv.swap_apply_right 0 i
    rw [← hmaps, MvPolynomial.coeff_rename_mapDomain (Equiv.swap 0 i)
      (Equiv.swap 0 i).injective ℓ (Finsupp.single i 1)]
    exact hi
  have hlt : (MvPolynomial.rename (Equiv.swap 0 i) ℓ).totalDegree ≤ 1 :=
    le_trans (MvPolynomial.totalDegree_rename_le (Equiv.swap 0 i) ℓ) (le_of_eq hℓ)
  -- eliminate that variable
  obtain ⟨e1⟩ := linearFormQuotient (MvPolynomial.rename (Equiv.swap 0 i) ℓ) hlt hcoeff
  obtain ⟨e0⟩ := renameQuotientTransport ℓ i
  -- pass to fraction fields
  obtain ⟨e2⟩ := Work.CrauderKatz.BlowUp.fractionRing_algEquiv_of_algEquiv (e0.trans e1)
  obtain ⟨e3⟩ := Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo K
  exact ⟨e2.trans e3⟩

end Work.MotK
