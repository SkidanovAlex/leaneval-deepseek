def zniKer (a b h : K) : Ideal (MvPolynomial (Fin 4) K) where
  carrier := {f | ∀ g : MvPolynomial (Fin 4) K, zniS a b h (g * f) = 0}
  zero_mem' := by intro g; rw [mul_zero, map_zero]
  add_mem' := by intro x y hx hy g; rw [mul_add, map_add, hx, hy, add_zero]
  smul_mem' := by
    intro c x hx g
    rw [Algebra.smul_def, ← mul_assoc]
    exact hx (g * c)

lemma zniS_mem (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    {f : MvPolynomial (Fin 4) K} (hf : f ∈ zpgI4 a b h) : zniS a b h f = 0 := by
  have hle : Ideal.span (Set.range (zpgQ a b h)) ≤ zniKer a b h := by
    rw [Ideal.span_le]
    rintro x ⟨k, rfl⟩
    intro g
    rw [zniS_mul_eq_sum]
    apply Finset.sum_eq_zero
    intro M hM
    simp only [zniMain a b h ha hb hh M k, smul_zero]
  rw [zpgI4] at hf
  have h1 := hle hf
  have h2 := h1 1
  simpa using h2

lemma zniS_fix (a b h : K) {f : MvPolynomial (Fin 4) K}
    (hf : ∀ M ∈ f.support, ¬ (zniLT 0 ≤ M) ∧ ¬ (zniLT 1 ≤ M) ∧ ¬ (zniLT 2 ≤ M)
      ∧ ¬ (zniLT 3 ≤ M) ∧ ¬ (zniLT 4 ≤ M)) : zniS a b h f = f := by
  conv_lhs => rw [MvPolynomial.as_sum f]
  rw [map_sum]
  rw [show (f.support.sum fun M => zniS a b h (monomial M (f.coeff M)))
      = f.support.sum (fun M => monomial M (f.coeff M)) from by
    apply Finset.sum_congr rfl
    intro M hM
    rw [show (monomial M (f.coeff M) : MvPolynomial (Fin 4) K)
        = C (f.coeff M) * monomial M 1 from by rw [MvPolynomial.C_mul_monomial, mul_one],
      zniS_C_mul, zniS_monomial, zniSM_bnone a b h M (hf M hM).1 (hf M hM).2.1 (hf M hM).2.2.1
        (hf M hM).2.2.2.1 (hf M hM).2.2.2.2,
      MvPolynomial.C_mul_monomial, mul_one]]
  exact (MvPolynomial.as_sum f).symm

end

theorem ZpgI4NInterI (K : Type) [Field K] (a b h : K)
    (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (n : MvPolynomial (Fin 4) K)
    (hred : ∀ c ∈ n.support,
      ¬ ((Finsupp.single 0 2 : Fin 4 →₀ ℕ) ≤ c) ∧
      ¬ ((Finsupp.single 0 1 + Finsupp.single 1 1 : Fin 4 →₀ ℕ) ≤ c) ∧
      ¬ ((Finsupp.single 1 2 : Fin 4 →₀ ℕ) ≤ c) ∧
      ¬ ((Finsupp.single 1 1 + Finsupp.single 2 1 : Fin 4 →₀ ℕ) ≤ c) ∧
      ¬ ((Finsupp.single 2 2 : Fin 4 →₀ ℕ) ≤ c))
    (hn : n ∈ Work.MotK.TGen.zpgI4 a b h) : n = 0 := by
  have h1 : zniS a b h n = 0 := zniS_mem a b h ha hb hh hn
  have h2 : zniS a b h n = n := by
    apply zniS_fix
    intro M hM
    obtain ⟨e1, e2, e3, e4, e5⟩ := hred M hM
    exact ⟨e4, e3, e2, e1, e5⟩
  rw [h2] at h1
  exact h1

end Work.MotK.TGen
