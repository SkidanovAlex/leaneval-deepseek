lemma zni_canon0 (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (N : Fin 4 →₀ ℕ) (h0 : zniLT 0 ≤ N) :
    zniS a b h (monomial (N - zniLT 0) (1 : K) * zpgQ a b h 0) = 0 := by
  rw [zniS_g_decomp]
  rw [tsub_add_cancel_of_le h0]
  rw [zniSM_b0 a b h N h0]
  convert zni_cancel a b h ha hb hh 0
    (C (zniRC a b h 0 0) * zniSM a b h (N - zniLT 0 + zniRM 0 0)
      + C (zniRC a b h 0 1) * zniSM a b h (N - zniLT 0 + zniRM 0 1)) using 1
  refl_ring1

