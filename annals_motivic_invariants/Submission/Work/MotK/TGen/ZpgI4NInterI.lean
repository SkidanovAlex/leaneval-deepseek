lemma zniS_mul_eq_sum (a b h : K) (g p : MvPolynomial (Fin 4) K) :
    zniS a b h (g * p)
      = g.support.sum (fun M => g.coeff M • zniS a b h (monomial M (1 : K) * p)) := by
  conv_lhs => rw [show g = g.support.sum (fun M => monomial M (g.coeff M)) from
    MvPolynomial.as_sum g]
  rw [Finset.sum_mul, map_sum]
  apply Finset.sum_congr rfl
  intro M hM
  rw [show (monomial M (g.coeff M) : MvPolynomial (Fin 4) K) * p
      = C (g.coeff M) * (monomial M 1 * p) from by
    rw [← mul_assoc, MvPolynomial.C_mul_monomial, mul_one],
    zniS_C_mul, MvPolynomial.C_mul']

lemma zniMain (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    ∀ (A : Fin 4 →₀ ℕ) (k : Fin 5), zniS a b h (monomial A (1 : K) * zpgQ a b h k) = 0 := by
  suffices H : ∀ n : ℕ,
      (∀ A, zniWt A + 14 = n → zniS a b h (monomial A (1 : K) * zpgQ a b h 0) = 0) ∧
      (∀ A, zniWt A + 14 = n → zniS a b h (monomial A (1 : K) * zpgQ a b h 1) = 0) ∧
      (∀ A, zniWt A + 13 = n → zniS a b h (monomial A (1 : K) * zpgQ a b h 2) = 0) ∧
      (∀ A, zniWt A + 12 = n → zniS a b h (monomial A (1 : K) * zpgQ a b h 3) = 0) ∧
      (∀ A, zniWt A + 14 = n → zniS a b h (monomial A (1 : K) * zpgQ a b h 4) = 0) by
    intro A k
    fin_cases k
    · exact (H _).1 A rfl
    · exact (H _).2.1 A rfl
    · exact (H _).2.2.1 A rfl
    · exact (H _).2.2.2.1 A rfl
    · exact (H _).2.2.2.2 A rfl
  intro n
  refine Nat.strong_induction_on n ?_
  intro n ih
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · -- component 0
    intro A hw
    by_cases h0 : zniLT 0 ≤ A + zniLT 0
    · simpa only [zni_add_sub_self_right] using zni_canon0 a b h ha hb hh (A + zniLT 0) h0
    · by_cases h1 : zniLT 1 ≤ A + zniLT 0
      · exact absurd (zni_le_add (zniLT 0) A) h0
      · by_cases h2 : zniLT 2 ≤ A + zniLT 0
        · exact absurd (zni_le_add (zniLT 0) A) h0
        · by_cases h3 : zniLT 3 ≤ A + zniLT 0
          · exact absurd (zni_le_add (zniLT 0) A) h0
          · by_cases h4 : zniLT 4 ≤ A + zniLT 0
            · exact absurd (zni_le_add (zniLT 0) A) h0
