import Mathlib
import Submission.Work.MotK.TGen.ZTwistDivGeomDefs
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# `Work.MotK.TGen.ZpgI4NInterI`

The chart ideal of the `h`-twisted Klein curve meets the `K[y₄]`-span of
`{1, y₁, y₂, y₃, y₁y₃}` trivially: a `K`-linear normal form for the ideal generated by the five
chart quadrics is built, with the weight `w(y₁)=6, w(y₂)=7, w(y₃)=7, w(y₄)=1` as termination
measure; its confluence is supplied by explicit `S`-polynomial certificates.
-/

namespace Work.MotK.TGen

open MvPolynomial

set_option maxHeartbeats 8000000

noncomputable section

variable {K : Type} [Field K]

/-! ## 1. The weight and the monomial data -/

/-- The weight of a monomial, `w(y₁) = 6`, `w(y₂) = 7`, `w(y₃) = 7`, `w(y₄) = 1`. -/
def zniWt (e : Fin 4 →₀ ℕ) : ℕ := 6 * e 0 + 7 * e 1 + 7 * e 2 + e 3

lemma zniWt_add (p q : Fin 4 →₀ ℕ) : zniWt (p + q) = zniWt p + zniWt q := by
  simp only [zniWt, Finsupp.add_apply]
  first | refl_ring1 | ring

lemma zniWt_sub {p q : Fin 4 →₀ ℕ} (h : q ≤ p) : zniWt (p - q) = zniWt p - zniWt q := by
  have h1 := zniWt_add (p - q) q
  rw [tsub_add_cancel_of_le h] at h1
  omega

/-- The leading monomials (as exponent vectors) of the five chart quadrics. -/
def zniLT : Fin 5 → Fin 4 →₀ ℕ
  | 0 => Finsupp.single 1 1 + Finsupp.single 2 1
  | 1 => Finsupp.single 1 2
  | 2 => Finsupp.single 0 1 + Finsupp.single 1 1
  | 3 => Finsupp.single 0 2
  | 4 => Finsupp.single 2 2

/-- The weights of the leading monomials. -/
def zniLTW : Fin 5 → ℕ
  | 0 => 14
  | 1 => 14
  | 2 => 13
  | 3 => 12
  | 4 => 14

lemma zniWt_LT (k : Fin 5) : zniWt (zniLT k) = zniLTW k := by
  fin_cases k <;> norm_num [zniLT, zniLTW, zniWt, Finsupp.add_apply]

/-- The exponent vectors of the two non-leading monomials of `zpgQ a b h k`. -/
def zniRM : Fin 5 → Fin 2 → Fin 4 →₀ ℕ
  | 0, 0 => Finsupp.single 0 1 + Finsupp.single 3 1
  | 0, 1 => 0
  | 1, 0 => Finsupp.single 3 1
  | 1, 1 => Finsupp.single 0 1 + Finsupp.single 2 1
  | 2, 0 => Finsupp.single 3 2
  | 2, 1 => Finsupp.single 2 1
  | 3, 0 => Finsupp.single 2 1 + Finsupp.single 3 1
  | 3, 1 => Finsupp.single 1 1
  | 4, 0 => Finsupp.single 0 1
  | 4, 1 => Finsupp.single 1 1 + Finsupp.single 3 1

/-- The `X`-product form of the leading monomials. -/
def zniLTP : Fin 5 → MvPolynomial (Fin 4) K
  | 0 => X 1 * X 2
  | 1 => X 1 ^(2:ℕ)
  | 2 => X 0 * X 1
  | 3 => X 0 ^(2:ℕ)
  | 4 => X 2 ^(2:ℕ)

/-- The `X`-product form of the two non-leading monomials. -/
def zniRMP : Fin 5 → Fin 2 → MvPolynomial (Fin 4) K
  | 0, 0 => X 0 * X 3
  | 0, 1 => 1
  | 1, 0 => X 3
  | 1, 1 => X 0 * X 2
  | 2, 0 => X 3 ^(2:ℕ)
  | 2, 1 => X 2
  | 3, 0 => X 2 * X 3
  | 3, 1 => X 1
  | 4, 0 => X 0
  | 4, 1 => X 1 * X 3

/-- The coefficients of the leading monomials of the five chart quadrics. -/
def zniLC (a b h : K) : Fin 5 → K
  | 0 => a ^(2:ℕ) * h ^(2:ℕ)
  | 1 => -(a * b)
  | 2 => a ^(2:ℕ)
  | 3 => -(a * b)
  | 4 => -(a * b * h ^(2:ℕ))

/-- The coefficients of the two non-leading monomials of `zpgQ a b h k`. -/
def zniRC (a b h : K) : Fin 5 → Fin 2 → K
  | 0, 0 => -b ^(2:ℕ) * h ^(2:ℕ)
  | 0, 1 => -(a * b)
  | 1, 0 => a ^(2:ℕ)
  | 1, 1 => -b ^(2:ℕ)
  | 2, 0 => -(a * b * h ^(2:ℕ))
  | 2, 1 => -b ^(2:ℕ)
  | 3, 0 => a ^(2:ℕ) * h ^(2:ℕ)
  | 3, 1 => -b ^(2:ℕ)
  | 4, 0 => a ^(2:ℕ)
  | 4, 1 => -(b ^(2:ℕ) * h ^(2:ℕ))

/-! ## 2. Monomial arithmetic -/

lemma zni_mono_mul (M N : Fin 4 →₀ ℕ) :
    (monomial M (1 : K) : MvPolynomial (Fin 4) K) * monomial N 1 = monomial (M + N) 1 := by
  rw [MvPolynomial.monomial_mul_monomial, mul_one]

lemma zni_mono_one (i : Fin 4) :
    (monomial (Finsupp.single i 1) (1 : K) : MvPolynomial (Fin 4) K) = X i := by
  rw [← MvPolynomial.X_pow_eq_monomial, pow_one]

lemma zni_mono_pow (i : Fin 4) (n : ℕ) :
    (monomial (Finsupp.single i n) (1 : K) : MvPolynomial (Fin 4) K) = X i ^ n := by
  rw [MvPolynomial.X_pow_eq_monomial]

lemma zni_mono_zero : (monomial (0 : Fin 4 →₀ ℕ) (1 : K) : MvPolynomial (Fin 4) K) = 1 := by
  rw [MvPolynomial.monomial_eq, C_1, one_mul, Finsupp.prod_zero_index]

lemma zni_mono_mul_C (A : Fin 4 →₀ ℕ) (c : K) (P : MvPolynomial (Fin 4) K) :
    (monomial A (1 : K) : MvPolynomial (Fin 4) K) * (C c * P) = C c * (monomial A 1 * P) := by
  refl_ring1

lemma zni_mono_mul_monomial (A B : Fin 4 →₀ ℕ) (c : K) :
    (monomial A (1 : K) : MvPolynomial (Fin 4) K) * (C c * monomial B 1)
      = C c * monomial (A + B) 1 := by
  rw [zni_mono_mul_C, zni_mono_mul]

lemma zniLTP_eq (k : Fin 5) : zniLTP (K := K) k = monomial (zniLT k) 1 := by
  fin_cases k
  · show zniLTP (K := K) (0 : Fin 5) = monomial (zniLT (0 : Fin 5)) 1
    rw [show (zniLTP (K := K) (0 : Fin 5) : MvPolynomial (Fin 4) K) = X 1 * X 2 from rfl,
      show (zniLT (0 : Fin 5) : Fin 4 →₀ ℕ) = Finsupp.single 1 1 + Finsupp.single 2 1 from rfl,
      ← zni_mono_one 1, ← zni_mono_one 2, zni_mono_mul]
  · show zniLTP (K := K) (1 : Fin 5) = monomial (zniLT (1 : Fin 5)) 1
    rw [show (zniLTP (K := K) (1 : Fin 5) : MvPolynomial (Fin 4) K) = X 1 ^(2:ℕ) from rfl,
      show (zniLT (1 : Fin 5) : Fin 4 →₀ ℕ) = Finsupp.single 1 2 from rfl, ← zni_mono_pow 1 2]
  · show zniLTP (K := K) (2 : Fin 5) = monomial (zniLT (2 : Fin 5)) 1
    rw [show (zniLTP (K := K) (2 : Fin 5) : MvPolynomial (Fin 4) K) = X 0 * X 1 from rfl,
      show (zniLT (2 : Fin 5) : Fin 4 →₀ ℕ) = Finsupp.single 0 1 + Finsupp.single 1 1 from rfl,
      ← zni_mono_one 0, ← zni_mono_one 1, zni_mono_mul]
  · show zniLTP (K := K) (3 : Fin 5) = monomial (zniLT (3 : Fin 5)) 1
    rw [show (zniLTP (K := K) (3 : Fin 5) : MvPolynomial (Fin 4) K) = X 0 ^(2:ℕ) from rfl,
      show (zniLT (3 : Fin 5) : Fin 4 →₀ ℕ) = Finsupp.single 0 2 from rfl, ← zni_mono_pow 0 2]
  · show zniLTP (K := K) (4 : Fin 5) = monomial (zniLT (4 : Fin 5)) 1
    rw [show (zniLTP (K := K) (4 : Fin 5) : MvPolynomial (Fin 4) K) = X 2 ^(2:ℕ) from rfl,
      show (zniLT (4 : Fin 5) : Fin 4 →₀ ℕ) = Finsupp.single 2 2 from rfl, ← zni_mono_pow 2 2]

lemma zniRMP_eq (k : Fin 5) (t : Fin 2) : zniRMP (K := K) k t = monomial (zniRM k t) 1 := by
  fin_cases k <;> fin_cases t
  · show zniRMP (K := K) (0 : Fin 5) (0 : Fin 2) = monomial (zniRM (0 : Fin 5) (0 : Fin 2)) 1
    rw [show (zniRMP (K := K) (0 : Fin 5) (0 : Fin 2) : MvPolynomial (Fin 4) K) = X 0 * X 3 from rfl,
      show (zniRM (0 : Fin 5) (0 : Fin 2) : Fin 4 →₀ ℕ)
        = Finsupp.single 0 1 + Finsupp.single 3 1 from rfl,
      ← zni_mono_one 0, ← zni_mono_one 3, zni_mono_mul]
  · show zniRMP (K := K) (0 : Fin 5) (1 : Fin 2) = monomial (zniRM (0 : Fin 5) (1 : Fin 2)) 1
    rw [show (zniRMP (K := K) (0 : Fin 5) (1 : Fin 2) : MvPolynomial (Fin 4) K) = 1 from rfl,
      show (zniRM (0 : Fin 5) (1 : Fin 2) : Fin 4 →₀ ℕ) = 0 from rfl, zni_mono_zero]
  · show zniRMP (K := K) (1 : Fin 5) (0 : Fin 2) = monomial (zniRM (1 : Fin 5) (0 : Fin 2)) 1
    rw [show (zniRMP (K := K) (1 : Fin 5) (0 : Fin 2) : MvPolynomial (Fin 4) K) = X 3 from rfl,
      show (zniRM (1 : Fin 5) (0 : Fin 2) : Fin 4 →₀ ℕ) = Finsupp.single 3 1 from rfl, zni_mono_one]
  · show zniRMP (K := K) (1 : Fin 5) (1 : Fin 2) = monomial (zniRM (1 : Fin 5) (1 : Fin 2)) 1
    rw [show (zniRMP (K := K) (1 : Fin 5) (1 : Fin 2) : MvPolynomial (Fin 4) K) = X 0 * X 2 from rfl,
      show (zniRM (1 : Fin 5) (1 : Fin 2) : Fin 4 →₀ ℕ)
        = Finsupp.single 0 1 + Finsupp.single 2 1 from rfl,
      ← zni_mono_one 0, ← zni_mono_one 2, zni_mono_mul]
  · show zniRMP (K := K) (2 : Fin 5) (0 : Fin 2) = monomial (zniRM (2 : Fin 5) (0 : Fin 2)) 1
    rw [show (zniRMP (K := K) (2 : Fin 5) (0 : Fin 2) : MvPolynomial (Fin 4) K) = X 3 ^(2:ℕ) from rfl,
      show (zniRM (2 : Fin 5) (0 : Fin 2) : Fin 4 →₀ ℕ) = Finsupp.single 3 2 from rfl, zni_mono_pow]
  · show zniRMP (K := K) (2 : Fin 5) (1 : Fin 2) = monomial (zniRM (2 : Fin 5) (1 : Fin 2)) 1
    rw [show (zniRMP (K := K) (2 : Fin 5) (1 : Fin 2) : MvPolynomial (Fin 4) K) = X 2 from rfl,
      show (zniRM (2 : Fin 5) (1 : Fin 2) : Fin 4 →₀ ℕ) = Finsupp.single 2 1 from rfl, zni_mono_one]
  · show zniRMP (K := K) (3 : Fin 5) (0 : Fin 2) = monomial (zniRM (3 : Fin 5) (0 : Fin 2)) 1
    rw [show (zniRMP (K := K) (3 : Fin 5) (0 : Fin 2) : MvPolynomial (Fin 4) K) = X 2 * X 3 from rfl,
      show (zniRM (3 : Fin 5) (0 : Fin 2) : Fin 4 →₀ ℕ)
        = Finsupp.single 2 1 + Finsupp.single 3 1 from rfl,
      ← zni_mono_one 2, ← zni_mono_one 3, zni_mono_mul]
  · show zniRMP (K := K) (3 : Fin 5) (1 : Fin 2) = monomial (zniRM (3 : Fin 5) (1 : Fin 2)) 1
    rw [show (zniRMP (K := K) (3 : Fin 5) (1 : Fin 2) : MvPolynomial (Fin 4) K) = X 1 from rfl,
      show (zniRM (3 : Fin 5) (1 : Fin 2) : Fin 4 →₀ ℕ) = Finsupp.single 1 1 from rfl, zni_mono_one]
  · show zniRMP (K := K) (4 : Fin 5) (0 : Fin 2) = monomial (zniRM (4 : Fin 5) (0 : Fin 2)) 1
    rw [show (zniRMP (K := K) (4 : Fin 5) (0 : Fin 2) : MvPolynomial (Fin 4) K) = X 0 from rfl,
      show (zniRM (4 : Fin 5) (0 : Fin 2) : Fin 4 →₀ ℕ) = Finsupp.single 0 1 from rfl, zni_mono_one]
  · show zniRMP (K := K) (4 : Fin 5) (1 : Fin 2) = monomial (zniRM (4 : Fin 5) (1 : Fin 2)) 1
    rw [show (zniRMP (K := K) (4 : Fin 5) (1 : Fin 2) : MvPolynomial (Fin 4) K) = X 1 * X 3 from rfl,
      show (zniRM (4 : Fin 5) (1 : Fin 2) : Fin 4 →₀ ℕ)
        = Finsupp.single 1 1 + Finsupp.single 3 1 from rfl,
      ← zni_mono_one 1, ← zni_mono_one 3, zni_mono_mul]

lemma zniWt_RM_lt (k : Fin 5) (t : Fin 2) : zniWt (zniRM k t) < zniWt (zniLT k) := by
  fin_cases k <;> fin_cases t <;> norm_num [zniRM, zniLT, zniWt, Finsupp.add_apply]

lemma zniLC_ne_zero (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) (k : Fin 5) :
    zniLC a b h k ≠ 0 := by
  fin_cases k <;> simp only [zniLC] <;> simp [ha, hb, hh]

/-! ## 3. Decomposition of the chart quadrics -/

lemma zpgQ_decomp (a b h : K) (k : Fin 5) :
    zpgQ a b h k = C (zniLC a b h k) * zniLTP (K := K) k
      + C (zniRC a b h k 0) * zniRMP (K := K) k 0
      + C (zniRC a b h k 1) * zniRMP (K := K) k 1 := by
  fin_cases k <;> simp only [zniLC, zniRC, zniLTP, zniRMP] <;> simp only [zpgQ] <;> simp <;> ring

lemma zpgQ_mono_decomp (a b h : K) (A : Fin 4 →₀ ℕ) (k : Fin 5) :
    monomial A (1 : K) * zpgQ a b h k
      = C (zniLC a b h k) * monomial (A + zniLT k) 1
        + C (zniRC a b h k 0) * monomial (A + zniRM k 0) 1
        + C (zniRC a b h k 1) * monomial (A + zniRM k 1) 1 := by
  rw [zpgQ_decomp, mul_add, mul_add, zniLTP_eq (K := K) k, zniRMP_eq (K := K) k 0,
    zniRMP_eq (K := K) k 1]
  rw [zni_mono_mul_monomial, zni_mono_mul_monomial, zni_mono_mul_monomial]

/-! ## 4. The normal form -/

lemma zniWt_mono {p q : Fin 4 →₀ ℕ} (h : p ≤ q) : zniWt p ≤ zniWt q := by
  have h1 : ∀ u : Fin 4, p u ≤ q u := fun u => by
    by_cases hu : u ∈ p.support
    · exact (Finsupp.le_iff p q).mp h u hu
    · rw [Finsupp.notMem_support_iff.mp hu]; exact zero_le
  have e0 := h1 0
  have e1 := h1 1
  have e2 := h1 2
  have e3 := h1 3
  simp only [zniWt]
  omega

lemma zniWt_step {N : Fin 4 →₀ ℕ} {k : Fin 5} (hk : zniLT k ≤ N) (t : Fin 2) :
    zniWt (N - zniLT k + zniRM k t) < zniWt N := by
  rw [zniWt_add, zniWt_sub hk]
  have h := zniWt_RM_lt k t
  have h2 := zniWt_mono hk
  omega

/-- The normal form, defined on monomials. -/
noncomputable def zniSM (a b h : K) : (Fin 4 →₀ ℕ) → MvPolynomial (Fin 4) K :=
  WellFounded.fix (r := fun a b => zniWt a < zniWt b) inferInstance fun N rec =>
    if _h0 : zniLT 0 ≤ N then
      -((C ((zniLC a b h 0)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 0 0) * rec (N - zniLT 0 + zniRM 0 0) (zniWt_step _h0 0)
          + C (zniRC a b h 0 1) * rec (N - zniLT 0 + zniRM 0 1) (zniWt_step _h0 1)))
    else if _h1 : zniLT 1 ≤ N then
      -((C ((zniLC a b h 1)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 1 0) * rec (N - zniLT 1 + zniRM 1 0) (zniWt_step _h1 0)
          + C (zniRC a b h 1 1) * rec (N - zniLT 1 + zniRM 1 1) (zniWt_step _h1 1)))
    else if _h2 : zniLT 2 ≤ N then
      -((C ((zniLC a b h 2)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 2 0) * rec (N - zniLT 2 + zniRM 2 0) (zniWt_step _h2 0)
          + C (zniRC a b h 2 1) * rec (N - zniLT 2 + zniRM 2 1) (zniWt_step _h2 1)))
    else if _h3 : zniLT 3 ≤ N then
      -((C ((zniLC a b h 3)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 3 0) * rec (N - zniLT 3 + zniRM 3 0) (zniWt_step _h3 0)
          + C (zniRC a b h 3 1) * rec (N - zniLT 3 + zniRM 3 1) (zniWt_step _h3 1)))
    else if _h4 : zniLT 4 ≤ N then
      -((C ((zniLC a b h 4)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 4 0) * rec (N - zniLT 4 + zniRM 4 0) (zniWt_step _h4 0)
          + C (zniRC a b h 4 1) * rec (N - zniLT 4 + zniRM 4 1) (zniWt_step _h4 1)))
    else monomial N 1

lemma zniSM_eq (a b h : K) (N : Fin 4 →₀ ℕ) :
    zniSM a b h N =
      (if _h0 : zniLT 0 ≤ N then
        -((C ((zniLC a b h 0)⁻¹) : MvPolynomial (Fin 4) K)
          * (C (zniRC a b h 0 0) * zniSM a b h (N - zniLT 0 + zniRM 0 0)
            + C (zniRC a b h 0 1) * zniSM a b h (N - zniLT 0 + zniRM 0 1)))
      else if _h1 : zniLT 1 ≤ N then
        -((C ((zniLC a b h 1)⁻¹) : MvPolynomial (Fin 4) K)
          * (C (zniRC a b h 1 0) * zniSM a b h (N - zniLT 1 + zniRM 1 0)
            + C (zniRC a b h 1 1) * zniSM a b h (N - zniLT 1 + zniRM 1 1)))
      else if _h2 : zniLT 2 ≤ N then
        -((C ((zniLC a b h 2)⁻¹) : MvPolynomial (Fin 4) K)
          * (C (zniRC a b h 2 0) * zniSM a b h (N - zniLT 2 + zniRM 2 0)
            + C (zniRC a b h 2 1) * zniSM a b h (N - zniLT 2 + zniRM 2 1)))
      else if _h3 : zniLT 3 ≤ N then
        -((C ((zniLC a b h 3)⁻¹) : MvPolynomial (Fin 4) K)
          * (C (zniRC a b h 3 0) * zniSM a b h (N - zniLT 3 + zniRM 3 0)
            + C (zniRC a b h 3 1) * zniSM a b h (N - zniLT 3 + zniRM 3 1)))
      else if _h4 : zniLT 4 ≤ N then
        -((C ((zniLC a b h 4)⁻¹) : MvPolynomial (Fin 4) K)
          * (C (zniRC a b h 4 0) * zniSM a b h (N - zniLT 4 + zniRM 4 0)
            + C (zniRC a b h 4 1) * zniSM a b h (N - zniLT 4 + zniRM 4 1)))
      else monomial N 1) := by
  unfold zniSM
  rw [WellFounded.fix_eq]

/-- The `K`-linear normal form. -/
noncomputable def zniS (a b h : K) : MvPolynomial (Fin 4) K →ₗ[K] MvPolynomial (Fin 4) K :=
  (MvPolynomial.basisMonomials (Fin 4) K).constr K (zniSM a b h)

lemma zniS_monomial (a b h : K) (N : Fin 4 →₀ ℕ) :
    zniS a b h (monomial N 1) = zniSM a b h N := by
  have h1 := Module.Basis.constr_basis (MvPolynomial.basisMonomials (Fin 4) K) K
    (zniSM a b h) N
  rw [MvPolynomial.coe_basisMonomials] at h1
  simpa [zniS] using h1

lemma zniS_C_mul (a b h : K) (c : K) (p : MvPolynomial (Fin 4) K) :
    zniS a b h (C c * p) = C c * zniS a b h p := by
  rw [MvPolynomial.C_mul', map_smul, MvPolynomial.smul_eq_C_mul]

lemma zniS_g_decomp (a b h : K) (A : Fin 4 →₀ ℕ) (k : Fin 5) :
    zniS a b h (monomial A (1 : K) * zpgQ a b h k)
      = C (zniLC a b h k) * zniSM a b h (A + zniLT k)
        + C (zniRC a b h k 0) * zniSM a b h (A + zniRM k 0)
        + C (zniRC a b h k 1) * zniSM a b h (A + zniRM k 1) := by
  rw [zpgQ_mono_decomp, map_add, map_add, zniS_C_mul, zniS_C_mul, zniS_C_mul,
    zniS_monomial, zniS_monomial, zniS_monomial]

/-! ## 5. Branch lemmas -/

lemma zniSM_b0 (a b h : K) (N : Fin 4 →₀ ℕ) (h0 : zniLT 0 ≤ N) :
    zniSM a b h N
      = -((C ((zniLC a b h 0)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 0 0) * zniSM a b h (N - zniLT 0 + zniRM 0 0)
          + C (zniRC a b h 0 1) * zniSM a b h (N - zniLT 0 + zniRM 0 1))) := by
  rw [zniSM_eq, dif_pos h0]

lemma zniSM_b1 (a b h : K) (N : Fin 4 →₀ ℕ) (h0 : ¬ zniLT 0 ≤ N) (h1 : zniLT 1 ≤ N) :
    zniSM a b h N
      = -((C ((zniLC a b h 1)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 1 0) * zniSM a b h (N - zniLT 1 + zniRM 1 0)
          + C (zniRC a b h 1 1) * zniSM a b h (N - zniLT 1 + zniRM 1 1))) := by
  rw [zniSM_eq, dif_neg h0, dif_pos h1]

lemma zniSM_b2 (a b h : K) (N : Fin 4 →₀ ℕ) (h0 : ¬ zniLT 0 ≤ N) (h1 : ¬ zniLT 1 ≤ N)
    (h2 : zniLT 2 ≤ N) :
    zniSM a b h N
      = -((C ((zniLC a b h 2)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 2 0) * zniSM a b h (N - zniLT 2 + zniRM 2 0)
          + C (zniRC a b h 2 1) * zniSM a b h (N - zniLT 2 + zniRM 2 1))) := by
  rw [zniSM_eq, dif_neg h0, dif_neg h1, dif_pos h2]

lemma zniSM_b3 (a b h : K) (N : Fin 4 →₀ ℕ) (h0 : ¬ zniLT 0 ≤ N) (h1 : ¬ zniLT 1 ≤ N)
    (h2 : ¬ zniLT 2 ≤ N) (h3 : zniLT 3 ≤ N) :
    zniSM a b h N
      = -((C ((zniLC a b h 3)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 3 0) * zniSM a b h (N - zniLT 3 + zniRM 3 0)
          + C (zniRC a b h 3 1) * zniSM a b h (N - zniLT 3 + zniRM 3 1))) := by
  rw [zniSM_eq, dif_neg h0, dif_neg h1, dif_neg h2, dif_pos h3]

lemma zniSM_b4 (a b h : K) (N : Fin 4 →₀ ℕ) (h0 : ¬ zniLT 0 ≤ N) (h1 : ¬ zniLT 1 ≤ N)
    (h2 : ¬ zniLT 2 ≤ N) (h3 : ¬ zniLT 3 ≤ N) (h4 : zniLT 4 ≤ N) :
    zniSM a b h N
      = -((C ((zniLC a b h 4)⁻¹) : MvPolynomial (Fin 4) K)
        * (C (zniRC a b h 4 0) * zniSM a b h (N - zniLT 4 + zniRM 4 0)
          + C (zniRC a b h 4 1) * zniSM a b h (N - zniLT 4 + zniRM 4 1))) := by
  rw [zniSM_eq, dif_neg h0, dif_neg h1, dif_neg h2, dif_neg h3, dif_pos h4]

lemma zniSM_bnone (a b h : K) (N : Fin 4 →₀ ℕ) (h0 : ¬ zniLT 0 ≤ N) (h1 : ¬ zniLT 1 ≤ N)
    (h2 : ¬ zniLT 2 ≤ N) (h3 : ¬ zniLT 3 ≤ N) (h4 : ¬ zniLT 4 ≤ N) :
    zniSM a b h N = monomial N 1 := by
  rw [zniSM_eq, dif_neg h0, dif_neg h1, dif_neg h2, dif_neg h3, dif_neg h4]

/-! ## 6. The lcm, the shifts and the general arithmetic -/

/-- The lcm of two leading monomials. -/
def zniLcm (i j : Fin 5) : Fin 4 →₀ ℕ := zniLT i ⊔ zniLT j

/-- The monomial `lcm / LT i`. -/
def zniSi (i j : Fin 5) : Fin 4 →₀ ℕ := zniLcm i j - zniLT i

/-- The monomial `lcm / LT j`. -/
def zniSj (i j : Fin 5) : Fin 4 →₀ ℕ := zniLcm i j - zniLT j

lemma zniSi_le (i j : Fin 5) : zniLT i ≤ zniLcm i j := le_sup_left

lemma zniLcm_le_iff (i j : Fin 5) {M : Fin 4 →₀ ℕ} (h : zniLT i ≤ M + zniLT j) :
    zniLcm i j ≤ M + zniLT j := by
  rw [zniLcm]
  exact sup_le h le_add_self

lemma zniSj_le (i j : Fin 5) {M : Fin 4 →₀ ℕ} (h : zniLT i ≤ M + zniLT j) :
    zniSj i j ≤ M := by
  rw [zniSj, tsub_le_iff_left]
  rw [add_comm]
  exact zniLcm_le_iff i j h

lemma zni_le_add (A N : Fin 4 →₀ ℕ) : A ≤ N + A := by
  rw [Finsupp.le_iff]
  intro u _
  rw [Finsupp.add_apply]
  exact Nat.le_add_left _ _

lemma zni_pt_le {p q : Fin 4 →₀ ℕ} (h : p ≤ q) (u : Fin 4) : p u ≤ q u := by
  by_cases hu : u ∈ p.support
  · exact (Finsupp.le_iff p q).mp h u hu
  · rw [Finsupp.notMem_support_iff.mp hu]; exact zero_le

lemma zni_add_sub_add_sub (x y z : Fin 4 →₀ ℕ) (h1 : z ≤ y) (h2 : y ≤ x) :
    (x - y) + (y - z) = x - z := by
  ext u
  simp only [Finsupp.add_apply, Finsupp.coe_tsub, Pi.sub_apply]
  have h1u : z u ≤ y u := zni_pt_le h1 u
  have h2u : y u ≤ x u := zni_pt_le h2 u
  omega

/-- `(A + N) - N = A`: the right-cancellation companion of `zni_add_sub_self`. -/
lemma zni_add_sub_self_right (A N : Fin 4 →₀ ℕ) : A + N - N = A := by
  ext u
  simp only [Finsupp.add_apply, Finsupp.coe_tsub, Pi.sub_apply]
  exact Nat.add_sub_cancel _ _

lemma zni_add_sub_self (x z : Fin 4 →₀ ℕ) (h : z ≤ x) : (x - z) + z = x :=
  tsub_add_cancel_of_le h

/-! ## 7. Confluence step -/

lemma zniStepGen (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (i j : Fin 5) (hij : i < j) (M : Fin 4 →₀ ℕ)
    (hM : zniLT i ≤ M + zniLT j) (lam : K) (hlam : lam ≠ 0)
    {P : MvPolynomial (Fin 4) K}
    (hcert : (C lam : MvPolynomial (Fin 4) K) *
      ((C (zniLC a b h j) : MvPolynomial (Fin 4) K)
          * (monomial (M - zniSj i j + zniSi i j) (1 : K) * zpgQ a b h i)
        - (C (zniLC a b h i) : MvPolynomial (Fin 4) K)
          * (monomial (M - zniSj i j + zniSj i j) (1 : K) * zpgQ a b h j)) = P)
    (hP : zniS a b h P = 0)
    (hcanon : zniS a b h (monomial ((M + zniLT j) - zniLT i) (1 : K) * zpgQ a b h i) = 0) :
    zniS a b h (monomial M (1 : K) * zpgQ a b h j) = 0 := by
  have hle : zniLT i ≤ zniLcm i j := zniSi_le i j
  have h2 : zniSj i j ≤ M := zniSj_le i j hM
  have h4 : zniLcm i j ≤ M + zniLT j := zniLcm_le_iff i j hM
  have e1 : M - zniSj i j + zniSj i j = M := zni_add_sub_self M (zniSj i j) h2
  have e2 : M - zniSj i j + zniSi i j = (M + zniLT j) - zniLT i := by
    rw [zniSi, zniSj]
    have h5 : M - (zniLcm i j - zniLT j) = M + zniLT j - zniLcm i j := by
      ext u
      simp only [Finsupp.add_apply, Finsupp.coe_tsub, Pi.sub_apply]
      have h4u : (zniLcm i j) u ≤ M u + (zniLT j) u := by
        have h := zni_pt_le h4 u
        rwa [Finsupp.add_apply] at h
      have h5u : (zniLT j) u ≤ (zniLcm i j) u := zni_pt_le le_sup_right u
      omega
    rw [h5, zni_add_sub_add_sub (M + zniLT j) (zniLcm i j) (zniLT i) hle h4]
  have hmain : (C lam : MvPolynomial (Fin 4) K) *
      ((C (zniLC a b h j) : MvPolynomial (Fin 4) K) * zniS a b h (monomial ((M + zniLT j) - zniLT i) (1 : K) * zpgQ a b h i)
        - (C (zniLC a b h i) : MvPolynomial (Fin 4) K) * zniS a b h (monomial M (1 : K) * zpgQ a b h j)) = 0 := by
    have hc : (C lam : MvPolynomial (Fin 4) K) *
        ((C (zniLC a b h j) : MvPolynomial (Fin 4) K) * (monomial (M - zniSj i j + zniSi i j) (1 : K) * zpgQ a b h i)
          - (C (zniLC a b h i) : MvPolynomial (Fin 4) K) * (monomial (M - zniSj i j + zniSj i j) (1 : K) * zpgQ a b h j)) = P := hcert
    rw [e2, e1] at hc
    have h4' := congrArg (zniS a b h) hc
    rw [hP] at h4'
    simpa only [map_sub, zniS_C_mul] using h4'
  rw [hcanon, mul_zero, zero_sub] at hmain
  rcases mul_eq_zero.mp hmain with h6 | h6
  · exact absurd (MvPolynomial.C_eq_zero.mp h6) hlam
  · have h7 : (C (zniLC a b h i) : MvPolynomial (Fin 4) K) *
        zniS a b h (monomial M (1 : K) * zpgQ a b h j) = 0 := neg_eq_zero.mp h6
    rcases mul_eq_zero.mp h7 with h8 | h8
    · exact absurd (MvPolynomial.C_eq_zero.mp h8) (zniLC_ne_zero a b h ha hb hh i)
    · exact h8

