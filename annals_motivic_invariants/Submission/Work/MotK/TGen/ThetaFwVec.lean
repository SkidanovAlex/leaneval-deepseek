namespace Work.MotK.TGen

open MvPolynomial

/-!
# `Work.MotK.TGen.ThetaFwVec` — the base point coordinates are recovered from `f̂₄ = fwVec 4`

The ruling presentation `θ = theta a b h : K[x₀,x₁,x₂] →ₐ[K] R[T]` (`R = ZRing a b h`, the
coordinate ring of the residual curve `Z = V(ZI a b h)`) is the pullback of the ruling of the
surface `{sT = 0}`: a point of the surface is determined by its base point `c' = (0,x₀,x₁,x₂,1)`
on `Z` and the ruling parameter `T`.  The statement proved here is the *recovery of the base
point*: with `f̂ = kleinTwP ∘ kleinTwStereo` the forward chart map of the link, the quotient
`f̂_{i+1}/f̂₄` is the `i`-th affine coordinate `xᵢ` on `Z`.

## The proof

Write `z = T·rv + rw` for the general point of the ruling line (`rv`, `rw` the two ruling
vectors) and `p = pRa a b h` for the projection centre.  Since

* `θ ∘ chart3 = π_p z` (definitional, from `RVS`, `RWS`),
* `z` lies on the twisted quadric `q`,

the inverse-stereographic identity `KleinTwStereo_pi` together with the homogeneity of `kleinTwP`
gives, with `B = kleinTwBilin p z` and `Pz = kleinTwP z`,

  `θ (f̂_j) = B² · (Pz)_j`   for every `j`   (`tfv_fwVec`),

i.e. the ruling point maps to the base point.  The remaining statement `(Pz)₄·xᵢ = (Pz)_{i+1}`
is the affine form of `Pz ∝ c'`; the explicit certificates

  `(Pz)₄·x₀ - (Pz)₁ = (h·a/b)·(a·x₁·T + b·x₂)·(T·Pt1 + Pt2)`,
  `(Pz)₄·x₁ - (Pz)₂ = (-(b·h))·(T·Pt1 + Pt2)`,
  `(Pz)₄·x₂ - (Pz)₃ = T·(h·a)·(T·Pt1 + Pt2)`

(`tfv_Pz_sub`) reduce everything to `Pt1 = Pt2 = 0`, which holds on the base curve (`ZI` is
generated by `Zcub 3 = -(a b²)·Pt2` and `Zcub 4 = (a b²)·Pt1`, `tfv_Zcub_three`, `tfv_Zcub_four`).

All the polynomial identities above are proved in the fraction field of the polynomial ring
(a domain), where the divisions by `a`, `b`, `h` are legitimate: `field_simp; ring`.  The only
glue is the injectivity of the localisation, `IsFractionRing.injective`.
-/

variable {K : Type} [Field K]

/-! ## The fraction field of the polynomial ring and the auxiliaries used in it -/

/-- The image of a constant of `K` inside the fraction field of `Polynomial (K[x₀,x₁,x₂])`. -/
theorem tfv_algMapCC (k : K) :
    algebraMap (Polynomial (MvPolynomial (Fin 3) K))
        (FractionRing (Polynomial (MvPolynomial (Fin 3) K))) (Polynomial.C (MvPolynomial.C k))
      = algebraMap K (FractionRing (Polynomial (MvPolynomial (Fin 3) K))) k := by
  rw [IsScalarTower.algebraMap_apply K (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K))), Polynomial.algebraMap_apply,
    MvPolynomial.algebraMap_eq]

/-- The image of a constant of `K` inside the fraction field of `K[x₀,x₁,x₂]`. -/
theorem tfv_algMap_C (k : K) :
    algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K))
        (MvPolynomial.C k)
      = algebraMap K (FractionRing (MvPolynomial (Fin 3) K)) k := by
  rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin 3) K)
      (FractionRing (MvPolynomial (Fin 3) K)), MvPolynomial.algebraMap_eq]

/-- `K → FractionRing (Polynomial K[x])` is injective (it is a map of fields). -/
theorem tfv_algMapK_injective :
    Function.Injective (algebraMap K (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))) := by
  intro x y h
  have h1 : algebraMap (Polynomial (MvPolynomial (Fin 3) K))
      (FractionRing (Polynomial (MvPolynomial (Fin 3) K))) (Polynomial.C (MvPolynomial.C x))
      = algebraMap (Polynomial (MvPolynomial (Fin 3) K))
        (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
          (Polynomial.C (MvPolynomial.C y)) := by
    rw [tfv_algMapCC, tfv_algMapCC, h]
  have h2 := IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K))) h1
  simpa using congrArg (fun p : Polynomial (MvPolynomial (Fin 3) K) => p.coeff 0) h2

/-- A nonzero constant of `K` stays nonzero in the fraction field of `Polynomial K[x]`. -/
theorem tfv_algMapK_ne_zero (k : K) (hk : k ≠ 0) :
    algebraMap K (FractionRing (Polynomial (MvPolynomial (Fin 3) K))) k ≠ 0 :=
  fun h => hk (tfv_algMapK_injective (by rw [h, map_zero]))

/-- A nonzero constant of `K` stays nonzero in the fraction field of `K[x]`. -/
theorem tfv_algMapK'_ne_zero (k : K) (hk : k ≠ 0) :
    algebraMap K (FractionRing (MvPolynomial (Fin 3) K)) k ≠ 0 := by
  intro h
  have h1 : algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K))
      (MvPolynomial.C k) = 0 := by rw [tfv_algMap_C, h]
  have h2 : MvPolynomial.C k = 0 := IsFractionRing.injective (MvPolynomial (Fin 3) K)
    (FractionRing (MvPolynomial (Fin 3) K)) (by rw [h1, map_zero])
  exact hk (by simpa using h2)

/-! ## The ruling point `z = T·rv + rw` and its quadro image -/

/-- The general point `T·rv + rw` of the ruling line, as a vector of polynomials. -/
noncomputable def tfvZ (a b h : K) : Fin 5 → Polynomial (MvPolynomial (Fin 3) K) :=
  fun i => Polynomial.C (Work.MotK.TwCensus.rv a b h i) * Polynomial.X
    + Polynomial.C (Work.MotK.TwCensus.rw a b h i)

/-- The quadro image `Pz = kleinTwP (T·rv + rw)`, i.e. the ruling point pushed to the base chart. -/
noncomputable def tfvP (a b h : K) (j : Fin 5) : Polynomial (MvPolynomial (Fin 3) K) :=
  Work.MotK.kleinTwP (Polynomial.C (MvPolynomial.C a)) (Polynomial.C (MvPolynomial.C b))
    (Polynomial.C (MvPolynomial.C h)) (tfvZ a b h) j

/-- The polar value `B(p, z)` of the ruling point against the projection centre. -/
noncomputable def tfvB (a b h : K) : Polynomial (MvPolynomial (Fin 3) K) :=
  Work.MotK.kleinTwBilin (Polynomial.C (MvPolynomial.C a)) (Polynomial.C (MvPolynomial.C b))
    (Polynomial.C (MvPolynomial.C h)) (fun i => Polynomial.C (pRa a b h i)) (tfvZ a b h)

/-- The ruling equation `T·Pt1 + Pt2`, the generator of the base curve in the ruling chart. -/
noncomputable def tfvW (a b h : K) : Polynomial (MvPolynomial (Fin 3) K) :=
  Polynomial.C (Work.MotK.TwCensus.Pt1 a b h) * Polynomial.X
    + Polynomial.C (Work.MotK.TwCensus.Pt2 a b h)

/-! ## `thPoly` on the chart coordinates -/

/-- `thPoly` on the first coordinate of the chart is the first coordinate of `π_p z`. -/
theorem tfv_thPoly_X_zero (a b h : K) :
    thPoly a b h (MvPolynomial.X (0 : Fin 3))
      = Polynomial.C (RVS a b h 1) * Polynomial.X + Polynomial.C (RWS a b h 1) := by
  simp only [thPoly, MvPolynomial.aeval_X]
  rw [show ch3' (K := K) (0 : Fin 3) = (1 : Fin 5) from rfl]

/-- `thPoly` on the second coordinate of the chart. -/
theorem tfv_thPoly_X_one (a b h : K) :
    thPoly a b h (MvPolynomial.X (1 : Fin 3))
      = Polynomial.C (RVS a b h 2) * Polynomial.X + Polynomial.C (RWS a b h 2) := by
  simp only [thPoly, MvPolynomial.aeval_X]
  rw [show ch3' (K := K) (1 : Fin 3) = (2 : Fin 5) from rfl]

/-- `thPoly` on the third coordinate of the chart. -/
theorem tfv_thPoly_X_two (a b h : K) :
    thPoly a b h (MvPolynomial.X (2 : Fin 3))
      = Polynomial.C (RVS a b h 3) * Polynomial.X + Polynomial.C (RWS a b h 3) := by
  simp only [thPoly, MvPolynomial.aeval_X]
  rw [show ch3' (K := K) (2 : Fin 3) = (3 : Fin 5) from rfl]

/-- `thPoly` on the constants. -/
theorem tfv_thPoly_C (a b h k : K) :
    thPoly a b h (MvPolynomial.C k) = Polynomial.C (MvPolynomial.C k) := by
  simp only [thPoly, MvPolynomial.aeval_C]
  rw [Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]

/-! ## `θ (f̂_j) = B² · (Pz)_j` -/

/-- The ruling point `z` lies on the twisted quadric. -/
theorem tfv_kleinTwQ_zV (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    Work.MotK.kleinTwQ (Polynomial.C (MvPolynomial.C a)) (Polynomial.C (MvPolynomial.C b))
      (Polynomial.C (MvPolynomial.C h)) (tfvZ a b h) = 0 := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [Work.MotK.kleinTwQ, Work.MotK.kleinTwP0, tfvZ, Work.MotK.TwCensus.rv,
    Work.MotK.TwCensus.rw,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- **`θ (f̂_j) = B² · (Pz)_j`**, for `j = 4`. -/
theorem tfv_fwVec_four (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    thPoly a b h (fwVec a b h 4) = tfvB a b h ^ 2 * tfvP a b h 4 := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvB, tfvP, tfvZ, fwVec, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.kleinTwStereo, Work.MotK.kleinTwQ, Work.MotK.kleinTwBilin,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.chart3, pRa,
    Work.MotK.kleinPointT, RVS, RWS,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    tfv_thPoly_X_zero, tfv_thPoly_X_one, tfv_thPoly_X_two, tfv_thPoly_C,
    Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.mul_apply,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- **`θ (f̂_j) = B² · (Pz)_j`**, for `j = 3`. -/
theorem tfv_fwVec_three (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    thPoly a b h (fwVec a b h 3) = tfvB a b h ^ 2 * tfvP a b h 3 := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvB, tfvP, tfvZ, fwVec, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.kleinTwStereo, Work.MotK.kleinTwQ, Work.MotK.kleinTwBilin,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.chart3, pRa,
    Work.MotK.kleinPointT, RVS, RWS,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    tfv_thPoly_X_zero, tfv_thPoly_X_one, tfv_thPoly_X_two, tfv_thPoly_C,
    Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.mul_apply,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- **`θ (f̂_j) = B² · (Pz)_j`**, for `j = 2`. -/
theorem tfv_fwVec_two (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    thPoly a b h (fwVec a b h 2) = tfvB a b h ^ 2 * tfvP a b h 2 := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvB, tfvP, tfvZ, fwVec, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.kleinTwStereo, Work.MotK.kleinTwQ, Work.MotK.kleinTwBilin,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.chart3, pRa,
    Work.MotK.kleinPointT, RVS, RWS,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    tfv_thPoly_X_zero, tfv_thPoly_X_one, tfv_thPoly_X_two, tfv_thPoly_C,
    Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.mul_apply,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- **`θ (f̂_j) = B² · (Pz)_j`**, for `j = 1`. -/
theorem tfv_fwVec_one (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    thPoly a b h (fwVec a b h 1) = tfvB a b h ^ 2 * tfvP a b h 1 := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvB, tfvP, tfvZ, fwVec, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.kleinTwStereo, Work.MotK.kleinTwQ, Work.MotK.kleinTwBilin,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.chart3, pRa,
    Work.MotK.kleinPointT, RVS, RWS,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    tfv_thPoly_X_zero, tfv_thPoly_X_one, tfv_thPoly_X_two, tfv_thPoly_C,
    Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.mul_apply,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- **`θ (f̂_j) = B² · (Pz)_j`**, for `j = 0`: both sides vanish, since `f̂₀ = 0` and `z` lies on
the twisted quadric. -/
theorem tfv_fwVec_zero (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    thPoly a b h (fwVec a b h 0) = tfvB a b h ^ 2 * tfvP a b h 0 := by
  have hQ := tfv_kleinTwQ_zV a b h ha hb hh
  rw [fwVec_zero a b h ha hh, map_zero,
    show tfvP a b h 0 = 0 from by
      simp only [tfvP, Work.MotK.kleinTwP, Work.MotK.kleinTwQ, Matrix.cons_val_zero]
      exact hQ,
    mul_zero]

/-- **`θ (f̂_j) = B² · (Pz)_j`** for every `j`: the ruling point maps to the base point. -/
theorem tfv_fwVec (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) (j : Fin 5) :
    thPoly a b h (fwVec a b h j) = tfvB a b h ^ 2 * tfvP a b h j := by
  fin_cases j
  · exact tfv_fwVec_zero a b h ha hb hh
  · exact tfv_fwVec_one a b h ha hb hh
  · exact tfv_fwVec_two a b h ha hb hh
  · exact tfv_fwVec_three a b h ha hb hh
  · exact tfv_fwVec_four a b h ha hb hh

/-! ## The certificates `(Pz)₄·xᵢ - (Pz)_{i+1} ∈ (T·Pt1 + Pt2)` -/

/-- The certificate for the first chart coordinate. -/
theorem tfv_Pz_sub_zero (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    tfvP a b h 4 * Polynomial.C (MvPolynomial.X 0) - tfvP a b h 1
      = Polynomial.C (MvPolynomial.C (h * a / b))
          * (Polynomial.C (MvPolynomial.C a * MvPolynomial.X 1) * Polynomial.X
              + Polynomial.C (MvPolynomial.C b * MvPolynomial.X 2)) * tfvW a b h := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvP, tfvW, tfvZ, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.TwCensus.Pt1,
    Work.MotK.TwCensus.Pt2,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- The certificate for the second chart coordinate. -/
theorem tfv_Pz_sub_one (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    tfvP a b h 4 * Polynomial.C (MvPolynomial.X 1) - tfvP a b h 2
      = Polynomial.C (MvPolynomial.C (-(b * h))) * tfvW a b h := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvP, tfvW, tfvZ, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.TwCensus.Pt1,
    Work.MotK.TwCensus.Pt2,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- The certificate for the third chart coordinate. -/
theorem tfv_Pz_sub_two (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    tfvP a b h 4 * Polynomial.C (MvPolynomial.X 2) - tfvP a b h 3
      = Polynomial.X * Polynomial.C (MvPolynomial.C (h * a)) * tfvW a b h := by
  have ha' := tfv_algMapK_ne_zero a ha
  have hb' := tfv_algMapK_ne_zero b hb
  have hh' := tfv_algMapK_ne_zero h hh
  apply IsFractionRing.injective (Polynomial (MvPolynomial (Fin 3) K))
    (FractionRing (Polynomial (MvPolynomial (Fin 3) K)))
  simp only [tfvP, tfvW, tfvZ, Work.MotK.kleinTwP, Work.MotK.kleinTwP0,
    Work.MotK.kleinTwP1, Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4,
    Work.MotK.TwCensus.rv, Work.MotK.TwCensus.rw, Work.MotK.TwCensus.Pt1,
    Work.MotK.TwCensus.Pt2,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMapCC, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- **The certificate**: `(Pz)₄·xᵢ - (Pz)_{i+1}` is a multiple of the ruling equation `T·Pt1 + Pt2`
on the base curve, for each of the three affine coordinates. -/
theorem tfv_Pz_sub (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) (i : Fin 3) :
    ∃ c : Polynomial (MvPolynomial (Fin 3) K),
      tfvP a b h 4 * Polynomial.C (MvPolynomial.X i)
          - tfvP a b h (ch3' (K := K) i) = c * tfvW a b h := by
  fin_cases i
  · exact ⟨_, tfv_Pz_sub_zero a b h ha hb hh⟩
  · exact ⟨_, tfv_Pz_sub_one a b h ha hb hh⟩
  · exact ⟨_, tfv_Pz_sub_two a b h ha hb hh⟩

/-! ## The two cubics of the base curve in terms of `Pt1`, `Pt2` -/

/-- `Zcub 4 = a·b²·Pt1`. -/
theorem tfv_Zcub_four (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    Work.MotK.TwCensus.Zcub a b h (4 : Fin 5)
      = MvPolynomial.C (a * b ^ 2) * Work.MotK.TwCensus.Pt1 a b h := by
  have ha' := tfv_algMapK'_ne_zero a ha
  have hb' := tfv_algMapK'_ne_zero b hb
  have hh' := tfv_algMapK'_ne_zero h hh
  apply IsFractionRing.injective (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K))
  simp only [Work.MotK.TwCensus.Zcub, Work.MotK.TwCensus.Pt1, Work.MotK.kleinTwR,
    Work.MotK.kleinTwR0, Work.MotK.kleinTwR1, Work.MotK.kleinTwR2, Work.MotK.kleinTwR3,
    Work.MotK.kleinTwR4, Work.MotK.chart3,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMap_C, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-- `Zcub 3 = -(a·b²)·Pt2`. -/
theorem tfv_Zcub_three (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    Work.MotK.TwCensus.Zcub a b h (3 : Fin 5)
      = -(MvPolynomial.C (a * b ^ 2) * Work.MotK.TwCensus.Pt2 a b h) := by
  have ha' := tfv_algMapK'_ne_zero a ha
  have hb' := tfv_algMapK'_ne_zero b hb
  have hh' := tfv_algMapK'_ne_zero h hh
  apply IsFractionRing.injective (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K))
  simp only [Work.MotK.TwCensus.Zcub, Work.MotK.TwCensus.Pt2, Work.MotK.kleinTwR,
    Work.MotK.kleinTwR0, Work.MotK.kleinTwR1, Work.MotK.kleinTwR2, Work.MotK.kleinTwR3,
    Work.MotK.kleinTwR4, Work.MotK.chart3,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons,
    map_sub, map_mul, map_add, map_pow, map_neg, map_zero, map_one,
    tfv_algMap_C, map_div₀, map_inv₀]
  field_simp [ha', hb', hh']
  refl_ring1

/-! ## The statement -/

/-- `theta a b h p` is the reduction of the ruling parametrisation `thPoly a b h p` modulo the
residual curve. -/
theorem tfv_theta_apply (a b h : K) (p : MvPolynomial (Fin 3) K) :
    theta a b h p
      = Polynomial.map (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h)))
          (thPoly a b h p) := rfl

theorem ThetaFwVec (K : Type) [Field K] (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (i : Fin 3) :
    Work.MotK.TGen.theta a b h (Work.MotK.TGen.fwVec a b h 4)
        * Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
            (MvPolynomial.X i))
      = Work.MotK.TGen.theta a b h
          (Work.MotK.TGen.fwVec a b h (Work.MotK.TGen.ch3' (K := K) i)) := by
  -- `Pt1` and `Pt2` vanish on the residual curve
  have hZcub4 : Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
      (Work.MotK.TwCensus.Zcub a b h 4) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.le_radical (Ideal.subset_span (Set.mem_range_self (4 : Fin 5))))
  have hZcub3 : Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
      (Work.MotK.TwCensus.Zcub a b h 3) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.le_radical (Ideal.subset_span (Set.mem_range_self (3 : Fin 5))))
  have hab2 : a * b ^ 2 ≠ 0 := mul_ne_zero ha (pow_ne_zero 2 hb)
  have hPt1_eq : Work.MotK.TwCensus.Pt1 a b h
      = MvPolynomial.C ((a * b ^ 2)⁻¹) * Work.MotK.TwCensus.Zcub a b h 4 := by
    rw [tfv_Zcub_four a b h ha hb hh, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hab2, map_one,
      one_mul]
  have hPt2_eq : Work.MotK.TwCensus.Pt2 a b h
      = -(MvPolynomial.C ((a * b ^ 2)⁻¹)) * Work.MotK.TwCensus.Zcub a b h 3 := by
    rw [tfv_Zcub_three a b h ha hb hh, neg_mul_neg, ← mul_assoc, ← map_mul,
      inv_mul_cancel₀ hab2, map_one, one_mul]
  have hpt1 : Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
      (Work.MotK.TwCensus.Pt1 a b h) = 0 := by
    rw [hPt1_eq, map_mul, hZcub4, mul_zero]
  have hpt2 : Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
      (Work.MotK.TwCensus.Pt2 a b h) = 0 := by
    rw [hPt2_eq, map_mul, hZcub3, mul_zero]
  -- the ruling equation dies modulo the residual curve
  have hW : Polynomial.map (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h)))
      (tfvW a b h) = 0 := by
    rw [tfvW, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_C,
      Polynomial.map_X, hpt1, hpt2]
    simp
  obtain ⟨c, hc⟩ := tfv_Pz_sub a b h ha hb hh i
  have hR : Polynomial.map (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h)))
      (tfvP a b h 4 * Polynomial.C (MvPolynomial.X i)
        - tfvP a b h (ch3' (K := K) i)) = 0 := by
    rw [hc, Polynomial.map_mul, hW, mul_zero]
  rw [tfv_theta_apply, tfv_theta_apply, tfv_fwVec a b h ha hb hh 4,
    tfv_fwVec a b h ha hb hh (ch3' (K := K) i)]
  rw [← Polynomial.map_C, ← Polynomial.map_mul, ← sub_eq_zero, ← Polynomial.map_sub]
  rw [show tfvB a b h ^ 2 * tfvP a b h 4 * Polynomial.C (MvPolynomial.X i)
        - tfvB a b h ^ 2 * tfvP a b h (ch3' (K := K) i)
      = tfvB a b h ^ 2 * (tfvP a b h 4 * Polynomial.C (MvPolynomial.X i)
          - tfvP a b h (ch3' (K := K) i)) from by ring]
  rw [Polynomial.map_mul, hR, mul_zero]

end Work.MotK.TGen
