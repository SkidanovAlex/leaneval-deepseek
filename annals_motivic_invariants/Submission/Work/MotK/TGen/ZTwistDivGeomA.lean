/-!
# `Work.MotK.TGen.ZTwistDivGeomA`

The first (purely algebraic) geometric leaf of node K6 of the T-twisted Crauder--Katz link
(see `NOTE_ZTwistDivGeomCerts.md`, `NOTE_ZTwistChartFrac.md` and
`Submission/Work/MotK/TGen/ZTwistDiv.lean`).

`ZElim2 a b h` is the eliminant of the *residual* plane model and `zpgE a b h` the eliminant of
the chart `y₀ = 1` of the *twisted Klein curve* in the coordinates `(y₁,y₃)`.  By
`ZTwistDivGeomDefs` (and `zpgE_aeval_eq` of `ZTwistDivGeomCerts`) the two are related by the
invertible *diagonal* substitution `X₀ ↦ (a/b)y₁`, `X₁ ↦ -(a/b)h·y₃`, up to the unit `a³/b⁴`.
Hence the two quotients are isomorphic as `K`-algebras, and so are their fraction rings.

The proof below uses the **division-free** form of the substitution identity

`σ₁(ZElim2 a b h) · b⁴ = a³ · σ₂(zpgE a b h)`,   `σ₁ = diag(a, -ah)`,  `σ₂ = diag(b, b)`,

in which `σ₁` and `σ₂` are the elementary diagonal automorphisms
`X i ↦ C c_i · X i` of `K[X₀,X₁]`; the certificate is a `ring` identity (an equivalent of
`zpgE_aeval_eq` in `ZTwistDivGeomCerts.lean`, reproved here to keep the module self-contained).
Since `σ₁(ZElim2)` and `σ₂(zpgE)` differ by the *unit* `a³/b⁴`, they generate the same ideal, so
`Ideal.map σ₁ (span {ZElim2}) = Ideal.map σ₂ (span {zpgE})`, and the two quotient rings are
linked by `Ideal.quotientEquivAlg` (for `σ₁`, `σ₂`) and `Ideal.quotientEquivAlgOfEq` (for the
ideal equality).  The fraction-ring statement is then `IsFractionRing.algEquivOfAlgEquiv`.
-/

set_option maxHeartbeats 1000000
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open MvPolynomial

namespace Work.MotK.TGen

/-- The **diagonal `K`-algebra automorphism** `X 0 ↦ C c₀ * X 0`, `X 1 ↦ C c₁ * X 1` of
`K[X₀,X₁]`, for `c₀, c₁ ≠ 0` (with inverse `X i ↦ C cᵢ⁻¹ * X i`). -/
private noncomputable def zDiagEquiv (K : Type) [Field K] (c0 c1 : K)
    (h0 : c0 ≠ 0) (h1 : c1 ≠ 0) : MvPolynomial (Fin 2) K ≃ₐ[K] MvPolynomial (Fin 2) K :=
  AlgEquiv.ofAlgHom
    (MvPolynomial.aeval ![MvPolynomial.C c0 * MvPolynomial.X 0, MvPolynomial.C c1 * MvPolynomial.X 1])
    (MvPolynomial.aeval ![MvPolynomial.C c0⁻¹ * MvPolynomial.X 0, MvPolynomial.C c1⁻¹ * MvPolynomial.X 1])
    (by
      rw [MvPolynomial.comp_aeval]
      have h : (fun i : Fin 2 => MvPolynomial.aeval ![MvPolynomial.C c0 * MvPolynomial.X 0,
            MvPolynomial.C c1 * MvPolynomial.X 1]
            (![MvPolynomial.C c0⁻¹ * MvPolynomial.X 0,
                MvPolynomial.C c1⁻¹ * MvPolynomial.X 1] i)) = fun i => MvPolynomial.X i := by
        funext i
        fin_cases i
        · simp
          rw [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ h0, MvPolynomial.C_1, one_mul]
        · simp
          rw [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ h1, MvPolynomial.C_1, one_mul]
      rw [h]
      apply MvPolynomial.algHom_ext
      intro i
      simp)
    (by
      rw [MvPolynomial.comp_aeval]
      have h : (fun i : Fin 2 => MvPolynomial.aeval ![MvPolynomial.C c0⁻¹ * MvPolynomial.X 0,
            MvPolynomial.C c1⁻¹ * MvPolynomial.X 1]
            (![MvPolynomial.C c0 * MvPolynomial.X 0,
                MvPolynomial.C c1 * MvPolynomial.X 1] i)) = fun i => MvPolynomial.X i := by
        funext i
        fin_cases i
        · simp
          rw [← mul_assoc, ← MvPolynomial.C_mul, mul_inv_cancel₀ h0, MvPolynomial.C_1, one_mul]
        · simp
          rw [← mul_assoc, ← MvPolynomial.C_mul, mul_inv_cancel₀ h1, MvPolynomial.C_1, one_mul]
      rw [h]
      apply MvPolynomial.algHom_ext
      intro i
      simp)

/-- The substitution `X 0 ↦ C a * X 0`, `X 1 ↦ C (-(a*h)) * X 1` occurring in the certificate. -/
private noncomputable def zSigA (K : Type) [Field K] (a b h : K) (ha : a ≠ 0) (hh : h ≠ 0) :
    MvPolynomial (Fin 2) K ≃ₐ[K] MvPolynomial (Fin 2) K :=
  zDiagEquiv K a (-(a*h)) ha (neg_ne_zero.mpr (mul_ne_zero ha hh))

/-- The substitution `X i ↦ C b * X i` occurring in the certificate. -/
private noncomputable def zSigB (K : Type) [Field K] (b : K) (hb : b ≠ 0) :
    MvPolynomial (Fin 2) K ≃ₐ[K] MvPolynomial (Fin 2) K :=
  zDiagEquiv K b b hb hb

/-- For a unit `u` with inverse `v` (`u * v = 1`), the principal ideals generated by `x * u` and
by `x` agree. -/
private lemma span_singleton_mul_eq_of_mul_eq_one {R : Type*} [CommRing R] {u v x : R}
    (h : u * v = 1) : Ideal.span {x * u} = Ideal.span {x} := by
  apply le_antisymm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mul_mem_right u _ (Ideal.subset_span (Set.mem_singleton x))
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have hmem : (x * u) * v ∈ Ideal.span {x * u} :=
      Ideal.mul_mem_right v _ (Ideal.subset_span (Set.mem_singleton (x * u)))
    have hx : (x * u) * v = x := by rw [mul_assoc, h, mul_one]
    rwa [hx] at hmem

/-- If `x * u = w * y` with `u` and `w` units, then `x` and `y` generate the same principal
ideal. -/
private lemma span_singleton_eq_of_unit_mul {R : Type*} [CommRing R] {x y u w : R}
    (hu : IsUnit u) (hw : IsUnit w) (h : x * u = w * y) : Ideal.span {x} = Ideal.span {y} := by
  obtain ⟨u', rfl⟩ := hu
  obtain ⟨w', rfl⟩ := hw
  calc Ideal.span {x}
      = Ideal.span {x * (↑u' : R)} :=
        (span_singleton_mul_eq_of_mul_eq_one (u := (↑u' : R)) (v := ↑u'⁻¹) (x := x)
          (by rw [Units.mul_inv])).symm
    _ = Ideal.span {(↑w' : R) * y} := by rw [h]
    _ = Ideal.span {y} := by
        rw [mul_comm]
        exact span_singleton_mul_eq_of_mul_eq_one (u := (↑w' : R)) (v := ↑w'⁻¹) (x := y)
          (by rw [Units.mul_inv])

/-- **The division-free substitution certificate.**
`σ_a(ZElim2 a b h) · b⁴ = a³ · σ_b(zpgE a b h)` where `σ_a = diag(a, -ah)` and
`σ_b = diag(b, b)`.  (An equivalent of `zpgE_aeval_eq` of `ZTwistDivGeomCerts.lean`.) -/
private lemma zCert (K : Type) [Field K] (a b h : K)
    (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    (zSigA K a b h ha hh : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
        (Work.MotK.TwCensus.ZElim2 a b h) * MvPolynomial.C (b^4)
      = MvPolynomial.C (a^3) * (zSigB K b hb : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
        (Work.MotK.TGen.zpgE a b h) := by
  rw [show (zSigA K a b h ha hh : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
      = MvPolynomial.aeval ![MvPolynomial.C a * MvPolynomial.X 0,
          MvPolynomial.C (-(a*h)) * MvPolynomial.X 1] from rfl,
    show (zSigB K b hb : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
      = MvPolynomial.aeval ![MvPolynomial.C b * MvPolynomial.X 0,
          MvPolynomial.C b * MvPolynomial.X 1] from rfl]
  rw [Work.MotK.TwCensus.ZElim2, Work.MotK.TGen.zpgE]
  simp only [map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat,
    MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
    Matrix.cons_val_zero, Matrix.cons_val_one]
  first | refl_ring1 | ring

/-- The two substitutions send the two eliminants to generators of the same ideal. -/
private lemma zIdealMap (K : Type) [Field K] (a b h : K)
    (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    Ideal.map (zSigA K a b h ha hh : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
        (Ideal.span {Work.MotK.TwCensus.ZElim2 a b h})
      = Ideal.map (zSigB K b hb : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
        (Ideal.span {Work.MotK.TGen.zpgE a b h}) := by
  have hu : IsUnit (MvPolynomial.C (b^4) : MvPolynomial (Fin 2) K) :=
    ⟨Units.mk _ _ (by rw [← MvPolynomial.C_mul, mul_inv_cancel₀ (pow_ne_zero 4 hb), MvPolynomial.C_1])
      (by rw [← MvPolynomial.C_mul, inv_mul_cancel₀ (pow_ne_zero 4 hb), MvPolynomial.C_1]), rfl⟩
  have hw : IsUnit (MvPolynomial.C (a^3) : MvPolynomial (Fin 2) K) :=
    ⟨Units.mk _ _ (by rw [← MvPolynomial.C_mul, mul_inv_cancel₀ (pow_ne_zero 3 ha), MvPolynomial.C_1])
      (by rw [← MvPolynomial.C_mul, inv_mul_cancel₀ (pow_ne_zero 3 ha), MvPolynomial.C_1]), rfl⟩
  rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton]
  exact span_singleton_eq_of_unit_mul hu hw (zCert K a b h ha hb hh)

/-- The quotient rings by the two eliminants are isomorphic as `K`-algebras. -/
private noncomputable def zQuotEquiv (K : Type) [Field K] (a b h : K)
    (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    (MvPolynomial (Fin 2) K ⧸ Ideal.span {Work.MotK.TwCensus.ZElim2 a b h}) ≃ₐ[K]
      (MvPolynomial (Fin 2) K ⧸ Ideal.span {Work.MotK.TGen.zpgE a b h}) :=
  (Ideal.quotientEquivAlg (Ideal.span {Work.MotK.TwCensus.ZElim2 a b h})
      (Ideal.map (zSigA K a b h ha hh : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
        (Ideal.span {Work.MotK.TwCensus.ZElim2 a b h})) (zSigA K a b h ha hh) rfl).trans
    ((Ideal.quotientEquivAlgOfEq K (zIdealMap K a b h ha hb hh)).trans
      (Ideal.quotientEquivAlg (Ideal.span {Work.MotK.TGen.zpgE a b h})
        (Ideal.map (zSigB K b hb : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 2) K)
          (Ideal.span {Work.MotK.TGen.zpgE a b h})) (zSigB K b hb) rfl).symm)

theorem ZTwistDivGeomA (K : Type) [Field K] (a b h : K)
    (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    Nonempty (FractionRing (MvPolynomial (Fin 2) K ⧸
        Ideal.span {Work.MotK.TwCensus.ZElim2 a b h}) ≃ₐ[K]
      FractionRing (MvPolynomial (Fin 2) K ⧸
        Ideal.span {Work.MotK.TGen.zpgE a b h})) :=
  ⟨IsFractionRing.algEquivOfAlgEquiv (zQuotEquiv K a b h ha hb hh)⟩

end Work.MotK.TGen
