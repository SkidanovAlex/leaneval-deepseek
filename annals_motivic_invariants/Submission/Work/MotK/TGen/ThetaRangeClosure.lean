import Mathlib
import Submission.Work.MotK.TGen.STRulingTheta
import Submission.Work.MotK.TGen.ThetaS
import Submission.Work.MotK.TGen.ThetaFwVec

set_option linter.unusedVariables false -- v435-speed

set_option synthInstance.maxHeartbeats 400000 -- v435-synth

namespace Work.MotK.TGen

set_option maxHeartbeats 4000000
set_option linter.style.haveILetI false

/-- **The ruling presentation generates the whole function field.**  With `A = ZRing a b h` a
domain, `theta a b h : K[x₀,x₁,x₂] →ₐ[K] A[T]` the ruling parametrisation of the surface
`{sT = 0}`, the fraction field of `theta.range` is the fraction field of `A[T]`.

This is the "presentation half" of the input used by `Work.MotK.TGen.STRulingDiv`: the ruled
surface over the residual curve `Z` has function field `κ(Z)(t)`.

## Route (both required ingredients are PROVED in the workspace)

* `Work.MotK.TGen.ThetaS` (PROVED): `Polynomial.X * theta a b h (Sklein a b h 4)
  = theta a b h (Sklein a b h 3)` in `A[T]`; with `hS4` this gives
  `Polynomial.X = theta (Sklein 3) / theta (Sklein 4)` in `L = FractionRing (A[T])`;
* `Work.MotK.TGen.ThetaFwVec` (PROVED): `theta a b h (fwVec a b h 4) * C (mk (X i))
  = theta a b h (fwVec a b h (ch3' i))` for `i : Fin 3`; with `hF4` this gives
  `algebraMap A L (mk (X i)) = theta (fwVec (ch3' i)) / theta (fwVec 4)` in `L`.

Hence every element of the image of `algebraMap (Polynomial A) L` lies in the subfield
`Subfield.closure (Set.range (algebraMap (theta.range) L))`, because `Polynomial A` is generated as
a `K`-algebra by `Polynomial.X` and the `C (mk (X i))` (and `A` is generated by the `mk (X i)`),
and every element of `L` is a quotient of two elements of the image of `Polynomial A`.
So `IsFractionRing (theta.range) L` and hence the isomorphism.

Two possible formalisation routes:

(a) Define `thetaRangeL := (theta a b h).range.map (IsScalarTower.toAlgHom K
    (Polynomial (ZRing a b h)) (FractionRing (Polynomial (ZRing a b h)))) : Subalgebra K L` and
    prove `Subfield.closure (Set.range (algebraMap thetaRangeL L)) = ⊤`; the template is the trio
    of `private` lemmas of `Submission/Work/MotK/TGen/CubTFracRange.lean`
    (`isFractionRing_of_subfield_closure_range'`, `fractionRing_algEquiv_of_closure_eq_top'`), which
    you may copy into your own file, together with `IsFractionRing.algEquivOfAlgEquiv` to transport
    along `theta.range ≅ thetaRangeL`.
(b) Or build the `K`-algebra hom `Polynomial (ZRing a b h) →ₐ[K] L` directly and use
    `IsFractionRing.of_field` / `IsLocalization`.

(A subtlety: `algebraMap (theta a b h).range L` does not elaborate — there is no instance
`Algebra ↥(theta.range) L` for the *subalgebra* `theta.range` of `Polynomial A` and the extension
`L`; hence route (a) goes through the image subalgebra `thetaRangeL` of `L`, or through explicit
composites `fun x : (theta a b h).range => algebraMap (Polynomial (ZRing a b h)) L x`.)-/
theorem ThetaRangeClosure (K : Type) [Field K] (a b h : K) [IsDomain (ZRing a b h)]
    (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (hS4 : theta a b h (Sklein a b h 4) ≠ 0)
    (hF4 : theta a b h (fwVec a b h 4) ≠ 0) :
    Nonempty (FractionRing (theta a b h).range ≃ₐ[K]
      FractionRing (Polynomial (ZRing a b h))) := by
  -- The instance search on `Polynomial (ZRing a b h)` is derailed by the diamond
  -- `Ideal.Quotient.commSemiring.toSemiring` vs `Ideal.Quotient.semiring` on the quotient ring;
  -- pinning the `Semiring` instance of `ZRing a b h` to the `CommSemiring`-derived one (and the
  -- `Semiring` of the subalgebra to its `CommSemiring`-derived one) makes `algebraMap` elaborate.
  letI : Semiring (ZRing a b h) := (inferInstance : CommSemiring (ZRing a b h)).toSemiring
  let R := Polynomial (ZRing a b h)
  let L := FractionRing R
  let S : Subalgebra K R := (theta a b h).range
  letI : CommSemiring ↥S := inferInstance
  letI : Semiring ↥S := (inferInstance : CommSemiring ↥S).toSemiring
  -- The structure map of `S` into `L` is the composite `S → R → L`.
  have hcompS : ∀ y : S, algebraMap S L y = algebraMap R L (y : R) := by
    intro y
    rw [Subalgebra.algebraMap_eq]
    rfl
  -- **Every element of `L` lies in the subfield generated by the image of `S`.**
  have hgen : Subfield.closure (Set.range (algebraMap S L)) = ⊤ := by
    set T : Subfield L := Subfield.closure (Set.range (algebraMap S L)) with hT
    have mem_range : ∀ y : S, algebraMap S L y ∈ T := by
      intro y
      rw [hT]
      exact Subfield.subset_closure ⟨y, rfl⟩
    -- the values of `theta` on the polynomial ring lie in the closure
    have hTheta : ∀ p : MvPolynomial (Fin 3) K, algebraMap R L (theta a b h p) ∈ T := by
      intro p
      have h1 : algebraMap S L (⟨theta a b h p, ⟨p, rfl⟩⟩ : S) ∈ T := mem_range _
      rwa [hcompS ⟨theta a b h p, ⟨p, rfl⟩⟩] at h1
    have hS4' : algebraMap R L (theta a b h (Sklein a b h 4)) ≠ 0 := fun h0 =>
      hS4 (IsFractionRing.injective R L (by rw [h0, map_zero]))
    have hF4' : algebraMap R L (theta a b h (fwVec a b h 4)) ≠ 0 := fun h0 =>
      hF4 (IsFractionRing.injective R L (by rw [h0, map_zero]))
    -- **the ruling parameter** `T = theta (Sklein 3) / theta (Sklein 4)` lies in the closure
    have hX : algebraMap R L Polynomial.X ∈ T := by
      have hTS := congrArg (algebraMap R L) (ThetaS K a b h)
      simp only [map_mul] at hTS
      have heq : algebraMap R L Polynomial.X
          = algebraMap R L (theta a b h (Sklein a b h 3))
            * (algebraMap R L (theta a b h (Sklein a b h 4)))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ hS4']
        exact hTS
      rw [heq]
      exact T.mul_mem (hTheta _) (T.inv_mem (hTheta _))
    -- **the base point coordinates** `C (mk (X i)) = theta (fwVec (ch3' i)) / theta (fwVec 4)`
    have hCi : ∀ i : Fin 3,
        algebraMap R L (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
          (MvPolynomial.X i))) ∈ T := by
      intro i
      have hTF := congrArg (algebraMap R L) (ThetaFwVec K a b h ha hb hh i)
      simp only [map_mul] at hTF
      have heq : algebraMap R L (Polynomial.C (Ideal.Quotient.mk
            (Ideal.radical (Work.MotK.TwCensus.ZI a b h)) (MvPolynomial.X i)))
          = (algebraMap R L (theta a b h (fwVec a b h 4)))⁻¹
            * algebraMap R L (theta a b h (fwVec a b h (ch3' (K := K) i))) := by
        rw [eq_inv_mul_iff_mul_eq₀ hF4']
        exact hTF
      rw [heq]
      exact T.mul_mem (T.inv_mem (hTheta _)) (hTheta _)
    -- the constants lie in the closure
    have hK : ∀ k : K, algebraMap K L k ∈ T := by
      intro k
      have hC : theta a b h (MvPolynomial.C k)
          = Polynomial.C (algebraMap K (ZRing a b h) k) := by
        rw [MvPolynomial.C_eq_algebraMap, AlgHom.commutes, Polynomial.algebraMap_apply]
      have hmain : algebraMap K L k = algebraMap R L (theta a b h (MvPolynomial.C k)) := by
        rw [hC, IsScalarTower.algebraMap_apply K R L, Polynomial.algebraMap_apply]
      rw [hmain]
      exact hTheta _
    -- the image of `A = K[x₀,x₁,x₂]/radical` is generated by the `mk (X i)`
    have hmemA : ∀ q : MvPolynomial (Fin 3) K,
        algebraMap (ZRing a b h) L
          (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h)) q) ∈ T := by
      intro q
      refine MvPolynomial.induction_on q (motive := fun q => algebraMap (ZRing a b h) L
        (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h)) q) ∈ T) ?_ ?_ ?_
      · intro k
        rw [MvPolynomial.C_eq_algebraMap, Ideal.Quotient.mk_algebraMap,
            ← IsScalarTower.algebraMap_apply K (ZRing a b h) L]
        exact hK k
      · intro p q hp hq
        rw [map_add, map_add]
        exact T.add_mem hp hq
      · intro p n hp
        rw [map_mul, map_mul]
        refine T.mul_mem hp ?_
        have h2 : algebraMap R L (Polynomial.C (Ideal.Quotient.mk
            (Ideal.radical (Work.MotK.TwCensus.ZI a b h)) (MvPolynomial.X n)))
            = algebraMap (ZRing a b h) L
              (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h))
                (MvPolynomial.X n)) := by
          rw [IsScalarTower.algebraMap_apply (ZRing a b h) R L, Polynomial.algebraMap_eq]
        rw [← h2]
        exact hCi n
    -- hence the image of `Polynomial A` lies in the closure
    have hmemR : ∀ p : R, algebraMap R L p ∈ T := by
      intro p
      refine Polynomial.induction_on p (motive := fun p => algebraMap R L p ∈ T) ?_ ?_ ?_
      · intro c
        obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective c
        have h2 : algebraMap R L (Polynomial.C (Ideal.Quotient.mk
            (Ideal.radical (Work.MotK.TwCensus.ZI a b h)) q))
            = algebraMap (ZRing a b h) L
              (Ideal.Quotient.mk (Ideal.radical (Work.MotK.TwCensus.ZI a b h)) q) := by
          rw [IsScalarTower.algebraMap_apply (ZRing a b h) R L, Polynomial.algebraMap_eq]
        rw [h2]
        exact hmemA q
      · intro p q hp hq
        rw [map_add]
        exact T.add_mem hp hq
      · intro n c hc
        rw [pow_succ, ← mul_assoc, map_mul]
        exact T.mul_mem hc hX
    -- every element of `L` is a quotient of two elements of `R`
    rw [eq_top_iff]
    intro z _
    obtain ⟨x, hx⟩ := IsLocalization.surj (nonZeroDivisors R) z
    have hne : algebraMap R L (x.2 : R) ≠ 0 := by
      intro h0
      refine (mem_nonZeroDivisors_iff_ne_zero.mp x.2.2) ?_
      exact IsFractionRing.injective R L (by rw [h0, map_zero])
    have hz : z = algebraMap R L x.1 * (algebraMap R L (x.2 : R))⁻¹ := by
      rw [← hx, mul_assoc, mul_inv_cancel₀ hne, mul_one]
    rw [hz]
    exact T.mul_mem (hmemR x.1) (T.inv_mem (hmemR (x.2 : R)))
  -- `L` is the fraction ring of `S`
  haveI : IsFractionRing S L := by
    have hcinj : Function.Injective (algebraMap S L) := by
      intro x y hxy
      rw [hcompS x, hcompS y] at hxy
      exact Subtype.ext (IsFractionRing.injective R L hxy)
    haveI : FaithfulSMul S L := (faithfulSMul_iff_algebraMap_injective S L).mpr hcinj
    refine IsFractionRing.of_field S L fun z => ?_
    have hz : z ∈ Subfield.closure (Set.range (algebraMap S L)) := by
      rw [hgen]; exact Subfield.mem_top z
    rw [Subfield.mem_closure_iff] at hz
    obtain ⟨y, hy, w, hw, hyw⟩ := hz
    have hclos : Subring.closure (Set.range (algebraMap S L))
        = Subring.map (algebraMap R L) S.toSubring := by
      apply le_antisymm
      · rw [Subring.closure_le]
        rintro x ⟨s, rfl⟩
        refine Subring.mem_map.mpr ⟨(s : R), s.2, ?_⟩
        rw [hcompS]
      · intro x hx
        obtain ⟨a, ha, rfl⟩ := Subring.mem_map.mp hx
        refine Subring.subset_closure ⟨⟨a, ha⟩, ?_⟩
        rw [hcompS]
    obtain ⟨a, ha, hay⟩ := Subring.mem_map.mp (by rw [← hclos]; exact hy)
    obtain ⟨b, hb, hbw⟩ := Subring.mem_map.mp (by rw [← hclos]; exact hw)
    refine ⟨⟨a, ha⟩, ⟨b, hb⟩, ?_⟩
    have h1 : algebraMap S L (⟨a, ha⟩ : S) = algebraMap R L a := by rw [hcompS]
    have h2 : algebraMap S L (⟨b, hb⟩ : S) = algebraMap R L b := by rw [hcompS]
    rw [← hyw, ← hay, ← hbw, h1, h2]
  exact ⟨AlgEquiv.restrictScalars K
    (IsLocalization.algEquiv (nonZeroDivisors S) (FractionRing S) L)⟩

end Work.MotK.TGen
