/-!
# The chart presentation of the twisted Klein curve

Target: `Work.MotK.TGen.ZChartPresentation`.

`Work.MotK.twistFieldTG K D H ⊆ OmG K D = K̄(E)` is the T-twist field of the Kummer class `H`,
generated by the twisted Klein coordinates `yᵢ = w^{-i}·κᵢ/κ₀` (`w⁵ = H`).  On the other hand
`Work.MotK.TwCensus.Qideal a b H` is the radical of the ideal generated by the five twisted Klein
quadrics `kleinTwP a b H` in `K[y₀,…,y₄]`; adjoining `y₀ - 1` cuts the cone by the affine chart.

The theorem says that the function field of that affine chart is `twistFieldTG K D H`.

## Reduction

Set `S := MvPolynomial (Fin 5) K`, `I := Qideal D.a D.b H ⊔ (X 0 - 1)`, and let

  `Φ : S →ₐ[K] ↥(twistFieldTG K D H)`,  `X i ↦ w^{-i}κᵢ/κ₀`

(`chartPhi`).  Since `Φ (X 0) = 1` (as `twCoordG K D H 0 = 1`) and the twisted Klein quadrics
vanish on the twisted coordinates (`Work.MotK.TGen.TwCoordGKleinTw`), `Φ` kills `I`
(`chartIdeal_le_ker`).  So `Φ` factors through `ψ : S ⧸ I →ₐ[K] ↥(twistFieldTG K D H)`, whose image
generates `twistFieldTG` as a field.

The whole remaining content is that `ψ` extends to the fraction field `FractionRing (S ⧸ I)`.  By
the universal property of the localisation at the non-zero-divisors it is enough that no
non-zero-divisor is killed, i.e. that `𝔭 := ker ψ` consists of zero divisors.  This follows from
the single height comparison `(RingHom.ker Φ).height = I.height`: then `𝔭 = (ker Φ)/I` is a prime
of `S ⧸ I` of height `0`, i.e. a minimal prime, and minimal primes consist of zero divisors
(`Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes`).

Both heights are `4`.  The two geometric inputs are isolated below:
`kerChartPhi_height_le : (RingHom.ker Φ).height ≤ 4` (the chart of the twisted Klein curve is at
most one-dimensional) and `ChartIdealHeight : 4 ≤ I.height` (the quadrics plus the chart equation
cut out a locus of dimension at most one).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.MotK.TGen

open MvPolynomial

noncomputable section

/-- **The chart ideal**: the five twisted Klein quadrics (radically) together with the chart
equation `y₀ - 1`. -/
noncomputable def chartIdeal (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K) :
    Ideal (MvPolynomial (Fin 5) K) :=
  Work.MotK.TwCensus.Qideal D.a D.b H ⊔ Ideal.span {MvPolynomial.X (0 : Fin 5) - 1}

/-- **The chart evaluation** `X i ↦ w^{-i} κᵢ/κ₀`, with values in `K̄(E)`. -/
noncomputable def chartPhiOm (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K) :
    MvPolynomial (Fin 5) K →ₐ[K] Work.MotK.OmG K D :=
  MvPolynomial.aeval fun i => Work.MotK.twCoordG K D H i

theorem chartPhiOm_X (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K) (i : Fin 5) :
    chartPhiOm K D H (MvPolynomial.X i) = Work.MotK.twCoordG K D H i :=
  MvPolynomial.aeval_X _ i

/-- The image of `chartPhiOm` lies in `twistFieldTG K D H`. -/
theorem chartPhiOm_mem (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K)
    (x : MvPolynomial (Fin 5) K) : chartPhiOm K D H x ∈ Work.MotK.twistFieldTG K D H := by
  have hle : Algebra.adjoin K (Set.range (Work.MotK.twCoordG K D H)) ≤
      (Work.MotK.twistFieldTG K D H).toSubalgebra := by
    rw [Algebra.adjoin_le_iff]
    rintro y ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin K _ (Set.mem_range_self i)
  have hx : x ∈ Algebra.adjoin K
      (Set.range (MvPolynomial.X : Fin 5 → MvPolynomial (Fin 5) K)) := by
    rw [MvPolynomial.adjoin_range_X]; exact Algebra.mem_top
  have himg : chartPhiOm K D H x ∈
      (Algebra.adjoin K (Set.range (MvPolynomial.X :
        Fin 5 → MvPolynomial (Fin 5) K))).map (chartPhiOm K D H) :=
    ⟨x, hx, rfl⟩
  rw [AlgHom.map_adjoin] at himg
  have hrange : (chartPhiOm K D H) ''
      Set.range (MvPolynomial.X : Fin 5 → MvPolynomial (Fin 5) K) =
      Set.range (Work.MotK.twCoordG K D H) := by
    ext y
    constructor
    · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, (chartPhiOm_X K D H i).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨MvPolynomial.X i, ⟨i, rfl⟩, chartPhiOm_X K D H i⟩
  rw [hrange] at himg
  exact hle himg

/-- The chart evaluation, with values in the twisted Klein field. -/
noncomputable def chartPhi (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K) :
    MvPolynomial (Fin 5) K →ₐ[K] ↥(Work.MotK.twistFieldTG K D H) :=
  (chartPhiOm K D H).codRestrict (Work.MotK.twistFieldTG K D H).toSubalgebra
    (chartPhiOm_mem K D H)

theorem chartPhi_coe (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K)
    (x : MvPolynomial (Fin 5) K) :
    ((chartPhi K D H x : ↥(Work.MotK.twistFieldTG K D H)) : Work.MotK.OmG K D) =
      chartPhiOm K D H x :=
  AlgHom.coe_codRestrict _ _ _ _

theorem chartPhi_X (K : Type) [Field K] (D : Work.MotV.KleinData K) (H : K) (i : Fin 5) :
    ((chartPhi K D H (MvPolynomial.X i) : ↥(Work.MotK.twistFieldTG K D H)) : Work.MotK.OmG K D)
      = Work.MotK.twCoordG K D H i := by
  rw [chartPhi_coe, chartPhiOm_X]

/-- `twCoordG K D H 0 = 1`: the zeroth twisted coordinate is the constant one. -/
theorem twCoordG_zero (K : Type) [Field K] (D : Work.MotV.KleinData K) (hD : D.Good) (H : K) :
    Work.MotK.twCoordG K D H 0 = 1 := by
  have h0 : Work.MotV.kleinCoord D (Work.MotK.KbG K) 0 ≠ 0 := hD.coord0_ne (Work.MotK.KbG K)
  simp only [Work.MotK.twCoordG, Fin.val_zero, pow_zero, one_mul]
  exact div_self h0

/-- The twisted Klein quadrics evaluated at the twisted coordinates vanish, in the `OmG`-form. -/
theorem chartPhiOm_kleinTwP (K : Type) [Field K] (D : Work.MotV.KleinData K) (hD : D.Good)
    (H : K) (hH : H ≠ 0) (k : Fin 5) :
    chartPhiOm K D H
        (kleinTwP (MvPolynomial.C D.a) (MvPolynomial.C D.b) (MvPolynomial.C H)
          (fun i => MvPolynomial.X i) k) = 0 := by
  have h1 : chartPhiOm K D H
      (kleinTwP (MvPolynomial.C D.a) (MvPolynomial.C D.b) (MvPolynomial.C H)
        (fun i => MvPolynomial.X i) k) =
      kleinTwP (algebraMap K (Work.MotK.OmG K D) D.a)
        (algebraMap K (Work.MotK.OmG K D) D.b) (algebraMap K (Work.MotK.OmG K D) H)
        (Work.MotK.twCoordG K D H) k := by
    fin_cases k <;>
      simp only [chartPhiOm, kleinTwP, kleinTwP0, kleinTwP1, kleinTwP2, kleinTwP3, kleinTwP4,
        Work.MotV.kleinTw, Work.MotV.twMon, Work.MotK.fin5_zero, Work.MotK.fin5_one,
        Work.MotK.fin5_two, Work.MotK.fin5_three, Work.MotK.fin5_four,
        Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons, Matrix.tail_cons, Matrix.cons_val_two, Matrix.cons_val_three,
        Matrix.cons_val_four,
        MvPolynomial.aeval_X, MvPolynomial.aeval_C, map_add, map_sub, map_mul, map_pow, map_neg,
        map_ofNat, Algebra.algebraMap_self_apply] <;>
      first | refl_ring1 | ring
  rw [h1, ← kleinTw_eq_kleinTwP']
  exact TwCoordGKleinTw (K := K) D hD H hH k

/-- **`chartPhi` kills the chart ideal.** -/
theorem chartIdeal_le_ker (K : Type) [Field K] (D : Work.MotV.KleinData K) (hD : D.Good) (H : K)
    (hH : H ≠ 0) : chartIdeal K D H ≤ RingHom.ker (chartPhi K D H) := by
  have hspan : Ideal.span (Set.range (fun k : Fin 5 =>
      kleinTwP (MvPolynomial.C D.a) (MvPolynomial.C D.b) (MvPolynomial.C H)
        (fun i => MvPolynomial.X i) k)) ≤ RingHom.ker (chartPhi K D H) := by
    rw [Ideal.span_le]
    rintro y ⟨k, rfl⟩
    exact RingHom.mem_ker.mpr (by
      apply Subtype.ext
      rw [chartPhi_coe]
      simpa using chartPhiOm_kleinTwP K D hD H hH k)
  have hQ : Work.MotK.TwCensus.Qideal D.a D.b H ≤ RingHom.ker (chartPhi K D H) := by
    intro x hx
    rw [Work.MotK.TwCensus.Qideal, Ideal.mem_radical_iff] at hx
    obtain ⟨n, hn⟩ := hx
    rw [RingHom.mem_ker]
    by_contra hne
    refine pow_ne_zero n hne ?_
    rw [← map_pow, RingHom.mem_ker.mp (hspan hn)]
  have hX : MvPolynomial.X (0 : Fin 5) - 1 ∈ RingHom.ker (chartPhi K D H) := by
    rw [RingHom.mem_ker]
    apply Subtype.ext
    rw [chartPhi_coe]
    have : chartPhiOm K D H (MvPolynomial.X (0 : Fin 5) - 1) = 0 := by
      rw [map_sub, chartPhiOm_X, map_one, twCoordG_zero K D hD H, sub_self]
    simpa using this
  rw [chartIdeal]
  refine sup_le hQ ?_
  exact Ideal.span_le.mpr (by rintro y rfl; exact hX)


end

end Work.MotK.TGen
