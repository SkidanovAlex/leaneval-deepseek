/-!
# `Work.MotK.TGen.FwVec4FracRange` — the fraction field of the *range* of the presentation map

`Work.MotK.TGen.FwVec4Rational` shows that the divisor `{f̂₄ = 0}` of the forward link map (whose
presentation map is `θ = fwTheta a b h`, the substitution of the rational parametrisation
`(p₀, p₁, p₂) = (χ₁/χ₄, χ₂/χ₄, χ₃/χ₄)` of the surface into `K[x₀,x₁,x₂]`) is a *junk* divisor: its
residue field is `K(u,v) = RatFunc (RatFunc K)`.  Here we prove the piece of that statement that
concerns the *range* of `θ` rather than its kernel:

  `FractionRing θ.range ≃ₐ[K] RatFunc (RatFunc K)`,

under the two hypotheses `h1`, `h2` that the two coordinate functions `u = fwU` and `v = fwV` of the
parametrising plane are quotients of elements in the range of `θ` (with common denominator
`θ (fwVec a b h 3)`).  Indeed then the fraction field of `θ.range` contains `u` and `v`, hence
contains `K(u,v) = Frac K[x₀,x₁] = FractionRing (MvPolynomial (Fin 2) K)`, and the latter is
`RatFunc (RatFunc K)` by `Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo`.

## Route

* `closure_algebraMap_union_X_eq_top` (private): the subfield of
  `L = FractionRing (MvPolynomial (Fin 2) K)` generated by the image of `K` together with the two
  images of `X 0`, `X 1` is everything.  Since `L` is the fraction field of `K[x₀,x₁]`, every element
  of `L` is a quotient `a/b` of two elements of the image of the polynomial ring; and interpolating
  `K → x₀ → x₁` with `MvPolynomial.induction_on` shows that the image of the polynomial ring lies in
  the subfield.
* `fractionRing_algEquiv_of_closure_eq_top` (private): if a subalgebra `S ⊆ L` of a `K`-field `L` is
  such that the subfield generated by (the image of) `S` is `L`, then `L` is a fraction ring of `S`
  (`Work.MotK.CensusBridge.isFractionRing_of_subfield_closure_range`), and `IsLocalization.algEquiv`
  identifies `FractionRing S` with `L`; `AlgEquiv.restrictScalars K` makes this a `K`-algebra
  equivalence.
* The `h1`/`h2` hypotheses are used only to exhibit `fwU K` and `fwV K` as elements of the closure of
  the range (`fwU K = θ (fwVec a b h 1) · (θ (fwVec a b h 3))⁻¹`), which combines with the previous
  item: the closure of the range contains `K`, `fwU K = algebraMap (X 0)` and `fwV K = algebraMap
  (X 1)`, so it is everything.
-/

set_option maxHeartbeats 1000000
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.MotK.TGen

/-- Every element of `L = FractionRing (MvPolynomial (Fin 2) K)` lies in any subfield of `L` that
contains the image of `K` and the images of `X 0`, `X 1`.  Equivalently, the subfield generated by
these is all of `L`: `L` is the fraction field `K(x₀,x₁)` of `K[x₀,x₁]`. -/
private theorem closure_algebraMap_union_X_eq_top (K : Type) [Field K] :
    Subfield.closure (Set.range (algebraMap K (FractionRing (MvPolynomial (Fin 2) K))) ∪
      ({algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 0),
        algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 1)} : Set (FractionRing (MvPolynomial (Fin 2) K)))) = ⊤ := by
  set T : Subfield (FractionRing (MvPolynomial (Fin 2) K)) :=
    Subfield.closure (Set.range (algebraMap K (FractionRing (MvPolynomial (Fin 2) K))) ∪
      ({algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 0),
        algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 1)} : Set (FractionRing (MvPolynomial (Fin 2) K)))) with hT
  have hmemK : ∀ k : K, algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ T := by
    intro k
    rw [hT]
    exact Subfield.subset_closure (Or.inl ⟨k, rfl⟩)
  have hmemX : ∀ i : Fin 2,
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (MvPolynomial.X i) ∈ T := by
    intro i
    rw [hT]
    fin_cases i <;> exact Subfield.subset_closure (Or.inr (by simp))
  have hmem : ∀ a : MvPolynomial (Fin 2) K,
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) a ∈ T := by
    intro a
    refine MvPolynomial.induction_on a (motive := fun a =>
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) a ∈ T) ?_ ?_ ?_
    · intro c
      rw [MvPolynomial.C_eq_algebraMap,
        ← IsScalarTower.algebraMap_apply K (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K)) c]
      exact hmemK c
    · intro p q hp hq
      rw [map_add]
      exact T.add_mem hp hq
    · intro p n hp
      rw [map_mul]
      exact T.mul_mem hp (hmemX n)
  rw [eq_top_iff]
  intro z _
  obtain ⟨x, hx⟩ := IsLocalization.surj (nonZeroDivisors (MvPolynomial (Fin 2) K)) z
  have hne : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
      (x.2 : MvPolynomial (Fin 2) K) ≠ 0 := by
    intro h0
    refine (mem_nonZeroDivisors_iff_ne_zero.mp x.2.2) ?_
    exact IsFractionRing.injective (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
      (by rw [h0, map_zero])
  have hz : z = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) x.1
      * (algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (x.2 : MvPolynomial (Fin 2) K))⁻¹ := by
    rw [← hx, mul_assoc, mul_inv_cancel₀ hne, mul_one]
  rw [hz]
  exact T.mul_mem (hmem x.1) (T.inv_mem (hmem (x.2 : MvPolynomial (Fin 2) K)))

/-- If a `K`-subalgebra `S` of a field `L` generates `L` as a subfield, then `FractionRing S` is
`K`-isomorphic to `L`. -/
private theorem fractionRing_algEquiv_of_closure_eq_top {K L : Type} [Field K] [Field L]
    [Algebra K L] (S : Subalgebra K L) (h : Subfield.closure (Set.range (algebraMap S L)) = ⊤) :
    Nonempty (FractionRing S ≃ₐ[K] L) := by
  haveI : IsFractionRing S L := Work.MotK.CensusBridge.isFractionRing_of_subfield_closure_range S h
  exact ⟨AlgEquiv.restrictScalars K (IsLocalization.algEquiv (nonZeroDivisors S) (FractionRing S) L)⟩

theorem FwVec4FracRange {K : Type} [Field K] (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (h3 : Work.MotK.TGen.fwTheta a b h (Work.MotK.TGen.fwVec a b h 3) ≠ 0)
    (h1 : Work.MotK.TGen.fwU K * Work.MotK.TGen.fwTheta a b h (Work.MotK.TGen.fwVec a b h 3)
      = Work.MotK.TGen.fwTheta a b h (Work.MotK.TGen.fwVec a b h 1))
    (h2 : Work.MotK.TGen.fwV K * Work.MotK.TGen.fwTheta a b h (Work.MotK.TGen.fwVec a b h 3)
      = Work.MotK.TGen.fwTheta a b h (Work.MotK.TGen.fwVec a b h 2)) :
    Nonempty (FractionRing (Work.MotK.TGen.fwTheta a b h).range ≃ₐ[K]
      RatFunc (RatFunc K)) := by
  have hgen : Subfield.closure (Set.range (algebraMap (fwTheta a b h).range
      (FractionRing (MvPolynomial (Fin 2) K)))) = ⊤ := by
    set T : Subfield (FractionRing (MvPolynomial (Fin 2) K)) :=
      Subfield.closure (Set.range (algebraMap (fwTheta a b h).range
        (FractionRing (MvPolynomial (Fin 2) K)))) with hT
    -- every element of `θ.range`, viewed in `L`, lies in the closure
    have mem_range : ∀ y : (fwTheta a b h).range,
        ((y : FractionRing (MvPolynomial (Fin 2) K)) ∈ T) := by
      intro y
      rw [hT]
      exact Subfield.subset_closure ⟨y, rfl⟩
    -- `u = θ (f̂₁) / θ (f̂₃)` and `v = θ (f̂₂) / θ (f̂₃)` lie in the closure (`h1`, `h2`)
    have hU : fwU K ∈ T := by
      have heq : fwU K = fwTheta a b h (fwVec a b h 1)
          * (fwTheta a b h (fwVec a b h 3))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ h3]
        exact h1
      rw [heq]
      exact T.mul_mem
        (mem_range ⟨_, ⟨fwVec a b h 1, rfl⟩⟩)
        (T.inv_mem (mem_range ⟨_, ⟨fwVec a b h 3, rfl⟩⟩))
    have hV : fwV K ∈ T := by
      have heq : fwV K = fwTheta a b h (fwVec a b h 2)
          * (fwTheta a b h (fwVec a b h 3))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ h3]
        exact h2
      rw [heq]
      exact T.mul_mem
        (mem_range ⟨_, ⟨fwVec a b h 2, rfl⟩⟩)
        (T.inv_mem (mem_range ⟨_, ⟨fwVec a b h 3, rfl⟩⟩))
    -- the constants lie in the closure
    have hKm : ∀ k : K, algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ T := by
      intro k
      have hr : algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ (fwTheta a b h).range :=
        ⟨MvPolynomial.C k, by
          rw [MvPolynomial.C_eq_algebraMap]
          exact AlgHom.commutes (fwTheta a b h) k⟩
      exact mem_range ⟨_, hr⟩
    refine le_antisymm le_top ?_
    rw [← closure_algebraMap_union_X_eq_top K]
    refine Subfield.closure_le.mpr ?_
    rintro x (hx | hx)
    · obtain ⟨k, rfl⟩ := hx
      exact hKm k
    · rw [Set.mem_insert_iff] at hx
      rcases hx with rfl | hx
      · exact hU
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact hV
  obtain ⟨e⟩ := fractionRing_algEquiv_of_closure_eq_top (fwTheta a b h).range hgen
  exact ⟨e.trans (Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo K).some⟩

end Work.MotK.TGen
