/-- Every element of `L = FractionRing (MvPolynomial (Fin 2) K)` lies in any subfield of `L` that
contains the image of `K` and the images of `X 0`, `X 1`.  Equivalently, the subfield generated by
these is all of `L`: `L` is the fraction field `K(x₀,x₁)` of `K[x₀,x₁]`. -/
private theorem closure_algebraMap_union_X_eq_top (K : Type*) [Field K] :
    Subfield.closure (Set.range (algebraMap K (FractionRing (MvPolynomial (Fin 2) K))) ∪
      ({algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 0),
        algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 1)} : Set (FractionRing (MvPolynomial (Fin 2) K)))) = ⊤ := by
  set T : Subfield (FractionRing (MvPolynomial (Fin 2) K)) :=
    Subfield.closure (Set.range (algebraMap K (FractionRing (MvPolynomial (Fin 2) K))) ∪
      ({algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 0),
        algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (MvPolynomial.X 1)} : Set (FractionRing (MvPolynomial (Fin 2) K)))) with hT
  have hmemK : ∀ k : K, algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ T := by
    intro k
    rw [hT]
    exact Subfield.subset_closure (Or.inl ⟨k, rfl⟩)
  have hmemX : ∀ i : Fin 2,
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (MvPolynomial.X i) ∈ T := by
    intro i
    rw [hT]
    fin_cases i <;> exact Subfield.subset_closure (Or.inr (by simp))
  have hmem : ∀ a : MvPolynomial (Fin 2) K,
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) a ∈ T := by
    intro a
    refine MvPolynomial.induction_on a (motive := fun a =>
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) a ∈ T) ?_ ?_ ?_
    · intro c
      rw [MvPolynomial.C_eq_algebraMap,
        ← IsScalarTower.algebraMap_apply K (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K)) c]
      exact hmemK c
    · intro p q hp hq
      rw [map_add]
      exact T.add_mem hp hq
    · intro p n hp
      rw [map_mul]
      exact T.mul_mem hp (hmemX n)
  rw [eq_top_iff]
  intro z _
  obtain ⟨x, hx⟩ := IsLocalization.surj (nonZeroDivisors (MvPolynomial (Fin 2) K)) z
  have hne : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
      (x.2 : MvPolynomial (Fin 2) K) ≠ 0 := by
    intro h0
    refine (mem_nonZeroDivisors_iff_ne_zero.mp x.2.2) ?_
    exact IsFractionRing.injective (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
      (by rw [h0, map_zero])
  have hz : z = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) x.1
      * (algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (x.2 : MvPolynomial (Fin 2) K))⁻¹ := by
    rw [← hx, mul_assoc, mul_inv_cancel₀ hne, mul_one]
  rw [hz]
  exact T.mul_mem (hmem x.1) (T.inv_mem (hmem (x.2 : MvPolynomial (Fin 2) K)))

/-- If `R ⊆ L` is a subalgebra of a field such that the subfield generated by (the image of) `R`
inside `L` is everything, then `L` is a fraction ring of `R`.

Indeed, `Subfield.mem_closure_iff` writes every element of `Subfield.closure s` as `y / z` with
`y`, `z` in the subring generated by `s`; here that subring is `R` itself.

This is the universe-polymorphic form of
`Work.MotK.CensusBridge.isFractionRing_of_subfield_closure_range`: the target statement below is
universe-polymorphic in `K`, so the library version, which is pinned to one universe, does not
apply directly. -/
private theorem isFractionRing_of_subfield_closure_range' {K L : Type*} [Field K] [Field L]
    [Algebra K L] (R : Subalgebra K L)
    (h : Subfield.closure (Set.range (algebraMap R L)) = ⊤) : IsFractionRing R L := by
  refine IsFractionRing.of_field R L fun z => ?_
  have hz : z ∈ Subfield.closure (Set.range (algebraMap R L)) := by
    rw [h]; exact Subfield.mem_top z
  rw [Subfield.mem_closure_iff] at hz
  obtain ⟨y, hy, w, hw, hyw⟩ := hz
  -- the subring generated by the image of `R` is `R` itself
  have hclos : Subring.closure (Set.range (algebraMap R L)) = R.toSubring := by
    refine le_antisymm ?_ ?_
    · rw [Subring.closure_le]
      rintro x ⟨r, rfl⟩
      exact Subalgebra.mem_toSubring.mpr r.2
    · intro x hx
      exact Subring.subset_closure ⟨⟨x, Subalgebra.mem_toSubring.mp hx⟩, rfl⟩
  have hyR : y ∈ R := Subalgebra.mem_toSubring.mp (by rw [← hclos]; exact hy)
  have hwR : w ∈ R := Subalgebra.mem_toSubring.mp (by rw [← hclos]; exact hw)
  exact ⟨⟨y, hyR⟩, ⟨w, hwR⟩, by simpa using hyw.symm⟩

/-- If a `K`-subalgebra `S` of a field `L` generates `L` as a subfield, then `FractionRing S` is
`K`-isomorphic to `L`. -/
private theorem fractionRing_algEquiv_of_closure_eq_top' {K L : Type*} [Field K] [Field L]
    [Algebra K L] (S : Subalgebra K L)
    (h : Subfield.closure (Set.range (algebraMap S L)) = ⊤) :
    Nonempty (FractionRing S ≃ₐ[K] L) := by
  haveI : IsFractionRing S L := isFractionRing_of_subfield_closure_range' S h
  exact ⟨AlgEquiv.restrictScalars K (IsLocalization.algEquiv (nonZeroDivisors S) (FractionRing S) L)⟩

/-- The fraction field of the polynomial ring `𝕜[t,z]` in two variables is the iterated rational
function field `𝕜(t)(z) = RatFunc (RatFunc 𝕜)`.

This is the universe-polymorphic form of
`Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo`, whose proof is repeated verbatim here
(the library version is pinned to a single universe). -/
private theorem fractionRing_mvPolynomial_finTwo' (𝕜 : Type*) [Field 𝕜] :
    Nonempty (FractionRing (MvPolynomial (Fin 2) 𝕜) ≃ₐ[𝕜] RatFunc (RatFunc 𝕜)) := by
  -- `RatFunc (RatFunc 𝕜) = RatFunc K` with `K = RatFunc 𝕜` is a fraction ring of
  -- `K[z] = RatFunc 𝕜[z]`.  To view it as a fraction ring of `𝕜[t][z]` we use the `𝕜[t][z]`-algebra
  -- structure given by the composite of coefficient extension `𝕜[t][z] → K[z]` and the
  -- field-of-fractions structure map `K[z] → K(z)`.
  letI : Algebra (Polynomial (Polynomial 𝕜)) (RatFunc (RatFunc 𝕜)) :=
    (RingHom.toAlgebra
      ((algebraMap (Polynomial (RatFunc 𝕜)) (RatFunc (RatFunc 𝕜))).comp
        (Polynomial.mapRingHom (algebraMap (Polynomial 𝕜) (RatFunc 𝕜)))))
  haveI : IsFractionRing (Polynomial (Polynomial 𝕜)) (RatFunc (RatFunc 𝕜)) :=
    Work.CrauderKatz.isFractionRing_polynomial_ratFunc (A := Polynomial 𝕜) (K := RatFunc 𝕜)
      (fun _ => rfl)
  haveI : IsScalarTower 𝕜 (Polynomial (Polynomial 𝕜)) (RatFunc (RatFunc 𝕜)) := by
    refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
    show algebraMap 𝕜 (RatFunc (RatFunc 𝕜)) c =
      ((algebraMap (Polynomial (RatFunc 𝕜)) (RatFunc (RatFunc 𝕜))).comp
        (Polynomial.mapRingHom (algebraMap (Polynomial 𝕜) (RatFunc 𝕜))))
        (algebraMap 𝕜 (Polynomial (Polynomial 𝕜)) c)
    rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.algebraMap_apply,
      Polynomial.map_C, ← IsScalarTower.algebraMap_apply 𝕜 (Polynomial 𝕜) (RatFunc 𝕜) c,
      IsScalarTower.algebraMap_apply 𝕜 (Polynomial (RatFunc 𝕜)) (RatFunc (RatFunc 𝕜)) c,
      Polynomial.algebraMap_apply]
  -- Transport along `Polynomial (Polynomial 𝕜) ≃ₐ[𝕜] MvPolynomial (Fin 2) 𝕜`.
  exact ⟨IsFractionRing.algEquivOfAlgEquiv (Polynomial.Bivariate.equivMvPolynomial 𝕜).symm⟩

/-- **The fraction field of the range of the parametrisation is `K(u)(v)`.**

Given that the two coordinate functions `u = X 0` and `v = X 1` of the parametrising plane are
quotients of elements in the range of `thetaMap a b h`, with common denominator the image of
`rvec a b h 4` (`h1`, `h2`, `h3` below), the fraction field of `thetaMap.range` is the iterated
rational function field `RatFunc (RatFunc K)`.

This is the `cubTRed` analogue of `Work.MotK.TGen.FwVec4FracRange` (same statement for `fwTheta`),
whose proof can be copied with `fwTheta ↦ thetaMap a b h`, the denominator `fwVec a b h 3 ↦
rvec a b h 4`, the numerators `fwVec a b h 1 ↦ rvec a b h 0`, `fwVec a b h 2 ↦ rvec a b h 3`,
`fwU K ↦ algebraMap (X 0)`, `fwV K ↦ algebraMap (X 1)` (note `h1`/`h2` here have the two sides in
the opposite order, so a `mul_comm`/`eq_mul_inv_iff_mul_eq₀` step is needed).  The two ingredients
are `Work.MotK.CensusBridge.isFractionRing_of_subfield_closure_range` (a subalgebra of a field whose
image generates it as a subfield has that field as fraction field) together with
`Work.CrauderKatz.BlowUp.fractionRing_mvPolynomial_finTwo`. -/
theorem CubTFracRange {K : Type*} [Field K] (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    (h3 : Work.MotK.TGen.thetaMap a b h (Work.MotK.TGen.rvec a b h 4) ≠ 0)
    (h1 : Work.MotK.TGen.thetaMap a b h (Work.MotK.TGen.rvec a b h 0)
      = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
            (MvPolynomial.X 0)
        * Work.MotK.TGen.thetaMap a b h (Work.MotK.TGen.rvec a b h 4))
    (h2 : Work.MotK.TGen.thetaMap a b h (Work.MotK.TGen.rvec a b h 3)
      = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
            (MvPolynomial.X 1)
        * Work.MotK.TGen.thetaMap a b h (Work.MotK.TGen.rvec a b h 4)) :
    Nonempty (FractionRing (Work.MotK.TGen.thetaMap a b h).range ≃ₐ[K] RatFunc (RatFunc K)) := by
  have hgen : Subfield.closure (Set.range (algebraMap (thetaMap a b h).range
      (FractionRing (MvPolynomial (Fin 2) K)))) = ⊤ := by
    set T : Subfield (FractionRing (MvPolynomial (Fin 2) K)) :=
      Subfield.closure (Set.range (algebraMap (thetaMap a b h).range
        (FractionRing (MvPolynomial (Fin 2) K)))) with hT
    -- every element of `θ.range`, viewed in `L`, lies in the closure
    have mem_range : ∀ y : (thetaMap a b h).range,
        ((y : FractionRing (MvPolynomial (Fin 2) K)) ∈ T) := by
      intro y
      rw [hT]
      exact Subfield.subset_closure ⟨y, rfl⟩
    -- `X 0 = θ (rvec 0) / θ (rvec 4)` and `X 1 = θ (rvec 3) / θ (rvec 4)` lie in the closure
    have hU : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (MvPolynomial.X 0) ∈ T := by
      have heq : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
            (MvPolynomial.X 0)
          = thetaMap a b h (rvec a b h 0) * (thetaMap a b h (rvec a b h 4))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ h3]
        exact h1.symm
      rw [heq]
      exact T.mul_mem
        (mem_range ⟨_, ⟨rvec a b h 0, rfl⟩⟩)
        (T.inv_mem (mem_range ⟨_, ⟨rvec a b h 4, rfl⟩⟩))
    have hV : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (MvPolynomial.X 1) ∈ T := by
      have heq : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
            (MvPolynomial.X 1)
          = thetaMap a b h (rvec a b h 3) * (thetaMap a b h (rvec a b h 4))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ h3]
        exact h2.symm
      rw [heq]
      exact T.mul_mem
        (mem_range ⟨_, ⟨rvec a b h 3, rfl⟩⟩)
        (T.inv_mem (mem_range ⟨_, ⟨rvec a b h 4, rfl⟩⟩))
    -- the constants lie in the closure
    have hKm : ∀ k : K, algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ T := by
      intro k
      have hr : algebraMap K (FractionRing (MvPolynomial (Fin 2) K)) k ∈ (thetaMap a b h).range :=
        ⟨MvPolynomial.C k, by
          rw [MvPolynomial.C_eq_algebraMap]
          exact AlgHom.commutes (thetaMap a b h) k⟩
      exact mem_range ⟨_, hr⟩
    refine le_antisymm le_top ?_
    rw [← closure_algebraMap_union_X_eq_top K]
    refine Subfield.closure_le.mpr ?_
    rintro x (hx | hx)
    · obtain ⟨k, rfl⟩ := hx
      exact hKm k
    · rw [Set.mem_insert_iff] at hx
      rcases hx with rfl | hx
      · exact hU
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact hV
  obtain ⟨e⟩ := fractionRing_algEquiv_of_closure_eq_top' (thetaMap a b h).range hgen
  exact ⟨e.trans (fractionRing_mvPolynomial_finTwo' K).some⟩

