import Mathlib
import Submission.Work.MotK.TGen.ZTwistDivGeomDefs
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# `Work.MotK.TGen.ZTwistQidealAux`

Vocabulary for the lemma `Work.MotK.TGen.ZTwistQidealChart`, which compares the fraction ring of
the affine chart `{y₀ = 1}` of the twisted Klein curve, computed in the five variables `y₀,…,y₄`,
with the fraction ring of the same chart computed in the four remaining variables:

`Frac (K[Y₀…Y₄] ⧸ (Qideal a b (h²) ⊔ (Y₀ - 1)))  ≃ₐ[K]  Frac (K[X₀…X₃] ⧸ √(zpgI4 a b h))`.

The two ideals are related by the substitution `Y 0 ↦ 1`, `Y (i+1) ↦ X i`:

* `Ptw a b h k` is the `k`-th twisted Pfaffian `kleinTwP a b (h²)` read in `K[Y₀,…,Y₄]`; by
  definition `TwCensus.Qideal a b (h²)` is the radical of the ideal `Ptw a b h` generates.
* `zpgQ a b h k` is the same Pfaffian evaluated at `y₀ = 1`, read in `K[X₀,…,X₃]`; `zpgI4 a b h`
  is the ideal it generates.
* `iota : K[X₀…X₃] →ₐ[K] K[Y₀…Y₄]` is `X i ↦ Y (i+1)` and `sigma` is the retraction
  `Y 0 ↦ 1`, `Y (i+1) ↦ X i`; `sigma ∘ iota = id` (`sigma_iota`) and `sigma (Ptw a b h k) =
  zpgQ a b h k` (`sigma_Ptw`).
* `mk_iota_sigma` records that on the quotient by any ideal containing `Y 0 - 1`, the composite
  `iota ∘ sigma` is the identity (the substitution `Y 0 ↦ 1` only changes an element by a
  multiple of `Y 0 - 1`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

namespace Work.MotK.TGen

open MvPolynomial

variable {K : Type} [Field K]

/-- The `k`-th twisted Pfaffian `kleinTwP a b (h²)` read in the five variables `Y₀,…,Y₄`. -/
noncomputable def Ptw (a b h : K) (k : Fin 5) : MvPolynomial (Fin 5) K :=
  Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C (h ^ 2))
    (fun i => MvPolynomial.X i) k

@[simp]
theorem Ptw_def (a b h : K) (k : Fin 5) :
    Ptw a b h k = Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b)
      (MvPolynomial.C (h ^ 2)) (fun i => MvPolynomial.X i) k := rfl

/-- `TwCensus.Qideal a b (h²)` is, by definition, the radical of the ideal generated by the five
twisted Pfaffians `Ptw a b h`. -/
theorem Qideal_eq_radical_span_Ptw (a b h : K) :
    Work.MotK.TwCensus.Qideal a b (h ^ 2)
      = (Ideal.span (Set.range (Ptw a b h))).radical := rfl

/-- The substitution `X i ↦ Y (i+1)` (the inclusion of the chart variables). -/
noncomputable def iota : MvPolynomial (Fin 4) K →ₐ[K] MvPolynomial (Fin 5) K :=
  MvPolynomial.aeval
    (![MvPolynomial.X (1 : Fin 5), MvPolynomial.X 2, MvPolynomial.X 3, MvPolynomial.X 4])

/-- The substitution `Y 0 ↦ 1`, `Y (i+1) ↦ X i` (setting the chart coordinate `y₀` to `1`). -/
noncomputable def sigma : MvPolynomial (Fin 5) K →ₐ[K] MvPolynomial (Fin 4) K :=
  MvPolynomial.aeval
    (![(1 : MvPolynomial (Fin 4) K), MvPolynomial.X 0, MvPolynomial.X 1, MvPolynomial.X 2,
      MvPolynomial.X 3])

@[simp]
theorem iota_X_zero : iota (K := K) (MvPolynomial.X (0 : Fin 4)) = MvPolynomial.X 1 := by
  simp [iota]

@[simp]
theorem iota_X_one : iota (K := K) (MvPolynomial.X (1 : Fin 4)) = MvPolynomial.X 2 := by
  simp [iota]

@[simp]
theorem iota_X_two : iota (K := K) (MvPolynomial.X (2 : Fin 4)) = MvPolynomial.X 3 := by
  simp [iota]

@[simp]
theorem iota_X_three : iota (K := K) (MvPolynomial.X (3 : Fin 4)) = MvPolynomial.X 4 := by
  simp [iota]

@[simp]
theorem sigma_X_zero : sigma (K := K) (MvPolynomial.X (0 : Fin 5)) = 1 := by
  simp [sigma]

@[simp]
theorem sigma_X_one : sigma (K := K) (MvPolynomial.X (1 : Fin 5)) = MvPolynomial.X 0 := by
  simp [sigma]

@[simp]
theorem sigma_X_two : sigma (K := K) (MvPolynomial.X (2 : Fin 5)) = MvPolynomial.X 1 := by
  simp [sigma]

@[simp]
theorem sigma_X_three : sigma (K := K) (MvPolynomial.X (3 : Fin 5)) = MvPolynomial.X 2 := by
  simp [sigma]

@[simp]
theorem sigma_X_four : sigma (K := K) (MvPolynomial.X (4 : Fin 5)) = MvPolynomial.X 3 := by
  simp [sigma]

/-- `sigma` is a retraction of `iota`. -/
theorem sigma_comp_iota : (sigma (K := K)).comp (iota (K := K)) = AlgHom.id K _ := by
  refine MvPolynomial.algHom_ext fun i => ?_
  fin_cases i <;> simp [AlgHom.comp_apply]

/-- The composite `sigma ∘ iota` is the identity. -/
theorem sigma_iota (p : MvPolynomial (Fin 4) K) : sigma (K := K) (iota p) = p := by
  have h := congrArg
    (fun (f : MvPolynomial (Fin 4) K →ₐ[K] MvPolynomial (Fin 4) K) => f p)
    (sigma_comp_iota (K := K))
  simpa [AlgHom.comp_apply] using h

/-- **The chart substitution identity.** Setting `Y 0 = 1` in the `k`-th twisted Pfaffian gives
the `k`-th chart quadric `zpgQ a b h k`. -/
theorem sigma_Ptw (a b h : K) (k : Fin 5) :
    sigma (K := K) (Ptw a b h k) = zpgQ a b h k := by
  fin_cases k <;>
  · simp only [Ptw, Work.MotK.kleinTwP, Work.MotK.kleinTwP0, Work.MotK.kleinTwP1,
      Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4, zpgQ, sigma,
      MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
      Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Matrix.cons_val_zero',
      Matrix.cons_val_succ', map_add, map_sub, map_mul, map_pow, map_neg,
      MvPolynomial.C_mul, MvPolynomial.C_pow]
    first | refl_ring1 | ring

/-- **The composite `iota ∘ sigma` is the identity modulo `Y 0 - 1`.**  For any ideal `I` of
`K[Y₀,…,Y₄]` containing `Y 0 - 1`, the substitution `Y 0 ↦ 1` does not change the class of a
polynomial in `K[Y₀,…,Y₄] ⧸ I`. -/
theorem mk_iota_sigma {I : Ideal (MvPolynomial (Fin 5) K)}
    (hI : MvPolynomial.X (0 : Fin 5) - 1 ∈ I) (p : MvPolynomial (Fin 5) K) :
    Ideal.Quotient.mk I (iota (K := K) (sigma p)) = Ideal.Quotient.mk I p := by
  have hX : Ideal.Quotient.mk I (MvPolynomial.X (0 : Fin 5) : MvPolynomial (Fin 5) K) = 1 := by
    have h0 : Ideal.Quotient.mk I (MvPolynomial.X (0 : Fin 5) - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hI
    rw [map_sub, map_one] at h0
    exact sub_eq_zero.mp h0
  have h : (Ideal.Quotient.mkₐ K I).comp ((iota (K := K)).comp (sigma (K := K)))
      = Ideal.Quotient.mkₐ K I := by
    refine MvPolynomial.algHom_ext fun i => ?_
    fin_cases i <;> simp [AlgHom.comp_apply, hX]
  simpa [AlgHom.comp_apply] using congrArg (fun f => f p) h

end Work.MotK.TGen
