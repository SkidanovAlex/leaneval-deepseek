import Mathlib
import Submission.Work.MotK.TGen.BwVec4Defs
import Submission.Work.MotK.TGen.BwVec4Prime
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

set_option linter.unusedVariables false -- v435-speed

/-!
# `Work.MotK.TGen.BwVec4Ker` — the kernel of the evaluation `X ↦ γ/β`

The cubic `bwVec a b h 4 = ǧ₄` (the denominator of the affine coordinates of the inverse link map
`χ = π_p ∘ kleinTwR` of the `T`-twisted Crauder–Katz link) is put in normal form in
`Submission/Work/MotK/TGen/BwVec4Defs.lean`:

  `bwFpoly a b h = C γ - C β · X ∈ K[X₀,X₁][X]`,  `β = bwBeta a b h`,  `γ = bwGamma a b h`,

and `bwTheta a b h : K[X₀,X₁][X] →ₐ[K] Frac K[X₀,X₁]` is the evaluation `X ↦ γ/β`.

Here we prove that the kernel of `bwTheta a b h` is *exactly* the principal ideal `(bwFpoly a b h)`.

**Proof.**  `⊇` is `bwTheta_Fpoly` together with `bwBeta_ne_zero`.  For `⊆`, let `p` be in the
kernel and put `S = K[X₀,X₁]`, `k = Frac S`, and view `t := γ/β ∈ k`.  Since `bwTheta` is the
evaluation `aeval t`, the element `t` is a root of `Polynomial.map (algebraMap S k) p`, hence the
monic polynomial `X - C t` divides it.  In `k[X]` one has

  `map (algebraMap S k) (bwFpoly a b h) = -C β · (X - C t)`,

and `C β` is a unit of `k[X]` because `β ≠ 0`; so `map (algebraMap S k) (bwFpoly a b h)` divides
`map (algebraMap S k) p`.  Finally `bwFpoly a b h` is *primitive* over the UFD `S` — this is the
coprimality of `β` and `γ` established in `BwVec4Prime.lean` (`isRelPrime_bwBeta_bwGamma`) — so
Gauss's lemma (`Polynomial.IsPrimitive.dvd_of_fraction_map_dvd_fraction_map`) descends the
divisibility to `S[X]`: `bwFpoly a b h ∣ p`.

Nothing in the argument depends on the characteristic of `K`; the hypotheses `a b h ≠ 0` are
exactly those under which `β ≠ 0` and `β ∤ γ`.
-/

set_option maxHeartbeats 1000000

namespace Work.MotK.TGen

open Polynomial MvPolynomial

noncomputable section

variable {K : Type} [Field K]

/-- **Coprimality of `β` and `γ`.**  For `a b h ≠ 0` the two coefficients
`β = bwBeta a b h` and `γ = bwGamma a b h` of the normal form `C γ - C β · X` of the cubic
`bwVec a b h 4` have no common non-unit divisor: any `r ∈ K[X₀,X₁]` dividing both is a unit.

This is the coprimality input of Gauss's lemma; it is the content of
`Work.MotK.TGen.isRelPrime_bwBeta_bwGamma` (`BwVec4Prime.lean`), i.e. of `β = C a · β'` being a
unit multiple of the irreducible `β'` together with `β' ∤ γ'`. -/
theorem bwBeta_bwGamma_coprime (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0)
    {r : MvPolynomial (Fin 2) K} (hβ : r ∣ bwBeta a b h) (hγ : r ∣ bwGamma a b h) :
    IsUnit r :=
  isRelPrime_bwBeta_bwGamma a b h ha hb hh hβ hγ

/-- **`bwFpoly a b h` is primitive.**  For `a b h ≠ 0`, the normal form
`bwFpoly a b h = C γ - C β · X` of the cubic `bwVec a b h 4` is a primitive element of
`K[X₀,X₁][X]`; equivalently, the only constant polynomials dividing it are units. -/
theorem bwFpoly_isPrimitive (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    (bwFpoly a b h).IsPrimitive := by
  intro r hr
  obtain ⟨q, hq⟩ := hr
  have h0 : bwGamma a b h = r * q.coeff 0 := by
    have := congrArg (fun p : Polynomial (MvPolynomial (Fin 2) K) => p.coeff 0) hq
    simpa [bwFpoly] using this
  have h1 : -bwBeta a b h = r * q.coeff 1 := by
    have := congrArg (fun p : Polynomial (MvPolynomial (Fin 2) K) => p.coeff 1) hq
    simpa [bwFpoly] using this
  refine bwBeta_bwGamma_coprime a b h ha hb hh ⟨-(q.coeff 1), ?_⟩ ⟨q.coeff 0, h0⟩
  rw [mul_neg, ← h1, neg_neg]

/-- **The kernel of the evaluation `X ↦ γ/β` is generated by `bwFpoly a b h`.**  For `a b h ≠ 0`
in any field `K`, the `K`-algebra map `bwTheta a b h : K[X₀,X₁][X] →ₐ[K] Frac K[X₀,X₁]` sending
the indeterminate to `γ/β` has kernel exactly the principal ideal generated by the normal form
`bwFpoly a b h = C γ - C β · X` of the cubic `bwVec a b h 4`.

Equivalently: `K[X₀,X₁][X]/(bwFpoly a b h) ≃ K[X₀,X₁][γ/β]` inside the fraction field. -/
theorem BwVec4Ker {K : Type} [Field K] (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0) (hh : h ≠ 0) :
    RingHom.ker (Work.MotK.TGen.bwTheta a b h)
      = Ideal.span {Work.MotK.TGen.bwFpoly a b h} := by
  have hβ : bwBeta a b h ≠ 0 := bwBeta_ne_zero a b h ha hb
  have hprim : (bwFpoly a b h).IsPrimitive := bwFpoly_isPrimitive a b h ha hb hh
  apply le_antisymm
  · intro p hp
    rw [Ideal.mem_span_singleton]
    have hp0 : bwTheta a b h p = 0 := RingHom.mem_ker.mp hp
    refine hprim.dvd_of_fraction_map_dvd_fraction_map
      (K := FractionRing (MvPolynomial (Fin 2) K)) ?_
    -- `t = γ/β` in the fraction field `k`
    set acc : FractionRing (MvPolynomial (Fin 2) K) :=
      algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K)) (bwGamma a b h) *
        (algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (bwBeta a b h))⁻¹ with hacc
    have hβk : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
        (bwBeta a b h) ≠ 0 :=
      fun hc => hβ (IsFractionRing.injective _ _ (by rw [hc, map_zero]))
    have hp' : Polynomial.aeval acc p = 0 := by rw [hacc]; exact hp0
    have hroot : (Polynomial.map (algebraMap (MvPolynomial (Fin 2) K)
        (FractionRing (MvPolynomial (Fin 2) K))) p).IsRoot acc := by
      rw [Polynomial.IsRoot.def, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hp'
    have hdvd : Polynomial.X - Polynomial.C acc
        ∣ Polynomial.map (algebraMap _ _) p :=
      Polynomial.dvd_iff_isRoot.mpr hroot
    -- `C β · (X - C t) = C γ` in `k[X]`
    have hmul : algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (bwBeta a b h) * acc
        = algebraMap (MvPolynomial (Fin 2) K) (FractionRing (MvPolynomial (Fin 2) K))
          (bwGamma a b h) := by
      rw [hacc, ← mul_assoc,
        mul_comm (algebraMap _ _ (bwBeta a b h)) (algebraMap _ _ (bwGamma a b h)),
        mul_assoc, mul_inv_cancel₀ hβk, mul_one]
    have hC : Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K)) (bwBeta a b h)) * Polynomial.C acc
        = Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K)) (bwGamma a b h)) := by
      rw [← Polynomial.C_mul, hmul]
    have hmap : Polynomial.map (algebraMap (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K))) (bwFpoly a b h)
        = Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
            (FractionRing (MvPolynomial (Fin 2) K)) (bwGamma a b h))
          - Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
            (FractionRing (MvPolynomial (Fin 2) K)) (bwBeta a b h)) * Polynomial.X := by
      simp only [bwFpoly, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C,
        Polynomial.map_X]
    have hmain : -(Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K)) (bwBeta a b h))
          * (Polynomial.X - Polynomial.C acc))
        = Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
            (FractionRing (MvPolynomial (Fin 2) K)) (bwGamma a b h))
          - Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
            (FractionRing (MvPolynomial (Fin 2) K)) (bwBeta a b h)) * Polynomial.X := by
      rw [mul_sub, hC]
      first | refl_ring1 | ring
    have hid : Polynomial.map (algebraMap (MvPolynomial (Fin 2) K)
          (FractionRing (MvPolynomial (Fin 2) K))) (bwFpoly a b h)
        = -(Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
            (FractionRing (MvPolynomial (Fin 2) K)) (bwBeta a b h)))
          * (Polynomial.X - Polynomial.C acc) := by
      rw [hmap, ← hmain]
      first | refl_ring1 | ring
    have hunit : IsUnit (-(Polynomial.C (algebraMap (MvPolynomial (Fin 2) K)
        (FractionRing (MvPolynomial (Fin 2) K)) (bwBeta a b h)))) :=
      (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr hβk)).neg
    have hassoc : Associated (Polynomial.map (algebraMap _ _) (bwFpoly a b h))
        (Polynomial.X - Polynomial.C acc) := by
      rw [hid]
      exact associated_unit_mul_left _ _ hunit
    exact (hassoc.dvd_iff_dvd_left).mpr hdvd
  · rintro p hp
    rw [Ideal.mem_span_singleton] at hp
    obtain ⟨c, rfl⟩ := hp
    rw [RingHom.mem_ker, map_mul, bwTheta_Fpoly a b h hβ, zero_mul]

end

end Work.MotK.TGen
