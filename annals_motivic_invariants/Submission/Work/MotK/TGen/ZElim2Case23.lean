theorem ZElim2Case23 (L : Type) [Field L] (h5 : (5 : L) ≠ 0) (r u1 u0 v2 v1 v0 : L)
    (hr : r ≠ 0) (hdisc : 1 - 11 * r ^(5:ℕ) - r ^(10:ℕ) ≠ 0) :
    Work.MotK.TGen.Q23 u1 u0 v2 v1 v0 * Work.MotK.TGen.C23 r u1 u0 v2 v1 v0
      ≠ Work.MotK.TGen.g0p r := by
  intro hQ
  have hP : (Work.MotK.TGen.Q23 u1 u0 v2 v1 v0) * (Work.MotK.TGen.C23 r u1 u0 v2 v1 v0)
      - Work.MotK.TGen.g0p r = 0 := by
    rw [hQ]; ring
  have hP' : MvPolynomial.finSuccEquiv L 1
      ((Work.MotK.TGen.Q23 u1 u0 v2 v1 v0) * (Work.MotK.TGen.C23 r u1 u0 v2 v1 v0)
        - Work.MotK.TGen.g0p r) = 0 := by
    rw [hP]; simp
  rw [finSucc_D L r u1 u0 v2 v1 v0] at hP'
  have hQ0 : QcM L r u1 u0 v2 v1 v0 = 0 := by
    have h := congrArg (fun p : Polynomial (MvPolynomial (Fin 1) L) => p.coeff 1) hP'
    simpa using h
  have hP0 : PcM L r u1 u0 v2 v1 v0 = 0 := by
    have h := congrArg (fun p : Polynomial (MvPolynomial (Fin 1) L) => p.coeff 0) hP'
    simpa using h
  have eF4 : -v2 ^(2:ℕ) * r ^(7:ℕ) + (3 : L) * u1 ^(2:ℕ) * v2 * r ^(7:ℕ) - u1 ^(4:ℕ) * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 4)) hQ0
    simp only [QcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eF3 : -1 + (-2 : L) * r ^(5:ℕ) + (-2 : L) * v2 * v1 * r ^(7:ℕ) + (6 : L) * u1 * u0 * v2 * r ^(7:ℕ) + (3 : L) * u1 ^(2:ℕ) * v1 * r ^(7:ℕ) + (-4 : L) * u1 ^(3:ℕ) * u0 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 3)) hQ0
    simp only [QcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eF2 : -v1 ^(2:ℕ) * r ^(7:ℕ) + (-2 : L) * v2 * v0 * r ^(7:ℕ) + (3 : L) * u0 ^(2:ℕ) * v2 * r ^(7:ℕ) + (-3 : L) * u1 * r ^(3:ℕ) - u1 * r ^(8:ℕ) + (6 : L) * u1 * u0 * v1 * r ^(7:ℕ) + (3 : L) * u1 ^(2:ℕ) * v0 * r ^(7:ℕ) + (-6 : L) * u1 ^(2:ℕ) * u0 ^(2:ℕ) * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 2)) hQ0
    simp only [QcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eF1 : (-2 : L) * v1 * v0 * r ^(7:ℕ) + (-3 : L) * u0 * r ^(3:ℕ) - u0 * r ^(8:ℕ) + (3 : L) * u0 ^(2:ℕ) * v1 * r ^(7:ℕ) + (6 : L) * u1 * u0 * v0 * r ^(7:ℕ) + (-4 : L) * u1 * u0 ^(3:ℕ) * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 1)) hQ0
    simp only [QcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eF0 : -v0 ^(2:ℕ) * r ^(7:ℕ) + (3 : L) * u0 ^(2:ℕ) * v0 * r ^(7:ℕ) - u0 ^(4:ℕ) * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 0)) hQ0
    simp only [QcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eG5 : r ^(2:ℕ) + (2 : L) * u1 * v2 ^(2:ℕ) * r ^(7:ℕ) - u1 ^(3:ℕ) * v2 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 5)) hP0
    simp only [PcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eG4 : (2 : L) * u0 * v2 ^(2:ℕ) * r ^(7:ℕ) + (4 : L) * u1 * v2 * v1 * r ^(7:ℕ) + (-3 : L) * u1 ^(2:ℕ) * u0 * v2 * r ^(7:ℕ) - u1 ^(3:ℕ) * v1 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 4)) hP0
    simp only [PcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eG3 : (-3 : L) * v2 * r ^(3:ℕ) - v2 * r ^(8:ℕ) + (4 : L) * u0 * v2 * v1 * r ^(7:ℕ) + (2 : L) * u1 * v1 ^(2:ℕ) * r ^(7:ℕ) + (4 : L) * u1 * v2 * v0 * r ^(7:ℕ) + (-3 : L) * u1 * u0 ^(2:ℕ) * v2 * r ^(7:ℕ) + (-3 : L) * u1 ^(2:ℕ) * u0 * v1 * r ^(7:ℕ) - u1 ^(3:ℕ) * v0 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 3)) hP0
    simp only [PcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eG2 : (-3 : L) * v1 * r ^(3:ℕ) - v1 * r ^(8:ℕ) + (2 : L) * u0 * v1 ^(2:ℕ) * r ^(7:ℕ) + (4 : L) * u0 * v2 * v0 * r ^(7:ℕ) - u0 ^(3:ℕ) * v2 * r ^(7:ℕ) + (4 : L) * u1 * v1 * v0 * r ^(7:ℕ) + (-3 : L) * u1 * u0 ^(2:ℕ) * v1 * r ^(7:ℕ) + (-3 : L) * u1 ^(2:ℕ) * u0 * v0 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 2)) hP0
    simp only [PcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eG1 : (-3 : L) * v0 * r ^(3:ℕ) - v0 * r ^(8:ℕ) + (4 : L) * u0 * v1 * v0 * r ^(7:ℕ) - u0 ^(3:ℕ) * v1 * r ^(7:ℕ) + (2 : L) * u1 * v0 ^(2:ℕ) * r ^(7:ℕ) + (-3 : L) * u1 * u0 ^(2:ℕ) * v0 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 1)) hP0
    simp only [PcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
  have eG0 : -r ^(2:ℕ) + (2 : L) * u0 * v0 ^(2:ℕ) * r ^(7:ℕ) - u0 ^(3:ℕ) * v0 * r ^(7:ℕ) = 0 := by
    have h := congrArg (fun p : MvPolynomial (Fin 1) L => p.coeff (Finsupp.single (0:Fin 1) 0)) hP0
    simp only [PcM, MvPolynomial.coeff_add, MvPolynomial.coeff_zero,
      coeff_C_mul_X0_pow] at h
    simpa using h
