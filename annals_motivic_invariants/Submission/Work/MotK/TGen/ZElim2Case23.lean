/-!
# The `(2,3)` elimination case for the five-term `μ₅`-invariant quintic

We show that `g0p r` admits no factorisation of the shape
`Q23 u1 u0 v2 v1 v0 * C23 r u1 u0 v2 v1 v0` when `5 ≠ 0` in the base field `L`,
`r ≠ 0` and `1 - 11 r ^ 5 - r ^ 10 ≠ 0`.

Writing `P := Q23 * C23 - g0p r`, the transport `MvPolynomial.finSuccEquiv L 1`
exhibits `P` as `C (QcM) * X + C (PcM)` (a polynomial of degree one in `X 0` whose
coefficients are polynomials in `X 1`).  Assuming `P = 0` gives the eleven coefficient
equations `eFk`, `eGk`.  An integer certificate
`34800 * (r ^ 10 + 11 * r ^ 5 - 1) = Σ nᵢ · Eᵢ` (together with the characteristic `2`,
`3` and `29`-adjusted certificates) then forces `1 - 11 r ^ 5 - r ^ 10 = 0`, contradicting
`hdisc`.  The arithmetic is carried out by `ring`; the case distinction on
`(34800 : L) = 0` (with `34800 = 2 ^ 4 * 3 * 5 ^ 2 * 29`) covers every characteristic.
-/

set_option maxHeartbeats 400000000
set_option maxRecDepth 100000

namespace Work.MotK.TGen.ZElim2Case23Aux

open MvPolynomial

lemma coeff_C_mul_X0_pow {L : Type} [CommSemiring L] (c : L) (k m : ℕ) :
    (MvPolynomial.C c * (MvPolynomial.X (0:Fin 1))^k : MvPolynomial (Fin 1) L).coeff
      (Finsupp.single 0 m) = if k = m then c else 0 := by
  rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_pow]
  by_cases h : k = m
  · subst h; simp
  · have hne : Finsupp.single (0:Fin 1) k ≠ Finsupp.single 0 m := by
      intro he
      rw [Finsupp.single_eq_single_iff] at he
      rcases he with ⟨-, h2⟩ | ⟨h1, h2⟩
      · exact h h2
      · exact h (h1.trans h2.symm)
    simp [hne, h]

private lemma finSuccEquiv_Cx {L : Type} [Field L] (b : L) :
    MvPolynomial.finSuccEquiv L 1 (MvPolynomial.C b) = Polynomial.C (MvPolynomial.C b) := by
  rw [← MvPolynomial.algebraMap_eq L (Fin 2), AlgEquiv.commutes, Polynomial.algebraMap_apply]; rfl

private lemma finSuccEquiv_X_zero' {L : Type} [Field L] :
    MvPolynomial.finSuccEquiv L 1 (MvPolynomial.X 0) = Polynomial.X :=
  MvPolynomial.finSuccEquiv_X_zero

private lemma finSuccEquiv_X_one' {L : Type} [Field L] :
    MvPolynomial.finSuccEquiv L 1 (MvPolynomial.X 1) = Polynomial.C (MvPolynomial.X 0) := by
  rw [show (1 : Fin 2) = Fin.succ (0 : Fin 1) from rfl, MvPolynomial.finSuccEquiv_X_succ]

noncomputable def QcM (L : Type) [Field L] (r u1 u0 v2 v1 v0 : L) : MvPolynomial (Fin 1) L :=
  MvPolynomial.C (-v2 ^(2:ℕ) * r ^(7:ℕ) + (3 : L) * u1 ^(2:ℕ) * v2 * r ^(7:ℕ) - u1 ^(4:ℕ) * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(4:ℕ) + MvPolynomial.C (-1 + (-2 : L) * r ^(5:ℕ) + (-2 : L) * v2 * v1 * r ^(7:ℕ) + (6 : L) * u1 * u0 * v2 * r ^(7:ℕ) + (3 : L) * u1 ^(2:ℕ) * v1 * r ^(7:ℕ) + (-4 : L) * u1 ^(3:ℕ) * u0 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(3:ℕ) + MvPolynomial.C (-v1 ^(2:ℕ) * r ^(7:ℕ) + (-2 : L) * v2 * v0 * r ^(7:ℕ) + (3 : L) * u0 ^(2:ℕ) * v2 * r ^(7:ℕ) + (-3 : L) * u1 * r ^(3:ℕ) - u1 * r ^(8:ℕ) + (6 : L) * u1 * u0 * v1 * r ^(7:ℕ) + (3 : L) * u1 ^(2:ℕ) * v0 * r ^(7:ℕ) + (-6 : L) * u1 ^(2:ℕ) * u0 ^(2:ℕ) * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(2:ℕ) + MvPolynomial.C ((-2 : L) * v1 * v0 * r ^(7:ℕ) + (-3 : L) * u0 * r ^(3:ℕ) - u0 * r ^(8:ℕ) + (3 : L) * u0 ^(2:ℕ) * v1 * r ^(7:ℕ) + (6 : L) * u1 * u0 * v0 * r ^(7:ℕ) + (-4 : L) * u1 * u0 ^(3:ℕ) * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(1:ℕ) + MvPolynomial.C (-v0 ^(2:ℕ) * r ^(7:ℕ) + (3 : L) * u0 ^(2:ℕ) * v0 * r ^(7:ℕ) - u0 ^(4:ℕ) * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(0:ℕ)

noncomputable def PcM (L : Type) [Field L] (r u1 u0 v2 v1 v0 : L) : MvPolynomial (Fin 1) L :=
  MvPolynomial.C (r ^(2:ℕ) + (2 : L) * u1 * v2 ^(2:ℕ) * r ^(7:ℕ) - u1 ^(3:ℕ) * v2 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(5:ℕ) + MvPolynomial.C ((2 : L) * u0 * v2 ^(2:ℕ) * r ^(7:ℕ) + (4 : L) * u1 * v2 * v1 * r ^(7:ℕ) + (-3 : L) * u1 ^(2:ℕ) * u0 * v2 * r ^(7:ℕ) - u1 ^(3:ℕ) * v1 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(4:ℕ) + MvPolynomial.C ((-3 : L) * v2 * r ^(3:ℕ) - v2 * r ^(8:ℕ) + (4 : L) * u0 * v2 * v1 * r ^(7:ℕ) + (2 : L) * u1 * v1 ^(2:ℕ) * r ^(7:ℕ) + (4 : L) * u1 * v2 * v0 * r ^(7:ℕ) + (-3 : L) * u1 * u0 ^(2:ℕ) * v2 * r ^(7:ℕ) + (-3 : L) * u1 ^(2:ℕ) * u0 * v1 * r ^(7:ℕ) - u1 ^(3:ℕ) * v0 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(3:ℕ) + MvPolynomial.C ((-3 : L) * v1 * r ^(3:ℕ) - v1 * r ^(8:ℕ) + (2 : L) * u0 * v1 ^(2:ℕ) * r ^(7:ℕ) + (4 : L) * u0 * v2 * v0 * r ^(7:ℕ) - u0 ^(3:ℕ) * v2 * r ^(7:ℕ) + (4 : L) * u1 * v1 * v0 * r ^(7:ℕ) + (-3 : L) * u1 * u0 ^(2:ℕ) * v1 * r ^(7:ℕ) + (-3 : L) * u1 ^(2:ℕ) * u0 * v0 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(2:ℕ) + MvPolynomial.C ((-3 : L) * v0 * r ^(3:ℕ) - v0 * r ^(8:ℕ) + (4 : L) * u0 * v1 * v0 * r ^(7:ℕ) - u0 ^(3:ℕ) * v1 * r ^(7:ℕ) + (2 : L) * u1 * v0 ^(2:ℕ) * r ^(7:ℕ) + (-3 : L) * u1 * u0 ^(2:ℕ) * v0 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(1:ℕ) + MvPolynomial.C (-r ^(2:ℕ) + (2 : L) * u0 * v0 ^(2:ℕ) * r ^(7:ℕ) - u0 ^(3:ℕ) * v0 * r ^(7:ℕ)) * (MvPolynomial.X 0) ^(0:ℕ)

lemma finSucc_D (L : Type) [Field L] (r u1 u0 v2 v1 v0 : L) :
    MvPolynomial.finSuccEquiv L 1
        (Work.MotK.TGen.Q23 u1 u0 v2 v1 v0 * Work.MotK.TGen.C23 r u1 u0 v2 v1 v0
          - Work.MotK.TGen.g0p r)
      = Polynomial.C (QcM L r u1 u0 v2 v1 v0) * Polynomial.X
        + Polynomial.C (PcM L r u1 u0 v2 v1 v0) := by
  simp only [Work.MotK.TGen.Q23, Work.MotK.TGen.C23, Work.MotK.TGen.q1p, Work.MotK.TGen.q0p,
    Work.MotK.TGen.g0p, QcM, PcM, map_sub, map_add, map_mul, map_pow,
    Polynomial.C_add, Polynomial.C_mul, Polynomial.C_pow, Polynomial.C_neg, Polynomial.C_sub,
    Polynomial.C_1, Polynomial.C_ofNat,
    map_ofNat, map_one, map_zero, map_neg, map_sub,
    finSuccEquiv_Cx, finSuccEquiv_X_zero', finSuccEquiv_X_one']
  refl_ring1


end Work.MotK.TGen.ZElim2Case23Aux

