import Mathlib
import Submission.Work.MotK.TGen.CensusFactors
import Submission.Work.MotK.TwRule
import Submission.Work.MotK.LinkCertGen
import Submission.Work.MotV.Defs
import Submission.Work.MotK.TGen.TwCoordGKleinTw
import Submission.Work.MotK.TGen.TwBridge

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

set_option maxHeartbeats 1000000

namespace Work.MotK.TGen

open MvPolynomial

/-- The three indices `1,2,3` of `Fin 5` attached to the three chart coordinates. -/
noncomputable def sdIdx (j : Fin 3) : Fin 5 := ⟨j.val + 1, by have := j.isLt; omega⟩

/-- The target field of the ruling presentation: `RatFunc ↥(twistFieldTG K D h)` = the function
field `F₁(t)` of the target ruling divisor `{sdualT = 0}`. -/
abbrev sdA (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) : Type :=
  RatFunc ↥(Work.MotK.twistFieldTG K D h)

/-- The twisted Klein coordinates, as elements of `sdA K D h`. -/
noncomputable def sdY (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Fin 5 → sdA K D h :=
  fun i => algebraMap ↥(Work.MotK.twistFieldTG K D h) (sdA K D h)
    ⟨Work.MotK.twCoordG K D h i,
      IntermediateField.subset_adjoin K (Set.range (Work.MotK.twCoordG K D h))
        (Set.mem_range_self i)⟩

/-- The first ruling vector `A(y) = dP_y(u₁)`, in `sdA K D h`. -/
noncomputable def sdRuleA (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Fin 5 → sdA K D h :=
  Work.MotK.kleinTwRuleA (algebraMap K (sdA K D h) D.a) (algebraMap K (sdA K D h) D.b)
    (algebraMap K (sdA K D h) h) (sdY K D h)

/-- The second ruling vector `B(y) = dP_y(u₂)`, in `sdA K D h`. -/
noncomputable def sdRuleB (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Fin 5 → sdA K D h :=
  Work.MotK.kleinTwRuleB (algebraMap K (sdA K D h) D.a) (algebraMap K (sdA K D h) D.b)
    (algebraMap K (sdA K D h) h) (sdY K D h)

/-- The ruling point `w = A(y) + t·B(y)` of the ruling line `ℓ_y` over the generic point of the
twisted Klein curve. -/
noncomputable def sdW (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Fin 5 → sdA K D h :=
  fun i => sdRuleA K D h i + (RatFunc.X : sdA K D h) * sdRuleB K D h i

/-- The chart coordinates of the target ruling divisor `{sdualT = 0}`:
`x_j ↦ w_{j+1}/w_4`. -/
noncomputable def sdPhi (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Fin 3 → sdA K D h :=
  fun j => sdW K D h (sdIdx j) / sdW K D h 4

/-- **The presentation of the target ruling divisor.** -/
noncomputable def sdTheta (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    MvPolynomial (Fin 3) K →ₐ[K] sdA K D h :=
  MvPolynomial.aeval (sdPhi K D h)

/-- The subalgebra of `sdA K D h` generated by the chart coordinates. -/
noncomputable def sdR (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Subalgebra K (sdA K D h) :=
  Algebra.adjoin K (Set.range (sdPhi K D h))

end Work.MotK.TGen
