/-!
# `Work.MotK.e11_T_diag`

The `T_diag` field of the Klein data `kleinDataCandidate 𝕜` (the `b = 11` Tate normal form
`E₁₁ : y² - 10xy - 11y = x³ - 11x²`): for a primitive fifth root of unity `ζ` in a field
extension `L/𝕜` with `5 ≠ 0 ≠ 11`, the translation by the `5`-torsion point
`Q(ζ) = (11(ζ²+ζ³−2)/5, (77ζ³+66ζ²+33ζ−66)/5)` acts diagonally on the Klein ratios
`κ_i/κ_0` with eigenvalue `ζ^i`.

The proof is the explicit computation described in `GUIDE_TDiagE11.md`: the eigen-relation is
`σ(κ_i)·κ_0 = ζ^i·κ_i·σ(κ_0)`, which after clearing the `D = x - a` denominators becomes a
polynomial identity modulo the Weierstrass relation `W` and the cyclotomic relation `Φ₅(ζ) = 0`.
-/

set_option linter.unusedSectionVars false
set_option maxHeartbeats 8000000

namespace Work.MotK

open WeierstrassCurve WeierstrassCurve.Affine

noncomputable section

/-! ## §1 The cyclotomic relation `Φ₅(ζ) = 0` -/

lemma e11_zeta_Phi (L : Type) [Field L] (ζ : L) (hζ : IsPrimitiveRoot ζ 5) :
    ζ ^(4:ℕ) + ζ ^(3:ℕ) + ζ ^(2:ℕ) + ζ + 1 = 0 := by
  have h5z : ζ ^(5:ℕ) = 1 := hζ.pow_eq_one
  have hne : ζ - 1 ≠ 0 := sub_ne_zero.mpr (hζ.ne_one (by norm_num))
  have hfac : (ζ - 1) * (ζ ^(4:ℕ) + ζ ^(3:ℕ) + ζ ^(2:ℕ) + ζ + 1) = 0 := by
    rw [show (ζ - 1) * (ζ ^(4:ℕ) + ζ ^(3:ℕ) + ζ ^(2:ℕ) + ζ + 1) = ζ ^(5:ℕ) - 1 from by ring, h5z, sub_self]
  exact (mul_eq_zero.mp hfac).resolve_left hne

/-! ## §2 The `5`-torsion point `Q(ζ)` -/

/-- The `x`-coordinate `Q(ζ) = 11(ζ²+ζ³−2)/5` of the marked `5`-torsion point. -/
def e11a (L : Type) [Field L] (ζ : L) : L := 11 * (ζ ^(2:ℕ) + ζ ^(3:ℕ) - 2) / 5

/-- The `y`-coordinate `(77ζ³+66ζ²+33ζ−66)/5` of the marked `5`-torsion point. -/
def e11b (L : Type) [Field L] (ζ : L) : L := (77 * ζ ^(3:ℕ) + 66 * ζ ^(2:ℕ) + 33 * ζ - 66) / 5

/-- The point `Q(ζ)` lies on `E₁₁`. -/
lemma e11_pt_eq (L : Type) [Field L] (ζ : L) (hζ : IsPrimitiveRoot ζ 5) (h5 : (5 : L) ≠ 0) :
    (e11b L ζ) ^(2:ℕ) - (10 * e11a L ζ + 11) * e11b L ζ - (e11a L ζ) ^(3:ℕ)
      + 11 * (e11a L ζ) ^(2:ℕ) = 0 := by
  have hΦ := e11_zeta_Phi L ζ hζ
  simp only [e11a, e11b]
  field_simp
  linear_combination (norm := ring_nf)
    (-1331 * ζ ^(5:ℕ) - 2662 * ζ ^(4:ℕ) + 4598 * ζ ^(2:ℕ) + 847 * ζ + 4598) * hΦ

/-! ## §3 The polynomial data used in the computation -/

def pA5 (F : Type) [Field F] (z : F) : F := 11 * (z ^(2:ℕ) + z ^(3:ℕ) - 2)
def pB5 (F : Type) [Field F] (z : F) : F := 77 * z ^(3:ℕ) + 66 * z ^(2:ℕ) + 33 * z - 66
def pD5 (F : Type) [Field F] (x z : F) : F := 5 * x - pA5 F z
def pY5 (F : Type) [Field F] (y z : F) : F := 5 * y - pB5 F z
def pNX5 (F : Type) [Field F] (x y z : F) : F :=
  5 * (pY5 F y z) ^(2:ℕ) - 50 * (pY5 F y z) * (pD5 F x z) + (55 - 5 * x - pA5 F z) * (pD5 F x z) ^(2:ℕ)
def pNY5 (F : Type) [Field F] (x y z : F) : F :=
  -(pY5 F y z) * (pNX5 F x y z - 5 * x * (pD5 F x z) ^(2:ℕ)) - 5 * y * (pD5 F x z) ^(3:ℕ)
    + 10 * (pNX5 F x y z) * (pD5 F x z) + 55 * (pD5 F x z) ^(3:ℕ)
def pB05 (F : Type) [Field F] (x y z : F) : F :=
  605 * (pD5 F x z) ^(4:ℕ) + 55 * (pNX5 F x y z) * (pD5 F x z) ^(2:ℕ) + (pNX5 F x y z) ^(2:ℕ)

