/-!
# The height of a principal prime ideal in a UFD

In a unique factorization domain `R`, the ideal generated by a prime element `p` has height `1`.

The mathematical content is that there is no nonzero prime ideal strictly below `span {p}`: every
nonzero prime ideal of a UFD contains a prime element `x` (`Ideal.IsPrime.exists_mem_prime_of_ne_bot`),
and `p ∣ x` together with primality of `p` and `x` forces `p` and `x` to be associated, hence
`span {p} = span {x} ⊆ q`.  Thus the only prime strictly below `span {p}` is `⊥`, whose height is
`0`; combined with `1 ≤ (span {p}).height` (a non-zero-divisor generates an ideal of height at
least one) this gives `height (span {p}) = 1`.

Note that this does *not* need `R` to be Noetherian (Krull's principal ideal theorem is only
available in Mathlib under an `IsNoetherianRing` assumption): the UFD hypothesis is what replaces
it here.
-/

namespace Work.MotK

open Ideal

/-- **Key step.** In a unique factorization domain, any *prime* ideal strictly contained in the
ideal generated by a prime element `p` is the zero ideal.  Indeed, a nonzero prime ideal contains a
prime element `x`; from `x ∈ span {p}` we get `p ∣ x`, and two prime elements where one divides the
other are associated, so `span {p} = span {x} ⊆ q`, contradicting the strict inclusion. -/
theorem eq_bot_of_isPrime_lt_span_singleton_prime {R : Type} [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] {p : R} (hp : Prime p) {q : Ideal R} (hq : q.IsPrime)
    (hlt : q < Ideal.span {p}) : q = ⊥ := by
  by_contra hqne
  obtain ⟨x, hxq, hxprime⟩ := hq.exists_mem_prime_of_ne_bot hqne
  have hpx : p ∣ x := Ideal.mem_span_singleton.mp (hlt.le hxq)
  have hassoc : Associated p x := hp.associated_of_dvd hxprime hpx
  have hspan : Ideal.span {p} = Ideal.span {x} := Ideal.span_singleton_eq_span_singleton.mpr hassoc
  have hle : Ideal.span {x} ≤ q := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxq)
  exact hlt.not_ge (hspan ▸ hle)

/-- The ideal generated by a prime element of a unique factorization domain has height one. -/
theorem HeightSpanSingletonPrime {R : Type} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]
    {p : R} (hp : Prime p) : (Ideal.span {p}).height = 1 := by
  refine le_antisymm ?_ (Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors (x := p) ?_)
  · -- `span {p}` has height at most one: every prime below it is `⊥`, of height `0`.
    refine (@Ideal.height_le_iff R _ (Ideal.span {p}) 1
      (Ideal.isPrime_span_singleton_of_prime hp)).mpr ?_
    intro q hq hlt
    rw [eq_bot_of_isPrime_lt_span_singleton_prime hp hq hlt]
    simp
  · -- `span {p}` has height at least one, since `p` is a non-zero-divisor.
    simpa using hp.ne_zero

end Work.MotK
