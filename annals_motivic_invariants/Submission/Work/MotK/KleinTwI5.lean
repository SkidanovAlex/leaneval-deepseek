/-! ## The ideal of the twisted Klein curve -/

variable (K : Type*) [Field K]

/-- The ideal of the twisted Klein curve `C = V(P_0, …, P_4)` in `ℙ⁴` (coordinates `X 0, …, X 4`). -/
noncomputable def kleinTwCurveIdeal (a b h : K) : Ideal (MvPolynomial (Fin 5) K) :=
  Ideal.span (Set.range (fun k => kleinTwP (MvPolynomial.C a) (MvPolynomial.C b)
    (MvPolynomial.C h) (fun i => MvPolynomial.X i) k))

variable {a b h : K}

/-- A multiple of the `k`-th twisted Pfaffian lies in the ideal of the twisted Klein curve. -/
theorem mul_kleinTwP_mem (k : Fin 5) (g : MvPolynomial (Fin 5) K) :
    g * kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
        (fun i => MvPolynomial.X i) k
      ∈ kleinTwCurveIdeal K a b h :=
  Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)

/-- The divided second partial `kleinTwSD0` lies in the ideal of the twisted Klein curve. -/
theorem kleinTwSD0_mem :
    kleinTwSD0 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
        (fun j => MvPolynomial.X j)
      ∈ kleinTwCurveIdeal K a b h := by
  rw [kleinTwSD0_eq]
  exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _ (mul_kleinTwP_mem K 0 _)
      (mul_kleinTwP_mem K 1 _))
      (mul_kleinTwP_mem K 2 _))
      (mul_kleinTwP_mem K 3 _)

/-- The divided second partial `kleinTwSD1` lies in the ideal of the twisted Klein curve. -/
theorem kleinTwSD1_mem :
    kleinTwSD1 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
        (fun j => MvPolynomial.X j)
      ∈ kleinTwCurveIdeal K a b h := by
  rw [kleinTwSD1_eq]
  exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _ (mul_kleinTwP_mem K 0 _)
      (mul_kleinTwP_mem K 1 _))
      (mul_kleinTwP_mem K 2 _))
      (mul_kleinTwP_mem K 3 _)

