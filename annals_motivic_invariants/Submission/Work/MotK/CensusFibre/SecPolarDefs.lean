  + 9*a^(6:ℕ)*b^(4:ℕ)*c 0*c 2*c 4
  + 3*a*b^(9:ℕ)*c 0*c 2*c 4
  - 2*a^(7:ℕ)*b^(3:ℕ)*c 0*(c 3)^(2:ℕ)
  + a^(2:ℕ)*b^(8:ℕ)*c 0*(c 3)^(2:ℕ)
  - 2*a^(7:ℕ)*b^(3:ℕ)*(c 1)^(2:ℕ)*c 4
  + a^(2:ℕ)*b^(8:ℕ)*(c 1)^(2:ℕ)*c 4
  + 3*a^(9:ℕ)*b*c 1*c 2*c 3
  - 9*a^(4:ℕ)*b^(6:ℕ)*c 1*c 2*c 3
  - 10*a^(5:ℕ)*b^(5:ℕ)*(c 2)^(3:ℕ)
  - a^(8:ℕ)*b^(2:ℕ)*c 3*(c 4)^(2:ℕ)
  - 2*a^(3:ℕ)*b^(7:ℕ)*c 3*(c 4)^(2:ℕ)

def kleinSecD3 (a b : R) (c : Fin 5 → R) : R :=
  - a^(8:ℕ)*b^(2:ℕ)*(c 0)^(2:ℕ)*c 4
  - 2*a^(3:ℕ)*b^(7:ℕ)*(c 0)^(2:ℕ)*c 4
  + 9*a^(6:ℕ)*b^(4:ℕ)*c 0*c 1*c 3
  + 3*a*b^(9:ℕ)*c 0*c 1*c 3
  - 2*a^(7:ℕ)*b^(3:ℕ)*c 0*(c 2)^(2:ℕ)
  + a^(2:ℕ)*b^(8:ℕ)*c 0*(c 2)^(2:ℕ)
  - a^(8:ℕ)*b^(2:ℕ)*(c 1)^(2:ℕ)*c 2
  - 2*a^(3:ℕ)*b^(7:ℕ)*(c 1)^(2:ℕ)*c 2
  - 2*a^(7:ℕ)*b^(3:ℕ)*c 1*(c 4)^(2:ℕ)
  + a^(2:ℕ)*b^(8:ℕ)*c 1*(c 4)^(2:ℕ)
  + 3*a^(9:ℕ)*b*c 2*c 3*c 4
  - 9*a^(4:ℕ)*b^(6:ℕ)*c 2*c 3*c 4
  - 10*a^(5:ℕ)*b^(5:ℕ)*(c 3)^(3:ℕ)

def kleinSecD4 (a b : R) (c : Fin 5 → R) : R :=
  - 2*a^(7:ℕ)*b^(3:ℕ)*(c 0)^(2:ℕ)*c 2
  + a^(2:ℕ)*b^(8:ℕ)*(c 0)^(2:ℕ)*c 2
  - a^(8:ℕ)*b^(2:ℕ)*c 0*(c 1)^(2:ℕ)
  - 2*a^(3:ℕ)*b^(7:ℕ)*c 0*(c 1)^(2:ℕ)
  + 3*a^(9:ℕ)*b*c 0*c 3*c 4
  - 9*a^(4:ℕ)*b^(6:ℕ)*c 0*c 3*c 4
  + 9*a^(6:ℕ)*b^(4:ℕ)*c 1*c 2*c 4
  + 3*a*b^(9:ℕ)*c 1*c 2*c 4
  - 2*a^(7:ℕ)*b^(3:ℕ)*c 1*(c 3)^(2:ℕ)
  + a^(2:ℕ)*b^(8:ℕ)*c 1*(c 3)^(2:ℕ)
  - a^(8:ℕ)*b^(2:ℕ)*(c 2)^(2:ℕ)*c 3
  - 2*a^(3:ℕ)*b^(7:ℕ)*(c 2)^(2:ℕ)*c 3
  - 10*a^(5:ℕ)*b^(5:ℕ)*(c 4)^(3:ℕ)

/-! ## Certificates for the divided second derivatives -/

theorem kleinSecD0_eq (a b : R) (c : Fin 5 → R) :
    kleinSecD0 a b c
      = (
    10*a^(4:ℕ)*b^(4:ℕ)*c 0) * kleinP0 a b c + (
    a^(2:ℕ)*b^(6:ℕ)*c 1
  + 3*a^(7:ℕ)*b*c 1) * kleinP1 a b c + (
  - a*b^(7:ℕ)*c 2
  + 2*a^(6:ℕ)*b^(2:ℕ)*c 2) * kleinP2 a b c
        + (
  - 2*a*b^(7:ℕ)*c 3
  - a^(6:ℕ)*b^(2:ℕ)*c 3) * kleinP3 a b c + (
    0) * kleinP4 a b c := by
  simp only [kleinSecD0, kleinP0, kleinP1, kleinP2, kleinP3, kleinP4]
  first | refl_ring1 | ring

theorem kleinSecD1_eq (a b : R) (c : Fin 5 → R) :
    kleinSecD1 a b c
      = (
  - 2*a*b^(7:ℕ)*c 3
  - a^(6:ℕ)*b^(2:ℕ)*c 3) * kleinP0 a b c + (
  - a*b^(7:ℕ)*c 4
  + 2*a^(6:ℕ)*b^(2:ℕ)*c 4) * kleinP1 a b c + (
    a^(2:ℕ)*b^(6:ℕ)*c 0
  + 3*a^(7:ℕ)*b*c 0) * kleinP2 a b c
        + (
    10*a^(4:ℕ)*b^(4:ℕ)*c 1) * kleinP3 a b c + (
    0) * kleinP4 a b c := by
  simp only [kleinSecD1, kleinP0, kleinP1, kleinP2, kleinP3, kleinP4]
  first | refl_ring1 | ring

theorem kleinSecD2_eq (a b : R) (c : Fin 5 → R) :
    kleinSecD2 a b c
      = (
    2*a^(2:ℕ)*b^(6:ℕ)*c 1
  + a^(7:ℕ)*b*c 1) * kleinP0 a b c + (
    10*a^(4:ℕ)*b^(4:ℕ)*c 2) * kleinP1 a b c + (
  - a^(2:ℕ)*b^(6:ℕ)*c 3
  + 2*a^(7:ℕ)*b*c 3) * kleinP2 a b c
        + (
  - 3*a*b^(7:ℕ)*c 4
  + a^(6:ℕ)*b^(2:ℕ)*c 4) * kleinP3 a b c + (
    0) * kleinP4 a b c := by
  simp only [kleinSecD2, kleinP0, kleinP1, kleinP2, kleinP3, kleinP4]
  first | refl_ring1 | ring

theorem kleinSecD3_eq (a b : R) (c : Fin 5 → R) :
    kleinSecD3 a b c
      = (
    a^(2:ℕ)*b^(6:ℕ)*c 4
  + 3*a^(7:ℕ)*b*c 4) * kleinP0 a b c + (
  - a*b^(7:ℕ)*c 0
  + 2*a^(6:ℕ)*b^(2:ℕ)*c 0) * kleinP1 a b c + (
  - 2*a*b^(7:ℕ)*c 1
  - a^(6:ℕ)*b^(2:ℕ)*c 1) * kleinP2 a b c
        + (
    0) * kleinP3 a b c + (
    10*a^(4:ℕ)*b^(4:ℕ)*c 3) * kleinP4 a b c := by
  simp only [kleinSecD3, kleinP0, kleinP1, kleinP2, kleinP3, kleinP4]
  first | refl_ring1 | ring

theorem kleinSecD4_eq (a b : R) (c : Fin 5 → R) :
    kleinSecD4 a b c
      = (
  - 3*a*b^(7:ℕ)*c 2
  + a^(6:ℕ)*b^(2:ℕ)*c 2) * kleinP0 a b c + (
  - a^(2:ℕ)*b^(6:ℕ)*c 3
  + 2*a^(7:ℕ)*b*c 3) * kleinP1 a b c + (
    10*a^(4:ℕ)*b^(4:ℕ)*c 4) * kleinP2 a b c
        + (
    2*a^(2:ℕ)*b^(6:ℕ)*c 0
  + a^(7:ℕ)*b*c 0) * kleinP3 a b c + (
    0) * kleinP4 a b c := by
  simp only [kleinSecD4, kleinP0, kleinP1, kleinP2, kleinP3, kleinP4]
  first | refl_ring1 | ring

end Work.MotK
