/-!
# Polars of the secant quintic and the ideal of the Klein curve

`kleinSecP j a b c u` (in `SecPolarDefs`) is the coefficient of `t^j` in `s (c + t • u)`, and
`kleinSecD i` the *divided* second derivative of `s` (`2 * kleinSecD i = ∂_i ∂_i s`), with
integral certificates `kleinSecD i = ∑_k g_k p_k`.  Here we prove

* `kleinSec_polar` — the polar expansion `s (c + t • u) = ∑_{j ≤ 5} t^j (kleinSecP j a b c u)`;
* `kleinSecP2_eq` — the second polar as the divided-derivative quadratic form
  `kleinSecP2 a b c u = ∑_i kleinSecD i · u_i² + ∑_{i<j} kleinSecDD_ij · u_i u_j`;
* `kleinSecD_mem`, `kleinSecDD_mem`, `kleinSecP2_mem` — the (divided) second partials of the
  secant quintic, and hence its second polar, lie in the ideal `(p_0, …, p_4)` of the Klein curve
  (identity **I5**: the secant surface has multiplicity ≥ 3 along `C`).

Generated by `_scratch/genpolar4.py`.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 100000
set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.MotK

variable {R : Type*} [CommRing R]

/-! ## Naturality of the polar coefficients -/

theorem kleinSecP0_map {S : Type*} [CommRing S] (φ : R →+* S) (a b : R)
    (c u : Fin 5 → R) :
    φ (kleinSecP0 a b c u) = kleinSecP0 (φ a) (φ b) (fun i => φ (c i)) (fun i => φ (u i)) := by
  simp only [kleinSecP0, map_add, map_mul, map_sub, map_neg, map_pow, map_ofNat, map_natCast]

