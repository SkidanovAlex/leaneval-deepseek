/-! ## The `T`-invariant (`q = p₀`) split link data

These are the split (over any commutative ring) analogues of the `T`-twisted data of
`LinkTwData.lean`, with the *T-invariant* quadric `q = kleinP0` and polar `kleinBilin0` in place of
the shift-invariant `q = Σ p_k` and `kleinBilin`.  They are what the T-twisted certificate has to
be obtained from by descent. -/

/-- The polar form of the T-invariant Pfaffian quadric `p₀`. -/
def kleinBilin0 {R : Type*} [CommRing R] (a b : R) (u v : Fin 5 → R) : R :=
  kleinP0 a b (u + v) - kleinP0 a b u - kleinP0 a b v

/-- Inverse stereographic projection from a point `p` of `{p₀ = 0}`. -/
def kleinStereoT {R : Type*} [CommRing R] (a b : R) (p v : Fin 5 → R) : Fin 5 → R :=
  fun i => kleinP0 a b v * p i - kleinBilin0 a b p v * v i

/-- The source equation of the `T`-invariant link: `b(p,v)·s(y(v))`. -/
def kleinFhomT {R : Type*} [CommRing R] (a b : R) (p v : Fin 5 → R) : R :=
  kleinBilin0 a b p v * kleinSec a b (kleinStereoT a b p v)

/-- The target equation of the `T`-invariant link: `b(p,R(w))·s'(w)`. -/
def kleinGhomT {R : Type*} [CommRing R] (a b : R) (p w : Fin 5 → R) : R :=
  kleinBilin0 a b p (kleinR a b w) * kleinSecDual a b w

/-! ## What is already proved for the certificate (A4)

The chart isomorphism of the certificate is `Work.MotK.TGen.chartIsoT`; here we record the
combination of it with the non-vanishing of the two divisors, which is the whole `F`, `G`, `hF`,
`hG`, `Φ` part of the `LinkCert` structure for the choice

  `F = Fdiv a b h = GambT a b h · f̂₄`,   `G = Gdiv a b h = FambT a b h · ǧ₄`. -/

/-- **The chart part of the T-twisted link certificate.**  For `a b h ≠ 0` the two divisor
polynomials of the affine chart of the T-twisted Crauder--Katz link are nonzero and their two
localisations are isomorphic by the pullback of the inverse link map. -/
theorem Fdiv_Gdiv_chart (K : Type) [Field K] (a b h : K) (ha : a ≠ 0) (hb : b ≠ 0)
    (hh : h ≠ 0) :
    TGen.Fdiv a b h ≠ 0 ∧ TGen.Gdiv a b h ≠ 0 ∧
      Nonempty (Localization.Away (TGen.Fdiv a b h) ≃ₐ[K] Localization.Away (TGen.Gdiv a b h)) :=
  ⟨TGen.FdivNeZero a b h ha hb hh, TGen.GdivNeZero a b h ha hb hh,
    TGen.chartIsoT a b h ha hb hh⟩


/-! ## The census of the T-twisted link, and the assembly

The certificate of `LinkCertTGenInf` is taken with

  `F = Fdiv a b h = linT · sT · f̂₄`,   `G = Gdiv a b h = cubT · sdualT · ǧ₄`,

`Φ` from `TGen.chartIsoT`, and `zP = (sdualT)` — the quintic `s'`-prime of the target side.
The four prime factors not yet handled by the existing junk lemmas (`JunkClassKleinTwBilinChart`
for `linT` and `JunkClassBwVec4` for `ǧ₄`) are the four *presentation* statements collected in
`TGenCensus` below: `sdualT` (class `RatFunc (twistFieldTG K D h)`), `sT`
(class `RatFunc (twistFieldTG K D (h²))`), and the two rational (junk) ones `fwVec a b h 4` and
`cubT` (class `RatFunc (RatFunc K)`).

Each of the four is proved by exhibiting a surjection `K[x₀,x₁,x₂] ↠ R` (`R` a domain) with
kernel the principal prime and fraction field the stated field, and applying
`Work.MotK.CensusBridge.resF_span_eq_ratFunc`; the clauses `IsPrime` and `height = 1` are exactly
the two bookkeeping clauses that `resF_span_eq_ratFunc` returns. -/

open MvPolynomial in
/-- **The census of the T-twisted Crauder--Katz link.**

The clauses are stated in the *robust* form ("every codimension-one point above the factor is of the
stated class"), not as "the factor is a prime element": the degree-10 factor `TGen.sT` is *not*
irreducible for every allowed `(a,b,h)` (e.g. `sT 1 1 1 = 13·(x₁+x₂)·(degree 9)`, see
`GUIDE_CENSUS.md`), so `Ideal.span {sT}` is not always prime; but the *divisor* statement — every
codimension-one point of `sT` is of class `RatFunc (twistFieldTG K D (h^2))` or junk — holds, the
extra factor being the junk linear form `TGen.linT` itself.

For the target-side factor `TGen.sdualT` the prime form *is* the right one: `zP` of the certificate
is its principal prime. -/
def TGenCensus (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) : Prop :=
  (∃ hpr : (Ideal.span {TGen.sdualT D.a D.b h} : Ideal (MvPolynomial (Fin 3) K)).IsPrime,
    Ideal.height (Ideal.span {TGen.sdualT D.a D.b h} : Ideal (MvPolynomial (Fin 3) K)) = 1 ∧
    Nonempty (Work.MotV.resF K ⟨Ideal.span {TGen.sdualT D.a D.b h}, hpr⟩ ≃ₐ[K]
      RatFunc ↥(twistFieldTG K D h))) ∧
  (∀ x : Work.MotA.polySpec K 3, Order.coheight x = 1 → TGen.sT D.a D.b h ∈ x.asIdeal →
    Nonempty (Work.MotV.resF K x ≃ₐ[K] RatFunc ↥(twistFieldTG K D (h ^ 2))) ∨
      Work.MotV.JunkClass K x) ∧
  (∀ x : Work.MotA.polySpec K 3, Order.coheight x = 1 → TGen.fwVec D.a D.b h 4 ∈ x.asIdeal →
    Work.MotV.JunkClass K x) ∧
  (∀ x : Work.MotA.polySpec K 3, Order.coheight x = 1 → TGen.cubT D.a D.b h ∈ x.asIdeal →
    Work.MotV.JunkClass K x)

/-- **The census implies the certificate.** -/
theorem linkCertTGenInf_of_census (K : Type) [Field K] [Infinite K] (hk : ringChar K ≠ 5)
    (D : Work.MotV.KleinData K) (hD : D.Good) (h : K) (hh : h ≠ 0)
    (hc : TGenCensus K D h) :
    Nonempty (Work.MotV.LinkCert K (twistFieldTG K D h) (twistFieldTG K D (h ^ 2))) := by
  have hab := hD.ab_ne
  have ha : D.a ≠ 0 := fun h0 => hab (by rw [h0, zero_mul])
  have hb : D.b ≠ 0 := fun h0 => hab (by rw [h0, mul_zero])
  obtain ⟨⟨hpSd, hhtSd, hrSd⟩, hST, hFw, hCb⟩ := hc
  -- the height-one bookkeeping
  have hcoh := fun (x : Work.MotA.polySpec K 3) (hx : Order.coheight x = 1) =>
    (AlgebraicGeometry.idealHeight_eq_coheight (CommRingCat.of (MvPolynomial (Fin 3) K)) x).trans hx
  let zP : Work.MotA.polySpec K 3 := ⟨Ideal.span {TGen.sdualT D.a D.b h}, hpSd⟩
  have hzP_ht : Order.coheight zP = 1 := by
    rw [← AlgebraicGeometry.idealHeight_eq_coheight (CommRingCat.of (MvPolynomial (Fin 3) K)) zP]
    exact hhtSd
  refine ⟨{ F := TGen.Fdiv D.a D.b h
            G := TGen.Gdiv D.a D.b h
            hF := TGen.FdivNeZero D.a D.b h ha hb hh
            hG := TGen.GdivNeZero D.a D.b h ha hb hh
            Φ := Classical.choice (TGen.chartIsoT D.a D.b h ha hb hh)
            zP := zP
            zP_ht := hzP_ht
            zP_mem := ?_
            zP_res := hrSd
            G_other := ?_
            F_all := ?_ }⟩
  · -- `zP_mem`: `Gdiv = cubT · sdualT · ǧ₄ ∈ (sdualT)`
    rw [TGen.Gdiv_eq]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
  · -- `G_other`
    intro x hcx hxG hxne
    haveI hxprime : x.asIdeal.IsPrime := x.2
    have hxG' : TGen.cubT D.a D.b h * TGen.sdualT D.a D.b h * TGen.bwVec D.a D.b h 4
        ∈ x.asIdeal := by
      rw [← TGen.Gdiv_eq]; exact hxG
    rcases hxprime.mem_or_mem hxG' with hcs | hbw
    · rcases hxprime.mem_or_mem hcs with hc | hs
      · -- the cubic cone factor is junk
        exact hCb x hcx hc
      · -- the quintic is `zP`
        have hx : x.asIdeal = Ideal.span {TGen.sdualT D.a D.b h} :=
          CensusPrime.eq_span_of_height_one _ hpSd hhtSd x.asIdeal (hcoh x hcx) hs
        exact absurd (PrimeSpectrum.ext hx) hxne
    · -- `ǧ₄` is junk
      exact TGen.JunkClassBwVec4 D.a D.b h ha hb hh x hcx hbw
  · -- `F_all`
    intro x hcx hxF
    haveI hxprime : x.asIdeal.IsPrime := x.2
    have hxF' : (TGen.linT D.a D.b h * TGen.sT D.a D.b h) * TGen.fwVec D.a D.b h 4
        ∈ x.asIdeal := by
      rw [← TGen.Fdiv_eq]; exact hxF
    rcases hxprime.mem_or_mem hxF' with hls | hfw
    · rcases hxprime.mem_or_mem hls with hl | hs
      · -- the linear factor is junk
        exact Or.inr (TGen.JunkClassKleinTwBilinChart D.a D.b h ha hb hh x hcx hl)
      · -- the degree-10 factor is of class `RatFunc (twistFieldTG K D (h²))` or junk
        exact hST x hcx hs
    · -- the quartic `f̂₄` is junk
      exact Or.inr (hFw x hcx hfw)

/-- **The census assembled from its four clauses** — the two class clauses
`Work.MotK.TGen.SdualTClass` / `Work.MotK.TGen.STClass` and the two divisor (junk) clauses
`Work.MotK.fwVec4JunkAll` / `Work.MotK.cubTJunkAll`. -/
theorem TGenCensus_all (K : Type) [Field K] [Infinite K] (hk : ringChar K ≠ 5)
    (D : Work.MotV.KleinData K) (hD : D.Good) (h : K) (hh : h ≠ 0) :
    TGenCensus K D h := by
  have hab := hD.ab_ne
  have ha : D.a ≠ 0 := fun h0 => hab (by rw [h0, zero_mul])
  have hb : D.b ≠ 0 := fun h0 => hab (by rw [h0, mul_zero])
  exact ⟨TGen.SdualTClass K hk D hD h hh, TGen.STClass K hk D hD h hh,
    fwVec4JunkAll D.a D.b h ha hb hh, cubTJunkAll D.a D.b h ha hb hh⟩

/-- **The affine Crauder--Katz link certificate for the T-twist** (audit node T8 / `linkCert_TK` for
an arbitrary base field).  For an infinite field `K` of characteristic `≠ 5`, a good Klein datum `D`
over `K` and a nonzero Kummer parameter `h ∈ K`, the twist fields of the Klein curve by `h` and by
`h²` are linked by an affine certificate in the sense of `Work.MotV.LinkCert`. -/
theorem LinkCertTGenInf (K : Type) [Field K] [Infinite K] (hk : ringChar K ≠ 5)
    (D : Work.MotV.KleinData K) (hD : D.Good) (h : K) (hh : h ≠ 0) :
    Nonempty (Work.MotV.LinkCert K (Work.MotK.twistFieldTG K D h)
      (Work.MotK.twistFieldTG K D (h ^ 2))) :=
  linkCertTGenInf_of_census K hk D hD h hh (TGenCensus_all K hk D hD h hh)


/- **The import graph.**  The proof of `LinkCertTGenInf` above needs the class clauses
`Work.MotK.TGen.SdualTClass` and `Work.MotK.TGen.STClass`, and the latter's proof goes through
`Work.MotK.TGen.STRulingDiv` — which needs the *junk conversions* `Work.MotK.fwVec4JunkAll` /
`Work.MotK.cubTJunkAll` that used to live in this file.  They now live in
`Submission/Work/MotK/TGen/JunkConversions.lean`, which `STRulingDiv` imports instead of this file;
that is what makes the statement of `LinkCertTGenInf` possible *here*, as the harness requires.
(Consequently this file is *not* the bottom of the graph any more: it imports the two class clauses
and JunkConversions.) -/

end Work.MotK
