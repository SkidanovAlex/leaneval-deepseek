theorem kleinTwSP5_map {S : Type*} [CommRing S] (φ : R →+* S) (a b h : R)
    (c u : Fin 5 → R) :
    φ (kleinTwSP5 a b h c u)
      = kleinTwSP5 (φ a) (φ b) (φ h) (fun i => φ (c i)) (fun i => φ (u i)) := by
  simp only [kleinTwSP5, kleinTwS, map_add, map_mul, map_sub, map_neg, map_pow, map_ofNat, map_natCast]

/-! ## The polar expansion -/

theorem kleinTwS_polar (a b h : R) (c u : Fin 5 → R) (t : R) :
    kleinTwS a b h (fun i => c i + t * u i)
      = kleinTwSP0 a b h c u + t * kleinTwSP1 a b h c u + t ^ 2 * kleinTwSP2 a b h c u
        + t ^ 3 * kleinTwSP3 a b h c u + t ^ 4 * kleinTwSP4 a b h c u
        + t ^ 5 * kleinTwSP5 a b h c u := by
  simp only [kleinTwSP0, kleinTwSP1, kleinTwSP2, kleinTwSP3, kleinTwSP4, kleinTwSP5, kleinTwS]
  refl_ring1

end Work.MotK
