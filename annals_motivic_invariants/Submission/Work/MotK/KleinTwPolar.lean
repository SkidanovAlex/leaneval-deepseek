/-!
# Polars of the twisted secant quintic: naturality and the polar expansion

`kleinTwSP j a b h c u` (`KleinTwPolarDefs`) is the coefficient of `t^j` in
`kleinTwS (c + t • u)`.  Here we prove the naturality of these coefficients under a ring
homomorphism and the polar expansion

  `kleinTwS (c + t • u) = ∑_{j ≤ 5} t^j · kleinTwSP j a b h c u`.

Used by the ruling identity `Work.MotK.KleinTwRuleMem` (through the coefficient lemmas
`kleinTwS_coeff_two`, `kleinTwS_coeff_three`).

Generated by `_ktrwork/gen_polar.py`.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Work.MotK

variable {R : Type*} [CommRing R]

/-! ## Naturality of the polar coefficients -/

theorem kleinTwSP0_map {S : Type*} [CommRing S] (φ : R →+* S) (a b h : R)
    (c u : Fin 5 → R) :
    φ (kleinTwSP0 a b h c u)
      = kleinTwSP0 (φ a) (φ b) (φ h) (fun i => φ (c i)) (fun i => φ (u i)) := by
  simp only [kleinTwSP0, kleinTwS, map_add, map_mul, map_sub, map_neg, map_pow, map_ofNat, map_natCast]

