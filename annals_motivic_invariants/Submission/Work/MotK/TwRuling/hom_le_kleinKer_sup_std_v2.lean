/-!
# The normal-form reduction modulo the Pfaffian ideal

This file proves `Work.MotK.TwRuling.hom_le_kleinKer_sup_std_v2`, the division ("Hilbert
function") step for the untwisted Klein (Pfaffian) ideal: every homogeneous form of degree `n`
lies in the ideal generated by the five Pfaffians `p₀,…,p₄` plus the span of the `5n` "standard
monomials" `stdMono L n` of `Submission/Work/MotK/TwRuling/KleinKerDefs.lean`.

The argument is the one used in `Submission/Work/MotK/TwRuling/sexticTw_notMem_kernel.lean`
(degree-6 Hilbert bound for the *twisted* ideal, with the same leading monomials), generalised
from `6` to `n` and specialised to the untwisted Pfaffians: with the weights
`wt v = 3 v₀ + 4 v₁ + 4 v₂ + v₃ + v₄`, the `k`-th Pfaffian expands as

`p_k = cc1 k · X^(LMv k) + cc2 k · X^(E2v k) + cc3 k · X^(E3v k)`

with `cc1 k ≠ 0` (because `a * b ≠ 0`) and `wt (E2v k), wt (E3v k) < wt (LMv k)`, and one runs a
strong induction on `wt v`: a degree-`n` monomial divisible by some `LMv k` is rewritten using
`p_k · X^(v - LMv k)`, the two remaining monomials having total degree `n` and strictly smaller
weight; a monomial divisible by no `LMv k` has `(v₀,v₁,v₂) = tr j` for a unique `j`, i.e. it *is*
one of the standard monomials.
-/

/-! ## §1 The untwisted Pfaffian expansion

The twisted Pfaffians of `Work.MotK.kleinTwP` specialise to the untwisted ones at `h = 1`, and
`Work.MotK.TwRuling.twQ_eq` (from `sexticTw_notMem_kernel.lean`) gives their three-term expansion
along the leading monomial `LMv`, the second and third exponents `E2v`, `E3v` and the
coefficients `cc1`, `cc2`, `cc3`. -/

/-- At `h = 1` the twisted Pfaffians are the untwisted Klein Pfaffians. -/
theorem kleinTwP_one_eq (L : Type) [Field L] (a b : L) :
    Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (1 : MvPolynomial (Fin 5) L)
        (fun i => MvPolynomial.X i)
      = Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b) (fun i => MvPolynomial.X i) := by
  funext k
  fin_cases k <;>
    simp [Work.MotK.kleinTwP, Work.MotK.kleinP, Work.MotK.kleinTwP0, Work.MotK.kleinTwP1,
      Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4, Work.MotK.kleinP0,
      Work.MotK.kleinP1, Work.MotK.kleinP2, Work.MotK.kleinP3, Work.MotK.kleinP4, Fin.isValue,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
      Matrix.cons_val_four]

/-- The untwisted Pfaffian `p_k`, expanded along its monomials: the leading monomial `X^(LMv k)`
(coefficient `cc1 a b 1 k`, nonzero when `a * b ≠ 0`) plus the two monomials `X^(E2v k)`,
`X^(E3v k)` of strictly smaller `wt`. -/
theorem kleinP_eq (L : Type) [Field L] (a b : L) (k : Fin 5) :
    Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b) (fun i => MvPolynomial.X i) k
      = MvPolynomial.C (cc1 a b 1 k) * mono (R := L) (LMv k)
        + MvPolynomial.C (cc2 a b 1 k) * mono (R := L) (E2v k)
        + MvPolynomial.C (cc3 a b 1 k) * mono (R := L) (E3v k) := by
  rw [← kleinTwP_one_eq (L := L) a b]
  exact twQ_eq a b 1 k

/-! ## §2 The standard monomials -/

/-- The fourth coordinate of `tr j` vanishes identically. -/
lemma tr_three (j : Fin 5) : tr j 3 = 0 := by fin_cases j <;> decide

/-- The fifth coordinate of `tr j` vanishes identically. -/
lemma tr_four (j : Fin 5) : tr j 4 = 0 := by fin_cases j <;> decide

/-- An exponent vector whose first three coordinates are `tr j` and whose last two sum to
`n - tt j` is the standard exponent vector `stdExp n ⟨j, v₃⟩`. -/
lemma stdExp_eq_of (n : ℕ) (v : Fin 5 → ℕ) (j : Fin 5) (hi : v 3 < n + 1 - tt j)
    (h0 : v 0 = tr j 0) (h1 : v 1 = tr j 1) (h2 : v 2 = tr j 2)
    (h34 : v 3 + v 4 = n - tt j) : stdExp n ⟨j, ⟨v 3, hi⟩⟩ = v := by
  funext i
  fin_cases i <;> simp [stdExp, h0, h1, h2, tr_three, tr_four] <;> omega

/-! ## §3 The division algorithm -/

/-- **Division by the Pfaffians.** A degree-`n` monomial lies in the Pfaffian ideal plus the span
of the standard monomials, by strong induction on its weight `wt`. -/
lemma mono_mem_std (L : Type) [Field L] (a b : L) (hab : a * b ≠ 0) (n : ℕ) (v : Fin 5 → ℕ)
    (hv : ∑ i, v i = n) :
    mono (R := L) v ∈ kleinKerSub L a b ⊔ Submodule.span L (Set.range (stdMono L n)) := by
  obtain ⟨ha, hb⟩ := mul_ne_zero_iff.mp hab
  have key : ∀ m, ∀ v : Fin 5 → ℕ, (∑ i, v i) = n → wt v = m →
      mono (R := L) v ∈ kleinKerSub L a b ⊔ Submodule.span L (Set.range (stdMono L n)) := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro v hv hwt
      by_cases hdiv : ∃ k : Fin 5, LMv k ≤ v
      · obtain ⟨k, hk⟩ := hdiv
        have hcc1 : cc1 a b 1 k ≠ 0 := cc1_ne a b 1 ha hb k
        set v' : Fin 5 → ℕ := fun i => v i - LMv k i with hv'def
        have hv_eq : v = LMv k + v' := by
          funext i
          have hi : LMv k i ≤ v i := hk i
          show v i = LMv k i + (v i - LMv k i)
          omega
        have hvn : 2 + ∑ i, v' i = n := by
          have h1 : ∑ i, (LMv k + v') i = ∑ i, LMv k i + ∑ i, v' i := by
            simp only [Pi.add_apply, Finset.sum_add_distrib]
          have h2 : ∑ i, LMv k i = 2 := sum_LMv k
          have h3 : ∑ i, v i = ∑ i, (LMv k + v') i := by rw [hv_eq]
          omega
        have hrel : mono (R := L) v = MvPolynomial.C ((cc1 a b 1 k)⁻¹) *
            (Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b) (fun i => MvPolynomial.X i) k
                * mono (R := L) v'
              - MvPolynomial.C (cc2 a b 1 k) * mono (R := L) (E2v k + v')
              - MvPolynomial.C (cc3 a b 1 k) * mono (R := L) (E3v k + v')) := by
          have hq := kleinP_eq (L := L) a b k
          have h1 : Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b)
                (fun i => MvPolynomial.X i) k * mono (R := L) v'
              = MvPolynomial.C (cc1 a b 1 k) * mono (R := L) v
                + MvPolynomial.C (cc2 a b 1 k) * mono (R := L) (E2v k + v')
                + MvPolynomial.C (cc3 a b 1 k) * mono (R := L) (E3v k + v') := by
            rw [hq, add_mul, add_mul]
            simp only [mul_assoc, ← mono_mul, ← hv_eq]
          rw [h1]
          rw [show MvPolynomial.C (cc1 a b 1 k) * mono (R := L) v
                + MvPolynomial.C (cc2 a b 1 k) * mono (R := L) (E2v k + v')
                + MvPolynomial.C (cc3 a b 1 k) * mono (R := L) (E3v k + v')
                - MvPolynomial.C (cc2 a b 1 k) * mono (R := L) (E2v k + v')
                - MvPolynomial.C (cc3 a b 1 k) * mono (R := L) (E3v k + v')
                = MvPolynomial.C (cc1 a b 1 k) * mono (R := L) v from by ring]
          rw [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hcc1, MvPolynomial.C_1, one_mul]
        have hmemq : Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b)
            (fun i => MvPolynomial.X i) k * mono (R := L) v' ∈ kleinKerSub L a b := by
          rw [mem_kleinKerSub_iff, mul_comm]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self k))
        have hmemE2 : mono (R := L) (E2v k + v') ∈
            kleinKerSub L a b ⊔ Submodule.span L (Set.range (stdMono L n)) := by
          refine ih (wt (E2v k + v')) ?_ (E2v k + v') ?_ rfl
          · have e1 : wt (E2v k + v') = wt (E2v k) + wt v' := wt_add _ _
            have e2 : wt v = wt (LMv k) + wt v' := by rw [hv_eq, wt_add]
            have e3 : wt (E2v k) < wt (LMv k) := wt_E2v_lt k
            omega
          · have h1 : ∑ i, (E2v k + v') i = ∑ i, E2v k i + ∑ i, v' i := by
              simp only [Pi.add_apply, Finset.sum_add_distrib]
            have h2 : ∑ i, E2v k i = 2 := sum_E2v k
            omega
        have hmemE3 : mono (R := L) (E3v k + v') ∈
            kleinKerSub L a b ⊔ Submodule.span L (Set.range (stdMono L n)) := by
          refine ih (wt (E3v k + v')) ?_ (E3v k + v') ?_ rfl
          · have e1 : wt (E3v k + v') = wt (E3v k) + wt v' := wt_add _ _
            have e2 : wt v = wt (LMv k) + wt v' := by rw [hv_eq, wt_add]
            have e3 : wt (E3v k) < wt (LMv k) := wt_E3v_lt k
            omega
          · have h1 : ∑ i, (E3v k + v') i = ∑ i, E3v k i + ∑ i, v' i := by
              simp only [Pi.add_apply, Finset.sum_add_distrib]
            have h2 : ∑ i, E3v k i = 2 := sum_E3v k
            omega
        rw [hrel, ← MvPolynomial.smul_eq_C_mul]
        refine Submodule.smul_mem _ _ (Submodule.sub_mem _ (Submodule.sub_mem _ ?_ ?_) ?_)
        · exact Submodule.mem_sup_left hmemq
        · rw [← MvPolynomial.smul_eq_C_mul]; exact Submodule.smul_mem _ _ hmemE2
        · rw [← MvPolynomial.smul_eq_C_mul]; exact Submodule.smul_mem _ _ hmemE3
      · -- `v` is not divisible by any leading monomial: it is a standard monomial
        have h0 : v 0 ≤ 1 := by
          by_contra hcon
          have hcon' : 2 ≤ v 0 := by omega
          exact hdiv ⟨0, by intro i; fin_cases i <;> simp [LMv] <;> omega⟩
        have h1 : v 1 ≤ 1 := by
          by_contra hcon
          have hcon' : 2 ≤ v 1 := by omega
          exact hdiv ⟨3, by intro i; fin_cases i <;> simp [LMv] <;> omega⟩
        have h2 : v 2 ≤ 1 := by
          by_contra hcon
          have hcon' : 2 ≤ v 2 := by omega
          exact hdiv ⟨1, by intro i; fin_cases i <;> simp [LMv] <;> omega⟩
        have h01 : ¬ (1 ≤ v 0 ∧ 1 ≤ v 1) := by
          rintro ⟨hA, hB⟩
          exact hdiv ⟨4, by intro i; fin_cases i <;> simp [LMv] <;> omega⟩
        have h12 : ¬ (1 ≤ v 1 ∧ 1 ≤ v 2) := by
          rintro ⟨hA, hB⟩
          exact hdiv ⟨2, by intro i; fin_cases i <;> simp [LMv] <;> omega⟩
        have hsum5 : v 0 + v 1 + v 2 + v 3 + v 4 = n := by
          have h := hv
          rw [Fin.sum_univ_five] at h
          exact h
        have h0' : v 0 = 0 ∨ v 0 = 1 := by omega
        rcases h0' with h0' | h0'
        · have h1' : v 1 = 0 ∨ v 1 = 1 := by omega
          rcases h1' with h1' | h1'
          · have h2' : v 2 = 0 ∨ v 2 = 1 := by omega
            rcases h2' with h2' | h2'
            · -- `(v₀,v₁,v₂) = (0,0,0) = tr 0`
              have hs : v 0 + v 1 + v 2 = tt 0 := by rw [h0', h1', h2']; decide
              have hadd : tt 0 + v 3 + v 4 = n := by omega
              have h34 : v 3 + v 4 = n - tt 0 := by omega
              have hlt : v 3 < n + 1 - tt 0 := by omega
              have hstd : stdExp n ⟨0, ⟨v 3, hlt⟩⟩ = v :=
                stdExp_eq_of n v 0 hlt (by rw [h0']; decide) (by rw [h1']; decide)
                  (by rw [h2']; decide) h34
              rw [← hstd]
              exact Submodule.mem_sup_right (Submodule.subset_span (Set.mem_range_self _))
            · -- `(v₀,v₁,v₂) = (0,0,1) = tr 3`
              have hs : v 0 + v 1 + v 2 = tt 3 := by rw [h0', h1', h2']; decide
              have hadd : tt 3 + v 3 + v 4 = n := by omega
              have h34 : v 3 + v 4 = n - tt 3 := by omega
              have hlt : v 3 < n + 1 - tt 3 := by omega
              have hstd : stdExp n ⟨3, ⟨v 3, hlt⟩⟩ = v :=
                stdExp_eq_of n v 3 hlt (by rw [h0']; decide) (by rw [h1']; decide)
                  (by rw [h2']; decide) h34
              rw [← hstd]
              exact Submodule.mem_sup_right (Submodule.subset_span (Set.mem_range_self _))
          · -- `v₁ = 1`, `v₀ = 0`, so `v₂ = 0`: `(0,1,0) = tr 2`
            have h2' : v 2 = 0 := by
              by_contra hcon
              have hcon' : 1 ≤ v 2 := by omega
              exact h12 ⟨by omega, hcon'⟩
            have hs : v 0 + v 1 + v 2 = tt 2 := by rw [h0', h1', h2']; decide
            have hadd : tt 2 + v 3 + v 4 = n := by omega
            have h34 : v 3 + v 4 = n - tt 2 := by omega
            have hlt : v 3 < n + 1 - tt 2 := by omega
            have hstd : stdExp n ⟨2, ⟨v 3, hlt⟩⟩ = v :=
              stdExp_eq_of n v 2 hlt (by rw [h0']; decide) (by rw [h1']; decide)
                (by rw [h2']; decide) h34
            rw [← hstd]
            exact Submodule.mem_sup_right (Submodule.subset_span (Set.mem_range_self _))
        · -- `v₀ = 1`, so `v₁ = 0`
          have h1' : v 1 = 0 := by
            by_contra hcon
            have hcon' : 1 ≤ v 1 := by omega
            exact h01 ⟨by omega, hcon'⟩
          have h2' : v 2 = 0 ∨ v 2 = 1 := by omega
          rcases h2' with h2' | h2'
          · -- `(v₀,v₁,v₂) = (1,0,0) = tr 1`
            have hs : v 0 + v 1 + v 2 = tt 1 := by rw [h0', h1', h2']; decide
            have hadd : tt 1 + v 3 + v 4 = n := by omega
            have h34 : v 3 + v 4 = n - tt 1 := by omega
            have hlt : v 3 < n + 1 - tt 1 := by omega
            have hstd : stdExp n ⟨1, ⟨v 3, hlt⟩⟩ = v :=
              stdExp_eq_of n v 1 hlt (by rw [h0']; decide) (by rw [h1']; decide)
                (by rw [h2']; decide) h34
            rw [← hstd]
            exact Submodule.mem_sup_right (Submodule.subset_span (Set.mem_range_self _))
          · -- `(v₀,v₁,v₂) = (1,0,1) = tr 4`
            have hs : v 0 + v 1 + v 2 = tt 4 := by rw [h0', h1', h2']; decide
            have hadd : tt 4 + v 3 + v 4 = n := by omega
            have h34 : v 3 + v 4 = n - tt 4 := by omega
            have hlt : v 3 < n + 1 - tt 4 := by omega
            have hstd : stdExp n ⟨4, ⟨v 3, hlt⟩⟩ = v :=
              stdExp_eq_of n v 4 hlt (by rw [h0']; decide) (by rw [h1']; decide)
                (by rw [h2']; decide) h34
            rw [← hstd]
            exact Submodule.mem_sup_right (Submodule.subset_span (Set.mem_range_self _))
  exact key (wt v) v hv rfl

/-- **The reduction modulo the Pfaffian ideal (normal form).**  Over a field `L` with `a * b ≠ 0`,
every homogeneous polynomial of degree `n` in `L[X₀,…,X₄]` lies in the sum of the Pfaffian ideal
`Work.MotK.TwRuling.kleinKerSub L a b` (the ideal generated by the five Klein Pfaffians
`Work.MotK.kleinP (C a) (C b) X k`, see `Submission/Work/MotK/TwRuling/KleinKerDefs.lean`) and the
`L`-span of the `5n` "standard monomials" `Work.MotK.TwRuling.stdMono L n`.

This is verbatim the statement of `Work.MotK.TwRuling.hom_le_kleinKer_sup_std`
(`Submission/Work/MotK/TwRuling/hom_le_kleinKer_sup_std.lean`), which is still a `sorry` there; the
new file exists so that the statement can be proved without touching that file.  It is the
normal-form input of the node `kleinKer_mem_of_homogeneous_aeval_eq_zero`
(`Submission/Work/MotK/TwRuling/KleinKerMain.lean`, whose two remaining `sorry`s are placeholders
for `Q_le_aeval_homogeneousSubmodule` — already proved — and this statement).  The same statement
in the `Work.MotAS` namespace, `Work.MotAS.homKleinKerSupStd`
(`Submission/Work/MotAS/homKleinKerSupStd.lean`), is its duplicate.

PROOF ROUTE (complete; only formalisation is left).  Give `X₀,…,X₄` the weights `3,4,4,1,1` and
put `wt v = 3v₀+4v₁+4v₂+v₃+v₄` on exponent vectors `v : Fin 5 → ℕ`.  The five Pfaffians are
trinomials whose monomials have pairwise distinct weights:
`p_k = lead k · monomial (lm k) 1 + (two monomials of strictly smaller weight)`, where
`lm = (X₀², X₂², X₁X₂, X₁², X₀X₁)` as exponent vectors and the leading coefficients
`lead = (-a*b, -a*b, a^2, -a*b, a^2)` are nonzero because `a*b ≠ 0` in a field; this is a
`fin_cases`/`ring` computation from `Work.MotK.kleinP0..4`.  It suffices to treat a single monomial
`monomial v 1` of total degree `n` (the degree-`n` part of `MvPolynomial` is spanned by its
monomials).  Induct on `wt v`:

* if `v` is **not** divisible by any `lm k`, then `(v₀,v₁,v₂)` is one of the five patterns
  `tr j ∈ {(0,0,0),(1,0,0),(0,1,0),(0,0,1),(1,0,1)}` (`Work.MotK.TwRuling.tr`) and
  `v = stdExp n ⟨j, ⟨v₃,_⟩⟩` (`Work.MotK.TwRuling.stdExp`, `tt`, `stdExp_sum`), so
  `monomial v 1 = stdMono L n ⟨j, ⟨v₃,_⟩⟩` lies in `Submodule.span L (Set.range (stdMono L n))`;
* otherwise pick `k` with `lm k ∣ v`, put `v' = v - lm k`, and read the expansion of `p_k` as
  `lead k * monomial v 1 = monomial v' 1 * p_k - monomial v' 1 * (p_k - lead k * monomial (lm k) 1)`.
  Here `monomial v' 1 * p_k ∈ kleinKerSub L a b` (an ideal is closed under multiplication) and
  `monomial v' 1 * (p_k - lead k * monomial (lm k) 1)` is a sum of *two* monomials of total degree
  `n` and of weight strictly smaller than `wt v`; divide by the nonzero `lead k` and apply the
  induction hypothesis to those two monomials.

Summing the resulting membership over the monomials of a homogeneous polynomial of degree `n`
gives the claim (membership in `MvPolynomial.homogeneousSubmodule (Fin 5) L n` is membership in
the span of the degree-`n` monomials). -/
theorem hom_le_kleinKer_sup_std_v2 (L : Type) [Field L] (a b : L) (hab : a * b ≠ 0) (n : ℕ) :
    MvPolynomial.homogeneousSubmodule (Fin 5) L n ≤
      Work.MotK.TwRuling.kleinKerSub L a b ⊔
        Submodule.span L (Set.range (Work.MotK.TwRuling.stdMono L n)) := by
  rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported,
    AddMonoidAlgebra.supported_eq_span_single]
  rw [Submodule.span_le]
  rintro _ ⟨d, hd, rfl⟩
  dsimp only
  rw [MvPolynomial.single_eq_monomial]
  have hn : ∑ i, d i = n := by
    rw [← Finsupp.degree_eq_sum]
    exact hd
  have hfd : funF (fun i => d i) = d := by
    ext i
    simp only [funF_apply]
  have hdm : mono (R := L) (fun i => d i) = MvPolynomial.monomial d 1 := by
    rw [mono, hfd]
  rw [← hdm]
  exact mono_mem_std L a b hab n (fun i => d i) hn

end Work.MotK.TwRuling
