/-!
# Degree-25 vocabulary for the T-twisted ruling nonvanishing

The target `Work.MotK.TwRuling.sdW_kleinTwR_ne_zero` reduces (via the ruling identity and the
Taylor/I5 identity shipped with `KleinTwRuleMem`) to the nonvanishing of a *quintic* form in the
twisted Klein coordinates.  The plan is the degree-5 analogue of the "kernel of the multiplication
map" argument that proves `Work.MotK.TwRuling.sdW_four_ne_zero`:

* the fivefold product map `(quintic forms in 5 variables) → R(E)` has range `L(25·O)`
  (`sdTF5_span`, the fivefold analogue of `productSpan_eq`);
* the degree-5 part of the ideal generated by the five Pfaffians is 101-dimensional, i.e. the
  quotient is 25-dimensional in degree 5 (`twIdeal_five_dim`);
* hence the kernel of the product map is exactly that ideal part, and any quintic form outside it
  is nonzero at the Klein coordinates (`quintic_notMem_kernel`).

This file only collects the vocabulary shared by those three statements.
-/

open WeierstrassCurve WeierstrassCurve.Affine

namespace Work.MotK.TwRuling

noncomputable section

variable {R : Type} [Field R]

/-- The 25 monomials of `L(25·O)`: `1, x, …, x¹²` together with `y, xy, …, x¹¹y`. -/
def sdTF5 (E : WeierstrassCurve R) : (Fin 13 ⊕ Fin 12) → Affine.FunctionField E :=
  Sum.elim (fun i : Fin 13 => (Work.MotV.genX E) ^ (i : ℕ))
    (fun j : Fin 12 => (Work.MotV.genX E) ^ (j : ℕ) * Work.MotV.genY E)

@[simp] theorem sdTF5_inl (E : WeierstrassCurve R) (i : Fin 13) :
    sdTF5 E (Sum.inl i) = (Work.MotV.genX E) ^ (i : ℕ) := rfl

@[simp] theorem sdTF5_inr (E : WeierstrassCurve R) (j : Fin 12) :
    sdTF5 E (Sum.inr j) = (Work.MotV.genX E) ^ (j : ℕ) * Work.MotV.genY E := rfl

/-- The 30 monomials of `L(30·O)`: `1, x, …, x¹⁵` together with `y, xy, …, x¹³y`. -/
def sdTF6 (E : WeierstrassCurve R) : (Fin 16 ⊕ Fin 14) → Affine.FunctionField E :=
  Sum.elim (fun i : Fin 16 => (Work.MotV.genX E) ^ (i : ℕ))
    (fun j : Fin 14 => (Work.MotV.genX E) ^ (j : ℕ) * Work.MotV.genY E)

@[simp] theorem sdTF6_inl (E : WeierstrassCurve R) (i : Fin 16) :
    sdTF6 E (Sum.inl i) = (Work.MotV.genX E) ^ (i : ℕ) := rfl

@[simp] theorem sdTF6_inr (E : WeierstrassCurve R) (j : Fin 14) :
    sdTF6 E (Sum.inr j) = (Work.MotV.genX E) ^ (j : ℕ) * Work.MotV.genY E := rfl

end

end Work.MotK.TwRuling
