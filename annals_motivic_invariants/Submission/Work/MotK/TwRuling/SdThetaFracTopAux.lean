/-!
# Auxiliary lemmas for `Work.MotK.TwRuling.SdThetaFracTop_charNeTwo`

`A := sdA K D h = RatFunc ↥(twistFieldTG K D h)`, and `T` is the subfield of `A` generated by the
image of the ruling algebra `sdR K D h = K[sdPhi 0, sdPhi 1, sdPhi 2]`.  This file collects the
memberships (`sdY`, `sdRuleA/B`, and `RatFunc.X` via the rank-two input) needed for the final
proof.
-/

namespace Work.MotK.TwRuling

open MvPolynomial

/-! ## §1 Naturality of the twisted ruling data -/

/-- Naturality of the twisted bilinear form `kleinTwBilin`. -/
theorem kleinTwBilin_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (a b h : R)
    (u v : Fin 5 → R) :
    Work.MotK.kleinTwBilin (φ a) (φ b) (φ h) (fun i => φ (u i)) (fun i => φ (v i))
      = φ (Work.MotK.kleinTwBilin a b h u v) := by
  simp only [Work.MotK.kleinTwBilin, Work.MotK.kleinTwQ, Work.MotK.kleinTwP0, map_sub, map_add,
    map_mul, map_pow, map_neg, Pi.add_apply]

/-- Naturality of the tangent vector `kleinTwTan`. -/
theorem kleinTwTan_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (a b h : R)
    (c : Fin 5 → R) (k : Fin 5) :
    Work.MotK.kleinTwTan (φ a) (φ b) (φ h) (fun i => φ (c i)) k
      = fun i => φ (Work.MotK.kleinTwTan a b h c k i) := by
  have hE' : ∀ l : Fin 5, ∀ j : Fin 5,
      (Work.MotK.kleinE l : Fin 5 → S) j = φ ((Work.MotK.kleinE l : Fin 5 → R) j) := by
    intro l j
    simp only [Work.MotK.kleinE, Pi.single_apply]
    split_ifs <;> simp
  funext i
  have h1 : Work.MotK.kleinTwBilin (φ a) (φ b) (φ h) (fun i => φ (c i))
        (Work.MotK.kleinE k : Fin 5 → S)
      = φ (Work.MotK.kleinTwBilin a b h c (Work.MotK.kleinE k)) := by
    rw [← funext (fun j => (hE' k j).symm)]
    exact kleinTwBilin_map φ a b h c (Work.MotK.kleinE k)
  have h2 : Work.MotK.kleinTwBilin (φ a) (φ b) (φ h) (fun i => φ (c i))
        (Work.MotK.kleinE 0 : Fin 5 → S)
      = φ (Work.MotK.kleinTwBilin a b h c (Work.MotK.kleinE 0)) := by
    rw [← funext (fun j => (hE' 0 j).symm)]
    exact kleinTwBilin_map φ a b h c (Work.MotK.kleinE 0)
  simp only [Work.MotK.kleinTwTan]
  rw [h1, h2, map_sub, map_mul, map_mul, hE' 0 i, hE' k i]

/-- Naturality of the first ruling vector `kleinTwRuleA`. -/
theorem kleinTwRuleA_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (a b h : R)
    (c : Fin 5 → R) :
    Work.MotK.kleinTwRuleA (φ a) (φ b) (φ h) (fun i => φ (c i))
      = fun i => φ (Work.MotK.kleinTwRuleA a b h c i) := by
  funext i
  simp only [Work.MotK.kleinTwRuleA]
  rw [kleinTwTan_map, ← Work.MotK.kleinTwPolarP_map_apply]

/-- Naturality of the second ruling vector `kleinTwRuleB`. -/
theorem kleinTwRuleB_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (a b h : R)
    (c : Fin 5 → R) :
    Work.MotK.kleinTwRuleB (φ a) (φ b) (φ h) (fun i => φ (c i))
      = fun i => φ (Work.MotK.kleinTwRuleB a b h c i) := by
  funext i
  simp only [Work.MotK.kleinTwRuleB]
  rw [kleinTwTan_map, ← Work.MotK.kleinTwPolarP_map_apply]

/-! ## §2 Membership in a subfield -/

/-- The inverse cubic map `kleinTwR` evaluated at elements of a subfield stays in that subfield. -/
theorem kleinTwR_mem {A : Type*} [Field A] (S : Subfield A) (a b h : A) (c : Fin 5 → A)
    (ha : a ∈ S) (hb : b ∈ S) (hh : h ∈ S) (hc : ∀ i, c i ∈ S) (k : Fin 5) :
    Work.MotK.kleinTwR a b h c k ∈ S := by
  have hmain := congrFun (Work.MotK.KleinTwRMap S.subtype (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S)
    (⟨h, hh⟩ : ↥S) (fun i => (⟨c i, hc i⟩ : ↥S))) k
  have h' : S.subtype (Work.MotK.kleinTwR (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S) (⟨h, hh⟩ : ↥S)
      (fun i => (⟨c i, hc i⟩ : ↥S)) k) = Work.MotK.kleinTwR a b h c k := hmain
  rw [← h']
  exact ((Work.MotK.kleinTwR (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S) (⟨h, hh⟩ : ↥S)
    (fun i => (⟨c i, hc i⟩ : ↥S)) k) : ↥S).2

/-- The first ruling vector evaluated at elements of a subfield stays in that subfield. -/
theorem kleinTwRuleA_mem {A : Type*} [Field A] (S : Subfield A) (a b h : A) (c : Fin 5 → A)
    (ha : a ∈ S) (hb : b ∈ S) (hh : h ∈ S) (hc : ∀ i, c i ∈ S) (k : Fin 5) :
    Work.MotK.kleinTwRuleA a b h c k ∈ S := by
  have hmain := congrFun (kleinTwRuleA_map S.subtype (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S)
    (⟨h, hh⟩ : ↥S) (fun i => (⟨c i, hc i⟩ : ↥S))) k
  have h' : Work.MotK.kleinTwRuleA a b h c k
      = S.subtype (Work.MotK.kleinTwRuleA (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S) (⟨h, hh⟩ : ↥S)
        (fun i => (⟨c i, hc i⟩ : ↥S)) k) := hmain
  rw [h']
  exact ((Work.MotK.kleinTwRuleA (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S) (⟨h, hh⟩ : ↥S)
    (fun i => (⟨c i, hc i⟩ : ↥S)) k) : ↥S).2

/-- The second ruling vector evaluated at elements of a subfield stays in that subfield. -/
theorem kleinTwRuleB_mem {A : Type*} [Field A] (S : Subfield A) (a b h : A) (c : Fin 5 → A)
    (ha : a ∈ S) (hb : b ∈ S) (hh : h ∈ S) (hc : ∀ i, c i ∈ S) (k : Fin 5) :
    Work.MotK.kleinTwRuleB a b h c k ∈ S := by
  have hmain := congrFun (kleinTwRuleB_map S.subtype (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S)
    (⟨h, hh⟩ : ↥S) (fun i => (⟨c i, hc i⟩ : ↥S))) k
  have h' : Work.MotK.kleinTwRuleB a b h c k
      = S.subtype (Work.MotK.kleinTwRuleB (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S) (⟨h, hh⟩ : ↥S)
        (fun i => (⟨c i, hc i⟩ : ↥S)) k) := hmain
  rw [h']
  exact ((Work.MotK.kleinTwRuleB (⟨a, ha⟩ : ↥S) (⟨b, hb⟩ : ↥S) (⟨h, hh⟩ : ↥S)
    (fun i => (⟨c i, hc i⟩ : ↥S)) k) : ↥S).2

/-! ## §3 The subfield generated by the ruling presentation -/

/-- The chart coordinates lie in the generated subfield. -/
theorem sdPhi_mem (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) (j : Fin 3) :
    Work.MotK.TGen.sdPhi K D h j ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h)
        (Work.MotK.TGen.sdA K D h))) := by
  refine Subfield.subset_closure ⟨⟨Work.MotK.TGen.sdPhi K D h j, ?_⟩, rfl⟩
  exact Algebra.subset_adjoin (Set.mem_range_self j)

/-- The constants lie in the generated subfield. -/
theorem algebraMap_K_mem (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) (k : K) :
    algebraMap K (Work.MotK.TGen.sdA K D h) k ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h)
        (Work.MotK.TGen.sdA K D h))) := by
  refine Subfield.subset_closure ⟨algebraMap K ↥(Work.MotK.TGen.sdR K D h) k, ?_⟩
  exact (IsScalarTower.algebraMap_apply K ↥(Work.MotK.TGen.sdR K D h)
    (Work.MotK.TGen.sdA K D h) k).symm

/-- The twisted Klein coordinates lie in the generated subfield. -/
theorem sdY_mem (K : Type) [Field K] (h2 : (2 : K) ≠ 0) (D : Work.MotV.KleinData K)
    (hD : D.Good) (h : K) (hh : h ≠ 0) (i : Fin 5) :
    Work.MotK.TGen.sdY K D h i ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h)
        (Work.MotK.TGen.sdA K D h))) := by
  set A := Work.MotK.TGen.sdA K D h with hA
  set T : Subfield A := Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    with hT
  have hKm : ∀ k : K, algebraMap K A k ∈ T := by
    intro k; rw [hT]; exact algebraMap_K_mem K D h k
  have hphi : ∀ j : Fin 3, Work.MotK.TGen.sdPhi K D h j ∈ T := by
    intro j; rw [hT]; exact sdPhi_mem K D h j
  have hW4 : Work.MotK.TGen.sdW K D h 4 ≠ 0 := sdW_four_ne_zero K D hD h hh
  have hRne : Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h)
      (Work.MotK.TGen.sdW K D h) ≠ 0 := sdW_kleinTwR_ne_zero_charNeTwo K h2 D hD h hh
  have hRu : ∀ k : Fin 5, Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b)
        (algebraMap K A h) (Work.MotK.TGen.sdW K D h) k
      = Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h)
        (Work.MotK.TGen.sdW K D h) 0 * Work.MotK.TGen.sdY K D h k :=
    fun k => sdW_kleinTwR_eq K D hD h hh k
  have hR0 : Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h)
      (Work.MotK.TGen.sdW K D h) 0 ≠ 0 := by
    intro h0
    refine hRne ?_
    funext k
    rw [hRu k, h0, zero_mul, Pi.zero_apply]
  set v : Fin 5 → A := ![0, Work.MotK.TGen.sdPhi K D h 0, Work.MotK.TGen.sdPhi K D h 1,
    Work.MotK.TGen.sdPhi K D h 2, 1] with hv
  have hW0 : Work.MotK.TGen.sdW K D h 0 = 0 := by
    simp only [Work.MotK.TGen.sdW, Work.MotK.TGen.sdRuleA, Work.MotK.TGen.sdRuleB]
    rw [kleinTwRuleA_zero, kleinTwRuleB_zero]
    refl_ring1
  have hv1 : v 1 = Work.MotK.TGen.sdW K D h 1 / Work.MotK.TGen.sdW K D h 4 := by
    rw [hv]
    show Work.MotK.TGen.sdPhi K D h 0
      = Work.MotK.TGen.sdW K D h 1 / Work.MotK.TGen.sdW K D h 4
    rw [Work.MotK.TGen.sdPhi]
    rfl
  have hv2 : v 2 = Work.MotK.TGen.sdW K D h 2 / Work.MotK.TGen.sdW K D h 4 := by
    rw [hv]
    show Work.MotK.TGen.sdPhi K D h 1
      = Work.MotK.TGen.sdW K D h 2 / Work.MotK.TGen.sdW K D h 4
    rw [Work.MotK.TGen.sdPhi]
    rfl
  have hv3 : v 3 = Work.MotK.TGen.sdW K D h 3 / Work.MotK.TGen.sdW K D h 4 := by
    rw [hv]
    show Work.MotK.TGen.sdPhi K D h 2
      = Work.MotK.TGen.sdW K D h 3 / Work.MotK.TGen.sdW K D h 4
    rw [Work.MotK.TGen.sdPhi]
    rfl
  have hv4 : v 4 = 1 := by
    rw [hv]; simp
  have hWv : Work.MotK.TGen.sdW K D h = fun k => Work.MotK.TGen.sdW K D h 4 * v k := by
    funext k
    fin_cases k
    · show Work.MotK.TGen.sdW K D h 0 = Work.MotK.TGen.sdW K D h 4 * v 0
      rw [hW0, hv]; simp
    · show Work.MotK.TGen.sdW K D h 1 = Work.MotK.TGen.sdW K D h 4 * v 1
      rw [hv1]
      field_simp
    · show Work.MotK.TGen.sdW K D h 2 = Work.MotK.TGen.sdW K D h 4 * v 2
      rw [hv2]
      field_simp
    · show Work.MotK.TGen.sdW K D h 3 = Work.MotK.TGen.sdW K D h 4 * v 3
      rw [hv3]
      field_simp
    · show Work.MotK.TGen.sdW K D h 4 = Work.MotK.TGen.sdW K D h 4 * v 4
      rw [hv4, mul_one]
  have hhom : ∀ k : Fin 5, Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b)
        (algebraMap K A h) (Work.MotK.TGen.sdW K D h) k
      = (Work.MotK.TGen.sdW K D h 4) ^ 3 * Work.MotK.kleinTwR (algebraMap K A D.a)
        (algebraMap K A D.b) (algebraMap K A h) v k := by
    intro k
    have := congrFun (Work.MotK.kleinTwR_homog (algebraMap K A D.a) (algebraMap K A D.b)
      (algebraMap K A h) (Work.MotK.TGen.sdW K D h 4) v) k
    rw [← hWv] at this
    exact this
  have hvmem : ∀ k : Fin 5, Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b)
      (algebraMap K A h) v k ∈ T := by
    intro k
    refine kleinTwR_mem T _ _ _ v ?_ ?_ ?_ ?_ k
    · exact hKm D.a
    · exact hKm D.b
    · exact hKm h
    · intro j
      rw [hv]
      fin_cases j
      · simp
      · simpa using hphi 0
      · simpa using hphi 1
      · simpa using hphi 2
      · simp
  have hv0 : Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h)
      v 0 ≠ 0 := by
    intro h0
    exact hR0 (by rw [hhom 0, h0, mul_zero])
  have hYeq : Work.MotK.TGen.sdY K D h i
      = Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h)
          (Work.MotK.TGen.sdW K D h) i
        / Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h)
          (Work.MotK.TGen.sdW K D h) 0 := by
    rw [eq_div_iff hR0, hRu i]
    refl_ring1
  rw [hT, hYeq, hhom i, hhom 0]
  have h3 : (Work.MotK.TGen.sdW K D h 4) ^ 3 ≠ 0 := pow_ne_zero _ hW4
  have hcancel : ((Work.MotK.TGen.sdW K D h 4) ^ 3
        * Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h) v i)
      / ((Work.MotK.TGen.sdW K D h 4) ^ 3
        * Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h) v 0)
      = Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h) v i
        / Work.MotK.kleinTwR (algebraMap K A D.a) (algebraMap K A D.b) (algebraMap K A h) v 0 := by
    rw [div_eq_div_iff (mul_ne_zero h3 hv0) hv0]
    refl_ring1
  rw [hcancel]
  exact T.div_mem (hvmem i) (hvmem 0)

/-- `sdW k / sdW 4` lies in the generated subfield for `k ≠ 0`. -/
theorem psi_mem (K : Type) [Field K] (D : Work.MotV.KleinData K) (hD : D.Good) (h : K)
    (hh : h ≠ 0) (k : Fin 5) (hk : k ≠ 0) :
    Work.MotK.TGen.sdW K D h k / Work.MotK.TGen.sdW K D h 4 ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h)
        (Work.MotK.TGen.sdA K D h))) := by
  set A := Work.MotK.TGen.sdA K D h with hA
  set T : Subfield A := Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    with hT
  have hphi : ∀ j : Fin 3, Work.MotK.TGen.sdPhi K D h j ∈ T := by
    intro j; rw [hT]; exact sdPhi_mem K D h j
  have hW4 : Work.MotK.TGen.sdW K D h 4 ≠ 0 := sdW_four_ne_zero K D hD h hh
  rw [hT]
  fin_cases k
  · exact absurd rfl hk
  · show Work.MotK.TGen.sdW K D h 1 / Work.MotK.TGen.sdW K D h 4 ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    have h1 : Work.MotK.TGen.sdPhi K D h 0
        = Work.MotK.TGen.sdW K D h 1 / Work.MotK.TGen.sdW K D h 4 := by
      rw [Work.MotK.TGen.sdPhi]; rfl
    rw [← h1]; exact hphi 0
  · show Work.MotK.TGen.sdW K D h 2 / Work.MotK.TGen.sdW K D h 4 ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    have h1 : Work.MotK.TGen.sdPhi K D h 1
        = Work.MotK.TGen.sdW K D h 2 / Work.MotK.TGen.sdW K D h 4 := by
      rw [Work.MotK.TGen.sdPhi]; rfl
    rw [← h1]; exact hphi 1
  · show Work.MotK.TGen.sdW K D h 3 / Work.MotK.TGen.sdW K D h 4 ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    have h1 : Work.MotK.TGen.sdPhi K D h 2
        = Work.MotK.TGen.sdW K D h 3 / Work.MotK.TGen.sdW K D h 4 := by
      rw [Work.MotK.TGen.sdPhi]; rfl
    rw [← h1]; exact hphi 2
  · show Work.MotK.TGen.sdW K D h 4 / Work.MotK.TGen.sdW K D h 4 ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    rw [div_self hW4]
    exact Subfield.one_mem _

/-- `RatFunc.X` lies in the generated subfield (this is the content of `sdRuleRankTwo`). -/
theorem ratFunc_X_mem (K : Type) [Field K] (h2 : (2 : K) ≠ 0) (D : Work.MotV.KleinData K)
    (hD : D.Good) (h : K) (hh : h ≠ 0) :
    (RatFunc.X : Work.MotK.TGen.sdA K D h) ∈
      Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h)
        (Work.MotK.TGen.sdA K D h))) := by
  set A := Work.MotK.TGen.sdA K D h with hA
  set T : Subfield A := Subfield.closure (Set.range (algebraMap (Work.MotK.TGen.sdR K D h) A))
    with hT
  have hKm : ∀ k : K, algebraMap K A k ∈ T := by
    intro k; rw [hT]; exact algebraMap_K_mem K D h k
  have hpsi : ∀ k : Fin 5, k ≠ 0 →
      Work.MotK.TGen.sdW K D h k / Work.MotK.TGen.sdW K D h 4 ∈ T := by
    intro k hk; rw [hT]; exact psi_mem K D hD h hh k hk
  have hY : ∀ j : Fin 5, Work.MotK.TGen.sdY K D h j ∈ T := by
    intro j; rw [hT]; exact sdY_mem K h2 D hD h hh j
  have hA_mem : ∀ i : Fin 5, Work.MotK.TGen.sdRuleA K D h i ∈ T := fun i =>
    kleinTwRuleA_mem T _ _ _ _ (hKm D.a) (hKm D.b) (hKm h) hY i
  have hB_mem : ∀ i : Fin 5, Work.MotK.TGen.sdRuleB K D h i ∈ T := fun i =>
    kleinTwRuleB_mem T _ _ _ _ (hKm D.a) (hKm D.b) (hKm h) hY i
  have hA0 : Work.MotK.TGen.sdRuleA K D h 0 = 0 := by
    simp only [Work.MotK.TGen.sdRuleA]; exact kleinTwRuleA_zero _ _ _ _
  have hB0 : Work.MotK.TGen.sdRuleB K D h 0 = 0 := by
    simp only [Work.MotK.TGen.sdRuleB]; exact kleinTwRuleB_zero _ _ _ _
  obtain ⟨i, j, hij⟩ := sdRuleRankTwo K h2 D hD h hh
  have hi : i ≠ 0 := by
    rintro rfl
    exact hij (by rw [hA0, hB0, zero_mul, mul_zero])
  have hj : j ≠ 0 := by
    rintro rfl
    exact hij (by rw [hA0, hB0, zero_mul, mul_zero])
  set ψ : Fin 5 → A := fun k => Work.MotK.TGen.sdW K D h k / Work.MotK.TGen.sdW K D h 4
    with hψdef
  have hEq : ψ j * Work.MotK.TGen.sdW K D h i - ψ i * Work.MotK.TGen.sdW K D h j = 0 := by
    simp only [hψdef]
    field_simp
    first | refl_ring1 | ring
  have hEq' : (ψ j * (Work.MotK.TGen.sdRuleA K D h i
        + (RatFunc.X : A) * Work.MotK.TGen.sdRuleB K D h i)
      - ψ i * (Work.MotK.TGen.sdRuleA K D h j
        + (RatFunc.X : A) * Work.MotK.TGen.sdRuleB K D h j)) = 0 := by
    simpa only [Work.MotK.TGen.sdW] using hEq
  have hdenmem : ψ j * Work.MotK.TGen.sdRuleB K D h i
      - ψ i * Work.MotK.TGen.sdRuleB K D h j ∈ T :=
    T.sub_mem (T.mul_mem (hpsi j hj) (hB_mem i)) (T.mul_mem (hpsi i hi) (hB_mem j))
  have hden : ψ j * Work.MotK.TGen.sdRuleB K D h i
      - ψ i * Work.MotK.TGen.sdRuleB K D h j ≠ 0 := by
    intro h0
    apply hij
    have hW4 : Work.MotK.TGen.sdW K D h 4 ≠ 0 := sdW_four_ne_zero K D hD h hh
    have hψj : ψ j * Work.MotK.TGen.sdW K D h 4 = Work.MotK.TGen.sdW K D h j := by
      simp only [hψdef]
      exact div_mul_cancel₀ _ hW4
    have hψi : ψ i * Work.MotK.TGen.sdW K D h 4 = Work.MotK.TGen.sdW K D h i := by
      simp only [hψdef]
      exact div_mul_cancel₀ _ hW4
    have h2 : (ψ j * Work.MotK.TGen.sdRuleB K D h i
          - ψ i * Work.MotK.TGen.sdRuleB K D h j) * Work.MotK.TGen.sdW K D h 4
        = Work.MotK.TGen.sdW K D h j * Work.MotK.TGen.sdRuleB K D h i
          - Work.MotK.TGen.sdW K D h i * Work.MotK.TGen.sdRuleB K D h j := by
      rw [show (ψ j * Work.MotK.TGen.sdRuleB K D h i
              - ψ i * Work.MotK.TGen.sdRuleB K D h j) * Work.MotK.TGen.sdW K D h 4
            = ψ j * Work.MotK.TGen.sdW K D h 4 * Work.MotK.TGen.sdRuleB K D h i
              - ψ i * Work.MotK.TGen.sdW K D h 4 * Work.MotK.TGen.sdRuleB K D h j
            from by ring]
      rw [hψj, hψi]
    have h3 : Work.MotK.TGen.sdW K D h j * Work.MotK.TGen.sdRuleB K D h i
          - Work.MotK.TGen.sdW K D h i * Work.MotK.TGen.sdRuleB K D h j
        = Work.MotK.TGen.sdRuleA K D h j * Work.MotK.TGen.sdRuleB K D h i
          - Work.MotK.TGen.sdRuleA K D h i * Work.MotK.TGen.sdRuleB K D h j := by
      simp only [Work.MotK.TGen.sdW]
      refl_ring1
    have h4 : Work.MotK.TGen.sdRuleA K D h j * Work.MotK.TGen.sdRuleB K D h i
        - Work.MotK.TGen.sdRuleA K D h i * Work.MotK.TGen.sdRuleB K D h j = 0 := by
      rw [← h3, ← h2, h0, zero_mul]
    exact (sub_eq_zero.mp h4).symm
  have ht_eq : (RatFunc.X : A) = -(ψ j * Work.MotK.TGen.sdRuleA K D h i
        - ψ i * Work.MotK.TGen.sdRuleA K D h j)
      / (ψ j * Work.MotK.TGen.sdRuleB K D h i
        - ψ i * Work.MotK.TGen.sdRuleB K D h j) := by
    rw [eq_div_iff hden]
    linear_combination (norm := refl_ring1) hEq'
  rw [ht_eq]
  exact T.div_mem
    (T.neg_mem (T.sub_mem (T.mul_mem (hpsi j hj) (hA_mem i))
      (T.mul_mem (hpsi i hi) (hA_mem j)))) hdenmem

/-- The image of the twist field `F₁` in `A = RatFunc ↥F₁` is the subfield generated by the
constants `K` and the twisted coordinates `sdY`. -/
theorem range_algebraMap_subset (K : Type) [Field K] (D : Work.MotV.KleinData K) (h : K) :
    Set.range (algebraMap ↥(Work.MotK.twistFieldTG K D h) (Work.MotK.TGen.sdA K D h))
      ⊆ ↑(Subfield.closure (Set.range (algebraMap K (Work.MotK.TGen.sdA K D h))
          ∪ Set.range (Work.MotK.TGen.sdY K D h))) := by
  set F := Work.MotK.twistFieldTG K D h with hF
  set A := Work.MotK.TGen.sdA K D h with hA
  set S : Subfield A := Subfield.closure (Set.range (algebraMap K A)
    ∪ Set.range (Work.MotK.TGen.sdY K D h)) with hS
  have aeval_mem : ∀ r : MvPolynomial (Set.range (Work.MotK.twCoordG K D h)) K,
      (MvPolynomial.aeval Subtype.val r : Work.MotK.OmG K D) ∈ F := by
    intro r
    induction r using MvPolynomial.induction_on with
    | C k =>
      rw [MvPolynomial.aeval_C]
      exact F.algebraMap_mem k
    | add p q hp hq => rw [map_add]; exact F.add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul, MvPolynomial.aeval_X]
      exact F.mul_mem hp (IntermediateField.subset_adjoin K _ i.2)
  have key : ∀ r : MvPolynomial (Set.range (Work.MotK.twCoordG K D h)) K,
      algebraMap ↥F A (⟨MvPolynomial.aeval Subtype.val r, aeval_mem r⟩ : ↥F) ∈ S := by
    intro r
    induction r using MvPolynomial.induction_on with
    | C k =>
      have h1 : (⟨MvPolynomial.aeval Subtype.val (MvPolynomial.C k), aeval_mem _⟩ : ↥F)
          = algebraMap K ↥F k := by
        refine Subtype.ext ?_
        show (MvPolynomial.aeval Subtype.val (MvPolynomial.C k) : Work.MotK.OmG K D)
          = ↑(algebraMap K ↥F k)
        rw [MvPolynomial.aeval_C,
          IsScalarTower.algebraMap_apply K ↥F (Work.MotK.OmG K D)]
        rfl
      rw [h1, ← IsScalarTower.algebraMap_apply K ↥F A]
      exact Subfield.subset_closure (Or.inl ⟨k, rfl⟩)
    | add p q hp hq =>
      have h1 : (⟨MvPolynomial.aeval Subtype.val (p + q), aeval_mem _⟩ : ↥F)
          = (⟨MvPolynomial.aeval Subtype.val p, aeval_mem p⟩ : ↥F)
            + ⟨MvPolynomial.aeval Subtype.val q, aeval_mem q⟩ := by
        apply Subtype.ext
        simp only [Subtype.coe_mk, AddSubmonoid.coe_add, AddMemClass.coe_add, map_add]
      rw [h1, map_add]
      exact S.add_mem hp hq
    | mul_X p i hp =>
      have h1 : (⟨MvPolynomial.aeval Subtype.val (p * MvPolynomial.X i), aeval_mem _⟩ : ↥F)
          = (⟨MvPolynomial.aeval Subtype.val p, aeval_mem p⟩ : ↥F)
            * ⟨(i.1 : Work.MotK.OmG K D), IntermediateField.subset_adjoin K _ i.2⟩ := by
        apply Subtype.ext
        simp only [Subtype.coe_mk, Submonoid.coe_mul, MulMemClass.coe_mul, map_mul,
          MvPolynomial.aeval_X]
      rw [h1, map_mul]
      refine S.mul_mem hp ?_
      obtain ⟨j, hj⟩ := i.2
      have h2 : (⟨(i.1 : Work.MotK.OmG K D),
            IntermediateField.subset_adjoin K _ i.2⟩ : ↥F)
          = ⟨Work.MotK.twCoordG K D h j,
              IntermediateField.subset_adjoin K _ (Set.mem_range_self j)⟩ := by
        apply Subtype.ext
        exact hj.symm
      rw [h2]
      exact Subfield.subset_closure (Or.inr ⟨j, rfl⟩)
  rintro y ⟨a, rfl⟩
  have ha : a.1 ∈ IntermediateField.adjoin K (Set.range (Work.MotK.twCoordG K D h)) := a.2
  rw [IntermediateField.mem_adjoin_iff] at ha
  obtain ⟨r, s, hrs⟩ := ha
  have ha_eq : a = (⟨MvPolynomial.aeval Subtype.val r, aeval_mem r⟩ : ↥F)
      / (⟨MvPolynomial.aeval Subtype.val s, aeval_mem s⟩ : ↥F) := by
    apply Subtype.ext
    show a.1 = _
    rw [hrs]
    rfl
  rw [ha_eq, map_div₀]
  exact S.div_mem (key r) (key s)

end Work.MotK.TwRuling
