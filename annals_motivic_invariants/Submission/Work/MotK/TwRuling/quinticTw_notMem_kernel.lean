/-!
# `Work.MotK.TwRuling.quinticTw_notMem_kernel`

`κ : Fin 5 → R(E)` spans the same `R`-subspace as the basis `sdBas E = ![1, x, y, x², xy]` of
`L(5·O)` and satisfies the five twisted Klein (Pfaffian) relations.  Then the evaluation map
`F ↦ F(κ)` is injective on the quintics modulo the degree-5 part `J` of the ideal generated by the
five Pfaffians.

The proof is the dimension count: `Hom₅` has dimension 126; the image of the evaluation map on
`Hom₅` is the span of the 25 fivefold products of `κ`, i.e. `span(sdTF5)` (dimension 25, by
`Work.MotK.TwRuling.sdTF5Span` plus the product-span transfer) — so the kernel has dimension 101;
and `J ⊆ Hom₅ ⊓ ker` (by `Work.MotK.TwRuling.twIdeal_le_homogeneous` and the Pfaffian relations)
with `101 ≤ dim J` (by `Work.MotK.TwRuling.twIdealFiveLower`), so `J = Hom₅ ⊓ ker`.
-/

set_option maxHeartbeats 1000000

namespace Work.MotK.TwRuling

open WeierstrassCurve WeierstrassCurve.Affine

/-! ## Abbreviations -/

/-- The degree-5 graded piece of `MvPolynomial (Fin 5) R`. -/
noncomputable def hom5 (R : Type) [Field R] : Submodule R (MvPolynomial (Fin 5) R) :=
  MvPolynomial.homogeneousSubmodule (Fin 5) R 5

/-- The degree-5 part of the ideal generated by the five twisted Pfaffians. -/
noncomputable def twIdeal5 (R : Type) [Field R] (a b h : R) : Submodule R (MvPolynomial (Fin 5) R) :=
  Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 3} =>
      Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
        (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1))

/-! ## The span of `n`-fold products -/

noncomputable def prodSpanN (R : Type) [CommSemiring R] {A : Type*} [CommSemiring A] [Algebra R A]
    {ι : Type*} (f : ι → A) (n : ℕ) : Submodule R A :=
  Submodule.span R (Set.range (fun p : Fin n → ι => ∏ i, f (p i)))

noncomputable def prodSpanNest (R : Type) [CommSemiring R] {A : Type*} [CommSemiring A]
    [Algebra R A] (f : Fin 5 → A) : Submodule R A :=
  Submodule.span R (Set.range (fun p : Fin 5 × Fin 5 × Fin 5 × Fin 5 × Fin 5 =>
    f p.1 * f p.2.1 * f p.2.2.1 * f p.2.2.2.1 * f p.2.2.2.2))

/-- If every `f i` lies in the span of `g`, then the span of the `n`-fold products of `f` is
contained in the span of the `n`-fold products of `g`. -/
lemma prodSpanN_le (R : Type) [Field R] {A : Type*} [CommSemiring A] [Algebra R A]
    {ι : Type*} {f g : ι → A} (n : ℕ) (h : ∀ i, f i ∈ Submodule.span R (Set.range g)) :
    prodSpanN R f n ≤ prodSpanN R g n := by
  induction n with
  | zero =>
    change Submodule.span R (Set.range (fun p : Fin 0 → ι => ∏ i, f (p i))) ≤
      Submodule.span R (Set.range (fun p : Fin 0 → ι => ∏ i, g (p i)))
    rw [Submodule.span_le]
    rintro _ ⟨p, rfl⟩
    change (∏ i : Fin 0, f (p i)) ∈
      Submodule.span R (Set.range (fun p : Fin 0 → ι => ∏ i, g (p i)))
    rw [Fin.prod_univ_zero]
    exact Submodule.subset_span ⟨p, by
      change (∏ i : Fin 0, g (p i)) = 1
      rw [Fin.prod_univ_zero]⟩
  | succ n ih =>
    change Submodule.span R (Set.range (fun p : Fin (n + 1) → ι => ∏ i, f (p i))) ≤
      Submodule.span R (Set.range (fun p : Fin (n + 1) → ι => ∏ i, g (p i)))
    rw [Submodule.span_le]
    rintro _ ⟨p, rfl⟩
    change (∏ i : Fin (n + 1), f (p i)) ∈
      Submodule.span R (Set.range (fun p : Fin (n + 1) → ι => ∏ i, g (p i)))
    rw [Fin.prod_univ_succ]
    have hx : (∏ i : Fin n, f (p i.succ)) ∈ prodSpanN R g n :=
      ih (Submodule.subset_span (Set.mem_range_self (fun i : Fin n => p i.succ)))
    have hy : f (p 0) ∈ Submodule.span R (Set.range g) := h _
    have hmul : f (p 0) * (∏ i : Fin n, f (p i.succ))
        ∈ Submodule.span R (Set.range g) * prodSpanN R g n := Submodule.mul_mem_mul hy hx
    simp only [prodSpanN] at hmul
    rw [Submodule.span_mul_span] at hmul
    refine (Submodule.span_le.mpr ?_) hmul
    rintro _ ⟨_, ⟨j, rfl⟩, _, ⟨q, rfl⟩, rfl⟩
    change g j * (∏ i : Fin n, g (q i)) ∈
      Submodule.span R (Set.range (fun p : Fin (n + 1) → ι => ∏ i, g (p i)))
    exact Submodule.subset_span ⟨(Fin.cons j q : Fin (n + 1) → ι), by
      change (∏ i : Fin (n + 1), g ((Fin.cons j q : Fin (n + 1) → ι) i)) = g j * ∏ i : Fin n, g (q i)
      rw [Fin.prod_univ_succ]
      simp [Fin.cons_zero, Fin.cons_succ]⟩

/-- The tuple-indexed and the nested-tuple-indexed spans of 5-fold products agree. -/
lemma prodSpanN_eq_prodSpanNest (R : Type) [CommSemiring R] {A : Type*} [CommSemiring A]
    [Algebra R A] (f : Fin 5 → A) :
    prodSpanN R f 5 = prodSpanNest R f := by
  unfold prodSpanN prodSpanNest
  congr 1
  ext x
  constructor
  · rintro ⟨p, rfl⟩
    refine ⟨(p 0, p 1, p 2, p 3, p 4), ?_⟩
    simp [Fin.prod_univ_five]
  · rintro ⟨q, rfl⟩
    refine ⟨![q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2], ?_⟩
    simp [Fin.prod_univ_five, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.tail_cons]

/-- The span of the 25 monomials of `L(25·O)` has dimension 25. -/
lemma finrank_span_sdTF5 (R : Type) [Field R] (E : WeierstrassCurve R) :
    Module.finrank R ↥(Submodule.span R (Set.range (Work.MotK.TwRuling.sdTF5 E))) = 25 := by
  rw [finrank_span_eq_card (Work.MotK.TwRuling.sdTF5_linearIndependent R E)]
  simp

/-! ## The target -/

theorem quinticTw_notMem_kernel (R : Type) [Field R] (E : WeierstrassCurve R) (a b h : R)
    (hab : a * b ≠ 0) (hh : h ≠ 0)
    (κ : Fin 5 → WeierstrassCurve.Affine.FunctionField E)
    (hκmem : ∀ i, κ i ∈ Submodule.span R (Set.range (Work.MotK.TwRuling.sdBas E)))
    (hspans : ∀ m, Work.MotK.TwRuling.sdBas E m ∈ Submodule.span R (Set.range κ))
    (hκ : ∀ k : Fin 5, Work.MotK.kleinTwP (algebraMap R (WeierstrassCurve.Affine.FunctionField E) a)
      (algebraMap R (WeierstrassCurve.Affine.FunctionField E) b)
      (algebraMap R (WeierstrassCurve.Affine.FunctionField E) h) κ k = 0)
    (F : MvPolynomial (Fin 5) R) (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin 5) R 5)
    (hFnot : F ∉ Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 3} =>
        Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
          (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1))) :
    MvPolynomial.aeval κ F ≠ 0 := by
  obtain ⟨ha, hb⟩ := mul_ne_zero_iff.mp hab
  have hJH : twIdeal5 R a b h ≤ hom5 R := twIdeal_le_homogeneous R a b h
  -- naturality of `aeval` with respect to the twisted Pfaffians
  have hψnat : ∀ k : Fin 5, MvPolynomial.aeval κ
      (Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
        (fun i => MvPolynomial.X i) k)
      = Work.MotK.kleinTwP (algebraMap R (WeierstrassCurve.Affine.FunctionField E) a)
          (algebraMap R (WeierstrassCurve.Affine.FunctionField E) b)
          (algebraMap R (WeierstrassCurve.Affine.FunctionField E) h) κ k := by
    intro k
    fin_cases k <;>
      simp [Work.MotK.kleinTwP, Work.MotK.kleinTwP0, Work.MotK.kleinTwP1, Work.MotK.kleinTwP2,
        Work.MotK.kleinTwP3, Work.MotK.kleinTwP4, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.tail_cons]
  have hJker : twIdeal5 R a b h ≤ LinearMap.ker (MvPolynomial.aeval κ).toLinearMap := by
    rw [twIdeal5, Submodule.span_le]
    rintro y ⟨q, rfl⟩
    show (MvPolynomial.aeval κ).toLinearMap (Work.MotK.kleinTwP (MvPolynomial.C a)
      (MvPolynomial.C b) (MvPolynomial.C h) (fun i => MvPolynomial.X i) q.1 *
        MvPolynomial.monomial q.2.1 1) = 0
    show MvPolynomial.aeval κ (Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b)
        (MvPolynomial.C h) (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1) = 0
    rw [map_mul, hψnat q.1, hκ q.1, zero_mul]
  -- the restriction of `aeval κ` to the degree-5 part
  set Φ : ↥(hom5 R) →ₗ[R] WeierstrassCurve.Affine.FunctionField E :=
    (MvPolynomial.aeval κ).toLinearMap.comp (hom5 R).subtype with hΦ
  haveI : Module.Finite R ↥(hom5 R) :=
    Module.Finite.of_fg (MvPolynomial.homogeneousSubmodule_fg (Fin 5) R 5)
  haveI : Module.Finite R ↥(LinearMap.range Φ) := Module.Finite.range Φ
  haveI hκfin : Module.Finite R ↥(prodSpanN R κ 5) := by
    rw [prodSpanN]
    exact Module.Finite.span_of_finite R (Set.finite_range _)
  have hH5fin : Module.finrank R ↥(hom5 R) = 126 := finrank_homogeneous_five R
  -- the 25-dimensional space of 5-fold products of `κ` sits in the range
  have hsd : prodSpanN R (Work.MotK.TwRuling.sdBas E) 5
      = Submodule.span R (Set.range (Work.MotK.TwRuling.sdTF5 E)) := by
    rw [prodSpanN_eq_prodSpanNest]
    exact sdTF5Span R E
  have hprod : prodSpanN R (Work.MotK.TwRuling.sdBas E) 5 ≤ prodSpanN R κ 5 :=
    prodSpanN_le R 5 hspans
  have hrange : prodSpanN R κ 5 ≤ LinearMap.range Φ := by
    change Submodule.span R (Set.range (fun p : Fin 5 → Fin 5 => ∏ i, κ (p i)))
      ≤ LinearMap.range Φ
    rw [Submodule.span_le]
    rintro _ ⟨p, rfl⟩
    change (∏ i : Fin 5, κ (p i)) ∈ LinearMap.range Φ
    have hhom : (∏ i, MvPolynomial.X (p i)) ∈ hom5 R := by
      have h := MvPolynomial.IsHomogeneous.prod (Finset.univ : Finset (Fin 5))
        (fun i : Fin 5 => MvPolynomial.X (p i)) (fun _ => 1)
        (fun i _ => MvPolynomial.isHomogeneous_X R (p i))
      simpa [hom5] using h
    have hval : Φ ⟨∏ i, MvPolynomial.X (p i), hhom⟩ = ∏ i, κ (p i) := by
      show MvPolynomial.aeval κ (∏ i, MvPolynomial.X (p i)) = ∏ i, κ (p i)
      rw [map_prod]
      exact Finset.prod_congr rfl (fun i _ => MvPolynomial.aeval_X κ (p i))
    rw [← hval]
    exact LinearMap.mem_range_self Φ _
  have hge : 25 ≤ Module.finrank R ↥(LinearMap.range Φ) := by
    calc 25 = Module.finrank R ↥(Submodule.span R (Set.range (Work.MotK.TwRuling.sdTF5 E))) :=
          (finrank_span_sdTF5 R E).symm
      _ = Module.finrank R ↥(prodSpanN R (Work.MotK.TwRuling.sdBas E) 5) := by rw [hsd]
      _ ≤ Module.finrank R ↥(prodSpanN R κ 5) := Submodule.finrank_mono hprod
      _ ≤ Module.finrank R ↥(LinearMap.range Φ) := Submodule.finrank_mono hrange
  -- rank--nullity: the kernel has dimension at most 101
  have hker_le : Module.finrank R ↥(LinearMap.ker Φ) ≤ 101 := by
    have hrn := LinearMap.finrank_range_add_finrank_ker Φ
    omega
  -- `twIdeal5` sits between `ker Φ` and the top
  have hJh : Submodule.comap (hom5 R).subtype (twIdeal5 R a b h) ≤ LinearMap.ker Φ := by
    intro x hx
    show Φ x = 0
    show (MvPolynomial.aeval κ).toLinearMap (x : MvPolynomial (Fin 5) R) = 0
    exact hJker hx
  have hfinJh : Module.finrank R ↥(Submodule.comap (hom5 R).subtype (twIdeal5 R a b h))
      = Module.finrank R ↥(twIdeal5 R a b h) :=
    (Submodule.comapSubtypeEquivOfLe hJH).finrank_eq
  have hJhfin : 101 ≤ Module.finrank R ↥(Submodule.comap (hom5 R).subtype (twIdeal5 R a b h)) := by
    rw [hfinJh]
    exact twIdealFiveLower R a b h ha hb hh
  have hker_eq : Submodule.comap (hom5 R).subtype (twIdeal5 R a b h) = LinearMap.ker Φ :=
    Submodule.eq_of_le_of_finrank_le hJh (le_trans hker_le hJhfin)
  -- conclude
  intro hae
  have hFmem : (⟨F, hF⟩ : ↥(hom5 R)) ∈ LinearMap.ker Φ := by
    show Φ ⟨F, hF⟩ = 0
    show MvPolynomial.aeval κ F = 0
    exact hae
  exact hFnot (by
    have h := hFmem
    rw [← hker_eq] at h
    exact h)

end Work.MotK.TwRuling
