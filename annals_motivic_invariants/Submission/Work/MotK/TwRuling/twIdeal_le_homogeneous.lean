import Mathlib
import Submission.Work.MotK.KleinTwData

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

namespace Work.MotK.TwRuling

/-! Every generator `q k * monomial m' 1` of the degree-5 part `J` of the ideal generated by the
five twisted Pfaffians `kleinTwP (C a) (C b) (C h) (fun i => X i)` is a homogeneous polynomial of
degree 5 (each Pfaffian is a quadratic form, `m'` has degree 3), so the whole span `J` lies in the
degree-5 graded piece `homogeneousSubmodule (Fin 5) R 5` of `MvPolynomial (Fin 5) R`.

Route in `Submission/Work/MotK/TwRuling/GUIDE_twIdeal_le_homogeneous.md`. -/

set_option maxHeartbeats 800000

variable {R : Type*} [CommRing R]

/-- A homogeneous polynomial of degree `0` times two linear forms is homogeneous of degree `2`. -/
private lemma hom_zero_mul_XX (r : MvPolynomial (Fin 5) R) (hr : r.IsHomogeneous 0) (i j : Fin 5) :
    (r * MvPolynomial.X i * MvPolynomial.X j).IsHomogeneous 2 := by
  have := (hr.mul (MvPolynomial.isHomogeneous_X (R := R) i)).mul
    (MvPolynomial.isHomogeneous_X (R := R) j)
  simpa using this

/-- A homogeneous polynomial of degree `0` times a square of a linear form is homogeneous of
degree `2`. -/
private lemma hom_zero_mul_sq (r : MvPolynomial (Fin 5) R) (hr : r.IsHomogeneous 0) (i : Fin 5) :
    (r * MvPolynomial.X i ^ 2).IsHomogeneous 2 := by
  have := hr.mul ((MvPolynomial.isHomogeneous_X (R := R) i).pow 2)
  simpa using this

private lemma hom_negC (a b : R) :
    (-MvPolynomial.C a * MvPolynomial.C b : MvPolynomial (Fin 5) R).IsHomogeneous 0 :=
  ((MvPolynomial.isHomogeneous_C (σ := Fin 5) a).neg).mul
    (MvPolynomial.isHomogeneous_C (σ := Fin 5) b)

private lemma hom_Csq (a h : R) :
    (MvPolynomial.C a ^ 2 * MvPolynomial.C h : MvPolynomial (Fin 5) R).IsHomogeneous 0 :=
  (((MvPolynomial.isHomogeneous_C (σ := Fin 5) a).pow 2).mul
    (MvPolynomial.isHomogeneous_C (σ := Fin 5) h))

private lemma hom_Csq2 (a : R) :
    (MvPolynomial.C a ^ 2 : MvPolynomial (Fin 5) R).IsHomogeneous 0 :=
  ((MvPolynomial.isHomogeneous_C (σ := Fin 5) a).pow 2)

private lemma hom_negC_mul_C (a b h : R) :
    (-MvPolynomial.C a * MvPolynomial.C b * MvPolynomial.C h :
      MvPolynomial (Fin 5) R).IsHomogeneous 0 :=
  (hom_negC (R := R) a b).mul (MvPolynomial.isHomogeneous_C (σ := Fin 5) h)

private lemma hom_kleinTwP0 (a b h : R) :
    (Work.MotK.kleinTwP0 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i)).IsHomogeneous 2 := by
  have h1 := hom_zero_mul_sq (-MvPolynomial.C a * MvPolynomial.C b : MvPolynomial (Fin 5) R)
    (hom_negC a b) 0
  have h2 := hom_zero_mul_XX (MvPolynomial.C a ^ 2 * MvPolynomial.C h : MvPolynomial (Fin 5) R)
    (hom_Csq a h) 2 3
  have h3 := hom_zero_mul_XX (MvPolynomial.C b ^ 2 * MvPolynomial.C h : MvPolynomial (Fin 5) R)
    (hom_Csq b h) 1 4
  simp only [Work.MotK.kleinTwP0]
  exact (h1.add h2).sub h3

private lemma hom_kleinTwP1 (a b h : R) :
    (Work.MotK.kleinTwP1 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i)).IsHomogeneous 2 := by
  have h1 := hom_zero_mul_sq (-MvPolynomial.C a * MvPolynomial.C b : MvPolynomial (Fin 5) R)
    (hom_negC a b) 2
  have h2 := hom_zero_mul_XX (MvPolynomial.C a ^ 2 : MvPolynomial (Fin 5) R) (hom_Csq2 a) 0 4
  have h3 := hom_zero_mul_XX (MvPolynomial.C b ^ 2 : MvPolynomial (Fin 5) R) (hom_Csq2 b) 1 3
  simp only [Work.MotK.kleinTwP1]
  exact (h1.add h2).sub h3

private lemma hom_kleinTwP2 (a b h : R) :
    (Work.MotK.kleinTwP2 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i)).IsHomogeneous 2 := by
  have h1 := hom_zero_mul_sq
    (-MvPolynomial.C a * MvPolynomial.C b * MvPolynomial.C h : MvPolynomial (Fin 5) R)
    (hom_negC_mul_C a b h) 4
  have h2 := hom_zero_mul_XX (MvPolynomial.C a ^ 2 : MvPolynomial (Fin 5) R) (hom_Csq2 a) 1 2
  have h3 := hom_zero_mul_XX (MvPolynomial.C b ^ 2 : MvPolynomial (Fin 5) R) (hom_Csq2 b) 0 3
  simp only [Work.MotK.kleinTwP2]
  exact (h1.add h2).sub h3

private lemma hom_kleinTwP3 (a b h : R) :
    (Work.MotK.kleinTwP3 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i)).IsHomogeneous 2 := by
  have h1 := hom_zero_mul_sq (-MvPolynomial.C a * MvPolynomial.C b : MvPolynomial (Fin 5) R)
    (hom_negC a b) 1
  have h2 := hom_zero_mul_XX (MvPolynomial.C a ^ 2 * MvPolynomial.C h : MvPolynomial (Fin 5) R)
    (hom_Csq a h) 3 4
  have h3 := hom_zero_mul_XX (MvPolynomial.C b ^ 2 : MvPolynomial (Fin 5) R) (hom_Csq2 b) 0 2
  simp only [Work.MotK.kleinTwP3]
  exact (h1.add h2).sub h3

private lemma hom_kleinTwP4 (a b h : R) :
    (Work.MotK.kleinTwP4 (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i)).IsHomogeneous 2 := by
  have h1 := hom_zero_mul_sq
    (-MvPolynomial.C a * MvPolynomial.C b * MvPolynomial.C h : MvPolynomial (Fin 5) R)
    (hom_negC_mul_C a b h) 3
  have h2 := hom_zero_mul_XX (MvPolynomial.C a ^ 2 : MvPolynomial (Fin 5) R) (hom_Csq2 a) 0 1
  have h3 := hom_zero_mul_XX (MvPolynomial.C b ^ 2 * MvPolynomial.C h : MvPolynomial (Fin 5) R)
    (hom_Csq b h) 2 4
  simp only [Work.MotK.kleinTwP4]
  exact (h1.add h2).sub h3

/-- Each of the five twisted Pfaffians of the Klein model is a quadratic form in the variables
`X 0, …, X 4`. -/
private lemma hom_kleinTwP (a b h : R) (k : Fin 5) :
    (Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i) k).IsHomogeneous 2 := by
  have h0 := hom_kleinTwP0 (R := R) a b h
  have h1 := hom_kleinTwP1 (R := R) a b h
  have h2 := hom_kleinTwP2 (R := R) a b h
  have h3 := hom_kleinTwP3 (R := R) a b h
  have h4 := hom_kleinTwP4 (R := R) a b h
  fin_cases k
  · exact h0
  · exact h1
  · exact h2
  · exact h3
  · exact h4

theorem twIdeal_le_homogeneous (R : Type) [Field R] (a b h : R) :
    Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 3} =>
        Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
          (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1))
      ≤ MvPolynomial.homogeneousSubmodule (Fin 5) R 5 := by
  rw [Submodule.span_le]
  rintro x ⟨⟨k, m⟩, rfl⟩
  have hP : (Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C h)
      (fun i => MvPolynomial.X i) k).IsHomogeneous 2 := hom_kleinTwP a b h k
  have hm : (MvPolynomial.monomial m.1 (1 : R)).IsHomogeneous 3 := by
    refine MvPolynomial.isHomogeneous_monomial (1 : R) ?_
    rw [Finsupp.degree_apply]
    exact m.2
  have h := hP.mul hm
  simpa using h

end Work.MotK.TwRuling
