/-!
# The twisted Klein curve contains `sdY`

`Work.MotK.TGen.sdY K D h` is the image of the twisted Klein coordinates `twCoordG K D h` in the
rational function field `sdA K D h = RatFunc ↥(twistFieldTG K D h)` of the target ruling divisor.

The twisted Klein quadrics `kleinTwP` vanish on `twCoordG` in `OmG K D = K̄(E)` — this is
`Work.MotK.TGen.TwCoordGKleinTw`, phrased for the `twMon`-form `Work.MotV.kleinTw` and transported
to the explicit Pfaffian form by `Work.MotK.TGen.kleinTw_eq_kleinTwP`.  Since all the data
(`D.a`, `D.b`, `h` and the `twCoordG K D h i`) lie in the intermediate field
`F := twistFieldTG K D h`, and `F ↪ OmG K D` is injective, the vanishing descends to `F` and then
along the algebra map `F → RatFunc ↥F = sdA K D h`.  This proves
`Work.MotK.TwRuling.sdY_curve`.

The only bookkeeping needed is that evaluation of `kleinTwP` commutes with a ring homomorphism
(`map_kleinTwP`) and the two `IsScalarTower` rewrites identifying `algebraMap K (sdA K D h) x`
with `algebraMap ↥F (sdA K D h) (algebraMap K ↥F x)`.
-/

/-- **Evaluation of the twisted Klein quadrics commutes with ring homomorphisms**: for any ring
homomorphism `φ : F →+* A`, `kleinTwP (φ a) (φ b) (φ h) (φ ∘ y) = φ ∘ kleinTwP a b h y`. -/
theorem map_kleinTwP {F A : Type*} [CommRing F] [CommRing A] (φ : F →+* A)
    (a b h : F) (y : Fin 5 → F) (k : Fin 5) :
    Work.MotK.kleinTwP (φ a) (φ b) (φ h) (fun i => φ (y i)) k =
      φ (Work.MotK.kleinTwP a b h y k) := by
  fin_cases k <;>
    simp only [Work.MotK.kleinTwP, Work.MotK.kleinTwP0, Work.MotK.kleinTwP1, Work.MotK.kleinTwP2,
      Work.MotK.kleinTwP3, Work.MotK.kleinTwP4] <;>
    simp [map_add, map_sub, map_mul, map_neg, map_pow]

/-- **The twisted Klein coordinates satisfy the twisted Klein equations in the function field
`sdA K D h` of the target ruling divisor.** -/
theorem sdY_curve (K : Type) [Field K] (D : Work.MotV.KleinData K) (hD : D.Good) (h : K)
    (hh : h ≠ 0) (k : Fin 5) :
    Work.MotK.kleinTwP (algebraMap K (Work.MotK.TGen.sdA K D h) D.a)
      (algebraMap K (Work.MotK.TGen.sdA K D h) D.b) (algebraMap K (Work.MotK.TGen.sdA K D h) h)
      (Work.MotK.TGen.sdY K D h) k = 0 := by
  -- The twisted Klein equation holds in `F := twistFieldTG K D h`, the field generated by the
  -- twisted coordinates inside `OmG K D`.
  have hF : Work.MotK.kleinTwP (algebraMap K ↥(Work.MotK.twistFieldTG K D h) D.a)
      (algebraMap K ↥(Work.MotK.twistFieldTG K D h) D.b)
      (algebraMap K ↥(Work.MotK.twistFieldTG K D h) h)
      (fun i => (⟨Work.MotK.twCoordG K D h i,
        IntermediateField.subset_adjoin K (Set.range (Work.MotK.twCoordG K D h))
          (Set.mem_range_self i)⟩ : ↥(Work.MotK.twistFieldTG K D h))) k = 0 := by
    -- Descend along the injective inclusion `F ↪ OmG K D`.
    apply (algebraMap ↥(Work.MotK.twistFieldTG K D h) (Work.MotK.OmG K D)).injective
    rw [map_zero, ← map_kleinTwP]
    simp only [← IsScalarTower.algebraMap_apply K ↥(Work.MotK.twistFieldTG K D h) (Work.MotK.OmG K D)]
    rw [← Work.MotK.TGen.kleinTw_eq_kleinTwP]
    exact Work.MotK.TGen.TwCoordGKleinTw D hD h hh k
  -- Push forward along the algebra map `F → RatFunc ↥F = sdA K D h`, using that all the data are
  -- images of elements of `F`.
  have h2 := map_kleinTwP (algebraMap ↥(Work.MotK.twistFieldTG K D h) (Work.MotK.TGen.sdA K D h))
    (algebraMap K ↥(Work.MotK.twistFieldTG K D h) D.a)
    (algebraMap K ↥(Work.MotK.twistFieldTG K D h) D.b)
    (algebraMap K ↥(Work.MotK.twistFieldTG K D h) h)
    (fun i => (⟨Work.MotK.twCoordG K D h i,
      IntermediateField.subset_adjoin K (Set.range (Work.MotK.twCoordG K D h))
        (Set.mem_range_self i)⟩ : ↥(Work.MotK.twistFieldTG K D h))) k
  rw [hF, map_zero] at h2
  exact h2

end Work.MotK.TwRuling
