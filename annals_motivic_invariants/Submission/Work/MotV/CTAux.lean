import Mathlib
import Submission.Work.MotV.Defs
import Submission.Work.MotV.ExpRigDefs

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# Auxiliaries for the constants-only node of the T-twist field

This file collects the general-purpose lemmas used by
`Work.MotV.constantsOnly_twist` (node CO).  Everything here is proved outright and depends only on
Mathlib and `Work.MotV.Defs` (`Work.MotV.ExpRigDefs` supplies `hT 𝕜 ≠ 0`).

* `Work.MotV.ratFunc_algHom_ext` — a `𝕜`-algebra homomorphism out of the rational function field
  `𝕜(X)` is determined by its value at `X` (the function field is generated by `X`);
* `Work.MotV.hT_ne_zero` — the Kummer parameter `hT = t(t-1)` is a nonzero rational function.
-/

set_option autoImplicit false

open WeierstrassCurve WeierstrassCurve.Affine
open scoped WithZero

namespace Work.MotV

noncomputable section

/-- **The rational function field is generated by `X`.**  Two `𝕜`-algebra homomorphisms
`𝕜(X) → R` into a `𝕜`-algebra agree as soon as they agree at `X`. -/
theorem ratFunc_algHom_ext {𝕜 R : Type*} [Field 𝕜] [Field R] [Algebra 𝕜 R]
    {φ ψ : RatFunc 𝕜 →ₐ[𝕜] R} (h : φ (RatFunc.X : RatFunc 𝕜) = ψ RatFunc.X) : φ = ψ := by
  have key : (Polynomial.aeval (RatFunc.X : RatFunc 𝕜) : Polynomial 𝕜 →ₐ[𝕜] RatFunc 𝕜)
      = IsScalarTower.toAlgHom 𝕜 (Polynomial 𝕜) (RatFunc 𝕜) := by
    apply Polynomial.algHom_ext
    rw [Polynomial.aeval_X, IsScalarTower.toAlgHom_apply, RatFunc.algebraMap_X]
  have h1 : ∀ p : Polynomial 𝕜,
      (Polynomial.aeval (RatFunc.X : RatFunc 𝕜)) p = algebraMap (Polynomial 𝕜) (RatFunc 𝕜) p := by
    intro p
    rw [← IsScalarTower.toAlgHom_apply 𝕜 (Polynomial 𝕜) (RatFunc 𝕜) p]
    exact congr_fun (congrArg DFunLike.coe key) p
  have hpoly : ∀ p : Polynomial 𝕜,
      φ (algebraMap (Polynomial 𝕜) (RatFunc 𝕜) p) = ψ (algebraMap (Polynomial 𝕜) (RatFunc 𝕜) p) := by
    intro p
    rw [← h1 p, ← Polynomial.aeval_algHom_apply φ (RatFunc.X : RatFunc 𝕜) p, h,
      Polynomial.aeval_algHom_apply ψ (RatFunc.X : RatFunc 𝕜) p, h1 p]
  refine AlgHom.ext fun f => ?_
  rw [← RatFunc.num_div_denom f, map_div₀, map_div₀, hpoly f.num, hpoly f.denom]

/-- The Kummer parameter `hT 𝕜 = t(t-1)` of the T-twist is a nonzero rational function.  This is
immediate from `Work.MotV.vT_hT` (`vT 𝕜 (hT 𝕜) = exp (-1)`). -/
theorem hT_ne_zero (𝕜 : Type*) [Field 𝕜] : hT 𝕜 ≠ 0 := by
  intro h0
  have h := vT_hT 𝕜
  rw [h0, Valuation.map_zero] at h
  exact WithZero.exp_ne_zero h.symm

end

end Work.MotV
