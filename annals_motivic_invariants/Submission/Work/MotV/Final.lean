/-!
# The characteristic-`≠ 5` branch of route V, unconditionally

This file feeds the two external inputs of the design into the assembly
`Work.MotV.not_gen_charNeFive_of_inputs`:

* **KDATA**: `Work.MotK.ExistsKleinData` (the explicit Klein model of the Tate normal form, the
  K-route's CAS job);
* **LK_T**: `Work.MotK.LinkCertT` (the T-twisted Crauder–Katz link certificate, the K-route's
  deliverable, `Submission/Work/MotK/GUIDE_LINK.md`).

**Axiom status.**  Both of those declarations are the *other* area's deliverables and are still
being completed (`Submission/Work/MotK/ExistsKleinData.lean` still has `sorry`s in its
characteristic-`2`/`3` cases, `Submission/Work/MotK/LinkCertT.lean` in the census).  Consequently the
axiom footprint of the statements below currently includes `sorryAx` through those two imports, and
becomes `propext, Classical.choice, Quot.sound` automatically as soon as the K-route's two files are
`sorry`-free -- no edit of this file is needed.  Everything on this area's side (CERT, SPREAD, CO,
RIG, and the assembly itself) is `sorry`-free and axiom-clean; see
`Work.MotV.not_gen_charNeFive_of_inputs` in `Submission/Work/MotV/Assembly.lean`.
-/

noncomputable section

namespace Work.MotV

/-- **The characteristic-`≠ 5` branch of `theorem_1_2_3` (`not_gen_charNeFive`).**  `Cr 𝕜 n` is not
generated by pseudo-regularizable elements for every infinite field `𝕜` of characteristic `≠ 5` and
every `n ≥ 4`. -/
theorem not_gen_charNeFive (𝕜 : Type) [Field 𝕜] [Infinite 𝕜] (hk : ringChar 𝕜 ≠ 5) {n : ℕ}
    (hn : 4 ≤ n) : ¬ GenByPseudoRegularizable 𝕜 n :=
  not_gen_charNeFive_of 𝕜 hk hn (Work.MotK.ExistsKleinData 𝕜)
    (fun D hD => Work.MotK.LinkCertT 𝕜 hk D hD)

/-- **Theorem 1.2 (2) of Lin–Shinder**: for every subfield `𝕜 ≤ ℂ` and every `n ≥ 4`, `Crₙ(𝕜)` is
not generated by pseudo-regularizable elements.  (Every such `𝕜` has characteristic `0`, so this
uses only the characteristic-`≠ 5` branch.) -/
theorem theorem_1_2_2' {n : ℕ} (hn : 4 ≤ n) (𝕜 : Subfield ℂ) :
    ¬ GenByPseudoRegularizable 𝕜 n :=
  theorem_1_2_2'_of (fun 𝕜 _ _ hk {n} hn => not_gen_charNeFive 𝕜 hk hn) hn 𝕜

/-- **Theorem 1.2 (3) of Lin–Shinder** from this branch and the characteristic-`5` branch.  The
second hypothesis is exactly the conclusion of the sibling area `Work.MotV5`'s assembly
`Work.MotV5.not_gen_charFive_of` (node ASM5), so instantiating this statement with
`Work.MotV5.not_gen_charFive` gives the challenge's Theorem 1.2 (3) with no further work. -/
theorem theorem_1_2_3'_of_charFive
    (hFive : ∀ (𝕜 : Type) [Field 𝕜] [Infinite 𝕜], ringChar 𝕜 = 5 → ∀ {n : ℕ}, 4 ≤ n →
      ¬ GenByPseudoRegularizable 𝕜 n)
    (𝕜 : Type) [Field 𝕜] {n : ℕ} (hn : 5 ≤ n) [Infinite 𝕜] :
    ¬ GenByPseudoRegularizable 𝕜 n :=
  theorem_1_2_3'_of (fun 𝕜 _ _ hk {n} hn => not_gen_charNeFive 𝕜 hk hn) hFive 𝕜 hn

end Work.MotV
