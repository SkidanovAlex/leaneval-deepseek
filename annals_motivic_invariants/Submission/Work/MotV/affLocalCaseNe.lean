# The local ring of a point of an elliptic curve at which `y` is a local parameter

Let `E` be an elliptic Weierstrass curve over a field `N` and `(a, b)` a nonsingular point of `E`
at which the `y`-derivative `W_y(a,b) = 2b + a₁a + a₃` does not vanish.  Then `(a, b)` is an
ordinary (non-2-torsion) point: the maximal ideal of the local ring `affPlaceAt E a b ⊆ N(E)` is
generated by `x - a`, and the element

`2(y - b) + a₁(x - a) + (2b + a₁a + a₃) = 2y + a₁x + a₃`

is a unit of the local ring (it does not vanish at `(a, b)`).

## Main results

* `Work.MotV.affPlaceAt_maxIdeal_eq_span_XClass`: in this case the maximal ideal of
  `↥(affPlaceAt E a b)` is generated by `x - a`.
* `Work.MotV.affPlaceAt_XClass_local_ne_zero`: the image of `x - a` in the local ring is nonzero.
* `Work.MotV.affPlaceAt_derivY_isUnit`: `2y + a₁x + a₃` is a unit of the local ring.
* `Work.MotV.affLocalCaseNe`: the image of `x - a` is irreducible and `2y + a₁x + a₃` is a unit.

## Tags

elliptic curve, function field, local ring, uniformizer
-/

import Mathlib
import Submission.Work.MotC2.AffPlaceSetup
import Submission.Work.MotC2.AffPlaceMaxIdealPrincipal

set_option linter.unusedVariables false -- v435-speed

open Polynomial WeierstrassCurve.Affine
open Work.MotC2 (Coord Func)

namespace Work.MotV

/-- The image of `x - a` in the local ring `↥(affPlaceAt E a b)` is nonzero: `x - a` is not the
zero function on the curve. -/
lemma affPlaceAt_XClass_local_ne_zero {N : Type*} [Field N] (E : WeierstrassCurve N)
    [E.IsElliptic] (a b : N) [Work.MotC2.IsNonsingularPoint E a b] :
    algebraMap (Coord E) ↥(Work.MotC2.affPlaceAt E a b) (CoordinateRing.XClass E a) ≠ 0 := by
  intro h0
  have h1 : algebraMap (Coord E) (Func E) (CoordinateRing.XClass E a) = 0 := by
    rw [← Work.MotC2.affPlaceAt_algebraMap_val E a b (CoordinateRing.XClass E a), h0]
    rfl
  exact CoordinateRing.XClass_ne_zero (W' := E) a
    (IsFractionRing.injective (Coord E) (Func E) (by simpa using h1))

/-- At a nonsingular point of an elliptic curve at which the `y`-derivative
`W_y(a, b) = 2b + a₁a + a₃` does not vanish, the maximal ideal of the local ring
`↥(affPlaceAt E a b)` is generated by the image of `x - a`: the coordinate `x` is a local
parameter at `(a, b)`.

This is the `y`-derivative branch of `Work.MotC2.AffPlaceMaxIdealPrincipal`, stated with the
explicit generator, which is what is needed to recognise the generator as an irreducible
element. -/
lemma affPlaceAt_maxIdeal_eq_span_XClass {N : Type*} [Field N] (E : WeierstrassCurve N)
    [E.IsElliptic] (a b : N) [Work.MotC2.IsNonsingularPoint E a b]
    (hw : 2 * b + E.a₁ * a + E.a₃ ≠ 0) :
    IsLocalRing.maximalIdeal ↥(Work.MotC2.affPlaceAt E a b) =
      Ideal.span {algebraMap (Coord E) ↥(Work.MotC2.affPlaceAt E a b) (CoordinateRing.XClass E a)} := by
  set S : Subalgebra N (Func E) := Work.MotC2.affPlaceAt E a b with hS
  set X' : ↥S := algebraMap (Coord E) ↥S (CoordinateRing.XClass E a)
  set Y' : ↥S := algebraMap (Coord E) ↥S (CoordinateRing.YClass E (Polynomial.C b))
  set α : ↥S := algebraMap N ↥S a
  set β : ↥S := algebraMap N ↥S b
  set A₁ : ↥S := algebraMap N ↥S E.a₁
  set A₂ : ↥S := algebraMap N ↥S E.a₂
  set A₃ : ↥S := algebraMap N ↥S E.a₃
  set A₄ : ↥S := algebraMap N ↥S E.a₄
  set A₆ : ↥S := algebraMap N ↥S E.a₆
  have hX'eq : X' = algebraMap (Coord E) ↥S (Work.MotC2.coordX E) - α :=
    Work.MotC2.affPlaceAt_algebraMap_XClass E a b
  have hY'eq : Y' = algebraMap (Coord E) ↥S (Work.MotC2.coordY E) - β :=
    Work.MotC2.affPlaceAt_algebraMap_YClass E a b
  have hY'mem : Y' ∈ IsLocalRing.maximalIdeal ↥S :=
    Work.MotC2.affPlaceAt_YClass_mem_maximalIdeal E a b
  have hX'mem : X' ∈ IsLocalRing.maximalIdeal ↥S :=
    Work.MotC2.affPlaceAt_XClass_mem_maximalIdeal E a b
  -- Taylor expansion of the Weierstrass relation around `(a, b)`.
  have htay : Y' * (Y' + A₁ * X' + (2 * β + A₁ * α + A₃)) =
      X' * ((3 * α + A₂) * X' + X' ^ 2 + (3 * α ^ 2 + 2 * A₂ * α + A₄ - A₁ * β)) := by
    have h1 := Work.MotC2.affPlaceAt_coordY_sq_relation E a b
    have h2 := Work.MotC2.affPlaceAt_equation E a b
    have ht := Work.MotC2.taylor_identity (x := algebraMap (Coord E) ↥S (Work.MotC2.coordX E))
      (y := algebraMap (Coord E) ↥S (Work.MotC2.coordY E))
      (a := α) (b := β) (A₁ := A₁) (A₂ := A₂) (A₃ := A₃) (A₄ := A₄) (A₆ := A₆) h1 h2
    rw [← hX'eq, ← hY'eq] at ht
    exact ht
  have hWy : algebraMap N ↥S (2 * b + E.a₁ * a + E.a₃) = 2 * β + A₁ * α + A₃ := by
    simp only [map_add, map_mul, map_ofNat]
    rfl
  -- The multiplier of `Y'` is a unit: it is a nonzero scalar modulo the maximal ideal.
  have hU : IsUnit (Y' + A₁ * X' + (2 * β + A₁ * α + A₃)) := by
    have hmem : Y' + A₁ * X' ∈ IsLocalRing.maximalIdeal ↥S :=
      add_mem hY'mem (Ideal.mul_mem_left _ _ hX'mem)
    have hunit := Work.MotC2.isUnit_algebraMap_affPlaceAt_of_ne_zero E a b hw
    have h3 := Work.MotC2.isUnit_add_mem_maximalIdeal hunit hmem
    rwa [hWy, add_comm] at h3
  have hm : IsLocalRing.maximalIdeal ↥S = Ideal.span ({X', Y'} : Set ↥S) :=
    Work.MotC2.affPlaceAt_maximalIdeal_eq E a b
  rw [hm, Work.MotC2.span_pair_eq_left_of_isUnit (hUV := htay) hU]

/-- At a nonsingular point `(a, b)` of an elliptic curve at which the `y`-derivative
`W_y(a, b) = 2b + a₁a + a₃` does not vanish, the element
`2(y - b) + a₁(x - a) + (2b + a₁a + a₃) = 2y + a₁x + a₃` of the local ring `↥(affPlaceAt E a b)`
is a unit: it is congruent to the nonzero scalar `2b + a₁a + a₃` modulo the maximal ideal. -/
lemma affPlaceAt_derivY_isUnit {N : Type*} [Field N] (E : WeierstrassCurve N) [E.IsElliptic]
    (a b : N) (h : WeierstrassCurve.Affine.Nonsingular E a b)
    (hw : 2 * b + E.a₁ * a + E.a₃ ≠ 0) :
    IsUnit (2 * algebraMap (Coord E) ↥(Work.MotC2.affPlaceAt E a b)
          (CoordinateRing.YClass E (Polynomial.C b)) +
        algebraMap N ↥(Work.MotC2.affPlaceAt E a b) E.a₁ *
          algebraMap (Coord E) ↥(Work.MotC2.affPlaceAt E a b)
            (CoordinateRing.XClass E a) +
        algebraMap N ↥(Work.MotC2.affPlaceAt E a b) (2 * b + E.a₁ * a + E.a₃)) := by
  have hns : Work.MotC2.IsNonsingularPoint E a b := ⟨h⟩
  have hYmem := Work.MotC2.affPlaceAt_YClass_mem_maximalIdeal E a b
  have hXmem := Work.MotC2.affPlaceAt_XClass_mem_maximalIdeal E a b
  have hmem : 2 * algebraMap (Coord E) ↥(Work.MotC2.affPlaceAt E a b)
        (CoordinateRing.YClass E (Polynomial.C b)) +
      algebraMap N ↥(Work.MotC2.affPlaceAt E a b) E.a₁ *
        algebraMap (Coord E) ↥(Work.MotC2.affPlaceAt E a b) (CoordinateRing.XClass E a) ∈
      IsLocalRing.maximalIdeal ↥(Work.MotC2.affPlaceAt E a b) :=
    add_mem (Ideal.mul_mem_left _ _ hYmem) (Ideal.mul_mem_left _ _ hXmem)
  have hunit := Work.MotC2.isUnit_algebraMap_affPlaceAt_of_ne_zero E a b hw
  have h3 := Work.MotC2.isUnit_add_mem_maximalIdeal hunit hmem
  rwa [add_comm] at h3

theorem affLocalCaseNe {N : Type*} [Field N] (E : WeierstrassCurve N) [E.IsElliptic]
    (a b : N) (h : WeierstrassCurve.Affine.Nonsingular E a b)
    (hw : 2 * b + E.a₁ * a + E.a₃ ≠ 0) :
    Irreducible (algebraMap (Work.MotC2.Coord E) ↥(Work.MotC2.affPlaceAt E a b)
        (WeierstrassCurve.Affine.CoordinateRing.XClass E a)) ∧
    IsUnit (2 * algebraMap (Work.MotC2.Coord E) ↥(Work.MotC2.affPlaceAt E a b)
          (WeierstrassCurve.Affine.CoordinateRing.YClass E (Polynomial.C b)) +
        algebraMap N ↥(Work.MotC2.affPlaceAt E a b) E.a₁ *
          algebraMap (Work.MotC2.Coord E) ↥(Work.MotC2.affPlaceAt E a b)
            (WeierstrassCurve.Affine.CoordinateRing.XClass E a) +
        algebraMap N ↥(Work.MotC2.affPlaceAt E a b) (2 * b + E.a₁ * a + E.a₃)) := by
  have hns : Work.MotC2.IsNonsingularPoint E a b := ⟨h⟩
  -- In a discrete valuation ring an element generating the maximal ideal is a uniformizer, hence
  -- irreducible; here `x - a` generates the maximal ideal and is nonzero.
  exact ⟨IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _
      (affPlaceAt_XClass_local_ne_zero E a b) (affPlaceAt_maxIdeal_eq_span_XClass E a b hw),
    affPlaceAt_derivY_isUnit E a b h hw⟩

end Work.MotV
