# The negation `[-1]` of an elliptic curve carries the place at `(c, d)` to the place at `-P`

Let `E` be a Weierstrass curve over a field `N`, with function field `Func E = N(E)`.  The
negation `[-1] : P ↦ -P` of `E` acts on the function field by the substitution `x ↦ x`,
`y ↦ -y - a₁x - a₃`; this is the algebra automorphism `Work.MotC2.negAlgEquiv E` of `N(E)`
(Negation.lean), and the `y`-coordinate of `-(c, d)` is
`WeierstrassCurve.Affine.negY E c d = -d - E.a₁ * c - E.a₃`.

The affine place at `(c, d)` — the localization of the coordinate ring `Coord E = N[x,y]/(W_E)` at
the maximal ideal `⟨x - c, y - d⟩`, realized as the `N`-subalgebra `Work.MotC2.affPlaceAt E c d ⊆
N(E)` generated by `Coord E` and the inverses of the elements outside `⟨x - c, y - d⟩` — must
therefore be carried by `negAlgEquiv E` onto the affine place at `(c, negY E c d)`:

`map_negAlgEquiv_affPlaceAt`.

## The proof

`affPlaceAt E c d` depends on `(c, d)` only through the ideal
`affPlaceIdeal E c d = ⟨x - c, y - d⟩ = Ideal.span {XClass E c, YClass E (C d)}`, and it is a
generated `N`-subalgebra, so its image under an automorphism whose action on `N[x,y]` is known is
again such a generated subalgebra, with the ideal replaced by the image ideal.  Concretely:

* the generator identities `negCoordAlgEquiv_XClass_eq_self` and `negCoordAlgEquiv_YClass_eq`
  compute the image of the two generators of `affPlaceIdeal E c d`;
* `map_negCoordAlgEquiv_affPlaceIdeal_eq` turns them into
  `Ideal.map (negCoordAlgEquiv E) (affPlaceIdeal E c d) = affPlaceIdeal E c (negY E c d)`;
* `map_affPlaceAt_of` is the formal statement that an `N`-algebra automorphism `τ` of `N(E)`
  lifting `ψ` on `N[x,y]` and satisfying `Ideal.map ψ I = I'` maps `affPlaceAt`-at-`I` onto
  `affPlaceAt`-at-`I'`: `AlgHom.map_adjoin` reduces it to the statement that `τ` permutes the
  generating set of `affPlaceAt`, which holds because `ψ` is a bijection respecting the ideal.

## Tags

elliptic curve, function field, place, local ring, automorphism, negation
-/

import Mathlib
import Submission.Work.MotC2.Negation
import Submission.Work.MotC2.AffPlaceSetup
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

open Polynomial WeierstrassCurve.Affine

namespace Work.MotV

/-! ## The image of `linCoef` in the coordinate ring -/

/-- The push-forward of `linCoef E = C a₁ * X + C a₃` to the coordinate ring is
`a₁ * x + a₃`. -/
lemma linCoef_algebraMap_coord {N : Type*} [Field N] (E : WeierstrassCurve N) :
    algebraMap (Polynomial N) (Work.MotC2.Coord E) (Work.MotC2.linCoef E) =
      algebraMap N (Work.MotC2.Coord E) E.a₁ * Work.MotC2.coordX E +
        algebraMap N (Work.MotC2.Coord E) E.a₃ := by
  simp only [Work.MotC2.linCoef, map_add, map_mul, Polynomial.C_eq_algebraMap,
    IsScalarTower.algebraMap_apply N (Polynomial N) (Work.MotC2.Coord E),
    Work.MotC2.algebraMap_X_eq_coordX]

/-! ## The action of `[-1]` on the two generators of `⟨x - c, y - d⟩` -/

/-- The negation fixes the class of `x - c`. -/
lemma negCoordAlgEquiv_XClass_eq_self {N : Type*} [Field N] (E : WeierstrassCurve N) (c : N) :
    Work.MotC2.negCoordAlgEquiv E (CoordinateRing.XClass E c) = CoordinateRing.XClass E c := by
  rw [Work.MotC2.XClass_eq_coordX_sub, map_sub, Work.MotC2.negCoordAlgEquiv_coordX,
    AlgEquiv.commutes]

/-- The negation sends the class of `y - d` to `-(y - negY c d) - a₁ (x - c)` in the coordinate
ring. -/
lemma negCoordAlgEquiv_YClass_eq {N : Type*} [Field N] (E : WeierstrassCurve N) (c d : N) :
    Work.MotC2.negCoordAlgEquiv E (CoordinateRing.YClass E (Polynomial.C d)) =
      - CoordinateRing.YClass E (Polynomial.C (WeierstrassCurve.Affine.negY E c d)) -
        algebraMap N (Work.MotC2.Coord E) E.a₁ * CoordinateRing.XClass E c := by
  have hneg : algebraMap N (Work.MotC2.Coord E) (WeierstrassCurve.Affine.negY E c d) =
      - algebraMap N (Work.MotC2.Coord E) d -
        algebraMap N (Work.MotC2.Coord E) E.a₁ * algebraMap N (Work.MotC2.Coord E) c -
        algebraMap N (Work.MotC2.Coord E) E.a₃ := by
    simp only [WeierstrassCurve.Affine.negY, map_sub, map_mul, map_neg]
  rw [Work.MotC2.YClass_eq_coordY_sub, Work.MotC2.YClass_eq_coordY_sub,
    Work.MotC2.XClass_eq_coordX_sub, map_sub, Work.MotC2.negCoordAlgEquiv_coordY,
    AlgEquiv.commutes, linCoef_algebraMap_coord, hneg]
  first | refl_ring1 | ring

/-! ## The image ideal -/

/-- The negation carries the ideal `⟨x - c, y - d⟩` of the coordinate ring onto
`⟨x - c, y - negY c d⟩`. -/
lemma map_negCoordAlgEquiv_affPlaceIdeal_eq {N : Type*} [Field N] (E : WeierstrassCurve N)
    (c d : N) :
    Ideal.map (Work.MotC2.negCoordAlgEquiv E : Work.MotC2.Coord E →+* Work.MotC2.Coord E)
        (Work.MotC2.affPlaceIdeal E c d) =
      Work.MotC2.affPlaceIdeal E c (WeierstrassCurve.Affine.negY E c d) := by
  have hX : (Work.MotC2.negCoordAlgEquiv E : Work.MotC2.Coord E →+* Work.MotC2.Coord E)
      (CoordinateRing.XClass E c) = CoordinateRing.XClass E c := negCoordAlgEquiv_XClass_eq_self E c
  have hY : (Work.MotC2.negCoordAlgEquiv E : Work.MotC2.Coord E →+* Work.MotC2.Coord E)
      (CoordinateRing.YClass E (Polynomial.C d)) =
      - CoordinateRing.YClass E (Polynomial.C (WeierstrassCurve.Affine.negY E c d)) -
        algebraMap N (Work.MotC2.Coord E) E.a₁ * CoordinateRing.XClass E c :=
    negCoordAlgEquiv_YClass_eq E c d
  rw [Work.MotC2.affPlaceIdeal, Work.MotC2.affPlaceIdeal, CoordinateRing.XYIdeal,
    CoordinateRing.XYIdeal, Ideal.map_span, Set.image_pair, hX, hY]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.mem_span_pair.mpr ⟨- algebraMap N (Work.MotC2.Coord E) E.a₁, -1, by ring⟩
  · rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.mem_span_pair.mpr ⟨- algebraMap N (Work.MotC2.Coord E) E.a₁, -1, by ring⟩

/-! ## The map of a generated affine place under an automorphism of the function field -/

/-- An `N`-algebra automorphism `τ` of the function field `N(E)` which lifts an `N`-algebra
automorphism `ψ` of the coordinate ring and carries the ideal `I` onto the ideal `I'` maps the
generated subalgebra `affPlaceAt`-at-`I` onto the one at `I'`. -/
lemma map_affPlaceAt_of {N : Type*} [Field N] (E : WeierstrassCurve N)
    (τ : Work.MotC2.Func E ≃ₐ[N] Work.MotC2.Func E) (ψ : Work.MotC2.Coord E ≃ₐ[N] Work.MotC2.Coord E)
    (h : ∀ r : Work.MotC2.Coord E,
      τ.toAlgHom (algebraMap (Work.MotC2.Coord E) (Work.MotC2.Func E) r) =
        algebraMap (Work.MotC2.Coord E) (Work.MotC2.Func E) (ψ r))
    (a b a' b' : N)
    (hI : Ideal.map (ψ : Work.MotC2.Coord E →+* Work.MotC2.Coord E)
        (Work.MotC2.affPlaceIdeal E a b) = Work.MotC2.affPlaceIdeal E a' b') :
    Subalgebra.map τ.toAlgHom (Work.MotC2.affPlaceAt E a b) =
      Work.MotC2.affPlaceAt E a' b' := by
  have hmem : ∀ r : Work.MotC2.Coord E,
      r ∈ Work.MotC2.affPlaceIdeal E a b ↔ ψ r ∈ Work.MotC2.affPlaceIdeal E a' b' := by
    intro r
    constructor
    · intro hr
      rw [← hI]
      exact Ideal.mem_map_of_mem (ψ : Work.MotC2.Coord E →+* Work.MotC2.Coord E) hr
    · intro hr
      have h2 : ψ r ∈ Ideal.map (ψ : Work.MotC2.Coord E →+* Work.MotC2.Coord E)
          (Work.MotC2.affPlaceIdeal E a b) := hI ▸ hr
      obtain ⟨x, hx, hxr⟩ := (Ideal.mem_map_of_equiv ψ (ψ r)).mp h2
      rw [ψ.injective hxr] at hx
      exact hx
  have hgen : τ.toAlgHom '' Work.MotC2.affPlaceGens E a b =
      Work.MotC2.affPlaceGens E a' b' := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      rcases hx with hx | hx
      · obtain ⟨r, rfl⟩ := hx
        rw [h]
        exact Set.mem_union_left _ ⟨ψ r, rfl⟩
      · obtain ⟨r, hr, rfl⟩ := hx
        rw [map_inv₀, h]
        exact Set.mem_union_right _
          ⟨ψ r, fun hψ => hr ((hmem r).mpr hψ), rfl⟩
    · intro hy
      rcases hy with hy | hy
      · obtain ⟨r, rfl⟩ := hy
        refine ⟨algebraMap (Work.MotC2.Coord E) (Work.MotC2.Func E) (ψ.symm r),
          Set.mem_union_left _ ⟨ψ.symm r, rfl⟩, ?_⟩
        rw [h, AlgEquiv.apply_symm_apply]
      · obtain ⟨r, hr, rfl⟩ := hy
        refine ⟨(algebraMap (Work.MotC2.Coord E) (Work.MotC2.Func E) (ψ.symm r))⁻¹,
          Set.mem_union_right _ ⟨ψ.symm r, ?_, rfl⟩, ?_⟩
        · intro hmem'
          apply hr
          have h3 := (hmem (ψ.symm r)).mp hmem'
          rwa [AlgEquiv.apply_symm_apply] at h3
        · rw [map_inv₀, h, AlgEquiv.apply_symm_apply]
  rw [Work.MotC2.affPlaceAt_eq_adjoin, Work.MotC2.affPlaceAt_eq_adjoin, AlgHom.map_adjoin, hgen]

/-! ## The main result -/

/-- **The negation `[-1]` carries the affine place at `(c, d)` to the affine place at
`(c, negY E c d)`.** -/
theorem map_negAlgEquiv_affPlaceAt {N : Type*} [Field N] (E : WeierstrassCurve N) (c d : N) :
    Subalgebra.map (Work.MotC2.negAlgEquiv E).toAlgHom (Work.MotC2.affPlaceAt E c d) =
      Work.MotC2.affPlaceAt E c (WeierstrassCurve.Affine.negY E c d) :=
  map_affPlaceAt_of E (Work.MotC2.negAlgEquiv E) (Work.MotC2.negCoordAlgEquiv E)
    (fun r => IsFractionRing.algEquivOfAlgEquiv_algebraMap (Work.MotC2.negCoordAlgEquiv E) r)
    c d c (WeierstrassCurve.Affine.negY E c d)
    (map_negCoordAlgEquiv_affPlaceIdeal_eq E c d)

end Work.MotV
