namespace Work.MotV

noncomputable section

variable {N : Type*} [Field N]

/-- A derivation of a `R`-algebra `B` into itself maps the `R`-subalgebra generated by a set `S`
into itself as soon as it maps `S` into that subalgebra.

This is the standard "the set of elements whose image under `D` lies in `A` is a subalgebra"
argument: the carrier `{x | x ∈ A ∧ D x ∈ A}` is closed under all the algebra operations. -/
lemma deriv_maps_adjoin {R B : Type*} [CommSemiring R] [Field B] [Algebra R B]
    (D : Derivation R B B) (S : Set B) (hS : ∀ s ∈ S, D s ∈ Algebra.adjoin R S) :
    ∀ x ∈ Algebra.adjoin R S, D x ∈ Algebra.adjoin R S := by
  intro x hx
  refine Algebra.adjoin_induction (p := fun y _ => D y ∈ Algebra.adjoin R S) ?_ ?_ ?_ ?_ hx
  · intro s hs
    exact hS s hs
  · intro r
    rw [Derivation.map_algebraMap]
    exact Subalgebra.zero_mem _
  · intro y z _ _ ihy ihz
    rw [Derivation.map_add]
    exact add_mem ihy ihz
  · intro y z hy hz ihy ihz
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact add_mem (mul_mem hy ihz) (mul_mem hz ihy)

/-- The affine coordinate ring `L[X, Y]/(W_E)`, viewed inside the function field `L(E)` through
the structure map, is exactly the image of that structure map: it is closed under the ring
operations, so adjoining it as a set changes nothing. -/
lemma affRing_eq_algHom_range (E : WeierstrassCurve N) :
    MotC2.affRing E =
      (IsScalarTower.toAlgHom N (MotC2.Coord E) (MotC2.Func E)).range := by
  rw [MotC2.affRing]
  refine le_antisymm ?_ ?_
  · rw [Algebra.adjoin_le_iff]
    rintro x ⟨a, rfl⟩
    exact ⟨a, rfl⟩
  · rintro x ⟨a, rfl⟩
    exact Algebra.subset_adjoin ⟨a, rfl⟩

theorem invDerivOnA {N : Type*} [Field N] (E : WeierstrassCurve N) [E.IsElliptic]
    (D : Derivation N (Work.MotC2.Func E) (Work.MotC2.Func E))
    (hDx : D (Work.MotC2.genX E) = 2 * Work.MotC2.genY E +
        algebraMap N (Work.MotC2.Func E) E.a₁ * Work.MotC2.genX E +
        algebraMap N (Work.MotC2.Func E) E.a₃)
    (hDy : D (Work.MotC2.genY E) = 3 * (Work.MotC2.genX E) ^ 2 +
        2 * algebraMap N (Work.MotC2.Func E) E.a₂ * Work.MotC2.genX E +
        algebraMap N (Work.MotC2.Func E) E.a₄ -
        algebraMap N (Work.MotC2.Func E) E.a₁ * Work.MotC2.genY E) :
    ∀ a : WeierstrassCurve.Affine.CoordinateRing E,
      ∃ b : WeierstrassCurve.Affine.CoordinateRing E,
        algebraMap (WeierstrassCurve.Affine.CoordinateRing E) (Work.MotC2.Func E) b =
          D (algebraMap (WeierstrassCurve.Affine.CoordinateRing E) (Work.MotC2.Func E) a) := by
  intro a
  set S : Set (MotC2.Func E) := {MotC2.genX E, MotC2.genY E} with hS
  have hgenX : MotC2.genX E ∈ Algebra.adjoin N S :=
    Algebra.subset_adjoin (by rw [hS]; exact Or.inl rfl)
  have hgenY : MotC2.genY E ∈ Algebra.adjoin N S :=
    Algebra.subset_adjoin (by rw [hS]; exact Or.inr rfl)
  have hconst : ∀ c : N, algebraMap N (MotC2.Func E) c ∈ Algebra.adjoin N S :=
    fun c => Subalgebra.algebraMap_mem _ c
  -- the two prescribed values of `D` are polynomials in `x` and `y`, hence lie in the subalgebra
  -- generated by them
  have hDxmem : D (MotC2.genX E) ∈ Algebra.adjoin N S := by
    rw [hDx]
    have h2 : (2 : MotC2.Func E) ∈ Algebra.adjoin N S := by simp
    exact add_mem (add_mem (mul_mem h2 hgenY) (mul_mem (hconst E.a₁) hgenX)) (hconst E.a₃)
  have hDymem : D (MotC2.genY E) ∈ Algebra.adjoin N S := by
    rw [hDy]
    have h2 : (2 : MotC2.Func E) ∈ Algebra.adjoin N S := by simp
    have h3 : (3 : MotC2.Func E) ∈ Algebra.adjoin N S := by simp
    exact sub_mem
      (add_mem (add_mem (mul_mem h3 (pow_mem hgenX 2))
        (mul_mem (mul_mem h2 (hconst E.a₂)) hgenX)) (hconst E.a₄))
      (mul_mem (hconst E.a₁) hgenY)
  -- hence `D` preserves the whole coordinate ring
  have hmaps : ∀ x ∈ MotC2.affRing E, D x ∈ MotC2.affRing E := by
    intro x hx
    rw [MotC2.affRing_eq_adjoin (L := N), ← hS] at hx ⊢
    exact deriv_maps_adjoin D S (by rintro s (rfl | rfl) <;> assumption) x hx
  have hmem : algebraMap (MotC2.Coord E) (MotC2.Func E) a ∈ MotC2.affRing E := by
    rw [MotC2.affRing]
    exact Algebra.subset_adjoin ⟨a, rfl⟩
  have hDmem := hmaps _ hmem
  rw [affRing_eq_algHom_range] at hDmem
  rcases hDmem with ⟨b, hb⟩
  exact ⟨b, hb⟩

end

end Work.MotV
