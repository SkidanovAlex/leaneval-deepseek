namespace Work.MotV

open WeierstrassCurve WeierstrassCurve.Affine Polynomial

variable {N : Type*} [Field N]

section CharP

/-- The affine coordinate ring of a curve over a field of characteristic `p` has characteristic
`p`. -/
instance instCharP_coord (p : ℕ) [CharP N p] (E : WeierstrassCurve N) :
    CharP (MotC2.Coord E) p :=
  charP_of_injective_algebraMap (FaithfulSMul.algebraMap_injective N (MotC2.Coord E)) p

/-- The function field of a curve over a field of characteristic `p` has characteristic `p`. -/
instance instCharP_funcField (p : ℕ) [CharP N p] (E : WeierstrassCurve N) :
    CharP (MotC2.Func E) p :=
  IsFractionRing.charP_of_isFractionRing (MotC2.Coord E) p

end CharP

/-! ## The subfield of `p`-th powers -/

/-- The subfield of `p`-th powers of a field `K`, as the range of the Frobenius endomorphism. -/
def PthPow (K : Type*) [Field K] (p : ℕ) [ExpChar K p] : Subfield K :=
  (frobenius K p).fieldRange

theorem mem_PthPow {K : Type*} [Field K] {p : ℕ} [ExpChar K p] {z : K} :
    z ∈ PthPow K p ↔ ∃ w : K, w ^ p = z := by
  rw [PthPow, RingHom.mem_fieldRange]
  exact exists_congr (fun w => by rw [frobenius_def])

/-- A derivation kills `p`-th powers (its base ring is irrelevant for this). -/
theorem deriv_eq_zero_of_mem_PthPow {K R : Type*} [Field K] [CommSemiring R] [Algebra R K]
    {p : ℕ} [Fact p.Prime] [CharP K p] (D : Derivation R K K) {z : K}
    (hz : z ∈ PthPow K p) : D z = 0 := by
  obtain ⟨w, rfl⟩ := mem_PthPow.mp hz
  have h := D.leibniz_pow (a := w) p
  have hp0 : ((p : ℕ) : K) = 0 := CharP.cast_eq_zero K p
  rw [h]
  simp only [nsmul_eq_mul, hp0, zero_mul, zero_smul]

/-! ## `N(E)^p(γ)`, the subfield generated by the `p`-th powers and one element -/

section Curve

variable (p : ℕ) [Fact p.Prime] [CharP N p] (E : WeierstrassCurve N)

instance instIsAlgebraic_PthPow : Algebra.IsAlgebraic (PthPow (MotC2.Func E) p) (MotC2.Func E) where
  isAlgebraic z := by
    refine ⟨X ^ p - C (⟨z ^ p, by rw [mem_PthPow]; exact ⟨z, rfl⟩⟩ : ↥(PthPow _ p)), ?_, ?_⟩
    · exact (monic_X_pow_sub_C _ (Fact.out : Nat.Prime p).ne_zero).ne_zero
    · rw [map_sub, map_pow, aeval_X, aeval_C, sub_eq_zero]
      rfl

/-- The subfield `N(E)^p(γ)` generated by the `p`-th powers and `γ`.  Its carrier is the
`N(E)^p`-subalgebra generated by `γ`, which is a field because `N(E)` is algebraic over `N(E)^p`. -/
noncomputable def KpAdjoin (γ : MotC2.Func E) : Subfield (MotC2.Func E) where
  carrier := (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ} : Set (MotC2.Func E))
  add_mem' := fun ha hb => (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).add_mem ha hb
  zero_mem' := (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).zero_mem
  mul_mem' := fun ha hb => (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).mul_mem ha hb
  one_mem' := (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).one_mem
  neg_mem' := fun ha => (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).neg_mem ha
  inv_mem' := by
    intro a ha
    by_cases ha0 : a = 0
    · simpa [ha0] using (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).zero_mem
    · have hF : IsField ↥(Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}) :=
        Subalgebra.isField_of_algebraic _
      obtain ⟨b, hb⟩ := hF.mul_inv_cancel
        (show (⟨a, ha⟩ : ↥(Algebra.adjoin (PthPow (MotC2.Func E) p) {γ})) ≠ 0 from
          fun h => ha0 (by simpa using congrArg Subtype.val h))
      have hb' : a * (b : MotC2.Func E) = 1 := by
        simpa using congrArg Subtype.val hb
      rw [inv_eq_of_mul_eq_one_right hb']
      exact b.2

theorem mem_KpAdjoin_iff (γ z : MotC2.Func E) :
    z ∈ KpAdjoin p E γ ↔ z ∈ Algebra.adjoin (PthPow (MotC2.Func E) p) {γ} := Iff.rfl

theorem mem_KpAdjoin_of_mem_PthPow (γ : MotC2.Func E) {z : MotC2.Func E}
    (hz : z ∈ PthPow (MotC2.Func E) p) : z ∈ KpAdjoin p E γ :=
  (Algebra.adjoin (PthPow (MotC2.Func E) p) {γ}).algebraMap_mem ⟨z, hz⟩

theorem mem_KpAdjoin_self (γ : MotC2.Func E) : γ ∈ KpAdjoin p E γ :=
  Algebra.subset_adjoin (Set.mem_singleton γ)

end Curve

/-! ## Constants are `p`-th powers over an algebraically closed field -/

theorem algebraMap_mem_PthPow [IsAlgClosed N] (p : ℕ) [Fact p.Prime] [CharP N p]
    (E : WeierstrassCurve N) (c : N) :
    algebraMap N (MotC2.Func E) c ∈ PthPow (MotC2.Func E) p := by
  have hdeg : (X ^ p - C c : Polynomial N).degree ≠ 0 := by
    rw [degree_X_pow_sub_C (Fact.out : Nat.Prime p).pos]
    exact_mod_cast (Fact.out : Nat.Prime p).ne_zero
  obtain ⟨w, hw⟩ := IsAlgClosed.exists_root (X ^ p - C c) hdeg
  rw [IsRoot, eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at hw
  refine mem_PthPow.mpr ⟨algebraMap N (MotC2.Func E) w, ?_⟩
  rw [← map_pow, hw]

/-! ## Generating the function field by the two coordinates -/

section Generate

variable (E : WeierstrassCurve N)

/-- A subfield of `N(E)` containing the constants and both coordinates `x`, `y` is everything:
every element of `N(E)` is a quotient of two polynomial expressions in `x` and `y`. -/
theorem eq_top_of_mem_genX_genY (S : Subfield (MotC2.Func E))
    (hN : ∀ c : N, algebraMap N (MotC2.Func E) c ∈ S)
    (hx : MotC2.genX E ∈ S) (hy : MotC2.genY E ∈ S) : S = ⊤ := by
  let S' : Subalgebra N (MotC2.Func E) :=
    { carrier := (S : Set (MotC2.Func E))
      add_mem' := fun ha hb => S.add_mem ha hb
      zero_mem' := S.zero_mem
      mul_mem' := fun ha hb => S.mul_mem ha hb
      one_mem' := S.one_mem
      algebraMap_mem' := hN }
  have haff : MotC2.affRing E ≤ S' := by
    rw [MotC2.affRing_eq_adjoin_genX_genY E]
    refine Algebra.adjoin_le_iff.mpr ?_
    rintro z (rfl | rfl)
    · exact hx
    · exact hy
  refine eq_top_iff.mpr fun z _ => ?_
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (MotC2.Coord E) z
  have hmem : ∀ a : MotC2.Coord E, algebraMap (MotC2.Coord E) (MotC2.Func E) a ∈ S := fun a =>
    haff (Algebra.subset_adjoin ⟨a, rfl⟩)
  have hb0 : algebraMap (MotC2.Coord E) (MotC2.Func E) b ≠ 0 := by
    simpa using (mem_nonZeroDivisors_iff_ne_zero.mp hb)
  rw [← hab, div_eq_mul_inv]
  exact S.mul_mem (hmem a) (S.inv_mem (hmem b))

end Generate

end Work.MotV
