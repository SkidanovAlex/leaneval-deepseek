# Coordinate rings of a Weierstrass curve: generation statements

This file collects the elementary generation statements about the affine coordinate ring
`Coord E = L[X,Y]/(W_E)` and the chart-at-infinity coordinate ring `infCoordRing E = L[u,w]`
(`u = 1/x`, `w = y/x²`) that the classification of rational places of `L(E)` needs.

## Main results

* `Work.MotC2.adjoin_coordX_coordY`: the affine coordinate ring is generated over `L` by `x` and `y`.
* `Work.MotC2.adjoin_infU_infW`: the chart-at-infinity coordinate ring is generated over `L` by its
  own coordinates `u` and `w`.
* `Work.MotC2.quot_infCoordRing_surjective`: the quotient of the chart ring by `(u, w)` is generated
  as an `L`-algebra by the empty set, i.e. the structure map `L → infCoordRing E ⧸ (u,w)` is
  surjective.
* `Work.MotC2.mem_infCoordIdeal_iff`: the ideal `(u, w) = infCoordIdeal E` of the chart ring is the
  chart-ring part of the submodule `infIdeal E` of `L(E)`.
-/

import Mathlib
import Submission.Work.MotC2.Defs

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

open Polynomial WeierstrassCurve.Affine

namespace Work.MotC2

variable {L : Type*} [Field L]

/-! ## The fraction field of a subalgebra of `L(E)` -/

/-- If the non-zero elements of an `L`-subalgebra `S ≤ L(E)` generate `L(E)` by division, then
`L(E)` is the fraction field of `S`. -/
theorem isFractionRing_of_forall_mul_eq {E : WeierstrassCurve L} {S : Subalgebra L (Func E)}
    (h : ∀ f : Func E, ∃ s₁ s₂ : S, (s₂ : Func E) ≠ 0 ∧ f * (s₂ : Func E) = (s₁ : Func E)) :
    IsFractionRing S (Func E) := by
  have hinj : Function.Injective (algebraMap S (Func E)) := fun x y hxy => Subtype.ext hxy
  have : IsDomain S := hinj.isDomain
  refine (isLocalization_iff (nonZeroDivisors S) (Func E)).mpr ⟨?_, ?_, ?_⟩
  · intro y
    rw [isUnit_iff_ne_zero]
    intro h0
    exact (mem_nonZeroDivisors_iff_ne_zero.mp y.2)
      (hinj (by rw [h0, map_zero]))
  · intro z
    obtain ⟨s₁, s₂, hs₂, hz⟩ := h z
    refine ⟨(s₁, ⟨s₂, mem_nonZeroDivisors_of_ne_zero (fun h0 => hs₂ (by simp [h0]))⟩), ?_⟩
    simpa using hz
  · intro x y hxy
    exact ⟨1, by simpa using hinj hxy⟩

/-! ## The affine coordinate ring is generated by `x` and `y` -/

theorem adjoin_coordX_coordY (E : WeierstrassCurve L) :
    Algebra.adjoin L ({coordX E, coordY E} : Set (Coord E)) = ⊤ := by
  have h := Algebra.adjoin_eq_adjoin_union L ({Polynomial.X} : Set L[X])
      ({AdjoinRoot.root (polynomial E)} : Set (AdjoinRoot (polynomial E)))
      (Polynomial.adjoin_X (R := L))
  have hroot : Algebra.adjoin (L[X]) ({AdjoinRoot.root (polynomial E)} : Set (Coord E)) = ⊤ :=
    AdjoinRoot.adjoinRoot_eq_top
  rw [hroot] at h
  simp only [Subalgebra.restrictScalars_top] at h
  have hX : (algebraMap (L[X]) (Coord E)) '' ({Polynomial.X} : Set L[X]) = {coordX E} := by
    rw [Set.image_singleton]
    exact congrArg Set.singleton (algebraMap_X_eq_coordX E)
  rw [hX, Set.singleton_union] at h
  exact h.symm

/-! ## The classes of `X - a` and `Y - b` -/

lemma XClass_eq_coordX_sub (E : WeierstrassCurve L) (a : L) :
    CoordinateRing.XClass E a = coordX E - algebraMap L (Coord E) a := by
  rw [CoordinateRing.XClass, CoordinateRing.mk, Polynomial.C_sub, map_sub, AdjoinRoot.mk_C,
    AdjoinRoot.mk_C, of_poly_C]
  rfl

lemma YClass_eq_coordY_sub (E : WeierstrassCurve L) (b : L) :
    CoordinateRing.YClass E (Polynomial.C b) = coordY E - algebraMap L (Coord E) b := by
  rw [CoordinateRing.YClass, CoordinateRing.mk, map_sub, AdjoinRoot.mk_X, AdjoinRoot.mk_C,
    of_poly_C]
  rfl

/-! ## The chart-at-infinity coordinate ring -/

lemma infCoordRing_smul_eq_mul (E : WeierstrassCurve L) (a : infCoordRing E) (x : Func E) :
    a • x = (a : Func E) * x := by
  rw [Subalgebra.smul_def, Algebra.smul_def]
  simp

theorem adjoin_infU_infW (E : WeierstrassCurve L) :
    Algebra.adjoin L ({⟨infU E, Algebra.subset_adjoin (by simp)⟩,
      ⟨infW E, Algebra.subset_adjoin (by simp)⟩} : Set (infCoordRing E)) = ⊤ := by
  have hinj : Function.Injective (Subalgebra.val (infCoordRing E)) := fun x y h => Subtype.ext h
  apply Subalgebra.map_injective hinj
  rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rfl

theorem quot_infCoordRing_surjective (E : WeierstrassCurve L) :
    Function.Surjective (algebraMap L ((infCoordRing E) ⧸ Ideal.span
      ({⟨infU E, Algebra.subset_adjoin (by simp)⟩,
        ⟨infW E, Algebra.subset_adjoin (by simp)⟩} : Set (infCoordRing E)))) := by
  set I : Ideal (infCoordRing E) := Ideal.span
      ({⟨infU E, Algebra.subset_adjoin (by simp)⟩,
        ⟨infW E, Algebra.subset_adjoin (by simp)⟩} : Set (infCoordRing E)) with hI
  change Function.Surjective (algebraMap L (infCoordRing E ⧸ I))
  intro x
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
  have ht : t ∈ Algebra.adjoin L ({⟨infU E, Algebra.subset_adjoin (by simp)⟩,
        ⟨infW E, Algebra.subset_adjoin (by simp)⟩} : Set (infCoordRing E)) := by
    rw [adjoin_infU_infW E]; trivial
  refine Algebra.adjoin_induction (p := fun t _ => ∃ c : L,
      algebraMap L (infCoordRing E ⧸ I) c = Ideal.Quotient.mk I t) ?_ ?_ ?_ ?_ ht
  · intro y hy
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hy)).symm
  · intro c
    exact ⟨c, by
      rw [IsScalarTower.algebraMap_apply L (infCoordRing E) (infCoordRing E ⧸ I),
        Ideal.Quotient.algebraMap_eq]⟩
  · intro p q hp hq ihp ihq
    obtain ⟨c₁, h₁⟩ := ihp
    obtain ⟨c₂, h₂⟩ := ihq
    exact ⟨c₁ + c₂, by rw [map_add (algebraMap L (infCoordRing E ⧸ I)) c₁ c₂, h₁, h₂,
      ← map_add (Ideal.Quotient.mk I) p q]⟩
  · intro p q hp hq ihp ihq
    obtain ⟨c₁, h₁⟩ := ihp
    obtain ⟨c₂, h₂⟩ := ihq
    exact ⟨c₁ * c₂, by rw [map_mul (algebraMap L (infCoordRing E ⧸ I)) c₁ c₂, h₁, h₂,
      ← map_mul (Ideal.Quotient.mk I) p q]⟩

noncomputable def infCoordIdeal (E : WeierstrassCurve L) : Ideal (infCoordRing E) :=
  Ideal.span ({⟨infU E, Algebra.subset_adjoin (by simp)⟩,
    ⟨infW E, Algebra.subset_adjoin (by simp)⟩} : Set (infCoordRing E))

lemma mem_infCoordIdeal_iff (E : WeierstrassCurve L) (r : infCoordRing E) :
    r ∈ infCoordIdeal E ↔ (r : Func E) ∈ infIdeal E := by
  constructor
  · intro hr
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hr
    rw [infIdeal, Submodule.mem_span_pair]
    refine ⟨a, b, ?_⟩
    have hab' : (a : Func E) * infU E + (b : Func E) * infW E = (r : Func E) := by
      simpa using congrArg (Subtype.val) hab
    rw [infCoordRing_smul_eq_mul, infCoordRing_smul_eq_mul]
    exact hab'
  · intro hr
    rw [infIdeal, Submodule.mem_span_pair] at hr
    obtain ⟨a, b, hab⟩ := hr
    rw [infCoordIdeal, Ideal.mem_span_pair]
    refine ⟨a, b, ?_⟩
    apply Subtype.ext
    have hab' : (a : Func E) * infU E + (b : Func E) * infW E = (r : Func E) := by
      rw [infCoordRing_smul_eq_mul, infCoordRing_smul_eq_mul] at hab
      exact hab
    simpa using hab'

end Work.MotC2
