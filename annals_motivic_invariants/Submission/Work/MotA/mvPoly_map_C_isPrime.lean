namespace Work.MotA

/-- If `p` is a prime ideal of `R`, then the ideal of `MvPolynomial σ R` generated by the
image of `p` under `C` is prime.

The idea is that `MvPolynomial σ R ⧸ p·MvPolynomial σ R` is the polynomial ring
`MvPolynomial σ (R ⧸ p)`, which is a domain; formally, we use that the kernel of the
surjection `MvPolynomial.map (Ideal.Quotient.mk p)` is prime (it is the kernel of a ring
homomorphism into the domain `MvPolynomial σ (R ⧸ p)`), and identify this kernel with
`p·MvPolynomial σ R` via `MvPolynomial.ker_map`. -/
theorem mvPoly_map_C_isPrime (R : Type) [CommRing R] (σ : Type) {p : Ideal R} (hp : p.IsPrime) : (Ideal.map (MvPolynomial.C : R →+* MvPolynomial σ R) p).IsPrime := by
  have hp' : p.IsPrime := hp
  have h : RingHom.ker (MvPolynomial.map (Ideal.Quotient.mk p) :
      MvPolynomial σ R →+* MvPolynomial σ (R ⧸ p)) =
      Ideal.map (MvPolynomial.C : R →+* MvPolynomial σ R) p := by
    rw [MvPolynomial.ker_map, Ideal.mk_ker]
  rw [← h]
  exact RingHom.ker_isPrime _

end Work.MotA
