open MvPolynomial

/-! ## Elementary computations with `MvPolynomial.rename` and single-variable substitution -/

/-- Substituting one variable commutes with renaming: `rename f` sends
`Polynomial.aeval (X i) g` to `Polynomial.aeval (X (f i)) g`. -/
lemma rename_aeval_X {𝕜 : Type} [CommSemiring 𝕜] {σ τ : Type} (f : σ → τ) (i : σ)
    (g : Polynomial 𝕜) :
    MvPolynomial.rename f
        (Polynomial.aeval (MvPolynomial.X i : MvPolynomial σ 𝕜) g) =
      Polynomial.aeval (MvPolynomial.X (f i) : MvPolynomial τ 𝕜) g := by
  have h : ((MvPolynomial.rename f).comp
        (Polynomial.aeval (MvPolynomial.X i : MvPolynomial σ 𝕜)))
      = Polynomial.aeval (MvPolynomial.X (f i) : MvPolynomial τ 𝕜) := by
    apply Polynomial.algHom_ext
    simp
  exact congrArg (fun φ => φ g) h

/-- The algebra equivalence `MvPolynomial (Fin 1) 𝕜 ≃ₐ[𝕜] Polynomial 𝕜` sends `Polynomial.X`
to the single variable `X 0` in the inverse direction. -/
lemma uniqueAlgEquiv_symm_X (𝕜 : Type) [CommSemiring 𝕜] :
    ((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm Polynomial.X : MvPolynomial (Fin 1) 𝕜) =
      MvPolynomial.X 0 := by
  rw [AlgEquiv.symm_apply_eq]
  simp [MvPolynomial.uniqueAlgEquiv_apply]

/-- `Fin.castAdd n` fixes `0`. -/
lemma castAdd_zero_fin_one (n : ℕ) : Fin.castAdd n (0 : Fin 1) = (0 : Fin (1 + n)) := by
  ext; simp

/-- **`A1` key computation.**  The image of `g` under the composite
`Polynomial 𝕜 ≃ₐ MvPolynomial (Fin 1) 𝕜 → MvPolynomial (Fin (1+n)) 𝕜` (which adjoins `n` new
coefficient variables and then views the result in `1+n` variables) is
`Polynomial.aeval (X 0) g` in `MvPolynomial (Fin (1+n)) 𝕜`. -/
lemma rename_castAdd_uniqueAlgEquiv_symm (𝕜 : Type) [CommSemiring 𝕜] (n : ℕ)
    (g : Polynomial 𝕜) :
    MvPolynomial.rename (Fin.castAdd n)
        ((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g : MvPolynomial (Fin 1) 𝕜) =
      (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (1 + n)) 𝕜) g) := by
  have h2 : ((MvPolynomial.rename (Fin.castAdd n)).comp
      ((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm :
        Polynomial 𝕜 →ₐ[𝕜] MvPolynomial (Fin 1) 𝕜))
      = Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (1+n)) 𝕜) := by
    apply Polynomial.algHom_ext
    rw [Polynomial.aeval_X]
    show MvPolynomial.rename (Fin.castAdd n)
      ((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm Polynomial.X) =
        (MvPolynomial.X 0 : MvPolynomial (Fin (1+n)) 𝕜)
    rw [uniqueAlgEquiv_symm_X 𝕜, MvPolynomial.rename_X, castAdd_zero_fin_one n]
  exact congrArg (fun φ => φ g) h2

/-- Reindexing `Fin (1+n) ≃ Fin (n+1)` (which fixes `0`) leaves `Polynomial.aeval (X 0) g`
unchanged. -/
lemma renameEquiv_finCongr_aeval_X0 (𝕜 : Type) [CommSemiring 𝕜] (n : ℕ) (g : Polynomial 𝕜) :
    MvPolynomial.renameEquiv 𝕜 (finCongr (Nat.add_comm 1 n))
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (1 + n)) 𝕜) g) =
      (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) 𝕜) g) := by
  rw [MvPolynomial.renameEquiv_apply]
  rw [rename_aeval_X (finCongr (Nat.add_comm 1 n)) 0 g]
  have h0 : finCongr (Nat.add_comm 1 n) (0 : Fin (1+n)) = (0 : Fin (n+1)) := by
    rw [finCongr_apply, Fin.cast_zero]
  rw [h0]

/-- **`S1` census, vertical primes.**  For `g ∈ 𝕜[t]` irreducible, the quotient of `𝕜[t,x₁,…,xₙ]` by
the ideal `(g(t))` generated by `g` (viewed as a polynomial in the first variable) is the polynomial
ring in `x₁,…,xₙ` over the residue field `𝕜[t]/(g)`:
`𝕜[t,x₁,…,xₙ] ⧸ (g(t)) ≃ₐ[𝕜] MvPolynomial (Fin n) (𝕜[t] ⧸ (g))`.

Together with `Work.MotA.resEquiv_iff_fractionRing` (`A2b`) this identifies the residue field of a
"vertical" codimension-one point `(g(t))` as `FractionRing ((𝕜[t]/g)[x₁,…,xₙ])`, the class that
`SPREAD` must separate from the horizontal (function-field) classes.

Route.  This is `Work.MotA.quotient_map_rename` (proved, `MotA/quotient_map_rename.lean`) with
`n := 1`, `k := n` and `p := Ideal.span {g}`: identify `Polynomial 𝕜 ≃ₐ[𝕜] MvPolynomial (Fin 1) 𝕜`
(`MvPolynomial.pUnitAlgEquiv` with `Fin 1 ≃ PUnit`), note
`Polynomial.aeval (MvPolynomial.X 0) g` corresponds to `MvPolynomial.rename (Fin.castAdd n) g`
under the reindexing `Fin (1+n) ≃ Fin (n+1)`, and use `hg` to get `(Ideal.span {g}).IsPrime`
(`Ideal.span_singleton_prime`).  A useful companion helper (provable in the same file, and used by
the census): `Prime (Polynomial.aeval (MvPolynomial.X 0) g)` — it follows because the quotient is a
domain, and it gives the height-one point defined by `(g(t))` directly. -/
theorem quotient_vertical (𝕜 : Type) [Field 𝕜] (n : ℕ) (g : Polynomial 𝕜) (hg : Prime g) :
    Nonempty ((MvPolynomial (Fin (n + 1)) 𝕜 ⧸
        Ideal.span {(Polynomial.aeval (MvPolynomial.X 0) g : MvPolynomial (Fin (n + 1)) 𝕜)})
      ≃ₐ[𝕜] MvPolynomial (Fin n) (Polynomial 𝕜 ⧸ Ideal.span {g})) := by
  classical
  -- The element of `𝕜[x]` corresponding to `g` under `𝕜[x] ≃ₐ[𝕜] 𝕜[X]` is prime, so the ideal it
  -- generates is a prime ideal and `quotient_map_rename` may be applied to it.
  have hne : ((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g : MvPolynomial (Fin 1) 𝕜) ≠ 0 := by
    intro h
    have h1 := congrArg (MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)) h
    rw [AlgEquiv.apply_symm_apply, map_zero] at h1
    exact hg.ne_zero h1
  haveI hp : (Ideal.span {((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g :
      MvPolynomial (Fin 1) 𝕜)}).IsPrime := by
    rw [Ideal.span_singleton_prime hne]
    exact (MulEquiv.prime_iff (MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm.toMulEquiv).mpr hg
  -- `A3` with one new variable: `𝕜[Fin (1+n)] ⧸ (g) ≅ 𝕜[Fin n] ⊗ 𝕜[Fin 1] ⧸ (g)`.
  obtain ⟨φ₀⟩ := quotient_map_rename 𝕜 1 n
    (Ideal.span {((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g : MvPolynomial (Fin 1) 𝕜)})
  -- The comparison of the two ideals (in the `1+n` and in the `n+1` indexings).
  have hρ : Ideal.span {(Polynomial.aeval (MvPolynomial.X 0) g : MvPolynomial (Fin (n+1)) 𝕜)}
      = Ideal.map (↑(MvPolynomial.renameEquiv 𝕜 (finCongr (Nat.add_comm 1 n))))
          (Ideal.map (MvPolynomial.rename (Fin.castAdd n))
            (Ideal.span {((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g :
              MvPolynomial (Fin 1) 𝕜)})) := by
    rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton]
    rw [rename_castAdd_uniqueAlgEquiv_symm 𝕜 n g, renameEquiv_finCongr_aeval_X0 𝕜 n g]
  -- The identification of the coefficient ring `𝕜[Fin 1] ⧸ (g)` with `𝕜[X] ⧸ (g)`.
  have he_map : Ideal.span {g} = Ideal.map (↑(MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)))
      (Ideal.span {((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g :
        MvPolynomial (Fin 1) 𝕜)}) := by
    rw [Ideal.map_span, Set.image_singleton, AlgEquiv.apply_symm_apply]
  let he : (MvPolynomial (Fin 1) 𝕜 ⧸
        Ideal.span {((MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)).symm g : MvPolynomial (Fin 1) 𝕜)})
      ≃ₐ[𝕜] (Polynomial 𝕜 ⧸ Ideal.span {g}) :=
    Ideal.quotientEquivAlg _ _ (MvPolynomial.uniqueAlgEquiv 𝕜 (Fin 1)) he_map
  exact ⟨(Ideal.quotientEquivAlg _ _
      (MvPolynomial.renameEquiv 𝕜 (finCongr (Nat.add_comm 1 n))) hρ).symm.trans
    (φ₀.trans (MvPolynomial.mapAlgEquiv (Fin n) he))⟩

end Work.MotA
