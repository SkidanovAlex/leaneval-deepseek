/-!
# `A1`: the basic-open formula

The key simplification of the whole development: an isomorphism of the localisations of
`𝕜[x₁,…,xₙ]` away from two nonzero polynomials `F` and `G` produces a Cremona transformation whose
`[κ(z)]`-coefficient is the difference `divCount 𝕜 n F z - divCount 𝕜 n G z`.  Whenever that
difference is nonzero, `Cr 𝕜 n` is not generated by pseudo-regularizable elements.

This assembles `Work.MotA.exists_awayBirationalMap_cInv` (the construction of the Cremona
transformation in the `Spec 𝕜[x]` model, with the coefficient computation) and
`Work.MotA.not_gen_of_cInv_ne_zero_polySpec` (the transport to `Cr 𝕜 n`).
-/

noncomputable section

namespace Work.MotA

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme MotivicInvariants

/-- **`A1`, the basic-open formula.**  If the localisations of `𝕜[x₁,…,xₙ]` away from two nonzero
polynomials `F`, `G` are isomorphic as `𝕜`-algebras, and if some base point `z` distinguishes the
two divisor counts `divCount 𝕜 n F z` and `divCount 𝕜 n G z`, then `Cr 𝕜 n` is not generated by
pseudo-regularizable elements. -/
theorem not_gen_of_awayAlgEquiv (𝕜 : Type) [Field 𝕜] (n : ℕ)
    (F G : MvPolynomial (Fin n) 𝕜) (hF : F ≠ 0) (hG : G ≠ 0)
    (Φ : Localization.Away F ≃ₐ[𝕜] Localization.Away G)
    {Z : AlgebraicGeometry.Scheme.{0}}
    [Z.Over (AlgebraicGeometry.Spec (CommRingCat.of 𝕜))] (z : Z)
    (h : divCount 𝕜 n F z ≠ divCount 𝕜 n G z) :
    ¬ GenByPseudoRegularizable 𝕜 n := by
  obtain ⟨f, hfover, hfc⟩ := exists_awayBirationalMap_cInv 𝕜 n F G hF hG Φ
  refine not_gen_of_cInv_ne_zero_polySpec 𝕜 n
    ⟨Z, inferInstance, z, f, hfover, ?_⟩
  intro hzero
  have h2 : (divCount 𝕜 n F z : ℤ) = (divCount 𝕜 n G z : ℤ) := by
    have h3 := hfc (Z := Z) z
    rw [hzero] at h3
    linarith
  exact h (Nat.cast_injective h2)

end Work.MotA
