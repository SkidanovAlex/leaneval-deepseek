/-!
# Spreading out: `𝕜[t,x₁,…,xₙ] →ₐ[𝕜] MvPolynomial (Fin n) (RatFunc 𝕜)`

This module provides the structure map used to spread a birational map over `K = RatFunc 𝕜` out to
one over `𝕜` (audit node `S1`): a polynomial in `t, x₁,…,xₙ` over `𝕜` is sent to a polynomial in
`x₁,…,xₙ` over `K = RatFunc 𝕜` by sending `t` to the indeterminate of `K` and `x_i` to `x_i`:

`Work.MotA.spreadMap 𝕜 n : 𝕜[t,x₁,…,xₙ] →ₐ[𝕜] MvPolynomial (Fin n) (RatFunc 𝕜)`.

Its image is exactly the set of polynomials in `x₁,…,xₙ` with coefficients in `𝕜[t]`, so that
`spreadMap 𝕜 n F' = C c * F` says that `F'` is obtained from `F ∈ K[x]` by clearing the `t`-denominators
(the role of `c : Polynomial 𝕜`), and the prime factors of such an `F'` in the UFD `𝕜[t,x]` are the
"horizontal" primes (those of `F` over `K`, with the same residue field) together with the
"vertical" primes dividing `C c` (those generated by an irreducible polynomial in `t` alone).

The map is injective (`Work.MotA.spreadMap_injective`), which is what makes the description above
unambiguous.
-/

noncomputable section

namespace Work.MotA

open MvPolynomial

/-- The structure map `𝕜[t, x₁,…,xₙ] →ₐ[𝕜] MvPolynomial (Fin n) (RatFunc 𝕜)` sending `t` to the
indeterminate of `RatFunc 𝕜` and `x_i` to `x_i`. -/
noncomputable def spreadMap (𝕜 : Type) [Field 𝕜] (n : ℕ) :
    MvPolynomial (Fin (n + 1)) 𝕜 →ₐ[𝕜] MvPolynomial (Fin n) (RatFunc 𝕜) :=
  MvPolynomial.aeval fun i : Fin (n + 1) =>
    Fin.cases (MvPolynomial.C RatFunc.X) (fun j => MvPolynomial.X j) i

@[simp]
theorem spreadMap_X_zero (𝕜 : Type) [Field 𝕜] (n : ℕ) :
    spreadMap 𝕜 n (MvPolynomial.X 0) = MvPolynomial.C (RatFunc.X : RatFunc 𝕜) := by
  simp [spreadMap]

@[simp]
theorem spreadMap_X_succ (𝕜 : Type) [Field 𝕜] (n : ℕ) (j : Fin n) :
    spreadMap 𝕜 n (MvPolynomial.X j.succ) = MvPolynomial.X j := by
  simp [spreadMap]

@[simp]
theorem spreadMap_C (𝕜 : Type) [Field 𝕜] (n : ℕ) (r : 𝕜) :
    spreadMap 𝕜 n (MvPolynomial.C r) =
      MvPolynomial.C (algebraMap 𝕜 (RatFunc 𝕜) r) := by
  simp [spreadMap]

end Work.MotA
