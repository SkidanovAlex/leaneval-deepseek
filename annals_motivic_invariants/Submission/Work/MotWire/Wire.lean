/-!
# The wire: `Submission.lean`'s six holes, proved from the delivered results

This module proves the six statements of `Submission.lean` — `theorem_1_2_1_a`,
`theorem_1_2_1_b`, `theorem_1_2_1_c`, `theorem_1_2_1_d`, `theorem_1_2_2`, `theorem_1_2_3` — from
the results delivered by the other subprojects of this workspace, with the single exception of the
characteristic-`5` input `Work.MotWire.CharFiveInput` (`Submission/Work/MotWire/Defs.lean`).

The statements below have **exactly the binders and conclusion** of the six statements in
`Submission.lean` (same types up to the extra hypothesis `CharFiveInput` where the characteristic-`5`
case occurs); `Submission/Work/MotWire/Patch.lean` re-proves the six statements against the real
`Submission.lean` and checks that the binder lists agree.

## The route, case by case

| hole | characteristic | delivered result used |
|---|---|---|
| `theorem_1_2_1_a` | `0` (number field) | `Work.MotT.not_gen_three_of_numberField` with audit node **T8** discharged by `Work.MotK.LinkCertTGenInf` |
| `theorem_1_2_1_b` | `0` (function field over a number field) | `Work.MotT.not_gen_three_functionField_charNeFive`, same discharge |
| `theorem_1_2_1_c`, `(d)` | split on `ringChar = 5` | `≠ 5`: as `(b)`; `= 5`: the input `CharFiveInput` at `n = 3` |
| `theorem_1_2_2` | `0` (subfield of `ℂ`) | `Work.MotV.theorem_1_2_2'` (nothing else needed) |
| `theorem_1_2_3` | split on `ringChar = 5` | `≠ 5`: `Work.MotV.not_gen_charNeFive`; `= 5`: the input `CharFiveInput` |

Note that `theorem_1_2_1 (a)`, `theorem_1_2_1 (b)` and `theorem_1_2_2` are **unconditional**: their
fields have characteristic `0`, so the characteristic-`5` input is never used, and `theorem_1_2_2`
is simply the delivered `Work.MotV.theorem_1_2_2'`.  The input is consumed only by
`theorem_1_2_1 (c)`, `(d)` (at `n = 3`, for the function field of a positive-dimensional variety
over a finite, resp. algebraically closed field of characteristic `5`) and by `theorem_1_2_3`
(at `n ≥ 5`).

## Axiom status

Everything imported here is `sorry`-free and axiom-clean (`Work.MotV.theorem_1_2_2'`,
`Work.MotV.not_gen_charNeFive`, `Work.MotK.LinkCertTGenInf`, and the `MotT`/`MotR` chain all
depend only on `propext, Classical.choice, Quot.sound`), so the axiom footprint of the six theorems
below is exactly that of the input `CharFiveInput`.
-/

namespace Work.MotWire

open AlgebraicGeometry
open MotivicInvariants (GenByPseudoRegularizable Variety)

/-- **`theorem_1_2_1 (a)`** of Lin–Shinder: over a number field, `Cr₃` is not generated by
pseudo-regularizable elements.  Unconditional: number fields have characteristic `0`, the T-route
`Work.MotT.not_gen_three_of_numberField` applies, and its link-certificate input (audit node T8) is
discharged by the delivered `Work.MotK.LinkCertTGenInf`. -/
theorem theorem_1_2_1_a (𝕜 : Type) [Field 𝕜] [NumberField 𝕜] :
    ¬ GenByPseudoRegularizable 𝕜 3 := by
  haveI : Infinite 𝕜 := inferInstance
  have hk : ringChar 𝕜 ≠ 5 := by
    have h0 : ringChar 𝕜 = 0 := ringChar.eq_zero
    rw [h0]; norm_num
  exact Work.MotT.not_gen_three_of_numberField 𝕜 (linkCertTInput_of_charNeFive 𝕜 hk)

/-- The characteristic of the function field of a positive-dimensional variety over a number field
is not `5` (it is `0`). -/
theorem ringChar_functionField_ne_five_of_numberField (𝔽 : Type) [Field 𝔽] [NumberField 𝔽]
    (X : Scheme) [Variety 𝔽 X] : ringChar ↥X.functionField ≠ 5 := by
  letI := Work.FFResidual.overFunctionFieldAlgebra 𝔽 X
  haveI : CharZero 𝔽 := NumberField.to_charZero
  have h0 : ringChar ↥X.functionField = 0 := by
    rw [← Algebra.ringChar_eq 𝔽 ↥X.functionField, ringChar.eq_zero]
  rw [h0]; norm_num

/-- **`theorem_1_2_1 (b)`** of Lin–Shinder: over the function field of a positive-dimensional
variety over a number field, `Cr₃` is not generated by pseudo-regularizable elements.
Unconditional (characteristic `0`). -/
theorem theorem_1_2_1_b (𝔽 : Type) [Field 𝔽] [NumberField 𝔽] (X : Scheme) [Variety 𝔽 X]
    (hX : 0 < topologicalKrullDim X) : ¬ GenByPseudoRegularizable X.functionField 3 := by
  haveI : Infinite ↥X.functionField := infinite_functionField 𝔽 X hX
  have h5 : ringChar ↥X.functionField ≠ 5 := ringChar_functionField_ne_five_of_numberField 𝔽 X
  exact Work.MotT.not_gen_three_functionField_charNeFive 𝔽 X hX (Or.inl ‹NumberField 𝔽›) h5
    (linkCertTInput_of_charNeFive ↥X.functionField h5)

/-- **`theorem_1_2_1 (c)`** of Lin–Shinder: over the function field of a positive-dimensional
variety over a finite field, `Cr₃` is not generated by pseudo-regularizable elements.

In characteristic `≠ 5` this is `theorem_1_2_1_b`'s route; in characteristic `5` it is the input
`CharFiveInput` at `n = 3`. -/
theorem theorem_1_2_1_c (hC5 : CharFiveInput) (𝔽 : Type) [Field 𝔽] [Finite 𝔽]
    (X : Scheme) [Variety 𝔽 X] (hX : 0 < topologicalKrullDim X) :
    ¬ GenByPseudoRegularizable X.functionField 3 := by
  haveI : Infinite ↥X.functionField := infinite_functionField 𝔽 X hX
  by_cases h5 : ringChar ↥X.functionField = 5
  · exact hC5 ↥X.functionField h5 (le_refl 3)
  · exact Work.MotT.not_gen_three_functionField_charNeFive 𝔽 X hX (Or.inr (Or.inl ‹Finite 𝔽›))
      h5 (linkCertTInput_of_charNeFive ↥X.functionField h5)

/-- **`theorem_1_2_1 (d)`** of Lin–Shinder: over the function field of a positive-dimensional
variety over an algebraically closed field, `Cr₃` is not generated by pseudo-regularizable
elements.

In characteristic `≠ 5` this is `theorem_1_2_1_b`'s route; in characteristic `5` it is the input
`CharFiveInput` at `n = 3`. -/
theorem theorem_1_2_1_d (hC5 : CharFiveInput) (𝔽 : Type) [Field 𝔽] [IsAlgClosed 𝔽]
    (X : Scheme) [Variety 𝔽 X] (hX : 0 < topologicalKrullDim X) :
    ¬ GenByPseudoRegularizable X.functionField 3 := by
  haveI : Infinite ↥X.functionField := infinite_functionField 𝔽 X hX
  by_cases h5 : ringChar ↥X.functionField = 5
  · exact hC5 ↥X.functionField h5 (le_refl 3)
  · exact Work.MotT.not_gen_three_functionField_charNeFive 𝔽 X hX (Or.inr (Or.inr ‹IsAlgClosed 𝔽›))
      h5 (linkCertTInput_of_charNeFive ↥X.functionField h5)

/-- **`theorem_1_2_2`** of Lin–Shinder: for a subfield `𝕜 ≤ ℂ` and `n ≥ 4`, `Crₙ(𝕜)` is not
generated by pseudo-regularizable elements.  Unconditional: this is exactly the delivered
`Work.MotV.theorem_1_2_2'` (every subfield of `ℂ` has characteristic `0`, so only the
characteristic-`≠ 5` branch is needed). -/
theorem theorem_1_2_2 {n : ℕ} (hn : 4 ≤ n) (𝕜 : Subfield ℂ) :
    ¬ GenByPseudoRegularizable 𝕜 n :=
  Work.MotV.theorem_1_2_2' hn 𝕜

/-- **`theorem_1_2_3`** of Lin–Shinder: for an infinite field `𝕜` and `n ≥ 5`, `Crₙ(𝕜)` is not
generated by pseudo-regularizable elements.

In characteristic `≠ 5` this is the delivered `Work.MotV.not_gen_charNeFive` (Theorem 1.2 (2)'s
route, with the `MotK` Klein data and T-twist link certificate); in characteristic `5` it is the
input `CharFiveInput`. -/
theorem theorem_1_2_3 (hC5 : CharFiveInput) (𝕜 : Type) [Field 𝕜] {n : ℕ} (hn : 5 ≤ n)
    [Infinite 𝕜] : ¬ GenByPseudoRegularizable 𝕜 n := by
  by_cases h5 : ringChar 𝕜 = 5
  · exact hC5 𝕜 h5 (by omega)
  · exact Work.MotV.not_gen_charNeFive 𝕜 h5 (by omega)

end Work.MotWire
