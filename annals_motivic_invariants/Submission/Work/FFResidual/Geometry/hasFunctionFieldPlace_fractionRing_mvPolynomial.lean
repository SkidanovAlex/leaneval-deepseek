import Mathlib
import Submission.Work.FFResidual.Defs
import Submission.Work.FFResidual.Geometry.isDiscreteValuationRing_localization_AtPrime_of_span_singleton

set_option linter.unusedVariables false -- v435-speed

namespace Work.FFResidual.Geometry

set_option linter.style.haveILetI false

-- Please declare this in namespace `Work.FFResidual.Geometry`.
-- The place is the local ring of the generic point of the hyperplane `X 0 = 0`:
-- `R := Localization.AtPrime (Ideal.span {MvPolynomial.X (0 : Fin (n+1))} : Ideal (MvPolynomial (Fin (n+1)) 𝔽))`,
-- whose maximal ideal is principal (`Localization.AtPrime.map_eq_maximalIdeal` + `Ideal.map_span`),
-- so that `R` is a discrete valuation ring (TFAE `IsDiscreteValuationRing.TFAE`, item
-- `(maximalIdeal R).IsPrincipal`), with uniformizer `algebraMap _ _ (MvPolynomial.X 0)`; the prime
-- `span {X 0}` comes from `Ideal.span_singleton_prime` and `MvPolynomial.X_prime`.
-- You may use `Work.FFResidual.Geometry.isDiscreteValuationRing_localization_AtPrime_of_span_singleton`
-- (import Submission.Work.FFResidual.Geometry.isDiscreteValuationRing_localization_AtPrime_of_span_singleton),
-- or reprove the DVR step inline.  For `IsFractionRing R (FractionRing A)` use
-- `IsFractionRing.isFractionRing_of_isDomain_of_isLocalization`, and build `Algebra R (FractionRing A)`
-- with `IsLocalization.lift`/`RingHom.toAlgebra` if the instances do not fire.
theorem hasFunctionFieldPlace_fractionRing_mvPolynomial (𝔽 : Type) [Field 𝔽] (n : ℕ) :
    Work.FFResidual.HasFunctionFieldPlace 𝔽 (FractionRing (MvPolynomial (Fin (n+1)) 𝔽)) := by
  -- The polynomial ring `A = 𝔽[X₀,…,Xₙ]` and the prime `p = (X₀)`.
  let A := MvPolynomial (Fin (n+1)) 𝔽
  let p : Ideal A := Ideal.span {MvPolynomial.X (0 : Fin (n+1))}
  have hx : (MvPolynomial.X (0 : Fin (n+1)) : A) ≠ 0 := MvPolynomial.X_ne_zero _
  have hp : p.IsPrime := (Ideal.span_singleton_prime hx).mpr (MvPolynomial.X_prime (R := 𝔽))
  letI : p.IsPrime := hp
  -- The valuation ring: the local ring of the generic point of the hyperplane `X₀ = 0`.
  let R := Localization.AtPrime p
  -- It is a discrete valuation ring (Noetherian local domain whose maximal ideal is principal).
  haveI hDVR : IsDiscreteValuationRing R :=
    isDiscreteValuationRing_localization_AtPrime_of_span_singleton hx
  -- The canonical algebra structure `R → K` on the fraction field `K = Frac A`, together with the
  -- scalar tower `A → R → K`.
  have hle : p.primeCompl ≤ nonZeroDivisors A := p.primeCompl_le_nonZeroDivisors
  letI hAlgR : Algebra R (FractionRing A) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe R (FractionRing A) p.primeCompl
      (nonZeroDivisors A) hle
  haveI hTowA : IsScalarTower A R (FractionRing A) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le R (FractionRing A) p.primeCompl
      (nonZeroDivisors A) hle
  -- `K` is the fraction field of the discrete valuation ring `R`.
  haveI hFR : IsFractionRing R (FractionRing A) := inferInstance
  -- The constants are integral at the place: `𝔽 → R → K` is a tower of algebras.  Both algebra maps
  -- into the localization are computed by the canonical ring maps of `A`.
  haveI hTowF : IsScalarTower 𝔽 R (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => by
      change algebraMap A (FractionRing A) (algebraMap 𝔽 A x) =
        algebraMap R (FractionRing A) (algebraMap A R (algebraMap 𝔽 A x))
      exact IsScalarTower.algebraMap_apply A R (FractionRing A) (algebraMap 𝔽 A x)
  -- `X₀` is a uniformizer: the maximal ideal of the local ring at `(X₀)` is generated by the image
  -- of `X₀`.
  refine ⟨{ R := R, π := algebraMap A R (MvPolynomial.X 0), isUniformizer := ?_ }⟩
  rw [← Localization.AtPrime.map_eq_maximalIdeal (I := p), Ideal.map_span, Set.image_singleton]

end Work.FFResidual.Geometry
