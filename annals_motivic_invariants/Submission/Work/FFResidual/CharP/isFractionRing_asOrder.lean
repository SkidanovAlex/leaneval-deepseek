import Mathlib
import Submission.Work.FFResidual.CharP.Order
import Submission.Work.FFResidual.CharP.asOrderMap_injective

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

set_option linter.style.haveILetI false

namespace Work.FFResidual.CharP

open Polynomial

variable {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]

/-- **Every element of the top field is a fraction of two elements of the Artin–Schreier order**:
for `z : AsTop P = 𝕜(s)`, `s ^ 5 - s = π⁻¹`, there are `x, y ∈ R[w] = R[X]/(X ^ 5 + π X ^ 4 - π)`,
`w = s⁻¹`, with `z = x / y`, i.e. `z * asOrderMap y = asOrderMap x` with `asOrderMap y ≠ 0`.

The set of such fractions is the `𝕜`-subalgebra of `AsTop` generated by `s` (it contains `s`, since
`asOrderMap` of the root is `w = s⁻¹` and every constant of `𝕜 = Frac R` is a fraction of two
elements of `R`, and it is closed under `+` and `*`), and `𝕜[s] = AsTop`. -/
private theorem asOrder_exists_fraction (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜)
    [CharP 𝕜 5] (z : P.AsTop) :
    ∃ x y : P.AsOrder, P.asOrderMap y ≠ 0 ∧ z * P.asOrderMap y = P.asOrderMap x := by
  -- The elements of `AsTop` that are quotients of two elements of the order.
  let Q : Subalgebra 𝕜 P.AsTop :=
    { carrier := {z | ∃ x y : P.AsOrder,
        P.asOrderMap y ≠ 0 ∧ z * P.asOrderMap y = P.asOrderMap x}
      mul_mem' := by
        rintro a b ⟨x₁, y₁, hy₁, h₁⟩ ⟨x₂, y₂, hy₂, h₂⟩
        refine ⟨x₁ * x₂, y₁ * y₂, ?_, ?_⟩
        · rw [map_mul]; exact mul_ne_zero hy₁ hy₂
        · simp only [map_mul] at h₁ h₂ ⊢
          rw [← h₁, ← h₂]; ring
      one_mem' := ⟨1, 1, by simp, by simp⟩
      add_mem' := by
        rintro a b ⟨x₁, y₁, hy₁, h₁⟩ ⟨x₂, y₂, hy₂, h₂⟩
        refine ⟨x₁ * y₂ + x₂ * y₁, y₁ * y₂, ?_, ?_⟩
        · rw [map_mul]; exact mul_ne_zero hy₁ hy₂
        · simp only [map_add, map_mul] at h₁ h₂ ⊢
          rw [← h₁, ← h₂]; ring
      zero_mem' := ⟨0, 1, by simp, by simp⟩
      algebraMap_mem' := by
        intro c
        -- a constant of `𝕜 = Frac R` is a fraction of two elements of `R`, hence of the order.
        obtain ⟨⟨a, b⟩, hb⟩ := IsLocalization.surj (nonZeroDivisors P.R) c
        refine ⟨algebraMap P.R P.AsOrder a, algebraMap P.R P.AsOrder b, ?_, ?_⟩
        · rw [P.asOrderMap_algebraMap, P.algebraMap_R_AsTop]
          intro h
          have h' : algebraMap P.R 𝕜 (b : P.R) = 0 :=
            (map_eq_zero_iff (algebraMap 𝕜 P.AsTop) (algebraMap 𝕜 P.AsTop).injective).mp h
          exact (mem_nonZeroDivisors_iff_ne_zero.mp b.2) (IsFractionRing.to_map_eq_zero_iff.mp h')
        · rw [P.asOrderMap_algebraMap, P.asOrderMap_algebraMap,
              P.algebraMap_R_AsTop, P.algebraMap_R_AsTop]
          rw [← map_mul, hb] }
  -- The order contains the Artin–Schreier root: `s = 1 / w`.
  have hroot : P.asRoot ∈ Q :=
    ⟨1, AdjoinRoot.root (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]),
      by rw [P.asOrderMap_root]; exact inv_ne_zero P.asRoot_ne_zero,
      by rw [P.asOrderMap_root, map_one]; exact mul_inv_cancel₀ P.asRoot_ne_zero⟩
  -- `AsTop = 𝕜[s]`, and `𝕜[s] ≤ Q` since `Q` is a `𝕜`-subalgebra containing `s`.
  have hle : Algebra.adjoin 𝕜 ({P.asRoot} : Set P.AsTop) ≤ Q := by
    refine Algebra.adjoin_le ?_
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    subst hw
    exact hroot
  have htop : (⊤ : Subalgebra 𝕜 P.AsTop) ≤ Q := by
    rw [← AdjoinRoot.adjoinRoot_eq_top (f := P.asPoly)]
    exact hle
  exact htop trivial

/-- **The Artin–Schreier order is a model of the Artin–Schreier place**: the ring `R[w]` inside
`AsTop = 𝕜(s)`, `s ^ 5 - s = π⁻¹`, generated by the uniformizer `w = s⁻¹`, has fraction field
`AsTop`. -/
theorem isFractionRing_asOrder {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]
    (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    IsFractionRing (Work.FFResidual.FunctionFieldPlace.AsOrder P) P.AsTop := by
  -- the order embeds in the top field, and every element of the top field is a fraction of two
  -- elements of the order (`asOrder_exists_fraction`).
  haveI : FaithfulSMul (P.AsOrder) P.AsTop :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (asOrderMap_injective P)
  refine IsFractionRing.of_field _ _ fun z => ?_
  obtain ⟨x, y, hy, hxy⟩ := asOrder_exists_fraction P z
  exact ⟨x, y, (eq_div_iff hy).mpr hxy⟩

end Work.FFResidual.CharP
