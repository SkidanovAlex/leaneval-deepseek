/-!
# The Eisenstein order of the Artin–Schreier place (characteristic five)

In characteristic `5`, the local model of the place of `AsTop P = 𝕜(s)`, `s ^ 5 - s = π⁻¹`, above
the place `P` is the **Eisenstein order**

  `AsOrder P = R[X] / (X ^ 5 + π X ^ 4 - π)`,

the ring `R[w]` generated by the uniformizer `w = s⁻¹` (`asRecip_pow`: `w ^ 5 + π w ^ 4 - π = 0`).
The defining polynomial is Eisenstein at the maximal ideal of `R` (`isEisensteinAt_asOrder_poly`), so
the quotient is a domain and a discrete valuation ring, with fraction field `AsTop P`
(`Submission/Work/FFResidual/CharP/Model.lean`).

## Main definitions and results

* `FunctionFieldPlace.AsOrder`, `asOrderMap` — the order and its map into the top field, with the
  `Algebra (AsOrder P) (AsTop P)` structure.
* `FunctionFieldPlace.coeff_asOrder_poly_zero`, `isEisensteinAt_asOrder_poly`, `asOrder_natDegree`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace Work.FFResidual

noncomputable section

open Polynomial

namespace FunctionFieldPlace

variable {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]

/-- **The Eisenstein order of the Artin–Schreier place**: `R[X]/(X ^ 5 + π X ^ 4 - π)`. -/
abbrev AsOrder (P : FunctionFieldPlace 𝔽 𝕜) : Type :=
  AdjoinRoot (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])

theorem asOrderMap_aux (P : FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    eval₂ (algebraMap P.R P.AsTop) P.asRecip (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]) = 0 := by
  simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
    Polynomial.eval₂_C, Polynomial.eval₂_mul]
  exact P.asRecip_pow

/-- **The map from the Artin–Schreier order into the top field**, sending the root of
`X ^ 5 + π X ^ 4 - π` to `w = s⁻¹`. -/
noncomputable def asOrderMap (P : FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    P.AsOrder →+* P.AsTop :=
  AdjoinRoot.lift (algebraMap P.R P.AsTop) P.asRecip (P.asOrderMap_aux)

/-- The top field as an algebra over the Artin–Schreier order, along `asOrderMap`. -/
noncomputable instance asOrderAlgebra (P : FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    Algebra P.AsOrder P.AsTop :=
  (P.asOrderMap).toAlgebra

theorem asOrderMap_root (P : FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    P.asOrderMap (AdjoinRoot.root (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])) = P.asRecip :=
  AdjoinRoot.lift_root _

theorem asOrderMap_algebraMap (P : FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] (r : P.R) :
    P.asOrderMap (algebraMap P.R P.AsOrder r) = algebraMap P.R P.AsTop r := by
  rw [AdjoinRoot.algebraMap_eq]
  exact AdjoinRoot.lift_of (P.asOrderMap_aux) (x := r)

/-- The `𝔽`-algebra structure on the Artin–Schreier order, through the constants. -/
noncomputable instance asOrderAlgebraF (P : FunctionFieldPlace 𝔽 𝕜) :
    Algebra 𝔽 P.AsOrder :=
  ((AdjoinRoot.of (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])).comp (algebraMap 𝔽 P.R)).toAlgebra

theorem algebraMap_𝔽_AsOrder (P : FunctionFieldPlace 𝔽 𝕜) (x : 𝔽) :
    algebraMap 𝔽 P.AsOrder x
      = AdjoinRoot.of (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]) (algebraMap 𝔽 P.R x) := rfl

theorem asOrderMap_algebraMap_𝔽 (P : FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] (x : 𝔽) :
    P.asOrderMap (algebraMap 𝔽 P.AsOrder x) = algebraMap 𝔽 P.AsTop x := by
  rw [algebraMap_𝔽_AsOrder,
    ← AdjoinRoot.algebraMap_eq (f := (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]))]
  rw [asOrderMap_algebraMap, algebraMap_R_AsTop]
  exact (IsScalarTower.algebraMap_apply 𝔽 P.R 𝕜 x).symm ▸ rfl

end FunctionFieldPlace

end

end Work.FFResidual
