/-!
# The Artin–Schreier order `R[X]/(X ^ 5 + π X ^ 4 - π)` is a discrete valuation ring

In characteristic `5` the local model of the place of `AsTop P = 𝕜(s)`, `s ^ 5 - s = π⁻¹`, is the
Eisenstein order `AsOrder P = R[X] / (X ^ 5 + π X ^ 4 - π)` (`Submission/Work/FFResidual/CharP/Order`),
the subring `R[w]` of `AsTop P` generated by `w = s⁻¹` (`asRecip_pow`: `w ^ 5 + π w ^ 4 - π = 0`).

Here we prove the ring-theoretic half of that statement, in the form in which the local theory of
the place consumes it: **`AsOrder P` is a discrete valuation ring**, as soon as it is known to be a
domain (which is the Eisenstein irreducibility statement, proved separately in
`isDomain_asOrder`).  The polynomial

  `f = X ^ 5 + C π * X ^ 4 - C π`

is monic of degree `5` with `f.coeff 4 = π` and `f.coeff 0 = -π`, so it is Eisenstein at the
maximal ideal `(π)` of the discrete valuation ring `R`; the general theorem
`Eisenstein.isDiscreteValuationRing_adjoinRoot_of_isEisensteinAt` then identifies
`R[X]/(f) = AsOrder P` as a discrete valuation ring (with maximal ideal generated by the image of
`X`, total ramification of index `deg f = e = 5`).

Note that no hypothesis on the characteristic is needed for this step: the Eisenstein property of
`f` only uses that `π` is a uniformizer of `R`.

## Main results

* `AsOrderPoly.coeff`, `AsOrderPoly.natDegree`, `AsOrderPoly.monic`,
  `AsOrderPoly.isEisensteinAt` — the elementary facts about `X ^ 5 + π X ^ 4 - π`;
* `isDiscreteValuationRing_asOrder` — `AsOrder P` is a discrete valuation ring.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Work.FFResidual.CharP

noncomputable section

open Polynomial

variable {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]

/-! ## The defining polynomial `X ^ 5 + π X ^ 4 - π` of the Artin–Schreier order -/

namespace AsOrderPoly

/-- The defining polynomial `X ^ 5 + π X ^ 4 - π` of the Artin–Schreier order. -/
abbrev poly (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) : P.R[X] :=
  X ^ 5 + C P.π * X ^ 4 - C P.π

/-- The coefficients of `X ^ 5 + π X ^ 4 - π`: `1` in degree `5`, `π` in degree `4`, `-π` in
degree `0`, and `0` elsewhere. -/
theorem coeff (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) (n : ℕ) :
    (poly P).coeff n
      = (if n = 5 then 1 else 0) + (if n = 4 then P.π else 0) - (if n = 0 then P.π else 0) := by
  simp only [poly, Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_X_pow,
    Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_C]

/-- The defining polynomial has degree `5`. -/
theorem natDegree (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) : (poly P).natDegree = 5 := by
  have h1 : (C P.π * X ^ 4 : P.R[X]).natDegree < (X ^ 5 : P.R[X]).natDegree := by
    rw [Polynomial.natDegree_X_pow]
    exact lt_of_le_of_lt (Polynomial.natDegree_C_mul_X_pow_le P.π 4) (by norm_num)
  have hA : (X ^ 5 + C P.π * X ^ 4 : P.R[X]).natDegree = 5 := by
    rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt h1, Polynomial.natDegree_X_pow]
  rw [poly, Polynomial.natDegree_sub_eq_left_of_natDegree_lt
    (p := (X ^ 5 + C P.π * X ^ 4 : P.R[X])) (q := C P.π)]
  · exact hA
  · rw [Polynomial.natDegree_C, hA]
    norm_num

/-- The defining polynomial is monic. -/
theorem monic (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) : (poly P).Monic := by
  rw [Polynomial.Monic.def, ← Polynomial.coeff_natDegree, natDegree P, coeff P 5]
  norm_num

/-- **The defining polynomial `X ^ 5 + π X ^ 4 - π` is Eisenstein at the maximal ideal of the
place.**  Its leading coefficient is `1`, its only nonzero non-leading coefficient is
`π` (degree `4`) together with the constant coefficient `-π`, and `π` is a uniformizer: it lies in
the maximal ideal but not in its square. -/
theorem isEisensteinAt (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    Polynomial.IsEisensteinAt (poly P) (IsLocalRing.maximalIdeal P.R) := by
  have hπ : P.π ∈ IsLocalRing.maximalIdeal P.R := by
    rw [P.isUniformizer]
    exact Ideal.mem_span_singleton_self P.π
  have hunit : ¬ IsUnit P.π := fun hu =>
    (IsLocalRing.maximalIdeal.isMaximal P.R).ne_top
      (Ideal.eq_top_of_isUnit_mem _ hπ hu)
  -- `π ∉ (π) ^ 2`: `π = π ^ 2 * r` would make `π` a unit.
  have hπ2 : P.π ∉ IsLocalRing.maximalIdeal P.R ^ 2 := by
    intro h
    rw [P.isUniformizer, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h
    obtain ⟨r, hr⟩ := h
    have h3 : P.π * (1 - P.π * r) = 0 := by
      rw [show P.π * (1 - P.π * r) = P.π - P.π ^ 2 * r by ring, sub_eq_zero]
      exact hr
    rcases mul_eq_zero.mp h3 with h0 | h0
    · exact P.pi_ne_zero h0
    · refine hunit ?_
      rw [sub_eq_zero] at h0
      exact isUnit_iff_exists_inv.mpr ⟨r, h0.symm⟩
  refine ⟨?_, ?_, ?_⟩
  · rw [(monic P).leadingCoeff]
    intro h1
    exact (IsLocalRing.maximalIdeal.isMaximal P.R).ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
  · intro n hn
    rw [natDegree P] at hn
    have hn5 : n ≠ 5 := by omega
    rw [coeff P n]
    rcases eq_or_ne n 4 with rfl | h4
    · simpa using hπ
    · rcases eq_or_ne n 0 with rfl | h0
      · simpa using neg_mem hπ
      · simp [h4, h0, hn5]
  · rw [coeff P 0]
    intro h
    exact hπ2 (by simpa using neg_mem h)

end AsOrderPoly

/-! ## The Artin–Schreier order is a discrete valuation ring -/

/-- **The Artin–Schreier order is a discrete valuation ring.**  `R[X]/(X ^ 5 + π X ^ 4 - π)` is a
discrete valuation ring: the polynomial is Eisenstein at the maximal ideal of `R`, so the quotient
is a local Noetherian domain whose maximal ideal is generated by the image of `X`. -/
theorem isDiscreteValuationRing_asOrder {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]
    (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜)
    [IsDomain (Work.FFResidual.FunctionFieldPlace.AsOrder P)] :
    IsDiscreteValuationRing (Work.FFResidual.FunctionFieldPlace.AsOrder P) :=
  Work.FFResidual.Eisenstein.isDiscreteValuationRing_adjoinRoot_of_isEisensteinAt
    (AsOrderPoly.monic P) (by rw [AsOrderPoly.natDegree P]; norm_num)
    (AsOrderPoly.isEisensteinAt P)

end

end Work.FFResidual.CharP
