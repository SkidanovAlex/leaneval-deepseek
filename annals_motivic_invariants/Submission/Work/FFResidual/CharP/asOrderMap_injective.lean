/-!
# Injectivity of the map from the Artin–Schreier order into the top field

Let `P : FunctionFieldPlace 𝔽 𝕜` be a place of a function field of characteristic `5` over its
field of constants, with uniformizer `π`.  The Artin–Schreier top field is
`AsTop P = 𝕜(s)`, `s ^ 5 - s = π⁻¹` (`Submission/Work/FFResidual/CharP/Basic.lean`), and the
local model of the place of `AsTop P` above `P` is the **Eisenstein order**

  `AsOrder P = R[X] / (X ^ 5 + π X ^ 4 - π)`,

the ring `R[w]` generated by `w = s⁻¹` (`CharP/Order.lean`).

This file proves that the `R`-algebra map `asOrderMap : R[w] → 𝕜(s)` sending the root of
`X ^ 5 + π X ^ 4 - π` to `w = s⁻¹` is **injective** — the characteristic-`5` analogue of
`Work.FFResidual.Kummer.kummerOrderMap_injective`, and the ring-theoretic input of the local theory
of the Artin–Schreier place (`isFractionRing_asOrder`).

## The argument

The model polynomial `X ^ 5 + π X ^ 4 - π ∈ R[X]` is *reciprocal* to the defining polynomial
`X ^ 5 - X - π⁻¹` of the top field, so the map is not directly an instance of the general
`AdjoinRoot` comparison of the Kummer case.  Instead:

* the polynomial `f = X ^ 5 + π X ^ 4 - π` is monic of degree `5`; the `𝕜`-algebra
  `T = 𝕜[X]/(f)` (`asModelPoly`, `asModelMap`) is therefore of dimension `5 = [𝕜(s) : 𝕜]` over `𝕜`,
  and the `𝕜`-algebra map `T → 𝕜(s)` sending the root to `w` is **surjective**, because `w` generates
  `𝕜(s)` (`adjoin_asRecip_eq_top`: its inverse is `π⁻¹w ^ 4 + w ^ 3`, so `s = w⁻¹ ∈ 𝕜[w]`);
* a surjective map of finite-dimensional `𝕜`-vector spaces of the same dimension is injective, so
  `T → 𝕜(s)` is injective;
* the map `asOrderMap` is the composite of the canonical `AdjoinRoot` comparison
  `R[X]/(f) → 𝕜[X]/(f)` (injective by `Kummer.adjoinRoot_map_injective_of_monic`, `R → 𝕜` being
  injective) with `T → 𝕜(s)`;
* a composite of injective maps is injective.

## Main results

* `asModelPoly`, `asModelMap` — the reciprocal model `𝕜[X]/(X ^ 5 + π X ^ 4 - π)` and its map to the
  top field.
* `asModelMap_injective` — that map is injective.
* `asOrderMap_injective` — the statement of this file.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace Work.FFResidual.CharP

open Polynomial

variable {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]

/-! ## 1. The reciprocal model `𝕜[X] / (X ^ 5 + π X ^ 4 - π)` -/

/-- The defining polynomial `X ^ 5 + π X ^ 4 - π` of the Artin–Schreier order, viewed over the
constants.  It is the reciprocal polynomial of `asPoly = X ^ 5 - X - π⁻¹`, whose root is `s`. -/
noncomputable abbrev asModelPoly (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) : 𝕜[X] :=
  (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]).map (algebraMap P.R 𝕜)

/-- The defining polynomial of the reciprocal model is monic. -/
theorem asModelPoly_monic (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    (asModelPoly P).Monic :=
  (AsOrderPoly.monic P).map (algebraMap P.R 𝕜)

/-- The defining polynomial of the reciprocal model has degree `5`. -/
theorem asModelPoly_natDegree (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    (asModelPoly P).natDegree = 5 := by
  rw [asModelPoly, Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective P.R 𝕜)]
  exact AsOrderPoly.natDegree P

/-- The defining polynomial of the reciprocal model is nonzero. -/
theorem asModelPoly_ne_zero (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    asModelPoly P ≠ 0 :=
  (asModelPoly_monic P).ne_zero

/-- The root of the reciprocal model. -/
noncomputable abbrev asModelRoot (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    AdjoinRoot (asModelPoly P) :=
  AdjoinRoot.root (asModelPoly P)

/-- **The map from the reciprocal model into the Artin–Schreier top field**, sending the root of
`X ^ 5 + π X ^ 4 - π` to `w = s⁻¹`.  It is a `𝕜`-algebra map, and is an isomorphism onto `𝕜(s)`
(`asModelMap_injective` and the surjectivity argument below). -/
noncomputable def asModelMap (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    AdjoinRoot (asModelPoly P) →ₐ[𝕜] P.AsTop :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId 𝕜 P.AsTop) P.asRecip (by
    rw [Polynomial.eval₂_map]
    exact P.asOrderMap_aux)

theorem asModelMap_root (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    asModelMap P (asModelRoot P) = P.asRecip :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

theorem asModelMap_of (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] (c : 𝕜) :
    asModelMap P (AdjoinRoot.of (asModelPoly P) c) = algebraMap 𝕜 P.AsTop c :=
  AdjoinRoot.liftAlgHom_of _ _ _ _ c

/-! ## 2. The dimension of the reciprocal model, and surjectivity of its map -/

/-- The reciprocal model is `5`-dimensional over the constants, like the top field. -/
theorem finrank_asModelPoly (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    Module.finrank 𝕜 (AdjoinRoot (asModelPoly P)) = 5 := by
  rw [PowerBasis.finrank (AdjoinRoot.powerBasis (f := asModelPoly P) (asModelPoly_ne_zero P)),
    AdjoinRoot.powerBasis_dim (f := asModelPoly P) (asModelPoly_ne_zero P)]
  exact asModelPoly_natDegree P

/-- **The map from the reciprocal model into the top field is surjective**: the range is the
`𝕜`-subalgebra generated by `w = s⁻¹`, which is all of `𝕜(s)`. -/
theorem asModelMap_surjective (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5]
    (hgen : Algebra.adjoin 𝕜 ({P.asRecip} : Set P.AsTop) = ⊤) :
    Function.Surjective (asModelMap P) := by
  rw [← AlgHom.range_eq_top]
  refine top_unique ?_
  rw [← hgen]
  refine Algebra.adjoin_le ?_
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact ⟨asModelRoot P, asModelMap_root P⟩

/-- **The map from the reciprocal model into the top field is injective**: it is a surjective map of
`𝕜`-vector spaces of the same dimension `5`. -/
theorem asModelMap_injective (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5]
    (hgen : Algebra.adjoin 𝕜 ({P.asRecip} : Set P.AsTop) = ⊤) :
    Function.Injective (asModelMap P) := by
  haveI : FiniteDimensional 𝕜 (AdjoinRoot (asModelPoly P)) :=
    (asModelPoly_monic P).finite_adjoinRoot
  haveI : FiniteDimensional 𝕜 P.AsTop := P.finiteDimensional_asTop
  have hfin : Module.finrank 𝕜 (AdjoinRoot (asModelPoly P)) = Module.finrank 𝕜 P.AsTop := by
    rw [finrank_asModelPoly P, P.finrank_asTop]
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := (asModelMap P).toLinearMap) hfin).mpr (asModelMap_surjective P hgen)

/-! ## 3. `asOrderMap` is the composite of the model comparison with `asModelMap` -/

/-- **`asOrderMap` computes on representatives as `asModelMap` does**: the Artin–Schreier order
`R[X]/(f)` maps to `𝕜[X]/(f)` by the canonical `AdjoinRoot` comparison, and then into `𝕜(s)` by
`asModelMap`. -/
theorem asOrderMap_eq_modelMap (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5]
    (x : P.AsOrder) :
    P.asOrderMap x = asModelMap P
      (AdjoinRoot.map (algebraMap P.R 𝕜) (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])
        (asModelPoly P) (by rw [asModelPoly]) x) := by
  obtain ⟨g, rfl⟩ :=
    AdjoinRoot.mk_surjective (g := (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])) x
  rw [Work.FFResidual.Kummer.adjoinRoot_map_mk]
  have h1 : P.asOrderMap (AdjoinRoot.mk (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]) g)
      = Polynomial.eval₂ (algebraMap P.R P.AsTop) P.asRecip g :=
    AdjoinRoot.lift_mk (P.asOrderMap_aux) g
  have h2 : asModelMap P (AdjoinRoot.mk (asModelPoly P) (g.map (algebraMap P.R 𝕜)))
      = Polynomial.eval₂ (↑(Algebra.ofId 𝕜 P.AsTop) : 𝕜 →+* P.AsTop) P.asRecip
          (g.map (algebraMap P.R 𝕜)) :=
    AdjoinRoot.liftAlgHom_mk (asModelPoly P) (Algebra.ofId 𝕜 P.AsTop) P.asRecip _ _
  rw [h1, h2, Polynomial.eval₂_map]
  rfl

/-! ## 4. Injectivity of `asOrderMap` -/

theorem asOrderMap_injective {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]
    (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    Function.Injective (Work.FFResidual.FunctionFieldPlace.asOrderMap P) := by
  have hgen : Algebra.adjoin 𝕜 ({P.asRecip} : Set P.AsTop) = ⊤ := adjoin_asRecip_eq_top P
  have hinjModel : Function.Injective (asModelMap P) := asModelMap_injective P hgen
  -- the canonical comparison `R[X]/(f) → 𝕜[X]/(f)` is injective
  have hne_one : (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X]) ≠ 1 := by
    intro h
    have h5 := AsOrderPoly.natDegree P
    rw [show AsOrderPoly.poly P = (1 : P.R[X]) from h] at h5
    simp at h5
  have hinjOrder : Function.Injective
      (AdjoinRoot.map (algebraMap P.R 𝕜) (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])
        (asModelPoly P) (by rw [asModelPoly])) :=
    Work.FFResidual.Kummer.adjoinRoot_map_injective_of_monic (algebraMap P.R 𝕜)
      (IsFractionRing.injective P.R 𝕜) (X ^ 5 + C P.π * X ^ 4 - C P.π : P.R[X])
      (AsOrderPoly.monic P) hne_one
  intro x y hxy
  refine hinjOrder (hinjModel ?_)
  rw [← asOrderMap_eq_modelMap P x, ← asOrderMap_eq_modelMap P y, hxy]

end Work.FFResidual.CharP
