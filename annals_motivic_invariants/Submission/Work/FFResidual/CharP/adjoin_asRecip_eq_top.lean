import Mathlib
import Submission.Work.FFResidual.CharP.Basic

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

namespace Work.FFResidual.CharP

/-- In characteristic `5`, the *reciprocal* Eisenstein element `w = s⁻¹` of the Artin–Schreier extension `AsTop P = 𝕜(s)`, `s ^ 5 - s = π⁻¹`, generates the top field as a `𝕜`-algebra.  Hint: `w` satisfies `w ^ 5 + π w ^ 4 - π = 0` (`FunctionFieldPlace.asRecip_pow`), so `π = w ^ 4 * (w + π)` and `w * (π⁻¹ * w ^ 4 + w ^ 3) = 1`, i.e. `w⁻¹ = π⁻¹ * w ^ 4 + w ^ 3 ∈ 𝕜[w]`; since `w = s⁻¹` and `s ≠ 0`, this inverse is `s`, so `s ∈ 𝕜[w]`, and `𝕜[s] = AsTop` (`AdjoinRoot.adjoinRoot_eq_top`). -/
theorem adjoin_asRecip_eq_top {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]
    (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) [CharP 𝕜 5] :
    Algebra.adjoin 𝕜 ({P.asRecip} : Set P.AsTop) = ⊤ := by
  -- Write `S := 𝕜[w]` for the subalgebra generated by the Eisenstein element `w = s⁻¹`.
  set S : Subalgebra 𝕜 P.AsTop := Algebra.adjoin 𝕜 ({P.asRecip} : Set P.AsTop)
  have hw : P.asRecip ∈ S := Algebra.subset_adjoin (Set.mem_singleton P.asRecip)
  -- The uniformizer is nonzero in the top field.
  have hπ : algebraMap P.R P.AsTop P.π ≠ 0 := by
    rw [FunctionFieldPlace.algebraMap_R_AsTop]
    intro h
    have hR : algebraMap P.R 𝕜 P.π ≠ 0 := fun h0 =>
      P.pi_ne_zero (IsFractionRing.injective P.R 𝕜 (by simpa using h0))
    exact hR ((algebraMap 𝕜 P.AsTop).injective (by simpa using h))
  -- `w * (π⁻¹ * w ^ 4 + w ^ 3) = π⁻¹ * (w ^ 5 + π * w ^ 4) = 1`, so the inverse of `w` is a
  -- polynomial in `w`.
  have hInvMem : P.asRecip⁻¹ ∈ S := by
    have hrel : P.asRecip ^ 5 + algebraMap P.R P.AsTop P.π * P.asRecip ^ 4
        = algebraMap P.R P.AsTop P.π := sub_eq_zero.mp P.asRecip_pow
    have hprod : P.asRecip
        * ((algebraMap P.R P.AsTop P.π)⁻¹ * P.asRecip ^ 4 + P.asRecip ^ 3) = 1 := by
      have h1 : P.asRecip
            * ((algebraMap P.R P.AsTop P.π)⁻¹ * P.asRecip ^ 4 + P.asRecip ^ 3)
          = (algebraMap P.R P.AsTop P.π)⁻¹
              * (P.asRecip ^ 5 + algebraMap P.R P.AsTop P.π * P.asRecip ^ 4) := by
        field_simp
      rw [h1, hrel, inv_mul_cancel₀ hπ]
    rw [inv_eq_of_mul_eq_one_right hprod]
    have hcoe : (algebraMap P.R P.AsTop P.π)⁻¹ = algebraMap 𝕜 P.AsTop P.asElement := by
      rw [FunctionFieldPlace.asElement, map_inv₀, FunctionFieldPlace.algebraMap_R_AsTop]
    rw [hcoe]
    exact S.add_mem (S.mul_mem (S.algebraMap_mem _) (S.pow_mem hw 4)) (S.pow_mem hw 3)
  -- `s = w⁻¹` is the inverse of `w`, hence lies in `𝕜[w]` as well.
  have hroot : P.asRoot ∈ S := by
    have hinv : P.asRecip⁻¹ = P.asRoot := by
      rw [FunctionFieldPlace.asRecip, inv_inv]
    rwa [hinv] at hInvMem
  -- `AsTop = 𝕜[s] ≤ 𝕜[w]`.
  refine le_antisymm le_top ?_
  rw [← AdjoinRoot.adjoinRoot_eq_top (f := P.asPoly)]
  exact Algebra.adjoin_le (fun x hx => by
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact hroot)

end Work.FFResidual.CharP
