/-!
# The Eisenstein order `R[s]` of the Kummer extension at a place

Let `P : FunctionFieldPlace 𝔽 𝕜` be a place of a function field over its constants, with
uniformizer `π`, and let `Top P = 𝕜(s)` be the Kummer extension `s ^ 5 = π` of
`Submission/Work/FFResidual/Kummer/Basic`.  This file introduces the **Eisenstein order**

  `KummerOrder P = R[X] / (X ^ 5 - π)`,

the local model of the place of `Top P` above the place `P`: it is the ring `R[s]` inside `Top P`,
a discrete valuation ring with fraction field `Top P`
(`Submission/Work/FFResidual/Kummer/Model`), maximal ideal generated by the image of `s` and
residue field the residue field of `R`.

## Main definitions and results

* `FunctionFieldPlace.KummerOrder`, `FunctionFieldPlace.kummerOrderMap` — the order and its map
  into the top field; `Algebra (KummerOrder P) (Top P)` is registered along this map.
* `FunctionFieldPlace.kummerOrderMap_root`, `kummerOrderMap_algebraMap`,
  `kummerOrderMap_algebraMap_𝔽` — the map sends the root to `s`, and is compatible with the
  structure maps.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false


namespace Work.FFResidual

noncomputable section

open Polynomial

namespace FunctionFieldPlace

variable {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]

/-- **The Eisenstein order of the Kummer place**: `R[X] / (X ^ 5 - π)`, the ring `R[s]` of the
Kummer extension `𝕜(s)`, `s ^ 5 = π`, at the place `P` of `𝕜`. -/
abbrev KummerOrder (P : FunctionFieldPlace 𝔽 𝕜) : Type :=
  AdjoinRoot (X ^ 5 - C P.π : P.R[X])

/-- The `𝔽`-algebra structure on the top field `𝕜(s)`, through the constants. -/
noncomputable instance (P : FunctionFieldPlace 𝔽 𝕜) : Algebra 𝔽 P.Top :=
  ((algebraMap 𝕜 P.Top).comp (algebraMap 𝔽 𝕜)).toAlgebra

/-- The `R`-algebra structure on the top field `𝕜(s)` along the place. -/
noncomputable instance (P : FunctionFieldPlace 𝔽 𝕜) : Algebra P.R P.Top :=
  ((algebraMap 𝕜 P.Top).comp (algebraMap P.R 𝕜)).toAlgebra

theorem algebraMap_R_Top (P : FunctionFieldPlace 𝔽 𝕜) (r : P.R) :
    algebraMap P.R P.Top r = algebraMap 𝕜 P.Top (algebraMap P.R 𝕜 r) := rfl

theorem algebraMap_𝔽_Top (P : FunctionFieldPlace 𝔽 𝕜) (x : 𝔽) :
    algebraMap 𝔽 P.Top x = algebraMap 𝕜 P.Top (algebraMap 𝔽 𝕜 x) := rfl

theorem algebraMap_R_Top_𝔽 (P : FunctionFieldPlace 𝔽 𝕜) (x : 𝔽) :
    algebraMap P.R P.Top (algebraMap 𝔽 P.R x) = algebraMap 𝔽 P.Top x := by
  rw [algebraMap_R_Top, algebraMap_𝔽_Top, IsScalarTower.algebraMap_apply 𝔽 P.R 𝕜]

/-- The defining relation of the Eisenstein order: `s ^ 5 = π`. -/
theorem kummerOrderMap_aux (P : FunctionFieldPlace 𝔽 𝕜) :
    eval₂ (algebraMap P.R P.Top) P.kummerRoot (X ^ 5 - C P.π : P.R[X]) = 0 := by
  rw [eval₂_sub, eval₂_pow, eval₂_X, eval₂_C, sub_eq_zero]
  rw [P.kummerRoot_pow_five, algebraMap_R_Top]

/-- **The map from the Eisenstein order into the top field**, sending the root of `X ^ 5 - π` to
the Kummer root `s`.  It is injective, with fraction field the top field
(`isFractionRing_kummerOrder`). -/
noncomputable def kummerOrderMap (P : FunctionFieldPlace 𝔽 𝕜) : P.KummerOrder →+* P.Top :=
  AdjoinRoot.lift (algebraMap P.R P.Top) P.kummerRoot (P.kummerOrderMap_aux)

/-- The top field as an algebra over the Eisenstein order, along `kummerOrderMap`. -/
noncomputable instance (P : FunctionFieldPlace 𝔽 𝕜) : Algebra P.KummerOrder P.Top :=
  (P.kummerOrderMap).toAlgebra

theorem kummerOrderMap_root (P : FunctionFieldPlace 𝔽 𝕜) :
    P.kummerOrderMap (AdjoinRoot.root (X ^ 5 - C P.π : P.R[X])) = P.kummerRoot :=
  AdjoinRoot.lift_root _

theorem kummerOrderMap_algebraMap (P : FunctionFieldPlace 𝔽 𝕜) (r : P.R) :
    P.kummerOrderMap (algebraMap P.R P.KummerOrder r) = algebraMap P.R P.Top r := by
  rw [AdjoinRoot.algebraMap_eq]
  exact AdjoinRoot.lift_of (P.kummerOrderMap_aux) (x := r)

/-- The `𝔽`-algebra structure on the Eisenstein order, through the constants. -/
noncomputable instance (P : FunctionFieldPlace 𝔽 𝕜) : Algebra 𝔽 P.KummerOrder :=
  ((AdjoinRoot.of (X ^ 5 - C P.π : P.R[X])).comp (algebraMap 𝔽 P.R)).toAlgebra

theorem algebraMap_𝔽_KummerOrder (P : FunctionFieldPlace 𝔽 𝕜) (x : 𝔽) :
    algebraMap 𝔽 P.KummerOrder x
      = AdjoinRoot.of (X ^ 5 - C P.π : P.R[X]) (algebraMap 𝔽 P.R x) := rfl

theorem kummerOrderMap_algebraMap_𝔽 (P : FunctionFieldPlace 𝔽 𝕜) (x : 𝔽) :
    P.kummerOrderMap (algebraMap 𝔽 P.KummerOrder x) = algebraMap 𝔽 P.Top x := by
  rw [algebraMap_𝔽_KummerOrder,
    ← AdjoinRoot.algebraMap_eq (f := (X ^ 5 - C P.π : P.R[X]))]
  rw [kummerOrderMap_algebraMap, algebraMap_R_Top_𝔽]

end FunctionFieldPlace

end

end Work.FFResidual
