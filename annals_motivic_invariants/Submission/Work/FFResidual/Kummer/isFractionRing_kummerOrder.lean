/-!
# The Eisenstein order is a model of the Kummer place

Let `P : FunctionFieldPlace 𝔽 𝕜` be a place of a function field over its constants, with
uniformizer `π`, and let `Top P = 𝕜(s)`, `s ^ 5 = π`, be the Kummer extension of
`Submission/Work/FFResidual/Kummer/Basic`.  This file proves that the **Eisenstein order**

  `KummerOrder P = R[X] / (X ^ 5 - π)`

is a model of the place of `Top P` above `P`: the map `R[X]/(X ^ 5 - π) → 𝕜(s)` sending the root of
`X ^ 5 - π` to the Kummer root `s` (`FunctionFieldPlace.kummerOrderMap`) is injective
(`kummerOrderMap_injective`), and the top field is its fraction field — every element of `𝕜(s)` is a
quotient of two elements of `R[s]`.

The proof of the fraction-ring statement is the standard one: the set of elements of `Top P` that
are quotients of two elements of `R[s]` is the `𝕜`-subalgebra of `Top P` generated by `s`
(`Algebra.adjoin 𝕜 {s}`: it contains `s = kummerOrderMap (root) / 1` and every fraction of
constants, from `IsFractionRing R 𝕜`, and is closed under `+`, `*`), and `𝕜[s] = Top P`
(`AdjoinRoot.adjoinRoot_eq_top`).

## Main results

* `Work.FFResidual.Kummer.kummerOrder_exists_fraction` — every element of `Top P` is a quotient of two
  elements of the order.
* `Work.FFResidual.Kummer.isFractionRing_kummerOrder` — the order has fraction field `Top P`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace Work.FFResidual.Kummer

noncomputable section

open Polynomial

variable {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]

/-- **Every element of the top field is a fraction of two elements of the Eisenstein order**:
for `z : 𝕜(s)`, `s ^ 5 = π`, there are `x, y ∈ R[X] / (X ^ 5 - π)` with `z = x / y`, i.e.
`z * kummerOrderMap y = kummerOrderMap x` with `kummerOrderMap y ≠ 0`. -/
theorem kummerOrder_exists_fraction (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜)
    (z : P.Top) :
    ∃ x y : P.KummerOrder, P.kummerOrderMap y ≠ 0 ∧ z * P.kummerOrderMap y = P.kummerOrderMap x := by
  -- The elements of `Top P` that are quotients of two elements of the order.
  let Q : Subalgebra 𝕜 P.Top :=
    { carrier := {z | ∃ x y : P.KummerOrder,
        P.kummerOrderMap y ≠ 0 ∧ z * P.kummerOrderMap y = P.kummerOrderMap x}
      mul_mem' := by
        rintro a b ⟨x₁, y₁, hy₁, h₁⟩ ⟨x₂, y₂, hy₂, h₂⟩
        refine ⟨x₁ * x₂, y₁ * y₂, ?_, ?_⟩
        · rw [map_mul]; exact mul_ne_zero hy₁ hy₂
        · simp only [map_mul] at h₁ h₂ ⊢
          rw [← h₁, ← h₂]; ring
      one_mem' := ⟨1, 1, by simp, by simp⟩
      add_mem' := by
        rintro a b ⟨x₁, y₁, hy₁, h₁⟩ ⟨x₂, y₂, hy₂, h₂⟩
        refine ⟨x₁ * y₂ + x₂ * y₁, y₁ * y₂, ?_, ?_⟩
        · rw [map_mul]; exact mul_ne_zero hy₁ hy₂
        · simp only [map_add, map_mul] at h₁ h₂ ⊢
          rw [← h₁, ← h₂]; ring
      zero_mem' := ⟨0, 1, by simp, by simp⟩
      algebraMap_mem' := by
        intro c
        -- a constant of `𝕜 = Frac R` is a fraction of two elements of `R`, hence of the order.
        obtain ⟨⟨a, b⟩, hb⟩ := IsLocalization.surj (nonZeroDivisors P.R) c
        refine ⟨algebraMap P.R P.KummerOrder a, algebraMap P.R P.KummerOrder b, ?_, ?_⟩
        · rw [P.kummerOrderMap_algebraMap, P.algebraMap_R_Top]
          intro h
          have h' : algebraMap P.R 𝕜 (b : P.R) = 0 :=
            (map_eq_zero_iff (algebraMap 𝕜 P.Top) (algebraMap 𝕜 P.Top).injective).mp h
          exact (mem_nonZeroDivisors_iff_ne_zero.mp b.2) (IsFractionRing.to_map_eq_zero_iff.mp h')
        · rw [P.kummerOrderMap_algebraMap, P.kummerOrderMap_algebraMap,
              P.algebraMap_R_Top, P.algebraMap_R_Top]
          rw [← map_mul, hb] }
  -- The order contains the Kummer root: `s = root / 1`.
  have hroot : P.kummerRoot ∈ Q :=
    ⟨AdjoinRoot.root (X ^ 5 - C P.π), 1, by simp, by simp [P.kummerOrderMap_root]⟩
  -- `Top P = 𝕜[s]`, and `𝕜[s] ≤ Q` since `Q` is a `𝕜`-subalgebra containing `s`.
  have hle : Algebra.adjoin 𝕜 ({P.kummerRoot} : Set P.Top) ≤ Q := by
    refine Algebra.adjoin_le ?_
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    subst hw
    exact hroot
  have htop : (⊤ : Subalgebra 𝕜 P.Top) ≤ Q := by
    rw [← AdjoinRoot.adjoinRoot_eq_top (f := P.kummerPoly)]
    exact hle
  exact htop trivial

/-- **The Eisenstein order is a model of the Kummer place**: `R[X]/(X ^ 5 - π)`, the ring `R[s]`
inside `𝕜(s)`, `s ^ 5 = π`, has fraction field the top field. -/
theorem isFractionRing_kummerOrder {𝔽 : Type} [Field 𝔽] {𝕜 : Type} [Field 𝕜] [Algebra 𝔽 𝕜]
    (P : Work.FFResidual.FunctionFieldPlace 𝔽 𝕜) :
    IsFractionRing (Work.FFResidual.FunctionFieldPlace.KummerOrder P) P.Top := by
  haveI : FaithfulSMul (Work.FFResidual.FunctionFieldPlace.KummerOrder P) P.Top :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (Work.FFResidual.Kummer.kummerOrderMap_injective P)
  refine IsFractionRing.of_field _ _ fun z => ?_
  obtain ⟨x, y, hy, hxy⟩ := kummerOrder_exists_fraction P z
  exact ⟨x, y, (eq_div_iff hy).mpr hxy⟩

end

end Work.FFResidual.Kummer
