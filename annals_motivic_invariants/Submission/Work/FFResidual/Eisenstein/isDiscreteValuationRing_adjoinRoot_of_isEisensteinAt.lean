import Mathlib
import Submission.Work.FFResidual.Eisenstein.exists_constCoeff_facts
import Submission.Work.FFResidual.Eisenstein.isUnit_one_sub_algebraMap_mul
import Submission.Work.Reflect.PolyId
set_option maxRecDepth 100000

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
