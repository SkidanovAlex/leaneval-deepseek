namespace Work.FFResidual.Eisenstein

open Polynomial

set_option linter.style.haveILetI false

/-- **The Eisenstein extension of a discrete valuation ring is a discrete valuation ring.**
Let `R` be a discrete valuation ring and let `f ∈ R[X]` be monic of positive degree, Eisenstein at
the maximal ideal.  Then the order `R[X]/(f)` generated by a root of `f` is a discrete valuation
ring, with maximal ideal generated by the image of `X` (total ramification, `e = deg f`, `f = 1`). -/
theorem isDiscreteValuationRing_adjoinRoot_of_isEisensteinAt {R : Type} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] {f : Polynomial R} (hmon : f.Monic) (hdeg : 0 < f.natDegree)
    (heis : Polynomial.IsEisensteinAt f (IsLocalRing.maximalIdeal R))
    [IsDomain (AdjoinRoot f)] :
    IsDiscreteValuationRing (AdjoinRoot f) := by
  classical
  -- ## 0. Setup
  obtain ⟨π, hπirr⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hπne : π ≠ 0 := hπirr.ne_zero
  have hπmax : IsLocalRing.maximalIdeal R = Ideal.span {π} := hπirr.maximalIdeal_eq
  have hπmem : π ∈ IsLocalRing.maximalIdeal R := hπmax ▸ Ideal.mem_span_singleton_self π
  have halg_inj : Function.Injective (algebraMap R (AdjoinRoot f)) := by
    rw [AdjoinRoot.algebraMap_eq]
    exact AdjoinRoot.of.injective_of_monic_of_degree_pos hmon (by
      rw [Polynomial.degree_eq_natDegree hmon.ne_zero]; exact_mod_cast hdeg)
  have hπne' : algebraMap R (AdjoinRoot f) π ≠ 0 := fun h => hπne (halg_inj (by simpa using h))
  haveI : Module.Finite R (AdjoinRoot f) := hmon.finite_adjoinRoot
  have hmem0 : f.coeff 0 ∈ IsLocalRing.maximalIdeal R := heis.mem hdeg
  have ha0ne : f.coeff 0 ≠ 0 := fun h => heis.notMem (h ▸ zero_mem _)
  obtain ⟨b₀, hb0⟩ := Ideal.mem_span_singleton.mp (hπmax ▸ hmem0)
  have hb0mem : b₀ ∉ IsLocalRing.maximalIdeal R := by
    intro hmem
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton.mp (hπmax ▸ hmem)
    refine heis.notMem ?_
    have h1 : f.coeff 0 = π ^ 2 * t := by rw [hb0, ht]; ring
    rw [hπmax, Ideal.span_singleton_pow, h1]
    exact Ideal.mul_mem_right t (Ideal.span {π ^ 2}) (Ideal.mem_span_singleton_self (π ^ 2))
  -- ## 1. There is `y` with `π * y = x ^ n`, where `x = root f`, `n = f.natDegree`
  have hweak' : f.IsWeaklyEisensteinAt (Ideal.span {π}) := hπmax ▸ heis.isWeaklyEisensteinAt
  have hweak : f.IsWeaklyEisensteinAt (Submodule.span R {π}) := hweak'
  have haeval : aeval (AdjoinRoot.root f) f = 0 := by
    rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  obtain ⟨y, -, hxy⟩ := hweak.exists_mem_adjoin_mul_eq_pow_natDegree haeval hmon
  have hnatdeg : (f.map (algebraMap R (AdjoinRoot f))).natDegree = f.natDegree :=
    natDegree_map_eq_of_injective halg_inj f
  have hxy' : algebraMap R (AdjoinRoot f) π * y = AdjoinRoot.root f ^ f.natDegree := by
    rw [hxy, hnatdeg]
  -- ## 2. The constant-term functional
  obtain ⟨c, hc1, hcpow, hcmul, hcn, hdecomp⟩ := exists_constCoeff_facts hmon hdeg
  set J : Ideal (AdjoinRoot f) :=
    Ideal.span {AdjoinRoot.root f} ⊔ Ideal.span {algebraMap R (AdjoinRoot f) π} with hJdef
  have hcJ : ∀ s ∈ J, c s ∈ IsLocalRing.maximalIdeal R := by
    intro s hs
    rw [hJdef, Submodule.mem_sup] at hs
    obtain ⟨a, ha, b', hb', rfl⟩ := hs
    obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton.mp ha
    obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hb'
    rw [map_add]
    refine add_mem ?_ ?_
    · exact hcmul _ hmem0 u
    · rw [mul_comm w, ← Algebra.smul_def, map_smul, smul_eq_mul]
      exact Ideal.mul_mem_right (c w) (IsLocalRing.maximalIdeal R) hπmem
  have h1J : (1 : AdjoinRoot f) ∉ J := by
    intro h
    have := hcJ 1 h
    rw [hc1] at this
    exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one this
  -- ## 3. Any element outside `J` is a unit
  have hunit : ∀ s : AdjoinRoot f, s ∉ J → IsUnit s := by
    intro s hsJ
    obtain ⟨t, ht⟩ := hdecomp s
    have hcmem : c s ∉ IsLocalRing.maximalIdeal R := by
      intro h
      apply hsJ
      rw [hJdef]
      refine Submodule.mem_sup.mpr ⟨AdjoinRoot.root f * t, ?_,
        algebraMap R (AdjoinRoot f) (c s), ?_, ?_⟩
      · exact Ideal.mul_mem_right t _ (Ideal.subset_span (Set.mem_singleton _))
      · obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp (hπmax ▸ h)
        rw [hu, map_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))
      · rw [add_comm]; exact ht.symm
    have hcu : IsUnit (algebraMap R (AdjoinRoot f) (c s)) :=
      (IsLocalRing.notMem_maximalIdeal.mp hcmem).map (algebraMap R (AdjoinRoot f))
    set u : (AdjoinRoot f)ˣ := hcu.unit with hu
    have huval : (u : AdjoinRoot f) = algebraMap R (AdjoinRoot f) (c s) := by
      rw [hu]; exact IsUnit.unit_spec hcu
    set y₀ : AdjoinRoot f := AdjoinRoot.root f * (-(↑u⁻¹) * t) with hy0
    have hs_eq : s = algebraMap R (AdjoinRoot f) (c s) * (1 - y₀) := by
      refine ht.trans ?_
      rw [hy0, ← huval, mul_sub, mul_one]
      rw [show (↑u : AdjoinRoot f) * (AdjoinRoot.root f * (-(↑u⁻¹) * t))
          = -(AdjoinRoot.root f * t) by
        calc (↑u : AdjoinRoot f) * (AdjoinRoot.root f * (-(↑u⁻¹) * t))
            = -((↑u * ↑u⁻¹) * (AdjoinRoot.root f * t)) := by ring
          _ = -(AdjoinRoot.root f * t) := by rw [Units.mul_inv, one_mul]]
      first | refl_ring1 | ring
    have key : y₀ ^ f.natDegree
        = algebraMap R (AdjoinRoot f) π * (y * (-(↑u⁻¹) * t) ^ f.natDegree) := by
      calc y₀ ^ f.natDegree
          = (AdjoinRoot.root f * (-(↑u⁻¹) * t)) ^ f.natDegree := by rw [hy0]
        _ = AdjoinRoot.root f ^ f.natDegree * (-(↑u⁻¹) * t) ^ f.natDegree := by rw [mul_pow]
        _ = (algebraMap R (AdjoinRoot f) π * y) * (-(↑u⁻¹) * t) ^ f.natDegree := by rw [hxy']
        _ = algebraMap R (AdjoinRoot f) π * (y * (-(↑u⁻¹) * t) ^ f.natDegree) := by ring
    have hy0n : y₀ ^ f.natDegree ∈ Ideal.span {algebraMap R (AdjoinRoot f) π} := by
      refine Ideal.mem_span_singleton'.mpr ⟨y * (-(↑u⁻¹) * t) ^ f.natDegree, ?_⟩
      rw [key, mul_comm]
    have hunit_pow : IsUnit (1 - y₀ ^ f.natDegree) := by
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hy0n
      have hz' : y₀ ^ f.natDegree = algebraMap R (AdjoinRoot f) π * z := by
        rw [← hz, mul_comm]
      rw [hz']
      exact isUnit_one_sub_algebraMap_mul hπmem z
    have hgeom : (1 - y₀) * ∑ i ∈ Finset.range f.natDegree, y₀ ^ i
        = 1 - y₀ ^ f.natDegree := by
      have h := mul_geom_sum y₀ f.natDegree
      have h2 : (1 - y₀) * ∑ i ∈ Finset.range f.natDegree, y₀ ^ i
          = -(y₀ ^ f.natDegree - 1) := by
        rw [show (1 - y₀) = -(y₀ - 1) by ring, neg_mul, h]
      rw [h2]
      first | refl_ring1 | ring
    have h1y : IsUnit (1 - y₀) := by
      have hprod : IsUnit ((1 - y₀) * ∑ i ∈ Finset.range f.natDegree, y₀ ^ i) := by
        rw [hgeom]; exact hunit_pow
      exact (IsUnit.mul_iff.mp hprod).1
    rw [hs_eq]
    exact hcu.mul h1y
  -- ## 4. `S` is local with maximal ideal `J`, and `J = (root f)`
  have hJmax : J.IsMaximal := by
    refine Ideal.isMaximal_iff.mpr ⟨h1J, ?_⟩
    intro K x hJK hxJ hxK
    have hK : K = ⊤ := Ideal.eq_top_of_isUnit_mem K hxK (hunit x hxJ)
    rw [hK]; exact Submodule.mem_top
  have hMaxEq : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal → M = J := by
    intro M hM
    exact hM.eq_of_le hJmax.ne_top fun s hsM =>
      of_not_not fun hsJ => hM.ne_top (Ideal.eq_top_of_isUnit_mem M hsM (hunit s hsJ))
  haveI : IsLocalRing (AdjoinRoot f) :=
    IsLocalRing.of_unique_max_ideal ⟨J, hJmax, fun M hM => hMaxEq M hM⟩
  have hmaxJ : IsLocalRing.maximalIdeal (AdjoinRoot f) = J := (IsLocalRing.eq_maximalIdeal hJmax).symm
  -- `c y = -b₀`, hence `y ∉ J` and `y` is a unit, hence `π ∈ (root f)`
  have hcxy : c y = -b₀ := by
    have h1 : c (algebraMap R (AdjoinRoot f) π * y) = -f.coeff 0 := by rw [hxy', hcn]
    rw [← Algebra.smul_def, map_smul] at h1
    have h2 : π * c y = -f.coeff 0 := by simpa using h1
    rw [hb0] at h2
    have h3 : π * c y = π * (-b₀) := by linear_combination h2
    exact mul_left_cancel₀ hπne h3
  have hyJ : y ∉ J := by
    intro hy
    have h := hcJ y hy
    rw [hcxy] at h
    exact hb0mem (by simpa using neg_mem h)
  have hyunit : IsUnit y := by
    rw [← IsLocalRing.notMem_maximalIdeal, hmaxJ]
    exact hyJ
  have hpi_mem : algebraMap R (AdjoinRoot f) π ∈ Ideal.span {AdjoinRoot.root f} := by
    obtain ⟨u, hu⟩ := hyunit
    have h1 : algebraMap R (AdjoinRoot f) π
        = AdjoinRoot.root f ^ f.natDegree * (↑u⁻¹ : AdjoinRoot f) := by
      rw [← hxy', ← hu, mul_assoc, Units.mul_inv, mul_one]
    refine Ideal.mem_span_singleton'.mpr ⟨AdjoinRoot.root f ^ (f.natDegree - 1) * ↑u⁻¹, ?_⟩
    rw [h1]
    conv_rhs => rw [show f.natDegree = (f.natDegree - 1) + 1 by omega, pow_succ]
    first | refl_ring1 | ring
  have hJeq : J = Ideal.span {AdjoinRoot.root f} := by
    rw [hJdef, sup_eq_left]
    exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hpi_mem)
  have hmax : IsLocalRing.maximalIdeal (AdjoinRoot f) = Ideal.span {AdjoinRoot.root f} := by
    rw [hmaxJ, hJeq]
  have hxne : AdjoinRoot.root f ≠ 0 := by
    intro hx0
    have hy0 : y = 0 := by
      have h := hxy'
      rw [hx0, zero_pow hdeg.ne', mul_eq_zero] at h
      exact h.resolve_left hπne'
    have hb00 : b₀ = 0 := by
      have h := hcxy
      rw [hy0, map_zero] at h
      exact neg_eq_zero.mp h.symm
    exact ha0ne (by rw [hb0, hb00, mul_zero])
  -- ## 5. Assembly
  haveI : IsNoetherianRing (AdjoinRoot f) := IsNoetherianRing.of_finite R (AdjoinRoot f)
  haveI hpid : IsPrincipalIdealRing (AdjoinRoot f) :=
    ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain (AdjoinRoot f)).out 5 1).mp (by
      rw [hmax]
      exact Submodule.IsPrincipal.mk ⟨AdjoinRoot.root f, rfl⟩)
  have hnf : IsLocalRing.maximalIdeal (AdjoinRoot f) ≠ ⊥ := by
    rw [hmax]
    exact fun h => hxne (Ideal.span_singleton_eq_bot.mp h)
  exact { not_a_field' := hnf }

end Work.FFResidual.Eisenstein
