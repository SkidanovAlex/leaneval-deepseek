/-! ## The ambient affine space and the affine transport -/

/-- Affine `4`-space over `𝕜`, the ambient scheme of the Cremona group `Cr 𝕜 4`. -/
noncomputable abbrev Affine4 (𝕜 : Type) [Field 𝕜] : Scheme.{0} := 𝔸(Fin 4; Spec (.of 𝕜))

variable {𝕜 : Type} [Field 𝕜]
variable {S T : Scheme.{0}} [IrreducibleSpace S] [IrreducibleSpace T]

/-- The **affine transport** of a birational map `ψ : S ⤏ T` along birational identifications
`ε : 𝔸⁴ ⤏ S` and `δ : T ⤏ 𝔸⁴`: the birational self-map `ε ∘ ψ ∘ δ` of `𝔸⁴`. -/
noncomputable def transport (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T)
    (δ : T.BirationalMap (Affine4 𝕜)) : (Affine4 𝕜).BirationalMap (Affine4 𝕜) :=
  ε.trans (ψ.trans δ)

@[simp]
theorem transport_def (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T)
    (δ : T.BirationalMap (Affine4 𝕜)) :
    transport ε ψ δ = ε.trans (ψ.trans δ) := rfl

/-- The affine transport of maps over `𝕜` is over `𝕜`. -/
theorem transport_isOver [S.Over (Spec (.of 𝕜))] [T.Over (Spec (.of 𝕜))]
    (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T) (δ : T.BirationalMap (Affine4 𝕜))
    [ε.IsOver (Spec (.of 𝕜))] [ψ.IsOver (Spec (.of 𝕜))] [δ.IsOver (Spec (.of 𝕜))] :
    (transport ε ψ δ).IsOver (Spec (.of 𝕜)) := by
  haveI hmid : (ψ.trans δ).IsOver (Spec (.of 𝕜)) :=
    Work.Motivic.pseudoReg_isOver_trans ψ δ
  rw [transport_def]
  exact Work.Motivic.pseudoReg_isOver_trans ε (ψ.trans δ)

/-- The **transported Cremona map** of an L-link: the affine transport, regarded as an element of
the Cremona group `Cr 𝕜 4 = Bir(𝔸⁴/𝕜)` of the challenge. -/
noncomputable def transportCr [S.Over (Spec (.of 𝕜))] [T.Over (Spec (.of 𝕜))]
    (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T) (δ : T.BirationalMap (Affine4 𝕜))
    [ε.IsOver (Spec (.of 𝕜))] [ψ.IsOver (Spec (.of 𝕜))] [δ.IsOver (Spec (.of 𝕜))] : Cr 𝕜 4 :=
  ⟨transport ε ψ δ, transport_isOver ε ψ δ⟩

@[simp]
theorem transportCr_coe [S.Over (Spec (.of 𝕜))] [T.Over (Spec (.of 𝕜))]
    (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T) (δ : T.BirationalMap (Affine4 𝕜))
    [ε.IsOver (Spec (.of 𝕜))] [ψ.IsOver (Spec (.of 𝕜))] [δ.IsOver (Spec (.of 𝕜))] :
    ((transportCr ε ψ δ : Cr 𝕜 4) : (Affine4 𝕜).BirationalMap (Affine4 𝕜)) =
      transport ε ψ δ := rfl

/-- **Additivity of the invariant coefficient along the transport**: the coefficient of the
transported map splits into the three coefficients of its factors. -/
theorem cInv_transport_eq [Variety 𝕜 S] [Variety 𝕜 T]
    (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T) (δ : T.BirationalMap (Affine4 𝕜))
    [ε.IsOver (Spec (.of 𝕜))] [ψ.IsOver (Spec (.of 𝕜))] [δ.IsOver (Spec (.of 𝕜))]
    {Z : Scheme.{0}} [Z.Over (Spec (.of 𝕜))] (z : Z) :
    cInv 𝕜 z (transport ε ψ δ) = cInv 𝕜 z ε + cInv 𝕜 z ψ + cInv 𝕜 z δ := by
  haveI hmid : (ψ.trans δ).IsOver (Spec (.of 𝕜)) :=
    Work.Motivic.pseudoReg_isOver_trans ψ δ
  have h2 := Work.Motivic.cInv_add (𝕜 := 𝕜) (X := S) (Y := T) (Z := Affine4 𝕜) z ψ δ
  have h1 := Work.Motivic.cInv_add (𝕜 := 𝕜) (X := Affine4 𝕜) (Y := S) (Z := Affine4 𝕜) z ε
    (ψ.trans δ)
  rw [transport_def, h1, h2]
  first | refl_ring1 | ring

/-- The transport of a link whose two identification maps have vanishing invariant coefficient has
the same coefficient as the link itself: the paper's `c(φ) = c(ψ)` transported to `𝔸⁴`
(strong rationality of the two sides of an L-link). -/
theorem cInv_transport_eq_of_eq_zero [Variety 𝕜 S] [Variety 𝕜 T]
    (ε : (Affine4 𝕜).BirationalMap S) (ψ : S.BirationalMap T) (δ : T.BirationalMap (Affine4 𝕜))
    [ε.IsOver (Spec (.of 𝕜))] [ψ.IsOver (Spec (.of 𝕜))] [δ.IsOver (Spec (.of 𝕜))]
    {Z : Scheme.{0}} [Z.Over (Spec (.of 𝕜))] (z : Z)
    (hε : cInv 𝕜 z ε = 0) (hδ : cInv 𝕜 z δ = 0) :
    cInv 𝕜 z (transport ε ψ δ) = cInv 𝕜 z ψ := by
  rw [cInv_transport_eq ε ψ δ z, hε, hδ]
  first | refl_ring1 | ring

/-! ## Products and stable birationality -/

/-- The product of two `𝕜`-schemes: the fibred product over `Spec 𝕜`. -/
noncomputable def prodOver (𝕜 : Type) [Field 𝕜] (X Y : Scheme.{0}) [X.Over (Spec (.of 𝕜))]
    [Y.Over (Spec (.of 𝕜))] : Scheme.{0} :=
  pullback (X ↘ Spec (.of 𝕜)) (Y ↘ Spec (.of 𝕜))

/-- The product of two `𝕜`-schemes is a `𝕜`-scheme (via the first projection). -/
noncomputable instance prodOverOver (X Y : Scheme.{0}) [X.Over (Spec (.of 𝕜))] [Y.Over (Spec (.of 𝕜))] :
    (prodOver 𝕜 X Y).Over (Spec (.of 𝕜)) :=
  ⟨pullback.fst _ _ ≫ (X ↘ Spec (.of 𝕜))⟩

/-- **Stable birationality** over `𝕜` (the relation used in Totaro's Corollary `cor-CYnSB`):
`X × 𝔸ⁿ` is birational to `Y × 𝔸ᵐ` for some `n, m`.  We use affine space rather than projective
space since only the function field matters and `𝔸ⁿ` is birational to `ℙⁿ` over any field. -/
def StablyBirational (𝕜 : Type) [Field 𝕜] (X Y : Scheme.{0}) [Variety 𝕜 X] [Variety 𝕜 Y] : Prop :=
  ∃ (n m : ℕ)
    (_ : Variety 𝕜 (prodOver 𝕜 X (𝔸(Fin n; Spec (.of 𝕜)))))
    (_ : Variety 𝕜 (prodOver 𝕜 Y (𝔸(Fin m; Spec (.of 𝕜))))),
    Nonempty (BirationalMap (prodOver 𝕜 X (𝔸(Fin n; Spec (.of 𝕜))))
      (prodOver 𝕜 Y (𝔸(Fin m; Spec (.of 𝕜)))))

/-- Isomorphisms of `𝕜`-schemes, i.e. isomorphisms compatible with the structure morphisms.  This
is the relation whose failure over `ℂ` is the geometric input of the K3 construction
(`S_ℂ ≄ S'_ℂ` for the two Fourier–Mukai partners). -/
def IsoOver (𝕜 : Type) [Field 𝕜] (X Y : Scheme.{0}) [X.Over (Spec (.of 𝕜))]
    [Y.Over (Spec (.of 𝕜))] : Prop :=
  ∃ e : X ≅ Y, e.hom.IsOver (Spec (.of 𝕜))

/-! ## The named geometric predicates

These stand for the geometric hypotheses of the Hassett–Lai/Totaro inputs which Mathlib is not
able to express.  They are *named inputs*: they are hypotheses, they are never proved in this
area, and they are recorded so that the named theorem-level inputs can refer to them.  Nothing in
the *computation* (the link `cInv = 1`) depends on them; they are consumed only by the named
inputs of `Submission/Work/K3/HL.lean`. -/

/-- **Named geometric predicate**: `X` is a smooth projective K3 surface of degree `12` over `𝕜`
(with a fixed polarization `H`, `H² = 12`).

Mathlib has no notion of smoothness, projectivity, canonical bundle, Néron–Severi group or
intersection number of divisors, so this cannot be defined; it is a named hypothesis. -/
class IsK3Degree12 (𝕜 : Type) [Field 𝕜] (X : Scheme.{0}) [Variety 𝕜 X] : Prop

/-- **Named geometric predicate**: the geometric Picard rank of `X` is one
(`ρ(X_ℂ) = 1`); again not expressible in Mathlib. -/
class PicardRankOneGeom (𝕜 : Type) [Field 𝕜] (X : Scheme.{0}) [Variety 𝕜 X] : Prop

/-- **Named geometric predicate**: `X` has trivial canonical bundle (`K_X ∼ 0`), the hypothesis of
Totaro's theorem `thm:BurtCY`/Corollary `cor-CYnSB`. -/
class IsKTrivial (𝕜 : Type) [Field 𝕜] (X : Scheme.{0}) [Variety 𝕜 X] : Prop


/-! ## The API of `IsoOver` -/

namespace IsoOver

variable {𝕜 : Type} [Field 𝕜] {X Y Z X' Y' : Scheme.{0}}

/-- Isomorphism over the base is reflexive. -/
theorem refl (𝕜 : Type) [Field 𝕜] (X : Scheme.{0}) [X.Over (Spec (.of 𝕜))] :
    IsoOver 𝕜 X X :=
  ⟨Iso.refl X, by rw [Hom.isOver_iff]; simp⟩

/-- The inverse of an isomorphism over the base is again over the base. -/
theorem symm_hom_isOver {X Y : Scheme.{0}} [X.Over (Spec (.of 𝕜))] [Y.Over (Spec (.of 𝕜))]
    (e : X ≅ Y) [e.hom.IsOver (Spec (.of 𝕜))] : e.symm.hom.IsOver (Spec (.of 𝕜)) := by
  rw [Hom.isOver_iff] at ‹e.hom.IsOver (Spec (.of 𝕜))› ⊢
  calc e.inv ≫ (X ↘ Spec (.of 𝕜)) = e.inv ≫ e.hom ≫ (Y ↘ Spec (.of 𝕜)) := by
        rw [‹e.hom ≫ (Y ↘ Spec (.of 𝕜)) = X ↘ Spec (.of 𝕜)›]
    _ = (e.inv ≫ e.hom) ≫ (Y ↘ Spec (.of 𝕜)) := by rw [Category.assoc]
    _ = 𝟙 Y ≫ (Y ↘ Spec (.of 𝕜)) := by rw [Iso.inv_hom_id]
    _ = Y ↘ Spec (.of 𝕜) := by rw [Category.id_comp]

/-- Isomorphism over the base is symmetric. -/
theorem symm {X Y : Scheme.{0}} [X.Over (Spec (.of 𝕜))] [Y.Over (Spec (.of 𝕜))]
    (h : IsoOver 𝕜 X Y) : IsoOver 𝕜 Y X := by
  obtain ⟨e, he⟩ := h
  exact ⟨e.symm, symm_hom_isOver e⟩

/-- Isomorphism over the base is transitive. -/
theorem trans [X.Over (Spec (.of 𝕜))] [Y.Over (Spec (.of 𝕜))] [Z.Over (Spec (.of 𝕜))]
    (h : IsoOver 𝕜 X Y) (h' : IsoOver 𝕜 Y Z) : IsoOver 𝕜 X Z := by
  obtain ⟨e, he⟩ := h
  obtain ⟨e', he'⟩ := h'
  refine ⟨e.trans e', ?_⟩
  rw [Hom.isOver_iff] at he he' ⊢
  rw [Iso.trans_hom, Category.assoc, he', he]

/-- Isomorphisms over the base can be transported along isomorphisms over the base. -/
theorem congr [X.Over (Spec (.of 𝕜))] [Y.Over (Spec (.of 𝕜))] [X'.Over (Spec (.of 𝕜))]
    [Y'.Over (Spec (.of 𝕜))] (e : X ≅ Y) [he : e.hom.IsOver (Spec (.of 𝕜))] (e' : X' ≅ Y')
    [he' : e'.hom.IsOver (Spec (.of 𝕜))] (h : IsoOver 𝕜 X X') : IsoOver 𝕜 Y Y' := by
  obtain ⟨f, hf⟩ := h
  refine ⟨e.symm.trans (f.trans e'), ?_⟩
  have h1 : e.symm.hom.IsOver (Spec (.of 𝕜)) := symm_hom_isOver e
  rw [Hom.isOver_iff] at h1 hf he' ⊢
  rw [Iso.trans_hom, Iso.trans_hom]
  simp only [Category.assoc]
  rw [he', hf, h1]

end IsoOver

end Work.K3

