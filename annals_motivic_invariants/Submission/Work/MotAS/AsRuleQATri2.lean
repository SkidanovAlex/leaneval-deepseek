      + asE0 a b g * (asBex0 a b g * asBex2 a b g)
      + (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g) *
          (asBex0 a b g * (asE0 a b g * asE2 a b g)
            + asE0 a b g * (asBex0 a b g * asE2 a b g + asE0 a b g * asBex2 a b g)
            + (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g)
                * (asE0 a b g * (asE0 a b g * asE2 a b g)))

theorem hX2 (a b g : K) :
    asAex0 a b g * (asAex0 a b g * asAex2 a b g)
      = asBex0 a b g * (asBex0 a b g * asBex2 a b g)
        + (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g) * asCorr2 a b g := by
  rw [asCorr2]
  rw [hred0, hred2]
  refl_ring1

theorem hdiv2 (a b g : K) :
    (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g) ∣
      Polynomial.C (asCt2 a b g) * (asAex0 a b g * (asAex0 a b g * asAex2 a b g))
        - Polynomial.C (asCt2 a b g) * asTriR2 a b g := by
  refine ⟨Polynomial.C (asCt2 a b g) * (asTriQ2 a b g + asCorr2 a b g), ?_⟩
  rw [hX2, hcert2]
  refl_ring1

end

end Work.MotAS
