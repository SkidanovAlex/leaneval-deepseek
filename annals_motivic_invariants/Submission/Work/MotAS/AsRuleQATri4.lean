  simp only [asBex0, asBex1, asBex3, asTriQ4, asTriR4, asTriQ4_c0, asTriQ4_c1, asTriQ4_c2, asTriQ4_c3, asTriQ4_c4, asTriQ4_c5, asTriQ4_c6, asTriR4_c0, asTriR4_c1, asTriR4_c2, asTriR4_c3, asTriR4_c4, asAex0_c0, asAex0_c1, asAex0_c2, asAex0_c3, asAex0_c5, asAex1_c0, asAex1_c1, asAex1_c2, asAex1_c3, asAex1_c4, asAex1_c5, asAex1_c6, asAex3_c0, asAex3_c1, asAex3_c2, asAex3_c3, asAex3_c4,
    Polynomial.C_add, Polynomial.C_sub, Polynomial.C_mul, Polynomial.C_pow, Polynomial.C_neg,
    Polynomial.C_ofNat, Polynomial.C_eq_natCast]
  refl_ring1

noncomputable def asCorr4 (a b g : K) : Polynomial K :=
    asBex0 a b g * (asBex1 a b g * asE3 a b g + asE1 a b g * asBex3 a b g)
      + asE0 a b g * (asBex1 a b g * asBex3 a b g)
      + (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g) *
          (asBex0 a b g * (asE1 a b g * asE3 a b g)
            + asE0 a b g * (asBex1 a b g * asE3 a b g + asE1 a b g * asBex3 a b g)
            + (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g)
                * (asE0 a b g * (asE1 a b g * asE3 a b g)))

theorem hX4 (a b g : K) :
    asAex0 a b g * (asAex1 a b g * asAex3 a b g)
      = asBex0 a b g * (asBex1 a b g * asBex3 a b g)
        + (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g) * asCorr4 a b g := by
  rw [asCorr4]
  rw [hred0, hred1, hred3]
  refl_ring1

theorem hdiv4 (a b g : K) :
    (Polynomial.X ^(5:ℕ) - Polynomial.X - Polynomial.C g) ∣
      Polynomial.C (asCt4 a b g) * (asAex0 a b g * (asAex1 a b g * asAex3 a b g))
        - Polynomial.C (asCt4 a b g) * asTriR4 a b g := by
  refine ⟨Polynomial.C (asCt4 a b g) * (asTriQ4 a b g + asCorr4 a b g), ?_⟩
  rw [hX4, hcert4]
  refl_ring1

end

