lemma step24_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, Zv3 y l * w ^ (l:ℕ)) = ∑ l, K24_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, Zv3, K24_1]
  refl_ring1


lemma step24_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, K24_1 g y l * w ^ (l:ℕ)) = ∑ l, K24_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, K24_1, K24_2]
  refl_ring1


lemma step24_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, K24_2 g y l * w ^ (l:ℕ)) = ∑ l, K24_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, K24_2, K24_3]
  refl_ring1


lemma step24_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, K24_3 g y l * w ^ (l:ℕ)) = ∑ l, K24_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, K24_3, K24_4]
