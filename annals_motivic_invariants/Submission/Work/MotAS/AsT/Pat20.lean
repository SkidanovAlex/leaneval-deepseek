lemma step20_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv4 y l * w ^ (l:ℕ)) * (∑ l, Zv4 y l * w ^ (l:ℕ)) = ∑ l, K20_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv4, Zv4, K20_1]
  refl_ring1


lemma step20_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv4 y l * w ^ (l:ℕ)) * (∑ l, K20_1 g y l * w ^ (l:ℕ)) = ∑ l, K20_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv4, K20_1, K20_2]
  refl_ring1


lemma step20_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, K20_2 g y l * w ^ (l:ℕ)) = ∑ l, K20_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, K20_2, K20_3]
  refl_ring1


lemma step20_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K20_3 g y l * w ^ (l:ℕ)) = ∑ l, K20_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, K20_3, K20_4]
  refl_ring1


theorem pat20 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    AX w y 1*(AX w y 2*((AX w y 4)^3)) = ∑ l, K20_4 g y l * w ^ (l:ℕ) := by
  simp only [AX, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, pw2, pw3, pw4, pw5, mul_assoc]
  rw [step20_1 g w hw y, step20_2 g w hw y, step20_3 g w hw y, step20_4 g w hw y]


