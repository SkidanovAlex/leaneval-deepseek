lemma step4_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv4 y l * w ^ (l:ℕ)) * (∑ l, Zv4 y l * w ^ (l:ℕ)) = ∑ l, K4_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv4, Zv4, K4_1]
  refl_ring1


lemma step4_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, K4_1 g y l * w ^ (l:ℕ)) = ∑ l, K4_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, K4_1, K4_2]
  refl_ring1


lemma step4_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, K4_2 g y l * w ^ (l:ℕ)) = ∑ l, K4_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, K4_2, K4_3]
  refl_ring1


lemma step4_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, K4_3 g y l * w ^ (l:ℕ)) = ∑ l, K4_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, K4_3, K4_4]
  refl_ring1


theorem pat4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (AX w y 2)^2*(AX w y 3*((AX w y 4)^2)) = ∑ l, K4_4 g y l * w ^ (l:ℕ) := by
  simp only [AX, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, pw2, pw3, pw4, pw5, mul_assoc]
  rw [step4_1 g w hw y, step4_2 g w hw y, step4_3 g w hw y, step4_4 g w hw y]


end Work.MotAS.AsT
