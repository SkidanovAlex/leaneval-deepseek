lemma step5_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv4 y l * w ^ (l:ℕ)) * (∑ l, Zv4 y l * w ^ (l:ℕ)) = ∑ l, K5_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv4, Zv4, K5_1]
  refl_ring1


lemma step5_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K5_1 g y l * w ^ (l:ℕ)) = ∑ l, K5_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, K5_1, K5_2]
  refl_ring1


lemma step5_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K5_2 g y l * w ^ (l:ℕ)) = ∑ l, K5_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, K5_2, K5_3]
  refl_ring1


lemma step5_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K5_3 g y l * w ^ (l:ℕ)) = ∑ l, K5_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K5_3, K5_4]
  refl_ring1


theorem pat5 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    AX w y 0*((AX w y 1)^2*((AX w y 4)^2)) = ∑ l, K5_4 g y l * w ^ (l:ℕ) := by
