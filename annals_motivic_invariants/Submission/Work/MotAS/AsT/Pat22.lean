lemma step22_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, Zv1 y l * w ^ (l:ℕ)) = ∑ l, K22_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, Zv1, K22_1]
  refl_ring1


lemma step22_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K22_1 g y l * w ^ (l:ℕ)) = ∑ l, K22_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
