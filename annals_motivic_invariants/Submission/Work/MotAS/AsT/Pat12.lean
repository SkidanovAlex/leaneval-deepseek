lemma step12_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, Zv2 y l * w ^ (l:ℕ)) = ∑ l, K12_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, Zv2, K12_1]
  refl_ring1


lemma step12_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K12_1 g y l * w ^ (l:ℕ)) = ∑ l, K12_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, K12_1, K12_2]
  refl_ring1


lemma step12_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K12_2 g y l * w ^ (l:ℕ)) = ∑ l, K12_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, K12_2, K12_3]
