lemma step16_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, Zv3 y l * w ^ (l:ℕ)) = ∑ l, K16_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, Zv3, K16_1]
  refl_ring1


lemma step16_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K16_1 g y l * w ^ (l:ℕ)) = ∑ l, K16_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K16_1, K16_2]
  refl_ring1


lemma step16_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K16_2 g y l * w ^ (l:ℕ)) = ∑ l, K16_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K16_2, K16_3]
  refl_ring1


lemma step16_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K16_3 g y l * w ^ (l:ℕ)) = ∑ l, K16_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K16_3, K16_4]
  refl_ring1


theorem pat16 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (AX w y 0)^3*(AX w y 2*(AX w y 3)) = ∑ l, K16_4 g y l * w ^ (l:ℕ) := by
  simp only [AX, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, pw2, pw3, pw4, pw5, mul_assoc]
  rw [step16_1 g w hw y, step16_2 g w hw y, step16_3 g w hw y, step16_4 g w hw y]


end Work.MotAS.AsT
