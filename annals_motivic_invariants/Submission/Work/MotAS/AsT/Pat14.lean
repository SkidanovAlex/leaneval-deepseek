lemma step14_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, Zv3 y l * w ^ (l:ℕ)) = ∑ l, K14_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, Zv3, K14_1]
  refl_ring1


lemma step14_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, K14_1 g y l * w ^ (l:ℕ)) = ∑ l, K14_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, K14_1, K14_2]
  refl_ring1


lemma step14_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv2 y l * w ^ (l:ℕ)) * (∑ l, K14_2 g y l * w ^ (l:ℕ)) = ∑ l, K14_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv2, K14_2, K14_3]
  refl_ring1


lemma step14_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, K14_3 g y l * w ^ (l:ℕ)) = ∑ l, K14_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, K14_3, K14_4]
  refl_ring1


theorem pat14 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    AX w y 1*((AX w y 2)^3*(AX w y 3)) = ∑ l, K14_4 g y l * w ^ (l:ℕ) := by
  simp only [AX, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, pw2, pw3, pw4, pw5, mul_assoc]
  rw [step14_1 g w hw y, step14_2 g w hw y, step14_3 g w hw y, step14_4 g w hw y]


end Work.MotAS.AsT
