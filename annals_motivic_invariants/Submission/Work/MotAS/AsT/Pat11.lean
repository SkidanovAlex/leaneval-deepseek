lemma step11_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv1 y l * w ^ (l:ℕ)) * (∑ l, Zv4 y l * w ^ (l:ℕ)) = ∑ l, K11_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv1, Zv4, K11_1]
  refl_ring1


lemma step11_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K11_1 g y l * w ^ (l:ℕ)) = ∑ l, K11_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K11_1, K11_2]
  refl_ring1


lemma step11_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K11_2 g y l * w ^ (l:ℕ)) = ∑ l, K11_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K11_2, K11_3]
  refl_ring1


lemma step11_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K11_3 g y l * w ^ (l:ℕ)) = ∑ l, K11_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K11_3, K11_4]
  refl_ring1


theorem pat11 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (AX w y 0)^3*(AX w y 1*(AX w y 4)) = ∑ l, K11_4 g y l * w ^ (l:ℕ) := by
  simp only [AX, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, pw2, pw3, pw4, pw5, mul_assoc]
  rw [step11_1 g w hw y, step11_2 g w hw y, step11_3 g w hw y, step11_4 g w hw y]


