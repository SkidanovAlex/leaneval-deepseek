lemma step1_1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, Zv4 y l * w ^ (l:ℕ)) = ∑ l, K1_1 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, Zv4, K1_1]
  refl_ring1


lemma step1_2 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv3 y l * w ^ (l:ℕ)) * (∑ l, K1_1 g y l * w ^ (l:ℕ)) = ∑ l, K1_2 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv3, K1_1, K1_2]
  refl_ring1


lemma step1_3 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K1_2 g y l * w ^ (l:ℕ)) = ∑ l, K1_3 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K1_2, K1_3]
  refl_ring1


lemma step1_4 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (∑ l, Zv0 y l * w ^ (l:ℕ)) * (∑ l, K1_3 g y l * w ^ (l:ℕ)) = ∑ l, K1_4 g y l * w ^ (l:ℕ) := by
  rw [redMul_spec g w hw]
  simp only [Fin.sum_univ_five, redMul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, Zv0, K1_3, K1_4]
  refl_ring1


theorem pat1 (g w : R) (hw : w ^ 5 = w + g) (y : Fin 5 → R) :
    (AX w y 0)^2*((AX w y 3)^2*(AX w y 4)) = ∑ l, K1_4 g y l * w ^ (l:ℕ) := by
  simp only [AX, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, pw2, pw3, pw4, pw5, mul_assoc]
  rw [step1_1 g w hw y, step1_2 g w hw y, step1_3 g w hw y, step1_4 g w hw y]


end Work.MotAS.AsT
