import Mathlib
import Submission.Work.MotAS.SdualAS2Defs

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# `Work.MotAS.AsCoeff6Defs` — the degree-6 coefficient forms of `R^AS(A + T·B)`

The corrected AS chart of the Crauder–Katz link (`Submission/Work/MotAS/CensusAS2.lean`) has
ruling lines `ℓ_c = {asRuleQW a b g c t}` (`Submission/Work/MotAS/SdualAS2Defs.lean`) and inverse
map `kleinRAS a b g`.  The inverse map is a cubic form and `asRuleQW a b g c t = A(c) + t·B(c)`
is linear in `t` with `A, B` quadratic in `c`; hence

  `R^AS(A(c) + T·B(c))`

is a polynomial of degree `≤ 3` in `T` whose `T^j`-coefficient is a **degree-6 form** in `c`.
This file packages those four coefficient forms as elements of `MvPolynomial (Fin 5) R`
(the variables being the coordinates of `c`), together with the degree-6 part `asIdeal6` of the
AS Pfaffian ideal.

* `qAS_A a b g`, `qAS_B a b g` — the two ruling vectors `A(c)`, `B(c)` evaluated at the variables
  `X 0, …, X 4`;
* `asCoeffPoly a b g` — `R^AS_0(A + T·B)` as a polynomial in `T` over `MvPolynomial (Fin 5) R`;
* `asCoeff6 a b g j` — its `T^j`-coefficient, a form of degree `6`;
* `asIdeal6 a b g` — the span of `p_k(X) · m` over the five AS Pfaffians `p_k` and the degree-4
  monomials `m`, i.e. the degree-6 part of the ideal generated by `p_0, …, p_4`.

The open node `Work.MotAS.asCoeff6_notMem` states that one of the four forms is *not* in
`asIdeal6` (under `a b ≠ 0`, `a²-ab-b² ≠ 0`); combined with the degree-6 kernel statement of the
AS Pfaffian ideal this gives the non-vanishing
`kleinRAS (asRuleQW … ) ≠ 0` of `Work.MotAS.asRuleQW_kleinRAS_ne_zero`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

namespace Work.MotAS

open MvPolynomial

variable (R : Type*) [CommRing R]

/-- The first ruling vector `A(c) = dP^AS_c(asTanQ(·,1))` evaluated at the variables
`X 0, …, X 4`: a quadratic form. -/
noncomputable def qAS_A (a b g : R) : Fin 5 → MvPolynomial (Fin 5) R :=
  fun k => asRuleQA (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
    (fun i => MvPolynomial.X i) k

/-- The second ruling vector `B(c) = dP^AS_c(asTanQ(·,2))` evaluated at the variables
`X 0, …, X 4`: a quadratic form. -/
noncomputable def qAS_B (a b g : R) : Fin 5 → MvPolynomial (Fin 5) R :=
  fun k => asRuleQB (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
    (fun i => MvPolynomial.X i) k

/-- `R^AS_0(A + T·B)` as a polynomial in `T` over `MvPolynomial (Fin 5) R`. -/
noncomputable def asCoeffPoly (a b g : R) : Polynomial (MvPolynomial (Fin 5) R) :=
  kleinRAS0 (Polynomial.C (MvPolynomial.C a)) (Polynomial.C (MvPolynomial.C b))
    (Polynomial.C (MvPolynomial.C g))
    (fun k => Polynomial.C (qAS_A R a b g k) + Polynomial.X * Polynomial.C (qAS_B R a b g k))

/-- The coefficient of `T^j` in `R^AS_0(A + T·B)`: a form of degree `6` in the variables `X i`. -/
noncomputable def asCoeff6 (a b g : R) (j : ℕ) : MvPolynomial (Fin 5) R :=
  (asCoeffPoly R a b g).coeff j

/-- The degree-6 part of the AS Pfaffian ideal: the span of `p_k(X) · m` over the five Pfaffians
`p_k = kleinPAS a b g (X ·)` and the degree-4 monomials `m`. -/
noncomputable def asIdeal6 (a b g : R) : Submodule R (MvPolynomial (Fin 5) R) :=
  Submodule.span R
    (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 4} =>
      kleinPAS (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
        (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1))

theorem qAS_A_apply (a b g : R) (k : Fin 5) :
    qAS_A R a b g k = asRuleQA (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) k := rfl

theorem qAS_B_apply (a b g : R) (k : Fin 5) :
    qAS_B R a b g k = asRuleQB (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) k := rfl

theorem asCoeff6_eq (a b g : R) (j : ℕ) :
    asCoeff6 R a b g j = (asCoeffPoly R a b g).coeff j := rfl

end Work.MotAS
