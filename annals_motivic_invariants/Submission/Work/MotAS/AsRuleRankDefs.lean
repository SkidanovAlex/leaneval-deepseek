/-!
# `Work.MotAS.AsRuleRankDefs` — the AS `(0,1)`-minor as a polynomial

The AS ruling vectors `asRuleQA`, `asRuleQB` (`Submission/Work/MotAS/SdualAS2Defs.lean`) are
`2`-homogeneous polynomial functions of the curve point `c`.  This file packages

* `asRuleMinP a b g` — the `(0,1)`-minor `asRuleQA c 1 * asRuleQB c 0 - asRuleQA c 0 *
  asRuleQB c 1` as a homogeneous quartic form in the five AS Galois coordinates `X 0, …, X 4`;
* `kleinPASm a b g` — the five AS Pfaffians as quadratic forms in the same coordinates.

They are the objects of the two open nodes

* `Work.MotAS.asRuleMinP_notMem` — the certificate that the quartic is *not* in the ideal
  generated by the five Pfaffians (a purely polynomial statement);
* `Work.MotAS.asRuleMinP_kernel` — the kernel of the evaluation of the five coordinates at the
  AS Galois coordinates `asTwY D g` in `Om D` is exactly that ideal.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

namespace Work.MotAS

open MvPolynomial

variable {K : Type} [CommRing K]

/-- The AS `(0,1)`-minor as a homogeneous quartic form in the five AS Galois coordinates. -/
noncomputable def asRuleMinP (a b g : K) : MvPolynomial (Fin 5) K :=
  asRuleQA (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) 1
    * asRuleQB (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) 0
  - asRuleQA (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) 0
    * asRuleQB (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) 1

/-- The five AS Pfaffians as quadratic forms in the five AS Galois coordinates. -/
noncomputable def kleinPASm (a b g : K) : Fin 5 → MvPolynomial (Fin 5) K :=
  fun k => kleinPAS (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C g)
      (fun i => MvPolynomial.X i) k

end Work.MotAS
