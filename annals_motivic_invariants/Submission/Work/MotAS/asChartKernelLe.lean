/-!
# `Work.MotAS.asChartKernelLe_of_aux` — the kernel inclusion in the AS chart

The statement of `Work.MotAS.ker_le_of_aux` (`Submission/Work/MotAS/asChartIdeal_isPrime.lean`)
copied here, so that `Work.MotAS.ASZChartPresentation` can use it: `asChartIdeal_isPrime.lean`
imports `ASZChartPresentation`, so the latter cannot import it back.

The argument is short: `asChartIdeal = √(p^AS_0, …, p^AS_4) + (X₀ - 1)`; the chart evaluation
`asChartPhi` kills it (`asChartIdeal_le_ker`), and for `f ∈ RingHom.ker (asChartPhi)` we homogenise
`f` to a form `F` of the same total degree with `F - f ∈ (X₀ - 1)` and
`aeval (asTwY D g) F = 0` (`Work.MotAS.asChartHomogenise`); the *transported Klein kernel*
statement `F ∈ (p^AS_0, …, p^AS_4)` then gives
`f = F - (F - f) ∈ (p^AS_0,…,p^AS_4) + (X₀ - 1) = asChartIdeal`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

namespace Work.MotAS

open MvPolynomial

variable {𝕜 : Type} [Field 𝕜] [CharP 𝕜 5]

/-- **The ideal generated by the five transported (AS) Pfaffians.** -/
noncomputable def asPFIdeal' (a b g : RatFunc 𝕜) : Ideal (MvPolynomial (Fin 5) (RatFunc 𝕜)) :=
  Ideal.span (Set.range (kleinPASm a b g))

theorem asPFIdeal'_le_asQideal (a b g : RatFunc 𝕜) : asPFIdeal' (𝕜 := 𝕜) a b g ≤ asQideal a b g := by
  rw [asPFIdeal', asQideal]
  refine le_trans (Ideal.span_mono ?_) Ideal.le_radical
  rintro x ⟨k, rfl⟩
  exact ⟨k, rfl⟩

/-- **The kernel of the chart evaluation is contained in the chart ideal**, given the transported
Klein kernel statement `hKAE` and the homogenisation `hHom`. -/
theorem asChartKernelLe_of_aux (D : Work.MotV.KleinData 𝕜) (hD : Work.MotV5.KleinData.ASGood D)
    (g : RatFunc 𝕜)
    (hKAE : ∀ (n : ℕ) (F : MvPolynomial (Fin 5) (RatFunc 𝕜)),
      F ∈ MvPolynomial.homogeneousSubmodule (Fin 5) (RatFunc 𝕜) n →
      MvPolynomial.aeval (asTwY D g) F = 0 → F ∈ asPFIdeal' (𝕜 := 𝕜) (aK D) (bK D) g)
    (hHom : ∀ f : MvPolynomial (Fin 5) (RatFunc 𝕜), asChartPhiOm D g f = 0 →
      ∃ F : MvPolynomial (Fin 5) (RatFunc 𝕜),
        F ∈ MvPolynomial.homogeneousSubmodule (Fin 5) (RatFunc 𝕜) f.totalDegree ∧
          MvPolynomial.aeval (asTwY D g) F = 0 ∧
          F - f ∈ Ideal.span {MvPolynomial.X (0 : Fin 5) - 1}) :
    RingHom.ker (asChartPhi D g) ≤ asChartIdeal (aK D) (bK D) g := by
  intro f hf
  -- the twist-field-valued vanishing implies the `Om D`-valued one
  have hfom : asChartPhiOm D g f = 0 := by
    have h1 : ((asChartPhi D g f : ↥(twistFieldAS D g)) : Work.MotV.Om D) = 0 := by
      rw [RingHom.mem_ker.mp hf]
      simp
    rwa [asChartPhi_coe] at h1
  obtain ⟨F, hFhom, hFaeval, hFdiff⟩ := hHom f hfom
  have hFmem : F ∈ asPFIdeal' (𝕜 := 𝕜) (aK D) (bK D) g := hKAE f.totalDegree F hFhom hFaeval
  have hsub : asPFIdeal' (𝕜 := 𝕜) (aK D) (bK D) g ≤ asChartIdeal (aK D) (bK D) g :=
    le_trans (asPFIdeal'_le_asQideal (aK D) (bK D) g) le_sup_left
  have hspan : (Ideal.span {MvPolynomial.X (0 : Fin 5) - 1} :
      Ideal (MvPolynomial (Fin 5) (RatFunc 𝕜))) ≤ asChartIdeal (aK D) (bK D) g := le_sup_right
  have : f = F - (F - f) := by ring
  rw [this]
  exact Ideal.sub_mem _ (hsub hFmem) (hspan hFdiff)

end Work.MotAS
