  simp only [asCt1, asCt2, asCt3, asCt4, asCt5, asCt6, asCt7, asCt8, asCt9, asCt10, asCt11, asCt12, asCt13, asCt14, asCt15, asTriR1_c4, asTriR2_c4, asTriR3_c4, asTriR4_c4, asTriR5_c4, asTriR6_c4, asTriR7_c4, asTriR8_c4, asTriR9_c4, asTriR10_c4, asTriR11_c4, asTriR12_c4, asTriR13_c4, asTriR14_c4, asTriR15_c4]
  refl_ring1

noncomputable def asW1 (a b g : K) : K :=
    a ^(3:ℕ) * b ^(3:ℕ) + 4 * a ^(4:ℕ) * b ^(2:ℕ) + 2 * a ^(5:ℕ) * b + 4 * a ^(6:ℕ)

noncomputable def asW2 (a b g : K) : K :=
    2 * b ^(6:ℕ) + 2 * a * b ^(5:ℕ) + a ^(2:ℕ) * b ^(4:ℕ) + 3 * a ^(3:ℕ) * b ^(3:ℕ) + 4 * a ^(4:ℕ) * b ^(2:ℕ) + 4 * a ^(5:ℕ) * b + 2 * b ^(6:ℕ) * g + a * b ^(5:ℕ) * g + 4 * a ^(2:ℕ) * b ^(4:ℕ) * g + 3 * a ^(3:ℕ) * b ^(3:ℕ) * g + 3 * a ^(4:ℕ) * b ^(2:ℕ) * g

noncomputable def asW3 (a b g : K) : K :=
    2 * a ^(2:ℕ) * b ^(4:ℕ) + 3 * a ^(3:ℕ) * b ^(3:ℕ) + 3 * a ^(4:ℕ) * b ^(2:ℕ) + 3 * a ^(5:ℕ) * b + 3 * a ^(6:ℕ) + 2 * a * b ^(5:ℕ) * g + 2 * a ^(2:ℕ) * b ^(4:ℕ) * g + 4 * a ^(4:ℕ) * b ^(2:ℕ) * g + 3 * a ^(6:ℕ) * g

noncomputable def asW4 (a b g : K) : K :=
    b ^(6:ℕ) + a * b ^(5:ℕ) + 3 * a ^(2:ℕ) * b ^(4:ℕ) + 4 * a ^(3:ℕ) * b ^(3:ℕ) + 2 * a ^(4:ℕ) * b ^(2:ℕ) + 3 * a ^(5:ℕ) * b + 3 * a ^(6:ℕ) + b ^(6:ℕ) * g + a ^(2:ℕ) * b ^(4:ℕ) * g + a ^(3:ℕ) * b ^(3:ℕ) * g + 2 * a ^(4:ℕ) * b ^(2:ℕ) * g + a ^(5:ℕ) * b * g + 2 * a ^(6:ℕ) * g

noncomputable def asW5 (a b g : K) : K :=
    0

theorem asBezout (a b g : K) :
    asW1 a b g * asPhiP_cE0 a b g + asW2 a b g * asPhiP_cE1 a b g
      + asW3 a b g * asPhiP_cE2 a b g + asW4 a b g * asPhiP_cE3 a b g
      + asW5 a b g * asPhiP_cE4 a b g
      = (a - 3 * b) ^(14:ℕ) * (a ^(13:ℕ) * b) := by
  unfold asW1 asW2 asW3 asW4 asW5
  unfold asPhiP_cE0 asPhiP_cE1 asPhiP_cE2 asPhiP_cE3 asPhiP_cE4
  try norm_num
  all_goals refl_ring1 (mod := 5)

end Work.MotAS
