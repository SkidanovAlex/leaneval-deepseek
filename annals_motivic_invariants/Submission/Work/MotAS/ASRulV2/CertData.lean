/-! ## The polynomials `P̃` (cleared eliminant) and `C` (graph numerator)

`P̃ = Dc·X⁵ + Nc4·X⁴ + … + Nc0` is the cleared eliminant of the `X₂ = 1` slice of the AS residual
curve; `C = Mc4·X⁴ + … + Mc0` is the numerator of the `X₁`-graph `X₀ = C/Ac` of that slice.
The certificate (verified numerically over 𝔽₅, 𝔽₂₅, 𝔽₁₂₅, 𝔽₆₂₅ at hundreds of random points) is

  `P̃ ∣ Ac³ · f_k(C/Ac, X₁)`   for `k = 0..4`,

where `f_k = zcubAS a b g k` with `X 2` set to `1`.  -/

/-- The cleared eliminant `P̃` of the `X₂ = 1` slice (monic up to the `(a,b)`-homogeneous factor
`Dc`; `Dc ≠ 0` for every `(a,b,g)` with `g = t³+t`). -/
noncomputable def Ptilde (a b g : K) : Polynomial K :=
  Polynomial.C (Dc a b g) * Polynomial.X ^(5:ℕ) + Polynomial.C (Nc4 a b g) * Polynomial.X ^(4:ℕ)
    + Polynomial.C (Nc3 a b g) * Polynomial.X ^(3:ℕ) + Polynomial.C (Nc2 a b g) * Polynomial.X ^(2:ℕ)
    + Polynomial.C (Nc1 a b g) * Polynomial.X + Polynomial.C (Nc0 a b g)

/-- The numerator of the graph `X₀ = Ccert/Ac` of the `X₂ = 1` slice. -/
noncomputable def Ccert (a b g : K) : Polynomial K :=
  Polynomial.C (Mc4 a b g) * Polynomial.X ^(4:ℕ) + Polynomial.C (Mc3 a b g) * Polynomial.X ^(3:ℕ)
    + Polynomial.C (Mc2 a b g) * Polynomial.X ^(2:ℕ) + Polynomial.C (Mc1 a b g) * Polynomial.X
    + Polynomial.C (Mc0 a b g)

/-- The graph `q = C/A` as a polynomial (only meaningful when `A ≠ 0`).  NOTE the parenthesisation:
`Polynomial.C ((Ac a b g)⁻¹)` — writing `Polynomial.C (Ac a b g)⁻¹` would be the *polynomial*
inverse of the constant, which is not what is meant.  This definition therefore needs `[Field K]`
(not merely `[CommRing K]`), which is why a sibling development that imports it under
`[CommRing K]` fails to elaborate. -/
noncomputable def Qcert {K : Type*} [Field K] (a b g : K) : Polynomial K :=
  Polynomial.C ((Ac a b g)⁻¹) * Ccert a b g

end Work.MotAS.ASRulV2.Cert
