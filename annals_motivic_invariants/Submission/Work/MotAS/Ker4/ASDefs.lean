import Mathlib
import Submission.Work.MotAS.AsRuleRankDefs
import Submission.Work.MotAS.Ker4.Defs

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# Degree-4 AS Pfaffian ideal (`Work.MotAS.Ker4`)

The AS (Artin–Schreier) analogues of `Work.MotAS.Ker4.kleinIdeal4`: the `Kb 𝕜`-submodule
generated by the products `kleinPASm a b g k · m` with `m` a monomial of degree `2`, together with
the AS Pfaffian ideal itself, viewed as a `Kb 𝕜`-submodule of `MvPolynomial (Fin 5) (Kb 𝕜)`
(the target statement's `Ideal.span …` lives over the *polynomial ring*
`MvPolynomial (Fin 5) (Kb 𝕜)`, which is a different module structure from the `Kb 𝕜`-module
structure used by the degree count; `restrictScalars` bridges them).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.MotAS.Ker4

open MvPolynomial

/-- The AS Pfaffian ideal `(p^AS_0, …, p^AS_4)`, viewed as a `Kb 𝕜`-submodule of
`MvPolynomial (Fin 5) (Kb 𝕜)`. -/
noncomputable def kleinIdealAS (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] (D : Work.MotV.KleinData 𝕜)
    (g : RatFunc 𝕜) : Submodule (Work.MotV.Kb 𝕜) (MvPolynomial (Fin 5) (Work.MotV.Kb 𝕜)) :=
  Submodule.restrictScalars (Work.MotV.Kb 𝕜)
    (Ideal.span (Set.range (Work.MotAS.kleinPASm (algebraMap 𝕜 (Work.MotV.Kb 𝕜) D.a)
      (algebraMap 𝕜 (Work.MotV.Kb 𝕜) D.b) (algebraMap (RatFunc 𝕜) (Work.MotV.Kb 𝕜) g))))

/-- The degree-4 part of the AS Pfaffian ideal: the `Kb 𝕜`-span of the products
`kleinPASm a b g k · m` with `m` a monomial of degree `2`. -/
noncomputable def kleinIdeal4AS (𝕜 : Type) [Field 𝕜] [CharP 𝕜 5] (D : Work.MotV.KleinData 𝕜)
    (g : RatFunc 𝕜) : Submodule (Work.MotV.Kb 𝕜) (MvPolynomial (Fin 5) (Work.MotV.Kb 𝕜)) :=
  Submodule.span (Work.MotV.Kb 𝕜)
    (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 2} =>
      Work.MotAS.kleinPASm (algebraMap 𝕜 (Work.MotV.Kb 𝕜) D.a)
          (algebraMap 𝕜 (Work.MotV.Kb 𝕜) D.b) (algebraMap (RatFunc 𝕜) (Work.MotV.Kb 𝕜) g) q.1
        * MvPolynomial.monomial q.2.1 1))

end Work.MotAS.Ker4
