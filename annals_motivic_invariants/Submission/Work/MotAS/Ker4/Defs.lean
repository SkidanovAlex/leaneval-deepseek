import Submission.Work.MotV.Defs
import Submission.Work.MotK.TwRuling.SdWNdeg
import Submission.Work.MotK.TwRuling.quinticTw_notMem_kernel

set_option linter.unusedVariables false -- v435-speed

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# Definitions for the degree-4 kernel computation (`Work.MotAS.Ker4`)

This is the vocabulary layer of the proof of `Work.MotAS.asRuleMinP_kernel`: the
"the kernel of the evaluation of a homogeneous quartic is the degree-4 part of the Pfaffian
ideal" statement, in the T-coordinates (`kleinP`) and in the AS coordinates (`kleinPASm`).

* `sdTF4 R E` — the 20 monomials `x^i` (`i < 11`) and `x^j·y` (`j < 9`) spanning `L(20·O)`;
* `hom4 R` — the degree-4 graded piece of `MvPolynomial (Fin 5) R`;
* `kleinIdeal4 R a b` — the degree-4 part of the ideal generated by the five (plain) Klein
  Pfaffians, i.e. the span of the products `kleinP_k · m` with `m` of degree 2.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open WeierstrassCurve WeierstrassCurve.Affine

namespace Work.MotAS.Ker4

/-- The 20 monomials of `L(20·O)`: `x^i` for `i < 11` and `x^j·y` for `j < 9`. -/
noncomputable def sdTF4 (R : Type) [Field R] (E : WeierstrassCurve R) :
    (Fin 11 ⊕ Fin 9) → Affine.FunctionField E :=
  Sum.elim (fun i : Fin 11 => (Work.MotV.genX E) ^ (i : ℕ))
    (fun j : Fin 9 => (Work.MotV.genX E) ^ (j : ℕ) * (Work.MotV.genY E))

@[simp] theorem sdTF4_inl (R : Type) [Field R] (E : WeierstrassCurve R) (i : Fin 11) :
    sdTF4 R E (Sum.inl i) = (Work.MotV.genX E) ^ (i : ℕ) := rfl

@[simp] theorem sdTF4_inr (R : Type) [Field R] (E : WeierstrassCurve R) (j : Fin 9) :
    sdTF4 R E (Sum.inr j) = (Work.MotV.genX E) ^ (j : ℕ) * (Work.MotV.genY E) := rfl

/-- The degree-4 graded piece of `MvPolynomial (Fin 5) R`. -/
abbrev hom4 (R : Type) [Field R] : Submodule R (MvPolynomial (Fin 5) R) :=
  MvPolynomial.homogeneousSubmodule (Fin 5) R 4

/-- The degree-4 part of the ideal generated by the five (plain) Klein Pfaffians: the `R`-span of
the products `kleinP a b X k · m` with `m` a monomial of degree 2. -/
noncomputable def kleinIdeal4 (R : Type) [Field R] (a b : R) :
    Submodule R (MvPolynomial (Fin 5) R) :=
  Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 2} =>
    Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b)
      (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1))

end Work.MotAS.Ker4
