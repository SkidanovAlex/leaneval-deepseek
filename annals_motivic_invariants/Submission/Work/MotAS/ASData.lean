/-!
# AS (characteristic 5) Galois-coordinate transport of the Klein--Fisher data

Part of the subproject `Submission/Work/MotAS` (`Work.MotAS`), the *characteristic 5*
(Artin--Schreier) branch of the Crauder--Katz chart of

* H.-Y. Lin, E. Shinder, *Motivic invariants of birational maps*, Ann. of Math. **199** (2024),

as designed in `MOTIVIC_KDATA_LEAD.md` §6.  The Artin--Schreier Galois coordinates are

* source: `x_i = Σ_j y_j (w+i)^j`, i.e. `x = asM w · y`, `asM w i j = (w+i)^j`;
* target: `z_k = Σ_j ẑ_j (w+2k)^j`, i.e. `z = asN w · ẑ`, `asN w k j = (w+2k)^j`

(the target step `2k` is forced by the shift covariance `p_k(Sx) = p_{k+3}(x)` of the Pfaffians).
The transported data below are the images of the split Klein--Fisher data of `Work.MotK` under
these substitutions, reduced modulo `w^5 = w + g` and `5 = 0`: they are *w-free*, hence
`𝕜`-rational and computable.  The transport identities are `asTransportP0..4`, `asTransportQ`,
`asTransportR0..4`, `asTransportS`, `asTransportSD` in `Work.MotAS.ASTransport`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.MotAS

variable {R : Type*} [CommRing R]

/-- Source Galois-coordinate matrix `asM w i j = (w+i)^j`. -/
def asM (w : R) : Matrix (Fin 5) (Fin 5) R := Matrix.of fun i j => (w + (i : ℕ)) ^ (j : ℕ)

/-- Target Galois-coordinate matrix `asN w k j = (w+2k)^j`. -/
def asN (w : R) : Matrix (Fin 5) (Fin 5) R := Matrix.of fun k j => (w + 2 * (k : ℕ)) ^ (j : ℕ)

/-- `p_0` in AS Galois coordinates: the `k`-th twisted Pfaffian (w-free). -/
def kleinPAS0 (a b g : R) (y : Fin 5 → R) : R :=
  2*a^ (2:ℕ)*g*y 1*y 4 + 2*a^ (2:ℕ)*g*y 2*y 3 + a^ (2:ℕ)*g*y 3*y 4 + a^ (2:ℕ)*y 0^ (2:ℕ) - 2*a^ (2:ℕ)*y 0*y 2 + 2*a^ (2:ℕ)*y 0*y 4 + a^ (2:ℕ)*y 1^ (2:ℕ) - 2*a^ (2:ℕ)*y 1*y 3 + a^ (2:ℕ)*y 2^ (2:ℕ) - 2*a^ (2:ℕ)*y 2*y 4 + a^ (2:ℕ)*y 3^ (2:ℕ) + a^ (2:ℕ)*y 4^ (2:ℕ) - 2*a*b*g*y 1*y 4 - 2*a*b*g*y 2*y 3 - a*b*y 0^ (2:ℕ) - 2*b^ (2:ℕ)*g*y 1*y 4 - 2*b^ (2:ℕ)*g*y 2*y 3 + b^ (2:ℕ)*g*y 3*y 4 - b^ (2:ℕ)*y 0^ (2:ℕ) - 2*b^ (2:ℕ)*y 0*y 2 - 2*b^ (2:ℕ)*y 0*y 4 + b^ (2:ℕ)*y 1^ (2:ℕ) + 2*b^ (2:ℕ)*y 1*y 3 - b^ (2:ℕ)*y 2^ (2:ℕ) - 2*b^ (2:ℕ)*y 2*y 4 + b^ (2:ℕ)*y 3^ (2:ℕ) - b^ (2:ℕ)*y 4^ (2:ℕ)

/-- `p_1` in AS Galois coordinates: the `k`-th twisted Pfaffian (w-free). -/
def kleinPAS1 (a b g : R) (y : Fin 5 → R) : R :=
  2*a^ (2:ℕ)*g*y 2*y 4 + a^ (2:ℕ)*g*y 3^ (2:ℕ) - a^ (2:ℕ)*g*y 4^ (2:ℕ) + 2*a^ (2:ℕ)*y 0*y 1 - a^ (2:ℕ)*y 0*y 3 + 2*a^ (2:ℕ)*y 1*y 2 + a^ (2:ℕ)*y 1*y 4 - a^ (2:ℕ)*y 2*y 3 - 2*a^ (2:ℕ)*y 3*y 4 - 2*a*b*g*y 2*y 4 - a*b*g*y 3^ (2:ℕ) - 2*a*b*y 0*y 1 - 2*a*b*y 1*y 4 - 2*a*b*y 2*y 3 - 2*b^ (2:ℕ)*g*y 2*y 4 - b^ (2:ℕ)*g*y 3^ (2:ℕ) - b^ (2:ℕ)*g*y 4^ (2:ℕ) - 2*b^ (2:ℕ)*y 0*y 1 - b^ (2:ℕ)*y 0*y 3 + 2*b^ (2:ℕ)*y 1*y 2 - b^ (2:ℕ)*y 1*y 4 + b^ (2:ℕ)*y 2*y 3 - 2*b^ (2:ℕ)*y 3*y 4

/-- `p_2` in AS Galois coordinates: the `k`-th twisted Pfaffian (w-free). -/
def kleinPAS2 (a b g : R) (y : Fin 5 → R) : R :=
  2*a^ (2:ℕ)*g*y 3*y 4 + 2*a^ (2:ℕ)*y 0*y 2 - 2*a^ (2:ℕ)*y 0*y 4 + a^ (2:ℕ)*y 1^ (2:ℕ) + 2*a^ (2:ℕ)*y 2^ (2:ℕ) - a^ (2:ℕ)*y 3^ (2:ℕ) - 2*a^ (2:ℕ)*y 4^ (2:ℕ) - 2*a*b*g*y 3*y 4 - 2*a*b*y 0*y 2 - a*b*y 1^ (2:ℕ) - 2*a*b*y 2*y 4 - a*b*y 3^ (2:ℕ) - 2*b^ (2:ℕ)*g*y 3*y 4 - 2*b^ (2:ℕ)*y 0*y 2 - 2*b^ (2:ℕ)*y 0*y 4 - b^ (2:ℕ)*y 1^ (2:ℕ) + 2*b^ (2:ℕ)*y 2^ (2:ℕ) + b^ (2:ℕ)*y 3^ (2:ℕ) - 2*b^ (2:ℕ)*y 4^ (2:ℕ)

/-- `p_3` in AS Galois coordinates: the `k`-th twisted Pfaffian (w-free). -/
def kleinPAS3 (a b g : R) (y : Fin 5 → R) : R :=
  a^ (2:ℕ)*g*y 4^ (2:ℕ) + 2*a^ (2:ℕ)*y 0*y 3 + 2*a^ (2:ℕ)*y 1*y 2 + a^ (2:ℕ)*y 1*y 4 - a^ (2:ℕ)*y 2*y 3 - 2*a^ (2:ℕ)*y 3*y 4 - a*b*g*y 4^ (2:ℕ) - 2*a*b*y 0*y 3 - 2*a*b*y 1*y 2 - 2*a*b*y 3*y 4 - b^ (2:ℕ)*g*y 4^ (2:ℕ) - 2*b^ (2:ℕ)*y 0*y 3 - 2*b^ (2:ℕ)*y 1*y 2 + b^ (2:ℕ)*y 1*y 4 - b^ (2:ℕ)*y 2*y 3 + 2*b^ (2:ℕ)*y 3*y 4

/-- `p_4` in AS Galois coordinates: the `k`-th twisted Pfaffian (w-free). -/
def kleinPAS4 (a b g : R) (y : Fin 5 → R) : R :=
  2*a^ (2:ℕ)*y 0*y 4 + 2*a^ (2:ℕ)*y 1*y 3 + a^ (2:ℕ)*y 2^ (2:ℕ) + 2*a^ (2:ℕ)*y 2*y 4 - 2*a^ (2:ℕ)*y 3^ (2:ℕ) + 2*a^ (2:ℕ)*y 4^ (2:ℕ) - 2*a*b*y 0*y 4 - 2*a*b*y 1*y 3 - a*b*y 2^ (2:ℕ) - a*b*y 4^ (2:ℕ) - 2*b^ (2:ℕ)*y 0*y 4 - 2*b^ (2:ℕ)*y 1*y 3 - b^ (2:ℕ)*y 2^ (2:ℕ) + 2*b^ (2:ℕ)*y 2*y 4 - 2*b^ (2:ℕ)*y 3^ (2:ℕ) - 2*b^ (2:ℕ)*y 4^ (2:ℕ)

/-- The five twisted Pfaffians `p^AS_0, …, p^AS_4`. -/
def kleinPAS (a b g : R) (y : Fin 5 → R) : Fin 5 → R :=
  ![kleinPAS0 a b g y, kleinPAS1 a b g y, kleinPAS2 a b g y, kleinPAS3 a b g y, kleinPAS4 a b g y]

/-- The twisted (S-invariant) quadric `q^AS = q(asM w · y)`. -/
def kleinQAS (a b : R) (y : Fin 5 → R) : R :=
