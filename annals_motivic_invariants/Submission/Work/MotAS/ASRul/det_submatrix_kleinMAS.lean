/-- **The determinant of the principal `4 × 4` minor of the AS Klein matrix** is minus the square
of the corresponding AS Pfaffian (characteristic `5`). -/
theorem det_submatrix_kleinMAS (K : Type) [Field K] [CharP K 5] (a b g : K) (y : Fin 5 → K)
    (k : Fin 5) :
    ((kleinMAS a b g y).submatrix k.succAbove k.succAbove).det
      = -(Work.MotAS.kleinPAS a b g y k) ^(2:ℕ) := by
  fin_cases k
  · exact det_submatrix_kleinMAS_0 K a b g y
  · exact det_submatrix_kleinMAS_1 K a b g y
  · exact det_submatrix_kleinMAS_2 K a b g y
  · exact det_submatrix_kleinMAS_3 K a b g y
  · exact det_submatrix_kleinMAS_4 K a b g y

end Work.MotAS.ASRul
