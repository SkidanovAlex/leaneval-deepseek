namespace Work.MotAS

open MvPolynomial

noncomputable section

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Multiplicativity of the degree-`n` homogeneous component against a polynomial `q` that is
homogeneous of degree `2`:

`homogeneousComponent n (a * q) = homogeneousComponent (n - 2) a * q` when `2 ≤ n`, and `0`
otherwise (in which case `n - 2` is the truncated subtraction, and the formula must not be used).

This is the `ℕ`-graded structure of `MvPolynomial` (via `DirectSum.coe_decompose_mul_of_right_mem`
applied to the degree grading) together with the identification of `decompose`'s components with
`homogeneousComponent`. -/
lemma homogeneousComponent_mul_of_mem_two {R : Type*} [CommSemiring R]
    (a q : MvPolynomial (Fin 5) R) (n : ℕ)
    (hq : q ∈ MvPolynomial.homogeneousSubmodule (Fin 5) R 2) :
    MvPolynomial.homogeneousComponent n (a * q)
      = if 2 ≤ n then MvPolynomial.homogeneousComponent (n - 2) a * q else 0 := by
  have h := DirectSum.coe_decompose_mul_of_right_mem (MvPolynomial.homogeneousSubmodule (Fin 5) R)
    (a := a) (b := q) (i := 2) (n := n) hq
  rw [show (↑((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin 5) R) (a * q)) n :
        MvPolynomial (Fin 5) R)) = MvPolynomial.homogeneousComponent n (a * q) from
      MvPolynomial.decomposition.decompose'_apply (a * q) n,
    show (↑((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin 5) R) a) (n - 2) :
        MvPolynomial (Fin 5) R)) = MvPolynomial.homogeneousComponent (n - 2) a from
      MvPolynomial.decomposition.decompose'_apply a (n - 2)] at h
  exact h

/-- **The degree-`n` part of an ideal generated by homogeneous quadrics.**

Let `p : Fin 5 → R[X₀,…,X₄]` be a family of quadratic forms and let `F` be homogeneous of degree
`n` lying in the ideal generated by the `p k`.  Then `F` is an `R`-linear combination of products
`p k · X^m` with `m` a monomial of degree `n - 2` (the degree-`n` part of the ideal is generated in
degree `n` by the quadrics).  -/
theorem mem_span_mul_monomial_of_mem_ideal_span {R : Type*} [Field R]
    (p : Fin 5 → MvPolynomial (Fin 5) R) (hp : ∀ k, (p k).IsHomogeneous 2)
    {n : ℕ} {F : MvPolynomial (Fin 5) R} (hF : F.IsHomogeneous n)
    (h : F ∈ Ideal.span (Set.range p)) :
    F ∈ Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2} =>
      p q.1 * MvPolynomial.monomial q.2.1 1)) := by
  set T : Submodule R (MvPolynomial (Fin 5) R) :=
    Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = n - 2} =>
      p q.1 * MvPolynomial.monomial q.2.1 1)) with hT
  suffices hcomp : MvPolynomial.homogeneousComponent n F ∈ T by
    rwa [MvPolynomial.homogeneousComponent_eq_self hF] at hcomp
  -- It suffices to show that for every element `x` of the ideal generated by the `p k` and every
  -- polynomial `c`, the degree-`n` component of `c * x` lies in `T`.  This predicate is closed
  -- under the operations generating `Submodule.span R (Set.range p)`.
  have key : ∀ c : MvPolynomial (Fin 5) R, MvPolynomial.homogeneousComponent n (c * F) ∈ T :=
    Submodule.span_induction (s := Set.range p)
      (p := fun x _ => ∀ c : MvPolynomial (Fin 5) R,
        MvPolynomial.homogeneousComponent n (c * x) ∈ T)
      -- generators: `x = p k`
      (fun x hx => by
        obtain ⟨k, rfl⟩ := hx
        intro c
        rw [homogeneousComponent_mul_of_mem_two c (p k) n (hp k)]
        split_ifs with h2
        · -- `2 ≤ n`: `homogeneousComponent (n-2) c` is a combination of degree-`(n-2)` monomials
          rw [MvPolynomial.homogeneousComponent_apply, Finset.sum_mul]
          refine Submodule.sum_mem T ?_
          intro d hd
          rw [Finset.mem_filter] at hd
          obtain ⟨hdmem, hddeg⟩ := hd
          have hmem : p k * MvPolynomial.monomial d 1 ∈ T :=
            Submodule.subset_span ⟨(k, ⟨d, hddeg⟩), rfl⟩
          have hmem' : MvPolynomial.monomial d 1 * p k ∈ T := by
            rw [mul_comm]; exact hmem
          rw [show MvPolynomial.monomial d (c.coeff d) = c.coeff d • MvPolynomial.monomial d 1 by
            simp [MvPolynomial.smul_monomial], smul_mul_assoc]
          exact Submodule.smul_mem T (c.coeff d) hmem'
        · -- `n < 2`: the component vanishes
          exact Submodule.zero_mem T)
      (fun c => by rw [mul_zero, map_zero]; exact Submodule.zero_mem T)
      (fun x y hx hy ihx ihy c => by
        rw [mul_add, map_add]
        exact Submodule.add_mem T (ihx c) (ihy c))
      (fun s x hx ih c => by
        rw [smul_eq_mul, ← mul_assoc]
        exact ih (c * s))
      h
  simpa using key 1

end

end Work.MotAS
