/-!
# `Work.MotAS.ASZElimData` — the explicit eliminant and graph coefficient of the AS residual chart

The ideal `ZIAS a b g = Ideal.span (Set.range (zcubAS a b g))` (the chart `(z₄ = 0, z₀ = 1)` of the
residual curve of the characteristic-`5` Crauder–Katz link) has an elimination ideal
`ZIAS a b g ∩ K[X₁,X₂] = (P)` generated by an irreducible quintic `P`, and contains an element
`D₀'(X₂)·X₀ + R'` whose `X₀`-coefficient `D₀'` is the degree-`5` polynomial `Dp` (in `X₂`) below.
These two polynomials are *fitted* (an earlier agent) and *verified* (this project) numerically over
`𝔽₅` and `𝔽₁₂₅`:

* `P ∈ ZIAS a b g` (Gröbner reduction) for all admissible `(a,b,g) ∈ 𝔽₅³` and random `𝔽₁₂₅` points;
* `Dp` agrees with the `X₀`-coefficient of the lex-Gröbner graph element of `ZIAS a b g`
  (the element with lead monomial `X₀·X₂⁵`), up to a scalar, over the same sample;
* `P` has `(a,b)`-degree `5`, `deg_g ≤ 3`, `(X₁,X₂)`-bidegree `(5,5)`, and `Dp` has
  `(a,b)`-degree `5`, `deg_g ≤ 5` and is a degree-`5` polynomial in `X₂`.

⚠ `Dp` degenerates (loses its `X₂⁵` term) where `a⁵g⁵ + 2a³b²g³ + a²b³g³ + 2b⁵g⁵ = 0`; the
hypothesis `g ∉ ℘(K)` forces `g ≠ 0` but does not by itself exclude that locus.  The certificate for
the general hypothesis set therefore has to be stated with a suitable *multiple* of `Dp`; see
`MOTAS_ASZ_PRESENTATION_STATE2.md` (workspace root) for the state of play.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.MotAS.ASZElim

open MvPolynomial

variable {K : Type*} [Field K]

/-- The eliminant `P ∈ K[X₀,X₁]` (the Fin 2 variables stand for `X₁` and `X₂` of the chart). -/
noncomputable def P (a b g : K) : MvPolynomial (Fin 2) K :=
  C (a^(5:ℕ)*g^(2:ℕ) + -1*a^(3:ℕ)*b^(2:ℕ) + 2*a^(2:ℕ)*b^(3:ℕ) + 2*b^(5:ℕ)*g^(2:ℕ)) * X 0^(5:ℕ)
  + C (2*a^(4:ℕ)*b + 2*a^(3:ℕ)*b^(2:ℕ) + -1*a^(2:ℕ)*b^(3:ℕ) + a*b^(4:ℕ)) * X 0^(4:ℕ)
  + C (a^(3:ℕ)*b^(2:ℕ) + 2*a^(2:ℕ)*b^(3:ℕ)) * X 0^(3:ℕ) * X 1^(2:ℕ)
  + C (-2*a^(5:ℕ)*g + b^(5:ℕ)*g) * X 0^(3:ℕ) * X 1
  + C (-1*a^(5:ℕ) + -1*a^(4:ℕ)*b + 2*a^(3:ℕ)*b^(2:ℕ) + a^(2:ℕ)*b^(3:ℕ) + -2*a*b^(4:ℕ) + 2*b^(5:ℕ)) * X 0^(3:ℕ)
  + C (a^(4:ℕ)*b*g + a^(3:ℕ)*b^(2:ℕ)*g + 2*a^(2:ℕ)*b^(3:ℕ)*g + -2*a*b^(4:ℕ)*g) * X 0^(2:ℕ) * X 1^(3:ℕ)
  + C (a^(4:ℕ)*b + 2*a^(3:ℕ)*b^(2:ℕ) + a^(2:ℕ)*b^(3:ℕ) + 2*a*b^(4:ℕ)) * X 0^(2:ℕ) * X 1^(2:ℕ)
  + C (2*a^(5:ℕ) + -1*b^(5:ℕ)) * X 0^(2:ℕ)
  + C (-1*a^(5:ℕ)*g^(2:ℕ) + -2*b^(5:ℕ)*g^(2:ℕ)) * X 0 * X 1^(4:ℕ)
  + C (-2*a^(5:ℕ)*g + -2*a^(4:ℕ)*b*g + -1*a^(3:ℕ)*b^(2:ℕ)*g + 2*a^(2:ℕ)*b^(3:ℕ)*g + a*b^(4:ℕ)*g + -1*b^(5:ℕ)*g) * X 0 * X 1^(3:ℕ)
  + C (-1*a^(5:ℕ) + -1*a^(4:ℕ)*b + -1*a^(3:ℕ)*b^(2:ℕ) + -2*a^(2:ℕ)*b^(3:ℕ) + 2*a*b^(4:ℕ) + -2*b^(5:ℕ)) * X 0 * X 1^(2:ℕ)
  + C (2*a^(5:ℕ)*g^(3:ℕ) + -1*b^(5:ℕ)*g^(3:ℕ)) * X 1^(5:ℕ)
  + C (-1*a^(5:ℕ)*g + -2*b^(5:ℕ)*g) * X 1^(3:ℕ)
  + C (a^(5:ℕ) + a^(4:ℕ)*b + -2*a^(3:ℕ)*b^(2:ℕ) + -1*a^(2:ℕ)*b^(3:ℕ) + 2*a*b^(4:ℕ) + -2*b^(5:ℕ)) * X 1^(2:ℕ)
  + C (-1*a^(5:ℕ) + -2*b^(5:ℕ))

/-- The `X₀`-coefficient `Dp ∈ K[X₀,X₁]` of the lex-Gröbner graph element of `ZIAS a b g`
(only the second variable `X₁` of `K[X₀,X₁]`, i.e. `X₂` of the chart, occurs). -/
noncomputable def Dp (a b g : K) : MvPolynomial (Fin 2) K :=
  C (a^(5:ℕ)*g^(5:ℕ) + 2*a^(3:ℕ)*b^(2:ℕ)*g^(3:ℕ) + a^(2:ℕ)*b^(3:ℕ)*g^(3:ℕ) + 2*b^(5:ℕ)*g^(5:ℕ)) * X 1^(5:ℕ)
  + C (3*a^(3:ℕ)*b^(2:ℕ)*g^(2:ℕ) + a^(2:ℕ)*b^(3:ℕ)*g^(2:ℕ)) * X 1^(4:ℕ)
  + C (3*a^(5:ℕ)*g^(3:ℕ) + b^(5:ℕ)*g^(3:ℕ)) * X 1^(3:ℕ)
  + C (4*a^(3:ℕ)*b^(2:ℕ) + 3*a^(2:ℕ)*b^(3:ℕ)) * X 1^(2:ℕ)
  + C (a^(5:ℕ)*g + a^(4:ℕ)*b*g + a^(3:ℕ)*b^(2:ℕ)*g + 2*a^(2:ℕ)*b^(3:ℕ)*g + 3*a*b^(4:ℕ)*g + 2*b^(5:ℕ)*g) * X 1
  + C (a^(5:ℕ)*g^(2:ℕ) + 2*b^(5:ℕ)*g^(2:ℕ))

end Work.MotAS.ASZElim
