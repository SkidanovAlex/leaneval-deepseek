/-!
# `Work.MotAS.ASRulV3.rangeClosureAS`

The range closure of the AS ruling presentation

  `θ = ASrulTheta a b g hDZ : K[X₀,X₁,X₂] →ₐ[K] S`,  `S = A[T][1/ε]`,  `A = K[X₀,X₁,X₂] ⧸ √(ZIAS a b g)`,

of the source ruling surface of the characteristic-`5` Crauder–Katz link: the fraction field of
`θ.range` is the fraction field of `A[T]`.

## Route

`Work.MotAS.Nodes.ASrulTheta_chart` (PROVED) is the chart identity
`θ (fwVecAS2 · 0) · toS (C (mk (X i))) = θ (fwVecAS2 · (i+1))` in `S`, so with
`θ (fwVecAS2 · 0) ≠ 0` the base-point coordinates `mk (X i)` lie in the subfield generated by
`θ.range`.  The ruling parameter `Polynomial.X` is recovered from `kbRw 3 = 0` and
`kbRw 4 = (a+2b)·kbRv 3`: `toS X = (a+2b)·θ (X 2)` up to the unit `C (mk (kbRv 3))`.  Since
`A[T]` is generated as a `K`-algebra by `C` and `X`, the closure is everything; `FractionRing S`
is `FractionRing (Polynomial A)` because `C ε` is a non-zero-divisor (`ε ≠ 0`).

The proof below is the AS analogue of `Work.MotK.TGen.ThetaRangeClosure`; it is the (native)
transcription of `Work.MotAS.Nodes.ASRulingRangeClosure`, which states the same result for the
verbatim copy `Work.MotAS.Nodes.Shim.*` of the ruling presentation.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

namespace Work.MotAS.ASRulV3

open MvPolynomial

/-! ## §1  Generic fraction-field lemmas (copies of the `private` lemmas of
`Submission/Work/MotK/TGen/CubTFracRange.lean`) -/

theorem isFractionRing_of_subfield_closure_range' {K L : Type*} [Field K] [Field L] [Algebra K L]
    (R : Subalgebra K L) (h : Subfield.closure (Set.range (algebraMap R L)) = ⊤) :
    IsFractionRing R L := by
  refine IsFractionRing.of_field R L fun z => ?_
  have hz : z ∈ Subfield.closure (Set.range (algebraMap R L)) := by
    rw [h]; exact Subfield.mem_top z
  rw [Subfield.mem_closure_iff] at hz
  obtain ⟨y, hy, w, hw, hyw⟩ := hz
  have hclos : Subring.closure (Set.range (algebraMap R L)) = R.toSubring := by
    refine le_antisymm ?_ ?_
    · rw [Subring.closure_le]
      rintro x ⟨r, rfl⟩
      exact Subalgebra.mem_toSubring.mpr r.2
    · intro x hx
      exact Subring.subset_closure ⟨⟨x, Subalgebra.mem_toSubring.mp hx⟩, rfl⟩
  have hyR : y ∈ R := Subalgebra.mem_toSubring.mp (by rw [← hclos]; exact hy)
  have hwR : w ∈ R := Subalgebra.mem_toSubring.mp (by rw [← hclos]; exact hw)
  exact ⟨⟨y, hyR⟩, ⟨w, hwR⟩, by simpa using hyw.symm⟩

theorem fractionRing_algEquiv_of_closure_eq_top' {K L : Type*} [Field K] [Field L] [Algebra K L]
    (S : Subalgebra K L) (h : Subfield.closure (Set.range (algebraMap S L)) = ⊤) :
    Nonempty (FractionRing S ≃ₐ[K] L) := by
  haveI : IsFractionRing S L := isFractionRing_of_subfield_closure_range' S h
  exact ⟨AlgEquiv.restrictScalars K (IsLocalization.algEquiv (nonZeroDivisors S) (FractionRing S) L)⟩

/-- Localising at a non-zero element does not change the fraction field. -/
theorem fractionRing_localizationAway_algEquiv (K : Type) [Field K] (A : Type) [CommRing A]
    [IsDomain A] [Algebra K A] (f : A) (hf : f ≠ 0) :
    Nonempty (FractionRing (Localization.Away f) ≃ₐ[K] FractionRing A) := by
  have hle : Submonoid.powers f ≤ nonZeroDivisors A :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hf)
  letI : Algebra (Localization.Away f) (FractionRing A) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe (Localization.Away f) (FractionRing A)
      (Submonoid.powers f) (nonZeroDivisors A) hle
  haveI : IsScalarTower A (Localization.Away f) (FractionRing A) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le (Localization.Away f)
      (FractionRing A) (Submonoid.powers f) (nonZeroDivisors A) hle
  haveI : IsScalarTower K (Localization.Away f) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => by
      rw [IsScalarTower.algebraMap_apply K A (FractionRing A),
          IsScalarTower.algebraMap_apply K A (Localization.Away f),
          IsScalarTower.algebraMap_apply A (Localization.Away f) (FractionRing A)]
  haveI : IsFractionRing (Localization.Away f) (FractionRing A) :=
    IsFractionRing.isFractionRing_of_isLocalization (Submonoid.powers f) (Localization.Away f)
      (FractionRing A) hle
  exact ⟨AlgEquiv.restrictScalars K (IsLocalization.algEquiv (nonZeroDivisors (Localization.Away f))
    (FractionRing (Localization.Away f)) (FractionRing A))⟩

/-! ## §2  `toS` bookkeeping -/

/-- `toS` on the constants: the structure map `Polynomial A →+* S` is `algebraMap` on `A`. -/
theorem rc_toS_C (K : Type) [Field K] [CharP K 5] (a b g : K)
    (x : Work.MotC5N3.ASrulA a b g) :
    Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C x)
      = algebraMap (Work.MotC5N3.ASrulA a b g)
          (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) x := by
  letI : Semiring (Work.MotC5N3.ASrulA a b g) :=
    (inferInstance : CommSemiring (Work.MotC5N3.ASrulA a b g)).toSemiring
  letI : CommSemiring (Work.MotC5N3.ASrulA a b g) := inferInstance
  letI : CommRing (Work.MotC5N3.ASrulA a b g) := inferInstance
  letI : Algebra (Polynomial (Work.MotC5N3.ASrulA a b g))
      (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) :=
    OreLocalization.instAlgebra
  show algebraMap (Polynomial (Work.MotC5N3.ASrulA a b g))
      (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) (Polynomial.C x)
    = algebraMap (Work.MotC5N3.ASrulA a b g)
      (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) x
  exact (congrArg (algebraMap (Polynomial (Work.MotC5N3.ASrulA a b g))
      (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))))
      (Polynomial.C_eq_algebraMap x)).trans
    (IsScalarTower.algebraMap_apply (Work.MotC5N3.ASrulA a b g)
      (Polynomial (Work.MotC5N3.ASrulA a b g))
      (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) x).symm

/-- The normalising coefficient satisfies `kbRw 4 = C (a + 2b) · kbRv 3` in `K[X₀,X₁,X₂]`. -/
theorem rc_kbRw_four_eq (K : Type) [Field K] (a b g : K) :
    Work.MotAS.ASRul.kbRw a b g 4
      = MvPolynomial.C (a + 2 * b) * Work.MotAS.ASRul.kbRv a b g 3 := by
  simp only [Work.MotAS.ASRul.kbRw, Work.MotAS.ASRul.kbRv, Matrix.cons_val_three,
    Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons]
  refl_ring1

/-! ## §3  The range closure, given the chart identity -/

theorem rangeClosureNat (K : Type) [Field K] [CharP K 5] (a b g : K)
    (hDZ : IsDomain (Work.MotC5N3.ASrulA a b g))
    (hε : Work.MotC5N3.ASrulEpsA a b g ≠ 0)
    (hθ0 : Work.MotC5N3.ASrulTheta a b g hDZ (Work.MotAS.fwVecAS2 a b g 0) ≠ 0)
    (hchart : ∀ i : Fin 3, Work.MotC5N3.ASrulTheta a b g hDZ
        (Work.MotAS.fwVecAS2 a b g 0)
      * Work.MotAS.Nodes.ASGen.toS a b g
          (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
            (MvPolynomial.X i)))
      = Work.MotC5N3.ASrulTheta a b g hDZ
          (Work.MotAS.fwVecAS2 a b g (Work.MotAS.asCh3 i))) :
    Nonempty (FractionRing (Work.MotC5N3.ASrulTheta a b g hDZ).range ≃ₐ[K]
      FractionRing (Polynomial (Work.MotC5N3.ASrulA a b g))) := by
  -- The quotient-ring `Semiring` diamond: pin the instances so that `algebraMap` elaborates.
  letI : Semiring (Work.MotC5N3.ASrulA a b g) :=
    (inferInstance : CommSemiring (Work.MotC5N3.ASrulA a b g)).toSemiring
  letI : CommSemiring (Work.MotC5N3.ASrulA a b g) := inferInstance
  letI : CommRing (Work.MotC5N3.ASrulA a b g) := inferInstance
  letI : Algebra (Polynomial (Work.MotC5N3.ASrulA a b g))
      (Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) :=
    OreLocalization.instAlgebra
  haveI : IsDomain (Work.MotC5N3.ASrulA a b g) := hDZ
  let A : Type := Work.MotC5N3.ASrulA a b g
  let R : Type := Polynomial A
  let S : Type := Localization.Away (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))
  let L : Type := FractionRing S
  let θ : MvPolynomial (Fin 3) K →ₐ[K] S := Work.MotC5N3.ASrulTheta a b g hDZ
  let f : S →ₐ[K] L := IsScalarTower.toAlgHom K S L
  let T : Subalgebra K S := θ.range
  let T' : Subalgebra K L := T.map f
  -- `toL` is the structure map `R →+* S`.
  have htoL : ∀ r : R, Work.MotAS.Nodes.ASGen.toS a b g r = algebraMap R S r := fun r => rfl
  -- `f` is the structure map `S →+* L`.
  have hf_eq : ∀ x : S, f x = algebraMap S L x := fun x => rfl
  -- ## Step 1: `ε = (a+2b) · mk (kbRv 3)`, hence the two non-vanishing facts.
  have hfac : Work.MotC5N3.ASrulEpsA a b g
      = algebraMap K A (a + 2 * b)
        * Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
            (Work.MotAS.ASRul.kbRv a b g 3) := by
    show Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
        (Work.MotAS.ASRul.kbRw a b g 4) = _
    rw [rc_kbRw_four_eq, map_mul, MvPolynomial.C_eq_algebraMap,
      Ideal.Quotient.mk_algebraMap]
  have ha2b : a + 2 * b ≠ 0 := by
    intro h0
    exact hε (by rw [hfac, h0, map_zero, zero_mul])
  have h3 : Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
      (Work.MotAS.ASRul.kbRv a b g 3) ≠ 0 := by
    intro h0
    exact hε (by rw [hfac, h0, mul_zero])
  -- ## Step 2: the tower facts
  have hCε0 : Polynomial.C (Work.MotC5N3.ASrulEpsA a b g) ≠ 0 :=
    fun h0 => hε (Polynomial.C_eq_zero.mp h0)
  have hle : Submonoid.powers (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))
      ≤ nonZeroDivisors R :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hCε0)
  haveI hSD : IsDomain S := IsLocalization.isDomain_of_le_nonZeroDivisors S hle
  have hinjRS : Function.Injective (algebraMap R S) := IsLocalization.injective S hle
  have hf_inj : Function.Injective f := by
    intro x y hxy
    rw [hf_eq x, hf_eq y] at hxy
    exact IsFractionRing.injective S L hxy
  -- ## Step 3: `C ε = (a+2b) · C (mk (kbRv 3))` in `S`
  have hCεeq : Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))
      = algebraMap K S (a + 2 * b)
        * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
            (Work.MotAS.ASRul.kbRv a b g 3))) := by
    have h1 : Polynomial.C (Work.MotC5N3.ASrulEpsA a b g)
        = Polynomial.C (algebraMap K A (a + 2 * b))
          * Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
              (Work.MotAS.ASRul.kbRv a b g 3)) := by
      rw [hfac, map_mul]
    have h2 := congrArg (fun z : R => Work.MotAS.Nodes.ASGen.toS a b g z) h1
    rw [h2, map_mul, rc_toS_C, rc_toS_C,
      ← IsScalarTower.algebraMap_apply K A S (a + 2 * b)]
  have hA0ne : Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
      (Work.MotAS.ASRul.kbRv a b g 3))) ≠ 0 := by
    rw [htoL]
    intro h0
    exact h3 (Polynomial.C_eq_zero.mp (hinjRS (by rw [h0, map_zero])))
  -- ## Step 4: the defining relation at `X 2`
  have hXmul : θ (MvPolynomial.X 2)
      * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))
      = Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
            (Work.MotAS.ASRul.kbRv a b g 3)) * Polynomial.X) := by
    have hth : θ (MvPolynomial.X 2)
        = IsLocalization.mk' S
            (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
                (Work.MotAS.ASRul.kbRv a b g 3)) * Polynomial.X)
            ⟨Polynomial.C (Work.MotC5N3.ASrulEpsA a b g), Submonoid.mem_powers _⟩ := by
      have h23 : Work.MotAS.asCh3 (2 : Fin 3) = (3 : Fin 5) := rfl
      have hkb : Work.MotAS.ASRul.kbRw a b g 3 = 0 := by
        simp [Work.MotAS.ASRul.kbRw]
      simp only [θ, Work.MotC5N3.ASrulTheta, MvPolynomial.aeval_X, h23, hkb,
        map_zero, Polynomial.C_0, add_zero]
      try rfl
    rw [hth]
    have hspec := IsLocalization.mk'_spec (S := S)
      (M := Submonoid.powers (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g)))
      (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
          (Work.MotAS.ASRul.kbRv a b g 3)) * Polynomial.X)
      ⟨Polynomial.C (Work.MotC5N3.ASrulEpsA a b g), Submonoid.mem_powers _⟩
    rw [htoL (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g)),
      htoL (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
          (Work.MotAS.ASRul.kbRv a b g 3)) * Polynomial.X)]
    exact hspec
  -- ## Step 5: `toL X = (a+2b) · θ (X 2)`
  have hXrel : Work.MotAS.Nodes.ASGen.toS a b g Polynomial.X
      = algebraMap K S (a + 2 * b) * θ (MvPolynomial.X 2) := by
    have hXmul' : θ (MvPolynomial.X 2)
        * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))
        = Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
              (Work.MotAS.ASRul.kbRv a b g 3))) * Work.MotAS.Nodes.ASGen.toS a b g Polynomial.X := by
      rw [hXmul, map_mul]
    rw [hCεeq] at hXmul'
    have h1 : (algebraMap K S (a + 2 * b) * θ (MvPolynomial.X 2))
          * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
              (Work.MotAS.ASRul.kbRv a b g 3)))
        = Work.MotAS.Nodes.ASGen.toS a b g Polynomial.X
          * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
              (Work.MotAS.ASRul.kbRv a b g 3))) := by
      calc (algebraMap K S (a + 2 * b) * θ (MvPolynomial.X 2))
            * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk
                (Ideal.radical (Work.MotAS.ZIAS a b g)) (Work.MotAS.ASRul.kbRv a b g 3)))
          = θ (MvPolynomial.X 2) * (algebraMap K S (a + 2 * b)
              * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk
                  (Ideal.radical (Work.MotAS.ZIAS a b g)) (Work.MotAS.ASRul.kbRv a b g 3)))) := by
            refl_ring1
        _ = Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk
              (Ideal.radical (Work.MotAS.ZIAS a b g)) (Work.MotAS.ASRul.kbRv a b g 3)))
              * Work.MotAS.Nodes.ASGen.toS a b g Polynomial.X := hXmul'
        _ = Work.MotAS.Nodes.ASGen.toS a b g Polynomial.X * Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk
              (Ideal.radical (Work.MotAS.ZIAS a b g)) (Work.MotAS.ASRul.kbRv a b g 3))) := by
            refl_ring1
    exact (mul_right_cancel₀ hA0ne h1).symm
  -- ## Step 6: the closure in `L`
  have hgen : Subfield.closure (Set.range (algebraMap T' L)) = ⊤ := by
    letI : CommSemiring ↥T' := inferInstance
    letI : Semiring ↥T' := (inferInstance : CommSemiring ↥T').toSemiring
    set U : Subfield L := Subfield.closure (Set.range (algebraMap T' L)) with hU
    have memU : ∀ y : T', algebraMap T' L y ∈ U := by
      intro y
      rw [hU]
      exact Subfield.subset_closure ⟨y, rfl⟩
    have halg : ∀ y : T', algebraMap T' L y = (y : L) := by
      intro y
      rw [Subalgebra.algebraMap_eq]
      rfl
    have memT : ∀ x : T, f (x : S) ∈ U := by
      intro x
      have h1 : f (x : S) ∈ T' := Subalgebra.mem_map.mpr ⟨(x : S), x.2, rfl⟩
      have h2 := memU ⟨f (x : S), h1⟩
      have h3 : algebraMap T' L ⟨f (x : S), h1⟩ = f (x : S) := by
        rw [halg]
      rwa [h3] at h2
    have hKmem : ∀ k : K, f (algebraMap K S k) ∈ U := by
      intro k
      have h1 : θ (MvPolynomial.C k) = algebraMap K S k := by
        rw [MvPolynomial.C_eq_algebraMap]
        exact AlgHom.commutes θ k
      rw [← h1]
      exact memT ⟨_, ⟨MvPolynomial.C k, rfl⟩⟩
    have hCimem : ∀ i : Fin 3, f (Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C
        (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g)) (MvPolynomial.X i)))) ∈ U := by
      intro i
      have h2 : f (θ (Work.MotAS.fwVecAS2 a b g 0))
          * f (Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk
              (Ideal.radical (Work.MotAS.ZIAS a b g)) (MvPolynomial.X i))))
          = f (θ (Work.MotAS.fwVecAS2 a b g (Work.MotAS.asCh3 i))) := by
        rw [← map_mul, hchart i]
      have hne : f (θ (Work.MotAS.fwVecAS2 a b g 0)) ≠ 0 := by
        intro h0
        exact hθ0 (hf_inj (by simpa using h0))
      have h3 : f (Work.MotAS.Nodes.ASGen.toS a b g (Polynomial.C (Ideal.Quotient.mk
              (Ideal.radical (Work.MotAS.ZIAS a b g)) (MvPolynomial.X i))))
          = f (θ (Work.MotAS.fwVecAS2 a b g (Work.MotAS.asCh3 i)))
            * (f (θ (Work.MotAS.fwVecAS2 a b g 0)))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ hne, mul_comm]
        exact h2
      rw [h3]
      exact U.mul_mem (memT ⟨_, ⟨Work.MotAS.fwVecAS2 a b g (Work.MotAS.asCh3 i), rfl⟩⟩)
        (U.inv_mem (memT ⟨_, ⟨Work.MotAS.fwVecAS2 a b g 0, rfl⟩⟩))
    have hXmem : f (Work.MotAS.Nodes.ASGen.toS a b g Polynomial.X) ∈ U := by
      rw [hXrel, map_mul]
      exact U.mul_mem (hKmem (a + 2 * b)) (memT ⟨_, ⟨MvPolynomial.X 2, rfl⟩⟩)
    have hmemA : ∀ x : A, f (algebraMap A S x) ∈ U := by
      intro x
      obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective (I := Ideal.radical (Work.MotAS.ZIAS a b g)) x
      refine MvPolynomial.induction_on q (motive := fun q => f (algebraMap A S
        (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g)) q)) ∈ U) ?_ ?_ ?_
      · intro k
        have h1 : Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g)) (MvPolynomial.C k)
            = algebraMap K A k := by
          rw [MvPolynomial.C_eq_algebraMap, Ideal.Quotient.mk_algebraMap]
        rw [h1, ← IsScalarTower.algebraMap_apply K A S k]
        exact hKmem k
      · intro p q hp hq
        rw [map_add, map_add, map_add]
        exact U.add_mem hp hq
      · intro p n hp
        rw [map_mul, map_mul, map_mul]
        refine U.mul_mem hp ?_
        rw [← rc_toS_C]
        exact hCimem n
    have hmemR : ∀ r : R, f (Work.MotAS.Nodes.ASGen.toS a b g r) ∈ U := by
      intro r
      refine Polynomial.induction_on r (motive := fun r => f (Work.MotAS.Nodes.ASGen.toS a b g r) ∈ U) ?_ ?_ ?_
      · intro x
        rw [rc_toS_C]
        exact hmemA x
      · intro p q hp hq
        rw [map_add, map_add]
        exact U.add_mem hp hq
      · intro n x hx
        rw [pow_succ, ← mul_assoc, map_mul, map_mul]
        exact U.mul_mem hx hXmem
    have hmemS : ∀ x : S, f x ∈ U := by
      intro x
      obtain ⟨w, hw⟩ := IsLocalization.surj
        (Submonoid.powers (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g))) x
      have hwne : algebraMap R S (w.2 : R) ≠ 0 := by
        intro h0
        exact (mem_nonZeroDivisors_iff_ne_zero.mp (hle w.2.2)) (hinjRS (by rw [h0, map_zero]))
      have hw' : f x * f (algebraMap R S (w.2 : R)) = f (algebraMap R S w.1) := by
        rw [← map_mul, hw]
      have hwne' : f (algebraMap R S (w.2 : R)) ≠ 0 := by
        intro h0
        exact hwne (hf_inj (by simpa using h0))
      have hx : f x = f (algebraMap R S w.1) * (f (algebraMap R S (w.2 : R)))⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ hwne']
        exact hw'
      rw [hx, ← htoL w.1, ← htoL (w.2 : R)]
      exact U.mul_mem (hmemR w.1) (U.inv_mem (hmemR (w.2 : R)))
    have htop : U = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨w, hw⟩ := IsLocalization.surj (nonZeroDivisors S) z
      have hwne : algebraMap S L (w.2 : S) ≠ 0 := by
        intro h0
        refine (mem_nonZeroDivisors_iff_ne_zero.mp w.2.2) ?_
        exact IsFractionRing.injective S L (by rw [h0, map_zero])
      have hz : z = algebraMap S L w.1 * (algebraMap S L (w.2 : S))⁻¹ := by
        rw [← hw, mul_assoc, mul_inv_cancel₀ hwne, mul_one]
      rw [hz, ← hf_eq w.1, ← hf_eq (w.2 : S)]
      exact U.mul_mem (hmemS w.1) (U.inv_mem (hmemS (w.2 : S)))
    exact htop
  haveI hFR : IsFractionRing ↥T' L := isFractionRing_of_subfield_closure_range' T' hgen
  -- ## Step 7: `T ≃ₐ[K] T'`
  let φ : T →ₐ[K] T' := AlgHom.codRestrict (f.comp (Subalgebra.val T)) T'
    (fun x => Subalgebra.mem_map.mpr ⟨(x : S), x.2, rfl⟩)
  have hφinj : Function.Injective φ := by
    intro x y hxy
    refine Subtype.ext (IsFractionRing.injective S L ?_)
    exact congrArg (fun z : T' => (z : L)) hxy
  have hφsurj : Function.Surjective φ := by
    intro y
    obtain ⟨x, hx, hxy⟩ := Subalgebra.mem_map.mp y.2
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  have e : T ≃ₐ[K] T' := AlgEquiv.ofBijective φ ⟨hφinj, hφsurj⟩
  -- ## Step 8: assemble
  have e1 : FractionRing ↥T ≃ₐ[K] L := IsFractionRing.algEquivOfAlgEquiv (R := K) (A := ↥T) (B := ↥T')
    (K := FractionRing ↥T) (L := L) e
  have e2 : L ≃ₐ[K] FractionRing R := (fractionRing_localizationAway_algEquiv K R
    (Polynomial.C (Work.MotC5N3.ASrulEpsA a b g)) hCε0).some
  exact ⟨e1.trans e2⟩

/-! ## §4  The target -/

theorem rangeClosureAS (K : Type) [Field K] [CharP K 5] (a b g : K)
    (hDZ : IsDomain (Work.MotC5N3.ASrulA a b g)) (hε : Work.MotC5N3.ASrulEpsA a b g ≠ 0)
    (ha : a ≠ 0) (hb : b ≠ 0) (h2ab : b ≠ 2 * a) (hg : g ≠ 0)
    (h0 : Work.MotC5N3.ASrulTheta a b g hDZ (Work.MotAS.fwVecAS2 a b g 0) ≠ 0) :
    Nonempty (FractionRing (Work.MotC5N3.ASrulTheta a b g hDZ).range ≃ₐ[K]
      FractionRing (Polynomial (Work.MotC5N3.ASrulA a b g))) := by
  have hchart : ∀ i : Fin 3,
      Work.MotC5N3.ASrulTheta a b g hDZ (Work.MotAS.fwVecAS2 a b g 0)
        * Work.MotAS.Nodes.ASGen.toS a b g
            (Polynomial.C (Ideal.Quotient.mk (Ideal.radical (Work.MotAS.ZIAS a b g))
              (MvPolynomial.X i)))
        = Work.MotC5N3.ASrulTheta a b g hDZ
            (Work.MotAS.fwVecAS2 a b g (Work.MotAS.asCh3 i)) :=
    fun i => Work.MotAS.Nodes.ASrulTheta_chart K a b g hDZ i
  exact rangeClosureNat K a b g hDZ hε h0 hchart

end Work.MotAS.ASRulV3
