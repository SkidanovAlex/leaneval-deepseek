set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

/-!
# Degree-6 vocabulary for the kernel computation (`Work.MotAS.Ker6`)

The degree-6 analogue of `Submission/Work/MotAS/Ker4/Defs.lean`.  The target
`Work.MotAS.asKernel6` needs the dimension count

* the image of the AS evaluation `F ↦ F(asTwY D g)` on `Hom₆` contains the span of the sixfold
  products of `asTwY D g`, which contains the span of the sixfold products of the basis
  `sdBas = ![1,x,y,x²,xy]` (dimension `30`), so the kernel has dimension at most `dim Hom₆ - 30`;
* the degree-6 part `asIdeal6` of the AS Pfaffian ideal is contained in the kernel, and has
  dimension at least `dim Hom₆ - 30`.

This file provides the object of the second half on the split side: the degree-6 part of the
*plain* Klein Pfaffian ideal, `kleinIdeal6`, whose dimension bound is transported to `asIdeal6`
along the Galois-coordinate substitution (as in degree `4`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedTactic false

namespace Work.MotAS.Ker6

open MvPolynomial

/-- The degree-6 graded piece of `MvPolynomial (Fin 5) R`. -/
abbrev hom6 (R : Type) [Field R] : Submodule R (MvPolynomial (Fin 5) R) :=
  MvPolynomial.homogeneousSubmodule (Fin 5) R 6

/-- The degree-6 part of the ideal generated by the five (plain) Klein Pfaffians: the `R`-span of
the products `kleinP a b X k · m` with `m` a monomial of degree `4`. -/
noncomputable def kleinIdeal6 (R : Type) [Field R] (a b : R) :
    Submodule R (MvPolynomial (Fin 5) R) :=
  Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 4} =>
    Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b) (fun i => MvPolynomial.X i) q.1 *
      MvPolynomial.monomial q.2.1 1))

theorem kleinIdeal6_def (R : Type) [Field R] (a b : R) :
    kleinIdeal6 R a b =
      Submodule.span R (Set.range (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 4} =>
        Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b)
          (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1)) := rfl

/-- The T-twisted Pfaffians at `h = C 1` are the plain ones (the extra `h`-factors in
`kleinTwP` are all `h¹`, hence become `1`). -/
theorem kleinTwP_C_one {R : Type} [CommRing R] (a b : R)
    (y : Fin 5 → MvPolynomial (Fin 5) R) :
    Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b)
        (MvPolynomial.C (1 : R)) y
      = Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b) y := by
  funext k
  fin_cases k <;>
    simp only [Work.MotK.kleinTwP, Work.MotK.kleinTwP0, Work.MotK.kleinTwP1,
      Work.MotK.kleinTwP2, Work.MotK.kleinTwP3, Work.MotK.kleinTwP4, Work.MotK.kleinP,
      Work.MotK.kleinP0, Work.MotK.kleinP1, Work.MotK.kleinP2, Work.MotK.kleinP3,
      Work.MotK.kleinP4, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.tail_cons,
      map_one, mul_one, one_mul] <;>
    first | refl_ring1 | ring

/-- The degree-6 part of the *plain* Klein Pfaffian ideal is the degree-6 part of the twisted
ideal at `h = 1`. -/
theorem kleinIdeal6_eq_twIdeal6 (R : Type) [Field R] (a b : R) :
    kleinIdeal6 R a b = Work.MotK.TwRuling.twIdeal6 R a b 1 := by
  rw [kleinIdeal6, Work.MotK.TwRuling.twIdeal6]
  have hgen : (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 4} =>
        Work.MotK.kleinTwP (MvPolynomial.C a) (MvPolynomial.C b) (MvPolynomial.C (1 : R))
          (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1)
      = (fun q : Fin 5 × {m : Fin 5 →₀ ℕ // m.support.sum m = 4} =>
        Work.MotK.kleinP (MvPolynomial.C a) (MvPolynomial.C b)
          (fun i => MvPolynomial.X i) q.1 * MvPolynomial.monomial q.2.1 1) := by
    funext q
    rw [kleinTwP_C_one]
  rw [hgen]

end Work.MotAS.Ker6
