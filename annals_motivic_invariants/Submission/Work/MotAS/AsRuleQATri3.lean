  simp only [asBex0, asBex1, asBex1, asTriQ3, asTriR3, asTriQ3_c0, asTriQ3_c1, asTriQ3_c2, asTriQ3_c3, asTriQ3_c4, asTriQ3_c5, asTriQ3_c6, asTriR3_c0, asTriR3_c1, asTriR3_c2, asTriR3_c3, asTriR3_c4, asAex0_c0, asAex0_c1, asAex0_c2, asAex0_c3, asAex0_c5, asAex1_c0, asAex1_c1, asAex1_c2, asAex1_c3, asAex1_c4, asAex1_c5, asAex1_c6,
