/-- `kleinSecDual` collected along the indexed coefficient/monomial data. -/
theorem collectF (a b : R) (x : Fin 5 → R) :
    Work.MotK.kleinSecDual a b x = ∑ i : Fin 26, coefF a b i * monF i x := by
  rw [sdColl]
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, coefF, monF, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.cons_val_succ, Matrix.cons_val', Matrix.head_cons, Matrix.tail_cons]
  norm_num
  refl_ring1

/-- `kleinSecDualAS` collected along the indexed z-monomial data. -/
theorem AScollectF (a b g : R) (z : Fin 5 → R) :
    Work.MotAS.kleinSecDualAS a b g z = ∑ j : Fin 126, zmon j z * RmF a b g j := by
  rw [sdCollAS]
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, zmon, RmF, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.cons_val_succ, Matrix.cons_val', Matrix.head_cons, Matrix.tail_cons]
  norm_num
  refl_ring1

