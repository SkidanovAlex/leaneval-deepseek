/-- the double-sum swap. -/
theorem swap_sum {ι κ : Type*} [Fintype ι] [Fintype κ] (c : ι → R) (f : κ → R)
    (W : ι → κ → R) :
    (∑ i, c i * ∑ j, f j * W i j) = ∑ j, f j * ∑ i, c i * W i j := by
  calc (∑ i, c i * ∑ j, f j * W i j)
      = ∑ i, ∑ j, c i * (f j * W i j) := by
          simp only [Finset.mul_sum]
    _ = ∑ i, ∑ j, f j * (c i * W i j) := by
          apply Finset.sum_congr rfl; intro i _
          apply Finset.sum_congr rfl; intro j _
          refl_ring1
    _ = ∑ j, ∑ i, f j * (c i * W i j) := Finset.sum_comm
    _ = ∑ j, f j * ∑ i, c i * W i j := by
          simp only [Finset.mul_sum]

/-- **the Artin--Schreier transport of the dual secant quintic** -/
theorem AsTransportSDKey {R : Type*} [CommRing R] (a b g w : R) (h5 : (5 : R) = 0)
    (hw : w ^(5:ℕ) = w + g) (z : Fin 5 → R) :
    Work.MotK.kleinSecDual a b (fun k => ∑ j, Work.MotAS.asN w k j * z j)
      = Work.MotAS.kleinSecDualAS a b g z := by
  have hXf : (fun k : Fin 5 => ∑ j, Work.MotAS.asN w k j * z j) = fun k => Xk w z k := by
    funext k
    fin_cases k <;>
    · simp only [Fin.sum_univ_five, Work.MotAS.asN, Matrix.of_apply, Xk, Xv, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.head_cons, Matrix.tail_cons, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.reduceFinMk]
      norm_num
      refl_ring1
  rw [hXf, collectF, AScollectF]
  simp only [sdmonF_all]
  rw [swap_sum (coefF a b) (fun j => zmon j z) (fun i j => RowF i j w)]
  apply Finset.sum_congr rfl; intro j _
  rw [keyF_all a b g w h5 hw j]

end Work.MotAS.SDF2

