open _root_.AlgebraicGeometry.Scheme.PartialMap
open _root_.MotivicInvariants
open _root_.MotivicInvariants.PseudoRegularization
open _root_.MotivicInvariants.Variety
set_option autoImplicit false

universe u

noncomputable section

section Mathlib

namespace AlgebraicGeometry.Scheme

open CategoryTheory


attribute [instance] BirationalMap.isDominant_hom BirationalMap.isDominant_inv

attribute [simp, grind =] BirationalMap.hom_comp_inv_id BirationalMap.inv_comp_hom_id

namespace BirationalMap

variable {X Y Z : Scheme.{u}} [IrreducibleSpace X] [IrreducibleSpace Y] [IrreducibleSpace Z]















end BirationalMap

variable {X Y : Scheme.{u}}









variable [IrreducibleSpace X] [IrreducibleSpace Y]


instance (S : Scheme.{u}) [X.Over S] (f : birationalAutOver X S) :
    (f : X.BirationalMap X).IsOver S := f.2


end AlgebraicGeometry.Scheme

end Mathlib

namespace MotivicInvariants

open CategoryTheory AlgebraicGeometry Scheme

variable (𝕜 𝔽 : Type) [Field 𝕜] [Field 𝔽]



attribute [instance] Variety.over Variety.isIntegral









/--
Statement of Theorem 1.2 (1) (a):

When `𝕜` is a number field, `Cr₃(𝕜)` is not generated by pseudo-regularizable elements.
-/
theorem theorem_1_2_1_a [NumberField 𝕜] :
    ¬ GenByPseudoRegularizable 𝕜 3 :=
  Work.MotWire.theorem_1_2_1_a 𝕜

/--
Statement of Theorem 1.2 (1) (b):

When `𝕜` is a function field over a number field, `Cr₃(𝕜)` is not generated by pseudo-regularizable
elements.

Here by a function field, we mean a function field of a positive-dimensional `𝔽`-variety.
-/
theorem theorem_1_2_1_b [NumberField 𝔽] (X : Scheme) [Variety 𝔽 X]
    (hX : 0 < topologicalKrullDim X) :
    ¬ GenByPseudoRegularizable X.functionField 3 :=
  Work.MotWire.theorem_1_2_1_b 𝔽 X hX

/--
Statement of Theorem 1.2 (1) (c):

When `𝕜` is a function field over a finite field, `Cr₃(𝕜)` is not generated by pseudo-regularizable
elements.

Here by a function field, we mean a function field of a positive-dimensional `𝔽`-variety.
-/
theorem theorem_1_2_1_c [Finite 𝔽] (X : Scheme) [Variety 𝔽 X]
    (hX : 0 < topologicalKrullDim X) :
    ¬ GenByPseudoRegularizable X.functionField 3 :=
  Work.MotC5N3.theorem_1_2_1_c 𝔽 X hX

/--
Statement of Theorem 1.2 (1) (d):

When `𝕜` is a function field over an algebraically closed field, `Cr₃(𝕜)` is not generated by
pseudo-regularizable elements.

Here by a function field, we mean a function field of a positive-dimensional `𝔽`-variety.
-/
theorem theorem_1_2_1_d [IsAlgClosed 𝔽] (X : Scheme) [Variety 𝔽 X]
    (hX : 0 < topologicalKrullDim X) :
    ¬ GenByPseudoRegularizable X.functionField 3 :=
  Work.MotC5N3.theorem_1_2_1_d 𝔽 X hX

/--
Statement of Theorem 1.2 (2):

For subfields `𝕜 ≤ ℂ` and `n ≥ 4`, `Crₙ(𝕜)` is not generated by pseudo-regularizable elements.
-/
theorem theorem_1_2_2 {n : ℕ} (hn : 4 ≤ n) (𝕜 : Subfield ℂ) :
    ¬ GenByPseudoRegularizable 𝕜 n :=
  Work.MotWire.theorem_1_2_2 hn 𝕜

/-
**Wiring status of Theorem 1.2 (3) (the `n ≥ 5` case) — see `Submission/Work/Wire123/NOTES.md` §16.**

The `n ≥ 5` chain of `Submission/Work/CY3Stab` is complete *as a reduction*, but the named inputs it
consumes cannot be supplied, so the reduction cannot be instantiated (this is proved in
`Submission/Work/Wire123`, not conjectured):

* the `ℤ`-model `Work.G2.CY3DatumZ` has **no terms at all** (`Work.Wire123.not_nonempty_CY3DatumZ`):
  its two cubic-self-intersection clauses quantify over *every* `Work.G2.CubicInput 𝕜`, and the
  constant-`0` cubic input is one of them, so the model would prove `0 = 14`.  Hence
  `Work.CY3Stab.theorem_1_2_3_of_G2` has no instance;
* the universal `Work.CY3.TotaroInput 𝕜` is refutable (`Work.Wire123.not_totaroInput`), as are its
  cohomological producers (`Work.Totaro.CohDistinguishing`, `CorCYnSB`, …):
  `Work.Wire123.not_cohdDistinguishing_CY3`, `not_corCYnSB_CY3`, `not_k3TotaroInput`;
* the transport hypotheses of the delivered chain are *not* needed at all, by the
  conjugation-invariance of the coefficient `Work.CrauderKatz.cInv_conj_eq` (§16.1): the residual is
  `Work.Wire123.TransLink 𝕜` (paper-shaped link data + (L2) + one birational map `𝔸⁵ ⇢ P`), and the
  challenge follows from it by `Work.Wire123.theorem_1_2_3_of_transLink`; the `n = 5` case is
  `Work.Wire123.not_gen_of_transLink_five` (§16.2);
* the sharpest form of the residual is `Work.Wire123.BareLink 𝕜` (the link data and the transport
  *alone*) together with one map `γ : P ⇢ P'` whose coefficient at the base point differs from the
  link's, i.e. `Work.Wire123.BareLink.not_gen_five`; the link data itself is constructible for every
  field with a non-square from the *proved* one-sided-link machinery
  (`Work.Wire123.bareLink_of_not_isSquare`, `Work.Wire123.exists_twoSidedLink_of_not_isSquare`).

Moreover the reduction is **sharp**, and this too is machine-checked
(`Work.Wire123.BareLinkShift`, `Axioms.lean` §15): the single remaining field of the sharpest
residual is *equivalent* to a self-map of the link fivefold with non-vanishing coefficient, hence to
an element of `Cr 𝕜 5` with non-vanishing coefficient, hence to the challenge itself.  So no
strictly weaker statement in this vocabulary can imply the theorem: the `n ≥ 5` case is reduced to a
single geometric input — a birational self-map of a fivefold birational to `𝔸⁵` over `𝕜` with
non-vanishing Lin–Shinder coefficient, i.e. the paper's `thm:CY3` (`G₂`-Grassmannian L-link,
`lem-nSBG2`, Totaro's `cor-CYnSB`) — which no chapter of this workspace produces (Mathlib has no
group schemes, blow-ups, intersection theory or rationality invariants; and over algebraically
closed `𝕜` every cheap separator is provably blind, `NOTES.md` §9).  The body below becomes one of

```lean
  Work.Wire123.theorem_1_2_3_of_transLink hn 𝕜 D        -- D : Work.Wire123.TransLink 𝕜
  Work.Wire123.theorem_1_2_3_of_leanLink hn 𝕜 D         -- D : Work.Wire123.LeanLink 𝕜
  Work.Wire123.theorem_1_2_3_of_chartPair hn 𝕜 D        -- D : Work.Wire123.ChartPairOver 𝕜
```

(fields of `Work.Wire123.LeanLink 𝕜` beyond the *link data* are redundant; a paper-shaped
`Work.Wire123.CellLink 𝕜` — the link plus the two big cells of `G/P`, `G/P'`, the latter supplied by
`Work.Wire123.stronglyBirational_of_bigCell`, the paper's `lem:GP-strongly-rational` — gives the
same conclusion; and for every field with a non-square the whole link datum is *constructed*, so
only the one map `γ` above is missing there)

the moment such a `D` exists; the statement below is character-identical to `Challenge.lean`.
-/

/--
Statement of Theorem 1.2 (3):

For infinite fields `𝕜` and `n ≥ 5`, `Crₙ(𝕜)` is not generated by pseudo-regularizable elements.
-/
theorem theorem_1_2_3 {n : ℕ} (hn : 5 ≤ n) [Infinite 𝕜] :
    ¬ GenByPseudoRegularizable 𝕜 n :=
  Work.MotC5N3.theorem_1_2_3 𝕜 hn

end MotivicInvariants

end
end Submission
