import Mathlib

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


universe u

namespace Work.SpecLin.Content

open scoped Classical

section

variable {R B : Type u} [CommRing R] [IsDomain R] [ValuationRing R] [CommRing B]
  [Nontrivial B] [Algebra R B] [Module.Free R B]

/-! ### Two elementary auxiliary facts

The first is the total divisibility of a valuation ring, in the form needed here: a
nonempty finite family of elements of `R` has an element dividing all of them. -/
private lemma exists_dvd_of_finset {A : Type*} [CommRing A] [IsDomain A] [ValuationRing A]
    {ι : Type*} (s : Finset ι) (f : ι → A) (hs : s.Nonempty) :
    ∃ i₀ ∈ s, ∀ i ∈ s, f i₀ ∣ f i := by
  classical
  have key : ∀ s : Finset ι, s.Nonempty → ∃ i₀ ∈ s, ∀ i ∈ s, f i₀ ∣ f i := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro h; exact absurd h Finset.not_nonempty_empty
    | insert a t ha ih =>
      intro hs
      rcases t.eq_empty_or_nonempty with hte | htn
      · subst hte
        refine ⟨a, Finset.mem_singleton_self a, ?_⟩
        intro i hi
        rw [Finset.mem_insert] at hi
        rcases hi with rfl | hi
        · exact dvd_refl _
        · exact absurd hi (Finset.notMem_empty i)
      · obtain ⟨j, hjt, hj⟩ := ih htn
        rcases ValuationRing.dvd_total (f a) (f j) with h | h
        · refine ⟨a, Finset.mem_insert_self a t, ?_⟩
          intro i hi
          rw [Finset.mem_insert] at hi
          rcases hi with rfl | hit
          · exact dvd_refl _
          · exact h.trans (hj i hit)
        · refine ⟨j, Finset.mem_insert_of_mem hjt, ?_⟩
          intro i hi
          rw [Finset.mem_insert] at hi
          rcases hi with rfl | hit
          · exact h
          · exact hj i hit
  exact key s hs

/-! ### The coordinate computation

`m • ⊤ ⊆ B` is the ideal of `B` generated by the maximal ideal of `R` (this is
`Ideal.smul_top_eq_map`), and it is computed coordinatewise in any `R`-basis: every
coordinate of an element of `m • ⊤` lies in `m`. -/

private lemma mem_map_iff (y : B) :
    y ∈ (IsLocalRing.maximalIdeal R).map (algebraMap R B) ↔
      y ∈ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R B) := by
  rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]

private lemma coord_mem_of_mem_smul_top {ι : Type u}
    (bB : Module.Basis ι R B) (i : ι) {y : B}
    (hy : y ∈ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R B)) :
    bB.repr y i ∈ IsLocalRing.maximalIdeal R := by
  classical
  refine Submodule.smul_induction_on hy ?_ ?_
  · intro r hr n _
    rw [map_smul, Finsupp.smul_apply]
    exact Ideal.mul_mem_right (bB.repr n i) (IsLocalRing.maximalIdeal R) hr
  · intro x y hx hy
    rw [map_add, Finsupp.add_apply]
    exact Ideal.add_mem (IsLocalRing.maximalIdeal R) hx hy

private lemma map_coord_le {ι : Type u}
    (bB : Module.Basis ι R B) (i : ι) :
    Submodule.map (bB.coord i) ((IsLocalRing.maximalIdeal R) • (⊤ : Submodule R B)) ≤
      ((IsLocalRing.maximalIdeal R) : Submodule R R) := by
  intro x hx
  rw [Submodule.mem_map] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  rw [Module.Basis.coord_apply]
  exact coord_mem_of_mem_smul_top bB i hy

private lemma nonempty_chooseBasisIndex :
    Nonempty (Module.Free.ChooseBasisIndex R B) := by
  have h : (Module.Free.chooseBasis R B).repr (1 : B) ≠ 0 := by
    rw [Ne, LinearEquiv.map_eq_zero_iff]
    exact one_ne_zero
  obtain ⟨i, _⟩ := Finsupp.support_nonempty_iff.mpr h
  exact ⟨i⟩

private lemma coord_surjective {ι : Type u} (bB : Module.Basis ι R B) (i : ι) :
    Function.Surjective (bB.coord i) := by
  intro r
  refine ⟨r • bB i, ?_⟩
  rw [map_smul, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_same]
  simp

/-- `1 ∉ m·B`: if it were, then `m·B = B`, and projecting onto a basis coordinate
(of a nonempty basis, which exists since `B` is nontrivial and free) would force `R = m`. -/
private lemma one_notMem_maximalIdeal_map :
    (1 : B) ∉ (IsLocalRing.maximalIdeal R).map (algebraMap R B) := by
  classical
  intro hmem
  set m := IsLocalRing.maximalIdeal R with hm
  have htop : m.map (algebraMap R B) = ⊤ := (Ideal.eq_top_iff_one _).mpr hmem
  obtain ⟨i₀⟩ := nonempty_chooseBasisIndex (R := R) (B := B)
  let bB := Module.Free.chooseBasis R B
  have hsmul : m • (⊤ : Submodule R B) = ⊤ := by
    rw [Ideal.smul_top_eq_map, htop, Submodule.restrictScalars_top]
  have hle := map_coord_le bB i₀
  have hkey : Submodule.map (bB.coord i₀) (⊤ : Submodule R B) = ⊤ :=
    (Submodule.map_top _).trans (LinearMap.range_eq_top_of_surjective _ (coord_surjective bB i₀))
  have h3 : (⊤ : Submodule R R) ≤ (m : Submodule R R) := by
    calc (⊤ : Submodule R R) = Submodule.map (bB.coord i₀) (⊤ : Submodule R B) := hkey.symm
      _ = Submodule.map (bB.coord i₀) (m • (⊤ : Submodule R B)) := by rw [hsmul]
      _ ≤ (m : Submodule R R) := hle
  have hm_top : m = ⊤ := Submodule.eq_top_iff'.mpr fun x => h3 Submodule.mem_top
  exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (hm.symm.trans hm_top)

end

/-- Let `R` be a valuation ring with maximal ideal `m` and let `B` be a nonzero `R`-algebra
which is free as an `R`-module.  Then every element of `B` is `c • b'` with `c ∈ R` and
`b' ∉ m·B` (the ideal of `B` generated by the maximal ideal of `R`).

This is the content normalisation used in `Work.SpecLin.linEquiv_of_sections`: every rational
function on the total space is a quotient of two elements of content one, i.e. a unit at the
generic point of the special fibre.  Proof: `b = 0` is trivial (`c = 0`, `b' = 1`, and
`1 ∉ m·B` since `B` is a nonzero free module over a domain).  For `b ≠ 0`, write
`b = Σ_{i ∈ s} r_i • e_i` in a basis `(e_i)` and take `c = r_{i₀}` where `r_{i₀}` divides each
other `r_i` (divisibility is total in a valuation ring); the coefficient of `e_{i₀}` in
`b' = b / c` is `1`, so `b' ∉ m·B`. -/
theorem exists_smul_notMem_maximalIdeal_map {R B : Type u} [CommRing R] [IsDomain R]
    [ValuationRing R] [CommRing B] [Nontrivial B] [Algebra R B] [Module.Free R B] (b : B) :
    ∃ (c : R) (b' : B), b = c • b' ∧
      b' ∉ (IsLocalRing.maximalIdeal R).map (algebraMap R B) := by
  classical
  let bB := Module.Free.chooseBasis R B
  set x : (Module.Free.ChooseBasisIndex R B) →₀ R := bB.repr b with hx_def
  by_cases hb : b = 0
  · exact ⟨0, 1, by rw [hb, zero_smul], one_notMem_maximalIdeal_map⟩
  · have hx : x ≠ 0 := by
      rw [hx_def, Ne, LinearEquiv.map_eq_zero_iff]
      exact hb
    have hs : x.support.Nonempty := Finsupp.support_nonempty_iff.mpr hx
    obtain ⟨i₀, hi₀, hdiv⟩ := exists_dvd_of_finset x.support x hs
    set c : R := x i₀ with hc_def
    have hc : c ≠ 0 := by
      rw [hc_def]; exact Finsupp.mem_support_iff.mp hi₀
    have hdivall : ∀ i, c ∣ x i := by
      intro i
      by_cases h : i ∈ x.support
      · exact hdiv i h
      · have hxi : x i = 0 := by
          by_contra hh; exact h (Finsupp.mem_support_iff.mpr hh)
        rw [hxi]; exact dvd_zero c
    let d : (Module.Free.ChooseBasisIndex R B) → R := fun i => (hdivall i).choose
    have hd : ∀ i, c * d i = x i := fun i => ((hdivall i).choose_spec).symm
    have hd_supp : Function.support d ⊆ (x.support : Set (Module.Free.ChooseBasisIndex R B)) := by
      intro i hi
      by_contra hmem
      have hxi : x i = 0 := by
        by_contra hh; exact hmem (Finsupp.mem_support_iff.mpr hh)
      have hcz : c * d i = 0 := by rw [hd i, hxi]
      rcases mul_eq_zero.mp hcz with h | h
      · exact hc h
      · exact hi h
    have hfin : (Function.support d).Finite :=
      x.support.finite_toSet.subset hd_supp
    let f : (Module.Free.ChooseBasisIndex R B) →₀ R := Finsupp.ofSupportFinite d hfin
    have hf_apply : ∀ i, f i = d i := by
      intro i
      simp only [f, Finsupp.ofSupportFinite_coe]
    let b' : B := bB.repr.symm f
    have hb'_repr : bB.repr b' = f := by
      simp only [b', LinearEquiv.apply_symm_apply]
    refine ⟨c, b', ?_, ?_⟩
    · apply bB.repr.injective
      rw [map_smul, hb'_repr]
      ext i
      rw [← hx_def, Finsupp.smul_apply, hf_apply i, smul_eq_mul, hd i]
    · rw [mem_map_iff]
      intro hmem
      have hmem' : bB.repr b' i₀ ∈ IsLocalRing.maximalIdeal R :=
        coord_mem_of_mem_smul_top bB i₀ hmem
      rw [hb'_repr, hf_apply i₀] at hmem'
      have hd_i₀ : d i₀ = 1 := by
        have h1 : c * d i₀ = c * 1 := by rw [hd i₀, hc_def, mul_one]
        exact mul_left_cancel₀ hc h1
      rw [hd_i₀] at hmem'
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr hmem')

end Work.SpecLin.Content
