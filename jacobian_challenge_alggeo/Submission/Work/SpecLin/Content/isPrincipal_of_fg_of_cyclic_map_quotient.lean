import Mathlib

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


universe u

namespace Work.SpecLin.Content

/-- Let `R` be a valuation ring with maximal ideal `m`, `O` a local `R`-algebra such that
`m·O` is contained in the maximal ideal of `O` (`IsLocalHom (algebraMap R O)`), and `I ⊆ O` a
finitely generated ideal whose quotient `I / m·I` is principal.  Then `I` is principal.

This is Nakayama's argument in the form used for the "section ideals are principal" step of
`Work.SpecLin.linEquiv_of_sections`: localising the coordinate ring `B = A ⊗_R R` of an affine
chart of `C_R` at a closed point `z` of the special fibre, the ideal `I_m = ker(s^#)` of a
section `s : Spec R ⟶ C` satisfies `I_m / m·I_m ↪ O ⧸ m·O`, and its image is the maximal ideal
of the discrete valuation ring `O ⧸ m·O` (or the unit ideal), hence principal; `I_m` is finitely
generated because `B` is a quotient of a finitely presented `R`-algebra, so `I_m` is principal.
No Noetherian hypothesis on `R` is needed. -/
theorem isPrincipal_of_fg_of_cyclic_map_quotient {R O : Type u} [CommRing R] [IsDomain R]
    [ValuationRing R] [CommRing O] [Algebra R O] [IsLocalRing O]
    [IsLocalHom (algebraMap R O)] (I : Ideal O) (hfg : I.FG)
    (h : (I.map (Ideal.Quotient.mk
      (((IsLocalRing.maximalIdeal R).map (algebraMap R O)) * I))).IsPrincipal) :
    Submodule.IsPrincipal I := by
  -- `J` is the ideal `m · O` generated by the maximal ideal of `R`.
  let J : Ideal O := (IsLocalRing.maximalIdeal R).map (algebraMap R O)
  -- `J` lies in the Jacobson radical of `O` (which is its unique maximal ideal).
  have hJ : J ≤ (⊥ : Ideal O).jacobson :=
    le_trans (IsLocalRing.map_maximalIdeal_le (algebraMap R O))
      (IsLocalRing.maximalIdeal_le_jacobson ⊥)
  let f : O →+* O ⧸ (J * I) := Ideal.Quotient.mk (J * I)
  -- The image of `I` in `O ⧸ J·I` is principal, say generated by `a`.
  obtain ⟨a, ha⟩ := h.principal
  have hmem : a ∈ Ideal.map f I := by
    rw [ha]; exact Ideal.mem_span_singleton_self a
  -- Lift the generator `a` to an element `b` of `I`.
  obtain ⟨b, hbI, hb⟩ :=
    (Ideal.mem_map_iff_of_surjective f Ideal.Quotient.mk_surjective (I := I)).mp hmem
  -- Nakayama's condition: `I ≤ (b) + J·I`.
  have hle : I ≤ Submodule.span O {b} ⊔ J • I := by
    intro x hx
    have hfx : f x ∈ Ideal.span {f b} := by
      have h1 : f x ∈ Ideal.map f I := Ideal.mem_map_of_mem f hx
      rw [ha, ← hb] at h1
      exact h1
    obtain ⟨c, hc⟩ := (Ideal.mem_span_singleton' (x := f x) (y := f b)).mp hfx
    obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective c
    have hdb : f (d * b) = f x := by rw [map_mul, hd, hc]
    have hz : x - d * b ∈ J * I :=
      (Ideal.Quotient.mk_eq_mk_iff_sub_mem x (d * b)).mp hdb.symm
    rw [Submodule.mem_sup]
    refine ⟨d * b, ?_, x - d * b, ?_, by ring⟩
    · exact Ideal.mem_span_singleton'.mpr ⟨d, by ring⟩
    · rw [Ideal.smul_eq_mul]; exact hz
  -- Nakayama: since `J` is in the Jacobson radical and `I` is finitely generated, `I = (b)`.
  have hfinal := Submodule.le_of_le_smul_of_le_jacobson_bot (I := J)
    (N := Submodule.span O {b}) (N' := I) hfg hJ hle
  exact ⟨⟨b, hfinal.antisymm (Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hbI))⟩⟩

end Work.SpecLin.Content
