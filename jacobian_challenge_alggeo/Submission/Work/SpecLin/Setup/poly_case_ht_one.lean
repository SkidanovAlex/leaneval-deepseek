import Mathlib
import Submission.Work.SpecLin.Setup.primitive_associated

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.SpecLin.Setup

open Polynomial

set_option linter.unusedVariables false

universe u

/-- If `c ∉ 𝔪·R[X]` where `𝔪` is the maximal ideal of the valuation ring `R`, then `c` is a
primitive polynomial: no non-unit constant divides `c`.

Indeed, `𝔪·R[X]` is the ideal of polynomials all of whose coefficients lie in `𝔪`; a constant
`r` dividing `c` divides every coefficient, so if `r` were not a unit the coefficients of `c`
would all lie in `𝔪`. -/
theorem isPrimitive_of_notMem_map {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    {c : Polynomial R} (hc : c ∉ (IsLocalRing.maximalIdeal R).map (Polynomial.C)) :
    c.IsPrimitive := by
  intro r hr
  by_contra hru
  have hrm : r ∈ IsLocalRing.maximalIdeal R :=
    (IsLocalRing.mem_maximalIdeal r).mpr (mem_nonunits_iff.mpr hru)
  refine hc ?_
  rw [Ideal.mem_map_C_iff]
  intro n
  have hdvd : r ∣ c.coeff n := (Polynomial.C_dvd_iff_dvd_coeff r c).mp hr n
  obtain ⟨y, hy⟩ := hdvd
  rw [hy]
  exact Ideal.mul_mem_right y (IsLocalRing.maximalIdeal R) hrm

/-- **Height one primes below a principal prime.**  Let `g` be a nonconstant polynomial over a
domain `R` such that the principal ideal `(g)` is prime.  Then every prime contained in `(g)` is
either `⊥` or `(g)` itself.

This is the "degree descent": if `Q ⊊ (g)` and `h ∈ Q`, then `h = g q` with `q ∈ Q` (as `g ∉ Q`
and `Q` is prime), so `h = g^n q_n` and `deg q_n = deg h - n·deg g`, forcing `h = 0`. -/
theorem eq_bot_or_eq_span_of_isPrime_le {R : Type*} [CommRing R] [IsDomain R]
    {g : Polynomial R} (hg0 : g ≠ 0) (hgdeg : 0 < g.natDegree)
    {Q : Ideal (Polynomial R)} [Q.IsPrime] (hQle : Q ≤ Ideal.span {g}) :
    Q = ⊥ ∨ Q = Ideal.span {g} := by
  by_cases hgQ : g ∈ Q
  · right
    exact le_antisymm hQle ((Ideal.span_singleton_le_iff_mem Q).mpr hgQ)
  · left
    rw [Submodule.eq_bot_iff]
    have key : ∀ n, ∀ h ∈ Q, h.natDegree = n → h = 0 := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro h hh hdeg
        by_contra hne
        have hspan : h ∈ Ideal.span {g} := hQle hh
        obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hspan
        have hq0 : q ≠ 0 := by
          rintro rfl
          simp at hne
        have hqQ : q ∈ Q := by
          rcases (inferInstance : Q.IsPrime).mem_or_mem hh with hg | hq
          · exact absurd hg hgQ
          · exact hq
        have hlt : q.natDegree < n := by
          have h1 : (g * q).natDegree = g.natDegree + q.natDegree :=
            Polynomial.natDegree_mul hg0 hq0
          rw [← hdeg, h1]; omega
        exact hq0 (ih q.natDegree hlt q hqQ rfl)
    intro h hh
    exact key h.natDegree h hh rfl

/-- A principal prime generated by a nonconstant polynomial has height `1` (over any domain). -/
theorem height_span_singleton_eq_one {R : Type*} [CommRing R] [IsDomain R]
    {g : Polynomial R} (hg0 : g ≠ 0) (hgdeg : 0 < g.natDegree)
    (hprim : (Ideal.span {g}).IsPrime) : (Ideal.span {g}).height = 1 := by
  have := hprim
  refine le_antisymm ?_ ?_
  · change (Ideal.span {g}).height ≤ ((1 : ℕ) : ℕ∞)
    rw [Ideal.height_le_iff]
    intro Q hQp hlt
    have hQp' := hQp
    rcases eq_bot_or_eq_span_of_isPrime_le hg0 hgdeg (le_of_lt hlt) with h | h
    · rw [h, Ideal.height_bot]
      exact zero_lt_one
    · exact absurd h hlt.ne
  · rw [Order.one_le_iff_ne_zero]
    intro h0
    exact hg0 (Ideal.span_singleton_eq_bot.mp (Ideal.height_eq_zero_iff_eq_bot.mp h0))

/-- The product of two primitive polynomials over a Bézout ring is primitive (Gauss's lemma in
the form of the content ideal). -/
theorem isPrimitive_mul {R : Type*} [CommRing R] [IsBezout R] {p q : Polynomial R}
    (hp : p.IsPrimitive) (hq : q.IsPrimitive) : (p * q).IsPrimitive := by
  rw [Polynomial.isPrimitive_iff_contentIdeal_eq_top] at *
  rw [Polynomial.contentIdeal_mul_eq_top_of_contentIdeal_eq_top hp hq]

/-- **Rescaling a factorisation over the fraction field to `R[X]`.**  Let `R` be a valuation
domain with fraction field `K`, `g ∈ R[X]` primitive, and `map g = a * b` a factorisation of the
image of `g` in `K[X]` into nonzero factors.  Then `g` admits a factorisation `g = g₁ * g₂` in
`R[X]` into primitive factors with `natDegree g₁ = natDegree a` and `natDegree g₂ = natDegree b`.

Indeed, replacing `a`, `b` by primitive associates `A`, `B` with `map A = C α * a` and
`map B = C β * b`, one has `map A * (C (αβ)⁻¹ * map B) = map g`, so Gauss's lemma
(`Polynomial.IsPrimitive.map_mul_mem_lifts_iff`) exhibits `C (αβ)⁻¹ * map B` as the image of some
`g₂ ∈ R[X]`, and `A * g₂ = g` by injectivity of `Polynomial.map`. -/
theorem primitive_factorization' {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
    {g : Polynomial R} (hg : g.IsPrimitive) {a b : Polynomial K} (ha : a ≠ 0) (hb : b ≠ 0)
    (h : Polynomial.map (algebraMap R K) g = a * b) :
    ∃ g₁ g₂ : Polynomial R, g₁.IsPrimitive ∧ g₂.IsPrimitive ∧ g = g₁ * g₂ ∧
      g₁.natDegree = a.natDegree ∧ g₂.natDegree = b.natDegree := by
  classical
  obtain ⟨A, hAp, α, hα0, hA⟩ := primitive_associated (R := R) a ha
  obtain ⟨B, hBp, β, hβ0, hB⟩ := primitive_associated (R := R) b hb
  have hmapinj : Function.Injective (Polynomial.map (algebraMap R K)) :=
    Polynomial.map_injective (algebraMap R K) (IsFractionRing.injective R K)
  have hαβ0 : α * β ≠ 0 := mul_ne_zero hα0 hβ0
  have hAB : Polynomial.map (algebraMap R K) A * Polynomial.map (algebraMap R K) B
      = Polynomial.C (α * β) * Polynomial.map (algebraMap R K) g := by
    have h1 : Polynomial.C α * a * (Polynomial.C β * b) = Polynomial.C (α * β) * (a * b) := by
      calc Polynomial.C α * a * (Polynomial.C β * b)
          = Polynomial.C α * Polynomial.C β * (a * b) := by ring
        _ = Polynomial.C (α * β) * (a * b) := by rw [← Polynomial.C_mul]
    rw [hA, hB, h1, ← h]
  have key : Polynomial.map (algebraMap R K) A *
      (Polynomial.C (α * β)⁻¹ * Polynomial.map (algebraMap R K) B)
      = Polynomial.map (algebraMap R K) g := by
    have h1 : Polynomial.C (α * β)⁻¹ * (Polynomial.map (algebraMap R K) A *
        Polynomial.map (algebraMap R K) B) = Polynomial.map (algebraMap R K) g := by
      rw [hAB, ← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hαβ0, Polynomial.C_1, one_mul]
    rw [← h1]; ring
  have hmem : Polynomial.C (α * β)⁻¹ * Polynomial.map (algebraMap R K) B ∈
      Polynomial.lifts (algebraMap R K) :=
    (hAp.map_mul_mem_lifts_iff).mp ⟨g, key.symm⟩
  rw [Polynomial.mem_lifts] at hmem
  obtain ⟨g₂, hg₂⟩ := hmem
  have hAg₂ : A * g₂ = g := by
    apply hmapinj
    rw [Polynomial.map_mul, hg₂]
    exact key
  have hg₂p : g₂.IsPrimitive := by
    intro r hr
    obtain ⟨q, rfl⟩ := hr
    exact hg r ⟨A * q, by rw [← hAg₂]; ring⟩
  have hdegA : A.natDegree = a.natDegree := by
    have h1 := Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective R K) A
    rw [hA, Polynomial.natDegree_C_mul hα0] at h1
    exact h1.symm
  have hdeg₂ : g₂.natDegree = b.natDegree := by
    have h1 := Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective R K) g₂
    have h2 : Polynomial.C (α * β)⁻¹ * Polynomial.map (algebraMap R K) B
        = Polynomial.C α⁻¹ * b := by
      rw [hB, ← mul_assoc]
      have h3 : Polynomial.C (α * β)⁻¹ * Polynomial.C β = Polynomial.C α⁻¹ := by
        rw [← Polynomial.C_mul]
        congr 1
        field_simp
      rw [h3]
    rw [hg₂, h2, Polynomial.natDegree_C_mul (inv_ne_zero hα0)] at h1
    exact h1.symm
  exact ⟨A, g₂, hAp, hg₂p, hAg₂.symm, hdegA, hdeg₂⟩

/-- **The core of `poly_case_ht_one`.**  Let `N` be a maximal ideal of `R[X]` for a valuation ring
`R`, and let `c ∈ N` be primitive.  Then `c` lies in a prime ideal of `R[X]` of height one which
is contained in `N`.

Note that the hypothesis `𝔪·R[X] ≤ N` of `poly_case_ht_one` is not needed: primitivity of `c`
alone suffices.

Proof.  Choose `g` of minimal degree among the primitive divisors of `c` lying in `N`; such `g`
exists since `c` itself is one.  We claim that `g` is irreducible over `K := Frac R`: a
factorisation `map g = a * b` over `K` with `a, b` non-units can be rescaled (clearing
denominators and passing to primitive parts) to a factorisation `g = g₁ * g₂` in `R[X]` with
`g₁, g₂` primitive and `natDegree g₁ = natDegree a < natDegree g`; primality of `N` then gives
`g₁ ∈ N` (or `g₂ ∈ N`), contradicting minimality.  Hence `g` is a primitive irreducible
polynomial, so `(g)` is a prime ideal (Gauss's lemma) of height one (degree descent) contained
in `N` and containing `c`. -/
theorem exists_ht_one_prime_of_isPrimitive {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    (N : Ideal (Polynomial R)) [N.IsMaximal]
    (c : Polynomial R) (hc_prim : c.IsPrimitive) (hcN : c ∈ N)
    (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K] :
    ∃ p : Ideal (Polynomial R), p.IsPrime ∧ p.height = 1 ∧ p ≤ N ∧ c ∈ p := by
  classical
  have hmapinj : Function.Injective (Polynomial.map (algebraMap R K)) :=
    Polynomial.map_injective _ (IsFractionRing.injective R K)
  have hex : ∃ n : ℕ, ∃ g : Polynomial R, g.IsPrimitive ∧ g ∈ N ∧ g ∣ c ∧ g.natDegree = n :=
    ⟨c.natDegree, c, hc_prim, hcN, dvd_rfl, rfl⟩
  obtain ⟨g, hg_prim, hgN, hg_dvd, hg_deg⟩ := Nat.find_spec hex
  have hmin : ∀ g' : Polynomial R, g'.IsPrimitive → g' ∈ N → g' ∣ c →
      Nat.find hex ≤ g'.natDegree := fun g' h1 h2 h3 =>
    Nat.find_min' hex ⟨g', h1, h2, h3, rfl⟩
  have hNprime : N.IsPrime := (inferInstance : N.IsMaximal).isPrime
  have hg_ne : g ≠ 0 := hg_prim.ne_zero
  have hgmap_ne : Polynomial.map (algebraMap R K) g ≠ 0 := by
    intro h
    exact hg_ne (hmapinj (by rw [h, Polynomial.map_zero]))
  have hg_deg_pos : 0 < g.natDegree := by
    rcases Nat.eq_zero_or_pos g.natDegree with h0 | hpos
    · exfalso
      have hC : Polynomial.C (g.coeff 0) ∣ g :=
        ⟨1, (Polynomial.eq_C_of_natDegree_eq_zero h0).trans (mul_one _).symm⟩
      have hunit : IsUnit g := by
        rw [Polynomial.eq_C_of_natDegree_eq_zero h0]
        exact Polynomial.isUnit_C.mpr (hg_prim (g.coeff 0) hC)
      exact (Ideal.IsMaximal.ne_top (inferInstance : N.IsMaximal))
        (Ideal.eq_top_of_isUnit_mem N hgN hunit)
    · exact hpos
  have hnatpos : ∀ {p : Polynomial K}, p ≠ 0 → ¬ IsUnit p → 0 < p.natDegree := by
    intro p hp0 hpu
    rcases Nat.eq_zero_or_pos p.natDegree with h0 | hpos
    · exfalso
      have hunit : IsUnit p := by
        rw [Polynomial.isUnit_iff]
        refine ⟨p.coeff 0, ?_, (Polynomial.eq_C_of_natDegree_eq_zero h0).symm⟩
        refine isUnit_iff_ne_zero.mpr ?_
        intro hz
        exact hp0 (by rw [Polynomial.eq_C_of_natDegree_eq_zero h0, hz, Polynomial.C_0])
      exact hpu hunit
    · exact hpos
  have hgmap_irr : Irreducible (Polynomial.map (algebraMap R K) g) := by
    refine ⟨?_, ?_⟩
    · intro hunit
      obtain ⟨μ, -, hμ⟩ := Polynomial.isUnit_iff.mp hunit
      have h1 : (Polynomial.map (algebraMap R K) g).natDegree = g.natDegree :=
        Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective R K) g
      rw [← hμ, Polynomial.natDegree_C] at h1
      omega
    · intro a b hab
      by_contra hcon
      push Not at hcon
      obtain ⟨ha, hb⟩ := hcon
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [zero_mul] at hab
        exact hgmap_ne hab
      have hb0 : b ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hab
        exact hgmap_ne hab
      obtain ⟨g₁, g₂, hg1p, hg2p, hgmul, hd1, hd2⟩ :=
        primitive_factorization' hg_prim ha0 hb0 hab
      have hprod : g₁ * g₂ ∈ N := hgmul ▸ hgN
      have hdegg : g.natDegree = a.natDegree + b.natDegree := by
        have h1 : (Polynomial.map (algebraMap R K) g).natDegree = g.natDegree :=
          Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective R K) g
        rw [← h1, hab, Polynomial.natDegree_mul ha0 hb0]
      rcases hNprime.mem_or_mem hprod with h1 | h1
      · have hle := hmin g₁ hg1p h1 (dvd_trans ⟨g₂, hgmul⟩ hg_dvd)
        rw [hd1] at hle
        have := hnatpos hb0 hb
        omega
      · have hle := hmin g₂ hg2p h1 (dvd_trans ⟨g₁, by rw [hgmul, mul_comm]⟩ hg_dvd)
        rw [hd2] at hle
        have := hnatpos ha0 ha
        omega
  have hgmap_prime : Prime (Polynomial.map (algebraMap R K) g) :=
    UniqueFactorizationMonoid.irreducible_iff_prime.mp hgmap_irr
  have hg_not_unit : ¬ IsUnit g := by
    intro hunit
    obtain ⟨r, -, hr⟩ := Polynomial.isUnit_iff.mp hunit
    have h1 : g.natDegree = 0 := by rw [← hr, Polynomial.natDegree_C]
    omega
  have hg_prime : Prime g := by
    refine ⟨hg_ne, hg_not_unit, fun a b hab => ?_⟩
    have hm : Polynomial.map (algebraMap R K) g ∣
        Polynomial.map (algebraMap R K) (a * b) :=
      map_dvd (Polynomial.mapRingHom (algebraMap R K)) hab
    rw [Polynomial.map_mul] at hm
    rcases hgmap_prime.dvd_or_dvd hm with h | h
    · exact Or.inl (hg_prim.dvd_of_fraction_map_dvd_fraction_map h)
    · exact Or.inr (hg_prim.dvd_of_fraction_map_dvd_fraction_map h)
  have hg_isPrime : (Ideal.span {g}).IsPrime := Ideal.isPrime_span_singleton_of_prime hg_prime
  exact ⟨Ideal.span {g}, hg_isPrime, height_span_singleton_eq_one hg_ne hg_deg_pos hg_isPrime,
    (Ideal.span_singleton_le_iff_mem N).mpr hgN, (Ideal.mem_span_singleton).mpr hg_dvd⟩

theorem poly_case_ht_one {R : Type u} [CommRing R] [IsDomain R] [ValuationRing R]
    (N : Ideal (Polynomial R)) [N.IsMaximal]
    (hN : (IsLocalRing.maximalIdeal R).map (Polynomial.C) ≤ N)
    (c : Polynomial R) (hc : c ∉ (IsLocalRing.maximalIdeal R).map (Polynomial.C))
    (hcN : c ∈ N) :
    ∃ p : Ideal (Polynomial R), p.IsPrime ∧ p.height = 1 ∧ p ≤ N ∧ c ∈ p :=
  exists_ht_one_prime_of_isPrimitive N c (isPrimitive_of_notMem_map hc) hcN (FractionRing R)

end Work.SpecLin.Setup
