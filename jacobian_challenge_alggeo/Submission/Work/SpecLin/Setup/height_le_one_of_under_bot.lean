import Mathlib
import Submission.Work.SpecLin.Setup.krullDimLE_tensor

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


universe u

namespace Work.SpecLin.Setup

open scoped TensorProduct

/-- Any prime of `B = A ⊗[K] R` lying over the generic point of `Spec R` (i.e. with contraction
to `R` equal to `⊥`) has height at most one: the generic fibre `A ⊗[K] FractionRing R` is
one-dimensional (it is integral over `FractionRing R [X]` via Noether normalisation of `A`,
`Setup.exists_transcendental_isIntegral`), and primes over `⊥` of `B` correspond bijectively,
height-preservingly, to primes of `A ⊗[K] FractionRing R`. -/
theorem height_le_one_of_under_bot {K : Type u} [Field K] (A : Type u) [CommRing A] [IsDomain A]
    [Algebra K A] [Algebra.FiniteType K A] [Ring.KrullDimLE 1 A]
    (hA : ¬ Ring.KrullDimLE 0 A)
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Algebra K R]
    (q : Ideal (TensorProduct K A R))
    (hq : q.comap (Algebra.TensorProduct.includeRight (R := K) (A := A) (B := R)) = ⊥) :
    q.height ≤ 1 := by
  classical
  -- Make the generic fibre `A ⊗[K] FractionRing R` a `B`-algebra, so that it becomes the
  -- localization of `B = A ⊗[K] R` away from the image of `R ∖ {0}`.
  letI : Algebra (TensorProduct K A R) (TensorProduct K A (FractionRing R)) :=
    (Algebra.TensorProduct.map (AlgHom.id K A)
      (IsScalarTower.toAlgHom K R (FractionRing R))).toAlgebra
  haveI hst : IsScalarTower A (TensorProduct K A R)
      (TensorProduct K A (FractionRing R)) := by
    refine .of_algebraMap_eq fun a => ?_
    have h2 : (algebraMap A (TensorProduct K A (FractionRing R))) a =
        a ⊗ₜ[K] (1 : FractionRing R) := by
      rw [Algebra.TensorProduct.algebraMap_apply]; simp
    have h3 : (algebraMap (TensorProduct K A R) (TensorProduct K A (FractionRing R)))
        ((algebraMap A (TensorProduct K A R)) a) = a ⊗ₜ[K] (1 : FractionRing R) := by
      have h1 : (algebraMap A (TensorProduct K A R)) a = a ⊗ₜ[K] (1 : R) := by
        rw [Algebra.TensorProduct.algebraMap_apply]; simp
      rw [h1]
      change (Algebra.TensorProduct.map (AlgHom.id K A)
        (IsScalarTower.toAlgHom K R (FractionRing R))) (a ⊗ₜ[K] (1 : R)) = _
      rw [Algebra.TensorProduct.map_tmul]; simp
    rw [h2, h3]
  -- The submonoid of `B` generated by the images of the nonzero elements of `R`.
  let S' : Submonoid (TensorProduct K A R) :=
    Submonoid.map (Algebra.TensorProduct.includeRight (R := K) (A := A) (B := R))
      (nonZeroDivisors R)
  haveI hloc : IsLocalization S' (TensorProduct K A (FractionRing R)) :=
    IsLocalization.tensorProduct_tensorProduct_right (R := K) (S := A) (nonZeroDivisors R)
      (FractionRing R) (by
        ext r
        rw [RingHom.comp_apply, RingHom.comp_apply]
        change (algebraMap (TensorProduct K A R) (TensorProduct K A (FractionRing R)))
          (Algebra.TensorProduct.includeRight r) = _
        rw [show Algebra.TensorProduct.includeRight r = (1 : A) ⊗ₜ[K] r from rfl]
        change (Algebra.TensorProduct.map (AlgHom.id K A)
          (IsScalarTower.toAlgHom K R (FractionRing R))) (1 ⊗ₜ[K] r) = _
        change _ = Algebra.TensorProduct.includeRight (algebraMap R (FractionRing R) r)
        rw [show Algebra.TensorProduct.includeRight (algebraMap R (FractionRing R) r) =
          (1 : A) ⊗ₜ[K] (algebraMap R (FractionRing R) r) from rfl]
        rw [Algebra.TensorProduct.map_tmul]; simp)
  -- `q` is disjoint from `S'`.
  have hdisj : Disjoint (S' : Set (TensorProduct K A R)) (q : Set (TensorProduct K A R)) := by
    rw [Set.disjoint_left]
    intro x hxS hxq
    obtain ⟨m, hm, hfm⟩ := Submonoid.mem_map.mp hxS
    have hm0 : m = 0 := by
      have h1 : m ∈ q.comap (Algebra.TensorProduct.includeRight (R := K) (A := A) (B := R)) := by
        rw [Ideal.mem_comap]
        rw [hfm]
        exact hxq
      rw [hq] at h1
      exact h1
    exact nonZeroDivisors.ne_zero hm hm0
  -- Hence `q` does not become the whole generic fibre.
  have hne : q.map (algebraMap (TensorProduct K A R) (TensorProduct K A (FractionRing R))) ≠ ⊤ :=
    (IsLocalization.map_algebraMap_ne_top_iff_disjoint S'
      (TensorProduct K A (FractionRing R)) q).mpr hdisj
  -- The generic fibre is one-dimensional.
  have hdim : Ring.KrullDimLE 1 (TensorProduct K A (FractionRing R)) :=
    Work.CurveBasics.BaseChange.krullDimLE_tensor (k := K) (F := FractionRing R) (R := A)
      (n := 1) (by assumption)
  have hdim_le : ringKrullDim (TensorProduct K A (FractionRing R)) ≤ (1 : WithBot ℕ∞) :=
    Ring.krullDimLE_iff.mp hdim
  -- Localization does not decrease the height, and the image has height at most the dimension.
  have h2 : q.height ≤ (q.map (algebraMap (TensorProduct K A R)
      (TensorProduct K A (FractionRing R)))).height := by
    rw [← IsLocalization.height_under S'
      (q.map (algebraMap (TensorProduct K A R) (TensorProduct K A (FractionRing R))))]
    exact Ideal.height_mono Ideal.le_comap_map
  have h3 : ((q.map (algebraMap (TensorProduct K A R)
      (TensorProduct K A (FractionRing R)))).height : WithBot ℕ∞) ≤
      ringKrullDim (TensorProduct K A (FractionRing R)) :=
    Ideal.height_le_ringKrullDim_of_ne_top hne
  have h4 : (q.height : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) :=
    le_trans (by exact_mod_cast h2) (le_trans h3 hdim_le)
  exact WithBot.coe_le_coe.mp h4

end Work.SpecLin.Setup
