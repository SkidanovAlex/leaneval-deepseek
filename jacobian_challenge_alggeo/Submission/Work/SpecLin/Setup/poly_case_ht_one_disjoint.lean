import Mathlib
import Submission.Work.SpecLin.Setup.poly_case_ht_one

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.SpecLin.Setup

set_option linter.style.haveILetI false

/-- **A height-one prime in `R[X]` that meets `R` is generated by constants.**

Let `R` be a local domain with maximal ideal `𝔪`, let `p ⊆ R[X]` be a prime ideal of height one
containing a polynomial `c` whose coefficients do not all lie in `𝔪` (in particular `c ≠ 0`).
Then `p` is *horizontal*: `p.under R = ⊥`.

Proof.  Suppose `I := p.under R ≠ ⊥`. Then `I` is a nonzero prime ideal of `R`, so `J := I·R[X]`
(that is, `I.map Polynomial.C`, the ideal of polynomials all of whose coefficients lie in `I`) is a
nonzero prime ideal with `J ≤ p`; here primality is `Ideal.isPrime_map_C_of_isPrime`.  If `J ≠ p`
then `J < p` are primes, so by `Ideal.height_le_iff` and `p.height = 1` the height of `J` would be
`0`, forcing `J = ⊥` by `Ideal.height_eq_zero_iff_eq_bot` — a contradiction.  Hence `J = p`, and
then every coefficient of `c ∈ p` lies in `I ≤ 𝔪` (a proper ideal of the local ring `R`), i.e.
`c ∈ 𝔪·R[X]`, contradicting the hypothesis on `c`. -/
theorem under_eq_bot_of_height_eq_one {R : Type*} [CommRing R] [IsDomain R] [IsLocalRing R]
    {p : Ideal (Polynomial R)} (hp : p.IsPrime) (hp1 : p.height = 1) {c : Polynomial R}
    (hc : c ∉ (IsLocalRing.maximalIdeal R).map Polynomial.C) (hcp : c ∈ p) : p.under R = ⊥ := by
  haveI := hp
  rw [Submodule.eq_bot_iff]
  intro r hr
  by_contra hr0
  set I : Ideal R := p.under R with hI
  have hrI : r ∈ I := by rw [hI]; exact hr
  have hJprime : (Ideal.map Polynomial.C I).IsPrime := Ideal.isPrime_map_C_of_isPrime
  have hJle : Ideal.map Polynomial.C I ≤ p := by
    rw [Ideal.map_le_iff_le_comap, hI]
    intro x hx
    rw [Ideal.mem_under] at hx
    rwa [Polynomial.algebraMap_eq] at hx
  have hJne : Ideal.map Polynomial.C I ≠ ⊥ := by
    intro hbot
    have hmem : Polynomial.C r ∈ Ideal.map Polynomial.C I := Ideal.mem_map_of_mem Polynomial.C hrI
    rw [hbot] at hmem
    exact hr0 (Polynomial.C_eq_zero.mp hmem)
  have hIle : I ≤ IsLocalRing.maximalIdeal R := by
    refine IsLocalRing.le_maximalIdeal ?_
    intro htop
    have h1I : (1 : R) ∈ I := by rw [htop]; trivial
    have h1 : (1 : Polynomial R) ∈ p := by
      rw [hI, Ideal.mem_under] at h1I
      rwa [Polynomial.algebraMap_eq] at h1I
    exact hp.ne_top ((Ideal.eq_top_iff_one p).mpr h1)
  have hJne_p : Ideal.map Polynomial.C I ≠ p := by
    intro heq
    have hcmem : c ∈ Ideal.map Polynomial.C I := heq ▸ hcp
    rw [Ideal.mem_map_C_iff] at hcmem
    refine hc ?_
    rw [Ideal.mem_map_C_iff]
    intro n
    exact hIle (hcmem n)
  have hJlt : Ideal.map Polynomial.C I < p := lt_of_le_of_ne hJle hJne_p
  have h2 := (Ideal.height_le_iff (p := p) (n := 1)).mp (by simpa using le_of_eq hp1)
  have h3 : (Ideal.map Polynomial.C I).height < (1 : ℕ∞) := by
    simpa using h2 _ hJprime hJlt
  have h4 : (Ideal.map Polynomial.C I).height = 0 := Order.lt_one_iff.mp h3
  exact hJne (Ideal.height_eq_zero_iff_eq_bot.mp h4)

/-- Strengthened polynomial case: the height-one prime `p` produced by the principal ideal
statement for `R[X]` (`R` a valuation ring) can be taken to be *horizontal*, i.e. with
`p ∩ R = ⊥` (encoded as `p.under R = ⊥`).

Proof: re-run the construction in `Submission/Work/SpecLin/Setup/poly_case_ht_one.lean`
(`exists_ht_one_prime_of_isPrimitive`), which produces `p = Ideal.span {g}` with `g` primitive and
`0 < g.natDegree`; then `(Ideal.span {g}).under R = ⊥` by the degree argument: if `C r = g * q`
with `r ≠ 0`, then `q ≠ 0` and `0 = natDegree (C r) = g.natDegree + q.natDegree ≥ 1`. -/
theorem poly_case_ht_one_disjoint {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    (N : Ideal (Polynomial R)) [N.IsMaximal]
    (hN : (IsLocalRing.maximalIdeal R).map (Polynomial.C) ≤ N)
    (c : Polynomial R) (hc : c ∉ (IsLocalRing.maximalIdeal R).map (Polynomial.C))
    (hcN : c ∈ N) :
    ∃ p : Ideal (Polynomial R), p.IsPrime ∧ p.height = 1 ∧ p ≤ N ∧ p.under R = ⊥ ∧ c ∈ p := by
  obtain ⟨p, hp, hp1, hpN, hcp⟩ := poly_case_ht_one N hN c hc hcN
  exact ⟨p, hp, hp1, hpN, under_eq_bot_of_height_eq_one hp hp1 hc hcp, hcp⟩

end Work.SpecLin.Setup
