/-- A general ideal-theoretic triviality: two ideals with the same image under a
surjective ring homomorphism, provided the kernels lie below them. -/
theorem eq_of_map_eq_map_of_surjective {A B : Type*} [CommRing A] [CommRing B] (f : A →+* B)
    (hf : Function.Surjective f) {I J : Ideal A} (hI : RingHom.ker f ≤ I) (hJ : RingHom.ker f ≤ J)
    (h : Ideal.map f I = Ideal.map f J) : I = J := by
  apply le_antisymm
  · intro x hx
    have hm : f x ∈ Ideal.map f J := by rw [← h]; exact Ideal.mem_map_of_mem f hx
    obtain ⟨y, hy, hyx⟩ := (Ideal.mem_map_iff_of_surjective f hf).mp hm
    have hxy : x - y ∈ RingHom.ker f := by rw [RingHom.mem_ker, map_sub, hyx, sub_self]
    have hxymem : x - y ∈ J := hJ hxy
    have hsplit : x = (x - y) + y := by ring
    rw [hsplit]; exact J.add_mem hxymem hy
  · intro x hx
    have hm : f x ∈ Ideal.map f I := by rw [h]; exact Ideal.mem_map_of_mem f hx
    obtain ⟨y, hy, hyx⟩ := (Ideal.mem_map_iff_of_surjective f hf).mp hm
    have hxy : x - y ∈ RingHom.ker f := by rw [RingHom.mem_ker, map_sub, hyx, sub_self]
    have hxymem : x - y ∈ I := hI hxy
    have hsplit : x = (x - y) + y := by ring
    rw [hsplit]; exact I.add_mem hxymem hy

/-- **A local equation of the special fibre at a closed point of the special fibre.**

For a curve `C` over a field `K`, a `K`-valuation ring `R`, an affine open chart `W ⊆ C` with
coordinate ring `A = Γ(C,W)`, the relative chart `B = A ⊗_K R`, its fibre prime
`P = chartFibrePrime R W = m_R·B` and a maximal ideal `N ⊇ P` of `B`: the maximal ideal of the
localisation `B_N` is generated by *one* element modulo the extension `P·B_N` of the fibre prime.
Equivalently, the maximal ideal of the local ring `(B_N) ⧸ (P·B_N)` — the local ring of the
special fibre at the point `N` — is principal: the special fibre is a smooth curve over the
residue field `κ = R/m_R`, so its local ring at the closed point `N` is a discrete valuation
ring.

This is the "local equation" input of the reading-off step: with `u` as in the statement (a
uniformizer of the special fibre at `N`), any element of `B_N` whose class generates the ideal of
the section `I_m` (i.e. `I_m·B_N = (f)·B_N + P·B_N`) has reduction of order `1` at the point of
`C_κ` cut out by `N` — see `Work.SpecLin.Alt.ordAt_chartTensorRedMap_eq_one`, whose hypothesis
`hf` is exactly the conclusion of the present statement, solved for such an `f`.

Intended route (all ingredients are already in the workspace):

* `Work.SpecLin.Alt.exists_chartTensorFibrePoint` produces a place `z` of the special fibre
  `C_κ = C.baseChange κ` with `z.point ∈ W_κ` and, for every `x ∈ K(C_κ)`,

  `(∃ a b : B, b ∉ N ∧ x * ρ b = ρ a) ↔ 0 ≤ ord_z x`

  (`ρ = chartTensorRedMap`); the right-hand side says that `x` lies in the valuation subring
  `O_z ⊆ K(C_κ)` of the place `z`.
* `Work.SpecLin.Alt.chartTensorRedMap_eq_zero_iff` gives `ρ x = 0 ↔ x ∈ P`, so `ρ` kills exactly
  `P`, and `b ∉ N` implies `ρ b ≠ 0`, hence `ρ b` is a unit of the field `K(C_κ)`.  Therefore the
  universal property of the localisation gives a ring homomorphism
  `ρV : B_N → K(C_κ)`, `ρV (a/s) = ρ a / ρ s`, and it factors through `(B_N) ⧸ P·B_N`.
* By the dictionary above, the image of `ρV` is exactly `O_z`; the kernel on `(B_N) ⧸ P·B_N` is
  trivial (`ρ a = 0 → a ∈ P`), so `(B_N) ⧸ P·B_N ≅ O_z` — the local ring of the smooth curve
  `C_κ` at its closed point `z`, a discrete valuation ring
  (`Work.CurveBasics.Curve.Place.instIsDiscreteValuationRing`).  Its maximal ideal is principal
  (`IsDiscreteValuationRing.exists_irreducible`, `Irreducible.maximalIdeal_eq`), and a preimage
  `u ∈ B_N` of a generator satisfies `IsLocalRing.maximalIdeal (B_N) = span {u} ⊔ P·B_N` because
  `(B_N) ⧸ P·B_N` is local with maximal ideal the image in it of `maximalIdeal (B_N)`
  (`IsLocalRing.maximalIdeal_eq_map_of_le`-style quotient manipulations; note `P·B_N ≤
  maximalIdeal (B_N)` since `P ≤ N`). -/
theorem exists_span_singleton_sup_chartFibrePrime_localization {K : Type u} [Field K]
    {C : Work.CurveBasics.Curve K}
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Algebra K R]
    (W : C.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) [Nonempty W]
    (N : Ideal (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)) [N.IsMaximal]
    (hPN : Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W ≤ N) :
    ∃ u : Localization.AtPrime N,
      IsLocalRing.maximalIdeal (Localization.AtPrime N) = Ideal.span {u} ⊔
        (Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W).map
          (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
            (Localization.AtPrime N)) := by
  classical
  obtain ⟨z, hz_mem, hz⟩ := exists_chartTensorFibrePoint R W hW N hPN
  haveI hNprime : N.IsPrime := ‹N.IsMaximal›.isPrime
  haveI hlocRing : IsLocalRing (Localization.AtPrime N) :=
    IsLocalization.AtPrime.isLocalRing (Localization.AtPrime N) N
  have hφinj : Function.Injective (chartFibreQuotMap (K:=K) (C:=C) R W hW) := by
    have hfr : @IsFractionRing (Work.SpecLin.Core.chartTensor (K:=K) (C:=C) R W ⧸
        Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W) _
        (C.baseChange (IsLocalRing.ResidueField R)).functionField _
        ((chartFibreQuotMap (K:=K) (C:=C) R W hW).toAlgebra) :=
      chartFibreQuotMap_isFractionRing (K:=K) (C:=C) R W hW
    have hinj := @IsFractionRing.injective (Work.SpecLin.Core.chartTensor (K:=K) (C:=C) R W ⧸
        Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W) _
        (C.baseChange (IsLocalRing.ResidueField R)).functionField _
        ((chartFibreQuotMap (K:=K) (C:=C) R W hW).toAlgebra) hfr
    simpa only [RingHom.algebraMap_toAlgebra] using hinj
  have hker : RingHom.ker (chartTensorRedMap (K:=K) (C:=C) R W hW)
      = Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W := by
    refine le_antisymm ?_ (chartFibrePrime_le_ker_redMap (K:=K) (C:=C) R W hW)
    intro x hx
    rw [RingHom.mem_ker] at hx
    have h1 : chartFibreQuotMap (K:=K) (C:=C) R W hW
        (Ideal.Quotient.mk (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W) x) = 0 := by
      rw [chartFibreQuotMap_mk]
      exact hx
    exact Ideal.Quotient.eq_zero_iff_mem.mp (hφinj (by rw [h1, map_zero]))
  have hred_ne : ∀ b : Work.SpecLin.Core.chartTensor R W,
      b ∉ N → chartTensorRedMap (K:=K) (C:=C) R W hW b ≠ 0 := by
    intro b hb h0
    have hb' : b ∈ RingHom.ker (chartTensorRedMap (K:=K) (C:=C) R W hW) := h0
    rw [hker] at hb'
    exact hb (hPN hb')
  have hred_mem_V : ∀ b : Work.SpecLin.Core.chartTensor R W,
      chartTensorRedMap (K:=K) (C:=C) R W hW b ∈ z.valuationSubring := by
    intro b
    rw [Work.CurveBasics.Place.mem_valuationSubring_iff]
    rw [← hz (chartTensorRedMap (K:=K) (C:=C) R W hW b)]
    refine ⟨b, 1, ?_, ?_⟩
    · intro h1
      exact (Ideal.IsMaximal.ne_top ‹N.IsMaximal›) ((Ideal.eq_top_iff_one _).mpr h1)
    · rw [map_one, mul_one]
  set g : Work.SpecLin.Core.chartTensor R W →+* ↥(z.valuationSubring) :=
    (chartTensorRedMap (K:=K) (C:=C) R W hW).codRestrict z.valuationSubring hred_mem_V
    with hg_def
  have hgb : ∀ b : Work.SpecLin.Core.chartTensor R W,
      (g b : (C.baseChange (IsLocalRing.ResidueField R)).functionField)
        = chartTensorRedMap (K:=K) (C:=C) R W hW b :=
    fun b => RingHom.codRestrict_apply _ _ _ b
  have hker_g : RingHom.ker g = Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W := by
    rw [← hker]
    ext b
    rw [RingHom.mem_ker, RingHom.mem_ker]
    constructor
    · intro hb
      have h2 : (g b : (C.baseChange (IsLocalRing.ResidueField R)).functionField) = 0 := by
        rw [hb]; rfl
      rwa [hgb b] at h2
    · intro hb
      have h2 : (g b : (C.baseChange (IsLocalRing.ResidueField R)).functionField) = 0 := by
        rw [hgb b, hb]
      exact Subtype.ext h2
  have hg : ∀ y : ↥(N.primeCompl), IsUnit (g (y : Work.SpecLin.Core.chartTensor R W)) := by
    intro y
    have hy : (y : Work.SpecLin.Core.chartTensor R W) ∉ N := y.2
    have hyV : ((chartTensorRedMap (K:=K) (C:=C) R W hW
        (y : Work.SpecLin.Core.chartTensor R W))⁻¹) ∈ z.valuationSubring := by
      rw [Work.CurveBasics.Place.mem_valuationSubring_iff]
      rw [← hz ((chartTensorRedMap (K:=K) (C:=C) R W hW
        (y : Work.SpecLin.Core.chartTensor R W))⁻¹)]
      exact ⟨1, (y : Work.SpecLin.Core.chartTensor R W), hy, by
        rw [map_one, inv_mul_cancel₀ (hred_ne _ hy)]⟩
    refine IsUnit.of_mul_eq_one
      (⟨(chartTensorRedMap (K:=K) (C:=C) R W hW
        (y : Work.SpecLin.Core.chartTensor R W))⁻¹, hyV⟩ : ↥(z.valuationSubring)) ?_
    exact Subtype.ext (by
      show (chartTensorRedMap (K:=K) (C:=C) R W hW
        (y : Work.SpecLin.Core.chartTensor R W))
        * (chartTensorRedMap (K:=K) (C:=C) R W hW
          (y : Work.SpecLin.Core.chartTensor R W))⁻¹ = 1
      exact mul_inv_cancel₀ (hred_ne _ hy))
  set ρV : Localization.AtPrime N →+* ↥(z.valuationSubring) := IsLocalization.lift hg
    with hρV_def
  have hρsurj : Function.Surjective ρV := by
    intro v
    have hvord : 0 ≤ (C.baseChange (IsLocalRing.ResidueField R)).ordAt (v : _) z :=
      (Work.CurveBasics.Place.mem_valuationSubring_iff _ _ _).mp v.2
    obtain ⟨a, b, hb, hab⟩ := (hz (v : _)).mpr hvord
    refine ⟨IsLocalization.mk' (Localization.AtPrime N) a
      (⟨b, hb⟩ : ↥(N.primeCompl)), ?_⟩
    rw [IsLocalization.lift_mk'_spec]
    refine Subtype.ext ?_
    show (chartTensorRedMap (K:=K) (C:=C) R W hW a : _)
      = (chartTensorRedMap (K:=K) (C:=C) R W hW b : _) * (v : _)
    rw [hab.symm, mul_comm]
  have hcomp : ρV.comp (algebraMap (Work.SpecLin.Core.chartTensor R W)
      (Localization.AtPrime N)) = g := IsLocalization.lift_comp (hg := hg)
  have hker_comp : RingHom.ker (ρV.comp (algebraMap (Work.SpecLin.Core.chartTensor R W)
      (Localization.AtPrime N))) = Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W := by
    rw [hcomp, hker_g]
  have hbot : Ideal.map ρV ((Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W).map
      (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N))) = ⊥ := by
    have h1 : Ideal.map (ρV.comp (algebraMap (Work.SpecLin.Core.chartTensor R W)
        (Localization.AtPrime N))) (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W)
        = ⊥ := by
      rw [Ideal.map_eq_bot_iff_le_ker, hker_comp]
    rw [Ideal.map_map]; exact h1
  have hQle : (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W).map
      (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N))
      ≤ RingHom.ker ρV := (Ideal.map_eq_bot_iff_le_ker ρV).mp hbot
  have hker_ρV_le : RingHom.ker ρV ≤ (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W).map
      (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N)) := by
    intro x hx
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective N.primeCompl x
    rw [RingHom.mem_ker] at hx
    have hga : g a = 0 := by
      have h := (IsLocalization.lift_mk'_spec (S := Localization.AtPrime N)
        (M := N.primeCompl) hg a 0 s).mp hx
      rwa [mul_zero] at h
    have haP : a ∈ Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W := by
      rw [← hker_g, RingHom.mem_ker]; exact hga
    have haQ : algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N) a
        ∈ (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W).map
          (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N)) :=
      Ideal.mem_map_of_mem _ haP
    have hu : IsUnit (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N)
        (s : Work.SpecLin.Core.chartTensor R W)) := IsLocalization.map_units _ s
    obtain ⟨u, hu_eq⟩ := hu
    have hmk : IsLocalization.mk' (Localization.AtPrime N) a s
        = algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N) a * ↑u⁻¹ := by
      have hspec := IsLocalization.mk'_spec (Localization.AtPrime N) a s
      rw [← hu_eq] at hspec
      rw [← hspec, mul_assoc, Units.mul_inv, mul_one]
    show IsLocalization.mk' (Localization.AtPrime N) a s ∈ _
    rw [hmk]
    exact Ideal.mul_mem_right (↑u⁻¹) _ haQ
  have hQ_le_max : (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W).map
      (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N))
      ≤ IsLocalRing.maximalIdeal (Localization.AtPrime N) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (R := Work.SpecLin.Core.chartTensor R W)
      N (Localization.AtPrime N)]
    exact Ideal.map_mono hPN
  have hker_ρV : RingHom.ker ρV = (Work.SpecLin.Core.chartFibrePrime (K:=K) (C:=C) R W).map
      (algebraMap (Work.SpecLin.Core.chartTensor R W) (Localization.AtPrime N)) :=
    le_antisymm hker_ρV_le hQle
  haveI hdvrO : IsDiscreteValuationRing ↥(z.valuationSubring) := by
    haveI hdvr : IsDiscreteValuationRing
        ((C.baseChange (IsLocalRing.ResidueField R)).left.presheaf.stalk z.point) :=
      z.instIsDiscreteValuationRing
    rw [show z.valuationSubring = ((IsDiscreteValuationRing.maximalIdeal
        ((C.baseChange (IsLocalRing.ResidueField R)).left.presheaf.stalk z.point)).valuation
        (C.baseChange (IsLocalRing.ResidueField R)).functionField).valuationSubring from rfl]
    exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing
      (IsDiscreteValuationRing.equivValuationSubring
        (A := (C.baseChange (IsLocalRing.ResidueField R)).left.presheaf.stalk z.point)
        (K := (C.baseChange (IsLocalRing.ResidueField R)).functionField))
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible ↥(z.valuationSubring)
  have hspan : IsLocalRing.maximalIdeal ↥(z.valuationSubring) = Ideal.span {ϖ} :=
    hϖ.maximalIdeal_eq
  have hmaxmap : Ideal.map ρV (IsLocalRing.maximalIdeal (Localization.AtPrime N))
      = IsLocalRing.maximalIdeal ↥(z.valuationSubring) :=
    IsLocalRing.map_maximalIdeal_of_surjective ρV hρsurj
  obtain ⟨u, hu_mem, hu_eq⟩ :=
    (Ideal.mem_map_iff_of_surjective ρV hρsurj).mp (by
      rw [hmaxmap, hspan]; exact Ideal.subset_span (Set.mem_singleton ϖ))
  refine ⟨u, ?_⟩
  apply eq_of_map_eq_map_of_surjective ρV hρsurj
  · rw [hker_ρV]; exact hQ_le_max
  · rw [hker_ρV]; exact le_sup_right
  · rw [hmaxmap, hspan, Ideal.map_sup, Ideal.map_span, Set.image_singleton, hu_eq, hbot,
      sup_bot_eq]

end Work.SpecLin.Alt
