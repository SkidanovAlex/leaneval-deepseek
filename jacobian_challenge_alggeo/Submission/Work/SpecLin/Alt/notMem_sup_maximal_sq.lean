import Mathlib
import Submission.Work.SpecLin.Alt.conservationNumber

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.SpecLin.Alt

universe u

/-- Let `q`, `P` be primes of a domain `B` over a valuation ring `R`, with `q ⊔ P = N` for a
maximal ideal `N`, and let `f` generate `q` with `f ∉ P`.  Then `f ∉ P ⊔ N²`: equivalently, the
image of `f` in `B_N ⧸ P B_N` is a uniformizer (of order exactly one). -/
theorem notMem_sup_maximal_sq {R : Type u} [CommRing R] [IsDomain R] [ValuationRing R]
    {B : Type u} [CommRing B] [IsDomain B] [Algebra R B]
    (P N q : Ideal B) (hP : P.IsPrime) (hN : N.IsMaximal) (hq : q.IsPrime)
    (hsup : q ⊔ P = N) (f : B) (hf : Ideal.span {f} = q) (hfP : f ∉ P) :
    f ∉ P ⊔ N ^ 2 := by
  -- The whole argument happens in the quotient `B ⧸ P`, which is a domain.
  -- (`hq`, `IsDomain R`, `ValuationRing R` and the `R`-algebra structure are not needed:
  -- the statement holds for any domain `B`.)
  intro hfmem
  have _ := hq
  have hp : P.IsPrime := hP
  have hn : N.IsMaximal := hN
  -- `P ≤ N`, hence `f ∈ q ≤ N`.
  have hPN : P ≤ N := by rw [← hsup]; exact le_sup_right
  have hfN : f ∈ N := by
    have hfq : f ∈ q := by rw [← hf]; exact Ideal.mem_span_singleton_self f
    rw [← hsup]; exact Ideal.mem_sup_left hfq
  -- The image `I = N·(B⧸P)` of `N` in `B ⧸ P` is maximal.
  have hker : RingHom.ker (Ideal.Quotient.mk P) ≤ N := by
    rw [Ideal.mk_ker]; exact hPN
  have hImax : (Ideal.map (Ideal.Quotient.mk P) N).IsMaximal :=
    Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective hker
  -- Since `q = (f)` and `q ⊔ P = N`, the ideal `I` is generated by the image of `f`.
  have hIspan : Ideal.map (Ideal.Quotient.mk P) N
      = Ideal.span {Ideal.Quotient.mk P f} := by
    rw [← hsup, Ideal.map_sup, Ideal.map_quotient_self, ← hf, Ideal.map_span]
    simp
  -- Assume for contradiction that `f ∈ P ⊔ N²`; then its image lies in `I²`.
  have hmem : Ideal.Quotient.mk P f ∈ Ideal.map (Ideal.Quotient.mk P) (P ⊔ N ^ 2) :=
    Ideal.mem_map_of_mem _ hfmem
  have hmap : Ideal.map (Ideal.Quotient.mk P) (P ⊔ N ^ 2)
      = (Ideal.map (Ideal.Quotient.mk P) N) ^ 2 := by
    rw [Ideal.map_sup, Ideal.map_pow, Ideal.map_quotient_self]
    simp
  rw [hmap] at hmem
  rw [hIspan] at hmem
  rw [Ideal.span_singleton_pow] at hmem
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hmem
  -- The image of `f` is nonzero because `f ∉ P`.
  have hg_ne : Ideal.Quotient.mk P f ≠ 0 := by
    intro h
    exact hfP (Ideal.Quotient.eq_zero_iff_mem.mp h)
  -- `x = f̄` satisfies `x = x²a` in the domain `B ⧸ P`, and `x ≠ 0`, so `x` is a unit,
  -- i.e. `1 ∈ I`, contradicting maximality of `I`.
  have hzero : Ideal.Quotient.mk P f * (1 - Ideal.Quotient.mk P f * a) = 0 := by
    rw [mul_sub, mul_one, ← mul_assoc, ← pow_two, sub_eq_zero]
    exact ha
  have hsecond : 1 - Ideal.Quotient.mk P f * a = 0 := by
    rcases mul_eq_zero.mp hzero with h | h
    · exact absurd h hg_ne
    · exact h
  have hone : (1 : B ⧸ P) ∈ Ideal.map (Ideal.Quotient.mk P) N := by
    rw [hIspan, Ideal.mem_span_singleton]
    exact ⟨a, sub_eq_zero.mp hsecond⟩
  exact Ideal.IsMaximal.ne_top hImax (Ideal.eq_top_iff_one _ |>.mpr hone)

end Work.SpecLin.Alt
