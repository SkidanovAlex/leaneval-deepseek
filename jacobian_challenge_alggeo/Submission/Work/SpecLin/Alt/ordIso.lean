import Mathlib
import Submission.Work.SpecLin.Alt.SchemeIso

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# Order of vanishing is transported along an isomorphism of schemes

For an isomorphism `e : X ≅ Y` of integral locally Noetherian schemes, the induced map
`ffMap e : Y.functionField ⟶ X.functionField` on function fields (the stalk map of `e.hom`
at the generic point) is a ring isomorphism which identifies the local ring of `X` at `z`
with the local ring of `Y` at `e.hom.base z`.  Consequently the order of vanishing of `f`
at `e z` on `Y` equals the order of vanishing of `ffMap e f` at `z` on `X`.

The proof proceeds by reducing to a purely ring-theoretic statement: for a ring isomorphism
`φ : S ≃+* R` of Noetherian domains of Krull dimension `≤ 1` with fraction fields `L`, `K`
related by `ψ : L →+* K` which is compatible with `φ`, the maps `Ring.ordFrac` correspond:
`Ring.ordFrac R (ψ x) = Ring.ordFrac S x`.  The key ingredient is that `Ring.ord` is
invariant under ring isomorphisms, which follows from the order isomorphism on ideals
`RingEquiv.idealComapOrderIso` and the description `Ring.ord` as a coheight of the ideal
generated by the element.
-/

set_option autoImplicit false

open CategoryTheory AlgebraicGeometry TopologicalSpace TopCat

universe u

namespace Work.SpecLin.Alt

/-- The order-theoretic coheight is invariant under order isomorphisms. -/
lemma coheight_eq_of_orderIso {α β : Type*} [Preorder α] [Preorder β] (f : α ≃o β) (a : α) :
    Order.coheight (f a) = Order.coheight a := by
  refine le_antisymm ?_ ?_
  · refine Order.coheight_le_iff.mpr fun p hp => ?_
    rw [← LTSeries.map_length p f.symm f.symm.strictMono]
    refine Order.length_le_coheight ?_
    rw [LTSeries.head_map]
    simpa using (f.symm.le_iff_le).mpr hp
  · refine Order.coheight_le_iff.mpr fun p hp => ?_
    rw [← LTSeries.map_length p f f.strictMono]
    refine Order.length_le_coheight ?_
    rw [LTSeries.head_map]
    exact (f.le_iff_le).mpr hp

/-- **The order of vanishing in a ring is invariant under ring isomorphisms.** -/
lemma ord_ringEquiv {R S : Type*} [Ring R] [Ring S] (e : R ≃+* S) (x : R) :
    Ring.ord S (e x) = Ring.ord R x := by
  rw [Ring.ord, Ring.ord, Module.length_quotient, Module.length_quotient]
  rw [← coheight_eq_of_orderIso e.idealComapOrderIso.symm (Ideal.span {x})]
  congr 1
  rw [RingEquiv.idealComapOrderIso_symm_apply, Ideal.map_span, Set.image_singleton]

/-- **The order function on a domain is invariant under ring isomorphisms.** -/
lemma ordMonoidWithZeroHom_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    [IsDomain R] [IsDomain S] (e : R ≃+* S) (x : R) :
    Ring.ordMonoidWithZeroHom S (e x) = Ring.ordMonoidWithZeroHom R x := by
  by_cases hx : x = 0
  · subst hx; simp
  · have hex : e x ≠ 0 := fun h => hx (e.injective (by simpa using h))
    rw [Ring.ordMonoidWithZeroHom_eq_ord (mem_nonZeroDivisors_iff_ne_zero.mpr hex),
        Ring.ordMonoidWithZeroHom_eq_ord (mem_nonZeroDivisors_iff_ne_zero.mpr hx),
        ord_ringEquiv]

/--
**Order of vanishing on fraction fields is natural under ring isomorphisms.**

Let `R`, `S` be Noetherian domains of Krull dimension at most one with fraction fields `K`,
`L`, let `φ : S ≃+* R` be a ring isomorphism and `ψ : L →+* K` a ring homomorphism
compatible with `φ` (i.e. `ψ (algebraMap S L s) = algebraMap R K (φ s)`).  Then
`Ring.ordFrac R (ψ x) = Ring.ordFrac S x` for all `x : L`.
-/
lemma ordFrac_ringEquiv
    {R S : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R] [Ring.KrullDimLE 1 R]
    [CommRing S] [IsDomain S] [IsNoetherianRing S] [Ring.KrullDimLE 1 S]
    {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
    {L : Type*} [Field L] [Algebra S L] [IsFractionRing S L]
    (φ : S ≃+* R) (ψ : L →+* K)
    (hψ : ∀ s, ψ (algebraMap S L s) = algebraMap R K (φ s)) :
    ∀ x, Ring.ordFrac R (ψ x) = Ring.ordFrac S x := by
  intro x
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective S x
  by_cases ha : a = 0
  · subst ha; simp
  · have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
    have hpa : φ a ≠ 0 := fun h => ha (φ.injective (by simpa using h))
    have hpb : φ b ≠ 0 := fun h => hb0 (φ.injective (by simpa using h))
    rw [map_div₀ ψ, hψ a, hψ b,
        map_div₀ (Ring.ordFrac (K := K) R), map_div₀ (Ring.ordFrac (K := L) S),
        Ring.ordFrac_eq_ord (K := K) R hpa, Ring.ordFrac_eq_ord (K := K) R hpb,
        ordMonoidWithZeroHom_ringEquiv φ a, ordMonoidWithZeroHom_ringEquiv φ b,
        ← Ring.ordFrac_eq_ord (K := L) S ha, ← Ring.ordFrac_eq_ord (K := L) S hb0]

/--
The canonical map from the stalk at a point to the function field, given by specialization
towards the generic point.
-/
noncomputable def specFF (X : Scheme) [IrreducibleSpace X] (z : X) :
    X.presheaf.stalk z ⟶ X.functionField :=
  X.presheaf.stalkSpecializes ((genericPoint_spec X).specializes (Set.mem_univ z))

/-- `algebraMap` from a stalk to the function field is `specFF`. -/
lemma specFF_hom (X : Scheme) [IrreducibleSpace X] (z : X) :
    (specFF X z).hom = algebraMap (X.presheaf.stalk z) X.functionField := by
  rw [specFF]
  exact (RingHom.algebraMap_toAlgebra _).symm

/--
**The map `ffMap` is compatible with the specialization maps into the function field.**
-/
theorem specFF_ffMap {X Y : Scheme} [IrreducibleSpace X] [IrreducibleSpace Y]
    (e : X ≅ Y) (z : X) :
    specFF Y (e.hom.base z) ≫ ffMap e = e.hom.stalkMap z ≫ specFF X z := by
  rw [specFF, ffMap,
    show (Y.presheaf.stalkCongr (Inseparable.of_eq (iso_genericPoint e).symm)).hom
        = Y.presheaf.stalkSpecializes
            (Inseparable.of_eq (iso_genericPoint e).symm).specializes'
        from rfl]
  rw [← Category.assoc, Presheaf.stalkSpecializes_comp]
  rw [show (Inseparable.of_eq (iso_genericPoint e).symm).specializes'.trans
        ((genericPoint_spec Y).specializes (Set.mem_univ (e.hom.base z)))
      = e.hom.base.hom.map_specializes ((genericPoint_spec X).specializes (Set.mem_univ z))
      from Subsingleton.elim _ _]
  exact Scheme.Hom.stalkSpecializes_stalkMap e.hom (genericPoint X) z
    ((genericPoint_spec X).specializes (Set.mem_univ z))

/-- The stalk map of an isomorphism of schemes at a point is bijective. -/
lemma stalkMap_bijective {X Y : Scheme} (e : X ≅ Y) (z : X) :
    Function.Bijective (e.hom.stalkMap z).hom := by
  set φ := e.hom.stalkMap z
  set φ' := e.hom.stalkMap (e.inv (e.hom.base z))
  set ι := e.inv.stalkMap (e.hom.base z)
  have happ1 : ∀ t, (ι ≫ φ).hom t = φ.hom (ι.hom t) := fun t => rfl
  have happ2 : ∀ t, (φ' ≫ ι).hom t = ι.hom (φ'.hom t) := fun t => rfl
  have h1 : Function.Bijective (ι ≫ φ).hom := by
    rw [Scheme.Hom.stalkMap_inv_hom e z]
    exact ConcreteCategory.bijective_of_isIso _
  have h2 : Function.Bijective (φ' ≫ ι).hom := by
    rw [Scheme.Hom.stalkMap_hom_inv e (e.hom.base z)]
    exact ConcreteCategory.bijective_of_isIso _
  have hinj : Function.Injective ι.hom := fun a b hab => h1.1 (by rw [happ1, happ1, hab])
  have hsurj : Function.Surjective ι.hom := fun y => by
    obtain ⟨x, hx⟩ := h2.2 y
    exact ⟨φ'.hom x, by rw [← hx, happ2]⟩
  have : IsIso ι := (ConcreteCategory.isIso_iff_bijective ι).mpr ⟨hinj, hsurj⟩
  have hφ : φ = inv ι ≫ (ι ≫ φ) := by
    rw [← Category.assoc, IsIso.inv_hom_id, Category.id_comp]
  have : IsIso φ := hφ ▸ inferInstance
  exact ConcreteCategory.bijective_of_isIso φ

/-- **Order of vanishing is transported along an isomorphism of schemes.**  For an isomorphism
`e : X ≅ Y` of integral locally Noetherian schemes and the induced ring homomorphism
`ffMap e : Y.functionField ⟶ X.functionField` of function fields (`Work.SpecLin.Alt.ffMap`,
the stalk map of `e.hom` at the generic point), the order of vanishing of `f` at `e z` on `Y`
equals the order of vanishing of `ffMap e f` at `z` on `X`. -/
theorem ordIso {X Y : AlgebraicGeometry.Scheme} [AlgebraicGeometry.IsIntegral X]
    [AlgebraicGeometry.IsLocallyNoetherian X] [AlgebraicGeometry.IsIntegral Y]
    [AlgebraicGeometry.IsLocallyNoetherian Y] (e : X ≅ Y) (f : Y.functionField) (z : X) :
    X.ord (Work.SpecLin.Alt.ffMap e f) z = Y.ord f (e.hom.base z) := by
  by_cases hz : Order.coheight z = 1
  · have hz' : Order.coheight (e.hom.base z) = 1 := by
      rw [coheight_eq_of_isOpenImmersion e.hom, hz]
    have hR : Ring.KrullDimLE 1 (X.presheaf.stalk z) := krullDimLE_of_coheight_le hz.le
    have hS : Ring.KrullDimLE 1 (Y.presheaf.stalk (e.hom.base z)) :=
      krullDimLE_of_coheight_le hz'.le
    have hmain : X.ordHom z hz (ffMap e f) = Y.ordHom (e.hom.base z) hz' f := by
      have hbij : Function.Bijective (e.hom.stalkMap z).hom := stalkMap_bijective e z
      have hψ : ∀ s : Y.presheaf.stalk (e.hom.base z),
          (ffMap e).hom (algebraMap (Y.presheaf.stalk (e.hom.base z)) Y.functionField s)
            = algebraMap (X.presheaf.stalk z) X.functionField ((e.hom.stalkMap z).hom s) := by
        intro s
        have hsq := specFF_ffMap e z
        have h1 := congrArg (fun (g : Y.presheaf.stalk (e.hom.base z) ⟶ X.functionField) =>
          g.hom s) hsq
        simpa [specFF, RingHom.algebraMap_toAlgebra, RingHom.comp_apply] using h1
      have hkey := ordFrac_ringEquiv (RingEquiv.ofBijective (e.hom.stalkMap z).hom hbij)
        (ffMap e).hom hψ f
      simpa [AlgebraicGeometry.Scheme.ordHom] using hkey
    rw [AlgebraicGeometry.Scheme.ord_eq_ordHom_of_coheight_eq_one hz,
      AlgebraicGeometry.Scheme.ord_eq_ordHom_of_coheight_eq_one hz', hmain]
  · have hz' : Order.coheight (e.hom.base z) ≠ 1 := by
      rw [coheight_eq_of_isOpenImmersion e.hom]; exact hz
    rw [AlgebraicGeometry.Scheme.ord_eq_zero_of_coheight_neq_one hz,
      AlgebraicGeometry.Scheme.ord_eq_zero_of_coheight_neq_one hz']

end Work.SpecLin.Alt
