/-
# The section ideal is locally principal at a closed point of the special fibre

For a curve `C` over a field `K`, a `K`-valuation ring `R`, an affine open chart `W ⊆ C`, the
relative chart `B = Γ(C,W) ⊗_K R`, its fibre prime `P = chartFibrePrime R W = m_R·B` and a
maximal ideal `N ⊇ P` of `B`, the extension of the section ideal `I = sectionPrime R W φ` to
the localisation `B_N` is principal.

## Proof

Write `O = B_N`, `I' = I·O`, `P' = P·O` and `J = m_R·O` (so `P' = J` by `Ideal.map_map`).

* If `I ⊄ N`, then some `x ∈ I` is not in `N`; its image in `O` is a unit, so `I' = O` and the
  unit ideal is principal (`isPrincipal_map_localization_of_not_le`).
* If `I ≤ N`, then `N = I ⊔ P` (`sectionPrime_sup_fibrePrime_eq_of_le`), and we apply Nakayama in
  the form `Work.SpecLin.Content.isPrincipal_of_fg_of_cyclic_map_quotient` at `O` with the ideal
  `I'`:
  * `I'` is finitely generated because `I` is (`Work.SpecLin.Alt.fg_ker_tensorLift`, using that
    `Γ(C,W)` is a finitely generated `K`-algebra);
  * `I' ⊓ P' = P'·I'`: this is `Work.SpecLin.Alt.inf_ker_eq_mul` (the retraction `B → R` makes
    `I ⊓ P = P·I`) together with `IsLocalization.map_inf`;
  * `I' ⊔ P' = m_O` because `I ⊔ P = N`;
  * the cyclicity of `I'/(J·I')`: `m_O` is generated by one element `u` modulo `P'`
    (`Work.SpecLin.Alt.exists_span_singleton_sup_chartFibrePrime_localization`, the "local
    equation of the special fibre": `B_N ⧸ P·B_N` is the local ring of the smooth curve `C_κ` at
    a closed point, hence a discrete valuation ring); writing `u = y + j` with `y ∈ I'`,
    `j ∈ P'` and using `I' ⊓ P' = P'·I'` gives `I' = span {y} ⊔ J·I'`, so the image of `I'` in
    `O ⧸ (J·I')` is generated by the image of `y`.

With `IsLocalHom (algebraMap R O)` (from `P ≤ N`) the Nakayama input applies and `I'` is
principal.
-/

import Mathlib
import Submission.Work.SpecLin.Core.linEquiv_of_sections_of_chart
import Submission.Work.SpecLin.Content.isPrincipal_of_fg_of_cyclic_map_quotient
import Submission.Work.SpecLin.Core.section_prime_sup_fibre_quot
import Submission.Work.SpecLin.Core.module_free_chartTensor
import Submission.Work.CurveBasics.All
import Submission.Work.SpecLin.Alt.sectionPrime_sup_fibrePrime_eq_of_le
import Submission.Work.CurveBasics.Order.finiteDimensional_adjoin_functionField
import Submission.Work.SpecLin.Alt.fg_ker_tensorLift
import Submission.Work.SpecLin.Alt.inf_ker_eq_mul
import Submission.Work.SpecLin.Alt.exists_span_singleton_sup_chartFibrePrime_localization

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


universe u

namespace Work.SpecLin.Alt

open scoped TensorProduct

set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

section CaseTwo

variable {K : Type u} [Field K] {C : Work.CurveBasics.Curve K}

/-- Case `sectionPrime ≤ N` of the local principality statement. -/
theorem isPrincipal_map_localization_of_le
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Algebra K R]
    (W : C.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) [Nonempty W]
    (φ : C.left.presheaf.obj (Opposite.op W) →ₐ[K] R)
    (N : Ideal (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)) [N.IsMaximal]
    (hPN : Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W ≤ N)
    (hIN : Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ ≤ N) :
    Submodule.IsPrincipal
      ((Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ).map
        (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
          (Localization.AtPrime N))) := by
  classical
  letI : Algebra R (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W) :=
    Algebra.TensorProduct.rightAlgebra (R := K) (A := C.left.presheaf.obj (Opposite.op W)) (B := R)
  haveI hftA : Algebra.FiniteType K (C.left.presheaf.obj (Opposite.op W)) :=
    Work.CurveBasics.Order.algebra_finiteType_sections C hW
  set I : Ideal (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W) :=
    Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ with hI
  set P : Ideal (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W) :=
    Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W with hP
  set I' : Ideal (Localization.AtPrime N) :=
    I.map (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
      (Localization.AtPrime N)) with hI'
  set P' : Ideal (Localization.AtPrime N) :=
    P.map (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
      (Localization.AtPrime N)) with hP'
  set J : Ideal (Localization.AtPrime N) :=
    (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime N)) with hJ
  -- `N = I ⊔ P`
  have hIP : I ⊔ P = N := by
    rw [hI, hP]
    exact Work.SpecLin.Alt.sectionPrime_sup_fibrePrime_eq_of_le R W hW φ N hPN hIN
  -- `I` is finitely generated
  have hFG : I.FG := by
    rw [hI]
    exact Work.SpecLin.Alt.fg_ker_tensorLift (K := K) (A := C.left.presheaf.obj (Opposite.op W))
      (R := R) φ
  -- `P·B_N` is the extension of the maximal ideal of `R`
  have hunf : Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W
      = (IsLocalRing.maximalIdeal R).map
        (↑(Algebra.TensorProduct.includeRight (R := K)
            (A := C.left.presheaf.obj (Opposite.op W)) (B := R)) :
          R →+* Work.SpecLin.Core.chartTensor (K := K) (C := C) R W) := rfl
  have hco : (algebraMap R (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W) :
        R →+* Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
      = (↑(Algebra.TensorProduct.includeRight (R := K)
            (A := C.left.presheaf.obj (Opposite.op W)) (B := R)) :
          R →+* Work.SpecLin.Core.chartTensor (K := K) (C := C) R W) := rfl
  have hPJ : P' = J := by
    have key : (algebraMap R (Localization.AtPrime N))
        = (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
            (Localization.AtPrime N)).comp
          (algebraMap R (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)) :=
      IsScalarTower.algebraMap_eq R _ _
    rw [hP', hJ, key, hP, hunf, Ideal.map_map, ← hco]
  -- `I ⊓ P = P * I`
  have hS1 : I ⊓ P = P * I := by
    rw [hI, hP]
    exact Work.SpecLin.Alt.inf_ker_eq_mul (K := K) (A := C.left.presheaf.obj (Opposite.op W))
      (R := R) φ (IsLocalRing.maximalIdeal R)
  -- `I' ⊓ P' = P' * I'`
  have hinf : I' ⊓ P' = P' * I' := by
    rw [hI', hP', ← IsLocalization.map_inf N.primeCompl (Localization.AtPrime N) I P, hS1,
      Ideal.map_mul]
  -- `I' ⊔ P' = m_O`
  have hsup : I' ⊔ P' = IsLocalRing.maximalIdeal (Localization.AtPrime N) := by
    rw [hI', hP', ← Ideal.map_sup, hIP,
      Localization.AtPrime.map_eq_maximalIdeal]
  -- a local equation of the special fibre at `N`
  obtain ⟨u, hu⟩ :=
    Work.SpecLin.Alt.exists_span_singleton_sup_chartFibrePrime_localization R W hW N hPN
  rw [← hP'] at hu
  -- a generator of `I'` modulo `P' * I'`
  have hu_mem : u ∈ I' ⊔ P' := by
    rw [hsup, hu]
    exact Submodule.mem_sup_left (Ideal.mem_span_singleton_self u)
  obtain ⟨y, hyI, j, hjP, hyj⟩ := Submodule.mem_sup.mp hu_mem
  have hkey : I' = Ideal.span {y} ⊔ P' * I' := by
    refine le_antisymm ?_ (sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hyI))
      Ideal.mul_le_right)
    intro x hx
    have hxO : x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime N) := by
      rw [← hsup]; exact Ideal.mem_sup_left hx
    have hx' : x ∈ Ideal.span {u} ⊔ P' := by
      rw [← hu]; exact hxO
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hx'
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ha
    have hxmem : x - y * c ∈ I' ⊓ P' := by
      refine ⟨sub_mem hx (Ideal.mul_mem_right c I' hyI), ?_⟩
      have h1 : x - y * c = c * j + b := by
        rw [← hab, ← hc, ← hyj]; ring
      rw [h1]
      exact add_mem (Ideal.mul_mem_left P' c hjP) hb
    rw [hinf] at hxmem
    exact Submodule.mem_sup.mpr ⟨y * c, Ideal.mem_span_singleton'.mpr ⟨c, by ring⟩,
      x - y * c, hxmem, by ring⟩
  have hkeyJ : I' = Ideal.span {y} ⊔ J * I' := by
    conv_lhs => rw [hkey]
    rw [hPJ]
  -- the image of `I'` in `O ⧸ (J * I')` is principal
  have hcyc : (I'.map (Ideal.Quotient.mk (J * I'))).IsPrincipal := by
    refine ⟨Ideal.Quotient.mk (J * I') y, ?_⟩
    refine le_antisymm ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      show Ideal.Quotient.mk (J * I') x ∈ Ideal.span {Ideal.Quotient.mk (J * I') y}
      have hx' : x ∈ Ideal.span {y} ⊔ J * I' := by rw [← hkeyJ]; exact hx
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hx'
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ha
      have hb0 : Ideal.Quotient.mk (J * I') b = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb
      have hsplit : Ideal.Quotient.mk (J * I') x
          = Ideal.Quotient.mk (J * I') c * Ideal.Quotient.mk (J * I') y := by
        rw [← hab, ← hc]
        simp only [map_add, map_mul, hb0, add_zero]
      rw [hsplit]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ hyI
  -- the local ring homomorphism `R → B_N`
  haveI hloc : IsLocalHom (algebraMap R (Localization.AtPrime N)) := by
    refine (IsLocalRing.local_hom_TFAE (algebraMap R (Localization.AtPrime N))).out 3 1 |>.mp ?_
    rw [← hJ, ← hPJ, hP', ← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono hPN
  -- Nakayama
  have hfg' : I'.FG := by rw [hI']; exact hFG.map _
  exact Work.SpecLin.Content.isPrincipal_of_fg_of_cyclic_map_quotient (R := R)
    (O := Localization.AtPrime N) I' hfg' hcyc

end CaseTwo

section CaseOne

variable {K : Type u} [Field K] {C : Work.CurveBasics.Curve K}

/-- Case `¬ sectionPrime ≤ N`: the section does not pass through the point `N`, so its equation is
a unit of `B_N` and the extension of the section ideal is the unit ideal. -/
theorem isPrincipal_map_localization_of_not_le
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Algebra K R]
    (W : C.left.Opens) (_hW : AlgebraicGeometry.IsAffineOpen W) [Nonempty W]
    (φ : C.left.presheaf.obj (Opposite.op W) →ₐ[K] R)
    (N : Ideal (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)) [N.IsMaximal]
    (_hPN : Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W ≤ N)
    (hIN : ¬ Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ ≤ N) :
    Submodule.IsPrincipal
      ((Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ).map
        (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
          (Localization.AtPrime N))) := by
  classical
  have hex : ∃ x ∈ Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ, x ∉ N := by
    by_contra h
    exact hIN fun y hy => by_contra fun hyN => h ⟨y, hy, hyN⟩
  obtain ⟨x, hxI, hxN⟩ := hex
  have hunit : IsUnit (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
      (Localization.AtPrime N) x) :=
    IsLocalization.map_units (Localization.AtPrime N)
      ⟨x, Ideal.mem_primeCompl_iff.mpr hxN⟩
  have htop : (Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ).map
      (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
        (Localization.AtPrime N)) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hxI) hunit
  rw [htop]
  exact ⟨1, (Ideal.span_singleton_one (α := Localization.AtPrime N)).symm⟩

end CaseOne

/-- **The section ideal is locally principal at a closed point of the special fibre.**

In the affine chart, for a maximal ideal `N` containing the fibre prime `P`, the extension of the
section ideal `I_m = ker(B →_K R)` to the localisation `B_N` is principal.  (This is the
"local equation" of the section at the point of the special fibre; the equation is the
"Cartier" input of the reading-off step.) -/
theorem isPrincipal_sectionPrime_localization {K : Type u} [Field K]
    {C : Work.CurveBasics.Curve K}
    (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Algebra K R]
    (W : C.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) [Nonempty W]
    (φ : C.left.presheaf.obj (Opposite.op W) →ₐ[K] R)
    (N : Ideal (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)) [N.IsMaximal]
    (hPN : Work.SpecLin.Core.chartFibrePrime (K := K) (C := C) R W ≤ N) :
    Submodule.IsPrincipal
      ((Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ).map
        (algebraMap (Work.SpecLin.Core.chartTensor (K := K) (C := C) R W)
          (Localization.AtPrime N))) := by
  by_cases hIN : Work.SpecLin.Core.sectionPrime (K := K) (C := C) R W φ ≤ N
  · exact Work.SpecLin.Alt.isPrincipal_map_localization_of_le R W hW φ N hPN hIN
  · exact Work.SpecLin.Alt.isPrincipal_map_localization_of_not_le R W hW φ N hPN hIN

end Work.SpecLin.Alt
