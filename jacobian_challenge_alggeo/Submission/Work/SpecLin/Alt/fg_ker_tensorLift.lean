import Mathlib

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


open scoped TensorProduct

namespace Work.SpecLin.Alt

/-- For a finitely generated `K`-algebra `A` and any `K`-algebra `R`, the kernel of the
multiplication map `A ⊗[K] R → R`, `a ⊗ r ↦ φ a * r`, is a finitely generated ideal of
`A ⊗[K] R`.

The kernel is generated by the finitely many elements `a ⊗ 1 - 1 ⊗ φ a` for `a` running over
a finite `K`-algebra generating set of `A`. -/
theorem fg_ker_tensorLift {K : Type _} [CommRing K] {A : Type _} [CommRing A] [Algebra K A]
    [Algebra.FiniteType K A] {R : Type _} [CommRing R] [Algebra K R] (φ : A →ₐ[K] R) :
    (RingHom.ker (Algebra.TensorProduct.lift φ (AlgHom.id K R)
      (fun _ _ => Commute.all _ _))).FG := by
  classical
  obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := K) (A := A)
  set π : A ⊗[K] R →ₐ[K] R :=
    Algebra.TensorProduct.lift φ (AlgHom.id K R) (fun _ _ => Commute.all _ _) with hπ
  set I : Ideal (A ⊗[K] R) :=
    Ideal.span ((fun a : A => a ⊗ₜ[K] 1 - 1 ⊗ₜ[K] φ a) '' (↑t : Set A)) with hI
  -- The generators lie in the kernel.
  have hI_le : I ≤ RingHom.ker π := by
    rw [hI, Ideal.span_le]
    rintro x ⟨a, ha, rfl⟩
    change π (a ⊗ₜ[K] 1 - 1 ⊗ₜ[K] φ a) = 0
    rw [hπ, map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul]
    simp
  -- Every `a : A` satisfies `a ⊗ 1 - 1 ⊗ φ a ∈ I`: it suffices to check the generators of `A`,
  -- which is an equalizer argument in the quotient `(A ⊗[K] R) ⧸ I`.
  have hstar : ∀ a : A, a ⊗ₜ[K] 1 - 1 ⊗ₜ[K] φ a ∈ I := by
    intro a
    set q : (A ⊗[K] R) →ₐ[K] (A ⊗[K] R) ⧸ I := Ideal.Quotient.mkₐ K I with hq
    set α : A →ₐ[K] (A ⊗[K] R) ⧸ I :=
      q.comp (Algebra.TensorProduct.includeLeft : A →ₐ[K] A ⊗[K] R) with hα
    set β : A →ₐ[K] (A ⊗[K] R) ⧸ I :=
      q.comp ((Algebra.TensorProduct.includeRight : R →ₐ[K] A ⊗[K] R).comp φ) with hβ
    have hle : Algebra.adjoin K (↑t : Set A) ≤ AlgHom.equalizer α β := by
      rw [Algebra.adjoin_le_iff]
      intro b hb
      change α b = β b
      have hmem : b ⊗ₜ[K] 1 - 1 ⊗ₜ[K] φ b ∈ I := by
        rw [hI]
        exact Ideal.subset_span ⟨b, hb, rfl⟩
      rw [hα, hβ, hq]
      simp only [AlgHom.comp_apply, Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.includeRight_apply, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      exact hmem
    have htop : AlgHom.equalizer α β = ⊤ := eq_top_iff.mpr (ht ▸ hle)
    have heq : α a = β a := by
      have : a ∈ AlgHom.equalizer α β := by rw [htop]; trivial
      exact (AlgHom.mem_equalizer α β a).mp this
    rw [hα, hβ, hq] at heq
    simp only [AlgHom.comp_apply, Algebra.TensorProduct.includeLeft_apply,
      Algebra.TensorProduct.includeRight_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.mk_eq_mk_iff_sub_mem] at heq
    exact heq
  -- `x` and `1 ⊗ π x` agree modulo `I`, by additivity and `hstar`.
  have hmain : ∀ x : A ⊗[K] R,
      x - (Algebra.TensorProduct.includeRight : R →ₐ[K] A ⊗[K] R) (π x) ∈ I := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul a r =>
      have h1 : π (a ⊗ₜ[K] r) = φ a * r := by
        rw [hπ, Algebra.TensorProduct.lift_tmul]; simp
      rw [h1, Algebra.TensorProduct.includeRight_apply]
      have h2 : (a ⊗ₜ[K] 1 - 1 ⊗ₜ[K] φ a) * (1 ⊗ₜ[K] r)
          = a ⊗ₜ[K] r - 1 ⊗ₜ[K] (φ a * r) := by
        rw [sub_mul, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul]
        simp
      rw [← h2]
      exact I.mul_mem_right _ (hstar a)
    | add x y hx hy =>
      have h1 : π (x + y) = π x + π y := map_add π x y
      have h2 : (Algebra.TensorProduct.includeRight : R →ₐ[K] A ⊗[K] R) (π x + π y)
          = (Algebra.TensorProduct.includeRight : R →ₐ[K] A ⊗[K] R) (π x)
            + (Algebra.TensorProduct.includeRight : R →ₐ[K] A ⊗[K] R) (π y) := map_add _ _ _
      rw [h1, h2]
      convert I.add_mem hx hy using 1
      ring
  have hker_le : RingHom.ker π ≤ I := by
    intro x hx
    rw [RingHom.mem_ker] at hx
    have h := hmain x
    rw [hx, map_zero, sub_zero] at h
    exact h
  have hker : RingHom.ker π = I := le_antisymm hker_le hI_le
  have hIfg : I.FG := by
    rw [hI]
    exact ⟨t.image (fun a : A => a ⊗ₜ[K] 1 - 1 ⊗ₜ[K] φ a), by rw [Finset.coe_image]⟩
  rw [hker]
  exact hIfg

end Work.SpecLin.Alt
