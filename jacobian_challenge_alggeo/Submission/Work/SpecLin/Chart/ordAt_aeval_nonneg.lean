import Mathlib
import Submission.Work.CurveBasics.All
import Submission.Work.CurveBasics.Place.mem_valuationSubring_iff

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


namespace Work.SpecLin.Chart

open CategoryTheory AlgebraicGeometry

/-- If a rational function `x₀` on a curve is regular at a place `Q`, then any polynomial in
`x₀` is regular at `Q`: the rational functions of nonnegative order at `Q` form a subring. -/
theorem ordAt_aeval_nonneg {K : Type*} [Field K] (C : Work.CurveBasics.Curve K) (Q : C.Place)
    {x₀ : C.functionField} (hx : 0 ≤ C.ordAt x₀ Q) (g : Polynomial K) :
    0 ≤ C.ordAt (Polynomial.aeval x₀ g) Q := by
  -- Regularity of `x₀` at `Q` means membership in the valuation subring of `K(C)` at `Q`.
  have hxmem : x₀ ∈ Q.valuationSubring :=
    (Work.CurveBasics.Place.mem_valuationSubring_iff C Q x₀).mpr hx
  -- The functions regular at `Q` form a `K`-subalgebra of `K(C)`: a subring (the valuation
  -- subring) that contains all constants.
  let S : Subalgebra K C.functionField := Subalgebra.mk
    (Q.valuationSubring.toSubring.toSubsemiring)
    (fun r => (Work.CurveBasics.Place.mem_valuationSubring_iff C Q _).mpr (by
      change (0 : ℤ) ≤ C.ordAt (algebraMap K C.functionField r) Q
      rw [Work.CurveBasics.Order.ordAt_algebraMap_eq_zero]))
  -- Hence it contains the `K`-subalgebra generated by `x₀`, and in particular `g(x₀)`.
  have hle : Algebra.adjoin K ({x₀} : Set C.functionField) ≤ S :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr hxmem)
  have hmem : Polynomial.aeval x₀ g ∈ S :=
    hle (Polynomial.aeval_mem_adjoin_singleton K x₀ (p := g))
  exact (Work.CurveBasics.Place.mem_valuationSubring_iff C Q _).mp hmem

end Work.SpecLin.Chart
