import Mathlib
import Submission.Work.SpecLin.Core.chartVocab

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


namespace Work.SpecLin.Alt
namespace Up

/-- If the extension of `I` to the localization at a maximal ideal `N` is the principal ideal
generated by `f`, then for every prime `q ≤ N`, the element `f` lies in `q` exactly when
`I ≤ q`.

The point is that localization at `N` is a further localization of localization at `q`
(since `q ≤ N`), so `I B_q = (f) B_q`, and `I ≤ q ↔ I B_q ≤ q B_q ↔ f/1 ∈ q B_q ↔ f ∈ q`. -/
theorem mem_iff_le_of_span_map_eq {B : Type _} [CommRing B] [IsDomain B]
    (N : Ideal B) [N.IsMaximal]
    (I : Ideal B) (f : B) (q : Ideal B) (hq : q.IsPrime) (hqN : q ≤ N)
    (hgen : I.map (algebraMap B (Localization.AtPrime N))
      = Ideal.span {algebraMap B (Localization.AtPrime N) f}) :
    (f ∈ q ↔ I ≤ q) := by
  -- Every element of `N.primeCompl` is outside `q`, because `q ≤ N`.
  have hdisj : ∀ m ∈ N.primeCompl, m ∉ q := by
    intro m hm hmq
    rw [Ideal.mem_primeCompl_iff] at hm
    exact hm (hqN hmq)
  constructor
  · -- If `f ∈ q`, then `(f) ⊆ q` after localization, hence `I B_N ⊆ q B_N`, whence `I ≤ q`.
    intro hfq x hxI
    have hx : algebraMap B (Localization.AtPrime N) x
        ∈ I.map (algebraMap B (Localization.AtPrime N)) :=
      Ideal.mem_map_of_mem _ hxI
    rw [hgen] at hx
    have hfmem : algebraMap B (Localization.AtPrime N) f
        ∈ q.map (algebraMap B (Localization.AtPrime N)) :=
      Ideal.mem_map_of_mem _ hfq
    have hspan_le : Ideal.span {algebraMap B (Localization.AtPrime N) f}
        ≤ q.map (algebraMap B (Localization.AtPrime N)) :=
      Ideal.span_le.mpr (by rintro y rfl; exact hfmem)
    have hxqmap : algebraMap B (Localization.AtPrime N) x
        ∈ q.map (algebraMap B (Localization.AtPrime N)) := hspan_le hx
    obtain ⟨m, hm, hmx⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff N.primeCompl
        (Localization.AtPrime N) q x).mp hxqmap
    rcases hq.mem_or_mem hmx with h | h
    · exact absurd h (hdisj m hm)
    · exact h
  · -- If `I ≤ q`, then `φ f ∈ I B_N = (φ f)`, so `m * f ∈ I ≤ q` for some `m ∉ N`,
    -- and `m ∉ q` since `q ≤ N`, so `f ∈ q`.
    intro hIq
    have hfmem : algebraMap B (Localization.AtPrime N) f
        ∈ I.map (algebraMap B (Localization.AtPrime N)) := by
      rw [hgen]; exact Ideal.mem_span_singleton_self _
    obtain ⟨m, hm, hmf⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff N.primeCompl
        (Localization.AtPrime N) I f).mp hfmem
    rcases hq.mem_or_mem (hIq hmf) with h | h
    · exact absurd h (hdisj m hm)
    · exact h

end Up
end Work.SpecLin.Alt

