/-
# The point of the generic fibre attached to a height-one prime of the relative chart

For a curve `C` over a field `K`, a `K`-valuation ring `R` with fraction field `F = Frac R` and
an affine open chart `W ⊆ C` with coordinate ring `A = Γ(C,W)`, let

* `B = A ⊗_K R` be the coordinate ring of the relative chart (`Core.chartTensor`),
* `S = Γ(C_F, W_F)` the coordinate ring of the chart `W_F = C.bcOpens F W` of the generic fibre,

and let `p ⊆ B` be a prime with `p ∩ R = 0` (i.e. `p` contains no non-zero element of `R`).
Then `p` generates a prime `p' = p·S ⊆ S`, and - when `p` has height one - the point of `S`
corresponding to `p'` is a *closed* point of `C_F` lying in `W_F`.

This file sets up that point together with the basic bookkeeping about `p'`.
-/
import Mathlib
import Submission.Work.SpecLin.Up.Alt.chartMap
import Submission.Work.SpecLin.Up.Alt.chartTensorMap_isFractionRing
import Submission.Work.SpecLin.Up.Alt.isLocalization_chartTensorSectionsMap
import Submission.Work.CurveBasics.BaseChange.isAffineOpen_bcOpens
import Submission.Work.CurveBasics.BaseChange.mem_range_germ_iff

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


set_option autoImplicit false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000
set_option linter.unusedSectionVars false

universe u

open CategoryTheory Limits AlgebraicGeometry
open scoped TensorProduct

namespace Work.SpecLin.Alt
namespace Up

variable {K : Type u} [Field K] {C : Work.CurveBasics.Curve K}

/-- The coordinate ring `Γ(C_F, W_F)` of the chart `W_F = C.bcOpens F W` of the generic
fibre of the curve `C` along `K → F = FractionRing R`. -/
abbrev chartSections (R : Type u) [CommRing R] [IsDomain R] [Algebra K R]
    (W : C.left.Opens) : Type u :=
  Γ((C.baseChange (FractionRing R)).left, C.bcOpens (FractionRing R) W)

/-- The submonoid of `B = Γ(C,W) ⊗_K R` generated by the images of the non-zero divisors
of the valuation ring `R`: the elements of `B` which become invertible in `Γ(C_F, W_F)`. -/
noncomputable abbrev chartContentSubmonoid (R : Type u) [CommRing R] [IsDomain R]
    [ValuationRing R] [Algebra K R] (W : C.left.Opens) :
    Submonoid (Work.SpecLin.Core.chartTensor R W) :=
  (nonZeroDivisors R).map
    (Algebra.TensorProduct.includeRight (R := K) (A := Γ(C.left, W)) (B := R))

/-- The image `p' = p·S` of a prime `p` of the relative chart `B` in the coordinate ring of
the chart of the generic fibre. -/
noncomputable abbrev chartTensorPrime (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    [Algebra K R] (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) : Ideal (chartSections R W) :=
  Ideal.map (chartTensorSectionsMap R W hW) p

variable (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Algebra K R]

/-- The non-zero divisors of `R` are disjoint from a prime of `B` which misses the image of
`R ∖ {0}`. -/
theorem chartContentSubmonoid_disjoint (W : C.left.Opens)
    (p : Ideal (Work.SpecLin.Core.chartTensor R W))
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    Disjoint ((chartContentSubmonoid (K := K) (C := C) R W : Submonoid _) : Set _)
      (p : Set (Work.SpecLin.Core.chartTensor R W)) := by
  rw [Set.disjoint_left]
  intro x hx hxp
  have hx' : x ∈ Submonoid.map
      (Algebra.TensorProduct.includeRight (R := K) (A := Γ(C.left, W)) (B := R))
      (nonZeroDivisors R) := hx
  rw [Submonoid.mem_map] at hx'
  obtain ⟨m, hm, rfl⟩ := hx'
  exact hmiss m (mem_nonZeroDivisors_iff_ne_zero.mp hm) hxp

/-- `p·S` is prime whenever `p` misses the image of `R ∖ {0}`: the extension of a prime along
a localisation at a submonoid disjoint from it. -/
theorem chartTensorPrime_isPrime (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    (chartTensorPrime R W hW p).IsPrime := by
  letI : Algebra (Work.SpecLin.Core.chartTensor R W) (chartSections R W) :=
    (chartTensorSectionsMap R W hW).toAlgebra
  haveI : IsLocalization (chartContentSubmonoid (K := K) (C := C) R W) (chartSections R W) :=
    isLocalization_chartTensorSectionsMap R W hW
  exact IsLocalization.isPrime_of_isPrime_disjoint _ (chartSections R W) p hp
    (chartContentSubmonoid_disjoint R W p hmiss)

/-- Localisation at a submonoid disjoint from `p` does not change the height: the height of
`p' = p·S` in the chart of the generic fibre equals the height of `p`. -/
theorem chartTensorPrime_height (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    (chartTensorPrime R W hW p).height = p.height := by
  letI : Algebra (Work.SpecLin.Core.chartTensor R W) (chartSections R W) :=
    (chartTensorSectionsMap R W hW).toAlgebra
  haveI : IsLocalization (chartContentSubmonoid (K := K) (C := C) R W) (chartSections R W) :=
    isLocalization_chartTensorSectionsMap R W hW
  have h := IsLocalization.height_map_of_disjoint
    (S := chartSections R W)
    (chartContentSubmonoid (K := K) (C := C) R W)
    p (chartContentSubmonoid_disjoint R W p hmiss)
  change (Ideal.map (chartTensorSectionsMap R W hW) p).height = p.height
  exact h

/-- The contraction of `p' = p·S` back to `B` is `p`. -/
theorem chartTensorPrime_comap (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    Ideal.comap (chartTensorSectionsMap R W hW) (chartTensorPrime R W hW p) = p := by
  letI : Algebra (Work.SpecLin.Core.chartTensor R W) (chartSections R W) :=
    (chartTensorSectionsMap R W hW).toAlgebra
  haveI : IsLocalization (chartContentSubmonoid (K := K) (C := C) R W) (chartSections R W) :=
    isLocalization_chartTensorSectionsMap R W hW
  have h := IsLocalization.under_map_of_isPrime_disjoint (S := chartSections R W)
    (chartContentSubmonoid (K := K) (C := C) R W)
    hp (chartContentSubmonoid_disjoint R W p hmiss)
  change Ideal.comap (chartTensorSectionsMap R W hW)
    (Ideal.map (chartTensorSectionsMap R W hW) p) = p
  exact h

/-- The preimage `W_F = C.bcOpens F W` of an affine open chart of `C` in the generic fibre
`C_F` is affine. -/
theorem chartAffineOpen (W : C.left.Opens) (hW : IsAffineOpen W) :
    IsAffineOpen (C.bcOpens (FractionRing R) W) :=
  Work.CurveBasics.BaseChange.isAffineOpen_bcOpens (FractionRing R) W hW

/-- **The point of the generic fibre attached to a prime of the relative chart.**  The point of
the affine chart `W_F = C.bcOpens F W` whose prime ideal is the image `p' = p·S` of `p` in
`S = Γ(C_F, W_F)`. -/
noncomputable def chartTensorPoint (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    (C.baseChange (FractionRing R)).left :=
  (chartAffineOpen (K := K) (C := C) R W hW).fromSpec
    ⟨chartTensorPrime R W hW p, chartTensorPrime_isPrime R W hW p hp hmiss⟩

/-- The point attached to `p` lies in the chart `W_F`. -/
theorem chartTensorPoint_mem (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    chartTensorPoint R W hW p hp hmiss ∈ C.bcOpens (FractionRing R) W := by
  change chartTensorPoint R W hW p hp hmiss ∈ (C.bcOpens (FractionRing R) W : Set _)
  rw [← (chartAffineOpen (K := K) (C := C) R W hW).range_fromSpec]
  exact ⟨_, rfl⟩

/-- The prime of the chart `W_F` attached to the point of `p` is `p' = p·S`. -/
theorem chartTensorPoint_primeIdealOf_spectrum (W : C.left.Opens) (hW : IsAffineOpen W)
    [Nonempty W] (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    (chartAffineOpen (K := K) (C := C) R W hW).primeIdealOf
        ⟨chartTensorPoint R W hW p hp hmiss, chartTensorPoint_mem R W hW p hp hmiss⟩ =
      ⟨chartTensorPrime R W hW p, chartTensorPrime_isPrime R W hW p hp hmiss⟩ := by
  show (chartAffineOpen (K := K) (C := C) R W hW).isoSpec.hom
      ⟨chartTensorPoint R W hW p hp hmiss, chartTensorPoint_mem R W hW p hp hmiss⟩ = _
  have h1 : (⟨chartTensorPoint R W hW p hp hmiss,
        chartTensorPoint_mem R W hW p hp hmiss⟩ : ↥(C.bcOpens (FractionRing R) W))
      = (chartAffineOpen (K := K) (C := C) R W hW).isoSpec.inv
          ⟨chartTensorPrime R W hW p, chartTensorPrime_isPrime R W hW p hp hmiss⟩ := by
    apply Subtype.ext
    rfl
  rw [h1]
  exact Homeomorph.apply_symm_apply
    (Scheme.homeoOfIso (chartAffineOpen (K := K) (C := C) R W hW).isoSpec) _

/-- The prime of the chart `W_F` attached to the point of `p`, as an ideal. -/
theorem chartTensorPoint_primeIdealOf (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    ((chartAffineOpen (K := K) (C := C) R W hW).primeIdealOf
        ⟨chartTensorPoint R W hW p hp hmiss,
          chartTensorPoint_mem R W hW p hp hmiss⟩).asIdeal = chartTensorPrime R W hW p :=
  congrArg PrimeSpectrum.asIdeal (chartTensorPoint_primeIdealOf_spectrum R W hW p hp hmiss)

/-- **The point attached to a height-one prime `p` of the relative chart is a closed point.**

Its prime `p'` in the chart has height one, so it is not the zero ideal; but the zero ideal of
the chart is exactly the prime of the generic point of the curve, so the point is not the
generic point, hence - the curve having dimension one - it is a closed point. -/
theorem chartTensorPoint_isClosed (W : C.left.Opens) (hW : IsAffineOpen W) [Nonempty W]
    (p : Ideal (Work.SpecLin.Core.chartTensor R W)) (hp : p.IsPrime) (hp1 : p.height = 1)
    (hmiss : ∀ r : R, r ≠ 0 → Algebra.TensorProduct.includeRight r ∉ p) :
    IsClosed ({chartTensorPoint R W hW p hp hmiss} :
      Set (C.baseChange (FractionRing R)).left) := by
  haveI hUaff : IsAffineOpen (C.bcOpens (FractionRing R) W) := chartAffineOpen R W hW
  haveI hne : Nonempty (C.bcOpens (FractionRing R) W) := C.bcOpens_nonempty (FractionRing R) W
  haveI hdom : IsDomain (chartSections R W) :=
    (Scheme.germToFunctionField_injective (C.baseChange (FractionRing R)).left
      (C.bcOpens (FractionRing R) W)).isDomain
  rcases Work.CurveBasics.Curve.eq_genericPoint_or_isClosed (C.baseChange (FractionRing R))
      (chartTensorPoint R W hW p hp hmiss) with hgen | hcl
  · exfalso
    have hmem : genericPoint (C.baseChange (FractionRing R)).left ∈ C.bcOpens (FractionRing R) W :=
      hgen ▸ chartTensorPoint_mem R W hW p hp hmiss
    have hbot : hUaff.primeIdealOf
        ⟨genericPoint (C.baseChange (FractionRing R)).left, hmem⟩ =
          (⊥ : PrimeSpectrum (chartSections R W)) := by
      rw [hUaff.primeIdealOf_genericPoint, AlgebraicGeometry.genericPoint_eq_bot_of_affine]
    have h2 : hUaff.primeIdealOf
        ⟨genericPoint (C.baseChange (FractionRing R)).left, hmem⟩ =
          ⟨chartTensorPrime R W hW p, chartTensorPrime_isPrime R W hW p hp hmiss⟩ := by
      have h3 : (⟨genericPoint (C.baseChange (FractionRing R)).left, hmem⟩ :
            ↥(C.bcOpens (FractionRing R) W)) =
          ⟨chartTensorPoint R W hW p hp hmiss,
            chartTensorPoint_mem R W hW p hp hmiss⟩ :=
        Subtype.ext hgen.symm
      rw [h3]
      exact chartTensorPoint_primeIdealOf_spectrum R W hW p hp hmiss
    have h5 : (⊥ : PrimeSpectrum (chartSections R W)).asIdeal = chartTensorPrime R W hW p :=
      congrArg PrimeSpectrum.asIdeal (hbot.symm.trans h2)
    have hpb : chartTensorPrime R W hW p = ⊥ := by
      rw [← h5]
      rfl
    exact (Ideal.ne_bot_of_height_eq_one
      (by rw [chartTensorPrime_height R W hW p hp hmiss]; exact hp1)) hpb
  · exact hcl


end Up
end Work.SpecLin.Alt

