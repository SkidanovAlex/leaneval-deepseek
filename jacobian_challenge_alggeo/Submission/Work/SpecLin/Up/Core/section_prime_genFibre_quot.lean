namespace Work.SpecLin.Core
namespace Up

open scoped TensorProduct

/-! The requested statement is

```
theorem section_prime_genFibre_quot {K : Type*} [Field K] {A : Type*} [CommRing A]
    [IsDomain A] [Algebra K A] {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [Algebra K R] (φ : A →ₐ[K] R) :
    (TensorProduct K A (FractionRing R) ⧸
      ((RingHom.ker (Algebra.TensorProduct.lift (S := K) φ (AlgHom.id K R)
        (fun _ _ => Commute.all _ _)).toRingHom).map
        (Algebra.TensorProduct.map (AlgHom.id K A) (IsScalarTower.toAlgHom K R (FractionRing R)))))
      ≃+* FractionRing R
```

Its type is not a proposition, so Lean rejects it as a `theorem`; as everywhere else in this
development for equivalences, it is therefore declared as a `noncomputable def` with the same
name and the same type. -/

/-- **The generic-fibre point of a section is rational over the fraction field.**  Let `A` be a
`K`-algebra, `R` a valuation ring over `K` with fraction field `F = Frac R`, and `φ : A →ₐ[K] R`.
Write `B = A ⊗[K] R`, `I = ker (B →ₐ[K] R)` for the evaluation `a ⊗ r ↦ φ a * r`, and
`B_F = A ⊗[K] F`.  Then the quotient of `B_F` by the ideal generated by (the image of) `I` is
`F`:  `B_F ⧸ I·B_F ≅ F`.  Equivalently, the point `Spec F → Spec B_F` determined by `φ` (the
generic fibre of the section `Spec R → Spec B`) is a rational point of the generic fibre of the
relative chart.

Proof: the evaluation `ev_F : B_F →ₐ[K] F`, `a ⊗ f ↦ φ a * f`, is surjective; the elements
`a ⊗ 1 - 1 ⊗ φ a` (`a ∈ A`) lie in the image of `I` (their image under `B → R` is
`φ a - φ a = 0`) and, modulo `I·B_F`, every element of `B_F` becomes `1 ⊗ ev_F x`; so
`I·B_F = ker ev_F` and the first isomorphism theorem applies. -/
noncomputable def section_prime_genFibre_quot {K : Type*} [Field K] {A : Type*} [CommRing A]
    [IsDomain A] [Algebra K A] {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [Algebra K R] (φ : A →ₐ[K] R) :
    (TensorProduct K A (FractionRing R) ⧸
      ((RingHom.ker (Algebra.TensorProduct.lift (S := K) φ (AlgHom.id K R)
        (fun _ _ => Commute.all _ _)).toRingHom).map
        (Algebra.TensorProduct.map (AlgHom.id K A) (IsScalarTower.toAlgHom K R (FractionRing R)))))
      ≃+* FractionRing R := by
  -- Notation for the fraction field, the two evaluations and the base-change map.
  let g : R →ₐ[K] FractionRing R := IsScalarTower.toAlgHom K R (FractionRing R)
  let ev : A ⊗[K] R →ₐ[K] R :=
    Algebra.TensorProduct.lift (S := K) φ (AlgHom.id K R) (fun _ _ => Commute.all _ _)
  let evF : A ⊗[K] FractionRing R →ₐ[K] FractionRing R :=
    Algebra.TensorProduct.lift (S := K) (g.comp φ) (AlgHom.id K (FractionRing R))
      (fun _ _ => Commute.all _ _)
  let ψ : A ⊗[K] R →ₐ[K] A ⊗[K] FractionRing R :=
    Algebra.TensorProduct.map (AlgHom.id K A) g
  let J : Ideal (A ⊗[K] FractionRing R) := (RingHom.ker ev.toRingHom).map ψ
  -- The two evaluations are compatible with the base change `R → F`: this is the naturality of
  -- `Algebra.TensorProduct.lift` in the second variable.
  have hnat : ∀ b : A ⊗[K] R, evF (ψ b) = g (ev b) := by
    intro b
    induction b using TensorProduct.inductionOn with
    | tmul a r =>
      simp only [evF, ψ, ev, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul,
        AlgHom.comp_apply, AlgHom.id_apply]
      rw [← map_mul]
    | add x y hx hy => simp only [map_add, hx, hy]
  -- Hence the kernel `I` of `ev` is carried into the kernel of `evF` by `ψ`.
  have hker : ∀ x ∈ J, evF x = 0 := by
    have hJ : J ≤ RingHom.ker evF.toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro i hi
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show evF (ψ i) = 0
      have hi' : ev i = 0 := RingHom.mem_ker.mp hi
      rw [hnat i, hi']
      exact map_zero g
    exact fun x hx => hJ hx
  -- The key computation: modulo `J`, every element of `B_F` is `1 ⊗ (evF x)`, i.e. the classes of
  -- the elements `a ⊗ 1 - 1 ⊗ φ a` (`a ∈ A`) generate the whole kernel of `evF`.
  have hT : ∀ x : A ⊗[K] FractionRing R,
      x - Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R) (evF x)
        ∈ J := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul a f =>
      have hmem : a ⊗ₜ[K] (1 : R) - 1 ⊗ₜ[K] φ a ∈ RingHom.ker ev.toRingHom := by
        rw [RingHom.mem_ker]
        simp [ev, Algebra.TensorProduct.lift_tmul]
      have h2 : ψ (a ⊗ₜ[K] (1 : R) - 1 ⊗ₜ[K] φ a) ∈ J := Ideal.mem_map_of_mem ψ hmem
      have h3 : ψ (a ⊗ₜ[K] (1 : R) - 1 ⊗ₜ[K] φ a) * (1 ⊗ₜ[K] f) ∈ J :=
        J.mul_mem_right _ h2
      simpa only [evF, ψ, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.includeRight_apply, AlgHom.comp_apply, AlgHom.id_apply,
        map_sub, map_one, sub_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        using h3
    | add x y hx hy =>
      have heq : x + y - Algebra.TensorProduct.includeRight (R := K) (A := A)
            (B := FractionRing R) (evF (x + y))
          = (x - Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R)
                (evF x))
            + (y - Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R)
                (evF y)) := by
        simp only [map_add]
        abel
      rw [heq]
      exact J.add_mem hx hy
  -- The two maps between `B_F ⧸ J` and `F` which are mutually inverse.
  let evFbar : (A ⊗[K] FractionRing R) ⧸ J →+* FractionRing R :=
    Ideal.Quotient.lift J evF.toRingHom hker
  let incl : FractionRing R →+* (A ⊗[K] FractionRing R) ⧸ J :=
    (Ideal.Quotient.mk J).comp
      (Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R)).toRingHom
  have hleft : ∀ f : FractionRing R, evFbar (incl f) = f := by
    intro f
    simp only [evFbar, incl, RingHom.comp_apply]
    rw [Ideal.Quotient.lift_mk]
    simp [evF, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.includeRight_apply]
  have hright : ∀ z : (A ⊗[K] FractionRing R) ⧸ J, incl (evFbar z) = z := by
    intro z
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective (I := J) z
    simp only [evFbar, incl, RingHom.comp_apply]
    rw [Ideal.Quotient.lift_mk]
    rw [Ideal.Quotient.eq]
    rw [← Ideal.neg_mem_iff]
    rw [neg_sub]
    exact hT x
  -- Assemble.
  show (A ⊗[K] FractionRing R) ⧸ J ≃+* FractionRing R
  refine RingEquiv.ofBijective evFbar ⟨fun x y hxy => ?_, fun y => ⟨incl y, hleft y⟩⟩
  calc x = incl (evFbar x) := (hright x).symm
    _ = incl (evFbar y) := by rw [hxy]
    _ = y := hright y

end Up
end Work.SpecLin.Core

