import Mathlib

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


universe u

namespace Work.SpecLin.Core

open scoped TensorProduct

/-- **(D1c-alg)** The generic fibre of the section prime is the kernel of the generic-fibre
evaluation. -/
theorem sectionPrime_genFibre_eq_ker {K : Type u} [Field K] {A : Type u} [CommRing A]
    [IsDomain A] [Algebra K A] {R : Type u} [CommRing R] [IsDomain R] [ValuationRing R]
    [Algebra K R] (φ : A →ₐ[K] R) :
    (RingHom.ker (Algebra.TensorProduct.lift (S := K) φ (AlgHom.id K R)
        (fun _ _ => Commute.all _ _)).toRingHom).map
        (Algebra.TensorProduct.map (AlgHom.id K A) (IsScalarTower.toAlgHom K R (FractionRing R)))
      = RingHom.ker (Algebra.TensorProduct.lift (S := K)
          ((IsScalarTower.toAlgHom K R (FractionRing R)).comp φ)
          (AlgHom.id K (FractionRing R)) (fun _ _ => Commute.all _ _)).toRingHom := by
  -- Notation: `g : R → F` is the structure map, `ev` the evaluation `A ⊗_K R → R`,
  -- `evF` the generic-fibre evaluation `A ⊗_K F → F`, `ψ = id_A ⊗ (R → F)` the base change,
  -- and `J` the ideal generated by the section prime under base change.
  let g : R →ₐ[K] FractionRing R := IsScalarTower.toAlgHom K R (FractionRing R)
  let ev : A ⊗[K] R →ₐ[K] R :=
    Algebra.TensorProduct.lift (S := K) φ (AlgHom.id K R) (fun _ _ => Commute.all _ _)
  let evF : A ⊗[K] FractionRing R →ₐ[K] FractionRing R :=
    Algebra.TensorProduct.lift (S := K) (g.comp φ) (AlgHom.id K (FractionRing R))
      (fun _ _ => Commute.all _ _)
  let ψ : A ⊗[K] R →ₐ[K] A ⊗[K] FractionRing R :=
    Algebra.TensorProduct.map (AlgHom.id K A) g
  let J : Ideal (A ⊗[K] FractionRing R) := (RingHom.ker ev.toRingHom).map ψ
  change J = RingHom.ker evF.toRingHom
  -- Naturality of `lift` in the second variable: `evF` after base change is `g` after `ev`.
  have hnat : ∀ b : A ⊗[K] R, evF (ψ b) = g (ev b) := by
    intro b
    induction b using TensorProduct.inductionOn with
    | tmul a r =>
      simp only [evF, ψ, ev, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul,
        AlgHom.comp_apply, AlgHom.id_apply]
      rw [← map_mul]
    | add x y hx hy => simp only [map_add, hx, hy]
  -- Every element of `A ⊗_K F` agrees with `1 ⊗ evF x` modulo `J`.
  have hT : ∀ x : A ⊗[K] FractionRing R,
      x - Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R) (evF x)
        ∈ J := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul a f =>
      have hmem : a ⊗ₜ[K] (1 : R) - 1 ⊗ₜ[K] φ a ∈ RingHom.ker ev.toRingHom := by
        rw [RingHom.mem_ker]
        simp [ev, Algebra.TensorProduct.lift_tmul]
      have h2 : ψ (a ⊗ₜ[K] (1 : R) - 1 ⊗ₜ[K] φ a) ∈ J := Ideal.mem_map_of_mem ψ hmem
      have h3 : ψ (a ⊗ₜ[K] (1 : R) - 1 ⊗ₜ[K] φ a) * (1 ⊗ₜ[K] f) ∈ J :=
        J.mul_mem_right _ h2
      simpa only [evF, ψ, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.includeRight_apply, AlgHom.comp_apply, AlgHom.id_apply,
        map_sub, map_one, sub_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        using h3
    | add x y hx hy =>
      have heq : x + y - Algebra.TensorProduct.includeRight (R := K) (A := A)
            (B := FractionRing R) (evF (x + y))
          = (x - Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R)
                (evF x))
            + (y - Algebra.TensorProduct.includeRight (R := K) (A := A) (B := FractionRing R)
                (evF y)) := by
        simp only [map_add]
        abel
      rw [heq]
      exact J.add_mem hx hy
  apply le_antisymm
  · -- `J ≤ ker evF`: the section prime maps into the kernel of the generic-fibre evaluation.
    change (RingHom.ker ev.toRingHom).map
      (ψ : A ⊗[K] R →+* A ⊗[K] FractionRing R) ≤ RingHom.ker evF.toRingHom
    rw [Ideal.map_le_iff_le_comap]
    intro i hi
    rw [Ideal.mem_comap, RingHom.mem_ker]
    show evF (ψ i) = 0
    rw [hnat i]
    have hi' : ev i = 0 := RingHom.mem_ker.mp hi
    rw [hi', map_zero]
  · -- `ker evF ≤ J`: an element killed by `evF` equals `x - 1 ⊗ evF x`, which lies in `J`.
    intro x hx
    rw [RingHom.mem_ker] at hx
    have hx' : evF x = 0 := hx
    have h := hT x
    rw [hx'] at h
    simpa using h

end Work.SpecLin.Core
