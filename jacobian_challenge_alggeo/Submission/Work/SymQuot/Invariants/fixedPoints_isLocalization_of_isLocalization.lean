# Invariants commute with localization

Let a finite group `G` act on commutative rings `R` and `R'`, with `R'` an `R`-algebra such that
the structure map `R → R'` is `G`-equivariant (`hcompat`).  If `R'` is the localization of `R` at
a `G`-stable submonoid `S ⊆ R`, then the fixed subring `R'^G` is the localization of `R^G` at the
fixed part `S ∩ R^G` of `S`.

This is the general form of `Work.SymQuot.Invariants.fixedPoints_isLocalization_away`, which
covers the case where `S` is generated by a single `G`-fixed element.  It is the ring-theoretic
shadow of the fact that the quotient by `G` commutes with restriction to an invariant open
subset of a `G`-scheme.

The proof constructs, for an element `z ∈ R'^G`, an explicit fraction `a / s` with `a, s ∈ R^G`
and `s ∈ S`: one starts from any fraction `a₀ / s₀` for `z`, multiplies numerator and denominator
by the `G`-translates of `s₀` so that the denominator `s̄ = ∏_g g • s₀` is `G`-fixed, and then
symmetrices the numerator by multiplying with the norm `N = ∏_k k • c` of a common denominator
`c` clearing the discrepancies `g • a - a`.
-/
import Mathlib
import Submission.Work.SymQuot.Invariants

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Work.SymQuot.Invariants

open Work.SymQuot

/-- The product of all `G`-translates of `a` is fixed by `G`. -/
lemma smul_prod_univ_smul {G : Type*} [Group G] [Fintype G] {R : Type*} [CommRing R]
    [MulSemiringAction G R] (a : R) (g : G) :
    g • (∏ h : G, h • a) = ∏ h : G, h • a := by
  have h1 : g • (∏ h : G, h • a) = ∏ h : G, g • (h • a) :=
    map_prod (MulSemiringAction.toRingHom G R g) (fun h => h • a) Finset.univ
  rw [h1]
  simp only [smul_smul]
  exact Equiv.prod_comp (Equiv.mulLeft g) (fun h => h • a)

/-- Splitting off the `a`-th factor of a product indexed by all of `G`. -/
lemma prod_univ_eq_mul_prod_erase {α : Type*} [Fintype α] [DecidableEq α] {M : Type*}
    [CommMonoid M] (f : α → M) (a : α) :
    (∏ x : α, f x) = f a * ∏ x ∈ Finset.univ.erase a, f x :=
  (Finset.mul_prod_erase Finset.univ f (Finset.mem_univ a)).symm

/-- If `s ∈ R^G` lies in the `G`-stable submonoid `S`, then its image under the induced map
`R^G →+* R'^G` is a unit of `R'^G` (its inverse in `R'` is `G`-fixed as well). -/
lemma isUnit_fixedPointsMap_of_mem {G : Type*} [Group G] {R : Type*} [CommRing R]
    [MulSemiringAction G R] {R' : Type*} [CommRing R'] [MulSemiringAction G R'] [Algebra R R']
    {S : Submonoid R}
    (hcompat : ∀ (g : G) (r : R), algebraMap R R' (g • r) = g • algebraMap R R' r)
    (s : FixedPoints.subring R G) (hs : (s : R) ∈ S) [IsLocalization S R'] :
    IsUnit (fixedPointsMap hcompat s) := by
  rw [isUnit_iff_exists]
  obtain ⟨b, hb1, hb2⟩ :=
    isUnit_iff_exists.mp (IsLocalization.map_units R' (⟨(s : R), hs⟩ : S))
  have hfixs : ∀ g : G, g • algebraMap R R' (s : R) = algebraMap R R' (s : R) := by
    intro g
    rw [← hcompat g (s : R), s.2 g]
  have hb_fix : ∀ g : G, g • b = b := by
    intro g
    have h1 : algebraMap R R' (s : R) * (g • b) = 1 := by
      have hh := congrArg (fun x => g • x) hb1
      rw [MulSemiringAction.smul_mul, hfixs g, MulSemiringAction.smul_one] at hh
      exact hh
    calc g • b = 1 * (g • b) := (one_mul _).symm
      _ = (b * algebraMap R R' (s : R)) * (g • b) := by rw [hb2]
      _ = b * (algebraMap R R' (s : R) * (g • b)) := by rw [mul_assoc]
      _ = b * 1 := by rw [h1]
      _ = b := mul_one _
  refine ⟨⟨b, hb_fix⟩, ?_, ?_⟩
  · exact Subtype.ext (by simpa [fixedPointsMap_coe] using hb1)
  · exact Subtype.ext (by simpa [fixedPointsMap_coe] using hb2)

/-- If `x y ∈ R^G` have the same image in `R'`, then some `G`-fixed element of `S` kills their
difference in `R`. -/
lemma exists_fixed_mul_eq_of_fixedPointsMap_eq {G : Type*} [Group G] [Fintype G] {R : Type*}
    [CommRing R] [MulSemiringAction G R] {R' : Type*} [CommRing R'] [MulSemiringAction G R']
    [Algebra R R']
    (hcompat : ∀ (g : G) (r : R), algebraMap R R' (g • r) = g • algebraMap R R' r)
    (S : Submonoid R) (hS : ∀ (g : G) (s : R), s ∈ S → g • s ∈ S) [IsLocalization S R']
    {x y : FixedPoints.subring R G}
    (h : fixedPointsMap hcompat x = fixedPointsMap hcompat y) :
    ∃ c : FixedPoints.subring R G, (c : R) ∈ S ∧ c * x = c * y := by
  classical
  have h' : algebraMap R R' (x : R) = algebraMap R R' (y : R) := by
    have hc := congrArg (fun t : FixedPoints.subring R' G => (t : R')) h
    simpa [fixedPointsMap_coe] using hc
  obtain ⟨c₀, hc₀⟩ := IsLocalization.exists_of_eq (M := S) (S := R') h'
  set cR : R := ∏ g : G, g • (c₀ : R) with hcR_def
  have hcR_mem : cR ∈ S := by
    rw [hcR_def]; exact Submonoid.prod_mem _ (fun g _ => hS g (c₀ : R) c₀.2)
  have hcR_fix : ∀ g : G, g • cR = cR := by
    intro g; rw [hcR_def]; exact smul_prod_univ_smul (c₀ : R) g
  refine ⟨⟨cR, hcR_fix⟩, hcR_mem, ?_⟩
  apply Subtype.ext
  have hdecomp : cR = (c₀ : R) * ∏ g ∈ Finset.univ.erase (1 : G), g • (c₀ : R) := by
    rw [hcR_def, prod_univ_eq_mul_prod_erase (fun g => g • (c₀ : R)) 1]
    simp
  calc cR * (x : R)
      = (∏ g ∈ Finset.univ.erase (1 : G), g • (c₀ : R)) * ((c₀ : R) * (x : R)) := by
        rw [hdecomp]; ring
    _ = (∏ g ∈ Finset.univ.erase (1 : G), g • (c₀ : R)) * ((c₀ : R) * (y : R)) := by rw [hc₀]
    _ = cR * (y : R) := by rw [hdecomp]; ring

/-- Every element `z` of `R'^G` can be written as `z * s = a` with `s, a ∈ R^G` and `s ∈ S`,
i.e. the image of `R^G` in `R'^G` generates `R'^G` as a localization at `S ∩ R^G`. -/
lemma exists_fixed_mul_eq_of_fixedPointsMap {G : Type*} [Group G] [Fintype G] {R : Type*}
    [CommRing R] [MulSemiringAction G R] {R' : Type*} [CommRing R'] [MulSemiringAction G R']
    [Algebra R R']
    (hcompat : ∀ (g : G) (r : R), algebraMap R R' (g • r) = g • algebraMap R R' r)
    (S : Submonoid R) (hS : ∀ (g : G) (s : R), s ∈ S → g • s ∈ S) [IsLocalization S R']
    (z : FixedPoints.subring R' G) :
    ∃ (s : FixedPoints.subring R G), (s : R) ∈ S ∧
      ∃ (a : FixedPoints.subring R G),
        z * fixedPointsMap hcompat s = fixedPointsMap hcompat a := by
  classical
  obtain ⟨⟨a₀, s₀⟩, hsurj⟩ := IsLocalization.surj S (z : R')
  set sbar : R := ∏ g : G, g • (s₀ : R) with hsbar_def
  set atil : R := a₀ * ∏ g ∈ Finset.univ.erase (1 : G), g • (s₀ : R) with hatil_def
  have hsbar_mem : sbar ∈ S := by
    rw [hsbar_def]; exact Submonoid.prod_mem _ (fun g _ => hS g (s₀ : R) s₀.2)
  have hsbar_fix : ∀ g : G, g • sbar = sbar := by
    intro g; rw [hsbar_def]; exact smul_prod_univ_smul (s₀ : R) g
  have hsbar_eq : sbar = (s₀ : R) * ∏ g ∈ Finset.univ.erase (1 : G), g • (s₀ : R) := by
    rw [hsbar_def, prod_univ_eq_mul_prod_erase (fun g => g • (s₀ : R)) 1]
    simp
  have hmain : algebraMap R R' atil = z * algebraMap R R' sbar := by
    rw [hatil_def, hsbar_eq, map_mul, map_mul, ← hsurj]
    ring
  have hg : ∀ g : G, algebraMap R R' (g • atil) = algebraMap R R' atil := by
    intro g
    calc algebraMap R R' (g • atil) = g • algebraMap R R' atil := hcompat g atil
      _ = g • ((z : R') * algebraMap R R' sbar) := by rw [hmain]
      _ = (g • (z : R')) * (g • algebraMap R R' sbar) := MulSemiringAction.smul_mul g _ _
      _ = (z : R') * (g • algebraMap R R' sbar) := by rw [z.2 g]
      _ = (z : R') * algebraMap R R' (g • sbar) := by rw [hcompat g sbar]
      _ = (z : R') * algebraMap R R' sbar := by rw [hsbar_fix g]
      _ = algebraMap R R' atil := hmain.symm
  have hcg : ∀ g : G, ∃ c : S, (c : R) * (g • atil) = (c : R) * atil :=
    fun g => IsLocalization.exists_of_eq (M := S) (S := R') (hg g)
  choose c hc using hcg
  set cR : R := ∏ g : G, (c g : R) with hcR_def
  have hcR_mem : cR ∈ S := by
    rw [hcR_def]; exact Submonoid.prod_mem _ (fun g _ => (c g).2)
  have hcR : ∀ g : G, cR * (g • atil) = cR * atil := by
    intro g
    have hdecomp : cR = (c g : R) * ∏ h ∈ Finset.univ.erase g, (c h : R) := by
      rw [hcR_def, prod_univ_eq_mul_prod_erase (fun h => (c h : R)) g]
    calc cR * (g • atil)
        = (∏ h ∈ Finset.univ.erase g, (c h : R)) * ((c g : R) * (g • atil)) := by
          rw [hdecomp]; ring
      _ = (∏ h ∈ Finset.univ.erase g, (c h : R)) * ((c g : R) * atil) := by rw [hc g]
      _ = cR * atil := by rw [hdecomp]; ring
  set N : R := ∏ k : G, k • cR with hN_def
  have hN_fix : ∀ g : G, g • N = N := by
    intro g; rw [hN_def]; exact smul_prod_univ_smul cR g
  have hN_mem : N ∈ S := by
    rw [hN_def]; exact Submonoid.prod_mem _ (fun k _ => hS k cR hcR_mem)
  have hN : ∀ g : G, N * (g • atil) = N * atil := by
    intro g
    have hdecomp : N = cR * ∏ k ∈ Finset.univ.erase (1 : G), k • cR := by
      rw [hN_def, prod_univ_eq_mul_prod_erase (fun k => k • cR) 1]
      simp
    calc N * (g • atil)
        = (∏ k ∈ Finset.univ.erase (1 : G), k • cR) * (cR * (g • atil)) := by
          rw [hdecomp]; ring
      _ = (∏ k ∈ Finset.univ.erase (1 : G), k • cR) * (cR * atil) := by rw [hcR g]
      _ = N * atil := by rw [hdecomp]; ring
  have hb_fix : ∀ g : G, g • (N * atil) = N * atil := by
    intro g
    rw [MulSemiringAction.smul_mul, hN_fix g, hN g]
  refine ⟨⟨N * sbar, ?_⟩, ?_, ⟨N * atil, hb_fix⟩, ?_⟩
  · intro g
    rw [MulSemiringAction.smul_mul, hN_fix g, hsbar_fix g]
  · exact S.mul_mem hN_mem hsbar_mem
  · apply Subtype.ext
    simp only [Subring.coe_mul, fixedPointsMap_coe]
    rw [map_mul, map_mul, hmain]
    ring

theorem fixedPoints_isLocalization_of_isLocalization {G : Type*} [Group G] [Finite G]
    {R : Type*} [CommRing R] [MulSemiringAction G R]
    {R' : Type*} [CommRing R'] [MulSemiringAction G R'] [Algebra R R']
    (hcompat : ∀ (g : G) (r : R), algebraMap R R' (g • r) = g • algebraMap R R' r)
    (S : Submonoid R) (hS : ∀ (g : G) (s : R), s ∈ S → g • s ∈ S) [IsLocalization S R'] :
    letI : Algebra (FixedPoints.subring R G) (FixedPoints.subring R' G) :=
      RingHom.toAlgebra (Work.SymQuot.fixedPointsMap hcompat)
    IsLocalization (S.comap (Subring.subtype (FixedPoints.subring R G)).toMonoidHom)
      (FixedPoints.subring R' G) := by
  letI : Algebra (FixedPoints.subring R G) (FixedPoints.subring R' G) :=
    RingHom.toAlgebra (Work.SymQuot.fixedPointsMap hcompat)
  haveI : Fintype G := Fintype.ofFinite G
  have key : (algebraMap (FixedPoints.subring R G) (FixedPoints.subring R' G))
      = Work.SymQuot.fixedPointsMap hcompat := RingHom.algebraMap_toAlgebra _
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · intro y
    rw [key]
    exact isUnit_fixedPointsMap_of_mem hcompat (y : FixedPoints.subring R G) (by exact y.2)
  · intro z
    rw [key]
    obtain ⟨s, hs, a, ha⟩ := exists_fixed_mul_eq_of_fixedPointsMap hcompat S hS z
    exact ⟨(a, ⟨s, hs⟩), by simpa using ha⟩
  · intro x y h
    rw [key] at h
    obtain ⟨c, hc_mem, hc_eq⟩ := exists_fixed_mul_eq_of_fixedPointsMap_eq hcompat S hS h
    exact ⟨⟨c, by simpa using hc_mem⟩, by simpa using hc_eq⟩

end Work.SymQuot.Invariants
