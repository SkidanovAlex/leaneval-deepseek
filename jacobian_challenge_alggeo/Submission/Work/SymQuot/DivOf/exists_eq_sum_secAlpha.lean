/-- The statement as requested at the path of this file: the single-namespace form of
`Work.SymQuot.DivOf.Work.SymQuot.DivOf.exists_eq_sum_secAlpha` (the declaration above, which sits
in the doubly opened namespace inherited from this file's original skeleton). -/
theorem exists_eq_sum_secAlpha {K : Type u} [Field K] {C : Work.CurveBasics.Curve K}
    (F : Type u) [Field F] [Algebra K F] (V : C.left.Opens) (hV : IsAffineOpen V) [Nonempty V]
    (b' : Γ((C.baseChange F).left, C.bcOpens F V)) :
    ∃ (r : ℕ) (b : Fin r → C.left.presheaf.obj (Opposite.op V)) (f : Fin r → F),
      b' = ∑ i, secConst C F V (f i) * secAlpha C F V (b i) :=
  Work.SymQuot.DivOf.Work.SymQuot.DivOf.exists_eq_sum_secAlpha F V hV b'

