/-!
# `Γ(C_F, V_F)` is generated by `secConst · secAlpha`

For a curve `C` over a field `K`, a field extension `F/K` and an affine open `V ⊆ C`, the
sections of the base change `C_F` over `V_F = (C_F ⟶ C)⁻¹V` are, via the affine-local
description of the base change, the tensor product `Γ(C,V) ⊗[K] F`: the canonical map
`Curve.BCSquare.sectionsLift` is the ring hom underlying the isomorphism of affine schemes

`Spec Γ(C', S.π ⁻¹ᵁ W) ≅ Spec (Γ(C,W) ⊗[k] F)`.

Since every element of a tensor product is a finite sum of pure tensors, every element of
`Γ(C_F, V_F)` is a finite sum of products `secConst c · secAlpha b`, which is the content of
`exists_eq_sum_secAlpha`.

The auxiliary statements proved here are of independent interest:

* `exists_eq_sum_tmul` — every element of `A ⊗[K] F` is a finite sum of pure tensors;
* `sectionsLift_surjective_of_isAffineOpen` — the affine-local description is surjective;
* `sectionsLift_tmul_generic` — its value on a pure tensor, in terms of the structure map and
  the pullback of sections;
* `exists_eq_sum_secAlpha_aux` — the statement for an arbitrary base-change square.
-/

/-- **Every element of `A ⊗[K] F` is a finite sum of pure tensors.** -/
lemma exists_eq_sum_tmul {K : Type u} [Field K] {F : Type u} [Field F] [Algebra K F]
    {A : Type u} [CommRing A] [Algebra K A] (z : A ⊗[K] F) :
    ∃ (r : ℕ) (a : Fin r → A) (c : Fin r → F), z = ∑ i, a i ⊗ₜ[K] c i := by
  refine TensorProduct.inductionOn z (fun x y => ⟨1, fun _ => x, fun _ => y, ?_⟩) ?_
  · simp
  · intro x y hx hy
    obtain ⟨r1, a1, c1, h1⟩ := hx
    obtain ⟨r2, a2, c2, h2⟩ := hy
    refine ⟨r1 + r2, Fin.append a1 a2, Fin.append c1 c2, ?_⟩
    rw [h1, h2, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]

/-- **The affine-local description of a base change is surjective.**  For a base-change square
`S : BCSquare C C'` and an affine open `W ⊆ C`, the canonical map
`Γ(C,W) ⊗[k] F ⟶ Γ(C', S.π ⁻¹ᵁ W)` is surjective: it is the ring hom underlying the
isomorphism `Spec Γ(C', S.π ⁻¹ᵁ W) ≅ Spec (Γ(C,W) ⊗[k] F)` of affine schemes. -/
lemma sectionsLift_surjective_of_isAffineOpen {k : Type u} [Field k] {F : Type u} [Field F]
    [Algebra k F] {C : Curve k} {C' : Curve F} (S : Curve.BCSquare C C') (W : C.left.Opens)
    (hW : IsAffineOpen W) :
    Function.Surjective (Curve.BCSquare.sectionsLift S W hW) := by
  set u := (Curve.BCSquare.isPullback_spec_preimage S W hW).isoPullback
    ≪≫ pullbackSpecIso k Γ(C.left, W) F with hu
  have hright : Function.RightInverse (fun z => (Spec.preimage u.inv).hom z)
      (fun z => (Spec.preimage u.hom).hom z) := by
    intro z
    have hid : (Spec.preimage u.inv ≫ Spec.preimage u.hom :
        CommRingCat.of (Γ(C'.left, S.π ⁻¹ᵁ W)) ⟶
          CommRingCat.of (Γ(C'.left, S.π ⁻¹ᵁ W))) = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_id]
      exact Iso.hom_inv_id u
    exact congrArg (fun (φ : CommRingCat.of (Γ(C'.left, S.π ⁻¹ᵁ W)) ⟶
      CommRingCat.of (Γ(C'.left, S.π ⁻¹ᵁ W))) => φ.hom z) hid
  exact hright.surjective

/-- **The affine-local description on a pure tensor.**  It is the product of the pullback of the
section and the structure map applied to the constant. -/
lemma sectionsLift_tmul_generic {k : Type u} [Field k] {F : Type u} [Field F] [Algebra k F]
    {C : Curve k} {C' : Curve F} (S : Curve.BCSquare C C') (W : C.left.Opens) (hW : IsAffineOpen W)
    (a : Γ(C.left, W)) (c : F) :
    Curve.BCSquare.sectionsLift S W hW (a ⊗ₜ[k] c) =
      (algebraMap F Γ(C'.left, S.π ⁻¹ᵁ W) c) * ((S.π.app W).hom a) := by
  have h1 : (a ⊗ₜ[k] (1 : F)) * ((1 : Γ(C.left, W)) ⊗ₜ[k] c) = a ⊗ₜ[k] c := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  rw [← h1, map_mul, Curve.BCSquare.sectionsLift_tmul_one,
    Curve.BCSquare.sectionsLift_one_tmul]
  exact mul_comm _ _

/-- **Generation of the sections of a base change by `secAlpha` and the structure map.**  For a
base-change square `S : BCSquare C C'` and an affine open `W ⊆ C`, every element of
`Γ(C', S.π ⁻¹ᵁ W)` is a finite sum of products of the image of a constant and the pullback of a
section of `W`. -/
theorem exists_eq_sum_secAlpha_aux {k : Type u} [Field k] {F : Type u} [Field F] [Algebra k F]
    {C : Curve k} {C' : Curve F} (S : Curve.BCSquare C C') (W : C.left.Opens) (hW : IsAffineOpen W)
    (b' : Γ(C'.left, S.π ⁻¹ᵁ W)) :
    ∃ (r : ℕ) (b : Fin r → Γ(C.left, W)) (f : Fin r → F),
      b' = ∑ i, (algebraMap F Γ(C'.left, S.π ⁻¹ᵁ W) (f i)) * ((S.π.app W).hom (b i)) := by
  obtain ⟨z, hz⟩ := sectionsLift_surjective_of_isAffineOpen S W hW b'
  obtain ⟨r, a, c, hzc⟩ := exists_eq_sum_tmul (K := k) (F := F) (A := Γ(C.left, W)) z
  refine ⟨r, a, c, ?_⟩
  rw [← hz, hzc, map_sum]
  exact Finset.sum_congr rfl fun i _ => sectionsLift_tmul_generic S W hW (a i) (c i)

theorem exists_eq_sum_secAlpha {K : Type u} [Field K] {C : Work.CurveBasics.Curve K}
    (F : Type u) [Field F] [Algebra K F] (V : C.left.Opens) (hV : IsAffineOpen V) [Nonempty V]
    (b' : Γ((C.baseChange F).left, C.bcOpens F V)) :
    ∃ (r : ℕ) (b : Fin r → C.left.presheaf.obj (Opposite.op V)) (f : Fin r → F),
      b' = ∑ i, secConst C F V (f i) * secAlpha C F V (b i) := by
  obtain ⟨r, b, f, hb⟩ := exists_eq_sum_secAlpha_aux (C.bcSquare F) V hV b'
  refine ⟨r, b, f, ?_⟩
  rw [hb]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [secAlpha_eq_app, secConst_apply]
  rfl

end Work.SymQuot.DivOf

