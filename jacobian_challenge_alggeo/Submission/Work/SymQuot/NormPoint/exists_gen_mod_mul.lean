import Mathlib

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# A generator of `I / (I * m)` (area SY, `NormPoint`)

Let `R` be a Dedekind domain with fraction field `K`, `I ≠ 0` an ideal and `m` a maximal
ideal.  The main algebraic content proved here is `exists_gen_mod_mul_aux`:

`R`-module `I / (I * m)` is *one dimensional* over the field `R / m`, generated by the image
of any element `u ∈ I \ I * m`, i.e.

`∃ u ∈ I, u ∉ I * m ∧ ∀ a ∈ I, ∃ r : R, a - r * u ∈ I * m`.

This is the classical fact that for a Dedekind domain `R`, a nonzero ideal `I` and a maximal
ideal `m`, the quotient `I / m·I` is isomorphic to `R / m`.  The proof below avoids localisation:
writing `P = ↑I` and `Q = ↑m` in the group `FractionalIdeal R⁰ K`, the key point is that
`Q ≤ N ≤ 1` forces `N = Q` or `N = 1` (`interval_lemmas`), because `m` is maximal.  Multiplying
the interval `[I·m, I]` by `I⁻¹` reduces it to that statement (`interval_ideal`).

The requested lemma `exists_gen_mod_mul` is then the case `m = RingHom.ker ψ` for an
`L`-algebra homomorphism `ψ : R →ₐ[L] L`, which is automatically surjective and hence has
maximal kernel; the coefficients in `R` are translated to coefficients in `L = R/m` using
`ψ`.

The result is used in the construction of the "norm point" of a finite flat algebra: a
flag basis of `Q` that puts a chosen element into a convenient form.
-/

set_option linter.style.haveILetI false
set_option linter.overlappingInstances false

open FractionalIdeal

universe u

namespace Work.SymQuot.NormPoint

/-! ## The interval `[Q, 1]` of fractional ideals for a maximal ideal -/

/-- **Maximality in the group of fractional ideals.**  If `m` is a maximal ideal of a Dedekind
domain `R`, then any fractional ideal `N` of the fraction field `K` lying between `↑m` and `1`
is either `↑m` itself or `1`.

Indeed, `N ≤ 1` means every element of `N` is the image of an element of `R`; if moreover
`N ⊋ ↑m` then `N` contains the image of some `r ∉ m`, and since `m` is maximal
`m ⊔ ⟨r⟩ = ⊤`, so `1 = d + c * r` with `d ∈ m` and hence `1 ∈ N`. -/
lemma interval_lemmas {R K : Type u} [CommRing R] [IsDomain R] [Field K] [Algebra R K]
    [IsFractionRing R K] {m : Ideal R} (hmax : m.IsMaximal)
    {N : FractionalIdeal (nonZeroDivisors R) K}
    (hQ : (m : FractionalIdeal (nonZeroDivisors R) K) ≤ N) (hN : N ≤ 1) :
    N = (m : FractionalIdeal (nonZeroDivisors R) K) ∨ N = 1 := by
  by_cases h : N = (m : FractionalIdeal (nonZeroDivisors R) K)
  · exact Or.inl h
  · refine Or.inr (le_antisymm hN ?_)
    have hex : ∃ x ∈ N, x ∉ (m : FractionalIdeal (nonZeroDivisors R) K) := by
      by_contra hcon
      push Not at hcon
      exact h (le_antisymm hcon hQ)
    obtain ⟨x, hxN, hxQ⟩ := hex
    obtain ⟨r, rfl⟩ := (FractionalIdeal.mem_one_iff (nonZeroDivisors R)).mp (hN hxN)
    have hr : r ∉ m := fun hrm =>
      hxQ ((FractionalIdeal.mem_coeIdeal (nonZeroDivisors R)).mpr ⟨r, hrm, rfl⟩)
    have hsup : m ⊔ Ideal.span {r} = ⊤ := by
      have hne : m ⊔ Ideal.span {r} ≠ m := by
        intro heq
        have hmem : (r : R) ∈ m ⊔ Ideal.span {r} :=
          Submodule.mem_sup.mpr ⟨0, m.zero_mem, r, Ideal.mem_span_singleton_self r, by simp⟩
        rw [heq] at hmem
        exact hr hmem
      by_contra htop
      exact hne (hmax.eq_of_le htop le_sup_left).symm
    have h1 : (1 : K) ∈ (N : Submodule R K) := by
      have hmem : (1 : R) ∈ m ⊔ Ideal.span {r} := by rw [hsup]; exact Submodule.mem_top
      obtain ⟨d, hd, u, hu, hdu⟩ := Submodule.mem_sup.mp hmem
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hu
      have hfac : (1 : K) = (algebraMap R K) d + (algebraMap R K) r * (algebraMap R K) c := by
        have hc := congrArg (algebraMap R K) hdu
        rw [map_add, map_mul, map_one] at hc
        exact hc.symm
      rw [hfac]
      refine Submodule.add_mem _
        (hQ ((FractionalIdeal.mem_coeIdeal (nonZeroDivisors R)).mpr ⟨d, hd, rfl⟩)) ?_
      rw [mul_comm]
      simpa only [Algebra.smul_def] using Submodule.smul_mem _ c hxN
    intro y hy
    obtain ⟨r', rfl⟩ := (FractionalIdeal.mem_one_iff (nonZeroDivisors R)).mp hy
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r' h1

/-- **No ideal strictly between `I · m` and `I`.**  For a Dedekind domain `R`, a nonzero ideal `I`,
a maximal ideal `m` and an ideal `J` with `I * m ≤ J ≤ I`, one has `J = I * m` or `J = I`.

Multiply the interval by `I⁻¹`:  the fractional ideal `N = ↑J * (↑I)⁻¹` satisfies
`↑m ≤ N ≤ 1`, so `interval_lemmas` applies. -/
lemma interval_ideal {R K : Type u} [CommRing R] [IsDomain R] [IsDedekindDomain R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    {I : Ideal R} (hI : I ≠ ⊥) {m : Ideal R} (hmax : m.IsMaximal) {J : Ideal R}
    (h1 : I * m ≤ J) (h2 : J ≤ I) : J = I * m ∨ J = I := by
  set P : FractionalIdeal (nonZeroDivisors R) K := (I : FractionalIdeal (nonZeroDivisors R) K)
    with hPdef
  set Q : FractionalIdeal (nonZeroDivisors R) K := (m : FractionalIdeal (nonZeroDivisors R) K)
    with hQdef
  have hPne : P ≠ 0 := by
    rw [hPdef, FractionalIdeal.coeIdeal_ne_zero]; exact hI
  have hPP : P * P⁻¹ = 1 := by rw [hPdef]; exact FractionalIdeal.coe_ideal_mul_inv I hI
  set N : FractionalIdeal (nonZeroDivisors R) K :=
    (J : FractionalIdeal (nonZeroDivisors R) K) * P⁻¹ with hNdef
  have hJleP : (J : FractionalIdeal (nonZeroDivisors R) K) ≤ P := by
    rw [hPdef]; exact (FractionalIdeal.coeIdeal_le_coeIdeal K).mpr h2
  have hNle : N ≤ 1 := by
    rw [hNdef]
    have h := mul_le_mul_of_nonneg_right hJleP (zero_le P⁻¹)
    rwa [hPP] at h
  have hQleN : Q ≤ N := by
    rw [hNdef]
    have hmI_le_J : (m * I : Ideal R) ≤ J := by rwa [Ideal.mul_comm m I]
    have hQP_le : Q * P ≤ (J : FractionalIdeal (nonZeroDivisors R) K) := by
      rw [hQdef, hPdef, ← FractionalIdeal.coeIdeal_mul]
      exact (FractionalIdeal.coeIdeal_le_coeIdeal K).mpr hmI_le_J
    have h := mul_le_mul_of_nonneg_right hQP_le (zero_le P⁻¹)
    rwa [mul_assoc, hPP, mul_one] at h
  have hNP : N * P = (J : FractionalIdeal (nonZeroDivisors R) K) := by
    rw [hNdef, mul_assoc, inv_mul_cancel₀ hPne, mul_one]
  rcases interval_lemmas hmax hQleN hNle with hNQ | hN1
  · left
    rw [← hQdef] at hNQ
    have hjeq : (J : FractionalIdeal (nonZeroDivisors R) K) = (I * m : Ideal R) := by
      rw [← hNP, hNQ, hQdef, hPdef, ← FractionalIdeal.coeIdeal_mul, Ideal.mul_comm m I]
    exact FractionalIdeal.coeIdeal_injective hjeq
  · right
    have hjeq : (J : FractionalIdeal (nonZeroDivisors R) K) =
        (I : FractionalIdeal (nonZeroDivisors R) K) := by
      rw [← hNP, hN1, one_mul, ← hPdef]
    exact FractionalIdeal.coeIdeal_injective hjeq

/-! ## The auxiliary statement over `R` -/

/-- **A generator of `I / (I · m)`.**  For a Dedekind domain `R`, a nonzero ideal `I` and a
maximal ideal `m` there is `u ∈ I \ I * m` whose image generates `I / (I * m)` as an `R`-module
(equivalently, as an `R/m`-vector space):

`∀ a ∈ I, ∃ r : R, a - r * u ∈ I * m`.

Since `↑m * ↑I ⊊ ↑I`, an element `u` of `I` whose image `x` lies outside `↑m * ↑I` exists.  The
ideal `I * m ⊔ ⟨u⟩` lies between `I * m` and `I`, and is not `I * m`, so `interval_ideal` shows it
is all of `I`, which gives the spanning property. -/
theorem exists_gen_mod_mul_aux {R K : Type u} [CommRing R] [IsDomain R] [IsDedekindDomain R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    {I : Ideal R} (hI : I ≠ ⊥) {m : Ideal R} (hmax : m.IsMaximal) :
    ∃ u ∈ I, u ∉ I * m ∧ ∀ a ∈ I, ∃ r : R, a - r * u ∈ I * m := by
  set P : FractionalIdeal (nonZeroDivisors R) K := (I : FractionalIdeal (nonZeroDivisors R) K)
    with hPdef
  set Q : FractionalIdeal (nonZeroDivisors R) K := (m : FractionalIdeal (nonZeroDivisors R) K)
    with hQdef
  have hPne : P ≠ 0 := by rw [hPdef, FractionalIdeal.coeIdeal_ne_zero]; exact hI
  have hQle : Q ≤ 1 := by rw [hQdef]; exact FractionalIdeal.coeIdeal_le_one
  have hQt : Q ≠ 1 := by
    rw [hQdef, FractionalIdeal.coeIdeal_ne_one, Ideal.one_eq_top]
    exact hmax.ne_top
  have hQPne : Q * P ≠ P := by
    intro heq
    have hQ1 : Q = 1 := mul_right_cancel₀ hPne (heq.trans (one_mul P).symm)
    exact hQt hQ1
  have hQPlt : Q * P < P := by
    refine lt_of_le_of_ne ?_ hQPne
    have h := mul_le_mul_of_nonneg_right hQle (zero_le P)
    rwa [one_mul] at h
  obtain ⟨_, x, hxP, hxQP⟩ := SetLike.lt_iff_le_and_exists.mp hQPlt
  rw [hPdef] at hxP
  obtain ⟨u, huI, hux⟩ := (FractionalIdeal.mem_coeIdeal (nonZeroDivisors R)).mp hxP
  have hu_notmem : u ∉ I * m := by
    intro hu
    apply hxQP
    have hu' : u ∈ m * I := by rwa [Ideal.mul_comm I m] at hu
    have hmul : Q * P = ((m * I : Ideal R) : FractionalIdeal (nonZeroDivisors R) K) := by
      rw [hQdef, hPdef, ← FractionalIdeal.coeIdeal_mul]
    rw [← hux, hmul]
    exact (FractionalIdeal.mem_coeIdeal (nonZeroDivisors R)).mpr ⟨u, hu', rfl⟩
  refine ⟨u, huI, hu_notmem, ?_⟩
  intro a ha
  set J : Ideal R := I * m ⊔ Ideal.span {u} with hJdef
  have hJ1 : I * m ≤ J := le_sup_left
  have hJ2 : J ≤ I := sup_le Ideal.mul_le_left
    (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr huI))
  have hJne : J ≠ I * m := by
    intro heq
    have hmem : u ∈ J := by
      rw [hJdef]
      exact Submodule.mem_sup.mpr
        ⟨0, (I * m).zero_mem, u, Ideal.mem_span_singleton_self u, by simp⟩
    rw [heq] at hmem
    exact hu_notmem hmem
  rcases interval_ideal (K := K) hI hmax hJ1 hJ2 with heq | heq
  · exact absurd heq hJne
  · have haJ : a ∈ J := by rw [heq]; exact ha
    rw [hJdef] at haJ
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp haJ
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hz
    refine ⟨r, ?_⟩
    have hsub : a - r * u = y := by rw [← hyz]; ring
    rw [hsub]; exact hy

/-! ## The requested lemma -/

/-- **A generator of `I / (I * ker ψ)`.**  Let `L` be a field, `R` a Dedekind domain and
`L`-algebra, `I ≠ 0` an ideal of `R` and `ψ : R →ₐ[L] L` an `L`-algebra homomorphism (so that
`R / ker ψ ≅ L`).  Then there is `u ∈ I` whose image generates `I / (I * ker ψ)` as an
`L`-vector space, and `u ∉ I * ker ψ`.

Indeed `ψ` is surjective, being `L`-linear with `L ⊆ ψ(R) ⊆ L`, so `m = ker ψ` is maximal, and
`exists_gen_mod_mul_aux` yields `u` together with, for every `a ∈ I`, a coefficient `r ∈ R` with
`a - r * u ∈ I * m`.  Replacing `r` by `ψ r ∈ L` only adds `(r - algebraMap L R (ψ r)) * u`, and
`r - algebraMap L R (ψ r) ∈ m`. -/
theorem exists_gen_mod_mul {L R : Type u} [Field L] [CommRing R] [IsDomain R]
    [IsDedekindDomain R] [Algebra L R] {I : Ideal R} (hI : I ≠ ⊥) (ψ : R →ₐ[L] L) :
    ∃ u ∈ I, u ∉ I * RingHom.ker ψ ∧ ∀ a ∈ I, ∃ c : L, a - c • u ∈ I * RingHom.ker ψ := by
  have hsurj : Function.Surjective ψ := fun c => ⟨algebraMap L R c, by
    rw [AlgHom.commutes]; exact Algebra.algebraMap_self_apply c⟩
  have hmax : (RingHom.ker ψ).IsMaximal := RingHom.ker_isMaximal_of_surjective ψ hsurj
  obtain ⟨u, huI, hu_notmem, hgen⟩ := exists_gen_mod_mul_aux (K := FractionRing R) hI hmax
  refine ⟨u, huI, hu_notmem, ?_⟩
  intro a ha
  obtain ⟨r, hr⟩ := hgen a ha
  refine ⟨ψ r, ?_⟩
  have h1 : a - (ψ r) • u = (a - r * u) + ((r - algebraMap L R (ψ r)) * u) := by
    rw [Algebra.smul_def]; ring
  have hrmem : r - algebraMap L R (ψ r) ∈ RingHom.ker ψ := by
    rw [RingHom.mem_ker, map_sub, AlgHom.commutes]; simp
  have h2 : (r - algebraMap L R (ψ r)) * u ∈ I * RingHom.ker ψ := by
    rw [mul_comm (r - algebraMap L R (ψ r)) u]
    exact Ideal.mul_mem_mul huI hrmem
  rw [h1]
  exact Ideal.add_mem _ hr h2

end Work.SymQuot.NormPoint
