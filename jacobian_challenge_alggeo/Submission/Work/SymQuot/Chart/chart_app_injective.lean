import Mathlib
import Submission.Work.SymQuot.Chart

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.SymQuot.Chart

open CategoryTheory Limits AlgebraicGeometry

universe u

/-- An injective ring homomorphism `φ : R ⟶ S` induces a scheme-theoretically dominant morphism
`Spec.map φ : Spec S ⟶ Spec R`: the associated map on structure sheaves has trivial kernel.

Indeed, the topological kernel of `Spec.map φ` is the ideal sheaf generated by `ker φ = 0`. -/
theorem isSchemeTheoreticallyDominant_specMap {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (hφ : Function.Injective φ) : IsSchemeTheoreticallyDominant (Spec.map φ) := by
  rw [isSchemeTheoreticallyDominant_iff, Scheme.ker_of_isAffine]
  -- The map on global sections of `Spec.map φ` is `φ` conjugated by the canonical isomorphisms
  -- `Γ(Spec R, ⊤) ≅ R` and `Γ(Spec S, ⊤) ≅ S`.
  have htop : Scheme.Hom.appTop (Spec.map φ)
      = (Scheme.ΓSpecIso R).hom ≫ φ ≫ (Scheme.ΓSpecIso S).inv := by
    have hnat := Scheme.toSpecΓ_naturality (Spec.map φ)
    rw [← SpecMap_ΓSpecIso_hom R, ← SpecMap_ΓSpecIso_hom S, ← Spec.map_comp,
      ← Spec.map_comp] at hnat
    have h := Spec.map_injective hnat
    rw [← Category.assoc, h, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hker : RingHom.ker (CommRingCat.Hom.hom (Scheme.Hom.appTop (Spec.map φ))) = ⊥ := by
    rw [← RingHom.injective_iff_ker_eq_bot, htop, CommRingCat.hom_comp, CommRingCat.hom_comp]
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso S).inv).1.comp
      (hφ.comp (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).hom).1)
  rw [hker]
  apply Scheme.IdealSheafData.ext_of_isAffine
  rw [Scheme.IdealSheafData.ofIdealTop_ideal]
  simp

theorem chart_app_injective {Γ : Type u} [Group Γ] [Fintype Γ] {X : AlgebraicGeometry.Scheme.{u}}
    (A : Work.SymQuot.GAction Γ X) {U : X.Opens} (hUa : AlgebraicGeometry.IsAffineOpen U)
    (hUi : A.IsInvariantOpen U) (P : (A.chart U hUi).Opens) :
    Function.Injective ⇑((A.chartMap U hUi).app P) := by
  -- The chart map is `U.toSpecΓ` followed by `Spec` of the inclusion `Γ(X,U)^G ↪ Γ(X,U)`.
  have hdom : IsSchemeTheoreticallyDominant
      (Spec.map (CommRingCat.ofHom (Subring.subtype (Work.SymQuot.GAction.invariants A U hUi)))) :=
    isSchemeTheoreticallyDominant_specMap _ (Subring.subtype_injective _)
  -- Hence its sections are injective, as `Spec` of an injective ring homomorphism.
  have hap : Function.Injective ⇑((Spec.map (CommRingCat.ofHom
      (Subring.subtype (Work.SymQuot.GAction.invariants A U hUi)))).app P) :=
    @Scheme.Hom.app_injective _ _ _ hdom inferInstance P
  -- The other factor `U.toSpecΓ` is an isomorphism because `U` is affine.
  have hiso : IsIso U.toSpecΓ := by
    rw [← IsAffineOpen.isoSpec_hom hUa]; infer_instance
  have h2 : Function.Injective ⇑((U.toSpecΓ).app
      ((Spec.map (CommRingCat.ofHom
        (Subring.subtype (Work.SymQuot.GAction.invariants A U hUi)))) ⁻¹ᵁ P)) :=
    (ConcreteCategory.bijective_of_isIso _).1
  rw [Work.SymQuot.GAction.chartMap]
  intro x y hxy
  simp only [Scheme.Hom.comp_app] at hxy
  exact hap (h2 hxy)

end Work.SymQuot.Chart
