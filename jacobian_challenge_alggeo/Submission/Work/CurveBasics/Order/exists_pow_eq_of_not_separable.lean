set_option autoImplicit false
set_option linter.style.haveILetI false

open scoped IntermediateField.algebraAdjoinAdjoin
open IntermediateField

universe u

namespace Work.CurveBasics.Order

/-- **Field-theoretic core of `exists_pow_eq_of_not_separable`.**  Let `k` be a perfect field of
characteristic `p > 0`, let `F/k` be a field extension and `h ∈ F` transcendental over `k` such
that `F/k(h)` is finite.  If `F/k(h)` is not separable, then `h` is a `p`-th power in `F`. -/
theorem exists_pow_eq_of_not_separable_aux {k F : Type u} [Field k] [PerfectField k] [Field F]
    [Algebra k F] {h : F} (hh : Transcendental k h) {p : ℕ} [CharP k p] (hp : p.Prime)
    (hfin : FiniteDimensional ↥(IntermediateField.adjoin k ({h} : Set F)) F)
    (hns : ¬ Algebra.IsSeparable ↥(IntermediateField.adjoin k ({h} : Set F)) F) :
    ∃ u : F, u ^ p = h := by
  classical
  -- characteristic hypotheses
  haveI hExpk : ExpChar k p := (expChar_prime_iff (R := k) hp).mpr ‹CharP k p›
  haveI hCharF : CharP F p := charP_of_injective_algebraMap (algebraMap k F).injective p
  haveI hExpF : ExpChar F p := (expChar_prime_iff (R := F) hp).mpr hCharF
  -- `K = k(h)`, and the separable closure of `K` in `F`
  let K : IntermediateField k F := IntermediateField.adjoin k ({h} : Set F)
  haveI hAlg : Algebra.IsAlgebraic ↥K F := Algebra.IsAlgebraic.of_finite ↥K F
  let L : IntermediateField ↥K F := separableClosure ↥K F
  have hLtop : L ≠ ⊤ := fun htop => hns ((separableClosure.eq_top_iff ↥K F).mp htop)
  let Lk : IntermediateField k F := L.restrictScalars k
  have hmem : ∀ x : F, x ∈ Lk ↔ IsSeparable ↥K x := fun _ => Iff.rfl
  have hhK : h ∈ K := IntermediateField.subset_adjoin k _ (Set.mem_singleton h)
  have hKL : K ≤ Lk := by
    intro x hx
    rw [hmem]
    exact isSeparable_algebraMap (F := ↥K) ⟨x, hx⟩
  by_contra hcon
  -- `h` is not a `p`-th power in `F`
  have hnotFp : h ∉ pthPowers p (⊤ : IntermediateField k F) := by
    intro hmem'
    obtain ⟨u, -, hu⟩ := mem_pthPowers.mp hmem'
    exact hcon ⟨u, hu⟩
  -- `L` is generated by `K` and its own `p`-th powers
  have hLk_sup : Lk = K ⊔ pthPowers p Lk :=
    le_antisymm (le_sup_pthPowers_of_isSeparable hKL (fun x hx => (hmem x).mp hx))
      (sup_le hKL (pthPowers_le p Lk))
  set A : IntermediateField k F := pthPowers p Lk with hA
  have hhLk : h ∈ Lk := hKL hhK
  have hhA : h ∉ A := fun hx => hnotFp (pthPowers_mono le_top hx)
  have hAh : h ^ p ∈ A := pow_mem_pthPowers hhLk
  have hALk : A ≤ Lk := pthPowers_le p Lk
  -- `A(h) = L`, so `[L : A] = p`
  have hAh_eq : IntermediateField.extendScalars hALk
      = IntermediateField.adjoin ↥A ({h} : Set F) := by
    refine IntermediateField.restrictScalars_injective k ?_
    rw [IntermediateField.extendScalars_restrictScalars,
      IntermediateField.restrictScalars_adjoin_eq_sup, sup_comm, ← hLk_sup]
  have hdegeq : A.relfinrank Lk = p := by
    rw [IntermediateField.relfinrank_eq_finrank_of_le hALk, hAh_eq]
    exact finrank_adjoin_pow_eq_prime hp hAh hhA
  -- `F/L` is purely inseparable, so (as `L ≠ F`) there is `b ∈ F ∖ L` with `b ^ p ∈ L`, and `b`
  -- itself is not a `p`-th power in `F`
  haveI hCharK : CharP ↥K p := charP_of_injective_algebraMap (algebraMap k ↥K).injective p
  haveI hCharL : CharP ↥L p := charP_of_injective_algebraMap (algebraMap ↥K ↥L).injective p
  haveI hExpL : ExpChar ↥L p := (expChar_prime_iff (R := ↥L) hp).mpr hCharL
  haveI hPurely : IsPurelyInseparable ↥L F := separableClosure.isPurelyInseparable ↥K F
  obtain ⟨a, haL⟩ : ∃ a : F, a ∉ L := by
    by_contra h'
    exact hLtop (top_le_iff.mp fun x _ => by
      by_contra hx
      exact h' ⟨x, hx⟩)
  have hex : ∃ n : ℕ, a ^ p ^ n ∈ L := by
    obtain ⟨n, hn⟩ := (isPurelyInseparable_iff_pow_mem ↥L p).mp hPurely a
    obtain ⟨y, hy⟩ := hn
    exact ⟨n, by rw [← hy]; exact y.2⟩
  set n := Nat.find hex with hn_def
  have hn : a ^ p ^ n ∈ L := Nat.find_spec hex
  have hmin : ∀ m < n, a ^ p ^ m ∉ L := fun m hm => Nat.find_min hex hm
  have hnpos : 0 < n := by
    by_contra hnp
    have hn0 : n = 0 := Nat.eq_zero_of_not_pos hnp
    rw [hn0] at hn
    exact haL (by simpa using hn)
  let b : F := a ^ p ^ (n - 1)
  have hbL : b ∉ L := by
    intro hcon'
    exact hmin (n - 1) (Nat.sub_one_lt (Nat.pos_iff_ne_zero.mp hnpos)) (by simpa [b] using hcon')
  have hbpL : b ^ p ∈ L := by
    have hbp : b ^ p = a ^ p ^ n := by
      simp only [b]
      rw [← pow_mul, ← pow_succ, Nat.sub_add_cancel hnpos]
    rw [hbp]; exact hn
  have hbLk : b ∉ Lk := fun hx => hbL hx
  have hbpLk : b ^ p ∈ Lk := hbpL
  -- the `p`-th powers of `M = L(b)` are contained in `L`
  set Mk : IntermediateField k F := Lk ⊔ IntermediateField.adjoin k ({b} : Set F) with hMk
  have hMp_le : pthPowers p Mk ≤ Lk := pthPowers_sup_adjoin_le hbpLk
  have hA_le_Mp : A ≤ pthPowers p Mk := pthPowers_mono le_sup_left
  -- the tower law of relative degrees, and `[L : A] = p` prime
  have htower : A.relfinrank (pthPowers p Mk) * (pthPowers p Mk).relfinrank Lk = p := by
    rw [IntermediateField.relfinrank_mul_relfinrank hA_le_Mp hMp_le, hdegeq]
  have hcases : A.relfinrank (pthPowers p Mk) = 1 ∨ (pthPowers p Mk).relfinrank Lk = 1 := by
    have hdvd : A.relfinrank (pthPowers p Mk) ∣ p := ⟨_, htower.symm⟩
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | hp'
    · exact Or.inl h1
    · right
      rw [hp'] at htower
      exact Nat.mul_left_cancel hp.pos (by rw [mul_one]; exact htower)
  rcases hcases with h1 | h1
  · -- `M ^ p = A`: then `b ^ p` is a `p`-th power in `L`, so `b ∈ L`, contradiction
    have hMpeq : pthPowers p Mk = A :=
      le_antisymm (IntermediateField.relfinrank_eq_one_iff.mp h1) hA_le_Mp
    have hbpA : b ^ p ∈ A := by
      rw [← hMpeq]
      exact pow_mem_pthPowers ((le_sup_right : IntermediateField.adjoin k ({b} : Set F)
        ≤ Lk ⊔ IntermediateField.adjoin k ({b} : Set F))
          (IntermediateField.subset_adjoin k _ (Set.mem_singleton b)))
    obtain ⟨z, hzLk, hz⟩ := mem_pthPowers.mp hbpA
    exact hbLk (by rw [← pow_p_eq_pow_p_iff.mp hz]; exact hzLk)
  · -- `M ^ p = L`: then `h` is a `p`-th power, contradiction
    have hMpeq : pthPowers p Mk = Lk :=
      le_antisymm hMp_le (IntermediateField.relfinrank_eq_one_iff.mp h1)
    have hhMp : h ∈ pthPowers p Mk := by rw [hMpeq]; exact hhLk
    obtain ⟨u, -, hu⟩ := mem_pthPowers.mp hhMp
    exact hcon ⟨u, hu⟩

theorem exists_pow_eq_of_not_separable {k : Type u} [Field k] [PerfectField k]
    (C : Work.CurveBasics.Curve k) (h : C.functionField) (hh : Transcendental k h)
    {p : ℕ} [CharP k p] (hp : p.Prime)
    (hns : ¬ Algebra.IsSeparable
      ↥(IntermediateField.adjoin k ({h} : Set ↥C.functionField)) ↥C.functionField) :
    ∃ u : C.functionField, u ^ p = h :=
  exists_pow_eq_of_not_separable_aux (F := C.functionField) hh hp
    (finiteDimensional_adjoin_functionField C hh) hns

end Work.CurveBasics.Order
