# The degree of the divisor of zeros is the degree of the function field

Let `C` be a smooth, proper, geometrically irreducible curve over a field `k` and let
`h ∈ K(C)` be transcendental over `k` with `[K(C) : k(h)]` finite.  The main theorem of this
file states

`∑_{Q : ord_Q h > 0} ord_Q(h) · [κ(Q) : k] = [K(C) : k(h)]`,

i.e. the degree of the divisor of zeros of `h` equals the degree of the field extension
`k(h) ⊆ K(C)`.

This is a generalisation of `Work.CurveBasics.Order.sum_ord_pos_eq_finrank`, which assumes in
addition that `K(C)/k(h)` is separable: here no separability is assumed, and the proof therefore
cannot use `IsIntegralClosure.finite` (which requires separability).

## Strategy

Let `A = k[h] ⊆ K = K(C)` be the subalgebra generated by `h` and let `B = A^int` be the integral
closure of `A` in `K`.  Then:

* `B` is a finite flat `A`-algebra (`ordClosure_finite`, `ordClosure_flat`);
* `A` is a PID, so `B` is free of rank `[K : k(h)]` (`ordClosure_finrank`);
* the sum over the primes `q` of `B` above `(h)`, of `e(q|(h))·f(q|(h))`, equals the sum over
  the zeros of `h` of `ord_Q(h)·[κ(Q) : k]` (`sum_primesOver_eq_sum_ord`);
* Mathlib's `Ideal.sum_ramification_inertia_eq_finrank` computes the same sum as the rank.
-/
import Mathlib
import Submission.Work.CurveBasics.Order.Setup
import Submission.Work.CurveBasics.Order.ordPosSetup
import Submission.Work.CurveBasics.Place.degree_eq_finrank
import Submission.Work.CurveBasics.Order.ordClosure_finite
import Submission.Work.CurveBasics.Order.sum_primesOver_eq_sum_ord

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


set_option autoImplicit false
set_option linter.style.haveILetI false

open CategoryTheory Limits AlgebraicGeometry
open scoped Classical IntermediateField.algebraAdjoinAdjoin nonZeroDivisors

universe u

namespace Work.CurveBasics.Order

open Work.CurveBasics

noncomputable section

variable {k : Type u} [Field k]

/-- The ideal `(h) ⊆ k[h]` is prime. -/
theorem ordIdeal_isPrime (C : Curve k) (h : C.functionField) (hh : Transcendental k h) :
    (C.ordIdeal h).IsPrime :=
  Curve.kx_span_gen_isPrime C h hh

/-- The integral closure of `k[h]` in `K(C)` is flat over `k[h]` as soon as it is finite: it is
torsion-free and `k[h]` is a principal ideal ring. -/
theorem ordClosure_flat (C : Curve k) (h : C.functionField)
    [Module.Finite (C.ordBase h) (C.ordClosure h)] :
    Module.Flat (C.ordBase h) (C.ordClosure h) :=
  inferInstance

/-- There are only finitely many primes of the integral closure above `(h)`. -/
noncomputable def ordIdeal_primesOver_fintype (C : Curve k) (h : C.functionField)
    [Module.Finite (C.ordBase h) (C.ordClosure h)] :
    Fintype ((C.ordIdeal h).primesOver (C.ordClosure h)) :=
  (Algebra.QuasiFinite.finite_primesOver (C.ordIdeal h)).fintype

/-- The rank of the integral closure of `k[h]` over `k[h]` is the degree `[K(C) : k(h)]`.

No separability is needed: `B` is a finitely generated torsion-free module over the principal
ideal ring `k[h]`, hence free, and `B` localised at the non-zero elements of `k[h]` is `K(C)`. -/
theorem ordClosure_finrank (C : Curve k) (h : C.functionField)
    [FiniteDimensional (IntermediateField.adjoin k ({h} : Set C.functionField)) C.functionField]
    [Module.Finite (C.ordBase h) (C.ordClosure h)] :
    Module.finrank (C.ordBase h) (C.ordClosure h)
      = Module.finrank (IntermediateField.adjoin k ({h} : Set C.functionField))
          C.functionField := by
  haveI : Module.Free (C.ordBase h) (C.ordClosure h) :=
    (Module.free_iff_isTorsionFree).mpr inferInstance
  haveI : Algebra.IsAlgebraic (↥(IntermediateField.adjoin k ({h} : Set C.functionField)) : Type _)
      (↥C.functionField : Type _) := Algebra.IsAlgebraic.of_finite _ _
  haveI : IsLocalization
      (Algebra.algebraMapSubmonoid (C.ordClosure h) (C.ordBase h)⁰) C.functionField :=
    IsIntegralClosure.isLocalization (C.ordBase h)
      (↥(IntermediateField.adjoin k ({h} : Set C.functionField)) : Type _) C.functionField
      (C.ordClosure h)
  let b := Module.Basis.localizationLocalization
    (↥(IntermediateField.adjoin k ({h} : Set C.functionField)) : Type _)
    (C.ordBase h)⁰ C.functionField
    (Module.Free.chooseBasis (C.ordBase h) (C.ordClosure h))
  rw [Module.finrank_eq_card_chooseBasisIndex (R := C.ordBase h),
    Module.finrank_eq_card_basis b]

/-- The sum of `e·f` over the primes of the integral closure above `(h)`, computed by
`Ideal.sum_ramification_inertia_eq_finrank`, is the degree `[K(C) : k(h)]`. -/
theorem sum_ramification_inertia_eq_finrank_curve_general (C : Curve k) (h : C.functionField)
    (hh : Transcendental k h)
    [FiniteDimensional (IntermediateField.adjoin k ({h} : Set C.functionField)) C.functionField]
    [Module.Finite (C.ordBase h) (C.ordClosure h)]
    [Fintype ((C.ordIdeal h).primesOver (C.ordClosure h))] :
    (∑ q : (C.ordIdeal h).primesOver (C.ordClosure h),
        ((q.1.ramificationIdx (C.ordBase h) : ℤ) * (q.1.inertiaDeg (C.ordBase h) : ℤ)))
      = (Module.finrank (IntermediateField.adjoin k ({h} : Set C.functionField))
          C.functionField : ℤ) := by
  haveI hprime : (C.ordIdeal h).IsPrime := ordIdeal_isPrime C h hh
  haveI hflat : Module.Flat (C.ordBase h) (C.ordClosure h) := ordClosure_flat C h
  have hmain : (∑ q : (C.ordIdeal h).primesOver (C.ordClosure h),
        ((q.1.ramificationIdx (C.ordBase h) : ℤ) * (q.1.inertiaDeg (C.ordBase h) : ℤ)))
      = (Module.finrank (C.ordBase h) (C.ordClosure h) : ℤ) := by
    have h := Ideal.sum_ramification_inertia_eq_finrank (C.ordIdeal h) (C.ordClosure h)
    rw [← h, Nat.cast_sum]
    exact Finset.sum_congr rfl fun q _ => by simp [Nat.cast_mul]
  rw [hmain, ordClosure_finrank C h]

open Work.CurveBasics in
theorem sum_ord_pos_eq_finrank_general {k : Type*} [Field k] (C : Curve k) (h : C.functionField)
    (hh : Transcendental k h)
    [FiniteDimensional (IntermediateField.adjoin k ({h} : Set C.functionField)) C.functionField] :
    ∑ Q ∈ (C.finite_support_ordAt h).toFinset.filter (fun Q => 0 < C.ordAt h Q),
        C.ordAt h Q * (C.hom.residueDegree Q.point : ℤ)
      = (Module.finrank (IntermediateField.adjoin k ({h} : Set C.functionField))
          C.functionField : ℤ) := by
  haveI hfin : Module.Finite (C.ordBase h) (C.ordClosure h) := ordClosure_finite C h hh
  haveI hft : Fintype ((C.ordIdeal h).primesOver (C.ordClosure h)) :=
    ordIdeal_primesOver_fintype C h
  rw [(sum_primesOver_eq_sum_ord C h hh).symm,
    sum_ramification_inertia_eq_finrank_curve_general C h hh]

end

end Work.CurveBasics.Order
