open Curve in
theorem isDedekindDomain_kxClosure (C : Curve k) (x : C.functionField)
    (hx : Transcendental k x)
    [FiniteDimensional (IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField] :
    IsDedekindDomain ↥(kxInt C x) := by
  haveI hNoeth : IsNoetherianRing ↥(kxInt C x) :=
    isNoetherianRing_integralClosure_of_isFractionRing
      (A := ↥(Algebra.adjoin k ({x} : Set C.functionField)))
      (K := ↥(IntermediateField.adjoin k ({x} : Set C.functionField)))
      (L := C.functionField)
  haveI hFrac : IsFractionRing ↥(kxInt C x) C.functionField :=
    integralClosure.isFractionRing_of_finite_extension
      (A := ↥(Algebra.adjoin k ({x} : Set C.functionField)))
      (K := ↥(IntermediateField.adjoin k ({x} : Set C.functionField))) (L := C.functionField)
  haveI hIC : IsIntegrallyClosed ↥(kxInt C x) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension
      (K := ↥(IntermediateField.adjoin k ({x} : Set C.functionField)))
  exact (isDedekindDomain_iff ↥(kxInt C x) C.functionField).mpr
    ⟨inferInstance, hNoeth, inferInstance,
      fun {y} hy => (isIntegrallyClosed_iff C.functionField).mp hIC hy⟩

open Curve in
theorem kxClosure_residue_surjective_aux (C : Curve k) (x : C.functionField)
    (hx : Transcendental k x)
    [FiniteDimensional (IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField]
    (Q : C.Place) (hQ : 0 < C.ordAt x Q) :
    Function.Surjective fun b : ↥(kxInt C x) =>
      IsLocalRing.residue ↥(Q.valuationSubring) ⟨(b : C.functionField), kxClosure_le_valuationSubring C x Q hQ.le b.2⟩ := by
  classical
  haveI hFrac : IsFractionRing ↥(kxInt C x) C.functionField :=
    integralClosure.isFractionRing_of_finite_extension
      (A := ↥(Algebra.adjoin k ({x} : Set C.functionField)))
      (K := ↥(IntermediateField.adjoin k ({x} : Set C.functionField))) (L := C.functionField)
  haveI hDed : IsDedekindDomain ↥(kxInt C x) := isDedekindDomain_kxClosure C x hx
  have hWne : Q.valuationSubring ≠ ⊤ := by
    intro htop
    have hx0 : x ≠ 0 := fun h => hx (h ▸ isAlgebraic_zero)
    have hxmem : x ∈ Q.valuationSubring := by
      rw [Place.mem_valuationSubring_iff]; change 0 ≤ C.ordAt x Q; linarith
    have hinv : x⁻¹ ∈ Q.valuationSubring := by rw [htop]; trivial
    rw [Place.mem_valuationSubring_iff] at hinv
    change 0 ≤ C.ordAt x⁻¹ Q at hinv
    rw [C.ordAt_inv hx0] at hinv
    linarith
  let q : Ideal (kxInt C x) := kxPrimeOfPlace C x Q hQ.le
  have hqprime : q.IsPrime := kxPrimeOfPlace_isPrime C x Q hQ.le
  have hqne : q ≠ ⊥ := by
    change kxPrimeOfPlace C x Q hQ.le ≠ ⊥
    intro hbot
    have hgen : algebraMap ↥(Algebra.adjoin k ({x} : Set C.functionField)) (kxInt C x)
        (Curve.kxGen C x) ∈ kxPrimeOfPlace C x Q hQ.le :=
      kxGen_mem_kxPrimeOfPlace C x hx Q hQ
    rw [hbot, Ideal.mem_bot] at hgen
    have h0 : (↑(Curve.kxGen C x) : C.functionField) = 0 := by
      change (algebraMap ↥(Algebra.adjoin k ({x} : Set C.functionField)) C.functionField)
        (Curve.kxGen C x) = 0
      rw [IsScalarTower.algebraMap_apply ↥(Algebra.adjoin k ({x} : Set C.functionField))
        (kxInt C x) C.functionField, hgen, map_zero]
    exact hx.ne_zero h0
  haveI hqmax : q.IsMaximal := hqprime.isMaximal hqne
  let v : IsDedekindDomain.HeightOneSpectrum (kxInt C x) := ⟨q, hqprime, hqne⟩
  let hle := kxClosure_le_valuationSubring C x Q hQ.le
  let phi : (kxInt C x) →+* ↥(Q.valuationSubring) := Subring.inclusion hle
  have hVeq : Q.valuationSubring =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime C.functionField v :=
    valuationSubring_eq_atPrime (A := kxInt C x) (K := C.functionField) q hqprime hqne hWne
      phi (fun a => by simp only [phi]; rfl) rfl
  let psi : (kxInt C x) →+* IsLocalRing.ResidueField ↥(Q.valuationSubring) :=
    (IsLocalRing.residue ↥(Q.valuationSubring)).comp phi
  have hker : RingHom.ker psi = q := by
    show RingHom.ker ((IsLocalRing.residue ↥(Q.valuationSubring)).comp phi) = q
    rw [← RingHom.comap_ker (IsLocalRing.residue ↥(Q.valuationSubring)) phi, IsLocalRing.ker_residue]
    rfl
  suffices Function.Surjective psi by
    intro c
    obtain ⟨b, hb⟩ := this c
    exact ⟨b, hb⟩
  intro c
  obtain ⟨y, hy⟩ := IsLocalRing.residue_surjective c
  rw [← hy]
  have hy_mem : (y : C.functionField) ∈
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime C.functionField v := by
    rw [← hVeq]; exact y.2
  have hy_le : IsDedekindDomain.HeightOneSpectrum.valuation C.functionField v (y : C.functionField) ≤ 1 := by
    rw [IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime_eq_valuationSubring] at hy_mem
    exact (Valuation.mem_valuationSubring_iff _ _).mp hy_mem
  obtain ⟨n, d, hnd⟩ :=
    IsDedekindDomain.HeightOneSpectrum.exists_primeCompl_mul_eq_of_integer v (y : C.functionField) hy_le
  have hd_notMem : (d : kxInt C x) ∉ q := d.2
  obtain ⟨s', i, hi, hsi⟩ := hqmax.exists_inv hd_notMem
  have hs'i : (d : kxInt C x) * s' - 1 ∈ q := by
    have h2 : (d : kxInt C x) * s' - 1 = -i := by
      rw [show (d : kxInt C x) * s' = 1 - i by
            rw [mul_comm (d : kxInt C x) s', eq_sub_iff_add_eq, hsi],
          show (1 : kxInt C x) - i - 1 = -i by ring]
    rw [h2]; exact neg_mem hi
  have hψ1 : psi ((d : kxInt C x) * s') = 1 := by
    have h : psi ((d : kxInt C x) * s' - 1) = 0 := by
      rw [← RingHom.mem_ker, hker]
      exact hs'i
    rw [show psi ((d : kxInt C x) * s' - 1)
        = psi ((d : kxInt C x) * s') - psi 1 from map_sub psi _ _, map_one, sub_eq_zero] at h
    exact h
  have hψm : psi (d : kxInt C x) * psi s' = 1 := by
    rw [← map_mul]; exact hψ1
  have hO : y * phi (d : kxInt C x) = phi n := by
    apply Subtype.ext
    show (y : C.functionField) * (d : C.functionField) = (n : C.functionField)
    exact hnd
  have hres : IsLocalRing.residue ↥(Q.valuationSubring) y * psi (d : kxInt C x) = psi n := by
    have h := congrArg (IsLocalRing.residue ↥(Q.valuationSubring)) hO
    simpa only [psi, RingHom.comp_apply, map_mul] using h
  refine ⟨n * s', ?_⟩
  rw [map_mul, ← hres, mul_assoc, hψm, mul_one]



/-- The image of `c : k` under `k → κ(Q)` is the residue of the germ of the corresponding
constant section of `C`. -/
lemma algebraMap_residueField_eq_germ (C : Curve k) (Q : C.Place) (c : k) :
    algebraMap k (C.left.residueField Q.point) c =
      C.left.residue Q.point (C.left.presheaf.germ (⊤ : C.left.Opens) Q.point trivial
        (C.hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c))) := by
  simp only [RingHom.algebraMap_toAlgebra, ConcreteCategory.comp_apply]
  rw [Scheme.Γevaluation_naturality_apply]
  rfl

/-- The underlying element of the field of fractions of
`IsDiscreteValuationRing.equivValuationSubring`. -/
theorem equivValuationSubring_coe_aux {A K : Type*} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [Field K] [Algebra A K] [IsFractionRing A K] (x : A) :
    ((IsDiscreteValuationRing.equivValuationSubring (A := A) (K := K) x :
        ↥((IsDiscreteValuationRing.maximalIdeal A).valuation K).valuationSubring) : K) =
      algebraMap A K x := by
  rw [IsDiscreteValuationRing.equivValuationSubring]; rfl

open Curve in
theorem kernelPrimeResidueField_finrank {k : Type*} [Field k] (C : Curve k)
    (x : C.functionField) (hx : Transcendental k x)
    [FiniteDimensional (IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField]
    (Q : C.Place) (hQ : 0 < C.ordAt x Q) :
    Module.finrank k (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le)
      = C.hom.residueDegree Q.point := by
  classical
  haveI hDVR : IsDiscreteValuationRing (C.left.presheaf.stalk Q.point) :=
    Place.isDiscreteValuationRing Q
  -- the `k`-algebra structure on the valuation subring, induced by the constants `k ⊆ K(C)`
  letI instAlgO : Algebra k ↥(Q.valuationSubring) :=
    ((algebraMap k C.functionField).codRestrict Q.valuationSubring
      (fun c => Curve.Place.algebraMap_mem_valuationSubring C Q c)).toAlgebra
  have hO_coe (c : k) :
      ((algebraMap k ↥(Q.valuationSubring) c : ↥(Q.valuationSubring)) : C.functionField) =
        algebraMap k C.functionField c := rfl
  -- the ring isomorphism between the local ring at `Q` and the valuation subring
  let E : (C.left.presheaf.stalk Q.point) ≃+* ↥(Q.valuationSubring) :=
    IsDiscreteValuationRing.equivValuationSubring (A := C.left.presheaf.stalk Q.point)
      (K := C.functionField)
  have hE_coe (y : C.left.presheaf.stalk Q.point) :
      ((E y : ↥(Q.valuationSubring)) : C.functionField) =
        algebraMap (C.left.presheaf.stalk Q.point) C.functionField y := by
    dsimp only [E]
    exact equivValuationSubring_coe_aux y
  -- the constant section of `C` at `Q` corresponds to the constant of `K(C)`
  have hE_germ (c : k) :
      E (C.left.presheaf.germ (⊤ : C.left.Opens) Q.point trivial
        (C.hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c))) =
        algebraMap k ↥(Q.valuationSubring) c := by
    apply Subtype.ext
    rw [hE_coe, hO_coe,
      Scheme.algebraMap_germ_eq_germToFunctionField (X := C.left) (U := ⊤) (x := Q.point) trivial]
    simp only [RingHom.algebraMap_toAlgebra, ConcreteCategory.comp_apply]
  -- the induced isomorphism of residue fields is `k`-linear
  have hmlin (c : k) : IsLocalRing.ResidueField.mapEquiv E
      (algebraMap k ↑(C.left.residueField Q.point) c) =
      algebraMap k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) c := by
    rw [algebraMap_residueField_eq_germ C Q c]
    show IsLocalRing.ResidueField.mapEquiv E
        (IsLocalRing.residue (C.left.presheaf.stalk Q.point)
          (C.left.presheaf.germ (⊤ : C.left.Opens) Q.point trivial
            (C.hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c)))) = _
    rw [IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue]
    show IsLocalRing.residue ↥(Q.valuationSubring)
        (E (C.left.presheaf.germ (⊤ : C.left.Opens) Q.point trivial
          (C.hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c)))) = _
    rw [hE_germ, IsScalarTower.algebraMap_apply k ↥(Q.valuationSubring)
        (IsLocalRing.ResidueField ↥(Q.valuationSubring)),
      IsLocalRing.ResidueField.algebraMap_eq]
  let eRF : ↑(C.left.residueField Q.point) ≃ₗ[k]
      IsLocalRing.ResidueField ↥(Q.valuationSubring) :=
    LinearEquiv.ofBijective
      ({ toFun := fun y : ↑(C.left.residueField Q.point) =>
          IsLocalRing.ResidueField.mapEquiv E y
         map_add' := fun a b => map_add _ a b
         map_smul' := fun m y => by
           have h1 : m • y = algebraMap k ↑(C.left.residueField Q.point) m * y :=
             Algebra.smul_def m y
           have h2 : (RingHom.id k) m • IsLocalRing.ResidueField.mapEquiv E y =
               algebraMap k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) m *
                 IsLocalRing.ResidueField.mapEquiv E y := by
             rw [Algebra.smul_def, RingHom.id_apply]
           calc IsLocalRing.ResidueField.mapEquiv E (m • y)
               = IsLocalRing.ResidueField.mapEquiv E
                   (algebraMap k ↑(C.left.residueField Q.point) m * y) :=
                 congrArg (IsLocalRing.ResidueField.mapEquiv E) h1
             _ = IsLocalRing.ResidueField.mapEquiv E
                   (algebraMap k ↑(C.left.residueField Q.point) m) *
                 IsLocalRing.ResidueField.mapEquiv E y :=
                 map_mul (IsLocalRing.ResidueField.mapEquiv E) _ _
             _ = algebraMap k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) m *
                 IsLocalRing.ResidueField.mapEquiv E y :=
                 congrArg (fun z => z * IsLocalRing.ResidueField.mapEquiv E y) (hmlin m)
             _ = (RingHom.id k) m • IsLocalRing.ResidueField.mapEquiv E y := h2.symm } :
        ↑(C.left.residueField Q.point) →ₗ[k] IsLocalRing.ResidueField ↥(Q.valuationSubring))
      ⟨fun x y h => RingEquiv.injective _ h, fun y => RingEquiv.surjective _ y⟩
  -- ### the residue map on the integral closure
  let hle := kxClosure_le_valuationSubring C x Q hQ.le
  let φ : C.ordClosure x →+* IsLocalRing.ResidueField ↥(Q.valuationSubring) :=
    (IsLocalRing.residue ↥(Q.valuationSubring)).comp (Subring.inclusion hle)
  have hφ_smul (c : k) : φ (algebraMap k (C.ordClosure x) c) =
      algebraMap k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) c := by
    have h1 : ((algebraMap k (C.ordClosure x) c : C.ordClosure x) : C.functionField) =
        algebraMap k C.functionField c := rfl
    have h2 : Subring.inclusion hle (algebraMap k (C.ordClosure x) c) =
        (⟨algebraMap k C.functionField c,
          Curve.Place.algebraMap_mem_valuationSubring C Q c⟩ : ↥(Q.valuationSubring)) :=
      Subtype.ext (by rw [Subring.coe_inclusion]; exact h1)
    show IsLocalRing.residue ↥(Q.valuationSubring)
        (Subring.inclusion hle (algebraMap k (C.ordClosure x) c)) = _
    rw [h2, IsScalarTower.algebraMap_apply k ↥(Q.valuationSubring)
        (IsLocalRing.ResidueField ↥(Q.valuationSubring)),
      IsLocalRing.ResidueField.algebraMap_eq]
    rfl
  have hker : RingHom.ker φ = kxPrimeOfPlace C x Q hQ.le := by
    show RingHom.ker ((IsLocalRing.residue ↥(Q.valuationSubring)).comp
      (Subring.inclusion hle)) = _
    rw [← RingHom.comap_ker (IsLocalRing.residue ↥(Q.valuationSubring))
      (Subring.inclusion hle), IsLocalRing.ker_residue]
    rfl
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨b, hb⟩ := kxClosure_residue_surjective_aux C x hx Q hQ y
    refine ⟨b, ?_⟩
    show IsLocalRing.residue ↥(Q.valuationSubring) (Subring.inclusion hle b) = y
    rw [show Subring.inclusion hle b =
        (⟨(b : C.functionField), hle b.2⟩ : ↥(Q.valuationSubring)) from
      Subtype.ext (by rw [Subring.coe_inclusion])]
    exact hb
  have hker' (a : C.ordClosure x) : φ a = 0 ↔ a ∈ kxPrimeOfPlace C x Q hQ.le := by
    rw [← RingHom.mem_ker, hker]
  let Φ : (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le) →+*
      IsLocalRing.ResidueField ↥(Q.valuationSubring) :=
    Ideal.Quotient.lift _ φ (fun a ha => (hker' a).mpr ha)
  have hΦmk (b : C.ordClosure x) : Φ (Ideal.Quotient.mk _ b) = φ b :=
    Ideal.Quotient.lift_mk _ φ _
  have hΦsurj : Function.Surjective Φ := by
    intro y
    obtain ⟨b, hb⟩ := hsurj y
    exact ⟨Ideal.Quotient.mk _ b, by rw [hΦmk]; exact hb⟩
  have hΦinj : Function.Injective Φ := by
    intro a b hab
    obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨b', rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [hΦmk a', hΦmk b'] at hab
    refine (Ideal.Quotient.mk_eq_mk_iff_sub_mem (I := kxPrimeOfPlace C x Q hQ.le) a' b').mpr ?_
    rw [← hker' (a' - b')]
    have hsub : φ (a' - b') = φ a' - φ b' := map_sub φ a' b'
    rw [hsub, hab, sub_self]
  have hfin1 : Module.finrank k (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le) =
      Module.finrank k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) := by
    refine Algebra.finrank_eq_of_equiv_equiv (RingEquiv.refl k)
      (RingEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩) ?_
    ext c
    show algebraMap k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) c
      = Φ (algebraMap k (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le) c)
    rw [show algebraMap k (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le) c
        = Ideal.Quotient.mk _ (algebraMap k (C.ordClosure x) c) from rfl]
    rw [show Φ (Ideal.Quotient.mk _ (algebraMap k (C.ordClosure x) c))
        = φ (algebraMap k (C.ordClosure x) c) from hΦmk _]
    exact (hφ_smul c).symm
  calc Module.finrank k (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le)
      = Module.finrank k (IsLocalRing.ResidueField ↥(Q.valuationSubring)) := hfin1
    _ = Module.finrank k ↑(C.left.residueField Q.point) := eRF.finrank_eq.symm
    _ = C.hom.residueDegree Q.point := (Place.degree_eq_finrank Q).symm



lemma kxEvalZero_surjective' (C : Curve k) (x : C.functionField) (hx : Transcendental k x) :
    Function.Surjective (Curve.kxEvalZero C x hx).toRingHom :=
  fun c => ⟨algebraMap k (C.ordBase x) c, by
    simpa using (Curve.kxEvalZero C x hx).commutes c⟩

open Curve in
theorem inertiaDeg_kxPrimeOfPlace_eq_finrank_quotient {k : Type*} [Field k] (C : Curve k)
    (x : C.functionField) (hx : Transcendental k x)
    (Q : C.Place) (hQ : 0 < C.ordAt x Q) :
    (kxPrimeOfPlace C x Q hQ.le).inertiaDeg (C.ordBase x)
      = Module.finrank k (C.ordClosure x ⧸ kxPrimeOfPlace C x Q hQ.le) := by
  classical
  set P := kxPrimeOfPlace C x Q hQ.le with hPdef
  have hLies : P.LiesOver (C.ordIdeal x) := kxPrimeOfPlace_liesOver C x hx Q hQ
  have hPprime : P.IsPrime := kxPrimeOfPlace_isPrime C x Q hQ.le
  haveI hInt : Algebra.IsIntegral (C.ordBase x) (C.ordClosure x) :=
    IsIntegralClosure.isIntegral_algebra (R := C.ordBase x) (B := C.functionField)
  have hpbot : C.ordIdeal x = P.under (C.ordBase x) := hLies.over
  have hpmax : (P.under (C.ordBase x)).IsMaximal := hpbot ▸ kxIdeal_isMaximal C x hx
  haveI : (P.under (C.ordBase x)).IsMaximal := hpmax
  haveI : P.IsPrime := hPprime
  haveI : P.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal P (P.under (C.ordBase x))
  rw [Ideal.inertiaDeg_eq_of_isMaximal (P.under (C.ordBase x)) P]
  -- the `k`-algebra isomorphism `k[x] ⧸ (x) ≃+* k`
  have hker_lift : ∀ a ∈ P.under (C.ordBase x), (Curve.kxEvalZero C x hx).toRingHom a = 0 := by
    intro a ha
    have hspan : a ∈ Ideal.span {Curve.kxGen C x} := by
      have h2 : a ∈ C.ordIdeal x := by rw [hpbot]; exact ha
      exact h2
    have h3 : a ∈ RingHom.ker (Curve.kxEvalZero C x hx).toRingHom := by
      rwa [← Curve.kx_span_gen_eq_ker C x hx]
    exact h3
  let i : (C.ordBase x ⧸ P.under (C.ordBase x)) ≃+* k :=
    RingEquiv.ofBijective
      (Ideal.Quotient.lift (P.under (C.ordBase x)) (Curve.kxEvalZero C x hx).toRingHom hker_lift)
      ⟨(by
        intro a b hab
        obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
        obtain ⟨b', rfl⟩ := Ideal.Quotient.mk_surjective b
        rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk] at hab
        rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
        have h : a' - b' ∈ RingHom.ker (Curve.kxEvalZero C x hx).toRingHom := by
          rw [RingHom.mem_ker, map_sub, hab, sub_self]
        have h2 : a' - b' ∈ Ideal.span {Curve.kxGen C x} := by
          rwa [← Curve.kx_span_gen_eq_ker C x hx] at h
        have h3 : a' - b' ∈ C.ordIdeal x := h2
        rw [hpbot] at h3
        exact h3), (by
        intro c
        exact ⟨Ideal.Quotient.mk _ (algebraMap k (C.ordBase x) c), by
          rw [Ideal.Quotient.lift_mk]
          simpa using (Curve.kxEvalZero C x hx).commutes c⟩)⟩
  have hi_mk (y : C.ordBase x) :
      i (Ideal.Quotient.mk (P.under (C.ordBase x)) y) = Curve.kxEvalZero C x hx y :=
    Ideal.Quotient.lift_mk (P.under (C.ordBase x)) (Curve.kxEvalZero C x hx).toRingHom hker_lift
  refine Algebra.finrank_eq_of_equiv_equiv i (RingEquiv.refl (C.ordClosure x ⧸ P)) ?_
  apply RingHom.ext
  intro z
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
  show algebraMap k (C.ordClosure x ⧸ P)
      (i (Ideal.Quotient.mk (P.under (C.ordBase x)) y))
    = algebraMap (C.ordBase x ⧸ P.under (C.ordBase x)) (C.ordClosure x ⧸ P)
        (Ideal.Quotient.mk (P.under (C.ordBase x)) y)
  rw [hi_mk]
  -- `f ≡ f(0) mod q`
  have hker : y - algebraMap k (C.ordBase x) (Curve.kxEvalZero C x hx y) ∈ C.ordIdeal x := by
    have h : y - algebraMap k (C.ordBase x) (Curve.kxEvalZero C x hx y) ∈
        RingHom.ker (Curve.kxEvalZero C x hx).toRingHom := by
      show (Curve.kxEvalZero C x hx)
          (y - algebraMap k (C.ordBase x) (Curve.kxEvalZero C x hx y)) = 0
      rw [map_sub, AlgHom.commutes]
      simp
    rwa [← Curve.kx_span_gen_eq_ker C x hx] at h
  have hmem : algebraMap (C.ordBase x) (C.ordClosure x)
      (y - algebraMap k (C.ordBase x) (Curve.kxEvalZero C x hx y)) ∈ P := by
    have h1 : y - algebraMap k (C.ordBase x) (Curve.kxEvalZero C x hx y) ∈ P.under (C.ordBase x) := by
      rw [← hpbot]; exact hker
    exact Ideal.mem_comap.mpr h1
  have hkey : Ideal.Quotient.mk P (algebraMap (C.ordBase x) (C.ordClosure x) y)
      = Ideal.Quotient.mk P (algebraMap k (C.ordClosure x) (Curve.kxEvalZero C x hx y)) := by
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    have h2 : algebraMap (C.ordBase x) (C.ordClosure x) y
        - algebraMap k (C.ordClosure x) (Curve.kxEvalZero C x hx y)
        = algebraMap (C.ordBase x) (C.ordClosure x)
            (y - algebraMap k (C.ordBase x) (Curve.kxEvalZero C x hx y)) := by
      rw [map_sub, IsScalarTower.algebraMap_eq k (C.ordBase x) (C.ordClosure x)]
      rfl
    rw [h2]
    exact hmem
  exact hkey.symm


/-! ## The main theorem -/

open Curve in
/-- The inertia degree of the prime of `k[x]^int` at a place where `x` vanishes is the degree
`[κ(Q) : k]` of the place. -/
theorem inertiaDeg_kxPrimeOfPlace_eq_finrank {k : Type*} [Field k] (C : Curve k) (x : C.functionField)
    (hx : Transcendental k x) (Q : C.Place) (hQ : 0 < C.ordAt x Q) :
    (kxPrimeOfPlace C x Q hQ.le).inertiaDeg ↥(Algebra.adjoin k ({x} : Set C.functionField))
      = Module.finrank k (C.left.residueField Q.point) := by
  haveI hFD : FiniteDimensional (IntermediateField.adjoin k ({x} : Set C.functionField))
      C.functionField := finiteDimensional_adjoin_functionField C hx
  exact (inertiaDeg_kxPrimeOfPlace_eq_finrank_quotient C x hx Q hQ).trans
    ((kernelPrimeResidueField_finrank C x hx Q hQ).trans
      (show C.hom.residueDegree Q.point = Module.finrank k (C.left.residueField Q.point) from
        Place.degree_eq_finrank Q))

end

