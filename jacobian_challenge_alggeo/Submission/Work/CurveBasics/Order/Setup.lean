# The ring `k[x]` inside a field extension, and its integral closure

This file sets up the arithmetic of the subalgebra `k[x] ⊆ K` generated by one element `x` of a
field extension `K/k`, together with its integral closure in `K`.  This is the algebraic
infrastructure behind the computation of `∑_Q ord_Q x · [κ(Q) : k]` for a curve `C`

Concretely, for `x : K` we set

* `kx x := ↥(Algebra.adjoin k {x})`, the subalgebra generated by `x`, isomorphic to `k[X]` when
  `x` is transcendental (`Polynomial.algEquivOfTranscendental`);
* `kxClosure x := integralClosure (kx x) K`, the integral closure of `k[x]` in `K`.

The first main point of this file is that the *algebraic* properties of `k[x]` needed by Mathlib's
theory of integral closures (`IsNoetherianRing`, `IsPrincipalIdealRing`, hence `IsDedekindDomain`
and `IsIntegrallyClosed`) are automatic: `k[x]` is a quotient of `k[X]` (via `aeval`), hence
Noetherian with principal ideals.
-/
import Mathlib
import Submission.Work.CurveBasics.Basic
import Submission.Work.CurveBasics.Place.Coheight
import Submission.Work.CurveBasics.Order

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


open scoped Classical IntermediateField.algebraAdjoinAdjoin
set_option autoImplicit false
set_option linter.style.haveILetI false
open CategoryTheory Limits AlgebraicGeometry Polynomial IntermediateField

universe u

namespace Work.CurveBasics

section Adjoin

variable {k : Type*} [Field k] {K : Type*} [Field K] [Algebra k K]

/-- The `k`-algebra map `k[X] → k[x]`, `X ↦ x`, where `k[x]` is the subalgebra of `K` generated
by `x`.  It is surjective, and injective exactly when `x` is transcendental over `k`. -/
noncomputable def aevalGen (x : K) :
    Polynomial k →ₐ[k] ↥(Algebra.adjoin k ({x} : Set K)) :=
  Polynomial.aeval (A := ↥(Algebra.adjoin k ({x} : Set K)))
    (⟨x, Algebra.self_mem_adjoin_singleton k x⟩ : ↥(Algebra.adjoin k ({x} : Set K)))

lemma aevalGen_surjective (x : K) : Function.Surjective (aevalGen (k := k) x) := by
  intro y
  obtain ⟨p, hp⟩ := Algebra.adjoin_mem_exists_aeval (R := k) (x := x) y.2
  refine ⟨p, ?_⟩
  have h1 : ((aevalGen (k := k) x) p : K) = (y : K) := by simpa [aevalGen] using hp
  exact Subtype.ext h1

instance instIsNoetherianRingAdjoinSingleton (x : K) :
    IsNoetherianRing ↥(Algebra.adjoin k ({x} : Set K)) :=
  isNoetherianRing_of_surjective (Polynomial k) ↥(Algebra.adjoin k ({x} : Set K))
    (aevalGen (k := k) x).toRingHom (aevalGen_surjective (k := k) x)

instance instIsPrincipalIdealRingAdjoinSingleton (x : K) :
    IsPrincipalIdealRing ↥(Algebra.adjoin k ({x} : Set K)) :=
  IsPrincipalIdealRing.of_surjective (aevalGen (k := k) x) (aevalGen_surjective (k := k) x)

end Adjoin

namespace Curve

noncomputable section

variable {k : Type u} [Field k]

/-- The subalgebra `k[x]` of the function field generated by `x`. -/
abbrev kx (C : Curve k) (x : C.functionField) : Type u :=
  ↥(Algebra.adjoin k ({x} : Set C.functionField))

/-- The integral closure of `k[x]` in the function field `K(C)`. -/
abbrev kxClosure (C : Curve k) (x : C.functionField) : Type u :=
  integralClosure ↥(Algebra.adjoin k ({x} : Set C.functionField)) C.functionField

end

end Curve


namespace Curve

noncomputable section

variable {k : Type u} [Field k]

section Closure

variable (C : Curve k) (x : C.functionField)
  [Algebra.IsSeparable ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField]
  [FiniteDimensional ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField]

/-- The integral closure of `k[x]` in the function field is finite over `k[x]`. -/
theorem kxClosure_finite :
    Module.Finite ↥(Algebra.adjoin k ({x} : Set C.functionField)) (kxClosure C x) :=
  IsIntegralClosure.finite ↥(Algebra.adjoin k ({x} : Set C.functionField))
    ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField (kxClosure C x)

/-- The integral closure of `k[x]` in the function field is flat over `k[x]`. -/
theorem kxClosure_flat :
    Module.Flat ↥(Algebra.adjoin k ({x} : Set C.functionField)) (kxClosure C x) := by
  haveI := kxClosure_finite C x
  exact inferInstance

/-- The integral closure of `k[x]` in the function field is a Dedekind domain. -/
theorem kxClosure_isDedekindDomain : IsDedekindDomain (kxClosure C x) :=
  integralClosure.isDedekindDomain ↥(Algebra.adjoin k ({x} : Set C.functionField))
    ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField

/-- The function field is the fraction field of the integral closure of `k[x]`. -/
theorem kxClosure_isFractionRing : IsFractionRing (kxClosure C x) C.functionField :=
  IsIntegralClosure.isFractionRing_of_finite_extension ↥(Algebra.adjoin k ({x} : Set C.functionField))
    ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField (kxClosure C x)

/-- The rank of the integral closure over `k[x]` is the degree of the function field over
`k(x)`. -/
theorem kxClosure_finrank :
    Module.finrank ↥(Algebra.adjoin k ({x} : Set C.functionField)) (kxClosure C x)
      = Module.finrank (IntermediateField.adjoin k ({x} : Set C.functionField))
          C.functionField :=
  IsIntegralClosure.rank ↥(Algebra.adjoin k ({x} : Set C.functionField))
    ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField (kxClosure C x)

end Closure

section PrimeIdeal

variable (C : Curve k) (x : C.functionField) (hx : Transcendental k x)
include hx

/-- The generator `x` of the subalgebra `k[x]`, as an element of it. -/
noncomputable def kxGen : ↥(Algebra.adjoin k ({x} : Set C.functionField)) :=
  ⟨x, Algebra.self_mem_adjoin_singleton k x⟩

/-- `k[X] ≅ k[x]`, `X ↦ x`. -/
noncomputable def kxEquiv : Polynomial k ≃ₐ[k] ↥(Algebra.adjoin k ({x} : Set C.functionField)) :=
  Polynomial.algEquivOfTranscendental k x hx

lemma kxEquiv_X : kxEquiv C x hx Polynomial.X = kxGen C x := by
  have h := Polynomial.algEquivOfTranscendental_apply_X (R := k) x hx
  simpa [kxEquiv, kxGen] using h

lemma kxEquiv_symm_gen : (kxEquiv C x hx).symm (kxGen C x) = Polynomial.X := by
  rw [← kxEquiv_X C x hx]
  exact AlgEquiv.symm_apply_apply _ _

/-- Evaluation at the constant term, as a `k`-algebra map `k[x] → k`. -/
noncomputable def kxEvalZero :
    ↥(Algebra.adjoin k ({x} : Set C.functionField)) →ₐ[k] k :=
  (Polynomial.aeval (0 : k)).comp (kxEquiv C x hx).symm

lemma kxEvalZero_eq_coeff_zero (y : ↥(Algebra.adjoin k ({x} : Set C.functionField))) :
    kxEvalZero C x hx y = ((kxEquiv C x hx).symm y).coeff 0 := by
  simp [kxEvalZero, Polynomial.aeval_def, Polynomial.coeff_zero_eq_eval_zero]

lemma kxEvalZero_gen : kxEvalZero C x hx (kxGen C x) = 0 := by
  rw [kxEvalZero_eq_coeff_zero, kxEquiv_symm_gen]
  simp

/-- The ideal `(x) ⊆ k[x]` is the kernel of evaluation at the constant term. -/
theorem kx_span_gen_eq_ker :
    (Ideal.span {kxGen C x} : Ideal ↥(Algebra.adjoin k ({x} : Set C.functionField)))
      = RingHom.ker (kxEvalZero C x hx).toRingHom := by
  ext y
  rw [RingHom.mem_ker]
  change y ∈ Ideal.span {kxGen C x} ↔ kxEvalZero C x hx y = 0
  have hmem : y ∈ Ideal.span {kxGen C x}
      ↔ Polynomial.X ∣ (kxEquiv C x hx).symm y := by
    rw [Ideal.mem_span_singleton]
    constructor
    · rintro ⟨c, hc⟩
      rw [hc, map_mul, kxEquiv_symm_gen]
      exact dvd_mul_right _ _
    · rintro ⟨q, hq⟩
      refine ⟨(kxEquiv C x hx) q, ?_⟩
      rw [← AlgEquiv.apply_symm_apply (kxEquiv C x hx) y, hq, map_mul, kxEquiv_X]
  rw [hmem, kxEvalZero_eq_coeff_zero]
  exact Polynomial.X_dvd_iff

/-- The ideal `(x) ⊆ k[x]` is prime. -/
theorem kx_span_gen_isPrime :
    (Ideal.span {kxGen C x} : Ideal ↥(Algebra.adjoin k ({x} : Set C.functionField))).IsPrime := by
  rw [kx_span_gen_eq_ker C x hx]
  exact RingHom.ker_isPrime _

end PrimeIdeal

section Main

variable (C : Curve k) (x : C.functionField) (hx : Transcendental k x)
  [Algebra.IsSeparable ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField]
  [FiniteDimensional ↥(IntermediateField.adjoin k ({x} : Set C.functionField)) C.functionField]
include hx

/-- The ideal `(x)` of the subalgebra `k[x] ⊆ K(C)`. -/
noncomputable def kxIdeal : Ideal ↥(Algebra.adjoin k ({x} : Set C.functionField)) :=
  Ideal.span {kxGen C x}

/-- The ideal `(x) ⊆ k[x]` is prime. -/
theorem kxIdeal_isPrime : (kxIdeal C x).IsPrime :=
  kx_span_gen_isPrime C x hx

instance kxIdeal_fintype : Fintype ((kxIdeal C x).primesOver (kxClosure C x)) := by
  haveI := kxClosure_finite C x
  exact (Algebra.QuasiFinite.finite_primesOver (kxIdeal C x)).fintype

/-- **The fundamental identity for the place `x = 0`.**  The sum over the primes of the integral
closure of `k[x]` above `(x)` of the ramification index times the inertia degree is the degree of
the function field over `k(x)`. -/
theorem sum_ramification_inertia_eq_finrank_curve :
    ∑ q : (kxIdeal C x).primesOver (kxClosure C x),
        q.1.ramificationIdx ↥(Algebra.adjoin k ({x} : Set C.functionField))
          * q.1.inertiaDeg ↥(Algebra.adjoin k ({x} : Set C.functionField))
      = Module.finrank (IntermediateField.adjoin k ({x} : Set C.functionField))
          C.functionField := by
  haveI : (kxIdeal C x).IsPrime := kxIdeal_isPrime C x hx
  haveI := kxClosure_finite C x
  haveI := kxClosure_flat C x
  exact (Ideal.sum_ramification_inertia_eq_finrank (kxIdeal C x) (kxClosure C x)).trans
    (kxClosure_finrank C x)

end Main

end

end Curve

end Work.CurveBasics
