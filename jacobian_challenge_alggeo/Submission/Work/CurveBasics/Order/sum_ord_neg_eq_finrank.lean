-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


namespace Work.CurveBasics.Order

open Work.CurveBasics

/-- The subfield generated by `h` and by `h⁻¹` agree. -/
private lemma adjoin_inv_eq_adjoin {k K : Type*} [Field k] [Field K] [Algebra k K] {h : K} :
    IntermediateField.adjoin k ({h⁻¹} : Set K) = IntermediateField.adjoin k ({h} : Set K) := by
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact IntermediateField.inv_mem _ (IntermediateField.mem_adjoin_simple_self k h)
  · rw [IntermediateField.adjoin_le_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    have h2 := IntermediateField.inv_mem (IntermediateField.adjoin k ({h⁻¹} : Set K))
      (IntermediateField.mem_adjoin_simple_self k h⁻¹)
    simpa using h2

/-- A rational function is transcendental if and only if its inverse is. -/
private lemma transcendental_inv {k K : Type*} [Field k] [Field K] [Algebra k K] {h : K}
    (hh : Transcendental k h) : Transcendental k h⁻¹ :=
  fun hc => hh (IsAlgebraic.inv_iff.mp hc)

open Work.CurveBasics in
/-- The order of vanishing of the inverse, as a statement about `Curve.ordAt`. -/
private lemma ordAt_inv' {k : Type*} [Field k] (C : Curve k) {h : C.functionField} (hh : h ≠ 0)
    (Q : C.Place) : C.ordAt h⁻¹ Q = -C.ordAt h Q :=
  Work.CurveBasics.Order.ordAt_inv C hh Q

open Work.CurveBasics in
/-- **The degree of the divisor of zeros is the degree of the function field extension.**
For a transcendental rational function `h` on a curve `C` over a field `k`, the sum of the orders
of the zeros of `h`, weighted by the residue degrees, equals `[K(C) : k(h)]`.

This is the separability-free version of a standard theorem of the theory of algebraic function
fields.  Its proof combines the fundamental identity of ramification theory
(`Ideal.sum_ramification_inertia_eq_finrank`, i.e. `∑_q e(q) f(q) = rank_{k[h]} k[h]^int`) with
the dictionary between the primes of the integral closure `k[h]^int` over `(h)` and the zeros of
`h` (`sum_primesOver_eq_sum_ord`), and the computation of the rank of the integral closure
(`kxClosure_finrank_general`). -/
theorem sum_ord_pos_eq_finrank_general' {k : Type*} [Field k] (C : Curve k) (h : C.functionField)
    (hh : Transcendental k h)
    [FiniteDimensional (IntermediateField.adjoin k ({h} : Set C.functionField)) C.functionField] :
    ∑ Q ∈ (C.finite_support_ordAt h).toFinset.filter (fun Q => 0 < C.ordAt h Q),
        C.ordAt h Q * (C.hom.residueDegree Q.point : ℤ)
      = (Module.finrank (IntermediateField.adjoin k ({h} : Set C.functionField))
          C.functionField : ℤ) := by
  haveI hFin : Module.Finite (C.ordBase h) (C.ordClosure h) := ordClosure_finite_general C h hh
  haveI hFree : Module.Free (C.ordBase h) (C.ordClosure h) :=
    Module.free_of_finite_type_torsion_free'
  haveI hQF : Algebra.QuasiFinite (C.ordBase h) (C.ordClosure h) := inferInstance
  haveI hFt : Fintype ((C.ordIdeal h).primesOver (C.ordClosure h)) :=
    (Algebra.QuasiFinite.finite_primesOver (C.ordIdeal h)).fintype
  haveI hPrime : (C.ordIdeal h).IsPrime := Curve.kx_span_gen_isPrime C h hh
  have hsum := Ideal.sum_ramification_inertia_eq_finrank (C.ordIdeal h) (C.ordClosure h)
  have hrank := kxClosure_finrank_general C h hh
  have hbridge := sum_primesOver_eq_sum_ord C h hh
  have hsumZ : ∑ q : (C.ordIdeal h).primesOver (C.ordClosure h),
      ((q.1.ramificationIdx (C.ordBase h) : ℤ) * (q.1.inertiaDeg (C.ordBase h) : ℤ))
      = (Module.finrank (C.ordBase h) (C.ordClosure h) : ℤ) := by
    rw [← hsum, Nat.cast_sum]
    exact Finset.sum_congr rfl fun q _ => by push_cast; ring
  rw [← hbridge, hsumZ]
  exact congrArg (fun n : ℕ => (n : ℤ)) hrank

open Work.CurveBasics in
/-- **The degree of the pole divisor.**  For a transcendental rational function `h` on a curve `C`
over a field `k`, the sum of the orders of the poles of `h`, weighted by the residue degrees,
equals the degree `[K(C) : k(h)]` of the function field over the subfield generated by `h`.

This is the mirror image of `sum_ord_pos_eq_finrank_general'` applied to `h⁻¹`. -/
theorem sum_ord_neg_eq_finrank {k : Type*} [Field k] (C : Curve k) (h : C.functionField)
    (hh : Transcendental k h)
    [FiniteDimensional (IntermediateField.adjoin k ({h} : Set C.functionField)) C.functionField] :
    ∑ Q ∈ (C.finite_support_ordAt h).toFinset.filter (fun Q => C.ordAt h Q < 0),
        (-C.ordAt h Q) * (C.hom.residueDegree Q.point : ℤ)
      = (Module.finrank (IntermediateField.adjoin k ({h} : Set C.functionField))
          C.functionField : ℤ) := by
  have hh0 : h ≠ 0 := hh.ne_zero
  have hT : Transcendental k h⁻¹ := transcendental_inv hh
  have hadj : IntermediateField.adjoin k ({h⁻¹} : Set C.functionField) =
      IntermediateField.adjoin k ({h} : Set C.functionField) := adjoin_inv_eq_adjoin
  have hfin := congrArg (fun E : IntermediateField k C.functionField =>
    (Module.finrank E C.functionField : ℤ)) hadj
  haveI : FiniteDimensional (IntermediateField.adjoin k ({h⁻¹} : Set C.functionField))
      C.functionField := hadj ▸ ‹FiniteDimensional
        (IntermediateField.adjoin k ({h} : Set C.functionField)) C.functionField›
  rw [← hfin, ← sum_ord_pos_eq_finrank_general' C h⁻¹ hT]
  have hsupp : (C.finite_support_ordAt h⁻¹).toFinset = (C.finite_support_ordAt h).toFinset := by
    rw [Set.Finite.toFinset_inj]
    ext Q
    simp only [Set.mem_ofPred_eq]
    rw [ordAt_inv' C hh0 Q]
    simp
  have hfilter : (C.finite_support_ordAt h⁻¹).toFinset.filter (fun Q => 0 < C.ordAt h⁻¹ Q)
      = (C.finite_support_ordAt h).toFinset.filter (fun Q => C.ordAt h Q < 0) := by
    rw [hsupp]
    apply Finset.filter_congr
    intro Q _
    rw [ordAt_inv' C hh0 Q]
    omega
  rw [hfilter]
  exact Finset.sum_congr rfl fun Q _ => by rw [ordAt_inv' C hh0 Q]

end Work.CurveBasics.Order
