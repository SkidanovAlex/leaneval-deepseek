import Mathlib

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


universe u

/-!
# The degree of a purely inseparable simple extension

Let `k → F` be a field extension, `p` a prime and `A` an intermediate field of `k → F`.
If `h ∈ F` satisfies `h ^ p ∈ A` but `h ∉ A`, then the simple extension `A(h)` of `A`
generated by `h` has degree `p` over `A`.

This is the standard computation of the degree of a purely inseparable extension of
exponent one: `h` is a root of `X ^ p - h ^ p` and, since the minimal polynomial of `h`
over `A` is a monic irreducible divisor of `X ^ p - h ^ p`, it is inseparable, hence of the
form `X ^ (p ^ n) - C y`. Bounding its degree by `p` (divisibility) and using `h ∉ A` to
rule out `n = 0` forces the degree to be exactly `p`.
-/

namespace Work.CurveBasics.Order

open Polynomial

/-- If `h ^ p ∈ A` but `h ∉ A`, with `p` prime and `F` of exponential characteristic `p`,
then `[A(h) : A] = p`. -/
theorem finrank_adjoin_pow_eq_prime {k F : Type u} [Field k] [Field F] [Algebra k F]
    {p : ℕ} [ExpChar F p] (hp : p.Prime) {A : IntermediateField k F} {h : F}
    (hpow : h ^ p ∈ A) (hnot : h ∉ A) :
    Module.finrank ↥A ↥(IntermediateField.adjoin ↥A ({h} : Set F)) = p := by
  -- View `h ^ p` as an element `a` of `A`.
  set a : ↥A := ⟨h ^ p, hpow⟩ with ha
  have haval : (a : F) = h ^ p := by simp [ha]
  -- `h` is integral over `A`, being a root of the monic polynomial `X ^ p - a`.
  have hint : IsIntegral ↥A h := by
    refine ⟨X ^ p - C a, monic_X_pow_sub_C a hp.ne_zero, ?_⟩
    simp [haval]
  -- Reduce the degree to the degree of the minimal polynomial of `h` over `A`.
  rw [IntermediateField.adjoin.finrank hint]
  -- `X ^ p - a` is inseparable, hence so is the minimal polynomial of `h`.
  have hns : (minpoly ↥A h).natSepDegree = 1 := by
    rw [minpoly.natSepDegree_eq_one_iff_pow_mem (x := h) p]
    exact ⟨1, ⟨a, by simp [haval]⟩⟩
  obtain ⟨n, y, hmy⟩ :=
    (minpoly.natSepDegree_eq_one_iff_eq_X_pow_sub_C (F := ↥A) p).1 hns
  -- Divisible polynomials have degree at most `p`.
  have hdvd : minpoly ↥A h ∣ X ^ p - C a := minpoly.dvd ↥A h (by simp [haval])
  have hne : (X ^ p - C a : Polynomial ↥A) ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hp.pos a
  have hle : (minpoly ↥A h).natDegree ≤ p := by
    have h := (minpoly.monic hint).natDegree_le_of_dvd hne hdvd
    rwa [Polynomial.natDegree_X_pow_sub_C] at h
  -- The minimal polynomial has degree `p ^ n`.
  have hd : (minpoly ↥A h).natDegree = p ^ n := by
    rw [hmy, Polynomial.natDegree_X_pow_sub_C]
  -- `n = 0` would force `h ∈ A`, contradicting the hypothesis.
  have hn0 : n ≠ 0 := by
    rintro rfl
    rw [pow_zero] at hd
    obtain ⟨b, hb⟩ := minpoly.natDegree_eq_one_iff.mp hd
    exact hnot (by rw [← hb]; exact b.2)
  have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
  have hple : p ≤ p ^ n := by
    calc p = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ n := Nat.pow_le_pow_right hp.one_le hn1
  have hn : p ^ n = p := le_antisymm (by rw [← hd]; exact hle) hple
  rw [hd, hn]

end Work.CurveBasics.Order
