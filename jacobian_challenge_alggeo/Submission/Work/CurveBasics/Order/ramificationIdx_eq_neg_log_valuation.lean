import Mathlib
import Submission.Work.CurveBasics.Order.RamifIdxSetup
import Submission.Work.CurveBasics.Order.Bridge
import Submission.Work.CurveBasics.Order.kxPrimeOfPlace_liesOver

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


set_option linter.style.haveILetI false

namespace Work.CurveBasics.Order

/-- The ramification index of the prime `q = k[x]^int ∩ 𝔪_Q` of `k[x]^int` over `k[x]` equals the
negative of the logarithm of the value of `x` under the height-one-prime valuation attached
to `q`.

Proof sketch: `IsDedekindDomain.ramificationIdx_eq_multiplicity` gives
`e = multiplicity q (p.map (algebraMap k[x] k[x]^int))` where `p = q.under k[x]`; the Lie-over
lemma `kxPrimeOfPlace_liesOver` identifies `p` with the ideal `(x)`, so
`p.map ... = Ideal.span {x}`.  Then
`IsDedekindDomain.HeightOneSpectrum.intValuation_eq_exp_neg_multiplicity` and
`valuation_of_algebraMap` give `V x = WithZero.exp (-(e : ℤ))`, and `WithZero.log_exp`
concludes. -/
theorem ramificationIdx_eq_neg_log_valuation {k : Type*} [Field k] (C : Work.CurveBasics.Curve k)
    (x : C.functionField) (hx : Transcendental k x) (Q : C.Place) (hQ : 0 < C.ordAt x Q)
    [IsDedekindDomain ↥(Work.CurveBasics.kxInt C x)]
    [IsFractionRing ↥(Work.CurveBasics.kxInt C x) C.functionField] :
    ((Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le).ramificationIdx
        ↥(Algebra.adjoin k ({x} : Set C.functionField)) : ℤ)
      = -(IsDedekindDomain.HeightOneSpectrum.valuation C.functionField
          (Work.CurveBasics.Order.kxHeightOne C x hx Q hQ) x).log := by
  classical
  -- the prime of `k[x]^int` attached to `Q` is prime and lies over `(x)`
  haveI hprime : (Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le).IsPrime :=
    Work.CurveBasics.kxPrimeOfPlace_isPrime C x Q hQ.le
  haveI hlies : (Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le).LiesOver (Curve.kxIdeal C x) :=
    Work.CurveBasics.Order.kxPrimeOfPlace_liesOver C x hx Q hQ
  -- the image of `(x)` in `k[x]^int` is the principal ideal generated by `x`
  have hmap : (Curve.kxIdeal C x).map
        (algebraMap ↥(Algebra.adjoin k ({x} : Set C.functionField)) ↥(Work.CurveBasics.kxInt C x))
      = Ideal.span {(⟨x, Work.CurveBasics.Order.kxGen_isIntegral C x⟩ :
          ↥(Work.CurveBasics.kxInt C x))} := by
    rw [Curve.kxIdeal, Ideal.map_span, Set.image_singleton,
      Work.CurveBasics.Order.algebraMap_kxGen_eq]
  -- `x` is a nonzero element of `k[x]^int`
  have hr : (⟨x, Work.CurveBasics.Order.kxGen_isIntegral C x⟩ :
      ↥(Work.CurveBasics.kxInt C x)) ≠ 0 := by
    intro h
    exact hx.ne_zero (by simpa using congrArg Subtype.val h)
  have hne : (Curve.kxIdeal C x).map
      (algebraMap ↥(Algebra.adjoin k ({x} : Set C.functionField)) ↥(Work.CurveBasics.kxInt C x))
      ≠ ⊥ := by
    rw [hmap]
    exact fun h => hr (Ideal.span_singleton_eq_bot.mp h)
  -- the ramification index is the multiplicity of `q` in `(x)`
  have hmult := Ideal.IsDedekindDomain.ramificationIdx_eq_multiplicity
      (Curve.kxIdeal C x) (Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le) hne
  -- the valuation of `x` is `exp (-(e : ℤ))`
  have hval : IsDedekindDomain.HeightOneSpectrum.valuation C.functionField
        (Work.CurveBasics.Order.kxHeightOne C x hx Q hQ) x
      = WithZero.exp (-(((Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le).ramificationIdx
          ↥(Algebra.adjoin k ({x} : Set C.functionField)) : ℕ) : ℤ)) := by
    have hone : (Work.CurveBasics.Order.kxHeightOne C x hx Q hQ).intValuation
        (⟨x, Work.CurveBasics.Order.kxGen_isIntegral C x⟩ :
          ↥(Work.CurveBasics.kxInt C x))
        = WithZero.exp (-(((Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le).ramificationIdx
            ↥(Algebra.adjoin k ({x} : Set C.functionField)) : ℕ) : ℤ)) := by
      rw [IsDedekindDomain.HeightOneSpectrum.intValuation_eq_exp_neg_multiplicity _ hr]
      rw [show (Work.CurveBasics.Order.kxHeightOne C x hx Q hQ).asIdeal
          = Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le from rfl]
      rw [← hmap, hmult]
    have htwo := (IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap
      (K := C.functionField) (Work.CurveBasics.Order.kxHeightOne C x hx Q hQ)
      (⟨x, Work.CurveBasics.Order.kxGen_isIntegral C x⟩ :
        ↥(Work.CurveBasics.kxInt C x))).trans hone
    simpa using htwo
  -- take logarithms
  have hlog : (IsDedekindDomain.HeightOneSpectrum.valuation C.functionField
        (Work.CurveBasics.Order.kxHeightOne C x hx Q hQ) x).log
      = -(((Work.CurveBasics.kxPrimeOfPlace C x Q hQ.le).ramificationIdx
          ↥(Algebra.adjoin k ({x} : Set C.functionField)) : ℕ) : ℤ) := by
    rw [hval, WithZero.log_exp]
  omega

end Work.CurveBasics.Order
