import Mathlib
import Submission.Work.CurveBasics.Order.isNoetherianRing_integralClosure_pid

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option linter.style.haveILetI false

namespace Work.CurveBasics.Order

/-- **Krull–Akizuki for principal ideal domains, for an arbitrary fraction field.**

The integral closure of a principal ideal domain `A` in a finite extension `L` of a fraction field
`K` of `A` (given by `IsFractionRing A K` rather than the canonical `FractionRing A`) is a
Noetherian ring.  This is the same statement as
`Work.CurveBasics.Order.isNoetherianRing_integralClosure_pid`, which is stated for the canonical
`FractionRing A`; since `IsNoetherianRing` is invariant under ring isomorphism, it follows by
transporting along the canonical isomorphism `FractionRing A ≃+* K` of fraction rings of `A`
(`IsFractionRing.algEquiv`, or `IsFractionRing.ringEquivOfRingEquiv`), together with the induced
isomorphism of the two integral closures (`IsIntegralClosure.equiv`) and
`isNoetherianRing_of_ringEquiv`. -/
theorem isNoetherianRing_integralClosure_of_isFractionRing {A : Type*} [CommRing A] [IsDomain A]
    [IsPrincipalIdealRing A] {K : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
    {L : Type*} [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] :
    IsNoetherianRing ↥(integralClosure A L) := by
  -- The canonical `A`-algebra isomorphism between the two fraction rings of `A`.
  let φ : FractionRing A ≃ₐ[A] K :=
    IsLocalization.algEquiv (nonZeroDivisors A) (FractionRing A) K
  -- Transport the `K`-algebra structure on `L` to a `FractionRing A`-algebra structure.
  letI : Algebra (FractionRing A) K := φ.toRingHom.toAlgebra
  letI : Algebra (FractionRing A) L :=
    ((IsScalarTower.toAlgHom A K L).toRingHom.comp φ.toRingHom).toAlgebra
  -- The two scalar actions are compatible, forming a tower.
  haveI hst1 : IsScalarTower (FractionRing A) K L := by
    refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
    rfl
  haveI hst2 : IsScalarTower A (FractionRing A) L := by
    refine IsScalarTower.of_algebraMap_eq (fun a => ?_)
    show algebraMap A L a = algebraMap K L (φ (algebraMap A (FractionRing A) a))
    rw [IsScalarTower.algebraMap_eq A K L, RingHom.comp_apply]
    exact congrArg (algebraMap K L) (φ.commutes' a).symm
  -- `K` is a finite `FractionRing A`-module (generated by `1`, transported along `φ`).
  haveI hfinK : Module.Finite (FractionRing A) K := by
    refine Module.Finite.of_surjective (LinearMap.toSpanSingleton (FractionRing A) K (1:K)) ?_
    intro k
    refine ⟨φ.symm k, ?_⟩
    rw [LinearMap.toSpanSingleton_apply, Algebra.smul_def, mul_one]
    change φ (φ.symm k) = k
    simp
  -- Hence `L` is a finite `FractionRing A`-module, and the PID statement applies verbatim.
  haveI hfinL : FiniteDimensional (FractionRing A) L := Module.Finite.trans K L
  exact isNoetherianRing_integralClosure_pid (A := A) (L := L)

end Work.CurveBasics.Order
