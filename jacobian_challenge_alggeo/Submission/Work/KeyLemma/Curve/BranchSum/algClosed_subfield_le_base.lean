import Mathlib
import Submission.Work.KeyLemma.Curve.BranchSum.minpoly_adjoin_transcendental_pow

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.KeyLemma.Curve.BranchSum

open scoped IntermediateField.algebraAdjoinAdjoin

universe u

/-- If `k` is algebraically closed, an element of a `k`-algebra `N` which is algebraic over `k`
already lies in the image of `k`.  Equivalently, `k` is relatively algebraically closed in `N`. -/
theorem isAlgebraic_mem_range {k : Type u} [Field k] [IsAlgClosed k] {N : Type u} [Field N]
    [Algebra k N] {y : N} (hy : IsAlgebraic k y) : y ∈ Set.range (algebraMap k N) := by
  haveI : Algebra.IsAlgebraic k ↥(IntermediateField.adjoin k ({y} : Set N)) :=
    IntermediateField.isAlgebraic_adjoin (fun z hz => by
      rw [Set.mem_singleton_iff] at hz
      subst hz
      exact hy.isIntegral)
  have hL := IntermediateField.eq_bot_of_isAlgClosed_of_isAlgebraic
    (IntermediateField.adjoin k ({y} : Set N))
  have hyL : y ∈ IntermediateField.adjoin k ({y} : Set N) :=
    IntermediateField.mem_adjoin_simple_self k y
  rw [hL] at hyL
  simpa [IntermediateField.mem_bot] using hyL

/-- If `x` and `y` are both transcendental over `k` and `N` is finite over `k(x)`, then `N` is
finite over `k(y)`.

Indeed `y` is algebraic over `k(x)`, so by symmetry of algebraic dependence between two
transcendentals (`IsAlgebraic.adjoin_singleton`) also `x` is algebraic over `k(y)`; hence
`k(x)` is contained in the finite extension `k(y)(x)` of `k(y)`, and `N` is finite over both. -/
theorem finiteDimensional_adjoin_of_transcendental {k : Type u} [Field k] {N : Type u} [Field N]
    [Algebra k N] (x y : N) (hx : Transcendental k x) (hy : Transcendental k y)
    [FiniteDimensional ↥(IntermediateField.adjoin k {x}) N] :
    FiniteDimensional ↥(IntermediateField.adjoin k {y}) N := by
  have hAy : IsAlgebraic ↥(IntermediateField.adjoin k {x}) y :=
    (Algebra.IsAlgebraic.of_finite ↥(IntermediateField.adjoin k {x}) N).isAlgebraic y
  have hAy' : IsAlgebraic ↥(Algebra.adjoin k {x}) y :=
    (IsFractionRing.isAlgebraic_iff ↥(Algebra.adjoin k {x})
      ↥(IntermediateField.adjoin k {x}) N).mpr hAy
  have h1 : IsAlgebraic ↥(Algebra.adjoin k {y}) x := IsAlgebraic.adjoin_singleton hx hy hAy'
  have hBx : IsAlgebraic ↥(IntermediateField.adjoin k {y}) x :=
    (IsFractionRing.isAlgebraic_iff ↥(Algebra.adjoin k {y})
      ↥(IntermediateField.adjoin k {y}) N).mp h1
  have hBx_int : IsIntegral ↥(IntermediateField.adjoin k {y}) x := hBx.isIntegral
  let C : IntermediateField ↥(IntermediateField.adjoin k {y}) N :=
    IntermediateField.adjoin ↥(IntermediateField.adjoin k {y}) {x}
  haveI hBC : Module.Finite ↥(IntermediateField.adjoin k {y}) ↥C :=
    IntermediateField.adjoin.finiteDimensional hBx_int
  have hxmk : x ∈ C := IntermediateField.subset_adjoin _ _ (Set.mem_singleton x)
  have hA_le_Ck : IntermediateField.adjoin k {x} ≤ C.restrictScalars k := by
    rw [IntermediateField.adjoin_le_iff]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact hxmk
  letI : Algebra ↥(IntermediateField.adjoin k {x}) ↥C := (Subfield.inclusion hA_le_Ck).toAlgebra
  haveI : IsScalarTower ↥(IntermediateField.adjoin k {x}) ↥C N :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI hCN : Module.Finite ↥C N := Module.Finite.right ↥(IntermediateField.adjoin k {x}) ↥C N
  exact Module.Finite.trans ↥C N

/-- If `k` is algebraically closed and `N` is a field extension of `k` which is finite over
`k(x)` for some `x` transcendental over `k`, then every subfield of `N` which is (as an abstract
field) algebraically closed is contained in the image of `k`.

Proof: suppose `y ∈ K'` is not in the image of `k`. Since `k` is algebraically closed it is
relatively algebraically closed in `N`, so `y` is transcendental over `k`. The field `k(y)` (the
subfield of `N` generated by `k` and `y`) satisfies `k(y) ⊆ N` with `[N : k(y)] = m < ∞`. Since
`K'` is algebraically closed, `X^n - y` has a root `r_n ∈ K' ⊆ N` for every `n`; the polynomial is
Eisenstein at the prime `(y)` of `k[y]`, hence irreducible over `Frac(k[y]) = k(y)`, so
`n = [k(y)(r_n) : k(y)] ≤ [N : k(y)] = m` for every `n ≥ 1`, a contradiction. -/
theorem algClosed_subfield_le_base {k : Type u} [Field k] [IsAlgClosed k]
    {N : Type u} [Field N] [Algebra k N]
    (x : N) (hx : Transcendental k x)
    [FiniteDimensional ↥(IntermediateField.adjoin k {x}) N]
    (K' : Subfield N) [IsAlgClosed ↥K'] :
    ∀ y ∈ K', y ∈ Set.range (algebraMap k N) := by
  intro y hyK'
  by_contra hmem
  have hyT : Transcendental k y := fun h => hmem (isAlgebraic_mem_range h)
  haveI hfin : FiniteDimensional ↥(IntermediateField.adjoin k {y}) N :=
    finiteDimensional_adjoin_of_transcendental x y hx hyT
  set m : ℕ := Module.finrank ↥(IntermediateField.adjoin k {y}) N with hm
  obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (⟨y, hyK'⟩ : ↥K') (Nat.succ_pos m)
  have hrN : ((r : N)) ^ (m + 1) = y := by
    have h := congrArg (fun z : ↥K' => (z : N)) hr
    simpa using h
  have hint : IsIntegral ↥(IntermediateField.adjoin k {y}) ((r : N)) :=
    ⟨Polynomial.X ^ (m + 1) - Polynomial.C (⟨y, IntermediateField.mem_adjoin_simple_self k y⟩ :
        ↥(IntermediateField.adjoin k {y})),
      Polynomial.monic_X_pow_sub_C _ (Nat.succ_ne_zero m), by simp [hrN]⟩
  have hdeg : Module.finrank ↥(IntermediateField.adjoin k {y})
      ↥(IntermediateField.adjoin ↥(IntermediateField.adjoin k {y}) {((r : N))}) = m + 1 := by
    rw [IntermediateField.adjoin.finrank hint,
      minpoly_adjoin_transcendental_pow y hyT (Nat.succ_pos m) ((r : N)) hrN,
      Polynomial.natDegree_X_pow_sub_C]
  have hle : Module.finrank ↥(IntermediateField.adjoin k {y})
      ↥(IntermediateField.adjoin ↥(IntermediateField.adjoin k {y}) {((r : N))}) ≤ m := by
    have h1 := IntermediateField.finrank_le_of_le_right
      (K := ↥(IntermediateField.adjoin k {y})) (L := N)
      (F := IntermediateField.adjoin ↥(IntermediateField.adjoin k {y}) {((r : N))})
      (E := ⊤) le_top
    simpa [IntermediateField.finrank_top', hm] using h1
  omega

end Work.KeyLemma.Curve.BranchSum
