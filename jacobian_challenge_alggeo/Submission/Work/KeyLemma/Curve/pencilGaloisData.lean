/-
# A Galois closure adapted to the pencil of a rational function

Let `k` be a field, `C` a curve over `k`, `h ∈ K(C)` transcendental over `k`,
`K := k(h) ⊆ E := K(C)` the associated finite separable extension (in the separable case), and
`A₀ := k[h] ⊆ K` the subalgebra generated by `h`.

To run the branch/specialisation argument for the pencil of `h` (the `Work.KeyLemma.Curve`
development) one needs a *finite Galois* extension `N` of `K` in which `E` embeds over `K`,
together with

* the `k`-algebra structure (`k ⊆ N`),
* the `A₀ = k[h]`-algebra structure (`k[h] ⊆ K ⊆ N`),
* the tower conditions making all of these subrings of `N`, and
* the *explicit* compatibilities `hKE` and `hAE` of the `algebraMap`s.

The last two are **not** automatic: an `IsScalarTower ↥S ↥T N` hypothesis between subobjects
`S ⊆ T ⊆ K(C)` is a tautology in Lean, because typeclass search resolves the `SMul` instances
through the ambient actions of the subtypes rather than through `Algebra.toSMul`
(see the discussion in `card_branches_fixed` and §13.1 of `NOTES_pencil.md`).  The content that
such a hypothesis is meant to carry -- that `N` contains `E` over `K`, and `k[h]` over `k` -- is
therefore stated below as the two equations `hKE` and `hAE`.

This file contains only the *packaging* of that data; the existence of a field `N` carrying it is
the theorem `Work.KeyLemma.Curve.nonempty_pencilGaloisData` (a Galois closure of `E/K`, realised
as the splitting field of the minimal polynomial of a primitive element of `E/K`).
-/
import Mathlib
import Submission.Work.KeyLemma.Curve.ordBaseBaseField

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


set_option autoImplicit false
open CategoryTheory AlgebraicGeometry Limits
open scoped Classical

universe u

namespace Work.KeyLemma.Curve

open Work.CurveBasics

/-- **The Galois data attached to the pencil of `h`.**  A field `N` which is a finite Galois
extension of `K = k(h)`, containing `E = K(C)` over `K`, together with the `k`-algebra and
`k[h]`-algebra structures and the two explicit compatibilities `hKE`, `hAE`. -/
structure PencilGaloisData (k : Type u) [Field k] (C : Curve k) (h : C.functionField) where
  /-- The Galois closure of `E = K(C)` over `K = k(h)`. -/
  N : Type u
  [fieldN : Field N]
  [algK : Algebra ↥(baseField C h) N]
  [algk : Algebra k N]
  [algE : Algebra ↥C.functionField N]
  [algA : Algebra ↥(C.ordBase h) N]
  [stkK : IsScalarTower k ↥(baseField C h) N]
  [stKE : IsScalarTower ↥(baseField C h) ↥C.functionField N]
  [stAK : IsScalarTower ↥(C.ordBase h) ↥(baseField C h) N]
  [stAE : IsScalarTower ↥(C.ordBase h) ↥C.functionField N]
  [fin : FiniteDimensional ↥(baseField C h) N]
  [galois : IsGalois ↥(baseField C h) N]
  [frac : IsFractionRing ↥(integralClosure ↥(C.ordBase h) N) N]
  /-- The `K`-algebra map to `N` is the composite `K → E → N`. -/
  hKE : (algebraMap ↥(baseField C h) N)
      = (algebraMap ↥C.functionField N).comp (algebraMap ↥(baseField C h) ↥C.functionField)
  /-- The `k[h]`-algebra map to `N` is the composite `k[h] → E → N`. -/
  hAE : (algebraMap ↥(C.ordBase h) N)
      = (algebraMap ↥C.functionField N).comp (algebraMap ↥(C.ordBase h) ↥C.functionField)

end Work.KeyLemma.Curve
