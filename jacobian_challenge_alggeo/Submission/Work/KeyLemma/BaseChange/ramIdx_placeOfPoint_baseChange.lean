-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.


namespace Work.KeyLemma.BaseChange

open CategoryTheory Limits AlgebraicGeometry
open scoped Classical

set_option maxHeartbeats 16000000

universe u

/-- **The ramification index of a place of `C_L` lying over a `k`-rational point is one.**

Let `C` be a curve over `k`, `p` a `k`-point of `C` with image `Q = placeOfPoint C p`, and let
`Q'` be a place of `C_L` with `π Q' = Q`.  Then `e(Q'/Q) = 1`.

The proof is the affine-chart computation of the fibre of `C_L ⟶ C` over the rational point
`Q`: for an affine open `W = Spec R ∋ Q` the preimage `U = π⁻¹W = Spec S` has
`S = Γ(C_L, U)` generated as a ring by the image of `R` and the constants `L`.  Since `Q` is
`k`-rational, `R/𝔭 = k`, so `S/𝔭S = L` is a field; hence `𝔭S` is a maximal ideal of `S`, and
as `𝔭S ⊆ q'` with `q'` prime we get `q' = 𝔭S`.  Localising at `q'` shows that the maximal
ideal of `𝒪_{C_L,Q'}` is generated by the image of the maximal ideal of `𝒪_{C,Q}`: a
uniformiser at `Q` stays a uniformiser at `Q'`. -/
theorem ramIdx_eq_one_of_fst_eq {k : Type u} [Field k] (C : Work.CurveBasics.Curve k)
    (L : Type u) [Field L] [Algebra k L] (p : Work.KeyLemma.Curve.Point C)
    (Q' : (C.baseChange L).Place)
    (hproj : C.baseChangeFst L Q'.point =
      (Work.KeyLemma.Curve.placeOfPoint C p).point) :
    Work.CurveBasics.Curve.ramIdx C L Q' = 1 := by
  classical
  have hcl : IsClosed ({(C.baseChangeFst L) Q'.point} : Set C.left) := by
    rw [hproj]; exact (Work.KeyLemma.Curve.placeOfPoint C p).isClosed
  rw [Work.CurveBasics.Curve.ramIdx, dif_pos hcl]
  obtain ⟨W, hW, hQW, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := (Work.KeyLemma.Curve.placeOfPoint C p).point) (U := ⊤) trivial
  have hQ'W : (C.baseChangeFst L) Q'.point ∈ W := hproj ▸ hQW
  have hQ'U : Q'.point ∈ C.bcOpens L W := hQ'W
  have hU : IsAffineOpen (C.bcOpens L W) :=
    Work.CurveBasics.BaseChange.isAffineOpen_bcOpens L W hW
  -- the points, as elements of the opens
  let xW : ↥W := ⟨(C.baseChangeFst L) Q'.point, hQ'W⟩
  let yU : ↥(C.bcOpens L W) := ⟨Q'.point, hQ'U⟩
  -- the `k`- and `L`-algebra structures of the local rings of sections
  letI hAalg : Algebra (C.left.presheaf.obj (Opposite.op W))
      (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) :=
    TopCat.Presheaf.algebra_section_stalk C.left.presheaf xW
  letI hBalg : Algebra (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W)))
      (((C.baseChange L).left).presheaf.stalk Q'.point) :=
    TopCat.Presheaf.algebra_section_stalk ((C.baseChange L).left).presheaf yU
  -- the two primes
  let pA : Ideal (C.left.presheaf.obj (Opposite.op W)) := (hW.primeIdealOf xW).asIdeal
  let qA : Ideal (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W))) :=
    (hU.primeIdealOf yU).asIdeal
  haveI hpAprime : pA.IsPrime := (hW.primeIdealOf xW).isPrime
  haveI hqAprime : qA.IsPrime := (hU.primeIdealOf yU).isPrime
  have hqAne : qA ≠ ⊤ := hqAprime.ne_top
  let g : (C.left.presheaf.obj (Opposite.op W)) →+*
      (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W))) :=
    (Scheme.Hom.app (C.baseChangeFst L) W).hom
  let ψ : (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) →+*
      (((C.baseChange L).left).presheaf.stalk Q'.point) :=
    (Scheme.Hom.stalkMap (C.baseChangeFst L) Q'.point).hom
  have hcompat : ψ.comp (algebraMap (C.left.presheaf.obj (Opposite.op W))
        (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))) =
      (algebraMap (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W)))
        (((C.baseChange L).left).presheaf.stalk Q'.point)).comp g := by
    ext r
    exact Scheme.Hom.germ_stalkMap_apply (C.baseChangeFst L) W Q'.point hQ'W r
  -- localisation structures at the two points
  have hAloc : IsLocalization.AtPrime (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) pA :=
    hW.isLocalization_stalk xW
  have hBloc : IsLocalization.AtPrime (((C.baseChange L).left).presheaf.stalk Q'.point) qA :=
    hU.isLocalization_stalk yU
  haveI hDVR : IsDiscreteValuationRing (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) :=
    (C.under L Q' hcl).instIsDiscreteValuationRing
  haveI hDVRB : IsDiscreteValuationRing (((C.baseChange L).left).presheaf.stalk Q'.point) :=
    Q'.instIsDiscreteValuationRing
  haveI := hAloc
  haveI := hBloc
  -- `𝔭S` is contained in the prime `q'` of `Q'`
  have hpA : pA = (hW.primeIdealOf
      ⟨(Work.KeyLemma.Curve.placeOfPoint C p).point, hQW⟩).asIdeal :=
    congrArg (fun z => (hW.primeIdealOf z).asIdeal) (Subtype.ext hproj)
  have hcomap : Ideal.comap g qA = pA := by
    have h1 := IsAffineOpen.comap_primeIdealOf_appLE
      (f := C.baseChangeFst L) W hW ((C.baseChangeFst L) ⁻¹ᵁ W) hU le_rfl
      (x := Q'.point) hQ'U
    have h2 := congrArg PrimeSpectrum.asIdeal h1
    rw [PrimeSpectrum.comap_asIdeal] at h2
    rw [Scheme.Hom.appLE_eq_app] at h2
    exact h2
  have hI_le : Ideal.map g pA ≤ qA := Ideal.map_le_iff_le_comap.mpr (le_of_eq hcomap.symm)
  -- the coordinate ring of the base change is generated by the image of `R` and by `L`
  have hgen : Subring.closure (Set.range g ∪
      Set.range (algebraMap L
        (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W))))) = ⊤ :=
    Work.CurveBasics.BaseChange.closure_range_union_range_eq_top_bcOpens C L W hW
  -- every element of `R` is a constant modulo `𝔭`, so `S ⧸ 𝔭S` is generated by `L`
  -- every element of `R` is a constant modulo `𝔭`, so `S ⧸ 𝔭S` is generated by `L`
  have hmem_range : ∀ r : (C.left.presheaf.obj (Opposite.op W)),
      (Ideal.Quotient.mk (Ideal.map g pA)) (g r) ∈
        ((Ideal.Quotient.mk (Ideal.map g pA)).comp (algebraMap L
          (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W))))).range := by
    intro r
    obtain ⟨c, hc⟩ := exists_sub_algebraMap_mem_primeIdealOf C p W hW hQW r
    refine RingHom.mem_range.mpr ⟨algebraMap k L c, ?_⟩
    have happ : g (algebraMap k (C.left.presheaf.obj (Opposite.op W)) c)
        = algebraMap L (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W)))
          (algebraMap k L c) := app_algebraMap C L W c
    have hmemI : g r - algebraMap L (((C.baseChange L).left).presheaf.obj
        (Opposite.op (C.bcOpens L W))) (algebraMap k L c) ∈ Ideal.map g pA := by
      have h := Ideal.mem_map_of_mem g (hpA.symm ▸ hc)
      rwa [map_sub, happ] at h
    have h0 : (Ideal.Quotient.mk (Ideal.map g pA))
        (g r - algebraMap L (((C.baseChange L).left).presheaf.obj
          (Opposite.op (C.bcOpens L W))) (algebraMap k L c)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hmemI
    rw [map_sub] at h0
    exact (sub_eq_zero.mp h0).symm
  have hsurj : Function.Surjective ((Ideal.Quotient.mk (Ideal.map g pA)).comp
      (algebraMap L (((C.baseChange L).left).presheaf.obj
        (Opposite.op (C.bcOpens L W))))) := by
    rw [← RingHom.range_eq_top, eq_top_iff]
    intro y _
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hs : s ∈ Subring.closure (Set.range g ∪ Set.range (algebraMap L
        (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W))))) := by
      rw [hgen]; exact Subring.mem_top s
    have hmem := Subring.mem_closure_image_of (Ideal.Quotient.mk (Ideal.map g pA)) hs
    have hsub' : (Ideal.Quotient.mk (Ideal.map g pA)) '' (Set.range g ∪ Set.range
          (algebraMap L (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W))))) ⊆
        ↑(((Ideal.Quotient.mk (Ideal.map g pA)).comp (algebraMap L
          (((C.baseChange L).left).presheaf.obj (Opposite.op (C.bcOpens L W))))).range) := by
      intro z hz
      rw [Set.image_union] at hz
      rcases hz with hz | hz
      · obtain ⟨r, hr, rfl⟩ := hz
        obtain ⟨r₀, rfl⟩ := hr
        exact hmem_range r₀
      · obtain ⟨a, ha, rfl⟩ := hz
        obtain ⟨l, rfl⟩ := ha
        exact RingHom.mem_range.mpr ⟨l, rfl⟩
    exact Subring.closure_le.mpr hsub' hmem
  -- hence `𝔭S` is maximal, and so it equals `q'`
  have hImax : (Ideal.map g pA).IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨?_, ?_⟩
    · intro h1
      exact hqAne (le_antisymm le_top (Ideal.eq_top_iff_one _ |>.mpr h1 ▸ hI_le))
    · intro J x hIJ hxI hxJ
      obtain ⟨l, hl⟩ := hsurj ((Ideal.Quotient.mk (Ideal.map g pA)) x)
      have hmem : x - algebraMap L (((C.baseChange L).left).presheaf.obj
          (Opposite.op (C.bcOpens L W))) l ∈ Ideal.map g pA := by
        have hl' : (Ideal.Quotient.mk (Ideal.map g pA))
            (algebraMap L (((C.baseChange L).left).presheaf.obj
              (Opposite.op (C.bcOpens L W))) l) = (Ideal.Quotient.mk (Ideal.map g pA)) x := hl
        have h0 : (Ideal.Quotient.mk (Ideal.map g pA))
            (x - algebraMap L (((C.baseChange L).left).presheaf.obj
              (Opposite.op (C.bcOpens L W))) l) = 0 := by
          rw [map_sub, hl', sub_self]
        exact Ideal.Quotient.eq_zero_iff_mem.mp h0
      have hmemJ : x - algebraMap _ _ l ∈ J := hIJ hmem
      by_cases hl0 : l = 0
      · subst hl0
        rw [map_zero, sub_zero] at hmem
        exact absurd hmem hxI
      · have hhlJ : algebraMap L (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W))) l ∈ J := by
          have := J.sub_mem hxJ hmemJ
          rwa [sub_sub_cancel] at this
        have hunit : IsUnit (algebraMap L (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W))) l) := (isUnit_iff_ne_zero.mpr hl0).map _
        obtain ⟨uu, huu⟩ := hunit
        have h1 : (↑uu⁻¹ : (((C.baseChange L).left).presheaf.obj
              (Opposite.op (C.bcOpens L W)))) * algebraMap L (((C.baseChange L).left).presheaf.obj
              (Opposite.op (C.bcOpens L W))) l = 1 := by
          rw [← huu]; exact Units.inv_mul uu
        rw [← h1]
        exact J.mul_mem_left _ hhlJ
  have hIq : Ideal.map g pA = qA := hImax.eq_of_le hqAne hI_le
  -- the maximal ideal of `𝒪_{C_L,Q'}` is generated by the image of a uniformiser at `Q`
  have hmax : Ideal.map ψ (IsLocalRing.maximalIdeal
        (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))) =
      IsLocalRing.maximalIdeal (((C.baseChange L).left).presheaf.stalk Q'.point) := by
    have hmapA : IsLocalRing.maximalIdeal (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) =
        Ideal.map (algebraMap (C.left.presheaf.obj (Opposite.op W))
          (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))) pA :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal pA _).symm
    have hmapB : IsLocalRing.maximalIdeal (((C.baseChange L).left).presheaf.stalk Q'.point) =
        Ideal.map (algebraMap (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W)))
          (((C.baseChange L).left).presheaf.stalk Q'.point)) qA :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal qA _).symm
    calc Ideal.map ψ (IsLocalRing.maximalIdeal (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)))
        = Ideal.map ψ (Ideal.map (algebraMap (C.left.presheaf.obj (Opposite.op W))
            (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))) pA) := by rw [hmapA]
      _ = Ideal.map (ψ.comp (algebraMap (C.left.presheaf.obj (Opposite.op W))
            (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)))) pA :=
          Ideal.map_map (algebraMap (C.left.presheaf.obj (Opposite.op W))
            (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))) ψ
      _ = Ideal.map ((algebraMap (((C.baseChange L).left).presheaf.obj
              (Opposite.op (C.bcOpens L W)))
            (((C.baseChange L).left).presheaf.stalk Q'.point)).comp g) pA := by rw [hcompat]
      _ = Ideal.map (algebraMap (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W)))
            (((C.baseChange L).left).presheaf.stalk Q'.point)) (Ideal.map g pA) :=
          (Ideal.map_map g (algebraMap (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W)))
            (((C.baseChange L).left).presheaf.stalk Q'.point))).symm
      _ = Ideal.map (algebraMap (((C.baseChange L).left).presheaf.obj
            (Opposite.op (C.bcOpens L W)))
            (((C.baseChange L).left).presheaf.stalk Q'.point)) qA := by rw [hIq]
      _ = IsLocalRing.maximalIdeal (((C.baseChange L).left).presheaf.stalk Q'.point) := hmapB.symm
  -- conclude
  let gen : C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point) :=
    Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal
      (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)))
  have hspan_gen : Ideal.span {gen} = IsLocalRing.maximalIdeal
      (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) :=
    Submodule.IsPrincipal.span_singleton_generator _
  have hspan : Ideal.span {ψ gen} =
      IsLocalRing.maximalIdeal (((C.baseChange L).left).presheaf.stalk Q'.point) := by
    rw [← hmax, ← hspan_gen, Ideal.map_span, Set.image_singleton]
  have hgenne : gen ≠ 0 := by
    intro h0
    refine IsDiscreteValuationRing.not_a_field
      (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) ?_
    rw [← hspan_gen, h0]
    exact Ideal.span_singleton_eq_bot.mpr rfl
  have hψne : ψ gen ≠ 0 := by
    intro h0
    have hffs : (Work.CurveBasics.Curve.functionFieldMap C L).hom
        (algebraMap (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))
          C.functionField gen)
        = algebraMap (((C.baseChange L).left).presheaf.stalk Q'.point)
            (((C.baseChange L).left).functionField) (ψ gen) :=
      Work.CurveBasics.Curve.functionFieldMap_stalkMap L Q'.point gen
    have h1 : (Work.CurveBasics.Curve.functionFieldMap C L).hom
        (algebraMap (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))
          C.functionField gen) = 0 := by
      rw [hffs, h0, map_zero]
    have h2 : algebraMap (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))
        C.functionField gen = 0 :=
      Work.CurveBasics.Curve.functionFieldMap_injective C L (by rw [h1, map_zero])
    exact hgenne (IsFractionRing.injective
      (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) C.functionField
      (by rw [h2, map_zero]))
  have hIrr : Irreducible (ψ gen) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hψne (eq_comm.mp hspan)
  rw [show (C.under L Q' hcl).uniformizer = algebraMap
      (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point)) C.functionField gen from rfl]
  rw [show (Work.CurveBasics.Curve.functionFieldMap C L).hom
        (algebraMap (C.left.presheaf.stalk ((C.baseChangeFst L) Q'.point))
          C.functionField gen)
        = algebraMap (((C.baseChange L).left).presheaf.stalk Q'.point)
            (((C.baseChange L).left).functionField) (ψ gen)
      from Work.CurveBasics.Curve.functionFieldMap_stalkMap L Q'.point gen]
  rw [Work.CurveBasics.Curve.ordAt_eq_log_ordFrac]
  rw [Ring.ordFrac_irreducible hIrr, WithZero.log_exp]

theorem ramIdx_placeOfPoint_baseChange {k : Type u} [Field k] (C : Work.CurveBasics.Curve k)
    (L : Type u) [Field L] [Algebra k L] (p : Work.KeyLemma.Curve.Point C) :
    Work.CurveBasics.Curve.ramIdx C L
      (Work.KeyLemma.Curve.placeOfPoint (Work.CurveBasics.Curve.baseChange C L)
        (Work.KeyLemma.Curve.Pt.baseChange L p)) = 1 :=
  ramIdx_eq_one_of_fst_eq C L p _ (proj_placeOfPoint_baseChange C L p)

end Work.KeyLemma.BaseChange
