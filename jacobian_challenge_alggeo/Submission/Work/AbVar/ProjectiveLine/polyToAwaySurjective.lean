/-
Area AV: the chart `D₊(X_i)` of the projective line is a polynomial ring.

`polyToAway i j : R[T] →ₐ[R] Away 𝒜 (X_i)` sends `T` to `X_j/X_i`.  Here we prove that it is
surjective, i.e. that the degree zero part of `R[X₀,X₁]_{X_i}` is generated over `R` by `X_j/X_i`.

The proof uses the general theorem `Away.adjoin_mk_prod_pow_eq_top`, which says that the away ring
of a graded ring is generated by the fractions `∏ v ^ aᵢ / f ^ a`; for the standard grading of a
polynomial ring in two variables and `f = X_i`, these generators are shown below to be powers of
`X_j/X_i`.
-/
import Mathlib
import Submission.Work.AbVar.ProjectiveLine.chart

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option autoImplicit false

namespace Work.AbVar.ProjectiveLine

open AlgebraicGeometry MvPolynomial HomogeneousLocalization

section Helpers

/-- `R[X₀,X₁]` is generated over its degree zero part `↥(StdG R 0)` by the two variables. -/
lemma adjoin_range_X_stdG {R : Type*} [CommRing R] :
    Algebra.adjoin (StdG R 0) (Set.range (MvPolynomial.X : Fin 2 → Poly2 R)) = ⊤ := by
  rw [eq_top_iff]
  rintro p -
  induction p using MvPolynomial.induction_on with
  | C a => exact Subalgebra.algebraMap_mem _ (constToZero a)
  | add p q hp hq => exact add_mem hp hq
  | mul_X p n hp => exact mul_mem hp (Algebra.subset_adjoin (Set.mem_range_self n))

/-- Enlarging numerator and denominator of a homogeneous fraction by a common power of the
denominator does not change it. -/
lemma Away.mk_mul_pow {A : Type*} [CommRing A] {σ : Type*} [SetLike σ A] [AddSubgroupClass σ A]
    {ι : Type*} [AddCommMonoid ι] [DecidableEq ι] {𝒜 : ι → σ} [GradedRing 𝒜] {f : A} {d : ι}
    (hf : f ∈ 𝒜 d) {n : ℕ} {x : A} (hx : x ∈ 𝒜 (n • d)) (m : ℕ)
    (h : x * f ^ m ∈ 𝒜 ((n + m) • d)) :
    Away.mk 𝒜 hf (n + m) (x * f ^ m) h = Away.mk 𝒜 hf n x hx := by
  apply HomogeneousLocalization.val_injective
  simp only [Away.val_mk]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul]
  ring

/-- Congruence for the constructor `Away.mk`. -/
lemma Away.mk_congr {A : Type*} [CommRing A] {σ : Type*} [SetLike σ A] [AddSubgroupClass σ A]
    {ι : Type*} [AddCommMonoid ι] [DecidableEq ι] {𝒜 : ι → σ} [GradedRing 𝒜] {f : A} {d : ι}
    (hf : f ∈ 𝒜 d) {n n' : ℕ} (h : n = n') {x x' : A} (hx : x = x')
    (h₁ : x ∈ 𝒜 (n • d)) (h₂ : x' ∈ 𝒜 (n' • d)) :
    Away.mk 𝒜 hf n x h₁ = Away.mk 𝒜 hf n' x' h₂ := by
  subst h; subst hx; congr 1

/-- A power of `X_j/X_i` is the fraction `X_j ^ n / X_i ^ n`. -/
lemma awayU_pow {R : Type*} [CommRing R] (i j : Fin 2) (n : ℕ) :
    (awayU i j) ^ n = Away.mk (StdG R) (X_mem_stdG i) n ((MvPolynomial.X j : Poly2 R) ^ n)
      (SetLike.pow_mem_graded n (X_mem_stdG j)) := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_pow, awayU_val, Localization.mk_pow, Away.val_mk]
  congr 1
  exact Subtype.ext (by rw [SubmonoidClass.coe_pow, powOne_val, pow_one])

/-- The generators produced by `Away.adjoin_mk_prod_pow_eq_top` for the standard grading of
`R[X₀,X₁]` and `f = X_i` are powers of `X_j/X_i`. -/
lemma mk_prod_eq_awayU_pow {R : Type*} [CommRing R] {i j : Fin 2} (hij : j ≠ i)
    (a : ℕ) (ai : Fin 2 → ℕ) (hai : ∑ k, ai k • 1 = a • 1)
    (hb : (∏ k, (MvPolynomial.X k : Poly2 R) ^ ai k) ∈ StdG R (a • 1)) :
    Away.mk (StdG R) (X_mem_stdG i) a (∏ k, (MvPolynomial.X k : Poly2 R) ^ ai k) hb
      = (awayU (R := R) i j) ^ (ai j) := by
  have ha : ai 0 + ai 1 = a := by
    have h := hai; rw [Fin.sum_univ_two] at h
    simpa only [nsmul_eq_mul, mul_one, Nat.cast_id] using h
  fin_cases i <;> fin_cases j <;> try (exfalso; exact hij rfl)
  · have hprod : (∏ k, (MvPolynomial.X k : Poly2 R) ^ ai k)
        = (MvPolynomial.X 1 : Poly2 R) ^ (ai 1) * (MvPolynomial.X 0 : Poly2 R) ^ (ai 0) := by
      rw [Fin.prod_univ_two, mul_comm]
    have hmem : (MvPolynomial.X 1 : Poly2 R) ^ (ai 1) * (MvPolynomial.X 0 : Poly2 R) ^ (ai 0)
        ∈ StdG R ((ai 1 + ai 0) • 1) := by
      rw [add_smul]
      exact SetLike.mul_mem_graded (SetLike.pow_mem_graded (ai 1) (X_mem_stdG 1))
        (SetLike.pow_mem_graded (ai 0) (X_mem_stdG 0))
    refine (Away.mk_congr (hf := X_mem_stdG (0:Fin 2)) (n := a) (n' := ai 1 + ai 0)
      (x := ∏ k, (MvPolynomial.X k : Poly2 R) ^ ai k)
      (x' := (MvPolynomial.X 1 : Poly2 R) ^ (ai 1) * (MvPolynomial.X 0 : Poly2 R) ^ (ai 0))
      ?_ hprod hb hmem).trans ?_
    · omega
    · rw [Away.mk_mul_pow (hf := X_mem_stdG (0:Fin 2)) (x := (MvPolynomial.X 1 : Poly2 R) ^ (ai 1))
        (hx := SetLike.pow_mem_graded (ai 1) (X_mem_stdG 1)) (m := ai 0) hmem]
      exact (awayU_pow (R := R) 0 1 (ai 1)).symm
  · have hprod : (∏ k, (MvPolynomial.X k : Poly2 R) ^ ai k)
        = (MvPolynomial.X 0 : Poly2 R) ^ (ai 0) * (MvPolynomial.X 1 : Poly2 R) ^ (ai 1) := by
      rw [Fin.prod_univ_two]
    have hmem : (MvPolynomial.X 0 : Poly2 R) ^ (ai 0) * (MvPolynomial.X 1 : Poly2 R) ^ (ai 1)
        ∈ StdG R ((ai 0 + ai 1) • 1) := by
      rw [add_smul]
      exact SetLike.mul_mem_graded (SetLike.pow_mem_graded (ai 0) (X_mem_stdG 0))
        (SetLike.pow_mem_graded (ai 1) (X_mem_stdG 1))
    refine (Away.mk_congr (hf := X_mem_stdG (1:Fin 2)) (n := a) (n' := ai 0 + ai 1)
      (x := ∏ k, (MvPolynomial.X k : Poly2 R) ^ ai k)
      (x' := (MvPolynomial.X 0 : Poly2 R) ^ (ai 0) * (MvPolynomial.X 1 : Poly2 R) ^ (ai 1))
      ?_ hprod hb hmem).trans ?_
    · omega
    · rw [Away.mk_mul_pow (hf := X_mem_stdG (1:Fin 2)) (x := (MvPolynomial.X 0 : Poly2 R) ^ (ai 0))
        (hx := SetLike.pow_mem_graded (ai 0) (X_mem_stdG 0)) (m := ai 1) hmem]
      exact (awayU_pow (R := R) 1 0 (ai 0)).symm

end Helpers

theorem polyToAwaySurjective {R : Type*} [CommRing R] {i j : Fin 2} (hij : j ≠ i) :
    Function.Surjective (Work.AbVar.ProjectiveLine.polyToAway (R := R) i j) := by
  rw [← AlgHom.range_eq_top]
  rw [show (polyToAway (R := R) i j) = Polynomial.aeval (awayU (R := R) i j) from rfl]
  rw [← Algebra.adjoin_singleton_eq_range_aeval R (awayU (R := R) i j)]
  -- `Away 𝒜 (X_i)` is generated over its degree zero part by `X_j/X_i`.
  have hG : Algebra.adjoin ↥(StdG R 0)
      ({awayU (R := R) i j} : Set (Away (StdG R) (MvPolynomial.X i))) = ⊤ := by
    have hadj := Away.adjoin_mk_prod_pow_eq_top (𝒜 := StdG R) (f := (MvPolynomial.X i : Poly2 R))
        (d := 1) (X_mem_stdG i) (Fin 2) (fun k => (MvPolynomial.X k : Poly2 R))
        adjoin_range_X_stdG (fun _ => 1) (fun k => X_mem_stdG k)
    rw [eq_top_iff, ← hadj]
    apply Algebra.adjoin_le
    rintro g ⟨a, ai, hai, hai', hg⟩
    rw [← hg]
    rw [mk_prod_eq_awayU_pow hij a ai hai _]
    exact pow_mem (Algebra.subset_adjoin (Set.mem_singleton _)) (ai j)
  -- the `R`- and `↥(StdG R 0)`-algebra structures have the same scalars
  have mem_aux : ∀ y : Away (StdG R) (MvPolynomial.X i),
      y ∈ Algebra.adjoin ↥(StdG R 0) ({awayU (R := R) i j} : Set _) →
      y ∈ Algebra.adjoin R ({awayU (R := R) i j} : Set _) := by
    intro y hy
    rw [Algebra.mem_adjoin_iff] at hy ⊢
    apply Subring.closure_mono _ hy
    intro x hx
    rcases hx with hx | hx
    · rcases hx with ⟨c, rfl⟩
      refine Or.inl ⟨constToZeroEquiv.symm c, ?_⟩
      show algebraMap R (Away (StdG R) (MvPolynomial.X i)) (constToZeroEquiv.symm c)
        = algebraMap ↥(StdG R 0) (Away (StdG R) (MvPolynomial.X i)) c
      rw [show algebraMap R (Away (StdG R) (MvPolynomial.X i))
          = (algebraMap ↥(StdG R 0) (Away (StdG R) (MvPolynomial.X i))).comp
              (constToZeroEquiv (R := R)).toRingHom from rfl]
      simp
    · exact Or.inr hx
  rw [eq_top_iff]
  intro y _
  exact mem_aux y (by rw [hG]; exact trivial)

end Work.AbVar.ProjectiveLine
