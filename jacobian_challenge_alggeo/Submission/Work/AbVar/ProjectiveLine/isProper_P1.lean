import Mathlib
import Submission.Work.AbVar.Basic
import Submission.Work.AbVar.ProjectiveLine

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The projective line is proper over its base field

`Work.AbVar.P1 k` is `Proj k[X₀, X₁]` for the standard grading, with the base
`Spec (𝒜 0) ≅ Spec k` (see `Work.AbVar.ProjectiveLine`).  Mathlib knows that
`Proj.toSpecZero 𝒜 : Proj 𝒜 ⟶ Spec (𝒜 0)` is proper as soon as the graded ring `A`
is a finite type algebra over its degree-zero part `𝒜 0`
(`AlgebraicGeometry.Proj.isProper_toSpecZero`).  In this file we supply that
hypothesis for the standard grading of a multivariate polynomial ring, and then
deduce properness of the structure morphism of `P1 k`.

## Main results

* `Work.AbVar.ProjectiveLine.finiteType_homogeneousSubmodule_zero`: for a finite
  variable type `σ` and a commutative ring `R`, the polynomial ring `R[Xᵢ]` is a
  finitely generated `↥(𝒜 0)`-algebra, where `𝒜` is the grading by total degree.
* `Work.AbVar.ProjectiveLine.isProper_P1`: the projective line over a field `k` is
  proper over `k`.
-/

set_option autoImplicit false

namespace Work.AbVar.ProjectiveLine

open AlgebraicGeometry CategoryTheory

-- The standard grading of `R[X₀, X₁]` by total degree, made available as a local instance in
-- this file so that `Proj (P1Grading k)` can be formed and so that Mathlib's properness
-- instance for `Proj.toSpecZero` applies.
attribute [local instance] MvPolynomial.gradedAlgebra

/-- **The polynomial ring is finite type over the degree-zero part of its standard grading.**

Let `𝒜 = MvPolynomial.homogeneousSubmodule σ R` be the grading of `R[Xᵢ]` (`i : σ`) by total
degree.  The degree-zero part `↥(𝒜 0)` is the image of `R` under `MvPolynomial.C`, and the
variables `Xᵢ` generate `R[Xᵢ]` over it.  Hence `R[Xᵢ]` is a finitely generated
`↥(𝒜 0)`-algebra — the hypothesis needed to apply
`AlgebraicGeometry.Proj.isProper_toSpecZero`.

Note that the `Algebra ↥(𝒜 0) (MvPolynomial σ R)` structure used here is the canonical one
coming from the graded ring structure, whose algebra map is the inclusion `↥(𝒜 0) ↪ R[Xᵢ]`. -/
theorem finiteType_homogeneousSubmodule_zero (σ R : Type*) [Fintype σ] [CommRing R] :
    Algebra.FiniteType ↥(MvPolynomial.homogeneousSubmodule σ R 0) (MvPolynomial σ R) := by
  classical
  have hC : ∀ a : R, MvPolynomial.C a ∈
      (MvPolynomial.homogeneousSubmodule σ R 0 : Submodule R (MvPolynomial σ R)) := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule (σ := σ) (R := R) 0 _).mpr
      (MvPolynomial.isHomogeneous_C σ a)
  refine ⟨Finset.univ.image (MvPolynomial.X : σ → MvPolynomial σ R), ?_⟩
  rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  -- Every polynomial lies in the subalgebra generated by the variables `Xᵢ`.
  have key : ∀ p : MvPolynomial σ R, p ∈ Algebra.adjoin ↥(MvPolynomial.homogeneousSubmodule σ R 0)
      (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
        -- constants are the image of the algebra map `↥(𝒜 0) → R[Xᵢ]`
        have h : MvPolynomial.C a = (algebraMap ↥(MvPolynomial.homogeneousSubmodule σ R 0)
            (MvPolynomial σ R)) ⟨MvPolynomial.C a, hC a⟩ := rfl
        rw [h]
        exact Subalgebra.algebraMap_mem _ _
    | add p q hp hq => exact Subalgebra.add_mem _ hp hq
    | mul_X p n hp =>
        exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin (Set.mem_range_self n))
  exact le_antisymm le_top fun p _ => key p

open CategoryTheory in
theorem isProper_P1 (k : Type*) [Field k] : AlgebraicGeometry.IsProper (Work.AbVar.P1 k).hom := by
  -- Mathlib's properness of `Proj` needs the graded ring to be of finite type over `𝒜 0`.
  have : Algebra.FiniteType ↥(P1Grading k 0) (MvPolynomial (Fin 2) k) :=
    finiteType_homogeneousSubmodule_zero (Fin 2) k
  -- The base change `Spec (𝒜 0) ⟶ Spec k` is `Spec` of a ring equivalence, hence an iso.
  have : IsIso (CommRingCat.ofHom (p1BaseEquiv k).toRingHom) :=
    (p1BaseEquiv k).toCommRingCatIso.isIso_hom
  change IsProper (Proj.toSpecZero (P1Grading k) ≫
    Spec.map (CommRingCat.ofHom (p1BaseEquiv k).toRingHom))
  exact inferInstance

end Work.AbVar.ProjectiveLine
