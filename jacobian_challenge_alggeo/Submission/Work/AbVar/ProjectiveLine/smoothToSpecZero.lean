/-
Area AV: smoothness of the structure morphism `Proj R[X₀,X₁] ⟶ Spec R`.

`Proj.toSpecZero` of a graded ring `A` is smooth over `Spec ↧(𝒜 0)` as soon as its
standard affine charts `D₊(X i)` are: those charts cover `Proj 𝒜` (the irrelevant ideal
is generated by `X 0` and `X 1`), and on `D₊(X i)` the structure morphism is, by
`AlgebraicGeometry.Proj.awayι_toSpecZero`, `Spec` of the ring homomorphism
`fromZeroRingHom 𝒜 (Submonoid.powers (X i))`.  Smoothness is Zariski-local at the source,
which is the content of `IsZariskiLocalAtSource.iff_of_iSup_eq_top`.
-/
import Mathlib
import Submission.Work.AbVar.ProjectiveLine.chart

namespace Work.AbVar.ProjectiveLine

open AlgebraicGeometry MvPolynomial HomogeneousLocalization CategoryTheory

theorem smoothToSpecZero (R : Type*) [CommRing R]
    (h : ∀ i : Fin 2, RingHom.Smooth (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin 2) R) (Submonoid.powers (MvPolynomial.X i)))) :
    AlgebraicGeometry.Smooth (AlgebraicGeometry.Proj.toSpecZero
      (MvPolynomial.homogeneousSubmodule (Fin 2) R)) := by
  -- This option is needed for the instance `IsZariskiLocalAtSource Smooth`
  -- (it is the same workaround Mathlib uses for `LocallyOfFiniteType` of `Proj.toSpecZero`).
  set_option backward.isDefEq.respectTransparency.types false in
  let A := MvPolynomial (Fin 2) R
  let 𝒜 : ℕ → Submodule R A := MvPolynomial.homogeneousSubmodule (Fin 2) R
  -- The variables generate `R[X₀,X₁]` as an `↥(𝒜 0)`-algebra.
  have adjoin : Algebra.adjoin (↥(𝒜 0)) (Set.range (fun i : Fin 2 => (MvPolynomial.X i : A))) = ⊤ := by
    rw [eq_top_iff]
    intro p hp
    clear hp
    induction p using MvPolynomial.induction_on with
    | C a =>
      have hmem : (MvPolynomial.C a : A) ∈ 𝒜 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C (Fin 2) a)
      have : (MvPolynomial.C a : A) =
          algebraMap (↥(𝒜 0)) A ⟨MvPolynomial.C a, hmem⟩ :=
        (SetLike.GradeZero.algebraMap_apply (A := 𝒜) ⟨MvPolynomial.C a, hmem⟩).symm
      rw [this]
      exact Subalgebra.algebraMap_mem _ _
    | add p q hp hq => exact add_mem hp hq
    | mul_X p n hp => exact mul_mem hp (Algebra.subset_adjoin (Set.mem_range_self n))
  -- Hence the charts `D₊(X 0)` and `D₊(X 1)` cover `Proj R[X₀,X₁]`.
  have hcover : ⨆ i : Fin 2, Proj.basicOpen 𝒜 (MvPolynomial.X i : A) = ⊤ :=
    Proj.iSup_basicOpen_eq_top' 𝒜 (fun i => (MvPolynomial.X i : A))
      (fun i => ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X R i)⟩)
      adjoin
  -- Smoothness is Zariski-local at the source.
  have key := IsZariskiLocalAtSource.iff_of_iSup_eq_top (P := @AlgebraicGeometry.Smooth)
    (f := Proj.toSpecZero 𝒜)
    (U := fun i : Fin 2 => Proj.basicOpen 𝒜 (MvPolynomial.X i : A)) hcover
  rw [key]
  intro i
  -- On the chart `D₊(X i)` the structure morphism is the `Spec` of `fromZeroRingHom`.
  rw [← MorphismProperty.cancel_left_of_respectsIso (P := @AlgebraicGeometry.Smooth)
      (f := (Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X i : A)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R i))
        Nat.zero_lt_one).inv),
    ← Category.assoc, ← Proj.awayι,
    Proj.awayι_toSpecZero, HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Smooth)]
  exact h i

end Work.AbVar.ProjectiveLine
