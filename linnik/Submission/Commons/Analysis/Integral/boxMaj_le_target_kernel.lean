      rcases eq_or_lt_of_le hu0 with h|h
      · rw [← h]; ring_nf; positivity
      · rw [le_div_iff₀ (by positivity)]
        nlinarith [mul_nonneg h.le (sub_nonneg.mpr (mul_self_le_mul_self (by linarith : (0:ℝ) ≤ 1+u) hsb))]
    have huni : (1+u)+1 ≤ (13/5)*((1/2+u)*(1+u)^2/((1/2+u)^2+(1+u)^2)
        + (2-u)*(1+u)^2/((2-u)^2+(1+u)^2)) := by
      have h0 := boxMaj_regionC_aux (1+u) (by linarith) (by linarith)
      have hrw : 3-(1+u) = 2-u := by ring
