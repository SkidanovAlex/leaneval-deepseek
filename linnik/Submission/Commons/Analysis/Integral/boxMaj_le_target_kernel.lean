/-! ## Elementary bounds used in the proof of `boxMaj_le_target_kernel` -/

/-- `log 4 ≤ 13863/10000`. -/
lemma boxMaj_log_four_le : Real.log 4 ≤ 13863/10000 := by
  have h : Real.log 4 = 2 * Real.log 2 := by
    rw [show (4:ℝ) = 2^2 by norm_num, Real.log_pow]; norm_num
  have h2 := Real.log_two_lt_d9
  linarith

/-- Concavity of the logarithm, weighted form. -/
lemma boxMaj_log_weighted_ge {a b θ : ℝ} (ha : 0 < a) (hb : 0 < b) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) :
    θ * Real.log a + (1 - θ) * Real.log b ≤ Real.log (θ * a + (1 - θ) * b) := by
  have h1 : a ^ θ * b ^ (1 - θ) ≤ θ * a + (1 - θ) * b :=
    Real.geom_mean_le_arith_mean2_weighted hθ0 (by linarith) ha.le hb.le (by ring)
  have h2 : Real.log (a ^ θ * b ^ (1 - θ)) ≤ Real.log (θ * a + (1 - θ) * b) :=
    Real.log_le_log (by positivity) h1
  rw [Real.log_mul (by positivity) (by positivity), Real.log_rpow ha, Real.log_rpow hb] at h2
  linarith

/-- Chord bound for `-log` on `[1/4,1]`: `-log s ≤ (37/20)(1-s)`. -/
lemma boxMaj_neg_log_le_slope {s : ℝ} (h1 : 1/4 ≤ s) (h2 : s ≤ 1) : -Real.log s ≤ (37/20)*(1-s) := by
  have hs0 : (0:ℝ) < s := by linarith
  have hθ0 : (0:ℝ) ≤ (4/3)*(1-s) := by linarith
  have hθ1 : (4/3)*(1-s) ≤ 1 := by linarith
  have hchord := boxMaj_log_weighted_ge (a := (1/4:ℝ)) (b := 1) (θ := (4/3)*(1-s))
      (by norm_num) (by norm_num) hθ0 hθ1
  have hrep : ((4:ℝ)/3*(1-s))*(1/4) + (1-(4/3)*(1-s))*1 = s := by ring
  rw [hrep, Real.log_one, mul_zero] at hchord
  have hlog14 : Real.log (1/4) = -Real.log 4 := by
    rw [Real.log_div (by norm_num) (by norm_num : (4:ℝ) ≠ 0), Real.log_one, zero_sub]
  rw [hlog14] at hchord
  have h4 := boxMaj_log_four_le
  have hnn : (0:ℝ) ≤ 1 - s := by linarith
  nlinarith [hchord, h4, hnn]

/-- `1/√(1+t) ≤ 1 - t/4` for `t ∈ [0,1]`. -/
lemma boxMaj_inv_sqrt_one_add_le {t : ℝ} (h0 : 0 ≤ t) (h1 : t ≤ 1) :
    (1:ℝ)/Real.sqrt (1+t) ≤ 1 - t/4 := by
  have hpos : (0:ℝ) < Real.sqrt (1+t) := Real.sqrt_pos.mpr (by linarith)
  have h4 : (0:ℝ) < 1 - t/4 := by linarith
  rw [div_le_iff₀ hpos]
  have h_aux : (0:ℝ) ≤ (1-t)*(6-t) + 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr h1) (by linarith : (0:ℝ) ≤ 6-t)]
  have hsq : (1:ℝ) ≤ (1-t/4)^2*(1+t) := by nlinarith [h_aux, h0]
  have heq : ((1-t/4)*Real.sqrt (1+t))^2 = (1-t/4)^2*(1+t) := by
    rw [mul_pow, Real.sq_sqrt (by linarith)]
  have ha : (0:ℝ) ≤ (1-t/4)*Real.sqrt (1+t) := le_of_lt (mul_pos h4 hpos)
  by_contra hc
  push_neg at hc
  have h2 : ((1-t/4)*Real.sqrt (1+t))^2 ≤ (1-t/4)*Real.sqrt (1+t) := by
    have := mul_le_mul_of_nonneg_left hc.le ha
    simpa [pow_two, mul_one] using this
  nlinarith [h2, hc, heq, hsq]

/-- `b/√(b²+s²) ≤ 1 - s²/(4b²)` for `0 < b`, `0 ≤ s ≤ b`. -/
lemma boxMaj_div_sqrt_le {b s : ℝ} (hb : 0 < b) (hs : 0 ≤ s) (hsb : s ≤ b) :
    b/Real.sqrt (b^2+s^2) ≤ 1 - s^2/(4*b^2) := by
  have hb2 : (0:ℝ) < b^2 := by positivity
  have ht0 : (0:ℝ) ≤ s^2/b^2 := by positivity
  have ht1 : s^2/b^2 ≤ 1 := by rw [div_le_one hb2]; nlinarith
  have hkey := boxMaj_inv_sqrt_one_add_le ht0 ht1
  have hsqrt : Real.sqrt (b^2+s^2) = b * Real.sqrt (1 + s^2/b^2) := by
    rw [show b^2+s^2 = b^2*(1+s^2/b^2) by field_simp]
    rw [Real.sqrt_mul (show (0:ℝ) ≤ b^2 by positivity), Real.sqrt_sq hb.le]
  rw [hsqrt]
  have h1 : b/(b*Real.sqrt (1+s^2/b^2)) = 1/Real.sqrt (1 + s^2/b^2) := by
    field_simp
  rw [h1]
  have heq : 1 - (s^2/b^2)/4 = 1 - s^2/(4*b^2) := by congr 1; field_simp
  linarith [hkey, heq.le, heq.ge]

