/-- Univariate auxiliary inequality used for the region `s > 1+u`. -/
lemma boxMaj_regionC_aux (b : ℝ) (h1 : 1 ≤ b) (h2 : b ≤ 2) :
    (b+1)*((b-1/2)^2+b^2)*((3-b)^2+b^2)
      ≤ (13/5)*((b-1/2)*b^2*((3-b)^2+b^2) + (3-b)*b^2*((b-1/2)^2+b^2)) := by
  have hc1 : (0:ℝ) ≤ b-1 := by linarith
  have hc2 : (0:ℝ) ≤ 2-b := by linarith
  have hcert : (0:ℝ) ≤ (1/2)*(2-b)^5 + 20*(b-1)*(2-b)^4 + 108*(b-1)^2*(2-b)^3
      + (885/4)*(b-1)^3*(2-b)^2 + 186*(b-1)^4*(2-b) + (197/4)*(b-1)^5 := by positivity
  have hkey : (13/5)*((b-1/2)*b^2*((3-b)^2+b^2) + (3-b)*b^2*((b-1/2)^2+b^2))
      - (b+1)*((b-1/2)^2+b^2)*((3-b)^2+b^2)
      = ((1/2)*(2-b)^5 + 20*(b-1)*(2-b)^4 + 108*(b-1)^2*(2-b)^3
      + (885/4)*(b-1)^3*(2-b)^2 + 186*(b-1)^4*(2-b) + (197/4)*(b-1)^5) := by ring
  linarith [hcert, hkey]

/-- Region `s > 1+u`. -/
lemma boxMaj_regionC (u s : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) (hsb : 1+u ≤ s) :
    2*(1+u)/(s*Real.sqrt ((1+u)^2+s^2))
      ≤ (13/5)*(((1/2+u)/((1/2+u)^2+s^2)) + ((2-u)/((2-u)^2+s^2))) + 2*u/((1+u)^2+s^2) := by
  have hb : (0:ℝ) < 1+u := by linarith
  have hs0 : (0:ℝ) < s := by linarith
  have hbc : (0:ℝ) < 1/2+u := by linarith
  have hstep1 : 2*(1+u)/(s*Real.sqrt ((1+u)^2+s^2)) ≤ 2*(1+u)/s^2 := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have hsq : s ≤ Real.sqrt ((1+u)^2+s^2) := by
      rw [Real.le_sqrt (by positivity) (by positivity)]
      nlinarith [sq_nonneg (1+u)]
    have hmul : s*s ≤ s*Real.sqrt ((1+u)^2+s^2) := mul_le_mul_of_nonneg_left hsq hs0.le
    nlinarith [hmul, hb]
  have hexpand : ((13/5)*(((1/2+u)/((1/2+u)^2+s^2)) + ((2-u)/((2-u)^2+s^2))) + 2*u/((1+u)^2+s^2)) * s^2
      = (13/5)*((1/2+u)*s^2/((1/2+u)^2+s^2) + (2-u)*s^2/((2-u)^2+s^2)) + 2*u*s^2/((1+u)^2+s^2) := by
    field_simp
  have hstep2 : 2*(1+u)/s^2
      ≤ (13/5)*(((1/2+u)/((1/2+u)^2+s^2)) + ((2-u)/((2-u)^2+s^2))) + 2*u/((1+u)^2+s^2) := by
    rw [div_le_iff₀ (by positivity), hexpand]
    have hm1 : (1/2+u)*(1+u)^2/((1/2+u)^2+(1+u)^2) ≤ (1/2+u)*s^2/((1/2+u)^2+s^2) := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith [mul_nonneg (mul_nonneg (pow_nonneg hbc.le 3) (sub_nonneg.mpr hsb))
        (by linarith : (0:ℝ) ≤ s + (1+u))]
    have hm2 : (2-u)*(1+u)^2/((2-u)^2+(1+u)^2) ≤ (2-u)*s^2/((2-u)^2+s^2) := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith [mul_nonneg (mul_nonneg (pow_nonneg (by linarith : (0:ℝ) ≤ 2-u) 3) (sub_nonneg.mpr hsb))
