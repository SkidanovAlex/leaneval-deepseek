/-- **Main inequality**: the elementary majorant for the box kernel is dominated by the
target Poisson-type kernel. -/
theorem boxMaj_le_target_kernel {β : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1) :
    ∀ s : ℝ, 1/4 ≤ s →
      (if s ≤ 2-β then Real.log ((4*(2-β)^2+s^2)/(2*(2-β)*s)) * (1 - s^2/(4*(2-β)^2))
        else (2-β)^2/(s*Real.sqrt ((2-β)^2+s^2)))
      + (if s ≤ β then Real.log ((4*β^2+s^2)/(2*β*s)) * (1 - s^2/(2*((2-β)^2+β^2)))
        else (2-β)*β/(s*Real.sqrt ((2-β)^2+s^2)))
      ≤ (13/5)*((3/2-β)/((3/2-β)^2+s^2)+(1+β)/((1+β)^2+s^2))
        + ((2-β)^2-β^2)/(2*((2-β)^2+s^2)) + ((2-β)^2-β^2)^2/(8*((2-β)^2+s^2)^2)
        + ((2-β)^2-β^2)^3/(16*((2-β)^2+s^2)^3) := by
  intro s hs
  set u : ℝ := 1 - β with hu
  have hu0 : (0:ℝ) < u := by rw [hu]; linarith
  have hu1 : u < 1 := by rw [hu]; linarith
  have hβeq : β = 1 - u := by rw [hu]; ring
  have h2β : (2:ℝ) - β = 1 + u := by rw [hβeq]; ring
  have h32 : (3:ℝ)/2 - β = 1/2 + u := by rw [hβeq]; ring
  have h1β : (1:ℝ) + β = 2 - u := by rw [hβeq]; ring
  rw [h2β, h32, h1β, hβeq]
  have hδ : (1+u)^2-(1-u)^2 = 4*u := by ring
  rw [hδ]
  have hb0 : (0:ℝ) < 1+u := by linarith
  have hs0 : (0:ℝ) < s := by linarith
  rcases le_or_gt s (1-u) with hA | hA
  · -- ===== Case A : s ≤ 1-u =====
    rw [if_pos (by linarith : s ≤ 1+u), if_pos hA]
    have h1s : s ≤ 1 := by linarith
    have h1u : (0:ℝ) < 1 - u := by linarith
    have hu34 : u ≤ 3/4 := by linarith
    have hv1 : (0:ℝ) ≤ 1 - s^2/(4*(1+u)^2) := by
      rw [sub_nonneg, div_le_one (by positivity)]; nlinarith
    have hv2 : (0:ℝ) ≤ 1 - s^2/(2*((1+u)^2+(1-u)^2)) := by
      rw [sub_nonneg, div_le_one (by positivity)]; nlinarith
    have hlog1 : Real.log ((4*(1+u)^2+s^2)/(2*(1+u)*s))
        ≤ Real.log (2*(1+u)) + (37/20)*(1-s) + s^2/(4*(1+u)^2) := by
      rw [show (4*(1+u)^2+s^2)/(2*(1+u)*s) = (2*(1+u)/s) * (1 + s^2/(4*(1+u)^2)) by field_simp; ring]
      rw [Real.log_mul (by positivity) (by positivity), Real.log_div (by positivity) (by positivity)]
      have hψ := boxMaj_neg_log_le_slope hs h1s
      have h1 : Real.log (1 + s^2/(4*(1+u)^2)) ≤ s^2/(4*(1+u)^2) := by
        have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1 + s^2/(4*(1+u)^2) by positivity)
        linarith
      linarith
    have hlog2 : Real.log ((4*(1-u)^2+s^2)/(2*(1-u)*s))
        ≤ Real.log (2*(1-u)) + (37/20)*(1-s) + s^2/(4*(1-u)^2) := by
      rw [show (4*(1-u)^2+s^2)/(2*(1-u)*s) = (2*(1-u)/s) * (1 + s^2/(4*(1-u)^2)) by field_simp; ring]
      rw [Real.log_mul (by positivity) (by positivity), Real.log_div (by positivity) (by positivity)]
      have hψ := boxMaj_neg_log_le_slope hs h1s
      have h1 : Real.log (1 + s^2/(4*(1-u)^2)) ≤ s^2/(4*(1-u)^2) := by
        have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1 + s^2/(4*(1-u)^2) by positivity)
        linarith
      linarith
    have hL1 : Real.log ((4*(1+u)^2+s^2)/(2*(1+u)*s)) * (1 - s^2/(4*(1+u)^2))
        ≤ Real.log (2*(1+u)) + (37/20)*(1-s) + s^2/(4*(1+u)^2) := by
      have hp : (0:ℝ) ≤ Real.log ((4*(1+u)^2+s^2)/(2*(1+u)*s)) := by
        apply Real.log_nonneg
        rw [le_div_iff₀ (by positivity)]
        nlinarith [sq_nonneg (2*(1+u)-s)]
      have hv1n : (0:ℝ) ≤ s^2/(4*(1+u)^2) := by positivity
