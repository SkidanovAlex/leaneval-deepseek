namespace Commons.Analysis.Integral

set_option maxHeartbeats 8000000
set_option maxRecDepth 10000

open Real

/-!
# Nonnegativity of the elementary lower bound `Wg` for the box-kernel integrand

With `u = 1 - β` the expression of the statement is

`Wg(u,t) = (13/5)·((1/2+u)/((1/2+u)²+t²) + (2-u)/((2-u)²+t²)) + 2u/Q + 2u²/Q² + 4u³/Q³
            - (log(2(1+u)) - log t + t²/(4(1+u)²))
            - (if t ≤ 1-u then log(2(1-u)) - log t + t²/(4(1-u)²) else (1-u)/t)`

(`Q = (1+u)²+t²`).  We show `Wg ≥ 0` for `0 < β < 1`, `1/6 ≤ t ≤ 5/6`.
-/

/-! ## Value bounds for the logarithm -/

lemma wgLog6_le : Real.log 6 ≤ 179176/100000 := by
  have hm : Real.log 6 = Real.log 2 + Real.log 3 := by
    rw [show (6:ℝ) = 2*3 by norm_num, Real.log_mul (by norm_num) (by norm_num)]
  rw [hm]; linarith [Real.log_two_lt_d9, Real.log_three_lt_d9]

lemma wgLogSixFifths_le : Real.log ((6:ℝ)/5) ≤ 18233/100000 := by
  have hm : Real.log ((6:ℝ)/5) = Real.log 6 - Real.log 5 := by
    rw [Real.log_div (by norm_num) (by norm_num)]
  have h6 : Real.log 6 = Real.log 2 + Real.log 3 := by
    rw [show (6:ℝ) = 2*3 by norm_num, Real.log_mul (by norm_num) (by norm_num)]
  rw [hm, h6]
  linarith [Real.log_two_lt_d9, Real.log_three_lt_d9, Real.log_five_gt_d9]

/-! ## Chord bounds for `-log` -/

/-- Chord bound for `-log` on `[1/4,5/6]`. -/
lemma wg_neg_log_chord_quarter {s : ℝ} (h1 : 1/4 ≤ s) (h2 : s ≤ 5/6) :
    -Real.log s ≤ 13863/10000 - (361191/175000)*(s - 1/4) := by
  set θ : ℝ := (12/7)*(5/6 - s) with hθ
  have hθ0 : 0 ≤ θ := by rw [hθ]; nlinarith
  have hθ1 : θ ≤ 1 := by rw [hθ]; nlinarith
  have hw := boxMaj_log_weighted_ge (a := (1/4:ℝ)) (b := (5/6:ℝ)) (θ := θ)
      (by norm_num) (by norm_num) hθ0 hθ1
  have harg : θ*(1/4) + (1-θ)*(5/6) = s := by rw [hθ]; ring
  rw [harg] at hw
  have e1 : Real.log (1/4:ℝ) = -Real.log 4 := by
    rw [Real.log_div (by norm_num) (by norm_num : (4:ℝ) ≠ 0), Real.log_one, zero_sub]
  have e2 : Real.log (5/6:ℝ) = -(Real.log 6 - Real.log 5) := by
    rw [Real.log_div (by norm_num) (by norm_num : (6:ℝ) ≠ 0)]
    ring
  rw [e1, e2] at hw
  have hle : -Real.log s ≤ θ*Real.log 4 + (1-θ)*(Real.log 6 - Real.log 5) := by linarith [hw]
  have h4 : Real.log 4 ≤ 13863/10000 := boxMaj_log_four_le
  have h65 : Real.log 6 - Real.log 5 ≤ 18233/100000 := by
    have h : Real.log ((6:ℝ)/5) ≤ 18233/100000 := wgLogSixFifths_le
    rwa [Real.log_div (by norm_num) (by norm_num)] at h
  have h1θ : 0 ≤ 1-θ := by linarith
  have hub : θ*Real.log 4 + (1-θ)*(Real.log 6 - Real.log 5)
      ≤ θ*(13863/10000) + (1-θ)*(18233/100000) := by
    have a := mul_le_mul_of_nonneg_left h4 hθ0
    have b := mul_le_mul_of_nonneg_left h65 h1θ
    linarith
  have hval : θ*(13863/10000) + (1-θ)*(18233/100000)
      = 13863/10000 - (361191/175000)*(s - 1/4) := by
    rw [hθ]; ring
  linarith [hle, hub, hval]

/-- Chord bound for `-log` on `[1/6,5/6]`. -/
lemma wg_neg_log_chord_sixth {s : ℝ} (h1 : 1/6 ≤ s) (h2 : s ≤ 5/6) :
    -Real.log s ≤ 179176/100000 - (482829/200000)*(s - 1/6) := by
  set θ : ℝ := (3/2)*(5/6 - s) with hθ
  have hθ0 : 0 ≤ θ := by rw [hθ]; nlinarith
  have hθ1 : θ ≤ 1 := by rw [hθ]; nlinarith
  have hw := boxMaj_log_weighted_ge (a := (1/6:ℝ)) (b := (5/6:ℝ)) (θ := θ)
      (by norm_num) (by norm_num) hθ0 hθ1
  have harg : θ*(1/6) + (1-θ)*(5/6) = s := by rw [hθ]; ring
  rw [harg] at hw
  have e1 : Real.log (1/6:ℝ) = -Real.log 6 := by
    rw [Real.log_div (by norm_num) (by norm_num : (6:ℝ) ≠ 0), Real.log_one, zero_sub]
  have e2 : Real.log (5/6:ℝ) = -(Real.log 6 - Real.log 5) := by
    rw [Real.log_div (by norm_num) (by norm_num : (6:ℝ) ≠ 0)]
    ring
  rw [e1, e2] at hw
  have hle : -Real.log s ≤ θ*Real.log 6 + (1-θ)*(Real.log 6 - Real.log 5) := by linarith [hw]
  have h6 : Real.log 6 ≤ 179176/100000 := wgLog6_le
  have h65 : Real.log 6 - Real.log 5 ≤ 18233/100000 := by
    have h : Real.log ((6:ℝ)/5) ≤ 18233/100000 := wgLogSixFifths_le
    rwa [Real.log_div (by norm_num) (by norm_num)] at h
  have h1θ : 0 ≤ 1-θ := by linarith
  have hub : θ*Real.log 6 + (1-θ)*(Real.log 6 - Real.log 5)
      ≤ θ*(179176/100000) + (1-θ)*(18233/100000) := by
    have a := mul_le_mul_of_nonneg_left h6 hθ0
    have b := mul_le_mul_of_nonneg_left h65 h1θ
    linarith
  have hval : θ*(179176/100000) + (1-θ)*(18233/100000)
      = 179176/100000 - (482829/200000)*(s - 1/6) := by
    rw [hθ]; ring
  linarith [hle, hub, hval]

