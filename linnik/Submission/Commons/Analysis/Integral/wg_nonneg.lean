      ((535634863349015591399617:ℝ)/376408917208235232000000)*u*s +
      ((157868183894681423537:ℝ)/929404733847494400000)*u^4 +
      ((219584797194127299169:ℝ)/522790162789215600000)*u^2*s^3 +
      ((16470565107769120650463:ℝ)/8364642604627449600000)*u^5 +
      ((67212221186890943959:ℝ)/29043897932734200000)*u^2*s^4 +
      ((270228222590132958427:ℝ)/29043897932734200000)*u^3*s^3 +
      ((1156363751505923567:ℝ)/756351508664953125)*u^6*s
      ) := by
    field_simp
    ring
  have hnn : 0 ≤ ((u+1/2)^2+s^2)*((2-u)^2+s^2)*((1+u)^2+s^2) * ((13/5)*((1/2+u)/((1/2+u)^2+s^2) + (2-u)/((2-u)^2+s^2)) + 2*u/((1+u)^2+s^2)
        - (13863/10000 + (179176/100000 - (482829/200000)*(s - 1/6)) + 1 + 25/144)) := by
    rw [hkey]; exact hcert
  have hpos : 0 < ((u+1/2)^2+s^2)*((2-u)^2+s^2)*((1+u)^2+s^2) := mul_pos (mul_pos hP1 hP2) hQ
  have h0 : (0:ℝ) ≤ (13/5)*((1/2+u)/((1/2+u)^2+s^2) + (2-u)/((2-u)^2+s^2)) + 2*u/((1+u)^2+s^2)
        - (13863/10000 + (179176/100000 - (482829/200000)*(s - 1/6)) + 1 + 25/144) := (mul_nonneg_iff_of_pos_left hpos).mp hnn
  linarith


/-! ## The positive part of the expression -/

/-- The positive (target-kernel) part of the expression, in the variable `u = 1 - β`. -/
noncomputable def wgT (u t : ℝ) : ℝ :=
  (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
  + 2*u/((1+u)^2+t^2) + 2*u^2/(((1+u)^2+t^2)^2) + 4*u^3/(((1+u)^2+t^2)^3)

/-! ## Case A : `t ≤ 1 - u` -/

/-- Case `t ≤ 1-u`: the `if` takes its "then" branch. -/
lemma wg_caseA {u t : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) (ht1 : 1/6 ≤ t) (ht2 : t ≤ 5/6)
    (htu : t ≤ 1 - u) :
    0 ≤ (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
        + (4*u)/(2*((1+u)^2+t^2)) + (4*u)^2/(8*((1+u)^2+t^2)^2) + (4*u)^3/(16*((1+u)^2+t^2)^3)
        - (Real.log (2*(1+u)) - Real.log t + t^2/(4*(1+u)^2))
        - (Real.log (2*(1-u)) - Real.log t + t^2/(4*(1-u)^2)) := by
  have ht0 : 0 < t := by linarith
  have hlog : Real.log (2*(1+u)) + Real.log (2*(1-u)) = Real.log (4*(1-u^2)) := by
    rw [← Real.log_mul (by positivity) (by positivity)]
    congr 1; ring
  have h3u : Real.log (4*(1-u^2)) ≤ 13863/10000 - u^2 := by
    rw [← hlog]; exact boxMaj_log_sum_le hu0 hu1
  have hconv : (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
        + (4*u)/(2*((1+u)^2+t^2)) + (4*u)^2/(8*((1+u)^2+t^2)^2) + (4*u)^3/(16*((1+u)^2+t^2)^3)
        - (Real.log (2*(1+u)) - Real.log t + t^2/(4*(1+u)^2))
        - (Real.log (2*(1-u)) - Real.log t + t^2/(4*(1-u)^2))
      = wgT u t - Real.log (4*(1-u^2)) + 2*Real.log t
          - t^2/(4*(1+u)^2) - t^2/(4*(1-u)^2) := by
    unfold wgT
    rw [← div_div, ← div_div, ← div_div, ← hlog]
    ring
  rw [hconv]
  rcases lt_or_ge t (1/4) with ht4 | ht4
  · -- ### sub-case `t < 1/4`
    have hb1 := boxMaj_regionA_sixth (u := u) (s := t) hu0 ht1 (le_of_lt ht4) htu
    have e1 : (4*u)/(2*((1+u)^2+t^2)) = 2*u/((1+u)^2+t^2) := by rw [← div_div]; ring
    have e2 : (4*u)^2/(8*((1+u)^2+t^2)^2) = 2*u^2/(((1+u)^2+t^2)^2) := by rw [← div_div]; ring
    have e3 : (4*u)^3/(16*((1+u)^2+t^2)^3) = 4*u^3/(((1+u)^2+t^2)^3) := by rw [← div_div]; ring
    rw [e1, e2, e3] at hb1
    have hb2 := boxMaj_neg_log_le_chord_sixth ht1 (le_of_lt ht4)
    have hb4 : t^2/(4*(1+u)^2) ≤ 1/64 := by
      rw [div_le_iff₀ (by positivity)]
      have hsq2 : t^2 ≤ 1/16 := by nlinarith [le_of_lt ht4, ht0]
      nlinarith [hsq2, hu0]
    unfold wgT
    linarith [hb1, hb2, h3u, hb4]
  · -- ### sub-case `1/4 ≤ t`
    have hb2 := wg_neg_log_chord_quarter ht4 ht2
    have hb4 : t^2/(4*(1+u)^2) ≤ 1/4 := by
      rw [div_le_iff₀ (by positivity)]
      nlinarith [ht2, ht0, hu0]
    have hb4b : t^2/(4*(1-u)^2) ≤ 1/4 := by
      rw [div_le_iff₀ (by positivity)]
      nlinarith [htu, ht0]
    have hus : u + t ≤ 1 := by linarith
    have hcert := wg_region_II hu0 ht4 ht2 hus
    have hchain : (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2)) + u - u^3
        ≤ (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
          + 2*u/((1+u)^2+t^2) + 2*u^2/(((1+u)^2+t^2)^2) + 4*u^3/(((1+u)^2+t^2)^3) := by
      have hle : u - u^3 ≤ 2*u/((1+u)^2+t^2) := by
        have hA : u/(1+u^2) ≤ 2*u/((1+u)^2+t^2) := by
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          have h1 : 0 ≤ 1 - u - t := by linarith
          have h2 : 0 ≤ 1 - u + t := by linarith
          have hmul : 0 ≤ (1-u-t)*(1-u+t) := mul_nonneg h1 h2
          have hsq : t^2 ≤ (1-u)^2 := by nlinarith [hmul]
          nlinarith [hsq, hu0]
        have hB : u - u^3 ≤ u/(1+u^2) := by
          rw [le_div_iff₀ (by positivity)]
          have h : (u - u^3)*(1+u^2) = u - u^5 := by ring
          rw [h]
          nlinarith [pow_nonneg hu0 5]
        linarith
      have hrest : (0:ℝ) ≤ 2*u^2/(((1+u)^2+t^2)^2) + 4*u^3/(((1+u)^2+t^2)^3) := by positivity
      linarith
    unfold wgT
    linarith [hchain, hcert, hb2, h3u, hb4, hb4b]

/-! ## Case B : `1 - u < t` -/

/-- Case `1-u < t`: the `if` takes its "else" branch. -/
lemma wg_caseB {u t : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1) (ht1 : 1/6 ≤ t) (ht2 : t ≤ 5/6)
    (htu : 1 - u < t) :
    0 ≤ (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
        + (4*u)/(2*((1+u)^2+t^2)) + (4*u)^2/(8*((1+u)^2+t^2)^2) + (4*u)^3/(16*((1+u)^2+t^2)^3)
        - (Real.log (2*(1+u)) - Real.log t + t^2/(4*(1+u)^2))
        - (1-u)/t := by
  have ht0 : 0 < t := by linarith
  have hconv : (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
        + (4*u)/(2*((1+u)^2+t^2)) + (4*u)^2/(8*((1+u)^2+t^2)^2) + (4*u)^3/(16*((1+u)^2+t^2)^3)
      = wgT u t := by
    unfold wgT
    rw [← div_div, ← div_div, ← div_div]
    ring
  rw [hconv]
  have hus : 1 ≤ u + t := by linarith
  have hcert := wg_caseB_ineq hu0 hu1 ht1 ht2 hus
  have hcut : (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2)) + 2*u/((1+u)^2+t^2)
      ≤ (13/5)*((1/2+u)/((1/2+u)^2+t^2)+(2-u)/((2-u)^2+t^2))
        + 2*u/((1+u)^2+t^2) + 2*u^2/(((1+u)^2+t^2)^2) + 4*u^3/(((1+u)^2+t^2)^3) := by
    have hrest : (0:ℝ) ≤ 2*u^2/(((1+u)^2+t^2)^2) + 4*u^3/(((1+u)^2+t^2)^3) := by positivity
    linarith
  have hlog2 : Real.log (2*(1+u)) ≤ 13863/10000 := by
    have hle : 2*(1+u) ≤ 4 := by linarith
    have h2 : Real.log (2*(1+u)) ≤ Real.log 4 := Real.log_le_log (by positivity) hle
    linarith [boxMaj_log_four_le]
  have hlogt : Real.log t ≥ -(179176/100000 - (482829/200000)*(t - 1/6)) := by
    have h := wg_neg_log_chord_sixth ht1 ht2
    linarith
  have hA : t^2/(4*(1+u)^2) ≤ 25/144 := by
    rw [div_le_iff₀ (by positivity)]
    nlinarith [ht2, hu0, sq_nonneg t]
  have hB : (1-u)/t ≤ 1 := by
    rw [div_le_one ht0]; linarith
  unfold wgT
  linarith [hcut, hcert, hlog2, hlogt, hA, hB]

/-! ## Main theorem -/

theorem wg_nonneg {β t : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1) (ht1 : 1/6 ≤ t) (ht2 : t ≤ 5/6) :
    0 ≤ (13/5)*((3/2-β)/((3/2-β)^2+t^2)+(1+β)/((1+β)^2+t^2))
        + ((2-β)^2-β^2)/(2*((2-β)^2+t^2))
        + ((2-β)^2-β^2)^2/(8*((2-β)^2+t^2)^2)
        + ((2-β)^2-β^2)^3/(16*((2-β)^2+t^2)^3)
        - (Real.log (2*(2-β)) - Real.log t + t^2/(4*(2-β)^2))
        - (if t ≤ β then Real.log (2*β) - Real.log t + t^2/(4*β^2) else β/t) := by
  set u : ℝ := 1 - β with hu
  have hu0 : 0 ≤ u := by rw [hu]; linarith
  have hu1 : u < 1 := by rw [hu]; linarith
  have h32 : 3/2 - β = 1/2 + u := by rw [hu]; ring
  have h1b : 1 + β = 2 - u := by rw [hu]; ring
  have h2b : 2 - β = 1 + u := by rw [hu]; ring
  have hb : β = 1 - u := by rw [hu]; ring
  have hdif : (2-β)^2 - β^2 = 4*u := by rw [h2b, hb]; ring
  rw [hdif, h32, h1b, h2b, hb]
  by_cases hcase : t ≤ 1 - u
  · rw [if_pos hcase]
    exact wg_caseA hu0 hu1 ht1 ht2 hcase
  · rw [if_neg hcase]
    exact wg_caseB hu0 (le_of_lt hu1) ht1 ht2 (lt_of_not_ge hcase)

end Commons.Analysis.Integral
