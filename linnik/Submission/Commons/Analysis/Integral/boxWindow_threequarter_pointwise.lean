    have h2 : (0:ℝ) ≤ ((2-β)^2-β^2)^2/(8*((2-β)^2+s^2)^2) := div_nonneg (by positivity) (by positivity)
    have h3 : (0:ℝ) ≤ ((2-β)^2-β^2)^3/(16*((2-β)^2+s^2)^3) := div_nonneg (by positivity) (by positivity)
    linarith
  rw [hsabs, if_pos h2b]
  by_cases hsb : s ≤ β
  · rw [if_pos hsb]
    have hb3 : (3:ℝ)/4 ≤ β := by linarith
    have h1 := tq_N1_le hβ0 hβ1 hs0 hs1
    have h2 := tq_N2log_le hβ0 hβ1 hs0 hs1 hsb
    have h3 := tq_log_bound hβ0 hβ1 hs0 hs1 hb3
    linarith
  · rw [if_neg hsb]
    have hb : β < 5/6 := by linarith
    have h1 := tq_N1_le hβ0 hβ1 hs0 hs1
    have h2 := tq_N2else_le hβ0 hβ1 hs0 hs1
    have h3 := tq_else_bound hβ0 hβ1 hs0 hs1 hb
    linarith

end Commons.Analysis.Integral