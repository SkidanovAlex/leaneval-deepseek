             else (2-β)^2/((|s|:ℝ) * Real.sqrt ((2-β)^2+(|s|:ℝ)^2)))
           + (if (|s|:ℝ) ≤ β then
              Real.log ((4*β^2+(|s|:ℝ)^2)/(2*β*(|s|:ℝ)))*(1-(|s|:ℝ)^2/(2*((2-β)^2+β^2)))
             else (2-β)*β/((|s|:ℝ) * Real.sqrt ((2-β)^2+(|s|:ℝ)^2))) )
