import Mathlib.Algebra.Order.Star.Real
import Mathlib.Analysis.Complex.ExponentialBounds

namespace Commons.Analysis.Integral

set_option maxHeartbeats 32000000
set_option maxRecDepth 100000



lemma tq_log_two_le : Real.log 2 ≤ 0.693148 := by
  linarith [Real.log_two_lt_d9]

lemma tq_log_four_thirds_le : Real.log ((4:ℝ)/3) ≤ 0.28769 := by
  have h2 := Real.log_two_lt_d9
  have h3 := Real.log_three_gt_d9
  have h4 : Real.log ((4:ℝ)/3) = 2*Real.log 2 - Real.log 3 := by
    rw [Real.log_div (by norm_num) (by norm_num)]
    rw [show (4:ℝ) = 2^2 by norm_num, Real.log_pow]
    norm_num
  rw [h4]; linarith

lemma tq_log_one_add_le (u : ℝ) (hu : 0 ≤ u) : Real.log (1+u) ≤ u := by
  have h := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1+u by linarith)
  linarith

lemma tq_log_one_add_ge (u : ℝ) (hu : 0 ≤ u) : u - u^2/2 ≤ Real.log (1+u) := by
  calc u - u^2/2 ≤ 2*u/(u+2) := by
        have hx2 : (0:ℝ) < u+2 := by linarith
        rw [le_div_iff₀ hx2]
        nlinarith [mul_nonneg hu (sq_nonneg u)]
    _ ≤ Real.log (1+u) := Real.le_log_one_add_of_nonneg hu

lemma tq_neg_log_le {s : ℝ} (hs0 : 3/4 ≤ s) :
    -Real.log s ≤ 0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2 := by
  have hspos : (0:ℝ) < s := by linarith
  set z : ℝ := (4/3)*(s-3/4) with hz
  have hz0 : 0 ≤ z := by rw [hz]; linarith
  have hs_eq : s = (3/4)*(1+z) := by rw [hz]; ring
  have hlog : Real.log s = Real.log ((3:ℝ)/4) + Real.log (1+z) := by
    rw [hs_eq, Real.log_mul (by norm_num) (by linarith)]
  have h34 : Real.log ((3:ℝ)/4) = - Real.log ((4:ℝ)/3) := by
    have hh : ((3:ℝ)/4) = ((4:ℝ)/3)⁻¹ := by norm_num
    rw [hh, Real.log_inv]
  have hge : z - z^2/2 ≤ Real.log (1+z) := tq_log_one_add_ge z hz0
  have h43 : Real.log ((4:ℝ)/3) ≤ 0.28769 := tq_log_four_thirds_le
  have hmain : Real.log ((4:ℝ)/3) - Real.log (1+z) ≤ 0.28769 - z + z^2/2 := by linarith
  calc -Real.log s = Real.log ((4:ℝ)/3) - Real.log (1+z) := by rw [hlog, h34]; ring
    _ ≤ 0.28769 - z + z^2/2 := hmain
    _ = 0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2 := by rw [hz]; ring

lemma tq_sqrt_lower {a c : ℝ} (ha : 0 < a) (hc : 0 < c) (hca : c ≤ a) :
    a + c^2/(2*a) - c^4/(8*a^3) ≤ Real.sqrt (a^2+c^2) := by
  have ha2 : (0:ℝ) < a^2 := by positivity
  set u : ℝ := c^2/a^2 with hu
  have hu0 : 0 ≤ u := by rw [hu]; positivity
  have hu1 : u ≤ 1 := by rw [hu, div_le_one ha2]; nlinarith
  have hkey : a^2 + c^2 = a^2*(1+u) := by rw [hu]; field_simp
  have hq : a + c^2/(2*a) - c^4/(8*a^3) = a*(1 + u/2 - u^2/8) := by rw [hu]; field_simp; try ring
  have hq0 : (0:ℝ) < 1 + u/2 - u^2/8 := by nlinarith [sq_nonneg u]
  have hsq : (1 + u/2 - u^2/8)^2 ≤ 1+u := by
    have h : (1 + u/2 - u^2/8)^2 = 1 + u - u^3/8 + u^4/64 := by ring
    rw [h]
    nlinarith [mul_nonneg (pow_nonneg hu0 3) (by linarith : (0:ℝ) ≤ 8-u)]
  have hsqrt : 1 + u/2 - u^2/8 ≤ Real.sqrt (1+u) :=
    (Real.le_sqrt hq0.le (by linarith)).mpr hsq
  have hrhs : Real.sqrt (a^2+c^2) = a*Real.sqrt (1+u) := by
    rw [hkey, Real.sqrt_mul (le_of_lt ha2), Real.sqrt_sq (le_of_lt ha)]
  rw [hq, hrhs]
  exact mul_le_mul_of_nonneg_left hsqrt (le_of_lt ha)


lemma tq_div_incr {c c' s : ℝ} (hc : 0 < c) (hs : 0 ≤ s) (hcc : c ≤ c') (hc's : c' ≤ s) :
    c/(c^2+s^2) ≤ c'/(c'^2+s^2) := by
  have hc'0 : 0 < c' := lt_of_lt_of_le hc hcc
  have h1 : (0:ℝ) < c^2+s^2 := by nlinarith [sq_nonneg c]
  have h2 : (0:ℝ) < c'^2+s^2 := by nlinarith [sq_nonneg c']
  rw [div_le_div_iff₀ h1 h2]
  have hcc2 : c*c' ≤ s*s := by
    have hm1 : c*c' ≤ c'*c' := mul_le_mul_of_nonneg_right hcc hc'0.le
    have hm2 : c'*c' ≤ s*s := mul_le_mul hc's hc's hc'0.le hs
    exact le_trans hm1 hm2
  nlinarith [hcc2, mul_nonneg (sub_nonneg.mpr hcc) (sub_nonneg.mpr hc's)]

lemma tq_div_decr {c c' s : ℝ} (hc : 0 < c) (hs : 0 ≤ s) (hcs : s ≤ c) (hcc : c ≤ c') :
    c'/(c'^2+s^2) ≤ c/(c^2+s^2) := by
  have hc'0 : 0 < c' := lt_of_lt_of_le hc hcc
  have h1 : (0:ℝ) < c^2+s^2 := by nlinarith [sq_nonneg c]
  have h2 : (0:ℝ) < c'^2+s^2 := by nlinarith [sq_nonneg c']
  rw [div_le_div_iff₀ h2 h1]
  have hcc2 : s*s ≤ c*c' := by
    have hm1 : s*s ≤ c*c := mul_le_mul hcs hcs hs hc.le
    have hm2 : c*c ≤ c*c' := mul_le_mul_of_nonneg_left hcc hc.le
    exact le_trans hm1 hm2
  nlinarith [hcc2, mul_nonneg (sub_nonneg.mpr hcc) (sub_nonneg.mpr hcs)]

lemma tq_g_mono {m1 m2 t : ℝ} (h1 : 1 ≤ m1) (h2 : m1 ≤ m2) (h3 : m2 ≤ 25/16)
    (ht0 : 9/16 ≤ t) (ht1 : t ≤ 25/36) :
    (m1+t)/((m1-t)^2+(25/4)*t) ≤ (m2+t)/((m2-t)^2+(25/4)*t) := by
  have hp1 : (0:ℝ) < (m1-t)^2+(25/4)*t := by nlinarith [sq_nonneg (m1-t)]
  have hp2 : (0:ℝ) < (m2-t)^2+(25/4)*t := by nlinarith [sq_nonneg (m2-t)]
  rw [div_le_div_iff₀ hp1 hp2]
  have hK : (0:ℝ) ≤ 3*t^2 - t*(m1+m2) + (25/4)*t - m1*m2 := by
    nlinarith [sq_nonneg (m1-1), sq_nonneg (m2-1), sq_nonneg (m1-25/16), sq_nonneg (m2-25/16), sq_nonneg (t-9/16), sq_nonneg (t-25/36), mul_nonneg (sub_nonneg.mpr h1) (sub_nonneg.mpr h2)]
  have hid : (m2+t)*((m1-t)^2+(25/4)*t) - (m1+t)*((m2-t)^2+(25/4)*t)
     = (m2-m1)*(3*t^2 - t*(m1+m2) + (25/4)*t - m1*m2) := by ring
  nlinarith [hK, h2, hid]

lemma tq_T_eq {β s : ℝ} (hβ0 : 0 ≤ β) (hβ1 : β ≤ 1) (hs0 : 3/4 ≤ s) :
    (13/5)*((3/2-β)/((3/2-β)^2+s^2)+(1+β)/((1+β)^2+s^2))
    = (13/2)*((((3/2-β)*(1+β))+s^2)/((((3/2-β)*(1+β))-s^2)^2+(25/4)*s^2)) := by
  have h1 : (3/2-β)^2+s^2 ≠ 0 := ne_of_gt (by positivity)
  have h2 : (1+β)^2+s^2 ≠ 0 := ne_of_gt (by positivity)
  have h3 : (((3/2-β)*(1+β))-s^2)^2+(25/4)*s^2 ≠ 0 := ne_of_gt (by positivity)
  field_simp
  ring

lemma tq_T_ge {β β' s : ℝ} (hβ0 : 0 ≤ β) (hβ0' : 0 ≤ β') (hβ1 : β ≤ 1) (hβ1' : β' ≤ 1)
    (hs0 : 3/4 ≤ s) (hs1 : s ≤ 5/6)
    (hm : (3/2-β')*(1+β') ≤ (3/2-β)*(1+β)) :
    (13/5)*((3/2-β')/((3/2-β')^2+s^2)+(1+β')/((1+β')^2+s^2))
    ≤ (13/5)*((3/2-β)/((3/2-β)^2+s^2)+(1+β)/((1+β)^2+s^2)) := by
  rw [tq_T_eq hβ0' hβ1' hs0, tq_T_eq hβ0 hβ1 hs0]
  have ht0 : (9:ℝ)/16 ≤ s^2 := by nlinarith
  have ht1 : s^2 ≤ 25/36 := by nlinarith
  have h1 : (1:ℝ) ≤ (3/2-β')*(1+β') := by
    nlinarith [hβ0', hβ1', mul_nonneg (by linarith : (0:ℝ) ≤ 1-β') (by linarith : (0:ℝ) ≤ 1+2*β')]
  have h3 : (3/2-β)*(1+β) ≤ 25/16 := by nlinarith [sq_nonneg (β-1/4)]
  exact mul_le_mul_of_nonneg_left (tq_g_mono h1 hm h3 ht0 ht1) (by norm_num)


lemma tq_N1_bound {β s b1 b2 : ℝ} (hs0 : 3/4 ≤ s) (hs1 : s ≤ 5/6) (hβ1 : β < 1)
    (hb1 : b1 ≤ β) (hb2 : β ≤ b2) (h1 : b1 ≤ 1) (h2 : b2 ≤ 1) :
    (1 - s^2/(4*(2-β)^2)) * ((0.693148 + 1 - β + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2)) + s^2/(4*(2-β)^2))
    ≤ (1 - s^2/(4*(2-b1)^2)) * ((0.693148 + 1 - b1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2)) + s^2/(4*(2-b2)^2)) := by
  have hspos : (0:ℝ) < s := by linarith
  have hb1' : (1:ℝ) ≤ 2-b1 := by linarith
  have hb2' : (1:ℝ) ≤ 2-b2 := by linarith
  have hβ2 : (1:ℝ) ≤ 2-β := by linarith
  have hdb1 : (0:ℝ) < 4*(2-b1)^2 := by positivity
  have hdb2 : (0:ℝ) < 4*(2-b2)^2 := by positivity
  have hdβ : (0:ℝ) < 4*(2-β)^2 := by positivity
  have hL : (0:ℝ) ≤ 0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2 := by
    have h1' := tq_neg_log_le hs0
    have h2' : (0:ℝ) ≤ -Real.log s := neg_nonneg.mpr (Real.log_nonpos (by linarith) (by linarith))
    linarith
  have hu1lo : s^2/(4*(2-b1)^2) ≤ s^2/(4*(2-β)^2) :=
    div_le_div_of_nonneg_left (by positivity) hdβ (by nlinarith [hb1, hβ2, hb1'])
  have hu1hi : s^2/(4*(2-β)^2) ≤ s^2/(4*(2-b2)^2) :=
    div_le_div_of_nonneg_left (by positivity) hdb2 (by nlinarith [hb2, hβ2, hb2'])
  have h1u : 1 - s^2/(4*(2-β)^2) ≤ 1 - s^2/(4*(2-b1)^2) := by linarith
  have hsum : 0.693148 + 1 - β + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2) + s^2/(4*(2-β)^2)
     ≤ 0.693148 + 1 - b1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2) + s^2/(4*(2-b2)^2) := by linarith
  have hc0 : (0:ℝ) ≤ 0.693148 + 1 - β + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2) + s^2/(4*(2-β)^2) := by
    have : (0:ℝ) ≤ s^2/(4*(2-β)^2) := by positivity
    linarith
  have hb0 : (0:ℝ) ≤ 1 - s^2/(4*(2-b1)^2) := by
    have hle : s^2/(4*(2-b1)^2) ≤ 1 := by
      rw [div_le_one hdb1]; nlinarith [hb1', hs0, hs1]
    linarith
  exact mul_le_mul h1u hsum hc0 hb0

lemma tq_N2log_bound {β s b1 b2 : ℝ} (hs0 : 3/4 ≤ s) (hs1 : s ≤ 5/6) (hβ1 : β < 1) (hβ34 : 3/4 ≤ β)
    (hb1 : b1 ≤ β) (hb2 : β ≤ b2) (h1 : b1 ≤ 1) (h2 : b2 ≤ 1) (hb1pos : 0 < b1) :
    (1 - s^2/(2*((2-β)^2+β^2))) * ((0.693148 + β - 1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2)) + s^2/(4*β^2))
    ≤ (1 - s^2/(2*((2-b1)^2+b1^2))) * ((0.693148 + b2 - 1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2)) + s^2/(4*b1^2)) := by
  have hspos : (0:ℝ) < s := by linarith
  have hβpos : (0:ℝ) < β := lt_of_lt_of_le hb1pos hb1
  have hL : (0:ℝ) ≤ 0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2 := by
    have h1' := tq_neg_log_le hs0
    have h2' : (0:ℝ) ≤ -Real.log s := neg_nonneg.mpr (Real.log_nonpos (by linarith) (by linarith))
    linarith
  have hD1 : (2-b2)^2+b2^2 ≤ (2-β)^2+β^2 := by nlinarith [hb2, hβ1]
  have hD2 : (2-β)^2+β^2 ≤ (2-b1)^2+b1^2 := by nlinarith [hb1, hβ1]
  have h2b : (0:ℝ) < 2-β := by linarith
  have hdβ : (0:ℝ) < 2*((2-β)^2+β^2) := by positivity
  have hu2lo : s^2/(2*((2-b1)^2+b1^2)) ≤ s^2/(2*((2-β)^2+β^2)) :=
    div_le_div_of_nonneg_left (by positivity) hdβ (by nlinarith [hD2])
  have hdb2' : (0:ℝ) < 2*((2-b2)^2+b2^2) := by
    have : (0:ℝ) < 2-b2 := by linarith
    positivity
  have hu2hi : s^2/(2*((2-β)^2+β^2)) ≤ s^2/(2*((2-b2)^2+b2^2)) :=
    div_le_div_of_nonneg_left (by positivity) hdb2' (by nlinarith [hD1])
  have h1u : 1 - s^2/(2*((2-β)^2+β^2)) ≤ 1 - s^2/(2*((2-b1)^2+b1^2)) := by linarith
  have hC : 0.693148 + β - 1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2) + s^2/(4*β^2)
     ≤ 0.693148 + b2 - 1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2) + s^2/(4*b1^2) := by
    have hv : s^2/(4*β^2) ≤ s^2/(4*b1^2) :=
      div_le_div_of_nonneg_left (by positivity) (by positivity) (by nlinarith [hb1, hb1pos, hβpos])
    linarith
  have hc0 : (0:ℝ) ≤ 0.693148 + β - 1 + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2) + s^2/(4*β^2) := by
    have : (0:ℝ) ≤ s^2/(4*β^2) := by positivity
    linarith
  have hb0 : (0:ℝ) ≤ 1 - s^2/(2*((2-b1)^2+b1^2)) := by
    have hle : s^2/(2*((2-b1)^2+b1^2)) ≤ 1 := by
      have : (0:ℝ) < 2*((2-b1)^2+b1^2) := by
        have h2b1 : (0:ℝ) < 2-b1 := by linarith
        positivity
      rw [div_le_one this]; nlinarith [hs0, hs1, sq_nonneg b1, h1, hβ1]
    linarith
  exact mul_le_mul h1u hC hc0 hb0



lemma tq_N2else_bound {β s b2 : ℝ} (hs0 : 3/4 ≤ s) (hs1 : s ≤ 5/6)
    (hb2 : β ≤ b2) (hβ0 : 0 < β) (hβ1 : β < 1) :
    8*(2-β)^4*β/(s*(8*(2-β)^4+4*(2-β)^2*s^2-s^4)) ≤ 20*b2/(21*s) := by
  have hspos : (0:ℝ) < s := by linarith
  have hA1 : (1:ℝ) ≤ 2-β := by linarith
  have hA0 : (0:ℝ) < 2-β := by linarith
  have hβp : (0:ℝ) < β := hβ0
  have hu1 : (1:ℝ) ≤ (2-β)^2 := by nlinarith [hA1]
  have hu4 : (2-β)^2 ≤ 4 := by nlinarith [hA1, hβ0, sq_nonneg (2-β)]
  have hs4 : s^4 ≤ (625:ℝ)/1296 := by
    have hs2 : s^2 ≤ 25/36 := by nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ 5/6-s) (by linarith : (0:ℝ) ≤ 5/6+s)]
    nlinarith [hs2, sq_nonneg s]
  have hkey : (0:ℝ) ≤ 4*(2-β)^2*s^2 - s^4 - (2/5)*(2-β)^4 := by
    have h1 : (0:ℝ) ≤ (2-β)^2 * (4*s^2 - 9/4) := mul_nonneg (by linarith [hu1]) (by nlinarith [hs0])
    have h2a : (13:ℝ)/20 ≤ 9/4 - (2/5)*((2-β)^2) := by linarith [hu4]
    have h2b : (0:ℝ) ≤ ((2-β)^2) * (9/4 - (2/5)*((2-β)^2)) := mul_nonneg (by linarith [hu1]) (le_trans (by norm_num : (0:ℝ) ≤ 13/20) h2a)
    have h2 : (0:ℝ) ≤ 9/4*((2-β)^2) - (2/5)*((2-β)^2)^2 - 625/1296 := by nlinarith [h2b]
    have h3 : (0:ℝ) ≤ 625/1296 - s^4 := by linarith [hs4]
    nlinarith [h1, h2, h3]
  have hK : (21:ℝ)/20 ≤ 1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4) := by
    have hA4 : (0:ℝ) < 8*(2-β)^4 := by positivity
    have hkey' : (0:ℝ) ≤ (4*(2-β)^2*s^2 - s^4 - (2/5)*(2-β)^4)/(8*(2-β)^4) :=
      div_nonneg hkey hA4.le
    have hid : (4*(2-β)^2*s^2 - s^4 - (2/5)*(2-β)^4)/(8*(2-β)^4)
        = (1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4)) - 21/20 := by
      rw [div_eq_iff hA4.ne']
      have hAne : (2-β) ≠ 0 := ne_of_gt hA0
      field_simp [hAne]
      ring
    linarith [hkey', hid]
  have hKpos : (0:ℝ) < 1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4) := by linarith
  have hNsleq : 8*(2-β)^4+4*(2-β)^2*s^2-s^4
      = 8*(2-β)^4*(1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4)) := by
    have hAne : (2-β) ≠ 0 := ne_of_gt hA0
    field_simp
    ring
  have hsimp : 8*(2-β)^4*β/(s*(8*(2-β)^4*(1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4))))
      = β/(s*(1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4))) := by
    rw [show s*(8*(2-β)^4*(1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4)))
        = 8*(2-β)^4*(s*(1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4))) by ring]
    rw [mul_div_mul_left _ _ (by positivity : (8:ℝ)*(2-β)^4 ≠ 0)]
  rw [hNsleq, hsimp]
  have hsK : (0:ℝ) < s*((21:ℝ)/20) := by positivity
  have hstep1 : β/(s*(1 + s^2/(2*(2-β)^2) - s^4/(8*(2-β)^4))) ≤ β/(s*((21:ℝ)/20)) :=
    div_le_div_of_nonneg_left (le_of_lt hβp) hsK (by nlinarith [hK, hspos])
  have hstep2 : β/(s*((21:ℝ)/20)) ≤ b2/(s*((21:ℝ)/20)) :=
    div_le_div_of_nonneg_right hb2 (le_of_lt hsK)
  have hfin : b2/(s*((21:ℝ)/20)) = 20*b2/(21*s) := by field_simp
  linarith
lemma tq_N1_le {β s : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1) (hs0 : 3/4 ≤ s) (hs1 : s ≤ 5/6) :
    Real.log ((4*(2-β)^2+s^2)/(2*(2-β)*s)) * (1 - s^2/(4*(2-β)^2))
    ≤ (1 - s^2/(4*(2-β)^2))
        * ((0.693148 + 1 - β + (0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2)) + s^2/(4*(2-β)^2)) := by
  have hspos : (0:ℝ) < s := by linarith
  have ha : (0:ℝ) < 2-β := by linarith
  have hb1 : (1:ℝ) < 2-β := by linarith
  have hu1 : (0:ℝ) ≤ s^2/(4*(2-β)^2) := by positivity
  have hu1le : s^2/(4*(2-β)^2) ≤ 1 := by
    rw [div_le_one (by positivity)]
    nlinarith [hs0, hs1, hb1, sq_nonneg s, sq_nonneg (2-β)]
  have hsplit : (4*(2-β)^2+s^2)/(2*(2-β)*s) = (2*(2-β)/s) * (1 + s^2/(4*(2-β)^2)) := by
    field_simp; ring
  have hlogeq : Real.log ((4*(2-β)^2+s^2)/(2*(2-β)*s))
      = Real.log (2*(2-β)) - Real.log s + Real.log (1 + s^2/(4*(2-β)^2)) := by
    rw [hsplit, Real.log_mul (by positivity) (by positivity),
        Real.log_div (by positivity) (by positivity)]
  have hlog2a : Real.log (2*(2-β)) ≤ 0.693148 + 1 - β := by
    have h : 2*(2-β) = 2*(1+(1-β)) := by ring
    rw [h, Real.log_mul (by norm_num) (by linarith)]
    linarith [tq_log_two_le, tq_log_one_add_le (1-β) (by linarith)]
  have hnegs : -Real.log s ≤ 0.28769 - (4/3)*(s-3/4) + (8/9)*(s-3/4)^2 := tq_neg_log_le hs0
  have hlog1 : Real.log (1 + s^2/(4*(2-β)^2)) ≤ s^2/(4*(2-β)^2) :=
