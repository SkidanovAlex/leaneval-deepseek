             else (2-β)^2/(s*Real.sqrt ((2-β)^2+s^2)))
           + (if s ≤ β then Real.log ((4*β^2+s^2)/(2*β*s))*(1-s^2/(2*((2-β)^2+β^2)))
             else (2-β)*β/(s*Real.sqrt ((2-β)^2+s^2))) )
        + ((2-β)^2-β^2)/(2*((2-β)^2+s^2))
        + ((2-β)^2-β^2)^2/(8*((2-β)^2+s^2)^2)
        + ((2-β)^2-β^2)^3/(16*((2-β)^2+s^2)^3) := by
  rcases le_or_gt (1/4) s with hs4 | hs4
  · -- ### `s ≥ 1/4`: use the previously proven result
    have h := boxMaj_le_target_kernel hβ0 hβ1 s hs4
    linarith
  · -- ### `1/6 ≤ s < 1/4`
