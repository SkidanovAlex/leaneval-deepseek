/-!
# The box majorant is dominated by the target kernel for `s ≥ 1/6`

This extends `Commons.Analysis.Integral.boxMaj_le_target_kernel` (valid for `s ≥ 1/4`)
to the range `s ≥ 1/6`.  The proof for `1/6 ≤ s < 1/4` uses a chord bound for
`-log s` on `[1/6,1/4]` and two polynomial certificates.
-/

/-- Chord-type bound `-log s ≤ ℓ(s)` on `[1/6,1/4]`, where
`ℓ(s) = (3-12s)*(179176/100000) + (12s-2)*(13863/10000)`. -/
lemma boxMaj_neg_log_le_chord_sixth {s : ℝ} (h1 : 1/6 ≤ s) (h2 : s ≤ 1/4) :
    -Real.log s ≤ (3-12*s)*(179176/100000) + (12*s-2)*(13863/10000) := by
  have hθ0 : (0:ℝ) ≤ 12*s - 2 := by linarith
  have hθ1 : 12*s - 2 ≤ 1 := by linarith
  have hw := boxMaj_log_weighted_ge (a := (1/4:ℝ)) (b := (1/6:ℝ)) (θ := 12*s-2)
      (by norm_num) (by norm_num) hθ0 hθ1
  have harg : (12*s-2)*(1/4) + (1-(12*s-2))*(1/6) = s := by ring
  rw [harg] at hw
  have hl4 : Real.log (1/4:ℝ) = -Real.log 4 := by
    rw [Real.log_div (by norm_num) (by norm_num : (4:ℝ) ≠ 0), Real.log_one, zero_sub]
  have hl6 : Real.log (1/6:ℝ) = -Real.log 6 := by
    rw [Real.log_div (by norm_num) (by norm_num : (6:ℝ) ≠ 0), Real.log_one, zero_sub]
  rw [hl4, hl6] at hw
  have h6 : Real.log 6 ≤ 179176/100000 := by
    have hm : Real.log 6 = Real.log 2 + Real.log 3 := by
      rw [show (6:ℝ) = 2*3 by norm_num, Real.log_mul (by norm_num) (by norm_num)]
    rw [hm]
    linarith [Real.log_two_lt_d9, Real.log_three_lt_d9]
  have h4 : Real.log 4 ≤ 13863/10000 := boxMaj_log_four_le
  have hcoef1 : (0:ℝ) ≤ 3 - 12*s := by linarith
  have hcoef2 : (0:ℝ) ≤ 12*s - 2 := hθ0
  have e1 : (1:ℝ) - (12*s-2) = 3 - 12*s := by ring
  rw [e1] at hw
  nlinarith [hw, h6, h4, hcoef1, hcoef2]

/-- `log((4b²+s²)/(2bs)) ≤ log(2b) + ℓ(s) + s²/(4b²)` for `b > 0`, `1/6 ≤ s ≤ 1/4`. -/
lemma boxMaj_log_arg_le {b s : ℝ} (hb : 0 < b) (hs0 : 1/6 ≤ s) (hs1 : s ≤ 1/4) :
    Real.log ((4*b^2+s^2)/(2*b*s))
      ≤ Real.log (2*b) + ((3-12*s)*(179176/100000) + (12*s-2)*(13863/10000)) + s^2/(4*b^2) := by
  have hspos : 0 < s := by linarith
  rw [show (4*b^2+s^2)/(2*b*s) = (2*b/s)*(1+s^2/(4*b^2)) by field_simp; ring]
  rw [Real.log_mul (by positivity) (by positivity), Real.log_div (by positivity) (by positivity)]
  have h1 : Real.log (1+s^2/(4*b^2)) ≤ s^2/(4*b^2) := by
    have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1+s^2/(4*b^2) by positivity)
    linarith
  have h2 := boxMaj_neg_log_le_chord_sixth hs0 hs1
  linarith

/-- `log(2(1+u)) + log(2(1-u)) ≤ 13863/10000 - u²` for `0 ≤ u < 1`. -/
lemma boxMaj_log_sum_le {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    Real.log (2*(1+u)) + Real.log (2*(1-u)) ≤ 13863/10000 - u^2 := by
  rw [← Real.log_mul (by positivity) (by positivity)]
  rw [show 2*(1+u)*(2*(1-u)) = 4*(1-u^2) by ring]
  rw [Real.log_mul (by norm_num) (by nlinarith : (1:ℝ) - u^2 ≠ 0)]
  have h1 : Real.log (1-u^2) ≤ -u^2 := by
    have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1-u^2 by nlinarith)
    linarith
  linarith [boxMaj_log_four_le, h1]

/-- `log(2(1+u)) ≤ 13863/10000 - (1-u)/2` for `0 ≤ u < 1`. -/
lemma boxMaj_log_two_mul_le {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u < 1) :
    Real.log (2*(1+u)) ≤ 13863/10000 - (1-u)/2 := by
  have he : (2:ℝ)*(1+u) = 4*(1 - (1-u)/2) := by ring
  rw [he, Real.log_mul (by norm_num) (by nlinarith : (1:ℝ) - (1-u)/2 ≠ 0)]
  have h1 : Real.log (1 - (1-u)/2) ≤ -(1-u)/2 := by
    have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1 - (1-u)/2 by linarith)
    linarith
  linarith [boxMaj_log_four_le, h1]

/-- `log(2(1-u)) ≥ -1.0986122888` whenever `1/6 ≤ 1-u`. -/
lemma boxMaj_log_two_one_sub_ge {u : ℝ} (hu : 1/6 ≤ 1-u) :
    -1.0986122888 ≤ Real.log (2*(1-u)) := by
  have h13 : ((3:ℝ))⁻¹ ≤ 2*(1-u) := by
    have : ((3:ℝ))⁻¹ = 1/3 := by norm_num
    rw [this]; linarith
  have hlog : Real.log ((3:ℝ)⁻¹) ≤ Real.log (2*(1-u)) := Real.log_le_log (by norm_num) h13
  have h3 : Real.log ((3:ℝ)⁻¹) = -Real.log 3 := by
    rw [show ((3:ℝ))⁻¹ = 1/3 by norm_num,
        Real.log_div (by norm_num) (by norm_num : (3:ℝ) ≠ 0), Real.log_one, zero_sub]
  rw [h3] at hlog
  linarith [Real.log_three_lt_d9, hlog]

