/-- **Main inequality, threshold `1/6`.** -/
theorem boxMaj_le_target_kernel_ge_sixth {β s : ℝ} (hβ0 : 0 < β) (hβ1 : β < 1) (hs : 1/6 ≤ s) :
    0 ≤ (13/5)*((3/2-β)/((3/2-β)^2+s^2)+(1+β)/((1+β)^2+s^2))
