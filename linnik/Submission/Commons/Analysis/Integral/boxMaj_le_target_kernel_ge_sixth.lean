      have hT1 : Real.log ((4*(1+u)^2+s^2)/(2*(1+u)*s)) * (1 - s^2/(4*(1+u)^2))
          ≤ Real.log (2*(1+u)) + ((3-12*s)*(179176/100000) + (12*s-2)*(13863/10000)) + s^2/(4*(1+u)^2) := by
        calc Real.log ((4*(1+u)^2+s^2)/(2*(1+u)*s)) * (1 - s^2/(4*(1+u)^2))
