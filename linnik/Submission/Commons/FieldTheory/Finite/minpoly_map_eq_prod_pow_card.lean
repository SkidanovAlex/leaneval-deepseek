import Mathlib.Algebra.Order.Ring.Star
import Mathlib.Data.Int.ConditionallyCompleteOrder
import Mathlib.Data.Int.Star
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal

namespace Commons.FieldTheory.Finite

open Polynomial

theorem minpoly_map_eq_prod_pow_card {F E : Type*} [Field F] [Field E] [Fintype F]
    [Fintype E] [DecidableEq F] [DecidableEq E] [Algebra F E] (a : E) :
    (minpoly F a).map (algebraMap F E) =
      ∏ i : Fin (minpoly F a).natDegree,
        (Polynomial.X - Polynomial.C (a ^ (Fintype.card F ^ (i : ℕ)))) := by
  classical
  set q : ℕ := Fintype.card F with hq
  set p : F[X] := minpoly F a with hp
  set d : ℕ := p.natDegree with hd
  have hInt : IsIntegral F a := Algebra.IsIntegral.isIntegral a
  have hpmon : p.Monic := minpoly.monic hInt
  have hpne : p ≠ 0 := minpoly.ne_zero hInt
  have hpadj : Module.finrank F ↥(IntermediateField.adjoin F {a}) = d := by
    rw [hd, hp]
    exact IntermediateField.adjoin.finrank hInt
  have hcardF : Nat.card F = q := by rw [Nat.card_eq_fintype_card, hq]
  -- Frobenius automorphism
  set σ : Gal(E/F) := FiniteField.frobeniusAlgEquivOfAlgebraic F E with hσ
  have hσ_iter : ∀ (k : ℕ) (x : E), (σ ^ k) x = x ^ (q ^ k) := by
    intro k x
    rw [AlgEquiv.coe_pow, hσ, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
  -- Every `a ^ (q ^ i)` is a root of `p.map (algebraMap F E)`.
  have hroot : ∀ i : Fin d, (p.map (algebraMap F E)).IsRoot (a ^ (q ^ (i : ℕ))) := by
    intro i
    have hσi : (σ ^ (i : ℕ)) a = a ^ (q ^ (i : ℕ)) := hσ_iter (i : ℕ) a
    have hmin : minpoly F (a ^ (q ^ (i : ℕ))) = p := by
      rw [← hσi, minpoly.algEquiv_eq, hp]
    have haeval : (aeval (a ^ (q ^ (i : ℕ)))) p = 0 := by
      have := minpoly.aeval F (a ^ (q ^ (i : ℕ)))
      rwa [hmin] at this
    rw [IsRoot.def, Polynomial.eval_map, ← Polynomial.aeval_def]
    exact haeval
  -- Distinctness of the Frobenius orbit.
  have hkey : ∀ i j : ℕ, i < j → j < d → a ^ (q ^ i) ≠ a ^ (q ^ j) := by
    intro i j hij hjd heq
    have hji : i + (j - i) = j := Nat.add_sub_of_le hij.le
    have hkpos : 0 < j - i := Nat.sub_pos_of_lt hij
    have hklt : j - i < d := lt_of_le_of_lt (Nat.sub_le j i) hjd
    have hfixa : (σ ^ (j - i)) a = a := by
      have h1 : (σ ^ i) a = (σ ^ j) a := by
        rw [hσ_iter i a, hσ_iter j a]
        exact heq
      have h2 : (σ ^ j) a = (σ ^ i) ((σ ^ (j - i)) a) := by
        conv_lhs => rw [← hji]
        rw [pow_add, AlgEquiv.mul_apply]
      rw [h2] at h1
      have h3 : a = (σ ^ (j - i)) a := (σ ^ i).injective h1
      rw [hσ_iter (j - i) a] at h3
      rw [hσ_iter (j - i) a]
      exact h3.symm
    -- `a` is fixed by the subgroup generated by `σ ^ (j-i)`.
    have hstab : (σ ^ (j - i)) ∈ MulAction.stabilizer Gal(E/F) a := by
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
      exact hfixa
    have hle : Subgroup.zpowers (σ ^ (j - i)) ≤ MulAction.stabilizer Gal(E/F) a :=
      Subgroup.zpowers_le.mpr hstab
    have hafixStab : a ∈ IntermediateField.fixedField (MulAction.stabilizer Gal(E/F) a) := by
      rw [IntermediateField.mem_fixedField_iff]
      intro f hf
      simpa [AlgEquiv.smul_def] using (MulAction.mem_stabilizer_iff.mp hf)
    have hafix : a ∈ IntermediateField.fixedField (Subgroup.zpowers (σ ^ (j - i))) :=
      IntermediateField.fixedField_le hle hafixStab
    have hleadj : IntermediateField.adjoin F {a}
        ≤ IntermediateField.fixedField (Subgroup.zpowers (σ ^ (j - i))) :=
      IntermediateField.adjoin_simple_le_iff.mpr hafix
    -- Hence `F⟮a⟯` is contained in the roots of `X ^ (q ^ (j-i)) - X`.
    have hpne' : (X ^ (q ^ (j - i)) - X : F[X]) ≠ 0 :=
      FiniteField.X_pow_card_sub_X_ne_zero F (by
        have hq1 : 1 < q := by rw [hq]; exact Fintype.one_lt_card
        exact Nat.one_lt_pow (by omega) hq1)
    have hrootSub : (IntermediateField.adjoin F {a} : Set E)
        ⊆ (X ^ (q ^ (j - i)) - X : F[X]).rootSet E := by
      intro x hx
      have hxfix : x ∈ IntermediateField.fixedField (Subgroup.zpowers (σ ^ (j - i))) := hleadj hx
      rw [IntermediateField.mem_fixedField_iff] at hxfix
      have hxfix' : (σ ^ (j - i)) x = x := hxfix _ (Subgroup.mem_zpowers _)
      rw [Polynomial.mem_rootSet_of_ne hpne']
      simp only [map_sub, map_pow, aeval_X]
      rw [← hσ_iter (j - i) x, hxfix', sub_self]
    -- Counting.
    have hcount : Nat.card ↥(IntermediateField.adjoin F {a}) ≤ q ^ (j - i) := by
      have h1 : Nat.card ↥(IntermediateField.adjoin F {a})
          ≤ ((X ^ (q ^ (j - i)) - X : F[X]).rootSet E).ncard := by
        have h := Set.ncard_le_ncard hrootSub
        rwa [show Nat.card ↥(IntermediateField.adjoin F {a})
          = ((IntermediateField.adjoin F {a} : Set E)).ncard from Nat.card_coe_set_eq _]
      have h2 : ((X ^ (q ^ (j - i)) - X : F[X]).rootSet E).ncard
          ≤ (X ^ (q ^ (j - i)) - X : F[X]).natDegree := Polynomial.ncard_rootSet_le _ _
      have h3 : (X ^ (q ^ (j - i)) - X : F[X]).natDegree ≤ q ^ (j - i) := by
        refine (Polynomial.natDegree_sub_le _ _).trans ?_
        rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X]
        refine max_le le_rfl ?_
        have : 1 < q := by rw [hq]; exact Fintype.one_lt_card
        exact Nat.one_le_pow _ _ (by omega)
      linarith
    have hcard : Nat.card ↥(IntermediateField.adjoin F {a}) = q ^ d := by
      have h := Module.natCard_eq_pow_finrank (K := F) (V := ↥(IntermediateField.adjoin F {a}))
      rw [h, hcardF, hpadj]
    have hq1 : 1 < q := by rw [hq]; exact Fintype.one_lt_card
    have hdk : d ≤ j - i := by
      have : q ^ d ≤ q ^ (j - i) := hcard ▸ hcount
      exact (Nat.pow_le_pow_iff_right hq1).mp this
    omega
  have hinj : Function.Injective (fun i : Fin d => a ^ (q ^ (i : ℕ))) := by
    intro i j hij
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · exact (hkey i j hlt j.isLt) hij
    · exact (hkey j i hgt i.isLt) hij.symm
  -- The product divides the mapped minimal polynomial.
  have hfac : ∀ i : Fin d, (X - C (a ^ (q ^ (i : ℕ)))) ∣ p.map (algebraMap F E) :=
    fun i => Polynomial.dvd_iff_isRoot.mpr (hroot i)
  have hcop : Pairwise (Function.onFun IsCoprime fun i : Fin d => X - C (a ^ (q ^ (i : ℕ)))) :=
    Polynomial.pairwise_coprime_X_sub_C hinj
  have hg_dvd : (∏ i : Fin d, (X - C (a ^ (q ^ (i : ℕ))))) ∣ p.map (algebraMap F E) :=
    Fintype.prod_dvd_of_coprime hcop hfac
  have hg_monic : (∏ i : Fin d, (X - C (a ^ (q ^ (i : ℕ))))).Monic := by
    simpa using Polynomial.monic_prod_X_sub_C (fun i : Fin d => a ^ (q ^ (i : ℕ))) Finset.univ
  have hf_monic : (p.map (algebraMap F E)).Monic := hpmon.map (algebraMap F E)
  have hf_deg : (p.map (algebraMap F E)).natDegree = d := by
    rw [Polynomial.natDegree_map_eq_of_injective (algebraMap F E).injective]
  have hg_deg : (∏ i : Fin d, (X - C (a ^ (q ^ (i : ℕ))))).natDegree = d := by
    have h := Polynomial.natDegree_finsetProd_X_sub_C_eq_card Finset.univ
      (fun i : Fin d => a ^ (q ^ (i : ℕ)))
    simpa using h
  have hfinal := Polynomial.eq_leadingCoeff_mul_of_monic_of_dvd_of_natDegree_le
    hg_monic hg_dvd (by rw [hf_deg, hg_deg])
  rw [hf_monic.leadingCoeff, C_1, one_mul] at hfinal
  exact hfinal

end Commons.FieldTheory.Finite