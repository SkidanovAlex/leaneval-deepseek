/-!
## The kernel `1 + p^(e-1)` of `(ZMod (p^e))ˣ`

We collect elementary facts about the cyclic subgroup generated by `1 + p^(e-1)` in
`ZMod (p^e)`: its elements are `1 + p^(e-1) * k`, a multiplicative character takes there
the value `χ (1 + p^(e-1)) ^ k`, and the sum over `w ∈ range p` of these values is `p`
exactly when `p ∣ k` (orthogonality on the kernel).
-/

/-- The element `1 + p^(e-1)*k` of `ZMod (p^e)` depends only on `k` modulo `p`. -/
private lemma kernel_term_cast_eq_of_dvd_sub (p e : ℕ) (he : 2 ≤ e) (k b : ℤ) (w : ℕ)
    (hb : (p : ℤ) ∣ k - b) :
    (((1 + (p : ℤ) ^ (e - 1) * ((w : ℤ) * k) : ℤ)) : ZMod (p ^ e))
      = (((1 + (p : ℤ) ^ (e - 1) * ((w : ℤ) * b) : ℤ)) : ZMod (p ^ e)) := by
  rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
  obtain ⟨c, hc⟩ := hb
  refine ⟨-(w * c), ?_⟩
  have hbk : b - k = -((p : ℤ) * c) := by rw [← hc]; ring
  calc (1 + (p : ℤ) ^ (e - 1) * ((w : ℤ) * b)) - (1 + (p : ℤ) ^ (e - 1) * ((w : ℤ) * k))
      = (p : ℤ) ^ (e - 1) * ((w : ℤ) * (b - k)) := by ring
    _ = (p : ℤ) ^ (e - 1) * ((w : ℤ) * (-((p : ℤ) * c))) := by rw [hbk]
    _ = (p ^ e : ℕ) * -((w : ℤ) * c) := by
        rw [show e = (e - 1) + 1 by omega, pow_succ]
        push_cast
        ring

/-- Orthogonality of the character sums over the kernel `1 + p^(e-1)`: if `χ` is
non-trivial on that kernel then `∑_{w < p} χ (1 + p^(e-1) * w * k)` equals `p` when
`p ∣ k` and `0` otherwise. -/
theorem primePowKernel_sum_orthogonality (p e : ℕ) [Fact p.Prime] (he : 2 ≤ e)
    (χ : DirichletCharacter ℂ (p ^ e))
    (htop : χ ((((1 + p ^ (e - 1) : ℕ)) : ZMod (p ^ e))) ≠ 1) (k : ℤ) :
    ∑ w ∈ Finset.range p, χ (((1 + (p : ℤ) ^ (e - 1) * ((w : ℤ) * k) : ℤ)) : ZMod (p ^ e))
      = if (p : ℤ) ∣ k then (p : ℂ) else 0 := by
  set ζ : ℂ := χ ((((1 + p ^ (e - 1) : ℕ)) : ZMod (p ^ e))) with hζdef
  have hζne : ζ ≠ 1 := by rw [hζdef]; exact htop
  have hζp : ζ ^ p = 1 := by
    rw [hζdef, ← primePowKernel_char_pow p e he χ p]
    have hcast : (((1 + (p : ℤ) ^ (e - 1) * ((p : ℕ) : ℤ) : ℤ)) : ZMod (p ^ e)) = 1 := by
      have h1 : (1 + (p : ℤ) ^ (e - 1) * ((p : ℕ) : ℤ)) = (1 : ℤ) + (p : ℤ) ^ e := by
        rw [show e = (e - 1) + 1 by omega, pow_succ]
        push_cast
        ring
      rw [h1, Int.cast_add, Int.cast_one]
      have hpz : (((p : ℤ) ^ e : ℤ) : ZMod (p ^ e)) = 0 := by
        rw [show (((p : ℤ) ^ e : ℤ)) = (↑(p ^ e) : ℤ) by push_cast; ring]
        rw [Int.cast_natCast, ZMod.natCast_self]
      rw [hpz, add_zero]
    rw [hcast, map_one]
  -- reduce `k` modulo `p`
  set b : ℕ := (k : ZMod p).val with hbdef
  have hbcast : ((b : ℤ) : ZMod p) = (k : ZMod p) := by
    rw [hbdef, Int.cast_natCast]
    exact ZMod.natCast_zmod_val (k : ZMod p)
  have hbdvd : (p : ℤ) ∣ k - b := by
    have h := (ZMod.intCast_eq_intCast_iff_dvd_sub k (b : ℤ) p).mp hbcast.symm
    rw [show k - (b : ℤ) = -((b : ℤ) - k) by ring]
    exact dvd_neg.mpr h
  have hterm : ∀ w : ℕ,
      χ (((1 + (p : ℤ) ^ (e - 1) * ((w : ℤ) * k) : ℤ)) : ZMod (p ^ e)) = (ζ ^ b) ^ w := by
    intro w
    rw [kernel_term_cast_eq_of_dvd_sub p e he k (b : ℤ) w hbdvd]
    rw [show (p : ℤ) ^ (e - 1) * ((w : ℤ) * (b : ℤ)) = (p : ℤ) ^ (e - 1) * ((w * b : ℕ) : ℤ) by
      push_cast; ring]
    rw [hζdef, primePowKernel_char_pow p e he χ (w * b), Nat.mul_comm w b, ← pow_mul]
  rw [Finset.sum_congr rfl (fun w _ => hterm w)]
  by_cases hpk : (p : ℤ) ∣ k
  · have hb0 : b = 0 := by
      have hk0 : (k : ZMod p) = 0 := (ZMod.intCast_zmod_eq_zero_iff_dvd k p).mpr hpk
      rw [hbdef, ZMod.val_eq_zero]
      exact hk0
    rw [hb0, pow_zero, if_pos hpk]
    simp [Finset.sum_const, Finset.card_range]
  · rw [if_neg hpk]
    have hbpos : 0 < b := by
      rcases Nat.eq_zero_or_pos b with h | h
      · exact absurd (hpk ((ZMod.intCast_zmod_eq_zero_iff_dvd k p).mp
          (by rw [← hbcast, h]; simp))) (by simp)
      · exact h
    have hblt : b < p := ZMod.val_lt _
    have hbne1 : ζ ^ b ≠ 1 := by
      intro h
      have h1 : orderOf ζ ∣ b := orderOf_dvd_iff_pow_eq_one.mpr h
      have h2 : orderOf ζ ∣ p := orderOf_dvd_iff_pow_eq_one.mpr hζp
      have h3 : orderOf ζ ∣ Nat.gcd b p := Nat.dvd_gcd h1 h2
      have hgcd : Nat.gcd b p = 1 := by
        rw [← Nat.coprime_iff_gcd_eq_one, Nat.coprime_comm]
        exact (Fact.out : Nat.Prime p).coprime_iff_not_dvd.mpr
          (Nat.not_dvd_of_pos_of_lt hbpos hblt)
      rw [hgcd] at h3
      exact hζne (orderOf_eq_one_iff.mp (Nat.dvd_one.mp h3))
    have hgeom := geom_sum_mul_neg (ζ ^ b) p
    have hrhs : 1 - (ζ ^ b) ^ p = 0 := by
      rw [← pow_mul, Nat.mul_comm b p, pow_mul, hζp, one_pow, sub_self]
    have hzero : (∑ w ∈ Finset.range p, (ζ ^ b) ^ w) * (1 - ζ ^ b) = 0 := by
      rw [hgeom, hrhs]
    rcases mul_eq_zero.mp hzero with h | h
    · exact h
    · exact absurd (sub_eq_zero.mp h).symm hbne1

/-!
## Polynomials of degree at most two

Explicit descriptions of `Q` and of its derivative for `Q.natDegree ≤ 2`, and the
existence and uniqueness of the critical point of `Q'` modulo `p`.
-/

/-- A polynomial over `ℤ` of degree at most two is `C a + C b * X + C c * X^2`. -/
private lemma eq_C_add_C_mul_X_add_C_mul_X_sq (Q : Polynomial ℤ) (h : Q.natDegree ≤ 2) :
    Q = Polynomial.C (Q.coeff 0) + Polynomial.C (Q.coeff 1) * Polynomial.X
        + Polynomial.C (Q.coeff 2) * Polynomial.X ^ 2 := by
  conv_lhs => rw [Q.as_sum_range_C_mul_X_pow]
  have hsum : (∑ i ∈ Finset.range (Q.natDegree + 1),
        Polynomial.C (Q.coeff i) * Polynomial.X ^ i)
      = ∑ i ∈ Finset.range 3, Polynomial.C (Q.coeff i) * Polynomial.X ^ i := by
    refine Finset.sum_subset (fun i hi => ?_) (fun i hi3 hni => ?_)
    · simp only [Finset.mem_range] at hi ⊢; omega
    · simp only [Finset.mem_range] at hi3 hni
      have : Q.coeff i = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      simp [this]
  rw [hsum, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one]
  ring

/-- Evaluation of a polynomial of degree at most two. -/
private lemma eval_eq_coeff (Q : Polynomial ℤ) (h : Q.natDegree ≤ 2) (x : ℤ) :
    Q.eval x = Q.coeff 0 + Q.coeff 1 * x + Q.coeff 2 * x ^ 2 := by
  conv_lhs => rw [eq_C_add_C_mul_X_add_C_mul_X_sq Q h]
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
    Polynomial.eval_pow]

/-- Evaluation of the derivative of a polynomial of degree at most two. -/
private lemma derivative_eval_eq_coeff (Q : Polynomial ℤ) (h : Q.natDegree ≤ 2) (x : ℤ) :
    (Polynomial.derivative Q).eval x = Q.coeff 1 + 2 * Q.coeff 2 * x := by
  conv_lhs => rw [eq_C_add_C_mul_X_add_C_mul_X_sq Q h]
  simp only [Polynomial.derivative_add, Polynomial.derivative_mul, Polynomial.derivative_C,
    Polynomial.derivative_X, Polynomial.derivative_pow, Polynomial.eval_add, Polynomial.eval_mul,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_pow, Polynomial.eval_zero,
    Polynomial.eval_one]
  ring_nf

/-- The critical point of the derivative of a quadratic polynomial, modulo `p`. -/
private noncomputable def critPt (p : ℕ) (Q : Polynomial ℤ) : ℕ :=
  ((-(Q.coeff 1)) * ((2 * Q.coeff 2 : ℤ) : ZMod p)⁻¹).val

private lemma critPt_cast (p : ℕ) [NeZero p] (Q : Polynomial ℤ) :
    ((critPt p Q : ℤ) : ZMod p) = (-(Q.coeff 1)) * ((2 * Q.coeff 2 : ℤ) : ZMod p)⁻¹ := by
  rw [critPt, Int.cast_natCast]
  exact ZMod.natCast_zmod_val _

/-- The derivative `Q'` of a quadratic polynomial with `p ∤ Q.coeff 2` vanishes modulo `p`
at exactly one residue class `a₀ ∈ range p`. -/
private lemma exists_critPt (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (Q : Polynomial ℤ)
    (hdeg : Q.natDegree ≤ 2) (hQ : ¬ (p : ℤ) ∣ Q.coeff 2) :
    critPt p Q < p ∧ ∀ a : ℕ, a < p →
      ((p : ℤ) ∣ (Polynomial.derivative Q).eval (a : ℤ) ↔ a = critPt p Q) := by
  have h2 : (2 : ZMod p) ≠ 0 := by
    intro h
    have hdvd : p ∣ 2 := (CharP.cast_eq_zero_iff (ZMod p) p 2).mp h
    rcases (Nat.dvd_prime (show Nat.Prime 2 by norm_num)).mp hdvd with h1 | h2
    · exact (Fact.out : Nat.Prime p).ne_one h1
    · exact hp2 h2
  have hc2 : ((Q.coeff 2 : ℤ) : ZMod p) ≠ 0 := by
    intro h
    exact hQ ((ZMod.intCast_zmod_eq_zero_iff_dvd (Q.coeff 2) p).mp h)
  have hunit : (2 : ZMod p) * ((Q.coeff 2 : ℤ) : ZMod p) ≠ 0 := mul_ne_zero h2 hc2
  have hunit' : ((2 : ZMod p) * (Q.coeff 2 : ZMod p)) ≠ 0 := by
    rwa [show ((2 : ZMod p) * (Q.coeff 2 : ZMod p)) = (2 : ZMod p) * ((Q.coeff 2 : ℤ) : ZMod p)
      from rfl]
  refine ⟨ZMod.val_lt _, fun a ha => ?_⟩
  have hkey : ∀ a : ℕ, (((Q.coeff 1 + 2 * Q.coeff 2 * (a : ℤ) : ℤ)) : ZMod p)
      = (Q.coeff 1 : ZMod p) + (2 : ZMod p) * (Q.coeff 2 : ZMod p) * (a : ZMod p) := by
    intro a; push_cast; ring
  rw [derivative_eval_eq_coeff Q hdeg (a : ℤ), ← ZMod.intCast_zmod_eq_zero_iff_dvd, hkey a]
  constructor
  · intro hzero
    have h1 : ((2 : ZMod p) * (Q.coeff 2 : ZMod p)) * (a : ZMod p) = -(Q.coeff 1 : ZMod p) := by
      linear_combination hzero
    have h2' : (a : ZMod p) = (critPt p Q : ZMod p) := by
      calc (a : ZMod p)
          = ((2 : ZMod p) * (Q.coeff 2 : ZMod p))⁻¹
              * (((2 : ZMod p) * (Q.coeff 2 : ZMod p)) * (a : ZMod p)) := by
            rw [← mul_assoc, inv_mul_cancel₀ hunit', one_mul]
        _ = ((2 : ZMod p) * (Q.coeff 2 : ZMod p))⁻¹ * (-(Q.coeff 1 : ZMod p)) := by rw [h1]
        _ = (critPt p Q : ZMod p) := by
            rw [← Int.cast_natCast, critPt_cast]
            push_cast
            ring
    have hlt : critPt p Q < p := ZMod.val_lt _
    rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hlt] at h2'
    exact h2'
  · intro hae
    rw [hae, ← Int.cast_natCast, critPt_cast]
    have hcast' : ((-(Q.coeff 1)) * ((2 * Q.coeff 2 : ℤ) : ZMod p)⁻¹)
        = (-(Q.coeff 1 : ZMod p)) * ((2 : ZMod p) * (Q.coeff 2 : ZMod p))⁻¹ := by
      rw [show ((2 * Q.coeff 2 : ℤ) : ZMod p) = (2 : ZMod p) * (Q.coeff 2 : ZMod p) by
        push_cast; ring]
    rw [hcast']
    field_simp
    ring

/-!
## The two structural steps of the lifting recursion

`pow_dvd_stationary_step` is the congruence that lets us split the sum over `j mod p^N`
according to `j = j₀ + p^(N-1) * w`; `exists_quadratic_lift` provides the quadratic
polynomial describing the terms that survive (those with `p ∣ Q'(j₀)`).
-/

/-- Stationary-phase congruence: splitting `x ↦ x + p^(N-1) * w` changes the value
`A + p^m * P(x)` by the factor `1 + p^(e-1) * w * P'(x)` modulo `p^e`. -/
private lemma pow_dvd_stationary_step (p e m N : ℕ) (hmN : m + N = e) (hN : 2 ≤ N)
    (hm : 1 ≤ m) (A : ℤ) (hA : (p : ℤ) ∣ A - 1) (P : Polynomial ℤ) (hdeg : P.natDegree ≤ 2)
    (x w : ℤ) :
    (p : ℤ) ^ e ∣ A + (p : ℤ) ^ m * P.eval (x + (p : ℤ) ^ (N - 1) * w)
      - (A + (p : ℤ) ^ m * P.eval x)
          * (1 + (p : ℤ) ^ (e - 1) * (w * (Polynomial.derivative P).eval x)) := by
  set D : ℤ := (Polynomial.derivative P).eval x with hD
  set h : ℤ := (p : ℤ) ^ (N - 1) * w with hh
  have he1 : (p : ℤ) ^ (e - 1) * (p : ℤ) = (p : ℤ) ^ e := by
    rw [← pow_succ]; congr 1; omega
  have h1 : (p : ℤ) ^ e ∣ (p : ℤ) ^ (e - 1) * (w * D) * (A - 1) := by
    obtain ⟨c, hc⟩ := hA
    refine ⟨w * D * c, ?_⟩
    rw [hc, show (p : ℤ) ^ (e - 1) * (w * D) * ((p : ℤ) * c) = (p : ℤ) ^ e * (w * D * c) by
      rw [← he1]; ring]
  have h2 : (p : ℤ) ^ e ∣ (p : ℤ) ^ (e - 1) * (w * D) * ((p : ℤ) ^ m * P.eval x) := by
    refine ⟨w * D * (p : ℤ) ^ (m - 1) * P.eval x, ?_⟩
    calc (p : ℤ) ^ (e - 1) * (w * D) * ((p : ℤ) ^ m * P.eval x)
        = (p : ℤ) ^ (e - 1) * (p : ℤ) ^ m * (w * D * P.eval x) := by ring
      _ = (p : ℤ) ^ (e - 1 + m) * (w * D * P.eval x) := by rw [pow_add]
      _ = (p : ℤ) ^ (e + (m - 1)) * (w * D * P.eval x) := by
            rw [show e - 1 + m = e + (m - 1) by omega]
      _ = (p : ℤ) ^ e * ((p : ℤ) ^ (m - 1) * (w * D * P.eval x)) := by rw [pow_add]; ring
      _ = (p : ℤ) ^ e * (w * D * (p : ℤ) ^ (m - 1) * P.eval x) := by ring
  have h3 : (p : ℤ) ^ e ∣ (p : ℤ) ^ m * (h ^ 2 * P.coeff 2) := by
    have hh2 : (p : ℤ) ^ m * (h ^ 2 * P.coeff 2)
        = (p : ℤ) ^ (m + 2 * (N - 1)) * (w ^ 2 * P.coeff 2) := by
      rw [hh, mul_pow, ← pow_mul]
      ring_nf
    rw [hh2]
    exact dvd_mul_of_dvd_left (pow_dvd_pow (p : ℤ) (by omega)) _
  have hPeval : P.eval (x + h) = P.eval x + h * D + h ^ 2 * P.coeff 2 := by
    rw [eval_eq_coeff P hdeg (x + h), eval_eq_coeff P hdeg x, hD,
      derivative_eval_eq_coeff P hdeg x]
    ring
  have hpH : (p : ℤ) ^ m * h = (p : ℤ) ^ (e - 1) * w := by
    have hexp : m + (N - 1) = e - 1 := by omega
    rw [hh, ← mul_assoc, ← pow_add, hexp]
  have hgoal : A + (p : ℤ) ^ m * P.eval (x + (p : ℤ) ^ (N - 1) * w)
      - (A + (p : ℤ) ^ m * P.eval x)
          * (1 + (p : ℤ) ^ (e - 1) * (w * (Polynomial.derivative P).eval x))
      = -((p : ℤ) ^ (e - 1) * (w * D) * (A - 1))
        - (p : ℤ) ^ (e - 1) * (w * D) * ((p : ℤ) ^ m * P.eval x)
        + (p : ℤ) ^ m * (h ^ 2 * P.coeff 2) := by
    rw [← hh, ← hD, hPeval]
    ring_nf
    rw [hpH]
    ring
  rw [hgoal]
  exact dvd_add (dvd_sub (dvd_neg.mpr h1) h2) h3

/-- Lifting the quadratic polynomial: if `p ∣ Q'(a₀)` then the values `Q(a₀ + p u)` are
described by a quadratic polynomial `R` with the same leading coefficient. -/
private lemma exists_quadratic_lift (p : ℕ) (Q : Polynomial ℤ) (hdeg : Q.natDegree ≤ 2)
    (a₀ : ℕ) (hroot : (p : ℤ) ∣ (Polynomial.derivative Q).eval (a₀ : ℤ)) :
    ∃ R : Polynomial ℤ, R.natDegree ≤ 2 ∧ R.coeff 2 = Q.coeff 2 ∧
      ∀ u : ℕ, Q.eval ((a₀ + p * u : ℕ) : ℤ) = Q.eval (a₀ : ℤ) + (p : ℤ) ^ 2 * R.eval (u : ℤ) := by
  obtain ⟨c, hc⟩ := hroot
  refine ⟨Polynomial.C c * Polynomial.X + Polynomial.C (Q.coeff 2) * Polynomial.X ^ 2,
    ?_, ?_, ?_⟩
  · refine le_trans (Polynomial.natDegree_add_le _ _) (max_le ?_ ?_)
    · have hc1 : (Polynomial.C c * Polynomial.X ^ 1).natDegree ≤ 2 :=
        (Polynomial.natDegree_C_mul_X_pow_le c 1).trans (by norm_num)
      simpa using hc1
    · exact Polynomial.natDegree_C_mul_X_pow_le (Q.coeff 2) 2
  · simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul_X, Polynomial.coeff_C_mul_X_pow]
    norm_num
  · intro u
    have hderiv : Q.coeff 1 + 2 * Q.coeff 2 * (a₀ : ℤ) = (p : ℤ) * c := by
      rw [← derivative_eval_eq_coeff Q hdeg (a₀ : ℤ)]
      exact hc
    rw [eval_eq_coeff Q hdeg ((a₀ + p * u : ℕ) : ℤ), eval_eq_coeff Q hdeg (a₀ : ℤ)]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
      Polynomial.eval_pow]
    push_cast
    linear_combination ((p : ℤ) * (u : ℤ)) * hderiv

/-!
## The main induction

We prove the slightly more general statement

`‖∑_{j < p^N} χ (A + p^m * P(j))‖ ≤ p^((N+1)/2)`

for `m + N = e`, `1 ≤ m`, `A ≡ 1 (mod p)` and `P ∈ ℤ[X]` of degree at most two with
`p ∤ P.coeff 2`.  The induction step splits `j = a + p * (u + p^(N-2) * w)`, applies the
stationary-phase congruence `pow_dvd_stationary_step` and orthogonality on the kernel
`1 + p^(e-1)` to select the critical class `a = critPt p P`, and then reduces to the
statement with `(m, N)` replaced by `(m+2, N-2)` using `exists_quadratic_lift`.
-/

private lemma sum_bound_aux (p e : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (he : 2 ≤ e)
    (χ : DirichletCharacter ℂ (p ^ e))
    (htop : χ ((((1 + p ^ (e - 1) : ℕ)) : ZMod (p ^ e))) ≠ 1) :
    ∀ (N m : ℕ) (A : ℤ) (Q : Polynomial ℤ), m + N = e → 1 ≤ m → (p : ℤ) ∣ A - 1 →
      Q.natDegree ≤ 2 → ¬ (p : ℤ) ∣ Q.coeff 2 →
      ‖∑ j ∈ Finset.range (p ^ N),
          χ (((A + (p : ℤ) ^ m * Q.eval (j : ℤ) : ℤ)) : ZMod (p ^ e))‖
        ≤ (p : ℝ) ^ (((N : ℝ) + 1) / 2) := by
  intro N m A Q hmN hm hA hdeg hQ
  revert m A Q
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro m A Q hmN hm hA hdeg hQ
    have hp1 : (1 : ℝ) ≤ (p : ℝ) := by
      exact_mod_cast (Fact.out : p.Prime).one_le
    have hppos : (0 : ℝ) < (p : ℝ) := by
      exact_mod_cast (Fact.out : p.Prime).pos
    rcases Nat.lt_or_ge N 2 with hN | hN
    · -- base cases `N ≤ 1`
      have hbound : ‖∑ j ∈ Finset.range (p ^ N),
            χ (((A + (p : ℤ) ^ m * Q.eval (j : ℤ) : ℤ)) : ZMod (p ^ e))‖
          ≤ ((p ^ N : ℕ) : ℝ) := by
        refine (norm_sum_le _ _).trans ?_
        refine (Finset.sum_le_sum (fun j _ => DirichletCharacter.norm_le_one χ _)).trans ?_
        simp
      refine hbound.trans ?_
      interval_cases N
      · rw [pow_zero, Nat.cast_one,
          show (((0 : ℕ) : ℝ) + 1) / 2 = (1 : ℝ) / 2 by norm_num]
        exact Real.one_le_rpow hp1 (by norm_num)
      · rw [pow_one, show (((1 : ℕ) : ℝ) + 1) / 2 = 1 by norm_num, Real.rpow_one]
    · -- main step, `2 ≤ N`
      have hN2 : 2 ≤ N := hN
      have hcrit := exists_critPt p hp2 Q hdeg hQ
      set a₀ : ℕ := critPt p Q with ha₀def
      have ha₀lt : a₀ < p := by rw [ha₀def]; exact hcrit.1
      have ha₀crit : ∀ a : ℕ, a < p →
          ((p : ℤ) ∣ (Polynomial.derivative Q).eval (a : ℤ) ↔ a = a₀) := by
        intro a ha
        rw [ha₀def]
        exact hcrit.2 a ha
      obtain ⟨R, hRdeg, hRcoeff, hRlift⟩ :=
        exists_quadratic_lift p Q hdeg a₀ ((ha₀crit a₀ ha₀lt).mpr rfl)
      -- the two-level splitting of the range
      have hsplit : (∑ j ∈ Finset.range (p ^ N),
            χ (((A + (p : ℤ) ^ m * Q.eval (j : ℤ) : ℤ)) : ZMod (p ^ e)))
          = ∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)), ∑ w ∈ Finset.range p,
              χ (((A + (p : ℤ) ^ m
                    * Q.eval (((a + p * (u + p ^ (N - 2) * w) : ℕ) : ℤ)) : ℤ))
                  : ZMod (p ^ e)) := by
        have h1 : p ^ N = p * p ^ (N - 1) := by rw [← pow_succ']; congr 1; omega
        have h2 : p ^ (N - 1) = p ^ (N - 2) * p := by rw [← pow_succ]; congr 1; omega
        rw [h1, Commons.Algebra.BigOperators.sum_range_mul_eq
          (fun j => χ (((A + (p : ℤ) ^ m * Q.eval (j : ℤ) : ℤ)) : ZMod (p ^ e)))
          p (p ^ (N - 1))]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [h2, Commons.Algebra.BigOperators.sum_range_mul_eq
          (fun t => χ (((A + (p : ℤ) ^ m * Q.eval ((a + p * t : ℕ) : ℤ) : ℤ))
            : ZMod (p ^ e))) (p ^ (N - 2)) p]
      -- the per-term factorisation
      have hterm : ∀ a ∈ Finset.range p, ∀ u ∈ Finset.range (p ^ (N - 2)),
          ∀ w ∈ Finset.range p,
          χ (((A + (p : ℤ) ^ m
                * Q.eval (((a + p * (u + p ^ (N - 2) * w) : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
            = χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * χ (((1 + (p : ℤ) ^ (e - 1)
                  * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))) : ℤ))
                  : ZMod (p ^ e)) := by
        intro a _ u _ w _
        have hj : (((a + p * (u + p ^ (N - 2) * w) : ℕ)) : ℤ)
            = (((a + p * u : ℕ) : ℤ)) + (p : ℤ) ^ (N - 1) * (w : ℤ) := by
          have hpp : (p : ℤ) ^ (N - 1) = (p : ℤ) * (p : ℤ) ^ (N - 2) := by
            rw [show N - 1 = (N - 2) + 1 by omega, pow_succ']
          push_cast
          rw [hpp]
          ring
        have hgoal : χ (((A + (p : ℤ) ^ m * Q.eval
                ((((a + p * u : ℕ) : ℤ)) + (p : ℤ) ^ (N - 1) * (w : ℤ)) : ℤ)) : ZMod (p ^ e))
            = χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * χ (((1 + (p : ℤ) ^ (e - 1)
                  * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))) : ℤ))
                  : ZMod (p ^ e)) := by
          rw [← map_mul]
          congr 1
          have hdvd := pow_dvd_stationary_step p e m N hmN hN2 hm A hA Q hdeg
            (((a + p * u : ℕ) : ℤ)) (w : ℤ)
          have hX : ((((A + (p : ℤ) ^ m * Q.eval
                  ((((a + p * u : ℕ) : ℤ)) + (p : ℤ) ^ (N - 1) * (w : ℤ)))
                - (A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)))
                  * (1 + (p : ℤ) ^ (e - 1)
                    * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ)))) : ℤ))
              : ZMod (p ^ e)) = 0 := by
            rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
            exact hdvd
          rw [← sub_eq_zero]
          rw [show (((A + (p : ℤ) ^ m * Q.eval
                  ((((a + p * u : ℕ) : ℤ)) + (p : ℤ) ^ (N - 1) * (w : ℤ)) : ℤ)) : ZMod (p ^ e))
                - (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
                  * (((1 + (p : ℤ) ^ (e - 1)
                      * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))) : ℤ))
                      : ZMod (p ^ e))
              = ((((A + (p : ℤ) ^ m * Q.eval
                    ((((a + p * u : ℕ) : ℤ)) + (p : ℤ) ^ (N - 1) * (w : ℤ)))
                  - (A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)))
                    * (1 + (p : ℤ) ^ (e - 1)
                      * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ)))) : ℤ))
                : ZMod (p ^ e)) by push_cast; ring]
          exact hX
        rw [hj]
        exact hgoal
      -- Step 1: factor the `u`-term out of the inner `w`-sum
      have hstep1 : (∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
            ∑ w ∈ Finset.range p,
              χ (((A + (p : ℤ) ^ m
                    * Q.eval (((a + p * (u + p ^ (N - 2) * w) : ℕ) : ℤ)) : ℤ))
                  : ZMod (p ^ e)))
          = ∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * (∑ w ∈ Finset.range p,
                  χ (((1 + (p : ℤ) ^ (e - 1)
                      * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))) : ℤ))
                      : ZMod (p ^ e))) := by
        refine Finset.sum_congr rfl (fun a ha => Finset.sum_congr rfl (fun u hu => ?_))
        rw [Finset.sum_congr rfl (fun w hw => hterm a ha u hu w hw), Finset.mul_sum]
      -- Step 2: orthogonality on the kernel `1 + p^(e-1)`
      have hstep2 : (∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * (∑ w ∈ Finset.range p,
                  χ (((1 + (p : ℤ) ^ (e - 1)
                      * ((w : ℤ) * (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))) : ℤ))
                      : ZMod (p ^ e))))
          = ∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * (if (p : ℤ) ∣ (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))
                  then (p : ℂ) else 0) := by
        refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun u _ => ?_))
        rw [primePowKernel_sum_orthogonality p e he χ htop
          ((Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ)))]
      -- Step 3: only the critical class survives
      have hcrit_u : ∀ a : ℕ, a < p → ∀ u : ℕ,
          ((p : ℤ) ∣ (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ)) ↔ a = a₀) := by
        intro a ha u
        have h1 : (((a + p * u : ℕ) : ℤ)) = (a : ℤ) + (p : ℤ) * (u : ℤ) := by push_cast; ring
        rw [h1, derivative_eval_eq_coeff Q hdeg ((a : ℤ) + (p : ℤ) * (u : ℤ)),
          show Q.coeff 1 + 2 * Q.coeff 2 * ((a : ℤ) + (p : ℤ) * (u : ℤ))
              = (Q.coeff 1 + 2 * Q.coeff 2 * (a : ℤ)) + (p : ℤ) * (2 * Q.coeff 2 * (u : ℤ))
            by ring]
        rw [dvd_add_left (dvd_mul_right (p : ℤ) (2 * Q.coeff 2 * (u : ℤ))),
          ← derivative_eval_eq_coeff Q hdeg (a : ℤ)]
        exact ha₀crit a ha
      have hstep3 : (∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * (if (p : ℤ) ∣ (Polynomial.derivative Q).eval (((a + p * u : ℕ) : ℤ))
                  then (p : ℂ) else 0))
          = ∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * (if a = a₀ then (p : ℂ) else 0) := by
        refine Finset.sum_congr rfl (fun a ha => Finset.sum_congr rfl (fun u _ => ?_))
        simp only [hcrit_u a (Finset.mem_range.mp ha) u]
      -- Step 4: the `a`-sum collapses to `a = a₀`
      have hstep4 : (∑ a ∈ Finset.range p, ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e))
              * (if a = a₀ then (p : ℂ) else 0))
          = (∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a₀ + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e)))
            * (p : ℂ) := by
        rw [Finset.sum_eq_single a₀]
        · rw [if_pos rfl, Finset.sum_mul]
        · intro b _ hb
          rw [if_neg hb]
          simp
        · intro h
          exact absurd (Finset.mem_range.mpr ha₀lt) h
      -- Step 5: replace `Q (a₀ + p u)` by the lifted quadratic `R`
      have hstep5 : (∑ u ∈ Finset.range (p ^ (N - 2)),
              χ (((A + (p : ℤ) ^ m * Q.eval (((a₀ + p * u : ℕ) : ℤ)) : ℤ)) : ZMod (p ^ e)))
          = ∑ u ∈ Finset.range (p ^ (N - 2)),
              χ ((((A + (p : ℤ) ^ m * Q.eval (a₀ : ℤ)) + (p : ℤ) ^ (m + 2)
                  * R.eval (u : ℤ) : ℤ)) : ZMod (p ^ e)) := by
        refine Finset.sum_congr rfl (fun u _ => ?_)
        have hInt : A + (p : ℤ) ^ m * Q.eval (((a₀ + p * u : ℕ) : ℤ))
            = (A + (p : ℤ) ^ m * Q.eval (a₀ : ℤ)) + (p : ℤ) ^ (m + 2) * R.eval (u : ℤ) := by
          have hpow : (p : ℤ) ^ m * (p : ℤ) ^ 2 = (p : ℤ) ^ (m + 2) := by rw [← pow_add]
          rw [hRlift u, mul_add, ← mul_assoc, hpow]
          ring
        rw [hInt]
      -- Step 6: the induction hypothesis
      have hA₁ : (p : ℤ) ∣ (A + (p : ℤ) ^ m * Q.eval (a₀ : ℤ)) - 1 := by
        have hp_dvd : (p : ℤ) ∣ (p : ℤ) ^ m * Q.eval (a₀ : ℤ) := by
          simpa using dvd_mul_of_dvd_left (pow_dvd_pow (p : ℤ) hm) (Q.eval (a₀ : ℤ))
        rw [show (A + (p : ℤ) ^ m * Q.eval (a₀ : ℤ)) - 1
            = (A - 1) + (p : ℤ) ^ m * Q.eval (a₀ : ℤ) by ring]
        exact dvd_add hA hp_dvd
      have hR₂ : ¬ (p : ℤ) ∣ R.coeff 2 := by rwa [hRcoeff]
      have hIH := ih (N - 2) (by omega) (m + 2) (A + (p : ℤ) ^ m * Q.eval (a₀ : ℤ)) R
        (by omega) (by omega) hA₁ hRdeg hR₂
      rw [hsplit, hstep1, hstep2, hstep3, hstep4, hstep5]
      rw [norm_mul, Complex.norm_natCast]
      refine (mul_le_mul_of_nonneg_right hIH hppos.le).trans_eq ?_
      have h2 : (((N - 2 : ℕ)) : ℝ) = (N : ℝ) - 2 := by
        rw [Nat.cast_sub (show 2 ≤ N by omega)]
        norm_num
      rw [show ((N : ℝ) + 1) / 2 = ((((N - 2 : ℕ)) : ℝ) + 1) / 2 + 1 by rw [h2]; ring,
        Real.rpow_add hppos, Real.rpow_one]



/-- **Bound for the quadratic character sum over a residue system modulo `p^(e-m)`.**

Let `p` be an odd prime, `e ≥ 2`, `1 ≤ m ≤ e`, `χ` a Dirichlet character modulo `p^e`
which is non-trivial on the kernel of `(ZMod (p^e))ˣ → (ZMod (p^(e-1)))ˣ`, and let
`Q ∈ ℤ[X]` have degree at most two with `p ∤ Q.coeff 2`.  Then

`‖∑_{j < p^(e-m)} χ (1 + p^m * Q(j))‖ ≤ p^((e-m+1)/2)`.

The proof is the stationary-phase recursion: splitting `j = a + p·(u + p^(N-2)·w)`
(`N = e - m`) and using orthogonality on the kernel `1 + p^(e-1)`, only the critical
class `a` with `p ∣ Q'(a)` survives, and the remaining quadratic is lifted from
`p^m` to `p^(m+2)` at the cost of one factor `p` and of two summation variables. -/
theorem primePowSubgroup_quadratic_sum_bound (p e m : ℕ) [Fact p.Prime] (hp2 : p ≠ 2)
    (he : 2 ≤ e) (hm : 1 ≤ m) (hme : m ≤ e) (χ : DirichletCharacter ℂ (p^e))
    (htop : χ (((1 + p^(e-1) : ℕ)) : ZMod (p^e)) ≠ 1)
    (Q : Polynomial ℤ) (hdeg : Q.natDegree ≤ 2) (hQ : ¬ (p : ℤ) ∣ Q.coeff 2) :
    ‖∑ j ∈ Finset.range (p^(e-m)), χ (((1 + p^m * Q.eval (j:ℤ) : ℤ)) : ZMod (p^e))‖
      ≤ (p : ℝ) ^ (((e - m : ℝ) + 1) / 2) := by
  have hmain := sum_bound_aux p e hp2 he χ htop (e - m) m 1 Q
    (by omega) hm (by simp) hdeg hQ
  simpa only [Nat.cast_pow, Nat.cast_one, Nat.cast_sub hme] using hmain


end Commons.NumberTheory.DirichletCharacter
