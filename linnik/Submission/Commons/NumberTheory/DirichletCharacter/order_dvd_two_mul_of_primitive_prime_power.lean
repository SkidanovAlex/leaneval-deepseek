import Mathlib.Algebra.Order.Ring.Star
import Mathlib.Data.Complex.Basic
import Mathlib.NumberTheory.DirichletCharacter.Basic
import Mathlib.RingTheory.ZMod.UnitsCyclic

namespace Commons.NumberTheory.DirichletCharacter

open MulChar

/-- The order of a Dirichlet character equals the order of the associated homomorphism
`(ZMod N)ˣ →* ℂˣ` of unit groups. -/
theorem orderOf_eq_orderOf_toUnitHom {N : ℕ} (χ : DirichletCharacter ℂ N) :
    orderOf χ = orderOf χ.toUnitHom := by
  have h := (MulChar.mulEquivToUnitHom (R := ZMod N) (R' := ℂ)).orderOf_eq χ
  rw [MulChar.mulEquivToUnitHom_apply, ← MulChar.toUnitHom_eq] at h
  exact h.symm

/-- A value of `χ.toUnitHom` has order dividing the order of `χ`. -/
theorem orderOf_toUnitHom_apply_dvd {N : ℕ} (χ : DirichletCharacter ℂ N)
    (a : (ZMod N)ˣ) : orderOf (χ.toUnitHom a) ∣ orderOf χ := by
  rw [orderOf_eq_orderOf_toUnitHom χ, orderOf_dvd_iff_pow_eq_one, ← MonoidHom.pow_apply,
    pow_orderOf_eq_one]
  rfl

/-- `1 + p` is coprime to any power of `p`. -/
theorem coprime_one_add_prime_pow (p e : ℕ) : Nat.Coprime (1 + p) (p ^ e) := by
  apply Nat.Coprime.pow_right
  exact (Nat.coprime_add_self_left (m := 1) (n := p)).mpr (Nat.coprime_one_left p)

/-- `5` is coprime to any power of `2`. -/
theorem coprime_five_two_pow (e : ℕ) : Nat.Coprime 5 (2 ^ e) := by
  apply Nat.Coprime.pow_right
  decide

/-- The order of the unit `1 + p` modulo `p ^ e` is `p ^ (e - 1)` (for odd `p`). -/
theorem orderOf_unitOfCoprime_one_add_prime {p e : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (he : 1 ≤ e) :
    orderOf (ZMod.unitOfCoprime (1 + p) (coprime_one_add_prime_pow p e)) = p ^ (e - 1) := by
  rw [← orderOf_units, ZMod.coe_unitOfCoprime]
  have hmod : p ^ e = p ^ ((e - 1) + 1) := by rw [Nat.sub_add_cancel he]
  rw [hmod, Nat.cast_add, Nat.cast_one]
  exact ZMod.orderOf_one_add_prime hp hp2 (e - 1)

/-- The order of the unit `5` modulo `2 ^ e` is `2 ^ (e - 2)`. -/
theorem orderOf_unitOfCoprime_five {e : ℕ} (he : 2 ≤ e) :
    orderOf (ZMod.unitOfCoprime 5 (coprime_five_two_pow e)) = 2 ^ (e - 2) := by
  rw [← orderOf_units, ZMod.coe_unitOfCoprime]
  have hmod : 2 ^ e = 2 ^ ((e - 2) + 2) := by rw [Nat.sub_add_cancel he]
  rw [hmod]
  exact ZMod.orderOf_five (e - 2)

/-- The kernel of the reduction `(ZMod (p ^ e))ˣ → (ZMod (p ^ (e - 1)))ˣ` has cardinality `p`. -/
theorem card_ker_unitsMap_prime_pow {p e : ℕ} (hp : p.Prime) (he : 2 ≤ e)
    (hd : p ^ (e - 1) ∣ p ^ e) :
    Nat.card (ZMod.unitsMap hd : (ZMod (p ^ e))ˣ →* (ZMod (p ^ (e - 1)))ˣ).ker = p := by
  set f : (ZMod (p ^ e))ˣ →* (ZMod (p ^ (e - 1)))ˣ := ZMod.unitsMap hd
  haveI : NeZero (p ^ e) := ⟨pow_ne_zero _ hp.pos.ne'⟩
  haveI : NeZero (p ^ (e - 1)) := ⟨pow_ne_zero _ hp.pos.ne'⟩
  have hcard := Subgroup.card_mul_index f.ker
  rw [Subgroup.index_ker, MonoidHom.range_eq_top_of_surjective f (ZMod.unitsMap_surjective hd),
      Subgroup.card_top] at hcard
  have h2 : Nat.card (ZMod (p ^ (e - 1)))ˣ = p ^ (e - 2) * (p - 1) := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime_pow hp (by omega : 0 < e - 1)]
    rw [show e - 1 - 1 = e - 2 by omega]
  have h1 : Nat.card (ZMod (p ^ e))ˣ = p ^ (e - 1) * (p - 1) := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime_pow hp (by omega : 0 < e)]
  rw [h2, h1] at hcard
  have hm : 0 < p ^ (e - 2) * (p - 1) :=
    Nat.mul_pos (pow_pos hp.pos _) (Nat.sub_pos_of_lt hp.one_lt)
  have hpm : p ^ (e - 1) * (p - 1) = p * (p ^ (e - 2) * (p - 1)) := by
    have h : e - 1 = e - 2 + 1 := by omega
    rw [h, pow_succ]; ring
  exact Nat.eq_of_mul_eq_mul_right hm (hcard.trans hpm)

/-- For odd `p`, the kernel of the reduction `(ZMod (p ^ e))ˣ → (ZMod (p ^ (e - 1)))ˣ` is
generated by `(1 + p) ^ (p ^ (e - 2))`. -/
theorem ker_unitsMap_primePow_eq_zpowers_odd {p e : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (he : 2 ≤ e) (hd : p ^ (e - 1) ∣ p ^ e) :
    (ZMod.unitsMap hd).ker = Subgroup.zpowers
      ((ZMod.unitOfCoprime (1 + p) (coprime_one_add_prime_pow p e)) ^ (p ^ (e - 2))) := by
  haveI : NeZero (p ^ e) := ⟨pow_ne_zero _ hp.pos.ne'⟩
  haveI : NeZero (p ^ (e - 1)) := ⟨pow_ne_zero _ hp.pos.ne'⟩
  set u : (ZMod (p ^ e))ˣ := ZMod.unitOfCoprime (1 + p) (coprime_one_add_prime_pow p e) with hu
  set c : ℕ := p ^ (e - 2) with hc
  have hord_u : orderOf u = p ^ (e - 1) := by
    rw [hu]; exact orderOf_unitOfCoprime_one_add_prime hp hp2 (by omega)
  have hmem : u ^ c ∈ (ZMod.unitsMap hd).ker := by
    rw [MonoidHom.mem_ker, map_pow, ← orderOf_dvd_iff_pow_eq_one]
    have hcast : ((ZMod.unitsMap hd u : (ZMod (p ^ (e - 1)))ˣ) : ZMod (p ^ (e - 1)))
        = (1 + p : ZMod (p ^ (e - 1))) := by
      rw [ZMod.unitsMap_val, hu, ZMod.coe_unitOfCoprime, ZMod.cast_natCast hd]
      simp only [Nat.cast_add, Nat.cast_one]
    rw [← orderOf_units (y := ZMod.unitsMap hd u), hcast, hc]
    have hmod : p ^ (e - 1) = p ^ ((e - 2) + 1) := by
      rw [show (e - 2) + 1 = e - 1 by omega]
    rw [hmod]
    rw [ZMod.orderOf_one_add_prime hp hp2 (e - 2)]
  have hne : u ^ c ≠ 1 := by
    intro h
    have hdvd : orderOf u ∣ c := (orderOf_dvd_iff_pow_eq_one).mpr h
    rw [hord_u, hc] at hdvd
    have hlt : p ^ (e - 2) < p ^ (e - 1) := Nat.pow_lt_pow_right hp.one_lt (by omega)
    exact absurd (Nat.le_of_dvd (pow_pos hp.pos _) hdvd) (not_le.mpr hlt)
  have hord_uc : orderOf (u ^ c) = p := by
    have hdvd : orderOf (u ^ c) ∣ p := by
      rw [orderOf_dvd_iff_pow_eq_one, ← pow_mul, hc,
        show p ^ (e - 2) * p = p ^ (e - 1) by
          rw [show (e : ℕ) - 1 = e - 2 + 1 by omega, pow_succ],
        ← hord_u]
      exact pow_orderOf_eq_one u
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | h1
    · exact absurd (orderOf_eq_one_iff.mp h1) hne
    · exact h1
  have hcardz : Nat.card (Subgroup.zpowers (u ^ c)) = p := by rw [Nat.card_zpowers, hord_uc]
  have hcardk : Nat.card (ZMod.unitsMap hd).ker = p := card_ker_unitsMap_prime_pow hp he hd
  have hle : Subgroup.zpowers (u ^ c) ≤ (ZMod.unitsMap hd).ker := Subgroup.zpowers_le.mpr hmem
  exact (Subgroup.eq_of_le_of_card_ge hle (by rw [hcardk, hcardz])).symm

/-- For `p = 2` and `3 ≤ e`, the kernel of the reduction `(ZMod (2 ^ e))ˣ → (ZMod (2 ^ (e - 1)))ˣ`
is generated by `5 ^ (2 ^ (e - 3))`. -/
theorem ker_unitsMap_twoPow_eq_zpowers {e : ℕ} (he : 3 ≤ e) (hd : 2 ^ (e - 1) ∣ 2 ^ e) :
    (ZMod.unitsMap hd).ker = Subgroup.zpowers
      ((ZMod.unitOfCoprime 5 (coprime_five_two_pow e)) ^ (2 ^ (e - 3))) := by
  have hp : Nat.Prime 2 := Nat.prime_two
  haveI : NeZero (2 ^ e) := ⟨pow_ne_zero _ hp.pos.ne'⟩
  haveI : NeZero (2 ^ (e - 1)) := ⟨pow_ne_zero _ hp.pos.ne'⟩
  set u : (ZMod (2 ^ e))ˣ := ZMod.unitOfCoprime 5 (coprime_five_two_pow e) with hu
  set c : ℕ := 2 ^ (e - 3) with hc
  have hord_u : orderOf u = 2 ^ (e - 2) := by
    rw [hu]; exact orderOf_unitOfCoprime_five (by omega)
  have hmem : u ^ c ∈ (ZMod.unitsMap hd).ker := by
    rw [MonoidHom.mem_ker, map_pow, ← orderOf_dvd_iff_pow_eq_one]
    have hcast : ((ZMod.unitsMap hd u : (ZMod (2 ^ (e - 1)))ˣ) : ZMod (2 ^ (e - 1)))
        = (5 : ZMod (2 ^ (e - 1))) := by
      rw [ZMod.unitsMap_val, hu, ZMod.coe_unitOfCoprime, ZMod.cast_natCast hd]
      norm_num
    rw [← orderOf_units (y := ZMod.unitsMap hd u), hcast, hc]
    have hmod : 2 ^ (e - 1) = 2 ^ ((e - 3) + 2) := by
      rw [show (e - 3) + 2 = e - 1 by omega]
    rw [hmod]
    rw [ZMod.orderOf_five (e - 3)]
  have hne : u ^ c ≠ 1 := by
    intro h
    have hdvd : orderOf u ∣ c := (orderOf_dvd_iff_pow_eq_one).mpr h
    rw [hord_u, hc] at hdvd
    have hlt : 2 ^ (e - 3) < 2 ^ (e - 2) := Nat.pow_lt_pow_right (by norm_num) (by omega)
    exact absurd (Nat.le_of_dvd (pow_pos (by norm_num) _) hdvd) (not_le.mpr hlt)
  have hord_uc : orderOf (u ^ c) = 2 := by
    have hdvd : orderOf (u ^ c) ∣ 2 := by
      rw [orderOf_dvd_iff_pow_eq_one, ← pow_mul, hc,
        show 2 ^ (e - 3) * 2 = 2 ^ (e - 2) by
          rw [show (e : ℕ) - 2 = e - 3 + 1 by omega, pow_succ],
        ← hord_u]
      exact pow_orderOf_eq_one u
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h1
    · exact absurd (orderOf_eq_one_iff.mp h1) hne
    · exact h1
  have hcardz : Nat.card (Subgroup.zpowers (u ^ c)) = 2 := by rw [Nat.card_zpowers, hord_uc]
  have hcardk : Nat.card (ZMod.unitsMap hd).ker = 2 :=
    card_ker_unitsMap_prime_pow Nat.prime_two (by omega) hd
  have hle : Subgroup.zpowers (u ^ c) ≤ (ZMod.unitsMap hd).ker := Subgroup.zpowers_le.mpr hmem
  exact (Subgroup.eq_of_le_of_card_ge hle (by rw [hcardk, hcardz])).symm

theorem order_dvd_two_mul_of_primitive_prime_power {p e : ℕ} (hp : p.Prime) (he : 2 ≤ e)
    {χ : DirichletCharacter ℂ (p ^ e)} (hχ : χ.IsPrimitive) (h1 : χ ≠ 1) :
    p ^ (e - 1) ∣ 2 * orderOf χ := by
  rcases eq_or_ne p 2 with hp2eq | hp2ne
  · subst hp2eq
    rcases eq_or_lt_of_le he with he2 | he3
    · -- e = 2
      subst he2
      show (2 : ℕ) ^ (2 - 1) ∣ 2 * orderOf χ
      rw [show (2 : ℕ) ^ (2 - 1) = 2 by norm_num]
      exact dvd_mul_of_dvd_left (dvd_refl 2) (orderOf χ)
    · -- 3 ≤ e
      have hd : 2 ^ (e - 1) ∣ 2 ^ e := pow_dvd_pow 2 (Nat.sub_le e 1)
      haveI : NeZero (2 ^ e) := ⟨pow_ne_zero _ Nat.prime_two.pos.ne'⟩
      have hχc : χ.conductor = 2 ^ e := hχ
      have hnotfac : ¬ χ.FactorsThrough (2 ^ (e - 1)) := by
        intro hf
        have hmem : 2 ^ (e - 1) ∈ χ.conductorSet :=
          (DirichletCharacter.mem_conductorSet_iff χ).mpr hf
        have hdvd : χ.conductor ∣ 2 ^ (e - 1) :=
          (DirichletCharacter.mem_conductorSet_iff_conductor_dvd χ hd).mp hmem
        rw [hχc] at hdvd
        exact absurd (Nat.le_of_dvd (pow_pos (by norm_num) _) hdvd)
          (not_le.mpr (Nat.pow_lt_pow_right (by norm_num) (by omega)))
      set u : (ZMod (2 ^ e))ˣ := ZMod.unitOfCoprime 5 (coprime_five_two_pow e) with hu
      have hgen := ker_unitsMap_twoPow_eq_zpowers he3 hd
      have key : χ.toUnitHom (u ^ (2 ^ (e - 3))) ≠ 1 := by
        intro h
        apply hnotfac
        rw [DirichletCharacter.factorsThrough_iff_ker_unitsMap hd, hgen]
        exact Subgroup.zpowers_le.mpr (MonoidHom.mem_ker.mpr h)
      have hord_u : orderOf u = 2 ^ (e - 2) := by
        rw [hu]; exact orderOf_unitOfCoprime_five (by omega)
      have hdu : orderOf (χ.toUnitHom u) = 2 ^ (e - 2) := by
        have hdvd : orderOf (χ.toUnitHom u) ∣ 2 ^ (e - 2) := by
          rw [← hord_u]; exact orderOf_map_dvd χ.toUnitHom u
        obtain ⟨k, hk, hk_eq⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
        have hk2 : k = e - 2 := by
          rcases lt_or_eq_of_le hk with hlt | heq
          · exfalso
            have hkle : k ≤ e - 3 := by omega
            have hdvd2 : 2 ^ k ∣ 2 ^ (e - 3) := pow_dvd_pow 2 hkle
            have h1 : (χ.toUnitHom u) ^ (2 ^ (e - 3)) = 1 := by
              rw [← orderOf_dvd_iff_pow_eq_one, hk_eq]; exact hdvd2
            exact key (by rw [map_pow]; exact h1)
          · exact heq
        rw [hk_eq, hk2]
      have hdiv2 : 2 ^ (e - 2) ∣ orderOf χ := hdu ▸ orderOf_toUnitHom_apply_dvd χ u
      have := mul_dvd_mul_left 2 hdiv2
      rwa [show 2 * 2 ^ (e - 2) = 2 ^ (e - 1) by
            rw [show (e : ℕ) - 1 = e - 2 + 1 by omega, pow_succ']] at this
  · -- odd p
    have hp2 : p ≠ 2 := hp2ne
    have hd : p ^ (e - 1) ∣ p ^ e := pow_dvd_pow p (Nat.sub_le e 1)
    haveI : NeZero (p ^ e) := ⟨pow_ne_zero _ hp.pos.ne'⟩
    have hχc : χ.conductor = p ^ e := hχ
    have hnotfac : ¬ χ.FactorsThrough (p ^ (e - 1)) := by
      intro hf
      have hmem : p ^ (e - 1) ∈ χ.conductorSet :=
        (DirichletCharacter.mem_conductorSet_iff χ).mpr hf
      have hdvd : χ.conductor ∣ p ^ (e - 1) :=
        (DirichletCharacter.mem_conductorSet_iff_conductor_dvd χ hd).mp hmem
      rw [hχc] at hdvd
      exact absurd (Nat.le_of_dvd (pow_pos hp.pos _) hdvd)
        (not_le.mpr (Nat.pow_lt_pow_right hp.one_lt (by omega)))
    set u : (ZMod (p ^ e))ˣ := ZMod.unitOfCoprime (1 + p) (coprime_one_add_prime_pow p e) with hu
    have hgen := ker_unitsMap_primePow_eq_zpowers_odd hp hp2 he hd
    have key : χ.toUnitHom (u ^ (p ^ (e - 2))) ≠ 1 := by
      intro h
      apply hnotfac
      rw [DirichletCharacter.factorsThrough_iff_ker_unitsMap hd, hgen]
      exact Subgroup.zpowers_le.mpr (MonoidHom.mem_ker.mpr h)
    have hord_u : orderOf u = p ^ (e - 1) := by
      rw [hu]; exact orderOf_unitOfCoprime_one_add_prime hp hp2 (by omega)
    have hdu : orderOf (χ.toUnitHom u) = p ^ (e - 1) := by
      have hdvd : orderOf (χ.toUnitHom u) ∣ p ^ (e - 1) := by
        rw [← hord_u]; exact orderOf_map_dvd χ.toUnitHom u
      obtain ⟨k, hk, hk_eq⟩ := (Nat.dvd_prime_pow hp).mp hdvd
      have hk2 : k = e - 1 := by
        rcases lt_or_eq_of_le hk with hlt | heq
        · exfalso
          have hkle : k ≤ e - 2 := by omega
          have hdvd2 : p ^ k ∣ p ^ (e - 2) := pow_dvd_pow p hkle
          have h1 : (χ.toUnitHom u) ^ (p ^ (e - 2)) = 1 := by
            rw [← orderOf_dvd_iff_pow_eq_one, hk_eq]; exact hdvd2
          exact key (by rw [map_pow]; exact h1)
        · exact heq
      rw [hk_eq, hk2]
    have hdiv : p ^ (e - 1) ∣ orderOf χ := hdu ▸ orderOf_toUnitHom_apply_dvd χ u
    exact dvd_mul_of_dvd_right hdiv 2

end Commons.NumberTheory.DirichletCharacter