/-!
# A Weil-type bound for polynomial character sums modulo `p ^ 2`

Let `p` be an odd prime, `χ` a primitive Dirichlet character modulo `p ^ 2` and
`F ∈ ℤ[X]`.  Writing `F̄` for the reduction of `F` modulo `p`, this file proves

`‖∑_{x : ZMod (p^2)} χ (F(x))‖ ≤ (deg F̄') · p`,

where `F̄'` is the derivative of `F̄`.

The proof is elementary.  Every residue class modulo `p ^ 2` can be written
uniquely as `a + p * m` with `a, m : ZMod p`; on such a decomposition the
polynomial satisfies the first-order Taylor expansion
`F(a + p m) ≡ F(a) + p m F'(a) (mod p ^ 2)` because `(p m) ^ 2 = 0`.  Summing the
character over the `p` classes of a fixed residue `a` therefore gives `0` unless
`F'(a) ≡ 0 (mod p)`: this is the "coset sum" vanishing, and it uses primitivity of
`χ` through the non-triviality of `χ` on the kernel of `(ZMod (p^2))ˣ → (ZMod p)ˣ`
(the group generated by `1 + p`).  Hence the total sum is `p` times a sum over the
roots in `ZMod p` of `F̄'`, of which a non-zero polynomial of degree `d` has at
most `d`.
-/

open scoped BigOperators

namespace Commons.NumberTheory.DirichletCharacter

theorem pow_one_add_prime_eq (p n : ℕ) :
    (1 + (p : ZMod (p ^ 2))) ^ n = 1 + (n : ZMod (p ^ 2)) * (p : ZMod (p ^ 2)) := by
  have hp2 : (p : ZMod (p ^ 2)) * (p : ZMod (p ^ 2)) = 0 := by
    rw [← Nat.cast_mul, show p * p = p ^ 2 from (pow_two p).symm, ZMod.natCast_self]
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_add, pow_one, ih]
    push_cast
    rw [show (1 + (n : ZMod (p ^ 2)) * (p : ZMod (p ^ 2))) * (1 + (p : ZMod (p ^ 2)))
          = 1 + (n : ZMod (p ^ 2)) * (p : ZMod (p ^ 2)) + (p : ZMod (p ^ 2))
            + (n : ZMod (p ^ 2)) * ((p : ZMod (p ^ 2)) * (p : ZMod (p ^ 2))) by ring]
    rw [hp2, mul_zero, add_zero]
    ring

theorem sum_val_eq_sum_range {n : ℕ} [NeZero n] {M : Type*} [AddCommMonoid M] (f : ℕ → M) :
    (∑ m : ZMod n, f m.val) = ∑ j ∈ Finset.range n, f j := by
  refine Finset.sum_bij (fun m _ => m.val) ?_ ?_ ?_ ?_
  · intro m _; exact Finset.mem_range.mpr (ZMod.val_lt m)
  · intro m₁ _ m₂ _ h; exact ZMod.val_injective n h
  · intro b hb
    refine ⟨(b : ZMod n), Finset.mem_univ _, ?_⟩
    rw [ZMod.val_natCast, Nat.mod_eq_of_lt (Finset.mem_range.mp hb)]
  · intro m _; rfl

theorem sum_val_pow_eq_zero {n : ℕ} [NeZero n] {ζ : ℂ} (hζ : ζ ^ n = 1) (h1 : ζ ≠ 1) :
    (∑ m : ZMod n, ζ ^ m.val) = 0 := by
  rw [sum_val_eq_sum_range, geom_sum_eq h1, hζ, sub_self, zero_div]

theorem primitive_apply_one_add_prime_ne_one (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2)
    (χ : DirichletCharacter ℂ (p ^ 2)) (hχ : χ.IsPrimitive) :
    χ (((1 + p : ℕ) : ZMod (p ^ 2))) ≠ 1 := by
  have : NeZero (p ^ 2) := ⟨pow_ne_zero 2 hp.pos.ne'⟩
  intro h
  have hd : p ^ (2 - 1) ∣ p ^ 2 := pow_dvd_pow p (by omega)
  set u : (ZMod (p ^ 2))ˣ := ZMod.unitOfCoprime (1 + p)
      (Commons.NumberTheory.DirichletCharacter.coprime_one_add_prime_pow p 2) with hudef
  have hker := Commons.NumberTheory.DirichletCharacter.ker_unitsMap_primePow_eq_zpowers_odd hp hp2
    (le_refl 2) hd
  have hu : ((u : ZMod (p ^ 2))) = ((1 + p : ℕ) : ZMod (p ^ 2)) := ZMod.coe_unitOfCoprime _ _
  have hu' : χ.toUnitHom u = 1 := by
    rw [← Units.val_eq_one, MulChar.coe_toUnitHom, hu]; exact h
  have hfac : χ.FactorsThrough (p ^ (2-1)) := by
    rw [DirichletCharacter.factorsThrough_iff_ker_unitsMap hd]
    intro x hx
    rw [MonoidHom.mem_ker]
    rw [hker] at hx
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hx
    have hpow : χ.toUnitHom (u ^ (p ^ (2 - 2))) = 1 := by rw [map_pow, hu', one_pow]
    rw [← hk, map_zpow, hpow, one_zpow]
  have hcd : χ.conductor ∣ p ^ (2-1) :=
    (DirichletCharacter.mem_conductorSet_iff_conductor_dvd χ hd).mp
      ((DirichletCharacter.mem_conductorSet_iff χ).mpr hfac)
  rw [show χ.conductor = p ^ 2 from hχ] at hcd
  have hp1 : p ^ (2 - 1) = p := by norm_num
  rw [hp1] at hcd
  have := Nat.le_of_dvd hp.pos hcd
  nlinarith [hp.two_le]

theorem mul_prime_eq_of_cast_eq {p : ℕ} [NeZero p] (x y : ZMod (p ^ 2))
    (h : ZMod.castHom (show p ∣ p ^ 2 from ⟨p, by ring⟩) (ZMod p) x
        = ZMod.castHom (show p ∣ p ^ 2 from ⟨p, by ring⟩) (ZMod p) y) :
    (p : ZMod (p ^ 2)) * x = (p : ZMod (p ^ 2)) * y := by
  have : NeZero (p ^ 2) := ⟨pow_ne_zero 2 (NeZero.ne p)⟩
  have hd : p ∣ p ^ 2 := ⟨p, by ring⟩
  have hvalz : ∀ z : ZMod (p ^ 2), (ZMod.castHom hd (ZMod p) z).val = z.val % p := by
    intro z; rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
  have key : ∀ z : ZMod (p ^ 2), (p : ZMod (p ^ 2)) * z
      = (p : ZMod (p ^ 2)) * (((ZMod.castHom hd (ZMod p) z).val : ℕ) : ZMod (p ^ 2)) := by
    intro z
    have hz : z = (((z.val % p : ℕ)) : ZMod (p ^ 2))
        + (p : ZMod (p ^ 2)) * (((z.val / p : ℕ)) : ZMod (p ^ 2)) := by
      conv_lhs => rw [← ZMod.natCast_zmod_val z, ← Nat.div_add_mod z.val p]
      push_cast; ring
    have hp2 : (p : ZMod (p ^ 2)) * (p : ZMod (p ^ 2)) = 0 := by
      rw [← Nat.cast_mul, show p * p = p ^ 2 from (pow_two p).symm, ZMod.natCast_self]
    calc (p : ZMod (p ^ 2)) * z
        = (p : ZMod (p ^ 2)) * ((((z.val % p : ℕ)) : ZMod (p ^ 2))
            + (p : ZMod (p ^ 2)) * (((z.val / p : ℕ)) : ZMod (p ^ 2))) := by
            conv_lhs => rw [hz]
      _ = (p : ZMod (p ^ 2)) * (((z.val % p : ℕ)) : ZMod (p ^ 2)) := by
            rw [mul_add, ← mul_assoc, hp2, zero_mul, add_zero]
      _ = (p : ZMod (p ^ 2)) * (((ZMod.castHom hd (ZMod p) z).val : ℕ) : ZMod (p ^ 2)) := by
            rw [← hvalz z]
  rw [key x, key y, h]

theorem sum_apply_one_add_prime_mul_eq_zero (p : ℕ) [NeZero p] (hp : p.Prime) (hp2 : p ≠ 2)
    (χ : DirichletCharacter ℂ (p ^ 2)) (hχ : χ.IsPrimitive) :
    (∑ m : ZMod p, χ (1 + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))) = 0 := by
  have hζne := primitive_apply_one_add_prime_ne_one p hp hp2 χ hχ
  have hζpow : (χ ((1 + p : ℕ) : ZMod (p ^ 2))) ^ p = 1 := by
    have h1 : (((1 + p : ℕ)) : ZMod (p ^ 2)) ^ p = 1 := by
      rw [show (((1 + p : ℕ)) : ZMod (p ^ 2)) = 1 + (p : ZMod (p ^ 2)) by push_cast; ring,
        pow_one_add_prime_eq p p]
      rw [← Nat.cast_mul, show p * p = p ^ 2 from (pow_two p).symm, ZMod.natCast_self, add_zero]
    rw [← map_pow, h1, map_one]
  have hterm : ∀ m : ZMod p, χ (1 + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))
      = (χ ((1 + p : ℕ) : ZMod (p ^ 2))) ^ m.val := by
    intro m
    rw [show (1 : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))
        = (1 + (p : ZMod (p ^ 2))) ^ m.val by
          rw [pow_one_add_prime_eq p m.val]; ring,
      show (1 + (p : ZMod (p ^ 2))) = (((1 + p : ℕ)) : ZMod (p ^ 2)) by push_cast; ring,
      ← map_pow]
  rw [Finset.sum_congr rfl (fun m _ => hterm m)]
  exact sum_val_pow_eq_zero hζpow hζne


theorem sum_apply_unit_add_prime_mul_eq_zero (p : ℕ) [NeZero p] (hp : p.Prime) (hp2 : p ≠ 2)
    (χ : DirichletCharacter ℂ (p ^ 2)) (hχ : χ.IsPrimitive) {v : ZMod (p ^ 2)}
    (hv : IsUnit v) :
    (∑ m : ZMod p, χ (v + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))) = 0 := by
  have : Fact p.Prime := ⟨hp⟩
  have : NeZero (p ^ 2) := ⟨pow_ne_zero 2 (NeZero.ne p)⟩
  have hd : p ∣ p ^ 2 := ⟨p, by ring⟩
  obtain ⟨u, rfl⟩ := hv
  set w : (ZMod p)ˣ := ZMod.unitsMap hd (u⁻¹) with hwdef
  have hwval : ((w : ZMod p)) = ZMod.castHom hd (ZMod p) ((↑u⁻¹ : ZMod (p ^ 2))) := by
    rw [hwdef]; exact ZMod.unitsMap_val hd u⁻¹
  have hterm : ∀ m : ZMod p,
      χ ((↑u : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))
      = χ (↑u : ZMod (p ^ 2))
        * χ (1 + (p : ZMod (p ^ 2)) * ((((w : ZMod p) * m).val : ℕ) : ZMod (p ^ 2))) := by
    intro m
    rw [show (↑u : ZMod (p^2)) + (p : ZMod (p^2)) * ((m.val : ℕ) : ZMod (p^2))
        = (↑u : ZMod (p^2)) * (1 + (↑u⁻¹ : ZMod (p^2)) * ((p : ZMod (p^2)) * ((m.val : ℕ) : ZMod (p^2)))) by
          rw [mul_add, mul_one, ← mul_assoc, Units.mul_inv, one_mul]]
    rw [map_mul]
    congr 1
    have hstep : (↑u⁻¹ : ZMod (p^2)) * ((p : ZMod (p^2)) * ((m.val : ℕ) : ZMod (p^2)))
        = (p : ZMod (p^2)) * ((((w : ZMod p) * m).val : ℕ) : ZMod (p^2)) := by
      rw [show (↑u⁻¹ : ZMod (p^2)) * ((p : ZMod (p^2)) * ((m.val : ℕ) : ZMod (p^2)))
          = (p : ZMod (p^2)) * ((↑u⁻¹ : ZMod (p^2)) * ((m.val : ℕ) : ZMod (p^2))) by ring]
      exact mul_prime_eq_of_cast_eq _ _ (by
        rw [map_mul, map_natCast, ZMod.natCast_zmod_val, map_natCast, ZMod.natCast_zmod_val,
          ← hwval])
    rw [hstep]
  rw [Finset.sum_congr rfl (fun m _ => hterm m), ← Finset.mul_sum]
  rw [show (∑ m : ZMod p, χ (1 + (p : ZMod (p ^ 2)) * ((((w : ZMod p) * m).val : ℕ) : ZMod (p ^ 2))))
      = ∑ m' : ZMod p, χ (1 + (p : ZMod (p ^ 2)) * ((m'.val : ℕ) : ZMod (p ^ 2))) from
    Fintype.sum_bijective (fun m : ZMod p => (w : ZMod p) * m)
      (Equiv.mulLeft₀ (w : ZMod p) (Units.ne_zero w)).bijective _ _ (fun _ => rfl)]
  rw [sum_apply_one_add_prime_mul_eq_zero (p := p) hp hp2 χ hχ, mul_zero]


theorem zmod_sq_digits_bijective (p : ℕ) [NeZero p] :
    Function.Bijective (fun am : ZMod p × ZMod p =>
      ((am.1.val : ℕ) : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((am.2.val : ℕ) : ZMod (p ^ 2))) := by
  have : NeZero (p ^ 2) := ⟨pow_ne_zero 2 (NeZero.ne p)⟩
  have hd : p ∣ p ^ 2 := ⟨p, by ring⟩
  have hp : 0 < p := Nat.pos_of_ne_zero (NeZero.ne p)
  have hcast1 : ∀ a : ZMod p, ZMod.castHom hd (ZMod p) (((a.val : ℕ)) : ZMod (p ^ 2)) = a := by
    intro a; rw [map_natCast, ZMod.natCast_zmod_val]
  have hcast2 : ∀ a : ZMod p,
      ZMod.castHom hd (ZMod p) ((p : ZMod (p ^ 2)) * ((a.val : ℕ) : ZMod (p ^ 2))) = 0 := by
    intro a; rw [map_mul, map_natCast, ZMod.natCast_self, zero_mul]
  refine (Fintype.bijective_iff_injective_and_card _).mpr ⟨?_, ?_⟩
  · intro am bm h
    have hc : (((am.1.val : ℕ)) : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((am.2.val : ℕ) : ZMod (p ^ 2))
        = (((bm.1.val : ℕ)) : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((bm.2.val : ℕ) : ZMod (p ^ 2)) := h
    have h1 : am.1 = bm.1 := by
      have h' := congrArg (ZMod.castHom hd (ZMod p)) hc
      rw [map_add, map_add, hcast1, hcast1, hcast2, hcast2, add_zero, add_zero] at h'
      exact h'
    have h3 : (p : ZMod (p ^ 2)) * ((am.2.val : ℕ) : ZMod (p ^ 2))
        = (p : ZMod (p ^ 2)) * ((bm.2.val : ℕ) : ZMod (p ^ 2)) := by
      rw [← h1] at hc
      exact add_left_cancel hc
    have h2 : am.2 = bm.2 := by
      have h4 : ((p * am.2.val : ℕ) : ZMod (p ^ 2)) = ((p * bm.2.val : ℕ) : ZMod (p ^ 2)) := by
        rw [Nat.cast_mul, Nat.cast_mul]; exact h3
      have hmodeq : p * am.2.val ≡ p * bm.2.val [MOD p ^ 2] :=
        (ZMod.natCast_eq_natCast_iff _ _ _).mp h4
      have hlt1 : p * am.2.val < p ^ 2 := by
        have := ZMod.val_lt am.2; nlinarith [show p ^ 2 = p * p from pow_two p]
      have hlt2 : p * bm.2.val < p ^ 2 := by
        have := ZMod.val_lt bm.2; nlinarith [show p ^ 2 = p * p from pow_two p]
      have heq : p * am.2.val = p * bm.2.val := Nat.ModEq.eq_of_lt_of_lt hmodeq hlt1 hlt2
      have hval : am.2.val = bm.2.val := Nat.mul_left_cancel hp heq
      exact ZMod.val_injective p hval
    exact Prod.ext h1 h2
  · rw [Fintype.card_prod, ZMod.card, ZMod.card, pow_two]

lemma castHom_eval₂_map (p : ℕ) [NeZero p] (F : Polynomial ℤ) (a : ZMod p) :
    ZMod.castHom (show p ∣ p ^ 2 from ⟨p, by ring⟩) (ZMod p)
        (Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2))) (((a.val : ℕ)) : ZMod (p ^ 2)) F)
      = Polynomial.eval₂ (Int.castRingHom (ZMod p)) a F := by
  have hy : (((a.val : ℕ)) : ZMod (p ^ 2)) = (Int.castRingHom (ZMod (p ^ 2))) ((a.val : ℕ) : ℤ) := by
    simp only [Int.coe_castRingHom, Int.cast_natCast]
  have hcomp : ∀ k : ℤ, ZMod.castHom (show p ∣ p ^ 2 from ⟨p, by ring⟩) (ZMod p)
        ((Int.castRingHom (ZMod (p ^ 2))) k) = (Int.castRingHom (ZMod p)) k := by
    intro k
    rw [ZMod.castHom_apply]
    exact ZMod.cast_intCast (show p ∣ p ^ 2 from ⟨p, by ring⟩) k
  have ha : a = (Int.castRingHom (ZMod p)) ((a.val : ℕ) : ℤ) := by
    simp only [Int.coe_castRingHom, Int.cast_natCast, ZMod.natCast_zmod_val]
  rw [hy, Polynomial.eval₂_at_apply, hcomp]
  conv_rhs => rw [ha]
  rw [← Polynomial.eval₂_at_apply]

lemma card_roots_le {K : Type*} [Field K] [Fintype K] [DecidableEq K] (P : Polynomial K) (hP : P ≠ 0) :
    (Finset.univ.filter (fun a : K => P.eval a = 0)).card ≤ P.natDegree := by
  have h : Finset.univ.filter (fun a : K => P.eval a = 0) = P.roots.toFinset := by
    ext a
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Multiset.mem_toFinset,
      Polynomial.mem_roots hP]
    exact Iff.rfl
  rw [h]
  exact le_trans (Multiset.toFinset_card_le _) (Polynomial.card_roots' P)


theorem primesq_weil_bound (p : ℕ) [NeZero p] (hp : p.Prime) (hp2 : p ≠ 2)
    (χ : DirichletCharacter ℂ (p ^ 2)) (hχ : χ.IsPrimitive) (F : Polynomial ℤ)
    (hF : Polynomial.derivative (F.map (Int.castRingHom (ZMod p))) ≠ 0) :
    ‖∑ x : ZMod (p ^ 2), χ (Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2))) x F)‖
      ≤ ((Polynomial.derivative (F.map (Int.castRingHom (ZMod p)))).natDegree : ℝ) * p := by
  classical
  have : NeZero (p ^ 2) := ⟨pow_ne_zero 2 (NeZero.ne p)⟩
  have : Fact p.Prime := ⟨hp⟩
  have hd : p ∣ p ^ 2 := ⟨p, by ring⟩
  set P : Polynomial (ZMod p) := Polynomial.derivative (F.map (Int.castRingHom (ZMod p))) with hPdef
  have hP0 : P ≠ 0 := hF
  set V : ZMod p → ZMod (p ^ 2) := fun a =>
    Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2))) (((a.val : ℕ)) : ZMod (p ^ 2)) F with hV
  set D : ZMod p → ZMod (p ^ 2) := fun a =>
    Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2))) (((a.val : ℕ)) : ZMod (p ^ 2))
      (Polynomial.derivative F) with hD
  have hcastV : ∀ a : ZMod p,
      ZMod.castHom hd (ZMod p) (V a) = (F.map (Int.castRingHom (ZMod p))).eval a := by
    intro a
    rw [hV]
    beta_reduce
    rw [Polynomial.eval_map]
    exact castHom_eval₂_map p F a
  have hcastD : ∀ a : ZMod p, ZMod.castHom hd (ZMod p) (D a) = P.eval a := by
    intro a
    rw [hD, hPdef]
    rw [Polynomial.derivative_map, Polynomial.eval_map]
    exact castHom_eval₂_map p (Polynomial.derivative F) a
  have hTay : ∀ (a m : ZMod p),
      Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2)))
          ((((a.val : ℕ)) : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) F
      = V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) := by
    intro a m
    have hδ : ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) ^ 2 = 0 := by
      have hpp : (p : ZMod (p ^ 2)) * (p : ZMod (p ^ 2)) = 0 := by
        rw [← Nat.cast_mul, show p * p = p ^ 2 from (pow_two p).symm, ZMod.natCast_self]
      rw [show ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) ^ 2
          = ((p : ZMod (p ^ 2)) * (p : ZMod (p ^ 2)))
            * (((m.val : ℕ) : ZMod (p ^ 2)) ^ 2) from by ring]
      rw [hpp, zero_mul]
    have key := Commons.Algebra.Polynomial.eval_add_eq_eval_add_derivative_mul_of_sq_eq_zero
      (F.map (Int.castRingHom (ZMod (p ^ 2)))) (u := (((a.val : ℕ)) : ZMod (p ^ 2)))
      (δ := (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) hδ
    rw [Polynomial.eval_map, Polynomial.derivative_map, Polynomial.eval_map] at key
    rw [hV, hD, key]
    simp only [Polynomial.eval_map]
  have hfiber : ∀ a : ZMod p,
      ‖∑ m : ZMod p, χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))))‖
        ≤ if P.eval a = 0 then (p : ℝ) else 0 := by
    intro a
    by_cases hPa : P.eval a = 0
    · have hDa : (p : ZMod (p ^ 2)) * D a = 0 := by
        have h := mul_prime_eq_of_cast_eq (D a) 0 (by rw [hcastD a, hPa, map_zero])
        rwa [mul_zero] at h
      have hterm : ∀ m : ZMod p,
          V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) = V a := by
        intro m
        rw [show D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))
            = ((p : ZMod (p ^ 2)) * D a) * ((m.val : ℕ) : ZMod (p ^ 2)) by ring, hDa, zero_mul,
          add_zero]
      have hcard : (Finset.univ : Finset (ZMod p)).card = p := by simp [ZMod.card]
      rw [if_pos hPa, Finset.sum_congr rfl (fun m _ => by rw [hterm m]), Finset.sum_const,
        hcard, nsmul_eq_mul, norm_mul, Complex.norm_natCast]
      calc (p : ℝ) * ‖χ (V a)‖ ≤ (p : ℝ) * 1 :=
            mul_le_mul_of_nonneg_left (DirichletCharacter.norm_le_one χ (V a)) (Nat.cast_nonneg p)
        _ = (p : ℝ) := mul_one _
    · by_cases hVa : ZMod.castHom hd (ZMod p) (V a) = 0
      · have hterm : ∀ m : ZMod p,
            χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))) = 0 := by
          intro m
          apply MulChar.map_nonunit
          intro hunit
          have h0 : ZMod.castHom hd (ZMod p)
              (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))) = 0 := by
            have hδ : ZMod.castHom hd (ZMod p)
                ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) = 0 := by
              rw [map_mul, map_natCast, ZMod.natCast_self, zero_mul]
            rw [map_add, map_mul, hVa, hδ, mul_zero, add_zero]
          exact not_isUnit_zero (by rw [← h0]; exact hunit.map (ZMod.castHom hd (ZMod p)))
        rw [if_neg hPa, Finset.sum_congr rfl (fun m _ => hterm m), Finset.sum_const_zero, norm_zero]
      · have hVunit : IsUnit (V a) := by
          rw [← ZMod.natCast_zmod_val (V a), ZMod.isUnit_iff_coprime,
            Nat.coprime_pow_right_iff (by norm_num : 0 < 2)]
          rw [Nat.coprime_comm, hp.coprime_iff_not_dvd]
          intro hdiv
          exact hVa (by
            rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.natCast_eq_zero_iff]
            exact hdiv)
        have hsub : (∑ m : ZMod p,
              χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))))
            = ∑ m : ZMod p,
                χ (V a + (p : ZMod (p ^ 2)) * (((P.eval a * m).val : ℕ) : ZMod (p ^ 2))) := by
          refine Finset.sum_congr rfl (fun m _ => ?_)
          have hstep : (p : ZMod (p ^ 2)) * (D a * ((m.val : ℕ) : ZMod (p ^ 2)))
              = (p : ZMod (p ^ 2)) * (((P.eval a * m).val : ℕ) : ZMod (p ^ 2)) :=
            mul_prime_eq_of_cast_eq _ _ (by
              rw [map_mul, map_natCast, ZMod.natCast_zmod_val, hcastD, map_natCast,
                ZMod.natCast_zmod_val])
          rw [show D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))
              = (p : ZMod (p ^ 2)) * (D a * ((m.val : ℕ) : ZMod (p ^ 2))) by ring, hstep]
        rw [if_neg hPa, hsub]
        rw [show (∑ m : ZMod p,
              χ (V a + (p : ZMod (p ^ 2)) * (((P.eval a * m).val : ℕ) : ZMod (p ^ 2))))
            = ∑ m' : ZMod p,
                χ (V a + (p : ZMod (p ^ 2)) * ((m'.val : ℕ) : ZMod (p ^ 2))) from
          Fintype.sum_bijective (fun m : ZMod p => P.eval a * m)
            (Equiv.mulLeft₀ (P.eval a) hPa).bijective _ _ (fun _ => rfl)]
        rw [sum_apply_unit_add_prime_mul_eq_zero (p := p) hp hp2 χ hχ (v := V a) hVunit]
        simp
  have hcongr : (∑ a : ZMod p, ∑ m : ZMod p, χ (Polynomial.eval₂
        (Int.castRingHom (ZMod (p ^ 2)))
        ((((a.val : ℕ)) : ZMod (p ^ 2)) + (p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))) F))
      = ∑ a : ZMod p, ∑ m : ZMod p,
          χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2)))) := by
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun m _ => ?_))
    rw [hTay a m]
  have hsum1 : (∑ x : ZMod (p ^ 2), χ (Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2))) x F))
      = ∑ am : ZMod p × ZMod p, χ (Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2)))
          ((((am.1.val : ℕ)) : ZMod (p ^ 2))
            + (p : ZMod (p ^ 2)) * ((am.2.val : ℕ) : ZMod (p ^ 2))) F) :=
    (Fintype.sum_bijective (fun am : ZMod p × ZMod p =>
        (((am.1.val : ℕ)) : ZMod (p ^ 2))
          + (p : ZMod (p ^ 2)) * ((am.2.val : ℕ) : ZMod (p ^ 2)))
      (zmod_sq_digits_bijective p)
      (fun am : ZMod p × ZMod p => χ (Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2)))
          ((((am.1.val : ℕ)) : ZMod (p ^ 2))
            + (p : ZMod (p ^ 2)) * ((am.2.val : ℕ) : ZMod (p ^ 2))) F))
      (fun x : ZMod (p ^ 2) => χ (Polynomial.eval₂ (Int.castRingHom (ZMod (p ^ 2))) x F))
      (fun _ => rfl)).symm
  have hmain : ‖∑ a : ZMod p, ∑ m : ZMod p,
        χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))))‖
      ≤ (P.natDegree : ℝ) * p := by
    calc ‖∑ a : ZMod p, ∑ m : ZMod p,
          χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))))‖
        ≤ ∑ a : ZMod p, ‖∑ m : ZMod p,
            χ (V a + D a * ((p : ZMod (p ^ 2)) * ((m.val : ℕ) : ZMod (p ^ 2))))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ a : ZMod p, (if P.eval a = 0 then (p : ℝ) else 0) :=
          Finset.sum_le_sum (fun a _ => hfiber a)
      _ = (p : ℝ) * ((Finset.univ.filter (fun a : ZMod p => P.eval a = 0)).card : ℝ) := by
          rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
          ring
      _ ≤ (p : ℝ) * (P.natDegree : ℝ) :=
          mul_le_mul_of_nonneg_left (by exact_mod_cast card_roots_le P hP0) (Nat.cast_nonneg p)
      _ = (P.natDegree : ℝ) * p := by ring
  rw [hsum1, Fintype.sum_prod_type]
  simp only []
  rw [hcongr]
  simpa only [hPdef] using hmain


