import Mathlib
import Submission.Work.LinnikBurgess.lf_defs
import Submission.Work.LinnikBurgess.lfSmall.content_dvd_critN

/-!
# `3^J ∣ contAB a b` forces `3^J` to divide every coefficient of the Wronskian

The Wronskian `critN a b = f_a' f_b - f_a f_b'` of the two monic cubics
`f_a = ∏_l (X + a_l)`, `f_b = ∏_l (X + b_l)` has all its coefficients lying in the ideal
generated by the three elementary-symmetric differences `e_k(a) - e_k(b)` (`k = 1,2,3`) — this is
the `p`-independent half of `Work.LinnikBurgess.critN_content_iff`, recorded as
`Work.LinnikBurgess.lfSmall.dvd_coeff_critN_of_dvd_contAB`:

`∀ n, (contAB a b : ℤ) ∣ (critN a b).coeff n`

where `contAB a b = gcd_k |e_k(a) - e_k(b)|` is the content.  Since divisibility by `3^J` of the
content is the input hypothesis, transitivity gives the desired coefficientwise divisibility.

Note that no use is made of the hypothesis that the six shifts `shift a b i` be pairwise
distinct: the statement is an unconditional statement about the content of `critN`, and the
uniqueness hypothesis is carried along only for the use made of the lemma downstream (it is the
`p = 3` analogue of `content_dvd_critN` for `p = 2`).
-/

namespace Work.LinnikBurgess.lfSmall

theorem content_three_ge {a b : Fin 3 → ℕ} (i : Fin 6)
    (hi : ∀ j : Fin 6, j ≠ i → shift a b i ≠ shift a b j) {J : ℕ}
    (hJ : (3 ^ J : ℕ) ∣ contAB a b) :
    ∀ n : ℕ, ((3 ^ J : ℕ) : ℤ) ∣ (critN a b).coeff n :=
  dvd_coeff_critN_of_dvd_contAB (3 ^ J) a b hJ

end Work.LinnikBurgess.lfSmall
