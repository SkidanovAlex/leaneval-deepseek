import Mathlib
import Submission.Work.LinnikBurgess.lfSmall.two_defs
import Submission.Work.LinnikBurgess.critN_shifts
import Submission.Work.LinnikBurgess.critN_content_iff

/-!
# The content of `contAB` divides every coefficient of `critN`

For triples `a b : Fin 3 → ℕ` the content `contAB a b = gcd_k |e_k(a) - e_k(b)|` divides the
content of the Wronskian `critN a b = f_a' f_b - f_a f_b'`, where `f_a = ∏_l (X + a_l)`:

`∀ n, (contAB a b : ℤ) ∣ (critN a b).coeff n`,

whence `2 ^ J ∣ contAB a b` gives `2 ^ J ∣ (critN a b).coeff n` for every `n`.

This is the `p`-independent half of `Work.LinnikBurgess.critN_content_iff` (which requires
`p ≥ 5` only for the converse direction). Writing `f_a = X^3 + A₁X² + A₂X + A₃` the expansion
(`critNcontent.critN_eq_expand`) is

`critN = C(B₁-A₁)X⁴ + C(2(B₂-A₂))X³ + C(-A₂B₁ + A₁B₂ + 3(B₃-A₃))X² + C(2A₁B₃ - 2B₁A₃)X + C(A₂B₃ - B₂A₃)`,

and each displayed coefficient visibly lies in the ideal generated by the three differences
`A₁-B₁`, `A₂-B₂`, `A₃-B₃`, i.e. in the ideal generated by their gcd `contAB a b`. No hypothesis
on `d` (primality, coprimality with `2` or `3`) is needed: only that `d` divides `contAB a b`,
and hence each of the three differences.
-/

namespace Work.LinnikBurgess.lfSmall

open Work.LinnikBurgess.critNcontent

/-- **Every divisor of `contAB a b` divides every coefficient of `critN a b`.**

This is the backward (easy) direction of `critN_content_iff`, valid for an arbitrary modulus. -/
theorem dvd_coeff_critN_of_dvd_contAB (d : ℕ) (a b : Fin 3 → ℕ) (hd : d ∣ contAB a b) :
    ∀ n, (d : ℤ) ∣ (critN a b).coeff n := by
  have hd0 : d ∣ (esymm3 a 0 - esymm3 b 0).natAbs ∧ d ∣ (esymm3 a 1 - esymm3 b 1).natAbs
      ∧ d ∣ (esymm3 a 2 - esymm3 b 2).natAbs := by
    rw [contAB_eq, Nat.dvd_gcd_iff, Nat.dvd_gcd_iff] at hd
    exact ⟨hd.1, hd.2.1, hd.2.2⟩
  obtain ⟨hd1, hd2, hd3⟩ := hd0
  have hD1 : (d : ℤ) ∣ esymm3 a 0 - esymm3 b 0 := (nat_dvd_natAbs_iff d _).mp hd1
  have hD2 : (d : ℤ) ∣ esymm3 a 1 - esymm3 b 1 := (nat_dvd_natAbs_iff d _).mp hd2
  have hD3 : (d : ℤ) ∣ esymm3 a 2 - esymm3 b 2 := (nat_dvd_natAbs_iff d _).mp hd3
  intro n
  rcases lt_or_ge n 5 with hn | hn
  · interval_cases n
    · -- degree 0: `A₂B₃ - B₂A₃ = (A₂-B₂)B₃ - B₂(A₃-B₃)`
      rw [critN_eq_expand, coeff_zero_exp]
      have hsplit : esymm3 a 1 * esymm3 b 2 - esymm3 b 1 * esymm3 a 2
          = (esymm3 a 1 - esymm3 b 1) * esymm3 b 2
            - esymm3 b 1 * (esymm3 a 2 - esymm3 b 2) := by ring
      rw [hsplit]
      exact dvd_sub (dvd_mul_of_dvd_left hD2 _) (dvd_mul_of_dvd_right hD3 _)
    · -- degree 1: `2A₁B₃ - 2B₁A₃ = 2((A₁-B₁)B₃ - B₁(A₃-B₃))`
      rw [critN_eq_expand, coeff_one_exp]
      have hsplit : 2 * esymm3 a 0 * esymm3 b 2 - 2 * esymm3 b 0 * esymm3 a 2
          = 2 * ((esymm3 a 0 - esymm3 b 0) * esymm3 b 2
            - esymm3 b 0 * (esymm3 a 2 - esymm3 b 2)) := by ring
      rw [hsplit]
      exact dvd_mul_of_dvd_right
        (dvd_sub (dvd_mul_of_dvd_left hD1 _) (dvd_mul_of_dvd_right hD3 _)) 2
    · -- degree 2: `-A₂B₁ + A₁B₂ + 3(B₃-A₃) = (A₁-B₁)B₂ - (A₂-B₂)B₁ - 3(A₃-B₃)`
      rw [critN_eq_expand, coeff_two_exp]
      have hsplit : -esymm3 a 1 * esymm3 b 0 + esymm3 a 0 * esymm3 b 1
            + 3 * (esymm3 b 2 - esymm3 a 2)
          = (esymm3 a 0 - esymm3 b 0) * esymm3 b 1
            - (esymm3 a 1 - esymm3 b 1) * esymm3 b 0
            - 3 * (esymm3 a 2 - esymm3 b 2) := by ring
      rw [hsplit]
      exact dvd_sub (dvd_sub (dvd_mul_of_dvd_left hD1 _) (dvd_mul_of_dvd_left hD2 _))
        (dvd_mul_of_dvd_right hD3 3)
    · -- degree 3: `2(B₂-A₂) = -(A₂-B₂) * 2`
      rw [critN_eq_expand, coeff_three_exp]
      have hsplit : 2 * (esymm3 b 1 - esymm3 a 1) = -(esymm3 a 1 - esymm3 b 1) * 2 := by ring
      rw [hsplit]
      exact dvd_mul_of_dvd_left (dvd_neg.mpr hD2) 2
    · -- degree 4: `B₁ - A₁ = -(A₁ - B₁)`
      rw [critN_eq_expand, coeff_four_exp]
      have hx := (dvd_neg).mpr hD1
      rwa [neg_sub] at hx
  · -- `critN` has degree at most 4, so all higher coefficients vanish
    rw [critN_eq_expand, coeff_of_ge_five hn]
    exact dvd_zero _

theorem content_dvd_critN {J : ℕ} (a b : Fin 3 → ℕ) (hJ : 2 ^ J ∣ contAB a b) :
    ∀ n, ((2 ^ J : ℕ) : ℤ) ∣ (critN a b).coeff n :=
  dvd_coeff_critN_of_dvd_contAB (2 ^ J) a b hJ

end Work.LinnikBurgess.lfSmall
