/-! ## The rational arithmetic of the certificate -/

/-- Upper bound of HB's per-character bound `B(K,λ) = (1-e^{-2Kλ})/(6K²λ) + (2Kλ-1+e^{-2Kλ})/(2K²λ²)`
from an enclosure `Glo ≤ e^{-2Kλ} ≤ Ghi`. -/
def Bup (K x Glo Ghi : ℚ) : ℚ := (1 - Glo)/(6*K^2*x) + (2*K*x - 1 + Ghi)/(2*K^2*x^2)

/-- Lower bound of the same expression. -/
def Bdn (K x Glo Ghi : ℚ) : ℚ := (1 - Ghi)/(6*K^2*x) + (2*K*x - 1 + Glo)/(2*K^2*x^2)

/-- Upper bound of `((1-e^{-Kx})/x)^2` from `Alo ≤ e^{-Kx}`. -/
def F2u (x Alo : ℚ) : ℚ := ((1 - Alo)/x)^2

/-- Lower bound of `((1-e^{-Kx})/x)^2` from `e^{-Kx} ≤ Ahi`. -/
def F2d (x Ahi : ℚ) : ℚ := ((1 - Ahi)/x)^2

/-- Upper bound of `w(x) = x/(e^{73x/30}-e^{16x/15}) = x e^{-73x/30}/(1-e^{-41x/30})`
from `Phi ≥ e^{-73x/30}` and `Qhi ≥ e^{-41x/30}`. -/
def wu (x Phi Qhi : ℚ) : ℚ := x*Phi/(1 - Qhi)

/-- Lower bound of `w(x)`. -/
def wd (x Plo Qlo : ℚ) : ℚ := x*Plo/(1 - Qlo)

/-- `max 0 (EBx - EBL·wx/wL)`: an upper (resp. lower) bound of
`C(x) = max(0, E(x)B(x) - E(Λ)B(Λ)w(x)/w(Λ))` when the arguments are upper (resp. lower)
bounds of `E(x)B(x)`, `E(Λ)B(Λ)`, `w(x)`, `w(Λ)`. -/
def Cb (EBx EBL wx wL : ℚ) : ℚ := max 0 (EBx - EBL*wx/wL)

/-- Multiply a (possibly negative) coefficient by the appropriate end of an interval. -/
def coefMul (c lo hi : ℚ) : ℚ := if c < 0 then c*lo else c*hi

