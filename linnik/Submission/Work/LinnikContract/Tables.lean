/-! ### Coercion lemmas -/

/-- `(rows15q, rows14q, table13q)` are the rational presentations of `(rows15, rows14, table13)`. -/
theorem tables_coe :
    rows15q.map (fun r => ((r.1 : ℝ), (r.2.1 : ℝ), (r.2.2.1 : ℝ), (r.2.2.2.1 : ℝ),
        (r.2.2.2.2 : ℝ))) = rows15 ∧
    rows14q.map (fun r => ((r.1 : ℝ), (r.2.1 : ℝ), (r.2.2 : ℝ))) = rows14 ∧
    table13q.map (fun e => ((e.1 : ℝ), (e.2.1 : ℝ), e.2.2)) = table13 := by
  refine ⟨?_, ?_, ?_⟩ <;>
  · simp only [rows15q, rows14q, table13q, rows15, rows14, table13, List.map_cons, List.map_nil,
      List.cons.injEq, Prod.mk.injEq]
    constructor <;> [skip; constructor] <;> norm_num

