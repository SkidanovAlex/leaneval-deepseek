/-- Rational lower bounds for `exp` at the nine grid arguments `0, 3/10, 3/5, 9/10, 6/5, 3/2,
9/5, 21/10, 17/8`; companion of `exp_bounds`, proved from the Taylor lower bound
`Real.sum_le_exp_of_nonneg`.  (Stated here rather than imported from `exp_bounds_lo` so that this
module is free of `sorry`.) -/
private theorem exp_lo_grid :
    (1:ℝ) ≤ Real.exp (0:ℝ) ∧
    (134985/100000 : ℝ) ≤ Real.exp ((3:ℝ)/10) ∧
    (182211/100000 : ℝ) ≤ Real.exp ((3:ℝ)/5) ∧
    (245960/100000 : ℝ) ≤ Real.exp ((9:ℝ)/10) ∧
    (332011/100000 : ℝ) ≤ Real.exp ((6:ℝ)/5) ∧
    (448168/100000 : ℝ) ≤ Real.exp ((3:ℝ)/2) ∧
    (604964/100000 : ℝ) ≤ Real.exp ((9:ℝ)/5) ∧
    (816616/100000 : ℝ) ≤ Real.exp ((21:ℝ)/10) ∧
    (837289/100000 : ℝ) ≤ Real.exp ((17:ℝ)/8) := by
  refine ⟨le_of_eq Real.exp_zero.symm, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals
    exact le_trans (by norm_num [Finset.sum_range_succ])
      (Real.sum_le_exp_of_nonneg (by norm_num) 20)

/-- Assembly of `Isub_le_cornerB` with the numeric check `cornerB ... ≤ -7/200` at one cell. -/
private lemma cell (s σ Elo Ehi c0 c1 t0 t1 : ℝ) (hs0 : 0 ≤ s) (hσ : σ ≠ 0)
    (hElo : Elo ≤ Real.exp (2 * s)) (hEhi : Real.exp (2 * s) ≤ Ehi)
    (hc0 : c0 ≤ Real.cos (2 * σ)) (hc1 : Real.cos (2 * σ) ≤ c1)
    (ht0 : t0 ≤ Real.sin (2 * σ)) (ht1 : Real.sin (2 * σ) ≤ t1)
    (hB : cornerB s σ Elo Ehi c0 c1 t0 t1 ≤ (-7/200 : ℝ)) :
    Work.ZeroFreeTables.OffAxis.Isub s σ ≤ (-7/200 : ℝ) :=
  le_trans (Isub_le_cornerB s σ Elo Ehi c0 c1 t0 t1 hs0 hσ hElo hEhi hc0 hc1 ht0 ht1) hB

