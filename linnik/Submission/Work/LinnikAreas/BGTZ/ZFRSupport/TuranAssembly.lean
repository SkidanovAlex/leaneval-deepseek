  have hy' : (1 - ρ₂.re) ≥ 3 * Real.log (3 / (72 * (J : ℝ) * (1 - ρ₀.re))) / (4 * (J : ℝ)) := by
    rw [hlogeq]
    exact hy
  have hfin := repelFinalArith (A := 3 / (8 * JB)) (JB := JB) (L := L) (x := 1 - ρ₀.re)
    (y := 1 - ρ₂.re) (J := (J : ℝ)) hJBpos rfl hL1 (by exact_mod_cast hJ1) hx hJ24 hJle hy'
  -- final bookkeeping
  have h1 : Real.log (3 / (144 * JB))
