/-- **Final arithmetic of the repulsion.**  If the power-sum argument gives
`A·log(1/λ₀) - B ≤ λ'` and `λ₀ ≤ λ'`, then an explicit positive constant suffices. -/
theorem repelArith {A B lam0 lam' : ℝ} (hA : 0 < A) (hlam0 : 0 < lam0) (hlam01 : lam0 ≤ 1)
    (hmin : lam0 ≤ lam') (hmain : A * Real.log (1 / lam0) - B ≤ lam') :
    min (A / 2) (A / (2 * (max (max B 0) 1)) * Real.exp (-(2 * (max (max B 0) 1) / A)))
        * Real.log (1 / lam0) ≤ lam' := by
  obtain ⟨b, hbdef⟩ : ∃ b : ℝ, b = max (max B 0) 1 := ⟨_, rfl⟩
  have hb1 : 1 ≤ b := by rw [hbdef]; exact le_max_right _ _
  have hb0 : 0 < b := lt_of_lt_of_le zero_lt_one hb1
  have hbB : B ≤ b := by rw [hbdef]; exact le_trans (le_max_left B 0) (le_max_left _ _)
  have hlog0 : 0 ≤ Real.log (1 / lam0) := by
    apply Real.log_nonneg
    rw [le_div_iff₀ hlam0]; linarith
  rcases le_total (2 * b / A) (Real.log (1 / lam0)) with hle | hlt
  · have hstep : (A / 2) * Real.log (1 / lam0) ≤ lam' := by
      have h2 : b ≤ (A / 2) * Real.log (1 / lam0) := by
        have h3 : 2 * b ≤ Real.log (1 / lam0) * A := (div_le_iff₀ hA).mp hle
        have h4 : b ≤ Real.log (1 / lam0) * A / 2 := by linarith
        calc b ≤ Real.log (1 / lam0) * A / 2 := h4
          _ = (A / 2) * Real.log (1 / lam0) := by ring
      have h3 : A * Real.log (1 / lam0) - (A / 2) * Real.log (1 / lam0) ≤ lam' := by
        linarith [hmain, h2, hbB]
      have h4 : A * Real.log (1 / lam0) - (A / 2) * Real.log (1 / lam0)
          = (A / 2) * Real.log (1 / lam0) := by ring
      linarith [h3, h4]
    calc min (A / 2) (A / (2 * (max (max B 0) 1)) * Real.exp (-(2 * (max (max B 0) 1) / A)))
          * Real.log (1 / lam0)
        = min (A / 2) (A / (2 * b) * Real.exp (-(2 * b / A))) * Real.log (1 / lam0) := by
          rw [hbdef]
      _ ≤ (A / 2) * Real.log (1 / lam0) :=
          mul_le_mul_of_nonneg_right (min_le_left _ _) hlog0
      _ ≤ lam' := hstep
  · have hexp : Real.exp (-(2 * b / A)) ≤ lam0 := by
      have h2 : -(2 * b / A) ≤ Real.log lam0 := by
        rw [Real.log_div one_ne_zero (ne_of_gt hlam0), Real.log_one, zero_sub] at hlt
        linarith [hlt]
      have h3 := Real.exp_le_exp.mpr h2
      rwa [Real.exp_log hlam0] at h3
    have h4 : A / (2 * b) * Real.exp (-(2 * b / A)) * (2 * b / A)
        = Real.exp (-(2 * b / A)) := by
      field_simp
    have hc : (0 : ℝ) ≤ A / (2 * b) * Real.exp (-(2 * b / A)) := by positivity
    have h5 : A / (2 * b) * Real.exp (-(2 * b / A)) * Real.log (1 / lam0)
        ≤ Real.exp (-(2 * b / A)) := by
      calc A / (2 * b) * Real.exp (-(2 * b / A)) * Real.log (1 / lam0)
          ≤ A / (2 * b) * Real.exp (-(2 * b / A)) * (2 * b / A) :=
            mul_le_mul_of_nonneg_left hlt hc
        _ = Real.exp (-(2 * b / A)) := h4
    calc min (A / 2) (A / (2 * (max (max B 0) 1)) * Real.exp (-(2 * (max (max B 0) 1) / A)))
          * Real.log (1 / lam0)
        = min (A / 2) (A / (2 * b) * Real.exp (-(2 * b / A))) * Real.log (1 / lam0) := by
          rw [hbdef]
      _ ≤ A / (2 * b) * Real.exp (-(2 * b / A)) * Real.log (1 / lam0) :=
          mul_le_mul_of_nonneg_right (min_le_right _ _) hlog0
      _ ≤ Real.exp (-(2 * b / A)) := h5
      _ ≤ lam0 := hexp
      _ ≤ lam' := hmin

end Work.LinnikAreas

