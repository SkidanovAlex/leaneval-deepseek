open Work.LinnikContract

/-- **The Turán/Hadamard step for the other-character repulsion.**  Given a character `χ` with a
zero `ρ₂` of minimal `λ` in its strip, the twisted power-sum argument bounds `1 - Re ρ₂` from
below. -/
theorem turanStep {q : ℕ} [NeZero q] (hU : TuranOther.TwUpperCore) (C : ℝ) (hCpos : 0 < C)
    (hMassB : ∀ (χ₀ χ : DirichletCharacter ℂ q) (β₀ γ α : ℝ),
      1 ≤ α → α ≤ 100 → |γ| ≤ 2 →
      Summable (fun u : ℂ => ((TuranOther.twMult χ₀ χ β₀ γ u : ℕ) : ℝ) / ‖(1 + (α : ℂ)) - u‖ ^ 2) ∧
        (∑' u : ℂ, ((TuranOther.twMult χ₀ χ β₀ γ u : ℕ) : ℝ) / ‖(1 + (α : ℂ)) - u‖ ^ 2)
          ≤ C * (Real.log (q : ℝ) + 1))
    (hArith : ∀ {α ε β β₀ : ℝ} {j J : ℕ}, 1 ≤ α → 0 < ε → 1 ≤ J → 1 ≤ j →
      (j : ℝ) ≤ (J : ℝ) → β ≤ 1 → β₀ < 1 →
      ((32 + 4 * ε) * 2 * Real.exp 1 * (J : ℝ) * (1 - β₀) ≤ ε * α) →
      (ε / (32 + 4 * ε)) * (1 / (1 + α - β) ^ (2 * j)) ≤
          1 / α ^ (2 * j) - (1 / (1 + α - β₀)) ^ (2 * j) →
      1 - β ≥ α * Real.log (ε * α / ((32 + 4 * ε) * 2 * (J : ℝ) * (1 - β₀))) / (4 * J))
    (hMult : ∀ (χ : DirichletCharacter ℂ q), χ ≠ 1 → ∀ {u : ℂ}, 0 < u.re →
      Work.LinnikContract.zeroMult χ u ≠ 0 → TuranOther.multL χ u ≠ 0)
    (χ₀ χ : DirichletCharacter ℂ q) (ρ₀ ρ₂ : ℂ)
    (h₀ne : χ₀ ≠ 1) (h₀sq : χ₀ * χ₀ = 1) (hχne : χ ≠ 1) (hχ₀χ : χ₀ * χ ≠ 1)
    (hβ₀ : DirichletCharacter.LFunction χ₀ ((ρ₀.re : ℂ)) = 0)
    (hρ₀im : ρ₀.im = 0) (hρ₀pos : 0 < ρ₀.re) (hρ₀lt : ρ₀.re < 1)
    (hρ₂zm : Work.LinnikContract.zeroMult χ ρ₂ ≠ 0)
    (hρ₂im : |ρ₂.im| ≤ 1) (hρ₂pos : 0 < ρ₂.re) (hρ₂lt : ρ₂.re < 1)
    (hβ₂ne : ρ₂.re ≠ ρ₀.re)
    (hlamsmall : (1 - ρ₀.re) * Real.log (q : ℝ) ≤
      min (1 / 2) (1 * 3 / ((32 + 4 * 1) * 4 * Real.exp 1
        * ((8 + 1) * (1 + 3) ^ 2 * C + 1))))
    (hlogq1 : 1 ≤ Real.log (q : ℝ)) :
    (1 - ρ₂.re) * Real.log (q : ℝ) ≥
      (3 / (8 * ((8 + 1) * (1 + 3) ^ 2 * C + 1)))
        * Real.log (1 / ((1 - ρ₀.re) * Real.log (q : ℝ)))
      + (3 / (8 * ((8 + 1) * (1 + 3) ^ 2 * C + 1)))
        * Real.log (1 * 3 / ((32 + 4 * 1) * 4 * ((8 + 1) * (1 + 3) ^ 2 * C + 1))) := by
  classical
  obtain ⟨γ, hγdef⟩ : ∃ γ : ℝ, γ = ρ₂.im := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = Real.log (q : ℝ) := ⟨_, rfl⟩
  obtain ⟨JB, hJBdef⟩ : ∃ JB : ℝ, JB = (8 + 1) * (1 + 3) ^ 2 * C + 1 := ⟨_, rfl⟩
  have hJBpos : 0 < JB := by rw [hJBdef]; positivity
  have hL1 : 1 ≤ L := by rw [hLdef]; exact hlogq1
  have hLpos : 0 < L := by linarith
  -- the designated point `ρ₂.re` lies in the zero multiset of the twisted product
  have hsupp : TuranOther.twMult χ₀ χ ρ₀.re γ (ρ₂.re : ℂ) ≠ 0 := by
    have h0 : (ρ₂.re : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hρ₂pos)
    have hβ : (ρ₂.re : ℂ) ≠ (ρ₀.re : ℂ) := by
      intro h
      exact hβ₂ne (Complex.ofReal_injective h)
    rw [TuranOther.twMult_eq_sum χ₀ χ ρ₀.re γ h0 hβ]
    have hc : TuranOther.multL χ ((ρ₂.re : ℂ) + Complex.I * (γ : ℂ)) ≠ 0 := by
      have hρ₂eq : (ρ₂.re : ℂ) + Complex.I * (γ : ℂ) = ρ₂ := by
        rw [hγdef, mul_comm]
        exact Complex.re_add_im ρ₂
      rw [hρ₂eq]
      exact hMult χ hχne hρ₂pos hρ₂zm
    intro hsum
    have hc2 : TuranOther.multL χ ((ρ₂.re : ℂ) + Complex.I * (γ : ℂ)) = 0 := by omega
    exact hc hc2
  obtain ⟨u₀, hu₀, hzu₀, hmaxu⟩ :=
    TuranOther.twMultMax χ₀ χ ρ₀.re γ 3 (by norm_num) ⟨(ρ₂.re : ℂ), hsupp⟩
  have hmaxz : ∀ u : ℂ,
      ‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u‖ ≤ ‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u₀‖ := by
    intro u
    by_cases hu : TuranOther.twMult χ₀ χ ρ₀.re γ u = 0
    · rw [TuranOther.twZ, if_pos hu, norm_zero]
      exact norm_nonneg _
    · rw [TuranOther.twZ, if_neg hu, TuranOther.twZ, if_neg hu₀]
      exact hmaxu u hu
  have hval : 1 / (4 - ρ₂.re) ^ 2 ≤ ‖TuranOther.zval 3 u₀‖ := by
    have hmax' := hmaxu (ρ₂.re : ℂ) hsupp
    have hnorm : ‖TuranOther.zval 3 (ρ₂.re : ℂ)‖ = 1 / (4 - ρ₂.re) ^ 2 := by
      rw [TuranOther.norm_zval_eq]
      have hcast : (1 : ℂ) + ((3 : ℝ) : ℂ) - (ρ₂.re : ℂ) = ((4 - ρ₂.re : ℝ) : ℂ) := by
        push_cast; ring
      rw [hcast]
      have h1 : ‖((4 - ρ₂.re : ℝ) : ℂ)‖ ^ 2 = (4 - ρ₂.re) ^ 2 := by
        rw [← Complex.normSq_eq_norm_sq, Complex.normSq_ofReal]
        ring
      have h2 : ‖((4 - ρ₂.re : ℝ) : ℂ)‖ = 4 - ρ₂.re := by
        nlinarith [h1, norm_nonneg ((4 - ρ₂.re : ℝ) : ℂ), hρ₂lt]
      rw [h2]
    rw [hnorm] at hmax'
    exact hmax'
  have hsq : ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 ≤ 16 := by
    have hzu0pos : 0 < ‖TuranOther.zval 3 u₀‖ := norm_pos_iff.mpr hzu₀
    have h2 : 1 / (4 - ρ₂.re) ^ 2 ≤ 1 / ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 := by
      rw [← TuranOther.norm_zval_eq 3 u₀]
      exact hval
    have hp : 0 < (4 - ρ₂.re) ^ 2 := pow_pos (by linarith : (0 : ℝ) < 4 - ρ₂.re) 2
    have hz0 : 0 < ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 := by
      have h := hzu0pos
      rw [TuranOther.norm_zval_eq] at h
      exact (one_div_pos).mp h
    have h2' : ((4 - ρ₂.re) ^ 2)⁻¹ ≤ (‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2)⁻¹ := by
      simpa [one_div] using h2
    have h4 : ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 ≤ (4 - ρ₂.re) ^ 2 :=
      (inv_le_inv₀ hp hz0).mp h2'
    nlinarith [h4, hρ₂pos]
  -- the mass hypothesis at the chosen parameters
  have hγ2 : |γ| ≤ 2 := by rw [hγdef]; linarith [abs_nonneg ρ₂.im]
  obtain ⟨hmassSumm, hmassBnd⟩ :=
    hMassB χ₀ χ ρ₀.re γ 3 (by norm_num) (by norm_num) hγ2
  -- the mass part of `twAuxBounds` (independent of `j`)
  obtain ⟨hWeylSumm, hWeylBnd, -, -⟩ :=
    TuranOther.twAuxBounds χ₀ χ ρ₀.re γ 3 (by norm_num) C ⟨hmassSumm, hmassBnd⟩ u₀ hu₀ hmaxu 1
      (by norm_num)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = ∑' u : ℂ,
      ((TuranOther.twMult χ₀ χ ρ₀.re γ u : ℕ) : ℝ) *
      (‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u‖
        / (‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u₀‖ + ‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u‖)) :=
    ⟨_, rfl⟩
  have hMnn : 0 ≤ M := by
    rw [hMdef]
    exact tsum_nonneg (fun u => mul_nonneg (Nat.cast_nonneg _) (by positivity))
  have hMle : M ≤ 16 * C * (L + 1) := by
    rw [hMdef]
    have h1 : ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 * (C * (Real.log (q : ℝ) + 1))
        ≤ 16 * C * (L + 1) := by
      have h2 : (C * (Real.log (q : ℝ) + 1)) * ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2
          ≤ (C * (Real.log (q : ℝ) + 1)) * 16 :=
        mul_le_mul_of_nonneg_left hsq (by positivity)
      have h3 : (C * (Real.log (q : ℝ) + 1)) * 16 = 16 * C * (L + 1) := by
        rw [hLdef]; ring
      calc ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 * (C * (Real.log (q : ℝ) + 1))
          = (C * (Real.log (q : ℝ) + 1)) * ‖(1 : ℂ) + ((3 : ℝ) : ℂ) - u₀‖ ^ 2 := by ring
        _ ≤ (C * (Real.log (q : ℝ) + 1)) * 16 := h2
        _ = 16 * C * (L + 1) := h3
    linarith [hWeylBnd, h1]
  -- Turán's theorem
  have hwi₀ : 1 ≤ ((TuranOther.twMult χ₀ χ ρ₀.re γ u₀ : ℕ) : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero hu₀
  have hw : ∀ u : ℂ, 0 ≤ ((TuranOther.twMult χ₀ χ ρ₀.re γ u : ℕ) : ℝ) :=
    fun u => Nat.cast_nonneg _
  have hzi₀ : TuranOther.twZ χ₀ χ ρ₀.re γ 3 u₀ ≠ 0 := by
    rw [TuranOther.twZ, if_neg hu₀]; exact hzu₀
  obtain ⟨j, hj1, hjle, hjbound⟩ :=
    DhK.turanWeighted 1 one_pos (fun u : ℂ => ((TuranOther.twMult χ₀ χ ρ₀.re γ u : ℕ) : ℝ))
      (fun u : ℂ => TuranOther.twZ χ₀ χ ρ₀.re γ 3 u) u₀ hwi₀ hw hzi₀ hmaxz hWeylSumm
  -- the power-sum part of `twAuxBounds` at `j`
  obtain ⟨-, -, hPowSumm, hPowRe⟩ :=
    TuranOther.twAuxBounds χ₀ χ ρ₀.re γ 3 (by norm_num) C ⟨hmassSumm, hmassBnd⟩ u₀ hu₀ hmaxu j hj1
  have hjbound' : (1 / (32 + 4 * 1)) * ‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u₀‖ ^ j
      ≤ TuranOther.twSum χ₀ χ ρ₀.re γ 3 j := by
    rw [← hPowRe]
    exact hjbound
  have hupper : TuranOther.twSum χ₀ χ ρ₀.re γ 3 j
      ≤ 1 / 3 ^ (2 * j) - (1 / (1 + 3 - ρ₀.re)) ^ (2 * j) :=
    hU q χ₀ χ h₀ne h₀sq hχne hχ₀χ ρ₀.re hβ₀ 3 (by norm_num) γ j hj1
  have hmain : (1 / (32 + 4 * 1)) * (1 / (1 + 3 - ρ₂.re) ^ (2 * j))
      ≤ 1 / 3 ^ (2 * j) - (1 / (1 + 3 - ρ₀.re)) ^ (2 * j) := by
    have hkey : (1 / (4 - ρ₂.re)) ^ (2 * j) ≤ ‖TuranOther.zval 3 u₀‖ ^ j := by
      have hpow : (1 / (4 - ρ₂.re)) ^ (2 * j) = (1 / (4 - ρ₂.re) ^ 2) ^ j := by
        rw [one_div_pow, one_div_pow, ← pow_mul]
      rw [hpow]
      exact pow_le_pow_left₀ (by positivity) hval j
    have hlow : (1 / (32 + 4 * 1)) * (1 / (1 + 3 - ρ₂.re) ^ (2 * j))
        ≤ (1 / (32 + 4 * 1)) * ‖TuranOther.zval 3 u₀‖ ^ j := by
      rw [show (1 / (1 + 3 - ρ₂.re) ^ (2 * j)) = (1 / (4 - ρ₂.re)) ^ (2 * j) by
        congr 2
        ring]
      exact mul_le_mul_of_nonneg_left hkey (by norm_num)
    have hlow' : (1 / (32 + 4 * 1)) * ‖TuranOther.zval 3 u₀‖ ^ j
        = (1 / (32 + 4 * 1)) * ‖TuranOther.twZ χ₀ χ ρ₀.re γ 3 u₀‖ ^ j := by
      rw [TuranOther.twZ, if_neg hu₀]
    rw [hlow'] at hlow
    linarith [hlow, hjbound', hupper]
  -- the choice of the interpolation node
  have hJB9 : JB = 9 * 16 * C + 1 := by rw [hJBdef]; ring
  have hx : 0 < 1 - ρ₀.re := by linarith
  have hxL : (1 - ρ₀.re) * L ≤ min (1 / 2) (3 / ((32 + 4 * 1) * 4 * Real.exp 1 * JB)) := by
    rw [hLdef, hJBdef]
    simpa using hlamsmall
  obtain ⟨J, hJ1, hJ24, hJle, hJj⟩ :=
    TuranOther.chooseJ hCpos hJB9 hL1 hMnn hMle hx hxL
  have hjle' : (j : ℝ) ≤ 9 * M := by
    have h89 : (8 : ℝ) + 1 = 9 := by norm_num
    rw [hMdef, ← h89]
    exact hjle
  have hxL48 : (1 - ρ₀.re) * L ≤ 1 / (48 * Real.exp 1 * JB) := by
    have h := le_trans hxL (min_le_right (1 / 2) (3 / ((32 + 4 * 1) * 4 * Real.exp 1 * JB)))
    have heq : 3 / ((32 + 4 * 1) * 4 * Real.exp 1 * JB) = 1 / (48 * Real.exp 1 * JB) := by
      rw [div_eq_div_iff (by positivity) (by positivity)]
      ring
    linarith [h, heq]
  have hJ24e : (J : ℝ) * (1 - ρ₀.re) ≤ 1 / (24 * Real.exp 1) := by
    calc (J : ℝ) * (1 - ρ₀.re) ≤ (2 * JB * L) * (1 - ρ₀.re) :=
          mul_le_mul_of_nonneg_right hJle (by linarith)
      _ = 2 * JB * ((1 - ρ₀.re) * L) := by ring
      _ ≤ 2 * JB * (1 / (48 * Real.exp 1 * JB)) :=
          mul_le_mul_of_nonneg_left hxL48 (by positivity)
      _ = 1 / (24 * Real.exp 1) := by field_simp; ring
  have hreg : (32 + 4 * 1) * 2 * Real.exp 1 * (J : ℝ) * (1 - ρ₀.re) ≤ 1 * 3 := by
    have he : (0 : ℝ) < Real.exp 1 := Real.exp_pos 1
    have h2 : Real.exp 1 * ((J : ℝ) * (1 - ρ₀.re)) ≤ 1 / 24 := by
      calc Real.exp 1 * ((J : ℝ) * (1 - ρ₀.re)) ≤ Real.exp 1 * (1 / (24 * Real.exp 1)) :=
            mul_le_mul_of_nonneg_left hJ24e (le_of_lt he)
        _ = 1 / 24 := by field_simp
    nlinarith [h2]
  have hjJ : (j : ℝ) ≤ (J : ℝ) := hJj j hjle'
  have hy := hArith (α := (3 : ℝ)) (ε := (1 : ℝ)) (β := ρ₂.re) (β₀ := ρ₀.re) (j := j) (J := J)
    (by norm_num) one_pos hJ1 hj1 hjJ (le_of_lt hρ₂lt) hρ₀lt hreg hmain
  have hlogeq : 3 / (72 * (J : ℝ) * (1 - ρ₀.re))
