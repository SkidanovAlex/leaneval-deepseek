noncomputable section

namespace Work.LinnikAreas.TuranOther

/-- The Hadamard-product upper bound for the twisted power sum. -/
def TwUpperCore : Prop :=
  ∀ (q : ℕ) [NeZero q] (χ₀ χ : DirichletCharacter ℂ q),
    χ₀ ≠ 1 → χ₀ * χ₀ = 1 → χ ≠ 1 → χ₀ * χ ≠ 1 → ∀ (β₀ : ℝ),
      DirichletCharacter.LFunction χ₀ ((β₀ : ℝ) : ℂ) = 0 → ∀ (α : ℝ), 1 ≤ α → ∀ (γ : ℝ) (j : ℕ),
        1 ≤ j → twSum χ₀ χ β₀ γ α j ≤ 1 / α ^ (2 * j) - (1 / (1 + α - β₀)) ^ (2 * j)

/-- The mass (inverse-square zero sum) bound, with summability. -/
def TwMassCore : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q] (χ₀ χ : DirichletCharacter ℂ q) (β₀ γ α : ℝ),
    1 ≤ α → α ≤ 100 → |γ| ≤ 2 →
    Summable (fun u : ℂ => ((twMult χ₀ χ β₀ γ u : ℕ) : ℝ) / ‖(1 + (α : ℂ)) - u‖ ^ 2) ∧
      (∑' u : ℂ, ((twMult χ₀ χ β₀ γ u : ℕ) : ℝ) / ‖(1 + (α : ℂ)) - u‖ ^ 2)
        ≤ C * (Real.log (q : ℝ) + 1)

end Work.LinnikAreas.TuranOther

