import Mathlib

/-!
# The mapping cylinder of a continuous map

`Work.Serre.serreC1` (C1 of the Serre blueprint) needs the *homology Whitehead theorem* for the
π-isomorphism `S¹ → X` of a `K(ℤ,1)`: a map which is a bijection on all homotopy groups induces a
bijection on homology.  The route taken here is the one of blueprint ADDENDUM 2, K2: replace `f` by
the inclusion of the source into its **mapping cylinder** `cyl f`, whose target copy is a homotopy
equivalence, and apply the relative cone construction (`SerreE2b`) to the pair
`(cyl f, range (cylIncl f))`.

This file fixes the construction:

* `cylRel f`, `cyl f` — the mapping cylinder of `f : C(P,X)` as the quotient of
  `(P × I) ⊕ X` by the relation generated by `(p, 1) ~ f p`;
* `cylIncl f : C(P, cyl f)` — the source, at the *bottom* `P × {0}` of the cylinder;
* `cylInr f : C(X, cyl f)` — the target copy;
* `cylRetract f : C(cyl f, X)` — the retraction onto the target copy, with
  `cylRetract f ∘ cylIncl f = f`.

The three properties of the construction needed downstream are delegated (they are stated in the
sibling files `CylHomeo.lean`, `CylHomotopyEquiv.lean`, `CylConnected.lean`):

* the bottom copy of `P` is *homeomorphic* to `P` (so that the pair
  `(cyl f, range (cylIncl f))` has the homotopy type of `(X, S¹)`);
* `cyl f` is homotopy equivalent to `X`;
* every point of `cyl f` is joined to the bottom copy by a path (the `0`-connectivity of the pair).
-/

open scoped Topology unitInterval

namespace Work.Serre

noncomputable section

variable {P X : Type} [TopologicalSpace P] [TopologicalSpace X]

/-- The gluing relation of the mapping cylinder: the top circle `P × {1}` of the cylinder `P × I` is
identified with the target along `f`. -/
def cylRel (f : C(P, X)) : (P × unitInterval) ⊕ X → (P × unitInterval) ⊕ X → Prop :=
  fun a b => ∃ p : P, a = Sum.inl (p, 1) ∧ b = Sum.inr (f p)

/-- **The mapping cylinder of `f`**: the quotient of the disjoint union of the cylinder `P × I` and
the target `X` obtained by gluing the top circle `P × {1}` to `X` along `f`. -/
abbrev cyl (f : C(P, X)) : Type := Quotient (Relation.EqvGen.setoid (cylRel f))

/-- The source of `f`, placed at the bottom `P × {0}` of the cylinder. -/
def cylIncl (f : C(P, X)) : C(P, cyl f) where
  toFun p := Quotient.mk'' (Sum.inl (p, 0))
  continuous_toFun :=
    continuous_quotient_mk'.comp (continuous_inl.comp (continuous_id.prodMk continuous_const))

/-- The target of `f`, placed as a copy inside the mapping cylinder. -/
def cylInr (f : C(P, X)) : C(X, cyl f) where
  toFun x := Quotient.mk'' (Sum.inr x)
  continuous_toFun := continuous_quotient_mk'.comp continuous_inr

/-- The quotient map defining the mapping cylinder. -/
def cylMk (f : C(P, X)) : (P × unitInterval) ⊕ X → cyl f := Quotient.mk''

/-- The gluing relation of the mapping cylinder, at the level of points: the top of the cylinder is
the target copy. -/
theorem cyl_mk_inl_one (f : C(P, X)) (p : P) :
    Quotient.mk'' (Sum.inl (p, 1) : (P × unitInterval) ⊕ X) = cylInr f (f p) :=
  Quotient.sound (s := Relation.EqvGen.setoid (cylRel f))
    (Relation.EqvGen.rel (r := cylRel f) _ _ ⟨p, rfl, rfl⟩)

/-- The function underlying the retraction of the mapping cylinder onto its target copy. -/
def cylRetractFun (f : C(P, X)) : (P × unitInterval) ⊕ X → X :=
  Sum.elim (fun q => f q.1) id

/-- The retraction function is constant on the equivalence classes of the gluing relation. -/
theorem cylRetractFun_rel (f : C(P, X)) :
    ∀ a b : (P × unitInterval) ⊕ X,
      Relation.EqvGen (cylRel f) a b → cylRetractFun f a = cylRetractFun f b := by
  have hgen : ∀ a b : (P × unitInterval) ⊕ X, cylRel f a b →
      cylRetractFun f a = cylRetractFun f b := by
    rintro a b ⟨p, rfl, rfl⟩
    rfl
  intro a b hab
  induction hab with
  | rel x y h => exact hgen x y h
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2

/-- **The retraction of the mapping cylinder onto its target**: it collapses the cylinder to the
target copy, `(p,t) ↦ f p`, and fixes `X`. -/
def cylRetract (f : C(P, X)) : C(cyl f, X) where
  toFun := Quotient.lift (cylRetractFun f) (cylRetractFun_rel f)
  continuous_toFun :=
    ((f.continuous.comp continuous_fst).sumElim continuous_id).quotient_lift
      (cylRetractFun_rel f)

/-- The retraction of the mapping cylinder onto its target is the map `f` on the bottom copy of the
source. -/
theorem cylRetract_cylIncl (f : C(P, X)) : (cylRetract f).comp (cylIncl f) = f := by
  apply ContinuousMap.ext
  intro p
  rfl


/-! ## The bottom copy of the source

For `t ≠ 1` the class of `inl (p,t)` in the mapping cylinder is a singleton: the only relation
`cylRel` identifies points of the top circle `P × {1}` with points of `X`. -/

/-- **The class of a point with `t ≠ 1`**: if `a ~ b` in the gluing relation and `b = inl (p,t)`
with `t ≠ 1`, then also `a = inl (p,t)`.  (In fact the implication is an equivalence, for every
pair `a b` related by the relation.) -/
theorem eqvGen_inl_iff {P X : Type} [TopologicalSpace P] [TopologicalSpace X] (f : C(P, X))
    {p : P} {t : unitInterval} (ht : t ≠ 1) {a b : (P × unitInterval) ⊕ X}
    (h : Relation.EqvGen (cylRel f) a b) :
    (a = Sum.inl (p, t)) ↔ (b = Sum.inl (p, t)) := by
  induction h with
  | rel u v huv =>
      obtain ⟨q, rfl, rfl⟩ := huv
      constructor
      · intro h
        have h1 : (1 : unitInterval) = t := by
          simpa using congrArg (fun z : P × unitInterval => z.2) (Sum.inl.inj h)
        exact absurd h1.symm ht
      · intro h
        exact absurd h (fun h => nomatch h)
  | refl u => exact Iff.rfl
  | symm u v huv ih => exact ih.symm
  | trans u v w huv hvw ihuv ihvw => exact ihuv.trans ihvw

/-- The class of a point `inl (p,t)` with `t ≠ 1` is a singleton. -/
theorem eqvGen_eq_inl {P X : Type} [TopologicalSpace P] [TopologicalSpace X] {f : C(P, X)} {p : P}
    {t : unitInterval} (ht : t ≠ 1) {a : (P × unitInterval) ⊕ X}
    (h : Relation.EqvGen (cylRel f) a (Sum.inl (p, t))) :
    a = Sum.inl (p, t) :=
  (eqvGen_inl_iff f ht h).mpr rfl

/-- **The bottom copy of the source is a copy**: `cylIncl` is injective. -/
theorem cylIncl_injective (f : C(P, X)) : Function.Injective (cylIncl f) := by
  intro p p' h
  have h1 : Quotient.mk'' (Sum.inl (p, 0) : (P × unitInterval) ⊕ X) = cylIncl f p' := h
  have h2 : Relation.EqvGen (cylRel f) (Sum.inl (p, 0)) (Sum.inl (p', 0)) :=
    Quotient.exact h1
  have h3 := (eqvGen_inl_iff f (p := p') (t := 0) (by norm_num) h2).mpr rfl
  simpa using h3

/-! ## Paths in the mapping cylinder -/

/-- `t ↦ (1 - s) * t` on the unit interval, used for the vertical paths of the cylinder. -/
def unitIntervalMulSub (s t : unitInterval) : unitInterval :=
  ⟨(1 - (s : ℝ)) * (t : ℝ), by
    constructor
    · exact mul_nonneg (by linarith [s.2.2]) t.2.1
    · nlinarith [s.2.1, s.2.2, t.2.1, t.2.2]⟩

@[simp] theorem unitIntervalMulSub_zero_left (t : unitInterval) :
    unitIntervalMulSub 0 t = t := by
  apply Subtype.ext
  simp [unitIntervalMulSub]

@[simp] theorem unitIntervalMulSub_one_left (t : unitInterval) :
    unitIntervalMulSub 1 t = 0 := by
  apply Subtype.ext
  simp [unitIntervalMulSub]

theorem continuous_unitIntervalMulSub_right (t : unitInterval) :
    Continuous fun s : unitInterval => unitIntervalMulSub s t := by
  refine Continuous.subtype_mk ?_ _
  show Continuous fun s : unitInterval => (1 - (s : ℝ)) * (t : ℝ)
  fun_prop

/-- The **vertical path** in the mapping cylinder, from `⟦inl (p,t)⟧` down to the bottom copy of
the source. -/
def cylVertPath (f : C(P, X)) (p : P) (t : unitInterval) :
    Path (Quotient.mk'' (Sum.inl (p, t) : (P × unitInterval) ⊕ X)) (cylIncl f p) where
  toFun s := Quotient.mk'' (Sum.inl (p, unitIntervalMulSub s t))
  continuous_toFun :=
    continuous_quotient_mk'.comp (continuous_inl.comp
      (continuous_const.prodMk (continuous_unitIntervalMulSub_right t)))
  source' := by
    show Quotient.mk'' (Sum.inl (p, unitIntervalMulSub 0 t)) = _
    rw [unitIntervalMulSub_zero_left]
  target' := by
    show Quotient.mk'' (Sum.inl (p, unitIntervalMulSub 1 t)) = cylIncl f p
    rw [unitIntervalMulSub_one_left]
    rfl

/-- Every point of the mapping cylinder is joined to the bottom copy of the source. -/
theorem cylConnected {P X : Type} [TopologicalSpace P] [TopologicalSpace X] (f : C(P, X))
    [PathConnectedSpace P] [PathConnectedSpace X] :
    ∀ y : cyl f, ∃ a : ↥(Set.range (cylIncl f)), Nonempty (Path y a.1) := by
  intro y
  induction y using Quotient.inductionOn with
  | h z =>
    rcases z with ⟨p, t⟩ | x
    · exact ⟨⟨cylIncl f p, p, rfl⟩, ⟨cylVertPath f p t⟩⟩
    · obtain ⟨p₀⟩ := (inferInstance : Nonempty P)
      obtain ⟨γ⟩ := PathConnectedSpace.joined x (f p₀)
      refine ⟨⟨cylIncl f p₀, p₀, rfl⟩, ⟨?_⟩⟩
      refine ((γ.map (cylInr f).continuous).cast rfl (cyl_mk_inl_one f p₀)).trans
        (cylVertPath f p₀ 1)

/-! ## The cylinder is homotopy equivalent to the target -/

/-- `(s,t) ↦ (1 - s) * t + s` on the unit interval: the parametrization of the push-up homotopy. -/
def unitIntervalLin (s t : unitInterval) : unitInterval :=
  ⟨(1 - (s : ℝ)) * (t : ℝ) + (s : ℝ), by
    constructor
    · nlinarith [s.2.1, s.2.2, t.2.1, t.2.2]
    · nlinarith [s.2.1, s.2.2, t.2.1, t.2.2]⟩

@[simp] theorem unitIntervalLin_one_right (s : unitInterval) : unitIntervalLin s 1 = 1 := by
  apply Subtype.ext
  simp [unitIntervalLin]

@[simp] theorem unitIntervalLin_zero_right (s : unitInterval) : unitIntervalLin s 0 = s := by
  apply Subtype.ext
  simp [unitIntervalLin]

@[simp] theorem unitIntervalLin_zero_left (t : unitInterval) : unitIntervalLin 0 t = t := by
  apply Subtype.ext
  simp [unitIntervalLin]

@[simp] theorem unitIntervalLin_one_left (t : unitInterval) : unitIntervalLin 1 t = 1 := by
  apply Subtype.ext
  simp [unitIntervalLin]

/-- The push-up map of the cylinder, on representatives: `(p,t) ↦ (p, (1-s)t + s)` and the identity
on the target copy. -/
def cylMoveFun (f : C(P, X)) (s : unitInterval) :
    (P × unitInterval) ⊕ X → (P × unitInterval) ⊕ X :=
  Sum.elim (fun q : P × unitInterval => Sum.inl (q.1, unitIntervalLin s q.2))
    (fun x : X => Sum.inr x)

/-- `s ↦ 1 - s` on the unit interval. -/
def unitIntervalOneSub (s : unitInterval) : unitInterval :=
  ⟨1 - (s : ℝ), by
    constructor <;> linarith [s.2.1, s.2.2]⟩

@[simp] theorem unitIntervalOneSub_zero : unitIntervalOneSub 0 = 1 := by
  apply Subtype.ext; simp [unitIntervalOneSub]

@[simp] theorem unitIntervalOneSub_one : unitIntervalOneSub 1 = 0 := by
  apply Subtype.ext; simp [unitIntervalOneSub]

theorem continuous_unitIntervalOneSub : Continuous unitIntervalOneSub := by
  refine Continuous.subtype_mk ?_ _
  show Continuous fun s : unitInterval => 1 - (s : ℝ)
  fun_prop

theorem continuous_cylMoveFun_apply (f : C(P, X)) :
    Continuous fun p : ((P × unitInterval) ⊕ X) × unitInterval => cylMoveFun f p.2 p.1 := by
  have h : (fun p : ((P × unitInterval) ⊕ X) × unitInterval => cylMoveFun f p.2 p.1)
      = (Sum.elim (fun q : (P × unitInterval) × unitInterval =>
            Sum.inl (q.1.1, unitIntervalLin q.2 q.1.2))
          (fun q : X × unitInterval => Sum.inr q.1))
        ∘ (Homeomorph.sumProdDistrib (X := P × unitInterval) (Y := X) (Z := unitInterval)) := by
    funext p
    rcases p with ⟨z, s⟩
    rcases z with q | x <;> rfl
  rw [h]
  refine (Continuous.sumElim ?_ ?_).comp (Homeomorph.sumProdDistrib (X := P × unitInterval)
    (Y := X) (Z := unitInterval)).continuous
  · refine continuous_inl.comp ?_
    refine (continuous_fst.comp continuous_fst).prodMk ?_
    exact Continuous.subtype_mk (by fun_prop) _
  · exact continuous_inr.comp continuous_fst

/-- The push-up map respects the gluing relation. -/
theorem cylMoveFun_rel (f : C(P, X)) (s : unitInterval) :
    ∀ a b : (P × unitInterval) ⊕ X,
      (Quotient.mk'' a : cyl f) = Quotient.mk'' b →
        (Quotient.mk'' (cylMoveFun f s a) : cyl f) = Quotient.mk'' (cylMoveFun f s b) := by
  have hgen : ∀ a b : (P × unitInterval) ⊕ X, cylRel f a b →
      (Quotient.mk'' (cylMoveFun f s a) : cyl f) = Quotient.mk'' (cylMoveFun f s b) := by
    rintro a b ⟨q, rfl, rfl⟩
    show Quotient.mk'' (Sum.inl (q, unitIntervalLin s 1) : (P × unitInterval) ⊕ X) =
      Quotient.mk'' (Sum.inr (f q))
    rw [unitIntervalLin_one_right]
    exact cyl_mk_inl_one f q
  intro a b hab
  have hab' : Relation.EqvGen (cylRel f) a b := Quotient.exact hab
  clear hab
  induction hab' with
  | rel x y h => exact hgen x y h
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2

/-- The push-up map of the cylinder, as a continuous map `cyl f × I → cyl f`. -/
def cylMove (f : C(P, X)) : C(cyl f × unitInterval, cyl f) where
  toFun p := Quotient.lift (fun z => Quotient.mk'' (cylMoveFun f p.2 z))
    (fun a b hab => cylMoveFun_rel f p.2 a b (Quotient.sound hab)) p.1
  continuous_toFun := by
    refine (isQuotientMap_quotient_mk' (s := Relation.EqvGen.setoid (cylRel f))).continuous_lift_prod_left
      (g := fun p : cyl f × unitInterval =>
        Quotient.lift (fun z => Quotient.mk'' (cylMoveFun f p.2 z))
          (fun a b hab => cylMoveFun_rel f p.2 a b (Quotient.sound hab)) p.1) ?_
    change Continuous fun p : ((P × unitInterval) ⊕ X) × unitInterval =>
      Quotient.lift (fun z => Quotient.mk'' (cylMoveFun f p.2 z))
        (fun a b hab => cylMoveFun_rel f p.2 a b (Quotient.sound hab)) (Quotient.mk'' p.1)
    have h : (fun p : ((P × unitInterval) ⊕ X) × unitInterval =>
        Quotient.lift (fun z => Quotient.mk'' (cylMoveFun f p.2 z))
          (fun a b hab => cylMoveFun_rel f p.2 a b (Quotient.sound hab)) (Quotient.mk'' p.1)) =
        fun p : ((P × unitInterval) ⊕ X) × unitInterval =>
          Quotient.mk'' (cylMoveFun f p.2 p.1) := rfl
    rw [h]
    exact continuous_quotient_mk'.comp (continuous_cylMoveFun_apply f)

@[simp] theorem cylMove_zero (f : C(P, X)) (y : cyl f) : cylMove f (y, 0) = y := by
  induction y using Quotient.inductionOn with
  | h z =>
      rcases z with ⟨p, t⟩ | x
      · show Quotient.mk'' (Sum.inl (p, unitIntervalLin 0 t) : (P × unitInterval) ⊕ X) = _
        rw [unitIntervalLin_zero_left]
      · rfl

@[simp] theorem cylMove_one (f : C(P, X)) (y : cyl f) :
    cylMove f (y, 1) = ((cylInr f).comp (cylRetract f)) y := by
  induction y using Quotient.inductionOn with
  | h z =>
      rcases z with ⟨p, t⟩ | x
      · show Quotient.mk'' (Sum.inl (p, unitIntervalLin 1 t) : (P × unitInterval) ⊕ X) = _
        rw [unitIntervalLin_one_left]
        exact cyl_mk_inl_one f p
      · rfl

/-- **The mapping cylinder is homotopy equivalent to its target.**  The homotopy equivalence is
`cylRetract` with inverse `cylInr`; the homotopy pushing the cylinder up to its top is `cylMove`. -/
theorem cylHomotopyEquiv (f : C(P, X)) :
    Nonempty (ContinuousMap.HomotopyEquiv (cyl f) X) := by
  refine ⟨ContinuousMap.HomotopyEquiv.mk (cylRetract f) (cylInr f) ?_ ?_⟩
  · exact ⟨{ toContinuousMap :=
                ⟨fun p : unitInterval × cyl f => cylMove f (p.2, unitIntervalOneSub p.1),
                  (cylMove f).continuous.comp
                    (continuous_snd.prodMk (continuous_unitIntervalOneSub.comp continuous_fst))⟩,
              map_zero_left := fun y => by simp [cylMove_one],
              map_one_left := fun y => by simp [cylMove_zero] }⟩
  · have hcomp : (cylRetract f).comp (cylInr f) = ContinuousMap.id X :=
      ContinuousMap.ext (fun x => rfl)
    simpa only [hcomp] using
      (show ((ContinuousMap.id X).Homotopic (ContinuousMap.id X)) from
        ⟨ContinuousMap.Homotopy.refl (ContinuousMap.id X)⟩)

/-! ## The bottom copy of the source -/

/-- **The bottom copy of the source is homeomorphic to the source.**  The map is the (open)
embedding `cylIncl f`; its image is the bottom `P × {0}` of the cylinder, and the cylinder supplies
an open collar of its image, which is what makes the inverse continuous. -/
theorem cylHomeo (f : C(P, X)) : Nonempty (P ≃ₜ ↥(Set.range (cylIncl f))) := by
  classical
  have hq : Topology.IsQuotientMap (cylMk f) := isQuotientMap_quotient_mk'
  have hinj : Function.Injective (cylIncl f) := cylIncl_injective f
  -- the collar of the bottom copy, and its open image in the quotient
  let Collar : Set P → Set ((P × unitInterval) ⊕ X) := fun U =>
    Sum.inl '' (U ×ˢ {t : unitInterval | (t : ℝ) < 1})
  have hcollar : ∀ U : Set P, IsOpen U → IsOpen (cylMk f '' Collar U) := by
    intro U hU
    have hW₀ : IsOpen (Collar U) :=
      isOpenMap_inl _ (hU.prod (isOpen_lt continuous_subtype_val continuous_const))
    refine (hq.isOpen_preimage (s := cylMk f '' Collar U)).mp ?_
    have hpre : (cylMk f ⁻¹' (cylMk f '' Collar U)) = Collar U := by
      ext z
      constructor
      · rintro ⟨w, hw, hzw⟩
        rcases hw with ⟨q, hqU, rfl⟩
        obtain ⟨hqU₁, hqU₂⟩ := hqU
        have ht : q.2 ≠ 1 := by
          intro h
          rw [h] at hqU₂
          exact absurd hqU₂ (by norm_num)
        have hz : z = Sum.inl q := (eqvGen_inl_iff f ht (Quotient.exact hzw)).mp rfl
        rw [hz]
        exact ⟨q, ⟨hqU₁, hqU₂⟩, rfl⟩
      · intro hz
        exact ⟨z, hz, rfl⟩
    rw [hpre]
    exact hW₀
  -- the inverse function of the homeomorphism
  let invFun : ↥(Set.range (cylIncl f)) → P := fun a => a.2.choose
  have hinv : ∀ a : ↥(Set.range (cylIncl f)), cylIncl f (invFun a) = a.1 :=
    fun a => a.2.choose_spec
  refine ⟨{ toFun := fun p => ⟨cylIncl f p, p, rfl⟩
            invFun := invFun
            left_inv := fun p => hinj (hinv ⟨cylIncl f p, p, rfl⟩)
            right_inv := fun a => Subtype.ext (hinv a)
            continuous_toFun := Continuous.subtype_mk (cylIncl f).continuous _
            continuous_invFun := ?_ }⟩
  rw [continuous_def]
  intro U hU
  change IsOpen (invFun ⁻¹' U)
  have heq : invFun ⁻¹' U = Subtype.val ⁻¹' (cylMk f '' Collar U) := by
    ext a
    constructor
    · intro ha
      exact ⟨Sum.inl (invFun a, 0), ⟨(invFun a, 0), ⟨ha, by norm_num⟩, rfl⟩, hinv a⟩
    · rintro ⟨w, hw, hwa⟩
      rcases hw with ⟨q, hqU, rfl⟩
      obtain ⟨hqU₁, hqU₂⟩ := hqU
      have ht : q.2 ≠ 1 := by
        intro h
        rw [h] at hqU₂
        exact absurd hqU₂ (by norm_num)
      have h2 : (Quotient.mk'' (Sum.inl (invFun a, 0)) : cyl f) =
          Quotient.mk'' (Sum.inl q) := (hinv a).trans hwa.symm
      have h3 : (Sum.inl (invFun a, 0) : (P × unitInterval) ⊕ X) = Sum.inl q :=
        (eqvGen_inl_iff f (p := q.1) (t := q.2) ht (Quotient.exact h2)).mpr rfl
      have h4 : invFun a = q.1 := by
        simpa using congrArg Prod.fst (Sum.inl.inj h3)
      show invFun a ∈ U
      exact h4.symm ▸ hqU₁
  rw [heq]
  exact (hcollar U hU).preimage continuous_subtype_val

end

end Work.Serre
