import Mathlib
import Submission.Work.Serre.CWModel.Gen
import Submission.Work.Serre.CWModel.killSub
import Submission.Work.Serre.CWModel.sphereExtend
import Submission.Work.Serre.CWModel.Descent

set_option synthInstance.maxHeartbeats 400000


/-!
# The `π₁`-killing step of the model tower

`Work.Serre.CWModel.killStep` kills `π_{n+2}(g)` (for `n ≥ 0`) by attaching, for every element of the
kernel of `π_{n+2}(g)`, one `(n+3)`-cell along a sphere map representing it and extending `g` over
the cell by a null-homotopy of the composite.  The case `π₁` is *not* an instance of that statement
(`n = -1`); it is this file.

Given `g : C(Γ,B)`, `g γ₀ = b₀`, with `π₁(g) : π₁(Γ,γ₀) → π₁(B,b₀)` **surjective**, attach to `Γ`,
for every element `α` of the *kernel* of `π₁(g)`, a `2`-cell along the loop `killFamily 0 Γ γ₀ α`
representing `α`, and extend `g` over that cell (the composite is null-homotopic precisely because
`α` is in the kernel).  The resulting map

  `attachG 0 Γ ι killFamily g G hG : attachCells 0 Γ ι killFamily ⟶ B`

is a `π₁`-bijection: `π₁` of the attached space is `π₁(Γ)` modulo the normal subgroup generated by
the attached loops, and the attached loops are exactly the kernel of the surjection `π₁(g)`.

The two halves:

* *surjective*: `π₁(Γ) → π₁(B)` is surjective by hypothesis and the induced maps are functorial;
* *injective*: `π₁(Γ) → π₁(attachCells …)` is surjective
  (`Work.RatHurewicz.surjective_πmap_attachIncl`, valid in degree `1`), and an element of `π₁(Γ)`
  whose image in `π₁(B)` is trivial is one of the attached classes, hence dies in the attached space
  (`Work.Serre.CWModel.killSub`).

Note that `G` and `hG` are *constructed* here, not assumed: the null-homotopy is the one supplied by
`π₁(g) α = 1` and the extension over the cell is `Work.Serre.CWModel.sphereExtend`.  The bijectivity
is independent of the choice of `G` (two extensions of the same boundary map differ by a homotopy
relative to `Γ`), so no compatibility condition on the `G k` is needed.
-/

open scoped Topology Topology.Homotopy unitInterval
open Work.RatHurewicz

namespace Work.Serre.SPC

noncomputable section

theorem piOne_killStep {B : Type} [TopologicalSpace B] (b₀ : B) {Γ : Type} [TopologicalSpace Γ] (γ₀ : Γ) (g : C(Γ, B)) (hbase : g γ₀ = b₀) (hsurj : Function.Surjective (Work.Serre.piMapN g 1 γ₀)) : ∃ (G : {α : HomotopyGroup (Fin 1) Γ γ₀ // Work.Serre.piMapN g 1 γ₀ α = 1} → C(Work.RatHurewicz.cellDisk 0, B)) (hG : ∀ (k : {α : HomotopyGroup (Fin 1) Γ γ₀ // Work.Serre.piMapN g 1 γ₀ α = 1}) (z : Work.RatHurewicz.cellSphere 0), G k (Work.RatHurewicz.cellSphereToDisk 0 z) = g (Work.RatHurewicz.killFamily 0 Γ γ₀ k.1 z)), Function.Bijective (Work.Serre.piMapN (Work.Serre.CWModel.attachG 0 Γ {α : HomotopyGroup (Fin 1) Γ γ₀ // Work.Serre.piMapN g 1 γ₀ α = 1} (fun k => Work.RatHurewicz.killFamily 0 Γ γ₀ k.1) g G hG) 1 (Work.RatHurewicz.attachIncl 0 Γ {α : HomotopyGroup (Fin 1) Γ γ₀ // Work.Serre.piMapN g 1 γ₀ α = 1} (fun k => Work.RatHurewicz.killFamily 0 Γ γ₀ k.1) γ₀)) := by
  classical
  -- the index type: the kernel of `π₁(g)`
  let ι := {α : HomotopyGroup (Fin 1) Γ γ₀ // Work.Serre.piMapN g 1 γ₀ α = 1}
  let f : ι → C(cellSphere 0, Γ) := fun k => killFamily 0 Γ γ₀ k.1
  -- the attaching maps become null-homotopic after composition with `g`
  have hnull : ∀ k : ι, (g.comp (f k)).Homotopic
      (ContinuousMap.const (cellSphere 0) (g γ₀)) := by
    intro k
    have hker : Work.Serre.piMapN g 1 γ₀ (k.1) = 1 := k.2
    have hn : 1 ≤ 1 := le_rfl
    have hcube : GenLoop.Homotopic (Work.StemsB.genLoopMap g 1 (Quotient.out (k.1)))
        (GenLoop.const (N := Fin 1) (X := B) (x := g γ₀)) := by
      have h1 : (Quotient.mk _ (Work.StemsB.genLoopMap g 1 (Quotient.out (k.1))) :
            HomotopyGroup (Fin 1) B (g γ₀))
          = Quotient.mk (GenLoop.Homotopic.setoid (Fin 1) (g γ₀))
              (GenLoop.const (N := Fin 1) (X := B) (x := g γ₀)) := by
        rw [← Work.Serre.piMapN_apply_mk, Quotient.out_eq (k.1), hker]
        exact HomotopyGroup.one_def (N := Fin 1) (X := B) (x := g γ₀)
      exact Quotient.exact h1
    have h2 := Work.Serre.CWModel.cubeLift_homotopic hn hcube
    rw [Work.RatHurewicz.cubeLift_genLoopMap, Work.Serre.CWModel.cubeLift_const] at h2
    exact h2
  -- the extensions over the 2-cells
  let G : ι → C(cellDisk 0, B) := fun k =>
    Classical.choose (Work.Serre.CWModel.sphereExtend (g.comp (f k))
      (hnull k).some.toContinuousMap (g γ₀)
      (hnull k).some.map_zero_left (hnull k).some.map_one_left)
  have hG : ∀ (k : ι) (z : cellSphere 0), G k (cellSphereToDisk 0 z) = g (f k z) := by
    intro k z
    have hspec := Classical.choose_spec (Work.Serre.CWModel.sphereExtend (g.comp (f k))
      (hnull k).some.toContinuousMap (g γ₀)
      (hnull k).some.map_zero_left (hnull k).some.map_one_left)
    exact congrFun (congrArg DFunLike.coe hspec) z
  refine ⟨G, hG, ?_⟩
  let g' : C(Work.RatHurewicz.attachCells 0 Γ ι f, B) :=
    Work.Serre.CWModel.attachG 0 Γ ι f g G hG
  -- functoriality: `π₁(g') ∘ π₁(incl) = π₁(g)`
  have hcomp' : ∀ a : HomotopyGroup (Fin 1) Γ γ₀,
      Work.Serre.piMapN g 1 γ₀ a
        = Work.Serre.piMapN g' 1 (attachIncl 0 Γ ι f γ₀)
            (Work.Serre.piMapN (attachIncl 0 Γ ι f) 1 γ₀ a) :=
    fun a => Work.Serre.piMapN_comp (attachIncl 0 Γ ι f) g' 1 γ₀ a
  -- multiplicativity of the induced maps on `π₁`
  have hmul : ∀ {Z : Type} [TopologicalSpace Z] (q : C(Γ, Z))
      (a b : HomotopyGroup (Fin 1) Γ γ₀),
      Work.Serre.piMapN q 1 γ₀ (a * b)
        = Work.Serre.piMapN q 1 γ₀ a * Work.Serre.piMapN q 1 γ₀ b :=
    fun q a b => map_mul (Work.StemsB.πmap q 0 γ₀) a b
  have hinv : ∀ {Z : Type} [TopologicalSpace Z] (q : C(Γ, Z))
      (a : HomotopyGroup (Fin 1) Γ γ₀),
      Work.Serre.piMapN q 1 γ₀ a⁻¹ = (Work.Serre.piMapN q 1 γ₀ a)⁻¹ :=
    fun q a => map_inv (Work.StemsB.πmap q 0 γ₀) a
  -- every element of the kernel dies in the attached space
  have hkill : ∀ α : HomotopyGroup (Fin 1) Γ γ₀, Work.Serre.piMapN g 1 γ₀ α = 1 →
      Work.Serre.piMapN (attachIncl 0 Γ ι f) 1 γ₀ α = 1 := by
    intro α hα
    exact Work.Serre.CWModel.killSub (n := 0) Γ γ₀ ι (fun k : ι => k.1) ⟨α, hα⟩
  have hsf : Function.Surjective (Work.Serre.piMapN (attachIncl 0 Γ ι f) 1 γ₀) :=
    surjective_πmap_attachIncl 0 Γ ι f γ₀
  refine ⟨?_, ?_⟩
  · -- injectivity
    intro a b hab
    obtain ⟨α, rfl⟩ := hsf a
    obtain ⟨β, rfl⟩ := hsf b
    have hαβ : Work.Serre.piMapN g 1 γ₀ α = Work.Serre.piMapN g 1 γ₀ β := by
      rw [hcomp' α, hcomp' β]; exact hab
    have hker : Work.Serre.piMapN g 1 γ₀ (α * β⁻¹) = 1 := by
      rw [hmul g α β⁻¹, hinv g β, hαβ, mul_inv_cancel]
    have hk := hkill (α * β⁻¹) hker
    have hthis : Work.Serre.piMapN (attachIncl 0 Γ ι f) 1 γ₀ α
        = Work.Serre.piMapN (attachIncl 0 Γ ι f) 1 γ₀ β := by
      refine mul_inv_eq_one.mp ?_
      rw [← hinv (attachIncl 0 Γ ι f) β, ← hmul (attachIncl 0 Γ ι f) α β⁻¹]
      exact hk
    rw [hthis]
  · -- surjectivity
    intro y
    obtain ⟨α, hα⟩ := hsurj y
    exact ⟨Work.Serre.piMapN (attachIncl 0 Γ ι f) 1 γ₀ α, by
      rw [← hcomp' α]; exact hα⟩

end

end Work.Serre.SPC
