import Mathlib
import Submission.Work.Serre.E3aSkDefs
import Submission.Work.Serre.exists_skeletonMap
import Submission.Work.Serre.OneCell.Defs
import Submission.Work.Serre.OneCell.OneCellGeom

/-!
# The `1`-skeleton of the model of a space as a wedge of circles: geometry

`Work.Serre.E3aSk.Skeleton X pt` is the wedge of one circle per based loop of `X`.  This file sets
up the geometric vocabulary used to prove that `π₁` of this space is generated by the classes of
the `1`-cells:

* `openCell w` — the open cell of the `w`-th circle;
* `shellSet`, `midSet`, `shell`, `mid` — the two halves of the model interval and their images;
* `spider` — the open neighbourhood of the base point consisting of the base point together with
  the outer halves of all the cells (the "star" of the base point);
* `seg`, `legL`, `legR` — the straight segment in the model interval and the two "legs" from the
  base point into a cell (through the two boundary points).
-/

open scoped Topology unitInterval

namespace Work.Serre.SkelPi

noncomputable section

/-- The index type of the `1`-cells of the skeleton: the based loops of `X`. -/
abbrev Idx (X : Type) [TopologicalSpace X] (pt : X) : Type := ↥(GenLoop (Fin 1) X pt)

/-- The skeleton itself. -/
abbrev Skel (X : Type) [TopologicalSpace X] (pt : X) : Type := Work.Serre.E3aSk.Skeleton X pt

/-- The base point of the skeleton. -/
abbrev base (X : Type) [TopologicalSpace X] (pt : X) : Skel X pt :=
  Work.Serre.E3aSk.skeletonBase X pt

/-- The characteristic map of the `w`-th `1`-cell. -/
abbrev cellMap (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    C(Work.Serre.cellDiskOne, Skel X pt) :=
  Work.Serre.oneCellMap PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) w

/-- The open cell of the `w`-th circle. -/
def openCell (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) : Set (Skel X pt) :=
  Work.Serre.OneCell.cellInteriorOne PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) w

/-- The outer half of the model interval. -/
def shellSet : Set Work.Serre.cellDiskOne :=
  {x | 1 / 2 < ‖(x : ℝ)‖ ∧ ‖(x : ℝ)‖ < 1}

/-- The inner half (closed) of the model interval. -/
def midSet : Set Work.Serre.cellDiskOne := {x | ‖(x : ℝ)‖ ≤ 1 / 2}

/-- The union of the outer halves of all the cells. -/
def shell (X : Type) [TopologicalSpace X] (pt : X) : Set (Skel X pt) :=
  Work.Serre.OneCell.cellUnionOne PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) shellSet

/-- The union of the inner halves of all the cells. -/
def mid (X : Type) [TopologicalSpace X] (pt : X) : Set (Skel X pt) :=
  Work.Serre.OneCell.cellUnionOne PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) midSet

/-- **The spider at the base point**: the base point together with the outer halves of all the
cells — an open neighbourhood of the base point. -/
def spider (X : Type) [TopologicalSpace X] (pt : X) : Set (Skel X pt) :=
  {base X pt} ∪ shell X pt

@[simp] theorem mem_openCell {X : Type} [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {z : Skel X pt} : z ∈ openCell X pt w ↔ ∃ x ∈ Work.Serre.OneCell.cellInnerOne,
      cellMap X pt w x = z := Iff.rfl

@[simp] theorem mem_shell {X : Type} [TopologicalSpace X] (pt : X) {z : Skel X pt} :
    z ∈ shell X pt ↔ ∃ (w : Idx X pt) (x : Work.Serre.cellDiskOne), x ∈ shellSet ∧
      cellMap X pt w x = z := by
  simp only [shell, Work.Serre.OneCell.mem_cellUnionOne, shellSet]

@[simp] theorem mem_mid {X : Type} [TopologicalSpace X] (pt : X) {z : Skel X pt} :
    z ∈ mid X pt ↔ ∃ (w : Idx X pt) (x : Work.Serre.cellDiskOne), x ∈ midSet ∧
      cellMap X pt w x = z := by
  simp only [mid, Work.Serre.OneCell.mem_cellUnionOne, midSet]

theorem mem_spider {X : Type} [TopologicalSpace X] (pt : X) {z : Skel X pt} :
    z ∈ spider X pt ↔ z = base X pt ∨ z ∈ shell X pt := by
  simp [spider]

theorem base_mem_spider (X : Type) [TopologicalSpace X] (pt : X) : base X pt ∈ spider X pt :=
  Or.inl rfl

theorem shell_subset_spider (X : Type) [TopologicalSpace X] (pt : X) :
    shell X pt ⊆ spider X pt := fun _ h => Or.inr h

/-! ## The straight segment in the model interval -/

theorem abs_le_one (x : Work.Serre.cellDiskOne) : |(x : ℝ)| ≤ 1 := by
  have h := Metric.mem_closedBall.mp x.2
  rwa [Real.dist_eq, sub_zero] at h

/-- The straight segment in the model interval `D¹ = [-1,1]`. -/
def seg (a b : Work.Serre.cellDiskOne) : Path a b where
  toFun t := ⟨(1 - (t : ℝ)) * (a : ℝ) + (t : ℝ) * (b : ℝ), by
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]
    have ha : |(a : ℝ)| ≤ 1 := abs_le_one a
    have hb : |(b : ℝ)| ≤ 1 := abs_le_one b
    have h1 : (0 : ℝ) ≤ (t : ℝ) := t.2.1
    have h2 : (t : ℝ) ≤ 1 := t.2.2
    have h : |(1 - (t : ℝ)) * (a : ℝ) + (t : ℝ) * (b : ℝ)|
        ≤ (1 - (t : ℝ)) * |(a : ℝ)| + (t : ℝ) * |(b : ℝ)| := by
      calc |(1 - (t : ℝ)) * (a : ℝ) + (t : ℝ) * (b : ℝ)|
          ≤ |(1 - (t : ℝ)) * (a : ℝ)| + |(t : ℝ) * (b : ℝ)| := abs_add_le _ _
        _ = (1 - (t : ℝ)) * |(a : ℝ)| + (t : ℝ) * |(b : ℝ)| := by
            rw [abs_mul, abs_mul, abs_of_nonneg (by linarith), abs_of_nonneg h1]
    nlinarith [abs_nonneg (a : ℝ), abs_nonneg (b : ℝ)]⟩
  continuous_toFun := by fun_prop
  source' := by
    refine Subtype.ext ?_
    simp
  target' := by
    refine Subtype.ext ?_
    simp

@[simp] theorem seg_zero (a b : Work.Serre.cellDiskOne) : seg a b 0 = a := by
  refine Subtype.ext ?_
  simp [seg]

@[simp] theorem seg_one (a b : Work.Serre.cellDiskOne) : seg a b 1 = b := by
  refine Subtype.ext ?_
  simp [seg]

theorem seg_apply_coe (a b : Work.Serre.cellDiskOne) (t : unitInterval) :
    (((seg a b) t : Work.Serre.cellDiskOne) : ℝ)
      = (1 - (t : ℝ)) * (a : ℝ) + (t : ℝ) * (b : ℝ) := rfl

/-- **Convexity of the model interval**: any two paths in `D¹` with the same endpoints are
homotopic relative to their endpoints. -/
theorem homotopic_seg {a b : Work.Serre.cellDiskOne} (u : Path a b) : u.Homotopic (seg a b) := by
  have hmem : ∀ (s : unitInterval) (t : unitInterval),
      (1 - (t : ℝ)) * (u s : ℝ) + (t : ℝ) * (seg a b s : ℝ)
        ∈ Metric.closedBall (0 : ℝ) 1 := by
    intro s t
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]
    have hu : |(u s : ℝ)| ≤ 1 := abs_le_one (u s)
    have hs : |(seg a b s : ℝ)| ≤ 1 := abs_le_one (seg a b s)
    have h1 : (0 : ℝ) ≤ (t : ℝ) := t.2.1
    have h2 : (t : ℝ) ≤ 1 := t.2.2
    have h : |(1 - (t : ℝ)) * (u s : ℝ) + (t : ℝ) * (seg a b s : ℝ)|
        ≤ (1 - (t : ℝ)) * |(u s : ℝ)| + (t : ℝ) * |(seg a b s : ℝ)| := by
      calc |(1 - (t : ℝ)) * (u s : ℝ) + (t : ℝ) * (seg a b s : ℝ)|
          ≤ |(1 - (t : ℝ)) * (u s : ℝ)| + |(t : ℝ) * (seg a b s : ℝ)| := abs_add_le _ _
        _ = (1 - (t : ℝ)) * |(u s : ℝ)| + (t : ℝ) * |(seg a b s : ℝ)| := by
            rw [abs_mul, abs_mul, abs_of_nonneg (by linarith), abs_of_nonneg h1]
    nlinarith [abs_nonneg (u s : ℝ), abs_nonneg (seg a b s : ℝ)]
  refine ⟨?_⟩
  refine
    { toFun := fun p => ⟨(1 - (p.1 : ℝ)) * (u p.2 : ℝ) + (p.1 : ℝ) * (seg a b p.2 : ℝ),
        hmem p.2 p.1⟩
      continuous_toFun := by fun_prop
      map_zero_left := ?_
      map_one_left := ?_
      prop' := ?_ }
  · intro x
    refine Subtype.ext ?_
    simp
  · intro x
    refine Subtype.ext ?_
    simp
  · intro t x hx
    rcases hx with hx | hx
    · rw [hx]
      refine Subtype.ext ?_
      show (1 - (t : ℝ)) * ((u (0 : unitInterval) : cellDiskOne) : ℝ)
          + (t : ℝ) * (((seg a b) (0 : unitInterval) : cellDiskOne) : ℝ)
        = ((u (0 : unitInterval) : cellDiskOne) : ℝ)
      have h1 : (((seg a b) (0 : unitInterval) : cellDiskOne) : ℝ) = (a : ℝ) :=
        congrArg Subtype.val (seg_zero a b)
      have h2 : ((u (0 : unitInterval) : cellDiskOne) : ℝ) = (a : ℝ) :=
        congrArg Subtype.val u.source'
      rw [h1, h2]
      ring
    · rw [Set.mem_singleton_iff] at hx
      rw [hx]
      refine Subtype.ext ?_
      show (1 - (t : ℝ)) * ((u (1 : unitInterval) : cellDiskOne) : ℝ)
          + (t : ℝ) * (((seg a b) (1 : unitInterval) : cellDiskOne) : ℝ)
        = ((u (1 : unitInterval) : cellDiskOne) : ℝ)
      have h1 : (((seg a b) (1 : unitInterval) : cellDiskOne) : ℝ) = (b : ℝ) :=
        congrArg Subtype.val (seg_one a b)
      have h2 : ((u (1 : unitInterval) : cellDiskOne) : ℝ) = (b : ℝ) :=
        congrArg Subtype.val u.target'
      rw [h1, h2]
      ring

/-! ## The two legs from the base point into a cell -/

/-- The left end `-1` of the model interval, as a point of the interval. -/
def endL : Work.Serre.cellDiskOne :=
  ⟨-1, by rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]; norm_num⟩

/-- The right end `+1` of the model interval, as a point of the interval. -/
def endR : Work.Serre.cellDiskOne :=
  ⟨1, by rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]; norm_num⟩

/-- The left end `-1` of the model interval, as a point of the boundary sphere. -/
def bndL : Work.Serre.cellSphereZero :=
  ⟨-1, by rw [Metric.mem_sphere, Real.dist_eq, sub_zero]; norm_num⟩

/-- The right end `+1` of the model interval, as a point of the boundary sphere. -/
def bndR : Work.Serre.cellSphereZero :=
  ⟨1, by rw [Metric.mem_sphere, Real.dist_eq, sub_zero]; norm_num⟩

@[simp] theorem endL_coe : ((endL : Work.Serre.cellDiskOne) : ℝ) = -1 := rfl

@[simp] theorem endR_coe : ((endR : Work.Serre.cellDiskOne) : ℝ) = 1 := rfl

@[simp] theorem cellSphereZeroToDiskOne_bndL :
    Work.Serre.cellSphereZeroToDiskOne bndL = endL := Subtype.ext rfl

@[simp] theorem cellSphereZeroToDiskOne_bndR :
    Work.Serre.cellSphereZeroToDiskOne bndR = endR := Subtype.ext rfl

theorem cellMap_endL (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    cellMap X pt w endL = base X pt := by
  show Work.Serre.oneCellMap PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) w endL = _
  rw [← cellSphereZeroToDiskOne_bndL]
  exact (Work.Serre.oneIncl_oneCellRel PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) w
    bndL).symm

theorem cellMap_endR (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    cellMap X pt w endR = base X pt := by
  show Work.Serre.oneCellMap PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) w endR = _
  rw [← cellSphereZeroToDiskOne_bndR]
  exact (Work.Serre.oneIncl_oneCellRel PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt) w
    bndR).symm

/-- The leg from the base point into the cell `w` through the left end `-1`. -/
def legL (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) : Path (base X pt) (cellMap X pt w x) where
  toFun t := cellMap X pt w ((seg endL x) t)
  continuous_toFun := (cellMap X pt w).continuous.comp (seg endL x).continuous
  source' := by
    show cellMap X pt w ((seg endL x) 0) = base X pt
    rw [seg_zero]
    exact cellMap_endL X pt w
  target' := by
    show cellMap X pt w ((seg endL x) 1) = cellMap X pt w x
    rw [seg_one]

/-- The leg from the base point into the cell `w` through the right end `+1`. -/
def legR (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) : Path (base X pt) (cellMap X pt w x) where
  toFun t := cellMap X pt w ((seg endR x) t)
  continuous_toFun := (cellMap X pt w).continuous.comp (seg endR x).continuous
  source' := by
    show cellMap X pt w ((seg endR x) 0) = base X pt
    rw [seg_zero]
    exact cellMap_endR X pt w
  target' := by
    show cellMap X pt w ((seg endR x) 1) = cellMap X pt w x
    rw [seg_one]

/-- The image of the `-1`-end leg is in the closed cell. -/
theorem legL_mem_closed (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) (t : unitInterval) :
    legL X pt w x t ∈ Set.range (cellMap X pt w) := ⟨_, rfl⟩

/-- The image of the `+1`-end leg is in the closed cell. -/
theorem legR_mem_closed (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) (t : unitInterval) :
    legR X pt w x t ∈ Set.range (cellMap X pt w) := ⟨_, rfl⟩

/-! ## The open cells, the shell and the middle -/

theorem inner_of_shellSet {x : Work.Serre.cellDiskOne} (hx : x ∈ shellSet) :
    x ∈ Work.Serre.OneCell.cellInnerOne := by
  rw [Work.Serre.OneCell.mem_cellInnerOne]
  exact hx.2

theorem inner_of_midSet {x : Work.Serre.cellDiskOne} (hx : x ∈ midSet) :
    x ∈ Work.Serre.OneCell.cellInnerOne := by
  rw [Work.Serre.OneCell.mem_cellInnerOne]
  exact lt_of_le_of_lt hx (by norm_num)

theorem notMem_midSet_of_shellSet {x : Work.Serre.cellDiskOne} (hx : x ∈ shellSet) :
    x ∉ midSet := fun h => absurd hx.1 (not_lt.mpr h)

theorem isClosed_midSet : IsClosed midSet :=
  isClosed_le continuous_subtype_val.norm continuous_const

theorem oneCellOldPart_eq_singleton (X : Type) [TopologicalSpace X] (pt : X) :
    Work.Serre.OneCell.oneCellOldPart PUnit (Idx X pt) (Work.Serre.E3aSk.skeletonAttach X pt)
      = {base X pt} := by
  ext z
  rw [Work.Serre.OneCell.mem_oneCellOldPart]
  constructor
  · rintro ⟨y, hy⟩
    rw [Subsingleton.elim y PUnit.unit] at hy
    exact hy.symm
  · intro hz
    exact ⟨PUnit.unit, hz.symm⟩

theorem innerUnion_eq_compl_base (X : Type) [TopologicalSpace X] (pt : X) :
    Work.Serre.OneCell.cellInnerUnionOne PUnit (Idx X pt)
      (Work.Serre.E3aSk.skeletonAttach X pt) = {base X pt}ᶜ := by
  rw [← oneCellOldPart_eq_singleton X pt,
    Work.Serre.OneCell.oneCellOldPart_eq_compl, compl_compl]

theorem mem_innerUnion_iff {X : Type} [TopologicalSpace X] (pt : X) {z : Skel X pt} :
    z ∈ Work.Serre.OneCell.cellInnerUnionOne PUnit (Idx X pt)
      (Work.Serre.E3aSk.skeletonAttach X pt) ↔ z ≠ base X pt := by
  rw [innerUnion_eq_compl_base]
  simp

theorem mem_innerUnion_of_ne_base {X : Type} [TopologicalSpace X] (pt : X) {z : Skel X pt}
    (hz : z ≠ base X pt) :
    z ∈ Work.Serre.OneCell.cellInnerUnionOne PUnit (Idx X pt)
      (Work.Serre.E3aSk.skeletonAttach X pt) :=
  (mem_innerUnion_iff pt).mpr hz

theorem base_notMem_mid (X : Type) [TopologicalSpace X] (pt : X) : base X pt ∉ mid X pt := by
  intro h
  obtain ⟨w, x, hx, hxz⟩ := (mem_mid (X := X) pt).mp h
  have h1 : base X pt ∈ Work.Serre.OneCell.cellInnerUnionOne PUnit (Idx X pt)
      (Work.Serre.E3aSk.skeletonAttach X pt) :=
    Set.mem_iUnion.mpr ⟨w, ⟨x, inner_of_midSet hx, hxz⟩⟩
  exact (mem_innerUnion_iff (X := X) pt).mp h1 rfl

theorem self_subset_spider_or_openCell (X : Type) [TopologicalSpace X] (pt : X) (z : Skel X pt) :
    z ∈ spider X pt ∨ ∃ w : Idx X pt, z ∈ openCell X pt w := by
  by_cases hb : z = base X pt
  · exact Or.inl (hb ▸ base_mem_spider X pt)
  · obtain ⟨w, hw⟩ := Set.mem_iUnion.mp (mem_innerUnion_of_ne_base pt hb)
    exact Or.inr ⟨w, hw⟩

/-- The union of the images of two disjoint parts of the open model interval is disjoint. -/
theorem disjoint_cellUnionOne {X : Type} [TopologicalSpace X] (pt : X)
    {U V : Set Work.Serre.cellDiskOne}
    (hU : U ⊆ Work.Serre.OneCell.cellInnerOne) (hV : V ⊆ Work.Serre.OneCell.cellInnerOne)
    (h : Disjoint U V) :
    Disjoint (Work.Serre.OneCell.cellUnionOne PUnit (Idx X pt)
        (Work.Serre.E3aSk.skeletonAttach X pt) U)
      (Work.Serre.OneCell.cellUnionOne PUnit (Idx X pt)
        (Work.Serre.E3aSk.skeletonAttach X pt) V) := by
  rw [Set.disjoint_left]
  intro z hz hz'
  rw [Work.Serre.OneCell.mem_cellUnionOne] at hz hz'
  obtain ⟨w, x, hxU, hx⟩ := hz
  obtain ⟨w', x', hx'V, hx'⟩ := hz'
  rcases eq_or_ne w w' with hww | hww
  · subst hww
    have hxx : x = x' := Work.Serre.OneCell.oneCellMap_injOn_inner
      (Y := PUnit) (f := Work.Serre.E3aSk.skeletonAttach X pt) w (hU hxU) (hV hx'V)
      (hx.trans hx'.symm)
    subst hxx
    exact (Set.disjoint_left.mp h) hxU hx'V
  · exact Set.disjoint_left.mp (Work.Serre.OneCell.disjoint_cellInteriorOne
      (Y := PUnit) (f := Work.Serre.E3aSk.skeletonAttach X pt) hww)
      ⟨x, hU hxU, hx⟩ ⟨x', hV hx'V, hx'⟩

/-- The unique cell and coordinate of a point of an open cell. -/
theorem cellMap_rep_unique {X : Type} [TopologicalSpace X] (pt : X) {w w' : Idx X pt}
    {x x' : Work.Serre.cellDiskOne} (hx : x ∈ Work.Serre.OneCell.cellInnerOne)
    (hx' : x' ∈ Work.Serre.OneCell.cellInnerOne)
    (h : cellMap X pt w x = cellMap X pt w' x') : w = w' ∧ x = x' := by
  rcases eq_or_ne w w' with hww | hww
  · subst hww
    exact ⟨rfl, Work.Serre.OneCell.oneCellMap_injOn_inner (Y := PUnit)
      (f := Work.Serre.E3aSk.skeletonAttach X pt) w hx hx' h⟩
  · exfalso
    exact Set.disjoint_left.mp (Work.Serre.OneCell.disjoint_cellInteriorOne
      (Y := PUnit) (f := Work.Serre.E3aSk.skeletonAttach X pt) hww)
      ⟨x, hx, rfl⟩ ⟨x', hx', h.symm⟩

theorem spider_eq_compl_mid (X : Type) [TopologicalSpace X] (pt : X) :
    spider X pt = (mid X pt)ᶜ := by
  ext z
  constructor
  · intro hz
    rw [mem_spider (X := X) pt] at hz
    rcases hz with rfl | hz
    · exact base_notMem_mid X pt
    · intro hm
      obtain ⟨w, x, hx, hxz⟩ := (mem_shell (X := X) pt).mp hz
      obtain ⟨w', x', hx', hx'z⟩ := (mem_mid (X := X) pt).mp hm
      obtain ⟨hww, hxx⟩ := cellMap_rep_unique pt (inner_of_shellSet hx) (inner_of_midSet hx')
        (hxz.trans hx'z.symm)
      subst hww; subst hxx
      exact notMem_midSet_of_shellSet hx hx'
  · intro hz
    rw [mem_spider (X := X) pt]
    by_cases hb : z = base X pt
    · exact Or.inl hb
    refine Or.inr ((mem_shell (X := X) pt).mpr ?_)
    obtain ⟨w, hw⟩ := Set.mem_iUnion.mp (mem_innerUnion_of_ne_base pt hb)
    obtain ⟨x, hx, hxz⟩ := hw
    have hxin : ‖(x : ℝ)‖ < 1 := by
      rw [Work.Serre.OneCell.mem_cellInnerOne, Real.norm_eq_abs] at hx
      exact hx
    refine ⟨w, x, ⟨?_, hxin⟩, hxz⟩
    by_contra hcon
    push Not at hcon
    exact hz ((mem_mid (X := X) pt).mpr ⟨w, x, hcon, hxz⟩)

theorem isClosed_mid (X : Type) [TopologicalSpace X] (pt : X) : IsClosed (mid X pt) :=
  Work.Serre.OneCell.isClosed_cellUnionOne (Y := PUnit)
    (f := Work.Serre.E3aSk.skeletonAttach X pt) (U := midSet)
    (fun x hx => inner_of_midSet hx) isClosed_midSet

theorem isOpen_spider (X : Type) [TopologicalSpace X] (pt : X) : IsOpen (spider X pt) := by
  rw [spider_eq_compl_mid]
  exact (isClosed_mid X pt).isOpen_compl

theorem isOpen_openCell (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    IsOpen (openCell X pt w) :=
  Work.Serre.OneCell.isOpen_cellImage (Y := PUnit)
    (f := Work.Serre.E3aSk.skeletonAttach X pt) (U := Work.Serre.OneCell.cellInnerOne) w
    (fun _ hx => hx)
    (isOpen_lt continuous_subtype_val.norm continuous_const)

/-! ## The legs of shell points stay in the spider -/

theorem legL_mem_spider (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {x : Work.Serre.cellDiskOne} (hx : x ∈ shellSet) (hx0 : (x : ℝ) ≤ 0) (t : unitInterval) :
    legL X pt w x t ∈ spider X pt := by
  show cellMap X pt w ((seg endL x) t) ∈ spider X pt
  have hxsh : (1 : ℝ) / 2 < |(x : ℝ)| := by
    rw [← Real.norm_eq_abs]; exact hx.1
  have hxneg : (x : ℝ) < -1 / 2 := by
    rw [abs_of_nonpos hx0] at hxsh; linarith
  have hxgt : (-1 : ℝ) < (x : ℝ) := by
    have h := hx.2
    rw [Real.norm_eq_abs] at h
    linarith [neg_abs_le (x : ℝ)]
  have hv : (((seg endL x) t : Work.Serre.cellDiskOne) : ℝ)
      = -1 + (t : ℝ) * (1 + (x : ℝ)) := by
    rw [seg_apply_coe, endL_coe]; ring
  have hfac : (1 + (x : ℝ)) * ((t : ℝ) - 1) ≤ 0 := by
    have h1 : (0 : ℝ) < 1 + (x : ℝ) := by linarith
    have h2 : (t : ℝ) - 1 ≤ 0 := by linarith [t.2.2]
    exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt h1) h2
  have hvle : (((seg endL x) t : Work.Serre.cellDiskOne) : ℝ) ≤ (x : ℝ) := by
    rw [hv]; linarith
  have hvge : (-1 : ℝ) ≤ ((seg endL x) t : Work.Serre.cellDiskOne) := by
    rw [hv]
    have h : (0 : ℝ) ≤ (t : ℝ) * (1 + (x : ℝ)) := by
      have h1 : (0 : ℝ) < 1 + (x : ℝ) := by linarith
      exact mul_nonneg t.2.1 (le_of_lt h1)
    linarith
  rcases eq_or_lt_of_le hvge with heq | hlt
  · have hpt : ((seg endL x) t : Work.Serre.cellDiskOne) = endL := by
      refine Subtype.ext ?_
      rw [endL_coe]
      linarith
    rw [hpt]
    exact Or.inl (cellMap_endL X pt w)
  refine shell_subset_spider X pt ((mem_shell (X := X) pt).mpr ⟨w, (seg endL x) t, ?_, rfl⟩)
  have hlt0 : (((seg endL x) t : Work.Serre.cellDiskOne) : ℝ) < 0 := by linarith
  refine ⟨?_, ?_⟩
  · rw [Real.norm_eq_abs, abs_of_neg hlt0]
    linarith
  · rw [Real.norm_eq_abs, abs_of_neg hlt0]
    linarith

theorem legR_mem_spider (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {x : Work.Serre.cellDiskOne} (hx : x ∈ shellSet) (hx0 : 0 < (x : ℝ)) (t : unitInterval) :
    legR X pt w x t ∈ spider X pt := by
  show cellMap X pt w ((seg endR x) t) ∈ spider X pt
  have hxsh : (1 : ℝ) / 2 < |(x : ℝ)| := by
    rw [← Real.norm_eq_abs]; exact hx.1
  have hxpos : (1 : ℝ) / 2 < (x : ℝ) := by
    rw [abs_of_pos hx0] at hxsh; linarith
  have hxlt : (x : ℝ) < 1 := by
    have h := hx.2
    rw [Real.norm_eq_abs] at h
    linarith [le_abs_self (x : ℝ)]
  have hv : (((seg endR x) t : Work.Serre.cellDiskOne) : ℝ)
      = 1 + (t : ℝ) * ((x : ℝ) - 1) := by
    rw [seg_apply_coe, endR_coe]; ring
  have hfac : (1 - (x : ℝ)) * (1 - (t : ℝ)) ≥ 0 := by
    have h1 : (0 : ℝ) < 1 - (x : ℝ) := by linarith
    have h2 : (0 : ℝ) ≤ 1 - (t : ℝ) := by linarith [t.2.2]
    exact mul_nonneg (le_of_lt h1) h2
  have hvge : (x : ℝ) ≤ (((seg endR x) t : Work.Serre.cellDiskOne) : ℝ) := by
    rw [hv]
    linarith
  have hvle : (((seg endR x) t : Work.Serre.cellDiskOne) : ℝ) ≤ 1 := by
    rw [hv]
    have h : (0 : ℝ) ≤ (t : ℝ) * (1 - (x : ℝ)) := by
      have h1 : (0 : ℝ) < 1 - (x : ℝ) := by linarith
      exact mul_nonneg t.2.1 (le_of_lt h1)
    linarith
  rcases eq_or_lt_of_le hvle with heq | hlt
  · have hpt : ((seg endR x) t : Work.Serre.cellDiskOne) = endR := by
      refine Subtype.ext ?_
      rw [endR_coe]
      linarith
    rw [hpt]
    exact Or.inl (cellMap_endR X pt w)
  refine shell_subset_spider X pt ((mem_shell (X := X) pt).mpr ⟨w, (seg endR x) t, ?_, rfl⟩)
  have hgt0 : (0 : ℝ) < ((seg endR x) t : Work.Serre.cellDiskOne) := by linarith
  refine ⟨?_, ?_⟩
  · rw [Real.norm_eq_abs, abs_of_pos hgt0]
    linarith
  · rw [Real.norm_eq_abs, abs_of_pos hgt0]
    exact hlt

/-! ## The cell loop, the cell class, and the subgroup generated by the cells -/

/-- The loop carried by the `w`-th cell, as a path on the model interval and based at the
base point. -/
def cellLoopPath (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    Path (base X pt) (base X pt) :=
  (((seg endL endR).map (cellMap X pt w).continuous).cast
    (cellMap_endL X pt w).symm (cellMap_endR X pt w).symm)

theorem cellLoopPath_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (t : unitInterval) :
    (cellLoopPath X pt w : unitInterval → Skel X pt) t = cellMap X pt w ((seg endL endR) t) :=
  rfl

/-- The interval cell loop and the cube cell loop agree. -/
theorem cellLoopPath_cube (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (u : Fin 1 → unitInterval) :
    (cellLoopPath X pt w : unitInterval → Skel X pt) (u 0)
      = (((cellMap X pt w).comp Work.Serre.E3aSk.SkelMap.cubeToD1)) u := by
  rw [cellLoopPath_apply]
  refine congrArg (cellMap X pt w) ?_
  refine Subtype.ext ?_
  rw [seg_apply_coe, endL_coe, endR_coe]
  show (1 - ((u 0 : unitInterval) : ℝ)) * (-1) + ((u 0 : unitInterval) : ℝ) * 1
      = 2 * ((u 0 : unitInterval) : ℝ) - 1
  ring

/-- The class of the loop carried by the `w`-th cell, in the fundamental group of the skeleton. -/
def cellLoopClass (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    FundamentalGroup (Skel X pt) (base X pt) :=
  Path.Homotopic.Quotient.mk (cellLoopPath X pt w)

/-- **The subgroup of `π₁` of the skeleton generated by the classes of the `1`-cells.** -/
def cellSubgroup (X : Type) [TopologicalSpace X] (pt : X) :
    Subgroup (FundamentalGroup (Skel X pt) (base X pt)) :=
  Subgroup.closure (Set.range (cellLoopClass X pt))

theorem cellLoopClass_mem_cellSubgroup (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    cellLoopClass X pt w ∈ cellSubgroup X pt :=
  Subgroup.subset_closure ⟨w, rfl⟩

/-! ## The legs with prescribed endpoints -/

/-- The straight leg from the base point into the cell `w` through the left end, ending at `z`
(where `hz` identifies the model endpoint of the cell with `z`). -/
def legAuxL (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) (x : Work.Serre.cellDiskOne)
    (z : Skel X pt) (hz : cellMap X pt w x = z) : Path (base X pt) z where
  toFun t := cellMap X pt w ((seg endL x) t)
  continuous_toFun := (cellMap X pt w).continuous.comp (seg endL x).continuous
  source' := by
    show cellMap X pt w ((seg endL x) 0) = base X pt
    rw [seg_zero]
    exact cellMap_endL X pt w
  target' := by
    show cellMap X pt w ((seg endL x) 1) = z
    rw [seg_one]
    exact hz

/-- The straight leg from the base point into the cell `w` through the right end, ending at `z`. -/
def legAuxR (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) (x : Work.Serre.cellDiskOne)
    (z : Skel X pt) (hz : cellMap X pt w x = z) : Path (base X pt) z where
  toFun t := cellMap X pt w ((seg endR x) t)
  continuous_toFun := (cellMap X pt w).continuous.comp (seg endR x).continuous
  source' := by
    show cellMap X pt w ((seg endR x) 0) = base X pt
    rw [seg_zero]
    exact cellMap_endR X pt w
  target' := by
    show cellMap X pt w ((seg endR x) 1) = z
    rw [seg_one]
    exact hz

theorem legAuxL_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) (z : Skel X pt) (hz : cellMap X pt w x = z)
    (t : unitInterval) :
    (legAuxL X pt w x z hz : unitInterval → Skel X pt) t = cellMap X pt w ((seg endL x) t) := rfl

theorem legAuxR_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) (z : Skel X pt) (hz : cellMap X pt w x = z)
    (t : unitInterval) :
    (legAuxR X pt w x z hz : unitInterval → Skel X pt) t = cellMap X pt w ((seg endR x) t) := rfl

theorem legAuxL_mem_spider (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {x : Work.Serre.cellDiskOne} (z : Skel X pt) (hz : cellMap X pt w x = z)
    (hx : x ∈ shellSet) (hx0 : (x : ℝ) ≤ 0) (t : unitInterval) :
    legAuxL X pt w x z hz t ∈ spider X pt := by
  rw [legAuxL_apply]
  exact legL_mem_spider X pt w hx hx0 t

theorem legAuxR_mem_spider (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {x : Work.Serre.cellDiskOne} (z : Skel X pt) (hz : cellMap X pt w x = z)
    (hx : x ∈ shellSet) (hx0 : 0 < (x : ℝ)) (t : unitInterval) :
    legAuxR X pt w x z hz t ∈ spider X pt := by
  rw [legAuxR_apply]
  exact legR_mem_spider X pt w hx hx0 t

/-! ## The chosen leg of a point -/

/-- The chosen cell of a point of the skeleton lying in an open cell. -/
def cellIdx (X : Type) [TopologicalSpace X] (pt : X) (z : Skel X pt)
    (h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z) : Idx X pt :=
  Classical.choose h

/-- The chosen coordinate of a point of the skeleton lying in an open cell. -/
def coord (X : Type) [TopologicalSpace X] (pt : X) (z : Skel X pt)
    (h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z) :
    Work.Serre.cellDiskOne :=
  Classical.choose (Classical.choose_spec h)

theorem coord_mem (X : Type) [TopologicalSpace X] (pt : X) (z : Skel X pt)
    (h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z) :
    coord X pt z h ∈ Work.Serre.OneCell.cellInnerOne :=
  (Classical.choose_spec (Classical.choose_spec h)).1

theorem cellMap_coord (X : Type) [TopologicalSpace X] (pt : X) (z : Skel X pt)
    (h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z) :
    cellMap X pt (cellIdx X pt z h) (coord X pt z h) = z :=
  (Classical.choose_spec (Classical.choose_spec h)).2

/-- The cell and coordinate of a point of the skeleton lying in two open cells agree. -/
theorem cellIdx_coord_unique (X : Type) [TopologicalSpace X] (pt : X) {z : Skel X pt}
    {w : Idx X pt} {x : Work.Serre.cellDiskOne} (hx : x ∈ Work.Serre.OneCell.cellInnerOne)
    (hxz : cellMap X pt w x = z)
    (h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z) :
    cellIdx X pt z h = w ∧ coord X pt z h = x :=
  cellMap_rep_unique pt (coord_mem X pt z h) hx ((cellMap_coord X pt z h).trans hxz.symm)

/-- **A chosen leg from the base point to each point of the skeleton**: through the end of the
cell on the side of the point. -/
def legOf (X : Type) [TopologicalSpace X] (pt : X) (z : Skel X pt) : Path (base X pt) z := by
  classical
  exact
    if h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z then
      if ((coord X pt z h : Work.Serre.cellDiskOne) : ℝ) ≤ 0 then
        legAuxL X pt (cellIdx X pt z h) (coord X pt z h) z (cellMap_coord X pt z h)
      else
        legAuxR X pt (cellIdx X pt z h) (coord X pt z h) z (cellMap_coord X pt z h)
    else
      (Path.refl (base X pt)).cast rfl (by
        by_contra hne
        obtain ⟨w, hw⟩ := Set.mem_iUnion.mp ((mem_innerUnion_iff (X := X) pt).mpr hne)
        exact h ⟨w, hw⟩)

theorem legOf_base (X : Type) [TopologicalSpace X] (pt : X) :
    legOf X pt (base X pt) = Path.refl (base X pt) := by
  rw [legOf, dif_neg ?_]
  · refine Path.ext rfl
  · rintro ⟨w, x, hx, hxz⟩
    exact (mem_innerUnion_iff (X := X) pt).mp
      (Set.mem_iUnion.mpr ⟨w, ⟨x, hx, hxz⟩⟩) rfl

theorem legOf_eq_legL (X : Type) [TopologicalSpace X] (pt : X) {z : Skel X pt}
    {w : Idx X pt} {x : Work.Serre.cellDiskOne} (hx : x ∈ Work.Serre.OneCell.cellInnerOne)
    (hz : cellMap X pt w x = z) (hs : (x : ℝ) ≤ 0) :
    legOf X pt z = legAuxL X pt w x z hz := by
  have h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z :=
    ⟨w, x, hx, hz⟩
  obtain ⟨hcel, hco⟩ := cellIdx_coord_unique X pt hx hz h
  have hs' : ((coord X pt z h : Work.Serre.cellDiskOne) : ℝ) ≤ 0 := by
    rw [hco]; exact hs
  rw [legOf, dif_pos h, if_pos hs']
  refine Path.ext ?_
  funext t
  rw [legAuxL_apply, legAuxL_apply, hcel, hco]

theorem legOf_eq_legR (X : Type) [TopologicalSpace X] (pt : X) {z : Skel X pt}
    {w : Idx X pt} {x : Work.Serre.cellDiskOne} (hx : x ∈ Work.Serre.OneCell.cellInnerOne)
    (hz : cellMap X pt w x = z) (hs : 0 < (x : ℝ)) :
    legOf X pt z = legAuxR X pt w x z hz := by
  have h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z :=
    ⟨w, x, hx, hz⟩
  obtain ⟨hcel, hco⟩ := cellIdx_coord_unique X pt hx hz h
  have hs' : ¬ (((coord X pt z h : Work.Serre.cellDiskOne) : ℝ) ≤ 0) := by
    rw [hco]; exact not_le.mpr hs
  rw [legOf, dif_pos h, if_neg hs']
  refine Path.ext ?_
  funext t
  rw [legAuxR_apply, legAuxR_apply, hcel, hco]

/-- The leg of a point of an open cell stays in the closed cell. -/
theorem legOf_mem_closed (X : Type) [TopologicalSpace X] (pt : X) {z : Skel X pt}
    {w : Idx X pt} (hz : z ∈ openCell X pt w) (t : unitInterval) :
    legOf X pt z t ∈ Set.range (cellMap X pt w) := by
  obtain ⟨x, hx, hxz⟩ := hz
  have h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z := ⟨w, x, hx, hxz⟩
  obtain ⟨hcel, -⟩ := cellIdx_coord_unique X pt hx hxz h
  rw [legOf, dif_pos h]
  split_ifs with hs
  · rw [legAuxL_apply, hcel]
    exact ⟨_, rfl⟩
  · rw [legAuxR_apply, hcel]
    exact ⟨_, rfl⟩

/-- The leg of a point of the spider stays in the spider. -/
theorem legOf_mem_spider (X : Type) [TopologicalSpace X] (pt : X) {z : Skel X pt}
    (hz : z ∈ spider X pt) (t : unitInterval) : legOf X pt z t ∈ spider X pt := by
  rw [mem_spider (X := X) pt] at hz
  rcases hz with rfl | hz
  · rw [legOf_base]; exact base_mem_spider X pt
  obtain ⟨w, x, hx, hxz⟩ := (mem_shell (X := X) pt).mp hz
  have hx' : x ∈ Work.Serre.OneCell.cellInnerOne := inner_of_shellSet hx
  have h : ∃ w x, x ∈ Work.Serre.OneCell.cellInnerOne ∧ cellMap X pt w x = z :=
    ⟨w, x, hx', hxz⟩
  obtain ⟨hcel, hco⟩ := cellIdx_coord_unique X pt hx' hxz h
  have hxshell : coord X pt z h ∈ shellSet := by rw [hco]; exact hx
  rw [legOf, dif_pos h]
  split_ifs with hs
  · rw [legAuxL_apply, hcel]
    exact legL_mem_spider X pt w hxshell hs t
  · rw [legAuxR_apply, hcel]
    exact legR_mem_spider X pt w hxshell (lt_of_not_ge hs) t

/-! ## The coordinate of a point of an open cell -/

/-- A coordinate of a point of an open cell in its model interval. -/
def coordOf (X : Type) [TopologicalSpace X] (pt : X) {w : Idx X pt} {z : Skel X pt}
    (hz : z ∈ openCell X pt w) : Work.Serre.cellDiskOne :=
  Classical.choose hz

theorem coordOf_mem (X : Type) [TopologicalSpace X] (pt : X) {w : Idx X pt} {z : Skel X pt}
    (hz : z ∈ openCell X pt w) : coordOf X pt hz ∈ Work.Serre.OneCell.cellInnerOne :=
  (Classical.choose_spec hz).1

theorem cellMap_coordOf (X : Type) [TopologicalSpace X] (pt : X) {w : Idx X pt} {z : Skel X pt}
    (hz : z ∈ openCell X pt w) : cellMap X pt w (coordOf X pt hz) = z :=
  (Classical.choose_spec hz).2

theorem legOf_eq_legL_coordOf (X : Type) [TopologicalSpace X] (pt : X) {w : Idx X pt}
    {z : Skel X pt} (hz : z ∈ openCell X pt w) (hs : (coordOf X pt hz : ℝ) ≤ 0) :
    legOf X pt z = legAuxL X pt w (coordOf X pt hz) z (cellMap_coordOf X pt hz) :=
  legOf_eq_legL X pt (coordOf_mem X pt hz) (cellMap_coordOf X pt hz) hs

theorem legOf_eq_legR_coordOf (X : Type) [TopologicalSpace X] (pt : X) {w : Idx X pt}
    {z : Skel X pt} (hz : z ∈ openCell X pt w) (hs : 0 < (coordOf X pt hz : ℝ)) :
    legOf X pt z = legAuxR X pt w (coordOf X pt hz) z (cellMap_coordOf X pt hz) :=
  legOf_eq_legR X pt (coordOf_mem X pt hz) (cellMap_coordOf X pt hz) hs

end

end Work.Serre.SkelPi
