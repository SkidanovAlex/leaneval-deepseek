import Mathlib
import Submission.Work.Thom.smooth8
import Submission.Work.Thom.manifoldP1
import Submission.Work.Cohomology.hmv_naturality

set_option synthInstance.maxHeartbeats 400000

/-!
# (pi_sphere copy) The milnor drive's interface WITHOUT AgreeAll and the capped-congruence glue
(they import the Milnor endgame with its sorry'd modules). Definitions otherwise verbatim.

# The drive's interface: the dimension-8 signature theorem, split into areas

Written by the project lead (the driving session). **Do not edit this file**: every area's
statement below is a contract. Add new material in your own files under `Submission/Work/<Area>/`.

The one remaining `sorry` of the project is `Work.Milnor.cappedCongruence`. It follows
(`Work.Drive.cappedCongruence_of_areas`, proved below) from two statements:

* `Work.Drive.Hirz8` — Hirzebruch's signature theorem in dimension 8, `45 σ = 7 p₂ − p₁²`, for
  every closed connected oriented **C^∞** 8-manifold, with `p₁`, `p₂` the Pontryagin classes of the
  tangent bundle as *defined* in `Submission/Work/Thom/manifoldP1.lean` (`p1Tangent'`, `p2Tangent'`);
* `Work.Drive.AgreeAll` — for the capped manifold `X = D(ξ) ∪_F D⁸`, the defined class
  `p1Tangent' X` is `± cappedPontryaginClass F hF`.

`Hirz8` itself follows (pure algebra, `Work.Drive.hirz8_of_generators_thom`, an area) from

* `Work.Drive.Generators8` — two closed oriented 8-manifolds satisfying the identity, with linearly
  independent `(p₁², p₂)`-numbers (e.g. `ℂP⁴` and `ℂP² × ℂP²`, or `ℂP⁴` and `ℍP²`);
* `Work.Drive.ThomRational` — Thom's theorem in the form used here: a weighted family of closed
  oriented 8-manifolds whose weighted `p₁²`- and `p₂`-numbers vanish has vanishing weighted
  signature (rationally, the signature is a combination of the Pontryagin numbers).

`ThomRational` is Thom's computation of `Ω^SO_8 ⊗ ℚ`: Pontryagin–Thom, transversality, bordism
invariance of `σ`, the rational cohomology of the oriented Grassmannian, and the rational
Hurewicz theorem for its Thom space in the stable range, whose homotopy-theoretic core is
`Work.Drive.StableStemsTorsion` (Serre: the stable stems `π_{n+j}(Sⁿ)`, `1 ≤ j ≤ 8`, are torsion).
-/

open scoped Manifold ContDiff Topology

set_option autoImplicit false

namespace Work.Drive

noncomputable section

/-- **A closed, connected, oriented, smooth (`C^∞`) 8-manifold** with a generating fundamental
class. This is `Work.Thom.ClosedOrientedSmooth8` with `C^∞` instead of `C¹` smoothness and with
`T2Space` added. -/
structure Smooth8 where
  /-- the underlying type -/
  pt : Type
  [topologicalSpace : TopologicalSpace pt]
  [chartedSpace : ChartedSpace (EuclideanSpace ℝ (Fin 8)) pt]
  [isManifold : IsManifold (𝓡 8) ∞ pt]
  [compactSpace : CompactSpace pt]
  [t2Space : T2Space pt]
  [connectedSpace : ConnectedSpace pt]
  /-- the fundamental class -/
  c : (Work.Cohomology.chainC ℤ (TopCat.toSSet.obj (TopCat.of pt))).homology 8
  /-- it generates `H₈(pt;ℤ)` -/
  c_generates : Submodule.span ℤ {c} = ⊤

attribute [instance] Smooth8.topologicalSpace Smooth8.chartedSpace Smooth8.isManifold
  Smooth8.compactSpace Smooth8.t2Space Smooth8.connectedSpace

namespace Smooth8

variable (M : Smooth8)

instance isManifold_one : IsManifold (𝓡 8) 1 M.pt := IsManifold.of_le (n := ∞) (by simp)

/-- The underlying `Work.Thom.ClosedOrientedSmooth8` (forget `C^∞` to `C¹`). -/
def toCOS8 : Work.Thom.ClosedOrientedSmooth8 where
  pt := M.pt
  c := M.c
  c_generates := M.c_generates

/-- The signature `σ(M)`. -/
def sigma : ℤ := M.toCOS8.sigma
/-- The `p₁²`-number `⟨p₁(TM) ⌣ p₁(TM), [M]⟩`, with `p₁(TM) = Work.Thom.p1Tangent'`. -/
def p1Sq : ℤ := M.toCOS8.p1Sq
/-- The `p₂`-number `⟨p₂(TM), [M]⟩`, with `p₂(TM) = Work.Thom.p2Tangent'`. -/
def p2Num : ℤ := M.toCOS8.p2Num

/-- The dimension-8 Hirzebruch identity for `M`. -/
def Hirzebruch : Prop := 45 * M.sigma = 7 * M.p2Num - M.p1Sq

end Smooth8

/-! ## The areas (each is a `Prop`; each area proves exactly one of them) -/

/-- **Area HIRZ8**: Hirzebruch's signature theorem in dimension 8. -/
def Hirz8 : Prop := ∀ M : Smooth8, M.Hirzebruch

/-- **Area GEN**: two closed oriented smooth 8-manifolds satisfying the identity, with linearly
independent Pontryagin-number vectors. (`ℂP⁴ = (σ,p₁²,p₂) = (1,25,10)`,
`ℂP²×ℂP² = (1,18,9)`, `ℍP² = (1,4,7)`.) -/
def Generators8 : Prop :=
  ∃ G₁ G₂ : Smooth8, G₁.Hirzebruch ∧ G₂.Hirzebruch ∧
    G₁.p1Sq * G₂.p2Num ≠ G₁.p2Num * G₂.p1Sq

/-- **Area THOM**: Thom's theorem, rational form. For any finite family of closed oriented smooth
8-manifolds with integer weights, if the weighted `p₁²`-numbers and the weighted `p₂`-numbers both
sum to zero, then the weighted signatures sum to zero. (Equivalently: after adding the disjoint
union of the weighted family, a manifold whose Pontryagin numbers vanish has signature zero.) -/
def ThomRational : Prop :=
  ∀ (n : ℕ) (M : Fin n → Smooth8) (w : Fin n → ℤ),
    ∑ i, w i * (M i).p1Sq = 0 → ∑ i, w i * (M i).p2Num = 0 → ∑ i, w i * (M i).sigma = 0

/-- **Area STEMS** (the homotopy-theoretic core of THOM): the stable stems `π_{n+j}(Sⁿ)`,
`1 ≤ j ≤ 8`, are torsion groups (Serre). Stated with `j = i + 1`, `0 ≤ i ≤ 7`, in the stable range
`n ≥ i + 3`, for the unit sphere `Sⁿ ⊆ ℝⁿ⁺¹` and any base point. -/
def StableStemsTorsion : Prop :=
  ∀ (i : ℕ), i ≤ 7 → ∀ (n : ℕ), i + 3 ≤ n →
    ∀ (x₀ : Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1)
      (α : HomotopyGroup (Fin (n + i + 1)) (Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1) x₀),
      ∃ N : ℕ, 0 < N ∧ α ^ N = 1

end

end Work.Drive
