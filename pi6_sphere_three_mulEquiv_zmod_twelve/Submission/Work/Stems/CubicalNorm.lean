import Submission.Work.Stems.Cubical.CubeFace

/-!
# Degenerate cubes and the normalised cubical chains

The cubical `n`-chains `Cub n X = C(Iⁿ, X) →₀ ℤ` (`Submission/Work/Stems/Cubical/CubeFace.lean`)
contain the **degenerate** cubes: those that do not depend on one of the coordinates.  Modding them
out gives the *normalised* cubical chains `Q_n(X)`, the chain complex which

* the cubical proof of the Hurewicz theorem works with (Hutchings, *The Hurewicz theorem*, §2:
  the homotopy operators `K`, the filling `Ψ` and the identities `(2.3)`–`(2.5)` are all stated
  "modulo degenerate cubes"; see `Submission/Work/Stems/HUR2B_NOTES.md`), and
* the blueprint `Submission/Work/Drive/SERRE_BLUEPRINT.md` uses as the coefficient complex of
  Serre's filtration (E1/E2).

## Main definitions

* `Work.Stems.IsDegenerate` — a cube not depending on one coordinate;
* `Work.Stems.degenSub` — the submodule of `Cub n X` generated by the degenerate `n`-cubes;
* `Work.Stems.normCub` — the normalised cubical `n`-chains `Cub n X ⧸ degenSub n X`.

## The structural facts (proved in sibling modules)

* `Work.Stems.isDegenerate_faceCube`: a face of a cube degenerate in a *different* direction is
  degenerate.
* `Work.Stems.cubD_maps_degenSub`: `cubD n X (degenSub (n+1) X) ⊆ degenSub n X`, so the differential
  descends to the normalised chains.  (For a cube degenerate in direction `j`, the two faces in
  direction `j` are literally equal and cancel in `cubD`, and all other faces are degenerate by the
  previous fact.)
-/

open scoped unitInterval Topology
open Work.Stems.Cubical

namespace Work.Stems

noncomputable section

variable {X : Type} [TopologicalSpace X]

/-- A singular `n`-cube is **degenerate** if it does not depend on one of its coordinates: it
factors through one of the projections `Iⁿ → I^{n-1}`.  (For `n = 0` there are no degenerate
cubes, so `Q_0(X) = C_0(X)`.) -/
def IsDegenerate (n : ℕ) (c : ContinuousMap (IC n) X) : Prop :=
  ∃ j : Fin n, ∀ t t' : IC n, (∀ i, i ≠ j → t i = t' i) → c t = c t'

/-- The submodule of `Cub n X` generated by the degenerate `n`-cubes. -/
def degenSub (n : ℕ) (X : Type) [TopologicalSpace X] : Submodule ℤ (Cub n X) :=
  Submodule.span ℤ
    {c : Cub n X | ∃ s : ContinuousMap (IC n) X, IsDegenerate n s ∧ c = Finsupp.single s 1}

/-- The **normalised cubical `n`-chains**: the cubical `n`-chains modulo the degenerate cubes. -/
abbrev normCub (n : ℕ) (X : Type) [TopologicalSpace X] := (Cub n X) ⧸ degenSub n X

end

end Work.Stems
