import Mathlib
import Submission.Work.EMFG.skeletonAux
import Submission.Work.Serre.SkelPi.Generate

/-!
# The `1`-cells generate `π₁` of the skeleton

`Work.Serre.SPC.Skeleton B b₀` is the wedge of one circle per based loop of `B`, and
`Work.EMFG.skeletonCellClass B b₀ w` is the class in `π₁` of the circle of the based loop `w`.

The purpose of this file is the theorem `Work.EMFG.skeletonCellClasses_generate`: these cell
classes *generate* `π₁(Skeleton B b₀)`, in the sense that two group homomorphisms out of
`π₁(Skeleton B b₀)` which agree on every `skeletonCellClass B b₀ w` are equal.

The mathematics is exactly the classical statement that the fundamental group of a wedge of
circles is the free group generated by the circles.  It is already formalised in
`Work.Serre.SkelPi.Generate` (`cellSubgroup_eq_top`, `closure_cellClassHom_eq_top`) using the
definitionally identical `ℚ`-side vocabulary `Work.Serre.E3aSk.Skeleton` /
`Work.Serre.SkelPi.cellClassHom`.  The only content of the present file is the observation that
the `SPC`-side and `E3aSk`-side models, base points and cell classes are *definitionally* the
same objects, so the generation statement transfers by `rfl`.
-/

open scoped Topology Topology.Homotopy unitInterval

namespace Work.EMFG

noncomputable section

/-- The `SPC`-side skeleton of `B` is definitionally the `E3aSk`-side skeleton of `B`. -/
theorem skeleton_eq_E3aSk (B : Type) [TopologicalSpace B] (b₀ : B) :
    Work.Serre.SPC.Skeleton B b₀ = Work.Serre.E3aSk.Skeleton B b₀ := rfl

/-- The `SPC`-side base point is definitionally the `E3aSk`-side base point. -/
theorem skeletonBase_eq_E3aSk (B : Type) [TopologicalSpace B] (b₀ : B) :
    Work.Serre.SPC.skeletonBase B b₀ = Work.Serre.E3aSk.skeletonBase B b₀ := rfl

/-- The `SPC`-side cell class is definitionally the `E3aSk`/`SkelPi`-side cell class. -/
theorem skeletonCellClass_eq_cellClassHom (B : Type) [TopologicalSpace B] (b₀ : B)
    (w : ↥(GenLoop (Fin 1) B b₀)) :
    skeletonCellClass B b₀ w = Work.Serre.SkelPi.cellClassHom B b₀ w := rfl

/-- **The classes of the `1`-cells generate `π₁` of the skeleton**: the subgroup they generate is
all of `π₁(Skeleton B b₀)`. -/
theorem skeletonCellClass_closure_eq_top (B : Type) [TopologicalSpace B] (b₀ : B) :
    Subgroup.closure (Set.range (skeletonCellClass B b₀)) = ⊤ :=
  Work.Serre.SkelPi.closure_cellClassHom_eq_top B b₀

/-- **The cell classes generate `π₁` of the skeleton** (homomorphism form): two group
homomorphisms out of `π₁(Skeleton B b₀)` that agree on every cell class are equal. -/
theorem skeletonCellClasses_generate (B : Type) [TopologicalSpace B] (b₀ : B) :
    ∀ {G : Type} [Group G]
      (φ ψ : HomotopyGroup (Fin 1) (Work.Serre.SPC.Skeleton B b₀) (Work.Serre.SPC.skeletonBase B b₀) →* G),
      (∀ w : ↥(GenLoop (Fin 1) B b₀),
        φ (Work.EMFG.skeletonCellClass B b₀ w) = ψ (Work.EMFG.skeletonCellClass B b₀ w)) → φ = ψ := by
  intro G _ φ ψ h
  -- the cell classes generate `π₁(Skeleton B b₀)`
  have hgen : Subgroup.closure (Set.range (skeletonCellClass B b₀)) = ⊤ :=
    skeletonCellClass_closure_eq_top B b₀
  -- the set on which the two homomorphisms agree is a subgroup
  set K : Subgroup (HomotopyGroup (Fin 1) (Work.Serre.SPC.Skeleton B b₀)
      (Work.Serre.SPC.skeletonBase B b₀)) :=
    { carrier := {x | φ x = ψ x},
      mul_mem' := by
        intro a b ha hb
        show φ (a * b) = ψ (a * b)
        rw [map_mul, map_mul, ha, hb],
      one_mem' := by
        show φ 1 = ψ 1
        rw [map_one, map_one],
      inv_mem' := by
        intro a ha
        show φ a⁻¹ = ψ a⁻¹
        rw [map_inv, map_inv, ha] } with hK
  -- it contains the generators, hence their closure, hence everything
  have hle : Subgroup.closure (Set.range (skeletonCellClass B b₀)) ≤ K := by
    rw [Subgroup.closure_le]
    rintro x ⟨w, rfl⟩
    exact h w
  ext x
  exact hle (by rw [hgen]; exact Subgroup.mem_top x)

end

end Work.EMFG
