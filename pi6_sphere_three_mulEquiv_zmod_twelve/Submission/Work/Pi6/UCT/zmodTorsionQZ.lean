import Mathlib
import Submission.Work.Pi6.UCT.Defs
set_option backward.isDefEq.respectTransparency false  -- v435port
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false  -- v435port
set_option backward.isDefEq.respectTransparency.types false  -- v435port

/-!
# The `n`-torsion of the circle group is cyclic of order `n`

`Work.Pi6.UCT.QZ = AddCircle (1 : ℚ) = ℚ / ℤ`.  For `0 < n`, the subgroup
`Submodule.torsionBy ℤ QZ (n : ℤ) = {x : QZ | n • x = 0}` is cyclic of order `n`, generated by
the class of `1/n`; hence it is isomorphic to `ZMod n`.

The isomorphism is written down explicitly: the `AddMonoidHom` `φ : ZMod n →+ QZ` sends the class
of `k : ℤ` to the class of `k / n`.  It is injective (`ZMod.lift_injective`: `k / n ∈ ℤ` forces
`n ∣ k`) and its image is exactly the `n`-torsion (if `n • x = 0`, a lift `q ∈ ℚ` of `x` satisfies
`n q ∈ ℤ`, so `x` is the class of `m / n` for some `m : ℤ`).
-/

namespace Work.Pi6.UCT

noncomputable section

open AddCommGroup

theorem zmodTorsionQZ (n : ℕ) (hn : 0 < n) :
    Nonempty (ZMod n ≃+ Submodule.torsionBy ℤ Work.Pi6.UCT.QZ (n : ℤ)) := by
  classical
  have hnq : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  -- The homomorphism `ℤ → QZ`, `k ↦ k / n mod 1`.
  let f : ℤ →+ Work.Pi6.UCT.QZ :=
    { toFun := fun k => (((k : ℚ) / (n : ℚ)) : Work.Pi6.UCT.QZ)
      map_zero' := by simp
      map_add' := by intro a b; rw [Int.cast_add, add_div]; rfl }
  -- `f n = 0`, so it descends to `ZMod n`.
  have hfn : f (n : ℤ) = 0 := by
    change ((((n : ℤ) : ℚ) / (n : ℚ) : ℚ) : Work.Pi6.UCT.QZ) = 0
    rw [Int.cast_natCast, div_self hnq]
    exact AddCircle.coe_period (1 : ℚ)
  let φ : ZMod n →+ Work.Pi6.UCT.QZ := ZMod.lift n ⟨f, hfn⟩
  have hφ : ∀ k : ℤ, φ (k : ZMod n) = (((k : ℚ) / (n : ℚ)) : Work.Pi6.UCT.QZ) := by
    intro k; rw [ZMod.lift_coe]; rfl
  -- Injectivity: `k / n = 0` in `ℚ / ℤ` forces `n ∣ k`.
  have hinj : Function.Injective φ := by
    rw [ZMod.lift_injective]
    intro m hm
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
    have h1 : (((m : ℚ) / (n : ℚ)) : Work.Pi6.UCT.QZ) = 0 := hm
    rw [AddCircle.coe_eq_zero_iff] at h1
    obtain ⟨k, hk⟩ := h1
    have h : (k : ℚ) = (m : ℚ) / (n : ℚ) := by simpa using hk
    have h2 : (m : ℚ) = (k : ℚ) * (n : ℚ) := by
      rw [h, div_mul_cancel₀ _ hnq]
    have h3 : m = k * (n : ℤ) := by exact_mod_cast h2
    exact ⟨k, by rw [h3, mul_comm]⟩
  -- The image lies in the `n`-torsion.
  have hmem : ∀ x : ZMod n, φ x ∈ Submodule.torsionBy ℤ Work.Pi6.UCT.QZ (n : ℤ) := by
    intro x
    rw [Submodule.mem_torsionBy_iff]
    obtain ⟨k, rfl⟩ := ZMod.intCast_surjective x
    rw [hφ k, ← AddCircle.coe_zsmul]
    have hz : (n : ℤ) • ((k : ℚ) / (n : ℚ)) = (k : ℚ) := by
      rw [zsmul_eq_mul]
      push_cast
      field_simp
    rw [hz]
    exact (AddCircle.coe_eq_zero_iff (1 : ℚ)).mpr ⟨k, by simp⟩
  let ψ : ZMod n →+ ↥(Submodule.torsionBy ℤ Work.Pi6.UCT.QZ (n : ℤ)) := φ.codRestrict _ hmem
  have hψ : ∀ x : ZMod n,
      ((ψ x : ↥(Submodule.torsionBy ℤ Work.Pi6.UCT.QZ (n : ℤ))) : Work.Pi6.UCT.QZ) = φ x :=
    fun x => rfl
  -- Surjectivity onto the `n`-torsion.
  have hsurj : Function.Surjective ψ := by
    intro y
    have hy : (n : ℤ) • (y : Work.Pi6.UCT.QZ) = 0 := Submodule.smul_coe_torsionBy (n : ℤ) y
    obtain ⟨q, hq⟩ := QuotientAddGroup.mk_surjective (y : Work.Pi6.UCT.QZ)
    have hq' : (q : Work.Pi6.UCT.QZ) = (y : Work.Pi6.UCT.QZ) := hq
    have h2 : (n : ℤ) • (q : Work.Pi6.UCT.QZ) = 0 := by rw [hq']; exact hy
    rw [← AddCircle.coe_zsmul] at h2
    obtain ⟨m, hm⟩ := (AddCircle.coe_eq_zero_iff (1 : ℚ)).mp h2
    refine ⟨(m : ZMod n), Subtype.ext ?_⟩
    rw [hψ]
    have hm1 : (m : ℚ) = (n : ℤ) • q := by simpa using hm
    have hm2 : (m : ℚ) = (n : ℚ) * q := by
      rw [hm1, zsmul_eq_mul]
      push_cast
      ring
    rw [hφ m]
    have hqeq : (m : ℚ) / (n : ℚ) = q := by
      rw [hm2]
      field_simp
    rw [hqeq, hq']
  exact ⟨AddEquiv.ofBijective ψ
    ⟨fun a b hab => hinj (by
        have := congrArg
          (fun z : ↥(Submodule.torsionBy ℤ Work.Pi6.UCT.QZ (n : ℤ)) =>
            (z : Work.Pi6.UCT.QZ)) hab
        simpa [hψ] using this), hsurj⟩⟩

end

end Work.Pi6.UCT
