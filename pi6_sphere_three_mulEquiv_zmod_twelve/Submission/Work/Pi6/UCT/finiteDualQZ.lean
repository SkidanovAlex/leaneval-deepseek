/-!
# A finite abelian group is its own group of `ℚ/ℤ`-valued characters

For a finite abelian group `A` we construct a (noncanonical) isomorphism
`A ≃ₗ[ℤ] Hom_ℤ(A, ℚ/ℤ)`, where `ℚ/ℤ = Work.Pi6.UCT.QZ = AddCircle (1 : ℚ)`.

This is the step that turns `H^{n+1} ≅ Hom(Hₙ, ℚ/ℤ)` into `H^{n+1} ≅ Hₙ`.

The argument is the structure theorem for finite abelian groups:

* **Cyclic case** (`finDualZModQZ`): `Hom_ℤ(ZMod n, ℚ/ℤ) ≅ ZMod n` for `0 < n`.  Evaluation at
  `1` identifies `Hom_ℤ(ZMod n, ℚ/ℤ)` with the `n`-torsion `T = {t : ℚ/ℤ // n • t = 0}`
  (a homomorphism out of `ZMod n` is determined by its value at `1`, and conversely any `t` with
  `n • t = 0` gives such a homomorphism), and `T ≅ ZMod n` because `T` is the cyclic subgroup
  generated by the class of `1/n`, which has additive order exactly `n`.  The second fact is the
  lemma `Work.Pi6.UCT.zmodTorsionQZ` (imported from `Pi6/UCT/zmodTorsionQZ.lean`).
* **General case**: `AddCommGroup.equiv_directSum_zmod_of_finite'` writes `A ≅ ⨁ i, ZMod (n i)`
  with all `n i > 1` (finitely many `i`).  Then `Hom_ℤ(⨁ i, M i, N) ≅ ∏ i, Hom_ℤ(M i, N)`
  (`DirectSum.linearEquivFunOnFintype` followed by `LinearMap.lsum`), and for finite index the
  product `∏ i, ZMod (n i)` is the direct sum `⨁ i, ZMod (n i) ≅ A`.

NOTE for downstream files: the helpers below are `private` so that this file can be imported
without any risk of a name clash.  The only public declaration is `finiteDualQZ`.
-/

set_option linter.style.haveILetI false

namespace Work.Pi6.UCT

noncomputable section

open scoped DirectSum

/-! ## The cyclic case -/

/-- `k ↦ k • u`, as an additive homomorphism `ℤ →+ QZ`. -/
private def finDualSmulHom (u : QZ) : ℤ →+ QZ where
  toFun k := k • u
  map_zero' := by simp
  map_add' k l := by simp [add_zsmul]

private lemma finDualSmulHom_apply_nat (u : QZ) (n : ℕ) :
    finDualSmulHom u (n : ℤ) = (n : ℤ) • u := rfl

/-- Given `u` with `n • u = 0`, the `ℤ`-linear map `ZMod n → QZ` sending `1` to `u`
(using the universal property of `ZMod n = ℤ ⧸ nℤ`). -/
private def finDualHomOfTorsion (n : ℕ) (u : QZ) (hu : (n : ℤ) • u = 0) :
    (ZMod n →ₗ[ℤ] QZ) :=
  (ZMod.lift n ⟨finDualSmulHom u, by rw [finDualSmulHom_apply_nat]; exact hu⟩).toIntLinearMap

private lemma finDualHomOfTorsion_apply_one (n : ℕ) (u : QZ) (hu : (n : ℤ) • u = 0) :
    finDualHomOfTorsion n u hu 1 = u := by
  have h1 : ((1 : ℤ) : ZMod n) = 1 := by simp
  have key : (ZMod.lift n ⟨finDualSmulHom u, by rw [finDualSmulHom_apply_nat]; exact hu⟩)
      ((1 : ℤ) : ZMod n) = u := by
    rw [ZMod.lift_coe]
    simp [finDualSmulHom]
  simpa [finDualHomOfTorsion, h1] using key

/-- Evaluation at `1`, as a map from `ZMod n`-valued characters to the `n`-torsion of `ℚ/ℤ`. -/
private def finDualEvalOne (n : ℕ) :
    (ZMod n →ₗ[ℤ] QZ) →+ Submodule.torsionBy ℤ QZ (n : ℤ) where
  toFun f := ⟨f 1, by
    rw [Submodule.mem_torsionBy_iff, Nat.cast_smul_eq_nsmul, ← map_nsmul,
      show n • (1 : ZMod n) = 0 from by rw [nsmul_eq_mul, mul_one, ZMod.natCast_self],
      map_zero]⟩
  map_zero' := by ext; simp
  map_add' f g := by ext; simp

private lemma finDualEvalOne_injective (n : ℕ) (hn : 0 < n) :
    Function.Injective (finDualEvalOne n) := by
  intro f g h
  haveI : NeZero n := ⟨hn.ne'⟩
  have h' : f 1 = g 1 := congrArg Subtype.val h
  ext x
  have hx : x.val • (1 : ZMod n) = x := by
    rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  calc f x = f (x.val • (1 : ZMod n)) := by rw [hx]
    _ = x.val • f 1 := by rw [map_nsmul]
    _ = x.val • g 1 := by rw [h']
    _ = g (x.val • (1 : ZMod n)) := by rw [map_nsmul]
    _ = g x := by rw [hx]

private lemma finDualEvalOne_surjective (n : ℕ) : Function.Surjective (finDualEvalOne n) := by
  rintro ⟨u, hu⟩
  rw [Submodule.mem_torsionBy_iff] at hu
  exact ⟨finDualHomOfTorsion n u hu, Subtype.ext (finDualHomOfTorsion_apply_one n u hu)⟩

/-- A homomorphism out of `ZMod n` is determined by its value at `1`. -/
private def finDualEvalOneEquiv (n : ℕ) (hn : 0 < n) :
    (ZMod n →ₗ[ℤ] QZ) ≃+ Submodule.torsionBy ℤ QZ (n : ℤ) :=
  AddEquiv.ofBijective (finDualEvalOne n)
    ⟨finDualEvalOne_injective n hn, finDualEvalOne_surjective n⟩

/-- **The cyclic case**: `Hom_ℤ(ZMod n, ℚ/ℤ) ≅ ZMod n` for `0 < n`. -/
private theorem finDualZModQZ (n : ℕ) (hn : 0 < n) :
    Nonempty ((ZMod n →ₗ[ℤ] QZ) ≃ₗ[ℤ] ZMod n) := by
  -- `Work.Pi6.UCT.zmodTorsionQZ`: the `n`-torsion of `ℚ/ℤ` is cyclic of order `n`
  obtain ⟨e⟩ := zmodTorsionQZ n hn
  exact ⟨((finDualEvalOneEquiv n hn).trans e.symm).toIntLinearEquiv⟩

/-- **A finite abelian group is its own group of `ℚ/ℤ`-valued characters** (noncanonically):
`A ≅ Hom_ℤ(A, ℚ/ℤ)` for `A` finite, where `ℚ/ℤ = Work.Pi6.UCT.QZ = AddCircle (1 : ℚ)`.
This is the step that turns `H^{n+1} ≅ Hom(Hₙ, ℚ/ℤ)` into `H^{n+1} ≅ Hₙ`.

Suggested route (via the structure result of finite abelian groups).  For a cyclic group:
`Hom_ℤ(ZMod m, QZ) ≅ ZMod m` — the map `f ↦ f 1` is injective (a hom out of `ZMod m` is
determined by its value at `1`) and identifies `Hom(ZMod m, QZ)` with the `m`-torsion
`{t : QZ // m • t = 0}`; the latter is `ZMod m` through `x ↦ (x.val : ℚ)/m` (injective since
`x.val / m ∈ ℤ → m ∣ x.val`); the map is onto the `m`-torsion, and `Nat.card` of the `m`-torsion is
bounded by `m` (`AddCircle.card_torsion_le_of_isSMulRegular` with `p = 1`, `𝕜 = ℚ`), so it is
bijective.  For general finite `A`: use `AddCommGroup.equiv_directSum_zmod_of_finite'` and the
isomorphism `Hom(⨁ Mᵢ, T) ≅ ∏ᵢ Hom(Mᵢ, T)` for finite index (`DirectSum.toModule` and its
components), together with
`DirectSum.linearEquivFunOnFintype : (⨁ i, M i) ≃ₗ[ℚ] (∀ i, M i)` or its `ℤ`-linear counterpart.

A different route that is also acceptable: use
`CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity` (Mathlib, `Analysis/Fourier`) with `M = ℂ`
to get `A ≅ AddChar A ℂ`, then bridge `AddChar A ℂ ≅ Hom_ℤ(A, QZ)` via
`AddChar A ℂ ≅ Hom(A, rootsOfUnity (Nat.card A) ℂ) ≅ Hom(A, QZ[Nat.card A]) ≅ Hom(A, QZ)`.

The statement is `ℤ`-linear; if your construction only gives an additive equivalence, note that
all `ℤ`-module structures on a fixed additive group agree (`Subsingleton.elim`).
Vocabulary: `Work.Pi6.UCT.QZ`.-/
theorem finiteDualQZ (A : Type*) [AddCommGroup A] [Finite A] :
    Nonempty (A ≃ₗ[ℤ] (A →ₗ[ℤ] Work.Pi6.UCT.QZ)) := by
  classical
  -- Structure theorem: `A ≅ ⨁ i, ZMod (n i)` with `n i > 1`
  obtain ⟨ι, hι, n, hn, e⟩ := AddCommGroup.equiv_directSum_zmod_of_finite' A
  let e' := e.some
  have cyc : ∀ i, (ZMod (n i) →ₗ[ℤ] QZ) ≃ₗ[ℤ] ZMod (n i) :=
    fun i => (finDualZModQZ (n i) (by have := hn i; omega)).some
  let eLin : A ≃ₗ[ℤ] (⨁ i, ZMod (n i)) := e'.toIntLinearEquiv
  -- `Hom(A, QZ) ≅ Hom(⨁ i, ZMod (n i), QZ)`
  let s1 : (A →ₗ[ℤ] QZ) ≃ₗ[ℤ] ((⨁ i, ZMod (n i)) →ₗ[ℤ] QZ) :=
    LinearEquiv.congrLeft QZ ℤ eLin
  -- `≅ Hom(∏ i, ZMod (n i), QZ)`
  let s2 : ((⨁ i, ZMod (n i)) →ₗ[ℤ] QZ) ≃ₗ[ℤ] ((i : ι) → ZMod (n i)) →ₗ[ℤ] QZ :=
    LinearEquiv.congrLeft QZ ℤ (DirectSum.linearEquivFunOnFintype ℤ ι (fun i => ZMod (n i)))
  -- `≅ ∏ i, Hom(ZMod (n i), QZ)`
  let s3 : (((i : ι) → ZMod (n i)) →ₗ[ℤ] QZ) ≃ₗ[ℤ] ((i : ι) → ZMod (n i) →ₗ[ℤ] QZ) :=
    (LinearMap.lsum ℤ (fun i => ZMod (n i)) ℤ).symm
  -- `≅ ∏ i, ZMod (n i)` and back through the direct sum to `A`
  let s4 : ((i : ι) → ZMod (n i) →ₗ[ℤ] QZ) ≃ₗ[ℤ] ((i : ι) → ZMod (n i)) :=
    LinearEquiv.piCongrRight cyc
  let s5 : ((i : ι) → ZMod (n i)) ≃ₗ[ℤ] (⨁ i, ZMod (n i)) :=
    (DirectSum.linearEquivFunOnFintype ℤ ι (fun i => ZMod (n i))).symm
  let s6 : (⨁ i, ZMod (n i)) ≃ₗ[ℤ] A := eLin.symm
  exact ⟨(s1.trans (s2.trans (s3.trans (s4.trans (s5.trans s6))))).symm⟩

end

end Work.Pi6.UCT
