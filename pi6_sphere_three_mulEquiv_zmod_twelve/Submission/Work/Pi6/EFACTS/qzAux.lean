/-!
# Helper facts for `Work.Pi6.EFACTS.qzDual`

Elementary parts of the theory of the injective cogenerator `ℚ ⧸ ℤ`
(`AddCircle (1 : ℚ)`) needed for `Work.Pi6.EFACTS.qzDual`:

* `ℚ` and the rational circle satisfy Baer's criterion;
* characters into the rational circle separate points of any abelian group;
* the dual `Hom_ℤ(ZMod k, ℚ ⧸ ℤ)` is isomorphic (as a `ℤ`-module) to `ZMod k`.
-/

namespace Work.Pi6.EFACTS.QZ

open CharacterModule

/-! ## Divisibility and Baer's criterion -/

theorem baer_rat : Module.Baer ℤ ℚ := Module.Baer.of_divisible ℚ

theorem baer_circle : Module.Baer ℤ (AddCircle (1 : ℚ)) := Module.Baer.of_divisible _

theorem injective_circle : Module.Injective ℤ (AddCircle (1 : ℚ)) :=
  Module.Baer.injective baer_circle

/-! ## Separation of points -/

/-- Any nonzero element of an abelian group is detected by a character into the rational circle. -/
theorem exists_linearMap_apply_ne_zero {A : Type*} [AddCommGroup A] {a : A} (ha : a ≠ 0) :
    ∃ f : A →ₗ[ℤ] AddCircle (1 : ℚ), f a ≠ 0 := by
  obtain ⟨c, hc⟩ := CharacterModule.exists_character_apply_ne_zero_of_ne_zero ha
  refine ⟨c.toIntLinearMap, fun h => hc ?_⟩
  exact (congrFun (AddMonoidHom.coe_toIntLinearMap c) a).symm.trans h

/-- If there are no nonzero characters on `A` then `A` is trivial. -/
theorem subsingleton_of_subsingleton_character {A : Type*} [AddCommGroup A]
    (h : Subsingleton (A →ₗ[ℤ] AddCircle (1 : ℚ))) : Subsingleton A := by
  refine ⟨fun a b => ?_⟩
  have hz : ∀ a : A, a = 0 := fun a =>
    CharacterModule.eq_zero_of_character_apply fun c => by
      have h0 : c.toIntLinearMap = (0 : A →ₗ[ℤ] AddCircle (1 : ℚ)) := Subsingleton.elim _ _
      have h1 : c.toIntLinearMap a = 0 := by rw [h0]; rfl
      have h2 : c a = c.toIntLinearMap a := congrFun (AddMonoidHom.coe_toIntLinearMap c) a |>.symm
      rw [h2]; exact h1
  rw [hz a, hz b]

/-! ## The dual of `ZMod k` -/

section ZModDual

/-- The element `1/k` of the rational circle. -/
noncomputable def qcirc (k : ℕ) : AddCircle (1 : ℚ) :=
  (↑((k : ℚ)⁻¹) : AddCircle (1 : ℚ))

lemma addOrderOf_qcirc (k : ℕ) (hk : 0 < k) : addOrderOf (qcirc k) = k := by
  have h := AddCircle.addOrderOf_period_div (𝕜 := ℚ) (p := (1 : ℚ)) hk
  simpa [qcirc, one_div] using h

lemma zsmul_qcirc_eq_zero_iff (k : ℕ) (hk : 0 < k) (m : ℤ) :
    m • qcirc k = 0 ↔ (k : ℤ) ∣ m := by
  rw [← addOrderOf_dvd_iff_zsmul_eq_zero, addOrderOf_qcirc k hk]

/-- The additive homomorphism `ℤ → ℚ ⧸ ℤ`, `m ↦ m • (1/k)`. -/
noncomputable def zsmulQ (k : ℕ) : ℤ →+ AddCircle (1 : ℚ) :=
  (LinearMap.toSpanSingleton ℤ (AddCircle (1 : ℚ)) (qcirc k)).toAddMonoidHom

@[simp] lemma zsmulQ_apply (k : ℕ) (m : ℤ) : zsmulQ k m = m • qcirc k := by
  show (LinearMap.toSpanSingleton ℤ (AddCircle (1 : ℚ)) (qcirc k)).toAddMonoidHom m = m • qcirc k
  rw [LinearMap.toAddMonoidHom_coe, LinearMap.toSpanSingleton_apply]

lemma zsmulQ_self (k : ℕ) (hk : 0 < k) : zsmulQ k (k : ℤ) = 0 := by
  rw [zsmulQ_apply, zsmul_qcirc_eq_zero_iff k hk]

/-- `ZMod k →ₗ[ℤ] ℚ ⧸ ℤ`, `x ↦ x • (1/k)`. -/
noncomputable def phi0 (k : ℕ) (hk : 0 < k) : ZMod k →ₗ[ℤ] AddCircle (1 : ℚ) :=
  (ZMod.lift k ⟨zsmulQ k, zsmulQ_self k hk⟩).toIntLinearMap

lemma phi0_intCast (k : ℕ) (hk : 0 < k) (m : ℤ) :
    phi0 k hk (m : ZMod k) = m • qcirc k := by
  show (ZMod.lift k ⟨zsmulQ k, zsmulQ_self k hk⟩) (Int.cast m) = m • qcirc k
  rw [ZMod.lift_coe]
  exact zsmulQ_apply k m

/-- The `k`-torsion of the rational circle is generated by `1/k`. -/
lemma circle_torsion (k : ℕ) (hk : 0 < k) {y : AddCircle (1 : ℚ)} (hy : k • y = 0) :
    ∃ m : ℤ, m • qcirc k = y := by
  obtain ⟨r, rfl⟩ := QuotientAddGroup.mk_surjective y
  rw [← AddCircle.coe_nsmul (1 : ℚ), AddCircle.coe_eq_zero_iff] at hy
  obtain ⟨m, hm⟩ := hy
  have hm' : (m : ℚ) = (k : ℚ) * r := by
    simpa [zsmul_eq_mul, nsmul_eq_mul] using hm
  have hr : r = (m : ℚ) * (k : ℚ)⁻¹ := by
    have hkq : (k : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
    have hdiv : r = (m : ℚ) / (k : ℚ) := by
      rw [eq_div_iff hkq, mul_comm]
      exact hm'.symm
    rwa [div_eq_mul_inv] at hdiv
  refine ⟨m, ?_⟩
  rw [qcirc, ← AddCircle.coe_zsmul (1 : ℚ), zsmul_eq_mul, hr]

/-- The `ℤ`-linear map `ZMod k →ₗ (ZMod k →ₗ ℚ ⧸ ℤ)`, `x ↦ (y ↦ φ₀ (x * y))`. -/
noncomputable def Phi (k : ℕ) (hk : 0 < k) :
    ZMod k →ₗ[ℤ] (ZMod k →ₗ[ℤ] AddCircle (1 : ℚ)) where
  toFun x := (phi0 k hk).comp (LinearMap.mulLeft ℤ x)
  map_add' x x' := by
    ext y
    simp only [LinearMap.comp_apply, LinearMap.add_apply, LinearMap.mulLeft_apply, add_mul,
      map_add]
  map_smul' m x := by
    ext y
    simp only [LinearMap.comp_apply, LinearMap.smul_apply, LinearMap.mulLeft_apply]
    rw [smul_mul_assoc, map_smul]
    rfl

lemma Phi_apply (k : ℕ) (hk : 0 < k) (x y : ZMod k) :
    Phi k hk x y = phi0 k hk (x * y) := by
  show (phi0 k hk) ((LinearMap.mulLeft ℤ x) y) = phi0 k hk (x * y)
  rw [LinearMap.mulLeft_apply]

lemma Phi_injective (k : ℕ) (hk : 0 < k) : Function.Injective (Phi k hk) := by
  intro x x' hxx
  have h₁ : Phi k hk (x - x') = 0 := by rw [map_sub, hxx, sub_self]
  have h₂ : x - x' = 0 := by
    have h1 : phi0 k hk (x - x') = 0 := by
      have hc := congrArg (fun f : ZMod k →ₗ[ℤ] AddCircle (1 : ℚ) => f 1) h₁
      simpa [Phi_apply, mul_one] using hc
    obtain ⟨n, hn⟩ := ZMod.intCast_surjective (x - x')
    rw [← hn] at h1 ⊢
    rw [phi0_intCast k hk n] at h1
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd n k).2 ((zsmul_qcirc_eq_zero_iff k hk n).1 h1)
  rwa [sub_eq_zero] at h₂

lemma Phi_surjective (k : ℕ) (hk : 0 < k) : Function.Surjective (Phi k hk) := by
  intro ψ
  have htor : k • ψ 1 = 0 := by
    rw [← map_nsmul, show k • (1 : ZMod k) = 0 from by
      rw [nsmul_eq_mul, mul_one, ZMod.natCast_self], map_zero]
  obtain ⟨m, hm⟩ := circle_torsion k hk htor
  refine ⟨(m : ZMod k), ?_⟩
  ext y
  obtain ⟨n, hn⟩ := ZMod.intCast_surjective y
  rw [← hn]
  have h2 : ψ (↑n : ZMod k) = (m * n) • qcirc k := by
    rw [← Int.smul_one_eq_cast n, map_zsmul, ← hm, smul_comm, ← smul_smul]
  rw [Phi_apply, ← Int.cast_mul, phi0_intCast k hk (m * n), h2]

/-- **The dual of `ZMod k` is `ZMod k`.** -/
noncomputable def zmodDualEquiv (k : ℕ) (hk : 0 < k) :
    (ZMod k →ₗ[ℤ] AddCircle (1 : ℚ)) ≃ₗ[ℤ] ZMod k :=
  (LinearEquiv.ofBijective (Phi k hk) ⟨Phi_injective k hk, Phi_surjective k hk⟩).symm

theorem zmodDual (k : ℕ) (hk : 0 < k) :
    Nonempty ((ZMod k →ₗ[ℤ] AddCircle (1 : ℚ)) ≃ₗ[ℤ] ZMod k) :=
  ⟨zmodDualEquiv k hk⟩

end ZModDual

end Work.Pi6.EFACTS.QZ
