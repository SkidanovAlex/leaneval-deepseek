import Mathlib
import Submission.Work.Pi6.EFACTS.Basic
import Submission.Work.Pi6.EFACTS.Wang
set_option backward.isDefEq.respectTransparency false  -- v435port
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false  -- v435port
set_option backward.isDefEq.respectTransparency.types false  -- v435port

/-!
# The cohomology ring of the fibre of the cover projection

`K2ZFacts` applies to any `K(ℤ,2)`-model through degree `≥ 10`; the fibre of `proj g3` over `∞` is
one (`Work.Pi6.EFACTS.fibreModel`), so its cohomology is `ℤ` in the even degrees `≤ 8`, generated by
the powers of a degree-`2` class, and vanishes in the odd degrees `≤ 9`; the same holds over any
field with `finrank = 1`.
-/

open CategoryTheory CategoryTheory.Limits
open scoped Topology

set_option maxHeartbeats 1600000
set_option linter.unusedVariables false

namespace Work.Pi6.EFACTS

noncomputable section

/-- **The cohomology ring of the fibre** from `K2ZFacts` and the `K(ℤ,2)`-structure of the fibre.
The two clauses are the integral and the field-coefficient parts of `Work.Pi6.K2ZFacts` at `N = 11`. -/
theorem fibreCoh {P3 : Type} [TopologicalSpace P3] (g3 : C(S3, P3)) (x₀ : fib g3)
    (hfib : Work.Serre.IsEMSpaceUpTo ℤ 2 (by norm_num) 11 (fib g3) x₀)
    (hZ : Work.Pi6.K2ZFacts) :
    (∃ x : Coh ℤ (fib g3) 2,
        (∀ k : ℕ, k ≤ 4 → ∀ a : Coh ℤ (fib g3) (2 * k), ∃! n : ℤ, a = n • cpow x k) ∧
        (∀ k : ℕ, k ≤ 4 → Subsingleton (Coh ℤ (fib g3) (2 * k + 1)))) ∧
      (∀ (𝕜 : Type) [Field 𝕜], ∃ w : Coh 𝕜 (fib g3) 2,
        ∀ k : ℕ, k ≤ 4 → cpow w k ≠ 0 ∧ Module.finrank 𝕜 (Coh 𝕜 (fib g3) (2 * k)) = 1 ∧
          Subsingleton (Coh 𝕜 (fib g3) (2 * k + 1))) := by
  exact hZ (fib g3) x₀ 11 (by norm_num) hfib

end

end Work.Pi6.EFACTS
