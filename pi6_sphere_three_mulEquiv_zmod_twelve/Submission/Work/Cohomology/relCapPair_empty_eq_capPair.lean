import Mathlib
import Submission.Work.Cohomology.relChains_empty_homology_iso
import Submission.Work.Cohomology.relComplex_empty_homology_iso
import Submission.Work.Cohomology.RelCapHTransfer
import Submission.Work.Cohomology.CapH
import Submission.Work.Cohomology.relChainsProjective

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory AlgebraicTopology Simplicial CategoryTheory.Limits
open scoped Simplicial

namespace Work.Cohomology

theorem relCapPair_empty_eq_capPair (X : TopCat) (n m : ℕ)
    (x : (Work.Cohomology.relComplex ℤ X ∅).homology n)
    (c : (Work.Cohomology.singularChains ℤ X).homology (n + m)) :
    (Work.Cohomology.relCapPair (TopCat.of X) ∅ n m) x
        ((HomologicalComplex.homologyMap
          (CategoryTheory.Limits.cokernel.π (Work.Cohomology.inclChains X ∅)) (n + m)) c)
      = (Work.Cohomology.capPair ℤ (TopCat.toSSet.obj X) n m)
          ((HomologicalComplex.homologyMap (Work.Cohomology.relIncl ℤ X ∅) n) x) c := by
  -- `TopCat.of X` is definitionally `X`, so we may ignore the coercion.
  change (relCapPair X ∅ n m) x
        ((HomologicalComplex.homologyMap (cokernel.π (inclChains X ∅)) (n + m)) c)
      = (capPair ℤ (TopCat.toSSet.obj X) n m)
          ((HomologicalComplex.homologyMap (relIncl ℤ X ∅) n) x) c
  -- The homology classes are generated by cycles; it suffices to consider those.
  obtain ⟨z, rfl⟩ :=
    (ModuleCat.epi_iff_surjective ((relComplex ℤ X ∅).homologyπ n)).mp inferInstance x
  obtain ⟨c₀, rfl⟩ :=
    (ModuleCat.epi_iff_surjective ((singularChains ℤ X).homologyπ (n + m))).mp inferInstance c
  -- `homologyMap` is compatible with `homologyπ` and `cyclesMap` (naturality of `homologyπ`).
  have hc : (HomologicalComplex.homologyMap (cokernel.π (inclChains X ∅)) (n + m))
      ((singularChains ℤ X).homologyπ (n + m) c₀)
      = (relChains X ∅).homologyπ (n + m)
          (HomologicalComplex.cyclesMap (cokernel.π (inclChains X ∅)) (n + m) c₀) :=
    congrArg (fun g => g.hom c₀)
      (HomologicalComplex.homologyπ_naturality (φ := cokernel.π (inclChains X ∅)) (n + m))
  have hx : (HomologicalComplex.homologyMap (relIncl ℤ X ∅) n)
      ((relComplex ℤ X ∅).homologyπ n z)
      = (singularCochainComplex ℤ X).homologyπ n
          (HomologicalComplex.cyclesMap (relIncl ℤ X ∅) n z) :=
    congrArg (fun g => g.hom z)
      (HomologicalComplex.homologyπ_naturality (φ := relIncl ℤ X ∅) n)
  rw [hc, hx]
  -- Evaluate both pairings on the cycles through their computation rules.
  rw [relCapPair_apply]
  change (singularChains ℤ X).homologyπ m
        (relCapPairZ X ∅ n m z
          (HomologicalComplex.cyclesMap (cokernel.π (inclChains X ∅)) (n + m) c₀))
      = (capPair ℤ (TopCat.toSSet.obj X) n m)
          (((cochainC ℤ (TopCat.toSSet.obj X)).homologyπ n)
            (HomologicalComplex.cyclesMap (relIncl ℤ X ∅) n z))
          (((chainC ℤ (TopCat.toSSet.obj X)).homologyπ (n + m)) c₀)
  rw [capPair_apply]
  -- Both sides are the homology class of the cycle-level cap products; these coincide.
  have hAB : relCapPairZ X ∅ n m z
        (HomologicalComplex.cyclesMap (cokernel.π (inclChains X ∅)) (n + m) c₀)
      = capPairZ ℤ (TopCat.toSSet.obj X) n m
          (HomologicalComplex.cyclesMap (relIncl ℤ X ∅) n z) c₀ := by
    apply iCycles_injective_C ℤ (singularChains ℤ X) m
    change (singularChains ℤ X).iCycles m
          (relCapPairZ X ∅ n m z
            (HomologicalComplex.cyclesMap (cokernel.π (inclChains X ∅)) (n + m) c₀))
        = (chainC ℤ (TopCat.toSSet.obj X)).iCycles m
            (capPairZ ℤ (TopCat.toSSet.obj X) n m
              (HomologicalComplex.cyclesMap (relIncl ℤ X ∅) n z) c₀)
    rw [relCapPairZ_iCycles, capPairZ_iCycles]
    -- The underlying chains of the two cycles coincide: both are the absolute cap product
    -- of `z` (viewed as an absolute cocycle) with `c₀`.
    have hcyc₁ : (relChains X ∅).iCycles (n + m)
          (HomologicalComplex.cyclesMap (cokernel.π (inclChains X ∅)) (n + m) c₀)
        = ((cokernel.π (inclChains X ∅)).f (n + m)) ((singularChains ℤ X).iCycles (n + m) c₀) :=
      congrArg (fun g => g.hom c₀)
        (HomologicalComplex.cyclesMap_i (cokernel.π (inclChains X ∅)) (n + m))
    have hcyc₂ : (cochainC ℤ (TopCat.toSSet.obj X)).iCycles n
          (HomologicalComplex.cyclesMap (relIncl ℤ X ∅) n z)
        = ((relIncl ℤ X ∅).f n) ((relComplex ℤ X ∅).iCycles n z) :=
      congrArg (fun g => g.hom z)
        (HomologicalComplex.cyclesMap_i (relIncl ℤ X ∅) n)
    rw [hcyc₁, hcyc₂]
    rw [relChains_cokernelIso_canon_apply, relCapHalf_apply_incl, relIncl_f]
    simp only [ModuleCat.hom_ofHom]
    rfl
  rw [hAB]
  rfl

end Work.Cohomology
