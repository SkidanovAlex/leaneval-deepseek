import Mathlib
import Submission.Work.Cohomology.CupRing
import Submission.Work.Cohomology.Singular
import Submission.Work.Cohomology.h0Evaluation

/-!
# `H⁰` of a path-connected space is generated by the unit class

For a path-connected topological space `X`, the zeroth singular cohomology `H⁰(X; ℤ)` is generated,
as a `ℤ`-module, by the unit class `oneH`: the map `ℤ → H⁰(X;ℤ)`, `m ↦ m • oneH`, is surjective.

The proof goes through the description of `H⁰` on the singular cochain complex of the simplicial
set `Y := TopCat.toSSet.obj X`:

* every class `x` is the class of a `0`-cocycle `α` (`h0ClassOf_iCycles`);
* a `0`-cocycle of a path-connected space is *constant* on the generators — it takes the same value
  on all `0`-simplices (`eval_constancy`), so `α = c • unitCochain` for `c` the value at the base
  simplex, by `genEval_ext`;
* the class map is `ℤ`-linear in the cochain (`cocycleOf_smul`), so the class of `c • unitCochain`
  is `c • oneH`.
-/

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

/-- **`H⁰(X;ℤ)` of a path-connected space is generated by the unit class `oneH`.** -/
theorem exists_smul_oneH (X : TopCat) [PathConnectedSpace ↥X]
    (x : ↑(Work.Cohomology.singularCohomology ℤ 0 X)) :
    ∃ m : ℤ, x = m • Work.Cohomology.oneH ℤ (TopCat.toSSet.obj X) := by
  let Y := TopCat.toSSet.obj X
  let z := (Work.Cohomology.h0CycIso Y).hom x
  let α := (Work.Cohomology.SSetCochainComplex ℤ Y).iCycles 0 z
  have hα : Work.Cohomology.cochainDiff ℤ Y α = 0 :=
    Work.Cohomology.cochainDiff_iCycles ℤ Y 0 z
  have hxα : Work.Cohomology.cohomologyClassOf ℤ Y α hα = x :=
    Work.Cohomology.h0ClassOf_iCycles Y x
  -- a `0`-cocycle of a path-connected space is constant on the `0`-simplices
  have hconst : ∀ s : Y _⦋0⦌, Work.Cohomology.genEval ℤ Y α s
      = Work.Cohomology.genEval ℤ Y α (Work.Cohomology.baseSimplex X) := by
    intro s
    have hf : α.comp ((Work.Cohomology.singularChains ℤ X).d 1 0).hom = 0 := hα
    exact Work.Cohomology.eval_constancy ℤ X α hf s
  let c : ℤ := Work.Cohomology.genEval ℤ Y α (Work.Cohomology.baseSimplex X)
  have hαc : α = c • Work.Cohomology.unitCochain ℤ Y := by
    apply Work.Cohomology.genEval_ext
    intro σ
    rw [Work.Cohomology.genEval_smul, Work.Cohomology.genEval_unitCochain, smul_eq_mul, mul_one]
    exact hconst σ
  -- the class map is linear in the cochain
  have hclass_smul_R : ∀ (R : Type) [CommRing R] (W : SSet) (n : ℕ) (a : R)
      (β : Work.Cohomology.Cochain R W n)
      (hβ : Work.Cohomology.cochainDiff R W β = 0)
      (h : Work.Cohomology.cochainDiff R W (a • β) = 0),
      Work.Cohomology.cohomologyClassOf R W (a • β) h
        = a • Work.Cohomology.cohomologyClassOf R W β hβ := by
    intro R _ W n a β hβ h
    rw [Work.Cohomology.cohomologyClassOf, Work.Cohomology.cohomologyClassOf,
      Work.Cohomology.cocycleOf_smul, map_smul]
  have h' : Work.Cohomology.cochainDiff ℤ Y (c • Work.Cohomology.unitCochain ℤ Y) = 0 :=
    hαc ▸ hα
  have h2 : Work.Cohomology.cohomologyClassOf ℤ Y α hα
      = Work.Cohomology.cohomologyClassOf ℤ Y (c • Work.Cohomology.unitCochain ℤ Y) h' :=
    Work.Cohomology.cohomologyClassOf_congr (R := ℤ) (X := Y) hαc hα h'
  have h3 : Work.Cohomology.cohomologyClassOf ℤ Y (c • Work.Cohomology.unitCochain ℤ Y) h'
      = c • Work.Cohomology.oneH ℤ Y := by
    rw [Work.Cohomology.oneH]
    rw [← int_smul_eq_zsmul (inferInstance : Module ℤ
      ↑(HomologicalComplex.homology (Work.Cohomology.SSetCochainComplex ℤ Y) 0)) c]
    exact hclass_smul_R ℤ Y 0 c (Work.Cohomology.unitCochain ℤ Y)
      (Work.Cohomology.cochainDiff_unitCochain ℤ Y) h'
  exact ⟨c, hxα.symm.trans (h2.trans h3)⟩

end

end Work.Cohomology
