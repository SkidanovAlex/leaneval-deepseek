-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# `ker H₃(S³ × S³ → S³ × D⁴) ≅ ℤ`

The inclusion `S³ × S³ = ∂(S³ × D⁴) ⊆ S³ × D⁴` induces on `H₃` the map

`H₃(S³ × S³) ⟶ H₃(S³ × D⁴)`

which, under the identifications `H₃(S³ × S³) ≅ ℤ × ℤ` and `H₃(S³ × D⁴) ≅ ℤ`, is the
projection onto the first summand.  Its kernel is therefore `ℤ`, generated by the class of the
second sphere factor (which bounds inside `D⁴`).

The proof is elementary linear algebra once the two isomorphisms `H₃(S³ × S³) ≅ ℤ × ℤ` and
`H₃(S³ × D⁴) ≅ ℤ` are available: the map is surjective (it is the pullback of the projection
`S³ × D⁴ ⟶ S³`, which is a homotopy equivalence, composed with the homology of the projection
`S³ × S³ ⟶ S³`, which has the section `x ↦ (x, y₀)`), and the kernel of any surjection
`ℤ × ℤ ↠ ℤ` is cyclic (Bezout).
-/

set_option maxHeartbeats 1000000

open CategoryTheory AlgebraicTopology CategoryTheory.Limits
open scoped Topology

namespace Work.Cohomology

noncomputable section

/-! ## 1. A self-contained algebra lemma: the kernel of a surjection `ℤ × ℤ ↠ ℤ` is `ℤ` -/

/-- If `f : ℤ × ℤ →ₗ[ℤ] ℤ` is surjective then its kernel is isomorphic to `ℤ`.

Writing `a = f (1, 0)`, `b = f (0, 1)`, surjectivity supplies `u`, `v` with `u a + v b = 1`
(Bezout), and the kernel is generated by the primitive vector `(b, -a)`. -/
private lemma kerMod_int_prod_of_surjective (f : ℤ × ℤ →ₗ[ℤ] ℤ)
    (hf : Function.Surjective f) :
    Nonempty (kerMod f ≅ ModuleCat.of ℤ ℤ) := by
  classical
  obtain ⟨w, hw⟩ := hf 1
  have h1 : ∀ x : ℤ × ℤ, f x = x.1 * f (1, 0) + x.2 * f (0, 1) := by
    intro x
    have hx : x = x.1 • ((1, 0) : ℤ × ℤ) + x.2 • ((0, 1) : ℤ × ℤ) := by
      ext <;> simp
    rw [hx, map_add, map_smul, map_smul]
    simp [smul_eq_mul]
  have hbez : w.1 * f (1, 0) + w.2 * f (0, 1) = 1 := by
    have h := h1 w
    rw [hw] at h
    exact h.symm
  let gen : ℤ × ℤ := (f (0, 1), -f (1, 0))
  have hgen : gen ∈ LinearMap.ker f := by
    rw [LinearMap.mem_ker, h1 gen]
    show f (0, 1) * f (1, 0) + (-f (1, 0)) * f (0, 1) = 0
    ring
  have hsmul : ∀ t : ℤ, t • gen = (t * f (0, 1), t * (-f (1, 0))) := by
    intro t
    ext <;> simp [gen, smul_eq_mul]
  have hkey : ∀ t : ℤ, t • gen = 0 → t = 0 := by
    intro t ht
    have ht2 : t * f (0, 1) = 0 := by
      have h := congrArg Prod.fst ht
      rw [hsmul t] at h
      simpa using h
    have ht1 : t * f (1, 0) = 0 := by
      have h := congrArg Prod.snd ht
      rw [hsmul t] at h
      have h' : t * (-f (1, 0)) = 0 := by simpa using h
      rw [mul_neg, neg_eq_zero] at h'
      exact h'
    calc t = t * 1 := (mul_one t).symm
      _ = t * (w.1 * f (1, 0) + w.2 * f (0, 1)) := by rw [hbez]
      _ = w.1 * (t * f (1, 0)) + w.2 * (t * f (0, 1)) := by ring
      _ = 0 := by rw [ht1, ht2]; ring
  let ψ : ℤ →ₗ[ℤ] ↥(LinearMap.ker f) :=
    (LinearMap.toSpanSingleton ℤ (ℤ × ℤ) gen).codRestrict (LinearMap.ker f) (fun t => by
      have ht : (LinearMap.toSpanSingleton ℤ (ℤ × ℤ) gen) t = t • gen := rfl
      rw [LinearMap.mem_ker, ht, h1 (t • gen), hsmul t]
      ring)
  have hψ : ∀ t : ℤ, (ψ t : ℤ × ℤ) = t • gen := fun t => rfl
  have hinj : Function.Injective ψ := by
    intro s t hst
    have hst' : s • gen = t • gen := by
      have h := congrArg (fun z : ↥(LinearMap.ker f) => (z : ℤ × ℤ)) hst
      rwa [hψ s, hψ t] at h
    have h0 : (s - t) • gen = 0 := by
      rw [sub_smul, hst', sub_self]
    have := hkey (s - t) h0
    exact sub_eq_zero.mp this
  have hsurj : Function.Surjective ψ := by
    intro y
    have hy0 : f y.1 = 0 := y.2
    have hy : y.1.1 * f (1, 0) + y.1.2 * f (0, 1) = 0 := by
      rw [← h1 y.1]
      exact hy0
    refine ⟨w.2 * y.1.1 - w.1 * y.1.2, ?_⟩
    apply Subtype.ext
    rw [hψ, hsmul]
    have hy2 : y.1.2 * f (0, 1) = -(y.1.1 * f (1, 0)) := by linarith [hy]
    have hy1 : y.1.1 * f (1, 0) = -(y.1.2 * f (0, 1)) := by linarith [hy]
    have hbez' : w.2 * f (0, 1) + w.1 * f (1, 0) = 1 := by linarith [hbez]
    apply Prod.ext
    · calc (w.2 * y.1.1 - w.1 * y.1.2) * f (0, 1)
          = w.2 * (y.1.1 * f (0, 1)) - w.1 * (y.1.2 * f (0, 1)) := by ring
        _ = w.2 * (y.1.1 * f (0, 1)) + w.1 * (y.1.1 * f (1, 0)) := by rw [hy2]; ring
        _ = y.1.1 * (w.2 * f (0, 1) + w.1 * f (1, 0)) := by ring
        _ = y.1.1 * 1 := by rw [hbez']
        _ = y.1.1 := mul_one _
    · calc (w.2 * y.1.1 - w.1 * y.1.2) * (-f (1, 0))
          = w.2 * (-(y.1.1 * f (1, 0))) - w.1 * (-(y.1.2 * f (1, 0))) := by ring
        _ = w.2 * (y.1.2 * f (0, 1)) + w.1 * (y.1.2 * f (1, 0)) := by rw [hy1]; ring
        _ = y.1.2 * (w.2 * f (0, 1) + w.1 * f (1, 0)) := by ring
        _ = y.1.2 * 1 := by rw [hbez']
        _ = y.1.2 := mul_one _
  exact ⟨(ofKerIsoKerMod f).symm ≪≫ LinearEquiv.toModuleIso (LinearEquiv.ofBijective ψ ⟨hinj, hsurj⟩).symm⟩

/-- The `ModuleCat ℤ` object built from the kernel of a `ℤ`-linear map (with the module structure
selected by typeclass search) is isomorphic to `kerMod f` (with the structure pinned to
`Submodule.module`); over `ℤ` the two structures agree. -/
private def ofKerIsoKerModGen {M N : Type} [AddCommGroup M] [Module ℤ M] [AddCommGroup N]
    [Module ℤ N] (f : M →ₗ[ℤ] N) : ModuleCat.of ℤ ↥(LinearMap.ker f) ≅ kerMod f :=
  moduleCatOfIsoOfEq

/-! ## 2. The homology modules and the homeomorphism `S³ × S³ ⊆ S³ × D⁴ ≅ S³ × S³` -/

/-- `H₃(S³ × S³)`. -/
abbrev HA3 : ModuleCat ℤ := (singularChains ℤ (TopCat.of PairAT)).homology 3

/-- `H₃(S³ × D⁴)`. -/
abbrev HX3 : ModuleCat ℤ := (singularChains ℤ PairXT).homology 3

/-- `H₃(S³)`. -/
abbrev HS3 : ModuleCat ℤ := (singularChains ℤ Sph3T).homology 3

instance instContractibleDisk4T : ContractibleSpace ↥Disc4T := diskUnit_contractible' 4

/-- The homeomorphism `S³ × S³ ⊆ S³ × D⁴ ≅ S³ × S³` with the honest product of two spheres. -/
def sqHomeo : ↥PairAT ≃ₜ (↥Sph3T × ↥Sph3T) :=
  (Homeomorph.setCongr (show PairAT = (Set.univ : Set ↥Sph3T) ×ˢ sphereInUnit 4 from by
      ext p; simp [Set.mem_prod, PairAT])).trans
    ((Homeomorph.Set.prod (Set.univ : Set ↥Sph3T) (sphereInUnit 4)).trans
      ((Homeomorph.Set.univ ↥Sph3T).prodCongr (sphereInUnitHomeomorph 4)))

/-- A base point of the disc `D⁴`, used to split the projection `S³ × D⁴ ⟶ S³`. -/
noncomputable def basePtT : ↥Disc4T := Classical.choose (id_nullhomotopic ↥Disc4T)

theorem basePtT_spec :
    (ContinuousMap.id ↥Disc4T).Homotopic (ContinuousMap.const ↥Disc4T basePtT) :=
  Classical.choose_spec (id_nullhomotopic ↥Disc4T : (ContinuousMap.id ↥Disc4T).Nullhomotopic)

/-- The projection `S³ × D⁴ ⟶ S³` is a homotopy equivalence, since `D⁴` is contractible.
(Stated explicitly, without passing through `Nonempty`, so that its underlying map is
definitionally the first projection.) -/
noncomputable def prXHomT : ContinuousMap.HomotopyEquiv (↥Sph3T × ↥Disc4T) ↥Sph3T where
  toFun := ContinuousMap.fst
  invFun := ContinuousMap.prodMk (ContinuousMap.id ↥Sph3T) (ContinuousMap.const ↥Sph3T basePtT)
  left_inv := by
    have hmain : ((ContinuousMap.id ↥Sph3T).prodMap (ContinuousMap.const ↥Disc4T basePtT)).Homotopic
        ((ContinuousMap.id ↥Sph3T).prodMap (ContinuousMap.id ↥Disc4T)) :=
      (ContinuousMap.Homotopic.refl (ContinuousMap.id ↥Sph3T)).prodMap basePtT_spec.symm
    have h1 : (ContinuousMap.prodMk (ContinuousMap.id ↥Sph3T)
          (ContinuousMap.const ↥Sph3T basePtT)).comp ContinuousMap.fst
        = (ContinuousMap.id ↥Sph3T).prodMap (ContinuousMap.const ↥Disc4T basePtT) := by
      ext p <;> simp [ContinuousMap.prodMap_apply, Prod.map]
    have h2 : (ContinuousMap.id ↥Sph3T).prodMap (ContinuousMap.id ↥Disc4T)
        = ContinuousMap.id (↥Sph3T × ↥Disc4T) := by
      ext p <;> simp [ContinuousMap.prodMap_apply, Prod.map]
    simpa [h1, h2.symm] using hmain
  right_inv := by
    have h1 : ContinuousMap.fst.comp (ContinuousMap.prodMk (ContinuousMap.id ↥Sph3T)
        (ContinuousMap.const ↥Sph3T basePtT)) = ContinuousMap.id ↥Sph3T := by
      ext p; simp
    rw [h1]

/-! ## 3. The main statement -/

theorem inclAThreeKerIso :
    Nonempty (ModuleCat.of ℤ ↥(LinearMap.ker (ModuleCat.Hom.hom
      (HomologicalComplex.homologyMap (inclChains PairXT PairAT) 3))) ≅ ModuleCat.of ℤ ℤ) := by
  classical
  -- the functor whose application to a map is `chainMap`
  let F : TopCat ⥤ ChainComplex (ModuleCat ℤ) ℕ :=
    (singularChainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)
  -- ## The section `S³ → S³ × S³ ⊆ S³ × D⁴` of the first projection
  obtain ⟨y₀, hy₀⟩ := sphereInUnit_nonempty 4 (by norm_num)
  let s1A : Sph3T ⟶ TopCat.of PairAT :=
    TopCat.ofHom ⟨fun x => ⟨(x, y₀), hy₀⟩,
      Continuous.subtype_mk (continuous_id.prodMk continuous_const) (fun _ => hy₀)⟩
  have hs1A : s1A ≫ pj1A = 𝟙 Sph3T := by
    apply TopCat.hom_ext
    ext x
    rfl
  have hchain : chainMap ℤ Sph3T (TopCat.of PairAT) s1A ≫
      chainMap ℤ (TopCat.of PairAT) Sph3T pj1A = 𝟙 (singularChains ℤ Sph3T) := by
    show F.map s1A ≫ F.map pj1A = 𝟙 _
    rw [← F.map_comp, hs1A, F.map_id]
  have hSAS : HomologicalComplex.homologyMap (chainMap ℤ Sph3T (TopCat.of PairAT) s1A) 3 ≫
      HomologicalComplex.homologyMap (chainMap ℤ (TopCat.of PairAT) Sph3T pj1A) 3 = 𝟙 HS3 := by
    rw [← HomologicalComplex.homologyMap_comp, hchain, HomologicalComplex.homologyMap_id]
  -- `H₃(pj1A)` is surjective
  have hsurjP : Function.Surjective (ModuleCat.Hom.hom
      (HomologicalComplex.homologyMap (chainMap ℤ (TopCat.of PairAT) Sph3T pj1A) 3)) := by
    intro y
    refine ⟨ModuleCat.Hom.hom
      (HomologicalComplex.homologyMap (chainMap ℤ Sph3T (TopCat.of PairAT) s1A) 3) y, ?_⟩
    have hid : (ModuleCat.Hom.hom
          (HomologicalComplex.homologyMap (chainMap ℤ (TopCat.of PairAT) Sph3T pj1A) 3)) ∘ₗ
        (ModuleCat.Hom.hom
          (HomologicalComplex.homologyMap (chainMap ℤ Sph3T (TopCat.of PairAT) s1A) 3))
        = LinearMap.id := by
      rw [← ModuleCat.hom_comp, hSAS, ModuleCat.hom_id]
    have hval := DFunLike.congr_fun hid y
    simpa using hval
  -- ## The comparison `H₃(inclA) ≫ H₃(pj1X) = H₃(pj1A)`
  have hφP : HomologicalComplex.homologyMap (inclChains PairXT PairAT) 3 ≫
      HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3 =
      HomologicalComplex.homologyMap (chainMap ℤ (TopCat.of PairAT) Sph3T pj1A) 3 := by
    rw [← HomologicalComplex.homologyMap_comp]
    congr 1
    show F.map (subtypeIncl PairXT PairAT) ≫ F.map pj1X = F.map pj1A
    rw [← F.map_comp, show (subtypeIncl PairXT PairAT) ≫ pj1X = pj1A from ?_]
    rw [show subtypeIncl PairXT PairAT = inclA from rfl]
    exact pj1A_eq_incl_pj1X
  -- `H₃(pj1X)` is an isomorphism (the first projection is a homotopy equivalence)
  have hQiso : IsIso (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3) := by
    have hf : TopCat.ofHom prXHomT.toFun = pj1X := rfl
    rw [← hf]
    exact homologyEquiv ℤ PairXT Sph3T (TopCat.ofHom prXHomT.toFun)
      (TopCat.ofHom prXHomT.invFun) prXHomT.left_inv.some prXHomT.right_inv.some 3
  haveI : IsIso (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3) := hQiso
  -- `H₃(inclA)` is surjective, because `H₃(inclA) = H₃(pj1A) ≫ H₃(pj1X)⁻¹`
  have hsurjφ : Function.Surjective (ModuleCat.Hom.hom
      (HomologicalComplex.homologyMap (inclChains PairXT PairAT) 3)) := by
    intro y
    obtain ⟨x, hx⟩ := hsurjP (ModuleCat.Hom.hom
      (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3) y)
    refine ⟨x, ?_⟩
    have hφeq : HomologicalComplex.homologyMap (inclChains PairXT PairAT) 3 =
        HomologicalComplex.homologyMap (chainMap ℤ (TopCat.of PairAT) Sph3T pj1A) 3 ≫
          CategoryTheory.inv (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3) := by
      rw [← hφP, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    have hval : ModuleCat.Hom.hom (HomologicalComplex.homologyMap (inclChains PairXT PairAT) 3) x
        = ModuleCat.Hom.hom
            (CategoryTheory.inv (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3))
            (ModuleCat.Hom.hom
              (HomologicalComplex.homologyMap (chainMap ℤ (TopCat.of PairAT) Sph3T pj1A) 3) x) := by
      rw [hφeq, ModuleCat.hom_comp]
      rfl
    rw [hval, hx]
    have hinv : ModuleCat.Hom.hom (CategoryTheory.inv
          (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3)) ∘ₗ
        ModuleCat.Hom.hom (HomologicalComplex.homologyMap (chainMap ℤ PairXT Sph3T pj1X) 3)
        = LinearMap.id := by
      rw [← ModuleCat.hom_comp, IsIso.hom_inv_id, ModuleCat.hom_id]
    have hval2 := DFunLike.congr_fun hinv y
    simpa using hval2
  -- ## The two isomorphisms
  have hXiso : Nonempty (HX3 ≅ ModuleCat.of ℤ ℤ) := by
    obtain ⟨e⟩ := homologyIso_of_homotopyEquiv (homotopyEquiv_prod_fst ↥Sph3T ↥Disc4T).some 3
    obtain ⟨e2⟩ := sphereHomologyTop 3 (by norm_num)
    exact ⟨e ≪≫ e2⟩
  have hAiso : Nonempty (HA3 ≅ ModuleCat.of ℤ (ℤ × ℤ)) := by
    obtain ⟨e⟩ := homologyIso_of_homotopyEquiv sqHomeo.toHomotopyEquiv 3
    obtain ⟨e2⟩ := homology_prod_sphere 3 3 3 (by norm_num) (by norm_num)
    exact ⟨e ≪≫ e2 ≪≫ LinearEquiv.toModuleIso (LinearEquiv.finTwoArrow ℤ ℤ)⟩
  -- ## Assembly
  obtain ⟨eX⟩ := hXiso
  obtain ⟨eA⟩ := hAiso
  set φ := HomologicalComplex.homologyMap (inclChains PairXT PairAT) 3 with hφ
  set fA : HA3 ⟶ ModuleCat.of ℤ ℤ := φ ≫ eX.hom with hfA
  set g : ModuleCat.of ℤ (ℤ × ℤ) ⟶ ModuleCat.of ℤ ℤ := eA.inv ≫ fA with hg
  have hsurj_fA : Function.Surjective (ModuleCat.Hom.hom fA) := by
    have hcomp : ModuleCat.Hom.hom fA
        = (ModuleCat.Hom.hom eX.hom) ∘ (ModuleCat.Hom.hom φ) := by
      rw [hfA, ModuleCat.hom_comp]
      rfl
    rw [hcomp]
    exact (ConcreteCategory.bijective_of_isIso eX.hom).2.comp hsurjφ
  have hsurj_g : Function.Surjective (ModuleCat.Hom.hom g) := by
    have hcomp : ModuleCat.Hom.hom g
        = (ModuleCat.Hom.hom fA) ∘ (ModuleCat.Hom.hom eA.inv) := by
      rw [hg, ModuleCat.hom_comp]
      rfl
    rw [hcomp]
    exact hsurj_fA.comp (ConcreteCategory.bijective_of_isIso eA.inv).2
  have hkerφ : Nonempty (kerMod (ModuleCat.Hom.hom φ) ≅ kerMod (ModuleCat.Hom.hom fA)) := by
    have hker : LinearMap.ker (ModuleCat.Hom.hom fA) = LinearMap.ker (ModuleCat.Hom.hom φ) := by
      rw [hfA, ModuleCat.hom_comp]
      ext x
      simp only [LinearMap.mem_ker, LinearMap.comp_apply]
      exact ⟨fun h => (ConcreteCategory.bijective_of_isIso eX.hom).1 (by rw [h, map_zero]),
        fun h => by rw [h, map_zero]⟩
    exact ⟨(ofKerIsoKerModGen (ModuleCat.Hom.hom φ)).symm ≪≫ moduleCatOfIsoOfEq ≪≫
      LinearEquiv.toModuleIso (LinearEquiv.ofEq (LinearMap.ker (ModuleCat.Hom.hom φ))
        (LinearMap.ker (ModuleCat.Hom.hom fA)) hker.symm) ≪≫ moduleCatOfIsoOfEq ≪≫
        (ofKerIsoKerModGen (ModuleCat.Hom.hom fA))⟩
  have hkerA : Nonempty (kerMod (ModuleCat.Hom.hom fA) ≅ kerMod (ModuleCat.Hom.hom g)) :=
    kerIsoOf fA g eA (by rw [hg, ← Category.assoc, Iso.hom_inv_id, Category.id_comp])
  have hkerG : Nonempty (kerMod (ModuleCat.Hom.hom g) ≅ ModuleCat.of ℤ ℤ) :=
    kerMod_int_prod_of_surjective g.hom hsurj_g
  exact ⟨moduleCatOfIsoOfEq ≪≫ (ofKerIsoKerModGen (ModuleCat.Hom.hom φ)) ≪≫ hkerφ.some ≪≫ hkerA.some ≪≫ hkerG.some⟩

end

end Work.Cohomology
