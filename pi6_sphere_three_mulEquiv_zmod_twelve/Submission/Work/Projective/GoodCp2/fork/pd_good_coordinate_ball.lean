/-! ## The universal-coefficient computation of the top-degree cap product -/

/-- If `M ≅ ℤ` (as a `ℤ`-module) then every nonzero linear map `M →ₗ[ℤ] ℤ` is injective. -/
private lemma base_injective_of_ne_zero_of_iso_int {M : Type*} [AddCommGroup M] [Module ℤ M]
    (e : M ≃ₗ[ℤ] ℤ) (κ : M →ₗ[ℤ] ℤ) (h : κ ≠ 0) : Function.Injective κ := by
  have hsmul : ∀ z : ℤ, e.symm z = z • e.symm (1 : ℤ) := by
    intro z
    calc e.symm z = e.symm (z • (1 : ℤ)) := by rw [show z • (1 : ℤ) = z from by simp]
      _ = z • e.symm (1 : ℤ) := map_zsmul e.symm z 1
  have hformula : ∀ m : M, κ m = (e m) * (κ (e.symm 1)) := by
    intro m
    calc κ m = κ (e.symm (e m)) := by rw [e.symm_apply_apply]
      _ = κ ((e m) • e.symm (1 : ℤ)) := by rw [hsmul (e m)]
      _ = (e m) • κ (e.symm (1 : ℤ)) := map_zsmul κ (e m) (e.symm 1)
      _ = (e m) * (κ (e.symm (1 : ℤ))) := by rw [smul_eq_mul]
  have hc : κ (e.symm (1 : ℤ)) ≠ 0 := by
    intro h0
    apply h
    ext m
    rw [hformula m, h0, mul_zero, LinearMap.zero_apply]
  intro a b hab
  have h2 : (e a) * (κ (e.symm (1 : ℤ))) = (e b) * (κ (e.symm (1 : ℤ))) := by
    rw [← hformula a, ← hformula b, hab]
  have h3 : (e a - e b) * (κ (e.symm (1 : ℤ))) = 0 := by
    rw [sub_mul, h2, sub_self]
  have h4 : e a - e b = 0 := (mul_eq_zero.mp h3).resolve_right hc
  exact e.injective (sub_eq_zero.mp h4)

/-- **The cap product with a generator of the top relative homology is bijective.**

Let `X` be contractible, `A ⊆ X`, and suppose `H_n(X,A) ≅ ℤ` is generated by `ν` (with all
homology groups of the pair free).  Then `x ↦ x ⌢ ν : H^n(X,A;ℤ) → H_0(X;ℤ)` is bijective.

The proof compares `x ⌢ ν` with the universal coefficient evaluation
`H^n(X,A) ≅ Hom(H_n(X,A),ℤ)` (`Work.Cohomology.uctDual_evaluation`, via
`Work.Cohomology.Compat.relCapPair_kronH_eq`): the composite of `x ↦ x ⌢ ν` with the augmentation
`κ = ⟨1, ·⟩ : H_0(X) → ℤ` is `E(x)(ν)`. -/
theorem relCapPair_top_bijective (X : TopCat) (A : Set X) [ContractibleSpace ↥X] (n : ℕ)
    (hfree : ∀ i, Module.Free ℤ ↥((relChains X A).homology i))
    (htop : Nonempty ((relChains X A).homology n ≅ ModuleCat.of ℤ ℤ))
    (ν : (relChains X A).homology n) (hν : Submodule.span ℤ {ν} = ⊤) :
    Function.Bijective (fun x => relCapPair X A n 0 x ν) := by
  haveI : IsIso (TopCat.singularHomology₀ε X (ModuleCat.of ℤ ℤ)) := inferInstance
  obtain ⟨eU, heU⟩ := uctDual_evaluation (relChains X A) (relChainsProjective X A) hfree n
  let E : relCohomology ℤ X A n ≅ ModuleCat.of ℤ (↥((relChains X A).homology n) →ₗ[ℤ] ℤ) :=
    (HomologicalComplex.homologyFunctor (ModuleCat ℤ) (ComplexShape.up ℕ) n).mapIso
      (Compat.relDualComplexIso X A) ≪≫ eU
  let κ : (singularChains ℤ X).homology 0 →ₗ[ℤ] ℤ :=
    kronH ℤ (TopCat.toSSet.obj X) 0 (oneH ℤ (TopCat.toSSet.obj X))
  have key : ∀ (u : relCohomology ℤ X A n) (z : (relChains X A).homology n),
      κ ((relCapPair X A n 0) u z) = (E.hom u) z := by
    intro u z
    have h := Compat.relCapPair_kronH_eq X A n eU heU u z
    change kronH ℤ (TopCat.toSSet.obj X) 0 (oneH ℤ (TopCat.toSSet.obj X))
      ((relCapPair X A n 0) u z) = (E.hom u) z
    rw [h]
    rfl
  have hevν : Function.Bijective (fun f : ↥((relChains X A).homology n) →ₗ[ℤ] ℤ => f ν) := by
    constructor
    · intro f g hfg
      have hmem : Submodule.span ℤ ({ν} : Set _) ≤ LinearMap.ker (f - g) := by
        rw [Submodule.span_le]
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        rw [hy]
        show (f - g) ν = 0
        rw [LinearMap.sub_apply, sub_eq_zero]
        exact hfg
      rw [hν] at hmem
      have hzero : f - g = 0 := by
        rw [← LinearMap.ker_eq_top]
        exact top_le_iff.mp hmem
      exact sub_eq_zero.mp hzero
    · intro z
      obtain ⟨eN⟩ := htop
      have hspan_e : Submodule.span ℤ ({eN.hom.hom ν} : Set ℤ) = ⊤ := by
        have h1 : Submodule.span ℤ ({eN.hom.hom ν} : Set ℤ)
            = Submodule.map eN.hom.hom (Submodule.span ℤ ({ν} : Set _)) := by
          rw [Submodule.map_span, Set.image_singleton]
        rw [h1, hν, Submodule.map_top,
          LinearMap.range_eq_top.mpr ((ModuleCat.epi_iff_surjective eN.hom).mp inferInstance)]
      have hmem : (1 : ℤ) ∈ Submodule.span ℤ ({eN.hom.hom ν} : Set ℤ) := by
        rw [hspan_e]; trivial
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
      have hc1 : (eN.hom.hom ν) * c = 1 := by
        have h : c * (eN.hom.hom ν) = 1 := by simpa [smul_eq_mul] using hc
        rwa [mul_comm] at h
      obtain hgen | hgen := Int.eq_one_or_neg_one_of_mul_eq_one hc1
      · refine ⟨(z * (eN.hom.hom ν)) • (eN.hom.hom), ?_⟩
        simp only [LinearMap.smul_apply, smul_eq_mul]
        rw [hgen]; ring
      · refine ⟨(z * (eN.hom.hom ν)) • (eN.hom.hom), ?_⟩
        simp only [LinearMap.smul_apply, smul_eq_mul]
        rw [hgen]; ring
  have hκne : κ ≠ 0 := by
    obtain ⟨f0, hf0⟩ := hevν.2 1
    intro h0
    have hx := key (E.inv f0) ν
    have h1 : (E.hom (E.inv f0)) ν = 1 :=
      (congrArg (fun g => g ν) (Iso.inv_hom_id_apply E f0)).trans hf0
    rw [h1] at hx
    rw [h0] at hx
    simp only [LinearMap.zero_apply] at hx
    exact one_ne_zero hx.symm
  have hκinj : Function.Injective κ :=
    base_injective_of_ne_zero_of_iso_int
      (uctIsoToLinearEquiv (asIso (TopCat.singularHomology₀ε X (ModuleCat.of ℤ ℤ)))) κ hκne
  refine ⟨?_, ?_⟩
  · intro x y hxy
    have hxy' : (relCapPair X A n 0) x ν = (relCapPair X A n 0) y ν := hxy
    have h1 : (E.hom x) ν = (E.hom y) ν := by rw [← key x ν, ← key y ν, hxy']
    have h2 : E.hom x = E.hom y := hevν.1 h1
    exact (ModuleCat.mono_iff_injective E.hom).mp inferInstance h2
  · intro y
    obtain ⟨f, hf⟩ := hevν.2 (κ y)
    refine ⟨E.inv f, ?_⟩
    have hkey : κ ((relCapPair X A n 0) (E.inv f) ν) = κ y := by
      have h2 : E.hom (E.inv f) = f := Iso.inv_hom_id_apply E f
      have h3 : κ ((relCapPair X A n 0) (E.inv f) ν) = f ν :=
        (key (E.inv f) ν).trans (congrArg (fun g => g ν) h2)
      exact h3.trans hf
    exact hκinj hkey


/-! ## A compact subset of an open ball is contained in a concentric closed ball -/

/-- A compact subset of the open ball of radius `R` is contained in a concentric closed ball of
radius `ρ` with `R/4 ≤ ρ < R/2`. -/
theorem exists_closedBall_superset_of_subset_ball {E : Type*} [NormedAddCommGroup E]
    (y : E) {R : ℝ} (hR : 0 < R) {K : Set E} (hKc : IsCompact K)
    (hK : K ⊆ Metric.ball y (R / 2)) :
    ∃ ρ, R / 4 ≤ ρ ∧ ρ < R / 2 ∧ K ⊆ Metric.closedBall y ρ := by
  rcases K.eq_empty_or_nonempty with hK0 | hne
  · subst hK0
    exact ⟨R / 4, le_rfl, by linarith, Set.empty_subset _⟩
  · have hcont : ContinuousOn (fun v : E => dist v y) K :=
      (continuous_id.dist continuous_const).continuousOn
    obtain ⟨v₀, hv₀K, hv₀max⟩ := hKc.exists_isMaxOn hne hcont
    have hv₀ : dist v₀ y < R / 2 := Metric.mem_ball.mp (hK hv₀K)
    refine ⟨max (R / 4) ((dist v₀ y + R / 2) / 2), le_max_left _ _, ?_, ?_⟩
    · rw [max_lt_iff]
      exact ⟨by linarith, by linarith⟩
    · intro v hv
      rw [Metric.mem_closedBall]
      have h1 : dist v y ≤ dist v₀ y := hv₀max hv
      have h2 : dist v₀ y ≤ (dist v₀ y + R / 2) / 2 := by linarith
      exact le_trans h1 (le_trans h2 (le_max_right _ _))

/-! ## The relative homology of the coordinate ball pair, compared to the flat model -/

/-- **The relative homology of the coordinate ball pair `(U, U∖K)` is that of the flat model.**

For `0 < s < r` with `Metric.ball (e z) r ⊆ e.target`, `e = chartAt _ z`, the pair

`U = e ⁻¹' Metric.ball (e z) (r/2) ∩ e.source`,  `K = e ⁻¹' Metric.closedBall (e z) (s/2) ∩ e.source`

has the relative homology of `(ℝ^N, ℝ^N ∖ Metric.closedBall (e z) (s/2))`.

The proof composes the excision `H_*(U, U∖K) ≅ H_*(M, M∖K)` with the excision
`H_*(U', U'∖K) ≅ H_*(M, M∖K)` for the bigger concentric ball `U' = e ⁻¹' ball (e z) s ∩ e.source`
and the chart/euclidean identifications of the pair `(U', U'∖K)` with the flat model. -/
theorem chartBallPair_homology_iso (N : ℕ) (M : TopCat) [T2Space M]
    [ChartedSpace (EuclideanSpace ℝ (Fin N)) M] (z : M) (r s : ℝ) (hs : 0 < s)
    (hrs : r / 2 ≤ s) (hsr : s < r) :
    let e : OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin N)) := chartAt _ z
    let U₁ : Set M := e ⁻¹' Metric.ball (e z) (r / 2) ∩ e.source
    let U₂ : Set M := e ⁻¹' Metric.ball (e z) s ∩ e.source
    let K : Set M := e ⁻¹' Metric.closedBall (e z) (s / 2) ∩ e.source
    Metric.ball (e z) r ⊆ e.target →
    ∀ i, Nonempty (((relChains (TopCat.of U₁) (pdRelSub U₁ K)).homology i)
      ≅ ((relChains (TopCat.of (EuclideanSpace ℝ (Fin N)))
        {v : EuclideanSpace ℝ (Fin N) | v ∉ Metric.closedBall (e z) (s / 2)}).homology i)) := by
  intro e U₁ U₂ K hball i
  have hs2 : 0 < s / 2 := by linarith
  have hball_s : Metric.ball (e z) s ⊆ e.target :=
    (Metric.ball_subset_ball (le_of_lt hsr)).trans hball
  have hcl : Metric.closedBall (e z) (s / 2) ⊆ e.target :=
    (Metric.closedBall_subset_ball (by linarith)).trans hball_s
  have hU₁open : IsOpen U₁ := by
    show IsOpen (e ⁻¹' Metric.ball (e z) (r / 2) ∩ e.source)
    rw [Set.inter_comm]; exact e.isOpen_inter_preimage Metric.isOpen_ball
  have hU₂open : IsOpen U₂ := by
    show IsOpen (e ⁻¹' Metric.ball (e z) s ∩ e.source)
    rw [Set.inter_comm]; exact e.isOpen_inter_preimage Metric.isOpen_ball
  have hKeq : K = e.symm '' Metric.closedBall (e z) (s / 2) := by
    show e ⁻¹' Metric.closedBall (e z) (s / 2) ∩ e.source
      = ↑e.symm '' Metric.closedBall (e z) (s / 2)
    rw [Set.inter_comm, ← OpenPartialHomeomorph.symm_image_eq_source_inter_preimage e hcl]
  have hKc : IsCompact K := by
    rw [hKeq]
    exact (isCompact_closedBall (e z) (s / 2)).image_of_continuousOn
      (e.continuousOn_symm.mono hcl)
  have hKopen : IsOpen Kᶜ := hKc.isClosed.isOpen_compl
  have hsub₁ : K ⊆ U₁ := by
    intro y hy
    exact ⟨Metric.closedBall_subset_ball (by linarith) hy.1, hy.2⟩
  have hsub₂ : K ⊆ U₂ := by
    intro y hy
    exact ⟨Metric.closedBall_subset_ball (by linarith) hy.1, hy.2⟩
  have hcov₁ : U₁ ∪ Kᶜ = Set.univ := by
    rw [Set.eq_univ_iff_forall]; intro x
    by_cases hx : x ∈ K
    · exact Or.inl (hsub₁ hx)
    · exact Or.inr hx
  have hcov₂ : U₂ ∪ Kᶜ = Set.univ := by
    rw [Set.eq_univ_iff_forall]; intro x
    by_cases hx : x ∈ K
    · exact Or.inl (hsub₂ hx)
    · exact Or.inr hx
  have h1 : IsIso (HomologicalComplex.homologyMap (relChainsMap M U₁ Kᶜ) i) :=
    excision_relChainsMap_isIso M U₁ Kᶜ hU₁open hKopen hcov₁ i
  have h2 : IsIso (HomologicalComplex.homologyMap (relChainsMap M U₂ Kᶜ) i) :=
    excision_relChainsMap_isIso M U₂ Kᶜ hU₂open hKopen hcov₂ i
  obtain ⟨e2⟩ := chartBallPair_relHomology_iso N M z s hs hball_s i
  obtain ⟨e3⟩ := euclideanBallPair_relHomology_iso N (e z) s hs i
  exact ⟨asIso (HomologicalComplex.homologyMap (relChainsMap M U₁ Kᶜ) i) ≪≫
    (asIso (HomologicalComplex.homologyMap (relChainsMap M U₂ Kᶜ) i)).symm ≪≫ e2 ≪≫ e3⟩

/-! ## `goodD` is bijective in the top degree -/

/-- **The duality map is bijective in the top degree.**

Let `W` be open and contractible, `K ⊆ W` compact, and suppose that the relative homology of
`(W, W∖K)` is free, that `H_N(W,W∖K) ≅ ℤ` and that the local fundamental class of `c` at `K`
generates it.  Then for `m + k = N` with `k = N` the duality map
`goodD N c W hW K hKW hKc k m hkm : H^k(W,W∖K) → H_m(W)` is bijective. -/
theorem goodD_top_bijective {M : TopCat} [T2Space M] (N : ℕ)
    (c : (singularChains ℤ M).homology N) {W : Set M} (hW : IsOpen W) {K : Set M}
    (hKW : K ⊆ W) (hKc : IsCompact K) [ContractibleSpace ↥(TopCat.of W)]
    (hfree : ∀ i, Module.Free ℤ ↥((relChains (TopCat.of W) (pdRelSub W K)).homology i))
    (htop : Nonempty ((relChains (TopCat.of W) (pdRelSub W K)).homology N ≅ ModuleCat.of ℤ ℤ))
    (hν : Submodule.span ℤ {localFundClass N c W hW K hKW hKc} = ⊤)
    (k m : ℕ) (hkm : k + m = N) (hk : N = k) :
    Function.Bijective (fun x => goodD N c W hW K hKW hKc k m hkm x) := by
  subst hk
  have hm : m = 0 := by omega
  subst hm
  have hcast : (hkm ▸ localFundClass N c W hW K hKW hKc)
      = localFundClass N c W hW K hKW hKc := by
    rw [show hkm = (rfl : N + 0 = N) from Subsingleton.elim _ _]
  change Function.Bijective (fun x => relCapPair (TopCat.of W) (pdRelSub W K) N 0 x
    (hkm ▸ localFundClass N c W hW K hKW hKc))
  exact relCapPair_top_bijective (TopCat.of W) (pdRelSub W K) N hfree htop
    (hkm ▸ localFundClass N c W hW K hKW hKc) (by rw [hcast]; exact hν)

/-! ## The base case of the `Good` framework -/

theorem pd_good_coordinate_ball (N : ℕ) (hN : 1 ≤ N) (M : TopCat) [CompactSpace M] [T2Space M]
    [ChartedSpace (EuclideanSpace ℝ (Fin N)) M]
    (c : (Work.Cohomology.singularChains ℤ M).homology N)
    (hc : ∀ x : M, Submodule.span ℤ
      {((HomologicalComplex.homologyMap
          (CategoryTheory.Limits.cokernel.π (Work.Cohomology.inclChains M {y | y ≠ x})) N) c)} = ⊤)
    (z : M) (r : ℝ) (hr : 0 < r) :
    let e : OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin N)) := chartAt _ z
    Metric.ball (e z) r ⊆ e.target →
    let U : Set M := e ⁻¹' Metric.ball (e z) (r / 2) ∩ e.source
    ∀ (hU : IsOpen U), Work.Cohomology.Good N c U hU := by
  intro e hball U hU
  have hr2 : 0 < r / 2 := by linarith
  have hball' : Metric.ball (e z) (r / 2) ⊆ e.target :=
    (Metric.ball_subset_ball (by linarith)).trans hball
  haveI hcontr : ContractibleSpace ↥(TopCat.of U) :=
    contractibleSpace_coordinateBall N M z (r / 2) hr2 hball'
  refine fun k m hkm => ⟨?_, ?_⟩
  · -- ## the surjectivity clause
    intro y
    by_cases hk : k = N
    · -- the top degree: the cap product with a generator is bijective
      have hK₀eq : e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source
          = e.symm '' Metric.closedBall (e z) ((r / 2) / 2) := by
        rw [Set.inter_comm, ← OpenPartialHomeomorph.symm_image_eq_source_inter_preimage e
          ((Metric.closedBall_subset_ball (by linarith)).trans hball')]
      have hK₀U : (e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source) ⊆ U := by
        intro y hy
        exact ⟨Metric.closedBall_subset_ball (by linarith) hy.1, hy.2⟩
      have hK₀c : IsCompact (e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source) := by
        rw [hK₀eq]
        exact (isCompact_closedBall (e z) ((r / 2) / 2)).image_of_continuousOn
          (e.continuousOn_symm.mono
            ((Metric.closedBall_subset_ball (by linarith)).trans hball'))
      have hzK₀ : z ∈ e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source := by
        refine ⟨?_, mem_chart_source _ z⟩
        rw [Set.mem_preimage, Metric.mem_closedBall, dist_self]
        linarith
      obtain ⟨-, hbij⟩ := pd_coordinate_ball_fundamental N hN M c hc z (r / 2) hr2 hball'
        hzK₀
        (localFundClass N c U hU (e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source)
          hK₀U hK₀c)
        (localFundClass_spec N c U hU (e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source)
          hK₀U hK₀c)
      obtain ⟨x, hx⟩ := (hbij k m hkm).2 y
      exact ⟨e ⁻¹' Metric.closedBall (e z) ((r / 2) / 2) ∩ e.source, hK₀U, hK₀c, x, hx⟩
    · -- the target vanishes for `k ≠ N`
      have hmpos : 0 < m := by omega
      haveI : Subsingleton ↥((singularChains ℤ (TopCat.of U)).homology m) :=
        ModuleCat.subsingleton_of_isZero (homologyContractible (X := TopCat.of U) m hmpos)
      exact ⟨∅, Set.empty_subset U, isCompact_empty, 0, Subsingleton.elim _ _⟩
  · -- ## the injectivity clause
    intro K hKU hKc x hx
    -- the enlargement: a concentric closed ball containing `K`
    have himg : e '' K ⊆ Metric.ball (e z) (r / 2) := by
      rintro v ⟨y, hyK, rfl⟩
      exact (hKU hyK).1
    have himgc : IsCompact (e '' K) :=
      (hKc.image_of_continuousOn (e.continuousOn.mono fun y hy => (hKU hy).2))
    obtain ⟨ρ, hρ₁, hρ₂, hKsub⟩ :=
      exists_closedBall_superset_of_subset_ball (e z) hr himgc himg
    set s : ℝ := 2 * ρ with hsdef
    have hs2 : s / 2 = ρ := by rw [hsdef]; ring
    have hs_pos : 0 < s := by rw [hsdef]; linarith
    have hsr : s < r := by rw [hsdef]; linarith
    have hrs : r / 2 ≤ s := by rw [hsdef]; linarith
    set K' : Set M := e ⁻¹' Metric.closedBall (e z) (s / 2) ∩ e.source with hK'def
    have hKK' : K ⊆ K' := by
      intro y hy
      refine ⟨?_, (hKU hy).2⟩
      show e y ∈ Metric.closedBall (e z) (s / 2)
      rw [hs2]
      exact hKsub ⟨y, hy, rfl⟩
    have hK'U : K' ⊆ U := by
      intro y hy
      exact ⟨Metric.closedBall_subset_ball (by rw [hs2]; linarith) hy.1, hy.2⟩
    have hK'cl : Metric.closedBall (e z) (s / 2) ⊆ e.target :=
      (Metric.closedBall_subset_ball (by linarith)).trans
        ((Metric.ball_subset_ball (le_of_lt hsr)).trans hball)
    have hK'c : IsCompact K' := by
      have heq : K' = e.symm '' Metric.closedBall (e z) (s / 2) := by
        rw [hK'def]
        show e ⁻¹' Metric.closedBall (e z) (s / 2) ∩ e.source
          = ↑e.symm '' Metric.closedBall (e z) (s / 2)
        rw [Set.inter_comm, ← OpenPartialHomeomorph.symm_image_eq_source_inter_preimage e hK'cl]
      rw [heq]
      exact (isCompact_closedBall (e z) (s / 2)).image_of_continuousOn
        (e.continuousOn_symm.mono hK'cl)
    -- the homology model of the pair `(U, U∖K')`
    have hmodel : ∀ i, Nonempty (((relChains (TopCat.of U) (pdRelSub U K')).homology i)
        ≅ ((relChains (TopCat.of (EuclideanSpace ℝ (Fin N)))
          {v : EuclideanSpace ℝ (Fin N) | v ∉ Metric.closedBall (e z) (s / 2)}).homology i)) :=
      fun i => chartBallPair_homology_iso N M z r s hs_pos hrs hsr hball i
    have hK'cball : IsCompact (Metric.closedBall (e z) (s / 2)) := isCompact_closedBall _ _
    have hK'conv : Convex ℝ (Metric.closedBall (e z) (s / 2)) := convex_closedBall _ _
    have hK'ne : (Metric.closedBall (e z) (s / 2)).Nonempty :=
      ⟨e z, Metric.mem_closedBall_self (by linarith)⟩
    have hballmodel := Duality.ball_local_homology N hN (Metric.closedBall (e z) (s / 2))
      hK'cball hK'conv hK'ne
    have hballfree := Duality.free_relChains_compl N hN (Metric.closedBall (e z) (s / 2))
      hK'cball hK'conv hK'ne
    have hfree : ∀ i, Module.Free ℤ ↥((relChains (TopCat.of U) (pdRelSub U K')).homology i) := by
      intro i
      obtain ⟨e1⟩ := hmodel i
      haveI : Module.Free ℤ ↥((relChains (TopCat.of (EuclideanSpace ℝ (Fin N)))
          {v | v ∉ Metric.closedBall (e z) (s / 2)}).homology i) := hballfree i
      exact Module.Free.of_equiv (σ := RingHom.id ℤ) (σ' := RingHom.id ℤ)
        (uctIsoToLinearEquiv e1).symm
    have htop : Nonempty ((relChains (TopCat.of U) (pdRelSub U K')).homology N
        ≅ ModuleCat.of ℤ ℤ) := by
      obtain ⟨e1⟩ := hmodel N
      obtain ⟨e2⟩ := hballmodel.2
      exact ⟨e1 ≪≫ e2⟩
    have hvan : ∀ i, i ≠ N → IsZero ((relChains (TopCat.of U) (pdRelSub U K')).homology i) := by
      intro i hi
      obtain ⟨e1⟩ := hmodel i
      exact IsZero.of_iso (hballmodel.1 i hi) e1
    -- the local fundamental class generates
    have hgenM : Submodule.span ℤ
        {((HomologicalComplex.homologyMap
          (CategoryTheory.Limits.cokernel.π (inclChains M K'ᶜ)) N) c)} = ⊤ := by
      have h := local_generator_ball N hN M c hc z s hs_pos
        ((Metric.ball_subset_ball (le_of_lt hsr)).trans hball)
      simpa only [hK'def] using h
    have hgen : Submodule.span ℤ {localFundClass N c U hU K' hK'U hK'c} = ⊤ := by
      have hK'open : IsOpen K'ᶜ := hK'c.isClosed.isOpen_compl
      have hcov : U ∪ K'ᶜ = Set.univ := by
        rw [Set.eq_univ_iff_forall]; intro y
        by_cases hy : y ∈ K'
        · exact Or.inl (hK'U hy)
        · exact Or.inr hy
      haveI : IsIso (HomologicalComplex.homologyMap (relChainsMap M U K'ᶜ) N) :=
        excision_relChainsMap_isIso M U K'ᶜ hU hK'open hcov N
      let φ : ↥((relChains (TopCat.of U) (pdRelSub U K')).homology N) →ₗ[ℤ]
          ↥((relChains M K'ᶜ).homology N) :=
        (HomologicalComplex.homologyMap (relChainsMap M U K'ᶜ) N).hom
      have hφμ : φ (localFundClass N c U hU K' hK'U hK'c) = relLocClass M N c K' :=
        localFundClass_spec N c U hU K' hK'U hK'c
      have hspanφ : Submodule.span ℤ {φ (localFundClass N c U hU K' hK'U hK'c)} = ⊤ := by
        rw [hφμ]; exact hgenM
      have hinj : Function.Injective φ := by
        have h := (ModuleCat.mono_iff_injective
          (HomologicalComplex.homologyMap (relChainsMap M U K'ᶜ) N)).mp (IsIso.mono_of_iso _)
        simpa [φ] using h
      refine le_antisymm le_top ?_
      intro v _
      have hmem : φ v ∈ Submodule.map φ (Submodule.span ℤ
          ({localFundClass N c U hU K' hK'U hK'c} : Set _)) := by
        rw [Submodule.map_span, Set.image_singleton, hspanφ]
        exact Submodule.mem_top
      obtain ⟨w, hw, hwv⟩ := hmem
      have hwv' : w = v := hinj hwv
      rw [← hwv']
      exact hw
    by_cases hk : k = N
    · have hbij := goodD_top_bijective (N := N) (c := c) hU hK'U hK'c hfree htop hgen k m hkm
        hk.symm
      refine ⟨K', hKK', hK'U, hK'c, ?_⟩
      have h1 : goodD N c U hU K' hK'U hK'c k m hkm
          (HomologicalComplex.homologyMap (pdRelComplexEnlarge U hKK') k x) = 0 := by
        rw [pd_goodD_natural N c U hU hKK' hKU hK'U hKc hK'c k m hkm x]
        exact hx
      refine hbij.1 ?_
      show goodD N c U hU K' hK'U hK'c k m hkm
          ((HomologicalComplex.homologyMap (pdRelComplexEnlarge U hKK') k) x)
        = goodD N c U hU K' hK'U hK'c k m hkm 0
      rw [h1]
      simp only [goodD, map_zero, LinearMap.zero_apply]
    · haveI : Subsingleton ↥((relComplex ℤ (TopCat.of U) (pdRelSub U K')).homology k) := by
        obtain ⟨e1⟩ := relCohomologyDual (TopCat.of U) (pdRelSub U K') hfree k
        haveI : Subsingleton ↥(ModuleCat.of ℤ
            (↥((relChains (TopCat.of U) (pdRelSub U K')).homology k) →ₗ[ℤ] ℤ)) := by
          haveI : Subsingleton ↥((relChains (TopCat.of U) (pdRelSub U K')).homology k) :=
            ModuleCat.subsingleton_of_isZero (hvan k hk)
          refine ⟨fun f g => LinearMap.ext fun m => ?_⟩
          rw [Subsingleton.elim m 0, map_zero, map_zero]
        exact ((ConcreteCategory.bijective_of_isIso e1.hom).1).subsingleton
      exact ⟨K', hKK', hK'U, hK'c, Subsingleton.elim _ _⟩

end

end Work.Cohomology
