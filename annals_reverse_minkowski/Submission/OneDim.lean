import Mathlib
import ChallengeDeps
import Submission.TailBounds
import Submission.LatticeBasics
import Submission.RhoBasics
import Submission.Determinant
import Submission.TFacts
import Submission.Commons.Analysis.IntegerGaussianSum.zsum_exp_neg_mul_sq_le

open ReverseMinkowski
open Module Real
open scoped Real BigOperators
set_option autoImplicit false

/-!
# The `n = 0` and `n = 1` cases of the Reverse Minkowski theorem

* `n = 0`: the ambient space is a singleton, so every lattice has exactly one point.
  `ρ s ℒ = 1` for every `s` and the claim is trivial.
* `n = 1`: a full-rank lattice is generated by a single vector `u` of norm `≥ 1`
  (by the sub-determinant hypothesis).  Rewriting the Gaussian sum over the
  `ℤ`-basis isomorphism gives
  `ρ (1/20) ℒ = ∑' k : ℤ, exp (-400 π ‖k • u‖²) ≤ ∑' k : ℤ, exp (-1200 k²) ≤ 3/2`
  where the last inequality is the `ℤ`-Gaussian tail bound.
-/

namespace Submission.OneDim

local notation "E0" => EuclideanSpace ℝ (Fin 0)
local notation "E1" => EuclideanSpace ℝ (Fin 1)

/-- In dimension zero every element of a submodule is zero. -/
lemma eq_zero_of_dim0 (ℒ : Submodule ℤ E0) (y : ℒ) : y = 0 := by
  apply Subtype.ext
  ext i
  exact Fin.elim0 i

/-- In dimension zero the Gaussian mass is exactly `1` (a single term at `0`). -/
lemma rho_eq_one_n0 (ℒ : Submodule ℤ E0) (s : ℝ) : ρ s ℒ = 1 := by
  unfold ρ
  rw [tsum_eq_single (0 : ℒ)]
  · simp
  · intro y hy
    exact False.elim (hy (eq_zero_of_dim0 ℒ y))

/-- The rank-one `finrank` of a full-rank lattice in dimension one. -/
lemma finrank_one (ℒ : Submodule ℤ E1) [DiscreteTopology ℒ]
    (hℒ : IsZLattice ℝ ℒ) : finrank ℤ ℒ = 1 := by
  have hrk := ZLattice.rank (K := ℝ) (L := ℒ)
  simpa using hrk

/-- The squared norm of an integral multiple of a lattice vector. -/
lemma norm_zsmul_vec_sq (ℒ : Submodule ℤ E1) (u : ℒ) (k : ℤ) :
    ‖(k • u : ℒ)‖ ^ 2 = (k : ℝ) ^ 2 * ‖u‖ ^ 2 := by
  calc
    ‖(k • u : ℒ)‖ ^ 2 = ‖((k • u : ℒ) : E1)‖ ^ 2 := rfl
    _ = ‖(k : ℝ)‖ ^ 2 * ‖(u : E1)‖ ^ 2 := by
      change ‖k • (u : E1)‖ ^ 2 = ‖(k : ℝ)‖ ^ 2 * ‖(u : E1)‖ ^ 2
      rw [← Int.cast_smul_eq_zsmul ℝ k (u : E1)]
      rw [norm_smul]
      ring
    _ = (k : ℝ) ^ 2 * ‖(u : E1)‖ ^ 2 := by simp [Real.norm_eq_abs, sq_abs]
    _ = (k : ℝ) ^ 2 * ‖u‖ ^ 2 := rfl

/-- Per-term exponent comparison for `s = 1/20`: for a lattice vector `u` with
`‖u‖ ≥ 1`, `-400 π ‖k • u‖² ≤ -1200 k²`. -/
lemma exponent_le_one_dim {ℒ : Submodule ℤ E1} (u : ℒ) (hu_ge : 1 ≤ ‖(u : E1)‖) (k : ℤ) :
    -Real.pi * ‖(k • u : ℒ)‖ ^ 2 / (1 / 20) ^ 2 ≤ -1200 * (k : ℝ) ^ 2 := by
  rw [norm_zsmul_vec_sq ℒ u k]
  have hpi : (3 : ℝ) ≤ Real.pi := by linarith [Real.pi_gt_three]
  have hu2 : 1 ≤ ‖(u : E1)‖ ^ 2 := by nlinarith
  have hb : 0 ≤ Real.pi * ‖(u : E1)‖ ^ 2 - 3 := by nlinarith
  have hA : 0 ≤ (k : ℝ) ^ 2 * (Real.pi * ‖(u : E1)‖ ^ 2 - 3) :=
    mul_nonneg (sq_nonneg (k : ℝ)) hb
  have hmain : -Real.pi * ((k : ℝ) ^ 2 * ‖(u : E1)‖ ^ 2) ≤ -3 * (k : ℝ) ^ 2 := by nlinarith
  calc
    -Real.pi * ((k : ℝ) ^ 2 * ‖(u : E1)‖ ^ 2) / (1 / 20) ^ 2
        ≤ -3 * (k : ℝ) ^ 2 / (1 / 20) ^ 2 := by
          exact div_le_div_of_nonneg_right hmain (sq_nonneg (1 / 20 : ℝ))
    _ = -1200 * (k : ℝ) ^ 2 := by
      norm_num
      ring

/-- The one-dimensional Gaussian sum over `ℤ` is summable for any `c > 0`. -/
lemma summable_z_gauss (c : ℝ) (hc0 : 0 < c) :
    Summable (fun k : ℤ => rexp (-c * (k : ℝ) ^ 2)) := by
  let q : ℝ := rexp (-c)
  have hq0 : 0 ≤ q := (Real.exp_pos (-c)).le
  have hq1 : q < 1 := by
    dsimp [q]
    rw [← Real.exp_zero]
    exact (Real.exp_lt_exp).mpr (by linarith)
  have hnat : Summable (fun n : ℕ => rexp (-c * (n : ℝ) ^ 2)) := by
    have hgeo : Summable (fun n : ℕ => q ^ n) := summable_geometric_of_lt_one hq0 hq1
    refine Summable.of_nonneg_of_le (fun n => (Real.exp_pos _).le) ?_ hgeo
    intro n
    by_cases hn : n = 0
    · subst n
      simp [q]
    · have hn1 : 1 ≤ (n : ℝ) := by exact_mod_cast Nat.succ_le_of_lt (Nat.pos_of_ne_zero hn)
      have hsq : (n : ℝ) ≤ (n : ℝ) ^ 2 := by nlinarith [sq_nonneg (n : ℝ)]
      calc
        rexp (-c * (n : ℝ) ^ 2) ≤ rexp (-c * (n : ℝ)) := by
          rw [Real.exp_le_exp]
          nlinarith
        _ = q ^ n := by
          dsimp [q]
          rw [← Real.exp_nat_mul]
          congr 1
          ring
  rw [summable_int_iff_summable_nat_and_neg]
  constructor
  · simpa using hnat
  · have hneg : Summable (fun n : ℕ => rexp (-c * ((-((n : ℕ) : ℤ) : ℤ) : ℝ) ^ 2)) := by
      refine Summable.congr hnat ?_
      intro n
      congr 1
      simp
    simpa using hneg

/-- Theorem 1.2 in dimension one: `ρ (1/20) ℒ ≤ 3/2`. -/
lemma rho_le_three_halves_n1 (ℒ : Submodule ℤ E1) [DiscreteTopology ℒ]
    (hℒ : IsZLattice ℝ ℒ)
    (h : ∀ ℒ' (_ : ℒ' ≤ ℒ) [DiscreteTopology ℒ'], determinant ℒ' ≥ 1) :
    ρ (1 / 20) ℒ ≤ 3 / 2 := by
  let b : Basis (Fin (finrank ℤ ℒ)) ℤ ℒ := Module.finBasis ℤ ℒ
  have hfin : finrank ℤ ℒ = 1 := finrank_one ℒ hℒ
  haveI : Unique (Fin (finrank ℤ ℒ)) := by
    rw [hfin]
    infer_instance
  let u : ℒ := b default
  have hu_ne : u ≠ 0 := b.ne_zero default
  have hu_ge : 1 ≤ ‖(u : E1)‖ :=
    Submission.LatticeBasics.norm_ge_one_of_all_subdet h u hu_ne
  let e2 : (Fin (finrank ℤ ℒ) → ℤ) ≃ₗ[ℤ] ℤ := LinearEquiv.funUnique (Fin (finrank ℤ ℒ)) ℤ ℤ
  let eT : ℒ ≃ₗ[ℤ] ℤ := b.equivFun.trans e2
  have hb_const : ∀ i : Fin (finrank ℤ ℒ), b i = u := by
    intro i
    have : i = default := Subsingleton.elim i default
    subst i
    rfl
  have hsymm (k : ℤ) : eT.symm k = k • u := by
    change b.equivFun.symm (e2.symm k) = k • u
    have h2 : e2.symm k = fun _ : Fin (finrank ℤ ℒ) => k := by
      ext i
      simp [e2]
    rw [h2]
    rw [Module.Basis.equivFun_symm_apply]
    simp [hb_const]
  let f : ℒ → ℝ := fun y => rexp (-Real.pi * ‖y‖ ^ 2 / (1 / 20) ^ 2)
  let g : ℤ → ℝ := fun k => rexp (-1200 * (k : ℝ) ^ 2)
  have hterm (k : ℤ) : f (eT.symm k) ≤ g k := by
    dsimp [f, g]
    rw [Real.exp_le_exp]
    rw [hsymm k]
    exact exponent_le_one_dim u hu_ge k
  have hs : (1 / 20 : ℝ) ≠ 0 := by norm_num
  have hsum_f : Summable f := by
    dsimp [f]
    exact Submission.RhoBasics.summable_rho ℒ hs
  have hsum_fcomp : Summable (fun k : ℤ => f (eT.symm k)) := by
    rcases hsum_f with ⟨a, ha⟩
    refine ⟨a, ?_⟩
    exact (Equiv.hasSum_iff eT.symm.toEquiv (f := f)).mpr ha
  have hsum_g : Summable g := by
    dsimp [g]
    exact summable_z_gauss 1200 (by norm_num)
  calc
    ρ (1 / 20) ℒ = ∑' y : ℒ, f y := by
      dsimp [ρ, f]
    _ = ∑' k : ℤ, f (eT.symm k) := (Equiv.tsum_eq eT.symm.toEquiv (f := f)).symm
    _ ≤ ∑' k : ℤ, g k := by
      exact Summable.tsum_le_tsum hterm hsum_fcomp hsum_g
    _ ≤ 3 / 2 := by
      dsimp [g]
      exact Commons.Analysis.IntegerGaussianSum.zsum_exp_neg_mul_sq_le 1200 (by norm_num)

/-- Theorem 1.2 for `n = 0`: `ρ (1/t) ℒ ≤ 3/2`. -/
lemma theorem_1_2_n0 (ℒ : Submodule ℤ E0) [DiscreteTopology ℒ]
    (_hℒ : IsZLattice ℝ ℒ)
    (_h : ∀ ℒ' (_ : ℒ' ≤ ℒ) [DiscreteTopology ℒ'], determinant ℒ' ≥ 1) :
    let t : ℝ := 10 * (Real.log (0 : ℕ) + 2)
    ρ (1 / t) ℒ ≤ 3 / 2 := by
  dsimp
  rw [rho_eq_one_n0]
  norm_num

/-- Theorem 1.2 for `n = 1`: `ρ (1/t) ℒ ≤ 3/2` (where `t = 20`). -/
lemma theorem_1_2_n1 (ℒ : Submodule ℤ E1) [DiscreteTopology ℒ]
    (hℒ : IsZLattice ℝ ℒ)
    (h : ∀ ℒ' (_ : ℒ' ≤ ℒ) [DiscreteTopology ℒ'], determinant ℒ' ≥ 1) :
    let t : ℝ := 10 * (Real.log (1 : ℕ) + 2)
    ρ (1 / t) ℒ ≤ 3 / 2 := by
  dsimp
  have ht : 10 * (Real.log ((1 : ℕ) : ℝ) + 2) = 20 := by
    simpa using TFacts.t_eq_twenty_one
  rw [ht]
  exact rho_le_three_halves_n1 ℒ hℒ h

/-- Theorem 1.2 for dimension at most one. -/
lemma theorem_1_2_small {n : ℕ} (hn : n ≤ 1)
    (ℒ : Submodule ℤ (EuclideanSpace ℝ (Fin n))) [DiscreteTopology ℒ]
    (hℒ : IsZLattice ℝ ℒ)
    (h : ∀ ℒ' (_ : ℒ' ≤ ℒ) [DiscreteTopology ℒ'], determinant ℒ' ≥ 1) :
    let t : ℝ := 10 * (Real.log n + 2)
    ρ (1 / t) ℒ ≤ 3 / 2 := by
  have h01 : n = 0 ∨ n = 1 := by omega
  rcases h01 with rfl | rfl
  · exact theorem_1_2_n0 ℒ hℒ h
  · exact theorem_1_2_n1 ℒ hℒ h

end Submission.OneDim
