import ChallengeDeps
import Mathlib.Algebra.Module.ZLattice.Basic
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.RingTheory.SimpleRing.Principal

open Module Real Matrix
open scoped BigOperators

set_option autoImplicit false
set_option linter.style.haveILetI false

/-! The determinant of a discrete `ℤ`-submodule of a Euclidean space: the square root of the
determinant of the Gram matrix of a `ℤ`-basis. These definitions (inlined from the problem's
scaffolding so that this module stays self-contained) agree with the ones used in the paper. -/

namespace Submission.Determinant

/-! Helpers for `det_eq_norm_of_generator`. -/

/-- A submodule of a Euclidean space generated over `ℤ` by a single nonzero vector
has `ℤ`-rank one. -/
lemma finrank_eq_one_of_span_singleton {n : ℕ} (S : Submodule ℤ (EuclideanSpace ℝ (Fin n)))
    {v : EuclideanSpace ℝ (Fin n)} (hv : v ≠ 0)
    (hspan : S = Submodule.span ℤ ({v} : Set (EuclideanSpace ℝ (Fin n)))) :
    finrank ℤ S = 1 := by
  have htz : Module.IsTorsionFree ℤ (EuclideanSpace ℝ (Fin n)) := by
    refine Module.IsTorsionFree.of_smul_eq_zero (R := ℤ) (M := EuclideanSpace ℝ (Fin n)) ?_
    intro z m hm
    rw [← Int.cast_smul_eq_zsmul ℝ z m] at hm
    rcases (smul_eq_zero.mp hm) with hz | hm
    · exact Or.inl (Int.cast_eq_zero.mp hz)
    · exact Or.inr hm
  haveI := htz
  have hlin : LinearIndependent ℤ (fun _ : Fin 1 => v) := by
    exact LinearIndependent.of_subsingleton (i := 0) hv
  have hcard : Fintype.card (Fin 1) = 1 := by simp
  rw [hspan]
  rw [show ({v} : Set (EuclideanSpace ℝ (Fin n))) =
      Set.range (fun _ : Fin 1 => v) by ext x; simp]
  rw [finrank_span_eq_card (R := ℤ) (b := (fun _ : Fin 1 => v)) hlin, hcard]

/-- If a discrete `ℤ`-submodule `S` of a Euclidean space has rank one, then for the unique
element of the `finBasis`, `determinant S` is the norm of that element. -/
lemma det_eq_norm_of_finBasis_singleton {n : ℕ} (S : Submodule ℤ (EuclideanSpace ℝ (Fin n)))
    [DiscreteTopology S] (hfin : finrank ℤ S = 1)
    (i0 : Fin (finrank ℤ S)) :
    let x : EuclideanSpace ℝ (Fin n) := (finBasis ℤ S i0 : EuclideanSpace ℝ (Fin n))
    ReverseMinkowski.determinant S = ‖x‖ := by
  intro x
  have hA : ∀ (r : Fin n) (i : Fin (finrank ℤ S)),
      (ReverseMinkowski.B S) r i = (finBasis ℤ S i : EuclideanSpace ℝ (Fin n)) r := by
    intro r i
    rfl
  have hA00 : ((ReverseMinkowski.B S).transpose * ReverseMinkowski.B S) i0 i0 = ‖x‖ ^ 2 := by
    rw [Matrix.mul_apply]
    simp only [Matrix.transpose_apply, hA]
    rw [EuclideanSpace.real_norm_sq_eq]
    simp [x, pow_two]
  haveI : Unique (Fin (finrank ℤ S)) :=
    { toInhabited := ⟨i0⟩, uniq := fun a => by apply Fin.ext; omega }
  have hdetA : ((ReverseMinkowski.B S).transpose * ReverseMinkowski.B S).det = ‖x‖ ^ 2 := by
    rw [Matrix.det_unique]
    rw [← (inferInstance : Unique (Fin (finrank ℤ S))).uniq i0]
    exact hA00
  unfold ReverseMinkowski.determinant
  rw [hdetA]
  rw [Real.sqrt_sq_eq_abs]
  simp

/-- If a basis `b` of `S` has index type of cardinality one (a singleton), then the span
of the single basis vector (seen in the ambient space) is all of `S`. -/
lemma span_eq_span_basis_singleton {n : ℕ} (S : Submodule ℤ (EuclideanSpace ℝ (Fin n)))
    [Module.Free ℤ S] [Module.Finite ℤ S] (hfin : finrank ℤ S = 1)
    (b : Basis (Fin (finrank ℤ S)) ℤ S) (i0 : Fin (finrank ℤ S)) :
    Submodule.span ℤ ({(b i0 : EuclideanSpace ℝ (Fin n))} : Set (EuclideanSpace ℝ (Fin n))) = S := by
  haveI : Nonempty (Fin (finrank ℤ S)) := ⟨i0⟩
  have hii : ∀ i : Fin (finrank ℤ S), i = i0 := by
    intro i
    apply Fin.ext
    omega
  have hfun : (fun i : Fin (finrank ℤ S) => (b i : EuclideanSpace ℝ (Fin n))) =
      fun _ => (b i0 : EuclideanSpace ℝ (Fin n)) := by
    funext i
    rw [hii i]
  have hrange : Set.range (fun i : Fin (finrank ℤ S) => (b i : EuclideanSpace ℝ (Fin n))) =
      ({(b i0 : EuclideanSpace ℝ (Fin n))} : Set (EuclideanSpace ℝ (Fin n))) := by
    rw [hfun]
    ext y
    simp
  calc
    Submodule.span ℤ ({(b i0 : EuclideanSpace ℝ (Fin n))} : Set (EuclideanSpace ℝ (Fin n)))
        = Submodule.span ℤ
          (Set.range (fun i : Fin (finrank ℤ S) => (b i : EuclideanSpace ℝ (Fin n)))) := by
            rw [hrange]
    _ = Submodule.span ℤ (Set.range (S.subtype ∘ b)) := by rfl
    _ = Submodule.span ℤ (S.subtype '' Set.range b) := by rw [Set.range_comp]
    _ = Submodule.map S.subtype (Submodule.span ℤ (Set.range b)) := by rw [Submodule.map_span]
    _ = Submodule.map S.subtype ⊤ := by rw [b.span_eq]
    _ = S := by rw [Submodule.map_subtype_top]

/-- If a submodule is generated by a single nonzero vector, its determinant is the norm
of that vector. -/
lemma det_eq_norm_of_generator {n : ℕ} (S : Submodule ℤ (EuclideanSpace ℝ (Fin n))) [DiscreteTopology S] {v : EuclideanSpace ℝ (Fin n)}
    (hvS : v ∈ S) (hv : v ≠ 0)
    (hspan : S = Submodule.span ℤ ({v} : Set (EuclideanSpace ℝ (Fin n)))) :
    ReverseMinkowski.determinant S = ‖v‖ := by
  have hfin : finrank ℤ S = 1 := finrank_eq_one_of_span_singleton S hv hspan
  let i0 : Fin (finrank ℤ S) := ⟨0, by omega⟩
  let x : EuclideanSpace ℝ (Fin n) := (finBasis ℤ S i0 : EuclideanSpace ℝ (Fin n))
  have hdet : ReverseMinkowski.determinant S = ‖x‖ :=
    det_eq_norm_of_finBasis_singleton S hfin i0
  -- x is an integral multiple of v
  have hxS : x ∈ S := by
    exact (finBasis ℤ S i0).property
  have hk : ∃ k : ℤ, k • v = x := by
    have hxspan : x ∈ Submodule.span ℤ ({v} : Set (EuclideanSpace ℝ (Fin n))) := by
      simpa [hspan] using hxS
    exact (Submodule.mem_span_singleton).mp hxspan
  -- v is an integral multiple of x (since the single basis vector spans S)
  have hSx : Submodule.span ℤ ({x} : Set (EuclideanSpace ℝ (Fin n))) = S := by
    simpa [x] using span_eq_span_basis_singleton S hfin (Module.finBasis ℤ S) i0
  have hl : ∃ l : ℤ, l • x = v := by
    have hvx : v ∈ Submodule.span ℤ ({x} : Set (EuclideanSpace ℝ (Fin n))) := by
      simpa [hSx] using hvS
    exact (Submodule.mem_span_singleton).mp hvx
  rcases hk with ⟨k, hxk⟩
  rcases hl with ⟨l, hvl⟩
  have hx_ne0 : x ≠ 0 := by
    intro hx0
    apply hv
    rw [← hvl, hx0, smul_zero]
  have hxkl : (k * l) • x = x := by
    calc (k * l) • x = k • (l • x) := by rw [mul_smul]
      _ = k • v := by rw [hvl]
      _ = x := hxk
  have hz : ((k * l) - 1) • x = 0 := by
    rw [sub_smul, hxkl]
    simp
  have htz : Module.IsTorsionFree ℤ (EuclideanSpace ℝ (Fin n)) := by
    refine Module.IsTorsionFree.of_smul_eq_zero (R := ℤ) (M := EuclideanSpace ℝ (Fin n)) ?_
    intro z m hm
    rw [← Int.cast_smul_eq_zsmul ℝ z m] at hm
    rcases (smul_eq_zero.mp hm) with hz | hm
    · exact Or.inl (Int.cast_eq_zero.mp hz)
    · exact Or.inr hm
  have hkl : k * l = 1 := by
    have hz' : k * l - 1 = 0 ∨ x = 0 := by
      simpa using (smul_eq_zero.mp hz)
    rcases hz' with h | hx0
    · exact sub_eq_zero.mp h
    · exact False.elim (hx_ne0 hx0)
  have hnx : ‖x‖ = ‖(k : ℝ)‖ * ‖v‖ := by
    calc
      ‖x‖ = ‖k • v‖ := by rw [hxk]
      _ = ‖(k : ℝ)‖ * ‖v‖ := by rw [norm_zsmul ℝ k v]
  have hk1 : ‖(k : ℝ)‖ = 1 := by
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hkl with rfl | rfl <;> norm_num
  have hnorm : ‖x‖ = ‖v‖ := by
    rw [hnx, hk1]
    simp
  rw [hdet, hnorm]

end Submission.Determinant