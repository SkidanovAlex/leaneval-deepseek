import Mathlib
import Submission.Commons.LinearAlgebra.Independence.discrete_basis_values_linIndep

open Module Real Matrix
open scoped Real BigOperators
set_option autoImplicit false
set_option maxHeartbeats 800000

/-!
# (P1) Basis-matrix parametrization of full-rank lattices

A full-rank lattice `ℒ ≤ E` (`E := EuclideanSpace ℝ (Fin m)`) is, once a `ℤ`-basis
`b : Basis (Fin m) ℤ ℒ` is chosen, identified with the invertible **basis matrix**
`basisMatrix b : Matrix (Fin m) (Fin m) ℝ` whose columns are the standard coordinates of
the basis vectors (in the canonical orthonormal basis of `E`).  Conversely a matrix `A`
generates the lattice `latticeOfMatrix A := span ℤ (columns of A)`.

P1 content:
* `basisMatrix_col`: column `i` of the basis matrix is exactly the coordinate vector of the
  lattice point `(bᵢ : E)`;
* `span_values_eq_lattice`: the `ℤ`-span of the (ambient) basis values of any `ℤ`-basis is
  the whole lattice (no full-rank hypothesis needed);
* `latticeOfMatrix_basisMatrix`: `latticeOfMatrix (basisMatrix b) = ℒ` — recovery;
* `basisMatrix_det_ne_zero`: the basis matrix is nonsingular (its columns are the
  `ℝ`-independent ambient basis values under the coordinate linear equivalence).

Basis changes between two `ℤ`-bases of the same lattice are right multiplications by
unimodular integer matrices (the `GL_m(ℤ)`-orbit structure) — the next (P1b) statement.
-/

noncomputable section
namespace Submission.LatticeParam

variable {m : ℕ}
local notation "E" => EuclideanSpace ℝ (Fin m)

/-- The coordinate vector of `x : E` in the standard basis (plain function values). -/
def coord (x : E) : Fin m → ℝ := fun j => x j

/-- The basis matrix of a `ℤ`-basis: row `j`, column `i` is the `j`-th standard coordinate
of the `i`-th basis vector (columns are the basis vectors' coordinate vectors). -/
def basisMatrix {ℒ : Submodule ℤ E} (b : Module.Basis (Fin m) ℤ ℒ) :
    Matrix (Fin m) (Fin m) ℝ :=
  fun j i => ((b i : ℒ) : E) j

/-- The lattice generated by the columns of a matrix. -/
def latticeOfMatrix (A : Matrix (Fin m) (Fin m) ℝ) : Submodule ℤ E :=
  Submodule.span ℤ (Set.range (fun col : Fin m => WithLp.toLp 2 (fun row : Fin m => A row col)))

/-- The coordinate linear equivalence `E ≃ₗ[ℝ] (Fin m → ℝ)`. -/
noncomputable def coordEquiv : E ≃ₗ[ℝ] (Fin m → ℝ) :=
  WithLp.linearEquiv 2 ℝ (Fin m → ℝ)

/-- Column `i` of the basis matrix is the coordinate vector of the basis point `(bᵢ : E)`. -/
lemma basisMatrix_col {ℒ : Submodule ℤ E} (b : Module.Basis (Fin m) ℤ ℒ) (i : Fin m) :
    (basisMatrix b).col i = (fun j : Fin m => ((b i : ℒ) : E) j) := by
  rfl

/-- The `ℤ`-span of the ambient values of a `ℤ`-basis equals the lattice. -/
lemma span_values_eq_lattice {ℒ : Submodule ℤ E} {ι : Type*} (b : Module.Basis ι ℤ ℒ) :
    Submodule.span ℤ (Set.range (fun i : ι => ((b i : ℒ) : E))) = ℒ := by
  calc
    Submodule.span ℤ (Set.range (fun i : ι => ((b i : ℒ) : E)))
        = Submodule.span ℤ (ℒ.subtype '' Set.range b) := by
          congr 1
          ext x
          constructor
          · rintro ⟨i, rfl⟩
            exact ⟨b i, ⟨i, rfl⟩, rfl⟩
          · rintro ⟨y, ⟨i, rfl⟩, hx⟩
            refine ⟨i, ?_⟩
            simpa using hx
    _ = Submodule.map ℒ.subtype (Submodule.span ℤ (Set.range b)) := by rw [Submodule.map_span]
    _ = Submodule.map ℒ.subtype ⊤ := by rw [b.span_eq]
    _ = ℒ := by rw [Submodule.map_top, Submodule.range_subtype]

/-- **Recovery**: the lattice generated by the basis matrix of a `ℤ`-basis is the lattice
itself. -/
theorem latticeOfMatrix_basisMatrix {ℒ : Submodule ℤ E} (b : Module.Basis (Fin m) ℤ ℒ) :
    latticeOfMatrix (basisMatrix b) = ℒ := by
  classical
  have hfam : (fun col : Fin m => WithLp.toLp 2 (fun row : Fin m => (basisMatrix b) row col)) =
      fun col : Fin m => ((b col : ℒ) : E) := by
    funext col
    ext row
    rfl
  calc
    latticeOfMatrix (basisMatrix b) = Submodule.span ℤ
        (Set.range (fun col : Fin m => ((b col : ℒ) : E))) := by
          dsimp [latticeOfMatrix]
          rw [hfam]
    _ = ℒ := span_values_eq_lattice b

/-- The basis matrix of a `ℤ`-basis of a discrete lattice is nonsingular: its columns are
the `ℝ`-independent ambient basis values (coordinate map applied). -/
theorem basisMatrix_det_ne_zero {ℒ : Submodule ℤ E} [DiscreteTopology ℒ]
    (b : Module.Basis (Fin m) ℤ ℒ) : (basisMatrix b).det ≠ 0 := by
  classical
  have hliE : LinearIndependent ℝ (fun i : Fin m => ((b i : ℒ) : E)) := by
    exact Commons.LinearAlgebra.Independence.discrete_basis_values_linIndep (ℒ := ℒ) b
  let φ : E →ₗ[ℝ] (Fin m → ℝ) := coordEquiv.toLinearMap
  have hker : φ.ker = ⊥ := LinearMap.ker_eq_bot.mpr coordEquiv.injective
  have hli : LinearIndependent ℝ (fun i : Fin m => φ ((b i : ℒ) : E)) := by
    simpa [Function.comp_def] using (LinearIndependent.map' hliE φ hker)
  have hcols : LinearIndependent ℝ (basisMatrix b).col := by
    have hpt : ∀ i : Fin m, (basisMatrix b).col i = φ ((b i : ℒ) : E) := by
      intro i
      funext j
      dsimp [φ, coordEquiv, basisMatrix, Matrix.col]
      simp
    have hfam : (basisMatrix b).col = (fun i : Fin m => φ ((b i : ℒ) : E)) := funext hpt
    exact hfam ▸ hli
  exact (Matrix.nonsingular_iff_det_ne_zero.mp (Matrix.Nonsingular.of_linearIndependent_col hcols))

/-! ## (P1b) basis changes are unimodular integer matrices -/

/-- The change-of-basis matrix from a `ℤ`-basis `b` to a `ℤ`-basis `c` of the same lattice:
column `i` holds the coordinates of `c i` in the basis `b`. -/
def basisChange {ℒ : Submodule ℤ E} (b c : Module.Basis (Fin m) ℤ ℒ) :
    Matrix (Fin m) (Fin m) ℤ :=
  b.toMatrix (fun i => (c i : ℒ))

/-- Coordinate identity for the change of basis: `(c i : E) = Σ_k (U k i : ℝ) • (b k : E)`,
the `ℤ`-representation pushed into the ambient space (as an `ℝ`-linear combination). -/
lemma basisChange_smul_eq {ℒ : Submodule ℤ E} [DiscreteTopology ℒ]
    (b c : Module.Basis (Fin m) ℤ ℒ) (i : Fin m) :
    ((c i : ℒ) : E) = ∑ k : Fin m, ((basisChange b c) k i : ℝ) • ((b k : ℒ) : E) := by
  classical
  -- (c i : ℒ) = linearCombination ℤ (fun k => (b k : ℒ)) (b.repr (c i))  (repr-expansion in ℒ)
  have hci : (c i : ℒ) = Finsupp.linearCombination ℤ (fun k : Fin m => (b k : ℒ)) (b.repr (c i)) := by
    calc
      (c i : ℒ) = b.repr.symm (b.repr (c i)) := (b.repr.symm_apply_apply (c i)).symm
      _ = Finsupp.linearCombination ℤ (fun k : Fin m => (b k : ℒ)) (b.repr (c i)) := by
          rw [Module.Basis.repr_symm_apply]
  -- push the (ℤ-linear) inclusion ℒ → E through, then expand to the full Fin-sum
  have hε : ((c i : ℒ) : E) =
      ∑ k : Fin m, (((b.repr (c i)) k : ℤ) : ℝ) • ((b k : ℒ) : E) := by
    calc
      ((c i : ℒ) : E) = (ℒ.subtype) (c i : ℒ) := rfl
      _ = (ℒ.subtype) (Finsupp.linearCombination ℤ (fun k : Fin m => (b k : ℒ)) (b.repr (c i))) :=
          congrArg (ℒ.subtype) hci
      _ = Finsupp.linearCombination ℤ (fun k : Fin m => ((b k : ℒ) : E)) (b.repr (c i)) := by
          rw [Finsupp.apply_linearCombination]
          congr 1
      _ = ∑ k : Fin m, (((b.repr (c i)) k : ℤ) : ℝ) • ((b k : ℒ) : E) := by
          rw [Finsupp.linearCombination_apply]
          rw [Finsupp.sum_fintype]
          · apply Finset.sum_congr rfl
            intro k hk
            rw [← Int.cast_smul_eq_zsmul (R := ℝ) (n := (b.repr (c i)) k) (((b k : ℒ) : E))]
          · intro k
            simp
  calc
    ((c i : ℒ) : E) = ∑ k : Fin m, (((b.repr (c i)) k : ℤ) : ℝ) • ((b k : ℒ) : E) := hε
    _ = ∑ k : Fin m, ((basisChange b c) k i : ℝ) • ((b k : ℒ) : E) := by
        apply Finset.sum_congr rfl
        intro k hk
        simp [basisChange, Module.Basis.toMatrix_apply]
/-- **Basis change**: the basis matrices of two `ℤ`-bases of the same lattice differ by
right multiplication by the (integer, coerced to real) change-of-basis matrix. -/
theorem basisMatrix_mul_basisChange {ℒ : Submodule ℤ E} [DiscreteTopology ℒ]
    (b c : Module.Basis (Fin m) ℤ ℒ) :
    basisMatrix c = (basisMatrix b) *
      (basisChange b c).map (fun z : ℤ => (z : ℝ)) := by
  classical
  ext j i
  calc
    (basisMatrix c) j i = ((c i : ℒ) : E) j := rfl
    _ = (∑ k : Fin m, ((basisChange b c) k i : ℝ) • ((b k : ℒ) : E)) j := by
          rw [basisChange_smul_eq b c i]
    _ = ∑ k : Fin m, ((basisChange b c) k i : ℝ) * ((basisMatrix b) j k) := by
          simp [basisMatrix]
    _ = ((basisMatrix b) * (basisChange b c).map (fun z : ℤ => (z : ℝ))) j i := by
          simp only [Matrix.mul_apply, Matrix.map_apply]
          apply Finset.sum_congr rfl
          intro k hk
          ring

/-- The change-of-basis matrix and its reverse are integer inverses. -/

theorem basisChange_mul_inv {ℒ : Submodule ℤ E} (b c : Module.Basis (Fin m) ℤ ℒ) :
    basisChange b c * basisChange c b = 1 ∧ basisChange c b * basisChange b c = 1 := by
  classical
  constructor
  · have h := Module.Basis.toMatrix_mul_toMatrix b c (fun i : Fin m => (b i : ℒ))
    rw [Module.Basis.toMatrix_self b] at h
    dsimp [basisChange]
    exact h
  · have h := Module.Basis.toMatrix_mul_toMatrix c b (fun i : Fin m => (c i : ℒ))
    rw [Module.Basis.toMatrix_self c] at h
    dsimp [basisChange]
    exact h

/-- Unimodularity: the change-of-basis determinant is `±1`. -/
theorem basisChange_det_eq_one_or_neg_one {ℒ : Submodule ℤ E} (b c : Module.Basis (Fin m) ℤ ℒ) :
    (basisChange b c).det = 1 ∨ (basisChange b c).det = -1 := by
  classical
  have hmul := (basisChange_mul_inv b c).1
  -- det U * det V = det (U * V) = det 1 = 1
  have hdet : (basisChange b c).det * (basisChange c b).det = 1 := by
    calc
      (basisChange b c).det * (basisChange c b).det = (basisChange b c * basisChange c b).det := by
        rw [Matrix.det_mul]
      _ = (1 : Matrix (Fin m) (Fin m) ℤ).det := by rw [hmul]
      _ = 1 := by simp
  -- det U is a unit of ℤ, hence ±1
  let u : ℤ := (basisChange b c).det
  let v : ℤ := (basisChange c b).det
  have hu : IsUnit u := by
    refine ⟨⟨u, v, ?_, ?_⟩, rfl⟩
    · exact hdet
    · rw [mul_comm, hdet]
  have habs : |u| = 1 := (Int.isUnit_iff_abs_eq.mp hu)
  have hb : (0 : ℤ) ≤ 1 := by norm_num
  rcases (abs_eq hb).mp habs with h | h
  · exact Or.inl h
  · exact Or.inr h

end Submission.LatticeParam
