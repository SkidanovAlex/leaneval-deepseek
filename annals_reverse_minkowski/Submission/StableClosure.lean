import Mathlib
import Submission.CellContinuity
import Submission.Uncrossing

open Module Real Filter
open scoped Real BigOperators InnerProductSpace Topology
set_option autoImplicit false
set_option maxHeartbeats 1000000

/-!
# (B-ii) closure of the stable family under matrix limits — rank-one part

For the global-minimizer argument over stable lattices one needs: a limit (in the matrix
product topology) of *stable* lattices `latticeOfMatrix Aₙ → latticeOfMatrix A₀` is again
stable.  `det`-continuity gives the determinant-one half; the content is that every
sublattice of the limit has determinant `≥ 1`.

WARNING (route check, Feb-2025): the naive "all submatrix-minor determinants of the basis
matrix are ≥ 1" criterion is FALSE for stability.  Counterexample (`m = 2`):
`A = [[2, √15/2], [0, 1/2]]` has `|det A| = 1` and both column (rank-1 sub-basis) lengths
`2 ≥ 1`, yet `A·(1,−1) = (2 − √15/2, −1/2)` has length ≈ 0.50 < 1, so the rank-1 sublattice
spanned by it (an *integer combination* of the columns, not a column) has determinant < 1
and `latticeOfMatrix A` is not stable.  Stability constrains ALL integer-coefficient tuples,
not just column subsets.

CORRECT route (implemented here for rank one, rank `r ≥ 2` next): every sublattice of
`latticeOfMatrix A` is generated by vectors `colSum A c₁, …, colSum A c_r` for integer
tuples `cᵢ`; fix one tuple: stability of `latticeOfMatrix Aₙ` gives `1 ≤ det⟨Aₙcᵢ⟩`, the
map `A ↦ det⟨Acᵢ⟩` is continuous (for rank one: `A ↦ ‖colSum A c‖`), so the inequality
passes to the limit; assembling over all tuples gives stability of the limit.

This module contains the rank-one instance (`A ↦ ‖colSum A c‖` continuous; the
`λ₁ ≥ 1`-type bound passes to the limit), which is both the `r = 1` case of the closure and
its own useful statement.
-/

noncomputable section
namespace Submission.StableClosure

variable {m : ℕ}
local notation "E" => EuclideanSpace ℝ (Fin m)

open Submission.CellContinuity
open Submission.StableCompact
open Submission.LatticeParam

theorem colSum_norm_ge_one_of_limit (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (h : ∀ n : ℕ, ∀ c : Fin m → ℤ, c ≠ 0 → 1 ≤ ‖colSum (An n) (fun i => (c i : ℝ))‖) :
    ∀ c : Fin m → ℤ, c ≠ 0 → 1 ≤ ‖colSum A₀ (fun i => (c i : ℝ))‖ := by
  intro c hc0
  have hcont : Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => ‖colSum A (fun i => (c i : ℝ))‖) := by
    dsimp [colSum, cols]
    fun_prop
  have hlim : Filter.Tendsto (fun n : ℕ => ‖colSum (An n) (fun i => (c i : ℝ))‖) Filter.atTop
      (𝓝 (‖colSum A₀ (fun i => (c i : ℝ))‖)) := by
    exact Filter.Tendsto.comp
      (g := fun A : Matrix (Fin m) (Fin m) ℝ => ‖colSum A (fun i => (c i : ℝ))‖)
      (hcont.continuousAt (x := A₀)) hconv
  exact ge_of_tendsto hlim (Filter.Eventually.of_forall (fun n => h n c hc0))

-- corollary: stability of the sequence gives the hypothesis via norm_ge_one_of_stable
theorem colSum_norm_ge_one_of_stable_sequence (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (hdetn : ∀ n : ℕ, (An n).det ≠ 0)
    (hStn : ∀ n : ℕ,
      @Submission.StableLattices.Stable m (latticeOfMatrix (An n))
        (latticeOfMatrix_discrete (An n) (hdetn n))) :
    ∀ c : Fin m → ℤ, c ≠ 0 → 1 ≤ ‖colSum A₀ (fun i => (c i : ℝ))‖ := by
  apply colSum_norm_ge_one_of_limit A₀ An hconv
  intro n c hc0
  haveI : DiscreteTopology (latticeOfMatrix (An n)) := latticeOfMatrix_discrete (An n) (hdetn n)
  have hSt : Submission.StableLattices.Stable (latticeOfMatrix (An n)) := hStn n
  let y : latticeOfMatrix (An n) := ⟨colSum (An n) (fun i => (c i : ℝ)), (mem_span_cols_iff (An n) _).mpr ⟨c, rfl⟩⟩
  have hy0 : y ≠ 0 := by
    intro hyz
    apply colSum_ne_zero_of_ne_zero (An n) (hdetn n) hc0
    exact congrArg Subtype.val hyz
  have hb := Submission.StableLattices.norm_ge_one_of_stable hSt y hy0
  simpa [y] using hb

lemma cols_mem (A : Matrix (Fin m) (Fin m) ℝ) (i : Fin m) :
    cols A i ∈ (latticeOfMatrix A : Set E) := by
  change cols A i ∈ (Submodule.span ℤ (Set.range (cols A)) : Set E)
  exact Submodule.subset_span (s := Set.range (cols A)) (Set.mem_range_self i)

lemma cols_linearIndependent_Z (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0) :
    LinearIndependent ℤ (cols A) := by
  classical
  refine (Fintype.linearIndependent_iff (R := ℤ) (M := E) (v := cols A)).mpr ?_
  intro c hc i
  change c i = (0 : ℤ)
  have hℝ : (∑ j : Fin m, (c j : ℝ) • cols A j) = 0 := by
    calc
      (∑ j : Fin m, (c j : ℝ) • cols A j) = ∑ j : Fin m, (c j : ℤ) • cols A j := by
        refine Finset.sum_congr rfl ?_
        intro j hj
        exact Int.cast_smul_eq_zsmul (R := ℝ) (c j) (cols A j)
      _ = 0 := hc
  have hlin := cols_linearIndependent A hdet
  have hiℝ : ((c i : ℤ) : ℝ) = ((0 : ℤ) : ℝ) := by
    simpa using ((Fintype.linearIndependent_iff (R := ℝ) (M := E) (v := cols A)).mp hlin
      (fun j : Fin m => (c j : ℝ)) hℝ i)
  exact (Int.cast_inj (α := ℝ)).mp hiℝ

/-- The columns, viewed as lattice elements, are `ℤ`-linearly independent. -/
lemma cols_lattice_linearIndependent (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0) :
    LinearIndependent ℤ (fun i : Fin m => (⟨cols A i, cols_mem A i⟩ : latticeOfMatrix A)) := by
  classical
  refine (Fintype.linearIndependent_iff (R := ℤ) (M := latticeOfMatrix A)
    (v := fun i : Fin m => (⟨cols A i, cols_mem A i⟩ : latticeOfMatrix A))).mpr ?_
  intro c hc i
  change c i = (0 : ℤ)
  have hE0 : (∑ j : Fin m, (c j : ℤ) • (cols A j)) = 0 := by
    have hmap := congrArg (fun x : latticeOfMatrix A => (x : E)) hc
    simpa using hmap
  have hiZ : c i = 0 :=
    (Fintype.linearIndependent_iff (R := ℤ) (M := E) (v := cols A)).mp (cols_linearIndependent_Z A hdet) c hE0 i
  exact congrArg (fun z : ℤ => (z : ℤ)) hiZ

/-- The columns span the whole lattice. -/
lemma cols_lattice_span_top (A : Matrix (Fin m) (Fin m) ℝ) :
    ⊤ ≤ Submodule.span ℤ (Set.range (fun i : Fin m => (⟨cols A i, cols_mem A i⟩ : latticeOfMatrix A))) := by
  intro x hx
  have hxE : (x : E) ∈ (latticeOfMatrix A : Set E) := x.2
  rcases (mem_span_cols_iff A (x : E)).mp hxE with ⟨c, hc⟩
  refine (Submodule.mem_span_range_iff_exists_fun (R := ℤ)
    (M := latticeOfMatrix A)
    (v := fun i : Fin m => (⟨cols A i, cols_mem A i⟩ : latticeOfMatrix A)) (x := x)).mpr ⟨c, ?_⟩
  apply Subtype.ext
  have hs : (∑ i : Fin m, (c i : ℤ) • (cols A i)) = (x : E) := by
    calc
      (∑ i : Fin m, (c i : ℤ) • (cols A i)) = colSum A (fun i => (c i : ℝ)) := by
        exact (colSum_eq_zsmul A c).symm
      _ = (x : E) := hc
  simpa using hs

/-- The columns of a nonsingular matrix are a `ℤ`-basis of `latticeOfMatrix A`. -/
def colsBasis_Z (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0) :
    Module.Basis (Fin m) ℤ (latticeOfMatrix A) :=
  Module.Basis.mk (cols_lattice_linearIndependent A hdet) (cols_lattice_span_top A)

/-- The column-basis evaluates to the columns. -/
lemma colsBasis_Z_apply (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0) (i : Fin m) :
    ((colsBasis_Z A hdet i : latticeOfMatrix A) : E) = cols A i := by
  dsimp [colsBasis_Z]
  rw [Module.Basis.coe_mk]

/-- `det (latticeOfMatrix A) = |det A|` for a nonsingular matrix: the columns are a
`ℤ`-basis (determinant = √det(gram)) and their Gram matrix is `AᵀA`. -/
lemma det_latticeOfMatrix_eq_abs_det (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0)
    [DiscreteTopology (latticeOfMatrix A)] :
    ReverseMinkowski.determinant (latticeOfMatrix A) = |A.det| := by
  classical
  haveI : Module.Free ℤ (latticeOfMatrix A) := instModuleFree_of_discrete_submodule (latticeOfMatrix A)
  haveI : Module.Finite ℤ (latticeOfMatrix A) := instModuleFinite_of_discrete_submodule (latticeOfMatrix A)
  let β : Module.Basis (Fin m) ℤ (latticeOfMatrix A) := colsBasis_Z A hdet
  have hβ : ∀ i : Fin m, ((β i : latticeOfMatrix A) : E) = cols A i := by
    intro i
    simpa [β] using (colsBasis_Z_apply A hdet i)
  have hgram : ReverseMinkowski.determinant (latticeOfMatrix A) =
      Real.sqrt ((Matrix.gram ℝ (fun i : Fin m => ((β i : latticeOfMatrix A) : E))).det) := by
    exact Submission.Uncrossing.det_eq_sqrt_gram_any_basis (L := latticeOfMatrix A) β
  have hA : basisMatrix β = A := by
    ext j i
    change ((β i : latticeOfMatrix A) : E) j = (cols A i) j
    rw [hβ i]
  have hgram2 : (Matrix.gram ℝ (fun i : Fin m => ((β i : latticeOfMatrix A) : E))).det =
      (A.det) ^ 2 := by
    calc
      (Matrix.gram ℝ (fun i : Fin m => ((β i : latticeOfMatrix A) : E))).det
          = ((basisMatrix β).det) ^ 2 := det_gram_eq_det_basisMatrix_sq β
      _ = (A.det) ^ 2 := by rw [hA]
  calc
    ReverseMinkowski.determinant (latticeOfMatrix A) =
        Real.sqrt ((Matrix.gram ℝ (fun i : Fin m => ((β i : latticeOfMatrix A) : E))).det) := hgram
    _ = Real.sqrt ((A.det) ^ 2) := by rw [hgram2]
    _ = |A.det| := Real.sqrt_sq_eq_abs (A.det)

lemma abs_det_eq_one_of_stable_matrix (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0)
    [DiscreteTopology (latticeOfMatrix A)]
    (hSt : Submission.StableLattices.Stable (latticeOfMatrix A)) : |A.det| = 1 := by
  have h1 : ReverseMinkowski.determinant (latticeOfMatrix A) = 1 := hSt.1
  rwa [det_latticeOfMatrix_eq_abs_det A hdet] at h1

/-- Determinant-one half of the stable closure: the limit of a convergent sequence of stable
matrix-lattices has determinant one. -/
lemma det_one_latticeOfMatrix_of_stable_sequence (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (hdetn : ∀ n : ℕ, (An n).det ≠ 0)
    (hStn : ∀ n : ℕ, @Submission.StableLattices.Stable m (latticeOfMatrix (An n))
      (latticeOfMatrix_discrete (An n) (hdetn n)))
    (hdet0 : A₀.det ≠ 0) [DiscreteTopology (latticeOfMatrix A₀)] :
    ReverseMinkowski.determinant (latticeOfMatrix A₀) = 1 := by
  classical
  have hlim : Filter.Tendsto (fun n : ℕ => |(An n).det|) Filter.atTop (𝓝 (|A₀.det|)) := by
    have hdetC : Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => |A.det|) := by
      exact continuous_abs.comp (continuous_id.matrix_det)
    exact Filter.Tendsto.comp (g := fun A : Matrix (Fin m) (Fin m) ℝ => |A.det|)
      (hdetC.continuousAt (x := A₀)) hconv
  have hlim1 : Filter.Tendsto (fun n : ℕ => |(An n).det|) Filter.atTop (𝓝 (1 : ℝ)) := by
    have hconst : (fun _ : ℕ => (1 : ℝ)) =ᶠ[Filter.atTop] fun n : ℕ => |(An n).det| := by
      refine Filter.Eventually.of_forall ?_
      intro n
      have hDTn : DiscreteTopology (latticeOfMatrix (An n)) := latticeOfMatrix_discrete (An n) (hdetn n)
      exact (@abs_det_eq_one_of_stable_matrix m (An n) (hdetn n) hDTn (hStn n)).symm
    exact Filter.Tendsto.congr' hconst (tendsto_const_nhds (x := (1 : ℝ)))
  have habs : |A₀.det| = 1 := tendsto_nhds_unique hlim hlim1
  rw [det_latticeOfMatrix_eq_abs_det A₀ hdet0]
  exact habs

lemma colSum_continuous (a : Fin m → ℝ) :
    Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => colSum A a) := by
  dsimp [colSum, cols]
  fun_prop

/-- The Gram matrix of the vectors `colSum A (cs k)` is continuous in `A`. -/
lemma gram_colSum_continuous {r : ℕ} (cs : Fin r → Fin m → ℤ) :
    Continuous (fun A : Matrix (Fin m) (Fin m) ℝ =>
      Matrix.gram ℝ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) := by
  refine continuous_matrix ?_
  intro k l
  have hk : Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => colSum A (fun i => (cs k i : ℝ))) := by
    exact colSum_continuous (fun i : Fin m => (cs k i : ℝ))
  have hl : Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => colSum A (fun i => (cs l i : ℝ))) := by
    exact colSum_continuous (fun i : Fin m => (cs l i : ℝ))
  exact Continuous.inner hk hl

/-- The determinant of the Gram matrix of the `colSum`-vectors is continuous in `A`. -/
lemma detGram_colSum_continuous {r : ℕ} (cs : Fin r → Fin m → ℤ) :
    Continuous (fun A : Matrix (Fin m) (Fin m) ℝ =>
      (Matrix.gram ℝ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))).det) := by
  have h := gram_colSum_continuous (cs := cs)
  exact h.matrix_det
  -- hmm: Continuous.matrix_det is for id; for general f: (Continuous f).matrix_det? the lemma: Continuous.matrix_det {A : X → Matrix} (hA : Continuous A) : Continuous fun x => (A x).det (from Topology/Instances/Matrix.lean line 119)
  -- check: probably `h.matrix_det` exists as Continuous.matrix_det hA. If syntax fails adjust.


/-- The `r`-dimensional volume of the lattice spanned by `colSum A (cs k)` (the determinant
of the rank-`r` sublattice they generate when independent). -/
noncomputable def volColSum {r : ℕ} (cs : Fin r → Fin m → ℤ) (A : Matrix (Fin m) (Fin m) ℝ) : ℝ :=
  Real.sqrt ((Matrix.gram ℝ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))).det)

/-- `volColSum cs A` is continuous in `A`. -/
lemma volColSum_continuous {r : ℕ} (cs : Fin r → Fin m → ℤ) :
    Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => volColSum (m := m) cs A) := by
  dsimp [volColSum]
  exact (detGram_colSum_continuous (cs := cs)).sqrt

/-- Sequential continuity of `volColSum`. -/
theorem tendsto_volColSum {r : ℕ} (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (cs : Fin r → Fin m → ℤ) :
    Filter.Tendsto (fun n : ℕ => volColSum (m := m) cs (An n)) Filter.atTop
      (𝓝 (volColSum (m := m) cs A₀)) := by
  have hc : Continuous (fun A : Matrix (Fin m) (Fin m) ℝ => volColSum (m := m) cs A) :=
    volColSum_continuous (m := m) cs
  exact Filter.Tendsto.comp (g := fun A : Matrix (Fin m) (Fin m) ℝ => volColSum (m := m) cs A)
    (hc.continuousAt (x := A₀)) hconv

/-- An eventually-`≥ 1` bound on the `r`-volumes along a convergent sequence passes to the
limit (the `r`-dimensional half of the rank-`r` stable-closure step). -/
lemma volColSum_ge_one_of_eventually {r : ℕ} (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (cs : Fin r → Fin m → ℤ)
    (h : ∀ᶠ n in Filter.atTop, 1 ≤ volColSum (m := m) cs (An n)) :
    1 ≤ volColSum (m := m) cs A₀ := by
  exact ge_of_tendsto (tendsto_volColSum A₀ An hconv cs) h

lemma colSum_add (A : Matrix (Fin m) (Fin m) ℝ) (a b : Fin m → ℝ) :
    colSum A (a + b) = colSum A a + colSum A b := by
  dsimp [colSum]
  simp [add_smul, Finset.sum_add_distrib]

lemma colSum_smul (A : Matrix (Fin m) (Fin m) ℝ) (r : ℝ) (a : Fin m → ℝ) :
    colSum A (r • a) = r • colSum A a := by
  dsimp [colSum]
  calc
    (∑ i : Fin m, (r • a) i • cols A i) = ∑ i : Fin m, r • (a i • cols A i) := by
      refine Finset.sum_congr rfl ?_
      intro i hi
      simp [Pi.smul_apply, smul_smul]
    _ = r • (∑ i : Fin m, a i • cols A i) := by
      rw [Finset.smul_sum]

lemma colSum_finset_sum {ι : Type*} (A : Matrix (Fin m) (Fin m) ℝ) (t : Finset ι) (f : ι → Fin m → ℝ) :
    colSum A (∑ x ∈ t, f x) = ∑ x ∈ t, colSum A (f x) := by
  classical
  induction t using Finset.induction_on with
  | empty => simp [colSum]
  | insert x t hx ih =>
      rw [Finset.sum_insert hx, Finset.sum_insert hx, colSum_add, ih]

-- interchange: colSum of an integer-linear combination of coefficient functions
lemma colSum_zsmul_sum {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ) (d : Fin r → ℤ) :
    colSum A (fun i : Fin m => (((∑ j : Fin r, (d j : ℤ) • cs j) i : ℤ) : ℝ)) =
      ∑ j : Fin r, (d j : ℤ) • colSum A (fun i : Fin m => (cs j i : ℝ)) := by
  calc
    colSum A (fun i : Fin m => (((∑ j : Fin r, (d j : ℤ) • cs j) i : ℤ) : ℝ))
        = colSum A (∑ j : Fin r, (d j : ℝ) • (fun i : Fin m => (cs j i : ℝ))) := by
          congr 1
          funext i
          simp [Finset.sum_apply]
    _ = ∑ j : Fin r, colSum A ((d j : ℝ) • (fun i : Fin m => (cs j i : ℝ))) := by
          rw [colSum_finset_sum A (Finset.univ : Finset (Fin r))]
    _ = ∑ j : Fin r, (d j : ℝ) • colSum A (fun i : Fin m => (cs j i : ℝ)) := by
          refine Finset.sum_congr rfl ?_
          intro j hj
          rw [colSum_smul]
    _ = ∑ j : Fin r, (d j : ℤ) • colSum A (fun i : Fin m => (cs j i : ℝ)) := by
          refine Finset.sum_congr rfl ?_
          intro j hj
          rw [Int.cast_smul_eq_zsmul]

/-- **Ingredient (iii-a)**: if the ambient vectors `colSum A (cs k)` are `ℤ`-linearly
independent, then the integer coefficient functions `cs k` are themselves `ℤ`-linearly
independent (no hypothesis on `A` needed: `colSum A` is additive in the coefficients, so a
relation among the `cs k` pushes to a relation among the `colSum`-images). -/
lemma linearIndependent_coeffs_of_colSum {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ)
    (cs : Fin r → Fin m → ℤ)
    (h : LinearIndependent ℤ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) :
    LinearIndependent ℤ cs := by
  classical
  refine (Fintype.linearIndependent_iff (R := ℤ) (M := Fin m → ℤ) (v := cs)).mpr ?_
  intro d hd k
  -- hd : ∑ j, (d j : ℤ) • cs j = 0 pointwise
  have hE0 : (∑ j : Fin r, (d j : ℤ) • colSum A (fun i => (cs j i : ℝ))) = 0 := by
    have h1 : (∑ j : Fin r, (d j : ℤ) • colSum A (fun i => (cs j i : ℝ))) =
        colSum A (fun i : Fin m => (((∑ j : Fin r, (d j : ℤ) • cs j) i : ℤ) : ℝ)) := by
      exact (colSum_zsmul_sum A cs d).symm
    rw [h1]
    have hdE : (fun i : Fin m => (((∑ j : Fin r, (d j : ℤ) • cs j) i : ℤ) : ℝ)) = 0 := by
      -- from hd : ∑ⱼ (d j : ℤ) • cs j = 0 (functions)
      funext i
      have hdi := congrFun hd i
      -- hdi : (∑ⱼ (d j:ℤ) • cs j) i = 0
      change ((((∑ j : Fin r, (d j : ℤ) • cs j) i : ℤ) : ℝ)) = (0 : ℝ)
      rw [hdi]
      simp
    rw [hdE]
    simp [colSum]
  have hdZ : d k = 0 :=
    (Fintype.linearIndependent_iff (R := ℤ) (M := E)
      (v := fun j : Fin r => colSum A (fun i => (cs j i : ℝ)))).mp h d hE0 k
  exact hdZ

/-- **(iii)(b)** If the limit vectors `colSum A₀ (cs k)` are ℝ-independent, then so are the
vectors `colSum (An n) (cs k)` for all sufficiently large `n` (rank-`r`-ness is an open
condition: `det(gram) > 0`-style, carried through the continuity of `A ↦ det(gram(colSum…))`). -/
lemma linearIndependent_colSum_eventually {r : ℕ} (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (cs : Fin r → Fin m → ℤ)
    (h0 : LinearIndependent ℝ (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ)))) :
    ∀ᶠ n in Filter.atTop,
      LinearIndependent ℝ (fun k : Fin r => colSum (An n) (fun i => (cs k i : ℝ))) := by
  classical
  have h0d : ((Matrix.gram ℝ (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ)))).det) ≠ 0 := by
    exact (Matrix.det_gram_ne_zero_iff_linearIndependent (𝕜 := ℝ)).mpr h0
  have hdetlim : Filter.Tendsto (fun n : ℕ =>
      (Matrix.gram ℝ (fun k : Fin r => colSum (An n) (fun i => (cs k i : ℝ)))).det)
      Filter.atTop (𝓝 ((Matrix.gram ℝ (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ)))).det)) := by
    have hc : Continuous (fun A : Matrix (Fin m) (Fin m) ℝ =>
        (Matrix.gram ℝ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))).det) := by
      exact detGram_colSum_continuous (m := m) cs
    exact Filter.Tendsto.comp (g := fun A : Matrix (Fin m) (Fin m) ℝ =>
        (Matrix.gram ℝ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))).det)
      (hc.continuousAt (x := A₀)) hconv
  have hev : ∀ᶠ n in Filter.atTop,
      (Matrix.gram ℝ (fun k : Fin r => colSum (An n) (fun i => (cs k i : ℝ)))).det ≠ 0 := by
    exact Filter.Tendsto.eventually_ne hdetlim h0d
  refine hev.mono ?_
  intro n hn
  exact (Matrix.det_gram_ne_zero_iff_linearIndependent (𝕜 := ℝ)).mp hn

lemma submodule_discrete_of_discrete {ℒ' ℒ : Submodule ℤ E} [DiscreteTopology ℒ] (hle : ℒ' ≤ ℒ) :
    DiscreteTopology ℒ' := by
  let f : ℒ' → ℒ := fun x => ⟨(x : E), hle x.2⟩
  have hf_inj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    exact congrArg (fun z : ℒ => (z : E)) hxy
  have hf_cont : Continuous f := by
    have hv : Continuous (fun x : ℒ' => (x : E)) := continuous_subtype_val
    exact Continuous.subtype_mk hv (fun x => hle x.2)
  exact DiscreteTopology.of_continuous_injective (β := ℒ) hf_cont hf_inj

/-- The `ℤ`-submodule of `E` spanned by the vectors `colSum A (cs k)`. -/
def spanColSum {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ) :
    Submodule ℤ E :=
  Submodule.span ℤ (Set.range (fun k : Fin r => colSum A (fun i => (cs k i : ℝ))))

lemma colSum_mem_spanColSum {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ)
    (k : Fin r) : colSum A (fun i => (cs k i : ℝ)) ∈ (spanColSum A cs : Set E) := by
  dsimp [spanColSum]
  exact Submodule.subset_span (s := Set.range (fun k : Fin r => colSum A (fun i => (cs k i : ℝ))))
    (Set.mem_range_self k)

lemma colSum_mem_latticeOfMatrix {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ)
    (k : Fin r) : colSum A (fun i => (cs k i : ℝ)) ∈ (latticeOfMatrix A : Set E) := by
  exact (mem_span_cols_iff A (colSum A (fun i => (cs k i : ℝ)))).mpr ⟨cs k, rfl⟩

lemma spanColSum_le_latticeOfMatrix {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ)
    (cs : Fin r → Fin m → ℤ) : spanColSum A cs ≤ latticeOfMatrix A := by
  change Submodule.span ℤ (Set.range (fun k : Fin r => colSum A (fun i => (cs k i : ℝ))))
      ≤ latticeOfMatrix A
  rw [Submodule.span_le]
  intro y hy
  rcases hy with ⟨k, rfl⟩
  exact colSum_mem_latticeOfMatrix A cs k

/-- The module-level `ℤ`-independence of the lifted `colSum` vectors. -/
lemma spanColSum_linearIndependent {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ)
    (cs : Fin r → Fin m → ℤ)
    (hind : LinearIndependent ℤ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) :
    LinearIndependent ℤ (fun k : Fin r =>
      (⟨colSum A (fun i => (cs k i : ℝ)), colSum_mem_spanColSum A cs k⟩ : spanColSum A cs)) := by
  classical
  refine (Fintype.linearIndependent_iff (R := ℤ) (M := spanColSum A cs)
    (v := fun k : Fin r =>
      (⟨colSum A (fun i => (cs k i : ℝ)), colSum_mem_spanColSum A cs k⟩ : spanColSum A cs))).mpr ?_
  intro d hd k
  change d k = (0 : ℤ)
  have hE0 : (∑ j : Fin r, (d j : ℤ) • colSum A (fun i => (cs j i : ℝ))) = 0 := by
    have hmap := congrArg (fun x : spanColSum A cs => (x : E)) hd
    simpa using hmap
  exact (Fintype.linearIndependent_iff (R := ℤ) (M := E)
    (v := fun j : Fin r => colSum A (fun i => (cs j i : ℝ)))).mp hind d hE0 k

/-- The lifted `colSum` vectors span the whole submodule. -/
lemma spanColSum_span_top {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ) :
    ⊤ ≤ Submodule.span ℤ (Set.range (fun k : Fin r =>
      (⟨colSum A (fun i => (cs k i : ℝ)), colSum_mem_spanColSum A cs k⟩ : spanColSum A cs))) := by
  intro x hx
  have hxE : (x : E) ∈ (spanColSum A cs : Set E) := x.2
  rcases (Submodule.mem_span_range_iff_exists_fun (R := ℤ) (M := E)
    (v := fun k : Fin r => colSum A (fun i => (cs k i : ℝ))) (x := (x : E))).mp hxE with ⟨d, hd⟩
  refine (Submodule.mem_span_range_iff_exists_fun (R := ℤ) (M := spanColSum A cs)
    (v := fun k : Fin r =>
      (⟨colSum A (fun i => (cs k i : ℝ)), colSum_mem_spanColSum A cs k⟩ : spanColSum A cs))
    (x := x)).mpr ⟨d, ?_⟩
  apply Subtype.ext
  simpa using hd


/-- When the `colSum`-vectors are `ℤ`-independent they are a `ℤ`-basis of `spanColSum A cs`. -/
def spanColSum_basis {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ)
    (hind : LinearIndependent ℤ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) :
    Module.Basis (Fin r) ℤ (spanColSum A cs) :=
  Module.Basis.mk (spanColSum_linearIndependent A cs hind) (spanColSum_span_top A cs)

/-- The basis of `spanColSum A cs` evaluates to the `colSum`-vectors. -/
lemma spanColSum_basis_apply {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ) (cs : Fin r → Fin m → ℤ)
    (hind : LinearIndependent ℤ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) (k : Fin r) :
    ((spanColSum_basis A cs hind k : spanColSum A cs) : E) = colSum A (fun i => (cs k i : ℝ)) := by
  dsimp [spanColSum_basis]
  rw [Module.Basis.coe_mk]

/-- **(iii)(c)** The determinant of the sublattice spanned by the `colSum`-vectors equals
`volColSum` (`√det(gram)`) — via `Uncrossing.det_eq_sqrt_gram_any_basis` with the
`colSum`-basis. -/
lemma determinant_spanColSum_eq_vol {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ)
    (cs : Fin r → Fin m → ℤ)
    (hind : LinearIndependent ℤ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ))))
    [DiscreteTopology (spanColSum A cs)] :
    ReverseMinkowski.determinant (spanColSum A cs) = volColSum (m := m) cs A := by
  classical
  haveI : Module.Free ℤ (spanColSum A cs) := instModuleFree_of_discrete_submodule (spanColSum A cs)
  haveI : Module.Finite ℤ (spanColSum A cs) := instModuleFinite_of_discrete_submodule (spanColSum A cs)
  let β : Module.Basis (Fin r) ℤ (spanColSum A cs) := spanColSum_basis A cs hind
  have hβ : ∀ k : Fin r, ((β k : spanColSum A cs) : E) = colSum A (fun i => (cs k i : ℝ)) := by
    intro k
    simpa [β] using (spanColSum_basis_apply A cs hind k)
  have hdet : ReverseMinkowski.determinant (spanColSum A cs) =
      Real.sqrt ((Matrix.gram ℝ (fun j : Fin r => ((β j : spanColSum A cs) : E))).det) := by
    exact Submission.Uncrossing.det_eq_sqrt_gram_any_basis (L := spanColSum A cs) β
  calc
    ReverseMinkowski.determinant (spanColSum A cs)
        = Real.sqrt ((Matrix.gram ℝ (fun j : Fin r => ((β j : spanColSum A cs) : E))).det) := hdet
    _ = volColSum (m := m) cs A := by
        have hfam : (fun j : Fin r => ((β j : spanColSum A cs) : E)) =
            fun j : Fin r => colSum A (fun i => (cs j i : ℝ)) := funext hβ
        rw [hfam]
        dsimp [volColSum]

/-- ℝ-independence of the ambient `colSum`-vectors implies their ℤ-independence. -/
lemma linearIndependent_int_of_real_colSum {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ)
    (cs : Fin r → Fin m → ℤ)
    (h : LinearIndependent ℝ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) :
    LinearIndependent ℤ (fun k : Fin r => colSum A (fun i => (cs k i : ℝ))) := by
  classical
  refine (Fintype.linearIndependent_iff (R := ℤ) (M := E)
    (v := fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))).mpr ?_
  intro d hd k
  change d k = (0 : ℤ)
  have hℝ : (∑ j : Fin r, (d j : ℝ) • colSum A (fun i => (cs j i : ℝ))) = 0 := by
    calc
      (∑ j : Fin r, (d j : ℝ) • colSum A (fun i => (cs j i : ℝ)))
          = ∑ j : Fin r, (d j : ℤ) • colSum A (fun i => (cs j i : ℝ)) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            exact Int.cast_smul_eq_zsmul (R := ℝ) (d j) (colSum A (fun i => (cs j i : ℝ)))
      _ = 0 := hd
  have hkℝ : ((d k : ℤ) : ℝ) = ((0 : ℤ) : ℝ) := by
    simpa using ((Fintype.linearIndependent_iff (R := ℝ) (M := E)
      (v := fun j : Fin r => colSum A (fun i => (cs j i : ℝ)))).mp h
      (fun j : Fin r => (d j : ℝ)) hℝ k)
  exact (Int.cast_inj (α := ℝ)).mp hkℝ

/-- **(iii)(d)** For a tuple `cs` whose limit `colSum`-vectors are ℝ-independent: stability of
the whole sequence `latticeOfMatrix (An n)` forces `1 ≤ volColSum cs A₀`.  (On the tail the
vectors are ℝ-independent, hence ℤ-independent; `spanColSum (An n) cs` is then a discrete
rank-`r` sublattice with determinant `volColSum cs (An n)` and `≥ 1` by stability; the
eventually-`≥ 1` bound passes to the limit.) -/
theorem volColSum_ge_one_of_stable_sequence {r : ℕ} (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (hdetn : ∀ n : ℕ, (An n).det ≠ 0)
    (hStn : ∀ n : ℕ, @Submission.StableLattices.Stable m (latticeOfMatrix (An n))
      (latticeOfMatrix_discrete (An n) (hdetn n)))
    (cs : Fin r → Fin m → ℤ)
    (h0 : LinearIndependent ℝ (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ)))) :
    1 ≤ volColSum (m := m) cs A₀ := by
  classical
  apply volColSum_ge_one_of_eventually (m := m) A₀ An hconv cs
  have htail := linearIndependent_colSum_eventually (m := m) A₀ An hconv cs h0
  refine htail.mono ?_
  intro n hindℝ
  have hindZ : LinearIndependent ℤ (fun k : Fin r => colSum (An n) (fun i => (cs k i : ℝ))) :=
    linearIndependent_int_of_real_colSum (An n) cs hindℝ
  have hDTn : DiscreteTopology (latticeOfMatrix (An n)) := latticeOfMatrix_discrete (An n) (hdetn n)
  have hDTspan : DiscreteTopology (spanColSum (An n) cs) := by
    haveI : DiscreteTopology (latticeOfMatrix (An n)) := hDTn
    exact submodule_discrete_of_discrete (hle := spanColSum_le_latticeOfMatrix (An n) cs)
  haveI : DiscreteTopology (spanColSum (An n) cs) := hDTspan
  have hvol : ReverseMinkowski.determinant (spanColSum (An n) cs) = volColSum (m := m) cs (An n) :=
    determinant_spanColSum_eq_vol (An n) cs hindZ
  have hle : spanColSum (An n) cs ≤ latticeOfMatrix (An n) := spanColSum_le_latticeOfMatrix (An n) cs
  have hSt : @Submission.StableLattices.Stable m (latticeOfMatrix (An n))
      (latticeOfMatrix_discrete (An n) (hdetn n)) := hStn n
  have h1 : 1 ≤ ReverseMinkowski.determinant (spanColSum (An n) cs) := hSt.2 (spanColSum (An n) cs) hle
  rwa [hvol] at h1

/-- **(iii) realization**: if the vectors `colSum A (cs k)` are exactly the ambient values of
a ℤ-basis `b` of a submodule `S`, then `spanColSum A cs = S` (basis coefficients give back
the span). -/
lemma spanColSum_eq_self_of_basis {r : ℕ} (A : Matrix (Fin m) (Fin m) ℝ)
    (cs : Fin r → Fin m → ℤ) {S : Submodule ℤ E} (b : Module.Basis (Fin r) ℤ S)
    (hb : ∀ k : Fin r, ((b k : S) : E) = colSum A (fun i => (cs k i : ℝ))) :
    spanColSum A cs = S := by
  classical
  calc
    spanColSum A cs = Submodule.span ℤ (Set.range (fun k : Fin r => colSum A (fun i => (cs k i : ℝ)))) := rfl
    _ = Submodule.span ℤ (Set.range (fun k : Fin r => ((b k : S) : E))) := by
          congr 1
          ext y
          constructor
          · rintro ⟨k, rfl⟩
            exact ⟨k, hb k⟩
          · rintro ⟨k, rfl⟩
            exact ⟨k, (hb k).symm⟩
    _ = S := span_values_eq_lattice b

/-- **(iii) arbitrary-sublattice bound**: if a sequence of stable lattices `latticeOfMatrix
(An n)` converges to `latticeOfMatrix A₀`, then every sublattice of the limit has
determinant `≥ 1`. -/
lemma subdet_ge_one_of_stable_sequence (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (hdetn : ∀ n : ℕ, (An n).det ≠ 0) (hdet0 : A₀.det ≠ 0)
    (hStn : ∀ n : ℕ, @Submission.StableLattices.Stable m (latticeOfMatrix (An n))
      (latticeOfMatrix_discrete (An n) (hdetn n)))
    (ℒ' : Submodule ℤ E) [DiscreteTopology ℒ'] (hle : ℒ' ≤ latticeOfMatrix A₀) :
    1 ≤ ReverseMinkowski.determinant ℒ' := by
  classical
  haveI : Module.Free ℤ ℒ' := instModuleFree_of_discrete_submodule ℒ'
  haveI : Module.Finite ℤ ℒ' := instModuleFinite_of_discrete_submodule ℒ'
  let r : ℕ := Module.finrank ℤ ℒ'
  let b : Module.Basis (Fin r) ℤ ℒ' := Module.finBasis ℤ ℒ'
  let cs : Fin r → Fin m → ℤ := fun k =>
    Classical.choose ((mem_span_cols_iff A₀ ((b k : ℒ') : E)).mp (hle (b k).property))
  have hck (k : Fin r) : colSum A₀ (fun i => ((cs k) i : ℝ)) = ((b k : ℒ') : E) := by
    dsimp [cs]
    exact Classical.choose_spec ((mem_span_cols_iff A₀ ((b k : ℒ') : E)).mp (hle (b k).property))
  have hreal : spanColSum A₀ cs = ℒ' := by
    refine spanColSum_eq_self_of_basis A₀ cs b ?_
    intro k
    exact (hck k).symm
  have hℝw : LinearIndependent ℝ (fun k : Fin r => ((b k : ℒ') : E)) :=
    Commons.LinearAlgebra.Independence.discrete_basis_values_linIndep (ℒ := ℒ') b
  have h0 : LinearIndependent ℝ (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ))) := by
    have hfam : (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ))) =
        fun k : Fin r => ((b k : ℒ') : E) := funext hck
    rwa [← hfam] at hℝw
  have hvol : 1 ≤ volColSum (m := m) cs A₀ :=
    volColSum_ge_one_of_stable_sequence A₀ An hconv hdetn hStn cs h0
  have hDTs : DiscreteTopology (spanColSum A₀ cs) := by
    haveI : DiscreteTopology (latticeOfMatrix A₀) := latticeOfMatrix_discrete A₀ hdet0
    exact submodule_discrete_of_discrete (hle := spanColSum_le_latticeOfMatrix A₀ cs)
  haveI : DiscreteTopology (spanColSum A₀ cs) := hDTs
  have hZ : LinearIndependent ℤ (fun k : Fin r => colSum A₀ (fun i => (cs k i : ℝ))) :=
    linearIndependent_int_of_real_colSum A₀ cs h0
  have hvolS : ReverseMinkowski.determinant (spanColSum A₀ cs) = volColSum (m := m) cs A₀ :=
    determinant_spanColSum_eq_vol A₀ cs hZ
  have hdeteq : ReverseMinkowski.determinant ℒ' = volColSum (m := m) cs A₀ := by
    calc
      ReverseMinkowski.determinant ℒ' = ReverseMinkowski.determinant (spanColSum A₀ cs) := by
        exact Submission.Uncrossing.det_eq_of_eq (L₁ := ℒ') (L₂ := spanColSum A₀ cs) hreal.symm
      _ = volColSum (m := m) cs A₀ := hvolS
  rwa [← hdeteq] at hvol

/-- **(iii) THE STABLE CLOSURE**: the limit of a convergent sequence of stable
matrix-lattices is stable. -/
theorem stable_latticeOfMatrix_of_stable_sequence (A₀ : Matrix (Fin m) (Fin m) ℝ)
    (An : ℕ → Matrix (Fin m) (Fin m) ℝ) (hconv : Filter.Tendsto An Filter.atTop (𝓝 A₀))
    (hdetn : ∀ n : ℕ, (An n).det ≠ 0) (hdet0 : A₀.det ≠ 0)
    (hStn : ∀ n : ℕ, @Submission.StableLattices.Stable m (latticeOfMatrix (An n))
      (latticeOfMatrix_discrete (An n) (hdetn n))) :
    @Submission.StableLattices.Stable m (latticeOfMatrix A₀) (latticeOfMatrix_discrete A₀ hdet0) := by
  classical
  haveI : DiscreteTopology (latticeOfMatrix A₀) := latticeOfMatrix_discrete A₀ hdet0
  constructor
  · exact det_one_latticeOfMatrix_of_stable_sequence A₀ An hconv hdetn hStn hdet0
  · intro ℒ' hle hDT
    exact subdet_ge_one_of_stable_sequence A₀ An hconv hdetn hdet0 hStn ℒ' hle

/-- Full-rankness of `latticeOfMatrix A` from `det A ≠ 0`. -/
lemma finrank_latticeOfMatrix (A : Matrix (Fin m) (Fin m) ℝ) (hdet : A.det ≠ 0)
    [DiscreteTopology (latticeOfMatrix A)] : Module.finrank ℤ (latticeOfMatrix A) = m := by
  classical
  haveI : Module.Free ℤ (latticeOfMatrix A) := instModuleFree_of_discrete_submodule (latticeOfMatrix A)
  haveI : Module.Finite ℤ (latticeOfMatrix A) := instModuleFinite_of_discrete_submodule (latticeOfMatrix A)
  simpa using (Module.finrank_eq_card_basis (colsBasis_Z A hdet))
