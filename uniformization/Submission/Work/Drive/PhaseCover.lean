/-!
# The phase cover of a Riemann surface

Let `X` be a connected Riemann surface, `z₀ : X`, `E : X → ℝ` harmonic off `z₀` and
`Θ : X → ℂ` continuous and nonzero off `z₀`.

This module builds the *phase cover*: the covering space of `X` whose sheets are the local branches
of the multivalued function `E* + arg Θ` (a conjugate of `E` plus an argument of `Θ`).  Its point is
that this multivalued function is *single-valued near `z₀`* — the pole of `E*` cancels the simple
zero of `Θ` — so that, unlike the conjugate étale space of `E`, its sheets form a covering space of
*all* of `X`.  Consequently the monodromy of the phase cover around a loop that is null-homotopic in
`X` is trivial, which is how the period of the conjugate of `E` is matched with the winding number
of `Θ`.

The construction follows `Submission/Conjugate.lean` (`conjTopology`): the topology on `X × ℝ` is
generated by the graphs of the local branches `lam`, and the projection to `X` is shown to be a
covering map by exhibiting, at each point, a local branch `lam` and identifying the sheets over a
neighbourhood with the translates `lam + c`.
-/

open LeanEval.Geometry
open scoped Manifold ContDiff Topology

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

noncomputable section

open Filter Set Classical

namespace Work.Drive

variable {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X]
  [SecondCountableTopology X] [ChartedSpace ℂ X]
  [IsManifold (modelWithCornersSelf ℂ ℂ) 1 X]

/-! ## Phase branches and the phase topology -/

/-- **A phase branch.**  A continuous function `lam` on the open set `V` which is, at every point of
`V` other than the pole `z₀`, locally the sum of the imaginary part of a holomorphic branch of `E`
and the imaginary part of a continuous logarithm of `Θ`. -/
def IsPhaseBranch (z₀ : X) (E : X → ℝ) (Θ : X → ℂ) (V : Set X) (lam : X → ℝ) : Prop :=
  IsOpen V ∧ ContinuousOn lam V ∧
    ∀ y ∈ V, y ≠ z₀ → ∃ (W : Set X) (F : X → ℂ) (w : X → ℂ),
      IsOpen W ∧ y ∈ W ∧ W ⊆ V ∧
      Submission.HolomorphicOnX F W ∧ (∀ z ∈ W, (F z).re = E z) ∧
      ContinuousOn w W ∧ (∀ z ∈ W, Complex.exp (w z) = Θ z) ∧
      ∀ z ∈ W, lam z = (F z).im + (w z).im

/-- The graph of a phase branch. -/
def phaseGraph (V : Set X) (lam : X → ℝ) : Set (X × ℝ) := {p | p.1 ∈ V ∧ p.2 = lam p.1}

/-- The generating family of the phase topology: the graphs of all phase branches. -/
def phaseFamily (z₀ : X) (E : X → ℝ) (Θ : X → ℂ) : Set (Set (X × ℝ)) :=
  {S | ∃ (V : Set X) (lam : X → ℝ), IsPhaseBranch z₀ E Θ V lam ∧ S = phaseGraph V lam}

/-- **The phase topology** on `X × ℝ`. -/
def phaseTopology (z₀ : X) (E : X → ℝ) (Θ : X → ℂ) : TopologicalSpace (X × ℝ) :=
  TopologicalSpace.generateFrom (phaseFamily z₀ E Θ)

theorem isOpen_phaseGraph {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {V : Set X} {lam : X → ℝ}
    (h : IsPhaseBranch z₀ E Θ V lam) : IsOpen[phaseTopology z₀ E Θ] (phaseGraph V lam) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨V, lam, h, rfl⟩

/-- A phase branch restricted to a smaller open set. -/
theorem IsPhaseBranch.mono {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {V V' : Set X} {lam : X → ℝ}
    (h : IsPhaseBranch z₀ E Θ V lam) (hV'o : IsOpen V') (hsub : V' ⊆ V) :
    IsPhaseBranch z₀ E Θ V' lam := by
  obtain ⟨hVo, hcont, hloc⟩ := h
  refine ⟨hV'o, hcont.mono hsub, fun y hy hy0 => ?_⟩
  obtain ⟨W, F, w, hWo, hyW, hWV, hF, hFre, hw, hwe, hlam⟩ := hloc y (hsub hy) hy0
  exact ⟨W ∩ V', F, w, hWo.inter hV'o, ⟨hyW, hy⟩, Set.inter_subset_right,
    hF.mono Set.inter_subset_left, (fun z hz => hFre z hz.1), hw.mono Set.inter_subset_left,
    (fun z hz => hwe z hz.1), (fun z hz => hlam z hz.1)⟩

/-- Shifting a phase branch by a real constant. -/
theorem IsPhaseBranch.add_const {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {V : Set X} {lam : X → ℝ}
    (h : IsPhaseBranch z₀ E Θ V lam) (c : ℝ) :
    IsPhaseBranch z₀ E Θ V (fun y => lam y + c) := by
  obtain ⟨hVo, hcont, hloc⟩ := h
  refine ⟨hVo, hcont.add continuousOn_const, fun y hy hy0 => ?_⟩
  obtain ⟨W, F, w, hWo, hyW, hWV, hF, hFre, hw, hwe, hlam⟩ := hloc y hy hy0
  refine ⟨W, fun z => F z + (c : ℂ) * Complex.I, w, hWo, hyW, hWV, ?_, ?_, hw, hwe, ?_⟩
  · exact hF.add (Submission.holomorphicOnX_const _)
  · intro z hz
    have h1 : (F z + (c : ℂ) * Complex.I).re = (F z).re := by
      simp [Complex.add_re, Complex.mul_re]
    rw [h1, hFre z hz]
  · intro z hz
    have h1 : (F z + (c : ℂ) * Complex.I).im = (F z).im + c := by
      simp [Complex.add_im, Complex.mul_im]
    show lam z + c = (F z + (c : ℂ) * Complex.I).im + (w z).im
    rw [h1, hlam z hz]
    ring

/-! ## Local structure: differences of phase branches are locally constant -/

/-- An integer whose `2πi`-multiple has norm less than `2π` vanishes. -/
private theorem int_eq_zero_of_norm_two_pi_I_lt {k : ℤ}
    (h : ‖(k : ℂ) * (2 * Real.pi * Complex.I)‖ < 2 * Real.pi) : k = 0 := by
  have hpos : (0 : ℝ) < 2 * Real.pi := by positivity
  have h4 : (k : ℂ) * (2 * Real.pi * Complex.I)
      = (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I := by
    push_cast; ring
  rw [h4] at h
  rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs] at h
  rw [abs_mul, abs_of_pos hpos] at h
  have h5 : |(k : ℝ)| < 1 := by
    have h5' : |(k : ℝ)| * (2 * Real.pi) < 1 * (2 * Real.pi) := by rw [one_mul]; exact h
    exact lt_of_mul_lt_mul_right h5' (le_of_lt hpos)
  rw [abs_lt] at h5
  have h6 : (-1 : ℤ) < k := by exact_mod_cast h5.1
  have h7 : k < 1 := by exact_mod_cast h5.2
  omega

/-- **Differences of phase branches are locally constant** (away from the pole). -/
theorem phaseBranch_sub_eventuallyEq {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {V₁ V₂ : Set X}
    {lam₁ lam₂ : X → ℝ} (h₁ : IsPhaseBranch z₀ E Θ V₁ lam₁) (h₂ : IsPhaseBranch z₀ E Θ V₂ lam₂)
    {y : X} (hy₁ : y ∈ V₁) (hy₂ : y ∈ V₂) (hy0 : y ≠ z₀) :
    ∀ᶠ z in 𝓝 y, lam₁ z - lam₂ z = lam₁ y - lam₂ y := by
  obtain ⟨-, hc₁, hl₁⟩ := h₁
  obtain ⟨-, hc₂, hl₂⟩ := h₂
  obtain ⟨W₁, F₁, w₁, hW₁o, hyW₁, hW₁V, hF₁, hF₁re, hw₁, hw₁e, hlam₁⟩ := hl₁ y hy₁ hy0
  obtain ⟨W₂, F₂, w₂, hW₂o, hyW₂, hW₂V, hF₂, hF₂re, hw₂, hw₂e, hlam₂⟩ := hl₂ y hy₂ hy0
  -- the difference of the conjugate parts is eventually constant
  have hF : ∀ᶠ z in 𝓝 y, F₁ z - F₂ z = F₁ y - F₂ y := by
    refine Submission.eventual_const_of_eventually_re (B := W₁ ∩ W₂) (hW₁o.inter hW₂o)
      (hF₁.mono Set.inter_subset_left |>.sub (hF₂.mono Set.inter_subset_right)) ?_ ⟨hyW₁, hyW₂⟩
    intro z hz
    simp [Complex.sub_re, hF₁re z hz.1, hF₂re z hz.2]
  -- the difference of the log parts is eventually constant
  have hw : ∀ᶠ z in 𝓝 y, w₁ z - w₂ z = w₁ y - w₂ y := by
    have hexp : ∀ z ∈ W₁ ∩ W₂, Complex.exp (w₁ z - w₂ z) = 1 := by
      intro z hz
      have hne : Θ z ≠ 0 := by rw [← hw₁e z hz.1]; exact Complex.exp_ne_zero _
      rw [Complex.exp_sub, hw₁e z hz.1, hw₂e z hz.2, div_self hne]
    have hmem : ∀ z ∈ W₁ ∩ W₂, ∃ n : ℤ, w₁ z - w₂ z = (n : ℂ) * (2 * Real.pi * Complex.I) :=
      fun z hz => Complex.exp_eq_one_iff.mp (hexp z hz)
    have hcont : ContinuousAt (fun z => w₁ z - w₂ z) y :=
      (hw₁.continuousAt (hW₁o.mem_nhds hyW₁)).sub (hw₂.continuousAt (hW₂o.mem_nhds hyW₂))
    have hclose : ∀ᶠ z in 𝓝 y,
        ‖(w₁ z - w₂ z) - (w₁ y - w₂ y)‖ < 2 * Real.pi := by
      have htend : Tendsto (fun z => (w₁ z - w₂ z) - (w₁ y - w₂ y)) (𝓝 y) (𝓝 0) := by
        simpa using hcont.tendsto.sub_const (w₁ y - w₂ y)
      have := (Metric.tendsto_nhds.mp htend) (2 * Real.pi) (by positivity)
      filter_upwards [this] with z hz
      simpa [dist_eq_norm] using hz
    filter_upwards [hclose, hW₁o.mem_nhds hyW₁, hW₂o.mem_nhds hyW₂] with z hz1 hzW₁ hzW₂
    obtain ⟨n, hn⟩ := hmem z ⟨hzW₁, hzW₂⟩
    obtain ⟨m, hm⟩ := hmem y ⟨hyW₁, hyW₂⟩
    have hdiff : (w₁ z - w₂ z) - (w₁ y - w₂ y) = ((n - m : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
      rw [hn, hm]; push_cast; ring
    have hzero : (w₁ z - w₂ z) - (w₁ y - w₂ y) = 0 := by
      have hnm : (n - m : ℤ) = 0 :=
        int_eq_zero_of_norm_two_pi_I_lt (k := n - m) (by rw [← hdiff]; exact hz1)
      rw [hdiff, hnm]
      norm_num
    exact sub_eq_zero.mp hzero
  have key : ∀ z ∈ W₁, ∀ z' ∈ W₂, lam₁ z - lam₂ z' = (F₁ z - F₂ z').im + (w₁ z - w₂ z').im := by
    intro z hz z' hz'
    rw [hlam₁ z hz, hlam₂ z' hz', Complex.sub_im, Complex.sub_im]
    ring
  filter_upwards [hF, hw, hW₁o.mem_nhds hyW₁, hW₂o.mem_nhds hyW₂] with z hzF hzw hzW₁ hzW₂
  rw [key z hzW₁ z hzW₂, key y hyW₁ y hyW₂, hzF, hzw]



section Existence

/-- A chart ball whose closed ball lies in the chart's target is simply connected. -/
theorem isSimplyConnected_chartBall_of_closedBall_subset {x : X} {ρ : ℝ} (hρ : 0 < ρ)
    (hsub : Metric.closedBall ((chartAt ℂ x) x) ρ ⊆ (chartAt ℂ x).target) :
    IsSimplyConnected (Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ) := by
  have htrans := Work.SimplyConnected.ABS.chartBall_transport (chartAt ℂ x) hρ hsub
  have himg : (chartAt ℂ x).symm '' Metric.ball ((chartAt ℂ x) x) ρ
      = Submission.chartBall (chartAt ℂ x) ((chartAt ℂ x) x) ρ := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      have hzt : z ∈ (chartAt ℂ x).target := Metric.ball_subset_closedBall.trans hsub hz
      rw [Submission.mem_chartBall]
      exact ⟨(chartAt ℂ x).map_target hzt,
        by rw [(chartAt ℂ x).right_inv hzt]; exact hz⟩
    · intro hy
      rw [Submission.mem_chartBall] at hy
      exact ⟨(chartAt ℂ x) y, hy.2, (chartAt ℂ x).left_inv hy.1⟩
  rw [← himg]
  exact htrans.2.2.2.2.2.2

/-- **Local existence of a phase branch with a prescribed value, away from the pole.** -/
theorem exists_isPhaseBranch_nhds {z₀ : X} {E : X → ℝ} {Θ : X → ℂ}
    (hEharm : Submission.HarmonicOnX E (Set.univ \ {z₀})) (hΘ : Continuous Θ)
    (hΘne : ∀ x : X, x ≠ z₀ → Θ x ≠ 0) {y : X} (hy : y ≠ z₀) (s : ℝ) :
    ∃ (V : Set X) (lam : X → ℝ), IsPhaseBranch z₀ E Θ V lam ∧ V ∈ 𝓝 y ∧
      (∀ z ∈ V, z ≠ z₀) ∧ lam y = s := by
  classical
  set e : OpenPartialHomeomorph X ℂ := chartAt ℂ y with he
  set c : ℂ := e y with hc
  obtain ⟨ρ₁, hρ₁, hρ₁sub⟩ : ∃ ρ₁ > 0, Metric.ball c ρ₁ ⊆ e.target :=
    Metric.isOpen_iff.mp e.open_target c (hc ▸ mem_chart_target ℂ y)
  obtain ⟨ρ₂, hρ₂, hρ₂inv⟩ :=
    Work.Modulus.BranchCovering.Aux.exists_chartBall_avoiding (z₀ := z₀) (x := y) hy
  set ρ : ℝ := min (ρ₁ / 2) ρ₂ with hρdef
  have hρpos : 0 < ρ := lt_min (by linarith) hρ₂
  have hρle₁ : ρ ≤ ρ₁ / 2 := min_le_left _ _
  have hρle₂ : ρ ≤ ρ₂ := min_le_right _ _
  have hball : Metric.closedBall c ρ ⊆ e.target :=
    (Metric.closedBall_subset_ball (by linarith : ρ < ρ₁)).trans hρ₁sub
  have hnotz₀ : ∀ z ∈ Submission.chartBall e c ρ, z ≠ z₀ := fun z hz =>
    hρ₂inv z (Work.Modulus.BranchCovering.Aux.chartBall_subset_of_le hρle₂ hz)
  have hEchart : Submission.HarmonicOnX E (Submission.chartBall e c ρ) :=
    fun z hz => hEharm z ⟨mem_univ z, hnotz₀ z hz⟩
  have hexF := Work.SimplyConnected.ABS.exists_holomorphicOnX_re_of_harmonicOn_chartBall
      hρpos hball hEchart
  let F : X → ℂ := Classical.choose hexF
  have hFhol : Submission.HolomorphicOnX F (Submission.chartBall e c ρ) :=
    (Classical.choose_spec hexF).1
  have hFre : ∀ z ∈ Submission.chartBall e c ρ, (F z).re = E z :=
    (Classical.choose_spec hexF).2
  haveI : LocallyPathConnectedSpace X := ChartedSpace.locallyPathConnectedSpace ℂ X
  have hzero : (0 : ℂ) ∉ Θ '' Submission.chartBall e c ρ := by
    rintro ⟨z, hz, hz0⟩
    exact hΘne z (hnotz₀ z hz) hz0
  have hexw := Complex.exists_continuousOn_eqOn_exp_comp (X := X)
      (U := Submission.chartBall e c ρ)
      (isSimplyConnected_chartBall_of_closedBall_subset hρpos hball)
      (Submission.chartBall_isOpen e c ρ) (g := Θ) hΘ.continuousOn hzero
  let w : X → ℂ := Classical.choose hexw
  have hwcont : ContinuousOn w (Submission.chartBall e c ρ) := (Classical.choose_spec hexw).1
  have hwexp : ∀ x ∈ Submission.chartBall e c ρ, Complex.exp (w x) = Θ x :=
    (Classical.choose_spec hexw).2
  have hFy : y ∈ Submission.chartBall e c ρ := by
    rw [Submission.mem_chartBall]
    exact ⟨mem_chart_source ℂ y, by rw [hc]; exact Metric.mem_ball_self hρpos⟩
  set cc : ℝ := s - ((F y).im + (w y).im) with hcc
  refine ⟨Submission.chartBall e c ρ,
    fun x => (F x + ((cc : ℝ) : ℂ) * Complex.I).im + (w x).im,
    ?_, (Submission.chartBall_isOpen e c ρ).mem_nhds hFy, hnotz₀, ?_⟩
  · refine ⟨Submission.chartBall_isOpen e c ρ, ?_, ?_⟩
    · have h1 : ContinuousOn (fun x => F x + (cc : ℂ) * Complex.I) (Submission.chartBall e c ρ) :=
        fun x hx =>
          ((hFhol.add (Submission.holomorphicOnX_const _)) x hx).continuousAt.continuousWithinAt
      exact (Complex.continuous_im.comp_continuousOn h1).add (Complex.continuous_im.comp_continuousOn hwcont)
    · intro z hz hz0
      refine ⟨Submission.chartBall e c ρ, fun x => F x + (cc : ℂ) * Complex.I, w,
        Submission.chartBall_isOpen e c ρ, hz, Subset.rfl,
        hFhol.add (Submission.holomorphicOnX_const _), ?_, hwcont, hwexp, ?_⟩
      · intro z' hz'
        have h1 : (F z' + (cc : ℂ) * Complex.I).re = (F z').re := by
          simp [Complex.add_re, Complex.mul_re]
        rw [h1]; exact hFre z' hz'
      · intro z' hz'
        rfl
  · have h1 : (F y + (cc : ℂ) * Complex.I).im = (F y).im + cc := by
      simp [Complex.add_im, Complex.mul_im]
    show (F y + (cc : ℂ) * Complex.I).im + (w y).im = s
    rw [h1, hcc]; ring

end Existence



section Model

/-- **The model phase branch at the pole.**  Near the pole `z₀`, the phase function
`E* + arg Θ` is single-valued: the logarithmic pole of `E` cancels the simple zero of `Θ`.  This is
the branch that makes the phase cover a covering space over `z₀` as well. -/
theorem exists_isPhaseBranch_at_pole {z₀ : X} {E : X → ℝ} {Θ : X → ℂ}
    (hEharm : Submission.HarmonicOnX E (Set.univ \ {z₀}))
    (hpole : Work.SimplyConnected.ABS.HasLogPoleOn (Set.univ \ {z₀}) z₀ E)
    (hΘ : Continuous Θ) (hΘne : ∀ x : X, x ≠ z₀ → Θ x ≠ 0)
    {u : X → ℂ} {V : Set X} (hV : V ∈ 𝓝 z₀) (huc : ContinuousOn u V)
    (hune : ∀ x ∈ V, u x ≠ 0)
    (hu : ∀ x ∈ V, Θ x = ((chartAt ℂ z₀) x - (chartAt ℂ z₀) z₀) * u x) :
    ∃ (ρ : ℝ) (lam : X → ℝ), 0 < ρ ∧
      IsPhaseBranch z₀ E Θ (Submission.chartBall (chartAt ℂ z₀) ((chartAt ℂ z₀) z₀) ρ) lam := by
  classical
  set e : OpenPartialHomeomorph X ℂ := chartAt ℂ z₀ with he
  set ζ : ℂ := e z₀ with hζ
  have hsrc : z₀ ∈ e.source := mem_chart_source ℂ z₀
  obtain ⟨ρ₁, hρ₁, hρ₁sub⟩ : ∃ ρ₁ > 0, Metric.ball ζ ρ₁ ⊆ e.target :=
    Metric.isOpen_iff.mp e.open_target ζ (hζ ▸ mem_chart_target ℂ z₀)
  obtain ⟨ρ₂, hρ₂, hρ₂sub⟩ := Work.Modulus.BranchCovering.Aux.exists_chartBall_subset_of_mem_nhds hV
  obtain ⟨C, VC, hVC, hCbound⟩ := hpole
  obtain ⟨ρ₃, hρ₃, hρ₃sub⟩ := Work.Modulus.BranchCovering.Aux.exists_chartBall_subset_of_mem_nhds hVC
  set ρ : ℝ := min (min ρ₁ ρ₂) ρ₃ / 2 with hρdef
  have hminpos : 0 < min (min ρ₁ ρ₂) ρ₃ := lt_min (lt_min hρ₁ hρ₂) hρ₃
  have hρpos : 0 < ρ := by rw [hρdef]; linarith
  have hρlt₁ : ρ < ρ₁ := by
    have h2 : min (min ρ₁ ρ₂) ρ₃ ≤ ρ₁ := (min_le_left _ _).trans (min_le_left _ _)
    rw [hρdef]; linarith
  have hρle₂ : ρ ≤ ρ₂ := by
    have h2 : min (min ρ₁ ρ₂) ρ₃ ≤ ρ₂ := (min_le_left _ _).trans (min_le_right _ _)
    rw [hρdef]; linarith
  have hρle₃ : ρ ≤ ρ₃ := by
    have h2 : min (min ρ₁ ρ₂) ρ₃ ≤ ρ₃ := min_le_right _ _
    rw [hρdef]; linarith
  have hsub_target : Metric.closedBall ζ ρ ⊆ e.target :=
    (Metric.closedBall_subset_ball hρlt₁).trans hρ₁sub
  have hball_sub : Metric.ball ζ ρ ⊆ e.target := Metric.ball_subset_closedBall.trans hsub_target
  -- the chart ball
  set B : Set X := Submission.chartBall e ζ ρ with hB
  have hBo : IsOpen B := Submission.chartBall_isOpen e ζ ρ
  have hBV : B ⊆ V := fun x hx =>
    hρ₂sub (Work.Modulus.BranchCovering.Aux.chartBall_subset_of_le hρle₂ hx)
  have hBV' : B ⊆ VC := fun x hx =>
    hρ₃sub (Work.Modulus.BranchCovering.Aux.chartBall_subset_of_le hρle₃ hx)
  have hBsrc : ∀ x ∈ B, x ∈ e.source := fun x hx => (Submission.mem_chartBall.mp hx).1
  have hBtgt : ∀ x ∈ B, e x ∈ e.target := fun x hx => hball_sub (Submission.mem_chartBall.mp hx).2
  have hz₀B : z₀ ∈ B := by
    rw [hB, Submission.mem_chartBall]
    exact ⟨hsrc, by rw [hζ]; exact Metric.mem_ball_self hρpos⟩
  -- ## the disc-side data
  have hHD_harm : ∀ w : ℂ, w ∈ Metric.ball ζ ρ → w ≠ ζ →
      InnerProductSpace.HarmonicAt (fun w => E (e.symm w) + Real.log ‖w - ζ‖) w := by
    intro w hw hwne
    have hwt : w ∈ e.target := hball_sub hw
    have hxsrc : e.symm w ∈ e.source := e.map_target hwt
    have hwinv : e (e.symm w) = w := e.right_inv hwt
    have hxne : e.symm w ≠ z₀ := fun h => hwne (by rw [← hwinv, h, hζ])
    have hEat : Submission.HarmonicOnXAt E (e.symm w) := hEharm (e.symm w) ⟨mem_univ _, hxne⟩
    have hEchart : InnerProductSpace.HarmonicAt (fun w : ℂ => E (e.symm w)) w := by
      have h1 := (Commons.Geometry.Manifold.harmonicAt_pullback_iff_chart (u := E)
        (x := e.symm w) (y := z₀) hxsrc).mp hEat
      simpa [Function.comp_def, ← he, hwinv] using h1
    exact hEchart.add
      ((analyticAt_id.sub analyticAt_const).harmonicAt_log_norm (sub_ne_zero.mpr hwne))
  have hHD_bound : ∃ M : ℝ, ∀ w : ℂ, w ∈ Metric.ball ζ ρ → w ≠ ζ →
      |E (e.symm w) + Real.log ‖w - ζ‖| ≤ M := by
    refine ⟨C, fun w hw hwne => ?_⟩
    have hwt : w ∈ e.target := hball_sub hw
    have hwinv : e (e.symm w) = w := e.right_inv hwt
    have hxB : e.symm w ∈ B := by
      rw [hB, Submission.mem_chartBall]
      exact ⟨e.map_target hwt, by rw [hwinv]; exact hw⟩
    have hxne : e.symm w ≠ z₀ := fun h => hwne (by rw [← hwinv, h, hζ])
    have h1 := hCbound (e.symm w) (hBV' hxB) ⟨mem_univ _, hxne⟩ hxne
    simpa [Function.comp_def, ← hζ, ← he, hwinv] using h1
  -- ## the extension to the disc and the analytic function
  obtain ⟨M, hM⟩ := hHD_bound
  obtain ⟨H, hHharm, hHeq⟩ :=
    Work.Potential.punctured_ball_harmonic_extension (a := ζ) (ρ := ρ) (M := M) hρpos
      (fun z hz hzne => hHD_harm z (Metric.mem_ball.mpr (by rw [dist_eq_norm]; exact hz)) hzne)
      (fun z hz hzne => hM z (Metric.mem_ball.mpr (by rw [dist_eq_norm]; exact hz)) hzne)
  have hHnhd : InnerProductSpace.HarmonicOnNhd H (Metric.ball ζ ρ) := fun w hw =>
    hHharm w (by rwa [Metric.mem_ball, dist_eq_norm] at hw)
  obtain ⟨FD, hFDana, hFDre⟩ :=
    InnerProductSpace.HarmonicOnNhd.exists_analyticOnNhd_ball_re_eq (f := H) (z := ζ) (R := ρ) hHnhd
  -- ## a continuous logarithm of `u` on the disc
  have hsym_cont : ContinuousOn e.symm (Metric.ball ζ ρ) := fun w hw =>
    (e.continuousAt_symm (hball_sub hw)).continuousWithinAt
  have hmapV : ∀ w ∈ Metric.ball ζ ρ, e.symm w ∈ V := fun w hw => hBV (by
    rw [hB, Submission.mem_chartBall]
    exact ⟨e.map_target (hball_sub hw), by rw [e.right_inv (hball_sub hw)]; exact hw⟩)
  have huD_cont : ContinuousOn (fun w : ℂ => u (e.symm w)) (Metric.ball ζ ρ) :=
    huc.comp hsym_cont hmapV
  have huD_ne : (0 : ℂ) ∉ (fun w : ℂ => u (e.symm w)) '' Metric.ball ζ ρ := by
    rintro ⟨w, hw, hw0⟩
    exact hune (e.symm w) (hmapV w hw) hw0
  have hexf := Complex.exists_continuousOn_eqOn_exp_comp (X := ℂ) (U := Metric.ball ζ ρ)
    (Work.Analysis.Complex.isSimplyConnected_ball hρpos) Metric.isOpen_ball huD_cont huD_ne
  let fD : ℂ → ℂ := Classical.choose hexf
  have hfDcont : ContinuousOn fD (Metric.ball ζ ρ) := (Classical.choose_spec hexf).1
  have hfDexp : ∀ w ∈ Metric.ball ζ ρ, Complex.exp (fD w) = u (e.symm w) :=
    (Classical.choose_spec hexf).2
  -- ## the model branch
  refine ⟨ρ, fun x => (FD (e x)).im + (fD (e x)).im, hρpos, hBo, ?_, ?_⟩
  · -- continuity
    have heOn : ContinuousOn e B := e.continuousOn.mono (fun x hx => (Submission.mem_chartBall.mp hx).1)
    have hmapB : ∀ x ∈ B, e x ∈ Metric.ball ζ ρ := fun x hx => (Submission.mem_chartBall.mp hx).2
    have h1 : ContinuousOn (fun x => FD (e x)) B := hFDana.continuousOn.comp heOn hmapB
    have h2 : ContinuousOn (fun x => fD (e x)) B := hfDcont.comp heOn hmapB
    exact (Complex.continuous_im.comp_continuousOn h1).add
      (Complex.continuous_im.comp_continuousOn h2)
  · -- the local form
    intro y hy hy0
    have hyne : e y ≠ ζ := fun h =>
      hy0 (e.injOn (hBsrc y hy) hsrc (by rw [← hζ]; exact h))
    set d : ℂ := e y - ζ with hd
    have hdne : d ≠ 0 := sub_ne_zero.mpr hyne
    have hdpos : 0 < ‖d‖ := norm_pos_iff.mpr hdne
    set θ : ℝ := Complex.arg d with hθ
    have hexpnorm : ‖Complex.exp (-(θ : ℂ) * Complex.I)‖ = 1 := by
      rw [Complex.norm_exp]
      have h0 : (-(θ : ℂ) * Complex.I).re = 0 := by
        simp [Complex.mul_re, Complex.neg_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
          Complex.I_im]
      rw [h0, Real.exp_zero]
    have harg : d * Complex.exp (-(θ : ℂ) * Complex.I) = (‖d‖ : ℂ) := by
      have h1 : (‖d‖ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I) = d := by
        have := Complex.norm_mul_exp_arg_mul_I d
        simpa [hθ] using this
      have h2 : Complex.exp ((θ : ℂ) * Complex.I) * Complex.exp (-(θ : ℂ) * Complex.I) = 1 := by
        rw [← Complex.exp_add]; simp
      calc d * Complex.exp (-(θ : ℂ) * Complex.I)
          = ((‖d‖ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) * Complex.exp (-(θ : ℂ) * Complex.I) := by
            rw [h1]
        _ = (‖d‖ : ℂ) := by rw [mul_assoc, h2, mul_one]
    set r : ℝ := ‖d‖ / 2 with hr
    have hrpos : 0 < r := by rw [hr]; linarith
    set g : ℂ → ℂ := fun w =>
      Complex.log ((w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I)) + (θ : ℂ) * Complex.I with hg
    -- the slit-plane condition on the small disc
    have hslit' : ∀ w ∈ Metric.ball (e y) r,
        (w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I) ∈ Complex.slitPlane := by
      intro w hw
      have hw' : ‖w - e y‖ < r := by rwa [Metric.mem_ball, dist_eq_norm] at hw
      have h1 : w - ζ = d + (w - e y) := by rw [hd]; ring
      have h2 : ((w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I)).re
          = ‖d‖ + (((w - e y) * Complex.exp (-(θ : ℂ) * Complex.I))).re := by
        rw [h1, add_mul, harg, Complex.add_re, Complex.ofReal_re]
      have h3 : |(((w - e y) * Complex.exp (-(θ : ℂ) * Complex.I))).re| ≤ ‖w - e y‖ := by
        calc |(((w - e y) * Complex.exp (-(θ : ℂ) * Complex.I))).re|
            ≤ ‖(w - e y) * Complex.exp (-(θ : ℂ) * Complex.I)‖ := Complex.abs_re_le_norm _
          _ = ‖w - e y‖ := by rw [norm_mul, hexpnorm, mul_one]
      have h4 : 0 < ((w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I)).re := by
        rw [h2]
        have := neg_le_abs (((w - e y) * Complex.exp (-(θ : ℂ) * Complex.I))).re
        linarith
      exact Complex.mem_slitPlane_iff.mpr (Or.inl h4)
    have hgcont : ContinuousOn g (Metric.ball (e y) r) := by
      have h1 : ContinuousOn (fun w : ℂ => (w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I))
          (Metric.ball (e y) r) :=
        ((continuousOn_id.sub continuousOn_const).mul continuousOn_const)
      exact (h1.clog hslit').add continuousOn_const
    set W : Set X := B ∩ Submission.chartBall e (e y) r with hW
    have hWo : IsOpen W := hBo.inter (Submission.chartBall_isOpen e (e y) r)
    have hyW : y ∈ W := ⟨hy, by
      rw [Submission.mem_chartBall]
      exact ⟨hBsrc y hy, by rw [hr]; exact Metric.mem_ball_self hrpos⟩⟩
    have hWB : W ⊆ B := Set.inter_subset_left
    have hzball : ∀ z ∈ W, e z ∈ Metric.ball ζ ρ := fun z hz =>
      (Submission.mem_chartBall.mp (hWB hz)).2
    have hzball' : ∀ z ∈ W, e z ∈ Metric.ball (e y) r := fun z hz =>
      (Submission.mem_chartBall.mp hz.2).2
    have hzsrc : ∀ z ∈ W, z ∈ e.source := fun z hz => (Submission.mem_chartBall.mp (hWB hz)).1
    have hzV : ∀ z ∈ W, z ∈ V := fun z hz => hBV (hWB hz)
    have hzζ : ∀ z ∈ W, e z ≠ ζ := by
      intro z hz h
      have h1 : ‖e z - ζ‖ = 0 := by rw [h]; simp
      have h2 : e z - ζ = d + (e z - e y) := by rw [hd]; ring
      have h3 : ‖d‖ ≤ ‖e z - ζ‖ + ‖e z - e y‖ := by
        have h4 : e z - ζ = d + (e z - e y) := by rw [hd]; ring
        rw [h4]
        simpa using norm_sub_le (d + (e z - e y)) (e z - e y)
      have h4 : ‖e z - e y‖ < r := by
        rw [← dist_eq_norm]; exact hzball' z hz
      rw [h1] at h3
      linarith
    refine ⟨W, fun x => FD (e x) - g (e x), fun x => fD (e x) + g (e x),
      hWo, hyW, hWB, ?_, ?_, ?_, ?_, ?_⟩
    · -- holomorphy
      intro z hz
      rw [Submission.HolomorphicOnXAt_iff_chart (hzsrc z hz)]
      have hev : ((fun x => FD (e x) - g (e x)) ∘ e.symm)
          =ᶠ[𝓝 (e z)] (fun w => FD w - g w) := by
        filter_upwards [e.open_target.mem_nhds (hBtgt z (hWB hz))] with w hw
        simp only [Function.comp_apply]
        rw [e.right_inv hw]
      have hgan : AnalyticAt ℂ g (e z) := by
        have h1 : AnalyticAt ℂ (fun w : ℂ => (w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I))
            (e z) := (analyticAt_id.sub analyticAt_const).mul analyticAt_const
        have h2 : (fun w : ℂ => (w - ζ) * Complex.exp (-(θ : ℂ) * Complex.I)) (e z)
            ∈ Complex.slitPlane := hslit' (e z) (hzball' z hz)
        exact (h1.clog h2).add analyticAt_const
      have hgoal : AnalyticAt ℂ ((fun x => FD (e x) - g (e x)) ∘ e.symm) (e z) :=
        AnalyticAt.congr ((hFDana (e z) (hzball z hz)).sub hgan) hev.symm
      simpa [he] using hgoal
    · -- the real part
      intro z hz
      have hzb : e z ∈ Metric.ball ζ ρ := hzball z hz
      have hzζ' : e z ≠ ζ := hzζ z hz
      have hgre : (g (e z)).re = Real.log ‖e z - ζ‖ := by
        have h1 : (Complex.log ((e z - ζ) * Complex.exp (-(θ : ℂ) * Complex.I))).re
            = Real.log ‖e z - ζ‖ := by
          rw [Complex.log_re, norm_mul, hexpnorm, mul_one]
        have h2 : ((θ : ℂ) * Complex.I).re = 0 := by simp [Complex.mul_re]
        rw [hg]
        simp only [Complex.add_re]
        rw [h1, h2, add_zero]
      have hFDre' : (FD (e z)).re = H (e z) := hFDre hzb
      have hHval : H (e z) = E (e.symm (e z)) + Real.log ‖e z - ζ‖ :=
        hHeq (e z) (by simpa [dist_eq_norm] using hzb) hzζ'
      calc ((fun x => FD (e x) - g (e x)) z).re = (FD (e z)).re - (g (e z)).re := by
            simp [Complex.sub_re]
        _ = H (e z) - Real.log ‖e z - ζ‖ := by rw [hFDre', hgre]
        _ = E (e.symm (e z)) := by rw [hHval]; ring
        _ = E z := by rw [e.left_inv (hzsrc z hz)]
    · -- continuity of the logarithmic part
      have heOn : ContinuousOn e W := e.continuousOn.mono (fun x hx => hzsrc x hx)
      have h1 : ContinuousOn (fun x => fD (e x)) W := hfDcont.comp heOn hzball
      have h2 : ContinuousOn (fun x => g (e x)) W := hgcont.comp heOn hzball'
      exact h1.add h2
    · -- the exponential
      intro z hz
      have hzb : e z ∈ Metric.ball ζ ρ := hzball z hz
      have hzζ' : e z ≠ ζ := hzζ z hz
      have hne : (e z - ζ) * Complex.exp (-(θ : ℂ) * Complex.I) ≠ 0 :=
        mul_ne_zero (sub_ne_zero.mpr hzζ') (Complex.exp_ne_zero _)
      have hgexp : Complex.exp (g (e z)) = (e z - ζ) := by
        rw [hg, Complex.exp_add, Complex.exp_log hne]
        have h2 : Complex.exp (-(θ : ℂ) * Complex.I) * Complex.exp ((θ : ℂ) * Complex.I) = 1 := by
          rw [← Complex.exp_add]; simp
        rw [mul_assoc, h2, mul_one]
      calc Complex.exp ((fun x => fD (e x) + g (e x)) z)
          = Complex.exp (fD (e z)) * Complex.exp (g (e z)) := by rw [Complex.exp_add]
        _ = u (e.symm (e z)) * (e z - ζ) := by rw [hfDexp _ hzb, hgexp]
        _ = (e z - ζ) * u z := by rw [e.left_inv (hzsrc z hz)]; ring
        _ = Θ z := (hu z (hzV z hz)).symm
    · -- the branch identity
      intro z hz
      simp only [Complex.sub_im, Complex.add_im]
      ring

end Model





section Openness

/-- **The set where two phase branches differ by a fixed constant is a neighbourhood of the pole**
when they agree in value there. -/
theorem phaseBranch_sub_mem_nhds_at_pole {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {V₁ V₂ : Set X}
    {lam₁ lam₂ : X → ℝ} (h₁ : IsPhaseBranch z₀ E Θ V₁ lam₁) (h₂ : IsPhaseBranch z₀ E Θ V₂ lam₂)
    (hz₁ : z₀ ∈ V₁) (hz₂ : z₀ ∈ V₂) {c : ℝ} (hc : lam₁ z₀ - lam₂ z₀ = c) :
    {y : X | y ∈ V₁ ∧ y ∈ V₂ ∧ lam₁ y - lam₂ y = c} ∈ 𝓝 z₀ := by
  set e : OpenPartialHomeomorph X ℂ := chartAt ℂ z₀ with he
  set ζ : ℂ := e z₀ with hζ
  have hsrc : z₀ ∈ e.source := mem_chart_source ℂ z₀
  have hmem : V₁ ∩ V₂ ∈ 𝓝 z₀ := inter_mem (h₁.1.mem_nhds hz₁) (h₂.1.mem_nhds hz₂)
  obtain ⟨ρ₁, hρ₁, hρ₁sub⟩ :=
    Work.Modulus.BranchCovering.Aux.exists_chartBall_subset_of_mem_nhds hmem
  obtain ⟨ρ₂, hρ₂, hρ₂sub⟩ : ∃ ρ₂ > 0, Metric.ball ζ ρ₂ ⊆ e.target :=
    Metric.isOpen_iff.mp e.open_target ζ (hζ ▸ mem_chart_target ℂ z₀)
  set ρ : ℝ := min ρ₁ (ρ₂ / 4) with hρdef
  have hρpos : 0 < ρ := lt_min hρ₁ (by linarith)
  have hρlt : ρ < ρ₂ / 2 := by
    have h2 : ρ ≤ ρ₂ / 4 := min_le_right _ _
    linarith
  have hρle₁ : ρ ≤ ρ₁ := min_le_left _ _
  have hsub : Metric.closedBall ζ (ρ₂ / 2) ⊆ e.target :=
    (Metric.closedBall_subset_ball (by linarith)).trans hρ₂sub
  set D : Set X := Submission.chartBall e ζ ρ with hD
  have hDo : IsOpen D := Submission.chartBall_isOpen e ζ ρ
  have hz₀D : z₀ ∈ D := by
    rw [hD, Submission.mem_chartBall]
    exact ⟨hsrc, by rw [hζ]; exact Metric.mem_ball_self hρpos⟩
  have hDV : D ⊆ V₁ ∩ V₂ := fun x hx =>
    hρ₁sub (Work.Modulus.BranchCovering.Aux.chartBall_subset_of_le hρle₁ (hD ▸ hx))
  have hDpc : IsPreconnected (D \ {z₀}) :=
    Work.Analysis.RiemannSurface.isPreconnected_chartBall_sdiff_singleton hρpos hρlt hsub hζ hsrc
  have hcl : z₀ ∈ closure (D \ {z₀}) :=
    Work.Analysis.RiemannSurface.mem_closure_chartBall_sdiff_singleton hρpos hζ hsrc
  haveI : PreconnectedSpace ↥(D \ {z₀}) := isPreconnected_iff_preconnectedSpace.mp hDpc
  have hLC : IsLocallyConstant (fun w : ↥(D \ {z₀}) => lam₁ (w : X) - lam₂ (w : X)) := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro w
    have hev := phaseBranch_sub_eventuallyEq h₁ h₂ ((hDV w.2.1).1) ((hDV w.2.1).2) w.2.2
    exact ((continuous_subtype_val.continuousAt (x := w)).tendsto.eventually hev)
  have hne : ∃ w : X, w ∈ D \ {z₀} := by
    obtain ⟨w, hw⟩ := mem_closure_iff.mp hcl Set.univ isOpen_univ (mem_univ z₀)
    exact ⟨w, hw.2⟩
  obtain ⟨y₀, hy₀⟩ := hne
  have hy₀D : y₀ ∈ D := hy₀.1
  have hy₀ne : y₀ ≠ z₀ := hy₀.2
  set v : ℝ := lam₁ y₀ - lam₂ y₀ with hv
  have hval : ∀ w ∈ D, w ≠ z₀ → lam₁ w - lam₂ w = v := fun w hw hwne =>
    IsLocallyConstant.apply_eq_of_isPreconnected hLC isPreconnected_univ
      (x := ⟨w, hw, hwne⟩) (y := ⟨y₀, hy₀D, hy₀ne⟩) trivial trivial
  have hcontAt : ContinuousAt (fun z => lam₁ z - lam₂ z) z₀ :=
    (h₁.2.1.continuousAt (h₁.1.mem_nhds hz₁)).sub (h₂.2.1.continuousAt (h₂.1.mem_nhds hz₂))
  have hvz : lam₁ z₀ - lam₂ z₀ = v := by
    by_contra hne'
    set ε : ℝ := ‖(lam₁ z₀ - lam₂ z₀) - v‖ / 2 with hεdef
    have hεpos : 0 < ε := by
      rw [hεdef]
      exact half_pos (norm_pos_iff.mpr (sub_ne_zero.mpr hne'))
    have hevv := hcontAt.tendsto.eventually
      (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (x := lam₁ z₀ - lam₂ z₀) hεpos))
    obtain ⟨W, hWV, hWo, hz₀W⟩ := mem_nhds_iff.mp hevv
    obtain ⟨w, hwW, hwD⟩ := mem_closure_iff.mp hcl W hWo hz₀W
    have hwval : lam₁ w - lam₂ w = v := hval w hwD.1 hwD.2
    have hwclose := hWV hwW
    simp only [Set.mem_ofPred_eq] at hwclose
    rw [dist_eq_norm, hwval, norm_sub_rev, hεdef] at hwclose
    linarith
  refine Filter.mem_of_superset (hDo.mem_nhds hz₀D) ?_
  intro w hw
  refine ⟨(hDV hw).1, (hDV hw).2, ?_⟩
  by_cases hw0 : w = z₀
  · rw [hw0, hc]
  · rw [hval w hw hw0, ← hvz, hc]

/-- **The set where two phase branches differ by a fixed constant is open.** -/
theorem isOpen_setOf_phaseBranch_sub_eq {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {V₁ V₂ : Set X}
    {lam₁ lam₂ : X → ℝ} (h₁ : IsPhaseBranch z₀ E Θ V₁ lam₁) (h₂ : IsPhaseBranch z₀ E Θ V₂ lam₂)
    (c : ℝ) :
    IsOpen {y : X | y ∈ V₁ ∧ y ∈ V₂ ∧ lam₁ y - lam₂ y = c} := by
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨hy₁, hy₂, hyc⟩
  by_cases hy0 : y = z₀
  · rw [hy0]
    rw [hy0] at hy₁ hy₂ hyc
    exact phaseBranch_sub_mem_nhds_at_pole h₁ h₂ hy₁ hy₂ hyc
  · have hev := phaseBranch_sub_eventuallyEq h₁ h₂ hy₁ hy₂ hy0
    filter_upwards [hev, h₁.1.mem_nhds hy₁, h₂.1.mem_nhds hy₂] with z hz hz₁ hz₂
    exact ⟨hz₁, hz₂, by rw [hz, hyc]⟩

end Openness









section Covering

/-- If `lam` is a phase branch on the open set `U`, then `U` is open in the phase topology (i.e.
the projection of the phase cover is continuous on the sheets over `U`). -/
theorem isOpen_preimage_fst_of_isPhaseBranch {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {U : Set X}
    {lam : X → ℝ} (hbr : IsPhaseBranch z₀ E Θ U lam) :
    IsOpen[phaseTopology z₀ E Θ] (Prod.fst ⁻¹' U) := by
  letI : TopologicalSpace (X × ℝ) := phaseTopology z₀ E Θ
  have hset : (Prod.fst ⁻¹' U : Set (X × ℝ))
      = Set.iUnion (fun c : ℝ => phaseGraph U (fun y => lam y + c)) := by
    ext p
    constructor
    · intro hp
      exact Set.mem_iUnion.mpr ⟨p.2 - lam p.1, hp, by ring⟩
    · intro hp
      obtain ⟨c, hc, -⟩ := Set.mem_iUnion.mp hp
      exact hc
  rw [hset]
  exact isOpen_iUnion fun c => isOpen_phaseGraph (hbr.add_const c)

/-- **The phase projection is evenly covered at a point admitting a phase branch nearby.** -/
theorem isEvenlyCovered_fst_of_isPhaseBranch {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {x : X} {U : Set X}
    {lam : X → ℝ} (hbr : IsPhaseBranch z₀ E Θ U lam) (hxU : x ∈ U)
    (hdisc : @DiscreteTopology ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ))
      ((phaseTopology z₀ E Θ).induced Subtype.val)) :
    @IsEvenlyCovered (X × ℝ) X (phaseTopology z₀ E Θ) (inferInstanceAs (TopologicalSpace X))
      Prod.fst x ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) ((phaseTopology z₀ E Θ).induced Subtype.val) := by
  classical
  letI : TopologicalSpace (X × ℝ) := phaseTopology z₀ E Θ
  have hUo : IsOpen U := hbr.1
  let Hfun : ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) → ↥U × ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) := fun e =>
    (⟨e.1.1, e.2⟩, ⟨(x, e.1.2 - lam e.1.1 + lam x), rfl⟩)
  let Hinv : ↥U × ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) → ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) := fun z =>
    ⟨(z.1.1, z.2.1.2 + lam z.1.1 - lam x), z.1.2⟩
  have hleft : Function.LeftInverse Hinv Hfun := by
    intro e
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · show e.1.2 - lam e.1.1 + lam x + lam e.1.1 - lam x = e.1.2
      ring
  have hright : Function.RightInverse Hinv Hfun := by
    intro z
    have h1 : (Hfun (Hinv z)).1 = z.1 := Subtype.ext rfl
    have h2 : (Hfun (Hinv z)).2 = z.2 := by
      apply Subtype.ext
      apply Prod.ext
      · exact (z.2.2).symm
      · show z.2.1.2 + lam z.1.1 - lam x - lam z.1.1 + lam x = z.2.1.2
        ring
    exact Prod.ext h1 h2
  have hcont1 : Continuous (fun e : ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) =>
      (⟨e.1.1, e.2⟩ : ↥U)) := by
    have hfst : Continuous (fun e : ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) => (e.1.1 : X)) := by
      rw [continuous_def]
      intro O hO
      have hset : (fun e : ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) => (e.1.1 : X)) ⁻¹' O
          = Subtype.val ⁻¹' Set.iUnion (fun c : ℝ =>
              phaseGraph (O ∩ U) (fun y => lam y + c)) := by
        ext e
        constructor
        · intro he
          exact Set.mem_iUnion.mpr ⟨e.1.2 - lam e.1.1, ⟨he, e.2⟩, by ring⟩
        · intro he
          obtain ⟨c, hc, -⟩ := Set.mem_iUnion.mp he
          exact hc.1
      rw [hset]
      exact (isOpen_iUnion fun c =>
        isOpen_phaseGraph ((hbr.mono (hO.inter hUo) Set.inter_subset_right).add_const c)).preimage
        continuous_subtype_val
    exact Continuous.subtype_mk (p := fun y : X => y ∈ U) hfst (fun e => e.2)
  have hcont2 : Continuous (fun e : ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) =>
      (⟨(x, e.1.2 - lam e.1.1 + lam x), rfl⟩ : ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)))) := by
    rw [continuous_def]
    intro O hO
    have hset : (fun e : ↥(Prod.fst ⁻¹' U : Set (X × ℝ)) =>
        (⟨(x, e.1.2 - lam e.1.1 + lam x), rfl⟩ : ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)))) ⁻¹' O
        = Set.iUnion (fun i : ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) =>
            Set.iUnion (fun _ : i ∈ O =>
              Subtype.val ⁻¹' phaseGraph U (fun y => lam y + (i.1.2 - lam x)))) := by
      ext e
      simp only [Set.mem_preimage, Set.mem_iUnion]
      constructor
      · intro he
        refine ⟨⟨(x, (e : X × ℝ).2 - lam (e : X × ℝ).1 + lam x), rfl⟩, he, ?_⟩
        exact ⟨e.2, by ring⟩
      · rintro ⟨i, hi, hy⟩
        have h2 : (e : X × ℝ).2 = lam (e : X × ℝ).1 + (i.1.2 - lam x) := hy.2
        have h3 : i = ⟨(x, (e : X × ℝ).2 - lam (e : X × ℝ).1 + lam x), rfl⟩ := by
          apply Subtype.ext
          apply Prod.ext
          · exact i.2
          · show i.1.2 = (e : X × ℝ).2 - lam (e : X × ℝ).1 + lam x
            linarith [h2]
        rw [h3] at hi
        exact hi
    rw [hset]
    refine isOpen_iUnion fun i => isOpen_iUnion fun _ => ?_
    exact (isOpen_phaseGraph (hbr.add_const _)).preimage continuous_subtype_val
  have hcontHfun : Continuous Hfun := hcont1.prodMk hcont2
  have hcontHinvX : Continuous (fun z : ↥U × ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) =>
      (Hinv z : X × ℝ)) := by
    rw [continuous_def]
    intro S hS
    change TopologicalSpace.GenerateOpen (phaseFamily z₀ E Θ) S at hS
    induction hS with
    | basic s hs =>
        obtain ⟨V', lam', hbr', rfl⟩ := hs
        rw [show (fun z : ↥U × ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) => (Hinv z : X × ℝ)) ⁻¹'
              phaseGraph V' lam'
            = Set.iUnion (fun i : ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) =>
                ({b : ↥U | b.1 ∈ V' ∧ lam' b.1 - lam b.1 = i.1.2 - lam x} ×ˢ {i})) from ?_]
        · refine isOpen_iUnion fun i => ?_
          have hbase : IsOpen {b : ↥U | b.1 ∈ V' ∧ lam' b.1 - lam b.1 = i.1.2 - lam x} := by
            have hset : {b : ↥U | b.1 ∈ V' ∧ lam' b.1 - lam b.1 = i.1.2 - lam x}
                = Subtype.val ⁻¹' {y : X | y ∈ V' ∧ y ∈ U ∧
                    lam' y - lam y = i.1.2 - lam x} := by
              ext b
              exact ⟨fun h => ⟨h.1, b.2, h.2⟩, fun h => ⟨h.1, h.2.2⟩⟩
            rw [hset]
            exact (isOpen_setOf_phaseBranch_sub_eq hbr' hbr _).preimage continuous_subtype_val
          exact hbase.prod (isOpen_discrete _)
        · ext z
          obtain ⟨b, i⟩ := z
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_prod, Set.mem_setOf_eq,
            Set.mem_singleton_iff, phaseGraph, Hinv]
          constructor
          · rintro ⟨hzV, hz2⟩
            exact ⟨i, ⟨hzV, by linarith⟩, rfl⟩
          · rintro ⟨i', ⟨hzV, hz2⟩, hi'⟩
            subst hi'
            exact ⟨hzV, by linarith⟩
    | univ => simp
    | inter s t _ _ ihs iht => rw [Set.preimage_inter]; exact ihs.inter iht
    | sUnion S _ ih =>
        rw [Set.preimage_sUnion]
        exact isOpen_iUnion fun t => isOpen_iUnion fun ht => ih t ht
  have hcontHinv : Continuous Hinv := by
    have h := Continuous.subtype_mk (p := fun p : X × ℝ => p ∈ Prod.fst ⁻¹' U) hcontHinvX
      (fun z => (Hinv z).2)
    simpa using h
  refine ⟨hdisc, U, hxU, hUo, isOpen_preimage_fst_of_isPhaseBranch hbr,
    ⟨⟨⟨Hfun, Hinv, hleft, hright⟩, hcontHfun, hcontHinv⟩, fun e => rfl⟩⟩

/-- **The fibre of the phase cover is discrete.**  Every point of the fibre over `x` is realised by
some branch `lam + c`, and that branch realises *only* that point over `x`, so the singletons are
open in the induced topology. -/
theorem discreteTopology_phaseFiber {z₀ : X} {E : X → ℝ} {Θ : X → ℂ} {U : Set X} {lam : X → ℝ}
    (hbr : IsPhaseBranch z₀ E Θ U lam) {x : X} (hxU : x ∈ U) :
    @DiscreteTopology ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)) ((phaseTopology z₀ E Θ).induced
      Subtype.val) := by
  letI : TopologicalSpace (X × ℝ) := phaseTopology z₀ E Θ
  rw [discreteTopology_iff_isOpen_singleton]
  rintro ⟨p, hp⟩
  have hp1 : p.1 = x := hp
  have hxU' : p.1 ∈ U := by rw [hp1]; exact hxU
  have hbr' : IsPhaseBranch z₀ E Θ U (fun y => lam y + (p.2 - lam p.1)) := hbr.add_const _
  have hmem : p ∈ phaseGraph U (fun y => lam y + (p.2 - lam p.1)) := by
    refine ⟨hxU', ?_⟩
    show p.2 = lam p.1 + (p.2 - lam p.1)
    ring
  rw [show ({⟨p, hp⟩} : Set ↥(Prod.fst ⁻¹' {x} : Set (X × ℝ)))
      = Subtype.val ⁻¹' phaseGraph U (fun y => lam y + (p.2 - lam p.1)) from ?_]
  · exact (isOpen_phaseGraph hbr').preimage continuous_subtype_val
  · ext q
    constructor
    · intro hq
      rw [Set.mem_singleton_iff] at hq
      rw [hq]
      exact hmem
    · intro hq
      rw [Set.mem_singleton_iff]
      have hq1 : (q : X × ℝ).1 = x := q.2
      have hq2 : (q : X × ℝ).2 = lam (q : X × ℝ).1 + (p.2 - lam p.1) := hq.2
      refine Subtype.ext (Prod.ext ?_ ?_)
      · rw [hq1, hp1]
      · have : lam (q : X × ℝ).1 + (p.2 - lam p.1) = p.2 := by rw [hq1, hp1]; ring
        rw [hq2, this]

/-- **The phase cover is a covering space of `X`.** -/
theorem isCoveringMap_phaseProj {z₀ : X} {E : X → ℝ} {Θ : X → ℂ}
    (hEharm : Submission.HarmonicOnX E (Set.univ \ {z₀}))
    (hpole : Work.SimplyConnected.ABS.HasLogPoleOn (Set.univ \ {z₀}) z₀ E)
    (hΘ : Continuous Θ) (hΘne : ∀ x : X, x ≠ z₀ → Θ x ≠ 0)
    (hloc : ∃ (u : X → ℂ) (V : Set X), V ∈ nhds z₀ ∧ ContinuousOn u V ∧
      (∀ x ∈ V, u x ≠ 0) ∧
      ∀ x ∈ V, Θ x = ((chartAt ℂ z₀) x - (chartAt ℂ z₀) z₀) * u x) :
    @IsCoveringMap (X × ℝ) X (phaseTopology z₀ E Θ) (inferInstanceAs (TopologicalSpace X))
      Prod.fst := by
  rcases hloc with ⟨u, V, hV, huc, hune, hu⟩
  intro x
  by_cases hx : x = z₀
  · rw [hx]
    obtain ⟨ρ, lam, hρ, hbr⟩ :=
      exists_isPhaseBranch_at_pole (z₀ := z₀) hEharm hpole hΘ hΘne hV huc hune hu
    refine isEvenlyCovered_fst_of_isPhaseBranch (x := z₀) hbr ?_
      (discreteTopology_phaseFiber hbr ?_)
    · rw [Submission.mem_chartBall]
      exact ⟨mem_chart_source ℂ z₀, Metric.mem_ball_self hρ⟩
    · rw [Submission.mem_chartBall]
      exact ⟨mem_chart_source ℂ z₀, Metric.mem_ball_self hρ⟩
  · obtain ⟨V', lam, hbr, hmem, hne, -⟩ := exists_isPhaseBranch_nhds hEharm hΘ hΘne hx 0
    have hxV' : x ∈ V' := mem_of_mem_nhds hmem
    exact isEvenlyCovered_fst_of_isPhaseBranch (x := x) hbr hxV'
      (discreteTopology_phaseFiber hbr hxV')

end Covering





