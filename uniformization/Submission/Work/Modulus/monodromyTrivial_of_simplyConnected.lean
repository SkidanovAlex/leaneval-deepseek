import Mathlib
import Submission.Work.Modulus.Defs
import Submission.Work.SimplyConnected.ModulusDefs
import Submission.Work.SimplyConnected.ModulusMain
import Submission.Work.SimplyConnected.Modulus.isCoveringMap_branchProj
import Submission.Work.SimplyConnected.Modulus.exists_isModulusBranch_at_pole
import Submission.Work.Modulus.BranchCovering.isCoveringMap_branchProj
import Submission.Work.Modulus.BranchCovering.branchOfUnitGreen

/-!
# Triviality of the monodromy of the multivalued modulus of a Green function

Let `X` be a connected complex one-manifold (a Riemann surface) which is simply connected, let
`z₀ : X`, and let `E : X → ℝ` be a Green function with pole `z₀` in the sense of
`Work.UnitGreen.IsUnitGreenFunctionAt`.  This file proves that the multivalued holomorphic function
`Φ = exp (-(E + iE*))` attached to `E` is single-valued: there is a *global* holomorphic `Φ` which
does not vanish off `z₀` and has modulus `exp (-E)` there.

The mathematical content is the monodromy argument in the form designed in
`Work.SC.ModulusDefs`: the branches of `Φ` (encoded by the pair `(Φ x, Φ'(x))`, the derivative
being needed at the pole, where all branches vanish) form a covering space

`Work.SC.branchProj z₀ E : Work.SC.ModulusBundle z₀ E → X`

for the étale topology generated by the graphs of the local branches.  The covering-space statement
`Work.SimplyConnected.Modulus.isCoveringMap_branchProj` is the local computation: a branch `Φ₀` on
a chart ball `B` around a point `p` exists (locally, `exp (-(E + iE*))` is a branch, and at the pole
the logarithmic singularity of `E` cancels the simple zero of the coordinate), and every branch
near a point of `B` is a constant multiple `c Φ₀` with `|c| = 1`, so that the bundle over `B` is
`B × S¹` — `S¹` carrying the discrete topology, as it must in the étale space of a locally constant
sheaf.

Since `X` is simply connected the monodromy of every loop is trivial, so the covering has a global
continuous section `σ` (`Commons.Topology.Covering.section_of_monodromy_eq_self_weak`); the value
coordinate `Φ x := (σ x)₂` is then holomorphic, because `σ` is locally contained in the graph of a
local branch, and its modulus is `exp (-E)` off the pole by definition of a branch.  This assembly is
`Work.SC.exists_holomorphic_modulus_of_isCoveringMap`; the present file supplies its covering-space
input and the non-emptiness of the bundle (a local branch at the pole).
-/

open LeanEval.Geometry
open scoped Manifold ContDiff Topology

set_option linter.unusedSectionVars false

noncomputable section

open Filter Set

namespace Work.Modulus

/-- **Triviality of the monodromy of the multivalued modulus.**  On a simply connected Riemann
surface the branches of the modulus `exp (-E)` of a Green function `E` with pole `z₀` patch to a
single-valued holomorphic function. -/
theorem monodromyTrivial_of_simplyConnected
    {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X] [SecondCountableTopology X]
    [ChartedSpace ℂ X] [IsManifold (modelWithCornersSelf ℂ ℂ) 1 X]
    {z₀ : X} {E : X → ℝ} (hE : Work.UnitGreen.IsUnitGreenFunctionAt z₀ E) [SimplyConnectedSpace X] :
    ∃ Φ : X → ℂ, Submission.HolomorphicOnX Φ Set.univ ∧ (∀ x, x ≠ z₀ → Φ x ≠ 0) ∧
      (∀ x, x ≠ z₀ → ‖Φ x‖ = Real.exp (-(E x))) := by
  refine Work.SC.exists_holomorphic_modulus_of_isCoveringMap
    (Work.Modulus.BranchCovering.isCoveringMap_branchProj (z₀ := z₀) hE) ?_
  -- the bundle is non-empty: a branch of the modulus exists near the pole
  obtain ⟨U, Φ, hbr, hU, -⟩ :=
    Work.Modulus.BranchCovering.Aux.exists_isModulusBranch_at_pole_of_unitGreen (z₀ := z₀) hE
  exact ⟨(z₀, Φ z₀, Work.SC.chartDeriv Φ z₀), U, Φ, hbr, mem_of_mem_nhds hU, rfl, rfl⟩

end Work.Modulus
