import Mathlib
import Submission.Work.Polygon.GraysonData
import Submission.Commons.Analysis.InnerProductSpace.exteriorPower_norm_concat_orthogonal
import Submission.Commons.Analysis.InnerProductSpace.norm_iMulti_snoc_orthonormal

/-!
# The wedge/projection covolume identity (P2/P3 block layer, step A1)

For an `ℝ`-independent family `u : Fin r → E d` and a vector `w : E d`, the norm of the
`(r+1)`-fold exterior product of the family with `w` appended decomposes as

    `‖ιMulti (snoc u w)‖ = ‖ιMulti u‖ · ‖w − π_w‖`,

where `π_w = (span ℝ (range u)).starProjection w` is the orthogonal projection of `w` onto
the span of `u` (so `‖w − π_w‖` is the distance from `w` to that span — the projective
height of `w` modulo the family).  This is the exact **projection-covolume identity**
needed by the §3 block layer: forming the lattice generated by `V` and one further vector
multiplies the covolume by the distance of that vector to `V` (Hadamard-type inequality
`covol(V + ℤw) ≤ covol(V)·‖w‖`).

Proof: decompose `w = p + q` with `p ∈ span u` and `q ⊥ span u`; the AlternatingMap
`ιMulti` is *linear in the last slot* (here `iMulti_snoc_add`, from
`AlternatingMap.map_update_add` and the `Fin.snoc`/`Function.update` identification), it
*vanishes* when the last slot lies in the span of the others
(`iMulti_snoc_eq_zero_of_mem_span`, from `AlternatingMap.map_linearDependent`), and for the
*orthogonal* family `(u, q)` the norm is multiplicative
(Commons `exteriorPower_norm_concat_orthogonal`, L53; the single-vector case has norm `‖q‖`
by Commons `norm_iMulti_cons_orthonormal`).

All declarations are Mathlib + Commons (L53, cons-norm) + `Submission.Work.Polygon.GraysonData`.
-/

open exteriorPower
noncomputable section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open scoped BigOperators

namespace Submission.WedgeProjection

open Submission.GraysonData

/-- `Fin.snoc` in terms of `Function.update` at the last index. -/
lemma snoc_eq_update {X : Type*} {r : ℕ} (u : Fin r → X) (x : X) (y : X) :
    Fin.snoc (α := fun _ : Fin (r + 1) => X) u y =
      Function.update (Fin.snoc (α := fun _ : Fin (r + 1) => X) u x) (Fin.last r) y := by
  funext i
  rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
  · rw [Function.update_of_ne, Fin.snoc_castSucc, Fin.snoc_castSucc]
    intro h
    have hv := congrArg Fin.val h
    simp at hv
    omega
  · rw [Fin.snoc_last, Function.update_self]

/-- `ιMulti` is linear in the last slot of `Fin.snoc`. -/
lemma iMulti_snoc_add {d r : ℕ} (u : Fin r → E d) (x y : E d) :
    exteriorPower.ιMulti ℝ (r + 1) (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u (x + y)) =
      exteriorPower.ιMulti ℝ (r + 1) (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u x) +
        exteriorPower.ιMulti ℝ (r + 1) (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u y) := by
  have h := AlternatingMap.map_update_add (exteriorPower.ιMulti ℝ (r + 1))
    (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u (0 : E d)) (Fin.last r) x y
  simpa only [← snoc_eq_update] using h

/-- `ιMulti` vanishes when the last slot of `Fin.snoc` lies in the span of the others. -/
lemma iMulti_snoc_eq_zero_of_mem_span {d r : ℕ} (u : Fin r → E d) {p : E d}
    (hp : p ∈ Submodule.span ℝ (Set.range u)) :
    exteriorPower.ιMulti ℝ (r + 1)
      (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u p) = 0 := by
  refine AlternatingMap.map_linearDependent (exteriorPower.ιMulti ℝ (r + 1))
    (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u p) ?_
  intro hli
  exact (linearIndependent_finSnoc.mp hli).2 hp

/-- **The wedge/projection identity**: for a family `u` and a vector `w`,

`‖ιMulti (Fin.snoc u w)‖ = ‖ιMulti u‖ · ‖w − π w‖`, `π` the orthogonal projection onto
`span ℝ (range u)`. -/
theorem norm_iMulti_snoc_eq_mul_dist {d r : ℕ} (u : Fin r → E d) (w : E d) :
    ‖exteriorPower.ιMulti ℝ (r + 1)
        (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w)‖ =
      ‖exteriorPower.ιMulti ℝ r u‖ *
        ‖w - (Submodule.span ℝ (Set.range u)).starProjection w‖ := by
  classical
  set V : Submodule ℝ (E d) := Submodule.span ℝ (Set.range u) with hV
  set p : E d := V.starProjection w with hp
  set q : E d := w - p with hq
  have hpV : p ∈ V := Submodule.starProjection_apply_mem V w
  have hqorth : q ∈ Vᗮ := by
    rw [hq]
    exact Submodule.sub_starProjection_mem_orthogonal w
  have hinner : ∀ i : Fin r, inner ℝ (u i) q = 0 := fun i => by
    have h := (Submodule.mem_orthogonal' V q).mp hqorth (u i) (Submodule.subset_span ⟨i, rfl⟩)
    rwa [real_inner_comm] at h
  have hw : w = p + q := by rw [hq]; abel
  rw [hw, iMulti_snoc_add, iMulti_snoc_eq_zero_of_mem_span u hpV, zero_add]
  have hj0 : ∀ j : Fin 1,
      (Fin.cons (α := fun _ : Fin (0 + 1) => E d) q (Fin.elim0 : Fin 0 → E d)) j = q := by
    intro j
    fin_cases j
    simp
  have ha0 : Orthonormal ℝ (Fin.elim0 : Fin 0 → E d) :=
    ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  have hnorm1 : ‖exteriorPower.ιMulti ℝ (0 + 1)
      (Fin.cons (α := fun _ : Fin (0 + 1) => E d) q (Fin.elim0 : Fin 0 → E d))‖ = ‖q‖ :=
    Commons.Analysis.InnerProductSpace.norm_iMulti_cons_orthonormal (E := E d) (n := 0) q
      (Fin.elim0 : Fin 0 → E d) ha0 (fun i => Fin.elim0 i)
  rw [Fin.snoc_eq_append,
    Commons.Analysis.InnerProductSpace.exteriorPower_norm_concat_orthogonal u
      (Fin.cons (α := fun _ : Fin (0 + 1) => E d) q (Fin.elim0 : Fin 0 → E d))
      (fun i j => by rw [hj0 j, hinner i]),
    hnorm1]

/-- **Distance form of the wedge/projection identity**: the appended factor is the
*distance* from `w` to the span of the family. -/
theorem norm_iMulti_snoc_eq_mul_iInf {d r : ℕ} (u : Fin r → E d) (w : E d) :
    ‖exteriorPower.ιMulti ℝ (r + 1)
        (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w)‖ =
      ‖exteriorPower.ιMulti ℝ r u‖ *
        (⨅ x : Submodule.span ℝ (Set.range u), ‖w - (x : E d)‖) := by
  rw [norm_iMulti_snoc_eq_mul_dist,
    Submodule.starProjection_minimal (U := Submodule.span ℝ (Set.range u)) w]

/-- **Hadamard/projection form**: the norm of an exterior product is at most the product of
the norm of the family's exterior product with the norm of the appended vector. -/
theorem norm_iMulti_snoc_le_mul_norm {d r : ℕ} (u : Fin r → E d) (w : E d) :
    ‖exteriorPower.ιMulti ℝ (r + 1)
        (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w)‖ ≤
      ‖exteriorPower.ιMulti ℝ r u‖ * ‖w‖ := by
  rw [norm_iMulti_snoc_eq_mul_dist]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  have hle : ‖w - (Submodule.span ℝ (Set.range u)).starProjection w‖ ≤ ‖w‖ := by
    have hpy := Submodule.norm_sq_eq_add_norm_sq_starProjection w
      (Submodule.span ℝ (Set.range u))
    rw [Submodule.starProjection_orthogonal] at hpy
    have hsub : ((ContinuousLinearMap.id ℝ (E d) -
        (Submodule.span ℝ (Set.range u)).starProjection) w)
        = w - (Submodule.span ℝ (Set.range u)).starProjection w := rfl
    rw [hsub] at hpy
    have h1 : ‖w - (Submodule.span ℝ (Set.range u)).starProjection w‖ ^ 2 ≤ ‖w‖ ^ 2 := by
      nlinarith [sq_nonneg ‖(Submodule.span ℝ (Set.range u)).starProjection w‖]
    exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h1
  exact hle

/-- **Covolume form of the projection identity** (Hadamard bound): appending one further
`ℝ`-independent lattice-like vector to a family multiplies the covolume of the spanned
lattice by at most the norm of that vector. -/
theorem latticeCovol_snoc_le_mul_norm {d r : ℕ} (hr : 0 < r) (u : Fin r → E d) (w : E d)
    (hu : LinearIndependent ℝ u)
    (huw : LinearIndependent ℝ (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w)) :
    latticeCovol (Submodule.span ℤ (Set.range
        (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w))) ≤
      latticeCovol (Submodule.span ℤ (Set.range u)) * ‖w‖ := by
  rw [latticeCovol_span (d := d) (r := r + 1) (by omega) _ huw,
    latticeCovol_span (d := d) (r := r) hr u hu]
  exact norm_iMulti_snoc_le_mul_norm u w

/-- **Covolume form of the projection identity** (exact distance factor): the covolume of
the lattice spanned by a family and one further vector is at most the product of the
family's covolume with the *distance* of that vector to the family's span. -/
theorem latticeCovol_snoc_le_mul_dist {d r : ℕ} (hr : 0 < r) (u : Fin r → E d) (w : E d)
    (hu : LinearIndependent ℝ u)
    (huw : LinearIndependent ℝ (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w)) :
    latticeCovol (Submodule.span ℤ (Set.range
        (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w))) ≤
      latticeCovol (Submodule.span ℤ (Set.range u)) *
        ‖w - (Submodule.span ℝ (Set.range u)).starProjection w‖ := by
  rw [latticeCovol_span (d := d) (r := r + 1) (by omega) _ huw,
    latticeCovol_span (d := d) (r := r) hr u hu]
  exact le_of_eq (norm_iMulti_snoc_eq_mul_dist u w)

/-- **Covolume form of the projection identity, log form**: for a nested pair
`span ℤ (range u) ⊆ span ℤ (range (snoc u w))`,
`log covol(snoc-span) ≤ log covol(u-span) + log ‖w‖`. -/
theorem log_latticeCovol_snoc_le {d r : ℕ} (hr : 0 < r) (u : Fin r → E d) (w : E d)
    (hu : LinearIndependent ℝ u)
    (huw : LinearIndependent ℝ (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w))
    (hw : 0 < ‖w‖) :
    Real.log (latticeCovol (Submodule.span ℤ (Set.range
        (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w)))) ≤
      Real.log (latticeCovol (Submodule.span ℤ (Set.range u))) + Real.log ‖w‖ := by
  classical
  have hcovU : 0 < latticeCovol (Submodule.span ℤ (Set.range u)) := by
    rw [latticeCovol_span (d := d) (r := r) hr u hu]
    exact norm_pos_iff.mpr (Commons.LinearAlgebra.ExteriorPower.iMulti_ne_zero_of_linearIndependent
      (K := ℝ) (k := r) u hu)
  have hcovS : 0 < latticeCovol (Submodule.span ℤ (Set.range
      (Fin.snoc (α := fun _ : Fin (r + 1) => E d) u w))) := by
    rw [latticeCovol_span (d := d) (r := r + 1) (by omega) _ huw]
    exact norm_pos_iff.mpr (Commons.LinearAlgebra.ExteriorPower.iMulti_ne_zero_of_linearIndependent
      (K := ℝ) (k := r + 1) _ huw)
  have h := latticeCovol_snoc_le_mul_norm (d := d) hr u w hu huw
  have hlog := Real.log_le_log hcovS h
  rwa [Real.log_mul hcovU.ne' hw.ne'] at hlog

end Submission.WedgeProjection
