import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.RingTheory.RegularLocalRing.Defs

set_option linter.style.haveILetI false

namespace Commons.LinearAlgebra.FreeModule

open scoped Pointwise

/-- For any `ℤ`-module structure on an additive group, the `ℤ`-span of a set `s` has the
same underlying additive subgroup as the additive subgroup generated by `s`. -/
lemma span_int_toAddSubgroup_eq_closure {M : Type*} [AddCommGroup M] [Module ℤ M]
    (s : Set M) : (Submodule.span ℤ s).toAddSubgroup = AddSubgroup.closure s := by
  let C : Submodule ℤ M :=
    { carrier := (AddSubgroup.closure s : Set M)
      zero_mem' := AddSubgroup.zero_mem _
      add_mem' := by
        intro x y hx hy
        exact AddSubgroup.add_mem _ hx hy
      smul_mem' := by
        intro a x hx
        convert! AddSubgroup.zsmul_mem (AddSubgroup.closure s) hx a using 1
        exact int_smul_eq_zsmul (inferInstance : Module ℤ M) a x }
  have hspan_le_C : Submodule.span ℤ s ≤ C := by
    rw [Submodule.span_le]
    exact fun x hx => AddSubgroup.subset_closure hx
  apply le_antisymm
  · intro x hx
    exact hspan_le_C (by simpa using hx)
  · rw [AddSubgroup.closure_le]
    intro x hx
    simpa using (Submodule.subset_span (R := ℤ) (s := s) hx : x ∈ Submodule.span ℤ s)

/-- A finitely generated `ℤ`-submodule of `M` is finitely generated as an additive group. -/
lemma addGroup_fg_of_submodule_fg {M : Type*} [AddCommGroup M] [Module ℤ M]
    {N : Submodule ℤ M} (hN : N.FG) : AddGroup.FG ↥N := by
  rcases hN with ⟨S, hS⟩
  have hclosure : AddSubgroup.closure (S : Set M) = N.toAddSubgroup := by
    calc
      AddSubgroup.closure (S : Set M) = (Submodule.span ℤ (S : Set M)).toAddSubgroup :=
        (span_int_toAddSubgroup_eq_closure (S : Set M)).symm
      _ = N.toAddSubgroup := by rw [hS]
  have hAS : N.toAddSubgroup.FG := ⟨S, hclosure⟩
  exact (AddGroup.fg_iff_addSubgroup_fg N.toAddSubgroup).mpr hAS

/-- A submodule of a torsion-free additive group is torsion-free as an additive group. -/
lemma addTorsionFree_submodule {M : Type*} [AddCommGroup M] [Module ℤ M]
    [Module.IsTorsionFree ℤ M] (N : Submodule ℤ M) : IsAddTorsionFree ↥N := by
  have hAddTF_M : IsAddTorsionFree M := IsAddTorsionFree.of_isTorsionFree ℤ M
  constructor
  intro n hn a b hab
  apply Subtype.ext
  exact hAddTF_M.nsmul_right_injective hn (by simpa using congrArg Subtype.val hab)

/--
Every `ℤ`-submodule of a free finite-rank torsion-free `ℤ`-module is itself free and
finite-rank over `ℤ`.

Route hints: (1) `Module.Finite ℤ ↥N`: `ℤ` is Noetherian, so a submodule of a finitely
generated module is finitely generated (find/prove `Module.Finite` for `↥N` from
`Module.Finite ℤ M`, e.g. via `Submodule` finite-generation over `ℤ` /
`IsNoetherianRing ℤ`); (2) `Module.IsTorsionFree ℤ ↥N` is inherited from `M` (a
submodule of a torsion-free module is torsion-free); (3) conclude `Module.Free ℤ ↥N`
via `Module.free_of_finite_type_torsion_free` (ℤ is a principal ideal domain and a
domain) applied to a finite spanning family of `↥N` obtained from `Module.Finite`.
-/
theorem submodule_free_finite_of_torsionFree {M : Type*} [AddCommGroup M] [Module ℤ M]
    [Module.Free ℤ M] [Module.Finite ℤ M] [Module.IsTorsionFree ℤ M] (N : Submodule ℤ M) :
    Module.Free ℤ ↥N ∧ Module.Finite ℤ ↥N := by
  -- (1) `Module.Finite ℤ ↥N`: ℤ is Noetherian, so the submodule `N ≤ ⊤` is finitely
  -- generated, and finite generation as a `ℤ`-module is equivalent to finite generation
  -- of the underlying additive group.
  have hNfg : N.FG := Submodule.FG.of_le (Module.Finite.fg_top) (le_top : N ≤ (⊤ : Submodule ℤ M))
  have hFin : Module.Finite ℤ ↥N :=
    Module.Finite.iff_addGroup_fg.mpr (addGroup_fg_of_submodule_fg hNfg)
  -- (2) `Module.IsTorsionFree ℤ ↥N`: inherited from `M` through additive torsion-freeness.
  have hTF : Module.IsTorsionFree ℤ ↥N := by
    haveI : IsAddTorsionFree ↥N := addTorsionFree_submodule N
    infer_instance
  -- (3) a finitely generated torsion-free module over the PID `ℤ` is free.
  have hFree : Module.Free ℤ ↥N := by
    letI : Module.Finite ℤ ↥N := hFin
    haveI : Module.IsTorsionFree ℤ ↥N := hTF
    infer_instance
  exact ⟨hFree, hFin⟩

end Commons.LinearAlgebra.FreeModule