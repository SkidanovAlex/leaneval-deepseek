/-- The certified integer table of the `k`-th representative. -/
def TZ (k : Fin 230) : List (List ℤ × List ℤ) := TZlist.getD k.val []

/-- BFS parent certificate: entry `i` is `zMul d (TZ[parent]) (gensZ[gen])`. -/
def certK (k : Fin 230) : List (ℕ × ℕ) := certList.getD k.val []

/-- All matrices in the table have shape `3 × 3` (9 entries). -/
def lenCheck (k : Fin 230) : Bool :=
  (TZ k).all fun t => decide (t.1.length = 9 ∧ t.2.length = 3)

/-- The identity occurs. -/
def oneCheck (k : Fin 230) : Bool := decide (zOne ∈ TZ k)

/-- The table is closed under right multiplication by generators. -/
def cloCheck (k : Fin 230) : Bool :=
  (TZ k).all fun t => (gensZ k).all fun g => decide (zMul (sgDen k) t g ∈ TZ k)

/-- No two entries have the same matrix. -/
def nodupCheck (k : Fin 230) : Bool := decide (((TZ k).map (·.1)).Nodup)

/-- All numerators are reduced modulo the denominator. -/
def redCheck (k : Fin 230) : Bool :=
  (TZ k).all fun t => t.2.all fun x => decide (0 ≤ x ∧ x < (sgDen k : ℤ))

/-- All matrices are unimodular. -/
def detCheck (k : Fin 230) : Bool :=
  (TZ k).all fun t => decide (det9 t.1 = 1 ∨ det9 t.1 = -1)

/-- The class index stored in `sgDataList` is a genuine index (`< 73`). -/
def idxCheck (k : Fin 230) : Bool :=
  decide ((sgDataList.getD k.val (0, 1, [], 0)).1 < 73)

/-- Every entry is reachable from the identity by repeatedly multiplying a previous entry by a
generator. -/
def chainCheck (k : Fin 230) : Bool :=
  (List.range (TZ k).length).all fun i =>
    if i = 0 then decide ((TZ k).getD i zOne = zOne)
    else
      let p := (certK k).getD i (0, 0)
      decide (p.1 < i ∧ p.2 < (gensZ k).length ∧
        zMul (sgDen k) ((TZ k).getD p.1 zOne) ((gensZ k).getD p.2 zOne) = (TZ k).getD i zOne)

/-- The table has at most `48` entries. -/
def sizeCheck (k : Fin 230) : Bool := decide ((TZ k).length ≤ 48)

/-- All checks for one representative. -/
def checkData (k : Fin 230) : Bool :=
  lenCheck k && oneCheck k && cloCheck k && nodupCheck k && redCheck k && detCheck k &&
    idxCheck k && chainCheck k && sizeCheck k

