/-
Second auxiliary module for `Work.SGsep.pair_separates`: table facts about the indexed access
functions `PSep.pn/elM/elI/zV`, the `vOf` ↔ `vA` bridge, and the soundness of `Data.TfCert`.
-/
import Mathlib
import Submission.Work.SG.SGsepDefs
import Submission.Work.SGsep.PairAux
import Submission.Work.SGsep.table_facts
import Submission.Work.SGsep.elem_separates
import Submission.Work.SGsep.repArith_ord_ne

namespace Work.SGsep
open Work.SG
open Work.SGsep.PSep
open Classical

namespace PSep

/-! ## Table facts -/

theorem pn_pos (k : Fin 230) : 0 < pn k := ElemTbl.repArith_n_pos_at k

theorem elM_ord_ne_zero (k : Fin 230) {i : ℕ} (hi : i < pn k) : (elM k i).ord ≠ 0 :=
  repArith_ord_ne k i hi

theorem elM_mem (k : Fin 230) {i : ℕ} (hi : i < pn k) : elM k i ∈ (Data.repArith k).elems := by
  obtain ⟨_, hlen⟩ := repArith_elems k
  rw [elM_def, List.getD_eq_getElem _ _ (by rw [hlen]; exact hi)]
  exact List.getElem_mem _

/-- `Tk k` is the image of `i ↦ elI k i` on `range (pn k)`. -/
theorem Tk_eq_range (k : Fin 230) : Tk k = ((List.range (pn k)).map (elI k)).toFinset := by
  obtain ⟨_, hlen⟩ := repArith_elems k
  have h : (Data.repArith k.val).elems.map Data.M3.toIMat
      = (List.range (pn k)).map (elI k) := by
    rw [map_eq_map_getD (Data.repArith k.val).elems Data.M3.toIMat Data.M3.one, hlen]
    apply List.map_congr_left
    intro i _
    rfl
  rw [Tk, h]

theorem mem_Tk_iff_exists (k : Fin 230) (A : IMat) :
    A ∈ Tk k ↔ ∃ i, i < pn k ∧ elI k i = A := by
  rw [Tk_eq_range, List.mem_toFinset, List.mem_map]
  constructor
  · rintro ⟨i, hi, rfl⟩; exact ⟨i, List.mem_range.mp hi, rfl⟩
  · rintro ⟨i, hi, rfl⟩; exact ⟨i, List.mem_range.mpr hi, rfl⟩

theorem elI_injOn (k : Fin 230) : Set.InjOn (elI k) (Set.Iio (pn k)) := by
  intro i hi j hj hij
  obtain ⟨hnodup, hlen⟩ := repArith_elems k
  have hile : i < (Data.repArith k).elems.length := by rw [hlen]; exact hi
  have hjle : j < (Data.repArith k).elems.length := by rw [hlen]; exact hj
  have h1 : elM k i = elM k j := Data.M3.toIMat_injective hij
  simp only [elM_def] at h1
  rw [List.getD_eq_getElem _ _ hile, List.getD_eq_getElem _ _ hjle] at h1
  exact hnodup.getElem_inj_iff.mp h1

/-! ## Lattices generated by columns -/

/-- A list combination of generators lying in a subgroup also lies in it. -/
theorem lin_mem_sub {L : AddSubgroup (Fin 3 → ℝ)} (gs : List Data.V3) (cs : List ℤ)
    (h : ∀ g ∈ gs, toRV g ∈ L) : toRV (Data.lin gs cs) ∈ L := by
  induction gs generalizing cs with
  | nil => simpa only [Data.lin, toRV_zero] using L.zero_mem
  | cons g gs ih =>
    cases cs with
    | nil => simpa only [Data.lin, toRV_zero] using L.zero_mem
    | cons c cs =>
      show toRV (Data.V3.add (Data.V3.smul c g) (Data.lin gs cs)) ∈ L
      rw [toRV_add, toRV_smul]
      exact add_mem (L.zsmul_mem (h g (by simp)) c)
        (ih cs (fun g' hg' => h g' (by simp [hg'])))

/-- If all columns of `MX` lie in a subgroup `L`, then `MX ℤ³ ⊆ L`. -/
theorem latImg_le_of_cols {L : AddSubgroup (Fin 3 → ℝ)} (MX : Data.M3)
    (h : ∀ g ∈ MX.cols, toRV g ∈ L) : latImg MX.toIMat ≤ L := by
  intro v hv
  obtain ⟨w, hw⟩ := mem_latImg.mp hv
  have hwl : (Data.lin MX.cols [w 0, w 1, w 2]).toFun = MX.toIMat.mulVec w := by
    rw [← Data.M3.mulVec_getD MX [w 0, w 1, w 2]]
    congr 1
    funext i; fin_cases i <;> simp
  have hveq : v = toRV (Data.lin MX.cols [w 0, w 1, w 2]) := by
    rw [toRV_def, hwl, ← mulVec_toRVec]
    exact hw.symm
  rw [hveq]
  exact lin_mem_sub MX.cols [w 0, w 1, w 2] h

/-- The `j`-th column of a flat matrix lies in its lattice. -/
theorem col_mem_latImg (M : Data.M3) {j : ℕ} (hj : j < 3) :
    toRV (M.cols.getD j Data.V3.zero) ∈ latImg M.toIMat := by
  interval_cases j
  · refine (mem_latImg_iff_cols M _).mpr ⟨[1, 0, 0], ?_⟩
    apply Data.V3.toFun_injective
    funext i; fin_cases i <;>
      simp [Data.lin, Data.M3.cols, Data.V3.smul, Data.V3.add, Data.V3.zero, Data.V3.toFun]
  · refine (mem_latImg_iff_cols M _).mpr ⟨[0, 1, 0], ?_⟩
    apply Data.V3.toFun_injective
    funext i; fin_cases i <;>
      simp [Data.lin, Data.M3.cols, Data.V3.smul, Data.V3.add, Data.V3.zero, Data.V3.toFun]
  · refine (mem_latImg_iff_cols M _).mpr ⟨[0, 0, 1], ?_⟩
    apply Data.V3.toFun_injective
    funext i; fin_cases i <;>
      simp [Data.lin, Data.M3.cols, Data.V3.smul, Data.V3.add, Data.V3.zero, Data.V3.toFun]

/-- Soundness of `Data.TfCert`: the certificate bit is `true` exactly when the lattice `MX ℤ³`
is contained in `MY ℤ³`. -/
theorem tfCert_bit (MX MY : Data.M3) (c : Data.TfCert)
    (h : Data.TfCert.chk MX.cols MY.cols c = true) :
    (c.bit = true ↔ latImg MX.toIMat ≤ latImg MY.toIMat) := by
  cases c with
  | yes cs =>
    obtain ⟨hlenb, hall⟩ := Bool.and_eq_true_iff.mp h
    have hlen : cs.length = MX.cols.length := beq_iff_eq.mp hlenb
    refine ⟨fun _ => latImg_le_of_cols MX ?_, fun _ => rfl⟩
    intro g hg
    obtain ⟨j, hj, hjeq⟩ := List.getElem_of_mem hg
    rw [← hjeq]
    have hjc : j < cs.length := by rw [hlen]; exact hj
    have hz := ElemTbl.all_zipWith_getElem (l₁ := MX.cols) (l₂ := cs)
      (f := fun x c => Data.SpanCert.chk MY.cols x (.yes c)) hall hj hjc
    exact (spanCert_bit MY (MX.cols[j]) (.yes (cs[j])) hz).mp rfl
  | no col φ m =>
    obtain ⟨hcolb, hchk⟩ := Bool.and_eq_true_iff.mp h
    have hcol : col < MX.cols.length := of_decide_eq_true hcolb
    have hnotmem : toRV (MX.cols.getD col Data.V3.zero) ∉ latImg MY.toIMat := by
      intro hmem
      obtain ⟨cs, hcs⟩ := (mem_latImg_iff_cols MY _).mp hmem
      exact Data.SpanCert.chk_no hchk ⟨cs, hcs⟩
    refine ⟨fun hf => False.elim (Bool.false_ne_true hf), fun hle => ?_⟩
    have hcol3 : col < 3 := by simpa [Data.M3.cols] using hcol
    exact False.elim (hnotmem (hle (col_mem_latImg MX hcol3)))

/-! ## The `vOf` ↔ `vA` bridge -/

/-- The divisibility inside the element certificate: `n ∣ N_A z`. -/
theorem vOfK_dvd (k : Fin 230) {i : ℕ} (hi : i < pn k) :
    Data.V3.dvd (pn k) (Data.M3.mulV (Data.normOf (elM k i)) (zV k i)) = true := by
  have hchk := elemTab_chk_at k i hi
  simp only [Data.ElemCert.chk] at hchk
  obtain ⟨hX, _⟩ := Bool.and_eq_true_iff.mp hchk
  obtain ⟨hY, _⟩ := Bool.and_eq_true_iff.mp hX
  obtain ⟨hZ, _⟩ := Bool.and_eq_true_iff.mp hY
  obtain ⟨_, hdvd⟩ := Bool.and_eq_true_iff.mp hZ
  exact hdvd

/-- The real intrinsic translation is the tabulated one. -/
theorem vOfK_eq_vA (k : Fin 230) (i : ℕ) (hk : TauOnTable k) (hi : i < pn k) :
    vA (sgTau k) (elI k i) = toRV (vOfK k i) := by
  have hdvd := vOfK_dvd k hi
  have hordOK : ElemTbl.OrdOK (elM k i) := ElemTbl.repArith_ordOK_at k i hi
  have hn0 : pn k ≠ 0 := ne_of_gt (pn_pos k)
  have hNZ : NZ (elI k i) = (Data.normOf (elM k i)).toIMat :=
    (ElemTbl.normOf_toIMat hordOK).symm
  have hτ : sgTau k (elI k i) = fun c => (zV k i).toFun c / (pn k : ℝ) := hk i hi
  rw [vA, hNZ, hτ]
  have hfun : (fun c : Fin 3 => (zV k i).toFun c / (pn k : ℝ))
      = (pn k : ℝ)⁻¹ • toRV (zV k i) := by
    funext c
    simp only [Pi.smul_apply, toRV, toRVec, Data.V3.toFun, div_eq_mul_inv]
    ring
  rw [hfun, Matrix.mulVec_smul, ← mulV_toRV]
  rw [vOfK_def]
  exact ElemTbl.toRV_ediv _ hn0 hdvd

