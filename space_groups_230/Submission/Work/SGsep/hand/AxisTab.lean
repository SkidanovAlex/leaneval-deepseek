/-- The check of the whole axis table: an entry is present exactly at the rotations, and every
present entry satisfies `AxisW.chkCore`. -/
theorem axisTab_spec :
    (List.range 230).all (fun k => (List.range (repArith k).n).all (fun i =>
      match (axisTab.getD k []).getD i none with
      | none => !((M3.det (A3n k i) == 1) && decide (3 ≤ M3.ord (A3n k i)))
      | some w => (M3.det (A3n k i) == 1) && decide (3 ≤ M3.ord (A3n k i)) &&
          w.chkCore (A3n k i))) = true := by
  decide +kernel

/-- Divisibility of the tabulated intrinsic translations: `n ∣ N_A z`. -/
theorem divTab :
    (List.range 230).all (fun k => (List.range (repArith k).n).all (fun i =>
      V3.dvd ((repArith k).n : Int)
        (M3.mulV (M3.normSum (A3n k i) (M3.ord (A3n k i)))
          ((repZ.getD k []).getD i V3.zero)))) = true := by
  decide +kernel

