import Mathlib

namespace Work.MainP

/-- The list `Y (n+1)` generated by `Y (i+1) = f (i-1) :: Y i` and `Y 0 = []` is
`[f (n-1), f (n-2), …, f 0, f 0]` (for `n ≥ 0`), so reversing it gives
`f 0 :: (List.range n).map f`. -/
theorem epiLabelList_rev {α : Type} (f : ℕ → α) (Y : ℕ → List α) (hY0 : Y 0 = [])
    (hY : ∀ i, Y (i+1) = f (i-1) :: Y i) :
    ∀ n, (Y (n+1)).reverse = f 0 :: (List.range n).map f := by
  intro n
  induction n with
  | zero =>
    have h1 : Y 1 = [f 0] := by
      have := hY 0
      rw [hY0] at this
      simpa using this
    rw [h1]
    rfl
  | succ n ih =>
    have h : Y (n+2) = f n :: Y (n+1) := by
      have := hY (n+1)
      simpa using this
    rw [h, List.reverse_cons, ih]
    simp [List.range_succ, List.map_append]

theorem epiLabelList {α : Type} (f : ℕ → α) (Y : ℕ → List α) (hY0 : Y 0 = [])
    (hY : ∀ i, Y (i+1) = f (i-1) :: Y i) :
    ∀ S : ℕ, 1 ≤ S → ((f (S-1) :: Y S).reverse).drop 1 = (List.range S).map f := by
  intro S hS
  cases S with
  | zero => omega
  | succ n =>
    have hmain : (f n :: Y (n+1)).reverse = f 0 :: (List.range (n+1)).map f := by
      rw [List.reverse_cons, epiLabelList_rev f Y hY0 hY n]
      simp [List.range_succ, List.map_append]
    have hidx : n + 1 - 1 = n := Nat.add_sub_cancel n 1
    rw [hidx, hmain]
    simp

end Work.MainP
