import Submission.Work.KvnDual
import Submission.Work.FinSigmaLevel

set_option linter.unusedSectionVars false

/-!
# The join of level-set σ-algebras (Green–Tao `B_{ε,η}(𝒟F_1) ∨ … ∨ B_{ε,η}(𝒟F_K)`)

The σ-algebra generated by the level sets of the anti-uniform functions `davg d (F j)` at
resolution `ε` (with shifts `α j`), presented by its atoms.  This is the σ-algebra `B_K` of
Green–Tao §7.
-/

open Finset
open scoped BigOperators

namespace GTTrans

open Commons.Combinatorics.Transference
open FinSigma

/-- The atom of the join of the level-set σ-algebras of the functions `davg d (F j)`
(`j : Fin K`) at resolution `ε` and shifts `α j` containing `x`. -/
noncomputable def levelJoin {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ}
    (F : Fin K → ZMod p → ℝ) (ε : ℝ) (α : Fin K → ℝ) (x : ZMod p) : Finset (ZMod p) :=
  Finset.univ.filter (fun y => ∀ j : Fin K,
    ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)

lemma mem_levelJoin {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ} (F : Fin K → ZMod p → ℝ) (ε : ℝ)
    (α : Fin K → ℝ) (x : ZMod p) : x ∈ levelJoin d F ε α x := by
  rw [levelJoin, Finset.mem_filter]
  exact ⟨Finset.mem_univ x, fun _ => rfl⟩

lemma mem_levelJoin_iff {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ} (F : Fin K → ZMod p → ℝ)
    (ε : ℝ) (α : Fin K → ℝ) (x y : ZMod p) :
    y ∈ levelJoin d F ε α x ↔ ∀ j : Fin K,
      ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋ := by
  rw [levelJoin, Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ y, h⟩⟩

lemma levelJoin_eq_of_mem {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ} (F : Fin K → ZMod p → ℝ)
    (ε : ℝ) (α : Fin K → ℝ) {x y : ZMod p} (hy : y ∈ levelJoin d F ε α x) :
    levelJoin d F ε α y = levelJoin d F ε α x := by
  rw [mem_levelJoin_iff] at hy
  ext z
  rw [mem_levelJoin_iff, mem_levelJoin_iff]
  exact ⟨fun hz j => (hz j).trans (hy j), fun hz j => (hz j).trans (hy j).symm⟩

/-- On an atom of the join, each generator is within `ε` of its value at the base point. -/
lemma abs_sub_lt_of_mem_levelJoin {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ}
    (F : Fin K → ZMod p → ℝ) {ε : ℝ} (hε : 0 < ε) (α : Fin K → ℝ) {x y : ZMod p}
    (hy : y ∈ levelJoin d F ε α x) (j : Fin K) :
    |davg d (F j) y - davg d (F j) x| < ε := by
  have h := (mem_levelJoin_iff d F ε α x y).mp hy j
  have h1 : |(davg d (F j) y - α j) / ε - (davg d (F j) x - α j) / ε| < 1 :=
    abs_sub_lt_one_of_floor_eq h
  have h2 : (davg d (F j) y - α j) / ε - (davg d (F j) x - α j) / ε
      = (davg d (F j) y - davg d (F j) x) / ε := by ring
  rw [h2, abs_div, abs_of_pos hε, div_lt_one hε] at h1
  exact h1

/-- On an atom of the join, each generator is within `ε` of its conditional expectation. -/
lemma abs_cE_levelJoin_sub_le {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ}
    (F : Fin K → ZMod p → ℝ) {ε : ℝ} (hε : 0 < ε) (α : Fin K → ℝ) (j : Fin K) (x : ZMod p) :
    |cE (levelJoin d F ε α) (davg d (F j)) x - davg d (F j) x| ≤ ε := by
  refine cE_abs_sub_le_of_bound (fun z => mem_levelJoin d F ε α z) (davg d (F j)) x ε ?_
  intro y hy
  exact le_of_lt (abs_sub_lt_of_mem_levelJoin d F hε α hy j)

/-- The join refines each individual level-set σ-algebra. -/
lemma levelJoin_subset_levelPart {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ}
    (F : Fin K → ZMod p → ℝ) (ε : ℝ) (α : Fin K → ℝ) (j : Fin K) (x : ZMod p) :
    levelJoin d F ε α x ⊆ Finset.univ.filter
      (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋) := by
  intro y hy
  rw [mem_levelJoin_iff] at hy
  rw [Finset.mem_filter]
  exact ⟨Finset.mem_univ y, hy j⟩

/-- The join is a refinement of the trivial σ-algebra, i.e. it is a genuine partition. -/
lemma levelJoin_subset_univ {p : ℕ} [Fact p.Prime] (d : ℕ) {K : ℕ} (F : Fin K → ZMod p → ℝ)
    (ε : ℝ) (α : Fin K → ℝ) (x : ZMod p) : levelJoin d F ε α x ⊆ Finset.univ :=
  fun _ _ => Finset.mem_univ _

end GTTrans
