import Submission.Work.FinSigma

set_option linter.unusedSectionVars false

/-!
# The σ-algebra generated by a bounded function (Green–Tao, Prop. 6.4)

For a function `G : X → ℝ` and parameters `0 < ε`, `α : ℝ`, the atoms of
`levelPart G ε α` are the level sets `{y : ⌊(G y - α)/ε⌋ = n}`.  Hence

* the number of atoms is `O(1/ε + |α|/ε + 1)` when `G` is bounded,
* on each atom `G` varies by at most `ε`,

which are the "bounded complexity" and "`G` lies in its own σ-algebra"
properties of GT Prop. 6.4.
-/

open Finset

namespace FinSigma

variable {X : Type*} [Fintype X] [DecidableEq X]

/-- `|a - b| < 1` when `a` and `b` have the same floor. -/
lemma abs_sub_lt_one_of_floor_eq {a b : ℝ} (h : ⌊a⌋ = ⌊b⌋) : |a - b| < 1 := by
  have h1 : a - b < 1 := by
    have hb : ((⌊a⌋ : ℤ) : ℝ) ≤ b := by rw [h]; exact Int.floor_le b
    have ha : a < ((⌊a⌋ : ℤ) : ℝ) + 1 := Int.lt_floor_add_one a
    linarith
  have h2 : b - a < 1 := by
    have ha : ((⌊b⌋ : ℤ) : ℝ) ≤ a := by rw [← h]; exact Int.floor_le a
    have hb : b < ((⌊b⌋ : ℤ) : ℝ) + 1 := Int.lt_floor_add_one b
    linarith
  rw [abs_lt]
  exact ⟨by linarith, h1⟩

/-- The level-set partition of `G` at resolution `ε` with shift `α`. -/
noncomputable def levelPart (G : X → ℝ) (ε α : ℝ) (x : X) : Finset X :=
  Finset.univ.filter (fun y => ⌊(G y - α) / ε⌋ = ⌊(G x - α) / ε⌋)

/-- The level index of `x`. -/
noncomputable def levIdx (G : X → ℝ) (ε α : ℝ) (x : X) : ℤ := ⌊(G x - α) / ε⌋

lemma levelPart_eq_filter (G : X → ℝ) (ε α : ℝ) (x : X) :
    levelPart G ε α x = Finset.univ.filter (fun y => levIdx G ε α y = levIdx G ε α x) := rfl

lemma mem_levelPart {G : X → ℝ} {ε α : ℝ} {x y : X} :
    y ∈ levelPart G ε α x ↔ levIdx G ε α y = levIdx G ε α x := by
  simp [levelPart, levIdx]

lemma levelPart_mem (G : X → ℝ) (ε α : ℝ) (x : X) : x ∈ levelPart G ε α x := by
  rw [mem_levelPart]

lemma levelPart_eq_of_mem {G : X → ℝ} {ε α : ℝ} {x y : X}
    (hy : y ∈ levelPart G ε α x) : levelPart G ε α y = levelPart G ε α x := by
  rw [mem_levelPart] at hy
  ext z
  rw [mem_levelPart, mem_levelPart, hy]

/-- On an atom of the level-set partition, `G` varies by less than `ε`. -/
lemma abs_sub_lt_of_mem_levelPart {G : X → ℝ} {ε α : ℝ} (hε : 0 < ε) {x y : X}
    (hy : y ∈ levelPart G ε α x) : |G y - G x| < ε := by
  rw [mem_levelPart, levIdx] at hy
  have h2 : |(G y - α) / ε - (G x - α) / ε| < 1 := abs_sub_lt_one_of_floor_eq hy
  have h3 : ε * |(G y - α) / ε - (G x - α) / ε| = |G y - G x| := by
    rw [show (G y - α) / ε - (G x - α) / ε = (G y - G x) / ε by ring, abs_div,
      abs_of_pos hε]
    field_simp
  rw [← h3]
  calc ε * |(G y - α) / ε - (G x - α) / ε| < ε * 1 :=
        mul_lt_mul_of_pos_left h2 hε
    _ = ε := mul_one ε

/-- The atoms of the level-set partition are contained in the level sets of `levIdx`. -/
lemma atoms_levelPart_subset (G : X → ℝ) (ε α : ℝ) :
    atoms (levelPart G ε α) ⊆
      (Finset.univ.image (levIdx G ε α)).image
        (fun n => Finset.univ.filter (fun y => levIdx G ε α y = n)) := by
  intro A hA
  rw [mem_atoms] at hA
  obtain ⟨x, rfl⟩ := hA
  refine Finset.mem_image.mpr ⟨levIdx G ε α x, ?_, ?_⟩
  · exact Finset.mem_image.mpr ⟨x, Finset.mem_univ x, rfl⟩
  · rw [levelPart_eq_filter]

/-- Number of distinct level indices is bounded by the number of integers in the range. -/
lemma card_atoms_levelPart_le (G : X → ℝ) (ε α : ℝ) (K : ℤ)
    (hK : ∀ x, levIdx G ε α x ∈ Finset.Icc (-K) K) :
    (atoms (levelPart G ε α)).card ≤ (2 * K + 1).toNat := by
  calc (atoms (levelPart G ε α)).card
      ≤ ((Finset.univ.image (levIdx G ε α)).image
          (fun n => Finset.univ.filter (fun y => levIdx G ε α y = n))).card :=
        Finset.card_le_card (atoms_levelPart_subset G ε α)
    _ ≤ (Finset.univ.image (levIdx G ε α)).card := Finset.card_image_le
    _ ≤ (Finset.Icc (-K) K).card := Finset.card_le_card (by
          intro n hn
          rw [Finset.mem_image] at hn
          obtain ⟨x, _, rfl⟩ := hn
          exact hK x)
    _ = (2 * K + 1).toNat := by
        rw [Int.card_Icc]; ring_nf

/-- Number of atoms of a level-set partition of a bounded function. -/
lemma card_atoms_levelPart_le_of_bounded {G : X → ℝ} {ε α M : ℝ} (hε : 0 < ε)
    (hG : ∀ x, |G x| ≤ M) :
    (atoms (levelPart G ε α)).card
      ≤ (2 * (⌈(M + |α|) / ε⌉ + 1) + 1).toNat := by
  have hK : ∀ x, levIdx G ε α x ∈ Finset.Icc (-(⌈(M + |α|) / ε⌉ + 1)) (⌈(M + |α|) / ε⌉ + 1) := by
    intro x
    set K : ℤ := ⌈(M + |α|) / ε⌉ + 1 with hKdef
    have ht : |((⌊(G x - α) / ε⌋ : ℤ) : ℝ)| ≤ (K : ℝ) := by
      have hb1 : ((⌊(G x - α) / ε⌋ : ℤ) : ℝ) ≤ |(G x - α) / ε| + 1 := by
        have h := Int.floor_le ((G x - α) / ε)
        linarith [le_abs_self ((G x - α) / ε)]
      have hb2 : -(((⌊(G x - α) / ε⌋ : ℤ) : ℝ)) ≤ |(G x - α) / ε| + 1 := by
        have h := Int.lt_floor_add_one ((G x - α) / ε)
        linarith [neg_abs_le ((G x - α) / ε)]
      have h3 : |((⌊(G x - α) / ε⌋ : ℤ) : ℝ)| ≤ |(G x - α) / ε| + 1 :=
        abs_le.mpr ⟨by linarith, hb1⟩
      refine le_trans h3 ?_
      have hab : |G x - α| ≤ M + |α| := by
        rw [abs_sub_le_iff]
        constructor <;> linarith [le_abs_self (G x), neg_abs_le (G x), le_abs_self α,
          neg_abs_le α, hG x]
      have h4 : |(G x - α) / ε| ≤ (M + |α|) / ε := by
        rw [abs_div, abs_of_pos hε]
        exact div_le_div_of_nonneg_right hab hε.le
      have h5 : (M + |α|) / ε ≤ ((⌈(M + |α|) / ε⌉ : ℤ) : ℝ) := Int.le_ceil _
      have h6 : ((K : ℤ) : ℝ) = ((⌈(M + |α|) / ε⌉ : ℤ) : ℝ) + 1 := by
        rw [hKdef]; push_cast; ring
      rw [h6]
      linarith
    rw [Finset.mem_Icc]
    rw [abs_le] at ht
    exact ⟨by exact_mod_cast ht.1, by exact_mod_cast ht.2⟩
  exact card_atoms_levelPart_le G ε α _ hK

/-- On an atom of the join `P ∨ levelPart G ε α`, `G` is within `ε` of its
conditional expectation. -/
lemma abs_cE_jpart_levelPart_sub_le {G : X → ℝ} {ε α : ℝ} (hε : 0 < ε)
    (P : X → Finset X) (hPmem : ∀ x, x ∈ P x) (x : X) :
    |cE (jpart P (levelPart G ε α)) G x - G x| ≤ ε := by
  refine cE_abs_sub_le_of_bound (part := jpart P (levelPart G ε α))
    (mem_jpart P (levelPart G ε α) hPmem) G x ε ?_
  intro y hy
  rw [jpart, Finset.mem_filter] at hy
  exact le_of_lt (abs_sub_lt_of_mem_levelPart hε (hy.2 ▸ levelPart_mem G ε α y))

end FinSigma
