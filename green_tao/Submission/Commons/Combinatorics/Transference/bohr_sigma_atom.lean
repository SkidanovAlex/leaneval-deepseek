import Mathlib
import Submission.Commons.Combinatorics.Transference.weier_family
import Submission.Commons.Combinatorics.Transference.sum_atom_le_of_approx_at
import Submission.Commons.Combinatorics.Transference.exists_continuous_psi_levelPart
import Submission.Commons.Combinatorics.Transference.Unorm_nonneg
import Submission.Commons.Combinatorics.Transference.poly_lemma_abstract

namespace Commons.Combinatorics.Transference

open Finset
open scoped BigOperators

/-- **Green–Tao Proposition 6.6, core estimate `(sigma-smooth)`.**

For the generalised Bohr `σ`-algebra generated by the level sets of the dual functions
`𝒟F_j` at resolution `ε` (with boundary layers `T_j`), there is `E ≥ 0` such that the
`(ν−1)`-mass of every atom of the join is bounded by
`|G|·(‖ν−1‖_{U^d}·E + η'·𝔼|ν−1|) + K·∑_j (ν+1)(T_j)`. -/
theorem bohr_sigma_atom {p : ℕ} [Fact p.Prime] {d K : ℕ} (hd : 1 ≤ d)
    (F : Fin K → ZMod p → ℝ) {ν τ : ZMod p → ℝ} (hν : ∀ x, 0 ≤ ν x) (hτ : ∀ x, 0 ≤ τ x)
    (hF : ∀ (j : Fin K) (x : ZMod p), |F j x| ≤ ν x)
    (hcorr : ∀ h : Fin d → ZMod p,
      (Fintype.card (ZMod p) : ℝ)⁻¹ * ∑ y : ZMod p,
          ∏ ω : Fin d → Bool, ν (y + ∑ i, (if ω i then h i else 0))
        ≤ ∑ ω : Fin d → Bool, ∑ ω' ∈ Finset.univ.filter (fun ω' => ω ≠ ω'),
            τ ((∑ i, (if ω' i then h i else 0)) - (∑ i, (if ω i then h i else 0))))
    {Cm : ℕ → ℝ} (hmom : ∀ q : ℕ,
      (Fintype.card (ZMod p) : ℝ)⁻¹ * ∑ y : ZMod p, τ y ^ q ≤ Cm q)
    {M : ℝ} (hM : 0 ≤ M) (hMbound : ∀ (j : Fin K) (x : ZMod p), |davg d (F j) x| ≤ M)
    {ε η η' : ℝ} (hε : 0 < ε) (hη : 0 < η) (hη1 : η ≤ 1 / 4) (hη' : 0 < η')
    (α : Fin K → ℝ) (T : Fin K → Finset (ZMod p))
    (hT : ∀ j y, (∃ n : ℤ, |(davg d (F j) y - α j) / ε - n| ≤ η) → y ∈ T j) :
    ∃ E : ℝ, 0 ≤ E ∧ ∀ x : ZMod p,
      |∑ y ∈ Finset.univ.filter (fun y => ∀ j : Fin K, y ∈ Finset.univ.filter
          (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)),
          (ν y - 1)|
        ≤ (Fintype.card (ZMod p) : ℝ) * (Unorm d (fun y => ν y - 1) * E
            + η' * (((Fintype.card (ZMod p) : ℝ))⁻¹ * ∑ y : ZMod p, |ν y - 1|))
          + (K : ℝ) * ∑ j : Fin K, ∑ y ∈ T j, (ν y + 1) := by
  classical
  -- Step 1: for every `j` and every point `x`, a `[0,1]`-valued continuous approximation
  -- of the level set of `𝒟F_j` at `x`, with `(ν+1)`-error charged to the boundary layer.
  have hpsi : ∀ (j : Fin K) (x : ZMod p),
      ∃ φ : ℝ → ℝ, Continuous φ ∧ (∀ t, 0 ≤ φ t) ∧ (∀ t, φ t ≤ 1) ∧
        ∑ y : ZMod p, (ν y + 1) * |(if y ∈ Finset.univ.filter
            (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)
            then (1 : ℝ) else 0) - φ (davg d (F j) y)|
          ≤ ∑ y ∈ T j, (ν y + 1) :=
    fun j x => exists_continuous_psi_levelPart (davg d (F j)) ν hε hη hη1 hν (hT j) x
  choose φ hφc hφ0 hφ1 hφapprox using hpsi
  -- Step 2: the Weierstrass estimate, uniform over the finite family `x ↦ ∏_j φ_{j,x}`.
  obtain ⟨E, hE, hEbound⟩ :=
    weier_family (p := p) (d := d) (K := K) hd hM hν hτ hcorr hmom
      (Finset.univ : Finset (ZMod p)) (fun x t => ∏ j : Fin K, φ j x (t j))
      (fun x => by
        show ContinuousOn (fun t : Fin K → ℝ => ∏ j : Fin K, φ j x (t j)) _
        exact (continuous_finsetProd Finset.univ
          (fun j _ => (hφc j x).comp (continuous_apply j))).continuousOn)
      hη'
  refine ⟨E, hE, fun x => ?_⟩
  -- Step 3: the level sets and the boundary-layer budget.
  set η₀ : ℝ := ∑ j : Fin K, ∑ y ∈ T j, (ν y + 1) with hη₀
  have hη₀nn : 0 ≤ η₀ := by
    rw [hη₀]
    exact Finset.sum_nonneg (fun j _ => Finset.sum_nonneg (fun y _ => by linarith [hν y]))
  have happrox : ∀ j : Fin K,
      ∑ y : ZMod p, (ν y + 1) * |(if y ∈ Finset.univ.filter
          (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)
          then (1 : ℝ) else 0) - φ j x (davg d (F j) y)| ≤ η₀ := by
    intro j
    calc ∑ y : ZMod p, (ν y + 1) * |(if y ∈ Finset.univ.filter
            (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)
            then (1 : ℝ) else 0) - φ j x (davg d (F j) y)|
        ≤ ∑ y ∈ T j, (ν y + 1) := hφapprox j x
      _ ≤ η₀ := by
          rw [hη₀]
          refine Finset.single_le_sum (f := fun i : Fin K => ∑ y ∈ T i, (ν y + 1))
            (a := j) ?_ (Finset.mem_univ j)
          intro i _
          exact Finset.sum_nonneg (fun y _ => by linarith [hν y])
  -- Step 4: the atom estimate `sum_atom_le_of_approx_at`.
  have hmain : |∑ y ∈ Finset.univ.filter (fun y => ∀ j : Fin K, y ∈ Finset.univ.filter
        (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)),
        (ν y - 1)|
      ≤ |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)| + (K : ℝ) * η₀ := by
    have h := sum_atom_le_of_approx_at
      (P := fun j z => Finset.univ.filter
        (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) z - α j) / ε⌋))
      (Ψ := fun j y => φ j x (davg d (F j) y))
      (ν := ν) (η := η₀)
      (δ := |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)|)
      hη₀nn (abs_nonneg _) hν (fun j y => hφ0 j x (davg d (F j) y))
      (fun j y => hφ1 j x (davg d (F j) y)) x happrox (le_refl _)
    simpa using h
  -- Step 5: the Weierstrass bound at the point `x`.
  have hW := hEbound x (Finset.mem_univ x) (fun y => ν y - 1) F hF hMbound
  have hGB : |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)|
      ≤ (Fintype.card (ZMod p) : ℝ) * (Unorm d (fun y => ν y - 1) * E
          + η' * (((Fintype.card (ZMod p) : ℝ))⁻¹ * ∑ y : ZMod p, |ν y - 1|)) := by
    have hGcpos : 0 < (Fintype.card (ZMod p) : ℝ) := by
      exact_mod_cast (Fintype.card_pos_iff.mpr ⟨(0 : ZMod p)⟩)
    have hstep : ((Fintype.card (ZMod p) : ℝ))⁻¹
          * |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)|
        ≤ Unorm d (fun y => ν y - 1) * E
          + η' * (((Fintype.card (ZMod p) : ℝ))⁻¹ * ∑ y : ZMod p, |ν y - 1|) := by
      have h := hW
      rw [abs_mul, abs_of_nonneg (inv_nonneg.mpr hGcpos.le)] at h
      exact h
    calc |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)|
        = (Fintype.card (ZMod p) : ℝ) * (((Fintype.card (ZMod p) : ℝ))⁻¹
            * |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)|) := by
          rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt hGcpos), one_mul]
      _ ≤ (Fintype.card (ZMod p) : ℝ) * (Unorm d (fun y => ν y - 1) * E
            + η' * (((Fintype.card (ZMod p) : ℝ))⁻¹ * ∑ y : ZMod p, |ν y - 1|)) :=
          mul_le_mul_of_nonneg_left hstep hGcpos.le
  calc |∑ y ∈ Finset.univ.filter (fun y => ∀ j : Fin K, y ∈ Finset.univ.filter
        (fun y => ⌊(davg d (F j) y - α j) / ε⌋ = ⌊(davg d (F j) x - α j) / ε⌋)),
        (ν y - 1)|
      ≤ |∑ y : ZMod p, (ν y - 1) * ∏ j : Fin K, φ j x (davg d (F j) y)| + (K : ℝ) * η₀ := hmain
    _ ≤ (Fintype.card (ZMod p) : ℝ) * (Unorm d (fun y => ν y - 1) * E
          + η' * (((Fintype.card (ZMod p) : ℝ))⁻¹ * ∑ y : ZMod p, |ν y - 1|))
        + (K : ℝ) * η₀ := by linarith [hGB]
    _ = (Fintype.card (ZMod p) : ℝ) * (Unorm d (fun y => ν y - 1) * E
          + η' * (((Fintype.card (ZMod p) : ℝ))⁻¹ * ∑ y : ZMod p, |ν y - 1|))
        + (K : ℝ) * ∑ j : Fin K, ∑ y ∈ T j, (ν y + 1) := by rw [hη₀]

end Commons.Combinatorics.Transference
