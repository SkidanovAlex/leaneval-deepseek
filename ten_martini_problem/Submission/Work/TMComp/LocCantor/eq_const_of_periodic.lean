import Mathlib

/-!
# A continuous function with periods `1` and an irrational number is constant

If `f : ℝ → ℂ` is continuous and invariant under translation by `1` and by an irrational
number `α`, then `f` is constant.  Indeed the additive subgroup generated by `1` and `α`
is dense in `ℝ` (Mathlib's `dense_addSubgroupClosure_pair_iff`), and `f` is constant on a
dense set, hence constant everywhere by continuity.
-/

namespace Work.TMComp.LocCantor

open Set

theorem eq_const_of_periodic (f : ℝ → ℂ) (hf : Continuous f) (α : ℝ) (hα : Irrational α)
    (h1 : ∀ x, f (x + 1) = f x) (ha : ∀ x, f (x + α) = f x) : ∃ c : ℂ, ∀ x, f x = c := by
  -- The additive subgroup generated by `1` and the irrational `α` is dense in `ℝ`.
  have hdense : Dense ((AddSubgroup.closure ({1, α} : Set ℝ)) : Set ℝ) := by
    rw [dense_addSubgroupClosure_pair_iff]
    simpa using hα.inv
  -- Every element of that subgroup is a period of `f`.
  have hperiod : ∀ g ∈ AddSubgroup.closure ({1, α} : Set ℝ), ∀ y, f (y + g) = f y := by
    intro g hg
    induction hg using AddSubgroup.closure_induction with
    | mem x hx => rcases hx with rfl | rfl
                  · exact h1
                  · exact ha
    | zero => intro y; simp
    | add a b ha hb iha ihb => intro y; rw [← add_assoc, ihb (y + a), iha y]
    | neg a ha iha => intro y; simpa using (iha (y + -a)).symm
  refine ⟨f 0, fun x => ?_⟩
  -- `f` takes the value `f 0` on the dense subgroup, hence on its closure, which is `ℝ`.
  have hsub : ((AddSubgroup.closure ({1, α} : Set ℝ)) : Set ℝ) ⊆ f ⁻¹' {f 0} := by
    intro s hs
    simp only [mem_preimage, mem_singleton_iff]
    simpa using hperiod s hs 0
  have hcl := closure_minimal hsub (isClosed_singleton.preimage hf)
  have hx : x ∈ closure ((AddSubgroup.closure ({1, α} : Set ℝ)) : Set ℝ) := by
    rw [hdense.closure_eq]; exact mem_univ x
  exact hcl hx

end Work.TMComp.LocCantor
