lemma prod_ite_one_eq {ι M : Type*} [CommMonoid M] (s : Finset ι) (p : ι → Prop)
    [DecidablePred p] (f : ι → M) :
    (∏ i ∈ s, (if p i then (1 : M) else f i)) = ∏ i ∈ s.filter (fun i => ¬ p i), f i := by
  rw [Finset.prod_ite]
  simp

lemma Sf_subset (i : ℕ) (hi : i < 60) : Sf i ⊆ Finset.range 147 := by
  intro τ hτ
  simp only [Sf, Finset.mem_image, Finset.mem_range] at hτ ⊢
  obtain ⟨j, hj, rfl⟩ := hτ
  omega

lemma Sf_card (i : ℕ) : (Sf i).card = 30 := by
  rw [Sf, Finset.card_image_of_injective]
  · simp
  · intro x y hxy
    have h : 3 * x + i = 3 * y + i := hxy
    omega

lemma prod_Sf_eq (i : ℕ) (F : ℕ → ℤ[X]) :
    ∏ τ ∈ Sf i, F τ = ∏ j ∈ Finset.range 30, F (3 * j + i) := by
  rw [Sf, Finset.prod_image]
  intro x _ y _ hxy
  have h : 3 * x + i = 3 * y + i := hxy
  omega

lemma Ppol_sq_eq (i : ℕ) :
    (Ppol i) ^ 2 = ∏ τ ∈ Sf i, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Ppol, prod_Sf_eq i (fun τ => (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)]
  rw [← Finset.prod_pow]
  apply Finset.prod_congr rfl
  intro j hj
  have h : (30 + (3 * j + i) : ℕ) = 30 + 3 * j + i := by omega
  rw [h]

lemma Qpol_eq (i : ℕ) (hi : i < 60) :
    Qpol i = ∏ τ ∈ (Finset.range 147) \ Sf i, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Qpol, prod_ite_one_eq, Finset.sdiff_eq_filter]

lemma prod_range_split (i : ℕ) (hi : i < 60) (F : ℕ → ℤ[X]) :
    (∏ τ ∈ Finset.range 147, F τ) =
      (∏ τ ∈ Sf i, F τ) * (∏ τ ∈ (Finset.range 147) \ Sf i, F τ) := by
  rw [← Finset.prod_union (Finset.disjoint_sdiff), Finset.union_sdiff_of_subset (Sf_subset i hi)]

lemma Dpol_split (i : ℕ) (hi : i < 60) :
    Dpol = (∏ τ ∈ Sf i, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2) *
      (∏ τ ∈ (Finset.range 147) \ Sf i, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2) := by
  unfold Dpol
  exact prod_range_split i hi _

lemma Dpol_eq_Ppol_sq_mul_Qpol (i : ℕ) (hi : i < 60) : Dpol = Ppol i ^ 2 * Qpol i := by
  rw [Dpol_split i hi, ← Ppol_sq_eq i, ← Qpol_eq i hi]

lemma Rpol_eq (j : ℕ) :
    Rpol j = ∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = j)),
      (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Rpol, prod_ite_one_eq]

lemma prod_filter_step (j : ℕ) :
    (∏ τ ∈ Finset.range 147, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ τ ∈ (Finset.range 147).filter (fun τ => (30 + τ : ℕ) = j),
            (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)
        * (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = j)),
            (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2) :=
  (Finset.prod_filter_mul_prod_filter_not (Finset.range 147) (fun τ => (30 + τ : ℕ) = j) _).symm

lemma filter_eq_singleton (j : ℕ) (h1 : 30 ≤ j) (h2 : j ≤ 176) :
    (Finset.range 147).filter (fun τ => (30 + τ : ℕ) = j) = {j - 30} := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_singleton]
  constructor
  · rintro ⟨hlt, hj⟩; omega
  · rintro rfl; constructor <;> omega

lemma Dpol_eq_sq_mul_Rpol (j : ℕ) (h1 : 30 ≤ j) (h2 : j ≤ 176) :
    Dpol = (C (3:ℤ) * X + C (j : ℤ)) ^ 2 * Rpol j := by
  rw [Dpol, prod_filter_step j, Rpol_eq j, filter_eq_singleton j h1 h2, Finset.prod_singleton]
  have e : ((30 + (j - 30) : ℕ) : ℤ) = (j : ℤ) := by omega
  rw [e]

lemma prod_filter_step2 (k : ℕ) :
    (∏ τ ∈ Finset.range 147, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ τ ∈ (Finset.range 147).filter (fun τ => ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
            (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)
        * (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
            (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2) :=
  (Finset.prod_filter_mul_prod_filter_not (Finset.range 147)
    (fun τ => ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)) _).symm

lemma filter_eq_pair (k : ℕ) (h1 : 30 ≤ k) (h2 : k ≤ 173) :
    (Finset.range 147).filter (fun τ => ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)) = {k - 30, k - 27} := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hlt, hk | hk⟩
    · left; omega
    · right; omega
  · rintro (rfl | rfl) <;> constructor <;> omega

lemma Dpol_eq_lin_mul_Tpol (k : ℕ) (h1 : 30 ≤ k) (h2 : k ≤ 173) :
    Dpol = (C (3:ℤ) * X + C (k : ℤ)) * (C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) * Tpol k := by
  have hne : k - 30 ∉ ({k - 27} : Finset ℕ) := by
    simp only [Finset.mem_singleton]; omega
  rw [Tpol, prod_ite_one_eq, Dpol, prod_filter_step2 k, filter_eq_pair k h1 h2,
    Finset.prod_insert hne, Finset.prod_singleton]
  have e1 : ((30 + (k - 30) : ℕ) : ℤ) = (k : ℤ) := by omega
  have e2 : ((30 + (k - 27) : ℕ) : ℤ) = ((k + 3 : ℕ) : ℤ) := by omega
  rw [e1, e2]
  ring

/-! ## degree bounds -/

lemma natDegree_lin_le (c : ℤ) : (C (3:ℤ) * X + C c).natDegree ≤ 1 := by
  calc (C (3:ℤ) * X + C c).natDegree ≤ max (C (3:ℤ) * X).natDegree (C c).natDegree :=
        Polynomial.natDegree_add_le _ _
    _ ≤ max 1 0 := by
        apply max_le
        · calc (C (3:ℤ) * X).natDegree ≤ X.natDegree := Polynomial.natDegree_C_mul_le _ _
            _ = 1 := Polynomial.natDegree_X
        · rw [Polynomial.natDegree_C]; norm_num
    _ = 1 := by norm_num

lemma natDegree_sq_lin_le (c : ℤ) : ((C (3:ℤ) * X + C c) ^ 2).natDegree ≤ 2 := by
  calc ((C (3:ℤ) * X + C c) ^ 2).natDegree ≤ 2 * (C (3:ℤ) * X + C c).natDegree :=
        Polynomial.natDegree_pow_le
    _ ≤ 2 * 1 := by gcongr; exact natDegree_lin_le c
    _ = 2 := by norm_num

lemma natDegree_prod_sq_le_card (s : Finset ℕ) :
    (∏ τ ∈ s, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤ 2 * s.card := by
  have h1 : (∏ τ ∈ s, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤
      ∑ τ ∈ s, ((C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2).natDegree :=
    Polynomial.natDegree_prod_le s (fun τ => (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)
  have h2 : (∑ τ ∈ s, ((C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2).natDegree) ≤ ∑ _τ ∈ s, 2 :=
    Finset.sum_le_sum (fun τ _ => natDegree_sq_lin_le _)
  have h3 : (∑ _τ ∈ s, (2 : ℕ)) = 2 * s.card := by
    rw [Finset.sum_const, smul_eq_mul, mul_comm]
  linarith

lemma natDegree_prod_sq_le_294 (s : Finset ℕ) (h : s.card ≤ 147) :
    (∏ τ ∈ s, (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤ 294 :=
  le_trans (natDegree_prod_sq_le_card s) (by omega)

lemma natDegree_sum_le' {ι : Type*} (s : Finset ι) (f : ι → ℤ[X]) (n : ℕ)
    (h : ∀ i ∈ s, (f i).natDegree ≤ n) : (∑ i ∈ s, f i).natDegree ≤ n := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      refine le_trans (Polynomial.natDegree_add_le _ _) (max_le ?_ ?_)
      · exact h a (Finset.mem_insert_self a s)
      · exact ih (fun i hi => h i (Finset.mem_insert_of_mem hi))

lemma filter_card_le (p : ℕ → Prop) [DecidablePred p] :
    ((Finset.range 147).filter p).card ≤ 147 := by
  have h := Finset.card_le_card (Finset.filter_subset p (Finset.range 147))
  rwa [Finset.card_range] at h

lemma card_sdiff_le (s : Finset ℕ) : ((Finset.range 147) \ s).card ≤ 147 := by
  have h := Finset.card_le_card (Finset.sdiff_subset (s := Finset.range 147) (t := s))
  rwa [Finset.card_range] at h

lemma natDegree_Qpol_le (i : ℕ) (hi : i < 60) : (Qpol i).natDegree ≤ 294 := by
  rw [Qpol_eq i hi]
  exact natDegree_prod_sq_le_294 _ (card_sdiff_le _)

lemma natDegree_Rpol_le (j : ℕ) : (Rpol j).natDegree ≤ 294 := by
  rw [Rpol_eq j]
  exact natDegree_prod_sq_le_294 _ (filter_card_le _)

lemma Tpol_eq' (k : ℕ) :
    Tpol k = (C (3:ℤ) * X + C (k : ℤ)) * ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
      (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)) := by
  rw [Tpol, prod_ite_one_eq]

lemma natDegree_Tpol_le (k : ℕ) : (Tpol k).natDegree ≤ 296 := by
  have h1 : (Tpol k).natDegree ≤ (C (3:ℤ) * X + C (k : ℤ)).natDegree +
      ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
        (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
          (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)).natDegree := by
    rw [Tpol_eq' k]
    exact Polynomial.natDegree_mul_le
  have h2 : ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
      (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2)).natDegree ≤ 1 + 294 := by
    have hm := Polynomial.natDegree_mul_le (p := (C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)))
      (q := (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2))
    have ha : (C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)).natDegree ≤ 1 := natDegree_lin_le _
    have hb : (∏ τ ∈ (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((30 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤ 294 :=
      natDegree_prod_sq_le_294 _ (filter_card_le _)
    linarith
  have h3 : (C (3:ℤ) * X + C (k : ℤ)).natDegree ≤ 1 := natDegree_lin_le _
  linarith

lemma natDegree_P1_le : P1.natDegree ≤ 352 := by
  have h1 : P1.natDegree ≤ (C ((4710128697246244834921603689 : ℤ) * (606813462200836026569688897302970236928000000 : ℤ) ^ 2)).natDegree +
      ((∏ r ∈ Finset.range 58, (Polynomial.X + C (((r : ℤ) + 1)))) *
        (∑ i ∈ Finset.range 60,
          C ((Lc) * (-1 : ℤ) ^ i * (Nat.choose 59 i : ℤ)) * Qpol i)).natDegree := by
    rw [P1]
    exact Polynomial.natDegree_mul_le
  have h2 : ((∏ r ∈ Finset.range 58, (Polynomial.X + C (((r : ℤ) + 1)))) *
      (∑ i ∈ Finset.range 60,
        C ((Lc) * (-1 : ℤ) ^ i * (Nat.choose 59 i : ℤ)) * Qpol i)).natDegree ≤ 58 + 294 := by
    refine le_trans (Polynomial.natDegree_mul_le) (add_le_add ?_ ?_)
    · have hp : (∏ r ∈ Finset.range 58, (Polynomial.X + C (((r : ℤ) + 1)))).natDegree ≤
          ∑ r ∈ Finset.range 58, (Polynomial.X + C (((r : ℤ) + 1))).natDegree :=
        Polynomial.natDegree_prod_le _ _
      have hq : (∑ r ∈ Finset.range 58, (Polynomial.X + C (((r : ℤ) + 1))).natDegree) = 58 := by
        rw [Finset.sum_congr rfl (fun r _ => Polynomial.natDegree_X_add_C _)]
        simp
      omega
    · exact natDegree_sum_le' _ _ 294 (fun i hi => by
        rw [Finset.mem_range] at hi
        exact le_trans (Polynomial.natDegree_C_mul_le _ _) (natDegree_Qpol_le i hi))
  have h3 : (C ((4710128697246244834921603689 : ℤ) * (606813462200836026569688897302970236928000000 : ℤ) ^ 2)).natDegree = 0 :=
    Polynomial.natDegree_C _
  rw [h3] at h1
  linarith

lemma natDegree_P2_le : P2.natDegree ≤ 296 := by
  have h1 : P2.natDegree ≤ (C ((2350561331282878571829474910515074683828862318181142924420699914240000000000000 : ℤ))).natDegree +
      ((∑ j ∈ aIdx, C (cA j) * Rpol j) + (∑ k ∈ dIdx, C (cD k) * Tpol k)).natDegree := by
    rw [P2]
    exact Polynomial.natDegree_mul_le
  have hR : (∑ j ∈ aIdx, C (cA j) * Rpol j).natDegree ≤ 294 :=
    natDegree_sum_le' _ _ 294 (fun j _ =>
      le_trans (Polynomial.natDegree_C_mul_le _ _) (natDegree_Rpol_le j))
  have hT : (∑ k ∈ dIdx, C (cD k) * Tpol k).natDegree ≤ 296 :=
    natDegree_sum_le' _ _ 296 (fun k _ =>
      le_trans (Polynomial.natDegree_C_mul_le _ _) (natDegree_Tpol_le k))
  have h2 : ((∑ j ∈ aIdx, C (cA j) * Rpol j) + (∑ k ∈ dIdx, C (cD k) * Tpol k)).natDegree ≤
      296 := by
    refine le_trans (Polynomial.natDegree_add_le _ _) (max_le (le_trans hR (by norm_num)) hT)
  have h3 : (C ((2350561331282878571829474910515074683828862318181142924420699914240000000000000 : ℤ))).natDegree = 0 := Polynomial.natDegree_C _
  rw [h3] at h1
  linarith

lemma degree_bound : max P1.natDegree P2.natDegree < 353 := by
  rw [max_lt_iff]
  constructor
  · exact lt_of_le_of_lt natDegree_P1_le (by norm_num)
  · exact lt_of_le_of_lt natDegree_P2_le (by norm_num)

/-! ## evaluation of the polynomials (integer form) -/

def EvP1 (c : ℤ) : ℤ := (4710128697246244834921603689 * 606813462200836026569688897302970236928000000 ^ 2) *
  ((∏ r ∈ Finset.range 58, (c + ((r : ℤ) + 1))) *
   (∑ i ∈ Finset.range 60, (Lc * wB i) *
     (∏ τ ∈ Finset.range 147, (if τ ∈ Sf i then 1 else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2))))

def EvP2 (c : ℤ) : ℤ := 2350561331282878571829474910515074683828862318181142924420699914240000000000000 *
  ((∑ j ∈ aIdx, cA j * (∏ τ ∈ Finset.range 147, (if (30 + τ : ℕ) = j then 1 else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2)))
   + (∑ k ∈ dIdx, cD k * ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) * (∏ τ ∈ Finset.range 147, (if (30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3 then 1 else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2)))))

lemma eval_ite (p : Prop) [Decidable p] (x : ℤ) (a b : ℤ[X]) :
    Polynomial.eval x (if p then a else b) = if p then Polynomial.eval x a else Polynomial.eval x b := by
  split <;> rfl

lemma eval_P1_EvP1 (c : ℤ) : P1.eval c = EvP1 c := by
  rw [P1, EvP1]
  simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_C,
    Polynomial.eval_X, Polynomial.eval_prod, Polynomial.eval_finsetSum, Polynomial.eval_one, Qpol,
    eval_ite]
  rw [wB_sum (f := fun i => ∏ τ ∈ Finset.range 147,
    (if τ ∈ Sf i then (1 : ℤ) else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2))]
  ring

lemma eval_P2_EvP2 (c : ℤ) : P2.eval c = EvP2 c := by
  rw [P2, EvP2]
  simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_C,
    Polynomial.eval_X, Polynomial.eval_prod, Polynomial.eval_finsetSum, Polynomial.eval_one, Rpol, Tpol,
    eval_ite]
  ring

/-! ## Cheap evaluation

The kernel evaluation of `EvP1`/`EvP2` recomputes all the 72-factor products, which is
prohibitively slow.  We introduce the single common product `Pall c` and rewrite
`EvP1`/`EvP2` in terms of it (dividing out the factors that are absent), so that each
`decide` only has to compute `Pall c` once and perform divisions by small factors. -/

def Pall (c : ℤ) : ℤ := ∏ τ ∈ Finset.range 147, (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2

def goD (c : ℤ) (i n : ℕ) : ℤ :=
  Nat.rec 1 (fun m ih => ih * (3 * c + ((30 + (3 * m + i) : ℕ) : ℤ)) ^ 2) n

lemma goD_eq (c : ℤ) (i : ℕ) : ∀ n, goD c i n = ∏ j ∈ Finset.range n, (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2 := by
  intro n
  induction n with
  | zero => simp [goD]
  | succ n ih =>
      have h : goD c i (n + 1) = goD c i n * (3 * c + ((30 + (3 * n + i) : ℕ) : ℤ)) ^ 2 := rfl
      rw [h, ih, Finset.prod_range_succ]

lemma prod_Sf_eqZ (i : ℕ) (F : ℕ → ℤ) :
    ∏ τ ∈ Sf i, F τ = ∏ j ∈ Finset.range 30, F (3 * j + i) := by
  rw [Sf, Finset.prod_image]
  intro x _ y _ hxy
  have h : 3 * x + i = 3 * y + i := hxy
  omega

lemma prod_range_splitZ (i : ℕ) (hi : i < 60) (F : ℕ → ℤ) :
    (∏ τ ∈ Finset.range 147, F τ) =
      (∏ τ ∈ Sf i, F τ) * (∏ τ ∈ (Finset.range 147) \ Sf i, F τ) := by
  rw [← Finset.prod_union (Finset.disjoint_sdiff), Finset.union_sdiff_of_subset (Sf_subset i hi)]

lemma sqf_ne_zero {c : ℤ} (hc : 0 ≤ c) {t : ℕ} (ht : 0 < t) : (3 * c + (t : ℤ)) ^ 2 ≠ 0 := by
  refine pow_ne_zero 2 ?_
  have h1 : (0 : ℤ) ≤ 3 * c := by linarith
  have h2 : (0 : ℤ) < (t : ℤ) := by exact_mod_cast ht
  linarith

lemma prod_erase_eq_div (s : Finset ℕ) (a : ℕ) (ha : a ∈ s) (g : ℕ → ℤ) (hg : g a ≠ 0) :
    (∏ x ∈ s.erase a, g x) = (∏ x ∈ s, g x) / g a := by
  have h := Finset.prod_erase_mul s g ha
  rw [← h]
  exact (Int.mul_ediv_cancel _ hg).symm

lemma prod_erase_pair_eq_div (s : Finset ℕ) (a b : ℕ) (ha : a ∈ s) (hb : b ∈ s.erase a)
    (g : ℕ → ℤ) (ha' : g a ≠ 0) (hb' : g b ≠ 0) :
    (∏ x ∈ (s.erase a).erase b, g x) = (∏ x ∈ s, g x) / (g a * g b) := by
  have hP : (∏ x ∈ s, g x) = (g a * g b) * (∏ x ∈ (s.erase a).erase b, g x) := by
    rw [← Finset.prod_erase_mul s g ha, ← Finset.prod_erase_mul (s.erase a) g hb]
    ring
  rw [hP]
  exact (Int.mul_ediv_cancel_left _ (mul_ne_zero ha' hb')).symm

lemma filter_not_eq_erase (j : ℕ) (h1 : 30 ≤ j) (h2 : j ≤ 176) :
    (Finset.range 147).filter (fun τ => ¬ ((30 + τ : ℕ) = j)) =
      (Finset.range 147).erase (j - 30) := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_erase]
  constructor
  · rintro ⟨hlt, hne⟩
    exact ⟨fun h => hne (by omega), hlt⟩
  · rintro ⟨hne, hlt⟩
    exact ⟨hlt, fun h => hne (by omega)⟩

lemma filter_not_pair_eq_erase (k : ℕ) (h1 : 30 ≤ k) (h2 : k ≤ 173) :
    (Finset.range 147).filter
        (fun τ => ¬ ((30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3)) =
      ((Finset.range 147).erase (k - 30)).erase (k - 27) := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_erase]
  constructor
  · rintro ⟨hlt, hne⟩
    refine ⟨?_, ?_, hlt⟩
    · intro h; exact hne (Or.inr (by omega))
    · intro h; exact hne (Or.inl (by omega))
  · rintro ⟨hne1, hne2, hlt⟩
    refine ⟨hlt, ?_⟩
    rintro (h | h)
    · exact hne2 (by omega)
    · exact hne1 (by omega)

lemma prod_ite_eq_div {c : ℤ} (hc : 0 ≤ c) (j : ℕ) (h1 : 30 ≤ j) (h2 : j ≤ 176) :
    (∏ τ ∈ Finset.range 147,
        (if (30 + τ : ℕ) = j then (1 : ℤ)
          else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2))
      = Pall c / (3 * c + ((30 + (j - 30) : ℕ) : ℤ)) ^ 2 := by
  have hmem : j - 30 ∈ Finset.range 147 := by
    simp only [Finset.mem_range]; omega
  have hne : (3 * c + ((30 + (j - 30) : ℕ) : ℤ)) ^ 2 ≠ 0 := by
    have hj : (30 + (j - 30) : ℕ) = j := by omega
    rw [hj]; exact sqf_ne_zero hc (by omega : 0 < j)
  rw [prod_ite_one_eq, filter_not_eq_erase j h1 h2, Pall]
  exact prod_erase_eq_div _ _ hmem _ hne

lemma prod_ite_pair_eq_div {c : ℤ} (hc : 0 ≤ c) (k : ℕ) (h1 : 30 ≤ k)
    (h2 : k ≤ 173) :
    (∏ τ ∈ Finset.range 147,
        (if (30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3 then (1 : ℤ)
          else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2))
      = Pall c / ((3 * c + ((30 + (k - 30) : ℕ) : ℤ)) ^ 2 *
          (3 * c + ((30 + (k - 27) : ℕ) : ℤ)) ^ 2) := by
  have hmem1 : k - 30 ∈ Finset.range 147 := by
    simp only [Finset.mem_range]; omega
  have hmem2 : k - 27 ∈ (Finset.range 147).erase (k - 30) := by
    simp only [Finset.mem_erase, Finset.mem_range]
    constructor
    · omega
    · omega
  have hne1 : (3 * c + ((30 + (k - 30) : ℕ) : ℤ)) ^ 2 ≠ 0 := by
    have hk : (30 + (k - 30) : ℕ) = k := by omega
    rw [hk]; exact sqf_ne_zero hc (by omega : 0 < k)
  have hne2 : (3 * c + ((30 + (k - 27) : ℕ) : ℤ)) ^ 2 ≠ 0 := by
    have hk : (30 + (k - 27) : ℕ) = k + 3 := by omega
    rw [hk]; exact sqf_ne_zero hc (by omega : 0 < k + 3)
  rw [prod_ite_one_eq, filter_not_pair_eq_erase k h1 h2, Pall]
  exact prod_erase_pair_eq_div _ _ _ hmem1 hmem2 _ hne1 hne2

lemma prod_ite_Sf_eq_div {c : ℤ} (hc : 0 ≤ c) (i : ℕ) (hi : i < 60) :
    (∏ τ ∈ Finset.range 147,
        (if τ ∈ Sf i then (1 : ℤ) else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2))
      = Pall c / (∏ j ∈ Finset.range 30,
          (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2) := by
  have hSf : (∏ τ ∈ Sf i, (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ j ∈ Finset.range 30, (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2) :=
    prod_Sf_eqZ i _
  have hne : (∏ j ∈ Finset.range 30,
      (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2) ≠ 0 := by
    rw [← hSf]
    exact Finset.prod_ne_zero_iff.mpr (fun τ _ => sqf_ne_zero hc (by omega : 0 < 30 + τ))
  have hsplit : Pall c =
      (∏ j ∈ Finset.range 30, (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2) *
        (∏ τ ∈ (Finset.range 147) \ Sf i,
          (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2) := by
    rw [Pall, prod_range_splitZ i hi, hSf]
  rw [prod_ite_one_eq, ← Finset.sdiff_eq_filter, hsplit,
    Int.mul_ediv_cancel_left _ hne]

def EvP1cheap (c : ℤ) : ℤ :=
  (4710128697246244834921603689 * 606813462200836026569688897302970236928000000 ^ 2) *
    ((∏ r ∈ Finset.range 58, (c + ((r : ℤ) + 1))) *
     (∑ i ∈ Finset.range 60, (Lc * wB i) * (Pall c / goD c i 30)))

lemma EvP1_goD (c : ℤ) :
    (∑ i ∈ Finset.range 60, (Lc * wB i) * (Pall c / goD c i 30)) =
      (∑ i ∈ Finset.range 60, (Lc * wB i) *
        (Pall c / (∏ j ∈ Finset.range 30, (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2))) := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [goD_eq c i]

def EvP2cheap (c : ℤ) : ℤ :=
  (2350561331282878571829474910515074683828862318181142924420699914240000000000000) *
    ((∑ j ∈ aIdx, cA j * (Pall c / (3 * c + ((30 + (j - 30) : ℕ) : ℤ)) ^ 2))
     + (∑ k ∈ dIdx, cD k *
          ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) *
            (Pall c / ((3 * c + ((30 + (k - 30) : ℕ) : ℤ)) ^ 2 *
              (3 * c + ((30 + (k - 27) : ℕ) : ℤ)) ^ 2)))))

lemma EvP1_sum_eq {c : ℤ} (hc : 0 ≤ c) :
    (∑ i ∈ Finset.range 60, (Lc * wB i) *
        (∏ τ ∈ Finset.range 147,
          (if τ ∈ Sf i then (1 : ℤ) else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2)))
      = (∑ i ∈ Finset.range 60, (Lc * wB i) *
        (Pall c / (∏ j ∈ Finset.range 30,
          (3 * c + ((30 + (3 * j + i) : ℕ) : ℤ)) ^ 2))) := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  rw [prod_ite_Sf_eq_div hc i hi]

lemma EvP2_sum1_eq {c : ℤ} (hc : 0 ≤ c) :
    (∑ j ∈ aIdx, cA j *
        (∏ τ ∈ Finset.range 147,
          (if (30 + τ : ℕ) = j then (1 : ℤ)
            else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2)))
      = (∑ j ∈ aIdx, cA j *
        (Pall c / (3 * c + ((30 + (j - 30) : ℕ) : ℤ)) ^ 2)) := by
  apply Finset.sum_congr rfl
  intro j hj
  obtain ⟨h1, h2⟩ := aIdx_bounds j hj
  rw [prod_ite_eq_div hc j h1 h2]

lemma EvP2_sum2_eq {c : ℤ} (hc : 0 ≤ c) :
    (∑ k ∈ dIdx, cD k *
        ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) *
          (∏ τ ∈ Finset.range 147,
            (if (30 + τ : ℕ) = k ∨ (30 + τ : ℕ) = k + 3 then (1 : ℤ)
              else (3 * c + ((30 + τ : ℕ) : ℤ)) ^ 2))))
      = (∑ k ∈ dIdx, cD k *
          ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) *
            (Pall c / ((3 * c + ((30 + (k - 30) : ℕ) : ℤ)) ^ 2 *
              (3 * c + ((30 + (k - 27) : ℕ) : ℤ)) ^ 2)))) := by
  apply Finset.sum_congr rfl
  intro k hk
  obtain ⟨h1, h2⟩ := dIdx_bounds k hk
  rw [prod_ite_pair_eq_div hc k h1 h2]

lemma EvP1_eq_cheap {c : ℤ} (hc : 0 ≤ c) : EvP1 c = EvP1cheap c := by
  rw [EvP1, EvP1cheap, EvP1_goD c, EvP1_sum_eq hc]

lemma EvP2_eq_cheap {c : ℤ} (hc : 0 ≤ c) : EvP2 c = EvP2cheap c := by
  rw [EvP2, EvP2cheap, EvP2_sum1_eq hc, EvP2_sum2_eq hc]


