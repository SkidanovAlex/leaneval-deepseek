  have hDf : ((Df m : ℤ) : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt (Df_pos m))
  have hFT : (2350561331282878571829474910515074683828862318181142924420699914240000000000000 : ℝ) ≠ 0 := by norm_num
  have hLc : (Lc : ℝ) ≠ 0 := by norm_num [Lc]
  have h := h1.trans (hP.trans h2.symm)
  have h' : (Vm29 m * ((Df m : ℤ) : ℝ)) * 2350561331282878571829474910515074683828862318181142924420699914240000000000000 =
      (Vd29 m * ((Df m : ℤ) : ℝ)) * 2350561331282878571829474910515074683828862318181142924420699914240000000000000 := mul_right_cancel₀ hLc h
  have h'' : Vm29 m * ((Df m : ℤ) : ℝ) = Vd29 m * ((Df m : ℤ) : ℝ) := mul_right_cancel₀ hFT h'
  exact mul_right_cancel₀ hDf h''

