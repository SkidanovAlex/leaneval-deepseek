/-! ## the factorial identity -/

lemma choose_fact_nat (m : ℕ) :
    (m + 58).choose 58 * (58 !) = ∏ r ∈ Finset.range 58, (m + r + 1) := by
  have h2 : (m + 1).ascFactorial 58 = 58 ! * (m + 58).choose 58 := by
    simpa using Nat.ascFactorial_eq_factorial_mul_choose m 58
  have h1 : (m + 1).ascFactorial 58 = ∏ i ∈ Finset.range 58, (m + 1 + i) :=
    Nat.ascFactorial_eq_prod_range (m + 1) 58
  rw [h2, Nat.mul_comm] at h1
  rw [h1]
  apply Finset.prod_congr rfl
  intro r hr
  omega

lemma choose_fact (m : ℕ) :
    (Nat.choose (m + 58) 58 : ℝ) * 2350561331282878571829474910515074683828862318181142924420699914240000000000000 = ∏ r ∈ Finset.range 58, ((m : ℝ) + (r + 1)) := by
  have h : ((m + 58).choose 58 : ℝ) * ((58 ! : ℕ) : ℝ) =
      ((∏ r ∈ Finset.range 58, (m + r + 1) : ℕ) : ℝ) := by
    exact_mod_cast choose_fact_nat m
  have h24 : ((58 ! : ℕ) : ℝ) = 2350561331282878571829474910515074683828862318181142924420699914240000000000000 := by norm_num
  rw [h24] at h
  rw [h]
  push_cast
  apply Finset.prod_congr rfl
  intro r hr
  ring


