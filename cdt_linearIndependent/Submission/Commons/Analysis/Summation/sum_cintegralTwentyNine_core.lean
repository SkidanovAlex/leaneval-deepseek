lemma cTwentyNinePf_eq (i m : ℕ) : cTwentyNinePf i m = ((Pf i m : ℤ) : ℝ) := by
  have h : ((Pf i m : ℤ) : ℝ) = ∏ j ∈ Finset.range 30,
