  rw [show (W129 m + W229 m) * ((Df m : ℤ) : ℝ) * 2350561331282878571829474910515074683828862318181142924420699914240000000000000 * (Lc : ℝ) =
      ((∑ j ∈ aIdx, aj j / (xm m j) ^ 2) * ((Df m : ℤ) : ℝ) * (Lc : ℝ) +
