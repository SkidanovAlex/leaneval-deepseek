def Df (m : ℕ) : ℤ := (Dpol).eval (m : ℤ)
def Pf (i : ℕ) (m : ℕ) : ℤ := (Ppol i).eval (m : ℤ)
def Qf (i : ℕ) (m : ℕ) : ℤ := (Qpol i).eval (m : ℤ)
def Rf (j : ℕ) (m : ℕ) : ℤ := (Rpol j).eval (m : ℤ)
def Tf (k : ℕ) (m : ℕ) : ℤ := (Tpol k).eval (m : ℤ)

lemma Pf_pos (i m : ℕ) (hi : i < 62) : 0 < Pf i m := by
  rw [Pf, Ppol, Polynomial.eval_prod]
  apply Finset.prod_pos
  intro j hj
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  positivity

lemma Df_pos (m : ℕ) : 0 < Df m := by
  rw [Df, Dpol, Polynomial.eval_prod]
  apply Finset.prod_pos
  intro τ hτ
  simp only [Polynomial.eval_pow, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_X]
  positivity

lemma Df_eq_Pf_sq_mul_Qf (i m : ℕ) (hi : i < 62) : Df m = (Pf i m) ^ 2 * Qf i m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_Ppol_sq_mul_Qpol i hi)
  simpa [Df, Pf, Qf, Polynomial.eval_mul, Polynomial.eval_pow] using h

lemma Df_eq_sq_mul_Rf (j m : ℕ) (h1 : 31 ≤ j) (h2 : j ≤ 182) :
    Df m = (3 * (m : ℤ) + (j : ℤ)) ^ 2 * Rf j m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_sq_mul_Rpol j h1 h2)
  simpa [Df, Rf, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat] using h

lemma Df_eq_lin_mul_Tf (k m : ℕ) (h1 : 31 ≤ k) (h2 : k ≤ 179) :
    Df m = (3 * (m : ℤ) + (k : ℤ)) * (3 * (m : ℤ) + ((k + 3 : ℕ) : ℤ)) * Tf k m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_lin_mul_Tpol k h1 h2)
  simpa [Df, Tf, Polynomial.eval_mul, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat] using h


/-! ## real-valued definitions -/

noncomputable def cThirtyPf (i : ℕ) (m : ℕ) : ℝ := ∏ j ∈ Finset.range 31, xm m (31 + 3 * j + i)

noncomputable def Vm30 (m : ℕ) : ℝ := (42391158275216203514294433201 : ℝ) * (Nat.choose (m + 60) 60 : ℝ) *
  (∑ i ∈ Finset.range 62, ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) *
    (54613211598075242391272000757267321323520000000 / cThirtyPf i m) ^ 2)

noncomputable def aj (j : ℕ) : ℝ := (cA j : ℝ) / (Lc : ℝ)
noncomputable def dj (k : ℕ) : ℝ := (cD k : ℝ) / (3 * (Lc : ℝ))

noncomputable def W130 (m : ℕ) : ℝ := ∑ j ∈ aIdx, aj j / (xm m j) ^ 2
noncomputable def W230 (m : ℕ) : ℝ := ∑ k ∈ dIdx, dj k * (1 / xm m k - 1 / xm m (k + 3))
noncomputable def Vd30 (m : ℕ) : ℝ := W130 m + W230 m

lemma cThirtyPf_eq (i m : ℕ) : cThirtyPf i m = ((Pf i m : ℤ) : ℝ) := by
  have h : ((Pf i m : ℤ) : ℝ) = ∏ j ∈ Finset.range 31,
      ((3 : ℝ) * (m : ℝ) + ((31 + 3 * j + i : ℕ) : ℝ)) := by
    rw [Pf, Ppol, Polynomial.eval_prod]
    push_cast
    apply Finset.prod_congr rfl
    intro j hj
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
    push_cast
    ring
  rw [h, cThirtyPf]
  apply Finset.prod_congr rfl
  intro j hj
  rw [xm_eq]

lemma eval_prodP (m : ℕ) :
    Polynomial.eval (m : ℤ) (∏ r ∈ Finset.range 60, (Polynomial.X + C ((r : ℤ) + 1))) =
      ∏ r ∈ Finset.range 60, ((m : ℤ) + (r + 1)) := by
  rw [Polynomial.eval_prod]
  apply Finset.prod_congr rfl
  intro r hr
  simp [Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_X]

lemma eval_sumP (m : ℕ) :
    Polynomial.eval (m : ℤ) (∑ i ∈ Finset.range 62,
        C ((Lc) * (-1 : ℤ) ^ i * (Nat.choose 61 i : ℤ)) * Qpol i) =
      ∑ i ∈ Finset.range 62, (Lc) * (-1 : ℤ) ^ i * (Nat.choose 61 i : ℤ) * (Qf i m) := by
  rw [Polynomial.eval_finsetSum]
  apply Finset.sum_congr rfl
  intro i hi
  simp [Polynomial.eval_mul, Polynomial.eval_C, Qf]

lemma eval_P1_int (m : ℕ) :
    P1.eval (m : ℤ) = (42391158275216203514294433201 * 54613211598075242391272000757267321323520000000 ^ 2) *
      (∏ r ∈ Finset.range 60, ((m : ℤ) + (r + 1))) *
      (∑ i ∈ Finset.range 62, (Lc) * (-1 : ℤ) ^ i * (Nat.choose 61 i : ℤ) * (Qf i m)) := by
  rw [P1, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C, eval_prodP m, eval_sumP m]
  ring

lemma eval_P1 (m : ℕ) :
    ((P1.eval (m : ℤ) : ℤ) : ℝ) = (42391158275216203514294433201 : ℝ) * (54613211598075242391272000757267321323520000000 : ℝ) ^ 2 *
      (∏ r ∈ Finset.range 60, ((m : ℝ) + (r + 1))) *
      (∑ i ∈ Finset.range 62, (Lc : ℝ) * (-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ) * ((Qf i m : ℤ) : ℝ)) := by
  rw [eval_P1_int m]
  push_cast
  ring

lemma eval_P2_int (m : ℕ) :
    P2.eval (m : ℤ) = 8320987112741390144276341183223364380754172606361245952449277696409600000000000000 *
      ((∑ j ∈ aIdx, cA j * Rf j m) + (∑ k ∈ dIdx, cD k * Tf k m)) := by
  rw [P2, Polynomial.eval_mul, Polynomial.eval_C]
  congr 1
  rw [Polynomial.eval_add, Polynomial.eval_finsetSum, Polynomial.eval_finsetSum]
  congr 1
  · apply Finset.sum_congr rfl
    intro j hj
    simp [Polynomial.eval_mul, Polynomial.eval_C, Rf]
  · apply Finset.sum_congr rfl
    intro k hk
    simp [Polynomial.eval_mul, Polynomial.eval_C, Tf]

lemma eval_P2 (m : ℕ) :
    ((P2.eval (m : ℤ) : ℤ) : ℝ) = (8320987112741390144276341183223364380754172606361245952449277696409600000000000000 : ℝ) *
      ((∑ j ∈ aIdx, (cA j : ℝ) * ((Rf j m : ℤ) : ℝ)) +
        (∑ k ∈ dIdx, (cD k : ℝ) * ((Tf k m : ℤ) : ℝ))) := by
  rw [eval_P2_int m]
  push_cast
  ring


/-! ## the factorial identity -/

lemma choose_fact_nat (m : ℕ) :
    (m + 60).choose 60 * (60 !) = ∏ r ∈ Finset.range 60, (m + r + 1) := by
  have h2 : (m + 1).ascFactorial 60 = 60 ! * (m + 60).choose 60 := by
    simpa using Nat.ascFactorial_eq_factorial_mul_choose m 60
  have h1 : (m + 1).ascFactorial 60 = ∏ i ∈ Finset.range 60, (m + 1 + i) :=
    Nat.ascFactorial_eq_prod_range (m + 1) 60
  rw [h2, Nat.mul_comm] at h1
  rw [h1]
  apply Finset.prod_congr rfl
  intro r hr
  omega

lemma choose_fact (m : ℕ) :
    (Nat.choose (m + 60) 60 : ℝ) * 8320987112741390144276341183223364380754172606361245952449277696409600000000000000 = ∏ r ∈ Finset.range 60, ((m : ℝ) + (r + 1)) := by
  have h : ((m + 60).choose 60 : ℝ) * ((60 ! : ℕ) : ℝ) =
      ((∏ r ∈ Finset.range 60, (m + r + 1) : ℕ) : ℝ) := by
    exact_mod_cast choose_fact_nat m
  have h24 : ((60 ! : ℕ) : ℝ) = 8320987112741390144276341183223364380754172606361245952449277696409600000000000000 := by norm_num
  rw [h24] at h
  rw [h]
  push_cast
  apply Finset.prod_congr rfl
  intro r hr
  ring


/-! ## the two clearing identities -/

lemma clear_left (m : ℕ) :
    Vm30 m * ((Df m : ℤ) : ℝ) * 8320987112741390144276341183223364380754172606361245952449277696409600000000000000 * (Lc : ℝ) =
      ((P1.eval (m : ℤ) : ℤ) : ℝ) := by
  have hgoal : Vm30 m * ((Df m : ℤ) : ℝ) * 8320987112741390144276341183223364380754172606361245952449277696409600000000000000 * (Lc : ℝ) =
      (42391158275216203514294433201 : ℝ) * ((Nat.choose (m + 60) 60 : ℝ) * 8320987112741390144276341183223364380754172606361245952449277696409600000000000000) *
        ((∑ i ∈ Finset.range 62, ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) *
            (54613211598075242391272000757267321323520000000 / cThirtyPf i m) ^ 2) * ((Df m : ℤ) : ℝ)) * (Lc : ℝ) := by
    rw [Vm30]
    ring
  have hsum : (∑ i ∈ Finset.range 62, ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) *
        (54613211598075242391272000757267321323520000000 / cThirtyPf i m) ^ 2) * ((Df m : ℤ) : ℝ) =
      (54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 62,
        ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ)) := by
    rw [Finset.sum_mul, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    rw [cThirtyPf_eq i m]
    have hD : ((Df m : ℤ) : ℝ) = ((((Pf i m : ℤ)) : ℝ)) ^ 2 * ((Qf i m : ℤ) : ℝ) := by
      rw [Df_eq_Pf_sq_mul_Qf i m hi]
      simp only [Int.cast_mul, Int.cast_pow]
    rw [hD]
    have hne : (((Pf i m : ℤ)) : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt (Pf_pos i m hi))
    field_simp
    try ring
  have hLc2 : ((54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 62,
        ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ) =
      (54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 62,
        (Lc : ℝ) * ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ)) := by
    rw [show ((54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 62,
          ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ)
        = (54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * ((Lc : ℝ) * (∑ i ∈ Finset.range 62,
          ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) by ring]
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  rw [hgoal, choose_fact m, hsum, eval_P1 m]
  rw [show (42391158275216203514294433201 : ℝ) * (∏ r ∈ Finset.range 60, ((m : ℝ) + (r + 1))) *
        ((54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 62,
          ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ)
      = (42391158275216203514294433201 : ℝ) * (∏ r ∈ Finset.range 60, ((m : ℝ) + (r + 1))) *
        (((54613211598075242391272000757267321323520000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 62,
          ((-1 : ℝ) ^ i * (Nat.choose 61 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ)) by ring]
  rw [hLc2]
