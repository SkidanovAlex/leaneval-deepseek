def Sf (i : ℕ) : Finset ℕ := (Finset.range 32).image (fun j => 3 * j + i)

/-! ## polynomials -/

noncomputable def Dpol : ℤ[X] := ∏ τ ∈ Finset.range 157, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2
noncomputable def Qpol (i : ℕ) : ℤ[X] := ∏ τ ∈ Finset.range 157, (if τ ∈ Sf i then (1 : ℤ[X]) else (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
noncomputable def Rpol (j : ℕ) : ℤ[X] := ∏ τ ∈ Finset.range 157, (if (32 + τ : ℕ) = j then (1 : ℤ[X]) else (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
noncomputable def Tpol (k : ℕ) : ℤ[X] :=
  (C (3:ℤ) * X + C (k : ℤ)) * ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
    (∏ τ ∈ Finset.range 157, (if (32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3 then (1 : ℤ[X]) else (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)))
noncomputable def Ppol (i : ℕ) : ℤ[X] := ∏ j ∈ Finset.range 32, (C (3:ℤ) * X + C ((32 + 3 * j + i : ℕ) : ℤ))

noncomputable def P1 : ℤ[X] :=
  C ((9841903960093729833633136498000764773027302941658595463707981234687199216787814840628237281701897616959761442406400000000000000 : ℤ)) *
    ((∏ r ∈ Finset.range 62, (Polynomial.X + C (((r : ℤ) + 1)))) *
    (∑ i ∈ Finset.range 64, C ((Lc) * (-1 : ℤ) ^ i * (Nat.choose 63 i : ℤ)) * Qpol i))

noncomputable def P2 : ℤ[X] :=
  C ((31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 : ℤ)) *
    ((∑ j ∈ aIdx, C (cA j) * Rpol j) + (∑ k ∈ dIdx, C (cD k) * Tpol k))

/-! ## generic product lemmas -/

lemma prod_ite_one_eq {ι M : Type*} [CommMonoid M] (s : Finset ι) (p : ι → Prop)
    [DecidablePred p] (f : ι → M) :
    (∏ i ∈ s, (if p i then (1 : M) else f i)) = ∏ i ∈ s.filter (fun i => ¬ p i), f i := by
  rw [Finset.prod_ite]
  simp

lemma Sf_subset (i : ℕ) (hi : i < 64) : Sf i ⊆ Finset.range 157 := by
  intro τ hτ
  simp only [Sf, Finset.mem_image, Finset.mem_range] at hτ ⊢
  obtain ⟨j, hj, rfl⟩ := hτ
  omega

lemma Sf_card (i : ℕ) : (Sf i).card = 32 := by
  rw [Sf, Finset.card_image_of_injective]
  · simp
  · intro x y hxy
    have h : 3 * x + i = 3 * y + i := hxy
    omega

lemma prod_Sf_eq (i : ℕ) (F : ℕ → ℤ[X]) :
    ∏ τ ∈ Sf i, F τ = ∏ j ∈ Finset.range 32, F (3 * j + i) := by
  rw [Sf, Finset.prod_image]
  intro x _ y _ hxy
  have h : 3 * x + i = 3 * y + i := hxy
  omega

lemma Ppol_sq_eq (i : ℕ) :
    (Ppol i) ^ 2 = ∏ τ ∈ Sf i, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Ppol, prod_Sf_eq i (fun τ => (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)]
  rw [← Finset.prod_pow]
  apply Finset.prod_congr rfl
  intro j hj
  have h : (32 + (3 * j + i) : ℕ) = 32 + 3 * j + i := by omega
  rw [h]

lemma Qpol_eq (i : ℕ) (hi : i < 64) :
    Qpol i = ∏ τ ∈ (Finset.range 157) \ Sf i, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Qpol, prod_ite_one_eq, Finset.sdiff_eq_filter]

lemma prod_range_split (i : ℕ) (hi : i < 64) (F : ℕ → ℤ[X]) :
    (∏ τ ∈ Finset.range 157, F τ) =
      (∏ τ ∈ Sf i, F τ) * (∏ τ ∈ (Finset.range 157) \ Sf i, F τ) := by
  rw [← Finset.prod_union (Finset.disjoint_sdiff), Finset.union_sdiff_of_subset (Sf_subset i hi)]

lemma Dpol_split (i : ℕ) (hi : i < 64) :
    Dpol = (∏ τ ∈ Sf i, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2) *
      (∏ τ ∈ (Finset.range 157) \ Sf i, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2) := by
  unfold Dpol
  exact prod_range_split i hi _

lemma Dpol_eq_Ppol_sq_mul_Qpol (i : ℕ) (hi : i < 64) : Dpol = Ppol i ^ 2 * Qpol i := by
  rw [Dpol_split i hi, ← Ppol_sq_eq i, ← Qpol_eq i hi]

lemma Rpol_eq (j : ℕ) :
    Rpol j = ∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = j)),
      (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Rpol, prod_ite_one_eq]

lemma prod_filter_step (j : ℕ) :
    (∏ τ ∈ Finset.range 157, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ τ ∈ (Finset.range 157).filter (fun τ => (32 + τ : ℕ) = j),
            (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
        * (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = j)),
            (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2) :=
  (Finset.prod_filter_mul_prod_filter_not (Finset.range 157) (fun τ => (32 + τ : ℕ) = j) _).symm

lemma filter_eq_singleton (j : ℕ) (h1 : 32 ≤ j) (h2 : j ≤ 188) :
    (Finset.range 157).filter (fun τ => (32 + τ : ℕ) = j) = {j - 32} := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_singleton]
  constructor
  · rintro ⟨hlt, hj⟩; omega
  · rintro rfl; constructor <;> omega

lemma Dpol_eq_sq_mul_Rpol (j : ℕ) (h1 : 32 ≤ j) (h2 : j ≤ 188) :
    Dpol = (C (3:ℤ) * X + C (j : ℤ)) ^ 2 * Rpol j := by
  rw [Dpol, prod_filter_step j, Rpol_eq j, filter_eq_singleton j h1 h2, Finset.prod_singleton]
  have e : ((32 + (j - 32) : ℕ) : ℤ) = (j : ℤ) := by omega
  rw [e]

lemma prod_filter_step2 (k : ℕ) :
    (∏ τ ∈ Finset.range 157, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ τ ∈ (Finset.range 157).filter (fun τ => ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
            (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
        * (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
            (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2) :=
  (Finset.prod_filter_mul_prod_filter_not (Finset.range 157)
    (fun τ => ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)) _).symm

lemma filter_eq_pair (k : ℕ) (h1 : 32 ≤ k) (h2 : k ≤ 185) :
    (Finset.range 157).filter (fun τ => ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)) = {k - 32, k - 29} := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hlt, hk | hk⟩
    · left; omega
    · right; omega
  · rintro (rfl | rfl) <;> constructor <;> omega

lemma Dpol_eq_lin_mul_Tpol (k : ℕ) (h1 : 32 ≤ k) (h2 : k ≤ 185) :
    Dpol = (C (3:ℤ) * X + C (k : ℤ)) * (C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) * Tpol k := by
  have hne : k - 32 ∉ ({k - 29} : Finset ℕ) := by
    simp only [Finset.mem_singleton]; omega
  rw [Tpol, prod_ite_one_eq, Dpol, prod_filter_step2 k, filter_eq_pair k h1 h2,
    Finset.prod_insert hne, Finset.prod_singleton]
  have e1 : ((32 + (k - 32) : ℕ) : ℤ) = (k : ℤ) := by omega
  have e2 : ((32 + (k - 29) : ℕ) : ℤ) = ((k + 3 : ℕ) : ℤ) := by omega
  rw [e1, e2]
  ring

/-! ## degree bounds -/

lemma natDegree_lin_le (c : ℤ) : (C (3:ℤ) * X + C c).natDegree ≤ 1 := by
  calc (C (3:ℤ) * X + C c).natDegree ≤ max (C (3:ℤ) * X).natDegree (C c).natDegree :=
        Polynomial.natDegree_add_le _ _
    _ ≤ max 1 0 := by
        apply max_le
        · calc (C (3:ℤ) * X).natDegree ≤ X.natDegree := Polynomial.natDegree_C_mul_le _ _
            _ = 1 := Polynomial.natDegree_X
        · rw [Polynomial.natDegree_C]; norm_num
    _ = 1 := by norm_num

lemma natDegree_sq_lin_le (c : ℤ) : ((C (3:ℤ) * X + C c) ^ 2).natDegree ≤ 2 := by
  calc ((C (3:ℤ) * X + C c) ^ 2).natDegree ≤ 2 * (C (3:ℤ) * X + C c).natDegree :=
        Polynomial.natDegree_pow_le
    _ ≤ 2 * 1 := by gcongr; exact natDegree_lin_le c
    _ = 2 := by norm_num

lemma natDegree_prod_sq_le_card (s : Finset ℕ) :
    (∏ τ ∈ s, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤ 2 * s.card := by
  have h1 : (∏ τ ∈ s, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤
      ∑ τ ∈ s, ((C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2).natDegree :=
    Polynomial.natDegree_prod_le s (fun τ => (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)
  have h2 : (∑ τ ∈ s, ((C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2).natDegree) ≤ ∑ _τ ∈ s, 2 :=
    Finset.sum_le_sum (fun τ _ => natDegree_sq_lin_le _)
  have h3 : (∑ _τ ∈ s, (2 : ℕ)) = 2 * s.card := by
    rw [Finset.sum_const, smul_eq_mul, mul_comm]
  linarith

lemma natDegree_prod_sq_le_314 (s : Finset ℕ) (h : s.card ≤ 157) :
    (∏ τ ∈ s, (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤ 314 :=
  le_trans (natDegree_prod_sq_le_card s) (by omega)

lemma natDegree_sum_le' {ι : Type*} (s : Finset ι) (f : ι → ℤ[X]) (n : ℕ)
    (h : ∀ i ∈ s, (f i).natDegree ≤ n) : (∑ i ∈ s, f i).natDegree ≤ n := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      refine le_trans (Polynomial.natDegree_add_le _ _) (max_le ?_ ?_)
      · exact h a (Finset.mem_insert_self a s)
      · exact ih (fun i hi => h i (Finset.mem_insert_of_mem hi))

lemma filter_card_le (p : ℕ → Prop) [DecidablePred p] :
    ((Finset.range 157).filter p).card ≤ 157 := by
  have h := Finset.card_le_card (Finset.filter_subset p (Finset.range 157))
  rwa [Finset.card_range] at h

lemma card_sdiff_le (s : Finset ℕ) : ((Finset.range 157) \ s).card ≤ 157 := by
  have h := Finset.card_le_card (Finset.sdiff_subset (s := Finset.range 157) (t := s))
  rwa [Finset.card_range] at h

lemma natDegree_Qpol_le (i : ℕ) (hi : i < 64) : (Qpol i).natDegree ≤ 314 := by
  rw [Qpol_eq i hi]
  exact natDegree_prod_sq_le_314 _ (card_sdiff_le _)

lemma natDegree_Rpol_le (j : ℕ) : (Rpol j).natDegree ≤ 314 := by
  rw [Rpol_eq j]
  exact natDegree_prod_sq_le_314 _ (filter_card_le _)

lemma Tpol_eq' (k : ℕ) :
    Tpol k = (C (3:ℤ) * X + C (k : ℤ)) * ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
      (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)) := by
  rw [Tpol, prod_ite_one_eq]

lemma natDegree_Tpol_le (k : ℕ) : (Tpol k).natDegree ≤ 316 := by
  have h1 : (Tpol k).natDegree ≤ (C (3:ℤ) * X + C (k : ℤ)).natDegree +
      ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
        (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
          (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)).natDegree := by
    rw [Tpol_eq' k]
    exact Polynomial.natDegree_mul_le
  have h2 : ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
      (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2)).natDegree ≤ 1 + 314 := by
    have hm := Polynomial.natDegree_mul_le (p := (C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)))
      (q := (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2))
    have ha : (C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)).natDegree ≤ 1 := natDegree_lin_le _
    have hb : (∏ τ ∈ (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)),
        (C (3:ℤ) * X + C ((32 + τ : ℕ) : ℤ)) ^ 2).natDegree ≤ 314 :=
      natDegree_prod_sq_le_314 _ (filter_card_le _)
    linarith
  have h3 : (C (3:ℤ) * X + C (k : ℤ)).natDegree ≤ 1 := natDegree_lin_le _
  linarith

