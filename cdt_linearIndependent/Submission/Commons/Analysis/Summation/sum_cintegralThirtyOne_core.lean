def Df (m : ℕ) : ℤ := (Dpol).eval (m : ℤ)
def Pf (i : ℕ) (m : ℕ) : ℤ := (Ppol i).eval (m : ℤ)
def Qf (i : ℕ) (m : ℕ) : ℤ := (Qpol i).eval (m : ℤ)
def Rf (j : ℕ) (m : ℕ) : ℤ := (Rpol j).eval (m : ℤ)
def Tf (k : ℕ) (m : ℕ) : ℤ := (Tpol k).eval (m : ℤ)

lemma Pf_pos (i m : ℕ) (hi : i < 64) : 0 < Pf i m := by
  rw [Pf, Ppol, Polynomial.eval_prod]
  apply Finset.prod_pos
  intro j hj
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  positivity

lemma Df_pos (m : ℕ) : 0 < Df m := by
  rw [Df, Dpol, Polynomial.eval_prod]
  apply Finset.prod_pos
  intro τ hτ
  simp only [Polynomial.eval_pow, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_X]
  positivity

lemma Df_eq_Pf_sq_mul_Qf (i m : ℕ) (hi : i < 64) : Df m = (Pf i m) ^ 2 * Qf i m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_Ppol_sq_mul_Qpol i hi)
  simpa [Df, Pf, Qf, Polynomial.eval_mul, Polynomial.eval_pow] using h

lemma Df_eq_sq_mul_Rf (j m : ℕ) (h1 : 32 ≤ j) (h2 : j ≤ 188) :
    Df m = (3 * (m : ℤ) + (j : ℤ)) ^ 2 * Rf j m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_sq_mul_Rpol j h1 h2)
  simpa [Df, Rf, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat] using h

lemma Df_eq_lin_mul_Tf (k m : ℕ) (h1 : 32 ≤ k) (h2 : k ≤ 185) :
    Df m = (3 * (m : ℤ) + (k : ℤ)) * (3 * (m : ℤ) + ((k + 3 : ℕ) : ℤ)) * Tf k m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_lin_mul_Tpol k h1 h2)
  simpa [Df, Tf, Polynomial.eval_mul, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat] using h


/-! ## real-valued definitions -/

noncomputable def cThirtyOnePf (i : ℕ) (m : ℕ) : ℝ := ∏ j ∈ Finset.range 32, xm m (32 + 3 * j + i)

noncomputable def Vm31 (m : ℕ) : ℝ := (381520424476945831628649898809 : ℝ) * (Nat.choose (m + 62) 62 : ℝ) *
  (∑ i ∈ Finset.range 64, ((-1 : ℝ) ^ i * (Nat.choose 63 i : ℝ)) *
    (5079028678620997542388296070425860883087360000000 / cThirtyOnePf i m) ^ 2)

noncomputable def aj (j : ℕ) : ℝ := (cA j : ℝ) / (Lc : ℝ)
noncomputable def dj (k : ℕ) : ℝ := (cD k : ℝ) / (3 * (Lc : ℝ))

noncomputable def W131 (m : ℕ) : ℝ := ∑ j ∈ aIdx, aj j / (xm m j) ^ 2
noncomputable def W231 (m : ℕ) : ℝ := ∑ k ∈ dIdx, dj k * (1 / xm m k - 1 / xm m (k + 3))
noncomputable def Vd31 (m : ℕ) : ℝ := W131 m + W231 m

lemma cThirtyOnePf_eq (i m : ℕ) : cThirtyOnePf i m = ((Pf i m : ℤ) : ℝ) := by
  have h : ((Pf i m : ℤ) : ℝ) = ∏ j ∈ Finset.range 32,
      ((3 : ℝ) * (m : ℝ) + ((32 + 3 * j + i : ℕ) : ℝ)) := by
    rw [Pf, Ppol, Polynomial.eval_prod]
    push_cast
    apply Finset.prod_congr rfl
    intro j hj
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
    push_cast
    ring
  rw [h, cThirtyOnePf]
  apply Finset.prod_congr rfl
  intro j hj
  rw [xm_eq]

lemma eval_prodP (m : ℕ) :
    Polynomial.eval (m : ℤ) (∏ r ∈ Finset.range 62, (Polynomial.X + C ((r : ℤ) + 1))) =
      ∏ r ∈ Finset.range 62, ((m : ℤ) + (r + 1)) := by
  rw [Polynomial.eval_prod]
  apply Finset.prod_congr rfl
  intro r hr
  simp [Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_X]

lemma eval_sumP (m : ℕ) :
    Polynomial.eval (m : ℤ) (∑ i ∈ Finset.range 64,
        C ((Lc) * (-1 : ℤ) ^ i * (Nat.choose 63 i : ℤ)) * Qpol i) =
      ∑ i ∈ Finset.range 64, (Lc) * (-1 : ℤ) ^ i * (Nat.choose 63 i : ℤ) * (Qf i m) := by
  rw [Polynomial.eval_finsetSum]
  apply Finset.sum_congr rfl
  intro i hi
  simp [Polynomial.eval_mul, Polynomial.eval_C, Qf]

lemma eval_P1_int (m : ℕ) :
    P1.eval (m : ℤ) = (381520424476945831628649898809 * 5079028678620997542388296070425860883087360000000 ^ 2) *
      (∏ r ∈ Finset.range 62, ((m : ℤ) + (r + 1))) *
      (∑ i ∈ Finset.range 64, (Lc) * (-1 : ℤ) ^ i * (Nat.choose 63 i : ℤ) * (Qf i m)) := by
  rw [P1, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C, eval_prodP m, eval_sumP m]
  ring

lemma eval_P1 (m : ℕ) :
    ((P1.eval (m : ℤ) : ℤ) : ℝ) = (381520424476945831628649898809 : ℝ) * (5079028678620997542388296070425860883087360000000 : ℝ) ^ 2 *
      (∏ r ∈ Finset.range 62, ((m : ℝ) + (r + 1))) *
      (∑ i ∈ Finset.range 64, (Lc : ℝ) * (-1 : ℝ) ^ i * (Nat.choose 63 i : ℝ) * ((Qf i m : ℤ) : ℝ)) := by
  rw [eval_P1_int m]
  push_cast
  ring

lemma eval_P2_int (m : ℕ) :
    P2.eval (m : ℤ) = 31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 *
      ((∑ j ∈ aIdx, cA j * Rf j m) + (∑ k ∈ dIdx, cD k * Tf k m)) := by
  rw [P2, Polynomial.eval_mul, Polynomial.eval_C]
  congr 1
  rw [Polynomial.eval_add, Polynomial.eval_finsetSum, Polynomial.eval_finsetSum]
  congr 1
  · apply Finset.sum_congr rfl
    intro j hj
    simp [Polynomial.eval_mul, Polynomial.eval_C, Rf]
  · apply Finset.sum_congr rfl
    intro k hk
    simp [Polynomial.eval_mul, Polynomial.eval_C, Tf]

lemma eval_P2 (m : ℕ) :
    ((P2.eval (m : ℤ) : ℤ) : ℝ) = (31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 : ℝ) *
      ((∑ j ∈ aIdx, (cA j : ℝ) * ((Rf j m : ℤ) : ℝ)) +
        (∑ k ∈ dIdx, (cD k : ℝ) * ((Tf k m : ℤ) : ℝ))) := by
  rw [eval_P2_int m]
  push_cast
  ring


/-! ## the factorial identity -/

lemma choose_fact_nat (m : ℕ) :
    (m + 62).choose 62 * (62 !) = ∏ r ∈ Finset.range 62, (m + r + 1) := by
  have h2 : (m + 1).ascFactorial 62 = 62 ! * (m + 62).choose 62 := by
    simpa using Nat.ascFactorial_eq_factorial_mul_choose m 62
  have h1 : (m + 1).ascFactorial 62 = ∏ i ∈ Finset.range 62, (m + 1 + i) :=
    Nat.ascFactorial_eq_prod_range (m + 1) 62
  rw [h2, Nat.mul_comm] at h1
  rw [h1]
  apply Finset.prod_congr rfl
  intro r hr
  omega

lemma choose_fact (m : ℕ) :
    (Nat.choose (m + 62) 62 : ℝ) * 31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 = ∏ r ∈ Finset.range 62, ((m : ℝ) + (r + 1)) := by
  have h : ((m + 62).choose 62 : ℝ) * ((62 ! : ℕ) : ℝ) =
      ((∏ r ∈ Finset.range 62, (m + r + 1) : ℕ) : ℝ) := by
    exact_mod_cast choose_fact_nat m
  have h24 : ((62 ! : ℕ) : ℝ) = 31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 := by norm_num
  rw [h24] at h
  rw [h]
  push_cast
  apply Finset.prod_congr rfl
  intro r hr
  ring


/-! ## the two clearing identities -/

lemma clear_left (m : ℕ) :
    Vm31 m * ((Df m : ℤ) : ℝ) * 31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 * (Lc : ℝ) =
