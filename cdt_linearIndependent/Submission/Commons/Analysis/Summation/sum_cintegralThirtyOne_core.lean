    natDegree_sum_le' _ _ 316 (fun k _ =>
      le_trans (Polynomial.natDegree_C_mul_le _ _) (natDegree_Tpol_le k))
  have h2 : ((∑ j ∈ aIdx, C (cA j) * Rpol j) + (∑ k ∈ dIdx, C (cD k) * Tpol k)).natDegree ≤
      316 := by
    refine le_trans (Polynomial.natDegree_add_le _ _) (max_le (le_trans hR (by norm_num)) hT)
  have h3 : (C ((31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 : ℤ))).natDegree = 0 := Polynomial.natDegree_C _
  rw [h3] at h1
  linarith

lemma degree_bound : max P1.natDegree P2.natDegree < 377 := by
  rw [max_lt_iff]
  constructor
  · exact lt_of_le_of_lt natDegree_P1_le (by norm_num)
  · exact lt_of_le_of_lt natDegree_P2_le (by norm_num)

/-! ## evaluation of the polynomials (integer form) -/

def EvP1 (c : ℤ) : ℤ := (381520424476945831628649898809 * 5079028678620997542388296070425860883087360000000 ^ 2) *
  ((∏ r ∈ Finset.range 62, (c + ((r : ℤ) + 1))) *
   (∑ i ∈ Finset.range 64, (Lc * wB i) *
     (∏ τ ∈ Finset.range 157, (if τ ∈ Sf i then 1 else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2))))

def EvP2 (c : ℤ) : ℤ := 31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 *
  ((∑ j ∈ aIdx, cA j * (∏ τ ∈ Finset.range 157, (if (32 + τ : ℕ) = j then 1 else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2)))
   + (∑ k ∈ dIdx, cD k * ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) * (∏ τ ∈ Finset.range 157, (if (32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3 then 1 else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2)))))

lemma eval_ite (p : Prop) [Decidable p] (x : ℤ) (a b : ℤ[X]) :
    Polynomial.eval x (if p then a else b) = if p then Polynomial.eval x a else Polynomial.eval x b := by
  split <;> rfl

lemma eval_P1_EvP1 (c : ℤ) : P1.eval c = EvP1 c := by
  rw [P1, EvP1]
  simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_C,
    Polynomial.eval_X, Polynomial.eval_prod, Polynomial.eval_finsetSum, Polynomial.eval_one, Qpol,
    eval_ite]
  rw [wB_sum (f := fun i => ∏ τ ∈ Finset.range 157,
    (if τ ∈ Sf i then (1 : ℤ) else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2))]
  ring

lemma eval_P2_EvP2 (c : ℤ) : P2.eval c = EvP2 c := by
  rw [P2, EvP2]
  simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_C,
    Polynomial.eval_X, Polynomial.eval_prod, Polynomial.eval_finsetSum, Polynomial.eval_one, Rpol, Tpol,
    eval_ite]
  ring

/-! ## Cheap evaluation

The kernel evaluation of `EvP1`/`EvP2` recomputes all the 72-factor products, which is
prohibitively slow.  We introduce the single common product `Pall c` and rewrite
`EvP1`/`EvP2` in terms of it (dividing out the factors that are absent), so that each
`decide` only has to compute `Pall c` once and perform divisions by small factors. -/

def Pall (c : ℤ) : ℤ := ∏ τ ∈ Finset.range 157, (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2

def goD (c : ℤ) (i n : ℕ) : ℤ :=
  Nat.rec 1 (fun m ih => ih * (3 * c + ((32 + (3 * m + i) : ℕ) : ℤ)) ^ 2) n

lemma goD_eq (c : ℤ) (i : ℕ) : ∀ n, goD c i n = ∏ j ∈ Finset.range n, (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2 := by
  intro n
  induction n with
  | zero => simp [goD]
  | succ n ih =>
      have h : goD c i (n + 1) = goD c i n * (3 * c + ((32 + (3 * n + i) : ℕ) : ℤ)) ^ 2 := rfl
      rw [h, ih, Finset.prod_range_succ]

lemma prod_Sf_eqZ (i : ℕ) (F : ℕ → ℤ) :
    ∏ τ ∈ Sf i, F τ = ∏ j ∈ Finset.range 32, F (3 * j + i) := by
  rw [Sf, Finset.prod_image]
  intro x _ y _ hxy
  have h : 3 * x + i = 3 * y + i := hxy
  omega

lemma prod_range_splitZ (i : ℕ) (hi : i < 64) (F : ℕ → ℤ) :
    (∏ τ ∈ Finset.range 157, F τ) =
      (∏ τ ∈ Sf i, F τ) * (∏ τ ∈ (Finset.range 157) \ Sf i, F τ) := by
  rw [← Finset.prod_union (Finset.disjoint_sdiff), Finset.union_sdiff_of_subset (Sf_subset i hi)]

lemma sqf_ne_zero {c : ℤ} (hc : 0 ≤ c) {t : ℕ} (ht : 0 < t) : (3 * c + (t : ℤ)) ^ 2 ≠ 0 := by
  refine pow_ne_zero 2 ?_
  have h1 : (0 : ℤ) ≤ 3 * c := by linarith
  have h2 : (0 : ℤ) < (t : ℤ) := by exact_mod_cast ht
  linarith

lemma prod_erase_eq_div (s : Finset ℕ) (a : ℕ) (ha : a ∈ s) (g : ℕ → ℤ) (hg : g a ≠ 0) :
    (∏ x ∈ s.erase a, g x) = (∏ x ∈ s, g x) / g a := by
  have h := Finset.prod_erase_mul s g ha
  rw [← h]
  exact (Int.mul_ediv_cancel _ hg).symm

lemma prod_erase_pair_eq_div (s : Finset ℕ) (a b : ℕ) (ha : a ∈ s) (hb : b ∈ s.erase a)
    (g : ℕ → ℤ) (ha' : g a ≠ 0) (hb' : g b ≠ 0) :
    (∏ x ∈ (s.erase a).erase b, g x) = (∏ x ∈ s, g x) / (g a * g b) := by
  have hP : (∏ x ∈ s, g x) = (g a * g b) * (∏ x ∈ (s.erase a).erase b, g x) := by
    rw [← Finset.prod_erase_mul s g ha, ← Finset.prod_erase_mul (s.erase a) g hb]
    ring
  rw [hP]
  exact (Int.mul_ediv_cancel_left _ (mul_ne_zero ha' hb')).symm

lemma filter_not_eq_erase (j : ℕ) (h1 : 32 ≤ j) (h2 : j ≤ 188) :
    (Finset.range 157).filter (fun τ => ¬ ((32 + τ : ℕ) = j)) =
      (Finset.range 157).erase (j - 32) := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_erase]
  constructor
  · rintro ⟨hlt, hne⟩
    exact ⟨fun h => hne (by omega), hlt⟩
  · rintro ⟨hne, hlt⟩
    exact ⟨hlt, fun h => hne (by omega)⟩

lemma filter_not_pair_eq_erase (k : ℕ) (h1 : 32 ≤ k) (h2 : k ≤ 185) :
    (Finset.range 157).filter
        (fun τ => ¬ ((32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3)) =
      ((Finset.range 157).erase (k - 32)).erase (k - 29) := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_erase]
  constructor
  · rintro ⟨hlt, hne⟩
    refine ⟨?_, ?_, hlt⟩
    · intro h; exact hne (Or.inr (by omega))
    · intro h; exact hne (Or.inl (by omega))
  · rintro ⟨hne1, hne2, hlt⟩
    refine ⟨hlt, ?_⟩
    rintro (h | h)
    · exact hne2 (by omega)
    · exact hne1 (by omega)

lemma prod_ite_eq_div {c : ℤ} (hc : 0 ≤ c) (j : ℕ) (h1 : 32 ≤ j) (h2 : j ≤ 188) :
    (∏ τ ∈ Finset.range 157,
        (if (32 + τ : ℕ) = j then (1 : ℤ)
          else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2))
      = Pall c / (3 * c + ((32 + (j - 32) : ℕ) : ℤ)) ^ 2 := by
  have hmem : j - 32 ∈ Finset.range 157 := by
    simp only [Finset.mem_range]; omega
  have hne : (3 * c + ((32 + (j - 32) : ℕ) : ℤ)) ^ 2 ≠ 0 := by
    have hj : (32 + (j - 32) : ℕ) = j := by omega
    rw [hj]; exact sqf_ne_zero hc (by omega : 0 < j)
  rw [prod_ite_one_eq, filter_not_eq_erase j h1 h2, Pall]
  exact prod_erase_eq_div _ _ hmem _ hne

lemma prod_ite_pair_eq_div {c : ℤ} (hc : 0 ≤ c) (k : ℕ) (h1 : 32 ≤ k)
    (h2 : k ≤ 185) :
    (∏ τ ∈ Finset.range 157,
        (if (32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3 then (1 : ℤ)
          else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2))
      = Pall c / ((3 * c + ((32 + (k - 32) : ℕ) : ℤ)) ^ 2 *
          (3 * c + ((32 + (k - 29) : ℕ) : ℤ)) ^ 2) := by
  have hmem1 : k - 32 ∈ Finset.range 157 := by
    simp only [Finset.mem_range]; omega
  have hmem2 : k - 29 ∈ (Finset.range 157).erase (k - 32) := by
    simp only [Finset.mem_erase, Finset.mem_range]
    constructor
    · omega
    · omega
  have hne1 : (3 * c + ((32 + (k - 32) : ℕ) : ℤ)) ^ 2 ≠ 0 := by
    have hk : (32 + (k - 32) : ℕ) = k := by omega
    rw [hk]; exact sqf_ne_zero hc (by omega : 0 < k)
  have hne2 : (3 * c + ((32 + (k - 29) : ℕ) : ℤ)) ^ 2 ≠ 0 := by
    have hk : (32 + (k - 29) : ℕ) = k + 3 := by omega
    rw [hk]; exact sqf_ne_zero hc (by omega : 0 < k + 3)
  rw [prod_ite_one_eq, filter_not_pair_eq_erase k h1 h2, Pall]
  exact prod_erase_pair_eq_div _ _ _ hmem1 hmem2 _ hne1 hne2

lemma prod_ite_Sf_eq_div {c : ℤ} (hc : 0 ≤ c) (i : ℕ) (hi : i < 64) :
    (∏ τ ∈ Finset.range 157,
        (if τ ∈ Sf i then (1 : ℤ) else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2))
      = Pall c / (∏ j ∈ Finset.range 32,
          (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2) := by
  have hSf : (∏ τ ∈ Sf i, (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ j ∈ Finset.range 32, (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2) :=
    prod_Sf_eqZ i _
  have hne : (∏ j ∈ Finset.range 32,
      (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2) ≠ 0 := by
    rw [← hSf]
    exact Finset.prod_ne_zero_iff.mpr (fun τ _ => sqf_ne_zero hc (by omega : 0 < 32 + τ))
  have hsplit : Pall c =
      (∏ j ∈ Finset.range 32, (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2) *
        (∏ τ ∈ (Finset.range 157) \ Sf i,
          (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2) := by
    rw [Pall, prod_range_splitZ i hi, hSf]
  rw [prod_ite_one_eq, ← Finset.sdiff_eq_filter, hsplit,
    Int.mul_ediv_cancel_left _ hne]

def EvP1cheap (c : ℤ) : ℤ :=
  (381520424476945831628649898809 * 5079028678620997542388296070425860883087360000000 ^ 2) *
    ((∏ r ∈ Finset.range 62, (c + ((r : ℤ) + 1))) *
     (∑ i ∈ Finset.range 64, (Lc * wB i) * (Pall c / goD c i 32)))

lemma EvP1_goD (c : ℤ) :
    (∑ i ∈ Finset.range 64, (Lc * wB i) * (Pall c / goD c i 32)) =
      (∑ i ∈ Finset.range 64, (Lc * wB i) *
        (Pall c / (∏ j ∈ Finset.range 32, (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2))) := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [goD_eq c i]

def EvP2cheap (c : ℤ) : ℤ :=
  (31469973260387937525653122354950764088012280797258232192163168247821107200000000000000) *
    ((∑ j ∈ aIdx, cA j * (Pall c / (3 * c + ((32 + (j - 32) : ℕ) : ℤ)) ^ 2))
     + (∑ k ∈ dIdx, cD k *
          ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) *
            (Pall c / ((3 * c + ((32 + (k - 32) : ℕ) : ℤ)) ^ 2 *
              (3 * c + ((32 + (k - 29) : ℕ) : ℤ)) ^ 2)))))

lemma EvP1_sum_eq {c : ℤ} (hc : 0 ≤ c) :
    (∑ i ∈ Finset.range 64, (Lc * wB i) *
        (∏ τ ∈ Finset.range 157,
          (if τ ∈ Sf i then (1 : ℤ) else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2)))
      = (∑ i ∈ Finset.range 64, (Lc * wB i) *
        (Pall c / (∏ j ∈ Finset.range 32,
          (3 * c + ((32 + (3 * j + i) : ℕ) : ℤ)) ^ 2))) := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  rw [prod_ite_Sf_eq_div hc i hi]

lemma EvP2_sum1_eq {c : ℤ} (hc : 0 ≤ c) :
    (∑ j ∈ aIdx, cA j *
        (∏ τ ∈ Finset.range 157,
          (if (32 + τ : ℕ) = j then (1 : ℤ)
            else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2)))
      = (∑ j ∈ aIdx, cA j *
        (Pall c / (3 * c + ((32 + (j - 32) : ℕ) : ℤ)) ^ 2)) := by
  apply Finset.sum_congr rfl
  intro j hj
  obtain ⟨h1, h2⟩ := aIdx_bounds j hj
  rw [prod_ite_eq_div hc j h1 h2]

lemma EvP2_sum2_eq {c : ℤ} (hc : 0 ≤ c) :
    (∑ k ∈ dIdx, cD k *
        ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) *
          (∏ τ ∈ Finset.range 157,
            (if (32 + τ : ℕ) = k ∨ (32 + τ : ℕ) = k + 3 then (1 : ℤ)
              else (3 * c + ((32 + τ : ℕ) : ℤ)) ^ 2))))
      = (∑ k ∈ dIdx, cD k *
          ((3 * c + (k : ℤ)) * (3 * c + ((k + 3 : ℕ) : ℤ)) *
            (Pall c / ((3 * c + ((32 + (k - 32) : ℕ) : ℤ)) ^ 2 *
              (3 * c + ((32 + (k - 29) : ℕ) : ℤ)) ^ 2)))) := by
  apply Finset.sum_congr rfl
  intro k hk
  obtain ⟨h1, h2⟩ := dIdx_bounds k hk
  rw [prod_ite_pair_eq_div hc k h1 h2]

lemma EvP1_eq_cheap {c : ℤ} (hc : 0 ≤ c) : EvP1 c = EvP1cheap c := by
  rw [EvP1, EvP1cheap, EvP1_goD c, EvP1_sum_eq hc]

lemma EvP2_eq_cheap {c : ℤ} (hc : 0 ≤ c) : EvP2 c = EvP2cheap c := by
  rw [EvP2, EvP2cheap, EvP2_sum1_eq hc, EvP2_sum2_eq hc]


