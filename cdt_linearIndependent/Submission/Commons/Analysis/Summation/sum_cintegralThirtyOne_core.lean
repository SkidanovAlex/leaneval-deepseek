lemma natDegree_P2_le : P2.natDegree ≤ 316 := by
  have h1 : P2.natDegree ≤ (C ((31469973260387937525653122354950764088012280797258232192163168247821107200000000000000 : ℤ))).natDegree +
      ((∑ j ∈ aIdx, C (cA j) * Rpol j) + (∑ k ∈ dIdx, C (cD k) * Tpol k)).natDegree := by
    rw [P2]
