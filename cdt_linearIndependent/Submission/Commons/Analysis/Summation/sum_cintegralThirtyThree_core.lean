def Df (m : ℕ) : ℤ := (Dpol).eval (m : ℤ)
def Pf (i : ℕ) (m : ℕ) : ℤ := (Ppol i).eval (m : ℤ)
def Qf (i : ℕ) (m : ℕ) : ℤ := (Qpol i).eval (m : ℤ)
def Rf (j : ℕ) (m : ℕ) : ℤ := (Rpol j).eval (m : ℤ)
def Tf (k : ℕ) (m : ℕ) : ℤ := (Tpol k).eval (m : ℤ)

lemma Pf_pos (i m : ℕ) (hi : i < 68) : 0 < Pf i m := by
  rw [Pf, Ppol, Polynomial.eval_prod]
  apply Finset.prod_pos
  intro j hj
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  positivity

lemma Df_pos (m : ℕ) : 0 < Df m := by
  rw [Df, Dpol, Polynomial.eval_prod]
  apply Finset.prod_pos
  intro τ hτ
  simp only [Polynomial.eval_pow, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_X]
  positivity

lemma Df_eq_Pf_sq_mul_Qf (i m : ℕ) (hi : i < 68) : Df m = (Pf i m) ^ 2 * Qf i m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_Ppol_sq_mul_Qpol i hi)
  simpa [Df, Pf, Qf, Polynomial.eval_mul, Polynomial.eval_pow] using h

lemma Df_eq_sq_mul_Rf (j m : ℕ) (h1 : 34 ≤ j) (h2 : j ≤ 200) :
    Df m = (3 * (m : ℤ) + (j : ℤ)) ^ 2 * Rf j m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_sq_mul_Rpol j h1 h2)
  simpa [Df, Rf, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat] using h

lemma Df_eq_lin_mul_Tf (k m : ℕ) (h1 : 34 ≤ k) (h2 : k ≤ 197) :
    Df m = (3 * (m : ℤ) + (k : ℤ)) * (3 * (m : ℤ) + ((k + 3 : ℕ) : ℤ)) * Tf k m := by
  have h := congrArg (Polynomial.eval (m : ℤ)) (Dpol_eq_lin_mul_Tpol k h1 h2)
  simpa [Df, Tf, Polynomial.eval_mul, Polynomial.eval_add,
    Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_ofNat] using h


/-! ## real-valued definitions -/

noncomputable def cThirtyThreePf (i : ℕ) (m : ℕ) : ℝ := ∏ j ∈ Finset.range 34, xm m (34 + 3 * j + i)

noncomputable def Vm33 (m : ℕ) : ℝ := (30903154382632612361920641803529 : ℝ) * (Nat.choose (m + 66) 66 : ℝ) *
  (∑ i ∈ Finset.range 68, ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) *
    (48271088561613960642858365853327381832862269440000000 / cThirtyThreePf i m) ^ 2)

noncomputable def aj (j : ℕ) : ℝ := (cA j : ℝ) / (Lc : ℝ)
noncomputable def dj (k : ℕ) : ℝ := (cD k : ℝ) / (3 * (Lc : ℝ))

noncomputable def W133 (m : ℕ) : ℝ := ∑ j ∈ aIdx, aj j / (xm m j) ^ 2
noncomputable def W233 (m : ℕ) : ℝ := ∑ k ∈ dIdx, dj k * (1 / xm m k - 1 / xm m (k + 3))
noncomputable def Vd33 (m : ℕ) : ℝ := W133 m + W233 m

lemma cThirtyThreePf_eq (i m : ℕ) : cThirtyThreePf i m = ((Pf i m : ℤ) : ℝ) := by
  have h : ((Pf i m : ℤ) : ℝ) = ∏ j ∈ Finset.range 34,
      ((3 : ℝ) * (m : ℝ) + ((34 + 3 * j + i : ℕ) : ℝ)) := by
    rw [Pf, Ppol, Polynomial.eval_prod]
    push_cast
    apply Finset.prod_congr rfl
    intro j hj
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
    push_cast
    ring
  rw [h, cThirtyThreePf]
  apply Finset.prod_congr rfl
  intro j hj
  rw [xm_eq]

lemma eval_prodP (m : ℕ) :
    Polynomial.eval (m : ℤ) (∏ r ∈ Finset.range 66, (Polynomial.X + C ((r : ℤ) + 1))) =
      ∏ r ∈ Finset.range 66, ((m : ℤ) + (r + 1)) := by
  rw [Polynomial.eval_prod]
  apply Finset.prod_congr rfl
  intro r hr
  simp [Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_X]

lemma eval_sumP (m : ℕ) :
    Polynomial.eval (m : ℤ) (∑ i ∈ Finset.range 68,
        C ((Lc) * (-1 : ℤ) ^ i * (Nat.choose 67 i : ℤ)) * Qpol i) =
      ∑ i ∈ Finset.range 68, (Lc) * (-1 : ℤ) ^ i * (Nat.choose 67 i : ℤ) * (Qf i m) := by
  rw [Polynomial.eval_finsetSum]
  apply Finset.sum_congr rfl
  intro i hi
  simp [Polynomial.eval_mul, Polynomial.eval_C, Qf]

lemma eval_P1_int (m : ℕ) :
    P1.eval (m : ℤ) = (30903154382632612361920641803529 * 48271088561613960642858365853327381832862269440000000 ^ 2) *
      (∏ r ∈ Finset.range 66, ((m : ℤ) + (r + 1))) *
      (∑ i ∈ Finset.range 68, (Lc) * (-1 : ℤ) ^ i * (Nat.choose 67 i : ℤ) * (Qf i m)) := by
  rw [P1, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C, eval_prodP m, eval_sumP m]
  ring

lemma eval_P1 (m : ℕ) :
    ((P1.eval (m : ℤ) : ℤ) : ℝ) = (30903154382632612361920641803529 : ℝ) * (48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 *
      (∏ r ∈ Finset.range 66, ((m : ℝ) + (r + 1))) *
      (∑ i ∈ Finset.range 68, (Lc : ℝ) * (-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ) * ((Qf i m : ℤ) : ℝ)) := by
  rw [eval_P1_int m]
  push_cast
  ring

lemma eval_P2_int (m : ℕ) :
    P2.eval (m : ℤ) = 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 *
      ((∑ j ∈ aIdx, cA j * Rf j m) + (∑ k ∈ dIdx, cD k * Tf k m)) := by
  rw [P2, Polynomial.eval_mul, Polynomial.eval_C]
  congr 1
  rw [Polynomial.eval_add, Polynomial.eval_finsetSum, Polynomial.eval_finsetSum]
  congr 1
  · apply Finset.sum_congr rfl
    intro j hj
    simp [Polynomial.eval_mul, Polynomial.eval_C, Rf]
  · apply Finset.sum_congr rfl
    intro k hk
    simp [Polynomial.eval_mul, Polynomial.eval_C, Tf]

lemma eval_P2 (m : ℕ) :
    ((P2.eval (m : ℤ) : ℤ) : ℝ) = (544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 : ℝ) *
      ((∑ j ∈ aIdx, (cA j : ℝ) * ((Rf j m : ℤ) : ℝ)) +
        (∑ k ∈ dIdx, (cD k : ℝ) * ((Tf k m : ℤ) : ℝ))) := by
  rw [eval_P2_int m]
  push_cast
  ring


/-! ## the factorial identity -/

lemma choose_fact_nat (m : ℕ) :
    (m + 66).choose 66 * (66 !) = ∏ r ∈ Finset.range 66, (m + r + 1) := by
  have h2 : (m + 1).ascFactorial 66 = 66 ! * (m + 66).choose 66 := by
    simpa using Nat.ascFactorial_eq_factorial_mul_choose m 66
  have h1 : (m + 1).ascFactorial 66 = ∏ i ∈ Finset.range 66, (m + 1 + i) :=
    Nat.ascFactorial_eq_prod_range (m + 1) 66
  rw [h2, Nat.mul_comm] at h1
  rw [h1]
  apply Finset.prod_congr rfl
  intro r hr
  omega

lemma choose_fact (m : ℕ) :
    (Nat.choose (m + 66) 66 : ℝ) * 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 = ∏ r ∈ Finset.range 66, ((m : ℝ) + (r + 1)) := by
  have h : ((m + 66).choose 66 : ℝ) * ((66 ! : ℕ) : ℝ) =
      ((∏ r ∈ Finset.range 66, (m + r + 1) : ℕ) : ℝ) := by
    exact_mod_cast choose_fact_nat m
  have h24 : ((66 ! : ℕ) : ℝ) = 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 := by norm_num
  rw [h24] at h
  rw [h]
  push_cast
  apply Finset.prod_congr rfl
  intro r hr
  ring


/-! ## the two clearing identities -/

lemma clear_left (m : ℕ) :
    Vm33 m * ((Df m : ℤ) : ℝ) * 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 * (Lc : ℝ) =
      ((P1.eval (m : ℤ) : ℤ) : ℝ) := by
  have hgoal : Vm33 m * ((Df m : ℤ) : ℝ) * 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 * (Lc : ℝ) =
      (30903154382632612361920641803529 : ℝ) * ((Nat.choose (m + 66) 66 : ℝ) * 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000) *
        ((∑ i ∈ Finset.range 68, ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) *
            (48271088561613960642858365853327381832862269440000000 / cThirtyThreePf i m) ^ 2) * ((Df m : ℤ) : ℝ)) * (Lc : ℝ) := by
    rw [Vm33]
    ring
  have hsum : (∑ i ∈ Finset.range 68, ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) *
        (48271088561613960642858365853327381832862269440000000 / cThirtyThreePf i m) ^ 2) * ((Df m : ℤ) : ℝ) =
      (48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 68,
        ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ)) := by
    rw [Finset.sum_mul, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    rw [cThirtyThreePf_eq i m]
    have hD : ((Df m : ℤ) : ℝ) = ((((Pf i m : ℤ)) : ℝ)) ^ 2 * ((Qf i m : ℤ) : ℝ) := by
      rw [Df_eq_Pf_sq_mul_Qf i m hi]
      simp only [Int.cast_mul, Int.cast_pow]
    rw [hD]
    have hne : (((Pf i m : ℤ)) : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt (Pf_pos i m hi))
    field_simp
    try ring
  have hLc2 : ((48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 68,
        ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ) =
      (48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 68,
        (Lc : ℝ) * ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ)) := by
    rw [show ((48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 68,
          ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ)
        = (48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * ((Lc : ℝ) * (∑ i ∈ Finset.range 68,
          ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) by ring]
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  rw [hgoal, choose_fact m, hsum, eval_P1 m]
  rw [show (30903154382632612361920641803529 : ℝ) * (∏ r ∈ Finset.range 66, ((m : ℝ) + (r + 1))) *
        ((48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 68,
          ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ)
      = (30903154382632612361920641803529 : ℝ) * (∏ r ∈ Finset.range 66, ((m : ℝ) + (r + 1))) *
        (((48271088561613960642858365853327381832862269440000000 : ℝ) ^ 2 * (∑ i ∈ Finset.range 68,
          ((-1 : ℝ) ^ i * (Nat.choose 67 i : ℝ)) * ((Qf i m : ℤ) : ℝ))) * (Lc : ℝ)) by ring]
  rw [hLc2]
  ring

lemma clear_right (m : ℕ) :
    Vd33 m * ((Df m : ℤ) : ℝ) * 544344939077443064003729240247842752644293064388798874532860126869671081148416000000000000000 * (Lc : ℝ) =
      ((P2.eval (m : ℤ) : ℤ) : ℝ) := by
  have hW1 : (∑ j ∈ aIdx, aj j / (xm m j) ^ 2) * ((Df m : ℤ) : ℝ) * (Lc : ℝ) =
      ∑ j ∈ aIdx, (cA j : ℝ) * ((Rf j m : ℤ) : ℝ) := by
    rw [Finset.sum_mul, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro j hj
    obtain ⟨hj1, hj2⟩ := aIdx_bounds j hj
    have hLc : (Lc : ℝ) ≠ 0 := by norm_num [Lc]
    have hD : ((Df m : ℤ) : ℝ) = (3 * (m : ℝ) + (j : ℝ)) ^ 2 * ((Rf j m : ℤ) : ℝ) := by
      rw [Df_eq_sq_mul_Rf j m hj1 hj2]
      simp only [Int.cast_mul, Int.cast_pow, Int.cast_add, Int.cast_ofNat, Int.cast_natCast]
    have h2 : (aj j) * (Lc : ℝ) = (cA j : ℝ) := by
      unfold aj
      field_simp
    rw [hD, xm_eq]
    have hne : 3 * (m : ℝ) + (j : ℝ) ≠ 0 := by positivity
    field_simp
    rw [← h2]
    ring
  have hW2 : (∑ k ∈ dIdx, dj k * (1 / xm m k - 1 / xm m (k + 3))) * ((Df m : ℤ) : ℝ) * (Lc : ℝ) =
      ∑ k ∈ dIdx, (cD k : ℝ) * ((Tf k m : ℤ) : ℝ) := by
    rw [Finset.sum_mul, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro k hk
    obtain ⟨hk1, hk2⟩ := dIdx_bounds k hk
    have hLc : (Lc : ℝ) ≠ 0 := by norm_num [Lc]
    have hD : ((Df m : ℤ) : ℝ) =
        (3 * (m : ℝ) + (k : ℝ)) * (3 * (m : ℝ) + ((k + 3 : ℕ) : ℝ)) * ((Tf k m : ℤ) : ℝ) := by
      rw [Df_eq_lin_mul_Tf k m hk1 hk2]
      simp only [Int.cast_mul, Int.cast_add, Int.cast_ofNat, Int.cast_natCast]
    have h2 : (dj k) * (3 * (Lc : ℝ)) = (cD k : ℝ) := by
      unfold dj
      field_simp
