  interval_cases i <;> decide

lemma wB_sum (f : ℕ → ℤ) :
    (∑ i ∈ Finset.range 68, (Lc * wB i) * f i) =
      (∑ i ∈ Finset.range 68, (Lc * (-1 : ℤ) ^ i * (Nat.choose 67 i : ℤ)) * f i) := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [wB_eq i (Finset.mem_range.mp hi)]
  ring

