/-! ## generic product lemmas -/

lemma prod_ite_one_eq {ι M : Type*} [CommMonoid M] (s : Finset ι) (p : ι → Prop)
    [DecidablePred p] (f : ι → M) :
    (∏ i ∈ s, (if p i then (1 : M) else f i)) = ∏ i ∈ s.filter (fun i => ¬ p i), f i := by
  rw [Finset.prod_ite]
  simp

lemma Sf_subset (i : ℕ) (hi : i < 70) : Sf i ⊆ Finset.range 172 := by
  intro τ hτ
  simp only [Sf, Finset.mem_image, Finset.mem_range] at hτ ⊢
  obtain ⟨j, hj, rfl⟩ := hτ
  omega

lemma Sf_card (i : ℕ) : (Sf i).card = 35 := by
  rw [Sf, Finset.card_image_of_injective]
  · simp
  · intro x y hxy
    have h : 3 * x + i = 3 * y + i := hxy
    omega

lemma prod_Sf_eq (i : ℕ) (F : ℕ → ℤ[X]) :
    ∏ τ ∈ Sf i, F τ = ∏ j ∈ Finset.range 35, F (3 * j + i) := by
  rw [Sf, Finset.prod_image]
  intro x _ y _ hxy
  have h : 3 * x + i = 3 * y + i := hxy
  omega

lemma Ppol_sq_eq (i : ℕ) :
    (Ppol i) ^ 2 = ∏ τ ∈ Sf i, (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Ppol, prod_Sf_eq i (fun τ => (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2)]
  rw [← Finset.prod_pow]
  apply Finset.prod_congr rfl
  intro j hj
  have h : (35 + (3 * j + i) : ℕ) = 35 + 3 * j + i := by omega
  rw [h]

lemma Qpol_eq (i : ℕ) (hi : i < 70) :
    Qpol i = ∏ τ ∈ (Finset.range 172) \ Sf i, (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Qpol, prod_ite_one_eq, Finset.sdiff_eq_filter]

lemma prod_range_split (i : ℕ) (hi : i < 70) (F : ℕ → ℤ[X]) :
    (∏ τ ∈ Finset.range 172, F τ) =
      (∏ τ ∈ Sf i, F τ) * (∏ τ ∈ (Finset.range 172) \ Sf i, F τ) := by
  rw [← Finset.prod_union (Finset.disjoint_sdiff), Finset.union_sdiff_of_subset (Sf_subset i hi)]

lemma Dpol_split (i : ℕ) (hi : i < 70) :
    Dpol = (∏ τ ∈ Sf i, (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2) *
      (∏ τ ∈ (Finset.range 172) \ Sf i, (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2) := by
  unfold Dpol
  exact prod_range_split i hi _

lemma Dpol_eq_Ppol_sq_mul_Qpol (i : ℕ) (hi : i < 70) : Dpol = Ppol i ^ 2 * Qpol i := by
  rw [Dpol_split i hi, ← Ppol_sq_eq i, ← Qpol_eq i hi]

lemma Rpol_eq (j : ℕ) :
    Rpol j = ∏ τ ∈ (Finset.range 172).filter (fun τ => ¬ ((35 + τ : ℕ) = j)),
      (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2 := by
  rw [Rpol, prod_ite_one_eq]

lemma prod_filter_step (j : ℕ) :
    (∏ τ ∈ Finset.range 172, (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2)
      = (∏ τ ∈ (Finset.range 172).filter (fun τ => (35 + τ : ℕ) = j),
            (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2)
        * (∏ τ ∈ (Finset.range 172).filter (fun τ => ¬ ((35 + τ : ℕ) = j)),
            (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2) :=
  (Finset.prod_filter_mul_prod_filter_not (Finset.range 172) (fun τ => (35 + τ : ℕ) = j) _).symm

lemma filter_eq_singleton (j : ℕ) (h1 : 35 ≤ j) (h2 : j ≤ 206) :
    (Finset.range 172).filter (fun τ => (35 + τ : ℕ) = j) = {j - 35} := by
  ext τ
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_singleton]
  constructor
  · rintro ⟨hlt, hj⟩; omega
  · rintro rfl; constructor <;> omega

lemma Dpol_eq_sq_mul_Rpol (j : ℕ) (h1 : 35 ≤ j) (h2 : j ≤ 206) :
    Dpol = (C (3:ℤ) * X + C (j : ℤ)) ^ 2 * Rpol j := by
  rw [Dpol, prod_filter_step j, Rpol_eq j, filter_eq_singleton j h1 h2, Finset.prod_singleton]
  have e : ((35 + (j - 35) : ℕ) : ℤ) = (j : ℤ) := by omega
  rw [e]

