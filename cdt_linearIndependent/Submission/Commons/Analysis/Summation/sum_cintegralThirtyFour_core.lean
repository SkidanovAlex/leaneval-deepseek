      (∑ i ∈ Finset.range 70, (Lc * (-1 : ℤ) ^ i * (Nat.choose 69 i : ℤ)) * f i) := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [wB_eq i (Finset.mem_range.mp hi)]
  ring

