def Sf (i : ℕ) : Finset ℕ := (Finset.range 35).image (fun j => 3 * j + i)

/-! ## polynomials -/

noncomputable def Dpol : ℤ[X] := ∏ τ ∈ Finset.range 172, (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2
noncomputable def Qpol (i : ℕ) : ℤ[X] := ∏ τ ∈ Finset.range 172, (if τ ∈ Sf i then (1 : ℤ[X]) else (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2)
noncomputable def Rpol (j : ℕ) : ℤ[X] := ∏ τ ∈ Finset.range 172, (if (35 + τ : ℕ) = j then (1 : ℤ[X]) else (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2)
noncomputable def Tpol (k : ℕ) : ℤ[X] :=
  (C (3:ℤ) * X + C (k : ℤ)) * ((C (3:ℤ) * X + C ((k + 3 : ℕ) : ℤ)) *
    (∏ τ ∈ Finset.range 172, (if (35 + τ : ℕ) = k ∨ (35 + τ : ℕ) = k + 3 then (1 : ℤ[X]) else (C (3:ℤ) * X + C ((35 + τ : ℕ) : ℤ)) ^ 2)))
noncomputable def Ppol (i : ℕ) : ℤ[X] := ∏ j ∈ Finset.range 35, (C (3:ℤ) * X + C ((35 + 3 * j + i : ℕ) : ℤ))

