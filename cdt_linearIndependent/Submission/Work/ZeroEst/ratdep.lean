import Mathlib
import Submission.Work.ZeroEst.defs
import Submission.Work.ZeroEst.degree_bound
import Submission.Work.ZeroEst.span_finite

/-!
# `Work.ZeroEst.ratdep` — Lang's Lemma 2.2 (bounded denominator of a rational ratio)

Let `X ⊆ ℚ⟦z⟧` be a finite-dimensional `ℚ`-subspace of the power series ring.  The lemma
states that there is a constant `N`, depending only on `X`, such that whenever `φ, ψ ∈ X` with
`ψ ≠ 0` and `φ/ψ` is a rational function — i.e. `Q·φ = P·ψ` for some polynomials `P, Q` with
`Q ≠ 0` — then one can choose such `P, Q` with `deg P, deg Q ≤ N`.

## Idea of the proof

Let `M := ℚ[X]·X` be the `ℚ[X]`-submodule of `ℚ⟦X⟧` generated by `X` (the `ℚ[X]`-module
structure is the standard one, `Polynomial.coeToPowerSeries`).  Because `X` is finite dimensional
over `ℚ`, `M` is a finitely generated, torsion-free `ℚ[X]`-module; over the PID `ℚ[X]` it is
therefore **free**, so it has a `ℚ[X]`-basis `bM` (`Module.basisOfFiniteTypeTorsionFree'`).

Writing elements of `X` in this basis gives a `ℚ`-linear map `ρ : X →ₗ[ℚ] (Fin n →₀ ℚ[X])`,
`ρ x = bM.repr x`.  The image `ρ.range` is a finite-dimensional `ℚ`-subspace of `ℚ[X]^n`, so by
`Work.ZeroEst.degree_bound` there is a uniform bound `N` on the degrees of all coordinates of all
of its elements.

Now `M` is a submodule of the domain `ℚ⟦X⟧`, so for `φ, ψ ∈ X` the relation `Q·φ = P·ψ` in
`ℚ⟦X⟧` transports to `M` and, after applying the `ℚ[X]`-linear coordinate map `bM.repr`, to
`Q * (ρ φ)_j = P * (ρ ψ)_j` in `ℚ[X]`.  Choosing `j` with `(ρ ψ)_j ≠ 0` (possible since `ψ ≠ 0`
and `ρ` is injective), multiplying the two identities and cancelling the nonzero factor `Q`
(the ring `ℚ⟦X⟧` being a domain) yields

`(ρ ψ)_j · φ = (ρ φ)_j · ψ`,

an identity whose two polynomial multipliers have degree `≤ N` by the choice of `N`.
-/

namespace Work.ZeroEst

noncomputable section

open Polynomial PowerSeries

/-- The algebra map `ℚ[X] → ℚ⟦X⟧` is the coercion of polynomials into power series. -/
private lemma algMap_poly_eq (p : Polynomial ℚ) :
    (algebraMap (Polynomial ℚ) (PowerSeries ℚ)) p = (p : PowerSeries ℚ) := by
  rw [PowerSeries.algebraMap_apply']
  change (PowerSeries.map (RingHom.id ℚ)) (p : PowerSeries ℚ) = (p : PowerSeries ℚ)
  rw [PowerSeries.map_id]; rfl

/-- The standard `ℚ[X]`-algebra structure on `ℚ⟦X⟧` is faithful. -/
private lemma faithfulSMul_poly_powerseries :
    FaithfulSMul (Polynomial ℚ) (PowerSeries ℚ) :=
  (faithfulSMul_iff_algebraMap_injective _ _).mpr (by
    intro p q h
    rw [algMap_poly_eq p, algMap_poly_eq q] at h
    exact Polynomial.coe_injective ℚ h)

theorem ratdep (X : Submodule ℚ (PowerSeries ℚ)) [FiniteDimensional ℚ X] :
    ∃ N : ℕ, ∀ (φ ψ : PowerSeries ℚ),
      φ ∈ X → ψ ∈ X → ψ ≠ 0 →
      (∃ P Q : Polynomial ℚ, Q ≠ 0 ∧ (Q : PowerSeries ℚ) * φ = (P : PowerSeries ℚ) * ψ) →
      ∃ P Q : Polynomial ℚ, P.degree ≤ (N : WithBot ℕ) ∧ Q.degree ≤ (N : WithBot ℕ) ∧
        Q ≠ 0 ∧ (Q : PowerSeries ℚ) * φ = (P : PowerSeries ℚ) * ψ := by
  haveI : FaithfulSMul (Polynomial ℚ) (PowerSeries ℚ) := faithfulSMul_poly_powerseries
  haveI : Module.IsTorsionFree (Polynomial ℚ) (PowerSeries ℚ) := inferInstance
  -- The `ℚ[X]`-span of `X`, a finitely generated torsion-free `ℚ[X]`-module.
  let M : Submodule (Polynomial ℚ) (PowerSeries ℚ) :=
    Submodule.span (Polynomial ℚ) (X : Set (PowerSeries ℚ))
  have hMfin : Module.Finite (Polynomial ℚ) M := span_finite X
  haveI : Module.Finite (Polynomial ℚ) M := hMfin
  haveI : Module.IsTorsionFree (Polynomial ℚ) M := inferInstance
  -- A `ℚ[X]`-basis of `M` (freeness of a f.g. torsion-free module over the PID `ℚ[X]`).
  obtain ⟨n, bM⟩ := Module.basisOfFiniteTypeTorsionFree' (R := Polynomial ℚ) (M := M)
  have hXM : X ≤ M.restrictScalars ℚ := fun x hx => Submodule.subset_span hx
  -- The coordinate map `X → ℚ[X]^n` attached to the basis.
  let ρ : X →ₗ[ℚ] (Fin n →₀ Polynomial ℚ) :=
    ((bM.repr : M →ₗ[Polynomial ℚ] (Fin n →₀ Polynomial ℚ)).restrictScalars ℚ).comp
      (Submodule.inclusion hXM)
  haveI : FiniteDimensional ℚ ρ.range := LinearMap.finiteDimensional_range ρ
  -- The uniform degree bound on the coordinates of elements of `X`.
  obtain ⟨N, hN⟩ := degree_bound ρ.range
  refine ⟨N, ?_⟩
  intro φ ψ hφ hψ hψ0 hdep
  rcases hdep with ⟨P, Q, hQ0, hPQ⟩
  set Φ : M := ⟨φ, hXM hφ⟩ with hΦdef
  set Ψ : M := ⟨ψ, hXM hψ⟩ with hΨdef
  have hfM : ρ ⟨φ, hφ⟩ = bM.repr Φ := rfl
  have hgM : ρ ⟨ψ, hψ⟩ = bM.repr Ψ := rfl
  -- `ψ ≠ 0` makes some coordinate of `Ψ` nonzero.
  have hψM : Ψ ≠ 0 := by
    intro h; exact hψ0 (congrArg Subtype.val h)
  have hg_ne : bM.repr Ψ ≠ 0 := by
    intro h
    exact hψM (bM.repr.injective (by rw [h, map_zero]))
  obtain ⟨j, hj⟩ : ∃ j : Fin n, (bM.repr Ψ) j ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hg_ne (Finsupp.ext h)
  -- The relation transported to `M` and to the coordinates.
  have hstep : Q • Φ = P • Ψ := by
    apply Subtype.ext
    change Q • φ = P • ψ
    rw [Algebra.smul_def, Algebra.smul_def, algMap_poly_eq, algMap_poly_eq]
    exact hPQ
  have hrepr : Q • (bM.repr Φ) = P • (bM.repr Ψ) := by
    rw [← LinearEquiv.map_smul, ← LinearEquiv.map_smul, hstep]
  have hcoord : Q * (bM.repr Φ) j = P * (bM.repr Ψ) j := by
    have := congrArg (fun v : Fin n →₀ Polynomial ℚ => v j) hrepr
    simpa [Finsupp.smul_apply] using this
  -- Degree bounds for the two coordinates we are about to use.
  have hdegf : ((ρ ⟨φ, hφ⟩) j).degree ≤ (N : WithBot ℕ) :=
    hN _ (LinearMap.mem_range_self ρ ⟨φ, hφ⟩) j
  have hdegg : ((ρ ⟨ψ, hψ⟩) j).degree ≤ (N : WithBot ℕ) :=
    hN _ (LinearMap.mem_range_self ρ ⟨ψ, hψ⟩) j
  refine ⟨(ρ ⟨φ, hφ⟩) j, (ρ ⟨ψ, hψ⟩) j, hdegf, hdegg, ?_, ?_⟩
  · -- the denominator `(ρ ψ)_j` is nonzero
    rw [hgM]; exact hj
  · -- and it is a valid denominator: `(ρ ψ)_j · φ = (ρ φ)_j · ψ`
    have hQ0' : (Q : PowerSeries ℚ) ≠ 0 := by
      intro h
      apply hQ0
      apply FaithfulSMul.algebraMap_injective (Polynomial ℚ) (PowerSeries ℚ)
      rw [algMap_poly_eq Q]
      simp [h]
    have hcoord' : Q * (ρ ⟨φ, hφ⟩) j = P * (ρ ⟨ψ, hψ⟩) j := by
      rw [hfM, hgM]; exact hcoord
    have hmapped : (Q : PowerSeries ℚ) * ((ρ ⟨φ, hφ⟩) j : PowerSeries ℚ)
        = (P : PowerSeries ℚ) * ((ρ ⟨ψ, hψ⟩) j : PowerSeries ℚ) := by
      have h := congrArg (algebraMap (Polynomial ℚ) (PowerSeries ℚ)) hcoord'
      simpa only [algMap_poly_eq, Polynomial.coe_mul] using h
    have key : (Q : PowerSeries ℚ) * (((ρ ⟨ψ, hψ⟩) j : PowerSeries ℚ) * φ)
        = (Q : PowerSeries ℚ) * (((ρ ⟨φ, hφ⟩) j : PowerSeries ℚ) * ψ) := by
      linear_combination ((ρ ⟨ψ, hψ⟩) j : PowerSeries ℚ) * hPQ - ψ * hmapped
    exact mul_left_cancel₀ hQ0' key

end

end Work.ZeroEst
