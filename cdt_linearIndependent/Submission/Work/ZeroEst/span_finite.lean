import Mathlib
import Submission.Work.ZeroEst.defs

namespace Work.ZeroEst

/-!
# The `ℚ[X]`-span of a finite-dimensional space of power series is finitely generated

Let `X ⊆ ℚ⟦X⟧` be a `ℚ`-subspace of finite dimension `n` over `ℚ` (a hypothesis that arises in
`Work.ZeroEst.ratdep` / `Work.ZeroEst.fixed_deg_order_bound`, where `X` is a finite-dimensional
space of power series such as the span of the monomials of bounded degree in a fundamental
solution matrix).  This file proves that the `ℚ[X]`-submodule generated by `X` is a *finitely
generated* `ℚ[X]`-module.

The mathematics is elementary: choose a finite set `S` spanning `X` over `ℚ` (e.g. a `ℚ`-basis,
which exists since `X` is finite dimensional).  Since `ℚ ⊆ ℚ[X]`, every `ℚ`-linear combination of
`S` is a `ℚ[X]`-linear combination, so `X` is contained in the `ℚ[X]`-span of `S`; conversely
`S ⊆ X`.  Hence the `ℚ[X]`-span of `X` equals the `ℚ[X]`-span of the *finite* set `S`, which is a
finitely generated `ℚ[X]`-module (`Submodule.fg_span`).

The only bookkeeping is that the two spans live over different base rings (`ℚ` and `ℚ[X]`), for
which the `IsScalarTower ℚ ℚ[X] ℚ⟦X⟧` instance supplies the comparison
(`Submodule.restrictScalars`).
-/

/-- **The `ℚ[X]`-span of a finite-dimensional `ℚ`-subspace of `ℚ⟦X⟧` is finitely generated.**

`X` is finite dimensional over `ℚ`, so it is spanned over `ℚ` by finitely many series `S`;
since `ℚ ⊆ ℚ[X]` and `S ⊆ X`, the `ℚ[X]`-submodule generated by `X` is generated by the finite
set `S` and is therefore a finite `ℚ[X]`-module. -/
theorem span_finite (X : Submodule ℚ (PowerSeries ℚ)) [FiniteDimensional ℚ X] :
    Module.Finite (Polynomial ℚ) (Submodule.span (Polynomial ℚ) (X : Set (PowerSeries ℚ))) := by
  rw [Module.Finite.iff_fg]
  -- a finite set `S ⊆ X` spanning `X` over `ℚ`
  obtain ⟨S, hSfin, hSspan⟩ :=
    Submodule.fg_def.mp (Module.Finite.fg_top (R := ℚ) (M := X))
  -- its image `T` in the ambient space `ℚ⟦X⟧`
  set T : Set (PowerSeries ℚ) := (Submodule.subtype X : X →ₗ[ℚ] PowerSeries ℚ) '' S with hT
  have hTfin : T.Finite := hSfin.image _
  have hXeq : Submodule.span ℚ T = X := by
    rw [hT, ← Submodule.map_span (Submodule.subtype X) S, hSspan, Submodule.map_subtype_top]
  -- `ℚ`-scalars are `ℚ[X]`-scalars, so the `ℚ`-span of `T` lies in its `ℚ[X]`-span
  have hsub : Submodule.span ℚ T ≤ (Submodule.span (Polynomial ℚ) T).restrictScalars ℚ :=
    Submodule.span_le.mpr (fun x hx => Submodule.subset_span hx)
  have hXsub : (X : Set (PowerSeries ℚ)) ⊆
      (Submodule.span (Polynomial ℚ) T : Set (PowerSeries ℚ)) := by
    intro x hx
    have hx' : x ∈ Submodule.span ℚ T := by rw [hXeq]; exact hx
    exact hsub hx'
  -- consequently the two `ℚ[X]`-spans agree
  have hle1 : Submodule.span (Polynomial ℚ) (X : Set (PowerSeries ℚ)) ≤
      Submodule.span (Polynomial ℚ) T := Submodule.span_le.mpr hXsub
  have hle2 : Submodule.span (Polynomial ℚ) T ≤
      Submodule.span (Polynomial ℚ) (X : Set (PowerSeries ℚ)) :=
    Submodule.span_mono (fun x hx => hXeq ▸ Submodule.subset_span hx)
  rw [le_antisymm hle1 hle2]
  exact Submodule.fg_span hTfin

end Work.ZeroEst
