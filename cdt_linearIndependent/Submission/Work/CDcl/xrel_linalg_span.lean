import Mathlib

namespace Work.CDcl

/-- Five vectors lying in the span of four vectors are linearly dependent: over a field, any
family of `n + 1` vectors contained in the span of `n` vectors has a nontrivial linear relation.

The proof is dimension bookkeeping: if `S : Fin 5 → M` were linearly independent, then, viewing
it inside `V = span K (range g)`, its span would have `finrank` equal to `Fintype.card (Fin 5) = 5`
(`finrank_span_eq_card`), while `V` is generated by the four vectors `g j`, so `finrank K V ≤ 4`
(`finrank_range_le_card`). Monotonicity of `finrank` for submodules of the finite-dimensional
module `V` yields `5 ≤ 4`. -/
theorem xrel_linalg_span {K M : Type*} [Field K] [AddCommGroup M] [Module K M]
    (g : Fin 4 → M) (S : Fin 5 → M) (h : ∀ k, S k ∈ Submodule.span K (Set.range g)) :
    ∃ c : Fin 5 → K, c ≠ 0 ∧ ∑ k, c k • S k = 0 := by
  have hnot : ¬ LinearIndependent K S := by
    intro hLI
    -- View everything inside the span `V` of the four vectors `g j`.
    let V : Submodule K M := Submodule.span K (Set.range g)
    let S' : Fin 5 → V := fun k => ⟨S k, h k⟩
    have hcomp : V.subtype ∘ S' = S := by funext k; rfl
    have hLI'' : LinearIndependent K (V.subtype ∘ S') := by rw [hcomp]; exact hLI
    have hLI' : LinearIndependent K S' := LinearIndependent.of_comp V.subtype hLI''
    -- `V` is finitely generated, as the span of a finite set.
    have hfinV : Module.Finite K V :=
      Module.Finite.of_fg (Submodule.fg_span (Set.finite_range g))
    -- Upper bound: `finrank K V ≤ 4`.
    have hVle : Module.finrank K V ≤ 4 := by
      have hrange := finrank_range_le_card (R := K) g
      simpa [Set.finrank, V] using hrange
    -- Lower bound: the span of the independent family `S'` has `finrank` five.
    have heq : Module.finrank K (Submodule.span K (Set.range S')) = 5 := by
      have hcard := finrank_span_eq_card (R := K) hLI'
      simpa using hcard
    have hle : Module.finrank K (Submodule.span K (Set.range S')) ≤ Module.finrank K V :=
      Submodule.finrank_le _
    omega
  -- Extract the nontrivial relation from `¬ LinearIndependent K S`.
  obtain ⟨f, g, hfg, i, hi⟩ := Fintype.not_linearIndependent_iffₛ.mp hnot
  refine ⟨fun k => f k - g k, ?_, ?_⟩
  · intro h0
    have : f i - g i = 0 := by simpa using congrFun h0 i
    exact hi (sub_eq_zero.mp this)
  · show ∑ k : Fin 5, (f k - g k) • S k = 0
    have h1 : ∑ k : Fin 5, (f k - g k) • S k
        = (∑ k : Fin 5, f k • S k) - (∑ k : Fin 5, g k • S k) := by
      simp only [sub_smul, Finset.sum_sub_distrib]
    rw [h1, hfg, sub_self]

end Work.CDcl
