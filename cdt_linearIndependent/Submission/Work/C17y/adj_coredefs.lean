import Mathlib
import Submission.Work.C17.adjoint_defs
import Submission.Work.C17adj.Psi8_ne_zero

/-!
# Definitions of the adjoint certificate (`Work.C17y.Core`)

Definitions of the certificate `Work.C17.linear_core` of `Submission/Work/C17/adjoint_core.lean`
(the explicit linear-algebra certificate for the denominator-cleared adjoint system
`Gpoly a b n c = 0 ⟹ n = 0 ∧ c = 0`), re-namespaced to `Work.C17y.Core` and split off from the
long proof so that the certificate's proof script can be built and debugged separately.

Two mathematical corrections to the original are needed for this to compile:

* the determinant `(Amat a b).det` equals `-Pdet a b` (numerically verified at admissible
  `(a,b)`), not `Pdet a b`; the definition `PdetC a b = -Pdet a b` and the lemma `Adet`
  (proved by `ring`, which now succeeds) record the correct statement, and
* the `simp` lemmas reducing the first row of `Amat` were incomplete (`Matrix.cons_val` and
  `Fin.isValue` were missing), so the expansion of the determinant left unreduced vector
  applications.

The five references to the shared definitions `AdmQ, Gpoly, Lform, Pdet, Psib` are qualified;
everything else is verbatim from the original module.
-/

set_option maxHeartbeats 4000000000
set_option maxRecDepth 1000000

namespace Work.C17y.Core
open Polynomial Matrix

lemma coeff_finset_sum {d : ℕ} {s : Finset ℕ} {f : ℕ → Polynomial ℚ} :
    (∑ i ∈ s, f i).coeff d = ∑ i ∈ s, (f i).coeff d := by
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, Polynomial.coeff_add, ih]

lemma coeff_Gpoly (a b : ℚ) (n : Fin 7 → ℚ) (c : Fin 6 → ℚ) {d : ℕ}
    (hd : d ∈ Finset.Icc 11 31) : (Work.C17.Gpoly a b n c).coeff d = Work.C17.Lform a b n c d := by
  simp only [Work.C17.Gpoly, coeff_finset_sum]
  rw [Finset.sum_eq_single d]
  · rw [Polynomial.coeff_C_mul_X_pow]; simp
  · intro e _ hne; rw [Polynomial.coeff_C_mul_X_pow]; simp [hne.symm]
  · intro hnot; exact absurd hd hnot

