import Mathlib
import Submission.CDT.KolchinAlgebraic
import Submission.CDT.KolchinTranscendental
import Submission.Commons.FieldTheory.Differential.exists_differential_of_closed
import Submission.Commons.FieldTheory.Differential.kolchin_algebraic
import Submission.Commons.FieldTheory.Transcendental.exists_coprime_aeval_div_eq
import Submission.Commons.FieldTheory.Differential.deriv_mem_adjoin_range
import Submission.Commons.FieldTheory.Differential.differentialAlgebra_subfield
import Submission.Commons.FieldTheory.Differential.differentialAlgebra_val
import Submission.Commons.FieldTheory.Differential.containConstants_val

/-!
# The algebraic independence of logarithms over a differential field

This module assembles Kolchin's lemma (`Submission.CDT.KolchinAlgebraic` for the algebraic case and
`Submission.CDT.KolchinTranscendental` for the transcendental case) into the classical
Ostrowski–Kolchin theorem.

Let `F ⊆ L` be characteristic-zero differential fields with the constants of `L` inside `F`
(`Differential.ContainConstants F L`), and let `u₁, …, uₙ ∈ L` with `uᵢ′ ∈ F`.

* `deriv_mem_adjoin` — the derivation preserves the field generated over a closed intermediate
  field by one more element (the commons has the more useful `…deriv_mem_adjoin_range` for the
  field generated by the `uᵢ`, which is what is used below, together with the tower plumbing
  `Commons.FieldTheory.Differential.{differentialAlgebra_subfield, differentialAlgebra_val,
  containConstants_val}`);
* `step` — one step of the induction: adjoining a single generator;
* **`exists_span_of_deriv_mem`** — the main theorem:
  `{v ∈ F(u₁,…,uₙ) : v′ ∈ F} = F + C_F·u₁ + ⋯ + C_F·uₙ`;
  equivalently, every `v` in the field generated by the `uᵢ` whose derivative lies in `F` is an
  `F`-element plus a `C_F`-linear combination of the `uᵢ`;
* `exists_span_of_deriv_mem_top` — the same statement when `F(u₁,…,uₙ) = L`;
* **`algebraicIndependent_of_linearIndependent`** — the Lindemann–Weierstrass form: if no nontrivial
  `C_F`-linear combination of the `uᵢ` lies in `F`, then `u₁, …, uₙ` are algebraically independent
  over `F`.

Applied to `uᵢ = log fᵢ` and the `C_F`-linear independence of the logarithmic derivatives — which for
`fᵢ ∈ K(X)` follows from the multiplicative independence of the `fᵢ`
(`Commons...LogMultiplicativeField.exists_int_prod_zpow_const_of_sum_dRat_div_field`) — this is the
Lindemann–Weierstrass theorem for function fields.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped Differential

noncomputable section

namespace Submission.CDT

open Polynomial IntermediateField

open MvPolynomial

variable {F L : Type*} [Field F] [Differential F] [Field L] [Algebra F L] [Differential L]
  [DifferentialAlgebra F L] [Differential.ContainConstants F L] [CharZero F]

/-- **The step of the induction.** -/
lemma step (E' : IntermediateField F L) (hE' : ∀ x ∈ E', x′ ∈ E') (a : L)
    (ha : ∃ b : F, a′ = algebraMap F L b)
    {v : L} (hv : v ∈ IntermediateField.adjoin E' ({a} : Set L))
    (hvF : ∃ b : F, v′ = algebraMap F L b) :
    ∃ (r : E') (c : L), c′ = 0 ∧ v = (r : L) + c * a := by
  obtain ⟨dE', hdE'⟩ := Commons.FieldTheory.Differential.exists_differential_of_closed E' hE'
  letI : Differential E' := dE'
  haveI hDE : DifferentialAlgebra F E' := Commons.FieldTheory.Differential.differentialAlgebra_subfield E' hE' dE' hdE'
  haveI hDEL : DifferentialAlgebra E' L := Commons.FieldTheory.Differential.differentialAlgebra_val E' hE' dE' hdE'
  haveI hCC : Differential.ContainConstants E' L := Commons.FieldTheory.Differential.containConstants_val (F := F) E'
  haveI hCZ : CharZero E' := Algebra.charZero_of_charZero F E'
  by_cases hInt : IsIntegral E' a
  · obtain ⟨b, hb⟩ := ha
    have ha' : a′ = algebraMap E' L (algebraMap F E' b) := by
      rw [← IsScalarTower.algebraMap_apply F E' L b]; exact hb
    obtain ⟨b', hb'⟩ :=
      Commons.FieldTheory.Differential.kolchin_algebraic (R := E') (S := L) (u := a)
        (a := algebraMap F E' b) hInt ha'
    obtain ⟨c, hc⟩ := Differential.ContainConstants.mem_range_of_deriv_eq_zero (A := F) hb'
    have hamem : a ∈ E' := by
      have h1 : a = algebraMap E' L (algebraMap F E' c - b') := by
        rw [map_sub, ← IsScalarTower.algebraMap_apply F E' L c, hc]
        ring
      rw [h1]
      exact (algebraMap F E' c - b').2
    have hvE' : v ∈ E' := by
      have hle : (IntermediateField.adjoin E' ({a} : Set L)) ≤ (⊥ : IntermediateField E' L) :=
        IntermediateField.adjoin_le_iff.mpr (fun x hx => by
          rw [Set.mem_singleton_iff] at hx
          rw [hx]
          exact IntermediateField.mem_bot.mpr ⟨⟨a, hamem⟩, rfl⟩)
      obtain ⟨y, hy⟩ := IntermediateField.mem_bot.mp (hle hv)
      rw [← hy]
      exact y.2
    refine ⟨⟨v, hvE'⟩, 0, ?_, ?_⟩
    · exact map_zero _
    · simp
  · have hTrans : Transcendental E' a := fun h => hInt (isAlgebraic_iff_isIntegral.mp h)
    obtain ⟨P₀, Q₀, hPQ₀⟩ := (IntermediateField.mem_adjoin_simple_iff E' v).mp hv
    have hrepr : ∃ r s : Polynomial E', s ≠ 0 ∧ v * (Polynomial.aeval a) s = (Polynomial.aeval a) r := by
      by_cases hQ0 : Q₀ = 0
      · refine ⟨0, 1, one_ne_zero, ?_⟩
        rw [Polynomial.aeval_one, mul_one, hPQ₀, hQ0, Polynomial.aeval_zero, div_zero]
      · refine ⟨P₀, Q₀, hQ0, ?_⟩
        have hz : (Polynomial.aeval a) Q₀ ≠ 0 :=
          fun h => hQ0 ((transcendental_iff.mp hTrans) Q₀ h)
        rw [hPQ₀, div_mul_cancel₀ _ hz]
    obtain ⟨P, Q, hQ0, hcop, hPQmul⟩ :=
      Commons.FieldTheory.Transcendental.exists_coprime_aeval_div_eq hTrans hrepr
    have hQA : (Polynomial.aeval a) Q ≠ 0 := fun h => hQ0 ((transcendental_iff.mp hTrans) Q h)
    have hvPQ : v = (Polynomial.aeval a) P / (Polynomial.aeval a) Q := by
      rw [eq_div_iff_mul_eq hQA]
      exact hPQmul
    obtain ⟨b₀, hb₀⟩ := hvF
    obtain ⟨b₁, hb₁⟩ := ha
    have ha'' : a′ = algebraMap E' L (algebraMap F E' b₁) := by
      rw [← IsScalarTower.algebraMap_apply F E' L b₁]; exact hb₁
    have hderiv : Differential.deriv ((Polynomial.aeval a) P / (Polynomial.aeval a) Q)
        = algebraMap E' L (algebraMap F E' b₀) := by
      rw [← hvPQ, hb₀, ← IsScalarTower.algebraMap_apply F E' L b₀]
    obtain ⟨r₀, c, hc, heq⟩ :=
      exists_add_mul_of_deriv_div_mem (R := E') (S := L) (u := a) (a := algebraMap F E' b₁)
        hTrans ha'' hQ0 hcop (ρ := algebraMap F E' b₀) hderiv
    refine ⟨r₀, c, hc, ?_⟩
    rw [hvPQ, heq]
    rfl

/-- **The algebraic independence / span theorem.** -/
theorem exists_span_of_deriv_mem (n : ℕ) :
    ∀ (u : Fin n → L), (∀ i, ∃ b : F, (u i)′ = algebraMap F L b) →
      ∀ v : L, v ∈ IntermediateField.adjoin F (Set.range u) →
        (∃ b : F, v′ = algebraMap F L b) →
          ∃ (r : F) (c : Fin n → F), (∀ i, (c i)′ = 0) ∧
            v = algebraMap F L r + ∑ i, algebraMap F L (c i) * u i := by
  induction n with
  | zero =>
      intro u hu v hv hvF
      have hre : Set.range u = ∅ := by
        rw [Set.eq_empty_iff_forall_notMem]
        rintro x ⟨i, -⟩
        exact i.elim0
      simp only [hre, IntermediateField.adjoin_empty] at hv
      obtain ⟨r, hr⟩ := IntermediateField.mem_bot.mp hv
      refine ⟨r, fun i => i.elim0, ?_, ?_⟩
      · intro i; exact i.elim0
      · rw [← hr]; simp
  | succ n ih =>
      intro u hu v hv hvF
      set u' : Fin n → L := fun i => u i.castSucc with hu'_def
      set a : L := u (Fin.last n) with ha_def
      have hu' : ∀ i, ∃ b : F, (u' i)′ = algebraMap F L b := fun i => hu i.castSucc
      have ha : ∃ b : F, a′ = algebraMap F L b := hu (Fin.last n)
      have hE' : ∀ x ∈ IntermediateField.adjoin F (Set.range u'),
          x′ ∈ IntermediateField.adjoin F (Set.range u') := Commons.FieldTheory.Differential.deriv_mem_adjoin_range u' hu'
      have hrange : Set.range u = Set.range u' ∪ {a} := by
        ext x
        constructor
        · rintro ⟨i, rfl⟩
          rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
          · exact Or.inl ⟨j, rfl⟩
          · exact Or.inr rfl
        · rintro (⟨j, rfl⟩ | rfl)
          · exact ⟨j.castSucc, rfl⟩
          · exact ⟨Fin.last n, rfl⟩
      have hv'' : v ∈ IntermediateField.adjoin (IntermediateField.adjoin F (Set.range u')) ({a} : Set L) := by
        have h1 : (IntermediateField.adjoin (IntermediateField.adjoin F (Set.range u'))
              ({a} : Set L)).restrictScalars F = IntermediateField.adjoin F (Set.range u) := by
          rw [IntermediateField.adjoin_adjoin_left, hrange]
        have h2 : v ∈ (IntermediateField.adjoin (IntermediateField.adjoin F (Set.range u'))
              ({a} : Set L)).restrictScalars F := by
          rw [h1]; exact hv
        exact h2
      obtain ⟨r₀, cc, hc, hveq⟩ := step (IntermediateField.adjoin F (Set.range u')) hE' a ha hv'' hvF
      obtain ⟨cF, hcF⟩ := Differential.ContainConstants.mem_range_of_deriv_eq_zero (A := F) hc
      have hcF' : (cF)′ = 0 := by
        have h : algebraMap F L (cF′) = 0 := by
          rw [← DifferentialAlgebra.deriv_algebraMap, hcF, hc]
        exact (FaithfulSMul.algebraMap_eq_zero_iff F L).mp h
      have hder : (r₀ : L)′ = v′ - cc * a′ := by
        have h := congrArg (fun w : L => w′) hveq
        simp only [map_add, Derivation.leibniz, smul_eq_mul, hc, mul_zero, add_zero] at h
        rw [h]; ring
      obtain ⟨b₀, hb₀⟩ := hvF
      obtain ⟨b₁, hb₁⟩ := ha
      have hr₀ : ∃ b : F, (r₀ : L)′ = algebraMap F L b :=
        ⟨b₀ - cF * b₁, by
          rw [hder, hb₀, hb₁, ← hcF, map_sub, map_mul]⟩
      obtain ⟨r, cf, hcf, hr⟩ := ih u' hu' (r₀ : L) r₀.2 hr₀
      refine ⟨r, Fin.snoc cf cF, ?_, ?_⟩
      · intro i
        rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
        · rw [Fin.snoc_castSucc]; exact hcf j
        · rw [Fin.snoc_last]; exact hcF'
      · rw [hveq, hr, ← hcF, Fin.sum_univ_castSucc]
        simp only [Fin.snoc_castSucc, Fin.snoc_last, hu'_def, ha_def]
        ring

/-- `Option (Fin n) ≃ Fin (n+1)`. -/
def optionEquivFin (n : ℕ) : Option (Fin n) ≃ Fin (n + 1) where
  toFun o := o.elim (Fin.last n) Fin.castSucc
  invFun i := i.lastCases none some
  left_inv o := by cases o <;> simp [Fin.lastCases_last, Fin.lastCases_castSucc]
  right_inv i := by
    rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · simp [Fin.lastCases_castSucc]
    · simp [Fin.lastCases_last]

/-- **Linear independence modulo `F` implies algebraic independence.** -/
theorem algebraicIndependent_of_linearIndependent (n : ℕ) :
    ∀ (u : Fin n → L), (∀ i, ∃ b : F, (u i)′ = algebraMap F L b) →
      (∀ (c : Fin n → F) (r : F), (∀ i, (c i)′ = 0) →
        (∑ i, algebraMap F L (c i) * u i = algebraMap F L r) → ∀ i, c i = 0) →
      AlgebraicIndependent F u := by
  induction n with
  | zero =>
      intro u hu hlin
      exact algebraicIndependent_empty_type_iff.mpr (FaithfulSMul.algebraMap_injective F L)
  | succ n ih =>
      intro u hu hlin
      have hu' : ∀ i : Fin n, ∃ b : F, (u i.castSucc)′ = algebraMap F L b :=
        fun i => hu i.castSucc
      have hlin' : ∀ (c : Fin n → F) (r : F), (∀ i, (c i)′ = 0) →
          (∑ i, algebraMap F L (c i) * u i.castSucc = algebraMap F L r) → ∀ i, c i = 0 := by
        intro c r hc hsum i
        have hc' : ∀ j : Fin (n + 1), ((Fin.snoc c 0 : Fin (n + 1) → F) j)′ = 0 := by
          intro j
          rcases Fin.eq_castSucc_or_eq_last j with ⟨k, rfl⟩ | rfl
          · rw [Fin.snoc_castSucc]; exact hc k
          · rw [Fin.snoc_last]; exact map_zero _
        have hsum' : ∑ j : Fin (n + 1), algebraMap F L ((Fin.snoc c 0 : Fin (n + 1) → F) j) * u j
            = algebraMap F L r := by
          rw [Fin.sum_univ_castSucc]
          simp only [Fin.snoc_castSucc, Fin.snoc_last, map_zero, zero_mul, add_zero]
          exact hsum
        have hlast := hlin _ r hc' hsum' i.castSucc
        rwa [Fin.snoc_castSucc] at hlast
      have hInd' : AlgebraicIndependent F (fun i : Fin n => u i.castSucc) := ih _ hu' hlin'
      have hTrans : Transcendental
          (IntermediateField.adjoin F (Set.range (fun i : Fin n => u i.castSucc)))
          (u (Fin.last n)) := by
        intro hT
        set K : IntermediateField F L :=
          IntermediateField.adjoin F (Set.range (fun i : Fin n => u i.castSucc)) with hK_def
        have halg : IsIntegral K (u (Fin.last n)) := isAlgebraic_iff_isIntegral.mp hT
        have hKc : ∀ x ∈ K, x′ ∈ K := Commons.FieldTheory.Differential.deriv_mem_adjoin_range _ hu'
        obtain ⟨dK, hdK⟩ := Commons.FieldTheory.Differential.exists_differential_of_closed K hKc
        letI : Differential K := dK
        haveI : DifferentialAlgebra F K := Commons.FieldTheory.Differential.differentialAlgebra_subfield K hKc dK hdK
        haveI : DifferentialAlgebra K L := Commons.FieldTheory.Differential.differentialAlgebra_val K hKc dK hdK
        haveI : Differential.ContainConstants K L := Commons.FieldTheory.Differential.containConstants_val (F := F) K
        haveI : CharZero K := Algebra.charZero_of_charZero F K
        obtain ⟨b₀, hb₀⟩ := hu (Fin.last n)
        have haK : (u (Fin.last n))′ = algebraMap K L (algebraMap F K b₀) := by
          rw [← IsScalarTower.algebraMap_apply F K L b₀]; exact hb₀
        obtain ⟨b, hb⟩ := Commons.FieldTheory.Differential.kolchin_algebraic (R := K) (S := L)
            (u := u (Fin.last n)) (a := algebraMap F K b₀) halg haK
        obtain ⟨c, hc⟩ := Differential.ContainConstants.mem_range_of_deriv_eq_zero (A := F) hb
        have hamem : u (Fin.last n) ∈ K := by
          have h1 : u (Fin.last n) = algebraMap K L (algebraMap F K c - b) := by
            rw [map_sub, ← IsScalarTower.algebraMap_apply F K L c, hc]; ring
          rw [h1]; exact (algebraMap F K c - b).2
        obtain ⟨r, cf, hcf, hr⟩ :=
          exists_span_of_deriv_mem n (fun i : Fin n => u i.castSucc) hu' (u (Fin.last n))
            (hK_def ▸ hamem) ⟨b₀, hb₀⟩
        have hc' : ∀ j : Fin (n + 1), ((Fin.snoc (fun i => -cf i) 1 : Fin (n + 1) → F) j)′ = 0 := by
          intro j
          rcases Fin.eq_castSucc_or_eq_last j with ⟨k, rfl⟩ | rfl
          · rw [Fin.snoc_castSucc, map_neg, hcf k, neg_zero]
          · rw [Fin.snoc_last]; exact Derivation.map_one_eq_zero _
        have hsum' : ∑ j : Fin (n + 1),
              algebraMap F L ((Fin.snoc (fun i => -cf i) 1 : Fin (n + 1) → F) j) * u j
            = algebraMap F L r := by
          rw [Fin.sum_univ_castSucc]
          simp only [Fin.snoc_castSucc, Fin.snoc_last, map_neg, map_one, one_mul]
          rw [show (∑ i : Fin n, -algebraMap F L (cf i) * u i.castSucc)
              = -(∑ i : Fin n, algebraMap F L (cf i) * u i.castSucc) by
            rw [← Finset.sum_neg_distrib]
            exact Finset.sum_congr rfl (fun i _ => by rw [neg_mul])]
          rw [hr]; ring
        have hlast := hlin _ r hc' hsum' (Fin.last n)
        rw [Fin.snoc_last] at hlast
        exact one_ne_zero hlast
      refine (algebraicIndependent_equiv' (R := F) (optionEquivFin n) (f := u)
        (g := fun o : Option (Fin n) => o.elim (u (Fin.last n)) (fun i => u i.castSucc)) ?_).mp ?_
      · funext o; cases o <;> rfl
      · refine AlgebraicIndependent.option_iff.mpr ⟨hInd', ?_⟩
        rw [← IntermediateField.transcendental_adjoin_iff]
        exact hTrans

/-- The span theorem, in the "generating" form. -/
theorem exists_span_of_deriv_mem_top (n : ℕ) (u : Fin n → L)
    (hu : ∀ i, ∃ b : F, (u i)′ = algebraMap F L b)
    (hgen : IntermediateField.adjoin F (Set.range u) = ⊤) :
    ∀ v : L, (∃ b : F, v′ = algebraMap F L b) →
      ∃ (r : F) (c : Fin n → F), (∀ i, (c i)′ = 0) ∧
        v = algebraMap F L r + ∑ i, algebraMap F L (c i) * u i :=
  fun v hv => exists_span_of_deriv_mem n u hu v (by rw [hgen]; trivial) hv

/-- **The full characterisation**: `{v : v′ ∈ F}` is exactly `F + Σ C_F·u_i`. -/
theorem deriv_mem_range_iff (n : ℕ) (u : Fin n → L)
    (hu : ∀ i, ∃ b : F, (u i)′ = algebraMap F L b)
    (hgen : IntermediateField.adjoin F (Set.range u) = ⊤) (v : L) :
    (∃ b : F, v′ = algebraMap F L b) ↔
      ∃ (r : F) (c : Fin n → F), (∀ i, (c i)′ = 0) ∧
        v = algebraMap F L r + ∑ i, algebraMap F L (c i) * u i := by
  constructor
  · exact exists_span_of_deriv_mem_top n u hu hgen v
  · rintro ⟨r, c, hc, rfl⟩
    choose b hb using hu
    refine ⟨r′ + ∑ i, c i * b i, ?_⟩
    rw [map_add, map_sum, map_add, map_sum]
    congr 1
    · rw [DifferentialAlgebra.deriv_algebraMap]
    · refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, DifferentialAlgebra.deriv_algebraMap,
        hc i, map_zero, mul_zero, add_zero, hb i, ← map_mul]

/-- **The complete Ostrowski–Kolchin theorem**: `u₁, …, uₙ` (with `uᵢ′ ∈ F`) are algebraically
independent over `F` if and only if no nontrivial `C_F`-linear combination of them lies in `F`. -/
theorem algebraicIndependent_iff_linearIndependent_mod (n : ℕ) (u : Fin n → L)
    (hu : ∀ i, ∃ b : F, (u i)′ = algebraMap F L b) :
    AlgebraicIndependent F u ↔
      ∀ (c : Fin n → F) (r : F), (∀ i, (c i)′ = 0) →
        (∑ i, algebraMap F L (c i) * u i = algebraMap F L r) → ∀ i, c i = 0 := by
  refine ⟨?_, fun hlin => algebraicIndependent_of_linearIndependent n u hu hlin⟩
  intro hInd c r hc hsum
  have hp : MvPolynomial.aeval u (∑ i, MvPolynomial.C (c i) * MvPolynomial.X i - MvPolynomial.C r)
      = 0 := by
    rw [map_sub, map_sum]
    simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
    rw [hsum, sub_self]
  have hp0 := (algebraicIndependent_iff.mp hInd) _ hp
  intro i
  have h2 : MvPolynomial.aeval (fun j : Fin n => if j = i then Polynomial.X else 0)
      (∑ j, MvPolynomial.C (c j) * MvPolynomial.X j - MvPolynomial.C r)
      = Polynomial.C (c i) * Polynomial.X - Polynomial.C r := by
    rw [map_sub, map_sum]
    simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
    rw [Finset.sum_eq_single i]
    · rw [if_pos rfl]
      simp only [Polynomial.C_eq_algebraMap]
    · intro j _ hj; rw [if_neg hj, mul_zero]
    · intro hi; exact absurd (Finset.mem_univ i) hi
  rw [hp0] at h2
  have h3 := congrArg (fun q : Polynomial F => q.coeff 1) h2
  simpa using h3.symm

omit [Differential F] [Differential L] [DifferentialAlgebra F L]
  [Differential.ContainConstants F L] [CharZero F] in
/-- If `u₁, …, uₙ` generate `L` over `F`, they are a transcendence basis as soon as they are
algebraically independent. -/
theorem isTranscendenceBasis_of_algebraicIndependent (n : ℕ) (u : Fin n → L)
    (hInd : AlgebraicIndependent F u)
    (hgen : IntermediateField.adjoin F (Set.range u) = ⊤) :
    IsTranscendenceBasis F u := by
  have halg : Algebra.IsAlgebraic (IntermediateField.adjoin F (Set.range u)) L := by
    refine ⟨fun x => ?_⟩
    have hx : x ∈ IntermediateField.adjoin F (Set.range u) := by rw [hgen]; trivial
    exact ⟨Polynomial.X - Polynomial.C ⟨x, hx⟩, Polynomial.X_sub_C_ne_zero _, by simp⟩
  have halg' : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range u)) L :=
    (IntermediateField.isAlgebraic_adjoin_iff_top).mp halg
  exact (AlgebraicIndependent.isTranscendenceBasis_iff_isAlgebraic hInd).mpr halg'

/-- **The transcendence-degree form of the Ostrowski–Kolchin theorem**: the logarithms
`u₁, …, uₙ` of multiplicatively independent functions form a transcendence basis of the extension
they generate. -/
theorem isTranscendenceBasis_of_linearIndependent (n : ℕ) (u : Fin n → L)
    (hu : ∀ i, ∃ b : F, (u i)′ = algebraMap F L b)
    (hgen : IntermediateField.adjoin F (Set.range u) = ⊤)
    (hlin : ∀ (c : Fin n → F) (r : F), (∀ i, (c i)′ = 0) →
      (∑ i, algebraMap F L (c i) * u i = algebraMap F L r) → ∀ i, c i = 0) :
    IsTranscendenceBasis F u :=
  isTranscendenceBasis_of_algebraicIndependent n u
    (algebraicIndependent_of_linearIndependent n u hu hlin) hgen


omit [Differential F] [Differential L] [DifferentialAlgebra F L]
  [Differential.ContainConstants F L] [CharZero F] in
/-- If `u₁, …, uₙ` generate `L` over `F`, then `trdeg_F L ≤ n`
(the finitely-generated bound). -/
theorem trdeg_le_card_of_adjoin_top (n : ℕ) (u : Fin n → L)
    (hgen : IntermediateField.adjoin F (Set.range u) = ⊤) :
    Algebra.trdeg F L ≤ (Cardinal.mk (Set.range u) : Cardinal) := by
  have halg : Algebra.IsAlgebraic (IntermediateField.adjoin F (Set.range u)) L := by
    refine ⟨fun x => ?_⟩
    have hx : x ∈ IntermediateField.adjoin F (Set.range u) := by rw [hgen]; trivial
    exact ⟨Polynomial.X - Polynomial.C ⟨x, hx⟩, Polynomial.X_sub_C_ne_zero _, by simp⟩
  haveI : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range u)) L :=
    (IntermediateField.isAlgebraic_adjoin_iff_top).mp halg
  exact Algebra.IsAlgebraic.trdeg_le_cardinalMk (R := F) (A := L) (s := Set.range u)

omit [Differential F] [Differential L] [DifferentialAlgebra F L]
  [Differential.ContainConstants F L] [CharZero F] in
/-- **The transcendence degree of a field generated by algebraically independent elements.** -/
theorem trdeg_eq_card_range_of_adjoin_top (n : ℕ) (u : Fin n → L)
    (hInd : AlgebraicIndependent F u)
    (hgen : IntermediateField.adjoin F (Set.range u) = ⊤) :
    Algebra.trdeg F L = (Cardinal.mk (Set.range u) : Cardinal) := by
  refine le_antisymm (trdeg_le_card_of_adjoin_top n u hgen) ?_
  have hcoe : AlgebraicIndependent F ((↑) : Set.range u → L) := hInd.coe_range
  exact hcoe.cardinalMk_le_trdeg

/-- The span theorem for an arbitrary finite index type. -/
theorem exists_span_of_deriv_mem_fintype {ι : Type*} [Fintype ι] (u : ι → L)
    (hu : ∀ i, ∃ b : F, (u i)′ = algebraMap F L b) :
    ∀ v ∈ IntermediateField.adjoin F (Set.range u), (∃ b : F, v′ = algebraMap F L b) →
      ∃ (r : F) (c : ι → F), (∀ i, (c i)′ = 0) ∧
        v = algebraMap F L r + ∑ i, algebraMap F L (c i) * u i := by
  intro v hv hvF
  set e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι with he
  have hu' : ∀ j : Fin (Fintype.card ι), ∃ b : F, (u (e.symm j))′ = algebraMap F L b :=
    fun j => hu _
  have hrange : Set.range (fun j : Fin (Fintype.card ι) => u (e.symm j)) = Set.range u := by
    ext x; constructor
    · rintro ⟨j, rfl⟩; exact ⟨e.symm j, rfl⟩
    · rintro ⟨i, rfl⟩; exact ⟨e i, by simp⟩
  obtain ⟨r, c, hc, heq⟩ := exists_span_of_deriv_mem (Fintype.card ι)
    (fun j : Fin (Fintype.card ι) => u (e.symm j)) hu' v (by rwa [hrange]) hvF
  refine ⟨r, fun i => c (e i), fun i => hc (e i), ?_⟩
  rw [heq]
  congr 1
  rw [← Equiv.sum_comp e (fun j => algebraMap F L (c j) * u (e.symm j))]
  simp

end Submission.CDT
