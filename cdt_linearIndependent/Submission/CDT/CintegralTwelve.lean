  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`12` instance of the `m`-sum evaluation
`Σₘ genW 12 m = a_12·L(2,χ₋₃) − 2·b_12` -/
theorem genW_twelve_eq_statement (m : ℕ) :
    genW 12 m = (282429536481 : ℝ) * (Nat.choose (m + 24) 24 : ℝ) *
          (∑ i ∈ Finset.range 26,
            ((-1 : ℝ) ^ i * (Nat.choose 25 i : ℝ)) *
              (254561089305600 / ((((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ) * ((3 * m + 28 + i : ℕ) : ℝ) * ((3 * m + 31 + i : ℕ) : ℝ) * ((3 * m + 34 + i : ℕ) : ℝ) * ((3 * m + 37 + i : ℕ) : ℝ) * ((3 * m + 40 + i : ℕ) : ℝ) * ((3 * m + 43 + i : ℕ) : ℝ) * ((3 * m + 46 + i : ℕ) : ℝ) * ((3 * m + 49 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 12 m = (282429536481 : ℝ) * (Nat.choose (m + 24) 24 : ℝ) *
      (∑ i ∈ Finset.range 26,
        ((-1 : ℝ) ^ i * (Nat.choose 25 i : ℝ)) *
          (254561089305600 / genProd 12 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 12) = 282429536481 := by norm_num
    have h3 : ((3 : ℝ) ^ 12) * (Nat.factorial 12 : ℝ) = 254561089305600 := by norm_num
    have hr : 2 * 12 + 2 = 26 := by norm_num
    have hb : 2 * 12 = 24 := by norm_num
    have hc : 2 * 12 + 1 = 25 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
