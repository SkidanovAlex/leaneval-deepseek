/-!
# The `(Cintegral)` instance at `n = 8` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 8`
needs no per-degree analytic module: one identifies the parametric summand
`genW 8 ·` with the degree-`8` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralEight_core` (lemma
`genW_eight_eq_statement`, via the product expansion `genProd_eight`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 8`, `HB_coeff 8`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 8 m i = ∏_{k≤8}(3m+8+1+3k+i)`, expanded -/
lemma genProd_eight (m i : ℕ) :
    genProd 8 m i = ((3 * m + 9 + i : ℕ) : ℝ) * ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) * ((3 * m + 24 + i : ℕ) : ℝ) * ((3 * m + 27 + i : ℕ) : ℝ) * ((3 * m + 30 + i : ℕ) : ℝ) * ((3 * m + 33 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`8` instance of the `m`-sum evaluation
`Σₘ genW 8 m = a_8·L(2,χ₋₃) − 2·b_8` -/
theorem genW_eight_eq_statement (m : ℕ) :
    genW 8 m = (43046721 : ℝ) * (Nat.choose (m + 16) 16 : ℝ) *
          (∑ i ∈ Finset.range 18,
            ((-1 : ℝ) ^ i * (Nat.choose 17 i : ℝ)) *
              (264539520 / ((((3 * m + 9 + i : ℕ) : ℝ) * ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) * ((3 * m + 24 + i : ℕ) : ℝ) * ((3 * m + 27 + i : ℕ) : ℝ) * ((3 * m + 30 + i : ℕ) : ℝ) * ((3 * m + 33 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 8 m = (43046721 : ℝ) * (Nat.choose (m + 16) 16 : ℝ) *
      (∑ i ∈ Finset.range 18,
        ((-1 : ℝ) ^ i * (Nat.choose 17 i : ℝ)) *
          (264539520 / genProd 8 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 8) = 43046721 := by norm_num
    have h3 : ((3 : ℝ) ^ 8) * (Nat.factorial 8 : ℝ) = 264539520 := by norm_num
    have hr : 2 * 8 + 2 = 18 := by norm_num
    have hb : 2 * 8 = 16 := by norm_num
    have hc : 2 * 8 + 1 = 17 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_eight m i]

/-- **the `(Cintegral)` instance at `n = 8`**:
`2157759·L(2,χ₋₃) − 66085799967 / 39200 = J_8`. -/
theorem CintegralIdentityAt_eight : CintegralIdentityAt 8 := by
  change L2chi3Real * (HA_coeff 8 : ℝ) - 2 * (HB_coeff 8 : ℝ) = cintegralJ 8
  have hA : HA_coeff 8 = 2157759 := by native_decide
  have hB : HB_coeff 8 = 66085799967 / 78400 := by native_decide
  have hJ : cintegralJ 8 = (2157759 : ℝ) * L2chi3Real - 66085799967 / 39200 := by
    rw [cintegralJ_eq_sum_W_gen 8]
    rw [show (∑' m : ℕ, genW 8 m) = (∑' m : ℕ, (43046721 : ℝ) * (Nat.choose (m + 16) 16 : ℝ) *
          (∑ i ∈ Finset.range 18,
            ((-1 : ℝ) ^ i * (Nat.choose 17 i : ℝ)) *
              (264539520 / ((((3 * m + 9 + i : ℕ) : ℝ) * ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) * ((3 * m + 24 + i : ℕ) : ℝ) * ((3 * m + 27 + i : ℕ) : ℝ) * ((3 * m + 30 + i : ℕ) : ℝ) * ((3 * m + 33 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_eight_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralEight_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 8` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_eight_eq_sum_W : cintegralJ 8 = ∑' m : ℕ, genW 8 m :=
  cintegralJ_eq_sum_W_gen 8

