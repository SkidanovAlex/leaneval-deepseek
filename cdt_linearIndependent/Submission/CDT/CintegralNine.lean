/-!
# The `(Cintegral)` instance at `n = 9` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 9`
needs no per-degree analytic module: one identifies the parametric summand
`genW 9 ·` with the degree-`9` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralNine_core` (lemma
`genW_nine_eq_statement`, via the product expansion `genProd_nine`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 9`, `HB_coeff 9`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 9 m i = ∏_{k≤9}(3m+9+1+3k+i)`, expanded -/
lemma genProd_nine (m i : ℕ) :
    genProd 9 m i = ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ) * ((3 * m + 28 + i : ℕ) : ℝ) * ((3 * m + 31 + i : ℕ) : ℝ) * ((3 * m + 34 + i : ℕ) : ℝ) * ((3 * m + 37 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`9` instance of the `m`-sum evaluation
`Σₘ genW 9 m = a_9·L(2,χ₋₃) − 2·b_9` -/
theorem genW_nine_eq_statement (m : ℕ) :
    genW 9 m = (387420489 : ℝ) * (Nat.choose (m + 18) 18 : ℝ) *
          (∑ i ∈ Finset.range 20,
            ((-1 : ℝ) ^ i * (Nat.choose 19 i : ℝ)) *
              (7142567040 / ((((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ) * ((3 * m + 28 + i : ℕ) : ℝ) * ((3 * m + 31 + i : ℕ) : ℝ) * ((3 * m + 34 + i : ℕ) : ℝ) * ((3 * m + 37 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 9 m = (387420489 : ℝ) * (Nat.choose (m + 18) 18 : ℝ) *
      (∑ i ∈ Finset.range 20,
        ((-1 : ℝ) ^ i * (Nat.choose 19 i : ℝ)) *
          (7142567040 / genProd 9 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 9) = 387420489 := by norm_num
    have h3 : ((3 : ℝ) ^ 9) * (Nat.factorial 9 : ℝ) = 7142567040 := by norm_num
    have hr : 2 * 9 + 2 = 20 := by norm_num
    have hb : 2 * 9 = 18 := by norm_num
    have hc : 2 * 9 + 1 = 19 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_nine m i]

/-- **the `(Cintegral)` instance at `n = 9`**:
`17319837·L(2,χ₋₃) − 530455590781 / 39200 = J_9`. -/
theorem CintegralIdentityAt_nine : CintegralIdentityAt 9 := by
  change L2chi3Real * (HA_coeff 9 : ℝ) - 2 * (HB_coeff 9 : ℝ) = cintegralJ 9
  have hA : HA_coeff 9 = 17319837 := by native_decide
  have hB : HB_coeff 9 = 530455590781 / 78400 := by native_decide
  have hJ : cintegralJ 9 = (17319837 : ℝ) * L2chi3Real - 530455590781 / 39200 := by
    rw [cintegralJ_eq_sum_W_gen 9]
    rw [show (∑' m : ℕ, genW 9 m) = (∑' m : ℕ, (387420489 : ℝ) * (Nat.choose (m + 18) 18 : ℝ) *
          (∑ i ∈ Finset.range 20,
            ((-1 : ℝ) ^ i * (Nat.choose 19 i : ℝ)) *
              (7142567040 / ((((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ) * ((3 * m + 28 + i : ℕ) : ℝ) * ((3 * m + 31 + i : ℕ) : ℝ) * ((3 * m + 34 + i : ℕ) : ℝ) * ((3 * m + 37 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_nine_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralNine_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 9` double-integral evaluation, restated through the
