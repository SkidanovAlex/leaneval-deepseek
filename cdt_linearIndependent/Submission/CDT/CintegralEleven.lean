/-- the parametric product `genProd 11 m i = ∏_{k≤11}(3m+11+1+3k+i)`, expanded -/
lemma genProd_eleven (m i : ℕ) :
    genProd 11 m i = ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) * ((3 * m + 24 + i : ℕ) : ℝ) * ((3 * m + 27 + i : ℕ) : ℝ) * ((3 * m + 30 + i : ℕ) : ℝ) * ((3 * m + 33 + i : ℕ) : ℝ) * ((3 * m + 36 + i : ℕ) : ℝ) * ((3 * m + 39 + i : ℕ) : ℝ) * ((3 * m + 42 + i : ℕ) : ℝ) * ((3 * m + 45 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`11` instance of the `m`-sum evaluation
`Σₘ genW 11 m = a_11·L(2,χ₋₃) − 2·b_11` -/
theorem genW_eleven_eq_statement (m : ℕ) :
    genW 11 m = (31381059609 : ℝ) * (Nat.choose (m + 22) 22 : ℝ) *
          (∑ i ∈ Finset.range 24,
            ((-1 : ℝ) ^ i * (Nat.choose 23 i : ℝ)) *
              (7071141369600 / ((((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) * ((3 * m + 24 + i : ℕ) : ℝ) * ((3 * m + 27 + i : ℕ) : ℝ) * ((3 * m + 30 + i : ℕ) : ℝ) * ((3 * m + 33 + i : ℕ) : ℝ) * ((3 * m + 36 + i : ℕ) : ℝ) * ((3 * m + 39 + i : ℕ) : ℝ) * ((3 * m + 42 + i : ℕ) : ℝ) * ((3 * m + 45 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 11 m = (31381059609 : ℝ) * (Nat.choose (m + 22) 22 : ℝ) *
      (∑ i ∈ Finset.range 24,
        ((-1 : ℝ) ^ i * (Nat.choose 23 i : ℝ)) *
          (7071141369600 / genProd 11 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 11) = 31381059609 := by norm_num
    have h3 : ((3 : ℝ) ^ 11) * (Nat.factorial 11 : ℝ) = 7071141369600 := by norm_num
    have hr : 2 * 11 + 2 = 24 := by norm_num
    have hb : 2 * 11 = 22 := by norm_num
    have hc : 2 * 11 + 1 = 23 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_eleven m i]

/-- **the `(Cintegral)` instance at `n = 11`**:
`1153462995·L(2,χ₋₃) − 4274588067098379 / 4743200 = J_11`. -/
theorem CintegralIdentityAt_eleven : CintegralIdentityAt 11 := by
  change L2chi3Real * (HA_coeff 11 : ℝ) - 2 * (HB_coeff 11 : ℝ) = cintegralJ 11
  have hA : HA_coeff 11 = 1153462995 := by native_decide
  have hB : HB_coeff 11 = 4274588067098379 / 9486400 := by native_decide
  have hJ : cintegralJ 11 = (1153462995 : ℝ) * L2chi3Real - 4274588067098379 / 4743200 := by
    rw [cintegralJ_eq_sum_W_gen 11]
    rw [show (∑' m : ℕ, genW 11 m) = (∑' m : ℕ, (31381059609 : ℝ) * (Nat.choose (m + 22) 22 : ℝ) *
          (∑ i ∈ Finset.range 24,
            ((-1 : ℝ) ^ i * (Nat.choose 23 i : ℝ)) *
              (7071141369600 / ((((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) * ((3 * m + 24 + i : ℕ) : ℝ) * ((3 * m + 27 + i : ℕ) : ℝ) * ((3 * m + 30 + i : ℕ) : ℝ) * ((3 * m + 33 + i : ℕ) : ℝ) * ((3 * m + 36 + i : ℕ) : ℝ) * ((3 * m + 39 + i : ℕ) : ℝ) * ((3 * m + 42 + i : ℕ) : ℝ) * ((3 * m + 45 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_eleven_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralEleven_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

