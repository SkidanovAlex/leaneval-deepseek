/-!
# The `(Cintegral)` instance at `n = 2` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 2`
needs no per-degree analytic module: one identifies the parametric summand
`genW 2 ·` with the degree-`2` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralTwo_core` (lemma
`genW_two_eq_statement`, via the product expansion `genProd_two`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 2`, `HB_coeff 2`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 2 m i = ∏_{k≤2}(3m+2+1+3k+i)`, expanded -/
lemma genProd_two (m i : ℕ) :
    genProd 2 m i = ((3 * m + 3 + i : ℕ) : ℝ) * ((3 * m + 6 + i : ℕ) : ℝ) * ((3 * m + 9 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`2` instance of the `m`-sum evaluation
`Σₘ genW 2 m = a_2·L(2,χ₋₃) − 2·b_2` -/
theorem genW_two_eq_statement (m : ℕ) :
    genW 2 m = (81 : ℝ) * (Nat.choose (m + 4) 4 : ℝ) *
          (∑ i ∈ Finset.range 6,
            ((-1 : ℝ) ^ i * (Nat.choose 5 i : ℝ)) *
              (18 / ((((3 * m + 3 + i : ℕ) : ℝ) * ((3 * m + 6 + i : ℕ) : ℝ) * ((3 * m + 9 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 2 m = (81 : ℝ) * (Nat.choose (m + 4) 4 : ℝ) *
      (∑ i ∈ Finset.range 6,
        ((-1 : ℝ) ^ i * (Nat.choose 5 i : ℝ)) *
          (18 / genProd 2 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 2) = 81 := by norm_num
    have h3 : ((3 : ℝ) ^ 2) * (Nat.factorial 2 : ℝ) = 18 := by norm_num
    have hr : 2 * 2 + 2 = 6 := by norm_num
    have hb : 2 * 2 = 4 := by norm_num
    have hc : 2 * 2 + 1 = 5 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_two m i]

/-- **the `(Cintegral)` instance at `n = 2`**:
`15·L(2,χ₋₃) − 23 / 2 = J_2`. -/
theorem CintegralIdentityAt_two : CintegralIdentityAt 2 := by
  change L2chi3Real * (HA_coeff 2 : ℝ) - 2 * (HB_coeff 2 : ℝ) = cintegralJ 2
  have hA : HA_coeff 2 = 15 := by native_decide
  have hB : HB_coeff 2 = 23 / 4 := by native_decide
  have hJ : cintegralJ 2 = (15 : ℝ) * L2chi3Real - 23 / 2 := by
    rw [cintegralJ_eq_sum_W_gen 2]
    rw [show (∑' m : ℕ, genW 2 m) = (∑' m : ℕ, (81 : ℝ) * (Nat.choose (m + 4) 4 : ℝ) *
          (∑ i ∈ Finset.range 6,
            ((-1 : ℝ) ^ i * (Nat.choose 5 i : ℝ)) *
              (18 / ((((3 * m + 3 + i : ℕ) : ℝ) * ((3 * m + 6 + i : ℕ) : ℝ) * ((3 * m + 9 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_two_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralTwo_core_corrected]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 2` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_two_eq_sum_W : cintegralJ 2 = ∑' m : ℕ, genW 2 m :=
  cintegralJ_eq_sum_W_gen 2

end Submission.CDT
