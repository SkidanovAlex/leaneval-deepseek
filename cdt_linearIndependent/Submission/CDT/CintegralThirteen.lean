    genW 13 m = (2541865828329 : ℝ) * (Nat.choose (m + 26) 26 : ℝ) *
          (∑ i ∈ Finset.range 28,
            ((-1 : ℝ) ^ i * (Nat.choose 27 i : ℝ)) *
              (9927882482918400 / ((((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ) * ((3 * m + 32 + i : ℕ) : ℝ) * ((3 * m + 35 + i : ℕ) : ℝ) * ((3 * m + 38 + i : ℕ) : ℝ) * ((3 * m + 41 + i : ℕ) : ℝ) * ((3 * m + 44 + i : ℕ) : ℝ) * ((3 * m + 47 + i : ℕ) : ℝ) * ((3 * m + 50 + i : ℕ) : ℝ) * ((3 * m + 53 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 13 m = (2541865828329 : ℝ) * (Nat.choose (m + 26) 26 : ℝ) *
