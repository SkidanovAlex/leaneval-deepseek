        ((-1 : ℝ) ^ i * (Nat.choose 27 i : ℝ)) *
          (9927882482918400 / genProd 13 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 13) = 2541865828329 := by norm_num
    have h3 : ((3 : ℝ) ^ 13) * (Nat.factorial 13 : ℝ) = 9927882482918400 := by norm_num
    have hr : 2 * 13 + 2 = 28 := by norm_num
