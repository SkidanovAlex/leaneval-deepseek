/-!
# The `(Cintegral)` instance at `n = 5` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 5`
needs no per-degree analytic module: one identifies the parametric summand
`genW 5 ·` with the degree-`5` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralFive_core` (lemma
`genW_five_eq_statement`, via the product expansion `genProd_five`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 5`, `HB_coeff 5`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 5 m i = ∏_{k≤5}(3m+5+1+3k+i)`, expanded -/
lemma genProd_five (m i : ℕ) :
    genProd 5 m i = ((3 * m + 6 + i : ℕ) : ℝ) * ((3 * m + 9 + i : ℕ) : ℝ) * ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`5` instance of the `m`-sum evaluation
`Σₘ genW 5 m = a_5·L(2,χ₋₃) − 2·b_5` -/
theorem genW_five_eq_statement (m : ℕ) :
    genW 5 m = (59049 : ℝ) * (Nat.choose (m + 10) 10 : ℝ) *
          (∑ i ∈ Finset.range 12,
            ((-1 : ℝ) ^ i * (Nat.choose 11 i : ℝ)) *
              (29160 / ((((3 * m + 6 + i : ℕ) : ℝ) * ((3 * m + 9 + i : ℕ) : ℝ) * ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 5 m = (59049 : ℝ) * (Nat.choose (m + 10) 10 : ℝ) *
      (∑ i ∈ Finset.range 12,
        ((-1 : ℝ) ^ i * (Nat.choose 11 i : ℝ)) *
          (29160 / genProd 5 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 5) = 59049 := by norm_num
    have h3 : ((3 : ℝ) ^ 5) * (Nat.factorial 5 : ℝ) = 29160 := by norm_num
    have hr : 2 * 5 + 2 = 12 := by norm_num
    have hb : 2 * 5 = 10 := by norm_num
    have hc : 2 * 5 + 1 = 11 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_five m i]

/-- **the `(Cintegral)` instance at `n = 5`**:
`4653·L(2,χ₋₃) − 727059 / 200 = J_5`. -/
theorem CintegralIdentityAt_five : CintegralIdentityAt 5 := by
  change L2chi3Real * (HA_coeff 5 : ℝ) - 2 * (HB_coeff 5 : ℝ) = cintegralJ 5
  have hA : HA_coeff 5 = 4653 := by native_decide
  have hB : HB_coeff 5 = 727059 / 400 := by native_decide
  have hJ : cintegralJ 5 = (4653 : ℝ) * L2chi3Real - 727059 / 200 := by
    rw [cintegralJ_eq_sum_W_gen 5]
    rw [show (∑' m : ℕ, genW 5 m) = (∑' m : ℕ, (59049 : ℝ) * (Nat.choose (m + 10) 10 : ℝ) *
          (∑ i ∈ Finset.range 12,
            ((-1 : ℝ) ^ i * (Nat.choose 11 i : ℝ)) *
              (29160 / ((((3 * m + 6 + i : ℕ) : ℝ) * ((3 * m + 9 + i : ℕ) : ℝ) * ((3 * m + 12 + i : ℕ) : ℝ) * ((3 * m + 15 + i : ℕ) : ℝ) * ((3 * m + 18 + i : ℕ) : ℝ) * ((3 * m + 21 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_five_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralFive_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 5` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_five_eq_sum_W : cintegralJ 5 = ∑' m : ℕ, genW 5 m :=
  cintegralJ_eq_sum_W_gen 5

end Submission.CDT
