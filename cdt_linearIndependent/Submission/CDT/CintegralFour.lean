/-!
# The `(Cintegral)` instance at `n = 4` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 4`
needs no per-degree analytic module: one identifies the parametric summand
`genW 4 ·` with the degree-`4` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralFour_core` (lemma
`genW_four_eq_statement`, via the product expansion `genProd_four`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 4`, `HB_coeff 4`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 4 m i = ∏_{k≤4}(3m+4+1+3k+i)`, expanded -/
lemma genProd_four (m i : ℕ) :
    genProd 4 m i = ((3 * m + 5 + i : ℕ) : ℝ) * ((3 * m + 8 + i : ℕ) : ℝ) * ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`4` instance of the `m`-sum evaluation
`Σₘ genW 4 m = a_4·L(2,χ₋₃) − 2·b_4` -/
theorem genW_four_eq_statement (m : ℕ) :
    genW 4 m = (6561 : ℝ) * (Nat.choose (m + 8) 8 : ℝ) *
          (∑ i ∈ Finset.range 10,
            ((-1 : ℝ) ^ i * (Nat.choose 9 i : ℝ)) *
              (1944 / ((((3 * m + 5 + i : ℕ) : ℝ) * ((3 * m + 8 + i : ℕ) : ℝ) * ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 4 m = (6561 : ℝ) * (Nat.choose (m + 8) 8 : ℝ) *
      (∑ i ∈ Finset.range 10,
        ((-1 : ℝ) ^ i * (Nat.choose 9 i : ℝ)) *
          (1944 / genProd 4 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 4) = 6561 := by norm_num
    have h3 : ((3 : ℝ) ^ 4) * (Nat.factorial 4 : ℝ) = 1944 := by norm_num
    have hr : 2 * 4 + 2 = 10 := by norm_num
    have hb : 2 * 4 = 8 := by norm_num
    have hc : 2 * 4 + 1 = 9 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_four m i]

/-- **the `(Cintegral)` instance at `n = 4`**:
`639·L(2,χ₋₃) − 3993 / 8 = J_4`. -/
theorem CintegralIdentityAt_four : CintegralIdentityAt 4 := by
  change L2chi3Real * (HA_coeff 4 : ℝ) - 2 * (HB_coeff 4 : ℝ) = cintegralJ 4
  have hA : HA_coeff 4 = 639 := by native_decide
  have hB : HB_coeff 4 = 3993 / 16 := by native_decide
  have hJ : cintegralJ 4 = (639 : ℝ) * L2chi3Real - 3993 / 8 := by
    rw [cintegralJ_eq_sum_W_gen 4]
    rw [show (∑' m : ℕ, genW 4 m) = (∑' m : ℕ, (6561 : ℝ) * (Nat.choose (m + 8) 8 : ℝ) *
          (∑ i ∈ Finset.range 10,
            ((-1 : ℝ) ^ i * (Nat.choose 9 i : ℝ)) *
              (1944 / ((((3 * m + 5 + i : ℕ) : ℝ) * ((3 * m + 8 + i : ℕ) : ℝ) * ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_four_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralFour_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- first instances of `CintegralIdentity` through `n = 4` -/
theorem cintegral_identity_le_four : ∀ n : ℕ, n ≤ 4 → CintegralIdentityAt n := by
  intro n hn
  interval_cases n
  · change L2chi3Real * (HA_coeff 0 : ℝ) - 2 * (HB_coeff 0 : ℝ) = cintegralJ 0
    exact CintegralIdentity_zero
  · change L2chi3Real * (HA_coeff 1 : ℝ) - 2 * (HB_coeff 1 : ℝ) = cintegralJ 1
    exact cintegral_identity_one
  · change L2chi3Real * (HA_coeff 2 : ℝ) - 2 * (HB_coeff 2 : ℝ) = cintegralJ 2
    exact CintegralIdentityAt_two
  · change L2chi3Real * (HA_coeff 3 : ℝ) - 2 * (HB_coeff 3 : ℝ) = cintegralJ 3
    exact CintegralIdentityAt_three
  · change L2chi3Real * (HA_coeff 4 : ℝ) - 2 * (HB_coeff 4 : ℝ) = cintegralJ 4
    exact CintegralIdentityAt_four

/-- the `(Cintegral)` `n = 4` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_four_eq_sum_W : cintegralJ 4 = ∑' m : ℕ, genW 4 m :=
  cintegralJ_eq_sum_W_gen 4

end Submission.CDT
