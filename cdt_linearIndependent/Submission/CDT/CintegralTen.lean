/-!
# The `(Cintegral)` instance at `n = 10` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 10`
needs no per-degree analytic module: one identifies the parametric summand
`genW 10 ·` with the degree-`10` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralTen_core` (lemma
`genW_ten_eq_statement`, via the product expansion `genProd_ten`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 10`, `HB_coeff 10`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 10 m i = ∏_{k≤10}(3m+10+1+3k+i)`, expanded -/
lemma genProd_ten (m i : ℕ) :
    genProd 10 m i = ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ) * ((3 * m + 32 + i : ℕ) : ℝ) * ((3 * m + 35 + i : ℕ) : ℝ) * ((3 * m + 38 + i : ℕ) : ℝ) * ((3 * m + 41 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`10` instance of the `m`-sum evaluation
`Σₘ genW 10 m = a_10·L(2,χ₋₃) − 2·b_10` -/
theorem genW_ten_eq_statement (m : ℕ) :
    genW 10 m = (3486784401 : ℝ) * (Nat.choose (m + 20) 20 : ℝ) *
          (∑ i ∈ Finset.range 22,
            ((-1 : ℝ) ^ i * (Nat.choose 21 i : ℝ)) *
              (214277011200 / ((((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ) * ((3 * m + 32 + i : ℕ) : ℝ) * ((3 * m + 35 + i : ℕ) : ℝ) * ((3 * m + 38 + i : ℕ) : ℝ) * ((3 * m + 41 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 10 m = (3486784401 : ℝ) * (Nat.choose (m + 20) 20 : ℝ) *
      (∑ i ∈ Finset.range 22,
        ((-1 : ℝ) ^ i * (Nat.choose 21 i : ℝ)) *
          (214277011200 / genProd 10 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 10) = 3486784401 := by norm_num
    have h3 : ((3 : ℝ) ^ 10) * (Nat.factorial 10 : ℝ) = 214277011200 := by norm_num
    have hr : 2 * 10 + 2 = 22 := by norm_num
    have hb : 2 * 10 = 20 := by norm_num
    have hc : 2 * 10 + 1 = 21 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_ten m i]

/-- **the `(Cintegral)` instance at `n = 10`**:
`140668065·L(2,χ₋₃) − 4308248502993 / 39200 = J_10`. -/
theorem CintegralIdentityAt_ten : CintegralIdentityAt 10 := by
  change L2chi3Real * (HA_coeff 10 : ℝ) - 2 * (HB_coeff 10 : ℝ) = cintegralJ 10
  have hA : HA_coeff 10 = 140668065 := by native_decide
  have hB : HB_coeff 10 = 4308248502993 / 78400 := by native_decide
  have hJ : cintegralJ 10 = (140668065 : ℝ) * L2chi3Real - 4308248502993 / 39200 := by
    rw [cintegralJ_eq_sum_W_gen 10]
    rw [show (∑' m : ℕ, genW 10 m) = (∑' m : ℕ, (3486784401 : ℝ) * (Nat.choose (m + 20) 20 : ℝ) *
          (∑ i ∈ Finset.range 22,
            ((-1 : ℝ) ^ i * (Nat.choose 21 i : ℝ)) *
              (214277011200 / ((((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ) * ((3 * m + 32 + i : ℕ) : ℝ) * ((3 * m + 35 + i : ℕ) : ℝ) * ((3 * m + 38 + i : ℕ) : ℝ) * ((3 * m + 41 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_ten_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralTen_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 10` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_ten_eq_sum_W : cintegralJ 10 = ∑' m : ℕ, genW 10 m :=
  cintegralJ_eq_sum_W_gen 10

