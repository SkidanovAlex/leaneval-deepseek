/-!
# The `(Cintegral)` instance at `n = 7` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 7`
needs no per-degree analytic module: one identifies the parametric summand
`genW 7 ·` with the degree-`7` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralSeven_core` (lemma
`genW_seven_eq_statement`, via the product expansion `genProd_seven`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 7`, `HB_coeff 7`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 7 m i = ∏_{k≤7}(3m+7+1+3k+i)`, expanded -/
lemma genProd_seven (m i : ℕ) :
    genProd 7 m i = ((3 * m + 8 + i : ℕ) : ℝ) * ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`7` instance of the `m`-sum evaluation
`Σₘ genW 7 m = a_7·L(2,χ₋₃) − 2·b_7` -/
theorem genW_seven_eq_statement (m : ℕ) :
    genW 7 m = (4782969 : ℝ) * (Nat.choose (m + 14) 14 : ℝ) *
          (∑ i ∈ Finset.range 16,
            ((-1 : ℝ) ^ i * (Nat.choose 15 i : ℝ)) *
              (11022480 / ((((3 * m + 8 + i : ℕ) : ℝ) * ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 7 m = (4782969 : ℝ) * (Nat.choose (m + 14) 14 : ℝ) *
      (∑ i ∈ Finset.range 16,
        ((-1 : ℝ) ^ i * (Nat.choose 15 i : ℝ)) *
          (11022480 / genProd 7 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 7) = 4782969 := by norm_num
    have h3 : ((3 : ℝ) ^ 7) * (Nat.factorial 7 : ℝ) = 11022480 := by norm_num
    have hr : 2 * 7 + 2 = 16 := by norm_num
    have hb : 2 * 7 = 14 := by norm_num
    have hc : 2 * 7 + 1 = 15 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_seven m i]

/-- **the `(Cintegral)` instance at `n = 7`**:
`272835·L(2,χ₋₃) − 417806469 / 1960 = J_7`. -/
theorem CintegralIdentityAt_seven : CintegralIdentityAt 7 := by
  change L2chi3Real * (HA_coeff 7 : ℝ) - 2 * (HB_coeff 7 : ℝ) = cintegralJ 7
  have hA : HA_coeff 7 = 272835 := by native_decide
  have hB : HB_coeff 7 = 417806469 / 3920 := by native_decide
  have hJ : cintegralJ 7 = (272835 : ℝ) * L2chi3Real - 417806469 / 1960 := by
    rw [cintegralJ_eq_sum_W_gen 7]
    rw [show (∑' m : ℕ, genW 7 m) = (∑' m : ℕ, (4782969 : ℝ) * (Nat.choose (m + 14) 14 : ℝ) *
          (∑ i ∈ Finset.range 16,
            ((-1 : ℝ) ^ i * (Nat.choose 15 i : ℝ)) *
              (11022480 / ((((3 * m + 8 + i : ℕ) : ℝ) * ((3 * m + 11 + i : ℕ) : ℝ) * ((3 * m + 14 + i : ℕ) : ℝ) * ((3 * m + 17 + i : ℕ) : ℝ) * ((3 * m + 20 + i : ℕ) : ℝ) * ((3 * m + 23 + i : ℕ) : ℝ) * ((3 * m + 26 + i : ℕ) : ℝ) * ((3 * m + 29 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_seven_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralSeven_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 7` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_seven_eq_sum_W : cintegralJ 7 = ∑' m : ℕ, genW 7 m :=
  cintegralJ_eq_sum_W_gen 7

