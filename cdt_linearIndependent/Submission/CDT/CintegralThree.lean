/-!
# The `(Cintegral)` instance at `n = 3` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 3`
needs no per-degree analytic module: one identifies the parametric summand
`genW 3 ·` with the degree-`3` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralThree_core` (lemma
`genW_three_eq_statement`, via the product expansion `genProd_three`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 3`, `HB_coeff 3`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 3 m i = ∏_{k≤3}(3m+3+1+3k+i)`, expanded -/
lemma genProd_three (m i : ℕ) :
    genProd 3 m i = ((3 * m + 4 + i : ℕ) : ℝ) * ((3 * m + 7 + i : ℕ) : ℝ) * ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`3` instance of the `m`-sum evaluation
`Σₘ genW 3 m = a_3·L(2,χ₋₃) − 2·b_3` -/
theorem genW_three_eq_statement (m : ℕ) :
    genW 3 m = (729 : ℝ) * (Nat.choose (m + 6) 6 : ℝ) *
          (∑ i ∈ Finset.range 8,
            ((-1 : ℝ) ^ i * (Nat.choose 7 i : ℝ)) *
              (162 / ((((3 * m + 4 + i : ℕ) : ℝ) * ((3 * m + 7 + i : ℕ) : ℝ) * ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 3 m = (729 : ℝ) * (Nat.choose (m + 6) 6 : ℝ) *
      (∑ i ∈ Finset.range 8,
        ((-1 : ℝ) ^ i * (Nat.choose 7 i : ℝ)) *
          (162 / genProd 3 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 3) = 729 := by norm_num
    have h3 : ((3 : ℝ) ^ 3) * (Nat.factorial 3 : ℝ) = 162 := by norm_num
    have hr : 2 * 3 + 2 = 8 := by norm_num
    have hb : 2 * 3 = 6 := by norm_num
    have hc : 2 * 3 + 1 = 7 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_three m i]

/-- **the `(Cintegral)` instance at `n = 3`**:
`93·L(2,χ₋₃) − 145 / 2 = J_3`. -/
theorem CintegralIdentityAt_three : CintegralIdentityAt 3 := by
  change L2chi3Real * (HA_coeff 3 : ℝ) - 2 * (HB_coeff 3 : ℝ) = cintegralJ 3
  have hA : HA_coeff 3 = 93 := by native_decide
  have hB : HB_coeff 3 = 145 / 4 := by native_decide
  have hJ : cintegralJ 3 = (93 : ℝ) * L2chi3Real - 145 / 2 := by
    rw [cintegralJ_eq_sum_W_gen 3]
    rw [show (∑' m : ℕ, genW 3 m) = (∑' m : ℕ, (729 : ℝ) * (Nat.choose (m + 6) 6 : ℝ) *
          (∑ i ∈ Finset.range 8,
            ((-1 : ℝ) ^ i * (Nat.choose 7 i : ℝ)) *
              (162 / ((((3 * m + 4 + i : ℕ) : ℝ) * ((3 * m + 7 + i : ℕ) : ℝ) * ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_three_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralThree_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- first instances of `CintegralIdentity` through `n = 3` -/
theorem cintegral_identity_le_three : ∀ n : ℕ, n ≤ 3 → CintegralIdentityAt n := by
  intro n hn
  interval_cases n
  · change L2chi3Real * (HA_coeff 0 : ℝ) - 2 * (HB_coeff 0 : ℝ) = cintegralJ 0
    exact CintegralIdentity_zero
  · change L2chi3Real * (HA_coeff 1 : ℝ) - 2 * (HB_coeff 1 : ℝ) = cintegralJ 1
    exact cintegral_identity_one
  · change L2chi3Real * (HA_coeff 2 : ℝ) - 2 * (HB_coeff 2 : ℝ) = cintegralJ 2
    exact CintegralIdentityAt_two
  · change L2chi3Real * (HA_coeff 3 : ℝ) - 2 * (HB_coeff 3 : ℝ) = cintegralJ 3
    exact CintegralIdentityAt_three

/-- the `(Cintegral)` `n = 3` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_three_eq_sum_W : cintegralJ 3 = ∑' m : ℕ, genW 3 m :=
  cintegralJ_eq_sum_W_gen 3

end Submission.CDT
