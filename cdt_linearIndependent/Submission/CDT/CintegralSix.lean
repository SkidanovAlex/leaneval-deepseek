/-!
# The `(Cintegral)` instance at `n = 6` via the general Beukers expansion

Module `Submission.CDT.CintegralGeneral` proves the general-`n` Beukers
expansion `cintegralJ_eq_sum_W_gen`, so the instance `CintegralIdentityAt 6`
needs no per-degree analytic module: one identifies the parametric summand
`genW 6 ·` with the degree-`6` summand of the commons identity
`Commons.Analysis.Summation.sum_cintegralSix_core` (lemma
`genW_six_eq_statement`, via the product expansion `genProd_six`) and applies
that commons identity together with `squareSum_eq_L2chi3` and the values of
`HA_coeff 6`, `HB_coeff 6`.  Generated by
`Scratch/cintegral_generator/mklight_all.py`.
-/

set_option maxHeartbeats 800000

noncomputable section

open scoped BigOperators

namespace Submission.CDT

/-- the parametric product `genProd 6 m i = ∏_{k≤6}(3m+6+1+3k+i)`, expanded -/
lemma genProd_six (m i : ℕ) :
    genProd 6 m i = ((3 * m + 7 + i : ℕ) : ℝ) * ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ) := by
  unfold genProd
  rw [Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_succ, Finset.prod_range_zero, one_mul]

/-- the degree-`6` instance of the `m`-sum evaluation
`Σₘ genW 6 m = a_6·L(2,χ₋₃) − 2·b_6` -/
theorem genW_six_eq_statement (m : ℕ) :
    genW 6 m = (531441 : ℝ) * (Nat.choose (m + 12) 12 : ℝ) *
          (∑ i ∈ Finset.range 14,
            ((-1 : ℝ) ^ i * (Nat.choose 13 i : ℝ)) *
              (524880 / ((((3 * m + 7 + i : ℕ) : ℝ) * ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ)))) ^ 2) := by
  have hL : genW 6 m = (531441 : ℝ) * (Nat.choose (m + 12) 12 : ℝ) *
      (∑ i ∈ Finset.range 14,
        ((-1 : ℝ) ^ i * (Nat.choose 13 i : ℝ)) *
          (524880 / genProd 6 m i) ^ 2) := by
    have h9 : ((9 : ℝ) ^ 6) = 531441 := by norm_num
    have h3 : ((3 : ℝ) ^ 6) * (Nat.factorial 6 : ℝ) = 524880 := by norm_num
    have hr : 2 * 6 + 2 = 14 := by norm_num
    have hb : 2 * 6 = 12 := by norm_num
    have hc : 2 * 6 + 1 = 13 := by norm_num
    unfold genW genCoef genIntTerm'
    rw [hr, hb, hc, h9, h3]
    ring
  rw [hL]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  rw [genProd_six m i]

/-- **the `(Cintegral)` instance at `n = 6`**:
`35169·L(2,χ₋₃) − 5495507 / 200 = J_6`. -/
theorem CintegralIdentityAt_six : CintegralIdentityAt 6 := by
  change L2chi3Real * (HA_coeff 6 : ℝ) - 2 * (HB_coeff 6 : ℝ) = cintegralJ 6
  have hA : HA_coeff 6 = 35169 := by native_decide
  have hB : HB_coeff 6 = 5495507 / 400 := by native_decide
  have hJ : cintegralJ 6 = (35169 : ℝ) * L2chi3Real - 5495507 / 200 := by
    rw [cintegralJ_eq_sum_W_gen 6]
    rw [show (∑' m : ℕ, genW 6 m) = (∑' m : ℕ, (531441 : ℝ) * (Nat.choose (m + 12) 12 : ℝ) *
          (∑ i ∈ Finset.range 14,
            ((-1 : ℝ) ^ i * (Nat.choose 13 i : ℝ)) *
              (524880 / ((((3 * m + 7 + i : ℕ) : ℝ) * ((3 * m + 10 + i : ℕ) : ℝ) * ((3 * m + 13 + i : ℕ) : ℝ) * ((3 * m + 16 + i : ℕ) : ℝ) * ((3 * m + 19 + i : ℕ) : ℝ) * ((3 * m + 22 + i : ℕ) : ℝ) * ((3 * m + 25 + i : ℕ) : ℝ)))) ^ 2)) from
      tsum_congr (fun m => genW_six_eq_statement m)]
    rw [Commons.Analysis.Summation.sum_cintegralSix_core]
    rw [squareSum_eq_L2chi3]
  rw [hJ]
  norm_num [hA, hB]
  ring

/-- the `(Cintegral)` `n = 6` double-integral evaluation, restated through the
general expansion -/
theorem cintegralJ_six_eq_sum_W : cintegralJ 6 = ∑' m : ℕ, genW 6 m :=
  cintegralJ_eq_sum_W_gen 6

