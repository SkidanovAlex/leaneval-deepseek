import Mathlib
import Submission.Subspace.RealRank.Box
import Submission.Subspace.ApproxSpace
import Submission.Commons.GeometryOfNumbers.SuccessiveMinima.exists_successiveMinima_realisers

set_option autoImplicit false
set_option maxHeartbeats 1600000

open scoped BigOperators

namespace Submission.Subspace.RealRank

variable {N : ℕ}

/-- Cardinality of the initial segment of `Fin N` given by `val < j`. -/
lemma card_filter_val_lt {N j : ℕ} (hj : j ≤ N) :
    ((Finset.univ : Finset (Fin N)).filter (fun i => i.val < j)).card = j := by
  have himg : (Finset.univ.filter (fun i : Fin N => i.val < j)).image Fin.val
      = Finset.range j := by
    ext n
    simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_range]
    constructor
    · rintro ⟨i, hi, rfl⟩; exact hi
    · intro hn; exact ⟨⟨n, lt_of_lt_of_le hn hj⟩, hn, rfl⟩
  rw [← Finset.card_image_of_injective _ Fin.val_injective, himg, Finset.card_range]

/-- The dictionary between the successive minima and the rank, at scale `1`. -/
lemma lamS_le_one_iff {N : ℕ} (hN : 1 ≤ N) (L : Fin N → Fin N → ℂ)
    (hdet : (Matrix.of L).det ≠ 0) (c : Fin N → ℝ) {Q : ℝ} (hQ : 1 ≤ Q) {R : ℕ}
    (hR : R = Module.finrank ℚ (approxSpace L c Q)) {i : ℕ} (hi : i < N) :
    lamS L c Q i ≤ 1 ↔ i < R := by
  have hQpos : 0 < Q := lt_of_lt_of_le one_pos hQ
  have hbox : boxT L c Q 1 = approxBox L c Q := by
    ext y; simp only [boxT, approxBox, Set.mem_ofPred_eq, one_mul]
  have hcard : ((Finset.univ : Finset (Fin N)).filter (fun j => lamS L c Q j.val ≤ 1)).card = R := by
    have h1 := rankT_eq_card hN L hdet c hQ 1 (by norm_num : (0:ℝ) ≤ 1)
    have h2 : rankT L c Q 1 = Module.finrank ℚ (approxSpace L c Q) := by
      unfold rankT boxTQ
      rw [hbox]
      rfl
    rw [← h1, hR]
    exact h2
  have hdown : ∀ {a b : ℕ}, a ≤ b → b < N → lamS L c Q b ≤ 1 → lamS L c Q a ≤ 1 := by
    intro a b hab hb h1
    exact le_trans (lamS_mono L c hQpos (by omega) hb) h1
  constructor
  · intro h1
    have hsub : (Finset.univ : Finset (Fin N)).filter (fun j => j.val ≤ i)
        ⊆ (Finset.univ : Finset (Fin N)).filter (fun j => lamS L c Q j.val ≤ 1) := by
      intro j hj
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
      exact hdown hj hi h1
    have hcard2 : ((Finset.univ : Finset (Fin N)).filter (fun j => j.val ≤ i)).card = i + 1 := by
      rw [show (Finset.univ : Finset (Fin N)).filter (fun j => j.val ≤ i)
          = (Finset.univ : Finset (Fin N)).filter (fun j => j.val < i + 1) from by
        apply Finset.filter_congr; intro j _; omega]
      exact card_filter_val_lt (by omega)
    have h2 : i + 1 ≤ R := by
      calc i + 1 = ((Finset.univ : Finset (Fin N)).filter (fun j => j.val ≤ i)).card :=
            hcard2.symm
        _ ≤ _ := Finset.card_le_card hsub
        _ = R := hcard
    omega
  · intro hcon
    by_contra h1
    push_neg at h1
    have hsub : (Finset.univ : Finset (Fin N)).filter (fun j => lamS L c Q j.val ≤ 1)
        ⊆ (Finset.univ : Finset (Fin N)).filter (fun j => j.val < i) := by
      intro j hj
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
      by_contra hlt
      push_neg at hlt
      exact absurd (hdown hlt j.isLt hj) (not_le.mpr h1)
    have h1' : R ≤ i := by
      calc R = _ := hcard.symm
        _ ≤ _ := Finset.card_le_card hsub
        _ = i := card_filter_val_lt (le_of_lt hi)
    omega


/-- Sums over the order embedding of a finset can be written as sums over the finset. -/
lemma sum_orderEmbOfFin_eq_sum {M : Type*} [AddCommMonoid M] {N n : ℕ} (T : Finset (Fin N))
    (hT : T.card = n) (f : Fin N → M) :
    ∑ a : Fin n, f (T.orderEmbOfFin hT a) = ∑ t ∈ T, f t := by
  change ∑ a : Fin n, f ((T.orderEmbOfFin hT).toEmbedding a) = ∑ t ∈ T, f t
  rw [← Finset.sum_map (Finset.univ : Finset (Fin n)) (T.orderEmbOfFin hT).toEmbedding f,
    Finset.map_orderEmbOfFin_univ]

/-- Products over the order embedding of a finset can be written as products over the finset. -/
lemma prod_orderEmbOfFin_eq_prod {M : Type*} [CommMonoid M] {N n : ℕ} (T : Finset (Fin N))
    (hT : T.card = n) (f : Fin N → M) :
    ∏ a : Fin n, f (T.orderEmbOfFin hT a) = ∏ t ∈ T, f t := by
  change ∏ a : Fin n, f ((T.orderEmbOfFin hT).toEmbedding a) = ∏ t ∈ T, f t
  rw [← Finset.prod_map (Finset.univ : Finset (Fin n)) (T.orderEmbOfFin hT).toEmbedding f,
    Finset.map_orderEmbOfFin_univ]

/-- **The box spans the space generated by its first `R` successive-minima realisers.** -/
theorem boxT_span_eq_realisers {N : ℕ} (hN : 1 ≤ N) (L : Fin N → Fin N → ℂ)
    (hdet : (Matrix.of L).det ≠ 0) (c : Fin N → ℝ) {Q : ℝ} (hQ : 1 ≤ Q)
    (x : Fin N → Fin N → ℤ)
    (hxb : ∀ j i, ‖∑ k, L i k * (x j k : ℂ)‖ ≤ lamS L c Q j.val * Q ^ (c i))
    (hxgen : ∀ (j : Fin N) (t : ℝ), 0 < t → t < lamS L c Q j.val → ∀ y : Fin N → ℤ,
      (∀ i, ‖∑ k, L i k * (y k : ℂ)‖ ≤ t * Q ^ (c i)) →
      (fun k => (y k : ℚ)) ∈ Submodule.span ℚ
        (Set.range (fun i : {i : Fin N // i < j} => fun k => (x i.1 k : ℚ))))
    {R : ℕ} (hR : R = Module.finrank ℚ (approxSpace L c Q)) (hRN : R < N) :
    approxSpace L c Q = Submodule.span ℚ
      (Set.range (fun i : {i : Fin N // i.val < R} => fun k => (x i.1 k : ℚ))) := by
  have hQpos : 0 < Q := lt_of_lt_of_le one_pos hQ
  have hbox : boxT L c Q 1 = approxBox L c Q := by
    ext y; simp only [boxT, approxBox, Set.mem_ofPred_eq, one_mul]
  have hQc : ∀ i : Fin N, 0 ≤ Q ^ (c i) := fun i => Real.rpow_nonneg hQpos.le _
  refine le_antisymm ?_ ?_
  · -- every box point lies in the span of the first `R` realisers
    rw [approxSpace, Submodule.span_le]
    rintro v ⟨y, hy, rfl⟩
    have hy' : ∀ i, ‖∑ k, L i k * (y k : ℂ)‖ ≤ 1 * Q ^ (c i) := by
      intro i
      rw [one_mul]
      simpa only [boxT, Set.mem_ofPred_eq] using hy i
    have h1 : (1 : ℝ) < lamS L c Q R := by
      by_contra hle
      push_neg at hle
      have h2 := (lamS_le_one_iff hN L hdet c hQ hR (i := R) hRN).mp hle
      omega
    exact hxgen (⟨R, hRN⟩ : Fin N) 1 zero_lt_one h1 y hy'
  · -- each of the first `R` realisers lies in the box
    rw [Submodule.span_le]
    rintro v ⟨i, rfl⟩
    have h1 : lamS L c Q i.1.val ≤ 1 :=
      (lamS_le_one_iff hN L hdet c hQ hR i.1.isLt).mpr i.2
    have h3 : x i.1 ∈ boxT L c Q 1 := by
      intro j
      exact le_trans (hxb i.1 j) (mul_le_mul_of_nonneg_right h1 (hQc j))
    exact Submodule.subset_span ⟨x i.1, by simpa only [hbox] using h3, rfl⟩

end Submission.Subspace.RealRank
