import Mathlib
import Submission.Subspace.Stage3
import Submission.Subspace.Stage2
import Submission.Commons.LinearAlgebra.FiniteDim.exists_independent_subset_ncard_finrank

/-!
# The approximation domain and the subspace it generates

For a system of linear forms `L : σ → σ → ℂ` and exponents `c : σ → ℝ` with `∑ c i < 0`, the
*approximation domain* (or "box") at scale `Q` is

`approxBox L c Q = {y ∈ ℤ^σ : ∀ i, ‖∑ j, L i j * y j‖ ≤ Q ^ (c i)}`,

and `approxSpace L c Q` is the `ℚ`-span of its image in `ℚ^σ`.  This is the space `Π(Q)` /
`V(Q)` of Schmidt's subspace theorem: every small solution `x` lies in `approxSpace L c ‖x‖`
(`mem_approxSpace_of_mem_box`), and for `Q` large the space is a *proper* subspace
(`approxSpace_ne_top`), by the geometry-of-numbers rank bound
`no_independent_int_points_of_small_domain`.
-/

open scoped BigOperators

namespace Submission.Subspace

variable {σ : Type*} [Fintype σ]

/-- A spanning set of a submodule contains a finite independent subset with `finrank` elements. -/
lemma exists_independent_subset_finrank_of_span {K V : Type*} [Field K] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] (W : Submodule K V) (s : Set V) (hs : s ⊆ W)
    (hsp : Submodule.span K s = W) :
    ∃ t : Set V, t ⊆ s ∧ t.Finite ∧ t.ncard = Module.finrank K ↥W ∧
      LinearIndependent K (Subtype.val : t → V) := by
  classical
  obtain ⟨b, hbs, hbspan, hbli⟩ := exists_linearIndependent K s
  have hbspanW : Submodule.span K b = W := hbspan.trans hsp
  have hbfin : b.Finite := Set.finite_coe_iff.mpr hbli.finite
  haveI : Fintype b := hbfin.fintype
  have h1 : Fintype.card b = Module.finrank K ↥W := by
    have hb : Submodule.span K (Set.range (Subtype.val : b → V)) = Submodule.span K b := by
      rw [Subtype.range_coe]
    rw [← hbspanW, ← hb, finrank_span_eq_card hbli]
  have h2 : Fintype.card b = b.ncard := by
    rw [← hbfin.card_toFinset, Set.ncard_eq_toFinset_card b hbfin]
  exact ⟨b, hbs, hbfin, h2.symm.trans h1, hbli⟩

/-- The approximation domain at scale `Q`: the integer points whose linear-form values are
bounded by `Q ^ (c i)`. -/
def approxBox (L : σ → σ → ℂ) (c : σ → ℝ) (Q : ℝ) : Set (σ → ℤ) :=
  {y | ∀ i : σ, ‖(∑ j : σ, L i j * (y j : ℂ) : ℂ)‖ ≤ Q ^ (c i)}

/-- The `ℚ`-subspace of `ℚ^σ` generated by the approximation domain at scale `Q`. -/
noncomputable def approxSpace (L : σ → σ → ℂ) (c : σ → ℝ) (Q : ℝ) : Submodule ℚ (σ → ℚ) :=
  Submodule.span ℚ (intCastVec '' approxBox L c Q)

lemma mem_approxBox_iff {L : σ → σ → ℂ} {c : σ → ℝ} {Q : ℝ} {y : σ → ℤ} :
    y ∈ approxBox L c Q ↔ ∀ i : σ, ‖(∑ j : σ, L i j * (y j : ℂ) : ℂ)‖ ≤ Q ^ (c i) :=
  Iff.rfl

/-- A point of the approximation domain lies in the subspace it generates. -/
lemma mem_approxSpace_of_mem_box {L : σ → σ → ℂ} {c : σ → ℝ} {Q : ℝ} {y : σ → ℤ}
    (hy : y ∈ approxBox L c Q) : intCastVec y ∈ approxSpace L c Q :=
  Submodule.subset_span ⟨y, hy, rfl⟩

lemma approxSpace_mono {L : σ → σ → ℂ} {c : σ → ℝ} {Q Q' : ℝ}
    (h : approxBox L c Q ⊆ approxBox L c Q') : approxSpace L c Q ≤ approxSpace L c Q' :=
  Submodule.span_mono (Set.image_mono h)

/-- **Rank bound.**  For `Q` large, the space generated by the approximation domain is a
proper subspace of `ℚ^σ`. -/
theorem approxSpace_ne_top (hσ : 2 ≤ Fintype.card σ) (L : σ → σ → ℂ)
    (ind : LinearIndependent ℂ L) (c : σ → ℝ) (hc : ∑ i, c i < 0) :
    ∃ Q₀ : ℝ, 1 ≤ Q₀ ∧ ∀ Q : ℝ, Q₀ ≤ Q → approxSpace L c Q ≠ ⊤ := by
  classical
  obtain ⟨Q₀, hQ₀1, hQ₀⟩ := no_independent_int_points_of_small_domain hσ L ind c hc
  refine ⟨Q₀, hQ₀1, fun Q hQ htop => ?_⟩
  have hspan : Submodule.span ℚ (intCastVec '' approxBox L c Q) = ⊤ := htop
  obtain ⟨t, htT, htfin, htcard, htli⟩ :=
    Commons.LinearAlgebra.FiniteDim.exists_independent_subset_ncard_finrank
      (intCastVec '' approxBox L c Q) hspan
  -- the corresponding set of integer box points
  set s : Set (σ → ℤ) := intCastVec ⁻¹' t with hs
  have himg : intCastVec '' s = t := by
    ext v
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hv
      obtain ⟨y, hy, hyv⟩ := htT hv
      exact ⟨y, by rw [hs, Set.mem_preimage, hyv]; exact hv, hyv⟩
  have hsfin : s.Finite := Set.Finite.preimage (intCastVec_injective.injOn) htfin
  have hsbox : ∀ y ∈ s, y ∈ approxBox L c Q := by
    intro y hy
    have hyt : intCastVec y ∈ t := by rw [hs] at hy; exact hy
    obtain ⟨y', hy', hyv⟩ := htT hyt
    rwa [← intCastVec_injective hyv]
  have hcongr : s.ncard = t.ncard :=
    Set.ncard_congr (fun y _ => intCastVec y)
      (fun y hy => by rw [hs] at hy; exact hy)
      (fun a b _ _ hab => intCastVec_injective hab)
      (fun v hv => by
        have hv' : v ∈ intCastVec '' s := by rw [himg]; exact hv
        obtain ⟨y, hy, hyv⟩ := hv'
        exact ⟨y, hy, hyv⟩)
  have hs_ncard : s.ncard = Fintype.card σ := by
    rw [hcongr, htcard, Module.finrank_fintype_fun_eq_card]
  haveI : Fintype ↥s := hsfin.fintype
  have hcard_s : Fintype.card ↥s = Fintype.card σ := by
    rw [← hsfin.card_toFinset, ← Set.ncard_eq_toFinset_card s hsfin, hs_ncard]
  -- the independence, transported back to integer points
  have hsli : LinearIndependent ℚ (fun y : ↥s => fun j : σ => ((y : σ → ℤ) j : ℚ)) := by
    have hbij : Function.Bijective (fun y : ↥s => (⟨intCastVec (y : σ → ℤ), by
      rw [← himg]; exact ⟨(y : σ → ℤ), y.2, rfl⟩⟩ : ↥t)) := by
      constructor
      · intro a b hab
        exact Subtype.ext (intCastVec_injective (Subtype.ext_iff.mp hab))
      · intro v
        have hv' : (v : σ → ℚ) ∈ intCastVec '' s := by rw [himg]; exact v.2
        obtain ⟨y, hy, hyv⟩ := hv'
        exact ⟨⟨y, hy⟩, Subtype.ext hyv⟩
    let φ : ↥s ≃ ↥t := Equiv.ofBijective _ hbij
    have hcomp := htli.comp φ φ.injective
    have hfun : ((Subtype.val : ↥t → σ → ℚ) ∘ ⇑φ) = fun y : ↥s => intCastVec (y : σ → ℤ) := by
      funext y
      exact congrArg Subtype.val (Equiv.ofBijective_apply _ hbij y)
    rw [hfun] at hcomp
    simpa [intCastVec, Function.comp_def] using hcomp
  -- conclude
  have e : σ ≃ ↥s := Fintype.equivOfCardEq hcard_s.symm
  refine hQ₀ Q hQ ⟨fun i => (e i : σ → ℤ), ?_, ?_⟩
  · have hcomp := hsli.comp e e.injective
    have hfun : ((fun y : ↥s => fun j : σ => ((y : σ → ℤ) j : ℚ)) ∘ e)
        = (fun i : σ => fun j : σ => (((e i : ↥s) : σ → ℤ) j : ℚ)) := rfl
    rw [hfun] at hcomp
    exact hcomp
  · intro i k
    exact hsbox _ (e i).2 k


/-- **Rank bound, finrank form.**  For `Q` large, `approxSpace L c Q` has `ℚ`-dimension
strictly less than `|σ|`. -/
theorem finrank_approxSpace_lt (hσ : 2 ≤ Fintype.card σ) (L : σ → σ → ℂ)
    (ind : LinearIndependent ℂ L) (c : σ → ℝ) (hc : ∑ i, c i < 0) :
    ∃ Q₀ : ℝ, 1 ≤ Q₀ ∧ ∀ Q : ℝ, Q₀ ≤ Q →
      Module.finrank ℚ (approxSpace L c Q) < Fintype.card σ := by
  obtain ⟨Q₀, h1, h2⟩ := approxSpace_ne_top hσ L ind c hc
  refine ⟨Q₀, h1, fun Q hQ => ?_⟩
  have hlt : approxSpace L c Q < ⊤ := lt_of_le_of_ne le_top (h2 Q hQ)
  have hfin := Submodule.finrank_lt_finrank_of_lt hlt
  rwa [finrank_top, Module.finrank_fintype_fun_eq_card] at hfin

/-- **`Fin`-indexed independent box points.**  If `W = span_ℚ (intCastVec '' s)` has
`ℚ`-dimension `k`, then `s` contains `k` points whose images are `ℚ`-linearly independent. -/
lemma exists_fin_box_independent (k : ℕ) (s : Set (σ → ℤ)) (W : Submodule ℚ (σ → ℚ))
    (hs : intCastVec '' s ⊆ W) (hsp : Submodule.span ℚ (intCastVec '' s) = W)
    (hcard : Module.finrank ℚ ↥W = k) :
    ∃ g : Fin k → (σ → ℤ), (∀ i, g i ∈ s) ∧
      LinearIndependent ℚ (fun i : Fin k => intCastVec (g i)) := by
  classical
  obtain ⟨t, ht, htfin, htncard, htli⟩ :=
    exists_independent_subset_finrank_of_span W (intCastVec '' s) hs hsp
  have hk : t.ncard = k := htncard.trans hcard
  haveI : Fintype t := htfin.fintype
  have hc : Fintype.card t = k := by
    rw [← htfin.card_toFinset, ← Set.ncard_eq_toFinset_card t htfin]
    exact hk
  let e : Fin k ≃ t := Fintype.equivOfCardEq (by rw [Fintype.card_fin]; exact hc.symm)
  have hpre : ∀ i : Fin k, ∃ y ∈ s, intCastVec y = (e i : σ → ℚ) := fun i => ht (e i).2
  refine ⟨fun i => Classical.choose (hpre i), fun i => (Classical.choose_spec (hpre i)).1, ?_⟩
  have hcomp := htli.comp e e.injective
  have hfun : ((Subtype.val : t → σ → ℚ) ∘ ⇑e)
      = fun i : Fin k => intCastVec (Classical.choose (hpre i)) := by
    funext i
    exact ((Classical.choose_spec (hpre i)).2).symm
  rw [hfun] at hcomp
  exact hcomp

end Submission.Subspace
