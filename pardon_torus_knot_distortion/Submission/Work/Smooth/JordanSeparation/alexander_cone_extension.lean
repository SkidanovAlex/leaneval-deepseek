import Mathlib

/-!
# The Alexander trick: a homeomorphism of the circle extends to the plane

The **cone (radial) extension** of a homeomorphism `f` of the unit circle `S¹ ⊂ ℂ` is the map

`coneMap f x = ‖x‖ • f (x / ‖x‖)`   (`x ≠ 0`),   `coneMap f 0 = 0`.

It is a norm-preserving homeomorphism of `ℂ` fixing `0` and restricting to `f` on `S¹`
(`alexander_cone_extension`).  This is the two-dimensional Alexander trick, the elementary
"coning" step used by every proof of the Jordan–Schoenflies theorem: it is what turns a
homeomorphism between two boundary circles into a homeomorphism between the discs they bound.

The extension does not depend on the orientation of `f`, and no hypothesis beyond the homeomorphism
is needed.
-/

open Set

namespace Work.Smooth.JordanSeparation

noncomputable section

/-- The direction of a non-zero complex number, as a point of the unit sphere. -/
theorem mem_sphere_div_norm (x : ℂ) (h : x ≠ 0) :
    x / (‖x‖ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
  have hnorm : ‖((‖x‖ : ℝ) : ℂ)‖ = ‖x‖ := by simp
  rw [Metric.mem_sphere, dist_zero_right, norm_div, hnorm]
  exact div_self (norm_ne_zero_iff.mpr h)

/-- A point of the unit sphere is the subtype generated by its own coerced value. -/
@[simp] theorem subtype_mk_sphere_coe {z : Metric.sphere (0 : ℂ) 1}
    (h : (z : ℂ) ∈ Metric.sphere (0 : ℂ) 1) :
    (⟨(z : ℂ), h⟩ : Metric.sphere (0 : ℂ) 1) = z := Subtype.ext rfl

/-- **The cone (radial) extension** of a self-map of the unit circle to the whole plane. -/
def coneMap (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) : ℂ → ℂ :=
  fun x => if h : x = 0 then 0 else
    let z : Metric.sphere (0 : ℂ) 1 := ⟨x / (‖x‖ : ℂ), mem_sphere_div_norm x h⟩
    (‖x‖ : ℂ) * (((f z : Metric.sphere (0 : ℂ) 1)) : ℂ)

@[simp] theorem coneMap_zero (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) :
    coneMap f 0 = 0 := by
  simp [coneMap]

/-- The value of the cone extension off the origin. -/
theorem coneMap_apply (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) {x : ℂ}
    (hx : x ≠ 0) :
    coneMap f x = (‖x‖ : ℂ) *
      (((f ⟨x / (‖x‖ : ℂ), mem_sphere_div_norm x hx⟩ : Metric.sphere (0 : ℂ) 1)) : ℂ) := by
  simp only [coneMap]
  rw [dif_neg hx]

/-- The cone extension is norm preserving. -/
theorem coneMap_norm (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) (x : ℂ) :
    ‖coneMap f x‖ = ‖x‖ := by
  by_cases hx : x = 0
  · rw [hx, coneMap_zero, norm_zero]
  · have h1 : ‖(((f ⟨x / (‖x‖ : ℂ),
        mem_sphere_div_norm x hx⟩ : Metric.sphere (0 : ℂ) 1)) : ℂ)‖ = 1 := by
      have h := (f ⟨x / (‖x‖ : ℂ), mem_sphere_div_norm x hx⟩).2
      rw [Metric.mem_sphere] at h
      simpa [dist_eq_norm] using h
    rw [coneMap_apply f hx, norm_mul, show ‖((‖x‖ : ℝ) : ℂ)‖ = ‖x‖ by simp, h1, mul_one]

/-- The direction of the cone extension at a non-zero point is the image of the direction. -/
theorem coneMap_div_norm (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) {x : ℂ}
    (hx : x ≠ 0) :
    coneMap f x / (‖coneMap f x‖ : ℂ) =
      (((f ⟨x / (‖x‖ : ℂ), mem_sphere_div_norm x hx⟩ : Metric.sphere (0 : ℂ) 1)) : ℂ) := by
  have hnorm : ‖coneMap f x‖ = ‖x‖ := coneMap_norm f x
  rw [hnorm, coneMap_apply f hx,
    mul_div_cancel_left₀ _ (Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr hx))]

/-- The cone extension is continuous. -/
theorem continuous_coneMap (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) :
    Continuous (coneMap f) := by
  rw [continuous_iff_continuousAt]
  intro x
  by_cases hx : x = 0
  · subst hx
    rw [Metric.continuousAt_iff]
    intro ε hε
    exact ⟨ε, hε, fun y hy => by
      have h1 : dist (coneMap f y) (coneMap f 0) = dist y (0 : ℂ) := by
        rw [coneMap_zero, dist_eq_norm, dist_eq_norm, sub_zero, sub_zero, coneMap_norm]
      rwa [h1]⟩
  · have hcontOn : ContinuousOn (coneMap f) {y : ℂ | y ≠ 0} := by
      rw [continuousOn_iff_continuous_domRestrict]
      have heq : (Set.domRestrict {y : ℂ | y ≠ 0} (coneMap f)) =
          fun p : {y : ℂ // y ≠ 0} => (‖(p : ℂ)‖ : ℂ) *
            (((f (⟨(p : ℂ) / (‖(p : ℂ)‖ : ℂ),
                mem_sphere_div_norm (p : ℂ) p.2⟩ : Metric.sphere (0 : ℂ) 1) :
                Metric.sphere (0 : ℂ) 1)) : ℂ) := by
        funext p
        exact coneMap_apply f p.2
      rw [heq]
      have hdiv : Continuous fun p : {y : ℂ // y ≠ 0} =>
          (p : ℂ) / ((‖(p : ℂ)‖ : ℝ) : ℂ) :=
        Continuous.div continuous_subtype_val
          (Complex.continuous_ofReal.comp continuous_subtype_val.norm) (fun p => by
            rw [Complex.ofReal_ne_zero]
            exact norm_ne_zero_iff.mpr p.2)
      have hmk : Continuous fun p : {y : ℂ // y ≠ 0} =>
          (⟨(p : ℂ) / (‖(p : ℂ)‖ : ℂ), mem_sphere_div_norm (p : ℂ) p.2⟩ :
            Metric.sphere (0 : ℂ) 1) :=
        hdiv.subtype_mk (fun p => mem_sphere_div_norm (p : ℂ) p.2)
      exact Continuous.mul
        (Complex.continuous_ofReal.comp continuous_subtype_val.norm)
        ((f.continuous.comp hmk).subtype_val)
    exact hcontOn.continuousAt (isOpen_ne.mem_nhds hx)

/-- The cone extension is a left inverse to the cone extension of the inverse. -/
theorem coneMap_comp (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) (x : ℂ) :
    coneMap f (coneMap f.symm x) = x := by
  by_cases hx : x = 0
  · rw [hx, coneMap_zero, coneMap_zero]
  · have hn : ‖coneMap f.symm x‖ = ‖x‖ := coneMap_norm f.symm x
    have hne : coneMap f.symm x ≠ 0 := by
      rw [← norm_ne_zero_iff, hn]
      exact norm_ne_zero_iff.mpr hx
    have hnormC : ((‖x‖ : ℝ) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr hx)
    have hsub : (⟨coneMap f.symm x / (‖coneMap f.symm x‖ : ℂ),
          mem_sphere_div_norm (coneMap f.symm x) hne⟩ : Metric.sphere (0 : ℂ) 1)
        = f.symm (⟨x / (‖x‖ : ℂ), mem_sphere_div_norm x hx⟩ : Metric.sphere (0 : ℂ) 1) := by
      apply Subtype.ext
      rw [Subtype.coe_mk]
      exact coneMap_div_norm f.symm hx
    rw [coneMap_apply f hne, hsub, Homeomorph.apply_symm_apply, hn]
    exact mul_div_cancel₀ x hnormC

/-- **The Alexander trick.**  Every homeomorphism of the unit circle `S¹ ⊂ ℂ` extends to a
norm-preserving homeomorphism of the plane fixing the origin; in particular it extends to the
closed unit disc, and it agrees with the original map on `S¹`. -/
theorem alexander_cone_extension (f : Metric.sphere (0 : ℂ) 1 ≃ₜ Metric.sphere (0 : ℂ) 1) :
    ∃ F : ℂ ≃ₜ ℂ, F 0 = 0 ∧ (∀ z : Metric.sphere (0 : ℂ) 1, F (z : ℂ) = (f z : ℂ)) ∧
      (∀ x : ℂ, ‖F x‖ = ‖x‖) := by
  have hbd : ∀ z : Metric.sphere (0 : ℂ) 1, coneMap f (z : ℂ) = (f z : ℂ) := by
    intro z
    have hz : ‖(z : ℂ)‖ = 1 := by
      have h := z.2
      rw [Metric.mem_sphere] at h
      simpa [dist_eq_norm] using h
    have hz0 : (z : ℂ) ≠ 0 := by
      rw [← norm_ne_zero_iff, hz]
      norm_num
    have hdirz : (⟨(z : ℂ) / (‖(z : ℂ)‖ : ℂ), mem_sphere_div_norm (z : ℂ) hz0⟩ :
        Metric.sphere (0 : ℂ) 1) = z := by
      apply Subtype.ext
      rw [Subtype.coe_mk, hz]
      simp
    rw [coneMap_apply f hz0, hdirz, hz]
    simp
  refine ⟨Homeomorph.mk ⟨coneMap f, coneMap f.symm, ?_, coneMap_comp f⟩
    (continuous_coneMap f) (continuous_coneMap f.symm), coneMap_zero f, hbd, coneMap_norm f⟩
  exact fun x => by
    simpa [Homeomorph.symm_symm] using coneMap_comp (f := f.symm) x

end

end Work.Smooth.JordanSeparation
