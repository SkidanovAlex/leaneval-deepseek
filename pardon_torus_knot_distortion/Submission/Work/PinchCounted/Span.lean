import Submission.Work.PinchCounted.Counted

/-!
# The span forms of the counted residual

`Defs.lean` states Pardon's pinch with span-preserving local models (`PinchSweep`) and derives
Pardon's Lemma 3 conclusion from it.  This module records the two *span-level* forms of the same
residual, which are the shapes a future stretch is most likely to produce:

* `CollarPushOff P s c σ u` — **the collar form.**  There is a piece `X` of the surface (Pardon's
  collar of the slice: the union of the traces of the necks of the pinching spheres) of vanishing
  winding span such that every loop of the box region lies either in one of the two half-regions or
  in `X`.  This is exactly what Pardon's proof produces: he shows that the loops crossing the slice
  can be routed through the collar, and that the collar carries no essential loop because every
  intermediate sphere meets the knot in fewer than `I(F,β)` points.

  `Span.le_sup_of_splits` then gives `W(boxRegion) ≤ W(halves)` and hence Pardon's Lemma 3
  conclusion.  The local models of the pinching family are *not* needed for this: only the collar
  and the routing.

* `CountedSpanPushOff` — the weakest span form: at every configuration carrying the counting data of
  the crux, `W(boxRegion) ≤ W(halves)`.  It follows from `PinchSweep` (the span is constant along the
  family and the box region contains the collar), and it implies `CountingHalf`.

None of these asks anything at the two *endpoint* traces: the counting is consumed through the
changed pieces of the pinch (see `Counting.lean`, `windingSpan_eq_bot_of_subset_of_count`).
-/

open LeanEval.KnotTheory.PardonDistortion
open Set
open scoped ENNReal

namespace Work.PinchCounted

noncomputable section

variable {P : Work.CoreTopology.ParamTorus}

/-! ## The collar form -/

/-- **The collar form of Pardon's pinch.**  There is a piece `X` of the surface (the collar of the
slice: the union of the traces of the necks of the pinching spheres) which carries no essential
loop, and every loop of the region inside the box lies either in one of the two half-regions or in
`X`.

The two components are exactly what Pardon's proof establishes: the loops crossing the slicing plane
are routed through the neck of the pinching sphere (so that the local models of the pinch are
span-preserving), and the collar is contained in the trace of an intermediate sphere, which meets
the knot in fewer than `I(F,β)` points, so it carries no essential loop. -/
def CollarPushOff (P : Work.CoreTopology.ParamTorus) (s : ℝ) (c : R3)
    (σ : Equiv.Perm (Fin 3)) (u : ℝ) : Prop :=
  ∃ X : Set R3, Work.SurgeryInvariance.WindingSpan P X = ⊥ ∧
    ∀ γ : Work.CoreTopology.ClosedCurve P,
      (∀ t : ℝ, γ t ∈ Work.BoxShrink.Core.boxRegion P s c σ) →
        (∀ t : ℝ, γ t ∈ PinchSweep.halves P s c σ u) ∨ (∀ t : ℝ, γ t ∈ X)

/-- **The span bound from the collar form.**  Pardon's push-off at the level of winding spans: the
winding vectors realised in the box region are generated by those of the two half-regions together
with those of the collar, and the collar contributes nothing
(`Work.SurgeryInvariance.Span.le_sup_of_splits`). -/
theorem windingSpan_le_halves_of_collarPushOff {s : ℝ} {c : R3} {σ : Equiv.Perm (Fin 3)}
    {u : ℝ} (h : CollarPushOff P s c σ u) :
    Work.SurgeryInvariance.WindingSpan P (Work.BoxShrink.Core.boxRegion P s c σ) ≤
      Work.SurgeryInvariance.WindingSpan P (PinchSweep.halves P s c σ u) := by
  obtain ⟨X, hX, hsplits⟩ := h
  exact Work.SurgeryInvariance.Span.le_sup_of_splits hsplits hX

/-- **Pardon's Lemma 3 conclusion from the collar form.** -/
theorem bubbleHalf_of_collarPushOff {s : ℝ} {c : R3} {σ : Equiv.Perm (Fin 3)} {u : ℝ}
    (h : CollarPushOff P s c σ u) : Work.BoxShrink.Bubble.BubbleHalf P s c σ u := by
  intro hbox
  have hle := windingSpan_le_halves_of_collarPushOff h
  have hne : Work.SurgeryInvariance.WindingSpan P (PinchSweep.halves P s c σ u) ≠ ⊥ := by
    intro hbot
    have hzero : Work.SurgeryInvariance.WindingSpan P (Work.BoxShrink.Core.boxRegion P s c σ) = ⊥ :=
      le_antisymm (hbot ▸ hle) bot_le
    exact (Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mpr hbox hzero
  have hnot : ¬ (Work.SurgeryInvariance.WindingSpan P
        (Work.BoxShrink.Core.upperRegion P s c σ u) = ⊥ ∧
        Work.SurgeryInvariance.WindingSpan P (Work.BoxShrink.Core.lowerRegion P s c σ u) = ⊥) := by
    intro hcon
    exact hne (by rw [PinchSweep.windingSpan_halves P s c σ u, hcon.1, hcon.2, sup_bot_eq])
  rcases not_and_or.mp hnot with h' | h'
  · exact Or.inl ((Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mp h')
  · exact Or.inr ((Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mp h')

/-- **A `PinchSweep` gives a collar form.**  The piece `Z` of the pinching family (the trace of
the pinching disc) is the collar: it is of vanishing span, and if every loop of the box region can
be routed through the halves or through `Z`, then the collar form of the residual holds.  The
routing is exactly the geometric content of Pardon's pinch. -/
theorem collarPushOff_of_pinchSweep {s : ℝ} {c : R3} {σ : Equiv.Perm (Fin 3)} {u : ℝ}
    (D : PinchSweep P s c σ u) (hsplits : ∀ γ : Work.CoreTopology.ClosedCurve P,
      (∀ t : ℝ, γ t ∈ Work.BoxShrink.Core.boxRegion P s c σ) →
        (∀ t : ℝ, γ t ∈ PinchSweep.halves P s c σ u) ∨
          (∀ t : ℝ, γ t ∈ D.Z)) :
    CollarPushOff P s c σ u :=
  ⟨D.Z, D.Z_span, hsplits⟩

/-! ## The collar can be absorbed into the loop transport -/

/-- **The transport form of the collar.**  If every loop of the box region is matched, with its
winding vector, by a loop of `halves ∪ X` — and `X` is an open piece of vanishing span disjoint from
the two half-regions — then the span of the box region equals that of the two half-regions, so
Pardon's Lemma 3 conclusion holds.

This is strictly sharper than `CollarPushOff`: the routing condition there is *set-theoretic* (every
loop of the box region is contained in a half or in `X`), whereas here it is enough that the loops of
the box region are *matched* by loops of `halves ∪ X`, which is what Pardon's pinch produces. -/
theorem bubbleHalf_of_regionEquivalent_collar {s : ℝ} {c : R3} {σ : Equiv.Perm (Fin 3)} {u : ℝ}
    {X : Set R3} (hXopen : Work.SurgeryInvariance.IsOpenInCarrier P X)
    (hXspan : Work.SurgeryInvariance.WindingSpan P X = ⊥)
    (hXdisj : Disjoint (PinchSweep.halves P s c σ u) X)
    (h : Work.SurgeryInvariance.RegionEquivalent P
      (PinchSweep.halves P s c σ u ∪ X) (Work.BoxShrink.Core.boxRegion P s c σ)) :
    Work.BoxShrink.Bubble.BubbleHalf P s c σ u := by
  have hspan : Work.SurgeryInvariance.WindingSpan P (Work.BoxShrink.Core.boxRegion P s c σ) =
      Work.SurgeryInvariance.WindingSpan P (PinchSweep.halves P s c σ u) := by
    rw [← Work.SurgeryInvariance.RegionEquivalent.windingSpan_eq h,
      Work.SurgeryInvariance.Span.union_eq_sup (PinchSweep.isOpenInCarrier_halves P s c σ u)
        hXopen hXdisj, hXspan, sup_bot_eq]
  intro hbox
  have hne : Work.SurgeryInvariance.WindingSpan P (PinchSweep.halves P s c σ u) ≠ ⊥ := by
    rw [← hspan]
    exact (Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mpr hbox
  have hnot : ¬ (Work.SurgeryInvariance.WindingSpan P
        (Work.BoxShrink.Core.upperRegion P s c σ u) = ⊥ ∧
        Work.SurgeryInvariance.WindingSpan P (Work.BoxShrink.Core.lowerRegion P s c σ u) = ⊥) := by
    intro hcon
    exact hne (by rw [PinchSweep.windingSpan_halves P s c σ u, hcon.1, hcon.2, sup_bot_eq])
  rcases not_and_or.mp hnot with h' | h'
  · exact Or.inl ((Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mp h')
  · exact Or.inr ((Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mp h')

/-! ## The span form of the counted residual -/

/-- **The counted residual in its weakest span form**: at every configuration carrying the counting
data of the crux, the winding span of the region inside the box is contained in that of the two
half-regions.  This is the sharpest consequence of Pardon's counting in the span vocabulary: it
says the pinch loses nothing essential.

Pardon's proof gives it through the intermediate spheres (`|S_t ∩ β| < I(F,β)`, so every changed
piece of the pinch is inessential, so the span is constant); the count at the two endpoints alone
does *not* give it — the local models at the pinch are what the counting buys. -/
def CountedSpanPushOff : Prop :=
  ∀ (p q : ℕ) (_hp : 0 < p) (_hq : 0 < q) (_hc : Nat.Coprime p q)
    (ψ : Submission.Diffeo) (K : Knot) (d : ℝ) (_hd : 0 ≤ d),
    Work.Sweep.IsDistortionBound K d →
    Set.range K.curve = Set.range
      (Work.CoreTopology.ClosedCurve.mapHomeomorph ψ.toHomeomorph
        (Work.CoreTopology.standardCurve p q)).γ →
    Submission.countConst * d < (Nat.min p q : ℝ) →
    Work.InnermostDisk.CleansDiscs (Work.Smooth.Morse.torus ψ) →
    ∀ (r : ℝ) (_hr : 0 < r) (c : R3) (σ : Equiv.Perm (Fin 3)),
      Submission.HasEssBox (Work.Smooth.Morse.torus ψ) r c σ →
      ∀ (s : ℝ) (_hrs : r < s) (_hs : s < (1 + Submission.eps) * r),
        Work.BoxShrink.SlicedSphere (Work.Smooth.Morse.torus ψ)
            {y : R3 | Submission.boxNorm c σ y = s} →
        ∀ (u : ℝ) (_hu : |u| < Submission.eps * r),
          ((↑(Set.encard {t : ℝ | t ∈ Set.Ico 0 (2 * Real.pi) ∧
              Submission.boxNorm c σ (K.curve t) = s}) : ENNReal)
            ≤ ENNReal.ofReal (10 * (1 + Submission.eps) / Submission.eps * d)) →
          ((↑(Set.encard {t : ℝ | t ∈ Set.Ico 0 (2 * Real.pi) ∧
              K.curve t ∈ Submission.PBox s c σ ∧
              (K.curve t) (σ 2) = c (σ 2) + u}) : ENNReal)
            ≤ ENNReal.ofReal (5 * (1 + Submission.eps) / Submission.eps * d)) →
          Work.SurgeryInvariance.WindingSpan (Work.Smooth.Morse.torus ψ)
              (Work.BoxShrink.Core.boxRegion (Work.Smooth.Morse.torus ψ) s c σ) ≤
            Work.SurgeryInvariance.WindingSpan (Work.Smooth.Morse.torus ψ)
              (PinchSweep.halves (Work.Smooth.Morse.torus ψ) s c σ u)

/-- **The sweep residual gives the span residual.** -/
theorem countedSpanPushOff_of_countedPinchSweep (h : CountedPinchSweep) : CountedSpanPushOff :=
  fun p q hp hq hc ψ K d hd hbound himg hsmall hcl r hr c σ hbox s hrs hs hslice u hu hS hU =>
    le_of_eq (PinchSweep.windingSpan_boxRegion_eq
      (h p q hp hq hc ψ K d hd hbound himg hsmall hcl r hr c σ hbox s hrs hs hslice u hu
        hS hU).some)

/-- **The span form of the counted residual gives the counted residual of the ledger**:
`Work.BoxShrink.Pinch.CountingHalf`. -/
theorem countingHalf_of_countedSpanPushOff (h : CountedSpanPushOff) :
    Work.BoxShrink.Pinch.CountingHalf := by
  intro p q hp hq hc ψ K d hd hbound himg hsmall hcl r hr c σ hbox s hrs hs hslice u hu hS hU hbox'
  set P := Work.Smooth.Morse.torus ψ with hP
  have hle := h p q hp hq hc ψ K d hd hbound himg hsmall hcl r hr c σ hbox s hrs hs hslice u hu
    hS hU
  have hne : Work.SurgeryInvariance.WindingSpan P (PinchSweep.halves P s c σ u) ≠ ⊥ := by
    intro hbot
    have hzero : Work.SurgeryInvariance.WindingSpan P
        (Work.BoxShrink.Core.boxRegion P s c σ) = ⊥ :=
      le_antisymm (hbot ▸ hle) bot_le
    exact (Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mpr hbox' hzero
  have hnot : ¬ (Work.SurgeryInvariance.WindingSpan P
        (Work.BoxShrink.Core.upperRegion P s c σ u) = ⊥ ∧
        Work.SurgeryInvariance.WindingSpan P (Work.BoxShrink.Core.lowerRegion P s c σ u) = ⊥) := by
    intro hcon
    exact hne (by rw [PinchSweep.windingSpan_halves P s c σ u, hcon.1, hcon.2, sup_bot_eq])
  rcases not_and_or.mp hnot with h' | h'
  · exact Or.inl ((Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mp h')
  · exact Or.inr ((Work.SurgeryInvariance.windingSpan_ne_bot_iff P _).mp h')

end

end Work.PinchCounted
