import Mathlib
import Submission.Work.BoxShrink.PinchOff.IB.Pieces
import Submission.Work.Smooth.Jordan.Defs

/-!
# The covering projection of the parameter plane onto the surface

The parameter plane of a parametrised torus `P` is the complex plane `ℂ` (see
`Work.BoxShrink.PinchOff.planePsi`), and the parametrisation is a covering map of `ℂ` onto the
surface `F = P.carrier` with deck group the lattice `2π(ℤ + iℤ)` generated by the period
translations `periodPt a b`.

This file provides

* `planeCover P`, the parametrisation as a map `ℂ → Set.range (planePsi P)`, and the fact that it
  is a **covering map** (`isCoveringMap_planeCover`), obtained from the sibling
  `Work.TorusCover.isCoveringMap_psiMapToRange_param` by transporting along the homeomorphism
  `ℂ ≃ₜ ℝ × ℝ`;
* the description of its **fibres** (`planePsi_eq_iff`): two parameter points have the same image on
  the surface exactly when they differ by a period lattice element;
* the lattice bookkeeping: `periodLattice` is a **discrete** subset of `ℂ`.
-/

open LeanEval.KnotTheory.PardonDistortion
open Set

namespace Work.BoxShrink.PinchOff

noncomputable section

/-! ## The covering map -/

/-- The parametrisation of the plane, viewed as a map onto the surface `P.carrier`. -/
def planeCover (P : Work.CoreTopology.ParamTorus) : ℂ → P.carrier :=
  fun z => ⟨planePsi P z, P.psi_mem_carrier z.re z.im⟩

@[simp] theorem planeCover_coe (P : Work.CoreTopology.ParamTorus) (z : ℂ) :
    (planeCover P z : R3) = planePsi P z := rfl

theorem continuous_planeCover (P : Work.CoreTopology.ParamTorus) : Continuous (planeCover P) :=
  (continuous_planePsi P).subtype_mk _

/-- The carrier of the torus is the range of the plane parametrisation. -/
theorem range_planePsi_eq_carrier (P : Work.CoreTopology.ParamTorus) :
    Set.range (planePsi P) = P.carrier := by
  ext x
  constructor
  · rintro ⟨z, rfl⟩
    exact P.psi_mem_carrier z.re z.im
  · rintro ⟨p, hp⟩
    exact ⟨(p.1 : ℂ) + (p.2 : ℂ) * Complex.I, by simp [planePsi, hp]⟩

theorem mem_range_planePsi_iff (P : Work.CoreTopology.ParamTorus) {x : R3} :
    x ∈ Set.range (planePsi P) ↔ x ∈ P.carrier := by
  rw [range_planePsi_eq_carrier]

/-- **The parametrisation of the plane is a covering map onto the surface.**  It is the transport,
along the homeomorphism `ℂ ≃ₜ ℝ × ℝ`, of the covering map `psiMapToRange psi` of the sibling
chapter `Work.TorusCover`. -/
theorem isCoveringMap_planeCover (P : Work.CoreTopology.ParamTorus) :
    IsCoveringMap (planeCover P) := by
  have h1 : IsCoveringMap (Work.TorusCover.psiMapToRange P.psi) :=
    Work.TorusCover.isCoveringMap_psiMapToRange_param P
  have h2 : IsCoveringMap (fun z : ℂ =>
      Work.TorusCover.psiMapToRange P.psi (Complex.equivRealProdCLM.toHomeomorph z)) :=
    h1.comp_homeomorph Complex.equivRealProdCLM.toHomeomorph
  have hfun : (fun z : ℂ => Work.TorusCover.psiMapToRange P.psi
      (Complex.equivRealProdCLM.toHomeomorph z)) = planeCover P := by
    funext z
    apply Subtype.ext
    simp [planeCover, planePsi, Work.TorusCover.psiMapToRange, Complex.equivRealProd]
  rwa [hfun] at h2

/-! ## The model disc: instances needed for the lifting theorem -/

instance instContractibleSpaceDisc : ContractibleSpace Work.Smooth.Jordan.Disc :=
  (convex_closedBall (0 : ℂ) 1).contractibleSpace ⟨0, by simp⟩

instance instLocallyPathConnectedSpaceDisc : LocallyPathConnectedSpace Work.Smooth.Jordan.Disc := by
  refine LocallyPathConnectedSpace.of_bases (p := fun _ (r : ℝ) => 0 < r)
    (s := fun x r => Metric.ball x r) (fun x => Metric.nhds_basis_ball) ?_
  intro x r hr
  have hconv : Convex ℝ (Metric.ball (x : ℂ) r ∩ Metric.closedBall (0 : ℂ) 1) :=
    (convex_ball (x : ℂ) r).inter (convex_closedBall 0 1)
  have hne : (Metric.ball (x : ℂ) r ∩ Metric.closedBall (0 : ℂ) 1).Nonempty :=
    ⟨(x : ℂ), Metric.mem_ball_self hr, x.2⟩
  have h := (hconv.isPathConnected hne).preimage_coe
    (U := Metric.closedBall (0 : ℂ) 1) (fun y hy => hy.2)
  convert h using 1
  ext y
  simp only [Set.mem_preimage, Set.mem_inter_iff, Metric.mem_ball, Subtype.coe_prop, and_true,
    Subtype.dist_eq]

/-! ## The fibres of the covering -/

theorem periodPt_add (a b c d : ℤ) :
    periodPt a b + periodPt c d = periodPt (a + c) (b + d) := by
  apply Complex.ext <;> simp [periodPt] <;> push_cast <;> ring

theorem periodPt_neg (a b : ℤ) : -periodPt a b = periodPt (-a) (-b) := by
  apply Complex.ext <;> simp [periodPt] <;> push_cast <;> ring

/-- **The fibres of the covering projection are the orbits of the period lattice.** -/
theorem planePsi_eq_iff {P : Work.CoreTopology.ParamTorus} {z w : ℂ} :
    planePsi P z = planePsi P w ↔ w - z ∈ periodLattice := by
  rw [planePsi_apply, planePsi_apply, P.inj_mod z.re z.im w.re w.im, mem_periodLattice]
  constructor
  · rintro ⟨⟨k, hk⟩, ⟨l, hl⟩⟩
    refine ⟨-k, -l, ?_⟩
    apply Complex.ext
    · simp only [periodPt_re, Complex.sub_re]
      rw [hk]; push_cast; ring
    · simp only [periodPt_im, Complex.sub_im]
      rw [hl]; push_cast; ring
  · rintro ⟨a, b, hab⟩
    constructor
    · refine ⟨-a, ?_⟩
      have hre := congrArg Complex.re hab
      simp only [periodPt_re, Complex.sub_re] at hre
      push_cast
      linarith
    · refine ⟨-b, ?_⟩
      have him := congrArg Complex.im hab
      simp only [periodPt_im, Complex.sub_im] at him
      push_cast
      linarith

/-- Distinct parameter points with the same image on the surface differ by a period. -/
theorem sub_mem_periodLattice_of_planePsi_eq {P : Work.CoreTopology.ParamTorus} {z w : ℂ}
    (h : planePsi P z = planePsi P w) : w - z ∈ periodLattice :=
  planePsi_eq_iff.mp h

theorem planePsi_eq_of_sub_mem_periodLattice {P : Work.CoreTopology.ParamTorus} {z w : ℂ}
    (h : w - z ∈ periodLattice) : planePsi P z = planePsi P w :=
  planePsi_eq_iff.mpr h

/-! ## The period lattice as a discrete subset of `ℂ` -/

theorem zero_mem_periodLattice : (0 : ℂ) ∈ periodLattice :=
  (mem_periodLattice 0).mpr ⟨0, 0, by simp [periodPt]⟩

theorem periodLattice_add_mem {z w : ℂ} (hz : z ∈ periodLattice) (hw : w ∈ periodLattice) :
    z + w ∈ periodLattice := by
  obtain ⟨a, b, rfl⟩ := (mem_periodLattice z).mp hz
  obtain ⟨c, d, rfl⟩ := (mem_periodLattice w).mp hw
  exact (mem_periodLattice _).mpr ⟨a + c, b + d, (periodPt_add a b c d).symm⟩

theorem periodLattice_neg_mem {z : ℂ} (hz : z ∈ periodLattice) : -z ∈ periodLattice := by
  obtain ⟨a, b, rfl⟩ := (mem_periodLattice z).mp hz
  exact (mem_periodLattice _).mpr ⟨-a, -b, (periodPt_neg a b).symm⟩

theorem periodLattice_sub_mem {z w : ℂ} (hz : z ∈ periodLattice) (hw : w ∈ periodLattice) :
    z - w ∈ periodLattice := by
  simpa [sub_eq_add_neg] using periodLattice_add_mem hz (periodLattice_neg_mem hw)

theorem norm_periodPt_sq (a b : ℤ) :
    ‖periodPt a b‖ ^ 2 = (2 * Real.pi) ^ 2 * ((a : ℝ) ^ 2 + (b : ℝ) ^ 2) := by
  rw [Complex.sq_norm, Complex.normSq_apply, periodPt_re, periodPt_im]
  ring

/-- A nonzero lattice point of the plane has norm at least `2π`. -/
theorem two_pi_le_norm_periodPt {a b : ℤ} (h : (a, b) ≠ 0) :
    2 * Real.pi ≤ ‖periodPt a b‖ := by
  have hsum : (1 : ℝ) ≤ (a : ℝ) ^ 2 + (b : ℝ) ^ 2 := by
    have key : ∀ n : ℤ, n ≠ 0 → (1 : ℝ) ≤ (n : ℝ) ^ 2 := by
      intro n hn
      have h1 : (1 : ℤ) ≤ |n| := by
        have : (0 : ℤ) < |n| := abs_pos.mpr hn
        omega
      have h2 : (1 : ℝ) ≤ |(n : ℝ)| := by exact_mod_cast h1
      rw [← sq_abs (n : ℝ)]
      nlinarith [abs_nonneg (n : ℝ)]
    rcases eq_or_ne a 0 with ha | ha
    · have hb : b ≠ 0 := fun hb => h (Prod.ext ha hb)
      have h1 := key b hb
      nlinarith [sq_nonneg (a : ℝ)]
    · have h1 := key a ha
      nlinarith [sq_nonneg (b : ℝ)]
  have hsq := norm_periodPt_sq a b
  have h2 : ((2 : ℝ) * Real.pi) ^ 2 ≤ ‖periodPt a b‖ ^ 2 := by
    rw [hsq]
    have hp : (0 : ℝ) < (2 * Real.pi) ^ 2 := by positivity
    nlinarith
  have h3 : (0 : ℝ) ≤ ‖periodPt a b‖ := norm_nonneg _
  nlinarith [Real.pi_pos]

/-- A nonzero lattice point of the plane has norm at least `2π`. -/
theorem two_pi_le_norm_of_mem_periodLattice {z : ℂ} (hz : z ∈ periodLattice) (h0 : z ≠ 0) :
    2 * Real.pi ≤ ‖z‖ := by
  obtain ⟨a, b, hab⟩ := (mem_periodLattice z).mp hz
  have hne : (a, b) ≠ 0 := by
    intro hh
    refine h0 ?_
    have h1 : a = 0 := congrArg Prod.fst hh
    have h2 : b = 0 := congrArg Prod.snd hh
    rw [← hab, h1, h2]
    simp [periodPt]
  rw [← hab]
  exact two_pi_le_norm_periodPt hne

/-- **The period lattice is discrete.** -/
theorem isDiscrete_periodLattice : IsDiscrete (periodLattice : Set ℂ) := by
  rw [isDiscrete_iff_forall_mem_exists_isOpen]
  intro p hp
  refine ⟨Metric.ball p Real.pi, Metric.isOpen_ball, ?_⟩
  ext q
  rw [Set.mem_inter_iff, Set.mem_singleton_iff, Metric.mem_ball, dist_eq_norm]
  constructor
  · rintro ⟨hdist, hq⟩
    by_contra hne
    have hdiff : q - p ∈ periodLattice := periodLattice_sub_mem hq hp
    have hne0 : q - p ≠ 0 := sub_ne_zero.mpr hne
    have hge := two_pi_le_norm_of_mem_periodLattice hdiff hne0
    linarith [Real.pi_pos]
  · rintro rfl
    exact ⟨by simpa using Real.pi_pos, hp⟩

end

end Work.BoxShrink.PinchOff
