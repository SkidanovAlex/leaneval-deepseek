import Mathlib
import Submission.Work.SurgeryInvariance.Defs

namespace Work.PinchLemma3.ClosedDiscA

/-- Integer multiples of a real number `T` that lies in the "period group" of a set `P`
(via the closure of the additive subgroup generated by `T`) are again periods of `P`.
Auxiliary form: membership of a zsmul of `T` in the closure of `{T}`. -/
private lemma mem_closure_singleton_zsmul (T : ℝ) (k : ℤ) :
    k • T ∈ AddSubgroup.closure ({T} : Set ℝ) :=
  AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_singleton T)) k

/-- If `T` is a period of the set `P` (in the sense that `t + T ∈ P ↔ t ∈ P` for all `t`),
then so is every integer multiple of `T`. -/
private lemma mem_add_zsmul {T : ℝ} {P : Set ℝ} (hP : ∀ t : ℝ, t + T ∈ P ↔ t ∈ P)
    (k : ℤ) (t : ℝ) : t + k • T ∈ P ↔ t ∈ P := by
  let S : AddSubgroup ℝ :=
    { carrier := {s : ℝ | ∀ t : ℝ, t + s ∈ P ↔ t ∈ P}
      zero_mem' := by intro t; simp
      add_mem' := by
        intro a b ha hb t
        rw [← add_assoc]
        exact (hb (t + a)).trans (ha t)
      neg_mem' := by
        intro a ha t
        have h := ha (t + (-a))
        rw [add_assoc, neg_add_cancel, add_zero] at h
        exact h.symm }
  have hT : T ∈ S := hP
  have hle : AddSubgroup.closure ({T} : Set ℝ) ≤ S :=
    (AddSubgroup.closure_le S).2 (by intro x hx; rw [Set.mem_singleton_iff] at hx; subst hx; exact hT)
  exact hle (mem_closure_singleton_zsmul T k) t

/-- The distance to a nonempty set is invariant under translation by an integer multiple
of a period of that set. -/
private lemma infDist_add_zsmul {T : ℝ} {Q : Set ℝ} (hQne : Q.Nonempty)
    (hQ : ∀ t : ℝ, t + T ∈ Q ↔ t ∈ Q) (k : ℤ) (t : ℝ) :
    Metric.infDist (t + k • T) Q = Metric.infDist t Q := by
  have hstep : ∀ t : ℝ, Metric.infDist (t + T) Q = Metric.infDist t Q := by
    intro t
    refine le_antisymm ?_ ?_
    · rw [Metric.le_infDist hQne]
      intro y hy
      calc Metric.infDist (t + T) Q ≤ dist (t + T) (y + T) :=
            Metric.infDist_le_dist_of_mem ((hQ y).2 hy)
        _ = dist t y := by rw [Real.dist_eq, Real.dist_eq]; congr 1; ring
    · rw [Metric.le_infDist hQne]
      intro y hy
      have hy' : y - T ∈ Q := (hQ (y - T)).1 (by simpa using hy)
      calc Metric.infDist t Q ≤ dist t (y - T) := Metric.infDist_le_dist_of_mem hy'
        _ = dist (t + T) y := by rw [Real.dist_eq, Real.dist_eq]; congr 1; ring
  let S : AddSubgroup ℝ :=
    { carrier := {s : ℝ | ∀ t : ℝ, Metric.infDist (t + s) Q = Metric.infDist t Q}
      zero_mem' := by intro t; simp
      add_mem' := by
        intro a b ha hb t
        rw [← add_assoc]
        exact (hb (t + a)).trans (ha t)
      neg_mem' := by
        intro a ha t
        have h := ha (t + (-a))
        rw [add_assoc, neg_add_cancel, add_zero] at h
        exact h.symm }
  have hT : T ∈ S := hstep
  have hle : AddSubgroup.closure ({T} : Set ℝ) ≤ S :=
    (AddSubgroup.closure_le S).2 (by intro x hx; rw [Set.mem_singleton_iff] at hx; subst hx; exact hT)
  exact hle (mem_closure_singleton_zsmul T k) t

/-- Every real number can be translated into the fundamental window `[0, T]` by an integer
multiple of `T > 0`. -/
private lemma exists_int_smul_add_mem_Icc {T : ℝ} (hT : 0 < T) (x : ℝ) :
    ∃ k : ℤ, x + k • T ∈ Set.Icc 0 T := by
  let n : ℤ := ⌊x / T⌋
  have hkx : x + (-n) • T = x - (n : ℝ) * T := by
    rw [neg_zsmul, zsmul_eq_mul T n, sub_eq_add_neg]
  refine ⟨-n, ?_⟩
  rw [hkx, Set.mem_Icc]
  have h1 : (n : ℝ) * T ≤ x := (le_div_iff₀ hT).mp (Int.floor_le (x / T))
  have h2 : x < ((n : ℝ) + 1) * T := (div_lt_iff₀ hT).mp (Int.lt_floor_add_one (x / T))
  constructor <;> linarith

/-- Two disjoint nonempty closed subsets of `ℝ`, both invariant under translation by `2 * π`,
are separated by a positive distance. -/
theorem exists_separation {P Q : Set ℝ} (hPc : IsClosed P) (hQc : IsClosed Q)
    (hPp : ∀ t, t + 2 * Real.pi ∈ P ↔ t ∈ P) (hQp : ∀ t, t + 2 * Real.pi ∈ Q ↔ t ∈ Q)
    (hPne : P.Nonempty) (hQne : Q.Nonempty) (hdisj : Disjoint P Q) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ p ∈ P, ∀ q ∈ Q, δ ≤ |p - q| := by
  set T : ℝ := 2 * Real.pi with hTdef
  have hTpos : 0 < T := by rw [hTdef]; positivity
  have hPper : ∀ t : ℝ, t + T ∈ P ↔ t ∈ P := by intro t; rw [hTdef]; exact hPp t
  have hQper : ∀ t : ℝ, t + T ∈ Q ↔ t ∈ Q := by intro t; rw [hTdef]; exact hQp t
  have hKc : IsCompact (P ∩ Set.Icc 0 T) := isCompact_Icc.inter_left hPc
  have hKne : (P ∩ Set.Icc 0 T).Nonempty := by
    obtain ⟨p, hpP⟩ := hPne
    obtain ⟨k, hk⟩ := exists_int_smul_add_mem_Icc hTpos p
    exact ⟨p + k • T, (mem_add_zsmul hPper k p).2 hpP, hk⟩
  obtain ⟨p₀, hp₀K, hmin⟩ :=
    hKc.exists_isMinOn hKne (Metric.continuous_infDist_pt Q).continuousOn
  refine ⟨Metric.infDist p₀ Q, ?_, ?_⟩
  · rw [← IsClosed.notMem_iff_infDist_pos hQc hQne]
    exact fun hq => (Set.disjoint_left.mp hdisj) hp₀K.1 hq
  · intro p hpP q hqQ
    obtain ⟨k, hk⟩ := exists_int_smul_add_mem_Icc hTpos p
    have hpK : p + k • T ∈ P ∩ Set.Icc 0 T := ⟨(mem_add_zsmul hPper k p).2 hpP, hk⟩
    calc Metric.infDist p₀ Q ≤ Metric.infDist (p + k • T) Q := hmin hpK
      _ = Metric.infDist p Q := infDist_add_zsmul hQne hQper k p
      _ ≤ dist p q := Metric.infDist_le_dist_of_mem hqQ
      _ = |p - q| := Real.dist_eq p q

end Work.PinchLemma3.ClosedDiscA
