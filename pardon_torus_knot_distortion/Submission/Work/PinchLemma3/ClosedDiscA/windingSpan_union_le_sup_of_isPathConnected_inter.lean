import Mathlib
import Submission.Work.SurgeryInvariance.Defs
import Submission.Work.SurgeryInvariance.WindingOf.homotopic_eq
import Submission.Work.PinchLemma3.ClosedDiscA.exists_alternating_partition
import Submission.Work.PinchLemma3.ClosedDiscA.exists_functional_kernel_eq

/-!
# The winding span is subadditive over two pieces with path-connected intersection

`Work.PinchLemma3.ClosedDiscA.windingSpan_union_le_sup_of_isPathConnected_inter`:
if `A, B` are open in the carrier of a parametrised torus and `A ∩ B` is path connected, then
the winding span of `A ∪ B` is contained in the supremum of the winding spans of `A` and of `B`.

This is the curve-level form of the fact (van Kampen) that the fundamental group of `A ∪ B` is
generated by the images of `π₁(A)` and `π₁(B)` when `A ∩ B` is path connected.

The proof decomposes a closed curve `γ` of `A ∪ B` into finitely many monochromatic arcs
alternating between `A` and `B`, whose endpoints lie in `A ∩ B`; running the `A`-arcs and the
`B`-arcs, joined up inside `A ∩ B`, produces closed curves `α ⊆ A`, `β ⊆ B` with
`winding γ = winding α + winding β`.

## Layout of the file

* `psiDisp` — the `ψ`-image of the displacement of a path in the parameter plane, an additive
  well-defined quantity attached to any path in the carrier;
* `closedCurveOfPath` — the closed curve obtained by reparametrising a loop on the unit interval;
* `exists_alternating_decomposition` — the monochromatic alternating partition;
* the final assembly.
-/

open LeanEval.KnotTheory.PardonDistortion Set

namespace Work.PinchLemma3.ClosedDiscA

noncomputable section

open scoped unitInterval

variable {P : Work.CoreTopology.ParamTorus}

/-! ## 1. Path lifting in the parameter plane -/

/-- The covering map associated with the parametrisation. -/
theorem isCoveringMap_psiMapToRange_param' (P : Work.CoreTopology.ParamTorus) :
    IsCoveringMap (Work.TorusCover.psiMapToRange P.psi) :=
  Work.TorusCover.isCoveringMap_psiMapToRange_param P

/-- The carrier is, by definition, the range of the parametrisation. -/
theorem carrier_eq_range_param (P : Work.CoreTopology.ParamTorus) :
    P.carrier = Set.range (Work.TorusCover.psiMap P.psi) := rfl

/-- **Path lifting.** A path `u` in the carrier with a lift `ξ` of its starting point lifts to a
continuous path `Λ` in the parameter plane with `Λ 0 = ξ` and `psiMap P.psi ∘ Λ = u`. -/
theorem exists_liftPath {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) :
    ∃ Λ : C(unitInterval, ℝ × ℝ), Λ 0 = ξ ∧
      ∀ t : unitInterval, Work.TorusCover.psiMap P.psi (Λ t) = (u t : R3) := by
  have cov := isCoveringMap_psiMapToRange_param' P
  have h0 : (u.toContinuousMap : C(unitInterval, Set.range (Work.TorusCover.psiMap P.psi))) 0
      = Work.TorusCover.psiMapToRange P.psi ξ := by
    refine Subtype.ext ?_
    show (u 0 : R3) = Work.TorusCover.psiMap P.psi ξ
    rw [hξ]
    exact congrArg Subtype.val u.source
  refine ⟨cov.liftPath u.toContinuousMap ξ h0, cov.liftPath_zero _ _ _, fun t => ?_⟩
  have h := congrFun (cov.liftPath_lifts u.toContinuousMap ξ h0) t
  have h' := congrArg (fun z : Set.range (Work.TorusCover.psiMap P.psi) => (z : R3)) h
  exact h'


/-! ## 2. The `ψ`-displacement of a path -/

/-- A chosen lift of a point of the carrier. -/
theorem psiMap_choose (x : P.carrier) :
    Work.TorusCover.psiMap P.psi (Classical.choose x.2) = (x : R3) := by
  simpa [Work.TorusCover.psiMap] using Classical.choose_spec x.2

/-- The parametrisation is invariant under translations by lattice vectors. -/
theorem psiMap_add_lattice_param (P : Work.CoreTopology.ParamTorus) (p q : ℝ × ℝ)
    (hq : q ∈ Work.TorusCover.lattice) :
    Work.TorusCover.psiMap P.psi (p + q) = Work.TorusCover.psiMap P.psi p := by
  obtain ⟨k, l, rfl⟩ := (Work.TorusCover.mem_lattice_iff' q).mp hq
  simp only [Work.TorusCover.psiMap_apply, Prod.fst_add, Prod.snd_add]
  refine (P.inj_mod _ _ _ _).mpr ⟨⟨k, by ring⟩, ⟨l, by ring⟩⟩

/-- The basepoint condition of path lifting. -/
theorem liftPath_base {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) :
    (u.toContinuousMap : C(unitInterval, Set.range (Work.TorusCover.psiMap P.psi))) 0
      = Work.TorusCover.psiMapToRange P.psi ξ :=
  u.source.trans (Subtype.ext hξ).symm

/-- Lifting a path in the carrier to the parameter plane, from a prescribed lift of its start. -/
noncomputable def liftPath' {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) : C(unitInterval, ℝ × ℝ) :=
  (isCoveringMap_psiMapToRange_param' P).liftPath u.toContinuousMap ξ (liftPath_base u ξ hξ)

theorem liftPath'_lifts {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) (t : unitInterval) :
    Work.TorusCover.psiMap P.psi (liftPath' u ξ hξ t) = (u t : R3) := by
  have h := congrFun ((isCoveringMap_psiMapToRange_param' P).liftPath_lifts u.toContinuousMap ξ
    (liftPath_base u ξ hξ)) t
  have h' := congrArg (fun z : Set.range (Work.TorusCover.psiMap P.psi) => (z : R3)) h
  exact h'

theorem liftPath'_zero {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) : liftPath' u ξ hξ 0 = ξ :=
  (isCoveringMap_psiMapToRange_param' P).liftPath_zero u.toContinuousMap ξ (liftPath_base u ξ hξ)

/-- **The `ψ`-displacement of a path.**  The displacement of a path in the parameter plane,
pushed forward by a linear map `ψ`; this is independent of the choice of lift of the starting
point (`psiDisp_eq`). -/
noncomputable def psiDisp {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    {x y : P.carrier} (u : Path x y) : W :=
  ψ (liftPath' u (Classical.choose x.2) (psiMap_choose x) 1) - ψ (Classical.choose x.2)

/-- **The characterising property of `psiDisp`**: it is computed with any lift of the start. -/
theorem psiDisp_eq {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) :
    psiDisp ψ u = ψ (liftPath' u ξ hξ 1) - ψ ξ := by
  have hξ₀ : Work.TorusCover.psiMap P.psi (Classical.choose x.2) = (x : R3) := psiMap_choose x
  have hlam : ξ - Classical.choose x.2 ∈ Work.TorusCover.lattice :=
    (Work.TorusCover.psiMap_eq_iff_param P).mp (hξ.trans hξ₀.symm)
  have hshift : (⟨fun t : unitInterval =>
          liftPath' u (Classical.choose x.2) hξ₀ t + (ξ - Classical.choose x.2),
        (liftPath' u (Classical.choose x.2) hξ₀).continuous.add continuous_const⟩ :
          C(unitInterval, ℝ × ℝ))
      = liftPath' u ξ hξ := by
    show (⟨fun t : unitInterval =>
          liftPath' u (Classical.choose x.2) hξ₀ t + (ξ - Classical.choose x.2),
        (liftPath' u (Classical.choose x.2) hξ₀).continuous.add continuous_const⟩ :
          C(unitInterval, ℝ × ℝ))
      = (isCoveringMap_psiMapToRange_param' P).liftPath u.toContinuousMap ξ (liftPath_base u ξ hξ)
    refine ((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff'
      (liftPath_base u ξ hξ)).mpr ⟨?_, ?_⟩
    · funext t
      refine Subtype.ext ?_
      show Work.TorusCover.psiMap P.psi
          (liftPath' u (Classical.choose x.2) hξ₀ t + (ξ - Classical.choose x.2)) = (u t : R3)
      rw [psiMap_add_lattice_param P _ _ hlam]
      exact liftPath'_lifts u (Classical.choose x.2) hξ₀ t
    · show liftPath' u (Classical.choose x.2) hξ₀ 0 + (ξ - Classical.choose x.2) = ξ
      rw [liftPath'_zero]
      abel
  have hval : liftPath' u ξ hξ 1
      = liftPath' u (Classical.choose x.2) hξ₀ 1 + (ξ - Classical.choose x.2) := by
    rw [← hshift]
    rfl
  rw [show psiDisp ψ u
      = ψ (liftPath' u (Classical.choose x.2) hξ₀ 1) - ψ (Classical.choose x.2) from rfl,
    hval, map_add, map_sub]
  abel

/-- The lift of a path, as a `Path` in the parameter plane. -/
noncomputable def liftPathP {x y : P.carrier} (u : Path x y) (ξ : ℝ × ℝ)
    (hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3)) : Path ξ (liftPath' u ξ hξ 1) :=
  ⟨liftPath' u ξ hξ, liftPath'_zero u ξ hξ, rfl⟩

/-- **Additivity of the `ψ`-displacement under concatenation of paths.** -/
theorem psiDisp_trans {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    {x y z : P.carrier} (u : Path x y) (v : Path y z) :
    psiDisp ψ (u.trans v) = psiDisp ψ u + psiDisp ψ v := by
  set ξ : ℝ × ℝ := Classical.choose x.2 with hξdef
  have hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3) := psiMap_choose x
  have hη : Work.TorusCover.psiMap P.psi (liftPath' u ξ hξ 1) = (y : R3) :=
    (liftPath'_lifts u ξ hξ 1).trans (congrArg Subtype.val u.target)
  have hglue : ((liftPathP u ξ hξ).trans (liftPathP v (liftPath' u ξ hξ 1) hη)).toContinuousMap
      = (isCoveringMap_psiMapToRange_param' P).liftPath (u.trans v).toContinuousMap ξ
          (liftPath_base (u.trans v) ξ hξ) := by
    refine ((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff'
      (liftPath_base (u.trans v) ξ hξ)).mpr ⟨?_, ?_⟩
    · funext t
      refine Subtype.ext ?_
      show Work.TorusCover.psiMap P.psi
        (((liftPathP u ξ hξ).trans (liftPathP v (liftPath' u ξ hξ 1) hη)) t) = ((u.trans v) t : R3)
      by_cases ht : (t : ℝ) ≤ 1 / 2
      · rw [Path.trans_apply, dif_pos ht, Path.trans_apply, dif_pos ht]
        exact liftPath'_lifts u ξ hξ _
      · rw [Path.trans_apply, dif_neg ht, Path.trans_apply, dif_neg ht]
        exact liftPath'_lifts v (liftPath' u ξ hξ 1) hη _
    · show ((liftPathP u ξ hξ).trans (liftPathP v (liftPath' u ξ hξ 1) hη)) 0 = ξ
      rw [Path.trans_apply, dif_pos (show (((0 : unitInterval) : ℝ) ≤ 1 / 2) from by norm_num)]
      exact (congrArg (liftPathP u ξ hξ)
        (Subtype.ext (by norm_num : (2 : ℝ) * (0 : ℝ) = 0))).trans (liftPathP u ξ hξ).source
  have h1 : liftPath' (u.trans v) ξ hξ 1 = liftPath' v (liftPath' u ξ hξ 1) hη 1 := by
    have h2 := congrArg (fun (w : C(unitInterval, ℝ × ℝ)) => w 1) hglue
    rw [show liftPath' (u.trans v) ξ hξ 1
        = (isCoveringMap_psiMapToRange_param' P).liftPath (u.trans v).toContinuousMap ξ
            (liftPath_base (u.trans v) ξ hξ) 1 from rfl, ← h2]
    show (((liftPathP u ξ hξ).trans (liftPathP v (liftPath' u ξ hξ 1) hη)) :
      Path ξ (liftPath' v (liftPath' u ξ hξ 1) hη 1)) 1 = _
    rw [Path.trans_apply, dif_neg (show ¬ (((1 : unitInterval) : ℝ) ≤ 1 / 2) from by norm_num)]
    exact (congrArg (liftPathP v (liftPath' u ξ hξ 1) hη)
      (Subtype.ext (by norm_num : (2 : ℝ) * (1 : ℝ) - 1 = 1))).trans
        (liftPathP v (liftPath' u ξ hξ 1) hη).target
  rw [psiDisp_eq ψ (u.trans v) ξ hξ, psiDisp_eq ψ u ξ hξ,
    psiDisp_eq ψ v (liftPath' u ξ hξ 1) hη, h1]
  abel

/-- **The `ψ`-displacement of the reverse of a path is the negative.** -/
theorem psiDisp_symm {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    {x y : P.carrier} (u : Path x y) : psiDisp ψ u.symm = - psiDisp ψ u := by
  set ξ : ℝ × ℝ := Classical.choose x.2 with hξdef
  have hξ : Work.TorusCover.psiMap P.psi ξ = (x : R3) := psiMap_choose x
  have hη : Work.TorusCover.psiMap P.psi (liftPath' u ξ hξ 1) = (y : R3) :=
    (liftPath'_lifts u ξ hξ 1).trans (congrArg Subtype.val u.target)
  have hrev : ((liftPathP u ξ hξ).symm).toContinuousMap
      = (isCoveringMap_psiMapToRange_param' P).liftPath u.symm.toContinuousMap
          (liftPath' u ξ hξ 1) (liftPath_base u.symm (liftPath' u ξ hξ 1) hη) := by
    refine ((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff'
      (liftPath_base u.symm (liftPath' u ξ hξ 1) hη)).mpr ⟨?_, ?_⟩
    · funext t
      refine Subtype.ext ?_
      show Work.TorusCover.psiMap P.psi (((liftPathP u ξ hξ).symm) t) = (u.symm t : R3)
      rw [Path.symm_apply, Path.symm_apply]
      exact liftPath'_lifts u ξ hξ _
    · show (((liftPathP u ξ hξ).symm)) 0 = liftPath' u ξ hξ 1
      rw [Path.symm_apply]
      exact (congrArg (liftPathP u ξ hξ)
        (Subtype.ext (by norm_num : (1 : ℝ) - (0 : ℝ) = 1))).trans (liftPathP u ξ hξ).target
  have h1 : liftPath' u.symm (liftPath' u ξ hξ 1) hη 1 = ξ := by
    have h2 := congrArg (fun (w : C(unitInterval, ℝ × ℝ)) => w 1) hrev
    rw [show liftPath' u.symm (liftPath' u ξ hξ 1) hη 1
        = (isCoveringMap_psiMapToRange_param' P).liftPath u.symm.toContinuousMap
            (liftPath' u ξ hξ 1) (liftPath_base u.symm (liftPath' u ξ hξ 1) hη) 1 from rfl, ← h2]
    show (((liftPathP u ξ hξ).symm) : Path (liftPath' u ξ hξ 1) ξ) 1 = ξ
    rw [Path.symm_apply]
    exact (congrArg (liftPathP u ξ hξ)
      (Subtype.ext (by norm_num : (1 : ℝ) - (1 : ℝ) = 0))).trans (liftPathP u ξ hξ).source
  rw [psiDisp_eq ψ u.symm (liftPath' u ξ hξ 1) hη, h1, psiDisp_eq ψ u ξ hξ]
  abel

/-! ## 3. Loops as closed curves, and the winding of a loop -/

/-- The clamp of a real number to the unit interval. -/
def clampI (s : ℝ) : unitInterval :=
  ⟨min (max s 0) 1, le_min (le_max_right s 0) zero_le_one, min_le_right (max s 0) 1⟩

theorem clampI_coe (s : ℝ) : (clampI s : ℝ) = min (max s 0) 1 := rfl

theorem continuous_clampI : Continuous clampI :=
  ((continuous_id.max continuous_const).min continuous_const).subtype_mk _

theorem clampI_zero : clampI 0 = (0 : unitInterval) := by ext; simp [clampI]

theorem clampI_one : clampI 1 = (1 : unitInterval) := by ext; simp [clampI]

theorem clampI_eq {s : ℝ} (h : s ∈ Set.Icc 0 1) : clampI s = ⟨s, h⟩ := by
  ext; simp [clampI, max_eq_left h.1, min_eq_left h.2]

/-- **A loop on the unit interval, as a closed curve.**  The loop `u : Path x x` is
reparametrised to the circle `ℝ/2πℤ`; the construction goes through the quotient so that the
continuity is automatic (the parametrisation is `u ∘ clamp` on `[0,1]`, whose endpoints agree). -/
noncomputable def closedCurveOfPath {x : P.carrier} (u : Path x x) :
    Work.CoreTopology.ClosedCurve P where
  γ := fun t : ℝ =>
    ((AddCircle.liftIco (1 : ℝ) 0 (fun s : ℝ => u (clampI s)))
      ((t / (2 * Real.pi) : ℝ) : AddCircle (1 : ℝ)) : R3)
  cont := by
    have h1 : Continuous (fun t : ℝ => ((t / (2 * Real.pi) : ℝ) : AddCircle (1 : ℝ))) :=
      (AddCircle.continuous_mk' (1 : ℝ)).comp (continuous_id.div_const _)
    have hf : (fun s : ℝ => u (clampI s)) 0 = (fun s : ℝ => u (clampI s)) 1 := by
      show u (clampI 0) = u (clampI 1)
      rw [clampI_zero, clampI_one]
      exact u.source.trans u.target.symm
    have hc : ContinuousOn (fun s : ℝ => u (clampI s)) (Set.Icc 0 1) :=
      (u.continuous.comp continuous_clampI).continuousOn
    exact continuous_subtype_val.comp
      ((AddCircle.liftIco_zero_continuous (f := fun s : ℝ => u (clampI s)) hf hc).comp h1)
  periodic := by
    intro t
    show ((AddCircle.liftIco (1 : ℝ) 0 (fun s : ℝ => u (clampI s)))
        (((t + 2 * Real.pi) / (2 * Real.pi) : ℝ) : AddCircle (1 : ℝ)) : R3) = _
    congr 1
    rw [show (t + 2 * Real.pi) / (2 * Real.pi) = t / (2 * Real.pi) + 1 from by
      rw [add_div, div_self (by positivity : (2 * Real.pi : ℝ) ≠ 0)], AddCircle.coe_add_period]
  mem := fun t => (AddCircle.liftIco (1 : ℝ) 0 (fun s : ℝ => u (clampI s)) _).2

theorem closedCurveOfPath_apply {x : P.carrier} (u : Path x x) (t : unitInterval) :
    (closedCurveOfPath u).γ (2 * Real.pi * (t : ℝ)) = (u t : R3) := by
  show ((AddCircle.liftIco (1 : ℝ) 0 (fun s : ℝ => u (clampI s)))
      (((2 * Real.pi * (t : ℝ)) / (2 * Real.pi) : ℝ) : AddCircle (1 : ℝ)) : R3) = _
  rw [show (2 * Real.pi * (t : ℝ)) / (2 * Real.pi) = (t : ℝ) from by field_simp]
  by_cases ht : (t : ℝ) < 1
  · rw [AddCircle.liftIco_zero_coe_apply (p := (1 : ℝ)) (f := fun s : ℝ => u (clampI s))
      (x := (t : ℝ)) ⟨unitInterval.nonneg t, ht⟩]
    exact congrArg Subtype.val
      (by rw [clampI_eq ⟨unitInterval.nonneg t, unitInterval.le_one t⟩])
  · have ht1 : (t : ℝ) = 1 := le_antisymm (unitInterval.le_one t) (not_lt.mp ht)
    have hpt : ((t : ℝ) : AddCircle (1 : ℝ)) = ((0 : ℝ) : AddCircle (1 : ℝ)) := by
      rw [ht1, AddCircle.coe_period, AddCircle.coe_zero]
    rw [hpt, AddCircle.liftIco_zero_coe_apply (p := (1 : ℝ)) (f := fun s : ℝ => u (clampI s))
      (x := (0 : ℝ)) ⟨le_refl 0, one_pos⟩]
    rw [clampI_zero]
    exact congrArg Subtype.val (u.source.trans (u.target.symm.trans
      (congrArg u (Subtype.ext ht1).symm)))

/-- **The `ψ`-displacement of a loop is the `ψ`-image of its period displacement.** -/
theorem psiDisp_eq_psi_periodShift {W : Type*} [AddCommGroup W] [Module ℝ W]
    (ψ : (ℝ × ℝ) →ₗ[ℝ] W) {x : P.carrier} (u : Path x x) :
    psiDisp ψ u = ψ (Work.TorusCover.periodShift
      (Work.SurgeryInvariance.windingOf P (closedCurveOfPath u))) := by
  obtain ⟨L⟩ := Work.TorusCover.ParamTorus_exists_liftOf P (closedCurveOfPath u)
  set Λ : ℝ → ℝ × ℝ := fun t => (L.Θ t, L.Φ t) with hΛ
  have hΛc : Continuous Λ := L.contΘ.prodMk L.contΦ
  have hΛlift : ∀ t : ℝ, Work.TorusCover.psiMap P.psi (Λ t) = (closedCurveOfPath u).γ t := by
    intro t
    simp only [hΛ, Work.TorusCover.psiMap]
    exact L.lifts t
  have hγ0 : (closedCurveOfPath u).γ 0 = (x : R3) := by
    have h := closedCurveOfPath_apply u (0 : unitInterval)
    rw [show (2 * Real.pi * ((0 : unitInterval) : ℝ)) = 0 from by norm_num] at h
    rw [h]
    exact congrArg Subtype.val u.source
  have hξ : Work.TorusCover.psiMap P.psi (Λ 0) = (x : R3) := by
    rw [hΛlift 0, hγ0]
  have hlift2 : (⟨fun t : unitInterval => Λ (2 * Real.pi * (t : ℝ)),
        hΛc.comp (continuous_const.mul continuous_subtype_val)⟩ : C(unitInterval, ℝ × ℝ))
      = liftPath' u (Λ 0) hξ := by
    show (⟨fun t : unitInterval => Λ (2 * Real.pi * (t : ℝ)),
        hΛc.comp (continuous_const.mul continuous_subtype_val)⟩ : C(unitInterval, ℝ × ℝ))
      = (isCoveringMap_psiMapToRange_param' P).liftPath u.toContinuousMap (Λ 0)
          (liftPath_base u (Λ 0) hξ)
    refine ((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff'
      (liftPath_base u (Λ 0) hξ)).mpr ⟨?_, ?_⟩
    · funext t
      refine Subtype.ext ?_
      show Work.TorusCover.psiMap P.psi (Λ (2 * Real.pi * (t : ℝ))) = (u t : R3)
      rw [hΛlift (2 * Real.pi * (t : ℝ))]
      exact closedCurveOfPath_apply u t
    · show Λ (2 * Real.pi * ((0 : unitInterval) : ℝ)) = Λ 0
      norm_num
  have h1 : liftPath' u (Λ 0) hξ 1 = Λ (2 * Real.pi) := by
    rw [← hlift2]
    norm_num
  have hper : Λ (2 * Real.pi) = Λ 0 + Work.TorusCover.periodShift L.winding := by
    have hw := L.winding_spec
    ext
    · simpa [hΛ, Work.TorusCover.periodShift] using hw.1
    · simpa [hΛ, Work.TorusCover.periodShift] using hw.2
  rw [psiDisp_eq ψ u (Λ 0) hξ, h1, ← map_sub,
    show Λ (2 * Real.pi) - Λ 0 = Work.TorusCover.periodShift L.winding from by
      rw [hper]; abel,
    ← Work.SurgeryInvariance.windingOf_eq P (closedCurveOfPath u) L]

/-- The image of `closedCurveOfPath u` is contained in any set containing the image of `u`. -/
theorem closedCurveOfPath_apply_mem {x : P.carrier} (u : Path x x) (X : Set R3)
    (hu : ∀ t : unitInterval, (u t : R3) ∈ X) (t : ℝ) : (closedCurveOfPath u).γ t ∈ X := by
  set y : AddCircle (1 : ℝ) := ((t / (2 * Real.pi) : ℝ) : AddCircle (1 : ℝ)) with hy
  have h3 : (((AddCircle.equivIco (1 : ℝ) 0 y : Set.Ico (0 : ℝ) (0 + 1))) : AddCircle (1 : ℝ)) = y :=
    AddCircle.coe_equivIco ..
  show ((AddCircle.liftIco (1 : ℝ) 0 (fun s : ℝ => u (clampI s))) y : R3) ∈ X
  rw [← h3, AddCircle.liftIco_coe_apply (p := (1 : ℝ)) (a := (0 : ℝ))
    (f := fun s : ℝ => u (clampI s))
    (x := ((AddCircle.equivIco (1 : ℝ) 0 y : Set.Ico (0 : ℝ) (0 + 1)) : ℝ))
    (AddCircle.equivIco (1 : ℝ) 0 y).2]
  exact hu _

/-- **A loop whose image lies in a region of vanishing winding content has vanishing
`ψ`-displacement**, provided `ψ` kills the integer vectors of `V`. -/
theorem psiDisp_eq_zero_of_subset {W : Type*} [AddCommGroup W] [Module ℝ W]
    {V : Submodule ℚ (ℚ × ℚ)} (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    (hψ : ∀ v : ℤ × ℤ, ((v.1 : ℚ), (v.2 : ℚ)) ∈ V → ψ ((v.1 : ℝ), (v.2 : ℝ)) = 0)
    {X : Set R3} (hVX : Work.SurgeryInvariance.WindingSpan P X ≤ V)
    {x : P.carrier} (u : Path x x) (hu : ∀ t : unitInterval, (u t : R3) ∈ X) :
    psiDisp ψ u = 0 := by
  rw [psiDisp_eq_psi_periodShift ψ u]
  set w : ℤ × ℤ := Work.SurgeryInvariance.windingOf P (closedCurveOfPath u) with hwdef
  have hmem : ((w.1 : ℚ), (w.2 : ℚ)) ∈ V := by
    refine hVX (Submodule.subset_span ⟨closedCurveOfPath u,
      fun t => closedCurveOfPath_apply_mem u X hu t, ?_⟩)
    rfl
  rw [show Work.TorusCover.periodShift w
      = (2 * Real.pi) • (((w.1 : ℝ), (w.2 : ℝ)) : ℝ × ℝ) from by
        ext <;> simp [Work.TorusCover.periodShift, smul_eq_mul, mul_comm]]
  rw [map_smul, hψ w hmem, smul_zero]

/-! ## 4. Concatenating loops, and the displacement of a sub-arc -/

/-- The `ψ`-displacement of a constant path vanishes. -/
theorem psiDisp_refl {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    (p : P.carrier) : psiDisp ψ (Path.refl p) = 0 := by
  rw [psiDisp_eq ψ (Path.refl p) (Classical.choose p.2) (psiMap_choose p)]
  have hconst : liftPath' (Path.refl p) (Classical.choose p.2) (psiMap_choose p)
      = ContinuousMap.const unitInterval (Classical.choose p.2) := by
    show (isCoveringMap_psiMapToRange_param' P).liftPath (Path.refl p).toContinuousMap
        (Classical.choose p.2) (liftPath_base (Path.refl p) (Classical.choose p.2) (psiMap_choose p))
      = ContinuousMap.const unitInterval (Classical.choose p.2)
    refine (((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff' _).mpr ⟨?_, ?_⟩).symm
    · funext t
      refine Subtype.ext ?_
      show Work.TorusCover.psiMap P.psi (Classical.choose p.2) = ((Path.refl p) t : R3)
      rw [psiMap_choose, Path.refl_apply]
    · rfl
  rw [hconst]
  simp

/-- **The concatenation of a finite family of loops based at `p`.** -/
noncomputable def glueLoops {p : P.carrier} : ∀ (n : ℕ), (Fin n → Path p p) → Path p p
  | 0, _ => Path.refl p
  | n + 1, f => (glueLoops n (fun j => f j.castSucc)).trans (f (Fin.last n))

/-- **The `ψ`-displacement of a concatenation of loops is the sum of the displacements.** -/
theorem psiDisp_glueLoops {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    {p : P.carrier} : ∀ (n : ℕ) (f : Fin n → Path p p),
    psiDisp ψ (glueLoops n f) = ∑ j : Fin n, psiDisp ψ (f j)
  | 0, f => by simp [glueLoops, psiDisp_refl]
  | n + 1, f => by
      rw [glueLoops, psiDisp_trans, psiDisp_glueLoops ψ n]
      rw [Fin.sum_univ_castSucc]

/-- The image of a concatenation of loops is contained in any set containing the images. -/
theorem glueLoops_mem {p : P.carrier} {X : Set R3} (hp : (p : R3) ∈ X) :
    ∀ (n : ℕ) (f : Fin n → Path p p),
      (∀ j t, (f j t : R3) ∈ X) → ∀ t : unitInterval, ((glueLoops n f) t : R3) ∈ X
  | 0, f, _, t => by
      simpa [glueLoops, Path.refl_apply] using hp
  | n + 1, f, hf, t => by
      rw [glueLoops, Path.trans_apply]
      by_cases ht : (t : ℝ) ≤ 1 / 2
      · rw [dif_pos ht]
        exact glueLoops_mem hp n (fun j => f j.castSucc) (fun j s => hf j.castSucc s) _
      · rw [dif_neg ht]
        exact hf (Fin.last n) _

/-- The sub-arc of a closed curve between two parameters, as a path in the carrier. -/
noncomputable def subArc (γ : Work.CoreTopology.ClosedCurve P) (a b : ℝ) :
    Path (⟨γ a, γ.mem a⟩ : P.carrier) ⟨γ b, γ.mem b⟩ where
  toContinuousMap :=
    ⟨fun t : unitInterval => ⟨γ (a + (t : ℝ) * (b - a)), γ.mem _⟩,
      (γ.cont.comp (continuous_const.add (continuous_subtype_val.mul continuous_const))).subtype_mk _⟩
  source' := Subtype.ext (by simp)
  target' := by
    refine Subtype.ext ?_
    show γ (a + ((1 : unitInterval) : ℝ) * (b - a)) = γ b
    congr 1
    rw [show (((1 : unitInterval)) : ℝ) = 1 from rfl]
    ring

/-- **The `ψ`-displacement of a sub-arc of `γ` is the difference of the values of a lift.** -/
theorem psiDisp_subArc {W : Type*} [AddCommGroup W] [Module ℝ W] (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    (γ : Work.CoreTopology.ClosedCurve P) (a b : ℝ) (Λ : ℝ → ℝ × ℝ) (hΛc : Continuous Λ)
    (hΛ : ∀ t : ℝ, Work.TorusCover.psiMap P.psi (Λ t) = γ t) :
    psiDisp ψ (subArc γ a b) = ψ (Λ b) - ψ (Λ a) := by
  have hξ : Work.TorusCover.psiMap P.psi (Λ a) = (⟨γ a, γ.mem a⟩ : P.carrier) := hΛ a
  have hl : liftPath' (subArc γ a b) (Λ a) hξ
      = (⟨fun t : unitInterval => Λ (a + (t : ℝ) * (b - a)),
          hΛc.comp (continuous_const.add (continuous_subtype_val.mul continuous_const))⟩ :
          C(unitInterval, ℝ × ℝ)) := by
    show (isCoveringMap_psiMapToRange_param' P).liftPath (subArc γ a b).toContinuousMap (Λ a)
        (liftPath_base (subArc γ a b) (Λ a) hξ) = _
    refine (((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff' _).mpr ⟨?_, ?_⟩).symm
    · funext t
      refine Subtype.ext ?_
      show Work.TorusCover.psiMap P.psi (Λ (a + (t : ℝ) * (b - a))) = ((subArc γ a b) t : R3)
      rw [hΛ]
      rfl
    · show Λ (a + ((0 : unitInterval) : ℝ) * (b - a)) = Λ a
      norm_num
  rw [psiDisp_eq ψ (subArc γ a b) (Λ a) hξ, hl]
  simp only [ContinuousMap.coe_mk]
  congr 1
  rw [show a + ((1 : unitInterval) : ℝ) * (b - a) = b from by
    rw [show (((1 : unitInterval)) : ℝ) = 1 from rfl]; ring]

/-- The sub-arc of a closed curve lying in a set whose parameters lie in the relevant range. -/
theorem subArc_coe_mem {Y : Set R3} (γ : Work.CoreTopology.ClosedCurve P) {a b : ℝ} (hab : a ≤ b)
    (h : ∀ t : ℝ, a ≤ t → t ≤ b → γ t ∈ Y) :
    ∀ v : unitInterval, ((subArc γ a b) v : R3) ∈ Y := by
  intro v
  show γ (a + (v : ℝ) * (b - a)) ∈ Y
  refine h _ ?_ ?_
  · nlinarith [unitInterval.nonneg v, sub_nonneg.mpr hab]
  · nlinarith [unitInterval.le_one v, sub_nonneg.mpr hab]

/-! ## 5. The main combinatorial step -/

/-- **Telescoping identity for an alternating partition.** -/
theorem sum_alternating_telescope {W : Type*} [AddCommGroup W] (f : ℕ → W) (k : ℕ) :
    (∑ j : Fin k, (f (2 * j.val + 1) - f (2 * j.val)))
      + ((∑ j : Fin (k - 1), (f (2 * j.val + 2) - f (2 * j.val + 1)))
        + (f (2 * k) - f (2 * k - 1)))
      = f (2 * k) - f 0 := by
  have hkey : ∀ n : ℕ, (∑ j ∈ Finset.range n,
      ((f (2 * j + 1) - f (2 * j)) + (f (2 * j + 2) - f (2 * j + 1)))) = f (2 * n) - f 0 := by
    intro n
    induction n with
    | zero => simp
    | succ m ih =>
        rw [Finset.sum_range_succ, ih]
        rw [show 2 * (m + 1) = 2 * m + 2 from by omega]
        abel
  rw [Fin.sum_univ_eq_sum_range (fun j => f (2 * j + 1) - f (2 * j)) k,
    Fin.sum_univ_eq_sum_range (fun j => f (2 * j + 2) - f (2 * j + 1)) (k - 1)]
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; simp
  · rw [show (∑ j ∈ Finset.range (k - 1), (f (2 * j + 2) - f (2 * j + 1)))
        + (f (2 * k) - f (2 * k - 1))
        = ∑ j ∈ Finset.range k, (f (2 * j + 2) - f (2 * j + 1)) from ?_]
    · rw [← Finset.sum_add_distrib]
      exact hkey k
    · conv_rhs => rw [show (k : ℕ) = k - 1 + 1 from by omega]
      rw [Finset.sum_range_succ]
      congr 1
      rw [show 2 * (k - 1) + 2 = 2 * k from by omega,
        show 2 * (k - 1) + 1 = 2 * k - 1 from by omega]

/-- **Cancellation identity for an alternating partition.** -/
theorem sum_alternating_cancel {W : Type*} [AddCommGroup W] (k : ℕ) (g : ℕ → W) :
    (∑ j ∈ Finset.range k, (g (2 * j) - g (2 * j + 1)))
      + ((∑ j ∈ Finset.range (k - 1), (g (2 * j + 1) - g (2 * j + 2))) + g (2 * k - 1)) = g 0 := by
  have hA : ∀ n : ℕ, (∑ j ∈ Finset.range n, (g (2 * j) - g (2 * j + 1)))
      + (∑ j ∈ Finset.range n, (g (2 * j + 1) - g (2 * j + 2))) = g 0 - g (2 * n) := by
    intro n
    induction n with
    | zero => simp
    | succ m ih =>
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        rw [show (∑ x ∈ Finset.range m, (g (2 * x) - g (2 * x + 1))) + (g (2 * m) - g (2 * m + 1))
              + (∑ x ∈ Finset.range m, (g (2 * x + 1) - g (2 * x + 2))
                  + (g (2 * m + 1) - g (2 * m + 2)))
            = ((∑ x ∈ Finset.range m, (g (2 * x) - g (2 * x + 1)))
                + (∑ x ∈ Finset.range m, (g (2 * x + 1) - g (2 * x + 2))))
              + ((g (2 * m) - g (2 * m + 1)) + (g (2 * m + 1) - g (2 * m + 2))) from by abel]
        rw [ih]
        rw [show 2 * (m + 1) = 2 * m + 2 from by omega]
        abel
  have hB : (∑ j ∈ Finset.range (k - 1), (g (2 * j + 1) - g (2 * j + 2)))
      + (g (2 * k - 1) - g (2 * k))
      = ∑ j ∈ Finset.range k, (g (2 * j + 1) - g (2 * j + 2)) := by
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk; simp
    · conv_rhs => rw [show (k : ℕ) = k - 1 + 1 from by omega]
      rw [Finset.sum_range_succ]
      congr 1
      rw [show 2 * (k - 1) + 1 = 2 * k - 1 from by omega,
        show 2 * (k - 1) + 2 = 2 * k from by omega]
  have h1 := hA k
  rw [show (∑ j ∈ Finset.range k, (g (2 * j) - g (2 * j + 1)))
      + ((∑ j ∈ Finset.range (k - 1), (g (2 * j + 1) - g (2 * j + 2))) + g (2 * k - 1))
      = ((∑ j ∈ Finset.range k, (g (2 * j) - g (2 * j + 1)))
          + (∑ j ∈ Finset.range k, (g (2 * j + 1) - g (2 * j + 2)))) + g (2 * k) from by
    rw [← hB]; abel]
  rw [h1]
  abel

/-- The membership of a concatenation. -/
theorem Path.trans_coe_mem {Y : Set R3} {a b c : P.carrier} (u : Path a b) (v : Path b c)
    (hu : ∀ t : unitInterval, (u t : R3) ∈ Y) (hv : ∀ t : unitInterval, (v t : R3) ∈ Y)
    (t : unitInterval) : ((u.trans v) t : R3) ∈ Y := by
  rw [Path.trans_apply]
  by_cases ht : (t : ℝ) ≤ 1 / 2
  · rw [dif_pos ht]; exact hu _
  · rw [dif_neg ht]; exact hv _

/-- The membership of the reverse of a path. -/
theorem Path.symm_coe_mem {Y : Set R3} {a b : P.carrier} (u : Path a b)
    (hu : ∀ t : unitInterval, (u t : R3) ∈ Y) (t : unitInterval) : ((u.symm) t : R3) ∈ Y := by
  rw [Path.symm_apply]
  exact hu _

theorem winding_mem_of_alternating {A B : Set R3}
    (hAc : A ⊆ P.carrier) (hBc : B ⊆ P.carrier)
    (hconn : IsPathConnected (A ∩ B))
    {V : Submodule ℚ (ℚ × ℚ)} {W : Type*} [AddCommGroup W] [Module ℝ W]
    (ψ : (ℝ × ℝ) →ₗ[ℝ] W)
    (hψ : ∀ v : ℤ × ℤ, ((v.1 : ℚ), (v.2 : ℚ)) ∈ V → ψ ((v.1 : ℝ), (v.2 : ℝ)) = 0)
    (hψ' : ∀ v : ℤ × ℤ, ψ ((v.1 : ℝ), (v.2 : ℝ)) = 0 → ((v.1 : ℚ), (v.2 : ℚ)) ∈ V)
    (hVA : Work.SurgeryInvariance.WindingSpan P A ≤ V)
    (hVB : Work.SurgeryInvariance.WindingSpan P B ≤ V)
    (γ : Work.CoreTopology.ClosedCurve P)
    {k : ℕ} (hk : 0 < k) {s : ℕ → ℝ}
    (hs0 : s 0 ∈ Set.Ico (0 : ℝ) (2 * Real.pi))
    (hslast : s (2 * k) = s 0 + 2 * Real.pi)
    (hmono : ∀ i j : ℕ, i ≤ 2 * k → j ≤ 2 * k → i < j → s i < s j)
    (hArcA : ∀ j : ℕ, j < k → ∀ t : ℝ, s (2 * j) ≤ t → t ≤ s (2 * j + 1) → γ t ∈ A)
    (hArcB : ∀ j : ℕ, j < k → ∀ t : ℝ, s (2 * j + 1) ≤ t → t ≤ s (2 * j + 2) → γ t ∈ B) :
    (((Work.SurgeryInvariance.windingOf P γ).1 : ℚ),
      ((Work.SurgeryInvariance.windingOf P γ).2 : ℚ)) ∈ V := by
  obtain ⟨L⟩ := Work.TorusCover.ParamTorus_exists_liftOf P γ
  set Λ : ℝ → ℝ × ℝ := fun t => (L.Θ t, L.Φ t) with hΛdef
  have hΛc : Continuous Λ := L.contΘ.prodMk L.contΦ
  have hΛmem : ∀ t : ℝ, Work.TorusCover.psiMap P.psi (Λ t) = γ t := by
    intro t; simp only [hΛdef, Work.TorusCover.psiMap]; exact L.lifts t
  set p : P.carrier := ⟨γ (s 0), γ.mem (s 0)⟩ with hpdef
  set pt : ℕ → P.carrier := fun i => ⟨γ (s i), γ.mem (s i)⟩ with hptdef
  have hs01 : s 0 ≤ s 1 := le_of_lt (hmono 0 1 (by omega) (by omega) (by omega))
  have hpt2k : pt (2 * k) = p := by
    refine Subtype.ext ?_
    show γ (s (2 * k)) = γ (s 0)
    rw [hslast]
    exact γ.periodic (s 0)
  -- the block boundaries lie in A and in B
  have hA_even : ∀ j : ℕ, j ≤ k → γ (s (2 * j)) ∈ A := by
    intro j hj
    rcases lt_or_eq_of_le hj with hj' | hj'
    · exact hArcA j hj' (s (2 * j)) (le_refl _)
        (le_of_lt (hmono (2 * j) (2 * j + 1) (by omega) (by omega) (by omega)))
    · rw [hj', hslast, γ.periodic (s 0)]
      exact hArcA 0 hk (s 0) (le_refl _) hs01
  have hB_even : ∀ j : ℕ, j ≤ k → γ (s (2 * j)) ∈ B := by
    intro j hj
    rcases Nat.eq_zero_or_pos j with hj' | hj'
    · rw [hj', ← γ.periodic (s 0), ← hslast]
      exact hArcB (k - 1) (by omega) (s (2 * k))
        (le_of_lt (hmono (2 * (k - 1) + 1) (2 * k) (by omega) (by omega) (by omega)))
        (le_of_eq (by congr 1; omega))
    · exact hArcB (j - 1) (by omega) (s (2 * j))
        (le_of_lt (hmono (2 * (j - 1) + 1) (2 * j) (by omega) (by omega) (by omega)))
        (le_of_eq (by congr 1; omega))
  have hA_odd : ∀ j : ℕ, j < k → γ (s (2 * j + 1)) ∈ A := fun j hj =>
    hArcA j hj (s (2 * j + 1))
      (le_of_lt (hmono (2 * j) (2 * j + 1) (by omega) (by omega) (by omega))) (le_refl _)
  have hB_odd : ∀ j : ℕ, j < k → γ (s (2 * j + 1)) ∈ B := fun j hj =>
    hArcB j hj (s (2 * j + 1)) (le_refl _)
      (le_of_lt (hmono (2 * j + 1) (2 * j + 2) (by omega) (by omega) (by omega)))
  have hbd : ∀ i : ℕ, i ≤ 2 * k → γ (s i) ∈ A ∩ B := by
    intro i hi
    rcases Nat.even_or_odd i with ⟨j, hj⟩ | ⟨j, hj⟩
    · subst hj
      rw [show j + j = 2 * j from by omega]
      exact ⟨hA_even j (by omega), hB_even j (by omega)⟩
    · subst hj
      exact ⟨hA_odd j (by omega), hB_odd j (by omega)⟩
  -- the connectors
  have hcon : ∀ i : ℕ, i ≤ 2 * k → ∃ c : Path p (pt i), ∀ t : unitInterval, (c t : R3) ∈ A ∩ B := by
    intro i hi
    rcases Nat.eq_zero_or_pos i with rfl | hi0
    · refine ⟨Path.refl p, fun t => ?_⟩
      rw [Path.refl_apply]
      exact ⟨hA_even 0 (by omega), hB_even 0 (by omega)⟩
    · obtain ⟨c, hc⟩ := hconn.joinedIn (p : R3)
        ⟨hA_even 0 (by omega), hB_even 0 (by omega)⟩ (pt i : R3) (hbd i hi)
      refine ⟨⟨⟨fun t => ⟨c t, hAc (hc t).1⟩, c.continuous.subtype_mk _⟩, ?_, ?_⟩,
        fun t => ⟨(hc t).1, (hc t).2⟩⟩
      · exact Subtype.ext c.source
      · exact Subtype.ext c.target
  let c : (i : Fin (2 * k + 1)) → Path p (pt i.val) := fun i =>
    Classical.choose (hcon i.val (Nat.lt_succ_iff.mp i.isLt))
  have hc : ∀ (i : Fin (2 * k + 1)) (t : unitInterval), (c i t : R3) ∈ A ∩ B := fun i =>
    Classical.choose_spec (hcon i.val (Nat.lt_succ_iff.mp i.isLt))
  have hcA : ∀ (i : Fin (2 * k + 1)) (t : unitInterval), (c i t : R3) ∈ A := fun i t => (hc i t).1
  have hcB : ∀ (i : Fin (2 * k + 1)) (t : unitInterval), (c i t : R3) ∈ B := fun i t => (hc i t).2
  let cc : Fin (2 * k + 1) → W := fun i => psiDisp ψ (c i)
  let ccN : ℕ → W := fun i => if h : i < 2 * k + 1 then cc ⟨i, h⟩ else 0
  have hccN : ∀ i (hi : i ≤ 2 * k), ccN i = cc ⟨i, by omega⟩ := by
    intro i hi
    show (if h : i < 2 * k + 1 then cc ⟨i, h⟩ else 0) = cc ⟨i, by omega⟩
    rw [dif_pos (by omega)]
  -- the last B-piece: the sub-arc from `s (2k-1)` to `s (2k)`, transported to end at `p`
  let Qlast : Path (pt (2 * k - 1)) p :=
    ⟨(subArc γ (s (2 * k - 1)) (s (2 * k))).toContinuousMap,
      (subArc γ (s (2 * k - 1)) (s (2 * k))).source,
      (subArc γ (s (2 * k - 1)) (s (2 * k))).target.trans hpt2k⟩
  have hQlast : psiDisp ψ Qlast = ψ (Λ (s (2 * k))) - ψ (Λ (s (2 * k - 1))) := by
    have hξ : Work.TorusCover.psiMap P.psi (Λ (s (2 * k - 1))) = (pt (2 * k - 1) : P.carrier) :=
      hΛmem _
    rw [psiDisp_eq ψ Qlast (Λ (s (2 * k - 1))) hξ]
    have hl : liftPath' Qlast (Λ (s (2 * k - 1))) hξ
        = (⟨fun t : unitInterval => Λ (s (2 * k - 1) + (t : ℝ) * (s (2 * k) - s (2 * k - 1))),
            hΛc.comp (continuous_const.add (continuous_subtype_val.mul continuous_const))⟩ :
            C(unitInterval, ℝ × ℝ)) := by
      show (isCoveringMap_psiMapToRange_param' P).liftPath Qlast.toContinuousMap
          (Λ (s (2 * k - 1))) (liftPath_base Qlast (Λ (s (2 * k - 1))) hξ) = _
      refine (((isCoveringMap_psiMapToRange_param' P).eq_liftPath_iff' _).mpr ⟨?_, ?_⟩).symm
      · funext t
        refine Subtype.ext ?_
        show Work.TorusCover.psiMap P.psi
            (Λ (s (2 * k - 1) + (t : ℝ) * (s (2 * k) - s (2 * k - 1)))) = (Qlast t : R3)
        rw [hΛmem]
        rfl
      · show Λ (s (2 * k - 1) + ((0 : unitInterval) : ℝ) * (s (2 * k) - s (2 * k - 1)))
            = Λ (s (2 * k - 1))
        norm_num
    rw [hl]
    simp only [ContinuousMap.coe_mk]
    congr 1
    rw [show s (2 * k - 1) + ((1 : unitInterval) : ℝ) * (s (2 * k) - s (2 * k - 1)) = s (2 * k) from by
      rw [show (((1 : unitInterval)) : ℝ) = 1 from rfl]; ring]
  -- the two loop families
  let Afun : Fin k → Path p p := fun j =>
    (c ⟨2 * j.val, by have := j.isLt; omega⟩).trans
      ((subArc γ (s (2 * j.val)) (s (2 * j.val + 1))).trans
        ((c ⟨2 * j.val + 1, by have := j.isLt; omega⟩).symm))
  let Breg : Fin (k - 1) → Path p p := fun j =>
    (c ⟨2 * j.val + 1, by have := j.isLt; omega⟩).trans
      ((subArc γ (s (2 * j.val + 1)) (s (2 * j.val + 2))).trans
        ((c ⟨2 * j.val + 2, by have := j.isLt; omega⟩).symm))
  set β : Path p p := (glueLoops (k - 1) Breg).trans
    ((c ⟨2 * k - 1, by omega⟩).trans Qlast) with hβdef
  have hαdisp : psiDisp ψ (glueLoops k Afun)
      = (∑ j : Fin k, (ψ (Λ (s (2 * j.val + 1))) - ψ (Λ (s (2 * j.val)))))
        + (∑ j : Fin k, (cc ⟨2 * j.val, by have := j.isLt; omega⟩
            - cc ⟨2 * j.val + 1, by have := j.isLt; omega⟩)) := by
    rw [psiDisp_glueLoops]
    rw [show (∑ j : Fin k, psiDisp ψ (Afun j))
        = ∑ j : Fin k, ((ψ (Λ (s (2 * j.val + 1))) - ψ (Λ (s (2 * j.val))))
            + (cc ⟨2 * j.val, by have := j.isLt; omega⟩
              - cc ⟨2 * j.val + 1, by have := j.isLt; omega⟩)) from
      Finset.sum_congr rfl (fun j _ => by
        show psiDisp ψ ((c ⟨2 * j.val, _⟩).trans
          ((subArc γ (s (2 * j.val)) (s (2 * j.val + 1))).trans
            ((c ⟨2 * j.val + 1, _⟩).symm))) = _
        rw [psiDisp_trans, psiDisp_trans, psiDisp_symm,
          psiDisp_subArc ψ γ (s (2 * j.val)) (s (2 * j.val + 1)) Λ hΛc hΛmem]
        abel)]
    rw [Finset.sum_add_distrib]
  have hβdisp : psiDisp ψ β
      = ((∑ j : Fin (k - 1), (ψ (Λ (s (2 * j.val + 2))) - ψ (Λ (s (2 * j.val + 1)))))
          + (ψ (Λ (s (2 * k))) - ψ (Λ (s (2 * k - 1)))))
        + ((∑ j : Fin (k - 1), (cc ⟨2 * j.val + 1, by have := j.isLt; omega⟩
            - cc ⟨2 * j.val + 2, by have := j.isLt; omega⟩))
          + cc ⟨2 * k - 1, by omega⟩) := by
    rw [hβdef, psiDisp_trans, psiDisp_trans, hQlast, psiDisp_glueLoops]
    rw [show (∑ j : Fin (k - 1), psiDisp ψ (Breg j))
        = (∑ j : Fin (k - 1), (ψ (Λ (s (2 * j.val + 2))) - ψ (Λ (s (2 * j.val + 1)))))
          + (∑ j : Fin (k - 1), (cc ⟨2 * j.val + 1, by have := j.isLt; omega⟩
              - cc ⟨2 * j.val + 2, by have := j.isLt; omega⟩)) from
      (Finset.sum_congr rfl (fun j _ => by
        show psiDisp ψ ((c ⟨2 * j.val + 1, _⟩).trans
          ((subArc γ (s (2 * j.val + 1)) (s (2 * j.val + 2))).trans
            ((c ⟨2 * j.val + 2, _⟩).symm))) = _
        rw [psiDisp_trans, psiDisp_trans, psiDisp_symm,
          psiDisp_subArc ψ γ (s (2 * j.val + 1)) (s (2 * j.val + 2)) Λ hΛc hΛmem]
        abel)).trans Finset.sum_add_distrib]
    abel
  -- the two loops have vanishing displacement
  -- the two loops have vanishing displacement
  have hAfun_mem : ∀ (j : Fin k) (u : unitInterval), ((Afun j) u : R3) ∈ A := by
    intro j u
    show (((c ⟨2 * j.val, _⟩).trans ((subArc γ (s (2 * j.val)) (s (2 * j.val + 1))).trans
      ((c ⟨2 * j.val + 1, _⟩).symm))) u : R3) ∈ A
    refine Path.trans_coe_mem _ _ (fun v => hcA _ v)
      (Path.trans_coe_mem _ _
        (fun v => subArc_coe_mem γ (le_of_lt (hmono _ _ (by omega) (by omega) (by omega)))
          (fun t ht1 ht2 => hArcA j (by have := j.isLt; omega) t ht1 ht2) v)
        (fun v => Path.symm_coe_mem _ (fun w => hcA _ w) v)) u
  have hpA' : (p : R3) ∈ A := hA_even 0 (by omega)
  have hpB' : (p : R3) ∈ B := hB_even 0 (by omega)
  have hA_mem : ∀ u : unitInterval, ((glueLoops k Afun) u : R3) ∈ A :=
    glueLoops_mem (X := A) hpA' k Afun hAfun_mem
  have hAdis : psiDisp ψ (glueLoops k Afun) = 0 :=
    psiDisp_eq_zero_of_subset ψ hψ hVA _ hA_mem
  have hBreg_mem : ∀ (j : Fin (k - 1)) (u : unitInterval), ((Breg j) u : R3) ∈ B := by
    intro j u
    show (((c ⟨2 * j.val + 1, _⟩).trans ((subArc γ (s (2 * j.val + 1)) (s (2 * j.val + 2))).trans
      ((c ⟨2 * j.val + 2, _⟩).symm))) u : R3) ∈ B
    refine Path.trans_coe_mem _ _ (fun v => hcB _ v)
      (Path.trans_coe_mem _ _
        (fun v => subArc_coe_mem γ (le_of_lt (hmono _ _ (by omega) (by omega) (by omega)))
          (fun t ht1 ht2 => hArcB j (by have := j.isLt; omega) t ht1 ht2) v)
        (fun v => Path.symm_coe_mem _ (fun w => hcB _ w) v)) u
  have hQlast_mem : ∀ u : unitInterval, (Qlast u : R3) ∈ B := by
    intro u
    exact subArc_coe_mem γ (le_of_lt (hmono _ _ (by omega) (by omega) (by omega)))
      (fun t ht1 ht2 => by
        have he1 : 2 * (k - 1) + 1 = 2 * k - 1 := by omega
        have he2 : 2 * (k - 1) + 2 = 2 * k := by omega
        exact hArcB (k - 1) (by omega) t (by rw [he1]; exact ht1) (by rw [he2]; exact ht2)) u
  have hB_mem : ∀ u : unitInterval, (β u : R3) ∈ B := by
    rw [hβdef]
    exact Path.trans_coe_mem _ _
      (fun v => glueLoops_mem (X := B) hpB' (k - 1) Breg hBreg_mem v)
      (Path.trans_coe_mem _ _ (fun v => hcB _ v) (fun v => hQlast_mem v)) 
  have hBdis : psiDisp ψ β = 0 := psiDisp_eq_zero_of_subset ψ hψ hVB _ hB_mem
  -- rewrite the two displacement identities in terms of `ccN`
  have hconvA : (∑ j : Fin k, (cc ⟨2 * j.val, by have := j.isLt; omega⟩
      - cc ⟨2 * j.val + 1, by have := j.isLt; omega⟩))
      = (∑ j : Fin k, (ccN (2 * j.val) - ccN (2 * j.val + 1))) := by
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hccN (2 * j.val) (by omega), ← hccN (2 * j.val + 1) (by omega)]
  have hconvB1 : (∑ j : Fin (k - 1), (cc ⟨2 * j.val + 1, by have := j.isLt; omega⟩
      - cc ⟨2 * j.val + 2, by have := j.isLt; omega⟩))
      = (∑ j : Fin (k - 1), (ccN (2 * j.val + 1) - ccN (2 * j.val + 2))) := by
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hccN (2 * j.val + 1) (by omega), ← hccN (2 * j.val + 2) (by omega)]
  have hAsum : (∑ j : Fin k, (ψ (Λ (s (2 * j.val + 1))) - ψ (Λ (s (2 * j.val)))))
      + (∑ j : Fin k, (ccN (2 * j.val) - ccN (2 * j.val + 1))) = 0 := by
    have h := hαdisp
    rw [hAdis, hconvA] at h
    exact h.symm
  have hBsum : ((∑ j : Fin (k - 1), (ψ (Λ (s (2 * j.val + 2))) - ψ (Λ (s (2 * j.val + 1)))))
      + (ψ (Λ (s (2 * k))) - ψ (Λ (s (2 * k - 1)))))
      + ((∑ j : Fin (k - 1), (ccN (2 * j.val + 1) - ccN (2 * j.val + 2)))
        + ccN (2 * k - 1)) = 0 := by
    have h := hβdisp
    rw [hBdis, hconvB1, ← hccN (2 * k - 1) (by omega)] at h
    exact h.symm
  have htel := sum_alternating_telescope (fun i => ψ (Λ (s i))) k
  have hcan : (∑ j : Fin k, (ccN (2 * j.val) - ccN (2 * j.val + 1)))
      + ((∑ j : Fin (k - 1), (ccN (2 * j.val + 1) - ccN (2 * j.val + 2)))
        + ccN (2 * k - 1)) = 0 := by
    have h1 : (∑ j : Fin k, (ccN (2 * j.val) - ccN (2 * j.val + 1)))
        = (∑ j ∈ Finset.range k, (ccN (2 * j) - ccN (2 * j + 1))) :=
      Fin.sum_univ_eq_sum_range (fun j => ccN (2 * j) - ccN (2 * j + 1)) k
    have h2 : (∑ j : Fin (k - 1), (ccN (2 * j.val + 1) - ccN (2 * j.val + 2)))
        = (∑ j ∈ Finset.range (k - 1), (ccN (2 * j + 1) - ccN (2 * j + 2))) :=
      Fin.sum_univ_eq_sum_range (fun j => ccN (2 * j + 1) - ccN (2 * j + 2)) (k - 1)
    rw [h1, h2, sum_alternating_cancel (W := W) k ccN]
    have hcc0 : ccN 0 = 0 := by
      rw [hccN 0 (by omega)]
      exact psiDisp_eq_zero_of_subset ψ hψ hVA (c ⟨0, by omega⟩)
        (fun t => hcA ⟨0, by omega⟩ t)
    rw [hcc0]
  have hfinal : ψ (Λ (s (2 * k))) - ψ (Λ (s 0)) = 0 := by
    have e1 : (∑ j : Fin k, (ψ (Λ (s (2 * j.val + 1))) - ψ (Λ (s (2 * j.val)))))
        = -(∑ j : Fin k, (ccN (2 * j.val) - ccN (2 * j.val + 1))) :=
      add_eq_zero_iff_eq_neg.mp hAsum
    have e2 : (∑ j : Fin (k - 1), (ψ (Λ (s (2 * j.val + 2))) - ψ (Λ (s (2 * j.val + 1)))))
        + (ψ (Λ (s (2 * k))) - ψ (Λ (s (2 * k - 1))))
        = -((∑ j : Fin (k - 1), (ccN (2 * j.val + 1) - ccN (2 * j.val + 2)))
          + ccN (2 * k - 1)) :=
      add_eq_zero_iff_eq_neg.mp hBsum
    rw [← htel, e1, e2, ← neg_add, hcan, neg_zero]
  have hper : Λ (s (2 * k)) = Λ (s 0) + Work.TorusCover.periodShift
      (Work.SurgeryInvariance.windingOf P γ) := by
    have h := L.period_shift_winding (s 0)
    have hw := Work.SurgeryInvariance.windingOf_eq P γ L
    rw [hslast, hw]
    ext <;> simp [hΛdef, Work.TorusCover.periodShift, h.1, h.2]
  have hpsi0 : ψ (((Work.SurgeryInvariance.windingOf P γ).1 : ℝ),
      ((Work.SurgeryInvariance.windingOf P γ).2 : ℝ)) = 0 := by
    have h2 : ψ (Work.TorusCover.periodShift (Work.SurgeryInvariance.windingOf P γ)) = 0 := by
      have hh := hfinal
      rw [hper, map_add, sub_eq_add_neg] at hh
      rw [show ψ (Λ (s 0)) + ψ (Work.TorusCover.periodShift (Work.SurgeryInvariance.windingOf P γ))
          + -ψ (Λ (s 0)) = ψ (Work.TorusCover.periodShift (Work.SurgeryInvariance.windingOf P γ))
          from by abel] at hh
      exact hh
    rw [show Work.TorusCover.periodShift (Work.SurgeryInvariance.windingOf P γ)
        = (2 * Real.pi) • ((((Work.SurgeryInvariance.windingOf P γ).1 : ℝ),
            ((Work.SurgeryInvariance.windingOf P γ).2 : ℝ)) : ℝ × ℝ) from by
          ext <;> simp [Work.TorusCover.periodShift, smul_eq_mul, mul_comm],
      map_smul] at h2
    exact (smul_eq_zero.mp h2).resolve_left (by positivity)
  exact hψ' _ hpsi0
/-! ## 10. The main theorem -/

theorem windingSpan_union_le_sup_of_isPathConnected_inter {P : Work.CoreTopology.ParamTorus}
    {A B : Set LeanEval.KnotTheory.PardonDistortion.R3}
    (hAc : A ⊆ P.carrier) (hBc : B ⊆ P.carrier)
    (hA : Work.SurgeryInvariance.IsOpenInCarrier P A)
    (hB : Work.SurgeryInvariance.IsOpenInCarrier P B)
    (hconn : IsPathConnected (A ∩ B)) :
    Work.SurgeryInvariance.WindingSpan P (A ∪ B) ≤
      Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B := by
  change Submodule.span ℚ (Work.SurgeryInvariance.windingVectors P (A ∪ B)) ≤
      Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B
  rw [Submodule.span_le]
  rintro v ⟨γ, hγ, rfl⟩
  by_cases htop : Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B = ⊤
  · rw [htop]; exact Submodule.mem_top
  · by_cases hbot : Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B = ⊥
    · have hVA : Work.SurgeryInvariance.WindingSpan P A ≤ ⊥ := hbot ▸ le_sup_left
      have hVB : Work.SurgeryInvariance.WindingSpan P B ≤ ⊥ := hbot ▸ le_sup_right
      rw [hbot]
      rcases exists_alternating_partition hA hB γ hγ with h | h | ⟨k, hk, s, hs0, hslast, hmono, hArcA, hArcB⟩
      · exact hVA (Submodule.subset_span ⟨γ, h, rfl⟩)
      · exact hVB (Submodule.subset_span ⟨γ, h, rfl⟩)
      · exact winding_mem_of_alternating (P := P) hAc hBc hconn
          (LinearMap.id : (ℝ × ℝ) →ₗ[ℝ] (ℝ × ℝ))
          (fun w hw => by
            rw [Submodule.mem_bot] at hw
            have h1 : (w.1 : ℚ) = 0 := congrArg Prod.fst hw
            have h2 : (w.2 : ℚ) = 0 := congrArg Prod.snd hw
            have h1' : w.1 = 0 := by exact_mod_cast h1
            have h2' : w.2 = 0 := by exact_mod_cast h2
            rw [h1', h2']
            simp)
          (fun w hw => by
            rw [Submodule.mem_bot]
            have h1 : (w.1 : ℝ) = 0 := congrArg Prod.fst hw
            have h2 : (w.2 : ℝ) = 0 := congrArg Prod.snd hw
            have h1' : w.1 = 0 := by exact_mod_cast h1
            have h2' : w.2 = 0 := by exact_mod_cast h2
            rw [h1', h2']
            simp)
          hVA hVB γ hk hs0 hslast hmono hArcA hArcB
    · -- `V` is a line
      rcases exists_functional_kernel_eq
          (Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B)
          hbot htop with ⟨a, b, hab, hker⟩
      let ψ : (ℝ × ℝ) →ₗ[ℝ] ℝ :=
        { toFun := fun p => (b : ℝ) * p.1 - (a : ℝ) * p.2
          map_add' := by intro p q; simp only [Prod.fst_add, Prod.snd_add]; ring
          map_smul' := by intro c p; simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul, RingHom.id_apply]; ring }
      have hψ : ∀ w : ℤ × ℤ,
          (((w.1 : ℚ), (w.2 : ℚ)) ∈
            (Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B)) →
          ψ ((w.1 : ℝ), (w.2 : ℝ)) = 0 := by
        intro w hw
        have h := (hker w).mp hw
        show (b : ℝ) * (w.1 : ℝ) - (a : ℝ) * (w.2 : ℝ) = 0
        exact_mod_cast h
      have hψ' : ∀ w : ℤ × ℤ, ψ ((w.1 : ℝ), (w.2 : ℝ)) = 0 →
          (((w.1 : ℚ), (w.2 : ℚ)) ∈
            (Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B)) := by
        intro w hw
        refine (hker w).mpr ?_
        have h : (b : ℝ) * (w.1 : ℝ) - (a : ℝ) * (w.2 : ℝ) = 0 := hw
        exact_mod_cast h
      rcases exists_alternating_partition hA hB γ hγ with h | h | ⟨k, hk, s, hs0, hslast, hmono, hArcA, hArcB⟩
      · exact Submodule.mem_sup_left (Submodule.subset_span ⟨γ, h, rfl⟩)
      · exact Submodule.mem_sup_right (Submodule.subset_span ⟨γ, h, rfl⟩)
      · exact winding_mem_of_alternating (P := P) hAc hBc hconn ψ hψ hψ'
          (le_sup_left : Work.SurgeryInvariance.WindingSpan P A ≤
            Work.SurgeryInvariance.WindingSpan P A ⊔ Work.SurgeryInvariance.WindingSpan P B)
          le_sup_right γ hk hs0 hslast hmono hArcA hArcB

end

