import Mathlib
import Submission.LargeValues.KeyProp

/-!
# Guth–Maynard, Proposition 4.1: the interfaces between the areas of the proof

WRITTEN BY THE PROJECT LEAD. Do NOT edit this file: every area of the proof is
stated against it. If you believe a definition or statement here is wrong, say so
in your report (with the reason) instead of working around it.

`Submission.LargeValues.KeyPropStatement` (GM Prop 3.1/4.1 in window form) is the only
thing still missing for the challenge theorem: `Submission.LargeValues.theorem_1_1_of_keyprop`
turns a proof of it into `theorem_1_1`. Its proof (GM §§4–12) is cut into areas,
each proving ONE of the `Prop`s below, and each allowed to ASSUME the others it
needs as hypotheses:

* `TraceStatement`  -- GM §4 + Prop 5.1: Lemmas 4.3–4.5, Prop 4.6, `S₁` negligible.
* `HBStatement`     -- Heath-Brown's Theorem 1.6 (the difference-set bound).
* `S2Statement`     -- GM §6: Lemma 6.2 + Prop 6.1 (k = 4). May assume `HBStatement`.
* `AffineStatement` -- GM §9: Prop 9.1 (equidistribution over affine maps).
* `S3Statement`     -- GM §§7, 8, 10: Props 7.1, 7.2, Lemmas 8.2–8.4, Prop 10.1.
                        May assume `AffineStatement`.
* `EnergyStatement` -- GM §11: Prop 11.1 for the smoothed polynomial. May assume `HBStatement`.
* assembly (GM §12): the four of Trace, S2, S3, Energy imply `KeyPropStatement`.

Setting throughout (GM Prop 3.1): `T = N^{6/5} = M N`, `W ⊆ [0, T]` a finite set,
`T^ε`-separated, `V = N^σ`. The paper's `A ⪅ B` ("for every δ > 0, A ≤ C(δ) T^δ B")
is written with an explicit `δ`, and `T^δ` as `N^δ` (the same thing up to renaming δ).
-/

open Complex Finset
open scoped BigOperators
set_option autoImplicit false

namespace Submission.GM

open Submission.LargeValues

/-- `W` is `δ`-separated. -/
def Separated (W : Finset ℝ) (δ : ℝ) : Prop :=
  ∀ t ∈ W, ∀ s ∈ W, t ≠ s → δ ≤ |t - s|

/-- GM (4.4): `h_t(u) = w(u)² u^{it}` (it vanishes off `[1, 2]`, where `w = bumpW` does). -/
noncomputable def hfun (t : ℝ) (u : ℝ) : ℂ :=
  (((bumpW u) ^ 2 : ℝ) : ℂ) * (u : ℂ) ^ (I * (t : ℂ))

/-- `ĥ_t(ξ) = ∫ e(-ξu) h_t(u) du` (Mathlib's Fourier transform has exactly the paper's
normalisation `e(x) = exp(2πix)`). -/
noncomputable def hhat (t ξ : ℝ) : ℂ :=
  FourierTransform.fourier (hfun t) ξ

/-- GM Lemma 4.5: `I_m = N³ Σ_{t₁,t₂,t₃ ∈ W} ĥ_{t₁-t₂}(m₁N) ĥ_{t₂-t₃}(m₂N) ĥ_{t₃-t₁}(m₃N)`. -/
noncomputable def Iterm (N : ℕ) (W : Finset ℝ) (m : ℤ × ℤ × ℤ) : ℂ :=
  (N : ℂ) ^ 3 * ∑ t₁ ∈ W, ∑ t₂ ∈ W, ∑ t₃ ∈ W,
    hhat (t₁ - t₂) ((m.1 : ℝ) * N) * hhat (t₂ - t₃) ((m.2.1 : ℝ) * N) *
      hhat (t₃ - t₁) ((m.2.2 : ℝ) * N)

/-- The number of nonzero coordinates of `m ∈ ℤ³`. -/
def nzCount (m : ℤ × ℤ × ℤ) : ℕ :=
  (if m.1 ≠ 0 then 1 else 0) + (if m.2.1 ≠ 0 then 1 else 0) + (if m.2.2 ≠ 0 then 1 else 0)

/-- GM (5.5): `S_k = Σ_{m : exactly k coordinates nonzero} I_m` (k = 1, 2, 3).
(A `tsum`; `TraceStatement` includes that these families are summable.) -/
noncomputable def Spart (k : ℕ) (N : ℕ) (W : Finset ℝ) : ℂ :=
  ∑' m : {m : ℤ × ℤ × ℤ // nzCount m = k}, Iterm N W m

/-- GM (7.2): `R(v) = Σ_{t ∈ W} |v|^{it}`. -/
noncomputable def Rfun (W : Finset ℝ) (v : ℝ) : ℂ :=
  ∑ t ∈ W, ((|v| : ℝ) : ℂ) ^ (I * (t : ℂ))

open scoped Classical in
/-- GM (1.7): the additive energy `E(W) = #{(w₁,w₂,w₃,w₄) ∈ W⁴ : |w₁+w₂-w₃-w₄| ≤ 1}`. -/
noncomputable def energy (W : Finset ℝ) : ℕ :=
  ((W ×ˢ W ×ˢ W ×ˢ W).filter
    (fun q : ℝ × ℝ × ℝ × ℝ => |q.1 + q.2.1 - q.2.2.1 - q.2.2.2| ≤ 1)).card

/-- **GM §4 + Prop 5.1.** For `N` large, on the Prop-3.1 setting: the families `S_k` are
summable, `S₁` is negligible (`≤ 1`; the paper has `O(T^{-10})`), and Prop 4.6 holds:
`|W| ≪_ε N^{2-2σ} + N^{1-2σ} |S₁+S₂+S₃|^{1/3}` with `N^σ = V`. -/
def TraceStatement : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∀ W : Finset ℝ,
    (∀ t ∈ W, t ∈ Set.Icc 0 (M N)) → Separated W ((M N) ^ ε) →
    (∀ k : ℕ, Summable (fun m : {m : ℤ × ℤ × ℤ // nzCount m = k} => Iterm N W m)) ∧
    ‖Spart 1 N W‖ ≤ 1 ∧
    ∀ b : ℕ → ℂ, (∀ n, ‖b n‖ ≤ 1) → ∀ V : ℝ, 0 < V →
      (∀ t ∈ W, V ≤ ‖smoothedPoly N b t‖) →
      (W.card : ℝ) ≤ C * ((N : ℝ) ^ 2 / V ^ 2 +
        (N : ℝ) / V ^ 2 * ‖Spart 1 N W + Spart 2 N W + Spart 3 N W‖ ^ (1 / 3 : ℝ))

/-- **Heath-Brown, Theorem 1.6** (J. LMS 1979, Thm 1; GM Theorem 1.6; Kerr
arXiv:1909.12075 Thm 3.2 with `γ ≡ 1`), for a `1`-separated family in `[0, T]`. -/
def HBStatement : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧
    ∀ (N : ℕ), 1 ≤ N → ∀ (T : ℝ), 1 ≤ T → ∀ (a : ℕ → ℂ), (∀ n, ‖a n‖ ≤ 1) →
    ∀ (R : ℕ) (t : Fin R → ℝ),
      (∀ i, t i ∈ Set.Icc 0 T) →
      (∀ i j, i ≠ j → 1 ≤ |t i - t j|) →
      (∑ i : Fin R, ∑ j : Fin R,
          ‖∑ n ∈ Finset.Icc N (2 * N), a n * (n : ℂ) ^ (I * ((t i - t j : ℝ) : ℂ))‖ ^ 2)
        ≤ C * T ^ ε * ((R : ℝ) ^ 2 * (N : ℝ) + (R : ℝ) * (N : ℝ) ^ 2
            + (R : ℝ) ^ ((5 : ℝ) / 4) * T ^ ((1 : ℝ) / 2) * (N : ℝ))

/-- **GM Prop 6.1 with k = 4** (`T = N^{6/5}`):
`S₂ ⪅ N²|W|² + T N |W|^{7/4} + N² |W|^{29/16} T^{1/8}`. -/
def S2Statement : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ → ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
    ∀ W : Finset ℝ, (∀ t ∈ W, t ∈ Set.Icc 0 (M N)) → Separated W ((M N) ^ ε) →
    ‖Spart 2 N W‖ ≤ C * (N : ℝ) ^ δ *
      ((N : ℝ) ^ 2 * (W.card : ℝ) ^ 2 + M N * N * (W.card : ℝ) ^ (7 / 4 : ℝ)
        + (N : ℝ) ^ 2 * (W.card : ℝ) ^ (29 / 16 : ℝ) * (M N) ^ (1 / 8 : ℝ))

/-- **GM Prop 10.1** (`T = N^{6/5}`): `S₃ ⪅ T²|W|^{3/2} + T N |W|^{1/2} E(W)^{1/2}`. -/
def S3Statement : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ → ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
    ∀ W : Finset ℝ, (∀ t ∈ W, t ∈ Set.Icc 0 (M N)) → Separated W ((M N) ^ ε) →
    ‖Spart 3 N W‖ ≤ C * (N : ℝ) ^ δ *
      ((M N) ^ 2 * (W.card : ℝ) ^ (3 / 2 : ℝ)
        + M N * N * (W.card : ℝ) ^ (1 / 2 : ℝ) * (energy W : ℝ) ^ (1 / 2 : ℝ))

/-- **GM Prop 11.1** for `D = smoothedPoly N b` (`T = N^{6/5}`, so `T^{3/4} ≤ N ≤ T`):
`E(W) ⪅ |W| N^{4-4σ} + |W|^{21/8} T^{1/4} N^{1-2σ} + |W|³ N^{1-2σ}` with `N^σ = V`. -/
def EnergyStatement : Prop :=
  ∀ δ : ℝ, 0 < δ → ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
    ∀ W : Finset ℝ, (∀ t ∈ W, t ∈ Set.Icc 0 (M N)) → Separated W 1 →
    ∀ b : ℕ → ℂ, (∀ n, ‖b n‖ ≤ 1) → ∀ V : ℝ, 0 < V →
      (∀ t ∈ W, V ≤ ‖smoothedPoly N b t‖) →
      (energy W : ℝ) ≤ C * (N : ℝ) ^ δ *
        ((W.card : ℝ) * (N : ℝ) ^ 4 / V ^ 4
          + (W.card : ℝ) ^ (21 / 8 : ℝ) * (M N) ^ (1 / 4 : ℝ) * N / V ^ 2
          + (W.card : ℝ) ^ 3 * N / V ^ 2)

/-- The inner sum of GM's `J(f)` (§9): `Σ_{|m₁| ∼ M₁, m₂ ∼ M₂, |m₃| ≤ K M₃} f((m₁u+m₃)/m₂)`,
where `x ∼ X` means `X < x ≤ 2X` (and `m₂ > 0`). -/
noncomputable def affineSum (K M₁ M₂ M₃ : ℝ) (f : ℝ → ℝ) (u : ℝ) : ℝ :=
  ∑ m₁ ∈ (Finset.Icc (-⌊2 * M₁⌋) ⌊2 * M₁⌋).filter (fun m : ℤ => M₁ < |(m : ℝ)|),
    ∑ m₂ ∈ (Finset.Icc (1 : ℤ) ⌊2 * M₂⌋).filter (fun m : ℤ => M₂ < (m : ℝ)),
      ∑ m₃ ∈ Finset.Icc (-⌊K * M₃⌋) ⌊K * M₃⌋,
        f (((m₁ : ℝ) * u + m₃) / m₂)

/-- **GM Prop 9.1** (with the uniformity spelled out as in the paper's remark after it):
for `f ≥ 0` continuous, supported in `[1/C₀, C₀]`, with `|f̂(ξ)| ≤ c(j,ε) T^ε (T/|ξ|)^j ‖f‖_∞`
for all `j, ε`, and every `δ > 0`, with a constant depending only on `C₀, K, c, δ`:
`∫ (Σ_{|m₁|∼M₁, m₂∼M₂, |m₃|≤KM₃} f((m₁u+m₃)/m₂))² du ≤ C' T^δ (M⁶ (∫f)² + M⁴ ∫f²)`
for all `0 < M₁, M₂, M₃ ≤ M`. -/
def AffineStatement : Prop :=
  ∀ (C₀ K : ℝ), 1 ≤ C₀ → 0 < K → ∀ c : ℕ → ℝ → ℝ, ∀ δ : ℝ, 0 < δ →
    ∃ C' : ℝ, 0 < C' ∧
    ∀ T : ℝ, 1 ≤ T → ∀ f : ℝ → ℝ, Continuous f → (∀ u, 0 ≤ f u) →
      (∀ u, f u ≠ 0 → u ∈ Set.Icc (1 / C₀) C₀) →
      (∀ (j : ℕ) (ε : ℝ), 0 < ε → ∀ ξ : ℝ, ξ ≠ 0 →
        ‖FourierTransform.fourier (fun u => (f u : ℂ)) ξ‖ ≤
          c j ε * T ^ ε * (T / |ξ|) ^ j * sSup (Set.range f)) →
      ∀ Mbig M₁ M₂ M₃ : ℝ, 0 < M₁ → M₁ ≤ Mbig → 0 < M₂ → M₂ ≤ Mbig → 0 < M₃ → M₃ ≤ Mbig →
        ∫ u, (affineSum K M₁ M₂ M₃ f u) ^ 2 ≤
          C' * T ^ δ * (Mbig ^ 6 * (∫ u, f u) ^ 2 + Mbig ^ 4 * ∫ u, (f u) ^ 2)

end Submission.GM
