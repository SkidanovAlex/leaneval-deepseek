import Mathlib
import Submission.Work.WilE1.Setup

namespace Work.WilE1

/-- The vanishing ideal of a single point `x` of affine `k`-space over `ℂ` is generated by the
coordinate differences `X i - C (x i)`. -/
theorem VanishSpan {k : ℕ} (x : Fin k → ℂ) :
    MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin k → ℂ)) =
      Ideal.span (Set.range fun i =>
        (MvPolynomial.X i - MvPolynomial.C (x i) : MvPolynomial (Fin k) ℂ)) := by
  set J := Ideal.span (Set.range fun i =>
      (MvPolynomial.X i - MvPolynomial.C (x i) : MvPolynomial (Fin k) ℂ)) with hJ
  refine le_antisymm ?_ ?_
  · -- `vanishingIdeal ℂ {x} ≤ J`: work in the quotient by `J`, where `X i` and `C (x i)` agree.
    intro p hp
    have hp0 : MvPolynomial.aeval (R := ℂ) x p = 0 :=
      (MvPolynomial.mem_vanishingIdeal_singleton_iff x p).mp hp
    -- In the quotient by `J`, the two ring maps `p ↦ mk p` and `p ↦ mk (C (aeval x p))` agree.
    have hker : ∀ q, Ideal.Quotient.mk J q
        = Ideal.Quotient.mk J (MvPolynomial.C (MvPolynomial.aeval (R := ℂ) x q)) := by
      have h : (Ideal.Quotient.mk J : MvPolynomial (Fin k) ℂ →+* MvPolynomial (Fin k) ℂ ⧸ J)
          = (Ideal.Quotient.mk J).comp
              ((MvPolynomial.C : ℂ →+* MvPolynomial (Fin k) ℂ).comp
                (MvPolynomial.aeval (R := ℂ) x).toRingHom) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp
        · intro i
          have hmem : (MvPolynomial.X i - MvPolynomial.C (x i)) ∈ J :=
            Ideal.subset_span ⟨i, rfl⟩
          have hz : Ideal.Quotient.mk J (MvPolynomial.X i - MvPolynomial.C (x i)) = 0 := by
            rw [Ideal.Quotient.eq_zero_iff_mem]; exact hmem
          have h2 : Ideal.Quotient.mk J (MvPolynomial.X i)
              = Ideal.Quotient.mk J (MvPolynomial.C (x i)) := by
            have h3 := map_sub (Ideal.Quotient.mk J) (MvPolynomial.X i) (MvPolynomial.C (x i))
            rw [hz] at h3
            exact sub_eq_zero.mp h3.symm
          have h4 : (MvPolynomial.aeval (R := ℂ) x).toRingHom (MvPolynomial.X i) = x i :=
            MvPolynomial.aeval_X x i
          rw [RingHom.comp_apply, RingHom.comp_apply, h4]
          exact h2
      intro q
      exact DFunLike.congr_fun h q
    have hp1 : Ideal.Quotient.mk J p
        = Ideal.Quotient.mk J (MvPolynomial.C (MvPolynomial.aeval (R := ℂ) x p)) := hker p
    rw [hp0, map_zero, map_zero] at hp1
    exact Ideal.Quotient.eq_zero_iff_mem.mp hp1
  · -- `J ≤ vanishingIdeal ℂ {x}`: each `X i - C (x i)` evaluates to `0` at `x`.
    rw [hJ]
    refine Ideal.span_le.mpr ?_
    rintro y ⟨i, rfl⟩
    change MvPolynomial.X i - MvPolynomial.C (x i)
      ∈ MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin k → ℂ))
    rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
    simp

end Work.WilE1
