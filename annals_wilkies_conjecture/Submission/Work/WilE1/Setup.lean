/-
  Area E1 (WilE1): shared vocabulary for the Bezout bounds.

  `jacDet` is the Jacobian determinant of a `k`-tuple of polynomials in `k` variables
  (`jacDetEval` is its value at a point of `ℝ^k`), and `sysIdeal` is the ideal generated by
  such a tuple.  All the statements of area E1 are phrased with these names.
-/
import Submission.Work.Wilkies.E.Spec
import Mathlib.RingTheory.Polynomial.Resultant.Basic
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

set_option autoImplicit false
noncomputable section
open Classical
namespace Work.WilE1

/-- The Jacobian matrix of a `k`-tuple of polynomials in `k` variables. -/
def jac {k : ℕ} {R : Type*} [CommSemiring R] (F : Fin k → MvPolynomial (Fin k) R) :
    Matrix (Fin k) (Fin k) (MvPolynomial (Fin k) R) :=
  Matrix.of fun i j => MvPolynomial.pderiv j (F i)

/-- The Jacobian determinant of a `k`-tuple of polynomials in `k` variables, evaluated at `x`. -/
def jacDetEval {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℝ) (x : Fin k → ℝ) : ℝ :=
  (Matrix.of fun i j => MvPolynomial.eval x (MvPolynomial.pderiv j (F i))).det

/-- The ideal generated by a tuple of polynomials. -/
def sysIdeal {k : ℕ} {R : Type*} [CommSemiring R] (F : Fin k → MvPolynomial (Fin k) R) :
    Ideal (MvPolynomial (Fin k) R) :=
  Ideal.span (Set.range F)

/-- Degree bookkeeping: the sum of `totalDegree + 1` over a tuple of polynomials. -/
def degSum {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℝ) : ℕ :=
  ∑ i, ((F i).totalDegree + 1)

/-- The Jacobian determinant of a `k`-tuple of complex polynomials, evaluated at `x`. -/
def jacDetEvalC {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ) (x : Fin k → ℂ) : ℂ :=
  (Matrix.of fun i j => MvPolynomial.eval x (MvPolynomial.pderiv j (F i))).det

/-- The *lifted* system: `F` together with `1 - Y · det J(F)`, in `k+1` variables (`Y` is the
last variable).  Its zero set is in bijection with the nondegenerate zeros of `F`. -/
def lifted {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ) :
    Fin (k+1) → MvPolynomial (Fin (k+1)) ℂ :=
  Fin.lastCases
    (1 - MvPolynomial.X (Fin.last k) * MvPolynomial.rename Fin.castSucc (jac F).det)
    (fun j => MvPolynomial.rename Fin.castSucc (F j))

end Work.WilE1
