/-
  Work.WilE2 — the base case of the Khovanskii elimination: `r = 0` (no chain functions).

  The system is a purely polynomial one, `n` equations in `n` variables, and the claim is the
  Bezout-type bound `T.card ≤ (∑ i, deg F_i) ^ n` for the set `T` of nondegenerate zeros.

  The proof runs entirely over `ℂ`:

  * `Work.WilE1.eaPolyEquiv` identifies `EPoly n 0 = MvPolynomial (Fin n ⊕ Fin 0) ℝ` with
    `MvPolynomial (Fin n) ℝ`, turning `ESys n 0`-data into ordinary polynomials
    (`Work.WilE2.ESys_nil_dictionary`);
  * each nondegenerate zero `x` of the (complexified) system gives a *distinct* minimal prime
    `m_x` of the ideal generated by the system (`Work.WilE2.card_le_minimalPrimes_C`, the
    Taylor/Nakayama argument of area E1);
  * Bezout's bound on the number of components of a complete intersection
    (`Work.WilE2.bz_minimalPrimes`) bounds the number of those minimal primes by `∏ max (deg,1)`;
  * `∏ max (deg,1) ≤ (∑ deg)^n` for a system whose total degree is at least `1`.
-/
import Mathlib
import Submission.Work.WilE2.Defs
import Submission.Work.WilE1.Basic
import Submission.Work.WilE1.Setup
import Submission.Work.WilE1.Transfer
import Submission.Work.WilE2.ESys_nil_dictionary
import Submission.Work.WilE2.card_le_minimalPrimes_C
import Submission.Work.WilE2.BzPort.P59

set_option autoImplicit false
set_option maxHeartbeats 1000000

noncomputable section
open Classical
namespace Work.WilE2

open WilkiesDesign WilkiesDesign.E

/-! ## §1. Elementary degree bookkeeping -/

/-- Mapping the coefficients of a real polynomial into `ℂ` does not raise the total degree. -/
theorem totalDegree_map_complex {σ : Type*} (p : MvPolynomial σ ℝ) :
    (MvPolynomial.map (algebraMap ℝ ℂ) p).totalDegree ≤ p.totalDegree := by
  rw [MvPolynomial.totalDegree, MvPolynomial.totalDegree]
  exact Finset.sup_mono (MvPolynomial.support_map_subset (algebraMap ℝ ℂ) p)

/-- A polynomial of total degree `0` is a constant. -/
theorem eq_C_of_totalDegree_eq_zero {σ : Type*} (p : MvPolynomial σ ℝ)
    (h : p.totalDegree = 0) : p = MvPolynomial.C (p.coeff 0) :=
  MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h

/-- The product of the `max · 1`-regularised degrees is at most the `n`-th power of the total
degree, as soon as the total degree is at least `1`. -/
theorem prod_max_one_le_pow_sum {n : ℕ} (d : Fin n → ℕ) (hD : 1 ≤ ∑ i, d i) :
    ∏ i, (d i).max 1 ≤ (∑ i, d i) ^ n := by
  have hle : ∀ i ∈ (Finset.univ : Finset (Fin n)), (d i).max 1 ≤ ∑ j, d j := by
    intro i _
    refine max_le ?_ hD
    exact Finset.single_le_sum (f := d) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
  have h := Finset.prod_le_pow_card (Finset.univ : Finset (Fin n)) (fun i => (d i).max 1)
    (∑ j, d j) hle
  rw [Finset.card_univ, Fintype.card_fin] at h
  exact h

/-! ## §2. The conditional bound

`kho_base_of_pieces` is the whole argument with its two external inputs kept as hypotheses:
the dictionary `ESys n 0 → MvPolynomial (Fin n) ℂ` for nondegenerate zeros, and the two counting
statements over `ℂ`.  Each of the three is proved in its own module. -/

/-- **Base case of the Khovanskii elimination, from its three ingredients.** -/
theorem kho_base_of_pieces {n : ℕ} (S : ESys n 0) (F : Fin n → EPoly n 0)
    (T : Finset (Fin n → ℝ))
    (hT : ∀ x ∈ T, S.Nondegen F x)
    (hdict : ∀ x ∈ T,
      (∀ i, MvPolynomial.eval (fun j => (x j : ℂ))
        (MvPolynomial.map (algebraMap ℝ ℂ) (Work.WilE1.eaPolyEquiv n (F i))) = 0) ∧
      Work.WilE1.jacDetEvalC
        (fun i => MvPolynomial.map (algebraMap ℝ ℂ) (Work.WilE1.eaPolyEquiv n (F i)))
        (fun j => (x j : ℂ)) ≠ 0)
    (hcount : ∀ (G : Fin n → MvPolynomial (Fin n) ℂ) (U : Finset (Fin n → ℂ)),
      (∀ x ∈ U, (∀ i, MvPolynomial.eval x (G i) = 0) ∧ Work.WilE1.jacDetEvalC G x ≠ 0) →
      U.card ≤ Nat.card {P : Ideal (MvPolynomial (Fin n) ℂ) //
        P ∈ (Ideal.span (Set.range G)).minimalPrimes})
    (hbz : ∀ (G : Fin n → MvPolynomial (Fin n) ℂ),
      Nat.card {P : Ideal (MvPolynomial (Fin n) ℂ) //
        P ∈ (Ideal.span (Set.range G)).minimalPrimes} ≤ ∏ i, ((G i).totalDegree).max 1) :
    T.card ≤ (∑ i, (F i).totalDegree) ^ n := by
  rcases Nat.eq_zero_or_pos n with hn | hnpos
  · -- `n = 0`: `Fin 0 → ℝ` is a point
    subst hn
    have h1 : T.card ≤ 1 := by
      have h := Finset.card_le_univ T
      simpa using h
    simpa using h1
  · by_cases hD0 : ∑ i, (F i).totalDegree = 0
    · -- every equation is a constant, so there are no nondegenerate zeros
      have hAllZero : ∀ i, (F i).totalDegree = 0 := by
        intro i
        have h := Finset.single_le_sum (f := fun i => (F i).totalDegree)
          (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
        omega
      have hTempty : T = ∅ := by
        refine Finset.not_nonempty_iff_eq_empty.mp ?_
        rintro ⟨x, hx⟩
        obtain ⟨hvan, hdet⟩ := hT x hx
        have hconst : ∀ i, ∃ c : ℝ, F i = MvPolynomial.C c :=
          fun i => ⟨_, eq_C_of_totalDegree_eq_zero _ (hAllZero i)⟩
        choose c hc using hconst
        have hc0 : ∀ i, c i = 0 := by
          intro i
          have h := hvan i
          rw [hc i] at h
          simpa [ESys.ev, MvPolynomial.eval_C] using h
        have hF0 : ∀ i, F i = 0 := by
          intro i
          rw [hc i, hc0 i]
          exact map_zero _
        exact hdet (Matrix.det_eq_zero_of_row_eq_zero ⟨0, hnpos⟩ fun j => by
          simp [ESys.d, ESys.ev, hF0])
      rw [hTempty]
      simp [hD0]
    · -- the total degree is positive: complexify and count minimal primes
      have hDpos : 1 ≤ ∑ i, (F i).totalDegree := Nat.one_le_iff_ne_zero.mpr hD0
      let G : Fin n → MvPolynomial (Fin n) ℂ :=
        fun i => MvPolynomial.map (algebraMap ℝ ℂ) (Work.WilE1.eaPolyEquiv n (F i))
      let emb : (Fin n → ℝ) ↪ (Fin n → ℂ) :=
        Function.Embedding.mk _ (Work.WilE1.complexifyPoint_injective n)
      have hmap : ∀ y ∈ T.map emb,
          (∀ i, MvPolynomial.eval y (G i) = 0) ∧ Work.WilE1.jacDetEvalC G y ≠ 0 := by
        intro y hy
        obtain ⟨x, hx, rfl⟩ := Finset.mem_map.mp hy
        exact hdict x hx
      calc T.card = (T.map emb).card := (Finset.card_map emb).symm
        _ ≤ Nat.card {P : Ideal (MvPolynomial (Fin n) ℂ) //
              P ∈ (Ideal.span (Set.range G)).minimalPrimes} := hcount G (T.map emb) hmap
        _ ≤ ∏ i, ((G i).totalDegree).max 1 := hbz G
        _ ≤ ∏ i, ((F i).totalDegree).max 1 := by
            refine Finset.prod_le_prod (s := Finset.univ) fun i _ => ?_
            refine max_le_max ?_ le_rfl
            calc (G i).totalDegree
                ≤ (Work.WilE1.eaPolyEquiv n (F i)).totalDegree := totalDegree_map_complex _
              _ = (F i).totalDegree := Work.WilE1.totalDegree_eaPolyEquiv (F i)
        _ ≤ (∑ i, (F i).totalDegree) ^ n := prod_max_one_le_pow_sum _ hDpos

/-! ## §3. The components bound over `ℂ` (ported)

`Commons.RingTheory.Ideal.card_minimalPrimes_quotient_le_univ` — the Bezout bound for the number
of minimal primes of a complete intersection — is the statement proved by the lead-supplied reuse
file, split into the modules `Submission.Work.WilE2.BzPort.P01 … P59`.  Here it is put into the
form used below, i.e. with the minimal primes of the ideal itself rather than of the quotient. -/

theorem bz_minimalPrimes {n : ℕ} (F : Fin n → MvPolynomial (Fin n) ℂ) :
    Nat.card {P : Ideal (MvPolynomial (Fin n) ℂ) //
      P ∈ (Ideal.span (Set.range F)).minimalPrimes} ≤ ∏ i, ((F i).totalDegree).max 1 := by
  rw [← Commons.RingTheory.Ideal.card_minimalPrimes_quotient_eq (Ideal.span (Set.range F))]
  exact Commons.RingTheory.Ideal.card_minimalPrimes_quotient_le_univ F

/-! ## §4. The base case -/

theorem kho_base {n : ℕ} (S : ESys n 0) (F : Fin n → EPoly n 0) (T : Finset (Fin n → ℝ))
    (hT : ∀ x ∈ T, S.Nondegen F x) :
    T.card ≤ (∑ i, (F i).totalDegree) ^ n :=
  kho_base_of_pieces S F T hT
    (fun x hx => ESys_nil_dictionary S F T hT x hx)
    (fun G U hU => card_le_minimalPrimes_C G U hU)
    (fun G => bz_minimalPrimes G)

end Work.WilE2
