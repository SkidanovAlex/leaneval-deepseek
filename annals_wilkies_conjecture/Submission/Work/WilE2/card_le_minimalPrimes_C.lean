import Mathlib
import Submission.Work.WilE1.Setup
import Submission.Work.WilE1.TaylorTwo
import Submission.Work.WilE1.VanishSpan
import Submission.Work.WilE1.DetTrick
import Submission.Work.WilE1.SpanLeSysIdealSupSq
import Submission.Work.WilE1.LiftedFinite

set_option linter.style.haveILetI false

namespace Work.WilE2

/-!
  The number of nondegenerate common zeros of a system `G` of `n` polynomials in `n` variables
  is bounded by the number of minimal primes of the ideal generated by `G`.

  The mathematics is the classical Jacobian criterion (already available in area E1 as
  `Work.WilE1.isMaximal_of_isPrime_of_sysIdeal_le_of_det_notMem`): a prime containing the
  system `G` and not containing `det J(G)` is maximal.  Consequently the maximal ideal
  `𝔪_x = (X_1 - x_1, …, X_n - x_n)` of a nondegenerate zero `x` is a minimal prime of
  `(G)`, and distinct points give distinct maximal ideals.
-/

open Work.WilE1

/-- The Jacobian determinant of `G` is not in the maximal ideal of a nondegenerate zero `x`. -/
theorem jac_det_notMem_vanishingIdeal {n : ℕ} (G : Fin n → MvPolynomial (Fin n) ℂ)
    (x : Fin n → ℂ) (hdet : jacDetEvalC G x ≠ 0) :
    (jac G).det ∉ MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ)) := by
  rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, MvPolynomial.aeval_eq_eval]
  intro h
  apply hdet
  rw [← h]
  simp only [jacDetEvalC, jac]
  rw [RingHom.map_det]
  rfl

/-- **The maximal ideal of a nondegenerate zero is a minimal prime of the system ideal.**

If `x` is a common zero of `G` at which `det J(G)` does not vanish, then the maximal ideal of
`x` is a minimal prime of `(G_1, …, G_n)`.  Indeed any prime `y` containing `(G)` and not
containing `det J(G)` is maximal (Jacobian criterion), so a prime below `𝔪_x` must equal
`𝔪_x`. -/
theorem vanishingIdeal_mem_minimalPrimes_of_nondegen {n : ℕ} (G : Fin n → MvPolynomial (Fin n) ℂ)
    (x : Fin n → ℂ) (hzero : ∀ i, MvPolynomial.eval x (G i) = 0)
    (hdet : jacDetEvalC G x ≠ 0) :
    MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ)) ∈
      (Ideal.span (Set.range G)).minimalPrimes := by
  haveI : (MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ))).IsMaximal := inferInstance
  have hle : Ideal.span (Set.range G) ≤ MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ)) := by
    refine Ideal.span_le.mpr ?_
    rintro p ⟨i, rfl⟩
    exact (MvPolynomial.mem_vanishingIdeal_singleton_iff x (G i)).mpr (by
      rw [MvPolynomial.aeval_eq_eval]
      exact hzero i)
  have hdetm := jac_det_notMem_vanishingIdeal G x hdet
  refine ⟨⟨(inferInstance : (MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ))).IsMaximal).isPrime,
    hle⟩, ?_⟩
  intro y hy hyx
  have hdet_y : (jac G).det ∉ y := fun h => hdetm (hyx h)
  have hmax : y.IsMaximal :=
    isMaximal_of_isPrime_of_sysIdeal_le_of_det_notMem G hy.1 hy.2 hdet_y
  exact le_of_eq (hmax.eq_of_le (Ideal.IsMaximal.ne_top inferInstance) hyx).symm

/-- The map sending a point to the maximal ideal of functions vanishing at it is injective. -/
theorem vanishingIdeal_singleton_injective {n : ℕ} :
    Function.Injective (fun x : Fin n → ℂ =>
      MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ))) := by
  intro x y hxy
  have hxy' : MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ)) =
      MvPolynomial.vanishingIdeal ℂ ({y} : Set (Fin n → ℂ)) := hxy
  by_contra hne
  obtain ⟨i, hi⟩ : ∃ i, x i ≠ y i := by
    by_contra h
    have h' : ∀ i, x i = y i := fun i => of_not_not (not_exists.mp h i)
    exact hne (funext h')
  have h1 : (MvPolynomial.X i - MvPolynomial.C (x i)) ∈
      MvPolynomial.vanishingIdeal ℂ ({x} : Set (Fin n → ℂ)) := by
    rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, MvPolynomial.aeval_eq_eval]
    simp
  have h2 : (MvPolynomial.X i - MvPolynomial.C (x i)) ∉
      MvPolynomial.vanishingIdeal ℂ ({y} : Set (Fin n → ℂ)) := by
    rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, MvPolynomial.aeval_eq_eval]
    simp only [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_eq_zero]
    exact fun h => hi h.symm
  exact h2 (hxy' ▸ h1)

theorem card_le_minimalPrimes_C {n : ℕ} (G : Fin n → MvPolynomial (Fin n) ℂ) (T : Finset (Fin n → ℂ))
    (hT : ∀ x ∈ T, (∀ i, MvPolynomial.eval x (G i) = 0) ∧ Work.WilE1.jacDetEvalC G x ≠ 0) :
    T.card ≤ Nat.card {P : Ideal (MvPolynomial (Fin n) ℂ) //
      P ∈ (Ideal.span (Set.range G)).minimalPrimes} := by
  classical
  haveI : Finite (Ideal.span (Set.range G)).minimalPrimes :=
    (Ideal.finite_minimalPrimes_of_isNoetherianRing (MvPolynomial (Fin n) ℂ)
      (Ideal.span (Set.range G))).to_subtype
  haveI : Fintype {P : Ideal (MvPolynomial (Fin n) ℂ) //
      P ∈ (Ideal.span (Set.range G)).minimalPrimes} :=
    Fintype.ofFinite _
  have hinj : Function.Injective (fun x : {x // x ∈ T} =>
      (⟨MvPolynomial.vanishingIdeal ℂ ({x.val} : Set (Fin n → ℂ)),
        vanishingIdeal_mem_minimalPrimes_of_nondegen G x.val (hT x.val x.property).1
          (hT x.val x.property).2⟩ :
        {P : Ideal (MvPolynomial (Fin n) ℂ) //
          P ∈ (Ideal.span (Set.range G)).minimalPrimes})) := by
    intro x y hxy
    exact Subtype.ext (vanishingIdeal_singleton_injective (congrArg Subtype.val hxy))
  have hcard := Fintype.card_le_of_injective _ hinj
  rw [Fintype.card_coe] at hcard
  rwa [Nat.card_eq_fintype_card]

end Work.WilE2
