/-
  WilE8 / GenZero — a `Gen`-set of degree `0` is trivial.

  The `Gen`-filtration of area E is generated by the transported `*`-sets (`star`) and is
  closed under monotonicity, complement, projection and the two product operations, finite
  unions and finite intersections, and it contains the zero sets of single polynomials.

  At degree `0` every one of these operations preserves the two-element Boolean algebra
  `{∅, univ}` of "trivial" subsets of `ℝⁿ`:

  * a `*`-set of degree `0` is a union of `*`-pieces of degree `0`; a `SemiPf` set of degree
    `0` has no conditions at all, so it is `∅` or the whole cube, and the projection of the
    connected component of a point of the cube is again the cube (or empty when the point is
    outside the cube).  Transporting by `psiV` turns the cube into `univ`, since `psiV`
    always lands in the closed cube.  This is the main mathematical input, `star_zero` below,
    whose `SemiPf`-level ingredient is `Work.WilE7.star_deg_zero`.
  * `compl` swaps `∅` and `univ`, `proj`/`prod_right`/`prod_left` map `∅` to `∅` and `univ`
    to `univ`, and a union (resp. intersection) of trivial sets is trivial because a sum of
    natural numbers is `0` only when every summand is `0`.
  * the zero set of `P` with `P.totalDegree = 0` is `∅` or `univ`, since `eval x P` is then
    independent of `x`.

  Consequently the whole `0`-th degree slice of the filtration `Gen · 0 ·` is trivial.
-/
import Mathlib
import Submission.Work.WilE8.Basic
import Submission.Work.WilE7.star_deg_zero

set_option autoImplicit false
noncomputable section
open Classical Topology
namespace Work.WilE8.GenZero
open WilkiesDesign WilkiesDesign.E

/-! ## The degree-zero `*`-sets -/

/-- A `*`-set of degree `0` is trivial: it is either empty or the whole closed cube.
Each piece in the (finite) covering has degree `0` because a sum of natural numbers vanishes
only if every summand does, and a degree-zero piece is empty or the whole cube. -/
lemma star_zero {F n : ℕ} {Z : Set (Fin n → ℝ)} (h : Star F 0 n Z) :
    Z = ∅ ∨ Z = cubeC n := by
  obtain ⟨L, hZL, -, hdeg⟩ := h
  have hdeg0 : ∀ P ∈ L, P.X.deg = 0 := by
    intro P hP
    have h1 : P.X.deg ≤ (L.map fun Q => Q.X.deg).sum :=
      List.le_sum_of_mem (List.mem_map_of_mem hP)
    omega
  by_cases hex : ∃ P ∈ L, P.set = cubeC n
  · right
    obtain ⟨P, hP, hPc⟩ := hex
    rw [hZL]
    refine Set.Subset.antisymm ?_ ?_
    · intro x hx
      rw [mem_list_iUnion] at hx
      obtain ⟨Q, hQ, hx⟩ := hx
      exact StarPiece.set_subset_cube Q hx
    · intro x hx
      rw [mem_list_iUnion]
      exact ⟨P, hP, by rw [hPc]; exact hx⟩
  · left
    rw [hZL]
    refine Set.Subset.antisymm ?_ (Set.empty_subset _)
    intro x hx
    rw [mem_list_iUnion] at hx
    obtain ⟨P, hP, hx⟩ := hx
    rcases Work.WilE7.star_deg_zero.1 P (hdeg0 P hP) with h | h
    · rw [h] at hx; exact hx
    · exact hex ⟨P, hP, h⟩

/-- A transported `*`-set of degree `0` is trivial: it is either empty or all of `ℝⁿ`.
Indeed `psiV ⁻¹' ∅ = ∅` and `psiV ⁻¹' cubeC n = univ`, because `psiV` always lands in the
closed cube. -/
lemma starR_zero {F n : ℕ} {X : Set (Fin n → ℝ)} (h : StarR F 0 n X) :
    X = ∅ ∨ X = Set.univ := by
  obtain ⟨Z, hZ, hZX⟩ := h
  rw [hZX]
  rcases star_zero hZ with h | h
  · left
    rw [h]
    exact Set.preimage_empty
  · right
    rw [h]
    exact Set.eq_univ_iff_forall.mpr fun x => psiV_mem_cube x

/-! ## The `Gen`-induction -/

/-- The projection of the empty set (resp. of everything) along the last coordinate. -/
lemma projLast_empty {n : ℕ} : projLast (∅ : Set (Fin (n + 1) → ℝ)) = ∅ := by
  ext x; simp [projLast]

lemma projLast_univ {n : ℕ} : projLast (Set.univ : Set (Fin (n + 1) → ℝ)) = Set.univ := by
  ext x; simp [projLast]

/-- In a sum of natural numbers equal to `0`, every summand is `0`. -/
lemma sum_eq_zero_of_sum_eq_zero {k : ℕ} {D : Fin k → ℕ} (h : ∑ i, D i = 0) (i : Fin k) :
    D i = 0 := by
  have h1 : D i ≤ ∑ j, D j :=
    Finset.single_le_sum (f := D) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
  omega

/-- The zero set of a polynomial of total degree `0` is empty or everything: such a
polynomial is constant, so its evaluation does not depend on the point. -/
lemma hyp_triv {n : ℕ} (P : MvPolynomial (Fin n) ℝ) (hP : P.totalDegree = 0) :
    {x : Fin n → ℝ | MvPolynomial.eval x P = 0} = ∅ ∨
      {x : Fin n → ℝ | MvPolynomial.eval x P = 0} = Set.univ := by
  have hconst : ∀ x y : Fin n → ℝ, MvPolynomial.eval x P = MvPolynomial.eval y P := by
    intro x y
    rw [MvPolynomial.eval_eq', MvPolynomial.eval_eq']
    refine Finset.sum_congr rfl ?_
    intro d hd
    have hd0 : d = 0 := by
      ext i
      exact (MvPolynomial.totalDegree_eq_zero_iff _ P).mp hP d hd i
    rw [hd0]
    simp
  by_cases h0 : ∃ x : Fin n → ℝ, MvPolynomial.eval x P = 0
  · right
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_univ, iff_true]
    obtain ⟨y, hy⟩ := h0
    rw [hconst x y, hy]
  · left
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
    intro hx
    exact h0 ⟨x, hx⟩

/-- Every `Gen`-set of degree `0` is trivial. -/
theorem gen_triv {F D n : ℕ} {X : Set (Fin n → ℝ)} (h : Gen F D n X) :
    D = 0 → X = ∅ ∨ X = Set.univ := by
  induction h with
  | star hst => intro hD; exact starR_zero (hD ▸ hst)
  | mono_F h ih => exact ih
  | mono_D h ih => intro h0; exact absurd h0 (by simp)
  | compl h ih =>
      intro hD
      rcases ih hD with h | h
      · right; rw [h, Set.compl_empty]
      · left; rw [h, Set.compl_univ]
  | proj h ih =>
      intro hD
      rcases ih hD with h | h
      · left; rw [h]; exact projLast_empty
      · right; rw [h]; exact projLast_univ
  | prod_right h ih =>
      intro hD
      rcases ih hD with h | h
      · left; rw [h]; ext z; simp
      · right; rw [h]; ext z; simp
  | prod_left h ih =>
      intro hD
      rcases ih hD with h | h
      · left; rw [h]; ext z; simp
      · right; rw [h]; ext z; simp
  | union Dk A hpre ih =>
      intro hD
      by_cases hex : ∃ i, A i = Set.univ
      · right
        obtain ⟨i, hi⟩ := hex
        rw [Set.eq_univ_iff_forall]
        intro x
        exact Set.mem_iUnion.mpr ⟨i, by rw [hi]; exact Set.mem_univ x⟩
      · left
        refine Set.Subset.antisymm ?_ (Set.empty_subset _)
        intro x hx
        rw [Set.mem_iUnion] at hx
        obtain ⟨i, hi⟩ := hx
        rcases ih i (sum_eq_zero_of_sum_eq_zero hD i) with h | h
        · rw [h] at hi; exact hi
        · exact hex ⟨i, h⟩
  | inter Dk A hpre ih =>
      intro hD
      by_cases hex : ∃ i, A i = ∅
      · left
        obtain ⟨i, hi⟩ := hex
        refine Set.Subset.antisymm ((Set.iInter_subset A i).trans (by rw [hi]))
          (Set.empty_subset _)
      · right
        rw [Set.eq_univ_iff_forall]
        intro x
        rw [Set.mem_iInter]
        intro i
        rcases ih i (sum_eq_zero_of_sum_eq_zero hD i) with h | h
        · exact absurd ⟨i, h⟩ hex
        · rw [h]; exact Set.mem_univ x
  | hyp n P => exact hyp_triv P

theorem eq_empty_or_univ {F n : ℕ} {X : Set (Fin n → ℝ)} (h : WilkiesDesign.E.Gen F 0 n X) :
    X = ∅ ∨ X = Set.univ :=
  gen_triv h rfl

end Work.WilE8.GenZero
