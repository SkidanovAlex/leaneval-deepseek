/-
  WilE9 — area E9 (sharp derivatives, BNZ §3) of `annals_wilkies_conjecture`.

  This file fixes the vocabulary of the E9 development and the elementary algebra of the
  frozen inductive `Gen` and of `Star`/`StarR`.  Everything else in `Submission/Work/WilE9`
  imports it.

  Conventions (they are the conventions of the lead design `Submission/Work/Wilkies/E/DESIGN.md`):

  * `sdSet f k v` is *verbatim* the set appearing in `SOMin.SharpDeriv`; the whole area is the
    statement that `sdSet f k v ∈ Gen a (b D) (n+1)` whenever `graphOf f ∈ Gen F D (n+1)`.
  * `psig x = 1/√(1+x²)` is the auxiliary `w`-coordinate for ψ: with `s = psi x` one has
    `s² + psig x² = 1`, `deriv psi x = psig x ^ 3` and `deriv psig x = -(psi x) * psig x^2`.
    Those two identities are what makes every `ψ`-transported derivative an *algebraic* factor.
  * `Gen.monoF`, `Gen.monoD` let us move formats and degrees upward, which is what makes the
    cost bookkeeping of the assembly possible.
-/
import Submission.Work.Wilkies.E.Spec
import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas
import Mathlib.LinearAlgebra.Matrix.Adjugate

set_option autoImplicit false
set_option maxHeartbeats 1000000
noncomputable section

open Classical Topology
namespace Work.WilE9
open WilkiesDesign WilkiesDesign.E

/-! ## 1. The set that `SharpDeriv` speaks about -/

/-- The graph of the `k`-th order derivative of `f` in the directions `v` (the set of
`SOMin.SharpDeriv`). Its domain of definition is the interior of the `C^k` locus of `f`.
The body is copied verbatim from `WilkieDesign.E.SOMin.SharpDeriv`. -/
def sdSet {n : ℕ} (f : (Fin n → ℝ) → ℝ) (k : ℕ) (v : Fin k → Fin n) : Set (Fin (n + 1) → ℝ) :=
  {z : Fin (n + 1) → ℝ | Fin.init z ∈ interior {x | ContDiffAt ℝ k f x} ∧
    z (Fin.last n) = iteratedFDeriv ℝ k f (Fin.init z) (fun j => Pi.single (v j) 1)}

/-- The `k`-th order derivative of `f` in the directions `v`, evaluated at `x`. -/
def dmulti {n : ℕ} (f : (Fin n → ℝ) → ℝ) (k : ℕ) (v : Fin k → Fin n) (x : Fin n → ℝ) : ℝ :=
  iteratedFDeriv ℝ k f x (fun j => Pi.single (v j) 1)

/-- The list-indexed iterated directional derivative. `glDeriv [i₁,…,i_k] f x` is
`∂_{i₁}⋯∂_{i_k} f` at `x`: the *head* of the list is the *outermost* derivative. This matches
the convention of `iteratedFDeriv` on the same list of directions (see `glDeriv_ofFn`), and it
is the indexing used by the implicit-function recursion of `WilE9/Ift.lean`. -/
def glDeriv {n : ℕ} : List (Fin n) → ((Fin n → ℝ) → ℝ) → ((Fin n → ℝ) → ℝ)
  | [], f => f
  | i :: L, f => fun x => fderiv ℝ (glDeriv L f) x (Pi.single i 1)

theorem sdSet_eq {n : ℕ} (f : (Fin n → ℝ) → ℝ) (k : ℕ) (v : Fin k → Fin n) :
    sdSet f k v = {z : Fin (n + 1) → ℝ |
      Fin.init z ∈ interior {x | ContDiffAt ℝ k f x} ∧
      z (Fin.last n) = dmulti f k v (Fin.init z)} := rfl

/-! ## 2. The ψ-algebra: `psi` and its auxiliary square root coordinate -/

/-- `w = 1/√(1+x²)`: with `s = psi x`, the pair `(s,w)` satisfies `s² + w² = 1`.
Consequently `deriv psi x = w^3` and `deriv w x = -s * w^2` *inside the ring generated by
`s` and `w`* — this is what makes ψ-transported derivatives algebraic. -/
def psig (x : ℝ) : ℝ := 1 / Real.sqrt (1 + x ^ 2)

/-- The inverse of `psi`: `ℝ → (-1,1)`, `y ↦ y/√(1-y²)`. -/
def psiInv (y : ℝ) : ℝ := y / Real.sqrt (1 - y ^ 2)

/-! ## 3. Monotonicity of the frozen `Gen` filtration -/

/-- Format monotonicity of `Gen`. -/
theorem Gen.monoF {F F' D n : ℕ} {X : Set (Fin n → ℝ)} (h : F ≤ F') (hX : Gen F D n X) :
    Gen F' D n X := by
  induction F', h using Nat.le_induction with
  | base => exact hX
  | succ k _ ih => exact Gen.mono_F ih

/-- Degree monotonicity of `Gen`. -/
theorem Gen.monoD {F D D' n : ℕ} {X : Set (Fin n → ℝ)} (h : D ≤ D') (hX : Gen F D n X) :
    Gen F D' n X := by
  induction D', h using Nat.le_induction with
  | base => exact hX
  | succ k _ ih => exact Gen.mono_D ih

/-- Simultaneous monotonicity. -/
theorem Gen.mono {F D F' D' n : ℕ} {X : Set (Fin n → ℝ)} (hF : F ≤ F') (hD : D ≤ D')
    (hX : Gen F D n X) : Gen F' D' n X :=
  Gen.monoD hD (Gen.monoF hF hX)

/-! ## 4. Elementary closure properties of `Gen` -/

/-- `Gen` is closed under arbitrary finite unions indexed by a `Fintype`. -/
theorem Gen.iUnion {F : ℕ} {n : ℕ} {ι : Type*} [Fintype ι] (D : ι → ℕ)
    (A : ι → Set (Fin n → ℝ)) (h : ∀ i, Gen F (D i) n (A i)) :
    Gen F (∑ i, D i) n (⋃ i, A i) := by
  classical
  set e := Fintype.equivFin ι with he
  have h' : Gen F (∑ i : Fin (Fintype.card ι), D (e.symm i)) n
      (⋃ i : Fin (Fintype.card ι), A (e.symm i)) :=
    Gen.union (fun i => D (e.symm i)) (fun i => A (e.symm i)) (fun i => h _)
  have hsum : (∑ i : Fin (Fintype.card ι), D (e.symm i)) = ∑ i : ι, D i :=
    Equiv.sum_comp e.symm D
  have hset : (⋃ i : Fin (Fintype.card ι), A (e.symm i)) = ⋃ i : ι, A i := by
    ext z
    simp only [Set.mem_iUnion]
    exact ⟨fun ⟨i, hi⟩ => ⟨e.symm i, hi⟩, fun ⟨i, hi⟩ => ⟨e i, by simpa using hi⟩⟩
  rw [hsum, hset] at h'
  exact h'

/-- `Gen` is closed under intersections of two sets (degree adds, format grows by one). -/
theorem Gen.inter₂ {F₁ F₂ D₁ D₂ n : ℕ} {X Y : Set (Fin n → ℝ)} (hX : Gen F₁ D₁ n X)
    (hY : Gen F₂ D₂ n Y) : Gen (max F₁ F₂ + 1) (D₁ + D₂) n (X ∩ Y) := by
  have hX' : Gen (max F₁ F₂) D₁ n X := Gen.monoF (le_max_left _ _) hX
  have hY' : Gen (max F₁ F₂) D₂ n Y := Gen.monoF (le_max_right _ _) hY
  have h := Gen.inter (fun i : Fin 2 => if i = 0 then D₁ else D₂)
    (fun i : Fin 2 => if i = 0 then X else Y) (by
      intro i
      fin_cases i
      · simpa using hX'
      · simpa using hY')
  have hsum : (∑ i : Fin 2, (if i = 0 then D₁ else D₂)) = D₁ + D₂ := by
    rw [Fin.sum_univ_two]
    simp
  have hset : (⋂ i : Fin 2, (if i = 0 then X else Y)) = X ∩ Y := by
    ext z
    simp [Fin.forall_fin_two]
  rw [hsum, hset] at h
  exact h

/-- `Gen` is closed under binary unions; the format does not grow. -/
theorem Gen.union₂ {F₁ F₂ D₁ D₂ n : ℕ} {X Y : Set (Fin n → ℝ)} (hX : Gen F₁ D₁ n X)
    (hY : Gen F₂ D₂ n Y) : Gen (max F₁ F₂) (D₁ + D₂) n (X ∪ Y) := by
  have hX' : Gen (max F₁ F₂) D₁ n X := Gen.monoF (le_max_left _ _) hX
  have hY' : Gen (max F₁ F₂) D₂ n Y := Gen.monoF (le_max_right _ _) hY
  have h := Gen.union (fun i : Fin 2 => if i = 0 then D₁ else D₂)
    (fun i : Fin 2 => if i = 0 then X else Y) (by
      intro i
      fin_cases i
      · simpa using hX'
      · simpa using hY')
  have hsum : (∑ i : Fin 2, (if i = 0 then D₁ else D₂)) = D₁ + D₂ := by
    rw [Fin.sum_univ_two]
    simp
  have hset : (⋃ i : Fin 2, (if i = 0 then X else Y)) = X ∪ Y := by
    ext z
    simp [Fin.exists_fin_two]
  rw [hsum, hset] at h
  exact h

/-- `Gen` is closed under the complement, at the cost of one format. -/
theorem Gen.compl' {F D n : ℕ} {X : Set (Fin n → ℝ)} (h : Gen F D n X) :
    Gen (F + 1) D n Xᶜ := Gen.compl h

/-- The empty set is in every `Gen F 0 n`. -/
theorem Gen.empty (F n : ℕ) : Gen F 0 n (∅ : Set (Fin n → ℝ)) := by
  have h : (⋃ i : Fin 0, (fun _ : Fin 0 => (∅ : Set (Fin n → ℝ))) i) = (∅ : Set (Fin n → ℝ)) := by
    simp
  rw [← h]
  exact Gen.iUnion (fun _ : Fin 0 => 0) (fun _ => ∅) (fun i => i.elim0)

/-- The whole space is in every `Gen (F+1) 0 n`. -/
theorem Gen.univ (F n : ℕ) : Gen (F + 1) 0 n (Set.univ : Set (Fin n → ℝ)) := by
  have h := Gen.empty F n
  simpa using Gen.compl h

/-! ## 5. Monotonicity for `Star` and `StarR`, and the bridge to `Gen` -/

theorem Star.mono {F D F' D' n : ℕ} {X : Set (Fin n → ℝ)} (hF : F ≤ F') (hD : D ≤ D')
    (h : Star F D n X) : Star F' D' n X := by
  obtain ⟨L, hL, hfmt, hdeg⟩ := h
  exact ⟨L, hL, fun P hP => le_trans (hfmt P hP) hF, le_trans hdeg hD⟩

theorem StarR.mono {F D F' D' n : ℕ} {X : Set (Fin n → ℝ)} (hF : F ≤ F') (hD : D ≤ D')
    (h : StarR F D n X) : StarR F' D' n X := by
  obtain ⟨Z, hZ, hX⟩ := h
  exact ⟨Z, Star.mono hF hD hZ, hX⟩

/-- Every `Star` set gives a `Gen` set by taking the `psiV`-preimage. -/
theorem Star.toGen {F D n : ℕ} {Z : Set (Fin n → ℝ)} (h : Star F D n Z) :
    Gen F D n (psiV ⁻¹' Z) := Gen.star ⟨Z, h, rfl⟩

/-- Every `StarR` set is `Gen`. -/
theorem StarR.toGen {F D n : ℕ} {X : Set (Fin n → ℝ)} (h : StarR F D n X) : Gen F D n X := by
  obtain ⟨Z, hZ, rfl⟩ := h
  exact Gen.star ⟨Z, hZ, rfl⟩

end Work.WilE9
