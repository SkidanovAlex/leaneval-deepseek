import Mathlib
import Submission.Work.WilE9.Defs
import Submission.Work.WilE9.Psi.hasDerivAt_psi
import Submission.Work.WilE9.Psi.hasDerivAt_psig
import Submission.Work.WilE9.Psi.psi_psig_algebra
import Submission.Work.WilE9.Deriv.mvPolyDeriv

/-!
# The jet of `ψ` is polynomial in `(ψ, psig)`

`ψ x = x/√(1+x²)` and `psig x = 1/√(1+x²)` generate the two algebraic coordinates of the
`ψ`-transport of the E9 development.  The two first derivatives

`ψ' = psig³`, `psig' = -ψ · psig²`

are *polynomial* in `(ψ, psig)`, and it follows by the chain rule that this stays true for every
iterated derivative: the whole jet of `ψ` lives in `ℝ[ψ x, psig x]` and needs no further
variables.  This is the Faà di Bruno input for the higher `ψ`-transport of area E9.

The mathematical content of the proof is the chain rule

`d/dt [ P(ψ t, psig t) ] = (∂₁P)(ψ,psig)·psig³ + (∂₂P)(ψ,psig)·(−ψ·psig²)`,

i.e. that the derivative of a polynomial expression in the two first integrals of the vector
field `(psig³, -ψ psig²)` is again a polynomial expression in the same two first integrals:
the polynomials are closed under the derivation `D P = ∂₁P · X₁³ − ∂₂P · X₀X₁²`.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

open MvPolynomial

namespace Work.WilE9.Psi

/-- The one-dimensional Fréchet derivative `c • 1` of a `HasDerivAt` agrees with its
`ContinuousLinearMap.toSpanSingleton` presentation. -/
private lemma toSpanSingleton_eq_smul_one (c : ℝ) :
    ContinuousLinearMap.toSpanSingleton ℝ c = c • (1 : ℝ →L[ℝ] ℝ) := by
  ext
  simp

/-- The curve `t ↦ (ψ t, psig t)` is differentiable, with derivative
`t ↦ t · (psig³, −ψ psig²)`.  The two components are `hasDerivAt_psi`/`hasDerivAt_psig`. -/
private lemma curve_hasFDerivAt (x : ℝ) :
    HasFDerivAt (fun y : ℝ => ![WilkiesDesign.E.psi y, Work.WilE9.psig y])
      (ContinuousLinearMap.pi ![Work.WilE9.psig x ^ 3 • (1 : ℝ →L[ℝ] ℝ),
          (-(WilkiesDesign.E.psi x) * Work.WilE9.psig x ^ 2) • (1 : ℝ →L[ℝ] ℝ)]) x := by
  rw [hasFDerivAt_pi]
  intro i
  fin_cases i
  · simpa [toSpanSingleton_eq_smul_one] using (hasDerivAt_psi x).hasFDerivAt
  · simpa [toSpanSingleton_eq_smul_one] using (hasDerivAt_psig x).hasFDerivAt

/-- **The chain rule for `ℝ[ψ, psig]`.**  For every polynomial `P` in two variables, the
derivative of `x ↦ P(ψ x, psig x)` is again of the form `x ↦ Q(ψ x, psig x)`, with the explicit
`Q = ∂₁P · X₁³ − ∂₂P · (X₀X₁²)` (here `X₀ ↦ ψ`, `X₁ ↦ psig`).

The proof is the chain rule: `MvPolynomial.eval` is differentiable with Fréchet derivative
`∑ᵢ (∂ᵢP)(a) • projᵢ` (`Work.WilE9.Deriv.mvPolyDeriv`, absent from Mathlib), and the curve
`(ψ, psig)` has derivative `(psig³, −ψ psig²)`. -/
private lemma deriv_eval_psi_psig (P : MvPolynomial (Fin 2) ℝ) (x : ℝ) :
    deriv (fun y : ℝ => MvPolynomial.eval ![WilkiesDesign.E.psi y, Work.WilE9.psig y] P) x
      = MvPolynomial.eval ![WilkiesDesign.E.psi x, Work.WilE9.psig x]
          (MvPolynomial.pderiv 0 P * MvPolynomial.X 1 ^ 3
            - MvPolynomial.pderiv 1 P * (MvPolynomial.X 0 * MvPolynomial.X 1 ^ 2)) := by
  have hc := (Work.WilE9.Deriv.mvPolyDeriv P ![WilkiesDesign.E.psi x, Work.WilE9.psig x]).comp x
    (curve_hasFDerivAt x)
  have hd : deriv (fun y : ℝ => MvPolynomial.eval ![WilkiesDesign.E.psi y, Work.WilE9.psig y] P) x
      = ((∑ i, (MvPolynomial.eval ![WilkiesDesign.E.psi x, Work.WilE9.psig x]
              (MvPolynomial.pderiv i P)) •
            (ContinuousLinearMap.proj i : (Fin 2 → ℝ) →L[ℝ] ℝ))
          ∘SL ContinuousLinearMap.pi ![Work.WilE9.psig x ^ 3 • (1 : ℝ →L[ℝ] ℝ),
              (-(WilkiesDesign.E.psi x) * Work.WilE9.psig x ^ 2) • (1 : ℝ →L[ℝ] ℝ)]) 1 :=
    hc.hasDerivAt.deriv
  rw [hd]
  simp only [Fin.sum_univ_two, ContinuousLinearMap.comp_apply, add_apply, smul_apply,
    ContinuousLinearMap.proj_apply, smul_eq_mul, ContinuousLinearMap.pi_apply, one_apply_eq_self,
    mul_one, map_sub, map_mul, map_pow, MvPolynomial.eval_X, Matrix.cons_val_zero,
    Matrix.cons_val_one]
  ring

/-- The explicit sequence of polynomials `P_j` with `ψ^{(j)} = P_j(ψ, psig)`, generated by the
derivation `D P = ∂₁P · X₁³ − ∂₂P · (X₀X₁²)` of `ℝ[X₀, X₁]` (the Lie derivative along the
vector field `(psig³, −ψ psig²)` in the `(ψ, psig)` coordinates). -/
private noncomputable def psiJetPoly : ℕ → MvPolynomial (Fin 2) ℝ
  | 0 => MvPolynomial.X 0
  | n + 1 => MvPolynomial.pderiv 0 (psiJetPoly n) * MvPolynomial.X 1 ^ 3
      - MvPolynomial.pderiv 1 (psiJetPoly n) * (MvPolynomial.X 0 * MvPolynomial.X 1 ^ 2)

/-- **Every iterated derivative of `ψ` is a polynomial in `(ψ x, psig x)`.**  Inductively,
`ψ^{(j+1)} = (∂₁P_j)(ψ,w)·w³ + (∂₂P_j)(ψ,w)·(−ψ w²)`, which stays polynomial because
`hasDerivAt_psi`/`hasDerivAt_psig` express the two derivatives inside the ring
`ℝ[ψ x, psig x]`.  This is the Faà di Bruno input for the higher `ψ`-transport: the whole jet
of the outer function `ψ` lives in the two algebraic generators and needs no extra variables. -/
theorem psi_iteratedDeriv_poly (j : ℕ) :
    ∃ P : MvPolynomial (Fin 2) ℝ, ∀ x : ℝ,
      iteratedDeriv j WilkiesDesign.E.psi x =
        MvPolynomial.eval ![WilkiesDesign.E.psi x, Work.WilE9.psig x] P := by
  refine ⟨psiJetPoly j, ?_⟩
  induction j with
  | zero =>
    intro x
    show iteratedDeriv 0 WilkiesDesign.E.psi x
      = MvPolynomial.eval ![WilkiesDesign.E.psi x, Work.WilE9.psig x] (MvPolynomial.X 0)
    rw [MvPolynomial.eval_X]
    simp
  | succ n ih =>
    intro x
    rw [iteratedDeriv_succ]
    have hfun : iteratedDeriv n WilkiesDesign.E.psi
        = fun y => MvPolynomial.eval ![WilkiesDesign.E.psi y, Work.WilE9.psig y]
            (psiJetPoly n) := funext ih
    rw [hfun]
    have h := deriv_eval_psi_psig (psiJetPoly n) x
    simp only [psiJetPoly] at h ⊢
    exact h

end Work.WilE9.Psi
