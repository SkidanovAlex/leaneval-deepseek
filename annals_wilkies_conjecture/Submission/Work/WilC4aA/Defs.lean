/-
  WilC4aA : area C4a of `annals_wilkies_conjecture` -- the analytic asymptotics step `C4a_asym`.

  This module fixes the vocabulary of the area.  The frozen statement
  `WilkiesDesign.CG.C4a.C4a_asym` says:  given curve selection in every dimension, a set `Y`
  whose slice at the parameter `c` is (over `t = 1/x > 0`) a finite union of good basic
  semianalytic pieces, and such that the slice is the graph of a function of `x`, the function
  is polynomially bounded with a rational exponent (or eventually zero).

  The plan of the proof (`Submission/Work/Wilkies/CG/C4a/DESIGN.md`) is:

  * a sequence of slice points with `t -> 0` produces a piece whose closure meets `{t = 0}`
    (`Accum`), a limit point `q` with `q 0 = 0`, and -- by curve selection -- an analytic arc
    `gamma` in the piece;
  * along the arc, `t(s) = s^N u(s)` with `u(0) > 0` (`analytic_factor`) and the value function
    has one-sided asymptotics as `s -> 0+` (`HasAsymAt0`), whence `y ~ a t^q` with `q` rational;
  * the graph hypothesis turns the statement along the arc into the statement for every slice
    point, and the slice description is used to see that the arc really produces slice points.

  ## Vocabulary

  * `Accum P`            : the piece `P` has points with `t = z 0` arbitrarily close to `0`.
  * `HasAsymAt0 f`       : one-sided asymptotics of `f` at `0+`: either `f` vanishes at `0+`, or
                           `f(s)/s^k -> b` for some integer `k` and some `b ≠ 0`.
  * `HasAsymT f`         : the same, with a *rational* exponent, i.e. the shape of the conclusion
                           of `PBOne` for a function of `t`.
  * `arcVal P γ`         : the `y`-value that the point `γ s` represents, `z 1` or `z 1⁻¹`
                           according to `P.inv`.
-/
import Submission.Work.Wilkies.CG.C4a.Spec
import Mathlib.Analysis.Analytic.Order

set_option autoImplicit false
noncomputable section
open Classical Topology Filter Set
namespace Work.WilC4aA

open WilkiesDesign WilkiesDesign.CG WilkiesDesign.CG.C4a

/-! ## 1. Definitions -/

/-- The piece `P` has points whose `t`-coordinate is arbitrarily close to `0` from above. -/
def Accum (P : LiftPiece) : Prop :=
  ∀ δ > (0 : ℝ), ∃ z ∈ P.set, z 0 ∈ Set.Ioo (0 : ℝ) δ

/-- One-sided asymptotics at `0⁺`: either `f` vanishes for all small positive arguments, or
`f(s)/s^k` tends to a nonzero limit for some integer exponent `k`. -/
def HasAsymAt0 (f : ℝ → ℝ) : Prop :=
  (f =ᶠ[𝓝[>] (0 : ℝ)] 0) ∨
    ∃ (k : ℤ) (b : ℝ), b ≠ 0 ∧
      Tendsto (fun s : ℝ => f s / s ^ (k : ℝ)) (𝓝[>] (0 : ℝ)) (𝓝 b)

/-- Asymptotics of a function of the positive real variable `t = x⁻¹`, in the shape used by
`PBOne`: either it vanishes eventually, or `f(t)/t^q` tends to a nonzero limit for some `q : ℚ`. -/
def HasAsymT (f : ℝ → ℝ) : Prop :=
  (f =ᶠ[𝓝[>] (0 : ℝ)] 0) ∨
    ∃ (q : ℚ) (a : ℝ), a ≠ 0 ∧
      Tendsto (fun t : ℝ => f t / t ^ ((q : ℝ))) (𝓝[>] (0 : ℝ)) (𝓝 a)

/-- The `y`-value represented by the point `z` of the piece `P`: `z 1`, or its inverse for an
inverted piece. -/
def arcVal (P : LiftPiece) (γ : ℝ → Fin (P.m + 2) → ℝ) : ℝ → ℝ :=
  fun s => if P.inv then ((γ s) 1)⁻¹ else (γ s) 1

/-! ## 2. Basic API -/

theorem accum_iff (P : LiftPiece) :
    Accum P ↔ ∀ δ > (0 : ℝ), ∃ z ∈ P.set, z 0 ∈ Set.Ioo (0 : ℝ) δ := Iff.rfl

theorem LiftPiece.set_eq_BasicSA (P : LiftPiece) : P.set = BasicSA P.F P.g := rfl

@[simp] theorem arcVal_apply (P : LiftPiece) (γ : ℝ → Fin (P.m + 2) → ℝ) (s : ℝ) :
    arcVal P γ s = if P.inv then ((γ s) 1)⁻¹ else (γ s) 1 := rfl

theorem arcVal_of_false {P : LiftPiece} (h : P.inv = false) (γ : ℝ → Fin (P.m + 2) → ℝ) :
    arcVal P γ = fun s => (γ s) 1 := by
  funext s
  simp [arcVal, h]

theorem arcVal_of_true {P : LiftPiece} (h : P.inv = true) (γ : ℝ → Fin (P.m + 2) → ℝ) :
    arcVal P γ = fun s => ((γ s) 1)⁻¹ := by
  funext s
  simp [arcVal, h]

/-- `𝓝[>] 0` is generated by the intervals `(0, δ)`. -/
theorem eventually_nhdsGT_iff {p : ℝ → Prop} :
    (∀ᶠ s in 𝓝[>] (0 : ℝ), p s) ↔ ∃ δ > (0 : ℝ), ∀ s ∈ Set.Ioo (0 : ℝ) δ, p s :=
  (nhdsGT_basis (0 : ℝ)).eventually_iff.trans
    ⟨fun ⟨δ, hδ, h⟩ => ⟨δ, hδ, fun _ hs => h hs⟩, fun ⟨δ, hδ, h⟩ => ⟨δ, hδ, fun s hs => h s hs⟩⟩

/-- An interval statement gives an `𝓝[>] 0` statement. -/
theorem eventually_nhdsGT_of_forall_Ioo {p : ℝ → Prop} {δ : ℝ} (hδ : 0 < δ)
    (h : ∀ s ∈ Set.Ioo (0 : ℝ) δ, p s) : ∀ᶠ s in 𝓝[>] (0 : ℝ), p s :=
  eventually_nhdsGT_iff.mpr ⟨δ, hδ, h⟩

/-- `HasAsymAt0` only depends on the germ at `0⁺`. -/
theorem HasAsymAt0.of_eventuallyEq {f g : ℝ → ℝ} (hfg : f =ᶠ[𝓝[>] (0 : ℝ)] g)
    (hg : HasAsymAt0 g) : HasAsymAt0 f := by
  rcases hg with h | ⟨k, b, hb, hT⟩
  · exact Or.inl (hfg.trans h)
  · refine Or.inr ⟨k, b, hb, ?_⟩
    have hfg' : (fun s : ℝ => g s / s ^ (k : ℝ)) =ᶠ[𝓝[>] (0 : ℝ)]
        (fun s : ℝ => f s / s ^ (k : ℝ)) := by
      filter_upwards [hfg] with s hs
      rw [hs]
    exact hT.congr' hfg'

/-! ## 3. Accessors for `LiftPiece.Good` -/

theorem good_anF {P : LiftPiece} (h : P.Good) : ∀ z, AnalyticAt ℝ P.F z := h.1

theorem good_ang {P : LiftPiece} (h : P.Good) : ∀ (j : Fin P.l) (z : Fin (P.m + 2) → ℝ),
    AnalyticAt ℝ (P.g j) z := h.2.1

theorem good_isBounded {P : LiftPiece} (h : P.Good) : Bornology.IsBounded P.set := h.2.2.1

theorem good_pos {P : LiftPiece} (h : P.Good) : ∀ z ∈ P.set, 0 < z 0 := h.2.2.2.1

theorem good_neZero {P : LiftPiece} (h : P.Good) :
    P.inv = true → ∀ z ∈ P.set, z 1 ≠ 0 := h.2.2.2.2

end Work.WilC4aA
