/-
  Area E7, dimension-one case of BV Proposition 9: the cell vocabulary.

  For the `n = 1` case of BV Proposition 9 the cells of `cubeC 1 = [-1,1]` produced by the
  proof are the singletons `{t}` and the open intervals `(a,b)`, cut out by a finite set `U`
  of "cut points" (with `-1` and `1` always among them).  This file fixes that vocabulary and
  its elementary API; the three non-trivial structural lemmas
  * `cuts_isCylDecompOn`     (the family really is a cylindrical decomposition of `cubeC 1`),
  * `cell_star_subpf`        (every such cell is `Star 1 4 1` and `SubPf 1`),
  * `interval_subset_of_ordConnected` (the real-analysis ingredient used for compatibility)
  are proved in the sibling files `DimOneCellsCyl`, `DimOneCellsStar` and `DimOneCellsCompat`.
-/
import Mathlib
import Submission.Work.WilE7.Defs

set_option autoImplicit false
noncomputable section
open Classical
namespace Work.WilE7
open WilkiesConjecture WilkiesDesign WilkiesDesign.E

/-! ## Points and cells of the line `ℝ¹ = Fin 1 → ℝ` -/

/-- The point `t` of the line `ℝ¹ = Fin 1 → ℝ`. -/
def pt1 (t : ℝ) : Fin 1 → ℝ := fun _ => t

@[simp] theorem pt1_apply (t : ℝ) (i : Fin 1) : pt1 t i = t := rfl

theorem pt1_eq_iff {t : ℝ} {x : Fin 1 → ℝ} : x = pt1 t ↔ x 0 = t := by
  constructor
  · rintro rfl; rfl
  · intro h
    funext i
    rw [Fin.eq_zero i]
    exact h

/-- The singleton cell `{t} ⊆ ℝ¹`. -/
def cellPt (t : ℝ) : Set (Fin 1 → ℝ) := {pt1 t}

/-- The open cell `(a,b) ⊆ ℝ¹`. -/
def cellIoo (a b : ℝ) : Set (Fin 1 → ℝ) := {x | a < x 0 ∧ x 0 < b}

@[simp] theorem mem_cellPt {t : ℝ} {x : Fin 1 → ℝ} : x ∈ cellPt t ↔ x = pt1 t := Iff.rfl

@[simp] theorem mem_cellIoo {a b : ℝ} {x : Fin 1 → ℝ} :
    x ∈ cellIoo a b ↔ a < x 0 ∧ x 0 < b := Iff.rfl

theorem cellPt_nonempty (t : ℝ) : (cellPt t).Nonempty := ⟨pt1 t, rfl⟩

theorem cellIoo_nonempty {a b : ℝ} (h : a < b) : (cellIoo a b).Nonempty :=
  ⟨pt1 ((a + b) / 2), by
    rw [mem_cellIoo, pt1_apply]
    exact ⟨by linarith, by linarith⟩⟩

/-- The "consecutive pairs" of a finite set `U ⊆ ℝ`: the pairs `(a,b) ∈ U × U` with `a < b`
and no element of `U` strictly between them.

The `DecidablePred` instance is pinned to `Classical.propDecidable`, as in
`Submission.Work.WilE7.Defs`, so that uses of the definition never depend on instance
synthesis. -/
def cutPairs (U : Finset ℝ) : Finset (ℝ × ℝ) :=
  @Finset.filter (ℝ × ℝ)
    (fun p : ℝ × ℝ => p.1 < p.2 ∧ ∀ u ∈ U, ¬ (p.1 < u ∧ u < p.2))
    (fun _ => Classical.propDecidable _) (U.product U)

theorem mem_cutPairs {U : Finset ℝ} {p : ℝ × ℝ} :
    p ∈ cutPairs U ↔ p.1 ∈ U ∧ p.2 ∈ U ∧ p.1 < p.2 ∧ ∀ u ∈ U, ¬ (p.1 < u ∧ u < p.2) := by
  unfold cutPairs
  rw [@Finset.mem_filter (ℝ × ℝ)
      (fun p : ℝ × ℝ => p.1 < p.2 ∧ ∀ u ∈ U, ¬ (p.1 < u ∧ u < p.2))
      (fun _ => Classical.propDecidable _) (U.product U)]
  change p ∈ U ×ˢ U ∧ (p.1 < p.2 ∧ ∀ u ∈ U, ¬ (p.1 < u ∧ u < p.2)) ↔ _
  rw [Finset.mem_product]
  tauto

/-- The cells cut out by a finite set `U ⊆ ℝ` of cut points: the points of `U` and the open
intervals between *consecutive* points of `U`. -/
def cuts (U : Finset ℝ) : Finset (Set (Fin 1 → ℝ)) :=
  U.image cellPt ∪ (cutPairs U).image (fun p => cellIoo p.1 p.2)

theorem mem_cuts {U : Finset ℝ} {κ : Set (Fin 1 → ℝ)} :
    κ ∈ cuts U ↔ (∃ t ∈ U, κ = cellPt t) ∨
      (∃ a ∈ U, ∃ b ∈ U, a < b ∧ (∀ u ∈ U, ¬ (a < u ∧ u < b)) ∧ κ = cellIoo a b) := by
  unfold cuts
  rw [Finset.mem_union, Finset.mem_image, Finset.mem_image]
  constructor
  · rintro (⟨t, ht, h⟩ | ⟨p, hp, h⟩)
    · exact Or.inl ⟨t, ht, h.symm⟩
    · obtain ⟨ha, hb, hab, hnb⟩ := mem_cutPairs.mp hp
      exact Or.inr ⟨p.1, ha, p.2, hb, hab, hnb, h.symm⟩
  · rintro (⟨t, ht, h⟩ | ⟨a, ha, b, hb, hab, hnb, h⟩)
    · exact Or.inl ⟨t, ht, h.symm⟩
    · exact Or.inr ⟨(a, b), mem_cutPairs.mpr ⟨ha, hb, hab, hnb⟩, h.symm⟩

/-- The number of cells generated by `U` is at most `(|U| + 1)²`. -/
theorem cuts_card (U : Finset ℝ) : (cuts U).card ≤ (U.card + 1) ^ 2 := by
  unfold cuts
  have h1 : (U.image cellPt).card ≤ U.card := Finset.card_image_le
  have h3 : (cutPairs U).card ≤ (U.product U).card :=
    @Finset.card_filter_le (ℝ × ℝ) (U.product U)
      (fun p : ℝ × ℝ => p.1 < p.2 ∧ ∀ u ∈ U, ¬ (p.1 < u ∧ u < p.2))
      (fun _ => Classical.propDecidable _)
  rw [show U.product U = U ×ˢ U from rfl, Finset.card_product] at h3
  have h2 : ((cutPairs U).image (fun p => cellIoo p.1 p.2)).card ≤ U.card * U.card :=
    le_trans Finset.card_image_le h3
  calc (U.image cellPt ∪ _).card ≤ (U.image cellPt).card + _ := Finset.card_union_le _ _
    _ ≤ U.card + U.card * U.card := Nat.add_le_add h1 h2
    _ ≤ (U.card + 1) ^ 2 := by nlinarith [Nat.zero_le U.card]

/-- Every cell generated by `U` is contained in the closed cube, when `U ⊆ [-1,1]`. -/
theorem cuts_subset_cube {U : Finset ℝ} (hU : ∀ t ∈ U, |t| ≤ 1) :
    ∀ κ ∈ cuts U, κ ⊆ cubeC 1 := by
  intro κ hκ x hx
  rcases mem_cuts.mp hκ with ⟨t, ht, rfl⟩ | ⟨a, ha, b, hb, hab, -, rfl⟩
  · rw [mem_cellPt, pt1_eq_iff] at hx
    intro i
    rw [Fin.eq_zero i, hx]
    exact hU t ht
  · rw [mem_cellIoo] at hx
    intro i
    rw [Fin.eq_zero i]
    have ha' : -1 ≤ a := (abs_le.mp (hU a ha)).1
    have hb' : b ≤ 1 := (abs_le.mp (hU b hb)).2
    exact abs_le.mpr ⟨by linarith [hx.1, ha'], by linarith [hx.2, hb']⟩

/-! ## The two cell shapes as restricted semi-Pfaffian sets

`Star 1 4 1 κ` is witnessed by a single `StarPiece` with empty chain (`r = 0`), whose
semi-Pfaffian part is the cell itself; the format is `1` and the degree at most `4`. -/

/-- The restricted semi-Pfaffian set `{x ∈ cubeC 1 | x 0 = t}` (empty when `|t| > 1`). -/
def ptSemiPf (t : ℝ) : SemiPf 1 :=
  ⟨0, EAChain.nil 1,
    [⟨[MvPolynomial.X (Sum.inl (0 : Fin 1)) - MvPolynomial.C t], []⟩]⟩

/-- The restricted semi-Pfaffian set `{x ∈ cubeC 1 | a < x 0 < b}` (empty unless
`-1 ≤ a < b ≤ 1`). -/
def ivlSemiPf (a b : ℝ) : SemiPf 1 :=
  ⟨0, EAChain.nil 1,
    [⟨[], [MvPolynomial.X (Sum.inl (0 : Fin 1)) - MvPolynomial.C a,
           MvPolynomial.C b - MvPolynomial.X (Sum.inl (0 : Fin 1))]⟩]⟩

/-- The `*`-piece whose point set is the singleton `{t}` (empty when `|t| > 1`). -/
def pointPiece (t : ℝ) : StarPiece 1 := ⟨0, ptSemiPf t, pt1 t⟩

/-- The `*`-piece whose point set is the open interval `(a,b)` (empty unless
`-1 ≤ a < b ≤ 1`). -/
def ivlPiece (a b : ℝ) : StarPiece 1 := ⟨0, ivlSemiPf a b, pt1 ((a + b) / 2)⟩

/-! ## Continuity of the coordinate projection -/

theorem continuous_projFirst (n m : ℕ) : Continuous (projFirst n m) :=
  continuous_pi fun i => continuous_apply (Fin.castAdd m i)

end Work.WilE7
