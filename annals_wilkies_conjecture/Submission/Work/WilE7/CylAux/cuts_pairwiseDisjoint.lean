import Mathlib
import Submission.Work.WilE7.DimOneCells
import Submission.Work.WilE7.CylAux.cellIoo_eq_of_inter_nonempty

namespace Work.WilE7.CylAux

open Classical

/-! ## Auxiliary facts about the cell shapes of `Work.WilE7.cuts`

The cells generated by a finite set `U ⊆ ℝ` of cut points are the points of `U` and the
open intervals between *consecutive* points of `U` (`Work.WilE7.cuts`).  The ingredients of
the pairwise disjointness of that family are the equality of two meeting intervals cut out
by consecutive points (`cellIoo_eq_of_inter_nonempty`, proved in the sibling file of the
same name) together with the two elementary facts below. -/

/-- A point `t ∈ U` never lies in an open interval cut out by consecutive points of `U`. -/
theorem pt1_notMem_cellIoo {U : Finset ℝ} {a b t : ℝ}
    (ht : t ∈ U) (hnb : ∀ u ∈ U, ¬ (a < u ∧ u < b)) : pt1 t ∉ cellIoo a b :=
  fun hx => hnb t ht (mem_cellIoo.mp hx)

/-- Two cells of the family `Work.WilE7.cuts U` that meet are equal: a point lying in both
of them forces the two cells to coincide.

Indeed, a cell is either a point `{t}` with `t ∈ U` or an interval `(a,b)` bounded by
consecutive points of `U`; a point of `U` lies in no such interval, and two meeting
intervals of consecutive points coincide (`cellIoo_eq_of_inter_nonempty`). -/
theorem eq_of_mem_cuts_of_mem {U : Finset ℝ} {κ κ' : Set (Fin 1 → ℝ)}
    (hκ : κ ∈ cuts U) (hκ' : κ' ∈ cuts U) {x : Fin 1 → ℝ} (hx : x ∈ κ) (hx' : x ∈ κ') :
    κ = κ' := by
  rcases mem_cuts.mp hκ with ⟨t, ht, rfl⟩ | ⟨a, ha, b, hb, _hab, hnb, rfl⟩
  · -- `κ = cellPt t`
    rw [mem_cellPt] at hx
    rcases mem_cuts.mp hκ' with ⟨s, _hs, rfl⟩ | ⟨c, hc, d, hd, _hcd, hnd, rfl⟩
    · rw [mem_cellPt] at hx'
      have hts : t = s := congrFun (hx.symm.trans hx') 0
      rw [hts]
    · exfalso
      exact pt1_notMem_cellIoo (U := U) ht hnd (hx ▸ hx')
  · -- `κ = cellIoo a b`
    rw [mem_cellIoo] at hx
    rcases mem_cuts.mp hκ' with ⟨s, hs, rfl⟩ | ⟨c, hc, d, hd, _hcd, hnd, rfl⟩
    · exfalso
      rw [mem_cellPt] at hx'
      exact (hnb s hs) (mem_cellIoo.mp (hx' ▸ hx))
    · rw [mem_cellIoo] at hx'
      have h := cellIoo_eq_of_inter_nonempty ha hb hnb hc hd hnd ⟨x, hx, hx'⟩
      have hac : a = c := (Prod.ext_iff.mp h).1
      have hbd : b = d := (Prod.ext_iff.mp h).2
      rw [hac, hbd]

theorem cuts_pairwiseDisjoint (U : Finset ℝ) :
    (↑(Work.WilE7.cuts U) : Set (Set (Fin 1 → ℝ))).PairwiseDisjoint id := by
  intro κ hκ κ' hκ' hne
  show Disjoint κ κ'
  rw [Set.disjoint_left]
  intro x hx hx'
  exact hne (eq_of_mem_cuts_of_mem hκ hκ' hx hx')

end Work.WilE7.CylAux
