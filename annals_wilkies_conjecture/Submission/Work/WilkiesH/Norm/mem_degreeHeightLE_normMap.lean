import Mathlib
import Submission.Work.WilkiesH.Norm.Defs

/-!
# Normalisation preserves the degree and the height

`normMap σ` acts coordinatewise on a point `x ∈ normPiece σ` by the identity, by negation, or by
inversion (up to a sign).  Each of these operations leaves the absolute multiplicative height of a
real number unchanged (`absMulHeight_neg`, `absMulHeight_inv`) and preserves integrality over `ℚ`
(`IsIntegral.neg`, `IsIntegral.inv`).  Moreover each transformed coordinate still lies in the
subfield `ℚ(x₁,…,xₙ)`, so the field generated by the normalised point is a subfield of the field
generated by the original point and its degree over `ℚ` can only decrease.

Consequently, if `x ∈ degreeHeightLE X g H` then `normMap σ x ∈ degreeHeightLE (normSet σ X) g H`.
This is the statement needed by the counting induction: it allows one to replace `X` by its
normalised image `normSet σ X ⊆ cube01 n` without losing any of the `(g, H)`-points.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

noncomputable section
open Classical

namespace Work.WilkiesH.Norm

open WilkiesDesign WilkiesConjecture

/-- The coordinate map of a shape preserves integrality over `ℚ`. -/
private lemma shapeMap_isIntegral (s : NormShape) (t : ℝ) (h : IsIntegral ℚ t) :
    IsIntegral ℚ (shapeMap s t) := by
  rcases s with _ | _ | _ | _ <;> simp only [shapeMap]
  · exact h
  · exact h.neg
  · exact h.inv
  · exact h.inv.neg

/-- The coordinate map of a shape preserves the absolute multiplicative height. -/
private lemma shapeMap_absMulHeight (s : NormShape) (t : ℝ) :
    NumberField.absMulHeight₁ (shapeMap s t) = NumberField.absMulHeight₁ t := by
  rcases s with _ | _ | _ | _ <;> simp only [shapeMap]
  · rfl
  · exact absMulHeight_neg t
  · exact absMulHeight_inv t
  · rw [absMulHeight_neg, absMulHeight_inv]

/-- The coordinate map of a shape stays inside any subfield of `ℝ` containing its argument:
each shape acts by `t ↦ t`, `t ↦ -t`, `t ↦ t⁻¹` or `t ↦ -t⁻¹`, and a subfield is closed
under negation and inversion. -/
private lemma shapeMap_mem_adjoin (s : NormShape) {t : ℝ} {A : IntermediateField ℚ ℝ}
    (ht : t ∈ A) : shapeMap s t ∈ A := by
  rcases s with _ | _ | _ | _ <;> simp only [shapeMap]
  · exact ht
  · exact neg_mem ht
  · exact inv_mem ht
  · exact neg_mem (inv_mem ht)

/-- Normalisation preserves the degree and the height bound: if `x` lies in the piece `normPiece σ`
and in `degreeHeightLE X g H`, then its normalised image lies in
`degreeHeightLE (normSet σ X) g H`. -/
theorem mem_degreeHeightLE_normMap {n : ℕ} {σ : Fin n → NormShape} {X : Set (Fin n → ℝ)} {g H : ℕ} {x : Fin n → ℝ} (hx : x ∈ normPiece σ) (h : x ∈ WilkiesConjecture.degreeHeightLE X g H) : normMap σ x ∈ WilkiesConjecture.degreeHeightLE (normSet σ X) g H := by
  rw [WilkiesConjecture.degreeHeightLE] at h ⊢
  obtain ⟨hxX, hint, hfr, hhe⟩ := h
  refine ⟨⟨x, ⟨hxX, hx⟩, rfl⟩, ?_, ?_, ?_⟩
  · intro i
    exact shapeMap_isIntegral (σ i) (x i) (hint i)
  · -- the field generated by `normMap σ x` is a subfield of the one generated by `x`
    haveI : Finite ↑(Set.range x) := (Set.finite_range x).to_subtype
    haveI : FiniteDimensional ℚ ↥(IntermediateField.adjoin ℚ (Set.range x)) :=
      IntermediateField.finiteDimensional_adjoin (S := Set.range x) fun y hy => by
        rcases hy with ⟨i, rfl⟩
        exact hint i
    refine (IntermediateField.finrank_le_of_le_right ?_).trans hfr
    rw [IntermediateField.adjoin_le_iff]
    rintro y ⟨i, rfl⟩
    exact shapeMap_mem_adjoin (σ i)
      (IntermediateField.subset_adjoin ℚ (Set.range x) (Set.mem_range_self i))
  · -- the height is the supremum of the coordinate heights, which are unchanged
    have hf : (fun i => NumberField.absMulHeight₁ ((normMap σ x) i))
        = fun i => NumberField.absMulHeight₁ (x i) :=
      funext fun i => shapeMap_absMulHeight (σ i) (x i)
    simp only [WilkiesConjecture.height, hf]
    exact hhe

end Work.WilkiesH.Norm
