import Mathlib
import Submission.Work.WilkiesH.Defs
import Submission.Work.WilkiesH.Norm.prod_infinitePlace_eq_prod_embeddings
import Submission.Work.WilkiesH.Norm.absNorm_map_ringEquiv

/-!
# Invariance of the absolute height under negation

For a real number `x` we prove `NumberField.absMulHeight₁ (-x) = NumberField.absMulHeight₁ x`.

`NumberField.absMulHeight₁ x` is `(Height.mulHeight₁ (AdjoinSimple.gen ℚ x)) ^ (finrank ℚ ℚ⟮x⟯ : ℝ)⁻¹`
for algebraic `x` (and `1` otherwise), the height being taken inside the number field `ℚ⟮x⟯`.
The two fields `ℚ⟮-x⟯` and `ℚ⟮x⟯` are *the same subfield of `ℝ`*, and under this identification the
elements `AdjoinSimple.gen ℚ (-x)` and `-AdjoinSimple.gen ℚ x` correspond.  So it suffices to know
that `Height.mulHeight₁` of an element of a number field is invariant under ring isomorphisms of
number fields, i.e. that the *absolute* height does not depend on the field in which the element is
considered (`mulHeight₁_ringEquiv`), and to apply it to `Height.mulHeight₁_neg`.

To prove `mulHeight₁_ringEquiv` we write `Height.mulHeight₁ y = Height.mulHeight ![y, 1]`,
rescale the tuple to make its entries algebraic integers (`IsFractionRing.div_surjective`), and
evaluate the height of a tuple of algebraic integers by

* `Work.WilkiesH.Norm.mulHeight_int_tuple_eq`: for `a : ι → 𝓞 K` with `a ≠ 0`,
  `Height.mulHeight (fun i => (a i : K)) = (∏ φ : K →+* ℂ, ⨆ i, ‖φ (a i)‖) / (span (range a)).absNorm`,
  an expression built from the complex embeddings and the norm of an ideal, both of which are
  manifestly transported by a ring isomorphism (embeddings by precomposition,
  `Work.WilkiesH.Norm.absNorm_map_ringEquiv` for the ideal).
-/

set_option linter.style.haveILetI false

open Classical IntermediateField NumberField

namespace Work.WilkiesH.Norm

/-- The multiplicative height of a nonzero tuple of algebraic integers, as the quotient of the
product over the complex embeddings by the absolute norm of the ideal generated by the tuple. -/
private theorem mulHeight_int_tuple_eq {K : Type*} [Field K] [NumberField K]
    {ι : Type*} [Fintype ι] (x : ι → NumberField.RingOfIntegers K) (hx : x ≠ 0) :
    Height.mulHeight (fun i => ((x i : NumberField.RingOfIntegers K) : K)) =
      (∏ φ : K →+* ℂ, ⨆ i, ‖φ ((x i : NumberField.RingOfIntegers K) : K)‖)
        / (Ideal.span (Set.range x)).absNorm := by
  classical
  have hxK : (fun i => ((x i : NumberField.RingOfIntegers K) : K)) ≠ 0 := by
    intro h
    refine hx (funext fun i => ?_)
    exact IsFractionRing.injective (NumberField.RingOfIntegers K) K (by simpa using congrFun h i)
  have hbot : Ideal.span (Set.range x) ≠ ⊥ := by
    intro h
    refine hx (funext fun i => ?_)
    have hmem : x i ∈ Ideal.span (Set.range x) := Ideal.subset_span (Set.mem_range_self i)
    rw [h] at hmem
    simpa using hmem
  have hN : (↑(Ideal.span (Set.range x)).absNorm : ℝ) ≠ 0 := by
    exact_mod_cast (Ideal.absNorm_eq_zero_iff.not.mpr hbot)
  rw [NumberField.mulHeight_eq hxK, prod_infinitePlace_eq_prod_embeddings]
  have hF : (∏ᶠ v : NumberField.FinitePlace K,
        ⨆ i, v ((x i : NumberField.RingOfIntegers K) : K))
      = 1 / (↑(Ideal.span (Set.range x)).absNorm : ℝ) := by
    rw [eq_div_iff hN, mul_comm]
    exact NumberField.absNorm_mul_finprod_finitePlace_eq_one hx
  rw [hF, one_div, div_eq_mul_inv]

/-- The multiplicative height of an element of a number field depends only on the element and not
on the ambient number field: it is invariant under any ring isomorphism. -/
theorem mulHeight₁_ringEquiv {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L]
    (σ : K ≃+* L) (y : K) : Height.mulHeight₁ (σ y) = Height.mulHeight₁ y := by
  classical
  obtain ⟨a, b, hb_mem, hdiv⟩ := IsFractionRing.div_surjective (NumberField.RingOfIntegers K) y
  have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
  have hbK : (b : K) ≠ 0 := fun h =>
    hb_ne (IsFractionRing.injective (NumberField.RingOfIntegers K) K (by simpa using h))
  have hya : (a : K) = y * (b : K) := by
    rw [← hdiv, div_mul_cancel₀ _ hbK]
  have hab : (![a, b] : Fin 2 → NumberField.RingOfIntegers K) ≠ 0 := by
    intro h
    exact hb_ne (by simpa using congrFun h 1)
  have hσab : (fun i : Fin 2 => (NumberField.RingOfIntegers.mapRingEquiv σ) (![a, b] i)) ≠ 0 := by
    intro h
    have h1 : (NumberField.RingOfIntegers.mapRingEquiv σ) b = 0 := by simpa using congrFun h 1
    exact hb_ne ((NumberField.RingOfIntegers.mapRingEquiv σ).injective (by simpa using h1))
  -- `mulHeight₁ y` and `mulHeight₁ (σ y)` are heights of the tuples `![a, b]`, `![σ a, σ b]`
  have hK : Height.mulHeight₁ y =
      Height.mulHeight (fun i : Fin 2 => ((![a, b] i : NumberField.RingOfIntegers K) : K)) := by
    rw [Height.mulHeight₁_eq_mulHeight]
    have hscal : (fun i : Fin 2 => ((![a, b] i : NumberField.RingOfIntegers K) : K))
        = ((b : K) • ![y, 1]) := by
      funext i
      fin_cases i
      · show (a : K) = (b : K) * y
        rw [hya, mul_comm]
      · show (b : K) = (b : K) * 1
        rw [mul_one]
    rw [hscal, Height.mulHeight_smul_eq_mulHeight _ hbK]
  have hL : Height.mulHeight₁ (σ y) = Height.mulHeight
      (fun i : Fin 2 => (((NumberField.RingOfIntegers.mapRingEquiv σ) (![a, b] i)
        : NumberField.RingOfIntegers L) : L)) := by
    rw [Height.mulHeight₁_eq_mulHeight]
    have hσb : (σ b : L) ≠ 0 := fun h => hbK (σ.injective (by simpa using h))
    have hσya : (σ a : L) = σ y * (σ b : L) := by
      rw [hya, map_mul]
    have hscal : (fun i : Fin 2 => (((NumberField.RingOfIntegers.mapRingEquiv σ) (![a, b] i)
        : NumberField.RingOfIntegers L) : L)) = ((σ b : L) • ![σ y, 1]) := by
      funext i
      fin_cases i
      · show (σ a : L) = (σ b : L) * σ y
        rw [hσya, mul_comm]
      · show (σ b : L) = (σ b : L) * 1
        rw [mul_one]
    rw [hscal, Height.mulHeight_smul_eq_mulHeight _ hσb]
  rw [hK, hL, mulHeight_int_tuple_eq _ hab, mulHeight_int_tuple_eq _ hσab]
  congr 1
  · -- the products over the complex embeddings correspond under `φ ↦ φ ∘ σ`
    let embEquiv : (K →+* ℂ) ≃ (L →+* ℂ) :=
      { toFun := fun φ => φ.comp (σ.symm : L →+* K)
        invFun := fun ψ => ψ.comp (σ : K →+* L)
        left_inv := fun φ => by ext x; simp
        right_inv := fun ψ => by ext x; simp }
    refine Fintype.prod_equiv (M := ℝ) embEquiv.symm _ _ ?_
    intro φ
    congr 1
  · -- the two ideals are related by `Ideal.map (RingOfIntegers.mapRingEquiv σ)`
    rw [show (Set.range (fun i : Fin 2 =>
        (NumberField.RingOfIntegers.mapRingEquiv σ) (![a, b] i)))
        = (NumberField.RingOfIntegers.mapRingEquiv σ : 𝓞 K →+* 𝓞 L) '' (Set.range ![a, b]) from
        Set.range_comp _ _,
      ← Ideal.map_span (NumberField.RingOfIntegers.mapRingEquiv σ : 𝓞 K →+* 𝓞 L)
        (Set.range ![a, b]),
      absNorm_map_ringEquiv (NumberField.RingOfIntegers.mapRingEquiv σ)]

/-- The absolute multiplicative height of a real number is invariant under negation. -/
theorem absMulHeight_neg (x : ℝ) : NumberField.absMulHeight₁ (-x) = NumberField.absMulHeight₁ x := by
  by_cases hx : IsIntegral ℚ x
  · have hnx : IsIntegral ℚ (-x) := hx.neg
    haveI : FiniteDimensional ℚ ↥(ℚ⟮x⟯ : IntermediateField ℚ ℝ) :=
      IntermediateField.adjoin.finiteDimensional hx
    haveI : NumberField ↥(ℚ⟮x⟯ : IntermediateField ℚ ℝ) := {}
    haveI : FiniteDimensional ℚ ↥(ℚ⟮-x⟯ : IntermediateField ℚ ℝ) :=
      IntermediateField.adjoin.finiteDimensional hnx
    haveI : NumberField ↥(ℚ⟮-x⟯ : IntermediateField ℚ ℝ) := {}
    have hfield : (ℚ⟮-x⟯ : IntermediateField ℚ ℝ) = ℚ⟮x⟯ := by
      apply le_antisymm
      · rw [adjoin_simple_le_iff]
        exact neg_mem (mem_adjoin_simple_self ℚ x)
      · rw [adjoin_simple_le_iff]
        simpa using neg_mem (mem_adjoin_simple_self ℚ (-x))
    have hfr : Module.finrank ℚ ↥(ℚ⟮-x⟯ : IntermediateField ℚ ℝ) =
        Module.finrank ℚ ↥(ℚ⟮x⟯ : IntermediateField ℚ ℝ) :=
      LinearEquiv.finrank_eq (IntermediateField.equivOfEq hfield).toLinearEquiv
    have hσ : (IntermediateField.equivOfEq hfield) (AdjoinSimple.gen ℚ (-x)) =
        - AdjoinSimple.gen ℚ x := by
      apply Subtype.ext
      rw [IntermediateField.equivOfEq, Subalgebra.equivOfEq_apply]
      simp
    have hgen : Height.mulHeight₁ (AdjoinSimple.gen ℚ (-x)) =
        Height.mulHeight₁ (AdjoinSimple.gen ℚ x) := by
      have h1 := mulHeight₁_ringEquiv (IntermediateField.equivOfEq hfield).toRingEquiv
        (AdjoinSimple.gen ℚ (-x))
      rw [show (IntermediateField.equivOfEq hfield).toRingEquiv (AdjoinSimple.gen ℚ (-x)) =
          (IntermediateField.equivOfEq hfield) (AdjoinSimple.gen ℚ (-x)) from rfl,
        hσ, Height.mulHeight₁_neg] at h1
      exact h1.symm
    rw [NumberField.absMulHeight₁, dite_eq_left hnx, NumberField.absMulHeight₁, dite_eq_left hx]
    rw [congrArg (fun n : ℕ => ((n : ℝ))⁻¹) hfr, hgen]
  · have hnx : ¬ IsIntegral ℚ (-x) := fun h => hx (by simpa using h.neg)
    rw [NumberField.absMulHeight₁, dite_eq_right hnx, NumberField.absMulHeight₁, dite_eq_right hx]

end Work.WilkiesH.Norm
