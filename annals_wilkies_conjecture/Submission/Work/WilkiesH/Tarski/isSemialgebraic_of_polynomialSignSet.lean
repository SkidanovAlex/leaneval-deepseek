import Mathlib
import Submission.Work.WilkiesI.Basic
import Submission.Work.WilLibTS.All

/-!
# The easy direction of the Tarski–Seidenberg bridge

`Work.WilLibTS.TS.PolynomialSignSet` (the sign-description predicate from the ported
Tarski–Seidenberg library) is generated by the zero sets and the strict positivity sets of
polynomials, together with complement and union.  Each of those four operations is one of the
Boolean operations on `Set.Definable`-sets, and each of the two generators is definable in the
language of rings over `ℝ` (Mathlib's `mvPolynomial_zeroLocus_definable`, together with the
fact that over `ℝ` the order is ring-definable: `0 < a ↔ ∃ b, a * b * b = 1`).  The toolbox
for exactly this is area I's `Submission/Work/WilkiesI/Basic.lean`, so the implication
`PolynomialSignSet ⟹ IsSemialgebraic` is a four-line induction.

(The converse direction is the actual Tarski–Seidenberg content; it is not needed here.)
-/

namespace Work.WilkiesH.Tarski

open Work.WilkiesI

/-- **The sign-description predicate implies semialgebraicity.**
Every `PolynomialSignSet` (a finite Boolean combination of polynomial zero sets and strict
polynomial positivity sets) is definable in the language of rings over `ℝ` with `ℝ` as
parameters. -/
theorem isSemialgebraic_of_polynomialSignSet {n : ℕ} {S : Set (Fin n → ℝ)}
    (h : Work.WilLibTS.TS.PolynomialSignSet (fun x : Fin n → ℝ => x) S) :
    WilkiesConjecture.IsSemialgebraic S := by
  induction h with
  | zero p => exact isSemialgebraic_eval_eq p 0
  | positive p => exact isSemialgebraic_eval_pos p
  | compl _hS ih => exact isSemialgebraic_compl ih
  | union _hS _hT ihS ihT => exact isSemialgebraic_union ihS ihT

end Work.WilkiesH.Tarski
