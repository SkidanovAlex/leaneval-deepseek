import Mathlib
import Submission.Work.WilkiesH.Norm.absMulHeight_inv

/-!
# The absolute height of `φ x` is the height of `x` in `ℚ⟮x⟯`, normalised by the degree

Let `K` be a number field, `φ : K →ₐ[ℚ] ℝ` a (`ℚ`-algebra) embedding, `F = ℚ⟮x⟯ ⊆ K` the
subfield generated by an element `x ∈ K`.  The absolute multiplicative height of the real
number `φ x` is by definition

`absMulHeight₁ (φ x) = mulHeight₁ (gen ℚ (φ x)) ^ (finrank ℚ ℚ⟮φ x⟯ : ℝ)⁻¹`,

the height of the generator of `ℚ⟮φ x⟯`, normalised by the `ℚ`-degree of that field.  Since
`φ` restricts to an isomorphism `F ≃ₐ[ℚ] ℚ⟮φ x⟯` sending `x` to `φ x`, and both `mulHeight₁`
and the `ℚ`-finrank are invariant under `ℚ`-algebra isomorphisms of number fields, the same
number is computed inside `F`:

`absMulHeight₁ (φ x) = (mulHeight₁ (K := ↥F) ⟨x, hx⟩) ^ (finrank ℚ ↥F : ℝ)⁻¹`.

This is the "relative form" of the absolute height: the absolute height of an algebraic
number `α` is `H_K(α) ^ (1 / [K : ℚ])` for any number field `K` containing `α`, and here
`K = ℚ⟮α⟯` is the smallest possible one.

The two ingredients are `IntermediateField.equivMap` (an intermediate field is isomorphic
to its image, here `φ '' F = ℚ⟮φ x⟯` by `IntermediateField.adjoin_map`) and
`Work.WilkiesH.Norm.mulHeight₁_algEquiv`.
-/

open scoped IntermediateField

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.WilkiesH.NT

theorem absMulHeight_eq_pow_inv {K : Type*} [Field K] [NumberField K]
    (φ : K →ₐ[ℚ] ℝ) (hφ : Function.Injective φ) {F : IntermediateField ℚ K} [NumberField ↥F]
    {x : K} (hx : x ∈ F) (hgen : F = IntermediateField.adjoin ℚ ({x} : Set K)) :
    NumberField.absMulHeight₁ (φ x)
      = (Height.mulHeight₁ (K := ↥F) ⟨x, hx⟩) ^ ((Module.finrank ℚ ↥F : ℝ)⁻¹) := by
  -- `φ x` is algebraic, so `absMulHeight₁` is computed by its genuine formula.
  have halg : IsAlgebraic ℚ x := Algebra.IsAlgebraic.isAlgebraic x
  have hφx : IsIntegral ℚ (φ x) := IsIntegral.map φ (isAlgebraic_iff_isIntegral.mp halg)
  haveI : FiniteDimensional ℚ ↥ℚ⟮φ x⟯ := IntermediateField.adjoin.finiteDimensional hφx
  haveI : NumberField ↥ℚ⟮φ x⟯ := {}
  -- `φ` maps `F = ℚ⟮x⟯` onto `ℚ⟮φ x⟯`.
  have hmap : IntermediateField.map φ F = ℚ⟮φ x⟯ := by
    rw [hgen, IntermediateField.adjoin_map]
    congr 1
    ext y
    simp
  -- Hence `φ` restricts to an isomorphism `F ≃ₐ[ℚ] ℚ⟮φ x⟯` sending `x` to the generator.
  let e : ↥F ≃ₐ[ℚ] ↥ℚ⟮φ x⟯ := (F.equivMap φ).trans (IntermediateField.equivOfEq hmap)
  have hex : e ⟨x, hx⟩ = IntermediateField.AdjoinSimple.gen ℚ (φ x) := by
    ext
    simp [e, IntermediateField.coe_equivMap_apply]
  -- `mulHeight₁` is invariant under `ℚ`-algebra isomorphisms of number fields.
  have hmul : Height.mulHeight₁ (K := ↥ℚ⟮φ x⟯) (IntermediateField.AdjoinSimple.gen ℚ (φ x))
      = Height.mulHeight₁ (K := ↥F) ⟨x, hx⟩ := by
    rw [← hex, Work.WilkiesH.Norm.mulHeight₁_algEquiv e ⟨x, hx⟩]
  -- ... and so is the `ℚ`-finrank.
  have hfin : Module.finrank ℚ ↥ℚ⟮φ x⟯ = Module.finrank ℚ ↥F :=
    (LinearEquiv.finrank_eq e.toLinearEquiv).symm
  rw [NumberField.absMulHeight₁, dite_eq_left hφx, hmul, hfin]

end Work.WilkiesH.NT
