import Mathlib
import Submission.Work.WilkiesH.Defs
import Submission.Work.WilkiesH.Height.one_le_absMulHeight
import Submission.Work.WilkiesH.NT.inv_absMulHeight_pow_le_abs
import Submission.Work.WilkiesH.NT.eval_absMulHeight_le

/-!
# Liouville lower bounds for the value of an integral polynomial

Combining

* the height upper bound for the evaluation of an integral polynomial
  (`Work.WilkiesH.NT.eval_absMulHeight_le`), and
* Liouville's inequality in the single number form
  (`Work.WilkiesH.NT.inv_absMulHeight_pow_le_abs`),

we deduce an explicit lower bound for `|P(x)|` for an integral polynomial `P`
with coefficients bounded by `N`, evaluated at a tuple `x` of integral real
numbers whose (absolute multiplicative) height is bounded by `H` and whose
degree over `ℚ` is bounded by `g`.

The chain is: `absMulHeight₁ (P x) ≤ M·N·H^e` with `M = monoCount n d`,
`e = (n+1)·d·[ℚ(x):ℚ]`, while Liouville gives
`1 / (absMulHeight₁ (P x))^{[ℚ(P x):ℚ]} ≤ |P x|`; since `[ℚ(P x):ℚ] ≤ [ℚ(x):ℚ] ≤ g`
and `absMulHeight₁ (P x) ≥ 1`, the exponent may be increased to `g` and the base
to `M·N·H^{(n+1)·d·g}`.
-/

set_option linter.style.haveILetI false

namespace Work.WilkiesH.NT

open Classical IntermediateField NumberField

/-- The evaluation of an integral polynomial at a tuple of integral real numbers is
integral over `ℚ`. -/
private lemma isIntegral_eval_map_intCast {n : ℕ} (P : MvPolynomial (Fin n) ℤ) {x : Fin n → ℝ}
    (hint : ∀ i, IsIntegral ℚ (x i)) :
    IsIntegral ℚ (MvPolynomial.eval x (P.map (Int.castRingHom ℝ))) := by
  have hrepr : MvPolynomial.eval x (P.map (Int.castRingHom ℝ))
      = ∑ m ∈ P.support, ((P.coeff m : ℤ) : ℝ) * ∏ i : Fin n, x i ^ (m i) := by
    rw [MvPolynomial.eval_map, MvPolynomial.eval₂_eq']
    simp
  rw [hrepr]
  refine IsIntegral.sum _ (fun m _ => IsIntegral.mul (isIntegral_intCast (R := ℚ) _) ?_)
  exact IsIntegral.prod _ (fun i _ => IsIntegral.pow (hint i) _)

/-- The value at `x` of an integral polynomial lies in the intermediate field
generated by the coordinates of `x`. -/
private lemma eval_map_intCast_mem_adjoin {n : ℕ} (P : MvPolynomial (Fin n) ℤ) (x : Fin n → ℝ) :
    MvPolynomial.eval x (P.map (Int.castRingHom ℝ)) ∈
      (IntermediateField.adjoin ℚ (Set.range x) : Set ℝ) := by
  have haev : MvPolynomial.eval x (P.map (Int.castRingHom ℝ))
      = MvPolynomial.aeval x (P.map (Int.castRingHom ℚ)) := by
    rw [MvPolynomial.eval_map, MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
    congr 1
  rw [haev]
  have h1 : MvPolynomial.aeval x (P.map (Int.castRingHom ℚ)) ∈ Algebra.adjoin ℚ (Set.range x) := by
    rw [← MvPolynomial.aeval_range x]
    exact AlgHom.mem_range_self _ _
  exact Algebra.adjoin_le (IntermediateField.subset_adjoin ℚ (Set.range x)) h1

theorem abs_eval_ge_of_ne_zero {n d N g H : ℕ} (hn : 1 ≤ n) (hN : 1 ≤ N) (hH1 : 1 ≤ H) (P : MvPolynomial (Fin n) ℤ) (hdeg : P.totalDegree ≤ d) (hcoef : ∀ m ∈ P.support, |(P.coeff m : ℤ)| ≤ (N : ℤ)) {x : Fin n → ℝ} (hint : ∀ i, IsIntegral ℚ (x i)) (hfin : Module.finrank ℚ (IntermediateField.adjoin ℚ (Set.range x)) ≤ g) (hH : WilkiesConjecture.height x ≤ (H : ℝ)) (hne : MvPolynomial.eval x (P.map (Int.castRingHom ℝ)) ≠ 0) : (1 : ℝ) / ((Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ) * (H : ℝ) ^ ((n + 1) * d * g)) ^ g ≤ |MvPolynomial.eval x (P.map (Int.castRingHom ℝ))| := by
  set y : ℝ := MvPolynomial.eval x (P.map (Int.castRingHom ℝ)) with hy_def
  have hy_ne : y ≠ 0 := hne
  have hy_int : IsIntegral ℚ y := isIntegral_eval_map_intCast P hint
  have hy_mem : y ∈ (IntermediateField.adjoin ℚ (Set.range x) : Set ℝ) :=
    eval_map_intCast_mem_adjoin P x
  haveI hfinK : FiniteDimensional ℚ ↥(IntermediateField.adjoin ℚ (Set.range x)) :=
    IntermediateField.finiteDimensional_adjoin (fun z hz => by
      obtain ⟨i, rfl⟩ := hz
      exact hint i)
  have hdegy : Module.finrank ℚ ↥(IntermediateField.adjoin ℚ ({y} : Set ℝ)) ≤ g := by
    have hmono : Module.finrank ℚ ↥(IntermediateField.adjoin ℚ ({y} : Set ℝ))
        ≤ Module.finrank ℚ ↥(IntermediateField.adjoin ℚ (Set.range x)) := by
      have hle : IntermediateField.adjoin ℚ ({y} : Set ℝ) ≤ IntermediateField.adjoin ℚ (Set.range x) :=
        IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hy_mem)
      rw [← IntermediateField.finrank_eq_finrank_subalgebra,
        ← IntermediateField.finrank_eq_finrank_subalgebra]
      exact Submodule.finrank_mono (Subalgebra.toSubmodule.le_iff_le.mpr hle)
    exact le_trans hmono hfin
  have hheight1 : (1 : ℝ) ≤ WilkiesConjecture.height x := by
    haveI : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
    have hbdd : BddAbove (Set.range fun i => NumberField.absMulHeight₁ (x i)) :=
      Finite.bddAbove_range _
    exact le_trans (Work.WilkiesH.Height.one_le_absMulHeight (x ⟨0, hn⟩)) (le_ciSup hbdd ⟨0, hn⟩)
  have hCB : NumberField.absMulHeight₁ y ≤
      (monoCount n d : ℝ) * (N : ℝ) * (H : ℝ) ^ ((n + 1) * d * g) := by
    have h1 := eval_absMulHeight_le hn hN P hdeg hcoef hint
    have hpow : (WilkiesConjecture.height x) ^
          ((n + 1) * d * Module.finrank ℚ (IntermediateField.adjoin ℚ (Set.range x)))
        ≤ (H : ℝ) ^ ((n + 1) * d * g) := by
      refine le_trans (pow_le_pow_right₀ hheight1 ?_) (pow_le_pow_left₀ (le_trans (by norm_num) hheight1) hH _)
      exact Nat.mul_le_mul (Nat.mul_le_mul_left _ le_rfl) hfin
    calc NumberField.absMulHeight₁ y
        ≤ (monoCount n d : ℝ) * (N : ℝ) *
            (WilkiesConjecture.height x) ^ ((n + 1) * d *
              Module.finrank ℚ (IntermediateField.adjoin ℚ (Set.range x))) := by
          rw [hy_def]; exact h1
      _ ≤ (monoCount n d : ℝ) * (N : ℝ) * (H : ℝ) ^ ((n + 1) * d * g) :=
          mul_le_mul_of_nonneg_left hpow (mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
  have hliou := inv_absMulHeight_pow_le_abs hy_int hy_ne
  have hC1 : (1 : ℝ) ≤ NumberField.absMulHeight₁ y := Work.WilkiesH.Height.one_le_absMulHeight y
  have hCpos : (0 : ℝ) < NumberField.absMulHeight₁ y := lt_of_lt_of_le zero_lt_one hC1
  have hstep1 : (1 : ℝ) /
        ((monoCount n d : ℝ) * (N : ℝ) * (H : ℝ) ^ ((n + 1) * d * g)) ^ g
      ≤ 1 / (NumberField.absMulHeight₁ y) ^ g :=
    one_div_le_one_div_of_le (pow_pos hCpos g)
      (pow_le_pow_left₀ (le_trans (by norm_num) hC1) hCB g)
  have hstep2 : (1 : ℝ) / (NumberField.absMulHeight₁ y) ^ g
      ≤ 1 / (NumberField.absMulHeight₁ y) ^
          (Module.finrank ℚ ↥(IntermediateField.adjoin ℚ ({y} : Set ℝ))) :=
    one_div_le_one_div_of_le (pow_pos hCpos _)
      (pow_le_pow_right₀ hC1 hdegy)
  exact le_trans (le_trans hstep1 hstep2) hliou

end Work.WilkiesH.NT
