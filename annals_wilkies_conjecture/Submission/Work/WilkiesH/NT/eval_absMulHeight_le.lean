import Mathlib
import Submission.Work.WilkiesH.Defs
import Submission.Work.WilkiesH.Height.one_le_absMulHeight
import Submission.Work.WilkiesH.NT.prod_infinitePlace_pow_eq
import Submission.Work.WilkiesH.NT.finprod_finitePlace_eq_pow
import Submission.Work.WilkiesH.NT.absMulHeight_eq_pow_inv
import Submission.Work.WilkiesH.NT.mulHeight_eval_int_le

/-!
# The height of a polynomial value

We prove the bound `Work.WilkiesH.NT.eval_absMulHeight_le`: for a polynomial
`P : MvPolynomial (Fin n) ℤ` of total degree `≤ d` whose coefficients are bounded by `N` in
absolute value, and a tuple `x : Fin n → ℝ` of algebraic real numbers,

`H(P(x)) ≤ (monoCount n d) * N * (height x) ^ ((n+1) * d * [ℚ(x) : ℚ])`,

where `H = NumberField.absMulHeight₁` is the absolute multiplicative height and
`height x = ⨆ i, H (x i)`.

The proof combines
* the comparison of the height of an element of a number field with the height of its real image
  (`absMulHeight_pow_finrank`, built from `absMulHeight_eq_pow_inv` and
  `mulHeight₁_eq_pow_finrank`),
* the elementary height bound for the value of a polynomial with integer coefficients of
  bounded size (`mulHeight_eval_int_le`),
* the elementary facts `1 ≤ H z` and `H (x i) ≤ height x`.
-/

set_option linter.style.haveILetI false

open Classical IntermediateField NumberField

namespace Work.WilkiesH.NT

/-! ### The height of an element of an extension field -/

/-- The (unnormalised) height of an element of a number field is the `Module.finrank`-th power of
the height of the same element computed in a subfield. -/
theorem mulHeight₁_eq_pow_finrank {K : Type*} [Field K] [NumberField K]
    (F : IntermediateField ℚ K) (z : ↥F) :
    Height.mulHeight₁ (K := K) (z : K) =
      (Height.mulHeight₁ (K := ↥F) z) ^ Module.finrank ↥F K := by
  rw [NumberField.mulHeight₁_eq, NumberField.mulHeight₁_eq, prod_infinitePlace_pow_eq F z,
    finprod_finitePlace_eq_pow F z, mul_pow]

/-! ### The height of a number-field element and of its real image -/

/-- The absolute height of the real number `φ x` and the (unnormalised) height of the element `x`
of the number field `K` are related by `H (φ x) ^ [K : ℚ] = mulHeight₁ x`. -/
private theorem absMulHeight_pow_finrank {K : Type*} [Field K] [NumberField K]
    (φ : K →ₐ[ℚ] ℝ) (hφ : Function.Injective φ) (x : K) :
    (NumberField.absMulHeight₁ (φ x)) ^ (Module.finrank ℚ K) = Height.mulHeight₁ (K := K) x := by
  haveI : Algebra.IsAlgebraic ℚ K := Algebra.IsAlgebraic.of_finite ℚ K
  have hx : IsIntegral ℚ x := isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic x)
  let F : IntermediateField ℚ K := IntermediateField.adjoin ℚ ({x} : Set K)
  haveI : FiniteDimensional ℚ ↥F := IntermediateField.adjoin.finiteDimensional hx
  haveI : NumberField ↥F := {}
  let z : ↥F := ⟨x, IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton x)⟩
  have h1 : NumberField.absMulHeight₁ (φ x)
      = (Height.mulHeight₁ (K := ↥F) z) ^ ((Module.finrank ℚ ↥F : ℝ)⁻¹) :=
    absMulHeight_eq_pow_inv φ hφ z.2 rfl
  have hpow : (NumberField.absMulHeight₁ (φ x)) ^ (Module.finrank ℚ ↥F)
      = Height.mulHeight₁ (K := ↥F) z := by
    rw [h1]
    exact Real.rpow_inv_natCast_pow (Height.mulHeight₁_nonneg z)
      (Nat.pos_iff_ne_zero.mp (Module.finrank_pos (R := ℚ) (M := ↥F)))
  rw [← Module.finrank_mul_finrank ℚ ↥F K, pow_mul, hpow, mulHeight₁_eq_pow_finrank F z]

theorem eval_absMulHeight_le {n d N : ℕ} (hn : 1 ≤ n) (hN : 1 ≤ N) (P : MvPolynomial (Fin n) ℤ) (hdeg : P.totalDegree ≤ d) (hcoef : ∀ m ∈ P.support, |(P.coeff m : ℤ)| ≤ (N : ℤ)) {x : Fin n → ℝ} (hint : ∀ i, IsIntegral ℚ (x i)) : NumberField.absMulHeight₁ (MvPolynomial.eval x (P.map (Int.castRingHom ℝ))) ≤ (Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ) * (WilkiesConjecture.height x) ^ ((n + 1) * d * Module.finrank ℚ (IntermediateField.adjoin ℚ (Set.range x))) := by
  classical
  -- The number field generated by the coordinates.
  let Kf : IntermediateField ℚ ℝ := IntermediateField.adjoin ℚ (Set.range x)
  haveI hKfdim : FiniteDimensional ℚ ↥Kf :=
    IntermediateField.finiteDimensional_adjoin (fun y hy => by
      obtain ⟨i, rfl⟩ := hy
      exact hint i)
  haveI hKfNF : NumberField ↥Kf := {}
  -- The coordinates and the value of the polynomial, as elements of that field.
  have hxmem : ∀ i, x i ∈ Kf := fun i => IntermediateField.subset_adjoin ℚ _ ⟨i, rfl⟩
  let xK : Fin n → ↥Kf := fun i => ⟨x i, hxmem i⟩
  set y : ℝ := MvPolynomial.eval x (P.map (Int.castRingHom ℝ)) with hydef
  have hyKf : y ∈ Kf := by
    rw [hydef, MvPolynomial.eval_map]
    refine MvPolynomial.eval₂_mem (s := Kf) (fun i _ => ?_) (fun i => hxmem i)
    refine (bot_le : (⊥ : IntermediateField ℚ ℝ) ≤ Kf) ?_
    rw [IntermediateField.mem_bot]
    exact ⟨(P.coeff i : ℚ), by simp⟩
  -- The value of `P` computed inside `Kf` is the image of `y`.
  have hyval : MvPolynomial.eval xK (P.map (Int.castRingHom ↥Kf)) = (⟨y, hyKf⟩ : ↥Kf) := by
    refine Subtype.ext ?_
    change (algebraMap ↥Kf ℝ) (MvPolynomial.eval xK (P.map (Int.castRingHom ↥Kf))) = y
    have hcomp : (algebraMap ↥Kf ℝ) ∘ xK = x := by
      funext i
      rfl
    have hh : (algebraMap ↥Kf ℝ).comp (Int.castRingHom ↥Kf) = Int.castRingHom ℝ := by
      ext m
      simp
    rw [MvPolynomial.map_eval (algebraMap ↥Kf ℝ), hcomp, MvPolynomial.map_map, hh, hydef]
  -- The absolute height of `y`, raised to `[Kf : ℚ]`.
  have hA : (NumberField.absMulHeight₁ y) ^ (Module.finrank ℚ ↥Kf)
      = Height.mulHeight₁ (K := ↥Kf) (⟨y, hyKf⟩ : ↥Kf) := by
    simpa using absMulHeight_pow_finrank (K := ↥Kf) (IntermediateField.val Kf)
      (fun a b hab => Subtype.ext hab) (⟨y, hyKf⟩ : ↥Kf)
  -- `1 ≤ height x` and `H (x i) ≤ height x`.
  have hMN : (0 : ℝ) ≤ (Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ) := by positivity
  have hHx1 : 1 ≤ WilkiesConjecture.height x := by
    refine le_trans (Work.WilkiesH.Height.one_le_absMulHeight (x ⟨0, by omega⟩)) ?_
    exact Finite.le_ciSup (fun j => NumberField.absMulHeight₁ (x j)) ⟨0, by omega⟩
  have hxi : ∀ i : Fin n, Height.mulHeight₁ (K := ↥Kf) (xK i)
      ≤ (WilkiesConjecture.height x) ^ (Module.finrank ℚ ↥Kf) := by
    intro i
    rw [← absMulHeight_pow_finrank (K := ↥Kf) (IntermediateField.val Kf)
      (fun a b hab => Subtype.ext hab) (xK i)]
    refine pow_le_pow_left₀ ?_ ?_ _
    · exact le_trans zero_le_one
        (Work.WilkiesH.Height.one_le_absMulHeight ((IntermediateField.val Kf) (xK i)))
    · exact Finite.le_ciSup (fun j => NumberField.absMulHeight₁ (x j)) i
  -- The polynomial bound, transported to `y`.
  have h3 := mulHeight_eval_int_le (K := ↥Kf) hN P hdeg hcoef xK
  rw [hyval] at h3
  -- The product of the coordinate bounds.
  have hprod : (∏ i : Fin n, Height.mulHeight₁ (K := ↥Kf) (xK i))
      ≤ ((WilkiesConjecture.height x) ^ (Module.finrank ℚ ↥Kf)) ^ n := by
    calc (∏ i : Fin n, Height.mulHeight₁ (K := ↥Kf) (xK i))
        ≤ ∏ _i : Fin n, (WilkiesConjecture.height x) ^ (Module.finrank ℚ ↥Kf) :=
          Finset.prod_le_prod₀ (fun i _ => Height.mulHeight₁_nonneg _) (fun i _ => hxi i)
      _ = ((WilkiesConjecture.height x) ^ (Module.finrank ℚ ↥Kf)) ^ n := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  -- The main estimate, raised to the `[Kf : ℚ]`-th power.
  have key : (NumberField.absMulHeight₁ y) ^ (Module.finrank ℚ ↥Kf)
      ≤ ((Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ)) ^ (Module.finrank ℚ ↥Kf)
        * (WilkiesConjecture.height x) ^ (n * d * Module.finrank ℚ ↥Kf) := by
    rw [hA]
    refine h3.trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    calc (∏ i : Fin n, Height.mulHeight₁ (K := ↥Kf) (xK i)) ^ d
        ≤ (((WilkiesConjecture.height x) ^ (Module.finrank ℚ ↥Kf)) ^ n) ^ d :=
          pow_le_pow_left₀ (by positivity) hprod d
      _ = (WilkiesConjecture.height x) ^ (n * d * Module.finrank ℚ ↥Kf) := by
          rw [← pow_mul, ← pow_mul]
          congr 1
          ring
  -- Absorb the remaining factor into the power of `height x`.
  have key2 : ((Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ)) ^ (Module.finrank ℚ ↥Kf)
        * (WilkiesConjecture.height x) ^ (n * d * Module.finrank ℚ ↥Kf)
      ≤ (((Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ))
          * (WilkiesConjecture.height x) ^ ((n + 1) * d * Module.finrank ℚ ↥Kf))
          ^ (Module.finrank ℚ ↥Kf) := by
    conv_rhs => rw [mul_pow]
    refine mul_le_mul_of_nonneg_left ?_ (pow_nonneg hMN _)
    rw [← pow_mul]
    refine pow_le_pow_right₀ hHx1 ?_
    have h1 : 1 ≤ Module.finrank ℚ ↥Kf :=
      Nat.one_le_iff_ne_zero.mpr (Nat.pos_iff_ne_zero.mp (Module.finrank_pos (R := ℚ) (M := ↥Kf)))
    calc n * d * Module.finrank ℚ ↥Kf
        ≤ (n + 1) * d * Module.finrank ℚ ↥Kf :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.le_succ n))
      _ ≤ (n + 1) * d * Module.finrank ℚ ↥Kf * Module.finrank ℚ ↥Kf :=
          Nat.le_mul_of_pos_right _ (lt_of_lt_of_le Nat.zero_lt_one h1)
  -- Compare the `[Kf : ℚ]`-th powers, then take the root.
  have hfin : (NumberField.absMulHeight₁ y) ^ (Module.finrank ℚ ↥Kf)
      ≤ (((Work.WilkiesH.monoCount n d : ℝ) * (N : ℝ))
          * (WilkiesConjecture.height x) ^ ((n + 1) * d * Module.finrank ℚ ↥Kf))
          ^ (Module.finrank ℚ ↥Kf) :=
    key.trans key2
  have hnK : Module.finrank ℚ ↥Kf ≠ 0 :=
    Nat.pos_iff_ne_zero.mp (Module.finrank_pos (R := ℚ) (M := ↥Kf))
  have hAy : (0 : ℝ) ≤ NumberField.absMulHeight₁ y :=
    le_trans zero_le_one (Work.WilkiesH.Height.one_le_absMulHeight y)
  have := (pow_le_pow_iff_left₀ hAy (mul_nonneg hMN (pow_nonneg (le_trans zero_le_one hHx1) _))
    hnK).mp hfin
  exact this

end Work.WilkiesH.NT
