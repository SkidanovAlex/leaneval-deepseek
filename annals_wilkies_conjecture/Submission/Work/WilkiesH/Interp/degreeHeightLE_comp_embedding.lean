import Mathlib
import Submission.Work.WilkiesH.Defs

/-!
# `degreeHeightLE` is preserved by restricting coordinates along an embedding

For `g H : ℕ`, `WilkiesConjecture.degreeHeightLE X g H` is the set of points of `X` all of
whose coordinates are integral over `ℚ`, whose field of coordinates has degree `≤ g`
over `ℚ`, and whose (multiplicative) height is `≤ H`.

This file records the trivial but indispensable bookkeeping fact that these properties are
inherited by any subfamily of the coordinates: for an embedding `e : Fin m ↪ Fin n` of
index sets and `x ∈ degreeHeightLE X g H`, the restricted tuple `fun i => x (e i)` again
has integral coordinates, degree `≤ g` and height `≤ H`.  Concretely

* the coordinates `x (e i)` are coordinates of `x`, hence integral;
* `ℚ⟮x (e i) : i⟯` is a subfield of `ℚ⟮x i : i⟯`, so its `ℚ`-dimension is at most that of
  `ℚ⟮x i : i⟯` (which is finite because it is generated by finitely many integral
  elements);
* the height of a tuple is the supremum of the heights of its coordinates, so passing to a
  subfamily can only lower it.

The main consumer is the interpolation step of the counting argument, where a point of
`X(g,H)` is restricted to a subfamily `J ⊆ Fin n` of `μ+1` coordinates.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Work.WilkiesH.Interp

open WilkiesConjecture

/-! ## Heights -/

/-- The absolute multiplicative height of a real number is nonnegative.  Either the number
is integral over `ℚ` and the height is a positive real power of an (at least `1`) height of
a generator of `ℚ⟮x⟯`, or the number is not integral and the height is the junk value `1`. -/
lemma zero_le_absMulHeight₁ (y : ℝ) : 0 ≤ NumberField.absMulHeight₁ y := by
  rw [NumberField.absMulHeight₁]
  split_ifs with hx
  · exact Real.rpow_nonneg (by positivity) _
  · norm_num

/-- The height of a tuple is nonnegative: the supremum of a family of nonnegative numbers,
and `0` for the empty tuple. -/
lemma zero_le_height {n : ℕ} (x : Fin n → ℝ) : 0 ≤ WilkiesConjecture.height x := by
  rcases isEmpty_or_nonempty (Fin n) with h | h
  · have hn : n = 0 := by
      by_contra hn
      exact h.false ⟨0, Nat.pos_of_ne_zero hn⟩
    subst hn
    rw [WilkiesConjecture.height, iSup]
    simp
  · obtain ⟨i⟩ := h
    exact (zero_le_absMulHeight₁ (x i)).trans
      (le_ciSup (f := fun j : Fin n => NumberField.absMulHeight₁ (x j))
        (Set.finite_range _).bddAbove i)

/-- The height of a tuple whose coordinates are a subfamily of those of `x` (along an
embedding `e` of index sets) is at most the height of `x`: the height is the supremum of
the heights of the individual coordinates. -/
theorem height_comp_le {n m : ℕ} (e : Fin m ↪ Fin n) (x : Fin n → ℝ) :
    WilkiesConjecture.height (fun i : Fin m => x (e i)) ≤ WilkiesConjecture.height x := by
  rw [WilkiesConjecture.height, iSup]
  refine Real.sSup_le ?_ (zero_le_height x)
  rintro y ⟨i, rfl⟩
  exact le_ciSup (f := fun j : Fin n => NumberField.absMulHeight₁ (x j))
    (Set.finite_range _).bddAbove (e i)

/-! ## Fields of coordinates -/

/-- The field generated by the coordinates `x (e i)` of a restricted tuple is a subfield of
the field generated by all the coordinates of `x`. -/
theorem adjoin_range_comp_le {n m : ℕ} (e : Fin m ↪ Fin n) (x : Fin n → ℝ) :
    IntermediateField.adjoin ℚ (Set.range (fun i : Fin m => x (e i))) ≤
      IntermediateField.adjoin ℚ (Set.range x) := by
  rw [IntermediateField.adjoin_le_iff]
  rintro y ⟨i, rfl⟩
  exact (IntermediateField.subset_adjoin ℚ (Set.range x)) ⟨e i, rfl⟩

/-- If all coordinates of `x` are integral over `ℚ`, then the field they generate is finite
dimensional over `ℚ`: it is generated by the finitely many integral elements `x i`, and the
subalgebra they generate is a finite `ℚ`-module (which, being generated by integral
elements, coincides with the intermediate field they generate). -/
theorem finiteDimensional_adjoin_range_of_isIntegral {n : ℕ} {x : Fin n → ℝ}
    (hint : ∀ i, IsIntegral ℚ (x i)) :
    FiniteDimensional ℚ ↥(IntermediateField.adjoin ℚ (Set.range x)) := by
  have hfin : Module.Finite ℚ ↥(Algebra.adjoin ℚ (Set.range x)) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range x)
      (by rintro y ⟨i, rfl⟩; exact hint i)
  have hsub : Module.Finite ℚ ↥(IntermediateField.adjoin ℚ (Set.range x)).toSubalgebra := by
    rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic (S := Set.range x)
      (fun y hy => by rcases hy with ⟨i, rfl⟩; exact (hint i).isAlgebraic)]
    exact hfin
  exact hsub

/-! ## The lemma -/

theorem degreeHeightLE_comp_embedding {n m : ℕ} (e : Fin m ↪ Fin n) (X : Set (Fin n → ℝ))
    (g H : ℕ) {x : Fin n → ℝ} (hx : x ∈ WilkiesConjecture.degreeHeightLE X g H) :
    (∀ i, IsIntegral ℚ ((fun i : Fin m => x (e i)) i)) ∧
      Module.finrank ℚ (IntermediateField.adjoin ℚ (Set.range (fun i : Fin m => x (e i)))) ≤ g ∧
      WilkiesConjecture.height (fun i : Fin m => x (e i)) ≤ (H : ℝ) := by
  obtain ⟨hxX, hint, hdeg, hh⟩ := hx
  refine ⟨fun i => hint (e i), ?_, ?_⟩
  · haveI : FiniteDimensional ℚ ↥(IntermediateField.adjoin ℚ (Set.range x)) :=
      finiteDimensional_adjoin_range_of_isIntegral hint
    exact (IntermediateField.finrank_le_of_le_right (adjoin_range_comp_le e x)).trans hdeg
  · exact (height_comp_le e x).trans hh

end Work.WilkiesH.Interp
