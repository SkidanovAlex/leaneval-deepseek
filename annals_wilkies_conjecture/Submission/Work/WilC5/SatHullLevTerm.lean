import Mathlib
import Submission.Work.WilC5.SatSetup
import Submission.Work.WilC5.SatBuild
import Submission.Work.WilC5.SatCore
import Submission.Work.WilC5.SatHull

open FirstOrder Language
open scoped FirstOrder

set_option autoImplicit false
noncomputable section

namespace Work.WilC5

/-!
  WilC5 — the term hull of a model of the total theory, at a single level.

  `SatHullLev L M κ N z` is the `L`-substructure of `N` generated by the values of the
  constants of level `z` of `L[[SatCTotal]]`.  In this file we show the fundamental
  description of its elements: an element of `N` lies in the level-`z` hull if and only if
  it is the value of a *closed term* of the language `L[[SatC z]]` of level `z`, evaluated
  after mapping the level-`z` constants into the constants of the total language.

  The technical content is the general fact `mem_closure_range_satConVal_iff_exists_term`:
  for a structure `N` carrying both an `L`-structure and an `L[[C]]`-structure whose `L`-part
  agrees with the `L`-structure (the hypothesis `IsExpansionOn (lhomWithConstants L C)`),
  the `L`-substructure generated by the values `SatConVal L C N c` of the constants of `C` is
  exactly the set of values of closed terms of `L[[C]]`.
-/

/-- **The term hull of a set of constants.**  Let `N` carry an `L`-structure and an
`L[[C]]`-structure whose `L`-part agrees with the `L`-structure (expressed by the hypothesis
that the language map `L →ᴸ L[[C]]` adding the constants is an expansion, in the sense of
`LHom.IsExpansionOn`).  Then the `L`-substructure of `N` generated by the constants `c ∈ C`
is exactly the set of values of the closed `L[[C]]`-terms: every element of the hull is named
by a term, and every closed term evaluates into the hull.

This is the "terms generate the closure" description of `Substructure.closure`, transported to
the language `L[[C]]` with constants. -/
theorem mem_closure_range_satConVal_iff_exists_term
    {L : FirstOrder.Language.{0, 0}} {N : Type} {C : Type}
    [instL : L.Structure N] [instC : (L[[C]]).Structure N]
    (hExp : @LHom.IsExpansionOn L (L[[C]]) (L.lhomWithConstants C) N instL instC)
    (a : N) :
    a ∈ (Substructure.closure L (Set.range (fun c : C => @SatConVal L C N instC c))) ↔
      ∃ t : (L[[C]]).Term Empty,
        @Term.realize (L[[C]]) N instC Empty (default : Empty → N) t = a := by
  haveI := hExp
  constructor
  · -- Every element of the hull is the value of a closed term.
    intro ha
    obtain ⟨t, ht⟩ := (@Substructure.mem_closure_iff_exists_term L N instL
      (s := Set.range (fun c : C => @SatConVal L C N instC c)) (x := a)).1 ha
    -- `t` is an `L`-term with variables indexed by the set of values of the constants; choose
    -- for each such value a constant naming it.
    let hCc : Set.range (fun c : C => @SatConVal L C N instC c) → C :=
      fun x => Classical.choose x.2
    have hC : ∀ x, @SatConVal L C N instC (hCc x) = (x : N) :=
      fun x => Classical.choose_spec x.2
    refine ⟨(t.subst (fun x => @Term.var L (C ⊕ Empty) (Sum.inl (hCc x)))).varsToConstants, ?_⟩
    rw [Term.realize_varsToConstants]
    rw [Term.realize_subst]
    have hval : (fun x : Set.range (fun c : C => @SatConVal L C N instC c) =>
        @Term.realize L N instL (C ⊕ Empty)
          (Sum.elim (fun c : C => (↑(L.con c) : N)) (default : Empty → N))
          (@Term.var L (C ⊕ Empty) (Sum.inl (hCc x)))) = Subtype.val := by
      funext x
      rw [Term.realize_var]
      exact hC x
    rw [hval]
    exact ht
  · -- Every closed term evaluates into the hull.
    rintro ⟨t, ht⟩
    rw [← ht]
    have h1 := @Term.realize_constantsToVars L N inferInstance C Empty instC inferInstance t
      (default : Empty → N)
    -- Regard the term as an `L`-term in the constants, then relabel the constants by the
    -- corresponding values in `N`.
    have hrel : (@Term.realize L N instL (Set.range (fun c : C => @SatConVal L C N instC c))
          Subtype.val
          ((t.constantsToVars).relabel
            (Sum.elim
              (fun c : C => (⟨@SatConVal L C N instC c, Set.mem_range_self c⟩ :
                Set.range (fun c : C => @SatConVal L C N instC c)))
              (fun e : Empty => Empty.elim e))))
        = @Term.realize L N instL (C ⊕ Empty)
            (Sum.elim (fun c : C => (↑(L.con c) : N)) (default : Empty → N))
            t.constantsToVars := by
      rw [Term.realize_relabel]
      congr 1
      funext i
      cases i with
      | inl c => rfl
      | inr e => exact Empty.elim e
    rw [Substructure.mem_closure_iff_exists_term]
    exact ⟨_, hrel.trans h1⟩

theorem SatHullLevTerm {L : FirstOrder.Language.{0, 0}} {M : Type} [instM : L.Structure M]
    {κ : Cardinal.{0}} (N : Type)
    [instN : (FirstOrder.Language.withConstants L (SatCTotal L M κ)).Structure N]
    (z : SatIdx κ) (a : N) :
    a ∈ (SatHullLev L M κ N z : Set N) ↔
      ∃ t : (SatLang L (SatC L M κ z)).Term Empty,
        @FirstOrder.Language.Term.realize (SatLang L (SatCTotal L M κ)) N instN Empty
          (default : Empty → N) ((SatLangMap (SatIncTotal L M κ z)).onTerm t) = a := by
  -- The `L`-structure of `N` is its reduct from `L[[SatCTotal]]`.
  letI instL : L.Structure N := SatReduct L M κ N
  -- The level-`z` language `L[[SatC z]]` acts on `N` through the inclusion of its constants
  -- into the total set of constants.
  letI instLC : (SatLang L (SatC L M κ z)).Structure N :=
    @LHom.reduct (SatLang L (SatC L M κ z)) (SatLang L (SatCTotal L M κ))
      (SatLangMap (SatIncTotal L M κ z)) N instN
  -- The `L`-part of that structure is the reduct, so the constants inclusion is an expansion.
  haveI hExp : @LHom.IsExpansionOn L (SatLang L (SatC L M κ z))
      (L.lhomWithConstants (SatC L M κ z)) N instL instLC :=
    { map_onFunction := fun {n} f x => rfl, map_onRelation := fun {n} R x => rfl }
  have key := mem_closure_range_satConVal_iff_exists_term (L := L) (N := N)
    (C := SatC L M κ z) (instL := instL) (instC := instLC) hExp a
  -- The hull is generated by the values of the level-`z` constants, in the level-`z` language.
  have hL : a ∈ (SatHullLev L M κ N z : Set N) ↔
      a ∈ (Substructure.closure L (Set.range (fun c : SatC L M κ z =>
        @SatConVal L (SatC L M κ z) N instLC c))) := Iff.rfl
  refine hL.trans (key.trans ?_)
  -- Finally, realizing a term of `L[[SatC z]]` in `L[[SatCTotal]]` after mapping the constants
  -- is the same as realizing it in the level-`z` structure.
  constructor
  · rintro ⟨t, ht⟩
    refine ⟨t, ?_⟩
    have h := @LHom.realize_onTerm (SatLang L (SatC L M κ z)) (SatLang L (SatCTotal L M κ)) N
      instLC Empty instN (SatLangMap (SatIncTotal L M κ z))
      (LHom.isExpansionOn_reduct (SatLangMap (SatIncTotal L M κ z)) N) t (default : Empty → N)
    exact h.trans ht
  · rintro ⟨t, ht⟩
    refine ⟨t, ?_⟩
    have h := @LHom.realize_onTerm (SatLang L (SatC L M κ z)) (SatLang L (SatCTotal L M κ)) N
      instLC Empty instN (SatLangMap (SatIncTotal L M κ z))
      (LHom.isExpansionOn_reduct (SatLangMap (SatIncTotal L M κ z)) N) t (default : Empty → N)
    exact h.symm.trans ht

end Work.WilC5
