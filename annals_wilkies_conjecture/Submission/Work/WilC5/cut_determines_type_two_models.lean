/-
  WilC5 — the two-model form of "the cut determines the type".

  This is the form of area C2's / C5's `cut_determines_type_of_omin` in which the two points live in
  *two different* models `K` and `L` of `TR`, related by a partial elementary map `σ : A → A'`
  between `dcl`-closed parameter sets, and the cut condition is transported along `σ`:

      `∀ a : A, (a < x ↔ σ a < y)`  and  `∀ a : A, (x < a ↔ y < σ a)`.

  The proof first amalgamates `K` and `L` over `σ` (`Work.WilC5.amalgam_of_partial_elementary`):
  a model `N ⊨ TR` with elementary embeddings `g : K →ₑ N`, `e : L →ₑ N` agreeing on `A`.  In `N`
  the images `g x` and `e y` define the same cut over `g '' A`, so the one-model theorem applies;
  the remaining work is the bookkeeping that lets the one-model theorem be quoted at a model
  (`N`) whose `LRc`-structure is *not* syntactically the one generated by its field/order
  instances.  This is the lemma `cdt_reduct` below: the two-model theorem stated for an explicit
  `LRc`-structure `s`, with hypotheses identifying its reducts with the ambient instances.

  The order of `K` (resp. `L`) — a `LinearOrder` compatible with the field — is the `LRc`-definable
  order `leEL` (`Work.WilC5.leEL_iff_le`), which is what makes the cut condition meaningful for
  the `LRc`-type; `leEL` is preserved by elementary embeddings for the same reason.
-/
import Mathlib
import Submission.Work.WilC5.TRCanon
import Submission.Work.WilC5.tr_isStrictOrderedRing
import Submission.Work.WilC5.cut_determines_type_of_omin
import Submission.Work.WilC5.ExistsSaturated
import Submission.Work.WilC5.extends_of_elementary_sat
import Submission.Work.WilC5.LRcReduct
import Submission.Work.WilC5.leEL_iff_le
import Submission.Work.WilC5.amalgam_of_partial_elementary
import Submission.Work.WilC5.extends_elemOn_sat
import Submission.Work.WilC5.dcl_image_of_elementary

set_option autoImplicit false
set_option maxHeartbeats 1000000

noncomputable section
open Classical FirstOrder FirstOrder.Language
namespace Work.WilC5

open WilkiesDesign WilkiesDesign.CG

/-- The `LRc`-structure built from an explicit `ring`/`rexp`/`constants` triple. -/
def canonLRc (M : Type) (ring : Language.ring.Structure M) (rexp : rexpL.Structure M)
    (con : (constantsOn ℝ).Structure M) : LRc.Structure M :=
  @Language.withConstantsStructure LR M
    (@Language.sumStructure Language.ring rexpL M ring rexp) ℝ con

/-- The `LRc`-structure generated by the reducts of an `LRc`-structure is that
`LRc`-structure. -/
theorem canonLRc_eq_inst {M : Type} (inst : LRc.Structure M) :
    canonLRc M (@lrcRingReduct M inst) (@lrcRexpReduct M inst) (@lrcConstReduct M inst) = inst := by
  apply Structure.ext
  · funext n f x
    cases f with
    | inl g =>
      cases g with
      | inl g' => rfl
      | inr g' => cases g' with | rexp => rfl
    | inr c => rfl
  · funext n R x
    cases R with
    | inl a =>
      cases a with
      | inl a' => exact isEmptyElim a'
      | inr a' => exact isEmptyElim a'
    | inr b => exact isEmptyElim b

/-- **The one-model cut theorem for an explicit `LRc`-structure.**

`cut_determines_type_of_omin` is stated for a type whose `LRc`-structure is the one generated by
its field/order instances.  This version takes the `LRc`-structure `s` as an explicit argument and
identifies its reducts with the instances through the three pointwise hypotheses `hCR`, `hRX`,
`hCN`; it is what lets the one-model theorem be applied at an amalgam `N` whose `LRc`-structure is
only known to have the right reducts. -/
theorem cdt_reduct {M : Type} (s : LRc.Structure M) (hOM : WilkiesDesign.CG.OMinModels)
    [Field M] [LinearOrder M] [IsStrictOrderedRing M] [Ring.CompatibleRing M]
    [rexpL.Structure M] [(constantsOn ℝ).Structure M]
    (hCR : ∀ {n} (f : Language.ring.Functions n) (x : Fin n → M),
      @Structure.funMap Language.ring M
          (Ring.CompatibleRing.toStructure (self := (inferInstance : Ring.CompatibleRing M))) n f x =
        @Structure.funMap LRc M s n (Sum.inl (Sum.inl f)) x)
    (hRX : ∀ (x : Fin 1 → M),
      @Structure.funMap rexpL M (inferInstance : rexpL.Structure M) 1 rexpFunc.rexp x =
        @Structure.funMap LRc M s 1 (Sum.inl (Sum.inr rexpFunc.rexp)) x)
    (hCN : ∀ {n} (c : (constantsOn ℝ).Functions n) (x : Fin n → M),
      @Structure.funMap (constantsOn ℝ) M (inferInstance : (constantsOn ℝ).Structure M) n c x =
        @Structure.funMap LRc M s n (Sum.inr c) x)
    (hM : @Theory.Model LRc M s TR) {A : Set M} (hA : @Work.WilC2.Dcl (M := M) s A ⊆ A)
    {a b : M} (hcut : (∀ c ∈ A, (c < a ↔ c < b)) ∧ (a ∈ A ↔ b ∈ A))
    {n : ℕ} (φ : LRc.Formula (Fin n ⊕ Fin 1)) (v : Fin n → M) (hv : ∀ i, v i ∈ A) :
    @Formula.Realize LRc M s (Fin n ⊕ Fin 1) φ (Sum.elim v (fun _ => a)) ↔
      @Formula.Realize LRc M s (Fin n ⊕ Fin 1) φ (Sum.elim v (fun _ => b)) := by
  have hTs : canonLRc M
      (Ring.CompatibleRing.toStructure (self := (inferInstance : Ring.CompatibleRing M)))
      (inferInstance : rexpL.Structure M)
      (inferInstance : (constantsOn ℝ).Structure M) = s := by
    apply Structure.ext
    · funext n f x
      cases f with
      | inl g =>
        cases g with
        | inl g' => exact hCR g' x
        | inr g' => cases g' with | rexp => exact hRX x
      | inr c => exact hCN c x
    · funext n R x
      cases R with
      | inl a =>
        cases a with
        | inl a' => exact isEmptyElim a'
        | inr a' => exact isEmptyElim a'
      | inr b => exact isEmptyElim b
  have hM' : @Theory.Model LRc M
      (canonLRc M
        (Ring.CompatibleRing.toStructure (self := (inferInstance : Ring.CompatibleRing M)))
        (inferInstance : rexpL.Structure M)
        (inferInstance : (constantsOn ℝ).Structure M)) TR := hTs ▸ hM
  have hA' : @Work.WilC2.Dcl (M := M)
      (canonLRc M
        (Ring.CompatibleRing.toStructure (self := (inferInstance : Ring.CompatibleRing M)))
        (inferInstance : rexpL.Structure M)
        (inferInstance : (constantsOn ℝ).Structure M)) A ⊆ A := hTs ▸ hA
  have key := @Work.WilC5.cut_determines_type_of_omin hOM M inferInstance inferInstance inferInstance
    inferInstance inferInstance inferInstance hM' A hA' a b hcut n φ v hv
  exact hTs ▸ key

/-- The two-variable `LRc`-formula whose realization is `leEL`. -/
def leForm2 : LRc.Formula (Fin 2) :=
  leFormL (Term.var (Sum.inl (0 : Fin 2))) (Term.var (Sum.inl (1 : Fin 2)))

theorem leForm2_realize {M : Type} [LRc.Structure M] (v : Fin 2 → M) :
    leForm2.Realize v ↔ leEL (v 0) (v 1) := by
  have h := leFormL_realize (t₁ := Term.var (Sum.inl (0 : Fin 2)))
    (t₂ := Term.var (Sum.inl (1 : Fin 2))) (v := v) (xs := (default : Fin 0 → M))
  simpa [leForm2, Formula.Realize, Term.realize_var] using h

/-- `leEL` is preserved by an elementary embedding (it is `LRc`-definable). -/
theorem elem_leEL {K N : Type} [LRc.Structure K] [LRc.Structure N]
    (f : LRc.ElementaryEmbedding K N) (a b : K) :
    leEL (f a) (f b) ↔ leEL a b := by
  have key : leForm2.Realize ![f a, f b] ↔ leForm2.Realize ![a, b] := by
    convert f.map_formula leForm2 ![a, b] using 2
    funext i
    fin_cases i <;> rfl
  rw [leForm2_realize, leForm2_realize] at key
  simpa using key

/-- The inverse of a surjective partial elementary map (as a function on the target) is elementary:
the comparison is reduced to the given `ElemOn` by relabelling the free variables of a formula to
the parameters of `B`. -/
theorem elemOn_inverse_formula {L : FirstOrder.Language.{0, 0}} {M N : Type} [L.Structure M]
    [L.Structure N] {B : Set N} {τ : B → M} (h : ElemOn (L := L) B τ) {g : M → N}
    (hg : ∀ m : M, ∃ b : B, τ b = m ∧ (b : N) = g m) :
    ∀ {n : ℕ} (φ : L.Formula (Fin n)) (m : Fin n → M),
      φ.Realize (g ∘ m) ↔ φ.Realize m := by
  intro n φ m
  choose b hb using hg
  have hb1 : ∀ i, τ (b (m i)) = m i := fun i => (hb (m i)).1
  have hb2 : ∀ i, ((b (m i) : B) : N) = g (m i) := fun i => (hb (m i)).2
  have hφ := h (φ.relabel (fun i : Fin n => b (m i)))
  simp only [Formula.realize_relabel] at hφ
  rw [show (Subtype.val : B → N) ∘ (fun i : Fin n => b (m i)) = g ∘ m from
        funext fun i => hb2 i,
      show (τ ∘ (fun i : Fin n => b (m i))) = m from funext fun i => hb1 i] at hφ
  exact hφ

/-- A surjective partial elementary map has an inverse which is an elementary embedding. -/
theorem elemOn_inverse_elementaryEmbedding {L : FirstOrder.Language.{0, 0}} {M N : Type}
    [L.Structure M] [L.Structure N] {B : Set N} {τ : B → M} (h : ElemOn (L := L) B τ)
    (hsurj : ∀ m : M, ∃ b : B, τ b = m) :
    ∃ g : L.ElementaryEmbedding M N, ∀ m : M, ∃ b : B, τ b = m ∧ (b : N) = g m := by
  classical
  let g : M → N := fun m => ((Classical.choose (hsurj m) : B) : N)
  have hg : ∀ m : M, ∃ b : B, τ b = m ∧ (b : N) = g m := by
    intro m
    exact ⟨Classical.choose (hsurj m), Classical.choose_spec (hsurj m), rfl⟩
  exact ⟨⟨g, fun {_} φ m => elemOn_inverse_formula (L := L) h hg φ m⟩, hg⟩

/-- **Amalgamation of two models of `TR` over a partial elementary map.**

There are `N ⊨ TR` and elementary embeddings `f : K → N`, `g : L → N` agreeing on `A`.  This is
proved by taking a saturated elementary extension `N` of `K` and extending the partial elementary
map `σ⁻¹` (between `f '' A` and `A`) to a surjective partial elementary map onto `L`; the inverse
of the latter is the elementary embedding `g : L → N`. -/
theorem amalgam_of_partial_elementary' {K L : Type}
    [FirstOrder.Language.Structure WilkiesDesign.CG.LRc K]
    [FirstOrder.Language.Structure WilkiesDesign.CG.LRc L]
    (hK : @FirstOrder.Language.Theory.Model WilkiesDesign.CG.LRc K _ WilkiesDesign.CG.TR)
    (hL : @FirstOrder.Language.Theory.Model WilkiesDesign.CG.LRc L _ WilkiesDesign.CG.TR)
    {A : Set K} (hA : Work.WilC2.Dcl A ⊆ A) (σ : A → L)
    (hσ : ∀ {n : ℕ} (φ : WilkiesDesign.CG.LRc.Formula (Fin n)) (a : Fin n → A),
      (φ.Realize (fun i => (a i : K)) ↔ φ.Realize (fun i => (σ (a i) : L)))) :
    ∃ (N : Type) (instN : FirstOrder.Language.Structure WilkiesDesign.CG.LRc N)
      (hN : @FirstOrder.Language.Theory.Model WilkiesDesign.CG.LRc N instN WilkiesDesign.CG.TR)
      (f : @FirstOrder.Language.ElementaryEmbedding WilkiesDesign.CG.LRc K N _ instN)
      (g : @FirstOrder.Language.ElementaryEmbedding WilkiesDesign.CG.LRc L N _ instN),
      ∀ a : A, f a = g (σ a) := by
  classical
  set κ : Cardinal.{0} := Order.succ (Cardinal.mk L) with hκdef
  have hκ : Cardinal.mk L < κ := Order.lt_succ_iff.mpr le_rfl
  obtain ⟨N, instN, f, hsat⟩ := Work.WilC5.ExistsSaturated (L := WilkiesDesign.CG.LRc) K κ
  let gk : A → N := fun a => (f (a : K) : N)
  let B₀ : Set N := Set.range gk
  let e : A ≃ B₀ :=
    { toFun := fun a => ⟨gk a, ⟨a, rfl⟩⟩
      invFun := fun y => Classical.choose y.2
      left_inv := fun a => Subtype.ext (f.injective (by
        have h := Classical.choose_spec (show gk a ∈ Set.range gk from ⟨a, rfl⟩)
        simpa [gk] using h))
      right_inv := fun y => Subtype.ext (Classical.choose_spec y.2) }
  let τ₀ : B₀ → L := fun y => σ (e.symm y)
  have hτ₀ : Work.WilC5.ElemOn (L := WilkiesDesign.CG.LRc) B₀ τ₀ := by
    have hred := Work.WilC5.realize_iff_of_fin (L := WilkiesDesign.CG.LRc) σ hσ
    intro φ
    let φ' : WilkiesDesign.CG.LRc.Formula A := φ.relabel (⇑e.symm)
    have h1' : φ'.Realize gk ↔ φ.Realize (Subtype.val : B₀ → N) := by
      have hfn : (gk ∘ (⇑e.symm) : B₀ → N) = (Subtype.val : B₀ → N) := by
        funext y
        change (f ((e.symm y : A) : K) : N) = (y : N)
        exact congrArg Subtype.val (e.apply_symm_apply y)
      rw [show φ' = φ.relabel (⇑e.symm) from rfl, Formula.realize_relabel, hfn]
    have h2' : φ'.Realize gk ↔ φ'.Realize (Subtype.val : A → K) := by
      have h := f.map_formula φ' (Subtype.val : A → K)
      simpa [Function.comp_def, gk] using h
    have h3' : φ'.Realize (Subtype.val : A → K) ↔ φ'.Realize σ := hred φ'
    have h4' : φ'.Realize σ ↔ φ.Realize τ₀ := by
      have hfn : (σ ∘ (⇑e.symm) : B₀ → L) = τ₀ := rfl
      rw [show φ' = φ.relabel (⇑e.symm) from rfl, Formula.realize_relabel, hfn]
    exact h1'.symm.trans (h2'.trans (h3'.trans h4'))
  obtain ⟨B', hBB, τ', hτ', hagree, hsurj⟩ :=
    Work.WilC5.exists_surj_extension_elemOn hτ₀ κ hκ hsat
  obtain ⟨g, hg⟩ := elemOn_inverse_elementaryEmbedding (L := WilkiesDesign.CG.LRc) hτ' hsurj
  refine ⟨N, instN, (f.theory_model_iff WilkiesDesign.CG.TR).mp hK, f, g, ?_⟩
  intro a
  obtain ⟨b, hb1, hb2⟩ := hg (σ a)
  have hea : (e a : N) ∈ B' := hBB (e a).2
  have h2 : τ' ⟨(e a : N), hea⟩ = σ a := by
    rw [hagree (e a)]
    simp only [τ₀]
    rw [Equiv.symm_apply_apply]
  have h3 : b = ⟨(e a : N), hea⟩ := elemOn_injective hτ' (hb1.trans h2.symm)
  rw [← hb2, h3]
  simp only [e, gk]
  rfl

theorem cut_determines_type_two_models (hOM : WilkiesDesign.CG.OMinModels) {K L : Type}
    [Field K] [LinearOrder K] [IsStrictOrderedRing K] [FirstOrder.Ring.CompatibleRing K]
    [WilkiesDesign.CG.rexpL.Structure K] [(FirstOrder.Language.constantsOn ℝ).Structure K]
    [FirstOrder.Language.Theory.Model K WilkiesDesign.CG.TR]
    [Field L] [LinearOrder L] [IsStrictOrderedRing L] [FirstOrder.Ring.CompatibleRing L]
    [WilkiesDesign.CG.rexpL.Structure L] [(FirstOrder.Language.constantsOn ℝ).Structure L]
    [FirstOrder.Language.Theory.Model L WilkiesDesign.CG.TR]
    {A : Set K} (hA : Work.WilC2.Dcl A ⊆ A) {A' : Set L} (hA' : Work.WilC2.Dcl A' ⊆ A')
    (σ : A → A')
    (hσ : ∀ {n : ℕ} (φ : WilkiesDesign.CG.LRc.Formula (Fin n)) (a : Fin n → A),
      (φ.Realize (fun i => (a i : K)) ↔ φ.Realize (fun i => (σ (a i) : L))))
    {x : K} {y : L}
    (hcut : (∀ a : A, ((a : K) < x ↔ σ a < y)) ∧ (∀ a : A, (x < (a : K) ↔ y < σ a)))
    {m : ℕ} (ψ : WilkiesDesign.CG.LRc.Formula (Fin m ⊕ Fin 1)) (w : Fin m → A) :
    (ψ.Realize (Sum.elim (fun i => (w i : K)) (fun _ => x))) ↔
      (ψ.Realize (Sum.elim (fun i => (σ (w i) : L)) (fun _ => y))) := by
  classical
  have hKTR : @Theory.Model LRc K _ TR := inferInstance
  have hLTR : @Theory.Model LRc L _ TR := inferInstance
  -- ### 1. the amalgam of `K` and `L` over `σ`
  obtain ⟨N, instN, hNTR, g, e, hagree⟩ :=
    amalgam_of_partial_elementary' hKTR hLTR hA (fun a : A => (σ a : L)) hσ
  -- ### 2. the canonical instance bundle on `N`
  let F : Field N := @Work.WilC5.trField N instN hNTR
  letI : Field N := F
  let LO : LinearOrder N := @Work.WilC5.trLinearOrder N instN hNTR
  letI : LinearOrder N := LO
  let SOR : IsStrictOrderedRing N := @Work.WilC5.tr_isStrictOrderedRing N instN hNTR
  haveI : IsStrictOrderedRing N := SOR
  let CR : Ring.CompatibleRing N :=
    { toStructure := @lrcRingReduct N instN
      funMap_add := by
        simp only [Fin.forall_fin_succ_pi, Fin.cons_zero, Fin.forall_fin_zero_pi]; intros; rfl
      funMap_mul := by
        simp only [Fin.forall_fin_succ_pi, Fin.cons_zero, Fin.forall_fin_zero_pi]; intros; rfl
      funMap_neg := by
        simp only [Fin.forall_fin_succ_pi, Fin.cons_zero, Fin.forall_fin_zero_pi]; intros; rfl
      funMap_zero := by simp only [Fin.forall_fin_zero_pi]; rfl
      funMap_one := by simp only [Fin.forall_fin_zero_pi]; rfl }
  letI : Ring.CompatibleRing N := CR
  let RX : rexpL.Structure N := @lrcRexpReduct N instN
  letI : rexpL.Structure N := RX
  let CN : (constantsOn ℝ).Structure N := @lrcConstReduct N instN
  letI : (constantsOn ℝ).Structure N := CN
  -- ### 3. `dcl`-closure of the image of `A`
  have hAdcl : @Work.WilC2.Dcl N instN ((⇑g) '' A) ⊆ (⇑g) '' A :=
    @dcl_image_of_elementary K N _ instN g A hA
  -- ### 4. `leEL` versus the (linear) orders
  have hgle : ∀ a b : K, leEL (g a) (g b) ↔ leEL a b := fun a b => elem_leEL g a b
  have hele : ∀ a b : L, leEL (e a) (e b) ↔ leEL a b := fun a b => elem_leEL e a b
  have hKord : ∀ a b : K, a < b ↔ leEL a b ∧ ¬ leEL b a := fun a b => by
    rw [lt_iff_le_not_ge, leEL_iff_le hKTR, leEL_iff_le hKTR]
  have hLord : ∀ a b : L, a < b ↔ leEL a b ∧ ¬ leEL b a := fun a b => by
    rw [lt_iff_le_not_ge, leEL_iff_le hLTR, leEL_iff_le hLTR]
  have hNord : ∀ a b : N, a < b ↔ leEL a b ∧ ¬ leEL b a := fun a b => Iff.rfl
  -- ### 5. the cut condition in `N`
  have hcutN : (∀ c ∈ (⇑g) '' A, (c < g x ↔ c < e y)) ∧
      (g x ∈ (⇑g) '' A ↔ e y ∈ (⇑g) '' A) := by
    constructor
    · rintro c ⟨a, ha, rfl⟩
      have h1 : (a : K) < x ↔ g a < g x := by
        rw [hKord, hNord, hgle a x, hgle x a]
      have h3 : (((σ ⟨a, ha⟩ : A')) : L) < y ↔ e (((σ ⟨a, ha⟩ : A')) : L) < e y := by
        rw [hLord, hNord, hele, hele]
      rw [← h1, hcut.1 ⟨a, ha⟩, h3, ← hagree ⟨a, ha⟩]
    · constructor
      · rintro ⟨a, ha, hax⟩
        have hxa : x = a := (g.injective hax).symm
        have hx'A : x ∈ A := hxa ▸ ha
        have hy : (((σ ⟨x, hx'A⟩ : A')) : L) = y := by
          refine le_antisymm ?_ ?_
          · exact not_lt.mp (fun h => absurd ((hcut.2 ⟨x, hx'A⟩).mpr h) (lt_irrefl x))
          · exact not_lt.mp (fun h => absurd ((hcut.1 ⟨x, hx'A⟩).mpr h) (lt_irrefl x))
        exact ⟨x, hx'A, by rw [hagree ⟨x, hx'A⟩, hy]⟩
      · rintro ⟨a, ha, hay⟩
        have hyσ : y = (((σ ⟨a, ha⟩ : A')) : L) := by
          apply e.injective
          rw [← hay, hagree ⟨a, ha⟩]
        have hxa : x = a := by
          refine le_antisymm ?_ ?_
          · exact not_lt.mp (fun h => absurd (hyσ ▸ (hcut.1 ⟨a, ha⟩).mp h) (lt_irrefl y))
          · exact not_lt.mp (fun h => absurd (hyσ ▸ (hcut.2 ⟨a, ha⟩).mp h) (lt_irrefl y))
        exact ⟨a, ha, by rw [hxa]⟩
  -- ### 6. the reduct cross-checks for `cdt_reduct`
  have hCR : ∀ {n} (f : Language.ring.Functions n) (x : Fin n → N),
      @Structure.funMap Language.ring N (Ring.CompatibleRing.toStructure (self := CR)) n f x =
        @Structure.funMap LRc N instN n (Sum.inl (Sum.inl f)) x := by
    intro n f x
    rfl
  have hRX : ∀ (x : Fin 1 → N),
      @Structure.funMap rexpL N RX 1 rexpFunc.rexp x =
        @Structure.funMap LRc N instN 1 (Sum.inl (Sum.inr rexpFunc.rexp)) x := by
    intro x
    rfl
  have hCN : ∀ {n} (c : (constantsOn ℝ).Functions n) (x : Fin n → N),
      @Structure.funMap (constantsOn ℝ) N CN n c x =
        @Structure.funMap LRc N instN n (Sum.inr c) x := by
    intro n c x
    rfl
  -- ### 7. the one-model theorem in `N`
  have hv : ∀ i, (fun i => g (w i)) i ∈ (⇑g) '' A := fun i => ⟨w i, (w i).2, rfl⟩
  have key := @cdt_reduct N instN hOM F LO SOR CR RX CN hCR hRX hCN hNTR ((⇑g) '' A) hAdcl
    (g x) (e y) hcutN m ψ (fun i => g (w i)) hv
  -- ### 8. transport back to `K` and `L`
  have hKside : @Formula.Realize LRc K _ (Fin m ⊕ Fin 1) ψ
        (Sum.elim (fun i => (w i : K)) (fun _ => x)) ↔
      @Formula.Realize LRc N instN (Fin m ⊕ Fin 1) ψ
        (Sum.elim (fun i => g (w i)) (fun _ => g x)) := by
    have h := g.map_formula ψ (Sum.elim (fun i => (w i : K)) (fun _ => x))
    rw [show (⇑g ∘ Sum.elim (fun i => (w i : K)) (fun _ => x)) =
      Sum.elim (fun i => g (w i)) (fun _ => g x) from by
        funext j; rcases j with j | j <;> rfl] at h
    exact h.symm
  have hLside : @Formula.Realize LRc N instN (Fin m ⊕ Fin 1) ψ
        (Sum.elim (fun i => g (w i)) (fun _ => e y)) ↔
      @Formula.Realize LRc L _ (Fin m ⊕ Fin 1) ψ
        (Sum.elim (fun i => (σ (w i) : L)) (fun _ => y)) := by
    have h := e.map_formula ψ (Sum.elim (fun i => ((σ (w i) : A') : L)) (fun _ => y))
    rw [show (⇑e ∘ Sum.elim (fun i => ((σ (w i) : A') : L)) (fun _ => y)) =
      Sum.elim (fun i => g (w i)) (fun _ => e y) from by
        funext j; rcases j with j | j
        · exact (hagree (w j)).symm
        · rfl] at h
    exact h
  exact hKside.trans (key.trans hLside)

