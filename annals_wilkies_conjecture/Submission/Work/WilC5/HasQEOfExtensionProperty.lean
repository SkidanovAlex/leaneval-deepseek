/-
  WilC5 — **Sacks' quantifier-elimination test** for an `L`-theory `T`:

  if every embedding `σ : A → N` of an `L`-substructure `A` of a model `M ⊨ T` into a model
  `N ⊨ T` which is `κ`-saturated for some `κ > |M|` extends to an embedding `M → N`, then `T`
  admits quantifier elimination (van den Dries–Macintyre–Marker, Corollary 4.5, quoting
  [15] = Sacks, *Saturated Model Theory*).

  The proof has two ingredients.

  * `realize_goodEmb`: **every embedding into a sufficiently saturated model is elementary.**  If
    `M, N ⊨ T`, `N` is `κ`-saturated with `κ > |M|` and `f : M ↪ N`, then `f` preserves and
    reflects every formula.  This is an induction on the formula; the only non-trivial step is
    `∀`.  Given `M ⊨ ∀x ψ(x, a)` and `y ∈ N`, one takes a saturated elementary extension `P` of
    `M` (`ExistsSaturated`), uses the extension property to extend
    `f⁻¹ : f(M) → M ⊆ P` to an embedding `h : N → P` (so `h(f m) = e m`), applies the induction
    hypothesis to `h` at the element `y`, and evaluates the `∀`-formula of `M` in `P` at `h y`.
  * `qfType_determines`: consequently the quantifier-free type of a tuple determines its full
    type: two tuples of models of `T` with the same quantifier-free type have the same type.  The
    quantifier-free type match gives an embedding of the substructure generated by the first tuple
    (`ExistsEmbeddingTupleSub`); extending it along the whole of the first model into a saturated
    elementary extension of the second and using `realize_goodEmb` transfers all formulas.

  Quantifier elimination itself then follows by compactness
  (`HasQEOfQfTypeDetermines`).
-/
import Mathlib
import Submission.Work.WilC5.Saturation
import Submission.Work.WilC5.ExistsSaturated
import Submission.Work.WilC5.QE
import Submission.Work.WilC5.ExtQE
import Submission.Work.WilC5.ExistsEmbeddingTupleSub
import Submission.Work.WilC5.HasQEOfQfTypeDetermines

set_option autoImplicit false
set_option linter.style.haveILetI false
noncomputable section
open Classical
namespace Work.WilC5

open FirstOrder Language
open scoped FirstOrder

variable {L : FirstOrder.Language.{0, 0}} {T : L.Theory}

/-- **Every embedding into a `κ`-saturated model of `T` (with `κ > |M|`) is elementary.**

Let `M, N ⊨ T`, let `N` be `κ`-saturated with `Cardinal.mk M < κ` and let `f : M ↪ N` be an
embedding.  Then for every bounded formula `ψ` and every assignment of its free variables in `M`,
`ψ` holds at the image under `f` if and only if it holds at the original assignment.

The proof is an induction on `ψ`; the `∀`-step is where saturation is used (see the module
comment). -/
theorem realize_goodEmb (hext : HasExtProp L T) :
    ∀ {α : Type} {n : ℕ} (ψ : L.BoundedFormula α n)
      {M N : Type} [L.Structure M] [L.Structure N]
      (hM : M ⊨ T) (hN : N ⊨ T) {κ : Cardinal.{0}} (hκ : Cardinal.mk M < κ)
      (hsat : @IsSaturated L N _ κ) (f : L.Embedding M N) (v : α → M) (xs : Fin n → M),
      ψ.Realize (f ∘ v) (f ∘ xs) ↔ ψ.Realize v xs := by
  intro α n ψ
  induction ψ with
  | falsum =>
    intro M N _ _ hM hN κ hκ hsat f v xs
    exact Iff.rfl
  | equal t₁ t₂ =>
    intro M N _ _ hM hN κ hκ hsat f v xs
    exact BoundedFormula.IsQF.realize_embedding
      (BoundedFormula.IsQF.of_isAtomic (BoundedFormula.IsAtomic.equal t₁ t₂)) f
  | rel R ts =>
    intro M N _ _ hM hN κ hκ hsat f v xs
    exact BoundedFormula.IsQF.realize_embedding
      (BoundedFormula.IsQF.of_isAtomic (BoundedFormula.IsAtomic.rel R ts)) f
  | imp φ ψ ihφ ihψ =>
    intro M N _ _ hM hN κ hκ hsat f v xs
    rw [BoundedFormula.realize_imp, BoundedFormula.realize_imp]
    exact Iff.imp (ihφ hM hN hκ hsat f v xs) (ihψ hM hN hκ hsat f v xs)
  | all φ ih =>
    intro M N _ _ hM hN κ hκ hsat f v xs
    constructor
    · -- from the truth in `N` to the truth in `M`
      intro hv
      rw [BoundedFormula.realize_all] at hv ⊢
      intro m
      refine (ih hM hN hκ hsat f v (Fin.snoc xs m)).mp ?_
      rw [Fin.comp_snoc]
      exact hv (f m)
    · -- from the truth in `M` to the truth in `N`: this is where saturation enters
      intro hv
      rw [BoundedFormula.realize_all] at hv ⊢
      intro a
      -- a `κ'`-saturated elementary extension `P` of `M`, with `κ' > |N|`
      obtain ⟨P, instP, e, hsatP⟩ := ExistsSaturated (L := L) M (2 ^ Cardinal.mk N)
      letI : L.Structure P := instP
      have hP : P ⊨ T := (e.theory_model_iff T).mp hM
      -- the restriction of `e` to the range of `f` (i.e. `e ∘ f⁻¹`)
      let σ : L.Embedding ↥(f.toHom.range) P :=
        (e.toEmbedding).comp (f.equivRange.symm).toEmbedding
      have hσ : ∀ m : M, σ ⟨f m, (Hom.mem_range).mpr ⟨m, rfl⟩⟩ = e m := by
        intro m
        have h1 : f.equivRange m = ⟨f m, (Hom.mem_range).mpr ⟨m, rfl⟩⟩ :=
          Subtype.ext (Embedding.equivRange_apply f m)
        change e (f.equivRange.symm ⟨f m, (Hom.mem_range).mpr ⟨m, rfl⟩⟩) = e m
        rw [← h1]
        exact congrArg e (Language.Equiv.symm_apply_apply (f.equivRange) m)
      -- the extension property extends it to all of `N`
      obtain ⟨h, hh⟩ := hext N P hN hP (2 ^ Cardinal.mk N) (Cardinal.cantor (Cardinal.mk N))
        hsatP (f.toHom.range) σ
      have hhf : ∀ m : M, h (f m) = e m := by
        intro m
        have hmem := hh ⟨f m, (Hom.mem_range).mpr ⟨m, rfl⟩⟩
        rw [hσ m] at hmem
        exact hmem
      -- the induction hypothesis for the body, applied to `h` and the witness `a`
      have hIH := ih (M := N) (N := P) hN hP (κ := 2 ^ Cardinal.mk N)
        (Cardinal.cantor (Cardinal.mk N)) hsatP h (f ∘ v) (Fin.snoc (f ∘ xs) a)
      refine hIH.mp ?_
      have hcomp1 : (h ∘ (f ∘ v)) = (e ∘ v) := funext fun i => hhf (v i)
      have hcomp2 : (h ∘ (Fin.snoc (f ∘ xs) a)) = Fin.snoc (e ∘ xs) (h a) := by
        rw [Fin.comp_snoc]
        congr 1
        funext i
        exact hhf (xs i)
      rw [hcomp1, hcomp2]
      -- evaluate the `∀`-formula of `M` in `P` at `h a`
      have hforall : (BoundedFormula.all φ).Realize (e ∘ v) (e ∘ xs) :=
        (e.map_boundedFormula (BoundedFormula.all φ) v xs).mpr
          ((BoundedFormula.realize_all (M := M) (θ := φ) (v := v) (xs := xs)).mpr hv)
      exact (BoundedFormula.realize_all (M := P) (θ := φ) (v := e ∘ v)
        (xs := e ∘ xs)).mp hforall (h a)

/-- **The quantifier-free type of a tuple determines its type.**  If two tuples of models of `T`
satisfy the same quantifier-free formulas, then they satisfy the same formulas. -/
theorem qfType_determines (hext : HasExtProp L T) {n : ℕ} {M N : Type} [L.Structure M]
    [L.Structure N] (hM : M ⊨ T) (hN : N ⊨ T) (v : Fin n → M) (w : Fin n → N)
    (h : IsQFEqv (L := L) v w) :
    ∀ ψ : L.Formula (Fin n), (Formula.Realize ψ v ↔ Formula.Realize ψ w) := by
  intro ψ
  -- a saturated elementary extension `N'` of `N`, above `|M|`
  obtain ⟨N', instN', e, hsatN'⟩ := ExistsSaturated (L := L) N (2 ^ Cardinal.mk M)
  letI : L.Structure N' := instN'
  have hN' : N' ⊨ T := (e.theory_model_iff T).mp hN
  -- the quantifier-free type of `v` matches that of the image of `w`
  have h' : IsQFEqv (L := L) v (fun i => e (w i)) :=
    fun θ hθ => (h θ hθ).trans (e.map_formula θ w).symm
  -- hence an embedding of the substructure generated by `v` into `N'`
  obtain ⟨σ, hσ⟩ := ExistsEmbeddingTupleSub (L := L) v (fun i => e (w i)) h'
  -- which the extension property extends to an embedding of all of `M`
  obtain ⟨g, hg⟩ := hext M N' hM hN' (2 ^ Cardinal.mk M) (Cardinal.cantor (Cardinal.mk M))
    hsatN' (tupleSub (L := L) v) σ
  have hgv : (g ∘ v) = (fun i => e (w i)) := by
    funext i
    have h1 := hg (⟨v i, tupleSub_mem_var v i⟩ : ↥(tupleSub (L := L) v))
    rw [hσ i] at h1
    exact h1
  -- `g` is elementary, and `e` is elementary, so the types agree
  have h2 : BoundedFormula.Realize ψ (g ∘ v) (g ∘ (default : Fin 0 → M)) ↔
      BoundedFormula.Realize ψ v (default : Fin 0 → M) :=
    realize_goodEmb hext ψ hM hN' (Cardinal.cantor (Cardinal.mk M)) hsatN' g v
      (default : Fin 0 → M)
  have hxs : (g ∘ (default : Fin 0 → M)) = (default : Fin 0 → N') := by
    funext i
    exact i.elim0
  rw [hxs] at h2
  rw [hgv] at h2
  exact h2.symm.trans (e.map_formula ψ w)

theorem HasQEOfExtensionProperty {L : FirstOrder.Language.{0, 0}} (T : L.Theory)
    (hext : ∀ (M N : Type) [L.Structure M] [L.Structure N],
      FirstOrder.Language.Theory.Model M T → FirstOrder.Language.Theory.Model N T →
      ∀ (κ : Cardinal.{0}), Cardinal.mk M < κ →
      @Work.WilC5.IsSaturated L N _ κ →
      ∀ (A : L.Substructure M) (σ : FirstOrder.Language.Embedding L A N),
        ∃ g : FirstOrder.Language.Embedding L M N, ∀ a : A, g a = σ a) :
    Work.WilC5.HasQE T :=
  HasQEOfQfTypeDetermines (L := L) T
    (fun {n} M N _ _ hM hN v w h => qfType_determines hext hM hN v w h)

end Work.WilC5
