/-
  WilC5 / S4Exp — **the value containment for the one-element extension `A ↦ A(exp a)`**
  (vdDMM §3, the value-theoretic input of Lemma 4.3).

  Situation: `K ⊨ TR`, `A ⊆ K` is `Dcl`-closed (with `A = S` the carrier of an elementary
  substructure), `a ∈ A`, `expE a ∉ A` and the value of `y := expE a` is *new* over `A`
  (the hypothesis `hynew`).  For an element `w ≠ 0` of the definable closure
  `Dcl (A ∪ {y})` — i.e. of the submodel generated by `A` and `y` — the value of `w` lies in
  the `ℚ`-span of `v(A^×)` and `v(y)` (vdDMM (3.7)), which is exactly the assertion

      `w ^ Q = z · y ^ N · (1 + ε)`,   `Q > 0`, `z ∈ A \ {0}`, `ε` infinitesimal.

  The proof has the following shape.

  * `Work.WilC5.valIneq_span` (a direct consequence of the frozen `hVI`, Wilkie's valuation
    inequality) produces an integer relation `IsUnitVal (c · w ^ q · y ^ n)` with `q ≠ 0` and
    `c ∈ A \ {0}`; in value-group notation this reads `q · v(w) = -v(c) - n · v(y)`.
  * Writing it as a statement about *archimedean classes* — `Work.WilC5.SameArch` — gives
    `SameArch (w ^ q) (c⁻¹ · y ^ (-n))` (`sameArch_zpow_of_unitVal` below); inverting it
    exchanges the sign of `q` and of the exponent of `y`.
  * `Work.WilC5.decomposition_of_same_value` (the standard part of the valuation, vdDMM
    Lemma 4.2) then writes the two elements that have the same value as
    `(realConst r · …) · (1 + ε)` with `ε` infinitesimal.
  * The `A`-side factor `realConst r · c^{±1}` is in `A`: `c^{±1} ∈ A` because `A` is closed
    under the `LRc`-definable operations, and every real constant is `LRc`-definable without
    parameters (`realConst_mem`, via `term_realize_mem_dcl` and `dclClosed_substructure`).

  The only point that uses `hx : expE a ∉ A` beyond the statement of `hynew` is that it forces
  `expE a ≠ 0`: `0 ∈ A` (a `Dcl`-closed set is closed under the ring operations,
  `Work.WilC5.dcl_ring_closure`).
-/
import Mathlib
import Submission.Work.WilC2.Dcl
import Submission.Work.WilC2.meetsDefinable_dcl
import Submission.Work.WilC2.dcl_exchange
import Submission.Work.WilC5.valIneq_span
import Submission.Work.WilC5.decomposition_of_same_value
import Submission.Work.WilC5.ValuesLemmas
import Submission.Work.WilC5.ValArith
import Submission.Work.WilC4.dcl_inv
import Submission.Work.WilC4.dcl_mul
import Submission.Work.WilC4.dcl_elementary
import Submission.Work.WilC4.definableElt_of_mem_left
import Submission.Work.WilC5.dcl_ring_closure
import Submission.Work.WilC5.dclClosed_substructure

set_option autoImplicit false
noncomputable section
open Classical FirstOrder FirstOrder.Language
namespace Work.WilC5.S4Exp

open WilkiesDesign WilkiesDesign.CG

variable {K : Type} [WilkiesDesign.CG.LEc.Structure K] [Field K] [LinearOrder K]
    [IsStrictOrderedRing K] [FirstOrder.Ring.CompatibleRing K]
    [WilkiesDesign.CG.rexpL.Structure K] [(FirstOrder.Language.constantsOn ℝ).Structure K]
    [FirstOrder.Language.Theory.Model K WilkiesDesign.CG.TR]

/-! ## Auxiliary facts about the `Dcl`-closed set `A` -/

/-- `Work.WilC2.Dcl` (definable closure with the parameter set `A`) is `Work.WilC4`'s
`DefinableElt A ∅`.  This is the bridge between the `Definable₁`-formulation of `Dcl` and the
`Definable`-formulation in which `Work.WilC4` states its closure lemmas (and in which the frozen
`ValIneq` states its definability hypotheses). -/
lemma mem_dcl_iff_definableElt (A : Set K) (x : K) :
    x ∈ (@Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ) A) ↔
      Work.WilC4.DefinableElt A ∅ x := by
  have hset : {v : Fin 1 → K | v 0 ∈ ({x} : Set K)} = {fun _ : Fin 1 => x} := by
    ext v; simp [funext_iff]
  rw [Work.WilC2.mem_dcl, Work.WilC4.DefinableElt, Set.union_empty, Set.Definable₁, hset]

/-- Every real constant `realConst K r` lies in every definable closure: it is the value of the
nullary `LRc`-term of the constant symbol attached to `r`. -/
lemma realConst_mem_dcl (A : Set K) (r : ℝ) :
    (Work.WilC5.realConst K r) ∈
      @Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ) A := by
  have h := Work.WilC5.term_realize_mem_dcl (M := K) (A := A)
    (t := @Language.Functions.term LRc 0 (Sum.inr (r : (constantsOn ℝ).Functions 0) : LRc.Functions 0))
    (x := (Fin.elim0 : Fin 0 → K)) (fun i => i.elim0)
  have ht : (@Language.Functions.term LRc 0 (Sum.inr (r : (constantsOn ℝ).Functions 0) :
        LRc.Functions 0)).realize (Fin.elim0 : Fin 0 → K) = Work.WilC5.realConst K r := by
    simp only [Language.Functions.term, Term.realize_func, Term.realize_var,
      Work.WilC5.realConst, Work.WilC5.lrcConstReduct_funMap]
    rfl
  rwa [ht] at h

/-- Every real constant lies in a `Dcl`-closed set. -/
lemma realConst_mem (A : Set K) (r : ℝ)
    (hAdcl : @Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ) A ⊆ A) :
    (Work.WilC5.realConst K r) ∈ A :=
  hAdcl (realConst_mem_dcl A r)

/-- A `Dcl`-closed set is closed under multiplication. -/
lemma mul_mem_A (A : Set K)
    (hAdcl : @Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ) A ⊆ A)
    {x y : K} (hx : x ∈ A) (hy : y ∈ A) : x * y ∈ A :=
  hAdcl ((mem_dcl_iff_definableElt A (x*y)).mpr
    (Work.WilC4.dcl_mul (Work.WilC4.definableElt_of_mem_left A ∅ hx)
      (Work.WilC4.definableElt_of_mem_left A ∅ hy)))

/-- A `Dcl`-closed set is closed under inversion of its nonzero elements. -/
lemma inv_mem_A (A : Set K)
    (hAdcl : @Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ) A ⊆ A)
    {x : K} (hx : x ∈ A) (hx0 : x ≠ 0) : x⁻¹ ∈ A :=
  hAdcl ((mem_dcl_iff_definableElt A x⁻¹).mpr
    (Work.WilC4.dcl_inv (Work.WilC4.definableElt_of_mem_left A ∅ hx) hx0))

/-- **The value relation read off an integer relation.**  If `c · u · y ^ n` is a unit of the
standard real valuation (`c ≠ 0`, `y ≠ 0`), then `u` and `c⁻¹ · y ^ (-n)` have the same value:
in value-group notation `v(u) + v(c) + n · v(y) = 0`, i.e. `v(u) = -v(c) - n · v(y)`. -/
lemma sameArch_zpow_of_unitVal {c y u : K} (hc : c ≠ 0) (hy : y ≠ 0) {n : ℤ}
    (h : WilkiesDesign.CG.IsUnitVal (c * u * y ^ n)) :
    Work.WilC5.SameArch u (c⁻¹ * y ^ (-n)) := by
  have hz : c⁻¹ * y ^ (-n) ≠ 0 := mul_ne_zero (inv_ne_zero hc) (zpow_ne_zero _ hy)
  rw [Work.WilC5.SameArch_iff_IsUnitVal_div hz]
  have key : u / (c⁻¹ * y ^ (-n)) = c * u * y ^ n := by
    rw [div_eq_mul_inv, mul_inv_rev, inv_inv, ← inv_zpow, inv_zpow', neg_neg]
    ring
  rw [key]
  exact h

/-! ## The value containment -/

theorem va_exp {K : Type} [WilkiesDesign.CG.LEc.Structure K] [Field K] [LinearOrder K]
    [IsStrictOrderedRing K] [FirstOrder.Ring.CompatibleRing K]
    [WilkiesDesign.CG.rexpL.Structure K] [(FirstOrder.Language.constantsOn ℝ).Structure K]
    [FirstOrder.Language.Theory.Model K WilkiesDesign.CG.TR]
    (hVI : WilkiesDesign.CG.ValIneq)
    (A : Set K)
    (hAdcl : @Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ) A ⊆ A)
    (S : WilkiesDesign.CG.LRc.ElementarySubstructure K) (hS : (S : Set K) = A)
    (a : K) (ha : a ∈ A) (hx : Work.WilC5.expE a ∉ A)
    (hynew : ∀ c ∈ A, c ≠ 0 → ¬ WilkiesDesign.CG.IsUnitVal (c * Work.WilC5.expE a))
    (w : K)
    (hw : w ∈ @Work.WilC2.Dcl K (WilkiesDesign.CG.LR.withConstantsStructure ℝ)
      (A ∪ {Work.WilC5.expE a}))
    (hw0 : w ≠ 0) :
    ∃ Q : ℤ, 0 < Q ∧ ∃ N : ℤ, ∃ z ∈ A, z ≠ 0 ∧ ∃ ε : K, Work.WilC5.IsInfinitesimal ε ∧
      w ^ Q = z * (Work.WilC5.expE a) ^ N * (1 + ε) := by
  classical
  -- `0 ∈ A`, hence `expE a ≠ 0`.
  have h0A : (0 : K) ∈ A := (Work.WilC5.dcl_ring_closure (M := K) (A := A) hAdcl).1
  have hy0 : Work.WilC5.expE a ≠ 0 := by
    intro h; exact hx (h ▸ h0A)
  -- `w` is definable from the parameters `S ∪ {expE a}`.
  have hbdef : ((S : Set K) ∪ {Work.WilC5.expE a}).Definable LRc {fun _ : Fin 1 => w} := by
    have h1 : Work.WilC4.DefinableElt (A ∪ {Work.WilC5.expE a}) ∅ w :=
      (mem_dcl_iff_definableElt (A ∪ {Work.WilC5.expE a}) w).mp hw
    have h2 : (A ∪ {Work.WilC5.expE a}).Definable LRc {fun _ : Fin 1 => w} := by
      simpa [Work.WilC4.DefinableElt, Set.union_empty] using h1
    rwa [hS]
  -- the value of `expE a` is new over `S`
  have hynew' : ∀ c ∈ (S : Set K), c ≠ 0 →
      ¬ WilkiesDesign.CG.IsUnitVal (c * Work.WilC5.expE a) := by
    rw [hS]; exact hynew
  -- Wilkie's inequality: an integer relation between `v w` and `v (expE a)` over `v(A^×)`.
  obtain ⟨q, hqne, n, c, hcS, hc0, hunit⟩ :=
    Work.WilC5.valIneq_span (M := K) hVI S hy0 hw0 hbdef hynew'
  have hcA : c ∈ A := by rw [← hS]; exact hcS
  have hSA : Work.WilC5.SameArch (w ^ q) (c⁻¹ * (Work.WilC5.expE a) ^ (-n)) :=
    sameArch_zpow_of_unitVal (K := K) hc0 hy0 hunit
  rcases lt_trichotomy q 0 with hqlt | hqeq | hqgt
  · -- `q < 0`: invert the relation, `Q := -q`, `N := n`, `z := realConst r · c`.
    have h1 : (w ^ q)⁻¹ = w ^ (-q) := by rw [← inv_zpow, inv_zpow']
    have h2 : (c⁻¹ * (Work.WilC5.expE a) ^ (-n))⁻¹ = c * (Work.WilC5.expE a) ^ n := by
      rw [mul_inv_rev, inv_inv, ← inv_zpow, inv_zpow', neg_neg]
      exact mul_comm _ _
    have hSA' : Work.WilC5.SameArch (w ^ (-q)) (c * (Work.WilC5.expE a) ^ n) := by
      have h := Work.WilC5.SameArch_inv hSA
      rwa [h1, h2] at h
    have hz0 : c * (Work.WilC5.expE a) ^ n ≠ 0 := mul_ne_zero hc0 (zpow_ne_zero _ hy0)
    obtain ⟨r, hrne, ε, hε, heq⟩ :=
      Work.WilC5.decomposition_of_same_value (M := K) hz0 hSA'
    refine ⟨-q, by omega, n, Work.WilC5.realConst K r * c, ?_, ?_, ε, hε, ?_⟩
    · exact mul_mem_A A hAdcl (realConst_mem A r hAdcl) hcA
    · exact mul_ne_zero (Work.WilC5.realConst_ne_zero hrne) hc0
    · rw [heq]; ring
  · exact absurd hqeq hqne
  · -- `q > 0`: the relation itself, `Q := q`, `N := -n`, `z := realConst r · c⁻¹`.
    have hz0 : c⁻¹ * (Work.WilC5.expE a) ^ (-n) ≠ 0 :=
      mul_ne_zero (inv_ne_zero hc0) (zpow_ne_zero _ hy0)
    obtain ⟨r, hrne, ε, hε, heq⟩ :=
      Work.WilC5.decomposition_of_same_value (M := K) hz0 hSA
    refine ⟨q, hqgt, -n, Work.WilC5.realConst K r * c⁻¹, ?_, ?_, ε, hε, ?_⟩
    · exact mul_mem_A A hAdcl (realConst_mem A r hAdcl) (inv_mem_A A hAdcl hcA hc0)
    · exact mul_ne_zero (Work.WilC5.realConst_ne_zero hrne) (inv_ne_zero hc0)
    · rw [heq]; ring

end Work.WilC5.S4Exp
