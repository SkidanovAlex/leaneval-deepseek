/-
  WilC5 — extending an embedding to the substructure generated by adjoining one point of the
  same type.

  This is the "one-point extension" step of the extension property: if `σ : F → N` is an
  embedding of the substructure `F ⊆ M` and `x : M`, `y : N` have the same type over the
  parameters `F` (hypothesis `htype`: they satisfy the same formulas, with the parameters of `F`
  interpreted by `σ`), then `σ` extends to the substructure generated by `F ∪ {x}`.

  The mathematical content is that every element of `closure L (F ∪ {x})` is the value of a term
  in the parameters `F` and the single extra variable `x`, and that `htype` (applied to the
  formulas saying that two such terms have equal values) makes the assignment
  `t(x, params) ↦ t(y, σ params)` well defined and an embedding.  The formal work is done by
  `Work.WilC5.ExistsEmbeddingTupleSub` (the tuple `v = (F ⊕ Fin 1 → M)` collecting all parameters
  and `x`), together with the identification `tupleSub v = closure L (F ∪ {x})`.
-/
import Mathlib
import Submission.Work.WilC5.ExistsEmbeddingTupleSub

namespace Work.WilC5

open FirstOrder Language
open scoped FirstOrder

theorem exists_embedding_closure_of_same_type {L : FirstOrder.Language.{0, 0}} {M N : Type}
    [L.Structure M] [L.Structure N] (F : L.Substructure M) (σ : L.Embedding F N) (x : M) (y : N)
    (htype : ∀ {n : ℕ} (φ : L.Formula (F ⊕ Fin (n + 1))) (v : Fin n → F),
      φ.Realize (Sum.elim Subtype.val (Fin.cons x (fun i => (v i : M)))) ↔
        φ.Realize (Sum.elim (fun f : F => (σ f : N))
          (Fin.cons y (fun i => (σ (v i) : N))))) :
    ∃ σ' : L.Embedding (FirstOrder.Language.Substructure.closure L ((F : Set M) ∪ {x})) N,
      ∀ f : F,
        σ' ⟨f, FirstOrder.Language.Substructure.subset_closure (Or.inl f.2)⟩ = σ f := by
  classical
  -- the tuple of all parameters together with the extra point
  set v : F ⊕ Fin 1 → M := Sum.elim (fun f : F => (f : M)) (fun _ => x) with hv
  set w : F ⊕ Fin 1 → N := Sum.elim (fun f : F => (σ f : N)) (fun _ => y) with hw
  -- `v` and `w` have the same quantifier-free type, by the hypothesis (at `n = 0`)
  have hqf : IsQFEqv (L := L) v w := by
    intro θ _
    have h := htype (n := 0) θ (fun i : Fin 0 => Fin.elim0 i)
    have e1 : (Sum.elim Subtype.val
        (Fin.cons x (fun i : Fin 0 => (((i.elim0 : F) : M))))) = v := by
      rw [hv]
      congr 1
      funext j
      fin_cases j
      simp
    have e2 : (Sum.elim (fun f : F => (σ f : N))
        (Fin.cons y (fun i : Fin 0 => (σ i.elim0 : N)))) = w := by
      rw [hw]
      congr 1
      funext j
      fin_cases j
      simp
    rw [e1, e2] at h
    exact h
  obtain ⟨σ₀, hσ₀⟩ := ExistsEmbeddingTupleSub (L := L) v w hqf
  -- the tuple substructure is the closure of `F ∪ {x}`
  have hle : FirstOrder.Language.Substructure.closure L ((F : Set M) ∪ {x}) ≤ tupleSub v := by
    rw [Substructure.closure_le]
    intro u hu
    rcases hu with hF | hx
    · have hmem := tupleSub_mem_var (L := L) v (Sum.inl ⟨u, hF⟩)
      simpa [hv] using hmem
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      have hmem := tupleSub_mem_var (L := L) v (Sum.inr 0)
      simpa [hv] using hmem
  refine ⟨Embedding.comp σ₀ (Substructure.inclusion hle), ?_⟩
  intro f
  have h1 : (Substructure.inclusion hle
        ⟨f, FirstOrder.Language.Substructure.subset_closure (Or.inl f.2)⟩ : ↥(tupleSub v))
      = ⟨v (Sum.inl f), tupleSub_mem_var v (Sum.inl f)⟩ := by
    apply Subtype.ext
    simp [Substructure.coe_inclusion, Set.inclusion, hv]
  rw [Embedding.comp_apply, h1, hσ₀ (Sum.inl f)]
  simp [hw]

end Work.WilC5
