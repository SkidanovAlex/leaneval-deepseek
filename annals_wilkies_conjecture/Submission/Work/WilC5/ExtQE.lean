/-
  WilC5 — definitions for the quantifier-elimination test
  `Work.WilC5.HasQEOfExtensionProperty` (Sacks' test, quoted in vdDMM's Corollary 4.5).

  The test is: if every embedding of a substructure `A ⊆ M` of a model `M ⊨ T` into a
  `κ`-saturated model `N ⊨ T` with `κ > |M|` extends to an embedding `M → N`, then `T` has
  quantifier elimination.

  This module holds the vocabulary shared by the pieces of the proof:

  * `HasExtProp L T` — the extension property above (the hypothesis of the test);
  * `IsQFEqv v w` — the tuples `v`, `w` have the same quantifier-free type;
  * `tupleSub v` — the substructure generated by the values of a tuple `v` (the elements are the
    realizations of `L`-terms in `v`), together with the membership lemmas
    `mem_tupleSub` and `tupleSub_mem_var`.
-/
import Mathlib
import Submission.Work.WilC5.Saturation
import Submission.Work.WilC5.QE

set_option autoImplicit false
noncomputable section
open Classical
namespace Work.WilC5

open FirstOrder Language

/-- **The extension property** of a theory `T` (Sacks' quantifier-elimination test): every
embedding `σ : A → N` of an `L`-substructure `A` of a model `M ⊨ T` into a model `N ⊨ T` which is
`κ`-saturated for some `κ > |M|` extends to an embedding `M → N`. -/
def HasExtProp (L : FirstOrder.Language.{0, 0}) (T : L.Theory) : Prop :=
  ∀ (M N : Type) [L.Structure M] [L.Structure N],
    FirstOrder.Language.Theory.Model M T → FirstOrder.Language.Theory.Model N T →
    ∀ (κ : Cardinal.{0}), Cardinal.mk M < κ →
    @Work.WilC5.IsSaturated L N _ κ →
    ∀ (A : L.Substructure M) (σ : FirstOrder.Language.Embedding L A N),
      ∃ g : FirstOrder.Language.Embedding L M N, ∀ a : A, g a = σ a

/-- **Same quantifier-free type.**  Two tuples (in possibly different structures of the same
language) have the same quantifier-free type when they satisfy the same quantifier-free formulas. -/
def IsQFEqv {L : FirstOrder.Language} {α : Type} {M : Type} {N : Type}
    [L.Structure M] [L.Structure N] (v : α → M) (w : α → N) : Prop :=
  ∀ θ : L.Formula α, FirstOrder.Language.BoundedFormula.IsQF θ →
    (FirstOrder.Language.Formula.Realize θ v ↔ FirstOrder.Language.Formula.Realize θ w)

/-- **The substructure generated by the values of a tuple.**  Its elements are the values of the
terms of `L` in the tuple `v`; this is a substructure because the value of `f (t₀, …, tₙ₋₁)` is
the value of the term `f t₀ … tₙ₋₁`. -/
def tupleSub {L : FirstOrder.Language} {α : Type} {M : Type} [L.Structure M] (v : α → M) :
    L.Substructure M :=
  Substructure.mk {x | ∃ t : L.Term α, Term.realize v t = x} (by
    intro n f x hx
    choose t ht using hx
    refine ⟨Term.func f t, ?_⟩
    rw [Term.realize_func]
    exact congrArg (Structure.funMap f) (funext fun i => ht i))

@[simp]
theorem mem_tupleSub {L : FirstOrder.Language} {α : Type} {M : Type} [L.Structure M]
    (v : α → M) (x : M) : x ∈ (tupleSub v : L.Substructure M) ↔ ∃ t : L.Term α, Term.realize v t = x :=
  Iff.rfl

/-- The values of the tuple lie in the substructure generated by them. -/
theorem tupleSub_mem_var {L : FirstOrder.Language} {α : Type} {M : Type} [L.Structure M]
    (v : α → M) (i : α) : v i ∈ (tupleSub v : L.Substructure M) :=
  ⟨Term.var i, Term.realize_var v i⟩

end Work.WilC5
