import Mathlib
import Submission.Work.WilC5.SatSetup
import Submission.Work.WilC5.SatBuild
import Submission.Work.WilC5.SatCore
import Submission.Work.WilC5.SatHull

/-
  WilC5 — the term hull is the union of the level hulls.

  `SatHull N` is the `L`-substructure of `N` generated by the values of *all* the constants of
  `L[[SatCTotal]]`, and `SatHullLev N z` is the `L`-substructure generated by the values of the
  constants of level `z` only.  Since every constant has a birth level, the generating sets of the
  `SatHullLev N z` exhaust the generating set of `SatHull N`, whence `SatHull N` is the supremum of
  the increasing chain `SatHullLev N z`.

  The family `z ↦ SatHullLev N z` is directed (it is increasing in `z`, and `SatIdx κ` is
  linearly ordered), so membership in its supremum is membership in one of its members
  (`Substructure.mem_iSup_of_directed`).
-/

open FirstOrder Language
open scoped FirstOrder

set_option autoImplicit false
noncomputable section
open Classical

namespace Work.WilC5

theorem SatHullEqIUnion {L : FirstOrder.Language.{0, 0}} {M : Type} [instM : L.Structure M]
    {κ : Cardinal.{0}} (N : Type)
    [instN : (FirstOrder.Language.withConstants L (SatCTotal L M κ)).Structure N] (a : N) :
    a ∈ (SatHull L M κ N : Set N) ↔ ∃ z : SatIdx κ, a ∈ (SatHullLev L M κ N z : Set N) := by
  -- `SatIdx κ` is the type of ordinals below a nonzero ordinal, hence nonempty.
  haveI : Nonempty (SatIdx κ) := by
    rw [SatIdx]
    refine Cardinal.nonempty_ord_toType ?_
    have hle : Cardinal.aleph0 ≤ Order.succ (Order.succ (κ + Cardinal.aleph0)) :=
      le_trans (le_trans (self_le_add_left _ _) (Order.le_succ _)) (Order.le_succ _)
    exact fun h => Cardinal.aleph0_pos.not_ge (h ▸ hle)
  -- The `L`-structure on `N` used throughout is the reduct of the `L[[SatCTotal]]`-structure;
  -- making it a local instance lets the substructure lattice operations below elaborate.
  letI : L.Structure N := SatReduct L M κ N
  -- The level hulls increase with the level.
  have hmono : ∀ {y z : SatIdx κ}, y ≤ z → SatHullLev L M κ N y ≤ SatHullLev L M κ N z := by
    intro y z h
    unfold SatHullLev
    refine FirstOrder.Language.Substructure.closure_mono ?_
    rintro b ⟨c, rfl⟩
    exact ⟨SatInc L M κ h c,
      congrArg (fun x => @SatConVal L (SatCt L M κ) N instN x)
        (congrFun (SatIncTotal_comp L M κ h) c)⟩
  -- Hence the family is directed, `SatIdx κ` being linearly ordered.
  have hdir : Directed (· ≤ ·) (fun z : SatIdx κ => SatHullLev L M κ N z) := by
    intro i j
    rcases le_total i j with hij | hij
    · exact ⟨j, hmono hij, le_refl _⟩
    · exact ⟨i, le_refl _, hmono hij⟩
  -- `SatHull` is the supremum of the level hulls.
  have hEq : SatHull L M κ N = ⨆ z, SatHullLev L M κ N z := by
    refine le_antisymm ?_ ?_
    · -- Every constant value lies in some level hull: the seed constants at any level, and the
      -- constant created at level `u` at level `succ u`.
      unfold SatHull
      rw [FirstOrder.Language.Substructure.closure_le]
      rintro b ⟨c, rfl⟩
      cases c with
      | inl m =>
        refine (FirstOrder.Language.Substructure.mem_iSup_of_directed hdir).mpr
          ⟨Classical.choice (inferInstance : Nonempty (SatIdx κ)), ?_⟩
        exact FirstOrder.Language.Substructure.subset_closure ⟨Sum.inl m, rfl⟩
      | inr p =>
        obtain ⟨u, a⟩ := p
        refine (FirstOrder.Language.Substructure.mem_iSup_of_directed hdir).mpr
          ⟨Order.succ u, ?_⟩
        exact FirstOrder.Language.Substructure.subset_closure
          ⟨Sum.inr ⟨⟨u, Order.lt_succ u⟩, a⟩, rfl⟩
    · -- Every level hull is contained in the term hull.
      refine iSup_le fun z => ?_
      unfold SatHullLev
      rw [FirstOrder.Language.Substructure.closure_le]
      rintro b ⟨c, rfl⟩
      exact FirstOrder.Language.Substructure.subset_closure ⟨SatIncTotal L M κ z c, rfl⟩
  rw [hEq]
  exact FirstOrder.Language.Substructure.mem_iSup_of_directed hdir

end Work.WilC5
