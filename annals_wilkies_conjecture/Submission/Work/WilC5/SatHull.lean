/-
  WilC5 — the term hull of a model of the total theory.

  Let `N` be a model of `SatTot` (the union of the images of the level theories `SatTh3 x`).  The
  *term hull* `SatHull N` is the `L`-substructure of `N` generated by the values of all the
  constants of `L[[SatCTotal]]`; every one of its elements is therefore the value of a closed term
  of `L[[SatCTotal]]`.  It is the carrier of the `κ`-saturated elementary extension of `M`.

  We also define the level-`z` hulls `SatHullLev N z`, generated by the values of the constants of
  level `z` only; `SatHull N` is the union of the `SatHullLev N z`.
-/
import Mathlib
import Submission.Work.WilC5.SatCore
import Submission.Work.WilC5.SatMain
import Submission.Work.WilC5.SatExpansionModel

open FirstOrder Language
open scoped FirstOrder

set_option autoImplicit false
noncomputable section
open Classical

namespace Work.WilC5

variable (L : FirstOrder.Language.{0, 0}) (M : Type) [instM : L.Structure M] (κ : Cardinal.{0})

/-- The total set of constants (abbreviation). -/
abbrev SatCt : Type := SatCTotal L M κ

/-- The total theory: the union of the images of the level theories `SatTh3 x` in the language of
all constants. -/
noncomputable def SatTot : (L[[SatCt L M κ]]).Theory :=
  ⋃ (x : SatIdx κ), (SatLangMap (SatIncTotal L M κ x)).onTheory (SatTh3 L M κ x)

/-- The `L`-reduct of an `L[[SatCTotal]]`-structure. -/
@[instance_reducible]
noncomputable def SatReduct (N : Type) [(L[[SatCt L M κ]]).Structure N] : L.Structure N :=
  SatLeftStruct L (SatCt L M κ) N

/-- The term hull: the `L`-substructure generated by the values of all constants. -/
noncomputable def SatHull (N : Type) [instN : (L[[SatCt L M κ]]).Structure N] :
    @FirstOrder.Language.Substructure L N (SatReduct L M κ N) :=
  letI : L.Structure N := SatReduct L M κ N
  FirstOrder.Language.Substructure.closure L
    (Set.range (fun c : SatCt L M κ => @SatConVal L (SatCt L M κ) N instN c))

/-- The level-`z` part of the term hull: the `L`-substructure generated by the values of the
constants of level `z`. -/
noncomputable def SatHullLev (N : Type) [instN : (L[[SatCt L M κ]]).Structure N] (z : SatIdx κ) :
    @FirstOrder.Language.Substructure L N (SatReduct L M κ N) :=
  letI : L.Structure N := SatReduct L M κ N
  FirstOrder.Language.Substructure.closure L
    (Set.range (fun c : SatC L M κ z =>
      @SatConVal L (SatCt L M κ) N instN (SatIncTotal L M κ z c)))

end Work.WilC5
