/-
  WilC5 — the valuation-theoretic vocabulary of van den Dries–Macintyre–Marker §3 for models of
  `TR`.

  The source works with the **standard real valuation** of an ordered field (their (1.1)): with
  `Fin(K)` the ring of elements bounded by a rational number and `μ(K)` the infinitesimals
  (the maximal ideal), the valuation is the quotient map `K^× → K^×/Un(K)`, so that `v(x) = v(y)`
  exactly when `x` and `y` lie in the same *archimedean class*, and bigger elements have smaller
  value.

  This module fixes that vocabulary, in the typeclass context of the frozen `IsUnitVal`,
  `OMinModels` and `ValIneq` (an ordered field; the `TR`-model hypotheses are added by callers).
  The basic API — that `Un(K)` is exactly the class of `1`, that `SameArch` is an equivalence
  relation on the nonzero elements, and that `VLe` is the associated preorder — is requested from
  the fleet as `Work.WilC5.IsUnitVal_iff_SameArch`, `Work.WilC5.SameArch_equiv` and
  `Work.WilC5.VLe_preorder`; here only the definitions are fixed, so that the extension lemmas
  4.2–4.4 can be stated against a stable vocabulary.

  Implementation notes:
  * everything is expressed with *natural* multipliers, matching the frozen
    `IsUnitVal x = ∃ N : ℕ, ((N : M) + 1)⁻¹ ≤ |x| ∧ |x| ≤ (N : M) + 1`;
  * `SameArch` is the relation `v x = v y`, `VLe x y` is `v x ≤ v y`, and
    `SameArch x y ↔ VLe x y ∧ VLe y x` (for nonzero `x`, `y`).
-/
import Mathlib
import Submission.Work.Wilkies.CG.Spec

set_option autoImplicit false
noncomputable section
open Classical
namespace Work.WilC5

open WilkiesDesign WilkiesDesign.CG

section Values

variable {K : Type} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

/-- **`Fin(K)`**: the elements bounded in absolute value by a natural number (vdDMM (1.1)); this
is the valuation ring of the standard real valuation. -/
def IsFiniteVal (x : K) : Prop := ∃ N : ℕ, |x| ≤ (N : K) + 1

/-- **`μ(K)`**: the infinitesimals, the maximal ideal of the valuation ring of vdDMM (1.1). -/
def IsInfinitesimal (x : K) : Prop := ∀ N : ℕ, |x| ≤ ((N : K) + 1)⁻¹

/-- **Same value** (same archimedean class of vdDMM (1.1)): `v(x) = v(y)`. -/
def SameArch (x y : K) : Prop := ∃ N : ℕ, |x| ≤ ((N : K) + 1) * |y| ∧ |y| ≤ ((N : K) + 1) * |x|

/-- **`v(x) ≤ v(y)`**: `y` is bounded by a natural multiple of `x`; bigger elements have smaller
value, as in vdDMM (1.1). -/
def VLe (x y : K) : Prop := ∃ N : ℕ, |y| ≤ ((N : K) + 1) * |x|

/-- **No new value**: every element of the submodel generated by `F` and `x` has the same value as
some element of `F` — the hypothesis `v(F(x)^×) = v(F^×)` of vdDMM Lemma 4.2. -/
def NoNewValue (F : Set K) (x : K) : Prop :=
  ∀ y : K, SameArch y x → ∃ f ∈ F, SameArch y f

/-- The **cut** that `x` makes in the submodel `F` (vdDMM (3.1)): the pair of sets of elements of
`F` below and above `x`.  o-minimality gives that the type of `x` over a model `F` is determined
by this cut. -/
def CutOf (F : Set K) (x : K) : Set K × Set K := ({f ∈ F | f < x}, {f ∈ F | x < f})

end Values

end Work.WilC5
