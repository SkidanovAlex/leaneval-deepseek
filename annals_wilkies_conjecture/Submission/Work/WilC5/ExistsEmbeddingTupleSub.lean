import Mathlib
import Submission.Work.WilC5.ExtQE

set_option maxHeartbeats 800000

namespace Work.WilC5

open FirstOrder Language

/-- **The tuple map on the substructure generated by a tuple.**

If `v : α → M` and `w : α → N` have the same quantifier-free type (`IsQFEqv v w`), then the map
sending a value `t(v)` of a term `t` in the tuple `v` to the value `t(w)` in the tuple `w` is a
well-defined `L`-embedding of the substructure generated by `v` into `N`, and it sends `v i` to
`w i`. -/
theorem ExistsEmbeddingTupleSub {L : FirstOrder.Language.{0, 0}} {α : Type} {M N : Type}
    [L.Structure M] [L.Structure N] (v : α → M) (w : α → N) (h : Work.WilC5.IsQFEqv (L := L) v w) :
    ∃ σ : FirstOrder.Language.Embedding L (Work.WilC5.tupleSub (L := L) v : L.Substructure M) N,
      ∀ i : α, (σ ⟨v i, Work.WilC5.tupleSub_mem_var v i⟩ : N) = w i := by
  classical
  -- Well-definedness of `t ↦ t(w)` with respect to `t(v)`: the two sides of a term identity
  -- satisfy the same atomic (hence quantifier-free) formula.
  have wf : ∀ t₁ t₂ : L.Term α, Term.realize v t₁ = Term.realize v t₂ →
      Term.realize w t₁ = Term.realize w t₂ := by
    intro t₁ t₂ hvw
    have hqf : BoundedFormula.IsQF (Term.equal t₁ t₂ : L.Formula α) :=
      BoundedFormula.IsQF.of_isAtomic
        (BoundedFormula.IsAtomic.equal (t₁.relabel Sum.inl) (t₂.relabel Sum.inl))
    have hkey : (Term.equal t₁ t₂ : L.Formula α).Realize w :=
      (h (Term.equal t₁ t₂) hqf).mp (by rw [Formula.realize_equal]; exact hvw)
    rwa [Formula.realize_equal] at hkey
  have wf' : ∀ t₁ t₂ : L.Term α, Term.realize w t₁ = Term.realize w t₂ →
      Term.realize v t₁ = Term.realize v t₂ := by
    intro t₁ t₂ hwv
    have hqf : BoundedFormula.IsQF (Term.equal t₁ t₂ : L.Formula α) :=
      BoundedFormula.IsQF.of_isAtomic
        (BoundedFormula.IsAtomic.equal (t₁.relabel Sum.inl) (t₂.relabel Sum.inl))
    have hkey : (Term.equal t₁ t₂ : L.Formula α).Realize v :=
      (h (Term.equal t₁ t₂) hqf).mpr (by rw [Formula.realize_equal]; exact hwv)
    rwa [Formula.realize_equal] at hkey
  -- Relation symbols are respected by the tuple map.
  have relAgree : ∀ {n : ℕ} (r : L.Relations n) (ts : Fin n → L.Term α),
      (Structure.RelMap r (fun i => Term.realize v (ts i)) ↔
       Structure.RelMap r (fun i => Term.realize w (ts i))) := by
    intro n r ts
    have hqf : BoundedFormula.IsQF (Relations.formula r ts) :=
      BoundedFormula.IsQF.of_isAtomic (BoundedFormula.IsAtomic.rel r _)
    have hkey := h (Relations.formula r ts) hqf
    rwa [Formula.realize_rel, Formula.realize_rel] at hkey
  let S : L.Substructure M := Work.WilC5.tupleSub v
  -- A choice of representing term for each element of the generated substructure.
  let rep : S → L.Term α := fun x => Classical.choose ((Work.WilC5.mem_tupleSub v x.1).mp x.2)
  have rep_spec : ∀ x : S, Term.realize v (rep x) = (x : M) :=
    fun x => Classical.choose_spec ((Work.WilC5.mem_tupleSub v x.1).mp x.2)
  let σFun : S → N := fun x => Term.realize w (rep x)
  -- `σFun` is independent of the chosen representing term.
  have hσ : ∀ (x : S) (t : L.Term α), Term.realize v t = (x : M) →
      σFun x = Term.realize w t := by
    intro x t ht
    exact wf (rep x) t (by rw [rep_spec x]; exact ht.symm)
  have hinj : Function.Injective σFun := by
    intro x y hxy
    apply Subtype.ext
    have : Term.realize v (rep x) = Term.realize v (rep y) := wf' (rep x) (rep y) hxy
    rw [rep_spec x, rep_spec y] at this
    exact this
  refine ⟨{ toFun := σFun, inj' := hinj, map_fun' := ?_, map_rel' := ?_ }, ?_⟩
  · -- Preservation of function symbols.
    intro n f x
    let t : Fin n → L.Term α := fun i => rep (x i)
    have ht : ∀ i, Term.realize v (t i) = ((x i : S) : M) := fun i => rep_spec (x i)
    have hval : Term.realize v (Term.func f t) = ((Structure.funMap f x : S) : M) := by
      rw [Term.realize_func]
      exact congrArg (Structure.funMap f) (funext fun i => ht i)
    calc σFun (Structure.funMap f x)
        = Term.realize w (Term.func f t) := hσ _ _ hval
      _ = Structure.funMap f (fun i => Term.realize w (t i)) := Term.realize_func w f t
      _ = Structure.funMap f (σFun ∘ x) :=
            congrArg (Structure.funMap f) (funext fun i => (hσ (x i) (t i) (ht i)).symm)
  · -- Preservation (and reflection) of relation symbols.
    intro n r x
    let t : Fin n → L.Term α := fun i => rep (x i)
    have ht : ∀ i, Term.realize v (t i) = ((x i : S) : M) := fun i => rep_spec (x i)
    have hfun : (fun i => Term.realize w (t i)) = (σFun ∘ x) := by
      funext i
      exact (hσ (x i) (t i) (ht i)).symm
    calc Structure.RelMap r (σFun ∘ x)
        ↔ Structure.RelMap r (fun i => Term.realize w (t i)) :=
          iff_of_eq (congrArg (fun (P : Fin n → N) => Structure.RelMap r P) hfun.symm)
      _ ↔ Structure.RelMap r (fun i => Term.realize v (t i)) := (relAgree r t).symm
      _ ↔ Structure.RelMap r (fun i => ((x i : S) : M)) :=
          iff_of_eq (congrArg (fun (P : Fin n → M) => Structure.RelMap r P) (funext ht))
      _ ↔ Structure.RelMap r x := Iff.rfl
  · -- The map sends each generator `v i` to `w i`.
    intro i
    have hmem : v i ∈ S := by
      change v i ∈ Work.WilC5.tupleSub v
      exact Work.WilC5.tupleSub_mem_var v i
    have key : σFun ⟨v i, hmem⟩ = w i := by
      have hv : Term.realize v (Term.var i : L.Term α) = ((⟨v i, hmem⟩ : S) : M) := by
        rw [Term.realize_var]
      have := hσ ⟨v i, hmem⟩ (Term.var i) hv
      rwa [Term.realize_var] at this
    exact key

end Work.WilC5
