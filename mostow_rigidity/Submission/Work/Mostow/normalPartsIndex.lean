import Mathlib
import Submission.Work.Mostow.geodDeps
import Submission.Work.Mostow.resStd_hom_discrete

namespace Work.Mostow

/-- **Finite index of the "small rotations" subgroup, uniformly in the group.**

The covering of `O(m)` by `F.card` balls of radius `1/8` in the operator norm
(`Work.Mostow.exists_cover_rotations`) gives a uniform bound on the index of the subgroup
generated by the elements of any subgroup `B ≤ O(m)` within `1/4` of the identity: two elements
of `B` whose rotation parts are in the same ball differ by an element of `B` of rotation
displacement `< 1/4`, hence (for the `B`, `A` of the theorem, where such elements lie in `A`)
they lie in the same coset of `A`.  Consequently at most `F.card` cosets occur, and choosing one
representative per cover ball produces the required finite transversal. -/
theorem normalPartsIndex (m : ℕ) (hm : 0 < m)
    (hA1 : Submission.Mostow.POActionProp 1) (hI1 : Submission.Mostow.HypIsometryProp 1)
    (hA : Submission.Mostow.POActionProp (1 + m)) (hI : Submission.Mostow.HypIsometryProp (1 + m)) :
    ∃ J : ℕ, 0 < J ∧
      ∀ (C : Subgroup (LeanEval.Geometry.MostowRigidity.PO (1 + m) 1)),
        IsDiscrete (SetLike.coe C) →
        (∀ c ∈ C, Submission.Mostow.resStd 1 m c = 1) →
        ∀ (B : Subgroup (Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m)),
          (∀ x : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m,
            x ∈ B ↔ ∃ c ∈ C, Submission.Mostow.nrmStd 1 m c = x) →
          ∀ (A : Subgroup (Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m)),
            (∀ x : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m, x ∈ A ↔
              x ∈ Subgroup.closure (Submission.Mostow.nrmStd 1 m ''
                {c : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1 |
                  c ∈ C ∧ Submission.Mostow.rotN (Submission.Mostow.nrmStd 1 m c) ≤ 1 / 4})) →
            ∃ s : Finset (Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m),
              s.card ≤ J ∧ ∀ x ∈ B, ∃ y ∈ s, x * y⁻¹ ∈ A := by
  classical
  obtain ⟨F, hF⟩ := Work.Mostow.exists_cover_rotations (m := m) (1 / 8) (by norm_num)
  have hFne : 0 < F.card := by
    obtain ⟨f, hf, -⟩ := hF (1 : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m)
    exact F.card_pos.mpr ⟨f, hf⟩
  refine ⟨F.card, hFne, ?_⟩
  intro C hdisc htriv B hBdef A hAdef
  have hgen_le : (Submission.Mostow.nrmStd 1 m ''
        {c : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1 |
          c ∈ C ∧ Submission.Mostow.rotN (Submission.Mostow.nrmStd 1 m c) ≤ 1 / 4}) ⊆ B := by
    rintro x ⟨c, ⟨hc, hrot⟩, rfl⟩
    exact (hBdef _).mpr ⟨c, hc, rfl⟩
  have hsmall : ∀ z : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m,
      z ∈ B → Submission.Mostow.rotN z ≤ 1 / 4 → z ∈ A := by
    intro z hz hrot
    obtain ⟨c, hc, hce⟩ := (hBdef z).mp hz
    have hrot' : Submission.Mostow.rotN (Submission.Mostow.nrmStd 1 m c) ≤ 1 / 4 := by
      rw [hce]; exact hrot
    exact (hAdef z).mpr (Subgroup.subset_closure ⟨c, ⟨hc, hrot'⟩, hce⟩)
  let rep : (Submission.Mostow.E m →L[ℝ] Submission.Mostow.E m) →
      (Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m) := fun f =>
    if h : ∃ x : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m,
        x ∈ B ∧ ‖Work.Mostow.opOf x - f‖ < 1 / 8 then Classical.choose h else 1
  refine ⟨F.image rep, ?_, ?_⟩
  · exact le_trans Finset.card_image_le le_rfl
  · intro x hx
    obtain ⟨f, hfF, hfx⟩ := hF x
    have hex : ∃ y : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m,
        y ∈ B ∧ ‖Work.Mostow.opOf y - f‖ < 1 / 8 := ⟨x, hx, hfx⟩
    have hrep : rep f = Classical.choose hex := by
      simp only [rep]
      exact dif_pos hex
    refine ⟨rep f, Finset.mem_image.mpr ⟨f, hfF, rfl⟩, ?_⟩
    rw [hrep]
    have hyB : Classical.choose hex ∈ B := (Classical.choose_spec hex).1
    have hyf : ‖Work.Mostow.opOf (Classical.choose hex) - f‖ < 1 / 8 :=
      (Classical.choose_spec hex).2
    have hclose : ‖Work.Mostow.opOf x - Work.Mostow.opOf (Classical.choose hex)‖ < 1 / 4 := by
      have htri := dist_triangle (Work.Mostow.opOf x) f (Work.Mostow.opOf (Classical.choose hex))
      rw [dist_eq_norm, dist_eq_norm, dist_eq_norm,
        norm_sub_rev f (Work.Mostow.opOf (Classical.choose hex))] at htri
      linarith
    have hrot : Submission.Mostow.rotN (x * (Classical.choose hex)⁻¹) ≤ 1 / 4 := by
      show Work.Mostow.mOf (x * (Classical.choose hex)⁻¹) ≤ 1 / 4
      have h := Work.Mostow.mOf_mul_inv_le x (Classical.choose hex)
      linarith
    exact hsmall _ (B.mul_mem hx (B.inv_mem hyB)) hrot

end Work.Mostow
