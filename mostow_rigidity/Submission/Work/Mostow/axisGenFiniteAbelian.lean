open Submission.Mostow LeanEval.Geometry.MostowRigidity

/-!
# The group generated by the small normal parts is finite abelian

Auxiliary facts about the normal part `nrmStd k m` of an element of the standard stratum
stabiliser `SetStabStd k m` (they are `nrmStd`-counterparts of `rhd_resStd_one`,
`rhd_resStd_inv` of `Submission/Work/Mostow/resStd_hom_discrete.lean`), the conjugation
invariance of `rotN`, and a general group-theoretic statement about closures.
-/

/-- The normal part of the identity is the identity. -/
lemma axisNrmStd_one (m : ℕ) (hA1 : POActionProp 1) (hI1 : HypIsometryProp 1)
    (hA : POActionProp (1 + m)) (hI : HypIsometryProp (1 + m)) :
    nrmStd 1 m (1 : PO (1 + m) 1) = 1 := by
  have h1 : (1 : PO (1 + m) 1) ∈ SetStabStd 1 m := rhd_one_mem_stab 1 m hA
  have e2 : blk 1 m (resStd 1 m 1) (nrmStd 1 m 1)
      = blk 1 m (1 : PO 1 1) (1 : E m ≃ₗᵢ[ℝ] E m) :=
    (rhd_stab_form 1 m hA1 hI1 hA hI h1).symm.trans (blk_hom 1 m hA1 hI1 hA hI).2.1.symm
  exact ((blk_hom 1 m hA1 hI1 hA hI).2.2 _ _ _ _ e2).2

/-- The normal part is compatible with inversion on the stratum stabiliser. -/
lemma axisNrmStd_inv (m : ℕ) (hA1 : POActionProp 1) (hI1 : HypIsometryProp 1)
    (hA : POActionProp (1 + m)) (hI : HypIsometryProp (1 + m))
    {g : PO (1 + m) 1} (hg : g ∈ SetStabStd 1 m) :
    nrmStd 1 m g⁻¹ = (nrmStd 1 m g)⁻¹ := by
  have h := nrmStd_mul m hA1 hI1 hA hI g⁻¹ g (rhd_inv_mem_stab 1 m hA hg) hg
  rw [inv_mul_cancel, axisNrmStd_one m hA1 hI1 hA hI] at h
  exact eq_inv_of_mul_eq_one_left h.symm

/-- The normal part is compatible with conjugation on the stratum stabiliser. -/
lemma axisNrmStd_conj (m : ℕ) (hA1 : POActionProp 1) (hI1 : HypIsometryProp 1)
    (hA : POActionProp (1 + m)) (hI : HypIsometryProp (1 + m))
    {g p : PO (1 + m) 1} (hg : g ∈ SetStabStd 1 m) (hp : p ∈ SetStabStd 1 m) :
    nrmStd 1 m (g * p * g⁻¹) = nrmStd 1 m g * nrmStd 1 m p * (nrmStd 1 m g)⁻¹ := by
  have hgi : g⁻¹ ∈ SetStabStd 1 m := rhd_inv_mem_stab 1 m hA hg
  have h1 : nrmStd 1 m (g * (p * g⁻¹)) = nrmStd 1 m g * nrmStd 1 m (p * g⁻¹) :=
    nrmStd_mul m hA1 hI1 hA hI g (p * g⁻¹) hg (rhd_mul_mem_stab 1 m hA hp hgi)
  have h2 : nrmStd 1 m (p * g⁻¹) = nrmStd 1 m p * (nrmStd 1 m g)⁻¹ := by
    rw [nrmStd_mul m hA1 hI1 hA hI p g⁻¹ hp hgi, axisNrmStd_inv m hA1 hI1 hA hI hg]
  conv_lhs => rw [mul_assoc]
  rw [h1, h2, mul_assoc]

/-- `rotN` is invariant under conjugation by a linear isometry. -/
lemma axisRotN_conj {m : ℕ} (R S : E m ≃ₗᵢ[ℝ] E m) : rotN (R * S * R⁻¹) = rotN S := by
  rw [npc_rotN_eq_mOf, npc_rotN_eq_mOf]
  show ‖opOf (R * S * R⁻¹) - 1‖ = ‖opOf S - 1‖
  rw [show opOf (R * S * R⁻¹) - 1 =
      (R : E m →L[ℝ] E m) * (opOf S - 1) * (R.symm : E m →L[ℝ] E m) from by
    ext x; simp [opOf, LinearIsometryEquiv.inv_def]]
  exact normConjIsom R (opOf S - 1)

/-- If a set of generators is stable under conjugation by `n`, so is the subgroup it generates. -/
lemma closure_conj_mem {G : Type*} [Group G] {s : Set G} {n : G}
    (h : ∀ y ∈ s, n * y * n⁻¹ ∈ s) :
    ∀ a ∈ Subgroup.closure s, n * a * n⁻¹ ∈ Subgroup.closure s := by
  intro a ha
  refine Subgroup.closure_induction (p := fun a _ => n * a * n⁻¹ ∈ Subgroup.closure s)
    (fun x hx => Subgroup.subset_closure (h x hx)) ?_ ?_ ?_ ha
  · simpa using Subgroup.one_mem (Subgroup.closure s)
  · intro x y hx hy ihx ihy
    rw [show n * (x * y) * n⁻¹ = (n * x * n⁻¹) * (n * y * n⁻¹) by group]
    exact Subgroup.mul_mem _ ihx ihy
  · intro x hx ih
    rw [show n * x⁻¹ * n⁻¹ = (n * x * n⁻¹)⁻¹ by group]
    exact Subgroup.inv_mem _ ih

/-- The group `A` generated by the small normal parts of `P` is finite and abelian, and the normal
part `nrmStd 1 m g` of `g` normalises it.

Here `N` is a discrete subgroup of `PO (1+m) 1` preserving the standard stratum (`hN`), `P` is a
normal subgroup of `N` contained in the kernel of `resStd 1 m` (`hP`, `hPnorm`), and
`A = closure (nrmStd 1 m '' {p ∈ P | rotN (nrmStd 1 m p) ≤ 1/4})` (`hAdef`).

Route.
* Every `p ∈ P` satisfies `p ∈ SetStabStd 1 m` (`hP`, `hN`) and `resStd 1 m p = 1`, so
  `Work.Mostow.rhd_stab_form` gives `p = blk 1 m 1 (nrmStd 1 m p)`; `rhd_resStd_smul_coordEmb` and
  `rhd_coordEmb_zero` then give `p • 0 = 0`.  `Work.Mostow.finite_nearStab` with radius `0` applied
  to `P` (discrete, since `P ≤ N` and `hdisc`) makes `{p | p ∈ P}` finite, hence also its image
  `nrmStd 1 m '' P`.
* `A` is generated by elements of the finite subgroup `B := closure (nrmStd 1 m '' P)`
  (`rhd_resStd_mul` + `blk_hom` show `nrmStd` is multiplicative on `SetStabStd`), so `A` is finite;
  and two generators `nrmStd 1 m p`, `nrmStd 1 m q` with `rotN ≤ 1/4` commute by
  `Work.Mostow.orthSmallCommute` (with `rotN = mOf`, `Submission/Work/Mostow/cardKAux.lean`), so
  `A` is abelian (the closure of a pairwise commuting set is abelian).  Note: the multiplicativity
  of `nrmStd`/`resStd` on `SetStabStd` and the conjugation invariance of `rotN` are only
  *commented* elsewhere in the workspace; prove them here if necessary (templates:
  `Work.Mostow.rhd_resStd_mul` for multiplicativity, and `Work.Mostow.normConjIsom` for `rotN`).
* Normalisation: for a generator `a = nrmStd 1 m p` we have `g * p * g⁻¹ ∈ P` (`hPnorm`, `hg`) and
  `nrmStd 1 m (g * p * g⁻¹) = nrmStd 1 m g * nrmStd 1 m p * (nrmStd 1 m g)⁻¹`; moreover this is a
  generator again because `rotN` is conjugation invariant.  Hence
  `nrmStd 1 m g * a * (nrmStd 1 m g)⁻¹ ∈ A` for all `a ∈ A`. -/
theorem axisGenFiniteAbelian (m : ℕ) (hm : 0 < m)
    (hA1 : Submission.Mostow.POActionProp 1) (hI1 : Submission.Mostow.HypIsometryProp 1)
    (hA : Submission.Mostow.POActionProp (1 + m)) (hI : Submission.Mostow.HypIsometryProp (1 + m))
    (N : Subgroup (LeanEval.Geometry.MostowRigidity.PO (1 + m) 1)) (hdisc : IsDiscrete (SetLike.coe N))
    (hN : ∀ n ∈ N, n ∈ Submission.Mostow.SetStabStd 1 m)
    (g : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1) (hg : g ∈ N)
    (P : Subgroup (LeanEval.Geometry.MostowRigidity.PO (1 + m) 1))
    (hP : ∀ p ∈ P, p ∈ N ∧ Submission.Mostow.resStd 1 m p = 1)
    (hPnorm : ∀ n ∈ N, ∀ p : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1, p ∈ P → n * p * n⁻¹ ∈ P)
    (A : Subgroup (Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m))
    (hAdef : ∀ x : Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m, x ∈ A ↔
      x ∈ Subgroup.closure (Submission.Mostow.nrmStd 1 m ''
        {p : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1 |
          p ∈ P ∧ Submission.Mostow.rotN (Submission.Mostow.nrmStd 1 m p) ≤ 1 / 4})) :
    Finite ↥A ∧ (∀ a ∈ A, ∀ b ∈ A, a * b = b * a) ∧
      (∀ a ∈ A, Submission.Mostow.nrmStd 1 m g * a * (Submission.Mostow.nrmStd 1 m g)⁻¹ ∈ A) := by
  classical
  set S : Set (PO (1 + m) 1) := {p | p ∈ P ∧ rotN (nrmStd 1 m p) ≤ 1 / 4} with hSdef
  set G0 : Set (E m ≃ₗᵢ[ℝ] E m) := nrmStd 1 m '' S with hG0def
  have hAcl : A = Subgroup.closure G0 := Subgroup.ext (fun x => hAdef x)
  have hPstab : ∀ p ∈ P, p ∈ SetStabStd 1 m := fun p hp => hN p (hP p hp).1
  have hPres : ∀ p ∈ P, resStd 1 m p = 1 := fun p hp => (hP p hp).2
  -- `P` is discrete, being a subgroup of the discrete group `N`
  have hdiscP : IsDiscrete (SetLike.coe P) := by
    refine rhd_isDiscrete_range (1 + m) hA P ?_
    intro R
    refine ((finite_nearStab (POBasic.ofProp hA) (HypIsoData.ofProp hI)
      hdisc R).image (fun γ : N => (γ : PO (1 + m) 1))).subset ?_
    rintro h ⟨hhP, hhd⟩
    exact ⟨⟨h, (hP h hhP).1⟩, hhd, rfl⟩
  have hmul : ∀ R R' : E m ≃ₗᵢ[ℝ] E m,
      blk 1 m 1 (R * R') = blk 1 m 1 R * blk 1 m 1 R' := by
    intro R R'
    simpa using (blk_hom 1 m hA1 hI1 hA hI).1 (1 : PO 1 1) (1 : PO 1 1) R R'
  have hone : blk 1 m (1 : PO 1 1) (1 : E m ≃ₗᵢ[ℝ] E m) = 1 :=
    (blk_hom 1 m hA1 hI1 hA hI).2.1
  -- the subgroup of normal parts that actually occur in `P`
  let H : Subgroup (E m ≃ₗᵢ[ℝ] E m) :=
    { carrier := {R | blk 1 m 1 R ∈ P}
      mul_mem' := by
        intro R R' hR hR'
        show blk 1 m 1 (R * R') ∈ P
        rw [hmul]
        exact P.mul_mem hR hR'
      one_mem' := by
        show blk 1 m 1 (1 : E m ≃ₗᵢ[ℝ] E m) ∈ P
        rw [hone]
        exact P.one_mem
      inv_mem' := by
        intro R hR
        show blk 1 m 1 R⁻¹ ∈ P
        have h1 : blk 1 m 1 R * blk 1 m 1 R⁻¹ = 1 := by
          rw [← hmul, mul_inv_cancel, hone]
        have h2 : blk 1 m 1 R⁻¹ = (blk 1 m 1 R)⁻¹ := by
          calc blk 1 m 1 R⁻¹ = (blk 1 m 1 R)⁻¹ * (blk 1 m 1 R * blk 1 m 1 R⁻¹) := by group
            _ = (blk 1 m 1 R)⁻¹ := by rw [h1, mul_one]
        rw [h2]
        exact P.inv_mem hR }
  have hHfin : (H : Set (E m ≃ₗᵢ[ℝ] E m)).Finite :=
    blockNormalPartFinite m hm hA1 hI1 hA hI P hdiscP
  -- every generator lies in the finite group `H`
  have hgen : ∀ x ∈ G0, x ∈ H := by
    rintro x ⟨p, ⟨hpP, hrot⟩, rfl⟩
    have hpform : p = blk 1 m 1 (nrmStd 1 m p) := by
      conv_lhs => rw [rhd_stab_form 1 m hA1 hI1 hA hI (hPstab p hpP)]
      rw [hPres p hpP]
    show blk 1 m 1 (nrmStd 1 m p) ∈ P
    exact hpform ▸ hpP
  have hAle : A ≤ H := by
    rw [hAcl]
    exact (Subgroup.closure_le H).mpr hgen
  have hfinA : Finite ↥A := (hHfin.subset hAle).to_subtype
  have hab : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a :=
    normalPartsCommute m hm hA1 hI1 hA hI P hdiscP hPres A hAcl
  -- normalisation
  have hconj_gen : ∀ y ∈ G0, nrmStd 1 m g * y * (nrmStd 1 m g)⁻¹ ∈ G0 := by
    rintro y ⟨p, ⟨hpP, hrot⟩, rfl⟩
    have hpg : g * p * g⁻¹ ∈ P := hPnorm g hg p hpP
    refine ⟨g * p * g⁻¹, ⟨hpg, ?_⟩, ?_⟩
    · rw [axisNrmStd_conj m hA1 hI1 hA hI (hN g hg) (hPstab p hpP)]
      rw [axisRotN_conj]
      exact hrot
    · exact axisNrmStd_conj m hA1 hI1 hA hI (hN g hg) (hPstab p hpP)
  have hclosure := closure_conj_mem hconj_gen
  refine ⟨hfinA, hab, ?_⟩
  intro a ha
  rw [hAdef a] at ha
  rw [hAdef (nrmStd 1 m g * a * (nrmStd 1 m g)⁻¹)]
  exact hclosure a ha

end Work.Mostow
