import Submission.Work.Mostow.egacNearIdOfSmallRot

/-!
# Mostow's elliptic gap at a cusp

`Work.Mostow.ellipticGapAtCusp`: for a lattice `Γ ≤ PO(n,1)` (`n ≥ 3`), a parabolic fixed point
`ξ ∈ parFixed Γ` and a non-trivial **elliptic** `γ ∈ Γ` fixing `ξ`, whose action on the horospheres
at `ξ` is the affine isometry `y ↦ A y + v` of `ξ^⊥`, some *unit* vector `y ⊥ ξ` is moved by at
least a uniform `θ > 0`: `θ ≤ ‖A y - y‖`.

This is the "rotation gap" of the cusp stabiliser `Γ_ξ = {γ ∈ Γ | bd γ ξ = ξ}`: the flat linear
part of an elliptic element of `Γ_ξ` is bounded away from the identity, uniformly over `Γ_ξ`.

## The proof

Write `fPart ξ γ = flatLin ξ (Λ γ)` for the flat linear part and `fShift ξ γ = flatTrans ξ (Λ γ)`
for the flat translation part (`Submission/Work/Mostow/flatEllipticBase.lean`); for an elliptic `γ`
fixing `ξ` the Busemann cocycle at `ξ` vanishes (`bCocy_eq_zero_of_fixed`), so `γ` preserves the
horosphere levels, and its flat action is the affine isometry `y ↦ fPart ξ γ y + fShift ξ γ`.
Any pair `(A, v)` satisfying the flat-action hypotheses agrees with this pair on `ξ^⊥`
(`fPart_eq_of_flatData`), so it suffices to prove the gap for `fPart`.

* **The deep-point estimate.**  If `γ` is elliptic, fixes `ξ`, preserves the levels and has flat
  rotation at most `θ₀` (`cegSmall ξ θ₀ γ`), and `L > 0` is small enough compared with `1/‖yc ξ p‖`
  (`p` a fixed point of `γ`), then `γ` is `η`-close to the identity on the unit ball around the deep
  point `hptOf ξ 0 L` (`Work.Mostow.egacNearIdOfSmallRot`, proved in parallel for this file):
  `cosh (hdist u (γ • u)) - 1 = (lev ξ u)²/2 ‖(fPart ξ γ - id)(yc ξ u - yc ξ p)‖²`, and on the unit
  ball one has `lev ξ u ≤ e L`, `‖yc ξ u‖ ≤ 4/L`.
* **Finiteness of the small-rotation elliptics.**  For `η > 0` the Zassenhaus constant, every
  *finite* set `s` of `θ₀`-small elliptics is simultaneously near the identity at one deep point
  `hptOf ξ 0 L` (`egac_closure_finite`), so `⟨s⟩` lies in the nilpotent group
  `Subgroup.closure {γ | NearIdAt γ z η}` (`zassenhausNilpotent`); it is finitely generated and
  generated by torsion elements (elliptics of a discrete group have finite order,
  `cegIsOfFinOrder`), hence finite (`nilp_torsionGen_finite`).  The fixed subspaces of finite
  subsets of the bad set therefore have a common minimal value of `finrank`, whence all the small
  elliptics fix one point of `ℍⁿ` and the bad set is contained in a point stabiliser, which is
  finite (`egac_bad_finite`, `cegStabFinite`).
* **Assembly.**  The bad set is finite and each of its elements really rotates
  (`eq_one_of_fPart_eq_id`), so the minimum of the finitely many positive rotation displacements
  is the required `θ`; every elliptic whose rotation exceeds the threshold `θ₀` is handled by
  scaling a vector realising the failure of `cegSmall`.
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity

noncomputable section

variable {n : ℕ}

/-- The ambient fixed subspace of a set of elements of `PO n 1`, in the hyperboloid lift. -/
noncomputable def egacFixSub (S : Set (LeanEval.Geometry.MostowRigidity.PO n 1)) :
    Submodule ℝ (Fin n ⊕ Fin 1 → ℝ) :=
  ⨅ σ ∈ S, LinearMap.ker ((LambdaMat σ).mulVecLin - LinearMap.id)

lemma egac_memFixSub {S : Set (LeanEval.Geometry.MostowRigidity.PO n 1)}
    {x : Fin n ⊕ Fin 1 → ℝ} :
    x ∈ egacFixSub S ↔ ∀ σ ∈ S, (LambdaMat σ).mulVecLin x = x := by
  simp only [egacFixSub, Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.sub_apply,
    LinearMap.id_coe, id_eq, sub_eq_zero]

lemma egac_fixSub_mono {S T : Set (LeanEval.Geometry.MostowRigidity.PO n 1)} (h : S ⊆ T) :
    egacFixSub T ≤ egacFixSub S := by
  intro x hx
  rw [egac_memFixSub] at hx ⊢
  exact fun σ hσ => hx σ (h hσ)

/-- The image of a set of elements of `Γ` in `PO n 1`. -/
def egacIm {Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)} (T : Set Γ) :
    Set (LeanEval.Geometry.MostowRigidity.PO n 1) := Subtype.val '' T

lemma egacIm_union {Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)} {T T' : Set Γ} :
    egacIm (T ∪ T') = egacIm T ∪ egacIm T' := by
  ext x
  constructor
  · rintro ⟨τ, hτ | hτ, rfl⟩
    · exact Or.inl ⟨τ, hτ, rfl⟩
    · exact Or.inr ⟨τ, hτ, rfl⟩
  · rintro (⟨τ, hτ, rfl⟩ | ⟨τ, hτ, rfl⟩)
    · exact ⟨τ, Or.inl hτ, rfl⟩
    · exact ⟨τ, Or.inr hτ, rfl⟩

lemma egac_hlift_fix (hA : Submission.Mostow.POActionProp n)
    {σ : LeanEval.Geometry.MostowRigidity.PO n 1} {p : Submission.Mostow.E n}
    (hp : σ • p = p) :
    (LambdaMat σ).mulVecLin (Submission.Mostow.hlift p) = Submission.Mostow.hlift p := by
  rw [Matrix.mulVecLin_apply, ← hlift_LambdaMat hA σ p, hp]

/-- **The small-rotation elliptics are finite.**  If every finite set of `θ₀`-small elliptic
elements of `Γ_ξ` generates a finite subgroup, then the whole set of them is finite: the fixed
subspaces of finite subsets, taken with minimal dimension, are the fixed subspace of one finite
subset, hence all the elements fix a common point of `ℍⁿ`, and the stabiliser of a point is
finite in a discrete group. -/
theorem egac_bad_finite (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n)
    {Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)}
    (hdisc : IsDiscrete (SetLike.coe Γ)) (ξ : Submission.Mostow.E n)
    (hξ : ξ ∈ Submission.Mostow.Sph n) {θ₀ : ℝ}
    (hfin : ∀ s : Finset Γ, (s : Set Γ) ⊆ Work.Mostow.cegBad Γ ξ θ₀ →
      Finite ↥(Subgroup.closure (s : Set Γ))) :
    (Work.Mostow.cegBad Γ ξ θ₀).Finite := by
  classical
  have hpred : ∃ d : ℕ, ∃ T : Set Γ, T.Finite ∧ T ⊆ (Work.Mostow.cegBad Γ ξ θ₀ : Set Γ) ∧
      Module.finrank ℝ ↥(egacFixSub (egacIm T)) = d :=
    ⟨_, ∅, Set.finite_empty, Set.empty_subset _, rfl⟩
  obtain ⟨T₀, hT₀fin, hT₀sub, hT₀dim⟩ := Nat.find_spec hpred
  have hminall : ∀ T : Set Γ, T.Finite → T ⊆ (Work.Mostow.cegBad Γ ξ θ₀ : Set Γ) →
      Nat.find hpred ≤ Module.finrank ℝ ↥(egacFixSub (egacIm T)) := by
    intro T hTfin hTsub
    exact Nat.find_min' hpred ⟨T, hTfin, hTsub, rfl⟩
  have hle₀ : ∀ T : Set Γ, T.Finite → T ⊆ (Work.Mostow.cegBad Γ ξ θ₀ : Set Γ) →
      egacFixSub (egacIm T₀) ≤ egacFixSub (egacIm T) := by
    intro T hTfin hTsub
    have h1 : egacFixSub (egacIm (T ∪ T₀)) ≤ egacFixSub (egacIm T₀) := by
      rw [egacIm_union]
      exact egac_fixSub_mono Set.subset_union_right
    have h2 : Nat.find hpred ≤ Module.finrank ℝ ↥(egacFixSub (egacIm (T ∪ T₀))) :=
      hminall _ (hTfin.union hT₀fin) (Set.union_subset hTsub hT₀sub)
    have h3 : Module.finrank ℝ ↥(egacFixSub (egacIm (T ∪ T₀)))
        ≤ Module.finrank ℝ ↥(egacFixSub (egacIm T₀)) := Submodule.finrank_mono h1
    have h4 : egacFixSub (egacIm (T ∪ T₀)) = egacFixSub (egacIm T₀) :=
      Submodule.eq_of_le_of_finrank_eq h1 (le_antisymm h3 (by rw [hT₀dim]; exact h2))
    rw [← h4, egacIm_union]
    exact egac_fixSub_mono Set.subset_union_left
  have hS₀bad : ∀ σ ∈ hT₀fin.toFinset, σ ∈ Work.Mostow.cegBad Γ ξ θ₀ := fun σ hσ =>
    hT₀sub (hT₀fin.mem_toFinset.mp hσ)
  have hclfin : Finite ↥(Subgroup.closure (↑hT₀fin.toFinset : Set Γ)) := hfin _ hS₀bad
  have hclfin' : ((Subgroup.closure (↑hT₀fin.toFinset : Set Γ) : Subgroup Γ) : Set Γ).Finite :=
    Set.finite_coe_iff.mpr hclfin
  have hmapfin : ((Subgroup.map (Subgroup.subtype Γ)
      (Subgroup.closure (↑hT₀fin.toFinset : Set Γ)) : Subgroup
        (LeanEval.Geometry.MostowRigidity.PO n 1)) : Set
          (LeanEval.Geometry.MostowRigidity.PO n 1)).Finite := by
    rw [Subgroup.coe_map]
    exact hclfin'.image _
  obtain ⟨p, hp⟩ := fixPoint_of_finite hA
    (Subgroup.map (Subgroup.subtype Γ) (Subgroup.closure (↑hT₀fin.toFinset : Set Γ)))
    ((Set.finite_coe_iff).mp hmapfin)
  have hfix : ∀ e : Γ, e ∈ Work.Mostow.cegBad Γ ξ θ₀ →
      (e : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p := by
    intro e he
    have hTefin : ({e} : Set Γ).Finite := Set.finite_singleton e
    have hTesub : ({e} : Set Γ) ⊆ (Work.Mostow.cegBad Γ ξ θ₀ : Set Γ) := by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rwa [hx]
    have hSub : egacFixSub (egacIm T₀) ≤ egacFixSub (egacIm ({e} : Set Γ)) :=
      hle₀ _ hTefin hTesub
    have hx : Submission.Mostow.hlift p ∈ egacFixSub (egacIm T₀) := by
      rw [egac_memFixSub]
      rintro x ⟨τ, hτ, rfl⟩
      have hτ' : τ ∈ (↑hT₀fin.toFinset : Set Γ) := (hT₀fin.mem_toFinset).mpr hτ
      have hpmem : ((τ : Γ) : LeanEval.Geometry.MostowRigidity.PO n 1) ∈
          Subgroup.map (Subgroup.subtype Γ) (Subgroup.closure (↑hT₀fin.toFinset : Set Γ)) :=
        Subgroup.mem_map_of_mem (Subgroup.subtype Γ) (Subgroup.subset_closure hτ')
      exact egac_hlift_fix hA (hp _ hpmem)
    have h2 : (LambdaMat (e : LeanEval.Geometry.MostowRigidity.PO n 1)).mulVecLin
        (Submission.Mostow.hlift p) = Submission.Mostow.hlift p := by
      have h3 := hSub hx
      rw [egac_memFixSub] at h3
      exact h3 (e : LeanEval.Geometry.MostowRigidity.PO n 1)
        ⟨e, by rw [Set.mem_singleton_iff], rfl⟩
    rw [Matrix.mulVecLin_apply, ← hlift_LambdaMat hA e p] at h2
    exact Submission.Mostow.Hyper.hlift_injective h2
  refine (cegStabFinite hA hI hdisc p).subset ?_
  intro e he
  exact hfix e he

/-- Transfer of finite order to a subgroup. -/
lemma egac_isOfFinOrder_sub {Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)}
    {H : Subgroup Γ} {x : Γ} (hx : x ∈ H) (h : IsOfFinOrder x) :
    IsOfFinOrder (⟨x, hx⟩ : H) :=
  (Submonoid.isOfFinOrder_coe (x := (⟨x, hx⟩ : H))).mp (by simpa using h)

/-- **Every finite set of small-rotation elliptic elements of `Γ` generates a finite subgroup.** -/
theorem egac_closure_finite (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n)
    {Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)}
    (hdisc : IsDiscrete (SetLike.coe Γ)) {ξ : Submission.Mostow.E n}
    (hξ : ξ ∈ Submission.Mostow.Sph n)
    {θ₀ η : ℝ} (hθ₀pos : 0 < θ₀) (hηpos : 0 < η) (hη8 : η ≤ 1 / 8)
    (hθ₀η : 4 * θ₀ ≤ η / 16)
    (hZ : ∀ z : Submission.Mostow.E n,
      Group.IsNilpotent ↥(Subgroup.closure
        {γ : Γ | Submission.Mostow.NearIdAt (γ : LeanEval.Geometry.MostowRigidity.PO n 1) z η}))
    (s : Finset Γ) (hs : (s : Set Γ) ⊆ Work.Mostow.cegBad Γ ξ θ₀) :
    Finite ↥(Subgroup.closure (s : Set Γ)) := by
  classical
  -- the fixed point of each element of `s`
  let pf : Γ → Submission.Mostow.E n := fun γ =>
    if h : ∃ p : Submission.Mostow.E n,
        (γ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p then h.choose else 0
  have hpf : ∀ γ ∈ s, (γ : LeanEval.Geometry.MostowRigidity.PO n 1) • pf γ = pf γ := by
    intro γ hγ
    have hmem := hs (Finset.mem_coe.mpr hγ)
    have hell : ∃ p : Submission.Mostow.E n,
        (γ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p := (mem_cegBad.mp hmem).2.2.1
    rw [show pf γ = hell.choose from dif_pos hell]
    exact hell.choose_spec
  -- the depth `L`
  set As : ℝ := ∑ γ ∈ s, ‖Work.Mostow.yc ξ (pf γ)‖ with hAs
  have hAsnn : 0 ≤ As := Finset.sum_nonneg (fun (γ : Γ) (_ : γ ∈ s) =>
    norm_nonneg (Work.Mostow.yc ξ (pf γ)))
  set L : ℝ := η / (8 * θ₀ * (1 + As)) with hLdef
  have hLpos : 0 < L := by
    rw [hLdef]; positivity
  have hLb : ∀ γ ∈ s, θ₀ * L * ‖Work.Mostow.yc ξ (pf γ)‖ ≤ η / 8 := by
    intro γ hγ
    have hle : ‖Work.Mostow.yc ξ (pf γ)‖ ≤ As := by
      rw [hAs]
      exact Finset.single_le_sum (fun (i : Γ) (_ : i ∈ s) =>
        norm_nonneg (Work.Mostow.yc ξ (pf i))) hγ
    have h1 : θ₀ * L = η / (8 * (1 + As)) := by
      rw [hLdef]
      have hne : (8 : ℝ) * θ₀ * (1 + As) ≠ 0 := by positivity
      field_simp
    rw [h1]
    have hfac : 0 < η / (8 * (1 + As)) := by positivity
    have h2 : η / (8 * (1 + As)) * ‖Work.Mostow.yc ξ (pf γ)‖ ≤ η / (8 * (1 + As)) * As :=
      mul_le_mul_of_nonneg_left hle (le_of_lt hfac)
    have h3 : η / (8 * (1 + As)) * As ≤ η / 8 := by
      rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity : (0:ℝ) < 8 * (1 + As))]
      nlinarith [le_of_lt hηpos, hAsnn]
    linarith
  -- every element of `s` is near the identity at the deep point
  have hnear : ∀ γ ∈ s, Submission.Mostow.NearIdAt
      (γ : LeanEval.Geometry.MostowRigidity.PO n 1) (Work.Mostow.hptOf ξ 0 L) η := by
    intro γ hγ
    have hmem := hs (Finset.mem_coe.mpr hγ)
    obtain ⟨hbd, -, hell, hsmall⟩ := mem_cegBad.mp hmem
    exact egacNearIdOfSmallRot n hA hI hξ hbd
      (Work.Mostow.lev_smul_of_elliptic hA hI hξ hbd hell) hθ₀pos hsmall (pf γ) (hpf γ hγ)
      hηpos hη8 hθ₀η hLpos (hLb γ hγ)
  -- the closure is a subgroup of a nilpotent group
  set H : Subgroup Γ := Subgroup.closure (s : Set Γ) with hH
  set N : Subgroup Γ := Subgroup.closure
    {γ : Γ | Submission.Mostow.NearIdAt (γ : LeanEval.Geometry.MostowRigidity.PO n 1)
      (Work.Mostow.hptOf ξ 0 L) η} with hN
  have hsub : H ≤ N := by
    rw [hH, hN]
    refine (Subgroup.closure_le _).mpr ?_
    intro γ hγ
    exact Subgroup.subset_closure (hnear γ (Finset.mem_coe.mp hγ))
  haveI hNnil : Group.IsNilpotent ↥N := hZ (Work.Mostow.hptOf ξ 0 L)
  haveI hHnil : Group.IsNilpotent ↥H := by
    refine isNilpotent_of_ker_le_center (Subgroup.inclusion hsub) ?_
    rw [Subgroup.ker_inclusion]
    exact bot_le
  haveI hHfg : Group.FG ↥H := inferInstance
  -- the closure is generated by elements of finite order
  have key : ∀ (x : Γ) (hx : x ∈ Subgroup.closure (s : Set Γ)),
      (⟨x, hx⟩ : ↥(Subgroup.closure (s : Set Γ))) ∈
        Subgroup.closure {h : ↥(Subgroup.closure (s : Set Γ)) | IsOfFinOrder h} := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
        have hmem := hs (Finset.mem_coe.mpr hy)
        have hell : ∃ p : Submission.Mostow.E n,
            (y : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p := (mem_cegBad.mp hmem).2.2.1
        have ht : IsOfFinOrder (y : Γ) := cegIsOfFinOrder hA hI hdisc y hell
        exact Subgroup.subset_closure (egac_isOfFinOrder_sub (Subgroup.subset_closure hy) ht)
    | one => exact Subgroup.subset_closure IsOfFinOrder.one
    | mul y z hy hz ihy ihz =>
        have h1 : (⟨y * z, Subgroup.mul_mem _ hy hz⟩ : ↥(Subgroup.closure (s : Set Γ)))
            = (⟨y, hy⟩ : ↥(Subgroup.closure (s : Set Γ))) * ⟨z, hz⟩ := Subtype.ext rfl
        rw [h1]
        exact Subgroup.mul_mem _ ihy ihz
    | inv y hy ihy =>
        have h1 : (⟨y⁻¹, Subgroup.inv_mem _ hy⟩ : ↥(Subgroup.closure (s : Set Γ)))
            = (⟨y, hy⟩ : ↥(Subgroup.closure (s : Set Γ)))⁻¹ := Subtype.ext rfl
        rw [h1]
        exact Subgroup.inv_mem _ ihy
  have htor : Subgroup.closure {h : ↥H | IsOfFinOrder h} = ⊤ := by
    rw [eq_top_iff]
    intro x _
    exact key x x.2
  exact nilp_torsionGen_finite htor
/-- **The elliptic gap in terms of the flat linear part.** -/
theorem egac_gap_core (n : ℕ) (hn : 3 ≤ n) (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n)
    (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)) (hΓ : Submission.Mostow.HypLattice Γ)
    (ξ : Submission.Mostow.E n) (hξ : ξ ∈ Work.Mostow.parFixed Γ) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (σ : Γ),
      Submission.Mostow.bd (σ : LeanEval.Geometry.MostowRigidity.PO n 1) ξ = ξ →
      (σ : LeanEval.Geometry.MostowRigidity.PO n 1) ≠ 1 →
      (∃ p : Submission.Mostow.E n, (σ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p) →
      ∃ y : Submission.Mostow.E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧
        θ ≤ ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y - y‖ := by
  classical
  obtain ⟨η₀, hη₀pos, hZ₀⟩ := Work.Mostow.zassenhausNilpotent n (by omega) hA hI
  set η : ℝ := min η₀ (1 / 8) with hηdef
  have hηpos : 0 < η := lt_min hη₀pos (by norm_num)
  have hη8 : η ≤ 1 / 8 := min_le_right _ _
  have hηη₀ : η ≤ η₀ := min_le_left _ _
  have hZ : ∀ z : Submission.Mostow.E n,
      Group.IsNilpotent ↥(Subgroup.closure {γ : Γ | Submission.Mostow.NearIdAt
        (γ : LeanEval.Geometry.MostowRigidity.PO n 1) z η}) := by
    intro z
    have hsub : Subgroup.closure {γ : Γ | Submission.Mostow.NearIdAt
          (γ : LeanEval.Geometry.MostowRigidity.PO n 1) z η}
        ≤ Subgroup.closure {γ : Γ | Submission.Mostow.NearIdAt
          (γ : LeanEval.Geometry.MostowRigidity.PO n 1) z η₀} := by
      refine Subgroup.closure_mono ?_
      intro γ hγ u hu
      exact lt_of_lt_of_le (hγ u hu) hηη₀
    haveI : Group.IsNilpotent ↥(Subgroup.closure {γ : Γ | Submission.Mostow.NearIdAt
        (γ : LeanEval.Geometry.MostowRigidity.PO n 1) z η₀}) := hZ₀ Γ hΓ.1 z
    exact Subgroup.isNilpotent_of_ker_le_center (Subgroup.inclusion hsub) (by
      rw [Subgroup.ker_inclusion]
      exact bot_le)
  set θ₀ : ℝ := min (1 / 4) (η / 64) with hθ₀def
  have hθ₀pos : 0 < θ₀ := lt_min (by norm_num) (by positivity)
  have hθ₀η : 4 * θ₀ ≤ η / 16 := by
    have h1 : θ₀ ≤ η / 64 := min_le_right _ _
    nlinarith
  have hfinBad : (Work.Mostow.cegBad Γ ξ θ₀).Finite :=
    egac_bad_finite hA hI hΓ.1 ξ hξ.1
      (fun s hs => egac_closure_finite hA hI hΓ.1 hξ.1 hθ₀pos hηpos hη8 hθ₀η hZ s hs)
  have hrot : ∀ σ : Γ, σ ∈ Work.Mostow.cegBad Γ ξ θ₀ →
      ∃ y : Submission.Mostow.E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧
        0 < ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y - y‖ := by
    intro σ hσ
    obtain ⟨hbd, hne1, hell, -⟩ := mem_cegBad.mp hσ
    by_contra hcon
    have hall : ∀ y : Submission.Mostow.E n, inner ℝ y ξ = 0 →
        Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y = y := by
      intro y hy
      rcases eq_or_ne y 0 with rfl | hy0
      · exact map_zero (Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1))
      · have hy1 : inner ℝ ((‖y‖ : ℝ)⁻¹ • y) ξ = 0 := by
          rw [real_inner_smul_left, hy, mul_zero]
        have hyn : ‖((‖y‖ : ℝ)⁻¹ • y : Submission.Mostow.E n)‖ = 1 := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr hy0)),
            inv_mul_cancel₀ (ne_of_gt (norm_pos_iff.mpr hy0))]
        have h2 : ¬ (0 < ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
            ((‖y‖ : ℝ)⁻¹ • y) - (‖y‖ : ℝ)⁻¹ • y‖) := fun h => hcon ⟨_, hy1, hyn, h⟩
        have h3 : ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
            ((‖y‖ : ℝ)⁻¹ • y) - (‖y‖ : ℝ)⁻¹ • y‖ = 0 :=
          le_antisymm (le_of_not_gt h2) (norm_nonneg _)
        have h4 : (‖y‖ : ℝ)⁻¹ • (Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y
            - y) = 0 := by
          rw [map_smul, ← smul_sub] at h3
          exact norm_eq_zero.mp h3
        have h5 := congrArg (fun z : Submission.Mostow.E n => (‖y‖ : ℝ) • z) h4
        have h6 : Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y - y = 0 := by
          simpa [smul_smul, mul_inv_cancel₀ (ne_of_gt (norm_pos_iff.mpr hy0)), one_smul] using h5
        exact sub_eq_zero.mp h6
    exact hne1 (Subtype.ext (Work.Mostow.eq_one_of_fPart_eq_id hA hI hξ.1 hbd hell hall))
  have hmain : ∃ θbad : ℝ, 0 < θbad ∧ ∀ σ : Γ, σ ∈ Work.Mostow.cegBad Γ ξ θ₀ →
      ∃ y : Submission.Mostow.E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧
        θbad ≤ ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y - y‖ := by
    by_cases hne : (Work.Mostow.cegBad Γ ξ θ₀ : Set Γ).Nonempty
    · haveI : Fintype ↥(Work.Mostow.cegBad Γ ξ θ₀) := hfinBad.fintype
      haveI : Nonempty ↥(Work.Mostow.cegBad Γ ξ θ₀) := hne.to_subtype
      let yfun : ↥(Work.Mostow.cegBad Γ ξ θ₀) → Submission.Mostow.E n :=
        fun σ => Classical.choose (hrot σ.1 σ.2)
      have hcfun : ∀ σ : ↥(Work.Mostow.cegBad Γ ξ θ₀),
          0 < ‖Work.Mostow.fPart ξ ((σ : Γ) : LeanEval.Geometry.MostowRigidity.PO n 1)
            (yfun σ) - yfun σ‖ := fun σ => (Classical.choose_spec (hrot σ.1 σ.2)).2.2
      set vals : Finset ℝ := Finset.univ.image (fun σ : ↥(Work.Mostow.cegBad Γ ξ θ₀) =>
        ‖Work.Mostow.fPart ξ ((σ : Γ) : LeanEval.Geometry.MostowRigidity.PO n 1)
          (yfun σ) - yfun σ‖) with hvals
      have hvalsne : vals.Nonempty := ⟨_, Finset.mem_image.mpr
        ⟨Classical.choice ‹Nonempty ↥(Work.Mostow.cegBad Γ ξ θ₀)›, Finset.mem_univ _, rfl⟩⟩
      have hminpos : 0 < vals.min' hvalsne := by
        obtain ⟨τ, -, hval⟩ := Finset.mem_image.mp (Finset.min'_mem vals hvalsne)
        rw [← hval]
        exact hcfun τ
      refine ⟨min θ₀ (vals.min' hvalsne), lt_min hθ₀pos hminpos, fun σ hσ => ?_⟩
      refine ⟨yfun ⟨σ, hσ⟩, (Classical.choose_spec (hrot σ hσ)).1,
        (Classical.choose_spec (hrot σ hσ)).2.1, ?_⟩
      refine le_trans (min_le_right _ _) ?_
      exact Finset.min'_le vals _ (Finset.mem_image.mpr ⟨⟨σ, hσ⟩, Finset.mem_univ _, rfl⟩)
    · exact ⟨θ₀, hθ₀pos, fun σ hσ => absurd ⟨σ, hσ⟩ hne⟩
  obtain ⟨θbad, hθbadpos, hbad⟩ := hmain
  refine ⟨min θbad θ₀, lt_min hθbadpos hθ₀pos, fun σ hbd hne hell => ?_⟩
  by_cases hσ : σ ∈ Work.Mostow.cegBad Γ ξ θ₀
  · obtain ⟨y, hy, hy1, hle⟩ := hbad σ hσ
    exact ⟨y, hy, hy1, le_trans (min_le_left _ _) hle⟩
  · have hsmall : ¬ Work.Mostow.cegSmall ξ θ₀
        (σ : LeanEval.Geometry.MostowRigidity.PO n 1) := fun hc =>
      hσ (mem_cegBad.mpr ⟨hbd, (fun h => hne (by rw [h, Subgroup.coe_one])), hell, hc⟩)
    rw [Work.Mostow.cegSmall] at hsmall
    push_neg at hsmall
    obtain ⟨y, hy, hyne⟩ := hsmall
    have hyne' : θ₀ * ‖y‖ < ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
        y - y‖ := by
      simpa only [Work.Mostow.fPart_apply] using hyne
    have hy0 : y ≠ 0 := by
      rintro rfl
      have h0 : ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
          (0 : Submission.Mostow.E n) - 0‖ = 0 := by
        simp only [map_zero, sub_zero, norm_zero]
      rw [h0, norm_zero, mul_zero] at hyne'
      exact absurd hyne' (lt_irrefl 0)
    refine ⟨(‖y‖ : ℝ)⁻¹ • y, ?_, ?_, ?_⟩
    · rw [real_inner_smul_left, hy, mul_zero]
    · rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr hy0)),
        inv_mul_cancel₀ (ne_of_gt (norm_pos_iff.mpr hy0))]
    · have hsm : ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
            ((‖y‖ : ℝ)⁻¹ • y) - (‖y‖ : ℝ)⁻¹ • y‖
          = (‖y‖ : ℝ)⁻¹ * ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
              y - y‖ := by
        rw [map_smul, ← smul_sub, norm_smul, Real.norm_eq_abs,
          abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr hy0))]
      rw [hsm]
      refine le_trans (min_le_right _ _) ?_
      have hpos : 0 < ‖y‖ := norm_pos_iff.mpr hy0
      have hkey : θ₀ * ‖y‖ ≤ ‖Work.Mostow.fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1)
          y - y‖ := le_of_lt hyne'
      have hmul := mul_le_mul_of_nonneg_left hkey (le_of_lt (inv_pos.mpr hpos))
      have hsimpl : (‖y‖ : ℝ)⁻¹ * (θ₀ * ‖y‖) = θ₀ := by
        rw [mul_comm θ₀ ‖y‖, ← mul_assoc, inv_mul_cancel₀ (ne_of_gt hpos), one_mul]
      rwa [hsimpl] at hmul

/-- **Mostow's elliptic gap at a cusp.** -/
theorem ellipticGapAtCusp (n : ℕ) (hn : 3 ≤ n)
    (hA : Submission.Mostow.POActionProp n) (hI : Submission.Mostow.HypIsometryProp n)
    (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)) (hΓ : Submission.Mostow.HypLattice Γ)
    (ξ : Submission.Mostow.E n) (hξ : ξ ∈ Work.Mostow.parFixed Γ) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (γ : Γ) (A : Submission.Mostow.E n →ₗ[ℝ] Submission.Mostow.E n)
      (v : Submission.Mostow.E n),
      (γ : LeanEval.Geometry.MostowRigidity.PO n 1) ≠ 1 →
      Submission.Mostow.bd (γ : LeanEval.Geometry.MostowRigidity.PO n 1) ξ = ξ →
      (∃ p : Submission.Mostow.E n, (γ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p) →
      (∀ y : Submission.Mostow.E n, inner ℝ y ξ = 0 → inner ℝ (A y) ξ = 0) →
      (∀ y : Submission.Mostow.E n, inner ℝ y ξ = 0 → ‖A y‖ = ‖y‖) →
      (∀ (y : Submission.Mostow.E n) (D : ℝ), inner ℝ y ξ = 0 → 0 < D →
        Work.Mostow.lev ξ ((γ : LeanEval.Geometry.MostowRigidity.PO n 1) • Work.Mostow.hptOf ξ y D) = D ∧
        Work.Mostow.yc ξ ((γ : LeanEval.Geometry.MostowRigidity.PO n 1) • Work.Mostow.hptOf ξ y D) = A y + v) →
      ∃ y : Submission.Mostow.E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧ θ ≤ ‖A y - y‖ := by
  obtain ⟨θ, hθpos, hθspec⟩ := egac_gap_core n hn hA hI Γ hΓ ξ hξ
  refine ⟨θ, hθpos, ?_⟩
  intro γ A v hne hbd hell hperp hnorm hform
  obtain ⟨hAeq, -⟩ := Work.Mostow.fPart_eq_of_flatData hA hI hξ.1 hbd hell hform
  obtain ⟨y, hy, hy1, hle⟩ := hθspec γ hbd hne hell
  exact ⟨y, hy, hy1, by rw [hAeq y hy]; exact hle⟩


end

