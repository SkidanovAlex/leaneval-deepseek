import Mathlib
import Submission.Work.Mostow.geodDeps
import Submission.Work.Mostow.resStd_hom_discrete
import Submission.Work.Mostow.blk_hom
import Submission.Work.Mostow.blk_smul_fermi
import Submission.Work.Mostow.finite_nearStab
import Submission.Work.Mostow.bieberbachDefs
import Submission.Work.Mostow.blockNormalPartFinite
import Submission.Work.Mostow.smallElementsCommute

/-!
# The normal parts of the small rotations in a discrete group commute

`Work.Mostow.normalPartsCommute` is the L7 input of the geodesic-stratum (k = 1) chain:
if `C ≤ PO (1+m) 1` is discrete and every element of `C` acts trivially on the standard
geodesic `stdTG 1 m` (`resStd 1 m c = 1`), then the group generated by the normal parts
`nrmStd 1 m c` of the elements with `rotN (nrmStd 1 m c) ≤ 1/4` is abelian.

The argument is short.  Put `H := {R : E m ≃ₗᵢ[ℝ] E m | blk 1 m 1 R ∈ C}`; `blk_hom` makes `H` a
subgroup of `O(m)`, and `R ↦ blk 1 m 1 R` is injective with image inside the set of elements of
`C` fixing the origin (`blk 1 m 1 R` fixes the stratum pointwise), which `finite_nearStab` shows
to be finite.  Hence `H` is finite.  Every generator `nrmStd 1 m c` of `A` lies in `H`: if `c` is
a block then `resStd 1 m c = 1` (hypothesis) forces `c = blk 1 m 1 (nrmStd 1 m c)`, otherwise
`nrmStd 1 m c` is the identity by definition.  So `A ≤ H` is a finite group, and its generators
all satisfy `mOf = rotN ≤ 1/4`; two such elements of a finite subgroup of `O(m)` commute
(`Work.Mostow.smallElementsCommute`), and pairwise commuting generators generate an abelian
group.  (This is the `C ≤ ker resStd` step of the design: it is exactly what the hypothesis
`htriv` supplies.)
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity

/-- `rotN` is the operator-norm displacement `mOf`. -/
lemma npc_rotN_eq_mOf {m : ℕ} (R : E m ≃ₗᵢ[ℝ] E m) : rotN R = mOf R := rfl

/-- A block element is equal to its block decomposition: `resStd` and `nrmStd` extract the two
components of `blk`. -/
lemma npc_nrmStd_resStd_of_blk (k m : ℕ) (hAk : POActionProp k) (hIk : HypIsometryProp k)
    (hA : POActionProp (k + m)) (hI : HypIsometryProp (k + m))
    {c : PO (k + m) 1} {h : PO k 1} {R : E m ≃ₗᵢ[ℝ] E m} (hc : c = blk k m h R) :
    nrmStd k m c = R ∧ resStd k m c = h := by
  have hhom := blk_hom k m hAk hIk hA hI
  have hex : ∃ p : PO k 1 × (E m ≃ₗᵢ[ℝ] E m), c = blk k m p.1 p.2 := ⟨(h, R), hc⟩
  have h1 : nrmStd k m c = hex.choose.2 := by unfold nrmStd; exact dite_eq_left hex
  have h2 : resStd k m c = hex.choose.1 := by unfold resStd; exact dite_eq_left hex
  have heq : blk k m h R = blk k m hex.choose.1 hex.choose.2 := hc.symm.trans hex.choose_spec
  obtain ⟨hh, hR⟩ := hhom.2.2 h hex.choose.1 R hex.choose.2 heq
  exact ⟨h1.trans hR.symm, h2.trans hh.symm⟩

set_option linter.style.haveILetI false in
theorem normalPartsCommute (m : ℕ) (hm : 0 < m)
    (hA1 : Submission.Mostow.POActionProp 1) (hI1 : Submission.Mostow.HypIsometryProp 1)
    (hA : Submission.Mostow.POActionProp (1 + m)) (hI : Submission.Mostow.HypIsometryProp (1 + m))
    (C : Subgroup (LeanEval.Geometry.MostowRigidity.PO (1 + m) 1))
    (hdisc : IsDiscrete (SetLike.coe C))
    (htriv : ∀ c ∈ C, Submission.Mostow.resStd 1 m c = 1)
    (A : Subgroup (Submission.Mostow.E m ≃ₗᵢ[ℝ] Submission.Mostow.E m))
    (hAdef : A = Subgroup.closure (Submission.Mostow.nrmStd 1 m ''
      {c : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1 |
        c ∈ C ∧ Submission.Mostow.rotN (Submission.Mostow.nrmStd 1 m c) ≤ 1 / 4})) :
    ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := by
  classical
  have hhom := blk_hom 1 m hA1 hI1 hA hI
  have hmul : ∀ R R' : E m ≃ₗᵢ[ℝ] E m, blk 1 m 1 (R * R') = blk 1 m 1 R * blk 1 m 1 R' := by
    intro R R'; simpa using hhom.1 1 1 R R'
  have hone : blk 1 m (1 : PO 1 1) (1 : E m ≃ₗᵢ[ℝ] E m) = 1 := hhom.2.1
  -- the subgroup of normal parts of the pure (stratum-trivial) rotations in `C`
  let H : Subgroup (E m ≃ₗᵢ[ℝ] E m) :=
    { carrier := {R | blk 1 m 1 R ∈ C}
      mul_mem' := by
        intro R R' hR hR'
        show blk 1 m 1 (R * R') ∈ C
        rw [hmul]; exact C.mul_mem hR hR'
      one_mem' := by
        show blk 1 m 1 (1 : E m ≃ₗᵢ[ℝ] E m) ∈ C
        rw [hone]; exact C.one_mem
      inv_mem' := by
        intro R hR
        show blk 1 m 1 R⁻¹ ∈ C
        have h1 : blk 1 m 1 R * blk 1 m 1 R⁻¹ = 1 := by rw [← hmul, mul_inv_cancel, hone]
        have h2 : blk 1 m 1 R⁻¹ = (blk 1 m 1 R)⁻¹ := by
          calc blk 1 m 1 R⁻¹ = (blk 1 m 1 R)⁻¹ * (blk 1 m 1 R * blk 1 m 1 R⁻¹) := by group
            _ = (blk 1 m 1 R)⁻¹ := by rw [h1, mul_one]
        rw [h2]; exact C.inv_mem hR }
  have hHfin : (H : Set (E m ≃ₗᵢ[ℝ] E m)).Finite :=
    blockNormalPartFinite m hm hA1 hI1 hA hI C hdisc
  haveI : Finite H := hHfin.to_subtype
  let S : Set (PO (1 + m) 1) := {c | c ∈ C ∧ rotN (nrmStd 1 m c) ≤ 1 / 4}
  let G : Set (E m ≃ₗᵢ[ℝ] E m) := nrmStd 1 m '' S
  have hAeq : A = Subgroup.closure G := hAdef
  -- every generator of `A` lies in the finite group `H`
  have hgen_mem : ∀ g ∈ G, g ∈ H := by
    rintro g ⟨c, ⟨hc, -⟩, rfl⟩
    by_cases hex : ∃ p : PO 1 1 × (E m ≃ₗᵢ[ℝ] E m), c = blk 1 m p.1 p.2
    · obtain ⟨hnrm, hres⟩ := npc_nrmStd_resStd_of_blk 1 m hA1 hI1 hA hI hex.choose_spec
      have h1 : hex.choose.1 = 1 := by rw [← hres]; exact htriv c hc
      have hc' : c = blk 1 m 1 (nrmStd 1 m c) := by
        calc c = blk 1 m hex.choose.1 hex.choose.2 := hex.choose_spec
          _ = blk 1 m 1 (nrmStd 1 m c) := by rw [hnrm, h1]
      show blk 1 m 1 (nrmStd 1 m c) ∈ C
      rw [← hc']; exact hc
    · have h1 : nrmStd 1 m c = 1 := by
        unfold nrmStd
        exact dite_eq_right hex
      show blk 1 m 1 (nrmStd 1 m c) ∈ C
      rw [h1, hone]; exact C.one_mem
  have hcl_le : Subgroup.closure G ≤ H :=
    (Subgroup.closure_le H).mpr (fun g hg => hgen_mem g hg)
  -- the generators are `1/4`-small, so they commute pairwise
  have hsmall : ∀ g ∈ G, mOf g ≤ 1 / 4 := by
    rintro g ⟨c, ⟨-, hrot⟩, rfl⟩
    rwa [← npc_rotN_eq_mOf]
  have hgen_comm : ∀ g ∈ G, ∀ g' ∈ G, g * g' = g' * g := by
    intro g hg g' hg'
    exact smallElementsCommute m H ⟨g, hcl_le (Subgroup.subset_closure hg)⟩
      ⟨g', hcl_le (Subgroup.subset_closure hg')⟩ (hsmall g hg) (hsmall g' hg')
  -- pairwise commuting generators generate an abelian group
  have h1 : ∀ a ∈ Subgroup.closure G, ∀ g ∈ G, a * g = g * a := by
    intro a ha
    exact Subgroup.closure_induction (k := G) (p := fun a _ => ∀ g ∈ G, a * g = g * a)
      (fun x hx g hg => hgen_comm x hx g hg)
      (fun g hg => by simp)
      (fun x y hx hy ihx ihy g hg => by
        calc (x * y) * g = x * (y * g) := by group
          _ = x * (g * y) := by rw [ihy g hg]
          _ = (x * g) * y := by group
          _ = (g * x) * y := by rw [ihx g hg]
          _ = g * (x * y) := by group)
      (fun x hx ihx g hg => by
        calc x⁻¹ * g = x⁻¹ * (g * x) * x⁻¹ := by group
          _ = x⁻¹ * (x * g) * x⁻¹ := by rw [← ihx g hg]
          _ = g * x⁻¹ := by group)
      ha
  have hmain : ∀ a ∈ Subgroup.closure G, ∀ b ∈ Subgroup.closure G, a * b = b * a := by
    intro a ha b hb
    exact (Subgroup.closure_induction (k := G)
      (p := fun b _ => ∀ a ∈ Subgroup.closure G, a * b = b * a)
      (fun x hx a ha => h1 a ha x hx)
      (fun a ha => by simp)
      (fun x y hx hy ihx ihy a ha => by
        calc a * (x * y) = (a * x) * y := by group
          _ = (x * a) * y := by rw [ihx a ha]
          _ = x * (a * y) := by group
          _ = x * (y * a) := by rw [ihy a ha]
          _ = (x * y) * a := by group)
      (fun x hx ihx a ha => by
        have h2 : x⁻¹ * a * x = a := by
          rw [mul_assoc, ihx a ha, ← mul_assoc, inv_mul_cancel, one_mul]
        calc a * x⁻¹ = (x⁻¹ * a * x) * x⁻¹ := by rw [h2]
          _ = x⁻¹ * a := by group)
      hb) a ha
  rw [hAeq]
  exact hmain

end Work.Mostow
