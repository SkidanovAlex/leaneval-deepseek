import Mathlib
import Submission.Mostow.GapADefs
import Submission.Work.Mostow.frameThinFar
import Submission.Work.Mostow.zassenhausNilpotent
import Submission.Work.Mostow.nilp_torsionGen_finite
import Submission.Work.Mostow.finite_shortAt
import Submission.Work.Mostow.KMcovol
import Submission.Work.Mostow.HLlinks

/-!
# GAP-A (`EscapeShort`) for odd `n ≥ 5`

Assembly of `Work.Mostow.gapA_odd` from

* `Work.Mostow.frameThinFar`: outside a compact set there is a non-identity element `η`-near the
  identity;
* the **infinite branch** `nearGrp_infinite_short`: if the subgroup generated by the
  `η`-near-identity elements is infinite, then it contains an infinite-order element which is
  `η`-short.  (The generating set is finite by discreteness, so the group is finitely generated;
  it is nilpotent by Zassenhaus and, if all generators were torsion, it would be finite by
  `nilp_torsionGen_finite` — contradiction.)
* the **finite branch** `Work.Mostow.geodStratum` (design L11): if that subgroup is finite and
  nontrivial, then an infinite-order element of displacement `≤ C η` exists, with `C` depending
  only on the stratum dimension `n - 1 ≥ 4`, and with `η` below a window `η₀(V)` depending on the
  covolume `V`.

`λ` is a reserved token — never use it as a variable name.
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory

noncomputable section

/-! ## The infinite branch -/

/-- **The infinite branch of GAP-A.**  For a discrete `Γ` there is `ηZ > 0` such that for every
`η ≤ ηZ` and every `z`, if the subgroup generated by the `η`-near-identity elements of `Γ` at `z`
is nontrivial and infinite, then some infinite-order element of `Γ` moves `z` by less than `η`. -/
theorem nearGrp_infinite_short (n : ℕ) (hn : 2 ≤ n) (hA : POActionProp n)
    (hI : HypIsometryProp n) (Γ : Subgroup (PO n 1)) (hdisc : IsDiscrete (SetLike.coe Γ)) :
    ∃ ηZ : ℝ, 0 < ηZ ∧ ∀ η : ℝ, 0 < η → η ≤ ηZ → ∀ z : E n,
      nearGrp Γ z η ≠ ⊥ → ¬ Finite ↥(nearGrp Γ z η) →
      ∃ γ : Γ, orderOf γ = 0 ∧ hdist z ((γ : PO n 1) • z) < η := by
  obtain ⟨ηZ, hηZpos, hηZ⟩ := zassenhausNilpotent n hn hA hI
  refine ⟨ηZ, hηZpos, ?_⟩
  intro η hη hηle z hne hinf
  have hzz : hdist z z ≤ 1 := by
    rw [(hI.2.2.1 z z).mpr rfl]
    norm_num
  -- the generating set is finite by discreteness
  have hSfin : {g : PO n 1 | g ∈ Γ ∧ NearIdAt g z η}.Finite := by
    have hTfin : {γ : Γ | hdist z ((γ : PO n 1) • z) ≤ η}.Finite :=
      finite_shortAt n hA hI Γ hdisc z η
    refine (hTfin.image (Subtype.val : Γ → PO n 1)).subset ?_
    rintro g ⟨hgΓ, hgN⟩
    exact ⟨⟨g, hgΓ⟩, le_of_lt (hgN z hzz), rfl⟩
  -- `nearGrp` is finitely generated
  haveI : Group.FG ↥(nearGrp Γ z η) := by
    haveI : Finite {g : PO n 1 | g ∈ Γ ∧ NearIdAt g z η} := hSfin
    unfold nearGrp
    exact Group.closure_finite_fg _
  -- and nilpotent: it lies in the image of the Zassenhaus subgroup of `Γ`
  set ZG : Subgroup Γ := Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z ηZ} with hZG
  have hZnil : Group.IsNilpotent ↥ZG := hηZ Γ hdisc z
  set K : Subgroup (PO n 1) := ZG.map Γ.subtype with hK
  haveI hKnil : Group.IsNilpotent ↥K :=
    Group.nilpotent_of_mulEquiv (Subgroup.equivMapOfInjective ZG Γ.subtype Γ.subtype_injective)
  have hKN : K = nearGrp Γ z ηZ := by
    rw [hK, hZG, nearGrp, MonoidHom.map_closure]
    congr 1
    ext g
    constructor
    · rintro ⟨γ, hγ, rfl⟩
      exact ⟨γ.2, hγ⟩
    · rintro ⟨hgΓ, hgN⟩
      exact ⟨⟨g, hgΓ⟩, hgN, rfl⟩
  haveI hNnilZ : Group.IsNilpotent ↥(nearGrp Γ z ηZ) := hKN ▸ hKnil
  have hle : nearGrp Γ z η ≤ nearGrp Γ z ηZ := by
    rw [nearGrp, nearGrp]
    refine (Subgroup.closure_le _).mpr ?_
    rintro g ⟨hgΓ, hgN⟩
    exact Subgroup.subset_closure ⟨hgΓ, NearIdAt_mono hgN hηle⟩
  haveI : Group.IsNilpotent ↥(nearGrp Γ z η) := isNilpotent_of_le hle
  -- if every generator were torsion, `nearGrp` would be finite
  have hex : ∃ g ∈ {g : PO n 1 | g ∈ Γ ∧ NearIdAt g z η}, ¬ IsOfFinOrder g := by
    by_contra hcon
    have hcon' : ∀ g ∈ {g : PO n 1 | g ∈ Γ ∧ NearIdAt g z η}, IsOfFinOrder g := by
      intro g hg
      by_contra hg'
      exact hcon ⟨g, hg, hg'⟩
    have hgen : Subgroup.closure {h : ↥(nearGrp Γ z η) | IsOfFinOrder h} = ⊤ :=
      closure_torsion_subtype_eq_top (nearGrp Γ z η) {g : PO n 1 | g ∈ Γ ∧ NearIdAt g z η}
        (by rfl) hcon'
    exact hinf (nilp_torsionGen_finite hgen)
  obtain ⟨g, hgS, hginf⟩ := hex
  refine ⟨⟨g, hgS.1⟩, ?_, ?_⟩
  · rw [← Subgroup.orderOf_coe]
    exact orderOf_eq_zero hginf
  · exact hgS.2 z hzz

/-! ## The outer assembly -/

/-- **Assembly of `GapAProp` from the near-identity escape and the two branches.** -/
theorem gapA_of_pieces {n : ℕ} (Γ : Subgroup (PO n 1)) (ηZ : ℝ) (hηZ : 0 < ηZ)
    (hframe : ∀ η : ℝ, 0 < η → ∃ K : Set (E n), IsCompact K ∧ ∀ z : E n,
      (∀ γ : Γ, (γ : PO n 1) • z ∉ K) → ∃ γ : Γ, γ ≠ 1 ∧ NearIdAt (γ : PO n 1) z η)
    (hinf : ∀ (η : ℝ), 0 < η → η ≤ ηZ → ∀ z : E n, nearGrp Γ z η ≠ ⊥ →
      ¬ Finite ↥(nearGrp Γ z η) →
      ∃ γ : Γ, orderOf γ = 0 ∧ hdist z ((γ : PO n 1) • z) < η)
    (hfin : ∀ ε : ℝ, 0 < ε → ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η ≤ η₀ → ∀ z : E n,
      nearGrp Γ z η ≠ ⊥ → Finite ↥(nearGrp Γ z η) →
      ∃ γ : Γ, orderOf γ = 0 ∧ hdist z ((γ : PO n 1) • z) < ε) :
    GapAProp Γ := by
  intro ε hε
  obtain ⟨η₀, hη₀pos, hfin'⟩ := hfin ε hε
  set η : ℝ := min (min η₀ ηZ) ε with hηdef
  have hηpos : 0 < η := by
    rw [hηdef]; exact lt_min (lt_min hη₀pos hηZ) hε
  have hηle₀ : η ≤ η₀ := le_trans (min_le_left _ _) (min_le_left _ _)
  have hηleZ : η ≤ ηZ := le_trans (min_le_left _ _) (min_le_right _ _)
  have hηε : η ≤ ε := min_le_right _ _
  obtain ⟨K, hKc, hK⟩ := hframe η hηpos
  refine ⟨K, hKc, ?_⟩
  intro z hz
  obtain ⟨γ, hγ1, hγnear⟩ := hK z hz
  have hmem : (γ : PO n 1) ∈ nearGrp Γ z η := Subgroup.subset_closure ⟨γ.2, hγnear⟩
  have hne : nearGrp Γ z η ≠ ⊥ := by
    intro h
    have h1 : (γ : PO n 1) ∈ (⊥ : Subgroup (PO n 1)) := by rwa [h] at hmem
    have h2 : (γ : PO n 1) = 1 := by simpa using h1
    exact hγ1 (Subtype.ext (by simpa using h2))
  by_cases hf : Finite ↥(nearGrp Γ z η)
  · exact hfin' η hηpos hηle₀ z hne hf
  · obtain ⟨g, hgord, hgdist⟩ := hinf η hηpos hηleZ z hne hf
    exact ⟨g, hgord, lt_of_lt_of_le hgdist hηε⟩

/-! ## The finite branch -/

/-- **The finite branch from the geodesic-stratum lemma.**  Given the statement of
`Work.Mostow.geodStratum` (in the even geodesic-stratum dimension `2 * k ≥ 4`), the covolume `V`
of a lattice `Γ ≤ PO (1 + 2 k) 1` and the window `η₀(V)` produce an infinite-order element moving
`z` by less than `ε`. -/
theorem hfin_of_geod (k : ℕ) (Γ : Subgroup (PO (1 + 2 * k) 1)) (hΓ : HypLattice Γ)
    (C : ℝ) (hCpos : 0 < C)
    (hC : ∀ V : ℝ, ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η ≤ η₀ →
      ∀ (Λ : Subgroup (PO (1 + 2 * k) 1)) (D : Set (E (1 + 2 * k))) (z : E (1 + 2 * k)),
        IsDiscrete (SetLike.coe Λ) → IsFundamentalDomain Λ D (volH (1 + 2 * k)) →
        volH (1 + 2 * k) D ≤ ENNReal.ofReal V → nearGrp Λ z η ≠ ⊥ →
        Finite ↥(nearGrp Λ z η) →
        ∃ γ ∈ Λ, orderOf γ = 0 ∧ hdist z (γ • z) ≤ C * η) :
    ∀ ε : ℝ, 0 < ε → ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η ≤ η₀ → ∀ z : E (1 + 2 * k),
      nearGrp Γ z η ≠ ⊥ → Finite ↥(nearGrp Γ z η) →
      ∃ γ : Γ, orderOf γ = 0 ∧ hdist z ((γ : PO (1 + 2 * k) 1) • z) < ε := by
  obtain ⟨hdisc, D, hD, hDtop⟩ := hΓ
  intro ε hε
  obtain ⟨η₁, hη₁pos, hη₁⟩ := hC (volH (1 + 2 * k) D).toReal
  refine ⟨min η₁ (ε / (2 * C)), lt_min hη₁pos (by positivity), ?_⟩
  intro η hη hηle z hne hf
  have hηη₁ : η ≤ η₁ := le_trans hηle (min_le_left _ _)
  have hηC : η ≤ ε / (2 * C) := le_trans hηle (min_le_right _ _)
  have hDle : volH (1 + 2 * k) D ≤ ENNReal.ofReal (volH (1 + 2 * k) D).toReal := by
    rw [ENNReal.ofReal_toReal hDtop]
  obtain ⟨γ, hγΓ, hγord, hγdist⟩ := hη₁ η hη hηη₁ Γ D z hdisc hD hDle hne hf
  refine ⟨⟨γ, hγΓ⟩, ?_, ?_⟩
  · rw [← Subgroup.orderOf_coe]
    exact hγord
  · have hbound : C * η ≤ ε / 2 := by
      have h := mul_le_mul_of_nonneg_left hηC (le_of_lt hCpos)
      rw [show C * (ε / (2 * C)) = ε / 2 by field_simp] at h
      exact h
    exact lt_of_le_of_lt (le_trans hγdist hbound) (by linarith)

/-- **The odd case of GAP-A**, assembled from `frameThinFar`, the infinite branch and the
geodesic-stratum (finite `nearGrp`) lemma. -/
theorem gapA_odd_geod (k : ℕ) (hk : 2 ≤ k)
    (hA : ∀ j, 1 ≤ j → POActionProp j) (hI : ∀ j, 1 ≤ j → HypIsometryProp j)
    (hCov : ∀ j, 2 ≤ j → j < 1 + 2 * k → CovolLB j)
    (H : ∃ C : ℝ, 0 < C ∧ ∀ V : ℝ, ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η ≤ η₀ →
      ∀ (Λ : Subgroup (PO (1 + 2 * k) 1)) (D : Set (E (1 + 2 * k))) (z : E (1 + 2 * k)),
        IsDiscrete (SetLike.coe Λ) → IsFundamentalDomain Λ D (volH (1 + 2 * k)) →
        volH (1 + 2 * k) D ≤ ENNReal.ofReal V → nearGrp Λ z η ≠ ⊥ →
        Finite ↥(nearGrp Λ z η) →
        ∃ γ ∈ Λ, orderOf γ = 0 ∧ hdist z (γ • z) ≤ C * η)
    (Γ : Subgroup (PO (1 + 2 * k) 1)) (hΓ : HypLattice Γ) (hmult : MultThickProp Γ) :
    GapAProp Γ := by
  obtain ⟨C, hCpos, hC⟩ := H
  have hframe : ∀ η : ℝ, 0 < η → ∃ K : Set (E (1 + 2 * k)), IsCompact K ∧ ∀ z : E (1 + 2 * k),
      (∀ γ : Γ, (γ : PO (1 + 2 * k) 1) • z ∉ K) →
      ∃ γ : Γ, γ ≠ 1 ∧ NearIdAt (γ : PO (1 + 2 * k) 1) z η :=
    frameThinFar (1 + 2 * k) (by omega) (hA _ (by omega)) (hI _ (by omega)) Γ hΓ.1 hmult
  obtain ⟨ηZ, hηZpos, hinf⟩ :=
    nearGrp_infinite_short (1 + 2 * k) (by omega) (hA _ (by omega)) (hI _ (by omega)) Γ hΓ.1
  exact gapA_of_pieces Γ ηZ hηZpos hframe hinf (hfin_of_geod k Γ hΓ C hCpos hC)


end

end Work.Mostow
