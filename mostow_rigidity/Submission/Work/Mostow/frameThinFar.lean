variable {n : ℕ}

/-!
# `frameThinFar` — the far-point thin part of a multithick group

## Proof strategy

`MultThickProp Γ` says that at a point `z` where the set of `δ`-short elements is finite of
cardinality at most `N` there is a `Γ`-translate of `z` in the compact set `K(δ,N)`.  We use it in
contrapositive form: fix `δ = 1` and let `N` be large enough (see `pigeonhole_short` below), take
`K = K(1,N)`; if `Γ • z` misses `K` then the set `S` of `γ : Γ` with `hdist z (γ z) < 1` is finite
(`finite_shortAt`) but has more than `N` elements.

`pigeonhole_short` is the pigeonhole step, and it is *uniform in `z`*: the point `z` is conjugated
to `0` by a boost `h` (`BoostTransitive`), and the configuration of `γ` is recorded on a fixed
finite `r`-net `P` of the unit ball at `0`, namely as the tuple
`j ↦ (h⁻¹ * γ * h) • j ∈ E n`.  All these tuples lie in the *compact* set
`∏_{j ∈ P} {v | hdist 0 v ≤ 1 + r + δ}`, so a totally bounded pigeonhole
(`pigeonhole_totBounded`) produces two `γ₁ ≠ γ₂` whose configurations are within `tE` in the sup
(chart) metric.  Chart closeness of two configurations is converted into hyperbolic closeness by
`hdist_le_of_dist_le`, and then the triangle inequality along the net gives
`γ₁⁻¹γ₂ ∈ NearIdAt · z η` (`nearIdAt_of_cfg_close`, `hdist_quot_eq`).

Everything is elementary: no torsion, no finite generation, no classification of isometries.
-/

/-! ## Action bookkeeping -/

lemma smul_inv_smul (hA : POActionProp n) (g : PO n 1) (u : E n) : g⁻¹ • (g • u) = u := by
  rw [← hA.2.2.2.2.1, inv_mul_cancel, hA.2.2.2.1]

lemma smul_conj (hA : POActionProp n) (h g : PO n 1) (u : E n) :
    (h * g * h⁻¹) • u = h • (g • (h⁻¹ • u)) := by
  rw [hA.2.2.2.2.1 (h * g) h⁻¹ u, hA.2.2.2.2.1 h g (h⁻¹ • u)]

lemma smul_inv_smul' (hA : POActionProp n) (g : PO n 1) (u : E n) :
    g • (g⁻¹ • u) = u := by
  rw [← hA.2.2.2.2.1, mul_inv_cancel, hA.2.2.2.1]

lemma smul_conj_left (hA : POActionProp n) (h g : PO n 1) (u : E n) :
    h • ((h⁻¹ * g * h) • u) = g • (h • u) := by
  have hX : h • ((h⁻¹ * g * h) • u) = (h * (h⁻¹ * g * h)) • u :=
    ((POBasic.ofProp hA).mul_smul h (h⁻¹ * g * h) u).symm
  have hY : g • (h • u) = (g * h) • u := ((POBasic.ofProp hA).mul_smul g h u).symm
  rw [hX, hY]
  congr 1
  group

/-- Displacement identity: the displacement of `u` under `g₁⁻¹ * g₂` equals the displacement of
`h⁻¹ • u` under the conjugate `(h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h)`. -/
lemma hdist_quot_eq (hA : POActionProp n) (hI : HypIsometryProp n)
    (h g₁ g₂ : PO n 1) (u : E n) :
    hdist u ((g₁⁻¹ * g₂) • u) =
      hdist ((h⁻¹ * g₁ * h) • (h⁻¹ • u)) ((h⁻¹ * g₂ * h) • (h⁻¹ • u)) := by
  have hA' := POBasic.ofProp hA
  have hI' := HypIsoData.ofProp hI
  have h1 : h • (h⁻¹ • u) = u := smul_inv_smul' hA h u
  have h2 : (g₁⁻¹ * g₂) • (h • (h⁻¹ • u)) =
      h • ((h⁻¹ * (g₁⁻¹ * g₂) * h) • (h⁻¹ • u)) := by
    have hX : (g₁⁻¹ * g₂) • (h • (h⁻¹ • u)) = ((g₁⁻¹ * g₂) * h) • (h⁻¹ • u) :=
      (hA'.mul_smul (g₁⁻¹ * g₂) h (h⁻¹ • u)).symm
    have hY : h • ((h⁻¹ * (g₁⁻¹ * g₂) * h) • (h⁻¹ • u)) =
        (h * (h⁻¹ * (g₁⁻¹ * g₂) * h)) • (h⁻¹ • u) :=
      (hA'.mul_smul h (h⁻¹ * (g₁⁻¹ * g₂) * h) (h⁻¹ • u)).symm
    rw [hX, hY]
    congr 1
    group
  have h3 : (h⁻¹ * (g₁⁻¹ * g₂) * h) = (h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h) := by group
  have h4 : (h⁻¹ * g₁ * h) • (((h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h)) • (h⁻¹ • u)) =
      (h⁻¹ * g₂ * h) • (h⁻¹ • u) := by
    have hX : (h⁻¹ * g₁ * h) • (((h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h)) • (h⁻¹ • u)) =
        ((h⁻¹ * g₁ * h) * ((h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h))) • (h⁻¹ • u) :=
      (hA'.mul_smul _ _ _).symm
    rw [hX]
    congr 1
    group
  calc hdist u ((g₁⁻¹ * g₂) • u)
      = hdist (h • (h⁻¹ • u)) ((g₁⁻¹ * g₂) • (h • (h⁻¹ • u))) := by rw [h1]
    _ = hdist (h • (h⁻¹ • u)) (h • ((h⁻¹ * (g₁⁻¹ * g₂) * h) • (h⁻¹ • u))) := by rw [h2]
    _ = hdist (h⁻¹ • u) ((h⁻¹ * (g₁⁻¹ * g₂) * h) • (h⁻¹ • u)) := hI'.isom_smul h _ _
    _ = hdist (h⁻¹ • u) (((h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h)) • (h⁻¹ • u)) := by rw [h3]
    _ = hdist ((h⁻¹ * g₁ * h) • (h⁻¹ • u))
          ((h⁻¹ * g₁ * h) • (((h⁻¹ * g₁ * h)⁻¹ * (h⁻¹ * g₂ * h)) • (h⁻¹ • u))) :=
        (hI'.isom_smul (h⁻¹ * g₁ * h) _ _).symm
    _ = hdist ((h⁻¹ * g₁ * h) • (h⁻¹ • u)) ((h⁻¹ * g₂ * h) • (h⁻¹ • u)) := by rw [h4]

/-! ## The configuration transfer -/

/-- If two elements have the same (or nearby) configurations on a dense-enough finite set of
test points, their quotient is near the identity at the base point. -/
lemma nearIdAt_of_cfg_close (hA : POActionProp n) (hI : HypIsometryProp n)
    {h g₁ g₂ : PO n 1} {P : Finset (E n)} {r ε δ' : ℝ}
    (hPdens : ∀ u : E n, hdist 0 u ≤ 1 → ∃ y ∈ P, hdist u y < r)
    (hbnd : ∀ y ∈ P, hdist 0 ((h⁻¹ * g₁ * h) • y) ≤ δ' ∧
      hdist 0 ((h⁻¹ * g₂ * h) • y) ≤ δ')
    (hclose : ∀ y ∈ P, hdist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y) ≤ ε)
    {η : ℝ} (hη : r + ε + r < η) :
    NearIdAt (g₁⁻¹ * g₂) (h • 0) η := by
  have hA' := POBasic.ofProp hA
  have hI' := HypIsoData.ofProp hI
  intro u hu
  set u' : E n := h⁻¹ • u with hu'def
  have hu' : hdist (0 : E n) u' ≤ 1 := by
    have hh : hdist (h⁻¹ • (h • (0 : E n))) (h⁻¹ • u) = hdist (h • (0 : E n)) u :=
      hI'.isom_smul h⁻¹ (h • (0 : E n)) u
    rw [smul_inv_smul hA h 0] at hh
    rw [hu'def, hh]
    exact hu
  obtain ⟨y, hyP, hyr⟩ := hPdens u' hu'
  have hmid : hdist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y) ≤ ε := hclose y hyP
  have hb1 : hdist (0 : E n) ((h⁻¹ * g₁ * h) • y) ≤ δ' := (hbnd y hyP).1
  have hb2 : hdist (0 : E n) ((h⁻¹ * g₂ * h) • y) ≤ δ' := (hbnd y hyP).2
  have ht1 : hdist ((h⁻¹ * g₁ * h) • u') ((h⁻¹ * g₁ * h) • y) = hdist u' y :=
    hI'.isom_smul _ _ _
  have ht2 : hdist ((h⁻¹ * g₂ * h) • y) ((h⁻¹ * g₂ * h) • u') = hdist y u' :=
    hI'.isom_smul _ _ _
  have hkey := hdist_quot_eq hA hI h g₁ g₂ u
  rw [hkey]
  calc hdist ((h⁻¹ * g₁ * h) • u') ((h⁻¹ * g₂ * h) • u')
      ≤ hdist ((h⁻¹ * g₁ * h) • u') ((h⁻¹ * g₁ * h) • y) +
        hdist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • u') :=
        hI'.triangle _ _ _
    _ ≤ hdist ((h⁻¹ * g₁ * h) • u') ((h⁻¹ * g₁ * h) • y) +
        (hdist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y) +
         hdist ((h⁻¹ * g₂ * h) • y) ((h⁻¹ * g₂ * h) • u')) := by
        have := hI'.triangle ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y)
          ((h⁻¹ * g₂ * h) • u')
        linarith
    _ = hdist u' y + (hdist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y) + hdist y u') := by
        rw [ht1, ht2]
    _ < η := by
        have hyu' : hdist y u' = hdist u' y := hI'.symm y u'
        have hsum : hdist u' y + (hdist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y) +
            hdist y u') < r + (ε + r) := by
          linarith [hyr, hmid]
        linarith [hsum, hη]



lemma exists_cfg_close {β : Type*} [PseudoMetricSpace β] {n : ℕ} {F : Set (PO n 1)}
    (hF : F.Finite) {f : PO n 1 → β} {K : Set β} (hK : TotallyBounded K)
    (hfK : ∀ g ∈ F, f g ∈ K) {N : ℕ} {t : ℝ} (ht : 0 ≤ t)
    (hN : ∀ G : Set β, G.Finite → G ⊆ K → N < G.ncard →
      ∃ x ∈ G, ∃ y ∈ G, x ≠ y ∧ dist x y ≤ t)
    (hNF : N < F.ncard) :
    ∃ g ∈ F, ∃ g' ∈ F, g ≠ g' ∧ dist (f g) (f g') ≤ t := by
  classical
  by_cases hcase : N < (f '' F).ncard
  · obtain ⟨x, hx, y, hy, hxy, hd⟩ :=
      hN (f '' F) (hF.image f) (by rintro _ ⟨g, hg, rfl⟩; exact hfK g hg) hcase
    obtain ⟨g, hg, rfl⟩ := hx
    obtain ⟨g', hg', rfl⟩ := hy
    refine ⟨g, hg, g', hg', ?_, hd⟩
    rintro rfl
    exact hxy rfl
  · rw [not_lt] at hcase
    have hninj : ¬ Set.InjOn f F := by
      intro hinj
      have h1 : (f '' F).ncard = F.ncard := hinj.ncard_image
      omega
    rw [Set.InjOn] at hninj
    push_neg at hninj
    obtain ⟨g, hg, g', hg', hfg, hne⟩ := hninj
    exact ⟨g, hg, g', hg', hne, by rw [hfg]; simpa using ht⟩

/-! ## The main pigeonhole -/

theorem pigeonhole_short (n : ℕ) (hA : POActionProp n) (hI : HypIsometryProp n)
    (δ η : ℝ) (hδ : 0 ≤ δ) (hη : 0 < η) :
    ∃ N : ℕ, ∀ (z : E n) (F : Set (PO n 1)), F.Finite →
      (∀ g ∈ F, hdist z (g • z) ≤ δ) → N < F.ncard →
      ∃ g ∈ F, ∃ g' ∈ F, g ≠ g' ∧ NearIdAt (g⁻¹ * g') z η := by
  have hI' := HypIsoData.ofProp hI
  have hA' := POBasic.ofProp hA
  set r : ℝ := η / 8 with hrdef
  have hr : 0 < r := by rw [hrdef]; linarith
  set δ' : ℝ := 1 + r + δ with hd'def
  have hδ' : 0 ≤ δ' := by rw [hd'def]; linarith
  set ε : ℝ := η / 8 with hedef
  have hε : 0 < ε := by rw [hedef]; linarith
  set tE : ℝ := min 1 ((Real.cosh ε - 1) / (2 * Real.cosh δ')) with htEdef
  have htEpos : 0 < tE := by
    rw [htEdef]
    refine lt_min one_pos (div_pos ?_ ?_)
    · have h2 : 0 < ε := hε
      have := (Real.one_lt_cosh).mpr (ne_of_gt h2)
      linarith
    · positivity
  have htE0 : 0 ≤ tE := le_of_lt htEpos
  have hsmall : Real.arcosh (1 + 2 * Real.cosh δ' * tE) ≤ ε := by
    have htEle : tE ≤ (Real.cosh ε - 1) / (2 * Real.cosh δ') := min_le_right _ _
    have hpos : 0 < 2 * Real.cosh δ' := by positivity
    have h2 : 2 * Real.cosh δ' * tE ≤ Real.cosh ε - 1 := by
      calc 2 * Real.cosh δ' * tE ≤ 2 * Real.cosh δ' * ((Real.cosh ε - 1) / (2 * Real.cosh δ')) :=
            mul_le_mul_of_nonneg_left htEle (le_of_lt hpos)
        _ = Real.cosh ε - 1 := by field_simp
    have h1 : 1 + 2 * Real.cosh δ' * tE ≤ Real.cosh ε := by linarith
    have hpos1 : 0 < 1 + 2 * Real.cosh δ' * tE := by nlinarith [htE0, Real.cosh_pos δ']
    calc Real.arcosh (1 + 2 * Real.cosh δ' * tE) ≤ Real.arcosh (Real.cosh ε) :=
          (Real.arcosh_le_arcosh hpos1 (Real.cosh_pos ε)).mpr h1
      _ = ε := Real.arcosh_cosh (le_of_lt hε)
  obtain ⟨P, hPmem, hPdens⟩ := exists_net_ball n hI r hr
  set K : Set (P → E n) := Set.univ.pi (fun _ : P => {v : E n | hdist (0 : E n) v ≤ δ'})
    with hKdef
  have hKc : IsCompact K := by
    rw [hKdef]
    exact isCompact_univ_pi (fun _ => hI'.ball_compact 0 δ')
  obtain ⟨N, hN⟩ := pigeonhole_totBounded hKc.totallyBounded htEpos
  refine ⟨N, ?_⟩
  intro z F hF hshort hNF
  obtain ⟨h, hh0⟩ := (BoostTransitive n hA).1 z
  have hcfgK : ∀ g ∈ F, ∀ j : P, hdist (0 : E n) ((h⁻¹ * g * h) • (j : E n)) ≤ δ' := by
    intro g hg j
    have hmem : (fun j : P => (h⁻¹ * g * h) • (j : E n)) ∈ K := by
      rw [hKdef]
      intro i _
      calc hdist (0 : E n) ((h⁻¹ * g * h) • (i : E n))
          = hdist (h • (0 : E n)) (h • ((h⁻¹ * g * h) • (i : E n))) :=
              (hI'.isom_smul h 0 _).symm
        _ = hdist (h • (0 : E n)) (g • (h • (i : E n))) := by rw [smul_conj_left hA h g (i : E n)]
        _ ≤ hdist (h • (0 : E n)) (g • (h • (0 : E n))) +
            hdist (g • (h • (0 : E n))) (g • (h • (i : E n))) := hI'.triangle _ _ _
        _ = hdist z (g • z) + hdist (h • (0 : E n)) (h • (i : E n)) := by
              rw [hh0, hI'.isom_smul]
        _ ≤ δ + (1 + r) := by
              refine add_le_add (hshort g hg) ?_
              rw [hI'.isom_smul]
              exact hPmem _ i.2
        _ = δ' := by rw [hd'def]; ring
    exact hmem j trivial
  have hcfgKmem : ∀ g ∈ F, (fun j : P => (h⁻¹ * g * h) • (j : E n)) ∈ K := by
    intro g hg
    rw [hKdef]
    intro j _
    exact hcfgK g hg j
  -- pigeonhole
  obtain ⟨g₁, hg₁, g₂, hg₂, hne, hcloseE⟩ :=
    exists_cfg_close (f := fun g => fun j : P => (h⁻¹ * g * h) • (j : E n))
      hF hKc.totallyBounded hcfgKmem htE0 hN hNF
  refine ⟨g₁, hg₁, g₂, hg₂, hne, ?_⟩
  rw [← hh0]
  refine nearIdAt_of_cfg_close (r := r) (ε := ε) (δ' := δ') hA hI hPdens ?_ ?_ ?_
  · intro y hy
    exact ⟨hcfgK g₁ hg₁ ⟨y, hy⟩, hcfgK g₂ hg₂ ⟨y, hy⟩⟩
  · intro y hy
    have hE : dist ((h⁻¹ * g₁ * h) • y) ((h⁻¹ * g₂ * h) • y) ≤ tE := by
      have := (dist_pi_le_iff htE0).mp hcloseE ⟨y, hy⟩
      simpa using this
    have h := hdist_le_of_dist_le n hI hδ' htE0 (hcfgK g₁ hg₁ ⟨y, hy⟩) (hcfgK g₂ hg₂ ⟨y, hy⟩) hE
    linarith
  · rw [hrdef, hedef]; linarith


/-! ## Assembly -/

theorem frameThinFar (n : ℕ) (hn : 2 ≤ n) (hA : POActionProp n) (hI : HypIsometryProp n)
    (Γ : Subgroup (PO n 1)) (hdisc : IsDiscrete (SetLike.coe Γ)) (hmult : MultThickProp Γ) :
    ∀ η : ℝ, 0 < η → ∃ K : Set (E n), IsCompact K ∧ ∀ z : E n, (∀ γ : Γ, (γ : PO n 1) • z ∉ K) →
      ∃ γ : Γ, γ ≠ 1 ∧ NearIdAt (γ : PO n 1) z η := by
  intro η hη
  obtain ⟨N, hN⟩ := pigeonhole_short n hA hI 1 η (by norm_num) hη
  obtain ⟨K, hKc, hKprop⟩ := hmult 1 one_pos N
  refine ⟨K, hKc, ?_⟩
  intro z hz
  set S : Set Γ := {γ : Γ | hdist z ((γ : PO n 1) • z) < 1} with hSdef
  have hSfin : S.Finite := by
    refine (finite_shortAt n hA hI Γ hdisc z 1).subset ?_
    intro γ hγ
    have hγ' : hdist z ((γ : PO n 1) • z) < 1 := by simpa [hSdef] using hγ
    exact le_of_lt hγ'
  have hncard : N < S.ncard := by
    by_contra hcon
    have hle : S.ncard ≤ N := by omega
    obtain ⟨γ₀, hγ₀⟩ := hKprop z ⟨hSfin, hle⟩
    exact hz γ₀ hγ₀
  have hFfin : (((↑) : Γ → PO n 1) '' S).Finite := hSfin.image _
  have hFncard : (((↑) : Γ → PO n 1) '' S).ncard = S.ncard :=
    Set.InjOn.ncard_image (fun a _ b _ hab => Subtype.coe_injective hab)
  have hFshort : ∀ g ∈ (((↑) : Γ → PO n 1) '' S), hdist z (g • z) ≤ 1 := by
    rintro g ⟨γ, hγ, rfl⟩
    exact le_of_lt hγ
  obtain ⟨g, hg, g', hg', hne, hnear⟩ :=
    hN z _ hFfin hFshort (by rw [hFncard]; exact hncard)
  obtain ⟨γ, hγS, hγeq⟩ := hg
  obtain ⟨γ', hγ'S, hγ'eq⟩ := hg'
  have hnear' : NearIdAt (((γ : Γ) : PO n 1)⁻¹ * ((γ' : Γ) : PO n 1)) z η := by
    have h' := hnear
    rw [← hγeq, ← hγ'eq] at h'
    exact h'
  refine ⟨γ⁻¹ * γ', ?_, ?_⟩
  · intro h1
    refine hne ?_
    have h3 : ((γ⁻¹ * γ' : Γ) : PO n 1) = 1 := by
      rw [h1]
      rfl
    have h4 : ((γ : Γ) : PO n 1)⁻¹ * ((γ' : Γ) : PO n 1) = 1 := by
      simpa using h3
    have h2 : ((γ : Γ) : PO n 1) = ((γ' : Γ) : PO n 1) := by
      calc ((γ : Γ) : PO n 1)
          = ((γ : Γ) : PO n 1) *
              (((γ : Γ) : PO n 1)⁻¹ * ((γ' : Γ) : PO n 1)) := by rw [h4, mul_one]
        _ = ((γ' : Γ) : PO n 1) := by group
    rw [← hγeq, ← hγ'eq]
    exact h2
  · simpa using hnear'

end

