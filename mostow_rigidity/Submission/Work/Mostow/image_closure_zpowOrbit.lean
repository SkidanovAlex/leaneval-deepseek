import Mathlib
import Submission.Work.Mostow.poAux

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity

/-- The action map `u ↦ g • u` preserves the closure of the orbit of `u₀` under the cyclic
group generated by `g`.  The orbit itself is already invariant (up to the shift `m ↦ m+1`),
so the closure is invariant as well; this is where continuity of the action is used. -/
theorem image_closure_zpowOrbit (n : ℕ) (hA : Submission.Mostow.POActionProp n)
    (g : LeanEval.Geometry.MostowRigidity.PO n 1) (u₀ : Submission.Mostow.E n) :
    (fun u : Submission.Mostow.E n => g • u) ''
        closure (Set.range (fun m : ℤ => (g ^ m) • u₀)) =
      closure (Set.range (fun m : ℤ => (g ^ m) • u₀)) := by
  have hone : ∀ u : Submission.Mostow.E n, (1 : PO n 1) • u = u := hA.2.2.2.1
  have hmul : ∀ (a b : PO n 1) (u : Submission.Mostow.E n), (a * b) • u = a • (b • u) :=
    hA.2.2.2.2.1
  have hcont : Continuous (fun p : PO n 1 × Submission.Mostow.E n => p.1 • p.2) :=
    hA.2.2.2.2.2.2.1
  set S : Set (Submission.Mostow.E n) := Set.range (fun m : ℤ => (g ^ m) • u₀) with hS
  have hfcont : Continuous (fun u : Submission.Mostow.E n => g • u) :=
    hcont.comp (continuous_const.prodMk continuous_id)
  have hhcont : Continuous (fun u : Submission.Mostow.E n => g⁻¹ • u) :=
    hcont.comp (continuous_const.prodMk continuous_id)
  have hfh : ∀ x : Submission.Mostow.E n, g • (g⁻¹ • x) = x := by
    intro x
    rw [← hmul, mul_inv_cancel, hone]
  have hfS : (fun u : Submission.Mostow.E n => g • u) '' S = S := by
    rw [hS]
    have h2 : ((fun u : Submission.Mostow.E n => g • u) ∘ (fun m : ℤ => (g ^ m) • u₀))
        = ((fun m : ℤ => (g ^ m) • u₀) ∘ (fun m : ℤ => m + 1)) := by
      funext m
      simp only [Function.comp_apply]
      rw [← hmul]
      have hpow : g * g ^ m = g ^ (m + 1) := by
        rw [← zpow_one_add]
        congr 1
        ring
      rw [hpow]
    have h3 : Set.range ((fun m : ℤ => (g ^ m) • u₀) ∘ (fun m : ℤ => m + 1))
        = Set.range (fun m : ℤ => (g ^ m) • u₀) :=
      Function.Surjective.range_comp (fun y : ℤ => ⟨y - 1, by ring⟩)
        (fun m : ℤ => (g ^ m) • u₀)
    rw [← Set.range_comp, h2, h3]
  have hhS : (fun u : Submission.Mostow.E n => g⁻¹ • u) '' S = S := by
    rw [hS]
    have h2 : ((fun u : Submission.Mostow.E n => g⁻¹ • u) ∘ (fun m : ℤ => (g ^ m) • u₀))
        = ((fun m : ℤ => (g ^ m) • u₀) ∘ (fun m : ℤ => m - 1)) := by
      funext m
      simp only [Function.comp_apply]
      rw [← hmul]
      have hpow : g⁻¹ * g ^ m = g ^ (m - 1) := by
        rw [← zpow_neg_one, ← zpow_add]
        congr 1
        ring
      rw [hpow]
    have h3 : Set.range ((fun m : ℤ => (g ^ m) • u₀) ∘ (fun m : ℤ => m - 1))
        = Set.range (fun m : ℤ => (g ^ m) • u₀) :=
      Function.Surjective.range_comp (fun y : ℤ => ⟨y + 1, by ring⟩)
        (fun m : ℤ => (g ^ m) • u₀)
    rw [← Set.range_comp, h2, h3]
  apply Set.Subset.antisymm
  · calc (fun u : Submission.Mostow.E n => g • u) '' closure S
        ⊆ closure ((fun u : Submission.Mostow.E n => g • u) '' S) :=
          image_closure_subset_closure_image hfcont
      _ = closure S := by rw [hfS]
  · intro x hx
    have hsub : (fun u : Submission.Mostow.E n => g⁻¹ • u) '' closure S ⊆ closure S := by
      calc (fun u : Submission.Mostow.E n => g⁻¹ • u) '' closure S
          ⊆ closure ((fun u : Submission.Mostow.E n => g⁻¹ • u) '' S) :=
            image_closure_subset_closure_image hhcont
        _ = closure S := by rw [hhS]
    exact ⟨g⁻¹ • x, hsub ⟨x, hx, rfl⟩, hfh x⟩

end Work.Mostow
