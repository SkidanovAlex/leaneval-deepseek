import Mathlib
import Submission.Work.Mostow.tiDefs
import Submission.Work.Mostow.count_hits
import Submission.Work.Mostow.stab_eq_blk
import Submission.Work.Mostow.volH_le_card_mul_of_ae_count
import Submission.Work.Mostow.ae_subsingleton_smul_of_ae_eq_fundamentalDomain
import Submission.Work.Mostow.zero_stratum_slice
import Submission.Work.Mostow.resStd_zero

/-!
# `Work.Mostow.count_hits_zero`

The counting lemma behind the `m = 0` (empty normal fibre) case of the tube inequality
`Work.Mostow.tubeIneq`; it is the degenerate case `m = 0` of `Work.Mostow.count_hits`.

When `m = 0` the Fermi coordinates about the standard stratum degenerate: `E 0` is a point, the
normal coordinate is identically `0`, and the block decomposition of `PO (j + 0) 1 = PO j 1`
trivialises.  Consequently

* `Work.Mostow.resStd_zero`: `resStd j 0` is the identity, so the closed subgroup generated by the
  restricted centraliser `centralizer {blk j 0 1 R} ⊓ Λ` is `Λ` itself (via `hb1 : blk j 0 1 R = 1`)
  and the kernel-type set `{c ∈ Λ | c ∈ centralizer b ∧ resStd c = 1}` of the general fibre count is
  the singleton `{1}` (`Nat.card K = 1`);
* `Work.Mostow.zero_stratum_slice`: the tube slice `tiTubeSlice j 0 DY ρ` agrees a.e. with the
  fundamental domain `DY` itself;
* `Work.Mostow.ae_subsingleton_smul_of_ae_eq_fundamentalDomain`: for a.e. `z` at most one orbit point
  `γ • z` lies in any set that agrees a.e. with a fundamental domain.

So the orbit points of a.e. `z` that land in the tube slice are unique, and the fibre count is
bounded by `Nat.card K = 1`.
-/

namespace Work.Mostow

set_option linter.style.haveILetI false

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory
open scoped Pointwise

noncomputable section

/-- For `m = 0` the closed subgroup generated by the restricted centraliser is `Λ` itself:
`resStd j 0` is the identity and `centralizer {blk j 0 1 R} = centralizer {1} = ⊤`. -/
private lemma closure_resStd_eq (j : ℕ) (hAj : POActionProp j) (hIj : HypIsometryProp j)
    (hA : POActionProp (j + 0)) (hI : HypIsometryProp (j + 0))
    (Λ : Subgroup (PO (j + 0) 1)) (R : E 0 ≃ₗᵢ[ℝ] E 0) (hb1 : blk j 0 1 R = 1) :
    Subgroup.closure (resStd j 0 ''
        ((Subgroup.centralizer {blk j 0 1 R} ⊓ Λ : Subgroup (PO (j + 0) 1)) :
          Set (PO (j + 0) 1))) = Λ := by
  have hcent : Subgroup.centralizer ({blk j 0 1 R} : Set (PO (j + 0) 1)) = ⊤ := by
    rw [hb1]
    ext g
    simp [Subgroup.mem_centralizer_iff]
  have himg : resStd j 0 '' (Λ : Set (PO (j + 0) 1)) = (Λ : Set (PO (j + 0) 1)) := by
    rw [show resStd j 0 = (id : PO (j + 0) 1 → PO (j + 0) 1) from
      funext fun g => resStd_zero j hAj hIj hA hI g, Set.image_id]
  calc Subgroup.closure (resStd j 0 ''
        ((Subgroup.centralizer {blk j 0 1 R} ⊓ Λ : Subgroup (PO (j + 0) 1)) :
          Set (PO (j + 0) 1)))
      = Subgroup.closure (resStd j 0 '' (Λ : Set (PO (j + 0) 1))) := by
        rw [hcent, top_inf_eq]
    _ = Subgroup.closure (Λ : Set (PO (j + 0) 1)) := by rw [himg]
    _ = Λ := Subgroup.closure_eq Λ

/-- The kernel-type set is a singleton. -/
private lemma card_K_eq_one (j : ℕ) (hAj : POActionProp j) (hIj : HypIsometryProp j)
    (hA : POActionProp (j + 0)) (hI : HypIsometryProp (j + 0))
    (Λ : Subgroup (PO (j + 0) 1)) (R : E 0 ≃ₗᵢ[ℝ] E 0) :
    Nat.card {c : PO (j + 0) 1 // c ∈ Λ ∧ c ∈ Subgroup.centralizer {blk j 0 1 R} ∧
      resStd j 0 c = 1} = 1 := by
  have key : ∀ c : {c : PO (j + 0) 1 // c ∈ Λ ∧
      c ∈ Subgroup.centralizer {blk j 0 1 R} ∧ resStd j 0 c = 1}, c.1 = 1 := by
    intro c
    have h := c.2.2.2
    rwa [resStd_zero j hAj hIj hA hI c.1] at h
  refine Nat.card_eq_one_iff_unique.mpr ⟨⟨fun a b => Subtype.ext ?_⟩, ⟨⟨1, ?_⟩⟩⟩
  · rw [key a, key b]
  · exact ⟨Subgroup.one_mem Λ, Subgroup.one_mem _, by rw [resStd_zero j hAj hIj hA hI]⟩

theorem count_hits_zero (j : ℕ) (hAj : Submission.Mostow.POActionProp j) (hIj : Submission.Mostow.HypIsometryProp j)
    (hA : Submission.Mostow.POActionProp (j + 0)) (hI : Submission.Mostow.HypIsometryProp (j + 0))
    (Λ : Subgroup (LeanEval.Geometry.MostowRigidity.PO (j + 0) 1)) (hdisc : IsDiscrete (SetLike.coe Λ))
    (R : Submission.Mostow.E 0 ≃ₗᵢ[ℝ] Submission.Mostow.E 0)
    (hb1 : Submission.Mostow.blk j 0 1 R = 1) (hR : ∀ w : Submission.Mostow.E 0, R w = w → w = 0)
    (DY : Set (Submission.Mostow.E j))
    (hDY : MeasureTheory.IsFundamentalDomain
        (Subgroup.closure (Submission.Mostow.resStd j 0 '' ((Subgroup.centralizer {Submission.Mostow.blk j 0 1 R} ⊓ Λ : Subgroup (LeanEval.Geometry.MostowRigidity.PO (j + 0) 1)) : Set (LeanEval.Geometry.MostowRigidity.PO (j + 0) 1))))
        DY (Submission.Mostow.volH j))
    (D : Set (Submission.Mostow.E (j + 0))) (hD : MeasureTheory.IsFundamentalDomain Λ D (Submission.Mostow.volH (j + 0)))
    (ρ η₁ : ℝ) (hρ : 0 ≤ ρ)
    (htube : ∀ u : Submission.Mostow.E (j + 0), u ∈ Submission.Mostow.tube j 0 ρ → Submission.Mostow.NearIdAt (Submission.Mostow.blk j 0 1 R) u η₁)
    (hKfin : Finite {c : LeanEval.Geometry.MostowRigidity.PO (j + 0) 1 // c ∈ Λ ∧ c ∈ Subgroup.centralizer {Submission.Mostow.blk j 0 1 R} ∧ Submission.Mostow.resStd j 0 c = 1}) :
    ∀ᵐ z ∂((Submission.Mostow.volH (j + 0)).restrict D),
      ∃ s : Finset Λ,
        s.card ≤ Nat.card {c : LeanEval.Geometry.MostowRigidity.PO (j + 0) 1 // c ∈ Λ ∧ c ∈ Subgroup.centralizer {Submission.Mostow.blk j 0 1 R} ∧ Submission.Mostow.resStd j 0 c = 1} ∧
        ∀ γ : Λ, (γ : LeanEval.Geometry.MostowRigidity.PO (j + 0) 1) • z ∈ Work.Mostow.tiTubeSlice j 0 DY ρ → γ ∈ s := by
  classical
  have hgroup := closure_resStd_eq j hAj hIj hA hI Λ R hb1
  rw [hgroup] at hDY
  have hKcard := card_K_eq_one j hAj hIj hA hI Λ R
  have hId : HypIsoData (j + 0) := HypIsoData.ofProp hI
  letI : MulAction (PO (j + 0) 1) (E (j + 0)) :=
    { one_smul := fun u => poOneSMul u
      mul_smul := fun g h u => poMulSMul g h u }
  letI : MulAction Λ (E (j + 0)) := inferInstance
  haveI : MeasurableConstSMul Λ (E (j + 0)) :=
    ⟨fun c => (hId.contDiff_smul (c : PO (j + 0) 1)).continuous.measurable⟩
  haveI : SMulInvariantMeasure Λ (E (j + 0)) (volH (j + 0)) :=
    ⟨fun c s hs => (hId.measurePreserving_smul (c : PO (j + 0) 1)).measure_preimage hs.nullMeasurableSet⟩
  haveI : Countable Λ := countable_of_isDiscrete (PO (j + 0) 1) hdisc
  have hslice : tiTubeSlice j 0 DY ρ =ᵐ[volH (j + 0)] DY :=
    zero_stratum_slice j DY hDY.nullMeasurableSet ρ hρ
  have hsub : ∀ᵐ z ∂(volH (j + 0)),
      ∀ γ₁ γ₂ : Λ, γ₁ • z ∈ tiTubeSlice j 0 DY ρ → γ₂ • z ∈ tiTubeSlice j 0 DY ρ → γ₁ = γ₂ :=
    ae_subsingleton_smul_of_ae_eq_fundamentalDomain (volH (j + 0)) hDY hslice
  have hsub' : ∀ᵐ z ∂((volH (j + 0)).restrict D),
      ∀ γ₁ γ₂ : Λ, (γ₁ : PO (j + 0) 1) • z ∈ tiTubeSlice j 0 DY ρ →
        (γ₂ : PO (j + 0) 1) • z ∈ tiTubeSlice j 0 DY ρ → γ₁ = γ₂ := by
    refine (MeasureTheory.ae_mono Measure.restrict_le_self ?_)
    filter_upwards [hsub] with z hz γ₁ γ₂ h₁ h₂
    exact hz γ₁ γ₂ h₁ h₂
  filter_upwards [hsub'] with z hz
  by_cases h : ∃ γ : Λ, (γ : PO (j + 0) 1) • z ∈ tiTubeSlice j 0 DY ρ
  · refine ⟨{Classical.choose h}, ?_, ?_⟩
    · rw [Finset.card_singleton, hKcard]
    · intro γ hγ
      rw [Finset.mem_singleton]
      exact hz γ (Classical.choose h) hγ (Classical.choose_spec h)
  · refine ⟨∅, ?_, ?_⟩
    · rw [Finset.card_empty]
      exact Nat.zero_le _
    · intro γ hγ
      exact absurd ⟨γ, hγ⟩ h


end

end Work.Mostow
