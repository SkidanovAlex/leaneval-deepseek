import Mathlib
import Submission.Work.Mostow.gapA.nilpotentPairNearIdAt
import Submission.Work.Mostow.frobeniusCommute
import Submission.Work.Mostow.nilp_torsionGen_finite
import Submission.Work.Mostow.boundedTorsionAux
import Submission.Work.Mostow.finiteClosureNearIdAt
import Submission.Work.Mostow.conjCountGeodV2

/-!
# Two torsion near-identity elements of a discrete subgroup commute

Let `Λ ≤ PO(n,1)` be discrete (`n ≥ 2`) and let `a, c ∈ Λ` be two elements which are
near the identity at a common point `u` (within a universal tolerance `θ`), each of which
fixes some point of `ℍⁿ`, and which are near the identity at *every* one of their own fixed
points.

Then `a` and `c` have a common fixed point and commute.

The proof uses the two Zassenhaus-type inputs:

* `nilpotentPairNearIdAt`: the subgroup `⟨a, c⟩` is nilpotent;
* `isOfFinOrder_of_fixed`: `a` and `c` have finite order (they lie in a discrete subgroup and
  fix a point), so `nilp_torsionGen_finite` makes `⟨a, c⟩` finite;

a finite subgroup of `PO(n,1)` fixes a point (`fixPoint_of_finite`), which is then a common
fixed point of `a` and `c`; finally `frobeniusCommute` gives commutativity from being
near-identity at that common fixed point.
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory

noncomputable section

theorem nearIdPairCommuteTorsion (m : ℕ) (hm : 2 ≤ 1 + m)
    (hA : Submission.Mostow.POActionProp (1 + m)) (hI : Submission.Mostow.HypIsometryProp (1 + m)) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (Λ : Subgroup (LeanEval.Geometry.MostowRigidity.PO (1 + m) 1)),
      _root_.IsDiscrete (SetLike.coe Λ) →
      ∀ (a c : LeanEval.Geometry.MostowRigidity.PO (1 + m) 1) (u : Submission.Mostow.E (1 + m)),
        a ∈ Λ → c ∈ Λ →
        Submission.Mostow.NearIdAt a u θ → Submission.Mostow.NearIdAt c u θ →
        (∃ x : Submission.Mostow.E (1 + m), a • x = x) → (∃ x : Submission.Mostow.E (1 + m), c • x = x) →
        (∀ x : Submission.Mostow.E (1 + m), a • x = x → Submission.Mostow.NearIdAt a x θ) →
        (∀ x : Submission.Mostow.E (1 + m), c • x = x → Submission.Mostow.NearIdAt c x θ) →
        ∃ p : Submission.Mostow.E (1 + m), a • p = p ∧ c • p = p ∧ a * c = c * a := by
  obtain ⟨θ₁, hθ₁pos, hθ₁⟩ :=
    Work.Mostow.gapA.nilpotentPairNearIdAt (1 + m) hm hA hI
  obtain ⟨θ₂, hθ₂pos, hθ₂⟩ := Work.Mostow.frobeniusCommute (1 + m) hm hA hI
  refine ⟨min θ₁ θ₂, lt_min hθ₁pos hθ₂pos, ?_⟩
  intro Λ hdisc a c u ha hc haN hcN hfixA hfixC hafix hcfix
  have hθle₁ : min θ₁ θ₂ ≤ θ₁ := min_le_left _ _
  have hθle₂ : min θ₁ θ₂ ≤ θ₂ := min_le_right _ _
  have ha₁ : NearIdAt a u θ₁ := NearIdAt.mono haN hθle₁
  have hc₁ : NearIdAt c u θ₁ := NearIdAt.mono hcN hθle₁
  -- nilpotency of `⟨a, c⟩`
  have hnil : Group.IsNilpotent (Subgroup.closure ({a, c} : Set (PO (1 + m) 1))) := by
    have h := hθ₁ Λ hdisc u (⟨a, ha⟩ : ↥Λ) (⟨c, hc⟩ : ↥Λ)
      (by simpa using ha₁) (by simpa using hc₁)
    simpa using h
  -- `a` and `c` are torsion
  have htorA : IsOfFinOrder a := by
    obtain ⟨pa, hpa⟩ := hfixA
    have h := Work.Mostow.isOfFinOrder_of_fixed hA hI Λ hdisc (⟨a, ha⟩ : ↥Λ) pa
      (by simpa using hpa)
    exact (Submonoid.isOfFinOrder_coe (x := (⟨a, ha⟩ : ↥Λ))).mpr h
  have htorC : IsOfFinOrder c := by
    obtain ⟨pc, hpc⟩ := hfixC
    have h := Work.Mostow.isOfFinOrder_of_fixed hA hI Λ hdisc (⟨c, hc⟩ : ↥Λ) pc
      (by simpa using hpc)
    exact (Submonoid.isOfFinOrder_coe (x := (⟨c, hc⟩ : ↥Λ))).mpr h
  -- the subgroup generated by `a` and `c`
  set H : Subgroup (PO (1 + m) 1) := Subgroup.closure ({a, c} : Set (PO (1 + m) 1)) with hHdef
  have haH : a ∈ H := by rw [hHdef]; exact Subgroup.subset_closure (by simp)
  have hcH : c ∈ H := by rw [hHdef]; exact Subgroup.subset_closure (by simp)
  haveI hnilH : Group.IsNilpotent H := by rw [hHdef]; exact hnil
  haveI hfgH : Group.FG H :=
    (Group.fg_iff_subgroup_fg H).mpr
      ((Subgroup.fg_iff H).mpr ⟨{a, c}, hHdef.symm, (Set.finite_singleton c).insert a⟩)
  have htorHa : IsOfFinOrder (⟨a, haH⟩ : H) :=
    (Submonoid.isOfFinOrder_coe (x := (⟨a, haH⟩ : H))).mp htorA
  have htorHc : IsOfFinOrder (⟨c, hcH⟩ : H) :=
    (Submonoid.isOfFinOrder_coe (x := (⟨c, hcH⟩ : H))).mp htorC
  -- `H` is generated by torsion elements
  have hgen : Subgroup.closure {h : H | IsOfFinOrder h} = ⊤ := by
    apply Subgroup.map_injective (Subgroup.subtype_injective H)
    rw [MonoidHom.map_closure, Subgroup.map_top, Subgroup.subtype_range]
    apply le_antisymm
    · rw [Subgroup.closure_le]
      rintro x ⟨h, hh, rfl⟩
      exact h.2
    · rw [hHdef, Subgroup.closure_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hx | hx
      · rw [hx]
        exact Subgroup.subset_closure ⟨⟨a, haH⟩, htorHa, rfl⟩
      · rw [hx]
        exact Subgroup.subset_closure ⟨⟨c, hcH⟩, htorHc, rfl⟩
  have hHfin : Finite H := Work.Mostow.nilp_torsionGen_finite hgen
  -- a finite subgroup of `PO(n,1)` fixes a point
  obtain ⟨p, hp⟩ := Work.Mostow.fixPoint_of_finite hA H hHfin
  have hap : a • p = p := hp a haH
  have hcp : c • p = p := hp c hcH
  have ha₂ : NearIdAt a p θ₂ := NearIdAt.mono (hafix p hap) hθle₂
  have hc₂ : NearIdAt c p θ₂ := NearIdAt.mono (hcfix p hcp) hθle₂
  exact ⟨p, hap, hcp, hθ₂ H hHfin p hp a haH c hcH ha₂ hc₂⟩

end

end Work.Mostow
