import Mathlib
import Submission.Work.Mostow.hlDefsAccess
import Submission.Work.Mostow.nilp_torsionGen_finite
import Submission.Work.Mostow.finite_nearStab

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory

/-!
# The Zassenhaus closure of a near-identity family is finite

Let `Γ ≤ PO n 1` be discrete and suppose that for every discrete subgroup the subgroup generated
by a family of "near identity at `z`" elements is nilpotent (`hZass`). Given a finite family
`S ⊆ Γ` of near-identity elements, each of which fixes some point of `ℍⁿ`, the subgroup generated
by `S` is finite.

The two ingredients are:

* every element of `S` has finite order, because an element of infinite order in a discrete
  subgroup acts without fixed points (`isOfFinOrder_of_fixed`, whose proof uses that the powers of a
  fixed-point-free-of-infinite-order element would give infinitely many elements displacing the
  origin by a bounded amount, contradicting `finite_nearStab`);
* a finitely generated nilpotent group generated by torsion elements is finite
  (`nilp_torsionGen_finite`).

The subgroup `⟨S⟩` sits inside the nilpotent subgroup given by `hZass`, hence is nilpotent itself.

## Main result

* `Work.Mostow.finiteClosureNearIdAt`
-/

/-- A subgroup of a nilpotent subgroup is nilpotent. -/
theorem isNilpotent_of_le_of_isNilpotent {G : Type*} [Group G] {H K : Subgroup G}
    (hle : H ≤ K) [hK : Group.IsNilpotent ↥K] : Group.IsNilpotent ↥H := by
  obtain ⟨m, hm⟩ := (Subgroup.isNilpotent_iff_lowerCentralSeries K).mp hK
  exact (Subgroup.isNilpotent_iff_lowerCentralSeries H).mpr
    ⟨m, le_bot_iff.mp (le_trans (Subgroup.lowerCentralSeries_mono m hle) (le_of_eq hm))⟩

/-- An element of a discrete subgroup of `PO n 1` that fixes a point of `ℍⁿ` has finite order.

If it had infinite order, its distinct powers would all fix `p`, hence would displace the origin by
at most `2 * hdist 0 p`; but the set of elements of `Γ` displacing the origin by a bounded amount is
finite (`finite_nearStab`). -/
theorem isOfFinOrder_of_fixed {n : ℕ} (hA : POActionProp n) (hI : HypIsometryProp n)
    (Γ : Subgroup (PO n 1)) (hdisc : IsDiscrete (SetLike.coe Γ))
    (γ : Γ) (p : E n) (hp : (γ : PO n 1) • p = p) : IsOfFinOrder γ := by
  by_contra hinf
  have hpb := POBasic.ofProp hA
  have hid := HypIsoData.ofProp hI
  -- every power of `γ` fixes `p`
  have hfixk : ∀ k : ℕ, ((γ ^ k : Γ) : PO n 1) • p = p := by
    intro k
    induction k with
    | zero => simpa using hpb.one_smul p
    | succ k ih =>
        rw [pow_succ, Subgroup.coe_mul, hpb.mul_smul, hp, ih]
  -- hence all powers displace the origin by at most `2 * hdist 0 p`
  have hmem : ∀ k : ℕ, (γ ^ k) ∈
      {γ' : Γ | hdist (0 : E n) ((γ' : PO n 1) • (0 : E n)) ≤ 2 * hdist (0 : E n) p} := by
    intro k
    have h1 := hid.triangle (0 : E n) p (((γ ^ k : Γ) : PO n 1) • (0 : E n))
    have h2 : hdist p (((γ ^ k : Γ) : PO n 1) • (0 : E n)) = hdist (0 : E n) p := by
      have h3 := hid.isom_smul (((γ ^ k : Γ) : PO n 1)) p (0 : E n)
      rw [hfixk k] at h3
      rw [h3, hid.symm]
    rw [h2] at h1
    simp only [Set.mem_ofPred_eq]
    linarith
  -- the near-stabiliser of the origin is finite, a contradiction
  have hfin := finite_nearStab hpb hid hdisc (2 * hdist (0 : E n) p)
  have hrange : (Set.range (fun k : ℕ => γ ^ k)).Finite :=
    hfin.subset (by rintro x ⟨k, rfl⟩; exact hmem k)
  exact Set.infinite_range_of_injective (injective_pow_iff_not_isOfFinOrder.mpr hinf) hrange

theorem finiteClosureNearIdAt (n : ℕ) (hn : 2 ≤ n) (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n)
    (η : ℝ) (hη : 0 < η)
    (hZass : ∀ (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)),
      IsDiscrete (SetLike.coe Γ) → ∀ z : Submission.Mostow.E n,
      Group.IsNilpotent (Subgroup.closure
        {γ : Γ | Submission.Mostow.NearIdAt (γ : LeanEval.Geometry.MostowRigidity.PO n 1) z η}))
    (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)) (hdisc : IsDiscrete (SetLike.coe Γ))
    (S : Finset Γ) (z : Submission.Mostow.E n)
    (hS : ∀ σ ∈ S, Submission.Mostow.NearIdAt (σ : LeanEval.Geometry.MostowRigidity.PO n 1) z η)
    (hell : ∀ σ ∈ S, ∃ p : Submission.Mostow.E n,
      (σ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p) :
    Finite (Subgroup.closure (↑S : Set Γ)) := by
  set H : Subgroup Γ := Subgroup.closure (↑S : Set Γ) with hH
  -- the ambient near-identity subgroup of `hZass` is nilpotent
  haveI hnilK : Group.IsNilpotent
      (Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η}) := hZass Γ hdisc z
  -- `⟨S⟩` sits inside it
  have hle : H ≤ Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η} := by
    rw [hH]
    exact Subgroup.closure_mono (fun x hx => hS x (Finset.mem_coe.mp hx))
  haveI hnilH : Group.IsNilpotent ↥H := isNilpotent_of_le_of_isNilpotent hle
  -- `⟨S⟩` is finitely generated
  haveI hfgH : Group.FG ↥H := (Group.fg_iff_subgroup_fg H).mpr ⟨S, hH.symm⟩
  -- every element of `S` has finite order
  have htorS : ∀ s : Γ, s ∈ (↑S : Set Γ) → IsOfFinOrder s := by
    intro s hs
    obtain ⟨p, hp⟩ := hell s (Finset.mem_coe.mp hs)
    exact isOfFinOrder_of_fixed hA hI Γ hdisc s p hp
  -- `⟨S⟩` is generated by torsion elements
  have hgen : Subgroup.closure {h : ↥H | IsOfFinOrder h} = ⊤ := by
    have hmap : Subgroup.map (Subgroup.subtype H) (Subgroup.closure {h : ↥H | IsOfFinOrder h})
        = Subgroup.map (Subgroup.subtype H) ⊤ := by
      rw [MonoidHom.map_closure, Subgroup.map_top, Subgroup.subtype_range]
      apply le_antisymm
      · rw [Subgroup.closure_le]
        rintro x ⟨h, hh, rfl⟩
        exact h.2
      · rw [hH]
        refine Subgroup.closure_mono ?_
        intro s hs
        have hsH : s ∈ H := by rw [hH]; exact Subgroup.subset_closure hs
        refine ⟨⟨s, hsH⟩, ?_, rfl⟩
        exact (Submonoid.isOfFinOrder_coe (x := (⟨s, hsH⟩ : ↥H))).mp (by simpa using htorS s hs)
    exact Subgroup.map_injective (Subgroup.subtype_injective H) hmap
  exact nilp_torsionGen_finite hgen

end Work.Mostow
