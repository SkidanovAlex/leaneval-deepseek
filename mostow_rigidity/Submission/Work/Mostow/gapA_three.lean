noncomputable section

/-- Membership of a subgroup does not change the order. -/
lemma isOfFinOrder_subgroup_coe_iff {G : Type*} [Group G] (H : Subgroup G) (g : H) :
    IsOfFinOrder (g : G) ↔ IsOfFinOrder g := by
  rw [← orderOf_pos_iff, ← orderOf_pos_iff, Subgroup.orderOf_coe]

lemma one_le_sinh_one : (1 : ℝ) ≤ Real.sinh 1 := by
  have h := Real.sinh_add (1 / 2 : ℝ) (1 / 2)
  rw [show (1 / 2 : ℝ) + 1 / 2 = 1 by norm_num] at h
  have h1 : (1 / 2 : ℝ) ≤ Real.sinh (1 / 2) := Real.self_le_sinh_iff.mpr (by norm_num)
  have h2 : (1 : ℝ) ≤ Real.cosh (1 / 2) := Real.one_le_cosh _
  have h3 : 0 < Real.sinh (1 / 2) := Real.sinh_pos_iff.mpr (by norm_num)
  have h4 : 0 < Real.cosh (1 / 2) := Real.cosh_pos _
  nlinarith [h, h1, h2, h3, h4]

lemma sinh_one_lt_two : Real.sinh 1 < 2 := by
  have h : Real.sinh 1 ≤ Real.exp 1 / 2 := by
    rw [Real.sinh_eq]
    have := Real.exp_pos (-1 : ℝ)
    linarith
  have he : Real.exp 1 < 4 := by linarith [Real.exp_one_lt_d9]
  linarith

lemma cosh_lt_two_of_le_half {y : ℝ} (hy0 : 0 ≤ y) (hy1 : y ≤ 1 / 2) : Real.cosh y < 2 := by
  have hexp : Real.exp (1 / 2 : ℝ) < 2 := by
    have hsq : Real.exp (1 / 2 : ℝ) ^ 2 = Real.exp 1 := by
      rw [← Real.exp_nat_mul]; norm_num
    have hlt : Real.exp (1 / 2 : ℝ) ^ 2 < 4 := by rw [hsq]; linarith [Real.exp_one_lt_d9]
    nlinarith [Real.exp_pos (1 / 2 : ℝ)]
  have h1 : Real.cosh y ≤ Real.exp y := by
    rw [Real.cosh_eq]
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 2)]
    have h := Real.exp_le_exp.mpr (by linarith : -y ≤ y)
    linarith
  exact lt_of_le_of_lt (le_trans h1 (Real.exp_le_exp.mpr hy1)) hexp

lemma sinh_le_two_mul {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 2) : Real.sinh x ≤ 2 * x := by
  have hmono : StrictMonoOn (fun y : ℝ => 2 * y - Real.sinh y) (Set.Icc 0 (1 / 2 : ℝ)) := by
    apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
    · exact ((continuous_const.mul continuous_id).sub Real.continuous_sinh).continuousOn
    · intro y hy
      have hyI : y ∈ Set.Ioo (0 : ℝ) (1 / 2) := by simpa [interior_Icc] using hy
      have hd : deriv (fun y : ℝ => 2 * y - Real.sinh y) y = 2 - Real.cosh y := by
        have h1 : HasDerivAt (fun y : ℝ => 2 * y - Real.sinh y) (2 * (1 : ℝ) - Real.cosh y) y :=
          ((hasDerivAt_id y).const_mul (2 : ℝ)).sub (Real.hasDerivAt_sinh y)
        simpa using h1.deriv
      rw [hd]
      have hc := cosh_lt_two_of_le_half hyI.1.le hyI.2.le
      linarith
  have hG : 0 ≤ 2 * x - Real.sinh x := by
    have h := (hmono.le_iff_le (show (0 : ℝ) ∈ Set.Icc 0 (1 / 2) by norm_num) ⟨hx0, hx1⟩).mpr hx0
    simpa using h
  linarith

/-- **The torsion branch of `gapA_three`**, assembled from the design pieces S3--S10. -/
theorem torsionBranch_of_pieces (hA : POActionProp 3) (hI : HypIsometryProp 3)
    (Γ : Subgroup (PO 3 1)) (hΓ : HypLattice Γ) (ε : ℝ) (hε : 0 < ε)
    (hrot : ∀ (f : PO 3 1) (z : E 3) (η : ℝ), f ≠ 1 → IsOfFinOrder f → f ∈ Γ → 0 < η → η ≤ 1 →
      NearIdAt f z η → RotData Γ f z η)
    (hconj : ∃ η_Z : ℝ, 0 < η_Z ∧ ∀ (M : ℕ), 3 ≤ M → ∀ (a b : E 3), a ∈ Sph 3 → b ∈ Sph 3 →
      a ≠ b → ∀ (b₀ : PO 3 1), b₀ ∈ Γ → IsRotationAbout b₀ a b (2 * Real.pi / (M : ℝ)) →
      ∀ (η₁ : ℝ), 0 < η₁ → η₁ ≤ η_Z → ∀ (w : E 3) (γ : PO 3 1), γ ∈ Γ → NearIdAt b₀ w η₁ →
      NearIdAt (γ⁻¹ * b₀ * γ) w η₁ → γ⁻¹ * b₀ * γ = b₀ ∨ γ⁻¹ * b₀ * γ = b₀⁻¹)
    (hunfold : ∀ (b₀ : PO 3 1) (η₁ : ℝ),
      (∀ (w : E 3) (γ : PO 3 1), γ ∈ Γ → NearIdAt b₀ w η₁ → NearIdAt (γ⁻¹ * b₀ * γ) w η₁ →
        γ⁻¹ * b₀ * γ = b₀ ∨ γ⁻¹ * b₀ * γ = b₀⁻¹) →
      ∀ (D Dc : Set (E 3)), MeasureTheory.IsFundamentalDomain ↥Γ D (volH 3) →
        MeasureTheory.IsFundamentalDomain
          ↥(Subgroup.centralizer ({b₀} : Set (PO 3 1)) ⊓ Γ) Dc (volH 3) →
        volH 3 (Tb b₀ η₁ ∩ Dc) ≤ 2 * volH 3 D)
    (htube : ∀ (a b : E 3) (M : ℕ) (b₀ : PO 3 1), a ∈ Sph 3 → b ∈ Sph 3 → a ≠ b → 0 < M →
      b₀ ∈ Γ → IsRotationAbout b₀ a b (2 * Real.pi / (M : ℝ)) →
      (∀ g : PO 3 1, g ∈ Γ → (∀ u : E 3, u ∈ geodSet a b → g • u = u) →
        (∃ k : ℤ, g = b₀ ^ k) ∨ ¬ IsOriented g) →
      ∀ (D : Set (E 3)), MeasureTheory.IsFundamentalDomain ↥Γ D (volH 3) →
      ∀ (η₁ : ℝ), 0 < η₁ → ∀ (ρ : ℝ), 0 < ρ →
      2 * Real.sinh (ρ + 1) * Real.sin (Real.pi / (M : ℝ)) ≤ η₁ →
      ((∃ (g : PO 3 1) (ℓ : ℝ) (Dc : Set (E 3)), 0 < ℓ ∧
          g ∈ Subgroup.centralizer ({b₀} : Set (PO 3 1)) ⊓ Γ ∧
          (∀ u : E 3, u ∈ geodSet a b → hdist u (g • u) = ℓ) ∧
          MeasureTheory.IsFundamentalDomain
            ↥(Subgroup.centralizer ({b₀} : Set (PO 3 1)) ⊓ Γ) Dc (volH 3) ∧
          ENNReal.ofReal (ℓ * (Real.pi / (M : ℝ)) * (Real.sinh ρ) ^ 2 / 2) ≤
            volH 3 (Tb b₀ η₁ ∩ Dc)) ∨
        (∀ Dc : Set (E 3),
          MeasureTheory.IsFundamentalDomain
            ↥(Subgroup.centralizer ({b₀} : Set (PO 3 1)) ⊓ Γ) Dc (volH 3) →
          volH 3 (Tb b₀ η₁ ∩ Dc) = ⊤)))
    (hnumeric : ∀ (M : ℕ) (b₀ g : PO 3 1) (ℓ η η_Z V r : ℝ) (z : E 3),
      3 ≤ M → 0 < ℓ → 0 ≤ V → 0 < η_Z → 0 < η → η ≤ η_Z / 5 → 0 ≤ r →
      ℓ * (Real.pi / (M : ℝ)) * (Real.sinh (tubeR M η_Z)) ^ 2 / 2 ≤ 2 * V →
      Real.sinh (r + 1) * Real.sin (Real.pi / (M : ℝ)) ≤ η / 2 →
      hdist z ((g * b₀) • z) ≤ 2 * (ℓ + Real.pi / (M : ℝ)) * Real.cosh r →
      hdist z ((g * b₀) • z) ≤ 300 * (V / η_Z ^ 2 + 1) * η)
    (hdeep : ∀ (a b : E 3) (ha : a ∈ Sph 3) (hb : b ∈ Sph 3) (hab : a ≠ b)
      (f : PO 3 1) (z : E 3) (θ : ℝ) (hf1 : f ≠ 1) (hf : IsRotationAbout f a b θ)
      (M : ℕ) (b₀ : PO 3 1) (hMb : orderOf b₀ = M) (hfpow : ∃ k : ℤ, f = b₀ ^ k)
      (hθord : 2 ≤ (orderOf f : ℝ) * Real.sin (θ / 2))
      (η : ℝ) (hη : 0 < η) (hη1 : η ≤ 1) (hnear : NearIdAt f z η),
      Real.sinh (distGeod a b z + 1) * Real.sin (Real.pi / (M : ℝ)) ≤
          Real.pi / 2 * Real.sinh (η / 2) ∧ 3 ≤ M)
    (hexFD : ∀ (H : Subgroup (PO 3 1)), IsDiscrete (SetLike.coe H) →
      ∃ D : Set (E 3), MeasureTheory.IsFundamentalDomain ↥H D (volH 3))
    (hrg : ∀ (a b u : E 3), a ∈ Sph 3 → b ∈ Sph 3 → a ≠ b → 0 ≤ distGeod a b u)
    (hplus : ∀ (a b : E 3), a ∈ Sph 3 → b ∈ Sph 3 → a ≠ b → ∀ w : E 3,
      ∃ u : E 3, hdist w u ≤ 1 ∧ distGeod a b w + 1 ≤ distGeod a b u)
    (hscrew : ∀ (a b : E 3) (M : ℕ) (b₀ g : PO 3 1), a ∈ Sph 3 → b ∈ Sph 3 → a ≠ b → 0 < M →
      IsRotationAbout b₀ a b (2 * Real.pi / (M : ℝ)) → ∀ (ℓ : ℝ) (z : E 3), 0 < ℓ →
      (∀ u : E 3, u ∈ geodSet a b → hdist u (g • u) = ℓ) → g * b₀ = b₀ * g →
      ∃ j : ℤ, ¬ IsOfFinOrder (g * b₀ ^ j) ∧
        hdist z ((g * b₀ ^ j) • z) ≤ 2 * (ℓ + Real.pi / (M : ℝ)) * Real.cosh (distGeod a b z)) :
    ∃ η_c : ℝ, 0 < η_c ∧ ∀ (η : ℝ), 0 < η → η ≤ η_c → ∀ (z : E 3) (f : Γ),
      f ≠ 1 → IsOfFinOrder (f : PO 3 1) → NearIdAt (f : PO 3 1) z η →
      ∃ g : Γ, ¬ IsOfFinOrder (g : Γ) ∧ hdist z ((g : PO 3 1) • z) < ε := by
  obtain ⟨η_Z, hηZ0, hconjZ⟩ := hconj
  obtain ⟨hdisc, D, hD, hVne⟩ := hΓ
  set V : ℝ := (volH 3 D).toReal with hVdef
  have hVnn : 0 ≤ V := ENNReal.toReal_nonneg
  have hVof : volH 3 D = ENNReal.ofReal V := (ENNReal.ofReal_toReal hVne).symm
  refine ⟨min (min (1 / 8) (η_Z / 20)) (ε / (2 * (1200 * (V / η_Z ^ 2 + 1)))), ?_, ?_⟩
  · have h1 : (0 : ℝ) < η_Z / 20 := by linarith
    have h2 : (0 : ℝ) < ε / (2 * (1200 * (V / η_Z ^ 2 + 1))) := by
      have : (0 : ℝ) < V / η_Z ^ 2 + 1 := by positivity
      positivity
    exact lt_min (lt_min (by norm_num) h1) h2
  · intro η hη0 hηc z f hf1 hffin hfnear
    have hη8 : η ≤ 1 / 8 := le_trans hηc (le_trans (min_le_left _ _) (min_le_left _ _))
    have hηZ20 : η ≤ η_Z / 20 := le_trans hηc (le_trans (min_le_left _ _) (min_le_right _ _))
    have hηeps : η ≤ ε / (2 * (1200 * (V / η_Z ^ 2 + 1))) := le_trans hηc (min_le_right _ _)
    have hη1 : η ≤ 1 := by linarith
    have hfne : (f : PO 3 1) ≠ 1 := fun h => hf1 (Subtype.coe_injective h)
    obtain ⟨a, b, θ, M, b₀, ha, hb, hab, _hθ0, _hθπ, hfrot, hθord, _hM0, hb₀Γ, hMb₀,
      hb₀rot, hstab, hfpow, _hdepth0⟩ :=
      hrot (f : PO 3 1) z η hfne hffin f.2 hη0 hη1 hfnear
    obtain ⟨hdeepZ, hM3⟩ :=
      hdeep a b ha hb hab (f : PO 3 1) z θ hfne hfrot M b₀ hMb₀ hfpow hθord η hη0 hη1 hfnear
    have hMpos : 0 < M := by omega
    have hM3' : (3 : ℝ) ≤ (M : ℝ) := by exact_mod_cast hM3
    have hrnn : 0 ≤ distGeod a b z := hrg a b z ha hb hab
    have hsinpos : 0 < Real.sin (Real.pi / (M : ℝ)) := by
      have h1 : 0 < Real.pi / (M : ℝ) := by positivity
      refine Real.sin_pos_of_pos_of_lt_pi h1 ?_
      rw [div_lt_iff₀ (by positivity : (0 : ℝ) < (M : ℝ))]
      nlinarith [Real.pi_pos, hM3']
    -- the strengthened depth bound with the numeric parameter `ηh = 4η`
    have hdepth : Real.sinh (distGeod a b z + 1) * Real.sin (Real.pi / (M : ℝ)) ≤ (4 * η) / 2 := by
      have h2 : Real.sinh (η / 2) ≤ η := by
        have := sinh_le_two_mul (by linarith : (0 : ℝ) ≤ η / 2) (by linarith : η / 2 ≤ 1 / 2)
        linarith
      have hmul : Real.pi / 2 * Real.sinh (η / 2) ≤ Real.pi / 2 * η :=
        mul_le_mul_of_nonneg_left h2 (by positivity)
      have h3 : Real.pi / 2 * η ≤ 2 * η := by nlinarith [Real.pi_le_four, hη0]
      linarith [hdeepZ, hmul, h3]
    have hηhZ : 4 * η ≤ η_Z / 5 := by linarith
    -- the sine bound used to see that the tube radius is positive
    have hs_le : Real.sin (Real.pi / (M : ℝ)) ≤ η_Z / 10 := by
      have h1 : (1 : ℝ) ≤ Real.sinh (distGeod a b z + 1) :=
        le_trans one_le_sinh_one (Real.sinh_le_sinh.mpr (by linarith))
      have hsn : 0 ≤ Real.sin (Real.pi / (M : ℝ)) := le_of_lt hsinpos
      have hkey : Real.sin (Real.pi / (M : ℝ)) ≤ (4 * η) / 2 := by
        calc Real.sin (Real.pi / (M : ℝ)) = 1 * Real.sin (Real.pi / (M : ℝ)) := (one_mul _).symm
          _ ≤ Real.sinh (distGeod a b z + 1) * Real.sin (Real.pi / (M : ℝ)) :=
              mul_le_mul_of_nonneg_right h1 hsn
          _ ≤ (4 * η) / 2 := hdepth
      linarith [hkey, hηZ20]
    have hsinhρ1 : Real.sinh (tubeR M η_Z + 1) = η_Z / (2 * Real.sin (Real.pi / (M : ℝ))) := by
      rw [tubeR]
      rw [show Real.arsinh (η_Z / (2 * Real.sin (Real.pi / (M : ℝ)))) - 1 + 1
          = Real.arsinh (η_Z / (2 * Real.sin (Real.pi / (M : ℝ)))) by ring]
      rw [Real.sinh_arsinh]
    have hρpos : 0 < tubeR M η_Z := by
      have hx : (5 : ℝ) ≤ η_Z / (2 * Real.sin (Real.pi / (M : ℝ))) := by
        rw [le_div_iff₀ (by positivity)]
        linarith [hs_le, hηZ0]
      have h5 : Real.sinh 1 < η_Z / (2 * Real.sin (Real.pi / (M : ℝ))) :=
        lt_of_lt_of_le sinh_one_lt_two (le_trans (by norm_num : (2 : ℝ) ≤ 5) hx)
      have h6 : (1 : ℝ) < Real.arsinh (η_Z / (2 * Real.sin (Real.pi / (M : ℝ)))) := by
        have := Real.arsinh_lt_arsinh.mpr h5
        rwa [Real.arsinh_sinh] at this
      rw [tubeR]; linarith
    have hρtube : 2 * Real.sinh (tubeR M η_Z + 1) * Real.sin (Real.pi / (M : ℝ)) ≤ η_Z := by
      rw [hsinhρ1]
      have hsinne : Real.sin (Real.pi / (M : ℝ)) ≠ 0 := ne_of_gt hsinpos
      rw [show 2 * (η_Z / (2 * Real.sin (Real.pi / (M : ℝ)))) * Real.sin (Real.pi / (M : ℝ))
          = η_Z * ((2 * Real.sin (Real.pi / (M : ℝ))) / (2 * Real.sin (Real.pi / (M : ℝ))))
          by ring]
      rw [div_self (mul_ne_zero (by norm_num) hsinne), mul_one]
    -- conjugation count at the window η_Z
    have hcc : ∀ (w : E 3) (γ : PO 3 1), γ ∈ Γ → NearIdAt b₀ w η_Z →
        NearIdAt (γ⁻¹ * b₀ * γ) w η_Z → γ⁻¹ * b₀ * γ = b₀ ∨ γ⁻¹ * b₀ * γ = b₀⁻¹ :=
      fun w γ hγ h1 h2 => hconjZ M hM3 a b ha hb hab b₀ hb₀Γ hb₀rot η_Z hηZ0 le_rfl w γ hγ h1 h2
    have hub : ∀ Dc : Set (E 3),
        MeasureTheory.IsFundamentalDomain
          ↥(Subgroup.centralizer ({b₀} : Set (PO 3 1)) ⊓ Γ) Dc (volH 3) →
        volH 3 (Tb b₀ η_Z ∩ Dc) ≤ 2 * volH 3 D :=
      fun Dc hDc => hunfold b₀ η_Z hcc D Dc hD hDc
    rcases htube a b M b₀ ha hb hab hMpos hb₀Γ hb₀rot hstab D hD η_Z hηZ0 (tubeR M η_Z)
      hρpos hρtube with ⟨g, ℓ, Dc, hℓpos, hgC, hgax, hDc, hvol⟩ | hinf
    · -- translation case
      have hgΓ : g ∈ Γ := hgC.2
      have hcomm : g * b₀ = b₀ * g := by
        have h := (Subgroup.mem_centralizer_iff.mp hgC.1) b₀ (Set.mem_singleton b₀)
        exact h.symm
      obtain ⟨j, hjinf, hjdisp⟩ := hscrew a b M b₀ g ha hb hab hMpos hb₀rot ℓ z hℓpos hgax hcomm
      refine ⟨⟨g * b₀ ^ j, mul_mem hgΓ (Subgroup.zpow_mem Γ hb₀Γ j)⟩, ?_, ?_⟩
      · intro hfin
        exact hjinf ((isOfFinOrder_subgroup_coe_iff Γ
          ⟨g * b₀ ^ j, mul_mem hgΓ (Subgroup.zpow_mem Γ hb₀Γ j)⟩).mpr hfin)
      · have hubDc := hub Dc hDc
        rw [hVof] at hubDc
        have hvol2 : ENNReal.ofReal (ℓ * (Real.pi / (M : ℝ)) * (Real.sinh (tubeR M η_Z)) ^ 2 / 2)
            ≤ 2 * ENNReal.ofReal V := le_trans hvol hubDc
        have hℓbound : ℓ * (Real.pi / (M : ℝ)) * (Real.sinh (tubeR M η_Z)) ^ 2 / 2 ≤ 2 * V := by
          have h2V : (0 : ℝ) ≤ 2 * V := by positivity
          have h2 : (2 : ℝ≥0∞) * ENNReal.ofReal V = ENNReal.ofReal (2 * V) := by
            rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_ofNat]
          rw [h2] at hvol2
          exact (ENNReal.ofReal_le_ofReal_iff h2V).mp hvol2
        have hnum := hnumeric M 1 (g * b₀ ^ j) ℓ (4 * η) η_Z V (distGeod a b z) z
          hM3 hℓpos hVnn hηZ0 (by linarith) hηhZ hrnn hℓbound hdepth
          (by simpa [mul_one] using hjdisp)
        rw [mul_one] at hnum
        have hbound : 300 * (V / η_Z ^ 2 + 1) * (4 * η) < ε := by
          have hA : (0 : ℝ) < 1200 * (V / η_Z ^ 2 + 1) := by positivity
          have hmul := mul_le_mul_of_nonneg_left hηeps hA.le
          have hsimp : 1200 * (V / η_Z ^ 2 + 1) *
              (ε / (2 * (1200 * (V / η_Z ^ 2 + 1)))) = ε / 2 := by
            field_simp
          rw [hsimp] at hmul
          have hrw : 300 * (V / η_Z ^ 2 + 1) * (4 * η) = 1200 * (V / η_Z ^ 2 + 1) * η := by ring
          rw [hrw]; linarith
        exact lt_of_le_of_lt hnum hbound
    · -- no-translation case: the unfolding bound contradicts the infinite volume
      have hdiscC : IsDiscrete (SetLike.coe (Subgroup.centralizer ({b₀} : Set (PO 3 1)) ⊓ Γ)) :=
        IsDiscrete.mono hdisc (fun x hx => hx.2)
      obtain ⟨Dc, hDc⟩ := hexFD _ hdiscC
      have h1 := hinf Dc hDc
      have h2 := hub Dc hDc
      rw [h1] at h2
      have h3 : (2 : ℝ≥0∞) * ENNReal.ofReal V = ⊤ := by
        rw [hVof] at h2
        exact top_le_iff.mp h2
      exact absurd h3 (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top)


/-- **Assembly of `gapA_three` from the near-identity escape and the torsion branch.** -/
theorem gapA_three_of_pieces (hA : POActionProp 3) (hI : HypIsometryProp 3)
    (Γ : Subgroup (PO 3 1)) (ε : ℝ) (hε : 0 < ε) (η : ℝ) (hη : 0 < η) (hηε : η ≤ ε)
    (hframe : ∀ η' : ℝ, 0 < η' → ∃ K : Set (E 3), IsCompact K ∧ ∀ z : E 3,
      (∀ γ : Γ, (γ : PO 3 1) • z ∉ K) → ∃ γ : Γ, γ ≠ 1 ∧ NearIdAt (γ : PO 3 1) z η')
    (htors : ∃ K : Set (E 3), IsCompact K ∧ ∀ z : E 3,
      (∀ γ : Γ, (γ : PO 3 1) • z ∉ K) → ∀ f : Γ, f ≠ 1 → IsOfFinOrder (f : PO 3 1) →
        NearIdAt (f : PO 3 1) z η →
          ∃ g : Γ, ¬ IsOfFinOrder (g : Γ) ∧ hdist z ((g : PO 3 1) • z) < ε) :
    ∃ K : Set (E 3), IsCompact K ∧ ∀ u : E 3, (∀ γ : Γ, (γ : PO 3 1) • u ∉ K) →
      ∃ g : Γ, orderOf g = 0 ∧ hdist u ((g : PO 3 1) • u) < ε := by
  obtain ⟨Kt, hKtc, hKt⟩ := htors
  obtain ⟨Kf, hKfc, hKf⟩ := hframe η hη
  refine ⟨Kf ∪ Kt, hKfc.union hKtc, ?_⟩
  intro u hu
  have hKf' : ∀ γ : Γ, (γ : PO 3 1) • u ∉ Kf := fun γ h => hu γ (Set.mem_union_left Kt h)
  have hKt' : ∀ γ : Γ, (γ : PO 3 1) • u ∉ Kt := fun γ h => hu γ (Set.mem_union_right Kf h)
  obtain ⟨ζ, hζ1, hζnear⟩ := hKf u hKf'
  by_cases hfin : IsOfFinOrder (ζ : PO 3 1)
  · obtain ⟨g, hginf, hgdist⟩ := hKt u hKt' ζ hζ1 hfin hζnear
    exact ⟨g, orderOf_eq_zero hginf, hgdist⟩
  · refine ⟨ζ, orderOf_eq_zero (fun h => hfin ((isOfFinOrder_subgroup_coe_iff Γ ζ).mpr h)), ?_⟩
    have h0 : hdist u u ≤ 1 := by
      rw [(hI.2.2.1 u u).mpr rfl]
      norm_num
    exact lt_of_lt_of_le (hζnear u h0) hηε

/-- The torsion branch of `gapA_three`, with all the design pieces instantiated. -/
theorem torsionBranch (hA : POActionProp 3) (hI : HypIsometryProp 3)
    (Γ : Subgroup (PO 3 1)) (hΓ : HypLattice Γ) (ε : ℝ) (hε : 0 < ε) :
    ∃ η_c : ℝ, 0 < η_c ∧ ∀ (η : ℝ), 0 < η → η ≤ η_c → ∀ (z : E 3) (f : Γ),
      f ≠ 1 → IsOfFinOrder (f : PO 3 1) → NearIdAt (f : PO 3 1) z η →
      ∃ g : Γ, ¬ IsOfFinOrder (g : Γ) ∧ hdist z ((g : PO 3 1) • z) < ε :=
  torsionBranch_of_pieces hA hI Γ hΓ ε hε
    (fun f z η hf1 hfin hfmem hη hη1 hnear =>
      (rotData3 hA hI Γ hΓ f hf1 hfin hfmem z η hη hη1 hnear : RotData Γ f z η))
    (conjCount3 hA hI Γ hΓ)
    (unfoldTube hA hI Γ hΓ)
    (fun a b M b₀ ha hb hab hM hb₀ hrot hstab D hD η₁ hη₁ ρ hρ hρtube =>
      tubeIneq3 hA hI Γ hΓ a b ha hb hab M hM b₀ hb₀ hrot hstab D hD η₁ hη₁ ρ hρ hρtube)
    screwNumeric
    (depthPlus3 hA hI)
    (exists_fundamentalDomain hA hI)
    (fun a b u ha hb hab => (geodFacts 3 (by norm_num) hA hI a b ha hb hab).2.1 u)
    (distGeod_addOne 3 (by norm_num) hA hI)
    (fun a b M b₀ g ha hb hab hM hrot ℓ z hℓ hg hcomm =>
      screwShort3 hA hI a b ha hb hab M hM b₀ g ℓ z hℓ hrot hg hcomm)

/-- **GAP-A (`EscapeShort`) for `n = 3`.** -/
theorem gapA_three (hA : POActionProp 3) (hI : HypIsometryProp 3)
    (hM : MargulisCuspProp 3) (hPS : PairStabProp 3) (Γ : Subgroup (PO 3 1)) (hΓ : HypLattice Γ)
    (hmult : MultThickProp Γ) :
    ∀ ε : ℝ, 0 < ε → ∃ K : Set (E 3), IsCompact K ∧ ∀ u : E 3, (∀ γ : Γ, (γ : PO 3 1) • u ∉ K) →
      ∃ g : Γ, orderOf g = 0 ∧ hdist u ((g : PO 3 1) • u) < ε := by
  intro ε hε
  obtain ⟨η_c, hηc0, htc⟩ := torsionBranch hA hI Γ hΓ ε hε
  refine gapA_three_of_pieces hA hI Γ ε hε (min η_c ε) (lt_min hηc0 hε) (min_le_right _ _)
    ?_ ?_
  · exact frameThinFar 3 (by norm_num) hA hI Γ hΓ.1 hmult
  · exact ⟨∅, isCompact_empty, fun z _ f hf1 hffin hfnear =>
      htc (min η_c ε) (lt_min hηc0 hε) (min_le_left _ _) z f hf1 hffin hfnear⟩

end

