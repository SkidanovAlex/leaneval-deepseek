import Mathlib
import Submission.Work.Mostow.gapA.defs
import Submission.Work.Mostow.Margulis.nearId_pair_nilpotent
import Submission.Work.Mostow.near1OfNearIdAtBall
import Submission.Work.Mostow.norm_gap
import Submission.Work.Mostow.BoostTransitive
import Submission.Work.Mostow.zassenhausOfOrigin
import Submission.Work.Mostow.margulisPairDefs
import Submission.Work.Mostow.coeToO

/-!
# Two points of a discrete subgroup that are near-identity at a common point generate a
nilpotent subgroup

Margulis' lemma in the form needed by the `n = 3` gap-A development: there is a positive
tolerance `θ`, depending only on `n`, such that for *every* discrete subgroup
`Γ ≤ PO(n,1)`, *every* point `w` of hyperbolic space and *every* pair `γ, δ ∈ Γ` which move
the unit ball around `w` by less than `θ`, the subgroup generated by `γ` and `δ` is nilpotent.

The proof has two halves.

* At the base point `w = 0` the entrywise near-identity conversion `near1OfNearIdAtBall`
  turns `NearIdAt · 0 θ` into `Near1 (ToO ·) (C θ)`, and `nearId_pair_nilpotent`
  (Zassenhaus + the discreteness gap) produces nilpotency for `C θ` below the Margulis
  constant (`pair_nilpotent_at_zero`).
* For a general base point `w` we conjugate by an isometry `g` with `g • 0 = w`
  (`BoostTransitive`): conjugation preserves discreteness (`isDiscrete_map_conj`) and turns
  `NearIdAt γ w θ` into `NearIdAt (g⁻¹ γ g) 0 θ` (`nearIdAt_conj_iff`), so the base-point
  case applies to the conjugated subgroup, and nilpotency is transported back along the group
  isomorphism `x ↦ g⁻¹ x g` (`pair_nilpotent_at`).

The same-`θ`-at-every-point phenomenon is the form in which the Margulis lemma is used in the
Zassenhaus-style local-group arguments; `zassenhausOfOrigin` performs the identical transport
for the whole near-identity set.
-/

namespace Work.Mostow.gapA

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory

noncomputable section

variable {n : ℕ}

/-- Conjugating by `g` translates the displacement `u ↦ γ • u` into the displacement of
`g⁻¹ * γ * g` at `u`. -/
lemma hdist_conj_eq (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n) (g γ : PO n 1) (u : E n) :
    hdist u ((g⁻¹ * γ * g) • u) = hdist (g • u) (γ • (g • u)) := by
  obtain ⟨_, _, _, hone, hmul, _, _, _, _, _, _, _⟩ := hA
  obtain ⟨_, _, _, _, _, _, hisom, -⟩ := hI
  rw [← hisom g u ((g⁻¹ * γ * g) • u)]
  congr 1
  rw [hmul (g⁻¹ * γ) g u, hmul g⁻¹ γ (g • u), ← hmul g g⁻¹ (γ • (g • u)),
    mul_inv_cancel, hone]

/-- Conjugating by an isometry `g` with `g • 0 = z` turns "near identity at `z`" into "near
identity at the origin" for the conjugate `g⁻¹ * γ * g`. -/
lemma nearIdAt_conj_iff (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n) {g : PO n 1} {z : E n}
    (hg : g • (0 : E n) = z) (η : ℝ) (γ : PO n 1) :
    NearIdAt (g⁻¹ * γ * g) (0 : E n) η ↔ NearIdAt γ z η := by
  have hone : ∀ u : E n, (1 : PO n 1) • u = u := hA.2.2.2.1
  have hmul : ∀ (g h : PO n 1) (u : E n), (g * h) • u = g • (h • u) := hA.2.2.2.2.1
  have hisom : ∀ (g : PO n 1) (u v : E n), hdist (g • u) (g • v) = hdist u v :=
    hI.2.2.2.2.2.2.1
  have hgv : ∀ v : E n, g • (g⁻¹ • v) = v := by
    intro v
    rw [← hmul g g⁻¹ v, mul_inv_cancel, hone]
  constructor
  · intro h v hv
    have hu : hdist (0 : E n) (g⁻¹ • v) ≤ 1 := by
      have hzv : hdist (0 : E n) (g⁻¹ • v) = hdist z v := by
        rw [← hisom g (0 : E n) (g⁻¹ • v), hg, hgv v]
      rw [hzv]; exact hv
    have h1 := h (g⁻¹ • v) hu
    rw [hdist_conj_eq hA hI g γ (g⁻¹ • v), hgv v] at h1
    exact h1
  · intro h u hu
    rw [hdist_conj_eq hA hI g γ u]
    apply h
    have : hdist z (g • u) = hdist (0 : E n) u := by
      rw [← hg, hisom g (0 : E n) u]
    rw [this]; exact hu

/-- Base-point case: two elements of a discrete subgroup that are `θ`-near the identity at the
origin generate a nilpotent subgroup, for a `θ > 0` depending only on `n`. -/
lemma pair_nilpotent_at_zero (n : ℕ) (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (Γ : Subgroup (PO n 1)), IsDiscrete (SetLike.coe Γ) →
      ∀ γ δ : Γ, NearIdAt (γ : PO n 1) (0 : E n) θ →
        NearIdAt (δ : PO n 1) (0 : E n) θ →
        Group.IsNilpotent (Subgroup.closure ({(γ : PO n 1), (δ : PO n 1)} : Set (PO n 1))) := by
  obtain ⟨C, hCpos, hC⟩ := near1OfNearIdAtBall n hA hI
  set q : ℝ := Work.Mostow.Margulis.margQ n with hq
  have hqpos : 0 < q := Work.Mostow.Margulis.margQ_pos n
  have hqsmall : 8 * (msz n) ^ 3 * q ≤ 1 / 2 := Work.Mostow.Margulis.margQ_small n
  refine ⟨min 1 (q / C), lt_min one_pos (div_pos hqpos hCpos), ?_⟩
  intro Γ hdisc γ δ hγ hδ
  have hθpos : 0 < min 1 (q / C) := lt_min one_pos (div_pos hqpos hCpos)
  have hθle1 : min 1 (q / C) ≤ 1 := min_le_left _ _
  have hθC : C * min 1 (q / C) ≤ q := by
    have h1 : min 1 (q / C) ≤ q / C := min_le_right _ _
    calc C * min 1 (q / C) ≤ C * (q / C) := mul_le_mul_of_nonneg_left h1 (le_of_lt hCpos)
      _ = q := by field_simp
  refine Work.Mostow.Margulis.nearId_pair_nilpotent n hA hI Γ hdisc γ δ q hqpos hqsmall ?_ ?_
  · exact ⟨ToO (γ : PO n 1), coeToO n hA (γ : PO n 1),
      Work.Mostow.Margulis.near1_mono (hC (min 1 (q / C)) hθpos hθle1 (γ : PO n 1) hγ) hθC⟩
  · exact ⟨ToO (δ : PO n 1), coeToO n hA (δ : PO n 1),
      Work.Mostow.Margulis.near1_mono (hC (min 1 (q / C)) hθpos hθle1 (δ : PO n 1) hδ) hθC⟩

/-- Transport of the base-point statement to an arbitrary base point by conjugation. -/
lemma pair_nilpotent_at (n : ℕ) (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n) (θ : ℝ) (hθ : 0 < θ)
    (h0 : ∀ (Γ : Subgroup (PO n 1)), IsDiscrete (SetLike.coe Γ) →
      ∀ γ δ : Γ, NearIdAt (γ : PO n 1) (0 : E n) θ →
        NearIdAt (δ : PO n 1) (0 : E n) θ →
        Group.IsNilpotent
          (Subgroup.closure ({(γ : PO n 1), (δ : PO n 1)} : Set (PO n 1)))) :
    ∀ (Γ : Subgroup (PO n 1)), IsDiscrete (SetLike.coe Γ) → ∀ (w : E n) (γ δ : Γ),
      NearIdAt (γ : PO n 1) w θ → NearIdAt (δ : PO n 1) w θ →
        Group.IsNilpotent (Subgroup.closure ({(γ : PO n 1), (δ : PO n 1)} : Set (PO n 1))) := by
  intro Γ hdisc w γ δ hγ hδ
  obtain ⟨g, hg⟩ := (BoostTransitive n hA).1 w
  set φ : PO n 1 ≃* PO n 1 := MulAut.conj g⁻¹ with hφdef
  have hφapply : ∀ x : PO n 1, φ x = g⁻¹ * x * g := by
    intro x
    rw [hφdef, MulAut.conj_apply]
    simp
  set Γ' : Subgroup (PO n 1) := Γ.map φ.toMonoidHom with hΓ'def
  have hdisc' : IsDiscrete (SetLike.coe Γ') := by
    rw [hΓ'def]
    exact isDiscrete_map_conj hdisc g
  have hmem : ∀ x : Γ, φ (x : PO n 1) ∈ Γ' := by
    intro x
    rw [hΓ'def]
    exact Subgroup.mem_map.mpr ⟨(x : PO n 1), x.2, rfl⟩
  have hγ'near : NearIdAt (φ (γ : PO n 1)) (0 : E n) θ := by
    rw [hφapply (γ : PO n 1)]
    exact (nearIdAt_conj_iff hA hI hg θ (γ : PO n 1)).mpr hγ
  have hδ'near : NearIdAt (φ (δ : PO n 1)) (0 : E n) θ := by
    rw [hφapply (δ : PO n 1)]
    exact (nearIdAt_conj_iff hA hI hg θ (δ : PO n 1)).mpr hδ
  have hnil := h0 Γ' hdisc' ⟨φ (γ : PO n 1), hmem γ⟩ ⟨φ (δ : PO n 1), hmem δ⟩
    hγ'near hδ'near
  set S : Subgroup (PO n 1) :=
    Subgroup.closure ({(γ : PO n 1), (δ : PO n 1)} : Set (PO n 1)) with hSdef
  have hclosure : S.map φ.toMonoidHom
      = Subgroup.closure ({(φ (γ : PO n 1)), (φ (δ : PO n 1))} : Set (PO n 1)) := by
    rw [hSdef, MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
    simp
  have hnil' : Group.IsNilpotent (S.map φ.toMonoidHom) := by
    rw [hclosure]
    exact hnil
  exact (Group.isNilpotent_congr (MulEquiv.subgroupMap φ S)).mpr hnil'

theorem nilpotentPairNearIdAt (n : ℕ) (hn : 2 ≤ n) (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)),
      IsDiscrete (SetLike.coe Γ) → ∀ (w : Submission.Mostow.E n) (γ δ : Γ),
      Submission.Mostow.NearIdAt (γ : LeanEval.Geometry.MostowRigidity.PO n 1) w θ →
      Submission.Mostow.NearIdAt (δ : LeanEval.Geometry.MostowRigidity.PO n 1) w θ →
      Group.IsNilpotent (Subgroup.closure
        ({((γ : LeanEval.Geometry.MostowRigidity.PO n 1)),
          ((δ : LeanEval.Geometry.MostowRigidity.PO n 1))} :
          Set (LeanEval.Geometry.MostowRigidity.PO n 1))) := by
  obtain ⟨θ, hθpos, h0⟩ := pair_nilpotent_at_zero n hA hI
  exact ⟨θ, hθpos, pair_nilpotent_at n hA hI θ hθpos h0⟩

end

end Work.Mostow.gapA
