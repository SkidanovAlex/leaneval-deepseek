open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory

/-- The origin case of the Zassenhaus lemma. -/
theorem zassenhausAtOrigin (n : ℕ) (hA : POActionProp n) (hI : HypIsometryProp n) :
    ∃ η : ℝ, 0 < η ∧ ∀ (Γ : Subgroup (PO n 1)), IsDiscrete (SetLike.coe Γ) →
      Group.IsNilpotent (Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) (0 : E n) η}) := by
  obtain ⟨C, hCpos, hC⟩ := nearId_norm n hA hI
  refine ⟨min (1 / 8) (1 / (16 * C)), ?_, ?_⟩
  · positivity
  · intro Γ hdisc
    set η : ℝ := min (1 / 8) (1 / (16 * C)) with hηdef
    have hηpos : 0 < η := by rw [hηdef]; positivity
    have hη8 : η ≤ 1 / 8 := by rw [hηdef]; exact min_le_left _ _
    have hηC : η ≤ 1 / (16 * C) := by rw [hηdef]; exact min_le_right _ _
    have hCη : C * η ≤ 1 / 16 := by
      have h1 : C * η ≤ C * (1 / (16 * C)) := mul_le_mul_of_nonneg_left hηC (le_of_lt hCpos)
      rw [show C * (1 / (16 * C)) = 1 / 16 by field_simp] at h1
      exact h1
    set ε : ℝ := C * η with hεdef
    have hεpos : 0 < ε := by rw [hεdef]; exact mul_pos hCpos hηpos
    have hε16 : ε ≤ 1 / 16 := by rw [hεdef]; exact hCη
    obtain ⟨m, hmpos, hm⟩ := norm_gap n hA hI Γ hdisc
    obtain ⟨N, hNlt⟩ : ∃ N : ℕ, ε * (4 * ε) ^ N < m := by
      have h4le : 4 * ε ≤ 1 / 4 := by linarith
      have h4nn : 0 ≤ 4 * ε := by linarith
      have h4lt : 4 * ε < 1 := by linarith
      obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one (show (0:ℝ) < m / ε by positivity) h4lt
      exact ⟨N, by
        calc ε * (4 * ε) ^ N < ε * (m / ε) := mul_lt_mul_of_pos_left hN hεpos
          _ = m := by field_simp⟩
    refine nilpotentOfSimpleComm {γ : Γ | NearIdAt (γ : PO n 1) (0 : E n) η} N ?_
    intro k hk c hc
    have hcoe : ∀ j : ℕ, ∀ d ∈ SimpleCommSet {γ : Γ | NearIdAt (γ : PO n 1) (0 : E n) η} j,
        (d : PO n 1) ∈ SimpleCommSet (Subgroup.subtype Γ '' {γ : Γ | NearIdAt (γ : PO n 1) (0 : E n) η}) j := by
      intro j
      induction j with
      | zero => intro d hd; exact ⟨d, hd, rfl⟩
      | succ j ih =>
        intro d hd
        rw [mem_SimpleCommSet_succ] at hd
        obtain ⟨a, ha, x, hx, rfl⟩ := hd
        rw [mem_SimpleCommSet_succ]
        exact ⟨(a : PO n 1), ih a ha, (x : PO n 1), ⟨x, hx, rfl⟩,
          map_commutatorElement (Subgroup.subtype Γ) a x⟩
    have hnorm : ‖LambdaMat (c : PO n 1) - 1‖ ≤ ε * (4 * ε) ^ k :=
      simpleCommNormBound n hA (fun g h hg hh => commutatorNormLe n hA g h hg hh)
        (Subgroup.subtype Γ '' {γ : Γ | NearIdAt (γ : PO n 1) (0 : E n) η}) ε hεpos hε16
        (by rintro x ⟨d, hd, rfl⟩
            exact hC (d : PO n 1) η hηpos hη8 hd)
        k (c : PO n 1) (hcoe k c hc)
    have hle : ε * (4 * ε) ^ k ≤ ε * (4 * ε) ^ N := by
      have h4le : 4 * ε ≤ 1 / 4 := by linarith
      have h4nn : 0 ≤ 4 * ε := by linarith
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_of_le_one h4nn (by linarith : 4 * ε ≤ 1) hk) (le_of_lt hεpos)
    by_contra hc1
    have hc1' : (c : PO n 1) ≠ 1 := fun h =>
      hc1 (Subtype.coe_injective (show (c : PO n 1) = ((1 : Γ) : PO n 1) from by rw [h]; rfl))
    have := hm c hc1'
    linarith

/-- **Zassenhaus' theorem, pointwise form.** -/
theorem zassenhausNilpotent (n : ℕ) (hn : 2 ≤ n) (hA : POActionProp n) (hI : HypIsometryProp n) :
    ∃ η : ℝ, 0 < η ∧ ∀ Γ : Subgroup (PO n 1), IsDiscrete (SetLike.coe Γ) → ∀ z : E n,
      Group.IsNilpotent (Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η}) := by
  obtain ⟨η, hηpos, hη⟩ := zassenhausAtOrigin n hA hI
  exact ⟨η, hηpos,
    zassenhausOfOrigin n (by omega) hA hI (fun u => (BoostTransitive n hA).1 u) η hηpos hη⟩

end Work.Mostow
