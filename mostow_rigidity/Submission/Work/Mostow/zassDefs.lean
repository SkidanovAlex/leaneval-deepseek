import Mathlib
import Submission.Mostow.HLDefs

/-!
# Shared vocabulary for the Zassenhaus lemma `Work.Mostow.zassenhausNilpotent`

* `SimpleCommSet X k` : the set of left-normed *simple* commutators `⁅x₁, ⁅x₂, …⁆…⁆` of
  weight `k` in the elements of a set `X` of a group (weight `0` is `X` itself).
* `CommGens X k` / `CommSubgroup X k` : the set (resp. subgroup) generated by the
  `⟨X⟩`-conjugates of the simple commutators of weight at least `k`.  `CommSubgroup X ·` is the
  descending central series whose termination gives nilpotency of `⟨X⟩`.
-/

open scoped commutatorElement

namespace Work.Mostow

variable {G : Type*} [Group G]

/-- Left-normed simple commutators of weight `k` in the elements of `X`
(weight `0` is `X` itself, so weight `1` is `{⁅x, y⁆ | x, y ∈ X}`). -/
def SimpleCommSet (X : Set G) : ℕ → Set G
  | 0 => X
  | k + 1 => {c : G | ∃ a ∈ SimpleCommSet X k, ∃ x ∈ X, c = ⁅a, x⁆}

@[simp] lemma SimpleCommSet_zero (X : Set G) : SimpleCommSet X 0 = X := rfl

lemma mem_SimpleCommSet_succ (X : Set G) (k : ℕ) (c : G) :
    c ∈ SimpleCommSet X (k + 1) ↔ ∃ a ∈ SimpleCommSet X k, ∃ x ∈ X, c = ⁅a, x⁆ :=
  Iff.rfl

/-- The `⟨X⟩`-conjugates of the simple commutators of weight at least `k`. -/
def CommGens (X : Set G) (k : ℕ) : Set G :=
  {g : G | ∃ j, k ≤ j ∧ ∃ c ∈ SimpleCommSet X j, ∃ h ∈ Subgroup.closure X, g = h * c * h⁻¹}

/-- The `k`-th term of the descending central series generated by `X`:
the subgroup generated by `CommGens X k`. -/
def CommSubgroup (X : Set G) (k : ℕ) : Subgroup G := Subgroup.closure (CommGens X k)

lemma SimpleCommSet_subset_CommGens (X : Set G) (k : ℕ) : SimpleCommSet X k ⊆ CommGens X k :=
  fun c hc => ⟨k, le_rfl, c, hc, 1, Subgroup.one_mem _, by simp⟩

lemma CommGens_subset_CommSubgroup (X : Set G) (k : ℕ) :
    CommGens X k ⊆ CommSubgroup X k := Subgroup.subset_closure

lemma CommSubgroup_antitone (X : Set G) : Antitone (CommSubgroup X) := by
  intro k l hkl
  apply Subgroup.closure_mono
  rintro g ⟨j, hkj, c, hc, h, hh, rfl⟩
  exact ⟨j, le_trans hkl hkj, c, hc, h, hh, rfl⟩

/-- Elements of the commutator series are normalised by `⟨X⟩`. -/
lemma CommSubgroup_conj_mem (X : Set G) (k : ℕ) {g : G} (hg : g ∈ CommSubgroup X k)
    {h : G} (hh : h ∈ Subgroup.closure X) : h * g * h⁻¹ ∈ CommSubgroup X k := by
  refine Subgroup.closure_induction (k := CommGens X k)
    (p := fun x _ => h * x * h⁻¹ ∈ CommSubgroup X k) ?_ ?_ ?_ ?_ hg
  · intro g' hg'
    obtain ⟨j, hjk, c, hc, h', hh', rfl⟩ := hg'
    exact Subgroup.subset_closure ⟨j, hjk, c, hc, h * h', Subgroup.mul_mem _ hh hh', by group⟩
  · simp
  · intro a b ha hb ha' hb'
    have hm : (h * a * h⁻¹) * (h * b * h⁻¹) ∈ CommSubgroup X k := Subgroup.mul_mem _ ha' hb'
    rwa [show (h * a * h⁻¹) * (h * b * h⁻¹) = h * (a * b) * h⁻¹ from by group] at hm
  · intro a ha ha'
    have hm : (h * a * h⁻¹)⁻¹ ∈ CommSubgroup X k := Subgroup.inv_mem _ ha'
    rwa [show (h * a * h⁻¹)⁻¹ = h * a⁻¹ * h⁻¹ from by group] at hm

end Work.Mostow
