import Mathlib
import Submission.Work.Mostow.geodDeps
import Submission.Work.Mostow.finite_nearStab
import Submission.Work.Mostow.minimalPositiveDisplacement

/-!
# The axis dichotomy for a discrete subgroup of `PO 1 1`

`PO 1 1` is the full isometry group of `ℍ¹`, which as a group is `ℝ ⋊ ℤ/2`: every element is
either a translation (`x ↦ x + c`) or a reflection (`x ↦ c - x`) in the signed distance
coordinate.  Consequently

* the square of every isometry is either trivial or fixed point free, and
* the set `T` of elements of a discrete subgroup `D` that are trivial or fixed point free is
  either trivial or infinite cyclic, generated by the element of minimal displacement.

The whole proof is carried out in the chart `E 1 = ℝ` of the hyperboloid model: the signed
distance `sc u = arsinh (u 0)` satisfies `hdist u v = |sc u - sc v|`, which turns `ℍ¹` into the
real line, and the action of `PO 1 1` into an action by isometries of `ℝ`, whose structure is
then elementary.
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity

namespace AxisDich

noncomputable section

/-! ## 1. `ℍ¹` as the real line -/

/-- Signed distance from the base point, in the chart: `hdist u v = |sc u - sc v|`. -/
def sc (u : E 1) : ℝ := Real.arsinh (u 0)

/-- The point of `ℍ¹` at signed distance `x` from the base point. -/
def pt (x : ℝ) : E 1 := WithLp.toLp 2 (fun _ : Fin 1 => Real.sinh x)

lemma pt_zero : pt 0 = (0 : E 1) := by
  show WithLp.toLp 2 (fun _ : Fin 1 => Real.sinh 0) = 0
  rw [Real.sinh_zero]
  exact WithLp.toLp_zero 2

lemma sc_zero : sc (0 : E 1) = 0 := by
  simp [sc, Real.arsinh_zero]

lemma sc_pt (x : ℝ) : sc (pt x) = x := by
  simp [sc, pt, Real.arsinh_sinh]

lemma pt_sc (u : E 1) : pt (sc u) = u := by
  have h : (pt (sc u)).ofLp = u.ofLp := by
    funext i
    fin_cases i
    simp [pt, sc, Real.sinh_arsinh]
  calc pt (sc u) = WithLp.toLp 2 (pt (sc u)).ofLp := (WithLp.toLp_ofLp 2 _).symm
    _ = WithLp.toLp 2 u.ofLp := by rw [h]
    _ = u := WithLp.toLp_ofLp 2 u

/-- `hdist` in `ℍ¹` is the Euclidean distance of the signed coordinates. -/
lemma hdist_eq_arsinh (u v : E 1) :
    hdist u v = |Real.arsinh (u 0) - Real.arsinh (v 0)| := by
  have hinner : ∀ u v : E 1, inner ℝ u v = u 0 * v 0 := by
    intro u v; rw [PiLp.inner_apply, Fin.sum_univ_one, Real.inner_apply]
  have hnu : ‖u‖ ^ 2 = (u 0) ^ 2 := by
    rw [← real_inner_self_eq_norm_sq, hinner u u]; ring
  have hnv : ‖v‖ ^ 2 = (v 0) ^ 2 := by
    rw [← real_inner_self_eq_norm_sq, hinner v v]; ring
  have htu : tpart u = Real.cosh (Real.arsinh (u 0)) := by
    rw [tpart, hnu, ← Real.cosh_arsinh (u 0)]
  have htv : tpart v = Real.cosh (Real.arsinh (v 0)) := by
    rw [tpart, hnv, ← Real.cosh_arsinh (v 0)]
  have harg : tpart u * tpart v - inner ℝ u v =
      Real.cosh (Real.arsinh (u 0) - Real.arsinh (v 0)) := by
    rw [htu, htv, hinner, Real.cosh_sub, Real.sinh_arsinh, Real.sinh_arsinh]
  rw [hdist, harg, ← Real.cosh_abs]
  exact Real.arcosh_cosh (abs_nonneg _)

lemma hdist_eq_sc (u v : E 1) : hdist u v = |sc u - sc v| := by
  rw [hdist_eq_arsinh]
  rfl

lemma hdist_zero_eq_sc (u : E 1) : hdist (0 : E 1) u = |sc u| := by
  rw [hdist_eq_sc, sc_zero, zero_sub, abs_neg]

lemma sc_inj (hI : HypIsoData 1) : Function.Injective (sc : E 1 → ℝ) := by
  intro u v huv
  refine (hI.eq_zero u v).mp ?_
  rw [hdist_eq_sc, huv, sub_self, abs_zero]

/-! ## 2. The action of `PO 1 1` on the line -/

/-- The action of `g` in the signed coordinate. -/
def Phi (g : PO 1 1) : ℝ → ℝ := fun x => sc (g • pt x)

lemma Phi_zero_arg (g : PO 1 1) : Phi g 0 = sc (g • (0 : E 1)) := by
  rw [Phi, pt_zero]

lemma Phi_one (hA : POBasic 1) : Phi (1 : PO 1 1) = id := by
  funext x
  show sc ((1 : PO 1 1) • pt x) = x
  rw [hA.one_smul, sc_pt]

lemma Phi_mul (hA : POBasic 1) (g h : PO 1 1) : Phi (g * h) = Phi g ∘ Phi h := by
  funext x
  show sc ((g * h) • pt x) = sc (g • pt (sc (h • pt x)))
  have h2 : g • (h • pt x) = g • pt (sc (h • pt x)) := by rw [pt_sc (h • pt x)]
  rw [hA.mul_smul, h2]

lemma Phi_isometry (hI : HypIsoData 1) (g : PO 1 1) (x y : ℝ) :
    |Phi g x - Phi g y| = |x - y| := by
  show |sc (g • pt x) - sc (g • pt y)| = |x - y|
  rw [← hdist_eq_sc (g • pt x) (g • pt y), hI.isom_smul, hdist_eq_sc, sc_pt, sc_pt]

/-- An isometry of the real line is an affine map of slope `±1`. -/
lemma isom_real_form {φ : ℝ → ℝ} (h : ∀ s t : ℝ, |φ s - φ t| = |s - t|) :
    ∃ c : ℝ, (∀ s : ℝ, φ s = c + s) ∨ (∀ s : ℝ, φ s = c - s) := by
  have hsq : ∀ s t : ℝ, (φ s - φ t) ^ 2 = (s - t) ^ 2 := by
    intro s t
    rw [← sq_abs (φ s - φ t), ← sq_abs (s - t), h s t]
  have hψsq : ∀ s : ℝ, (φ s - φ 0) ^ 2 = s ^ 2 := by
    intro s
    simpa using hsq s 0
  have hmul : ∀ s t : ℝ, (φ s - φ 0) * (φ t - φ 0) = s * t := by
    intro s t
    nlinarith [hsq s t, hψsq s, hψsq t]
  have hψ1 : (φ 1 - φ 0) ^ 2 = 1 := by simpa using hψsq 1
  have hprod : ∀ s : ℝ, (φ s - φ 0) * (φ 1 - φ 0) = s := by
    intro s
    simpa using hmul s 1
  have hbb : (φ 1 - φ 0) * (φ 1 - φ 0) = 1 := by
    simpa [pow_two] using hψ1
  have hlin : ∀ s : ℝ, φ s - φ 0 = s * (φ 1 - φ 0) := by
    intro s
    calc φ s - φ 0 = (φ s - φ 0) * ((φ 1 - φ 0) * (φ 1 - φ 0)) := by rw [hbb, mul_one]
      _ = ((φ s - φ 0) * (φ 1 - φ 0)) * (φ 1 - φ 0) := by ring
      _ = s * (φ 1 - φ 0) := by rw [hprod s]
  have hk : (φ 1 - φ 0) = 1 ∨ (φ 1 - φ 0) = -1 :=
    sq_eq_sq_iff_eq_or_eq_neg.mp (by simpa using hψ1)
  rcases hk with hk | hk
  · refine ⟨φ 0, Or.inl fun s => ?_⟩
    have hh := hlin s
    rw [hk, mul_one] at hh
    linarith
  · refine ⟨φ 0, Or.inr fun s => ?_⟩
    have hh := hlin s
    rw [hk, mul_neg, mul_one] at hh
    linarith

lemma Phi_form (hI : HypIsoData 1) (g : PO 1 1) :
    ∃ c : ℝ, (∀ x : ℝ, Phi g x = c + x) ∨ (∀ x : ℝ, Phi g x = c - x) :=
  isom_real_form (Phi_isometry hI g)

lemma Phi_eq_one_iff (hA : POBasic 1) (hI : HypIsoData 1) (g : PO 1 1) :
    (∀ x : ℝ, Phi g x = x) ↔ g = 1 := by
  constructor
  · intro h
    refine hA.faithful g fun u => ?_
    have h1 : sc (g • u) = sc u := by
      have := h (sc u)
      rw [Phi, pt_sc u] at this
      exact this
    exact sc_inj hI h1
  · intro hg
    subst hg
    intro x
    show sc ((1 : PO 1 1) • pt x) = x
    rw [hA.one_smul, sc_pt]

lemma Phi_fix_iff (hI : HypIsoData 1) (g : PO 1 1) (u : E 1) :
    g • u = u ↔ Phi g (sc u) = sc u := by
  constructor
  · intro h
    rw [Phi, pt_sc u, h]
  · intro h
    refine sc_inj hI ?_
    have h2 : sc (g • u) = sc u := by
      have h3 : Phi g (sc u) = sc (g • pt (sc u)) := rfl
      rw [h3, pt_sc u] at h
      exact h
    exact h2

/-! ## 3. The dichotomy for squares -/

/-- The square of every isometry of `ℍ¹` is trivial or fixed point free. -/
lemma sq_dichotomy (hA : POBasic 1) (hI : HypIsoData 1) (g : PO 1 1) :
    g * g = 1 ∨ ∀ u : E 1, (g * g) • u ≠ u := by
  rcases Phi_form hI g with ⟨c, hc | hc⟩
  · by_cases hc0 : c = 0
    · left
      have hid : ∀ x : ℝ, Phi g x = x := by intro x; rw [hc, hc0, zero_add]
      have hg1 : g = 1 := (Phi_eq_one_iff hA hI g).mp hid
      rw [hg1, mul_one]
    · right
      intro u hu
      have hfix : Phi (g * g) (sc u) = sc u := (Phi_fix_iff hI (g * g) u).mp hu
      have hcomp : Phi (g * g) (sc u) = Phi g (Phi g (sc u)) := by
        rw [Phi_mul hA g g]; rfl
      rw [hcomp, hc, hc] at hfix
      exact hc0 (by linarith)
  · left
    apply (Phi_eq_one_iff hA hI (g * g)).mp
    intro x
    have hcomp : Phi (g * g) x = Phi g (Phi g x) := by
      rw [Phi_mul hA g g]; rfl
    rw [hcomp, hc, hc]
    ring

/-! ## 4. Elements of `T` act by translations -/

variable {T : Subgroup (PO 1 1)}

/-- Elements of `T` (other than `1`) are fixed point free by definition. -/
lemma Phi_trans (hA : POBasic 1) (hI : HypIsoData 1)
    (hfree : ∀ g ∈ T, g ≠ 1 → ∀ x : E 1, g • x ≠ x) {g : PO 1 1} (hg : g ∈ T) (x : ℝ) :
    Phi g x = x + Phi g 0 := by
  rcases Phi_form hI g with ⟨c, hc | hc⟩
  · have h0 : Phi g 0 = c := by rw [hc]; ring
    rw [hc, h0]; ring
  · have hfix : g • pt (c / 2) = pt (c / 2) := by
      rw [Phi_fix_iff hI g (pt (c / 2)), sc_pt, hc]
      ring
    by_cases hg1 : g = 1
    · subst hg1
      rw [Phi_one hA]
      simp
    · exact absurd hfix (hfree g hg hg1 (pt (c / 2)))

lemma Phi_mul_zero (hA : POBasic 1) (hI : HypIsoData 1)
    (hfree : ∀ g ∈ T, g ≠ 1 → ∀ x : E 1, g • x ≠ x) {g h : PO 1 1} (hg : g ∈ T) :
    Phi (g * h) 0 = Phi g 0 + Phi h 0 := by
  rw [Phi_mul hA g h, Function.comp_apply, Phi_trans hA hI hfree hg]
  ring

lemma Phi_pow_zero (hA : POBasic 1) (hI : HypIsoData 1)
    (hfree : ∀ g ∈ T, g ≠ 1 → ∀ x : E 1, g • x ≠ x) {g : PO 1 1} (hg : g ∈ T) (m : ℕ) :
    Phi (g ^ m) 0 = m * Phi g 0 := by
  induction m with
  | zero => rw [pow_zero, Phi_one hA]; simp
  | succ m ih =>
      rw [pow_succ, Phi_mul_zero hA hI hfree (T.pow_mem hg m), ih, Nat.cast_succ]
      ring

lemma Phi_inv_zero (hA : POBasic 1) (hI : HypIsoData 1)
    (hfree : ∀ g ∈ T, g ≠ 1 → ∀ x : E 1, g • x ≠ x) {g : PO 1 1} (hg : g ∈ T) :
    Phi g⁻¹ 0 = - Phi g 0 := by
  have h1 : Phi (g * g⁻¹) 0 = 0 := by
    rw [mul_inv_cancel, Phi_one hA]
    rfl
  have h2 := Phi_mul_zero hA hI hfree hg (h := g⁻¹)
  rw [h1] at h2
  linarith

lemma Phi_inj_of_mem (hA : POBasic 1) (hI : HypIsoData 1)
    (hfree : ∀ g ∈ T, g ≠ 1 → ∀ x : E 1, g • x ≠ x) {g h : PO 1 1} (hg : g ∈ T) (hh : h ∈ T)
    (heq : Phi g 0 = Phi h 0) : g = h := by
  have hact : ∀ u : E 1, g • u = h • u := by
    intro u
    have h1 : pt (Phi g (sc u)) = g • u := by
      have h1a : Phi g (sc u) = sc (g • u) := by
        show sc (g • pt (sc u)) = sc (g • u)
        rw [pt_sc u]
      rw [h1a, pt_sc]
    have h2 : pt (Phi h (sc u)) = h • u := by
      have h2a : Phi h (sc u) = sc (h • u) := by
        show sc (h • pt (sc u)) = sc (h • u)
        rw [pt_sc u]
      rw [h2a, pt_sc]
    have h3 : Phi g (sc u) = Phi h (sc u) := by
      rw [Phi_trans hA hI hfree hg, Phi_trans hA hI hfree hh, heq]
    rw [← h1, h3, h2]
  have h1 : g⁻¹ * h = 1 := hA.faithful _ (fun u => by
    rw [hA.mul_smul, ← hact u, ← hA.mul_smul, inv_mul_cancel, hA.one_smul])
  calc g = g * 1 := (mul_one g).symm
    _ = g * (g⁻¹ * h) := by rw [← h1]
    _ = h := by group

/-- Integer division step: `q` sits in the half open interval `[n m, (n+1) m)`. -/
lemma floor_step_nat {q m : ℝ} (hq : 0 ≤ q) (hm : 0 < m) :
    ∃ n : ℕ, 0 ≤ q - n * m ∧ q - n * m < m := by
  have hfl : 0 ≤ ⌊q / m⌋ := Int.floor_nonneg.mpr (div_nonneg hq (le_of_lt hm))
  refine ⟨(⌊q / m⌋).toNat, ?_, ?_⟩
  · have h1 : (((⌊q / m⌋).toNat : ℤ) : ℝ) = ⌊q / m⌋ := by
      rw [Int.toNat_of_nonneg hfl]
    have h2 : ((⌊q / m⌋).toNat : ℝ) ≤ q / m := by
      have hh := Int.floor_le (q / m)
      rw [← h1] at hh
      exact hh
    have h3 := mul_le_mul_of_nonneg_right h2 (le_of_lt hm)
    rw [div_mul_cancel₀ _ (ne_of_gt hm)] at h3
    linarith
  · have h1 : (((⌊q / m⌋).toNat : ℤ) : ℝ) = ⌊q / m⌋ := by
      rw [Int.toNat_of_nonneg hfl]
    have h2 : q / m < ((⌊q / m⌋).toNat : ℝ) + 1 := by
      have hh := Int.lt_floor_add_one (q / m)
      rw [← h1] at hh
      exact hh
    have h3 := mul_lt_mul_of_pos_right h2 hm
    rw [div_mul_cancel₀ _ (ne_of_gt hm), add_mul, one_mul] at h3
    linarith

end

end AxisDich

open AxisDich

theorem axisDichotomy (hA : Submission.Mostow.POActionProp 1)
    (hI : Submission.Mostow.HypIsometryProp 1)
    (D : Subgroup (LeanEval.Geometry.MostowRigidity.PO 1 1))
    (hdisc : IsDiscrete (SetLike.coe D))
    (T : Subgroup (LeanEval.Geometry.MostowRigidity.PO 1 1))
    (hT : ∀ h : LeanEval.Geometry.MostowRigidity.PO 1 1,
      h ∈ T ↔ h ∈ D ∧ (h = 1 ∨ ∀ x : Submission.Mostow.E 1, h • x ≠ x)) :
    (∀ h ∈ D, h * h ∈ T) ∧
      (T = ⊥ ∨
        ∃ g₀ ∈ T, (∀ x : Submission.Mostow.E 1, g₀ • x ≠ x) ∧
          T = Subgroup.closure ({g₀} : Set (LeanEval.Geometry.MostowRigidity.PO 1 1)) ∧
          ∀ h ∈ T, h ≠ 1 →
            Submission.Mostow.hdist (0 : Submission.Mostow.E 1) (g₀ • (0 : Submission.Mostow.E 1)) ≤
              Submission.Mostow.hdist (0 : Submission.Mostow.E 1) (h • (0 : Submission.Mostow.E 1))) := by
  have hA' : POBasic 1 := POBasic.ofProp hA
  have hI' : HypIsoData 1 := HypIsoData.ofProp hI
  have hdiscT : IsDiscrete (SetLike.coe T) :=
    hdisc.mono (fun x hx => ((hT x).mp hx).1)
  have hfree : ∀ g ∈ T, g ≠ 1 → ∀ x : E 1, g • x ≠ x := by
    intro g hg hg1
    rcases ((hT g).mp hg).2 with h | h
    · exact absurd h hg1
    · exact h
  have hpos_of_ne_one : ∀ h ∈ T, h ≠ 1 → 0 < hdist (0 : E 1) (h • (0 : E 1)) := by
    intro h hh hh1
    have hne : h • (0 : E 1) ≠ 0 := hfree h hh hh1 0
    rcases lt_or_eq_of_le (hI'.nonneg (0 : E 1) (h • (0 : E 1))) with hlt | heq
    · exact hlt
    · exfalso
      exact hne (((hI'.eq_zero (0 : E 1) (h • (0 : E 1))).mp heq.symm).symm)
  constructor
  · intro h hhD
    rw [hT (h * h)]
    exact ⟨mul_mem hhD hhD, sq_dichotomy hA' hI' h⟩
  · by_cases hex : ∃ h ∈ T, h ≠ 1
    · right
      obtain ⟨g₁, hg₁T, hg₁ne⟩ := hex
      obtain ⟨g₀, hg₀T, hg₀pos, hg₀min⟩ :=
        minimalPositiveDisplacement hA hI T hdiscT ⟨g₁, hg₁T, hpos_of_ne_one g₁ hg₁T hg₁ne⟩
      have hd₀ : hdist (0 : E 1) (g₀ • (0 : E 1)) = |Phi g₀ 0| := by
        rw [hdist_zero_eq_sc, Phi_zero_arg]
      set gc : PO 1 1 := if 0 < Phi g₀ 0 then g₀ else g₀⁻¹ with hgcdef
      have hgcT : gc ∈ T := by
        rw [hgcdef]; split
        · exact hg₀T
        · exact T.inv_mem hg₀T
      have hPhic : Phi gc 0 = |Phi g₀ 0| := by
        rw [hgcdef]; split
        · rename_i hp
          exact (abs_of_pos hp).symm
        · rename_i hp
          rw [Phi_inv_zero hA' hI' hfree hg₀T, abs_of_nonpos (le_of_not_gt hp)]
      have hdc : 0 < Phi gc 0 := by
        rw [hPhic, ← hd₀]; exact hg₀pos
      have hmin : ∀ h ∈ T, h ≠ 1 → Phi gc 0 ≤ hdist (0 : E 1) (h • (0 : E 1)) := by
        intro h hh hh1
        have := hg₀min h hh (hpos_of_ne_one h hh hh1)
        rwa [hd₀, ← hPhic] at this
      have hpow : ∀ {h : PO 1 1}, h ∈ T → 0 ≤ Phi h 0 → ∃ n : ℕ, gc ^ n = h := by
        intro h hh hq
        obtain ⟨n, hnlo, hnhi⟩ := floor_step_nat hq hdc
        refine ⟨n, ?_⟩
        set k : PO 1 1 := h * (gc ^ n)⁻¹ with hkdef
        have hkT : k ∈ T := T.mul_mem hh (T.inv_mem (T.pow_mem hgcT n))
        have hkpsi : Phi k 0 = Phi h 0 - n * Phi gc 0 := by
          rw [hkdef, Phi_mul_zero hA' hI' hfree hh,
            Phi_inv_zero hA' hI' hfree (T.pow_mem hgcT n),
            Phi_pow_zero hA' hI' hfree hgcT n]
          ring
        have hknn : 0 ≤ Phi k 0 := by rw [hkpsi]; linarith
        have hklt : Phi k 0 < Phi gc 0 := by rw [hkpsi]; linarith
        by_cases hk1 : k = 1
        · have hh' : h * (gc ^ n)⁻¹ = 1 := by rw [← hkdef]; exact hk1
          exact (mul_inv_eq_one.mp hh').symm
        · exfalso
          have hle := hmin k hkT hk1
          have hz : hdist (0 : E 1) (k • (0 : E 1)) = Phi k 0 := by
            rw [hdist_zero_eq_sc, ← Phi_zero_arg k, abs_of_nonneg hknn]
          rw [hz] at hle
          linarith
      have hcyc : ∀ {h : PO 1 1}, h ∈ T → ∃ n : ℤ, gc ^ n = h := by
        intro h hh
        by_cases hq : 0 ≤ Phi h 0
        · obtain ⟨n, hn⟩ := hpow hh hq
          exact ⟨(n : ℤ), by rw [zpow_natCast]; exact hn⟩
        · have hq' : Phi h 0 < 0 := lt_of_not_ge hq
          have hqh : 0 ≤ Phi h⁻¹ 0 := by
            rw [Phi_inv_zero hA' hI' hfree hh]
            linarith
          obtain ⟨n, hn⟩ := hpow (T.inv_mem hh) hqh
          refine ⟨-(n : ℤ), ?_⟩
          have hz : gc ^ (-(n : ℤ)) = (gc ^ n)⁻¹ := by rw [zpow_neg, zpow_natCast]
          rw [hz, hn, inv_inv]
      have hTeq : T = Subgroup.closure ({gc} : Set (PO 1 1)) := by
        apply le_antisymm
        · intro h hh
          rw [Subgroup.mem_closure_singleton]
          exact hcyc hh
        · rw [Subgroup.closure_le]
          intro x hx
          rw [Set.mem_singleton_iff] at hx
          rw [hx]
          exact hgcT
      have hgcne : gc ≠ 1 := by
        intro h1
        rw [h1, Phi_one hA'] at hdc
        simp at hdc
      refine ⟨gc, hgcT, fun x => hfree gc hgcT hgcne x, hTeq, ?_⟩
      intro h hh hh1
      rw [hdist_zero_eq_sc, ← Phi_zero_arg gc, abs_of_pos hdc]
      exact hmin h hh hh1
    · left
      have hall : ∀ h ∈ T, h = 1 := by
        intro h hh
        by_contra h1
        exact hex ⟨h, hh, h1⟩
      ext h
      rw [Subgroup.mem_bot]
      exact ⟨fun hh => hall h hh, fun h1 => by rw [h1]; exact T.one_mem⟩

end Work.Mostow
