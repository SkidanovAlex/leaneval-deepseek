import Mathlib
import Submission.Work.Mostow.flatEllipticBase
import Submission.Work.Mostow.levYcFormula

/-!
# The elliptic (flat rotation) gap at a cusp of a lattice

`Work.Mostow.flatEllipticGap`: for a lattice `Γ ≤ PO(n,1)` (`n ≥ 3`), a parabolic fixed point
`ξ ∈ parFixed Γ` and a non-trivial **elliptic** `γ ∈ Γ` fixing `ξ` which acts on the flat space
`ξ^⊥` (the horospheres at `ξ`) by an affine isometry `y ↦ A y + v`, some unit vector `y ⊥ ξ` is
moved by at least a uniform `θ > 0`: `θ ≤ ‖A y - y‖`.

The proof has two halves.

* The *finiteness* half: for `η > 0` the Zassenhaus constant, there is `θ₀ > 0` such that the set
  of non-trivial elliptics of `Γ_ξ` whose flat rotation is `θ₀`-small is finite (`feg_cegBad_finite`).
  This is the Zassenhaus argument: a finite set of `θ₀`-small elliptics is simultaneously
  near-identity at a common deep point `hptOf ξ 0 L` (`feg_common_deep`, via `feg_nearIdAt_of_small`
  and the flat displacement formula `hdist_fPart`), hence generates a subgroup of a nilpotent
  group; that subgroup is finitely generated and generated by torsion elements (each elliptic of a
  discrete group has finite order, `cegIsOfFinOrder`), hence finite (`nilp_torsionGen_finite`). The
  fixed subspaces of the finite subgroups so obtained form a decreasing family of subspaces of the
  finite-dimensional hyperboloid lift, so they stabilise: all `θ₀`-small elliptics have a common
  fixed point, and the setwise stabiliser of a point in a discrete group is finite (`cegStabFinite`).
* The *gap* half: the finitely many `θ₀`-small elliptics are bounded away from the identity on
  `ξ^⊥` (`eq_one_of_fPart_eq_id` shows that the identity flat linear part forces `γ = 1`), while
  every other elliptic fixing `ξ` rotates by more than `θ₀`; the minimum of these finitely many
  positive quantities is the required `θ`.

The two halves are proved for the flat linear part `fPart ξ σ = flatLin ξ (Λ σ)` of the flat action;
the general affine pair `(A, v)` of the statement is identified with `(fPart ξ γ, fShift ξ γ)` by
`fPart_eq_of_flatData` (which uses only the flat-action formula supplied as a hypothesis).
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity

noncomputable section

variable {n : ℕ}

/-- A constant dominating `√(2 e (cosh 1 - 1))`. -/
def fegK : ℝ := Real.sqrt (2 * Real.exp 1 * (Real.cosh 1 - 1)) + 1

lemma fegK_pos : 0 < fegK := by
  have h2 : 1 < Real.cosh 1 := Real.one_lt_cosh.mpr one_ne_zero
  have h3 : 0 < Real.exp 1 := Real.exp_pos 1
  have h1 : 0 < 2 * Real.exp 1 * (Real.cosh 1 - 1) := by nlinarith
  have h4 := Real.sqrt_nonneg (2 * Real.exp 1 * (Real.cosh 1 - 1))
  rw [fegK]
  linarith

/-- The constant `√(2 (cosh η - 1))`. -/
noncomputable def fegC (η : ℝ) : ℝ := Real.sqrt (2 * (Real.cosh η - 1))

lemma fegC_pos {η : ℝ} (hη : 0 < η) : 0 < fegC η := by
  have h2 : 1 < Real.cosh η := Real.one_lt_cosh.mpr (ne_of_gt hη)
  rw [fegC, Real.sqrt_pos]
  linarith

lemma fegC_sq {η : ℝ} (hη : 0 < η) : (fegC η) ^ 2 = 2 * (Real.cosh η - 1) := by
  have h2 : 1 < Real.cosh η := Real.one_lt_cosh.mpr (ne_of_gt hη)
  rw [fegC, Real.sq_sqrt (by linarith)]

lemma feg_hlift_inj {u v : E n} (h : hlift u = hlift v) : u = v := by
  ext i; exact congrFun h (Sum.inl i)

/-- The ambient *fixed subspace* of a set of elements of `PO n 1`, in the hyperboloid lift. -/
noncomputable def fegFixSub (S : Set (PO n 1)) : Submodule ℝ (Fin n ⊕ Fin 1 → ℝ) :=
  ⨅ σ ∈ S, LinearMap.ker ((LambdaMat σ).mulVecLin - LinearMap.id)

lemma feg_memFixSub {S : Set (PO n 1)} {x : Fin n ⊕ Fin 1 → ℝ} :
    x ∈ fegFixSub S ↔ ∀ σ ∈ S, (LambdaMat σ).mulVecLin x = x := by
  simp only [fegFixSub, Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.sub_apply,
    LinearMap.id_coe, id_eq, sub_eq_zero]

lemma feg_mono {S T : Set (PO n 1)} (h : S ⊆ T) : fegFixSub T ≤ fegFixSub S := by
  intro x hx
  rw [feg_memFixSub] at hx ⊢
  exact fun σ hσ => hx σ (h hσ)

/-- The image of a set of elements of `Γ` in `PO n 1`. -/
def fegIm {Γ : Subgroup (PO n 1)} (T : Set Γ) : Set (PO n 1) := Subtype.val '' T

lemma fegIm_union {Γ : Subgroup (PO n 1)} {T T' : Set Γ} :
    fegIm (T ∪ T') = fegIm T ∪ fegIm T' := by
  ext x; constructor
  · rintro ⟨τ, hτ | hτ, rfl⟩ <;> [left; right] <;> exact ⟨τ, hτ, rfl⟩
  · rintro (⟨τ, hτ, rfl⟩ | ⟨τ, hτ, rfl⟩)
    · exact ⟨τ, Or.inl hτ, rfl⟩
    · exact ⟨τ, Or.inr hτ, rfl⟩

lemma feg_mem_fegIm {Γ : Subgroup (PO n 1)} {T : Set Γ} {x : PO n 1} :
    x ∈ fegIm T ↔ ∃ τ ∈ T, (τ : PO n 1) = x := Iff.rfl

lemma feg_hlift_fix (hA : POActionProp n) {σ : PO n 1} {p : E n} (hp : σ • p = p) :
    (LambdaMat σ).mulVecLin (hlift p) = hlift p := by
  rw [Matrix.mulVecLin_apply, ← hlift_LambdaMat hA σ p, hp]

/-- **The deep-point estimate.**  An elliptic `σ` fixing `ξ` with a small flat rotation and a
small flat translation part is `NearIdAt · z η` at the deep point `z = hptOf ξ 0 L`. -/
lemma feg_nearIdAt_of_small (hA : POActionProp n) (hI : HypIsometryProp n)
    {ξ : E n} (hξ : ξ ∈ Sph n) {σ : PO n 1} (hbd : bd σ ξ = ξ)
    (hell : ∃ p : E n, σ • p = p) {θ L η : ℝ} (hθ : 0 ≤ θ) (hL : 0 < L) (hη : 0 < η)
    (hsmall : cegSmall ξ θ σ)
    (hconst : Real.exp 1 * (θ * fegK + L * ‖fShift ξ σ‖) < fegC η) :
    NearIdAt σ (hptOf ξ 0 L) η := by
  have hId : HypIsoData n := HypIsoData.ofProp hI
  intro u hu
  have hzl : lev ξ (hptOf ξ 0 L) = L := (hptOf_level ξ hξ L hL 0 (by simp)).1
  have hzy : yc ξ (hptOf ξ 0 L) = 0 := (hptOf_level ξ hξ L hL 0 (by simp)).2
  have hLu : 0 < lev ξ u := lev_pos ξ hξ u
  have hcosh := levYcFormula hξ (hptOf ξ 0 L) u
  rw [hzl, hzy, zero_sub, norm_neg] at hcosh
  have hle1 : Real.cosh (hdist (hptOf ξ 0 L) u) ≤ Real.cosh 1 := by
    rw [Real.cosh_le_cosh, abs_of_nonneg (hId.nonneg _ _), abs_one]
    exact hu
  have hkey : Real.cosh (Real.log (L / lev ξ u)) ≤ Real.cosh 1 := by
    have h2 : (L * lev ξ u / 2) * ‖yc ξ u‖ ^ 2 ≥ 0 := by positivity
    linarith [hcosh ▸ hle1]
  have hlog := (Real.cosh_le_cosh.mp hkey)
  rw [abs_le, abs_one] at hlog
  have hlevu : lev ξ u ≤ Real.exp 1 * L := by
    have h1 : Real.exp (-1) ≤ L / lev ξ u := by
      have h2 := Real.exp_le_exp.mpr hlog.1
      rwa [Real.exp_log (div_pos hL hLu)] at h2
    rw [le_div_iff₀ hLu] at h1
    have h3 : Real.exp 1 * (Real.exp (-1) * lev ξ u) ≤ Real.exp 1 * L :=
      mul_le_mul_of_nonneg_left h1 (Real.exp_pos 1).le
    have h4 : Real.exp 1 * Real.exp (-1) = 1 := by rw [← Real.exp_add]; norm_num
    rwa [← mul_assoc, h4, one_mul] at h3
  have hlevu' : L / Real.exp 1 ≤ lev ξ u := by
    have h1 : L / lev ξ u ≤ Real.exp 1 := by
      have h2 := Real.exp_le_exp.mpr hlog.2
      rwa [Real.exp_log (div_pos hL hLu)] at h2
    rw [div_le_iff₀ hLu] at h1
    rw [div_le_iff₀ (Real.exp_pos 1)]
    linarith
  have hycc : (L * lev ξ u / 2) * ‖yc ξ u‖ ^ 2 ≤ Real.cosh 1 - 1 := by
    have h2 : Real.cosh (Real.log (L / lev ξ u)) ≥ 1 := Real.one_le_cosh _
    linarith [hcosh ▸ hle1]
  have hyc : ‖yc ξ u‖ ≤ fegK / L := by
    have h2 : (L * (L / Real.exp 1) / 2) * ‖yc ξ u‖ ^ 2 ≤ Real.cosh 1 - 1 := by
      have h3 : L * (L / Real.exp 1) / 2 ≤ L * lev ξ u / 2 := by
        have := mul_le_mul_of_nonneg_left hlevu' hL.le
        linarith
      nlinarith [sq_nonneg ‖yc ξ u‖]
    have h4 : ‖yc ξ u‖ ^ 2 ≤ 2 * Real.exp 1 * (Real.cosh 1 - 1) / L ^ 2 := by
      have h5 : 2 * (Real.cosh 1 - 1) / (L * (L / Real.exp 1))
          = 2 * Real.exp 1 * (Real.cosh 1 - 1) / L ^ 2 := by
        field_simp
      have h6 : ‖yc ξ u‖ ^ 2 ≤ 2 * (Real.cosh 1 - 1) / (L * (L / Real.exp 1)) := by
        rw [le_div_iff₀ (by positivity : (0:ℝ) < L * (L / Real.exp 1))]
        nlinarith
      rwa [h5] at h6
    have h7 : ‖yc ξ u‖ ≤ Real.sqrt (2 * Real.exp 1 * (Real.cosh 1 - 1)) / L := by
      have hA : Real.sqrt (‖yc ξ u‖ ^ 2) ≤ Real.sqrt (2 * Real.exp 1 * (Real.cosh 1 - 1) / L ^ 2) :=
        Real.sqrt_le_sqrt h4
      have hpos : (0:ℝ) ≤ 2 * Real.exp 1 * (Real.cosh 1 - 1) := by
        have h1 : 1 < Real.cosh 1 := Real.one_lt_cosh.mpr one_ne_zero
        have h2 : 0 < Real.exp 1 := Real.exp_pos 1
        nlinarith
      rw [Real.sqrt_sq (norm_nonneg (yc ξ u)), Real.sqrt_div hpos, Real.sqrt_sq hL.le] at hA
      exact hA
    have h8 : Real.sqrt (2 * Real.exp 1 * (Real.cosh 1 - 1)) ≤ fegK := by
      rw [fegK]; linarith [Real.sqrt_nonneg (2 * Real.exp 1 * (Real.cosh 1 - 1))]
    have h9 : Real.sqrt (2 * Real.exp 1 * (Real.cosh 1 - 1)) / L ≤ fegK / L :=
      div_le_div_of_nonneg_right h8 hL.le
    linarith
  have hstep : ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖
      ≤ θ * ‖yc ξ u‖ + ‖fShift ξ σ‖ := by
    have h0 : ‖fPart ξ σ (yc ξ u) - yc ξ u‖ ≤ θ * ‖yc ξ u‖ := hsmall (yc ξ u) (inner_yc_Sph hξ u)
    have h1 : fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u
        = (fPart ξ σ (yc ξ u) - yc ξ u) + fShift ξ σ := by abel
    rw [h1]
    exact le_trans (norm_add_le _ _) (by linarith)
  have hmain : lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖
      ≤ Real.exp 1 * (θ * fegK + L * ‖fShift ξ σ‖) := by
    have hA1 : lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖
        ≤ lev ξ u * (θ * ‖yc ξ u‖ + ‖fShift ξ σ‖) :=
      mul_le_mul_of_nonneg_left hstep hLu.le
    have hA2 : θ * ‖yc ξ u‖ ≤ θ * (fegK / L) := mul_le_mul_of_nonneg_left hyc hθ
    have hA3 : lev ξ u * (θ * ‖yc ξ u‖ + ‖fShift ξ σ‖)
        ≤ Real.exp 1 * L * (θ * (fegK / L) + ‖fShift ξ σ‖) := by
      have h3 : θ * ‖yc ξ u‖ + ‖fShift ξ σ‖ ≤ θ * (fegK / L) + ‖fShift ξ σ‖ := by linarith
      have hnn1 : 0 ≤ θ * ‖yc ξ u‖ := mul_nonneg hθ (norm_nonneg _)
      have hnn2 : 0 ≤ θ * (fegK / L) + ‖fShift ξ σ‖ := by linarith [norm_nonneg (fShift ξ σ)]
      have hnn3 : 0 ≤ Real.exp 1 * L := by positivity
      have hnnc : 0 ≤ θ * ‖yc ξ u‖ + ‖fShift ξ σ‖ := by linarith [hnn1, norm_nonneg (fShift ξ σ)]
      exact mul_le_mul hlevu h3 hnnc hnn3
    have hA4 : Real.exp 1 * L * (θ * (fegK / L) + ‖fShift ξ σ‖)
        = Real.exp 1 * (θ * fegK + L * ‖fShift ξ σ‖) := by
      field_simp
    linarith [hA1, hA3, hA4.le, hA4.ge]
  have hdist_lt : hdist u (σ • u) < η := by
    rw [hdist_fPart hA hI hξ hbd hell u]
    have hpos : 0 < 1 + (lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖) ^ 2 / 2 := by
      positivity
    have h2 : 1 + (lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖) ^ 2 / 2
        < Real.cosh η := by
      have h3 : (lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖) ^ 2
          < (fegC η) ^ 2 := by
        have h4 : lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖ < fegC η :=
          lt_of_le_of_lt hmain hconst
        have h5 : 0 ≤ lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖ := by positivity
        nlinarith [h4, fegC_pos hη]
      rw [fegC_sq hη] at h3
      linarith
    calc Real.arcosh (1 + (lev ξ u * ‖fPart ξ σ (yc ξ u) + fShift ξ σ - yc ξ u‖) ^ 2 / 2)
        < Real.arcosh (Real.cosh η) := (Real.arcosh_lt_arcosh hpos (Real.cosh_pos η)).mpr h2
      _ = η := Real.arcosh_cosh (le_of_lt hη)
  exact hdist_lt


/-- **A common deep point.**  For a finite set `S` of `θ₀`-small elliptics in `Γ_ξ` with `θ₀` small
enough wrt the Zassenhaus constant of `η`, there is a point `z` at which all of `S` is `NearIdAt`. -/
lemma feg_common_deep (hA : POActionProp n) (hI : HypIsometryProp n)
    {Γ : Subgroup (PO n 1)} {ξ : E n} (hξ : ξ ∈ Sph n) {θ₀ η : ℝ} (hθ₀ : 0 ≤ θ₀)
    (hη : 0 < η) (hθ₀c : Real.exp 1 * (θ₀ * fegK) < fegC η / 2)
    (S : Finset Γ) (hS : ∀ σ ∈ S, σ ∈ cegBad Γ ξ θ₀) :
    ∃ z : E n, ∀ σ ∈ S, NearIdAt (σ : PO n 1) z η := by
  classical
  set V : ℝ := S.sum (fun σ => ‖fShift ξ (σ : PO n 1)‖) + 1 with hV
  have hVpos : 0 < V := by positivity
  have hSV : ∀ σ ∈ S, ‖fShift ξ (σ : PO n 1)‖ ≤ V := by
    intro σ hσ
    have h1 : ‖fShift ξ (σ : PO n 1)‖
        ≤ S.sum (fun σ => ‖fShift ξ (σ : PO n 1)‖) :=
      Finset.single_le_sum (f := fun σ : Γ => ‖fShift ξ (σ : PO n 1)‖)
        (fun i _ => norm_nonneg _) hσ
    rw [hV]
    linarith
  have hdiv : θ₀ * fegK < fegC η / (2 * Real.exp 1) := by
    have he : 0 < Real.exp 1 := Real.exp_pos 1
    have h : θ₀ * fegK * Real.exp 1 < fegC η / 2 := by linarith [hθ₀c]
    have h' : θ₀ * fegK < (fegC η / 2) / Real.exp 1 := (lt_div_iff₀ he).mpr h
    rwa [div_div] at h'
  set L : ℝ := (fegC η / (2 * Real.exp 1) - θ₀ * fegK) / (2 * V) with hL
  have hLpos : 0 < L := by
    rw [hL]
    exact div_pos (by linarith) (by positivity)
  have hfegCp : 0 < fegC η := fegC_pos hη
  refine ⟨hptOf ξ 0 L, fun σ hσ => ?_⟩
  obtain ⟨hbd, hne1, hell, hsmall⟩ := mem_cegBad.mp (hS σ hσ)
  refine feg_nearIdAt_of_small hA hI hξ hbd hell hθ₀ hLpos hη hsmall ?_
  have h2 : L * ‖fShift ξ (σ : PO n 1)‖ ≤ L * V :=
    mul_le_mul_of_nonneg_left (hSV σ hσ) hLpos.le
  have h3 : L * V = (fegC η / (2 * Real.exp 1) - θ₀ * fegK) / 2 := by
    rw [hL]; field_simp
  have h1 : L * ‖fShift ξ (σ : PO n 1)‖ ≤ (fegC η / (2 * Real.exp 1) - θ₀ * fegK) / 2 := by
    linarith [h2, h3.le, h3.ge]
  have h4 : Real.exp 1 * (θ₀ * fegK + L * ‖fShift ξ (σ : PO n 1)‖)
      < Real.exp 1 * (fegC η / (2 * Real.exp 1)) := by
    refine mul_lt_mul_of_pos_left ?_ (Real.exp_pos 1)
    linarith [hdiv, h1]
  have h5 : Real.exp 1 * (fegC η / (2 * Real.exp 1)) = fegC η / 2 := by field_simp
  linarith [h4, h5.le, h5.ge, hfegCp]

/-- **Finite generation closes up.**  A finite set of `θ₀`-small elliptics generates a finite
subgroup of `Γ`. -/
lemma feg_closure_finite (hA : POActionProp n) (hI : HypIsometryProp n)
    {Γ : Subgroup (PO n 1)} (hdisc : IsDiscrete (SetLike.coe Γ)) {ξ : E n} (hξ : ξ ∈ Sph n)
    {θ₀ η : ℝ} (hθ₀ : 0 ≤ θ₀)
    (hθ₀c : Real.exp 1 * (θ₀ * fegK) < fegC η / 2) (hη : 0 < η)
    (hZ : ∀ z : E n, Group.IsNilpotent
      (Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η}))
    (S : Finset Γ) (hS : ∀ σ ∈ S, σ ∈ cegBad Γ ξ θ₀) :
    ((Subgroup.closure (↑S : Set Γ) : Subgroup Γ) : Set Γ).Finite := by
  classical
  obtain ⟨z, hz⟩ := feg_common_deep hA hI hξ hθ₀ hη hθ₀c S hS
  haveI : Group.IsNilpotent ↥(Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η}) := hZ z
  have hle : Subgroup.closure (↑S : Set Γ)
      ≤ Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η} :=
    Subgroup.closure_mono (fun γ hγ => hz γ hγ)
  haveI : Group.IsNilpotent
      ↥((Subgroup.closure (↑S : Set Γ)).subgroupOf
        (Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η})) := Subgroup.isNilpotent _
  have hnil : Group.IsNilpotent ↥(Subgroup.closure (↑S : Set Γ)) :=
    (Group.isNilpotent_congr (Subgroup.subgroupOfEquivOfLe hle)).mp inferInstance
  have hfg : Group.FG ↥(Subgroup.closure (↑S : Set Γ)) :=
    (Group.fg_iff_subgroup_fg _).mpr
      ((Subgroup.fg_iff _).mpr ⟨(↑S : Set Γ), rfl, S.finite_toSet⟩)
  have hgen : Subgroup.closure {h : ↥(Subgroup.closure (↑S : Set Γ)) | IsOfFinOrder h} = ⊤ := by
    refine eq_top_iff.mpr ?_
    rw [← Subgroup.closure_preimage_eq_top (↑S : Set Γ)]
    refine Subgroup.closure_mono ?_
    intro h hh
    have hmem : ((h : ↥(Subgroup.closure (↑S : Set Γ))) : Γ) ∈ S := hh
    have hbad : ((h : ↥(Subgroup.closure (↑S : Set Γ))) : Γ) ∈ cegBad Γ ξ θ₀ := hS _ hmem
    obtain ⟨-, -, hell, -⟩ := mem_cegBad.mp hbad
    obtain ⟨k, hk, hk1⟩ :=
      (isOfFinOrder_iff_pow_eq_one).mp (cegIsOfFinOrder hA hI hdisc _ hell)
    refine (isOfFinOrder_iff_pow_eq_one).mpr ⟨k, hk, ?_⟩
    exact Subtype.ext (by simpa using hk1)
  exact (Set.finite_coe_iff).mp (nilp_torsionGen_finite hgen)

/-- **The small-rotation elliptics are finite.**  For a suitable (small) threshold `θ₀` the set of
non-trivial elliptics of `Γ_ξ` whose flat rotation is `θ₀`-small is finite. -/
lemma feg_cegBad_finite (hA : POActionProp n) (hI : HypIsometryProp n)
    {Γ : Subgroup (PO n 1)} (hdisc : IsDiscrete (SetLike.coe Γ)) {ξ : E n} (hξ : ξ ∈ Sph n)
    {η : ℝ} (hη : 0 < η)
    (hZ : ∀ z : E n, Group.IsNilpotent
      (Subgroup.closure {γ : Γ | NearIdAt (γ : PO n 1) z η})) :
    ∃ θ₀ : ℝ, 0 < θ₀ ∧ (cegBad Γ ξ θ₀).Finite := by
  classical
  have hfegC : 0 < fegC η := fegC_pos hη
  have he : 0 < Real.exp 1 := Real.exp_pos 1
  have hK : 0 < fegK := fegK_pos
  set θ₀ : ℝ := min 1 (fegC η / (4 * Real.exp 1 * fegK)) with hθ₀def
  have hθ₀pos : 0 < θ₀ := by
    rw [hθ₀def]
    exact lt_min one_pos (by positivity)
  have hθ₀c : Real.exp 1 * (θ₀ * fegK) < fegC η / 2 := by
    have h1 : θ₀ ≤ fegC η / (4 * Real.exp 1 * fegK) := min_le_right _ _
    have h2 : θ₀ * fegK ≤ fegC η / (4 * Real.exp 1) := by
      have h3 := mul_le_mul_of_nonneg_right h1 hK.le
      have h4 : fegC η / (4 * Real.exp 1 * fegK) * fegK = fegC η / (4 * Real.exp 1) := by
        field_simp
      rwa [h4] at h3
    have h2' : Real.exp 1 * (θ₀ * fegK) ≤ fegC η / 4 := by
      have h3 := mul_le_mul_of_nonneg_left h2 he.le
      have h4 : Real.exp 1 * (fegC η / (4 * Real.exp 1)) = fegC η / 4 := by field_simp
      linarith [h3, h4.le, h4.ge]
    linarith [h2', hfegC]
  have hpred : ∃ d : ℕ, ∃ T : Set Γ, T.Finite ∧ T ⊆ (cegBad Γ ξ θ₀ : Set Γ) ∧
      Module.finrank ℝ ↥(fegFixSub (fegIm T)) = d :=
    ⟨_, ∅, Set.finite_empty, Set.empty_subset _, rfl⟩
  obtain ⟨T₀, hT₀fin, hT₀sub, hT₀dim⟩ := Nat.find_spec hpred
  have hminall : ∀ T : Set Γ, T.Finite → T ⊆ (cegBad Γ ξ θ₀ : Set Γ) →
      Nat.find hpred ≤ Module.finrank ℝ ↥(fegFixSub (fegIm T)) := by
    intro T hTfin hTsub
    by_contra hlt
    push_neg at hlt
    exact absurd (Nat.find_min' hpred ⟨T, hTfin, hTsub, rfl⟩) (not_le.mpr hlt)
  have hle₀ : ∀ T : Set Γ, T.Finite → T ⊆ (cegBad Γ ξ θ₀ : Set Γ) →
      fegFixSub (fegIm T₀) ≤ fegFixSub (fegIm T) := by
    intro T hTfin hTsub
    have h1 : fegFixSub (fegIm (T ∪ T₀)) ≤ fegFixSub (fegIm T₀) := by
      rw [fegIm_union]
      exact feg_mono Set.subset_union_right
    have h2 : Nat.find hpred ≤ Module.finrank ℝ ↥(fegFixSub (fegIm (T ∪ T₀))) :=
      hminall _ (hTfin.union hT₀fin) (Set.union_subset hTsub hT₀sub)
    have h3 : Module.finrank ℝ ↥(fegFixSub (fegIm (T ∪ T₀)))
        ≤ Module.finrank ℝ ↥(fegFixSub (fegIm T₀)) := Submodule.finrank_mono h1
    have h4 : fegFixSub (fegIm (T ∪ T₀)) = fegFixSub (fegIm T₀) :=
      Submodule.eq_of_le_of_finrank_eq h1 (le_antisymm h3 (by rw [hT₀dim]; exact h2))
    rw [← h4, fegIm_union]
    exact feg_mono Set.subset_union_left
  have hS₀bad : ∀ σ ∈ hT₀fin.toFinset, σ ∈ cegBad Γ ξ θ₀ := by
    intro σ hσ
    exact hT₀sub (hT₀fin.mem_toFinset.mp hσ)
  have hclfin : ((Subgroup.closure (↑hT₀fin.toFinset : Set Γ) : Subgroup Γ) : Set Γ).Finite :=
    feg_closure_finite hA hI hdisc hξ hθ₀pos.le hθ₀c hη hZ hT₀fin.toFinset hS₀bad
  have hmapfin : ((Subgroup.map Γ.subtype (Subgroup.closure (↑hT₀fin.toFinset : Set Γ))
      : Subgroup (PO n 1)) : Set (PO n 1)).Finite := by
    rw [Subgroup.coe_map]
    exact hclfin.image _
  obtain ⟨p, hp⟩ := fixPoint_of_finite hA
    (Subgroup.map Γ.subtype (Subgroup.closure (↑hT₀fin.toFinset : Set Γ)))
    ((Set.finite_coe_iff).mp hmapfin)
  have hfix : ∀ e : Γ, e ∈ cegBad Γ ξ θ₀ → (e : PO n 1) • p = p := by
    intro e he
    have hTefin : ({e} : Set Γ).Finite := Set.finite_singleton e
    have hTesub : ({e} : Set Γ) ⊆ (cegBad Γ ξ θ₀ : Set Γ) := by
      intro x hx; rw [Set.mem_singleton_iff] at hx; rwa [hx]
    have hSub : fegFixSub (fegIm T₀) ≤ fegFixSub (fegIm ({e} : Set Γ)) := hle₀ _ hTefin hTesub
    have hx : hlift p ∈ fegFixSub (fegIm T₀) := by
      rw [feg_memFixSub]
      rintro x ⟨τ, hτ, rfl⟩
      have hτ' : τ ∈ (↑hT₀fin.toFinset : Set Γ) := (hT₀fin.mem_toFinset).mpr hτ
      have hpmem : ((τ : Γ) : PO n 1) ∈ Subgroup.map Γ.subtype
          (Subgroup.closure (↑hT₀fin.toFinset : Set Γ)) :=
        Subgroup.mem_map_of_mem Γ.subtype (Subgroup.subset_closure hτ')
      exact feg_hlift_fix hA (hp ((τ : Γ) : PO n 1) hpmem)
    have h2 : (LambdaMat (e : PO n 1)).mulVecLin (hlift p) = hlift p := by
      have h3 := hSub hx
      rw [feg_memFixSub] at h3
      exact h3 (e : PO n 1) ⟨e, by rw [Set.mem_singleton_iff], rfl⟩
    rw [Matrix.mulVecLin_apply, ← hlift_LambdaMat hA e p] at h2
    exact feg_hlift_inj h2
  refine ⟨θ₀, hθ₀pos, (cegStabFinite hA hI hdisc p).subset ?_⟩
  intro e he
  exact hfix e he


/-- **The elliptic gap, in terms of the flat linear part.** For a lattice `Γ ≤ PO(n,1)` with
`n ≥ 2`, a parabolic fixed point `ξ ∈ parFixed Γ` and a non-trivial elliptic `σ ∈ Γ` fixing `ξ`,
some unit vector of `ξ^⊥` is moved by at least a uniform `θ > 0` under the flat linear part
`fPart ξ σ`. -/
theorem feg_gap_core (n : ℕ) (hn : 2 ≤ n) (hA : Submission.Mostow.POActionProp n)
    (hI : Submission.Mostow.HypIsometryProp n)
    (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)) (hΓ : Submission.Mostow.HypLattice Γ)
    (ξ : Submission.Mostow.E n) (hξ : ξ ∈ Work.Mostow.parFixed Γ) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (σ : Γ),
      Submission.Mostow.bd (σ : LeanEval.Geometry.MostowRigidity.PO n 1) ξ = ξ → σ ≠ 1 →
      (∃ p : Submission.Mostow.E n, (σ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p) →
      ∃ y : Submission.Mostow.E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧
        θ ≤ ‖fPart ξ (σ : LeanEval.Geometry.MostowRigidity.PO n 1) y - y‖ := by
  classical
  obtain ⟨η₀, hη₀, hZ⟩ := zassenhausNilpotent n hn hA hI
  obtain ⟨θ₀, hθ₀pos, hfin⟩ := feg_cegBad_finite hA hI hΓ.1 hξ.1 hη₀ (hZ Γ hΓ.1)
  have hex : ∀ σ : Γ, σ ∈ cegBad Γ ξ θ₀ → ∃ y : E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧
      0 < ‖fPart ξ (σ : PO n 1) y - y‖ := by
    intro σ hσ
    by_contra hcon
    push_neg at hcon
    refine hσ.2.1 (Subtype.ext (eq_one_of_fPart_eq_id hA hI hξ.1 hσ.1 hσ.2.2.1 ?_))
    intro y hy
    rcases eq_or_ne y 0 with rfl | hy0
    · exact map_zero _
    · have hy1 : inner ℝ ((‖y‖ : ℝ)⁻¹ • y) ξ = 0 := by
        rw [real_inner_smul_left, hy, mul_zero]
      have hyn : ‖((‖y‖ : ℝ)⁻¹ • y : E n)‖ = 1 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr hy0)),
          inv_mul_cancel₀ (ne_of_gt (norm_pos_iff.mpr hy0))]
      have h2 := hcon _ hy1 hyn
      have h3 : fPart ξ (σ : PO n 1) ((‖y‖ : ℝ)⁻¹ • y) - (‖y‖ : ℝ)⁻¹ • y = 0 := by
        have h4 : ‖fPart ξ (σ : PO n 1) ((‖y‖ : ℝ)⁻¹ • y) - (‖y‖ : ℝ)⁻¹ • y‖ = 0 :=
          le_antisymm h2 (norm_nonneg _)
        exact norm_eq_zero.mp h4
      have h5 : (‖y‖ : ℝ)⁻¹ • (fPart ξ (σ : PO n 1) y - y) = 0 := by
        rw [map_smul, ← smul_sub] at h3
        exact h3
      have h6 := congrArg (fun z : E n => (‖y‖ : ℝ) • z) h5
      have h7 : fPart ξ (σ : PO n 1) y - y = 0 := by
        simpa [smul_smul, mul_inv_cancel₀ (ne_of_gt (norm_pos_iff.mpr hy0)), one_smul] using h6
      exact sub_eq_zero.mp h7
  -- the minimal value over the finite set
  have hmain : ∃ θ : ℝ, 0 < θ ∧ ∀ σ : Γ, σ ∈ cegBad Γ ξ θ₀ →
      ∃ y : E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧
        θ ≤ ‖fPart ξ (σ : PO n 1) y - y‖ := by
    by_cases hne : (cegBad Γ ξ θ₀ : Set Γ).Nonempty
    · haveI : Fintype ↥(cegBad Γ ξ θ₀) := hfin.fintype
      haveI : Nonempty ↥(cegBad Γ ξ θ₀) := hne.to_subtype
      let yfun : ↥(cegBad Γ ξ θ₀) → E n := fun σ => Classical.choose (hex σ.1 σ.2)
      have hcfun : ∀ σ : ↥(cegBad Γ ξ θ₀), 0 < ‖fPart ξ ((σ : Γ) : PO n 1)
          (yfun σ) - yfun σ‖ := fun σ => (Classical.choose_spec (hex σ.1 σ.2)).2.2
      set vals : Finset ℝ := Finset.univ.image (fun σ : ↥(cegBad Γ ξ θ₀) =>
        ‖fPart ξ ((σ : Γ) : PO n 1) (yfun σ) - yfun σ‖) with hvals
      have hvalsne : vals.Nonempty := ⟨_, Finset.mem_image.mpr
        ⟨Classical.choice ‹Nonempty ↥(cegBad Γ ξ θ₀)›, Finset.mem_univ _, rfl⟩⟩
      have hminpos : 0 < vals.min' hvalsne := by
        obtain ⟨σ, -, hval⟩ := Finset.mem_image.mp (Finset.min'_mem vals hvalsne)
        rw [← hval]
        exact hcfun σ
      refine ⟨min θ₀ (vals.min' hvalsne), ?_, ?_⟩
      · exact lt_min hθ₀pos hminpos
      · intro σ hσ
        refine ⟨yfun ⟨σ, hσ⟩, (Classical.choose_spec (hex σ hσ)).1,
          (Classical.choose_spec (hex σ hσ)).2.1, ?_⟩
        refine le_trans (min_le_right _ _) ?_
        exact Finset.min'_le vals _ (Finset.mem_image.mpr ⟨⟨σ, hσ⟩, Finset.mem_univ _, rfl⟩)
    · refine ⟨θ₀, hθ₀pos, fun σ hσ => ?_⟩
      exact absurd ⟨σ, hσ⟩ hne
  obtain ⟨θ, hθpos, hθ⟩ := hmain
  refine ⟨min θ θ₀, lt_min hθpos hθ₀pos, fun σ hbd hne1 hell => ?_⟩
  by_cases hσ : σ ∈ cegBad Γ ξ θ₀
  · obtain ⟨y, hy, hy1, hyle⟩ := hθ σ hσ
    exact ⟨y, hy, hy1, le_trans (min_le_left _ _) hyle⟩
  · simp only [mem_cegBad, not_and_or, not_exists] at hσ
    have hsmall : ¬ cegSmall ξ θ₀ (σ : PO n 1) := by
      rcases hσ with h | h | h | h
      · exact absurd hbd h
      · exact absurd hne1 h
      · rcases hell with ⟨p, hp⟩
        exact absurd hp (h p)
      · exact h
    rw [cegSmall] at hsmall
    push_neg at hsmall
    obtain ⟨y, hy, hyne⟩ := hsmall
    rw [← fPart_apply] at hyne
    have hy0 : y ≠ 0 := by
      rintro rfl
      have h0 : ‖(fPart ξ (σ : PO n 1)) (0 : E n) - 0‖ = 0 := by
        rw [map_zero, sub_zero, norm_zero]
      rw [h0, norm_zero, mul_zero] at hyne
      exact lt_irrefl 0 hyne
    have hyperp : inner ℝ ((‖y‖ : ℝ)⁻¹ • y) ξ = 0 := by
      rw [real_inner_smul_left, hy, mul_zero]
    have hynorm : ‖((‖y‖ : ℝ)⁻¹ • y : E n)‖ = 1 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr hy0)),
        inv_mul_cancel₀ (ne_of_gt (norm_pos_iff.mpr hy0))]
    refine ⟨(‖y‖ : ℝ)⁻¹ • y, hyperp, hynorm, ?_⟩
    have hsm : ‖fPart ξ (σ : PO n 1) ((‖y‖ : ℝ)⁻¹ • y) - (‖y‖ : ℝ)⁻¹ • y‖
        = (‖y‖ : ℝ)⁻¹ * ‖fPart ξ (σ : PO n 1) y - y‖ := by
      rw [map_smul, ← smul_sub, norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr hy0))]
    rw [hsm]
    refine le_trans (min_le_right _ _) ?_
    rw [← div_eq_inv_mul, le_div_iff₀ (norm_pos_iff.mpr hy0)]
    linarith [hyne]

theorem flatEllipticGap (n : ℕ) (hn : 3 ≤ n)
    (hA : Submission.Mostow.POActionProp n) (hI : Submission.Mostow.HypIsometryProp n)
    (Γ : Subgroup (LeanEval.Geometry.MostowRigidity.PO n 1)) (hΓ : Submission.Mostow.HypLattice Γ)
    (ξ : Submission.Mostow.E n) (hξ : ξ ∈ Work.Mostow.parFixed Γ) :
    ∃ θ : ℝ, 0 < θ ∧ ∀ (γ : Γ) (A : Submission.Mostow.E n →ₗ[ℝ] Submission.Mostow.E n)
      (v : Submission.Mostow.E n),
      (γ : LeanEval.Geometry.MostowRigidity.PO n 1) ≠ 1 →
      Submission.Mostow.bd (γ : LeanEval.Geometry.MostowRigidity.PO n 1) ξ = ξ →
      (∃ p : Submission.Mostow.E n, (γ : LeanEval.Geometry.MostowRigidity.PO n 1) • p = p) →
      (∀ y : Submission.Mostow.E n, inner ℝ y ξ = 0 → inner ℝ (A y) ξ = 0) →
      (∀ y : Submission.Mostow.E n, inner ℝ y ξ = 0 → ‖A y‖ = ‖y‖) →
      (∀ (y : Submission.Mostow.E n) (D : ℝ), inner ℝ y ξ = 0 → 0 < D →
        Work.Mostow.lev ξ ((γ : LeanEval.Geometry.MostowRigidity.PO n 1) • Work.Mostow.hptOf ξ y D) = D ∧
        Work.Mostow.yc ξ ((γ : LeanEval.Geometry.MostowRigidity.PO n 1) • Work.Mostow.hptOf ξ y D) = A y + v) →
      ∃ y : Submission.Mostow.E n, inner ℝ y ξ = 0 ∧ ‖y‖ = 1 ∧ θ ≤ ‖A y - y‖ := by
  obtain ⟨θ, hθpos, hθspec⟩ := feg_gap_core n (by omega) hA hI Γ hΓ ξ hξ
  refine ⟨θ, hθpos, ?_⟩
  intro γ A v hγne hbd hell hAperp hAnorm hform
  obtain ⟨hAeq, hv⟩ := fPart_eq_of_flatData hA hI hξ.1 hbd hell hform
  obtain ⟨y, hy, hy1, hyle⟩ := hθspec γ hbd (fun h => hγne (by rw [h]; rfl)) hell
  exact ⟨y, hy, hy1, by rw [hAeq y hy]; exact hyle⟩

end

end Work.Mostow
