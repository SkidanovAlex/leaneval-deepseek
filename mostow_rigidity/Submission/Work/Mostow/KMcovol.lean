/-!
# Kazhdan–Margulis covolume bound (route B)

`KMcovol` proves `CovolLB k` for `k ≥ 2`.  The core is `KMthick`: for every lattice
`Γ ≤ PO k 1` there is a point of injectivity radius at least a universal `ε > 0`.
The proof maximises the injectivity radius (`thickMax`) and rules out a small maximum by the
usual case analysis: either a short infinite-order element produces a common invariant set
(`shortInfinite`), which is then pushed away (`rayStrictHoro` / `rayStrictPair`), or all short
elements are torsion; then the subgroup generated by the short elements is finite
(`margulisIndexFinite` + `zassenhausNilpotent` + `nilp_torsionGen_finite`), fixes a point
(`fixPoint_of_finite`), and the point is pushed away (`rayStrictPoint`).
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory
open scoped Topology Matrix

noncomputable section

/-- A subgroup of a nilpotent group is nilpotent (for an explicitly given containing subgroup). -/
lemma isNilpotent_of_le {G : Type*} [Group G] {H K : Subgroup G} [hK : Group.IsNilpotent ↥K]
    (h : H ≤ K) : Group.IsNilpotent ↥H := by
  haveI : Group.IsNilpotent ↥(H.subgroupOf K) := Subgroup.isNilpotent (H.subgroupOf K)
  exact Group.nilpotent_of_mulEquiv (Subgroup.subgroupOfEquivOfLe h)

/-- If a subgroup is generated by torsion elements, the closure of its own torsion elements is
everything. -/
lemma closure_torsion_subtype_eq_top {G : Type*} [Group G] (H : Subgroup G) (S : Set G)
    (hH : H = Subgroup.closure S) (hS : ∀ x ∈ S, IsOfFinOrder x) :
    Subgroup.closure {h : ↥H | IsOfFinOrder h} = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  have hx : (x : G) ∈ Subgroup.closure S := by rw [← hH]; exact x.2
  have hmain : ∀ z : ↥H, (z : G) = (x : G) →
      z ∈ Subgroup.closure {h : ↥H | IsOfFinOrder h} :=
    Subgroup.closure_induction
      (p := fun y hy => ∀ z : ↥H, (z : G) = y → z ∈ Subgroup.closure {h : ↥H | IsOfFinOrder h})
      (fun y hy z hz => by
        have htor : IsOfFinOrder (⟨y, by rw [hH]; exact Subgroup.subset_closure hy⟩ : ↥H) :=
          Submonoid.isOfFinOrder_coe.mp (hS y hy)
        have hzy : z = ⟨y, by rw [hH]; exact Subgroup.subset_closure hy⟩ := Subtype.ext hz
        rw [hzy]
        exact Subgroup.subset_closure htor)
      (fun z hz => by
        have hz1 : z = 1 := Subtype.ext (by simpa using hz)
        rw [hz1]; exact Subgroup.one_mem _)
      (fun y y' hy hy' ih1 ih2 z hz => by
        have h1 := ih1 ⟨y, by rw [hH]; exact hy⟩ rfl
        have h2 := ih2 ⟨y', by rw [hH]; exact hy'⟩ rfl
        have hprod := Subgroup.mul_mem _ h1 h2
        have heq : (⟨y, by rw [hH]; exact hy⟩ * ⟨y', by rw [hH]; exact hy'⟩ : ↥H) = z :=
          Subtype.ext (by rw [Subgroup.coe_mul]; exact hz.symm)
        exact heq ▸ hprod)
      (fun y hy ih z hz => by
        have h1 := ih ⟨y, by rw [hH]; exact hy⟩ rfl
        have hinv := Subgroup.inv_mem _ h1
        have heq : (⟨y, by rw [hH]; exact hy⟩ : ↥H)⁻¹ = z :=
          Subtype.ext (by rw [Subgroup.coe_inv]; exact hz.symm)
        exact heq ▸ hinv)
      hx
  exact hmain x rfl

/-! ## A finite subgroup of `PO n 1` has a fixed point -/

lemma KMmink_add_left {n : ℕ} (x y z : Fin n ⊕ Fin 1 → ℝ) :
    Hyper.mink (x + y) z = Hyper.mink x z + Hyper.mink y z := by
  simp only [Hyper.mink, add_dotProduct]

lemma KMmink_add_right {n : ℕ} (x y z : Fin n ⊕ Fin 1 → ℝ) :
    Hyper.mink x (y + z) = Hyper.mink x y + Hyper.mink x z := by
  simp only [Hyper.mink, Matrix.mulVec_add, dotProduct_add]

lemma KMmink_sum_left {n : ℕ} {ι : Type*} (s : Finset ι) (f : ι → (Fin n ⊕ Fin 1 → ℝ))
    (y : Fin n ⊕ Fin 1 → ℝ) :
    Hyper.mink (∑ i ∈ s, f i) y = ∑ i ∈ s, Hyper.mink (f i) y := by
  classical
  induction s using Finset.induction with
  | empty => simp [Hyper.mink]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, KMmink_add_left, ih]

lemma KMmink_sum_right {n : ℕ} {ι : Type*} (s : Finset ι) (x : Fin n ⊕ Fin 1 → ℝ)
    (f : ι → (Fin n ⊕ Fin 1 → ℝ)) :
    Hyper.mink x (∑ i ∈ s, f i) = ∑ i ∈ s, Hyper.mink x (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp [Hyper.mink]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, KMmink_add_right, ih]

/-- **A finite subgroup of `PO n 1` fixes a point of `ℍⁿ`.** -/
theorem finiteFixes (n : ℕ) (hA : POActionProp n) (F : Subgroup (PO n 1)) (hF : Finite F) :
    ∃ p : E n, ∀ f ∈ F, f • p = p := by
  classical
  haveI : Fintype F := Fintype.ofFinite F
  haveI : Nonempty F := ⟨1⟩
  set v : Fin n ⊕ Fin 1 → ℝ := ∑ f : F, hlift ((f : PO n 1) • (0 : E n)) with hv
  have htime : 0 < v (Sum.inr 0) := by
    rw [hv, Finset.sum_apply]
    have hpos : 0 < ∑ f : F, tpart ((f : PO n 1) • (0 : E n)) :=
      Finset.sum_pos (fun f _ => Hyper.tpart_pos _) Finset.univ_nonempty
    simpa [hlift] using hpos
  have hcard : (1 : ℝ) ≤ (Fintype.card F : ℝ) := by
    exact_mod_cast Fintype.card_pos (α := F)
  have hminkneg : Hyper.mink v v < 0 := by
    rw [hv, KMmink_sum_left]
    have hstep : ∀ f : F, ∑ g : F, Hyper.mink (hlift ((f : PO n 1) • (0 : E n)))
        (hlift ((g : PO n 1) • (0 : E n))) ≤ -1 := by
      intro f
      have h1 : ∀ g : F, Hyper.mink (hlift ((f : PO n 1) • (0 : E n)))
          (hlift ((g : PO n 1) • (0 : E n))) ≤ -1 := by
        intro g
        rw [Hyper.mink_hlift]
        have h2 := one_le_cosh_hdist ((f : PO n 1) • (0 : E n)) ((g : PO n 1) • (0 : E n))
        linarith
      calc ∑ g : F, Hyper.mink (hlift ((f : PO n 1) • (0 : E n)))
              (hlift ((g : PO n 1) • (0 : E n)))
          ≤ ∑ _g : F, (-1 : ℝ) := Finset.sum_le_sum (fun g _ => h1 g)
        _ = -((Fintype.card F : ℕ) : ℝ) := by
              rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring
        _ ≤ -1 := by linarith
    have hle : ∑ f : F, Hyper.mink (hlift ((f : PO n 1) • (0 : E n))) v ≤ -1 := by
      calc ∑ f : F, Hyper.mink (hlift ((f : PO n 1) • (0 : E n))) v
          ≤ ∑ _f : F, (-1 : ℝ) := by
            refine Finset.sum_le_sum (fun f _ => ?_)
            rw [hv, KMmink_sum_right]
            exact hstep f
        _ = -((Fintype.card F : ℕ) : ℝ) := by
              rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring
        _ ≤ -1 := by linarith
    linarith
  set μ : ℝ := Real.sqrt (-(Hyper.mink v v)) with hμ
  have hμpos : 0 < μ := by rw [hμ]; exact Real.sqrt_pos.mpr (neg_pos.mpr hminkneg)
  have hμsq : μ * μ = -(Hyper.mink v v) := by
    rw [hμ, Real.mul_self_sqrt (le_of_lt (neg_pos.mpr hminkneg))]
  set y : Fin n ⊕ Fin 1 → ℝ := μ⁻¹ • v with hy
  have hminky : Hyper.mink y y = -1 := by
    rw [hy, Hyper.mink_smul]
    have hvμ : Hyper.mink v v = -(μ * μ) := by linarith [hμsq]
    rw [hvμ, mul_neg]
    have h : μ⁻¹ * μ⁻¹ * (μ * μ) = 1 := by
      rw [show μ⁻¹ * μ⁻¹ * (μ * μ) = (μ⁻¹ * μ) * (μ⁻¹ * μ) by ring,
        inv_mul_cancel₀ (ne_of_gt hμpos), mul_one]
    rw [h]
  have hypos : 0 < y (Sum.inr 0) := by
    rw [hy, Pi.smul_apply, smul_eq_mul]
    exact mul_pos (inv_pos.mpr hμpos) htime
  have hfixv : ∀ g : F, (emat ((g : F) : PO n 1)).mulVec v = v := by
    intro g
    rw [hv, Matrix.mulVec_sum]
    have hstep : ∀ f : F,
        (emat ((g : F) : PO n 1)).mulVec (hlift (((f : F) : PO n 1) • (0 : E n)))
          = hlift ((((g : F) : PO n 1) * ((f : F) : PO n 1)) • (0 : E n)) := by
      intro f
      rw [emat_hlift, hA.2.2.2.2.1]
    rw [Finset.sum_congr rfl (fun f _ => hstep f)]
    exact Equiv.sum_comp (Equiv.mulLeft g)
      (fun f : F => hlift (((f : F) : PO n 1) • (0 : E n)))
  refine ⟨Hyper.spat y, fun f hf => ?_⟩
  have hylift : hlift (Hyper.spat y) = y := Hyper.hlift_spat_of_mink y hminky hypos
  have hkey : hlift (((⟨f, hf⟩ : F) : PO n 1) • Hyper.spat y) = hlift (Hyper.spat y) := by
    rw [hylift, ← emat_hlift, hylift, hy]
    rw [Matrix.mulVec_smul, hfixv ⟨f, hf⟩]
  exact Hyper.hlift_injective hkey

/-- **Kazhdan–Margulis, thick point (KM-I).** For `k ≥ 2` there is a universal `ε > 0` such
that every lattice `Γ ≤ PO k 1` has a point of injectivity radius at least `ε`. -/
theorem KMthick (k : ℕ) (hk : 2 ≤ k) (hA : POActionProp k) (hI : HypIsometryProp k)
    (hM : MargulisCuspProp k) (hL : MargulisLoxProp k) (hC : ClassifyProp k)
    (hmult : ∀ Λ : Subgroup (PO k 1), HypLattice Λ → MultThickProp Λ) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ Γ : Subgroup (PO k 1), HypLattice Γ →
      ∃ x : E k, ∀ γ : Γ, γ ≠ 1 → ε ≤ hdist x ((γ : PO k 1) • x) := by
  have hAb : POBasic k := POBasic.ofProp hA
  have hIb : HypIsoData k := HypIsoData.ofProp hI
  obtain ⟨ε₂, hε₂pos, hε₂⟩ := shortInfinite k hk hA hI hM hL hC
  obtain ⟨ηZ, hηZpos, hηZ⟩ := zassenhausNilpotent k hk hA hI
  set η : ℝ := min ε₂ ηZ / 2 with hηdef
  have hminpos : 0 < min ε₂ ηZ := lt_min hε₂pos hηZpos
  have hηpos : 0 < η := by rw [hηdef]; exact div_pos hminpos two_pos
  have hηle₂ : η ≤ ε₂ := by rw [hηdef]; linarith [min_le_left ε₂ ηZ, hminpos]
  have hηleZ : η ≤ ηZ := by rw [hηdef]; linarith [min_le_right ε₂ ηZ, hminpos]
  obtain ⟨εmi, hεmipos, m, hmi⟩ := margulisIndexFiniteQ k hk hA hI η hηpos
  set ε₁ : ℝ := min εmi 1 / 2 with hε₁def
  have hε₁pos : 0 < ε₁ := by rw [hε₁def]; exact div_pos (lt_min hεmipos one_pos) two_pos
  have hε₁le_mi : ε₁ ≤ εmi := by rw [hε₁def]; linarith [min_le_left εmi 1, hεmipos]
  have hε₁le_1 : ε₁ ≤ 1 := by rw [hε₁def]; linarith [min_le_right εmi 1]
  refine ⟨ε₁ / 2, by positivity, ?_⟩
  intro Γ hΓ
  obtain ⟨x₀, s, hspos, hle, hmax⟩ := thickMax k hk hA hI Γ hΓ (hmult Γ hΓ)
  refine ⟨x₀, ?_⟩
  have hself : ∀ u : E k, hdist u u ≤ 1 := by
    intro u
    have h : hdist u u = 0 := (hIb.eq_zero u u).mpr rfl
    rw [h]; norm_num
  have hs_ge : ε₁ / 2 ≤ s := by
    by_contra hcon
    have hs_lt : s < ε₁ / 2 := not_le.mp hcon
    set A : Set Γ := {γ | γ ≠ 1 ∧ hdist x₀ ((γ : PO k 1) • x₀) < ε₁} with hAdef
    have hAfin : A.Finite := by
      refine (finite_orbit_near k hA hI hΓ.1 x₀ x₀ ε₁).subset ?_
      intro γ hγ; exact le_of_lt hγ.2
    have finish : ∀ x' : E k, hdist x₀ x' < ε₁ / 4 →
        (∀ γ : Γ, γ ∈ A → hdist x₀ ((γ : PO k 1) • x₀) < hdist x' ((γ : PO k 1) • x')) → False := by
      intro x' hclose hinc
      have hAinc : ∀ γ ∈ A, s < hdist x' ((γ : PO k 1) • x') :=
        fun γ hγ => lt_of_le_of_lt (hle γ hγ.1) (hinc γ hγ)
      obtain ⟨δA, hδApos, hδAle⟩ :
          ∃ δA : ℝ, 0 < δA ∧ ∀ γ ∈ A, s + δA ≤ hdist x' ((γ : PO k 1) • x') := by
        rcases A.eq_empty_or_nonempty with hAe | hAne
        · exact ⟨1, one_pos, fun γ hγ => by rw [hAe] at hγ; simp at hγ⟩
        · set F : Finset Γ := hAfin.toFinset with hF
          have hFne : F.Nonempty := by rw [hF, Set.Finite.toFinset_nonempty]; exact hAne
          refine ⟨F.inf' hFne (fun γ => hdist x' ((γ : PO k 1) • x') - s), ?_, ?_⟩
          · rw [Finset.lt_inf'_iff]
            intro γ hγ
            have hγA : γ ∈ A := by rw [hF, Set.Finite.mem_toFinset] at hγ; exact hγ
            exact sub_pos.mpr (hAinc γ hγA)
          · intro γ hγ
            have hmem : γ ∈ F := by rw [hF, Set.Finite.mem_toFinset]; exact hγ
            have hle' := Finset.inf'_le (s := F) (fun γ => hdist x' ((γ : PO k 1) • x') - s) hmem
            linarith
      set δ : ℝ := min δA (ε₁ / 2 - s) / 2 with hδdef
      have hδpos : 0 < δ := by
        rw [hδdef]; exact div_pos (lt_min hδApos (by linarith)) two_pos
      have hδleA : δ ≤ δA := by rw [hδdef]; linarith [min_le_left δA (ε₁ / 2 - s)]
      have hδle2 : δ ≤ ε₁ / 2 - s := by rw [hδdef]; linarith [min_le_right δA (ε₁ / 2 - s)]
      have hgap : ∀ γ : Γ, γ ≠ 1 → s + δ ≤ hdist x' ((γ : PO k 1) • x') := by
        intro γ hγne
        by_cases hγA : γ ∈ A
        · have h1 := hδAle γ hγA; linarith
        · have hd : ε₁ ≤ hdist x₀ ((γ : PO k 1) • x₀) := by
            by_contra hlt
            exact hγA ⟨hγne, not_le.mp hlt⟩
          have htri : hdist x₀ ((γ : PO k 1) • x₀)
              ≤ hdist x₀ x' + hdist x' ((γ : PO k 1) • x') + hdist x₀ x' := by
            have h1 := hIb.triangle x₀ x' ((γ : PO k 1) • x₀)
            have h2 := hIb.triangle x' ((γ : PO k 1) • x') ((γ : PO k 1) • x₀)
            have h3 : hdist ((γ : PO k 1) • x') ((γ : PO k 1) • x₀) = hdist x' x₀ :=
              hIb.isom_smul (γ : PO k 1) x' x₀
            rw [h3, hIb.symm x' x₀] at h2
            linarith
          linarith
      obtain ⟨γ, hγ1, hγlt⟩ := hmax x' (s + δ / 2) (by linarith)
      have hgg := hgap γ hγ1
      linarith
    by_cases hinf : ∃ γ : Γ, ¬ IsOfFinOrder γ ∧ hdist x₀ ((γ : PO k 1) • x₀) < ε₂
    · obtain ⟨γ₀, hγ₀inf, hγ₀short⟩ := hinf
      rcases hε₂ Γ hΓ.1 x₀ γ₀ hγ₀inf hγ₀short with ⟨ξ, hξ, hpt⟩ | ⟨a, b, ha, hb, hab, hpair⟩
      · obtain ⟨x', hx'dist, hx'mono⟩ := rayStrictHoro k hA hI ξ hξ x₀ (ε₁ / 4) (by positivity)
        refine finish x' hx'dist ?_
        intro γ hγ
        have hγle : hdist x₀ ((γ : PO k 1) • x₀) ≤ 1 := le_trans (le_of_lt hγ.2) hε₁le_1
        have hpos : 0 < hdist x₀ ((γ : PO k 1) • x₀) := lt_of_lt_of_le hspos (hle γ hγ.1)
        exact hx'mono (γ : PO k 1) (hpt γ hγle).1 (hpt γ hγle).2 hpos
      · obtain ⟨x', hx'dist, hx'mono⟩ := rayStrictPair k hk hA hI a b x₀ ha hb hab (ε₁ / 4) (by positivity)
        refine finish x' hx'dist ?_
        intro γ hγ
        have hγle : hdist x₀ ((γ : PO k 1) • x₀) ≤ 1 := le_trans (le_of_lt hγ.2) hε₁le_1
        have hpos : 0 < hdist x₀ ((γ : PO k 1) • x₀) := lt_of_lt_of_le hspos (hle γ hγ.1)
        exact hx'mono (γ : PO k 1) (hpair γ hγle) hpos
    · have hfin' : ∀ γ : Γ, hdist x₀ ((γ : PO k 1) • x₀) < ε₂ → IsOfFinOrder γ := by
        intro γ hγ
        by_contra hnf
        exact hinf ⟨γ, hnf, hγ⟩
      set Δ : Subgroup (PO k 1) := Subgroup.closure {g | g ∈ Γ ∧ hdist x₀ (g • x₀) < εmi} with hΔ
      set N : Subgroup (PO k 1) := Subgroup.closure {g | g ∈ Δ ∧ NearIdAt g x₀ η} with hN
      obtain ⟨hFI, hIdx⟩ := hmi Γ hΓ.1 x₀
      -- `N` is nilpotent: it lies in the image of the Zassenhaus subgroup of `Γ`
      set ZΓ : Subgroup Γ := Subgroup.closure {γ : Γ | NearIdAt (γ : PO k 1) x₀ ηZ} with hZΓ
      have hZΓnil : Group.IsNilpotent ↥ZΓ := hηZ Γ hΓ.1 x₀
      set K : Subgroup (PO k 1) := ZΓ.map Γ.subtype with hK
      haveI hKnil : Group.IsNilpotent ↥K :=
        Group.nilpotent_of_mulEquiv (Subgroup.equivMapOfInjective ZΓ Γ.subtype Γ.subtype_injective)
      have hNK : N ≤ K := by
        rw [hN]
        refine (Subgroup.closure_le K).mpr ?_
        rintro g ⟨hgΔ, hgN⟩
        have hgΓ : g ∈ Γ := by
          rw [hΔ] at hgΔ
          exact (Subgroup.closure_le Γ).mpr (fun z hz => hz.1) hgΔ
        exact ⟨⟨g, hgΓ⟩, Subgroup.subset_closure (NearIdAt_mono hgN hηleZ), rfl⟩
      haveI : Group.IsNilpotent ↥N := isNilpotent_of_le hNK
      -- `N` is finitely generated
      have hKfin : {g : PO k 1 | g ∈ Δ ∧ NearIdAt g x₀ η}.Finite := by
        have hTfin : {γ : Γ | NearIdAt (γ : PO k 1) x₀ η}.Finite := by
          refine (finite_orbit_near k hA hI hΓ.1 x₀ x₀ η).subset ?_
          intro γ hγ
          exact le_of_lt (hγ x₀ (hself x₀))
        refine (hTfin.image (Subtype.val : Γ → PO k 1)).subset ?_
        rintro g ⟨hgΔ, hgN⟩
        have hgΓ : g ∈ Γ := by
          rw [hΔ] at hgΔ
          exact (Subgroup.closure_le Γ).mpr (fun z hz => hz.1) hgΔ
        exact ⟨⟨g, hgΓ⟩, hgN, rfl⟩
      haveI : Group.FG ↥N := by
        haveI : Finite {g : PO k 1 | g ∈ Δ ∧ NearIdAt g x₀ η} := hKfin
        rw [hN]
        exact Group.closure_finite_fg _
      -- every element of `N` is a product of torsion elements
      have hgen : Subgroup.closure {h : ↥N | IsOfFinOrder h} = ⊤ := by
        refine closure_torsion_subtype_eq_top N {g : PO k 1 | g ∈ Δ ∧ NearIdAt g x₀ η} ?_ ?_
        · rw [hN]
        · rintro g ⟨hgΔ, hgN⟩
          have hgΓ : g ∈ Γ := by
            rw [hΔ] at hgΔ
            exact (Subgroup.closure_le Γ).mpr (fun z hz => hz.1) hgΔ
          have hgshort : hdist x₀ (g • x₀) < ε₂ := lt_of_lt_of_le (hgN x₀ (hself x₀)) hηle₂
          exact Submonoid.isOfFinOrder_coe.mpr (hfin' ⟨g, hgΓ⟩ hgshort)
      have hNfin : Finite ↥N := nilp_torsionGen_finite hgen
      -- hence `Δ` is finite
      have hNleΔ : N ≤ Δ := (Subgroup.closure_le _).mpr (fun g hg => hg.1)
      have hNsubfin : Finite ↥(N.subgroupOf Δ) :=
        Finite.of_equiv ↥N (Subgroup.subgroupOfEquivOfLe hNleΔ).symm.toEquiv
      have hΔfin : Finite ↥Δ :=
        (Subgroup.finite_iff_finite_and_finiteIndex (N.subgroupOf Δ)).mpr ⟨hNsubfin, hFI⟩
      obtain ⟨y, hy⟩ := finiteFixes k hA Δ hΔfin
      obtain ⟨x', hx'dist, hx'mono⟩ := rayStrictPoint k hA hI y x₀ (ε₁ / 4) (by positivity)
      refine finish x' hx'dist ?_
      intro γ hγ
      have hγΔ : (γ : PO k 1) ∈ Δ := by
        rw [hΔ]
        exact Subgroup.subset_closure ⟨γ.2, lt_of_lt_of_le hγ.2 hε₁le_mi⟩
      have hpos : 0 < hdist x₀ ((γ : PO k 1) • x₀) := lt_of_lt_of_le hspos (hle γ hγ.1)
      exact hx'mono (γ : PO k 1) (hy _ hγΔ) hpos
  intro γ hγ
  exact le_trans hs_ge (hle γ hγ)

/-- **Kazhdan–Margulis covolume bound (KM-J).** -/
theorem KMcovol (k : ℕ) (hk : 2 ≤ k) (hA : POActionProp k) (hI : HypIsometryProp k)
    (hM : MargulisCuspProp k) (hL : MargulisLoxProp k) (hPS : PairStabProp k) (hC : ClassifyProp k)
    (hmult : ∀ Λ : Subgroup (PO k 1), HypLattice Λ → MultThickProp Λ) : CovolLB k := by
  have hIb : HypIsoData k := HypIsoData.ofProp hI
  obtain ⟨ε, hεpos, hε⟩ := KMthick k hk hA hI hM hL hC hmult
  obtain ⟨c, hcpos, hcovol⟩ := covol_of_thick k hA hI ε hεpos
  refine ⟨c, hcpos, ?_⟩
  intro Λ hΛdisc D hD
  by_cases htop : volH k D = ⊤
  · rw [htop]; exact le_top
  · have hlat : HypLattice Λ := ⟨hΛdisc, ⟨D, hD, htop⟩⟩
    obtain ⟨x, hx⟩ := hε Λ hlat
    refine hcovol Λ hΛdisc D hD x ?_
    intro l hl
    by_contra hl1
    have hshort : hdist x ((l : PO k 1) • x) < ε :=
      hl x (by have h0 : hdist x x = 0 := (hIb.eq_zero x x).mpr rfl; rw [h0]; norm_num)
    have hge := hx l hl1
    linarith

end

end Work.Mostow
