import Mathlib
import Submission.Work.Mostow.geomFiniteThickThinDefs
import Submission.Work.Mostow.geomFiniteDefs
import Submission.Work.Mostow.Hyper

/-!
# Vocabulary for the thin-tube cocompactness lemma

* `Tube g ε` : the `ε`-tube of an isometry `g`, `{u | hdist u (g • u) < ε}`;
* `Dirichlet Γ` : the Dirichlet domain of `Γ` around the base point `0`,
  `{u | ∀ δ : Γ, hdist 0 u ≤ hdist 0 (δ • u)}`.

`ThinTube Γ ε` (from `geomFiniteThickThinDefs`) is the union of the tubes of the elements of `Γ`
which have no fixed point in `ℍⁿ` and are not parabolic.

The elementary facts proved here are the invariance of `Tube g ε` under the cyclic group
generated by `g`.
-/

namespace Work.Mostow

open Submission.Mostow LeanEval.Geometry.MostowRigidity MeasureTheory

noncomputable section

variable {n : ℕ}

/-- The `ε`-tube of an isometry `g`: the points moved by less than `ε` by `g`. -/
def Tube (g : PO n 1) (ε : ℝ) : Set (E n) := {u | hdist u (g • u) < ε}

/-- The Dirichlet domain of `Γ` around the base point `0`: the points that are at least as close
to `0` as all their `Γ`-translates. -/
def Dirichlet (Γ : Subgroup (PO n 1)) : Set (E n) :=
  {u | ∀ δ : Γ, hdist (0 : E n) u ≤ hdist (0 : E n) ((δ : PO n 1) • u)}

/-- The tube of `g` is invariant under `g`. -/
lemma tube_smul_iff (hI : HypIsometryProp n)
    (g : PO n 1) (ε : ℝ) (u : E n) :
    (g • u ∈ Tube g ε) ↔ (u ∈ Tube g ε) := by
  have h := hI.2.2.2.2.2.2.1 g u (g • u)
  simp only [Tube, Set.mem_ofPred_eq]
  rw [h]

/-- The tube of `g` is invariant under `g⁻¹`. -/
lemma tube_inv_smul_iff (hA : POActionProp n) (hI : HypIsometryProp n)
    (g : PO n 1) (ε : ℝ) (u : E n) :
    (g⁻¹ • u ∈ Tube g ε) ↔ (u ∈ Tube g ε) := by
  have hiso := hI.2.2.2.2.2.2.1
  simp only [Tube, Set.mem_ofPred_eq]
  have h1 : g • (g⁻¹ • u) = u := by
    rw [← hA.2.2.2.2.1 g g⁻¹ u, mul_inv_cancel, hA.2.2.2.1]
  rw [h1, ← hiso g (g⁻¹ • u) u, h1]

/-- The tube of `g` is invariant under positive powers of `g`. -/
lemma tube_pow_mem (hA : POActionProp n) (hI : HypIsometryProp n)
    (g : PO n 1) (ε : ℝ) :
    ∀ (m : ℕ) (u : E n), (g ^ m • u ∈ Tube g ε) ↔ (u ∈ Tube g ε) := by
  intro m
  induction m with
  | zero => intro u; rw [pow_zero, hA.2.2.2.1]
  | succ j ih =>
      intro u
      rw [pow_succ, hA.2.2.2.2.1, ih (g • u), tube_smul_iff hI g ε u]

/-- The tube of `g` is invariant under powers of `g⁻¹`. -/
lemma tube_inv_pow_mem (hA : POActionProp n) (hI : HypIsometryProp n)
    (g : PO n 1) (ε : ℝ) :
    ∀ (m : ℕ) (u : E n), ((g⁻¹) ^ m • u ∈ Tube g ε) ↔ (u ∈ Tube g ε) := by
  intro m
  induction m with
  | zero => intro u; rw [pow_zero, hA.2.2.2.1]
  | succ j ih =>
      intro u
      rw [pow_succ, hA.2.2.2.2.1, ih (g⁻¹ • u), tube_inv_smul_iff hA hI g ε u]

/-- The tube of `g` is invariant under the cyclic group generated by `g`. -/
lemma tube_zpowers_mem (hA : POActionProp n) (hI : HypIsometryProp n)
    (g : PO n 1) (ε : ℝ) {k : PO n 1} (hk : k ∈ Subgroup.zpowers g) (u : E n) :
    (k • u ∈ Tube g ε) ↔ (u ∈ Tube g ε) := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hk
  rw [← hm]
  by_cases hm0 : 0 ≤ m
  · rw [show g ^ m = g ^ m.toNat from by
        rw [← zpow_natCast, Int.toNat_of_nonneg hm0]]
    exact tube_pow_mem hA hI g ε m.toNat u
  · rw [show g ^ m = (g⁻¹) ^ m.natAbs from by
        have h1 : m = -(m.natAbs : ℤ) := by omega
        rw [h1, zpow_neg, inv_pow, zpow_natCast, Int.natAbs_neg, Int.natAbs_natCast]]
    exact tube_inv_pow_mem hA hI g ε m.natAbs u

/-- Conjugating an element without fixed points keeps it without fixed points. -/
lemma no_fixpoint_conj (hA : POActionProp n) {g γ : PO n 1}
    (h : ∀ p : E n, γ • p ≠ p) : ∀ p : E n, (g * γ * g⁻¹) • p ≠ p := by
  intro p hp
  have h1 : (g * γ * g⁻¹) • p = g • (γ • (g⁻¹ • p)) := by
    rw [hA.2.2.2.2.1 (g * γ) g⁻¹ p, hA.2.2.2.2.1 g γ (g⁻¹ • p)]
  rw [h1] at hp
  have hp' : g⁻¹ • (g • (γ • (g⁻¹ • p))) = g⁻¹ • p := by rw [hp]
  have h2 : g⁻¹ • (g • (γ • (g⁻¹ • p))) = γ • (g⁻¹ • p) := by
    rw [← hA.2.2.2.2.1 g⁻¹ g (γ • (g⁻¹ • p)), inv_mul_cancel, hA.2.2.2.1]
  rw [h2] at hp'
  exact h (g⁻¹ • p) hp'

/-- Conjugating a non-parabolic element keeps it non-parabolic. -/
lemma not_isParabolic_conj (hA : POActionProp n) (hI : HypIsometryProp n)
    {g γ : PO n 1} (h : ¬ IsParabolic γ) : ¬ IsParabolic (g * γ * g⁻¹) := by
  intro hc
  refine h ?_
  have h1 := isParabolic_conj hA hI g⁻¹ (g * γ * g⁻¹) hc
  convert h1 using 2
  group

/-- Conjugation identifies the tube of a conjugate with the translate of the tube. -/
lemma hdist_conj (hA : POActionProp n) (hI : HypIsometryProp n)
    (δ γ : PO n 1) (u : E n) :
    hdist (δ • u) ((δ * γ * δ⁻¹) • (δ • u)) = hdist u (γ • u) := by
  rw [hA.2.2.2.2.1 (δ * γ) δ⁻¹ (δ • u)]
  rw [← hA.2.2.2.2.1 δ⁻¹ δ u]
  rw [inv_mul_cancel, hA.2.2.2.1]
  rw [hA.2.2.2.2.1 δ γ u]
  exact hI.2.2.2.2.2.2.1 δ u (γ • u)

/-- `ThinTube` is invariant under `Γ`. -/
lemma thinTube_smul_mem (hA : POActionProp n) (hI : HypIsometryProp n)
    (Γ : Subgroup (PO n 1)) (ε : ℝ) (δ : Γ) {u : E n} (hu : u ∈ ThinTube Γ ε) :
    ((δ : Γ) : PO n 1) • u ∈ ThinTube Γ ε := by
  obtain ⟨γ, hfix, hpar, hdist⟩ := hu
  refine ⟨⟨((δ : Γ) : PO n 1) * (γ : PO n 1) * ((δ : Γ) : PO n 1)⁻¹,
      mul_mem (mul_mem δ.2 γ.2) (inv_mem δ.2)⟩, ?_, ?_, ?_⟩
  · exact no_fixpoint_conj hA hfix
  · exact not_isParabolic_conj hA hI hpar
  · rw [hdist_conj hA hI ((δ : Γ) : PO n 1) (γ : PO n 1) u]
    exact hdist

end

end Work.Mostow
