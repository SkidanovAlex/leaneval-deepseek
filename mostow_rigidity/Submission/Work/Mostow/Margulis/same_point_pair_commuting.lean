variable {n : ℕ}

/-! ## The flat action of a level-preserving stabiliser element on `ξ^⊥` -/

/-- The subspace `ξ^⊥` of the chart `E n`. -/
def pSub (ξ : E n) : Submodule ℝ (E n) := (Submodule.span ℝ {ξ})ᗮ

lemma mem_pSub {ξ x : E n} : x ∈ pSub ξ ↔ inner ℝ x ξ = 0 := by
  rw [pSub, Submodule.mem_orthogonal]
  constructor
  · intro h
    have h1 : inner ℝ ξ x = 0 := h ξ (Submodule.mem_span_singleton_self ξ)
    rwa [real_inner_comm] at h1
  · intro h u hu
    rw [Submodule.mem_span_singleton] at hu
    obtain ⟨c, rfl⟩ := hu
    rw [real_inner_smul_left, real_inner_comm, h, mul_zero]

lemma flatAct_pSub {ξ : E n} (hξ : ξ ∈ Sph n) (g : PO n 1) {y : E n} (hy : y ∈ pSub ξ) :
    flatAct ξ g y ∈ pSub ξ := by
  rw [mem_pSub] at hy ⊢
  exact flatAct_mem hξ g y

lemma zero_mem_pSub (ξ : E n) : (0 : E n) ∈ pSub ξ := by
  rw [mem_pSub]; simp

lemma lev_inv_eq_one (hA : POBasic n) (hI : HypIsoData n) {ξ : E n} (hξ : ξ ∈ Sph n)
    {g : PO n 1} (hg : bd g ξ = ξ) (h0 : lev ξ (g • (0:E n)) = 1) :
    lev ξ (g⁻¹ • (0:E n)) = 1 := by
  have hmul : (g * g⁻¹) • (0:E n) = g • (g⁻¹ • (0:E n)) := hA.mul_smul g g⁻¹ 0
  rw [mul_inv_cancel, hA.one_smul] at hmul
  have h1 : lev ξ (g • (g⁻¹ • (0:E n))) = lev ξ (g⁻¹ • (0:E n)) * lev ξ (g • (0:E n)) :=
    lev_smul_self hI hA ξ hξ g (g⁻¹ • (0:E n)) hg
  rw [← hmul, h0, mul_one] at h1
  have h2 : lev ξ (0 : E n) = 1 := by simp [lev, tpart]
  rw [h2] at h1
  exact h1.symm

/-- The flat action of a level-preserving stabiliser element as an isometry equivalence of the
subspace `ξ^⊥`. -/
def flatIso (hA : POBasic n) (hI : HypIsoData n) {ξ : E n} (hξ : ξ ∈ Sph n)
    {g : PO n 1} (hg : bd g ξ = ξ) (h0 : lev ξ (g • (0:E n)) = 1) :
    ↥(pSub ξ) ≃ᵢ ↥(pSub ξ) :=
  IsometryEquiv.mk
    { toFun := fun y => ⟨flatAct ξ g y, flatAct_pSub hξ g y.2⟩
      invFun := fun y => ⟨flatAct ξ g⁻¹ y, flatAct_pSub hξ g⁻¹ y.2⟩
      left_inv := by
        intro y
        apply Subtype.ext
        have hginv : bd g⁻¹ ξ = ξ := bd_inv_of hξ hA hg
        have h0inv : lev ξ (g⁻¹ • (0:E n)) = 1 := lev_inv_eq_one hA hI hξ hg h0
        have hcomp := flatAct_comp hξ hA hI (g := g⁻¹) (h := g) hginv hg h0inv h0
          (mem_pSub.mp y.2)
        have hone : flatAct ξ (1 : PO n 1) y.1 = y.1 := flatAct_one hξ hA (mem_pSub.mp y.2)
        rw [inv_mul_cancel] at hcomp
        rw [hone] at hcomp
        exact hcomp.symm
      right_inv := by
        intro y
        apply Subtype.ext
        have hginv : bd g⁻¹ ξ = ξ := bd_inv_of hξ hA hg
        have h0inv : lev ξ (g⁻¹ • (0:E n)) = 1 := lev_inv_eq_one hA hI hξ hg h0
        have hcomp := flatAct_comp hξ hA hI (g := g) (h := g⁻¹) hg hginv h0 h0inv
          (mem_pSub.mp y.2)
        have hone : flatAct ξ (1 : PO n 1) y.1 = y.1 := flatAct_one hξ hA (mem_pSub.mp y.2)
        rw [mul_inv_cancel] at hcomp
        rw [hone] at hcomp
        exact hcomp.symm }
    (by
      intro y y'
      have h := flatAct_isometry hξ hA hI hg h0 (mem_pSub.mp y.2) (mem_pSub.mp y'.2)
      simp only [Subtype.edist_eq]
      rw [edist_dist, edist_dist]
      exact congrArg ENNReal.ofReal (by simpa [dist_eq_norm] using h))

/-- `flatIso` is multiplicative. -/
lemma flatIso_mul (hA : POBasic n) (hI : HypIsoData n) {ξ : E n} (hξ : ξ ∈ Sph n)
    {g h : PO n 1} (hg : bd g ξ = ξ) (hh : bd h ξ = ξ)
    (h0g : lev ξ (g • (0:E n)) = 1) (h0h : lev ξ (h • (0:E n)) = 1)
    (h0gh : lev ξ ((g * h) • (0:E n)) = 1) :
    (flatIso hA hI hξ (bd_mul_of hξ hA hg hh) h0gh)
      = (flatIso hA hI hξ hh h0h).trans (flatIso hA hI hξ hg h0g) := by
  apply IsometryEquiv.ext
  intro y
  apply Subtype.ext
  rw [IsometryEquiv.trans_apply]
  dsimp only [flatIso]
  exact flatAct_comp hξ hA hI (g := g) (h := h) hg hh h0g h0h (mem_pSub.mp y.2)

/-- The level-preservation is multiplicative. -/
lemma lev_mul_eq_one (hA : POBasic n) (hI : HypIsoData n) {ξ : E n} (hξ : ξ ∈ Sph n)
    {g h : PO n 1} (hg : bd g ξ = ξ) (h0g : lev ξ (g • (0:E n)) = 1)
    (h0h : lev ξ (h • (0:E n)) = 1) :
    lev ξ ((g * h) • (0:E n)) = 1 := by
  have h1 : (g * h) • (0:E n) = g • (h • (0:E n)) := hA.mul_smul g h 0
  rw [h1, lev_smul_self hI hA ξ hξ g (h • (0:E n)) hg, h0h, h0g, mul_one]


/-! ## The subgroup generated by `γ` and `δ`, and the flat homomorphism -/

lemma closure_bd_fix {ξ : E n} (hξ : ξ ∈ Sph n) (hA : POBasic n) {γ δ : PO n 1}
    (hγ : bd γ ξ = ξ) (hδ : bd δ ξ = ξ) {g : PO n 1}
    (hg : g ∈ Subgroup.closure ({γ, δ} : Set (PO n 1))) : bd g ξ = ξ := by
  induction hg using Subgroup.closure_induction with
  | mem y hy =>
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl
      · exact hγ
      · exact hδ
  | one => exact hA.bd_one ξ hξ
  | mul x y _ _ ihx ihy => exact bd_mul_of hξ hA ihx ihy
  | inv x _ ihx => exact bd_inv_of hξ hA ihx

lemma closure_lev {ξ : E n} (hξ : ξ ∈ Sph n) (hA : POBasic n) (hI : HypIsoData n)
    {γ δ : PO n 1} (hγ : bd γ ξ = ξ) (hδ : bd δ ξ = ξ)
    (h0γ : lev ξ (γ • (0:E n)) = 1) (h0δ : lev ξ (δ • (0:E n)) = 1) {g : PO n 1}
    (hg : g ∈ Subgroup.closure ({γ, δ} : Set (PO n 1))) : lev ξ (g • (0:E n)) = 1 := by
  induction hg using Subgroup.closure_induction with
  | mem y hy =>
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl
      · exact h0γ
      · exact h0δ
  | one => simp [hA.one_smul, lev, tpart]
  | mul x y hx hy ihx ihy =>
      exact lev_mul_eq_one hA hI hξ (closure_bd_fix hξ hA hγ hδ hx) ihx ihy
  | inv x hx ihx =>
      exact lev_inv_eq_one hA hI hξ (closure_bd_fix hξ hA hγ hδ hx) ihx

/-- The flat action as a monoid homomorphism on a level-preserving subgroup. -/
def flatHom (hA : POBasic n) (hI : HypIsoData n) {ξ : E n} (hξ : ξ ∈ Sph n)
    (H : Subgroup (PO n 1)) (hfix : ∀ g ∈ H, bd g ξ = ξ)
    (hlev : ∀ g ∈ H, lev ξ (g • (0:E n)) = 1) :
    H →* (↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) where
  toFun g := flatIso hA hI hξ (hfix g g.2) (hlev g g.2)
  map_one' := by
    apply IsometryEquiv.ext
    intro y
    apply Subtype.ext
    dsimp only [flatIso]
    exact flatAct_one hξ hA (mem_pSub.mp y.2)
  map_mul' g h := by
    apply IsometryEquiv.ext
    intro y
    apply Subtype.ext
    rw [IsometryEquiv.mul_apply]
    dsimp only [flatIso]
    exact flatAct_comp hξ hA hI (g := (g : PO n 1)) (h := (h : PO n 1))
      (hfix g g.2) (hfix h h.2) (hlev g g.2) (hlev h h.2) (mem_pSub.mp y.2)


/-! ## Auxiliary group-theoretic facts, the value of `flatHom`, and proper discontinuity -/

/-- The value of `flatHom` on a subgroup element is given by `flatAct`. -/
lemma flatHom_apply (hA : POBasic n) (hI : HypIsoData n) {ξ : E n} (hξ : ξ ∈ Sph n)
    (H : Subgroup (PO n 1)) (hfix : ∀ g ∈ H, bd g ξ = ξ)
    (hlev : ∀ g ∈ H, lev ξ (g • (0 : E n)) = 1) (h : H) (y : ↥(pSub ξ)) :
    flatHom hA hI hξ H hfix hlev h y
      = ⟨flatAct ξ (h : PO n 1) (y : E n), flatAct_pSub hξ (h : PO n 1) y.2⟩ := rfl

/-- The image of a finitely generated subgroup under a homomorphism is finitely generated. -/
private lemma fg_map_of_fg {G N : Type*} [Group G] [Group N] (f : G →* N) {K : Subgroup G}
    (h : K.FG) : (Subgroup.map f K).FG := by
  obtain ⟨S, hS, hSfin⟩ := (Subgroup.fg_iff K).mp h
  exact (Subgroup.fg_iff _).mpr ⟨f '' S, by rw [← MonoidHom.map_closure, hS], hSfin.image f⟩

/-- The top subgroup of a finitely generated group is finitely generated. -/
private lemma fg_top_of_fg {G : Type*} [Group G] {K : Subgroup G} (h : K.FG) :
    (⊤ : Subgroup K).FG := by
  obtain ⟨S, hS, hSfin⟩ := (Subgroup.fg_iff K).mp h
  refine (Subgroup.fg_iff (⊤ : Subgroup K)).mpr ⟨Subtype.val ⁻¹' S, ?_, ?_⟩
  · rw [Subgroup.eq_top_iff']
    intro k
    have hk : (k : G) ∈ Subgroup.closure S := by rw [hS]; exact k.2
    have hp : ∀ (z : G) (hz : z ∈ Subgroup.closure S), ∀ (hz' : z ∈ K),
        (⟨z, hz'⟩ : K) ∈ Subgroup.closure (Subtype.val ⁻¹' S : Set K) := by
      intro z hz
      induction hz using Subgroup.closure_induction with
      | mem x hx => intro hx'; exact Subgroup.subset_closure hx
      | one => intro hx'; exact Subgroup.one_mem _
      | mul x y hx hy ihx ihy =>
          intro hxy
          have h1 : (⟨x * y, hxy⟩ : K) = (⟨x, hS ▸ hx⟩ : K) * (⟨y, hS ▸ hy⟩ : K) :=
            Subtype.ext rfl
          rw [h1]
          exact Subgroup.mul_mem _ (ihx _) (ihy _)
      | inv x hx ihx =>
          intro hx'
          have h1 : (⟨x⁻¹, hx'⟩ : K) = (⟨x, hS ▸ hx⟩ : K)⁻¹ := Subtype.ext rfl
          rw [h1]
          exact Subgroup.inv_mem _ (ihx _)
    exact hp (k : G) hk k.2
  · exact hSfin.preimage (fun a _ b _ hab => Subtype.ext hab)

/-- The flat action of a level-preserving subgroup of a discrete group on `ξ^⊥` is properly
discontinuous. -/
lemma flatHom_properlyDiscontinuous (hA : POBasic n) (hI : HypIsoData n)
    (Γ : Subgroup (PO n 1)) (hdisc : IsDiscrete (SetLike.coe Γ)) {ξ : E n} (hξ : ξ ∈ Sph n)
    (H : Subgroup (PO n 1)) (hHΓ : H ≤ Γ) (hfix : ∀ g ∈ H, bd g ξ = ξ)
    (hlev : ∀ g ∈ H, lev ξ (g • (0 : E n)) = 1) :
    ∀ K : Set ↥(pSub ξ), IsCompact K →
      {g : (flatHom hA hI hξ H hfix hlev).range |
        ((g : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) '' K ∩ K).Nonempty}.Finite := by
  intro K hK
  set Φ : H →* (↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) := flatHom hA hI hξ H hfix hlev with hΦdef
  have hcont : Continuous (horoPt ξ : E n → E n) := by
    show Continuous (fun y : E n => (‖y‖ ^ 2 / 2) • ξ + y)
    fun_prop
  -- the compact horospherical image of `K`
  have hK''c : IsCompact (horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K)) :=
    (hK.image continuous_subtype_val).image hcont
  -- finitely many group elements move a point of `horoPt ξ '' K` to another such point
  have hfinΓ : {γ : Γ | ∃ u ∈ horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K),
      ∃ v ∈ horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K),
      ((γ : Γ) : PO n 1) • u = v}.Finite :=
    finite_nearStab_compact hA hI hdisc hK''c hK''c
  have hsub : {h : H | ∃ y ∈ K, Φ h y ∈ K} ⊆
      (fun h : H => (⟨(h : PO n 1), hHΓ h.2⟩ : Γ)) ⁻¹'
        {γ : Γ | ∃ u ∈ horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K),
          ∃ v ∈ horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K),
          ((γ : Γ) : PO n 1) • u = v} := by
    rintro h ⟨y, hyK, hyK'⟩
    have hyort : inner ℝ (y : E n) ξ = 0 := mem_pSub.mp y.2
    have h1 : (h : PO n 1) • horoPt ξ (y : E n)
        = horoPt ξ (flatAct ξ (h : PO n 1) (y : E n)) :=
      flatAct_horoPt hξ hA hI (hfix h h.2) (hlev h h.2) hyort
    have h2 : flatAct ξ (h : PO n 1) (y : E n) = (Φ h y : E n) := by
      rw [hΦdef, flatHom_apply]
    refine ⟨horoPt ξ (y : E n), ⟨(y : E n), ⟨y, hyK, rfl⟩, rfl⟩,
      horoPt ξ (Φ h y : E n),
      ⟨(Φ h y : E n), ⟨(Φ h y : ↥(pSub ξ)), hyK', rfl⟩, rfl⟩, ?_⟩
    rw [h1, h2]
  have hfinH : {h : H | ∃ y ∈ K, Φ h y ∈ K}.Finite := by
    have hinj : Set.InjOn (fun h : H => (⟨(h : PO n 1), hHΓ h.2⟩ : Γ))
        ((fun h : H => (⟨(h : PO n 1), hHΓ h.2⟩ : Γ)) ⁻¹'
          {γ : Γ | ∃ u ∈ horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K),
            ∃ v ∈ horoPt ξ '' ((Subtype.val : ↥(pSub ξ) → E n) '' K),
            ((γ : Γ) : PO n 1) • u = v}) := by
      intro a _ b _ hab
      exact Subtype.ext (congrArg (fun z : Γ => (z : PO n 1)) hab)
    exact (hfinΓ.preimage hinj).subset hsub
  have himg : (fun h : H => (⟨Φ h, ⟨h, rfl⟩⟩ : Φ.range)) '' {h : H | ∃ y ∈ K, Φ h y ∈ K}
      = {g : Φ.range | ∃ y ∈ K, (g : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) y ∈ K} := by
    ext g
    constructor
    · rintro ⟨h, hh, rfl⟩
      exact hh
    · rintro ⟨y, hy, hy'⟩
      obtain ⟨h, hh⟩ := MonoidHom.mem_range.mp g.2
      exact ⟨h, ⟨y, hy, by rw [hh]; exact hy'⟩, Subtype.ext hh⟩
  have hfinΦ : {g : Φ.range | ∃ y ∈ K, (g : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) y ∈ K}.Finite := by
    rw [← himg]
    exact hfinH.image _
  have hEq : {g : Φ.range | ((g : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) '' K ∩ K).Nonempty}
      = {g : Φ.range | ∃ y ∈ K, (g : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) y ∈ K} := by
    ext g
    constructor
    · rintro ⟨z, ⟨y, hy, hyz⟩, hzK⟩
      exact ⟨y, hy, hyz ▸ hzK⟩
    · rintro ⟨y, hy, hyK⟩
      exact ⟨(g : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) y, ⟨y, hy, rfl⟩, hyK⟩
  rw [hEq, hΦdef]
  exact hfinΦ

/-! ## The target -/

/-- **Margulis lemma, parabolic case**: two elements `γ δ` of a discrete subgroup `Γ ≤ PO(n,1)`
(`n ≥ 3`) which are entrywise close to the identity (`NearId q`, `8 (n+1)^3 q ≤ 1/2`), which fix no
point of `ℍⁿ` (so they are parabolic rather than elliptic), and which have the *same* boundary fixed
point `ξ` (so `bdFix` is the singleton `{ξ}` for both) have commuting positive powers. -/
theorem same_point_pair_commuting (n : ℕ) (hn : 3 ≤ n) (hA : POActionProp n)
    (hI : HypIsometryProp n) (Γ : Subgroup (PO n 1)) (hdisc : IsDiscrete (SetLike.coe Γ))
    (γ δ : Γ) (q : ℝ) (hq : 0 < q) (hsmall : 8 * (msz n) ^ 3 * q ≤ 1 / 2)
    (hγ : NearId q (γ : PO n 1)) (hδ : NearId q (δ : PO n 1))
    (hnfγ : ∀ u : E n, (γ : PO n 1) • u ≠ u) (hnfδ : ∀ u : E n, (δ : PO n 1) • u ≠ u)
    (ξ : E n) (hξ : ξ ∈ Sph n) (hγfix : bdFix (γ : PO n 1) = {ξ})
    (hδfix : bdFix (δ : PO n 1) = {ξ}) :
    ∃ m k : ℕ, 0 < m ∧ 0 < k ∧
      (γ : PO n 1) ^ m * (δ : PO n 1) ^ k = (δ : PO n 1) ^ k * (γ : PO n 1) ^ m := by
  have hA' : POBasic n := POBasic.ofProp hA
  have hI' : HypIsoData n := HypIsoData.ofProp hI
  have hγξ : bd (γ : PO n 1) ξ = ξ := by
    have hmem : ξ ∈ bdFix (γ : PO n 1) := by rw [hγfix]; exact Set.mem_singleton ξ
    rw [bdFix] at hmem
    exact hmem.2
  have hδξ : bd (δ : PO n 1) ξ = ξ := by
    have hmem : ξ ∈ bdFix (δ : PO n 1) := by rw [hδfix]; exact Set.mem_singleton ξ
    rw [bdFix] at hmem
    exact hmem.2
  have h0γ : lev ξ ((γ : PO n 1) • (0 : E n)) = 1 :=
    lev_eq_one_of_singleton_bdFix n (by omega) hA hI (γ : PO n 1) ξ hξ hγfix
  have h0δ : lev ξ ((δ : PO n 1) • (0 : E n)) = 1 :=
    lev_eq_one_of_singleton_bdFix n (by omega) hA hI (δ : PO n 1) ξ hξ hδfix
  set H : Subgroup (PO n 1) :=
    Subgroup.closure ({(γ : PO n 1), (δ : PO n 1)} : Set (PO n 1)) with hHdef
  have hγH : (γ : PO n 1) ∈ H := by
    rw [hHdef]; exact Subgroup.subset_closure (Set.mem_insert _ _)
  have hδH : (δ : PO n 1) ∈ H := by
    rw [hHdef]
    exact Subgroup.subset_closure (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton _)))
  have hHΓ : H ≤ Γ := by
    rw [hHdef]
    refine (Subgroup.closure_le Γ).mpr ?_
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx2
    · exact γ.2
    · rw [Set.mem_singleton_iff] at hx2
      rw [hx2]; exact δ.2
  have hfixH : ∀ g ∈ H, bd g ξ = ξ := fun g hg => closure_bd_fix hξ hA' hγξ hδξ hg
  have hlevH : ∀ g ∈ H, lev ξ (g • (0 : E n)) = 1 :=
    fun g hg => closure_lev hξ hA' hI' hγξ hδξ h0γ h0δ hg
  set Φ : H →* (↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) := flatHom hA' hI' hξ H hfixH hlevH with hΦdef
  -- injectivity of the flat action
  have hΦinj : Function.Injective Φ := by
    intro a b hab
    have hkey : Φ (a * b⁻¹) = 1 := by
      have h1 : Φ (a * b⁻¹) * Φ b = Φ b := by
        rw [← map_mul, show (a * b⁻¹) * b = a from by group]
        exact hab
      have h2 : Φ (a * b⁻¹) * Φ b = 1 * Φ b := by
        rw [h1, one_mul]
      exact mul_right_cancel h2
    have hg1 : ((a * b⁻¹ : H) : PO n 1) = 1 := by
      refine eq_one_of_flatAct_fix n (by omega) hA hI hξ (hfixH _ (a * b⁻¹).2)
        (hlevH _ (a * b⁻¹).2) ?_
      intro y hy
      have h2 : Φ (a * b⁻¹) (⟨y, mem_pSub.mpr hy⟩ : ↥(pSub ξ))
          = (⟨y, mem_pSub.mpr hy⟩ : ↥(pSub ξ)) := by
        rw [hkey]; rfl
      have h3 : flatHom hA' hI' hξ H hfixH hlevH (a * b⁻¹) (⟨y, mem_pSub.mpr hy⟩ : ↥(pSub ξ))
          = (⟨y, mem_pSub.mpr hy⟩ : ↥(pSub ξ)) := by
        rw [← hΦdef]; exact h2
      rw [flatHom_apply] at h3
      exact congrArg Subtype.val h3
    have : a * b⁻¹ = 1 := Subtype.ext hg1
    exact mul_inv_eq_one.mp this
  -- proper discontinuity
  have hpd := flatHom_properlyDiscontinuous hA' hI' Γ hdisc hξ H hHΓ hfixH hlevH
  -- nilpotency and finite generation
  have hnilH : Group.IsNilpotent H := by
    rw [hHdef]
    exact nilpotent_of_nearId_pair n hA hI Γ hdisc γ δ q hq hsmall hγ hδ
  have hHfg : H.FG := by
    refine (Subgroup.fg_iff H).mpr ⟨{(γ : PO n 1), (δ : PO n 1)}, hHdef.symm, ?_⟩
    exact Set.Finite.insert _ (Set.finite_singleton _)
  haveI : Group.IsNilpotent H := hnilH
  let φ : H →* Φ.range :=
    { toFun := fun h => ⟨Φ h, MonoidHom.mem_range.mpr ⟨h, rfl⟩⟩
      map_one' := Subtype.ext (map_one Φ)
      map_mul' := fun a b => Subtype.ext (map_mul Φ a b) }
  have hφbij : Function.Bijective φ := by
    refine ⟨fun a b hab => hΦinj (Subtype.ext_iff.mp hab), fun g => ?_⟩
    obtain ⟨h, hh⟩ := MonoidHom.mem_range.mp g.2
    exact ⟨h, Subtype.ext hh⟩
  have hGnil : Group.IsNilpotent Φ.range :=
    Group.nilpotent_of_mulEquiv (MulEquiv.ofBijective φ hφbij)
  have hGfg : Φ.range.FG := by
    rw [MonoidHom.range_eq_map]
    exact fg_map_of_fg Φ (fg_top_of_fg hHfg)
  obtain ⟨A, hAfin, hAab⟩ := Work.Mostow.Margulis.nilpotent_isometry_virtually_abelian
    Φ.range (by rw [hΦdef]; exact hpd) hGnil hGfg
  haveI : A.FiniteIndex := hAfin
  set A₀ : Subgroup Φ.range := A.normalCore with hA₀def
  haveI : A₀.Normal := inferInstance
  have hA₀fin : A₀.FiniteIndex := Subgroup.finiteIndex_normalCore A
  have hA₀le : A₀ ≤ A := Subgroup.normalCore_le A
  set gγ : Φ.range := ⟨Φ ⟨(γ : PO n 1), hγH⟩,
    MonoidHom.mem_range.mpr ⟨⟨(γ : PO n 1), hγH⟩, rfl⟩⟩ with hgγdef
  set gδ : Φ.range := ⟨Φ ⟨(δ : PO n 1), hδH⟩,
    MonoidHom.mem_range.mpr ⟨⟨(δ : PO n 1), hδH⟩, rfl⟩⟩ with hgδdef
  have hgγcoe : (gγ : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) = Φ ⟨(γ : PO n 1), hγH⟩ := by
    rw [hgγdef]
  have hgδcoe : (gδ : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ)) = Φ ⟨(δ : PO n 1), hδH⟩ := by
    rw [hgδdef]
  have hpowγ : gγ ^ A₀.index ∈ A := hA₀le (Subgroup.pow_index_mem A₀ gγ)
  have hpowδ : gδ ^ A₀.index ∈ A := hA₀le (Subgroup.pow_index_mem A₀ gδ)
  have hcommG : (Φ ⟨(γ : PO n 1), hγH⟩) ^ A₀.index * (Φ ⟨(δ : PO n 1), hδH⟩) ^ A₀.index
      = (Φ ⟨(δ : PO n 1), hδH⟩) ^ A₀.index
        * (Φ ⟨(γ : PO n 1), hγH⟩) ^ A₀.index := by
    have h := hAab (gγ ^ A₀.index) hpowγ (gδ ^ A₀.index) hpowδ
    have h2 := congrArg (fun t : Φ.range => (t : ↥(pSub ξ) ≃ᵢ ↥(pSub ξ))) h
    simp only [Subgroup.coe_mul, Subgroup.coe_pow, hgγcoe, hgδcoe] at h2
    exact h2
  have hcommH : (⟨(γ : PO n 1), hγH⟩ : H) ^ A₀.index * (⟨(δ : PO n 1), hδH⟩ : H) ^ A₀.index
      = (⟨(δ : PO n 1), hδH⟩ : H) ^ A₀.index * (⟨(γ : PO n 1), hγH⟩ : H) ^ A₀.index := by
    apply hΦinj
    simpa only [map_mul, map_pow] using hcommG
  refine ⟨A₀.index, A₀.index, ?_, ?_, ?_⟩
  · exact Nat.pos_of_ne_zero (Subgroup.finiteIndex_iff.mp hA₀fin)
  · exact Nat.pos_of_ne_zero (Subgroup.finiteIndex_iff.mp hA₀fin)
  · have h4 := congrArg (fun t : H => ((t : H) : PO n 1)) hcommH
    simpa using h4

end

end Work.Mostow.Margulis
