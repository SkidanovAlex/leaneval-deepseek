import Mathlib

namespace Work.Mostow.Margulis

open Subgroup
open scoped commutatorElement

/-- If `B ≤ D ≤ A`, `⁅⊤, A⁆ ≤ B` and `B` is normal in `G`, then every subgroup `D`
sandwiched between `B` and `A` is normal in `G`. -/
private lemma normal_of_between {G : Type*} [Group G] {A B D : Subgroup G}
    (hcen : ⁅(⊤ : Subgroup G), A⁆ ≤ B) (hBD : B ≤ D) (hDA : D ≤ A) : D.Normal := by
  refine Subgroup.Normal.mk (fun n hn g => ?_)
  have h1 : ⁅g, n⁆ ∈ D :=
    hBD (hcen (commutator_mem_commutator (Subgroup.mem_top g) (hDA hn)))
  have h2 : ⁅g, n⁆ * n = g * n * g⁻¹ := by
    rw [commutatorElement_def]; group
  rw [← h2]
  exact D.mul_mem h1 hn

/-- A normal subgroup contains all commutators with the whole group. -/
private lemma commutator_top_le_of_normal {G : Type*} [Group G] {B : Subgroup G}
    (hB : B.Normal) : ⁅(⊤ : Subgroup G), B⁆ ≤ B := by
  rw [commutator_le]
  intro g _ b hb
  rw [commutatorElement_def]
  exact B.mul_mem (hB.conj_mem b hb g) (B.inv_mem hb)

/-- Auxiliary form of the main result: the chain is produced for the subgroup generated by
`B` and a finite set `T`, with the extra requirement that every member of the chain still
contains `B` (needed to feed the normal/commutator conditions back in). -/
private lemma chain_aux {G : Type*} [Group G] {A B : Subgroup G} (hBA : B ≤ A)
    (hB : B.Normal) (hcen : ⁅(⊤ : Subgroup G), A⁆ ≤ B) (T : Finset G)
    (hTle : Subgroup.closure (T : Set G) ≤ A) :
    ∃ (m : ℕ) (c : ℕ → Subgroup G) (x : ℕ → G), c 0 = B ⊔ Subgroup.closure (T : Set G) ∧
      c m = B ∧ (∀ i, (c i).Normal) ∧ (∀ i, B ≤ c i) ∧
      (∀ i, c (i + 1) ≤ c i) ∧ (∀ i, ⁅(⊤ : Subgroup G), c i⁆ ≤ c (i + 1)) ∧
      (∀ i, c i = c (i + 1) ⊔ Subgroup.zpowers (x i)) := by
  classical
  revert hTle
  refine Finset.induction_on T ?base ?step
  · intro _
    exact ⟨0, fun _ => B, fun _ => 1, by simp, by simp, fun i => hB, fun i => le_refl B,
      fun i => le_refl B, fun i => commutator_top_le_of_normal hB, fun i => by simp⟩
  · intro t s _hts ih hTle
    have hle_s : Subgroup.closure (s : Set G) ≤ A :=
      le_trans (Subgroup.closure_mono (fun y hy => Finset.mem_insert_of_mem hy)) hTle
    obtain ⟨m, c, x, hc0, hcm, hnorm, hBle, hdes, _hcom, hcyc⟩ := ih hle_s
    have hci : Subgroup.closure (↑(insert t s) : Set G) =
        Subgroup.zpowers t ⊔ Subgroup.closure (s : Set G) := by
      rw [Finset.coe_insert, Set.insert_eq, Subgroup.closure_union, zpowers_eq_closure]
    have hcle : Subgroup.closure (s : Set G) ≤ Subgroup.closure (↑(insert t s) : Set G) :=
      Subgroup.closure_mono (fun y hy => Finset.mem_insert_of_mem hy)
    have hDle : B ⊔ Subgroup.closure (↑(insert t s) : Set G) ≤ A := sup_le hBA hTle
    have hDnorm : (B ⊔ Subgroup.closure (↑(insert t s) : Set G)).Normal :=
      normal_of_between hcen le_sup_left hDle
    let c' : ℕ → Subgroup G := fun i =>
      if i = 0 then B ⊔ Subgroup.closure (↑(insert t s) : Set G) else c (i - 1)
    let x' : ℕ → G := fun i => if i = 0 then t else x (i - 1)
    have hzero : c' 0 = B ⊔ Subgroup.closure (↑(insert t s) : Set G) := by simp [c']
    have htop : c' (m + 1) = B := by simp [c', hcm]
    have hnorm' : ∀ i, (c' i).Normal := by
      intro i
      by_cases hi : i = 0
      · subst hi; simpa [c'] using hDnorm
      · have h : c' i = c (i - 1) := by simp [c', hi]
        rw [h]; exact hnorm (i - 1)
    have hBle' : ∀ i, B ≤ c' i := by
      intro i
      by_cases hi : i = 0
      · subst hi
        simp [c']
      · have h : c' i = c (i - 1) := by simp [c', hi]
        rw [h]; exact hBle (i - 1)
    have hdesc' : ∀ i, c' (i + 1) ≤ c' i := by
      intro i
      by_cases hi : i = 0
      · subst hi
        simpa [c', hc0] using (sup_le_sup_left hcle B)
      · have h1 : c' i = c (i - 1) := by simp [c', hi]
        have h2 : c' (i + 1) = c i := by simp [c']
        have hi' : i - 1 + 1 = i := Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hi)
        rw [h1, h2]
        exact hi' ▸ hdes (i - 1)
    have hle0 : ∀ i, c' i ≤ c' 0 := by
      intro i
      induction i with
      | zero => exact le_rfl
      | succ j ihj => exact le_trans (hdesc' j) ihj
    have hcom' : ∀ i, ⁅(⊤ : Subgroup G), c' i⁆ ≤ c' (i + 1) := by
      intro i
      have h1 : c' i ≤ A := le_trans (hle0 i) (by rw [hzero]; exact hDle)
      exact le_trans (le_trans (Subgroup.commutator_mono le_rfl h1) hcen) (hBle' (i + 1))
    have hcyc' : ∀ i, c' i = c' (i + 1) ⊔ Subgroup.zpowers (x' i) := by
      intro i
      by_cases hi : i = 0
      · subst hi
        have e1 : c' 0 = B ⊔ Subgroup.closure (↑(insert t s) : Set G) := by simp [c']
        have e2 : c' (0 + 1) = c 0 := by simp [c']
        have e3 : x' 0 = t := by simp [x']
        rw [e1, e2, e3, hc0, hci]
        ac_rfl
      · have h1 : c' i = c (i - 1) := by simp [c', hi]
        have h2 : c' (i + 1) = c i := by simp [c']
        have h3 : x' i = x (i - 1) := by simp [x', hi]
        have hi' : i - 1 + 1 = i := Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hi)
        simpa [h1, h2, h3, hi'] using hcyc (i - 1)
    exact ⟨m + 1, c', x', hzero, htop, hnorm', hBle', hdesc', hcom', hcyc'⟩

theorem cyclic_chain_of_generators {G : Type*} [Group G] {A B : Subgroup G} (hBA : B ≤ A)
    (hB : B.Normal) (hcen : ⁅(⊤ : Subgroup G), A⁆ ≤ B) (T : Finset G)
    (hT : A = B ⊔ Subgroup.closure (T : Set G)) :
    ∃ (m : ℕ) (c : ℕ → Subgroup G) (x : ℕ → G), c 0 = A ∧ c m = B ∧
      (∀ i, (c i).Normal) ∧ (∀ i, c (i + 1) ≤ c i) ∧
      (∀ i, ⁅(⊤ : Subgroup G), c i⁆ ≤ c (i + 1)) ∧
      (∀ i, c i = c (i + 1) ⊔ Subgroup.zpowers (x i)) := by
  have hTle : Subgroup.closure (T : Set G) ≤ A := by rw [hT]; exact le_sup_right
  obtain ⟨m, c, x, hc0, hcm, hnorm, _hBle, hdes, hcom, hcyc⟩ :=
    chain_aux hBA hB hcen T hTle
  exact ⟨m, c, x, hc0.trans hT.symm, hcm, hnorm, hdes, hcom, hcyc⟩

end Work.Mostow.Margulis
