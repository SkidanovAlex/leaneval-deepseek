import Mathlib

/-!
# Generators of the factors of the lower central series

If `G` is generated by a finite set `T`, then each factor `γ_j / γ_{j+1}` of the lower
central series of `G` is generated by finitely many elements: namely the images of the
left-normed commutators of weight `j + 1` in the elements of `T`.

The main theorem `Work.Mostow.Margulis.lcs_factor_generators` states this in the form
`γ_j = γ_{j+1} ⊔ closure S` for a finite set `S`.

The proof is a direct induction on `j`, using the two subgroup commutator identities
`⁅A ⊔ B, C⁆ = ⁅A, C⁆ ⊔ ⁅B, C⁆` (valid when `C` is normal) and the fact that
`⁅L_{j+1}, ⊤⁆ = L_{j+2}`.
-/

namespace Work.Mostow.Margulis

open scoped commutatorElement

variable {G : Type*} [Group G]

/-- `lcsGens X n` is the set of left-normed commutators of weight `n + 1` with entries in `X`:
`lcsGens X 0 = X` and `lcsGens X (n+1) = {⁅x, t⁆ | x ∈ lcsGens X n, t ∈ X}`. -/
def lcsGens (X : Set G) : ℕ → Set G
  | 0 => X
  | n + 1 => { g | ∃ x ∈ lcsGens X n, ∃ t ∈ X, ⁅x, t⁆ = g }

@[simp]
lemma mem_lcsGens_succ (X : Set G) (n : ℕ) (g : G) :
    g ∈ lcsGens X (n+1) ↔ ∃ x ∈ lcsGens X n, ∃ t ∈ X, ⁅x, t⁆ = g := Iff.rfl

/-- Every left-normed commutator of weight `n + 1` in the elements of `X` lies in the `n`-th
term of the lower central series of `G`. -/
lemma lcsGens_subset_lowerCentralSeries (X : Set G) (n : ℕ) :
    lcsGens X n ⊆ (⊤ : Subgroup G).lowerCentralSeries n := by
  induction n with
  | zero => intro x _; exact Subgroup.mem_top x
  | succ n ih =>
      intro g hg
      rw [mem_lcsGens_succ] at hg
      obtain ⟨x, hx, t, ht, rfl⟩ := hg
      have hx' := ih hx
      have hmem : ⁅x, t⁆ ∈ ⁅(⊤ : Subgroup G).lowerCentralSeries n, ⊤⁆ :=
        Subgroup.commutator_mem_commutator hx' (Subgroup.mem_top t)
      rw [Subgroup.lowerCentralSeries_succ]
      exact hmem

/-- `lcsGens X n` is finite whenever `X` is. -/
lemma lcsGens_finite (X : Set G) (hX : X.Finite) (n : ℕ) : (lcsGens X n).Finite := by
  induction n with
  | zero => simpa [lcsGens] using hX
  | succ n ih =>
      have h : (lcsGens X n ×ˢ X).Finite := ih.prod hX
      have himg := h.image (fun p : G × G => ⁅p.1, p.2⁆)
      convert himg using 1
      ext g
      simp only [mem_lcsGens_succ, Set.mem_image, Set.mem_prod, Prod.exists]
      constructor
      · rintro ⟨x, hx, t, ht, rfl⟩; exact ⟨x, t, ⟨hx, ht⟩, rfl⟩
      · rintro ⟨a, b, ⟨ha, hb⟩, rfl⟩; exact ⟨a, ha, b, hb, rfl⟩

/-- If `D` is a normal subgroup containing `⁅x, y⁆` for all `y ∈ Y`, then it contains `⁅x, y⁆`
for all `y` in the subgroup generated by `Y`. -/
lemma commutator_closure_right (D : Subgroup G) (hD : D.Normal) (x : G) {Y : Set G}
    (h : ∀ y ∈ Y, ⁅x, y⁆ ∈ D) : ∀ y ∈ Subgroup.closure Y, ⁅x, y⁆ ∈ D := by
  let Z : Subgroup G :=
    { carrier := {y | ⁅x, y⁆ ∈ D}
      one_mem' := by
        show ⁅x, (1 : G)⁆ ∈ D
        simp
      mul_mem' := by
        intro a b ha hb
        show ⁅x, a * b⁆ ∈ D
        rw [commutatorElement_mul_right_eq_mul_conj]
        have h1 : a * ⁅x, b⁆ * a⁻¹ ∈ D := hD.conj_mem ⁅x, b⁆ hb a
        simpa only [mul_assoc] using D.mul_mem ha h1
      inv_mem' := by
        intro a ha
        show ⁅x, a⁻¹⁆ ∈ D
        rw [commutatorElement_inv_right, ← commutatorElement_inv]
        have h1 : a⁻¹ * ⁅x, a⁆⁻¹ * a ∈ D := by
          simpa using hD.conj_mem ⁅x, a⁆⁻¹ (D.inv_mem ha) a⁻¹
        exact h1 }
  have hYZ : Y ⊆ Z := fun y hy => h y hy
  intro y hy
  exact (Subgroup.closure_le Z).mpr hYZ hy

/-- Extension of the previous lemma to both variables. -/
lemma commutator_closure_closure_le (D : Subgroup G) (hD : D.Normal) (X Y : Set G)
    (h : ∀ x ∈ X, ∀ y ∈ Y, ⁅x, y⁆ ∈ D) :
    ∀ x ∈ Subgroup.closure X, ∀ y ∈ Subgroup.closure Y, ⁅x, y⁆ ∈ D := by
  have hX' : ∀ x ∈ X, ∀ y ∈ Subgroup.closure Y, ⁅x, y⁆ ∈ D :=
    fun x hx => commutator_closure_right D hD x (fun y hy => h x hx y hy)
  let K : Subgroup G :=
    { carrier := {x | ∀ y ∈ Subgroup.closure Y, ⁅x, y⁆ ∈ D}
      one_mem' := by
        intro y hy
        show ⁅(1 : G), y⁆ ∈ D
        simp
      mul_mem' := by
        intro a b ha hb y hy
        show ⁅a * b, y⁆ ∈ D
        rw [commutatorElement_mul_left_eq_conj_mul]
        have h1 : a * ⁅b, y⁆ * a⁻¹ ∈ D := hD.conj_mem ⁅b, y⁆ (hb y hy) a
        exact D.mul_mem h1 (ha y hy)
      inv_mem' := by
        intro a ha y hy
        show ⁅a⁻¹, y⁆ ∈ D
        rw [commutatorElement_inv_left, ← commutatorElement_inv]
        have h1 : a⁻¹ * ⁅a, y⁆⁻¹ * a ∈ D := by
          simpa using hD.conj_mem ⁅a, y⁆⁻¹ (D.inv_mem (ha y hy)) a⁻¹
        exact h1 }
  have hXK : X ⊆ K := fun x hx => hX' x hx
  intro x hx y hy
  exact (Subgroup.closure_le K).mpr hXK hx y hy

/-- The key step of the induction: the commutator of the subgroup generated by the weight `j + 1`
left-normed commutators with all of `G` is contained in `γ_{j+2}` together with the subgroup
generated by the weight `j + 2` left-normed commutators. -/
lemma commutator_lcsGens_le (X : Set G) (hX : Subgroup.closure X = ⊤) (j : ℕ) :
    ⁅Subgroup.closure (lcsGens X j), ⊤⁆ ≤
      (⊤ : Subgroup G).lowerCentralSeries (j+2) ⊔ Subgroup.closure (lcsGens X (j+1)) := by
  set D : Subgroup G :=
    (⊤ : Subgroup G).lowerCentralSeries (j+2) ⊔ Subgroup.closure (lcsGens X (j+1)) with hD
  have hDle : D ≤ (⊤ : Subgroup G).lowerCentralSeries (j+1) := by
    rw [hD]
    refine sup_le ?_ ?_
    · exact Subgroup.lowerCentralSeries_antitone ⊤ (by omega)
    · exact (Subgroup.closure_le _).mpr (fun x hx => lcsGens_subset_lowerCentralSeries X (j+1) hx)
  have hDnorm : D.Normal := by
    rw [← Subgroup.commutator_top_right_le_iff]
    calc ⁅D, ⊤⁆ ≤ ⁅(⊤ : Subgroup G).lowerCentralSeries (j+1), ⊤⁆ :=
          Subgroup.commutator_mono_left hDle
      _ = (⊤ : Subgroup G).lowerCentralSeries (j+2) :=
          (Subgroup.lowerCentralSeries_succ ⊤ (j+1)).symm
      _ ≤ D := by rw [hD]; exact le_sup_left
  have hXY : ∀ x ∈ lcsGens X j, ∀ y ∈ X, ⁅x, y⁆ ∈ D := by
    intro x hx y hy
    have hmem : ⁅x, y⁆ ∈ Subgroup.closure (lcsGens X (j+1)) :=
      Subgroup.subset_closure ⟨x, hx, y, hy, rfl⟩
    rw [hD]
    exact (le_sup_right : Subgroup.closure (lcsGens X (j+1)) ≤
      (⊤ : Subgroup G).lowerCentralSeries (j+2) ⊔ Subgroup.closure (lcsGens X (j+1))) hmem
  have hkey := commutator_closure_closure_le D hDnorm (lcsGens X j) X hXY
  exact Subgroup.commutator_le.mpr (fun x hx y hy =>
    hkey x hx y (hX.symm ▸ hy))

/-- Main inductive statement: `γ_j` is contained in `γ_{j+1}` together with the subgroup
generated by the weight `j + 1` left-normed commutators in the generators. -/
lemma lowerCentralSeries_le_succ_sup_lcsGens (X : Set G) (hX : Subgroup.closure X = ⊤) (j : ℕ) :
    (⊤ : Subgroup G).lowerCentralSeries j ≤
      (⊤ : Subgroup G).lowerCentralSeries (j+1) ⊔ Subgroup.closure (lcsGens X j) := by
  induction j with
  | zero =>
      rw [Subgroup.lowerCentralSeries_zero, show lcsGens X 0 = X from rfl, hX]
      exact le_sup_right
  | succ j ih =>
      calc (⊤ : Subgroup G).lowerCentralSeries (j+1)
          = ⁅(⊤ : Subgroup G).lowerCentralSeries j, ⊤⁆ := Subgroup.lowerCentralSeries_succ ⊤ j
        _ ≤ ⁅(⊤ : Subgroup G).lowerCentralSeries (j+1) ⊔ Subgroup.closure (lcsGens X j), ⊤⁆ :=
              Subgroup.commutator_mono_left ih
        _ = ⁅(⊤ : Subgroup G).lowerCentralSeries (j+1), ⊤⁆ ⊔
              ⁅Subgroup.closure (lcsGens X j), ⊤⁆ :=
              Subgroup.commutator_sup_right _ _ _
        _ = (⊤ : Subgroup G).lowerCentralSeries (j+2) ⊔ ⁅Subgroup.closure (lcsGens X j), ⊤⁆ := rfl
        _ ≤ (⊤ : Subgroup G).lowerCentralSeries (j+2) ⊔ Subgroup.closure (lcsGens X (j+1)) :=
              sup_le le_sup_left (commutator_lcsGens_le X hX j)

/-- **Each factor of the lower central series of a finitely generated group is finitely
generated**: for every `j` there is a finite set `S` with `γ_j = γ_{j+1} ⊔ closure S`. -/
theorem lcs_factor_generators {G : Type*} [Group G] (T : Finset G)
    (hT : Subgroup.closure (T : Set G) = ⊤) :
    ∀ j, ∃ S : Finset G, (⊤ : Subgroup G).lowerCentralSeries j =
      (⊤ : Subgroup G).lowerCentralSeries (j + 1) ⊔ Subgroup.closure ((S : Finset G) : Set G) := by
  intro j
  rcases j with _ | k
  · refine ⟨T, ?_⟩
    rw [Subgroup.lowerCentralSeries_zero, hT, sup_top_eq]
  · refine ⟨(lcsGens_finite ((T : Finset G) : Set G) (Finset.finite_toSet T) (k+1)).toFinset, ?_⟩
    have hcoe : ((((lcsGens_finite ((T : Finset G) : Set G) (Finset.finite_toSet T) (k+1)).toFinset :
        Finset G)) : Set G) = lcsGens ((T : Finset G) : Set G) (k+1) := Set.Finite.coe_toFinset _
    rw [hcoe]
    refine le_antisymm (lowerCentralSeries_le_succ_sup_lcsGens _ hT (k+1)) ?_
    refine sup_le ?_ ?_
    · exact Subgroup.lowerCentralSeries_antitone ⊤ (by omega)
    · exact (Subgroup.closure_le _).mpr (fun x hx => lcsGens_subset_lowerCentralSeries _ (k+1) hx)

end Work.Mostow.Margulis
