import Mathlib
import Submission.Work.Mostow.Margulis.lcs_factor_generators
import Submission.Work.Mostow.Margulis.cyclic_chain_of_generators
import Submission.Work.Mostow.Margulis.cyclic_extension_step

namespace Work.Mostow.Margulis

open scoped commutatorElement

/-!
# The main auxiliary result

Everything below serves the proof of `fg_nilpotent_finiteIndex_torsionFree`; the two ingredients
that are proved elsewhere are `lcs_factor_generators` (each lower-central factor of a finitely
generated group is finitely generated) and `cyclic_chain_of_generators` (a finitely generated
"central" factor can be refined into a chain with cyclic factors), together with the single
extension step `cyclic_extension_step`.
-/

variable {G : Type*} [Group G]

/-- A `G`-central cyclic series for the subgroup `H ≤ G`: a descending sequence
`H = Gs 0 ≥ Gs 1 ≥ ⋯ ≥ Gs m = ⊥` of subgroups normal in `G`, such that each factor
`Gs i / Gs (i+1)` is central in `G / Gs (i+1)` and is cyclic, generated by the image of `x i`. -/
structure CentralCyclicSeries (G : Type*) [Group G] (H : Subgroup G) where
  m : ℕ
  Gs : ℕ → Subgroup G
  x : ℕ → G
  zero : Gs 0 = H
  bot : Gs m = ⊥
  normal : ∀ i, (Gs i).Normal
  antitone : ∀ i, Gs (i + 1) ≤ Gs i
  central : ∀ i, ⁅(⊤ : Subgroup G), Gs i⁆ ≤ Gs (i + 1)
  cyclic : ∀ i, Gs i = Gs (i + 1) ⊔ Subgroup.zpowers (x i)

/-- Concatenating a finite chain `c` (going down from `A` to `B`) with a tail series `s`
(going down from `B` to `⊥`). -/
def concatGs (mc : ℕ) (c s : ℕ → Subgroup G) : ℕ → Subgroup G :=
  fun i => if i < mc then c i else s (i - mc)

/-- The matching choice of generators for `concatGs`. -/
def concatX (mc : ℕ) (xc xs : ℕ → G) : ℕ → G :=
  fun i => if i < mc then xc i else xs (i - mc)

/-- **Existence of a central cyclic series** for the `j`-th term of the lower central series of a
finitely generated group `G`, provided `γ_{j+n} = ⊥`.  The proof is an induction on `n`: the top
layer `γ_j ≥ γ_{j+1}` is refined into cyclic factors (using `lcs_factor_generators` and
`cyclic_chain_of_generators`) and concatenated with the series obtained for `γ_{j+1}` from the
induction hypothesis. -/
theorem exists_centralCyclicSeries [Group.FG G] (n j : ℕ)
    (hj : (⊤ : Subgroup G).lowerCentralSeries (j + n) = ⊥) :
    Nonempty (CentralCyclicSeries G ((⊤ : Subgroup G).lowerCentralSeries j)) := by
  obtain ⟨S0, hS0, hS0fin⟩ := Group.fg_iff.mp (show Group.FG G from inferInstance)
  have hT : Subgroup.closure (↑hS0fin.toFinset : Set G) = ⊤ := by
    rw [hS0fin.coe_toFinset]; exact hS0
  revert j
  induction n with
  | zero =>
      intro j hj
      refine ⟨{ m := 0, Gs := fun _ => ⊥, x := fun _ => 1, zero := ?_, bot := rfl,
                normal := fun i => Subgroup.normal_bot, antitone := fun i => le_refl _,
                central := fun i => ?_, cyclic := fun i => ?_ }⟩
      · simpa using hj.symm
      · simp [Subgroup.commutator_def]
      · simp [Subgroup.zpowers_one_eq_bot]
  | succ n ih =>
      intro j hj
      obtain ⟨S, hS⟩ := lcs_factor_generators (G := G) hS0fin.toFinset hT j
      have hcen : ⁅(⊤ : Subgroup G), (⊤ : Subgroup G).lowerCentralSeries j⁆ ≤
          (⊤ : Subgroup G).lowerCentralSeries (j + 1) := by
        rw [Subgroup.commutator_comm]
        exact le_of_eq (Subgroup.lowerCentralSeries_succ (⊤ : Subgroup G) j)
      obtain ⟨mc, c, xc, hc0, hcm, hcn, hca, hcce, hccy⟩ :=
        cyclic_chain_of_generators (G := G) (A := (⊤ : Subgroup G).lowerCentralSeries j)
          (B := (⊤ : Subgroup G).lowerCentralSeries (j + 1))
          (Subgroup.lowerCentralSeries_antitone ⊤ (Nat.le_succ j)) inferInstance hcen S hS
      have hstep : (⊤ : Subgroup G).lowerCentralSeries (j + 1 + n) = ⊥ := by
        rw [Nat.add_right_comm]; exact hj
      obtain ⟨s⟩ := ih (j + 1) hstep
      refine ⟨{ m := mc + s.m, Gs := concatGs mc c s.Gs, x := concatX mc xc s.x,
                zero := ?_, bot := ?_, normal := ?_, antitone := ?_, central := ?_,
                cyclic := ?_ }⟩
      · simp only [concatGs]
        by_cases h : 0 < mc
        · rw [if_pos h, hc0]
        · rw [if_neg h]
          have h0 : mc = 0 := by omega
          rw [h0] at hcm ⊢
          simp only [Nat.sub_zero]
          rw [s.zero, ← hcm, hc0]
      · simp only [concatGs]
        rw [if_neg (by omega), Nat.add_sub_cancel_left]
        exact s.bot
      · intro i
        simp only [concatGs]
        by_cases h : i < mc
        · rw [if_pos h]; exact hcn i
        · rw [if_neg h]; exact s.normal _
      · intro i
        by_cases h1 : i + 1 < mc
        · have hi : i < mc := by omega
          simp only [concatGs, if_pos h1, if_pos hi]
          exact hca i
        · by_cases h2 : i < mc
          · have h3 : i + 1 = mc := by omega
            have hse : s.Gs 0 ≤ c i := by
              have h := hca i
              rw [h3] at h; rw [hcm] at h; rw [← s.zero] at h
              exact h
            simp only [concatGs, if_pos h2, h3, Nat.sub_self, Nat.lt_irrefl]
            exact hse
          · have hmi : mc ≤ i := Nat.le_of_not_lt h2
            have h4 : i + 1 - mc = i - mc + 1 := Nat.sub_add_comm hmi
            simp only [concatGs, if_neg h1, if_neg h2, h4]
            exact s.antitone (i - mc)
      · intro i
        by_cases h1 : i + 1 < mc
        · have hi : i < mc := by omega
          simp only [concatGs, if_pos h1, if_pos hi]
          exact hcce i
        · by_cases h2 : i < mc
          · have h3 : i + 1 = mc := by omega
            have hse : ⁅(⊤ : Subgroup G), c i⁆ ≤ s.Gs 0 := by
              have h := hcce i
              rw [h3] at h; rw [hcm] at h; rw [← s.zero] at h
              exact h
            simp only [concatGs, if_pos h2, h3, Nat.sub_self, Nat.lt_irrefl]
            exact hse
          · have hmi : mc ≤ i := Nat.le_of_not_lt h2
            have h4 : i + 1 - mc = i - mc + 1 := Nat.sub_add_comm hmi
            simp only [concatGs, if_neg h1, if_neg h2, h4]
            exact s.central (i - mc)
      · intro i
        by_cases h1 : i + 1 < mc
        · have hi : i < mc := by omega
          simp only [concatGs, concatX, if_pos h1, if_pos hi]
          exact hccy i
        · by_cases h2 : i < mc
          · have h3 : i + 1 = mc := by omega
            have hse : c i = s.Gs 0 ⊔ Subgroup.zpowers (xc i) := by
              have h := hccy i
              rw [h3] at h; rw [hcm] at h; rw [← s.zero] at h
              exact h
            simp only [concatGs, concatX, if_pos h2, h3, Nat.sub_self, Nat.lt_irrefl]
            exact hse
          · have hmi : mc ≤ i := Nat.le_of_not_lt h2
            have h4 : i + 1 - mc = i - mc + 1 := Nat.sub_add_comm hmi
            simp only [concatGs, concatX, if_neg h1, if_neg h2, h4]
            exact s.cyclic (i - mc)

/-- **Downward induction over a central cyclic series.**  Given such a series for `⊤` in `G`, one
produces a subgroup of `G` which is normal, torsion-free and of finite index: starting from `⊥` at
the bottom and applying `cyclic_extension_step` at every stage. -/
theorem centralCyclicSeries_torsionFree (s : CentralCyclicSeries G ⊤) :
    ∃ K : Subgroup G, K.Normal ∧ (∀ y ∈ K, IsOfFinOrder y → y = 1) ∧ K.FiniteIndex := by
  suffices h : ∀ i, i ≤ s.m → ∃ K : Subgroup G,
      K.Normal ∧ K ≤ s.Gs (s.m - i) ∧ (∀ y ∈ K, IsOfFinOrder y → y = 1) ∧
      (K.subgroupOf (s.Gs (s.m - i))).FiniteIndex by
    obtain ⟨K, hKn, -, hKtf, hKid⟩ := h s.m le_rfl
    rw [Nat.sub_self, s.zero] at hKid
    refine ⟨K, hKn, hKtf, ?_⟩
    have hrel : K.relIndex ⊤ ≠ 0 := (Subgroup.finiteIndex_iff.mp hKid)
    have hidx : K.index = K.relIndex ⊤ := by
      have h := Subgroup.relIndex_mul_index (H := K) (K := ⊤) le_top
      rw [Subgroup.index_eq_one.mpr rfl, mul_one] at h
      exact h.symm
    rw [Subgroup.finiteIndex_iff, hidx]
    exact hrel
  intro i
  induction i with
  | zero =>
      intro _
      refine ⟨⊥, Subgroup.normal_bot, bot_le, (fun y hy _ => by simp at hy; exact hy), ?_⟩
      rw [Nat.sub_zero, s.bot, Subgroup.subgroupOf_self]
      exact Subgroup.finiteIndex_iff.mpr (by simp)
  | succ i ih =>
      intro hi
      have hi' : i ≤ s.m := by omega
      obtain ⟨K, hKn, hKle, hKtf, hKid⟩ := ih hi'
      have hlt : s.m - (i + 1) + 1 = s.m - i := by omega
      have hNle : s.Gs (s.m - i) ≤ s.Gs (s.m - (i + 1)) := by
        have h := s.antitone (s.m - (i + 1))
        rwa [hlt] at h
      have hgen : s.Gs (s.m - (i + 1)) =
          s.Gs (s.m - i) ⊔ Subgroup.zpowers (s.x (s.m - (i + 1))) := by
        have h := s.cyclic (s.m - (i + 1))
        rwa [hlt] at h
      have hc : ⁅(⊤ : Subgroup G), s.Gs (s.m - (i + 1))⁆ ≤ s.Gs (s.m - i) := by
        have h := s.central (s.m - (i + 1))
        rwa [hlt] at h
      exact cyclic_extension_step (s.Gs (s.m - (i + 1))) (s.Gs (s.m - i)) K
        (s.x (s.m - (i + 1))) (s.normal _) (s.normal _) hKn hKle hNle hc hgen hKtf hKid

/-- Every finitely generated nilpotent group has a finite-index torsion-free subgroup.  Here
"torsion-free" is `∀ x ∈ H, IsOfFinOrder x → x = 1`.

Proof plan (polycyclic induction).  A finitely generated nilpotent group `G` has a finite subnormal
series `G = G 0 ≥ G 1 ≥ ... ≥ G n = ⊥` whose factors `G i / G (i+1)` are cyclic: take the lower
central series `(⊤ : Subgroup G).lowerCentralSeries` (it reaches `⊥` by nilpotency, see
`Subgroup.isNilpotent_iff_lowerCentralSeries`) and refine each factor, which is a finitely
generated abelian group, into cyclic factors using a finite generating set (each `γ i` is finitely
generated because it is the normal closure of finitely many simple commutators of a finite
generating set of `G`, and the normal closure of a finite set in a finitely generated group is
finitely generated).

Then prove by *downward* induction on `i` that `G i` has a finite-index torsion-free normal
subgroup `K i`:
* `K n = ⊥`.
* step: let `L` be the core of `K (i+1)` in `G i`.  `L` is normal in `G i`, torsion-free, and of
  finite index: the kernel of the conjugation action `G i → Aut(G (i+1)/K (i+1))` lies in the
  normaliser of `K (i+1)` (if `g` acts trivially then `g x g⁻¹ x⁻¹ ∈ K (i+1)` for all
  `x ∈ G (i+1)`, in particular `g K (i+1) g⁻¹ ≤ K (i+1)`), so the orbit of `K (i+1)` under `G i`
  is finite and the core is a finite intersection of finite-index subgroups.
  - If `G i / G (i+1)` is finite then `K i := L`.
  - If `G i / G (i+1)` is infinite cyclic, pick `g ∈ G i` generating the quotient mod `G (i+1)`.
    Then `g` has infinite order, and `M := π⁻¹⟨g L⟩` (where `π : G i → G i / L`) has finite index
    in `G i` because `[G i / L : ⟨g L⟩] ≤ |G (i+1)/L|` is finite; `M` is torsion-free since a
    torsion element of `M` maps into the torsion-free group `⟨g L⟩ ≅ ℤ`, hence lies in `L`, hence
    is trivial.  Take `K i := core_{G i} M`. -/
theorem fg_nilpotent_finiteIndex_torsionFree {G : Type*} [Group G] [Group.IsNilpotent G]
    [Group.FG G] :
    ∃ H : Subgroup G, H.FiniteIndex ∧ ∀ x ∈ H, IsOfFinOrder x → x = 1 := by
  obtain ⟨n, hn⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp ‹Group.IsNilpotent G›
  obtain ⟨s⟩ := exists_centralCyclicSeries (G := G) n 0 (by simpa using hn)
  obtain ⟨K, _, hKtf, hKid⟩ := centralCyclicSeries_torsionFree s
  exact ⟨K, hKid, hKtf⟩

end Work.Mostow.Margulis
