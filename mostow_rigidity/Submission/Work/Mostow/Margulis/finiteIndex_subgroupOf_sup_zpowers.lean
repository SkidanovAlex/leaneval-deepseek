import Mathlib

set_option linter.style.haveILetI false

namespace Work.Mostow.Margulis

/-- If `H ≤ K` are subgroups of a group `G`, `H` is normal in `G`, `K = H ⊔ ⟨x⟩` and some
positive power `x ^ d` (`d > 0`) of `x` lies in `H`, then `H` has finite index in `K`.

Proof: the quotient `K ⧸ H.subgroupOf K` is generated by the image of `x`, and `(xH)^d = x^d H = H`,
so that image has order dividing `d`; hence the quotient is finite. -/
theorem finiteIndex_subgroupOf_sup_zpowers {G : Type*} [Group G] {H K : Subgroup G} (hHK : H ≤ K)
    (hHn : H.Normal) {x : G} (hxK : x ∈ K) (hgen : K = H ⊔ Subgroup.zpowers x)
    {d : ℕ} (hd : 0 < d) (hxd : x ^ d ∈ H) : (H.subgroupOf K).FiniteIndex := by
  haveI := hHn
  -- Work in the quotient `G ⧸ H`, where `H` becomes trivial.
  let φ : G →* G ⧸ H := QuotientGroup.mk' H
  have hker : φ.ker = H := QuotientGroup.ker_mk' H
  -- The image of `x` has finite order (dividing `d`).
  have hpow : φ x ^ d = 1 := by
    rw [← map_pow φ x d]
    exact MonoidHom.mem_ker.mp (by rw [hker]; exact hxd)
  have hord : IsOfFinOrder (φ x) := isOfFinOrder_iff_pow_eq_one.mpr ⟨d, hd, hpow⟩
  have hfin : Finite (Subgroup.zpowers (φ x)) := finite_zpowers.mpr hord
  -- The image of `K` is the finite cyclic subgroup generated by `φ x`.
  have hmapH : Subgroup.map φ H = ⊥ := (Subgroup.map_eq_bot_iff H).mpr (by rw [hker])
  have hmapK : Subgroup.map φ K = Subgroup.zpowers (φ x) := by
    rw [hgen, Subgroup.map_sup, MonoidHom.map_zpowers, hmapH, bot_sup_eq]
  -- Restrict `φ` to `K`: its kernel is `H.subgroupOf K` and its range is finite.
  have hrange : (φ.comp K.subtype).range = Subgroup.zpowers (φ x) := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype, hmapK]
  haveI : Finite ((φ.comp K.subtype).range) := by
    rw [hrange]; exact hfin
  have hkerK : (φ.comp K.subtype).ker = H.subgroupOf K := by
    ext k
    simp only [MonoidHom.mem_ker, MonoidHom.comp_apply, Subgroup.mem_subgroupOf]
    rw [← MonoidHom.mem_ker, hker]
    exact Iff.rfl
  rw [← hkerK]
  exact Subgroup.finiteIndex_ker (φ.comp K.subtype)

end Work.Mostow.Margulis
