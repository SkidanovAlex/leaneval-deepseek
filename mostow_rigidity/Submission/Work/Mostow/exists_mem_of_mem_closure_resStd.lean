import Mathlib
import Submission.Work.Mostow.resStd_hom_discrete
import Submission.Work.Mostow.geodSetup

namespace Work.Mostow

/-- Every element of the group generated by the restriction image `resStd k m '' C` lifts back to
`C`: `resStd` is multiplicative on the setwise stabiliser `SetStabStd k m` (and maps `1` to `1`,
inverses to inverses), so `resStd k m '' C` is already a subgroup and the closure is the image.
This is the "lift `g₀ ∈ G` to `n₀ ∈ N`" step of the geodesic-stratum screw argument. -/
theorem exists_mem_of_mem_closure_resStd (k m : ℕ)
    (hAk : Submission.Mostow.POActionProp k) (hIk : Submission.Mostow.HypIsometryProp k)
    (hA : Submission.Mostow.POActionProp (k + m)) (hI : Submission.Mostow.HypIsometryProp (k + m))
    (C : Subgroup (LeanEval.Geometry.MostowRigidity.PO (k + m) 1))
    (hC : ∀ c ∈ C, c ∈ Submission.Mostow.SetStabStd k m) (g : LeanEval.Geometry.MostowRigidity.PO k 1)
    (hg : g ∈ Subgroup.closure (Submission.Mostow.resStd k m '' (C : Set (LeanEval.Geometry.MostowRigidity.PO (k + m) 1)))) :
    ∃ c ∈ C, Submission.Mostow.resStd k m c = g := by
  -- the restriction image of `C` is already a subgroup: `resStd` is multiplicative on the
  -- setwise stabiliser, sends `1` to `1` and inverses to inverses
  have hmem : ∀ x ∈ Subgroup.closure
      (Submission.Mostow.resStd k m '' (C : Set (LeanEval.Geometry.MostowRigidity.PO (k + m) 1))),
      ∃ c ∈ C, Submission.Mostow.resStd k m c = x := by
    intro x hx
    exact Subgroup.closure_induction
      (p := fun x _ => ∃ c ∈ C, Submission.Mostow.resStd k m c = x)
      (fun y hy => by
        obtain ⟨c, hc, hcy⟩ := hy
        exact ⟨c, hc, hcy⟩)
      ⟨1, C.one_mem, rhd_resStd_one k m hAk hIk hA hI⟩
      (fun y z _ _ ihy ihz => by
        obtain ⟨c₁, hc₁, he₁⟩ := ihy
        obtain ⟨c₂, hc₂, he₂⟩ := ihz
        exact ⟨c₁ * c₂, C.mul_mem hc₁ hc₂,
          by rw [rhd_resStd_mul k m hAk hIk hA hI (hC _ hc₁) (hC _ hc₂), he₁, he₂]⟩)
      (fun y _ ihy => by
        obtain ⟨c, hc, he⟩ := ihy
        exact ⟨c⁻¹, C.inv_mem hc,
          by rw [rhd_resStd_inv k m hAk hIk hA hI (hC _ hc), he]⟩)
      hx
  exact hmem g hg

/-- Consequence: the closure of the restriction image of `C` is that image itself, i.e.
`resStd k m '' C` is a subgroup of `PO k 1` whenever `C ≤ SetStabStd k m`. -/
theorem closure_resStd_image_eq (k m : ℕ)
    (hAk : Submission.Mostow.POActionProp k) (hIk : Submission.Mostow.HypIsometryProp k)
    (hA : Submission.Mostow.POActionProp (k + m)) (hI : Submission.Mostow.HypIsometryProp (k + m))
    (C : Subgroup (LeanEval.Geometry.MostowRigidity.PO (k + m) 1))
    (hC : ∀ c ∈ C, c ∈ Submission.Mostow.SetStabStd k m) :
    (Subgroup.closure (Submission.Mostow.resStd k m ''
        (C : Set (LeanEval.Geometry.MostowRigidity.PO (k + m) 1))) : Set (LeanEval.Geometry.MostowRigidity.PO k 1))
      = Submission.Mostow.resStd k m '' (C : Set (LeanEval.Geometry.MostowRigidity.PO (k + m) 1)) := by
  refine Set.Subset.antisymm (fun g hg => ?_) Subgroup.subset_closure
  obtain ⟨c, hc, hcg⟩ :=
    exists_mem_of_mem_closure_resStd k m hAk hIk hA hI C hC g hg
  exact ⟨c, hc, hcg⟩

end Work.Mostow
