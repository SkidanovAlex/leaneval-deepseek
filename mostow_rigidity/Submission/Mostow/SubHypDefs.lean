import Submission.Mostow.HLDefs

/-!
# Lead-written vocabulary: totally geodesic sub-hyperbolic spaces (definitions only; DO NOT EDIT)
Standard stratum: E k ↪ E (k+m) as the first k chart coordinates (the hyperboloid points with vanishing last m
spatial coordinates). Fermi coordinates `fermi k m v w` (foot v ∈ E k, normal vector w ∈ E m, ‖w‖ = distance).
General strata are reduced to the standard one by conjugation (elliptic normal form).
-/

open LeanEval.Geometry.MostowRigidity MeasureTheory

namespace Submission.Mostow

noncomputable section

/-- the standard embedding of `E k` as the first `k` coordinates of `E (k+m)` -/
def coordEmb (k m : ℕ) (v : E k) : E (k + m) :=
  WithLp.toLp 2 (Fin.append (fun i => v i) (fun _ : Fin m => (0 : ℝ)))

/-- tangential (first `k`) chart coordinates -/
def tanC (k m : ℕ) (u : E (k + m)) : E k := WithLp.toLp 2 (fun i => u (Fin.castAdd m i))

/-- normal (last `m`) chart coordinates -/
def nrmC (k m : ℕ) (u : E (k + m)) : E m := WithLp.toLp 2 (fun i => u (Fin.natAdd k i))

/-- the standard totally geodesic `k`-dimensional subspace -/
def stdTG (k m : ℕ) : Set (E (k + m)) := Set.range (coordEmb k m)

/-- `sinh s / s` (value `1` at `0`) -/
def sinhc (s : ℝ) : ℝ := if s = 0 then 1 else Real.sinh s / s

/-- Fermi coordinates about `stdTG k m` -/
def fermi (k m : ℕ) (v : E k) (w : E m) : E (k + m) :=
  WithLp.toLp 2 (Fin.append (fun i => Real.cosh ‖w‖ * v i) (fun i => sinhc ‖w‖ * w i))

/-- inverse of `fermi` (explicit) -/
def fermiInv (k m : ℕ) (u : E (k + m)) : E k × E m :=
  let s := Real.arsinh ‖nrmC k m u‖
  ((Real.cosh s)⁻¹ • tanC k m u, (if nrmC k m u = 0 then 0 else (s / ‖nrmC k m u‖) • nrmC k m u))

/-- tube of radius `ρ` about the standard stratum -/
def tube (k m : ℕ) (ρ : ℝ) : Set (E (k + m)) := {u | ‖nrmC k m u‖ ≤ Real.sinh ρ}

/-- normal-fibre measure of the tube: density `cosh^k s · sinhc(s)^(m−1)` -/
def tubeMeasure (k m : ℕ) : Measure (E m) :=
  (volume : Measure (E m)).withDensity
    (fun w => ENNReal.ofReal (Real.cosh ‖w‖ ^ k * sinhc ‖w‖ ^ (m - 1)))

/-- fixed set of an isometry -/
def fixSet {n : ℕ} (g : PO n 1) : Set (E n) := {u | g • u = u}

/-- setwise stabiliser of the standard stratum -/
def SetStabStd (k m : ℕ) : Set (PO (k + m) 1) := {g | ∀ u, u ∈ stdTG k m ↔ g • u ∈ stdTG k m}

/-- the subgroup generated by the elements of `Λ` that are `η`-near the identity at `z` -/
def nearGrp {n : ℕ} (Λ : Subgroup (PO n 1)) (z : E n) (η : ℝ) : Subgroup (PO n 1) :=
  Subgroup.closure {g | g ∈ Λ ∧ NearIdAt g z η}

/-- the block isometry: `h` on the stratum, `R` on the normal fibre (Fermi coordinates) -/
def blkMap (k m : ℕ) (h : PO k 1) (R : E m ≃ₗᵢ[ℝ] E m) (u : E (k + m)) : E (k + m) :=
  fermi k m (h • (fermiInv k m u).1) (R (fermiInv k m u).2)

open Classical in
/-- the element of `PO (k+m) 1` realising `blkMap` (junk `1` if none — it always exists: a theorem) -/
def blk (k m : ℕ) (h : PO k 1) (R : E m ≃ₗᵢ[ℝ] E m) : PO (k + m) 1 :=
  if hg : ∃ g : PO (k + m) 1, ∀ u, g • u = blkMap k m h R u then hg.choose else 1

open Classical in
/-- restriction to the stratum (junk `1` off the setwise stabiliser) -/
def resStd (k m : ℕ) (g : PO (k + m) 1) : PO k 1 :=
  if hg : ∃ p : PO k 1 × (E m ≃ₗᵢ[ℝ] E m), g = blk k m p.1 p.2 then hg.choose.1 else 1

open Classical in
/-- normal part (junk identity off the setwise stabiliser) -/
def nrmStd (k m : ℕ) (g : PO (k + m) 1) : E m ≃ₗᵢ[ℝ] E m :=
  if hg : ∃ p : PO k 1 × (E m ≃ₗᵢ[ℝ] E m), g = blk k m p.1 p.2 then hg.choose.2
  else LinearIsometryEquiv.refl ℝ (E m)

/-- uniform lower bound on the covolume of discrete subgroups of `PO k 1` (Kazhdan–Margulis–Wang for PO(k,1)) -/
def CovolLB (k : ℕ) : Prop :=
  ∃ v : ℝ, 0 < v ∧ ∀ Λ : Subgroup (PO k 1), IsDiscrete (SetLike.coe Λ) →
    ∀ D : Set (E k), IsFundamentalDomain Λ D (volH k) → ENNReal.ofReal v ≤ volH k D

end

end Submission.Mostow
