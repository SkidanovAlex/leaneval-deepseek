/-!
# The decomposition group of a place is the absolute Galois group of the completion

Let `K` be a number field, `p` a finite place of `K`, `K'` a separable closure of `K` and `A` a
place of `K'` above `p`.  This file proves that the decomposition group of `A`,

`D_A = {σ ∈ Gal(K'/K) | σ(A) = A}`,

is isomorphic to the absolute Galois group of the `p`-adic completion of `K`:

`D_A ≅ Gal(SeparableClosure (adicCompletion K p) / adicCompletion K p)`.

The proof follows the classical route (Neukirch–Schmidt–Wingberg, Chapter XII):

1. `C = placeCompletion A` is the completion of `K'` at `A`; it is a separably closed complete
   valued field.
2. `K'` embeds in `C` with dense image, and the elements of `C` algebraic over `K` are *exactly*
   the image of `K'` (`isAlgebraic_iff_exists_placeCompletionCoe`).
3. The `p`-adic completion `Kp` of `K` embeds in `C` by a continuous ring homomorphism `Φ`, and
   the two integer rings match (`comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers`).
4. The field `M = Kp·K'` generated by `Kp` and the image of `K'` inside `C` is the algebraic
   closure of `Kp` in `C` (Krasner's lemma,
   `exists_mem_subfieldClosure_of_eval_eq_zero`), hence `M` is a separable closure of `Kp`.
5. Every `σ ∈ D_A` preserves the valuation of `A`, hence extends continuously to an automorphism
   `σ̂` of `C` fixing `Φ(Kp)`; restricting to `M` gives an isomorphism `D_A ≅ Gal(M/Kp)`.
6. Two separable closures of `Kp` have isomorphic automorphism groups.
-/

open scoped Pointwise Valued

namespace NK.NeukirchUchida

noncomputable section

variable {K : Type*} [Field K] [NumberField K]
variable {K' : Type*} [Field K'] [Algebra K K'] [IsSepClosure K K']

/-- **Neukirch–Uchida, local decomposition.**  The decomposition group of a place `A` of a
separable closure `K'` of a number field `K` above a finite place `p` is the absolute Galois
group of the `p`-adic completion of `K`. -/
theorem nonempty_mulEquiv_decompositionGroupOf_localGalois {K K' : Type*} [Field K]
    [NumberField K] [Field K'] [Algebra K K'] [IsSepClosure K K']
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    (hA : A.comap (algebraMap K K') =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p) :
    Nonempty (NK.Mine.decompositionGroupOf K K' A ≃*
      Gal(SeparableClosure (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) /
        IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)) := by
  haveI : IsSepClosed K' := IsSepClosure.sep_closed K
  -- ### Notation
  let Kp := IsDedekindDomain.HeightOneSpectrum.adicCompletion K p
  let Φ : Kp →+* placeCompletion A := adicCompletionToPlaceCompletion p A hA
  letI : Algebra Kp (placeCompletion A) := Φ.toAlgebra
  have hΦeq : Φ = adicCompletionToPlaceCompletion p A hA := rfl
  haveI hSepC : IsSepClosed (placeCompletion A) := isSepClosed_placeCompletion p A hA
  have hΦmap : algebraMap Kp (placeCompletion A) = Φ := rfl
  haveI : CharZero Kp := CharZero.of_addMonoidHom (algebraMap K Kp).toAddMonoidHom (by simp)
    (fun a b h => RingHom.injective (algebraMap K Kp) h)
  -- the image of `K'` in `C`, and the subfield it generates together with `Kp`
  let S : Set (placeCompletion A) := Set.range (placeCompletionCoe A)
  let M : IntermediateField Kp (placeCompletion A) := IntermediateField.adjoin Kp S
  have hmemM : ∀ y : K', (placeCompletionCoe A y : placeCompletion A) ∈ M := fun y =>
    IntermediateField.subset_adjoin Kp S ⟨y, rfl⟩
  -- ### step 5.1: the image of `K'` is algebraic over `Kp`
  have hS_alg : ∀ x ∈ S, IsAlgebraic Kp x := by
    rintro x ⟨y, rfl⟩
    obtain ⟨q, hq0, hq⟩ := (Algebra.IsSeparable.isAlgebraic K K').isAlgebraic y
    refine ⟨q.map (algebraMap K Kp), Polynomial.map_ne_zero hq0, ?_⟩
    rw [Polynomial.aeval_def, hΦmap, Polynomial.eval₂_map,
      show Φ.comp (algebraMap K Kp) = (placeCompletionCoe A).comp (algebraMap K K') from
        RingHom.ext fun c => by
          rw [RingHom.comp_apply, RingHom.comp_apply, hΦeq,
            adicCompletionToPlaceCompletion_algebraMap p A hA c, placeCompletionCoe_apply],
      Polynomial.eval₂_eq_eval_map, ← Polynomial.map_map, Polynomial.eval_map,
      Polynomial.eval₂_hom,
      Polynomial.eval_map, ← Polynomial.aeval_def, hq, map_zero]
  have hM_alg : ∀ x ∈ M, IsAlgebraic Kp x := by
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem z hz => exact hS_alg z hz
    | algebraMap z => exact isAlgebraic_algebraMap z
    | add x y hx hy ihx ihy => exact ihx.add ihy
    | mul x y hx hy ihx ihy => exact ihx.mul ihy
    | inv x hx ih => exact ih.inv
  -- ### step 5.2: `M` is contained in the separable closure of `Kp`, and contains it
  -- (Krasner's lemma)
  have hM_le_sep : M ≤ separableClosure Kp (placeCompletion A) := by
    intro x hx
    rw [mem_separableClosure_iff]
    exact PerfectField.separable_of_irreducible
      (minpoly.irreducible (hM_alg x hx).isIntegral)
  have hsep_le_M : separableClosure Kp (placeCompletion A) ≤ M := by
    intro x hx
    rw [mem_separableClosure_iff] at hx
    obtain ⟨q, hq0, hqx⟩ := (hx.isIntegral.isAlgebraic)
    have hx' : ∃ q : Polynomial Kp, q ≠ 0 ∧ Polynomial.eval₂ Φ x q = 0 := ⟨q, hq0, by
      rw [Polynomial.aeval_def,
        show algebraMap Kp (placeCompletion A) = Φ from hΦmap] at hqx
      exact hqx⟩
    obtain ⟨y, hy⟩ := exists_mem_subfieldClosure_of_eval_eq_zero p A hA
      (comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers p A hA) hx'
    have hsub : Set.range (adicCompletionToPlaceCompletion p A hA) ∪
        {placeCompletionCoe A y} ⊆ (M : Set (placeCompletion A)) := by
      rintro z (⟨w, rfl⟩ | rfl)
      · simpa [hΦmap] using M.algebraMap_mem w
      · exact hmemM y
    exact Subfield.closure_le.mpr hsub hy
  have hMeq : M = separableClosure Kp (placeCompletion A) :=
    le_antisymm hM_le_sep hsep_le_M
  -- ### step 5.3: `M` is a separable closure of `Kp`
  have hSepM : IsSepClosure Kp M :=
    hMeq.symm ▸ separableClosure.isSepClosure Kp (placeCompletion A)
  -- ### steps 5.4 - 5.5: `D_A ≃* Gal(M/Kp)`
  have hDE : Nonempty (NK.Mine.decompositionGroupOf K K' A ≃* (M ≃ₐ[Kp] M)) :=
    nonempty_mulEquiv_decompositionGroupOf_adjoin (K := K) (K' := K') p A hA
      (halg := fun z => rfl)
      (comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers p A hA)
  -- ### step 6: `Gal(M/Kp) ≃* Gal(Kp^sep/Kp)` for two separable closures of `Kp`
  obtain ⟨e₂⟩ := NK.FieldTheory.Galois.nonempty_mulEquiv_algEquiv_of_isSepClosure
    (K := Kp) (L := M) (M := SeparableClosure Kp)
  obtain ⟨e₁⟩ := hDE
  exact ⟨e₁.trans e₂⟩


end

end NK.NeukirchUchida
