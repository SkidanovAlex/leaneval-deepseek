# The index of the `m`-th power subgroup is a profinite-completion invariant

For a commutative group `A` and any `m : ℕ` with `A ⧸ A^m` finite, the index of the subgroup
generated by the `m`-th powers is the same in `A` and in the profinite completion `A^∧`.

This generalises `NK.LocalInputs.CommGroupRank.natCard_quot_pow_cpl_eq_of_finite` (which is the
case of a prime `m`) to arbitrary `m`; the proof is the same one: the `m`-th power subgroup of the
completion is the kernel of the continuous surjection `A^∧ ↠ A ⧸ A^m`, since it is a closed
subgroup containing the dense image of `A^m` and is contained in that open kernel.
-/
import Mathlib
import Submission.NK.LocalInputs.CommGroupRank.numIndexSubgroups_profiniteCompletion

namespace NK.Mine

open scoped Classical
open scoped IsMulCommutative

noncomputable section

universe u

open NK.LocalInputs.CommGroupRank

/-- In a commutative group, the subgroup generated by the `m`-th powers is the range of the
`m`-th power endomorphism. -/
theorem closure_range_pow_eq_powMonoidHom_range (G : Type u) [Group G] [IsMulCommutative G]
    (m : ℕ) :
    Subgroup.closure (Set.range fun y : G => y ^ m) = (powMonoidHom m : G →* G).range := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro x ⟨y, rfl⟩
    exact ⟨y, rfl⟩
  · intro x hx
    exact Subgroup.subset_closure hx

/-- **The `m`-th power quotient of a commutative group and of its profinite completion have the
same cardinality**, when `A ⧸ A^m` is finite. -/
theorem natCard_quot_powMonoidHom_cpl_eq (A : Type u) [CommGroup A] (m : ℕ)
    [Finite (A ⧸ (powMonoidHom m : A →* A).range)] :
    Nat.card (cpl A ⧸ (powMonoidHom m : cpl A →* cpl A).range) =
      Nat.card (A ⧸ (powMonoidHom m : A →* A).range) := by
  have hmc : IsMulCommutative (cpl A) := isMulCommutative_cpl A
  let H : Subgroup A := (powMonoidHom m : A →* A).range
  let E := A ⧸ H
  let q : A →* E := QuotientGroup.mk' H
  have hq_surj : Function.Surjective q := QuotientGroup.mk'_surjective H
  have hq_ker : q.ker = H := QuotientGroup.ker_mk' H
  let P : ProfiniteGrp := ProfiniteGrp.ofFiniteGrp (FiniteGrp.of E)
  let φ : ProfiniteGrp.ProfiniteCompletion.completion (GrpCat.of A) ⟶ P :=
    ProfiniteGrp.ProfiniteCompletion.lift (P := P) (GrpCat.ofHom (q : A →* ↑P.toProfinite.toTop))
  let φm : cpl A →* E := φ.hom.toMonoidHom
  have hφη : φm.comp (cplEta A) = q := by
    refine MonoidHom.ext (fun a => ?_)
    have h := CategoryTheory.ConcreteCategory.congr_hom (ProfiniteGrp.ProfiniteCompletion.lift_eta
      (P := P) (f := GrpCat.ofHom (q : A →* ↑P.toProfinite.toTop))) a
    exact h
  have hsurj : Function.Surjective φm := by
    intro y
    obtain ⟨a, ha⟩ := hq_surj y
    exact ⟨cplEta A a, by
      rw [show φm (cplEta A a) = (φm.comp (cplEta A)) a from rfl, hφη, ha]⟩
  have hqa : ∀ a : A, φm (cplEta A a) = q a := fun a =>
    congrArg (fun f : A →* E => f a) hφη
  have hNcomap : φm.ker.comap (cplEta A) = H := by
    ext a
    rw [Subgroup.mem_comap, MonoidHom.mem_ker, hqa a, ← MonoidHom.mem_ker, hq_ker]
  -- `E` has exponent dividing `m`
  have hEexp : ∀ z : E, z ^ m = 1 := by
    intro z
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective H z
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact MonoidHom.mem_range.mpr ⟨w, rfl⟩
  -- the `m`-th power subgroup is contained in the kernel
  have hge : (powMonoidHom m : cpl A →* cpl A).range ≤ φm.ker := by
    rintro x ⟨y, rfl⟩
    change φm (y ^ m) = 1
    rw [map_pow]
    exact hEexp (φm y)
  -- the kernel is open: it is closed and of finite index
  haveI hker_fin : φm.ker.FiniteIndex := by
    rw [Subgroup.finiteIndex_iff, Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj]
    exact Nat.card_ne_zero.mpr ⟨⟨⟨1, Subgroup.mem_top 1⟩⟩, inferInstance⟩
  have hopen : IsOpen ((φm.ker : Set (cpl A))) := by
    refine Subgroup.isOpen_of_isClosed_of_finiteIndex _ ?_
    have hEq : (φm.ker : Set (cpl A)) = φm ⁻¹' ({1} : Set E) := by
      ext x
      simp [MonoidHom.mem_ker]
    rw [hEq]
    exact isClosed_singleton.preimage (φ.hom.continuous_toFun)
  -- the `m`-th power subgroup is closed
  have hclosed : IsClosed (((powMonoidHom m : cpl A →* cpl A).range : Subgroup (cpl A)) :
      Set (cpl A)) := by
    convert (isCompact_range (continuous_pow (M := cpl A) m)).isClosed using 1
    ext x
    simp
  have hη : Dense (Set.range (cplEta A)) := ProfiniteGrp.ProfiniteCompletion.denseRange _
  -- the reverse inclusion, by density
  have hle : φm.ker ≤ (powMonoidHom m : cpl A →* cpl A).range := by
    intro x hx
    have hST : ((cplEta A) '' (H : Set A)) ⊆
        (((powMonoidHom m : cpl A →* cpl A).range : Subgroup (cpl A)) : Set (cpl A)) := by
      rintro _ ⟨a, ha, rfl⟩
      obtain ⟨b, rfl⟩ := ha
      exact ⟨cplEta A b, by
        simp only [powMonoidHom_apply]
        exact (map_pow (cplEta A) b m).symm⟩
    refine (IsClosed.closure_subset_iff hclosed).mpr hST ?_
    rw [mem_closure_iff]
    intro U hU hxU
    have hUopen : IsOpen (U ∩ (φm.ker : Set (cpl A))) := hU.inter hopen
    have hne : (U ∩ (φm.ker : Set (cpl A))).Nonempty := ⟨x, hxU, hx⟩
    obtain ⟨z, hzrange, hzU, hzN⟩ := hη.exists_mem_open hUopen hne
    obtain ⟨a, rfl⟩ := hzrange
    have haH : a ∈ H := by
      have h1 : a ∈ (φm.ker).comap (cplEta A) := hzN
      rwa [hNcomap] at h1
    exact ⟨cplEta A a, hzU, ⟨a, haH, rfl⟩⟩
  have hN : φm.ker = (powMonoidHom m : cpl A →* cpl A).range := le_antisymm hle hge
  rw [← hN]
  exact Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective φm hsurj).toEquiv

/-- **The index of the `m`-th power subgroup is a profinite-completion invariant** for commutative
groups: the subgroups generated by the `m`-th powers in `A` and in its profinite completion have
the same index. -/
theorem index_powSub_cpl_eq (A : Type*) [CommGroup A] {m : ℕ} (hm : 0 < m)
    [Finite (A ⧸ Subgroup.closure (Set.range fun y : A => y ^ m))] :
    (Subgroup.closure (Set.range fun y : NK.LocalInputs.CommGroupRank.cpl A => y ^ m)).index =
      (Subgroup.closure (Set.range fun y : A => y ^ m)).index := by
  have hA : Subgroup.closure (Set.range fun y : A => y ^ m) = (powMonoidHom m : A →* A).range :=
    closure_range_pow_eq_powMonoidHom_range A m
  have hC : Subgroup.closure (Set.range fun y : cpl A => y ^ m) =
      (powMonoidHom m : cpl A →* cpl A).range :=
    closure_range_pow_eq_powMonoidHom_range (cpl A) m
  haveI : Finite (A ⧸ (powMonoidHom m : A →* A).range) :=
    hA ▸ (inferInstance : Finite (A ⧸ Subgroup.closure (Set.range fun y : A => y ^ m)))
  show Nat.card (cpl A ⧸ Subgroup.closure (Set.range fun y : cpl A => y ^ m)) =
      Nat.card (A ⧸ Subgroup.closure (Set.range fun y : A => y ^ m))
  rw [hA, hC]
  exact natCard_quot_powMonoidHom_cpl_eq A m

end

end NK.Mine
