import Mathlib
import Submission.NK.Mine.AdjoinLocalGalois

open scoped Pointwise Topology

namespace NK.Mine

noncomputable section

set_option maxHeartbeats 1000000
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

/-! ## Generic lemmas

The proof of the continuity of `σ ↦ σ̂|_M` rests on two general facts, stated here in the abstract
so that the (heavy) arithmetic vocabulary of the main statement does not leak into them. -/

/-- **Single-element extraction.**  Let `f : K' →+* L` be a ring homomorphism from a field `K'`
algebraic over `K` into a field `L`.  Then every element of the subfield of `L` generated over `κ`
by the image of `f` lies in the subfield generated over `κ` by the image of a *finite*
intermediate extension `K ≤ F ≤ K'`. -/
theorem exists_finite_adjoin_of_mem_adjoin_range
    {κ L K K' : Type*} [Field κ] [Field L] [Algebra κ L] [Field K] [Field K']
    [Algebra K K'] [Algebra.IsAlgebraic K K'] (f : K' →+* L) {x : L}
    (hx : x ∈ IntermediateField.adjoin κ (Set.range f)) :
    ∃ F : IntermediateField K K', FiniteDimensional K F ∧
      x ∈ IntermediateField.adjoin κ (f '' (F : Set K')) := by
  classical
  refine IntermediateField.adjoin_induction κ (s := Set.range f)
    (p := fun z _ => ∃ F : IntermediateField K K', FiniteDimensional K F ∧
      z ∈ IntermediateField.adjoin κ (f '' (F : Set K'))) ?_ ?_ ?_ ?_ ?_ hx
  · rintro z ⟨y, rfl⟩
    refine ⟨IntermediateField.adjoin K ({y} : Set K'), ?_, ?_⟩
    · exact IntermediateField.adjoin.finiteDimensional
        (IsAlgebraic.isIntegral (Algebra.IsAlgebraic.isAlgebraic y))
    · exact IntermediateField.subset_adjoin κ _
        ⟨y, IntermediateField.subset_adjoin K _ (Set.mem_singleton y), rfl⟩
  · intro c
    exact ⟨(⊥ : IntermediateField K K'),
      (inferInstance : FiniteDimensional K (⊥ : IntermediateField K K')),
      IntermediateField.algebraMap_mem _ c⟩
  · rintro z w _ _ ⟨F₁, hf₁, hm₁⟩ ⟨F₂, hf₂, hm₂⟩
    haveI := hf₁
    haveI := hf₂
    refine ⟨F₁ ⊔ F₂, IntermediateField.finiteDimensional_sup F₁ F₂, add_mem ?_ ?_⟩
    · exact IntermediateField.adjoin_le_iff.mpr
        ((Set.image_mono (le_sup_left : F₁ ≤ F₁ ⊔ F₂)).trans
          (IntermediateField.subset_adjoin κ _)) hm₁
    · exact IntermediateField.adjoin_le_iff.mpr
        ((Set.image_mono (le_sup_right : F₂ ≤ F₁ ⊔ F₂)).trans
          (IntermediateField.subset_adjoin κ _)) hm₂
  · rintro z _ ⟨F, hf, hm⟩
    exact ⟨F, hf, inv_mem hm⟩
  · rintro z w _ _ ⟨F₁, hf₁, hm₁⟩ ⟨F₂, hf₂, hm₂⟩
    haveI := hf₁
    haveI := hf₂
    refine ⟨F₁ ⊔ F₂, IntermediateField.finiteDimensional_sup F₁ F₂, mul_mem ?_ ?_⟩
    · exact IntermediateField.adjoin_le_iff.mpr
        ((Set.image_mono (le_sup_left : F₁ ≤ F₁ ⊔ F₂)).trans
          (IntermediateField.subset_adjoin κ _)) hm₁
    · exact IntermediateField.adjoin_le_iff.mpr
        ((Set.image_mono (le_sup_right : F₂ ≤ F₁ ⊔ F₂)).trans
          (IntermediateField.subset_adjoin κ _)) hm₂

/-- **The extension of a valuation-preserving automorphism to the completion is the identity on
a generated subfield.**  If `σ` preserves the valuation `v` and acts trivially on the image of `κ`
in the completion and on a set `s` of the completion, then its continuous extension to the
completion acts trivially on the subfield generated by `κ` and `s`. -/
theorem completionRingEquiv_eq_of_mem_adjoin
    {R : Type*} [Field R] {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]
    (v : Valuation R Γ₀) (σ : R ≃+* R) (hσ : ∀ x : R, v (σ x) = v x)
    {κ : Type*} [Field κ] [Algebra κ v.Completion]
    (hcoef : ∀ c : κ, Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
      (algebraMap κ v.Completion c) = algebraMap κ v.Completion c)
    {s : Set v.Completion}
    (hs : ∀ y ∈ s, Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ y = y)
    {z : v.Completion} (hz : z ∈ IntermediateField.adjoin κ s) :
    Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ z = z := by
  refine IntermediateField.adjoin_induction κ (s := s)
    (p := fun z _ => Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ z = z)
    ?_ ?_ ?_ ?_ ?_ hz
  · intro y hy; exact hs y hy
  · intro c; exact hcoef c
  · intro a b _ _ ha hb; rw [map_add, ha, hb]
  · intro a _ ha; rw [map_inv₀, ha]
  · intro a b _ _ ha hb; rw [map_mul, ha, hb]

/-- **Continuity from the local fixing property.**  Let `D` be a subgroup of an absolute Galois
group and `f : D → Gal(M/κ)` a group homomorphism.  If for every finite extension `E/κ` inside `M`
there is a finite extension `F/K` inside `K'` whose fixing subgroup is mapped by `f` into the
fixing subgroup of `E`, then `f` is continuous for the Krull topologies. -/
theorem continuous_of_local_fixing
    {κ L : Type*} [Field κ] [Field L] [Algebra κ L] (M : IntermediateField κ L)
    {K K' : Type*} [Field K] [Field K'] [Algebra K K'] (D : Subgroup Gal(K'/K))
    (f : ↥D →* Gal(↥M/κ))
    (h : ∀ E : IntermediateField κ ↥M, FiniteDimensional κ E →
      ∃ F : IntermediateField K K', FiniteDimensional K F ∧
        ∀ σ : ↥D, (σ : Gal(K'/K)) ∈ F.fixingSubgroup → f σ ∈ E.fixingSubgroup) :
    Continuous (f : ↥D → Gal(↥M/κ)) := by
  refine continuous_of_continuousAt_one f ?_
  rw [ContinuousAt, f.map_one, Filter.tendsto_def]
  intro U hU
  rw [krullTopology_mem_nhds_one_iff κ ↥M] at hU
  obtain ⟨E, hEfin, hEU⟩ := hU
  obtain ⟨F, hFfin, hF⟩ := h E hEfin
  have hFnhds : (F.fixingSubgroup : Set Gal(K'/K)) ∈ 𝓝 (1 : Gal(K'/K)) :=
    (krullTopology_mem_nhds_one_iff K K' _).mpr ⟨F, hFfin, subset_rfl⟩
  have hval : Subtype.val ⁻¹' (F.fixingSubgroup : Set Gal(K'/K)) ∈ 𝓝 (1 : ↥D) :=
    (Filter.tendsto_def.mp (continuous_subtype_val.continuousAt :
      ContinuousAt (Subtype.val : ↥D → Gal(K'/K)) (1 : ↥D))) _ hFnhds
  refine Filter.mem_of_superset hval ?_
  intro σ hσ
  exact hEU (hF σ hσ)

/-! ## The specialization to `M = κ·K' ⊆ placeCompletion A` -/

/-- The continuous extension of a valuation-preserving automorphism `σ` of `K'` to the completion
of `K'` at `A` sends `placeCompletionCoe A y` to `placeCompletionCoe A (σ y)`. -/
theorem completionRingEquiv_placeCompletionCoe
    {K : Type*} [Field K] [NumberField K]
    {K' : Type*} [Field K'] [Algebra K K'] [IsSepClosure K K']
    (A : ValuationSubring K') (σ : Gal(K'/K))
    (hσ : ∀ x : K', A.valuation (σ x) = A.valuation x) (y : K') :
    Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.toRingEquiv hσ
        (NK.NeukirchUchida.placeCompletionCoe A y) =
      NK.NeukirchUchida.placeCompletionCoe A (σ y) := by
  rw [show NK.NeukirchUchida.placeCompletionCoe A y =
      ((y : K') : NK.NeukirchUchida.placeCompletion A) from rfl,
    Submission.NeukirchUchida.Local.completionRingEquiv_coe]
  rfl

/-- **The map `σ ↦ σ̂|_M` fixes a subfield generated by a fixing subgroup.**  If `σ ∈ D_A` fixes a
finite extension `F ≤ K'` of `K` pointwise, then its restriction to `M = κ·K'` fixes the subfield
generated over `κ` by the image of `F` in `M`. -/
theorem decompositionToAdjoin_fixes_adjoin
    {K : Type*} [Field K] [NumberField K]
    {K' : Type*} [Field K'] [Algebra K K'] [IsSepClosure K K']
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    (hA : A.comap (algebraMap K K') =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      algebraMap _ _ z = NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA z)
    (σ : NK.Mine.decompositionGroupOf K K' A) (F : IntermediateField K K')
    (hF : ∀ y ∈ F, σ.1 y = y)
    {z : ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)}
    (hz : (z : NK.NeukirchUchida.placeCompletion A) ∈
      IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        (NK.NeukirchUchida.placeCompletionCoe A '' (F : Set K'))) :
    NK.NeukirchUchida.decompositionToAdjoin p A hA halg σ z = z := by
  refine Subtype.ext ?_
  have hval : ∀ x : K', A.valuation (σ.1 x) = A.valuation x :=
    NK.NeukirchUchida.val_eq_of_mem_decompositionGroupOf A σ.2
  have hcoef : ∀ c : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval
        (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
          (NK.NeukirchUchida.placeCompletion A) c) =
      algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        (NK.NeukirchUchida.placeCompletion A) c := by
    intro c
    have hΦ : (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        (NK.NeukirchUchida.placeCompletion A)) =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA := RingHom.ext halg
    rw [RingHom.congr_fun hΦ c]
    exact NK.NeukirchUchida.completionRingEquiv_adicCompletionToPlaceCompletion p A hA
      σ.1.toRingEquiv hval (fun c => σ.1.commutes c) c
  have hs : ∀ y ∈ (NK.NeukirchUchida.placeCompletionCoe A '' (F : Set K')),
      Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval y = y := by
    rintro y ⟨y₀, hy₀, rfl⟩
    rw [completionRingEquiv_placeCompletionCoe A σ.1 hval y₀, hF y₀ hy₀]
  have h := completionRingEquiv_eq_of_mem_adjoin A.valuation σ.1.toRingEquiv hval hcoef hs hz
  show (NK.NeukirchUchida.decompositionToAdjoin p A hA halg σ z :
    NK.NeukirchUchida.placeCompletion A) = (z : NK.NeukirchUchida.placeCompletion A)
  rw [show (NK.NeukirchUchida.decompositionToAdjoin p A hA halg σ z :
      NK.NeukirchUchida.placeCompletion A) =
    Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval
      (z : NK.NeukirchUchida.placeCompletion A) from rfl]
  exact h

/-- **The map `σ ↦ σ̂|_M` of the local decomposition result is continuous** (for the Krull
topology on `Gal(M/κ)`, `M = adjoinPlaceCompletion p A = κ·K' ⊆ placeCompletion A`), where `κ` is
the `p`-adic completion of the number field `K` and `K'` a separable closure of `K`.

Route (forward continuity, no compactness needed).  `f = decompositionToAdjoin p A hA halg` is a
group homomorphism `D = decompositionGroupOf K K' A →* Gal(M/κ)` (`NK.Mine.adjoinLocalHom`), so by
`continuous_of_continuousAt_one` it suffices to prove continuity at `1`: for a finite-dimensional
intermediate field `E ≤ M` over `κ` we must find an intermediate field `F ≤ K'` with
`FiniteDimensional K F` and `F.fixingSubgroup ∩ D ⊆ f ⁻¹' E.fixingSubgroup` (a neighbourhood of `1`
in the subtype `↥D`: the set `F.fixingSubgroup ⊓ D`, viewed as a subset of `↥D`, is open because it
is the preimage of the open `F.fixingSubgroup` under `Subtype.val`).

* By the primitive element result `Field.exists_primitive_element κ ↥E` (`E/κ` is separable as
  `E ⊆ M` and `IsSepClosure κ M`) write `E = κ(θ)` for a single `θ : ↥E`; via
  `IntermediateField.lift_adjoin_simple`/`lift_top` this means
  `E = IntermediateField.adjoin κ {↑θ}`.
* **Single-element extraction.**  For every `x ∈ M` there is `F ≤ K'` with `FiniteDimensional K F`
  and `x ∈ IntermediateField.adjoin κ (placeCompletionCoe A '' (F : Set K'))`.  Proof by
  `IntermediateField.adjoin_induction` on `x ∈ M = adjoin κ (range (placeCompletionCoe A))`: for a
  generator `x = placeCompletionCoe A y` take `F = IntermediateField.adjoin K {y}` (finite over `K`
  since `K'/K` is algebraic, using `IntermediateField.adjoin.finiteDimensional` and
  `IsAlgebraic.isIntegral`); for `x ∈ κ` take `F = ⊥`; for sums/products take the sup of the two
  fields found (`IntermediateField.finiteDimensional_sup`), and inversion preserves the ambient
  field.  Apply this to `x = ↑θ`.
* **Fixing step.**  If `σ ∈ D` fixes `F ≤ K'` pointwise then `f σ` fixes every element of
  `IntermediateField.adjoin κ (placeCompletionCoe A '' (F : Set K'))` pointwise: again by
  `adjoin_induction`, using `decompositionToAdjoin_coInAdjoin`
  (`f σ (coInAdjoin y) = coInAdjoin (σ y)`) and `AlgEquiv.commutes` for the `κ`-coefficients.
* Hence `σ ∈ F.fixingSubgroup ∩ D` implies `f σ ∈ E.fixingSubgroup`, and continuity at `1` follows
  from `krullTopology_mem_nhds_one_iff κ ↥M`. -/
theorem continuous_decompositionToAdjoin
    {K : Type*} [Field K] [NumberField K]
    {K' : Type*} [Field K'] [Algebra K K'] [IsSepClosure K K']
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    (hA : A.comap (algebraMap K K') =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      algebraMap _ _ z = NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA z) :
    Continuous (NK.NeukirchUchida.decompositionToAdjoin p A hA halg :
      NK.Mine.decompositionGroupOf K K' A →
      (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
        IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
        NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)) := by
  classical
  have hSep : IsSepClosure (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A) :=
    NK.Mine.isSepClosure_adjoinPlaceCompletion p A hA halg
  haveI := hSep
  have hkey : ∀ E : IntermediateField (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A),
      FiniteDimensional (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) E →
      ∃ F : IntermediateField K K', FiniteDimensional K F ∧
        ∀ σ : ↥(NK.Mine.decompositionGroupOf K K' A),
          (σ : Gal(K'/K)) ∈ F.fixingSubgroup →
          NK.NeukirchUchida.decompositionToAdjoin p A hA halg σ ∈ E.fixingSubgroup := by
    intro E hEfin
    haveI hEdim : FiniteDimensional (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) ↥E :=
      hEfin
    obtain ⟨θ, hθ⟩ := Field.exists_primitive_element
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) ↥E
    have hE : E = IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ({↑θ} : Set ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)) := by
      calc E = IntermediateField.lift (⊤ : IntermediateField
            (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) ↥E) :=
            (IntermediateField.lift_top _ E).symm
        _ = IntermediateField.lift (IntermediateField.adjoin
              (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) ({θ} : Set ↥E)) := by
              rw [hθ]
        _ = IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
              ({↑θ} : Set ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)) :=
            IntermediateField.lift_adjoin_simple _ E θ
    obtain ⟨F, hFfin, hFmem⟩ := exists_finite_adjoin_of_mem_adjoin_range
      (κ := IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (L := NK.NeukirchUchida.placeCompletion A) (K := K) (K' := K')
      (NK.NeukirchUchida.placeCompletionCoe A)
      (x := (((θ : ↥E) : ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)) :
        NK.NeukirchUchida.placeCompletion A))
      (((θ : ↥E) : ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A))).2
    refine ⟨F, hFfin, ?_⟩
    intro σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hle : E ≤ (IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        (NK.NeukirchUchida.placeCompletionCoe A '' (F : Set K'))).comap
        (IntermediateField.val
          (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)) := by
      rw [hE, IntermediateField.adjoin_le_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact hFmem
    exact decompositionToAdjoin_fixes_adjoin p A hA halg σ F
      ((IntermediateField.mem_fixingSubgroup_iff F (σ : Gal(K'/K))).mp hσ) (hle hx)
  have hcont : Continuous (NK.Mine.adjoinLocalHom p A hA halg :
      ↥(NK.Mine.decompositionGroupOf K K' A) →
      (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
        IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
        NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)) :=
    continuous_of_local_fixing (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A)
      (NK.Mine.decompositionGroupOf K K' A) (NK.Mine.adjoinLocalHom p A hA halg) hkey
  exact hcont

end

end NK.Mine
