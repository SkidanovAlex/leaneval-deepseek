import Mathlib
import Submission.NK.HeckeL.Zeta
import Submission.NK.HeckeL.Product.prod_comp_eq_pow_card_ker
import Submission.NK.HeckeL.Product.prod_nthRootsFinset_one_sub_mul

set_option linter.style.haveILetI false

namespace NK.HeckeL.Product

/-- The product, over the characters of the cyclic group generated by `σ`, of `1 - χ(σ) x`:
restricting to `⟨σ⟩` cuts the exponent of the general formula down to `1`. -/
private theorem prod_zpowers_monoidHom_one_sub_mul_aux {G : Type*} [CommGroup G] [Fintype G]
    (σ : G) (x : ℂ) :
    ∏ ψ : Subgroup.zpowers σ →* ℂˣ, (1 - ((ψ ⟨σ, Subgroup.mem_zpowers σ⟩ : ℂˣ) : ℂ) * x)
      = 1 - x ^ orderOf σ := by
  classical
  set H : Subgroup G := Subgroup.zpowers σ with hH
  set h : H := ⟨σ, Subgroup.mem_zpowers σ⟩ with hh
  have hHcard : Nat.card H = orderOf σ := by rw [hH]; exact Nat.card_zpowers σ
  have hgen : ∀ y : H, y ∈ Subgroup.zpowers h := by
    intro y
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp y.2
    refine Subgroup.mem_zpowers_iff.mpr ⟨k, Subtype.ext ?_⟩
    rw [Subgroup.coe_zpow]
    simpa using hk
  have hinj : Function.Injective (fun ψ : H →* ℂˣ => ((ψ h : ℂˣ) : ℂ)) := by
    intro ψ χ hψχ
    have : ψ h = χ h := Units.ext hψχ
    exact (MonoidHom.eq_iff_eq_on_generator hgen ψ χ).mpr this
  have hhd : h ^ orderOf σ = 1 := by
    rw [← hHcard, Nat.card_eq_fintype_card]
    exact pow_card_eq_one
  have hsub : (Finset.univ.image (fun ψ : H →* ℂˣ => ((ψ h : ℂˣ) : ℂ))) ⊆
      Polynomial.nthRootsFinset (orderOf σ) (1 : ℂ) := by
    intro z hz
    simp only [Finset.mem_image, Finset.mem_univ, true_and] at hz
    obtain ⟨ψ, rfl⟩ := hz
    rw [Polynomial.mem_nthRootsFinset (orderOf_pos σ)]
    rw [← Units.val_pow_eq_pow_val, ← map_pow, hhd, map_one, Units.val_one]
  have hScard : (Finset.univ.image (fun ψ : H →* ℂˣ => ((ψ h : ℂˣ) : ℂ))).card = orderOf σ := by
    rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, ← Nat.card_eq_fintype_card,
      CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity H ℂ, hHcard]
  have hncard : (Polynomial.nthRootsFinset (orderOf σ) (1 : ℂ)).card = orderOf σ :=
    IsPrimitiveRoot.card_nthRootsFinset
      (Complex.isPrimitiveRoot_exp (orderOf σ) (orderOf_pos σ).ne')
  have hS : (Finset.univ.image (fun ψ : H →* ℂˣ => ((ψ h : ℂˣ) : ℂ))) =
      Polynomial.nthRootsFinset (orderOf σ) (1 : ℂ) := by
    refine Finset.eq_of_subset_of_card_le hsub ?_
    rw [hncard, hScard]
  have hprod : ∏ ψ : H →* ℂˣ, (1 - ((ψ h : ℂˣ) : ℂ) * x)
      = ∏ z ∈ Polynomial.nthRootsFinset (orderOf σ) (1 : ℂ), (1 - z * x) := by
    rw [← hS]
    exact (Finset.prod_image (s := Finset.univ) (g := fun ψ : H →* ℂˣ => ((ψ h : ℂˣ) : ℂ))
      (f := fun z : ℂ => 1 - z * x) (fun a _ b _ hab => hinj hab)).symm
  rw [hprod]
  exact prod_nthRootsFinset_one_sub_mul (orderOf σ) (orderOf_pos σ) x

theorem prod_monoidHom_one_sub_mul (G : Type*) [CommGroup G] [Fintype G] (σ : G) (x : ℂ) :
    ∏ χ : G →* ℂˣ, (1 - (χ σ : ℂ) * x) =
      (1 - x ^ orderOf σ) ^ (Nat.card G / orderOf σ) := by
  classical
  haveI hN : (Subgroup.zpowers σ).Normal := inferInstance
  have hsurj : Function.Surjective (MonoidHom.domRestrictHom (Subgroup.zpowers σ) ℂˣ) :=
    MonoidHom.domRestrict_surjective ℂ (Subgroup.zpowers σ)
  have hmain := prod_comp_eq_pow_card_ker (MonoidHom.domRestrictHom (Subgroup.zpowers σ) ℂˣ)
    hsurj (fun ψ : Subgroup.zpowers σ →* ℂˣ => 1 - ((ψ ⟨σ, Subgroup.mem_zpowers σ⟩ : ℂˣ) : ℂ) * x)
  have hinner : ∏ ψ : Subgroup.zpowers σ →* ℂˣ,
      (1 - ((ψ ⟨σ, Subgroup.mem_zpowers σ⟩ : ℂˣ) : ℂ) * x) = 1 - x ^ orderOf σ :=
    prod_zpowers_monoidHom_one_sub_mul_aux σ x
  have hker : Nat.card (MonoidHom.domRestrictHom (Subgroup.zpowers σ) ℂˣ).ker =
      Nat.card G / orderOf σ := by
    rw [CommGroup.card_domRestrictHom_ker ℂ (Subgroup.zpowers σ)]
    have h1 : Nat.card G = Nat.card (G ⧸ Subgroup.zpowers σ) * Nat.card (Subgroup.zpowers σ) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup _
    rw [Nat.card_zpowers] at h1
    exact Nat.eq_div_of_mul_eq_right (orderOf_pos σ).ne' (by rw [mul_comm]; exact h1.symm)
  calc ∏ χ : G →* ℂˣ, (1 - (χ σ : ℂ) * x)
      = ∏ χ : G →* ℂˣ,
          (1 - ((((MonoidHom.domRestrictHom (Subgroup.zpowers σ) ℂˣ) χ)
            ⟨σ, Subgroup.mem_zpowers σ⟩ : ℂˣ) : ℂ) * x) := by
        refine Finset.prod_congr rfl fun χ _ => ?_
        rfl
    _ = (∏ ψ : Subgroup.zpowers σ →* ℂˣ,
          (1 - ((ψ ⟨σ, Subgroup.mem_zpowers σ⟩ : ℂˣ) : ℂ) * x)) ^
            Nat.card (MonoidHom.domRestrictHom (Subgroup.zpowers σ) ℂˣ).ker := hmain
    _ = (1 - x ^ orderOf σ) ^ (Nat.card G / orderOf σ) := by rw [hinner, hker]

end NK.HeckeL.Product
