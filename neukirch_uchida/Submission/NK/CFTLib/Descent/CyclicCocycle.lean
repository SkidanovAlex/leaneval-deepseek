import Mathlib
import Submission.NK.HassePrinciple.Mu

/-!
# The explicit cyclic 2-cocycle of a cyclic group

Let `G` be a finite cyclic group generated by an element `g`, of cardinality `n`, and let `A` be a
`NK.HassePrinciple.CoeffInt`-linear representation of `G`.  For an element `a ∈ A` fixed by `G`
we define here the **explicit cyclic cocycle**

`cycFun A g a : G × G → A`,   `cycFun A g a (γ, δ) = carry(γ, δ) • a`,

where `carry(γ,δ) ∈ {0,1}` is the "carry" of the additive representatives of `γ` and `δ` with
respect to the generator `g` (i.e. `1` exactly when the exponents of `γ` and `δ` in terms of `g`
add up past `n`).  This is the classical factor system of the cyclic algebra
`A ⋊_a G`, and its cohomology class

`cycClass A g a := [cycFun A g a] ∈ H²(G, A)`

satisfies, by the classical theory of cyclic groups (periodicity of Tate cohomology):

* `cycClass A g a = 0` if and only if `a` is a norm, `a ∈ range (A.norm)`;
* every class in `H²(G, A)` is of this form.

The reason for building this *explicit* cocycle (rather than using Mathlib's period map
`Rep.FiniteCyclicGroup.groupCohomologyπEven`, whose kernel is likewise `range (A.norm)`) is that it
is *functorial on the nose*: for a group homomorphism `ρ : G' → G` and a `ρ`-equivariant map of
coefficient modules `φ : A → B`, the induced map on `H²` sends `cycClass A g a` to
`cycClass B (ρ g) (φ a)`.  This is what makes the localisation of the class at the decomposition
subgroups of a place computable, which is the technical input of the transfer step
(`NK.CFTLib.IdeleHasse.Descent.transfer`).

## Contents

* `dlog`, `carry`, `cycFun`, `cycClass` — the definitions;
* `pow_dlog`, `dlog_lt`, `card_mul_carry`, `carry_eq_zero_or_one`, `cycFun_mem_cocycles₂` — the
  elementary arithmetic of the carry and the cocycle identity.
-/

open CategoryTheory

namespace NK.CFTLib.Descent

universe u

variable {G : Type u} [Group G] [Fintype G]

noncomputable section

/-- **The discrete logarithm** with respect to a generator `g` of a finite group, with values in
`{0, 1, …, Fintype.card G - 1}`: the unique `i` in that range with `g ^ i = γ`. -/
def dlog (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (γ : G) : ℕ :=
  ((zmodMulEquivOfGenerator hg (Nat.card_eq_fintype_card (α := G))).symm γ).toAdd.val

/-- Computation rule for the isomorphism `Multiplicative (ZMod n) ≃* G` attached to a generator. -/
lemma zmodMulEquiv_apply_ofAdd_natCast (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (i : ℕ) :
    (zmodMulEquivOfGenerator hg (Nat.card_eq_fintype_card (α := G)))
      (Multiplicative.ofAdd ((i : ℕ) : ZMod (Fintype.card G))) = g ^ i := by
  rw [show ((i : ℕ) : ZMod (Fintype.card G)) = ((i : ℤ) : ZMod (Fintype.card G)) by push_cast; rfl]
  rw [zmodMulEquivOfGenerator_apply_ofAdd_intCast]
  simp

/-- `dlog` inverts the power map. -/
lemma pow_dlog (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (γ : G) :
    g ^ dlog g hg γ = γ := by
  haveI : NeZero (Fintype.card G) := ⟨(Fintype.card_pos).ne'⟩
  have h := zmodMulEquiv_apply_ofAdd_natCast (G := G) g hg (dlog g hg γ)
  have key : ((dlog g hg γ : ℕ) : ZMod (Fintype.card G)) =
      Multiplicative.toAdd ((zmodMulEquivOfGenerator hg
        (Nat.card_eq_fintype_card (α := G))).symm γ) := by
    rw [dlog, ZMod.natCast_zmod_val]
  rw [key] at h
  rw [show Multiplicative.ofAdd (Multiplicative.toAdd
        ((zmodMulEquivOfGenerator hg (Nat.card_eq_fintype_card (α := G))).symm γ))
      = (zmodMulEquivOfGenerator hg (Nat.card_eq_fintype_card (α := G))).symm γ from rfl,
    MulEquiv.apply_symm_apply] at h
  exact h.symm

/-- `dlog` takes values in `{0, …, n-1}`. -/
lemma dlog_lt (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (γ : G) :
    dlog g hg γ < Fintype.card G := by
  haveI : NeZero (Fintype.card G) := ⟨(Fintype.card_pos).ne'⟩
  exact ZMod.val_lt _

/-- **The carry**: for `γ, δ : G`, the integer `⌊(i + j)/n⌋ ∈ {0,1}` where `i`, `j` are the
discrete logarithms of `γ` and `δ`.  Equivalently
`carry(γ,δ) • n = dlog γ + dlog δ - dlog (γ * δ)`. -/
def carry (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (γ δ : G) : ℤ :=
  ((dlog g hg γ : ℤ) + (dlog g hg δ : ℤ) - (dlog g hg (γ * δ) : ℤ)) / (Fintype.card G : ℤ)

/-- The defining relation of the carry. -/
lemma card_mul_carry (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (γ δ : G) :
    (Fintype.card G : ℤ) * carry g hg γ δ =
      (dlog g hg γ : ℤ) + (dlog g hg δ : ℤ) - (dlog g hg (γ * δ) : ℤ) := by
  haveI : NeZero (Fintype.card G) := ⟨(Fintype.card_pos).ne'⟩
  have horder : orderOf g = Fintype.card G := by
    rw [orderOf_eq_card_of_zpowers_eq_top (by rw [eq_top_iff]; intro x _; exact hg x),
      Nat.card_eq_fintype_card]
  have hpow : g ^ ((dlog g hg γ : ℤ) + (dlog g hg δ : ℤ) - (dlog g hg (γ * δ) : ℤ)) = 1 := by
    rw [zpow_sub, zpow_add]
    simp only [zpow_natCast, pow_dlog]
    group
  have hdiv : (Fintype.card G : ℤ) ∣
      (dlog g hg γ : ℤ) + (dlog g hg δ : ℤ) - (dlog g hg (γ * δ) : ℤ) := by
    rw [← horder]
    exact (orderOf_dvd_iff_zpow_eq_one (x := g)).mpr hpow
  rw [carry, mul_comm, Int.ediv_mul_cancel hdiv]

/-- The carry takes only the values `0` and `1`. -/
lemma carry_eq_zero_or_one (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (γ δ : G) :
    carry g hg γ δ = 0 ∨ carry g hg γ δ = 1 := by
  haveI : NeZero (Fintype.card G) := ⟨(Fintype.card_pos).ne'⟩
  have hn : (0 : ℤ) < Fintype.card G := by exact_mod_cast (Fintype.card_pos (α := G))
  have hc : carry g hg γ δ * (Fintype.card G : ℤ) =
      (dlog g hg γ : ℤ) + (dlog g hg δ : ℤ) - (dlog g hg (γ * δ) : ℤ) := by
    rw [mul_comm, card_mul_carry]
  have h2 : (0 : ℤ) ≤ (dlog g hg γ : ℤ) := by positivity
  have h3 : (dlog g hg γ : ℤ) < Fintype.card G := by exact_mod_cast dlog_lt g hg γ
  have h4 : (0 : ℤ) ≤ (dlog g hg δ : ℤ) := by positivity
  have h5 : (dlog g hg δ : ℤ) < Fintype.card G := by exact_mod_cast dlog_lt g hg δ
  have h6 : (0 : ℤ) ≤ (dlog g hg (γ * δ) : ℤ) := by positivity
  have h7 : (dlog g hg (γ * δ) : ℤ) < Fintype.card G := by
    exact_mod_cast dlog_lt g hg (γ * δ)
  have hlt : carry g hg γ δ < 2 := by nlinarith [hc, hn]
  have hgt : -(1 : ℤ) < carry g hg γ δ := by nlinarith [hc, hn, h6, h7]
  omega


/-- **The explicit cyclic 2-cocycle.**  For a generator `g` of a finite cyclic group `G`,
`n = Fintype.card G`, a `NK.HassePrinciple.CoeffInt`-linear representation `A` and `a ∈ A`:

`cycFun A g hg a (γ, δ) = carry(γ, δ) • a`,  with `carry(γ,δ) ∈ {0,1}` as above.

This is exactly the factor system of the crossed product `A ⋊_a G`. -/
def cycFun (A : Rep NK.HassePrinciple.CoeffInt G) (g : G)
    (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (a : A) : G × G → A :=
  fun p => carry g hg p.1 p.2 • a

section Cocycle

variable (A : Rep NK.HassePrinciple.CoeffInt G)

/-- The additive form of the carry identity: the carry is a 2-cocycle on the cyclic group. -/
lemma carry_add_carry (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (g' h j : G) :
    carry g hg (g' * h) j + carry g hg g' h = carry g hg h j + carry g hg g' (h * j) := by
  haveI : NeZero (Fintype.card G) := ⟨(Fintype.card_pos).ne'⟩
  have hn : (Fintype.card G : ℤ) ≠ 0 := by
    exact_mod_cast (Fintype.card_pos (α := G)).ne'
  have h1 := card_mul_carry g hg (g' * h) j
  have h2 := card_mul_carry g hg g' h
  have h3 := card_mul_carry g hg h j
  have h4 := card_mul_carry g hg g' (h * j)
  have hkey : (Fintype.card G : ℤ) * (carry g hg (g' * h) j + carry g hg g' h) =
      (Fintype.card G : ℤ) * (carry g hg h j + carry g hg g' (h * j)) := by
    rw [mul_add, mul_add, h1, h2, h3, h4]
    simp only [mul_assoc]
    ring
  exact mul_left_cancel₀ hn hkey

/-- **The cocycle identity** for the explicit cyclic cocycle, for a `G`-invariant coefficient. -/
lemma cycFun_mem_cocycles₂ (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (a : A)
    (ha : ∀ γ : G, A.ρ γ a = a) :
    cycFun A g hg a ∈ groupCohomology.cocycles₂ A := by
  rw [groupCohomology.mem_cocycles₂_iff]
  intro g' h j
  have hc := carry_add_carry (G := G) g hg g' h j
  show carry g hg (g' * h) j • a + carry g hg g' h • a =
    A.ρ g' (carry g hg h j • a) + carry g hg g' (h * j) • a
  rw [map_zsmul, ha g', ← add_zsmul, ← add_zsmul, hc]

end Cocycle

/-- **The cyclic class** of a `G`-invariant coefficient `a`: the cohomology class of the explicit
cyclic cocycle `cycFun A g hg a`. -/
def cycClass (A : Rep NK.HassePrinciple.CoeffInt G) (g : G)
    (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (a : A) (ha : ∀ γ : G, A.ρ γ a = a) :
    groupCohomology A 2 :=
  (groupCohomology.H2π A) ⟨cycFun A g hg a, cycFun_mem_cocycles₂ A g hg a ha⟩

end

end NK.CFTLib.Descent
