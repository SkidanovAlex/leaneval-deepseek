import Mathlib
import Submission.NK.GlobalCFT.Cohomology
import Submission.NK.GlobalCFT.NormGroup
import Submission.NK.GlobalCFT.H0Computation
import Submission.NK.GlobalCFT.Cohomology.globalCFT_H0Computation_of_invariants_and_norm
import Submission.Commons.RepresentationTheory.GroupCohomology.natCard_nsmul_H2_eq_zero

/-!
# The fundamental class of a cyclic extension of number fields, from an element of order `[L:K]`
in `C_K ⧸ N_{L/K} C_L`

Let `L / K` be a finite Galois extension of number fields with **cyclic** Galois group
`G = Gal(L/K)`, and let `C_K = 𝕀_K ⧸ Kˣ` be the idèle class group.  The two results below supply
the *fundamental class* `H²(G, C_L)` -- an element of order `|G| = [L : K]` -- from an arithmetic
input, namely an element of the quotient `C_K ⧸ N_{L/K} C_L` of order `|G|`:

* `NK.CFTLib.exists_addOrderOf_eq_card_of_cyclic_normClassQuotient` is the target: if
  `x ∈ C_K` satisfies `x ^ k ∈ N_{L/K} C_L ↔ |G| ∣ k`, then `H²(Gal(L/K), C_L)` has an element of
  order `|G|`.

The mathematics is the degree-two **periodicity** of the cohomology of a cyclic group.  Writing
`A = C_L` (a `ℤ[G]`-module) and fixing a generator `g` of `G`, Mathlib's
`Rep.FiniteCyclicGroup.groupCohomologyπEven` identifies

  `H²(G, A) ≅ ker(ρ(g) - 1) / im(N)`,   `N = ∑_{σ ∈ G} ρ(σ)`,

and the hypotheses say exactly that the image of `z` (the class of `x` inside the invariants
`(C_L)^G ≅ C_K`) has order `|G|` in that quotient.  Since `|G|` kills `H²(G, A)` (the classical
`cor ∘ res = |G|` argument, here `natCard_cast_smul_H2_eq_zero`), the class of `z` has order
exactly `|G|`.

The bridge between the arithmetic hypothesis on `x ∈ C_K` and the group-theoretic hypothesis on
`z ∈ C_L` is the `H⁰`-computation of class field theory: the inclusion `ψ : C_K →* C_L` is
injective with image the Galois invariants, and intertwines the idèlic norm with the product of
the conjugates (`NK.GlobalCFT.globalCFT_normClassHom_eq_prod_smul`), so that for `q ∈ C_K`,

  `ψ q ∈ im(∑_σ ρ(σ)) ⟺ q ∈ N_{L/K} C_L`   (`NK.GlobalCFT.Cohomology.ofMul_mem_range_norm_iff`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField RestrictedProduct IsMulCommutative
open CategoryTheory

noncomputable section

namespace NK.CFTLib

/-- **The inclusion of idèle class groups, with its norm and invariance properties.**

For a finite Galois extension `L / K` of number fields there is a homomorphism of idèle class
groups `ψ : C_K →* C_L` (the map induced by the local embeddings of the idèles of `K` into those
of `L`) which is injective, has image exactly the subgroup of classes fixed by `Gal(L/K)`, and
intertwines the idèlic norm `N_{L/K} : C_L → C_K` with the product of the Galois conjugates.

The first two properties are the `H⁰`-computation `C_K = (C_L)^{Gal(L/K)}` of class field theory
(`NK.GlobalCFT.Inclusion.globalCFT_invariants_ideleClassGroup`), the third is the product formula
for the norm (`NK.GlobalCFT.globalCFT_normClassHom_eq_prod_smul`). -/
theorem exists_inclusion_normClassHom_prod (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] :
    ∃ ψ : NK.GlobalCFT.IdeleClassGroup K →* NK.GlobalCFT.IdeleClassGroup L,
      Function.Injective ψ ∧
      (∀ q : NK.GlobalCFT.IdeleClassGroup L,
        (∀ σ : L ≃ₐ[K] L, σ • q = q) ↔ q ∈ ψ.range) ∧
      (∀ q : NK.GlobalCFT.IdeleClassGroup L,
        ψ (NK.GlobalCFT.IdeleClassGroup.normClassHom K L q) = ∏ σ : L ≃ₐ[K] L, σ • q) := by
  classical
  obtain ⟨φ, hφ⟩ := NK.GlobalCFT.Inclusion.globalCFT_ideleInclusion_exists (K := K) (L := L)
    (fun w => Classical.choose
      (NK.GlobalCFT.Inclusion.globalCFT_exists_placeUnder (K := K) (L := L) w))
    (fun w => Classical.choose_spec
      (NK.GlobalCFT.Inclusion.globalCFT_exists_placeUnder (K := K) (L := L) w))
  obtain ⟨ψ, hψ⟩ :=
    NK.GlobalCFT.Inclusion.globalCFT_ideleClassGroup_inclusion_exists (K := K) (L := L) _ _ φ hφ
  refine ⟨ψ, ?_, ?_, ?_⟩
  · exact NK.GlobalCFT.Inclusion.globalCFT_ideleClassGroup_inclusion_injective
      (K := K) (L := L) _ _ φ hφ ψ hψ
  · intro q
    exact NK.GlobalCFT.Inclusion.globalCFT_invariants_ideleClassGroup
      (K := K) (L := L) _ _ φ hφ ψ hψ q
  · intro q
    exact NK.GlobalCFT.globalCFT_normClassHom_eq_prod_smul (K := K) (L := L) _ _ φ hφ ψ hψ q

/-- **Periodicity in degree two: an element of `H²(G, A)` of order `|G|` from an element of
`ker(ρ(g) - 1)` of order `|G|` in `ker(ρ(g) - 1) / im(N)`.**

Let `G` be a finite cyclic group generated by `g`, and let `A` be a `k`-linear representation of
`G` (`k` any commutative ring), with norm map `N = ∑_{σ ∈ G} ρ(σ)`.  If `z ∈ A` is fixed by `g`
and its multiples `n • z` are values of the norm exactly when `|G| ∣ n`, then `H²(G, A)` contains
an element of order exactly `|G|` -- namely the image of `z` under the periodicity isomorphism
`H²(G, A) ≅ ker(ρ(g) - 1) / im(N)` (Mathlib's `Rep.FiniteCyclicGroup.groupCohomologyπEven`).

Indeed `|G| • H²(G, A) = 0` (`natCard_cast_smul_H2_eq_zero`), while `n • π z = 0` forces
`n • z ∈ im(N)`, hence `|G| ∣ n`. -/
theorem exists_addOrderOf_eq_card_of_cyclic_of_norm {G : Type} [Group G] [Fintype G] [IsCyclic G]
    {k : Type} [CommRing k] (A : Rep k G) (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (z : A)
    (hz : A.ρ g z = z)
    (h : ∀ n : ℕ, n • z ∈ LinearMap.range (A.ρ.norm) ↔ Nat.card G ∣ n) :
    ∃ α : groupCohomology A 2, addOrderOf α = Nat.card G := by
  classical
  letI : CommGroup G := IsCyclic.commGroup
  -- `z` lies in the kernel of `ρ(g) - 1`
  have hmk : (Rep.Hom.hom (A.applyAsHom g - 𝟙 A)).toLinearMap z = 0 := by
    have h1 : Rep.Hom.hom (A.applyAsHom g - 𝟙 A)
        = Rep.Hom.hom (A.applyAsHom g) - Rep.Hom.hom (𝟙 A) := rfl
    rw [h1]
    show (Rep.Hom.hom (A.applyAsHom g) - Rep.Hom.hom (𝟙 A)).toLinearMap z = 0
    rw [Representation.IntertwiningMap.sub_toLinearMap, LinearMap.sub_apply]
    change (Rep.Hom.hom (A.applyAsHom g)) z - (Rep.Hom.hom (𝟙 A)) z = 0
    rw [Rep.applyAsHom_apply, Rep.hom_id, Representation.IntertwiningMap.id_apply, hz, sub_self]
  let u : LinearMap.ker (Rep.Hom.hom (A.applyAsHom g - 𝟙 A)).toLinearMap :=
    ⟨z, LinearMap.mem_ker.mpr hmk⟩
  -- the periodicity quotient map, in degree two
  let π := Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num)
  refine ⟨π u, ?_⟩
  -- the order divides `|G|`
  have hdvd : addOrderOf (π u) ∣ Nat.card G := by
    refine addOrderOf_dvd_iff_nsmul_eq_zero.mpr ?_
    rw [← Nat.cast_smul_eq_nsmul k (Nat.card G) (π u)]
    exact Commons.RepresentationTheory.GroupCohomology.natCard_cast_smul_H2_eq_zero A (π u)
  -- and conversely `|G|` divides the order
  have hkill : ∀ n : ℕ, n • (π u) = 0 → Nat.card G ∣ n := by
    intro n hn
    have hn0 : π (n • u) = 0 := by
      rw [show π (n • u) = n • π u from map_nsmul (ConcreteCategory.hom π) n u, hn]
    rw [Rep.FiniteCyclicGroup.groupCohomologyπEven_eq_zero_iff] at hn0
    have hn1 : (n • u).1 = n • z := rfl
    rw [hn1] at hn0
    rw [show LinearMap.range (Rep.norm A).hom.toLinearMap = LinearMap.range A.ρ.norm from by
      congr 1] at hn0
    exact (h n).mp hn0
  exact Nat.dvd_antisymm hdvd (hkill (addOrderOf (π u)) (addOrderOf_nsmul_eq_zero (π u)))

/-- **The fundamental class of a cyclic extension from an element of the norm quotient.**

For a finite Galois extension `L / K` with cyclic Galois group and `x ∈ C_K` whose image in the
norm quotient `C_K ⧸ N_{L/K} C_L` has order `[L : K]` (expressed by
`x ^ k ∈ N_{L/K} C_L ↔ [L : K] ∣ k`), the second cohomology `H²(Gal(L/K), C_L)` contains an
element of order `[L : K]`. -/
theorem exists_addOrderOf_eq_card_of_cyclic_normClassQuotient
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    (x : NK.GlobalCFT.IdeleClassGroup K)
    (hx : ∀ k : ℕ, x ^ k ∈ NK.GlobalCFT.Idele.normClassSubgroup K L ↔
      Nat.card (L ≃ₐ[K] L) ∣ k) :
    ∃ α : groupCohomology (NK.GlobalCFT.IdeleClassGroup.rep K L) 2,
      addOrderOf α = Nat.card (L ≃ₐ[K] L) := by
  classical
  letI : CommGroup (L ≃ₐ[K] L) := IsCyclic.commGroup
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := L ≃ₐ[K] L)
  -- the `H⁰`-computation: `C_K` is the Galois invariants of `C_L`, and `ψ` intertwines the norm
  obtain ⟨ψ, hinj, hinv, hnorm⟩ := exists_inclusion_normClassHom_prod K L
  have hfx : g • (ψ x) = ψ x := (hinv (ψ x)).mpr ⟨x, rfl⟩ g
  let z : (NK.GlobalCFT.IdeleClassGroup.rep K L).V := Additive.ofMul (ψ x)
  have hz : (NK.GlobalCFT.IdeleClassGroup.rep K L).ρ g z = z := by
    have h1 : (NK.GlobalCFT.IdeleClassGroup.rep K L).ρ g z = Additive.ofMul (g • (ψ x)) := rfl
    rw [h1]
    exact congrArg Additive.ofMul hfx
  refine exists_addOrderOf_eq_card_of_cyclic_of_norm (k := ℤ)
    (NK.GlobalCFT.IdeleClassGroup.rep K L) g hg z hz ?_
  -- the arithmetic hypothesis, transported along the `H⁰`-computation
  intro n
  have hk : n • z = Additive.ofMul (ψ (x ^ n)) := by
    rw [show z = Additive.ofMul (ψ x) from rfl]
    exact (ofMul_pow n (ψ x)).symm.trans (congrArg Additive.ofMul (map_pow ψ x n).symm)
  rw [hk]
  exact (NK.GlobalCFT.Cohomology.ofMul_mem_range_norm_iff ψ hinj hnorm (x ^ n)).trans (hx n)

end NK.CFTLib
