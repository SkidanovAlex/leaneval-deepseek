/-!
# The kernel containment for subextensions of cyclotomic extensions

Let `M ⊆ E' = k'(ζ_n)` be an intermediate field with `M/k'` finite abelian (e.g. cyclic) of number
fields, let `n ∣ m`, and let the prime divisors of `(m)` contain all the primes ramified in `M/k'`.
Then the ideal-theoretic Artin symbol of `M/k'` satisfies

`ker Ψ ∩ I(m) ⊆ P(m)·𝔑(m)`,

i.e. every fractional ideal `A` coprime to `(m)` whose Artin symbol is trivial lies in the subgroup
generated by the principal ray `P(m) = principalRay k' m` (the principal ideals `(b)` with
`b ≡ 1 mod* m`, totally positive) and the norm ray `𝔑(m) = normRay k' M m` (the relative norms of
ideals of `M` coprime to `(m)`).  This is Lang, *Algebraic Number Theory*, Ch. X §2, Theorem 2 in
the case that the extension is contained in a cyclotomic one.

The three ingredients:

* **norms are killed** — `NK.CFTLib.ArtinReciprocityIdeal.normRayLeKer` (Lang X §2, property A4);
* **the principal ray is killed** — the cyclotomic base case
  `NK.CFTLib.ARL.artinReciprocity_cyclotomic` for `k'(ζ_n)/k'`, transferred to `M/k'` by
  consistency of Frobenius elements (`NK.CFTLib.exists_isFrobAtPrime_restrict`), and extended
  from integral generators to arbitrary fractional generators by
  `NK.CFTLib.Arl.artinSym_spanSingleton_eq_one_of_congr_pos`;
* **the index inequality** `[I(m) : P(m)𝔑(m)] ≤ [M : k']` (the second inequality of class field
  theory in ideal form) — `NK.CFTLib.ArtinReciprocityIdeal.indexPrincipalRaySupNormRayLe`.

The Artin symbol on `I(m)` is surjective onto `Gal(M/k')`
(`NK.CFTLib.ArtinReciprocityIdeal.artinSymSurjectiveOnCoprime`, from the fact that the Frobenius
elements at the primes not dividing `(m)` generate the Galois group), so `Ψ` induces a bijection
`I(m) ⧸ (ker Ψ ∩ I(m)) ≅ Gal(M/k')` and hence `[I(m) : ker Ψ ∩ I(m)] = [M : k']`.  The index of
`P(m)·𝔑(m)` in `I(m)` is at most `[M : k']` (the second inequality of class field theory in ideal
form, `NK.CFTLib.ArtinReciprocityIdeal.indexPrincipalRaySupNormRayLe`) and is finite: the
idèle–ideal dictionary identifies the quotient `I(m) ⧸ P(m)𝔑(m)` with the quotient of the idèle
class group `C_{k'}` by `Kˣ·N_{M/k'}𝕀_M`
(`NK.GlobalCFTdeep.normClassSubgroup_index_ne_zero`).  Since the two subgroups `ker Ψ ∩ I(m)` and
`P(m)𝔑(m) ∩ I(m)` of `I(m)` are nested and have equal finite index, they are equal, which is the
assertion. -/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open NK.Chebotarev
open NumberField
open scoped NumberField IsMulCommutative nonZeroDivisors

namespace NK.CFTLib.ArtinReciprocityIdeal

section CyclotomicAmbient

variable {k' E' : Type} [Field k'] [NumberField k'] [Field E'] [NumberField E']
  [Algebra k' E'] [FiniteDimensional k' E'] [IsGalois k' E']
  (M : IntermediateField k' E') [FiniteDimensional k' M] [NumberField ↥M] [IsGalois k' ↥M]
  [IsMulCommutative (Gal(↥M/k'))]

/-- **The ramification hypothesis in the form of the ramification index of the extension.**
If every prime ramified in `M/k'` divides `(m)`, then every prime `p` not dividing `(m)` has
ramification index one in `M/k'`. -/
theorem cyclotomicKernelLe_ramificationIdxIn_eq_one {m : ℕ}
    (hram : ∀ p : PrimeIdeal k', ¬ IsUnramified (K := k') (L := ↥M) p →
      (m : 𝓞 k') ∈ p.asIdeal) {p : PrimeIdeal k'} (hp : (m : 𝓞 k') ∉ p.asIdeal) :
    p.asIdeal.ramificationIdxIn (𝓞 ↥M) = 1 := by
  have hunr : IsUnramified (K := k') (L := ↥M) p := by
    by_contra h
    exact hp (hram p h)
  obtain ⟨P, hP⟩ := exists_primeIdeal_liesOver (K := k') (L := ↥M) p
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.LiesOver p.asIdeal := hP
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 k') (B := 𝓞 ↥M)
    p.asIdeal P.asIdeal (Gal(↥M/k'))]
  exact hunr P hP

/-- **The product condition for subextensions of a cyclotomic extension.**
Let `M ⊆ E' = k'(ζ_n)` and `n ∣ m`.  If every prime ramified in `M/k'` divides `(m)`, then the
ideal-theoretic Artin symbol of `M/k'` kills every principal ideal `(a)` with `a ∈ 𝓞 k'`,
`a ≡ 1 mod (m)` and `a` totally positive, for any choice of Frobenius elements.

The proof restricts the cyclotomic base case
(`NK.CFTLib.ARL.artinReciprocity_cyclotomic` for `k'(ζ_n)/k'`, applied at the modulus `n`, which
divides `m`) along the restriction homomorphism `Gal(E'/k') →* Gal(M/k')`: at a prime `p` in the
factorisation of `(a)` (so `p ∤ (m)`, hence `p ∤ (n)`) a Frobenius element of `E'/k'` restricts to
a Frobenius element of the abelian extension `M/k'`
(`NK.CFTLib.exists_isFrobAtPrime_restrict`), where Frobenius elements are unique. -/
theorem cyclotomicKernelLe_artinKillsPrincipal (n : ℕ) [NeZero n]
    [IsCyclotomicExtension {n} k' E'] (m : ℕ) (hn : n ∣ m)
    (hram : ∀ p : PrimeIdeal k', ¬ IsUnramified (K := k') (L := ↥M) p →
      (m : 𝓞 k') ∈ p.asIdeal) :
    NK.CFTLib.artinKillsPrincipal k' ↥M m := by
  intro a ha hpos s e σ hs hfac hfrob
  -- the modulus `n` divides `m`
  obtain ⟨c, hc⟩ : ∃ c : 𝓞 k', (m : 𝓞 k') = (n : 𝓞 k') * c := by
    obtain ⟨d, hd⟩ := hn
    exact ⟨(d : 𝓞 k'), by push_cast [hd]; ring⟩
  have hspan : Ideal.span {(m : 𝓞 k')} ≤ Ideal.span {(n : 𝓞 k')} :=
    Ideal.span_singleton_le_span_singleton.mpr ⟨c, hc⟩
  have hs' : ∀ p ∈ s, (n : 𝓞 k') ∉ p.asIdeal := by
    intro p hp hmem
    exact hs p hp (by rw [hc]; exact Ideal.mul_mem_right _ _ hmem)
  -- a Frobenius element of the ambient cyclotomic extension at every prime
  let τ : PrimeIdeal k' → Gal(E'/k') := fun p =>
    Classical.choose (exists_isFrobAtPrime (K := k') (L := E') p)
  have hτ : ∀ p : PrimeIdeal k', IsFrobAtPrime (K := k') (L := E') p (τ p) := fun p =>
    Classical.choose_spec (exists_isFrobAtPrime (K := k') (L := E') p)
  -- the cyclotomic base case for `k'(ζ_n)/k'`
  have hbase := NK.CFTLib.ARL.artinReciprocity_cyclotomic k' E' n a (hspan ha) hpos s e τ hs'
    hfac (fun p _ => hτ p)
  -- the primes of `s` are unramified in `M/k'`
  have hunr : ∀ p ∈ s, IsUnramified (K := k') (L := ↥M) p := by
    intro p hp
    by_contra h
    exact hs p hp (hram p h)
  -- the restriction of `τ p` is `σ p`
  have hcomm : ∀ x y : Gal(↥M/k'), x * y = y * x :=
    fun x y => IsMulCommutative.is_comm.comm x y
  have hres : ∀ p ∈ s, AlgEquiv.restrictNormalHom (F := k') (K₁ := E') M (τ p) = σ p := by
    intro p hp
    obtain ⟨ρ, -, huniq⟩ := ExistsUniqueIsFrobAtPrime (K := k') (L := ↥M) hcomm p (hunr p hp)
    rw [huniq _ (exists_isFrobAtPrime_restrict (K := k') (L := E') M (hτ p)),
      huniq _ (hfrob p hp)]
  have hmap : (s.toList.map fun p =>
        (AlgEquiv.restrictNormalHom (F := k') (K₁ := E') M (τ p)) ^ e p).prod
      = AlgEquiv.restrictNormalHom (F := k') (K₁ := E') M
          (s.toList.map (fun p => τ p ^ e p)).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    exact List.map_congr_left (fun p _ => by rw [Function.comp_apply, map_pow])
  calc (s.toList.map (fun p => σ p ^ e p)).prod
      = (s.toList.map fun p =>
          (AlgEquiv.restrictNormalHom (F := k') (K₁ := E') M (τ p)) ^ e p).prod :=
        congrArg List.prod (List.map_congr_left (fun p hp => by
          rw [hres p (Finset.mem_toList.mp hp)]))
    _ = AlgEquiv.restrictNormalHom (F := k') (K₁ := E') M
          (s.toList.map (fun p => τ p ^ e p)).prod := hmap
    _ = 1 := by rw [hbase, map_one]

/-- **The principal ray is killed by the Artin symbol** (the cyclotomic case).
If `M ⊆ E' = k'(ζ_n)`, `n ∣ m`, and every prime ramified in `M/k'` divides `(m)`, then
`P(m) = principalRay k' m` lies in the kernel of the Artin symbol of `M/k'`. -/
theorem cyclotomicKernelLe_principalRay_le_ker (n : ℕ) [NeZero n]
    [IsCyclotomicExtension {n} k' E'] (m : ℕ) (hm : 0 < m) (hn : n ∣ m)
    (hram : ∀ p : PrimeIdeal k', ¬ IsUnramified (K := k') (L := ↥M) p →
      (m : 𝓞 k') ∈ p.asIdeal) :
    principalRay k' m ≤ (artinSymFracHom (K := k') (L := ↥M)
      (fun a b : Gal(↥M/k') => IsMulCommutative.is_comm.comm a b)).ker := by
  have hcomm : ∀ a b : Gal(↥M/k'), a * b = b * a :=
    fun a b => IsMulCommutative.is_comm.comm a b
  have hprinc := cyclotomicKernelLe_artinKillsPrincipal (k' := k') (E' := E') M n m hn hram
  have hram' : ∀ p : PrimeIdeal k', (m : 𝓞 k') ∉ p.asIdeal →
      p.asIdeal.ramificationIdxIn (𝓞 ↥M) = 1 :=
    fun p hp => cyclotomicKernelLe_ramificationIdxIn_eq_one (k' := k') (E' := E') M hram hp
  rw [principalRay, Subgroup.closure_le]
  rintro A ⟨b, hb, rfl⟩
  show NK.CFTLib.Arl.artinSym hcomm
      ((spanUnit b : Frac k') : FractionalIdeal (𝓞 k')⁰ k') = 1
  have h := NK.CFTLib.Arl.artinSym_spanSingleton_eq_one_of_congr_pos (K := k') (L := ↥M)
    hcomm m hm hram' hprinc b hb.1 hb.2
  simpa only [coe_spanUnit] using h

end CyclotomicAmbient

theorem cyclotomicKernelLe (k' E' : Type) [Field k'] [NumberField k'] [Field E'] [NumberField E']
    [Algebra k' E'] [FiniteDimensional k' E'] [IsGalois k' E'] (n : ℕ) [NeZero n]
    [IsCyclotomicExtension {n} k' E']
    (M : IntermediateField k' E') [FiniteDimensional k' M] [NumberField ↥M] [IsGalois k' ↥M]
    [IsCyclic (Gal(↥M/k'))] [IsMulCommutative (Gal(↥M/k'))]
    (m : ℕ) (hm : 0 < m) (hn : n ∣ m)
    (hadm : NK.CFTLib.ArtinReciprocityIdeal.IsAdmissible k' ↥M m)
    (hram : ∀ p : NK.Chebotarev.PrimeIdeal k',
        ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := k') (L := ↥M) p →
        (m : NumberField.RingOfIntegers k') ∈ p.asIdeal) :
    ∀ A : NK.CFTLib.ArtinReciprocityIdeal.Frac k',
      NK.CFTLib.ArtinReciprocityIdeal.FracCoprime m A →
      NK.CFTLib.Arl.artinSym (K := k') (L := ↥M) IsMulCommutative.is_comm.comm A = 1 →
      A ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay k' m ⊔
          NK.CFTLib.ArtinReciprocityIdeal.normRay k' ↥M m := by
  classical
  let hcomm : ∀ a b : Gal(↥M/k'), a * b = b * a := IsMulCommutative.is_comm.comm
  let f : Frac k' →* Gal(↥M/k') := artinSymFracHom hcomm
  let I : Subgroup (Frac k') := idealCoprimeGroup k' m
  let PN : Subgroup (Frac k') := principalRay k' m ⊔ normRay k' ↥M m
  -- ### `P(m)` and `𝔑(m)` are killed by the Artin symbol
  have hPker : principalRay k' m ≤ f.ker :=
    cyclotomicKernelLe_principalRay_le_ker (k' := k') (E' := E') M n m hm hn hram
  have hNker : normRay k' ↥M m ≤ f.ker := fun A hA => normRayLeKer k' ↥M m hm hram A hA
  have hPNker : PN ≤ f.ker := sup_le hPker hNker
  -- ### the Artin symbol is surjective on `I(m)`, so `[I(m) : ker Ψ] = [M : k']`
  have hmap : I.map f = ⊤ := by
    rw [eq_top_iff]
    intro σ _
    obtain ⟨A, hAσ⟩ := artinSymSurjectiveOnCoprime k' ↥M m hm hram σ
    refine Subgroup.mem_map.mpr ⟨(A : Frac k'), A.2, ?_⟩
    simpa only [f, hcomm, artinSymFracHom_apply] using hAσ
  have hcardI : f.ker.relIndex I = Nat.card (Gal(↥M/k')) := by
    rw [Subgroup.relIndex_ker I f, hmap]
    exact Nat.card_congr (Subgroup.topEquiv (G := Gal(↥M/k'))).toEquiv
  have hIdxKerInf : (f.ker ⊓ I).relIndex I = Module.finrank k' ↥M := by
    rw [Subgroup.inf_relIndex_right f.ker I, hcardI, IsGalois.card_aut_eq_finrank k' ↥M]
  -- ### the index inequality `[I(m) : P(m)·𝔑(m)] ≤ [M : k']`
  have hIdxPNInf : (PN ⊓ I).relIndex I ≤ (f.ker ⊓ I).relIndex I := by
    rw [Subgroup.inf_relIndex_right PN I, Subgroup.inf_relIndex_right f.ker I, hcardI,
      IsGalois.card_aut_eq_finrank k' ↥M]
    exact indexPrincipalRaySupNormRayLe k' ↥M m hm
  -- ### the two subgroups of `I(m)` have the same index
  have hle : PN ⊓ I ≤ f.ker ⊓ I := fun x hx => ⟨hPNker hx.1, hx.2⟩
  -- `P(m)·𝔑(m)` has finite index in `I(m)`: the ideal-theoretic group `I(m)⧸P(m)𝔑(m)` is the
  -- quotient of the idèle class group by `Kˣ·N_{M/k'}𝕀_M` (`theta` of
  -- `indexIdealCoprimeLeNormClassIndex`), whose index is the (nonzero) index of `N C_M`
  have hrelIndex_ne : PN.relIndex I ≠ 0 := by
    have hidx : (NK.GlobalCFT.Idele.principalSubgroup k'
        ⊔ NK.GlobalCFT.Idele.normImage k' ↥M).index
        = (NK.GlobalCFT.Idele.normClassSubgroup k' ↥M).index :=
      index_principalSubgroup_sup_normImage (K := k') (L := ↥M) m
    haveI hfin : (NK.GlobalCFT.Idele.principalSubgroup k'
        ⊔ NK.GlobalCFT.Idele.normImage k' ↥M).FiniteIndex :=
      Subgroup.finiteIndex_iff.mpr (by
        rw [hidx]
        exact NK.GlobalCFTdeep.normClassSubgroup_index_ne_zero)
    haveI hkerfin : (theta k' ↥M m hm).ker.FiniteIndex :=
      Subgroup.finiteIndex_of_le (principalSubgroup_sup_normImage_le_ker (K := k') (L := ↥M) m hm)
    rw [show PN.relIndex I
        = ((rayNorm k' ↥M m).subgroupOf (NK.CFTLib.ARL.Icoprime k' m)).index from by
      show ((principalRay k' m ⊔ normRay k' ↥M m).subgroupOf
          (idealCoprimeGroup k' m)).index
        = ((rayNorm k' ↥M m).subgroupOf (NK.CFTLib.ARL.Icoprime k' m)).index
      rw [principalRay_eq_ARL, normRay_eq_normIdeals, idealCoprimeGroup_eq_Icoprime]
      rfl]
    rw [index_rayNorm_eq_ker_index (K := k') (L := ↥M) m hm]
    exact Subgroup.FiniteIndex.index_ne_zero
  have hEqPN : (PN ⊓ I).relIndex I = (f.ker ⊓ I).relIndex I :=
    le_antisymm hIdxPNInf (Subgroup.relIndex_le_of_le_left hle (by
      rwa [Subgroup.inf_relIndex_right PN I]))
  -- ### hence `ker Ψ ∩ I(m) ⊆ P(m)·𝔑(m) ∩ I(m)`
  have hker_le_PN : f.ker ⊓ I ≤ PN ⊓ I := by
    have h1 : (PN ⊓ I).relIndex (f.ker ⊓ I) = 1 := by
      have hpos : 0 < (f.ker ⊓ I).relIndex I := by
        rw [hIdxKerInf]
        exact Module.finrank_pos
      refine Nat.eq_of_mul_eq_mul_right hpos ?_
      rw [Subgroup.relIndex_mul_relIndex (PN ⊓ I) (f.ker ⊓ I) I hle inf_le_right, hEqPN,
        one_mul]
    exact Subgroup.relIndex_eq_one.mp h1
  -- ### conclusion
  intro A hcop hsym
  have hAI : A ∈ I := (mem_idealCoprimeGroup_iff (K := k') m A).mpr hcop
  have hAker : A ∈ f.ker := hsym
  exact (hker_le_PN ⟨hAker, hAI⟩).1

end NK.CFTLib.ArtinReciprocityIdeal
