import Mathlib
import Submission.NK.CFTLib.ArtinReciprocityIdeal.LangDefs
import Submission.NK.CFTLib.ArtinReciprocityIdeal.frobAtPrime_prod_relNorm_eq_one
import Submission.NK.CFTLib.ArtinReciprocityIdeal.Basic
import Submission.NK.GlobalCFTdeep.SecondInequality.frobeniusGenerateTop_of_notMem
import Submission.NK.CFTLib.Arl.Defs

/-!
# Surjectivity of the Artin symbol on the ideals coprime to the modulus

This module proves `NK.CFTLib.ArtinReciprocityIdeal.artinSymSurjectiveOnCoprime`, the
**surjectivity half of Lang's Chapter X Theorem 1**: for a finite **abelian** extension `L/K` of
number fields and a modulus `m > 0` divisible by all primes ramified in `L/K`, every
`σ : Gal(L/K)` is the Artin symbol `artinSym A` of a fractional ideal `A` coprime to `(m)`
(i.e. an element of `idealCoprimeGroup K m`, Lang's `I(m)`).

The mathematics is the elementary half of class field theory: the Frobenius elements at the primes
`p ∤ (m)` are Artin symbols of prime ideals, and they already generate `Gal(L/K)`
(`NK.GlobalCFTdeep.SecondInequality.frobeniusGenerateTop_of_notMem`, the Čebotarev input); since
`artinSym` is multiplicative, its image on the subgroup generated by the prime ideals not dividing
`(m)` is a subgroup containing all those Frobenius elements, hence is everything.

The only finiteness input needed is that only finitely many primes divide `(m)`.

## Main results

* `NK.CFTLib.ArtinReciprocityIdeal.finite_setOf_mem_span` — finitely many primes divide `(m)`;
* `NK.CFTLib.ArtinReciprocityIdeal.artinSymSurjectiveOnCoprime` — the target.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open NumberField IsDedekindDomain
open scoped NumberField nonZeroDivisors

noncomputable section

namespace NK.CFTLib.ArtinReciprocityIdeal

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L]

/-- The underlying fractional ideal of a unit of the group of fractional ideals is nonzero. -/
lemma frac_val_ne_zero (A : Frac K) : (A : FractionalIdeal (𝓞 K)⁰ K) ≠ 0 := by
  intro h
  have h1 : ((A : Frac K) : FractionalIdeal (𝓞 K)⁰ K) * ↑(A⁻¹) = 1 := by rw [Units.mul_inv]
  rw [h, zero_mul] at h1
  exact one_ne_zero h1.symm

/-- Only finitely many primes of `K` divide the modulus `m > 0`, i.e. contain `(m : 𝓞 K)`. -/
lemma finite_setOf_mem_span (m : ℕ) (hm : 0 < m) :
    {p : NK.Chebotarev.PrimeIdeal K | (m : 𝓞 K) ∈ p.asIdeal}.Finite := by
  have hm0 : (m : 𝓞 K) ≠ 0 := by exact_mod_cast (Nat.pos_iff_ne_zero.mp hm)
  have hspan : Ideal.span {(m : 𝓞 K)} ≠ 0 := by
    intro h
    exact hm0 (Ideal.span_singleton_eq_bot.mp h)
  refine (Ideal.finite_factors (I := Ideal.span {(m : 𝓞 K)}) hspan).subset ?_
  intro p hp
  simp only [Set.mem_ofPred_eq] at hp ⊢
  rw [Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
  exact hp

theorem artinSymSurjectiveOnCoprime (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    [IsMulCommutative (Gal(L/K))] (m : ℕ) (hm : 0 < m)
    (hram : ∀ p : NK.Chebotarev.PrimeIdeal K,
      ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
      (m : NumberField.RingOfIntegers K) ∈ p.asIdeal) :
    ∀ σ : Gal(L/K), ∃ A : NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup K m,
      NK.CFTLib.Arl.artinSym (K := K) (L := L)
        (fun a b : Gal(L/K) => IsMulCommutative.is_comm.comm a b)
        (A : NK.CFTLib.ArtinReciprocityIdeal.Frac K) = σ := by
  classical
  have hcomm : ∀ a b : Gal(L/K), a * b = b * a := fun a b => IsMulCommutative.is_comm.comm a b
  -- ## The finite set of primes dividing the modulus
  have hfin : {p : NK.Chebotarev.PrimeIdeal K | (m : 𝓞 K) ∈ p.asIdeal}.Finite :=
    finite_setOf_mem_span (K := K) m hm
  let T : Finset (NK.Chebotarev.PrimeIdeal K) := hfin.toFinset
  have hTmem : ∀ p : NK.Chebotarev.PrimeIdeal K, p ∈ T ↔ (m : 𝓞 K) ∈ p.asIdeal :=
    fun p => hfin.mem_toFinset
  -- ## The Artin symbol as a homomorphism on the group of fractional ideals
  let φ : Frac K →* Gal(L/K) :=
    { toFun := fun A => NK.CFTLib.Arl.artinSym hcomm (A : FractionalIdeal (𝓞 K)⁰ K)
      map_one' := by
        rw [Units.val_one]
        exact NK.CFTLib.Arl.artinSym_one hcomm
      map_mul' := fun A B => by
        rw [Units.val_mul]
        exact NK.CFTLib.Arl.artinSym_mul hcomm (frac_val_ne_zero A) (frac_val_ne_zero B) }
  -- ## Frobenius elements at the primes outside `T` generate the Galois group
  have hgen := NK.GlobalCFTdeep.SecondInequality.frobeniusGenerateTop_of_notMem
    (K := K) (L := L) T
  -- ... and each of them is the Artin symbol of a prime ideal not dividing `(m)`
  have hSP : {σ : Gal(L/K) | ∃ p : NK.Chebotarev.PrimeIdeal K, p ∉ T ∧
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := L) p σ}
      ⊆ ((idealCoprimeGroup K m).map φ : Set (Gal(L/K))) := by
    rintro σ ⟨p, hpT, hfrob⟩
    have hpT' : (m : 𝓞 K) ∉ p.asIdeal := fun h => hpT ((hTmem p).mpr h)
    have hunr : IsUnramified (K := K) (L := L) p := by
      by_contra h
      exact hpT' (hram p h)
    refine ⟨idealUnit p.asIdeal p.ne_bot, Subgroup.subset_closure ⟨p, hpT', rfl⟩, ?_⟩
    show NK.CFTLib.Arl.artinSym hcomm
      (↑(idealUnit p.asIdeal p.ne_bot) : FractionalIdeal (𝓞 K)⁰ K) = σ
    rw [show (↑(idealUnit p.asIdeal p.ne_bot) : FractionalIdeal (𝓞 K)⁰ K) = ↑p.asIdeal from rfl,
      NK.CFTLib.Arl.artinSym_prime hcomm p]
    exact (NK.Chebotarev.isFrobAtPrime_iff_frobAtPrime_eq hcomm p hunr σ).mp hfrob
  intro σ
  have htop : (⊤ : Subgroup (Gal(L/K))) ≤ (idealCoprimeGroup K m).map φ := by
    rw [← hgen]
    exact (Subgroup.closure_le _).mpr hSP
  obtain ⟨A, hA, hAσ⟩ := Subgroup.mem_map.mp (htop (Subgroup.mem_top σ))
  exact ⟨⟨A, hA⟩, hAσ⟩

end NK.CFTLib.ArtinReciprocityIdeal
