import Mathlib
import Submission.NK.CFTLib.ARL.exists_mod_order_independent
import Submission.NK.CFTLib.ARL.exists_prime_units_order

/-!
# The arithmetic of the auxiliary modulus

For the construction of Artin's auxiliary field we need a modulus `M` together with a rational
prime `ℓ` whose class in `(ZMod M)ˣ` behaves "orthogonally" to the classes of the norms:

  `ℓ ^ u · a ^ v = 1` in `ZMod M`  ⟹  `n ∣ u` and `n ∣ v`   (for each `a = a i`).

The modulus is `M = q₀ · ∏ᵢ mᵢ` where `q₀` is a prime with `n ∣ q₀ - 1`,
`v_p(q₀ - 1) = v_p(n)` for `p ∣ n` (`exists_prime_units_order`) and `n ∣ orderOf (aᵢ : ZMod mᵢ)`
(`exists_mod_order_independent`), the factors being coprime to `q₀` and to all the `aⱼ`; `ℓ` is a
prime congruent to `1` modulo `∏ᵢ mᵢ` and to a generator of the subgroup of order `n` modulo `q₀`
(Chinese remainder theorem plus Dirichlet).

A relation `ℓ^u aᵢ^v = 1` reduces modulo `mᵢ` to `aᵢ^v = 1` (because `ℓ ≡ 1` there), whence
`n ∣ v`; and modulo `q₀` it becomes `τ^u = aᵢ^{-v}` with `τ` of order `n`, and since `n ∣ v`,
`τ^u` lies in the subgroup generated by `aᵢⁿ`, whose order is coprime to `n`; hence `τ^u = 1`
and `n ∣ u`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

namespace NK.CFTLib.ARL

/-- If `y ^ (q - 1) = 1` and `n ∣ q - 1` then `orderOf (y ^ n) ∣ (q - 1) / n`. -/
private lemma orderOf_pow_dvd_div {G : Type*} [Monoid G] {y : G} {q n : ℕ}
    (hy : y ^ (q - 1) = 1) (hnq : n ∣ q - 1) : orderOf (y ^ n) ∣ (q - 1) / n := by
  rw [orderOf_dvd_iff_pow_eq_one, ← pow_mul, Nat.mul_div_cancel' hnq]
  exact hy

/-- The main arithmetic input of the auxiliary-field construction. -/
theorem auxField_arith (n : ℕ) (hn : 0 < n) {ι : Type} [Fintype ι] (a : ι → ℕ)
    (ha : ∀ i, 1 < a i) (T : Finset ℕ) (hT : ∀ p ∈ T, p.Prime) :
    ∃ (M : ℕ) (_ : NeZero M) (ℓ : ℕ), ℓ.Prime ∧
      (∀ p ∈ T, ¬ p ∣ M) ∧ (∀ i, Nat.Coprime (a i) M) ∧ ¬ ℓ ∣ M ∧
      ∀ i (u v : ℕ), ((ℓ : ZMod M)) ^ u * ((a i : ZMod M)) ^ v = 1 → n ∣ u ∧ n ∣ v := by
  classical
  have hn0 : n ≠ 0 := hn.ne'
  -- ## the finite set of primes to avoid
  set B : ℕ := max (T.sup id) (Finset.univ.sup a) with hB
  set S₀ : Finset ℕ := T ∪ (Finset.range (B + 1)).filter Nat.Prime with hS₀
  have hS₀prime : ∀ p ∈ S₀, p.Prime := by
    intro p hp
    rcases Finset.mem_union.mp hp with h | h
    · exact hT p h
    · exact (Finset.mem_filter.mp h).2
  have hTsub : ∀ p ∈ T, p ∈ S₀ := fun p hp => Finset.mem_union_left _ hp
  have ha_sub : ∀ p : ℕ, p.Prime → (∃ i, p ∣ a i) → p ∈ S₀ := by
    intro p hp ⟨i, hpi⟩
    refine Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ?_, hp⟩)
    have h1 : a i ≤ B := le_trans (Finset.le_sup (f := a) (Finset.mem_univ i)) (le_max_right _ _)
    have h2 : p ≤ a i := Nat.le_of_dvd (by have := ha i; omega) hpi
    omega
  -- ## the prime `q₀`
  obtain ⟨q₀, hq₀prime, hq₀gt, hq₀dvd, hq₀val, u, huord⟩ :=
    exists_prime_units_order n (S₀.sup id) hn
  haveI : Fact q₀.Prime := ⟨hq₀prime⟩
  have hq₀notS₀ : q₀ ∉ S₀ := by
    intro h
    have hle : q₀ ≤ S₀.sup id := Finset.le_sup (f := id) h
    omega
  -- ## the moduli `m i`
  have hS' : ∀ p ∈ S₀ ∪ {q₀}, p.Prime := by
    intro p hp
    rcases Finset.mem_union.mp hp with h | h
    · exact hS₀prime p h
    · rw [Finset.mem_singleton] at h
      exact h ▸ hq₀prime
  have hex : ∀ i, ∃ m : ℕ, 0 < m ∧ (∀ p ∈ S₀ ∪ {q₀}, ¬ p ∣ m) ∧
      (∀ p : ℕ, p.Prime → p ∣ m → ¬ p ∣ a i) ∧ n ∣ orderOf ((a i : ZMod m)) := by
    intro i
    obtain ⟨m, b, hmpos, hmS, hma, -, hm1, -, -⟩ :=
      exists_mod_order_independent n (a i) (ha i) hn (S₀ ∪ {q₀}) hS'
    exact ⟨m, hmpos, hmS, hma, hm1⟩
  choose m hm using hex
  have hmpos : ∀ i, 0 < m i := fun i => (hm i).1
  have hmS : ∀ i, ∀ p ∈ S₀ ∪ {q₀}, ¬ p ∣ m i := fun i => (hm i).2.1
  have hmn : ∀ i, n ∣ orderOf ((a i : ZMod (m i))) := fun i => (hm i).2.2.2
  -- ## the modulus `M = q₀ * ∏ m i`
  set P : ℕ := ∏ i, m i with hP
  set M : ℕ := q₀ * P with hM
  have hPpos : 0 < P := Finset.prod_pos (fun i _ => hmpos i)
  have hMpos : 0 < M := by rw [hM]; exact Nat.mul_pos hq₀prime.pos hPpos
  haveI hMne : NeZero M := ⟨hMpos.ne'⟩
  have hmi_dvd_P : ∀ i, m i ∣ P := fun i => Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
  have hmi_dvd_M : ∀ i, m i ∣ M := by
    intro i; rw [hM]; exact dvd_mul_of_dvd_right (hmi_dvd_P i) q₀
  have hq₀_dvd_M : q₀ ∣ M := by rw [hM]; exact dvd_mul_right q₀ P
  have hP_dvd_M : P ∣ M := by rw [hM]; exact dvd_mul_left P q₀
  have hq₀_coprime_m : ∀ i, q₀.Coprime (m i) := by
    refine fun i => (hq₀prime.coprime_iff_not_dvd).mpr (fun hdvd => ?_)
    exact hmS i q₀ (Finset.mem_union_right _ (Finset.mem_singleton_self q₀)) hdvd
  have hq₀_coprime_P : q₀.Coprime P := by
    rw [hP]
    exact Nat.Coprime.prod_right (fun i _ => hq₀_coprime_m i)
  have hM_notT : ∀ p ∈ T, ¬ p ∣ M := by
    intro p hp hdvd
    have hpS : p ∈ S₀ := hTsub p hp
    have hpP : ¬ p ∣ P := by
      intro hpP
      obtain ⟨i, -, hmi⟩ := (Prime.dvd_finsetProd_iff (Nat.prime_iff.mp (hT p hp))
        (fun i => m i)).mp (by rw [← hP]; exact hpP)
      exact hmS i p (Finset.mem_union_left _ hpS) hmi
    rw [hM] at hdvd
    rcases (Nat.Prime.dvd_mul (hT p hp)).mp hdvd with h | h
    · have hpq : p = q₀ := ((hq₀prime.dvd_iff_eq (hT p hp).ne_one).mp h).symm
      rw [hpq] at hpS
      exact hq₀notS₀ hpS
    · exact hpP h
  have ha_coprime_M : ∀ i, Nat.Coprime (a i) M := by
    refine fun i => Nat.coprime_of_dvd (fun p hp hpa hpm => ?_)
    have hpS : p ∈ S₀ := ha_sub p hp ⟨i, hpa⟩
    have hpP : ¬ p ∣ P := by
      intro hpP
      obtain ⟨j, -, hmj⟩ := (Prime.dvd_finsetProd_iff (Nat.prime_iff.mp hp)
        (fun j => m j)).mp (by rw [← hP]; exact hpP)
      exact hmS j p (Finset.mem_union_left _ hpS) hmj
    rw [hM] at hpm
    rcases (Nat.Prime.dvd_mul hp).mp hpm with h | h
    · have hpq : p = q₀ := ((hq₀prime.dvd_iff_eq hp.ne_one).mp h).symm
      rw [hpq] at hpS
      exact hq₀notS₀ hpS
    · exact hpP h
  -- ## the prime `ℓ`
  set τ : ℕ := ((u : (ZMod q₀)ˣ) : ZMod q₀).val with hτ
  have hτ_cast : ((τ : ZMod q₀)) = ((u : (ZMod q₀)ˣ) : ZMod q₀) := ZMod.natCast_zmod_val _
  have hτ_coprime : τ.Coprime q₀ := (ZMod.unitsEquivCoprime u).2
  obtain ⟨k, hkP, hkq⟩ := Nat.chineseRemainder hq₀_coprime_P.symm 1 τ
  have hk_coprime_P : k.Coprime P := by
    refine Nat.coprime_of_dvd (fun p hp hpk hpP => ?_)
    have h1 : k ≡ 1 [MOD p] := hkP.of_dvd hpP
    have h2 : k ≡ 0 [MOD p] := Nat.modEq_zero_iff_dvd.mpr hpk
    have h3 : (1 : ℕ) ≡ 0 [MOD p] := h1.symm.trans h2
    exact hp.not_dvd_one (Nat.modEq_zero_iff_dvd.mp h3)
  have hk_coprime_q₀ : k.Coprime q₀ := by
    refine Nat.coprime_of_dvd (fun p hp hpk hpq => ?_)
    have hpeq : p = q₀ := ((hq₀prime.dvd_iff_eq hp.ne_one).mp hpq).symm
    have hpk' : q₀ ∣ k := hpeq ▸ hpk
    have h1 : k ≡ τ [MOD q₀] := hkq
    have h2 : k ≡ 0 [MOD q₀] := Nat.modEq_zero_iff_dvd.mpr hpk'
    have h3 : τ ≡ 0 [MOD q₀] := h1.symm.trans h2
    exact hq₀prime.ne_one
      (Nat.Coprime.eq_one_of_dvd hτ_coprime.symm (Nat.modEq_zero_iff_dvd.mp h3))
  have hk_coprime_M : k.Coprime M := by
    rw [hM]
    exact hk_coprime_q₀.mul_right hk_coprime_P
  obtain ⟨ℓ, hℓgt, hℓprime, hℓmod⟩ := Nat.forall_exists_prime_gt_and_modEq M hMpos.ne' hk_coprime_M
  have hℓ_not_M : ¬ ℓ ∣ M := by
    intro h; have := Nat.le_of_dvd hMpos h; omega
  have hℓ1P : ℓ ≡ 1 [MOD P] := (hℓmod.of_dvd hP_dvd_M).trans hkP
  have hℓq : ℓ ≡ τ [MOD q₀] := (hℓmod.of_dvd hq₀_dvd_M).trans hkq
  refine ⟨M, hMne, ℓ, hℓprime, hM_notT, ha_coprime_M, hℓ_not_M, ?_⟩
  intro i u₀ v₀ hrel
  -- ## first conclusion: `n ∣ v₀`
  have hv : n ∣ v₀ := by
    have h2 : ((ℓ : ZMod (m i))) ^ u₀ * ((a i : ZMod (m i))) ^ v₀ = 1 := by
      have h := congrArg (ZMod.castHom (hmi_dvd_M i) (ZMod (m i))) hrel
      rw [map_one] at h
      simpa only [map_mul, map_pow, ZMod.castHom_apply, ZMod.cast_natCast (hmi_dvd_M i)] using h
    have hℓ1 : (ℓ : ZMod (m i)) = 1 := by
      have h := (ZMod.natCast_eq_natCast_iff ℓ 1 (m i)).mpr (hℓ1P.of_dvd (hmi_dvd_P i))
      simpa using h
    rw [hℓ1, one_pow, one_mul] at h2
    exact dvd_trans (hmn i) (orderOf_dvd_iff_pow_eq_one.mpr h2)
  refine ⟨?_, hv⟩
  -- ## second conclusion: `n ∣ u₀`
  have h2 : ((ℓ : ZMod q₀)) ^ u₀ * ((a i : ZMod q₀)) ^ v₀ = 1 := by
    have h := congrArg (ZMod.castHom hq₀_dvd_M (ZMod q₀)) hrel
    rw [map_one] at h
    simpa only [map_mul, map_pow, ZMod.castHom_apply, ZMod.cast_natCast hq₀_dvd_M] using h
  have hℓτ : (ℓ : ZMod q₀) = (τ : ZMod q₀) := (ZMod.natCast_eq_natCast_iff ℓ τ q₀).mpr hℓq
  rw [hℓτ, hτ_cast] at h2
  have haq : (a i).Coprime q₀ :=
    ((hq₀prime.coprime_iff_not_dvd).mpr (fun hdvd => hq₀notS₀ (ha_sub q₀ hq₀prime ⟨i, hdvd⟩))).symm
  let ai : (ZMod q₀)ˣ := ZMod.unitOfCoprime (a i) haq
  have hai : ((ai : ZMod q₀)) = (a i : ZMod q₀) := ZMod.coe_unitOfCoprime (a i) haq
  have h3 : ((u : (ZMod q₀)ˣ) : ZMod q₀) ^ u₀ * ((ai : (ZMod q₀)ˣ) : ZMod q₀) ^ v₀ = 1 := by
    rw [hai]
    exact h2
  have h4 : (u : (ZMod q₀)ˣ) ^ u₀ * ai ^ v₀ = 1 := by
    refine Units.ext ?_
    rw [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, Units.val_one]
    exact h3
  have h5 : (u : (ZMod q₀)ˣ) ^ u₀ = (ai⁻¹ ^ n) ^ (v₀ / n) := by
    have hv' : v₀ = n * (v₀ / n) := (Nat.mul_div_cancel' hv).symm
    calc (u : (ZMod q₀)ˣ) ^ u₀
        = (ai ^ v₀)⁻¹ := eq_inv_of_mul_eq_one_left h4
      _ = (ai⁻¹) ^ v₀ := by rw [inv_pow]
      _ = (ai⁻¹) ^ (n * (v₀ / n)) := congrArg (fun k => (ai⁻¹) ^ k) hv'
      _ = (ai⁻¹ ^ n) ^ (v₀ / n) := by rw [pow_mul]
  have hunits : ∀ y : (ZMod q₀)ˣ, y ^ (q₀ - 1) = 1 := by
    intro y
    refine Units.ext ?_
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    refine ZMod.pow_card_sub_one_eq_one (a := ((y : (ZMod q₀)ˣ) : ZMod q₀)) ?_
    intro hzero
    have h1 : (((y * y⁻¹ : (ZMod q₀)ˣ)) : ZMod q₀) = 1 := by rw [mul_inv_cancel, Units.val_one]
    rw [Units.val_mul, hzero, zero_mul] at h1
    exact one_ne_zero h1.symm
  have hdiv1 : orderOf ((u : (ZMod q₀)ˣ) ^ u₀) ∣ n := by
    rw [← huord]; exact orderOf_pow_dvd (x := (u : (ZMod q₀)ˣ)) u₀
  have hdiv2 : orderOf ((u : (ZMod q₀)ˣ) ^ u₀) ∣ orderOf (ai⁻¹ ^ n) := by
    rw [h5]; exact orderOf_pow_dvd (x := ai⁻¹ ^ n) (v₀ / n)
  have hcop : Nat.Coprime n (orderOf (ai⁻¹ ^ n)) := by
    refine Nat.Coprime.coprime_dvd_right (orderOf_pow_dvd_div (hunits ai⁻¹) hq₀dvd) ?_
    exact coprime_div_of_factorization_eq hn0 hq₀prime.two_le hq₀dvd hq₀val
  have h6 : (u : (ZMod q₀)ˣ) ^ u₀ = 1 := by
    have h1 : orderOf ((u : (ZMod q₀)ˣ) ^ u₀) = 1 :=
      Nat.Coprime.eq_one_of_dvd (hcop.coprime_dvd_left hdiv1) hdiv2
    rw [← orderOf_eq_one_iff]; exact h1
  rw [← huord]
  exact orderOf_dvd_iff_pow_eq_one.mpr h6

end NK.CFTLib.ARL
