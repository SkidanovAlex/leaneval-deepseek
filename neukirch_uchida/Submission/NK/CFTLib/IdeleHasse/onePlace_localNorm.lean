import Mathlib
import Submission.NK.GlobalCFT.NormGroup
import Submission.NK.CFTLib.IdeleHasse.localNormSubgroup
import Submission.NK.HassePrinciple.IdeleCocycle

/-!
# The one-place dictionary for idèle norms

For a finite extension `L / K` of number fields and a place `v` of `K`, the idèle which is `a` at
`v` and `1` elsewhere is a norm of idèles if and only if `a` is a local norm:

  `onePlace v a ∈ Idele.normImage K L ↔ a ∈ localNormSubgroup K L v`

(`localNormSubgroup K L v` is the subgroup of `K_vˣ` generated by the images of the local norms
`N_{L_w/K_v}`, `w | v`; see `Submission/Work/CFTLib/IdeleHasse/localNormSubgroup.lean`).

This is the dictionary promised (as `mem_normImage_onePlace`) by the docstring of
`localNormSubgroup.lean`.  The proof is elementary: a norm idèle trivial away from `v` has
component at `v` a *product* of local norms (`normIdeleFun` is the product of the local norms over
the places `w | v`), and conversely a local norm at a single `w | v` is the norm of the idèle
supported at that `w`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped NumberField RestrictedProduct
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.IdeleHasse

open NK.GlobalCFT

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- **`onePlace` is multiplicative in the value.** -/
theorem onePlace_mul (w : Place K) (a b : (Place.localField K w)ˣ) :
    NK.HassePrinciple.onePlace w (a * b) =
      NK.HassePrinciple.onePlace w a * NK.HassePrinciple.onePlace w b := by
  ext v
  by_cases hv : v = w
  · subst hv
    rw [NK.HassePrinciple.onePlace_apply_self, Idele.mul_apply,
      NK.HassePrinciple.onePlace_apply_self, NK.HassePrinciple.onePlace_apply_self]
  · rw [NK.HassePrinciple.onePlace_apply_ne hv, Idele.mul_apply,
      NK.HassePrinciple.onePlace_apply_ne hv, NK.HassePrinciple.onePlace_apply_ne hv, mul_one]

/-- **`onePlace` of the unit idèle is the unit idèle.** -/
theorem onePlace_one (w : Place K) :
    NK.HassePrinciple.onePlace w (1 : (Place.localField K w)ˣ) = 1 := by
  ext v
  by_cases hv : v = w
  · subst hv; rw [NK.HassePrinciple.onePlace_apply_self]; rfl
  · rw [NK.HassePrinciple.onePlace_apply_ne hv]; rfl

/-- **`onePlace` as a monoid homomorphism.** -/
noncomputable def onePlaceHom (w : Place K) : (Place.localField K w)ˣ →* Idele K where
  toFun := NK.HassePrinciple.onePlace w
  map_one' := onePlace_one w
  map_mul' := onePlace_mul w

@[simp] theorem onePlaceHom_apply (w : Place K) (a : (Place.localField K w)ˣ) :
    onePlaceHom w a = NK.HassePrinciple.onePlace w a := rfl

/-- The component at `Q` of the norm idèle of the idèle which is `y` at the finite place `q` of `L`
and `1` elsewhere is the local norm `N_{L_q/K_Q}(y)`. -/
theorem normIdeleFun_onePlace_ofFinite (q : HeightOneSpectrum (𝓞 L))
    (y : (q.adicCompletion L)ˣ) (Q : HeightOneSpectrum (𝓞 K))
    (hq : q.asIdeal.LiesOver Q.asIdeal) :
    Idele.normIdeleFun K L (NK.HassePrinciple.onePlace (Place.ofFinite q) y) (Place.ofFinite Q) =
      Place.localNormFinite q Q hq y := by
  rw [Idele.normIdeleFun_ofFinite]
  have hmem : q ∈ Place.primesOverFinite (K := K) (L := L) Q :=
    (Place.mem_primesOverFinite (K := K) (L := L) (Q := Q) (q := q)).mpr hq
  rw [show (∏ q' ∈ (Place.primesOverFinite (K := K) (L := L) Q).attach,
        Place.localNormFinite q'.1 Q
          ((Place.mem_primesOverFinite (K := K) (L := L) (Q := Q) (q := q'.1)).mp q'.2)
          ((NK.HassePrinciple.onePlace (Place.ofFinite q) y) (Place.ofFinite q'.1)))
      = Place.localNormFinite q Q
          ((Place.mem_primesOverFinite (K := K) (L := L) (Q := Q) (q := q)).mp hmem)
          ((NK.HassePrinciple.onePlace (Place.ofFinite q) y) (Place.ofFinite q)) from
    Finset.prod_eq_single_of_mem ⟨q, hmem⟩ (Finset.mem_attach _ _) (fun b _ hbne => by
      have hbq : Place.ofFinite b.1 ≠ Place.ofFinite q := fun h =>
        hbne (Subtype.ext (Place.ofFinite_inj.mp h))
      rw [NK.HassePrinciple.onePlace_apply_ne hbq, map_one])]
  rw [NK.HassePrinciple.onePlace_apply_self,
    Subsingleton.elim ((Place.mem_primesOverFinite (K := K) (L := L) (Q := Q) (q := q)).mp hmem) hq]

/-- The norm idèle of the single-place idèle at the finite place `q` is trivial at every place of
`K` other than the place `Q` below `q`. -/
theorem normIdeleFun_onePlace_ofFinite_apply_ne (q : HeightOneSpectrum (𝓞 L))
    (y : (q.adicCompletion L)ˣ) {Q : HeightOneSpectrum (𝓞 K)} (hq : q.asIdeal.LiesOver Q.asIdeal)
    {v : Place K} (hv : v ≠ Place.ofFinite Q) :
    Idele.normIdeleFun K L (NK.HassePrinciple.onePlace (Place.ofFinite q) y) v = 1 := by
  match v with
  | Sum.inl w =>
      rw [Idele.normIdeleFun_ofInfinite]
      refine Finset.prod_eq_one fun w' _ => ?_
      have hcomp : (NK.HassePrinciple.onePlace (Place.ofFinite q) y) (Place.ofInfinite w'.1) = 1 := by
        rw [NK.HassePrinciple.onePlace_apply_ne]
        simp
      rw [hcomp, map_one]
  | Sum.inr Q' =>
      rw [Idele.normIdeleFun_ofFinite]
      refine Finset.prod_eq_one fun q' _ => ?_
      have hqq' : q' ≠ q := by
        intro h
        haveI : q.asIdeal.LiesOver Q'.asIdeal := h ▸ (Place.mem_primesOverFinite (K := K) (L := L)
          (Q := Q') (q := q')).mp q'.2
        have hieq : Q'.asIdeal = Q.asIdeal := by
          rw [Ideal.LiesOver.over (P := q.asIdeal) (p := Q'.asIdeal),
            Ideal.LiesOver.over (P := q.asIdeal) (p := Q.asIdeal)]
        exact hv (by rw [IsDedekindDomain.HeightOneSpectrum.ext hieq])
      have hcomp : (NK.HassePrinciple.onePlace (Place.ofFinite q) y) (Place.ofFinite q') = 1 := by
        rw [NK.HassePrinciple.onePlace_apply_ne]
        intro h
        exact hqq' (Place.ofFinite_inj.mp h)
      rw [hcomp, map_one]

/-! ## The archimedean case -/

/-- The component at `w` of the norm idèle of the idèle which is `y` at the infinite place `w'`
of `L` and `1` elsewhere is the local norm `N_{L_{w'}/K_w}(y)`. -/
theorem normIdeleFun_onePlace_ofInfinite (w' : InfinitePlace L) (y : w'.Completionˣ)
    (w : InfinitePlace K) (hw : w'.LiesOver w) :
    Idele.normIdeleFun K L (NK.HassePrinciple.onePlace (Place.ofInfinite w') y)
        (Place.ofInfinite w) =
      letI : w'.LiesOver w := hw
      Place.localNormInfinite w' w y := by
  rw [Idele.normIdeleFun_ofInfinite]
  have hmem : w' ∈ Place.fiberInfinite (K := K) (L := L) w :=
    (Place.mem_fiberInfinite (K := K) (L := L) (v := w) (w := w')).mpr hw
  rw [show (∏ w'' ∈ (Place.fiberInfinite (K := K) (L := L) w).attach,
        letI : (w''.1 : InfinitePlace L).LiesOver w :=
          (Place.mem_fiberInfinite (K := K) (L := L) (v := w) (w := w''.1)).mp w''.2
        Place.localNormInfinite w''.1 w
          ((NK.HassePrinciple.onePlace (Place.ofInfinite w') y) (Place.ofInfinite w''.1)))
      = (letI : w'.LiesOver w := hw; Place.localNormInfinite w' w
          ((NK.HassePrinciple.onePlace (Place.ofInfinite w') y) (Place.ofInfinite w'))) from
    Finset.prod_eq_single_of_mem ⟨w', hmem⟩ (Finset.mem_attach _ _) (fun b _ hbne => by
      have hbw : Place.ofInfinite b.1 ≠ Place.ofInfinite w' := fun h =>
        hbne (Subtype.ext (Place.ofInfinite_inj.mp h))
      rw [NK.HassePrinciple.onePlace_apply_ne hbw, map_one])]
  rw [NK.HassePrinciple.onePlace_apply_self]

/-- The norm idèle of the single-place idèle at the infinite place `w'` is trivial at every place
of `K` other than the place `w` below `w'`. -/
theorem normIdeleFun_onePlace_ofInfinite_apply_ne (w' : InfinitePlace L) (y : w'.Completionˣ)
    {w : InfinitePlace K} (hw : w'.LiesOver w) {v : Place K} (hv : v ≠ Place.ofInfinite w) :
    Idele.normIdeleFun K L (NK.HassePrinciple.onePlace (Place.ofInfinite w') y) v = 1 := by
  match v with
  | Sum.inl w'' =>
      rw [Idele.normIdeleFun_ofInfinite]
      refine Finset.prod_eq_one fun w₀ _ => ?_
      have hcomp : (NK.HassePrinciple.onePlace (Place.ofInfinite w') y)
          (Place.ofInfinite w₀.1) = 1 := by
        rw [NK.HassePrinciple.onePlace_apply_ne]
        intro h
        haveI hwLies'' : w'.LiesOver w'' := by
          have hw_eq : w₀.1 = w' := Place.ofInfinite_inj.mp h
          rw [← hw_eq]
          exact (Place.mem_fiberInfinite (K := K) (L := L) (v := w'') (w := w₀.1)).mp w₀.2
        haveI hwLies : w'.LiesOver w := hw
        have hcongr : w'' = w := by
          have hh : w''.1 = w.1 := by
            rw [← AbsoluteValue.LiesOver.comp_eq (w := w'.1) (v := w''.1),
              ← AbsoluteValue.LiesOver.comp_eq (w := w'.1) (v := w.1)]
          exact NumberField.InfinitePlace.ext w'' w
            (fun k => congrArg (fun (v : AbsoluteValue K ℝ) => v k) hh)
        exact hv (by rw [hcongr])
      rw [hcomp, map_one]
  | Sum.inr Q =>
      rw [Idele.normIdeleFun_ofFinite]
      refine Finset.prod_eq_one fun q' _ => ?_
      have hcomp : (NK.HassePrinciple.onePlace (Place.ofInfinite w') y)
          (Place.ofFinite q'.1) = 1 := by
        rw [NK.HassePrinciple.onePlace_apply_ne]
        simp
      rw [hcomp, map_one]

/-! ## The dictionary -/

/-- **The one-place dictionary at an infinite place.** -/
theorem onePlace_ofInfinite_mem_normImage_iff (w : InfinitePlace K)
    (a : (Place.localField K (Place.ofInfinite w))ˣ) :
    NK.HassePrinciple.onePlace (Place.ofInfinite w) a ∈ Idele.normImage K L ↔
      a ∈ localNormSubgroup (K := K) (L := L) (Place.ofInfinite w) := by
  constructor
  · intro h
    obtain ⟨y, hy⟩ := (Idele.mem_normImage (K := K) (L := L)).mp h
    rw [localNormSubgroup_ofInfinite (K := K) (L := L)]
    have hval := hy (Place.ofInfinite w)
    rw [NK.HassePrinciple.onePlace_apply_self, Idele.normIdeleFun_ofInfinite] at hval
    rw [hval]
    refine Subgroup.prod_mem _ fun w' _ => ?_
    exact Subgroup.mem_iSup_of_mem
      ⟨w'.1, (Place.mem_fiberInfinite (K := K) (L := L) (v := w) (w := w'.1)).mp w'.2⟩
      (MonoidHom.mem_range.mpr ⟨_, rfl⟩)
  · intro ha
    rw [localNormSubgroup_ofInfinite (K := K) (L := L)] at ha
    let φ : (Place.localField K (Place.ofInfinite w))ˣ →* Idele K := onePlaceHom (Place.ofInfinite w)
    have hle : (⨆ (w' : {w' : InfinitePlace L // w'.LiesOver w}),
        MonoidHom.range (@Place.localNormInfinite K _ L _ _ w'.1 w w'.2)) ≤
          (Idele.normImage K L).comap φ := by
      refine iSup_le_iff.mpr fun w' => ?_
      rintro - ⟨y, rfl⟩
      show NK.HassePrinciple.onePlace (Place.ofInfinite w)
        (@Place.localNormInfinite K _ L _ _ w'.1 w w'.2 y) ∈ Idele.normImage K L
      rw [← normIdeleFun_onePlace_ofInfinite (K := K) (L := L) w'.1 y w w'.2]
      refine (Idele.mem_normImage (K := K) (L := L)).mpr
        ⟨NK.HassePrinciple.onePlace (Place.ofInfinite w'.1) y, fun v => ?_⟩
      by_cases hv : v = Place.ofInfinite w
      · rw [hv, NK.HassePrinciple.onePlace_apply_self]
      · rw [NK.HassePrinciple.onePlace_apply_ne hv]
        exact (normIdeleFun_onePlace_ofInfinite_apply_ne (K := K) (L := L) w'.1 y w'.2 hv).symm
    exact hle ha

/-- **The one-place dictionary at a finite place.** -/
theorem onePlace_ofFinite_mem_normImage_iff (Q : HeightOneSpectrum (𝓞 K))
    (a : (Place.localField K (Place.ofFinite Q))ˣ) :
    NK.HassePrinciple.onePlace (Place.ofFinite Q) a ∈ Idele.normImage K L ↔
      a ∈ localNormSubgroup (K := K) (L := L) (Place.ofFinite Q) := by
  constructor
  · intro h
    obtain ⟨y, hy⟩ := (Idele.mem_normImage (K := K) (L := L)).mp h
    rw [localNormSubgroup_ofFinite (K := K) (L := L)]
    have hval := hy (Place.ofFinite Q)
    rw [NK.HassePrinciple.onePlace_apply_self, Idele.normIdeleFun_ofFinite] at hval
    rw [hval]
    refine Subgroup.prod_mem _ fun q' _ => ?_
    exact Subgroup.mem_iSup_of_mem
      ⟨q'.1, (Place.mem_primesOverFinite (K := K) (L := L) (Q := Q) (q := q'.1)).mp q'.2⟩
      (MonoidHom.mem_range.mpr ⟨_, rfl⟩)
  · intro ha
    rw [localNormSubgroup_ofFinite (K := K) (L := L)] at ha
    let φ : (Place.localField K (Place.ofFinite Q))ˣ →* Idele K := onePlaceHom (Place.ofFinite Q)
    have hle : (⨆ (q : {q : HeightOneSpectrum (𝓞 L) // q.asIdeal.LiesOver Q.asIdeal}),
        MonoidHom.range (Place.localNormFinite q.1 Q q.2)) ≤ (Idele.normImage K L).comap φ := by
      refine iSup_le_iff.mpr fun q' => ?_
      rintro - ⟨y, rfl⟩
      show NK.HassePrinciple.onePlace (Place.ofFinite Q) (Place.localNormFinite q'.1 Q q'.2 y)
        ∈ Idele.normImage K L
      rw [← normIdeleFun_onePlace_ofFinite (K := K) (L := L) q'.1 y Q q'.2]
      refine (Idele.mem_normImage (K := K) (L := L)).mpr
        ⟨NK.HassePrinciple.onePlace (Place.ofFinite q'.1) y, fun v => ?_⟩
      by_cases hv : v = Place.ofFinite Q
      · rw [hv, NK.HassePrinciple.onePlace_apply_self]
      · rw [NK.HassePrinciple.onePlace_apply_ne hv]
        exact (normIdeleFun_onePlace_ofFinite_apply_ne (K := K) (L := L) q'.1 y q'.2 hv).symm
    exact hle ha

/-- **The one-place dictionary for idèle norms.**  The idèle which is `a` at the place `v` and `1`
elsewhere is a norm of idèles if and only if `a` is a local norm. -/
theorem onePlace_mem_normImage_iff (v : Place K) (a : (Place.localField K v)ˣ) :
    NK.HassePrinciple.onePlace v a ∈ Idele.normImage K L ↔
      a ∈ localNormSubgroup (K := K) (L := L) v := by
  match v with
  | Sum.inl w => exact onePlace_ofInfinite_mem_normImage_iff (K := K) (L := L) w a
  | Sum.inr Q => exact onePlace_ofFinite_mem_normImage_iff (K := K) (L := L) Q a

end NK.CFTLib.IdeleHasse
