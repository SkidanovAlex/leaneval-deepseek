/-!
# The Frobenius-avoidance statement of Proposition 4f.3, at primes away from `ℓ`

This file proves the form of Shimizu's Proposition 4f.3 in which the escaping prime is required to
have *rational prime below it different from `ℓ`* — the form needed when the Frobenius element is
used through its well definedness in the torsion-free quotient `Γ_K^{tf}`
(`NK.Reconstruct.frobUniquenessAwayFromL`).

The mathematical input beyond Čebotarev is the ramification of `ℓ` in the cyclotomic field
`ℚ(ζ_{ℓ²})`: this is why the *normal closure of the level enlarged by `ℚ(ζ_{ℓ²})`* has no prime of
ramification index one over `ℓ` (Mathlib's `IsCyclotomicExtension.Rat.ramificationIdx_eq_of_prime_pow`).
-/

/-- **The contraction of the principal ideal generated by `n` in `𝓞 ℚ` to `ℤ`.**  The canonical map
`ℤ → 𝓞 ℚ` is surjective (`Rat.int_algebraMap_surjective`), so contraced principal ideals are
principal. -/
theorem comap_span_ringOfIntegersRat (n : ℕ) :
    (Ideal.span {(n : NumberField.RingOfIntegers ℚ)}).comap
        (algebraMap ℤ (NumberField.RingOfIntegers ℚ)) = Ideal.span {(n : ℤ)} := by
  refine le_antisymm ?_ ?_
  · intro x hx
    rw [Ideal.mem_comap] at hx
    rw [Ideal.mem_span_singleton] at hx
    obtain ⟨c, hc⟩ := hx
    obtain ⟨z, rfl⟩ := Rat.int_algebraMap_surjective (NumberField.RingOfIntegers ℚ) c
    rw [Ideal.mem_span_singleton]
    refine ⟨z, ?_⟩
    have hinj := Rat.int_algebraMap_injective (NumberField.RingOfIntegers ℚ)
    apply hinj
    rw [map_mul, map_natCast, hc]
  · intro x hx
    rw [Ideal.mem_comap]
    rw [Ideal.mem_span_singleton] at hx ⊢
    obtain ⟨c, hc⟩ := hx
    refine ⟨algebraMap ℤ (NumberField.RingOfIntegers ℚ) c, ?_⟩
    rw [hc, map_mul, map_natCast]

/-- **`ℓ` is ramified at every prime of a number field containing `ℚ(ζ_{ℓ²})`.**  If `M` is a
finite Galois level of `Ω/ℚ` containing the ℚ-adjoin of a primitive `ℓ ^ 2`-th root of unity, then
no prime `P` of `𝓞 M` lying over the prime `(ℓ)` of `ℤ` has ramification index one.

Indeed the contraction `Q'` of `P` to `𝓞 ℚ(ζ)` has ramification index `ℓ (ℓ - 1) ≠ 1` over `ℤ`
(Mathlib's computation of the ramification index of the prime `p` in `ℚ(ζ_{p ^ (k+1)})`), and
`ramificationIdx_below_dvd` divides that index into `P`'s. -/
theorem ramificationIdx_int_ne_one_of_le_adjoin_primitiveRoot {Ω : Type*} [Field Ω] [Algebra ℚ Ω]
    [IsSepClosure ℚ Ω] (ℓ : ℕ) [Fact ℓ.Prime] {ζ : Ω} (hζ : IsPrimitiveRoot ζ (ℓ ^ 2))
    (M : IntermediateField ℚ Ω) [FiniteDimensional ℚ M] [NumberField ↥M]
    (hQM : IntermediateField.adjoin ℚ ({ζ} : Set Ω) ≤ M)
    (P : Ideal (NumberField.RingOfIntegers ↥M)) [P.IsPrime]
    (hP : P.LiesOver (Ideal.span {(ℓ : ℤ)})) :
    P.ramificationIdx ℤ ≠ 1 := by
  let Q : IntermediateField ℚ Ω := IntermediateField.adjoin ℚ ({ζ} : Set Ω)
  have hQle : Q.toSubsemiring ≤ M.toSubsemiring := hQM
  haveI hInt : Algebra.IsIntegral ℚ Ω := (IsSepClosure.separable.isAlgebraic).isIntegral
  haveI hNz : NeZero (ℓ ^ 2) := ⟨pow_ne_zero 2 (Fact.out (p := ℓ.Prime)).ne_zero⟩
  haveI hcyc : IsCyclotomicExtension ({ℓ ^ (1 + 1)} : Set ℕ) ℚ ↥Q := by
    have h := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
    convert h using 2 <;> first | rfl | exact Subsingleton.elim _ _
  haveI hnfQ : NumberField ↥Q := IsCyclotomicExtension.numberField ({ℓ ^ (1 + 1)} : Set ℕ) ℚ ↥Q
  letI : Algebra ↥Q ↥M := (Subsemiring.inclusion hQle).toAlgebra
  haveI hSt : IsScalarTower ℤ (NumberField.RingOfIntegers ↥Q) (NumberField.RingOfIntegers ↥M) :=
    inferInstance
  haveI hFl : Module.Flat (NumberField.RingOfIntegers ↥Q) (NumberField.RingOfIntegers ↥M) :=
    inferInstance
  haveI : P.LiesOver (Ideal.under (NumberField.RingOfIntegers ↥Q) P) := Ideal.LiesOver.mk rfl
  haveI hQ'lies : (Ideal.under (NumberField.RingOfIntegers ↥Q) P).LiesOver
      (Ideal.span {(ℓ : ℤ)}) := Ideal.LiesOver.tower_bot P _ _
  have hcyc2 : (Ideal.under (NumberField.RingOfIntegers ↥Q) P).ramificationIdx ℤ =
      ℓ * (ℓ - 1) := by
    rw [IsCyclotomicExtension.Rat.ramificationIdx_eq_of_prime_pow (p := ℓ) (k := 1)
      (K := ↥Q) (Ideal.under (NumberField.RingOfIntegers ↥Q) P), pow_one]
  have hdvd : (Ideal.under (NumberField.RingOfIntegers ↥Q) P).ramificationIdx ℤ ∣
      P.ramificationIdx ℤ := Ideal.ramificationIdx_below_dvd _ _
  intro h1
  have hdvd2 : ℓ * (ℓ - 1) ∣ 1 := by
    rw [hcyc2, h1] at hdvd
    exact hdvd
  have hle : ℓ * (ℓ - 1) ≤ 1 := Nat.le_of_dvd (by norm_num) hdvd2
  have h2 : 2 ≤ ℓ := (Fact.out : ℓ.Prime).two_le
  have h3 : 1 ≤ ℓ - 1 := by omega
  have h4 : 2 ≤ ℓ * (ℓ - 1) := by
    calc (2 : ℕ) = 2 * 1 := by norm_num
      _ ≤ ℓ * (ℓ - 1) := Nat.mul_le_mul h2 h3
  omega

/-- **The ramification index over `ℤ` and over `𝓞 ℚ` agree.**  For a prime `P` of `𝓞 M` lying both
over the prime `(ℓ)` of `ℤ` and over the corresponding prime of `𝓞 ℚ`, the two ramification indices
coincide: both are the length of `Localization.AtPrime P ⧸ (ℓ)`. -/
theorem ramificationIdx_int_eq_rat_of_liesOver_span {Ω : Type*} [Field Ω] [Algebra ℚ Ω]
    (ℓ : ℕ) (M : IntermediateField ℚ Ω) [FiniteDimensional ℚ M] [NumberField ↥M]
    (P : Ideal (NumberField.RingOfIntegers ↥M)) [P.IsPrime]
    (h1 : P.LiesOver (Ideal.span {(ℓ : ℤ)}))
    (h2 : P.LiesOver (Ideal.span {(ℓ : NumberField.RingOfIntegers ℚ)})) :
    P.ramificationIdx ℤ = P.ramificationIdx (NumberField.RingOfIntegers ℚ) := by
  haveI := h1
  haveI := h2
  have hideal : Ideal.map (algebraMap ℤ (Localization.AtPrime P)) (Ideal.span {(ℓ : ℤ)}) =
      Ideal.map (algebraMap (NumberField.RingOfIntegers ℚ) (Localization.AtPrime P))
        (Ideal.span {(ℓ : NumberField.RingOfIntegers ℚ)}) := by
    rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
    simp
  rw [Ideal.ramificationIdx_eq (R := ℤ) (p := Ideal.span {(ℓ : ℤ)}) (q := P),
      Ideal.ramificationIdx_eq (R := NumberField.RingOfIntegers ℚ)
        (p := Ideal.span {(ℓ : NumberField.RingOfIntegers ℚ)}) (q := P), hideal]

/-- **Čebotarev with a completely split prime away from `ℓ`.**  Let `Ω/ℚ` be Galois and separably
closed, `L` a finite normal number-field level of `Ω/ℚ` and `N/L` a finite normal number-field
level inside `Ω`.  Then for every `τ ∈ Gal(N/L)` there is a prime `𝔭` of `L` which is completely
split over `ℚ` and whose rational prime is different from `ℓ`, and a prime `P` of `𝓞 N` above `𝔭`,
unramified over `𝔭`, at which `τ` is an arithmetic Frobenius element.

This is `NK.Reconstruct.exists_split_frobAt_unramified` with the extra clause
`primeBelowNat 𝔭 ≠ ℓ`: the normal closure of the level is enlarged by the cyclotomic field
`ℚ(ζ_{ℓ²})`, in which `ℓ` is ramified — so Čebotarev at the enlarged level cannot return a prime
over `ℓ`. -/
theorem exists_split_frobAt_awayFromL {Ω : Type*} [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω]
    [IsSepClosure ℚ Ω] (hc : NK.Reconstruct.ChebotarevInput ℚ Ω) (L : NK.Reconstruct.FrobLevel ℚ Ω)
    (ℓ : ℕ) [Fact ℓ.Prime]
    (N : IntermediateField ↥L.L Ω) [FiniteDimensional ↥L.L N] [Normal ↥L.L N] [NumberField ↥N]
    (τ : Gal(↥N/↥L.L)) :
    ∃ (𝔭 : NK.Chebotarev.PrimeIdeal ↥L.L) (P : NK.Chebotarev.PrimeIdeal ↥N),
      P.asIdeal.LiesOver 𝔭.asIdeal ∧ NK.Reconstruct.SplitsCompletelyOverRat 𝔭 ∧
      P.asIdeal.ramificationIdx (NumberField.RingOfIntegers ↥L.L) = 1 ∧
      NK.Chebotarev.IsFrobAt (K := ↥L.L) (L := ↥N) P τ ∧
      NK.LocalInputs.primeBelowNat ↥L.L 𝔭 ≠ ℓ := by
  classical
  -- (0) Ω is normal over `↥L.L`
  haveI hNormalOmega : Normal ↥L.L Ω := IsGalois.to_normal
  -- (1) a primitive `ℓ ^ 2`-th root of unity in `Ω`
  haveI hAlgClosed : IsAlgClosed Ω := IsAlgClosure.isAlgClosed ℚ
  haveI hcharZero : CharZero Ω := charZero_of_injective_algebraMap (algebraMap ℚ Ω).injective
  obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot_prime_pow Ω ℓ 2 (by norm_num)
  -- (2) `A` : the normal closure of `N` over `ℚ`, and `M` : its compositum with `ℚ(ζ)`,
  -- normalised again
  let A : IntermediateField ℚ Ω := IntermediateField.normalClosure ℚ ↥N Ω
  letI : Algebra ℚ ↥A := IntermediateField.algebra' A
  haveI hAfin : FiniteDimensional ℚ ↥A := normalClosure.is_finiteDimensional ℚ ↥N Ω
  haveI hAnor : Normal ℚ ↥A := normalClosure.normal ℚ ↥N Ω
  haveI hAnf : NumberField ↥A :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField (K := ℚ) (K' := Ω) A
  let Qh : IntermediateField ℚ Ω := IntermediateField.adjoin ℚ ({ζ} : Set Ω)
  letI : Algebra ℚ ↥Qh := Qh.algebra'
  haveI hcycQ : IsCyclotomicExtension ({ℓ ^ (1 + 1)} : Set ℕ) ℚ ↥Qh := by
    have h := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
    convert h using 2 <;> first | rfl | exact Subsingleton.elim _ _
  haveI hQhnf : NumberField ↥Qh := IsCyclotomicExtension.numberField ({ℓ ^ (1 + 1)} : Set ℕ) ℚ ↥Qh
  haveI hsupfin : FiniteDimensional ℚ ↥(A ⊔ Qh) := inferInstance
  letI : Algebra ℚ ↥(A ⊔ Qh) := (A ⊔ Qh).algebra'
  let M : IntermediateField ℚ Ω := IntermediateField.normalClosure ℚ ↥(A ⊔ Qh) Ω
  letI : Algebra ℚ ↥M := IntermediateField.algebra' M
  haveI hMfin : FiniteDimensional ℚ ↥M := normalClosure.is_finiteDimensional ℚ ↥(A ⊔ Qh) Ω
  haveI hMnor : Normal ℚ ↥M := normalClosure.normal ℚ ↥(A ⊔ Qh) Ω
  haveI hMnf : NumberField ↥M :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField (K := ℚ) (K' := Ω) M
  -- (3) the inclusions `N ⊆ A ⊆ A ⊔ Qh ⊆ M` and `L ⊆ M`
  have hN_A : N.toSubsemiring ≤ A.toSubsemiring := fun x hx => by
    show x ∈ (⨆ f : ↥N →ₐ[ℚ] Ω, f.fieldRange : IntermediateField ℚ Ω)
    exact le_iSup (fun f : ↥N →ₐ[ℚ] Ω => f.fieldRange) (N.val.restrictScalars ℚ)
      ⟨⟨x, hx⟩, rfl⟩
  have hA_sup : A.toSubsemiring ≤ (A ⊔ Qh).toSubsemiring := fun x hx =>
    (show A ≤ A ⊔ Qh from le_sup_left) hx
  have hsup_M : (A ⊔ Qh).toSubsemiring ≤ M.toSubsemiring := fun x hx => by
    show x ∈ (⨆ f : ↥(A ⊔ Qh) →ₐ[ℚ] Ω, f.fieldRange : IntermediateField ℚ Ω)
    exact le_iSup (fun f : ↥(A ⊔ Qh) →ₐ[ℚ] Ω => f.fieldRange) ((A ⊔ Qh).val)
      ⟨⟨x, hx⟩, rfl⟩
  have hNM : N.toSubsemiring ≤ M.toSubsemiring := (hN_A.trans hA_sup).trans hsup_M
  have hLM : L.L.toSubsemiring ≤ M.toSubsemiring := fun x hx =>
    hNM (N.algebraMap_mem (⟨x, hx⟩ : ↥L.L))
  have hQM : Qh ≤ M := fun x hx => hsup_M ((show Qh ≤ A ⊔ Qh from le_sup_right) hx)
  -- (4) the algebra structures `↥N → ↥M` and `↥L.L → ↥M`
  letI : Algebra ↥N ↥M := (Subsemiring.inclusion hNM).toAlgebra
  letI : Algebra ↥L.L ↥M := (Subsemiring.inclusion hLM).toAlgebra
  haveI tLNM : @IsScalarTower ↥L.L ↥N ↥M Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  letI instLL : Algebra ℚ ↥L.L := IntermediateField.algebra' (K := ℚ) (L := Ω) L.L
  haveI tQLM : @IsScalarTower ℚ ↥L.L ↥M Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  -- (5) `↥L.L` is normal (hence Galois) over `ℚ`, and `M` is normal over `↥L.L`
  have hNorLL : Normal ℚ ↥L.L := by
    have he : (IntermediateField.algebra' (K := ℚ) (L := Ω) L.L : Algebra ℚ ↥L.L) = instLL :=
      Subsingleton.elim _ _
    exact he ▸ L.normal
  haveI := hNorLL
  haveI hgalLL : IsGalois ℚ ↥L.L :=
    Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
  haveI hMnorL : Normal ↥L.L ↥M := Normal.tower_top_of_normal (F := ℚ) (K := ↥L.L) (E := ↥M)
  -- (6) lift `τ` to `ρ ∈ Gal(M/L)`
  obtain ⟨ρ, hρ⟩ := AlgEquiv.restrictNormalHom_surjective (F := ↥L.L) (K₁ := ↥N) (E := ↥M) τ
  -- (7) `ρ` as a `ℚ`-automorphism, and Čebotarev at the level `M`
  let ρ₀ : Gal(↥M/ℚ) := ρ.restrictScalars ℚ
  obtain ⟨p₀, Pt, hPtlies, he0, hρ₀frob⟩ := hc M ρ₀
  -- (8) the primes of `L` and of `N` below `Pt`
  let pp : NK.Chebotarev.PrimeIdeal ↥L.L := Pt.under (𝓞 ↥L.L)
  let P : NK.Chebotarev.PrimeIdeal ↥N := Pt.under (𝓞 ↥N)
  -- (9) `ρ` fixes `↥L.L`
  have hρ' : ρ.restrictNormal ↥N = τ := hρ
  have hfix : ∀ x : ↥L.L, ρ (algebraMap ↥L.L ↥M x) = algebraMap ↥L.L ↥M x := by
    intro x
    rw [IsScalarTower.algebraMap_apply ↥L.L ↥N ↥M x]
    rw [← AlgEquiv.restrictNormal_commutes ρ ↥N (algebraMap ↥L.L ↥N x), hρ', AlgEquiv.commutes]
  -- (10) unramifiedness: `e(𝔭/ℚ) = 1` and `e(Pt/𝔭) = 1`
  obtain ⟨hunr_pp, hunr_Pt⟩ :=
    ramificationIdx_under_eq_one_and_eq_one (K := ℚ) (L := ↥L.L) (M := ↥M) Pt he0
  -- (11) the restriction of `ρ₀` to `L` is trivial, hence `𝔭` is completely split over `ℚ`
  have hres := isFrobAt_restrictNormalHom_le (K := ℚ) (K' := Ω) (L := L.L) (M := M) hLM hρ₀frob
  have hres1 : AlgEquiv.restrictNormalHom (F := ℚ) (K₁ := ↥M) L.L ρ₀ = 1 := by
    refine restrictNormalHom_eq_one_of_commutes (K := ℚ) (K' := Ω) L.L M ?_
    intro x
    exact hfix x
  have hfrob1 : NK.Chebotarev.IsFrobAt (K := ℚ) (L := ↥L.L) pp 1 := by
    rw [hres1] at hres
    exact hres
  have hlies_pp : pp.asIdeal.LiesOver p₀.asIdeal := ⟨by
    show p₀.asIdeal = Ideal.under (𝓞 ℚ) pp.asIdeal
    rw [show pp.asIdeal = Ideal.under (𝓞 ↥L.L) Pt.asIdeal from rfl,
      Ideal.under_under (A := 𝓞 ℚ) (B := 𝓞 ↥L.L) (𝔓 := Pt.asIdeal), ← hPtlies.over]⟩
  have hf_pp : pp.asIdeal.inertiaDeg (𝓞 ℚ) = 1 :=
    (IsFrobAt_eq_one_iff_inertiaDeg_eq_one (K := ℚ) (L := ↥L.L) hlies_pp hunr_pp).1 hfrob1
  have hsplit : SplitsCompletelyOverRat pp := by
    refine ⟨?_, ?_⟩
    · convert hf_pp using 2
      congr 1
      exact Subsingleton.elim _ _
    · convert hunr_pp using 2
      congr 1
      exact Subsingleton.elim _ _
  -- (12) the rational prime of `𝔭` is not `ℓ`
  have hpp_ne_ℓ : NK.LocalInputs.primeBelowNat ↥L.L pp ≠ ℓ := by
    intro hbad
    -- the residue characteristic of `pp` is `primeBelowNat`, which `hbad` makes equal to `ℓ`
    have hcharQ : CharP (𝓞 ↥L.L ⧸ pp.asIdeal) (NK.LocalInputs.primeBelowNat ↥L.L pp) :=
      NK.ReconstructField.charP_of_liesOver pp (NK.LocalInputs.primeBelow ↥L.L pp)
        (NK.LocalInputs.primeBelow_liesOver ↥L.L pp)
    have hcharℓ : CharP (𝓞 ↥L.L ⧸ pp.asIdeal) ℓ := hbad ▸ hcharQ
    have hmemL : (ℓ : 𝓞 ↥L.L) ∈ pp.asIdeal :=
      (NK.ReconstructField.charP_quotient_iff_mem pp (Fact.out : ℓ.Prime)).mp hcharℓ
    -- pull back to `𝓞 M` and then to `𝓞 ℚ`
    have hmemM : (ℓ : 𝓞 ↥M) ∈ Pt.asIdeal := by
      rw [show pp.asIdeal = Ideal.under (𝓞 ↥L.L) Pt.asIdeal from rfl, Ideal.mem_under] at hmemL
      simpa using hmemL
    have hmemQ : (ℓ : 𝓞 ℚ) ∈ p₀.asIdeal := by
      rw [hPtlies.over, Ideal.mem_under]
      simpa using hmemM
    have hspan : p₀.asIdeal = Ideal.span {(ℓ : 𝓞 ℚ)} :=
      Commons.NumberTheory.NumberField.Completion.asIdeal_eq_span_prime p₀ ℓ
        (Fact.out : ℓ.Prime) hmemQ
    have hP2 : Pt.asIdeal.LiesOver (Ideal.span {(ℓ : 𝓞 ℚ)}) :=
      Ideal.LiesOver.mk (by rw [← hspan]; exact hPtlies.over)
    have hP1 : Pt.asIdeal.LiesOver (Ideal.span {(ℓ : ℤ)}) := by
      refine Ideal.LiesOver.mk ?_
      rw [← comap_span_ringOfIntegersRat ℓ, ← hspan, hPtlies.over]
      refine Ideal.ext fun x => ?_
      simp only [Ideal.mem_comap]
      rw [IsScalarTower.algebraMap_apply ℤ (𝓞 ℚ) (𝓞 ↥M)]
    -- the ramification indices over `ℤ` and over `𝓞 ℚ` agree
    have hbridge : Pt.asIdeal.ramificationIdx ℤ = Pt.asIdeal.ramificationIdx (𝓞 ℚ) := by
      haveI := hP1
      haveI := hP2
      have hideal : Ideal.map (algebraMap ℤ (Localization.AtPrime Pt.asIdeal))
            (Ideal.span {(ℓ : ℤ)}) =
          Ideal.map (algebraMap (𝓞 ℚ) (Localization.AtPrime Pt.asIdeal))
            (Ideal.span {(ℓ : 𝓞 ℚ)}) := by
        rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
        simp
      rw [Ideal.ramificationIdx_eq (R := ℤ) (p := Ideal.span {(ℓ : ℤ)}) (q := Pt.asIdeal),
          Ideal.ramificationIdx_eq (R := 𝓞 ℚ) (p := Ideal.span {(ℓ : 𝓞 ℚ)}) (q := Pt.asIdeal),
          hideal]
    exact ramificationIdx_int_ne_one_of_le_adjoin_primitiveRoot ℓ hζ M hQM Pt hP1
      (by rw [hbridge, he0])
  -- (13) unramifiedness of `P` over `𝔭`
  have hlies_P : P.asIdeal.LiesOver pp.asIdeal := ⟨by
    show pp.asIdeal = Ideal.under (𝓞 ↥L.L) P.asIdeal
    rw [show P.asIdeal = Ideal.under (𝓞 ↥N) Pt.asIdeal from rfl,
      Ideal.under_under (A := 𝓞 ↥L.L) (B := 𝓞 ↥N) (𝔓 := Pt.asIdeal),
      show pp.asIdeal = Ideal.under (𝓞 ↥L.L) Pt.asIdeal from rfl]⟩
  obtain ⟨hunr_P, -⟩ :=
    ramificationIdx_under_eq_one_and_eq_one (K := ↥L.L) (L := ↥N) (M := ↥M) Pt hunr_Pt
  -- (14) descent of the Frobenius element from `M` to `N`
  have hρfrob : NK.Chebotarev.IsFrobAt (K := ↥L.L) (L := ↥M) Pt ρ :=
    isFrobAt_of_isFrobAt_restrictScalars (K := ℚ) (L := ↥L.L) (M := ↥M) Pt ρ hf_pp hρ₀frob
  have hcommL : ∀ y : 𝓞 ↥N,
      galRestrict (𝓞 ↥L.L) ↥L.L ↥M (𝓞 ↥M) ρ (algebraMap (𝓞 ↥N) (𝓞 ↥M) y)
        = algebraMap (𝓞 ↥N) (𝓞 ↥M) (galRestrict (𝓞 ↥L.L) ↥L.L ↥N (𝓞 ↥N) τ y) :=
    galRestrict_commutes_of_field_commutes (L := ↥L.L) (N := ↥N) (M := ↥M)
      (ρ := ρ) (τ := τ) (fun x => by
        rw [← AlgEquiv.restrictNormal_commutes ρ ↥N x, hρ'])
  have hfcard : Nat.card (𝓞 ↥L.L ⧸ P.asIdeal.under (𝓞 ↥L.L))
      = Nat.card (𝓞 ↥L.L ⧸ Pt.asIdeal.under (𝓞 ↥L.L)) := by
    show Nat.card (𝓞 ↥L.L ⧸ Ideal.under (𝓞 ↥L.L)
          (Ideal.under (𝓞 ↥N) Pt.asIdeal))
        = Nat.card (𝓞 ↥L.L ⧸ Ideal.under (𝓞 ↥L.L) Pt.asIdeal)
    rw [Ideal.under_under]
  have hliesPt : Pt.asIdeal.LiesOver P.asIdeal := ⟨rfl⟩
  have hfrobP : NK.Chebotarev.IsFrobAt (K := ↥L.L) (L := ↥N) P τ :=
    frobAt_descend_of_galRestrict_commutes (K := ↥L.L) (L := ↥L.L) (N := ↥N) (M := ↥M)
      hliesPt hρfrob hcommL hfcard
  exact ⟨pp, P, hlies_P, hsplit, hunr_P, hfrobP, hpp_ne_ℓ⟩

/-! ## The target statement -/

/-- **The Frobenius-avoidance statement of Shimizu's Proposition 4f.3, at primes away from `ℓ`.**

Given finitely many closed subgroups `H_i` of `Γ_L = Gamma ↥L.L Ω ℓ` which are not open, there is a
prime `𝔭` of `L` which is **completely split over `ℚ`** and whose rational prime is **different from
`ℓ`**, and a Frobenius element `σ ∈ Gal(Ω/L)` at `𝔭` whose image `galToGamma σ ∈ Γ_L` lies outside
every `H_i`.

The prime away from `ℓ` is what makes the ℓ-adic Frobenius element well defined modulo the torsion
of `Γ_L` (`NK.Reconstruct.frobUniquenessAwayFromL`), which is how Shimizu's Proposition 4f.3 is
consumed.  The Čebotarev input is the weak one-prime form `ChebotarevInput ℚ Ω`; the passage to
primes away from `ℓ` is the ramification of `ℓ` in `ℚ(ζ_{ℓ²})`
(`NK.Reconstruct.exists_split_frobAt_awayFromL`), and the density of the Frobenius elements at
those primes is `NK.Reconstruct.dense_image_galToGamma_splitFrobenius_awayFromL`. -/
theorem exists_splitIsFrobElementAt_notMem_iUnion_closedSubgroup_awayFromL {Ω : Type*}
    [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω]
    (hc : NK.Reconstruct.ChebotarevInput ℚ Ω)
    (L : NK.Reconstruct.FrobLevel ℚ Ω) [IsSepClosure ↥L.L Ω]
    (ℓ : ℕ) [Fact ℓ.Prime] {ι : Type*} [Finite ι]
    (H : ι → Subgroup (NK.Reconstruct.Gamma ↥L.L Ω ℓ))
    (hcl : ∀ i, IsClosed ((H i : Subgroup (NK.Reconstruct.Gamma ↥L.L Ω ℓ)) :
      Set (NK.Reconstruct.Gamma ↥L.L Ω ℓ)))
    (hopen : ∀ i, ¬ IsOpen ((H i : Subgroup (NK.Reconstruct.Gamma ↥L.L Ω ℓ)) :
      Set (NK.Reconstruct.Gamma ↥L.L Ω ℓ))) :
    ∃ (𝔭 : NK.Chebotarev.PrimeIdeal ↥L.L) (σ : Gal(Ω/↥L.L)),
      NK.Reconstruct.IsFrobElementAt 𝔭 σ ∧ NK.Reconstruct.SplitsCompletelyOverRat 𝔭 ∧
      NK.LocalInputs.primeBelowNat ↥L.L 𝔭 ≠ ℓ ∧
      ∀ i, galToGamma (K := ↥L.L) (K' := Ω) ℓ σ ∉ H i := by
  classical
  -- the away-from-`ℓ` split Čebotarev input, from the ramification of `ℓ` in `ℚ(ζ_{ℓ²})`
  have hC : ∀ (N : IntermediateField ↥L.L Ω) [FiniteDimensional ↥L.L N] [Normal ↥L.L N]
      [NumberField ↥N] (τ : Gal(↥N/↥L.L)),
      ∃ (𝔭 : NK.Chebotarev.PrimeIdeal ↥L.L) (P : NK.Chebotarev.PrimeIdeal ↥N),
        P.asIdeal.LiesOver 𝔭.asIdeal ∧ NK.Reconstruct.SplitsCompletelyOverRat 𝔭 ∧
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers ↥L.L) = 1 ∧
        NK.Chebotarev.IsFrobAt (K := ↥L.L) (L := ↥N) P τ ∧
        NK.LocalInputs.primeBelowNat ↥L.L 𝔭 ≠ ℓ :=
    fun N _ _ _ τ => exists_split_frobAt_awayFromL hc L ℓ N τ
  have hD : ∀ (T : IntermediateField ↥L.L Ω) [FiniteDimensional ↥L.L T] [Normal ↥L.L T]
      [NumberField ↥T] (τ : Gal(↥T/↥L.L)),
      ∃ (𝔭 : NK.Chebotarev.PrimeIdeal ↥L.L) (σ : Gal(Ω/↥L.L)),
        NK.Reconstruct.SplitsCompletelyOverRat 𝔭 ∧ NK.Reconstruct.IsFrobElementAt 𝔭 σ ∧
        NK.LocalInputs.primeBelowNat ↥L.L 𝔭 ≠ ℓ ∧
        AlgEquiv.restrictNormalHom (F := ↥L.L) (K₁ := Ω) T σ = τ :=
    fun T _ _ _ τ => exists_isFrobElementAt_split_awayFromL L ℓ hC T τ
  -- the images of those Frobenius elements are dense in `Γ_L`
  have hdense := dense_image_galToGamma_splitFrobenius_awayFromL L ℓ hD
  -- a dense subset of a compact Hausdorff group meets the complement of the `H_i`
  obtain ⟨d, ⟨σ, hσwit, rfl⟩, hd⟩ :=
    exists_mem_dense_notMem_iUnion_closedSubgroup H hcl hopen hdense
  obtain ⟨𝔭, hsplit, hfrob, hpne⟩ := hσwit
  exact ⟨𝔭, σ, hfrob, hsplit, hpne, hd⟩

end NK.Reconstruct
