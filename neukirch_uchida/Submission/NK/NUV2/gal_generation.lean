import Mathlib
import Submission.NK.Reconstruct.NumFieldIn
import Submission.NK.Reconstruct.GammaObject

/-!
# `Gal(L/M)` is generated by `Gal(L/K₁)` and `Gal(L/K₂)` when `M = K₁ ⊓ K₂`

This file proves `NK.NUV2.gal_generation`: for a finite Galois level `L/ℚ` inside a separable
closure `Ω`, and number fields `K₁, K₂, M ⊆ L` with `M = K₁ ∩ K₂`, the Galois group
`Gal(L/M)` is generated, inside `Gal(L/ℚ)`, by `Gal(L/K₁)` and `Gal(L/K₂)`.

Concretely: a *subgroup* `S ≤ Gal(L/ℚ)` containing the images of `Gal(L/K₁)` and `Gal(L/K₂)`
under `AlgEquiv.restrictScalars ℚ` contains the image of `Gal(L/M)` as well.

The mathematical content is the fundamental theorem of Galois theory for the finite Galois
extension `L/ℚ`:

* the intermediate fields of `L/ℚ` correspond to the subgroups of `Gal(L/ℚ)`, with
  `K ↦ K.fixingSubgroup` inclusion-reversing;
* consequently `(K₁ ⊓ K₂).fixingSubgroup = K₁.fixingSubgroup ⊔ K₂.fixingSubgroup`
  (`fixingSubgroup_inf_eq_sup` below — Mathlib has the `⊔`-analogue
  `IntermediateField.fixingSubgroup_sup` but not this form);
* the images of `Gal(L/Kᵢ)` under `AlgEquiv.restrictScalars ℚ` are exactly the elements of
  `Kᵢ.fixingSubgroup` (an `L/Kᵢ`-algebra automorphism is a `ℚ`-algebra automorphism fixing `Kᵢ`
  pointwise, and conversely).

The hypothesis `M = K₁ ⊓ K₂` is the only arithmetic input; the containments `Kᵢ ⊆ L` (`h₁`, `h₂`)
are part of the ambient setting and are not needed.

The field `↥L.L` carries a `ℚ`-algebra structure which typeclass search resolves to the canonical
one; the construction of the intermediate fields of `↥L.L` corresponding to `K₁, K₂, M` goes
through `IntermediateField.comap` along `IsScalarTower.toAlgHom ℚ ↥L.L Ω` (rather than
`IntermediateField.val`, whose `ℚ`-algebra structure is the `IntermediateField.algebra'` one and
which therefore leads to an instance diamond).  Membership in these fields is then
definitionally `algebraMap ↥L.L Ω x ∈ K` by `Iff.rfl`.
-/

set_option maxHeartbeats 2000000
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace NK.NUV2

open NK.Reconstruct

/-! ## The Galois correspondence for the meet of two intermediate fields -/

/-- **The fixing subgroup of a meet is the supremum of the fixing subgroups.**

For a finite-dimensional Galois extension `E/F` and intermediate fields `K, L`,
`(K ⊓ L).fixingSubgroup = K.fixingSubgroup ⊔ L.fixingSubgroup` as subgroups of `Gal(E/F)`.

This is the order-theoretic form of the fundamental theorem of Galois theory: `fixingSubgroup` is
inclusion-reversing and, by `IsGalois.fixedField_fixingSubgroup` and
`IntermediateField.fixingSubgroup_fixedField`, is inverse to `IntermediateField.fixedField` on
intermediate fields and to it on all subgroups, so it carries `⊔` on subgroups to `⊓` on fields.
Mathlib has the field-theoretic `⊔`-analogue `IntermediateField.fixingSubgroup_sup`
(`fixingSubgroup (K ⊔ L) = fixingSubgroup K ⊓ fixingSubgroup L`) but not this dual form. -/
lemma fixingSubgroup_inf_eq_sup {F E : Type*} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] [IsGalois F E] (K L : IntermediateField F E) :
    (K ⊓ L).fixingSubgroup = K.fixingSubgroup ⊔ L.fixingSubgroup := by
  refine le_antisymm ?_ ?_
  · -- It suffices to see that the field fixed by `K.fixingSubgroup ⊔ L.fixingSubgroup` is
    -- contained in `K ⊓ L`; the Galois correspondence then gives the reverse inclusion.
    have h1 : IntermediateField.fixedField (K.fixingSubgroup ⊔ L.fixingSubgroup) ≤ K :=
      le_trans (IntermediateField.fixedField_le (le_sup_left (a := K.fixingSubgroup)))
        (le_of_eq (IsGalois.fixedField_fixingSubgroup K))
    have h2 : IntermediateField.fixedField (K.fixingSubgroup ⊔ L.fixingSubgroup) ≤ L :=
      le_trans (IntermediateField.fixedField_le (le_sup_right (a := K.fixingSubgroup)))
        (le_of_eq (IsGalois.fixedField_fixingSubgroup L))
    calc (K ⊓ L).fixingSubgroup
        ≤ (IntermediateField.fixedField (K.fixingSubgroup ⊔ L.fixingSubgroup)).fixingSubgroup :=
          IntermediateField.fixingSubgroup_le (le_inf h1 h2)
      _ = K.fixingSubgroup ⊔ L.fixingSubgroup := IntermediateField.fixingSubgroup_fixedField _
  · -- Both `K.fixingSubgroup` and `L.fixingSubgroup` fix `K ⊓ L`.
    exact sup_le (IntermediateField.fixingSubgroup_le inf_le_left)
      (IntermediateField.fixingSubgroup_le inf_le_right)

/-! ## The main lemma -/

theorem gal_generation (Ω : Type) [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω]
    (K₁ K₂ M : NK.Reconstruct.NumFieldIn ℚ Ω) (L : NK.Reconstruct.FrobLevel ℚ Ω)
    [NumberField ↥K₁.L] [NumberField ↥K₂.L] [NumberField ↥M.L] [NumberField ↥L.L]
    [FiniteDimensional ℚ ↥K₁.L] [FiniteDimensional ℚ ↥K₂.L] [FiniteDimensional ℚ ↥M.L]
    [FiniteDimensional ℚ ↥L.L] [Normal ℚ ↥L.L]
    [IsSepClosure ↥K₁.L Ω] [IsSepClosure ↥K₂.L Ω] [IsSepClosure ↥M.L Ω] [IsSepClosure ↥L.L Ω]
    (hM : M.L = K₁.L ⊓ K₂.L) (h₁ : K₁.L ≤ L.L) (h₂ : K₂.L ≤ L.L)
    [Algebra ↥M.L ↥L.L] [Algebra ↥K₁.L ↥L.L] [Algebra ↥K₂.L ↥L.L]
    [IsScalarTower ↥M.L ↥L.L Ω] [IsScalarTower ↥K₁.L ↥L.L Ω] [IsScalarTower ↥K₂.L ↥L.L Ω]
    (S : Subgroup (↥L.L ≃ₐ[ℚ] ↥L.L))
    (hS₁ : ∀ g₁ : Gal(↥L.L/↥K₁.L), (AlgEquiv.restrictScalars ℚ g₁ : ↥L.L ≃ₐ[ℚ] ↥L.L) ∈ S)
    (hS₂ : ∀ g₂ : Gal(↥L.L/↥K₂.L), (AlgEquiv.restrictScalars ℚ g₂ : ↥L.L ≃ₐ[ℚ] ↥L.L) ∈ S) :
    ∀ g : Gal(↥L.L/↥M.L), (AlgEquiv.restrictScalars ℚ g : ↥L.L ≃ₐ[ℚ] ↥L.L) ∈ S := by
  -- `L.L` is a finite extension of `ℚ` which is normal by hypothesis and separable because `ℚ` has
  -- characteristic zero, hence Galois: the Galois correspondence applies to `↥L.L / ℚ`.
  haveI : IsGalois ℚ ↥L.L := IsGalois.mk
  -- The intermediate fields of `↥L.L / ℚ` cut out by `K₁.L`, `K₂.L`, `M.L`.
  let f : ↥L.L →ₐ[ℚ] Ω := IsScalarTower.toAlgHom ℚ ↥L.L Ω
  let A : IntermediateField ℚ ↥L.L := IntermediateField.comap f K₁.L
  let B : IntermediateField ℚ ↥L.L := IntermediateField.comap f K₂.L
  let C : IntermediateField ℚ ↥L.L := IntermediateField.comap f M.L
  have hmemA : ∀ x : ↥L.L, x ∈ A ↔ algebraMap ↥L.L Ω x ∈ K₁.L := fun x => Iff.rfl
  have hmemB : ∀ x : ↥L.L, x ∈ B ↔ algebraMap ↥L.L Ω x ∈ K₂.L := fun x => Iff.rfl
  have hmemC : ∀ x : ↥L.L, x ∈ C ↔ algebraMap ↥L.L Ω x ∈ M.L := fun x => Iff.rfl
  -- `C = A ⊓ B` is the translation of `M = K₁ ⊓ K₂`.
  have hCAB : C = A ⊓ B := by
    ext x
    rw [hmemC, IntermediateField.mem_inf, hmemA, hmemB, hM, IntermediateField.mem_inf]
  -- `S` contains `A.fixingSubgroup`: a `ℚ`-automorphism of `↥L.L` fixing `A` pointwise is exactly
  -- an `↥K₁.L`-algebra automorphism, i.e. an element of `Gal(↥L.L/↥K₁.L)`, to which `hS₁` applies.
  have hfixA : A.fixingSubgroup ≤ S := by
    intro σ hσ
    have hcomm : ∀ m : ↥K₁.L, σ (algebraMap ↥K₁.L ↥L.L m) = algebraMap ↥K₁.L ↥L.L m := by
      intro m
      have hm : algebraMap ↥K₁.L ↥L.L m ∈ A := by
        rw [hmemA, ← IsScalarTower.algebraMap_apply ↥K₁.L ↥L.L Ω]
        exact m.2
      exact (IntermediateField.mem_fixingSubgroup_iff A σ).mp hσ _ hm
    let g : ↥L.L ≃ₐ[↥K₁.L] ↥L.L := { AlgEquiv.toRingEquiv σ with commutes' := hcomm }
    have hcoe : (AlgEquiv.restrictScalars ℚ g : ↥L.L ≃ₐ[ℚ] ↥L.L) = σ := AlgEquiv.ext fun x => rfl
    rw [← hcoe]
    exact hS₁ g
  have hfixB : B.fixingSubgroup ≤ S := by
    intro σ hσ
    have hcomm : ∀ m : ↥K₂.L, σ (algebraMap ↥K₂.L ↥L.L m) = algebraMap ↥K₂.L ↥L.L m := by
      intro m
      have hm : algebraMap ↥K₂.L ↥L.L m ∈ B := by
        rw [hmemB, ← IsScalarTower.algebraMap_apply ↥K₂.L ↥L.L Ω]
        exact m.2
      exact (IntermediateField.mem_fixingSubgroup_iff B σ).mp hσ _ hm
    let g : ↥L.L ≃ₐ[↥K₂.L] ↥L.L := { AlgEquiv.toRingEquiv σ with commutes' := hcomm }
    have hcoe : (AlgEquiv.restrictScalars ℚ g : ↥L.L ≃ₐ[ℚ] ↥L.L) = σ := AlgEquiv.ext fun x => rfl
    rw [← hcoe]
    exact hS₂ g
  -- Hence `S` contains `C.fixingSubgroup = A.fixingSubgroup ⊔ B.fixingSubgroup`.
  have hfixC : C.fixingSubgroup ≤ S := by
    rw [hCAB, fixingSubgroup_inf_eq_sup]
    exact sup_le hfixA hfixB
  -- Finally, an `↥M.L`-algebra automorphism of `↥L.L` fixes `C` pointwise, so its underlying
  -- `ℚ`-automorphism lies in `C.fixingSubgroup ⊆ S`.
  intro g
  refine hfixC ?_
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  change g x = x
  have hxM : algebraMap ↥L.L Ω x ∈ M.L := (hmemC x).mp hx
  let m : ↥M.L := ⟨algebraMap ↥L.L Ω x, hxM⟩
  have hx' : algebraMap ↥M.L ↥L.L m = x := by
    apply Subtype.ext
    change algebraMap ↥L.L Ω (algebraMap ↥M.L ↥L.L m) = algebraMap ↥L.L Ω x
    rw [← IsScalarTower.algebraMap_apply ↥M.L ↥L.L Ω]
    rfl
  calc g x = g (algebraMap ↥M.L ↥L.L m) := by rw [hx']
    _ = algebraMap ↥M.L ↥L.L m := AlgEquiv.commutes g m
    _ = x := hx'

end NK.NUV2
