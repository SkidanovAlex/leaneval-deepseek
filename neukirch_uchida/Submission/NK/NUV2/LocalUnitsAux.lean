import Mathlib
import Submission.NK.Reconstruct.GammaDual
import Submission.NK.RankTheoryDeep.CharModule

/-!
# Auxiliary lemmas for the `ℤ_2`-rank bound on the local units at a place above `2`

The general (non-arithmetic) inputs of `NK.NUV2.localUnits_two`:

* `padicInt_eq_zero_of_forall_dvd_pow` — separation of `ℤ_ℓ`: an element divisible by every power
  of `ℓ` is zero;
* `additive_ofMul_pow` — powers become natural multiples under `Additive.ofMul`;
* `mem_closure_subtype` — traces of a closure in a subgroup;
* `rank_dual_le_of_cover_subtype` — **the cover engine**: if a subgroup `U ≤ A` is covered by
  `d` elements modulo `ℓ`-th powers, then `rank_{ℤ_ℓ} Hom_cts(U, ℤ_ℓ) ≤ d`;
* `rank_dual_le_of_finiteIndex` — a finite-index subgroup has the same `ℤ_ℓ`-rank of the dual.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NK.NUV2.LocalUnitsAux

universe u

/-- **Separation of `ℤ_ℓ`**: an element of `ℤ_ℓ` divisible by every power of `ℓ` is zero. -/
theorem padicInt_eq_zero_of_forall_dvd_pow {p : ℕ} [Fact p.Prime] {a : PadicInt p}
    (h : ∀ n : ℕ, ∃ b : PadicInt p, a = (p : PadicInt p) ^ n * b) : a = 0 := by
  by_contra ha
  have hkey : ∀ n : ℕ, n ≤ a.valuation := by
    intro n
    obtain ⟨b, hb⟩ := h n
    refine (PadicInt.mem_span_pow_iff_le_valuation a ha n).mp ?_
    rw [hb]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have := hkey (a.valuation + 1)
  omega

/-- `Additive.ofMul` turns powers into natural multiples. -/
theorem additive_ofMul_pow {G : Type*} [Monoid G] (x : G) (n : ℕ) :
    Additive.ofMul (x ^ n) = n • Additive.ofMul x := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, show Additive.ofMul (x ^ n * x) = Additive.ofMul (x ^ n) + Additive.ofMul x
        from rfl, ih, succ_nsmul]

/-- **Traces of a closure.**  If `s ⊆ U` is a set of elements of a subgroup `U ≤ G`, then an
element `x ∈ U` whose ambient class lies in the closure of `s` lies in the closure of the traces of
`s` inside `U`. -/
theorem mem_closure_subtype {G : Type*} [Group G] {U : Subgroup G} {s : Set G} (hs : s ⊆ U)
    {x : G} (hx : x ∈ Subgroup.closure s) :
    (⟨x, (Subgroup.closure_le U).mpr hs hx⟩ : U) ∈ Subgroup.closure {y : U | (y : G) ∈ s} := by
  induction hx using Subgroup.closure_induction with
  | mem y hy => exact Subgroup.subset_closure hy
  | one => exact Subgroup.one_mem _
  | mul y z hy hz ihy ihz => exact Subgroup.mul_mem _ ihy ihz
  | inv y hy ihy => exact Subgroup.inv_mem _ ihy

/-- **The cover engine.**  If every element of a subgroup `U ≤ A` is the product of an element of
the subgroup generated by `g : Fin d → A` and an `ℓ`-th power of an element of `U`, then every
continuous additive character of `U` is determined by its values on the `g i`, so
`rank_{ℤ_ℓ} Dual U ℓ ≤ d`. -/
theorem rank_dual_le_of_cover_subtype {A : Type u} [CommGroup A] [TopologicalSpace A]
    {ℓ : ℕ} [Fact ℓ.Prime] {d : ℕ} (U : Subgroup A) (g : Fin d → A) (hg : ∀ i, g i ∈ U)
    (hcover : ∀ a ∈ U, ∃ z ∈ Subgroup.closure (Set.range g), ∃ w ∈ U, a = z * w ^ ℓ) :
    Module.rank (PadicInt ℓ) (NK.Reconstruct.Dual ↥U ℓ) ≤ (d : Cardinal) := by
  classical
  let gen : Fin d → U := fun i => ⟨g i, hg i⟩
  let Φ : NK.Reconstruct.Dual ↥U ℓ →ₗ[PadicInt ℓ] (Fin d → PadicInt ℓ) :=
    { toFun := fun χ i => χ (Additive.ofMul (gen i))
      map_add' := by intro x y; funext i; rfl
      map_smul' := by intro a x; funext i; rfl }
  have hset : {y : U | (y : A) ∈ Set.range g} = Set.range gen := by
    ext y
    constructor
    · rintro ⟨i, hi⟩
      exact ⟨i, Subtype.ext hi⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, rfl⟩
  have hgs : Set.range g ⊆ U := by rintro y ⟨i, rfl⟩; exact hg i
  have hcoverU : ∀ a : U, ∃ z ∈ Subgroup.closure (Set.range gen), ∃ w : U, a = z * w ^ ℓ := by
    intro a
    obtain ⟨z, hz, w, hw, hzw⟩ := hcover (a : A) a.2
    refine ⟨⟨z, (Subgroup.closure_le U).mpr hgs hz⟩, ?_, ⟨w, hw⟩, ?_⟩
    · rw [← hset]
      exact mem_closure_subtype hgs hz
    · apply Subtype.ext
      simpa using hzw
  have hinj : Function.Injective Φ := by
    intro χ ψ hχψ
    have hzero : ∀ i, (χ - ψ) (Additive.ofMul (gen i)) = 0 := by
      intro i
      have hi : χ (Additive.ofMul (gen i)) = ψ (Additive.ofMul (gen i)) := congrFun hχψ i
      rw [show (χ - ψ) (Additive.ofMul (gen i))
          = χ (Additive.ofMul (gen i)) - ψ (Additive.ofMul (gen i)) from rfl, hi, sub_self]
    have hvan : ∀ z ∈ Subgroup.closure (Set.range gen), (χ - ψ) (Additive.ofMul z) = 0 := by
      intro z hz
      induction hz using Subgroup.closure_induction with
      | mem y hy => obtain ⟨i, rfl⟩ := hy; exact hzero i
      | one => simp
      | mul y z hy hz ihy ihz =>
          rw [show Additive.ofMul (y * z) = Additive.ofMul y + Additive.ofMul z from rfl,
            map_add, ihy, ihz, add_zero]
      | inv y hy ihy =>
          rw [show Additive.ofMul y⁻¹ = -Additive.ofMul y from rfl, map_neg, ihy, neg_zero]
    have hpow : ∀ n : ℕ, ∀ a : U, ∃ t : PadicInt ℓ,
        (χ - ψ) (Additive.ofMul a) = (ℓ : PadicInt ℓ) ^ n * t := by
      intro n
      induction n with
      | zero => intro a; exact ⟨(χ - ψ) (Additive.ofMul a), by simp⟩
      | succ n ih =>
          intro a
          obtain ⟨z, hz, w, hzw⟩ := hcoverU a
          obtain ⟨t, ht⟩ := ih w
          refine ⟨t, ?_⟩
          have h1 : (χ - ψ) (Additive.ofMul (z * w ^ ℓ))
              = (χ - ψ) (Additive.ofMul z) + (χ - ψ) (Additive.ofMul (w ^ ℓ)) := by
            rw [show Additive.ofMul (z * w ^ ℓ)
              = Additive.ofMul z + Additive.ofMul (w ^ ℓ) from rfl, map_add]
          have h2 : (χ - ψ) (Additive.ofMul (w ^ ℓ)) = (ℓ : ℕ) • (χ - ψ) (Additive.ofMul w) := by
            rw [additive_ofMul_pow, map_nsmul]
          have hstep : (χ - ψ) (Additive.ofMul a)
              = (ℓ : PadicInt ℓ) * (χ - ψ) (Additive.ofMul w) := by
            rw [hzw, h1, h2, hvan z hz, zero_add, nsmul_eq_mul]
          rw [hstep, ht, pow_succ]
          ring
    have hfin : χ - ψ = 0 := by
      apply Subtype.ext
      refine AddMonoidHom.ext fun y => ?_
      exact padicInt_eq_zero_of_forall_dvd_pow
        (fun n => by simpa using hpow n (Additive.toMul y))
    exact sub_eq_zero.mp hfin
  have h := Φ.lift_rank_le_of_injective hinj
  have hrank : Module.rank (PadicInt ℓ) (Fin d → PadicInt ℓ) = (d : Cardinal) :=
    rank_fin_fun d
  rw [hrank, Cardinal.lift_natCast] at h
  have h'' : Cardinal.lift.{0, u} (Module.rank (PadicInt ℓ) (NK.Reconstruct.Dual ↥U ℓ)) ≤
      Cardinal.lift.{0, u} (d : Cardinal.{u}) := by
    simpa only [Cardinal.lift_natCast] using h
  exact (Cardinal.lift_le.{0, u}).mp h''

/-- **Finite-index subgroups have the same dual rank.**  A continuous additive character of `A`
vanishing on a finite-index subgroup `U` is zero (its image is finite hence trivial). -/
theorem rank_dual_le_of_finiteIndex {A : Type u} [CommGroup A] [TopologicalSpace A] {ℓ : ℕ}
    [Fact ℓ.Prime] (U : Subgroup A) [U.FiniteIndex] :
    Module.rank (PadicInt ℓ) (NK.Reconstruct.Dual A ℓ) ≤
      Module.rank (PadicInt ℓ) (NK.Reconstruct.Dual ↥U ℓ) := by
  classical
  let Φ : NK.Reconstruct.Dual A ℓ →ₗ[PadicInt ℓ] NK.Reconstruct.Dual ↥U ℓ :=
    { toFun := fun χ => ⟨χ.1.comp (MonoidHom.toAdditive U.subtype),
        χ.2.comp continuous_subtype_val⟩
      map_add' := by intro x y; rfl
      map_smul' := by intro a x; rfl }
  have hinj : Function.Injective Φ := by
    intro χ ψ hχψ
    have hagree : ∀ u : U, χ (Additive.ofMul (u : A)) = ψ (Additive.ofMul (u : A)) := by
      intro u
      have h := congrArg (fun z : NK.Reconstruct.Dual ↥U ℓ =>
        (z : Additive ↥U →+ PadicInt ℓ) (Additive.ofMul u)) hχψ
      simpa [Φ] using h
    apply Subtype.ext
    refine AddMonoidHom.ext fun y => ?_
    set a : A := Additive.toMul y with ha
    have hmem : a ^ U.index ∈ U := Subgroup.pow_index_mem U a
    have h1 : χ (Additive.ofMul (a ^ U.index)) = ψ (Additive.ofMul (a ^ U.index)) :=
      hagree ⟨a ^ U.index, hmem⟩
    rw [additive_ofMul_pow, map_nsmul, map_nsmul] at h1
    have h' : (U.index : PadicInt ℓ) * χ (Additive.ofMul a)
        = (U.index : PadicInt ℓ) * ψ (Additive.ofMul a) := by
      simpa [nsmul_eq_mul] using h1
    have hne : (U.index : PadicInt ℓ) ≠ 0 := by
      exact_mod_cast (Subgroup.FiniteIndex.index_ne_zero (H := U))
    have hfin : χ (Additive.ofMul a) = ψ (Additive.ofMul a) := mul_left_cancel₀ hne h'
    have hy : y = Additive.ofMul a := by
      rw [ha]
      exact (ofMul_toMul y).symm
    rwa [hy]
  have h := Φ.lift_rank_le_of_injective hinj
  exact Cardinal.lift_le.mp h

end NK.NUV2.LocalUnitsAux
