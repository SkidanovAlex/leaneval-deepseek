import Mathlib
import Submission.NK.NUV2.BC2Imports

open scoped NumberField
open IsDedekindDomain

namespace NK.NUV2

/-- In the ring of integers `A = q.adicCompletionIntegers K` of the `q`-adic completion of a
number field `K`, where `q` lies over `(2)`, the ideal generated by `2` is the `e`-th power of the
maximal ideal, `e = q.asIdeal.ramificationIdx ℤ`.
Proof sketch: in `𝓞 K`, `(2) · 𝓞 K = q ^ e * Q` with `q ⊔ Q = ⊤`
(`Ideal.eq_prime_pow_mul_coprime` plus
`Ideal.IsDedekindDomain.ramificationIdx_eq_normalizedFactors_count`); applying
`Ideal.map (algebraMap (𝓞 K) A)` and using
`Commons.NumberTheory.NumberField.adicCompletionIntegers_maximalIdeal_eq_map`
(`m = q.asIdeal.map (algebraMap (𝓞 K) A)`) gives `2 * A = m ^ e * Ideal.map _ Q`; the second factor
is `⊤` because `m ⊔ Ideal.map _ Q = Ideal.map _ (q ⊔ Q) = ⊤` and a proper ideal of the local ring
`A` lies in `m` (`IsLocalRing.le_maximalIdeal`). -/
theorem two_span_eq_maximalIdeal_pow (K : Type) [Field K] [NumberField K]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hlies : q.asIdeal.LiesOver (Ideal.span {(2 : ℤ)})) :
    Ideal.span {(2 : q.adicCompletionIntegers K)} =
      (IsLocalRing.maximalIdeal (q.adicCompletionIntegers K)) ^ (q.asIdeal.ramificationIdx ℤ) := by
  classical
  let T := NumberField.RingOfIntegers K
  let A := q.adicCompletionIntegers K
  let p : Ideal ℤ := Ideal.span {(2 : ℤ)}
  let I : Ideal T := p.map (algebraMap ℤ T)
  -- `I` is the principal ideal generated by `2` in `𝓞 K`
  have hIeq : I = Ideal.span {(2 : T)} := by
    simp only [I, p, Ideal.map_span, Set.image_singleton, map_ofNat]
  have hI : I ≠ ⊥ := by
    rw [hIeq]
    intro h
    have h2 : (2 : T) = 0 := Ideal.span_singleton_eq_bot.mp h
    norm_num at h2
  -- factor `I = q ^ e * Q` with `q ⊔ Q = ⊤`
  obtain ⟨Q, hQsup, hQeq⟩ := Ideal.eq_prime_pow_mul_coprime hI q.asIdeal
  -- identify the exponent with the ramification index
  haveI := hlies
  have he : Multiset.count q.asIdeal (UniqueFactorizationMonoid.normalizedFactors I)
      = q.asIdeal.ramificationIdx ℤ :=
    (Ideal.IsDedekindDomain.ramificationIdx_eq_normalizedFactors_count p q.asIdeal hI).symm
  have hQeq' : I = q.asIdeal ^ (q.asIdeal.ramificationIdx ℤ) * Q := by
    rw [← he]; exact hQeq
  -- push the factorization to the completion
  have hmap : I.map (algebraMap T A)
      = (IsLocalRing.maximalIdeal A) ^ (q.asIdeal.ramificationIdx ℤ)
        * (Q.map (algebraMap T A)) := by
    rw [hQeq', Ideal.map_mul, Ideal.map_pow,
      ← Commons.NumberTheory.NumberField.adicCompletionIntegers_maximalIdeal_eq_map q]
  have hImap : I.map (algebraMap T A) = Ideal.span {(2 : A)} := by
    rw [hIeq, Ideal.map_span, Set.image_singleton,
      show (algebraMap T A) (2 : T) = (2 : A) from map_ofNat (algebraMap T A) 2]
  -- the coprime factor becomes the whole ring after completing
  have hsup : IsLocalRing.maximalIdeal A ⊔ Q.map (algebraMap T A) = ⊤ := by
    have h := congrArg (Ideal.map (algebraMap T A)) hQsup
    rw [Ideal.map_sup, Ideal.map_top,
      ← Commons.NumberTheory.NumberField.adicCompletionIntegers_maximalIdeal_eq_map q] at h
    exact h
  have hQtop : Q.map (algebraMap T A) = ⊤ := by
    by_contra hQne
    have hle : Q.map (algebraMap T A) ≤ IsLocalRing.maximalIdeal A :=
      IsLocalRing.le_maximalIdeal hQne
    have htop : (⊤ : Ideal A) ≤ IsLocalRing.maximalIdeal A := by
      rw [← hsup]; exact sup_le le_rfl hle
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top (le_antisymm le_top htop)
  calc Ideal.span {(2 : A)}
      = I.map (algebraMap T A) := hImap.symm
    _ = (IsLocalRing.maximalIdeal A) ^ (q.asIdeal.ramificationIdx ℤ)
          * (Q.map (algebraMap T A)) := hmap
    _ = (IsLocalRing.maximalIdeal A) ^ (q.asIdeal.ramificationIdx ℤ) := by
          rw [hQtop, Ideal.mul_top]

end NK.NUV2
