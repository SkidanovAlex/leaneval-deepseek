import Mathlib
import Submission.NK.NUV2.TowerRank.normClassSubgroup_fixedField_commutator
import Submission.NK.NUV2.ArtinBridge.normClassSubgroup_le_of_intermediateField_le
import Submission.NK.NUV2.ArtinBridge.index_eq_card_abelianization_of_fundamentalClassElement

/-!
# The norm class subgroup of `F^H` depends only on the image of `H` in `Gal(E/K)^ab`

Let `K ⊆ E` be a finite Galois extension of number fields with group `G = Gal(E/K)`, and let
`H ≤ G` be **normal**.  The fixed field `F = E^H` is then Galois over `K`, and so is
`F'' = E^{H ⊔ [G,G]}` (the join of `H` with the derived subgroup of `G`).  The claim of this file
is that the two norm class subgroups of the idèle class group coincide:

  `N_{F/K} C_F = N_{F''/K} C_{F''}`.

Since `H ⊆ H ⊔ [G,G]` we have `F'' ⊆ F` and hence, by the tower property of norm subgroups,
`N_{F/K} C_F ≤ N_{F''/K} C_{F''}`.  The reverse inclusion comes from an index count: both
subgroups have finite index in `C_K` and

  `[C_K : N_{L/K} C_L] = |Gal(L/K)^ab|`

(the norm index theorem, proved from the fundamental class element `hFC` in
`NK.NUV2.ArtinBridge.index_eq_card_abelianization_of_fundamentalClassElement`), while

  `Gal(F/K)^ab = (G ⧸ H)^ab`  and  `Gal(F''/K)^ab = (G ⧸ (H ⊔ [G,G]))^ab`

are equicardinal, both being the quotient `G ⧸ (H ⊔ [G,G])`:

* `(G ⧸ H) ⧸ [(G ⧸ H), (G ⧸ H)] = (G ⧸ H) ⧸ (H ⊔ [G,G]).map (mk' H) ≃* G ⧸ (H ⊔ [G,G])`
  by Noether's third isomorphism theorem (the commutator of the quotient `G ⧸ H` is generated by
  the image of `[G,G]`, because `H` maps to `1`);

* `G ⧸ (H ⊔ [G,G])` is abelian, hence equal to its own abelianisation.

Mathematically this is the statement that the norm group attached to an *abelian* subextension
depends only on the image of the corresponding subgroup in the abelianisation `G^ab`, i.e. the
`H`-part of the norm limitation theorem.  It is the general form of
`NK.NUV2.TowerRank.normClassSubgroup_fixedField_commutator` (the case `H = ⊤`, where
`F'' = E^{[G,G]}` is the maximal abelian subextension), and it needs no Frobenius normalisation of
the Artin map: only the norm index theorem for the two Galois levels `F/K` and `F''/K`.
-/

namespace NK.NUV2.TowerRank

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

/-! ## The group-theoretic input: the abelianisation of a quotient -/

/-- **The abelianisation of `G ⧸ H` is `G ⧸ (H ⊔ [G,G])`.**  For a normal subgroup `H` of a group
`G`, the abelianisation of the quotient `G ⧸ H` has the same cardinality as the abelianisation of
`G ⧸ (H ⊔ [G,G])` -- both are `G` modulo the join of `H` with the derived subgroup.

Indeed `[(G ⧸ H), (G ⧸ H)] = (H ⊔ [G,G]).map (mk' H)` (the image of the derived subgroup of `G`
under the quotient map), so by Noether's third isomorphism theorem
`(G ⧸ H)^ab = (G ⧸ H) ⧸ (H ⊔ [G,G]).map (mk' H) ≃* G ⧸ (H ⊔ [G,G])`, and `G ⧸ (H ⊔ [G,G])` is
abelian (it is a quotient of `G^ab`), hence is its own abelianisation. -/
theorem natCard_abelianization_quotient_sup_commutator {G : Type*} [Group G]
    (H : Subgroup G) [H.Normal] :
    Nat.card (Abelianization (G ⧸ H)) = Nat.card (Abelianization (G ⧸ (H ⊔ commutator G))) := by
  -- the image of the derived subgroup of `G` is the derived subgroup of `G ⧸ H`
  have hmapC : (commutator G).map (QuotientGroup.mk' H) = commutator (G ⧸ H) := by
    rw [map_commutator_eq, MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective H)]
    rfl
  -- `H` maps to `1` in `G ⧸ H`
  have hmapH : (H : Subgroup G).map (QuotientGroup.mk' H) = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    intro x hx
    rw [QuotientGroup.ker_mk']
    exact hx
  have hHs : (H ⊔ commutator G).map (QuotientGroup.mk' H) = commutator (G ⧸ H) := by
    rw [Subgroup.map_sup, hmapH, hmapC, bot_sup_eq]
  -- Noether's third isomorphism theorem
  have hiso : Abelianization (G ⧸ H) ≃* G ⧸ (H ⊔ commutator G) :=
    (QuotientGroup.quotientMulEquivOfEq hHs.symm).trans
      (QuotientGroup.quotientQuotientEquivQuotient H (H ⊔ commutator G) le_sup_left)
  -- `G ⧸ (H ⊔ [G,G])` is abelian, so it is its own abelianisation
  have hmapC2 : (commutator G).map (QuotientGroup.mk' (H ⊔ commutator G)) =
      commutator (G ⧸ (H ⊔ commutator G)) := by
    rw [map_commutator_eq,
      MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective (H ⊔ commutator G))]
    rfl
  have hCbot : (commutator G).map (QuotientGroup.mk' (H ⊔ commutator G)) = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    intro x hx
    rw [QuotientGroup.ker_mk']
    exact Subgroup.mem_sup_right hx
  have hcommbot : commutator (G ⧸ (H ⊔ commutator G)) = ⊥ := by
    rw [← hmapC2]
    exact hCbot
  have hiso2 : Abelianization (G ⧸ (H ⊔ commutator G)) ≃* (G ⧸ (H ⊔ commutator G)) :=
    (QuotientGroup.quotientMulEquivOfEq hcommbot).trans QuotientGroup.quotientBot
  rw [Nat.card_congr hiso.toEquiv, Nat.card_congr hiso2.toEquiv]

/-- Two subgroups of a group, one contained in the other, with a common finite index (and equal
indices), are equal. -/
private theorem subgroup_eq_of_le_of_index_eq {G : Type*} [Group G] {A B : Subgroup G} (h : A ≤ B)
    (hidx : A.index = B.index) (hne : A.index ≠ 0) : A = B := by
  have hmul : A.relIndex B * B.index = A.index := Subgroup.relIndex_mul_index h
  have hB : B.index ≠ 0 := by rw [← hidx]; exact hne
  have h1 : A.relIndex B * B.index = 1 * B.index := by rw [one_mul, hmul, hidx]
  exact le_antisymm h (Subgroup.relIndex_eq_one.mp
    (Nat.mul_right_cancel (Nat.pos_of_ne_zero hB) h1))

/-! ## The arithmetic statement -/

/-- **The norm class subgroup of the fixed field of `H` depends only on `H` modulo `[G,G]`.**

For `K ⊆ E` a finite Galois extension of number fields with group `G = Gal(E/K)` and `H ≤ G` a
**normal** subgroup, the norm class subgroups of the fixed fields of `H` and of `H ⊔ [G,G]`
coincide:

  `N_{E^H/K} C_{E^H} = N_{E^{H ⊔ [G,G]}/K} C_{E^{H ⊔ [G,G]}}`.

Both inclusions: `H ⊆ H ⊔ [G,G]` gives `E^{H ⊔ [G,G]} ⊆ E^H` and hence the inclusion
`N_{E^H/K} C_{E^H} ≤ N_{E^{H ⊔ [G,G]}/K} C_{E^{H ⊔ [G,G]}}` by the tower property, and the reverse
inclusion follows because the two subgroups have the same finite index, namely
`|Gal(E^H/K)^ab| = |Gal(E^{H ⊔ [G,G]}/K)^ab| = |(G ⧸ (H ⊔ [G,G]))^ab|` (norm index theorem from
`hFC` plus `NK.NUV2.TowerRank.natCard_abelianization_quotient_sup_commutator`). -/
theorem normClassSubgroup_fixedField_sup_commutator_of_normal
    (hFC : NK.GlobalCFTdeep.FundamentalClassElement)
    {K E : Type*} [Field K] [NumberField K] [Field E] [NumberField E] [Algebra K E]
    [FiniteDimensional K E] [IsGalois K E] (H : Subgroup Gal(E/K)) [H.Normal] :
    NK.GlobalCFT.Idele.normClassSubgroup K ↥(IntermediateField.fixedField H) =
      NK.GlobalCFT.Idele.normClassSubgroup K
        ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) := by
  classical
  -- the two fixed fields are number fields, finite and Galois over `K`
  letI : NumberField ↥(IntermediateField.fixedField H) := inferInstance
  letI : FiniteDimensional K ↥(IntermediateField.fixedField H) := inferInstance
  letI : IsGalois K ↥(IntermediateField.fixedField H) := inferInstance
  letI : NumberField ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) :=
    inferInstance
  letI : FiniteDimensional K ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) :=
    inferInstance
  letI : IsGalois K ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) :=
    inferInstance
  -- `E^{H ⊔ [G,G]} ⊆ E^H`, since `H ≤ H ⊔ [G,G]`
  have hsub : IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆) ≤
      IntermediateField.fixedField H :=
    IntermediateField.fixedField_le le_sup_left
  -- the tower `K ⊆ E^{H ⊔ [G,G]} ⊆ E^H` gives the easy inclusion
  letI : Algebra ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))
      ↥(IntermediateField.fixedField H) := (IntermediateField.inclusion hsub).toRingHom.toAlgebra
  haveI : IsScalarTower K ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))
      ↥(IntermediateField.fixedField H) := IsScalarTower.of_algebraMap_eq' rfl
  haveI : FiniteDimensional ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))
      ↥(IntermediateField.fixedField H) :=
    Module.Finite.of_restrictScalars_finite K
      ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))
      ↥(IntermediateField.fixedField H)
  have hle : NK.GlobalCFT.Idele.normClassSubgroup K ↥(IntermediateField.fixedField H) ≤
      NK.GlobalCFT.Idele.normClassSubgroup K
        ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) :=
    NK.GlobalCFT.Idele.normClassSubgroup_le_of_tower (K := K)
      (L := ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)))
      (M := ↥(IntermediateField.fixedField H))
  -- the norm index theorem for the two levels
  have hidx1 : (NK.GlobalCFT.Idele.normClassSubgroup K
        ↥(IntermediateField.fixedField H)).index =
      Nat.card (Abelianization
        (↥(IntermediateField.fixedField H) ≃ₐ[K] ↥(IntermediateField.fixedField H))) :=
    NK.NUV2.ArtinBridge.index_eq_card_abelianization_of_fundamentalClassElement hFC (K := K)
      (L := ↥(IntermediateField.fixedField H))
  have hidx2 : (NK.GlobalCFT.Idele.normClassSubgroup K
        ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))).index =
      Nat.card (Abelianization
        (↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) ≃ₐ[K]
          ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)))) :=
    NK.NUV2.ArtinBridge.index_eq_card_abelianization_of_fundamentalClassElement hFC (K := K)
      (L := ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)))
  -- the Galois groups of the two fixed fields are the quotients `G ⧸ H` and `G ⧸ (H ⊔ [G,G])`
  have he1 : Gal(E/K) ⧸ H ≃*
      (↥(IntermediateField.fixedField H) ≃ₐ[K] ↥(IntermediateField.fixedField H)) :=
    IsGalois.normalAutEquivQuotient (K := K) (L := E) H
  have he2 : Gal(E/K) ⧸ (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆) ≃*
      (↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) ≃ₐ[K]
        ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))) :=
    IsGalois.normalAutEquivQuotient (K := K) (L := E) (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)
  have hcard1 : Nat.card (Abelianization
        (↥(IntermediateField.fixedField H) ≃ₐ[K] ↥(IntermediateField.fixedField H))) =
      Nat.card (Abelianization (Gal(E/K) ⧸ H)) :=
    Nat.card_congr he1.abelianizationCongr.symm.toEquiv
  have hcard2 : Nat.card (Abelianization
        (↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) ≃ₐ[K]
          ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)))) =
      Nat.card (Abelianization (Gal(E/K) ⧸ (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))) :=
    Nat.card_congr he2.abelianizationCongr.symm.toEquiv
  -- the abelianisations are equicardinal
  have hcard : Nat.card (Abelianization
        (↥(IntermediateField.fixedField H) ≃ₐ[K] ↥(IntermediateField.fixedField H))) =
      Nat.card (Abelianization
        (↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)) ≃ₐ[K]
          ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆)))) := by
    rw [hcard1, hcard2]
    exact natCard_abelianization_quotient_sup_commutator H
  -- equal finite indices and the inclusion give the equality
  have hAB : (NK.GlobalCFT.Idele.normClassSubgroup K
        ↥(IntermediateField.fixedField H)).index =
      (NK.GlobalCFT.Idele.normClassSubgroup K
        ↥(IntermediateField.fixedField (H ⊔ ⁅(⊤ : Subgroup Gal(E/K)), ⊤⁆))).index :=
    hidx1.trans (hcard.trans hidx2.symm)
  have hne : (NK.GlobalCFT.Idele.normClassSubgroup K
      ↥(IntermediateField.fixedField H)).index ≠ 0 := by
    rw [hidx1]
    exact Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
  exact subgroup_eq_of_le_of_index_eq hle hAB hne

end NK.NUV2.TowerRank
