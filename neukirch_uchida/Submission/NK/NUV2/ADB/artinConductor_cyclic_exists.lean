import Mathlib
import Submission.NK.CFTLib.ArtinReciprocityIdeal.Conductor
import Submission.NK.CFTLib.ArtinReciprocityIdeal.AbelianReduction
import Submission.NK.NUV2.ARL.kernelLeOfAuxField
import Submission.NK.CFTLib.ARL.auxField_exists_B
import Submission.NK.CFTLib.ArtinReciprocityIdeal.exists_admissible
import Submission.NK.CFTLib.ArtinReciprocityIdeal.langCyclicRelIndex
import Submission.NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_span_eq_one_of_kernelLe_of_relIndex

/-!
# The cyclic Artin conductor: existence

`NK.NUV2.ADB.artinConductor_cyclic_exists`: for a finite **cyclic** Galois extension `L/K` of
number fields there is a positive integer `m` (an Artin conductor of `L/K`) such that every prime
`p ∤ m` is unramified in `L` and the ideal-theoretic Artin symbol kills every principal ideal
`(a)` with `a ≡ 1 mod m` and `a` totally positive (see
`NK.CFTLib.artinConductor`, `Submission/Work/CFTLib/ArtinReciprocityIdeal/Conductor.lean`).

This is Lang, *Algebraic Number Theory*, Chapter X §2, Theorem 2 (Childress, *Class Field Theory*,
Chapter 5, Theorem 2.1(ii)), the cyclic case of the ideal-theoretic reciprocity law.  The proof
assembles the two halves of Lang's Theorem 2, both of which are proved in this workspace:

* **kernel containment** `ker ψ ∩ I(m) ⊆ P(m)·𝔑(m)` — the transfer of Artin's lemma
  (`NK.NUV2.ARL.kernelLeOfAuxField`), at an admissible modulus
  (`NK.CFTLib.ArtinReciprocityIdeal.exists_admissible`) for which the auxiliary fields of
  Artin's lemma exist (`NK.CFTLib.ARL.auxField_exists_B`);
* **index inequality** `[I(m) : P(m)·𝔑(m)] ≥ [L : K]` — the idèle–ideal dictionary plus the norm
  index theorem (`NK.CFTLib.ArtinReciprocityIdeal.langCyclicRelIndex`);

which give `ker ψ ∩ I(m) = P(m)·𝔑(m)`, hence `P(m) ⊆ ker ψ`
(`NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_span_eq_one_of_kernelLe_of_relIndex`): the product
condition of a conductor.  Multiplying the modulus by the absolute norm of the relative different
takes care of the ramification condition.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open NK.Chebotarev
open NumberField
open scoped NumberField IsMulCommutative

namespace NK.NUV2.ADB

/-- **Lang's kernel containment**: there is an admissible modulus `m > 0` containing every prime
ramified in the cyclic extension `L/K` such that every fractional ideal `A` of `K` coprime to
`(m)` whose Artin symbol is trivial lies in the subgroup generated by the principal ray `P(m)` and
the norm group `𝔑(m)`.

This is the crux of Lang, *Algebraic Number Theory*, Chapter X §2, Theorem 2.  It is the transfer
of Artin's lemma (`NK.NUV2.ARL.kernelLeOfAuxField`) applied at the admissible modulus supplied by
`NK.CFTLib.ArtinReciprocityIdeal.exists_admissible`; the auxiliary fields required by the
transfer are supplied by `NK.CFTLib.ARL.auxField_exists_B`. -/
theorem langCyclicKernelLe' (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    [IsMulCommutative (Gal(L/K))] :
    ∃ m : ℕ, 0 < m ∧ NK.CFTLib.ArtinReciprocityIdeal.IsAdmissible K L m ∧
      (∀ p : NK.Chebotarev.PrimeIdeal K,
        ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
        (m : 𝓞 K) ∈ p.asIdeal) ∧
      ∀ A : NK.CFTLib.ArtinReciprocityIdeal.Frac K,
        NK.CFTLib.ArtinReciprocityIdeal.FracCoprime m A →
        NK.CFTLib.Arl.artinSym (K := K) (L := L) IsMulCommutative.is_comm.comm A = 1 →
        A ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K m ⊔
            NK.CFTLib.ArtinReciprocityIdeal.normRay K L m := by
  obtain ⟨m, hm, hadm, hram⟩ :=
    NK.CFTLib.ArtinReciprocityIdeal.exists_admissible (K := K) (L := L)
  exact ⟨m, hm, hadm, hram, fun A hcop hsym =>
    NK.NUV2.ARL.kernelLeOfAuxField K L m hm
      (NK.CFTLib.ARL.auxField_exists_B K L m hm) hram A hcop hsym⟩

/-- **The product condition of a conductor, from the triviality of the Artin symbol of the
principal ideals `(a)`, `a ≡ 1 mod m` totally positive.**  This is the (elementary) passage from
the Artin-symbol form to `NK.CFTLib.artinKillsPrincipal`; it is the copy of
`NK.CFTLib.ArtinReciprocityIdeal.artinKillsPrincipal_of_artinSymbolKillsPrincipal` for the
unfolded hypothesis. -/
theorem artinKillsPrincipal_of_span_eq_one {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    [IsMulCommutative (Gal(L/K))] {m : ℕ}
    (hram : ∀ p : NK.Chebotarev.PrimeIdeal K,
      ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
      (m : 𝓞 K) ∈ p.asIdeal)
    (h : ∀ a : 𝓞 K, a - 1 ∈ Ideal.span {(m : 𝓞 K)} → (∀ φ : K →+* ℝ, 0 < φ (a : K)) →
      NK.CFTLib.ArtinReciprocityIdeal.artinSymbol (K := K) (L := L) (Ideal.span {a}) = 1) :
    NK.CFTLib.artinKillsPrincipal K L m := by
  intro a ha hpos s e σ hs hfac hfrob
  have hcomm : ∀ a b : Gal(L/K), a * b = b * a := fun a b => IsMulCommutative.is_comm.comm a b
  have hunr : ∀ p ∈ s, NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p :=
    fun p hp => by
      by_contra hcon
      exact hs p hp (hram p hcon)
  calc (s.toList.map (fun p => σ p ^ e p)).prod
      = (s.toList.map (fun p => (frobAtPrime (K := K) (L := L) p) ^ e p)).prod :=
        NK.CFTLib.frobAtPrime_prod_irrel (K := K) (L := L) hcomm s e σ hunr hfrob
    _ = ∏ p ∈ s, (frobAtPrime (K := K) (L := L) p) ^ e p :=
        NK.CFTLib.ArtinReciprocityIdeal.toList_map_prod_eq_finset_prod s _
    _ = ∏ p ∈ s, (NK.CFTLib.ArtinReciprocityIdeal.frobSymbol (K := K) (L := L) p.asIdeal)
          ^ e p := by
        refine Finset.prod_congr rfl fun p hp => ?_
        show (frobAtPrime (K := K) (L := L) p) ^ e p
          = (NK.CFTLib.ArtinReciprocityIdeal.frobSymbol (K := K) (L := L) p.asIdeal) ^ e p
        rw [← NK.CFTLib.ArtinReciprocityIdeal.frobSymbol_eq (K := K) (L := L) p (hunr p hp)]
    _ = NK.CFTLib.ArtinReciprocityIdeal.artinSymbol (K := K) (L := L)
          (∏ p ∈ s, p.asIdeal ^ e p) :=
        (NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_finset_prod (K := K) (L := L) s e).symm
    _ = NK.CFTLib.ArtinReciprocityIdeal.artinSymbol (K := K) (L := L) (Ideal.span {a}) := by
        rw [← hfac]
    _ = 1 := h a ha hpos

/-- **The ramification bookkeeping of a conductor**: if `m` satisfies the product condition, then
`m · N(𝔡_{L/K})` is a conductor, i.e. `NK.CFTLib.artinConductor K L (m · N(𝔡_{L/K}))`. -/
theorem artinConductor_of_artinKillsPrincipal' {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] {m : ℕ} (hm : 0 < m)
    (h : NK.CFTLib.artinKillsPrincipal K L m) :
    NK.CFTLib.artinConductor K L (m * Ideal.absNorm (differentIdeal (𝓞 K) (𝓞 L))) := by
  have hdiff_ne : Ideal.absNorm (differentIdeal (𝓞 K) (𝓞 L)) ≠ 0 := by
    rw [Ideal.absNorm_ne_zero_iff]
    exact Ring.HasFiniteQuotients.finiteQuotient
      (differentIdeal_ne_bot (A := 𝓞 K) (B := 𝓞 L))
  refine ⟨Nat.mul_pos hm (Nat.pos_of_ne_zero hdiff_ne), ?_, ?_⟩
  · intro p hp
    refine NK.CFTLib.ramificationIdxIn_eq_one_of_absNorm_differentIdeal_notMem p ?_
    intro hmem
    apply hp
    push_cast
    exact p.asIdeal.mul_mem_left _ hmem
  · exact h.mono (dvd_mul_right m _)

theorem artinConductor_cyclic_exists (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    [IsCyclic (L ≃ₐ[K] L)] :
    ∃ m : ℕ, NK.CFTLib.artinConductor K L m := by
  haveI : IsMulCommutative (L ≃ₐ[K] L) := IsCyclic.isMulCommutative
  obtain ⟨m, hm, hram, hspan⟩ :=
    NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_span_eq_one_of_kernelLe_of_relIndex K L
      (langCyclicKernelLe' K L)
      (fun m hm hram hadm =>
        NK.CFTLib.ArtinReciprocityIdeal.langCyclicRelIndex K L m hm hram hadm)
  exact ⟨_, artinConductor_of_artinKillsPrincipal' hm
    (artinKillsPrincipal_of_span_eq_one (K := K) (L := L) hram hspan)⟩

end NK.NUV2.ADB
