import Mathlib
import Submission.NK.NUV2.LCLeaves
import Submission.NK.BrauerHasse.Profinite

namespace NK.NUV2.LC

open scoped Pointwise Topology

set_option linter.style.haveILetI false

/-- **Orbit separation for the Galois action on places** (lemma `(L5)` of the route-B design in
`Submission/Work/NUV2/LC/RouteB/decompContainment_B.lean`).

Let `V ≤ Gal(K'/K)` be closed and let `A₂` not lie in the `V`-orbit of the place `A₁`.  Then there
is an **open** subgroup `U ≥ V` whose orbit of `A₁` still avoids `A₂`.

Proof (reviewed): the set `C = {g : Gal(K'/K) | g • A₁ = A₂}` is closed — it is empty or a coset of
the stabiliser `MulAction.stabilizer Gal(K'/K) A₁`, which is closed
(`Commons.FieldTheory.Galois.isClosed_stabilizer_valuationSubring`), and `Gal(K'/K)` is a compact
Hausdorff topological group.  If `A₂` lay in `(V·N)•A₁` for every open subgroup `N`, the sets
`(V·N) ∩ C` would be non-empty, closed and nested inside the compact set `V·N ⊆ Gal(K'/K)`, so by
the finite intersection property some `g` would lie in `⋂_N (V·N) = V` and in `C`, giving
`A₂ ∈ V•A₁` — contradiction.  So some `U = V·N` works (`V·N` is open and contains `V`). -/
theorem orbit_separation {K K' : Type} [Field K] [NumberField K] [Field K'] [Algebra K K']
    [IsSepClosure K K'] (V : Subgroup Gal(K'/K)) (hV : IsClosed (V : Set Gal(K'/K)))
    (A₁ A₂ : ValuationSubring K') (h : A₂ ∉ MulAction.orbit V A₁) :
    ∃ U : Subgroup Gal(K'/K), IsOpen (U : Set Gal(K'/K)) ∧ V ≤ U ∧
      A₂ ∉ MulAction.orbit U A₁ := by
  classical
  haveI : IsGalois K K' := inferInstance
  -- The set of group elements carrying the place `A₁` to the place `A₂`.
  let C : Set Gal(K'/K) := {g | g • A₁ = A₂}
  -- ## Step 1: `C` is closed.
  have hCclosed : IsClosed C := by
    by_cases hne : C.Nonempty
    · -- `C` is a coset of the (closed) stabiliser of `A₁`.
      obtain ⟨g₀, hg₀⟩ := hne
      have hstab : IsClosed (MulAction.stabilizer Gal(K'/K) A₁ : Set Gal(K'/K)) :=
        Commons.FieldTheory.Galois.isClosed_stabilizer_valuationSubring A₁
      have hCeq : C = {g : Gal(K'/K) | g₀⁻¹ * g ∈ MulAction.stabilizer Gal(K'/K) A₁} := by
        ext g
        simp only [C, Set.mem_ofPred_eq]
        constructor
        · intro hg
          rw [MulAction.mem_stabilizer_iff]
          rw [mul_smul, hg, ← hg₀, ← mul_smul, inv_mul_cancel, one_smul]
        · intro hg
          rw [MulAction.mem_stabilizer_iff] at hg
          rw [← hg₀]
          calc g • A₁ = (g₀ * (g₀⁻¹ * g)) • A₁ := by rw [mul_inv_cancel_left]
            _ = g₀ • ((g₀⁻¹ * g) • A₁) := by rw [mul_smul]
            _ = g₀ • A₁ := by rw [hg]
      rw [hCeq]
      exact hstab.preimage (continuous_const.mul continuous_id)
    · rw [Set.not_nonempty_iff_eq_empty] at hne
      rw [hne]
      exact isClosed_empty
  -- ## Step 2: for every `c ∈ C` there is a *normal open* subgroup `N` with `c·N ∩ V = ∅`.
  --
  -- `V` is closed and `c ∉ V` (else `A₂ = c • A₁` would lie in the `V`-orbit of `A₁`), so
  -- `{x | c * x ∉ V}` is an open neighbourhood of `1`.  As `K'/K` is normal, the neighbourhood
  -- filter of `1` is generated by fixing subgroups of finite dimensional *normal* intermediate
  -- fields, and the fixing subgroup of such a field is normal in `Gal(K'/K)`.
  have key : ∀ c : Gal(K'/K), c ∈ C →
      ∃ N : Subgroup Gal(K'/K), N.Normal ∧ IsOpen (N : Set Gal(K'/K)) ∧
        ∀ n ∈ N, c * n ∉ (V : Set Gal(K'/K)) := by
    intro c hc
    have hcV : c ∉ (V : Set Gal(K'/K)) := by
      intro hcV
      exact h (MulAction.mem_orbit_iff.mpr ⟨⟨c, hcV⟩, hc⟩)
    obtain ⟨E, hEfin, hEnorm, hEsub⟩ :=
      (krullTopology_mem_nhds_one_iff_of_normal K K' _).mp (show
        {x : Gal(K'/K) | c * x ∉ (V : Set Gal(K'/K))} ∈ 𝓝 1 from by
          have hopen : IsOpen {x : Gal(K'/K) | c * x ∉ (V : Set Gal(K'/K))} := by
            have h1 : IsOpen (((V : Set Gal(K'/K)))ᶜ) := hV.isOpen_compl
            have hcont : Continuous (fun x : Gal(K'/K) => c * x) :=
              continuous_const.mul continuous_id
            change IsOpen ((fun x : Gal(K'/K) => c * x) ⁻¹' (((V : Set Gal(K'/K)))ᶜ))
            exact hcont.isOpen_preimage _ h1
          exact hopen.mem_nhds (x := 1) (by simpa using hcV))
    haveI : Normal K ↥E := hEnorm
    haveI : IsGalois K ↥E := inferInstance
    exact ⟨E.fixingSubgroup, IsGalois.fixingSubgroup_normal_of_isGalois E,
      E.fixingSubgroup_isOpen, fun n hn => hEsub hn⟩
  -- ## Step 3: the compactness argument.
  --
  -- Fix, for each `c ∈ C`, a normal open subgroup `N_c` as in step 2.  The sets `c • N_c` cover
  -- `C`, which is compact (closed in the compact group `Gal(K'/K)`), so finitely many of them
  -- already cover `C`, say for `c ∈ t`.  Let `N = ⋂_{c ∈ t} N_c`, a normal open subgroup, and put
  -- `U = V ⊔ N = V·N`.  Then `U` is open, contains `V`, and `U ∩ C = ∅`.
  let Nf : {c : Gal(K'/K) // c ∈ C} → Subgroup Gal(K'/K) :=
    fun i => Classical.choose (key i.1 i.2)
  have Nf_norm : ∀ i, (Nf i).Normal := fun i => (Classical.choose_spec (key i.1 i.2)).1
  have Nf_open : ∀ i, IsOpen ((Nf i) : Set Gal(K'/K)) :=
    fun i => (Classical.choose_spec (key i.1 i.2)).2.1
  have Nf_sep : ∀ i (n : Gal(K'/K)), n ∈ Nf i → i.1 * n ∉ (V : Set Gal(K'/K)) :=
    fun i => (Classical.choose_spec (key i.1 i.2)).2.2
  have hcover : C ⊆ ⋃ i : {c : Gal(K'/K) // c ∈ C}, (i.1 • (Nf i : Set Gal(K'/K))) := by
    intro x hx
    exact Set.mem_iUnion.mpr ⟨⟨x, hx⟩, by
      rw [Set.mem_smul_set]
      exact ⟨1, (Nf ⟨x, hx⟩).one_mem, by simp⟩⟩
  have hUopen : ∀ i : {c : Gal(K'/K) // c ∈ C}, IsOpen (i.1 • (Nf i : Set Gal(K'/K))) :=
    fun i => (Nf_open i).leftCoset i.1
  obtain ⟨t, ht⟩ := hCclosed.isCompact.elim_finite_subcover
    (fun i : {c : Gal(K'/K) // c ∈ C} => i.1 • (Nf i : Set Gal(K'/K))) hUopen hcover
  let N : Subgroup Gal(K'/K) := t.inf (fun i => Nf i)
  have hinf_open : ∀ s : Finset {c : Gal(K'/K) // c ∈ C},
      IsOpen ((s.inf (fun i => Nf i) : Subgroup Gal(K'/K)) : Set Gal(K'/K)) := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s _ ih =>
        rw [Finset.inf_insert]
        exact (Nf_open a).inter ih
  have hNopen : IsOpen (N : Set Gal(K'/K)) := hinf_open t
  have hNnorm : N.Normal := by
    rw [show N = ⨅ i ∈ t, Nf i from Finset.inf_eq_iInf t (fun i => Nf i)]
    exact Subgroup.normal_iInf_normal
      (fun i => Subgroup.normal_iInf_normal (fun _ => Nf_norm i))
  have hNle : ∀ i ∈ t, N ≤ Nf i := by
    intro i hi
    exact Finset.inf_le hi
  haveI : N.Normal := hNnorm
  -- ## Step 4: `U = V ⊔ N` is the open subgroup sought, and `C ∩ U = ∅`.
  refine ⟨V ⊔ N, Subgroup.isOpen_mono le_sup_right hNopen, le_sup_left, ?_⟩
  intro hmem
  -- Rewrite the orbit membership in terms of elements of the ambient group.
  obtain ⟨g, hgU, hgA⟩ : ∃ g ∈ (V ⊔ N : Subgroup Gal(K'/K)), g • A₁ = A₂ := by
    rw [MulAction.mem_orbit_iff] at hmem
    obtain ⟨x, hx⟩ := hmem
    refine ⟨x, x.2, ?_⟩
    rw [← Subgroup.smul_def]
    exact hx
  -- Since `N` is normal, `U = V·N` and we can write `g = v * n` with `v ∈ V`, `n ∈ N`.
  have hgVN : g ∈ (V : Set Gal(K'/K)) * (N : Set Gal(K'/K)) := by
    rw [← Subgroup.mul_normal V N]
    exact hgU
  rw [Set.mem_mul] at hgVN
  obtain ⟨v, hvV, n, hnN, hvn⟩ := hgVN
  -- Since `g ∈ C` and the `c • N_c` cover `C`, we have `g = c * n_c` for some place `c ∈ t`.
  obtain ⟨i, hit, hgi⟩ := Set.mem_iUnion₂.mp (ht hgA)
  rw [Set.mem_smul_set] at hgi
  obtain ⟨n_i, hn_i, hni⟩ := hgi
  rw [smul_eq_mul] at hni
  -- Then `v = g * n⁻¹ = i * (n_i * n⁻¹)`, with `n_i * n⁻¹ ∈ N ⊆ N_i`; so `v ∈ V` meets
  -- `i · N_i`, contradicting that this coset is disjoint from `V`.
  have hnmem : n⁻¹ ∈ N := N.inv_mem hnN
  have hprod : n_i * n⁻¹ ∈ Nf i := (Nf i).mul_mem hn_i (hNle i hit hnmem)
  have hv : v = i.1 * (n_i * n⁻¹) := by
    have h1 : v * n = i.1 * n_i := by rw [hvn, hni]
    rw [← mul_assoc, ← h1, mul_assoc, mul_inv_cancel, mul_one]
  exact Nf_sep i (n_i * n⁻¹) hprod (hv ▸ hvV)

end NK.NUV2.LC
