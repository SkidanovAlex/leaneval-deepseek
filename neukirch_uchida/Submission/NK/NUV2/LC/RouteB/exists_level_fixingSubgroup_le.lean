import Mathlib
import Submission.NK.NUV2.LC.RouteB.level_kills_aux

namespace NK.NUV2.LC.RouteB

/-- A finite-dimensional intermediate field of `K'` over `K` is generated by a finite set of
elements of `K'`. -/
lemma exists_finite_generating_of_finiteDimensional {K K' : Type*} [Field K] [Field K']
    [Algebra K K'] (E : IntermediateField K K') (h : FiniteDimensional K ↥E) :
    ∃ S : Set K', S.Finite ∧ E ≤ IntermediateField.adjoin K S := by
  have hMf : Module.Finite K ↥E := h
  have hEss : Algebra.EssFiniteType K ↥E := inferInstance
  obtain ⟨t, ht⟩ := (IntermediateField.essFiniteType_iff (K := E)).mp hEss
  exact ⟨(t : Set K'), t.finite_toSet, le_of_eq ht.symm⟩

/-- **Enlargement of a level so that it contains the fixed field of `V`.**  For a closed subgroup
`V ≤ Gal(K'/K)` with `K'^V` finite over `K` (e.g. `V` open) and any finite Galois level `L`, there is
a finite Galois level `L' ≥ L` with `L'.fixingSubgroup ≤ V`, equivalently `K'^V ⊆ L'`.  This is the
reduction that makes the base field `levelBase V L' = fixedField (V.map (levelRestrict L'))` equal to
`K'^V` and hence *constant* in the level: the construction is the Galois closure over `K` of
`K'^V`, i.e. `FiniteGaloisIntermediateField.adjoin K S ⊔ L` for a finite generating set `S` of
`K'^V` over `K` (e.g. the image of a `K`-basis of `K'^V`). -/
theorem exists_level_fixingSubgroup_le {K K' : Type} [Field K] [NumberField K] [Field K']
    [Algebra K K'] [IsSepClosure K K']
    (V : Subgroup Gal(K'/K)) (L : FiniteGaloisIntermediateField K K')
    (hV : IsClosed (V : Set Gal(K'/K)))
    (hfin : FiniteDimensional K ↥(IntermediateField.fixedField V)) :
    ∃ (L' : FiniteGaloisIntermediateField K K'), L ≤ L' ∧ L'.fixingSubgroup ≤ V := by
  obtain ⟨S, hSfin, hSE⟩ :=
    exists_finite_generating_of_finiteDimensional (IntermediateField.fixedField V) hfin
  have hSf : Finite S := hSfin.to_subtype
  let L' : FiniteGaloisIntermediateField K K' := FiniteGaloisIntermediateField.adjoin K S ⊔ L
  have hLle : L ≤ L' := le_sup_right
  have hE2 : IntermediateField.adjoin K S ≤
      (↑(FiniteGaloisIntermediateField.adjoin K S) : IntermediateField K K') := by
    rw [FiniteGaloisIntermediateField.adjoin_val]
    exact IntermediateField.le_normalClosure _
  have hE3 : (↑(FiniteGaloisIntermediateField.adjoin K S) : IntermediateField K K') ≤
      (↑L' : IntermediateField K K') := le_sup_left
  have hE : IntermediateField.fixedField V ≤ (↑L' : IntermediateField K K') :=
    hSE.trans (hE2.trans hE3)
  have hfix : (↑L' : IntermediateField K K').fixingSubgroup ≤
      (IntermediateField.fixedField V).fixingSubgroup :=
    IntermediateField.fixingSubgroup_le hE
  have hEq : (IntermediateField.fixedField V).fixingSubgroup = V := by
    simpa using InfiniteGalois.fixingSubgroup_fixedField (H := ⟨V, hV⟩)
  exact ⟨L', hLle, hfix.trans hEq.le⟩

end NK.NUV2.LC.RouteB
