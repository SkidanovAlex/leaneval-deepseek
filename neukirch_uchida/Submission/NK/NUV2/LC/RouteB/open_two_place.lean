/-!
# The two-place realisation at an open level, from a single non-trivial class

This file contains the reduction of the requested lemma
`NK.NUV2.LC.RouteB.open_two_place` to its *additive* core: it is enough to
exhibit **one** class `x` of `H²(U, Z/p)` whose local component at `A₁` is
non-zero and whose local component at `A₂` vanishes.  Indeed, since the target
`LocalH2 p U A₁` is a `ZMod p`-module of cardinality `p` (the local Brauer
computation `natCard_localH2_of_isMuOpen`), every prescribed class `y` is a
scalar multiple `c • y₀` of any non-zero class `y₀`, and the localisation is
`ZMod p`-linear, so `c • x` realises `y` at `A₁` and still vanishes at `A₂`.

The companion result `natCard_localH2_of_isMuOpen` records the local Brauer
computation `|H²(U ⊓ D_A, Z/p)| = |Br(F_v)[p]| = p` for a `μ_p`-open subgroup
`U ≤ Gal(K'/K)` and every place `A` over a finite prime of `K` (it is the
cardinality computation carried out inside `NK.NUV2.LC.RouteB.isLive_of_isMuOpen`).
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

open scoped Pointwise

namespace NK.NUV2.LC.RouteB

open NK.BrauerHasse

variable {K K' : Type} [Field K] [NumberField K] [Field K'] [Algebra K K'] [IsSepClosure K K']

/-! ## The additive structure of the localisation -/

/-- The localisation at a place as an additive homomorphism (the two types `LocalH2 p U A` and
`H2Profinite p (U ⊓ D_A)` are definitionally equal). -/
noncomputable def locAddHom' (p : ℕ) (U : Subgroup Gal(K'/K)) (A : OverFinitePrime K K') :
    H2Profinite p U →+ H2Profinite p (U ⊓ stabSubgroup A.1) where
  toFun := fun x => H2Profinite.loc p U x A
  map_zero' := H2Profinite.loc_zero p U A
  map_add' := fun x y => H2Profinite.loc_add p U A x y

/-- The `ZMod p`-module structure on the local cohomology `LocalH2 p U A`.  The two types
`LocalH2 p U A` and `H2Profinite p (U ⊓ D_A)` are definitionally equal, but `LocalH2` is a `def` and
so type class search does not unfold it; this instance makes the module structure available. -/
noncomputable instance instModuleZModLocalH2' (p : ℕ) (U : Subgroup Gal(K'/K))
    (A : ValuationSubring K') :
    Module (ZMod p) (NK.BrauerHasse.LocalH2 (K := K) (K' := K') p U A) :=
  inferInstanceAs (Module (ZMod p)
    (NK.BrauerHasse.H2Profinite (K := K) (K' := K') p (U ⊓ NK.BrauerHasse.stabSubgroup A)))

/-- **The localisation is `ZMod p`-linear.** -/
theorem H2Profinite.loc_smul (p : ℕ) [NeZero p] (U : Subgroup Gal(K'/K))
    (A : OverFinitePrime K K') (c : ZMod p) (x : H2Profinite p U) :
    H2Profinite.loc p U (c • x) A = c • H2Profinite.loc p U x A := by
  have h : c = ((c.val : ℕ) : ZMod p) := (ZMod.natCast_zmod_val c).symm
  rw [h, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul]
  exact map_nsmul (locAddHom' p U A) c.val x

/-! ## A `ZMod p`-module of cardinality `p` is generated by each non-zero element -/

/-- **In a `ZMod p`-module of cardinality `p` (`p` a prime) every element is a scalar multiple of
every non-zero element.** -/
theorem exists_smul_eq_of_card_eq_prime' (p : ℕ) [Fact p.Prime] {M : Type} [AddCommGroup M]
    [Module (ZMod p) M] (hcard : Nat.card M = p) {y : M} (hy : y ≠ 0) :
    ∀ w : M, ∃ c : ZMod p, c • y = w := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  haveI : Finite M := Nat.finite_of_card_ne_zero (by
    rw [hcard]; exact (Fact.out : p.Prime).ne_zero)
  have hinj : Function.Injective (fun c : ZMod p => c • y) := by
    intro c d hcd
    have h : (c - d) • y = 0 := by simp only [sub_smul, hcd, sub_self]
    rcases smul_eq_zero.mp h with h0 | h0
    · exact sub_eq_zero.mp h0
    · exact absurd h0 hy
  have h1 : Nat.card (ZMod p) = p := by rw [Nat.card_eq_fintype_card, ZMod.card]
  have hbij := (Nat.bijective_iff_injective_and_card (fun c : ZMod p => c • y)).mpr
    ⟨hinj, by rw [h1, hcard]⟩
  exact hbij.2

/-! ## The local Brauer computation at the decomposition group -/

/-- **The local Brauer computation at an open level**: for `p ≠ 2` a prime, `ζ ∈ K'` a primitive
`p`-th root of unity and `U ≤ Gal(K'/K)` a `μ_p`-open subgroup, the local cohomology at every place
`A` of `K'` over a finite prime of `K` has exactly `p` elements:

  `|H²(U ⊓ D_A, Z/p)| = |Br(F_v)[p]| = p`,  `F = K'^U`, `v = A|_F`.

This is the cardinality computation carried out inside
`NK.NUV2.LC.RouteB.isLive_of_isMuOpen` (where it is used only to produce a non-zero class). -/
theorem natCard_localH2_of_isMuOpen (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (ζ : K')
    (hζ : IsPrimitiveRoot ζ p) (U : Subgroup Gal(K'/K))
    (hU : IsMuOpen (K := K) (K' := K') ζ U) (A : OverFinitePrime K K') :
    Nat.card (LocalH2 (K := K) (K' := K') p U A.1) = p := by
  classical
  obtain ⟨A₀, hA₀⟩ := A
  obtain ⟨hUopen, hUζ⟩ := hU
  let F : IntermediateField K K' := IntermediateField.fixedField U
  have hUcl : IsClosed (U : Set Gal(K'/K)) := Subgroup.isClosed_of_isOpen U hUopen
  have hFixF : F.fixingSubgroup = U :=
    InfiniteGalois.fixingSubgroup_fixedField (k := K) (K := K') ⟨U, hUcl⟩
  have hFfd : FiniteDimensional K F := by
    rw [← InfiniteGalois.isOpen_iff_finite (k := K) (K := K') F, hFixF]
    exact hUopen
  haveI : FiniteDimensional K F := hFfd
  haveI : NumberField ↥F := NumberField.of_module_finite K ↥F
  haveI : IsSepClosure ↥F K' := ⟨IsSepClosure.sep_closed K, inferInstance⟩
  have hζF : ζ ∈ F := by
    rw [IntermediateField.mem_fixedField_iff]
    intro f hf
    exact (IntermediateField.mem_fixingSubgroup_iff _ f).mp (hUζ hf) ζ
      (IntermediateField.mem_adjoin_simple_self K ζ)
  have hAF : A₀.comap (algebraMap ↥F K') ≠ ⊤ := by
    intro htop
    refine hA₀ ?_
    have h1 : (A₀.comap (algebraMap ↥F K')).comap (algebraMap K ↥F)
        = A₀.comap (algebraMap K K') := by
      rw [ValuationSubring.comap_comap, IsScalarTower.algebraMap_eq K ↥F K']
    rw [← h1, htop]
    ext x; simp [ValuationSubring.mem_comap]
  obtain ⟨𝔮, h𝔮⟩ :=
    NK.BrauerHasse.exists_heightOneSpectrum_eq_comap (K := ↥F) (K' := K') A₀ hAF
  obtain ⟨eD⟩ := NK.NUV2.LC.decompContinuousIso ↥F K' 𝔮 A₀ h𝔮
  have hE : Nonempty (↥(U ⊓ NK.BrauerHasse.stabSubgroup A₀) ≃ₜ*
      ↥(MulAction.stabilizer (K' ≃ₐ[↥F] K') A₀)) :=
    hFixF ▸ nonempty_continuousMulEquiv_fixingSubgroup_inf_stabSubgroup F A₀
  have hζ₀ : IsPrimitiveRoot (⟨ζ, hζF⟩ : ↥F) p :=
    IsPrimitiveRoot.of_map_of_injective (f := F.val) (by simpa using hζ)
      (fun a b h => Subtype.ext h)
  have hζroot : ∃ ζ' : 𝔮.adicCompletion ↥F, IsPrimitiveRoot ζ' p :=
    ⟨algebraMap ↥F (𝔮.adicCompletion ↥F) (⟨ζ, hζF⟩ : ↥F),
      IsPrimitiveRoot.map_of_injective (f := algebraMap ↥F (𝔮.adicCompletion ↥F)) hζ₀
        (Commons.NumberTheory.NumberField.Completion.injective_algebraMap_adicCompletion 𝔮)⟩
  have hcard : Nat.card (NK.BrauerHasse.H2Profinite (K := K) (K' := K') p
      (U ⊓ NK.BrauerHasse.stabSubgroup A₀)) = p := by
    rw [natCard_h2Profinite_of_homeomorph (k := K) (k' := K') (κ := ↥F) (κ' := K')
      (H := U ⊓ NK.BrauerHasse.stabSubgroup A₀)
      (J := MulAction.stabilizer (K' ≃ₐ[↥F] K') A₀) p hE.some]
    exact NK.NUV2.LC.card_h2P_of_homeomorph (K := ↥F) (K' := K') (L := ↥F) 𝔮 hp hζroot _
      (Commons.FieldTheory.Galois.isClosed_stabilizer_valuationSubring A₀) eD
  exact hcard


/-! ## Local triviality at a place that splits completely in the level -/

/-- **The local component at `A` vanishes for every class of a level in which `A` "splits
completely".**  Concretely: if the fine local group of the level `E` at `A` is trivial — i.e.
`U ⊓ D_A ≤ Gal(K'/E)`, so that `A` (more precisely the place of the fixed field `F = K'^U` below it)
splits completely in `E/F` — then the level-wise localisation of any class of `H²(U, Z/p)` at the
level `E` is zero, hence the localisation of that class at `A` is zero. -/
theorem H2Profinite.loc_ofLevel_eq_zero_of_le_fixingSubgroup (p : ℕ) (U : Subgroup Gal(K'/K))
    (A : OverFinitePrime K K') (E : FiniteGaloisIntermediateField K K')
    (h : (U ⊓ stabSubgroup A.1) ≤ E.fixingSubgroup) (c : LevelH2 p U E) :
    H2Profinite.loc p U (H2Profinite.ofLevel E c) A = 0 := by
  rw [H2Profinite.loc_ofLevel_apply]
  have htop : E.fixingSubgroup.subgroupOf (U ⊓ stabSubgroup A.1) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    exact h x.2
  have hsub : Subsingleton (LocalLevelGroup U A.1 E) := by
    rw [LocalLevelGroup, htop]
    exact QuotientGroup.subsingleton_iff.mpr rfl
  haveI : Subsingleton (LocalLevelGroup U A.1 E) := hsub
  haveI : Subsingleton (LocalLevelH2 p U A.1 E) :=
    NK.Indecomposed.subsingleton_H2_of_subsingleton
  have h0 : locLevel p U A.1 E c = 0 := Subsingleton.elim _ _
  rw [h0]
  exact NK.BrauerHasse.local_ofLevel_zero (K := K) (K' := K') (p := p) (U := U) A.1 E

/-! ## The reduction to a single non-trivial class -/


/-- **The two-place realisation from one non-trivial class.**  If `p` is a prime, `A₁, A₂` are two
places of `K'` over finite primes of `K`, the local group `LocalH2 p U A₁` has cardinality `p`, and
there is a class `x` of `H²(U, Z/p)` whose localisation at `A₁` is non-zero and which is locally
trivial at `A₂`, then every prescribed local class at `A₁` is realised by a class which is locally
trivial at `A₂`.

Proof: by `exists_smul_eq_of_card_eq_prime'` the prescribed class `y` is `c • y₀` for a fixed
non-zero `y₀ = loc x A₁`; the scalar multiple `c • x` then has localisation `c • y = y` at `A₁`
(`H2Profinite.loc_smul`) and localisation `c • 0 = 0` at `A₂`. -/
theorem open_two_place_of_exists_nonzero (p : ℕ) (hp : p.Prime)
    (U : Subgroup Gal(K'/K)) (A₁ A₂ : OverFinitePrime K K')
    (hcard : Nat.card (LocalH2 (K := K) (K' := K') p U A₁.1) = p)
    (h : ∃ x : H2Profinite (K := K) (K' := K') p U,
      H2Profinite.loc p U x A₁ ≠ 0 ∧ H2Profinite.loc p U x A₂ = 0) :
    ∀ y : LocalH2 (K := K) (K' := K') p U A₁.1,
      ∃ x : H2Profinite (K := K) (K' := K') p U,
        H2Profinite.loc p U x A₁ = y ∧ H2Profinite.loc p U x A₂ = 0 := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  obtain ⟨x, hx₁, hx₂⟩ := h
  intro y
  obtain ⟨c, hc⟩ := exists_smul_eq_of_card_eq_prime' p hcard hx₁ y
  refine ⟨c • x, ?_, ?_⟩
  · rw [H2Profinite.loc_smul, hc]
  · rw [H2Profinite.loc_smul, hx₂, smul_zero]



end NK.NUV2.LC.RouteB
