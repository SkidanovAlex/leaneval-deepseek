import Mathlib
import Submission.NK.BrauerHasse.Basic
import Submission.NK.Cohomology.capture_two_map_eq_zero_of_cyclic
import Submission.NK.NUV2.LC.RouteB.muLevelMap_ne_zero_of_kummerLevel_ne_zero

/-!
# The pullback along `Z/p ^ 2 ↠ Z/p` kills `H²(·, Z/p)`

Let `G = Multiplicative (ZMod (p ^ 2))`, `Q = Multiplicative (ZMod p)` and let
`π : G →* Q` be the reduction `x mod p`.  For the *trivial* coefficients `Z/p` the map
`H2.map π : H²(Q, Z/p) → H²(G, Z/p)` induced by `π` is **zero**.

This is the inflation of the second cohomology of `Q = Z/p` along the extension
`1 → Z/p → Z/p² → Z/p → 1`: the group `H²(Z/p, Z/p) ≅ Z/p` is generated by the class of the
extension `Z/p²` itself, and pulling that class back along the reduction splits the extension (one
gets `Z/p² × Z/p`), so every inflated class vanishes.

Formally the proof reduces, via `H2_induction_on`, to a *cochain-level* statement: the pullback of
any `2`-cocycle `z` of the trivial `Q`-representation to `G` is a `2`-coboundary.  This is
witnessed by the transgression criterion of `NK.Cohomology`: for a finite cyclic `G` generated by
`g` and a `2`-cocycle `z`, `z` is a coboundary as soon as its transgression
`∑_{t < |G|} z (g ^ t, g)` lies in the norm group of the coefficients.  Here the coefficients are
the trivial module `Z/p`, the element `g ^ p` lies in the kernel of `π`, so the summands
`t ↦ z (π (g ^ t), π g)` are `p`-periodic; summing over the `p` blocks of `{0, …, p² - 1}`
exhibits the transgression as a multiple of `p`, which vanishes in characteristic `p`.
-/

open CategoryTheory

namespace NK.NUV2.LC.RouteB

section Periodic

variable {M : Type*}

/-- A `p`-periodic sequence is invariant under shifts by multiples of `p`. -/
lemma periodic_shift_add_mul [AddCommMonoid M] (p : ℕ) (f : ℕ → M)
    (hf : ∀ t, f (t + p) = f t) (m t : ℕ) : f (p * m + t) = f t := by
  induction m generalizing t with
  | zero => simp
  | succ m ih =>
      have h : p * (m + 1) + t = p * m + (t + p) := by ring
      rw [h, ih (t + p), hf]

/-- The sum of a `p`-periodic sequence over `p * m` terms is `m` times the sum over one period. -/
lemma sum_range_mul_of_periodic [AddCommMonoid M] (p m : ℕ) (f : ℕ → M)
    (hf : ∀ t, f (t + p) = f t) :
    (∑ t ∈ Finset.range (p * m), f t) = m • ∑ t ∈ Finset.range p, f t := by
  induction m with
  | zero => simp
  | succ m ih =>
      rw [show p * (m + 1) = p * m + p by ring, Finset.sum_range_add, ih,
        show (∑ t ∈ Finset.range p, f (p * m + t)) = ∑ t ∈ Finset.range p, f t from
          Finset.sum_congr rfl (fun t _ => periodic_shift_add_mul p f hf m t),
        show (m + 1) • (∑ t ∈ Finset.range p, f t)
          = (m • ∑ t ∈ Finset.range p, f t) + ∑ t ∈ Finset.range p, f t from by
          rw [add_nsmul, one_nsmul]]

end Periodic

section Pullback

/-- The reduction `Z / p ^ 2 → Z / p`, as a homomorphism of the multiplicative groups. -/
noncomputable def redHom (p : ℕ) : Multiplicative (ZMod (p ^ 2)) →* Multiplicative (ZMod p) :=
  AddMonoidHom.toMultiplicative
    ((ZMod.castHom (show p ∣ p ^ 2 from ⟨p, by ring⟩) (ZMod p)).toAddMonoidHom)

lemma redHom_ofAdd_one (p : ℕ) :
    redHom p (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) = Multiplicative.ofAdd (1 : ZMod p) := by
  simp [redHom]

lemma redHom_gen_pow (p : ℕ) :
    (redHom p (Multiplicative.ofAdd (1 : ZMod (p ^ 2)))) ^ p = 1 := by
  rw [redHom_ofAdd_one, ← ofAdd_nsmul p (1 : ZMod p)]
  simp

/-- The element `1` generates the cyclic group `Multiplicative (ZMod n)`. -/
lemma mem_zpowers_ofAdd_one (n : ℕ) [NeZero n] (x : Multiplicative (ZMod n)) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod n)) := by
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨((Multiplicative.toAdd x).val : ℤ), ?_⟩
  rw [zpow_natCast, ← ofAdd_nsmul, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val, ofAdd_toAdd]

/-- The evaluation of the degree-`2` cochain map of Mathlib's functoriality API. -/
lemma cochainsMap₂_redHom_apply (p : ℕ) (k : Type) [CommRing k]
    {A : Rep k (Multiplicative (ZMod p))} {B : Rep k (Multiplicative (ZMod (p ^ 2)))}
    (φ : Rep.res (redHom p) A ⟶ B)
    (z : Multiplicative (ZMod p) × Multiplicative (ZMod p) → A)
    (γ δ : Multiplicative (ZMod (p ^ 2))) :
    (groupCohomology.cochainsMap₂ (redHom p) φ) z (γ, δ) = φ.hom (z (redHom p γ, redHom p δ)) :=
  rfl

/-- **The pullback of a `2`-cocycle is a `2`-cocycle.** -/
lemma pullback_mem_cocycles₂ (p : ℕ) (k : Type) [CommRing k]
    (z : groupCohomology.cocycles₂ (Rep.trivial k (Multiplicative (ZMod p)) k)) :
    (fun q : Multiplicative (ZMod (p ^ 2)) × Multiplicative (ZMod (p ^ 2)) =>
        z (redHom p q.1, redHom p q.2)) ∈
      groupCohomology.cocycles₂ (Rep.trivial k (Multiplicative (ZMod (p ^ 2))) k) := by
  rw [groupCohomology.mem_cocycles₂_iff]
  intro a b c
  have h := (groupCohomology.mem_cocycles₂_iff
      (A := Rep.trivial k (Multiplicative (ZMod p)) k) (⇑z)).mp z.2
      (redHom p a) (redHom p b) (redHom p c)
  simp only [map_mul] at h ⊢
  exact h

/-- The pullback of a `2`-cocycle of the trivial `Z/p`-representation, as an element of the
`2`-cocycles of the trivial `Z/p²`-representation. -/
noncomputable def pullbackCocycle (p : ℕ) (k : Type) [CommRing k]
    (z : groupCohomology.cocycles₂ (Rep.trivial k (Multiplicative (ZMod p)) k)) :
    groupCohomology.cocycles₂ (Rep.trivial k (Multiplicative (ZMod (p ^ 2))) k) :=
  ⟨fun q => z (redHom p q.1, redHom p q.2), pullback_mem_cocycles₂ p k z⟩

/-- **The transgression of a pulled-back cocycle vanishes.**  The summands are `p`-periodic
because `redHom p ((ofAdd 1) ^ p) = 1`, so the sum over the `p²` powers of a generator is `p` times
the sum over one period; the coefficients have characteristic `p`. -/
lemma transgression_pullbackCocycle_eq_zero (p : ℕ) [Fact p.Prime] (k : Type) [CommRing k]
    (hp : (p : k) = 0)
    (z : groupCohomology.cocycles₂ (Rep.trivial k (Multiplicative (ZMod p)) k)) :
    (∑ t ∈ Finset.range (Fintype.card (Multiplicative (ZMod (p ^ 2)))),
        (pullbackCocycle p k z)
          ((Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ t,
            Multiplicative.ofAdd (1 : ZMod (p ^ 2)))) = 0 := by
  set g : Multiplicative (ZMod (p ^ 2)) := Multiplicative.ofAdd (1 : ZMod (p ^ 2)) with hg
  have hgpow : (redHom p g) ^ p = 1 := by rw [hg]; exact redHom_gen_pow p
  have hper : ∀ t : ℕ, (pullbackCocycle p k z) (g ^ (t + p), g)
      = (pullbackCocycle p k z) (g ^ t, g) := by
    intro t
    show z (redHom p (g ^ (t + p)), redHom p g) = z (redHom p (g ^ t), redHom p g)
    have h1 : redHom p (g ^ (t + p)) = redHom p (g ^ t) := by
      calc redHom p (g ^ (t + p)) = redHom p (g ^ t * g ^ p) := by rw [pow_add]
        _ = redHom p (g ^ t) * redHom p (g ^ p) := map_mul _ _ _
        _ = (redHom p g) ^ t * (redHom p g) ^ p := by simp only [map_pow]
        _ = (redHom p g) ^ t * 1 := by rw [hgpow]
        _ = (redHom p g) ^ t := by rw [mul_one]
        _ = redHom p (g ^ t) := by simp only [map_pow]
    rw [h1]
  have hcard : Fintype.card (Multiplicative (ZMod (p ^ 2))) = p * p := by
    rw [Fintype.card_congr (Multiplicative.toAdd)]
    simp [ZMod.card, pow_two]
  rw [hcard, sum_range_mul_of_periodic p p _ hper]
  have : (p : k) • (∑ t ∈ Finset.range p, (pullbackCocycle p k z) (g ^ t, g)) = 0 := by
    rw [hp, zero_smul]
  simpa [Nat.cast_smul_eq_nsmul] using this

/-- **The pullback of a `2`-cocycle is a `2`-coboundary**, by the transgression criterion. -/
lemma pullbackCocycle_mem_coboundaries₂ (p : ℕ) [Fact p.Prime] (k : Type) [CommRing k]
    (hp : (p : k) = 0)
    (z : groupCohomology.cocycles₂ (Rep.trivial k (Multiplicative (ZMod p)) k)) :
    (⇑(pullbackCocycle p k z)) ∈
      groupCohomology.coboundaries₂ (Rep.trivial k (Multiplicative (ZMod (p ^ 2))) k) := by
  refine NK.Cohomology.mem_coboundaries₂_of_transgression_mem_range
    (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) (mem_zpowers_ofAdd_one (p ^ 2))
    (Rep.trivial k (Multiplicative (ZMod (p ^ 2))) k) (pullbackCocycle p k z) ?_
  rw [transgression_pullbackCocycle_eq_zero p k hp z]
  exact Submodule.zero_mem _

end Pullback

section Main

/-- The coefficient ring `Z/p` of `NK.BrauerHasse` has characteristic `p`. -/
lemma coeff_natCast_self (p : ℕ) : (p : NK.BrauerHasse.Coeff p) = 0 := by
  rw [show (p : NK.BrauerHasse.Coeff p) = ULift.up (p : ZMod p) from rfl,
    show (p : ZMod p) = 0 from ZMod.natCast_self p]
  rfl

/-- The structural morphism used in `NK.BrauerHasse.H2.map` is the identity on coefficients. -/
lemma trivHom_apply (p : ℕ) (f : Multiplicative (ZMod (p ^ 2)) →* Multiplicative (ZMod p))
    (a : NK.BrauerHasse.Coeff p) : (NK.BrauerHasse.trivHom f).hom a = a := rfl

/-- The statement with the reduction written as `redHom p`. -/
lemma h2_map_redHom_eq_zero (p : ℕ) [Fact p.Prime] :
    ∀ x : NK.BrauerHasse.H2 p (Multiplicative (ZMod p)),
      (NK.BrauerHasse.H2.map (p := p) (redHom p)).hom x = 0 := by
  intro x
  obtain ⟨z, hz⟩ := (ModuleCat.epi_iff_surjective
      (groupCohomology.H2π (Rep.trivial (NK.BrauerHasse.Coeff p)
        (Multiplicative (ZMod p)) (NK.BrauerHasse.Coeff p)))).mp
    (inferInstance : Epi (groupCohomology.H2π (Rep.trivial (NK.BrauerHasse.Coeff p)
      (Multiplicative (ZMod p)) (NK.BrauerHasse.Coeff p)))) x
  rw [← hz]
  have hcomp : (groupCohomology.map (redHom p) (NK.BrauerHasse.trivHom (redHom p)) 2)
        (groupCohomology.H2π (Rep.trivial (NK.BrauerHasse.Coeff p)
          (Multiplicative (ZMod p)) (NK.BrauerHasse.Coeff p)) z)
      = groupCohomology.H2π (Rep.trivial (NK.BrauerHasse.Coeff p)
          (Multiplicative (ZMod (p ^ 2))) (NK.BrauerHasse.Coeff p))
          ((groupCohomology.mapCocycles₂ (redHom p) (NK.BrauerHasse.trivHom (redHom p))) z) :=
    groupCohomology.H2π_comp_map_apply (redHom p) (NK.BrauerHasse.trivHom (redHom p)) z
  rw [NK.BrauerHasse.H2.map, hcomp, groupCohomology.H2π_eq_zero_iff,
    groupCohomology.coe_mapCocycles₂]
  have hval : (groupCohomology.cochainsMap₂ (redHom p) (NK.BrauerHasse.trivHom (redHom p)))
        (⇑z) = (⇑(pullbackCocycle p (NK.BrauerHasse.Coeff p) z) :
          Multiplicative (ZMod (p ^ 2)) × Multiplicative (ZMod (p ^ 2)) →
            NK.BrauerHasse.Coeff p) := by
    funext q
    rw [cochainsMap₂_redHom_apply]
    exact trivHom_apply p (redHom p) (z (redHom p q.1, redHom p q.2))
  rw [hval]
  exact pullbackCocycle_mem_coboundaries₂ p (NK.BrauerHasse.Coeff p)
    (coeff_natCast_self p) z

end Main

theorem h2_map_zmod_p_sq_eq_zero (p : ℕ) [Fact p.Prime] :
    ∀ x : NK.BrauerHasse.H2 p (Multiplicative (ZMod p)),
      (NK.BrauerHasse.H2.map (p := p) (AddMonoidHom.toMultiplicative
        ((ZMod.castHom (show p ∣ p ^ 2 from ⟨p, by ring⟩) (ZMod p)).toAddMonoidHom))).hom x = 0 := by
  intro x
  simpa only [redHom] using h2_map_redHom_eq_zero p x

end NK.NUV2.LC.RouteB
