namespace NK.NUV2.LC

open scoped Pointwise Topology

set_option linter.style.haveILetI false

/-- **Continuity of the transport of an automorphism group along a field isomorphism.**

For any `K`-algebra isomorphism `φ : A₁ ≃ₐ[K] A₂` of fields, the induced isomorphism
`AlgEquiv.autCongr φ : Gal(A₁/K) ≃* Gal(A₂/K)` (which sends `τ` to `φ.symm.trans (τ.trans φ)`)
is continuous for the Krull topologies.  A basic neighbourhood of `1` in `Gal(A₂/K)` is the
fixing subgroup of a finite intermediate field `E ≤ A₂`; its preimage contains the fixing
subgroup of the finite intermediate field `φ⁻¹(E) = E.map φ.symm.toAlgHom ≤ A₁`. -/
theorem continuous_algEquiv_autCongr {K A₁ A₂ : Type*} [Field K] [Field A₁] [Field A₂]
    [Algebra K A₁] [Algebra K A₂] (φ : A₁ ≃ₐ[K] A₂) :
    Continuous (AlgEquiv.autCongr φ : (A₁ ≃ₐ[K] A₁) → (A₂ ≃ₐ[K] A₂)) := by
  refine continuous_of_continuousAt_one _ ?_
  rw [ContinuousAt, map_one, Filter.tendsto_def]
  intro U hU
  rw [krullTopology_mem_nhds_one_iff K A₂] at hU
  obtain ⟨E, hEfin, hEU⟩ := hU
  haveI := hEfin
  have hEfin' : FiniteDimensional K ↥(E.map φ.symm.toAlgHom) :=
    LinearEquiv.finiteDimensional (IntermediateField.equivMap E φ.symm.toAlgHom).toLinearEquiv
  refine (krullTopology_mem_nhds_one_iff K A₁
    ((AlgEquiv.autCongr φ) ⁻¹' U)).mpr ⟨E.map φ.symm.toAlgHom, hEfin', ?_⟩
  intro τ hτ
  refine hEU ?_
  rw [SetLike.mem_coe]
  refine (IntermediateField.mem_fixingSubgroup_iff E (AlgEquiv.autCongr φ τ)).mpr fun y hy => ?_
  have hx : φ.symm y ∈ E.map φ.symm.toAlgHom :=
    (IntermediateField.mem_map E).mpr ⟨y, hy, rfl⟩
  have hτx : τ (φ.symm y) = φ.symm y :=
    (IntermediateField.mem_fixingSubgroup_iff _ τ).mp (SetLike.mem_coe.mp hτ) (φ.symm y) hx
  simp only [AlgEquiv.autCongr_apply, AlgEquiv.trans_apply, hτx, AlgEquiv.apply_symm_apply]

/-- **Leaf 5: the decomposition group of a place above `𝔭` is *continuously* isomorphic to the
absolute Galois group of the `𝔭`-adic completion.**

This upgrades `NK.NeukirchUchida.nonempty_mulEquiv_decompositionGroupOf_localGalois` from an
abstract group isomorphism to a two-sided continuous one (`≃ₜ*`).

Route.  Put `κ = K_𝔭`, `C = placeCompletion A` (the completion of `K'` at `A`), `Φ : κ →+* C` the
canonical embedding and `M = κ·K' ≤ C` the subfield generated by the images of `κ` and `K'`;
`M` is a separable closure of `κ`.  The composite

  `D_A ≃* Aut_κ(M) ≃* Gal(κ^sep/κ)`

is `NK.Mine.localGaloisEquiv`.  Its first factor is `σ ↦ σ̂|_M` (`decompositionToAdjoin`), whose
continuity is `NK.Mine.continuous_decompositionToAdjoin`, and its second factor is the transport
`AlgEquiv.autCongr φ` of automorphism groups along an isomorphism `φ : M ≃ₐ[κ] κ^sep`, whose
continuity is `continuous_algEquiv_autCongr`.  This gives continuity of the composite.

For the inverse: `D_A` is the stabiliser of the valuation subring `A`, hence closed in the Krull
topology (`Commons.FieldTheory.Galois.isClosed_stabilizer_valuationSubring`), so it is a closed
subspace of the compact group `Gal(K'/K)` (`CompactSpace` of a Galois group, `IsSepClosure.isGalois`)
and thus compact; the target `Gal(κ^sep/κ)` is Hausdorff (`krullTopology_t2`).  A continuous
bijection from a compact space onto a Hausdorff space is a homeomorphism, so the inverse is
continuous as well. -/
theorem decompContinuousIso : NK.NUV2.DecompContinuousIso := by
  intro K K' _ _ _ _ _ 𝔭 A hA
  classical
  let Kp := IsDedekindDomain.HeightOneSpectrum.adicCompletion K 𝔭
  let Φ : Kp →+* NK.NeukirchUchida.placeCompletion A :=
    NK.NeukirchUchida.adicCompletionToPlaceCompletion 𝔭 A hA
  letI : Algebra Kp (NK.NeukirchUchida.placeCompletion A) := Φ.toAlgebra
  have halg : ∀ z : Kp,
      algebraMap Kp (NK.NeukirchUchida.placeCompletion A) z = Φ z := fun _ => rfl
  have hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
      (NK.NeukirchUchida.adicCompletionToPlaceCompletion 𝔭 A hA) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K 𝔭 :=
    NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers 𝔭 A hA
  -- ## continuity of the forward map
  have hcont₁ : Continuous (NK.Mine.adjoinLocalEquiv 𝔭 A hA halg hW :
      NK.Mine.decompositionGroupOf K K' A →
      (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') 𝔭 A ≃ₐ[Kp]
        NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') 𝔭 A)) :=
    NK.Mine.continuous_decompositionToAdjoin 𝔭 A hA halg
  have hcont₂ : Continuous (AlgEquiv.autCongr (NK.Mine.adjoinSepEquiv 𝔭 A hA halg) :
      (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') 𝔭 A ≃ₐ[Kp]
        NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') 𝔭 A) →
      Gal(SeparableClosure Kp/Kp)) :=
    continuous_algEquiv_autCongr _
  have hcont : Continuous (NK.Mine.localGaloisEquiv 𝔭 A hA halg hW :
      NK.Mine.decompositionGroupOf K K' A → Gal(SeparableClosure Kp/Kp)) := by
    have h := hcont₂.comp hcont₁
    simpa only [NK.Mine.localGaloisEquiv, MulEquiv.coe_trans, Function.comp_def] using h
  -- ## compactness of the source and Hausdorffness of the target
  haveI : IsGalois K K' := IsSepClosure.isGalois
  haveI : CompactSpace Gal(K'/K) := inferInstance
  have hDclosed : IsClosed
      ((NK.Mine.decompositionGroupOf K K' A : Subgroup Gal(K'/K)) : Set Gal(K'/K)) :=
    Commons.FieldTheory.Galois.isClosed_stabilizer_valuationSubring A
  haveI : CompactSpace ↥(NK.Mine.decompositionGroupOf K K' A) :=
    isCompact_iff_compactSpace.mp hDclosed.isCompact
  haveI : T2Space (Gal(SeparableClosure Kp/Kp)) := krullTopology_t2
  -- ## the continuous bijection is a homeomorphism
  have hclosed : IsClosedMap (NK.Mine.localGaloisEquiv 𝔭 A hA halg hW :
      ↥(NK.Mine.decompositionGroupOf K K' A) → Gal(SeparableClosure Kp/Kp)) := fun s hs =>
    (hs.isCompact.image hcont).isClosed
  refine ⟨ContinuousMulEquiv.mk'
    (Equiv.toHomeomorphOfContinuousClosed
      (NK.Mine.localGaloisEquiv 𝔭 A hA halg hW).toEquiv hcont hclosed) ?_⟩
  intro x y
  exact map_mul (NK.Mine.localGaloisEquiv 𝔭 A hA halg hW) x y

end NK.NUV2.LC
