import Mathlib
import Submission.NK.NUV2.ArtinBridge.levelPairIso

/-!
# The compositum of two `ℓ`-levels of `Ω/K` is again an `ℓ`-level

`NK.Reconstruct.FrobLevel K Ω` is the type of finite *normal* levels `L/K` of a Galois
extension `Ω/K` (`Submission/Work/Reconstruct/Gamma.lean`).  The Artin bridge of
`Submission/Work/NUV2/ArtinBridge/` runs over the levels whose Galois group is an `ℓ`-group,
and it needs to know that this class of levels is *directed*: the compositum `L ⊔ M` of two
such levels is again one.

This is the elementary fact behind it: if `L` and `M` are normal over `K` then so is `L ⊔ M`,
so both restriction maps `Gal(L ⊔ M/K) →* Gal(L/K)` and `Gal(L ⊔ M/K) →* Gal(M/K)` are
defined, and together they are **injective** — an automorphism of `L ⊔ M` fixing `L` and `M`
fixes the field they generate, namely all of `L ⊔ M`.  Hence `Gal(L ⊔ M/K)` is isomorphic to
a subgroup of `Gal(L/K) × Gal(M/K)`, and a subgroup of a product of `ℓ`-groups is an
`ℓ`-group.

## Main results

* `NK.NUV2.ArtinBridge.isPGroup_prod` — a product of `ℓ`-groups is an `ℓ`-group;
* `NK.NUV2.ArtinBridge.exists_injective_restrictNormalHom_sup` — the existence of an
  injective homomorphism `Gal(L ⊔ M/K) →* Gal(L/K) × Gal(M/K)` for `L`, `M` normal over `K`
  inside a normal extension `Ω/K` (the form in which the previous item is consumed);
* `NK.NUV2.ArtinBridge.isPGroup_sup_of_isPGroup` — the requested statement: the (`K`-linear)
  automorphism group of the compositum of two `ℓ`-levels is an `ℓ`-group.
-/

namespace NK.NUV2.ArtinBridge

/-- **A product of `ℓ`-groups is an `ℓ`-group.**  This is not in Mathlib (only the finite-order
formulation is), and it is what makes `IsPGroup` usable on products.  If `g ^ ℓ ^ k = 1` and
`h ^ ℓ ^ m = 1` then `(g, h) ^ ℓ ^ max k m = 1`. -/
theorem isPGroup_prod {G H : Type*} [Group G] [Group H] (ℓ : ℕ)
    (hG : IsPGroup ℓ G) (hH : IsPGroup ℓ H) : IsPGroup ℓ (G × H) := by
  intro x
  obtain ⟨k₁, hk₁⟩ := hG x.1
  obtain ⟨k₂, hk₂⟩ := hH x.2
  refine ⟨max k₁ k₂, ?_⟩
  have h1 : x.1 ^ ℓ ^ max k₁ k₂ = 1 := by
    obtain ⟨d, hd⟩ := Nat.pow_dvd_pow ℓ (le_max_left k₁ k₂)
    rw [hd, pow_mul, hk₁, one_pow]
  have h2 : x.2 ^ ℓ ^ max k₁ k₂ = 1 := by
    obtain ⟨d, hd⟩ := Nat.pow_dvd_pow ℓ (le_max_right k₁ k₂)
    rw [hd, pow_mul, hk₂, one_pow]
  exact Prod.ext h1 h2

open IntermediateField in
/-- **Restriction to two normal subextensions is injective.**  Let `Ω/K` be normal and let
`L, M ⊆ Ω` be normal over `K`.  Then there is an injective group homomorphism from the group
`Gal(L ⊔ M/K)` of `K`-algebra automorphisms of the compositum into the product
`Gal(L/K) × Gal(M/K)`.

Indeed, `L ⊔ M` is normal over `K` (`IntermediateField.normal_sup`), so `Gal(L ⊔ M/K)` is the
quotient of `Gal(Ω/K)` by the subgroup `(L ⊔ M).fixingSubgroup`, and the restriction maps
`Gal(Ω/K) →* Gal(L/K)` and `Gal(Ω/K) →* Gal(M/K)` have product kernel exactly
`L.fixingSubgroup ⊓ M.fixingSubgroup = (L ⊔ M).fixingSubgroup`
(`IntermediateField.fixingSubgroup_sup`), so they descend to an injection on that quotient.
Concretely: an automorphism of `L ⊔ M` fixing `L` and `M` pointwise fixes everything in `L ⊔ M`,
because `L ⊔ M` is the field generated by `L ∪ M`.

This is stated with an `∃` (rather than by exhibiting the composite of restrictions, which
would require the tower instance `Algebra ↥L ↥(L ⊔ M)`) because that is exactly the form in
which `IsPGroup.of_injective` consumes it. -/
theorem exists_injective_restrictNormalHom_sup {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    [Normal K Ω] (L M : IntermediateField K Ω) [Normal K ↥L] [Normal K ↥M] :
    ∃ e : (↥(L ⊔ M) ≃ₐ[K] ↥(L ⊔ M)) →* (↥L ≃ₐ[K] ↥L) × (↥M ≃ₐ[K] ↥M),
      Function.Injective e := by
  have hAn : Normal K ↥(L ⊔ M) := inferInstance
  -- the product of the two restriction maps on `Gal(Ω/K)`
  let Φ : (Ω ≃ₐ[K] Ω) →* (↥L ≃ₐ[K] ↥L) × (↥M ≃ₐ[K] ↥M) :=
    (AlgEquiv.restrictNormalHom ↥L).prod (AlgEquiv.restrictNormalHom ↥M)
  -- its kernel is the fixing subgroup of the compositum
  have hker : Φ.ker = (L ⊔ M).fixingSubgroup := by
    rw [MonoidHom.ker_prod, IntermediateField.restrictNormalHom_ker,
      IntermediateField.restrictNormalHom_ker, ← IntermediateField.fixingSubgroup_sup]
  -- hence it descends to the quotient `Gal(Ω/K) ⧸ (L ⊔ M).fixingSubgroup`, injectively
  let Ψ : (Ω ≃ₐ[K] Ω) ⧸ Φ.ker →* (↥L ≃ₐ[K] ↥L) × (↥M ≃ₐ[K] ↥M) :=
    QuotientGroup.lift Φ.ker Φ le_rfl
  have hΨinj : Function.Injective Ψ := by
    rw [← MonoidHom.ker_eq_bot_iff, QuotientGroup.ker_lift]
    simp
  -- and that quotient is `Gal(L ⊔ M/K)`, because `L ⊔ M` is normal over `K`
  let r : (Ω ≃ₐ[K] Ω) →* (↥(L ⊔ M) ≃ₐ[K] ↥(L ⊔ M)) :=
    AlgEquiv.restrictNormalHom ↥(L ⊔ M)
  have hsurj : Function.Surjective r := AlgEquiv.restrictNormalHom_surjective (K₁ := ↥(L ⊔ M)) Ω
  have hkerA : r.ker = Φ.ker := by
    rw [IntermediateField.restrictNormalHom_ker, ← hker]
  have e1 : (↥(L ⊔ M) ≃ₐ[K] ↥(L ⊔ M)) ≃* ((Ω ≃ₐ[K] Ω) ⧸ r.ker) :=
    (QuotientGroup.quotientKerEquivOfSurjective r hsurj).symm
  refine ⟨Ψ.comp (e1.trans (QuotientGroup.quotientMulEquivOfEq hkerA)).toMonoidHom, ?_⟩
  intro a b h
  exact (e1.trans (QuotientGroup.quotientMulEquivOfEq hkerA)).injective (hΨinj h)

/-- **The compositum of two `ℓ`-levels is again an `ℓ`-level.**  For a number field `K` inside a
Galois extension `Ω/K` and finite normal levels `L`, `M` of `Ω/K` whose Galois groups
`Gal(L/K)`, `Gal(M/K)` are `ℓ`-groups, the compositum `L ⊔ M` has `ℓ`-group Galois group:
`Gal(L ⊔ M/K)` embeds into `Gal(L/K) × Gal(M/K)` via the two restriction maps
(`NK.NUV2.ArtinBridge.exists_injective_restrictNormalHom_sup`), a product of `ℓ`-groups is an
`ℓ`-group (`NK.NUV2.ArtinBridge.isPGroup_prod`), and a subgroup of an `ℓ`-group is an
`ℓ`-group.

This is the directedness of the `ℓ`-levels used by the levelwise Artin bridge
(`NK.NUV2.ArtinBridge.CanonicalArtinDatum`, `NK.NUV2.ArtinBridge.LevelPairIso`). -/
theorem isPGroup_sup_of_isPGroup {K : Type} [Field K] [NumberField K] {Ω : Type} [Field Ω]
    [Algebra K Ω] [IsGalois K Ω] (ℓ : ℕ) (L M : NK.Reconstruct.FrobLevel K Ω)
    (hL : IsPGroup ℓ (↥L.L ≃ₐ[K] ↥L.L)) (hM : IsPGroup ℓ (↥M.L ≃ₐ[K] ↥M.L)) :
    IsPGroup ℓ (↥(L.L ⊔ M.L) ≃ₐ[K] ↥(L.L ⊔ M.L)) := by
  have hLn : Normal K ↥L.L := L.normal
  have hMn : Normal K ↥M.L := M.normal
  obtain ⟨e, he⟩ := exists_injective_restrictNormalHom_sup L.L M.L
  exact (isPGroup_prod ℓ hL hM).of_injective e he

end NK.NUV2.ArtinBridge
