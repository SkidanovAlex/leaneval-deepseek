/-!
# `r_ℂ(K) + 1 ≤ finrank_{ℤ_2} Hom_cts(C_K, ℤ_2)`

The idèle-side lower half of CoNF (10.3.20), in `finrank` form: the continuous character module
of the idèle class group has `ℤ_2`-rank at least `r_ℂ(K) + 1`.

The proof has three parts, in the spirit of the classical computation
`rank Hom_cts(C_K, ℤ_ℓ) = [K : ℚ] - u`:

* the characters of the integral idèles `∏_v 𝒪_vˣ` at the places above `2` give
  `rank Hom_cts(𝕀_int, ℤ_2) ≥ ∑_{q | 2} e_q f_q = [K : ℚ]`;
* the constraint "vanish on the global units `𝒪_Kˣ`" is at most `(𝓞 K)ˣ`-many conditions, and the
  units have `ℤ`-rank `r_1 + r_2 - 1`, so `r_ℂ(K) + 1 = [K : ℚ] - (r_1 + r_2 - 1)` characters
  survive on `𝕀_int ⧸ 𝒪_Kˣ`;
* the latter is a finite-index subgroup of `C_K` (the quotient is the class group), and the
  transfer `x ↦ x ^ N` turns a character of a finite-index subgroup into a continuous character
  of `C_K`.

The finiteness of the rank is the *upper* half of CoNF (10.3.20), which needs no class field
theory and is available as `NK.RankTheoryDeep.rank_dual_integralIdeles_le` together with the
local unit structure at `2` (`NK.NUV2.localUnits_two`).
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped NumberField Topology

namespace NK.NUV2

open NK.GlobalCFT

noncomputable section

universe u

/-! ## Part 1: arithmetic of `r_ℂ(K)`, the unit rank and `[K : ℚ]` -/

/-- `r_ℂ(K)` is Mathlib's `nrComplexPlaces`. -/
theorem rComplex_eq_nrComplexPlaces (K : Type*) [Field K] [NumberField K] :
    NK.Reconstruct.rComplex K = NumberField.InfinitePlace.nrComplexPlaces K := by
  classical
  rw [NK.Reconstruct.rComplex, NumberField.InfinitePlace.nrComplexPlaces]
  exact Nat.card_eq_fintype_card

/-- **The unit rank and `r_ℂ(K) + 1` exhaust `[K : ℚ]`**: with the units having `ℤ`-rank
`r_1 + r_2 - 1` and `[K : ℚ] = r_1 + 2 r_2`, one has
`(r_1 + r_2 - 1) + (r_ℂ(K) + 1) ≤ [K : ℚ]`. -/
theorem unitsRank_add_rComplex_add_one_le_finrank (K : Type*) [Field K] [NumberField K] :
    NumberField.Units.rank K + (NK.Reconstruct.rComplex K + 1) ≤ Module.finrank ℚ K := by
  rw [NumberField.Units.rank, rComplex_eq_nrComplexPlaces]
  have hcard := NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces K
  have hrank := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  have hpos : 1 ≤ Fintype.card (NumberField.InfinitePlace K) :=
    Fintype.card_pos_iff.mpr inferInstance
  omega

/-- **The unit rank and `r_ℂ(K) + 1` exhaust `[K : ℚ]`** (the equality form). -/
theorem finrank_eq_unitsRank_add (K : Type) [Field K] [NumberField K] :
    Module.finrank ℚ K = NumberField.Units.rank K + (NK.Reconstruct.rComplex K + 1) := by
  rw [NumberField.Units.rank, rComplex_eq_nrComplexPlaces]
  have hcard := NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces K
  have hrank := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  have hpos : 1 ≤ Fintype.card (NumberField.InfinitePlace K) :=
    Fintype.card_pos_iff.mpr inferInstance
  omega

/-! ## Part 2: the character module of the global units is at most `r_1 + r_2 - 1`-dimensional -/

/-- **Every character of `(𝓞 K)ˣ` is determined by its values on the fundamental system.**  The
units of `K` are the torsion subgroup times the free part generated by `fundSystem`
(`NumberField.Units.exist_unique_eq_mul_prod`), and a character into the torsion-free group `ℤ_2`
kills the torsion subgroup; hence evaluation at `fundSystem` is injective. -/
theorem rank_addMonoidHom_units_le (K : Type) [Field K] [NumberField K] :
    Module.rank (PadicInt 2) (Additive (𝓞 K)ˣ →+ PadicInt 2)
      ≤ (NumberField.Units.rank K : Cardinal) := by
  classical
  let Φ : (Additive (𝓞 K)ˣ →+ PadicInt 2) →ₗ[PadicInt 2]
      (Fin (NumberField.Units.rank K) → PadicInt 2) :=
    { toFun := fun χ i => χ (Additive.ofMul (NumberField.Units.fundSystem K i))
      map_add' := fun χ χ' => rfl
      map_smul' := fun a χ => rfl }
  have hinj : Function.Injective Φ := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro ψ hψ
    apply AddMonoidHom.ext
    intro x
    rw [AddMonoidHom.zero_apply]
    obtain ⟨u, rfl⟩ : ∃ u : (𝓞 K)ˣ, Additive.ofMul u = x := ⟨Additive.toMul x, rfl⟩
    obtain ⟨⟨ζ, e⟩, he, -⟩ := NumberField.Units.exist_unique_eq_mul_prod K u
    have hgen : ∀ i, ψ (Additive.ofMul (NumberField.Units.fundSystem K i)) = 0 := by
      intro i
      have h := congrFun (LinearMap.mem_ker.mp hψ) i
      simpa [Φ] using h
    have hz : ψ (Additive.ofMul (ζ : (𝓞 K)ˣ)) = 0 := by
      have hmem : IsOfFinOrder (ζ : (𝓞 K)ˣ) := (CommGroup.mem_torsion _).mp ζ.2
      obtain ⟨n, hn, hn1⟩ := isOfFinOrder_iff_pow_eq_one.mp hmem
      have h1 : n • ψ (Additive.ofMul (ζ : (𝓞 K)ˣ)) = 0 := by
        rw [← map_nsmul, ← ofMul_pow, hn1, ofMul_one, map_zero]
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hn.ne')
    have hmain : ψ (Additive.ofMul u) =
        ψ (Additive.ofMul (ζ : (𝓞 K)ˣ))
          + ∑ i, e i • ψ (Additive.ofMul (NumberField.Units.fundSystem K i)) := by
      conv_lhs => rw [he]
      rw [ofMul_mul, ofMul_prod, map_add, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [ofMul_zpow, map_zsmul]
    rw [hmain, hz, zero_add]
    exact Finset.sum_eq_zero fun i _ => by rw [hgen i, smul_zero]
  calc Module.rank (PadicInt 2) (Additive (𝓞 K)ˣ →+ PadicInt 2)
      ≤ Module.rank (PadicInt 2) (Fin (NumberField.Units.rank K) → PadicInt 2) :=
        LinearMap.rank_le_of_injective Φ hinj
    _ = (NumberField.Units.rank K : Cardinal) := by
        rw [← Module.finrank_eq_rank, Module.finrank_fintype_fun_eq_card, Fintype.card_fin]



/-! ## Part 3: characters of the integral idèles which kill `𝒪_Kˣ` extend to `C_K` -/

/-- **A group homomorphism with open kernel is continuous**: it is the quotient map onto the
discrete group `G ⧸ ker f`, followed by an arbitrary map. -/
theorem continuous_of_open_kernel {G : Type*} [Group G] [TopologicalSpace G] [ContinuousMul G]
    {H : Type*} [Group H] [TopologicalSpace H] (f : G →* H) (h : IsOpen (f.ker : Set G)) :
    Continuous f := by
  haveI : DiscreteTopology (G ⧸ f.ker) := QuotientGroup.discreteTopology h
  have hfac : f = (QuotientGroup.lift f.ker f le_rfl).comp (QuotientGroup.mk' f.ker) := by
    ext g
    exact QuotientGroup.lift_mk' f.ker le_rfl g
  rw [hfac]
  exact (continuous_of_discreteTopology (f := fun y : G ⧸ f.ker =>
    QuotientGroup.lift f.ker f le_rfl y)).comp QuotientGroup.continuous_mk

/-- **An additive homomorphism with open kernel is continuous.** -/
theorem continuous_of_open_kernel_add {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] {H : Type*} [AddCommGroup H] [TopologicalSpace H]
    (f : G →+ H) (h : IsOpen (f.ker : Set G)) : Continuous f := by
  haveI : DiscreteTopology (G ⧸ f.ker) := QuotientAddGroup.discreteTopology h
  have hfac : f = (QuotientAddGroup.lift f.ker f le_rfl).comp (QuotientAddGroup.mk' f.ker) := by
    ext g
    exact QuotientAddGroup.lift_mk' f.ker le_rfl g
  rw [hfac]
  exact (continuous_of_discreteTopology (f := fun y : G ⧸ f.ker =>
    QuotientAddGroup.lift f.ker f le_rfl y)).comp QuotientAddGroup.continuous_mk

section Extension

variable (K : Type) [Field K] [NumberField K]

/-- **An integral principal idèle is the diagonal image of a global unit.** -/
theorem principalSubgroup_subgroupOf_le_range_unitsToIntegral :
    (Idele.principalSubgroup K).subgroupOf (Idele.integralIdeles K) ≤
      (unitsToIntegral K).range := by
  intro y hy
  rw [Subgroup.mem_subgroupOf] at hy
  obtain ⟨k, hk⟩ := Idele.mem_principalSubgroup.mp hy
  rw [MonoidHom.mem_range]
  have h1 : FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (k : K) = 1 := by
    have h2 : (y : Idele K).idealOf = 1 := (Idele.idealOf_eq_one_iff _).mpr y.2
    rw [← hk, Idele.idealOf_principalIdele] at h2
    exact h2
  obtain ⟨u, hu⟩ : ∃ u : (𝓞 K)ˣ, (u : K) = (k : K) := by
    rw [← FractionalIdeal.spanSingleton_one (S := nonZeroDivisors (𝓞 K)) (R := 𝓞 K) (P := K),
      FractionalIdeal.spanSingleton_eq_spanSingleton] at h1
    obtain ⟨z, hz⟩ := h1
    refine ⟨z⁻¹, ?_⟩
    have hz' : (algebraMap (𝓞 K) K) (z : 𝓞 K) * (k : K) = 1 := by
      simpa [Units.smul_def, Algebra.smul_def] using hz
    have hmul : (algebraMap (𝓞 K) K) (z : 𝓞 K) *
        (algebraMap (𝓞 K) K) ((z⁻¹ : (𝓞 K)ˣ) : 𝓞 K) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    have haz : (algebraMap (𝓞 K) K) (z : 𝓞 K) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hz'
      exact one_ne_zero hz'.symm
    have hk' : (k : K) = (algebraMap (𝓞 K) K) ((z⁻¹ : (𝓞 K)ˣ) : 𝓞 K) :=
      mul_left_cancel₀ haz (by rw [hz', hmul])
    exact hk'.symm
  refine ⟨u, ?_⟩
  apply Subtype.ext
  rw [unitsToIntegral_coe, ← hk]
  congr 1
  apply Units.ext
  simpa [Units.coe_map] using hu

/-- **A continuous character of `𝕀_int` killing the diagonal global units extends to `C_K`.**

The extension is `Ψ x = ψ y`, where `y ∈ 𝕀_int` is any integral idèle whose class is `x ^ N`
(`N = |Cl(K)|`); it is well defined because two such idèles differ by an element of
`𝒪_Kˣ = 𝕀_int ∩ Kˣ`, on which `ψ` vanishes, and it is continuous by the criterion
`continuous_of_toZModPow_comp`: the `2 ^ n`-reductions of `Ψ` kill an open subgroup of `C_K`. -/
theorem rank_ker_restrictUnits_le_rank_dual_classGroup :
    Module.rank (PadicInt 2) ↥(restrictUnits (K := K)).ker
      ≤ Module.rank (PadicInt 2) (NK.Reconstruct.Dual (IdeleClassGroup K) 2) := by
  classical
  obtain ⟨f, hker, -⟩ := IdeleClassGroup.local_global_exact_sequence K
  set N : ℕ := Nat.card (ClassGroup (𝓞 K)) with hN
  have hNpos : 0 < N := by rw [hN]; exact Nat.card_pos
  have hpow : ∀ x : IdeleClassGroup K,
      x ^ N ∈ Subgroup.map (IdeleClassGroup.mk K) (Idele.integralIdeles K) := by
    intro x
    rw [← hker, MonoidHom.mem_ker, map_pow, hN]
    exact pow_card_eq_one'
  have hex : ∀ x : IdeleClassGroup K, ∃ y : ↥(Idele.integralIdeles K),
      IdeleClassGroup.mk K (y : Idele K) = x ^ N := by
    intro x
    obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp (hpow x)
    exact ⟨⟨y, hy⟩, hxy⟩
  let sec : IdeleClassGroup K → ↥(Idele.integralIdeles K) := fun x => Classical.choose (hex x)
  have hsec : ∀ x, IdeleClassGroup.mk K
      ((sec x : ↥(Idele.integralIdeles K)) : Idele K) = x ^ N :=
    fun x => Classical.choose_spec (hex x)
  have hkill : ∀ (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2),
      restrictUnits ψ = 0 → ∀ y : ↥(Idele.integralIdeles K),
      y ∈ (Idele.principalSubgroup K).subgroupOf (Idele.integralIdeles K) →
        ψ (Additive.ofMul y) = 0 := by
    intro ψ hψ y hy
    obtain ⟨u, hu⟩ := principalSubgroup_subgroupOf_le_range_unitsToIntegral K hy
    have h0 : restrictUnits ψ (Additive.ofMul u) = 0 := by rw [hψ]; rfl
    rw [restrictUnits_apply] at h0
    rwa [hu] at h0
  have hdiff : ∀ a b : ↥(Idele.integralIdeles K),
      IdeleClassGroup.mk K (a : Idele K) = IdeleClassGroup.mk K (b : Idele K) →
      a⁻¹ * b ∈ (Idele.principalSubgroup K).subgroupOf (Idele.integralIdeles K) := by
    intro a b hab
    rw [Subgroup.mem_subgroupOf]
    have h := (IdeleClassGroup.mk_eq_mk_iff (K := K)).mp hab
    simpa using h
  have hcoe : ∀ a b : ↥(Idele.integralIdeles K),
      (((a * b : ↥(Idele.integralIdeles K)) : Idele K)) = (a : Idele K) * (b : Idele K) :=
    fun a b => rfl
  have hpow_coe : ∀ (a : ↥(Idele.integralIdeles K)) (m : ℕ),
      (((a ^ m : ↥(Idele.integralIdeles K)) : Idele K)) = (a : Idele K) ^ m :=
    fun a m => rfl
  -- the extension of a character, computed via the section `sec`
  have hmul : ∀ (ψ : ↥(restrictUnits (K := K)).ker) (x y : IdeleClassGroup K),
      (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2) (Additive.ofMul (sec (x * y)))
        = (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
            (Additive.ofMul (sec x))
          + (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
            (Additive.ofMul (sec y)) := by
    intro ψ x y
    have hmk : IdeleClassGroup.mk K ((sec (x * y) : ↥(Idele.integralIdeles K)) : Idele K) =
        IdeleClassGroup.mk K (((sec x * sec y : ↥(Idele.integralIdeles K)) : Idele K)) := by
      rw [hsec (x * y), hcoe (sec x) (sec y), map_mul, hsec x, hsec y, mul_pow]
    have hδ : (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
        (Additive.ofMul ((sec (x * y))⁻¹ * (sec x * sec y))) = 0 :=
      hkill _ (LinearMap.mem_ker.mp ψ.2) _ (hdiff _ _ hmk)
    have key : Additive.ofMul (sec (x * y)) +
        Additive.ofMul ((sec (x * y))⁻¹ * (sec x * sec y)) =
        Additive.ofMul (sec x * sec y) := by
      rw [ofMul_mul, ofMul_mul, ofMul_inv]
      abel
    have hb : Additive.ofMul (sec x * sec y) =
        Additive.ofMul (sec x) + Additive.ofMul (sec y) := by
      rw [ofMul_mul]
    calc (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
          (Additive.ofMul (sec (x * y)))
        = ψ.1 (Additive.ofMul (sec (x * y))) +
            ψ.1 (Additive.ofMul ((sec (x * y))⁻¹ * (sec x * sec y))) := by
          rw [hδ, add_zero]
      _ = ψ.1 (Additive.ofMul (sec (x * y)) +
            Additive.ofMul ((sec (x * y))⁻¹ * (sec x * sec y))) := (map_add _ _ _).symm
      _ = ψ.1 (Additive.ofMul (sec x * sec y)) := by rw [key]
      _ = ψ.1 (Additive.ofMul (sec x) + Additive.ofMul (sec y)) := by rw [hb]
      _ = ψ.1 (Additive.ofMul (sec x)) + ψ.1 (Additive.ofMul (sec y)) := map_add _ _ _
  have hzero : ∀ ψ : ↥(restrictUnits (K := K)).ker,
      (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
        (Additive.ofMul (sec (1 : IdeleClassGroup K))) = 0 := by
    intro ψ
    have hsec1 : sec (1 : IdeleClassGroup K) ∈
        (Idele.principalSubgroup K).subgroupOf (Idele.integralIdeles K) := by
      rw [Subgroup.mem_subgroupOf]
      have h : IdeleClassGroup.mk K ((sec (1 : IdeleClassGroup K) :
          ↥(Idele.integralIdeles K)) : Idele K) = IdeleClassGroup.mk K (1 : Idele K) := by
        rw [hsec (1 : IdeleClassGroup K), one_pow]
        rfl
      have h2 := (IdeleClassGroup.mk_eq_mk_iff (K := K)).mp h
      simpa using (Idele.principalSubgroup K).inv_mem h2
    exact hkill _ (LinearMap.mem_ker.mp ψ.2) _ hsec1
  -- reduced characters of the integral idèles
  have hred : ∀ ψ : ↥(restrictUnits (K := K)).ker, ∀ y : ↥(Idele.integralIdeles K),
      ψ.1 (Additive.ofMul y) = ψ.1 (Additive.ofMul y) := fun _ _ => rfl
  -- characters killing `𝒪_Kˣ` depend only on the class of an integral idèle
  have heq_of_kill : ∀ (ψ : ↥(restrictUnits (K := K)).ker) (a b : ↥(Idele.integralIdeles K)),
      a⁻¹ * b ∈ (Idele.principalSubgroup K).subgroupOf (Idele.integralIdeles K) →
      ψ.1 (Additive.ofMul a) = ψ.1 (Additive.ofMul b) := by
    intro ψ a b hab
    have hz := hkill _ (LinearMap.mem_ker.mp ψ.2) _ hab
    have key : Additive.ofMul a + Additive.ofMul (a⁻¹ * b) = Additive.ofMul b := by
      rw [ofMul_mul, ofMul_inv]
      abel
    calc ψ.1 (Additive.ofMul a)
        = ψ.1 (Additive.ofMul a) + ψ.1 (Additive.ofMul (a⁻¹ * b)) := by rw [hz, add_zero]
      _ = ψ.1 (Additive.ofMul a + Additive.ofMul (a⁻¹ * b)) := (map_add _ _ _).symm
      _ = ψ.1 (Additive.ofMul b) := by rw [key]
  -- the extension is continuous
  have hcont : ∀ ψ : ↥(restrictUnits (K := K)).ker,
      Continuous (fun x : Additive (IdeleClassGroup K) =>
        (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
          (Additive.ofMul (sec (Additive.toMul x)))) := by
    intro ψ
    let g : Additive (IdeleClassGroup K) →+ PadicInt 2 :=
      { toFun := fun x => (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
          (Additive.ofMul (sec (Additive.toMul x)))
        map_zero' := by simpa using hzero ψ
        map_add' := by
          intro x y
          exact hmul ψ (Additive.toMul x) (Additive.toMul y) }
    refine NK.RankTheoryDeep.continuous_of_toZModPow_comp (g := g)
      (f := fun n => (PadicInt.toZModPow n).toAddMonoidHom.comp g) ?_ ?_
    · intro n
      refine continuous_of_open_kernel_add _ ?_
      -- the open set `U ⊆ 𝕀_int` on which the `2 ^ n`-reduction of `ψ` vanishes
      set U : Set ↥(Idele.integralIdeles K) :=
        {y | PadicInt.toZModPow n ((ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
          (Additive.ofMul y)) = 0} with hU
      have hspan : ((Ideal.span {(((2 : ℕ) : ℤ_[2]) ^ n)} : Ideal ℤ_[2]) : Set ℤ_[2]) ∈ 𝓝 0 := by
        refine Filter.mem_of_superset
          (Metric.ball_mem_nhds (0 : ℤ_[2]) (by positivity : (0 : ℝ) < (2 : ℝ) ^ (-(n : ℤ)))) ?_
        intro z hz
        rw [Metric.mem_ball, dist_zero_right] at hz
        exact (PadicInt.norm_le_pow_iff_mem_span_pow z n).mp (le_of_lt hz)
      have hspanOpen : IsOpen (((Ideal.span {(((2 : ℕ) : ℤ_[2]) ^ n)} : Ideal ℤ_[2])) : Set ℤ_[2]) :=
        (Ideal.span {(((2 : ℕ) : ℤ_[2]) ^ n)}).toAddSubgroup.isOpen_of_mem_nhds hspan
      have hUopen : IsOpen U := by
        have hmemb : ∀ z : ℤ_[2], PadicInt.toZModPow n z = 0 ↔
            z ∈ (Ideal.span {(((2 : ℕ) : ℤ_[2]) ^ n)} : Ideal ℤ_[2]) := by
          intro z
          rw [← PadicInt.ker_toZModPow (p := 2) n, RingHom.mem_ker]
        have hpre : U = (fun y : ↥(Idele.integralIdeles K) =>
            (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2) (Additive.ofMul y)) ⁻¹'
            ((Ideal.span {(((2 : ℕ) : ℤ_[2]) ^ n)} : Ideal ℤ_[2])) := by
          ext y
          rw [hU]
          exact hmemb _
        rw [hpre]
        exact hspanOpen.preimage ψ.1.2
      obtain ⟨V, hVopen, hVU⟩ := isOpen_induced_iff.mp hUopen
      have hImgOpen : IsOpen (IdeleClassGroup.mk K ''
          ((Idele.integralIdeles K : Set (Idele K)) ∩ V)) :=
        (show IsOpenMap (IdeleClassGroup.mk K) from by
          rw [show IdeleClassGroup.mk K = QuotientGroup.mk' (Idele.principalSubgroup K) from rfl]
          exact QuotientGroup.isOpenMap_coe)
          _ ((isOpen_integralIdeles (K := K)).inter hVopen)
      refine AddSubgroup.isOpen_of_mem_nhds
        ((PadicInt.toZModPow n).toAddMonoidHom.comp g).ker (g := 0) ?_
      refine Filter.mem_of_superset (hImgOpen.mem_nhds ?_) ?_
      · refine ⟨1, ⟨(Idele.integralIdeles K).one_mem, ?_⟩, map_one _⟩
        have hU1 : (1 : ↥(Idele.integralIdeles K)) ∈ U := by rw [hU]; simp
        have hV1 : (1 : ↥(Idele.integralIdeles K)) ∈ Subtype.val ⁻¹' V := by
          rw [hVU]; exact hU1
        exact hV1
      · intro z hz
        rw [SetLike.mem_coe]
        obtain ⟨v, hvmem, rfl⟩ := hz
        obtain ⟨hvint, hvV⟩ := hvmem
        have hvU : (⟨v, hvint⟩ : ↥(Idele.integralIdeles K)) ∈ U := by
          rw [← hVU, Set.mem_preimage]
          exact hvV
        have hψv : PadicInt.toZModPow n ((ψ : NK.Reconstruct.Dual
            (↥(Idele.integralIdeles K)) 2)
            (Additive.ofMul (⟨v, hvint⟩ : ↥(Idele.integralIdeles K)))) = 0 := hvU
        have hsame : IdeleClassGroup.mk K
            ((sec (IdeleClassGroup.mk K v) : ↥(Idele.integralIdeles K)) : Idele K)
            = IdeleClassGroup.mk K
              (((⟨v, hvint⟩ : ↥(Idele.integralIdeles K)) ^ N : ↥(Idele.integralIdeles K)) :
                Idele K) := by
          rw [hsec (IdeleClassGroup.mk K v), hpow_coe, map_pow]
        have hkill' := heq_of_kill ψ _ _ (hdiff _ _ hsame)
        show PadicInt.toZModPow n (g (Additive.ofMul (IdeleClassGroup.mk K v))) = 0
        show PadicInt.toZModPow n ((ψ : NK.Reconstruct.Dual
            (↥(Idele.integralIdeles K)) 2)
            (Additive.ofMul (sec (IdeleClassGroup.mk K v)))) = 0
        rw [hkill']
        rw [show Additive.ofMul (((⟨v, hvint⟩ : ↥(Idele.integralIdeles K)) ^ N :
              ↥(Idele.integralIdeles K))) =
            N • Additive.ofMul (⟨v, hvint⟩ : ↥(Idele.integralIdeles K)) from ofMul_pow N _,
          map_nsmul]
        rw [show N • (ψ.1 (Additive.ofMul (⟨v, hvint⟩ : ↥(Idele.integralIdeles K)))) =
            (N : ℤ_[2]) * (ψ.1 (Additive.ofMul (⟨v, hvint⟩ : ↥(Idele.integralIdeles K))))
            from nsmul_eq_mul N _, map_mul, hψv, mul_zero]
    · intro n x
      rfl
  -- the extension map is injective
  let EFun' : ↥(restrictUnits (K := K)).ker → Additive (IdeleClassGroup K) → PadicInt 2 :=
    fun ψ x => (ψ : NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2)
      (Additive.ofMul (sec (Additive.toMul x)))
  let E : ↥(restrictUnits (K := K)).ker →ₗ[PadicInt 2]
      NK.Reconstruct.Dual (IdeleClassGroup K) 2 :=
    { toFun := fun ψ =>
        ⟨{ toFun := EFun' ψ, map_zero' := by simpa using hzero ψ,
           map_add' := by intro x y; exact hmul ψ (Additive.toMul x) (Additive.toMul y) },
         hcont ψ⟩,
      map_add' := fun ψ ψ' => by ext x; rfl,
      map_smul' := fun a ψ => by ext x; rfl }
  refine LinearMap.rank_le_of_injective E ?_
  intro ψ ψ' h
  have hval : ∀ y : ↥(Idele.integralIdeles K),
      ψ.1 (Additive.ofMul y) = ψ'.1 (Additive.ofMul y) := by
    intro y
    have h1 : (E ψ) (Additive.ofMul (IdeleClassGroup.mk K (y : Idele K))) =
        (E ψ') (Additive.ofMul (IdeleClassGroup.mk K (y : Idele K))) := by rw [h]
    have hsame : IdeleClassGroup.mk K
        ((sec (IdeleClassGroup.mk K (y : Idele K)) : ↥(Idele.integralIdeles K)) : Idele K)
        = IdeleClassGroup.mk K (((y ^ N : ↥(Idele.integralIdeles K)) : Idele K)) := by
      rw [hsec (IdeleClassGroup.mk K (y : Idele K)), hpow_coe, map_pow]
    have h2 := heq_of_kill ψ _ _ (hdiff _ _ hsame)
    have h3 := heq_of_kill ψ' _ _ (hdiff _ _ hsame)
    have hE : ∀ (χ : ↥(restrictUnits (K := K)).ker) (z : IdeleClassGroup K),
        (E χ) (Additive.ofMul z) = χ.1 (Additive.ofMul (sec z)) := fun _ _ => rfl
    have h4 : (E ψ) (Additive.ofMul (IdeleClassGroup.mk K (y : Idele K))) =
        N • ψ.1 (Additive.ofMul y) := by
      rw [hE, h2]
      rw [show Additive.ofMul ((y ^ N : ↥(Idele.integralIdeles K))) =
        N • Additive.ofMul y from ofMul_pow N y, map_nsmul]
    have h5 : (E ψ') (Additive.ofMul (IdeleClassGroup.mk K (y : Idele K))) =
        N • ψ'.1 (Additive.ofMul y) := by
      rw [hE, h3]
      rw [show Additive.ofMul ((y ^ N : ↥(Idele.integralIdeles K))) =
        N • Additive.ofMul y from ofMul_pow N y, map_nsmul]
    rw [h4, h5] at h1
    have h6 : (N : PadicInt 2) * (ψ.1 (Additive.ofMul y)) =
        (N : PadicInt 2) * (ψ'.1 (Additive.ofMul y)) := by
      simpa [nsmul_eq_mul] using h1
    exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr hNpos.ne') h6
  ext y
  exact hval (Additive.toMul y)

/-! ## Part 4: the lower bound for the character module of the integral idèles -/

/-- The finite set of places of `K` above `2`, as height-one primes of `𝓞 K`. -/
noncomputable def twoPlaces (K : Type) [Field K] [NumberField K] :
    Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) := by
  classical
  exact (Finset.univ : Finset ↥((Ideal.span {((2 : ℕ) : ℤ)}).primesOver
    (NumberField.RingOfIntegers K))).image (NK.RankTheoryDeep.primeOfOver K)

/-- `q` belongs to `twoPlaces K` iff it lies over the rational prime `2`. -/
theorem mem_twoPlaces {K : Type} [Field K] [NumberField K]
    {q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)} :
    q ∈ twoPlaces K ↔ q.asIdeal.LiesOver (Ideal.span {(2 : ℤ)}) := by
  classical
  rw [twoPlaces, Finset.mem_image]
  constructor
  · rintro ⟨q', -, hq⟩
    rw [← hq]
    exact q'.2.2
  · intro hq
    have hmem : (2 : NumberField.RingOfIntegers K) ∈ q.asIdeal := by
      have := (Ideal.mem_of_liesOver (P := q.asIdeal) (p := Ideal.span {((2 : ℕ) : ℤ)})
        (A := ℤ) (B := NumberField.RingOfIntegers K) (2 : ℤ)).mp
        (Ideal.mem_span_singleton_self (2 : ℤ))
      simpa using this
    have hq' : q.asIdeal ∈ (Ideal.span {((2 : ℕ) : ℤ)}).primesOver
        (NumberField.RingOfIntegers K) :=
      (NK.RankTheoryDeep.primesOver_span_iff_mem K q).mpr hmem
    exact ⟨⟨q.asIdeal, hq'⟩, Finset.mem_univ _, rfl⟩

/-- **The character module of the integral idèles is at least `[K : ℚ]`-dimensional**, given the
local unit structure at the places above `2`.

Each place `q | 2` contributes an injective linear map `ℤ_2 ^ (e_q f_q) →ₗ Dual (𝒪_qˣ)`, and the
"test idèles" at the places `q | 2` (`NK.NUV2.Phi`) make the combined map injective; the sum of
the local degrees is `[K : ℚ]`. -/
theorem rank_dual_integralIdeles_lowerBound (K : Type) [Field K] [NumberField K]
    (hloc : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      q.asIdeal.LiesOver (Ideal.span {(2 : ℤ)}) →
      (((q.asIdeal.ramificationIdx ℤ * q.asIdeal.inertiaDeg ℤ : ℕ)) : Cardinal) ≤
        Module.rank (PadicInt 2) (NK.Reconstruct.Dual
          (↥(NK.GlobalCFT.Place.localUnits K (NK.GlobalCFT.Place.ofFinite q))) 2)) :
    (Module.finrank ℚ K : Cardinal) ≤
      Module.rank (PadicInt 2) (NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2) := by
  classical
  set S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    twoPlaces K with hS
  -- the local degree, as a function of a height-one prime
  set n : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ :=
    fun q => q.asIdeal.ramificationIdx ℤ * q.asIdeal.inertiaDeg ℤ with hn
  have hlies : ∀ q : ↥S, (q : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)).asIdeal.LiesOver (Ideal.span {(2 : ℤ)}) := by
    intro q
    have h1 : (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) ∈
        twoPlaces K := by rw [← hS]; exact q.2
    simpa using (mem_twoPlaces (K := K)).mp h1
  have hloc' : ∀ q : ↥S, (n (q : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K)) : Cardinal) ≤
      Module.rank (PadicInt 2) (NK.Reconstruct.Dual
        (↥(NK.GlobalCFT.Place.localUnits K
          (NK.GlobalCFT.Place.ofFinite (q : IsDedekindDomain.HeightOneSpectrum
            (NumberField.RingOfIntegers K))))) 2) := by
    intro q
    rw [hn]
    exact hloc _ (hlies q)
  -- the injections `ℤ_2 ^ (e_q f_q) ↪ Dual (𝒪_qˣ)`
  have hinj : ∀ q : ↥S, ∃ f : (Fin (n (q : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K))) → PadicInt 2) →ₗ[PadicInt 2]
      NK.Reconstruct.Dual (↥(NK.GlobalCFT.Place.localUnits K
        (NK.GlobalCFT.Place.ofFinite (q : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K))))) 2, Function.Injective f := by
    intro q
    obtain ⟨s, hs_card, hs_li⟩ := exists_set_linearIndependent (PadicInt 2)
      (NK.Reconstruct.Dual (↥(NK.GlobalCFT.Place.localUnits K
        (NK.GlobalCFT.Place.ofFinite (q : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K))))) 2)
    refine Module.Free.exists_linearMap_injective_of_linearIndependent_of_rank_le
      (v := Subtype.val) hs_li ?_
    have h1 : Module.rank (PadicInt 2) (Fin (n (q : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K))) → PadicInt 2)
        = (n (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
            Cardinal) := by
      rw [← Module.finrank_eq_rank, Module.finrank_pi, Fintype.card_fin]
    rw [h1, hs_card]
    exact hloc' q
  choose f hf using hinj
  -- the product of the local injections
  let F : ((q : ↥S) → (Fin (n (q : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K))) → PadicInt 2)) →ₗ[PadicInt 2]
      ((q : ↥S) → NK.Reconstruct.Dual (↥(NK.GlobalCFT.Place.localUnits K
        (NK.GlobalCFT.Place.ofFinite (q : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K))))) 2) :=
    { toFun := fun x q => f q (x q)
      map_add' := by intro x y; funext q; exact (f q).map_add (x q) (y q)
      map_smul' := by intro a x; funext q; exact (f q).map_smul a (x q) }
  have hF : Function.Injective F := by
    intro x y hxy
    funext q
    have h := congrFun hxy q
    change (f q) (x q) = (f q) (y q) at h
    exact hf q h
  have hcomp : Function.Injective ((Phi S).comp F) := (Phi_injective S).comp hF
  -- the rank of the product of free modules
  have hrank : Module.rank (PadicInt 2) ((q : ↥S) → (Fin (n (q :
      IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) → PadicInt 2))
      = ((∑ q : ↥S, n (q : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K)) : ℕ) : Cardinal) := by
    rw [← Module.finrank_eq_rank, Module.finrank_pi_fintype, Nat.cast_sum, Nat.cast_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [Module.finrank_pi, Fintype.card_fin]
  -- the sum of the local degrees is the global degree
  have hsum : (∑ q : ↥S, n (q : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K))) = Module.finrank ℚ K := by
    rw [Finset.univ_eq_attach, Finset.sum_attach]
    rw [hS, twoPlaces]
    rw [Finset.sum_image]
    · have hcongr : (∑ x : ↥((Ideal.span {((2 : ℕ) : ℤ)}).primesOver
            (NumberField.RingOfIntegers K)), n (NK.RankTheoryDeep.primeOfOver K x))
          = ∑ x : ↥((Ideal.span {((2 : ℕ) : ℤ)}).primesOver (NumberField.RingOfIntegers K)),
            (x : Ideal (NumberField.RingOfIntegers K)).ramificationIdx ℤ
              * (x : Ideal (NumberField.RingOfIntegers K)).inertiaDeg ℤ := by
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [hn]
        rfl
      rw [hcongr, NK.RankTheoryDeep.sum_localDeg_eq_finrank (K := K) (ℓ := 2)]
    · intro a _ b _ hab
      exact Subtype.ext (congrArg
        (fun x : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) => x.asIdeal)
        hab)
  calc (Module.finrank ℚ K : Cardinal)
      = ((∑ q : ↥S, n (q : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K)) : ℕ) : Cardinal) := by rw [hsum]
    _ = Module.rank (PadicInt 2) ((q : ↥S) → (Fin (n (q :
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) →
            PadicInt 2)) := hrank.symm
    _ ≤ Module.rank (PadicInt 2) (NK.Reconstruct.Dual (↥(Idele.integralIdeles K)) 2) :=
        LinearMap.rank_le_of_injective _ hcomp

/-! ## Part 5: the assembly -/

/-- **The idèle-side lower half of CoNF (10.3.20)**, from the local unit structure at the places
above `2`.

`rank Hom_cts(𝕀_int, ℤ_2) = [K : ℚ]` (Part 4 and the upper bound `rank_dual_integralIdeles_le`);
`restrictUnits` cuts it down by at most the rank `r_1 + r_2 - 1` of the global units (Part 2), and
what survives embeds in `Hom_cts(C_K, ℤ_2)` by the extension of characters (Part 3).  Since
`[K : ℚ] - (r_1 + r_2 - 1) = r_ℂ(K) + 1`, the statement follows. -/
theorem ideleDualRank_finrank_lowerBound_of_localUnits (K : Type) [Field K] [NumberField K]
    (hloc : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      q.asIdeal.LiesOver (Ideal.span {(2 : ℤ)}) →
      (((q.asIdeal.ramificationIdx ℤ * q.asIdeal.inertiaDeg ℤ : ℕ)) : Cardinal) ≤
        Module.rank (PadicInt 2) (NK.Reconstruct.Dual
          (↥(NK.GlobalCFT.Place.localUnits K (NK.GlobalCFT.Place.ofFinite q))) 2)) :
    NK.Reconstruct.rComplex K + 1 ≤ Module.finrank (PadicInt 2)
      (NK.Reconstruct.Dual (NK.GlobalCFT.IdeleClassGroup K) 2) := by
  classical
  -- the rank of the character module of the integral idèles is exactly `[K : ℚ]`
  have hVle : Module.rank (PadicInt 2) (NK.Reconstruct.Dual
      (↥(Idele.integralIdeles K)) 2) ≤ (Module.finrank ℚ K : Cardinal) :=
    NK.RankTheoryDeep.rank_dual_integralIdeles_le K NK.NUV2.localUnits_two
  have hVge := rank_dual_integralIdeles_lowerBound K hloc
  have hVeq : Module.rank (PadicInt 2) (NK.Reconstruct.Dual
      (↥(Idele.integralIdeles K)) 2) = (Module.finrank ℚ K : Cardinal) :=
    le_antisymm hVle hVge
  have hVlt : Module.rank (PadicInt 2) (NK.Reconstruct.Dual
      (↥(Idele.integralIdeles K)) 2) < Cardinal.aleph0 :=
    lt_of_le_of_lt hVle (by exact_mod_cast Cardinal.natCast_lt_aleph0)
  have hVnat : Cardinal.toNat (Module.rank (PadicInt 2) (NK.Reconstruct.Dual
      (↥(Idele.integralIdeles K)) 2)) = Module.finrank ℚ K := by
    rw [hVeq, Cardinal.toNat_natCast]
  -- rank-nullity for `restrictUnits`
  have hkerlt : Module.rank (PadicInt 2) (restrictUnits (K := K)).ker < Cardinal.aleph0 :=
    lt_of_le_of_lt (Submodule.rank_le _) hVlt
  have hrglt : Module.rank (PadicInt 2) (restrictUnits (K := K)).range < Cardinal.aleph0 :=
    lt_of_le_of_lt (le_trans (Submodule.rank_le _) (rank_addMonoidHom_units_le K))
      (by exact_mod_cast Cardinal.natCast_lt_aleph0)
  have hnat : Module.finrank ℚ K
      = Cardinal.toNat (Module.rank (PadicInt 2) (restrictUnits (K := K)).range)
        + Cardinal.toNat (Module.rank (PadicInt 2) (restrictUnits (K := K)).ker) := by
    rw [← hVnat, ← Cardinal.toNat_add hrglt hkerlt,
      ← LinearMap.rank_range_add_rank_ker (restrictUnits (K := K))]
  -- the range is at most the character module of the global units
  have hble : Cardinal.toNat (Module.rank (PadicInt 2) (restrictUnits (K := K)).range)
      ≤ NumberField.Units.rank K := by
    have h1 : Module.rank (PadicInt 2) (restrictUnits (K := K)).range
        ≤ (NumberField.Units.rank K : Cardinal) :=
      le_trans (Submodule.rank_le _) (rank_addMonoidHom_units_le K)
    have := Cardinal.toNat_le_toNat h1 (Cardinal.natCast_lt_aleph0)
    rwa [Cardinal.toNat_natCast] at this
  -- the kernel embeds in the character module of the class group
  have hker_le : Module.rank (PadicInt 2) (restrictUnits (K := K)).ker
      ≤ Module.rank (PadicInt 2)
          (NK.Reconstruct.Dual (NK.GlobalCFT.IdeleClassGroup K) 2) :=
    rank_ker_restrictUnits_le_rank_dual_classGroup K
  have hClt : Module.rank (PadicInt 2) (NK.Reconstruct.Dual
      (NK.GlobalCFT.IdeleClassGroup K) 2) < Cardinal.aleph0 :=
    lt_of_le_of_lt (NK.RankTheoryDeep.rank_dual_ideleClassGroup_le_integralIdeles K) hVlt
  have ha_le : Cardinal.toNat (Module.rank (PadicInt 2) (restrictUnits (K := K)).ker)
      ≤ Cardinal.toNat (Module.rank (PadicInt 2)
          (NK.Reconstruct.Dual (NK.GlobalCFT.IdeleClassGroup K) 2)) :=
    Cardinal.toNat_le_toNat hker_le hClt
  -- the arithmetic
  have harith : NK.Reconstruct.rComplex K + 1
      ≤ Module.finrank ℚ K - NumberField.Units.rank K := by
    have h := finrank_eq_unitsRank_add K
    omega
  show NK.Reconstruct.rComplex K + 1 ≤ Cardinal.toNat (Module.rank (PadicInt 2)
      (NK.Reconstruct.Dual (NK.GlobalCFT.IdeleClassGroup K) 2))
  omega

/-! ## Part 6: the unconditional statement, from the local unit structure at `2` -/

/-- **The idèle-side lower half of CoNF (10.3.20)** for the prime `2`.

The local unit structure at the places above `2` (`NK.NUV2.localUnitDualRank_lowerBound`)
supplies the input of `ideleDualRank_finrank_lowerBound_of_localUnits`. -/
theorem ideleDualRank_finrank_lowerBound (K : Type) [Field K] [NumberField K] :
    NK.Reconstruct.rComplex K + 1
      ≤ Module.finrank (PadicInt 2)
          (NK.Reconstruct.Dual (NK.GlobalCFT.IdeleClassGroup K) 2) :=
  ideleDualRank_finrank_lowerBound_of_localUnits K
    (fun q hq => NK.NUV2.localUnitDualRank_lowerBound K q hq)

end Extension

end

end NK.NUV2
