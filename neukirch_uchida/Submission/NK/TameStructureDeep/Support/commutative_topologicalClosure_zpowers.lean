import Mathlib
import Submission.NK.TameStructureDeep.Defs

set_option linter.style.haveILetI false

namespace NK.TameStructureDeep.Support

/-- The topological closure of the cyclic subgroup generated by `x` is commutative: it is the
topological closure of a commutative subgroup of a Hausdorff topological group. -/
theorem commutative_topologicalClosure_zpowers {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] (x : G) {a b : G}
    (ha : a ∈ (Subgroup.zpowers x).topologicalClosure)
    (hb : b ∈ (Subgroup.zpowers x).topologicalClosure) : a * b = b * a := by
  have hcomm : ∀ y z : Subgroup.zpowers x, y * z = z * y := by
    intro y z
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp y.2
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp z.2
    apply Subtype.ext
    show ((y : G) * (z : G)) = ((z : G) * (y : G))
    rw [← hm, ← hn, ← zpow_add, ← zpow_add, add_comm]
  letI : CommGroup (Subgroup.zpowers x).topologicalClosure :=
    Subgroup.commGroupTopologicalClosure _ hcomm
  exact congrArg Subtype.val
    (mul_comm (⟨a, ha⟩ : (Subgroup.zpowers x).topologicalClosure) ⟨b, hb⟩)

end NK.TameStructureDeep.Support
