# A closed subgroup of `Ẑ` surjecting onto every finite quotient is everything

Let `Ẑ = NK.LocalAnabelian.Zhat` be the profinite completion of `ℤ`, with its canonical
components `compHomZMod d hd : Ẑ →* Multiplicative (ZMod d)` (`zhatComponents.lean`).
The theorem proved here is

  `zhat_eq_top_of_isClosed_of_compHomZMod_image_eq_univ`:
  a **closed** subgroup `H ≤ Ẑ` whose image under *every* component map
  `compHomZMod d hd` (`d ≠ 0`) is all of `ZMod d` must be `Ẑ` itself.

This is the group-theoretic input of the "degree" bookkeeping in the local anabelian
reconstruction: the closed subgroups of `Ẑ` are the groups `Ẑ ^ n`, and `Ẑ ^ n` surjects onto
`ℤ ⧸ dℤ` only for `n` coprime to `d`; so a subgroup surjecting onto all of them is `Ẑ`.

## The mathematics

1. `Ẑ ^ d = NK.TowerRank.powSubgroup d` is the subgroup of `d`-th powers, and
   `Ẑ ⧸ Ẑ ^ d` is generated by the class `g` of the canonical generator
   (`NK.TowerRank.closure_zpowers_mk_powSubgroup`); since `g ^ d = 1`, it is closed (finite),
   hence `zpowers g = ⊤`.
2. Consequently the component map `compHomZMod d hd` factors through `Ẑ ⧸ Ẑ ^ d`
   (`compHomZModLift`) and the factorisation is **injective**: on `g ^ k` it takes the value
   `(ofAdd 1) ^ k`, which is trivial iff `d ∣ k`, and then `g ^ k = (g ^ d) ^ · = 1`.  Hence
   `ker (compHomZMod d hd) = Ẑ ^ d` (`ker_compHomZMod_eq_powSubgroup`).
3. Therefore the hypothesis that `H` surjects onto `ZMod d` says exactly that
   `H ⊔ Ẑ ^ d = ⊤` (`hsup`).
4. If `N ≥ H` is an open subgroup of `Ẑ` of index `d`, then `N` is normal (`Ẑ` is commutative),
   `Ẑ ⧸ N` has order `d`, so `x ^ d ∈ N` for all `x`, i.e. `Ẑ ^ d ≤ N`; with `H ≤ N` and
   `H ⊔ Ẑ ^ d = ⊤` this forces `N = ⊤`.
5. A closed subgroup of a profinite group is the intersection of the open subgroups containing
   it (`ProfiniteGrp.closedSubgroup_eq_sInf_open`); the previous point makes that intersection
   `⊤`, so `H = ⊤`.
-/
import Mathlib
import Submission.NK.TameStructureDeep.Degree.zhatComponents
import Submission.NK.TowerRank.isProCyclic_zhat

open scoped Classical

set_option linter.style.haveILetI false

namespace NK.TameStructureDeep.Degree

noncomputable section

/-- The `d`-th component of the canonical topological generator of `Ẑ` is the class of `1`. -/
theorem compHomZMod_zhatGen (d : ℕ) (hd : d ≠ 0) :
    compHomZMod d hd NK.TowerRank.zhatGen = Multiplicative.ofAdd (1 : ZMod d) := by
  rw [NK.TowerRank.zhatGen, NK.TowerRank.zEta, compHomZMod_apply,
    NK.TameStructure.ProCyclic.compHom_eta]
  show (zmodQuotEquiv d hd)
      (QuotientGroup.mk' (NK.TameStructure.ProCyclic.mZ d hd).toSubgroup (Multiplicative.ofAdd 1))
    = Multiplicative.ofAdd (1 : ZMod d)
  rw [zmodQuotEquiv_mk, toZModHom_apply, Int.cast_one]

/-- The image of `Ẑ ^ d` under the `d`-th component map is trivial. -/
theorem powSubgroup_le_ker_compHomZMod (d : ℕ) (hd : d ≠ 0) :
    NK.TowerRank.powSubgroup d ≤ (compHomZMod d hd).ker := by
  haveI : NeZero d := ⟨hd⟩
  intro x hx
  rw [MonoidHom.mem_ker]
  have hx' : x ∈ (NK.TowerRank.powSubgroup d : Set NK.LocalAnabelian.Zhat) := hx
  rw [NK.TowerRank.coe_powSubgroup] at hx'
  obtain ⟨y, rfl⟩ := hx'
  rw [map_pow]
  have hcard : Nat.card (Multiplicative (ZMod d)) = d := by
    rw [Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card]
  have hdvd : orderOf ((compHomZMod d hd) y) ∣ Nat.card (Multiplicative (ZMod d)) :=
    orderOf_dvd_natCard _
  rw [hcard] at hdvd
  exact orderOf_dvd_iff_pow_eq_one.mp hdvd

/-- The `d`-th component map, factored through the quotient `Ẑ ⧸ Ẑ ^ d`. -/
def compHomZModLift (d : ℕ) (hd : d ≠ 0) :
    NK.LocalAnabelian.Zhat ⧸ NK.TowerRank.powSubgroup d →* Multiplicative (ZMod d) :=
  QuotientGroup.lift (NK.TowerRank.powSubgroup d) (compHomZMod d hd)
    (powSubgroup_le_ker_compHomZMod d hd)

/-- The defining property of `compHomZModLift`. -/
theorem compHomZModLift_mk (d : ℕ) (hd : d ≠ 0) (z : NK.LocalAnabelian.Zhat) :
    compHomZModLift d hd (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) z) =
      compHomZMod d hd z :=
  QuotientGroup.lift_mk' _ _ z

/-- **`compHomZModLift` is injective**: the kernel of the `d`-th component map is `Ẑ ^ d`, i.e.
an element of `Ẑ` whose `d`-th component is `1` is a `d`-th power. -/
theorem compHomZModLift_injective (d : ℕ) (hd : d ≠ 0) :
    Function.Injective (compHomZModLift d hd) := by
  haveI : NeZero d := ⟨hd⟩
  haveI : T1Space (NK.LocalAnabelian.Zhat ⧸ NK.TowerRank.powSubgroup d) :=
    QuotientGroup.t1Space_iff.mpr (NK.TowerRank.isClosed_powSubgroup d)
  have hgpow :
      (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) NK.TowerRank.zhatGen) ^ d = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff (NK.TowerRank.zhatGen ^ d)).mpr (by
      show NK.TowerRank.zhatGen ^ d ∈ (NK.TowerRank.powSubgroup d : Set NK.LocalAnabelian.Zhat)
      rw [NK.TowerRank.coe_powSubgroup]
      exact ⟨NK.TowerRank.zhatGen, rfl⟩)
  -- the class of the canonical generator generates `Ẑ ⧸ Ẑ ^ d`
  have hzp : Subgroup.zpowers
      (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) NK.TowerRank.zhatGen) = ⊤ := by
    have hcl := NK.TowerRank.closure_zpowers_mk_powSubgroup d
    have hfin : (Subgroup.zpowers
        (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) NK.TowerRank.zhatGen) :
        Set (NK.LocalAnabelian.Zhat ⧸ NK.TowerRank.powSubgroup d)).Finite := by
      refine IsOfFinOrder.finite_zpowers ?_
      exact isOfFinOrder_iff_pow_eq_one.mpr ⟨d, Nat.pos_of_ne_zero hd, hgpow⟩
    apply SetLike.coe_injective
    rw [Subgroup.coe_top, ← hfin.isClosed.closure_eq]
    exact hcl
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro q hq
  rw [MonoidHom.mem_ker] at hq
  have hqmem : q ∈ Subgroup.zpowers
      (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) NK.TowerRank.zhatGen) := by
    rw [hzp]; trivial
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hqmem
  rw [← hk] at hq
  rw [Subgroup.mem_bot, ← hk]
  -- on the generator, the component map is `k ↦ (ofAdd 1) ^ k = ofAdd k`
  have h1 : (k : ZMod d) = 0 := by
    rw [map_zpow, compHomZModLift_mk, compHomZMod_zhatGen] at hq
    rw [← ofAdd_zsmul] at hq
    rw [show (1 : Multiplicative (ZMod d)) = Multiplicative.ofAdd (0 : ZMod d) from rfl] at hq
    rw [Multiplicative.ofAdd.injective.eq_iff, zsmul_eq_mul, mul_one] at hq
    exact hq
  -- hence `d ∣ k` and `g ^ k = (g ^ d) ^ · = 1`
  obtain ⟨m, hm⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd k d).mp h1
  rw [hm, zpow_mul, zpow_natCast, hgpow, one_zpow]

/-- **The kernel of the `d`-th component map is `Ẑ ^ d`.** -/
theorem ker_compHomZMod_eq_powSubgroup (d : ℕ) (hd : d ≠ 0) :
    (compHomZMod d hd).ker = NK.TowerRank.powSubgroup d := by
  refine le_antisymm ?_ (powSubgroup_le_ker_compHomZMod d hd)
  intro x hx
  have hx1 : compHomZModLift d hd (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) x) = 1 := by
    rw [compHomZModLift_mk, MonoidHom.mem_ker.mp hx]
  have hq : QuotientGroup.mk' (NK.TowerRank.powSubgroup d) x = 1 :=
    compHomZModLift_injective d hd (by rw [hx1, map_one])
  exact (QuotientGroup.eq_one_iff x).mp hq

/-- **A closed subgroup of `Ẑ` whose image under every component map `compHomZMod d hd`
(`d ≠ 0`) is everything is `Ẑ` itself.** -/
theorem zhat_eq_top_of_isClosed_of_compHomZMod_image_eq_univ
    (H : Subgroup NK.LocalAnabelian.Zhat)
    (hclosed : IsClosed (H : Set NK.LocalAnabelian.Zhat))
    (h : ∀ (d : ℕ) (hd : d ≠ 0),
      (NK.TameStructureDeep.Degree.compHomZMod d hd) '' (H : Set NK.LocalAnabelian.Zhat) = Set.univ) :
    H = ⊤ := by
  haveI hHn : H.Normal := Subgroup.normal_of_isMulCommutative H
  -- Step 1: `H` surjects onto `Ẑ ⧸ Ẑ ^ d` for every `d ≥ 1`, i.e. `H ⊔ Ẑ ^ d = ⊤`.
  have hsup : ∀ (d : ℕ) (hd : d ≠ 0),
      H ⊔ NK.TowerRank.powSubgroup d = ⊤ := by
    intro d hd
    have himg : ∀ q : NK.LocalAnabelian.Zhat ⧸ NK.TowerRank.powSubgroup d,
        ∃ h' ∈ H, QuotientGroup.mk' (NK.TowerRank.powSubgroup d) h' = q := by
      intro q
      have hq : compHomZModLift d hd q ∈
          (compHomZMod d hd) '' (H : Set NK.LocalAnabelian.Zhat) := by
        rw [h d hd]
        trivial
      obtain ⟨h', hh', hh'q⟩ := hq
      exact ⟨h', hh', compHomZModLift_injective d hd (by rw [compHomZModLift_mk, hh'q])⟩
    rw [eq_top_iff]
    intro z _
    obtain ⟨h', hh', hh'z⟩ := himg (QuotientGroup.mk' (NK.TowerRank.powSubgroup d) z)
    have hmem : h'⁻¹ * z ∈ NK.TowerRank.powSubgroup d := (QuotientGroup.eq).mp hh'z
    have hmul : h' * (h'⁻¹ * z) ∈ H ⊔ NK.TowerRank.powSubgroup d :=
      (Subgroup.mem_sup_of_normal_left).mpr ⟨h', hh', h'⁻¹ * z, hmem, rfl⟩
    rwa [mul_inv_cancel_left] at hmul
  -- Step 2: an open subgroup of `Ẑ` containing `H` is everything.
  have hNtop : ∀ N : Subgroup NK.LocalAnabelian.Zhat,
      IsOpen (N : Set NK.LocalAnabelian.Zhat) → H ≤ N → N = ⊤ := by
    intro N hNopen hHN
    haveI hNn : N.Normal := Subgroup.normal_of_isMulCommutative N
    haveI : Finite (NK.LocalAnabelian.Zhat ⧸ N) := Subgroup.quotient_finite_of_isOpen N hNopen
    haveI : N.FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
    have hdne : N.index ≠ 0 := Subgroup.index_ne_zero_of_finite
    have hPle : NK.TowerRank.powSubgroup N.index ≤ N := by
      intro x hx
      have hx' : x ∈ (NK.TowerRank.powSubgroup N.index : Set NK.LocalAnabelian.Zhat) := hx
      rw [NK.TowerRank.coe_powSubgroup] at hx'
      obtain ⟨y, rfl⟩ := hx'
      have hcard : Nat.card (NK.LocalAnabelian.Zhat ⧸ N) = N.index :=
        (Subgroup.index_eq_card N).symm
      have hord : orderOf (QuotientGroup.mk' N y) ∣ N.index := by
        rw [← hcard]
        exact orderOf_dvd_natCard _
      have hpow : (QuotientGroup.mk' N y) ^ N.index = 1 := orderOf_dvd_iff_pow_eq_one.mp hord
      have h2 : QuotientGroup.mk' N (y ^ N.index) = 1 := by rw [map_pow, hpow]
      exact (QuotientGroup.eq_one_iff (y ^ N.index)).mp h2
    rw [eq_top_iff, ← hsup N.index hdne]
    exact sup_le hHN hPle
  -- Step 3: a closed subgroup is the intersection of the open subgroups containing it.
  refine le_antisymm le_top ?_
  intro x _
  have hmem : x ∈ H := by
    change x ∈ (⟨H, hclosed⟩ : ClosedSubgroup NK.LocalAnabelian.Zhat).toSubgroup
    rw [ProfiniteGrp.closedSubgroup_eq_sInf_open
      (⟨H, hclosed⟩ : ClosedSubgroup NK.LocalAnabelian.Zhat)]
    exact Subgroup.mem_sInf.mpr fun N hN => by rw [hNtop N hN.1 hN.2]; trivial
  exact hmem

end

end NK.TameStructureDeep.Degree
