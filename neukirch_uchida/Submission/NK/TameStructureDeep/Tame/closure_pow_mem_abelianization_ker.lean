import Mathlib
import Submission.NK.TameStructureDeep.Tame.isTameFrobeniusLift_correctedWildInertia
import Submission.NK.TameStructureDeep.Tame.wildInertiaSubgroup_eq_correctedWildInertia

/-!
# `q - 1`-st powers of the inertia die in the abelianised tame quotient

For a number field `K`, a finite place `𝔭`, `κ = K_𝔭`, a separable closure `K'` of `κ`,
`p = resCharAt 𝔭` the residue characteristic and `q = residueCard K 𝔭` the residue field order,
this file proves

`closure_pow_mem_abelianization_ker`: the subgroup of `G_κ = Gal(K'/κ)` generated by the
`(q - 1)`-st powers of the inertia subgroup `I_κ` lies in the kernel of

`G_κ ⟶ G_κ/V_κ ⟶ (G_κ/V_κ)^{ab}`,

where `V_κ = wildInertiaSubgroup p` is the wild inertia.

The mathematical content is the Frobenius normalisation, in the form supplied by
`Tame.isTameFrobeniusLift_correctedWildInertia` and `Tame.wildInertiaSubgroup_eq_correctedWildInertia`:
a Frobenius element `F` for the residue cardinality `q` satisfies

`F y F⁻¹ ≡ y ^ q  (mod V_κ)`   for every `y ∈ I_κ`.

The group-theoretic consequence (`pow_sub_one_mem_ker_abelianization_quotient`, proved here in the
abstract) is that `y ^ (q - 1) ≡ [F, y] (mod V_κ)`; commutators become trivial in the
abelianisation of `G_κ/V_κ`, so `y ^ (q - 1)` lies in the kernel.  Equivalently: the tame inertia
of the abelianised tame quotient is `(q - 1)`-torsion.
-/

namespace NK.TameStructureDeep.Tame

/-! ## The group-theoretic core -/

/-- **A Frobenius lift kills `(q - 1)`-st powers of the inertia in the abelianised quotient.**

Let `V ◁ G` be a normal subgroup (the wild inertia) and `I ≤ G` a subgroup (the inertia).  If
`F ∈ G` satisfies the Frobenius normalisation modulo `V`, `F y F⁻¹ (y ^ q)⁻¹ ∈ V` for every
`y ∈ I`, then for every `x ∈ I` the element `x ^ (q - 1)` lies in the kernel of the composite
`G → G ⧸ V → (G ⧸ V)^ab`.

Indeed, modulo `V` the Frobenius relation reads `F x F⁻¹ = x ^ q`, i.e. the commutator `[F, x]` is
`x ^ (q - 1)`; and the kernel of `G ⧸ V → (G ⧸ V)^ab` is the subgroup generated by commutators of
`G ⧸ V`. -/
theorem pow_sub_one_mem_ker_abelianization_quotient {G : Type*} [Group G] {V I : Subgroup G}
    [V.Normal] {q : ℕ} {F : G} (h : ∀ y ∈ I, F * y * F⁻¹ * (y ^ q)⁻¹ ∈ V) {x : G}
    (hx : x ∈ I) :
    x ^ (q - 1) ∈ (Abelianization.of.comp (QuotientGroup.mk' V)).ker := by
  set φ : G →* Abelianization (G ⧸ V) := Abelianization.of.comp (QuotientGroup.mk' V) with hφdef
  rw [MonoidHom.mem_ker]
  -- the image of `F x F⁻¹ (x ^ q)⁻¹` is `1`, since that element lies in `V`
  have h0 : φ x ^ q = φ x := by
    have hmem : F * x * F⁻¹ * (x ^ q)⁻¹ ∈ V := h x hx
    have hzf : φ (F * x * F⁻¹ * (x ^ q)⁻¹) = 1 := by
      rw [hφdef, MonoidHom.comp_apply]
      have hq1 : QuotientGroup.mk' V (F * x * F⁻¹ * (x ^ q)⁻¹) = 1 := by
        rw [QuotientGroup.mk'_apply]
        exact (QuotientGroup.eq_one_iff _).mpr hmem
      rw [hq1, map_one]
    simp only [map_mul, map_inv, map_pow] at hzf
    -- in the abelian group `(G ⧸ V)^ab` the outer conjugating factor drops out
    have hca : φ F * φ x * (φ F)⁻¹ = φ x := by
      rw [mul_comm (φ F) (φ x), mul_assoc, mul_inv_cancel, mul_one]
    rw [hca] at hzf
    exact (mul_inv_eq_one.mp hzf).symm
  -- hence `(φ x) ^ (q - 1) = 1`
  rcases Nat.eq_zero_or_pos q with hq | hq
  · subst hq
    simp
  · have hsub : q - 1 + 1 = q := Nat.sub_add_cancel hq
    have h4 : φ x ^ (q - 1) * φ x = 1 * φ x := by
      rw [← pow_succ, hsub, h0, one_mul]
    have h5 : φ x ^ (q - 1) = 1 := mul_right_cancel h4
    rwa [map_pow]

/-! ## The arithmetic instance -/

theorem closure_pow_mem_abelianization_ker (K : Type*) [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']
    {π : 𝔭.adicCompletionIntegers K} (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π)
    {F : Gal(K'/(𝔭.adicCompletion K))}
    (hF : NK.LocalAnabelian.IsFrobeniusFor (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭) (NK.LocalStructure.residueCard K 𝔭) F) :
    Subgroup.closure (Set.range fun x : ↥(NK.LocalAnabelian.inertiaSubgroup
        (κ := 𝔭.adicCompletion K) (K' := K') (NK.TameStructureDeep.Tame.resCharAt 𝔭)) =>
        (x : Gal(K'/(𝔭.adicCompletion K))) ^ (NK.LocalStructure.residueCard K 𝔭 - 1)) ≤
      (Abelianization.of.comp (QuotientGroup.mk' (NK.LocalTame.wildInertiaSubgroup
        (κ := 𝔭.adicCompletion K) (K' := K') (NK.TameStructureDeep.Tame.resCharAt 𝔭)))).ker := by
  rw [Subgroup.closure_le]
  rintro _ ⟨x, rfl⟩
  -- the Frobenius normalisation modulo the wild inertia
  have hlift := NK.TameStructureDeep.Tame.isTameFrobeniusLift_correctedWildInertia
    (κ := 𝔭.adicCompletion K) (K' := K')
    (NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭).ne_one
    (NK.TameStructureDeep.Tame.uniformizer_ne_zero 𝔭 hπ) hF
  have hV : ∀ y ∈ NK.LocalAnabelian.inertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭),
      F * y * F⁻¹ * (y ^ NK.LocalStructure.residueCard K 𝔭)⁻¹ ∈
        NK.LocalTame.wildInertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
          (NK.TameStructureDeep.Tame.resCharAt 𝔭) := by
    intro y hy
    have hh := hlift.2 y hy
    rw [← NK.TameStructureDeep.Tame.wildInertiaSubgroup_eq_correctedWildInertia 𝔭 hπ] at hh
    exact hh
  exact NK.TameStructureDeep.Tame.pow_sub_one_mem_ker_abelianization_quotient hV x.2

end NK.TameStructureDeep.Tame
