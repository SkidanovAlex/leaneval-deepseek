# The Kummer pairing of `κ^{ur}(π^{1/ℓ})` over the unramified closure is surjective

Let `κ` be a field, `K'` a separable closure of `κ`, `p` and `ℓ` primes with `p ∤ ℓ`, `a ∈ κ` and
`β ∈ K'` with `β ^ ℓ = a`.  Write `κ^{ur} = unramifiedClosure p = κ(μ_{p'}) ⊆ K'`.  If `β` has no
conjugate in `κ^{ur}`, i.e. `x ^ ℓ ≠ a` for every `x ∈ κ^{ur}` (the Kummer input
`UnramifiedNoPow` in the case `a = π` a uniformiser), then `β ∉ κ^{ur}`.

The main result here is the *surjectivity of the Kummer pairing* on the group side:

  for every `ℓ`-th root of unity `ζ ∈ K'`, there is `σ ∈ Gal(K'/κ)` fixing `κ^{ur}` pointwise
  (`σ ∈ (κ^{ur}).fixingSubgroup`, i.e. `σ ∈ Gal(K'/κ^{ur})`) with `σ β = ζ β`.

Equivalently, the homomorphism `Gal(K'/κ^{ur}) →* μ_ℓ`, `σ ↦ σ β / β`, is surjective.

Everything is elementary Galois theory: `μ_ℓ ⊆ κ^{ur}` because `ℓ ≠ p`, `β ∉ κ^{ur}` because
`κ^{ur} ⊆ K'` is the fixed field of the fixing subgroup (`fixedField_fixingSubgroup`), whence
`σ ↦ σβ/β` is a non-trivial homomorphism `Gal(K'/κ^{ur}) →* μ_ℓ`; and `μ_ℓ` is generated by any
of its non-trivial elements, because in a field the `ℓ`-th roots of unity are the roots of the
degree-`ℓ` polynomial `X ^ ℓ - 1`, so `μ_ℓ` has exactly `ℓ` elements.

This is the group-theoretic half of the Kummer isomorphism
`Gal(κ^{ur}(π^{1/ℓ})/κ^{ur}) ≅ μ_ℓ` used in the tamely ramified structure theorem
`Gal(κ^{tr}/κ^{ur}) ≅ ∏_{ℓ ≠ p} ℤ_ℓ`.
-/
import Mathlib
import Submission.NK.TameStructureDeep.Tame.Defs
import Submission.NK.TameStructureDeep.Tame.Kummer
import Submission.NK.LocalAnabelian.ResidueField.inertiaSubgroup_eq_fixingSubgroup_unramifiedClosure

namespace NK.TameStructureDeep.Tame

set_option linter.unusedVariables false

open scoped Classical

/-! ## Two elementary lemmas on roots of unity in a field -/

/-- An `n`-th root of unity different from `1`, with `n` prime, is a *primitive* `n`-th root of
unity: its multiplicative order divides the prime `n` and is not `1`. -/
lemma isPrimitiveRoot_of_pow_eq_one_of_prime {M : Type*} [CommMonoid M] {n : ℕ} (hn : n.Prime)
    {ϑ : M} (hϑ : ϑ ^ n = 1) (h1 : ϑ ≠ 1) : IsPrimitiveRoot ϑ n := by
  rw [IsPrimitiveRoot.iff_orderOf]
  rcases hn.eq_one_or_self_of_dvd (orderOf ϑ) (orderOf_dvd_of_pow_eq_one hϑ) with h | h
  · exact absurd (orderOf_eq_one_iff.mp h) h1
  · exact h

/-- **Two non-trivial `ℓ`-th roots of unity in a field are powers of one another**, `ℓ` prime.

If `z ^ ℓ = 1`, `z ≠ 1` and `w ^ ℓ = 1`, then `w = z ^ k` for some `k ∈ ℕ`.  Indeed `z` is a
primitive `ℓ`-th root of unity, whence `X ^ ℓ - 1 = ∏_{i < ℓ} (X - z ^ i)`; evaluating at `w`
exhibits `w` as one of the powers `z ^ i`.  (This is the cyclicity of `μ_ℓ`, and it is where the
hypothesis that the ambient ring is a *field* is used.) -/
lemma exists_pow_eq_of_pow_eq_one_of_prime {K : Type*} [Field K] {ℓ : ℕ} (hℓ : ℓ.Prime)
    {z w : K} (hz : z ^ ℓ = 1) (hz1 : z ≠ 1) (hw : w ^ ℓ = 1) : ∃ k : ℕ, w = z ^ k := by
  have hzp : IsPrimitiveRoot z ℓ := isPrimitiveRoot_of_pow_eq_one_of_prime hℓ hz hz1
  have hfac := X_pow_sub_C_eq_prod hzp (α := (1 : K)) (a := (1 : K)) hℓ.pos (by simp)
  have h := congrArg (Polynomial.eval w) hfac
  simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
    Polynomial.eval_prod, hw, mul_one] at h
  rw [sub_self] at h
  obtain ⟨i, -, hi⟩ := Finset.prod_eq_zero_iff.mp h.symm
  exact ⟨i, sub_eq_zero.mp hi⟩

/-! ## Surjectivity of the Kummer pairing over the unramified closure -/

theorem exists_smul_root_of_notMem_unramifiedClosure {κ K' : Type*} [Field κ] [Field K'] [Algebra κ K']
    [IsSepClosure κ K'] {p ℓ : ℕ} (hp : p.Prime) (hℓ : ℓ.Prime) (hpℓ : ¬ p ∣ ℓ) {a : κ} {β : K'}
    (hβ : β ^ ℓ = algebraMap κ K' a)
    (hirr : ∀ x : K', x ∈ NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p →
      x ^ ℓ ≠ algebraMap κ K' a)
    {ζ : K'} (hζ : ζ ^ ℓ = 1) :
    ∃ σ : Gal(K'/κ),
      σ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup ∧
        σ β = ζ * β := by
  classical
  set L : IntermediateField κ K' := NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p with hL
  -- `β ≠ 0`, since `β = 0` would force `a = 0` and contradict the Kummer input at `x = 0`
  have hβne : β ≠ 0 := by
    intro hb
    refine hirr 0 L.zero_mem ?_
    rw [← hβ, hb, zero_pow hℓ.ne_zero]
  -- every `ℓ`-th root of unity lies in `κ^{ur} = κ(μ_{p'})`, because `ℓ ≠ p`
  have hmu : ∀ ϑ : K', ϑ ^ ℓ = 1 → ϑ ∈ L := by
    intro ϑ hϑ
    rw [hL]
    rcases eq_or_ne ϑ 1 with h1 | h1
    · rw [h1]; exact IntermediateField.one_mem _
    · exact NK.TameStructureDeep.mem_unramifiedClosure_of_isPrimitiveRoot (p := p) hpℓ
        (isPrimitiveRoot_of_pow_eq_one_of_prime hℓ hϑ h1)
  -- `κ^{ur}` is the fixed field of its fixing subgroup, so `β ∉ κ^{ur}` gives a fixing
  -- automorphism moving `β`
  obtain ⟨σ₀, hσ₀mem, hσ₀β⟩ : ∃ σ : Gal(K'/κ), σ ∈ L.fixingSubgroup ∧ σ β ≠ β := by
    by_contra h
    refine hirr β ?_ hβ
    rw [← InfiniteGalois.fixedField_fixingSubgroup (k := κ) (K := K') L,
      IntermediateField.mem_fixedField_iff]
    intro f hf
    by_contra hfb
    exact h ⟨f, hf, hfb⟩
  set z : K' := σ₀ β / β with hzdef
  -- `σ₀` fixes `κ^{ur} ∋ a`
  have hfixa : σ₀ (algebraMap κ K' a) = algebraMap κ K' a :=
    (IntermediateField.mem_fixingSubgroup_iff L σ₀).mp hσ₀mem _ (IntermediateField.algebraMap_mem L a)
  have hσβeq : σ₀ β = z * β := by
    rw [hzdef, div_mul_cancel₀ _ hβne]
  -- the Kummer cocycle `z = σ₀ β / β` is an `ℓ`-th root of unity
  have hzpow : z ^ ℓ = 1 := by
    have h1 : (σ₀ β) ^ ℓ = β ^ ℓ := by rw [← map_pow, hβ, hfixa, ← hβ]
    rw [hzdef, div_pow, h1, div_self (pow_ne_zero ℓ hβne)]
  have hz1 : z ≠ 1 := by
    intro h
    refine hσ₀β ((div_eq_one_iff_eq hβne).mp ?_)
    rw [← hzdef]; exact h
  have hzL : z ∈ L := hmu z hzpow
  -- the action of the powers of `σ₀` on `β` is the `z`-power action
  have hpow : ∀ n : ℕ, (σ₀ ^ n) β = z ^ n * β := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      have hzn : σ₀ (z ^ n) = z ^ n :=
        (IntermediateField.mem_fixingSubgroup_iff L σ₀).mp hσ₀mem _
          (by simpa using IntermediateField.pow_mem L hzL (n : ℤ))
      calc (σ₀ ^ (n + 1)) β = σ₀ ((σ₀ ^ n) β) := by rw [pow_succ', AlgEquiv.mul_apply]
        _ = σ₀ (z ^ n * β) := by rw [ih]
        _ = σ₀ (z ^ n) * σ₀ β := by rw [map_mul]
        _ = z ^ n * (z * β) := by rw [hzn, hσβeq]
        _ = z ^ (n + 1) * β := by ring
  -- `μ_ℓ` is generated by `z`, so every `ℓ`-th root of unity is attained
  have key : ∃ σ : Gal(K'/κ), σ ∈ L.fixingSubgroup ∧ σ β = ζ * β := by
    rcases eq_or_ne ζ 1 with h1 | h1
    · exact ⟨1, Subgroup.one_mem _, by rw [h1, one_mul, AlgEquiv.one_apply]⟩
    · obtain ⟨k, hk⟩ := exists_pow_eq_of_pow_eq_one_of_prime hℓ hzpow hz1 hζ
      exact ⟨σ₀ ^ k, Subgroup.pow_mem L.fixingSubgroup hσ₀mem k, by rw [hpow k, hk]⟩
  obtain ⟨σ, hσmem, hσβ⟩ := key
  exact ⟨σ, hσmem, hσβ⟩

end NK.TameStructureDeep.Tame
