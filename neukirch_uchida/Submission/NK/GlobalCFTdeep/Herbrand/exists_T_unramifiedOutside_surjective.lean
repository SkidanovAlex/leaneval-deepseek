import Mathlib
import Submission.NK.GlobalCFTdeep.Shared

/-!
# A Galois-stable set of places whose `T`-idèles generate the idèle class group

Let `K ⊆ L` be a finite Galois extension of number fields.  This file constructs a finite set `S`
of places of `K`, containing all archimedean places and all the places below ramified primes of
`L`, with `T = {w : Place L | w lies over some v ∈ S}` Galois-stable, such that the `T`-idèles
together with the principal idèles generate all of `𝕀 L`:

`⊤ = Idele.principalSubgroup L ⊔ TIdeles T`.

Since `𝕀 L / (principal ⊔ TIdeles T)` is the quotient of the idèle class group by the classes
supported on `T`, the last statement says exactly that the ideal classes of `L` are generated by
the primes in `T` (equivalently, that the class group is captured by the `T`-idèles).

## Strategy

* `exists_finset_TIdeles_surjective` produces a finite set `T₁` of places of `L` whose `T₁`-idèles
  surject onto the class group of `𝓞 L`; equivalently, the primes in `T₁` generate the class group.
* `Commons.NumberTheory.NumberField.finite_setOf_ramificationIdx_ne_one` says that only finitely
  many primes of `𝓞 L` ramify over `K`.
* `S` is the union of the places of `K` below the places of `T₁` and below the ramified primes,
  together with all archimedean places of `K`.  Then `T ⊇ T₁`, `T` is Galois-stable (the action
  preserves "lies over"), and the `TIdeles` are monotone in `T`.

## Main result

* `NK.GlobalCFTdeep.Herbrand.exists_T_unramifiedOutside_surjective`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped NumberField RestrictedProduct
open NumberField IsDedekindDomain

noncomputable section

namespace NK.GlobalCFTdeep.Herbrand

open NK.GlobalCFT

/-- The `T`-idèles are monotone in `T`: enlarging `T` weakens the local-unit condition outside
`T`, hence enlarges the group of `T`-idèles. -/
theorem TIdeles_mono {L : Type} [Field L] [NumberField L] {T T' : Set (Place L)}
    (h : T ⊆ T') : TIdeles T ≤ TIdeles T' := by
  intro x hx w hw
  exact hx w fun hw' => hw (h hw')

theorem exists_T_unramifiedOutside_surjective {K L : Type} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] :
    ∃ (S : Finset (NK.GlobalCFT.Place K)) (T : Set (NK.GlobalCFT.Place L)),
      (∀ (σ : L ≃ₐ[K] L) ⦃w : NK.GlobalCFT.Place L⦄, w ∈ T → σ • w ∈ T) ∧
      (∀ w : NK.GlobalCFT.Place L, w ∈ T ↔ ∃ v ∈ S, NK.GlobalCFT.Place.LiesOver w v) ∧
      (∀ a : NumberField.InfinitePlace K, NK.GlobalCFT.Place.ofInfinite a ∈ S) ∧
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
        (∀ v ∈ S, ¬ NK.GlobalCFT.Place.LiesOver
          (NK.GlobalCFT.Place.ofFinite q) v) →
        q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) ∧
      ((⊤ : Subgroup (NK.GlobalCFT.Idele L))
        = NK.GlobalCFT.Idele.principalSubgroup L ⊔ NK.GlobalCFTdeep.TIdeles T) := by
  classical
  -- a finite set of places of `L` whose `T`-idèles surject onto the class group
  obtain ⟨T₁, hT₁⟩ := exists_finset_TIdeles_surjective (L := L)
  -- only finitely many primes of `𝓞 L` ramify over `𝓞 K`
  have hRfin : ({q : HeightOneSpectrum (𝓞 L) |
      q.asIdeal.ramificationIdx (𝓞 K) ≠ 1} : Set _).Finite :=
    Commons.NumberTheory.NumberField.finite_setOf_ramificationIdx_ne_one (K := K) (L := L)
  -- a choice of the place of `K` below a given place of `L`
  let under : Place L → Place K := fun w => Norm.globalCFT_placeUnder w
  let A : Finset (Place K) := T₁.image under
  let B : Finset (Place K) := hRfin.toFinset.image fun q => under (Place.ofFinite q)
  let C : Finset (Place K) := Finset.univ.image Place.ofInfinite
  let S : Finset (Place K) := A ∪ B ∪ C
  let T : Set (Place L) := {w | ∃ v ∈ S, Place.LiesOver w v}
  have memA : ∀ x, x ∈ A → x ∈ S :=
    fun x hx => Finset.mem_union_left _ (Finset.mem_union_left _ hx)
  have memB : ∀ x, x ∈ B → x ∈ S :=
    fun x hx => Finset.mem_union_left _ (Finset.mem_union_right _ hx)
  have memC : ∀ x, x ∈ C → x ∈ S := fun x hx => Finset.mem_union_right _ hx
  -- every place of `L` in `T₁` lies over an element of `S`, i.e. `T₁ ⊆ T`
  have hT₁_le : (↑T₁ : Set (Place L)) ⊆ T := by
    intro w hw
    refine ⟨under w, memA _ (Finset.mem_image.mpr ⟨w, ?_, rfl⟩),
      Norm.liesOver_globalCFT_placeUnder w⟩
    simpa using hw
  refine ⟨S, T, ?_, ?_, ?_, ?_, ?_⟩
  · -- `T` is stable under `Gal(L/K)`
    intro σ w hw
    obtain ⟨v, hvS, hv⟩ := hw
    exact ⟨v, hvS, (Place.liesOver_smul_iff (σ := σ)).mpr hv⟩
  · -- `T` is, by definition, the set of places of `L` lying over `S`
    intro w
    rfl
  · -- all archimedean places of `K` lie in `S`
    intro a
    exact memC _ (Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩)
  · -- a prime of `L` outside `T` is unramified
    intro q hq
    by_contra hram
    have hqmem : q ∈ hRfin.toFinset := (hRfin.mem_toFinset (a := q)).mpr (by simpa using hram)
    exact hq _ (memB _ (Finset.mem_image.mpr ⟨q, hqmem, rfl⟩))
      (Norm.liesOver_globalCFT_placeUnder (Place.ofFinite q))
  · -- the class group is captured by the `T`-idèles
    refine top_eq_principal_sup_TIdeles T ?_
    intro c
    obtain ⟨u, huT₁, hu⟩ := hT₁ c
    exact ⟨u, TIdeles_mono hT₁_le huT₁, hu⟩

end NK.GlobalCFTdeep.Herbrand
