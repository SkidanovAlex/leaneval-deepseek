import Mathlib
import Submission.Work.RPCore.Defs
import Submission.Work.RPCore.Chain.ChainDefs
import Submission.Work.RPCore.Chain.foldl_ofFn_chain
import Submission.Work.RPCore.Chain.chainAction_crit_P
import Submission.Work.RPCore.Chain.chainAction_crit_q

/-!
# C3: critical points of the broken-geodesic chain action

`chainAction_crit`: a critical point of the discrete (broken-geodesic) action
`chainAction n W` yields a chain `x₀ ∈ Z ↦ … ↦ Z` for the maps `ψ j` generated by the
type-2 generating functions `W j`; in particular the composite `ψ_n ∘ … ∘ ψ_0` maps some
point of the zero section into the zero section.

The two analytic inputs

* `chainAction_crit_P` (`∂/∂P_j` of the action),
* `chainAction_crit_q` (`∂/∂q_k` of the action)

are proved in the sibling modules of this directory; everything else is `chainAction_aux`
below.
-/

namespace Work.RPCore.Chain

open Work.RPV
open scoped Classical

noncomputable section

/-- The chain point attached to the index `k`: the pair `(q k, p k)` where `p k` is the
momentum produced by the type-2 generating function `W k` from the boundary data
`Peff n P k`. -/
def chainPt (n : ℕ) (W : Fin (n + 1) → PS → ℝ) (q : Fin (n + 1) → ℝ × ℝ)
    (P : Fin n → ℝ × ℝ) : Fin (n + 1) → PS :=
  fun k => (q k, Peff n P k + dq (W k) (q k) (Peff n P k))

/-- Assembly step: the critical-point equations `hP`, `hQ` for `chainAction` turn the
sequence `chainPt` into an orbit of the maps `ψ j` running from the zero section back
into the zero section. -/
theorem chainAction_aux (n : ℕ) (ψ : Fin (n + 1) → PS → PS) (W : Fin (n + 1) → PS → ℝ)
    (hW : ∀ j, IsType2GF (ψ j) (W j)) (q : Fin (n + 1) → ℝ × ℝ) (P : Fin n → ℝ × ℝ)
    (hP : ∀ j : Fin n,
      q j.succ - q j.castSucc = dP (W j.castSucc) (q j.castSucc) (Peff n P j.castSucc))
    (hQ : ∀ k : Fin (n + 1),
      dq (W k) (q k) (Peff n P k) = Pprev n P k - Peff n P k) :
    ∃ x ∈ Zsec, ∃ y ∈ Zsec, (List.ofFn ψ).foldl (fun acc f => f acc) x = y := by
  have hstep : ∀ j : Fin n, ψ j.castSucc (chainPt n W q P j.castSucc) = chainPt n W q P j.succ := by
    intro j
    have h2 : q j.succ = q j.castSucc + dP (W j.castSucc) (q j.castSucc) (Peff n P j.castSucc) := by
      rw [← hP j]; abel
    have hcond : (chainPt n W q P j.castSucc).2 =
          Peff n P j.castSucc + dq (W j.castSucc) (chainPt n W q P j.castSucc).1
            (Peff n P j.castSucc) ∧
        q j.succ = (chainPt n W q P j.castSucc).1 +
          dP (W j.castSucc) (chainPt n W q P j.castSucc).1 (Peff n P j.castSucc) :=
      ⟨rfl, h2⟩
    have hψ := ((hW j.castSucc) (chainPt n W q P j.castSucc).1 (chainPt n W q P j.castSucc).2
      (q j.succ) (Peff n P j.castSucc)).mpr hcond
    have hgoal : chainPt n W q P j.succ = (q j.succ, P j) := by
      show (q j.succ, Peff n P j.succ + dq (W j.succ) (q j.succ) (Peff n P j.succ)) =
        (q j.succ, P j)
      rw [hQ j.succ, Pprev_succ n P j]
      congr 1
      abel
    rw [hψ, hgoal, Peff_castSucc n P j]
  have hz0 : chainPt n W q P 0 ∈ Zsec := by
    show (chainPt n W q P 0).2 = 0
    show Peff n P 0 + dq (W 0) (q 0) (Peff n P 0) = 0
    rw [hQ 0, Pprev_zero n P]
    abel
  have hzlast : ψ (Fin.last n) (chainPt n W q P (Fin.last n)) ∈ Zsec := by
    have hcond : (chainPt n W q P (Fin.last n)).2 =
          Peff n P (Fin.last n) + dq (W (Fin.last n)) (chainPt n W q P (Fin.last n)).1
            (Peff n P (Fin.last n)) ∧
        (chainPt n W q P (Fin.last n)).1 +
            dP (W (Fin.last n)) (chainPt n W q P (Fin.last n)).1 (Peff n P (Fin.last n)) =
          (chainPt n W q P (Fin.last n)).1 +
            dP (W (Fin.last n)) (chainPt n W q P (Fin.last n)).1 (Peff n P (Fin.last n)) :=
      ⟨rfl, rfl⟩
    have hψ := ((hW (Fin.last n)) (chainPt n W q P (Fin.last n)).1
      (chainPt n W q P (Fin.last n)).2
      ((chainPt n W q P (Fin.last n)).1 +
        dP (W (Fin.last n)) (chainPt n W q P (Fin.last n)).1 (Peff n P (Fin.last n)))
      (Peff n P (Fin.last n))).mpr hcond
    show (ψ (Fin.last n) (chainPt n W q P (Fin.last n))).2 = 0
    rw [hψ, Peff_last n P]
  let ys : Fin (n + 2) → PS := fun i =>
    if h : (i : ℕ) < n + 1 then chainPt n W q P ⟨i, h⟩
    else ψ (Fin.last n) (chainPt n W q P (Fin.last n))
  have hys0 : ys 0 = chainPt n W q P 0 := by
    show (if h : (0:ℕ) < n+1 then chainPt n W q P ⟨0, h⟩ else
      ψ (Fin.last n) (chainPt n W q P (Fin.last n))) = chainPt n W q P 0
    rw [dif_pos (Nat.zero_lt_succ n)]
    congr 1
  have hyslast : ys (Fin.last (n + 1)) = ψ (Fin.last n) (chainPt n W q P (Fin.last n)) := by
    show (if h : ((Fin.last (n+1) : Fin (n+2)) : ℕ) < n + 1 then
      chainPt n W q P ⟨↑(Fin.last (n+1)), h⟩ else
      ψ (Fin.last n) (chainPt n W q P (Fin.last n))) = _
    rw [dif_neg (by simp)]
  have hys_castSucc : ∀ i : Fin (n + 1), ys i.castSucc = chainPt n W q P i := by
    intro i
    show (if h : ((i.castSucc : Fin (n+2)) : ℕ) < n + 1 then
      chainPt n W q P ⟨↑(i.castSucc), h⟩ else
      ψ (Fin.last n) (chainPt n W q P (Fin.last n))) = chainPt n W q P i
    rw [dif_pos (show ((i.castSucc : Fin (n+2)) : ℕ) < n + 1 from i.isLt)]
    congr 1
  have hfold : ∀ i : Fin (n + 1), ψ i (ys i.castSucc) = ys i.succ := by
    intro i
    rw [hys_castSucc i]
    by_cases hi : (i : ℕ) < n
    · let j : Fin n := ⟨i.val, hi⟩
      have hi_eq : i = j.castSucc := by ext; rfl
      rw [hi_eq]
      have hsucc : (j.castSucc : Fin (n + 1)).succ = (j.succ : Fin (n+1)).castSucc := by
        ext; simp [Fin.succ]
      rw [hsucc, hys_castSucc j.succ, hstep j]
    · have hi_eq : i = Fin.last n := by ext; simp [Fin.last]; omega
      rw [hi_eq]
      have hsucc : (Fin.last n : Fin (n + 1)).succ = Fin.last (n + 1) := by ext; simp [Fin.last]
      rw [hsucc, hyslast]
  refine ⟨ys 0, ?_, ys (Fin.last (n + 1)), ?_, ?_⟩
  · rw [hys0]; exact hz0
  · rw [hyslast]; exact hzlast
  · exact foldl_ofFn_chain n ψ ys hfold

theorem chainAction_crit (n : ℕ) (ψ : Fin (n + 1) → Work.RPV.PS → Work.RPV.PS)
    (W : Fin (n + 1) → Work.RPV.PS → ℝ) (hW : ∀ j, Work.RPV.IsType2GF (ψ j) (W j))
    (hWd : ∀ j, Differentiable ℝ (W j)) (q : Fin (n + 1) → ℝ × ℝ) (P : Fin n → ℝ × ℝ)
    (hcrit : fderiv ℝ (fun z : (Fin (n + 1) → ℝ × ℝ) × (Fin n → ℝ × ℝ) =>
      Work.RPV.chainAction n W z.1 z.2) (q, P) = 0) :
    ∃ x ∈ Work.RPV.Zsec, ∃ y ∈ Work.RPV.Zsec,
      (List.ofFn ψ).foldl (fun acc f => f acc) x = y := by
  exact chainAction_aux n ψ W hW q P
    (chainAction_crit_P n W hWd q P hcrit) (chainAction_crit_q n W hWd q P hcrit)

end

end Work.RPCore.Chain
