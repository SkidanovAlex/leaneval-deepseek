import Mathlib
import Submission.Work.RPB1a.Caratheodory.Brouwer.brouwer_fixed_point_square

namespace Work.RPB1a.Caratheodory.IOD

open Complex Set Metric
open MeasureTheory
open scoped ContDiff Real Topology
-- Brouwer/Kulpa invariance of domain, unit-ball form (Tao's blog post on BFPT and IOD, Kulpa 1998).
-- Route: f is a homeo onto f '' closedBall 0 1, so g := f⁻¹ is continuous there; extend g to a
-- continuous G : ℂ → ℂ (Mathlib Topology/TietzeExtension.lean). Suppose f 0 ∉ interior (f '' closedBall 0 1);
-- there are y ∉ f '' closedBall 0 1 arbitrarily close to f 0. Translate so f 0 = 0, ‖c‖ ≤ ε for such c, and
-- ‖G y‖ ≤ 1/10 for ‖y‖ ≤ ε. With Φ y := max (ε/‖y‖) 1 • y, Σ := {y ∈ f '' closedBall 0 1 : ‖y‖ ≥ ε} ∪ {‖y‖ = ε},
-- the map G is bounded below by δ > 0 on the compact part with ‖y‖ ≥ ε; approximate G on the compact Σ by a
-- polynomial map P (Stone–Weierstrass: Mathlib Topology/ContinuousMap/StoneWeierstrass.lean) with P ≠ 0 on Σ.
-- Then G̃ := P ∘ Φ is continuous, nowhere zero on f '' closedBall 0 1, and ‖G y - G̃ y‖ ≤ 1 for all y;
-- Brouwer's FPT for the unit ball (see RPB1a/Caratheodory/IOD/brouwer_fixed_point_unit_ball) applied to
-- x ↦ x - G̃ (f x) (which maps the ball into itself, since x - G̃ (f x) = G (f x) - G̃ (f x) and G (f x) = x)
-- produces a zero of G̃, a contradiction.

noncomputable section

/-! ### Stone–Weierstrass: approximation on a compact set by a differentiable map

This is the analytic input of Tao's proof: any continuous `g : ℂ → ℂ` can be uniformly approximated
on a compact set by an (everywhere) real-differentiable map.  The differentiable maps are realized
as the subalgebra of `C(ℂ, ℝ)` generated by `re` and `im`, and the real Stone–Weierstrass theorem is
applied to the two real components of `g`. -/

private theorem diff_approx_on_compact {K : Set ℂ} (hK : IsCompact K)
    (g : ℂ → ℂ) (hg : Continuous g) {δ : ℝ} (hδ : 0 < δ) :
    ∃ P : ℂ → ℂ, Differentiable ℝ P ∧ ∀ y ∈ K, ‖P y - g y‖ < δ := by
  let reC : C(ℂ, ℝ) := ⟨Complex.re, Complex.continuous_re⟩
  let imC : C(ℂ, ℝ) := ⟨Complex.im, Complex.continuous_im⟩
  let A : Subalgebra ℝ C(ℂ, ℝ) := Algebra.adjoin ℝ ({reC, imC} : Set C(ℂ, ℝ))
  have hgen : ∀ f ∈ ({reC, imC} : Set C(ℂ, ℝ)), Differentiable ℝ (f : ℂ → ℝ) := by
    intro f hf
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hf
    rcases hf with rfl | rfl
    · exact Complex.differentiable_re
    · exact Complex.differentiable_im
  have hA_diff : ∀ f ∈ A, Differentiable ℝ (f : ℂ → ℝ) := by
    intro f hf
    refine Algebra.adjoin_induction
      (p := fun (f : C(ℂ, ℝ)) (_ : f ∈ A) => Differentiable ℝ (f : ℂ → ℝ)) ?_ ?_ ?_ ?_ hf
    · intro a ha; exact hgen a ha
    · intro r
      have h : (algebraMap ℝ C(ℂ, ℝ) r : ℂ → ℝ) = fun _ => r := by ext z; simp
      rw [h]; exact differentiable_const r
    · intro a b _ _ ha hb; exact ha.add hb
    · intro a b _ _ ha hb; simpa only [ContinuousMap.coe_mul] using ha.mul hb
  have hA_sep : A.SeparatesPoints := by
    intro z w hzw
    by_cases hre : z.re ≠ w.re
    · refine ⟨⇑reC, ⟨reC, ?_, rfl⟩, by simpa [reC] using hre⟩
      exact Algebra.subset_adjoin (s := ({reC, imC} : Set C(ℂ, ℝ)))
        (show reC ∈ ({reC, imC} : Set C(ℂ, ℝ)) from by simp)
    · push_neg at hre
      have him : z.im ≠ w.im := fun h => hzw (Complex.ext hre h)
      refine ⟨⇑imC, ⟨imC, ?_, rfl⟩, by simpa [imC] using him⟩
      exact Algebra.subset_adjoin (s := ({reC, imC} : Set C(ℂ, ℝ)))
        (show imC ∈ ({reC, imC} : Set C(ℂ, ℝ)) from by simp)
  have hgre : Continuous (fun z => (g z).re) := Complex.continuous_re.comp hg
  have hgim : Continuous (fun z => (g z).im) := Complex.continuous_im.comp hg
  obtain ⟨p1, hp1A, hp1⟩ :=
    ContinuousMap.exists_mem_subalgebra_near_continuous_of_isCompact_of_separatesPoints
      hA_sep ⟨fun z => (g z).re, hgre⟩ hK (half_pos hδ)
  obtain ⟨p2, hp2A, hp2⟩ :=
    ContinuousMap.exists_mem_subalgebra_near_continuous_of_isCompact_of_separatesPoints
      hA_sep ⟨fun z => (g z).im, hgim⟩ hK (half_pos hδ)
  refine ⟨fun z => (p1 z : ℂ) + (p2 z : ℂ) * I, ?_, ?_⟩
  · have h1 : Differentiable ℝ (fun z => (p1 z : ℂ)) :=
      Complex.ofRealCLM.differentiable.comp (hA_diff p1 hp1A)
    have h2 : Differentiable ℝ (fun z => (p2 z : ℂ)) :=
      Complex.ofRealCLM.differentiable.comp (hA_diff p2 hp2A)
    exact h1.add (h2.mul_const I)
  · intro y hy
    have hlt1 : |p1 y - (g y).re| < δ / 2 := by
      simpa only [Real.norm_eq_abs, ContinuousMap.coe_mk] using hp1 y hy
    have hlt2 : |p2 y - (g y).im| < δ / 2 := by
      simpa only [Real.norm_eq_abs, ContinuousMap.coe_mk] using hp2 y hy
    calc ‖(p1 y : ℂ) + (p2 y : ℂ) * I - g y‖
        ≤ |((p1 y : ℂ) + (p2 y : ℂ) * I - g y).re|
            + |((p1 y : ℂ) + (p2 y : ℂ) * I - g y).im| := Complex.norm_le_abs_re_add_abs_im _
      _ = |p1 y - (g y).re| + |p2 y - (g y).im| := by simp
      _ < δ := by linarith

/-! ### Brouwer's fixed point theorem for the closed unit disk of `ℂ` -/

private lemma clampC_norm_le_one (z : ℂ) : ‖(max 1 ‖z‖)⁻¹ • z‖ ≤ 1 := by
  have hpos : 0 < max 1 ‖z‖ := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpos)]
  calc (max 1 ‖z‖)⁻¹ * ‖z‖ ≤ (max 1 ‖z‖)⁻¹ * (max 1 ‖z‖) :=
        mul_le_mul_of_nonneg_left (le_max_right _ _) (le_of_lt (inv_pos.mpr hpos))
    _ = 1 := inv_mul_cancel₀ (ne_of_gt hpos)

private lemma clampC_eq_self {z : ℂ} (hz : ‖z‖ ≤ 1) : (max 1 ‖z‖)⁻¹ • z = z := by
  rw [max_eq_left hz, inv_one, one_smul]

private lemma mem_square_iff_norm_le_one (p : ℝ × ℝ) :
    p ∈ Set.Icc (-1 : ℝ) 1 ×ˢ Set.Icc (-1 : ℝ) 1 ↔ ‖p‖ ≤ 1 := by
  rw [Set.mem_prod, Set.mem_Icc, Set.mem_Icc, Prod.norm_def, max_le_iff]
  constructor
  · rintro ⟨⟨h1, h2⟩, ⟨h3, h4⟩⟩
    exact ⟨by rw [Real.norm_eq_abs]; exact abs_le.mpr ⟨h1, h2⟩,
           by rw [Real.norm_eq_abs]; exact abs_le.mpr ⟨h3, h4⟩⟩
  · intro ⟨h1, h2⟩
    rw [Real.norm_eq_abs] at h1 h2
    exact ⟨abs_le.mp h1, abs_le.mp h2⟩

/-- Brouwer's fixed point theorem for the closed unit disk of `ℂ`, deduced from the square form
`brouwer_fixed_point_square` by conjugating with the coordinate identification `ℂ ≃ ℝ × ℝ`. -/
theorem brouwer_fixed_point_disk (f : ℂ → ℂ) (hf : ContinuousOn f (closedBall 0 1))
    (hm : MapsTo f (closedBall 0 1) (closedBall 0 1)) :
    ∃ x, ‖x‖ ≤ 1 ∧ f x = x := by
  set F : ℂ → ℂ := fun z => f ((max 1 ‖z‖)⁻¹ • z) with hF
  have hclamp : Continuous fun z : ℂ => (max 1 ‖z‖)⁻¹ • z := by
    have hmax : Continuous fun z : ℂ => max 1 ‖z‖ :=
      (continuous_const : Continuous fun _ : ℂ => (1 : ℝ)).max continuous_norm
    exact Continuous.smul (Continuous.inv₀ hmax
      (fun z => ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_left _ _)))) continuous_id
  have hFc : Continuous F := hf.comp_continuous hclamp (fun z => by
    rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
    exact clampC_norm_le_one z)
  have hFmem : ∀ z, ‖F z‖ ≤ 1 := by
    intro z
    have hmem : (max 1 ‖z‖)⁻¹ • z ∈ closedBall (0 : ℂ) 1 := by
      rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
      exact clampC_norm_le_one z
    have h := hm hmem
    rw [Metric.mem_closedBall, dist_eq_norm, sub_zero] at h
    simpa only [hF] using h
  set G : ℝ × ℝ → ℝ × ℝ :=
    fun p => Complex.equivRealProdCLM (F (Complex.equivRealProdCLM.symm p)) with hG
  have hGc : Continuous G :=
    Complex.equivRealProdCLM.continuous.comp
      (hFc.comp Complex.equivRealProdCLM.symm.continuous)
  have hGmaps : ∀ p ∈ Set.Icc (-1 : ℝ) 1 ×ˢ Set.Icc (-1 : ℝ) 1,
      G p ∈ Set.Icc (-1 : ℝ) 1 ×ˢ Set.Icc (-1 : ℝ) 1 := by
    intro p _
    rw [mem_square_iff_norm_le_one]
    have h1 : G p = Complex.equivRealProd (F (Complex.equivRealProdCLM.symm p)) := by
      simp only [hG, Complex.equivRealProdCLM_apply, Complex.equivRealProd_apply]
    rw [h1]
    exact (Complex.equivRealProd_apply_le _).trans (hFmem _)
  obtain ⟨p, _, hfix⟩ :=
    Work.RPB1a.Caratheodory.Brouwer.brouwer_fixed_point_square G hGc hGmaps
  have hFx : F (Complex.equivRealProdCLM.symm p) = Complex.equivRealProdCLM.symm p := by
    refine Complex.equivRealProdCLM.injective ?_
    rw [Complex.equivRealProdCLM.apply_symm_apply]
    exact hfix
  refine ⟨Complex.equivRealProdCLM.symm p, ?_, ?_⟩
  · rw [← hFx]; exact hFmem _
  · have hle : ‖Complex.equivRealProdCLM.symm p‖ ≤ 1 := by rw [← hFx]; exact hFmem _
    have hclamp : (max 1 ‖Complex.equivRealProdCLM.symm p‖)⁻¹ •
        Complex.equivRealProdCLM.symm p = Complex.equivRealProdCLM.symm p := clampC_eq_self hle
    calc f (Complex.equivRealProdCLM.symm p)
        = f ((max 1 ‖Complex.equivRealProdCLM.symm p‖)⁻¹ •
            Complex.equivRealProdCLM.symm p) := by rw [hclamp]
      _ = F (Complex.equivRealProdCLM.symm p) := by rw [hF]
      _ = Complex.equivRealProdCLM.symm p := hFx

/-! ### Tao's invariance of domain argument -/

private lemma radialProjection_mem (c : ℂ) {ε : ℝ} (hε : 0 < ε) {s : Set ℂ} (hc : c ∉ s)
    {y : ℂ} (hy : y ∈ s) :
    c + max (ε / ‖y - c‖) (1 : ℝ) • (y - c) ∈
      {z ∈ s | ‖z - c‖ ≥ ε} ∪ sphere c ε := by
  by_cases h : ε < ‖y - c‖
  · have hyc : 0 < ‖y - c‖ := hε.trans h
    rw [max_eq_right_of_lt ((div_lt_one hyc).mpr h), one_smul, add_sub_cancel]
    exact Or.inl ⟨hy, h.le⟩
  · right
    simp only [not_lt] at h
    have hy_neq_c : c ≠ y := fun hcy => hc (hcy ▸ hy)
    have hpos : 0 < ‖y - c‖ := norm_pos_iff.mpr (sub_ne_zero.mpr (Ne.symm hy_neq_c))
    have hleft : 1 ≤ ε / ‖y - c‖ := (one_le_div hpos).mpr h
    rw [max_eq_left hleft, mem_sphere, dist_eq_norm, add_sub_cancel_left, norm_smul,
      Real.norm_eq_abs, abs_of_nonneg (div_nonneg hε.le (norm_nonneg _)),
      div_mul_cancel₀ _ (ne_of_gt hpos)]

theorem interior_image_of_continuousOn_injOn {f : ℂ → ℂ} (hf : ContinuousOn f (closedBall 0 1))
    (hi : InjOn f (closedBall 0 1)) :
    f 0 ∈ interior (f '' closedBall (0 : ℂ) 1) := by
  haveI : CompactSpace ↥(closedBall (0 : ℂ) 1) :=
    isCompact_iff_compactSpace.mp (isCompact_closedBall (0 : ℂ) 1)
  -- The homeomorphism of `closedBall 0 1` onto its image under `f`.
  let FEquiv := Equiv.Set.imageOfInjOn f (closedBall (0 : ℂ) 1) hi
  let FInvCmap : C(f '' closedBall (0 : ℂ) 1, closedBall (0 : ℂ) 1) :=
    ⟨FEquiv.symm, Continuous.continuous_symm_of_equiv_compact_to_t2
      (continuous_induced_rng.mpr (ContinuousOn.domRestrict hf))⟩
  have hballimageclosed : IsClosed (f '' closedBall (0 : ℂ) 1) :=
    ((isCompact_closedBall (0 : ℂ) 1).image_of_continuousOn hf).isClosed
  -- Tietze: extend `f⁻¹` to a continuous `G : ℂ → closedBall 0 1`.
  obtain ⟨G, hG⟩ := ContinuousMap.exists_restrict_eq hballimageclosed FInvCmap
  have hG_eq : ∀ y (hy : y ∈ f '' closedBall (0 : ℂ) 1), G y = FInvCmap ⟨y, hy⟩ := by
    intro y hy
    simpa only [ContinuousMap.restrict_apply] using DFunLike.congr_fun hG ⟨y, hy⟩
  have hG0 : G (f 0) = (0 : closedBall (0 : ℂ) 1) := by
    have h1 : G (f 0) =
        FInvCmap ⟨f 0, mem_image_of_mem f (by simp : (0 : ℂ) ∈ closedBall 0 1)⟩ := hG_eq _ _
    rw [h1]
    have H : (⟨f 0, mem_image_of_mem f (by simp : (0 : ℂ) ∈ closedBall 0 1)⟩ :
        ↥(f '' closedBall (0 : ℂ) 1)) = FEquiv ⟨0, by simp⟩ := Subtype.ext rfl
    rw [H]
    simp only [FInvCmap]
    exact FEquiv.symm_apply_apply ⟨0, by simp⟩
  let G' : C(ℂ, ℂ) := ⟨fun x => (G x : ℂ), continuous_subtype_val.comp G.continuous⟩
  have hG'0 : G' (f 0) = 0 := by
    simp only [G', ContinuousMap.coe_mk, hG0]
    rfl
  have hG'_left_inv : ∀ x ∈ closedBall (0 : ℂ) 1, G' (f x) = x := by
    intro x hx
    have h1 : G (f x) = FInvCmap ⟨f x, mem_image_of_mem f hx⟩ := hG_eq _ _
    simp only [G', ContinuousMap.coe_mk]
    rw [h1]
    have H : (⟨f x, mem_image_of_mem f hx⟩ : ↥(f '' closedBall (0 : ℂ) 1)) = FEquiv ⟨x, hx⟩ :=
      Subtype.ext rfl
    rw [H]
    simp only [FInvCmap]
    exact congrArg Subtype.val (FEquiv.symm_apply_apply ⟨x, hx⟩)
  -- Stability of zero: it suffices to build a continuous `Gt` on the image, nowhere zero there,
  -- with `‖G - Gt‖ ≤ 1` pointwise.
  have stability : ∀ (Gt : ℂ → ℂ), ContinuousOn Gt (f '' closedBall (0 : ℂ) 1) →
      (∀ y ∈ f '' closedBall (0 : ℂ) 1, ‖G' y - Gt y‖ ≤ 1) →
      ∃ y ∈ f '' closedBall (0 : ℂ) 1, Gt y = 0 := by
    intro Gt hGt hbound
    let diff : ℂ → ℂ := fun x => x - Gt (f x)
    have hMapsTo : MapsTo diff (closedBall (0 : ℂ) 1) (closedBall (0 : ℂ) 1) := by
      intro x hx
      have h := hbound (f x) (mem_image_of_mem f hx)
      rw [hG'_left_inv x hx] at h
      rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
      simpa only [diff] using h
    have hcont : ContinuousOn diff (closedBall (0 : ℂ) 1) :=
      (continuousOn_id' _).sub (hGt.comp hf (mapsTo_image f _))
    obtain ⟨x, hx, hfix⟩ := brouwer_fixed_point_disk diff hcont hMapsTo
    have hxmem : x ∈ closedBall (0 : ℂ) 1 := by
      rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]; exact hx
    refine ⟨f x, mem_image_of_mem f hxmem, ?_⟩
    have hx' : x - Gt (f x) = x := by simpa only [diff] using hfix
    rw [sub_eq_self] at hx'
    exact hx'
  by_contra hnotinterior
  rw [mem_interior] at hnotinterior
  have hnot : ∀ t, t ⊆ f '' closedBall (0 : ℂ) 1 → IsOpen t → f 0 ∉ t := by
    intro t ht hto hm
    exact hnotinterior ⟨t, ht, hto, hm⟩
  obtain ⟨δ0, hδ0pos, hδ0⟩ : ∃ δ0 > 0, ∀ y, ‖y - f 0‖ < δ0 → ‖G' y‖ < (0.1 : ℝ) := by
    have hc : ContinuousAt (G' : ℂ → ℂ) (f 0) := G'.continuous.continuousAt
    rw [Metric.continuousAt_iff] at hc
    obtain ⟨δ0, hδ0pos, hδ0fun⟩ := hc (0.1) (by norm_num)
    exact ⟨δ0, hδ0pos, fun y hy => by
      have hy' : dist y (f 0) < δ0 := by rw [dist_eq_norm]; exact hy
      simpa only [dist_eq_norm, hG'0, sub_zero] using hδ0fun hy'⟩
  set ε : ℝ := δ0 / 2 with hε
  have hεpos : 0 < ε := half_pos hδ0pos
  have hnotball : ¬ ball (f 0) ε ⊆ f '' closedBall (0 : ℂ) 1 :=
    fun hsub => hnot (ball (f 0) ε) hsub isOpen_ball (mem_ball_self hεpos)
  rw [Set.not_subset] at hnotball
  obtain ⟨c, hc1, hc2⟩ := hnotball
  have hc1' : dist c (f 0) < ε := by rwa [mem_ball] at hc1
  have hG_small : ∀ y, ‖y - c‖ ≤ ε → ‖G' y‖ ≤ (0.1 : ℝ) := by
    intro y hy
    have hcn : ‖c - f 0‖ < ε := by rw [← dist_eq_norm]; exact hc1'
    have hineq : ‖y - f 0‖ ≤ ‖y - c‖ + ‖c - f 0‖ := by
      have := norm_add_le (y - c) (c - f 0)
      simpa only [sub_add_sub_cancel] using this
    have hdist : ‖y - f 0‖ < δ0 := by linarith [hineq, hy, hcn, hε]
    exact (hδ0 y hdist).le
  set sigma1 : Set ℂ := {y ∈ f '' closedBall (0 : ℂ) 1 | ‖y - c‖ ≥ ε} with hsigma1
  set sigma2 : Set ℂ := sphere c ε with hsigma2
  set sigma : Set ℂ := sigma1 ∪ sigma2 with hsigma
  have hsigma1compact : IsCompact sigma1 := by
    rw [isCompact_iff_isClosed_bounded]
    refine ⟨?_, ?_⟩
    · have hclosed : IsClosed {y : ℂ | ‖y - c‖ ≥ ε} := by
        rw [show {y : ℂ | ‖y - c‖ ≥ ε} = (ball c ε)ᶜ by
          ext y; simp only [Set.mem_setOf_eq, Set.mem_compl_iff, mem_ball_iff_norm, not_lt]]
        exact isOpen_ball.isClosed_compl
      rw [hsigma1, show {y : ℂ | y ∈ f '' closedBall (0 : ℂ) 1 ∧ ‖y - c‖ ≥ ε}
          = f '' closedBall (0 : ℂ) 1 ∩ {y : ℂ | ‖y - c‖ ≥ ε} from by
        ext y; simp only [Set.mem_setOf_eq, Set.mem_inter_iff]]
      exact hballimageclosed.inter hclosed
    · exact (IsCompact.isBounded
        ((isCompact_closedBall (0 : ℂ) 1).image_of_continuousOn hf)).subset
        (Set.sep_subset (f '' closedBall (0 : ℂ) 1) (fun y => ‖y - c‖ ≥ ε))
  have hsigmacompact : IsCompact sigma := by
    rw [hsigma]
    exact IsCompact.union hsigma1compact (by rw [hsigma2]; exact isCompact_sphere c ε)
  set Phi : ℂ → ℂ := fun y => c + max (ε / ‖y - c‖) 1 • (y - c) with hPhi
  have hPhiimg : ∀ y ∈ f '' closedBall (0 : ℂ) 1, Phi y ∈ sigma := by
    intro y hy
    rw [hsigma]
    simpa only [hPhi, hsigma1, hsigma2] using radialProjection_mem c hεpos hc2 hy
  have hPhicont : ContinuousOn Phi (f '' closedBall (0 : ℂ) 1) := by
    rw [continuousOn_iff_continuous_domRestrict]
    have hvec : Continuous fun y : ↥(f '' closedBall (0 : ℂ) 1) => (y : ℂ) - c :=
      continuous_subtype_val.sub continuous_const
    have hden : Continuous fun y : ↥(f '' closedBall (0 : ℂ) 1) => ‖(y : ℂ) - c‖ := hvec.norm
    have hden_ne : ∀ y : ↥(f '' closedBall (0 : ℂ) 1), ‖(y : ℂ) - c‖ ≠ 0 := by
      intro y
      rw [norm_ne_zero_iff, sub_ne_zero]
      exact fun h => hc2 (h ▸ y.property)
    have hsc : Continuous fun y : ↥(f '' closedBall (0 : ℂ) 1) => max (ε / ‖(y : ℂ) - c‖) 1 :=
      (continuous_const.div hden hden_ne).max continuous_const
    have hfin : Continuous fun y : ↥(f '' closedBall (0 : ℂ) 1) =>
        c + max (ε / ‖(y : ℂ) - c‖) 1 • ((y : ℂ) - c) :=
      continuous_const.add (hsc.smul hvec)
    show Continuous (fun y : ↥(f '' closedBall (0 : ℂ) 1) => Phi (y : ℂ))
    simpa only [hPhi] using hfin
  have hGavoids : ∀ y ∈ sigma1, G' y ≠ 0 := by
    intro y hy
    by_contra hGeq
    have hG_inj : Set.InjOn G' (f '' closedBall (0 : ℂ) 1) := by
      intro a ha b hb hab
      have ha_eq := hG_eq a ha
      have hb_eq := hG_eq b hb
      simp only [G', ContinuousMap.coe_mk] at hab
      rw [ha_eq, hb_eq] at hab
      have hab' : FInvCmap ⟨a, ha⟩ = FInvCmap ⟨b, hb⟩ := Subtype.val_injective hab
      simp only [FInvCmap] at hab'
      exact congrArg Subtype.val (FEquiv.symm.injective hab')
    have hyeq : y = f 0 := by
      have hf0 : f 0 ∈ f '' closedBall (0 : ℂ) 1 := mem_image_of_mem f (by simp)
      have heq : G' y = G' (f 0) := by rw [hGeq, hG'0]
      exact hG_inj hy.1 hf0 heq
    rw [hyeq] at hy
    have hlt : ‖f 0 - c‖ < ε := by
      have := hc1'; rw [dist_eq_norm, norm_sub_rev] at this; exact this
    have hge : ‖f 0 - c‖ ≥ ε := hy.2
    linarith
  have hnormcont : ContinuousOn (fun y => ‖G' y‖) sigma1 :=
    (G'.continuous.norm).continuousOn
  obtain ⟨dl, hdlpos, hdllt, hdlle⟩ :
      ∃ dl, 0 < dl ∧ dl < (0.1 : ℝ) ∧ ∀ y ∈ sigma1, dl ≤ ‖G' y‖ := by
    by_cases hP : sigma1.Nonempty
    · obtain ⟨z, hz, hmin⟩ := IsCompact.exists_isMinOn hsigma1compact hP hnormcont
      refine ⟨min ‖G' z‖ 0.05, lt_min (norm_pos_iff.mpr (hGavoids z hz)) (by norm_num),
        (min_le_right _ _).trans_lt (by norm_num),
        fun y hy => (min_le_left _ _).trans (hmin hy)⟩
    · exact ⟨0.05, by norm_num, by norm_num, fun y hy => absurd ⟨y, hy⟩ hP⟩
  -- Stone–Weierstrass approximation of `G'` on the compact `Σ`.
  obtain ⟨P, hPdiff, hPbound⟩ :=
    diff_approx_on_compact hsigmacompact (G' : ℂ → ℂ) G'.continuous hdlpos
  have h0_notin_image : (0 : ℂ) ∉ P '' sigma1 := by
    rintro ⟨y, hy, hPy⟩
    have hGy : dl ≤ ‖G' y‖ := hdlle y hy
    have hPy0 : ‖P y - G' y‖ < dl := hPbound y (by rw [hsigma]; exact Or.inl hy)
    rw [hPy] at hPy0
    simp only [zero_sub, norm_neg] at hPy0
    linarith
  have hP_image_null : volume (P '' sigma2) = 0 := by
    rw [hsigma2]
    exact MeasureTheory.addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume
      hPdiff.differentiableOn
      (MeasureTheory.Measure.addHaar_sphere_of_ne_zero volume c (ne_of_gt hεpos))
  have hPnormcont : ContinuousOn (fun y => ‖P y‖) sigma1 :=
    (hPdiff.continuous.norm).continuousOn
  obtain ⟨v, hvnorm, hv1, hv2⟩ : ∃ v, ‖v‖ < dl ∧ v ∉ P '' sigma1 ∧ v ∉ P '' sigma2 := by
    rcases sigma1.eq_empty_or_nonempty with hσ1 | hσ1
    · have hnotsub : ¬ ball (0 : ℂ) dl ⊆ P '' sigma2 := by
        intro hsub
        have hle : volume (ball (0 : ℂ) dl) ≤ volume (P '' sigma2) := measure_mono hsub
        rw [hP_image_null] at hle
        exact (not_le.mpr (measure_ball_pos volume (0 : ℂ) hdlpos)) hle
      obtain ⟨v, hv, hv2⟩ := Set.not_subset.mp hnotsub
      exact ⟨v, by rwa [mem_ball_zero_iff] at hv, by simp [hσ1], hv2⟩
    · obtain ⟨d, hd, hdmin⟩ := IsCompact.exists_isMinOn hsigma1compact hσ1 hPnormcont
      have hkpos : 0 < min ‖P d‖ dl :=
        lt_min (norm_pos_iff.mpr (fun h => h0_notin_image ⟨d, hd, h⟩)) hdlpos
      obtain ⟨v, hv, hv2⟩ : ∃ v ∈ ball (0 : ℂ) (min ‖P d‖ dl), v ∉ P '' sigma2 := by
        rw [← Set.not_subset]
        intro hsub
        have hle : volume (ball (0 : ℂ) (min ‖P d‖ dl)) ≤ 0 := by
          rw [← hP_image_null]
          exact measure_mono hsub
        exact (not_lt.mpr hle) (measure_ball_pos volume (0 : ℂ) hkpos)
      refine ⟨v, ?_, ?_, hv2⟩
      · have := mem_ball_zero_iff.mp hv; linarith [this, min_le_right ‖P d‖ dl]
      · rintro ⟨x, hx, hxv⟩
        have hxd : ‖P d‖ ≤ ‖P x‖ := hdmin hx
        rw [hxv] at hxd
        have := mem_ball_zero_iff.mp hv
        linarith [this, hxd, min_le_left ‖P d‖ dl]
  have hv_notin : v ∉ P '' sigma := by
    rw [hsigma, Set.image_union]
    exact fun h => h.elim hv1 hv2
  let Gt : ℂ → ℂ := fun y => P (Phi y) - v
  have hGt_cont : ContinuousOn Gt (f '' closedBall (0 : ℂ) 1) := by
    have h : ContinuousOn ((P - fun _ : ℂ => v) ∘ Phi) (f '' closedBall (0 : ℂ) 1) :=
      (hPdiff.continuous.sub (continuous_const : Continuous fun _ : ℂ => v)).comp_continuousOn
        hPhicont
    have heq : ((P - fun _ : ℂ => v) ∘ Phi) = Gt := by
      funext y; simp only [Function.comp_apply, Pi.sub_apply, Gt]
    rwa [heq] at h
  have hGt_nonzero : ∀ y ∈ f '' closedBall (0 : ℂ) 1, Gt y ≠ 0 := by
    intro y hy h0
    apply hv_notin
    refine ⟨Phi y, hPhiimg y hy, ?_⟩
    have h0' : P (Phi y) - v = 0 := by simpa only [Gt] using h0
    exact sub_eq_zero.mp h0'
  have hbound : ∀ y ∈ f '' closedBall (0 : ℂ) 1, ‖G' y - Gt y‖ ≤ 1 := by
    intro y hy
    by_cases hcase : ε < ‖y - c‖
    · have hPhi : Phi y = y := by
        have hlt1 : ε / ‖y - c‖ < 1 := by
          have hyc : 0 < ‖y - c‖ := hεpos.trans hcase
          rwa [div_lt_one hyc]
        simp only [hPhi, max_eq_right_of_lt hlt1, one_smul, add_sub_cancel]
      have hPy : ‖P y - G' y‖ < dl := hPbound y (by rw [hsigma]; exact Or.inl ⟨hy, hcase.le⟩)
      have hGty : Gt y = P y - v := by simp only [Gt, hPhi]
      rw [hGty]
      calc ‖G' y - (P y - v)‖ = ‖(G' y - P y) + v‖ := by ring_nf
        _ ≤ ‖G' y - P y‖ + ‖v‖ := norm_add_le _ _
        _ = ‖P y - G' y‖ + ‖v‖ := by rw [norm_sub_rev]
        _ ≤ 1 := by linarith
    · push_neg at hcase
      have hy_ne_c : y ≠ c := fun h => hc2 (h ▸ hy)
      have hyc_ne : ‖y - c‖ ≠ 0 := norm_ne_zero_iff.mpr (sub_ne_zero.mpr hy_ne_c)
      have hpos : 0 < ‖y - c‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hy_ne_c)
      have hleft : 1 ≤ ε / ‖y - c‖ := (one_le_div hpos).mpr hcase
      have hPhi_sphere : Phi y ∈ sigma2 := by
        rw [hsigma2, mem_sphere, dist_eq_norm]
        have heq : Phi y - c = (ε / ‖y - c‖) • (y - c) := by
          simp only [hPhi, max_eq_left hleft, add_sub_cancel_left]
        rw [heq, norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (div_nonneg hεpos.le (norm_nonneg _)), div_mul_cancel₀ _ hyc_ne]
      have hPhi_le : ‖Phi y - c‖ = ε := by
        rw [hsigma2] at hPhi_sphere
        rwa [mem_sphere, dist_eq_norm] at hPhi_sphere
      have hPPhi : ‖P (Phi y) - G' (Phi y)‖ < dl :=
        hPbound (Phi y) (by rw [hsigma]; exact Or.inr hPhi_sphere)
      have hsmall_y : ‖G' y‖ ≤ 0.1 := hG_small y hcase
      have hsmall_Phi : ‖G' (Phi y)‖ ≤ 0.1 := hG_small (Phi y) (by rw [hPhi_le])
      have hPnorm : ‖P (Phi y)‖ ≤ dl + 0.1 := by
        calc ‖P (Phi y)‖ = ‖(P (Phi y) - G' (Phi y)) + G' (Phi y)‖ := by ring_nf
          _ ≤ ‖P (Phi y) - G' (Phi y)‖ + ‖G' (Phi y)‖ := norm_add_le _ _
          _ ≤ dl + 0.1 := by linarith
      simp only [Gt]
      calc ‖G' y - (P (Phi y) - v)‖ = ‖(G' y - P (Phi y)) + v‖ := by ring_nf
        _ ≤ ‖G' y - P (Phi y)‖ + ‖v‖ := norm_add_le _ _
        _ ≤ (‖G' y‖ + ‖P (Phi y)‖) + ‖v‖ := by linarith [norm_sub_le (G' y) (P (Phi y))]
        _ ≤ 1 := by linarith
  obtain ⟨y, hy, hy0⟩ := stability Gt hGt_cont hbound
  exact hGt_nonzero y hy hy0

end

end Work.RPB1a.Caratheodory.IOD
