import Mathlib
import Mathlib.Topology.Homotopy.Lifting
import Submission.Commons.Topology.Plane.exists_loop_of_strip_path
import Submission.Commons.Topology.Strip.translate_path_of_two_collared_periodic
import Submission.Commons.Topology.Strip.barrier_bottom_top_of_no_left_right
import Submission.Commons.Topology.Strip.closed_periodic_bounded_away_from_level

namespace Commons.Topology.Plane

open Set Function Filter
open scoped Topology

/-!
# An essential loop in an annulus avoiding a non-spanning closed set

Target: `Commons.Topology.Plane.annulus_essential_loop_of_no_spanning`.

Let `L ⊆ ℂ` be closed, contained in the closed annulus `{ρ ≤ ‖z‖ ≤ ρ'}`, and such that no
preconnected subset of `L` meets both boundary circles.  Then the annulus contains a loop avoiding
`L` which is not nullhomotopic in `ℂ \ {0}`.

## Mathematical content

This is the *annulus duality* (Denné, *Alternating quadrisecants of knots*, arXiv:math/0510561,
Prop. 25, itself a sharpening of the classical "a closed subset of an annulus containing no
continuum joining the two boundary circles has an essential loop in its complement").

## Proof

Let `covS q = q.2 * exp (q.1 * I)` be the covering map `ℝ × [ρ,ρ'] → {ρ ≤ ‖z‖ ≤ ρ'}`, with deck
group generated by `q ↦ (q.1 + 2π, q.2)`, and let `K = covS ⁻¹' L ∩ {ρ ≤ q.2 ≤ ρ'}` be the lift
of `L` to the strip.

Since no preconnected subset of `L` meets both boundary circles, the compact space `L` admits a
*clopen* decomposition `L = U ⊔ Uᶜ` with `L ∩ {‖z‖ = ρ} ⊆ U` and `U ∩ {L ∩ {‖z‖ = ρ'}} = ∅`
(`Commons.Topology.Strip.exists_clopen_separating_of_no_component`, applied to the two circle
slices).  Pulling back to the strip gives two closed, `2π`-periodic, disjoint obstacles
`P = K ∩ covS ⁻¹' U` and `Q = K ∩ covS ⁻¹' Uᶜ` with `P ∩ {q.2 = ρ'} = ∅` and
`Q ∩ {q.2 = ρ} = ∅`; adding the two boundary lines to `P` and `Q` respectively (resp.) and using
`Commons.Topology.Strip.closed_periodic_bounded_away_from_level`, the two obstacles satisfy the
collar hypotheses of the collared annulus duality
`Commons.Topology.Strip.translate_path_of_two_collared_periodic`, which produces a translate path
`z ~ z + (2π,0)` in the strip staying in the *open* strip and avoiding `P ∪ Q = K`.

Finally `Commons.Topology.Plane.exists_loop_of_strip_path` converts this translate path into a loop
`Circle → ℂ \ {0}` avoiding `L`; enlarging `L` by the excluded half-planes `{‖w‖ ≤ ρ}` and
`{ρ' ≤ ‖w‖}` (a closed set) simultaneously certifies that the loop stays in the annulus.
-/

/-- The covering map `q ↦ q.2 * exp (q.1 * I)`; restricted to `ℝ × [ρ,ρ']` it covers the closed
annulus `{ρ ≤ ‖z‖ ≤ ρ'}` with deck group generated by `q ↦ (q.1 + 2π, q.2)`. -/
noncomputable def covS (q : ℝ × ℝ) : ℂ := (q.2 : ℂ) * Complex.exp ((q.1 : ℂ) * Complex.I)

lemma continuous_covS : Continuous covS := by unfold covS; fun_prop

lemma norm_covS (q : ℝ × ℝ) : ‖covS q‖ = |q.2| := by
  unfold covS
  rw [norm_mul, Complex.norm_exp, Complex.mul_I_re, Complex.ofReal_im, neg_zero,
    Real.exp_zero, mul_one, Complex.norm_real, Real.norm_eq_abs]

lemma covS_add_two_pi (q : ℝ × ℝ) : covS (q.1 + 2 * Real.pi, q.2) = covS q := by
  unfold covS
  have h : (((q.1 + 2 * Real.pi : ℝ)) : ℂ) * Complex.I
      = (q.1 : ℂ) * Complex.I + (((2 * Real.pi : ℝ)) : ℂ) * Complex.I := by push_cast; ring
  rw [h, Complex.exp_add]
  have h2 : Complex.exp ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I) = 1 := by
    rw [show ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I) = 2 * (Real.pi : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.exp_two_pi_mul_I
  rw [h2, mul_one]

lemma covS_ne_zero {ρ : ℝ} (hρ : 0 < ρ) {q : ℝ × ℝ} (hq : ρ ≤ q.2) : covS q ≠ 0 := by
  rw [← norm_pos_iff, norm_covS, abs_of_nonneg (le_trans hρ.le hq)]
  linarith

theorem annulus_essential_loop_of_no_spanning {L : Set ℂ} (hL : IsClosed L) {ρ ρ' : ℝ}
    (hρ : 0 < ρ) (hρρ' : ρ < ρ')
    (hsub : L ⊆ {z : ℂ | ρ ≤ ‖z‖ ∧ ‖z‖ ≤ ρ'})
    (hjoin : ∀ C : Set ℂ, C ⊆ L → IsPreconnected C →
      (C ∩ {z : ℂ | ‖z‖ = ρ}).Nonempty → (C ∩ {z : ℂ | ‖z‖ = ρ'}).Nonempty → False) :
    ∃ γ : C(Circle, {z : ℂ // z ≠ 0}),
      (∀ t, ρ ≤ ‖(γ t : ℂ)‖ ∧ ‖(γ t : ℂ)‖ ≤ ρ' ∧ (γ t : ℂ) ∉ L) ∧ ¬ γ.Nullhomotopic := by
  have hpi : (0 : ℝ) < 2 * Real.pi := by positivity
  -- the lift of `L` to the strip
  set K : Set (ℝ × ℝ) := covS ⁻¹' L ∩ {q : ℝ × ℝ | ρ ≤ q.2 ∧ q.2 ≤ ρ'} with hKdef
  have hKmem : ∀ q : ℝ × ℝ, q ∈ K ↔ covS q ∈ L ∧ ρ ≤ q.2 ∧ q.2 ≤ ρ' := by
    intro q
    simp only [hKdef, Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq]
  have hKclosed : IsClosed K := by
    rw [hKdef]
    exact (hL.preimage continuous_covS).inter (isClosed_Icc.preimage continuous_snd)
  have hKper : ∀ q : ℝ × ℝ, q ∈ K ↔ (q.1 + 2 * Real.pi, q.2) ∈ K := by
    intro q
    rw [hKmem q, hKmem (q.1 + 2 * Real.pi, q.2), covS_add_two_pi q]
  have hKsub : K ⊆ {q : ℝ × ℝ | ρ ≤ q.2 ∧ q.2 ≤ ρ'} := fun q hq => (hKmem q).mp hq |>.2
  -- `L` is compact
  have hLcpt : IsCompact L := by
    refine Metric.isCompact_iff_isClosed_bounded.mpr ⟨hL, ?_⟩
    refine Bornology.IsBounded.subset (Metric.isBounded_closedBall (x := (0 : ℂ)) (r := ρ')) ?_
    intro z hz
    rw [Metric.mem_closedBall, dist_zero_right]
    exact (hsub hz).2
  haveI : CompactSpace ↥L := isCompact_iff_compactSpace.mp hLcpt
  -- the two circle slices of `L`
  set Cc : Set ↥L := Subtype.val ⁻¹' {z : ℂ | ‖z‖ = ρ} with hCcdef
  set Dd : Set ↥L := Subtype.val ⁻¹' {z : ℂ | ‖z‖ = ρ'} with hDddef
  have hCccl : IsClosed Cc := by
    rw [hCcdef]
    exact (isClosed_eq continuous_norm continuous_const).preimage continuous_subtype_val
  have hDdcl : IsClosed Dd := by
    rw [hDddef]
    exact (isClosed_eq continuous_norm continuous_const).preimage continuous_subtype_val
  have hdec : ∀ z : ↥L,
      ¬ ((connectedComponent z ∩ Cc).Nonempty ∧ (connectedComponent z ∩ Dd).Nonempty) := by
    rintro z ⟨⟨w, hw1, hw2⟩, ⟨v, hv1, hv2⟩⟩
    have hw2' : ‖(w : ℂ)‖ = ρ := hw2
    have hv2' : ‖(v : ℂ)‖ = ρ' := hv2
    exact hjoin (Subtype.val '' connectedComponent z)
      (by rintro _ ⟨a, -, rfl⟩; exact a.2)
      (isPreconnected_connectedComponent.image _ continuous_subtype_val.continuousOn)
      ⟨(w : ℂ), ⟨⟨w, hw1, rfl⟩, hw2'⟩⟩
      ⟨(v : ℂ), ⟨⟨v, hv1, rfl⟩, hv2'⟩⟩
  obtain ⟨U, hUcl, hUC, hUD⟩ :=
    Commons.Topology.Strip.exists_clopen_separating_of_no_component hCccl hDdcl hdec
  -- the two obstacles
  set P : Set (ℝ × ℝ) := K ∩ covS ⁻¹' (Subtype.val '' U) with hPdef
  set Q : Set (ℝ × ℝ) := K ∩ covS ⁻¹' (Subtype.val '' Uᶜ) with hQdef
  have hUimgcl : IsClosed (Subtype.val '' U) :=
    (hUcl.isClosed.isCompact.image continuous_subtype_val).isClosed
  have hUcimgcl : IsClosed (Subtype.val '' Uᶜ) :=
    (hUcl.compl.isClosed.isCompact.image continuous_subtype_val).isClosed
  have hPclosed : IsClosed P := by
    rw [hPdef]; exact hKclosed.inter (hUimgcl.preimage continuous_covS)
  have hQclosed : IsClosed Q := by
    rw [hQdef]; exact hKclosed.inter (hUcimgcl.preimage continuous_covS)
  have hPsub : P ⊆ {q : ℝ × ℝ | ρ ≤ q.2 ∧ q.2 ≤ ρ'} := fun q hq => hKsub (hPdef ▸ hq).1
  have hQsub : Q ⊆ {q : ℝ × ℝ | ρ ≤ q.2 ∧ q.2 ≤ ρ'} := fun q hq => hKsub (hQdef ▸ hq).1
  have hPper : ∀ q : ℝ × ℝ, q ∈ P ↔ (q.1 + 2 * Real.pi, q.2) ∈ P := by
    intro q
    rw [hPdef]
    constructor
    · rintro ⟨hK, hU⟩
      exact ⟨(hKper q).mp hK, by simpa [covS_add_two_pi q] using hU⟩
    · rintro ⟨hK, hU⟩
      exact ⟨(hKper q).mpr hK, by simpa [covS_add_two_pi q] using hU⟩
  have hQper : ∀ q : ℝ × ℝ, q ∈ Q ↔ (q.1 + 2 * Real.pi, q.2) ∈ Q := by
    intro q
    rw [hQdef]
    constructor
    · rintro ⟨hK, hU⟩
      exact ⟨(hKper q).mp hK, by simpa [covS_add_two_pi q] using hU⟩
    · rintro ⟨hK, hU⟩
      exact ⟨(hKper q).mpr hK, by simpa [covS_add_two_pi q] using hU⟩
  have hdisj : Disjoint P Q := by
    rw [Set.disjoint_left]
    rintro q ⟨-, hqU⟩ ⟨-, hqU'⟩
    obtain ⟨u, huU, hu⟩ := hqU
    obtain ⟨v, hvUc, hv⟩ := hqU'
    have huv : u = v := Subtype.ext (by rw [hu, hv])
    rw [huv] at huU
    exact hvUc huU
  have hPQ : P ∪ Q = K := by
    ext q
    constructor
    · rintro (h | h)
      · exact (hPdef ▸ h).1
      · exact (hQdef ▸ h).1
    · intro hq
      obtain ⟨hcov, -⟩ := (hKmem q).mp hq
      by_cases hU : (⟨covS q, hcov⟩ : ↥L) ∈ U
      · exact Or.inl ⟨hq, ⟨⟨covS q, hcov⟩, hU, rfl⟩⟩
      · exact Or.inr ⟨hq, ⟨⟨covS q, hcov⟩, hU, rfl⟩⟩
  -- the top / bottom avoidance
  have hPtop : ∀ q : ℝ × ℝ, q ∈ P → q.2 ≠ ρ' := by
    rintro q ⟨-, hqU⟩ hq2
    obtain ⟨u, huU, hu⟩ := hqU
    have hnorm : ‖(u : ℂ)‖ = ρ' := by rw [hu, norm_covS, hq2, abs_of_pos (lt_trans hρ hρρ')]
    have huD : u ∈ Dd := hnorm
    exact (Set.eq_empty_iff_forall_notMem.mp hUD) u ⟨huU, huD⟩
  have hQbot : ∀ q : ℝ × ℝ, q ∈ Q → q.2 ≠ ρ := by
    rintro q ⟨-, hqU⟩ hq2
    obtain ⟨u, huU, hu⟩ := hqU
    have hnorm : ‖(u : ℂ)‖ = ρ := by rw [hu, norm_covS, hq2, abs_of_pos hρ]
    have huC : u ∈ Cc := hnorm
    exact huU (hUC huC)
  -- collars
  obtain ⟨ε₀, hε₀pos, hε₀⟩ := Commons.Topology.Strip.closed_periodic_bounded_away_from_level
    (p := 2 * Real.pi) (a := ρ) (b := ρ') (c := ρ') hpi hρρ' hPclosed hPsub hPper hPtop
  obtain ⟨δ₀, hδ₀pos, hδ₀⟩ := Commons.Topology.Strip.closed_periodic_bounded_away_from_level
    (p := 2 * Real.pi) (a := ρ) (b := ρ') (c := ρ) hpi hρρ' hQclosed hQsub hQper hQbot
  set ε : ℝ := min ε₀ ((ρ' - ρ) / 2) with hεdef
  set δ : ℝ := min δ₀ ((ρ' - ρ) / 2) with hδdef
  have hεle : ε ≤ ε₀ := by rw [hεdef]; exact min_le_left _ _
  have hδle : δ ≤ δ₀ := by rw [hδdef]; exact min_le_left _ _
  have hεlt : ε ≤ (ρ' - ρ) / 2 := by rw [hεdef]; exact min_le_right _ _
  have hδlt : δ ≤ (ρ' - ρ) / 2 := by rw [hδdef]; exact min_le_right _ _
  have hεpos : 0 < ε := lt_min hε₀pos (by linarith)
  have hδpos : 0 < δ := lt_min hδ₀pos (by linarith)
  have hPtop' : P ⊆ {q : ℝ × ℝ | q.2 ≤ ρ' - ε} := by
    intro q hq
    show q.2 ≤ ρ' - ε
    rcases hε₀ q hq with h | h
    · linarith
    · exfalso; linarith [(hPsub hq).2, h, hε₀pos]
  have hQbot' : Q ⊆ {q : ℝ × ℝ | ρ + δ ≤ q.2} := by
    intro q hq
    show ρ + δ ≤ q.2
    rcases hδ₀ q hq with h | h
    · exfalso; linarith [(hQsub hq).1, h, hδ₀pos]
    · linarith
  -- the boundary lines are added to make the resulting translate path stay in the *open* strip
  set P' : Set (ℝ × ℝ) := P ∪ {q : ℝ × ℝ | q.2 = ρ} with hP'def
  set Q' : Set (ℝ × ℝ) := Q ∪ {q : ℝ × ℝ | q.2 = ρ'} with hQ'def
  have hP'closed : IsClosed P' := by
    rw [hP'def]; exact hPclosed.union (isClosed_eq continuous_snd continuous_const)
  have hQ'closed : IsClosed Q' := by
    rw [hQ'def]; exact hQclosed.union (isClosed_eq continuous_snd continuous_const)
  have hP'sub : P' ⊆ {q : ℝ × ℝ | ρ ≤ q.2 ∧ q.2 ≤ ρ'} := by
    rintro q (hq | hq)
    · exact hPsub hq
    · have h2 : q.2 = ρ := hq
      exact ⟨le_of_eq h2.symm, le_trans (le_of_eq h2) hρρ'.le⟩
  have hQ'sub : Q' ⊆ {q : ℝ × ℝ | ρ ≤ q.2 ∧ q.2 ≤ ρ'} := by
    rintro q (hq | hq)
    · exact hQsub hq
    · have h2 : q.2 = ρ' := hq
      exact ⟨le_trans hρρ'.le (le_of_eq h2.symm), le_of_eq h2⟩
  have hP'per : ∀ q : ℝ × ℝ, q ∈ P' ↔ (q.1 + 2 * Real.pi, q.2) ∈ P' := by
    intro q
    rw [hP'def]
    constructor
    · rintro (h | h)
      · exact Or.inl ((hPper q).mp h)
      · exact Or.inr h
    · rintro (h | h)
      · exact Or.inl ((hPper q).mpr h)
      · exact Or.inr h
  have hQ'per : ∀ q : ℝ × ℝ, q ∈ Q' ↔ (q.1 + 2 * Real.pi, q.2) ∈ Q' := by
    intro q
    rw [hQ'def]
    constructor
    · rintro (h | h)
      · exact Or.inl ((hQper q).mp h)
      · exact Or.inr h
    · rintro (h | h)
      · exact Or.inl ((hQper q).mpr h)
      · exact Or.inr h
  have hdisj' : Disjoint P' Q' := by
    rw [Set.disjoint_left]
    rintro q (hq | hq) (hq' | hq')
    · exact (Set.disjoint_left.mp hdisj) hq hq'
    · exact hPtop q hq hq'
    · exact hQbot q hq' hq
    · exact absurd (hq.symm.trans hq') (ne_of_lt hρρ')
  have hP'top : P' ⊆ {q : ℝ × ℝ | q.2 ≤ ρ' - ε} := by
    rintro q (hq | hq)
    · exact hPtop' hq
    · have h2 : q.2 = ρ := hq
      show q.2 ≤ ρ' - ε
      rw [h2]; linarith [hεlt, hεpos]
  have hQ'bot : Q' ⊆ {q : ℝ × ℝ | ρ + δ ≤ q.2} := by
    rintro q (hq | hq)
    · exact hQbot' hq
    · have h2 : q.2 = ρ' := hq
      show ρ + δ ≤ q.2
      rw [h2]; linarith [hδlt, hδpos]
  -- the collared annulus duality
  obtain ⟨z, hz1, hz2, hznot, γ, hγ0, hγ1, hγstrip, hγavoid⟩ :=
    Commons.Topology.Strip.translate_path_of_two_collared_periodic (p := 2 * Real.pi)
      (a := ρ) (b := ρ') (ε := ε) (δ := δ) hpi hρρ' hεpos hδpos hP'closed hQ'closed
      hP'sub hQ'sub hdisj' hP'per hQ'per hP'top hQ'bot
  -- the translate path stays in the open strip
  have hγstrict : ∀ t, ρ < (γ t).2 ∧ (γ t).2 < ρ' := by
    intro t
    have h := hγavoid t
    have h1 : (γ t).2 ≠ ρ := fun h2 => h (Or.inl (Or.inr h2))
    have h2 : (γ t).2 ≠ ρ' := fun h3 => h (Or.inr (Or.inr h3))
    exact ⟨lt_of_le_of_ne (hγstrip t).1 (Ne.symm h1), lt_of_le_of_ne (hγstrip t).2 h2⟩
  have hγpos : ∀ t, 0 < (γ t).2 := fun t => lt_trans hρ (hγstrict t).1
  have hnotK : ∀ t, γ t ∉ K := by
    intro t hK
    have h : γ t ∈ P ∪ Q := hPQ ▸ hK
    rcases h with h | h
    · exact hγavoid t (Or.inl (Or.inl h))
    · exact hγavoid t (Or.inr (Or.inl h))
  -- the enlarged obstacle: `L` together with the excluded half-planes
  set M : Set ℂ := L ∪ {w : ℂ | ‖w‖ ≤ ρ} ∪ {w : ℂ | ρ' ≤ ‖w‖} with hMdef
  have hMclosed : IsClosed M := by
    rw [hMdef]
    exact (hL.union (isClosed_le continuous_norm continuous_const)).union
      (isClosed_le continuous_const continuous_norm)
  have hMavoid : ∀ t, covS (γ t) ∉ M := by
    intro t hM
    have hnorm : ‖covS (γ t)‖ = (γ t).2 := by rw [norm_covS, abs_of_pos (hγpos t)]
    rcases hM with (hM | hM) | hM
    · exact hnotK t ((hKmem (γ t)).mpr ⟨hM, (hγstrip t).1, (hγstrip t).2⟩)
    · have hle : ‖covS (γ t)‖ ≤ ρ := hM
      rw [hnorm] at hle
      exact absurd hle (not_le.mpr (hγstrict t).1)
    · have hge : ρ' ≤ ‖covS (γ t)‖ := hM
      rw [hnorm] at hge
      exact absurd hge (not_le.mpr (hγstrict t).2)
  have hper1 : (γ 1).1 = (γ 0).1 + 2 * Real.pi := by rw [hγ0, hγ1]
  have hper2 : (γ 1).2 = (γ 0).2 := by rw [hγ0, hγ1]
  obtain ⟨γ', hγ'M, hγ'ess⟩ :=
    exists_loop_of_strip_path hMclosed γ hper1 hper2 hγpos hMavoid
  refine ⟨γ', ?_, hγ'ess⟩
  intro t
  have hnot := hγ'M t
  refine ⟨?_, ?_, ?_⟩
  · by_contra h
    push Not at h
    exact hnot (Or.inl (Or.inr (le_of_lt h)))
  · by_contra h
    push Not at h
    exact hnot (Or.inr (le_of_lt h))
  · intro h
    exact hnot (Or.inl (Or.inl h))

end Commons.Topology.Plane
