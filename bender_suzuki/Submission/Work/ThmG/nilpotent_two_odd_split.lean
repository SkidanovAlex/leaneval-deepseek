/-!
# The `2`-part / odd-part splitting of a finite nilpotent subgroup

Let `Q ≤ G` be a finite nilpotent subgroup.

* `Work.ThmG.twoPart Q = O_2(Q)` is the subgroup generated by the elements of `Q` of `2`-power
  order; since `Q` is nilpotent its Sylow `2`-subgroup is normal, hence unique, and every
  `2`-element of `Q` lies in it.  So `twoPart Q` is the image in `G` of the Sylow `2`-subgroup
  (`twoPart_eq_map_sylow_two`).
* `Work.ThmG.oddPart Q = O_{2'}(Q)` is the subgroup generated by the elements of `Q` of odd order.
  Since `Q` is nilpotent there is a normal subgroup `N ⊴ Q` of index `|Sylow 2|` (Mathlib's
  `Group.IsNilpotent.exists_normal_index_eq_of_dvd_card`), and the odd-order elements of `Q` are
  exactly the elements of `N` (`odd_mem_iff_mem_of_index_eq_card_sylow_two`); hence
  `oddPart Q` is the image of `N` and has odd order.

The two subgroups therefore form an internal direct product decomposition
`Q = O_2(Q) × O_{2'}(Q)` with mutually commuting factors: this is what the theorem records.
-/

namespace Work.ThmG

/-- A finite nilpotent subgroup `Q` splits as the direct product of its `2`-part `O_2(Q)` and its
odd part `O_{2'}(Q)`: they generate `Q`, meet trivially, commute elementwise, have coprime orders,
`O_{2'}(Q)` has odd order, `O_2(Q)` is nilpotent (it is a `2`-group), the orders multiply to
`|Q|`, and `O_{2'}(Q) = 1` forces `Q` to be a `2`-group. -/
theorem nilpotent_two_odd_split {G : Type*} [Group G] (Q : Subgroup G) [Finite Q]
    (hQ : Group.IsNilpotent Q) :
    Work.ThmG.twoPart Q ⊔ Work.ThmG.oddPart Q = Q ∧
      Work.ThmG.twoPart Q ⊓ Work.ThmG.oddPart Q = ⊥ ∧
      (∀ a ∈ Work.ThmG.twoPart Q, ∀ b ∈ Work.ThmG.oddPart Q, a * b = b * a) ∧
      Nat.Coprime (Nat.card (Work.ThmG.twoPart Q)) (Nat.card (Work.ThmG.oddPart Q)) ∧
      Odd (Nat.card (Work.ThmG.oddPart Q)) ∧ Group.IsNilpotent (Work.ThmG.twoPart Q) ∧
      Nat.card (Work.ThmG.twoPart Q) * Nat.card (Work.ThmG.oddPart Q) = Nat.card Q ∧
      (¬ IsPGroup 2 Q → Work.ThmG.oddPart Q ≠ ⊥) := by
  classical
  haveI h2 : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI hQnil : Group.IsNilpotent Q := hQ
  -- `P`: the (unique) Sylow `2`-subgroup of the nilpotent group `Q`
  let P : Sylow 2 Q := Classical.arbitrary _
  haveI hPnorm : ((P : Subgroup Q)).Normal := inferInstance
  -- `N`: the normal subgroup of `Q` of index `|P|`
  have hdvd : Nat.card P ∣ Nat.card Q := Subgroup.card_subgroup_dvd_card (P : Subgroup Q)
  obtain ⟨N, hNidx, hNnorm⟩ := Group.IsNilpotent.exists_normal_index_eq_of_dvd_card hdvd
  haveI : N.Normal := hNnorm
  -- `twoPart Q` is the image of `P`
  have htwo : Work.ThmG.twoPart Q = (P : Subgroup Q).map Q.subtype :=
    twoPart_eq_map_sylow_two Q hQ P
  -- the odd-order elements of `Q` are exactly the elements of `N`
  obtain ⟨hNodd, hiff⟩ := odd_mem_iff_mem_of_index_eq_card_sylow_two P N hNnorm hNidx
  -- `oddPart Q` is the image of `N`
  have hodd : Work.ThmG.oddPart Q = N.map Q.subtype := by
    refine le_antisymm ?_ ?_
    · rw [Work.ThmG.oddPart]
      refine (Subgroup.closure_le _).mpr ?_
      rintro x ⟨hxQ, hxodd⟩
      have hord : Odd (orderOf (⟨x, hxQ⟩ : Q)) := by
        rw [← Subgroup.orderOf_coe (H := Q) (⟨x, hxQ⟩ : Q)]
        exact hxodd
      exact ⟨⟨x, hxQ⟩, (hiff ⟨x, hxQ⟩).mp hord, rfl⟩
    · rintro x ⟨n, hn, rfl⟩
      refine Subgroup.subset_closure ⟨n.2, ?_⟩
      have hnodd : Odd (orderOf n) := (hiff n).mpr hn
      simpa using hnodd
  have hcardP : Nat.card ↥((P : Subgroup Q)) = 2 ^ (Nat.card Q).factorization 2 :=
    Sylow.card_eq_multiplicity P
  have hcard_two : Nat.card ↥(Work.ThmG.twoPart Q) = Nat.card ↥((P : Subgroup Q)) := by
    rw [htwo, Subgroup.card_map_of_injective Q.subtype_injective]
  have hcard_odd : Nat.card ↥(Work.ThmG.oddPart Q) = Nat.card ↥N := by
    rw [hodd, Subgroup.card_map_of_injective Q.subtype_injective]
  have hmul' : Nat.card ↥N * Nat.card ↥((P : Subgroup Q)) = Nat.card Q := by
    rw [← hNidx]; exact Subgroup.card_mul_index N
  have hmul : Nat.card ↥((P : Subgroup Q)) * Nat.card ↥N = Nat.card Q := by
    rw [Nat.mul_comm]; exact hmul'
  have hcopNP : Nat.Coprime (Nat.card ↥((P : Subgroup Q))) (Nat.card ↥N) := by
    rw [hcardP]
    exact (Nat.coprime_two_left.mpr hNodd).pow_left _
  have hNP : N ⊓ (P : Subgroup Q) = ⊥ := by
    rw [Subgroup.eq_bot_iff_card]
    have h1 : Nat.card ↥(N ⊓ (P : Subgroup Q)) ∣ Nat.card ↥((P : Subgroup Q)) :=
      Subgroup.card_dvd_of_le inf_le_right
    have h2 : Nat.card ↥(N ⊓ (P : Subgroup Q)) ∣ Nat.card ↥N :=
      Subgroup.card_dvd_of_le inf_le_left
    have hd : Nat.card ↥(N ⊓ (P : Subgroup Q)) ∣ 1 := by
      rw [← hcopNP.gcd_eq_one]
      exact Nat.dvd_gcd h1 h2
    exact Nat.dvd_one.mp hd
  -- the product map `N × P → Q` is bijective, so every element of `Q` factors as `n * p`
  have hinj : Function.Injective
      (fun z : ↥N × ↥((P : Subgroup Q)) => ((z.1 : Q) * (z.2 : Q) : Q)) := by
    rintro ⟨n1, p1⟩ ⟨n2, p2⟩ h
    have h' : (n1 : Q) * (p1 : Q) = (n2 : Q) * (p2 : Q) := h
    have heq : (n2 : Q)⁻¹ * (n1 : Q) = (p2 : Q) * (p1 : Q)⁻¹ := by
      calc (n2 : Q)⁻¹ * (n1 : Q)
          = (n2 : Q)⁻¹ * ((n1 : Q) * (p1 : Q)) * (p1 : Q)⁻¹ := by group
        _ = (n2 : Q)⁻¹ * ((n2 : Q) * (p2 : Q)) * (p1 : Q)⁻¹ := by rw [h']
        _ = (p2 : Q) * (p1 : Q)⁻¹ := by group
    have hmemN : (n2 : Q)⁻¹ * (n1 : Q) ∈ N := N.mul_mem (N.inv_mem n2.2) n1.2
    have hmemP : (n2 : Q)⁻¹ * (n1 : Q) ∈ (P : Subgroup Q) := by
      rw [heq]; exact (P : Subgroup Q).mul_mem p2.2 ((P : Subgroup Q).inv_mem p1.2)
    have hone : (n2 : Q)⁻¹ * (n1 : Q) = 1 := by
      have : (n2 : Q)⁻¹ * (n1 : Q) ∈ (⊥ : Subgroup Q) := by
        rw [← hNP]; exact ⟨hmemN, hmemP⟩
      simpa using this
    have hn : (n1 : Q) = (n2 : Q) := by
      rw [← mul_inv_cancel_left (n2 : Q) (n1 : Q), hone, mul_one]
    have hp : (p2 : Q) * (p1 : Q)⁻¹ = 1 := by rw [← heq]; exact hone
    refine Prod.ext (Subtype.ext hn) (Subtype.ext ?_)
    exact (mul_inv_eq_one.mp hp).symm
  have hsurj : ∀ x : Q, ∃ n : ↥N, ∃ p : ↥((P : Subgroup Q)), (n : Q) * (p : Q) = x := by
    intro x
    have hfr : Function.Injective
        (fun z : ↥N × ↥((P : Subgroup Q)) => ((z.1 : Q) * (z.2 : Q) : Q)) := hinj
    have hrange : Set.range
        (fun z : ↥N × ↥((P : Subgroup Q)) => ((z.1 : Q) * (z.2 : Q) : Q)) = Set.univ := by
      refine Set.eq_of_subset_of_ncard_le (Set.subset_univ _) ?_
      rw [Set.ncard_univ, Set.ncard_range_of_injective hfr, Nat.card_prod, hmul']
    have hx : x ∈ Set.range
        (fun z : ↥N × ↥((P : Subgroup Q)) => ((z.1 : Q) * (z.2 : Q) : Q)) :=
      hrange.symm ▸ Set.mem_univ x
    obtain ⟨z, hz⟩ := hx
    exact ⟨z.1, z.2, hz⟩
  -- elements of the `2`-part and of the odd part commute
  have hcomm : ∀ a ∈ Work.ThmG.twoPart Q, ∀ b ∈ Work.ThmG.oddPart Q, a * b = b * a := by
    intro a ha b hb
    rw [htwo] at ha
    rw [hodd] at hb
    obtain ⟨p, hp, rfl⟩ := ha
    obtain ⟨n, hn, rfl⟩ := hb
    obtain ⟨k, hk⟩ := IsPGroup.iff_orderOf.mp P.isPGroup' (⟨p, hp⟩ : ↥((P : Subgroup Q)))
    have hpk : orderOf p = 2 ^ k :=
      (Subgroup.orderOf_coe (H := (P : Subgroup Q)) (⟨p, hp⟩ : ↥((P : Subgroup Q)))).trans hk
    have hnk : Odd (orderOf n) := (hiff n).mpr hn
    have hord : (orderOf p).Coprime (orderOf n) := by
      rw [hpk]
      exact (Nat.coprime_two_left.mpr hnk).pow_left k
    have hc := Group.IsNilpotent.commute_of_orderOf_coprime (x := p) (y := n) hord
    simpa using congrArg (fun z : Q => Q.subtype z) hc.eq
  have hinf : Work.ThmG.twoPart Q ⊓ Work.ThmG.oddPart Q = ⊥ := by
    rw [Subgroup.eq_bot_iff_card]
    have h1 : Nat.card ↥(Work.ThmG.twoPart Q ⊓ Work.ThmG.oddPart Q) ∣
        Nat.card ↥(Work.ThmG.twoPart Q) := Subgroup.card_dvd_of_le inf_le_left
    have h2 : Nat.card ↥(Work.ThmG.twoPart Q ⊓ Work.ThmG.oddPart Q) ∣
        Nat.card ↥(Work.ThmG.oddPart Q) := Subgroup.card_dvd_of_le inf_le_right
    rw [hcard_two] at h1
    rw [hcard_odd] at h2
    have hd : Nat.card ↥(Work.ThmG.twoPart Q ⊓ Work.ThmG.oddPart Q) ∣ 1 := by
      rw [← hcopNP.gcd_eq_one]
      exact Nat.dvd_gcd h1 h2
    exact Nat.dvd_one.mp hd
  have hsup : Work.ThmG.twoPart Q ⊔ Work.ThmG.oddPart Q = Q := by
    refine le_antisymm (sup_le (Work.ThmG.twoPart_le Q) (Work.ThmG.oddPart_le Q)) ?_
    intro x hx
    obtain ⟨n, p, hnp⟩ := hsurj ⟨x, hx⟩
    have hn : ((n : Q) : G) ∈ Work.ThmG.oddPart Q := by
      rw [hodd]; exact ⟨(n : Q), n.2, rfl⟩
    have hp : ((p : Q) : G) ∈ Work.ThmG.twoPart Q := by
      rw [htwo]; exact ⟨(p : Q), p.2, rfl⟩
    have hnpG : ((n : Q) : G) * ((p : Q) : G) = x := congrArg (fun z : Q => (z : G)) hnp
    rw [← hnpG, sup_comm]
    exact Subgroup.mul_mem_sup hn hp
  have hnil : Group.IsNilpotent ↥(Work.ThmG.twoPart Q) := by
    haveI : Group.IsNilpotent ↥((P : Subgroup Q)) := IsPGroup.isNilpotent P.isPGroup'
    rw [htwo]
    exact Group.nilpotent_of_mulEquiv
      ((P : Subgroup Q).equivMapOfInjective Q.subtype Q.subtype_injective)
  have hcop : Nat.Coprime (Nat.card ↥(Work.ThmG.twoPart Q))
      (Nat.card ↥(Work.ThmG.oddPart Q)) := by
    rw [hcard_two, hcard_odd]; exact hcopNP
  have hoddodd : Odd (Nat.card ↥(Work.ThmG.oddPart Q)) := by
    rw [hcard_odd]; exact hNodd
  have hcardmul : Nat.card ↥(Work.ThmG.twoPart Q) * Nat.card ↥(Work.ThmG.oddPart Q) =
      Nat.card Q := by
    rw [hcard_two, hcard_odd]; exact hmul
  have hnonp : ¬ IsPGroup 2 Q → Work.ThmG.oddPart Q ≠ ⊥ := by
    intro hnot hbot
    rw [Subgroup.eq_bot_iff_card] at hbot
    rw [hcard_odd] at hbot
    apply hnot
    exact IsPGroup.of_card (n := (Nat.card Q).factorization 2) (by
      calc Nat.card Q = Nat.card ↥N * Nat.card ↥((P : Subgroup Q)) := hmul'.symm
        _ = Nat.card ↥((P : Subgroup Q)) := by rw [hbot]; exact one_mul _
        _ = 2 ^ (Nat.card Q).factorization 2 := hcardP)
  exact ⟨hsup, hinf, hcomm, hcop, hoddodd, hnil, hcardmul, hnonp⟩

end Work.ThmG
