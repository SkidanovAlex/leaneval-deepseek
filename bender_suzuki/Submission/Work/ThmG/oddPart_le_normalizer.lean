namespace Work.ThmG

/-- A subgroup normalizing `Q` normalizes the generating set of `oddPart Q`: conjugation
preserves element orders, and it preserves `Q` by hypothesis. -/
theorem le_normalizer_oddPart_gen {G : Type*} [Group G] {H Q : Subgroup G}
    (hN : H ≤ Subgroup.normalizer (Q : Set G)) :
    H ≤ Subgroup.normalizer ({x : G | x ∈ Q ∧ Odd (orderOf x)} : Set G) := by
  rw [Subgroup.le_set_normalizer_iff]
  intro h hh x hx
  refine ⟨(hN hh x).mp hx.1, ?_⟩
  rw [← MulAut.conj_apply h x, (MulAut.conj h).orderOf_eq]
  exact hx.2

/-- **`H` normalizes the odd part of `Q` whenever it normalizes `Q`.**

`oddPart Q = O_{2'}(Q)` is generated by the odd-order elements of `Q`, and conjugation by an
element `h ∈ H` maps that generating set into itself: it maps `Q` into `Q` because
`H ≤ N(Q)`, and it preserves element orders.  Hence `h` normalizes the subgroup that
generating set spans (Mathlib's `Subgroup.normalizer_le_normalizer_closure`). -/
theorem oddPart_le_normalizer {G : Type*} [Group G] {H Q : Subgroup G}
    (hN : H ≤ Subgroup.normalizer (Q : Set G)) :
    H ≤ Subgroup.normalizer ((Work.ThmG.oddPart Q : Subgroup G) : Set G) :=
  (le_normalizer_oddPart_gen hN).trans (Subgroup.normalizer_le_normalizer_closure _)

end Work.ThmG
