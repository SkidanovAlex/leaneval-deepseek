/-!
# Area `ThmG`: Peterfalvi II, Ch. VI §1, Théorème G — vocabulary

`ThmGProp` (Peterfalvi II, Théorème G, p. 257) says: in a simple group `G` in situation
(B0)–(B2) with split rank-one data `H = Q ⋊ D`, `t ∉ H`, `D = H ∩ Hᵗ`, if `G` is *not* a
Zassenhaus group (`V = C_D(t) ≠ 1`) and centralisers of the prime-order subgroups of `V` have
2-rank `≥ 2` (hypothesis (B3)), then `Q` is a 2-group.

The proof of the paper runs: suppose `Q₁ = O_{2'}(Q) ≠ 1`; then `D` acts fixed-point-freely on
`Q₁`, `Q` is TI and nilpotent, so Feit–Sibley (App. XII) applies to `Q = S × Q₁`; the coherence
of `𝒮 = {χ ∈ Irr H | Q₁ ⊄ ker χ}` together with a norm-two character `λ` of `H` induces a degree
count in `Irr G` producing an irreducible constituent `f` of `Ind_H^G λ` with `Q₁ ⊆ ker f`, whose
kernel is then a non-trivial proper normal subgroup of the simple group `G`.

This file fixes the two notions of the reduction (`O_2` and `O_{2'}`, for the subgroups `S` and
`Q₁`) and the bundle of structural inputs of Chapters I, II and V that the argument consumes and
that the current area `Prop`s do not expose; see `RankOneStructure` below.

Notation of the paper: `D = H ∩ H^t = twoPoint H t`, `V = C_D(t) = centD H t`,
`K = J(D,t) = invertedBy (twoPoint H t) t`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

noncomputable section

open Classical
open LeanEval.GroupTheory.Defs

namespace Work.ThmG

open Submission.Blueprint

variable {G : Type*} [Group G]

/-- `O_2(X)`: the subgroup generated by the elements of `X` of 2-power order.  For a finite
nilpotent `X` this is the unique Sylow 2-subgroup `O_2(X)`, the 2-part of `X`. -/
def twoPart (X : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ X ∧ ∃ n : ℕ, x ^ 2 ^ n = 1}

/-- `O_{2'}(X)`: the subgroup generated by the odd-order elements of `X`.  For a finite
nilpotent `X` this is `O_{2'}(X)`, the Hall `2'`-subgroup of `X`, called `Q₁` in the paper. -/
def oddPart (X : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ X ∧ Odd (orderOf x)}

theorem twoPart_le (X : Subgroup G) : twoPart X ≤ X :=
  (Subgroup.closure_le X).mpr fun _ hx => hx.1

theorem oddPart_le (X : Subgroup G) : oddPart X ≤ X :=
  (Subgroup.closure_le X).mpr fun _ hx => hx.1

theorem one_mem_twoPart (X : Subgroup G) : (1 : G) ∈ twoPart X :=
  Subgroup.subset_closure ⟨X.one_mem, 1, by simp⟩

theorem one_mem_oddPart (X : Subgroup G) : (1 : G) ∈ oddPart X :=
  Subgroup.subset_closure ⟨X.one_mem, by simp [orderOf_one]⟩

theorem mem_twoPart_of_pow (X : Subgroup G) {x : G} (hx : x ∈ X) {n : ℕ}
    (h : x ^ 2 ^ n = 1) : x ∈ twoPart X := Subgroup.subset_closure ⟨hx, n, h⟩

theorem mem_oddPart_of_odd (X : Subgroup G) {x : G} (hx : x ∈ X) (h : Odd (orderOf x)) :
    x ∈ oddPart X := Subgroup.subset_closure ⟨hx, h⟩

/-- **The structural inputs of Theorem G** that are consumed by the argument of Theorem G and
that none of the area `Prop`s of `Submission/Blueprint/Interfaces.lean` currently exposes.
Each field is a literal statement of a numbered result of the paper (references in the field
comments), so that a later area (the `Ch. V §1–2` files of `ThmF`, or `ThreePoints`, or an
extension of `ChIIFourProp`) can discharge it.

Here `D = twoPoint H t = H ∩ Hᵗ`, `K = invertedBy D t = J(D,t)` and `Q₁ = oddPart Q`. -/
structure RankOneStructure (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G) : Prop where
  /-- Ch. I §2: `K = J(D,t) ≠ 1` (`|K| = |Inv(H)| > 1`).  Used to produce an element of `D`
  of prime order acting fixed-point-freely on `Q`, whence (Thompson) `Q` is nilpotent. -/
  K_ne_one : ∃ x ∈ invertedBy (twoPoint H t) t, x ≠ 1
  /-- Ch. II §4 Prop. 2(b) / II p. 236: `D = H ∩ Hᵗ ≠ 1`, equivalently `V = C_D(t) ≠ 1`, i.e. `G`
  is not a Zassenhaus group.  (Used for `|D| ≥ 3` in the degree count.) -/
  D_ne_bot : twoPoint H t ≠ ⊥
  /-- App. XII hypothesis: `(|D|, |Q|) = 1` (`D` is a Hall complement of the Hall subgroup
  `Q` of `H`). -/
  coprime : Nat.Coprime (Nat.card (twoPoint H t)) (Nat.card Q)
  /-- Ch. V §2 Lemma 2 c) (with Ch. II §4 Prop. 2 b) and hypothesis (B3)): `D` acts
  fixed-point-freely on the odd part `Q₁ = O_{2'}(Q)` of `Q`. -/
  fpf_oddPart : ∀ d ∈ twoPoint H t, d ≠ 1 → ∀ x ∈ oddPart Q, d * x * d⁻¹ = x → x = 1
  /-- Ch. VI §1, p. 258: the existence of a linear character `lam ≠ 1_H` of `H` with `Q ⊆ ker lam`
  (the paper's `QK ⊆ ker lam`; it exists because `H/QK ≅ V ≠ 1` is solvable). -/
  exists_linear : ∃ lam : H → ℂ, lam ∈ Work.CharCore.Irr H ∧ lam 1 = 1 ∧
    lam ≠ (fun _ : H => (1 : ℂ)) ∧ (∀ x : H, (x : G) ∈ Q → lam x = 1)
  /-- Ch. VI §1, p. 258: for such a `lam`, `Ind_H^G lam` has norm `2`, i.e. is the sum of two
  distinct irreducible characters of `G` (TI/Hall argument on p. 258). -/
  ind_two : ∀ lam : H → ℂ, lam ∈ Work.CharCore.Irr H → lam 1 = 1 →
    lam ≠ (fun _ : H => (1 : ℂ)) → (∀ x : H, (x : G) ∈ Q → lam x = 1) →
    ∃ f₁ ∈ Work.CharCore.Irr G, ∃ f₂ ∈ Work.CharCore.Irr G, f₁ ≠ f₂ ∧
      Work.Induction.indFun H lam = f₁ + f₂
  /-- App. XII (3)–(4): `𝒮 = {χ ∈ Irr H | Q₁ ⊄ ker χ}` contains a character of degree
  `|D|`, and every degree in `𝒮` is a multiple of it (`χ_i(1) = a_i |D|`, `a_i ∈ ℕ`). -/
  degree : ∃ χ ∈ excludingKernel H (oddPart Q), χ 1 = (Nat.card (twoPoint H t) : ℂ) ∧
    ∀ ψ ∈ excludingKernel H (oddPart Q), ∃ a : ℕ, ψ 1 = (a : ℂ) * χ 1
  /-- App. XII Lemma 2 (a): every `χ ∈ 𝒮` is induced from `Q`, hence vanishes off `Q`
  (`𝒮 = {Ind_Q^H φ | φ ∈ Irr Q, Q₁ ⊄ ker φ}`). -/
  vanishes_off : ∀ χ ∈ excludingKernel H (oddPart Q), ∀ h : H, (h : G) ∉ Q → χ h = 0

/-- The structural inputs of `RankOneStructure`, as one `Prop` mirroring the shape of the
area `Prop`s (so that `thmG` can take them as a hypothesis). -/
def RankOneStructureProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    Situation G → IsSimpleGroup G → IsSplitRankOne H Q t → ¬ IsZassenhaus H →
    (∀ P : Subgroup G, P ≤ centD H t → (Nat.card P).Prime →
      HasFourGroup (Subgroup.centralizer (P : Set G))) →
    @RankOneStructure G _ _ H Q t

/-! ## The eight structural inputs as named `Prop`s

Following the lead's ruling, each field of `RankOneStructure` is exported here as a standalone
`Prop` with exactly the field's statement, so that its owner area can import this module and
target it:

* `KNeOneProp`, `DNeBotProp` — area `ThreePoints` (Ch. I §2: `|K| = |Inv H| > 1`;
  Ch. II §4 Prop. 2 (b) with II p. 236: `D ≠ 1`);
* `CoprimeDQProp` — area `DoubleTransitivity` (Ch. I: `Q` is a Hall subgroup of `H`);
* `FpfOddPartProp`, `ExistsLinearProp`, `IndTwoProp` — the `Ch. V §1–2` export of `ThmF`;
* `DegreeProp`, `VanishesOffProp` — area `FeitSibley` (App. XII (3)–(4) and Lemma 2 (a)).
-/

/-- The hypothesis context (B0)–(B3) of the split rank-one situation, shared by the eight
structural inputs below. -/
def RankOneHyp (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G) : Prop :=
  Situation G ∧ IsSimpleGroup G ∧ IsSplitRankOne H Q t ∧ ¬ IsZassenhaus H ∧
    (∀ P : Subgroup G, P ≤ centD H t → (Nat.card P).Prime →
      HasFourGroup (Subgroup.centralizer (P : Set G)))

/-- **Field 1** (area `ThreePoints`, Ch. I §2): `K = J(D,t) ≠ 1` (`|K| = |Inv H| > 1`). -/
def KNeOneProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → ∃ x ∈ invertedBy (twoPoint H t) t, x ≠ 1

/-- **Field 2** (area `ThreePoints`, Ch. II §4 Prop. 2 (b) with p. 236): `D = H ∩ Hᵗ ≠ 1`.
(Already proved in this area: `Work.ThmG.dNeBotProp`.) -/
def DNeBotProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → twoPoint H t ≠ ⊥

/-- **Field 3** (area `DoubleTransitivity`, Ch. I): `(|D|, |Q|) = 1`. -/
def CoprimeDQProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → Nat.Coprime (Nat.card (twoPoint H t)) (Nat.card Q)

/-- **Field 4** (the `Ch. V §1–2` export of `ThmF`, Ch. V §2 Lemma 2 c): `D` acts
fixed-point-freely on `Q₁ = O_{2'}(Q)`. -/
def FpfOddPartProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → ∀ d ∈ twoPoint H t, d ≠ 1 → ∀ x ∈ oddPart Q, d * x * d⁻¹ = x → x = 1

/-- **Field 5** (the `Ch. V §1–2` export of `ThmF`, Ch. VI §1 p. 258): a linear character
`lam ≠ 1_H` of `H` with `Q ⊆ ker lam`. -/
def ExistsLinearProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → ∃ lam : H → ℂ, lam ∈ Work.CharCore.Irr H ∧ lam 1 = 1 ∧
      lam ≠ (fun _ : H => (1 : ℂ)) ∧ (∀ x : H, (x : G) ∈ Q → lam x = 1)

/-- **Field 6** (the `Ch. V §1–2` export of `ThmF`, Ch. VI §1 p. 258): for such a `lam`,
`Ind_H^G lam` is the sum of two distinct irreducible characters of `G` (`‖Ind lam‖² = 2`). -/
def IndTwoProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → ∀ lam : H → ℂ, lam ∈ Work.CharCore.Irr H → lam 1 = 1 →
      lam ≠ (fun _ : H => (1 : ℂ)) → (∀ x : H, (x : G) ∈ Q → lam x = 1) →
      ∃ f₁ ∈ Work.CharCore.Irr G, ∃ f₂ ∈ Work.CharCore.Irr G, f₁ ≠ f₂ ∧
        Work.Induction.indFun H lam = f₁ + f₂

/-- **Field 7** (area `FeitSibley`, App. XII (3)–(4)): `𝒮 = {χ ∈ Irr H | Q₁ ⊄ ker χ}` contains a
character of degree `|D|`, and all degrees in `𝒮` are multiples of it. -/
def DegreeProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → ∃ χ ∈ excludingKernel H (oddPart Q),
      χ 1 = (Nat.card (twoPoint H t) : ℂ) ∧
      ∀ ψ ∈ excludingKernel H (oddPart Q), ∃ a : ℕ, ψ 1 = (a : ℂ) * χ 1

/-- **Field 8** (area `FeitSibley`, App. XII Lemma 2 (a)): every `χ ∈ 𝒮` vanishes off `Q`. -/
def VanishesOffProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q : Subgroup G) (t : G),
    RankOneHyp G H Q t → ∀ χ ∈ excludingKernel H (oddPart Q), ∀ h : H, (h : G) ∉ Q → χ h = 0

/-- **Wiring**: the eight named structural inputs give `RankOneStructureProp`, i.e. they discharge
the hypothesis of `Work.ThmG.thmG`. -/
theorem rankOneStructure_of (h1 : KNeOneProp) (h2 : DNeBotProp) (h3 : CoprimeDQProp)
    (h4 : FpfOddPartProp) (h5 : ExistsLinearProp) (h6 : IndTwoProp) (h7 : DegreeProp)
    (h8 : VanishesOffProp) : RankOneStructureProp := by
  intro G _ _ H Q t hSit hsimple hsplit hnotZ hB3
  have hh : RankOneHyp G H Q t := ⟨hSit, hsimple, hsplit, hnotZ, hB3⟩
  exact ⟨h1 G H Q t hh, h2 G H Q t hh, h3 G H Q t hh, h4 G H Q t hh, h5 G H Q t hh,
    h6 G H Q t hh, h7 G H Q t hh, h8 G H Q t hh⟩

end Work.ThmG
