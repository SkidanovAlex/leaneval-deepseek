namespace Work.ThmG

/-- In a finite nilpotent group `Q`, every element of `p`-power order lies in the
(necessarily unique) Sylow `p`-subgroup `P`.

The `p`-element `y` generates a `p`-subgroup `⟨y⟩`; by Sylow's theorem `⟨y⟩` is contained in
*some* Sylow `p`-subgroup `P'`, and since `Q` is nilpotent every Sylow subgroup is normal,
so `P'` and the given Sylow `P` coincide (`IsPGroup.le_sylow_of_normal`). -/
theorem mem_sylow_of_pow_eq_one {Q : Type*} [Group Q] [Finite Q] [Group.IsNilpotent Q]
    (p : ℕ) [Fact p.Prime] (P : Sylow p Q) {y : Q} {k : ℕ} (h : y ^ p ^ k = 1) : y ∈ P := by
  have hsub : IsPGroup p (Subgroup.zpowers y) := by
    apply IsPGroup.of_card_dvd_pow (n := k)
    rw [Nat.card_zpowers, orderOf_dvd_iff_pow_eq_one]
    exact h
  obtain ⟨P', hP'⟩ := IsPGroup.exists_le_sylow hsub
  have hle : (P' : Subgroup Q) ≤ (P : Subgroup Q) :=
    IsPGroup.le_sylow_of_normal P'.isPGroup' P
  exact hle (hP' (Subgroup.mem_zpowers y))

/-- `O_2(Q)` is the image in `G` of a Sylow `2`-subgroup of a finite nilpotent subgroup `Q`:
the subgroup generated by the elements of `Q` of `2`-power order is exactly (the set of
elements of) the unique Sylow `2`-subgroup of `Q`. -/
theorem twoPart_eq_map_sylow_two {G : Type*} [Group G] (Q : Subgroup G) [Finite Q]
    (hQ : Group.IsNilpotent Q) (P : Sylow 2 Q) :
    Work.ThmG.twoPart Q = (P : Subgroup Q).map Q.subtype := by
  have hQ' : Group.IsNilpotent Q := hQ
  apply le_antisymm
  · -- every element of a Sylow `2`-subgroup has `2`-power order, hence is a generator of
    -- `twoPart Q`
    rw [Work.ThmG.twoPart, Subgroup.closure_le]
    rintro x ⟨hxQ, n, hn⟩
    refine Subgroup.mem_map.mpr ⟨⟨x, hxQ⟩, mem_sylow_of_pow_eq_one 2 P (k := n) ?_, rfl⟩
    apply Q.subtype_injective
    rw [map_pow, map_one]
    exact hn
  · -- conversely every element of `2`-power order of `Q` lies in the Sylow `2`-subgroup `P`
    rw [Subgroup.map_le_iff_le_comap]
    intro x hx
    obtain ⟨k, hk⟩ := P.isPGroup' ⟨x, hx⟩
    have hkQ : x ^ 2 ^ k = 1 := by
      have h1 := congrArg (fun t : ↥(P : Subgroup Q) => (t : Q)) hk
      simpa [Subgroup.coe_pow] using h1
    refine Work.ThmG.mem_twoPart_of_pow Q x.2 (n := k) ?_
    rw [← map_pow, hkQ, map_one]

end Work.ThmG
