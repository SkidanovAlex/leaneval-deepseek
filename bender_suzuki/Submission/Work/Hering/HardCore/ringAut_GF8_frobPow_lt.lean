/-!
# Every ring automorphism of `GF(8)` is a Frobenius power with exponent `< 3`

The Galois group `Gal(GF(8)/GF(2))` is cyclic of order `3`, generated by the Frobenius
`σ : x ↦ x ^ 2` (this is `FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow`, whose
indexing set is `Fin (Module.finrank (ZMod 2) (GaloisField 2 3)) = Fin 3`).  Since every ring
automorphism of `GF(8)` fixes the prime field `ZMod 2`, it is a `ZMod 2`-algebra automorphism,
hence a power `σ ^ i` with `i < 3`, i.e. the map `x ↦ x ^ (2 ^ i)`.
-/

set_option autoImplicit false

namespace Work.Hering.HardCore

open Work.Hering.AppVIII

/-- Every ring automorphism `θ` of `GF(8) = GaloisField 2 3` is of the form `x ↦ x ^ (2 ^ i)`
for some `i < 3`. -/
theorem ringAut_GF8_frobPow_lt (θ : GaloisField 2 3 ≃+* GaloisField 2 3) :
    ∃ i : ℕ, i < 3 ∧ ∀ x : GaloisField 2 3, θ x = x ^ (2 ^ i) := by
  -- `θ` fixes the prime field `ZMod 2`, so it is a `ZMod 2`-algebra automorphism.
  have hfix : ∀ c : ZMod 2, θ (algebraMap (ZMod 2) (GaloisField 2 3) c) =
      algebraMap (ZMod 2) (GaloisField 2 3) c := fun c => ringEquiv_algebraMap_eq θ c
  let θ' : GaloisField 2 3 ≃ₐ[ZMod 2] GaloisField 2 3 := AlgEquiv.ofRingEquiv hfix
  -- The Frobenius powers `σ ^ i`, `i : Fin 3`, exhaust the algebra automorphism group.
  have hbij := FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) (GaloisField 2 3)
  rw [GaloisField.finrank 2 (by norm_num : (3 : ℕ) ≠ 0)] at hbij
  obtain ⟨k, hk⟩ := hbij.2 θ'
  have hk' : (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 3) ^ (k : ℕ)) =
      θ' := hk
  -- `θ` is the map `x ↦ x ^ 2 ^ i`.
  have hfun : ∀ x : GaloisField 2 3, θ x = x ^ (2 ^ (k : ℕ)) := by
    intro x
    have hfrob : ⇑(FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 3)) =
        fun y => y ^ 2 := by
      rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ZMod.card]
    calc θ x = θ' x := (AlgEquiv.ofRingEquiv_apply hfix x).symm
      _ = (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 3) ^ (k : ℕ)) x := by
            rw [hk']
      _ = x ^ (2 ^ (k : ℕ)) := by rw [AlgEquiv.coe_pow, hfrob, pow_iterate]
  exact ⟨k.1, k.2, hfun⟩

end Work.Hering.HardCore
