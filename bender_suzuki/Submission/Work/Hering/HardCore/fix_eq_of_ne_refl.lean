import Mathlib
import Submission.Work.Hering.AppVIII.frobPowOfFourth

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# Fixed points of a nontrivial automorphism of `GF(8)`

`Aut(GF(2³))` is cyclic of order `3`, generated by the Frobenius `x ↦ x²`; consequently a
nontrivial ring automorphism `θ` of `GaloisField 2 3` is a Frobenius power `x ↦ x ^ (2 ^ s)`
with `s ∈ {1, 2}`.  The fixed points of `x ↦ x ^ (2 ^ s)` are the `x` with `x ^ (2 ^ s - 1) = 1`,
i.e. (as `2 ^ s - 1 ∈ {1, 3}` is coprime to `8 - 1 = 7`) only `x = 0` and `x = 1`.
-/

set_option autoImplicit false

namespace Work.Hering.HardCore

/-- `GaloisField 2 3` has cardinality `8` (hence `x ^ 7 = 1` for units). -/
theorem card_galoisField_two_three : Nat.card (GaloisField 2 3) = 8 := by
  rw [GaloisField.card 2 3 (by norm_num)]
  norm_num

theorem fix_eq_of_ne_refl (θ : GaloisField 2 3 ≃+* GaloisField 2 3)
    (hθ : θ ≠ RingEquiv.refl _) (x : GaloisField 2 3) (hx : θ x = x) :
    x = 0 ∨ x = 1 := by
  haveI : Fintype (GaloisField 2 3) := Fintype.ofFinite _
  -- Promote `θ` to a `ZMod 2`-algebra automorphism (it fixes the prime field).
  have hfix : ∀ c : ZMod 2, θ (algebraMap (ZMod 2) (GaloisField 2 3) c) =
      algebraMap (ZMod 2) (GaloisField 2 3) c :=
    fun c => Work.Hering.AppVIII.ringEquiv_algebraMap_eq θ c
  let θ' : GaloisField 2 3 ≃ₐ[ZMod 2] GaloisField 2 3 := AlgEquiv.ofRingEquiv hfix
  -- `Aut(GF(8))` is generated by the Frobenius `x ↦ x ^ 2`.
  have hbij := FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) (GaloisField 2 3)
  rw [GaloisField.finrank 2 (by norm_num : (3 : ℕ) ≠ 0)] at hbij
  obtain ⟨k, hk⟩ := hbij.2 θ'
  -- `θ` is the map `x ↦ x ^ (2 ^ k.1)`.
  have hfrob : ⇑(FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 3)) =
      fun y => y ^ 2 := by
    rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ZMod.card]
  have hpow : ∀ y, θ y = y ^ (2 ^ k.1) := by
    intro y
    calc θ y = θ' y := (AlgEquiv.ofRingEquiv_apply hfix y).symm
      _ = (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 3) ^ k.1) y := by
            rw [← hk]
      _ = y ^ (2 ^ k.1) := by rw [AlgEquiv.coe_pow, hfrob, pow_iterate]
  -- `k.1 ≠ 0`, since `θ ≠ 1`.
  have hk0 : k.1 ≠ 0 := by
    intro h0
    apply hθ
    ext y
    rw [hpow y, h0]
    simp
  have hxp : x ^ (2 ^ k.1) = x := by rw [← hpow x, hx]
  rcases eq_or_ne x 0 with hx0 | hx0
  · exact Or.inl hx0
  · right
    -- `x ^ 7 = 1` because `GaloisField 2 3` has `8` elements.
    have hcard : Fintype.card (GaloisField 2 3) = 8 := by
      rw [← Nat.card_eq_fintype_card, card_galoisField_two_three]
    have h7 : x ^ 7 = 1 := by
      have h := FiniteField.pow_card_sub_one_eq_one x hx0
      rw [hcard] at h
      simpa using h
    -- dividing `x ^ (2 ^ k.1) = x` by `x` gives `x ^ (2 ^ k.1 - 1) = 1`.
    have hge : 1 ≤ 2 ^ k.1 := Nat.one_le_pow _ _ (by norm_num)
    have hm : x ^ (2 ^ k.1 - 1) = 1 := by
      have h1 : x ^ (2 ^ k.1 - 1) * x = x ^ (2 ^ k.1) := by
        rw [← pow_succ, Nat.sub_add_cancel hge]
      have h2 : x ^ (2 ^ k.1 - 1) * x = 1 * x := by rw [h1, hxp, one_mul]
      exact mul_right_cancel₀ hx0 h2
    -- `orderOf x` divides `gcd 7 (2 ^ k.1 - 1) = 1`.
    have hdvd : orderOf x ∣ Nat.gcd 7 (2 ^ k.1 - 1) :=
      Nat.dvd_gcd (orderOf_dvd_iff_pow_eq_one.mpr h7) (orderOf_dvd_iff_pow_eq_one.mpr hm)
    have hcases : k.1 = 1 ∨ k.1 = 2 := by
      have hlt : k.1 < 3 := k.2
      omega
    rcases hcases with hk1 | hk2
    · rw [hk1] at hdvd
      norm_num only [pow_one, Nat.reduceSub, Nat.gcd_one_right] at hdvd
      exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp hdvd)
    · rw [hk2] at hdvd
      norm_num only [Nat.reducePow, Nat.reduceSub, Nat.gcd_one_right] at hdvd
      exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp hdvd)

end Work.Hering.HardCore
