/-!
# Bounded exponent representation in the subgroup generated by three commuting elements

Let `C` be an abelian subgroup of a group `G` and let `c₁, c₂, c₃ ∈ C` all have order dividing
`2 ^ m`.  Then every element of the subgroup generated by `c₁, c₂, c₃` is a product
`c₁ ^ A * c₂ ^ B * c₃ ^ D` with `A, B, D < 2 ^ m`.

The proof exhibits the set of such bounded products as a subgroup `T` (using the commutativity
of the generators and `pow_eq_pow_mod` to reduce exponents mod `2 ^ m`) and then applies
`Subgroup.closure_le`.
-/

namespace Work.Hering.HardCore

theorem closure_three_eq {G : Type*} [Group G] (C : Subgroup G)
    (hCab : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x)
    {c₁ c₂ c₃ : G} (hc₁ : c₁ ∈ C) (hc₂ : c₂ ∈ C) (hc₃ : c₃ ∈ C)
    {m : ℕ} (hm : 1 ≤ m) (h1 : c₁ ^ 2 ^ m = 1) (h2 : c₂ ^ 2 ^ m = 1) (h3 : c₃ ^ 2 ^ m = 1) :
    ∀ x ∈ Subgroup.closure ({c₁, c₂, c₃} : Set G),
      ∃ A B D : ℕ, A < 2 ^ m ∧ B < 2 ^ m ∧ D < 2 ^ m ∧ x = c₁ ^ A * c₂ ^ B * c₃ ^ D := by
  have hNpos : 0 < 2 ^ m := pow_pos (by norm_num) m
  have hm0 : m ≠ 0 := by omega
  -- the three generators pairwise commute
  have hcomm12 : Commute c₁ c₂ := (commute_iff_eq c₁ c₂).mpr (hCab c₁ hc₁ c₂ hc₂)
  have hcomm13 : Commute c₁ c₃ := (commute_iff_eq c₁ c₃).mpr (hCab c₁ hc₁ c₃ hc₃)
  have hcomm23 : Commute c₂ c₃ := (commute_iff_eq c₂ c₃).mpr (hCab c₂ hc₂ c₃ hc₃)
  -- the set of bounded products is a subgroup
  let T : Subgroup G :=
    { carrier := {g : G | ∃ A B D : ℕ, A < 2 ^ m ∧ B < 2 ^ m ∧ D < 2 ^ m ∧
        c₁ ^ A * c₂ ^ B * c₃ ^ D = g}
      one_mem' := ⟨0, 0, 0, hNpos, hNpos, hNpos, by simp⟩
      mul_mem' := by
        intro g h hg hh
        obtain ⟨A, B, D, hA, hB, hD, rfl⟩ := hg
        obtain ⟨A', B', D', hA', hB', hD', rfl⟩ := hh
        refine ⟨(A + A') % 2 ^ m, (B + B') % 2 ^ m, (D + D') % 2 ^ m,
          Nat.mod_lt _ hNpos, Nat.mod_lt _ hNpos, Nat.mod_lt _ hNpos, ?_⟩
        rw [commute_three_mul hcomm12 hcomm13 hcomm23 A B D A' B' D',
          pow_eq_pow_mod (A + A') h1, pow_eq_pow_mod (B + B') h2,
          pow_eq_pow_mod (D + D') h3]
      inv_mem' := by
        intro g hg
        obtain ⟨A, B, D, hA, hB, hD, rfl⟩ := hg
        have key1 : c₁ ^ ((2 ^ m - A) % 2 ^ m + A) = 1 := by
          have hA' : c₁ ^ ((2 ^ m - A) % 2 ^ m) = c₁ ^ (2 ^ m - A) :=
            (pow_eq_pow_mod (2 ^ m - A) h1).symm
          rw [pow_add, hA', ← pow_add, Nat.sub_add_cancel (le_of_lt hA), h1]
        have key2 : c₂ ^ ((2 ^ m - B) % 2 ^ m + B) = 1 := by
          have hB' : c₂ ^ ((2 ^ m - B) % 2 ^ m) = c₂ ^ (2 ^ m - B) :=
            (pow_eq_pow_mod (2 ^ m - B) h2).symm
          rw [pow_add, hB', ← pow_add, Nat.sub_add_cancel (le_of_lt hB), h2]
        have key3 : c₃ ^ ((2 ^ m - D) % 2 ^ m + D) = 1 := by
          have hD' : c₃ ^ ((2 ^ m - D) % 2 ^ m) = c₃ ^ (2 ^ m - D) :=
            (pow_eq_pow_mod (2 ^ m - D) h3).symm
          rw [pow_add, hD', ← pow_add, Nat.sub_add_cancel (le_of_lt hD), h3]
        have hhg : (c₁ ^ ((2 ^ m - A) % 2 ^ m) * c₂ ^ ((2 ^ m - B) % 2 ^ m) *
              c₃ ^ ((2 ^ m - D) % 2 ^ m)) * (c₁ ^ A * c₂ ^ B * c₃ ^ D) = 1 := by
          rw [commute_three_mul hcomm12 hcomm13 hcomm23 _ _ _ A B D,
            key1, key2, key3, one_mul, one_mul]
        refine ⟨(2 ^ m - A) % 2 ^ m, (2 ^ m - B) % 2 ^ m, (2 ^ m - D) % 2 ^ m,
          Nat.mod_lt _ hNpos, Nat.mod_lt _ hNpos, Nat.mod_lt _ hNpos, ?_⟩
        exact (mul_eq_one_iff_eq_inv).mp hhg }
  -- `T` contains the generators, hence the whole closure
  have hT : Subgroup.closure ({c₁, c₂, c₃} : Set G) ≤ T := by
    rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨1, 0, 0, Nat.one_lt_two_pow hm0, hNpos, hNpos, by simp⟩
    · exact ⟨0, 1, 0, hNpos, Nat.one_lt_two_pow hm0, hNpos, by simp⟩
    · exact ⟨0, 0, 1, hNpos, hNpos, Nat.one_lt_two_pow hm0, by simp⟩
  intro x hx
  obtain ⟨A, B, D, hA, hB, hD, heq⟩ := hT hx
  exact ⟨A, B, D, hA, hB, hD, heq.symm⟩

end Work.Hering.HardCore
