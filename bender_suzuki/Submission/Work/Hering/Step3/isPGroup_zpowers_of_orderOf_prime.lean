namespace Work.Hering.Step3

set_option linter.unusedVariables false

/-- The cyclic subgroup generated by an element of prime order `d` is a `d`-group:
its cardinality equals `orderOf g = d = d ^ 1`. -/
theorem isPGroup_zpowers_of_orderOf_prime {G : Type*} [Group G] {g : G} {d : ℕ}
    (hd : Nat.Prime d) (hord : orderOf g = d) : IsPGroup d ↥(Subgroup.zpowers g) := by
  exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hord, pow_one])

end Work.Hering.Step3
