namespace Work.Hering.Step3

/-- A subgroup of cardinality `4` in which every element squares to `1` (i.e. a group of exponent
`2` of order `4`) is generated by two distinct involutions.  This is the abstract content of the
fact that a subgroup of `V = Inv(G) ∪ {1}` of order `4` is a four-group. -/
theorem exists_two_involutions_of_card_four {G : Type*} [Group G] (H : Subgroup G)
    (hexp : ∀ x ∈ H, x * x = 1) (hcard : Nat.card H = 4) :
    ∃ a b : G, a ∈ H ∧ b ∈ H ∧ orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧
      H = Subgroup.closure ({a, b} : Set G) := by
  -- `H` is finite and nontrivial, so it contains an element `a ≠ 1`
  have hfin : Finite ↥H := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  have hne_bot : H ≠ ⊥ := by
    intro h
    rw [h, Subgroup.card_bot] at hcard
    norm_num at hcard
  have hnontriv : Nontrivial ↥H := (Subgroup.nontrivial_iff_ne_bot H).mpr hne_bot
  obtain ⟨a, haH, ha1⟩ := Subgroup.exists_ne_one_of_nontrivial H
  have ha2 : orderOf a = 2 := orderOf_eq_two_of_sq_eq_one (hexp a haH) ha1
  -- `⟨a⟩` is a proper subgroup of `H`, so there is `b ∈ H` outside it
  have hAcard : Nat.card ↥(Subgroup.zpowers a) = 2 := by rw [Nat.card_zpowers, ha2]
  have hAle : Subgroup.zpowers a ≤ H := Subgroup.zpowers_le.mpr haH
  have hAne : Subgroup.zpowers a ≠ H := by
    intro heq
    rw [heq, hcard] at hAcard
    norm_num at hAcard
  have hAlt : Subgroup.zpowers a < H := lt_of_le_of_ne hAle hAne
  obtain ⟨b, hbH, hbA⟩ := (SetLike.lt_iff_le_and_exists.mp hAlt).2
  have hb1 : b ≠ 1 := fun hb => hbA (hb ▸ (Subgroup.zpowers a).one_mem)
  have hb2 : orderOf b = 2 := orderOf_eq_two_of_sq_eq_one (hexp b hbH) hb1
  have hab : a ≠ b := fun h => hbA (h ▸ Subgroup.mem_zpowers a)
  refine ⟨a, b, haH, hbH, ha2, hb2, hab, ?_⟩
  -- `S := ⟨a, b⟩` is squeezed between `⟨a⟩` and `H`, whose orders are `2` and `4`
  have haS : a ∈ Subgroup.closure ({a, b} : Set G) := Subgroup.subset_closure (by simp)
  have hbS : b ∈ Subgroup.closure ({a, b} : Set G) := Subgroup.subset_closure (by simp)
  have hSH : Subgroup.closure ({a, b} : Set G) ≤ H := (Subgroup.closure_le H).mpr (by
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact haH
    · exact hbH)
  haveI hSfin : Finite ↥(Subgroup.closure ({a, b} : Set G)) :=
    Finite.of_injective (Subgroup.inclusion hSH) (Subgroup.inclusion_injective hSH)
  have hAleS : Subgroup.zpowers a ≤ Subgroup.closure ({a, b} : Set G) :=
    Subgroup.zpowers_le.mpr haS
  have hAneS : Subgroup.zpowers a ≠ Subgroup.closure ({a, b} : Set G) :=
    fun heq => hbA (heq ▸ hbS)
  have hAltS : Subgroup.zpowers a < Subgroup.closure ({a, b} : Set G) :=
    lt_of_le_of_ne hAleS hAneS
  have hgt2 : 2 < Nat.card ↥(Subgroup.closure ({a, b} : Set G)) := by
    rw [← hAcard]
    exact Subgroup.card_lt_of_lt hAltS
  have hdvd : Nat.card ↥(Subgroup.closure ({a, b} : Set G)) ∣ 4 := by
    rw [← hcard]
    exact Subgroup.card_dvd_of_le hSH
  have hcardS : Nat.card ↥(Subgroup.closure ({a, b} : Set G)) = 4 := by
    have h4 : (4 : ℕ) = 2 ^ 2 := by norm_num
    rw [h4] at hdvd
    obtain ⟨k, _, hk_eq⟩ := (Nat.dvd_prime_pow (p := 2) (m := 2) Nat.prime_two).mp hdvd
    interval_cases k
    · simp only [pow_zero] at hk_eq; omega
    · simp only [pow_one] at hk_eq; omega
    · norm_num at hk_eq; omega
  exact (Subgroup.eq_of_le_of_card_ge hSH (by rw [hcard, hcardS])).symm

theorem exists_pair_of_le_invSubgroup {G : Type*} [Group G] (hDT : DTInv G) (h4 : HasFourGroup G)
    {U : Subgroup G} (hU : U ≤ invSubgroup hDT h4) (hcard : Nat.card U = 4) :
    ∃ a b : G, a ∈ U ∧ b ∈ U ∧ orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧
      U = Subgroup.closure ({a, b} : Set G) :=
  exists_two_involutions_of_card_four U
    (fun _ hx => pow_two_eq_one_of_mem_invSubgroup hDT h4 (hU hx)) hcard

end Work.Hering.Step3
