set_option linter.style.haveILetI false

namespace Work.Hering.GL32

/-- **A `p`-group acting on a nonzero finite-dimensional vector space in characteristic `p` fixes a
nonzero vector.**

This is the standard fact used in the proof of Bender's theorem: for a finite `p`-group `P` acting
`k`-linearly on a nonzero finite-dimensional `k`-vector space `M`, where `k` has characteristic `p`,
the subspace of `P`-fixed vectors is nonzero.  Equivalently the trivial module is a composition
factor of `M`; the proof below applies the orbit-counting lemma
`IsPGroup.exists_fixed_point_of_prime_dvd_card_of_fixed_point` to the finite `𝔽_p`-subspace
generated by the `P`-orbit of a nonzero vector, whose cardinality `p ^ n` with `n ≥ 1` is divisible
by `p`, so that the (always present) fixed point `0` cannot be the only one.

Note on the statement: a `Module` over a `DivisionRing` is automatically an `AddCommGroup`
(`x - y = x + (-1) • y`), but Mathlib does not install this as a global instance, and the
abbreviation `FiniteDimensional K V` carries the instance argument `[AddCommGroup V]` explicitly.
Hence `[AddCommGroup M]` is needed for `FiniteDimensional k M` to elaborate, and `Module k M` has to
be introduced before it. -/
theorem pgroup_fixed_ne_bot {p : ℕ} (hp : Nat.Prime p) {P : Type*} [Group P] [Finite P]
    (hP : IsPGroup p P) {k M : Type*} [Field k] [CharP k p] [AddCommGroup M]
    [Module k M] [FiniteDimensional k M] [DistribMulAction P M] [SMulCommClass P k M]
    (hm : 0 < Module.finrank k M) : ∃ m : M, m ≠ 0 ∧ ∀ g : P, g • m = m := by
  classical
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI hnt : Nontrivial M := Module.nontrivial_of_finrank_pos hm
  obtain ⟨m₀, hm₀⟩ := exists_ne (0 : M)
  -- View `M` as a module over the prime field `𝔽_p`, via the algebra map `𝔽_p → k`.
  letI : Algebra (ZMod p) k := ZMod.algebra k p
  letI : Module (ZMod p) M := Module.compHom M (algebraMap (ZMod p) k)
  -- The `𝔽_p`-subspace spanned by the `P`-orbit of `m₀`; it is finite, nonzero and `P`-invariant.
  let v : P → M := fun g => g • m₀
  let V : Submodule (ZMod p) M := Submodule.span (ZMod p) (Set.range v)
  have hm₀V : m₀ ∈ V := by
    apply Submodule.subset_span
    exact Set.mem_range.mpr ⟨1, by simp [v]⟩
  have hVmem : ∀ (g : P) (x : M), x ∈ V → g • x ∈ V := by
    intro g x hx
    refine Submodule.span_induction (p := fun y _ => g • y ∈ V) ?_ ?_ ?_ ?_ hx
    · rintro y ⟨h, rfl⟩
      rw [← mul_smul]
      exact Submodule.subset_span (Set.mem_range.mpr ⟨g * h, rfl⟩)
    · simp
    · intro y z hy hz ihy ihz
      rw [smul_add]
      exact V.add_mem ihy ihz
    · intro a y hy ihy
      show g • ((algebraMap (ZMod p) k a) • y) ∈ V
      rw [smul_comm g (algebraMap (ZMod p) k a) y]
      exact V.smul_mem a ihy
  -- The action of `P` on `V` induced by its action on `M`.
  let actV : P → V → V := fun g x => ⟨g • (x : M), hVmem g x x.2⟩
  letI : MulAction P V :=
    { smul := actV
      one_smul := fun x => by
        change actV 1 x = x
        exact Subtype.ext (one_smul P (x : M))
      mul_smul := fun g h x => by
        change actV (g * h) x = actV g (actV h x)
        exact Subtype.ext (mul_smul g h (x : M)) }
  haveI hVfin : Module.Finite (ZMod p) V := Module.Finite.span_of_finite _ (Set.finite_range v)
  haveI : Finite V := Module.finite_of_finite (ZMod p)
  -- `V` is a nonzero `𝔽_p`-vector space, so `Nat.card V = p ^ n` with `n ≥ 1` is divisible by `p`.
  have hntV : Nontrivial V :=
    ⟨⟨⟨m₀, hm₀V⟩, 0, fun h => hm₀ (by simpa using congrArg Subtype.val h)⟩⟩
  have hdvd : p ∣ Nat.card V := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod p) (V := V), Nat.card_zmod]
    exact dvd_pow_self p (Module.finrank_pos (R := ZMod p) (M := V)).ne'
  -- `0` is a fixed point and `p ∣ Nat.card V`, so the number of fixed points is a positive multiple
  -- of `p`: there is a fixed point different from `0`.
  have h0fix : (0 : V) ∈ MulAction.fixedPoints P V := by
    rw [MulAction.mem_fixedPoints]
    intro g
    change actV g 0 = 0
    exact Subtype.ext (smul_zero g)
  obtain ⟨b, hbfix, hbne⟩ :=
    IsPGroup.exists_fixed_point_of_prime_dvd_card_of_fixed_point hP V hdvd h0fix
  refine ⟨(b : M), ?_, ?_⟩
  · intro hb
    exact hbne (Subtype.ext (by simpa using hb)).symm
  · intro g
    have h := MulAction.mem_fixedPoints.mp hbfix g
    change actV g b = b at h
    exact congrArg Subtype.val h

end Work.Hering.GL32
