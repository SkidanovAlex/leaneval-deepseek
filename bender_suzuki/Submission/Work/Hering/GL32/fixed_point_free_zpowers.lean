namespace Work.Hering.GL32

/-- In a group, an element `x ≠ 1` of the cyclic subgroup generated by an element `b`
with `b ^ 3 = 1` is equal to `b` or to `b ^ 2`. -/
private theorem zpowers_cube_eq {G : Type*} [Group G] (b x : G) (hb : b ^ 3 = 1)
    (hx : x ∈ Subgroup.zpowers b) (hx1 : x ≠ 1) : x = b ∨ x = b ^ 2 := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hx
  have hbz : b ^ (3 : ℤ) = 1 := by simpa using hb
  have hmod : b ^ k = b ^ (k % 3) := zpow_eq_zpow_emod k hbz
  have hk' : x = b ^ (k % 3) := by rw [← hk, hmod]
  have hr : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by
    have h0 : 0 ≤ k % 3 := Int.emod_nonneg k (by norm_num)
    have hlt : k % 3 < 3 := Int.emod_lt_of_pos k (by norm_num)
    omega
  rcases hr with h | h | h
  · exfalso; rw [h, zpow_zero] at hk'; exact absurd hk' hx1
  · left; rw [hk', h, zpow_one]
  · right; rw [hk', h, zpow_two, pow_two]

/-- Conjugation by `b` raises an element of `⟨a⟩` to the square, when `b * a * b⁻¹ = a ^ 2`. -/
private theorem conj_b_eq_sq {G : Type*} [Group G] (a b s : G) (hrel : b * a * b⁻¹ = a ^ 2)
    (hs : s ∈ Subgroup.zpowers a) : b * s * b⁻¹ = s ^ 2 := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hs
  subst hm
  rw [← conj_zpow (i := m) (a := b) (b := a), hrel]
  have h : (a ^ 2 : G) = a ^ (2 : ℤ) := by simp
  rw [h, ← zpow_mul a 2 m, show (2 : ℤ) * m = m * 2 by ring, zpow_mul a m 2]
  simp

/-- Conjugation by `b ^ 2` raises an element of `⟨a⟩` to the fourth power,
when `b * a * b⁻¹ = a ^ 2`. -/
private theorem conj_b_sq_eq_four {G : Type*} [Group G] (a b s : G) (hrel : b * a * b⁻¹ = a ^ 2)
    (hs : s ∈ Subgroup.zpowers a) : b ^ 2 * s * (b ^ 2)⁻¹ = s ^ 4 := by
  have h1 := conj_b_eq_sq a b s hrel hs
  have h2 := conj_b_eq_sq a b (s ^ 2) hrel (Subgroup.pow_mem (Subgroup.zpowers a) hs 2)
  calc b ^ 2 * s * (b ^ 2)⁻¹ = b * (b * s * b⁻¹) * b⁻¹ := by
        rw [pow_two, mul_inv_rev]; group
    _ = b * s ^ 2 * b⁻¹ := by rw [h1]
    _ = (s ^ 2) ^ 2 := h2
    _ = s ^ 4 := by rw [← pow_mul]

/-- If `s ∈ ⟨a⟩` and `a ^ 7 = 1`, then `s ^ 7 = 1`. -/
private theorem pow_seven_eq_one {G : Type*} [Group G] (a s : G) (ha : a ^ 7 = 1)
    (hs : s ∈ Subgroup.zpowers a) : s ^ 7 = 1 := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hs
  subst hm
  rw [show (a ^ m) ^ 7 = (a ^ m) ^ (7 : ℤ) by simp]
  rw [← zpow_mul a m 7, zpow_mul' a m 7]
  rw [show (a : G) ^ (7 : ℤ) = a ^ 7 by simp, ha, one_zpow]

/-- **Bender–Suzuki, `GL(3,2)` local structure.**  In a group generated by an element `a`
of order dividing `7` and an element `b` of order dividing `3` with `b * a * b⁻¹ = a ^ 2`,
the non-trivial elements of `⟨b⟩` act fixed-point-freely on `⟨a⟩`: the only element of
`⟨a⟩` commuting with (equivalently, fixed by conjugation with) a non-trivial element of
`⟨b⟩` is the identity. -/
theorem fixed_point_free_zpowers {G : Type*} [Group G] (a b : G)
    (ha : a ^ 7 = 1) (hb : b ^ 3 = 1) (hrel : b * a * b⁻¹ = a ^ 2) :
    ∀ x ∈ Subgroup.zpowers b, x ≠ 1 → ∀ s ∈ Subgroup.zpowers a, x * s * x⁻¹ = s → s = 1 := by
  intro x hx hx1 s hs hfix
  rcases zpowers_cube_eq b x hb hx hx1 with h1 | h1
  · rw [h1] at hfix
    have hh := conj_b_eq_sq a b s hrel hs
    rw [hfix] at hh
    have h2 : s * s = s := by rw [← pow_two, ← hh]
    exact mul_eq_right.mp h2
  · rw [h1] at hfix
    have hh := conj_b_sq_eq_four a b s hrel hs
    rw [hfix] at hh
    have h4 : s ^ 4 = s := hh.symm
    have h3 : s ^ 3 = 1 := by
      have h : s ^ 3 * s = 1 * s := by rw [one_mul, ← pow_succ]; exact h4
      exact mul_right_cancel h
    have h7s : s ^ 7 = s := by
      rw [show (7 : ℕ) = 3 + 4 by norm_num, pow_add, h3, one_mul, h4]
    rw [← h7s, pow_seven_eq_one a s ha hs]

end Work.Hering.GL32
