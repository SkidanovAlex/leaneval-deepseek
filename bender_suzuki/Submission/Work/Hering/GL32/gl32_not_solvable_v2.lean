/-
# `GL(3,2) = Aut((Z/2)^3)` is not solvable

`GL(3,2)` is perfect: `SL(3,2) = GL(3,2)` is generated by transvections, and — because there
are three indices — every elementary transvection is a commutator of two transvections
(`[t_{ik}(a), t_{kj}(b)] = t_{ij}(ab)` for distinct `i, j, k`).  A nontrivial perfect group is
not solvable, so `¬ IsSolvable GL(3,2)`.

We transfer perfectness from `SL(3, 𝔽₂)` to `MulAut (Multiplicative (Fin 3 → ZMod 2))` along the
explicit chain of isomorphisms

* `MulAut (Multiplicative (Fin 3 → ZMod 2)) ≃* (Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)`:
  over `𝔽₂` every additive automorphism is automatically linear;
* `SL(3, 𝔽₂) →* GL(3, 𝔽₂) ≃* (Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)`,
  where the first map is surjective because `(𝔽₂)ˣ` is trivial.
-/

import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option linter.style.haveILetI false

open scoped commutatorElement

namespace Work.Hering.GL32

/-! ## Elementary transvections are commutators -/

/-- The commutator of two elementary transvections with distinct indices is again an elementary
transvection: `[t_{ik}(a), t_{kj}(b)] = t_{ij}(ab)` when `i, j, k` are pairwise distinct. -/
lemma commutator_transvection {n : Type*} [Fintype n] [DecidableEq n] {R : Type*} [CommRing R]
    (i j k : n) (hik : i ≠ k) (hkj : k ≠ j) (hij : i ≠ j) (a b : R) :
    ⁅Matrix.SpecialLinearGroup.transvection hik a, Matrix.SpecialLinearGroup.transvection hkj b⁆
      = Matrix.SpecialLinearGroup.transvection hij (a*b) := by
  rw [commutatorElement_def, Matrix.SpecialLinearGroup.transvection_inv,
    Matrix.SpecialLinearGroup.transvection_inv]
  apply Subtype.ext
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.transvection_coe]
  simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one]
  simp [Matrix.single_mul_single_same, Matrix.single_mul_single_of_ne,
    hik.symm, hkj.symm, hij.symm]
  simp only [← Matrix.single_neg]
  abel

/-- Every elementary transvection of `SL(3, 𝔽₂)` lies in the commutator subgroup
(the third index always exists). -/
lemma transvection_mem_commutator (i j : Fin 3) (hij : i ≠ j) (a : ZMod 2) :
    Matrix.SpecialLinearGroup.transvection hij a ∈
      commutator (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) := by
  obtain ⟨k, hki, hkj⟩ : ∃ k : Fin 3, k ≠ i ∧ k ≠ j := by
    revert i j
    decide
  have hik : i ≠ k := hki.symm
  have key := commutator_transvection (R := ZMod 2) i j k hik hkj hij a 1
  rw [mul_one] at key
  rw [← key]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

/-- `SL(3, 𝔽₂)` is perfect. -/
theorem sl32_isPerfect : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) := by
  rw [Group.isPerfect_def]
  apply eq_top_iff.mpr
  intro M _
  refine Matrix.SpecialLinearGroup.diagonal_transvection_induction'
    (P := fun M => M ∈ commutator (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))) M ?_ ?_ ?_
  · intro i j hij c hc
    have hc1 : c = 1 := by
      have h01 := (show ∀ c : ZMod 2, c = 0 ∨ c = 1 from by decide) c
      rcases h01 with h | h
      · exact absurd h hc
      · exact h
    subst hc1
    rw [show Matrix.SpecialLinearGroup.diag2n hij 1 hc = 1 from by
      apply Subtype.ext
      rw [Matrix.SpecialLinearGroup.diag2n_coe]
      simp]
    exact Subgroup.one_mem _
  · intro i j hij a
    exact transvection_mem_commutator i j hij a
  · intro A B hA hB
    exact Subgroup.mul_mem _ hA hB

/-! ## Over `𝔽₂`, every additive automorphism of `𝔽₂³` is linear -/

/-- An additive automorphism of `Fin 3 → ZMod 2`, regarded as a `ZMod 2`-linear equivalence. -/
private noncomputable def toLinEquiv (φ : MulAut (Multiplicative (Fin 3 → ZMod 2))) :
    (Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2) :=
{ toFun := fun x => Multiplicative.toAdd (φ (Multiplicative.ofAdd x))
  invFun := fun x => Multiplicative.toAdd (φ.symm (Multiplicative.ofAdd x))
  left_inv := by intro x; simp
  right_inv := by intro x; simp
  map_add' := by intro x y; simp
  map_smul' := by
    intro c x
    rcases (show ∀ c : ZMod 2, c = 0 ∨ c = 1 from by decide) c with rfl | rfl <;> simp }

private noncomputable def toLinHom : MulAut (Multiplicative (Fin 3 → ZMod 2)) →*
    ((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) where
  toFun := toLinEquiv
  map_one' := by ext x; rfl
  map_mul' := by intro f g; ext x; rfl

private lemma toLinHom_injective : Function.Injective toLinHom := by
  intro f g h
  apply MulEquiv.ext
  intro x
  have hx := congrArg (fun (e : (Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) =>
      e (Multiplicative.toAdd x)) h
  simpa [toLinHom, toLinEquiv] using hx

private lemma toLinHom_surjective : Function.Surjective toLinHom := by
  intro e
  refine ⟨e.toAddEquiv.toMultiplicative, ?_⟩
  ext x
  simp [toLinHom, toLinEquiv]

/-- Additive automorphisms of `𝔽₂³` are exactly the linear ones. -/
private noncomputable def mulAutEquivLin : MulAut (Multiplicative (Fin 3 → ZMod 2)) ≃*
    ((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) :=
  MulEquiv.ofBijective toLinHom ⟨toLinHom_injective, toLinHom_surjective⟩

/-! ## `GL(3, 𝔽₂) ≃* (Fin 3 → ZMod 2) ≃ₗ (Fin 3 → ZMod 2)` -/

/-- Over `𝔽₂` the determinant of an invertible matrix is `1`, so `SL(3, 𝔽₂) → GL(3, 𝔽₂)` is
surjective. -/
private lemma toGL_surjective : Function.Surjective (Matrix.SpecialLinearGroup.toGL :
    Matrix.SpecialLinearGroup (Fin 3) (ZMod 2) →* Matrix.GeneralLinearGroup (Fin 3) (ZMod 2)) := by
  intro g
  refine ⟨⟨(g : Matrix (Fin 3) (Fin 3) (ZMod 2)), ?_⟩, ?_⟩
  · have h : Matrix.GeneralLinearGroup.det g = 1 := Subsingleton.elim _ _
    have h2 := congrArg Units.val h
    simpa [Matrix.GeneralLinearGroup.val_det_apply] using h2
  · apply Units.ext
    rfl

private noncomputable def glEquivLin : Matrix.GeneralLinearGroup (Fin 3) (ZMod 2) ≃*
    ((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) :=
  (Matrix.GeneralLinearGroup.toLin).trans
    (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) (Fin 3 → ZMod 2))

/-- `SL(3, 𝔽₂)` is nontrivial (it contains a nontrivial transvection). -/
private lemma sl32_nontrivial : Nontrivial (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) :=
  ⟨Matrix.SpecialLinearGroup.transvection (show (0:Fin 3) ≠ 1 by decide) (1 : ZMod 2), 1,
    by decide⟩

/-! ## The main theorem -/

theorem gl32_not_solvable_v2 :
    ¬ Group.IsSolvable (MulAut (Multiplicative (Fin 3 → ZMod 2))) := by
  haveI hsl : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) := sl32_isPerfect
  haveI hgl : Group.IsPerfect (Matrix.GeneralLinearGroup (Fin 3) (ZMod 2)) :=
    Group.IsPerfect.ofSurjective (f := Matrix.SpecialLinearGroup.toGL) toGL_surjective
  haveI hlin : Group.IsPerfect ((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) :=
    Group.IsPerfect.ofSurjective (f := glEquivLin.toMonoidHom) glEquivLin.surjective
  haveI hperf : Group.IsPerfect (MulAut (Multiplicative (Fin 3 → ZMod 2))) :=
    Group.IsPerfect.ofSurjective (f := mulAutEquivLin.symm.toMonoidHom)
      mulAutEquivLin.symm.surjective
  haveI hnt : Nontrivial (MulAut (Multiplicative (Fin 3 → ZMod 2))) := by
    haveI : Nontrivial (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) := sl32_nontrivial
    haveI : Nontrivial (Matrix.GeneralLinearGroup (Fin 3) (ZMod 2)) :=
      Matrix.SpecialLinearGroup.toGL_injective.nontrivial
    haveI : Nontrivial ((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) :=
      Equiv.nontrivial glEquivLin.toEquiv.symm
    exact Equiv.nontrivial mulAutEquivLin.toEquiv
  exact Group.IsPerfect.not_isSolvable _

end Work.Hering.GL32
