import Submission.Work.Hering.GL32.gl32_not_solvable_v2

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `GL(3,2) = Aut((Z/2)^3)` is not solvable

This is a thin wrapper around `Work.Hering.GL32.gl32_not_solvable_v2`, which proves it via
perfectness of `SL(3,2) = GL(3,2)` (generated by transvections, each a commutator of two
transvections).

It replaces an earlier proof through the (expensive, unformalisable) finite computation that the
six elementary transvections of `GL(3,F₂)` generate the group; see the area notes.
-/

set_option autoImplicit false

namespace Work.Hering.GL32

/-- `GL(3,2)` is not solvable. -/
theorem gl32_not_solvable :
    ¬ Group.IsSolvable (MulAut (Multiplicative (Fin 3 → ZMod 2))) :=
  gl32_not_solvable_v2

end Work.Hering.GL32
