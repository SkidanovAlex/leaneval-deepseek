/-!
# `Aut((ℤ/2)³) = GL(3,2)` contains a Frobenius group of order `21`

Step 5 of the Hering reduction (Peterfalvi I, §2) needs the local structure of the automorphism
group of an elementary abelian group of order `8`: `Aut((ℤ/2)³) ≅ GL(3,2)` contains a Frobenius
group of order `21` (a Sylow `7`-subgroup acted on faithfully by a group of order `3`), and hence
an element `s` of order `7` and an element `t` of order `3` with `t * s * t⁻¹ ≠ s`.

The actual Frobenius group is constructed in `Submission.Work.Hering.GL32.frobenius21`
(`e7` = multiplication by a root of `X³+X+1`, `e3` = the Frobenius map `x ↦ x²`).  Here we

* assemble the subgroup `A = ⟨e7⟩ ⊔ ⟨e3⟩` of order `21` and extract `s`, `t`
  (`order21_canonical`);
* transport such a configuration across an arbitrary group isomorphism (`transport_order21`);
* produce the isomorphism `U ≃* (ℤ/2)³` for a group `U` of order `8` and exponent `2`
  (`iso_fin3`) out of `Work.Hering.F2.groups_of_exponent_two`.

The requested lemma `mulAut_eight_order21` is the combination of the three.
-/

set_option autoImplicit false

namespace Work.Hering.Step5

open Work.Hering.GL32

/-- **A Frobenius group of order `21` in `Aut((ℤ/2)³)`.**  The subgroup generated by the element
`e7` of order `7` and the element `e3` of order `3` (with `e3 * e7 * e3⁻¹ = e7²`) is the
Frobenius group of order `21`; in particular there are `s` of order `7` and `t` of order `3`
with `t * s * t⁻¹ ≠ s`. -/
theorem order21_canonical :
    ∃ A : Subgroup (MulAut (Multiplicative (Fin 3 → ZMod 2))), Nat.card A = 21 ∧
      ∃ s t : ↥A, orderOf s = 7 ∧ orderOf t = 3 ∧ t * s * t⁻¹ ≠ s := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  set S : Subgroup (MulAut (Multiplicative (Fin 3 → ZMod 2))) := Subgroup.zpowers e7 with hSdef
  set X : Subgroup (MulAut (Multiplicative (Fin 3 → ZMod 2))) := Subgroup.zpowers e3 with hXdef
  have hS : Nat.card ↥S = 7 := by
    rw [hSdef, Nat.card_zpowers]
    exact orderOf_eq_prime e7_pow_seven e7_ne_one
  have hX : Nat.card ↥X = 3 := by
    rw [hXdef, Nat.card_zpowers]
    exact orderOf_eq_prime e3_pow_three e3_ne_one
  -- `X` normalises `S`
  have hNX : X ≤ Subgroup.normalizer (S : Set (MulAut (Multiplicative (Fin 3 → ZMod 2)))) := by
    rw [hXdef]
    rw [Subgroup.zpowers_le, hSdef]
    exact mem_normalizer_zpowers_of_zpowers_conj e7 e3 (by rw [e3_conj_e7]; exact zpowers_e7_sq)
  -- the two cyclic subgroups meet trivially
  have hSX : S ⊓ X = ⊥ := by
    rw [hSdef, hXdef]
    exact inf_zpowers_eq_bot_of_coprime e7 e3 e7_pow_seven e3_pow_three (by decide)
  haveI : Finite ↥S := inferInstance
  haveI : Finite ↥X := inferInstance
  refine ⟨S ⊔ X, ?_, ?_⟩
  · -- `|⟨e7⟩ ⊔ ⟨e3⟩| = 7 * 3 = 21`
    have h := Work.PGroup.card_sup_mul_card_inf_of_le_normalizer (H := S) (K := X) hNX
    rw [hSX, hS, hX, Subgroup.card_bot] at h
    omega
  · -- the witnesses
    let s : ↥(S ⊔ X) := ⟨e7, Subgroup.mem_sup_left (Subgroup.mem_zpowers e7)⟩
    let t : ↥(S ⊔ X) := ⟨e3, Subgroup.mem_sup_right (Subgroup.mem_zpowers e3)⟩
    refine ⟨s, t, ?_, ?_, ?_⟩
    · have hs : (s : MulAut (Multiplicative (Fin 3 → ZMod 2))) = e7 := rfl
      rw [← Subgroup.orderOf_coe s, hs]
      exact orderOf_eq_prime e7_pow_seven e7_ne_one
    · have ht : (t : MulAut (Multiplicative (Fin 3 → ZMod 2))) = e3 := rfl
      rw [← Subgroup.orderOf_coe t, ht]
      exact orderOf_eq_prime e3_pow_three e3_ne_one
    · intro hconj
      have hval : e3 * e7 * e3⁻¹ = e7 := by
        have h1 := congrArg
          (fun z : ↥(S ⊔ X) => (z : MulAut (Multiplicative (Fin 3 → ZMod 2)))) hconj
        simpa only [Subgroup.coe_mul, Subgroup.coe_inv, s, t] using h1
      have hfix := fixed_point_free_zpowers e7 e3 e7_pow_seven e3_pow_three e3_conj_e7
        e3 (Subgroup.mem_zpowers e3) e3_ne_one e7 (Subgroup.mem_zpowers e7) hval
      exact e7_ne_one hfix

/-- **Transport across a group isomorphism.**  If an isomorphic copy of `G` carries a subgroup of
`MulAut G` of order `21` with non-commuting elements of orders `7` and `3`, then so does `U`. -/
theorem transport_order21 {U G : Type*} [Group U] [Group G] (e : U ≃* G)
    (h : ∃ A : Subgroup (MulAut G), Nat.card A = 21 ∧
      ∃ s t : ↥A, orderOf s = 7 ∧ orderOf t = 3 ∧ t * s * t⁻¹ ≠ s) :
    ∃ A : Subgroup (MulAut U), Nat.card A = 21 ∧
      ∃ s t : ↥A, orderOf s = 7 ∧ orderOf t = 3 ∧ t * s * t⁻¹ ≠ s := by
  obtain ⟨A, hA, s, t, hs, ht, hne⟩ := h
  let F : MulAut U ≃* MulAut G := MulAut.congr e
  let A' : Subgroup (MulAut U) := A.map F.symm.toMonoidHom
  let Φ : ↥A ≃* ↥A' :=
    { toFun := fun x => ⟨F.symm (x : MulAut G), Subgroup.mem_map_of_mem _ x.2⟩
      invFun := fun y => ⟨F (y : MulAut U), by
        obtain ⟨a, ha, hae⟩ := Subgroup.mem_map.mp y.2
        rw [← hae]
        simpa using ha⟩
      left_inv := by
        intro x
        apply Subtype.ext
        simp
      right_inv := by
        intro y
        apply Subtype.ext
        simp
      map_mul' := by
        intro x y
        apply Subtype.ext
        simp [map_mul] }
  refine ⟨A', ?_, Φ s, Φ t, ?_, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective F.symm.injective]
    exact hA
  · exact (orderOf_injective (Φ : ↥A →* ↥A') Φ.injective s).trans hs
  · exact (orderOf_injective (Φ : ↥A →* ↥A') Φ.injective t).trans ht
  · intro hconj
    apply hne
    apply Φ.injective
    rw [map_mul, map_mul, map_inv]
    exact hconj

/-- **`(ℤ/2)³` classification.**  A finite group of order `8` and exponent `2` is elementary
abelian of rank `3`, hence isomorphic to `Multiplicative (Fin 3 → ZMod 2) = (ℤ/2)³`. -/
theorem iso_fin3 {U : Type*} [Group U] [Finite U] (hcard : Nat.card U = 8)
    (hexp : ∀ x : U, x * x = 1) :
    Nonempty (U ≃* Multiplicative (Fin 3 → ZMod 2)) := by
  -- a group of exponent `2` is commutative
  have habel : ∀ x y : U, x * y = y * x := by
    intro x y
    have hx : x⁻¹ = x := inv_eq_of_mul_eq_one_left (hexp x)
    have hy : y⁻¹ = y := inv_eq_of_mul_eq_one_left (hexp y)
    calc x * y = (x * y)⁻¹ := eq_inv_of_mul_eq_one_left (hexp (x * y))
      _ = y⁻¹ * x⁻¹ := by rw [mul_inv_rev]
      _ = y * x := by rw [hy, hx]
  obtain ⟨n, ⟨e⟩⟩ := Work.Hering.F2.groups_of_exponent_two habel hexp
  -- the rank is pinned down by the cardinality
  have hn : n = 3 := by
    have h1 : Nat.card U = Nat.card (Multiplicative (Fin n → ZMod 2)) := Nat.card_congr e.toEquiv
    rw [hcard] at h1
    have hmult : Nat.card (Multiplicative (Fin n → ZMod 2)) = Nat.card (Fin n → ZMod 2) :=
      Nat.card_congr
        { toFun := Multiplicative.toAdd
          invFun := Multiplicative.ofAdd
          left_inv := fun x => rfl
          right_inv := fun x => rfl }
    have hcardn : Nat.card (Fin n → ZMod 2) = 2 ^ n := by simp
    have hpow : 2 ^ n = 8 := by rw [← hcardn, ← hmult, ← h1]
    have h23 : 2 ^ n = 2 ^ 3 := by rw [hpow]; norm_num
    exact Nat.pow_right_injective (le_refl 2) h23
  rw [hn] at e
  exact ⟨e⟩

/-- **Bender–Suzuki, Step 5 local structure.**  Let `U` be a finite group of order `8` all of
whose elements are involutions.  Then `MulAut U ≅ GL(3,2)` contains a subgroup `A` of order `21`
with elements `s`, `t` of orders `7`, `3` such that `t * s * t⁻¹ ≠ s`. -/
theorem mulAut_eight_order21 {U : Type*} [Group U] [Finite U] (hcard : Nat.card U = 8)
    (hexp : ∀ x : U, x * x = 1) :
    ∃ A : Subgroup (MulAut U), Nat.card A = 21 ∧
      ∃ s t : ↥A, orderOf s = 7 ∧ orderOf t = 3 ∧ t * s * t⁻¹ ≠ s := by
  obtain ⟨e⟩ := iso_fin3 hcard hexp
  exact transport_order21 e order21_canonical

end Work.Hering.Step5
