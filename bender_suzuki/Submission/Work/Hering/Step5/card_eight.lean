/-! ## Elementary counting lemmas -/

/-- `2 ^ k` is odd only for `k = 0`. -/
private lemma eq_zero_of_odd_two_pow {k : ℕ} (h : Odd (2 ^ k)) : k = 0 := by
  by_contra hk
  have hdvd : 2 ∣ 2 ^ k := dvd_pow_self 2 hk
  exact ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp h.coprime_two_left) hdvd

/-- A subgroup of a `2`-group of order at least `4` contains a subgroup of order `4`. -/
private lemma exists_card_four_le {W : Subgroup G} (hW : IsPGroup 2 W) (h4W : 4 ≤ Nat.card W) :
    ∃ W₀ : Subgroup G, W₀ ≤ W ∧ Nat.card W₀ = 4 := by
  have h4' : 2 ^ 2 ≤ Nat.card ↥(⊤ : Subgroup ↥W) := by simpa using h4W
  obtain ⟨W₀, -, hcard⟩ :=
    Sylow.exists_subgroup_le_card_pow_prime_of_le_card (p := 2) (n := 2) Nat.prime_two hW h4'
  exact ⟨W₀.map W.subtype, Subgroup.map_subtype_le W₀, by
    rw [Subgroup.card_map_of_injective W.subtype_injective]; exact hcard⟩

/-- A `2`-group without a subgroup of order `4` has at most `2` elements. -/
private lemma card_le_two_of_no_four {W : Subgroup G} (hW : IsPGroup 2 W)
    (h : ¬ ∃ W₀ : Subgroup G, W₀ ≤ W ∧ Nat.card W₀ = 4) : Nat.card W ≤ 2 := by
  obtain ⟨k, hk⟩ := hW.exists_card_eq
  match k with
  | 0 => rw [hk, pow_zero]; norm_num
  | 1 => rw [hk]; norm_num
  | k + 2 =>
    have h4 : 4 ≤ Nat.card ↥W := by
      rw [hk]
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ (k + 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact absurd (exists_card_four_le hW h4) h

/-- A subgroup containing three pairwise distinct elements has at least three elements. -/
private lemma three_le_card_of_mem_of_ne {W : Subgroup G} {a b c : G} (ha : a ∈ W) (hb : b ∈ W)
    (hc : c ∈ W) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) : 3 ≤ Nat.card W := by
  let f : Fin 3 → ↥W := fun i =>
    if i = 0 then ⟨a, ha⟩ else if i = 1 then ⟨b, hb⟩ else ⟨c, hc⟩
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f]
  have hcard := Nat.card_le_card_of_injective f hf
  rwa [Nat.card_fin] at hcard

/-- In a subgroup with at most two elements, two elements different from `1` are equal. -/
private lemma eq_of_ne_one_of_card_le_two {W : Subgroup G} (hW : Nat.card W ≤ 2) {a b : G}
    (ha : a ∈ W) (hb : b ∈ W) (ha1 : a ≠ 1) (hb1 : b ≠ 1) : a = b := by
  by_contra hab
  have h3 : 3 ≤ Nat.card W :=
    three_le_card_of_mem_of_ne (W := W) (a := 1) (b := a) (c := b) W.one_mem ha hb
      (Ne.symm ha1) (Ne.symm hb1) hab
  omega

/-! ## Subgroup-theoretic consequences of the configuration -/

section VFacts

/-- If the centralizer of every `4`-subgroup of `V` is a `2`-group, then for every subgroup
`H ≤ G` of odd order `> 1` the centralizer `C_V(H)` has at most two elements. -/
lemma card_centralizer_inf_le_two {V : Subgroup G} (hV2 : IsPGroup 2 V)
    (hC : ∀ W : Subgroup G, W ≤ V → Nat.card W = 4 →
      IsPGroup 2 ↥(Subgroup.centralizer (W : Set G)))
    {H : Subgroup G} (hodd : Odd (Nat.card H)) (h1 : 1 < Nat.card H) :
    Nat.card ↥(V ⊓ Subgroup.centralizer (H : Set G)) ≤ 2 := by
  refine card_le_two_of_no_four (hV2.to_le inf_le_left) ?_
  rintro ⟨W₀, hW₀le, hW₀card⟩
  have hW₀V : W₀ ≤ V := hW₀le.trans inf_le_left
  have hCW : IsPGroup 2 ↥(Subgroup.centralizer (W₀ : Set G)) := hC W₀ hW₀V hW₀card
  have hHle : H ≤ Subgroup.centralizer (W₀ : Set G) := by
    intro y hy
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    have hw2 : w ∈ Subgroup.centralizer (H : Set G) := (Subgroup.mem_inf.mp (hW₀le hw)).2
    exact ((Subgroup.mem_centralizer_iff.mp hw2) y hy).symm
  obtain ⟨k, hk⟩ := (hCW.to_le hHle).exists_card_eq
  have hk0 : k = 0 := eq_zero_of_odd_two_pow (by rw [← hk]; exact hodd)
  rw [hk, hk0, pow_zero] at h1
  exact absurd h1 (lt_irrefl 1)

/-- If `u ∈ U`, `u ≠ 1`, centralises `H`, and `C_V(H)` has at most two elements, then
`C_V(H) ≤ U`. -/
lemma inf_centralizer_le_of_exists {V U H : Subgroup G} (hU : U ≤ V)
    (hcard : Nat.card ↥(V ⊓ Subgroup.centralizer (H : Set G)) ≤ 2)
    (h : ∃ u ∈ U, u ≠ 1 ∧ ∀ y ∈ H, y * u = u * y) :
    V ⊓ Subgroup.centralizer (H : Set G) ≤ U := by
  obtain ⟨u, huU, hu1, huc⟩ := h
  set C : Subgroup G := Subgroup.centralizer (H : Set G) with hCdef
  have huC : u ∈ U ⊓ C := by
    refine Subgroup.mem_inf.mpr ⟨huU, ?_⟩
    rw [Subgroup.mem_centralizer_iff]
    exact huc
  have hne : U ⊓ C ≠ ⊥ := by
    intro hbot
    have : u ∈ (⊥ : Subgroup G) := by rw [← hbot]; exact huC
    exact hu1 (by simpa using this)
  have h1 : 1 < Nat.card ↥(U ⊓ C) := by
    rw [lt_iff_not_ge]
    intro hle
    exact hne (Subgroup.eq_bot_of_card_le (U ⊓ C) hle)
  have hle : U ⊓ C ≤ V ⊓ C := inf_le_inf_right C hU
  have hcard' : Nat.card ↥(V ⊓ C) ≤ Nat.card ↥(U ⊓ C) := by omega
  exact ((Subgroup.eq_of_le_of_card_ge hle hcard').ge).trans inf_le_left

/-- If `T` normalises `S`, `V` is normal and `C_V(S)` has at most two elements, then
`C_V(S) ≤ C_V(T)`: an element of order `3` cannot act non-trivially on a group of order `≤ 2`. -/
lemma inf_centralizer_le_of_normalizer {V S T : Subgroup G} (hVn : V.Normal)
    (hTS : T ≤ Subgroup.normalizer (S : Set G))
    (hcard : Nat.card ↥(V ⊓ Subgroup.centralizer (S : Set G)) ≤ 2) :
    V ⊓ Subgroup.centralizer (S : Set G) ≤ V ⊓ Subgroup.centralizer (T : Set G) := by
  intro v hv
  obtain ⟨hvV, hvC⟩ := Subgroup.mem_inf.mp hv
  refine Subgroup.mem_inf.mpr ⟨hvV, ?_⟩
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  rcases eq_or_ne v 1 with rfl | hv1
  · simp
  have hxinv : x⁻¹ ∈ Subgroup.normalizer (S : Set G) :=
    (Subgroup.normalizer (S : Set G)).inv_mem (hTS hx)
  have hxvW : x * v * x⁻¹ ∈ V ⊓ Subgroup.centralizer (S : Set G) := by
    refine Subgroup.mem_inf.mpr ⟨hVn.conj_mem v hvV x, ?_⟩
    rw [Subgroup.mem_centralizer_iff]
    intro s hs
    have hs' : x⁻¹ * s * x ∈ S := by
      simpa using ((Subgroup.mem_normalizer_iff.mp hxinv) s).mp hs
    have hcomm := (Subgroup.mem_centralizer_iff.mp hvC) (x⁻¹ * s * x) hs'
    calc s * (x * v * x⁻¹) = x * ((x⁻¹ * s * x) * v) * x⁻¹ := by group
      _ = x * (v * (x⁻¹ * s * x)) * x⁻¹ := by rw [hcomm]
      _ = (x * v * x⁻¹) * s := by group
  have hne : x * v * x⁻¹ ≠ 1 := by
    intro h
    have h2 : x⁻¹ * (x * v * x⁻¹) * x = 1 := by rw [h]; simp
    have h3 : x⁻¹ * (x * v * x⁻¹) * x = v := by group
    rw [h3] at h2
    exact hv1 h2
  have hEq : v = x * v * x⁻¹ := eq_of_ne_one_of_card_le_two hcard hv hxvW hv1 hne
  have h2 : x⁻¹ * v * x = v := by
    have := congrArg (fun t => x⁻¹ * t * x) hEq
    simpa [mul_assoc] using this
  calc x * v = x * (x⁻¹ * v * x) := by rw [h2]
    _ = v * x := by group

end VFacts

/-! ## Transfer of a Frobenius group of order `21` from `↥L` to `G` -/

/-- Transport of the structure of a non-abelian group of order `21`, given as subgroups of
`L ≤ G`, into `G` (via the inclusion `↥L → G`). -/
lemma transfer_order21 {L : Subgroup G} {S X : Subgroup ↥L} (hSnorm : S.Normal)
    (hScard : Nat.card S = 7) (hXcard : Nat.card X = 3) (hinf : S ⊓ X = ⊥) (hsup : S ⊔ X = ⊤)
    (hcent : S ⊓ Subgroup.centralizer (X : Set ↥L) = ⊥) (hcomm : ⁅X, S⁆ = S) :
    ∃ S' X' : Subgroup G, S' ≤ L ∧ X' ≤ L ∧ (S'.subgroupOf L).Normal ∧ Nat.card S' = 7 ∧
      Nat.card X' = 3 ∧ S' ⊓ X' = ⊥ ∧ S' ⊔ X' = L ∧
      S' ⊓ Subgroup.centralizer (X' : Set G) = ⊥ ∧ ⁅X', S'⁆ = S' := by
  refine ⟨S.map L.subtype, X.map L.subtype, Subgroup.map_subtype_le S, Subgroup.map_subtype_le X,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have hsub : (S.map L.subtype).subgroupOf L = S := by
      ext g
      constructor
      · intro hg
        rw [Subgroup.mem_subgroupOf, Subgroup.mem_map] at hg
        obtain ⟨s, hs, hsg⟩ := hg
        rw [← Subtype.ext hsg]
        exact hs
      · intro hg
        rw [Subgroup.mem_subgroupOf, Subgroup.mem_map]
        exact ⟨g, hg, rfl⟩
    rw [hsub]; exact hSnorm
  · rw [Subgroup.card_map_of_injective L.subtype_injective]; exact hScard
  · rw [Subgroup.card_map_of_injective L.subtype_injective]; exact hXcard
  · rw [← Subgroup.map_inf S X L.subtype L.subtype_injective, hinf, Subgroup.map_bot]
  · rw [← Subgroup.map_sup S X L.subtype, hsup, ← Subgroup.top_subgroupOf L,
      Subgroup.subgroupOf_map_subtype]
    simp
  · refine le_antisymm ?_ bot_le
    intro g hg
    obtain ⟨hgS, hgC⟩ := Subgroup.mem_inf.mp hg
    rw [Subgroup.mem_map] at hgS
    obtain ⟨s, hsS, hsg⟩ := hgS
    have hs1 : s = 1 := by
      have hmem : s ∈ S ⊓ Subgroup.centralizer (X : Set ↥L) := by
        refine Subgroup.mem_inf.mpr ⟨hsS, ?_⟩
        rw [Subgroup.mem_centralizer_iff]
        intro x hx
        apply Subtype.ext
        have hxg : L.subtype x ∈ X.map L.subtype := Subgroup.mem_map_of_mem L.subtype hx
        have hcomm' := (Subgroup.mem_centralizer_iff.mp hgC) (L.subtype x) hxg
        rw [← hsg] at hcomm'
        simpa using hcomm'
      rw [hcent] at hmem
      simpa using hmem
    exact Subgroup.mem_bot.mpr (by rw [← hsg, hs1]; simp)
  · rw [← Subgroup.map_commutator X S L.subtype, hcomm]

/-! ## The main theorem -/

theorem card_eight {G : Type*} [Group G] [Finite G] {hDT : DTInv G} {h4 : HasFourGroup G}
    (hWagner : WagnerProp) (hAppVII : AppVIIProp)
    (hC : ∀ U : Subgroup G, U ≤ invSubgroup hDT h4 → Nat.card U = 4 →
      IsPGroup 2 ↥(Subgroup.centralizer (U : Set G)))
    (h8 : 8 ≤ Nat.card ↥(invSubgroup hDT h4)) :
    Nat.card ↥(invSubgroup hDT h4) = 8 := by
  classical
  set V : Subgroup G := invSubgroup hDT h4 with hVdef
  have hVn : V.Normal := by rw [hVdef]; exact invSubgroup_normal hDT h4
  have hV2 : IsPGroup 2 V := by rw [hVdef]; exact isPGroup_invSubgroup hDT h4
  have hCV : ∀ W : Subgroup G, W ≤ V → Nat.card W = 4 →
      IsPGroup 2 ↥(Subgroup.centralizer (W : Set G)) :=
    fun W hW => hC W (hW.trans hVdef.le)
  -- ## Step 1: a subgroup `U ≤ V` of order `8`
  obtain ⟨U, hUV, hUcard⟩ :=
    Work.Hering.V.exists_subgroup_card_eight hDT h4 (by rw [← hVdef]; exact h8)
  -- ## Step 2: Wagner's proposition: `N_G(U)` covers `Aut U`
  have hsurj := wagner_surjective hWagner (hUV.trans hVdef.le) hUcard
  -- ## Step 3: a Frobenius group of order `21` in `Aut U`, lifted to a subgroup `L ≤ N_G(U)`
  have hexpU : ∀ x : U, x * x = 1 := fun x =>
    Subtype.ext (pow_two_eq_one_of_mem_invSubgroup hDT h4 (hVdef.le (hUV x.2)))
  obtain ⟨Λ, hΛcard, s, t, hs, ht, hst⟩ := mulAut_eight_order21 hUcard hexpU
  have hΛnab : ∃ a b : ↥Λ, a * b ≠ b * a := ⟨s, t, fun h => hst (by rw [h.symm]; group)⟩
  have hCU2 : IsPGroup 2 ↥(Subgroup.centralizer (U : Set G)) := by
    obtain ⟨W, hWU, hWcard⟩ := exists_card_four_le ((hV2.to_le hUV)) (by rw [hUcard]; norm_num)
    exact (hCV W (hWU.trans hUV) hWcard).to_le
      (Subgroup.centralizer_le (fun x hx => hWU hx))
  obtain ⟨L, hLcard, hLnorm, -, hLnab⟩ :=
    exists_order21_le_normalizer Λ hΛcard hΛnab hsurj hCU2
  obtain ⟨S, X, hSnorm, hScard, hXcard, hSXinf, hSXsup, hSXcent, hSXcomm⟩ :=
    order21_structure hLcard hLnab
  obtain ⟨S', X', hS'le, hX'le, hS'norm, hS'card, hX'card, hS'X'inf, hS'X'sup, hS'X'cent,
    hX'S'comm⟩ := transfer_order21 hSnorm hScard hXcard hSXinf hSXsup hSXcent hSXcomm
  -- ## Step 4: the centralizers in `V` of `S'`, `X'` and its conjugates lie in `U`
  have hcardCS : Nat.card ↥(V ⊓ Subgroup.centralizer (S' : Set G)) ≤ 2 :=
    card_centralizer_inf_le_two hV2 hCV (by rw [hS'card]; norm_num) (by rw [hS'card]; norm_num)
  have hCXU : V ⊓ Subgroup.centralizer (X' : Set G) ≤ U :=
    inf_centralizer_le_of_exists hUV
      (card_centralizer_inf_le_two hV2 hCV (by rw [hX'card]; norm_num)
        (by rw [hX'card]; norm_num))
      (exists_nonidentity_centralizing_of_card_three (hX'le.trans hLnorm) hX'card hUcard)
  haveI : (S'.subgroupOf L).Normal := hS'norm
  have hLnS : L ≤ Subgroup.normalizer (S' : Set G) :=
    Subgroup.le_normalizer_of_normal_subgroupOf hS'le
  have hCSU : V ⊓ Subgroup.centralizer (S' : Set G) ≤ U :=
    (inf_centralizer_le_of_normalizer hVn (hX'le.trans hLnS) hcardCS).trans hCXU
  -- ## Step 5: Appendix VII
  obtain ⟨m, hm⟩ := Work.Hering.V.card_eq_two_pow hDT h4
  have hcop : Nat.Coprime (Nat.card V) (Nat.card L) := by
    rw [hLcard, hVdef, hm]
    exact (show Nat.Coprime 2 21 from by norm_num).pow_left m
  have hodd : Odd (Nat.card ↥(S' ⊓ Subgroup.centralizer (X' : Set G))) := by
    rw [hS'X'cent, Subgroup.card_bot]
    exact ⟨0, rfl⟩
  have hgen := appVII_conj hAppVII hVn hX'le hS'le hS'norm (by rw [inf_comm]; exact hS'X'inf)
    (by rw [sup_comm]; exact hS'X'sup) Nat.prime_three hX'card (by rw [hS'card]; norm_num)
    hcop hodd
  -- ## Conclusion: the generators of `V` all lie in `U`, hence `V = U`
  have hVU : V = U := by
    refine le_antisymm (hgen.trans ?_) hUV
    rw [Subgroup.closure_le]
    intro v hv
    rcases hv with hv | hv
    · -- `v` is centralised by `S' = ⁅X', S'⁆`
      obtain ⟨hvV, hvcomm⟩ := hv
      refine hCSU (Subgroup.mem_inf.mpr ⟨hvV, ?_⟩)
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      have hw' : w ∈ ⁅X', S'⁆ := by rw [hX'S'comm]; exact hw
      have := hvcomm w hw'
      rwa [mul_inv_eq_iff_eq_mul] at this
    · -- `v` is centralised by a conjugate of `X'`
      obtain ⟨hvV, x, hx⟩ := hv
      let H : Subgroup G := X'.map (MulAut.conj ((x : ↥S') : G)).toMonoidHom
      have hHcard : Nat.card H = 3 := by
        rw [Subgroup.card_map_of_injective (MulAut.conj ((x : ↥S') : G)).injective]
        exact hX'card
      have hHN : H ≤ Subgroup.normalizer (U : Set G) := by
        intro y hy
        rw [Subgroup.mem_map] at hy
        obtain ⟨z, hz, hzy⟩ := hy
        rw [← hzy]
        exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hLnorm (hS'le x.2)) (hLnorm (hX'le hz)))
          (Subgroup.inv_mem _ (hLnorm (hS'le x.2)))
      have hmem : v ∈ V ⊓ Subgroup.centralizer (H : Set G) := by
        refine Subgroup.mem_inf.mpr ⟨hvV, ?_⟩
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        have := hx y hy
        rwa [mul_inv_eq_iff_eq_mul] at this
      exact inf_centralizer_le_of_exists hUV
        (card_centralizer_inf_le_two hV2 hCV (by rw [hHcard]; norm_num)
          (by rw [hHcard]; norm_num))
        (exists_nonidentity_centralizing_of_card_three hHN hHcard hUcard) hmem
  rw [hVU, hUcard]

end Work.Hering.Step5
