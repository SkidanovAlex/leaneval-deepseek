import Mathlib
import Submission.Work.Hering.AppVII.Setup

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `appVIIZ` is natural under an equivariant pair of isomorphisms

`appVIIZ A P Q K` is generated by the fixed points in `K` of `⁅P,Q⁆` and of the conjugates
`P^x` (`x ∈ Q`).  It is manifestly built out of data that are transported by group
isomorphisms: if `eA : A ≃* A'` and `eK : K ≃* K'` intertwine the two actions
(`eK (a • k) = eA a • eK k`), then `appVIIZ` for `(A', P.map eA, Q.map eA, K')` is exactly the
image under `eK` of `appVIIZ` for `(A, P, Q, K)`.

The work is done by the auxiliary notion `fixing H K` — the subgroup of `K` fixed pointwise by
`H ≤ A` — and the transport lemma `map_fixing` for it; `appVIIF1` and `appVIIFx` are literally
instances of `fixing`, so the statement follows by reducing the closure of a union of two
particular `fixing`s to the closure of the images.

This is used to move the Appendix VII configuration across isomorphic settings (compare the
sibling results `appVIIZ_map_eq` / `appVIIZ_quotient_eq` for the case of a single ambient group
`K` and a compatible homomorphism of acting groups).
-/

set_option autoImplicit false

open scoped Pointwise

namespace Work.Hering.AppVII

universe u u' v v'

/-- The subgroup of `K` of elements fixed pointwise by every element of `H ≤ A`. -/
def fixing {A : Type u} [Group A] (H : Subgroup A) (K : Type v) [Group K]
    [MulDistribMulAction A K] : Subgroup K where
  carrier := {k : K | ∀ y ∈ H, y • k = k}
  mul_mem' := by
    intro x y hx hy z hz
    rw [smul_mul', hx z hz, hy z hz]
  one_mem' := by intro z _; exact smul_one z
  inv_mem' := by intro x hx z hz; rw [smul_inv', hx z hz]

/-- `appVIIF1` is `fixing` for the commutator `⁅P,Q⁆`. -/
theorem appVIIF1_eq_fixing {A : Type u} [Group A] (P Q : Subgroup A) (K : Type v) [Group K]
    [MulDistribMulAction A K] : appVIIF1 A P Q K = fixing (⁅P, Q⁆ : Subgroup A) K := rfl

/-- `appVIIFx` is `fixing` for the conjugate `P^x`. -/
theorem appVIIFx_eq_fixing {A : Type u} [Group A] (P Q : Subgroup A) (K : Type v) [Group K]
    [MulDistribMulAction A K] (x : ↥Q) :
    appVIIFx A P Q K x = fixing (P.map (MulAut.conj (x : A)).toMonoidHom) K := rfl

/-- **Transport of the fixed-point subgroup.**  If `eA : A ≃* A'` and `eK : K ≃* K'` intertwine
the actions (`eK (a • k) = eA a • eK k`), then the fixed points of `H ≤ A` map onto the fixed
points of `H.map eA`. -/
theorem map_fixing {A : Type u} {A' : Type u'} {K : Type v} {K' : Type v'}
    [Group A] [Group A'] [Group K] [Group K']
    [MulDistribMulAction A K] [MulDistribMulAction A' K']
    (eA : A ≃* A') (eK : K ≃* K')
    (hact : ∀ (a : A) (k : K), eK (a • k) = eA a • eK k) (H : Subgroup A) :
    (fixing H K).map eK.toMonoidHom = fixing (H.map eA.toMonoidHom) K' := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    intro k hk y hy
    obtain ⟨y₀, hy₀, rfl⟩ := Subgroup.mem_map.mp hy
    show eA y₀ • eK k = eK k
    rw [← hact y₀ k, hk y₀ hy₀]
  · intro k' hk'
    refine Subgroup.mem_map.mpr ⟨eK.symm k', ?_, eK.apply_symm_apply k'⟩
    intro y hy
    show y • eK.symm k' = eK.symm k'
    refine eK.injective ?_
    show eK (y • eK.symm k') = eK (eK.symm k')
    rw [hact y (eK.symm k'), eK.apply_symm_apply]
    exact hk' (eA y) (Subgroup.mem_map.mpr ⟨y, hy, rfl⟩)

/-- Conjugation interacts with a group isomorphism: the image of `P^x` is `(P.map eA)^{eA x}`. -/
theorem map_conj_map {A : Type u} {A' : Type u'} [Group A] [Group A'] (eA : A ≃* A')
    (P : Subgroup A) (x : A) :
    (P.map (MulAut.conj x).toMonoidHom).map eA.toMonoidHom
      = (P.map eA.toMonoidHom).map (MulAut.conj (eA x)).toMonoidHom := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  ext a
  simp [MulAut.conj_apply]

theorem map_appVIIZ_equiv {A : Type u} {A' : Type u'} {K : Type v} {K' : Type v'}
    [Group A] [Group A'] [Group K] [Group K']
    [MulDistribMulAction A K] [MulDistribMulAction A' K']
    (eA : A ≃* A') (eK : K ≃* K')
    (hact : ∀ (a : A) (k : K), eK (a • k) = eA a • eK k) (P Q : Subgroup A) :
    (appVIIZ A P Q K).map eK.toMonoidHom
      = appVIIZ A' (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) K' := by
  -- The generators of the first family correspond.
  have hF1 : (appVIIF1 A P Q K).map eK.toMonoidHom
      = appVIIF1 A' (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) K' := by
    show (fixing ⁅P, Q⁆ K).map eK.toMonoidHom
      = fixing ⁅P.map eA.toMonoidHom, Q.map eA.toMonoidHom⁆ K'
    rw [map_fixing eA eK hact, Subgroup.map_commutator]
  -- The generators of the second family correspond, `x ↦ eA x`.
  have hFx : ∀ x : ↥Q, (appVIIFx A P Q K x).map eK.toMonoidHom
      = appVIIFx A' (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) K'
          ⟨eA (x : A), Subgroup.mem_map.mpr ⟨x, x.2, rfl⟩⟩ := by
    intro x
    show (fixing (P.map (MulAut.conj (x : A)).toMonoidHom) K).map eK.toMonoidHom
      = fixing ((P.map eA.toMonoidHom).map (MulAut.conj (eA (x : A))).toMonoidHom) K'
    rw [map_fixing eA eK hact, map_conj_map]
  apply le_antisymm
  · rw [appVIIZ, Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
    rintro k (hk | ⟨x, hx⟩)
    · refine appVIIF1_le_appVIIZ A' (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) K' ?_
      rw [← hF1]
      exact Subgroup.mem_map.mpr ⟨k, hk, rfl⟩
    · refine appVIIFx_le_appVIIZ A' (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) K'
        ⟨eA (x : A), Subgroup.mem_map.mpr ⟨x, x.2, rfl⟩⟩ ?_
      rw [← hFx x]
      exact Subgroup.mem_map.mpr ⟨k, hx, rfl⟩
  · rw [appVIIZ, Subgroup.closure_le]
    rintro k' (hk' | ⟨x', hx'⟩)
    · rw [← hF1] at hk'
      obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.mp hk'
      exact Subgroup.mem_map.mpr ⟨k, appVIIF1_le_appVIIZ A P Q K hk, rfl⟩
    · -- `x'` lies in the image of `↥Q`, since `Q' = Q.map eA`
      obtain ⟨x, hxQ, hxeq⟩ := Subgroup.mem_map.mp x'.2
      have hx'e : x' = ⟨eA (x : A), Subgroup.mem_map.mpr ⟨x, hxQ, rfl⟩⟩ :=
        Subtype.ext hxeq.symm
      rw [hx'e] at hx'
      rw [← hFx ⟨x, hxQ⟩] at hx'
      obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.mp hx'
      exact Subgroup.mem_map.mpr ⟨k, appVIIFx_le_appVIIZ A P Q K ⟨x, hxQ⟩ hk, rfl⟩

end Work.Hering.AppVII
