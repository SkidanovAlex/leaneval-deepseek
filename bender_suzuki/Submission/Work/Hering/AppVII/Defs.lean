import Submission.Work.Hering.Perm.Defs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# Appendix VII of Peterfalvi I (p. 216)

Let `Q ⋊ P` act on a group `K`, with `|P| = p` prime, `p ∤ |Q|`, `|C_Q(P)|` odd and
`(|K|, |Q ⋊ P|) = 1`. Then `K` is generated by `C_K(⁅P,Q⁆)` together with the `C_K(P^x)`,
`x ∈ Q`.

Stated with `P`, `Q` subgroups of the acting group `A` with `Q` normal, `P ⊓ Q = ⊥`,
`P ⊔ Q = ⊤`, and an arbitrary `MulAction A K`.
-/

set_option autoImplicit false

namespace Work.Hering

/-- Appendix VII of Peterfalvi I (p. 216), as a `Prop`. The hypothesis `[MulDistribMulAction A K]`
records that in the source `K ⋊ (Q ⋊ P)` acts on `K`, i.e. `A` acts on `K` **by group
automorphisms**; this is used in the reduction of `Hering` (the action of a subgroup of `G` on
`V` by conjugation). -/
def AppVIIProp : Prop :=
  ∀ {A : Type*} [Group A] [Finite A] (P Q : Subgroup A) (hQn : Q.Normal)
    (hinf : P ⊓ Q = ⊥) (hsup : P ⊔ Q = ⊤)
    (p : ℕ) (hp : p.Prime) (hcardP : Nat.card ↥P = p) (hpQ : ¬ p ∣ Nat.card ↥Q)
    {K : Type*} [Group K] [Finite K] [MulDistribMulAction A K]
    (hcop : Nat.Coprime (Nat.card K) (Nat.card A))
    (hodd : Odd (Nat.card ↥(Q ⊓ Subgroup.centralizer (P : Set A)))),
    Subgroup.closure ({k : K | ∀ y ∈ (⁅P, Q⁆ : Subgroup A), y • k = k} ∪
        {k : K | ∃ x : ↥Q, ∀ y ∈ P.map (MulAut.conj (x : A)).toMonoidHom, y • k = k}) = ⊤

/-- The version of Appendix VII with an *arbitrary* `MulAction` in place of an action by group
automorphisms. It is **false**: see `Work.Hering.AppVII.not_appVIIPropArbitrary`. -/
def AppVIIPropArbitrary : Prop :=
  ∀ {A : Type*} [Group A] [Finite A] (P Q : Subgroup A) (hQn : Q.Normal)
    (hinf : P ⊓ Q = ⊥) (hsup : P ⊔ Q = ⊤)
    (p : ℕ) (hp : p.Prime) (hcardP : Nat.card ↥P = p) (hpQ : ¬ p ∣ Nat.card ↥Q)
    {K : Type*} [Group K] [Finite K] [MulAction A K]
    (hcop : Nat.Coprime (Nat.card K) (Nat.card A))
    (hodd : Odd (Nat.card ↥(Q ⊓ Subgroup.centralizer (P : Set A)))),
    Subgroup.closure ({k : K | ∀ y ∈ (⁅P, Q⁆ : Subgroup A), y • k = k} ∪
        {k : K | ∃ x : ↥Q, ∀ y ∈ P.map (MulAut.conj (x : A)).toMonoidHom, y • k = k}) = ⊤

end Work.Hering
