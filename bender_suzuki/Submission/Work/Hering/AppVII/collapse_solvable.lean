/-!
# `Work.Hering.AppVII.collapse_solvable`

The reduction step of Appendix VII (Peterfalvi I, p. 216) which *collapses* a configuration in
which the coefficient group `K` has a non-trivial proper `A`-invariant normal subgroup `N` that is
**solvable**: under the strong induction hypothesis

`ih : ∀ m < n, AppVIIStmt m`

for the induction measure `n = |A|·|K|`, a configuration with such an `N` still satisfies
`appVIIZ A P Q K = ⊤`.

The argument is the standard two-step descent for `Z = appVIIZ A P Q K`, using that both `N` and
the quotient `K ⧸ N` are strictly smaller coefficient groups than `K` (because `N` is neither
`⊥` nor `⊤`):

* applying the induction hypothesis to the configuration with coefficient group `↥N` gives
  `appVIIZ A P Q ↥N = ⊤`, and `map_subtype_appVIIZ_le` then yields `N ≤ Z`;
* applying the induction hypothesis to the configuration with coefficient group `K ⧸ N` gives
  `appVIIZ A P Q (K ⧸ N) = ⊤`; the image `Z ⧸ N` of `Z` in `K ⧸ N` is generated by the images of
  the generators of `Z` (Gaschütz's lemma `C_{K/N}(H) = C_K(H)·N/N` for the solvable coefficient
  `N`, together with the elementary inclusion the other way), so `Z ⧸ N = K ⧸ N`, i.e. `Z·N = K`,
  whence `Z = K` because `N ≤ Z`.

Both applications of the induction hypothesis need the coprimality `(|K'|, |A|) = 1` for the
smaller coefficient groups `K' = ↥N` and `K' = K ⧸ N`, which follows from `(|K|, |A|) = 1`; the
oddness hypothesis is unchanged.

## Universes

`AppVIIStmt` is universe-polymorphic in the acting group `A` and the coefficient group `K`, so the
induction hypothesis `ih : ∀ m < n, AppVIIStmt m` of the statement below is a statement about
configurations whose groups live in the universes attached to that occurrence of `AppVIIStmt`,
which are *not* the universes `u`, `v` of `A` and `K` (they are generalized as two further
universe parameters of the lemma).  Since every group occurring here is finite, this is harmless:
`AppVIIStmt_univ_indep` below replaces a configuration by an isomorphic model living in the
required universes (Mathlib's `Finite.exists_type_univ_nonempty_mulEquiv`) and transports
`appVIIZ` along the two isomorphisms (`map_appVIIZ_equiv`).  All the applications of `ih` in the
proof below are therefore made through `ihuv`, the induction hypothesis transported to `.{u, v}`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Pointwise

namespace Work.Hering.AppVII

universe u v u' v'

/-! ## The two directions of `C_{K/N}(H) = C_K(H)·N/N` for a subgroup `H ≤ A` -/

/-- `appVIIFC A H K` is the fixed-point subgroup of the subgroup `H` of the acting group, i.e.
`FT.fixedPoints ↥H K` under the restricted action. -/
theorem appVIIFC_eq_fixedPoints {A : Type u} [Group A] {K : Type v} [Group K]
    [MulDistribMulAction A K] (H : Subgroup A) :
    appVIIFC A H K = FT.fixedPoints ↥H K := by
  ext k
  simp only [mem_appVIIFC, FT.mem_fixedPoints]
  constructor
  · intro h b; exact h (b : A) b.2
  · intro h y hy; exact h ⟨y, hy⟩

/-- **Gaschütz's lemma with a solvable coefficient, in the form used by the reduction.**
For a subgroup `H ≤ A` of the acting group and an `A`-invariant normal subgroup `N ⊴ K` with
`(|K|,|A|) = 1` and `N` solvable, the fixed points of `H` in `K ⧸ N` are the image of the fixed
points of `H` in `K`. -/
theorem appVIIFC_le_map {A : Type u} [Group A] [Finite A] {K : Type v} [Group K] [Finite K]
    [MulDistribMulAction A K] (H : Subgroup A) (N : Subgroup K) [N.Normal]
    [FT.IsInvariant A N] (hcop : Nat.Coprime (Nat.card K) (Nat.card A))
    (hsol : Group.IsSolvable ↥N) :
    appVIIFC A H (K ⧸ N) ≤ (appVIIFC A H K).map (QuotientGroup.mk' N) := by
  haveI hHinv : FT.IsInvariant ↥H N := isInvariant_restrict_act N H
  have hcopH : Nat.Coprime (Nat.card ↥H) (Nat.card K) := by
    refine hcop.symm.coprime_dvd_left ?_
    exact ⟨H.index, (Subgroup.card_mul_index H).symm⟩
  have hkey : (FT.fixedPoints ↥H K).map (QuotientGroup.mk' N) = FT.fixedPoints ↥H (K ⧸ N) :=
    fixedPoints_quotient_of_solvable_coeff hcopH N (Or.inr hsol)
  intro x hx
  have hx' : x ∈ FT.fixedPoints ↥H (K ⧸ N) := by
    rw [FT.mem_fixedPoints]
    intro b
    exact hx (b : A) b.2
  rw [← hkey] at hx'
  rw [appVIIFC_eq_fixedPoints (A := A) (K := K) H]
  exact hx'

/-- The image of `appVIIZ A P Q K` in `K ⧸ N` is `appVIIZ A P Q (K ⧸ N)`, granted the same
statement for the two generating families (`H = ⁅P,Q⁆` and `H = P^x`, `x ∈ Q`). -/
theorem collapse_appVIIZ_map_eq {A : Type u} [Group A] {K : Type v} [Group K]
    [MulDistribMulAction A K]
    (P Q : Subgroup A) (N : Subgroup K) [N.Normal] [FT.IsInvariant A N]
    (hF1 : (appVIIF1 A P Q K).map (QuotientGroup.mk' N) = appVIIF1 A P Q (K ⧸ N))
    (hFx : ∀ x : ↥Q, (appVIIFx A P Q K x).map (QuotientGroup.mk' N) = appVIIFx A P Q (K ⧸ N) x) :
    (appVIIZ A P Q K).map (QuotientGroup.mk' N) = appVIIZ A P Q (K ⧸ N) := by
  refine le_antisymm ?_ ?_
  · rw [appVIIZ, Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
    rintro k (hk | ⟨x, hkx⟩)
    · exact Subgroup.subset_closure (Or.inl (hF1 ▸ Subgroup.mem_map.mpr ⟨k, hk, rfl⟩))
    · exact Subgroup.subset_closure (Or.inr ⟨x, hFx x ▸ Subgroup.mem_map.mpr ⟨k, hkx, rfl⟩⟩)
  · rw [appVIIZ, Subgroup.closure_le]
    rintro k (hk | ⟨x, hkx⟩)
    · exact Subgroup.map_mono (appVIIF1_le_appVIIZ A P Q K) (hF1 ▸ hk)
    · exact Subgroup.map_mono (appVIIFx_le_appVIIZ A P Q K x) (hFx x ▸ hkx)

/-- If `N ≤ M` and the image of `M` in `K ⧸ N` is everything, then `M` is everything: indeed
`M ⧸ N = K ⧸ N` forces `M = K` because `N ≤ M`. -/
theorem eq_top_of_map_quotient_eq_top {K : Type u} [Group K] (N M : Subgroup K) [N.Normal]
    (hNM : N ≤ M) (h : M.map (QuotientGroup.mk' N) = ⊤) : M = ⊤ := by
  refine eq_top_iff.mpr fun x _ => ?_
  have hx : QuotientGroup.mk' N x ∈ M.map (QuotientGroup.mk' N) := by rw [h]; trivial
  obtain ⟨z, hz, hzx⟩ := Subgroup.mem_map.mp hx
  have hmem : z⁻¹ * x ∈ N := by
    rw [← QuotientGroup.eq]
    simpa [QuotientGroup.mk'_apply] using hzx
  have hx2 : x = z * (z⁻¹ * x) := by group
  rw [hx2]
  exact M.mul_mem hz (hNM hmem)

/-! ## Universe independence of the induction statement -/

/-- A subgroup whose image under a group isomorphism is everything is everything. -/
theorem eq_top_of_map_mulEquiv_eq_top {K : Type u} {K' : Type v} [Group K] [Group K']
    (eK : K ≃* K') (M : Subgroup K) (h : M.map eK.toMonoidHom = ⊤) : M = ⊤ := by
  refine eq_top_iff.mpr fun x _ => ?_
  have hx : eK x ∈ M.map eK.toMonoidHom := by rw [h]; trivial
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  have hxy : y = x := eK.injective hyx
  rwa [← hxy]

/-- **Universe independence of `AppVIIStmt`.**  A proof of Peterfalvi's Appendix VII for
configurations whose groups live in the universes `(u, v)` gives a proof for configurations living
in any other pair of universes `(u', v')`: a finite configuration is replaced by an isomorphic
model in `(u, v)` (`Finite.exists_type_univ_nonempty_mulEquiv`), to which the hypothesis applies,
and the conclusion is transported back along the isomorphisms (`map_appVIIZ_equiv`). -/
theorem AppVIIStmt_univ_indep {n : ℕ} (h : AppVIIStmt.{u, v} n) : AppVIIStmt.{u', v'} n := by
  intro A instA finA P Q hQn hinf hsup p hp hcardP hpQ K instK finK instAct hcop hodd hsize
  classical
  letI : Group A := instA
  letI : Finite A := finA
  letI : Group K := instK
  letI : Finite K := finK
  letI : MulDistribMulAction A K := instAct
  -- Models of `A` and `K` in the universes `u`, `v` of the induction hypothesis.
  obtain ⟨A₂, hA₂grp, hA₂fin, ⟨eA⟩⟩ := Finite.exists_type_univ_nonempty_mulEquiv.{u', u} A
  obtain ⟨K₂, hK₂grp, hK₂fin, ⟨eK⟩⟩ := Finite.exists_type_univ_nonempty_mulEquiv.{v', v} K
  letI : Group A₂ := hA₂grp
  letI : Fintype A₂ := hA₂fin
  letI : Group K₂ := hK₂grp
  letI : Fintype K₂ := hK₂fin
  letI : MulDistribMulAction A₂ K₂ := transportAct eA eK
  have hcardA : Nat.card A₂ = Nat.card A := (Nat.card_congr eA.toEquiv).symm
  have hcardK : Nat.card K₂ = Nat.card K := (Nat.card_congr eK.toEquiv).symm
  -- The centralizer of `P` is transported by `eA` (`Work.Hering.AppVII.map_centralizer_mulEquiv`).
  have hcen : (Subgroup.centralizer (P : Set A)).map eA.toMonoidHom
      = Subgroup.centralizer ((P.map eA.toMonoidHom : Subgroup A₂) : Set A₂) :=
    map_centralizer_mulEquiv eA P
  -- All the hypotheses of `AppVIIStmt` are transported.
  have hQn₂ : (Q.map eA.toMonoidHom).Normal := hQn.map eA.toMonoidHom eA.surjective
  have hinf₂ : P.map eA.toMonoidHom ⊓ Q.map eA.toMonoidHom = ⊥ := by
    have h1 : (P ⊓ Q).map eA.toMonoidHom = ⊥ := by rw [hinf, Subgroup.map_bot]
    rwa [Subgroup.map_inf P Q eA.toMonoidHom eA.injective] at h1
  have hsup₂ : P.map eA.toMonoidHom ⊔ Q.map eA.toMonoidHom = ⊤ := by
    have h1 : (P ⊔ Q).map eA.toMonoidHom = ⊤ := by
      rw [hsup, Subgroup.map_top_of_surjective _ eA.surjective]
    rwa [Subgroup.map_sup P Q eA.toMonoidHom] at h1
  have hcardP₂ : Nat.card ↥(P.map eA.toMonoidHom) = p := by
    rw [Subgroup.card_map_of_injective (f := eA.toMonoidHom) eA.injective, hcardP]
  have hpQ₂ : ¬ p ∣ Nat.card ↥(Q.map eA.toMonoidHom) := by
    rwa [Subgroup.card_map_of_injective (f := eA.toMonoidHom) eA.injective]
  have hcop₂ : Nat.Coprime (Nat.card K₂) (Nat.card A₂) := by
    rw [hcardK, hcardA]; exact hcop
  have hodd₂ : Odd (Nat.card ↥(Q.map eA.toMonoidHom ⊓
      Subgroup.centralizer ((P.map eA.toMonoidHom : Subgroup A₂) : Set A₂))) := by
    have hset : Q.map eA.toMonoidHom ⊓
        Subgroup.centralizer ((P.map eA.toMonoidHom : Subgroup A₂) : Set A₂)
        = (Q ⊓ Subgroup.centralizer (P : Set A)).map eA.toMonoidHom := by
      rw [← hcen, Subgroup.map_inf Q _ eA.toMonoidHom eA.injective]
    rw [hset, Subgroup.card_map_of_injective (f := eA.toMonoidHom) eA.injective]
    exact hodd
  have hsize₂ : Nat.card A₂ * Nat.card K₂ = n := by
    rw [hcardA, hcardK]; exact hsize
  have key : appVIIZ A₂ (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) K₂ = ⊤ :=
    h (P.map eA.toMonoidHom) (Q.map eA.toMonoidHom) hQn₂ hinf₂ hsup₂ p hp hcardP₂ hpQ₂
      hcop₂ hodd₂ hsize₂
  -- Transport the conclusion back.
  have hact : ∀ (a : A) (k : K), eK (a • k) = eA a • eK k := by
    intro a k
    change eK (a • k) = eK (eA.symm (eA a) • eK.symm (eK k))
    simp
  have hkey := map_appVIIZ_equiv eA eK hact P Q
  rw [key] at hkey
  exact eq_top_of_map_mulEquiv_eq_top eK (appVIIZ A P Q K) hkey

/-! ## The collapse -/

theorem collapse_solvable {n : ℕ} (ih : ∀ m < n, AppVIIStmt m)
    {A : Type u} [Group A] [Finite A] (P Q : Subgroup A) (hQn : Q.Normal)
    (hinf : P ⊓ Q = ⊥) (hsup : P ⊔ Q = ⊤) (p : ℕ) (hp : p.Prime) (hcardP : Nat.card ↥P = p)
    (hpQ : ¬ p ∣ Nat.card ↥Q) {K : Type v} [Group K] [Finite K] [MulDistribMulAction A K]
    (hcop : Nat.Coprime (Nat.card K) (Nat.card A))
    (hodd : Odd (Nat.card ↥(Q ⊓ Subgroup.centralizer (P : Set A))))
    (hsize : Nat.card A * Nat.card K = n)
    (N : Subgroup K) [N.Normal] [FT.IsInvariant A N] (hNbot : N ≠ ⊥) (hNtop : N ≠ ⊤)
    (hsol : Group.IsSolvable ↥N) : appVIIZ A P Q K = ⊤ := by
  -- The induction hypothesis, transported to the universes of `A` and `K`.
  have ihuv : ∀ m < n, AppVIIStmt.{u, v} m := fun m hm => AppVIIStmt_univ_indep (ih m hm)
  -- `N` is a strictly smaller coefficient group than `K`.
  have hcardN_lt : Nat.card ↥N < Nat.card K := by
    have h1 : Nat.card K = Nat.card ↥N * N.index := (Subgroup.card_mul_index N).symm
    have hidx1 : N.index ≠ 1 := fun hc => hNtop (Subgroup.index_eq_one.mp hc)
    have hpos : 0 < Nat.card K := Nat.card_pos
    have hidx0 : N.index ≠ 0 := by
      intro h0
      rw [h1, h0, mul_zero] at hpos
      exact absurd hpos (lt_irrefl 0)
    have hidx2 : 1 < N.index := by omega
    have hcard1 : 0 < Nat.card ↥N := Nat.card_pos
    calc Nat.card ↥N < Nat.card ↥N * N.index := lt_mul_of_one_lt_right hcard1 hidx2
      _ = Nat.card K := h1.symm
  -- and so is the quotient `K ⧸ N`.
  have hcardQ_lt : Nat.card (K ⧸ N) < Nat.card K := by
    have h1 : Nat.card K = Nat.card (K ⧸ N) * Nat.card ↥N :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup N
    have hnt : Nontrivial ↥N := (Subgroup.nontrivial_iff_ne_bot N).mpr hNbot
    have hcard2 : 1 < Nat.card ↥N := Finite.one_lt_card
    have hpos : 0 < Nat.card (K ⧸ N) := by
      have : 0 < Nat.card K := Nat.card_pos
      rw [h1] at this
      exact Nat.pos_of_mul_pos_right this
    calc Nat.card (K ⧸ N) < Nat.card (K ⧸ N) * Nat.card ↥N :=
          lt_mul_of_one_lt_right hpos hcard2
      _ = Nat.card K := h1.symm
  -- Step 1: the induction hypothesis applied to the coefficient group `↥N` gives `N ≤ Z`.
  have hcopN : Nat.Coprime (Nat.card ↥N) (Nat.card A) := by
    refine hcop.coprime_dvd_left ?_
    exact ⟨N.index, (Subgroup.card_mul_index N).symm⟩
  have hIHN : appVIIZ A P Q ↥N = ⊤ :=
    ihuv (Nat.card A * Nat.card ↥N)
      (by rw [← hsize]; exact Nat.mul_lt_mul_left Nat.card_pos |>.mpr hcardN_lt)
      (K := ↥N) P Q hQn hinf hsup p hp hcardP hpQ hcopN hodd rfl
  have hNZ : N ≤ appVIIZ A P Q K := by
    have hmap := map_subtype_appVIIZ_le (K := K) P Q N
    rw [hIHN] at hmap
    have htop : (⊤ : Subgroup ↥N).map N.subtype = N := by
      have h := Subgroup.subgroupOf_map_subtype (⊤ : Subgroup K) N
      rw [Subgroup.top_subgroupOf, top_inf_eq] at h
      exact h
    rwa [htop] at hmap
  -- Step 2: the induction hypothesis applied to the coefficient group `K ⧸ N` gives
  -- `Z ⧸ N = K ⧸ N`.
  have hcopQ : Nat.Coprime (Nat.card (K ⧸ N)) (Nat.card A) :=
    hcop.coprime_dvd_left (Subgroup.card_quotient_dvd_card N)
  have hIHQ : appVIIZ A P Q (K ⧸ N) = ⊤ :=
    ihuv (Nat.card A * Nat.card (K ⧸ N))
      (by rw [← hsize]; exact Nat.mul_lt_mul_left Nat.card_pos |>.mpr hcardQ_lt)
      (K := K ⧸ N) P Q hQn hinf hsup p hp hcardP hpQ hcopQ hodd rfl
  -- The images of the two generating families, via Gaschütz and the elementary inclusion.
  have hF1 : (appVIIF1 A P Q K).map (QuotientGroup.mk' N) = appVIIF1 A P Q (K ⧸ N) := by
    rw [appVIIF1_eq_appVIIFC A P Q K, appVIIF1_eq_appVIIFC A P Q (K ⧸ N)]
    exact le_antisymm (appVIIFC_map_le (A := A) ⁅P, Q⁆ N)
      (appVIIFC_le_map (A := A) (K := K) ⁅P, Q⁆ N hcop hsol)
  have hFx : ∀ x : ↥Q, (appVIIFx A P Q K x).map (QuotientGroup.mk' N)
      = appVIIFx A P Q (K ⧸ N) x := by
    intro x
    rw [appVIIFx_eq_appVIIFC A P Q K x, appVIIFx_eq_appVIIFC A P Q (K ⧸ N) x]
    exact le_antisymm (appVIIFC_map_le (A := A) (P.map (MulAut.conj (x : A)).toMonoidHom) N)
      (appVIIFC_le_map (A := A) (K := K) (P.map (MulAut.conj (x : A)).toMonoidHom) N hcop hsol)
  have hZmap : (appVIIZ A P Q K).map (QuotientGroup.mk' N) = appVIIZ A P Q (K ⧸ N) :=
    collapse_appVIIZ_map_eq P Q N hF1 hFx
  have hZtop : (appVIIZ A P Q K).map (QuotientGroup.mk' N) = ⊤ := by rw [hZmap, hIHQ]
  exact eq_top_of_map_quotient_eq_top N (appVIIZ A P Q K) hNZ hZtop

end Work.Hering.AppVII
