import Mathlib
import Submission.Work.Hering.AppVII.Setup

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `appVIIZ` is transported along a compatible group homomorphism

`appVIIZ A P Q K` is generated by the fixed points of `⁅P,Q⁆` and of the conjugates `P^x`
(`x ∈ Q`), inside a group `K` carrying a `MulDistribMulAction` of `A`.  If `ψ : G →* G'` is a
group homomorphism and the `G'`-action on `K` is compatible with the `G`-action through `ψ`
(`ψ g • k = g • k`), then replacing `G` by `G'`, `P` by `P.map ψ` and `Q` by `Q.map ψ` does not
change `appVIIZ`.

Specialised to `ψ = QuotientGroup.mk' C : A →* A ⧸ C`, this gives the statement
`appVIIZ_quotient_eq`: passing to the quotient by a normal subgroup `C` of `A` (when the action
factors through the quotient) leaves `appVIIZ` unchanged.
-/

set_option autoImplicit false

open scoped Pointwise

namespace Work.Hering.AppVII

universe u v w

/-- **Transport of `appVIIZ` along a compatible group homomorphism.**
For a group homomorphism `ψ : G →* G'` and a `G'`-action on `K` compatible with the `G`-action
through `ψ`, `appVIIZ` of the images `P.map ψ`, `Q.map ψ` equals `appVIIZ G P Q K`. -/
theorem appVIIZ_map_eq {G : Type u} {G' : Type v} {K : Type w} [Group G] [Group G'] [Group K]
    [MulDistribMulAction G K] [MulDistribMulAction G' K]
    (ψ : G →* G') (P Q : Subgroup G)
    (hact : ∀ (g : G) (k : K), ψ g • k = g • k) :
    appVIIZ G' (P.map ψ) (Q.map ψ) K = appVIIZ G P Q K := by
  -- The fixed points of `⁅P, Q⁆` correspond.
  have hF1 : (appVIIF1 G' (P.map ψ) (Q.map ψ) K : Set K) = (appVIIF1 G P Q K : Set K) := by
    ext k
    constructor
    · intro hk y hy
      have hy' : ψ y ∈ ⁅P.map ψ, Q.map ψ⁆ := by
        rw [← Subgroup.map_commutator]
        exact Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
      have h := hk (ψ y) hy'
      rwa [hact y k] at h
    · intro hk Y hY
      rw [← Subgroup.map_commutator] at hY
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hY
      rw [hact y k]
      exact hk y hy
  -- The fixed points of the conjugates `P^x`, `x ∈ Q`, correspond.
  have hconj : ∀ x : ↥Q,
      (P.map ψ).map (MulAut.conj (ψ (x : G))).toMonoidHom
        = (P.map (MulAut.conj (x : G)).toMonoidHom).map ψ := by
    intro x
    have hhom : (MulAut.conj (ψ (x : G))).toMonoidHom.comp ψ
        = ψ.comp (MulAut.conj (x : G)).toMonoidHom := by
      ext a
      simp [MulAut.conj_apply]
    rw [Subgroup.map_map, Subgroup.map_map, hhom]
  have hFx_mem : ∀ (x : ↥Q) (k : K),
      k ∈ appVIIFx G' (P.map ψ) (Q.map ψ) K ⟨ψ (x : G), Subgroup.mem_map.mpr ⟨x, x.2, rfl⟩⟩
        ↔ k ∈ appVIIFx G P Q K x := by
    intro x k
    show (∀ y ∈ (P.map ψ).map (MulAut.conj (ψ (x : G))).toMonoidHom, y • k = k)
        ↔ (∀ y ∈ P.map (MulAut.conj (x : G)).toMonoidHom, y • k = k)
    rw [hconj x]
    constructor
    · intro h y hy
      have : ψ y ∈ (P.map (MulAut.conj (x : G)).toMonoidHom).map ψ :=
        Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
      have hh := h (ψ y) this
      rwa [hact y k] at hh
    · intro h y hy
      obtain ⟨y', hy', rfl⟩ := Subgroup.mem_map.mp hy
      rw [hact y' k]
      exact h y' hy'
  have hFx : {k : K | ∃ x' : ↥(Q.map ψ), k ∈ appVIIFx G' (P.map ψ) (Q.map ψ) K x'}
      = {k : K | ∃ x : ↥Q, k ∈ appVIIFx G P Q K x} := by
    ext k
    constructor
    · rintro ⟨x', hx'⟩
      obtain ⟨x, hxQ, hxx⟩ := Subgroup.mem_map.mp x'.2
      refine ⟨⟨x, hxQ⟩, ?_⟩
      have heq : x' = ⟨ψ x, Subgroup.mem_map.mpr ⟨x, hxQ, rfl⟩⟩ :=
        Subtype.ext hxx.symm
      rw [heq] at hx'
      exact (hFx_mem ⟨x, hxQ⟩ k).mp hx'
    · rintro ⟨x, hx⟩
      exact ⟨⟨ψ (x : G), Subgroup.mem_map.mpr ⟨x, x.2, rfl⟩⟩, (hFx_mem x k).mpr hx⟩
  rw [appVIIZ, appVIIZ, hF1, hFx]

/-- Passing to the quotient by a normal subgroup `C ≤ A` (when the action of `A` on `K` descends
to the quotient, as witnessed by `hact`) leaves `appVIIZ` unchanged:
`appVIIZ (A ⧸ C) (P.map (mk' C)) (Q.map (mk' C)) K = appVIIZ A P Q K`. -/
theorem appVIIZ_quotient_eq {A : Type u} {K : Type v} [Group A] [Group K]
    [MulDistribMulAction A K] (C : Subgroup A) [C.Normal] (P Q : Subgroup A)
    [act : MulDistribMulAction (A ⧸ C) K]
    (hact : ∀ (a : A) (k : K), (QuotientGroup.mk' C a) • k = a • k) :
    appVIIZ (A ⧸ C) (P.map (QuotientGroup.mk' C)) (Q.map (QuotientGroup.mk' C)) K
      = appVIIZ A P Q K :=
  appVIIZ_map_eq (QuotientGroup.mk' C) P Q hact

end Work.Hering.AppVII
