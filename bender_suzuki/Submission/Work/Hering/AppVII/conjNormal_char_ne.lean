namespace Work.Hering.AppVII

open scoped commutatorElement

/-- Let `Q` be a normal subgroup of a finite group `H`, and suppose that `⁅P, Q⁆ = Q`
where `P` has prime order.  Then a non-trivial character `χ` of `Q` cannot be fixed by
conjugation with any non-trivial element of `P`.

Indeed, conjugation by a non-trivial `p ∈ P` fixes `χ`; since `P` has prime order every
element of `P` is a power of `p`, so all of `P` fixes `χ`.  Then `χ` kills every
commutator `⁅x, y⁆` with `x ∈ P`, `y ∈ Q`, and since `Q = ⁅P, Q⁆` is generated by these,
`χ` is trivial — contradiction. -/
theorem conjNormal_char_ne {F H : Type*} [Field F] [Group H] [Finite H]
    (P Q : Subgroup H) [Q.Normal] (hcomm : ⁅P, Q⁆ = Q) (hpc : (Nat.card ↥P).Prime)
    {χ : ↥Q →* Fˣ} (hχ : χ ≠ 1) {p : ↥P} (hp : p ≠ 1) :
    χ.comp (MulAut.conjNormal (p : H)).toMonoidHom ≠ χ := by
  intro h
  apply hχ
  -- Conjugation by `p` fixes `χ`.
  have hA : ∀ y : ↥Q, χ (MulAut.conjNormal (p : H) y) = χ y := by
    intro y
    simpa using DFunLike.congr_fun h y
  -- Hence conjugation by every power of `p` fixes `χ`.
  have hAn : ∀ n : ℕ, ∀ y : ↥Q, χ (((MulAut.conjNormal (p : H))^n) y) = χ y := by
    intro n
    induction n with
    | zero => intro y; simp
    | succ n ih =>
      intro y
      rw [pow_succ, MulAut.mul_apply, ih (MulAut.conjNormal (p : H) y), hA y]
  -- As `P` has prime order, `p ≠ 1` generates `P`, so every `a ∈ P` fixes `χ`.
  have hgen : ∀ a : ↥P, ∀ b : ↥Q, χ (MulAut.conjNormal (a : H) b) = χ b := by
    intro a b
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff a p).mp
      (@mem_powers_of_prime_card (↥P) _ (Nat.card ↥P) ⟨hpc⟩ rfl p a hp)
    rw [← hn, Subgroup.coe_pow, map_pow]
    exact hAn n b
  -- The commutator `⁅P, Q⁆` is generated by the `⁅x, y⁆`, and `hcomm` says it equals `Q`.
  have hcl : Subgroup.closure {g : H | ∃ g₁ ∈ P, ∃ g₂ ∈ Q, ⁅g₁, g₂⁆ = g} = Q := hcomm
  -- Every element of `Q` is a product of such commutators, on which `χ` vanishes.
  have key : ∀ x ∈ Subgroup.closure {g : H | ∃ g₁ ∈ P, ∃ g₂ ∈ Q, ⁅g₁, g₂⁆ = g},
      ∀ (hx : x ∈ Q), χ ⟨x, hx⟩ = 1 := by
    intro x hxcl
    refine Subgroup.closure_induction (p := fun x _ => ∀ hx : x ∈ Q, χ ⟨x, hx⟩ = 1)
      ?_ ?_ ?_ ?_ hxcl
    · rintro x ⟨g₁, hg₁, g₂, hg₂, rfl⟩ hx'
      set a : ↥P := ⟨g₁, hg₁⟩
      set b : ↥Q := ⟨g₂, hg₂⟩
      have h1 : (⟨⁅g₁, g₂⁆, hx'⟩ : ↥Q) = MulAut.conjNormal (a : H) b * b⁻¹ := by
        ext
        simp [a, b, commutatorElement_def]
      rw [h1, map_mul, map_inv, hgen a b]
      simp
    · intro hx
      have : (⟨(1 : H), hx⟩ : ↥Q) = 1 := by ext; rfl
      rw [this, map_one]
    · intro y z hy hz ihy ihz h
      have hyQ : y ∈ Q := hcl ▸ hy
      have hzQ : z ∈ Q := hcl ▸ hz
      have heq : (⟨y * z, h⟩ : ↥Q) = ⟨y, hyQ⟩ * ⟨z, hzQ⟩ := by ext; rfl
      rw [heq, map_mul, ihy hyQ, ihz hzQ]
      simp
    · intro y hy ihy h
      have hyQ : y ∈ Q := hcl ▸ hy
      have heq : (⟨y⁻¹, h⟩ : ↥Q) = (⟨y, hyQ⟩ : ↥Q)⁻¹ := by ext; rfl
      rw [heq, map_inv, ihy hyQ]
      simp
  ext q
  simpa using key q (by rw [hcl]; exact q.2) q.2

end Work.Hering.AppVII
