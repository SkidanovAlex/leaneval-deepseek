/-!
# Appendix VII of Peterfalvi I (p. 216) — setup

The subgroup `appVIIZ A P Q K` whose being `⊤` is the conclusion of `AppVIIProp`
(`Submission/Work/Hering/AppVII/Defs.lean`) is generated by the fixed points of `⁅P,Q⁆` in `K`
together with the fixed points of the conjugates `P^x`, `x ∈ Q`:

* `appVIIF1 A P Q K` — the elements fixed by `⁅P,Q⁆`;
* `appVIIFx A P Q K x` — the elements fixed by `P^x` (`x : ↥Q`);
* `appVIIZ A P Q K` — the subgroup they generate.

This module is separate from `appVII.lean` so that the lemmas which build the reduction
(`appVII_special`, …) can import the setup without importing the target statement.

The roadmap for the proof of Appendix VII is in the module docstring of `appVII.lean`.
-/

set_option autoImplicit false

open scoped Pointwise

namespace Work.Hering.AppVII

/-- The elements of `K` fixed by `⁅P,Q⁆` (a subgroup). -/
def appVIIF1 (A : Type*) [Group A] (P Q : Subgroup A) (K : Type*) [Group K]
    [MulDistribMulAction A K] : Subgroup K where
  carrier := {k : K | ∀ y ∈ (⁅P, Q⁆ : Subgroup A), y • k = k}
  mul_mem' := by
    intro x y hx hy z hz
    rw [smul_mul', hx z hz, hy z hz]
  one_mem' := by intro z _; exact smul_one z
  inv_mem' := by intro x hx z hz; rw [smul_inv', hx z hz]

/-- The elements of `K` fixed by the conjugate `P^x` (`x : ↥Q`). -/
def appVIIFx (A : Type*) [Group A] (P Q : Subgroup A) (K : Type*) [Group K]
    [MulDistribMulAction A K] (x : ↥Q) : Subgroup K where
  carrier := {k : K | ∀ y ∈ P.map (MulAut.conj (x : A)).toMonoidHom, y • k = k}
  mul_mem' := by
    intro a b ha hb z hz
    rw [smul_mul', ha z hz, hb z hz]
  one_mem' := by intro z _; exact smul_one z
  inv_mem' := by intro a ha z hz; rw [smul_inv', ha z hz]

/-- `appVIIZ A P Q K` is the subgroup of `K` generated by the fixed points of `⁅P,Q⁆` and of the
conjugates `P^x` (`x : ↥Q`); its being `⊤` is the conclusion of Appendix VII. -/
def appVIIZ (A : Type*) [Group A] (P Q : Subgroup A) (K : Type*) [Group K]
    [MulDistribMulAction A K] : Subgroup K :=
  Subgroup.closure ((appVIIF1 A P Q K : Set K) ∪
    {k : K | ∃ x : ↥Q, k ∈ appVIIFx A P Q K x})

theorem appVIIF1_le_appVIIZ (A : Type*) [Group A] (P Q : Subgroup A) (K : Type*) [Group K]
    [MulDistribMulAction A K] : appVIIF1 A P Q K ≤ appVIIZ A P Q K :=
  fun _ hk => Subgroup.subset_closure (Or.inl hk)

theorem appVIIFx_le_appVIIZ (A : Type*) [Group A] (P Q : Subgroup A) (K : Type*) [Group K]
    [MulDistribMulAction A K] (x : ↥Q) : appVIIFx A P Q K x ≤ appVIIZ A P Q K :=
  fun _ hk => Subgroup.subset_closure (Or.inr ⟨x, hk⟩)

/-! ## The induction statement and the API used by the reduction -/

universe u v

open scoped commutatorElement

/-- The action of a subgroup `B ≤ A` on `K`, obtained by restricting the action of `A`. -/
def restrictAct {A : Type u} {K : Type v} [Group A] [Group K] [MulDistribMulAction A K]
    (B : Subgroup A) : MulDistribMulAction ↥B K :=
  MulDistribMulAction.compHom K (Subgroup.subtype B)

instance instRestrictAct {A : Type u} {K : Type v} [Group A] [Group K] [MulDistribMulAction A K]
    (B : Subgroup A) : MulDistribMulAction ↥B K :=
  restrictAct B

@[simp]
theorem restrictAct_smul {A : Type u} {K : Type v} [Group A] [Group K]
    [MulDistribMulAction A K] (B : Subgroup A) (b : ↥B) (k : K) :
    b • k = (b : A) • k := rfl

/-- Peterfalvi's Appendix VII, at the fixed value `Nat.card A * Nat.card K = n` of the induction
measure.  Exposed so that the statement can be proved by strong induction on
`Nat.card A * Nat.card K`. -/
def AppVIIStmt (n : ℕ) : Prop :=
  ∀ {A : Type u} [Group A] [Finite A] (P Q : Subgroup A) (hQn : Q.Normal)
    (hinf : P ⊓ Q = ⊥) (hsup : P ⊔ Q = ⊤) (p : ℕ) (hp : p.Prime) (hcardP : Nat.card ↥P = p)
    (hpQ : ¬ p ∣ Nat.card ↥Q) {K : Type v} [Group K] [Finite K] [MulDistribMulAction A K]
    (hcop : Nat.Coprime (Nat.card K) (Nat.card A))
    (hodd : Odd (Nat.card ↥(Q ⊓ Subgroup.centralizer (P : Set A)))),
    Nat.card A * Nat.card K = n → appVIIZ A P Q K = ⊤

section API

variable {A : Type u} {K : Type v} [Group A] [Group K] [MulDistribMulAction A K]

/-- `appVIIF1` is antitone in the pair `(P, Q)`. -/
theorem appVIIF1_le_of_le {P₁ Q₁ P₂ Q₂ : Subgroup A} (hP : P₁ ≤ P₂) (hQ : Q₁ ≤ Q₂) :
    appVIIF1 A P₂ Q₂ K ≤ appVIIF1 A P₁ Q₁ K :=
  fun _ hk y hy => hk y (Subgroup.commutator_mono hP hQ hy)

/-- The image of `appVIIZ` of an `A`-invariant subgroup of `K` lies in `appVIIZ` of `K`. -/
theorem map_subtype_appVIIZ_le (P Q : Subgroup A) (M : Subgroup K) [FT.IsInvariant A M] :
    (appVIIZ A P Q ↥M).map M.subtype ≤ appVIIZ A P Q K := by
  rw [Subgroup.map_le_iff_le_comap, appVIIZ, Subgroup.closure_le]
  rintro y (hy | hy)
  · refine appVIIF1_le_appVIIZ A P Q K fun z hz => ?_
    have h2 := congrArg (Subtype.val) (hy z hz)
    rwa [FT.coe_subgroup_smul] at h2
  · obtain ⟨x, hx⟩ := hy
    refine appVIIFx_le_appVIIZ A P Q K x fun z hz => ?_
    have h2 := congrArg (Subtype.val) (hx z hz)
    rwa [FT.coe_subgroup_smul] at h2

/-! ### The commutator `⁅P,Q⁆` is normal in `P ⊔ Q` -/

/-- The commutator identity `y * ⁅p,q⁆ * y⁻¹ = ⁅p,y⁆⁻¹ * ⁅p, y*q⁆`. -/
theorem conj_commutatorElement_eq (p q y : A) :
    y * ⁅p, q⁆ * y⁻¹ = (⁅p, y⁆)⁻¹ * ⁅p, y * q⁆ := by
  have h := commutatorElement_mul_right_eq_mul_conj p y q
  rw [h]
  group

theorem map_conj_commutator_le_of_mapsTo {P Q : Subgroup A} {g : A}
    (hP : ∀ x ∈ P, g * x * g⁻¹ ∈ P) (hQ : ∀ x ∈ Q, g * x * g⁻¹ ∈ Q) :
    Subgroup.map (MulAut.conj g).toMonoidHom ⁅P, Q⁆ ≤ ⁅P, Q⁆ := by
  rw [Subgroup.commutator_def, MonoidHom.map_closure, Subgroup.closure_le]
  rintro x ⟨z, ⟨g₁, hg₁, g₂, hg₂, rfl⟩, rfl⟩
  show g * ⁅g₁, g₂⁆ * g⁻¹ ∈ ⁅P, Q⁆
  rw [conjugate_commutatorElement]
  exact Subgroup.subset_closure ⟨g * g₁ * g⁻¹, hP g₁ hg₁, g * g₂ * g⁻¹, hQ g₂ hg₂, rfl⟩

theorem map_conj_commutator_le_of_mem_right {P Q : Subgroup A} {y : A} (hy : y ∈ Q) :
    Subgroup.map (MulAut.conj y).toMonoidHom ⁅P, Q⁆ ≤ ⁅P, Q⁆ := by
  rw [Subgroup.commutator_def, MonoidHom.map_closure, Subgroup.closure_le]
  rintro x ⟨z, ⟨g₁, hg₁, g₂, hg₂, rfl⟩, rfl⟩
  show y * ⁅g₁, g₂⁆ * y⁻¹ ∈ ⁅P, Q⁆
  rw [conj_commutatorElement_eq]
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _
      (Subgroup.subset_closure ⟨g₁, hg₁, y, hy, rfl⟩))
    (Subgroup.subset_closure ⟨g₁, hg₁, y * g₂, Q.mul_mem hy hg₂, rfl⟩)

/-- `P ≤ N_A(⁅P,Q⁆)` when `Q ⊴ A`. -/
theorem le_normalizer_commutator_left {P Q : Subgroup A} (hQn : Q.Normal) :
    P ≤ Subgroup.normalizer (⁅P, Q⁆ : Subgroup A) := by
  haveI : Q.Normal := hQn
  intro p hp
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    have h1 := map_conj_commutator_le_of_mapsTo (P := P) (Q := Q) (g := p)
      (fun x hx => P.mul_mem (P.mul_mem hp hx) (P.inv_mem hp))
      (fun x hx => Subgroup.Normal.conj_mem inferInstance x hx p)
      (Subgroup.mem_map.mpr ⟨h, hh, rfl⟩)
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using h1
  · intro hh
    have h1 := map_conj_commutator_le_of_mapsTo (P := P) (Q := Q) (g := p⁻¹)
      (fun x hx => P.mul_mem (P.mul_mem (P.inv_mem hp) hx) (P.inv_mem (P.inv_mem hp)))
      (fun x hx => Subgroup.Normal.conj_mem inferInstance x hx p⁻¹)
      (Subgroup.mem_map.mpr ⟨p * h * p⁻¹, hh, rfl⟩)
    have h2 : (MulEquiv.toMonoidHom (MulAut.conj p⁻¹)) (p * h * p⁻¹) = h := by
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
      group
    rwa [h2] at h1

/-- `Q ≤ N_A(⁅P,Q⁆)`. -/
theorem le_normalizer_commutator_right (P Q : Subgroup A) :
    Q ≤ Subgroup.normalizer (⁅P, Q⁆ : Subgroup A) := by
  intro y hy
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    have h1 := map_conj_commutator_le_of_mem_right (P := P) (Q := Q) hy
      (Subgroup.mem_map.mpr ⟨h, hh, rfl⟩)
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using h1
  · intro hh
    have h1 := map_conj_commutator_le_of_mem_right (P := P) (Q := Q) (Q.inv_mem hy)
      (Subgroup.mem_map.mpr ⟨y * h * y⁻¹, hh, rfl⟩)
    have h2 : (MulEquiv.toMonoidHom (MulAut.conj y⁻¹)) (y * h * y⁻¹) = h := by
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
      group
    rwa [h2] at h1

/-- `⁅P,Q⁆ ⊴ A` when `Q ⊴ A` and `P ⊔ Q = ⊤`. -/
theorem commutator_normal_of_sup_eq_top {P Q : Subgroup A} (hQn : Q.Normal)
    (hsup : P ⊔ Q = ⊤) : (⁅P, Q⁆ : Subgroup A).Normal := by
  have h : P ⊔ Q ≤ Subgroup.normalizer (⁅P, Q⁆ : Subgroup A) :=
    sup_le (le_normalizer_commutator_left hQn) (le_normalizer_commutator_right P Q)
  exact (Subgroup.normalizer_eq_top_iff).mp (le_antisymm le_top (hsup ▸ h))

/-! ### Invariance of the two generating families -/

/-- `a • C_K(⁅P,Q⁆) ≤ C_K(⁅P,Q⁆)` when every `a` normalizes `⁅P,Q⁆`. -/
theorem smul_appVIIF1_le_self {P Q : Subgroup A}
    (hHN : ∀ a : A, ∀ x ∈ (⁅P, Q⁆ : Subgroup A), a * x * a⁻¹ ∈ ⁅P, Q⁆) (a : A) :
    a • appVIIF1 A P Q K ≤ appVIIF1 A P Q K := by
  intro z hz
  obtain ⟨w, hw, hwz⟩ :=
    (Subgroup.mem_smul_pointwise_iff_exists z a (appVIIF1 A P Q K)).mp hz
  rw [← hwz]
  intro y hy
  rw [← mul_smul, show y * a = a * (a⁻¹ * y * (a⁻¹)⁻¹) from by group, mul_smul,
    hw _ (hHN a⁻¹ y hy)]

theorem smul_appVIIF1_eq_self {P Q : Subgroup A}
    (hHN : ∀ a : A, ∀ x ∈ (⁅P, Q⁆ : Subgroup A), a * x * a⁻¹ ∈ ⁅P, Q⁆) (a : A) :
    a • appVIIF1 A P Q K = appVIIF1 A P Q K := by
  refine le_antisymm (smul_appVIIF1_le_self hHN a) ?_
  intro z hz
  refine (Subgroup.mem_smul_pointwise_iff_exists z a (appVIIF1 A P Q K)).mpr
    ⟨a⁻¹ • z, smul_appVIIF1_le_self hHN a⁻¹
      (Subgroup.smul_mem_pointwise_smul z a⁻¹ (appVIIF1 A P Q K) hz), smul_inv_smul a z⟩

/-- For `a = p * q` (`p ∈ P`, `q ∈ Q`), conjugation by `a` permutes the family of subgroups
`P^x`, `x ∈ Q`. -/
theorem smul_appVIIFx_eq {P Q : Subgroup A} (hQn : Q.Normal) (hsup : P ⊔ Q = ⊤)
    (a : A) (x : ↥Q) :
    ∃ y : ↥Q, a • appVIIFx A P Q K x = appVIIFx A P Q K y := by
  classical
  haveI : Q.Normal := hQn
  obtain ⟨p', hp'P, q, hqQ, ha⟩ :=
    (Subgroup.mem_sup_of_normal_right (s := P) (t := Q)).mp (hsup ▸ Subgroup.mem_top a)
  refine ⟨⟨p' * (q * (x : A)) * p'⁻¹,
    Subgroup.Normal.conj_mem hQn (q * (x : A)) (Q.mul_mem hqQ x.2) p'⟩, ?_⟩
  refine le_antisymm ?_ ?_
  · intro z hz
    obtain ⟨w, hw, hwz⟩ :=
      (Subgroup.mem_smul_pointwise_iff_exists z a (appVIIFx A P Q K x)).mp hz
    rw [← hwz]
    intro u hu
    rw [Subgroup.mem_map] at hu
    obtain ⟨v, hv, hvu⟩ := hu
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at hvu
    have hmem : a⁻¹ * u * a ∈ P.map (MulAut.conj (x : A)).toMonoidHom := by
      rw [Subgroup.mem_map]
      refine ⟨p'⁻¹ * v * p', P.mul_mem (P.mul_mem (P.inv_mem hp'P) hv) hp'P, ?_⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, ← hvu, ← ha]
      group
    rw [← mul_smul, show u * a = a * (a⁻¹ * u * a) from by group, mul_smul, hw _ hmem]
  · intro z hz
    refine (Subgroup.mem_smul_pointwise_iff_exists z a (appVIIFx A P Q K x)).mpr
      ⟨a⁻¹ • z, ?_, smul_inv_smul a z⟩
    intro u hu
    rw [Subgroup.mem_map] at hu
    obtain ⟨v, hv, hvu⟩ := hu
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at hvu
    have hmem : a * u * a⁻¹ ∈
        P.map (MulAut.conj (p' * (q * (x : A)) * p'⁻¹)).toMonoidHom := by
      rw [Subgroup.mem_map]
      refine ⟨p' * v * p'⁻¹, P.mul_mem (P.mul_mem hp'P hv) (P.inv_mem hp'P), ?_⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, ← hvu, ← ha]
      group
    have h := hz _ hmem
    rw [← mul_smul, show u * a⁻¹ = a⁻¹ * (a * u * a⁻¹) from by group, mul_smul, h]

/-- `appVIIZ A P Q K` is `A`-invariant when `Q ⊴ A` and `P ⊔ Q = ⊤`. -/
theorem smul_appVIIZ_le_self {P Q : Subgroup A} (hQn : Q.Normal) (hsup : P ⊔ Q = ⊤) (a : A) :
    a • appVIIZ A P Q K ≤ appVIIZ A P Q K := by
  have hHN : (⁅P, Q⁆ : Subgroup A).Normal := commutator_normal_of_sup_eq_top hQn hsup
  have hHN' : ∀ b : A, ∀ x ∈ (⁅P, Q⁆ : Subgroup A), b * x * b⁻¹ ∈ ⁅P, Q⁆ :=
    fun b x hx => hHN.conj_mem x hx b
  rw [Subgroup.pointwise_smul_def]
  change Subgroup.map (MulDistribMulAction.toMonoidEnd A K a : K →* K) (appVIIZ A P Q K)
    ≤ appVIIZ A P Q K
  refine (Subgroup.map_le_iff_le_comap).mpr ?_
  rw [appVIIZ, Subgroup.closure_le]
  rintro z (hz | hz)
  · exact Subgroup.subset_closure (Or.inl (smul_appVIIF1_le_self hHN' a
      (Subgroup.smul_mem_pointwise_smul z a (appVIIF1 A P Q K) hz)))
  · obtain ⟨x, hx⟩ := hz
    obtain ⟨y, hy⟩ := smul_appVIIFx_eq (K := K) hQn hsup a x
    refine Subgroup.subset_closure (Or.inr ⟨y, ?_⟩)
    rw [← hy]
    exact Subgroup.smul_mem_pointwise_smul z a (appVIIFx A P Q K x) hx

theorem smul_appVIIZ_eq_self {P Q : Subgroup A} (hQn : Q.Normal) (hsup : P ⊔ Q = ⊤) (a : A) :
    a • appVIIZ A P Q K = appVIIZ A P Q K := by
  refine le_antisymm (smul_appVIIZ_le_self hQn hsup a) ?_
  intro z hz
  refine (Subgroup.mem_smul_pointwise_iff_exists z a (appVIIZ A P Q K)).mpr
    ⟨a⁻¹ • z, smul_appVIIZ_le_self hQn hsup a⁻¹
      (Subgroup.smul_mem_pointwise_smul z a⁻¹ (appVIIZ A P Q K) hz), smul_inv_smul a z⟩

/-! ### Transport of `appVIIZ` between configurations -/

/-- A change of the acting group: passing from `A` to a subgroup `B ≤ A` (with `P, Q ≤ B`)
does not make `appVIIZ` larger. -/
theorem map_subgroupOf_commutator {P Q B : Subgroup A} (hPB : P ≤ B) (hQB : Q ≤ B) :
    Subgroup.map B.subtype ⁅P.subgroupOf B, Q.subgroupOf B⁆ = ⁅P, Q⁆ := by
  rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hPB,
    Subgroup.map_subgroupOf_eq_of_le hQB]

theorem map_conj_subgroupOf {P B : Subgroup A} (hPB : P ≤ B) (b : ↥B) :
    Subgroup.map B.subtype ((P.subgroupOf B).map (MulAut.conj b).toMonoidHom)
      = P.map (MulAut.conj (b : A)).toMonoidHom := by
  rw [Subgroup.map_map]
  have hcomp : (B.subtype.comp (MulAut.conj b).toMonoidHom)
      = ((MulAut.conj (b : A)).toMonoidHom.comp B.subtype) := by
    ext x
    simp [MulAut.conj_apply]
  rw [hcomp, ← Subgroup.map_map, Subgroup.map_subgroupOf_eq_of_le hPB]

/-- `appVIIZ` for the configuration induced on a subgroup `B ≤ A` (with `P, Q ≤ B`) is contained
in `appVIIZ` for the ambient configuration. -/
theorem appVIIZ_subgroupOf_le (P Q B : Subgroup A) (hPB : P ≤ B) (hQB : Q ≤ B) :
    appVIIZ ↥B (P.subgroupOf B) (Q.subgroupOf B) K ≤ appVIIZ A P Q K := by
  letI : MulDistribMulAction ↥B K := instRestrictAct B
  rw [appVIIZ, Subgroup.closure_le]
  rintro z (hz | hz)
  · refine appVIIF1_le_appVIIZ A P Q K fun y hy => ?_
    have hmap : y ∈ Subgroup.map B.subtype ⁅P.subgroupOf B, Q.subgroupOf B⁆ := by
      rw [map_subgroupOf_commutator hPB hQB]; exact hy
    obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp hmap
    have hyB : y ∈ B := by rw [← hxy]; exact x.2
    have hmem : (⟨y, hyB⟩ : ↥B) ∈ ⁅P.subgroupOf B, Q.subgroupOf B⁆ := by
      rwa [show x = ⟨y, hyB⟩ from Subtype.ext hxy] at hx
    exact hz ⟨y, hyB⟩ hmem
  · obtain ⟨x, hx⟩ := hz
    have hxQ : (((x : ↥B)) : A) ∈ Q := Subgroup.mem_subgroupOf.mp x.2
    refine appVIIFx_le_appVIIZ A P Q K ⟨((x : ↥B) : A), hxQ⟩ fun v hv => ?_
    rw [Subgroup.mem_map] at hv
    obtain ⟨p, hp, hpv⟩ := hv
    simp only [MulAut.conj_apply] at hpv
    have hpB : p ∈ B := hPB hp
    have hmem : ((x : ↥B) * (⟨p, hpB⟩ : ↥B) * (x : ↥B)⁻¹)
        ∈ (P.subgroupOf B).map (MulAut.conj (x : ↥B)).toMonoidHom :=
      Subgroup.mem_map.mpr ⟨⟨p, hpB⟩, Subgroup.mem_subgroupOf.mpr hp, rfl⟩
    have h := hx _ hmem
    have hval : (((x : ↥B) * (⟨p, hpB⟩ : ↥B) * (x : ↥B)⁻¹ : ↥B) : A) = v := by
      rw [← hpv]
      simp [Subgroup.coe_mul, Subgroup.coe_inv]
    rw [← hval]
    exact h

/-- Membership transfer for `appVIIF1` between a configuration on `A` and the same configuration
viewed on a subgroup `B ≤ A`. -/
theorem mem_appVIIF1_subgroupOf_iff {P Q B : Subgroup A} (hPB : P ≤ B) (hQB : Q ≤ B) (k : K) :
    k ∈ appVIIF1 ↥B (P.subgroupOf B) (Q.subgroupOf B) K ↔ k ∈ appVIIF1 A P Q K := by
  letI : MulDistribMulAction ↥B K := instRestrictAct B
  constructor
  · intro h y hy
    have hmap : y ∈ Subgroup.map B.subtype ⁅P.subgroupOf B, Q.subgroupOf B⁆ := by
      rw [map_subgroupOf_commutator hPB hQB]; exact hy
    obtain ⟨y₁, hy₁, hy₁y⟩ := Subgroup.mem_map.mp hmap
    have h1 := h y₁ hy₁
    rw [← hy₁y]
    exact h1
  · intro h u hu
    have hmem : (u : A) ∈ ⁅P, Q⁆ := by
      have h2 : (u : A) ∈ Subgroup.map B.subtype ⁅P.subgroupOf B, Q.subgroupOf B⁆ :=
        Subgroup.mem_map.mpr ⟨u, hu, rfl⟩
      rwa [map_subgroupOf_commutator hPB hQB] at h2
    exact h (u : A) hmem

/-- Membership transfer for `appVIIFx` between a configuration on `A` and the same configuration
viewed on a subgroup `B ≤ A`. -/
theorem mem_appVIIFx_subgroupOf_iff {P Q B : Subgroup A} (hPB : P ≤ B) (hQB : Q ≤ B)
    (x : ↥(Q.subgroupOf B)) (k : K) :
    k ∈ appVIIFx ↥B (P.subgroupOf B) (Q.subgroupOf B) K x
      ↔ k ∈ appVIIFx A P Q K ⟨(x : A), Subgroup.mem_subgroupOf.mp x.2⟩ := by
  letI : MulDistribMulAction ↥B K := instRestrictAct B
  constructor
  · intro h y hy
    rw [Subgroup.mem_map] at hy
    obtain ⟨p, hp, hpy⟩ := hy
    simp only [MulAut.conj_apply] at hpy
    have hxB : (x : A) ∈ B := ((x : ↥B)).2
    have hpB : p ∈ B := hPB hp
    have hyB : y ∈ B := by
      rw [← hpy]
      exact B.mul_mem (B.mul_mem hxB hpB) (B.inv_mem hxB)
    have hmem : (⟨y, hyB⟩ : ↥B) ∈ (P.subgroupOf B).map (MulAut.conj (x : ↥B)).toMonoidHom := by
      refine Subgroup.mem_map.mpr ⟨⟨p, hpB⟩, Subgroup.mem_subgroupOf.mpr hp, Subtype.ext ?_⟩
      show ((MulAut.conj (x : ↥B)) (⟨p, hpB⟩ : ↥B) : A) = y
      rw [MulAut.conj_apply]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      exact hpy
    exact h ⟨y, hyB⟩ hmem
  · intro h u hu
    rw [Subgroup.mem_map] at hu
    obtain ⟨p, hp, hpu⟩ := hu
    have hmem : (u : A) ∈ P.map (MulAut.conj (x : A)).toMonoidHom := by
      have hpu' : ((x : ↥B) : A) * ((p : ↥B) : A) * (((x : ↥B) : A))⁻¹ = ((u : ↥B) : A) := by
        have h1 := congrArg (Subtype.val : ↥B → A) hpu
        simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h1
        simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using h1
      refine Subgroup.mem_map.mpr ⟨((p : ↥B) : A), Subgroup.mem_subgroupOf.mp hp, ?_⟩
      simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using hpu'
    exact h (u : A) hmem

/-- `appVIIZ` is unchanged when the acting group `A` is replaced by a subgroup `B ≤ A` containing
`P` and `Q`. -/
theorem appVIIZ_subgroupOf_eq (P Q B : Subgroup A) (hPB : P ≤ B) (hQB : Q ≤ B) :
    appVIIZ ↥B (P.subgroupOf B) (Q.subgroupOf B) K = appVIIZ A P Q K := by
  letI : MulDistribMulAction ↥B K := instRestrictAct B
  have h1 : (appVIIF1 ↥B (P.subgroupOf B) (Q.subgroupOf B) K : Set K) = appVIIF1 A P Q K :=
    Set.ext fun k => mem_appVIIF1_subgroupOf_iff hPB hQB k
  have h2 : {k : K | ∃ x : ↥(Q.subgroupOf B),
        k ∈ appVIIFx ↥B (P.subgroupOf B) (Q.subgroupOf B) K x}
      = {k : K | ∃ x : ↥Q, k ∈ appVIIFx A P Q K x} := by
    ext k
    constructor
    · rintro ⟨x, hx⟩
      exact ⟨⟨(x : A), Subgroup.mem_subgroupOf.mp x.2⟩,
        (mem_appVIIFx_subgroupOf_iff hPB hQB x k).mp hx⟩
    · rintro ⟨x, hx⟩
      refine ⟨⟨⟨(x : A), hQB x.2⟩, Subgroup.mem_subgroupOf.mpr x.2⟩, ?_⟩
      refine (mem_appVIIFx_subgroupOf_iff hPB hQB
        (⟨⟨(x : A), hQB x.2⟩, Subgroup.mem_subgroupOf.mpr x.2⟩ : ↥(Q.subgroupOf B)) k).mpr ?_
      convert hx using 2
  rw [appVIIZ, appVIIZ, h1, h2]

end API

end Work.Hering.AppVII
