/-! ## Auxiliary lemmas

The proof of `cType_mixed` uses the following elementary facts about `K = GF(2 ^ (2s+1))`. -/

/-- An additive map sends `0` to `0`. -/
lemma additive_zero {K : Type*} [AddCommGroup K] {f : K → K}
    (hf : ∀ x y, f (x + y) = f x + f y) : f 0 = 0 := by
  have h : f 0 = f 0 + f 0 := by simpa using hf 0 0
  exact (add_left_cancel (show f 0 + 0 = f 0 + f 0 by rw [add_zero]; exact h)).symm

/-- In characteristic two, the `2 ^ k`-th power of a sum is the sum of `2 ^ k`-th powers
(of elements of `K = GF(2 ^ (2s+1))`). -/
lemma add_pow_two_pow {s : ℕ} (k : ℕ) (a b : KC s) :
    (a + b) ^ (2 ^ k) = a ^ (2 ^ k) + b ^ (2 ^ k) := by
  have h1 := frobeniusEquiv_pow_apply (2 * s + 1) k (a + b)
  have h2 := frobeniusEquiv_pow_apply (2 * s + 1) k a
  have h3 := frobeniusEquiv_pow_apply (2 * s + 1) k b
  have h4 : ((frobeniusEquiv (KC s) 2) ^ k) (a + b) =
      ((frobeniusEquiv (KC s) 2) ^ k) a + ((frobeniusEquiv (KC s) 2) ^ k) b := map_add _ a b
  rw [← h1, h4, h2, h3]

/-- **Every ring automorphism of `GF(2ⁿ)` (`n ≠ 0`) is a Frobenius power** `x ↦ x ^ (2 ^ i)`.
The proof is that of `frobPowOfFourth`, without the hypothesis `φ ^ 4 ≠ 1`: a ring automorphism
of `GF(2ⁿ)` fixes the prime field, hence is an algebra automorphism, and the Galois group of
`GF(2ⁿ)` over `ZMod 2` is generated by the Frobenius. -/
theorem ringAut_eq_frobPow {n : ℕ} (hn : n ≠ 0)
    (φ : GaloisField 2 n ≃+* GaloisField 2 n) :
    ∃ i : ℕ, ∀ x : GaloisField 2 n, φ x = x ^ (2 ^ i) := by
  have hfix : ∀ c : ZMod 2, φ (algebraMap (ZMod 2) (GaloisField 2 n) c) =
      algebraMap (ZMod 2) (GaloisField 2 n) c := fun c => ringEquiv_algebraMap_eq φ c
  let φ' : GaloisField 2 n ≃ₐ[ZMod 2] GaloisField 2 n := AlgEquiv.ofRingEquiv hfix
  have hbij := FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) (GaloisField 2 n)
  rw [GaloisField.finrank 2 hn] at hbij
  obtain ⟨k, hk⟩ := hbij.2 φ'
  refine ⟨(k : ℕ), fun x => ?_⟩
  have hfrob : ⇑(FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n)) =
      fun y => y ^ 2 := by
    rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ZMod.card]
  calc φ x = φ' x := (AlgEquiv.ofRingEquiv_apply hfix x).symm
    _ = (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n) ^ (k : ℕ)) x := by
          rw [← hk]
    _ = x ^ (2 ^ (k : ℕ)) := by rw [AlgEquiv.coe_pow, hfrob, pow_iterate]

/-- The explicit form of `quadC`: `q(x,y) = x ^ (2 ^ s + 1) + ε · x ^ (2 ^ (2s)) · y ^ (2 ^ (s+1))
+ y ^ 2`.  (Here `sqrtF x = x ^ (2 ^ (2s))` and `thetaC s (y * y) = y ^ (2 ^ (s+1))`.) -/
theorem quadC_expand (s : ℕ) (ε : KC s) (x y : KC s) :
    quadC s ε (x, y) = x ^ (2 ^ s + 1) + ε * (x ^ (2 ^ (2 * s)) * y ^ (2 ^ (s + 1))) + y ^ 2 := by
  have hn : 0 < 2 * s + 1 := by omega
  have h1 : (2 * s + 1) - 1 = 2 * s := by omega
  have hx : x * x ^ (2 ^ s) = x ^ (2 ^ s + 1) := by
    calc x * x ^ (2 ^ s) = x ^ 1 * x ^ (2 ^ s) := by rw [pow_one]
      _ = x ^ (1 + 2 ^ s) := (pow_add x 1 (2 ^ s)).symm
      _ = x ^ (2 ^ s + 1) := by congr 1; omega
  have hy : (y * y) ^ (2 ^ s) = y ^ (2 ^ (s + 1)) := by
    rw [← pow_two y, ← pow_mul]
    congr 1
    rw [pow_succ', Nat.mul_comm]
  simp only [quadC, cCocycle, thetaC]
  rw [frobeniusEquiv_pow_apply (2 * s + 1) s x,
    frobeniusEquiv_pow_apply (2 * s + 1) s (y * y),
    sqrtF_eq_pow (2 * s + 1) hn x, h1, hx, hy, pow_two]

/-- **App. VIII (the mixed case).**  Let `K = GF(2 ^ (2s+1))`, `s ≥ 1`, `ε ≠ 0`.  Suppose
`f₁ f₂ f₃ g : K → K` are additive, `f₁`, `f₂` injective, and
`g (q (x,y)) = q (f₁ x, f₃ x + f₂ y)` for the squaring form `q` of `C(n,ε)`.  Then `f₁` and `f₂`
are Frobenius monomials with the *same* exponent: `f₁ x = a₁ · x ^ (2 ^ i)`,
`f₂ y = a₂ · y ^ (2 ^ i)` with `a₁ a₂ ≠ 0`.

The hypothesis decouples (in characteristic two) into the single *mixed* relation
`g (ε x ^ (2^(2s)) y ^ (2^(s+1))) = ε (f₁ x) ^ (2^(2s)) (f₂ y) ^ (2^(s+1))`, in which the shear
`f₃` cancels.  Writing `u = x ^ (2^(2s))`, `v = y ^ (2^(s+1))` this reads
`g (ε u v) = ε A u · B v` for the additive bijections `A = σ ∘ f₁ ∘ σ⁻¹`, `B = τ ∘ f₂ ∘ τ⁻¹`
(`σ = x ↦ x ^ 2^(2s)`, `τ = y ↦ y ^ 2^(s+1)`).  Comparing the value at `(u v, 1)` with `(u,v)`
gives `A (u v) · B 1 = A u · B v`, whence `A 1 · A (u v) = A u · A v`: the map
`u ↦ A u / A 1` is a ring endomorphism of the finite field `K`, hence a Frobenius power `Φ ^ i`.
The relation `A 1 · B v = A v · B 1` shows that `B` is a Frobenius power with the *same* `i`. -/
theorem cType_mixed {s : ℕ} (hs : 1 ≤ s) {ε : KC s} (hε : ε ≠ 0)
    (f₁ f₂ f₃ g : KC s → KC s)
    (hf₁ : ∀ x y, f₁ (x + y) = f₁ x + f₁ y) (hf₂ : ∀ x y, f₂ (x + y) = f₂ x + f₂ y)
    (hf₃ : ∀ x y, f₃ (x + y) = f₃ x + f₃ y) (hg : ∀ x y, g (x + y) = g x + g y)
    (hf₁inj : Function.Injective f₁) (hf₂inj : Function.Injective f₂)
    (main : ∀ x y : KC s, g (quadC s ε (x, y)) = quadC s ε (f₁ x, f₃ x + f₂ y)) :
    ∃ (i : ℕ) (a₁ a₂ : KC s), a₁ ≠ 0 ∧ a₂ ≠ 0 ∧
      (∀ x : KC s, f₁ x = a₁ * x ^ (2 ^ i)) ∧ (∀ y : KC s, f₂ y = a₂ * y ^ (2 ^ i)) := by
  have hf₁0 : f₁ 0 = 0 := additive_zero hf₁
  have hf₂0 : f₂ 0 = 0 := additive_zero hf₂
  have hf₃0 : f₃ 0 = 0 := additive_zero hf₃
  have hf₁1 : f₁ (1 : KC s) ≠ 0 := fun h => one_ne_zero (hf₁inj (by rw [h, hf₁0]))
  have hf₂1 : f₂ (1 : KC s) ≠ 0 := fun h => one_ne_zero (hf₂inj (by rw [h, hf₂0]))
  have hg3 : ∀ a b c : KC s, g (a + b + c) = g a + g b + g c := by
    intro a b c
    rw [hg (a + b) c, hg a b]
  -- ## Step 1: the mixed relation
  have mixed : ∀ x y : KC s,
      g (ε * (x ^ (2 ^ (2 * s)) * y ^ (2 ^ (s + 1)))) =
        ε * ((f₁ x) ^ (2 ^ (2 * s)) * (f₂ y) ^ (2 ^ (s + 1))) := by
    intro x y
    have h0 : g (x ^ (2 ^ s + 1)) =
        (f₁ x) ^ (2 ^ s + 1) + ε * ((f₁ x) ^ (2 ^ (2 * s)) * (f₃ x) ^ (2 ^ (s + 1)))
          + (f₃ x) ^ 2 := by
      have h := main x 0
      rw [quadC_expand, quadC_expand, hf₂0] at h
      simpa using h
    have hy0 : g (y ^ 2) = (f₂ y) ^ 2 := by
      have h := main 0 y
      rw [quadC_expand, quadC_expand, hf₁0, hf₃0] at h
      simpa using h
    have hgen := main x y
    rw [quadC_expand, quadC_expand] at hgen
    rw [hg3] at hgen
    rw [h0, hy0] at hgen
    rw [add_pow_two_pow (s := s) (s + 1) (f₃ x) (f₂ y)] at hgen
    rw [CharTwo.add_sq (f₃ x) (f₂ y)] at hgen
    linear_combination (1 : KC s) * hgen
  -- ## Step 2: change of variables
  let σ : KC s ≃+* KC s := (frobeniusEquiv (KC s) 2) ^ (2 * s)
  let τ : KC s ≃+* KC s := (frobeniusEquiv (KC s) 2) ^ (s + 1)
  have hσ : ∀ x : KC s, σ x = x ^ (2 ^ (2 * s)) :=
    fun x => frobeniusEquiv_pow_apply (2 * s + 1) (2 * s) x
  have hτ : ∀ y : KC s, τ y = y ^ (2 ^ (s + 1)) :=
    fun y => frobeniusEquiv_pow_apply (2 * s + 1) (s + 1) y
  let A : KC s → KC s := fun u => σ (f₁ (σ.symm u))
  let B : KC s → KC s := fun v => τ (f₂ (τ.symm v))
  have hAeq : ∀ u : KC s, (f₁ (σ.symm u)) ^ (2 ^ (2 * s)) = A u := by
    intro u
    show (f₁ (σ.symm u)) ^ (2 ^ (2 * s)) = σ (f₁ (σ.symm u))
    rw [hσ]
  have hBeq : ∀ v : KC s, (f₂ (τ.symm v)) ^ (2 ^ (s + 1)) = B v := by
    intro v
    show (f₂ (τ.symm v)) ^ (2 ^ (s + 1)) = τ (f₂ (τ.symm v))
    rw [hτ]
  have hσc : ∀ u : KC s, (σ.symm u) ^ (2 ^ (2 * s)) = u := by
    intro u
    rw [← hσ (σ.symm u), RingEquiv.apply_symm_apply σ u]
  have hτc : ∀ v : KC s, (τ.symm v) ^ (2 ^ (s + 1)) = v := by
    intro v
    rw [← hτ (τ.symm v), RingEquiv.apply_symm_apply τ v]
  have hAB : ∀ u v : KC s, g (ε * (u * v)) = ε * (A u * B v) := by
    intro u v
    have h := mixed (σ.symm u) (τ.symm v)
    simp only [hAeq, hBeq, hσc, hτc] at h
    exact h
  have hB1 : B 1 ≠ 0 := by
    have h1 : B 1 = τ (f₂ 1) := by simp [B]
    rw [h1]
    exact fun h => hf₂1 (τ.injective (by rw [h, map_zero]))
  have hA1ne : A 1 ≠ 0 := by
    have h1 : A 1 = σ (f₁ 1) := by simp [A]
    rw [h1]
    exact fun h => hf₁1 (σ.injective (by rw [h, map_zero]))
  -- ## Step 3: multiplicativity of `A` up to the scalar `A 1`
  have h1rel : ∀ u v : KC s, A (u * v) * B 1 = A u * B v := by
    intro u v
    have h := hAB (u * v) 1
    have h' := hAB u v
    rw [mul_one] at h
    exact mul_left_cancel₀ hε (h.symm.trans h')
  have h2rel : ∀ v : KC s, A 1 * B v = A v * B 1 := by
    intro v
    have h := hAB 1 v
    have h' := hAB v 1
    rw [one_mul] at h
    rw [mul_one] at h'
    exact mul_left_cancel₀ hε (h.symm.trans h')
  have h3rel : ∀ u v : KC s, A 1 * A (u * v) = A u * A v := by
    intro u v
    have key : A 1 * (A (u * v) * B 1) = A u * (A v * B 1) := by
      calc A 1 * (A (u * v) * B 1) = A 1 * (A u * B v) := by rw [h1rel u v]
        _ = (A 1 * A u) * B v := (mul_assoc (A 1) (A u) (B v)).symm
        _ = (A u * A 1) * B v := by rw [mul_comm (A 1) (A u)]
        _ = A u * (A 1 * B v) := mul_assoc (A u) (A 1) (B v)
        _ = A u * (A v * B 1) := by rw [h2rel v]
    have key' : (A 1 * A (u * v)) * B 1 = (A u * A v) * B 1 := by
      rw [mul_assoc (A 1) (A (u * v)) (B 1), mul_assoc (A u) (A v) (B 1)]
      exact key
    exact mul_right_cancel₀ hB1 key'
  have hAadd : ∀ u v : KC s, A (u + v) = A u + A v := by
    intro u v
    show σ (f₁ (σ.symm (u + v))) = σ (f₁ (σ.symm u)) + σ (f₁ (σ.symm v))
    rw [map_add (σ.symm) u v, hf₁ (σ.symm u) (σ.symm v), map_add (σ)]
  have hA0 : A 0 = 0 := by
    show σ (f₁ (σ.symm 0)) = 0
    rw [show σ.symm 0 = 0 from map_zero σ.symm, hf₁0, map_zero]
  have hAmul : ∀ u v : KC s, A (u * v) = (A 1)⁻¹ * (A u * A v) := by
    intro u v
    rw [← h3rel u v, ← mul_assoc, inv_mul_cancel₀ hA1ne, one_mul]
  -- ## Step 4: `u ↦ A u / A 1` is a ring endomorphism of `K`, hence a Frobenius power
  let ψ : KC s →+* KC s :=
    { toFun := fun u => (A 1)⁻¹ * A u
      map_one' := inv_mul_cancel₀ hA1ne
      map_mul' := by
        intro u v
        show (A 1)⁻¹ * A (u * v) = ((A 1)⁻¹ * A u) * ((A 1)⁻¹ * A v)
        rw [hAmul u v]; ring
      map_zero' := by
        show (A 1)⁻¹ * A 0 = 0
        rw [hA0, mul_zero]
      map_add' := by
        intro u v
        show (A 1)⁻¹ * A (u + v) = (A 1)⁻¹ * A u + (A 1)⁻¹ * A v
        rw [hAadd u v, mul_add] }
  have hψinj : Function.Injective ψ := by
    intro u v huv
    have huv' : (A 1)⁻¹ * A u = (A 1)⁻¹ * A v := huv
    have hA : A u = A v := mul_left_cancel₀ (inv_ne_zero hA1ne) huv'
    have h1 : f₁ (σ.symm u) = f₁ (σ.symm v) := σ.injective (by
      show σ (f₁ (σ.symm u)) = σ (f₁ (σ.symm v))
      exact hA)
    have h2 : σ.symm u = σ.symm v := hf₁inj h1
    calc u = σ (σ.symm u) := (RingEquiv.apply_symm_apply σ u).symm
      _ = σ (σ.symm v) := by rw [h2]
      _ = v := RingEquiv.apply_symm_apply σ v
  have hψbij : Function.Bijective ψ :=
    ⟨hψinj, Finite.injective_iff_surjective.mp hψinj⟩
  let ψe : KC s ≃+* KC s := RingEquiv.ofBijective ψ hψbij
  obtain ⟨i, hi⟩ := ringAut_eq_frobPow (by omega : 2 * s + 1 ≠ 0) ψe
  have hψA : ∀ u : KC s, (A 1)⁻¹ * A u = u ^ (2 ^ i) := fun u => hi u
  -- ## Step 5: the structure of `A` and `B`
  have hAform : ∀ u : KC s, A u = A 1 * u ^ (2 ^ i) := by
    intro u
    calc A u = A 1 * ((A 1)⁻¹ * A u) := by
          rw [← mul_assoc, mul_inv_cancel₀ hA1ne, one_mul]
      _ = A 1 * u ^ (2 ^ i) := by rw [hψA u]
  have hBform : ∀ v : KC s, B v = v ^ (2 ^ i) * B 1 := by
    intro v
    calc B v = (A 1)⁻¹ * (A 1 * B v) := by
          rw [← mul_assoc, inv_mul_cancel₀ hA1ne, one_mul]
      _ = (A 1)⁻¹ * (A v * B 1) := by rw [h2rel v]
      _ = ((A 1)⁻¹ * A v) * B 1 := (mul_assoc (A 1)⁻¹ (A v) (B 1)).symm
      _ = v ^ (2 ^ i) * B 1 := by rw [hψA v]
  -- ## Step 6: read off `f₁` and `f₂`
  refine ⟨i, f₁ 1, f₂ 1, hf₁1, hf₂1, ?_, ?_⟩
  · intro x
    have hAσ : A (σ x) = σ (f₁ x) := by
      show σ (f₁ (σ.symm (σ x))) = σ (f₁ x)
      rw [RingEquiv.symm_apply_apply σ x]
    have hscale : σ.symm (A 1) = f₁ 1 := by
      show σ.symm (σ (f₁ (σ.symm 1))) = f₁ 1
      rw [RingEquiv.symm_apply_apply σ (f₁ (σ.symm 1)), show σ.symm 1 = 1 from map_one σ.symm]
    calc f₁ x = σ.symm (σ (f₁ x)) := (RingEquiv.symm_apply_apply σ (f₁ x)).symm
      _ = σ.symm (A (σ x)) := by rw [hAσ]
      _ = σ.symm (A 1 * (σ x) ^ (2 ^ i)) := by rw [hAform]
      _ = σ.symm (A 1) * σ.symm ((σ x) ^ (2 ^ i)) := by
            rw [map_mul (σ.symm) (A 1) ((σ x) ^ (2 ^ i))]
      _ = σ.symm (A 1) * x ^ (2 ^ i) := by
            rw [map_pow (σ.symm) (σ x) (2 ^ i), RingEquiv.symm_apply_apply σ x]
      _ = f₁ 1 * x ^ (2 ^ i) := by rw [hscale]
  · intro y
    have hBτ : B (τ y) = τ (f₂ y) := by
      show τ (f₂ (τ.symm (τ y))) = τ (f₂ y)
      rw [RingEquiv.symm_apply_apply τ y]
    have hscale : τ.symm (B 1) = f₂ 1 := by
      show τ.symm (τ (f₂ (τ.symm 1))) = f₂ 1
      rw [RingEquiv.symm_apply_apply τ (f₂ (τ.symm 1)), show τ.symm 1 = 1 from map_one τ.symm]
    calc f₂ y = τ.symm (τ (f₂ y)) := (RingEquiv.symm_apply_apply τ (f₂ y)).symm
      _ = τ.symm (B (τ y)) := by rw [hBτ]
      _ = τ.symm ((τ y) ^ (2 ^ i) * B 1) := by rw [hBform]
      _ = τ.symm ((τ y) ^ (2 ^ i)) * τ.symm (B 1) := by
            rw [map_mul (τ.symm) ((τ y) ^ (2 ^ i)) (B 1)]
      _ = y ^ (2 ^ i) * f₂ 1 := by
            rw [map_pow (τ.symm) (τ y) (2 ^ i), RingEquiv.symm_apply_apply τ y, hscale]
      _ = f₂ 1 * y ^ (2 ^ i) := by rw [mul_comm]

end Work.Hering.AppVIII
