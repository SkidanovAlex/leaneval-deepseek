/-!
# The automorphisms of `GF(2ⁿ)` with `φ⁴ ≠ 1` are powers of the Frobenius

Appendix VIII of Peterfalvi I needs the description of the field automorphisms of `GF(2ⁿ)`
as powers of the Frobenius `x ↦ x ^ 2`.  The main content of this file is the standard fact
that `Aut(GF(2ⁿ))` is cyclic of order `n`, generated by the Frobenius `σ : x ↦ x ^ 2`:

if `φ` is a ring automorphism of `GaloisField 2 n` with `φ ^ 4 ≠ 1`, then `φ` is `σ ^ s` for a
*unique* `s < n`, and the hypothesis `φ ^ 4 ≠ 1` says exactly that `n ∤ 4 * s`.
-/

set_option autoImplicit false

namespace Work.Hering.AppVIII

/-- A ring homomorphism out of `ZMod p` is determined by its value at `1`; since `ZMod p` is
generated by `1`, any two ring homs `ZMod p →+* R` agree. -/
lemma ringHom_eq_of_zmod {p : ℕ} [NeZero p] {R : Type*} [NonAssocSemiring R]
    (f g : ZMod p →+* R) : f = g := by
  ext c
  obtain ⟨k, hk⟩ : ∃ k : ℕ, (k : ZMod p) = c := ⟨c.val, ZMod.natCast_zmod_val c⟩
  subst hk
  simp

/-- A ring automorphism of a `ZMod p`-algebra fixes the prime field `ZMod p` pointwise (it
commutes with the algebra structure map). -/
lemma ringEquiv_algebraMap_eq {p : ℕ} [NeZero p] {R : Type*} [Ring R] [Algebra (ZMod p) R]
    (φ : R ≃+* R) (c : ZMod p) : φ (algebraMap (ZMod p) R c) = algebraMap (ZMod p) R c :=
  RingHom.congr_fun
    (ringHom_eq_of_zmod (φ.toRingHom.comp (algebraMap (ZMod p) R)) (algebraMap (ZMod p) R)) c

/-- The `k`-th power of the Frobenius automorphism of `GF(2ⁿ)` is the map `x ↦ x ^ (2 ^ k)`. -/
lemma frobeniusEquiv_pow_apply (n k : ℕ) (x : GaloisField 2 n) :
    ((frobeniusEquiv (GaloisField 2 n) 2) ^ k) x = x ^ (2 ^ k) := by
  rw [← iterateFrobeniusEquiv_eq_pow]
  rfl

/-- **App. VIII, preliminary.** Every ring automorphism `φ` of `GF(2ⁿ)` with `φ ^ 4 ≠ 1` is the
`2^s`-th power map for a unique `s < n`, and necessarily `n ∤ 4 * s`.

Indeed `Aut(GF(2ⁿ))` is cyclic of order `n`, generated by the Frobenius `σ : x ↦ x ^ 2`, so
`φ = σ ^ s` for a unique `s < n`; as `σ` has order `n`, `n ∣ 4 * s` would force
`φ ^ 4 = σ ^ (4 * s) = 1`. -/
theorem frobPowOfFourth {n : ℕ} (hn : n ≠ 0)
    (φ : GaloisField 2 n ≃+* GaloisField 2 n) (hφ : φ ^ 4 ≠ 1) :
    ∃ s : ℕ, s < n ∧ ¬ n ∣ 4 * s ∧ ∀ x : GaloisField 2 n, φ x = x ^ (2 ^ s) := by
  -- `φ` is an automorphism of the `ZMod 2`-algebra `GF(2ⁿ)`, since it fixes the prime field.
  have hfix : ∀ c : ZMod 2, φ (algebraMap (ZMod 2) (GaloisField 2 n) c) =
      algebraMap (ZMod 2) (GaloisField 2 n) c := fun c => ringEquiv_algebraMap_eq φ c
  let φ' : GaloisField 2 n ≃ₐ[ZMod 2] GaloisField 2 n := AlgEquiv.ofRingEquiv hfix
  -- The Galois group over the prime field is generated by the Frobenius, of order
  -- `finrank (ZMod 2) GF(2ⁿ) = n`.
  have hbij := FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) (GaloisField 2 n)
  rw [GaloisField.finrank 2 hn] at hbij
  obtain ⟨k, hk⟩ := hbij.2 φ'
  have hk' : (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n) ^ (k : ℕ)) =
      φ' := hk
  -- `φ` is the map `x ↦ x ^ 2 ^ k`.
  have hfun : ∀ x : GaloisField 2 n, φ x = x ^ (2 ^ (k : ℕ)) := by
    intro x
    have hfrob : ⇑(FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n)) =
        fun y => y ^ 2 := by
      rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ZMod.card]
    calc φ x = φ' x := (AlgEquiv.ofRingEquiv_apply hfix x).symm
      _ = (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n) ^ (k : ℕ)) x := by
            rw [← hk']
      _ = x ^ (2 ^ (k : ℕ)) := by rw [AlgEquiv.coe_pow, hfrob, pow_iterate]
  refine ⟨k.1, k.2, ?_, ?_⟩
  · -- `n ∣ 4 * s` would give `φ ^ 4 = σ ^ (4 * s) = 1`.
    intro hdvd
    apply hφ
    have hσ : φ = (frobeniusEquiv (GaloisField 2 n) 2) ^ (k : ℕ) := by
      refine RingEquiv.ext fun x => ?_
      rw [frobeniusEquiv_pow_apply]
      exact hfun x
    rw [hσ]
    have horder : orderOf (frobeniusEquiv (GaloisField 2 n) 2) = n := by
      have := Work.Higman.orderOf_frobeniusEquiv_pow n 1 (Nat.pos_iff_ne_zero.mpr hn)
      simpa using this
    have h2 : (frobeniusEquiv (GaloisField 2 n) 2) ^ (4 * (k : ℕ)) = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp (by rw [horder]; exact hdvd)
    rw [← pow_mul, Nat.mul_comm (k : ℕ) 4]
    exact h2
  · intro x
    simpa using hfun x

end Work.Hering.AppVIII
