set_option linter.style.haveILetI false

open scoped Pointwise

namespace Work.GroupTheory

/-- Let `T` be a `2`-subgroup of a finite group `L` of odd index (i.e. a Sylow `2`-subgroup), and let
`a ≠ b` be two commuting involutions of `L`.  Then `T` itself contains two distinct commuting
involutions.

Proof: `⟨a, b⟩ ≅ C₂ × C₂` is a `2`-subgroup of `L`, hence lies in a Sylow `2`-subgroup `Q`.  All
Sylow `2`-subgroups are conjugate, so `Q` is the image of `T` under conjugation by some `g`, and
the conjugates of `a` and `b` by `g` are the required elements of `T`. -/
theorem exists_pair_mem_of_odd_index {L : Type} [Group L] [Finite L] {T : Subgroup L}
    (hT : IsPGroup 2 T) (hidx : Odd T.index) {a b : L}
    (ha : orderOf a = 2) (hb : orderOf b = 2) (hne : a ≠ b) (hcomm : a * b = b * a) :
    ∃ a' ∈ T, ∃ b' ∈ T, orderOf a' = 2 ∧ orderOf b' = 2 ∧ a' ≠ b' ∧ a' * b' = b' * a' := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  -- ### `T` is a Sylow `2`-subgroup: its index is odd, hence not divisible by `2`.
  have hnotdvd : ¬ 2 ∣ T.index :=
    fun h => (Nat.not_even_iff_odd.mpr hidx) (even_iff_two_dvd.mpr h)
  let TP : Sylow 2 L := hT.toSylow hnotdvd
  have hTP : (TP : Subgroup L) = T := IsPGroup.toSylow_coe hT hnotdvd
  -- ### The subgroup generated by `a` and `b` is a `2`-group.
  let V : Subgroup L := Subgroup.zpowers a ⊔ Subgroup.zpowers b
  have hVp : IsPGroup 2 V := by
    have hHa : IsPGroup 2 (Subgroup.zpowers a) :=
      IsPGroup.of_card (p := 2) (n := 1) (by rw [Nat.card_zpowers, ha, pow_one])
    have hHb : IsPGroup 2 (Subgroup.zpowers b) :=
      IsPGroup.of_card (p := 2) (n := 1) (by rw [Nat.card_zpowers, hb, pow_one])
    -- `b` commutes with `a`, hence normalizes `⟨a⟩`, so `⟨b⟩` may be adjoined to a `2`-group.
    have hle : Subgroup.zpowers b ≤ Subgroup.normalizer (Subgroup.zpowers a : Set L) := by
      apply Subgroup.zpowers_le.mpr
      apply Subgroup.centralizer_le_normalizer
      rw [Subgroup.mem_centralizer_iff]
      intro h hh
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
      exact (Commute.zpow_left hcomm k).eq
    exact IsPGroup.to_sup_of_normal_left' hHa hHb hle
  have hVa : a ∈ V := Subgroup.mem_sup_left (Subgroup.mem_zpowers a)
  have hVb : b ∈ V := Subgroup.mem_sup_right (Subgroup.mem_zpowers b)
  -- ### `V` lies in a Sylow `2`-subgroup `Q`, which is conjugate to `T`.
  obtain ⟨Q, hVQ⟩ := hVp.exists_le_sylow
  have haQ : a ∈ (Q : Subgroup L) := hVQ hVa
  have hbQ : b ∈ (Q : Subgroup L) := hVQ hVb
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq L Q TP
  have hgsub : MulAut.conj g • (Q : Subgroup L) = (TP : Subgroup L) := by
    apply SetLike.ext'
    rw [Subgroup.coe_pointwise_smul]
    have h := congrArg (fun S : Sylow 2 L => (S : Set L)) hg
    rwa [Sylow.coe_smul] at h
  -- ### The required elements are the conjugates of `a` and `b` by `g`.
  set a' : L := MulAut.conj g • a with ha'def
  set b' : L := MulAut.conj g • b with hb'def
  have ha'eq : a' = g * a * g⁻¹ := by rw [ha'def, MulAut.smul_def, MulAut.conj_apply]
  have hb'eq : b' = g * b * g⁻¹ := by rw [hb'def, MulAut.smul_def, MulAut.conj_apply]
  have ha'T : a' ∈ T := by
    have h1 : MulAut.conj g • a ∈ MulAut.conj g • (Q : Subgroup L) :=
      Subgroup.smul_mem_pointwise_smul a (MulAut.conj g) Q haQ
    rw [hgsub] at h1
    simpa only [ha'def, hTP] using h1
  have hb'T : b' ∈ T := by
    have h1 : MulAut.conj g • b ∈ MulAut.conj g • (Q : Subgroup L) :=
      Subgroup.smul_mem_pointwise_smul b (MulAut.conj g) Q hbQ
    rw [hgsub] at h1
    simpa only [hb'def, hTP] using h1
  -- ### Order is preserved by conjugation.
  have hconj_order : ∀ x : L, orderOf (g * x * g⁻¹) = orderOf x := by
    intro x
    rw [orderOf_eq_orderOf_iff]
    intro n
    rw [conj_pow]
    constructor
    · intro h
      have h2 := congrArg (fun y => g⁻¹ * y * g) h
      calc x ^ n = g⁻¹ * (g * x ^ n * g⁻¹) * g := by group
        _ = g⁻¹ * 1 * g := h2
        _ = 1 := by group
    · intro h; rw [h]; group
  have horder_a' : orderOf a' = 2 := by rw [ha'eq, hconj_order a, ha]
  have horder_b' : orderOf b' = 2 := by rw [hb'eq, hconj_order b, hb]
  -- ### Distinctness and commutation are preserved by conjugation.
  have hne' : a' ≠ b' := by
    intro h
    apply hne
    have h2 : g * a * g⁻¹ = g * b * g⁻¹ := by rw [ha'eq, hb'eq] at h; exact h
    calc a = g⁻¹ * (g * a * g⁻¹) * g := by group
      _ = g⁻¹ * (g * b * g⁻¹) * g := by rw [h2]
      _ = b := by group
  have hcomm' : a' * b' = b' * a' := by
    calc a' * b' = g * (a * b) * g⁻¹ := by rw [ha'eq, hb'eq]; group
      _ = g * (b * a) * g⁻¹ := by rw [hcomm]
      _ = b' * a' := by rw [ha'eq, hb'eq]; group
  exact ⟨a', ha'T, b', hb'T, horder_a', horder_b', hne', hcomm'⟩

end Work.GroupTheory
