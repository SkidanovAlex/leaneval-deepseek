namespace Work.GroupTheory

/-- **Any choice of one Sylow subgroup per prime generates.**  Let `K` be a finite group and, for
each prime `p`, let `S p` be a Sylow `p`-subgroup of `K`.  Then the subgroup generated by all the
`S p` is `⊤`.

Proof: `|S p| = p ^ (|K|).factorization p` (`Sylow.card_eq_multiplicity`), so for every prime
`p ∣ |K|` Lagrange gives `p ^ v_p(|K|) ∣ |H|` where `H` is the join; the factors are pairwise
coprime, so `|K| = ∏_p p ^ v_p(|K|) ∣ |H|` and hence `H = ⊤`. -/
theorem SylowIUnionTop {K : Type*} [Group K] [Finite K] (S : ∀ (p : ℕ), p.Prime → Sylow p K) :
    (⨆ (p : ℕ) (hp : p.Prime), ((S p hp : Sylow p K) : Subgroup K)) = ⊤ := by
  classical
  -- `H` is the subgroup generated by the chosen Sylow subgroups.
  set H : Subgroup K := ⨆ (p : ℕ) (hp : p.Prime), ((S p hp : Sylow p K) : Subgroup K) with hH
  -- Each chosen Sylow subgroup lies in `H`.
  have hSle : ∀ (p : ℕ) (hp : p.Prime), ((S p hp : Sylow p K) : Subgroup K) ≤ H := by
    intro p hp
    rw [hH]
    exact le_iSup_of_le p (le_iSup_of_le hp le_rfl)
  have hK_ne : Nat.card K ≠ 0 := Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
  have hH_ne : Nat.card H ≠ 0 := Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
  -- `|K| ∣ |H|`: for every prime `p`, `p ^ v_p(|K|) = |S p| ∣ |H|`, hence `v_p(|K|) ≤ v_p(|H|)`.
  have hdvd1 : Nat.card K ∣ Nat.card H := by
    rw [← Nat.factorization_le_iff_dvd hK_ne hH_ne, Finsupp.le_def]
    intro p
    by_cases hp : p.Prime
    · have : Fact p.Prime := ⟨hp⟩
      have h1 : Nat.card ↥(((S p hp : Sylow p K)) : Subgroup K) ∣ Nat.card H :=
        Subgroup.card_dvd_of_le (hSle p hp)
      have h2 : Nat.card ↥(((S p hp : Sylow p K)) : Subgroup K) =
          p ^ (Nat.card K).factorization p := Sylow.card_eq_multiplicity (S p hp)
      have h3 : p ^ (Nat.card K).factorization p ∣ Nat.card H := h2 ▸ h1
      exact (Nat.Prime.pow_dvd_iff_le_factorization hp hH_ne).mp h3
    · rw [Nat.factorization_eq_zero_of_not_prime _ hp,
        Nat.factorization_eq_zero_of_not_prime _ hp]
  -- Lagrange: `H ≤ K` gives `|H| ∣ |K|`.
  have hdvd2 : Nat.card H ∣ Nat.card K := Subgroup.card_subgroup_dvd_card H
  have hcard : Nat.card H = Nat.card K := (Nat.dvd_antisymm hdvd1 hdvd2).symm
  exact Subgroup.eq_top_of_card_eq H hcard

end Work.GroupTheory
