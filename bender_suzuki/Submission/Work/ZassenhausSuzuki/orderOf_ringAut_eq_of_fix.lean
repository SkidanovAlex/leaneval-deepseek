namespace Work.ZassenhausSuzuki

open IntermediateField

/-- A ring endomorphism of a `ZMod 2`-algebra is automatically `ZMod 2`-linear:
it agrees with the structure map, because `ZMod 2` is generated by `1` as a ring. -/
theorem ringHom_comp_algebraMap_zmod_two (A : Type*) [Ring A] [Algebra (ZMod 2) A]
    (f : A →+* A) :
    f.comp (algebraMap (ZMod 2) A) = algebraMap (ZMod 2) A := by
  ext a
  fin_cases a
  · change f (algebraMap (ZMod 2) A 0) = algebraMap (ZMod 2) A 0; simp
  · change f (algebraMap (ZMod 2) A 1) = algebraMap (ZMod 2) A 1; simp

/-- An automorphism of a finite field with exactly the prime field as its fixed
points has order equal to the degree of the field over its prime field.

Here `GaloisField 2 m` is the field with `2 ^ m` elements, and `θ` is a ring
automorphism whose only fixed points are `0` and `1`. By Artin's theorem the
extension over the fixed field has degree `orderOf θ`, while the fixed field is
the prime field `ZMod 2`, over which the degree is `m`. -/
theorem orderOf_ringAut_eq_of_fix {m : ℕ} (hm : 1 ≤ m)
    (θ : GaloisField 2 m ≃+* GaloisField 2 m)
    (hfix : ∀ x : GaloisField 2 m, θ x = x → x = 0 ∨ x = 1) :
    orderOf θ = m := by
  -- `θ` is a `ZMod 2`-algebra automorphism (see `ringHom_comp_algebraMap_zmod_two`).
  have hcomm : ∀ a : ZMod 2,
      θ (algebraMap (ZMod 2) (GaloisField 2 m) a) = algebraMap (ZMod 2) (GaloisField 2 m) a := by
    intro a
    fin_cases a
    · change θ (algebraMap (ZMod 2) (GaloisField 2 m) 0) = algebraMap (ZMod 2) (GaloisField 2 m) 0
      simp
    · change θ (algebraMap (ZMod 2) (GaloisField 2 m) 1) = algebraMap (ZMod 2) (GaloisField 2 m) 1
      simp
  let θa : GaloisField 2 m ≃ₐ[ZMod 2] GaloisField 2 m := { θ with commutes' := hcomm }
  -- The fixed field of `⟨θa⟩` is exactly the prime field `ZMod 2`.
  have hfixfield : IntermediateField.fixedField (Subgroup.zpowers θa) = ⊥ := by
    apply le_antisymm
    · intro x hx
      rw [IntermediateField.mem_fixedField_iff] at hx
      have hθx : θ x = x := hx θa (Subgroup.mem_zpowers θa)
      rcases hfix x hθx with h | h
      · rw [h]; exact zero_mem _
      · rw [h]; exact one_mem _
    · intro x hx
      rw [IntermediateField.mem_fixedField_iff]
      intro f _
      obtain ⟨a, rfl⟩ := IntermediateField.mem_bot.mp hx
      exact f.commutes a
  -- Artin's theorem: the degree of the extension over the fixed field is the
  -- order of the cyclic group generated by `θa`.
  have hfin : Module.finrank (IntermediateField.fixedField (Subgroup.zpowers θa)) (GaloisField 2 m)
      = Nat.card (Subgroup.zpowers θa) := IntermediateField.finrank_fixedField_eq_card _
  rw [hfixfield, IntermediateField.finrank_bot'] at hfin
  rw [GaloisField.finrank 2 (by omega : m ≠ 0)] at hfin
  have hord : orderOf θa = m := by rw [← Nat.card_zpowers θa]; exact hfin.symm
  -- Transfer the order back from the algebra automorphism group to the ring
  -- automorphism group along the injective forgetful map.
  let φ : (GaloisField 2 m ≃ₐ[ZMod 2] GaloisField 2 m) →*
      (GaloisField 2 m ≃+* GaloisField 2 m) :=
    { toFun := fun e => e.toRingEquiv
      map_one' := by ext; rfl
      map_mul' := by intro a b; ext; rfl }
  have hinj : Function.Injective φ := by
    intro a b h
    ext x
    exact congr_fun (congr_arg DFunLike.coe h) x
  have horder : orderOf θ = orderOf θa := by
    have := orderOf_injective φ hinj θa
    rwa [show φ θa = θ from rfl] at this
  rw [horder, hord]

end Work.ZassenhausSuzuki
