/-!
# The induced map of `Aut(A(K,θ))` on the first coordinate is semilinear

Let `K = GF(2ⁿ)`, let `θ` be a non-trivial automorphism of `K` of *odd* order and let
`A = A(K,θ) = SzA K θ` be Higman's group, `(a,b) * (c,d) = (a+c, b+d+a·θ c)`.  This file proves
that for every automorphism `z` of `A` the induced map on the first coordinate,
`x ↦ (z ⟨x,0⟩).a`, is a semilinear map of the field `K`: there are `λ ∈ Kˣ` and a field
automorphism `σ` of `K` with `(z ⟨x,0⟩).a = λ · σ x` for all `x`.

## Structure of the proof

* The centre of `A` is `{(0,b)}` (`SzA.mem_center_iff`), so `z` preserves it and the quotient
  `A/Z ≅ (K,+)`.  Writing `f = linMap θ z` for the induced map on `A/Z` and `g = cenMap θ z`
  for the induced map on the centre, both are additive bijections of `K` and the image of
  `z(x²) = z(x)²` is the identity

  `g (x · θ x) = f x · θ (f x)`   (`SzAuto.cenMap_mul_theta`).

  (These structural facts about `SzA` are proved in `SzAuto/aut_V_action_scalar.lean`.)

* The field-theoretic core is Peterfalvi I, App. VIII, Prop. 1 (p. 224), available in this
  workspace as `Work.Hering.AppVIII.typeACore`: if `f, g` are additive maps of `K` with
  `g (x · x^(2^s)) = f x · (f x)^(2^s)` for the *same* Frobenius power `s < n` and `f ≢ 0`,
  then `f x = λ · x^(2^i)` for some `λ ≠ 0` and some `i < n`.

* It remains to see that `θ` *is* a Frobenius power: `Aut(GF(2ⁿ))` is cyclic of order `n`,
  generated by the Frobenius (`Work.Hering.AppVIII.frobPowOfFourth`), so `θ = x ↦ x^(2^s)`
  with `s < n` and `n ∤ 4s`.  The hypothesis `Odd (orderOf θ)` is used exactly here: it forces
  `θ ^ 4 ≠ 1` (an odd divisor of `4` is `1`), which is what `frobPowOfFourth` needs.

* Combining, `f x = λ · x^(2^i) = λ · σ x` with `σ = frobeniusEquiv K 2 ^ i`, and `f x` is by
  definition the first coordinate `(z ⟨x,0⟩).a`.
-/

set_option linter.style.haveILetI false

namespace Work.ZassenhausSuzuki.SzAuto

open Work.ZassenhausSuzuki

/-- A non-trivial automorphism of `GF(2ⁿ)` of **odd** order has fourth power `≠ 1`: an odd
divisor of `4` equals `1`, which would make the automorphism trivial.

This is what allows `θ` of odd order to be recognised as a Frobenius power by
`Work.Hering.AppVIII.frobPowOfFourth`. -/
theorem ringAut_pow_four_ne_one {n : ℕ} (θ : GaloisField 2 n ≃+* GaloisField 2 n) (hθ : θ ≠ 1)
    (hodd : Odd (orderOf θ)) : θ ^ 4 ≠ 1 := by
  intro h
  have h4 : orderOf θ ∣ 4 := orderOf_dvd_iff_pow_eq_one.mpr h
  obtain ⟨k, _hk2, hk⟩ :=
    (Nat.dvd_prime_pow Nat.prime_two).mp (show orderOf θ ∣ 2 ^ 2 by simpa using h4)
  -- `orderOf θ` is odd and a power of two, hence `orderOf θ = 1`
  have hmod : 2 ^ k % 2 = 1 := by rw [← hk]; exact Nat.odd_iff.mp hodd
  have hk0 : k = 0 := by
    by_contra hk0
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk0
    simp [pow_succ] at hmod
  rw [hk0, pow_zero] at hk
  exact hθ (orderOf_eq_one_iff.mp hk)

theorem aut_indFst_semilinear {n : ℕ} (θ : GaloisField 2 n ≃+* GaloisField 2 n) (hθ : θ ≠ 1)
    (hodd : Odd (orderOf θ)) (z : MulAut (Work.ZassenhausSuzuki.SzA (GaloisField 2 n) θ)) :
    ∃ lam : (GaloisField 2 n)ˣ, ∃ σ : GaloisField 2 n ≃+* GaloisField 2 n,
      ∀ x : GaloisField 2 n, (z ⟨x, 0⟩).a = (lam : GaloisField 2 n) * σ x := by
  rcases Nat.eq_zero_or_pos n with hn0 | hn
  · -- `GaloisField 2 0` has no non-trivial ring automorphism
    subst hn0
    exact absurd (Work.Hering.AppVIII.galoisFieldZero θ) hθ
  · classical
    have hnne : n ≠ 0 := by omega
    -- `θ` is a Frobenius power `x ↦ x^(2^s)`
    obtain ⟨s, hsn, h4, hφs⟩ :=
      Work.Hering.AppVIII.frobPowOfFourth hnne θ (ringAut_pow_four_ne_one θ hθ hodd)
    have hs0 : s ≠ 0 := by
      rintro rfl
      exact hθ (RingEquiv.ext fun x => by simpa using hφs x)
    letI : Fintype (GaloisField 2 n) := Fintype.ofFinite _
    have hcard : Fintype.card (GaloisField 2 n) = 2 ^ n := by
      rw [Fintype.card_eq_nat_card, GaloisField.card 2 n hnne]
    -- `f = linMap θ z` is not identically zero
    have hfnz : ∃ x, linMap θ z x ≠ 0 := by
      refine ⟨1, fun h => one_ne_zero (linMap_eq_zero (θ := θ) hθ z h)⟩
    -- the key identity `g (x · θ x) = f x · θ (f x)` rewritten with `θ x = x^(2^s)`
    have hid : ∀ x : GaloisField 2 n,
        cenMap θ z (x * x ^ (2 ^ s)) = linMap θ z x * (linMap θ z x) ^ (2 ^ s) := by
      intro x
      rw [← hφs x, ← hφs (linMap θ z x)]
      exact cenMap_mul_theta (θ := θ) hθ z x
    obtain ⟨lam, i, hlam, _hi, hf, _⟩ :=
      Work.Hering.AppVIII.typeACore hcard hsn hs0 h4 (linMap θ z) (cenMap θ z)
        (linMap_add hθ z) (cenMap_add hθ z) hfnz hid
    refine ⟨Units.mk0 lam hlam, (frobeniusEquiv (GaloisField 2 n) 2) ^ i, fun x => ?_⟩
    show (z ⟨x, 0⟩).a =
      (Units.mk0 lam hlam : GaloisField 2 n) * ((frobeniusEquiv (GaloisField 2 n) 2) ^ i) x
    rw [← linMap_apply z x, hf x, Work.Hering.AppVIII.frobeniusEquiv_pow_apply, Units.val_mk0]

end Work.ZassenhausSuzuki.SzAuto
