/-!
# The semilinear map `x ↦ λ·σ(x)` is never a Singer cycle of `GF(2ⁿ)`

Let `F = GF(2ⁿ)`, `λ ∈ Fˣ` and `σ` a nontrivial ring automorphism of `F`.  Consider the
`𝔽₂`-linear map `f : y ↦ λ·σ(y)`.  We show that `f` cannot have order exactly `2ⁿ - 1`:
in fact, writing `σ(x) = x ^ (2^s)` with `0 < s < n` (`ringAut_eq_pow_two_pow`, the description
of `Aut(GF(2ⁿ))` as the cyclic group generated by the Frobenius), the finite field is
`𝔽₂`-linearly generated by the power map, and one computes

`f^[m](y) = λ ^ (∑_{i<m} 2^(s*i)) · y ^ (2^(s*m))`.

For `g = gcd(n, s)` and `m = (n/g)·(2^g - 1)` we have `n ∣ s·m` (so `y^(2^(s*m)) = y`) and
`(2ⁿ - 1) ∣ ∑_{i<m} 2^(s*i)` (so `λ^(∑ …) = 1`), whence `f^[m] = id` with
`0 < m < 2ⁿ - 1`.  This contradicts the second half of the hypothesis, which claims that every
proper positive power of `f` moves some point.
-/

set_option autoImplicit false

namespace Work.ZassenhausSuzuki.SzAuto

/-- **Automorphisms of `GF(2ⁿ)` are powers of the Frobenius.**  Every ring automorphism `φ` of
`GF(2ⁿ)` is the map `x ↦ x ^ (2 ^ s)` for some `0 ≤ s < n`. -/
theorem ringAut_eq_pow_two_pow {n : ℕ} (hn : n ≠ 0)
    (φ : GaloisField 2 n ≃+* GaloisField 2 n) :
    ∃ s : ℕ, s < n ∧ ∀ x, φ x = x ^ (2 ^ s) := by
  have hfix : ∀ c : ZMod 2, φ (algebraMap (ZMod 2) (GaloisField 2 n) c) =
      algebraMap (ZMod 2) (GaloisField 2 n) c :=
    fun c => Work.Hering.AppVIII.ringEquiv_algebraMap_eq φ c
  let φ' : GaloisField 2 n ≃ₐ[ZMod 2] GaloisField 2 n := AlgEquiv.ofRingEquiv hfix
  have hbij := FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) (GaloisField 2 n)
  rw [GaloisField.finrank 2 hn] at hbij
  obtain ⟨k, hk⟩ := hbij.2 φ'
  have hk' : (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n) ^ (k : ℕ)) =
      φ' := hk
  have hfun : ∀ x : GaloisField 2 n, φ x = x ^ (2 ^ (k : ℕ)) := by
    intro x
    have hfrob : ⇑(FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n)) =
        fun y => y ^ 2 := by
      rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ZMod.card]
    calc φ x = φ' x := (AlgEquiv.ofRingEquiv_apply hfix x).symm
      _ = (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) (GaloisField 2 n) ^ (k : ℕ)) x := by
            rw [← hk']
      _ = x ^ (2 ^ (k : ℕ)) := by rw [AlgEquiv.coe_pow, hfrob, pow_iterate]
  exact ⟨k.1, k.2, hfun⟩

theorem not_iterate_eq_of_ringAut_ne_v2 {n : ℕ} (hn : 1 ≤ n) (lam : (GaloisField 2 n)ˣ)
    (σ : GaloisField 2 n ≃+* GaloisField 2 n) (hσ : σ ≠ 1) :
    ¬ (∀ x : GaloisField 2 n, ((fun y => (lam : GaloisField 2 n) * σ y)^[2 ^ n - 1]) x = x ∧
       ∀ m : ℕ, 0 < m → m < 2 ^ n - 1 →
         ∃ x : GaloisField 2 n, ((fun y => (lam : GaloisField 2 n) * σ y)^[m]) x ≠ x) := by
  intro h
  obtain ⟨_hA, hB⟩ := h 0
  have hn' : n ≠ 0 := by omega
  -- describe `σ` as a power of the Frobenius
  obtain ⟨s, hsn, hpow⟩ := ringAut_eq_pow_two_pow hn' σ
  have hs0 : s ≠ 0 := by
    rintro rfl
    apply hσ
    ext x
    simpa using hpow x
  have hs_pos : 0 < s := Nat.pos_of_ne_zero hs0
  have hn2 : 2 ≤ n := by omega
  -- the arithmetic facts attached to `m = (n/g)·(2^g - 1)`, `g = gcd(n,s)`
  obtain ⟨hm_pos, hm_lt, hndvd⟩ := arith_facts n s hs_pos hsn
  obtain hsumdvd := two_pow_sub_one_dvd_sum n s hs_pos hsn
  haveI : Fintype (GaloisField 2 n) := Fintype.ofFinite _
  have hcard : Fintype.card (GaloisField 2 n) = 2 ^ n := by
    rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 2 n hn'
  have hbase : (lam : GaloisField 2 n) ^ (2 ^ n - 1) = 1 := by
    rw [← hcard]
    exact FiniteField.pow_card_sub_one_eq_one (lam : GaloisField 2 n) (Units.ne_zero lam)
  -- `f ^ m = id` for this `m`
  have hmain : ∀ y : GaloisField 2 n,
      ((fun y => (lam : GaloisField 2 n) * σ y)^[(n / n.gcd s) * (2 ^ (n.gcd s) - 1)]) y = y := by
    intro y
    have hf : (fun y : GaloisField 2 n => (lam : GaloisField 2 n) * σ y)
        = (fun y : GaloisField 2 n => (lam : GaloisField 2 n) * y ^ (2 ^ s)) := by
      funext z
      rw [hpow z]
    rw [hf, iterate_powmap s (lam : GaloisField 2 n) ((n / n.gcd s) * (2 ^ (n.gcd s) - 1)) y]
    have hlampow : (lam : GaloisField 2 n) ^
        (Finset.sum (Finset.range ((n / n.gcd s) * (2 ^ (n.gcd s) - 1)))
          (fun i => 2 ^ (s * i))) = 1 := by
      obtain ⟨k, hk⟩ := hsumdvd
      rw [hk, pow_mul, hbase, one_pow]
    have hyyy : y ^ (2 ^ (s * ((n / n.gcd s) * (2 ^ (n.gcd s) - 1)))) = y := by
      obtain ⟨t, ht⟩ := hndvd
      have hfix : y ^ (2 ^ n) = y := Work.Hering.AppVIII.pow_two_pow_card n (by omega) y
      have hiter : ∀ t, y ^ (2 ^ (n * t)) = y := by
        intro t
        induction t with
        | zero => simp
        | succ t ih => rw [Nat.mul_succ, pow_add, pow_mul, ih, hfix]
      rw [ht]
      exact hiter t
    rw [hlampow, hyyy, one_mul]
  -- `f ^ m` moves nothing, contradicting `hB`
  obtain ⟨x, hx⟩ := hB ((n / n.gcd s) * (2 ^ (n.gcd s) - 1)) hm_pos hm_lt
  exact hx (hmain x)

end Work.ZassenhausSuzuki.SzAuto
