variable {G : Type} [Group G] {H Q : Subgroup G} {t : G}

/-!
## Preliminaries for `centralizer_twoPoint_eq`

The geometric half of the argument is in the sibling module
`Work.ZassenhausSuzuki.centralizer_le_normalizer_twoPoint`: a non-identity `k` of the two-point
stabiliser `D = twoPoint H t` normalises `D` exactly because `k` fixes only the two points
`∞ = H` and `t · ∞` of `Ω = G ⧸ H`.  Recorded here is the statement of that fixpoint property
(`fixedPts_zpowers_eq`), together with the arithmetic fact `ne_inv_of_mem_twoPoint` that `k` is
not its own inverse (its order is odd).
-/

/-- **The fixed points of the cyclic subgroup generated by `k`** for `k ∈ D = twoPoint H t`,
`k ≠ 1`: exactly the two points `∞ = H` and `t · ∞` of `Ω = G ⧸ H`.  (`k` fixes both because
`k ∈ H` and `k ∈ Hᵗ`, and a third fixed point would give `k = 1` by the Zassenhaus condition.) -/
lemma fixedPts_zpowers_eq (h : IsSplitRankOne H Q t) (hZ : IsZassenhaus H) {k : G}
    (hk : k ∈ twoPoint H t) (hk1 : k ≠ 1) :
    fixedPts H (Subgroup.zpowers k) = {basePt H, ((t : G) : G ⧸ H)} := by
  have hkD : Subgroup.zpowers k ≤ twoPoint H t := Subgroup.zpowers_le.mpr hk
  have hkH : k ∈ H := (Subgroup.mem_inf.mp hk).1
  have hkt : k • ((t : G) : G ⧸ H) = ((t : G) : G ⧸ H) :=
    ((mem_twoPoint_iff_smul H t k).mp hk).2
  have hne : basePt H ≠ ((t : G) : G ⧸ H) := ((basePt_ne_iff H t).mpr h.not_mem).symm
  ext ω
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Work.ThreePoints.mem_fixedPts]
  constructor
  · intro hω
    by_cases h1 : ω = basePt H
    · exact Or.inl h1
    · by_cases h2 : ω = ((t : G) : G ⧸ H)
      · exact Or.inr h2
      · exact absurd (hZ (basePt H) ((t : G) : G ⧸ H) ω hne (Ne.symm h1) (Ne.symm h2) k
          (smul_basePt_of_mem H hkH) hkt (hω k (Subgroup.mem_zpowers k))) hk1
  · rintro (rfl | rfl)
    · exact fun x hx => smul_basePt_of_mem H (Subgroup.mem_inf.mp (hkD hx)).1
    · exact fun x hx => ((mem_twoPoint_iff_smul H t x).mp (hkD hx)).2

/-- **`k` is not its own inverse.**  `D = twoPoint H t` has odd order, so the order of
`k ∈ D` is odd; an element which is its own inverse has order dividing `2`, hence is `1`. -/
lemma ne_inv_of_mem_twoPoint (h : IsSplitRankOne H Q t) {k : G} (hk : k ∈ twoPoint H t)
    (hk1 : k ≠ 1) : k ≠ k⁻¹ := by
  intro hkk
  have hodd : Odd (Nat.card (twoPoint H t)) := h.stronglyEmbedded.2.2 t h.not_mem
  have hoddk : Odd (orderOf k) := hodd.of_dvd_nat (Subgroup.orderOf_dvd_natCard (twoPoint H t) hk)
  have hdvd : orderOf k ∣ 2 :=
    orderOf_dvd_iff_pow_eq_one.mpr (by rw [pow_two, mul_eq_one_iff_eq_inv.mpr hkk])
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
  · exact hk1 (orderOf_eq_one_iff.mp h1)
  · obtain ⟨m, hm⟩ := hoddk
    omega

/-!
Suzuki 1962, §8, p. 118: a non-identity element `k` of the two-point stabiliser
`D = twoPoint H t = H ⊓ Hᵗ` has `C_G(k) = D`.

Route: `k ∈ D` fixes the two points `H`, `tH` of `Ω = G ⧸ H`, and `D` fixes no others
(`Work.ZassenhausTwoGroup.mem_fixedPts_twoPoint`).  As `IsZassenhaus H` says that a non-identity
element fixes at most two points, `Fix(k) = {H, tH}`; hence every `g ∈ C_G(k)` permutes
`{H, tH}` and therefore normalises the pointwise stabiliser `D` of that pair, so
`C_G(k) ≤ N_G(D) = D ⊔ ⟨t⟩` (`Work.ZassenhausTwoGroup.normalizer_twoPoint`).  If `g = d * t`
(`d ∈ D`) centralised `k`, then `g` conjugates `k` to `k⁻¹` (since `t` inverts the abelian `D`,
`Work.ZassenhausSuzuki.twoPoint_inverted`), so `k = k⁻¹` and `k² = 1`, impossible because `D` has
odd order.  Finally `D ≤ C_G(k)` because `D` is abelian
(`Work.ZassenhausSuzuki.QSZ_isCyclic_twoPoint`).
-/
theorem centralizer_twoPoint_eq {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G}
    (h : Submission.Blueprint.IsSplitRankOne H Q t) (hZ : Submission.Blueprint.IsZassenhaus H)
    (h2 : IsPGroup 2 Q) {k : G} (hk : k ∈ Submission.Blueprint.twoPoint H t) (hk1 : k ≠ 1) :
    Subgroup.centralizer ({k} : Set G) = Submission.Blueprint.twoPoint H t := by
  have hD : twoPoint H t ≠ ⊥ := by
    intro hbot
    rw [hbot] at hk
    exact hk1 (Subgroup.mem_bot.mp hk)
  have hQne : Q ≠ ⊥ := Work.ZassenhausPSL2.Feit.Q_ne_bot_of_split h
  have hab : ∀ x ∈ twoPoint H t, ∀ y ∈ twoPoint H t, x * y = y * x :=
    twoPoint_comm h hZ hQne h2
  refine le_antisymm ?_ ?_
  · -- `C_G(k) ≤ D`
    intro g hg
    have hN := Work.ZassenhausTwoGroup.normalizer_twoPoint h hZ hD
    have htN : t ∈ Subgroup.normalizer (twoPoint H t : Set G) := by
      rw [hN]; exact Subgroup.mem_sup_right (Subgroup.mem_zpowers t)
    have ht2 : t * t = 1 := by rw [← pow_two, ← h.invol]; exact pow_orderOf_eq_one t
    have hgN : g ∈ twoPoint H t ⊔ Subgroup.zpowers t := by
      rw [← hN]
      exact centralizer_le_normalizer_twoPoint h hZ hk hk1 hg
    rcases mem_sup_zpowers (twoPoint H t) htN ht2 g hgN with hgD | hgt
    · exact hgD
    · -- `g = d * t` with `d = g * t ∈ D` centralises `k`, hence conjugates `k` to `k⁻¹`,
      -- forcing `k = k⁻¹`, which is impossible because `D` has odd order.
      exfalso
      obtain ⟨d, hd, hg_eq⟩ : ∃ d ∈ twoPoint H t, g = d * t :=
        ⟨g * t, hgt, by rw [mul_assoc, ht2, mul_one]⟩
      have hinv : t * k * t⁻¹ = k⁻¹ := twoPoint_inverted_of_zass h hZ k hk
      have hgk : g * k = k * g :=
        (Subgroup.mem_centralizer_iff.mp hg k (Set.mem_singleton k)).symm
      have h1 : g * k * g⁻¹ = k := by rw [hgk, mul_assoc, mul_inv_cancel, mul_one]
      have h2 : g * k * g⁻¹ = k⁻¹ := by
        have hdk : d * k = k * d := hab d hd k hk
        have hdk' : d * k * d⁻¹ = k := by rw [hdk, mul_assoc, mul_inv_cancel, mul_one]
        rw [hg_eq]
        calc (d * t) * k * (d * t)⁻¹ = d * (t * k * t⁻¹) * d⁻¹ := by group
          _ = d * k⁻¹ * d⁻¹ := by rw [hinv]
          _ = k⁻¹ := by
                calc d * k⁻¹ * d⁻¹ = (d * k * d⁻¹)⁻¹ := by group
                  _ = k⁻¹ := by rw [hdk']
      exact ne_inv_of_mem_twoPoint h hk hk1 (h1.symm.trans h2)
  · -- `D ≤ C_G(k)`
    intro d hd
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact hab k hk d hd

end Work.ZassenhausSuzuki
