import Submission.Work.ZassenhausSuzuki.Recognition
import Submission.Work.ZassenhausSuzuki.Tits
import Submission.Work.ZassenhausSuzuki.isTitsTheta_eq_titsTheta

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# Area `ZassenhausSuzuki`: the model half of the recognition

`SzModelDatumProp` (Recognition.lean) is reduced here to two inputs, following the lead's
design note `NOTES_LEAD_probe1945.md`:

* `TitsThetaUniqueProp` (D1) — on `GF(2^(2n+1))` the Tits endomorphism is *unique*: the Galois
  group is cyclic of order `2n+1` generated by Frobenius, `θ = Frob^k` with `2k ≡ 1 (mod 2n+1)`
  forces `k = n+1`, i.e. `θ = titsTheta n`.
* `SzModelDatumTitsProp` (D2) — the model datum of the literal model `SzModel n` at the
  canonical Tits endomorphism (`szModelDatum_titsTheta` in the design file): the Borel
  `szBorelS n`, the root group `szTwoGroupS n` and the Weyl element `szWgM n` of the ported
  Models library, coordinated by `A(GF(2^(2n+1)), titsTheta n)` with `f = τ`.

`szModelDatumProp_of` assembles them.  The type-level subtlety (the lead's note §2):
`SzModel ((m-1)/2)` lives over `GaloisField 2 (2·((m-1)/2)+1)`, which is not *definitionally*
`GaloisField 2 m`, so the general case is reached by `subst` on `2 * ((m-1)/2) + 1 = m`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open LeanEval.GroupTheory.Defs
open Submission.Blueprint
open Work.RankOneUniqueness

namespace Work.ZassenhausSuzuki

/-- **D1.**  Uniqueness of the Tits endomorphism of `GF(2^(2n+1))`. -/
def TitsThetaUniqueProp : Prop :=
  ∀ (n : ℕ) {θ : GaloisField 2 (2 * n + 1) ≃+* GaloisField 2 (2 * n + 1)},
    IsTitsTheta θ → θ = titsTheta n

/-- **D2.**  The model datum of `SzModel n` at the canonical Tits endomorphism
(`szModelDatum_titsTheta` of the lead's note). -/
def SzModelDatumTitsProp : Prop :=
  ∀ (n : ℕ), 1 ≤ n →
    Nonempty (ModelRankOneDatum (SzModel n)
      (SzA (GaloisField 2 (2 * n + 1)) (titsTheta n)) (SzA.sigma (titsTheta n)))

/-- **D1 is a theorem** (`isTitsTheta_eq_titsTheta`): the Tits endomorphism of
`GF(2^(2n+1))` is unique. -/
theorem titsThetaUniqueProp : TitsThetaUniqueProp :=
  fun n (θ : GaloisField 2 (2 * n + 1) ≃+* GaloisField 2 (2 * n + 1)) hθ =>
    isTitsTheta_eq_titsTheta n hθ

/-- **D2′.**  Transport of the model datum to `GF(2^m)` with `m = 2k+1`. -/
theorem szModelDatum_of_eq (h1 : TitsThetaUniqueProp) (h2 : SzModelDatumTitsProp)
    {k m : ℕ} (h : 2 * k + 1 = m) (hk : 1 ≤ k)
    (θ : GaloisField 2 m ≃+* GaloisField 2 m) (hθ : IsTitsTheta θ) :
    Nonempty (ModelRankOneDatum (SzModel k) (SzA (GaloisField 2 m) θ) (SzA.sigma θ)) := by
  subst h
  obtain rfl := h1 k hθ
  exact h2 k hk

/-- **D3.**  The model half of the Suzuki recognition, from D1 and D2. -/
theorem szModelDatumProp_of (h1 : TitsThetaUniqueProp) (h2 : SzModelDatumTitsProp) :
    SzModelDatumProp := by
  intro m hm hm3 θ hθ
  exact szModelDatum_of_eq h1 h2 (k := (m - 1) / 2) (by obtain ⟨n, rfl⟩ := hm; omega)
    (by omega) θ hθ

end Work.ZassenhausSuzuki
