/-!
# Semilinear classification of additive maps intertwining the anisotropic form `x ↦ x·θx`

This file proves `Work.ZassenhausSuzuki.szAut_semilinear_ph_zs`, the Hua-subgroup step of
Suzuki 1962, Lemma 6 (= BG 5.4): if `φ, ψ` are injective additive maps of `K = GF(2ⁿ)` with

  `ψ (x · θ x) = φ x · θ (φ x)`   for all `x`,

then `φ` is semilinear, `φ x = λ · σ x` for some `λ ∈ Kˣ` and `σ ∈ Aut(K)`.

## Proof

* `Aut(GF(2ⁿ))` is cyclic of order `n`, generated by the Frobenius `x ↦ x ^ 2`
  (`Work.Hering.AppVIII.frobPowOfFourth`).  Since `θ ≠ 1` has *odd* order, `θ ^ 4 ≠ 1`
  (an odd divisor of `4` is `1`), hence `θ = (x ↦ x ^ (2 ^ s))` for some `s < n` with
  `n ∤ 4 s`, and `s ≠ 0` because `θ ≠ 1`.
* With `θ x = x ^ (2 ^ s)` the hypothesis becomes exactly
  `ψ (x · x ^ (2 ^ s)) = φ x · (φ x) ^ (2 ^ s)`, and `φ ≢ 0` because it is injective.
* Peterfalvi I, App. VIII, Prop. 1, formalised in this workspace as
  `Work.Hering.AppVIII.typeACore`, then gives `φ x = λ · x ^ (2 ^ i)` with `λ ≠ 0`, `i < n`.
* Taking `σ = frobeniusEquiv K 2 ^ i` and `λ` as a unit yields the claim.

The placeholder `Work.ZassenhausSuzuki.SzAuto.szAut_semilinear_ph` (a `unproved`) is not used;
neither is anything else that depends on it.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.ZassenhausSuzuki

/-- A non-trivial automorphism of `GF(2ⁿ)` of **odd** order has fourth power `≠ 1`: an odd
divisor of `4` equals `1`, which would make the automorphism trivial.  This is what allows
`θ` of odd order to be recognised as a Frobenius power by
`Work.Hering.AppVIII.frobPowOfFourth`. -/
theorem ringAut_pow_four_ne_one_zs {n : ℕ} (θ : GaloisField 2 n ≃+* GaloisField 2 n)
    (hθ : θ ≠ 1) (hodd : Odd (orderOf θ)) : θ ^ 4 ≠ 1 := by
  intro h
  have h4 : orderOf θ ∣ 4 := orderOf_dvd_iff_pow_eq_one.mpr h
  obtain ⟨k, _hk2, hk⟩ :=
    (Nat.dvd_prime_pow Nat.prime_two).mp (show orderOf θ ∣ 2 ^ 2 by simpa using h4)
  have hmod : 2 ^ k % 2 = 1 := by rw [← hk]; exact Nat.odd_iff.mp hodd
  have hk0 : k = 0 := by
    by_contra hk0
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk0
    simp [pow_succ] at hmod
  rw [hk0, pow_zero] at hk
  exact hθ (orderOf_eq_one_iff.mp hk)

/-- **Semilinear classification** (replacement for the placeholder
`Work.ZassenhausSuzuki.SzAuto.szAut_semilinear_ph` in `SzAuto/aut_V_action_scalar.lean`; the
Hua-subgroup step of Suzuki 1962 Lemma 6 / BG 5.4): if `φ, ψ : GF(2ⁿ) → GF(2ⁿ)` are injective
additive maps with `ψ (x·θx) = φ x · θ(φ x)` for all `x`, then `φ` is semilinear:
`φ x = λ·σ x` for a unit `λ` and a ring automorphism `σ` (the anisotropic form `x ↦ x·θx` is the
only input).  Provers: the corresponding placeholder in `SzAuto/aut_V_action_scalar.lean` must NOT
be cited (it is a `unproved`); check `#print axioms` of your lemma. -/
theorem szAut_semilinear_ph_zs {n : ℕ} (hn : 1 ≤ n) (θ : GaloisField 2 n ≃+* GaloisField 2 n)
    (hθ : θ ≠ 1) (hodd : Odd (orderOf θ)) (φ ψ : GaloisField 2 n → GaloisField 2 n)
    (hφadd : ∀ x y, φ (x + y) = φ x + φ y) (hφinj : Function.Injective φ)
    (hψadd : ∀ x y, ψ (x + y) = ψ x + ψ y) (hψinj : Function.Injective ψ)
    (hS : ∀ x, ψ (x * θ x) = φ x * θ (φ x)) :
    ∃ lam : (GaloisField 2 n)ˣ, ∃ σ : GaloisField 2 n ≃+* GaloisField 2 n,
      ∀ x, φ x = (lam : GaloisField 2 n) * σ x := by
  classical
  have hnne : n ≠ 0 := by omega
  -- `θ` is a power of the Frobenius: `θ x = x ^ (2 ^ s)` with `s < n` and `n ∤ 4 s`.
  obtain ⟨s, hsn, h4, hθs⟩ :=
    Work.Hering.AppVIII.frobPowOfFourth hnne θ (ringAut_pow_four_ne_one_zs θ hθ hodd)
  -- `θ ≠ 1` forces `s ≠ 0`.
  have hs0 : s ≠ 0 := by
    rintro rfl
    exact hθ (RingEquiv.ext fun x => by simpa using hθs x)
  letI : Fintype (GaloisField 2 n) := Fintype.ofFinite _
  have hcard : Fintype.card (GaloisField 2 n) = 2 ^ n := by
    rw [Fintype.card_eq_nat_card, GaloisField.card 2 n hnne]
  -- `φ` is not the zero map, being injective.
  have hφ0 : φ 0 = 0 := by
    have h := hφadd 0 0
    rw [add_zero] at h
    exact h.trans (CharTwo.add_self_eq_zero (φ 0))
  have hfnz : ∃ x, φ x ≠ 0 :=
    ⟨1, fun h => one_ne_zero (hφinj (h.trans hφ0.symm))⟩
  -- the hypothesis of `typeACore`
  have hid : ∀ x, ψ (x * x ^ (2 ^ s)) = φ x * (φ x) ^ (2 ^ s) := by
    intro x
    rw [← hθs x, ← hθs (φ x)]
    exact hS x
  obtain ⟨lam, i, hlam, _hi, hf, _⟩ :=
    Work.Hering.AppVIII.typeACore hcard hsn hs0 h4 φ ψ hφadd hψadd hfnz hid
  exact ⟨Units.mk0 lam hlam, (frobeniusEquiv (GaloisField 2 n) 2) ^ i, fun x => by
    rw [hf x, Work.Hering.AppVIII.frobeniusEquiv_pow_apply, Units.val_mk0]⟩

end Work.ZassenhausSuzuki
