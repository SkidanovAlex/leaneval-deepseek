/-!
# A nontrivial ring automorphism of `GF(2^m)` of odd order forces `3 ≤ m`

Let `θ` be a ring automorphism of the finite field `K = GF(2^m)` (`m ≥ 1`) that is
not the identity and whose order is odd.  Then `3 ≤ m`.

Math.  `K` is a Galois extension of its prime field `𝔽₂ = ZMod 2` with cyclic Galois
group generated by the Frobenius `φ : x ↦ x²`; the group has order `m` (the
`𝔽₂`-dimension of `K`), so the map `i ↦ φ^i` is a bijection `Fin m → Gal(K/𝔽₂)`.
Every ring automorphism of `K` fixes the prime field, hence is such a `φ^i`; in
particular `orderOf θ = orderOf (φ^i)` divides `orderOf φ = m`.  If additionally
`orderOf θ` is odd then it is odd and `≠ 1`, hence `≥ 3`; since it divides `m` we get
`3 ≤ m`.

The cases `m = 1` and `m = 2` are the two excluded ones: for `m = 1` the only ring
automorphism is the identity, and for `m = 2` the only nontrivial one has order `2`.
-/

set_option linter.style.haveILetI false

namespace Work.ZassenhausSuzuki

theorem three_le_of_odd_ringAut {m : ℕ} (hm : 1 ≤ m)
    (θ : GaloisField 2 m ≃+* GaloisField 2 m)
    (hθ : θ ≠ 1) (hodd : Odd (orderOf θ)) : 3 ≤ m := by
  let K := GaloisField 2 m
  haveI : Fintype K := Fintype.ofFinite K
  -- Every ring automorphism of `K` fixes the prime field `ZMod 2`.
  have hfixθ : ∀ x : ZMod 2, θ (algebraMap (ZMod 2) K x) = algebraMap (ZMod 2) K x := by
    intro x
    have hx : ((x.val : ℕ) : ZMod 2) = x := ZMod.natCast_zmod_val x
    rw [← hx, map_natCast (algebraMap (ZMod 2) K) x.val]
    exact map_natCast θ x.val
  -- Regard `θ` as an algebra automorphism `Θ` of `K` over `ZMod 2`.
  let Θ : K ≃ₐ[ZMod 2] K := AlgEquiv.ofRingEquiv (f := θ) hfixθ
  have hcoe : (Θ : K ≃+* K) = θ := rfl
  -- The "forget to ring equivalence" map is an injective monoid hom, so it preserves orders.
  let ψ : (K ≃ₐ[ZMod 2] K) →* (K ≃+* K) :=
    { toFun := fun e => (e : K ≃+* K)
      map_one' := rfl
      map_mul' := fun f g => by ext x; rfl }
  have horder : orderOf θ = orderOf Θ := by
    have hinj : Function.Injective ψ := fun a b h => AlgEquiv.coe_ringEquiv_injective h
    have := orderOf_injective ψ hinj Θ
    rwa [show ψ Θ = θ from hcoe] at this
  -- The Frobenius generates the cyclic Galois group of order `m`.
  let F : K ≃ₐ[ZMod 2] K := FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) K
  have hfr : Module.finrank (ZMod 2) K = m := GaloisField.finrank 2 (by omega)
  have hForder : orderOf F = m := by
    rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, hfr]
  -- So `Θ` is a power of the Frobenius, whence `orderOf Θ` divides `orderOf F = m`.
  obtain ⟨i, hi⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) K).2 Θ
  have hi' : F ^ (i : ℕ) = Θ := by simpa using hi
  have hdvd : orderOf θ ∣ m := by
    rw [horder]
    have hdvd0 : orderOf Θ ∣ orderOf F := by
      rw [← hi']
      exact orderOf_pow_dvd (x := F) i.1
    rw [hForder] at hdvd0
    exact hdvd0
  -- An odd order different from `1` is at least `3`.
  have hne1 : orderOf θ ≠ 1 := by
    intro h
    exact hθ (orderOf_eq_one_iff.mp h)
  have hge3 : 3 ≤ orderOf θ := by
    obtain ⟨k, hk⟩ := hodd
    omega
  calc 3 ≤ orderOf θ := hge3
    _ ≤ m := Nat.le_of_dvd (by omega) hdvd

end Work.ZassenhausSuzuki
