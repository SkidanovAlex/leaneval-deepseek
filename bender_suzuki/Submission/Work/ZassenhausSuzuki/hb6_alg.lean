import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.ZassenhausSuzuki

/-- Pure group-theoretic algebra lemma for the Bender–Suzuki argument.

In a group generated by elements `t, ρ, h, k` subject to
`t² = 1`, `t ρ² t = ρ t ρ⁻¹`, `(ρ²)² = 1`, `t h t = h⁻¹`, `t k t = k⁻¹` and
`k⁻¹ ρ² k = h⁻¹ (h⁻¹ ρ² h ρ²) h`, the displayed identity between words in
`t, ρ, h, k` holds.

The proof shows that both sides equal `(t ρ t)⁻¹ h (t ρ t) h⁻¹`:
the left hand side is `t (ρ⁻¹ h⁻¹ ρ h) t` and application of `t`-conjugation
(the involutive automorphism `MulAut.conj t`, which inverts `h` and `k` and
sends `ρ` to `t ρ t`) turns it into `(t ρ t)⁻¹ h (t ρ t) h⁻¹`; the right hand
side reduces, using `k t k = t`, `ρ t ρ⁻¹ = (t ρ t)²` and the relation
expressing `k q k⁻¹` for `q = (t ρ t)²`, to the same expression. -/
theorem hb6_alg {M : Type*} [Group M] (t ρ h k : M)
    (ht : t * t = 1)
    (hstruct : t * (ρ * ρ) * t = ρ * t * ρ⁻¹)
    (hj2 : (ρ * ρ) * (ρ * ρ) = 1)
    (hh : t * h * t = h⁻¹)
    (hk : t * k * t = k⁻¹)
    (hjk : k⁻¹ * (ρ * ρ) * k = h⁻¹ * (h⁻¹ * (ρ * ρ) * h * (ρ * ρ)) * h) :
    t * (ρ⁻¹ * h⁻¹ * ρ * h) * t =
      (ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * k⁻¹ * (h * h)) * ((h⁻¹ * h⁻¹) * (k * k)) * t
        * (k * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹) := by
  -- `hj2` is not needed for this computation, but we keep it in scope.
  have _hj2 : (ρ * ρ) * (ρ * ρ) = 1 := hj2
  have htinv : t⁻¹ = t := inv_eq_of_mul_eq_one_right ht
  -- `t` acts as the involutive automorphism `MulAut.conj t` on the group.
  have hφ : ∀ x : M, MulAut.conj t x = t * x * t := fun x => by
    rw [MulAut.conj_apply, htinv]
  have hφh : MulAut.conj t h = h⁻¹ := by rw [hφ]; exact hh
  have hhinv : t * h⁻¹ * t = h := by rw [← hφ (h⁻¹), map_inv, hφh, inv_inv]
  -- conjugation by `t` distributes over products
  have conj_mul : ∀ x y : M, t * (x * y) * t = (t * x * t) * (t * y * t) := by
    intro x y
    rw [← hφ (x * y), map_mul]
    simp only [hφ]
  have hρinv : t * ρ⁻¹ * t = (t * ρ * t)⁻¹ := by
    rw [← hφ (ρ⁻¹), map_inv, hφ]
  -- `(t ρ t)² = t ρ² t`
  have hq2 : (t * ρ * t) * (t * ρ * t) = t * (ρ * ρ) * t := by
    rw [← hφ (ρ * ρ), map_mul]
    simp only [hφ]
  -- from `t k t = k⁻¹` we get `k t k = t`
  have hktk : k * t * k = t := by
    have h1 : (k * t * k) * t = 1 := by
      rw [show (k * t * k) * t = k * (t * k * t) by group, hk, mul_inv_cancel]
    rw [eq_inv_of_mul_eq_one_left h1, htinv]
  have hkt : k * t = t * k⁻¹ := by
    apply mul_left_cancel (a := t)
    rw [← mul_assoc, hk, ← mul_assoc, ht, one_mul]
  -- `k` conjugated by `t` on `(t ρ t)²`
  have hmid : k * ((t * ρ * t) * (t * ρ * t)) * k⁻¹ = t * (k⁻¹ * (ρ * ρ) * k) * t := by
    rw [hq2]
    rw [show k * (t * (ρ * ρ) * t) * k⁻¹ = (k * t) * (ρ * ρ) * (t * k⁻¹) by group]
    rw [show t * (k⁻¹ * (ρ * ρ) * k) * t = (t * k⁻¹) * (ρ * ρ) * (k * t) by group]
    rw [hkt]
  -- the key consequence of `hjk`: conjugating `(t ρ t)²` by `k`
  have key : k * ((t * ρ * t) * (t * ρ * t)) * k⁻¹
      = (h * h) * ((t * ρ * t) * (t * ρ * t)) * h⁻¹
        * ((t * ρ * t) * (t * ρ * t)) * h⁻¹ := by
    rw [hmid, hjk]
    simp only [conj_mul, hhinv, hh]
    group
  have hρtρ : ρ * t * ρ⁻¹ = (t * ρ * t) * (t * ρ * t) := by rw [← hstruct, hq2]
  have hCρ : ρ⁻¹ * ((t * ρ * t) * (t * ρ * t)) * ρ = t := by
    rw [hq2, hstruct]; group
  have hlhs : t * (ρ⁻¹ * h⁻¹ * ρ * h) * t = (t * ρ * t)⁻¹ * h * (t * ρ * t) * h⁻¹ := by
    simp only [conj_mul, hρinv, hhinv, hh]
  have hrhs : (ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * k⁻¹ * (h * h)) * ((h⁻¹ * h⁻¹) * (k * k)) * t
        * (k * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹) = (t * ρ * t)⁻¹ * h * (t * ρ * t) * h⁻¹ := by
    calc (ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * k⁻¹ * (h * h)) * ((h⁻¹ * h⁻¹) * (k * k)) * t
          * (k * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹)
        = ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * k * t * k * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹ := by group
      _ = ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * t * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹ := by
            rw [show ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * k * t * k * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹
                  = ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ρ * (k * t * k) * ρ⁻¹ * k⁻¹ * h * ρ * h⁻¹
                  by group,
              hktk]
      _ = ρ⁻¹ * (h⁻¹ * h⁻¹) * k * (ρ * t * ρ⁻¹) * k⁻¹ * h * ρ * h⁻¹ := by group
      _ = ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ((t * ρ * t) * (t * ρ * t)) * k⁻¹ * h * ρ * h⁻¹ := by
            rw [hρtρ]
      _ = ρ⁻¹ * (h⁻¹ * h⁻¹)
            * ((h * h) * ((t * ρ * t) * (t * ρ * t)) * h⁻¹
                * ((t * ρ * t) * (t * ρ * t)) * h⁻¹) * h * ρ * h⁻¹ := by
            rw [show ρ⁻¹ * (h⁻¹ * h⁻¹) * k * ((t * ρ * t) * (t * ρ * t)) * k⁻¹ * h * ρ * h⁻¹
                  = ρ⁻¹ * (h⁻¹ * h⁻¹) * (k * ((t * ρ * t) * (t * ρ * t)) * k⁻¹)
                    * h * ρ * h⁻¹
                  by group,
              key]
      _ = ρ⁻¹ * ((t * ρ * t) * (t * ρ * t)) * h⁻¹
            * ((t * ρ * t) * (t * ρ * t)) * ρ * h⁻¹ := by group
      _ = (ρ⁻¹ * ((t * ρ * t) * (t * ρ * t)) * ρ) * (ρ⁻¹ * h⁻¹ * ρ)
            * (ρ⁻¹ * ((t * ρ * t) * (t * ρ * t)) * ρ) * h⁻¹ := by group
      _ = t * (ρ⁻¹ * h⁻¹ * ρ) * t * h⁻¹ := by rw [hCρ]
      _ = (t * ρ * t)⁻¹ * h * (t * ρ * t) * h⁻¹ := by
            simp only [conj_mul, hρinv, hhinv]
  rw [hlhs, hrhs]

end Work.ZassenhausSuzuki
