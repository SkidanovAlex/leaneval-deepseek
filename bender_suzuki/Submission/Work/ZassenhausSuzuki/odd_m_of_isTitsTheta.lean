import Mathlib
import Submission.Work.ZassenhausSuzuki.CoreV2

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# The field degree `m` of a Tits endomorphism of `GF(2^m)` is odd

Let `θ : GF(2^m) ≃+* GF(2^m)` be a **Tits endomorphism** (`Work.ZassenhausSuzuki.IsTitsTheta`),
i.e. `θ²` is the Frobenius (squaring) map `φ : x ↦ x²`.  Then `m` is odd.

Math.  `GF(2^m)` is a Galois extension of its prime field `ZMod 2` with cyclic Galois group
generated by the Frobenius `φ`; its order is `m` (the `ZMod 2`-dimension).  Every ring
automorphism of `GF(2^m)` fixes `ZMod 2`, hence lies in the Galois group, so `θ = φ^i` for a
unique `i : Fin m`.  Applying the relation `θ ∘ θ = φ` gives
`φ^(2i) = φ^1`, i.e. `2i ≡ 1 (mod m)`.  In `ZMod m` this exhibits `2` as a unit
(`2 · i = 1`), so `2` is coprime to `m`, i.e. `m` is odd.

The case `m = 0`.  `GaloisField 2 0` is the splitting field of the *zero* polynomial, which is
`ZMod 2` up to isomorphism; a two-element field has only the trivial ring automorphism, so
`hθ.1` (`θ ≠ 1`) is already contradictory.  (Here the extra hypothesis `Odd (orderOf θ)` is not
needed — it is simply part of the requested statement.)
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open Polynomial

namespace Work.ZassenhausSuzuki

open LeanEval.GroupTheory.Defs

/-- `GaloisField 2 0` is (isomorphic to) `ZMod 2`, hence has two elements. -/
theorem card_galoisField_two_zero : Nat.card (GaloisField 2 0) = 2 := by
  haveI : Fintype (GaloisField 2 0) := Fintype.ofFinite _
  haveI : Polynomial.IsSplittingField (ZMod 2) (ZMod 2)
      (X ^ 2 ^ 0 - X : (ZMod 2)[X]) :=
    { splits' := by simp
      adjoin_rootSet' := by simp [Polynomial.rootSet] }
  have e : ZMod 2 ≃ₐ[ZMod 2] GaloisField 2 0 :=
    Polynomial.IsSplittingField.algEquiv (ZMod 2) (X ^ 2 ^ 0 - X : (ZMod 2)[X])
  have h : Nat.card (GaloisField 2 0) = Nat.card (ZMod 2) := Nat.card_congr e.toEquiv.symm
  rw [show Nat.card (ZMod 2) = 2 by rw [Nat.card_eq_fintype_card, ZMod.card]] at h
  exact h

theorem odd_m_of_isTitsTheta {m : ℕ} {θ : GaloisField 2 m ≃+* GaloisField 2 m}
    (hθ : Work.ZassenhausSuzuki.IsTitsTheta θ) (hodd : Odd (orderOf θ)) : Odd m := by
  by_cases hm : m = 0
  · -- `m = 0`: `GF(2^0) ≅ ZMod 2`, whose only ring automorphism is the identity.
    subst hm
    classical
    haveI : Fintype (GaloisField 2 0) := Fintype.ofFinite _
    have hcard : Fintype.card (GaloisField 2 0) = 2 := by
      rw [← Nat.card_eq_fintype_card]
      exact card_galoisField_two_zero
    have h01 : ∀ x : GaloisField 2 0, x = 0 ∨ x = 1 := by
      intro x
      have hmem : x ∈ ({0, 1} : Finset (GaloisField 2 0)) := by
        have hc : ({0, 1} : Finset (GaloisField 2 0)).card =
            Fintype.card (GaloisField 2 0) := by
          rw [hcard, Finset.card_insert_of_notMem (by simp), Finset.card_singleton]
        rw [Finset.eq_univ_of_card _ hc]
        exact Finset.mem_univ x
      simpa using hmem
    have hone : θ = 1 := by
      ext x
      rcases h01 x with hx | hx <;> rw [hx] <;> simp
    exact absurd hone hθ.1
  · -- `m ≠ 0`: write `θ = φ^i` in the cyclic Galois group and read off `2i ≡ 1 (mod m)`.
    let K := GaloisField 2 m
    haveI : Fintype K := Fintype.ofFinite K
    -- every ring automorphism of `GF(2^m)` fixes the prime field `ZMod 2`
    have hfixθ : ∀ x : ZMod 2, θ (algebraMap (ZMod 2) K x) = algebraMap (ZMod 2) K x := by
      intro x
      have hx : ((x.val : ℕ) : ZMod 2) = x := ZMod.natCast_zmod_val x
      rw [← hx, map_natCast (algebraMap (ZMod 2) K) x.val]
      exact map_natCast θ x.val
    let Θ : K ≃ₐ[ZMod 2] K := AlgEquiv.ofRingEquiv (f := θ) hfixθ
    let F : K ≃ₐ[ZMod 2] K := FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) K
    have hfr : Module.finrank (ZMod 2) K = m := GaloisField.finrank 2 hm
    have hForder : orderOf F = m := by
      rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, hfr]
    -- the Galois group is cyclic, generated by the Frobenius `F`
    obtain ⟨i, hi₀⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) K).2 Θ
    have hi : F ^ (i : ℕ) = Θ := hi₀
    have hΘapp : ∀ x, Θ x = θ x := fun x => AlgEquiv.ofRingEquiv_apply hfixθ x
    have hFapp : ∀ x, F x = x ^ 2 := by
      intro x
      have h1 : F x = x ^ Fintype.card (ZMod 2) :=
        congr_fun (FiniteField.coe_frobeniusAlgEquivOfAlgebraic (ZMod 2) K) x
      rw [ZMod.card] at h1
      exact h1
    -- `θ ∘ θ` is the Frobenius
    have hsq : Θ * Θ = F := by
      apply AlgEquiv.ext
      intro x
      rw [AlgEquiv.mul_apply]
      show θ (θ x) = F x
      rw [hθ.2 x, hFapp x]
    have hpow : F ^ (2 * i.1) = F ^ 1 := by
      rw [show 2 * i.1 = i.1 * 2 by ring, pow_mul, hi, pow_two, hsq, pow_one]
    have hmod : 2 * i.1 ≡ 1 [MOD orderOf F] := (pow_eq_pow_iff_modEq (x := F)).mp hpow
    have hmod' : 2 * i.1 ≡ 1 [MOD m] := by simpa [hForder] using hmod
    -- `2` is a unit in `ZMod m`, so `m` is odd
    have h2eq : (2 : ZMod m) * (i.1 : ZMod m) = 1 := by
      have h := (ZMod.natCast_eq_natCast_iff (2 * i.1) 1 m).mpr hmod'
      simpa using h
    have hunit : IsUnit (2 : ZMod m) :=
      isUnit_iff_exists.mpr ⟨_, h2eq, by rw [mul_comm]; exact h2eq⟩
    exact Nat.coprime_two_left.mp ((ZMod.isUnit_iff_coprime 2 m).mp hunit)

end Work.ZassenhausSuzuki
