/-!
# `Work.ZassenhausSuzuki.Shadow.ChV12.X5_eq_sup_conj_Q0sub` — `X = ⟨Q₀, tQ₀t⟩`

Let `(H,Q,t,s)` satisfy `Work.ZassenhausSuzuki.SzHyp` and put `A = Q₀sub H`, `R = A ⊔ conj t A`.  The theorem of this
file is

  `X5 H t = A ⊔ conj t A`   (i.e. `⟨Q₀, K, t⟩ = ⟨Q₀, t⟩`),

the fact that the Bruhat group `X = ⟨Q₀, K, t⟩` of Peterfalvi II Ch. V §2 Lemma 5 is generated by
`Q₀` together with the involution `t` alone: the generator `K = J(D,t)` is redundant.  (The
source reads this off from `X ≅ PSL(2,q)`; the point of the proof below is that it is
*elementary*, i.e. needs neither the recursion `(B1)` nor `ChIIFourProp`.)

## The proof

Everything rests on the computation of the source's first step (`t_conj_sq` below): for
`k ∈ K = J(D,t)` one has `t (k⁻¹ s k) t = (k s k⁻¹)(k² t)(k s k⁻¹)`, which uses only
`t k t = k⁻¹`, `t s t = s t s` (i.e. `o(st) = 3`), and the `H`-invariance of `Q₀`.

Since `k s k⁻¹, k⁻¹ s k ∈ Q₀sub H` lie in `R` and `t (k⁻¹ s k) t ∈ conj t (Q₀sub H) ⊆ R`, that
identity gives `k² t ∈ R` for every `k ∈ K`.  Taking `k = 1` gives `t ∈ R`; then `k² ∈ R`, and
since `k` has odd order (`K ⊆ D`, of odd order), `k ∈ ⟨k²⟩ ⊆ R`.  So `K ⊆ R`, and with `Q₀ ⊆ R`
and `t ∈ R` this yields `X5 H t = ⟨Q₀ ∪ Kset ∪ {t}⟩ ≤ R`.  The reverse inclusion is immediate
from `t ∈ X5`.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option linter.unusedVariables false

namespace Work.ZassenhausSuzuki.Shadow.ChV12
open Work.ThmF.ChV12
variable {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s : G}

open Submission.Blueprint (twoPoint)

/-- **The key relation of Lemma 5.**  For `k ∈ K = J(D,t)`,
`t (k⁻¹ s k) t = (k s k⁻¹) (k² t) (k s k⁻¹)`.

This is the source's `t s^k t = k t s t k^{-1} = k s k^{-1} · k² t · k s k^{-1}`; it uses
`t k t = k⁻¹` (the defining property of `K`) and `t s t = s t s` (equivalently `o(st) = 3`). -/
theorem t_conj_sq (h : Work.ZassenhausSuzuki.SzHyp H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Kset H t) :
    t * (k⁻¹ * s * k) * t = (k * s * k⁻¹) * (k ^ 2 * t) * (k * s * k⁻¹) := by
  obtain ⟨-, hkinv⟩ := Work.ThmF.mem_Kset_iff.mp hk
  have ht2 : t * t = 1 := Work.ZassenhausSuzuki.Shadow.L5.ht_mul_self h
  have hti : t⁻¹ = t := Work.ZassenhausSuzuki.Shadow.L5.ht_inv h
  have hts : t * s * t = s * t * s := Work.ZassenhausSuzuki.SzHyp.tst_eq_sts h
  have htk : t * k * t = k⁻¹ := by
    have h' := hkinv
    rwa [hti] at h'
  have htik : t * k⁻¹ * t = k := by
    rw [Work.ZassenhausSuzuki.Shadow.L5.conj_inv h k, htk, inv_inv]
  have hkt : k * t = t * k⁻¹ := by
    calc k * t = (t * k⁻¹ * t) * t := by rw [htik]
      _ = t * k⁻¹ * (t * t) := by group
      _ = t * k⁻¹ := by rw [ht2, mul_one]
  have hktk : k * t * k = t := by
    rw [hkt, mul_assoc, inv_mul_cancel, mul_one]
  have hL : t * (k⁻¹ * s * k) * t = k * s * t * s * k⁻¹ := by
    calc t * (k⁻¹ * s * k) * t
        = t * k⁻¹ * s * k * t := by group
      _ = t * k⁻¹ * (t * t) * s * (t * t) * k * t := by rw [ht2]; group
      _ = (t * k⁻¹ * t) * (t * s * t) * (t * k * t) := by group
      _ = k * (s * t * s) * k⁻¹ := by rw [htik, hts, htk]
      _ = k * s * t * s * k⁻¹ := by group
  have hR : (k * s * k⁻¹) * (k ^ 2 * t) * (k * s * k⁻¹) = k * s * t * s * k⁻¹ := by
    calc (k * s * k⁻¹) * (k ^ 2 * t) * (k * s * k⁻¹)
        = k * s * (k⁻¹ * k ^ 2) * t * k * s * k⁻¹ := by group
      _ = k * s * k * t * k * s * k⁻¹ := by rw [show k⁻¹ * k ^ 2 = k by group]
      _ = k * s * (k * t * k) * s * k⁻¹ := by group
      _ = k * s * t * s * k⁻¹ := by rw [hktk]
  rw [hL, hR]

/-- **`X5 H t ≤ R` for any `R` containing `Q₀sub H` and its `t`-conjugate.**  Together with the
trivial inclusion `Q₀sub H ⊔ conj t (Q₀sub H) ≤ X5 H t` this says
`X5 H t = Q₀sub H ⊔ conj t (Q₀sub H)`. -/
theorem X5_le_of_Q0sub_sup_conj (h : Work.ZassenhausSuzuki.SzHyp H Q t s) {R : Subgroup G}
    (hA : Work.ThmF.Q0sub H ≤ R)
    (hconj : Submission.Blueprint.conj t (Work.ThmF.Q0sub H) ≤ R) :
    Work.ThmF.Lemma5.X5 H t ≤ R := by
  have ht2 : t * t = 1 := Work.ZassenhausSuzuki.Shadow.L5.ht_mul_self h
  have hsA : s ∈ Work.ThmF.Q0sub H :=
    Work.ThmF.Q0_le_Q0sub H (Or.inl (Work.ZassenhausSuzuki.Shadow.L5.s_mem_involutions h))
  -- `k ^ 2 * t ∈ R` for `k ∈ Kset H t`
  have key : ∀ k : G, k ∈ Work.ThmF.Kset H t → k ^ 2 * t ∈ R := by
    intro k hk
    obtain ⟨hkD, -⟩ := Work.ThmF.mem_Kset_iff.mp hk
    have hkH : k ∈ H := (Subgroup.mem_inf.mp hkD).1
    have hkmem : k⁻¹ * s * k ∈ Work.ThmF.Q0sub H := by
      have h' := (Subgroup.mem_normalizer_iff.mp
        (H_le_normalizer_Q0sub H (H.inv_mem hkH)) s).mp hsA
      simpa using h'
    have hcmem : k * s * k⁻¹ ∈ Work.ThmF.Q0sub H :=
      (Subgroup.mem_normalizer_iff.mp (H_le_normalizer_Q0sub H hkH) s).mp hsA
    have hLHS : t * (k⁻¹ * s * k) * t ∈ R :=
      hconj (Subgroup.mem_map.mpr ⟨k⁻¹ * s * k, hkmem, by
        change (MulAut.conj t) (k⁻¹ * s * k) = t * (k⁻¹ * s * k) * t
        rw [MulAut.conj_apply, Work.ZassenhausSuzuki.Shadow.L5.ht_inv h]⟩)
    have hcR : k * s * k⁻¹ ∈ R := hA hcmem
    have hprod : (k * s * k⁻¹) * (k ^ 2 * t) * (k * s * k⁻¹) ∈ R := by
      rw [← t_conj_sq h hk]
      exact hLHS
    have hcancel := R.mul_mem (R.mul_mem (R.inv_mem hcR) hprod) (R.inv_mem hcR)
    convert hcancel using 1
    group
  -- `t ∈ R` (the case `k = 1`)
  have htR : t ∈ R := by
    have h1 := key 1 (Work.ThmF.one_mem_Kset H t)
    simpa using h1
  -- hence `K ⊆ R`: `k² ∈ R` and `k ∈ ⟨k²⟩` because `k` has odd order
  have hKset : ∀ k ∈ Work.ThmF.Kset H t, k ∈ R := by
    intro k hk
    have h2t : k ^ 2 * t ∈ R := key k hk
    have h2 : k ^ 2 ∈ R := by
      have h' := R.mul_mem h2t htR
      rwa [mul_assoc, ht2, mul_one] at h'
    have hkD : k ∈ twoPoint H t := (Work.ThmF.mem_Kset_iff.mp hk).1
    have hodd : Odd (orderOf k) :=
      Odd.of_dvd_nat (Work.ThmF.split_odd_card_twoPoint h.split)
        (Subgroup.orderOf_dvd_natCard (twoPoint H t) hkD)
    obtain ⟨m, hm⟩ := hodd
    have hpow : k = (k ^ 2) ^ (m + 1) := by
      rw [← pow_mul, show 2 * (m + 1) = orderOf k + 1 by omega, pow_succ, pow_orderOf_eq_one,
        one_mul]
    rw [hpow]
    exact R.pow_mem h2 (m + 1)
  refine (Subgroup.closure_le R).mpr ?_
  intro x hx
  rcases hx with (hx | hx) | hx
  · exact hA (Work.ThmF.Q0_le_Q0sub H hx)
  · exact hKset x hx
  · rw [Set.mem_singleton_iff] at hx
    subst hx
    exact htR

theorem X5_eq_sup_conj_Q0sub {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s : G} (h : Work.ZassenhausSuzuki.SzHyp H Q t s) : Work.ThmF.Lemma5.X5 H t = Work.ThmF.Q0sub H ⊔ Submission.Blueprint.conj t (Work.ThmF.Q0sub H) := by
  refine le_antisymm (X5_le_of_Q0sub_sup_conj h le_sup_left le_sup_right) ?_
  refine sup_le Work.ZassenhausSuzuki.Shadow.L5.Q0sub_le_X5 ?_
  intro y hy
  have ht2 : t * t = 1 := Work.ZassenhausSuzuki.Shadow.L5.ht_mul_self h
  rw [Work.Models.mem_conj_iff] at hy
  have hyA : t * y * t ∈ Work.ThmF.Q0sub H := by
    rwa [Work.ZassenhausSuzuki.Shadow.L5.ht_inv h] at hy
  have hyX : t * (t * y * t) * t ∈ Work.ThmF.Lemma5.X5 H t :=
    (Work.ThmF.Lemma5.X5 H t).mul_mem
      ((Work.ThmF.Lemma5.X5 H t).mul_mem (Work.ThmF.Lemma5.t_mem_X5 H t)
        (Work.ZassenhausSuzuki.Shadow.L5.Q0sub_le_X5 hyA))
      (Work.ThmF.Lemma5.t_mem_X5 H t)
  have hconv : t * (t * y * t) * t = y := by
    rw [show t * (t * y * t) * t = (t * t) * y * (t * t) by group, ht2]
    group
  rwa [hconv] at hyX

end Work.ZassenhausSuzuki.Shadow.ChV12
