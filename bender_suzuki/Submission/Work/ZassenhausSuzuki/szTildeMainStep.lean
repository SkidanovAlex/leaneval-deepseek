namespace Work.ZassenhausSuzuki

/-- Pure group-theoretic core of `szTildeMainStep`.  Let `μ` be an involution, `x0 = μ a`, `τ`
an element (not assumed to be an involution) with `τ a τ⁻¹ = a` and `τ⁻¹ μ τ = μ⁻¹ a μ`.
Then `τ` conjugates the generator `x0` into its own cyclic subgroup: `τ x0 τ⁻¹ ∈ ⟨x0⟩`.

Indeed `X = τ μ τ⁻¹` satisfies `X * X = 1` and `X⁻¹ a X = μ` (conjugate the second hypothesis
by `τ`), whence `X a X = μ`; so `τ x0 τ⁻¹ = X a` and `(X a)² = (X a X) a = μ a = x0`.  The
element `X a = τ x0 τ⁻¹` is conjugate to `x0`, hence has the same order, and
`mem_zpowers_of_sq_eq` finishes. -/
private lemma conj_mem_zpowers_of_sq {G : Type} [Group G] [Finite G] (τ μ a x0 : G)
    (hμ2 : μ * μ = 1) (hx0 : x0 = μ * a) (hτa : τ * a * τ⁻¹ = a)
    (hconj : τ⁻¹ * μ * τ = μ⁻¹ * a * μ) :
    τ * x0 * τ⁻¹ ∈ Subgroup.zpowers x0 := by
  have hXaX : (τ * μ * τ⁻¹)⁻¹ * a * (τ * μ * τ⁻¹) = μ := by
    calc (τ * μ * τ⁻¹)⁻¹ * a * (τ * μ * τ⁻¹)
        = (τ * μ⁻¹ * τ⁻¹) * (τ * a * τ⁻¹) * (τ * μ * τ⁻¹) := by rw [hτa]; group
      _ = τ * (μ⁻¹ * a * μ) * τ⁻¹ := by group
      _ = τ * (τ⁻¹ * μ * τ) * τ⁻¹ := by rw [← hconj]
      _ = μ := by group
  have hX2 : (τ * μ * τ⁻¹) * (τ * μ * τ⁻¹) = 1 := by
    rw [show (τ * μ * τ⁻¹) * (τ * μ * τ⁻¹) = τ * (μ * μ) * τ⁻¹ from by group, hμ2]
    group
  have hXaX' : (τ * μ * τ⁻¹) * a * (τ * μ * τ⁻¹) = μ := by
    have hXmuX : (τ * μ * τ⁻¹) * μ * (τ * μ * τ⁻¹) = a := by
      calc (τ * μ * τ⁻¹) * μ * (τ * μ * τ⁻¹)
          = (τ * μ * τ⁻¹) * ((τ * μ * τ⁻¹)⁻¹ * a * (τ * μ * τ⁻¹)) * (τ * μ * τ⁻¹) := by
            rw [hXaX]
        _ = ((τ * μ * τ⁻¹) * (τ * μ * τ⁻¹)⁻¹) * a * ((τ * μ * τ⁻¹) * (τ * μ * τ⁻¹)) := by group
        _ = a := by rw [mul_inv_cancel, hX2, one_mul, mul_one]
    calc (τ * μ * τ⁻¹) * a * (τ * μ * τ⁻¹)
        = (τ * μ * τ⁻¹) * ((τ * μ * τ⁻¹) * μ * (τ * μ * τ⁻¹)) * (τ * μ * τ⁻¹) := by rw [hXmuX]
      _ = ((τ * μ * τ⁻¹) * (τ * μ * τ⁻¹)) * μ * ((τ * μ * τ⁻¹) * (τ * μ * τ⁻¹)) := by group
      _ = μ := by rw [hX2, one_mul, mul_one]
  have hy : τ * x0 * τ⁻¹ = (τ * μ * τ⁻¹) * a := by
    rw [hx0]
    calc τ * (μ * a) * τ⁻¹ = (τ * μ * τ⁻¹) * (τ * a * τ⁻¹) := by group
      _ = (τ * μ * τ⁻¹) * a := by rw [hτa]
  have hy_sq : (τ * x0 * τ⁻¹) * (τ * x0 * τ⁻¹) = x0 := by
    rw [hy, hx0]
    calc ((τ * μ * τ⁻¹) * a) * ((τ * μ * τ⁻¹) * a)
        = ((τ * μ * τ⁻¹) * a * (τ * μ * τ⁻¹)) * a := by group
      _ = μ * a := by rw [hXaX']
  have hord : orderOf (τ * x0 * τ⁻¹) = orderOf x0 :=
    (SemiconjBy.orderOf_eq τ (x := x0) (y := τ * x0 * τ⁻¹)
      (by rw [SemiconjBy]; group)).symm
  exact mem_zpowers_of_sq_eq hy_sq hord

/-- If `τ` conjugates the generator `x0` into `⟨x0⟩`, it conjugates every element of `⟨x0⟩`
into `⟨x0⟩` (conjugation is a homomorphism and `⟨x0⟩` is generated by `x0`). -/
private lemma zpowers_conj_mem {G : Type} [Group G] {τ x0 : G}
    (hy : τ * x0 * τ⁻¹ ∈ Subgroup.zpowers x0) {h : G} (hh : h ∈ Subgroup.zpowers x0) :
    τ * h * τ⁻¹ ∈ Subgroup.zpowers x0 := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hh
  rw [← hk]
  have hmap : τ * x0 ^ k * τ⁻¹ = (τ * x0 * τ⁻¹) ^ k := by
    rw [show τ * x0 ^ k * τ⁻¹ = (MulAut.conj τ) (x0 ^ k) from rfl, map_zpow]
    rfl
  rw [hmap]
  exact (Subgroup.zpowers x0).zpow_mem hy k

/-- BG 5.13, second half: a central involution `a ≠ 1` of `Q` whose reflection is not itself has `(∼ a)² = a`.  Route (all ingredients are in `Submission.Work.ZassenhausSuzuki.szTildeAux`): `tildeOf_conj_mu` (= BG 3.3 (a)) with `τ := ∼ a` (as an element of `G`), `μ := t * hG C a`, `x0 := μ * a`; conjugating that identity by `τ` gives `μ = X⁻¹ * a * X` for `X := τ * μ * τ⁻¹`, hence `X * a * X = μ` (using `X * X = 1`, which follows from `t_mul_h_sq`) and `(τ * x0 * τ⁻¹) * (τ * x0 * τ⁻¹) = x0`; `mem_zpowers_of_sq_eq` then gives `τ * x0 * τ⁻¹ ∈ ⟨x0⟩` (orders agree since it is a conjugate); now apply `eq_a_of_mem_normalizer_of_sq_eq_one` — which needs precisely this conjugation-of-generator membership, that the element lies in `Q`, is `≠ 1` and is an involution — either to `τ` when `τ * τ = 1` (that contradicts `hne`, using `tildeOf_ne_one` for `τ ≠ 1`) or to `τ * τ` otherwise (an involution since `τ ^ 4 = 1`). -/
theorem szTildeMainStep {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G}
    (hsplit : Submission.Blueprint.IsSplitRankOne H Q t)
    (hzass : Submission.Blueprint.IsZassenhaus H) (h2 : IsPGroup 2 Q)
    {m : ℕ} {θ : GaloisField 2 m ≃+* GaloisField 2 m} (hθ1 : θ ≠ 1) (hθodd : Odd (orderOf θ))
    {e : Q ≃* Work.ZassenhausSuzuki.SzA (GaloisField 2 m) θ}
    (htorus : ∀ d : G, d ∈ Submission.Blueprint.twoPoint H t →
      ∃ lam : (GaloisField 2 m)ˣ, ∀ x : Q,
        ∃ y : Q, (y : G) = d * (x : G) * d⁻¹ ∧
          e y = Work.ZassenhausSuzuki.SzA.hLam θ (lam : GaloisField 2 m) (e x))
    (C : Work.ZassenhausPSL2.Canon H Q t) {a : Q}
    (ha1 : (a : G) ≠ 1) (ha2 : a * a = 1) (hacen : a ∈ Subgroup.center Q)
    (h4 : ∀ x : Q, x ^ 4 = 1)
    (hne : (Work.ZassenhausSuzuki.tildeOf C a : Q) ≠ a) :
    (Work.ZassenhausSuzuki.tildeOf C a : Q) * (Work.ZassenhausSuzuki.tildeOf C a : Q) = a := by
  classical
  -- `τ = ∼ a` viewed as an element of `G`.
  set τg : G := ((tildeOf C a : Q) : G) with hτg
  -- `μ = t · h_a` is an involution.
  have hμ2 : (t * hG C a) * (t * hG C a) = 1 := t_mul_h_sq hsplit hzass h2 C a
  -- `τ` is non-trivial, and it commutes with `a` (which is central in `Q`).
  have hτane : ((tildeOf C a : Q) : G) ≠ 1 := by
    intro h
    exact tildeOf_ne_one hsplit hzass h2 C ha1 (Subtype.ext h)
  have hτg1 : τg ≠ 1 := by rw [hτg]; exact hτane
  have hτa : τg * (a : G) * τg⁻¹ = (a : G) := by
    have hcomm : (tildeOf C a) * a = a * (tildeOf C a) :=
      (Subgroup.mem_center_iff.mp hacen) (tildeOf C a)
    have h := congrArg (fun z : Q => (z : G)) hcomm
    simp only [Subgroup.coe_mul] at h
    rw [hτg]
    calc ((tildeOf C a : Q) : G) * (a : G) * ((tildeOf C a : Q) : G)⁻¹
        = (a : G) * ((tildeOf C a : Q) : G) * ((tildeOf C a : Q) : G)⁻¹ := by rw [h]
      _ = (a : G) := by group
  -- BG 3.3 (a) for `a`, i.e. `τ⁻¹ μ τ = μ⁻¹ a μ`.
  have hconj : τg⁻¹ * (t * hG C a) * τg = (t * hG C a)⁻¹ * (a : G) * (t * hG C a) := by
    rw [hτg]
    exact tildeOf_conj_mu hsplit hzass h2 C ha1 ha2
  -- Hence `τ` conjugates `x0 = μ a` into `⟨x0⟩`.
  have hy_mem : τg * (t * hG C a * (a : G)) * τg⁻¹
      ∈ Subgroup.zpowers (t * hG C a * (a : G)) :=
    conj_mem_zpowers_of_sq τg (t * hG C a) (a : G) (t * hG C a * (a : G)) hμ2 rfl hτa hconj
  -- And `τ * τ` conjugates every element of `⟨x0⟩` into `⟨x0⟩`.
  have hsx0 : (τg * τg) * (t * hG C a * (a : G)) * (τg * τg)⁻¹
      ∈ Subgroup.zpowers (t * hG C a * (a : G)) := by
    have h := zpowers_conj_mem hy_mem hy_mem
    rwa [show τg * (τg * (t * hG C a * (a : G)) * τg⁻¹) * τg⁻¹
          = (τg * τg) * (t * hG C a * (a : G)) * (τg * τg)⁻¹ from by group] at h
  have hs_mem : τg * τg ∈ Q := by
    rw [hτg]
    exact Q.mul_mem (tildeOf C a).2 (tildeOf C a).2
  have hτ_mem : τg ∈ Q := by
    rw [hτg]
    exact (tildeOf C a).2
  have hs2 : (τg * τg) * (τg * τg) = 1 := by
    have h := h4 (tildeOf C a)
    have hh : τg ^ 4 = 1 := by
      rw [hτg]
      simpa [Subgroup.coe_pow] using congrArg (fun z : Q => (z : G)) h
    rw [show (τg * τg) * (τg * τg) = τg ^ 4 from by
      rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, sq, sq]]
    exact hh
  -- `τ * τ ≠ 1`: otherwise `τ` itself is a non-trivial involution of `Q` normalising `⟨x0⟩`,
  -- hence `τ = a` by BG 5.13, contradicting `hne`.
  have hs_ne : (τg * τg) ≠ 1 := by
    intro hs1
    have hττ : τg = (a : G) :=
      eq_a_of_mem_normalizer_of_sq_eq_one hsplit hzass h2 hθ1 hθodd htorus C ha1 ha2 hacen
        (τ := τg) hτ_mem hy_mem hτg1 hs1
    exact hne (Subtype.ext (hτg.symm.trans hττ))
  have hfin : τg * τg = (a : G) :=
    eq_a_of_mem_normalizer_of_sq_eq_one hsplit hzass h2 hθ1 hθodd htorus C ha1 ha2 hacen
      (τ := τg * τg) hs_mem hsx0 hs_ne hs2
  apply Subtype.ext
  rw [Subgroup.coe_mul, ← hτg]
  exact hfin

end Work.ZassenhausSuzuki
