namespace Work.ZassenhausSuzuki

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

/-- A Tits endomorphism of a finite field of characteristic two has odd order.

`Fix θ = {0,1}` (`Work.ZassenhausSuzuki.fix_of_isTitsTheta`), so by Artin's theorem
(`IntermediateField.finrank_fixedField_eq_card`) `orderOf θ = Module.finrank (ZMod 2) K`; the
same argument applies to `θ * θ` (whose fixed field is also `{0,1}`), so
`orderOf (θ ^ 2) = orderOf θ`, i.e. `orderOf θ / Nat.gcd (orderOf θ) 2 = orderOf θ`, whence
`Nat.gcd (orderOf θ) 2 = 1`.  (Equivalently: transport to `GaloisField 2 (finrank)` and use
`Work.ZassenhausSuzuki.orderOf_ringAut_eq_of_fix`.) -/
theorem odd_orderOf_of_isTitsTheta {K : Type} [Field K] [CharP K 2] [Finite K]
    {θ : K ≃+* K} (hθ : Work.ZassenhausSuzuki.IsTitsTheta θ) :
    Odd (orderOf θ) := by
  -- `K` is a `ZMod 2`-algebra; this instance is not registered globally, so we provide it here.
  letI : Algebra (ZMod 2) K := ZMod.algebra (R := K) 2
  haveI : Module.Finite (ZMod 2) K := Module.Finite.of_finite
  haveI : Algebra.IsAlgebraic (ZMod 2) K := Algebra.IsAlgebraic.of_finite (ZMod 2) K
  -- The Frobenius (squaring) automorphism, regarded as a `ZMod 2`-algebra automorphism.
  let F : K ≃ₐ[ZMod 2] K := FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) K
  have hFapp : ∀ x : K, F x = x ^ 2 := by
    intro x
    have h1 : F x = x ^ Fintype.card (ZMod 2) :=
      congr_fun (FiniteField.coe_frobeniusAlgEquivOfAlgebraic (ZMod 2) K) x
    rw [ZMod.card] at h1
    exact h1
  -- Every ring automorphism of a field of characteristic two fixes the prime field.
  have hfixθ : ∀ x : ZMod 2, θ (algebraMap (ZMod 2) K x) = algebraMap (ZMod 2) K x := by
    intro x
    have hx : ((x.val : ℕ) : ZMod 2) = x := ZMod.natCast_zmod_val x
    rw [← hx, map_natCast (algebraMap (ZMod 2) K) x.val]
    exact map_natCast θ x.val
  let Θ : K ≃ₐ[ZMod 2] K := AlgEquiv.ofRingEquiv (f := θ) hfixθ
  have hcoe : (Θ : K ≃+* K) = θ := rfl
  -- `θ²` is the Frobenius.
  have hsqmul : Θ * Θ = F := by
    apply AlgEquiv.ext
    intro x
    rw [AlgEquiv.mul_apply]
    show θ (θ x) = F x
    rw [hθ.2 x, hFapp x]
  have hsq : Θ ^ 2 = F := by rw [pow_two]; exact hsqmul
  -- Forgetting the algebra structure preserves the order.
  have horder : orderOf Θ = orderOf θ := by
    let ψ : (K ≃ₐ[ZMod 2] K) →* (K ≃+* K) :=
      { toFun := fun e => (e : K ≃+* K)
        map_one' := rfl
        map_mul' := fun f g => by ext x; rfl }
    have hinj : Function.Injective ψ := fun a b h => AlgEquiv.coe_ringEquiv_injective h
    have hsub := orderOf_injective ψ hinj Θ
    rw [show ψ Θ = θ from hcoe] at hsub
    exact hsub.symm
  -- The Galois group of `K` over `ZMod 2` is cyclic, generated by the Frobenius.
  obtain ⟨i, hi⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) K).2 Θ
  have hpow : orderOf (Θ ^ 2) = orderOf Θ / Nat.gcd (orderOf Θ) 2 :=
    orderOf_pow' Θ (by norm_num)
  have hdvdF : orderOf Θ ∣ orderOf F := by
    rw [← hi]
    exact orderOf_pow_dvd (x := F) i.1
  have hFpos : 0 < orderOf F := by
    rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic]
    exact Module.finrank_pos
  have hForder2 : orderOf F = orderOf Θ / Nat.gcd (orderOf Θ) 2 := by rw [← hsq, hpow]
  have hle1 : orderOf Θ ≤ orderOf F := Nat.le_of_dvd hFpos hdvdF
  have hle2 : orderOf F ≤ orderOf Θ := by
    rw [hForder2]; exact Nat.div_le_self _ _
  have hdpos : 0 < orderOf Θ := lt_of_lt_of_le hFpos hle2
  have hd : orderOf Θ / Nat.gcd (orderOf Θ) 2 = orderOf Θ :=
    hForder2.symm.trans (le_antisymm hle2 hle1)
  -- `Nat.gcd (orderOf θ) 2 = 1`, i.e. `orderOf θ` is odd.
  have hg : Nat.gcd (orderOf Θ) 2 = 1 := by
    have hgpos : 0 < Nat.gcd (orderOf Θ) 2 := Nat.gcd_pos_of_pos_left 2 hdpos
    have hgd : Nat.gcd (orderOf Θ) 2 ∣ orderOf Θ := Nat.gcd_dvd_left _ _
    have htmp := (Nat.div_eq_iff_eq_mul_left hgpos hgd).mp hd
    have h1 : orderOf Θ * 1 = orderOf Θ * Nat.gcd (orderOf Θ) 2 := by
      rw [mul_one]; exact htmp
    exact (Nat.eq_of_mul_eq_mul_left hdpos h1).symm
  have hodd : Odd (orderOf Θ) := Nat.coprime_two_right.mp (Nat.coprime_iff_gcd_eq_one.mpr hg)
  exact horder ▸ hodd

end Work.ZassenhausSuzuki
