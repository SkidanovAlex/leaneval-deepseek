/-!
# Extending an invariant irreducible representation over a cyclic quotient

`Work.CharPrelim.exists_extension_rep`: if `K ◁ G` is a normal subgroup, `ρ` an irreducible
finite-dimensional complex representation of `K`, `g₀ ∈ G` generates `G ⧸ K` (with `orderOf g₀K = n`
and `g₀^n ∈ K`), and `P` is an intertwiner realizing the invariance of `ρ` under conjugation by
`g₀` (`P · ρ k = ρ (g₀ k g₀⁻¹) · P`) whose `n`-th power is `ρ (g₀^n)`, then `ρ` extends to a
representation `R` of `G`, automatically irreducible.

The construction is the classical Clifford/Mackey one: since every `x ∈ G` is `g₀^i k` for some
`i ∈ ℤ` and `k ∈ K`, one sets `R x = P^i · ρ k`; the hypotheses on `P` (together with the fact
that `G ⧸ K` has order `n` generated by `g₀K`) make this independent of the presentation and
multiplicative.  The irreducibility of `R` follows because any `R`-invariant subspace is a
`ρ`-invariant subspace.
-/

noncomputable section

open scoped MonoidAlgebra

namespace Work.CharPrelim

/-- For a representation `ρ : Representation k H M` and `h : H`, the image `ρ h` is an
invertible `k`-linear map; this is it as a linear equivalence. -/
noncomputable def repLinEquiv {k : Type*} [Field k] {H : Type*} [Group H] {M : Type*}
    [AddCommGroup M] [Module k M] (ρ : Representation k H M) (h : H) : M ≃ₗ[k] M :=
  LinearEquiv.ofBijective (ρ h) (ρ.apply_bijective h)

@[simp] theorem repLinEquiv_apply {k H M} [Field k] [Group H] [AddCommGroup M] [Module k M]
    (ρ : Representation k H M) (h : H) (v : M) : repLinEquiv ρ h v = ρ h v :=
  LinearEquiv.ofBijective_apply _ _

/-- `ρ` regarded as a monoid homomorphism into the group of linear automorphisms. -/
noncomputable def repLinEquivHom {k H M} [Field k] [Group H] [AddCommGroup M] [Module k M]
    (ρ : Representation k H M) : H →* (M ≃ₗ[k] M) where
  toFun := repLinEquiv ρ
  map_one' := by ext v; simp [repLinEquiv]
  map_mul' a b := by ext v; simp [repLinEquiv, Module.End.mul_apply]

@[simp] theorem repLinEquivHom_apply {k H M} [Field k] [Group H] [AddCommGroup M] [Module k M]
    (ρ : Representation k H M) (h : H) (v : M) : repLinEquivHom ρ h v = ρ h v := rfl

@[simp] theorem toLinearMap_repLinEquivHom {k H M} [Field k] [Group H] [AddCommGroup M]
    [Module k M] (ρ : Representation k H M) (h : H) :
    ((repLinEquivHom ρ h : M ≃ₗ[k] M) : M →ₗ[k] M) = ρ h := by
  ext v; simp [repLinEquivHom, repLinEquiv]

/-- Irreducibility is inherited from the restriction along a group homomorphism: if
`R.comp φ = ρ` with `ρ` irreducible, then `R` is irreducible.  Indeed restriction of
`R`-subrepresentations along `φ` is an injective monotone map (in fact the identity on the
underlying submodules), so an `R`-subrepresentation is `⊥` or `⊤` as soon as its restriction is. -/
theorem isIrreducible_of_comp_eq {k : Type*} [Field k] {G H : Type*} [Group G] [Group H]
    {V : Type*} [AddCommGroup V] [Module k V]
    (R : Representation k G V) (ρ : Representation k H V) (φ : H →* G)
    (h : R.comp φ = ρ) [ρ.IsIrreducible] : R.IsIrreducible := by
  have hcoe : ∀ h' : H, ρ h' = R (φ h') := by
    intro h'; rw [← h]; rfl
  let res : Subrepresentation R → Subrepresentation ρ := fun σ =>
    { toSubmodule := σ.toSubmodule
      apply_mem_toSubmodule := fun h' v hv => by
        rw [hcoe h']
        exact σ.apply_mem_toSubmodule (φ h') hv }
  have hres_inj : Function.Injective res := by
    intro σ τ hστ
    apply Subrepresentation.ext
    exact congrArg (fun s : Subrepresentation ρ => s.toSubmodule) hστ
  have hres_bot : res ⊥ = ⊥ := Subrepresentation.ext rfl
  have hres_top : res ⊤ = ⊤ := Subrepresentation.ext rfl
  haveI : Nontrivial (Subrepresentation R) :=
    ⟨⟨⊥, ⊤, fun hbot => by
      have : res (⊥ : Subrepresentation R) = res ⊤ := by rw [hbot]
      rw [hres_bot, hres_top] at this
      exact bot_ne_top this⟩⟩
  refine (isSimpleOrder_iff _).mpr ⟨inferInstance, fun σ => ?_⟩
  rcases IsSimpleOrder.eq_bot_or_eq_top (res σ) with hb | ht
  · left
    exact hres_inj (by rw [hb, hres_bot])
  · right
    exact hres_inj (by rw [ht, hres_top])

theorem exists_extension_rep {G : Type*} [Group G] [Fintype G] {K : Subgroup G} [K.Normal]
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (ρ : Representation ℂ ↥K V) (hρ : ρ.IsIrreducible)
    (g₀ : G) (n : ℕ) (hn : 0 < n)
    (hgen : ∀ x : G, ∃ i : ℤ, (QuotientGroup.mk' K g₀) ^ i = (QuotientGroup.mk' K) x)
    (hnord : orderOf ((QuotientGroup.mk' K) g₀) = n)
    (hk : g₀ ^ (n : ℤ) ∈ K)
    (P : V ≃ₗ[ℂ] V)
    (hP : ∀ k : ↥K, (P : V →ₗ[ℂ] V) ∘ₗ ρ k =
      ρ ⟨g₀ * (k : G) * g₀⁻¹, (inferInstance : K.Normal).conj_mem (k : G) k.2 g₀⟩
        ∘ₗ (P : V →ₗ[ℂ] V))
    (hPn : ((P ^ (n : ℤ) : V ≃ₗ[ℂ] V) : V →ₗ[ℂ] V) = ρ ⟨g₀ ^ (n : ℤ), hk⟩) :
    ∃ R : Representation ℂ G V, R.IsIrreducible ∧ R.comp K.subtype = ρ := by
  classical
  haveI := hρ
  let φ : MulAut ↥K := MulAut.conjNormal g₀
  -- The intertwining relation, transported to the group of linear equivalences.
  have hPEQ : ∀ k : ↥K, P * repLinEquivHom ρ k = repLinEquivHom ρ (φ k) * P := by
    intro k
    have hφ : φ k =
        ⟨g₀ * (k : G) * g₀⁻¹, (inferInstance : K.Normal).conj_mem (k : G) k.2 g₀⟩ :=
      Subtype.ext (MulAut.conjNormal_apply g₀ k)
    ext v
    rw [LinearEquiv.mul_apply, LinearEquiv.mul_apply, repLinEquivHom_apply,
      repLinEquivHom_apply, hφ]
    have h1 : (P : V →ₗ[ℂ] V) ((ρ k) v) =
        (ρ ⟨g₀ * (k : G) * g₀⁻¹, (inferInstance : K.Normal).conj_mem (k : G) k.2 g₀⟩)
          ((P : V →ₗ[ℂ] V) v) := by
      simpa using LinearMap.congr_fun (hP k) v
    exact h1
  -- The same for `P⁻¹`.
  have hPinv : ∀ k : ↥K, P⁻¹ * repLinEquivHom ρ k = repLinEquivHom ρ ((φ⁻¹) k) * P⁻¹ := by
    intro k
    have hφk : φ (φ⁻¹ k) = k := by simp [φ]
    have h2 : P * repLinEquivHom ρ (φ⁻¹ k) = repLinEquivHom ρ k * P := by
      have h := hPEQ (φ⁻¹ k); rw [hφk] at h; exact h
    calc P⁻¹ * repLinEquivHom ρ k
        = P⁻¹ * repLinEquivHom ρ k * (P * P⁻¹) := by group
      _ = P⁻¹ * (repLinEquivHom ρ k * P) * P⁻¹ := by group
      _ = P⁻¹ * (P * repLinEquivHom ρ (φ⁻¹ k)) * P⁻¹ := by rw [← h2]
      _ = repLinEquivHom ρ (φ⁻¹ k) * P⁻¹ := by group
  -- Generic natural-number power form of the commutation relation.
  have nat_lemma : ∀ (u : V ≃ₗ[ℂ] V) (ψ : MulAut ↥K),
      (∀ k, u * repLinEquivHom ρ k = repLinEquivHom ρ (ψ k) * u) →
      ∀ (m : ℕ) (k : ↥K),
        u ^ m * repLinEquivHom ρ k = repLinEquivHom ρ ((ψ ^ m) k) * u ^ m := by
    intro u ψ hu m
    induction m with
    | zero => intro k; simp
    | succ m ih =>
      intro k
      rw [pow_succ, mul_assoc, hu k, ← mul_assoc, ih (ψ k), mul_assoc, ← pow_succ]
      congr 1
  -- `P^i · ρ k = ρ (φ^i k) · P^i` for all `i : ℤ`.
  have hcomm : ∀ (i : ℤ) (k : ↥K),
      P ^ i * repLinEquivHom ρ k = repLinEquivHom ρ ((φ ^ i) k) * P ^ i := by
    intro i k
    rcases Int.eq_nat_or_neg i with ⟨m, hm | hm⟩
    · rw [hm]; simpa only [zpow_natCast] using nat_lemma P φ hPEQ m k
    · rw [hm]
      have h := nat_lemma P⁻¹ (φ⁻¹) hPinv m k
      have hPm : P ^ (-(m:ℤ)) = (P⁻¹)^m := by rw [zpow_neg, zpow_natCast, inv_pow]
      have hφm : (φ ^ (-(m:ℤ))) = (φ⁻¹)^m := by rw [zpow_neg, zpow_natCast, inv_pow]
      rw [hPm, hφm]
      exact h
  -- The rearranged form used in the multiplicativity computation.
  have hcomm' : ∀ (i : ℤ) (m : ↥K),
      repLinEquivHom ρ m * P ^ i = P ^ i * repLinEquivHom ρ ((φ ^ (-i)) m) := by
    intro i m
    have h := hcomm i ((φ ^ (-i)) m)
    have hφ : (φ ^ i) ((φ ^ (-i)) m) = m := by
      rw [← MulAut.mul_apply, ← zpow_add, add_neg_cancel, zpow_zero, MulAut.one_apply]
    rw [hφ] at h
    exact h.symm
  -- The value of `φ^j` on an element of `K`.
  have hφapply : ∀ (j : ℤ) (k : ↥K), ((φ ^ j) k : G) = g₀ ^ j * (k:G) * g₀ ^ (-j) := by
    intro j k
    have hφj : φ ^ j = MulAut.conjNormal (g₀ ^ j) := by
      rw [show φ = MulAut.conjNormal g₀ from rfl, ← map_zpow]
    rw [hφj, MulAut.conjNormal_apply, zpow_neg]
  -- `P^n = ρ (g₀^n)` as linear equivalences.
  have hQn : repLinEquivHom ρ ⟨g₀ ^ (n : ℤ), hk⟩ = P ^ (n : ℤ) := by
    apply LinearEquiv.toLinearMap_injective
    simp only [toLinearMap_repLinEquivHom, hPn]
  -- A chosen exponent `i₀ x` with `(g₀K)^{i₀ x} = xK`.
  let i₀ : G → ℤ := fun x => Classical.choose (hgen x)
  have hi₀ : ∀ x, (QuotientGroup.mk' K g₀) ^ (i₀ x) = (QuotientGroup.mk' K) x :=
    fun x => Classical.choose_spec (hgen x)
  have hmem : ∀ (i : ℤ) (x : G), (QuotientGroup.mk' K g₀) ^ i = (QuotientGroup.mk' K) x →
      g₀ ^ (-i) * x ∈ K := by
    intro i x hix
    have h : (QuotientGroup.mk' K) (g₀ ^ (-i) * x) = 1 := by
      rw [map_mul, map_zpow, ← hix, ← zpow_add, neg_add_cancel, zpow_zero]
    exact (QuotientGroup.eq_one_iff (g₀ ^ (-i) * x)).mp h
  -- The canonical `K`-component of `x` for the exponent `i₀ x`.
  let e₀ : G → ↥K := fun x => ⟨g₀ ^ (-(i₀ x)) * x, hmem (i₀ x) x (hi₀ x)⟩
  have he₀ : ∀ x, g₀ ^ (i₀ x) * (e₀ x : G) = x := by
    intro x
    change g₀ ^ (i₀ x) * (g₀ ^ (-(i₀ x)) * x) = x
    rw [zpow_neg]; group
  -- Independence of the presentation `x = g₀^i · k`.
  have indep : ∀ (i j : ℤ) (k l : ↥K), (g₀:G)^i * (k:G) = g₀^j * (l:G) →
      P ^ i * repLinEquivHom ρ k = P ^ j * repLinEquivHom ρ l := by
    intro i j k l hkl
    have hmemij : g₀ ^ (i - j) ∈ K := by
      have h1 : (g₀:G)^(i-j) = (l:G) * (k:G)⁻¹ := by
        have h2 : (g₀:G)^j * g₀^(i-j) = (g₀:G)^j * ((l:G) * (k:G)⁻¹) := by
          rw [← zpow_add, show j + (i-j) = i by ring]
          rw [← mul_assoc, ← hkl, mul_assoc, mul_inv_cancel, mul_one]
        exact mul_left_cancel h2
      rw [h1]
      exact K.mul_mem l.2 (K.inv_mem k.2)
    have hq : (QuotientGroup.mk' K g₀) ^ (i - j) = 1 := by
      have h : (QuotientGroup.mk' K) (g₀ ^ (i-j)) = 1 := (QuotientGroup.eq_one_iff _).mpr hmemij
      rwa [map_zpow] at h
    have hdvd : (n:ℤ) ∣ (i - j) := by
      have h := (orderOf_dvd_iff_zpow_eq_one (x := (QuotientGroup.mk' K) g₀) (i := i - j)).mpr hq
      rwa [hnord] at h
    obtain ⟨m, hm⟩ := hdvd
    have hi : i = j + (n:ℤ) * m := by omega
    have hl : (l:G) = (g₀:G)^(i-j) * (k:G) := by
      apply mul_left_cancel (a := (g₀:G)^j)
      rw [← hkl, ← mul_assoc, ← zpow_add, show j + (i-j) = i by ring]
    have hkl' : (⟨g₀^(n:ℤ), hk⟩ : ↥K) ^ m * k = l := by
      apply Subtype.ext
      simp only [Subgroup.coe_mul, Subgroup.coe_zpow]
      rw [← zpow_mul, ← hm, ← hl]
    have hQn' : P ^ (n:ℤ) = repLinEquivHom ρ ⟨g₀^(n:ℤ), hk⟩ := hQn.symm
    calc P ^ i * repLinEquivHom ρ k
        = P ^ (j + (n:ℤ)*m) * repLinEquivHom ρ k := by rw [← hi]
      _ = P ^ j * P ^ ((n:ℤ)*m) * repLinEquivHom ρ k := by rw [zpow_add]
      _ = P ^ j * (P ^ (n:ℤ)) ^ m * repLinEquivHom ρ k := by rw [zpow_mul]
      _ = P ^ j * (repLinEquivHom ρ ⟨g₀^(n:ℤ), hk⟩) ^ m * repLinEquivHom ρ k := by rw [hQn']
      _ = P ^ j * repLinEquivHom ρ (⟨g₀^(n:ℤ), hk⟩ ^ m) * repLinEquivHom ρ k := by
            rw [← map_zpow (repLinEquivHom ρ) _ m]
      _ = P ^ j * (repLinEquivHom ρ (⟨g₀^(n:ℤ), hk⟩ ^ m) * repLinEquivHom ρ k) := by group
      _ = P ^ j * repLinEquivHom ρ (⟨g₀^(n:ℤ), hk⟩ ^ m * k) := by
            rw [← map_mul (repLinEquivHom ρ) _ _]
      _ = P ^ j * repLinEquivHom ρ l := by rw [hkl']
  -- The value at any other presentation.
  have hpres : ∀ (i : ℤ) (k : ↥K) (x : G), g₀ ^ i * (k:G) = x →
      P ^ (i₀ x) * repLinEquivHom ρ (e₀ x) = P ^ i * repLinEquivHom ρ k := by
    intro i k x hx
    exact indep (i₀ x) i (e₀ x) k (by rw [he₀ x, hx])
  -- Pure group identity used to compare the two presentations of `x * y`.
  have haux : ∀ (a b x y : G) (i j : ℤ), g₀^i * a = x → g₀^j * b = y →
      g₀ ^ (i+j) * (g₀ ^ (-j) * a * g₀ ^ j * b) = x * y := by
    intro a b x y i j ha hb
    rw [← ha, ← hb, zpow_add, zpow_neg]
    group
  -- Multiplicativity of the formula.
  have hR'mul : ∀ x y : G,
      P ^ (i₀ (x*y)) * repLinEquivHom ρ (e₀ (x*y)) =
        (P ^ (i₀ x) * repLinEquivHom ρ (e₀ x)) *
          (P ^ (i₀ y) * repLinEquivHom ρ (e₀ y)) := by
    intro x y
    have hp : g₀ ^ (i₀ x + i₀ y) * ((φ ^ (-(i₀ y))) (e₀ x) * e₀ y : ↥K) = x * y := by
      rw [Subgroup.coe_mul, hφapply (-(i₀ y)) (e₀ x), neg_neg]
      exact haux (e₀ x : G) (e₀ y : G) x y (i₀ x) (i₀ y) (he₀ x) (he₀ y)
    have hxy := hpres (i₀ x + i₀ y) ((φ ^ (-(i₀ y))) (e₀ x) * e₀ y) (x * y) hp
    have hcy := hcomm' (i₀ y) (e₀ x)
    have step : (P ^ (i₀ x) * repLinEquivHom ρ (e₀ x)) *
          (P ^ (i₀ y) * repLinEquivHom ρ (e₀ y))
        = P ^ (i₀ x + i₀ y) * repLinEquivHom ρ ((φ ^ (-(i₀ y))) (e₀ x) * e₀ y) := by
      calc (P ^ (i₀ x) * repLinEquivHom ρ (e₀ x)) *
              (P ^ (i₀ y) * repLinEquivHom ρ (e₀ y))
          = P ^ (i₀ x) * (repLinEquivHom ρ (e₀ x) * P ^ (i₀ y)) *
              repLinEquivHom ρ (e₀ y) := by group
        _ = P ^ (i₀ x) *
              (P ^ (i₀ y) * repLinEquivHom ρ ((φ ^ (-(i₀ y))) (e₀ x))) *
              repLinEquivHom ρ (e₀ y) := by rw [hcy]
        _ = (P ^ (i₀ x) * P ^ (i₀ y)) *
              (repLinEquivHom ρ ((φ ^ (-(i₀ y))) (e₀ x)) * repLinEquivHom ρ (e₀ y)) := by
              group
        _ = P ^ (i₀ x + i₀ y) *
              (repLinEquivHom ρ ((φ ^ (-(i₀ y))) (e₀ x)) * repLinEquivHom ρ (e₀ y)) := by
              rw [← zpow_add]
        _ = P ^ (i₀ x + i₀ y) *
              repLinEquivHom ρ ((φ ^ (-(i₀ y))) (e₀ x) * e₀ y) := by
              rw [← map_mul (repLinEquivHom ρ) _ _]
    rw [hxy, step]
  -- The monoid homomorphism `G → GL(V)` and its underlying representation.
  let R' : G →* (V ≃ₗ[ℂ] V) :=
    { toFun := fun x => P ^ (i₀ x) * repLinEquivHom ρ (e₀ x)
      map_one' := by
        have h := hpres 0 1 1 (by simp)
        rw [h]; simp
      map_mul' := hR'mul }
  let R : Representation ℂ G V :=
    (LinearEquiv.automorphismGroup.toLinearMapMonoidHom).comp R'
  -- `R` restricts to `ρ` on `K`.
  have hRk : ∀ k : ↥K, R' (k : G) = repLinEquivHom ρ k := by
    intro k
    have h := hpres 0 ⟨(k:G), k.2⟩ (k:G) (by simp)
    change P ^ (i₀ (k:G)) * repLinEquivHom ρ (e₀ (k:G)) = repLinEquivHom ρ k
    simpa using h
  have hRcomp : R.comp K.subtype = ρ := by
    apply MonoidHom.ext
    intro k
    change ((R' (k:G)) : V →ₗ[ℂ] V) = ρ k
    rw [hRk k, toLinearMap_repLinEquivHom]
  exact ⟨R, isIrreducible_of_comp_eq R ρ K.subtype hRcomp, hRcomp⟩

end Work.CharPrelim
