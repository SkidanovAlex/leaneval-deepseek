/-!
# The pointwise product of two characters is a character

Characters are functions `G → ℂ`.  This file shows that `Work.CharCore.IsChar` — the additive
monoid generated by the irreducible characters `Irr G` — is also closed under the pointwise
product, `(f * g) x = f x * g x`.

The mathematical content is the tensor product of representations:

* if `χ` and `ψ` are irreducible characters, then by `Work.CharCore.mem_Irr_iff_fdrep` they are
  the characters of finite dimensional representations `V` and `W`; the diagonal action on
  `V ⊗[ℂ] W` makes it a representation of `G` whose character is `χ * ψ`
  (`Representation.char_tensor`, `FDRep.char_tensor`);
* the character of *any* finite dimensional complex representation is a character
  (`Work.CharCore.isChar_character`), so `χ * ψ` is a character;
* finally a general `IsChar f` is a sum of irreducible characters, so `f * g` is a sum of the
  products `χ * ψ`, and `IsChar` is closed under finite sums (`Work.CharCore.IsChar.sum`).

## Main results

* `Work.CharCore.isChar_mul_mem_Irr` : `χ * ψ` is a character for `χ, ψ ∈ Irr G`;
* `Work.CharCore.IsChar.mul_irr` : `IsChar f` implies `IsChar (f * χ)` for `χ ∈ Irr G`;
* `Work.CharCore.isChar_mul` : `IsChar f` and `IsChar g` imply `IsChar (f * g)`.
-/

noncomputable section

open scoped CategoryTheory.MonoidalCategory

namespace Work.CharCore

variable {G : Type*} [Group G] [Fintype G]

/-- The pointwise product of two irreducible characters is a character: it is the character of
the tensor product of the underlying representations, acting diagonally. -/
theorem isChar_mul_mem_Irr {χ ψ : G → ℂ} (hχ : χ ∈ Irr G) (hψ : ψ ∈ Irr G) :
    IsChar (χ * ψ) := by
  obtain ⟨V, -, hV⟩ := (mem_Irr_iff_fdrep χ).mp hχ
  obtain ⟨W, -, hW⟩ := (mem_Irr_iff_fdrep ψ).mp hψ
  rw [← hV, ← hW, ← FDRep.char_tensor V W]
  exact isChar_character (V ⊗ W).ρ

/-- Multiplying a character by an irreducible character gives a character. -/
theorem IsChar.mul_irr {f : G → ℂ} (hf : IsChar f) {χ : G → ℂ} (hχ : χ ∈ Irr G) :
    IsChar (f * χ) := by
  induction hf using AddSubmonoid.closure_induction with
  | mem x hx => exact isChar_mul_mem_Irr hx hχ
  | zero => simpa using IsChar.zero
  | add x y _ _ ihx ihy =>
      have hxy : (x + y) * χ = x * χ + y * χ := by
        funext g; simp [Pi.add_apply, add_mul]
      rw [hxy]; exact ihx.add ihy

/-- Multiplying two characters gives a character. -/
theorem IsChar.mul {f g : G → ℂ} (hf : IsChar f) (hg : IsChar g) : IsChar (f * g) := by
  induction hg using AddSubmonoid.closure_induction with
  | mem x hx => exact hf.mul_irr hx
  | zero => simpa using IsChar.zero
  | add x y _ _ ihx ihy =>
      have hxy : f * (x + y) = f * x + f * y := by
        funext g; simp [Pi.add_apply, mul_add]
      rw [hxy]; exact ihx.add ihy

theorem isChar_mul {G : Type*} [Group G] [Fintype G] {f g : G → ℂ} (hf : IsChar f) (hg : IsChar g) :
    IsChar (f * g) :=
  hf.mul hg

end Work.CharCore
