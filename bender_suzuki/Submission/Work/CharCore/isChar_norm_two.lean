/-!
# A character of norm two is the sum of two distinct irreducible characters

Let `F` be a character of a finite group `G` (an element of the additive monoid generated by
`Irr G`) whose norm `cfInner F F` equals `2`.  Writing `F = ∑ χ, c χ • χ` with `c χ : ℕ`
(`Work.CharCore.isChar_iff_exists_nat_coeffs`) and using orthonormality of `Irr G`
(`Work.CharCore.irr_orthonormal`), the norm formula
`Work.CharCore.cfInner_eq_sum_sq` turns the hypothesis into `∑ χ, (c χ) ^ 2 = 2`.  A sum of
squares of natural numbers equal to `2` has exactly two nonzero summands, both equal to `1`
(`sum_sq_eq_two_nat`), so `F` is the sum of the two corresponding irreducible characters.

## Main results

* `sum_sq_eq_one_nat` — a sum of squares of natural numbers equal to `1` has a unique nonzero
  summand, equal to `1`;
* `sum_sq_eq_two_nat` — a sum of squares of natural numbers equal to `2` has exactly two
  nonzero summands, both equal to `1`;
* `sum_natCoeff_eq_add` — reconstruction of a formal sum with two unit coefficients;
* `isChar_norm_two` — the target.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

open Classical Finset

namespace Work.CharCore

variable {G : Type*} [Group G] [Fintype G]

/-- A sum of squares of natural numbers equal to `1` has a unique nonzero summand, and it is
`1`. -/
theorem sum_sq_eq_one_nat {ι : Type*} (s : Finset ι) (c : ι → ℕ)
    (h : ∑ i ∈ s, c i ^ 2 = 1) :
    ∃ i₀ ∈ s, c i₀ = 1 ∧ ∀ i ∈ s, i ≠ i₀ → c i = 0 := by
  have hex : ∃ i ∈ s, c i ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    have h0 : ∑ i ∈ s, c i ^ 2 = 0 :=
      Finset.sum_eq_zero fun i hi => by rw [hcon i hi]; simp
    omega
  obtain ⟨i₀, hi₀s, hi₀⟩ := hex
  have hle : c i₀ ^ 2 ≤ 1 := by
    have h1 : c i₀ ^ 2 ≤ ∑ i ∈ s, c i ^ 2 :=
      Finset.single_le_sum (f := fun i => c i ^ 2) (fun i _ => Nat.zero_le _) hi₀s
    omega
  have hval : c i₀ = 1 := by
    have hle1 : c i₀ ≤ 1 := by
      by_contra hcon
      have h2 : 2 ≤ c i₀ := by omega
      have h4 : 4 ≤ c i₀ ^ 2 := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ c i₀ ^ 2 := Nat.pow_le_pow_left h2 2
      omega
    omega
  refine ⟨i₀, hi₀s, hval, fun i hi hne => ?_⟩
  have herase : ∑ k ∈ s.erase i₀, c k ^ 2 = 0 := by
    have hsplit := Finset.sum_erase_add (s := s) (f := fun k => c k ^ 2) hi₀s
    rw [h, hval] at hsplit
    omega
  have hz : c i ^ 2 = 0 := by
    have h1 : c i ^ 2 ≤ ∑ k ∈ s.erase i₀, c k ^ 2 :=
      Finset.single_le_sum (f := fun k => c k ^ 2) (fun k _ => Nat.zero_le _)
        (Finset.mem_erase.mpr ⟨hne, hi⟩)
    omega
  exact sq_eq_zero_iff.mp hz

/-- A sum of squares of natural numbers equal to `2` has exactly two nonzero summands, and
they are both `1`. -/
theorem sum_sq_eq_two_nat {ι : Type*} [Fintype ι] (c : ι → ℕ)
    (h : ∑ i, c i ^ 2 = 2) :
    ∃ i j, i ≠ j ∧ c i = 1 ∧ c j = 1 ∧ ∀ k, k ≠ i → k ≠ j → c k = 0 := by
  have hex : ∃ i, c i ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    have h0 : ∑ i, c i ^ 2 = 0 := Finset.sum_eq_zero fun i _ => by rw [hcon i]; simp
    omega
  obtain ⟨i, hi⟩ := hex
  have hle2 : c i ^ 2 ≤ 2 := by
    have h1 : c i ^ 2 ≤ ∑ j, c j ^ 2 :=
      Finset.single_le_sum (f := fun j => c j ^ 2) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
    omega
  have hci : c i = 1 := by
    have hle1 : c i ≤ 1 := by
      by_contra hcon
      have h2 : 2 ≤ c i := by omega
      have h4 : 4 ≤ c i ^ 2 := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ c i ^ 2 := Nat.pow_le_pow_left h2 2
      omega
    have hpos : 1 ≤ c i := Nat.one_le_iff_ne_zero.mpr hi
    omega
  have hrest : ∑ k ∈ Finset.univ.erase i, c k ^ 2 = 1 := by
    have hsplit :=
      Finset.sum_erase_add (s := Finset.univ) (f := fun k => c k ^ 2) (Finset.mem_univ i)
    rw [h, hci] at hsplit
    omega
  obtain ⟨j, hje, hcj, hzero⟩ := sum_sq_eq_one_nat (Finset.univ.erase i) c hrest
  refine ⟨i, j, ?_, hci, hcj, fun k hki hkj =>
    hzero k (Finset.mem_erase.mpr ⟨hki, Finset.mem_univ k⟩) hkj⟩
  exact fun hij => (Finset.mem_erase.mp hje).1 hij.symm

/-- Reconstruction: if a natural coefficient function on `Irr G` is `1` at two distinct
elements and vanishes elsewhere, the associated formal sum is the sum of those two
irreducible characters. -/
theorem sum_natCoeff_eq_add {c : ↥(Irr G) → ℕ} {i j : ↥(Irr G)} (hij : i ≠ j)
    (hci : c i = 1) (hcj : c j = 1) (hzero : ∀ k, k ≠ i → k ≠ j → c k = 0) :
    (∑ χ : ↥(Irr G), (c χ : ℂ) • (χ : G → ℂ)) = (i : G → ℂ) + (j : G → ℂ) := by
  have hsub : ({i, j} : Finset ↥(Irr G)) ⊆ Finset.univ := Finset.subset_univ _
  have hzero' : ∀ χ ∈ (Finset.univ : Finset ↥(Irr G)), χ ∉ ({i, j} : Finset ↥(Irr G)) →
      ((c χ : ℂ) • (χ : G → ℂ)) = 0 := by
    intro χ _ hχ
    have hχi : χ ≠ i := fun hh => hχ (by rw [hh]; simp)
    have hχj : χ ≠ j := fun hh => hχ (by rw [hh]; simp)
    rw [hzero χ hχi hχj]; simp
  rw [← Finset.sum_subset hsub hzero', Finset.sum_pair hij, hci, hcj]
  simp

theorem isChar_norm_two {G : Type*} [Group G] [Fintype G] {F : G → ℂ}
    (hchar : Work.CharCore.IsChar F) (hclass : Work.CharCore.IsClassFun F)
    (hnorm : Work.CharCore.cfInner F F = 2) :
    ∃ f₁ ∈ Work.CharCore.Irr G, ∃ f₂ ∈ Work.CharCore.Irr G, f₁ ≠ f₂ ∧ F = f₁ + f₂ := by
  obtain ⟨c, hc⟩ := isChar_iff_exists_nat_coeffs.mp hchar
  -- rewrite the coefficients as integers to apply the norm formula
  have hc' : F = ∑ χ : ↥(Irr G), ((c χ : ℤ) : ℂ) • (χ : G → ℂ) := by
    rw [hc]
    exact Finset.sum_congr rfl fun χ _ => by simp [Int.cast_natCast]
  -- the norm formula: `cfInner F F = ∑ χ, (c χ) ^ 2`
  have hsumC : ∑ χ : ↥(Irr G), (c χ : ℂ) ^ 2 = 2 := by
    have hsq := cfInner_eq_sum_sq (s := Irr G) (fun _ hx => hx) (fun χ : ↥(Irr G) => (c χ : ℤ))
    rw [hc'] at hnorm
    rw [hsq] at hnorm
    simpa using hnorm
  have hsumN : ∑ χ : ↥(Irr G), (c χ) ^ 2 = 2 := by
    have hc2 : ((∑ χ : ↥(Irr G), (c χ) ^ 2 : ℕ) : ℂ) = (2 : ℂ) := by
      push_cast
      exact hsumC
    exact Nat.cast_injective hc2
  obtain ⟨i, j, hij, hci, hcj, hzero⟩ := sum_sq_eq_two_nat c hsumN
  refine ⟨(i : G → ℂ), i.2, (j : G → ℂ), j.2, ?_, ?_⟩
  · intro h
    exact hij (Subtype.ext h)
  · rw [hc]
    exact sum_natCoeff_eq_add hij hci hcj hzero

end Work.CharCore
