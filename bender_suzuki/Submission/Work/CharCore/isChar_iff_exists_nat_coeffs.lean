/-!
# `Work.CharCore.isChar_iff_exists_nat_coeffs`

A function `f : G → ℂ` is a character (i.e. lies in the additive monoid generated by the
irreducible characters) if and only if it is a non-negative integral linear combination of
the irreducible characters.

The proof identifies the set of such combinations with an additive submonoid of `G → ℂ`
containing `Irr G`; minimality of the closure gives one inclusion, and closure under sums of
non-negative multiples gives the other.
-/

noncomputable section

open Classical

namespace Work.CharCore

theorem isChar_iff_exists_nat_coeffs {G : Type*} [Group G] [Fintype G] {f : G → ℂ} :
    IsChar f ↔ ∃ c : ↥(Irr G) → ℕ, f = ∑ χ : ↥(Irr G), (c χ : ℂ) • (χ : G → ℂ) := by
  -- The set of non-negative integral combinations of irreducible characters is an additive
  -- submonoid of `G → ℂ`.
  let S : AddSubmonoid (G → ℂ) :=
    { carrier := {f | ∃ c : ↥(Irr G) → ℕ, f = ∑ χ : ↥(Irr G), (c χ : ℂ) • (χ : G → ℂ)}
      zero_mem' := by
        refine ⟨fun _ => 0, ?_⟩
        simp
      add_mem' := by
        rintro f g ⟨cf, rfl⟩ ⟨cg, rfl⟩
        refine ⟨fun χ => cf χ + cg χ, ?_⟩
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun χ _ => by rw [Nat.cast_add, add_smul]) }
  -- Each irreducible character is such a combination (coefficient `1` on itself),
  -- so the closure of `Irr G` is contained in `S`.
  have hle : AddSubmonoid.closure ((Irr G : Finset (G → ℂ)) : Set (G → ℂ)) ≤ S := by
    rw [AddSubmonoid.closure_le]
    intro χ₀ hχ₀
    refine ⟨fun χ => if (χ : G → ℂ) = χ₀ then 1 else 0, ?_⟩
    rw [Finset.sum_eq_single (⟨χ₀, hχ₀⟩ : ↥(Irr G))]
    · simp
    · intro b _ hb
      have hne : (b : G → ℂ) ≠ χ₀ := fun h => hb (Subtype.ext h)
      simp [hne]
    · intro h; exact absurd (Finset.mem_univ _) h
  constructor
  · intro hf
    exact hle hf
  · rintro ⟨c, rfl⟩
    -- A single non-negative multiple of an element of `Irr G` is a character.
    exact IsChar.sum (fun χ _ => by
      simpa only [Nat.cast_smul_eq_nsmul] using IsChar.nsmul (IsChar.of_mem_Irr χ.2) (c χ))

end Work.CharCore
