/-!
# Virtual characters are exactly the integral combinations of irreducible characters

`Work.CharCore.IsVChar f` is defined as membership of `f` in the additive subgroup of
`G → ℂ` generated by the finite set `Irr G` of irreducible characters.  This file records
the concrete description of that subgroup as the set of *finite integral linear
combinations* of the irreducible characters:

`f` is a virtual character iff there are integers `c χ` with `f = ∑ χ, c χ • χ`.

The mathematical content is the elementary fact that the additive subgroup generated by a
finite set `S` of an additive commutative group consists precisely of the integral linear
combinations `∑ s, c s • s` with `c : S → ℤ` arbitrary.  We prove that in general
(`mem_closure_finset_iff_exists_int_coeffs`) and then specialise it, using that an integer
cast into `ℂ` acting on `G → ℂ` agrees with the integer multiple
(`Int.cast_smul_eq_zsmul`).
-/

noncomputable section

open Classical

namespace Work.CharCore

section General

variable {M : Type*} [AddCommGroup M]

/-- **The additive subgroup generated by a finite set is its integral span.**

For a finite set `S` in an additive commutative group, an element lies in the subgroup
generated by `S` iff it is a finite integral linear combination of the elements of `S`,
i.e. iff there is `c : S → ℤ` with `x = ∑ s, c s • s`. -/
theorem mem_closure_finset_iff_exists_int_coeffs (S : Finset M) (x : M) :
    x ∈ AddSubgroup.closure (S : Set M) ↔ ∃ c : S → ℤ, x = ∑ s : S, c s • (s : M) := by
  classical
  refine ⟨fun hx => ?_, fun ⟨c, hc⟩ => ?_⟩
  · -- `x` lies in the generated subgroup: build the coefficients by closure induction.
    let q : M → Prop := fun y => ∃ c : S → ℤ, y = ∑ s : S, c s • (s : M)
    have hq : ∀ y ∈ AddSubgroup.closure (S : Set M), q y := by
      intro y hy
      induction hy using AddSubgroup.closure_induction with
      | mem z hz =>
          -- a generator is the combination with a single coefficient `1`
          refine ⟨fun s => if s = (⟨z, hz⟩ : S) then 1 else 0, ?_⟩
          symm
          rw [Finset.sum_eq_single (⟨z, hz⟩ : S) (by intro b _ hb; simp [hb])
            (by intro h; exact absurd (Finset.mem_univ _) h)]
          simp
      | zero => exact ⟨0, by simp⟩
      | add a b _ _ iha ihb =>
          obtain ⟨c₁, h₁⟩ := iha
          obtain ⟨c₂, h₂⟩ := ihb
          refine ⟨c₁ + c₂, ?_⟩
          show a + b = ∑ s : S, (c₁ s + c₂ s) • (s : M)
          simp only [add_smul, Finset.sum_add_distrib]
          rw [← h₁, ← h₂]
      | neg a _ iha =>
          obtain ⟨c₁, h₁⟩ := iha
          refine ⟨-c₁, ?_⟩
          show -a = ∑ s : S, (-(c₁ s)) • (s : M)
          simp only [neg_smul, Finset.sum_neg_distrib]
          rw [← h₁]
    exact hq x hx
  · -- conversely an integral combination is a sum of integer multiples of generators
    rw [hc]
    exact AddSubgroup.sum_mem _
      (fun s _ => AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure s.2) (c s))

end General

/-- **Virtual characters are the integral linear combinations of irreducible characters.**

`IsVChar f` holds iff `f` can be written as `∑ χ, c χ • χ` with integer coefficients
`c` indexed by the irreducible characters `Irr G`. -/
theorem isVChar_iff_exists_int_coeffs {G : Type*} [Group G] [Fintype G] {f : G → ℂ} :
    IsVChar f ↔ ∃ c : ↥(Irr G) → ℤ, f = ∑ χ : ↥(Irr G), (c χ : ℂ) • (χ : G → ℂ) := by
  rw [IsVChar, mem_closure_finset_iff_exists_int_coeffs (Irr G) f]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    rw [hc]
    exact Finset.sum_congr rfl fun χ _ => by rw [Int.cast_smul_eq_zsmul]
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    rw [hc]
    exact Finset.sum_congr rfl fun χ _ => by rw [Int.cast_smul_eq_zsmul]

end Work.CharCore
