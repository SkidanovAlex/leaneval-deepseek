/-!
# `Work.CharCore.Defs`: irreducible complex characters of a finite group

Base module of the character-theory core (area A5) of the Feit–Thompson drive.

Conventions (shared with the other areas):

* characters are functions `G → ℂ`, with inner product `Work.CharCore.cfInner`,
  `(1/|G|) ∑_x f x * conj (g x)` (definitionally the same as `Work.CharLib.cfInner` when
  `G : Type`);
* `Work.CharCore.Irr G : Finset (G → ℂ)` is the finset of irreducible complex characters:
  the characters of the irreducible complex representations of `G`.  It is built from a
  finite family of simple submodules of the regular module `ℂ[G]` which is independent and
  spans `ℂ[G]` (such a family exists since `ℂ[G]` is semisimple by Maschke's theorem); the
  lemma `Work.CharCore.irreducible_character_mem_Irr` shows that every irreducible character
  occurs, and `Work.CharCore.mem_Irr_iff_irreducible` gives the full characterisation;
* `Work.CharCore.IsChar` is the additive monoid generated by `Irr G` (honest characters)
  and `Work.CharCore.IsVChar` the additive group it generates (virtual characters).

Everything is universe-polymorphic and stated with `[Fintype G]`; pass to it with
`Fintype.ofFinite` if only `[Finite G]` is available.
-/

noncomputable section

open Classical

namespace Work.CharCore

variable {G : Type*} [Group G] [Fintype G]

/-- The normalised inner product of two complex valued functions on a finite group,
`(1/|G|) ∑_x f x * conj (g x)`.  It is linear in the first argument and conjugate linear in
the second. -/
noncomputable def cfInner (f g : G → ℂ) : ℂ :=
  (Fintype.card G : ℂ)⁻¹ * ∑ x, f x * starRingEnd ℂ (g x)

/-- `f` is a class function on `G`. -/
def IsClassFun (f : G → ℂ) : Prop := ∀ g h : G, f (h * g * h⁻¹) = f g

/-- Restriction of a function on `G` to a subgroup, as a function on the subgroup. -/
def resFun (H : Subgroup G) (f : G → ℂ) : H → ℂ := fun h => f h

/-- The induced class function of a function on a subgroup, in the classical trace form
`Ind_H^G f g = |H|⁻¹ ∑_{x : x g x⁻¹ ∈ H} f (x g x⁻¹)`. -/
noncomputable def indFun (H : Subgroup G) (f : H → ℂ) : G → ℂ :=
  fun g => (Nat.card H : ℂ)⁻¹ *
    ∑ x : G, if hx : x * g * x⁻¹ ∈ H then f ⟨x * g * x⁻¹, hx⟩ else 0

/-- The complex group algebra of `G`. -/
abbrev groupAlgebra (G : Type*) [Group G] := MonoidAlgebra ℂ G

/-- A finite family of simple submodules of the regular module `ℂ[G]` which is independent
and spans `ℂ[G]`. -/
theorem exists_irrSubmodules (G : Type*) [Group G] [Fintype G] :
    ∃ s : Finset (Submodule (groupAlgebra G) (groupAlgebra G)),
      sSupIndep ((s : Set (Submodule (groupAlgebra G) (groupAlgebra G)))) ∧
      sSup ((s : Set (Submodule (groupAlgebra G) (groupAlgebra G)))) = ⊤ ∧
      ∀ N ∈ s, IsSimpleModule (groupAlgebra G) N := by
  obtain ⟨s, hss, hsup, hsimple⟩ :=
    IsSemisimpleModule.exists_sSupIndep_sSup_simples_eq_top (groupAlgebra G) (groupAlgebra G)
  have hfin : s.Finite := WellFoundedGT.finite_of_sSupIndep hss
  refine ⟨hfin.toFinset, by simpa using hss, by simpa using hsup, fun N hN => ?_⟩
  exact hsimple N (by simpa using hN)

/-- A chosen finite family of simple submodules of the regular module `ℂ[G]`, independent,
spanning `ℂ[G]`. -/
noncomputable def irrSubmodules (G : Type*) [Group G] [Fintype G] :
    Finset (Submodule (groupAlgebra G) (groupAlgebra G)) :=
  Classical.choose (exists_irrSubmodules G)

theorem sSupIndep_irrSubmodules (G : Type*) [Group G] [Fintype G] :
    sSupIndep ((irrSubmodules G : Set (Submodule (groupAlgebra G) (groupAlgebra G)))) :=
  (Classical.choose_spec (exists_irrSubmodules G)).1

theorem sSup_irrSubmodules (G : Type*) [Group G] [Fintype G] :
    sSup ((irrSubmodules G : Set (Submodule (groupAlgebra G) (groupAlgebra G)))) = ⊤ :=
  (Classical.choose_spec (exists_irrSubmodules G)).2.1

theorem isSimpleModule_of_mem_irrSubmodules (N : Submodule (groupAlgebra G) (groupAlgebra G))
    (hN : N ∈ irrSubmodules G) : IsSimpleModule (groupAlgebra G) N :=
  (Classical.choose_spec (exists_irrSubmodules G)).2.2 N hN

/-- The representation of `G` on a submodule of the regular module `ℂ[G]`. -/
noncomputable def submoduleRep (N : Submodule (groupAlgebra G) (groupAlgebra G)) :
    Representation ℂ G N :=
  Representation.ofModule' (k := ℂ) (G := G) (M := N)

/-- **The irreducible complex characters of `G`**, as a finset of functions `G → ℂ`. -/
noncomputable def Irr (G : Type*) [Group G] [Fintype G] : Finset (G → ℂ) :=
  (irrSubmodules G).image fun N => (submoduleRep N).character

/-- `f` is a character of `G`: it lies in the additive monoid generated by the irreducible
characters. -/
def IsChar (f : G → ℂ) : Prop :=
  f ∈ AddSubmonoid.closure ((Irr G : Finset (G → ℂ)) : Set (G → ℂ))

/-- `f` is a virtual (integral) character of `G`: it lies in the additive group generated by
the irreducible characters. -/
def IsVChar (f : G → ℂ) : Prop :=
  f ∈ AddSubgroup.closure ((Irr G : Finset (G → ℂ)) : Set (G → ℂ))

/-- The degree `χ 1` of a function `G → ℂ`, read as a natural number (and `0` if the value
at `1` is not a natural number).  For irreducible characters this is the dimension of the
corresponding representation. -/
noncomputable def irrDeg (χ : G → ℂ) : ℕ :=
  if h : ∃ d : ℕ, χ 1 = (d : ℂ) then Classical.choose h else 0


/-- The character of the regular representation of `G`: it takes the value `|G|` at `1` and
`0` elsewhere. -/
noncomputable def regularChar (G : Type*) [Group G] [Fintype G] : G → ℂ :=
  fun g => if g = 1 then (Nat.card G : ℂ) else 0

/-- The kernel of a character, as a set: `{g | χ g = χ 1}`. -/
def charKernel (χ : G → ℂ) : Set G := {g | χ g = χ 1}

end Work.CharCore
