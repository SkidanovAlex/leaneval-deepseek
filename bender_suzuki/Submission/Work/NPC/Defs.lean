/-
Area A9 of the Feit--Thompson (odd order theorem) drive: **normal `p`-complement theorems**.

This file contains only the definitions of the area (the API and the main theorems live in
the files `Submission/Work/NPC/Basic.lean`, `Submission/Work/NPC/Frobenius/*.lean`,
`Submission/Work/NPC/Thompson/*.lean`).

## Main definitions

* `Work.NPC.IsNormalPComplement p N` : `N` is a normal `p`-complement of `G`, i.e. `N ⊴ G`,
  `|N|` is coprime to `p` and the quotient `G ⧸ N` is a `p`-group.
* `Work.NPC.HasNormalPComplement p G` : `G` has a normal `p`-complement (also abbreviated
  `Work.NPC.HasNPC p G`).
* `Work.NPC.IsConjPGroup p Q` : the group `N_G(Q)/C_G(Q)` of automorphisms of `Q` induced by
  conjugation by elements of `G` is a `p`-group.  This is the hypothesis of Frobenius'
  normal `p`-complement theorem, and the conclusion of the third equivalent formulation.
* `Work.NPC.HasFrobeniusCondition p G` : Frobenius' hypothesis, `N_G(Q)/C_G(Q)` is a `p`-group
  for every non-identity `p`-subgroup `Q ≤ G`.
* `Work.NPC.thompsonJ P` : Thompson's subgroup `J(P)`, the subgroup generated by the abelian
  subgroups of `P` of maximal order.
* `Work.NPC.centerOf P` : the center of `P`, as a subgroup of the ambient group.
* `Work.NPC.ZJ P` : `Z(J(P))`, the centre of `J(P)`.

These definitions are also provided under the `FT` namespace (aliases at the end of the file)
so that other areas of the project can use the shared naming convention.
-/
import Mathlib
import Submission.Work.PGroup.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

noncomputable section

open scoped Pointwise

namespace Work.NPC

variable {G : Type*} [Group G]

/-- `N` is a **normal `p`-complement** of the group `G`: `N` is normal in `G`, its order is
coprime to `p`, and the quotient `G ⧸ N` is a `p`-group.  For a finite group `G` and a prime `p`
this says that `N` is a normal Hall `p'`-subgroup of `G` (`G` is `p`-nilpotent with kernel `N`).

The order condition is stated as `Nat.Coprime (Nat.card N) p`, so that the definition makes sense
(in the vacuous way) without a primality hypothesis; all theorems about it assume `p` prime. -/
structure IsNormalPComplement (p : ℕ) (N : Subgroup G) : Prop where
  /-- The complement is a normal subgroup. -/
  normal : N.Normal
  /-- The order of the complement is coprime to `p`. -/
  coprime_card : (Nat.card N).Coprime p
  /-- The quotient by the complement is a `p`-group. -/
  isPGroup_quotient : IsPGroup p (G ⧸ N)

/-- `G` has a **normal `p`-complement**. -/
def HasNormalPComplement (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ N : Subgroup G, IsNormalPComplement p N

/-- `HasNPC p G` is shorthand for `HasNormalPComplement p G`. -/
abbrev HasNPC (p : ℕ) (G : Type*) [Group G] : Prop := HasNormalPComplement p G

/-- `IsConjPGroup p Q` : the quotient `N_G(Q) ⧸ C_G(Q)` (the group of automorphisms of `Q`
induced by conjugation by elements of `G`) is a `p`-group. -/
def IsConjPGroup (p : ℕ) (Q : Subgroup G) : Prop :=
  IsPGroup p (Subgroup.normalizer (Q : Set G) ⧸
    (Subgroup.centralizer (Q : Set G)).subgroupOf (Subgroup.normalizer (Q : Set G)))

/-- **Frobenius' hypothesis**: for every non-identity `p`-subgroup `Q ≤ G`, the group
`N_G(Q)/C_G(Q)` is a `p`-group. -/
def HasFrobeniusCondition (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∀ Q : Subgroup G, IsPGroup p Q → Q ≠ ⊥ → IsConjPGroup p Q

/-- **Thompson's subgroup** `J(P)`: the subgroup generated by the abelian subgroups of `P`
of maximal order.

This is `Work.PGroup.thompsonJ` (area A4 of the project, the canonical definition of `J(P)` in
this workspace): the subgroup generated by all abelian `A ≤ P` with `Nat.card A = maxAbelianOrder P`.
It is exposed here under the `Work.NPC` namespace because every statement of the normal
`p`-complement area is phrased through it. -/
abbrev thompsonJ (P : Subgroup G) : Subgroup G := Work.PGroup.thompsonJ P

/-- The centre of a subgroup `P`, viewed as a subgroup of the ambient group: this is
`Work.PGroup.centerIn P = (Subgroup.center P).map P.subtype`. -/
abbrev centerOf (P : Subgroup G) : Subgroup G := Work.PGroup.centerIn P

/-- `Z(J(P))`, the centre of Thompson's subgroup, as a subgroup of the ambient group
(`Work.PGroup.ZJ`). -/
abbrev ZJ (P : Subgroup G) : Subgroup G := Work.PGroup.ZJ P

end Work.NPC

/- Aliases in the shared `FT` namespace used throughout the project. -/
namespace FT

abbrev IsNormalPComplement {G : Type*} [Group G] (p : ℕ) (N : Subgroup G) : Prop :=
  Work.NPC.IsNormalPComplement p N

abbrev HasNormalPComplement (p : ℕ) (G : Type*) [Group G] : Prop :=
  Work.NPC.HasNormalPComplement p G

abbrev HasNPC (p : ℕ) (G : Type*) [Group G] : Prop := Work.NPC.HasNormalPComplement p G

abbrev IsConjPGroup {G : Type*} [Group G] (p : ℕ) (Q : Subgroup G) : Prop :=
  Work.NPC.IsConjPGroup p Q

abbrev HasFrobeniusCondition (p : ℕ) (G : Type*) [Group G] : Prop :=
  Work.NPC.HasFrobeniusCondition p G

abbrev thompsonJ {G : Type*} [Group G] (P : Subgroup G) : Subgroup G := Work.NPC.thompsonJ P

abbrev centerOf {G : Type*} [Group G] (P : Subgroup G) : Subgroup G := Work.NPC.centerOf P

abbrev ZJ {G : Type*} [Group G] (P : Subgroup G) : Subgroup G := Work.NPC.ZJ P

end FT
