/-
Area A9 (normal `p`-complement theorems): a conjugacy-closed Sylow subgroup gives a normal
`p`-complement.

## The mathematics

`Work.NPC.Frobenius.npc_of_conjugacyClosed_sylow` is the theorem of Burnside/Frobenius which is
equivalent (by the focal subgroup theorem and Frobenius' normal `p`-complement theorem) to

> `G` has a normal `p`-complement  ⇔  a Sylow `p`-subgroup of `G` controls its own fusion in `G`.

The proof given here is Isaacs' short argument (*Finite Group Theory*, Theorem 5.25), which does
not need the full transfer/Frobenius machinery:

* Let `M = O^p(G)` be the subgroup generated by the elements of `G` whose order is coprime to `p`
  (the `p'`-elements); it is normal in `G` and `G ⧸ M` is a `p`-group
  (`Work.NPC.Frobenius.pResidual_normal`, `...isPGroup_quotient_pResidual`).

* Let `P` be a Sylow `p`-subgroup controlling its own fusion, and let `S` be the Sylow
  `p`-subgroup `M ⊓ P` of `M` (`...exists_sylow_subgroupOf_inf`).  Since `M` is generated by its
  `p'`-elements, `S` lies in the commutator subgroup of `M`
  (`...sylow_le_commutator_of_generated`); by the focal subgroup theorem for `M` this means that
  `S` is generated by its "focal generators", i.e. commutators `⁅a, u⁆` with `a ∈ S`, `u ∈ M` and
  `⁅a, u⁆ ∈ S`.

* For such a generator, the element `u a u⁻¹` is an element of `S ≤ P` conjugate in `G` to
  `a ∈ P`, so by hypothesis it is conjugate to `a` inside `P`: `u a u⁻¹ = c a c⁻¹` with `c ∈ P`.
  Hence `⁅a, u⁆ = ⁅a, c⁆ ∈ ⁅M ⊓ P, P⁆` and consequently `M ⊓ P ≤ ⁅M ⊓ P, P⁆`.

* `M ⊓ P ⊴ P` (as `M ⊴ G`), so `⁅M ⊓ P, P⁆ ≤ M ⊓ P`; therefore
  `M ⊓ P = ⁅M ⊓ P, P⁆ = ⁅M ⊓ P, P, P, … , P⁆`, an iterated commutator with an arbitrary number of
  copies of `P`.  Since `P` is nilpotent (a `p`-group) its lower central series eventually
  vanishes, so `M ⊓ P = ⊥`.

* Finally the quotient map `G →* G ⧸ M` has `p`-group target and is injective on `P`
  (because `P ⊓ M = ⊥`), so by the transfer engine
  `Work.NPC.hasNormalPComplement_of_hom_to_pGroup` the group `G` has a normal `p`-complement.
-/
import Mathlib
import Submission.Work.NPC.Defs
import Submission.Work.NPC.Engine
import Submission.Work.NPC.Fusion
import Submission.Work.NPC.Frobenius.PResidual
import Submission.Work.NPC.Frobenius.pResidual_closure_self
import Submission.Work.NPC.Frobenius.isPGroup_quotient_pResidual
import Submission.Work.NPC.Frobenius.exists_sylow_subgroupOf_inf
import Submission.Work.NPC.Frobenius.sylow_le_commutator_of_generated

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Pointwise commutatorElement

namespace Work.NPC.Frobenius

variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- **Key step.**  If `P` is a Sylow `p`-subgroup of `G` controlling its own fusion in `G`, then
`O^p(G) ⊓ P = ⊥`, where `O^p(G)` is the subgroup of `G` generated by its `p'`-elements. -/
theorem pResidual_inf_sylow_eq_bot (P : Sylow p G)
    (h : ∀ x y : ↥(P : Subgroup G), IsConj (x : G) (y : G) → IsConj x y) :
    pResidual p G ⊓ (P : Subgroup G) = ⊥ := by
  classical
  set M : Subgroup G := pResidual p G with hM
  haveI hMnormal : M.Normal := pResidual_normal p
  -- a Sylow `p`-subgroup `S` of `M`, namely `M ⊓ P`
  obtain ⟨S, hS⟩ := exists_sylow_subgroupOf_inf (p := p) P (M := M)
  -- `M` is generated by its `p'`-elements, so `S` lies in the commutator subgroup of `M`
  have hgen : Subgroup.closure {y : M | ¬ p ∣ orderOf y} = ⊤ := pResidual_closure_self p
  have hScomm : (S : Subgroup M) ≤ _root_.commutator M :=
    sylow_le_commutator_of_generated S hgen
  -- hence the focal subgroup of `S` (in `M`) is all of `S`
  have hSfoc : S.focalSubgroup = (S : Subgroup M) := by
    rw [← Subgroup.commutator_inf_eq_focalSubgroup S, inf_eq_right.mpr hScomm]
  -- every element of `S`, viewed in `G`, lies in `⁅M ⊓ P, P⁆`
  let T : Subgroup M := (⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆).comap M.subtype
  have hT : S.focalSubgroup ≤ T := by
    rw [Subgroup.focalSubgroup_def]
    refine (Subgroup.closure_le T).mpr ?_
    rintro w ⟨hwS, a, haS, u, rfl⟩
    have haQ : (a : G) ∈ M ⊓ (P : Subgroup G) := by
      have h1 : a ∈ (M ⊓ (P : Subgroup G)).subgroupOf M := by rw [← hS]; exact haS
      exact Subgroup.mem_subgroupOf.mp h1
    have hwQ : ((⁅a, u⁆ : M) : G) ∈ M ⊓ (P : Subgroup G) := by
      have h1 : (⁅a, u⁆ : M) ∈ (M ⊓ (P : Subgroup G)).subgroupOf M := by rw [← hS]; exact hwS
      exact Subgroup.mem_subgroupOf.mp h1
    have hcoe : ((⁅a, u⁆ : M) : G) = ⁅(a : G), (u : G)⁆ := map_commutatorElement M.subtype a u
    rw [hcoe] at hwQ
    set A : G := (a : G) with hA
    set U : G := (u : G) with hU
    -- `U * A * U⁻¹ ∈ M ⊓ P`, because `⁅A, U⁆ ∈ M ⊓ P` and `M ⊓ P` is a subgroup
    have hAU : ⁅A, U⁆ ∈ M ⊓ (P : Subgroup G) := hwQ
    have hAinv : A⁻¹ ∈ M ⊓ (P : Subgroup G) := (M ⊓ (P : Subgroup G)).inv_mem haQ
    have hconj1 : A⁻¹ * ⁅A, U⁆ * A ∈ M ⊓ (P : Subgroup G) :=
      (M ⊓ (P : Subgroup G)).mul_mem ((M ⊓ (P : Subgroup G)).mul_mem hAinv hAU) haQ
    have h2 : A⁻¹ * ⁅A, U⁆ * A = U * A⁻¹ * U⁻¹ * A := by
      rw [commutatorElement_def]; group
    rw [h2] at hconj1
    have h3 : U * A⁻¹ * U⁻¹ ∈ M ⊓ (P : Subgroup G) := by
      have := (M ⊓ (P : Subgroup G)).mul_mem hconj1 hAinv
      simpa using this
    have hY : U * A * U⁻¹ ∈ M ⊓ (P : Subgroup G) := by
      have h4 : (U * A⁻¹ * U⁻¹)⁻¹ ∈ M ⊓ (P : Subgroup G) :=
        (M ⊓ (P : Subgroup G)).inv_mem h3
      have h5 : (U * A⁻¹ * U⁻¹)⁻¹ = U * A * U⁻¹ := by group
      rwa [h5] at h4
    -- `A` and `U * A * U⁻¹` are `G`-conjugate elements of `P`, hence `P`-conjugate
    have hconj : IsConj A (U * A * U⁻¹) := isConj_iff.mpr ⟨U, rfl⟩
    have hpconj : IsConj (⟨A, haQ.2⟩ : ↥(P : Subgroup G))
        (⟨U * A * U⁻¹, hY.2⟩ : ↥(P : Subgroup G)) :=
      h ⟨A, haQ.2⟩ ⟨U * A * U⁻¹, hY.2⟩ hconj
    obtain ⟨c, hc⟩ := isConj_iff.mp hpconj
    have hcg : ((c : ↥(P : Subgroup G)) : G) ∈ (P : Subgroup G) := (c : ↥(P : Subgroup G)).2
    have hYeq : U * A * U⁻¹
        = ((c : ↥(P : Subgroup G)) : G) * A * (((c : ↥(P : Subgroup G)) : G))⁻¹ := by
      have hh := (congrArg Subtype.val hc).symm
      simpa using hh
    have hfinal : ⁅A, U⁆ = ⁅A, ((c : ↥(P : Subgroup G)) : G)⁆ := by
      have h1 : ⁅A, ((c : ↥(P : Subgroup G)) : G)⁆ = A * (U * A * U⁻¹)⁻¹ := by
        rw [commutatorElement_def, hYeq]
        group
      rw [h1, commutatorElement_def]
      group
    show ((⁅a, u⁆ : M) : G) ∈ ⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆
    rw [hcoe, hfinal]
    exact Subgroup.commutator_mem_commutator haQ hcg
  have hQle : M ⊓ (P : Subgroup G) ≤ ⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆ := by
    intro z hz
    have hxS : (⟨z, hz.1⟩ : M) ∈ S := by
      have h1 : (⟨z, hz.1⟩ : M) ∈ (M ⊓ (P : Subgroup G)).subgroupOf M :=
        Subgroup.mem_subgroupOf.mpr hz
      rwa [← hS] at h1
    have hxf : (⟨z, hz.1⟩ : M) ∈ S.focalSubgroup := by rw [hSfoc]; exact hxS
    have hzT : (⟨z, hz.1⟩ : M) ∈ (⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆).subgroupOf M :=
      hT hxf
    exact Subgroup.mem_subgroupOf.mp hzT
  -- `M ⊓ P` is normal in `P`, so the commutator is contained in it
  have hQle' : ⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆ ≤ M ⊓ (P : Subgroup G) := by
    rw [Subgroup.commutator_le]
    intro q hq p hp
    have hqM : q ∈ M := hq.1
    have hp' : p⁻¹ ∈ (P : Subgroup G) := (P : Subgroup G).inv_mem hp
    have hq'' : p * q * p⁻¹ ∈ M ⊓ (P : Subgroup G) := by
      refine ⟨?_, ?_⟩
      · exact hMnormal.conj_mem q hqM p
      · exact (P : Subgroup G).mul_mem ((P : Subgroup G).mul_mem hp hq.2) hp'
    have hj : p⁻¹ * (p * q * p⁻¹) * p ∈ M ⊓ (P : Subgroup G) := by
      refine ⟨?_, ?_⟩
      · simpa using hMnormal.conj_mem (p * q * p⁻¹) hq''.1 p⁻¹
      · exact (P : Subgroup G).mul_mem ((P : Subgroup G).mul_mem hp' hq''.2) hp
    have h1 : p⁻¹ * (p * q * p⁻¹) * p * (p * q * p⁻¹)⁻¹ ∈ M ⊓ (P : Subgroup G) :=
      (M ⊓ (P : Subgroup G)).mul_mem hj ((M ⊓ (P : Subgroup G)).inv_mem hq'')
    have h2 : p⁻¹ * (p * q * p⁻¹) * p * (p * q * p⁻¹)⁻¹ = ⁅q, p⁆ := by
      rw [commutatorElement_def]; group
    rwa [h2] at h1
  have hQcomm : M ⊓ (P : Subgroup G) = ⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆ :=
    le_antisymm hQle hQle'
  -- `P` is nilpotent, so a high enough iterated commutator with `P` vanishes
  obtain ⟨n, hn⟩ := (Subgroup.isNilpotent_iff_lowerCentralSeries (P : Subgroup G)).mp
    (IsPGroup.isNilpotent P.isPGroup')
  have hseries : ∀ k : ℕ, M ⊓ (P : Subgroup G) ≤ (P : Subgroup G).lowerCentralSeries k := by
    intro k
    induction k with
    | zero => exact inf_le_right
    | succ k ih =>
        have hsucc : (P : Subgroup G).lowerCentralSeries (k + 1)
            = ⁅(P : Subgroup G).lowerCentralSeries k, (P : Subgroup G)⁆ := rfl
        rw [hsucc]
        calc M ⊓ (P : Subgroup G) = ⁅M ⊓ (P : Subgroup G), (P : Subgroup G)⁆ := hQcomm
          _ ≤ ⁅(P : Subgroup G).lowerCentralSeries k, (P : Subgroup G)⁆ :=
              Subgroup.commutator_mono ih le_rfl
  have := hseries n
  rw [hn] at this
  exact le_bot_iff.mp this

theorem npc_of_conjugacyClosed_sylow {G : Type*} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (P : Sylow p G)
    (h : ∀ x y : ↥(P : Subgroup G), IsConj (x : G) (y : G) → IsConj x y) :
    Work.NPC.HasNormalPComplement p G := by
  have hMP : pResidual p G ⊓ (P : Subgroup G) = ⊥ := pResidual_inf_sylow_eq_bot P h
  -- the quotient map to the `p`-group `G ⧸ O^p(G)` is injective on `P`
  refine Work.NPC.hasNormalPComplement_of_hom_to_pGroup P (QuotientGroup.mk' (pResidual p G))
    (isPGroup_quotient_pResidual (G := G) (p := p)) ?_
  have hker : ((QuotientGroup.mk' (pResidual p G)).domRestrict (P : Subgroup G)).ker
      = (pResidual p G).subgroupOf (P : Subgroup G) := by
    change ((QuotientGroup.mk' (pResidual p G)).comp (P : Subgroup G).subtype).ker = _
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
    rfl
  refine (MonoidHom.ker_eq_bot_iff _).mp ?_
  rw [hker, Subgroup.subgroupOf_eq_bot]
  exact disjoint_iff.mpr hMP

end Work.NPC.Frobenius
