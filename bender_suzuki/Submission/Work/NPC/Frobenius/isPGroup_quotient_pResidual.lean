import Mathlib
import Submission.Work.NPC.Frobenius.PResidual

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.NPC.Frobenius

/-- The quotient of a finite group by its `p`-residual `O^p(G)` (the subgroup generated by the
elements of order coprime to `p`) is a `p`-group.

Indeed, for `g : G` write `orderOf g = p ^ k * m` with `m` the `p'`-part of the order
(`k = padicValNat p (orderOf g)`, `m = divMaxPow (orderOf g) p`).  Then `g ^ p ^ k` has order
dividing `m`, hence coprime to `p`, so `g ^ p ^ k` lies in the residual; thus the class of `g`
in the quotient is killed by the `p`-power `p ^ k`. -/
theorem isPGroup_quotient_pResidual {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime] :
    IsPGroup p (G ⧸ pResidual p G) := by
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  intro x
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (pResidual p G) x
  refine ⟨padicValNat p (orderOf g), ?_⟩
  -- the order of `g` is nonzero, as `G` is finite
  have hd : orderOf g ≠ 0 := by
    have hpos : 0 < orderOf g := Nat.pos_of_dvd_of_pos (orderOf_dvd_natCard g) Nat.card_pos
    exact hpos.ne'
  -- `orderOf g = p ^ k * m` with `m` the `p'`-part of the order
  have hmul : p ^ padicValNat p (orderOf g) * (orderOf g).divMaxPow p = orderOf g :=
    Nat.pow_padicValNat_mul_divMaxPow p (orderOf g)
  -- hence `g ^ p ^ k` has order dividing `m`
  have hpow : (g ^ p ^ padicValNat p (orderOf g)) ^ ((orderOf g).divMaxPow p) = 1 := by
    rw [← pow_mul, hmul, pow_orderOf_eq_one]
  have hdiv : orderOf (g ^ p ^ padicValNat p (orderOf g)) ∣ (orderOf g).divMaxPow p :=
    orderOf_dvd_iff_pow_eq_one.mpr hpow
  -- and `m` is coprime to `p`, so `g ^ p ^ k` is a `p'`-element, i.e. lies in the residual
  have hnp : ¬ p ∣ (orderOf g).divMaxPow p := Nat.not_dvd_divMaxPow hp1 hd
  have hnp' : ¬ p ∣ orderOf (g ^ p ^ padicValNat p (orderOf g)) :=
    fun h => hnp (h.trans hdiv)
  have hmem : g ^ p ^ padicValNat p (orderOf g) ∈ pResidual p G :=
    Subgroup.subset_closure hnp'
  -- so the class of `g` is killed by the `p`-power `p ^ k`
  rw [← map_pow]
  exact (QuotientGroup.eq_one_iff _).mpr hmem

end Work.NPC.Frobenius
