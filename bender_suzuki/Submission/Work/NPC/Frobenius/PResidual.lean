/-
Auxiliary definitions for the proof that a group with a conjugacy-closed Sylow `p`-subgroup has a
normal `p`-complement (`Work.NPC.Frobenius.npc_of_conjugacyClosed_sylow`).

The key object is the subgroup `O^p(G)` of `G`, the smallest normal subgroup with `p`-group
quotient; equivalently (and that is the definition used here) the subgroup generated by the
elements of `G` whose order is coprime to `p` (the `p'`-elements).
-/
import Mathlib
import Submission.Work.NPC.Defs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.NPC.Frobenius

variable {G : Type*} [Group G]

/-- `pResidual p G` is the subgroup generated by the elements of `G` whose order is coprime to
`p` (the `p'`-elements of `G`).  Equivalently, it is the smallest normal subgroup `N` of `G` such
that `G ⧸ N` is a `p`-group; this is the subgroup usually denoted `O^p(G)`. -/
def pResidual (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | ¬ p ∣ orderOf x}

variable (p : ℕ)

/-- The subgroup generated by the `p'`-elements is normal: conjugation preserves the order of an
element. -/
theorem pResidual_normal : (pResidual p G).Normal := by
  refine Subgroup.Normal.mk ?_
  intro x hx g
  refine Subgroup.closure_induction (p := fun y _ => g * y * g⁻¹ ∈ pResidual p G) ?_ ?_ ?_ ?_ hx
  · intro y hy
    rw [← MulAut.conj_apply]
    refine Subgroup.subset_closure ?_
    have ho : orderOf ((MulAut.conj g) y) = orderOf y :=
      orderOf_injective ((MulAut.conj g : G ≃* G) : G →* G) (MulAut.conj g).injective y
    change ¬ p ∣ orderOf ((MulAut.conj g) y)
    rw [ho]
    exact hy
  · simp
  · intro y z hy hz ihy ihz
    have heq : g * (y * z) * g⁻¹ = (g * y * g⁻¹) * (g * z * g⁻¹) := by group
    rw [heq]
    exact (pResidual p G).mul_mem ihy ihz
  · intro y hy ihy
    have heq : g * y⁻¹ * g⁻¹ = (g * y * g⁻¹)⁻¹ := by group
    rw [heq]
    exact (pResidual p G).inv_mem ihy

/-- Instance form of `pResidual_normal`, so that the quotient notation `G ⧸ pResidual p G`
works. -/
instance instNormalPResidual : (pResidual p G).Normal := pResidual_normal p

end Work.NPC.Frobenius
