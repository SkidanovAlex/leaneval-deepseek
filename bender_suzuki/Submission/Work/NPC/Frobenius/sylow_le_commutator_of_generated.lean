/-
Auxiliary lemmas for `Work.NPC.Frobenius.sylow_le_commutator_of_generated`.

The mathematical content is the following.  Let `p` be a prime.  The subgroup generated by the
elements of a group `G` whose order is coprime to `p` is denoted `O^p(G)` (here `pResidual p G`).
The theorem says: if `O^p(G) = ⊤`, that is, `G` is generated by its `p'`-elements, then every
Sylow `p`-subgroup of `G` is contained in the commutator subgroup `G'`.

Indeed, `G ⧸ G'` is abelian and is generated by the images of the `p'`-elements, which again have
order coprime to `p`; in a commutative group a product of elements of `p'`-order has `p'`-order, so
each element of `G ⧸ G'` has order coprime to `p`.  Hence the image of a Sylow `p`-subgroup, being a
`p`-group, is trivial, i.e. the Sylow subgroup lies in `G'`.
-/
import Mathlib
import Submission.Work.NPC.Frobenius.PResidual

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.NPC.Frobenius

/-- In a commutative group, the product of two elements whose orders are not divisible by the
prime `p` again has order not divisible by `p`. -/
lemma not_dvd_orderOf_mul {A : Type*} [CommGroup A] {p : ℕ} (hp : p.Prime) {x y : A}
    (hx : ¬ p ∣ orderOf x) (hy : ¬ p ∣ orderOf y) : ¬ p ∣ orderOf (x * y) := by
  intro h
  have hdvd : orderOf (x * y) ∣ Nat.lcm (orderOf x) (orderOf y) :=
    (Commute.all x y).orderOf_mul_dvd_lcm
  rcases (hp.dvd_lcm).mp (dvd_trans h hdvd) with h' | h'
  · exact hx h'
  · exact hy h'

/-- In a commutative group, every element of the subgroup generated by the elements of order
coprime to `p` itself has order coprime to `p`. -/
lemma not_dvd_orderOf_of_mem_closure {A : Type*} [CommGroup A] {p : ℕ} (hp : p.Prime) {z : A}
    (hz : z ∈ Subgroup.closure {x : A | ¬ p ∣ orderOf x}) : ¬ p ∣ orderOf z := by
  refine Subgroup.closure_induction (p := fun z _ => ¬ p ∣ orderOf z) ?_ ?_ ?_ ?_ hz
  · intro x hx
    exact hx
  · rw [orderOf_one]
    exact hp.not_dvd_one
  · intro x y _ _ ihx ihy
    exact not_dvd_orderOf_mul hp ihx ihy
  · intro x _ ihx
    rwa [orderOf_inv]

/-- If `a` has order not divisible by the prime `p` but `a` is a `p`-element, then `a = 1`. -/
lemma eq_one_of_not_dvd_orderOf_of_pow {A : Type*} [Group A] {p : ℕ} (hp : p.Prime) {a : A}
    {k : ℕ} (h : ¬ p ∣ orderOf a) (hk : a ^ (p ^ k) = 1) : a = 1 := by
  have hdvd : orderOf a ∣ p ^ k := orderOf_dvd_of_pow_eq_one hk
  obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow hp).mp hdvd
  cases j with
  | zero => exact orderOf_eq_one_iff.mp (by simpa using hj)
  | succ j' =>
      exact absurd (hj ▸ ⟨p ^ j', pow_succ' p j'⟩) h

/-- **Sylow subgroups of a group generated by its `p'`-elements lie in the commutator subgroup.**

If a finite group `M` is generated by the elements whose order is not divisible by the prime `p`,
then every Sylow `p`-subgroup of `M` is contained in the commutator subgroup `⁅M,M⁆`.  Indeed the
abelian quotient `M ⧸ ⁅M,M⁆` is generated by elements of order coprime to `p`, so it has no
nontrivial `p`-torsion. -/
theorem sylow_le_commutator_of_generated {M : Type*} [Group M] [Finite M] {p : ℕ} [Fact p.Prime]
    (S : Sylow p M) (hgen : Subgroup.closure {y : M | ¬ p ∣ orderOf y} = ⊤) :
    (S : Subgroup M) ≤ _root_.commutator M := by
  have hp : p.Prime := Fact.out
  intro y hy
  rw [← Abelianization.ker_of (G := M), MonoidHom.mem_ker]
  -- It suffices to show that the image of `y` in the abelianization is trivial.
  have hy' : y ∈ Subgroup.closure {y : M | ¬ p ∣ orderOf y} := by rw [hgen]; trivial
  -- its order is coprime to `p`, because the abelianization is generated by `p'`-elements
  have hsub : (Abelianization.of : M →* Abelianization M) '' {y : M | ¬ p ∣ orderOf y}
      ⊆ {x : Abelianization M | ¬ p ∣ orderOf x} := by
    rintro z ⟨w, hw, rfl⟩
    exact fun hc => hw (dvd_trans hc (orderOf_map_dvd (Abelianization.of : M →* Abelianization M) w))
  have hpos : ¬ p ∣ orderOf (Abelianization.of y) := by
    refine not_dvd_orderOf_of_mem_closure hp (Subgroup.closure_mono hsub ?_)
    have hmem : Abelianization.of y ∈
        Subgroup.map (Abelianization.of : M →* Abelianization M)
          (Subgroup.closure {y : M | ¬ p ∣ orderOf y}) := ⟨y, hy', rfl⟩
    rwa [MonoidHom.map_closure] at hmem
  -- while it is also a `p`-element, being the image of an element of the Sylow subgroup
  obtain ⟨k, hk⟩ := Sylow.isPGroup' S ⟨y, hy⟩
  have hkM : y ^ (p ^ k) = 1 := by
    have := congrArg (fun z : ↥(S : Subgroup M) => (z : M)) hk
    simpa using this
  exact eq_one_of_not_dvd_orderOf_of_pow hp hpos (by rw [← map_pow, hkM, map_one])

end Work.NPC.Frobenius
