/-
Area A3 (coprime action): the *internal* setting.

Downstream (Bender–Glauberman, Feit–Thompson local analysis) works with two subgroups `A, G ≤ X`
where `A` normalizes `G`, and lets `A` act on `G` by conjugation.  This file provides that action
(`FT.Normalizes`, `FT.conjSmul`, `FT.conjAction`, registered as instances) and the translation
lemmas identifying the abstract notions of `Submission/Work/Coprime/Defs.lean` with the internal
ones:

* `FT.map_fixedPoints_conjAction` : `C_G(A)` (abstract) is `C_X(A) ⊓ G` (internal);
* `FT.commutator_conjAction`      : `[G, A]` (abstract) is the internal commutator `⁅A, G⁆` of
  subgroups.  Note the convention: `FT.commutator A ⊤` is generated by the elements
  `x⁻¹ * (a • x)`, which for the conjugation action are the commutators `⁅x⁻¹, a⁆`.
-/
import Submission.Work.Coprime.Defs
import Submission.Work.Coprime.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false

open scoped Pointwise
open scoped commutatorElement

namespace FT

variable {X : Type*} [Group X]

/-- `A` normalizes the subgroup `G`.  A class, so that the conjugation action of `A` on `G` can be
found by typeclass search. -/
class Normalizes (A G : Subgroup X) : Prop where
  le_normalizer : A ≤ Subgroup.normalizer (G : Set X)

/-- The conjugation of `x ∈ G` by `a ∈ A` (for `A` normalizing `G`). -/
def conjSmul (A G : Subgroup X) (hA : A ≤ Subgroup.normalizer (G : Set X)) (a : A) (x : G) : G :=
  ⟨(a : X) * (x : X) * (a : X)⁻¹,
    (Subgroup.mem_normalizer_iff.mp (hA a.2) (x : X)).mp x.2⟩

@[simp]
theorem conjSmul_coe (A G : Subgroup X) (hA : A ≤ Subgroup.normalizer (G : Set X))
    (a : A) (x : G) : ((conjSmul A G hA a x : G) : X) = (a : X) * (x : X) * (a : X)⁻¹ := rfl

/-- The conjugation action of a subgroup `A ≤ X` on a subgroup `G ≤ X` which it normalizes. -/
instance instConjMulDistribMulAction (A G : Subgroup X) [Normalizes A G] :
    MulDistribMulAction A G where
  smul := conjSmul A G (Normalizes.le_normalizer (X := X))
  one_smul x := by
    change conjSmul A G (Normalizes.le_normalizer (X := X)) 1 x = x
    exact Subtype.ext (by simp [conjSmul])
  mul_smul a b x := by
    change conjSmul A G (Normalizes.le_normalizer (X := X)) (a * b) x =
      conjSmul A G (Normalizes.le_normalizer (X := X)) a
        (conjSmul A G (Normalizes.le_normalizer (X := X)) b x)
    exact Subtype.ext (by simp [conjSmul, mul_assoc])
  smul_one a := by
    change conjSmul A G (Normalizes.le_normalizer (X := X)) a 1 = 1
    exact Subtype.ext (by simp [conjSmul])
  smul_mul a x y := by
    change conjSmul A G (Normalizes.le_normalizer (X := X)) a (x * y) =
      conjSmul A G (Normalizes.le_normalizer (X := X)) a x *
        conjSmul A G (Normalizes.le_normalizer (X := X)) a y
    exact Subtype.ext (by simp [conjSmul, mul_assoc])

@[simp]
theorem conj_smul_coe (A G : Subgroup X) [Normalizes A G] (a : A) (x : G) :
    ((a • x : G) : X) = (a : X) * (x : X) * (a : X)⁻¹ := rfl

/-- `C_G(A)` for the conjugation action, viewed inside `X`, is the centralizer of `A` in `X`
intersected with `G`. -/
theorem map_fixedPoints_conjAction (A G : Subgroup X) [Normalizes A G] :
    (fixedPoints A G).map G.subtype = Subgroup.centralizer (A : Set X) ⊓ G := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨?_, y.2⟩
    show (y : X) ∈ Subgroup.centralizer (A : Set X)
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    have h1 : (⟨a, ha⟩ : A) • y = y := hy ⟨a, ha⟩
    have h2 : (a : X) * (y : X) * (a : X)⁻¹ = (y : X) := by
      simpa [conj_smul_coe] using congrArg (Subtype.val) h1
    calc (a : X) * (y : X) = (a : X) * (y : X) * (a : X)⁻¹ * (a : X) := by group
      _ = (y : X) * (a : X) := by rw [h2]
  · rintro ⟨hx, hxG⟩
    refine ⟨⟨x, hxG⟩, ?_, rfl⟩
    intro a
    refine Subtype.ext ?_
    have h1 : (a : X) * x = x * (a : X) := by
      have h2 := (Subgroup.mem_centralizer_iff.mp hx) (a : X) a.2
      simpa [eq_comm] using h2
    simp only [conj_smul_coe]
    rw [h1, mul_assoc, mul_inv_cancel, mul_one]

/-- The abstract commutator `[G, A]` of `Submission/Work/Coprime/Defs.lean`, for the conjugation
action of `A` on `G`, maps (under `G ↪ X`) to the internal commutator `⁅G, A⁆` of subgroups (the
order `G` first is the one for which `⁅g, a⁆` is a generator; the subgroup commutator is symmetric,
`⁅G, A⁆ = ⁅A, G⁆`). -/
theorem commutator_conjAction (A G : Subgroup X) [Normalizes A G] :
    (commutator A (⊤ : Subgroup G)).map G.subtype = ⁅G, A⁆ := by
  refine le_antisymm ?_ ?_
  · refine Subgroup.map_le_iff_le_comap.mpr ?_
    refine commutator_le fun a x _ => ?_
    show G.subtype (x⁻¹ * (a • x)) ∈ ⁅G, A⁆
    have h : G.subtype (x⁻¹ * (a • x)) = ⁅((x : X))⁻¹, (a : X)⁆ := by
      simp [conj_smul_coe, commutatorElement_def, mul_assoc]
    rw [h]
    exact Subgroup.commutator_mem_commutator (G.inv_mem x.2) a.2
  · refine (Subgroup.closure_le _).mpr ?_
    rintro y ⟨g, hg, a, ha, rfl⟩
    have hy : ((⟨g, hg⟩ : G)⁻¹)⁻¹ * ((⟨a, ha⟩ : A) • (⟨g, hg⟩ : G)⁻¹) ∈
        commutator A (⊤ : Subgroup G) :=
      Subgroup.subset_closure ⟨(⟨a, ha⟩ : A), (⟨g, hg⟩ : G)⁻¹, Subgroup.mem_top _, rfl⟩
    have hmap : G.subtype (((⟨g, hg⟩ : G)⁻¹)⁻¹ * ((⟨a, ha⟩ : A) • (⟨g, hg⟩ : G)⁻¹)) = ⁅g, a⁆ := by
      simp [conj_smul_coe, commutatorElement_def, mul_assoc]
    rw [← hmap]
    exact Subgroup.mem_map_of_mem G.subtype hy

/-- `A` acts trivially on `G` by conjugation iff `A` centralizes `G`. -/
theorem isTrivialOn_conjAction_iff (A G : Subgroup X) [Normalizes A G] :
    IsTrivialOn A G ↔ ∀ a ∈ A, ∀ g ∈ G, a * g = g * a := by
  constructor
  · intro h a ha g hg
    have h1 : (⟨a, ha⟩ : A) • (⟨g, hg⟩ : G) = ⟨g, hg⟩ := h ⟨a, ha⟩ ⟨g, hg⟩
    have h2 : (a : X) * (g : X) * (a : X)⁻¹ = (g : X) := by
      simpa [conj_smul_coe] using congrArg (Subtype.val) h1
    calc (a : X) * (g : X) = (a : X) * (g : X) * (a : X)⁻¹ * (a : X) := by group
      _ = (g : X) * (a : X) := by rw [h2]
  · intro h a g
    refine Subtype.ext ?_
    show (a : X) * (g : X) * (a : X)⁻¹ = (g : X)
    rw [h (a : X) a.2 (g : X) g.2]
    group

end FT
