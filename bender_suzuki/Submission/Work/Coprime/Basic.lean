/-
Area A3 (coprime action): first API layer on top of `Submission.Work.Coprime.Defs`.

Contains:
* the restricted action of `A` on an `A`-invariant subgroup;
* `FT.omega1 p G` (`Ω₁` of a `p`-group) and its `A`-invariance;
* the equivalence "`A` acts trivially on `G ⧸ N`" (`N` normal and `A`-invariant)
  ⟺ "`[G, A] ≤ N`";
* the easy inclusion `C_G(A)N/N ⊆ C_{G/N}(A)`.
-/
import Submission.Work.Coprime.Defs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false

open scoped Pointwise

namespace FT

variable {A : Type*} {G : Type*} [Group A] [Group G] [MulDistribMulAction A G]

/-! ## The action on an invariant subgroup -/

/-- The restricted action of `A` on an `A`-invariant subgroup `H ≤ G`. -/
instance instSubgroupMulDistribMulAction (H : Subgroup G) [IsInvariant A H] :
    MulDistribMulAction A H where
  smul a x := ⟨a • (x : G), IsInvariant.smul_mem (inferInstance : IsInvariant A H) a x.2⟩
  one_smul x := Subtype.ext (one_smul A (x : G))
  mul_smul a b x := Subtype.ext (mul_smul a b (x : G))
  smul_one a := Subtype.ext (smul_one a)
  smul_mul a x y := Subtype.ext (smul_mul' a (x : G) (y : G))

@[simp]
theorem coe_subgroup_smul {H : Subgroup G} [IsInvariant A H] (a : A) (x : H) :
    ((a • x : H) : G) = a • (x : G) := rfl

/-! ## `Ω₁` -/

/-- `Ω₁(P)`: the subgroup generated by the elements whose order divides `p`. -/
def omega1 (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | x ^ p = 1}

theorem mem_omega1 {p : ℕ} {x : G} (hx : x ^ p = 1) : x ∈ omega1 p G :=
  Subgroup.subset_closure hx

theorem omega1_le_iff {p : ℕ} {H : Subgroup G} :
    omega1 p G ≤ H ↔ ∀ x : G, x ^ p = 1 → x ∈ H :=
  (Subgroup.closure_le H).trans ⟨fun h x hx => h hx, fun h x hx => h x hx⟩

/-- `Ω₁(P)` is invariant under every automorphism of `G` preserving `p`. -/
instance instIsInvariantOmega1 (p : ℕ) : IsInvariant A (omega1 p G) := by
  refine IsInvariant.closure fun a => ?_
  refine Set.ext fun x => ?_
  rw [Set.mem_smul_set_iff_inv_smul_mem]
  show (a⁻¹ • x) ^ p = 1 ↔ x ^ p = 1
  rw [← smul_pow', inv_smul_eq_iff, smul_one]

/-! ## Triviality on a quotient -/

theorem isTrivialOn_quotient_iff (N : Subgroup G) [N.Normal] [IsInvariant A N] :
    IsTrivialOn A (G ⧸ N) ↔ commutator A (⊤ : Subgroup G) ≤ N := by
  constructor
  · intro h
    refine commutator_le fun a x _ => ?_
    have h1 : a • (x : G ⧸ N) = (x : G ⧸ N) := h a (x : G ⧸ N)
    rw [quotient_smul_mk] at h1
    have h2 : (a • x)⁻¹ * x ∈ N := QuotientGroup.eq.mp h1
    simpa using N.inv_mem h2
  · intro h a x
    refine Quotient.inductionOn x (fun g => ?_)
    rw [quotient_smul_mk, QuotientGroup.eq]
    have h1 : g⁻¹ * (a • g) ∈ N := h (le_commutator a (Subgroup.mem_top g))
    simpa using N.inv_mem h1

/-- The image of `C_G(A)` in `G ⧸ N` lies in `C_{G/N}(A)`. -/
theorem map_fixedPoints_le (N : Subgroup G) [N.Normal] [IsInvariant A N] :
    (fixedPoints A G).map (QuotientGroup.mk' N) ≤ fixedPoints A (G ⧸ N) := by
  rintro _ ⟨c, hc, rfl⟩ a
  show a • (c : G ⧸ N) = (c : G ⧸ N)
  rw [quotient_smul_mk]
  rw [show a • c = c from hc a]


/-! ## Invariance of characteristic subgroups -/

/-- Every characteristic subgroup is invariant under any group of automorphisms. -/
theorem IsInvariant.of_characteristic {H : Subgroup G} (hH : H.Characteristic) :
    IsInvariant A H :=
  ⟨fun a => by
    rw [Subgroup.pointwise_smul_def]
    exact (Subgroup.characteristic_iff_map_eq.mp hH) (MulDistribMulAction.toMulEquiv G a)⟩

/-- The Frattini subgroup is invariant under any group of automorphisms. -/
instance instIsInvariantFrattini : IsInvariant A (frattini G) :=
  IsInvariant.of_characteristic frattini_characteristic

/-- The centre of `G` is invariant under any group of automorphisms. -/
instance instIsInvariantCenter : IsInvariant A (Subgroup.center G) :=
  IsInvariant.of_characteristic Subgroup.centerCharacteristic

end FT
