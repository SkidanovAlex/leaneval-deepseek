/-
Area A3 of the Feit–Thompson drive: coprime action of a group on a group.

Setting: `A` and `G` are groups and `A` acts on `G` by automorphisms, i.e. there is an
instance `[MulDistribMulAction A G]`; `Coprime (Nat.card A) (Nat.card G)` is *not* assumed
here, it is an explicit hypothesis of the main theorems.

Main definitions (all in namespace `FT`):

* `FT.fixedPoints A G` — the subgroup `C_G(A)` of elements fixed (centralised) by `A`.
* `FT.IsInvariant A H` — a class: the subgroup `H ≤ G` is `A`-invariant (`a • H = H` for all `a`).
* `FT.IsTrivialOn A G` — the predicate "`A` acts trivially on `G`".
* `FT.commutator A H` — the subgroup `[H, A]` generated by the elements `x⁻¹ * (a • x)`
  (`x ∈ H`, `a : A`), i.e. the commutator of `H` with the action of `A`.
* `FT.instQuotientMulDistribMulAction` — for `N ⊴ G` an `A`-invariant normal subgroup, the
  induced action of `A` on the quotient group `G ⧸ N` (used to state `C_{G/N}(A) = C_G(A)N/N`).

Conventions.  Subgroups are acted on pointwise: `a • H` requires `open scoped Pointwise`.
`G` is usually implicit and inferred from the subgroup in question; `A` is explicit because it
cannot be inferred from `H` alone.
-/
import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false

open scoped Pointwise

namespace FT

variable {A : Type*} {G : Type*} [Group A] [Group G] [MulDistribMulAction A G]

/-! ## Fixed points -/

/-- `C_G(A)`: the subgroup of elements of `G` fixed by the action of `A`. -/
def fixedPoints (A : Type*) (G : Type*) [Group A] [Group G] [MulDistribMulAction A G] :
    Subgroup G where
  carrier := {g : G | ∀ a : A, a • g = g}
  mul_mem' := by
    intro x y hx hy a
    rw [smul_mul', hx a, hy a]
  one_mem' := by
    intro a
    rw [smul_one]
  inv_mem' := by
    intro x hx a
    rw [smul_inv', hx a]

@[simp]
theorem mem_fixedPoints {g : G} : g ∈ fixedPoints A G ↔ ∀ a : A, a • g = g := Iff.rfl

theorem smul_eq_self_of_mem_fixedPoints {g : G} (hg : g ∈ fixedPoints A G) (a : A) :
    a • g = g := hg a

theorem fixedPoints_le_iff {H : Subgroup G} :
    H ≤ fixedPoints A G ↔ ∀ (a : A), ∀ ⦃x : G⦄, x ∈ H → a • x = x :=
  ⟨fun h a x hx => h hx a, fun h x hx a => h a hx⟩

/-! ## Trivial action -/

/-- `A` acts trivially on `G`. -/
def IsTrivialOn (A : Type*) (G : Type*) [Group A] [Group G] [MulDistribMulAction A G] : Prop :=
  ∀ (a : A) (g : G), a • g = g

theorem fixedPoints_eq_top_iff : fixedPoints A G = ⊤ ↔ IsTrivialOn A G :=
  ⟨fun h a g => by have : g ∈ fixedPoints A G := h ▸ Subgroup.mem_top g; exact this a,
    fun h => top_unique fun g _ a => h a g⟩

theorem isTrivialOn_iff_fixedPoints_eq_top : IsTrivialOn A G ↔ fixedPoints A G = ⊤ :=
  (fixedPoints_eq_top_iff (A := A) (G := G)).symm

theorem IsTrivialOn.smul_eq_self (h : IsTrivialOn A G) (a : A) (g : G) : a • g = g := h a g

/-! ## Invariant subgroups -/

/-- An `A`-invariant subgroup: a subgroup `H ≤ G` with `a • H = H` for all `a : A`. -/
class IsInvariant (A : Type*) {G : Type*} [Group A] [Group G] [MulDistribMulAction A G]
    (H : Subgroup G) : Prop where
  smul_eq_self : ∀ a : A, a • H = H

theorem IsInvariant.mem_smul_iff {H : Subgroup G} (h : IsInvariant A H) (a : A) (x : G) :
    a • x ∈ H ↔ x ∈ H := by
  have h1 : ∀ y : G, y ∈ H ↔ a⁻¹ • y ∈ H := by
    intro y
    rw [← Subgroup.mem_pointwise_smul_iff_inv_smul_mem, h.smul_eq_self a]
  have h2 := h1 (a • x)
  rw [inv_smul_smul] at h2
  exact h2

theorem IsInvariant.smul_mem {H : Subgroup G} (h : IsInvariant A H) (a : A) {x : G}
    (hx : x ∈ H) : a • x ∈ H := (h.mem_smul_iff a x).mpr hx

theorem IsInvariant.inv_smul_mem {H : Subgroup G} (h : IsInvariant A H) (a : A) {x : G}
    (hx : x ∈ H) : a⁻¹ • x ∈ H := (h.mem_smul_iff a⁻¹ x).mpr hx

instance instIsInvariantTop : IsInvariant A (⊤ : Subgroup G) :=
  ⟨fun a => le_antisymm le_top fun x _ =>
    (Subgroup.mem_smul_pointwise_iff_exists x a ⊤).mpr ⟨a⁻¹ • x, trivial, smul_inv_smul a x⟩⟩

instance instIsInvariantBot : IsInvariant A (⊥ : Subgroup G) := ⟨fun a => by simp⟩

instance instIsInvariantFixedPoints : IsInvariant A (fixedPoints A G) :=
  ⟨fun a => le_antisymm
    (fun y hy => by
      obtain ⟨x, hx, rfl⟩ :=
        (Subgroup.mem_smul_pointwise_iff_exists y a (fixedPoints A G)).mp hy
      intro b
      rw [smul_smul, hx (b * a), hx a])
    (fun y hy => (Subgroup.mem_smul_pointwise_iff_exists y a (fixedPoints A G)).mpr
      ⟨y, hy, hy a⟩)⟩

instance instIsInvariantInf {H K : Subgroup G} [IsInvariant A H] [IsInvariant A K] :
    IsInvariant A (H ⊓ K) :=
  ⟨fun a => by
    rw [Subgroup.smul_inf, (inferInstance : IsInvariant A H).smul_eq_self a,
      (inferInstance : IsInvariant A K).smul_eq_self a]⟩

instance instIsInvariantSup {H K : Subgroup G} [IsInvariant A H] [IsInvariant A K] :
    IsInvariant A (H ⊔ K) :=
  ⟨fun a => by
    rw [Subgroup.smul_sup, (inferInstance : IsInvariant A H).smul_eq_self a,
      (inferInstance : IsInvariant A K).smul_eq_self a]⟩

/-- The subgroup generated by an `A`-invariant set of elements is `A`-invariant. -/
theorem IsInvariant.closure {S : Set G} (hS : ∀ a : A, a • S = S) :
    IsInvariant A (Subgroup.closure S) :=
  ⟨fun a => by rw [Subgroup.smul_closure, hS a]⟩

/-! ## The commutator `[H, A]` -/

/-- `[H, A]`, the commutator of the subgroup `H ≤ G` with the acting group `A`: the subgroup
generated by the elements `x⁻¹ * (a • x)` with `x ∈ H`, `a : A`. -/
def commutator (A : Type*) {G : Type*} [Group A] [Group G] [MulDistribMulAction A G]
    (H : Subgroup G) : Subgroup G :=
  Subgroup.closure {y : G | ∃ a : A, ∃ x ∈ H, y = x⁻¹ * (a • x)}

theorem commutator_def' (H : Subgroup G) :
    commutator A H = Subgroup.closure {y : G | ∃ a : A, ∃ x ∈ H, y = x⁻¹ * (a • x)} := rfl

theorem le_commutator {H : Subgroup G} (a : A) {x : G} (hx : x ∈ H) :
    x⁻¹ * (a • x) ∈ commutator A H :=
  Subgroup.subset_closure ⟨a, x, hx, rfl⟩

theorem commutator_le_iff {H K : Subgroup G} :
    commutator A H ≤ K ↔ ∀ (a : A), ∀ ⦃x : G⦄, x ∈ H → x⁻¹ * (a • x) ∈ K :=
  ⟨fun h a x hx => h (le_commutator a hx), fun h =>
    (Subgroup.closure_le K).mpr (by rintro y ⟨a, x, hx, rfl⟩; exact h a hx)⟩

theorem commutator_le {H K : Subgroup G}
    (h : ∀ (a : A), ∀ ⦃x : G⦄, x ∈ H → x⁻¹ * (a • x) ∈ K) : commutator A H ≤ K :=
  commutator_le_iff.mpr h

theorem commutator_mono {H K : Subgroup G} (h : H ≤ K) : commutator A H ≤ commutator A K :=
  commutator_le fun a x hx => le_commutator a (h hx)

/-- Conjugating the commutator `[H, A]` by an automorphism `a` gives `[a • H, A]`. -/
theorem smul_commutator (H : Subgroup G) (a : A) : a • commutator A H = commutator A (a • H) := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.pointwise_smul_subset_iff]
    refine commutator_le fun b x hx => ?_
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, inv_inv]
    have h1 : a • (x⁻¹ * (b • x)) = (a • x)⁻¹ * ((a * b * a⁻¹) • (a • x)) := by
      rw [smul_mul', smul_inv', smul_smul, smul_smul,
        show a * b * a⁻¹ * a = a * b by group]
    rw [h1]
    exact le_commutator _ (Subgroup.smul_mem_pointwise_smul x a H hx)
  · refine commutator_le fun b y hy => ?_
    obtain ⟨x, hx, rfl⟩ := (Subgroup.mem_smul_pointwise_iff_exists y a H).mp hy
    have h1 : a • (x⁻¹ * ((a⁻¹ * b * a) • x)) = (a • x)⁻¹ * (b • (a • x)) := by
      simp only [smul_mul', smul_inv', smul_smul]
      rw [show a * (a⁻¹ * b * a) = b * a by group]
    rw [← h1]
    exact Subgroup.smul_mem_pointwise_smul _ a _ (le_commutator _ hx)

instance instIsInvariantCommutator (H : Subgroup G) [IsInvariant A H] :
    IsInvariant A (commutator A H) :=
  ⟨fun a => by
    rw [smul_commutator, (inferInstance : IsInvariant A H).smul_eq_self a]⟩

theorem commutator_eq_bot_iff : commutator A (⊤ : Subgroup G) = ⊥ ↔ IsTrivialOn A G := by
  constructor
  · intro h a g
    have h1 : g⁻¹ * (a • g) ∈ commutator A (⊤ : Subgroup G) := le_commutator a trivial
    rw [h] at h1
    have h2 : g⁻¹ * (a • g) = 1 := Subgroup.mem_bot.mp h1
    calc a • g = g * (g⁻¹ * (a • g)) := by rw [← mul_assoc, mul_inv_cancel, one_mul]
      _ = g := by rw [h2, mul_one]
  · intro h
    refine le_antisymm ?_ bot_le
    refine commutator_le fun a x _ => ?_
    rw [h a x]
    exact Subgroup.mem_bot.mpr (inv_mul_cancel x)

/-! ## The induced action on a quotient -/

/-- The action of an element `a : A` on the quotient `G ⧸ N`, for `N ⊴ G` an `A`-invariant
normal subgroup: `gN ↦ (a • g)N`. -/
def quotientSmul (A : Type*) {G : Type*} [Group A] [Group G] [MulDistribMulAction A G]
    (N : Subgroup G) [N.Normal] [IsInvariant A N] (a : A) (x : G ⧸ N) : G ⧸ N :=
  Quotient.map' (fun g => a • g) (by
    intro g h hgh
    rw [QuotientGroup.leftRel_apply] at hgh ⊢
    rw [← smul_inv', ← smul_mul']
    exact (inferInstance : IsInvariant A N).mem_smul_iff a (g⁻¹ * h) |>.mpr hgh) x

@[simp]
theorem quotientSmul_mk (N : Subgroup G) [N.Normal] [IsInvariant A N] (a : A) (g : G) :
    quotientSmul A N a (g : G ⧸ N) = ((a • g : G) : G ⧸ N) := rfl

instance instSMulQuotient (N : Subgroup G) [N.Normal] [IsInvariant A N] :
    SMul A (G ⧸ N) := ⟨quotientSmul A N⟩

/-- For an `A`-invariant normal subgroup `N ⊴ G` the action of `A` descends to the quotient
group `G ⧸ N`. -/
instance instQuotientMulDistribMulAction (A : Type*) {G : Type*} [Group A] [Group G]
    [MulDistribMulAction A G] (N : Subgroup G) [N.Normal] [IsInvariant A N] :
    MulDistribMulAction A (G ⧸ N) where
  one_smul x := by
    change quotientSmul A N 1 x = x
    exact Quotient.inductionOn x (fun g => by rw [quotientSmul_mk, one_smul])
  mul_smul a b x := by
    change quotientSmul A N (a * b) x = quotientSmul A N a (quotientSmul A N b x)
    exact Quotient.inductionOn x (fun g => by
      rw [quotientSmul_mk, quotientSmul_mk, quotientSmul_mk, mul_smul])
  smul_one a := by
    change quotientSmul A N a 1 = 1
    rw [← QuotientGroup.mk_one, quotientSmul_mk, smul_one]
  smul_mul a x y := by
    change quotientSmul A N a (x * y) = quotientSmul A N a x * quotientSmul A N a y
    refine Quotient.inductionOn x (fun g => ?_)
    refine Quotient.inductionOn y (fun g' => ?_)
    rw [← QuotientGroup.mk_mul, quotientSmul_mk, quotientSmul_mk, quotientSmul_mk, smul_mul',
      QuotientGroup.mk_mul]

@[simp]
theorem quotient_smul_mk (N : Subgroup G) [N.Normal] [IsInvariant A N] (a : A) (g : G) :
    a • (g : G ⧸ N) = ((a • g : G) : G ⧸ N) := rfl

end FT
