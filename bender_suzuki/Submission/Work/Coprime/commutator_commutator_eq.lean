/-!
# `[G, A, A] = [G, A]` for a coprime action

For a finite group `A` acting by automorphisms on a finite group `G` with
`Nat.card A` coprime to `Nat.card G`, and with `A` or `G` solvable, the
commutator `[G, A]` (in the sense of `FT.commutator A ⊤`, generated by the
elements `x⁻¹ * (a • x)`) satisfies `[[G, A], A] = [G, A]`.

The mathematical content is the coprime-action decomposition
`G = C_G(A) · [G, A]`: every `g : G` is a product `c * m` with `c` fixed by `A`
and `m ∈ [G, A]`.  We obtain it from the vanishing of `H¹(A, [G, A])`
(`Work.Coprime.crossed_hom_coboundary`): the map `a ↦ g⁻¹ * (a • g)` is a
crossed homomorphism `A → [G, A]`, hence a coboundary; the conjugating element
`m` has the property that `g * m` is fixed by `A`.
-/

set_option linter.unusedVariables false

open scoped Pointwise

namespace Work.Coprime

variable {A : Type*} {G : Type*} [Group A] [Group G] [Finite A] [Finite G]
  [MulDistribMulAction A G]

/-- **Coprime action decomposition.**  Under `(|A|, |G|) = 1` with `A` or `G`
solvable, every element of `G` is the product of an element fixed by `A` and an
element of the commutator `[G, A] = FT.commutator A ⊤`. -/
theorem exists_fixed_mul_commutator (hcop : (Nat.card A).Coprime (Nat.card G))
    (hsol : Group.IsSolvable A ∨ Group.IsSolvable G) (g : G) :
    ∃ c ∈ FT.fixedPoints A G,
      ∃ m ∈ FT.commutator A (⊤ : Subgroup G), g = c * m := by
  classical
  -- The commutator subgroup and the action of `A` on it.
  let K : Subgroup G := FT.commutator A (⊤ : Subgroup G)
  haveI hKinv : FT.IsInvariant A K := by
    rw [show K = FT.commutator A (⊤ : Subgroup G) from rfl]; infer_instance
  -- The crossed homomorphism `η a = g⁻¹ * (a • g)` with values in `K`.
  let η : A → K := fun a =>
    ⟨g⁻¹ * (a • g), by
      rw [show K = FT.commutator A (⊤ : Subgroup G) from rfl]
      exact FT.le_commutator a (Subgroup.mem_top g)⟩
  have hη1 : η 1 = 1 := by
    ext
    simp [η]
  have hηcross : ∀ a b : A, η (a * b) = η a * (a • η b) := by
    intro a b
    ext
    show g⁻¹ * ((a * b) • g) = (g⁻¹ * (a • g)) * (a • (g⁻¹ * (b • g)))
    rw [mul_smul, smul_mul', smul_inv']
    group
  -- Solvability and coprimality pass to `K`.
  have hsolK : Group.IsSolvable A ∨ Group.IsSolvable K := by
    rcases hsol with hA | hG
    · exact Or.inl hA
    · exact Or.inr (Group.isSolvable_of_isSolvable_injective
        (f := K.subtype) K.subtype_injective)
  have hcopK : (Nat.card A).Coprime (Nat.card K) :=
    hcop.coprime_dvd_right (by
      rw [show K = FT.commutator A (⊤ : Subgroup G) from rfl]
      exact Subgroup.card_subgroup_dvd_card _)
  obtain ⟨m, hm⟩ := Work.Coprime.crossed_hom_coboundary hsolK hcopK η hη1 hηcross
  -- Translate the coboundary equation back to `G`.
  have hm' : ∀ a : A, g⁻¹ * (a • g) = (m : G) * (a • (m : G))⁻¹ := by
    intro a
    have := congrArg (fun x : K => (x : G)) (hm a)
    simpa [η] using this
  refine ⟨g * (m : G), ?_, (m : G)⁻¹, K.inv_mem m.2, ?_⟩
  · -- `g * m` is fixed by `A`
    rw [FT.mem_fixedPoints]
    intro a
    have hsplit : (a • g) = g * (m : G) * (a • (m : G))⁻¹ := by
      have h := hm' a
      calc (a • g) = g * (g⁻¹ * (a • g)) := by group
        _ = g * ((m : G) * (a • (m : G))⁻¹) := by rw [h]
        _ = g * (m : G) * (a • (m : G))⁻¹ := by group
    calc a • (g * (m : G)) = (a • g) * (a • (m : G)) := by rw [smul_mul']
      _ = g * (m : G) := by rw [hsplit]; group
  · -- `g = (g * m) * m⁻¹`
    group

theorem commutator_commutator_eq (A : Type*) {G : Type*} [Group A] [Group G] [Finite A] [Finite G]
    [MulDistribMulAction A G] (hcop : (Nat.card A).Coprime (Nat.card G))
    (hsol : Group.IsSolvable A ∨ Group.IsSolvable G) :
    FT.commutator A (FT.commutator A (⊤ : Subgroup G)) = FT.commutator A (⊤ : Subgroup G) := by
  refine le_antisymm ?_ ?_
  · -- `[[G,A], A] ≤ [G,A]`
    refine FT.commutator_le (fun a x hx => ?_)
    exact (FT.commutator A (⊤ : Subgroup G)).mul_mem
      ((FT.commutator A (⊤ : Subgroup G)).inv_mem hx)
      (FT.IsInvariant.smul_mem
        (inferInstance : FT.IsInvariant A (FT.commutator A (⊤ : Subgroup G))) a hx)
  · -- `[G,A] ≤ [[G,A], A]`
    refine FT.commutator_le (fun a x _ => ?_)
    obtain ⟨c, hc, m, hm, rfl⟩ :=
      exists_fixed_mul_commutator (A := A) hcop hsol x
    have key : (c * m)⁻¹ * (a • (c * m)) = m⁻¹ * (a • m) := by
      rw [smul_mul', hc a]
      group
    rw [key]
    exact FT.le_commutator a hm

end Work.Coprime
