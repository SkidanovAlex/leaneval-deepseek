/-!
# `Q = O_2(Q) · O_{2'}(Q)` for a nilpotent `Q`

A finite nilpotent group is the direct product of its Sylow subgroups; equivalently
(`Work.Fitting.isNilpotent_iff_iSup_pCore_eq_top`) it is generated by its `p`-cores `O_p(G)`:

  `G = ⨆_{p ∣ |G|} O_p(G)`   (`G` nilpotent).

Fixing a prime `p`, the terms of this join split into `O_p(G)` and the `O_r(G)` with `r ≠ p`;
each `O_r(G)` with `r ≠ p` is a normal `r`-subgroup, hence a normal `p'`-subgroup, hence lies in
`O_{p'}(G)`.  So `O_p(G) ⊔ O_{p'}(G) = G` (`pCore_sup_pPrimeCore_eq_top`, valid for an arbitrary
natural number `p`, not only a prime one).

Applying this inside `Q` with `p = 2` and pushing the equality forward along the inclusion
`Q.subtype : Q →* G` gives the stated `twoPart Q ⊔ oddPart Q = Q`; this is the decomposition
`Q = O_2(Q) × O_{2'}(Q)` used throughout the Zassenhaus area (`twoPart Q` is the Sylow
`2`-subgroup `S` of `Q`, `oddPart Q` is Feit's `M₁ = O_{2'}(Q)`).

Note that the equality `O_p ⊔ O_{p'} = G` (and hence the target statement) *does* need
nilpotency: in `G = S₃` with `p = 2` one has `O_2(S₃) = 1` and `O_{2'}(S₃) = A₃`.
-/

namespace Work.ZassenhausTwoGroup

/-- In a finite nilpotent group, `O_p(G) ⊔ O_{p'}(G) = G`: the `p`-core together with the
`p'`-core generate the whole group.

The proof only uses that `G` is generated by its `p`-cores (`O_r(G)` for the prime divisors `r`
of `|G|`), which is `Work.Fitting.isNilpotent_iff_iSup_pCore_eq_top`: a term `O_r(G)` with `r = p`
lies in `O_p(G)`, and a term with `r ≠ p` is a normal `r`-subgroup, hence a normal `p'`-subgroup,
so it lies in `O_{p'}(G)`.  No primality of `p` is needed. -/
theorem pCore_sup_pPrimeCore_eq_top {G : Type} [Group G] [Finite G]
    (h : Group.IsNilpotent G) (p : ℕ) :
    Work.Fitting.pCore p G ⊔ Work.Fitting.pPrimeCore p G = ⊤ := by
  refine le_antisymm le_top ?_
  -- `G` is generated by its `p`-cores `O_r(G)`, `r` a prime divisor of `|G|`.
  rw [← (Work.Fitting.isNilpotent_iff_iSup_pCore_eq_top G).mp h]
  refine iSup₂_le fun r _ => ?_
  by_cases hr : r = p
  · -- `O_p(G) ≤ O_p(G) ⊔ O_{p'}(G)`.
    subst hr
    exact le_sup_left
  · -- For `r ≠ p`, `O_r(G)` is a normal `r`-subgroup, hence a normal `p'`-subgroup.
    exact (Work.Fitting.le_piCore (inferInstance : (Work.Fitting.pCore r G).Normal)
      ((Work.Fitting.piCore_isPiNat G (fun q => q = r)).mono
        (fun q hq => by rw [hq]; exact hr))).trans le_sup_right

theorem twoPart_sup_oddPart {G : Type} [Group G] [Finite G] {Q : Subgroup G}
    (h : Group.IsNilpotent Q) : Work.ZassenhausTwoGroup.twoPart Q ⊔ Work.ZassenhausTwoGroup.oddPart Q = Q := by
  -- Inside the nilpotent group `Q`, the `2`-core and the `2'`-core generate `Q`.
  have htop : Work.Fitting.pCore 2 ↥Q ⊔ Work.Fitting.pPrimeCore 2 ↥Q = ⊤ :=
    pCore_sup_pPrimeCore_eq_top h 2
  -- Pushing this along `Q.subtype : Q →* G` (and using `map_sup`) gives the claim, because
  -- `twoPart`/`oddPart` are exactly the images of `O_2(Q)`/`O_{2'}(Q)`, while `⊤ ↦ Q`.
  have hmap : (Work.Fitting.pCore 2 ↥Q ⊔ Work.Fitting.pPrimeCore 2 ↥Q).map Q.subtype = Q := by
    rw [htop, ← MonoidHom.range_eq_map Q.subtype, Subgroup.range_subtype]
  rw [twoPart, oddPart,
    ← Subgroup.map_sup (Work.Fitting.pCore 2 ↥Q) (Work.Fitting.pPrimeCore 2 ↥Q) Q.subtype]
  exact hmap

end Work.ZassenhausTwoGroup
