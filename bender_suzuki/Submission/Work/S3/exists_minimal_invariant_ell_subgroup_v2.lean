/-!
# `Work.S3.exists_minimal_invariant_ell_subgroup_v2`

Peterfalvi II, Ch. V §3, step (3): if `Q` is a finite nilpotent subgroup of a finite group `G`
and `ℓ` is a prime dividing `|O_{2'}(Q)|`, then there is a subgroup `M ≤ O_{2'}(Q)` which is

* non-trivial, elementary abelian of exponent `ℓ` (`IsPGroup ℓ`, commutative, `x ^ ℓ = 1`);
* invariant under `L = K ⋊ P` (`K = Ksub H t`, `P`) acting by conjugation;
* minimal among the non-trivial `L`-invariant subgroups of `O_{2'}(Q)`.

The mathematical content is entirely group-theoretic:

* `O_{2'}(Q)` is nilpotent (it is a subgroup of the nilpotent group `Q`), so
  `ℓ ∣ |Z(O_{2'}(Q))|` (`Group.IsNilpotent.prime_dvd_card_center`);
* `Ω₁(Z(O_{2'}(Q)))` — the subgroup generated by the elements `x` of the centre with `x ^ ℓ = 1`
  (`Work.PGroup.omega1`) — is therefore non-trivial, characteristic (hence invariant under any
  group acting by automorphisms), abelian and of exponent `ℓ`;
* a minimal non-trivial invariant subgroup of `Ω₁(Z(O_{2'}(Q)))` inherits all these properties.

The abstract statement of the first two items is `exists_minimal_invariant_elementary_abelian_action`
(stated for an arbitrary group `N` with an action of a group `A` by automorphisms), and the passage
back to the ambient group `G` is `map_conj_transfer`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Work.S3

open scoped Pointwise

/-! ## An abstract minimal invariant elementary abelian `p`-subgroup

Let `A` act on a finite nilpotent group `N` by automorphisms, and let `p` be a prime dividing
`|N|`.  Then `N` contains a non-trivial `A`-invariant subgroup `M` which is elementary abelian of
exponent `p`, minimal among the non-trivial `A`-invariant subgroups contained in `M`. -/
theorem exists_minimal_invariant_elementary_abelian_action
    {A N : Type*} [Group A] [Group N] [Finite N]
    (φ : A →* MulAut N) (hNnil : Group.IsNilpotent N) {p : ℕ} (hp : p.Prime)
    (hdvd : p ∣ Nat.card N) :
    ∃ M : Subgroup N, M ≠ ⊥ ∧ IsPGroup p ↥M ∧ IsMulCommutative ↥M ∧ (∀ x : ↥M, x ^ p = 1) ∧
      (∀ a : A, Subgroup.map ((φ a).toMonoidHom) M = M) ∧
      (∀ L : Subgroup N, L ≤ M → L ≠ ⊥ →
        (∀ a : A, Subgroup.map ((φ a).toMonoidHom) L = L) → L = M) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  haveI := hNnil
  let Z : Subgroup N := Subgroup.center N
  have hZcomm : IsMulCommutative ↥Z := Subgroup.center.isMulCommutative N
  let Ω : Subgroup N := Work.PGroup.omega1 N p Z
  have hΩchar : Ω.Characteristic := Work.PGroup.omega1_characteristic p Subgroup.centerCharacteristic
  have hΩle : Ω ≤ Z := Work.PGroup.omega1_le p Z
  have hΩinv : ∀ a : A, Subgroup.map ((φ a).toMonoidHom) Ω = Ω :=
    fun a => (Subgroup.characteristic_iff_map_eq).mp hΩchar (φ a)
  have hΩexp : ∀ x : N, x ∈ Ω → x ^ p = 1 :=
    fun x hx => (Work.PGroup.omega1_mem_and_pow hZcomm hx).2
  have hpZ : p ∣ Nat.card ↥Z := Group.IsNilpotent.prime_dvd_card_center (G := N) hdvd
  -- a subgroup of order `p` inside the centre, giving a non-trivial element of `Ω`
  obtain ⟨K, hKcard, _hKbot, hKZ⟩ := Sylow.exists_subgroup_card_pow_prime_le_le (G := N) hp
    (n := 1) (H := ⊥) (L := Z) (by simp) (by simpa using hpZ) bot_le
  rw [pow_one] at hKcard
  have hKne : K ≠ ⊥ := by
    rw [← Subgroup.one_lt_card_iff_ne_bot K, hKcard]; exact hp.one_lt
  obtain ⟨x, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hKne
  have hxZ : (x : N) ∈ Z := hKZ x.2
  have hxpowK : x ^ p = 1 := by
    have hdvd : orderOf x ∣ p := by
      have h := orderOf_dvd_natCard x
      rw [hKcard] at h; exact h
    exact (orderOf_dvd_iff_pow_eq_one).mp hdvd
  have hxpow : (x : N) ^ p = 1 := by
    have h := congrArg (fun z : ↥K => (z : N)) hxpowK
    simpa using h
  have hΩne : Ω ≠ ⊥ := by
    intro hbot
    have hmem : (x : N) ∈ (⊥ : Subgroup N) := by
      rw [← hbot]; exact Work.PGroup.omega1_subset p hxZ hxpow
    exact hx1 (Subtype.ext (Subgroup.mem_bot.mp hmem))
  -- a minimal non-trivial invariant subgroup of `Ω`
  let Φ : Set (Subgroup N) :=
    {M | M ≤ Ω ∧ M ≠ ⊥ ∧ ∀ a : A, Subgroup.map ((φ a).toMonoidHom) M = M}
  have hΩmem : Ω ∈ Φ := ⟨le_rfl, hΩne, hΩinv⟩
  have hex : ∃ k : ℕ, ∃ M : Subgroup N, M ∈ Φ ∧ Nat.card ↥M = k := ⟨_, Ω, hΩmem, rfl⟩
  obtain ⟨M, hMΦ, hMcard⟩ := Nat.find_spec hex
  have hMmin : ∀ L : Subgroup N, L ∈ Φ → Nat.find hex ≤ Nat.card ↥L :=
    fun L hL => Nat.find_min' hex ⟨L, hL, rfl⟩
  have hMleΩ : M ≤ Ω := hMΦ.1
  have hMne : M ≠ ⊥ := hMΦ.2.1
  have hMinv : ∀ a : A, Subgroup.map ((φ a).toMonoidHom) M = M := hMΦ.2.2
  have hMexp : ∀ x : ↥M, x ^ p = 1 :=
    fun x => Subtype.ext (by simpa using hΩexp (x : N) (hMleΩ x.2))
  refine ⟨M, hMne, ?_, ?_, hMexp, hMinv, ?_⟩
  · rw [isPGroup_iff_orderOf_dvd_pow]
    intro x
    exact ⟨1, by rw [pow_one]; exact (orderOf_dvd_iff_pow_eq_one).mpr (hMexp x)⟩
  · refine isMulCommutative_iff.mpr fun x y => Subtype.ext ?_
    have hxZ : (x : N) ∈ Z := hΩle (hMleΩ x.2)
    have h := (Subgroup.mem_center_iff.mp hxZ) (y : N)
    simpa using h.symm
  · intro L hLM hLne hLinv
    have hLΦ : L ∈ Φ := ⟨hLM.trans hMleΩ, hLne, hLinv⟩
    have h1 : Nat.find hex ≤ Nat.card ↥L := hMmin L hLΦ
    exact Subgroup.eq_of_le_of_card_ge hLM (by rw [hMcard]; exact h1)

/-! ## Passing a `K₁`-invariant subgroup of `Q₁` back to the ambient group

Let `A ≤ N_G(Q₁)`.  A subgroup `M ≤ Q₁` which is invariant under the conjugation action of `A`
(the automorphism `Q₁.normalizerMonoidHom ∘ inclusion`) gives a subgroup `M.map Q₁.subtype ≤ G`
which is invariant under conjugation by the elements of `A` in `G`; every property transfers. -/
theorem map_conj_transfer {G : Type} [Group G] [Finite G] {Q₁ A : Subgroup G}
    (hA : A ≤ Subgroup.normalizer (Q₁ : Set G)) {p : ℕ} {M : Subgroup ↥Q₁}
    (hMne : M ≠ ⊥) (hMpg : IsPGroup p ↥M) (hMcomm : IsMulCommutative ↥M)
    (hMexp : ∀ x : ↥M, x ^ p = 1)
    (hMinv : ∀ a : ↥A,
      Subgroup.map ((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) a).toMonoidHom M = M)
    (hMmin : ∀ L : Subgroup ↥Q₁, L ≤ M → L ≠ ⊥ →
      (∀ a : ↥A,
        Subgroup.map ((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) a).toMonoidHom L = L)
        → L = M) :
    M.map Q₁.subtype ≤ Q₁ ∧ M.map Q₁.subtype ≠ ⊥ ∧ IsPGroup p ↥(M.map Q₁.subtype) ∧
    IsMulCommutative ↥(M.map Q₁.subtype) ∧ (∀ x : ↥(M.map Q₁.subtype), x ^ p = 1) ∧
    (∀ x ∈ A, ∀ m ∈ M.map Q₁.subtype, x * m * x⁻¹ ∈ M.map Q₁.subtype) ∧
    (∀ N : Subgroup G, N ≤ M.map Q₁.subtype → N ≠ ⊥ →
      (∀ x ∈ A, ∀ m ∈ N, x * m * x⁻¹ ∈ N) → N = M.map Q₁.subtype) := by
  classical
  haveI : IsMulCommutative ↥M := hMcomm
  refine ⟨Subgroup.map_subtype_le M, ?_, hMpg.map Q₁.subtype, ?_, ?_, ?_, ?_⟩
  · exact fun h => hMne ((Subgroup.map_eq_bot_iff_of_injective M Q₁.subtype_injective).mp h)
  · refine isMulCommutative_iff.mpr fun x y => ?_
    obtain ⟨x₀, hx₀, hx₀eq⟩ := Subgroup.mem_map.mp x.2
    obtain ⟨y₀, hy₀, hy₀eq⟩ := Subgroup.mem_map.mp y.2
    have h2 : (x₀ : G) * (y₀ : G) = (y₀ : G) * (x₀ : G) := by
      have hcomm : (⟨x₀, hx₀⟩ : ↥M) * (⟨y₀, hy₀⟩ : ↥M)
          = (⟨y₀, hy₀⟩ : ↥M) * (⟨x₀, hx₀⟩ : ↥M) := mul_comm' _ _
      have h3 := congrArg (fun z : ↥M => (z : G)) hcomm
      simpa using h3
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    rw [← hx₀eq, ← hy₀eq]
    exact h2
  · intro x
    obtain ⟨x₀, hx₀, hx₀eq⟩ := Subgroup.mem_map.mp x.2
    have h := hMexp ⟨x₀, hx₀⟩
    have h2 : (x₀ : G) ^ p = 1 := by
      have h3 := congrArg (fun z : ↥M => (z : G)) h
      simpa using h3
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [← hx₀eq]
    exact h2
  · intro x hx m hm
    obtain ⟨m₀, hm₀, hm₀eq⟩ := Subgroup.mem_map.mp hm
    have h1 : ((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) ⟨x, hx⟩) m₀ ∈ M := by
      rw [← hMinv ⟨x, hx⟩]
      exact Subgroup.mem_map.mpr ⟨m₀, hm₀, rfl⟩
    refine Subgroup.mem_map.mpr ⟨_, h1, ?_⟩
    rw [← hm₀eq]
    rfl
  · intro N hNM hNne hNinv
    let L : Subgroup ↥Q₁ := N.comap Q₁.subtype
    have hLM : L ≤ M := by
      intro y hy
      have hyN : Q₁.subtype y ∈ N := Subgroup.mem_comap.mp hy
      obtain ⟨z, hz, hzEq⟩ := Subgroup.mem_map.mp (hNM hyN)
      rwa [Q₁.subtype_injective hzEq] at hz
    have hLne : L ≠ ⊥ := by
      intro hLbot
      apply hNne
      rw [eq_bot_iff]
      intro g hg
      obtain ⟨y, _hy, hyEq⟩ := Subgroup.mem_map.mp (hNM hg)
      have hyL : y ∈ L := by
        rw [Subgroup.mem_comap]; rw [hyEq]; exact hg
      have hy1 : y = 1 := by rw [hLbot] at hyL; simpa using hyL
      rw [← hyEq, hy1]
      simp
    have hLinv : ∀ a : ↥A,
        Subgroup.map ((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) a).toMonoidHom L = L := by
      intro a
      have hstep : Subgroup.map ((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) a).toMonoidHom L ≤ L := by
        intro z hz
        obtain ⟨y, hy, hyEq⟩ := Subgroup.mem_map.mp hz
        rw [← hyEq]
        rw [Subgroup.mem_comap]
        change (a : G) * (y : G) * (a : G)⁻¹ ∈ N
        exact hNinv (a : G) a.2 (y : G) (Subgroup.mem_comap.mp hy)
      refine Subgroup.eq_of_le_of_card_ge hstep ?_
      rw [Subgroup.card_map_of_injective
        (f := ((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) a).toMonoidHom)
        (((Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA) a)).injective]
    have hL : L = M := hMmin L hLM hLne hLinv
    apply le_antisymm hNM
    intro g hg
    obtain ⟨y, hy, hyEq⟩ := Subgroup.mem_map.mp hg
    have hyL : y ∈ L := by rw [hL]; exact hy
    have hmem : Q₁.subtype y ∈ N := Subgroup.mem_comap.mp hyL
    rwa [hyEq] at hmem

/-! ## The target -/

theorem exists_minimal_invariant_ell_subgroup_v2 {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G} {P : Subgroup G} (hQnil : Group.IsNilpotent ↥Q) (hQnorm : H ≤ Subgroup.normalizer (Q : Set G)) (hPH : ∀ x ∈ P, x ∈ H) (hKH : Work.ThmF.Ksub H t ≤ H) {l : ℕ} (hl : l.Prime) (hdvd : l ∣ Nat.card ↥(Work.ThmF.oddPart Q)) : ∃ M : Subgroup G, M ≤ Work.ThmF.oddPart Q ∧ M ≠ ⊥ ∧ IsPGroup l ↥M ∧ IsMulCommutative ↥M ∧ (∀ x : ↥M, x ^ l = 1) ∧ (∀ x ∈ (Work.ThmF.Ksub H t ⊔ P), ∀ m ∈ M, x * m * x⁻¹ ∈ M) ∧ (∀ N : Subgroup G, N ≤ M → N ≠ ⊥ → (∀ x ∈ (Work.ThmF.Ksub H t ⊔ P), ∀ m ∈ N, x * m * x⁻¹ ∈ N) → N = M) := by
  classical
  let Q₁ : Subgroup G := Work.ThmF.oddPart Q
  let A : Subgroup G := Work.ThmF.Ksub H t ⊔ P
  -- `Q₁ = O_{2'}(Q)` is nilpotent
  haveI hQ₁nil : Group.IsNilpotent ↥Q₁ := by
    haveI := hQnil
    have hle : Q₁ ≤ Q := Work.ThmF.oddPart_le Q
    haveI : Group.IsNilpotent ↥(Q₁.subgroupOf Q) := inferInstance
    exact (Group.isNilpotent_congr (Subgroup.subgroupOfEquivOfLe hle)).mp inferInstance
  -- `A = K ⋊ P` lies in `H`, hence normalises `Q` and `Q₁`
  have hA_H : A ≤ H := sup_le hKH hPH
  have hA_NQ : A ≤ Subgroup.normalizer (Q : Set G) := hA_H.trans hQnorm
  have hA_NQ₁ : A ≤ Subgroup.normalizer (Q₁ : Set G) := by
    show A ≤ Subgroup.normalizer ((Work.ThmF.oddPart Q : Subgroup G) : Set G)
    exact Work.ThmG.oddPart_le_normalizer (H := A) hA_NQ
  -- the conjugation action of `A` on `Q₁`
  let φ : ↥A →* MulAut ↥Q₁ :=
    (Subgroup.normalizerMonoidHom (H := Q₁)).comp (Subgroup.inclusion hA_NQ₁)
  obtain ⟨M, hMne, hMpg, hMcomm, hMexp, hMinv, hMmin⟩ :=
    exists_minimal_invariant_elementary_abelian_action (A := ↥A) (N := ↥Q₁) φ hQ₁nil hl hdvd
  obtain ⟨hle, hne, hpg, hcomm, hexp, hinv, hmin⟩ :=
    map_conj_transfer (Q₁ := Q₁) (A := A) hA_NQ₁ hMne hMpg hMcomm hMexp hMinv hMmin
  exact ⟨M.map Q₁.subtype, hle, hne, hpg, hcomm, hexp, hinv, hmin⟩

end Work.S3
