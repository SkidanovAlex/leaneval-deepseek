import Submission.Work.ThmF.Prove.S3.ConjRep
import Submission.Work.ThmF.Prove.S3.card_mul_finrank_invariants_eq
import Submission.Work.CharPrelim.Defs
import Submission.Work.S3.cq_ell_subgroup_isCyclic
import Submission.Work.S3.KP_frobenius_cent

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

open scoped IsMulCommutative

namespace Work.S3

/-- **Peterfalvi II, Ch. V §3, step (3): the minimal `KP`-invariant `ℓ`-subgroup `M` of `O_{2'}(Q)`
has order `ℓ ^ |P|`.

Let `M ≤ O_{2'}(Q)` be elementary abelian of exponent `ℓ` (so an `𝔽_ℓ`-vector space), invariant
under conjugation by `L = K ⋊ P` with `K = Ksub H t`, minimal with these properties, and with
`C_M(K) = 1`.  We show `|M| = ℓ ^ |P|`.

The proof is the paper's:

* the conjugation action of `L` on `M` makes `S := Additive M` a `ZMod ℓ`-module, and the
  identification of the `P`-fixed points with `C := M ∩ C_G(P)` gives
  `Nat.card ↥(Representation.invariants …) = Nat.card ↥C`;
* `C ≤ C_Q(P)` is an elementary abelian `ℓ`-group, hence cyclic by the near-field input
  (`Work.S3.cq_ell_subgroup_isCyclic`), so `|C| ≤ ℓ` (non-trivial and generated by an element of
  order dividing `ℓ`);
* the coprime Frobenius dimension formula
  (`Work.ThmF.Prove.S3.card_mul_finrank_invariants_eq`, Isaacs 15.16) applied to the Frobenius
  group `L` with kernel `K` and complement `P`, together with `C_K(M) = 1`, gives
  `|P| · dim S^P = dim S`, i.e. `|P| · dim C = dim M`;
* `M ≠ 1` forces `dim M ≥ 1`, whence `dim C ≥ 1`; with `|C| = ℓ ^ dim C ≤ ℓ` this is `dim C = 1`
  and `dim M = |P|`, so `|M| = ℓ ^ |P|`. -/
theorem minimal_M_card_eq_prime_pow {G : Type} [Group G] [Finite G] {H Q : Subgroup G}
    {t s r : G} {P : Subgroup G} (hNF : Work.ThmF.ChV3.NearFieldAppXIProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2)
    (hKcyc : IsCyclic ↥(Work.ThmF.Ksub H t))
    (hKlcop : ¬ ℓ ∣ Nat.card ↥(Work.ThmF.Ksub H t))
    (hKP : P ⊓ Work.ThmF.Ksub H t = ⊥)
    (hFrob : Work.CharPrelim.IsFrobeniusIn (Work.ThmF.Ksub H t ⊔ P) (Work.ThmF.Ksub H t))
    {M : Subgroup G} (hMle : M ≤ Work.ThmF.oddPart Q) (hMne : M ≠ ⊥)
    (hMcomm : IsMulCommutative ↥M) (hMexp : ∀ x : ↥M, x ^ ℓ = 1)
    (hMinv : ∀ x ∈ (Work.ThmF.Ksub H t ⊔ P), ∀ m ∈ M, x * m * x⁻¹ ∈ M)
    (hMirr : ∀ N : Subgroup G, N ≤ M → N ≠ ⊥ →
      (∀ x ∈ (Work.ThmF.Ksub H t ⊔ P), ∀ n ∈ N, x * n * x⁻¹ ∈ N) → N = M)
    (hMcent : Subgroup.centralizer ((Work.ThmF.Ksub H t : Set G)) ⊓ M = ⊥) :
    Nat.card ↥M = ℓ ^ Nat.card P := by
  classical
  haveI : IsMulCommutative ↥M := hMcomm
  haveI : Fact (∀ x : ↥M, x ^ ℓ = 1) := ⟨hMexp⟩
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hℓ2' : 2 ≤ ℓ := hℓ.two_le
  -- ## the group `L = K ⋊ P` and its subgroups `KT`, `ET`
  let L : Subgroup G := Work.ThmF.Ksub H t ⊔ P
  let KT : Subgroup ↥L := (Work.ThmF.Ksub H t).subgroupOf L
  let ET : Subgroup ↥L := P.subgroupOf L
  have hKle : Work.ThmF.Ksub H t ≤ L := le_sup_left
  have hPle : P ≤ L := le_sup_right
  haveI : Fintype ↥L := Fintype.ofFinite _
  -- `L` normalises `M`
  have hN : L ≤ Subgroup.normalizer (M : Set G) := Subgroup.le_normalizer_iff.mpr hMinv
  -- ## `L` is a Frobenius group with kernel `KT` and complement `ET`
  have hKn : KT.Normal := hFrob.normal
  have hKne : KT ≠ ⊥ := by
    intro h
    apply hFrob.ne_bot
    have hd : Disjoint (Work.ThmF.Ksub H t) L := Subgroup.subgroupOf_eq_bot.mp h
    rw [disjoint_iff, inf_of_le_left hKle] at hd
    exact hd
  have hEne : ET ≠ ⊥ := by
    intro h
    have hd : Disjoint P L := Subgroup.subgroupOf_eq_bot.mp h
    rw [disjoint_iff] at hd
    have hPbot : P = ⊥ := by rw [inf_of_le_left hPle] at hd; exact hd
    exact ((Subgroup.one_lt_card_iff_ne_bot P).mp (by have := c.P_prime.two_le; omega)) hPbot
  have hinf : KT ⊓ ET = ⊥ := by
    show (Work.ThmF.Ksub H t).subgroupOf L ⊓ P.subgroupOf L = ⊥
    rw [show (Work.ThmF.Ksub H t).subgroupOf L ⊓ P.subgroupOf L
          = (Work.ThmF.Ksub H t ⊓ P).subgroupOf L from by
        ext x; simp only [Subgroup.mem_inf, Subgroup.mem_subgroupOf]]
    rw [Subgroup.subgroupOf_eq_bot, disjoint_iff]
    rw [show Work.ThmF.Ksub H t ⊓ P = ⊥ from by rw [inf_comm]; exact hKP]
    exact bot_inf_eq _
  have hsup : KT ⊔ ET = ⊤ := by
    show (Work.ThmF.Ksub H t).subgroupOf L ⊔ P.subgroupOf L = ⊤
    rw [← Subgroup.subgroupOf_sup hKle hPle, Subgroup.subgroupOf_eq_top]
  have hcent : ∀ k ∈ KT, k ≠ 1 → Subgroup.centralizer ({k} : Set ↥L) ≤ KT := by
    intro k hk hk1 y hy
    have hyk : y * k = k * y := Subgroup.mem_centralizer_singleton_iff.mp hy
    have hkK : ((k : ↥L) : G) ∈ Work.ThmF.Ksub H t := Subgroup.mem_subgroupOf.mp hk
    have hk1' : ((k : ↥L) : G) ≠ 1 := fun h => hk1 (Subtype.ext h)
    have hcommG : ((y : ↥L) : G) * ((k : ↥L) : G) = ((k : ↥L) : G) * ((y : ↥L) : G) := by
      have := congrArg (fun z : ↥L => (z : G)) hyk
      simpa using this
    rw [Subgroup.mem_subgroupOf]
    refine hFrob.cent ((k : ↥L) : G) hkK hk1' ⟨?_, ?_⟩
    · exact Subgroup.mem_centralizer_singleton_iff.mpr hcommG
    · exact y.2
  have hKsol : Group.IsSolvable ↥KT := by
    haveI hcycK : IsCyclic ↥KT :=
      (MulEquiv.isCyclic (Subgroup.subgroupOfEquivOfLe hKle)).mpr hKcyc
    haveI hcommK : IsMulCommutative ↥KT := IsCyclic.isMulCommutative
    exact Group.isSolvable_of_comm (fun a b => mul_comm' a b)
  have hcardKT : Nat.card ↥KT = Nat.card ↥(Work.ThmF.Ksub H t) :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKle).toEquiv
  have hchar : ∀ q : ℕ, q.Prime → (q : ZMod ℓ) = 0 → ¬ q ∣ Nat.card ↥KT := by
    intro q hq hq0 hdvd
    rw [hcardKT] at hdvd
    have hdvl : ℓ ∣ q := (CharP.cast_eq_zero_iff (ZMod ℓ) ℓ q).mp hq0
    have hqeq : q = ℓ := (hq.dvd_iff_eq hℓ.ne_one).mp hdvl
    rw [hqeq] at hdvd
    exact hKlcop hdvd
  -- ## the `P`-fixed points of the conjugation representation
  set S : Submodule (ZMod ℓ) (Additive ↥M) :=
    Representation.invariants
      ((Work.ThmF.Prove.S3.conjRepOfLe L M hN (n := ℓ)).comp ET.subtype) with hS
  set C : Subgroup G := M ⊓ Subgroup.centralizer (P : Set G) with hC
  have hmem : ∀ (m : ↥M), Additive.ofMul m ∈ S ↔ (m : G) ∈ Subgroup.centralizer (P : Set G) := by
    intro m
    rw [hS, Representation.mem_invariants]
    constructor
    · intro h
      rw [Subgroup.mem_centralizer_iff]
      intro p hp
      have h2 := h (⟨⟨p, (le_sup_right : P ≤ L) hp⟩, hp⟩ : ET)
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype] at h2
      simp only [Work.ThmF.Prove.S3.conjRepOfLe_apply] at h2
      have h3 : p * (m : G) * p⁻¹ = (m : G) := congrArg Subtype.val (Additive.ofMul.injective h2)
      calc p * (m : G) = p * (m : G) * p⁻¹ * p := by group
        _ = (m : G) * p := by rw [h3]
    · intro h
      intro e
      obtain ⟨q, hqP⟩ := e
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype]
      simp only [Work.ThmF.Prove.S3.conjRepOfLe_apply]
      refine congrArg Additive.ofMul (Subtype.ext ?_)
      show ((q : ↥L) : G) * (m : G) * ((q : ↥L) : G)⁻¹ = (m : G)
      have hcm := Subgroup.mem_centralizer_iff.mp h (q : G) hqP
      rw [hcm]; group
  have hSC : Nat.card ↥S = Nat.card ↥C := by
    refine Nat.card_congr ?_
    refine
      { toFun := fun v => ⟨((Additive.toMul v.1 : ↥M) : G),
            ⟨(Additive.toMul v.1).2, (hmem (Additive.toMul v.1)).mp v.2⟩⟩
        invFun := fun cc => ⟨Additive.ofMul ⟨(cc.1 : G), cc.2.1⟩,
            (hmem ⟨(cc.1 : G), cc.2.1⟩).mpr cc.2.2⟩
        left_inv := ?_
        right_inv := ?_ }
    · intro v; apply Subtype.ext; rfl
    · intro cc; apply Subtype.ext; rfl
  -- ## the fixed points of `K` vanish
  have hfix : Representation.invariants
      ((Work.ThmF.Prove.S3.conjRepOfLe L M hN (n := ℓ)).comp KT.subtype) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro v hv
    obtain ⟨m, rfl⟩ : ∃ m : ↥M, Additive.ofMul m = v := ⟨Additive.toMul v, rfl⟩
    rw [Representation.mem_invariants] at hv
    have hcentK : (m : G) ∈ Subgroup.centralizer ((Work.ThmF.Ksub H t : Set G)) := by
      rw [Subgroup.mem_centralizer_iff]
      intro k hk
      have h2 := hv (⟨⟨k, (le_sup_left : Work.ThmF.Ksub H t ≤ L) hk⟩, hk⟩ : KT)
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype] at h2
      simp only [Work.ThmF.Prove.S3.conjRepOfLe_apply] at h2
      have h3 : k * (m : G) * k⁻¹ = (m : G) :=
        congrArg Subtype.val (Additive.ofMul.injective h2)
      calc k * (m : G) = k * (m : G) * k⁻¹ * k := by group
        _ = (m : G) * k := by rw [h3]
    have hbot : (m : G) ∈ (⊥ : Subgroup G) := by
      rw [← hMcent]
      exact ⟨hcentK, m.2⟩
    have hv1 : m = 1 := Subtype.ext (Subgroup.mem_bot.mp hbot)
    simpa using congrArg Additive.ofMul hv1
  -- ## the Frobenius dimension formula
  haveI : Module.Finite (ZMod ℓ) (Additive ↥M) := Module.Finite.of_finite
  haveI : Finite ↥S := Subtype.finite
  haveI : Module.Finite (ZMod ℓ) ↥S := Module.Finite.of_finite
  have hformula : Nat.card ↥ET * Module.finrank (ZMod ℓ) ↥S
      = Module.finrank (ZMod ℓ) (Additive ↥M) :=
    Work.ThmF.Prove.S3.card_mul_finrank_invariants_eq hKn hinf hsup hKne hEne hcent hKsol hchar
      (Work.ThmF.Prove.S3.conjRepOfLe L M hN (n := ℓ)) hfix ET le_rfl
  -- ## cardinality of `S` and of `M` as `𝔽_ℓ`-vector spaces
  have hEM : Nat.card ↥ET = Nat.card ↥P :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPle).toEquiv
  have hSpow : Nat.card ↥S = ℓ ^ Module.finrank (ZMod ℓ) ↥S := by
    have h := Module.natCard_eq_pow_finrank (K := ZMod ℓ) (V := ↥S)
    rw [Nat.card_zmod ℓ] at h
    exact h
  have hMpow : Nat.card ↥M = ℓ ^ Module.finrank (ZMod ℓ) (Additive ↥M) := by
    have h := Module.natCard_eq_pow_finrank (K := ZMod ℓ) (V := Additive ↥M)
    rw [Nat.card_zmod ℓ] at h
    exact h
  have hM2 : 2 ≤ Nat.card ↥M := by
    have := (Subgroup.one_lt_card_iff_ne_bot M).mpr hMne
    omega
  have hD1 : 1 ≤ Module.finrank (ZMod ℓ) (Additive ↥M) := by
    rcases Nat.eq_zero_or_pos (Module.finrank (ZMod ℓ) (Additive ↥M)) with h | h
    · rw [h, pow_zero] at hMpow; omega
    · exact h
  have hd1 : 1 ≤ Module.finrank (ZMod ℓ) ↥S := by
    rcases Nat.eq_zero_or_pos (Module.finrank (ZMod ℓ) ↥S) with h | h
    · rw [h, mul_zero] at hformula; omega
    · exact h
  -- ## `|C| ≤ ℓ`
  have hCle : Nat.card ↥C ≤ ℓ := by
    have hBC : C ≤ Work.ThmF.ChV3.CQ Q P := fun x hx =>
      ⟨Work.ThmF.oddPart_le Q (hMle hx.1), hx.2⟩
    have hMpg : IsPGroup ℓ ↥M := IsPGroup.of_card hMpow
    have hCpg : IsPGroup ℓ ↥C := hMpg.to_le (fun x hx => hx.1)
    have hcyc : IsCyclic ↥C := Work.S3.cq_ell_subgroup_isCyclic hNF c hℓ hℓ2 hBC hCpg
    obtain ⟨g, hg⟩ := hcyc.exists_generator
    have htop : Subgroup.zpowers g = ⊤ := (Subgroup.eq_top_iff' _).mpr hg
    have hcardC : Nat.card ↥C = orderOf g := by
      have h1 : Nat.card ↥C = Nat.card ↥(Subgroup.zpowers g) := by rw [htop, Subgroup.card_top]
      rw [h1, Nat.card_zpowers]
    have hdvd : orderOf g ∣ ℓ := by
      rw [orderOf_dvd_iff_pow_eq_one]
      apply Subtype.ext
      rw [Subgroup.coe_pow, Subgroup.coe_one]
      have hmemM : (g : G) ∈ M := (show C ≤ M from inf_le_left) g.2
      have hthis : ((⟨(g : G), hmemM⟩ : ↥M) ^ ℓ) = 1 := hMexp _
      have hcoe := congrArg (fun z : ↥M => (z : G)) hthis
      rw [Subgroup.coe_pow, Subgroup.coe_one] at hcoe
      simpa using hcoe
    rcases (Nat.Prime.eq_one_or_self_of_dvd hℓ (orderOf g) hdvd) with h | h
    · rw [hcardC, h]; omega
    · rw [hcardC, h]
  -- ## `dim S = 1`, `dim M = |P|`, conclusion
  have hd2 : Module.finrank (ZMod ℓ) ↥S ≤ 1 := by
    have hpow : ℓ ^ Module.finrank (ZMod ℓ) ↥S ≤ ℓ := by
      rw [← hSpow, hSC]; exact hCle
    have h2 : ℓ ^ Module.finrank (ZMod ℓ) ↥S ≤ ℓ ^ 1 := by rw [pow_one]; exact hpow
    exact (Nat.pow_le_pow_iff_right (by omega : 1 < ℓ)).mp h2
  have hd : Module.finrank (ZMod ℓ) ↥S = 1 := le_antisymm hd2 hd1
  have hDP : Module.finrank (ZMod ℓ) (Additive ↥M) = Nat.card ↥P := by
    rw [← hformula, hEM, hd, mul_one]
  rw [hMpow, hDP]

end Work.S3
