/-!
# `Work.S3.KP_frobenius_cent` — `K ⋊ P` is a Frobenius group with kernel `K`

Peterfalvi II, Ch. V §3: in the standing context `CtxF H Q t s r P` (hypothesis (F1): `V = C_D(t)`
has a subgroup `P` of prime order with `C_G(P)` of 2-rank `1`), the product `KP` is a Frobenius
group with kernel `K = J(D,t) = Ksub H t`.

The paper records this as the opening remark of §3 ("Then `C_K(P) = 1`") and uses it in step (3)
("`KP` is a Frobenius group and `K` acts fixed-point-freely on `M`"), step (4) ("`KP` is a
Frobenius group with kernel `K`, so in `ℤ[KP]` …") and implicitly throughout.

## Proof

`Work.CharPrelim.IsFrobeniusIn X K` asks for `K ≤ X`, `K ⊴ X`, `K ≠ ⊥`, `K ≠ X` and
`C_X(h) ≤ K` for `h ∈ K^#`, where `X = K ⊔ P`.

* `K ≤ K ⊔ P` is `le_sup_left`.
* `K ⊴ K ⊔ P`: `K ⊴ D = twoPoint H t` (Ch. V §1 Prop. 2, `ChV12.Ksub_cyclic_normal`) and `P`
  normalises `K` (`P ≤ V = C_D(t)` acts on `K` by conjugation, `ChV12.conj_mem_Ksub`), so
  `K ⊔ P ≤ N_G(K)`.
* `K ≠ ⊥`: `|K| = |Inv H| ≥ 2` (`Bender.cardInvGeTwo`, `Bender.cardKsetEqInv`), via
  `ChV3.CtxF.Kset_nontrivial`.
* `K ≠ K ⊔ P`: `P ⋠ K`.  Indeed `P ≤ V = C_D(t)` and for `x ∈ K` one has `t x t⁻¹ = x⁻¹` while
  `t x t⁻¹ = x` for `x ∈ V`, so `K ∩ V = 1`; alternatively (the form used below) any `p ∈ P^#`
  lying in `K = Kset` lies in `C_G(P)`, i.e. in `Kset ∩ C_G(P) = {1}`.
* The centraliser condition is the point: `C_{K⊔P}(h) ≤ K` for `h ∈ K^#`.  The crux is

  `ChV3.Kset_inf_centralizer_eq_bot` : `Kset H t ∩ C_G(P) = {1}`

  (proved in `ThmF/ChV3/step1.lean`: if `1 ≠ x ∈ K ∩ C_G(P)` then `x` and the involution
  `u ∈ Inv H` centralised by `P` (Ch. II §4 Prop. 2 (a)) span a four-group inside `C_G(P)`,
  contradicting (F1)).  Given `x ∈ C_{K⊔P}(h)`, write `x = k * p` with `k ∈ K`, `p ∈ P`
  (using `K ≤ N_G(P)`); since `K` is cyclic (hence commutative) and `h ∈ K`, the relation
  `x h x⁻¹ = h` reduces to `p h p⁻¹ = h`, i.e. `h ∈ Kset ∩ C_G(P) = {1}` unless `p = 1`.
  Hence `x = k ∈ K`.

Source: Peterfalvi II Ch. V §3 pp. 247–248 (step 1), together with `ThmF/ChV3/step1.lean`.
-/

open scoped Pointwise

namespace Work.S3

open LeanEval.GroupTheory.Defs

/-- A subgroup of prime order is generated by each of its elements other than `1`. -/
private theorem zpowers_eq_of_prime_card {G : Type} [Group G] [Finite G] {P : Subgroup G}
    (hP : (Nat.card P).Prime) {p : G} (hp : p ∈ P) (hp1 : p ≠ 1) :
    Subgroup.zpowers p = P := by
  have hdvd : orderOf p ∣ Nat.card P := Subgroup.orderOf_dvd_natCard P hp
  have hne : orderOf p ≠ 1 := fun h => hp1 (orderOf_eq_one_iff.mp h)
  have hord : orderOf p = Nat.card P := by
    rcases hP.eq_one_or_self_of_dvd (orderOf p) hdvd with h | h
    · exact absurd h hne
    · exact h
  refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hp) ?_
  rw [Nat.card_zpowers, hord]

/-- A group of prime order is commutative: if `p ∈ P`, `p ≠ 1` commutes with `h`, then `h`
commutes with every element of `P`. -/
private theorem mem_centralizer_of_prime_card {G : Type} [Group G] [Finite G] {P : Subgroup G}
    (hP : (Nat.card P).Prime) {p h : G} (hp : p ∈ P) (hp1 : p ≠ 1) (hph : p * h = h * p) :
    h ∈ Subgroup.centralizer (P : Set G) := by
  have hzp := zpowers_eq_of_prime_card hP hp hp1
  rw [Subgroup.mem_centralizer_iff]
  intro q hq
  have hqz : q ∈ Subgroup.zpowers p := hzp ▸ hq
  exact Subgroup.mem_centralizer_singleton_iff.mp
    (Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr hph) hqz)

theorem KP_frobenius_cent {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G}
    {P : Subgroup G} (hFT : Submission.Blueprint.FeitThompsonProp)
    (hC4 : Submission.Blueprint.ChIIFourProp) (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    Work.CharPrelim.IsFrobeniusIn (Work.ThmF.Ksub H t ⊔ P) (Work.ThmF.Ksub H t) := by
  classical
  have hS : Submission.Blueprint.Situation G := c.sit
  have hsplit : Submission.Blueprint.IsSplitRankOne H Q t := c.split
  -- Ch. V §1 Prop. 2: `K` is cyclic and equal to `Kset`, and normal in `D = twoPoint H t`
  obtain ⟨hKcyc, hKsub_eq, _hKn⟩ := Work.ThmF.ChV12.Ksub_cyclic_normal hFT hC4 hS hsplit
  -- cyclic groups are commutative
  have hKcomm : IsMulCommutative ↥(Work.ThmF.Ksub H t) := by
    rw [isMulCommutative_iff]
    intro a b
    obtain ⟨g, hg⟩ := hKcyc.exists_generator
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
    rw [← hm, ← hn]
    calc g ^ m * g ^ n = g ^ (m + n) := (zpow_add g m n).symm
      _ = g ^ (n + m) := by rw [add_comm]
      _ = g ^ n * g ^ m := zpow_add g n m
  -- step (1): `K ∩ C_G(P) = 1`
  have hcrux : Work.ThmF.Kset H t ∩ (Subgroup.centralizer (P : Set G) : Set G) = {1} :=
    Work.ThmF.ChV3.Kset_inf_centralizer_eq_bot hS hC4 hsplit c.P_le c.F1
  -- `P ≤ V = C_D(t)` normalises `K = J(D,t)`
  have hPn : P ≤ Subgroup.normalizer (Work.ThmF.Ksub H t : Set G) := by
    intro p hp
    rw [Subgroup.mem_normalizer_iff]
    intro y
    constructor
    · intro hy
      exact Work.ThmF.ChV12.conj_mem_Ksub H t (c.P_le hp) y hy
    · intro hy
      have h2 := Work.ThmF.ChV12.conj_mem_Ksub H t (c.P_le (P.inv_mem hp)) (p * y * p⁻¹) hy
      have h3 : p⁻¹ * (p * y * p⁻¹) * (p⁻¹)⁻¹ = y := by group
      rwa [h3] at h2
  -- `P` is non-trivial, so it has an element `p₀ ≠ 1`
  have hPne : P ≠ ⊥ :=
    (Subgroup.one_lt_card_iff_ne_bot P).mp (by have := c.P_prime.two_le; omega)
  haveI : Nontrivial ↥P := (Subgroup.nontrivial_iff_ne_bot P).mpr hPne
  obtain ⟨p₀, hp₀1⟩ := exists_ne (1 : ↥P)
  have hp₀ : (p₀ : G) ∈ P := p₀.2
  have hp₀ne : (p₀ : G) ≠ 1 := fun h => hp₀1 (Subtype.ext h)
  -- `K` is non-trivial
  obtain ⟨k₀, hk₀, hk₀1⟩ := Work.ThmF.ChV3.CtxF.Kset_nontrivial c
  have hk₀K : k₀ ∈ Work.ThmF.Ksub H t := hKsub_eq.ge hk₀
  refine ⟨le_sup_left, ?_, ?_, ?_, ?_⟩
  · -- `K ⊴ K ⊔ P`
    refine (Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_left).mpr ?_
    exact sup_le (Subgroup.le_normalizer) hPn
  · -- `K ≠ ⊥`
    intro hbot
    exact hk₀1 (Subgroup.mem_bot.mp (hbot ▸ hk₀K))
  · -- `K ≠ K ⊔ P`, since `P ≰ K`
    intro heq
    have hpK : (p₀ : G) ∈ Work.ThmF.Ksub H t := heq.symm ▸ (Subgroup.mem_sup_right hp₀)
    have hpKset : (p₀ : G) ∈ Work.ThmF.Kset H t := hKsub_eq ▸ hpK
    have hmemP : (p₀ : G) ∈ Subgroup.centralizer (P : Set G) :=
      mem_centralizer_of_prime_card c.P_prime hp₀ hp₀ne rfl
    have : (p₀ : G) ∈ ({1} : Set G) := by
      rw [← hcrux]; exact ⟨hpKset, hmemP⟩
    exact hp₀ne (by simpa using this)
  · -- `C_{K⊔P}(h) ≤ K` for `h ∈ K^#`
    intro h hh hh1
    have hhKset : h ∈ Work.ThmF.Kset H t := hKsub_eq ▸ hh
    intro x hx
    obtain ⟨hxC, hxL⟩ := Subgroup.mem_inf.mp hx
    -- write `x = k * p` with `k ∈ K`, `p ∈ P`
    have hset : (↑(Work.ThmF.Ksub H t ⊔ P) : Set G) =
        (↑(Work.ThmF.Ksub H t) : Set G) * (↑P : Set G) :=
      Subgroup.coe_mul_of_right_le_normalizer_left (Work.ThmF.Ksub H t) P hPn
    have hxL' : x ∈ (↑(Work.ThmF.Ksub H t ⊔ P) : Set G) := hxL
    rw [hset] at hxL'
    obtain ⟨k, hk, p, hp, hkp⟩ := Set.mem_mul.mp hxL'
    have h1 : x * h = h * x := Subgroup.mem_centralizer_singleton_iff.mp hxC
    rw [← hkp] at h1
    -- `K` is commutative, so the `K`-part of `x` drops out
    have hkh : k * h = h * k := by
      have := mul_comm' (⟨k, hk⟩ : ↥(Work.ThmF.Ksub H t)) ⟨h, hh⟩
      simpa using congrArg Subtype.val this
    have h2 : p * h = h * p := by
      have h3 : k * (p * h) = k * (h * p) := by
        calc k * (p * h) = k * p * h := (mul_assoc k p h).symm
          _ = h * (k * p) := h1
          _ = h * k * p := (mul_assoc h k p).symm
          _ = k * h * p := by rw [← hkh]
          _ = k * (h * p) := mul_assoc k h p
      exact mul_left_cancel h3
    by_cases hp1 : p = 1
    · -- `x = k ∈ K`
      rw [← hkp, hp1, mul_one]
      exact hk
    · -- `p ≠ 1` commutes with `h ∈ K^#`, contradicting `K ∩ C_G(P) = 1`
      exfalso
      have hmemP : h ∈ Subgroup.centralizer (P : Set G) :=
        mem_centralizer_of_prime_card c.P_prime hp hp1 h2
      have : h ∈ ({1} : Set G) := by rw [← hcrux]; exact ⟨hhKset, hmemP⟩
      exact hh1 (by simpa using this)

end Work.S3
