open Classical

/-- **Step 1 (ring-theoretic core).**  In a semisimple ring `R`, every two-sided ideal `K` is
generated by a *central* idempotent: `K = Ideal.span {f}` with `f * f = f` and `f * x = x * f`
for all `x`.

Proof.  Let `K'` be a complement of `K` in the regular left module `R` (it exists because `R` is
semisimple) and let `p : R →ₗ[R] K` be the projection onto `K` along `K'`; put `f = p 1`.  Since
`p` is `R`-linear, `(p x : R) = x * (p 1) = x * f`, so `K = R f` and `j * f = j` for all `j ∈ K`.

For the *left* identity of `K` we use the same construction on the *right* module structure:
`K` is a two-sided ideal, hence an `Rᵐᵒᵖ`-submodule of `R`, and `Rᵐᵒᵖ` is again semisimple by
`IsSemisimpleRing` (Wedderburn–Artin).  For the corresponding projection `pr` with `f' = pr 1`
one gets `(pr x : R) = f' * x` and `f' * j = j` for `j ∈ K`.  Applying these to `f ∈ K` and
`f' ∈ K` gives `f = f' * f = f'`.  Finally, for arbitrary `x`,
`f * x = (f * x) * f = f * (x * f) = x * f`. -/
theorem ideal_eq_span_central_idempotent {R : Type*} [Ring R] [IsSemisimpleRing R]
    (K : Ideal R) [K.IsTwoSided] :
    ∃ f : R, IsIdempotentElem f ∧ (∀ x : R, f * x = x * f) ∧ K = Ideal.span {f} := by
  classical
  obtain ⟨K', hc⟩ := ComplementedLattice.exists_isCompl (K : Submodule R R)
  let p := Submodule.projectionOnto (K : Submodule R R) K' hc
  let f : R := ((p (1 : R) : ↥(K : Submodule R R)) : R)
  have hpf : ∀ x : R, ((p x : ↥(K : Submodule R R)) : R) = x * f := by
    intro x
    have hx : x • (1 : R) = x := by rw [smul_eq_mul, mul_one]
    calc ((p x : ↥(K : Submodule R R)) : R)
        = ((p (x • (1 : R)) : ↥(K : Submodule R R)) : R) := by rw [hx]
      _ = ((x • p (1 : R) : ↥(K : Submodule R R)) : R) := by rw [map_smul]
      _ = x * f := by rw [Submodule.coe_smul, smul_eq_mul]
  have hfmem : f ∈ K := (p (1 : R) : ↥(K : Submodule R R)).2
  have hright : ∀ j ∈ K, j * f = j := by
    intro j hj
    have h1 : p j = ⟨j, hj⟩ := Submodule.projectionOnto_apply_of_mem_left hc hj
    have h2 := hpf j
    rw [h1] at h2
    simpa using h2.symm
  have hff : IsIdempotentElem f := by
    show f * f = f
    exact hright f hfmem
  -- the same construction for the opposite (right) module structure
  let Kop : Submodule Rᵐᵒᵖ R :=
    { carrier := K
      zero_mem' := K.zero_mem
      add_mem' := fun ha hb => K.add_mem ha hb
      smul_mem' := fun a b hb => by
        show b * (MulOpposite.unop a) ∈ K
        exact Ideal.mul_mem_right _ K hb }
  obtain ⟨Kop', hc2⟩ := ComplementedLattice.exists_isCompl Kop
  let pr := Submodule.projectionOnto Kop Kop' hc2
  let f' : R := ((pr (1 : R) : ↥Kop) : R)
  have hprf : ∀ x : R, ((pr x : ↥Kop) : R) = f' * x := by
    intro x
    have hx : (MulOpposite.op x) • (1 : R) = x := by
      rw [show ((MulOpposite.op x) • (1 : R)) = (1 : R) * x from rfl, one_mul]
    calc ((pr x : ↥Kop) : R)
        = ((pr ((MulOpposite.op x) • (1 : R)) : ↥Kop) : R) := by rw [hx]
      _ = (((MulOpposite.op x) • pr (1 : R) : ↥Kop) : R) := by rw [map_smul]
      _ = f' * x := by
        rw [Submodule.coe_smul]
        show (MulOpposite.op x) • ((pr (1 : R) : ↥Kop) : R) = ((pr (1 : R) : ↥Kop) : R) * x
        rfl
  have hleft : ∀ j ∈ K, f' * j = j := by
    intro j hj
    have h1 : pr j = ⟨j, hj⟩ := Submodule.projectionOnto_apply_of_mem_left hc2 hj
    have h2 := hprf j
    rw [h1] at h2
    simpa using h2.symm
  have hf'mem : f' ∈ K := (pr (1 : R) : ↥Kop).2
  have hfff : f = f' := by
    have h1 : f = f' * f := (hleft f hfmem).symm
    have h2 : f' = f' * f := (hright f' hf'mem).symm
    exact h1.trans h2.symm
  have hcent : ∀ x : R, f' * x = x * f' := by
    intro x
    have hmem1 : f' * x ∈ K := Ideal.mul_mem_right x K hf'mem
    have hmem2 : x * f ∈ K := K.mul_mem_left x hfmem
    have h1 : (f' * x) * f = f' * x := hright (f' * x) hmem1
    have h2 : f' * (x * f) = x * f := hleft (x * f) hmem2
    calc f' * x = (f' * x) * f := h1.symm
      _ = f' * (x * f) := mul_assoc _ _ _
      _ = x * f := h2
      _ = x * f' := by rw [hfff]
  refine ⟨f, hff, ?_, ?_⟩
  · intro x
    simpa [hfff] using hcent x
  · apply le_antisymm
    · intro j hj
      rw [← hright j hj]
      exact Ideal.mul_mem_left _ j (Ideal.subset_span (Set.mem_singleton f))
    · exact (Ideal.span_singleton_le_iff_mem K).mpr hfmem

/-- **Step 2–3 (block-theoretic core).**  Let `R` be a semisimple ring, `e` a primitive central
idempotent and `I` a two-sided ideal not containing `e`.  Then no non-zero element of the block
`Re = {x | x * e = x}` annihilates `I`-side: more precisely `x ∈ I` and `x * e = x` force `x = 0`.

Proof.  By Step 1, `I = Ideal.span {f}` for a central idempotent `f`; then `x ∈ I` gives
`x * f = x`.  The product `g = e * f` is again a central idempotent with `g * e = g`, so
primitivity of `e` gives `g = 0` or `g = e`.  In the first case `x = x * f = (x * e) * f = x * g = 0`,
in the second `e = e * f ∈ I`, contradicting the hypothesis. -/
theorem eq_zero_of_mem_ideal_of_mul_eq_self {R : Type*} [Ring R] [IsSemisimpleRing R]
    (e : R) (he : Work.Hering.AppVII.IsPrimitiveCentralIdempotent e)
    (I : Ideal R) [I.IsTwoSided] (heI : e ∉ I) :
    ∀ x : R, x ∈ I → x * e = x → x = 0 := by
  intro x hxI hxe
  obtain ⟨f, hfid, hfcent, hI⟩ := ideal_eq_span_central_idempotent I
  have hfI : f ∈ I := by rw [hI]; exact Ideal.subset_span (Set.mem_singleton f)
  have hxf : x * f = x := by
    rw [hI, ← Ideal.submodule_span_eq, Submodule.mem_span_singleton] at hxI
    obtain ⟨a, ha⟩ := hxI
    rw [← ha, smul_eq_mul, mul_assoc, hfid]
  set g : R := e * f with hgdef
  have hgid : IsIdempotentElem g := by
    show g * g = g
    rw [hgdef]
    have hc : Commute f e := hfcent e
    rw [hc.mul_mul_mul_comm e f, he.1.1, hfid]
  have hgcent : ∀ y : R, y * g = g * y := by
    intro y
    rw [hgdef]
    calc y * (e * f) = (y * e) * f := by rw [mul_assoc]
      _ = (e * y) * f := by rw [he.1.2 y]
      _ = e * (y * f) := by rw [mul_assoc]
      _ = e * (f * y) := by rw [hfcent y]
      _ = (e * f) * y := by rw [mul_assoc]
  have hge : g * e = g := by
    rw [hgdef, mul_assoc, hfcent e, ← mul_assoc, he.1.1]
  rcases he.2.2 g ⟨hgid, hgcent⟩ hge with hg0 | hge'
  · have hxg : x = x * g := by
      calc x = x * f := hxf.symm
        _ = (x * e) * f := by rw [hxe]
        _ = x * (e * f) := by rw [mul_assoc]
        _ = x * g := by rw [hgdef]
    rw [hxg, hg0, mul_zero]
  · exfalso
    apply heI
    rw [← hge']
    exact I.mul_mem_left e hfI

/-- **Injectivity of the block action on its irreducible module** (auxiliary form, taking
primitivity of the idempotent as a hypothesis).

`k = F̄_r`, `r ∤ |A|`, `e = toK hcop χ hχ ∈ k[A]` a **primitive** central idempotent which acts
as the identity on the irreducible `k[A]`-module `V ≠ 0`.  Then the annihilator of `V` inside
the block `k[A]e` is trivial: `x ∈ k[A]` with `x·e = x` and `ρ.asAlgebraHom x = 0` is `0`.

Route (all ingredients are in Mathlib): `k[A]` is semisimple (Maschke; `(Nat.card A : k) ≠ 0`
follows from `hcop`).

*Step 1* — in a semisimple ring `R`, every **two-sided** ideal `J` (`J.IsTwoSided`) is generated
by a *central* idempotent.  Let `p := Submodule.projectionOnto _ _ hc : R →ₗ[R] J` be the
projection onto `J` of the left module `R` (existence of the complement `J'`:
`ComplementedLattice.exists_isCompl`, available because `IsSemisimpleRing R` is
`IsSemisimpleModule R R`), and `f := (p 1 : R)`.  Then `(p x : R) = x * f` for all `x`
(`p` is `R`-linear and `x • 1 = x`), `f * f = f` (since `p` fixes `J`, use
`Submodule.projectionOnto_apply_of_mem_left`), and `j * f = j` for `j ∈ J`.  Using that `R` is
also semisimple as a right module over itself (`isSemisimpleRing_mulOpposite_iff`; the right
ideal `J` is an `Rᵐᵒᵖ`-submodule because `J` is two-sided), let `pr` be the corresponding
projection and `f' := (pr 1 : R)`; then `f' * j = j` for `j ∈ J`.  Hence
`f' = f' * f = f = f * f'`, so `f` is a two-sided identity of `J`, and for any `a`:
`f * a = (f * a) * f = f * a * f` and `a * f = f * (a * f) = f * a * f`, so `f` is central;
clearly `J = Ideal.span {f}`.

*Step 2* — `e` primitive central makes the block `k[A]e` simple: a two-sided ideal `J` of the
block ring is a two-sided ideal of `k[A]` (because `k[A]·J·k[A] = J`, using `x·e = x`), so by
Step 1 `J = k[A]·f` for a central idempotent `f` of `k[A]`; necessarily `f·e = f` and
primitivity forces `f = 0` or `f = e`.

*Step 3* — `Ann(V) ∩ k[A]e` is a two-sided ideal of the block, and it is not the whole block
because `e` acts as the identity on `V ≠ 0` (`hblock`); by Step 2 it is `0`.  Since
`x·e = x` says exactly `x ∈ k[A]e`, and `ρ.asAlgebraHom x = 0` says `x ∈ Ann(V)`, the
conclusion follows.

(`V ≠ 0` is automatic: `Representation.IsIrreducible = IsSimpleOrder (Subrepresentation ρ)`
extends `Nontrivial`.) -/
theorem BlockInjectivePrim {A : Type*} [Group A] [Fintype A] {r : ℕ} [Fact r.Prime]
    (hcop : Nat.Coprime r (Nat.card A))
    (χ : A → ℂ) (hχ : χ ∈ Work.CharCore.Irr A)
    (hprim : Work.Hering.AppVII.IsPrimitiveCentralIdempotent
      (Work.Hering.AppVII.toK hcop χ hχ))
    {V : Type*} [AddCommGroup V] [Module (Work.Hering.AppVII.BrauerField r) V]
    [Module.Finite (Work.Hering.AppVII.BrauerField r) V]
    (ρ : Representation (Work.Hering.AppVII.BrauerField r) A V) (hρ : ρ.IsIrreducible)
    (hblock : ρ.asAlgebraHom (Work.Hering.AppVII.toK hcop χ hχ) = 1) :
    ∀ x : MonoidAlgebra (Work.Hering.AppVII.BrauerField r) A,
      x * Work.Hering.AppVII.toK hcop χ hχ = x → ρ.asAlgebraHom x = 0 → x = 0 := by
  intro x hxe hx0
  have hcard : (Nat.card A : Work.Hering.AppVII.BrauerField r) ≠ 0 := by
    intro h
    exact Work.Hering.AppVII.not_dvd_card hcop
      ((CharP.cast_eq_zero_iff (Work.Hering.AppVII.BrauerField r) r (Nat.card A)).mp h)
  have _inst_neZero : NeZero (Nat.card A : Work.Hering.AppVII.BrauerField r) := ⟨hcard⟩
  have _inst_ss : IsSemisimpleRing (MonoidAlgebra (Work.Hering.AppVII.BrauerField r) A) := inferInstance
  have heI : Work.Hering.AppVII.toK hcop χ hχ ∉
      RingHom.ker (ρ.asAlgebraHom : MonoidAlgebra (Work.Hering.AppVII.BrauerField r) A →+*
        Module.End (Work.Hering.AppVII.BrauerField r) V) := by
    intro hmem
    have h1 : ρ.asAlgebraHom (Work.Hering.AppVII.toK hcop χ hχ) = 0 := by
      simpa using RingHom.mem_ker.mp hmem
    rw [hblock] at h1
    have _inst_nt : Nontrivial V := by
      have _inst_sm : IsSimpleModule (MonoidAlgebra (Work.Hering.AppVII.BrauerField r) A) ρ.asModule :=
        inferInstance
      exact (IsSimpleModule.nontrivial (MonoidAlgebra (Work.Hering.AppVII.BrauerField r) A)
        ρ.asModule : Nontrivial V)
    obtain ⟨v, hv⟩ := exists_ne (0 : V)
    refine hv ?_
    have h2 := congrArg (fun (f : Module.End (Work.Hering.AppVII.BrauerField r) V) => f v) h1
    simpa using h2
  exact eq_zero_of_mem_ideal_of_mul_eq_self (Work.Hering.AppVII.toK hcop χ hχ) hprim
    (RingHom.ker (ρ.asAlgebraHom : MonoidAlgebra (Work.Hering.AppVII.BrauerField r) A →+*
      Module.End (Work.Hering.AppVII.BrauerField r) V))
    heI x (RingHom.mem_ker.mpr hx0) hxe

end

end Work.NormalComplement.AppVII
