namespace Work.NormalComplement

open Classical

variable {G : Type*} [Group G]

/-- `O^p(W)` (in the sense of `Work.Grun.pResidual`) is the subgroup generated by the elements of
`W` whose order is prime to `p`, as a subgroup of the ambient group. -/
private lemma pResidual_eq_closure_of_pPrimeElems (p : ℕ) (W : Subgroup G) :
    Work.Grun.pResidual p W = Subgroup.closure {x : G | x ∈ W ∧ ¬ p ∣ orderOf x} := by
  unfold Work.Grun.pResidual
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.2, hy⟩
  · rintro ⟨hxW, hx⟩
    exact ⟨⟨x, hxW⟩, hx, rfl⟩

/-- The relative index of `O^p(W)` in `W` is a power of `p`: it is the order of the `p`-group
quotient `W ⧸ O^p(W)`. -/
private lemma exists_pow_relIndex_pResidual [Finite G] {p : ℕ} [Fact p.Prime]
    (W : Subgroup G) : ∃ n, (Work.Grun.pResidual p W).relIndex W = p ^ n := by
  have hmap := Work.Grun.pResidual_eq_map_pResidual p W
  have hsub : (Work.Grun.pResidual p W).subgroupOf W = Work.NPC.Frobenius.pResidual p ↥W := by
    change Subgroup.comap W.subtype (Work.Grun.pResidual p W) = Work.NPC.Frobenius.pResidual p ↥W
    rw [hmap]
    exact Subgroup.comap_map_eq_self_of_injective W.subtype_injective _
  obtain ⟨n, hn⟩ :=
    IsPGroup.exists_card_eq (Work.NPC.Frobenius.isPGroup_quotient_pResidual (G := ↥W) (p := p))
  refine ⟨n, ?_⟩
  show (Subgroup.subgroupOf (Work.Grun.pResidual p W) W).index = p ^ n
  rw [hsub, Subgroup.index_eq_card]
  exact hn

/-- A natural number dividing `p ^ n` that is not divisible by the prime `p` is `1`. -/
private lemma eq_one_of_dvd_pow_of_not_dvd {p d : ℕ} (hp : p.Prime) {n : ℕ}
    (hdvd : d ∣ p ^ n) (hnd : ¬ p ∣ d) : d = 1 := by
  have hcop : d.Coprime (p ^ n) := ((hp.coprime_iff_not_dvd.mpr hnd).symm).pow_right n
  have h1 : d ∣ 1 := hcop.dvd_of_dvd_mul_left (by rwa [mul_one])
  exact Nat.dvd_one.mp h1

/-- Peterfalvi I Ch. III §1, the *Strategy* (p.175): if `E ≤ W ∩ D` contains a Sylow `p`-subgroup
of `W` and `y ∈ W` witnesses `O^p(W) ≠ W`, then `O^p(W)` is a strictly smaller normal subgroup of
any `H` normalising `W`, still multiplied up to `H` by `D`.

Hints (all ingredients exist in the workspace):
* `Work.Grun.pResidual_eq_map_pResidual : pResidual p W = (Work.NPC.Frobenius.pResidual p ↥W).map W.subtype`
  (in `Submission.Work.Grun.Main`);
* `Work.NPC.Frobenius.isPGroup_quotient_pResidual : IsPGroup p (↥W ⧸ pResidual p (↥W))`, so
  `[W : O^p(W)] = p ^ k` (`Subgroup.index_eq_card` + `Subgroup.relIndex_top_right` +
  `Subgroup.relIndex_map_map_of_injective`);
* `Subgroup.relIndex_mul_relIndex (H := ·) (K := ·) (L := W)` gives
  `[W : O^p(W) ⊔ E] ∣ [W : O^p(W)]` and `∣ [W : E]`; the first is a `p`-power, the second is prime to
  `p` by `hE`, so the index is `1` (`Nat.Coprime.gcd_eq_one`, `Nat.dvd_gcd`, `Nat.dvd_one`);
  `Subgroup.relIndex_eq_one` then gives `W ≤ O^p(W) ⊔ E`;
* for normality use `conj g (pResidual p W) = pResidual p (conj g W)` (conjugation commutes with
  `pResidual`, since `orderOf` is conjugation-invariant) together with `hHn`. -/
theorem pResidual_strategy {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {E W D H : Subgroup G} {y : G}
    (hEW : E ≤ W) (hED : E ≤ D) (hE : ¬ p ∣ (E.subgroupOf W).index) (hWH : W ≤ H)
    (hHn : H ≤ Subgroup.normalizer (W : Set G)) (hWD : W ⊔ D = H)
    (hyW : y ∈ W) (hy : y ∉ Work.Grun.pResidual p W) :
    ∃ W₁ : Subgroup G, W₁ < W ∧ W₁ ≤ H ∧ H ≤ Subgroup.normalizer (W₁ : Set G) ∧
      W₁ ⊔ D = H := by
  set K : Subgroup G := Work.Grun.pResidual p W with hKdef
  have hKle : K ≤ W := by rw [hKdef]; exact Work.Grun.pResidual_le p W
  have hyK : y ∉ K := by rw [hKdef]; exact hy
  have hKne : K ≠ W := by
    intro h
    rw [h] at hyK
    exact hyK hyW
  -- The heart of the argument: `[W : O^p(W) ⊔ E]` divides both the `p`-power `[W : O^p(W)]`
  -- and the `p'`-number `[W : E]`, hence equals `1`, i.e. `W ≤ O^p(W) ⊔ E`.
  have hWle : W ≤ K ⊔ E := by
    have hK'W : K ⊔ E ≤ W := sup_le hKle hEW
    have hd1 : (K ⊔ E).relIndex W ∣ K.relIndex W := by
      have h := Subgroup.relIndex_mul_relIndex K (K ⊔ E) W le_sup_left hK'W
      exact ⟨K.relIndex (K ⊔ E), by rw [mul_comm]; exact h.symm⟩
    have hd2 : (K ⊔ E).relIndex W ∣ E.relIndex W := by
      have h := Subgroup.relIndex_mul_relIndex E (K ⊔ E) W le_sup_right hK'W
      exact ⟨E.relIndex (K ⊔ E), by rw [mul_comm]; exact h.symm⟩
    obtain ⟨n, hn⟩ := exists_pow_relIndex_pResidual (G := G) (p := p) W
    have hn' : K.relIndex W = p ^ n := by rw [hKdef]; exact hn
    have hE' : ¬ p ∣ E.relIndex W := hE
    have hnotp : ¬ p ∣ (K ⊔ E).relIndex W := by
      intro hp
      obtain ⟨c, hc⟩ := hd2
      exact hE' (hc ▸ dvd_mul_of_dvd_left hp c)
    have hone : (K ⊔ E).relIndex W = 1 :=
      eq_one_of_dvd_pow_of_not_dvd (Fact.out : p.Prime) (hn' ▸ hd1) hnotp
    exact Subgroup.relIndex_eq_one.mp hone
  refine ⟨K, lt_of_le_of_ne hKle hKne, hKle.trans hWH, ?_, ?_⟩
  · -- Normality: `O^p(W)` is generated by the `p'`-elements of `W`, which `H ≤ N_G(W)`
    -- permutes among themselves.
    have hKT : K = Subgroup.closure {x : G | x ∈ W ∧ ¬ p ∣ orderOf x} := by
      rw [hKdef]; exact pResidual_eq_closure_of_pPrimeElems p W
    rw [hKT, Subgroup.le_normalizer_closure_iff]
    intro h hh x hx
    have hWnorm : ∀ a ∈ H, ∀ b ∈ W, a * b * a⁻¹ ∈ W := Subgroup.le_set_normalizer_iff.mp hHn
    have hconjW : h * x * h⁻¹ ∈ W := hWnorm h hh x hx.1
    have hord : orderOf (h * x * h⁻¹) = orderOf x := by
      rw [← MulAut.conj_apply]
      exact orderOf_injective ((MulAut.conj h : G ≃* G) : G →* G) (MulAut.conj h).injective x
    exact Subgroup.subset_closure ⟨hconjW, by rw [hord]; exact hx.2⟩
  · -- `O^p(W) · D = H`, since `W ≤ O^p(W) ⊔ E ≤ O^p(W) ⊔ D`.
    refine le_antisymm (sup_le (hKle.trans hWH) (hWD ▸ le_sup_right)) ?_
    rw [← hWD]
    exact sup_le (hWle.trans (sup_le_sup_left hED K)) le_sup_right

end Work.NormalComplement
