/-- A finite product of real numbers in `[0,1]` is bounded by each of its factors.  (The
corresponding Mathlib lemma `Finset.prod_eq_one_iff_of_le_one` is stated for an `IsOrderedMonoid`,
which `ℝ` is not, so we prove the one inequality we need directly.) -/
lemma prod_le_of_forall_le_one {ι : Type*} [Fintype ι] {f : ι → ℝ} (h0 : ∀ i, 0 ≤ f i)
    (h1 : ∀ i, f i ≤ 1) (j : ι) : ∏ i, f i ≤ f j := by
  classical
  rw [← Finset.mul_prod_erase Finset.univ f (Finset.mem_univ j)]
  exact mul_le_of_le_one_right (h0 j) (Finset.prod_le_one₀ (fun i _ => h0 i) (fun i _ => h1 i))

/-- **Huppert *Endliche Gruppen I* V.7.1**, `Fin`-indexed form (the shape of
`Work.CharCore.isIntegral_average_rootsOfUnity`): the average of `d > 0` roots of unity that is
integral over `ℤ` is either zero or of modulus `1`.

Proof.  Let `K := ℚ(ε i : i) ⊆ ℂ` be the subfield of `ℂ` generated by the `ε i`, a finite extension
of `ℚ` (every `ε i` is a root of a monic integral polynomial, hence integral over `ℚ`), separable
as `ℚ` has characteristic `0`.  Write `ε' i` for `ε i` viewed in `K` and
`c' := (d:K)⁻¹ * ∑ i, ε' i`, so that `algebraMap K ℂ c' = (d:ℂ)⁻¹ * ∑ i, ε i`; by hypothesis `c'`
is integral over `ℤ`.  Then `N := Algebra.norm ℚ c'` is a rational number integral over `ℤ`, i.e. an
integer `m`, and `Algebra.norm_eq_prod_embeddings` gives
`(m:ℂ) = ∏ σ : K →ₐ[ℚ] ℂ, σ c'`.  For any such `σ` and any `i`, from `(ε i)^n = 1` we get
`(σ (ε' i))^n = 1`, so `‖σ (ε' i)‖ = 1`; hence `‖σ c'‖ ≤ 1` by the triangle inequality.  If
`∑ i, ε i ≠ 0` then `c' ≠ 0`, so every `σ c' ≠ 0` and `m ≠ 0`, whence
`1 ≤ |m| = ‖(m:ℂ)‖ = ∏ σ, ‖σ c'‖`, while every factor is `≤ 1`: the factor belonging to the
inclusion `K ↪ ℂ`, which is `‖(d:ℂ)⁻¹ * ∑ i, ε i‖`, must therefore be `1`. -/
theorem isIntegral_average_rootsOfUnity {d : ℕ} (hd : 0 < d) (ε : Fin d → ℂ)
    (hε : ∀ i, ∃ n : ℕ, 0 < n ∧ ε i ^ n = 1)
    (hint : IsIntegral ℤ ((d : ℂ)⁻¹ * ∑ i, ε i)) :
    (∑ i, ε i = 0) ∨ ‖(d : ℂ)⁻¹ * ∑ i, ε i‖ = 1 := by
  classical
  -- The number field generated by the `ε i` inside `ℂ`.
  let K : IntermediateField ℚ ℂ := IntermediateField.adjoin ℚ (Set.range ε)
  have hmemK : ∀ i, ε i ∈ K := fun i => IntermediateField.subset_adjoin ℚ (Set.range ε) ⟨i, rfl⟩
  let ε' : Fin d → K := fun i => ⟨ε i, hmemK i⟩
  let c' : K := (d : K)⁻¹ * ∑ i, ε' i
  have hcoe : algebraMap K ℂ c' = (d : ℂ)⁻¹ * ∑ i, ε i := by simp [c', ε']
  -- `c'` is integral over `ℤ`, by transporting the hypothesis along the embedding `K ↪ ℂ`.
  have hc'int : IsIntegral ℤ c' := by
    refine (isIntegral_algebraMap_iff (R := ℤ) (A := K) (B := ℂ)).mp ?_
    rw [hcoe]; exact hint
  -- `K` is a finite (hence separable, char `0`) extension of `ℚ`: the `ε i` are roots of unity.
  have hfin : FiniteDimensional ℚ K := by
    apply IntermediateField.finiteDimensional_adjoin
    rintro x ⟨i, rfl⟩
    obtain ⟨n, hn, hεn⟩ := hε i
    exact IsIntegral.of_pow hn (by rw [hεn]; exact isIntegral_one)
  have : FiniteDimensional ℚ K := hfin
  have : Algebra.IsSeparable ℚ K := inferInstance
  -- The norm of `c'` is a rational integer `m`.
  have hNint : IsIntegral ℤ (Algebra.norm ℚ c') := Algebra.isIntegral_norm ℚ hc'int
  obtain ⟨m, hm⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral (R := ℤ) (K := ℚ) hNint
  -- ... and it is the product of the conjugates of `c'`.
  have hmain : (m : ℂ) = ∏ σ : K →ₐ[ℚ] ℂ, σ c' := by
    have h := Algebra.norm_eq_prod_embeddings (K := ℚ) (L := K) ℂ c'
    rw [← hm] at h
    simpa using h
  have hnorm : ‖(m : ℂ)‖ = ∏ σ : K →ₐ[ℚ] ℂ, ‖σ c'‖ := by
    rw [hmain, norm_prod]
  -- Every conjugate of `c'` is an average of roots of unity, hence has modulus at most `1`.
  have hbound : ∀ σ : K →ₐ[ℚ] ℂ, ‖σ c'‖ ≤ 1 := by
    intro σ
    have hσc : σ c' = (d : ℂ)⁻¹ * ∑ i, σ (ε' i) := by
      simp [c', map_sum, map_inv₀]
    have h1 : ∀ i, ‖σ (ε' i)‖ = 1 := by
      intro i
      obtain ⟨n, hn, hεn⟩ := hε i
      have hpow : (ε' i) ^ n = 1 := Subtype.ext (by simpa [ε'] using hεn)
      have hpows : (σ (ε' i)) ^ n = 1 := by rw [← map_pow, hpow, map_one]
      have hnormp : ‖σ (ε' i)‖ ^ n = 1 := by rw [← norm_pow, hpows]; simp
      exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) hn.ne').mp hnormp
    rw [hσc, norm_mul, norm_inv, Complex.norm_natCast]
    have hdR : (0 : ℝ) < d := by exact_mod_cast hd
    have hsum : ‖∑ i, σ (ε' i)‖ ≤ (d : ℝ) := by
      calc ‖∑ i, σ (ε' i)‖ ≤ ∑ i, ‖σ (ε' i)‖ := norm_sum_le _ _
        _ = ∑ _i : Fin d, (1 : ℝ) := by simp [h1]
        _ = d := by simp
    calc (d : ℝ)⁻¹ * ‖∑ i, σ (ε' i)‖ ≤ (d : ℝ)⁻¹ * d := by
          exact mul_le_mul_of_nonneg_left hsum (inv_nonneg.mpr hdR.le)
      _ = 1 := inv_mul_cancel₀ (ne_of_gt hdR)
  rcases eq_or_ne (∑ i, ε i) 0 with hzero | hzero
  · exact Or.inl hzero
  · right
    -- If the sum is nonzero then `c' ≠ 0`, so the norm `m` is a nonzero integer.
    have hc'ne : c' ≠ 0 := by
      intro h
      have h2 : (d : ℂ)⁻¹ * ∑ i, ε i = 0 := by rw [← hcoe, h, map_zero]
      rcases mul_eq_zero.mp h2 with h3 | h3
      · exact absurd h3 (inv_ne_zero (by exact_mod_cast hd.ne'))
      · exact hzero h3
    have hmne : m ≠ 0 := by
      have hA : (m : ℂ) ≠ 0 := by
        rw [hmain]
        exact Finset.prod_ne_zero_iff.mpr (fun σ _ => (map_ne_zero σ).mpr hc'ne)
      exact Int.cast_ne_zero.mp hA
    have h1le : (1 : ℝ) ≤ ‖(m : ℂ)‖ := by
      rw [Complex.norm_intCast]
      exact_mod_cast Int.one_le_abs hmne
    -- `1 ≤ ∏ σ, ‖σ c'‖ ≤ ‖c'‖` with `‖σ c'‖ ≤ 1` forces `‖c'‖ = 1`, i.e. `‖c‖ = 1` for `c` the
    -- average in `ℂ` (the factor of the inclusion `K ↪ ℂ`).
    have hle : ∏ σ : K →ₐ[ℚ] ℂ, ‖σ c'‖ ≤ ‖(IsScalarTower.toAlgHom ℚ K ℂ) c'‖ :=
      prod_le_of_forall_le_one (fun σ => norm_nonneg _) hbound _
    rw [hnorm] at h1le
    have heq : ‖(IsScalarTower.toAlgHom ℚ K ℂ) c'‖ = 1 :=
      le_antisymm (hbound _) (h1le.trans hle)
    rw [IsScalarTower.toAlgHom_apply] at heq
    simpa [hcoe] using heq

end Work.NormalComplement
