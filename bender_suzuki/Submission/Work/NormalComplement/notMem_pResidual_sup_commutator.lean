/-
# A `p`-element outside the commutator subgroup is outside `O^p(E) · [E,E]`

Let `E` be a subgroup of a finite group `G` and let `y ∈ E` be a non-trivial element of
`p`-power order lying outside the derived subgroup `⁅E, E⁆`.  Then `y` does not lie in the
subgroup generated by `O^p(E) = Work.Grun.pResidual p E` (the subgroup of `E` generated by its
`p'`-elements) together with `⁅E, E⁆`.

The proof is a reduction to the abelian case.  Since `⁅E,E⁆` is the kernel of the abelianisation
`Abelianization.of : E →* Abelianization E`, the image `ā = Abelianization.of y` is non-trivial.
Its order divides a power of `p`, so it is again a `p`-power.  On the other hand each `p'`-element
of `E` has image an element of order coprime to `p`, so the image of `O^p(E)` is contained in the
subgroup generated by the `p'`-elements of the (abelian) group `Abelianization E`; by
`notMem_closure_prime_order` this subgroup contains no non-trivial element of `p`-power order.
Hence `ā` is not in the image of `O^p(E) ⊔ ⁅E,E⁆`, and neither is `y`.
-/
import Mathlib
import Submission.Work.Grun.pResidual

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

open scoped commutatorElement

namespace Work.NormalComplement

/-- In a commutative group, the elements of order coprime to `p` are closed under multiplication
and inversion (`Commute.orderOf_mul_dvd_lcm` together with primality of `p`), so the subgroup
they generate consists only of such elements; hence a non-trivial element whose order is a power
of `p` does not lie in that subgroup. -/
theorem notMem_closure_prime_order {A : Type*} [CommGroup A] {p : ℕ} [Fact p.Prime]
    {a : A} (ha1 : a ≠ 1) (hord : ∃ k : ℕ, orderOf a = p ^ k) :
    a ∉ Subgroup.closure {x : A | ¬ p ∣ orderOf x} := by
  have hp : p.Prime := Fact.out
  obtain ⟨k, hk⟩ := hord
  have hk0 : k ≠ 0 := by
    rintro rfl
    rw [pow_zero] at hk
    exact ha1 (orderOf_eq_one_iff.mp hk)
  intro hmem
  have hprop : ¬ p ∣ orderOf a := by
    refine Subgroup.closure_induction (fun x hx => hx) ?_ ?_ ?_ hmem
    · rw [orderOf_one]
      exact hp.not_dvd_one
    · intro x y _ _ ihx ihy hcon
      rcases (hp.dvd_lcm).mp (hcon.trans (Commute.all x y).orderOf_mul_dvd_lcm) with h | h
      · exact ihx h
      · exact ihy h
    · intro x _ ihx hcon
      rw [orderOf_inv] at hcon
      exact ihx hcon
  exact hprop (by rw [hk]; exact dvd_pow_self p hk0)

/-- **A `p`-element outside `⁅E,E⁆` stays outside `Work.Grun.pResidual p E ⊔ ⁅E, E⁆`.** -/
theorem notMem_pResidual_sup_commutator {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {E : Subgroup G} {y : G} (hyE : y ∈ E) (hy1 : y ≠ 1)
    (hord : ∃ k : ℕ, orderOf y = p ^ k) (hy' : y ∉ ⁅E, E⁆) :
    y ∉ Work.Grun.pResidual p E ⊔ ⁅E, E⁆ := by
  set θ : E →* Abelianization E := Abelianization.of with hθ
  set T : Set (Abelianization E) := {x | ¬ p ∣ orderOf x} with hT
  let yE : E := ⟨y, hyE⟩
  have hkerθ : θ.ker = commutator E := by rw [hθ]; exact Abelianization.ker_of E
  -- `⁅E,E⁆` is the image of the commutator subgroup of `E` under the inclusion
  have hmap_top : (⊤ : Subgroup E).map E.subtype = E := by
    ext x
    constructor
    · intro hx
      obtain ⟨e, -, he⟩ := Subgroup.mem_map.mp hx
      exact he ▸ e.2
    · intro hx
      exact Subgroup.mem_map_of_mem E.subtype (Subgroup.mem_top (⟨x, hx⟩ : E))
  have hcomm_map : (commutator E).map E.subtype = ⁅E, E⁆ := by
    rw [commutator_def, Subgroup.map_commutator, hmap_top]
  -- the image of `y` in the abelianisation is non-trivial
  have hθy1 : θ yE ≠ 1 := by
    intro h1
    have hmem : yE ∈ commutator E := by
      rw [← hkerθ, MonoidHom.mem_ker]
      exact h1
    have h2 : E.subtype yE ∈ (commutator E).map E.subtype :=
      Subgroup.mem_map_of_mem E.subtype hmem
    rw [hcomm_map] at h2
    exact hy' h2
  -- ... and has `p`-power order
  have hordθ : ∃ j : ℕ, orderOf (θ yE) = p ^ j := by
    obtain ⟨k, hk⟩ := hord
    have hyEord : orderOf yE = p ^ k := (Subgroup.orderOf_coe yE).symm.trans hk
    have hdvd : orderOf (θ yE) ∣ p ^ k := by
      have := orderOf_map_dvd θ yE
      rwa [hyEord] at this
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp hdvd
    exact ⟨j, hj⟩
  have hcore : θ yE ∉ Subgroup.closure T := by
    rw [hT]
    exact notMem_closure_prime_order hθy1 hordθ
  -- the subgroup of `E` mapping into the `p'`-part of the abelianisation
  -- contains both `O^p(E)` and `⁅E,E⁆`
  have hP : Work.Grun.pResidual p E ≤
      (Subgroup.comap θ (Subgroup.closure T)).map E.subtype := by
    rw [Work.Grun.pResidual]
    rw [Subgroup.map_le_map_iff_of_injective E.subtype_injective]
    refine (Subgroup.closure_le _).mpr ?_
    intro z hz
    change θ z ∈ Subgroup.closure T
    apply Subgroup.subset_closure
    rw [hT]
    intro hdvd
    exact hz (by rw [Subgroup.orderOf_coe z]; exact hdvd.trans (orderOf_map_dvd θ z))
  have hN : ⁅E, E⁆ ≤ (Subgroup.comap θ (Subgroup.closure T)).map E.subtype := by
    rw [← hcomm_map]
    refine Subgroup.map_mono ?_
    intro z hz
    rw [Subgroup.mem_comap]
    have hz1 : θ z = 1 := by
      rw [← MonoidHom.mem_ker, hkerθ]
      exact hz
    rw [hz1]
    exact Subgroup.one_mem _
  intro hyM
  have hyL : y ∈ (Subgroup.comap θ (Subgroup.closure T)).map E.subtype :=
    (sup_le hP hN) hyM
  have hyL' : E.subtype yE ∈ (Subgroup.comap θ (Subgroup.closure T)).map E.subtype := hyL
  have hyEL : yE ∈ Subgroup.comap θ (Subgroup.closure T) :=
    (Subgroup.mem_map_iff_mem (f := E.subtype) E.subtype_injective).mp hyL'
  exact hcore ((Subgroup.mem_comap).mp hyEL)

end Work.NormalComplement
