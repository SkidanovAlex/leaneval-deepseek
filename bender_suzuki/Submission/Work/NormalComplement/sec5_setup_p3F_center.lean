/-! ## The counting lemma for the subgroup generated by an odd-index 2-subgroup

Auxiliary general fact used in the proof of `sec5_setup_p3F_center`: if `S` is a normal subgroup
of `M = H ⊓ N` whose index in `M` is odd (here: `|M| = |S| · |D ⊓ N|` with `|D|` odd and
`D ⊓ N ≤ N_G(S)`), then every involution of `M` already lies in `S`. -/

/-- If `|H ⊓ N| = |S| · |D ⊓ N|`, `S ⊴ H ⊓ N`, `|D|` odd, `S ≤ F ⊓ H` and `F ≤ N`, then the sets
of involutions of `F ⊓ H` and of `H ⊓ N` agree.  This is
`Work.NormalComplement.involutions_eq_of_odd_index` (proved separately), in the `involutions`
notation. -/
private theorem involutions_eq_of_odd_index_aux {G : Type} [Group G] [Finite G]
    {F N H S D : Subgroup G}
    (hsup : S ⊔ (D ⊓ N) = H ⊓ N)
    (hnorm : H ⊓ N ≤ Subgroup.normalizer (S : Set G))
    (hcard : Nat.card ↥(H ⊓ N) = Nat.card ↥S * Nat.card ↥(D ⊓ N))
    (hDodd : Odd (Nat.card ↥D))
    (hSle : S ≤ F ⊓ H) (hFleN : F ≤ N) :
    (Submission.Blueprint.involutions ((F ⊓ H : Subgroup G) : Set G)) =
      (Submission.Blueprint.involutions ((H ⊓ N : Subgroup G) : Set G)) := by
  have h := Work.NormalComplement.involutions_eq_of_odd_index (F := F) (N := N) (H := H)
    (S := S) (D := D) hsup hnorm hcard hDodd hSle hFleN
  show ({x : G | x ∈ (F ⊓ H : Subgroup G) ∧ orderOf x = 2} : Set G) =
    {x : G | x ∈ (H ⊓ N : Subgroup G) ∧ orderOf x = 2}
  exact h

/-- **Peterfalvi I Ch. III §5 Prop. 2 (a), counting clause** (p.184).  With `C = C_G(A)` and
`F₀ = O^{2'}(C)` (seen as a subgroup of `G`), `L = F₀ ⊓ H`: the number of involutions of `L` is
`2^p - 1`, the centre of `F₀` lies in `L` (so `L/Z(F₀)` makes sense) and `Z(F₀) = O(F₀)` has odd
order.

Route (see `REFS/peterfalvi_I_ch3_4.md`, §5 Prop. 2 (a), p.184, and §1 Lemma 3, p.175):
* `hC4` P3(b) at `X = A` (`h.A_ne : A ≠ ⊥`, `h.A_le : A ≤ centD H t`, and `∃ k ∈ NK H t A, k ≠ 1`
  which follows from `h.A_CK : (CK H t A).ncard = 2^p - 1 > 1`) gives `S ≤ F₀ ⊓ H` with
  `IsPGroup 2 S`, `¬ 2 ∣ (S.subgroupOf (F₀ ⊓ H)).index`, `H ⊓ N_G(A) ≤ N_G(S)`,
  `S ⊓ twoPoint H t = ⊥`, `S ⊔ (twoPoint H t ⊓ N_G(A)) = H ⊓ N_G(A)`.  Hence
  `S ⊴ H ⊓ N_G(A)` and `(H ⊓ N_G(A))/S` is isomorphic to `D ⊓ N_G(A)` (odd order, as `D` has odd
  order), so **every involution of `H ⊓ N_G(A)` lies in `S ≤ F₀ ⊓ H`**; with
  `F₀ ≤ C_G(A) ≤ N_G(A)` this gives `involutions (F₀ ⊓ H) = involutions (H ⊓ N_G(A))` as sets.
* `Work.NormalComplement.sec1_lemma3` with `X = A`, `P` gives
  `(involutions (H ⊓ N_G(A))).ncard = 2 ^ Nat.card P - 1`, and `h.P_card : Nat.card P = p`.
* `Z(F₀) ≤ L`: `hC4` P3(c) at `X = A` gives `oddCore F₀ = Subgroup.center F₀`; `hC4` P1(b) at
  `X = A`, `F = F₀`, `g = 1` (hypotheses `3 ≤ (fixedPts H A).ncard` from
  `Work.ThreePoints.three_le_fixedPts_of_le_centD` and `involutions (C_G(A)) ⊆ F₀` from
  `Work.ThreePoints.involutions_subset_p3F`) gives `IsStronglyEmbedded ((F₀ ⊓ H).subgroupOf F₀)`;
  a strongly embedded subgroup is self-normalising
  (`Work.ThreePoints.IsStronglyEmbedded.normalizer_eq`) and `Z(F₀)` lies in the normaliser of every
  subgroup, so `Z(F₀) ≤ (F₀ ⊓ H).subgroupOf F₀`.
* `Odd (Nat.card (Subgroup.center ↥F₀))`: `center = oddCore`, and `oddCore` of a finite group has
  odd order (`Work.ThompsonFrobenius.odd_oddCore`). -/
theorem sec5_setup_p3F_center (hFT : Submission.Blueprint.FeitThompsonProp)
    (hC4 : Submission.Blueprint.ChIIFourProp) {G : Type} [Group G] [Finite G]
    {H : Subgroup G} {t : G} {W : Subgroup G} {p : ℕ} {P A : Subgroup G} {r : ℕ}
    (h : Work.NormalComplement.Design.Setup5 G H t W p P A r) :
    let C : Subgroup G := Subgroup.centralizer (A : Set G)
    let F₀ : Subgroup G := (Submission.Blueprint.oddResidual ↥C).map C.subtype
    (Submission.Blueprint.involutions ((F₀ ⊓ H : Subgroup G) : Set G)).ncard = 2 ^ p - 1 ∧
      Subgroup.center ↥F₀ ≤ (F₀ ⊓ H).subgroupOf F₀ ∧
      Odd (Nat.card (Subgroup.center ↥F₀)) := by
  classical
  dsimp only
  let C : Subgroup G := Subgroup.centralizer (A : Set G)
  let F₀ : Subgroup G := (Submission.Blueprint.oddResidual ↥C).map C.subtype
  change (Submission.Blueprint.involutions ((F₀ ⊓ H : Subgroup G) : Set G)).ncard = 2 ^ p - 1 ∧
    Subgroup.center ↥F₀ ≤ (F₀ ⊓ H).subgroupOf F₀ ∧
    Odd (Nat.card (Subgroup.center ↥F₀))
  -- ## `F₀` lies in `C = C_G(A)`, hence in `N_G(A)`
  have hF0leC : F₀ ≤ C := Subgroup.map_subtype_le _
  have hFleN : F₀ ≤ Subgroup.normalizer (A : Set G) :=
    hF0leC.trans (Subgroup.centralizer_le_normalizer (A : Set G))
  -- ## there is a non-trivial `k ∈ N_K(A)`
  have hkInv : ∃ k ∈ Submission.Blueprint.invertedBy (Submission.Blueprint.twoPoint H t) t,
      k ≠ 1 ∧ k ∈ Subgroup.normalizer (A : Set G) := by
    by_contra hcon
    have hsub : (Kset (Submission.Blueprint.twoPoint H t) t ∩
        (Subgroup.centralizer (A : Set G) : Set G)) ⊆ ({1} : Set G) := by
      intro k hk
      by_contra hk1
      simp only [Set.mem_singleton_iff] at hk1
      exact hcon ⟨k, hk.1, hk1, Subgroup.centralizer_le_normalizer (A : Set G) hk.2⟩
    have hcardCK : (Kset (Submission.Blueprint.twoPoint H t) t ∩
        (Subgroup.centralizer (A : Set G) : Set G)).ncard = 2 ^ p - 1 := h.A_CK
    have hle1 : (Kset (Submission.Blueprint.twoPoint H t) t ∩
        (Subgroup.centralizer (A : Set G) : Set G)).ncard ≤ 1 := by
      have h1 := Set.ncard_le_ncard hsub (Set.finite_singleton 1)
      rwa [Set.ncard_singleton] at h1
    have h4 : 4 ≤ 2 ^ p := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ p := Nat.pow_le_pow_right (by norm_num) h.prime.two_le
    omega
  have hkNK : ∃ k ∈ Design.NK H t A, k ≠ 1 := by
    obtain ⟨k, hk1, hk2, hk3⟩ := hkInv
    exact ⟨k, ⟨hk1, hk3⟩, hk2⟩
  -- ## Ch. II §4 Prop. 3 (b), (c) at `X = A`
  have hspec := (hC4 G h.sit H h.se t h.invol h.notMem).2.2.2.1 A h.A_ne h.A_le hkInv
  dsimp only at hspec
  obtain ⟨-, ⟨S, _hSpg, hSle, _hSidx, hSN, hSinf, hSsup⟩, hoddcentRaw, -⟩ := hspec
  -- ## the cardinality bookkeeping for `S`, `D = twoPoint H t`, `M = H ⊓ N_G(A)`
  have hcard : Nat.card ↥(H ⊓ Subgroup.normalizer (A : Set G)) = Nat.card ↥S *
      Nat.card ↥(Submission.Blueprint.twoPoint H t ⊓ Subgroup.normalizer (A : Set G)) := by
    have hTK : (Submission.Blueprint.twoPoint H t ⊓ Subgroup.normalizer (A : Set G)) ≤
        Subgroup.normalizer (S : Set G) := by
      intro x hx
      have hxH : x ∈ H := (inf_le_left : Submission.Blueprint.twoPoint H t ≤ H) hx.1
      exact hSN ⟨hxH, hx.2⟩
    have hinf : S ⊓ (Submission.Blueprint.twoPoint H t ⊓ Subgroup.normalizer (A : Set G)) = ⊥ := by
      refine le_antisymm ?_ bot_le
      intro x hx
      have h1 : x ∈ S ⊓ Submission.Blueprint.twoPoint H t :=
        ⟨(Subgroup.mem_inf.mp hx).1, (Subgroup.mem_inf.mp (Subgroup.mem_inf.mp hx).2).1⟩
      rw [hSinf] at h1
      exact h1
    have hprod := card_sup_mul_card_inf (H := S)
      (K := Submission.Blueprint.twoPoint H t ⊓ Subgroup.normalizer (A : Set G)) hTK
    rw [hSsup, hinf, Subgroup.card_bot, mul_one] at hprod
    exact hprod
  have hDoddT : Odd (Nat.card ↥(Submission.Blueprint.twoPoint H t)) :=
    Work.Models.IsStronglyEmbedded.odd_twoPoint h.se h.notMem
  -- ## counting: the involutions of `F₀ ⊓ H` and of `H ⊓ N_G(A)` form the same set
  have hset_eq : (Submission.Blueprint.involutions ((F₀ ⊓ H : Subgroup G) : Set G)) =
      (Submission.Blueprint.involutions
        ((H ⊓ Subgroup.normalizer (A : Set G) : Subgroup G) : Set G)) := by
    have h := involutions_eq_of_odd_index_aux (F := F₀) (N := Subgroup.normalizer (A : Set G))
      (H := H) (S := S) (D := Submission.Blueprint.twoPoint H t)
      hSsup hSN hcard hDoddT hSle hFleN
    exact h
  -- ## §1 Lemma 3 at `X = A`
  have hPne : P ≠ ⊥ := by
    intro hbot
    have h1 : Nat.card ↥P = 1 := by rw [hbot]; exact Subgroup.card_bot
    rw [h.P_card] at h1
    have h2 := h.prime.two_le
    omega
  have hPV : P ≤ Submission.Blueprint.centD H t := h.P_le.trans inf_le_right
  have hPX : P ≤ Subgroup.normalizer (A : Set G) := hPV.trans h.A_normal
  have hfpf : Design.FpfOn P (Design.NK H t A) := by
    intro x hx hx1 k hkk hcomm
    exact h.P_fpf x hx hx1 k hkk.1 hcomm
  have hlemma3 := sec1_lemma3 hFT hC4 Work.Models.models_prop appV h.sit h.se h.invol h.notMem
    h.A_ne h.A_le hkNK hPne hPV hPX hfpf
  have hcount : (Submission.Blueprint.involutions
        ((H ⊓ Subgroup.normalizer (A : Set G) : Subgroup G) : Set G)).ncard =
      2 ^ Nat.card P - 1 := hlemma3.2.2.2.1
  refine ⟨?_, ?_, ?_⟩
  · rw [hset_eq, hcount, h.P_card]
  · -- `Z(F₀) ≤ F₀ ⊓ H`: `F₀ ⊓ H` is strongly embedded in `F₀` (Ch. II §4 Prop. 1 (b))
    have hP1b := (hC4 G h.sit H h.se t h.invol h.notMem).1
    have h3fix : 3 ≤ (Submission.Blueprint.fixedPts H A).ncard :=
      Work.ThreePoints.three_le_fixedPts_of_le_centD h.se h.invol h.notMem h.A_le
    have hinv : Submission.Blueprint.involutions
        (Subgroup.centralizer (A : Set G) : Set G) ⊆ F₀ :=
      Work.ThreePoints.involutions_subset_p3F A
    have hAle : A ≤ Submission.Blueprint.conj 1 H := by
      rw [Work.ThreePoints.conj_one]
      have h1 : Submission.Blueprint.centD H t ≤ Submission.Blueprint.twoPoint H t := inf_le_left
      have h2 : Submission.Blueprint.twoPoint H t ≤ H := inf_le_left
      exact h.A_le.trans (h1.trans h2)
    have hSE : LeanEval.GroupTheory.Defs.IsStronglyEmbedded ((F₀ ⊓ H).subgroupOf F₀) := by
      have h := hP1b A F₀ h3fix hinv hFleN 1 hAle
      rwa [Work.ThreePoints.conj_one] at h
    have h1 : Subgroup.center ↥F₀ ≤ Subgroup.normalizer
        (((F₀ ⊓ H).subgroupOf F₀ : Subgroup ↥F₀) : Set ↥F₀) :=
      Subgroup.center_le_normalizer _
    have h2 : Subgroup.normalizer
        (((F₀ ⊓ H).subgroupOf F₀ : Subgroup ↥F₀) : Set ↥F₀) = (F₀ ⊓ H).subgroupOf F₀ :=
      Work.ThreePoints.IsStronglyEmbedded.normalizer_eq hSE
    exact h1.trans (le_of_eq h2)
  · -- `Z(F₀) = O(F₀)` has odd order
    have hoddcent : Submission.Blueprint.oddCore ↥F₀ = Subgroup.center ↥F₀ := hoddcentRaw.1
    rw [← hoddcent]
    exact Work.ThompsonFrobenius.odd_oddCore ↥F₀

end Work.NormalComplement
