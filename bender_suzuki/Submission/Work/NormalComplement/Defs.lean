variable {G : Type*} [Group G]

namespace Work.NormalComplement

/-! ## `p`-control groups (Peterfalvi I Ch. III §1, Definition p.172) -/

/-- **`p`-control group.**  `E` is a `p`-control group in `W` if `E ≤ W`, `E` contains a Sylow
`p`-subgroup of `W`, and for every `p`-subgroup `U` of `E` and every `x ∈ W` with `conj x U ≤ E`
we have `x ∈ C_W(U)·E` — Peterfalvi I Ch. III §1 (p.172), condition 2.

The product `C_W(U)·E` must be stated as a product, **not** as the join `C_W(U) ⊔ E`: for subgroups
neither of which normalises the other, the join is strictly larger than the product, and using the
join makes the condition vacuous in cases where the conclusion has content.  Concretely, with
`G = S₅`, `W = S₄ = Stab 5`, `E = A₄`, `p = 3`, every `3`-subgroup `U ≤ E` satisfies
`C_G(U) ⊔ E = S₅ ⊇ W`, so the join version of the condition holds for `E` in `W`; but
`y = (2 3 4) ∈ E ∖ [E,E]` has `orderOf y = 3` and `y ∈ O^3(S₄) = S₄`, so Ch. III §1 Lemma 1 would
be false.  With the product the hypothesis fails for `U = ⟨y⟩` and `x = (4 5)` (there
`conj x U ⊄ E`), and Lemma 1 is the source's theorem.

(Conjugation is the challenge's `conj x U = x U x⁻¹`; the source writes `U^x = x⁻¹Ux` and takes
`x ∈ C_W(U)E`, so the clause below pairs `conj x⁻¹ U ≤ E` with `x`.) -/
def IsPControl (p : ℕ) (E W : Subgroup G) : Prop :=
  E ≤ W ∧ ¬ p ∣ (E.subgroupOf W).index ∧
    ∀ U : Subgroup G, U ≤ E → IsPGroup p U → ∀ x ∈ W, conj x⁻¹ U ≤ E →
      ∃ c ∈ Subgroup.centralizer (U : Set G) ⊓ W, ∃ e ∈ E, x = c * e

/-- `E` contains a Sylow `p`-subgroup of `W` (for `E ≤ W`) — the first condition of `E` being a
`p`-control group.  Stated as coprimality of the index, which is how the transfer argument uses
it (`(n,p) = 1` with `n = |W : E|`). -/
def ContainsSylow (p : ℕ) (E W : Subgroup G) : Prop := ¬ p ∣ (E.subgroupOf W).index

/-! ## Normal complements -/

/-- `Q` is a **normal complement** of `D` in `H`: `Q ⊴ H`, `Q ∩ D = 1` and `QD = H`.
This is the conclusion of Theorem D with `D = H ∩ H^t`. -/
def IsNormalComplementOf (Q D H : Subgroup G) : Prop :=
  Q ≤ H ∧ H ≤ Subgroup.normalizer (Q : Set G) ∧ Q ⊓ D = ⊥ ∧ Q ⊔ D = H

/-- `D` has a normal complement in `H`. -/
def HasNormalComplementIn (D H : Subgroup G) : Prop :=
  ∃ Q : Subgroup G, IsNormalComplementOf Q D H

/-! ## The fixed data `D, V, K` of Ch. II §4 -/

/-- Peterfalvi's `K = J(D,t) = {x ∈ D | x^t = x⁻¹}`, as a set.  It is not a subgroup a priori;
App. I (1)(b) gives a bijection `V × K → D`, and `⟨K⟩` is the interesting group. -/
abbrev Kset (D : Subgroup G) (t : G) : Set G := invertedBy D t

/-- The group generated by `K = J(D,t)`. -/
def Kgrp (D : Subgroup G) (t : G) : Subgroup G := Subgroup.closure (Kset D t)

/-- The `O_{p'}` of a subgroup `X ≤ G`, as a subgroup of `G`: the largest normal subgroup of `X`
whose order is prime to `p`. -/
def pPrimeCoreSub (p : ℕ) (X : Subgroup G) : Subgroup G :=
  (pPrimeCore p ↥X).map X.subtype

/-- The `O_{π'}` of a subgroup `X ≤ G`, as a subgroup of `G`: the largest normal subgroup of `X`
whose order has no prime divisor in `π`.  Used in the Corollary of Ch. III §1 Lemma 2. -/
noncomputable def piPrimeCoreSub (π : Set ℕ) (X : Subgroup G) : Subgroup G :=
  (Work.Fitting.piCore (fun q => q ∉ π) ↥X).map X.subtype

/-! ## Appendix I vocabulary (Ch. III §1–§2 uses App. I constantly) -/

/-- `t` normalises the subgroup `P` (as a set). -/
def NormalizedBy (t : G) (P : Subgroup G) : Prop := ∀ x ∈ P, t * x * t⁻¹ ∈ P

/-- `P` is a Sylow `p`-subgroup of the subgroup `X`: a `p`-subgroup of `X` of index prime to
`p`.  (This is the ambient-`G` version of `P : Sylow p ↥X`.) -/
def IsSylowIn (p : ℕ) (P X : Subgroup G) : Prop :=
  IsPGroup p P ∧ P ≤ X ∧ ¬ p ∣ (P.subgroupOf X).index

/-- App. I's set `K = {[t,x] | x ∈ X} = {t⁻¹x⁻¹tx | x ∈ X}` (transcribed literally in the
challenge's left-hand convention).  For `orderOf t = 2` and `X` normalised by `t`, this is
Peterfalvi's `J(X,t)`, the set of elements of `X` inverted by `t`. -/
def Kapp (t : G) (X : Subgroup G) : Set G := {z : G | ∃ x ∈ X, z = t⁻¹ * x⁻¹ * t * x}

end Work.NormalComplement
