/-
# Transporting `O^p` and the commutator subgroup along `↥(E.subgroupOf W) ≃* ↥E`

For subgroups `E ≤ W` of a group `G`, the canonical isomorphism of `Mathlib`,
`Subgroup.subgroupOfEquivOfLe h : ↥(E.subgroupOf W) ≃* ↥E` (where `h : E ≤ W`), sends an element
of `↥(E.subgroupOf W)` to the same element of `G`, hence preserves orders.  Therefore it
transports the `p`-residual `O^p` (the subgroup generated by the `p'`-elements) and the
commutator subgroup:

* `map_pResidual_subgroupOfEquivOfLe`;
* `map_commutator_subgroupOfEquivOfLe`.

Consequently the subgroup of `↥W` generated by `O^p(↥(E.subgroupOf W))` and the commutator of
`↥(E.subgroupOf W)` is pushed to `G` as `Work.Grun.pResidual p E ⊔ ⁅E, E⁆`: pushing further along
`E.subtype` corresponds to viewing `O^p` and the commutator inside `E` itself.  That is the
statement `map_pResidual_sup_commutator_subgroupOf`.

Note that `Work.NPC.Frobenius.pResidual p ↥X` (used for the subgroup `↥(E.subgroupOf W)` of `↥W`)
and `Work.Grun.pResidual p E` (the same subgroup as a subgroup of the ambient `G`) are the two
coexisting formalizations of `O^p` in the workspace; see `Work.Grun.pResidual_eq_map_pResidual`.
-/
import Mathlib
import Submission.Work.Grun.pResidual

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.NormalComplement

/-- The canonical isomorphism `↥(E.subgroupOf W) ≃* ↥E` (for `E ≤ W`) preserves element orders,
hence transports the subgroup generated by the `p'`-elements (`O^p`). -/
theorem map_pResidual_subgroupOfEquivOfLe {G : Type*} [Group G] {p : ℕ} {E W : Subgroup G}
    (h : E ≤ W) :
    Subgroup.map (Subgroup.subgroupOfEquivOfLe h : ↥(E.subgroupOf W) →* ↥E)
        (Work.NPC.Frobenius.pResidual p ↥(E.subgroupOf W))
      = Work.NPC.Frobenius.pResidual p ↥E := by
  let e : ↥(E.subgroupOf W) ≃* ↥E := Subgroup.subgroupOfEquivOfLe h
  have hord : ∀ x : ↥(E.subgroupOf W),
      orderOf ((e : ↥(E.subgroupOf W) →* ↥E) x) = orderOf x :=
    fun x => orderOf_injective (e : ↥(E.subgroupOf W) →* ↥E) e.injective x
  rw [Work.NPC.Frobenius.pResidual, Work.NPC.Frobenius.pResidual, MonoidHom.map_closure]
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [hord x]
    exact hx
  · intro hy
    refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
    rw [← hord (e.symm y),
      show (e : ↥(E.subgroupOf W) →* ↥E) (e.symm y) = y from e.apply_symm_apply y]
    exact hy

/-- The canonical isomorphism `↥(E.subgroupOf W) ≃* ↥E` (for `E ≤ W`) is surjective, hence
transports the commutator subgroup. -/
theorem map_commutator_subgroupOfEquivOfLe {G : Type*} [Group G] {E W : Subgroup G}
    (h : E ≤ W) :
    Subgroup.map (Subgroup.subgroupOfEquivOfLe h : ↥(E.subgroupOf W) →* ↥E)
        (commutator ↥(E.subgroupOf W))
      = commutator ↥E := by
  simp only [commutator, Subgroup.map_commutator, Subgroup.map_equiv_top]

/-- `O^p` and the commutator of `↥(E.subgroupOf W)`, pushed into the ambient group `G` along the
subtype inclusions `↥(E.subgroupOf W) → ↥W → G`, generate the same subgroup of `E` as
`Work.Grun.pResidual p E ⊔ ⁅E, E⁆`. -/
theorem map_pResidual_sup_commutator_subgroupOf {G : Type*} [Group G] {p : ℕ}
    {E W : Subgroup G} (h : E ≤ W) :
    (((Work.NPC.Frobenius.pResidual p ↥(E.subgroupOf W) ⊔ commutator ↥(E.subgroupOf W)).map
        (E.subgroupOf W).subtype).map W.subtype)
      = Work.Grun.pResidual p E ⊔ ⁅E, E⁆ := by
  let e : ↥(E.subgroupOf W) ≃* ↥E := Subgroup.subgroupOfEquivOfLe h
  have hcomp : (W.subtype.comp (E.subgroupOf W).subtype : ↥(E.subgroupOf W) →* G)
      = E.subtype.comp (e : ↥(E.subgroupOf W) →* ↥E) := by
    ext x
    exact (Subgroup.subgroupOfEquivOfLe_apply_coe h x).symm
  have hP : Subgroup.map (e : ↥(E.subgroupOf W) →* ↥E)
        (Work.NPC.Frobenius.pResidual p ↥(E.subgroupOf W))
      = Work.NPC.Frobenius.pResidual p ↥E :=
    map_pResidual_subgroupOfEquivOfLe h
  have hC : Subgroup.map (e : ↥(E.subgroupOf W) →* ↥E)
        (commutator ↥(E.subgroupOf W)) = commutator ↥E :=
    map_commutator_subgroupOfEquivOfLe h
  have hG : (Work.NPC.Frobenius.pResidual p ↥E).map E.subtype = Work.Grun.pResidual p E := by
    rw [Work.NPC.Frobenius.pResidual, Work.Grun.pResidual]
    congr 1
    ext x
    simp
  rw [Subgroup.map_map (g := W.subtype) (f := (E.subgroupOf W).subtype), hcomp,
    ← Subgroup.map_map (g := E.subtype) (f := (e : ↥(E.subgroupOf W) →* ↥E)),
    Subgroup.map_sup, Subgroup.map_sup, hP, hC, hG, Subgroup.map_subtype_commutator E]

end Work.NormalComplement
