/-
# Auxiliary lemmas for Peterfalvi I, Appendix I (5)(c)

Setting (Appendix I, p.199): `G` is a finite group, `d` a prime, `t ∈ G` of order `d`, `X ≤ G` a
`d'`-subgroup normalised by `t`.  We write

* `V = fixX t X = C_G(t) ⊓ X` (Peterfalvi's `V = C_X(t)`),
* `K = Kapp t X = {t⁻¹x⁻¹tx | x ∈ X}` (Peterfalvi's `K = {[t,x] | x ∈ X}`),
* `⟨K⟩ = closureKapp t X`.

This file collects the facts about `K` that are shared by the two assertions of App. I (5)(c):

* the conjugation action of a `p`-subgroup `U ≤ V` on the set `K` and the resulting orbit count
  `p ∤ |K|` (`not_dvd_ncard_Kapp`), hence `p ∤ |⟨K⟩|` (`not_dvd_card_closureKapp`) using (5)(a)
  (`appI_five_a`);
* the first assertion of (5)(c): if `C_K(U) = 1` then `N_X(U) ⊆ V`
  (`mem_fixX_of_normalizes`).
-/
import Mathlib
import Submission.Work.NormalComplement.Defs
import Submission.Work.NormalComplement.appI_four
import Submission.Work.NormalComplement.appI_five_a
import Submission.Work.NormalComplement.appI_two

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option warn.classDefReducibility false

open scoped Pointwise

namespace Work.NormalComplement

variable {G : Type*} [Group G] [Finite G]

/-- Peterfalvi's `V = C_X(t)` (Appendix I). -/
abbrev fixX (t : G) (X : Subgroup G) : Subgroup G := Subgroup.centralizer ({t} : Set G) ⊓ X

/-- Peterfalvi's `⟨K⟩`, the subgroup of `X` generated by `K = Kapp t X` (Appendix I (4)). -/
abbrev closureKapp (t : G) (X : Subgroup G) : Subgroup G := Subgroup.closure (Kapp t X)

lemma fixX_le_X {t : G} {X : Subgroup G} : fixX t X ≤ X := inf_le_right

/-- `1 ∈ Kapp t X` (take `x = 1`). -/
lemma one_mem_Kapp (t : G) (X : Subgroup G) : (1 : G) ∈ Kapp t X :=
  ⟨1, X.one_mem, by simp⟩

/-- `V = C_X(t)` normalises `K = Kapp t X` (App. I (4)). -/
lemma Kapp_conj_mem {t : G} {X : Subgroup G} :
    ∀ v ∈ fixX t X, ∀ k ∈ Kapp t X, v * k * v⁻¹ ∈ Kapp t X :=
  fun v hv k hk => Kapp_conj_centralizer k hk v hv

/-! ## The quotient `N_Q(V ∩ Q) / (V ∩ Q)` of App. I (5)(c) -/

/-- `N_Q(V ∩ Q)`, the normalizer in `Q` of `V ∩ Q`, as a subgroup of the ambient group. -/
abbrev normInQ {G : Type*} [Group G] (V Q : Subgroup G) : Subgroup G :=
  Subgroup.normalizer ((V ⊓ Q : Subgroup G) : Set G) ⊓ Q

/-- `V ∩ Q` viewed as a subgroup of `N_Q(V ∩ Q)`. -/
abbrev infSubOfNorm {G : Type*} [Group G] (V Q : Subgroup G) : Subgroup ↥(normInQ V Q) :=
  (V ⊓ Q).subgroupOf (normInQ V Q)

instance infSubOfNorm_normal {G : Type*} [Group G] (V Q : Subgroup G) :
    (infSubOfNorm V Q).Normal := by
  rw [Subgroup.normal_subgroupOf_iff (le_inf Subgroup.le_normalizer inf_le_right)]
  intro h k hh hk
  exact (Subgroup.mem_normalizer_iff.mp hk.1 h).mp hh

/-! ## The "fixed point" hypothesis of App. I (5)(c), restated -/

/-- The "fixed point" hypothesis of App. I (5)(c) follows from the "fixed-point-free" one as soon
as `U ≠ ⊥`. -/
lemma kapp_fixed_eq_one_of_fpf {t : G} {X U : Subgroup G} (hU1 : U ≠ ⊥)
    (hfpf : ∀ u ∈ U, u ≠ 1 → ∀ k ∈ Kapp t X, u * k * u⁻¹ = k → k = 1) :
    ∀ k ∈ Kapp t X, (∀ u ∈ U, u * k * u⁻¹ = k) → k = 1 := by
  obtain ⟨u, hu1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hU1
  intro k hk hfix
  exact hfpf u.1 u.2 (fun h => hu1 (Subtype.ext h)) k hk (hfix u.1 u.2)

/-! ## The conjugation action of `U ≤ V` on the set `K` -/

/-- The underlying `SMul` of the conjugation action of `U ≤ V = C_X(t)` on `K = Kapp t X`. -/
def KappSMul {t : G} {X U : Subgroup G} (hU : U ≤ fixX t X) : SMul U ↥(Kapp t X) :=
  ⟨fun u k => ⟨u.1 * k.1 * u.1⁻¹, Kapp_conj_mem u.1 (hU u.2) k.1 k.2⟩⟩

theorem KappSMul_val {t : G} {X U : Subgroup G} (hU : U ≤ fixX t X) (u : U) (k : ↥(Kapp t X)) :
    ((KappSMul hU).smul u k).1 = u.1 * k.1 * u.1⁻¹ := rfl

/-- The conjugation action of `U ≤ V = C_X(t)` on the set `K = Kapp t X`. -/
def KappMulAction {t : G} {X U : Subgroup G} (hU : U ≤ fixX t X) : MulAction U ↥(Kapp t X) where
  toSMul := KappSMul hU
  one_smul k := Subtype.ext (by
    change ((KappSMul hU).smul 1 k).1 = k.1
    rw [KappSMul_val hU]; simp)
  mul_smul u v k := Subtype.ext (by
    change ((KappSMul hU).smul (u * v) k).1 = ((KappSMul hU).smul u ((KappSMul hU).smul v k)).1
    rw [KappSMul_val hU, KappSMul_val hU, KappSMul_val hU]
    simp only [Subgroup.coe_mul, mul_inv_rev]
    group)

theorem KappMulAction_val {t : G} {X U : Subgroup G} (hU : U ≤ fixX t X) (u : U) (k : ↥(Kapp t X)) :
    (letI : MulAction U ↥(Kapp t X) := KappMulAction hU; (u • k).1) = u.1 * k.1 * u.1⁻¹ := rfl

/-- If every element of `U` has `p`-power order and `p ∤ |H|`, then `U ⊓ H = ⊥`. -/
theorem inf_eq_bot_of_isPGroup_of_not_dvd {p : ℕ} (hp : p.Prime) {U H : Subgroup G}
    (hUp : IsPGroup p U) (hH : ¬ p ∣ Nat.card ↥H) : U ⊓ H = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  rw [Subgroup.eq_bot_iff_forall]
  intro y hy
  obtain ⟨hyU, hyH⟩ := Subgroup.mem_inf.mp hy
  obtain ⟨n, hn⟩ := (IsPGroup.iff_orderOf.mp hUp) ⟨y, hyU⟩
  have hyn : orderOf y = p ^ n := (Subgroup.orderOf_coe (⟨y, hyU⟩ : ↥U)).trans hn
  have hdvd : p ^ n ∣ Nat.card ↥H := by rw [← hyn]; exact Subgroup.orderOf_dvd_natCard H hyH
  have hn0 : n = 0 := by
    by_contra hn0
    exact hH (dvd_trans (dvd_pow_self p hn0) hdvd)
  exact orderOf_eq_one_iff.mp (by rw [hyn, hn0, pow_zero])

/-- Orbit counting: if `U ≤ V = C_X(t)` is a `p`-subgroup with no nontrivial fixed point in
`K = Kapp t X`, then `p ∤ |K|`. -/
theorem not_dvd_ncard_Kapp {p : ℕ} (hp : p.Prime) {t : G} {X U : Subgroup G}
    (hU : U ≤ fixX t X) (hUp : IsPGroup p U)
    (hfix : ∀ k ∈ Kapp t X, (∀ u ∈ U, u * k * u⁻¹ = k) → k = 1) :
    ¬ p ∣ (Kapp t X).ncard := by
  haveI : Fact p.Prime := ⟨hp⟩
  letI : MulAction U ↥(Kapp t X) := KappMulAction hU
  have hval : ∀ (u : U) (k : ↥(Kapp t X)), (u • k).1 = u.1 * k.1 * u.1⁻¹ :=
    fun u k => KappMulAction_val hU u k
  have hsub : Subsingleton ↥(MulAction.fixedPoints U ↥(Kapp t X)) :=
    ⟨fun a b => by
      rw [Subtype.ext_iff, Subtype.ext_iff]
      have ha : (a.1).1 = 1 := hfix (a.1).1 a.1.2 (fun u hu => by
        have := congrArg Subtype.val (a.2 ⟨u, hu⟩)
        rw [hval] at this
        exact this)
      have hb : (b.1).1 = 1 := hfix (b.1).1 b.1.2 (fun u hu => by
        have := congrArg Subtype.val (b.2 ⟨u, hu⟩)
        rw [hval] at this
        exact this)
      rw [ha, hb]⟩
  have hne : Nonempty ↥(MulAction.fixedPoints U ↥(Kapp t X)) :=
    ⟨⟨⟨1, one_mem_Kapp t X⟩, fun u => Subtype.ext (by rw [hval]; simp)⟩⟩
  have hcard : Nat.card ↥(MulAction.fixedPoints U ↥(Kapp t X)) = 1 :=
    Nat.card_eq_one_iff_unique.mpr ⟨hsub, hne⟩
  have hmod := IsPGroup.card_modEq_card_fixedPoints hUp (↥(Kapp t X))
  rw [hcard, Nat.card_coe_set_eq] at hmod
  have hmod' : (Kapp t X).ncard % p = (1 : ℕ) % p := hmod
  intro hdvd
  have h0 : (Kapp t X).ncard % p = 0 := Nat.mod_eq_zero_of_dvd hdvd
  have h1 : (1 : ℕ) % p = 1 := Nat.mod_eq_of_lt hp.one_lt
  exact Nat.zero_ne_one (h0.symm.trans (hmod'.trans h1))

/-- App. I (5)(a): `|⟨K⟩|` is a `p'`-number as soon as `|K|` is. -/
theorem not_dvd_card_closureKapp {p : ℕ} (hp : p.Prime) {d : ℕ} (hd : d.Prime) {t : G}
    (ht : orderOf t = d) {X : Subgroup G} (htX : NormalizedBy t X)
    (hdX : Nat.Coprime (Nat.card X) d) (hsolv : Group.IsSolvable X) {U : Subgroup G}
    (hU : U ≤ fixX t X) (hUp : IsPGroup p U)
    (hfix : ∀ k ∈ Kapp t X, (∀ u ∈ U, u * k * u⁻¹ = k) → k = 1) :
    ¬ p ∣ Nat.card ↥(closureKapp t X) := by
  intro hdvd
  exact not_dvd_ncard_Kapp hp hU hUp hfix ((appI_five_a hd ht htX hdX hsolv p hp).mp hdvd)

/-- **Peterfalvi I, Appendix I (5)(c), first assertion** (with `p.Prime`): if `U ≤ V = C_X(t)` is a
`p`-subgroup with `C_K(U) = 1`, then `N_X(U) ⊆ V`. -/
theorem mem_fixX_of_normalizes {d : ℕ} (hd : d.Prime) {t : G} (ht : orderOf t = d)
    {X : Subgroup G} (htX : NormalizedBy t X) (hdX : Nat.Coprime (Nat.card X) d)
    (hsolv : Group.IsSolvable X) {p : ℕ} (hp : p.Prime) {U : Subgroup G} (hU : U ≤ fixX t X)
    (hUp : IsPGroup p U)
    (hCK : ∀ k ∈ Kapp t X, (∀ u ∈ U, u * k * u⁻¹ = k) → k = 1) :
    ∀ z ∈ X, (∀ u ∈ U, z * u * z⁻¹ ∈ U) → z ∈ fixX t X := by
  obtain ⟨hKX, hVnormK, hXnormKl, hsup, htKl, hKappKl, hcard⟩ := appI_four hd ht htX hdX
  -- `V ≤ X`, so `V` normalises `⟨K⟩`.
  have hVnormKl : fixX t X ≤ Subgroup.normalizer ((closureKapp t X : Subgroup G) : Set G) :=
    Subgroup.le_normalizer_iff.mpr (fun v hv k hk => hXnormKl v (fixX_le_X hv) k hk)
  -- `p ∤ |⟨K⟩|`, hence `U ⊓ ⟨K⟩ = ⊥`.
  have hpKl : ¬ p ∣ Nat.card ↥(closureKapp t X) :=
    not_dvd_card_closureKapp hp hd ht htX hdX hsolv hU hUp hCK
  have hUinf : U ⊓ closureKapp t X = ⊥ := inf_eq_bot_of_isPGroup_of_not_dvd hp hUp hpKl
  intro z hzX hzU
  -- `t` normalises `U` (as `U ≤ V` centralises `t`).
  have htU : NormalizedBy t U := fun u hu => by
    have hut : u * t = t * u := Subgroup.mem_centralizer_singleton_iff.mp (hU hu).1
    have h : t * u * t⁻¹ = u := by rw [← hut]; group
    rw [h]; exact hu
  have htN : t ∈ Subgroup.normalizer (U : Set G) := mem_normalizer_of_normalizedBy htU
  have hzN : z ∈ Subgroup.normalizer (U : Set G) := mem_normalizer_of_normalizedBy hzU
  -- `k = [t,z] = t⁻¹z⁻¹tz` lies in `K`, hence in `⟨K⟩`, and in `N(U)`.
  have hkK : t⁻¹ * z⁻¹ * t * z ∈ Kapp t X := ⟨z, hzX, rfl⟩
  have hkNz : t⁻¹ * z⁻¹ * t * z ∈ Subgroup.normalizer (U : Set G) :=
    (Subgroup.normalizer (U : Set G)).mul_mem
      ((Subgroup.normalizer (U : Set G)).mul_mem
        ((Subgroup.normalizer (U : Set G)).mul_mem
          ((Subgroup.normalizer (U : Set G)).inv_mem htN)
          ((Subgroup.normalizer (U : Set G)).inv_mem hzN))
        htN) hzN
  -- `k` commutes with every element of `U` (its commutator with `U` lies in `U ⊓ ⟨K⟩ = ⊥`).
  have hkcomm : ∀ u ∈ U, u * (t⁻¹ * z⁻¹ * t * z) * u⁻¹ = t⁻¹ * z⁻¹ * t * z := by
    intro u hu
    set k := t⁻¹ * z⁻¹ * t * z with hkdef
    have hkKl : k ∈ closureKapp t X := Subgroup.subset_closure hkK
    have hkN : k ∈ Subgroup.normalizer (U : Set G) := hkNz
    have huN : u ∈ Subgroup.normalizer ((closureKapp t X : Subgroup G) : Set G) := hVnormKl (hU hu)
    have h1 : k * u * k⁻¹ * u⁻¹ ∈ U :=
      U.mul_mem ((Subgroup.mem_normalizer_iff.mp hkN u).mp hu) (U.inv_mem hu)
    have h2 : k * u * k⁻¹ * u⁻¹ ∈ closureKapp t X := by
      have h' : k * (u * k⁻¹ * u⁻¹) ∈ closureKapp t X :=
        (closureKapp t X).mul_mem hkKl
          ((Subgroup.mem_normalizer_iff.mp huN k⁻¹).mp ((closureKapp t X).inv_mem hkKl))
      simpa [mul_assoc] using h'
    have h3 : k * u * k⁻¹ * u⁻¹ = 1 :=
      Subgroup.mem_bot.mp (hUinf ▸ Subgroup.mem_inf.mpr ⟨h1, h2⟩)
    have h4 : k * u * k⁻¹ = u := by
      have := congrArg (fun w => w * u) h3
      simpa [mul_assoc] using this
    have h5 : k * u = u * k := by
      calc k * u = (k * u * k⁻¹) * k := by group
        _ = u * k := by rw [h4]
    rw [hkdef] at h5 ⊢
    rw [← h5]; group
  have hk1 : t⁻¹ * z⁻¹ * t * z = 1 := hCK _ hkK hkcomm
  refine ⟨Subgroup.mem_centralizer_singleton_iff.mpr ?_, hzX⟩
  have h5 : t⁻¹ * z⁻¹ * t = z⁻¹ := by
    refine mul_right_cancel (b := z) (show (t⁻¹ * z⁻¹ * t) * z = z⁻¹ * z by
      rw [show (t⁻¹ * z⁻¹ * t) * z = 1 from hk1, inv_mul_cancel])
  have h6 : t⁻¹ * z * t = z := by
    have := congrArg Inv.inv h5
    simpa [mul_inv_rev, inv_inv, mul_assoc] using this
  have h7 : z * t = t * z := by
    have := congrArg (fun w => t * w) h6
    simpa [mul_assoc] using this
  exact h7

end Work.NormalComplement
