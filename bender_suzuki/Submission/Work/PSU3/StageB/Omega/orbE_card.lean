/-
# `Work.PSU3.StageB.Omega.orbE_card` — the `KW`-orbits on `E n^×` (Peterfalvi II, Ch. VII §2)

Setting: `fr : CoarseFrame H Q t n` in the hypotheses of `PSU3Hyp H Q t`, so that
`E n = GF(q²)` with `q = 2ⁿ`, `bar : Q → Q/Q₀ ≅ E n`, and `κ : KW →* (E n)ˣ` is injective
with image the product `F* · ⟨κ ζ⟩` of the fixed units `F* = FX n` (of order `q - 1`) and
the cyclic group generated by `κ ζ` (of order `orderOf ζ`), the two intersecting trivially.

The `KW`-orbits on `E n` are the sets `orbE fr a = {κ d · a | d ∈ KW}`.  This file proves
(`orbE_card`, the statement requested by the Stage B assembly):

* every orbit of a **nonzero** `a` has exactly `Nat.card fr.KW` elements (the action is free:
  `κ d · a = a` with `a ≠ 0` forces `κ d = 1`, hence `d = 1`);
* the number of orbits on `E n^×` multiplied by `orderOf fr.ζ` equals `2ⁿ + 1`.

The second statement is the arithmetic of the orbit decomposition: `E n^×` is partitioned into
orbits of size `|KW| = (q-1)·orderOf ζ`, and `|E n^×| = q² - 1 = (q-1)(q+1)`, whence
`#orbits · orderOf ζ = q + 1`.  The ingredients, proved here:

* `orbE_card_single` — orbit size;
* `orbE_card_nz_E` — `|E n^×| = (2ⁿ-1)(2ⁿ+1)`;
* `orbE_card_KW` — `|KW| = (2ⁿ-1) · orderOf ζ`, via the bijection
  `(KW ∩ Ksub) × ⟨ζ⟩ ≃ KW` (`KW_gen`) and the triviality of `FX n ⊓ ⟨κ ζ⟩` (from `ζ_norm`)
  together with `|FX n| = 2ⁿ - 1` (`fixedUnits_card`);
* `orbE_card_fiber` and `orbE_card_of_fiber_card` — the fibres of the orbit map are the
  orbits, so `|E n^×| = #orbits · |KW|`.

The degenerate case `n = 0` is impossible: `σE = id`, so `ζ_norm` gives `(κ ζ)² = 1` and
`κ ζ = 1` in the characteristic-two field `E 0`, contradicting `ζ ≠ 1` and `κ` injective.
-/
import Mathlib
import Submission.Work.PSU3.StageB.Omega.API
import Submission.Work.PSU3.StageB.fixedUnits_card

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

open Work.ThmF
open Work.PSU3
open Work.PSU3.StageB

namespace Work.PSU3.StageB.Omega

variable {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G} {n : ℕ}

/-! ## Orbits of `KW` on `E n` -/

/-- In characteristic two, `x * x = 1` forces `x = 1`. -/
theorem orbE_eq_one_of_mul_self_eq_one {F : Type*} [Field F] [CharP F 2] {x : F}
    (h : x * x = 1) : x = 1 := by
  rcases (mul_self_eq_one_iff.mp h) with h1 | h1
  · exact h1
  · rw [h1]; exact CharTwo.neg_eq 1

/-- The `KW`-orbit of `b` is the `KW`-orbit of `a` as soon as `b` lies in the orbit of `a`. -/
theorem orbE_eq_of_mem (fr : CoarseFrame H Q t n) {a b : E n}
    (hb : b ∈ orbE fr a) : orbE fr b = orbE fr a := by
  rw [mem_orbE_iff] at hb
  obtain ⟨d, rfl⟩ := hb
  ext x
  constructor
  · rintro ⟨e, rfl⟩
    exact ⟨e * d, by rw [map_mul, Units.val_mul]; ring⟩
  · rintro ⟨e, rfl⟩
    refine ⟨e * d⁻¹, ?_⟩
    have hne : (fr.κ d : E n) ≠ 0 := Units.ne_zero _
    rw [map_mul, map_inv, Units.val_mul, Units.val_inv_eq_inv_val]
    rw [mul_assoc, ← mul_assoc ((↑(fr.κ d))⁻¹) (↑(fr.κ d)) a, inv_mul_cancel₀ hne, one_mul]

/-- The elements of the orbit of a nonzero element are nonzero. -/
theorem orbE_ne_zero_of_mem (fr : CoarseFrame H Q t n) {a b : E n}
    (ha : a ≠ 0) (hb : b ∈ orbE fr a) : b ≠ 0 := by
  rw [mem_orbE_iff] at hb
  obtain ⟨d, rfl⟩ := hb
  exact mul_ne_zero (Units.ne_zero _) ha

/-- **First assertion.**  The `KW`-orbit of a nonzero `a : E n` has exactly `|KW|` elements:
`d ↦ κ d · a` is a bijection `KW → orbE fr a` because the action is free. -/
theorem orbE_card_single (fr : CoarseFrame H Q t n) {a : E n} (ha : a ≠ 0) :
    Nat.card {b : E n // b ∈ orbE fr a} = Nat.card fr.KW := by
  refine (Nat.card_congr (Equiv.ofBijective (fun d : fr.KW =>
    (⟨(fr.κ d : E n) * a, ⟨d, rfl⟩⟩ : {b : E n // b ∈ orbE fr a})) ⟨?_, ?_⟩)).symm
  · rintro d e hde
    have h1 : (fr.κ d : E n) * a = (fr.κ e : E n) * a := congrArg Subtype.val hde
    exact fr.κ_injective (Units.ext (mul_right_cancel₀ ha h1))
  · rintro ⟨b, hb⟩
    rw [mem_orbE_iff] at hb
    obtain ⟨d, rfl⟩ := hb
    exact ⟨d, rfl⟩

/-! ## Counting the orbits -/

/-- The orbit map `a ↦ orbE fr a` on the nonzero elements of `E n`. -/
noncomputable def orbE_orbitMap (fr : CoarseFrame H Q t n) :
    {a : E n // a ≠ 0} →
      {O : Set (E n) // ∃ a : E n, a ≠ 0 ∧ O = orbE fr a} :=
  fun a => ⟨orbE fr a.1, a.1, a.2, rfl⟩

/-- The orbit map is onto the orbit set. -/
theorem orbE_orbitMap_surjective (fr : CoarseFrame H Q t n) :
    Function.Surjective (orbE_orbitMap fr) := by
  rintro ⟨O, a, ha, rfl⟩
  exact ⟨⟨a, ha⟩, Subtype.ext rfl⟩

/-- The fibre of the orbit map over a given orbit `O` is a `KW`-orbit, hence has `|KW|`
elements. -/
theorem orbE_card_fiber (fr : CoarseFrame H Q t n)
    (O : {O : Set (E n) // ∃ a : E n, a ≠ 0 ∧ O = orbE fr a}) :
    Nat.card {a : {a : E n // a ≠ 0} // orbE_orbitMap fr a = O} = Nat.card fr.KW := by
  obtain ⟨a₀, ha₀, hO⟩ := O.2
  refine (Nat.card_congr ?_).trans (orbE_card_single fr ha₀)
  refine Equiv.ofBijective (fun a : {a : {a : E n // a ≠ 0} // orbE_orbitMap fr a = O} =>
      (⟨a.1.1, ?_⟩ : {b : E n // b ∈ orbE fr a₀})) ⟨?_, ?_⟩
  · have h1 : orbE fr a.1.1 = orbE fr a₀ := by
      have h2 := congrArg Subtype.val a.2
      simp only [orbE_orbitMap] at h2
      exact h2.trans hO
    rw [← h1]
    exact orbE_refl fr a.1.1
  · intro x y hxy
    have h3 : x.1.1 = y.1.1 :=
      congrArg (fun z : {b : E n // b ∈ orbE fr a₀} => z.1) hxy
    exact Subtype.ext (Subtype.ext h3)
  · intro b
    refine ⟨⟨⟨b.1, orbE_ne_zero_of_mem fr ha₀ b.2⟩, ?_⟩, Subtype.ext rfl⟩
    apply Subtype.ext
    simp only [orbE_orbitMap]
    rw [orbE_eq_of_mem fr b.2, hO]

/-- **Fibre counting.**  If all fibres of a map between finite types have `c` elements and the
map is onto, then the domain has `Nat.card β * c` elements. -/
theorem orbE_card_of_fiber_card {α β : Type*} [Finite α] [Finite β]
    (f : α → β) (hf : Function.Surjective f) (c : ℕ)
    (h : ∀ b : β, Nat.card {a : α // f a = b} = c) : Nat.card α = Nat.card β * c := by
  classical
  haveI : Fintype α := Fintype.ofFinite α
  haveI : Fintype β := Fintype.ofFinite β
  haveI : ∀ b : β, Fintype {a : α // f a = b} := fun b => Fintype.ofFinite _
  calc Nat.card α = Nat.card (Σ b : β, {a : α // f a = b}) :=
        (Nat.card_congr (Equiv.sigmaFiberEquiv f)).symm
    _ = ∑ b : β, Nat.card {a : α // f a = b} := Nat.card_sigma
    _ = ∑ _b : β, c := Finset.sum_congr rfl (fun b _ => h b)
    _ = Nat.card β * c := by
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, smul_eq_mul]

/-! ## The cardinality of `E n^×` -/

/-- `|E n^×| = (2ⁿ-1)(2ⁿ+1)`: the nonzero elements of `GF(2^{2n})`. -/
theorem orbE_card_nz_E (n : ℕ) (hn : 1 ≤ n) :
    Nat.card {a : E n // a ≠ 0} = (2 ^ n - 1) * (2 ^ n + 1) := by
  have hcard : Nat.card (E n) = 2 ^ (2 * n) := GaloisField.card 2 (2 * n) (by omega)
  have hunits : Nat.card {a : E n // a ≠ 0} = Nat.card (E n) - 1 := by
    rw [← Nat.card_congr unitsEquivNeZero, Nat.card_units]
  rw [hunits, hcard]
  have hmain : (2 ^ n - 1) * (2 ^ n + 1) + 1 = 2 ^ (2 * n) := by
    have h2 : 2 ^ (2 * n) = 2 ^ n * 2 ^ n := by
      rw [show 2 * n = n + n by omega, pow_add]
    rw [h2]
    obtain ⟨r, hr⟩ : ∃ r, 2 ^ n = r + 1 :=
      ⟨2 ^ n - 1, by have h1 : 1 ≤ 2 ^ n := Nat.one_le_two_pow; omega⟩
    rw [hr]
    simp only [Nat.add_sub_cancel]
    ring
  exact (Nat.eq_sub_of_add_eq hmain).symm

/-! ## The cardinality of `KW` -/

/-- **The arithmetic of `KW`.**  `|KW| = (2ⁿ-1)·orderOf ζ`, given `|FX n| = 2ⁿ - 1`.

Proof: `Ksub ≤ KW` is the part of `KW` acting on `Q₀`, and `κ` identifies it with the fixed
units `FX n`; every `d ∈ KW` is `k · ζ^j` with `k ∈ Ksub` (`KW_gen`), and the two subgroups
intersect trivially because `ζ_norm` gives `σE (κ ζ) = (κ ζ)⁻¹`, so an element of
`FX n ⊓ ⟨κ ζ⟩` is a `y` with `y² = 1`, hence `y = 1` in the characteristic-two field. -/
theorem orbE_card_KW (fr : CoarseFrame H Q t n)
    (hFX : Nat.card ↥(FX n) = 2 ^ n - 1) :
    Nat.card fr.KW = (2 ^ n - 1) * orderOf fr.ζ := by
  -- `κ` identifies `KW ∩ Ksub` with the fixed units `FX n`
  have hbij : Nat.card ↥((Ksub H t).comap fr.KW.subtype) = Nat.card ↥(FX n) := by
    refine Nat.card_congr (Equiv.ofBijective (fun k : ↥((Ksub H t).comap fr.KW.subtype) =>
      (⟨fr.κ k.1, (fr.mem_K_iff k.1).mp k.2⟩ : ↥(FX n))) ⟨?_, ?_⟩)
    · intro k l hkl
      exact Subtype.ext (fr.κ_injective (Subtype.ext_iff.mp hkl))
    · intro u
      obtain ⟨d, hd⟩ := fr.K_surj u.1 u.2
      refine ⟨⟨d, ?_⟩, Subtype.ext hd⟩
      exact (fr.mem_K_iff d).mpr (by rw [hd]; exact u.2)
  -- the norm-one units `N = {v | ↑v · σE ↑v = 1}`
  have hinf : FX n ⊓ Subgroup.zpowers (fr.κ fr.ζ) = ⊥ := by
    rw [eq_bot_iff]
    intro u hu
    rw [Subgroup.mem_bot]
    set N : Subgroup (E n)ˣ :=
      { carrier := {v | ((v : (E n)ˣ) : E n) * σE ((v : (E n)ˣ) : E n) = 1}
        mul_mem' := by
          intro a b ha hb
          have ha' : ((a : (E n)ˣ) : E n) * σE ((a : (E n)ˣ) : E n) = 1 := ha
          have hb' : ((b : (E n)ˣ) : E n) * σE ((b : (E n)ˣ) : E n) = 1 := hb
          show (((a * b : (E n)ˣ) : E n)) * σE (((a * b : (E n)ˣ) : E n)) = 1
          have h : (((a * b : (E n)ˣ) : E n)) * σE (((a * b : (E n)ˣ) : E n))
              = (((a : (E n)ˣ) : E n) * σE (((a : (E n)ˣ) : E n)))
                * (((b : (E n)ˣ) : E n) * σE (((b : (E n)ˣ) : E n))) := by
            rw [Units.val_mul, map_mul]; ring
          rw [h, ha', hb', one_mul]
        one_mem' := by simp
        inv_mem' := by
          intro a ha
          have ha' : ((a : (E n)ˣ) : E n) * σE ((a : (E n)ˣ) : E n) = 1 := ha
          show (((a⁻¹ : (E n)ˣ) : E n)) * σE (((a⁻¹ : (E n)ˣ) : E n)) = 1
          have h : (((a⁻¹ : (E n)ˣ) : E n)) * σE (((a⁻¹ : (E n)ˣ) : E n))
              = ((((a : (E n)ˣ) : E n) * σE (((a : (E n)ˣ) : E n))))⁻¹ := by
            rw [Units.val_inv_eq_inv_val, σE_inv, ← mul_inv]
          rw [h, ha', inv_one] }
    have hgen : fr.κ fr.ζ ∈ N := fr.ζ_norm
    have hmem : u ∈ N := Subgroup.zpowers_le.mpr hgen hu.2
    have h1 : ((u : (E n)ˣ) : E n) * ((u : (E n)ˣ) : E n) = 1 := by
      have h2 : ((u : (E n)ˣ) : E n) * σE ((u : (E n)ˣ) : E n) = 1 := hmem
      rw [show σE (((u : (E n)ˣ) : E n)) = ((u : (E n)ˣ) : E n) from hu.1] at h2
      exact h2
    exact Units.ext (orbE_eq_one_of_mul_self_eq_one h1)
  -- the same triviality inside `KW`
  have hinfKW : (Ksub H t).comap fr.KW.subtype ⊓ Subgroup.zpowers fr.ζ = ⊥ := by
    rw [eq_bot_iff]
    intro w hw
    rw [Subgroup.mem_bot]
    have h1 : fr.κ w ∈ FX n := (fr.mem_K_iff w).mp hw.1
    have h2 : fr.κ w ∈ Subgroup.zpowers (fr.κ fr.ζ) := by
      have hsub : Subgroup.zpowers fr.ζ ≤ (Subgroup.zpowers (fr.κ fr.ζ)).comap fr.κ := by
        rw [Subgroup.zpowers_le, Subgroup.mem_comap]
        exact Subgroup.mem_zpowers _
      exact hsub hw.2
    have h3 : fr.κ w = 1 := by
      have h4 : fr.κ w ∈ FX n ⊓ Subgroup.zpowers (fr.κ fr.ζ) := ⟨h1, h2⟩
      rw [hinf, Subgroup.mem_bot] at h4
      exact h4
    exact fr.κ_injective (by rw [h3, map_one])
  -- `(KW ∩ Ksub) × ⟨ζ⟩ ≃ KW`, `(k, z) ↦ k z`
  have hcard1 : Nat.card fr.KW = Nat.card ↥((Ksub H t).comap fr.KW.subtype)
      * Nat.card ↥(Subgroup.zpowers fr.ζ) := by
    rw [← Nat.card_prod]
    refine (Nat.card_congr (Equiv.ofBijective (fun p : ↥((Ksub H t).comap fr.KW.subtype)
        × ↥(Subgroup.zpowers fr.ζ) => p.1.1 * p.2.1) ⟨?_, ?_⟩)).symm
    · rintro ⟨⟨k, hk⟩, ⟨z, hz⟩⟩ ⟨⟨k', hk'⟩, ⟨z', hz'⟩⟩ heq
      have heq' : k * z = k' * z' := by simpa using heq
      have h2 : z * z'⁻¹ = k⁻¹ * k' := by
        have hh := congrArg (fun w : fr.KW => k⁻¹ * w * z'⁻¹) heq'
        simpa [mul_assoc] using hh
      have hmemK' : z * z'⁻¹ ∈ (Ksub H t).comap fr.KW.subtype := by
        rw [h2]
        exact ((Ksub H t).comap fr.KW.subtype).mul_mem
          (((Ksub H t).comap fr.KW.subtype).inv_mem hk) hk'
      have hmemZ' : z * z'⁻¹ ∈ Subgroup.zpowers fr.ζ :=
        (Subgroup.zpowers fr.ζ).mul_mem hz ((Subgroup.zpowers fr.ζ).inv_mem hz')
      have hmem : z * z'⁻¹ ∈ (Ksub H t).comap fr.KW.subtype ⊓ Subgroup.zpowers fr.ζ :=
        ⟨hmemK', hmemZ'⟩
      have hone : z * z'⁻¹ = 1 := by
        have h5 := hmem
        rw [hinfKW, Subgroup.mem_bot] at h5
        exact h5
      have hkk : k = k' := inv_mul_eq_one.mp (by rw [← h2, hone])
      have hzz : z = z' := by
        have h6 : k' * z = k' * z' := by rw [hkk] at heq'; exact heq'
        exact mul_left_cancel h6
      exact Prod.ext (Subtype.ext hkk) (Subtype.ext hzz)
    · intro d
      obtain ⟨k, hkKsub, j, hdj⟩ := fr.KW_gen d
      refine ⟨(⟨k, hkKsub⟩, ⟨fr.ζ ^ j,
        (Subgroup.zpowers fr.ζ).pow_mem (Subgroup.mem_zpowers fr.ζ) j⟩), ?_⟩
      show k * fr.ζ ^ j = d
      exact hdj.symm
  rw [hcard1, Nat.card_zpowers, hbij, hFX]

/-! ## The orbit count -/

theorem orbE_card {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G} {n : ℕ}
    (hS : Work.PSU3.PSU3Hyp H Q t) (fr : Work.PSU3.CoarseFrame H Q t n) :
    (∀ a : Work.PSU3.E n, a ≠ 0 →
      Nat.card {b : Work.PSU3.E n // b ∈ Work.PSU3.StageB.orbE fr a} = Nat.card fr.KW) ∧
    (Nat.card {O : Set (Work.PSU3.E n) // ∃ a : Work.PSU3.E n, a ≠ 0 ∧ O = Work.PSU3.StageB.orbE fr a})
      * orderOf fr.ζ = 2 ^ n + 1 := by
  rcases Nat.eq_zero_or_pos n with hn0 | hn
  · -- `n = 0` is impossible for a coarse frame: `σE = id` forces `κ ζ = 1`
    subst hn0
    exfalso
    have hσ : ∀ x : E 0, σE x = x := by
      intro x
      change x ^ 2 ^ 0 = x
      simp
    have hone : ((fr.κ fr.ζ : (E 0)ˣ) : E 0) * ((fr.κ fr.ζ : (E 0)ˣ) : E 0) = 1 := by
      have h := fr.ζ_norm
      rwa [hσ] at h
    have h1 : fr.κ fr.ζ = 1 := Units.ext (orbE_eq_one_of_mul_self_eq_one hone)
    exact fr.ζ_ne_one (fr.κ_injective (by rw [h1, map_one]))
  · constructor
    · intro a ha
      exact orbE_card_single fr ha
    · set M := Nat.card {O : Set (E n) // ∃ a : E n, a ≠ 0 ∧ O = orbE fr a} with hM
      have hFX : Nat.card ↥(FX n) = 2 ^ n - 1 := fixedUnits_card n hn
      have hcount := orbE_card_of_fiber_card (orbE_orbitMap fr) (orbE_orbitMap_surjective fr)
        (Nat.card fr.KW) (orbE_card_fiber fr)
      have hnz := orbE_card_nz_E n hn
      have hKW := orbE_card_KW fr hFX
      have hMX : M * Nat.card fr.KW = (2 ^ n - 1) * (2 ^ n + 1) := hcount.symm.trans hnz
      have key : (2 ^ n - 1) * (M * orderOf fr.ζ) = (2 ^ n - 1) * (2 ^ n + 1) := by
        have h1 : (2 ^ n - 1) * (M * orderOf fr.ζ)
            = M * ((2 ^ n - 1) * orderOf fr.ζ) := by
          rw [← mul_assoc, mul_comm (2 ^ n - 1) M, mul_assoc]
        rw [h1, ← hKW]
        exact hMX
      have hpos : 0 < 2 ^ n - 1 := by
        have h2 : 2 ≤ 2 ^ n := by
          calc (2 : ℕ) = 2 ^ 1 := (pow_one 2).symm
            _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
        omega
      exact Nat.mul_left_cancel hpos key

end Work.PSU3.StageB.Omega
