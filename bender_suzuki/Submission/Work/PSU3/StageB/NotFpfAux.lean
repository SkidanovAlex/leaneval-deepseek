/-
# Stage B / B2 — bookkeeping around the coarse frame

Elementary (hole-free) facts about a coarse frame in the presence of `PSU3Hyp` that the
Stage B/C nodes use.  Kept in its own module so that other nodes can import them without
pulling in the still-open B2 statement.

Contents:

* `mem_Q_of_orderOf_eq_two_pow`, `mem_Q_of_sq_eq_one` — `Q` is the normal Sylow 2-subgroup of
  `H`, so every 2-element of `H` lies in `Q`;
* `frameQ0_eq_Q0sub` — the frame's `Q₀` is exactly `⟨Inv H⟩`;
* `notDFpfBar_witness` — a fixed point of `¬ DFpfBar`, in frame coordinates;
* `not_mem_KW_of_fixed` — such a witness never lies in `KW`;
* `DFpfBar_of_twoPoint_le_KW` — `D = KW` implies `DFpfBar`.
-/
import Mathlib
import Submission.Work.PSU3.Defs
import Submission.Work.PSU3.GaloisField
import Submission.Work.PSU3.StageB.Frame
import Submission.Work.ThmF.Setup
import Submission.Work.RankOneUniqueness.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false

open LeanEval.GroupTheory.Defs Submission.Blueprint
open Work.ThmF

namespace Work.PSU3.StageB

variable {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G}

/-- **2-elements of `H` lie in `Q`.**  `Q` is a normal Sylow 2-subgroup of `H`: `|H| = |Q|·|D|`
with `D = H ∩ H^t` of odd order, so `H/Q` has odd order; the image of a 2-element of `H` in
`H/Q` therefore has order dividing both a 2-power and an odd number. -/
lemma mem_Q_of_orderOf_eq_two_pow (hS : Work.PSU3.PSU3Hyp H Q t) {x : G} (hxH : x ∈ H) {m : ℕ}
    (hord : orderOf x = 2 ^ m) : x ∈ Q := by
  have hN : (Q.subgroupOf H).Normal := Work.ThmF.split_Q_normal_in_H hS.split
  haveI := hN
  have hcardQ : Nat.card ↥(Q.subgroupOf H) = Nat.card Q :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS.split.le)
  have hidx : (Q.subgroupOf H).index = Nat.card (twoPoint H t) := by
    have h2 : Nat.card ↥H = Nat.card ↥(Q.subgroupOf H) * (Q.subgroupOf H).index :=
      (Subgroup.card_mul_index _).symm
    rw [Work.ThmF.split_card_H hS.split, hcardQ] at h2
    exact (Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := ↥Q)) h2).symm
  have hodd : Odd (Nat.card (twoPoint H t)) := Work.ThmF.split_odd_card_twoPoint hS.split
  have hcop : Nat.Coprime (2 ^ m) (Nat.card (twoPoint H t)) :=
    (Nat.coprime_two_left.mpr hodd).pow_left m
  have hq : (QuotientGroup.mk' (Q.subgroupOf H)) (⟨x, hxH⟩ : ↥H) = 1 := by
    apply orderOf_eq_one_iff.mp
    have hdvd1 : orderOf ((QuotientGroup.mk' (Q.subgroupOf H)) (⟨x, hxH⟩ : ↥H)) ∣ 2 ^ m := by
      have h := orderOf_map_dvd (QuotientGroup.mk' (Q.subgroupOf H)) (⟨x, hxH⟩ : ↥H)
      simpa [Subgroup.orderOf_coe, hord] using h
    have hdvd2 : orderOf ((QuotientGroup.mk' (Q.subgroupOf H)) (⟨x, hxH⟩ : ↥H)) ∣
        Nat.card (twoPoint H t) := by
      rw [← hidx, Subgroup.index_eq_card]
      exact orderOf_dvd_natCard _
    have hk : orderOf ((QuotientGroup.mk' (Q.subgroupOf H)) (⟨x, hxH⟩ : ↥H)) ∣ 1 := by
      have h := Nat.dvd_gcd hdvd1 hdvd2
      rw [Nat.Coprime] at hcop
      rw [hcop] at h
      exact h
    exact Nat.dvd_one.mp hk
  exact Subgroup.mem_subgroupOf.mp ((QuotientGroup.eq_one_iff _).mp hq)

/-- An element of `H` of order dividing `2` lies in `Q`. -/
lemma mem_Q_of_sq_eq_one (hS : Work.PSU3.PSU3Hyp H Q t) {x : G} (hxH : x ∈ H)
    (hx2 : x ^ 2 = 1) : x ∈ Q := by
  have hdvd : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hx2
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
  · rw [orderOf_eq_one_iff.mp h]; exact Q.one_mem
  · exact mem_Q_of_orderOf_eq_two_pow hS hxH (m := 1) (by rw [h]; norm_num)

/-- **`Q₀sub H = fr.Q0`.**  The frame's `Q₀` is `{x ∈ Q | x² = 1}`, and every involution of `H`
lies in the normal Sylow 2-subgroup `Q`.  Hence `fr.Q0` is exactly the subgroup generated by
the involutions of `H`. -/
lemma frameQ0_eq_Q0sub (hS : Work.PSU3.PSU3Hyp H Q t) {n : ℕ}
    (fr : Work.PSU3.CoarseFrame H Q t n) : fr.Q0 = Work.ThmF.Q0sub H := by
  refine le_antisymm ?_ ?_
  · intro z hz
    have hzQ : z ∈ Q := fr.Q0_le hz
    have hz2 : z ^ 2 = 1 := (fr.mem_Q0_iff z hzQ).mp hz
    refine Work.ThmF.Q0_le_Q0sub H ?_
    rw [Work.ThmF.mem_Q0_iff]
    rcases eq_or_ne z 1 with h1 | h1
    · exact Or.inr h1
    · refine Or.inl ⟨hS.split.le hzQ, ?_⟩
      have hdvd : orderOf z ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hz2
      rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
      · exact absurd (orderOf_eq_one_iff.mp h) h1
      · exact h
  · change Subgroup.closure (Work.ThmF.Q0 H) ≤ fr.Q0
    rw [Subgroup.closure_le]
    intro z hz
    rw [Work.ThmF.mem_Q0_iff] at hz
    rcases hz with ⟨hzH, hzord⟩ | rfl
    · have hzQ : z ∈ Q :=
        mem_Q_of_orderOf_eq_two_pow hS hzH (m := 1) (by rw [hzord]; norm_num)
      refine (fr.mem_Q0_iff z hzQ).mpr ?_
      rw [← hzord]; exact pow_orderOf_eq_one z
    · exact fr.Q0.one_mem

/-- The witness of `¬ DFpfBar H Q t`, expressed with the frame's `Q₀`. -/
lemma notDFpfBar_witness (hS : Work.PSU3.PSU3Hyp H Q t) {n : ℕ}
    (fr : Work.PSU3.CoarseFrame H Q t n) (hnfpf : ¬ Work.PSU3.DFpfBar H Q t) :
    ∃ d ∈ twoPoint H t, d ≠ 1 ∧ ∃ x ∈ Q, x ∉ fr.Q0 ∧ d⁻¹ * x * d * x⁻¹ ∈ fr.Q0 := by
  rw [Work.PSU3.DFpfBar] at hnfpf
  push_neg at hnfpf
  obtain ⟨d, hd, hd1, x, hx, hx0, hfix⟩ := hnfpf
  refine ⟨d, hd, hd1, x, hx, ?_, ?_⟩
  · rwa [← frameQ0_eq_Q0sub hS fr] at hx0
  · rwa [← frameQ0_eq_Q0sub hS fr] at hfix

/-- The witness of `¬ DFpfBar H Q t` is never an element of the frame's `KW` (elements of `KW`
act on `(Q/Q₀)#` by the scalar `κ d ≠ 1`). -/
lemma not_mem_KW_of_fixed (hS : Work.PSU3.PSU3Hyp H Q t) {n : ℕ}
    (fr : Work.PSU3.CoarseFrame H Q t n) {d x : G} (hd : d ∈ twoPoint H t) (hd1 : d ≠ 1)
    (hx : x ∈ Q) (hx0 : x ∉ fr.Q0) (hfix : d⁻¹ * x * d * x⁻¹ ∈ fr.Q0) : d ∉ fr.KW := by
  intro hdKW
  have hdH : d ∈ H := (Subgroup.mem_inf.mp hd).1
  have hyQ : d⁻¹ * x * d ∈ Q := by
    have h := Work.RankOneUniqueness.conj_mem_of_mem hS.split (H.inv_mem hdH) hx
    simpa using h
  have hyxQ : d⁻¹ * x * d * x⁻¹ ∈ Q := Q.mul_mem hyQ (Q.inv_mem hx)
  -- `bar x ≠ 1`
  have hbx : Multiplicative.toAdd (fr.bar ⟨x, hx⟩) ≠ 0 := by
    intro hb
    refine hx0 ((fr.bar_eq_one_iff ⟨x, hx⟩).mp ?_)
    have := congrArg Multiplicative.ofAdd hb
    simpa using this
  -- `bar (d⁻¹ x d x⁻¹) = 1` because `d⁻¹ x d x⁻¹ ∈ Q₀`
  have h1 : fr.bar ⟨d⁻¹ * x * d * x⁻¹, hyxQ⟩ = 1 :=
    (fr.bar_eq_one_iff _).mpr hfix
  -- hence `bar (d⁻¹ x d) = bar x`
  have h2 : fr.bar ⟨d⁻¹ * x * d, hyQ⟩ = fr.bar ⟨x, hx⟩ := by
    have hmul : (⟨d⁻¹ * x * d, hyQ⟩ : Q) * ⟨x, hx⟩⁻¹ =
        ⟨d⁻¹ * x * d * x⁻¹, hyxQ⟩ := rfl
    have h := congrArg fr.bar hmul
    rw [map_mul, map_inv, h1] at h
    exact mul_inv_eq_one.mp h
  -- `act_bar` computes `bar (d⁻¹ x d) = κ d · bar x`
  have h3 : Multiplicative.toAdd (fr.bar ⟨d⁻¹ * x * d, hyQ⟩) =
      (fr.κ ⟨d, hdKW⟩ : Work.PSU3.E n) * Multiplicative.toAdd (fr.bar ⟨x, hx⟩) :=
    fr.act_bar ⟨d, hdKW⟩ ⟨x, hx⟩ ⟨d⁻¹ * x * d, hyQ⟩ rfl
  -- so `κ d · bar x = bar x` and `κ d = 1`
  have h4 : (fr.κ ⟨d, hdKW⟩ : Work.PSU3.E n) * Multiplicative.toAdd (fr.bar ⟨x, hx⟩) =
      Multiplicative.toAdd (fr.bar ⟨x, hx⟩) := by
    rw [← h3, h2]
  have h5 : (fr.κ ⟨d, hdKW⟩ : Work.PSU3.E n) = 1 := by
    have := congrArg (fun z : Work.PSU3.E n => z * (Multiplicative.toAdd (fr.bar ⟨x, hx⟩))⁻¹) h4
    simpa [mul_assoc, hbx] using this
  have h6 : (⟨d, hdKW⟩ : fr.KW) = 1 := fr.κ_injective (Units.ext (by simpa using h5))
  have h7 : d = 1 := by
    have := congrArg (fun z : fr.KW => (z : G)) h6
    simpa using this
  exact hd1 h7

/-- **`DFpfBar` follows from `D = KW`**: elements of `KW` act on `Q/Q₀` by the scalar `κ d`,
and `κ` is injective.  So `¬ DFpfBar` forces `D ≠ KW`, i.e. `V ≠ W`. -/
lemma DFpfBar_of_twoPoint_le_KW (hS : Work.PSU3.PSU3Hyp H Q t) {n : ℕ}
    (fr : Work.PSU3.CoarseFrame H Q t n) (h : twoPoint H t ≤ fr.KW) :
    Work.PSU3.DFpfBar H Q t := by
  intro d hd hd1 x hx hx0 hfix
  rw [← frameQ0_eq_Q0sub hS fr] at hx0 hfix
  exact not_mem_KW_of_fixed hS fr hd hd1 hx hx0 hfix (h hd)

end Work.PSU3.StageB
