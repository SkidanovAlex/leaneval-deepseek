/-!
# The commutator subgroup of a subgroup of `GL₂` preserving a line is a `p`-group

Let `p` be prime, `K = ZMod p` and `V = K²`.  If `G ≤ GL₂(K)` preserves a line `L = K ∙ e`
(with `e ≠ 0`), then `G` lies in the stabiliser of the flag `0 ≤ L ≤ V`.  The subgroup `N` of
elements acting trivially on `L` and on `V ⧸ L` is the unipotent radical of that stabiliser: it
is a `p`-group, and `G ⧸ N` embeds into the abelian group `Aut(L) × Aut(V ⧸ L)`.  Hence the
derived subgroup `⁅G, G⁆` is contained in the `p`-group `N`, so it is itself a `p`-group.

The key algebraic input is that endomorphisms of a cyclic module commute
(`Work.GL2odd.end_mul_comm_of_span_singleton`), applied to `L` and to `V ⧸ L`.

## Main result

* `Work.GL2odd.commutator_isPGroup_of_preserves_line`
-/

open scoped commutatorElement
open Matrix

namespace Work.GL2odd

noncomputable section

/-- The action of `GL (Fin 2) (ZMod p)` on `Fin 2 → ZMod p`, as a multiplicative equivalence with
the group of `ZMod p`-linear automorphisms of the vector space. -/
noncomputable def glToLinEquiv (p : ℕ) :
    GL (Fin 2) (ZMod p) ≃* ((Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) :=
  (Matrix.GeneralLinearGroup.toLin (n := Fin 2) (R := ZMod p)).trans
    (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod p) (Fin 2 → ZMod p))

@[simp] theorem glToLinEquiv_apply (p : ℕ) (g : GL (Fin 2) (ZMod p))
    (v : Fin 2 → ZMod p) :
    glToLinEquiv p g v = (g : Matrix (Fin 2) (Fin 2) (ZMod p)).mulVec v := by
  simp [glToLinEquiv]

/-- The line spanned by `e`. -/
def lineSpan (p : ℕ) (e : Fin 2 → ZMod p) : Submodule (ZMod p) (Fin 2 → ZMod p) :=
  Submodule.span (ZMod p) {e}

/-- Membership in the line spanned by `e` is membership in `ZMod p ∙ e`. -/
theorem mem_lineSpan_iff {p : ℕ} {e v : Fin 2 → ZMod p} :
    v ∈ lineSpan p e ↔ ∃ c : ZMod p, c • e = v :=
  Submodule.mem_span_singleton

/-- An element of `GL` fixing `e` fixes every multiple of `e`. -/
theorem glToLin_fixes_lineSpan {p : ℕ} {e : Fin 2 → ZMod p} {g : GL (Fin 2) (ZMod p)}
    (hg : glToLinEquiv p g e = e) {v : Fin 2 → ZMod p} (hv : v ∈ lineSpan p e) :
    glToLinEquiv p g v = v := by
  obtain ⟨c, rfl⟩ := mem_lineSpan_iff.mp hv
  rw [map_smul, hg]

/-- The unipotent radical of the stabiliser of the line `ZMod p ∙ e`: the elements of
`GL (Fin 2) (ZMod p)` acting trivially on the line and on the quotient by it. -/
def unipotent (p : ℕ) (e : Fin 2 → ZMod p) : Subgroup (GL (Fin 2) (ZMod p)) where
  carrier := {g | glToLinEquiv p g e = e ∧ ∀ v, glToLinEquiv p g v - v ∈ lineSpan p e}
  one_mem' := by
    refine ⟨by simp, fun v => ?_⟩
    simp
  mul_mem' := by
    rintro g h ⟨hg1, hg2⟩ ⟨hh1, hh2⟩
    refine ⟨by rw [map_mul, LinearEquiv.mul_apply, hh1, hg1], fun v => ?_⟩
    have hsub : glToLinEquiv p h v - v ∈ lineSpan p e := hh2 v
    have hfix : glToLinEquiv p g (glToLinEquiv p h v - v) = glToLinEquiv p h v - v :=
      glToLin_fixes_lineSpan hg1 hsub
    have hkey : glToLinEquiv p g (glToLinEquiv p h v) - v
        = (glToLinEquiv p g v - v) + (glToLinEquiv p h v - v) := by
      rw [show glToLinEquiv p h v = v + (glToLinEquiv p h v - v) from by abel,
        map_add, hfix]
      abel
    rw [map_mul, LinearEquiv.mul_apply, hkey]
    exact Submodule.add_mem _ (hg2 v) (hh2 v)
  inv_mem' := by
    rintro g ⟨hg1, hg2⟩
    refine ⟨?_, fun v => ?_⟩
    · rw [map_inv]
      apply (glToLinEquiv p g).injective
      rw [show glToLinEquiv p g ((glToLinEquiv p g)⁻¹ e) = e from
        LinearEquiv.apply_symm_apply (glToLinEquiv p g) e, hg1]
    · rw [map_inv]
      have hz := hg2 ((glToLinEquiv p g)⁻¹ v)
      rw [show glToLinEquiv p g ((glToLinEquiv p g)⁻¹ v) = v from
        LinearEquiv.apply_symm_apply (glToLinEquiv p g) v] at hz
      simpa [neg_sub] using Submodule.neg_mem _ hz

@[simp] theorem mem_unipotent_iff {p : ℕ} {e : Fin 2 → ZMod p} {g : GL (Fin 2) (ZMod p)} :
    g ∈ unipotent p e ↔
      glToLinEquiv p g e = e ∧ ∀ v, glToLinEquiv p g v - v ∈ lineSpan p e :=
  Iff.rfl

/-- If `span{e} ⊔ span{f} = ⊤` then `V ⧸ span{e}` is generated by the class of `f`. -/
theorem quotient_span_eq_top {p : ℕ} {e f : Fin 2 → ZMod p}
    (hf : lineSpan p e ⊔ Submodule.span (ZMod p) {f} = ⊤) :
    Submodule.span (ZMod p) {(Submodule.Quotient.mk (p := lineSpan p e) f :
      (Fin 2 → ZMod p) ⧸ lineSpan p e)} = ⊤ := by
  have h := (Submodule.map_mkQ_eq_top (lineSpan p e) (Submodule.span (ZMod p) {f})).mpr hf
  rwa [Submodule.map_span, Set.image_singleton] at h

/-- The unipotent radical of the stabiliser of a line in `K²` is a `p`-group. -/
theorem unipotent_isPGroup {p : ℕ} [Fact p.Prime] (e : Fin 2 → ZMod p) (he : e ≠ 0) :
    IsPGroup p ↥(unipotent p e) := by
  classical
  obtain ⟨f, hf⟩ := exists_compl_span_singleton e he
  have hy := quotient_span_eq_top (p := p) hf
  let θfun : ↥(unipotent p e) → Multiplicative ↥(lineSpan p e) :=
    fun n => Multiplicative.ofAdd ⟨glToLinEquiv p n.1 f - f, (mem_unipotent_iff.mp n.2).2 f⟩
  have θmap_one : θfun 1 = 1 := by
    apply Multiplicative.toAdd.injective
    show (⟨glToLinEquiv p 1 f - f, _⟩ : ↥(lineSpan p e)) = 0
    apply Subtype.ext
    simp
  have θmap_mul : ∀ n m : ↥(unipotent p e), θfun (n * m) = θfun n * θfun m := by
    intro n m
    apply Multiplicative.ofAdd.injective
    apply Subtype.ext
    have hmn := (mem_unipotent_iff.mp n.2).1
    have hmm := (mem_unipotent_iff.mp m.2).2 f
    show glToLinEquiv p (n * m).1 f - f
        = (glToLinEquiv p n.1 f - f) + (glToLinEquiv p m.1 f - f)
    rw [Subgroup.coe_mul, map_mul, LinearEquiv.mul_apply]
    have hfix : glToLinEquiv p n.1 (glToLinEquiv p m.1 f - f) = glToLinEquiv p m.1 f - f :=
      glToLin_fixes_lineSpan hmn hmm
    rw [show glToLinEquiv p m.1 f = f + (glToLinEquiv p m.1 f - f) from by abel, map_add, hfix]
    abel
  let θ : ↥(unipotent p e) →* Multiplicative ↥(lineSpan p e) :=
    { toFun := θfun, map_one' := θmap_one, map_mul' := θmap_mul }
  have hLgroup : IsPGroup p (Multiplicative ↥(lineSpan p e)) := by
    rw [isPGroup_iff_pow_pow_eq_one]
    intro x
    refine ⟨1, ?_⟩
    have h : x ^ p = 1 := by
      have h2 : (x ^ p).toAdd = 0 := by
        rw [toAdd_pow]
        rw [show p • x.toAdd = (p : ZMod p) • x.toAdd from
          (Nat.cast_smul_eq_nsmul (ZMod p) p x.toAdd).symm]
        rw [ZMod.natCast_self, zero_smul]
      exact Multiplicative.toAdd.injective (by rw [h2, toAdd_one])
    simpa [pow_one] using h
  have hinj : Function.Injective θ := by
    intro n m h
    have hsub : glToLinEquiv p n.1 f - f = glToLinEquiv p m.1 f - f := by
      have hc := congrArg (fun x : Multiplicative ↥(lineSpan p e) =>
        (Multiplicative.toAdd x : ↥(lineSpan p e))) h
      simpa [θ, θfun] using congrArg Subtype.val hc
    have hf' : glToLinEquiv p n.1 f = glToLinEquiv p m.1 f := sub_left_inj.mp hsub
    have he1 : glToLinEquiv p n.1 e = e := (mem_unipotent_iff.mp n.2).1
    have he2 : glToLinEquiv p m.1 e = e := (mem_unipotent_iff.mp m.2).1
    have htop : Submodule.span (ZMod p) ({e, f} : Set (Fin 2 → ZMod p)) = ⊤ := by
      rw [Submodule.span_insert]
      exact hf
    have hlin : (glToLinEquiv p n.1 : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p))
        = (glToLinEquiv p m.1 : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) := by
      apply LinearMap.ext_on htop
      intro z hz
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with hz | hz
      · rw [hz]; exact he1.trans he2.symm
      · rw [hz]; exact hf'
    have hσ : glToLinEquiv p n.1 = glToLinEquiv p m.1 :=
      LinearEquiv.toLinearMap_injective hlin
    exact Subtype.ext ((glToLinEquiv p).injective hσ)
  exact IsPGroup.of_injective hLgroup θ hinj

theorem commutator_isPGroup_of_preserves_line {p : ℕ} [Fact p.Prime]
    (G : Subgroup (GL (Fin 2) (ZMod p))) (e : Fin 2 → ZMod p) (he : e ≠ 0)
    (hpres : ∀ g ∈ G, (g : Matrix (Fin 2) (Fin 2) (ZMod p)).mulVec e ∈ Submodule.span (ZMod p) {e}) :
    IsPGroup p ↥⁅G,G⁆ := by
  obtain ⟨f, hf⟩ := exists_compl_span_singleton e he
  have hy := quotient_span_eq_top (p := p) hf
  have hmem : ∀ t ∈ G, glToLinEquiv p t e ∈ lineSpan p e := by
    intro t ht
    simpa only [lineSpan, glToLinEquiv_apply] using hpres t ht
  have hle : ∀ t ∈ G, Submodule.map
      ((glToLinEquiv p t : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) :
        (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) (lineSpan p e) ≤ lineSpan p e := by
    intro t ht
    rw [lineSpan, Submodule.map_span, Set.image_singleton]
    exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr (hmem t ht))
  have heq : ∀ t ∈ G, Submodule.map
      ((glToLinEquiv p t : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) :
        (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) (lineSpan p e) = lineSpan p e := by
    intro t ht
    refine le_antisymm (hle t ht) ?_
    have hcomp : (((glToLinEquiv p t : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) :
          (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p))
        ∘ₗ ((glToLinEquiv p t⁻¹ : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) :
          (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)))
        = LinearMap.id := by
      apply LinearMap.ext
      intro x
      show (glToLinEquiv p t) ((glToLinEquiv p t⁻¹) x) = x
      have h1 : (glToLinEquiv p t) ((glToLinEquiv p t⁻¹) x)
          = (glToLinEquiv p t * glToLinEquiv p t⁻¹) x := (LinearEquiv.mul_apply _ _ x).symm
      rw [h1, ← map_mul, mul_inv_cancel, map_one]
      rfl
    calc lineSpan p e
        = Submodule.map (((glToLinEquiv p t : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) ∘ₗ ((glToLinEquiv p t⁻¹ : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p))) (lineSpan p e) := by rw [hcomp, Submodule.map_id]
      _ = Submodule.map ((glToLinEquiv p t : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) (Submodule.map ((glToLinEquiv p t⁻¹ : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) (lineSpan p e)) := by rw [Submodule.map_comp]
      _ ≤ Submodule.map ((glToLinEquiv p t : (Fin 2 → ZMod p) ≃ₗ[ZMod p] (Fin 2 → ZMod p)) : (Fin 2 → ZMod p) →ₗ[ZMod p] (Fin 2 → ZMod p)) (lineSpan p e) := Submodule.map_mono (hle t⁻¹ (G.inv_mem ht))
  refine IsPGroup.to_le (unipotent_isPGroup e he) ?_
  rw [Subgroup.commutator_le]
  intro g hg h hh
  have hcomm : glToLinEquiv p ⁅g, h⁆
      = glToLinEquiv p g * glToLinEquiv p h * (glToLinEquiv p g)⁻¹ * (glToLinEquiv p h)⁻¹ := by
    rw [commutatorElement_def]
    simp only [map_mul, map_inv]
  obtain ⟨hf1, hf2⟩ := commutator_mem_unipotent_of_preserves_submodule (lineSpan p e)
      (⟨e, Submodule.mem_span_singleton_self e⟩ : lineSpan p e)
      (span_singleton_self_span_top e)
      (Submodule.Quotient.mk (p := lineSpan p e) f) hy
      (glToLinEquiv p g) (glToLinEquiv p h) (heq g hg) (heq h hh)
  rw [mem_unipotent_iff]
  refine ⟨?_, ?_⟩
  · rw [hcomm]
    exact hf1 e (Submodule.mem_span_singleton_self e)
  · intro v
    rw [hcomm]
    exact hf2 v

end

end Work.GL2odd
