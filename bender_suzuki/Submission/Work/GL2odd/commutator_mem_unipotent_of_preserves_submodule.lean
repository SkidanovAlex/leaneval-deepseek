/-!
# The commutator of two `L`-preserving linear equivalences is unipotent

Let `L ≤ V` be a submodule such that `L` is generated by a single element (`Submodule.span K {x} = ⊤`,
`x : L`) and such that the quotient `V ⧸ L` is generated by a single element
(`Submodule.span K {y} = ⊤`, `y : V ⧸ L`).  If two linear equivalences `u`, `w` of `V` preserve
`L`, then their commutator `u w u⁻¹ w⁻¹` fixes `L` pointwise and acts trivially on `V ⧸ L`
(i.e. it is "unipotent": `c v - v ∈ L` for every `v`).

The two ingredients are the two sides of the short exact sequence `0 → L → V → V ⧸ L → 0`:
the endomorphism ring of `L` is commutative (both `u` and `w` restrict to endomorphisms of the
cyclic module `L`), and the endomorphism ring of `V ⧸ L` is commutative (the quotient is cyclic).
Hence the induced action on both is given by commuting endomorphisms, so the induced commutator
is the identity.
-/

namespace Work.GL2odd

/-- If a linear equivalence preserves the submodule `L`, so does its inverse. -/
private lemma map_symm_eq_self {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    {L : Submodule K V} {u : V ≃ₗ[K] V} (hu : L.map (u : V →ₗ[K] V) = L) :
    L.map (u.symm : V →ₗ[K] V) = L := by
  have hmem : ∀ z : V, (u : V →ₗ[K] V) z ∈ L → z ∈ L := by
    intro z hz
    have hz' : (u : V →ₗ[K] V) z ∈ L.map (u : V →ₗ[K] V) := by rw [hu]; exact hz
    obtain ⟨y, hy, hyz⟩ := Submodule.mem_map.mp hz'
    have h : y = z := u.injective hyz
    rwa [h] at hy
  apply le_antisymm
  · intro z hz
    obtain ⟨y, hy, hyz⟩ := Submodule.mem_map.mp hz
    apply hmem z
    have hyz' : (u : V →ₗ[K] V) z = y := by
      rw [← hyz]; exact LinearEquiv.apply_symm_apply u y
    rw [hyz']; exact hy
  · intro z hz
    rw [Submodule.mem_map]
    refine ⟨(u : V →ₗ[K] V) z, ?_, ?_⟩
    · rw [← hu]; exact Submodule.mem_map.mpr ⟨z, hz, rfl⟩
    · exact LinearEquiv.symm_apply_apply u z

theorem commutator_mem_unipotent_of_preserves_submodule {K V : Type*} [Field K]
    [AddCommGroup V] [Module K V] (L : Submodule K V) (x : L) (hx : Submodule.span K {x} = ⊤)
    (y : V ⧸ L) (hy : Submodule.span K {y} = ⊤) (u w : V ≃ₗ[K] V)
    (hu : L.map (u : V →ₗ[K] V) = L) (hw : L.map (w : V →ₗ[K] V) = L) :
    (∀ v : V, v ∈ L → (u * w * u⁻¹ * w⁻¹) v = v) ∧
    (∀ v : V, (u * w * u⁻¹ * w⁻¹) v - v ∈ L) := by
  -- `u`, `w` and their inverses map `L` into itself
  have hu_mem : ∀ v : V, v ∈ L → (u : V →ₗ[K] V) v ∈ L :=
    fun v hv => (Submodule.map_le_iff_le_comap).mp hu.le hv
  have hw_mem : ∀ v : V, v ∈ L → (w : V →ₗ[K] V) v ∈ L :=
    fun v hv => (Submodule.map_le_iff_le_comap).mp hw.le hv
  have hu'_eq : L.map (u.symm : V →ₗ[K] V) = L := map_symm_eq_self hu
  have hw'_eq : L.map (w.symm : V →ₗ[K] V) = L := map_symm_eq_self hw
  have hu'_mem : ∀ v : V, v ∈ L → (u.symm : V →ₗ[K] V) v ∈ L :=
    fun v hv => (Submodule.map_le_iff_le_comap).mp hu'_eq.le hv
  have hw'_mem : ∀ v : V, v ∈ L → (w.symm : V →ₗ[K] V) v ∈ L :=
    fun v hv => (Submodule.map_le_iff_le_comap).mp hw'_eq.le hv
  -- `u` and `w` commute on `L`, because `L` is a cyclic module
  have hcommL : ∀ v ∈ L, (u : V →ₗ[K] V) ((w : V →ₗ[K] V) v) =
      (w : V →ₗ[K] V) ((u : V →ₗ[K] V) v) := by
    have hkey := end_mul_comm_of_span_singleton hx
      ((u : V →ₗ[K] V).restrict hu_mem) ((w : V →ₗ[K] V).restrict hw_mem)
    intro v hv
    have h1 := LinearMap.congr_fun hkey (⟨v, hv⟩ : L)
    simp only [Module.End.mul_apply, LinearMap.restrict_apply] at h1
    exact Subtype.ext_iff.mp h1
  refine ⟨?_, ?_⟩
  · -- Part 1: the commutator fixes `L` pointwise.
    intro v hv
    have hmem2 : (u.symm : V →ₗ[K] V) ((w.symm : V →ₗ[K] V) v) ∈ L :=
      hu'_mem _ (hw'_mem v hv)
    have h1 : (u * w * u⁻¹ * w⁻¹) v =
        (u : V →ₗ[K] V)
          ((w : V →ₗ[K] V) ((u.symm : V →ₗ[K] V) ((w.symm : V →ₗ[K] V) v))) := by
      simp [LinearEquiv.mul_apply]
    rw [h1, hcommL _ hmem2]
    simp
  · -- Part 2: the commutator acts trivially on `V ⧸ L`.
    intro v
    have hu_le : L ≤ L.comap (u : V →ₗ[K] V) := (Submodule.map_le_iff_le_comap).mp hu.le
    have hw_le : L ≤ L.comap (w : V →ₗ[K] V) := (Submodule.map_le_iff_le_comap).mp hw.le
    have hu'_le : L ≤ L.comap (u.symm : V →ₗ[K] V) :=
      (Submodule.map_le_iff_le_comap).mp hu'_eq.le
    have hw'_le : L ≤ L.comap (w.symm : V →ₗ[K] V) :=
      (Submodule.map_le_iff_le_comap).mp hw'_eq.le
    have hc_mem : ∀ z : V, z ∈ L → (↑(u * w * u⁻¹ * w⁻¹) : V →ₗ[K] V) z ∈ L := by
      intro z hz
      rw [show (↑(u * w * u⁻¹ * w⁻¹) : V →ₗ[K] V) z =
            (u : V →ₗ[K] V)
              ((w : V →ₗ[K] V)
                ((u.symm : V →ₗ[K] V) ((w.symm : V →ₗ[K] V) z))) from by
          simp [LinearEquiv.coe_toLinearMap_mul]]
      exact hu_mem _ (hw_mem _ (hu'_mem _ (hw'_mem _ hz)))
    have hc_le : L ≤ L.comap (↑(u * w * u⁻¹ * w⁻¹) : V →ₗ[K] V) := hc_mem
    -- induced endomorphisms of the quotient
    let U : V ⧸ L →ₗ[K] V ⧸ L := L.mapQ L (u : V →ₗ[K] V) hu_le
    let W : V ⧸ L →ₗ[K] V ⧸ L := L.mapQ L (w : V →ₗ[K] V) hw_le
    let Ui : V ⧸ L →ₗ[K] V ⧸ L := L.mapQ L (u.symm : V →ₗ[K] V) hu'_le
    let Wi : V ⧸ L →ₗ[K] V ⧸ L := L.mapQ L (w.symm : V →ₗ[K] V) hw'_le
    have hUUi : U * Ui = 1 := by
      apply LinearMap.ext
      intro z
      refine Submodule.Quotient.induction_on L z ?_
      intro a
      simp [U, Ui, Submodule.mapQ_apply]
    have hWWi : W * Wi = 1 := by
      apply LinearMap.ext
      intro z
      refine Submodule.Quotient.induction_on L z ?_
      intro a
      simp [W, Wi, Submodule.mapQ_apply]
    -- the induced map of the commutator is the product of the induced maps
    have hceq : L.mapQ L (↑(u * w * u⁻¹ * w⁻¹) : V →ₗ[K] V) hc_le = U * W * Ui * Wi := by
      apply LinearMap.ext
      intro z
      refine Submodule.Quotient.induction_on L z ?_
      intro a
      simp [U, W, Ui, Wi, Submodule.mapQ_apply]
    -- all endomorphisms of the cyclic module `V ⧸ L` commute
    have hone : L.mapQ L (↑(u * w * u⁻¹ * w⁻¹) : V →ₗ[K] V) hc_le = 1 := by
      rw [hceq]
      have hUiW : W * Ui = Ui * W := (end_mul_comm_of_span_singleton hy Ui W).symm
      rw [mul_assoc U W Ui, hUiW, ← mul_assoc U Ui W, hUUi, one_mul, hWWi]
    have h := LinearMap.congr_fun hone (Submodule.Quotient.mk v)
    rw [Submodule.mapQ_apply] at h
    rw [Module.End.one_eq_id, LinearMap.id_apply] at h
    rw [Submodule.Quotient.eq] at h
    exact h

end Work.GL2odd
