/-!
# Endomorphisms of a module generated by a single element

A module over a commutative (semi)ring that is generated by a single element has a commutative
endomorphism ring: every endomorphism is a scalar map `c • id`, and scalar maps commute.

This is the algebraic heart of the statement that a group of `K`-linear maps preserving a
one-dimensional subspace `L` induces commuting maps on both `L` and the quotient `V ⧸ L`.

## Main results

* `Work.GL2odd.end_mul_comm_of_span_singleton`
* `Work.GL2odd.span_singleton_self_span_top`
-/

namespace Work.GL2odd

/-- **Endomorphisms of a cyclic module commute.**  If `M` is generated by the single element `x`,
then any two `R`-linear endomorphisms of `M` commute (they are both scalar multiplications). -/
theorem end_mul_comm_of_span_singleton {R M : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M] {x : M} (h : Submodule.span R {x} = ⊤)
    (f g : M →ₗ[R] M) : f * g = g * f := by
  apply LinearMap.ext_on h
  intro y hy
  rw [Set.mem_singleton_iff] at hy
  rw [hy]
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
    (show g x ∈ Submodule.span R {x} by rw [h]; exact trivial)
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp
    (show f x ∈ Submodule.span R {x} by rw [h]; exact trivial)
  rw [Module.End.mul_apply, Module.End.mul_apply]
  calc f (g x) = f (a • x) := by rw [ha]
    _ = a • f x := map_smul f a x
    _ = a • (b • x) := by rw [hb]
    _ = b • (a • x) := by rw [smul_comm]
    _ = b • g x := by rw [ha]
    _ = g (b • x) := (map_smul g b x).symm
    _ = g (f x) := by rw [hb]

/-- The submodule `R ∙ x` is generated, *as a module*, by the element `x`. -/
theorem span_singleton_self_span_top {R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
    (x : M) :
    Submodule.span R {(⟨x, Submodule.mem_span_singleton_self x⟩ : Submodule.span R {x})} = ⊤ := by
  rw [Submodule.eq_top_iff']
  rintro ⟨y, hy⟩
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hy
  rw [Submodule.mem_span_singleton]
  exact ⟨c, by ext; simpa using hc⟩

end Work.GL2odd
