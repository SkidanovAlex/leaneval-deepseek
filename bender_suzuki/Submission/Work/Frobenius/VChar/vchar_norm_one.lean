/-!
# A virtual character of norm one is `±` an irreducible character (Frobenius layer)

`Work.Frobenius.IsVChar f` says that `f` lies in the additive subgroup of `G → ℂ` generated by
the irreducible characters `Work.Frobenius.Irr G`, and `Work.Frobenius.charPair` is the bilinear
trace pairing `|G|⁻¹ ∑ x, f x * g x⁻¹`, under which the irreducible characters are orthonormal
(`charPair_irr_eq_ite`).

The purpose of this file is the standard consequence: if `charPair f f = 1` then `f` is `±χ`
for some irreducible character `χ` (this is the statement that "an isometry of `ℤ[Irr G]` sends
`±Irr G` to `±Irr G`", used in the Frobenius-group arguments of the odd-order project).

The proof is elementary: writing `f = ∑_{x ∈ s} c x • x` with `s` a finite set of irreducible
characters and `c x ∈ ℤ` (possible by definition of `IsVChar`), bilinearity of the pairing and
orthonormality give `charPair f f = ∑_{x ∈ s} (c x)^2`, a sum of squares of integers; equality
to `1` forces exactly one coefficient to be nonzero, and it is `±1`.

## Main results

* `Work.Frobenius.VChar.zSpan`, `mem_zSpan`, `self_mem_zSpan`, `zSpan_eq_closure`,
  `zSpan_le_iff`, `zSpan_mono` — the integral lattice spanned by a finite set of functions.
* `Work.Frobenius.VChar.isVChar_iff_zSpan` / `isVChar_iff_coeff` — virtual characters are the
  finite integral combinations of irreducible characters.
* `Work.Frobenius.VChar.charPair_self_eq_sum_sq` — the norm formula.
* `Work.Frobenius.VChar.sum_sq_eq_one_int` — integer arithmetic.
* `Work.Frobenius.VChar.vchar_norm_one` — the target.
-/

set_option linter.unusedSectionVars false

@[expose] public section

noncomputable section

open Classical

namespace Work.Frobenius.VChar

variable {G : Type*} [Group G] [Fintype G]

/-- The integral lattice spanned by a finite set `s` of complex valued functions: the set of
finite integral linear combinations `∑ x ∈ s, c x • x`. -/
def zSpan (s : Finset (G → ℂ)) : AddSubgroup (G → ℂ) where
  carrier := {f | ∃ c : s → ℤ, f = ∑ x : s, (c x : ℂ) • (x : G → ℂ)}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro f g ⟨c, rfl⟩ ⟨d, rfl⟩
    refine ⟨c + d, ?_⟩
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun z _ => by
      simp only [Pi.add_apply, Int.cast_add, add_smul]
  neg_mem' := by
    rintro f ⟨c, rfl⟩
    refine ⟨-c, ?_⟩
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun z _ => by
      simp only [Pi.neg_apply, Int.cast_neg, neg_smul]

theorem mem_zSpan {s : Finset (G → ℂ)} {f : G → ℂ} :
    f ∈ zSpan s ↔ ∃ c : s → ℤ, f = ∑ x : s, (c x : ℂ) • (x : G → ℂ) := Iff.rfl

theorem self_mem_zSpan {s : Finset (G → ℂ)} {x : G → ℂ} (hx : x ∈ s) : x ∈ zSpan s := by
  refine ⟨fun y => if y = ⟨x, hx⟩ then 1 else 0, ?_⟩
  rw [Finset.sum_eq_single (⟨x, hx⟩ : s)]
  · simp
  · intro b _ hb
    simp [hb]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem zSpan_eq_closure (s : Finset (G → ℂ)) :
    zSpan s = AddSubgroup.closure (↑s : Set (G → ℂ)) := by
  refine le_antisymm ?_ ?_
  · rintro f ⟨c, rfl⟩
    exact AddSubgroup.sum_mem _ fun x _ => by
      rw [Int.cast_smul_eq_zsmul]
      exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure x.2) _
  · rw [AddSubgroup.closure_le]
    exact fun x hx => self_mem_zSpan hx

theorem zSpan_le_iff {s : Finset (G → ℂ)} {K : AddSubgroup (G → ℂ)} :
    zSpan s ≤ K ↔ (↑s : Set (G → ℂ)) ⊆ K := by
  rw [zSpan_eq_closure]
  exact AddSubgroup.closure_le K

theorem zSpan_mono {s t : Finset (G → ℂ)} (h : s ⊆ t) : zSpan s ≤ zSpan t := by
  rw [zSpan_le_iff]
  exact fun x hx => self_mem_zSpan (h hx)

theorem isVChar_iff_zSpan {f : G → ℂ} :
    IsVChar f ↔ ∃ s : Finset (G → ℂ), (↑s : Set (G → ℂ)) ⊆ Irr G ∧ f ∈ zSpan s := by
  constructor
  · intro hf
    refine AddSubgroup.closure_induction
      (p := fun f _ => ∃ s : Finset (G → ℂ), (↑s : Set (G → ℂ)) ⊆ Irr G ∧ f ∈ zSpan s)
      ?_ ?_ ?_ ?_ hf
    · intro x hx
      refine ⟨{x}, ?_, self_mem_zSpan (by simp)⟩
      intro z hz
      rw [Finset.mem_coe, Finset.mem_singleton] at hz
      rwa [hz]
    · exact ⟨∅, by simp, by simp⟩
    · rintro x y _ _ ⟨s, hs, hxs⟩ ⟨t, ht, hyt⟩
      refine ⟨s ∪ t, ?_, ?_⟩
      · intro z hz
        rcases Finset.mem_union.mp hz with h | h
        · exact hs h
        · exact ht h
      · exact AddSubgroup.add_mem _
          (zSpan_mono Finset.subset_union_left hxs) (zSpan_mono Finset.subset_union_right hyt)
    · rintro x _ ⟨s, hs, hxs⟩
      exact ⟨s, hs, AddSubgroup.neg_mem _ hxs⟩
  · rintro ⟨s, hs, hfs⟩
    have hle : zSpan s ≤ AddSubgroup.closure (Irr G) :=
      zSpan_le_iff.mpr (fun x hx => AddSubgroup.subset_closure (hs hx))
    exact hle hfs

theorem isVChar_iff_coeff {f : G → ℂ} :
    IsVChar f ↔ ∃ s : Finset (G → ℂ), (↑s : Set (G → ℂ)) ⊆ Irr G ∧
      ∃ c : s → ℤ, f = ∑ x : s, (c x : ℂ) • (x : G → ℂ) := by
  rw [isVChar_iff_zSpan]
  constructor
  · rintro ⟨s, hs, hfs⟩
    exact ⟨s, hs, mem_zSpan.mp hfs⟩
  · rintro ⟨s, hs, c, hc⟩
    exact ⟨s, hs, mem_zSpan.mpr ⟨c, hc⟩⟩

theorem charPair_self_eq_sum_sq {s : Finset (G → ℂ)} (hs : (↑s : Set (G → ℂ)) ⊆ Irr G)
    {f : G → ℂ} {c : s → ℤ} (hf : f = ∑ x : s, (c x : ℂ) • (x : G → ℂ)) :
    charPair f f = ∑ x : s, ((c x : ℤ) : ℂ) ^ 2 := by
  subst hf
  rw [charPair_sum_smul_left]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [charPair_sum_smul_right]
  have hinner : (∑ y : s, (c y : ℂ) * charPair (x : G → ℂ) (y : G → ℂ)) = (c x : ℂ) := by
    refine (Finset.sum_eq_single x ?_ ?_).trans ?_
    · intro y _ hy
      rw [Irr.charPair_irr_eq_ite (hs x.2) (hs y.2)]
      have hne : ¬ ((x : G → ℂ) = (y : G → ℂ)) := fun h => hy (Subtype.ext h).symm
      simp [hne]
    · intro h; exact absurd (Finset.mem_univ _) h
    · rw [Irr.charPair_irr_eq_ite (hs x.2) (hs x.2)]
      simp
  rw [hinner]
  ring

theorem sum_sq_eq_one_int {ι : Type*} [Fintype ι] (c : ι → ℤ)
    (h : ∑ i, c i ^ 2 = 1) :
    ∃ i₀, (c i₀ = 1 ∨ c i₀ = -1) ∧ ∀ i, i ≠ i₀ → c i = 0 := by
  classical
  -- some coefficient is nonzero
  have hex : ∃ i, c i ≠ 0 := by
    by_contra hcon
    have h0 : ∑ i, c i ^ 2 = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      have : c i = 0 := by
        by_contra hci
        exact hcon ⟨i, hci⟩
      simp [this]
    omega
  obtain ⟨i₀, hi₀⟩ := hex
  -- and then it is `±1`
  have hle : c i₀ ^ 2 ≤ 1 := by
    have h1 : c i₀ ^ 2 ≤ ∑ i, c i ^ 2 :=
      Finset.single_le_sum (fun i _ => sq_nonneg (c i)) (Finset.mem_univ i₀)
    rwa [h] at h1
  have hge : 1 ≤ c i₀ ^ 2 := by
    have hpos := sq_pos_of_ne_zero hi₀
    omega
  have heq : c i₀ ^ 2 = 1 := le_antisymm hle hge
  have hunit : c i₀ = 1 ∨ c i₀ = -1 := sq_eq_one_iff.mp heq
  refine ⟨i₀, hunit, ?_⟩
  -- all the other coefficients vanish because the remaining sum of squares is `0`
  intro i hi
  have herase : ∑ j ∈ Finset.univ.erase i₀, c j ^ 2 = 0 := by
    have hsplit := Finset.sum_erase_add (s := Finset.univ) (f := fun j => c j ^ 2)
      (Finset.mem_univ i₀)
    rw [h, heq] at hsplit
    omega
  have hz : c i ^ 2 = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => sq_nonneg (c j))).mp herase i
      (Finset.mem_erase.mpr ⟨hi, Finset.mem_univ i⟩)
  exact sq_eq_zero_iff.mp hz

theorem vchar_norm_one {G : Type*} [Group G] [Fintype G] {f : G → ℂ} (hV : IsVChar f)
    (h1 : charPair f f = 1) : ∃ χ ∈ Irr G, f = χ ∨ f = -χ := by
  obtain ⟨s, hs, c, hc⟩ := isVChar_iff_coeff.mp hV
  -- the norm formula turns `charPair f f = 1` into `∑ (c x)^2 = 1` over the integers
  have hsumC : ∑ x : s, ((c x : ℤ) : ℂ) ^ 2 = 1 := by
    rw [← charPair_self_eq_sum_sq hs hc]; exact h1
  have hsZ : ∑ x : s, (c x) ^ 2 = 1 := by
    have hcast : ((∑ x : s, (c x) ^ 2 : ℤ) : ℂ) = 1 := by
      push_cast
      exact hsumC
    exact_mod_cast hcast
  obtain ⟨x₀, hunit, hzero⟩ := sum_sq_eq_one_int c hsZ
  -- so `f` is `±` the single summand at `x₀`
  refine ⟨(x₀ : G → ℂ), hs x₀.2, ?_⟩
  have hfval : f = (c x₀ : ℂ) • (x₀ : G → ℂ) := by
    rw [hc, Finset.sum_eq_single x₀]
    · intro b _ hb
      simp [hzero b hb]
    · intro h; exact absurd (Finset.mem_univ _) h
  rcases hunit with h1' | h1'
  · left; rw [hfval, h1']; simp
  · right; rw [hfval, h1']; simp

end Work.Frobenius.VChar
