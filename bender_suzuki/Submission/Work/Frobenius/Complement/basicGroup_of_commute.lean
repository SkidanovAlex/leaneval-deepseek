namespace Work.Frobenius.Complement

set_option linter.style.haveILetI false

/-- If `x` and `y` are commuting elements of order a prime `p`, and `x` is not in the subgroup
generated by `y`, then the group they generate contains a subgroup isomorphic to
`Multiplicative (ZMod p × ZMod p)`. -/
lemma basicGroup_of_commute {p : ℕ} (hp : p.Prime) {G : Type*} [Group G] {x y : G}
    (hx : orderOf x = p) (hy : orderOf y = p) (hxy : x * y = y * x)
    (hne : x ∉ Subgroup.zpowers y) :
    ∃ Q : Subgroup G, Nonempty (Q ≃* Multiplicative (ZMod p × ZMod p)) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  set A : Subgroup G := Subgroup.zpowers x with hA
  set B : Subgroup G := Subgroup.zpowers y with hB
  have hcardA : Nat.card A = p := by rw [hA, Nat.card_zpowers, hx]
  have hcomm : Commute x y := hxy
  -- `A` and `B` have trivial intersection
  have hdisj : Disjoint A B := by
    rw [disjoint_iff_inf_le]
    intro z hz
    rw [Subgroup.mem_inf] at hz
    obtain ⟨hzA, hzB⟩ := hz
    rw [Subgroup.mem_bot]
    by_contra hz1
    have hna : (⟨z, hzA⟩ : A) ≠ 1 := fun h => hz1 (Subtype.ext_iff.mp h)
    have htop : Subgroup.zpowers (⟨z, hzA⟩ : A) = ⊤ :=
      zpowers_eq_top_of_prime_card hcardA hna
    have hxA : (⟨x, by rw [hA]; exact Subgroup.mem_zpowers x⟩ : A) ∈
        Subgroup.zpowers (⟨z, hzA⟩ : A) := by
      rw [htop]; exact Subgroup.mem_top _
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hxA
    have hk' : z ^ k = x := by
      have h2 := congrArg (fun t : A => (t : G)) hk
      simpa using h2
    have hmem : x ∈ B := by rw [← hk']; exact B.zpow_mem hzB k
    exact hne (hB ▸ hmem)
  -- the map `A × B → G`, `(a, b) ↦ a * b`
  have comm : ∀ (a : A) (b : B), Commute (A.subtype a) (B.subtype b) := by
    intro a b
    have ha : (a : G) ∈ Subgroup.zpowers x := a.2
    have hb : (b : G) ∈ Subgroup.zpowers y := b.2
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp ha
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hb
    show Commute (a : G) (b : G)
    rw [← hk, ← hm]
    exact Commute.zpow_zpow hcomm k m
  let f : A × B →* G := MonoidHom.noncommCoprod A.subtype B.subtype comm
  have hf_inj : Function.Injective f := by
    have key := MonoidHom.noncommCoprod_injective A.subtype B.subtype comm
    exact key.mpr ⟨A.subtype_injective, B.subtype_injective, by
      rw [Subgroup.range_subtype, Subgroup.range_subtype]
      exact hdisj⟩
  have eA : A ≃* Multiplicative (ZMod p) := by
    haveI : IsCyclic A := Subgroup.isCyclic_zpowers x
    exact hcardA ▸ (zmodCyclicMulEquiv (G := A) inferInstance).symm
  have eB : B ≃* Multiplicative (ZMod p) := by
    haveI : IsCyclic B := Subgroup.isCyclic_zpowers y
    have hcardB : Nat.card B = p := by rw [hB, Nat.card_zpowers, hy]
    exact hcardB ▸ (zmodCyclicMulEquiv (G := B) inferInstance).symm
  have eAB : A × B ≃* Multiplicative (ZMod p × ZMod p) :=
    (MulEquiv.prodCongr eA eB).trans (MulEquiv.prodMultiplicative (ZMod p) (ZMod p)).symm
  exact ⟨f.range, ⟨(MonoidHom.ofInjective hf_inj).symm.trans eAB⟩⟩

end Work.Frobenius.Complement
