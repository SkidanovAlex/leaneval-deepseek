namespace Work.Frobenius.Complement

/-- **The `p`--`q` fixed-point-free contradiction.**

Let `T`, `X` be `F`-linear endomorphisms of a nontrivial finite-dimensional `F`-vector space `W`,
with `T ^ q = 1` and `X ^ p = 1` for distinct primes `p`, `q` invertible in `F`.  Suppose both
`T` and `X` act fixed-point-freely, and suppose `X` conjugates `T` into a power of itself,
`X (T w) = (T ^ s) (X w)` for all `w`, with `s % q ≠ 1`.  Then we reach a contradiction: the
group generated by `T` and `X` is a non-abelian group of order `p q`, and such a group admits no
fixed-point-free module.

The mathematical input is `Work.Frobenius.Complement.exists_fixed_of_isFpf_module`: in this
situation `X` must have a nonzero fixed vector, contradicting fixed-point-freeness. -/
theorem fpf_module_pq_contradiction {F W : Type*} [Field F] [AddCommGroup W] [Module F W]
    [FiniteDimensional F W] [Nontrivial W] {p q s : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (hpF : (p : F) ≠ 0) (hqF : (q : F) ≠ 0) (hs : s % q ≠ 1)
    {T X : W →ₗ[F] W} (hTq : T ^ q = 1) (hT1 : ∀ w, T w = w → w = 0)
    (hXp : X ^ p = 1) (hX1 : ∀ w, X w = w → w = 0)
    (hrel : ∀ w, X (T w) = (T ^ s) (X w)) : False := by
  obtain ⟨w, hwne, hXw⟩ :=
    exists_fixed_of_isFpf_module (F := F) (W := W) hp hq hpF hqF hs hTq hT1 hXp hrel
  exact hwne (hX1 w hXw)

end Work.Frobenius.Complement
