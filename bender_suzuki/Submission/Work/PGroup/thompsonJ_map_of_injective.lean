import Mathlib
import Submission.Work.PGroup.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `J(P)` is natural under injective homomorphisms

`Work.PGroup.thompsonJ P` is the subgroup generated by the abelian subgroups of `P` of maximal
order.  An injective homomorphism `f : G →* H` induces a bijection `A ↦ A.map f` between the
subgroups of `P` and those of `P.map f`, preserving commutativity and cardinality; consequently
the sets of natural numbers whose supremum is `Work.PGroup.maxAbelianOrder` agree, and the
generating set of `J(P)` is carried onto the generating set of `J(P.map f)`.
-/

set_option linter.style.haveILetI false

namespace Work.PGroup

/-- `Nat.card` is carried across an injective subgroup map. -/
private lemma natCard_map_eq {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) (A : Subgroup G) :
    Nat.card (A.map f) = Nat.card A :=
  Subgroup.card_map_of_injective hf

/-- Commutativity is preserved by a subgroup map. -/
private lemma map_isMulCommutative' {G H : Type*} [Group G] [Group H] (f : G →* H)
    (A : Subgroup G) [IsMulCommutative A] : IsMulCommutative (A.map f) :=
  Subgroup.map_isMulCommutative A f

/-- Commutativity is reflected by an injective subgroup map. -/
private lemma comap_isMulCommutative' {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) (B : Subgroup H) [IsMulCommutative B] :
    IsMulCommutative (B.comap f) :=
  Subgroup.comap_injective_isMulCommutative (H := B) hf

/-- `maxAbelianOrder` is natural under injective homomorphisms. -/
theorem maxAbelianOrder_map_of_injective {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) (P : Subgroup G) :
    Work.PGroup.maxAbelianOrder (P.map f) = Work.PGroup.maxAbelianOrder P := by
  have hset : {n : ℕ | ∃ A : Subgroup G, A ≤ P ∧ IsMulCommutative A ∧ Nat.card A = n}
      = {n : ℕ | ∃ B : Subgroup H, B ≤ P.map f ∧ IsMulCommutative B ∧ Nat.card B = n} := by
    ext n
    constructor
    · rintro ⟨A, hA, hAcomm, hAcard⟩
      haveI : IsMulCommutative A := hAcomm
      exact ⟨A.map f, Subgroup.map_mono hA, map_isMulCommutative' f A,
        (natCard_map_eq f hf A).trans hAcard⟩
    · rintro ⟨B, hB, hBcomm, hBcard⟩
      have hBrange : B ≤ f.range := hB.trans (Subgroup.map_le_range f P)
      refine ⟨B.comap f, ?_, ?_, ?_⟩
      · rw [← Subgroup.comap_map_eq_self_of_injective hf P]
        exact Subgroup.comap_mono hB
      · haveI : IsMulCommutative B := hBcomm
        exact comap_isMulCommutative' f hf B
      · calc Nat.card (B.comap f) = Nat.card ((B.comap f).map f) :=
              (natCard_map_eq f hf (B.comap f)).symm
          _ = Nat.card B := by rw [Subgroup.map_comap_eq_self hBrange]
          _ = n := hBcard
  rw [maxAbelianOrder, maxAbelianOrder, hset]

/-- `J(P)` is natural under injective homomorphisms: `J(P.map f) = J(P).map f`.  An injective
`f` gives a bijection `A ↦ A.map f` between the subgroups of `P` and those of `P.map f` which
preserves commutativity and cardinality, so the sets of natural numbers defining
`Work.PGroup.maxAbelianOrder` agree, and `thompsonJ` (a closure of a union of such subgroups)
transports.  This generalizes `Work.PGroup.thompsonJ_characteristic`. -/
theorem thompsonJ_map_of_injective {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) (P : Subgroup G) :
    Work.PGroup.thompsonJ (P.map f) = (Work.PGroup.thompsonJ P).map f := by
  have hm := maxAbelianOrder_map_of_injective f hf P
  refine le_antisymm ?_ ?_
  · -- `J(P.map f) ≤ J(P).map f`
    rw [thompsonJ, Subgroup.closure_le]
    rintro y ⟨B, hB, hBcomm, hBcard, hyB⟩
    have hBrange : B ≤ f.range := hB.trans (Subgroup.map_le_range f P)
    have hmap : (B.comap f).map f = B := Subgroup.map_comap_eq_self hBrange
    obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp (hmap ▸ hyB)
    refine hxy ▸ Subgroup.mem_map_of_mem f ?_
    refine le_thompsonJ ?_ ?_ ?_ hx
    · rw [← Subgroup.comap_map_eq_self_of_injective hf P]
      exact Subgroup.comap_mono hB
    · haveI : IsMulCommutative B := hBcomm
      exact comap_isMulCommutative' f hf B
    · calc Nat.card (B.comap f) = Nat.card ((B.comap f).map f) :=
            (natCard_map_eq f hf (B.comap f)).symm
        _ = Nat.card B := by rw [hmap]
        _ = maxAbelianOrder (P.map f) := hBcard
        _ = maxAbelianOrder P := hm
  · -- `J(P).map f ≤ J(P.map f)`
    rw [Subgroup.map_le_iff_le_comap, thompsonJ, Subgroup.closure_le]
    rintro x ⟨A, hA, hAcomm, hAcard, hxA⟩
    refine Subgroup.mem_comap.mpr ?_
    refine le_thompsonJ ?_ ?_ ?_ (Subgroup.mem_map_of_mem f hxA)
    · exact Subgroup.map_mono hA
    · haveI : IsMulCommutative A := hAcomm
      exact map_isMulCommutative' f A
    · rw [natCard_map_eq f hf A, hAcard, hm]

end Work.PGroup
