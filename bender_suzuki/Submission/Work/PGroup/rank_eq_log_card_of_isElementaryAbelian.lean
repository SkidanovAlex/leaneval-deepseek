import Mathlib
import Submission.Work.PGroup.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
open scoped Pointwise
open scoped IsMulCommutative

namespace Work.PGroup

noncomputable section

/-- The minimum number of generators of a finite elementary abelian `p`-group equals
`log_p` of its order: an elementary abelian `p`-group of order `p ^ n` is an `n`-dimensional
vector space over `𝔽_p`, and both its minimal number of generators and `log_p` of its order
are `n`. -/
theorem rank_eq_log_card_of_isElementaryAbelian {G : Type*} [Group G] {p : ℕ} (hp : p.Prime)
    (E : Subgroup G) [Finite E] (hE : Work.PGroup.IsElementaryAbelian p E) :
    Group.rank E = Nat.log p (Nat.card E) := by
  classical
  haveI : IsMulCommutative E := hE.comm
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Nonempty E := ⟨⟨1, E.one_mem⟩⟩
  -- `E` is a vector space over `𝔽_p`: the `ZMod p`-module structure on the additive group `E`.
  haveI hmod : Module (ZMod p) (Additive E) := AddCommGroup.zmodModule (fun x => by
    refine Additive.ext ?_
    rw [toMul_nsmul, toMul_zero]
    exact hE.pow_eq_one x.toMul)
  haveI : Module.Finite (ZMod p) (Additive E) := Module.Finite.of_finite
  haveI : Module.Free (ZMod p) (Additive E) := Module.Free.of_divisionRing _ _
  haveI : StrongRankCondition (ZMod p) := commRing_strongRankCondition _
  -- The order of `E` is `p` to the dimension of this vector space.
  have hcard : Nat.card E = p ^ Module.finrank (ZMod p) (Additive E) := by
    rw [Nat.card_congr (Additive.ofMul (α := E)),
      Module.natCard_eq_pow_finrank (K := ZMod p) (V := Additive E), Nat.card_zmod]
  have hlog : Nat.log p (Nat.card E) = Module.finrank (ZMod p) (Additive E) := by
    rw [hcard, Nat.log_pow hp.one_lt]
  refine le_antisymm ?_ ?_
  · -- Upper bound: produce a generating set of size the dimension from a basis.
    rw [hlog]
    let b : Module.Basis (Fin (Module.finrank (ZMod p) (Additive E))) (ZMod p) (Additive E) :=
      Module.finBasis (ZMod p) (Additive E)
    let f : Fin (Module.finrank (ZMod p) (Additive E)) → E := fun i => (b i).toMul
    let H : Subgroup E := Subgroup.closure (Set.range f)
    have hmem : ∀ a : Additive E, a.toMul ∈ H := by
      intro a
      let Q : AddSubgroup (Additive E) :=
        { carrier := {a : Additive E | a.toMul ∈ H}
          zero_mem' := by
            show Additive.toMul (0 : Additive E) ∈ H
            rw [toMul_zero]
            exact H.one_mem
          add_mem' := by
            intro x y hx hy
            show Additive.toMul (x + y) ∈ H
            rw [toMul_add]
            exact H.mul_mem hx hy
          neg_mem' := by
            intro x hx
            show Additive.toMul (-x) ∈ H
            rw [toMul_neg]
            exact H.inv_mem hx }
      have hspan : Submodule.span (ZMod p) (Set.range b) ≤
          AddSubgroup.toZModSubmodule p Q :=
        Submodule.span_le.mpr (by
          rintro y ⟨i, rfl⟩
          show Additive.toMul (b i) ∈ H
          exact Subgroup.subset_closure (show f i ∈ Set.range f from ⟨i, rfl⟩))
      have ha : a ∈ Submodule.span (ZMod p) (Set.range b) := by
        rw [b.span_eq]
        exact Submodule.mem_top
      exact hspan ha
    have htop : H = ⊤ := by
      rw [eq_top_iff]
      intro x _
      exact hmem (Additive.ofMul x)
    have hS : Subgroup.closure ((Finset.univ.image f : Finset E) : Set E) = ⊤ := by
      simpa [Finset.coe_image, Finset.coe_univ, Set.image_univ] using htop
    refine (Group.rank_le hS).trans ?_
    calc (Finset.univ.image f).card ≤ (Finset.univ : Finset (Fin _)).card := Finset.card_image_le
      _ = Module.finrank (ZMod p) (Additive E) := by rw [Finset.card_univ, Fintype.card_fin]
  · -- Lower bound: a group generated by `r` elements of exponent `p` has order dividing `p ^ r`.
    have hexp : Monoid.exponent E ∣ p :=
      Monoid.exponent_dvd_of_forall_pow_eq_one (fun x => hE.pow_eq_one x)
    have hdvd : Nat.card E ∣ p ^ Group.rank E :=
      (card_dvd_exponent_pow_rank E).trans (pow_dvd_pow_of_dvd hexp _)
    have hle : Nat.card E ≤ p ^ Group.rank E := Nat.le_of_dvd (pow_pos hp.pos _) hdvd
    have hlt : Nat.card E < p ^ (Group.rank E + 1) :=
      hle.trans_lt (Nat.pow_lt_pow_right hp.one_lt (Nat.lt_succ_self _))
    exact Nat.lt_succ_iff.mp
      ((Nat.log_lt_iff_lt_pow hp.one_lt (Nat.card_pos (α := E)).ne').mpr hlt)

end

end Work.PGroup
