/-!
# The subgroup `[x, A]` generated by the commutators `⁅x, a⁆`

This small module fixes the vocabulary used by Thompson's replacement theorem: given an element
`x` of a group `G` and a subgroup `A ≤ G`, `Work.PGroup.commClosure x A` is the subgroup
generated by the commutators `⁅x, a⁆` with `a ∈ A`, i.e. the classical `[x, A]`.

It is deliberately *not* the subgroup commutator `⁅Subgroup.zpowers x, A⁆` (which also contains
commutators `⁅x ^ k, a⁆`); the counting argument in Thompson's product lemma uses exactly the
image of `A` under the `crossed homomorphism' `a ↦ ⁅x, a⁆`, so the closure of that image is the
right object.
-/

set_option linter.unusedVariables false
open scoped Classical Pointwise commutatorElement
open Subgroup

noncomputable section

namespace Work.PGroup

variable {G : Type*} [Group G]

/-- `commClosure x A = [x, A]`: the subgroup generated by the commutators `⁅x, a⁆`, `a ∈ A`. -/
def commClosure (x : G) (A : Subgroup G) : Subgroup G :=
  Subgroup.closure ((fun a : G => ⁅x, a⁆) '' (A : Set G))

theorem mem_commClosure {x : G} {A : Subgroup G} {a : G} (ha : a ∈ A) :
    ⁅x, a⁆ ∈ commClosure x A :=
  Subgroup.subset_closure ⟨a, ha, rfl⟩

theorem commClosure_le {x : G} {A M : Subgroup G}
    (h : ∀ a : G, a ∈ A → ⁅x, a⁆ ∈ M) : commClosure x A ≤ M := by
  rw [commClosure, Subgroup.closure_le]
  rintro m ⟨a, ha, rfl⟩
  exact h a ha

theorem le_commClosure_iff {x : G} {A M : Subgroup G} :
    commClosure x A ≤ M ↔ ∀ a : G, a ∈ A → ⁅x, a⁆ ∈ M :=
  ⟨fun h a ha => h (mem_commClosure ha), fun h => commClosure_le h⟩

/-- A subgroup of a commutative subgroup is commutative. -/
theorem isMulCommutative_of_le {H K : Subgroup G} (hK : IsMulCommutative K) (h : H ≤ K) :
    IsMulCommutative H := by
  refine isMulCommutative_iff.mpr fun a b => Subtype.ext ?_
  simpa using congrArg Subtype.val (isMulCommutative_iff.mp hK ⟨a, h a.2⟩ ⟨b, h b.2⟩)

end Work.PGroup
