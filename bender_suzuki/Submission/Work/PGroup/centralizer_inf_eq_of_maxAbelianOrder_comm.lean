import Mathlib
import Submission.Work.PGroup.Basic
import Submission.Work.PGroup.le_maxAbelianOrder

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `P ∩ C_G(A) = A` for `A` an abelian subgroup of `P` of maximal order (commutative-hypothesis form)

Let `P` be a *finite* subgroup of a group `G` (no `p`-group hypothesis is needed) and let
`A ≤ P` be abelian with `|A| = maxAbelianOrder P`, i.e. `A` is of maximal order among the
abelian subgroups of `P`.  Then `A` is self-centralizing in `P`:

`P ⊓ C_G(A) = A`.

The proof is elementary.  Clearly `A ≤ P ⊓ C_G(A)`.  Conversely, if `x ∈ P` centralizes `A`,
then the subgroup `B = ⟨A, x⟩` generated by `A` and `x` is *abelian* (it is generated by the
abelian `A` together with an element centralizing `A`), and `B ≤ P`.  Hence
`|A| ≤ |B| ≤ maxAbelianOrder P = |A|`, so `|A| = |B|`; as `A ≤ B` and both are finite, `A = B`,
whence `x ∈ A`.

Compare FT §3 and Gorenstein, *Finite Groups*, §5.3 (a maximal abelian subgroup of a `p`-group
equals its centralizer).
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open Subgroup

namespace Work.PGroup

theorem centralizer_inf_eq_of_maxAbelianOrder_comm {G : Type*} [Group G] {P A : Subgroup G} [Finite P]
    (hA : A ≤ P) (hAab : IsMulCommutative A) (hAmax : Nat.card A = Work.PGroup.maxAbelianOrder P) :
    P ⊓ Subgroup.centralizer (A : Set G) = A := by
  refine le_antisymm ?_ (le_inf hA (Subgroup.le_centralizer_iff_isMulCommutative.mpr hAab))
  intro x hx
  rw [Subgroup.mem_inf] at hx
  obtain ⟨hxP, hxC⟩ := hx
  -- the subgroup generated by `A` and `x`
  set B : Subgroup G := Subgroup.closure ((A : Set G) ∪ {x}) with hBdef
  have hAleB : A ≤ B := fun y hy => Subgroup.subset_closure (Or.inl hy)
  have hxB : x ∈ B := Subgroup.subset_closure (Or.inr rfl)
  have hBP : B ≤ P := by
    rw [hBdef, Subgroup.closure_le]
    rintro y (hy | hy)
    · exact hA hy
    · rw [Set.mem_singleton_iff] at hy
      exact hy ▸ hxP
  -- `B` is abelian, generated by the abelian `A` and the element `x` centralizing `A`
  have hBcomm : IsMulCommutative B := by
    rw [hBdef]
    apply Subgroup.isMulCommutative_closure
    intro a ha b hb _
    rw [Set.mem_union] at ha hb
    rcases ha with ha | ha
    · rcases hb with hb | hb
      · exact congrArg Subtype.val (mul_comm' (⟨a, ha⟩ : ↥A) (⟨b, hb⟩ : ↥A))
      · rw [Set.mem_singleton_iff] at hb
        subst hb
        exact Subgroup.mem_centralizer_iff.mp hxC a ha
    · rw [Set.mem_singleton_iff] at ha
      subst ha
      rcases hb with hb | hb
      · exact (Subgroup.mem_centralizer_iff.mp hxC b hb).symm
      · rw [Set.mem_singleton_iff] at hb
        subst hb
        rfl
  -- `B` is finite, being contained in the finite group `P`
  haveI : Finite ↥B :=
    Finite.of_injective (Subgroup.inclusion hBP) (Subgroup.inclusion_injective hBP)
  -- `|B| ≤ maxAbelianOrder P = |A| ≤ |B|`, so `B = A`
  have hcard : Nat.card B ≤ Nat.card A :=
    (le_maxAbelianOrder P B hBP hBcomm).trans (le_of_eq hAmax.symm)
  have hBA : A = B := Subgroup.eq_of_le_of_card_ge hAleB hcard
  rw [← hBA] at hxB
  exact hxB

end Work.PGroup
