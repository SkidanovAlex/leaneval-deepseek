/-!
# The centralizer of a maximal abelian subgroup of a `p`-group

Let `P` be a finite `p`-subgroup of a group `G` and let `A ≤ P` be abelian and *maximal* among
the abelian subgroups of `P`: whenever `A ≤ B ≤ P` and `B` is abelian we have `B = A`.  Then
`A` is self-centralizing in `P`, i.e.

`P ⊓ C_G(A) = A`.

The argument is elementary and in fact does not use that `P` is a `p`-group.

* Clearly `A ≤ P ⊓ C_G(A)`, because `A` is contained in `P` and, being abelian, it centralizes
  itself.
* Conversely let `x ∈ P ⊓ C_G(A)`.  Then `x` commutes with every element of `A`, hence the
  subgroup `B = A ⊔ ⟨x⟩` is abelian: it is generated by `A` (abelian) together with a single
  element that centralizes `A`.  Clearly `A ≤ B` and `B ≤ P`.  Maximality of `A` gives `B = A`,
  whence `x ∈ A`.

## Main result

* `Work.PGroup.centralizer_inf_eq_of_maximal_abelian`
-/

set_option linter.unusedVariables false

open Subgroup

namespace Work.PGroup

theorem centralizer_inf_eq_of_maximal_abelian {G : Type*} [Group G] {p : ℕ} (hp : p.Prime)
    (P A : Subgroup G) [Finite P] (hP : IsPGroup p P) (hA : A ≤ P) (hAab : IsMulCommutative A)
    (hmax : ∀ B : Subgroup G, A ≤ B → B ≤ P → IsMulCommutative B → B = A) :
    P ⊓ Subgroup.centralizer (A : Set G) = A := by
  refine le_antisymm ?_ (le_inf hA ?_)
  · -- `P ⊓ C_G(A) ≤ A`
    intro x hx
    rw [Subgroup.mem_inf] at hx
    obtain ⟨hxP, hxC⟩ := hx
    -- The subgroup generated by `A` and `x` is abelian and contained in `P`.
    set B : Subgroup G := A ⊔ Subgroup.zpowers x with hB
    have hAB : A ≤ B := le_sup_left
    have hBP : B ≤ P := sup_le hA (Subgroup.zpowers_le.mpr hxP)
    have hBcomm : IsMulCommutative B := by
      rw [hB, Subgroup.sup_eq_closure]
      apply Subgroup.isMulCommutative_closure
      intro u hu v hv _
      rw [Set.mem_union] at hu hv
      rcases hu with huA | hux
      · -- `u ∈ A`
        rcases hv with hvA | hvx
        · exact isMulCommutative_iff_of_setLike.mp hAab u huA v hvA
        · obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hvx
          exact Commute.zpow_right (a := u)
            (show Commute u x from Subgroup.mem_centralizer_iff.mp hxC u huA) j
      · -- `u ∈ ⟨x⟩`
        obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hux
        rcases hv with hvA | hvx
        · exact Commute.zpow_left (b := v)
            (show Commute x v from (Subgroup.mem_centralizer_iff.mp hxC v hvA).symm) i
        · obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hvx
          exact ((Commute.refl x).zpow_left i).zpow_right j
    have hB_eq : B = A := hmax B hAB hBP hBcomm
    have hxB : x ∈ B := Subgroup.mem_sup_right (Subgroup.mem_zpowers x)
    rw [hB_eq] at hxB
    exact hxB
  · -- `A ≤ P ⊓ C_G(A)`
    intro a ha
    exact Subgroup.mem_centralizer_iff.mpr
      (fun b hb => isMulCommutative_iff_of_setLike.mp hAab b hb a ha)

end Work.PGroup
