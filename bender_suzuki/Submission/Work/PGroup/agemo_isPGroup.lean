namespace Work.PGroup

/-- `℧ⁱ(P)` is a `p`-group whenever `P` is: it is a subgroup of `P` (generated by `p ^ i`-th
powers of elements of `P`), and subgroups of a `p`-group are again `p`-groups, which is applied
here through the injective inclusion `℧ⁱ(P) ↪ P`. -/
theorem agemo_isPGroup {G : Type*} [Group G] {p : ℕ} (i : ℕ) (P : Subgroup G)
    (hP : IsPGroup p P) : IsPGroup p (Work.PGroup.agemo p i P) :=
  hP.of_injective (Subgroup.inclusion (agemo_le p i P)) (Subgroup.inclusion_injective _)

end Work.PGroup
