/-! ### Elementary group-theoretic helpers -/

/-- Two commuting elements form a pairwise commuting set. -/
theorem commute_pair_pairwise {G : Type*} [Group G] {x y : G} (h : x * y = y * x) :
    ({x, y} : Set G).Pairwise Commute := by
  rw [Set.pairwise_pair]
  exact fun _ => ⟨h, h.symm⟩

/-- The subgroup generated by two elements is the supremum of the cyclic subgroups. -/
theorem closure_pair_eq_zpowers_sup {G : Type*} [Group G] (x y : G) :
    Subgroup.closure ({x, y} : Set G) = Subgroup.zpowers x ⊔ Subgroup.zpowers y := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with hzx | hzy
    · rw [hzx]; exact Subgroup.mem_sup_left (Subgroup.mem_zpowers x)
    · rw [hzy]; exact Subgroup.mem_sup_right (Subgroup.mem_zpowers y)
  · refine sup_le ?_ ?_
    · rw [Subgroup.zpowers_le]
      exact Subgroup.subset_closure (by simp)
    · rw [Subgroup.zpowers_le]
      exact Subgroup.subset_closure (by simp)

/-- If `x, y` commute then so do the cyclic subgroups they generate. -/
theorem isMulCommutative_of_commute_zpowers_sup {G : Type*} [Group G] {x y : G}
    (h : x * y = y * x) : IsMulCommutative ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y) :=
  (closure_pair_eq_zpowers_sup x y) ▸ (Subgroup.isMulCommutative_closure (commute_pair_pairwise h))

/-- If `G = ⟨x, y⟩` with `x y = y x` then `G` is commutative. -/
theorem isMulCommutative_of_commute_of_closure_pair_eq_top {G : Type*} [Group G] {x y : G}
    (h : x * y = y * x) (htop : Subgroup.closure ({x, y} : Set G) = ⊤) :
    IsMulCommutative G := by
  have hc : IsMulCommutative ↥(Subgroup.closure ({x, y} : Set G)) :=
    Subgroup.isMulCommutative_closure (commute_pair_pairwise h)
  have hc' : IsMulCommutative ↥(⊤ : Subgroup G) := htop ▸ hc
  refine isMulCommutative_iff.mpr fun u v => ?_
  have h2 := isMulCommutative_iff.mp hc' (⟨u, trivial⟩ : ↥(⊤ : Subgroup G))
    (⟨v, trivial⟩ : ↥(⊤ : Subgroup G))
  exact congrArg Subtype.val h2

/-- Conjugation distributes over powers. -/
theorem conj_mul_pow {G : Type*} [Group G] (b x : G) (m : ℕ) :
    b * x ^ m * b⁻¹ = (b * x * b⁻¹) ^ m := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ, pow_succ, ← ih]; group

/-- If `b * a * b⁻¹ = a ^ κ` then `b ^ n * a * (b ^ n)⁻¹ = a ^ (κ ^ n)`. -/
theorem pow_conj_eq {G : Type*} [Group G] {a b : G} {κ : ℕ} (h : b * a * b⁻¹ = a ^ κ) (n : ℕ) :
    b ^ n * a * (b ^ n)⁻¹ = a ^ (κ ^ n) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hstep : b ^ (n + 1) * a * (b ^ (n + 1))⁻¹ = b * (b ^ n * a * (b ^ n)⁻¹) * b⁻¹ := by
      rw [pow_succ]; group
    rw [hstep, ih, conj_mul_pow b a (κ ^ n), h, ← pow_mul, pow_succ, Nat.mul_comm]

/-- The index of a subgroup of a finite group is positive. -/
theorem index_pos {G : Type*} [Group G] [Finite G] (H : Subgroup G) : 0 < H.index := by
  rw [Subgroup.index_eq_card]
  exact Nat.card_pos

/-- Cardinality formula: `|L| = [L : K] * |K|` for `K ≤ L`. -/
theorem card_eq_relIndex_mul_card {G : Type*} [Group G] [Finite G] {K L : Subgroup G}
    (h : K ≤ L) : Nat.card ↥L = K.relIndex L * Nat.card ↥K := by
  have hpos : 0 < L.index := index_pos L
  have h1 : K.relIndex L * L.index = K.index := Subgroup.relIndex_mul_index h
  have h2 : K.index * Nat.card ↥K = Nat.card G := Subgroup.index_mul_card K
  have h3 : L.index * Nat.card ↥L = Nat.card G := Subgroup.index_mul_card L
  have h4 : Nat.card ↥L * L.index = (K.relIndex L * Nat.card ↥K) * L.index := by
    rw [mul_comm (Nat.card ↥L) L.index, h3, ← h2, ← h1]
    ring
  exact Nat.mul_right_cancel hpos h4

/-- A subgroup strictly containing a subgroup of prime index `p` is the whole group. -/
theorem eq_top_of_index_eq_prime {G : Type*} [Group G] {p : ℕ} (hp : p.Prime) {H K : Subgroup G}
    (hHK : H ≤ K) (hH : H.index = p) (hne : K ≠ H) : K = ⊤ := by
  have hidx : K.index ∣ p := by rw [← hH]; exact Subgroup.index_dvd_of_le hHK
  rcases hp.eq_one_or_self_of_dvd _ hidx with h1 | h1
  · rw [Subgroup.index_eq_one] at h1; exact h1
  · exfalso
    have hrel : H.relIndex K = 1 := by
      have h := Subgroup.relIndex_mul_index hHK
      rw [h1, hH] at h
      exact Nat.mul_right_cancel hp.pos (h.trans (one_mul p).symm)
    exact hne (le_antisymm (Subgroup.relIndex_eq_one.mp hrel) hHK)


/-- Transport of commutativity across an equality of subgroups. -/
theorem isMulCommutative_of_subgroup_eq_top {G : Type*} [Group G] {H : Subgroup G}
    (h : H = ⊤) (hc : IsMulCommutative ↥H) : IsMulCommutative G := by
  have hc' : IsMulCommutative ↥(⊤ : Subgroup G) := h ▸ hc
  refine isMulCommutative_iff.mpr fun u v => ?_
  have h2 := isMulCommutative_iff.mp hc' (⟨u, trivial⟩ : ↥(⊤ : Subgroup G))
    (⟨v, trivial⟩ : ↥(⊤ : Subgroup G))
  exact congrArg Subtype.val h2

/-- **The structure of a nonabelian `p`-group with a cyclic subgroup of index `p`.** -/
theorem structure_of_cyclic_index_p {P : Type*} [Group P] [Finite P] {p : ℕ} (hp : p.Prime)
    (hodd : p ≠ 2) (hP : IsPGroup p P) (hnab : ¬ IsMulCommutative P) (H : Subgroup P)
    (hH : ∃ a : P, H = Subgroup.zpowers a) (hindex : H.index = p) :
    ∃ a : P, H = Subgroup.zpowers a ∧
      (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) ≤ Subgroup.center P ∧
      Nat.card ↥(⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) = p ∧
      (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) = Subgroup.zpowers (a ^ (Nat.card H / p)) ∧
      Subgroup.center P = Subgroup.zpowers (a ^ p) ∧
      (∀ i : ℕ, 1 ≤ i → p ^ i ≤ Nat.card H / p →
        IsMulCommutative (Work.PGroup.omega p i (⊤ : Subgroup P)) ∧
        ¬ IsCyclic ↥(Work.PGroup.omega p i (⊤ : Subgroup P)) ∧
        Nat.card ↥(Work.PGroup.omega p i (⊤ : Subgroup P)) = p ^ (i + 1)) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨a, rfl⟩ := hH
  -- numerical setup
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card).mp hP
  have hp1 : 1 ≤ n := by
    have hdvd : p ∣ p ^ n := by
      rw [← hn]; exact hindex ▸ Subgroup.index_dvd_card _
    by_contra h
    have hn0 : n = 0 := by omega
    rw [hn0, pow_zero] at hdvd
    exact hp.ne_one (Nat.dvd_one.mp hdvd)
  have hn2 : 2 ≤ n := by
    by_contra h
    have hn1' : n = 1 := by omega
    have hcardP : Nat.card P = p := by rw [hn, hn1', pow_one]
    haveI : IsCyclic P := isCyclic_of_prime_card hcardP
    exact hnab IsCyclic.isMulCommutative
  set m := n - 1 with hm_def
  have hm1 : 1 ≤ m := by omega
  have hminfac : (Nat.card P).minFac = p := by
    rw [hn, Nat.pow_minFac (by omega), hp.minFac_eq]
  haveI hNorm : (Subgroup.zpowers a).Normal :=
    Subgroup.normal_of_index_eq_minFac_card (by rw [hindex, hminfac])
  have hcardH : Nat.card ↥(Subgroup.zpowers a) = p ^ m := by
    have h : Nat.card ↥(Subgroup.zpowers a) * p = p ^ m * p := by
      conv_lhs => rw [← hindex]
      rw [Subgroup.card_mul_index, hn]
      conv_rhs => rw [← pow_succ, hm_def, Nat.sub_add_cancel hp1]
    exact Nat.mul_right_cancel hp.pos h
  have hcardHdiv : Nat.card ↥(Subgroup.zpowers a) / p = p ^ (m - 1) := by
    rw [hcardH]
    simpa using Nat.pow_div (x := p) (m := m) (n := 1) hm1 hp.pos
  have horder : orderOf a = p ^ m := by rw [← Nat.card_zpowers]; exact hcardH
  have ha_ne : a ≠ 1 := by
    intro h
    rw [h, orderOf_one] at horder
    have h2 : 1 < p ^ m := Nat.one_lt_pow (by omega) hp.one_lt
    omega
  -- `b ∉ ⟨a⟩`, `P = ⟨a⟩ · ⟨b⟩`
  obtain ⟨b, hbH⟩ : ∃ b : P, b ∉ Subgroup.zpowers a := by
    by_contra h
    push_neg at h
    have htop : Subgroup.zpowers a = ⊤ := (Subgroup.eq_top_iff' _).mpr h
    have h1 : p = 1 := by rw [← hindex, htop, Subgroup.index_top]
    exact hp.ne_one h1
  have hsup : Subgroup.zpowers a ⊔ Subgroup.zpowers b = ⊤ :=
    eq_top_of_index_eq_prime hp le_sup_left hindex (by
      intro h
      exact hbH (h ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers b)))
  have hcl : Subgroup.closure ({a, b} : Set P) = ⊤ := by
    rw [closure_pair_eq_zpowers_sup, hsup]
  -- a subgroup is central if it commutes with the two generators
  have central_of_commutes : ∀ z : P, a * z = z * a → b * z = z * b → z ∈ Subgroup.center P := by
    intro z ha hb
    rw [Subgroup.mem_center_iff]
    intro g
    have hcen : Subgroup.closure ({a, b} : Set P) ≤ Subgroup.centralizer ({z} : Set P) := by
      rw [Subgroup.closure_le]
      rintro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hxa | hxb
      · rw [hxa]
        exact Subgroup.mem_centralizer_iff.mpr (by
          intro y hy
          rw [Set.mem_singleton_iff] at hy; rw [hy]; exact ha.symm)
      · rw [hxb]
        exact Subgroup.mem_centralizer_iff.mpr (by
          intro y hy
          rw [Set.mem_singleton_iff] at hy; rw [hy]; exact hb.symm)
    have hg : g ∈ Subgroup.closure ({a, b} : Set P) := by rw [hcl]; trivial
    exact (Subgroup.mem_centralizer_iff.mp (hcen hg) z (Set.mem_singleton z)).symm
  -- the conjugation exponent `κ`
  have hconj : b * a * b⁻¹ ∈ Subgroup.zpowers a :=
    hNorm.conj_mem a (Subgroup.mem_zpowers a) b
  obtain ⟨κ, hκ⟩ : ∃ κ : ℕ, a ^ κ = b * a * b⁻¹ :=
    (Submonoid.mem_powers_iff (b * a * b⁻¹) a).mp ((mem_powers_iff_mem_zpowers).mpr hconj)
  have hκ_ne0 : κ ≠ 0 := by
    intro h
    have h1 : b * a * b⁻¹ = 1 := by rw [← hκ, h, pow_zero]
    refine ha_ne ?_
    calc a = b⁻¹ * (b * a * b⁻¹) * b := by group
      _ = 1 := by rw [h1]; group
  have hκ1 : 1 ≤ κ := by omega
  have hκ_ne_one : ¬ p ^ m ∣ κ - 1 := by
    intro hdvd
    have h1 : a ^ (κ - 1) = 1 := by
      rw [← orderOf_dvd_iff_pow_eq_one, horder]; exact hdvd
    have h2 : a ^ κ = a := by
      rw [show κ = κ - 1 + 1 by omega, pow_succ, h1, one_mul]
    have hba : a * b = b * a := by
      have h3 : b * a * b⁻¹ = a := by rw [← hκ, h2]
      calc a * b = (b * a * b⁻¹) * b := by rw [h3]
        _ = b * a := by group
    exact hnab (isMulCommutative_of_commute_of_closure_pair_eq_top hba hcl)
  -- `b ^ p ∈ ⟨a⟩` and the exponent `s`
  have hbp_mem : b ^ p ∈ Subgroup.zpowers a := by
    have h1 : (QuotientGroup.mk' (Subgroup.zpowers a)) (b ^ p) = 1 := by
      rw [map_pow]
      have h2 := pow_card_eq_one' (x := (QuotientGroup.mk' (Subgroup.zpowers a)) b)
      have h3 : Nat.card (P ⧸ Subgroup.zpowers a) = p := by
        rw [← Subgroup.index_eq_card]; exact hindex
      rwa [h3] at h2
    have h4 : ((b ^ p : P) : P ⧸ Subgroup.zpowers a) = 1 := by
      rw [← QuotientGroup.mk'_apply]; exact h1
    rwa [QuotientGroup.eq_one_iff] at h4
  obtain ⟨s, hs⟩ : ∃ s : ℕ, a ^ s = b ^ p :=
    (Submonoid.mem_powers_iff (b ^ p) a).mp ((mem_powers_iff_mem_zpowers).mpr hbp_mem)
  have hsdvd : p ∣ s := by
    by_contra hs'
    have h1 : orderOf (b ^ p) = p ^ m := by
      rw [← hs]; exact orderOf_pow_eq_of_not_dvd hp horder hs'
    have hle : Subgroup.zpowers (b ^ p) ≤ Subgroup.zpowers a := Subgroup.zpowers_le.mpr hbp_mem
    have hcard : Nat.card ↥(Subgroup.zpowers (b ^ p)) = p ^ m := by
      rw [Nat.card_zpowers]; exact h1
    have heq : Subgroup.zpowers (b ^ p) = Subgroup.zpowers a :=
      Subgroup.eq_of_le_of_card_ge hle (by rw [hcard, hcardH])
    have ha_mem : a ∈ Subgroup.zpowers b := by
      have h2 : a ∈ Subgroup.zpowers (b ^ p) := by rw [heq]; exact Subgroup.mem_zpowers a
      have hle2 : Subgroup.zpowers (b ^ p) ≤ Subgroup.zpowers b :=
        Subgroup.zpowers_le.mpr (Subgroup.npow_mem_zpowers b p)
      exact hle2 h2
    have htopb : Subgroup.zpowers b = (⊤ : Subgroup P) := by
      rw [← hsup]
      exact le_antisymm le_sup_right (sup_le (Subgroup.zpowers_le.mpr ha_mem) le_rfl)
    have htopb' : ∀ x : P, x ∈ Subgroup.zpowers b := fun x => by rw [htopb]; trivial
    haveI : IsCyclic P := isCyclic_of_orderOf_eq_card b
      (orderOf_eq_card_of_forall_mem_zpowers htopb')
    exact hnab IsCyclic.isMulCommutative
  -- `p ^ m ∣ κ ^ p - 1`
  have hbp_comm_a : b ^ p * a = a * b ^ p := by
    have hle : Subgroup.zpowers a ≤ Subgroup.centralizer ({a} : Set P) :=
      Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_iff.mpr (by
        intro y hy
        rw [Set.mem_singleton_iff] at hy; rw [hy]))
    exact (Subgroup.mem_centralizer_iff.mp (hle hbp_mem) a (Set.mem_singleton a)).symm
  have haκp : a ^ (κ ^ p) = a := by
    rw [← pow_conj_eq hκ.symm p]
    rw [hbp_comm_a]; group
  have hpow_κ : p ^ m ∣ κ ^ p - 1 := by
    have h1 : a ^ (κ ^ p - 1) = 1 := by
      have h2 : a ^ (κ ^ p - 1) * a = a := by
        rw [← pow_succ, Nat.sub_add_cancel (Nat.one_le_pow p κ hκ1), haκp]
      exact mul_right_cancel (h2.trans (one_mul a).symm)
    rw [← horder, orderOf_dvd_iff_pow_eq_one]; exact h1
  -- `p ^ (m-1) ∣ κ - 1`, `p ∣ κ - 1`, and `2 ≤ m`
  have hκ_dvd : p ^ (m - 1) ∣ κ - 1 := dvd_sub_one_of_pow_eq_one hp hodd hpow_κ hκ_ne_one
  have hp_dvd_κp1 : p ∣ κ ^ p - 1 := by
    have h1 : p ^ 1 ∣ p ^ m := pow_dvd_pow p hm1
    rw [pow_one] at h1
    exact dvd_trans h1 hpow_κ
  have hm2 : 2 ≤ m := by
    by_contra h
    have hm1' : m = 1 := by omega
    exact hκ_ne_one (by rw [hm1', pow_one]; exact dvd_sub_one_of_dvd_pow_sub_one hp hp_dvd_κp1)
  have hp_dvd : p ∣ κ - 1 := by
    have h1 : p ^ 1 ∣ p ^ (m - 1) := pow_dvd_pow p (by omega)
    simpa using dvd_trans h1 hκ_dvd
  have hκ' : κ = κ - 1 + 1 := by omega
  -- ### `K = ⟨a ^ (p^(m-1))⟩` : order `p`, central
  have hK_order : orderOf (a ^ p ^ (m - 1)) = p := by
    have h1 : (a ^ p ^ (m - 1)) ^ p = 1 := by
      rw [← pow_mul]
      have h2 : p ^ (m - 1) * p = p ^ m := by rw [← pow_succ, Nat.sub_add_cancel hm1]
      rw [h2, ← horder]
      exact pow_orderOf_eq_one a
    have h2 : a ^ p ^ (m - 1) ≠ 1 := by
      intro h
      rw [← orderOf_dvd_iff_pow_eq_one, horder] at h
      exact absurd ((Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp h) (by omega)
    have h3 : orderOf (a ^ p ^ (m - 1)) ∣ p := orderOf_dvd_iff_pow_eq_one.mpr h1
    rcases hp.eq_one_or_self_of_dvd _ h3 with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) h2
    · exact h
  have hKcard : Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - 1))) = p := by
    rw [Nat.card_zpowers]; exact hK_order
  have hKZ : Subgroup.zpowers (a ^ p ^ (m - 1)) ≤ Subgroup.center P := by
    refine Subgroup.zpowers_le.mpr (central_of_commutes _ ?_ ?_)
    · exact ((Commute.refl a).pow_left (p ^ (m - 1))).symm
    · have h1 : b * a ^ p ^ (m - 1) * b⁻¹ = a ^ (κ * p ^ (m - 1)) := by
        rw [conj_mul_pow, ← hκ, pow_mul]
      have h3 : a ^ (p ^ (m - 1) * (κ - 1)) = 1 := by
        rw [← orderOf_dvd_iff_pow_eq_one, horder]
        obtain ⟨t, ht⟩ := hκ_dvd
        rw [ht, ← mul_assoc]
        have h4 : p ^ m ∣ p ^ (m - 1) * p ^ (m - 1) := by
          rw [← pow_add]
          exact pow_dvd_pow p (by omega)
        exact h4.mul_right t
      have h2 : a ^ (κ * p ^ (m - 1)) = a ^ p ^ (m - 1) := by
        rw [hκ', add_mul, one_mul, mul_comm (κ - 1) (p ^ (m - 1)), pow_add, h3, one_mul]
      calc b * (a ^ p ^ (m - 1)) = (b * (a ^ p ^ (m - 1)) * b⁻¹) * b := by group
        _ = a ^ (κ * p ^ (m - 1)) * b := by rw [h1]
        _ = a ^ p ^ (m - 1) * b := by rw [h2]
  -- ### `[P, P] = ⟨a ^ (p^(m-1))⟩`
  have hcomm_a : b * a * b⁻¹ * a⁻¹ = a ^ (κ - 1) := by
    rw [← hκ]
    show a ^ κ * a⁻¹ = a ^ (κ - 1)
    conv_lhs => rw [hκ', pow_succ]
    group
  have haκ1_pow : (a ^ (κ - 1)) ^ p = 1 := by
    rw [← pow_mul, ← orderOf_dvd_iff_pow_eq_one, horder]
    rw [show p ^ m = p ^ (m - 1) * p from by rw [← pow_succ, Nat.sub_add_cancel hm1]]
    exact mul_dvd_mul_right hκ_dvd p
  have haκ1_ne : a ^ (κ - 1) ≠ 1 := by
    intro h
    rw [← orderOf_dvd_iff_pow_eq_one, horder] at h
    exact hκ_ne_one h
  have haκ1_order : orderOf (a ^ (κ - 1)) = p := by
    have h6 : orderOf (a ^ (κ - 1)) ∣ p := orderOf_dvd_iff_pow_eq_one.mpr haκ1_pow
    rcases hp.eq_one_or_self_of_dvd _ h6 with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) haκ1_ne
    · exact h
  have haκ1_mem : a ^ (κ - 1) ∈ Subgroup.zpowers (a ^ p ^ (m - 1)) := by
    rw [zpowers_pow_eq_closure hp horder hm1]
    exact Subgroup.subset_closure ⟨Subgroup.npow_mem_zpowers a (κ - 1),
      by rw [pow_one]; exact haκ1_pow⟩
  have haκ1_eq : Subgroup.zpowers (a ^ (κ - 1)) = Subgroup.zpowers (a ^ p ^ (m - 1)) := by
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr haκ1_mem) ?_
    rw [Nat.card_zpowers, Nat.card_zpowers, haκ1_order, hK_order]
  have hKleC : Subgroup.zpowers (a ^ p ^ (m - 1)) ≤ (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) := by
    rw [← haκ1_eq]
    refine Subgroup.zpowers_le.mpr ?_
    rw [← hcomm_a]
    exact Subgroup.commutator_mem_commutator trivial trivial
  have hCleK : (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) ≤ Subgroup.zpowers (a ^ p ^ (m - 1)) := by
    haveI : (Subgroup.zpowers (a ^ p ^ (m - 1))).Normal := Subgroup.normal_of_le_center hKZ
    let q : P →* (P ⧸ Subgroup.zpowers (a ^ p ^ (m - 1))) := QuotientGroup.mk' _
    have hqa : q a ^ (κ - 1) = 1 := by
      have h : q (a ^ (κ - 1)) = 1 := by
        rw [QuotientGroup.mk'_apply]
        exact (QuotientGroup.eq_one_iff _).mpr haκ1_mem
      rwa [map_pow] at h
    have hqak : q a ^ κ = q a := by
      rw [show κ = κ - 1 + 1 by omega, pow_succ, hqa, one_mul]
    have hqconj : q b * q a * (q b)⁻¹ = q a := by
      have h1 : q b * q a * (q b)⁻¹ = q (b * a * b⁻¹) := by
        rw [map_mul, map_mul, map_inv, mul_assoc]
      rw [h1, ← hκ, map_pow, hqak]
    have hcomm : q a * q b = q b * q a := by
      have h2 : q b * q a = q a * q b := by
        calc q b * q a = (q b * q a * (q b)⁻¹) * q b := by
              rw [mul_assoc, inv_mul_cancel, mul_one]
          _ = q a * q b := by rw [hqconj]
      exact h2.symm
    have hclq : Subgroup.closure ({q a, q b} : Set (P ⧸ Subgroup.zpowers (a ^ p ^ (m - 1)))) = ⊤ := by
      have h1 : Subgroup.map q ⊤ = ⊤ :=
        Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective _)
      rw [← h1, ← hcl, MonoidHom.map_closure, Set.image_pair]
    have haux : IsMulCommutative (P ⧸ Subgroup.zpowers (a ^ p ^ (m - 1))) :=
      isMulCommutative_of_commute_of_closure_pair_eq_top hcomm hclq
    exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp haux
  have hPP_eq : (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) = Subgroup.zpowers (a ^ p ^ (m - 1)) :=
    le_antisymm hCleK hKleC
  have hPP_le_Z : (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) ≤ Subgroup.center P := hPP_eq ▸ hKZ
  have hPPcard : Nat.card ↥(⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) = p := hPP_eq ▸ hKcard
  -- ### `Z(P) = ⟨a ^ p⟩`
  have hapZ : a ^ p ∈ Subgroup.center P := by
    refine central_of_commutes _ ?_ ?_
    · exact ((Commute.refl a).pow_left p).symm
    · have h1 : b * a ^ p * b⁻¹ = a ^ (κ * p) := by
        rw [conj_mul_pow, ← hκ, pow_mul]
      have h3 : a ^ (p * (κ - 1)) = 1 := by
        rw [← orderOf_dvd_iff_pow_eq_one, horder]
        obtain ⟨t, ht⟩ := hκ_dvd
        rw [ht, show p * (p ^ (m - 1) * t) = p ^ m * t from by
          rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hm1]]
        exact dvd_mul_right _ _
      have h2 : a ^ (κ * p) = a ^ p := by
        rw [hκ', add_mul, one_mul, mul_comm (κ - 1) p, pow_add, h3, one_mul]
      calc b * (a ^ p) = (b * a ^ p * b⁻¹) * b := by group
        _ = a ^ (κ * p) * b := by rw [h1]
        _ = a ^ p * b := by rw [h2]
  have hcenter_le : Subgroup.center P ≤ Subgroup.zpowers (a ^ p) := by
    intro z hz
    have hza : a * z = z * a := Subgroup.mem_center_iff.mp hz a
    have hLcomm : IsMulCommutative ↥(Subgroup.zpowers a ⊔ Subgroup.zpowers z) :=
      isMulCommutative_of_commute_zpowers_sup hza
    have hne : Subgroup.zpowers a ⊔ Subgroup.zpowers z ≠ ⊤ := by
      intro hLtop
      exact hnab (isMulCommutative_of_subgroup_eq_top hLtop hLcomm)
    have hidx : (Subgroup.zpowers a ⊔ Subgroup.zpowers z).index ∣ p := by
      rw [← hindex]; exact Subgroup.index_dvd_of_le le_sup_left
    have hLeq : Subgroup.zpowers a ⊔ Subgroup.zpowers z = Subgroup.zpowers a := by
      rcases hp.eq_one_or_self_of_dvd _ hidx with h1 | h1
      · exfalso
        exact hne (Subgroup.index_eq_one.mp h1)
      · have hrel : (Subgroup.zpowers a).relIndex (Subgroup.zpowers a ⊔ Subgroup.zpowers z) = 1 := by
          have h := Subgroup.relIndex_mul_index (H := Subgroup.zpowers a)
            (K := Subgroup.zpowers a ⊔ Subgroup.zpowers z) le_sup_left
          rw [h1, hindex] at h
          exact Nat.mul_right_cancel hp.pos (h.trans (one_mul p).symm)
        exact le_antisymm (Subgroup.relIndex_eq_one.mp hrel) le_sup_left
    have hzH : z ∈ Subgroup.zpowers a := hLeq ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers z)
    obtain ⟨t, ht⟩ : ∃ t : ℕ, a ^ t = z :=
      (Submonoid.mem_powers_iff z a).mp ((mem_powers_iff_mem_zpowers).mpr hzH)
    have htκ : p ^ m ∣ t * (κ - 1) := by
      have h1 : a ^ (t * (κ - 1)) * a ^ t = a ^ t := by
        rw [← pow_add]
        have h2 : t * (κ - 1) + t = t * κ := by
          conv_rhs => rw [show κ = κ - 1 + 1 by omega, mul_add, mul_one]
        rw [h2, Nat.mul_comm t κ, pow_mul, hκ, ← conj_mul_pow, ht,
          Subgroup.mem_center_iff.mp hz b, mul_assoc, mul_inv_cancel, mul_one]
      have h2 : a ^ (t * (κ - 1)) = 1 :=
        mul_right_cancel (h1.trans (one_mul (a ^ t)).symm)
      rw [← horder]
      exact orderOf_dvd_iff_pow_eq_one.mpr h2
    have hpt : p ∣ t := dvd_of_dvd_mul_of_pow_dvd hp hm1 hκ_dvd hκ_ne_one htκ
    obtain ⟨u, hu⟩ := hpt
    refine (Subgroup.mem_zpowers_iff).mpr ⟨(u : ℤ), ?_⟩
    rw [zpow_natCast, ← pow_mul, ← hu, ht]
  have hcenter_eq : Subgroup.center P = Subgroup.zpowers (a ^ p) :=
    le_antisymm hcenter_le (Subgroup.zpowers_le.mpr hapZ)
  -- ### `Ω₁(P)` and an element of order `p` outside `⟨a⟩`
  have hcommp : ∀ x y : P, ⁅x, y⁆ ^ p = 1 := by
    intro x y
    have hmem : ⁅x, y⁆ ∈ Subgroup.zpowers (a ^ p ^ (m - 1)) := by
      rw [← hPP_eq]
      exact Subgroup.commutator_mem_commutator (H₁ := (⊤ : Subgroup P)) (H₂ := ⊤) trivial trivial
    have h := Subgroup.orderOf_dvd_natCard (Subgroup.zpowers (a ^ p ^ (m - 1))) hmem
    rw [hKcard] at h
    exact orderOf_dvd_iff_pow_eq_one.mp h
  have hpowmul : ∀ x y : P, (x * y) ^ p = x ^ p * y ^ p :=
    pow_mul_eq_of_class_two hp hodd hPP_le_Z hcommp
  let φ : P →* P :=
    { toFun := fun x => x ^ p, map_one' := one_pow p, map_mul' := hpowmul }
  have hφapply : ∀ x : P, φ x = x ^ p := fun x => rfl
  have homega1_eq : Work.PGroup.omega p 1 (⊤ : Subgroup P) = φ.ker := by
    refine le_antisymm ?_ ?_
    · rw [Work.PGroup.omega, Subgroup.closure_le]
      rintro x ⟨-, hx⟩
      refine MonoidHom.mem_ker.mpr ?_
      show x ^ p = 1
      simpa using hx
    · intro x hx
      have hx' : x ^ p = 1 := by
        have := MonoidHom.mem_ker.mp hx
        rwa [hφapply] at this
      exact Subgroup.subset_closure ⟨trivial, by simpa using hx'⟩
  have horderap : orderOf (a ^ p) = p ^ (m - 1) := by
    rw [orderOf_pow, horder, Nat.gcd_eq_right (dvd_pow_self p (by omega : m ≠ 0))]
    simpa using Nat.pow_div (x := p) (m := m) (n := 1) hm1 hp.pos
  have hrange : φ.range = Subgroup.zpowers (a ^ p) := by
    rw [MonoidHom.range_eq_map, ← hcl, MonoidHom.map_closure]
    have himg : φ '' ({a, b} : Set P) = ({a ^ p, b ^ p} : Set P) := by
      rw [Set.image_pair]
      simp only [hφapply]
    rw [himg, closure_pair_eq_zpowers_sup, sup_eq_left.mpr]
    rw [Subgroup.zpowers_le]
    obtain ⟨u, hu⟩ := hsdvd
    rw [← hs, hu, pow_mul]
    exact Subgroup.npow_mem_zpowers (a ^ p) u
  have homega1_card : Nat.card ↥(Work.PGroup.omega p 1 (⊤ : Subgroup P)) = p ^ 2 := by
    rw [homega1_eq]
    have h := Subgroup.index_mul_card φ.ker
    rw [Subgroup.index_ker φ, hrange, Nat.card_zpowers, horderap, hn] at h
    have h2 : p ^ (m - 1) * Nat.card ↥φ.ker = p ^ (m - 1) * p ^ 2 := by
      rw [h, ← pow_add, show m - 1 + 2 = n by omega]
    exact Nat.eq_of_mul_eq_mul_left (pow_pos hp.pos _) h2
  have homega1_inf : Work.PGroup.omega p 1 (⊤ : Subgroup P) ⊓ Subgroup.zpowers a =
      Subgroup.zpowers (a ^ p ^ (m - 1)) := by
    rw [homega1_eq, zpowers_pow_eq_closure hp horder hm1]
    refine le_antisymm ?_ ?_
    · intro x hx
      obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.mp hx
      have hx1' : x ^ p = 1 := by
        have := MonoidHom.mem_ker.mp hx1
        rwa [hφapply] at this
      exact Subgroup.subset_closure ⟨hx2, by rw [pow_one]; exact hx1'⟩
    · intro x hx
      have hle : Subgroup.closure {g : P | g ∈ Subgroup.zpowers a ∧ g ^ p ^ 1 = 1} ≤ φ.ker := by
        rw [Subgroup.closure_le]
        rintro g ⟨-, hg⟩
        refine MonoidHom.mem_ker.mpr ?_
        show g ^ p = 1
        simpa using hg
      have hle2 : Subgroup.closure {g : P | g ∈ Subgroup.zpowers a ∧ g ^ p ^ 1 = 1} ≤
          Subgroup.zpowers a := by
        rw [Subgroup.closure_le]
        rintro g ⟨hg, -⟩
        exact hg
      exact Subgroup.mem_inf.mpr ⟨hle hx, hle2 hx⟩
  obtain ⟨c, hcω, hcnot⟩ : ∃ c : P, c ∈ Work.PGroup.omega p 1 (⊤ : Subgroup P) ∧
      c ∉ Subgroup.zpowers (a ^ p ^ (m - 1)) := by
    by_contra h
    push_neg at h
    have hsub : Work.PGroup.omega p 1 (⊤ : Subgroup P) ≤ Subgroup.zpowers (a ^ p ^ (m - 1)) :=
      fun x hx => h x hx
    have hdvd : Nat.card ↥(Work.PGroup.omega p 1 (⊤ : Subgroup P)) ∣ p := by
      have h := Subgroup.card_dvd_of_le (H := Work.PGroup.omega p 1 (⊤ : Subgroup P))
        (K := Subgroup.zpowers (a ^ p ^ (m - 1))) hsub
      rwa [hKcard] at h
    rw [homega1_card] at hdvd
    have hdvd' : p ^ 2 ∣ p ^ 1 := by simpa using hdvd
    exact (by omega : ¬ (2 ≤ 1)) ((Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd')
  have hc_notH : c ∉ Subgroup.zpowers a := fun h =>
    hcnot (homega1_inf ▸ Subgroup.mem_inf.mpr ⟨hcω, h⟩)
  refine ⟨a, rfl, hPP_le_Z, hPPcard, ?_, hcenter_eq, ?_⟩
  · rw [hcardHdiv]
    exact hPP_eq
  · intro i hi hip
    have him : i ≤ m - 1 := by
      rw [hcardHdiv] at hip
      exact (Nat.pow_le_pow_iff_right hp.one_lt).mp hip
    -- every element of `P` commutes with `a ^ (p^(m-i))`
    have hcomm_pow : ∀ y : P, y * a ^ p ^ (m - i) * y⁻¹ = a ^ p ^ (m - i) := by
      intro y
      have hy : y ∈ Subgroup.zpowers a ⊔ Subgroup.zpowers b := by rw [hsup]; trivial
      obtain ⟨h, hh, k, hk, hyk⟩ := (Subgroup.mem_sup_of_normal_left (s := Subgroup.zpowers a)
        (t := Subgroup.zpowers b)).mp hy
      obtain ⟨j, -, hjk⟩ :=
        Finset.mem_image.mp ((mem_zpowers_iff_mem_range_orderOf).mp hk)
      rw [← hyk, ← hjk]
      have h1 : b ^ j * a ^ p ^ (m - i) * (b ^ j)⁻¹ = a ^ (κ ^ j * p ^ (m - i)) := by
        rw [conj_mul_pow, pow_conj_eq hκ.symm j, ← pow_mul]
      have hdiv : p ^ m ∣ p ^ (m - i) * (κ ^ j - 1) := by
        have hj1 : p ^ (m - 1) ∣ κ ^ j - 1 := by
          have hmod : (1 : ℕ) ≡ κ [MOD p ^ (m - 1)] := (Nat.modEq_iff_dvd' hκ1).mpr hκ_dvd
          have h2 : (1 : ℕ) ≡ κ ^ j [MOD p ^ (m - 1)] := by simpa using hmod.pow j
          exact (Nat.modEq_iff_dvd' (Nat.one_le_pow j κ hκ1)).mp h2
        have h2 : p ^ (m - i) * p ^ (m - 1) ∣ p ^ (m - i) * (κ ^ j - 1) :=
          mul_dvd_mul_left _ hj1
        have h3 : p ^ m ∣ p ^ (m - i) * p ^ (m - 1) := by
          rw [← pow_add]
          exact pow_dvd_pow p (by omega)
        exact dvd_trans h3 h2
      have h2 : b ^ j * a ^ p ^ (m - i) * (b ^ j)⁻¹ = a ^ p ^ (m - i) := by
        rw [h1]
        have hκj1 : 1 ≤ κ ^ j := Nat.one_le_pow j κ hκ1
        have hexp : κ ^ j * p ^ (m - i) = p ^ (m - i) * (κ ^ j - 1) + p ^ (m - i) := by
          conv_lhs => rw [show κ ^ j = κ ^ j - 1 + 1 from by omega, add_mul, one_mul,
            mul_comm (κ ^ j - 1)]
        rw [hexp, pow_add,
          show a ^ (p ^ (m - i) * (κ ^ j - 1)) = 1 from by
            rw [← orderOf_dvd_iff_pow_eq_one, horder]; exact hdiv,
          one_mul]
      have hh_comm : h * a ^ p ^ (m - i) = a ^ p ^ (m - i) * h := by
        have hle : Subgroup.zpowers a ≤ Subgroup.centralizer ({a ^ p ^ (m - i)} : Set P) :=
          Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_iff.mpr (by
            intro z hz
            rw [Set.mem_singleton_iff] at hz; rw [hz]
            exact (Commute.refl a).pow_left (p ^ (m - i))))
        exact (Subgroup.mem_centralizer_iff.mp (hle hh) (a ^ p ^ (m - i))
          (Set.mem_singleton _)).symm
      calc h * b ^ j * a ^ p ^ (m - i) * (h * b ^ j)⁻¹
          = h * (b ^ j * a ^ p ^ (m - i) * (b ^ j)⁻¹) * h⁻¹ := by group
        _ = h * a ^ p ^ (m - i) * h⁻¹ := by rw [h2]
        _ = a ^ p ^ (m - i) := by rw [hh_comm]; group
    -- `Ωᵢ(P)` is the set of elements whose `p^i`-th power is trivial
    let S : Subgroup P :=
      { carrier := {x : P | x ^ p ^ i = 1}
        mul_mem' := fun {x y} hx hy =>
          mul_pow_eq_one_of_pow_eq_one hp hodd hi hPP_le_Z hPPcard
            (fun u v => Subgroup.commutator_mem_commutator (H₁ := (⊤ : Subgroup P))
              (H₂ := ⊤) trivial trivial) hx hy
        one_mem' := by simp
        inv_mem' := fun {x} hx => by
          show (x⁻¹) ^ p ^ i = 1
          rw [inv_pow, hx, inv_one] }
    have hSeq : Work.PGroup.omega p i (⊤ : Subgroup P) = S := by
      refine le_antisymm ?_ ?_
      · rw [Work.PGroup.omega, Subgroup.closure_le]
        rintro x ⟨-, hx⟩
        exact hx
      · intro x hx
        exact Subgroup.subset_closure ⟨trivial, hx⟩
    have homega_mono : Work.PGroup.omega p 1 (⊤ : Subgroup P) ≤
        Work.PGroup.omega p i (⊤ : Subgroup P) := by
      rw [homega1_eq, hSeq]
      intro x hx
      have hx' : x ^ p = 1 := by
        have := MonoidHom.mem_ker.mp hx
        rwa [hφapply] at this
      show x ^ p ^ i = 1
      have hpip : p ^ i = p * p ^ (i - 1) := by rw [← pow_succ', Nat.sub_add_cancel hi]
      rw [hpip, pow_mul, hx', one_pow]
    have hc_omega : c ∈ Work.PGroup.omega p i (⊤ : Subgroup P) := homega_mono hcω
    have homega_inf : Work.PGroup.omega p i (⊤ : Subgroup P) ⊓ Subgroup.zpowers a =
        Subgroup.zpowers (a ^ p ^ (m - i)) := by
      refine le_antisymm ?_ ?_
      · intro x hx
        obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.mp hx
        rw [hSeq] at hx1
        rw [zpowers_pow_eq_closure hp horder (by omega : i ≤ m)]
        exact Subgroup.subset_closure ⟨hx2, hx1⟩
      · intro x hx
        rw [zpowers_pow_eq_closure hp horder (by omega : i ≤ m)] at hx
        have hle : Subgroup.closure {g : P | g ∈ Subgroup.zpowers a ∧ g ^ p ^ i = 1} ≤
            S ⊓ Subgroup.zpowers a := by
          rw [Subgroup.closure_le]
          rintro g ⟨hg1, hg2⟩
          exact Subgroup.mem_inf.mpr ⟨hg2, hg1⟩
        exact Subgroup.mem_inf.mpr ⟨by rw [hSeq]; exact (Subgroup.mem_inf.mp (hle hx)).1,
          (Subgroup.mem_inf.mp (hle hx)).2⟩
    have hsup_i : Work.PGroup.omega p i (⊤ : Subgroup P) ⊔ Subgroup.zpowers a = ⊤ :=
      eq_top_of_index_eq_prime hp le_sup_right hindex (by
        intro h
        exact hc_notH (h ▸ Subgroup.mem_sup_left hc_omega))
    have hord_ai : orderOf (a ^ p ^ (m - i)) = p ^ i := by
      rw [orderOf_pow, horder, Nat.gcd_eq_right (pow_dvd_pow p (by omega : m - i ≤ m)),
        Nat.pow_div (by omega : m - i ≤ m) hp.pos, Nat.sub_sub_self (by omega : i ≤ m)]
    have hrel_omega : (Work.PGroup.omega p i (⊤ : Subgroup P) ⊓ Subgroup.zpowers a).relIndex
        (Work.PGroup.omega p i (⊤ : Subgroup P)) = p := by
      rw [Subgroup.inf_relIndex_left]
      have h := Subgroup.relIndex_sup_left (Work.PGroup.omega p i (⊤ : Subgroup P))
        (Subgroup.zpowers a)
      rw [← h, sup_comm, hsup_i, Subgroup.relIndex_top_right, hindex]
    have homega_card : Nat.card ↥(Work.PGroup.omega p i (⊤ : Subgroup P)) = p ^ (i + 1) := by
      rw [card_eq_relIndex_mul_card (K := Work.PGroup.omega p i (⊤ : Subgroup P) ⊓
          Subgroup.zpowers a) (L := Work.PGroup.omega p i (⊤ : Subgroup P)) inf_le_left,
        hrel_omega, homega_inf, Nat.card_zpowers, hord_ai, ← pow_succ']
    have hA_le : Subgroup.zpowers (a ^ p ^ (m - i)) ≤ Work.PGroup.omega p i (⊤ : Subgroup P) := by
      rw [← homega_inf]; exact inf_le_left
    have hB_le : Subgroup.zpowers c ≤ Work.PGroup.omega p i (⊤ : Subgroup P) :=
      Subgroup.zpowers_le.mpr hc_omega
    have hAB_card : Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) =
        p ^ (i + 1) := by
      have hle : Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c ≤
          Work.PGroup.omega p i (⊤ : Subgroup P) := sup_le hA_le hB_le
      have hdvd : Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) ∣
          p ^ (i + 1) := by
        rw [← homega_card]; exact Subgroup.card_dvd_of_le hle
      have hgt : p ^ i < Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) := by
        have h1 : Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i))) ∣
            Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) :=
          Subgroup.card_dvd_of_le le_sup_left
        have h2 : Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i))) = p ^ i := by
          rw [Nat.card_zpowers]; exact hord_ai
        have h3 : Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i))) ≠
            Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) := by
          intro heq
          have h4 : Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c =
              Subgroup.zpowers (a ^ p ^ (m - i)) :=
            (Subgroup.eq_of_le_of_card_ge le_sup_left (by rw [heq])).symm
          exact hc_notH ((Subgroup.zpowers_le.mpr (Subgroup.npow_mem_zpowers a _))
            (h4 ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers c)))
        have h1' : p ^ i ∣
            Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) := by
          rwa [h2] at h1
        have h3' : p ^ i ≠
            Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) := by
          rwa [h2] at h3
        have hpos : 0 < Nat.card ↥(Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c) :=
          Nat.card_pos
        exact Nat.lt_of_le_of_ne (Nat.le_of_dvd hpos h1') h3'
      obtain ⟨k, hk, hk'⟩ := (Nat.dvd_prime_pow hp).mp hdvd
      have hk2 : k = i + 1 := by
        have h4 : i < k := (Nat.pow_lt_pow_iff_right hp.one_lt).mp (by rw [← hk']; exact hgt)
        omega
      rw [hk', hk2]
    have homega_eq_AB : Work.PGroup.omega p i (⊤ : Subgroup P) =
        Subgroup.zpowers (a ^ p ^ (m - i)) ⊔ Subgroup.zpowers c :=
      (Subgroup.eq_of_le_of_card_ge (sup_le hA_le hB_le)
        (by rw [homega_card, hAB_card])).symm
    refine ⟨?_, ?_, homega_card⟩
    · rw [homega_eq_AB]
      refine isMulCommutative_of_commute_zpowers_sup ?_
      have h := hcomm_pow c
      rw [mul_inv_eq_iff_eq_mul] at h
      exact h.symm
    · intro hcyc
      haveI := hcyc
      have hexp := IsCyclic.exponent_eq_card (α := ↥(Work.PGroup.omega p i (⊤ : Subgroup P)))
      have hdvd : Monoid.exponent ↥(Work.PGroup.omega p i (⊤ : Subgroup P)) ∣ p ^ i := by
        rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
        intro x
        refine Subtype.ext ?_
        have h1 : (x : P) ∈ S := by rw [← hSeq]; exact x.2
        exact h1
      rw [hexp, homega_card] at hdvd
      exact (by omega : ¬ (i + 1 ≤ i)) ((Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd)

end

end Work.PGroup.Symplectic
