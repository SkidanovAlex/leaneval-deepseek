/-!
# The `n ≥ 3` obstruction for groups all of whose abelian characteristic subgroups are cyclic

Let `X` be a finite group in which every abelian characteristic subgroup is cyclic.  Suppose
`X = E ⊔ R` with `[E, R] = 1`, that `⟨c⟩` is a characteristic cyclic subgroup of order `p ^ n`
(`p` an odd prime, `n ≥ 3`) contained in `R`, that `y ∈ R` has order `p` and conjugates `c` to
`c ^ (1 + m * p ^ (n - 1))`, that `y` is not the element of order `p` of `⟨c⟩`, that every `p`-th
power in `E` lies in `⟨c ^ p ^ (n - 1)⟩`, and that the elements of `R` centralizing `c ^ p` are
exactly the products `c ^ i * y ^ j`.

Then we derive a contradiction, as follows.  Let `F = Ω₁(X)`, the subgroup generated by all
elements of order dividing `p` (characteristic in `X`).  Every `x ∈ X` with `x ^ p = 1` commutes
with both `y` and `c ^ (p ^ (n - 1))`: writing `x = e * r` with `e ∈ E`, `r ∈ R`, the relation
`r ^ p = (e ^ p)⁻¹ ∈ ⟨c ^ p ^ (n - 1)⟩ ⊆ ⟨c⟩` forces `r` to centralize `c ^ p` (lifting the
exponent, using `p` odd), so `r = c ^ i * y ^ j`; then `r ^ p = c ^ (i * p)` again lies in a
group of order `p`, which forces `p ^ (n - 2) ∣ i` (here `n ≥ 3` enters), and `c ^ (p ^ (n - 2))`
commutes with `y`.  Hence `y` and `c ^ (p ^ (n - 1))` — two distinct subgroups of order `p` — lie
in the centre of `F`, so `Z(F)` is cyclic by hypothesis but contains `C_p × C_p`: contradiction.

This is the endgame of Gorenstein's proof of P. Hall's theorem, Theorem 5.4.9 (Feit–Thompson
3.5), where the subgroup `R` is isomorphic to `M_{n+1}(p)`.
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.PGroup.Symplectic

open scoped commutatorElement

variable {X : Type*} [Group X]

/-- **Elements of a product of two commuting subgroups.**  If `⁅E, R⁆ = ⊥` then every element of
`E ⊔ R` is a product `e * r` with `e ∈ E` and `r ∈ R`. -/
theorem exists_mul_eq_of_mem_sup {E R : Subgroup X} (hER : ⁅E, R⁆ = ⊥) {x : X}
    (hx : x ∈ E ⊔ R) : ∃ e ∈ E, ∃ r ∈ R, e * r = x := by
  have hcomm : ∀ e ∈ E, ∀ r ∈ R, r * e = e * r := fun e he r hr =>
    (Subgroup.mem_centralizer_iff.mp (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hER he)) r hr
  let T : Subgroup X :=
    { carrier := {x : X | ∃ e ∈ E, ∃ r ∈ R, e * r = x}
      one_mem' := ⟨1, E.one_mem, 1, R.one_mem, by rw [mul_one]⟩
      mul_mem' := by
        rintro x u ⟨e₁, he₁, r₁, hr₁, rfl⟩ ⟨e₂, he₂, r₂, hr₂, rfl⟩
        exact ⟨e₁ * e₂, E.mul_mem he₁ he₂, r₁ * r₂, R.mul_mem hr₁ hr₂, by
          calc e₁ * e₂ * (r₁ * r₂) = e₁ * (e₂ * r₁) * r₂ := by group
            _ = e₁ * (r₁ * e₂) * r₂ := by rw [(hcomm e₂ he₂ r₁ hr₁).symm]
            _ = e₁ * r₁ * (e₂ * r₂) := by group⟩
      inv_mem' := by
        rintro x ⟨e, he, r, hr, rfl⟩
        exact ⟨e⁻¹, E.inv_mem he, r⁻¹, R.inv_mem hr,
          by rw [mul_inv_rev, hcomm e⁻¹ (E.inv_mem he) r⁻¹ (R.inv_mem hr)]⟩ }
  exact (sup_le (show E ≤ T from fun e he => ⟨e, he, 1, R.one_mem, by rw [mul_one]⟩)
    (show R ≤ T from fun r hr => ⟨1, E.one_mem, r, hr, by rw [one_mul]⟩)) hx

/-- **The centralizer of the `p`-th power.**  Let `c` have order `p ^ n`, `n ≥ 2`, `p` an odd
prime, `⟨c⟩` characteristic, and let `r ^ p ∈ ⟨c⟩`.  Then `r` centralizes `c ^ p`.

Writing `r⁻¹ * c * r = c ^ k` (possible since `⟨c⟩` is normal) and `r ^ p = c ^ s` (possible since
`c` has finite order), iterating the conjugation gives `c ^ (k ^ p) = c`, so `p ^ n ∣ k ^ p - 1`
and, by lifting the exponent for odd `p`, `p ^ (n - 1) ∣ k - 1`.  Hence `k * p ≡ p` modulo
`p ^ n` and `r⁻¹ * c ^ p * r = (r⁻¹ * c * r) ^ p = c ^ (k * p) = c ^ p`. -/
theorem inv_mul_pow_eq_self_of_pow_mem_zpowers {p n : ℕ} (hp : p.Prime) (hodd : p ≠ 2)
    (hn : 2 ≤ n) {c r : X} (hchar : (Subgroup.zpowers c).Characteristic)
    (hord : orderOf c = p ^ n) (hr : r ^ p ∈ Subgroup.zpowers c) :
    r⁻¹ * c ^ p * r = c ^ p := by
  have hn1 : 1 ≤ n := by omega
  have hcn : c ^ (p ^ n) = 1 := by
    have := pow_orderOf_eq_one c
    rwa [hord] at this
  have hfc : IsOfFinOrder c := isOfFinOrder_iff_pow_eq_one.mpr ⟨p ^ n, pow_pos hp.pos n, hcn⟩
  have hmem : r⁻¹ * c * r ∈ Subgroup.zpowers c := by
    have h := (Subgroup.normal_of_characteristic (Subgroup.zpowers c) : (Subgroup.zpowers c).Normal)
    simpa using h.conj_mem c (Subgroup.mem_zpowers c) r⁻¹
  obtain ⟨k, hk⟩ := exists_pow_eq_of_mem_zpowers hfc hmem
  obtain ⟨s, hs⟩ := exists_pow_eq_of_mem_zpowers hfc hr
  have hkpos : 1 ≤ k := by
    rcases Nat.eq_zero_or_pos k with h0 | h
    · exfalso
      rw [h0, pow_zero] at hk
      have hc1 : c = 1 := by
        have : r * (r⁻¹ * c * r) * r⁻¹ = c := by group
        rw [← hk] at this
        simpa using this.symm
      have h1 : orderOf c = 1 := by rw [hc1, orderOf_one]
      rw [hord] at h1
      have := Nat.one_lt_pow (by omega : n ≠ 0) hp.one_lt
      omega
    · exact h
  have hiter : (r ^ p)⁻¹ * c * r ^ p = c ^ (k ^ p) := by
    have hk' : r⁻¹ * c * r = c ^ ((k : ℤ)) := by rw [zpow_natCast]; exact hk.symm
    have h := conj_pow_eq hk' p
    have hcast : (k : ℤ) ^ p = ((k ^ p : ℕ) : ℤ) := by push_cast; ring
    rw [h, hcast, zpow_natCast]
  have hrp_comm : (r ^ p)⁻¹ * c * r ^ p = c := by
    rw [← hs]
    calc (c ^ s)⁻¹ * c * c ^ s = (c ^ s)⁻¹ * (c * c ^ s) := by group
      _ = (c ^ s)⁻¹ * (c ^ s * c) := by rw [((Commute.refl c).pow_right s).eq]
      _ = c := by group
  have hcpow : c ^ (k ^ p) = c := hiter ▸ hrp_comm
  have hmod : k ^ p ≡ 1 [MOD p ^ n] := by
    have h := (pow_eq_pow_iff_modEq (x := c)).mp (show c ^ (k ^ p) = c ^ 1 by
      rw [pow_one]; exact hcpow)
    rwa [hord] at h
  have hdiv : p ^ n ∣ k ^ p - 1 :=
    (Nat.modEq_iff_dvd' (show 1 ≤ k ^ p from one_le_pow₀ hkpos)).mp hmod.symm
  have hlt : p ^ (n - 1) ∣ k - 1 := p_pow_pred_dvd_sub_one_of_pow_dvd hp hodd hn hdiv
  have hconjpow : r⁻¹ * c ^ p * r = c ^ (k * p) := by
    have h := conj_pow (a := r⁻¹) (b := c) (i := p)
    rw [inv_inv] at h
    rw [← h, ← hk, ← pow_mul]
  rw [hconjpow]
  have hfinal : c ^ (k * p) = c ^ p := by
    rw [pow_eq_pow_iff_modEq, hord]
    refine (Nat.modEq_iff_dvd' (by nlinarith [hkpos, hp.pos])).mpr ?_ |>.symm
    obtain ⟨t, ht⟩ := hlt
    have h1 : k * p - p = (k - 1) * p := by rw [Nat.sub_mul, one_mul]
    have hp1 : p ^ n = p ^ (n - 1) * p := by rw [← pow_succ, Nat.sub_add_cancel hn1]
    refine ⟨t, ?_⟩
    rw [h1, ht, hp1]; ring
  exact hfinal

/-- **Conjugation is trivial on `c ^ (p ^ t)`, `t ≥ 1`.**  If `c` has order `p ^ n` and
`y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1))`, then `y` centralizes every `c ^ (p ^ t)` with `t ≥ 1`
(where the exponent is `p ^ (n - 1 + t) ≥ p ^ n`). -/
theorem conj_pow_prime_pow_eq_self {p n m t : ℕ} (hn : 1 ≤ n) (ht : 1 ≤ t) {c y : X}
    (hord : orderOf c = p ^ n) (hconj : y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1))) :
    y⁻¹ * c ^ (p ^ t) * y = c ^ (p ^ t) := by
  have hcn : c ^ (p ^ n) = 1 := by
    have := pow_orderOf_eq_one c
    rwa [hord] at this
  have hexp : (1 + m * p ^ (n - 1)) * p ^ t = p ^ t + p ^ n * (m * p ^ (t - 1)) := by
    have h1 : p ^ (n - 1) * p ^ t = p ^ n * p ^ (t - 1) := by
      rw [← pow_add, ← pow_add]; congr 1; omega
    calc (1 + m * p ^ (n - 1)) * p ^ t = p ^ t + m * (p ^ (n - 1) * p ^ t) := by ring
      _ = p ^ t + m * (p ^ n * p ^ (t - 1)) := by rw [h1]
      _ = p ^ t + p ^ n * (m * p ^ (t - 1)) := by ring
  have hstep : y⁻¹ * c ^ (p ^ t) * y = (y⁻¹ * c * y) ^ (p ^ t) := by
    have h := conj_pow (a := y⁻¹) (b := c) (i := p ^ t)
    rw [inv_inv] at h
    exact h.symm
  rw [hstep, hconj, ← pow_mul, hexp, pow_add, pow_mul, hcn, one_pow, mul_one]

/-- Arithmetic: from `d ∣ N` and `N / d = p`, the divisor `d` is `N / p`. -/
lemma eq_div_of_div_eq_of_dvd {N d p : ℕ} (hp : 0 < p) (hd : d ∣ N) (h : N / d = p) :
    d = N / p := by
  have hN : N = p * d := by rw [← Nat.div_mul_cancel hd, h]
  rw [hN, Nat.mul_div_cancel_left d hp]

/-- **The subgroup of order `p` of a cyclic group is unique.**  If `y, z` both have order `p` and
both lie in the cyclic subgroup `⟨a⟩`, then they generate the same subgroup.  (Consequently
`y ∈ ⟨z⟩`.) -/
theorem zpowers_eq_of_mem_zpowers_of_orderOf_eq_prime {p : ℕ} (hp : p.Prime) {a y z : X}
    (hy : orderOf y = p) (hz : orderOf z = p) (hya : y ∈ Subgroup.zpowers a)
    (hza : z ∈ Subgroup.zpowers a) : Subgroup.zpowers y = Subgroup.zpowers z := by
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hya
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hza
  have hyn : n ≠ 0 := by
    rintro rfl
    rw [zpow_zero] at hn
    rw [← hn, orderOf_one] at hy
    exact hp.ne_one hy.symm
  have hzm : m ≠ 0 := by
    rintro rfl
    rw [zpow_zero] at hm
    rw [← hm, orderOf_one] at hz
    exact hp.ne_one hz.symm
  have ho_n : orderOf (a ^ n) = p := by rw [hn]; exact hy
  have ho_m : orderOf (a ^ m) = p := by rw [hm]; exact hz
  rw [← hn, ← hm, Subgroup.zpowers_eq_zpowers_iff',
    Int.gcd_eq_natAbs_gcd_natAbs, Int.gcd_eq_natAbs_gcd_natAbs]
  simp only [Int.natAbs_natCast]
  have h1 : orderOf a / (orderOf a).gcd n.natAbs = p := by
    rw [← orderOf_zpow' a hyn]; exact ho_n
  have h2 : orderOf a / (orderOf a).gcd m.natAbs = p := by
    rw [← orderOf_zpow' a hzm]; exact ho_m
  have hd1 : (orderOf a).gcd n.natAbs ∣ orderOf a := Nat.gcd_dvd_left _ _
  have hd2 : (orderOf a).gcd m.natAbs ∣ orderOf a := Nat.gcd_dvd_left _ _
  have e1 : (orderOf a).gcd n.natAbs = orderOf a / p := eq_div_of_div_eq_of_dvd hp.pos hd1 h1
  have e2 : (orderOf a).gcd m.natAbs = orderOf a / p := eq_div_of_div_eq_of_dvd hp.pos hd2 h2
  rw [Nat.gcd_comm n.natAbs (orderOf a), Nat.gcd_comm m.natAbs (orderOf a), e1, e2]


/-- **Elements of order dividing `p` commute with `y` and with `c ^ (p ^ (n - 1))`.**

This is the technical heart of the argument: writing `x = e * r` with `e ∈ E`, `r ∈ R` and using
`x ^ p = 1`, one gets `r ^ p = (e ^ p)⁻¹ ∈ ⟨c ^ p ^ (n - 1)⟩ ⊆ ⟨c⟩`, whence `r` centralizes
`c ^ p` (`inv_mul_pow_eq_self_of_pow_mem_zpowers`) and so `r = c ^ i * y ^ j`.  Then
`r ^ p = c ^ (i * p)` again lies in a group of order `p`, forcing `p ^ (n - 2) ∣ i` (here
`n ≥ 3` is used), so that `c ^ i` centralizes `y`.  The case of `c ^ (p ^ (n - 1))` is easier:
both `c` and `y` centralize it. -/
theorem commute_of_pow_eq_one {p n m : ℕ} (hp : p.Prime) (hodd : p ≠ 2) (hn : 3 ≤ n)
    {E R : Subgroup X} (hsup : E ⊔ R = ⊤) (hER : ⁅E, R⁆ = ⊥)
    {c y : X} (hHchar : (Subgroup.zpowers c).Characteristic)
    (hEp : ∀ e ∈ E, e ^ p ∈ Subgroup.zpowers (c ^ p ^ (n - 1)))
    (hcR : c ∈ R) (hc : orderOf c = p ^ n) (hyR : y ∈ R) (hyp : y ^ p = 1)
    (hconj : y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1)))
    (hnormal : ∀ u ∈ R, u⁻¹ * c ^ p * u = c ^ p → ∃ i j : ℕ, u = c ^ i * y ^ j)
    {x : X} (hx : x ^ p = 1) :
    Commute x y ∧ Commute x (c ^ p ^ (n - 1)) := by
  have hn1 : 1 ≤ n := by omega
  obtain ⟨e, heE, r, hrR, her⟩ := exists_mul_eq_of_mem_sup hER (by rw [hsup]; trivial)
  have hEcentral : e ∈ Subgroup.centralizer (R : Set X) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hER heE
  have hRu : ∀ u ∈ R, u * e = e * u := fun u hu =>
    (Subgroup.mem_centralizer_iff.mp hEcentral) u hu
  have hce : Commute e r := (hRu r hrR).symm
  -- `e ^ p * r ^ p = 1`
  have heprp : e ^ p * r ^ p = 1 := by
    have h1 : (e * r) ^ p = 1 := by rw [her]; exact hx
    rwa [Commute.mul_pow hce p] at h1
  -- the element `z = c ^ (p ^ (n - 1))`
  have hzp : (c ^ p ^ (n - 1)) ^ p = 1 := by
    have hp1 : p ^ (n - 1) * p = p ^ n := by rw [← pow_succ, Nat.sub_add_cancel hn1]
    rw [← pow_mul, hp1]
    have h := pow_orderOf_eq_one c
    rwa [hc] at h
  have hzf : IsOfFinOrder (c ^ p ^ (n - 1)) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨p, hp.pos, hzp⟩
  -- `r ^ p` lies in `⟨c⟩`
  have hrp_z : r ^ p ∈ Subgroup.zpowers (c ^ p ^ (n - 1)) := by
    have hrp_eq : r ^ p = (e ^ p)⁻¹ := by
      calc r ^ p = (e ^ p)⁻¹ * (e ^ p * r ^ p) := by group
        _ = (e ^ p)⁻¹ * 1 := by rw [heprp]
        _ = (e ^ p)⁻¹ := by rw [mul_one]
    rw [hrp_eq]
    exact Subgroup.inv_mem _ (hEp e heE)
  have hrp_c : r ^ p ∈ Subgroup.zpowers c :=
    (Subgroup.zpowers_le.mpr (Subgroup.pow_mem _ (Subgroup.mem_zpowers c) _)) hrp_z
  -- hence `r` centralizes `c ^ p` and `r = c ^ i * y ^ j`
  have hcentral : r⁻¹ * c ^ p * r = c ^ p :=
    inv_mul_pow_eq_self_of_pow_mem_zpowers hp hodd (by omega) hHchar hc hrp_c
  obtain ⟨i, j, hij⟩ := hnormal r hrR hcentral
  -- `r ^ p = c ^ (i * p)` is again of order dividing `p`
  have hrp_ip : r ^ p = c ^ (i * p) := by
    rw [hij, pow_eq_of_conj_eq hp hodd (show 2 ≤ n by omega) hc hconj i j]
    have hyj : y ^ (j * p) = 1 := by rw [mul_comm j p, pow_mul, hyp, one_pow]
    rw [hyj, mul_one]
  have hcip_mem : c ^ (i * p) ∈ Subgroup.zpowers (c ^ p ^ (n - 1)) := by
    rw [← hrp_ip]; exact hrp_z
  have hzmem_pow : ∀ w ∈ Subgroup.zpowers (c ^ p ^ (n - 1)), w ^ p = 1 := by
    intro w hw
    obtain ⟨k, hk⟩ := exists_pow_eq_of_mem_zpowers hzf hw
    rw [← hk, ← pow_mul, mul_comm k p, pow_mul, hzp, one_pow]
  have hcip2 : c ^ (i * p * p) = 1 := by
    have h : (c ^ (i * p)) ^ p = 1 := hzmem_pow (c ^ (i * p)) hcip_mem
    calc c ^ (i * p * p) = (c ^ (i * p)) ^ p := by rw [pow_mul]
      _ = 1 := h
  have hindvd : p ^ (n - 2) ∣ i := by
    have hdvd : p ^ n ∣ i * p * p := by
      rw [← hc, orderOf_dvd_iff_pow_eq_one]
      exact hcip2
    have hpp : p ^ n = p ^ (n - 2) * p ^ 2 := by rw [← pow_add]; congr 1; omega
    have hd : p ^ (n - 2) * p ^ 2 ∣ i * p ^ 2 := by
      rw [← hpp]
      have hh : i * p * p = i * p ^ 2 := by ring
      rwa [hh] at hdvd
    exact (Nat.mul_dvd_mul_iff_right (pow_pos hp.pos 2)).mp hd
  -- `c ^ i` commutes with `y`: `p ^ (n - 2) ∣ i` and `y` centralizes `c ^ (p ^ (n - 2))`
  have hcy_pred : Commute (c ^ p ^ (n - 2)) y := by
    have h := conj_pow_prime_pow_eq_self (p := p) (n := n) (m := m) (t := n - 2) hn1
      (by omega) hc hconj
    show c ^ p ^ (n - 2) * y = y * c ^ p ^ (n - 2)
    calc c ^ p ^ (n - 2) * y = y * (y⁻¹ * c ^ p ^ (n - 2) * y) := by group
      _ = y * c ^ p ^ (n - 2) := by rw [h]
  obtain ⟨t, ht⟩ := hindvd
  have hciy : Commute (c ^ i) y := by
    have h2 : Commute (c ^ (p ^ (n - 2) * t)) y := by
      rw [pow_mul]
      exact hcy_pred.pow_left t
    rwa [← ht] at h2
  have hey : Commute e y := (hRu y hyR).symm
  have hry : Commute r y := by
    rw [hij]
    exact hciy.mul_left ((Commute.refl y).pow_left j)
  have hcz : Commute (c ^ p ^ (n - 1)) y := by
    have h := conj_pow_prime_pow_eq_self (p := p) (n := n) (m := m) (t := n - 1) hn1
      (by omega) hc hconj
    show c ^ p ^ (n - 1) * y = y * c ^ p ^ (n - 1)
    calc c ^ p ^ (n - 1) * y = y * (y⁻¹ * c ^ p ^ (n - 1) * y) := by group
      _ = y * c ^ p ^ (n - 1) := by rw [h]
  have hez : Commute e (c ^ p ^ (n - 1)) := (hRu (c ^ p ^ (n - 1)) (R.pow_mem hcR _)).symm
  have hrz : Commute r (c ^ p ^ (n - 1)) := by
    rw [hij]
    exact (((Commute.refl c).pow_left i).pow_right _).mul_left (hcz.symm.pow_left j)
  refine ⟨?_, ?_⟩
  · have h := hey.mul_left hry
    rwa [her] at h
  · have h := hez.mul_left hrz
    rwa [her] at h


open scoped commutatorElement

set_option maxHeartbeats 800000

/-- Membership in the centre of a subgroup, transported to the ambient group. -/
lemma mem_centerIn_iff' {H : Subgroup X} {x : X} :
    x ∈ Work.PGroup.centerIn H ↔ x ∈ H ∧ ∀ y ∈ H, y * x = x * y := by
  rw [Work.PGroup.centerIn]
  constructor
  · intro hx
    obtain ⟨c, hc, hcx⟩ := Subgroup.mem_map.mp hx
    refine ⟨?_, ?_⟩
    · rw [← hcx]; exact c.2
    · intro y hy
      have h2 : y * (c : X) = (c : X) * y := by
        have := congrArg (Subtype.val) (Subgroup.mem_center_iff.mp hc ⟨y, hy⟩)
        simpa using this
      rw [← hcx]
      exact h2
  · rintro ⟨hxH, hcomm⟩
    exact ⟨⟨x, hxH⟩, Subgroup.mem_center_iff.mpr (fun w => Subtype.ext (hcomm w.val w.2)), rfl⟩

/-- **The `n ≥ 3` obstruction.**  There is no configuration as in the hypotheses: a finite group
all of whose abelian characteristic subgroups are cyclic cannot contain a cyclic characteristic
subgroup `⟨c⟩` of order `p ^ n` (`p` odd, `n ≥ 3`) together with an element `y` of order `p` in
`R` acting on `c` by `c ↦ c ^ (1 + m * p ^ (n - 1))`, outside `⟨c ^ p ^ (n - 1)⟩`, when `X`
factors as `E ⊔ R` with `[E, R] = 1`, all `p`-th powers in `E` lie in `⟨c ^ p ^ (n - 1)⟩`, and
the elements of `R` centralizing `c ^ p` are exactly the products `c ^ i * y ^ j`.

The contradiction is obtained from `Z(Ω₁(X))`: by `commute_of_pow_eq_one` the two distinct
subgroups of order `p` generated by `y` and by `c ^ p ^ (n - 1)` both lie in the centre of
`Ω₁(X)`, which is therefore not cyclic; but `Z(Ω₁(X))` is abelian and characteristic in `X`, so
by hypothesis it *is* cyclic. -/
theorem false_of_three_le_of_allAbelianCharCyclic {X : Type*} [Group X] [Finite X] {p n m : ℕ}
    (hp : p.Prime) (hodd : p ≠ 2) (hn : 3 ≤ n)
    (hdc : ∀ A : Subgroup X, A.Characteristic → IsMulCommutative A → ∃ a : X, A = Subgroup.zpowers a)
    {E R : Subgroup X} (hsup : E ⊔ R = ⊤) (hER : ⁅E, R⁆ = ⊥)
    {c y : X} (hHchar : (Subgroup.zpowers c).Characteristic)
    (hEp : ∀ e ∈ E, e ^ p ∈ Subgroup.zpowers (c ^ p ^ (n - 1)))
    (hcR : c ∈ R) (hc : orderOf c = p ^ n) (hyR : y ∈ R) (hyp : y ^ p = 1)
    (hconj : y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1)))
    (hynw : y ∉ Subgroup.zpowers (c ^ p ^ (n - 1)))
    (hnormal : ∀ u ∈ R, u⁻¹ * c ^ p * u = c ^ p → ∃ i j : ℕ, u = c ^ i * y ^ j) :
    False := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  have hn1 : 1 ≤ n := by omega
  -- the element `c ^ (p ^ (n - 1))` has order `p`
  have hzp : (c ^ p ^ (n - 1)) ^ p = 1 := by
    have hp1 : p ^ (n - 1) * p = p ^ n := by rw [← pow_succ, Nat.sub_add_cancel hn1]
    rw [← pow_mul, hp1]
    have h := pow_orderOf_eq_one c
    rwa [hc] at h
  have hzne : c ^ p ^ (n - 1) ≠ 1 := by
    intro h1
    have hd : p ^ n ∣ p ^ (n - 1) := by
      rw [← hc, orderOf_dvd_iff_pow_eq_one]
      exact h1
    have hlt : p ^ (n - 1) < p ^ n := Nat.pow_lt_pow_right hp.one_lt (by omega)
    exact absurd (Nat.le_of_dvd (pow_pos hp.pos _) hd) (not_le.mpr hlt)
  have hzord : orderOf (c ^ p ^ (n - 1)) = p := orderOf_eq_prime hzp hzne
  have hyne : y ≠ 1 := fun h => hynw (h ▸ Subgroup.one_mem _)
  have hyord : orderOf y = p := orderOf_eq_prime hyp hyne
  -- elements of order dividing `p` commute with `y` and with `c ^ (p ^ (n - 1))`
  have hcomm : ∀ x : X, x ^ p = 1 → Commute x y ∧ Commute x (c ^ p ^ (n - 1)) :=
    fun x hx => commute_of_pow_eq_one hp hodd hn hsup hER hHchar hEp hcR hc hyR hyp hconj
      hnormal hx
  -- `F = Ω₁(X)`, the subgroup generated by the elements of order dividing `p`
  let F : Subgroup X := Subgroup.closure {x : X | x ^ p = 1}
  have hFchar : F.Characteristic := by
    rw [Subgroup.characteristic_iff_map_eq]
    intro φ
    change Subgroup.map φ.toMonoidHom (Subgroup.closure {x : X | x ^ p = 1}) =
      Subgroup.closure {x : X | x ^ p = 1}
    rw [MonoidHom.map_closure]
    apply congrArg Subgroup.closure
    ext x
    simp only [Set.mem_image, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨w, hw, rfl⟩
      show (φ.toMonoidHom w) ^ p = 1
      rw [← map_pow φ.toMonoidHom w p, hw, map_one]
    · intro hx
      refine ⟨φ.symm x, ?_, ?_⟩
      · show (φ.symm x) ^ p = 1
        rw [← map_pow φ.symm x p, hx, map_one]
      · show φ.toMonoidHom (φ.symm x) = x
        exact φ.apply_symm_apply x
  haveI : F.Characteristic := hFchar
  have hAchar : (Work.PGroup.centerIn F).Characteristic := by
    rw [Work.PGroup.centerIn]
    infer_instance
  -- `y` and `c ^ (p ^ (n - 1))` lie in the centre of `F`
  have hFle_y : {x : X | x ^ p = 1} ⊆ (Subgroup.centralizer ({y} : Set X) : Set X) := by
    intro w hw
    exact Subgroup.mem_centralizer_singleton_iff.mpr (hcomm w hw).1
  have hFle_z : {x : X | x ^ p = 1} ⊆
      (Subgroup.centralizer ({c ^ p ^ (n - 1)} : Set X) : Set X) := by
    intro w hw
    exact Subgroup.mem_centralizer_singleton_iff.mpr (hcomm w hw).2
  have hFmem_y : F ≤ Subgroup.centralizer ({y} : Set X) :=
    (Subgroup.closure_le _).mpr hFle_y
  have hFmem_z : F ≤ Subgroup.centralizer ({c ^ p ^ (n - 1)} : Set X) :=
    (Subgroup.closure_le _).mpr hFle_z
  have hyA : y ∈ Work.PGroup.centerIn F := by
    rw [mem_centerIn_iff']
    refine ⟨Subgroup.subset_closure hyp, fun w hw => ?_⟩
    exact Subgroup.mem_centralizer_singleton_iff.mp (hFmem_y hw)
  have hzA : c ^ p ^ (n - 1) ∈ Work.PGroup.centerIn F := by
    rw [mem_centerIn_iff']
    refine ⟨Subgroup.subset_closure hzp, fun w hw => ?_⟩
    exact Subgroup.mem_centralizer_singleton_iff.mp (hFmem_z hw)
  -- the centre of `F` is abelian, hence cyclic by hypothesis
  have hAabel : IsMulCommutative (Work.PGroup.centerIn F) := by
    rw [isMulCommutative_iff]
    intro u v
    refine Subtype.ext ?_
    show (u : X) * (v : X) = (v : X) * (u : X)
    exact (((mem_centerIn_iff'.mp u.2).2 v ((mem_centerIn_iff'.mp v.2).1)).symm)
  obtain ⟨a, ha⟩ := hdc (Work.PGroup.centerIn F) hAchar hAabel
  -- two distinct subgroups of order `p` inside a cyclic group: contradiction
  have hya : y ∈ Subgroup.zpowers a := ha ▸ hyA
  have hza : c ^ p ^ (n - 1) ∈ Subgroup.zpowers a := ha ▸ hzA
  have heq : Subgroup.zpowers y = Subgroup.zpowers (c ^ p ^ (n - 1)) :=
    zpowers_eq_of_mem_zpowers_of_orderOf_eq_prime hp hyord hzord hya hza
  exact hynw (heq ▸ Subgroup.mem_zpowers y)


end Work.PGroup.Symplectic
