/-!
# A generator of the centralizer of `c ^ p` in a `p`-group

This is the group-theoretic structure lemma behind P. Hall's classification of `p`-groups of
symplectic type (Feit–Thompson 3.5, Gorenstein §5.4), used to build the symplectic form on a
`p`-group all of whose abelian characteristic subgroups are cyclic.

Let `X` be a group, `p` an odd prime, `R ≤ X` a `p`-subgroup, and `c ∈ R` of order `p ^ n`
(`n ≥ 2`) whose centralizer in `R` is exactly the cyclic subgroup it generates
(`hnormal`, `hCen`), with `R ≠ ⟨c⟩` (`hne`).  Then there is `y ∈ R ∖ ⟨c⟩` of order dividing `p`
such that `C_R(c ^ p) = ⟨c⟩ · ⟨y⟩` — every `u ∈ R` centralizing `c ^ p` is a product
`c ^ i * y ^ j` — and `y` conjugates `c` to `c ^ (1 + m * p ^ (n - 1))`.

The two mathematical ingredients are separated into the imported lemmas:
* `exists_order_p_conj` produces `y` (of order `p`, outside `⟨c⟩`, centralizing `c ^ p`, with the
  conjugation relation), and
* `centralizer_agemo_le_zpowers_sup` shows that the elements centralizing `c ^ p` form the
  subgroup generated by `⟨c⟩` and `y`.
-/

set_option linter.style.haveILetI false

namespace Work.PGroup.Symplectic

theorem exists_centralizer_agemo_generator {X : Type*} [Group X] {p n : ℕ} (hp : p.Prime)
    (hodd : p ≠ 2) (R : Subgroup X) (hR : IsPGroup p ↥R) {c : X} (hcR : c ∈ R) (hn : 2 ≤ n)
    (hc : orderOf c = p ^ n)
    (hnormal : ∀ r ∈ R, r⁻¹ * c * r ∈ Subgroup.zpowers c)
    (hCen : ∀ r ∈ R, r⁻¹ * c * r = c → r ∈ Subgroup.zpowers c)
    (hne : ∃ r ∈ R, r ∉ Subgroup.zpowers c) :
    ∃ y : X, y ∈ R ∧ y ∉ Subgroup.zpowers c ∧ y ^ p = 1 ∧
      (∀ u ∈ R, u⁻¹ * c ^ p * u = c ^ p → ∃ i j : ℕ, u = c ^ i * y ^ j) ∧
      (∃ m : ℕ, y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1))) := by
  obtain ⟨y, hyR, hyK, hyp, _hyN, hm⟩ :=
    exists_order_p_conj hp hodd hn hR hcR hc hnormal hCen hne
  obtain ⟨m, hym⟩ := hm
  refine ⟨y, hyR, hyK, hyp, ?_, m, hym⟩
  exact centralizer_agemo_le_zpowers_sup hp hn hcR hyR hc hnormal hCen hyK hym

end Work.PGroup.Symplectic
