/-!
# Transfer of "all abelian characteristic subgroups are cyclic" to a subgroup

Given an ambient group `G` and a subgroup `P ≤ G`, suppose every abelian subgroup `A ≤ P` of `G`
that is invariant under conjugation by the normalizer `N_G(P)` is cyclic (as a subgroup of `G`,
i.e. generated by one element of `G`).  Then `P` itself, viewed as a group, has the property that
all of its abelian characteristic subgroups are cyclic.

The bridge is entirely formal: a subgroup `A ≤ P` (in the intrinsic sense, i.e. `A : Subgroup ↥P`)
is characteristic in `↥P` precisely when its image `A.map P.subtype ≤ G` is invariant under
conjugation by `N_G(P)`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Classical Pointwise
open Subgroup

namespace Work.PGroup.Symplectic

/-- Conjugating a subgroup by a group element is the same as taking its image under the
corresponding monoid homomorphism.  (The two sides are definitionally distinct: `•` is the
pointwise action on subgroups, `map` is the subgroup image.) -/
theorem conj_smul_eq_map_conj {G : Type*} [Group G] (g : G) (H : Subgroup G) :
    MulAut.conj g • H = H.map (MulAut.conj g).toMonoidHom := by
  ext y
  rw [Subgroup.mem_smul_pointwise_iff_exists, Subgroup.mem_map]
  constructor
  · rintro ⟨s, hs, hsy⟩
    exact ⟨s, hs, by rw [← hsy]; rfl⟩
  · rintro ⟨s, hs, rfl⟩
    exact ⟨s, hs, rfl⟩

theorem allAbelianCharCyclic_subtype {G : Type*} [Group G] {P : Subgroup G}
    (h : ∀ A : Subgroup G, A ≤ P → (∀ g : G, g ∈ Subgroup.normalizer (P : Set G) →
        Work.PGroup.conjBy g A = A) → IsMulCommutative A → ∃ a : G, A = Subgroup.zpowers a) :
    Work.PGroup.AllAbelianCharCyclic ↥P := by
  intro A hAchar hAcomm
  -- `A`, viewed as a subgroup of `G`.
  have hinv : ∀ g : G, g ∈ Subgroup.normalizer (P : Set G) →
      Work.PGroup.conjBy g (A.map P.subtype) = A.map P.subtype := by
    intro g hg
    -- the automorphism of `↥P` induced by `g`, and its explicit action
    have hhom : (MulAut.conj g).toMonoidHom.comp P.subtype =
        P.subtype.comp (P.normalizerMonoidHom ⟨g, hg⟩).toMonoidHom := by
      ext a
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Subgroup.normalizerMonoidHom,
        MulDistribMulAction.toMulAut_apply, MulDistribMulAction.toMulEquiv_apply,
        MulAut.conj_apply]
      rfl
    rw [Work.PGroup.conjBy, conj_smul_eq_map_conj, Subgroup.map_map, hhom, ← Subgroup.map_map,
      Subgroup.characteristic_iff_map_eq.mp hAchar (P.normalizerMonoidHom ⟨g, hg⟩)]
  have hcomm : IsMulCommutative (A.map P.subtype) := by
    rw [isMulCommutative_iff]
    rintro ⟨x, hx⟩ ⟨y, hy⟩
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hx
    obtain ⟨b, hb, rfl⟩ := Subgroup.mem_map.mp hy
    apply Subtype.ext
    show (a : G) * (b : G) = (b : G) * (a : G)
    exact congrArg (fun z : A => (z : G)) (isMulCommutative_iff.mp hAcomm ⟨a, ha⟩ ⟨b, hb⟩)
  obtain ⟨a, ha⟩ := h (A.map P.subtype) (Subgroup.map_subtype_le A) hinv hcomm
  have haP : a ∈ P := Subgroup.map_subtype_le A (ha ▸ Subgroup.mem_zpowers a)
  refine ⟨⟨a, haP⟩, ?_⟩
  apply Subgroup.map_injective (f := P.subtype) (Subgroup.subtype_injective P)
  rw [MonoidHom.map_zpowers, ha]
  rfl

end Work.PGroup.Symplectic
