/-!
# The `p`-th power map on `⟨c, y⟩` when `y` conjugates `c` to a power

Let `X` be a group, `p` an odd prime, `n ≥ 2`, and let `c, y ∈ X` with `c` of order `p ^ n`
and `y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1))`.  Then for all `i j : ℕ`

`(c ^ i * y ^ j) ^ p = c ^ (i * p) * y ^ (j * p)`,

i.e. the `p`-th power map is multiplicative on the subgroup generated by `c` and `y`.

This is the elementary group-theoretic computation behind P. Hall's classification of
`p`-groups of symplectic type (Gorenstein §5.4, Feit–Thompson 3.5).  Writing
`z = c ^ (p ^ (n - 1))` (an element of order dividing `p`), the conjugation relation becomes
`y⁻¹ * c * y = c * z ^ m`, so that `z` is central in `⟨c, y⟩` and the group is of nilpotency
class two there; the class-two power formula then gives the result, the correction term
`z ^ (p.choose 2)` vanishing because `p ∣ p.choose 2` for odd `p`.

The proof rests on the general lemma `pow_mul_eq_of_commute` for a group in which `b * a = a * b * u`
with `u` commuting with `a` and `b`.
-/

namespace Work.PGroup.Symplectic

/-- **Power formula in a group where `b * a = a * b * u` with `u` central in `⟨a, b⟩`.**
If `u` commutes with both `a` and `b`, and `b * a = a * b * u`, then
`(a * b) ^ k = a ^ k * b ^ k * u ^ (k.choose 2)` for every `k`.

This is the class-two power formula `(ab)^n = a^n b^n [b,a]^(n.choose 2)` with the commutator
`[b,a]` replaced by an abstract element `u` that is only assumed to commute with `a` and `b`. -/
theorem pow_mul_eq_of_commute {G : Type*} [Group G] {a b u : G}
    (hua : Commute u a) (hub : Commute u b) (hba : b * a = a * b * u) :
    ∀ k : ℕ, (a * b) ^ k = a ^ k * b ^ k * u ^ (k.choose 2) := by
  have hbapow : ∀ k : ℕ, b ^ k * a = a * b ^ k * u ^ k := by
    intro k
    induction k with
    | zero => simp
    | succ n ih =>
      have hcn : Commute u (b ^ n) := hub.pow_right n
      calc b ^ (n + 1) * a = b * (b ^ n * a) := by rw [pow_succ']; group
        _ = b * (a * b ^ n * u ^ n) := by rw [ih]
        _ = b * a * b ^ n * u ^ n := by group
        _ = a * b * u * b ^ n * u ^ n := by rw [hba]
        _ = a * b * (u * b ^ n) * u ^ n := by group
        _ = a * b * (b ^ n * u) * u ^ n := by rw [hcn.eq]
        _ = a * b ^ (n + 1) * u ^ (n + 1) := by rw [pow_succ', pow_succ']; group
  intro k
  induction k with
  | zero => simp
  | succ n ih =>
    have huCn : Commute (u ^ (n.choose 2)) (a * b) := (hua.mul_right hub).pow_left (n.choose 2)
    have huBn : Commute (u ^ n) b := hub.pow_left n
    have hchoose : (n + 1).choose 2 = n + n.choose 2 := by
      rw [Nat.choose_succ_succ, Nat.choose_one_right]
    calc (a * b) ^ (n + 1)
        = (a * b) ^ n * (a * b) := by rw [pow_succ]
      _ = a ^ n * b ^ n * u ^ (n.choose 2) * (a * b) := by rw [ih]
      _ = a ^ n * b ^ n * (u ^ (n.choose 2) * (a * b)) := by group
      _ = a ^ n * b ^ n * ((a * b) * u ^ (n.choose 2)) := by rw [huCn.eq]
      _ = a ^ n * (b ^ n * a) * b * u ^ (n.choose 2) := by group
      _ = a ^ n * (a * b ^ n * u ^ n) * b * u ^ (n.choose 2) := by rw [hbapow n]
      _ = a ^ n * a * b ^ n * (u ^ n * b) * u ^ (n.choose 2) := by group
      _ = a ^ n * a * b ^ n * (b * u ^ n) * u ^ (n.choose 2) := by rw [huBn.eq]
      _ = a ^ (n + 1) * b ^ (n + 1) * u ^ ((n + 1).choose 2) := by
            rw [hchoose]
            calc a ^ n * a * b ^ n * (b * u ^ n) * u ^ (n.choose 2)
                = (a ^ n * a) * (b ^ n * b) * (u ^ n * u ^ (n.choose 2)) := by group
              _ = a ^ (n + 1) * b ^ (n + 1) * u ^ (n + n.choose 2) := by
                    rw [← pow_succ a n, ← pow_succ b n, ← pow_add]

/-- **The `p`-th power map is multiplicative on `⟨c, y⟩`.**  If `c` has order `p ^ n` (`p` an odd
prime, `n ≥ 2`) and `y` conjugates `c` to `c ^ (1 + m * p ^ (n - 1))`, then
`(c ^ i * y ^ j) ^ p = c ^ (i * p) * y ^ (j * p)` for all `i, j`. -/
theorem pow_eq_of_conj_eq {X : Type*} [Group X] {p n m : ℕ} (hp : p.Prime) (hodd : p ≠ 2)
    (hn : 2 ≤ n) {c y : X} (hc : orderOf c = p ^ n)
    (hconj : y⁻¹ * c * y = c ^ (1 + m * p ^ (n - 1))) :
    ∀ i j : ℕ, (c ^ i * y ^ j) ^ p = c ^ (i * p) * y ^ (j * p) := by
  have hn1 : 1 ≤ n := by omega
  -- `c` has order `p ^ n`, so `c ^ (p ^ n) = 1`.
  have hcpn : c ^ (p ^ n) = 1 := by
    have := pow_orderOf_eq_one c
    rwa [hc] at this
  -- The central element `z = c ^ (p ^ (n - 1))` of order dividing `p`.
  set z : X := c ^ (p ^ (n - 1)) with hzdef
  have hzp : z ^ p = 1 := by
    rw [hzdef, ← pow_mul, show p ^ (n - 1) * p = p ^ n by rw [← pow_succ, Nat.sub_add_cancel hn1], hcpn]
  -- `z` is centralized by `y`.
  have hzy : Commute z y := by
    have hyzy : y⁻¹ * z * y = z := by
      have h1 : (y⁻¹ * c * y) ^ (p ^ (n - 1)) = y⁻¹ * z * y := by
        rw [hzdef]
        simpa using (conj_pow (a := y⁻¹) (b := c) (i := p ^ (n - 1)))
      rw [← h1, hconj, hzdef, ← pow_mul]
      have hpp : p ^ (n - 1) * p ^ (n - 1) = p ^ n * p ^ (n - 2) := by
        rw [← pow_add, ← pow_add]; congr 1; omega
      have hA : (1 + m * p ^ (n - 1)) * p ^ (n - 1) = p ^ (n - 1) + p ^ n * (m * p ^ (n - 2)) := by
        calc (1 + m * p ^ (n - 1)) * p ^ (n - 1)
            = p ^ (n - 1) + m * (p ^ (n - 1) * p ^ (n - 1)) := by ring
          _ = p ^ (n - 1) + m * (p ^ n * p ^ (n - 2)) := by rw [hpp]
          _ = p ^ (n - 1) + p ^ n * (m * p ^ (n - 2)) := by ring
      rw [hA, pow_add, pow_mul, hcpn, one_pow, mul_one]
    show z * y = y * z
    calc z * y = y * (y⁻¹ * z * y) := by group
      _ = y * z := by rw [hyzy]
  -- `z` is a power of `c`, hence centralized by `c`.
  have hzc : Commute z c := by
    rw [hzdef]
    exact (Commute.refl c).pow_left (p ^ (n - 1))
  -- The basic commutation `c * y = y * c * z ^ m`.
  have hcy : c * y = y * c * z ^ m := by
    calc c * y = y * (y⁻¹ * c * y) := by group
      _ = y * c ^ (1 + m * p ^ (n - 1)) := by rw [hconj]
      _ = y * c * z ^ m := by
            rw [hzdef, pow_add, pow_one, mul_comm m (p ^ (n - 1)), pow_mul]
            group
  -- `c * y ^ j = y ^ j * c * z ^ (j * m)`.
  have hcyp : ∀ j : ℕ, c * y ^ j = y ^ j * c * z ^ (j * m) := by
    intro j
    induction j with
    | zero => simp
    | succ k ih =>
      have hzk : Commute (z ^ (k * m)) y := hzy.pow_left (k * m)
      calc c * y ^ (k + 1) = c * (y ^ k * y) := by rw [pow_succ']; group
        _ = (c * y ^ k) * y := by group
        _ = (y ^ k * c * z ^ (k * m)) * y := by rw [ih]
        _ = y ^ k * c * (z ^ (k * m) * y) := by group
        _ = y ^ k * c * (y * z ^ (k * m)) := by rw [hzk.eq]
        _ = y ^ k * (c * y) * z ^ (k * m) := by group
        _ = y ^ k * (y * c * z ^ m) * z ^ (k * m) := by rw [hcy]
        _ = y ^ k * y * c * (z ^ m * z ^ (k * m)) := by group
        _ = y ^ (k + 1) * c * z ^ ((k + 1) * m) := by
              rw [← pow_succ y k, ← pow_add, show m + k * m = (k + 1) * m by ring]
  -- `c ^ i * y ^ j = y ^ j * c ^ i * z ^ (j * m * i)`.
  have hcypp : ∀ i j : ℕ, c ^ i * y ^ j = y ^ j * c ^ i * z ^ (j * m * i) := by
    intro i j
    induction i with
    | zero => simp
    | succ k ih =>
      have hcz : Commute (z ^ (j * m)) (c ^ k) := (hzc.pow_left (j * m)).pow_right k
      calc c ^ (k + 1) * y ^ j
          = c * (c ^ k * y ^ j) := by rw [pow_succ']; group
        _ = c * (y ^ j * c ^ k * z ^ (j * m * k)) := by rw [ih]
        _ = c * y ^ j * c ^ k * z ^ (j * m * k) := by group
        _ = (y ^ j * c * z ^ (j * m)) * c ^ k * z ^ (j * m * k) := by rw [hcyp j]
        _ = y ^ j * (c * c ^ k) * (z ^ (j * m) * z ^ (j * m * k)) := by
              rw [show (y ^ j * c * z ^ (j * m)) * c ^ k * z ^ (j * m * k)
                    = y ^ j * c * (z ^ (j * m) * c ^ k) * z ^ (j * m * k) by group,
                  hcz.eq]
              group
        _ = y ^ j * c ^ (k + 1) * z ^ (j * m * (k + 1)) := by
              rw [← pow_succ' c k, ← pow_add, show j * m + j * m * k = j * m * (k + 1) by ring]
  intro i j
  -- Apply the class-two power formula with `a = c ^ i`, `b = y ^ j`, `u = (z ^ (j * m * i))⁻¹`.
  have hua : Commute ((z ^ (j * m * i))⁻¹) (c ^ i) :=
    ((hzc.pow_left (j * m * i)).pow_right i).inv_left
  have hub : Commute ((z ^ (j * m * i))⁻¹) (y ^ j) :=
    ((hzy.pow_left (j * m * i)).pow_right j).inv_left
  have hba : y ^ j * c ^ i = c ^ i * y ^ j * (z ^ (j * m * i))⁻¹ := by
    rw [hcypp i j]; group
  have key := pow_mul_eq_of_commute hua hub hba p
  -- The correction factor `z ^ (j * m * i * (p.choose 2))` is trivial since `z ^ p = 1`.
  have hp2 : 2 < p := by have := hp.two_le; omega
  have hdvd : p ∣ p.choose 2 := hp.dvd_choose_self (by norm_num) hp2
  have hu1 : ((z ^ (j * m * i))⁻¹) ^ (p.choose 2) = 1 := by
    obtain ⟨t, ht⟩ := hdvd
    rw [ht, pow_mul]
    have hzpp : ((z ^ (j * m * i))⁻¹) ^ p = 1 := by
      rw [inv_pow]
      have h2 : (z ^ (j * m * i)) ^ p = 1 := by
        rw [← pow_mul, mul_comm (j * m * i) p, pow_mul, hzp, one_pow]
      rw [h2, inv_one]
    rw [hzpp, one_pow]
  rw [key, hu1, mul_one, ← pow_mul, ← pow_mul]

end Work.PGroup.Symplectic
