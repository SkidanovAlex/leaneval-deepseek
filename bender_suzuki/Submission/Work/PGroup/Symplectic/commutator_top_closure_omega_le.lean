open scoped commutatorElement

namespace Work.PGroup.Symplectic

/-- If `[X, C] ≤ Z(C)` then the commutator of the whole group with the subgroup
generated by the elements of `C` of order dividing `p` lies in the subgroup
generated by the elements of `Z(C)` of order dividing `p`. -/
theorem commutator_top_closure_omega_le {X : Type*} [Group X] {p : ℕ} (C : Subgroup X)
    (htop : ⁅(⊤ : Subgroup X), C⁆ ≤ (Subgroup.center ↥C).map C.subtype) :
    ⁅(⊤ : Subgroup X), Subgroup.closure {x : X | x ∈ C ∧ x ^ p = 1}⁆ ≤
      Subgroup.closure {z : X | z ∈ (Subgroup.center ↥C).map C.subtype ∧ z ^ p = 1} := by
  set Ω : Subgroup X := Subgroup.closure {x : X | x ∈ C ∧ x ^ p = 1} with hΩ
  set D : Subgroup X :=
    Subgroup.closure {z : X | z ∈ (Subgroup.center ↥C).map C.subtype ∧ z ^ p = 1} with hD
  -- `D` consists of elements that are central in `C`
  have hD_le : D ≤ (Subgroup.center ↥C).map C.subtype := by
    rw [hD]
    exact (Subgroup.closure_le _).mpr (fun z hz => hz.1)
  have hcc : ∀ w ∈ (Subgroup.center ↥C).map C.subtype, ∀ c ∈ C, c * w = w * c := by
    intro w hw c hc
    obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hw
    have := Subgroup.mem_center_iff.mp hu (⟨c, hc⟩ : ↥C)
    simpa using congrArg Subtype.val this
  -- each generator `ω` of `Ω` has `⁅x, ω⁆ ∈ D` for every `x`
  have hgen : ∀ ω : X, ω ∈ C → ω ^ p = 1 → ∀ x : X, ⁅x, ω⁆ ∈ D := by
    intro ω hωC hωp x
    have hmem_comm : ⁅x, ω⁆ ∈ ⁅(⊤ : Subgroup X), C⁆ :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top x) hωC
    have hz : ⁅x, ω⁆ ∈ (Subgroup.center ↥C).map C.subtype := htop hmem_comm
    have hcomm : Commute ω ⁅x, ω⁆ := hcc ⁅x, ω⁆ hz ω hωC
    have hp : ⁅x, ω⁆ ^ p = 1 := by
      rw [hcomm.commutatorElement_pow_right, hωp, commutatorElement_one_right]
    rw [hD]
    exact Subgroup.subset_closure ⟨hz, hp⟩
  have hmain : ∀ g ∈ Ω, ∀ x : X, ⁅x, g⁆ ∈ D := by
    intro g hg
    have h := Subgroup.closure_induction
      (p := fun g _ => g ∈ C ∧ ∀ x : X, ⁅x, g⁆ ∈ D)
      (fun s hs => ⟨hs.1, hgen s hs.1 hs.2⟩)
      ⟨C.one_mem, by intro x; simp⟩
      (fun a b ha hb iha ihb => ⟨C.mul_mem iha.1 ihb.1, fun x => by
          have h1 : ⁅x, b⁆ ∈ (Subgroup.center ↥C).map C.subtype := hD_le (ihb.2 x)
          have hxconj : a * ⁅x, b⁆ * a⁻¹ = ⁅x, b⁆ := by
            rw [hcc ⁅x, b⁆ h1 a iha.1]; group
          rw [commutatorElement_mul_right_eq_mul_conj]
          rw [show ⁅x, a⁆ * a * ⁅x, b⁆ * a⁻¹ = ⁅x, a⁆ * ⁅x, b⁆ by
                calc ⁅x, a⁆ * a * ⁅x, b⁆ * a⁻¹ = ⁅x, a⁆ * (a * ⁅x, b⁆ * a⁻¹) := by
                      group
                  _ = ⁅x, a⁆ * ⁅x, b⁆ := by rw [hxconj]]
          exact D.mul_mem (iha.2 x) (ihb.2 x)⟩)
      (fun a ha iha => ⟨C.inv_mem iha.1, fun x => by
          have hax : ⁅a, x⁆ ∈ D := by
            have h2 : ⁅x, a⁆⁻¹ = ⁅a, x⁆ := commutatorElement_inv x a
            rw [← h2]
            exact D.inv_mem (iha.2 x)
          have h2 : ⁅a, x⁆ ∈ (Subgroup.center ↥C).map C.subtype := hD_le hax
          have hac : a⁻¹ * ⁅a, x⁆ * a = ⁅a, x⁆ := by
            rw [hcc ⁅a, x⁆ h2 a⁻¹ (C.inv_mem iha.1)]; group
          rw [commutatorElement_inv_right, hac]
          exact hax⟩)
      hg
    exact h.2
  exact Subgroup.commutator_le.mpr (fun x _ g hg => hmain g hg x)

end Work.PGroup.Symplectic
