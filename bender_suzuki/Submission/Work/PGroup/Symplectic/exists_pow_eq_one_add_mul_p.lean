/-!
# The exponent of a conjugation inside a cyclic `p`-group

Let `X` be a group, `p` a prime, `c : X` an element of order `p ^ n`, and `r : X` an element
such that

* `r⁻¹ * c * r` lies in the cyclic group `⟨c⟩` generated by `c`, and
* some `p`-power of `r` centralizes `c`.

Then `r⁻¹ * c * r = c ^ (1 + m * p)` for some natural number `m`; equivalently, conjugation by
`r` acts on `⟨c⟩ ≅ ℤ/p^n` by an automorphism `c ↦ c^(1+m p)`, i.e. an automorphism congruent to
the identity modulo `p`.

The mathematical content is the following.  Write `r⁻¹ * c * r = c ^ k`.  Iterating conjugation,
`(r ^ j)⁻¹ * c * (r ^ j) = c ^ (k ^ j)`.  For `j = p ^ N` the second hypothesis gives
`c ^ (k ^ (p ^ N)) = c`, hence `p ^ n ∣ k ^ (p ^ N) - 1` and a fortiori `p ∣ k ^ (p ^ N) - 1`.
Frobenius' congruence `k ^ (p ^ N) ≡ k (mod p)` then yields `k ≡ 1 (mod p)`, i.e. `p ∣ k - 1`.
Writing `k - 1 = p * t`, the element `c⁻¹ * (r⁻¹ * c * r) = c ^ (k - 1) = (c ^ p) ^ t` lies in
`⟨c ^ p⟩`; since `c ^ p` has finite order, it is an honest (non-negative) power `(c ^ p) ^ m` of
`c ^ p`, and `r⁻¹ * c * r = c * (c ^ p) ^ m = c ^ (1 + m * p)`.
-/

namespace Work.PGroup.Symplectic

/-- If `a` has finite order, every element of the cyclic subgroup it generates is a natural
power of `a`. (For a general (possibly infinite order) element the same holds with integer
exponents only.) -/
lemma exists_pow_eq_of_mem_zpowers {G : Type*} [Group G] {a y : G} (ha : IsOfFinOrder a)
    (hy : y ∈ Subgroup.zpowers a) : ∃ m : ℕ, a ^ m = y := by
  rw [← IsOfFinOrder.mem_powers_iff_mem_zpowers ha] at hy
  exact (Submonoid.mem_powers_iff y a).mp hy

/-- Conjugation iterates powers: if `r⁻¹ * c * r = c ^ k` then
`(r ^ j)⁻¹ * c * r ^ j = c ^ (k ^ j)`. -/
lemma conj_pow_eq {G : Type*} [Group G] {c r : G} {k : ℤ} (hk : r⁻¹ * c * r = c ^ k) :
    ∀ j : ℕ, (r ^ j)⁻¹ * c * r ^ j = c ^ (k ^ j) := by
  intro j
  induction j with
  | zero => simp
  | succ m ih =>
    have hstep : (r ^ (m + 1))⁻¹ * c * r ^ (m + 1) = r⁻¹ * ((r ^ m)⁻¹ * c * r ^ m) * r := by
      rw [pow_succ, mul_inv_rev]; group
    rw [hstep, ih]
    have h2 : r⁻¹ * c ^ (k ^ m) * r = ((MulAut.conj r⁻¹) c) ^ (k ^ m) := by
      rw [← map_zpow (MulAut.conj r⁻¹) c (k ^ m), MulAut.conj_apply, inv_inv]
    have h3 : (MulAut.conj r⁻¹) c = c ^ k := by
      rw [MulAut.conj_apply, inv_inv, hk]
    rw [h2, h3, ← zpow_mul]
    congr 1
    rw [pow_succ]; ring

/-- Frobenius: `k ^ (p ^ N) ≡ k (mod p)` for a prime `p`. -/
lemma int_modEq_pow_prime_pow {p : ℕ} (hp : p.Prime) (k : ℤ) (N : ℕ) :
    k ^ (p ^ N) ≡ k [ZMOD (p:ℤ)] := by
  induction N with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, pow_mul]
    exact (ih.pow p).trans (Int.ModEq.pow_prime_eq_self hp k)

/-- If `p ∣ k ^ (p ^ N) - 1` for a prime `p`, then `p ∣ k - 1`. -/
lemma prime_dvd_sub_one_of_dvd_pow_prime_pow_sub_one {p : ℕ} (hp : p.Prime) {k : ℤ} {N : ℕ}
    (h : (p : ℤ) ∣ k ^ (p ^ N) - 1) : (p : ℤ) ∣ k - 1 := by
  have hmod : k ^ (p ^ N) ≡ 1 [ZMOD (p : ℤ)] := by
    rw [Int.modEq_iff_dvd]
    rw [show (1 : ℤ) - k ^ (p^N) = -(k^(p^N) - 1) by ring]
    exact dvd_neg.mpr h
  have hk1 : k ≡ 1 [ZMOD (p:ℤ)] := (int_modEq_pow_prime_pow hp k N).symm.trans hmod
  have h' : (p:ℤ) ∣ -(1 - k) := dvd_neg.mpr (Int.modEq_iff_dvd.mp hk1)
  rwa [neg_sub] at h'

theorem exists_pow_eq_one_add_mul_p {X : Type*} [Group X] {p n : ℕ} (hp : p.Prime)
    {c r : X} (hc : orderOf c = p ^ n) (hconj : r⁻¹ * c * r ∈ Subgroup.zpowers c)
    (hexp : ∃ N : ℕ, (r ^ p ^ N)⁻¹ * c * (r ^ p ^ N) = c) :
    ∃ m : ℕ, r⁻¹ * c * r = c ^ (1 + m * p) := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · -- `n = 0`: then `c = 1` and the claim is trivial.
    rw [hn, pow_zero] at hc
    have hc1 : c = 1 := orderOf_eq_one_iff.mp hc
    subst hc1
    exact ⟨0, by simp⟩
  obtain ⟨N, hN⟩ := hexp
  obtain ⟨k, hk'⟩ := Subgroup.mem_zpowers_iff.mp hconj
  have hk : r⁻¹ * c * r = c ^ k := hk'.symm
  have hfc : IsOfFinOrder c := by
    rw [isOfFinOrder_iff_pow_eq_one]
    exact ⟨p ^ n, pow_pos hp.pos n, by rw [← hc]; exact pow_orderOf_eq_one c⟩
  -- Conjugation by `r ^ (p ^ N)` fixes `c`, whence `c ^ (k ^ (p ^ N)) = c`.
  have hpow := conj_pow_eq hk (p ^ N)
  rw [hN] at hpow
  have hmod : k ^ (p ^ N) ≡ 1 [ZMOD (orderOf c : ℤ)] := by
    refine zpow_eq_zpow_iff_modEq.mp ?_
    rw [zpow_one]
    exact hpow.symm
  -- Hence `p ^ n ∣ k ^ (p ^ N) - 1`, and so `p ∣ k ^ (p ^ N) - 1`.
  have hdiv : ((p ^ n : ℕ) : ℤ) ∣ k ^ (p ^ N) - 1 := by
    have h1 := Int.modEq_iff_dvd.mp hmod
    rw [hc] at h1
    have h2 : ((p ^ n : ℕ) : ℤ) ∣ -(1 - k ^ (p ^ N)) := dvd_neg.mpr h1
    rwa [neg_sub] at h2
  have hpdiv : (p : ℤ) ∣ k ^ (p ^ N) - 1 := by
    refine dvd_trans ?_ hdiv
    rw [Int.natCast_dvd_natCast]
    exact dvd_pow_self p (by omega)
  -- Frobenius gives `p ∣ k - 1`.
  have hkpd : (p : ℤ) ∣ k - 1 := prime_dvd_sub_one_of_dvd_pow_prime_pow_sub_one hp hpdiv
  obtain ⟨t, ht⟩ := hkpd
  -- `c⁻¹ * (r⁻¹ * c * r) = c ^ (k - 1) = (c ^ p) ^ t`.
  have hd : c⁻¹ * (r⁻¹ * c * r) = (c ^ p) ^ t := by
    rw [hk, ← zpow_neg_one c, ← zpow_add]
    have hkt : (-1 : ℤ) + k = (p : ℤ) * t := by
      have : k - 1 = (p : ℤ) * t := ht
      linarith
    rw [hkt, zpow_mul, zpow_natCast]
  have hmem : c⁻¹ * (r⁻¹ * c * r) ∈ Subgroup.zpowers (c ^ p) := by
    rw [hd]
    exact Subgroup.mem_zpowers_iff.mpr ⟨t, rfl⟩
  -- `c ^ p` has finite order, so this integer power is a natural power.
  obtain ⟨m, hm⟩ := exists_pow_eq_of_mem_zpowers (hfc.pow) hmem
  refine ⟨m, ?_⟩
  have hr : r⁻¹ * c * r = c * (c ^ p) ^ m := by
    rw [hm]; group
  have hcp : c * (c ^ p) ^ m = c ^ (1 + m * p) := by
    rw [← pow_mul, ← pow_succ']
    congr 1
    ring
  rw [hr, hcp]

end Work.PGroup.Symplectic
