/-!
# `Ω₁` of a subgroup, and the `p`-socle of the centre of a finite `p`-group

This module provides the small amount of "`Ω₁" technology needed for the construction of
Thompson's critical subgroups.

For a subgroup `A` of a group `H` we let `omega1 p A` be the subgroup generated by the elements
of `A` whose `p`-th power is trivial.  When `A` is abelian this is exactly the set of such
elements, and it is an elementary abelian subgroup.

The main point of the file is `inf_omega1_center_ne_bot`: in a finite `p`-group `M`, every
nontrivial normal subgroup meets `Ω₁(Z(M))`.  This is the "normality-large" property of the
`p`-socle of the centre, and it is the key ingredient in the proof that `C_M(C) ≤ C` for the
critical subgroup `C` built in `Work.PGroup.exists_characteristic_critical`.
-/

set_option linter.style.haveILetI false

open Subgroup

namespace Work.PGroup

variable {H : Type*} [Group H]

/-- `Ω₁(A)`: the subgroup of `H` generated by the elements of `A` whose `p`-th power is `1`. -/
def omega1 (H : Type*) [Group H] (p : ℕ) (A : Subgroup H) : Subgroup H :=
  Subgroup.closure {x : H | x ∈ A ∧ x ^ p = 1}

theorem omega1_le (p : ℕ) (A : Subgroup H) : omega1 H p A ≤ A := by
  rw [omega1, Subgroup.closure_le]
  rintro x ⟨hx, -⟩
  exact hx

theorem omega1_subset (p : ℕ) {A : Subgroup H} {x : H} (hx : x ∈ A) (hx1 : x ^ p = 1) :
    x ∈ omega1 H p A :=
  Subgroup.subset_closure ⟨hx, hx1⟩

theorem omega1_mem_and_pow {p : ℕ} {A : Subgroup H} (hA : IsMulCommutative A) {x : H}
    (hx : x ∈ omega1 H p A) : x ∈ A ∧ x ^ p = 1 := by
  induction hx using Subgroup.closure_induction with
  | mem y hy => exact hy
  | one => exact ⟨A.one_mem, one_pow p⟩
  | mul a b _ _ iha ihb =>
      refine ⟨A.mul_mem iha.1 ihb.1, ?_⟩
      rw [Commute.mul_pow (show Commute a b from setLike_mul_comm (s := A) iha.1 ihb.1), iha.2,
        ihb.2, one_mul]
  | inv a _ iha => exact ⟨A.inv_mem iha.1, by rw [inv_pow, iha.2, inv_one]⟩

theorem omega1_pow_eq_one {p : ℕ} {A : Subgroup H} (hA : IsMulCommutative A) {x : H}
    (hx : x ∈ omega1 H p A) : x ^ p = 1 :=
  (omega1_mem_and_pow hA hx).2

theorem omega1_isMulCommutative {p : ℕ} {A : Subgroup H} (hA : IsMulCommutative A) :
    IsMulCommutative (omega1 H p A) := by
  refine isMulCommutative_iff.mpr fun x y => Subtype.ext ?_
  exact setLike_mul_comm (s := A) (omega1_le p A x.2) (omega1_le p A y.2)

theorem omega1_mono {p : ℕ} {A B : Subgroup H} (h : A ≤ B) : omega1 H p A ≤ omega1 H p B := by
  rw [omega1, omega1, Subgroup.closure_le]
  rintro x ⟨hxA, hx1⟩
  exact omega1_subset p (h hxA) hx1

theorem omega1_characteristic (p : ℕ) {A : Subgroup H} (hA : A.Characteristic) :
    (omega1 H p A).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro φ
  rw [omega1, MonoidHom.map_closure]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨y, ⟨hyA, hy1⟩, rfl⟩
    refine ⟨?_, ?_⟩
    · have h1 : y ∈ A.comap φ.toMonoidHom := by rw [hA.fixed φ]; exact hyA
      exact h1
    · rw [← map_pow, hy1, map_one]
  · rintro ⟨hx, hx1⟩
    refine ⟨φ.symm x, ⟨?_, ?_⟩, by simp⟩
    · have h1 : φ.symm x ∈ A.comap φ.toMonoidHom := by
        show φ (φ.symm x) ∈ A
        rw [MulEquiv.apply_symm_apply]
        exact hx
      rwa [hA.fixed φ] at h1
    · rw [← map_pow, hx1, map_one]

/-- In a finite `p`-group, every nontrivial normal subgroup meets `Ω₁` of the centre. -/
theorem inf_omega1_center_ne_bot {M : Type*} [Group M] [Finite M] {p : ℕ} (hp : p.Prime)
    (hM : IsPGroup p M) {N : Subgroup M} (hNnorm : N.Normal) (hN : N ≠ ⊥) :
    N ⊓ omega1 M p (Subgroup.center M) ≠ ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Group.IsNilpotent M := hM.isNilpotent
  haveI := hNnorm
  have h1 : N ⊓ Subgroup.center M ≠ ⊥ := Group.IsNilpotent.inf_center_ne_bot_of_normal hN
  obtain ⟨x, hxne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp h1
  obtain ⟨hxN, hxZ⟩ := Subgroup.mem_inf.mp x.2
  have hxMne : (x : M) ≠ 1 := fun h => hxne (Subtype.ext h)
  obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp hM) (x : M)
  have hk0 : k ≠ 0 := by
    rintro rfl
    refine hxMne ?_
    rw [← pow_one (x : M), ← pow_zero p, ← hk]
    exact pow_orderOf_eq_one _
  obtain ⟨k', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk0
  refine Subgroup.ne_bot_iff_exists_ne_one.mpr ⟨⟨(x : M) ^ p ^ k', ?_⟩, ?_⟩
  · refine Subgroup.mem_inf.mpr ⟨N.pow_mem hxN _, ?_⟩
    exact omega1_subset p ((Subgroup.center M).pow_mem hxZ _)
      (by rw [← pow_mul, ← pow_succ, ← hk, pow_orderOf_eq_one])
  · intro hcontra
    have hval : (x : M) ^ p ^ k' = 1 := congrArg Subtype.val hcontra
    have hdvd : orderOf (x : M) ∣ p ^ k' := orderOf_dvd_iff_pow_eq_one.mpr hval
    rw [hk] at hdvd
    exact (Nat.not_dvd_of_pos_of_lt (pow_pos hp.pos k')
      (Nat.pow_lt_pow_succ (a := p) (n := k') hp.one_lt)) hdvd

end Work.PGroup
