import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `Work.PGroup` : the p-group toolkit for the Feit–Thompson odd order theorem

This is the base module of area **A4** of the Feit–Thompson drive.  It fixes the vocabulary in
which every later p-group statement of the project is phrased.

## Conventions

* `G` is the ambient group; almost all definitions make sense for an arbitrary group, so we only
  assume `[Group G]` here (finiteness hypotheses appear in the statements that need them).
* Subgroups are always subgroups of the *ambient* group `G`.  A statement such as "`Ω₁(P)` is
  characteristic in `P`" is therefore phrased as invariance of `omega p i P` under conjugation
  by elements of `Subgroup.normalizer P` (see e.g. `Work.PGroup.omega_conj`).
* `IsElementaryAbelian p E` means that `E` is commutative and every element of `E` has order
  dividing `p` (so for `p` prime, `E` is an elementary abelian `p`-group in the usual sense).
* The `p`-rank `mRank p G` is the maximum of the minimal number of generators of an elementary
  abelian `p`-subgroup of `G`.

## Main definitions

* `Work.PGroup.omega`, `Work.PGroup.agemo` : the subgroups `Ωᵢ(P)` and `℧ⁱ(P)`.
* `Work.PGroup.centerIn`, `Work.PGroup.frattiniIn` : `Z(P)` and `Φ(P)` as subgroups of `G`.
* `Work.PGroup.IsElementaryAbelian`, `Work.PGroup.mRank`, `Work.PGroup.mRankIn`.
* `Work.PGroup.IsSpecial`, `Work.PGroup.IsExtraspecial`.
* `Work.PGroup.maxAbelianOrder`, `Work.PGroup.thompsonJ`, `Work.PGroup.ZJ`.
* `Work.PGroup.IsCriticalSubgroup` (Thompson's critical subgroups).
* `Work.PGroup.IsCentralProduct`.

## References

* W. Feit, J. G. Thompson, *Solvability of groups of odd order*, Pacific J. Math. **13** (1963),
  775–1029 (cited as FT), §2 (notation), §3 (quoted results), Chapter II §8 (Lemmas 8.1–8.3).
* D. Gorenstein, *Finite Groups*, §5.3 (critical subgroups, Thompson subgroup).
-/

set_option linter.unusedVariables false

open scoped Classical Pointwise
open Subgroup

noncomputable section

namespace Work.PGroup

variable {G : Type*} [Group G]

/-- Conjugation of a subgroup by a group element, i.e. the pointwise action of `MulAut.conj g`.
This is definitionally `MulAut.conj g • H`; it is provided so that statements below do not depend
on the `Pointwise` scoped instances being open in the calling file. -/
abbrev conjBy (g : G) (H : Subgroup G) : Subgroup G := MulAut.conj g • H

/-! ### The omega and agemo subgroups -/

/-- `omega p i P = Ωᵢ(P)`: the subgroup of the ambient group generated by the elements of `P`
whose order divides `p ^ i` (FT §2: "the subgroup of the p-group X generated by the elements
of order at most `p ^ n`"). -/
def omega (p i : ℕ) (P : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ P ∧ x ^ (p ^ i) = 1}

/-- `agemo p i P = ℧ⁱ(P)`: the subgroup of the ambient group generated by the `p ^ i`-th powers
of elements of `P` (FT §2: "the subgroup of the p-group X generated by the `p ^ n`-th powers of
elements of X"). -/
def agemo (p i : ℕ) (P : Subgroup G) : Subgroup G :=
  Subgroup.closure {y : G | ∃ x ∈ P, x ^ (p ^ i) = y}

/-- The center of a subgroup, regarded as a subgroup of the ambient group `G`. -/
def centerIn (H : Subgroup G) : Subgroup G := (Subgroup.center ↥H).map H.subtype

/-- The Frattini subgroup of a subgroup, regarded as a subgroup of the ambient group `G`. -/
def frattiniIn (H : Subgroup G) : Subgroup G := (frattini ↥H).map H.subtype

/-! ### Elementary abelian subgroups and the p-rank -/

/-- `E` is elementary abelian of exponent `p`: it is commutative and every one of its elements
has order dividing `p`.  For `p` prime this is the usual notion of an elementary abelian
`p`-group (of exponent `p` or trivial); FT §2. -/
def IsElementaryAbelian (p : ℕ) (E : Subgroup G) : Prop :=
  IsMulCommutative E ∧ ∀ x : E, x ^ p = 1

/-- The `p`-rank `mRank p G` of a finite group `G`: the maximum of `Group.rank E` (the minimal
number of generators of `E`) over the elementary abelian `p`-subgroups `E ≤ G`.  This is FT's
`m_p(G)` (`m(X)` = minimal number of generators, `m_p(X) = m(𝔓)` for a Sylow `p`-subgroup). -/
noncomputable def mRank (p : ℕ) (G : Type*) [Group G] [Finite G] : ℕ :=
  sSup {n : ℕ | ∃ E : Subgroup G, IsElementaryAbelian p E ∧ Group.rank E = n}

/-- The `p`-rank of a subgroup, as a subgroup of the ambient group. -/
noncomputable def mRankIn (p : ℕ) (P : Subgroup G) [Finite P] : ℕ := mRank p ↥P

/-! ### Special and extraspecial p-groups -/

/-- A *special* `p`-group (FT §2): an elementary abelian `p`-group, or a non-abelian `p`-group
whose center, derived subgroup and Frattini subgroup coincide and are elementary abelian. -/
def IsSpecial (p : ℕ) (P : Subgroup G) : Prop :=
  IsElementaryAbelian p P ∨
    (IsPGroup p P ∧ ¬ IsMulCommutative P ∧ centerIn P = ⁅P, P⁆ ∧
      centerIn P = frattiniIn P ∧ IsElementaryAbelian p (centerIn P))

/-- An *extraspecial* `p`-group (FT §2): a non-abelian special `p`-group whose center has
order `p`. -/
def IsExtraspecial (p : ℕ) (P : Subgroup G) : Prop :=
  ¬ IsMulCommutative P ∧ IsSpecial p P ∧ Nat.card (centerIn P) = p

/-! ### The Thompson subgroup -/

/-- The maximal order of an abelian subgroup of `P`. -/
noncomputable def maxAbelianOrder (P : Subgroup G) : ℕ :=
  sSup {n : ℕ | ∃ A : Subgroup G, A ≤ P ∧ IsMulCommutative A ∧ Nat.card A = n}

/-- The Thompson subgroup `J(P)`: the subgroup generated by the abelian subgroups of `P` of
maximal order (FT 3.4–3.5 / Gorenstein §5.3; B–G App. B uses the Puig subgroup in its place). -/
noncomputable def thompsonJ (P : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | ∃ A : Subgroup G, A ≤ P ∧ IsMulCommutative A ∧
    Nat.card A = maxAbelianOrder P ∧ x ∈ A}

/-- `ZJ(P) = Z(J(P))`, the center of the Thompson subgroup of `P`. -/
noncomputable def ZJ (P : Subgroup G) : Subgroup G := centerIn (thompsonJ P)

/-! ### Thompson's critical subgroups -/

/-- A *critical subgroup* of a `p`-group `P` in the sense of FT Lemma 8.2 (see also Gorenstein,
*Finite Groups*, Theorem 5.3.11): a nontrivial subgroup `C ≤ P`, characteristic in `P`, of
nilpotency class at most two with `C / Z(C)` elementary abelian, satisfying `[P, C] ≤ Z(C)` and
`C_P(C) ≤ C` (equivalently `C_P(C) = Z(C)`).

The condition that `p'`-automorphisms of `P` act faithfully on `C` (FT 8.2 (ii)) is not part of
the structure; it is recovered in
`Work.PGroup.IsCriticalSubgroup.isPGroup_normalizer_inf_centralizer`. -/
structure IsCriticalSubgroup (p : ℕ) (P C : Subgroup G) : Prop where
  /-- `C` is a subgroup of `P`. -/
  le_self : C ≤ P
  /-- `C` is nontrivial. -/
  ne_bot : C ≠ ⊥
  /-- `C` is characteristic in `P`: it is invariant under every element of `N_G(P)`. -/
  characteristic : ∀ g : G, g ∈ Subgroup.normalizer P → conjBy g C = C
  /-- `C` is Frattini-in-center: `Φ(C) ≤ Z(C)`.  Since `C` is a `p`-group this is equivalent to
  saying that `C` has nilpotency class at most two and `C / Z(C)` is elementary abelian. -/
  frattini_le_center : frattiniIn C ≤ centerIn C
  /-- `C` is commutator-in-center: `[P, C] ≤ Z(C)`. -/
  commutator_le_center : ⁅P, C⁆ ≤ centerIn C
  /-- `C` is self-centralizing in `P`: `C_P(C) ≤ C`. -/
  self_centralizing : P ⊓ Subgroup.centralizer (C : Set G) ≤ C

/-! ### Central products -/

/-- `P` is the internal central product of its subgroups `A` and `B`: `P = A * B`, `A` and `B`
commute elementwise, and `A ∩ B` is central in both (FT 3.5). -/
def IsCentralProduct (P A B : Subgroup G) : Prop :=
  A ≤ P ∧ B ≤ P ∧ A ⊔ B = P ∧ ⁅A, B⁆ = ⊥ ∧
    A ⊓ B ≤ centerIn A ∧ A ⊓ B ≤ centerIn B

/-! ### Elementary API -/

theorem subset_omega {p i : ℕ} {P : Subgroup G} {x : G} (hx : x ∈ P) (hx1 : x ^ (p ^ i) = 1) :
    x ∈ omega p i P :=
  Subgroup.subset_closure ⟨hx, hx1⟩

theorem pow_mem_agemo {p i : ℕ} {P : Subgroup G} {x : G} (hx : x ∈ P) :
    x ^ (p ^ i) ∈ agemo p i P :=
  Subgroup.subset_closure ⟨x, hx, rfl⟩

theorem omega_le (p i : ℕ) (P : Subgroup G) : omega p i P ≤ P := by
  rw [omega, Subgroup.closure_le]
  rintro x ⟨hx, -⟩
  exact hx

theorem agemo_le (p i : ℕ) (P : Subgroup G) : agemo p i P ≤ P := by
  rw [agemo, Subgroup.closure_le]
  rintro y ⟨x, hx, rfl⟩
  exact P.pow_mem hx _

theorem omega_mono {p i : ℕ} {P Q : Subgroup G} (h : P ≤ Q) : omega p i P ≤ omega p i Q := by
  rw [omega, Subgroup.closure_le]
  rintro x ⟨hx, hx1⟩
  exact Subgroup.subset_closure ⟨h hx, hx1⟩

theorem agemo_mono {p i : ℕ} {P Q : Subgroup G} (h : P ≤ Q) : agemo p i P ≤ agemo p i Q := by
  rw [agemo, Subgroup.closure_le]
  rintro y ⟨x, hx, rfl⟩
  exact Subgroup.subset_closure ⟨x, h hx, rfl⟩

theorem centerIn_le (H : Subgroup G) : centerIn H ≤ H :=
  Subgroup.map_subtype_le _

theorem frattiniIn_le (H : Subgroup G) : frattiniIn H ≤ H :=
  Subgroup.map_subtype_le _

theorem IsElementaryAbelian.comm {p : ℕ} {E : Subgroup G} (h : IsElementaryAbelian p E) :
    IsMulCommutative E := h.1

theorem IsElementaryAbelian.pow_eq_one {p : ℕ} {E : Subgroup G} (h : IsElementaryAbelian p E)
    (x : E) : x ^ p = 1 := h.2 x

theorem IsElementaryAbelian.mul_comm {p : ℕ} {E : Subgroup G} (h : IsElementaryAbelian p E)
    (x y : E) : x * y = y * x := isMulCommutative_iff.mp h.1 x y

theorem IsElementaryAbelian.isPGroup {p : ℕ} {E : Subgroup G} (h : IsElementaryAbelian p E) :
    IsPGroup p E :=
  isPGroup_iff_pow_pow_eq_one.2 fun x => ⟨1, by simpa using h.pow_eq_one x⟩

theorem IsElementaryAbelian.mono {p : ℕ} {E F : Subgroup G} (hF : IsElementaryAbelian p F)
    (h : E ≤ F) : IsElementaryAbelian p E := by
  constructor
  · refine isMulCommutative_iff.mpr fun x y => Subtype.ext ?_
    simpa using congrArg Subtype.val (hF.mul_comm ⟨x, h x.2⟩ ⟨y, h y.2⟩)
  · intro x
    refine Subtype.ext ?_
    simpa using congrArg Subtype.val (hF.pow_eq_one ⟨x, h x.2⟩)

theorem isElementaryAbelian_bot (p : ℕ) : IsElementaryAbelian p (⊥ : Subgroup G) :=
  ⟨IsMulCommutative.of_comm (fun a b => Subsingleton.elim _ _),
    fun x => Subsingleton.elim _ _⟩

variable {p i : ℕ} {P : Subgroup G} in
theorem omega_zero : omega p 0 P = ⊥ := by
  rw [omega, Subgroup.eq_bot_iff_forall]
  intro x hx
  rw [Subgroup.mem_closure] at hx
  exact hx ⊥ (by rintro y ⟨hy, hy1⟩; simpa using hy1)

variable {p i : ℕ} {P : Subgroup G} in
theorem agemo_zero : agemo p 0 P = P := by
  rw [agemo]
  refine le_antisymm (agemo_le p 0 P) fun x hx => ?_
  refine Subgroup.subset_closure ⟨x, hx, ?_⟩
  simp

theorem le_thompsonJ {P A : Subgroup G} (hA : A ≤ P) (hab : IsMulCommutative A)
    (hcard : Nat.card A = maxAbelianOrder P) : A ≤ thompsonJ P :=
  fun x hx => Subgroup.subset_closure ⟨A, hA, hab, hcard, hx⟩

theorem thompsonJ_le (P : Subgroup G) : thompsonJ P ≤ P := by
  rw [thompsonJ, Subgroup.closure_le]
  rintro x ⟨A, hA, -, -, hx⟩
  exact hA hx

theorem ZJ_le_thompsonJ (P : Subgroup G) : ZJ P ≤ thompsonJ P := centerIn_le _

theorem IsExtraspecial.noncomm {p : ℕ} {P : Subgroup G} (h : IsExtraspecial p P) :
    ¬ IsMulCommutative P := h.1

theorem IsExtraspecial.center_card {p : ℕ} {P : Subgroup G} (h : IsExtraspecial p P) :
    Nat.card (centerIn P) = p := h.2.2

theorem IsExtraspecial.isSpecial {p : ℕ} {P : Subgroup G} (h : IsExtraspecial p P) :
    IsSpecial p P := h.2.1

theorem IsCentralProduct.comm {P A B : Subgroup G} (h : IsCentralProduct P A B) : ⁅A, B⁆ = ⊥ :=
  h.2.2.2.1

theorem IsCentralProduct.le_left {P A B : Subgroup G} (h : IsCentralProduct P A B) : A ≤ P := h.1

theorem IsCentralProduct.le_right {P A B : Subgroup G} (h : IsCentralProduct P A B) : B ≤ P := h.2.1

theorem IsCentralProduct.eq_sup {P A B : Subgroup G} (h : IsCentralProduct P A B) :
    A ⊔ B = P := h.2.2.1

end Work.PGroup
