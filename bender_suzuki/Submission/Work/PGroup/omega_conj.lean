/-!
# `Ωᵢ(P)` is characteristic in `P`

`Work.PGroup.omega p i P` is the subgroup of `G` generated by the elements of `P` whose order
divides `p ^ i`.  It is plainly invariant under conjugation by an element `g` of the normalizer
of `P`, because conjugation by `g` is an automorphism of `G`, it maps `P` to itself for
`g ∈ N_G(P)`, and it preserves powers.  This file records that invariance; it is the formal
content of the phrase "`Ωᵢ(P)` is characteristic in `P`" used throughout the Feit–Thompson
development.
-/

open scoped Classical Pointwise
open Subgroup

noncomputable section

namespace Work.PGroup

variable {G : Type*} [Group G]

/-- Conjugation commutes with taking powers: `(g x g⁻¹)ⁿ = g xⁿ g⁻¹`. -/
private lemma conj_smul_pow (g x : G) (n : ℕ) :
    (MulAut.conj g • x) ^ n = MulAut.conj g • (x ^ n) := by
  show (MulAut.conj g x) ^ n = MulAut.conj g (x ^ n)
  rw [map_pow]

/-- The inverse conjugation commutes with taking powers. -/
private lemma inv_conj_smul_pow (g x : G) (n : ℕ) :
    ((MulAut.conj g)⁻¹ • x) ^ n = (MulAut.conj g)⁻¹ • (x ^ n) := by
  show ((MulAut.conj g)⁻¹ x) ^ n = (MulAut.conj g)⁻¹ (x ^ n)
  rw [map_pow]

/-- The conjugation action of `MulAut.conj g` on `G` is `x ↦ g * x * g⁻¹`. -/
private lemma conj_smul_eq (g x : G) : MulAut.conj g • x = g * x * g⁻¹ := by
  show MulAut.conj g x = g * x * g⁻¹
  rw [MulAut.conj_apply]

/-- The inverse conjugation action of `MulAut.conj g` on `G` is `x ↦ g⁻¹ * x * g`. -/
private lemma inv_conj_smul_eq (g x : G) : (MulAut.conj g)⁻¹ • x = g⁻¹ * x * g := by
  have h : (MulAut.conj g)⁻¹ = MulAut.conj g⁻¹ := by ext y; simp
  rw [h]
  show MulAut.conj g⁻¹ x = g⁻¹ * x * g
  rw [MulAut.conj_apply, inv_inv]

theorem omega_conj {G : Type*} [Group G] (p i : ℕ) (P : Subgroup G) (g : G)
    (hg : g ∈ Subgroup.normalizer (P : Set G)) :
    Work.PGroup.conjBy g (Work.PGroup.omega p i P) = Work.PGroup.omega p i P := by
  -- The generating set `{x ∈ P | x ^ (p ^ i) = 1}` is stable under conjugation by any
  -- element of the normalizer of `P`.
  have key : ∀ h : G, h ∈ Subgroup.normalizer (P : Set G) →
      (MulAut.conj h) • ({x : G | x ∈ P ∧ x ^ (p ^ i) = 1} : Set G) =
        {x : G | x ∈ P ∧ x ^ (p ^ i) = 1} := by
    intro h hh
    ext y
    rw [Set.mem_smul_set]
    constructor
    · rintro ⟨x, ⟨hxP, hx1⟩, hxy⟩
      rw [← hxy]
      refine ⟨?_, ?_⟩
      · rw [conj_smul_eq]; exact (Subgroup.mem_normalizer_iff.mp hh x).mp hxP
      · rw [conj_smul_pow, hx1]; exact map_one _
    · intro hy
      refine ⟨(MulAut.conj h)⁻¹ • y, ⟨?_, ?_⟩, smul_inv_smul _ y⟩
      · rw [inv_conj_smul_eq]
        simpa using (Subgroup.mem_normalizer_iff.mp
          ((Subgroup.normalizer (P : Set G)).inv_mem hh) y).mp hy.1
      · rw [inv_conj_smul_pow, hy.2]; exact map_one _
  -- Conjugation turns the closure into the closure of the conjugated generating set.
  show MulAut.conj g • Subgroup.closure ({x : G | x ∈ P ∧ x ^ (p ^ i) = 1} : Set G)
      = Subgroup.closure ({x : G | x ∈ P ∧ x ^ (p ^ i) = 1} : Set G)
  rw [Subgroup.smul_closure, key g hg]

end Work.PGroup
