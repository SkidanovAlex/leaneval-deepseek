namespace Work.PGroup

/-- If `P` is commutative then an abelian subgroup of `P` of maximal order is `P` itself: the
maximal order of an abelian subgroup of `P` equals `|P|`.  Indeed `P` is itself such an abelian
subgroup, and no subgroup of a finite group has larger cardinality than the group. -/
theorem maxAbelianOrder_eq_card_of_commutative {G : Type*} [Group G] (P : Subgroup G) [Finite P]
    (hP : IsMulCommutative P) : maxAbelianOrder P = Nat.card P := by
  apply le_antisymm
  · rw [maxAbelianOrder]
    refine csSup_le ⟨Nat.card P, P, le_rfl, hP, rfl⟩ ?_
    rintro n ⟨A, hA, -, rfl⟩
    exact Subgroup.card_le_of_le hA
  · rw [maxAbelianOrder]
    refine le_csSup ?_ ⟨P, le_rfl, hP, rfl⟩
    exact ⟨Nat.card P, fun n hn => by
      obtain ⟨A, hA, -, rfl⟩ := hn
      exact Subgroup.card_le_of_le hA⟩

/-- `J(P) = P` for a commutative finite subgroup `P`: the Thompson subgroup of `P` is generated by
the abelian subgroups of `P` of maximal order, and when `P` is commutative `P` itself is such a
subgroup, so `P ≤ J(P)`; the reverse inclusion always holds. -/
theorem thompsonJ_eq_of_commutative {G : Type*} [Group G] (P : Subgroup G) [Finite P]
    (hP : IsMulCommutative P) : Work.PGroup.thompsonJ P = P := by
  refine le_antisymm (thompsonJ_le P) ?_
  exact le_thompsonJ le_rfl hP (maxAbelianOrder_eq_card_of_commutative P hP).symm

end Work.PGroup
