/-!
# `Φ(P) = P^p [P,P]` for a finite `p`-group

For a finite `p`-group `P`, the Frattini subgroup equals the subgroup generated by the `p`-th
powers together with the derived subgroup.  This is the group-theoretic core of Burnside's basis
theorem: `P / Φ(P)` is the largest elementary abelian quotient of `P`, and it is realised by
`P / (P^p [P,P])`.

In the vocabulary of `Work.PGroup` (subgroups of an ambient group `G`) the statement reads
`Φ(P) = ℧¹(P) ⊔ ⁅P, P⁆`, where `agemo p 1 P` is `℧¹(P) = P^p` and `⁅P, P⁆` is the derived
subgroup.

## Proof

Work inside `H := ↥P`, a finite group of order a power of `p`.  Let `K` be the subgroup generated
by the `p`-th powers and `C = ⁅⊤, ⊤⁆` the derived subgroup.

* `K ⊔ C ≤ Φ(H)`: every maximal subgroup `M` of a finite `p`-group has index `p`
  (`Work.PGroup.isCoatom_index_eq_prime`), so `H ⧸ M` is (cyclic) of order `p`; hence it is abelian
  and of exponent `p`, giving `C ≤ M` and `K ≤ M`.  As `Φ(H)` is the intersection of the maximal
  subgroups, `K ⊔ C ≤ Φ(H)`.
* `Φ(H) ≤ K ⊔ C`: since `H ⧸ (K ⊔ C)` is a finite elementary abelian `p`-group, any `x ∉ K ⊔ C`
  is avoided by some maximal subgroup of `H`
  (`Work.PGroup.exists_isCoatom_notMem_of_normal`), so `x ∉ Φ(H)`.

Both containments are proved at the level of `H := ↥P` and transported to `G` along `P.subtype`.
-/

set_option linter.style.haveILetI false

open Subgroup
open scoped Classical Pointwise

namespace Work.PGroup

/-- The subgroup generated by the `p`-th powers of a group is normal (it is conjugation-stable
because `g x^p g⁻¹ = (g x g⁻¹)^p`). -/
theorem powClosure_normal {H : Type*} [Group H] (p : ℕ) :
    (Subgroup.closure (Set.range fun x : H => x ^ p)).Normal := by
  refine ⟨fun n hn g => ?_⟩
  induction hn using Subgroup.closure_induction with
  | mem y hy =>
      obtain ⟨z, rfl⟩ := hy
      change g * z ^ p * g⁻¹ ∈ Subgroup.closure (Set.range fun x : H => x ^ p)
      rw [← conj_pow]
      exact Subgroup.subset_closure ⟨g * z * g⁻¹, rfl⟩
  | one => simp
  | mul a b _ _ iha ihb =>
      rw [show g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) by group]
      exact mul_mem iha ihb
  | inv a _ iha =>
      rw [show g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ by group]
      exact inv_mem iha

/-- For a finite `p`-group `H`, the Frattini subgroup is generated by the `p`-th powers and the
derived subgroup. -/
theorem frattini_eq_powClosure_sup_commutator {H : Type*} [Group H] [Finite H] {p : ℕ}
    (hp : p.Prime) (hH : IsPGroup p H) :
    frattini H = Subgroup.closure (Set.range fun x : H => x ^ p) ⊔ ⁅(⊤ : Subgroup H), ⊤⁆ := by
  haveI : Fact p.Prime := ⟨hp⟩
  set K : Subgroup H := Subgroup.closure (Set.range fun x : H => x ^ p) with hK
  set C : Subgroup H := ⁅(⊤ : Subgroup H), ⊤⁆ with hC
  have hKnormal : K.Normal := by rw [hK]; exact powClosure_normal p
  have hCnormal : C.Normal := by rw [hC]; exact commutator_normal ⊤ ⊤
  have hNnormal : (K ⊔ C).Normal := sup_normal K C
  have hnil : Group.IsNilpotent H := hH.isNilpotent
  have hnc : NormalizerCondition H := Group.normalizerCondition_of_isNilpotent
  -- Every maximal subgroup contains `K ⊔ C`.
  have hcoatom : ∀ M : Subgroup H, IsCoatom M → K ⊔ C ≤ M := by
    intro M hM
    have hMnormal : M.Normal := NormalizerCondition.normal_of_coatom M hnc hM
    have hMindex : M.index = p := isCoatom_index_eq_prime hH hM
    have hcard : Nat.card (H ⧸ M) = p := by rw [← Subgroup.index_eq_card]; exact hMindex
    have hcommq : IsMulCommutative (H ⧸ M) := (isCyclic_of_prime_card hcard).isMulCommutative
    have mem_of_mk : ∀ y : H, (QuotientGroup.mk' M) y = 1 → y ∈ M := by
      intro y hy
      have : y ∈ (QuotientGroup.mk' M).ker := (MonoidHom.mem_ker).mpr hy
      rwa [QuotientGroup.ker_mk'] at this
    refine sup_le ?_ ?_
    · rw [hK, Subgroup.closure_le]
      rintro y ⟨x, rfl⟩
      refine mem_of_mk _ ?_
      rw [map_pow, ← orderOf_dvd_iff_pow_eq_one, ← hcard]
      exact orderOf_dvd_natCard _
    · rw [hC, Subgroup.commutator_le]
      intro a _ b _
      refine mem_of_mk _ ?_
      rw [map_commutatorElement]
      exact Commute.commutator_eq (isMulCommutative_iff.mp hcommq _ _)
  refine le_antisymm ?_ ?_
  · -- `Φ(H) ≤ K ⊔ C`
    intro x hx
    by_contra hxN
    have hcomm' : ⁅(⊤ : Subgroup H), ⊤⁆ ≤ K ⊔ C := hC ▸ le_sup_right
    have hpow' : ∀ y : H, y ^ p ∈ K ⊔ C := fun y =>
      Subgroup.mem_sup_left (Subgroup.subset_closure (Set.mem_range_self y))
    obtain ⟨M, hM, hxM⟩ :=
      exists_isCoatom_notMem_of_normal hp (K ⊔ C) hcomm' hpow' hxN
    exact hxM (frattini_le_coatom hM hx)
  · -- `K ⊔ C ≤ Φ(H)`
    rw [frattini, Order.radical]
    refine le_iInf fun M => le_iInf fun hM => hcoatom M ?_
    simpa using hM

/-- **`Φ(P) = ℧¹(P) · [P, P]`.**  For a finite `p`-subgroup `P` of an ambient group `G`, the
Frattini subgroup of `P` (viewed in `G`) is generated by the `p`-th powers of elements of `P`
together with the derived subgroup `⁅P, P⁆`. -/
theorem frattini_eq_agemo_sup_commutator {G : Type*} [Group G] {p : ℕ} (hp : p.Prime)
    (P : Subgroup G) [Finite P] (hP : IsPGroup p P) :
    Work.PGroup.frattiniIn P = Work.PGroup.agemo p 1 P ⊔ ⁅P, P⁆ := by
  have key := frattini_eq_powClosure_sup_commutator (H := ↥P) hp hP
  have h1 : Subgroup.map P.subtype (Subgroup.closure (Set.range fun x : ↥P => x ^ p))
      = Work.PGroup.agemo p 1 P := by
    rw [Work.PGroup.agemo, MonoidHom.map_closure]
    simp only [pow_one]
    congr 1
    ext y
    simp only [Set.mem_image, Set.mem_range, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨z, ⟨w, rfl⟩, hzy⟩
      rw [map_pow] at hzy
      exact ⟨w.1, w.2, hzy⟩
    · rintro ⟨x, hx, hxy⟩
      refine ⟨⟨x, hx⟩ ^ p, ⟨⟨x, hx⟩, rfl⟩, ?_⟩
      rw [map_pow]
      exact hxy
  have h2 : Subgroup.map P.subtype (⁅(⊤ : Subgroup ↥P), ⊤⁆) = ⁅P, P⁆ := by
    rw [Subgroup.map_commutator, Subgroup.map_top, Subgroup.range_subtype]
  have hmain : Subgroup.map P.subtype (frattini ↥P)
      = Subgroup.map P.subtype (Subgroup.closure (Set.range fun x : ↥P => x ^ p))
        ⊔ Subgroup.map P.subtype (⁅(⊤ : Subgroup ↥P), ⊤⁆) := by
    rw [key, Subgroup.map_sup]
  rw [h1, h2] at hmain
  exact hmain

end Work.PGroup
