/-!
# `Z(P) ≤ J(P)`

The centre of a finite subgroup `P` is contained in the Thompson subgroup `J(P)`, the subgroup
generated by the abelian subgroups of `P` of maximal order.

The mathematical content is the following observation.  If `A ≤ P` is an abelian subgroup of
maximal order and `z ∈ Z(P)`, then `z` commutes with every element of `P`, hence with every
element of `A`, so the subgroup `B = ⟨A, z⟩` generated by `A` and `z` is *abelian*.  It is also
contained in `P`, so `|B| ≤ maxAbelianOrder P = |A| ≤ |B|`, and therefore `|B|` is the maximal
order of an abelian subgroup of `P`.  Hence `B ≤ J(P)` by definition of `J(P)`, and `z ∈ B`.

This is the elementary half of the classical fact that the "`ZJ`-data" of `P` (`Z(P)`,
`Z(J(P))`) are well behaved; it is used freely in the Thompson-subgroup arguments of the
Feit–Thompson proof (FT §3, quoted results 3.4–3.5).

## Main result

* `Work.PGroup.centerIn_le_thompsonJ`
-/

set_option linter.style.haveILetI false

open Subgroup

namespace Work.PGroup

open scoped Pointwise

theorem centerIn_le_thompsonJ {G : Type*} [Group G] (P : Subgroup G) [Finite P] :
    Work.PGroup.centerIn P ≤ Work.PGroup.thompsonJ P := by
  intro z hz
  -- an abelian subgroup of `P` of maximal order
  obtain ⟨A, hAP, hAcomm, hAcard⟩ := maxAbelianOrder_attained P
  -- `z` lies in `P` and commutes with every element of `P`
  obtain ⟨zp, hzpcenter, hzpe⟩ := Subgroup.mem_map.mp hz
  have hzpe' : (zp : G) = z := hzpe
  have hzP : z ∈ P := hzpe ▸ zp.2
  have hzcent : ∀ y ∈ (P : Set G), y * z = z * y := by
    intro y hy
    have h := Subgroup.mem_center_iff.mp hzpcenter (⟨y, hy⟩ : ↥P)
    have h' : y * (zp : G) = (zp : G) * y := by
      have := congrArg Subtype.val h
      simpa using this
    rw [hzpe'] at h'
    exact h'
  -- the subgroup generated by `A` and `z`
  set B : Subgroup G := Subgroup.closure ((A : Set G) ∪ {z}) with hBdef
  have hAleB : A ≤ B := fun x hx => Subgroup.subset_closure (Or.inl hx)
  have hzB : z ∈ B := Subgroup.subset_closure (Or.inr rfl)
  have hBP : B ≤ P := by
    rw [hBdef, Subgroup.closure_le]
    rintro x (hx | hx)
    · exact hAP hx
    · rw [Set.mem_singleton_iff] at hx; exact hx ▸ hzP
  -- `B` is abelian: its generators `A ∪ {z}` pairwise commute
  have hBcomm : IsMulCommutative B := by
    rw [hBdef]
    apply Subgroup.isMulCommutative_closure
    intro a ha b hb _
    rw [Set.mem_union] at ha hb
    rcases ha with ha | ha
    · rcases hb with hb | hb
      · exact congrArg Subtype.val (mul_comm' (⟨a, ha⟩ : ↥A) (⟨b, hb⟩ : ↥A))
      · rw [Set.mem_singleton_iff] at hb; subst hb; exact hzcent a (hAP ha)
    · rw [Set.mem_singleton_iff] at ha; subst ha
      rcases hb with hb | hb
      · exact (hzcent b (hAP hb)).symm
      · rw [Set.mem_singleton_iff] at hb; subst hb; rfl
  -- `B` is finite, being a subgroup of the finite group `P`
  have hinj : Function.Injective (fun x : ↥B => (⟨x.1, hBP x.2⟩ : ↥P)) := by
    intro x y h
    exact Subtype.ext (congrArg (fun w : ↥P => (w : G)) h)
  haveI : Finite ↥B := Finite.of_injective (fun x : ↥B => (⟨x.1, hBP x.2⟩ : ↥P)) hinj
  -- `B` is an abelian subgroup of `P` of maximal order
  have hBcard : Nat.card B = maxAbelianOrder P := by
    refine le_antisymm (le_maxAbelianOrder P B hBP hBcomm) ?_
    rw [← hAcard]
    exact Subgroup.card_le_of_le hAleB
  exact le_thompsonJ hBP hBcomm hBcard hzB

end Work.PGroup
