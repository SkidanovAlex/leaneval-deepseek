/-!
# A non-cyclic finite `p`-group has two distinct subgroups of index `p`

Let `Q` be a finite `p`-group which is not cyclic.  Then `Q` has at least two distinct
subgroups of index `p`.

The proof runs through the Frattini subgroup `Φ(Q)`.

* `Q / Φ(Q)` is elementary abelian (commutative of exponent dividing `p`), and by
  Burnside's basis theorem its minimal number of generators equals that of `Q`.
* Since `Q` is not cyclic it cannot be generated by one element, so `Group.rank Q ≥ 2`
  (`isCyclic_of_rank_le_one`), hence `Group.rank (Q / Φ(Q)) ≥ 2`, hence
  `|Q / Φ(Q)| ≥ p ^ 2`.
* Every `p`-th power and every commutator lies in `Φ(Q)`, so
  `exists_isCoatom_notMem_of_normal` produces, for every `x ∉ Φ(Q)`, a maximal subgroup
  avoiding `x`; maximal subgroups of the finite `p`-group `Q` have index `p`
  (`isCoatom_index_eq_prime`).
* Taking `x₁ ∉ Φ(Q)` gives `M₁` with `x₁ ∉ M₁`.  Since `|Q / Φ(Q)| ≥ p^2 > p`, the
  subgroup `Φ(Q)` is strictly contained in `M₁`, so we may pick `x₂ ∈ M₁ \ Φ(Q)`.  The
  maximal subgroup `M₂` avoiding `x₂` is then distinct from `M₁`, and both have index `p`.
-/

set_option linter.style.haveILetI false

open scoped Classical Pointwise
open Subgroup

namespace Work.PGroup

/-- A finite group generated by at most one element is cyclic.  (The rank of a group is the
minimal size of a generating set, so `Group.rank G ≤ 1` means that a single element generates
`G`.) -/
theorem isCyclic_of_rank_le_one {G : Type*} [Group G] [Group.FG G] (h : Group.rank G ≤ 1) :
    IsCyclic G := by
  obtain ⟨S, hcard, hgen⟩ := Group.rank_spec G
  have hSc : S.card ≤ 1 := hcard ▸ h
  haveI : Nonempty G := ⟨1⟩
  obtain ⟨x, hx⟩ := Finset.card_le_one_iff_subset_singleton.mp hSc
  have hle : Subgroup.closure (S : Set G) ≤ Subgroup.zpowers x := by
    rw [Subgroup.closure_le]
    intro y hy
    rw [Finset.mem_coe] at hy
    have hyx : y = x := by simpa using hx hy
    rw [hyx]
    exact Subgroup.mem_zpowers x
  have htop : Subgroup.zpowers x = ⊤ := le_antisymm le_top (hgen ▸ hle)
  exact isCyclic_iff_exists_zpowers_eq_top.mpr ⟨x, htop⟩

theorem two_index_prime_subgroups {Q : Type*} [Group Q] [Finite Q] {p : ℕ}
    (hp : p.Prime) (hQ : IsPGroup p Q) (hnc : ¬ IsCyclic Q) :
    ∃ M₁ M₂ : Subgroup Q, M₁ ≠ M₂ ∧ M₁.index = p ∧ M₂.index = p := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  -- `Q` is not generated by one element, so its rank is at least `2`.
  have hrank2 : 2 ≤ Group.rank Q := by
    by_contra h
    exact hnc (isCyclic_of_rank_le_one (G := Q) (by omega))
  -- The Frattini quotient.
  let A := Q ⧸ frattini Q
  have hAcomm : IsMulCommutative A :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr (commutator_le_frattini hp hQ)
  have hAexp : Monoid.exponent A ∣ p := by
    rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (frattini Q) q
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact pow_mem_frattini hp hQ x
  have hApow : ∀ x : A, x ^ p = 1 := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp hAexp
  have hcommA : ∀ a b : A, a * b = b * a := fun a b => isMulCommutative_iff.mp hAcomm a b
  -- Burnside: the rank of `Q` equals the rank of its Frattini quotient.
  have hrankA : Group.rank A = Group.rank Q :=
    (rank_eq_rank_quotient_frattini (H := Q)).symm
  have hlog2 : 2 ≤ Nat.log p (Nat.card A) := by
    calc 2 ≤ Group.rank Q := hrank2
      _ = Group.rank A := hrankA.symm
      _ ≤ Nat.log p (Nat.card A) := rank_le_log_card_of_pow_eq_one hp hcommA hApow
  have hcardA : p ^ 2 ≤ Nat.card A := by
    haveI : Nonempty A := ⟨1⟩
    exact (Nat.le_log_iff_pow_le hp.one_lt (Nat.card_pos (α := A)).ne').mp hlog2
  -- The index of `Φ(Q)` is `|Q / Φ(Q)| ≥ p^2 > p`.
  have hidxPhi : (frattini Q).index = Nat.card A := Subgroup.index_eq_card (frattini Q)
  have hidxPhi_ge : p ^ 2 ≤ (frattini Q).index := by rw [hidxPhi]; exact hcardA
  -- `Φ(Q) ≠ ⊤`, so there is an element outside it.
  have hPhiNeTop : frattini Q ≠ ⊤ := by
    intro h
    have hle : p ^ 2 ≤ 1 := by
      have hh := hidxPhi_ge
      rw [h, Subgroup.index_top] at hh
      exact hh
    have h4 : 4 ≤ p ^ 2 := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ p ^ 2 := Nat.pow_le_pow_left hp.two_le 2
    omega
  have hnotle_top : ¬ ((⊤ : Subgroup Q) ≤ frattini Q) := by
    intro h
    exact hPhiNeTop (le_antisymm le_top h)
  obtain ⟨x₁, -, hx₁⟩ := Set.not_subset.mp hnotle_top
  -- A maximal subgroup avoiding `x₁`.
  obtain ⟨M₁, hM₁coat, hx₁M₁⟩ :=
    exists_isCoatom_notMem_of_normal hp (frattini Q)
      (commutator_le_frattini hp hQ) (fun x => pow_mem_frattini hp hQ x) hx₁
  have hidx₁ : M₁.index = p := isCoatom_index_eq_prime hQ hM₁coat
  -- `Φ(Q) < M₁`, because `Φ(Q)` has index at least `p^2 > p` while `M₁` has index `p`.
  have hPhiNeM₁ : frattini Q ≠ M₁ := by
    intro h
    have hle : p ^ 2 ≤ p := by
      have hh := hidxPhi_ge
      rw [h, hidx₁] at hh
      exact hh
    have h2p : 2 * p ≤ p ^ 2 := by
      rw [pow_two]
      calc 2 * p = p * 2 := by ring
        _ ≤ p * p := Nat.mul_le_mul_left p hp.two_le
    have hp0 : 0 < p := hp.pos
    have : 2 * p ≤ p := le_trans h2p hle
    omega
  have hnotle : ¬ (M₁ ≤ frattini Q) := by
    intro h
    exact hPhiNeM₁ (le_antisymm (frattini_le_coatom hM₁coat) h)
  obtain ⟨x₂, hx₂M₁, hx₂Phi⟩ := Set.not_subset.mp hnotle
  -- A second maximal subgroup, avoiding the element `x₂ ∈ M₁`.
  obtain ⟨M₂, hM₂coat, hx₂M₂⟩ :=
    exists_isCoatom_notMem_of_normal hp (frattini Q)
      (commutator_le_frattini hp hQ) (fun x => pow_mem_frattini hp hQ x) hx₂Phi
  have hidx₂ : M₂.index = p := isCoatom_index_eq_prime hQ hM₂coat
  exact ⟨M₁, M₂, fun hEq => hx₂M₂ (hEq ▸ hx₂M₁), hidx₁, hidx₂⟩

end Work.PGroup
