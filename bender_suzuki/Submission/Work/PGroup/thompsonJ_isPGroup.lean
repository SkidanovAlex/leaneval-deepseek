namespace Work.PGroup

/-- The Thompson subgroup `J(P)` of a `p`-group `P` is again a `p`-group: it is generated by
subgroups of `P`, hence is contained in `P`, and subgroups of `p`-groups are `p`-groups. -/
theorem thompsonJ_isPGroup {G : Type*} [Group G] {p : ℕ} (P : Subgroup G) (hP : IsPGroup p P) :
    IsPGroup p (Work.PGroup.thompsonJ P) := by
  refine hP.to_le ?_
  rw [thompsonJ, Subgroup.closure_le]
  rintro x ⟨A, hA, -, -, hxA⟩
  exact hA hxA

end Work.PGroup
