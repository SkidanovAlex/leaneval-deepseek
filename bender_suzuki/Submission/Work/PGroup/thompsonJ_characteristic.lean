import Mathlib
import Submission.Work.PGroup.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `J(P)` is characteristic in `P`

`Work.PGroup.thompsonJ P` is the Thompson subgroup of `P`: the subgroup generated by the abelian
subgroups of `P` of maximal order.  An element `g` of the normalizer of `P` permutes the subgroups
of `P` by conjugation, and conjugation is an isomorphism, so it preserves the property of being
abelian and the cardinality of a subgroup.  Hence it permutes the set of abelian subgroups of `P`
of maximal order, whose union generates `J(P)`.  Consequently `J(P)` is invariant under
conjugation by `N_G(P)`, i.e. `J(P)` is *characteristic* in `P`.

This is the formal content of the phrase "the Thompson subgroup is characteristic" used in the
Feit–Thompson development.
-/

set_option linter.style.haveILetI false

open scoped Classical Pointwise
open Subgroup

noncomputable section

namespace Work.PGroup

/-- `conjBy` is the image of the subgroup under the monoid homomorphism given by conjugation. -/
private lemma conjBy_eq_map' {G : Type*} [Group G] (g : G) (C : Subgroup G) :
    conjBy g C = C.map (MulAut.conj g).toMonoidHom := by
  rw [conjBy, Subgroup.pointwise_smul_def]; rfl

/-- Conjugation is monotone on subgroups. -/
private lemma conjBy_mono' {G : Type*} [Group G] {g : G} {A B : Subgroup G} (h : A ≤ B) :
    conjBy g A ≤ conjBy g B := by
  rw [conjBy_eq_map', conjBy_eq_map']
  exact Subgroup.map_mono h

/-- If `g` lies in the normalizer of `P` then conjugation by `g` fixes `P`. -/
private lemma conjBy_eq_self' {G : Type*} [Group G] {P : Subgroup G} {g : G}
    (hg : g ∈ Subgroup.normalizer (P : Set G)) : conjBy g P = P :=
  (conjBy_eq_map' g P).trans (Subgroup.mem_normalizer_iff_map_conj_eq.mp hg)

/-- Membership in a conjugate of a subgroup: `x ∈ gHg⁻¹ ↔ g⁻¹ x g ∈ H`. -/
private lemma mem_conjBy_iff' {G : Type*} [Group G] {g x : G} {H : Subgroup G} :
    x ∈ conjBy g H ↔ g⁻¹ * x * g ∈ H := by
  rw [conjBy, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, MulAut.smul_def,
    MulAut.conj_inv_apply]

theorem thompsonJ_characteristic {G : Type*} [Group G] (P : Subgroup G) (g : G)
    (hg : g ∈ Subgroup.normalizer (P : Set G)) :
    Work.PGroup.conjBy g (Work.PGroup.thompsonJ P) = Work.PGroup.thompsonJ P := by
  have hg' : g⁻¹ ∈ Subgroup.normalizer (P : Set G) :=
    (Subgroup.normalizer (P : Set G)).inv_mem hg
  have hPg : conjBy g P = P := conjBy_eq_self' hg
  have hPg' : conjBy g⁻¹ P = P := conjBy_eq_self' hg'
  -- The generating set of `J(P)`: elements lying in an abelian subgroup of `P` of maximal order.
  let S : Set G := {x : G | ∃ A : Subgroup G, A ≤ P ∧ IsMulCommutative A ∧
    Nat.card A = maxAbelianOrder P ∧ x ∈ A}
  have hJ : thompsonJ P = Subgroup.closure S := rfl
  -- Conjugation permutes the abelian subgroups of `P` of maximal order.
  have hS : MulAut.conj g • S = S := by
    ext x
    rw [Set.mem_smul_set]
    constructor
    · rintro ⟨y, hy, hyx⟩
      obtain ⟨A, hAP, hAab, hAcard, hyA⟩ := hy
      refine ⟨conjBy g A, (conjBy_mono' hAP).trans (le_of_eq hPg), ?_, ?_, ?_⟩
      · rw [conjBy_eq_map']
        haveI : IsMulCommutative A := hAab
        exact Subgroup.map_isMulCommutative A (MulAut.conj g).toMonoidHom
      · rw [conjBy_eq_map', Subgroup.card_map_of_injective (MulAut.conj g).injective, hAcard]
      · rw [mem_conjBy_iff']
        have hxy : g⁻¹ * x * g = y := by
          rw [← hyx, MulAut.smul_def, MulAut.conj_apply]
          group
        rw [hxy]; exact hyA
    · intro hx
      obtain ⟨A, hAP, hAab, hAcard, hxA⟩ := hx
      refine ⟨(MulAut.conj g)⁻¹ • x, ?_, smul_inv_smul _ _⟩
      refine ⟨conjBy g⁻¹ A, (conjBy_mono' hAP).trans (le_of_eq hPg'), ?_, ?_, ?_⟩
      · rw [conjBy_eq_map']
        haveI : IsMulCommutative A := hAab
        exact Subgroup.map_isMulCommutative A (MulAut.conj g⁻¹).toMonoidHom
      · rw [conjBy_eq_map', Subgroup.card_map_of_injective (MulAut.conj g⁻¹).injective, hAcard]
      · rw [show (MulAut.conj g)⁻¹ = MulAut.conj g⁻¹ from by ext y; simp]
        exact Subgroup.smul_mem_pointwise_smul x (MulAut.conj g⁻¹) A hxA
  rw [hJ]
  show MulAut.conj g • Subgroup.closure S = Subgroup.closure S
  rw [Subgroup.smul_closure, hS]

end Work.PGroup
