/-
# P. Hall's transfer theorem (M. Hall, *The Theory of Groups*, Theorem 14.4.1)

This file assembles the area `Work.Grun`:

* `Work.Grun.hall_14_4_1` — M. Hall's Theorem 14.4.1 in the form FT 1963, Lemma 17.2 needs it:
  if `P` is a Sylow `p`-subgroup of a finite group `G`, `H ≥ P`, `G = O^p(G)` (`hperf`) and every
  double coset `P x H ≠ H` carries an element `z ∈ P` whose action on the cosets of `H` in `P x H`
  is a central `p`-cycle with `e_p(u,z) = 1` for all `u ∈ P` (`hz`), then every homomorphism
  `H →* Multiplicative (ZMod p)` is trivial;
* `Work.Grun.pResidual_eq_self_of_hall` — the subgroup form `O^p(H) = H`
  (`Work.Grun.pResidual` is FT's `O^p`, the subgroup generated by the `p'`-elements).

## The proof

Fix `θ : H →* Multiplicative (ZMod p)` and let `V = θ.transfer : G →* Multiplicative (ZMod p)`;
by `hperf` we have `V = 1`.  For `u ∈ P`, Mathlib's cycle formula for the transfer
(`Work.Grun.transfer_eq_diag_mul_free`, Hall's Lemma 14.4.1) writes

  `V u = d(u) * (contribution of the ⟨u⟩-orbits of G ⧸ H of length > 1)`.

* The diagonal part is `d(u) = θ u` (`Work.Grun.prod_diagFactor_eq`, Hall's Lemmas 14.4.2–14.4.3;
  this is where `hz` is used: on each double coset `P x H ≠ H` the `u`-fixed cosets form `⟨z⟩`-cycles
  and Hall's binomial computation gives `θ (e_p(u,z)) = 1`);
* the free part is trivial: the length `r` of a nontrivial `⟨u⟩`-orbit of `G ⧸ H` divides
  `|⟨u⟩|`, hence is a `p`-power `p^k` with `k ≥ 1`; the corresponding factor is
  `θ (x⁻¹ u^r x)` with `x⁻¹ u^r x ∈ H`, and the fusion lemma `Work.Grun.theta_conj_eq` (Hall's
  Lemma 14.4.2 transported to `p`-elements) shows `θ (x⁻¹ u^r x) = θ (u^r) = (θ u)^r = 1`
  because `θ` has exponent `p` and `p ∣ r`.

So `1 = V u = θ u` for every `u ∈ P`.

Finally `H = O^p(H) · P`: `H/O^p(H)` is a `p`-group, so `[H : O^p(H)·P]` divides both the
`p`-power `[H : O^p(H)]` and the `p'`-number `[H : P]` (`Work.Grun.sup_pResidual_sylow_eq_top`).
Since `θ` vanishes on the `p'`-elements and on `P`, it vanishes on `H`.

Reference: M. Hall, *The Theory of Groups* (1959), §14.4, pp. 204–213 (Theorem 14.4.1);
W. Feit and J. G. Thompson, *Solvability of groups of odd order*, §17, Lemma 17.2.
-/
import Mathlib
import Submission.Work.Grun.Basic
import Submission.Work.Grun.Hyp
import Submission.Work.Grun.Diag
import Submission.Work.Grun.pResidual
import Submission.Work.Grun.prod_diagFactor_eq
import Submission.Work.Grun.transfer_eq_diag_mul_free
import Submission.Work.Grun.theta_conj_eq
import Submission.Work.NPC.Frobenius.isPGroup_quotient_pResidual

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

open scoped Classical Pointwise commutatorElement

set_option linter.style.haveILetI false

namespace Work.Grun

variable {G : Type*} [Group G]

/-! ### The cyclic group `Multiplicative (ZMod p)` has exponent `p` -/

/-- `Multiplicative (ZMod p)`, the cyclic group `ℤ/p` written multiplicatively, has exponent `p`. -/
theorem mul_zmod_pow_prime (p : ℕ) (a : Multiplicative (ZMod p)) : a ^ p = 1 := by
  have h : p • Multiplicative.toAdd a = 0 := by
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  rw [← ofAdd_toAdd a, ← ofAdd_nsmul, h, ofAdd_zero]

/-! ### Homomorphisms `H →* Multiplicative (ZMod p)` kill `p'`-elements -/

/-- A homomorphism into the `p`-group `Multiplicative (ZMod p)` kills every element whose order is
prime to `p`. -/
theorem theta_eq_one_of_not_dvd_orderOf {p : ℕ} [Fact p.Prime] {H : Subgroup G}
    (θ : H →* Multiplicative (ZMod p)) {x : H} (hx : ¬ p ∣ orderOf x) : θ x = 1 := by
  have h1 : orderOf (θ x) ∣ orderOf x := orderOf_map_dvd θ x
  have h2 : orderOf (θ x) ∣ p :=
    orderOf_dvd_iff_pow_eq_one.mpr (mul_zmod_pow_prime p (θ x))
  have h4 : orderOf (θ x) ∣ Nat.gcd (orderOf x) p := Nat.dvd_gcd h1 h2
  have h5 : Nat.gcd (orderOf x) p = 1 :=
    (((Fact.out : p.Prime).coprime_iff_not_dvd).mpr hx).symm.gcd_eq_one
  rw [h5] at h4
  exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp h4)

/-! ### The length of a `⟨u⟩`-orbit of `G ⧸ H`, for `u ∈ P`, is a `p`-power -/

/-- For `u` in the Sylow `p`-subgroup `P`, the `⟨u⟩`-period of any coset of `H` is a `p`-power. -/
theorem period_eq_prime_pow_of_sylow [Fintype G] {p : ℕ} [Fact p.Prime] {P : Sylow p G}
    {H : Subgroup G} (u : (P : Subgroup G)) (γ : G ⧸ H) :
    ∃ k : ℕ, Function.minimalPeriod (fun x => (u : G) • x) γ = p ^ k := by
  obtain ⟨n, hn⟩ := P.isPGroup'.exists_card_eq
  have hord : orderOf (u : G) ∣ p ^ n := by
    rw [Subgroup.orderOf_coe, ← hn]
    exact orderOf_dvd_natCard u
  have hpd : Function.minimalPeriod (fun x => (u : G) • x) γ ∣ orderOf (u : G) := by
    rw [← MulAction.period_eq_minimalPeriod]
    exact MulAction.period_dvd_orderOf (u : G) γ
  obtain ⟨k, _, hk⟩ := (Nat.dvd_prime_pow Fact.out).mp (dvd_trans hpd hord)
  exact ⟨k, hk⟩

/-! ### The fusion lemma for powers -/

/-- Hall's Lemma 14.4.2 for powers: if a `p`-power of `u ∈ P` is conjugate into `H`, the `θ`-value
of the conjugate is the corresponding power of `θ u`. -/
theorem theta_conj_pow_eq {p : ℕ} [Fact p.Prime] {P : Sylow p G} {H : Subgroup G} [Fintype G]
    [Fintype (G ⧸ H)] (hPH : (P : Subgroup G) ≤ H) (hz : HallHyp p (P : Subgroup G) H)
    {A : Type*} [CommGroup A] (θ : H →* A) (hexp : ∀ a : A, a ^ p = 1)
    (u : (P : Subgroup G)) (r : ℕ) (g : G) (hg : g⁻¹ * (u : G) ^ r * g ∈ H) :
    θ ⟨g⁻¹ * (u : G) ^ r * g, hg⟩ = θ ⟨(u : G), hPH u.2⟩ ^ r := by
  have h1 := theta_conj_eq hPH hz θ hexp (u ^ r) g (by simpa using hg)
  have h2 : (⟨((u ^ r : (P : Subgroup G)) : G), hPH (u ^ r).2⟩ : H)
      = (⟨(u : G), hPH u.2⟩ : H) ^ r := by
    ext
    simp
  rw [h2, map_pow] at h1
  simpa using h1

/-! ### The free part of the transfer is trivial -/

/-- The contribution `Work.Grun.freeProd θ u` of the nontrivial `⟨u⟩`-orbits of `G ⧸ H` to the
transfer is `1` for `u ∈ P`.  Each such orbit has length `r = p^k`, `k ≥ 1`, and its factor is
`θ (x⁻¹ u^r x) = θ (u^r) = (θ u)^r = 1` (fusion, `theta_conj_pow_eq`). -/
theorem freeProd_eq_one {p : ℕ} [Fact p.Prime] {P : Sylow p G} {H : Subgroup G} [Fintype G]
    [Fintype (G ⧸ H)] (hPH : (P : Subgroup G) ≤ H) (hz : HallHyp p (P : Subgroup G) H)
    {A : Type*} [CommGroup A] (θ : H →* A) (hexp : ∀ a : A, a ^ p = 1)
    (u : (P : Subgroup G)) : freeProd θ (u : G) = 1 := by
  classical
  rw [freeProd]
  refine Finset.prod_eq_one (fun q _ => ?_)
  by_cases hper : Function.minimalPeriod (fun x => (u : G) • x) q.out = 1
  · rw [ite_eq_left hper]
  · rw [ite_eq_right hper]
    set r : ℕ := Function.minimalPeriod (fun x => (u : G) • x) q.out with hr
    have hmem : (Quotient.out q.out)⁻¹ * (u : G) ^ r * Quotient.out q.out ∈ H :=
      QuotientGroup.out_conj_pow_minimalPeriod_mem H (u : G) q.out
    have hconj := theta_conj_pow_eq hPH hz θ hexp u r (Quotient.out q.out) hmem
    obtain ⟨k, hk⟩ := period_eq_prime_pow_of_sylow (H := H) u q.out
    have hk0 : k ≠ 0 := fun h0 => hper (by rw [hr, hk, h0, pow_zero])
    have hdvd : p ∣ r := by
      rw [hr, hk]
      exact dvd_pow_self p hk0
    have hpow : θ ⟨(u : G), hPH u.2⟩ ^ r = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp
        (dvd_trans (orderOf_dvd_iff_pow_eq_one.mpr (hexp _)) hdvd)
    rw [hconj, hpow]

/-! ### `θ` is trivial on the Sylow subgroup -/

/-- For `u` in the Sylow `p`-subgroup `P ≤ H`, the transfer of `θ` computes `θ u`, and it is trivial
because `hperf` makes the transfer trivial. -/
theorem theta_eq_one_on_sylow {p : ℕ} [Fact p.Prime] {P : Sylow p G} {H : Subgroup G} [Fintype G]
    [Fintype (G ⧸ H)] (hPH : (P : Subgroup G) ≤ H) (hz : HallHyp p (P : Subgroup G) H)
    (hperf : ∀ φ : G →* Multiplicative (ZMod p), φ = 1)
    (θ : H →* Multiplicative (ZMod p)) (u : (P : Subgroup G)) :
    θ ⟨(u : G), hPH u.2⟩ = 1 := by
  have h1 : θ.transfer (u : G) = 1 := by
    have h := congrArg (fun f : G →* Multiplicative (ZMod p) => f (u : G)) (hperf θ.transfer)
    simpa using h
  rw [transfer_eq_diag_mul_free θ (u : G),
    prod_diagFactor_eq hPH hz θ (mul_zmod_pow_prime p) u,
    freeProd_eq_one hPH hz θ (mul_zmod_pow_prime p) u, mul_one] at h1
  exact h1

/-! ### `H = O^p(H) · P` -/

/-- `H` is generated by its `p'`-elements together with a Sylow `p`-subgroup: the index
`[H : O^p(H) · P]` divides the `p`-power `[H : O^p(H)]` (the quotient `H/O^p(H)` is a `p`-group)
and the `p'`-number `[H : P]`. -/
theorem sup_pResidual_sylow_eq_top [Fintype G] {p : ℕ} [Fact p.Prime] {P : Sylow p G}
    {H : Subgroup G} (hPH : (P : Subgroup G) ≤ H) :
    Work.NPC.Frobenius.pResidual p H ⊔ (P.subtype hPH : Subgroup H) = ⊤ := by
  classical
  set K : Subgroup H := Work.NPC.Frobenius.pResidual p H with hK
  set Q : Subgroup H := (P.subtype hPH : Subgroup H) with hQ
  have hmK : (K ⊔ Q).index ∣ K.index := Subgroup.index_dvd_of_le le_sup_left
  have hmQ : (K ⊔ Q).index ∣ Q.index := Subgroup.index_dvd_of_le le_sup_right
  -- `K` has `p`-power index
  obtain ⟨n, hn⟩ :=
    (Work.NPC.Frobenius.isPGroup_quotient_pResidual (G := H) (p := p)).exists_card_eq
  have hKp : K.index = p ^ n := by rw [hK, Subgroup.index_eq_card, hn]
  -- `Q` has index prime to `p`
  have hQnd : ¬ p ∣ Q.index := by
    rw [hQ]
    exact (P.subtype hPH).not_dvd_index
  have hm1 : (K ⊔ Q).index = 1 := by
    obtain ⟨j, _, hjeq⟩ := (Nat.dvd_prime_pow Fact.out).mp (hKp ▸ hmK)
    rcases Nat.eq_zero_or_pos j with hj | hj
    · rw [hjeq, hj, pow_zero]
    · exact absurd (hjeq ▸ dvd_pow_self p (by omega) : p ∣ (K ⊔ Q).index)
        (fun hp => hQnd (hp.trans hmQ))
  exact Subgroup.index_eq_one.mp hm1

/-! ### The two targets -/

/-- **M. Hall, Theorem 14.4.1 (P. Hall's transfer theorem), hom form**, as FT 1963, Lemma 17.2
needs it: under the hypothesis `hz` (which FT §17 supplies for `H = 𝔑₁`, `P` a Sylow subgroup of
`H`), every homomorphism of `H` into the cyclic group `ℤ/p` is trivial. -/
theorem hall_14_4_1 [Finite G] {p : ℕ} [Fact p.Prime] (P : Sylow p G)
    (H : Subgroup G) (hPH : (P : Subgroup G) ≤ H)
    (hperf : ∀ φ : G →* Multiplicative (ZMod p), φ = 1)
    (hz : ∀ x : G, x ∉ H → ∃ z ∈ (P : Subgroup G),
      z ∉ cosetKernel H P x ∧ z ^ p ∈ cosetKernel H P x ∧
      (∀ u ∈ (P : Subgroup G), ⁅u, z⁆ ∈ cosetKernel H P x) ∧
      ∀ u ∈ (P : Subgroup G), iterComm (p - 1) u z = 1) :
    ∀ θ : H →* Multiplicative (ZMod p), θ = 1 := by
  haveI : Fintype G := Fintype.ofFinite G
  haveI : Fintype (G ⧸ H) := Fintype.ofFinite _
  intro θ
  refine MonoidHom.ext fun h => ?_
  have hsup := sup_pResidual_sylow_eq_top (G := G) hPH
  have hmem : h ∈ Work.NPC.Frobenius.pResidual p H ⊔ (P.subtype hPH : Subgroup H) := by
    rw [hsup]; exact Subgroup.mem_top h
  have hmem' : h ∈ Subgroup.closure
      ((Work.NPC.Frobenius.pResidual p H : Set H) ∪ ((P.subtype hPH : Subgroup H) : Set H)) := by
    rwa [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
  have hker : Subgroup.closure
      ((Work.NPC.Frobenius.pResidual p H : Set H) ∪ ((P.subtype hPH : Subgroup H) : Set H))
      ≤ θ.ker := by
    rw [Subgroup.closure_le]
    rintro x (hx | hx)
    · rw [Work.NPC.Frobenius.pResidual] at hx
      exact (Subgroup.closure_le θ.ker).mpr
        (fun y hy => theta_eq_one_of_not_dvd_orderOf θ hy) hx
    · have h := theta_eq_one_on_sylow hPH hz hperf θ ⟨(x : G), hx⟩
      simpa using h
  exact MonoidHom.mem_ker.mp (hker hmem')

/-- **M. Hall, Theorem 14.4.1, subgroup form**: under the hypotheses of `hall_14_4_1`, the subgroup
`O^p(H)` generated by the `p'`-elements of `H` is all of `H` (FT 1963, Lemma 17.2: `𝔑₁ = O^p(𝔑₁)`).

**Warning.**  This `O^p` is `Work.Grun.pResidual` (generated by the `p'`-elements), *not*
`Work.HallHigman.opSubgroup` (generated by the elements of `p`-power order) nor
`Work.Transitivity.OpSubgroup`; the two notions differ. -/
theorem pResidual_eq_self_of_hall [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) (H : Subgroup G) (hPH : (P : Subgroup G) ≤ H)
    (hperf : ∀ φ : G →* Multiplicative (ZMod p), φ = 1)
    (hz : ∀ x : G, x ∉ H → ∃ z ∈ (P : Subgroup G),
      z ∉ cosetKernel H P x ∧ z ^ p ∈ cosetKernel H P x ∧
      (∀ u ∈ (P : Subgroup G), ⁅u, z⁆ ∈ cosetKernel H P x) ∧
      ∀ u ∈ (P : Subgroup G), iterComm (p - 1) u z = 1) :
    pResidual p H = H :=
  pResidual_eq_self_iff.mpr (hall_14_4_1 P H hPH hperf hz)

/-- `Work.Grun.hall_14_4_1` with the hypothesis bundled as `Work.Grun.HallHyp` (the two forms are
definitionally equal). -/
theorem hall_14_4_1_of_hallHyp [Finite G] {p : ℕ} [Fact p.Prime] (P : Sylow p G)
    (H : Subgroup G) (hPH : (P : Subgroup G) ≤ H)
    (hperf : ∀ φ : G →* Multiplicative (ZMod p), φ = 1)
    (hz : HallHyp p (P : Subgroup G) H) :
    ∀ θ : H →* Multiplicative (ZMod p), θ = 1 :=
  hall_14_4_1 P H hPH hperf hz

/-- `Work.Grun.pResidual_eq_self_of_hall` with the hypothesis bundled as `Work.Grun.HallHyp`. -/
theorem pResidual_eq_self_of_hallHyp [Finite G] {p : ℕ} [Fact p.Prime] (P : Sylow p G)
    (H : Subgroup G) (hPH : (P : Subgroup G) ≤ H)
    (hperf : ∀ φ : G →* Multiplicative (ZMod p), φ = 1)
    (hz : HallHyp p (P : Subgroup G) H) :
    pResidual p H = H :=
  pResidual_eq_self_of_hall P H hPH hperf hz

/-- The same conclusion, in the form "`H` is generated by its `p'`-elements": the closure in `H` of
the elements of order prime to `p` is all of `H`.  This is the form in which the statement
`O^p(𝔑₁) = 𝔑₁` of FT 1963, Lemma 17.2 can be used without committing to a definition of `O^p`. -/
theorem closure_pPrime_eq_top_of_hall [Finite G] {p : ℕ} [Fact p.Prime] (P : Sylow p G)
    (H : Subgroup G) (hPH : (P : Subgroup G) ≤ H)
    (hperf : ∀ φ : G →* Multiplicative (ZMod p), φ = 1)
    (hz : ∀ x : G, x ∉ H → ∃ z ∈ (P : Subgroup G),
      z ∉ cosetKernel H P x ∧ z ^ p ∈ cosetKernel H P x ∧
      (∀ u ∈ (P : Subgroup G), ⁅u, z⁆ ∈ cosetKernel H P x) ∧
      ∀ u ∈ (P : Subgroup G), iterComm (p - 1) u z = 1) :
    Subgroup.closure {x : H | ¬ p ∣ orderOf x} = ⊤ := by
  have htop : (⊤ : Subgroup H).map H.subtype = H := by
    ext x
    simp
  have h1 : (Subgroup.closure {x : H | ¬ p ∣ orderOf (x : G)}).map H.subtype
      = (⊤ : Subgroup H).map H.subtype := by
    rw [htop, ← pResidual]
    exact pResidual_eq_self_of_hall P H hPH hperf hz
  have hset : {x : H | ¬ p ∣ orderOf (x : G)} = {x : H | ¬ p ∣ orderOf x} := by
    ext x
    simp
  exact Subgroup.map_injective H.subtype_injective (by rwa [hset] at h1)

/-! ### Consistency of the two notions of `O^p` used in the workspace -/

/-- `Work.Grun.pResidual` is the image in `G` of `Work.NPC.Frobenius.pResidual`: the two definitions
of `O^p` (generated by the `p'`-elements) agree. -/
theorem pResidual_eq_map_pResidual (p : ℕ) (H : Subgroup G) :
    pResidual p H = (Work.NPC.Frobenius.pResidual p H).map H.subtype := by
  have hset : {x : H | ¬ p ∣ orderOf (x : G)} = {x : H | ¬ p ∣ orderOf x} := by
    ext x
    simp
  rw [pResidual, Work.NPC.Frobenius.pResidual, hset]

end Work.Grun
