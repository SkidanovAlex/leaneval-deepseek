/-- The group `Multiplicative (ZMod p)` has `p` elements. -/
theorem card_multiplicative_zmod (p : ℕ) [NeZero p] :
    Nat.card (Multiplicative (ZMod p)) = p := by
  rw [← Nat.card_congr (Multiplicative.ofAdd (α := ZMod p)), Nat.card_eq_fintype_card,
    ZMod.card]

/-- A nontrivial finite `p`-group admits a nontrivial homomorphism into the cyclic group
`Multiplicative (ZMod p)` (`≅ C_p`): take a subgroup of index `p` (a maximal subgroup, which is
normal), and compose the quotient map with the isomorphism `Q ⧸ M ≃* Multiplicative (ZMod p)`. -/
theorem exists_monoidHom_zmod_ne_one_of_isPGroup {Q : Type*} [Group Q] [Finite Q] {p : ℕ}
    [Fact p.Prime] (hQ : IsPGroup p Q) [Nontrivial Q] :
    ∃ θ : Q →* Multiplicative (ZMod p), θ ≠ 1 := by
  have hp : p.Prime := Fact.out
  haveI : NeZero p := ⟨hp.ne_zero⟩
  obtain ⟨n, hn⟩ := hQ.exists_card_eq
  have hnpos : 0 < n := by
    by_contra h
    have h1 : 1 < p ^ n := by
      rw [← hn]
      exact Finite.one_lt_card_iff_nontrivial.mpr inferInstance
    have hn0 : n = 0 := by omega
    rw [hn0, pow_zero] at h1
    exact lt_irrefl 1 h1
  have hn1le : 1 ≤ n := Nat.succ_le_of_lt hnpos
  -- a subgroup of order `p ^ (n - 1)`, hence of index `p`
  obtain ⟨M, hMcard⟩ := Sylow.exists_subgroup_card_pow_prime_of_le_card (G := Q) (n := n - 1)
    hp hQ (by rw [hn]; exact Nat.pow_le_pow_right hp.pos (Nat.sub_le n 1))
  have hindex : M.index = p := by
    have h1 : M.index * Nat.card M = Nat.card Q := Subgroup.index_mul_card M
    rw [hMcard, hn] at h1
    have hpow : p ^ n = p ^ (n - 1) * p := by
      have h1 : p ^ n = p ^ ((n - 1) + 1) := by rw [Nat.sub_add_cancel hn1le]
      rw [h1, pow_succ]
    rw [hpow, mul_comm (p ^ (n - 1)) p] at h1
    exact Nat.eq_of_mul_eq_mul_right (pow_pos hp.pos _) h1
  have hMne : M ≠ ⊤ := by
    intro h
    rw [h, Subgroup.index_top] at hindex
    exact hp.ne_one hindex.symm
  have hminfac : (Nat.card Q).minFac = p := by
    rw [hn]
    exact hp.pow_minFac (Nat.pos_iff_ne_zero.mp hnpos)
  have hMnormal : M.Normal :=
    Subgroup.normal_of_index_eq_minFac_card (G := Q) (H := M) (by rw [hindex, hminfac])
  letI : M.Normal := hMnormal
  have hcardQ : Nat.card (Q ⧸ M) = p := by
    rw [← Subgroup.index_eq_card M, hindex]
  have hcardM : Nat.card (Multiplicative (ZMod p)) = p := card_multiplicative_zmod p
  let e : Q ⧸ M ≃* Multiplicative (ZMod p) := mulEquivOfPrimeCardEq hcardQ hcardM
  refine ⟨e.toMonoidHom.comp (QuotientGroup.mk' M), ?_⟩
  intro hθ
  obtain ⟨q, hq⟩ : ∃ q : Q, q ∉ M := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hMne ((Subgroup.eq_top_iff' M).mpr h)
  have hqm1 : QuotientGroup.mk' M q ≠ 1 := by
    rw [QuotientGroup.mk'_apply]
    intro h
    exact hq ((QuotientGroup.eq_one_iff q).mp h)
  have hval1 : (e.toMonoidHom.comp (QuotientGroup.mk' M)) q = 1 := by
    rw [hθ, MonoidHom.one_apply]
  have hval2 : (e.toMonoidHom.comp (QuotientGroup.mk' M)) q = e (QuotientGroup.mk' M q) := rfl
  rw [hval2] at hval1
  exact (e.injective.ne hqm1) (hval1.trans e.map_one.symm)

/-- For a finite group `X` and a prime `p`: `X` has no nontrivial homomorphism into
`Multiplicative (ZMod p)` if and only if `X` is generated by its `p'`-elements. -/
theorem forall_hom_eq_one_iff_closure_pPrime_eq_top (X : Type*) [Group X] [Finite X] {p : ℕ}
    [Fact p.Prime] :
    (∀ θ : X →* Multiplicative (ZMod p), θ = 1) ↔
      Subgroup.closure {x : X | ¬ p ∣ orderOf x} = ⊤ := by
  have hp : p.Prime := Fact.out
  haveI : NeZero p := ⟨hp.ne_zero⟩
  constructor
  · -- Contrapositive: if `O^p(X) ≠ ⊤` then `X ⧸ O^p(X)` is a nontrivial `p`-group and carries a
    -- nontrivial homomorphism, which pulls back to `X`.
    intro hθ
    by_contra hN
    have hN' : Work.NPC.Frobenius.pResidual p X ≠ ⊤ := hN
    haveI : Nontrivial (X ⧸ Work.NPC.Frobenius.pResidual p X) :=
      QuotientGroup.nontrivial_iff.mpr hN'
    have hQ : IsPGroup p (X ⧸ Work.NPC.Frobenius.pResidual p X) :=
      Work.NPC.Frobenius.isPGroup_quotient_pResidual
    obtain ⟨θ', hθ'⟩ :=
      exists_monoidHom_zmod_ne_one_of_isPGroup (Q := X ⧸ Work.NPC.Frobenius.pResidual p X) hQ
    let θ : X →* Multiplicative (ZMod p) :=
      θ'.comp (QuotientGroup.mk' (Work.NPC.Frobenius.pResidual p X))
    have hθeq : θ = 1 := hθ θ
    have hθ'eq : θ' = 1 := by
      apply MonoidHom.ext
      intro y
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Work.NPC.Frobenius.pResidual p X) y
      have hx : θ x = 1 := by rw [hθeq, MonoidHom.one_apply]
      simpa [θ] using hx
    exact hθ' hθ'eq
  · -- If the `p'`-elements generate `X`, then every homomorphism into the `p`-group
    -- `Multiplicative (ZMod p)` kills them, hence is trivial.
    intro hN θ
    have hle : Subgroup.closure {x : X | ¬ p ∣ orderOf x} ≤ θ.ker := by
      apply (Subgroup.closure_le θ.ker).mpr
      intro s hs
      show θ s = 1
      have h1 : orderOf (θ s) ∣ Nat.card (Multiplicative (ZMod p)) := orderOf_dvd_natCard _
      have h1' : orderOf (θ s) ∣ p := by
        rwa [card_multiplicative_zmod p] at h1
      have h2 : orderOf (θ s) ∣ orderOf s := orderOf_map_dvd θ s
      have hcop : p.gcd (orderOf s) = 1 := (hp.coprime_iff_not_dvd).mpr hs
      have hgcd : orderOf (θ s) ∣ 1 := by
        have := Nat.dvd_gcd h1' h2
        rwa [hcop] at this
      exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp hgcd)
    exact MonoidHom.ker_eq_top_iff.mp (top_le_iff.mp (by rw [← hN]; exact hle))

end Work.Grun
