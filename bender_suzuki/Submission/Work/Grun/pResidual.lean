/-
# The `p`-residual `O^p(H)` of a subgroup

FT 1963, Lemma 17.2 concludes `𝔑₁ = O^p(𝔑₁)`, i.e. `𝔑₁` is generated by its `p'`-elements.
`Work.Grun.pResidual p H` is that subgroup, and `pResidual_eq_self_iff` identifies the condition
`pResidual p H = H` with the vanishing of all homomorphisms `H →* Multiplicative (ZMod p)` — the
form in which `Work.Grun.hall_14_4_1` proves it.

**Warning.**  This is *not* the same subgroup as `Work.HallHigman.opSubgroup p G`, whose definition
(`closure {x | ∃ k, x ^ p ^ k = 1}`) generates the subgroup of `G` by its elements of `p`-*power*
order rather than by its `p'`-elements.  The two differ (e.g. `G = S₃`, `p = 3`: `O^3(S₃) = S₃` but
`⟨{x | x ^ 3 ^ k = 1}⟩ = A₃`), so `Work.Transitivity.OpSubgroup p H = H` is *not* equivalent to the
statement of Hall's theorem.
-/
import Mathlib
import Submission.Work.Grun.forall_hom_eq_one_iff_closure_pPrime_eq_top

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

open scoped Classical Pointwise commutatorElement

namespace Work.Grun

variable {G : Type*} [Group G]

/-- FT's `O^p(H)`: the subgroup of `H` generated by the elements of order prime to `p`. -/
def pResidual (p : ℕ) (H : Subgroup G) : Subgroup G :=
  (Subgroup.closure {x : H | ¬ p ∣ orderOf (x : G)}).map H.subtype

theorem pResidual_le (p : ℕ) (H : Subgroup G) : pResidual p H ≤ H :=
  Subgroup.map_subtype_le _

/-- `H = O^p(H)` (with the correct notion `O^p`) if and only if `H` has no nontrivial quotient of
order `p`. -/
theorem pResidual_eq_self_iff {H : Subgroup G} [Finite H] {p : ℕ} [Fact p.Prime] :
    pResidual p H = H ↔ ∀ θ : H →* Multiplicative (ZMod p), θ = 1 := by
  have htop : (⊤ : Subgroup H).map H.subtype = H := by
    ext x
    simp
  have key : ∀ K : Subgroup H, K.map H.subtype = H ↔ K = ⊤ := by
    intro K
    refine ⟨fun h => Subgroup.map_injective H.subtype_injective ?_, fun h => by rw [h]; exact htop⟩
    rw [h, htop]
  have hset : {x : H | ¬ p ∣ orderOf (x : G)} = {x : H | ¬ p ∣ orderOf x} := by
    ext x
    rw [Set.mem_setOf_eq, Set.mem_setOf_eq, Subgroup.orderOf_coe]
  rw [pResidual, hset, key, forall_hom_eq_one_iff_closure_pPrime_eq_top H]

end Work.Grun
