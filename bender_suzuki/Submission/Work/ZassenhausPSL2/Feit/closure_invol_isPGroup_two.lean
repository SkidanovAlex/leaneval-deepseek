/-- `(x ^ z) ^ n = (x ^ n) ^ z` for an integer power `z` and a natural power `n`,
i.e. taking a `z`-th power commutes with taking an `n`-th power. -/
lemma pow_zpow_comm {G : Type} [Group G] (x : G) (z : ℤ) (n : ℕ) :
    (x ^ z) ^ n = (x ^ n) ^ z := by
  calc (x ^ z) ^ n = (x ^ z) ^ (n : ℤ) := by rw [zpow_natCast]
    _ = x ^ (z * (n : ℤ)) := by rw [← zpow_mul]
    _ = x ^ ((n : ℤ) * z) := by rw [mul_comm]
    _ = (x ^ (n : ℤ)) ^ z := by rw [zpow_mul]
    _ = (x ^ n) ^ z := by rw [zpow_natCast]

/-- If `u` and `v` are involutions and `u * v` has order a power of two, then the
subgroup generated by `u` and `v` is a 2-group (it is dihedral of order
`2 * orderOf (u * v)`). -/
theorem closure_invol_isPGroup_two {G : Type} [Group G] [Finite G] {u v : G}
    (hu : orderOf u = 2) (hv : orderOf v = 2) (huv : ∃ k : ℕ, orderOf (u * v) = 2 ^ k) :
    IsPGroup 2 (Subgroup.closure ({u, v} : Set G)) := by
  obtain ⟨k, hk⟩ := huv
  -- `w = u * v` generates, together with `u`, the whole group; `u` inverts it.
  set w : G := u * v with hw
  have hu2 : u * u = 1 := by rw [← pow_two, ← hu]; exact pow_orderOf_eq_one u
  have hv2 : v * v = 1 := by rw [← pow_two, ← hv]; exact pow_orderOf_eq_one v
  have huinv : u⁻¹ = u := by rw [inv_eq_iff_mul_eq_one]; exact hu2
  have hvinv : v⁻¹ = v := by rw [inv_eq_iff_mul_eq_one]; exact hv2
  have hk' : orderOf w = 2 ^ k := by rw [hw, hk]
  have hwpow : w ^ (2 ^ k) = 1 := by rw [← hk']; exact pow_orderOf_eq_one w
  -- Conjugation by `u` is inversion on `⟨w⟩`.
  have hrel : u * w * u = w⁻¹ := by
    rw [hw, mul_inv_rev, huinv, hvinv, ← mul_assoc u u v, hu2, one_mul]
  have hconj : ∀ z : ℤ, u * w ^ z * u = w ^ (-z) := by
    intro z
    have h : (MulAut.conj u) (w ^ z) = ((MulAut.conj u) w) ^ z :=
      map_zpow (MulAut.conj u) w z
    rw [MulAut.conj_apply, huinv] at h
    rw [MulAut.conj_apply, huinv, hrel] at h
    rw [h, inv_zpow, ← zpow_neg]
  have hswap : ∀ z : ℤ, w ^ z * u = u * w ^ (-z) := by
    intro z
    calc w ^ z * u = (u * u) * (w ^ z * u) := by rw [hu2, one_mul]
      _ = u * (u * w ^ z * u) := by group
      _ = u * w ^ (-z) := by rw [hconj z]
  -- Every element of `⟨u, v⟩` is `w ^ z` or `u * w ^ z`.
  let K : Subgroup G :=
    { carrier := {x : G | ∃ z : ℤ, x = w ^ z ∨ x = u * w ^ z}
      mul_mem' := by
        rintro a b ⟨za, ha | ha⟩ ⟨zb, hb | hb⟩
        · exact ⟨za + zb, Or.inl (by rw [ha, hb, ← zpow_add])⟩
        · exact ⟨-za + zb, Or.inr (by
            rw [ha, hb, ← mul_assoc (w ^ za) u (w ^ zb), hswap za, mul_assoc,
              ← zpow_add])⟩
        · exact ⟨za + zb, Or.inr (by rw [ha, hb, mul_assoc, ← zpow_add])⟩
        · exact ⟨-za + zb, Or.inl (by
            rw [ha, hb, ← mul_assoc (u * w ^ za) u (w ^ zb), hconj za, ← zpow_add])⟩
      one_mem' := ⟨0, Or.inl (by rw [zpow_zero])⟩
      inv_mem' := by
        rintro a ⟨za, ha | ha⟩
        · exact ⟨-za, Or.inl (by rw [ha, zpow_neg])⟩
        · exact ⟨za, Or.inr (by
            rw [ha, mul_inv_rev, huinv, ← zpow_neg, hswap (-za), neg_neg])⟩ }
  have hKsub : Subgroup.closure ({u, v} : Set G) ≤ K := by
    rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨0, Or.inr (by rw [zpow_zero, mul_one])⟩
    · exact ⟨1, Or.inr (by rw [zpow_one, hw, ← mul_assoc, hu2, one_mul])⟩
  rw [isPGroup_iff_pow_pow_eq_one]
  intro g
  have hgK : (g : G) ∈ K := hKsub g.2
  change ∃ z : ℤ, (g : G) = w ^ z ∨ (g : G) = u * w ^ z at hgK
  rcases hgK with ⟨z, hz | hz⟩
  · -- `g = w ^ z`, whose order divides `orderOf w = 2 ^ k`.
    refine ⟨k + 1, ?_⟩
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [hz, ← orderOf_dvd_iff_pow_eq_one]
    have h1 : (w ^ z) ^ (2 ^ k) = 1 := by rw [pow_zpow_comm, hwpow, one_zpow]
    exact dvd_trans (orderOf_dvd_of_pow_eq_one h1) (Nat.pow_dvd_pow 2 (Nat.le_succ k))
  · -- `g = u * w ^ z` is an involution, so its order divides `2`.
    refine ⟨k + 1, ?_⟩
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [hz, ← orderOf_dvd_iff_pow_eq_one]
    have hsq : (u * w ^ z) ^ 2 = 1 := by
      rw [pow_two, ← mul_assoc (u * w ^ z) u (w ^ z), hconj z, ← zpow_add,
        neg_add_cancel, zpow_zero]
    have h2 : 2 ∣ 2 ^ (k + 1) := by
      have h := Nat.pow_dvd_pow 2 (show 1 ≤ k + 1 by omega)
      rwa [pow_one] at h
    exact dvd_trans (orderOf_dvd_of_pow_eq_one hsq) h2

end Work.ZassenhausPSL2.Feit
