import Mathlib
import Submission.Work.Hall.SchurZassenhaus.hall_sz_conj_abelian
import Submission.Work.Hall.Transport.hall_map_mulAut_conj
import Submission.Work.Hall.Transport.hall_map_subtype_mulAut_conj
import Submission.Work.Hall.Transport.hall_map_subtype_comap_of_le
import Submission.Work.Hall.Transport.hall_card_comap_subtype_of_le

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.Hall.SchurZassenhaus

open scoped Pointwise

/-- **Schur–Zassenhaus, abelian step, coprime form.**  Let `M ◁ G` be abelian and let `H`, `K` be
subgroups of `G` with `H ⊓ M = K ⊓ M = ⊥` and `H ⊔ M = K ⊔ M`.  If `|M|` is coprime to `|H|`,
then `H` and `K` are conjugate.

The argument reduces to the group `L = H ⊔ M = K ⊔ M`, in which `M` is an abelian normal Hall
subgroup with complements `H` and `K`; the abelian case of Schur–Zassenhaus
(`hall_sz_conj_abelian`) then produces the conjugating element, and the inclusion `L ↪ G`
transports it back. -/
theorem sz_abelian_step_coprime {G : Type*} [Group G] [Finite G] {M H K : Subgroup G} [M.Normal]
    [IsMulCommutative M] (hc : (Nat.card M).Coprime (Nat.card H)) (hsup : H ⊔ M = K ⊔ M)
    (hHd : H ⊓ M = ⊥) (hKd : K ⊓ M = ⊥) :
    ∃ x : G, K = H.map (MulAut.conj x).toMonoidHom := by
  -- Work inside the subgroup `L = H ⊔ M = K ⊔ M` generated by the two complements.
  let L : Subgroup G := H ⊔ M
  have hHL : H ≤ L := le_sup_left
  have hML : M ≤ L := le_sup_right
  have hKL : K ≤ L := by
    rw [show L = K ⊔ M from hsup]; exact le_sup_left
  -- `M` is an abelian normal subgroup of `L`.
  -- `H.subgroupOf L` is a complement of `M.subgroupOf L` in `L`.
  have hMc : (M.subgroupOf L).IsComplement' (H.subgroupOf L) := by
    refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
    · rw [disjoint_iff_inf_le]
      intro x hx
      rw [Subgroup.mem_inf] at hx
      obtain ⟨hxM, hxH⟩ := hx
      rw [Subgroup.mem_subgroupOf] at hxM hxH
      rw [Subgroup.mem_bot]
      exact Subtype.ext (by
        have hmem : (x : G) ∈ H ⊓ M := ⟨hxH, hxM⟩
        rw [hHd, Subgroup.mem_bot] at hmem
        simpa using hmem)
    · rw [← Subgroup.normal_mul (M.subgroupOf L) (H.subgroupOf L)]
      have htop : M.subgroupOf L ⊔ H.subgroupOf L = ⊤ := by
        rw [← Subgroup.subgroupOf_sup hML hHL, sup_comm]
        exact Subgroup.subgroupOf_self L
      rw [htop, Subgroup.coe_top]
  -- `K.subgroupOf L` is a complement of `M.subgroupOf L` in `L`.
  have hKc : (M.subgroupOf L).IsComplement' (K.subgroupOf L) := by
    refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
    · rw [disjoint_iff_inf_le]
      intro x hx
      rw [Subgroup.mem_inf] at hx
      obtain ⟨hxM, hxK⟩ := hx
      rw [Subgroup.mem_subgroupOf] at hxM hxK
      rw [Subgroup.mem_bot]
      exact Subtype.ext (by
        have hmem : (x : G) ∈ K ⊓ M := ⟨hxK, hxM⟩
        rw [hKd, Subgroup.mem_bot] at hmem
        simpa using hmem)
    · rw [← Subgroup.normal_mul (M.subgroupOf L) (K.subgroupOf L)]
      have htop : M.subgroupOf L ⊔ K.subgroupOf L = ⊤ := by
        rw [← Subgroup.subgroupOf_sup hML hKL, sup_comm, ← hsup]
        exact Subgroup.subgroupOf_self L
      rw [htop, Subgroup.coe_top]
  -- `M.subgroupOf L` is an abelian normal Hall subgroup of `L`: its index is `|H|`.
  have hc' : (Nat.card (M.subgroupOf L)).Coprime (M.subgroupOf L).index := by
    have hcardM : Nat.card (M.subgroupOf L) = Nat.card M := by
      rw [← Subgroup.comap_subtype M L, Work.Hall.Transport.hall_card_comap_subtype_of_le hML]
    have hcardH : Nat.card (H.subgroupOf L) = Nat.card H := by
      rw [← Subgroup.comap_subtype H L, Work.Hall.Transport.hall_card_comap_subtype_of_le hHL]
    have hidx : (M.subgroupOf L).index = Nat.card (H.subgroupOf L) :=
      (Subgroup.IsComplement'.symm hMc).index_eq_card
    rw [hcardM, hidx, hcardH]
    exact hc
  -- Apply Schur–Zassenhaus in the abelian case inside `L`.
  obtain ⟨g, hg⟩ := Work.Hall.SchurZassenhaus.hall_sz_conj_abelian (G := L) hc' hMc hKc
  refine ⟨(g : G), ?_⟩
  -- Transport the conjugacy back to `G` along the inclusion `L ↪ G`.
  have hQR : ((H.subgroupOf L).map (MulAut.conj g).toMonoidHom).map L.subtype
      = H.map (MulAut.conj (g : G)).toMonoidHom := by
    rw [← Subgroup.comap_subtype H L]
    exact Work.Hall.Transport.hall_map_subtype_mulAut_conj hHL g
  have hcongr := congrArg (Subgroup.map L.subtype) hg
  rw [Subgroup.map_subgroupOf_eq_of_le hKL, hQR] at hcongr
  exact hcongr

end Work.Hall.SchurZassenhaus
