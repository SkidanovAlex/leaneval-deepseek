/-- Coprime action (Peterfalvi I Ch. I §1 (9), Huppert I.18.6): an odd-order group on which a
four-group `{1,a,b,ab}` acts by conjugation is generated by the centralisers of the three
non-trivial involutions.  (Used to prove that `O_{2'}(G) ≤ H` for a strongly embedded `H`.) -/
theorem sup_centralizer_eq_of_fourGroup {G : Type} [Group G] [Finite G] {a b : G} {O : Subgroup G}
    (ha : orderOf a = 2) (hb : orderOf b = 2) (hne : a ≠ b) (hcomm : a * b = b * a)
    (hO : Odd (Nat.card O))
    (hAO : Subgroup.closure ({a, b} : Set G) ≤ Subgroup.normalizer (O : Set G)) :
    O ≤ Subgroup.centralizer ({a} : Set G) ⊔ Subgroup.centralizer ({b} : Set G) ⊔
      Subgroup.centralizer ({a * b} : Set G) := by
  have ha2 : a * a = 1 := by
    have h := pow_orderOf_eq_one a
    rw [ha] at h
    simpa [pow_two] using h
  have hb2 : b * b = 1 := by
    have h := pow_orderOf_eq_one b
    rw [hb] at h
    simpa [pow_two] using h
  have ha1 : a ≠ 1 := by intro h; rw [h] at ha; simp at ha
  have hb1 : b ≠ 1 := by intro h; rw [h] at hb; simp at hb
  let V : Subgroup G := Subgroup.closure ({a, b} : Set G)
  haveI : FT.Normalizes V O := ⟨hAO⟩
  let av : V := ⟨a, Subgroup.subset_closure (by simp : a ∈ ({a, b} : Set G))⟩
  let bv : V := ⟨b, Subgroup.subset_closure (by simp : b ∈ ({a, b} : Set G))⟩
  have hav2 : av * av = 1 := by apply Subtype.ext; simp [av, ha2]
  have hbv2 : bv * bv = 1 := by apply Subtype.ext; simp [bv, hb2]
  have ha1' : av ≠ 1 := fun h => ha1 (congrArg Subtype.val h)
  have hb1' : bv ≠ 1 := fun h => hb1 (congrArg Subtype.val h)
  have hne' : av ≠ bv := fun h => hne (congrArg Subtype.val h)
  have hcomm' : av * bv = bv * av := by apply Subtype.ext; simp [av, bv, hcomm]
  have hV' : ∀ v : V, v = 1 ∨ v = av ∨ v = bv ∨ v = av * bv := by
    intro v
    have hv := closure_pair_mem_four ha2 hb2 hcomm (v : G) (Subtype.coe_prop v)
    rcases hv with h | h | h | h
    · left; exact Subtype.ext h
    · right; left; exact Subtype.ext h
    · right; right; left; exact Subtype.ext h
    · right; right; right; exact Subtype.ext h
  have hmain := fourGroup_elemCent_sup_eq_top (V := V) (G := ↥O) (a := av) (b := bv)
    ha1' hb1' hne' hav2 hbv2 hcomm' hV' hO
  have hm := congrArg (Subgroup.map O.subtype) hmain
  rw [Subgroup.map_sup, Subgroup.map_sup, elemCent_conj_map, elemCent_conj_map,
      elemCent_conj_map, Subgroup.map_top, Subgroup.range_subtype] at hm
  rw [eq_comm] at hm
  rw [hm]
  exact sup_le (sup_le (le_trans inf_le_left (le_trans le_sup_left le_sup_left))
    (le_trans inf_le_left (le_trans le_sup_right le_sup_left)))
    (le_trans inf_le_left le_sup_right)

end Work.ThreePoints
