import Mathlib
import Submission.Work.ThreePoints.P3Sub.Basic
import Submission.Work.ThreePoints.Omega
import Submission.Work.ThreePoints.Sec2
import Submission.Work.ThreePoints.P3NeBot.oddResidual_basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `Work.ThreePoints.P3NeBot.Basic`: the group `F₁ = ⟨Inv C_G(X)⟩`

Peterfalvi I Ch. II §4 Prop. 3 repeatedly uses `F₁ = ⟨Inv C_G(X)⟩`, the subgroup generated by
the involutions of the centraliser of `X` (`X ≤ V = C_D(t)`).  This file fixes the notation and
proves the elementary facts used by the proof of Prop. 3 (a), (b):

* `p3F1 X ≤ C_G(X)` (it is generated by elements of the centraliser);
* `p3F1 X ≤ N_G(X)`;
* `p3F1 X ≤ p3F X = O^{2'}(C_G(X))` (every involution lies in `O^{2'}`, since the quotient of a
  finite group by `O^{2'}` has odd order).
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open LeanEval.GroupTheory.Defs

namespace Work.ThreePoints

open Submission.Blueprint

variable {G : Type} [Group G] [Finite G]

/-- `F₁ = ⟨Inv C_G(X)⟩`, the subgroup generated by the involutions of `C_G(X)`, as a subgroup of
the ambient group `G` (Peterfalvi I Ch. II §4, Prop. 3). -/
noncomputable def p3F1 (X : Subgroup G) : Subgroup G :=
  Subgroup.closure (involutions (Subgroup.centralizer (X : Set G) : Set G) : Set G)

/-- An involution of `C_G(X)` lies in `F₁`. -/
theorem mem_p3F1_of_mem_involutions {X : Subgroup G} {u : G}
    (hu : u ∈ involutions (Subgroup.centralizer (X : Set G) : Set G)) : u ∈ p3F1 X :=
  Subgroup.subset_closure hu

/-- `F₁` is contained in the centraliser of `X`. -/
theorem p3F1_le_centralizer (X : Subgroup G) :
    p3F1 X ≤ Subgroup.centralizer (X : Set G) := by
  rw [p3F1, Subgroup.closure_le]
  rintro u ⟨hu, -⟩
  exact hu

/-- `F₁` is contained in the normaliser of `X`. -/
theorem p3F1_le_normalizer (X : Subgroup G) :
    p3F1 X ≤ Subgroup.normalizer (X : Set G) :=
  (p3F1_le_centralizer X).trans (Subgroup.centralizer_le_normalizer (X : Set G))

/-- An involution of a finite group lies in `O^{2'}`: the quotient by `O^{2'}` has odd order. -/
theorem involution_mem_oddResidual {H : Type} [Group H] [Finite H] {x : H} (hx : x * x = 1) :
    x ∈ Submission.Blueprint.oddResidual H :=
  (P3NeBot.oddResidual_basic (G := H)).2.2.2 x hx

/-- `F₁ = ⟨Inv C_G(X)⟩` is contained in `F = O^{2'}(C_G(X))`: every involution of `C_G(X)` lies
in `O^{2'}(C_G(X))` because the quotient by `O^{2'}` has odd order. -/
theorem p3F1_le_p3F (X : Subgroup G) : p3F1 X ≤ p3F X := by
  rw [p3F1, Subgroup.closure_le]
  rintro u ⟨hu, hu2⟩
  change u ∈ p3F X
  rw [mem_p3F]
  refine ⟨⟨u, hu⟩, ?_, rfl⟩
  exact involution_mem_oddResidual (x := (⟨u, hu⟩ : ↥(Subgroup.centralizer (X : Set G))))
    (Subtype.ext (mul_self_eq_one_of_orderOf_eq_two hu2))

end Work.ThreePoints
