namespace Work.ThreePoints.P3NeBot

open LeanEval.GroupTheory.Defs

variable {G : Type} [Group G]

/-- If `g` normalises both `A` and `B`, then it normalises `A ⊓ B`. -/
theorem mem_normalizer_inf {A B : Subgroup G} {g : G}
    (hA : g ∈ Subgroup.normalizer (A : Set G)) (hB : g ∈ Subgroup.normalizer (B : Set G)) :
    g ∈ Subgroup.normalizer ((A ⊓ B : Subgroup G) : Set G) := by
  rw [Subgroup.mem_normalizer_iff] at hA hB ⊢
  intro x
  rw [Subgroup.mem_inf, Subgroup.mem_inf]
  exact ⟨fun h => ⟨(hA x).mp h.1, (hB x).mp h.2⟩,
    fun h => ⟨(hA x).mpr h.1, (hB x).mpr h.2⟩⟩

/-- Peterfalvi Appendix I (1) in the form used by Ch. II §4 Prop. 3 (a): the normaliser in
`D = H ∩ H^t` of a subgroup `X ≤ V = C_D(t)` is generated by its intersections with `K = J(D,t)`
and with `V`; since every element of `N_K(X)` lies in `F₁ = ⟨Inv C_G(X)⟩` (Lemma 1), this gives
`N_D(X) ≤ F₁ · N_V(X)`.
Apply App. I (1)(a) to the subgroup `N_D(X) = D ⊓ N_G(X)` (odd order, normalised by `t`); its
centraliser in `t` is `V ⊓ N_G(X)` and its inverted elements are `N_K(X)`.  App. I (1)(a) is not
stated directly (`Work.DoubleTransitivity.App1.app1_1b` gives the cardinality/`K` form); the
product decomposition `X = C_X(t)·J(X,t)` follows from `Work.DoubleTransitivity.App1.phiMap` and
`Work.DoubleTransitivity.App1.phiMap_bijective`.
Do not import any module whose closure still contains `hole`. -/
theorem p3_appI_one {G : Type} [Group G] [Finite G]
    (hFT : Submission.Blueprint.FeitThompsonProp) (hC : Submission.Blueprint.ThmCProp)
    (hA : Submission.Blueprint.ThmAProp) (hBrSz : Submission.Blueprint.BrauerSuzukiProp)
    (hS : Submission.Blueprint.Situation G) {H : Subgroup G}
    (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H) {t : G} (ht : orderOf t = 2)
    (htH : t ∉ H) {X : Subgroup G} (hX : X ≤ Submission.Blueprint.centD H t) :
    (Submission.Blueprint.twoPoint H t ⊓ Subgroup.normalizer (X : Set G)) ≤
      Work.ThreePoints.p3F1 X ⊔ (Submission.Blueprint.centD H t ⊓ Subgroup.normalizer (X : Set G)) := by
  classical
  let D : Subgroup G := Submission.Blueprint.twoPoint H t
  let N : Subgroup G := Subgroup.normalizer (X : Set G)
  let V : Subgroup G := Submission.Blueprint.centD H t
  let M : Subgroup G := D ⊓ N
  let F1 : Subgroup G := Work.ThreePoints.p3F1 X
  let CV : Subgroup G := V ⊓ N
  change M ≤ F1 ⊔ CV
  intro m hm
  -- ### `t` centralises and normalises `X`, because `X ≤ V = C_D(t)`
  have htC : t ∈ Subgroup.centralizer (X : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    exact (mem_centD.mp (hX hx)).2.2
  have htN : t ∈ N := Subgroup.centralizer_le_normalizer (X : Set G) htC
  -- ### `t` normalises `D` and `N`, hence `M = D ⊓ N`
  have htD : t ∈ Subgroup.normalizer (D : Set G) := Work.ThreePoints.mem_normalizer_twoPoint H ht
  have htM : t ∈ Subgroup.normalizer (M : Set G) :=
    mem_normalizer_inf htD (Subgroup.le_normalizer htN)
  -- ### `M` has odd order, since `M ≤ D` and `D` is odd
  have hoddD : Odd (Nat.card ↥D) :=
    Work.ThreePoints.IsStronglyEmbedded.odd_card_inf_conj hH htH
  have hMD : M ≤ D := inf_le_left
  have hoddM : Odd (Nat.card ↥M) :=
    Odd.of_dvd_nat hoddD (Subgroup.card_dvd_of_le hMD)
  -- ### Appendix I (1): `M = C_M(t) · J(M,t)`
  obtain ⟨p, hp⟩ :=
    (Work.DoubleTransitivity.App1.phiMap_bijective (X := M) (t := t) ht hoddM htM).2 ⟨m, hm⟩
  have hm_eq : (p.1 : G) * (p.2 : G) ^ Work.DoubleTransitivity.App1.expo M = m := by
    have h1 := congrArg (fun z : ↥M => (z : G)) hp
    simpa [Work.DoubleTransitivity.App1.phiMap_apply] using h1
  -- ### the `C_M(t)`-part lies in `V ⊓ N_G(X)`
  have hvm : (p.1 : G) ∈ CV := by
    have h1 : (p.1 : G) ∈ Work.DoubleTransitivity.centralizerIn M t := p.1.2
    have h1M : (p.1 : G) ∈ M := (Subgroup.mem_inf.mp h1).1
    have h1c : (p.1 : G) ∈ Subgroup.centralizer ({t} : Set G) := (Subgroup.mem_inf.mp h1).2
    have h1D : (p.1 : G) ∈ D := (Subgroup.mem_inf.mp h1M).1
    have h1N : (p.1 : G) ∈ N := (Subgroup.mem_inf.mp h1M).2
    exact Subgroup.mem_inf.mpr ⟨Subgroup.mem_inf.mpr ⟨h1D, h1c⟩, h1N⟩
  -- ### the `J(M,t)`-part lies in `F₁` (Lemma 1) and so do its powers
  have hyF : (p.2 : G) ∈ F1 := by
    have h2 : (p.2 : G) ∈ Submission.Blueprint.invertedBy M t := p.2.2
    have h2M : (p.2 : G) ∈ M := h2.1
    have h2D : (p.2 : G) ∈ Submission.Blueprint.invertedBy (Submission.Blueprint.twoPoint H t) t :=
      ⟨(Subgroup.mem_inf.mp h2M).1, h2.2⟩
    have h2N : (p.2 : G) ∈ N := (Subgroup.mem_inf.mp h2M).2
    exact p3_lemma1 hFT hC hA hBrSz hS hH ht htH hX h2D h2N
  have hpow : (p.2 : G) ^ Work.DoubleTransitivity.App1.expo M ∈ F1 :=
    Subgroup.pow_mem F1 hyF _
  -- ### conclude
  have hsum : (p.1 : G) * (p.2 : G) ^ Work.DoubleTransitivity.App1.expo M ∈ F1 ⊔ CV :=
    Subgroup.mul_mem (F1 ⊔ CV) (Subgroup.mem_sup_right hvm) (Subgroup.mem_sup_left hpow)
  rwa [hm_eq] at hsum

end Work.ThreePoints.P3NeBot
