/-
# Coprime action of a four-group: the vocabulary

Fix a finite group `V` acting by automorphisms on a group `G` (a `MulDistribMulAction V G`).
For an element `v : V` we write `elemCent v` for the *centraliser of a single element of the
acting group*:

  `elemCent v = {g : G | v • g = g}`.

This is the object appearing in Gorenstein, *Finite Groups*, Theorem 5.3.16 (= Huppert I.18.6 in
the form quoted by Peterfalvi I Ch. I §1 (9)): if `V` is a **noncyclic** abelian `q`-group acting
coprimely on `G`, then `G` is generated by the `elemCent v` for `v ∈ V \ {1}`.

The main consumer is `Work.ThreePoints.sup_centralizer_eq_of_fourGroup`, where `V = {1,a,b,ab}`
is a four-group acting by conjugation on an odd-order subgroup `O` of an ambient group.

Only definitions and elementary API live here, so that the individual lemmas of the development
can import this module.
-/
import Mathlib
import Submission.Work.Coprime.Defs
import Submission.Work.Coprime.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedVariables false

open scoped Pointwise

namespace Work.ThreePoints

/-- The centraliser of a single element `v` of the acting group `V`, acting on `G`: the set of
elements of `G` fixed by `v`. -/
def elemCent {V : Type*} [Group V] {G : Type*} [Group G] [MulDistribMulAction V G]
    (v : V) : Subgroup G where
  carrier := {g | v • g = g}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    show v • (x * y) = x * y
    rw [smul_mul', hx, hy]
  inv_mem' := by
    intro x hx
    show v • x⁻¹ = x⁻¹
    rw [smul_inv', hx]

@[simp] theorem mem_elemCent {V : Type*} [Group V] {G : Type*} [Group G]
    [MulDistribMulAction V G] {v : V} {g : G} :
    g ∈ elemCent v ↔ v • g = g := Iff.rfl

theorem elemCent_le_iff {V : Type*} [Group V] {G : Type*} [Group G] [MulDistribMulAction V G]
    {v : V} {H : Subgroup G} : H ≤ elemCent v ↔ ∀ x ∈ H, v • x = x :=
  ⟨fun h x hx => h hx, fun h x hx => h x hx⟩

/-- The map from the Sylow-level invariance to the subgroup-level invariance used by
`FT.IsInvariant`. -/
theorem isInvariant_of_sylow_invariant {V : Type*} [Group V] {G : Type*} [Group G]
    [MulDistribMulAction V G] {p : ℕ} (P : Sylow p G) (hP : ∀ v : V, v • P = P) :
    FT.IsInvariant V (P : Subgroup G) := by
  refine ⟨fun v => ?_⟩
  have h := congrArg (fun (Q : Sylow p G) => (Q : Subgroup G)) (hP v)
  simpa [Sylow.pointwise_smul_def] using h

end Work.ThreePoints
