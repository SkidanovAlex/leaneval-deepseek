/-!
# `p3cd_gen_by_involutions`

Peterfalvi I Ch. II §4 Prop. 3 (c), the last step for `F = O^{2'}(C_G(X))`:
`F` is generated by its involutions.

The source gets this from `F = F₁ = ⟨Inv C_G(X)⟩` (Prop. 3 (a)).  Here we use instead the
induction hypothesis (B1) of `Situation G`, applied to the proper subgroup `F`:

* `F = O^{2'}(F)` (idempotency of `O^{2'}`), so `F` has no proper normal subgroup of odd index;
* `(B1)` applied to `F` (`gen_card_p3F_lt` makes `F` a proper subgroup of `G`) gives
  `F/O_{2'}(F) ≅ Y` with `Y` a simple Bender group;
* a simple group is generated by its involutions, and every involution of `Y` lifts to an
  involution of `F` because `O_{2'}(F)` has odd order;
* hence `F = ⟨Inv F⟩ · O_{2'}(F)`, so `⟨Inv F⟩` has odd index in `F`, and minimality of
  `O^{2'}(F) = F` forces `⟨Inv F⟩ = F`.

The two inputs on `F` itself are supplied by the companion target `p3cd_hasFourGroup`
(Ch. II §4 Prop. 3 (c) 2-rank part, and Prop. 1 (b) in its `strongEmbedded_p3F_inf_H`).
-/

variable {G : Type} [Group G] [Finite G]

/-! ## 1. Pure group theory: `⟨Inv F⟩` is normal, and involutions of odd quotients lift -/

/-- Conjugating an involution of `F` gives an involution of `F`. -/
theorem conj_mem_involutions_top {F : Type} [Group F] {u : F}
    (hu : u ∈ Submission.Blueprint.involutions (⊤ : Set F)) (g : F) :
    g * u * g⁻¹ ∈ Submission.Blueprint.involutions (⊤ : Set F) := by
  obtain ⟨-, hu2⟩ := mem_involutions.mp hu
  have hu1 : u * u = 1 := mul_self_eq_one_of_orderOf_eq_two hu2
  refine mem_involutions.mpr ⟨Subgroup.mem_top _, ?_⟩
  have h1 : (g * u * g⁻¹) * (g * u * g⁻¹) = 1 := by
    calc (g * u * g⁻¹) * (g * u * g⁻¹) = g * (u * u) * g⁻¹ := by group
      _ = 1 := by rw [hu1]; group
  refine orderOf_eq_two_of ?_ h1
  intro hcon
  have h2 : u = 1 := by
    calc u = g⁻¹ * (g * u * g⁻¹) * g := by group
      _ = g⁻¹ * 1 * g := by rw [hcon]
      _ = 1 := by group
  rw [h2, orderOf_one] at hu2
  exact absurd hu2 (by norm_num)

/-- `⟨Inv F⟩` is normal in `F`: conjugation permutes the involutions. -/
theorem closure_involutions_normal {F : Type} [Group F] :
    (Subgroup.closure (Submission.Blueprint.involutions (⊤ : Set F))).Normal := by
  refine ⟨fun a ha b => ?_⟩
  induction ha using Subgroup.closure_induction with
  | mem y hy => exact Subgroup.subset_closure (conj_mem_involutions_top hy b)
  | one => simp
  | mul y z hy hz ihy ihz =>
      have h : b * (y * z) * b⁻¹ = (b * y * b⁻¹) * (b * z * b⁻¹) := by group
      rw [h]
      exact Subgroup.mul_mem _ ihy ihz
  | inv y hy ihy =>
      have h : b * y⁻¹ * b⁻¹ = (b * y * b⁻¹)⁻¹ := by group
      rw [h]
      exact Subgroup.inv_mem _ ihy

/-- **Involutions lift through an odd-order kernel.**  If `φ : F →* Y` is surjective with
`|ker φ|` odd, then every involution of `Y` is the image of an involution of `F`. -/
theorem exists_involution_map_eq_of_ker_odd {F : Type} [Group F] [Finite F] {Y : Type} [Group Y]
    (φ : F →* Y) (hφ : Function.Surjective φ) (hodd : Odd (Nat.card ↥φ.ker))
    {v : Y} (hv : orderOf v = 2) :
    ∃ u : F, orderOf u = 2 ∧ φ u = v := by
  obtain ⟨x, hx⟩ := hφ v
  have hvx : orderOf (φ x) = 2 := by rw [hx]; exact hv
  set m : ℕ := orderOf x with hm
  have h2dvd : 2 ∣ m := by
    have h := orderOf_map_dvd φ x
    rw [hvx] at h
    exact h
  have hmpos : 0 < m := orderOf_pos x
  have hle : 2 ≤ m := Nat.le_of_dvd hmpos h2dvd
  have hmul : m = 2 * (m / 2) := (Nat.mul_div_cancel' h2dvd).symm
  have hv2sq : v ^ 2 = 1 := orderOf_dvd_iff_pow_eq_one.mp (by rw [hv])
  have hsq : (x ^ (m / 2)) * (x ^ (m / 2)) = 1 := by
    rw [← pow_two, ← pow_mul, Nat.mul_comm, ← hmul, hm, pow_orderOf_eq_one]
  have hne : x ^ (m / 2) ≠ 1 := by
    intro h1
    have hdvd : m ∣ m / 2 := by rw [hm, orderOf_dvd_iff_pow_eq_one]; exact h1
    have hge : m ≤ m / 2 := Nat.le_of_dvd (by omega) hdvd
    omega
  have hoddhalf : Odd (m / 2) := by
    rw [← Nat.not_even_iff_odd]
    intro hev
    have hmap1 : φ (x ^ (m / 2)) = 1 := by
      rw [map_pow, hx]
      obtain ⟨t, ht⟩ := hev
      rw [ht, ← two_mul, pow_mul, hv2sq, one_pow]
    have hmem : x ^ (m / 2) ∈ φ.ker := hmap1
    have hdvd : orderOf (x ^ (m / 2)) ∣ Nat.card ↥φ.ker :=
      Subgroup.orderOf_dvd_natCard φ.ker hmem
    have hdvd2 : orderOf (x ^ (m / 2)) ∣ 2 :=
      orderOf_dvd_iff_pow_eq_one.mpr (by simpa [pow_two] using hsq)
    have hgcd : orderOf (x ^ (m / 2)) ∣ 1 := by
      have h1 := Nat.dvd_gcd hdvd2 hdvd
      rwa [Nat.coprime_two_left.mpr hodd] at h1
    exact hne (orderOf_eq_one_iff.mp (Nat.dvd_one.mp hgcd))
  refine ⟨x ^ (m / 2), ?_, ?_⟩
  · exact orderOf_eq_two_of hne hsq
  · rw [map_pow, hx]
    obtain ⟨t, ht⟩ := hoddhalf
    rw [ht, pow_succ, pow_mul, hv2sq, one_pow, one_mul]

/-- If `Y` is a nontrivial simple group, it is generated by its involutions. -/
theorem closure_involutions_eq_top_of_isSimpleGroup {Y : Type} [Group Y] [IsSimpleGroup Y]
    (hinv : ∃ v : Y, orderOf v = 2) :
    Subgroup.closure (Submission.Blueprint.involutions (⊤ : Set Y)) = ⊤ := by
  set W : Subgroup Y := Subgroup.closure (Submission.Blueprint.involutions (⊤ : Set Y)) with hW
  have hnormal : W.Normal := closure_involutions_normal
  rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal _ _ _ W hnormal with h | h
  · exfalso
    obtain ⟨v, hv⟩ := hinv
    have hmem : v ∈ (⊥ : Subgroup Y) :=
      h ▸ Subgroup.subset_closure (mem_involutions.mpr ⟨Subgroup.mem_top v, hv⟩)
    rw [Subgroup.mem_bot] at hmem
    rw [hmem, orderOf_one] at hv
    exact absurd hv (by norm_num)
  · exact h

/-- If `W ⊔ O = ⊤` with `O` a normal subgroup of odd order, then `W` has odd index. -/
theorem odd_index_of_sup_eq_top_of_odd {F : Type} [Group F] [Finite F] {W O : Subgroup F}
    (hW : W.Normal) (hO : O.Normal) (hOodd : Odd (Nat.card ↥O)) (hsup : W ⊔ O = ⊤) :
    Odd W.index := by
  haveI := hO
  haveI := hW
  have hsurj : Function.Surjective
      ((QuotientGroup.mk' W).comp O.subtype : ↥O →* F ⧸ W) := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective W x
    have ha : a ∈ W ⊔ O := by rw [hsup]; exact Subgroup.mem_top a
    obtain ⟨w, hw, o, ho, hwo⟩ := Subgroup.mem_sup_of_normal_left.mp ha
    refine ⟨⟨o, ho⟩, ?_⟩
    show QuotientGroup.mk' W o = QuotientGroup.mk' W a
    rw [← hwo, map_mul]
    have h1 : QuotientGroup.mk' W w = 1 := (QuotientGroup.eq_one_iff w).mpr hw
    rw [QuotientGroup.mk'_apply, h1, one_mul]
  set f : ↥O →* F ⧸ W := (QuotientGroup.mk' W).comp O.subtype with hf
  have hrange : f.range = ⊤ := MonoidHom.range_eq_top.mpr hsurj
  have hcard : (Nat.card ↥f.ker) * Nat.card (F ⧸ W) = Nat.card ↥O := by
    have h1 := Subgroup.card_mul_index f.ker
    rw [Subgroup.index_ker, hrange, Subgroup.card_top] at h1
    exact h1
  rw [Subgroup.index_eq_card]
  exact Odd.of_dvd_nat hOodd ⟨Nat.card ↥f.ker, hcard.symm.trans (Nat.mul_comm _ _)⟩

/-- If `F/oddCore F` is a simple group with involutions and `O^{2'}(F) = F`, then `F = ⟨Inv F⟩`.
This is the heart of the argument: `⟨Inv F⟩` has odd index in `F`, and `O^{2'}(F) = F` means that
`F` has no proper normal subgroup of odd index. -/
theorem closure_involutions_eq_top_of_quotient {F : Type} [Group F] [Finite F] {Y : Type}
    [Group Y] (φ : F →* Y) (hφ : Function.Surjective φ)
    (hker : φ.ker = Submission.Blueprint.oddCore F) (hY : IsSimpleGroup Y)
    (hinv : ∃ v : Y, orderOf v = 2) (hres : Submission.Blueprint.oddResidual F = ⊤) :
    Subgroup.closure (Submission.Blueprint.involutions (⊤ : Set F)) = ⊤ := by
  set W : Subgroup F := Subgroup.closure (Submission.Blueprint.involutions (⊤ : Set F)) with hW
  have hWn : W.Normal := closure_involutions_normal
  have hoddker : Odd (Nat.card ↥φ.ker) := by
    rw [hker]; exact Work.BrauerSuzuki.OddCore.oddCard_oddCore
  have himage : Subgroup.map φ W = ⊤ := by
    rw [hW, MonoidHom.map_closure]
    rw [eq_top_iff, ← closure_involutions_eq_top_of_isSimpleGroup hinv]
    refine Subgroup.closure_mono ?_
    rintro v hv
    obtain ⟨u, hu2, hsuv⟩ :=
      exists_involution_map_eq_of_ker_odd φ hφ hoddker (mem_involutions.mp hv).2
    exact ⟨u, mem_involutions.mpr ⟨Subgroup.mem_top u, hu2⟩, hsuv⟩
  have hsup : W ⊔ φ.ker = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : φ x ∈ Subgroup.map φ W := by rw [himage]; exact Subgroup.mem_top (φ x)
    obtain ⟨w, hw, hwx⟩ := Subgroup.mem_map.mp hx
    have hk : w⁻¹ * x ∈ φ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hwx, inv_mul_cancel]
    have hmem : w * (w⁻¹ * x) ∈ W ⊔ φ.ker := Subgroup.mul_mem_sup hw hk
    simpa using hmem
  have hodd : Odd W.index :=
    odd_index_of_sup_eq_top_of_odd hWn
      (by rw [hker]; exact Work.BrauerSuzuki.oddCore_normal F)
      (by rw [hker]; exact Work.BrauerSuzuki.OddCore.oddCard_oddCore) hsup
  have hmin := (Work.Reductions.oddResidual_basic (G := F)).2.2.1 W hWn hodd
  rw [hres] at hmin
  exact le_antisymm le_top hmin

/-! ## 2. Two elementary facts about `X` and `F = p3F X` -/

/-- `X ≤ H ⊓ H^t` for `X ≤ centD H t`. -/
theorem gen_le_twoPoint_of_le_centD {H : Subgroup G} {t : G} {X : Subgroup G}
    (hX : X ≤ centD H t) : X ≤ twoPoint H t :=
  hX.trans inf_le_left

/-- `t` centralises `X` for `X ≤ centD H t`. -/
theorem gen_mem_centralizer_of_le_centD {H : Subgroup G} {t : G} {X : Subgroup G}
    (hX : X ≤ centD H t) : t ∈ Subgroup.centralizer (X : Set G) := by
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  exact (mem_centD.mp (hX hx)).2.2

/-- `t ∈ F = O^{2'}(C_G(X))` for `X ≤ centD H t` and `orderOf t = 2`. -/
theorem gen_mem_p3F_t {H : Subgroup G} {t : G} (ht : orderOf t = 2) {X : Subgroup G}
    (hX : X ≤ centD H t) : t ∈ p3F X :=
  involution_mem_p3F ⟨gen_mem_centralizer_of_le_centD hX, ht⟩

/-- With `X ≠ ⊥`, `X ≤ centD H t` and `O_{2'}(G) = ⊥`, the group `F = O^{2'}(C_G(X))` is a
proper subgroup of `G`: this is what makes `(B1)` applicable to `F`. -/
theorem gen_card_p3F_lt (hS : Situation G) {H : Subgroup G} (hH : IsStronglyEmbedded H) {t : G}
    (htH : t ∉ H) {X : Subgroup G} (hX0 : X ≠ ⊥) (hX : X ≤ centD H t) :
    Nat.card ↥(p3F X) < Nat.card G := by
  set C : Subgroup G := Subgroup.centralizer (X : Set G) with hCdef
  have hCne : C ≠ ⊤ := by
    intro hCt
    apply hX0
    have hXn : X.Normal := ⟨fun x hx g => by
      have hg : g ∈ C := hCt ▸ Subgroup.mem_top g
      have hc : x * g = g * x := Subgroup.mem_centralizer_iff.mp hg x hx
      rw [← hc, mul_inv_cancel_right]; exact hx⟩
    have hXD : X ≤ twoPoint H t := gen_le_twoPoint_of_le_centD hX
    have hDodd : Odd (Nat.card ↥(twoPoint H t)) := hH.2.2 t htH
    have hXodd : Odd (Nat.card X) := Odd.of_dvd_nat hDodd (Subgroup.card_dvd_of_le hXD)
    have hXO : X ≤ Submission.Blueprint.oddCore G := le_sSup ⟨hXn, hXodd⟩
    rw [hS.2.2] at hXO
    exact le_bot_iff.mp hXO
  have hFC : p3F X ≤ C := p3F_le_centralizer X
  calc Nat.card ↥(p3F X) ≤ Nat.card C := Subgroup.card_le_of_le hFC
    _ < Nat.card G := by
      have h := Subgroup.card_lt_of_lt (lt_top_iff_ne_top.mpr hCne)
      simpa [Subgroup.card_top] using h

/-! ## 3. The target -/

theorem p3cd_gen_by_involutions {G : Type} [Group G] [Finite G]
    (hFT : Submission.Blueprint.FeitThompsonProp) (hC : Submission.Blueprint.ThmCProp)
    (hA : Submission.Blueprint.ThmAProp) (hZJ : Submission.Blueprint.GlaubermanZJProp)
    (hBrSz : Submission.Blueprint.BrauerSuzukiProp) (hMod : Submission.Blueprint.ModelFactsProp)
    (hS : Submission.Blueprint.Situation G) {H : Subgroup G}
    (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H) {t : G} (ht : orderOf t = 2)
    (htH : t ∉ H) (X : Subgroup G) (hX0 : X ≠ ⊥)
    (hX : X ≤ Submission.Blueprint.centD H t)
    (hNX : ∃ k ∈ Submission.Blueprint.invertedBy (Submission.Blueprint.twoPoint H t) t, k ≠ 1 ∧
      k ∈ Subgroup.normalizer (X : Set G)) :
    Subgroup.closure
      (Submission.Blueprint.involutions ((⊤ : Subgroup ↥(Work.ThreePoints.p3F X)) : Set ↥(Work.ThreePoints.p3F X))) = ⊤ := by
  -- the two inputs on `F = O^{2'}(C_G(X))`
  have hSE : IsStronglyEmbedded ((p3F X ⊓ H).subgroupOf (p3F X)) :=
    strongEmbedded_p3F_inf_H hFT hC hA hBrSz hS hH ht htH hX
  have hfour : Submission.Blueprint.HasFourGroup ↥(p3F X) :=
    p3cd_hasFourGroup hFT hC hA hZJ hBrSz hMod hS hH ht htH X hX0 hX hNX
  have hBH : Submission.Blueprint.BenderHyp ↥(p3F X) :=
    ⟨hfour, (p3F X ⊓ H).subgroupOf (p3F X), hSE⟩
  -- the induction hypothesis (B1) applied to `F`
  obtain ⟨L, hLn, -, hLidx, Y, hYgrp, φ, hφsurj, hφker, hYbender⟩ :=
    hS.2.1 ↥(p3F X) (gen_card_p3F_lt hS hH htH hX0 hX) hBH
  have hLtop : L = ⊤ := by
    have hle : Submission.Blueprint.oddResidual ↥(p3F X) ≤ L :=
      (Work.Reductions.oddResidual_basic (G := ↥(p3F X))).2.2.1 L hLn hLidx
    rw [oddResidual_p3F_eq_top' X] at hle
    exact top_le_iff.mp hle
  subst hLtop
  letI : Group Y := hYgrp
  haveI : Finite Y := Finite.of_surjective φ hφsurj
  let ψ : ↥(p3F X) →* Y :=
    φ.comp ((Subgroup.topEquiv (G := ↥(p3F X))).symm : ↥(p3F X) →* ↥(⊤ : Subgroup ↥(p3F X)))
  have hψsurj : Function.Surjective ψ :=
    hφsurj.comp (Subgroup.topEquiv (G := ↥(p3F X))).symm.surjective
  have hψker : ψ.ker = Submission.Blueprint.oddCore ↥(p3F X) := by
    have hψ : ψ = φ.comp
        ((Subgroup.topEquiv (G := ↥(p3F X))).symm : ↥(p3F X) →* ↥(⊤ : Subgroup ↥(p3F X))) := rfl
    ext x
    rw [MonoidHom.mem_ker, hψ, MonoidHom.comp_apply, ← MonoidHom.mem_ker, hφker]
    show ((Subgroup.topEquiv (G := ↥(p3F X))).symm x) ∈
        (Submission.Blueprint.oddCore ↥(p3F X)).subgroupOf (⊤ : Subgroup ↥(p3F X)) ↔
      x ∈ Submission.Blueprint.oddCore ↥(p3F X)
    rw [Subgroup.mem_subgroupOf, Subgroup.topEquiv_symm_apply_coe]
  have hYsimple : IsSimpleGroup Y := (hMod Y hYbender).1
  have htF : t ∈ p3F X := gen_mem_p3F_t ht hX
  have ht2' : orderOf (⟨t, htF⟩ : ↥(p3F X)) = 2 := by
    rw [← Subgroup.orderOf_coe (⟨t, htF⟩ : ↥(p3F X))]; exact ht
  have hkerOdd : Odd (Nat.card ↥ψ.ker) := by
    rw [hψker]; exact Work.BrauerSuzuki.OddCore.oddCard_oddCore
  have htne : ψ (⟨t, htF⟩ : ↥(p3F X)) ≠ 1 := by
    intro h1
    have hmem : (⟨t, htF⟩ : ↥(p3F X)) ∈ ψ.ker := h1
    have hdvd : orderOf (⟨t, htF⟩ : ↥(p3F X)) ∣ Nat.card ↥ψ.ker :=
      Subgroup.orderOf_dvd_natCard ψ.ker hmem
    rw [ht2'] at hdvd
    exact (Nat.not_even_iff_odd.mpr hkerOdd) (even_iff_two_dvd.mpr hdvd)
  have hinv : ∃ v : Y, orderOf v = 2 := by
    refine ⟨ψ (⟨t, htF⟩ : ↥(p3F X)), orderOf_eq_two_of htne ?_⟩
    rw [← map_mul, show (⟨t, htF⟩ : ↥(p3F X)) * (⟨t, htF⟩ : ↥(p3F X)) = 1 from
      mul_self_eq_one_of_orderOf_eq_two ht2', map_one]
  exact closure_involutions_eq_top_of_quotient ψ hψsurj hψker hYsimple hinv
    (oddResidual_p3F_eq_top' X)

end Work.ThreePoints
