open scoped Pointwise

namespace Work.ThreePoints

variable {V : Type*} [Group V] {G : Type*} [Group G] [MulDistribMulAction V G]

/-! ## Elementary API for `elemCent` -/

/-- `elemCent v` inside an invariant subgroup `H` is the trace of `elemCent v`. -/
theorem elemCent_subgroupOf {H : Subgroup G} [FT.IsInvariant V H] (v : V) :
    elemCent (G := ↥H) v = (elemCent (G := G) v).subgroupOf H := by
  ext x
  rw [Subgroup.mem_subgroupOf, mem_elemCent, mem_elemCent, Subtype.ext_iff,
    FT.coe_subgroup_smul]

/-- If the theorem holds on an invariant subgroup `H`, then `H` lies in the join in the ambient
group. -/
theorem le_sup_of_subgroup_top {a b : V} {H : Subgroup G} [FT.IsInvariant V H]
    (h : elemCent (G := ↥H) a ⊔ elemCent (G := ↥H) b ⊔ elemCent (G := ↥H) (a * b) = ⊤) :
    H ≤ elemCent (G := G) a ⊔ elemCent (G := G) b ⊔ elemCent (G := G) (a * b) := by
  have h2 := congrArg (Subgroup.map H.subtype) h
  rw [Subgroup.map_sup, Subgroup.map_sup, elemCent_subgroupOf, elemCent_subgroupOf,
      elemCent_subgroupOf, Subgroup.subgroupOf_map_subtype, Subgroup.subgroupOf_map_subtype,
      Subgroup.subgroupOf_map_subtype, Subgroup.map_top, Subgroup.range_subtype] at h2
  rw [← h2]
  exact sup_le (sup_le (le_trans inf_le_left (le_trans le_sup_left le_sup_left))
    (le_trans inf_le_left (le_trans le_sup_right le_sup_left)))
    (le_trans inf_le_left le_sup_right)

/-- Coprimality of `4` with an odd number. -/
theorem coprime_four_of_odd {n : ℕ} (h : Odd n) : Nat.Coprime 4 n := by
  have h2 : Nat.Coprime 2 n :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr (fun hd =>
      (Nat.not_even_iff_odd.mpr h) (even_iff_two_dvd.mpr hd))
  simpa using h2.pow_left 2

/-- The cardinality of a four-group presented as `{1,a,b,ab}`. -/
theorem natCard_eq_four {a b : V} (ha : a ≠ 1) (hb : b ≠ 1)
    (hne : a ≠ b) (ha2 : a * a = 1) (hb2 : b * b = 1)
    (hV : ∀ v : V, v = 1 ∨ v = a ∨ v = b ∨ v = a * b) :
    Nat.card V = 4 := by
  have hab1 : a * b ≠ 1 := by
    intro h
    exact hne (mul_left_cancel (show a * b = a * a by rw [h, ha2])).symm
  have haba : a * b ≠ a := by
    intro h
    exact hb (mul_left_cancel (show a * b = a * 1 by rw [h, mul_one]))
  have habb : a * b ≠ b := by
    intro h
    exact ha (mul_right_cancel (show a * b = 1 * b by rw [h, one_mul]))
  have huniv : ({1, a, b, a * b} : Set V) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro v
    rcases hV v with h | h | h | h <;> simp [h]
  have hnotmem1 : (1 : V) ∉ ({a, b, a * b} : Set V) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨fun h => ha h.symm, fun h => hb h.symm, fun h => hab1 h.symm⟩
  have hnotmema : a ∉ ({b, a * b} : Set V) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨hne, fun h => haba h.symm⟩
  have hnotmemb : b ∉ ({a * b} : Set V) := by
    simp only [Set.mem_singleton_iff]; exact fun h => habb h.symm
  rw [← Set.ncard_univ, ← huniv]
  rw [show ({1, a, b, a * b} : Set V) = insert 1 (insert a (insert b ({a * b} : Set V)))
    from rfl]
  rw [Set.ncard_insert_of_notMem hnotmem1, Set.ncard_insert_of_notMem hnotmema,
      Set.ncard_insert_of_notMem hnotmemb, Set.ncard_singleton]

/-! ## The induction -/

/-- Strong induction on `|G|` for the four-group generation theorem. -/
theorem fourGroup_aux [Finite V] (a b : V) (hcardV : Nat.card V = 4)
    (ha : a ≠ 1) (hb : b ≠ 1) (hne : a ≠ b)
    (ha2 : a * a = 1) (hb2 : b * b = 1) (hcomm : a * b = b * a)
    (hV : ∀ v : V, v = 1 ∨ v = a ∨ v = b ∨ v = a * b) :
    ∀ n, ∀ (G : Type*) [Group G] [Finite G] [MulDistribMulAction V G],
      Nat.card G = n → Odd (Nat.card G) →
      elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b) = ⊤ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hVpg : IsPGroup 2 V := IsPGroup.of_card (n := 2) (by rw [hcardV]; norm_num)
  haveI : Group.IsNilpotent V := IsPGroup.isNilpotent hVpg
  haveI : Group.IsSolvable V := IsNilpotent.to_isSolvable
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro G _ _ _ hcard hodd
    by_cases hZtop : Subgroup.center G = ⊤
    · -- `G` is abelian
      haveI : IsMulCommutative G := Subgroup.center_eq_top_iff.mp hZtop
      exact abelian_elemCent_sup_eq_top ha2 hb2 hcomm hodd
    by_cases hZbot : Subgroup.center G = ⊥
    · -- `Z(G) = ⊥`: `G` has no centre, hence is no `p`-group; reduce to invariant Sylows
      have hnt : Nontrivial G := by
        rw [← not_subsingleton_iff_nontrivial]
        intro hss
        refine hZtop (top_le_iff.mp fun x _ => ?_)
        exact Subgroup.mem_center_iff.mpr fun y => Subsingleton.elim (y * x) (x * y)
      have hcopVG : (Nat.card V).Coprime (Nat.card G) := by
        rw [hcardV]; exact coprime_four_of_odd hodd
      have hKdvd : Nat.card G ∣ Nat.card ↥(elemCent (G := G) a ⊔ elemCent b ⊔
          elemCent (a * b)) := by
        apply card_dvd_of_prime_pow_factorization_dvd
        intro p hp hpdvd
        haveI : Fact p.Prime := ⟨hp⟩
        obtain ⟨P, hPinv⟩ :=
          Work.Coprime.exists_invariant_sylow V hcopVG (Or.inl inferInstance) p
        haveI : FT.IsInvariant V (P : Subgroup G) := isInvariant_of_sylow_invariant P hPinv
        have hcardP : Nat.card ↥(P : Subgroup G) = p ^ (Nat.card G).factorization p :=
          Sylow.card_eq_multiplicity P
        have hne_top : (P : Subgroup G) ≠ ⊤ := by
          intro hTop
          have hpG : IsPGroup p G := IsPGroup.of_card (n := (Nat.card G).factorization p)
            (by rw [← hcardP, hTop, Subgroup.card_top])
          have hcenter : ⊥ < Subgroup.center G := hpG.bot_lt_center
          rw [hZbot] at hcenter
          exact lt_irrefl _ hcenter
        have hPlt : Nat.card ↥(P : Subgroup G) < n := by
          have hle := Subgroup.card_le_card_group (P : Subgroup G)
          have hlt : Nat.card ↥(P : Subgroup G) < Nat.card G :=
            lt_of_le_of_ne hle (fun h => hne_top (Subgroup.eq_top_of_card_eq _ h))
          rwa [hcard] at hlt
        have hoddP : Odd (Nat.card ↥(P : Subgroup G)) :=
          Odd.of_dvd_nat hodd (Subgroup.card_subgroup_dvd_card _)
        have hihP := ih _ hPlt ↥(P : Subgroup G) rfl hoddP
        rw [← hcardP]
        exact Subgroup.card_dvd_of_le (le_sup_of_subgroup_top hihP)
      have hKeq : Nat.card ↥(elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b)) =
          Nat.card G :=
        Nat.dvd_antisymm (Subgroup.card_subgroup_dvd_card _) hKdvd
      exact Subgroup.eq_top_of_card_eq _ hKeq
    · -- `1 ≠ Z(G) ≠ ⊤`: reduce to `Z(G)` and `G ⧸ Z(G)`
      haveI : FT.IsInvariant V (Subgroup.center G) :=
        FT.IsInvariant.of_characteristic Subgroup.centerCharacteristic
      -- induction hypothesis on the centre
      have hZlt : Nat.card ↥(Subgroup.center G) < n := by
        have hlt : (Subgroup.center G) < ⊤ := lt_top_iff_ne_top.mpr hZtop
        have := Subgroup.card_lt_of_lt hlt
        rwa [Subgroup.card_top, hcard] at this
      have hoddZ : Odd (Nat.card ↥(Subgroup.center G)) :=
        Odd.of_dvd_nat hodd (Subgroup.card_subgroup_dvd_card _)
      have hZle : Subgroup.center G ≤
          elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b) :=
        le_sup_of_subgroup_top (ih _ hZlt ↥(Subgroup.center G) rfl hoddZ)
      -- induction hypothesis on the quotient
      have hcardZ : 1 < Nat.card ↥(Subgroup.center G) :=
        (Subgroup.one_lt_card_iff_ne_bot _).mpr hZbot
      have hmul : Nat.card ↥(Subgroup.center G) * (Subgroup.center G).index = Nat.card G :=
        Subgroup.card_mul_index _
      have hQlt : Nat.card (G ⧸ Subgroup.center G) < n := by
        have hpos : 0 < (Subgroup.center G).index :=
          Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite (H := Subgroup.center G))
        rw [← hcard, ← Subgroup.index_eq_card]
        calc (Subgroup.center G).index < 2 * (Subgroup.center G).index := by omega
          _ ≤ Nat.card ↥(Subgroup.center G) * (Subgroup.center G).index :=
              Nat.mul_le_mul_right _ (by omega : 2 ≤ Nat.card ↥(Subgroup.center G))
          _ = Nat.card G := hmul
      have hoddQ : Odd (Nat.card (G ⧸ Subgroup.center G)) := by
        rw [← Subgroup.index_eq_card]
        exact Odd.of_dvd_nat hodd (Subgroup.index_dvd_card _)
      have hihQ := ih _ hQlt (G ⧸ Subgroup.center G) rfl hoddQ
      -- the image of the join is everything
      have hab2 : (a * b) * (a * b) = 1 := by
        calc (a * b) * (a * b) = a * (b * (a * b)) := by rw [mul_assoc]
          _ = a * ((b * a) * b) := by rw [← mul_assoc b a b]
          _ = a * ((a * b) * b) := by rw [hcomm]
          _ = a * (a * (b * b)) := by rw [mul_assoc a b b]
          _ = a * (a * 1) := by rw [hb2]
          _ = a * a := by rw [mul_one]
          _ = 1 := ha2
      have hKm : (elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b)).map
          (QuotientGroup.mk' (Subgroup.center G)) = ⊤ := by
        rw [Subgroup.map_sup, Subgroup.map_sup,
          elemCent_map_mk a ha2 (Subgroup.center G) hodd,
          elemCent_map_mk b hb2 (Subgroup.center G) hodd,
          elemCent_map_mk (a * b) hab2 (Subgroup.center G) hodd]
        exact hihQ
      have hZK : (elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b)) ⊔
          Subgroup.center G = ⊤ := by
        have hcomap : Subgroup.comap (QuotientGroup.mk' (Subgroup.center G))
            ((elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b)).map
              (QuotientGroup.mk' (Subgroup.center G))) = ⊤ := by
          rw [hKm, Subgroup.comap_top]
        rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk'] at hcomap
        exact hcomap
      rw [sup_eq_left.mpr hZle] at hZK
      exact hZK

/-- The subgroup generated by two commuting involutions consists of `1`, `a`, `b`, `ab`. -/
theorem closure_pair_mem_four {G : Type*} [Group G] {a b : G} (ha2 : a * a = 1)
    (hb2 : b * b = 1) (hcomm : a * b = b * a) :
    ∀ x ∈ Subgroup.closure ({a, b} : Set G), x = 1 ∨ x = a ∨ x = b ∨ x = a * b := by
  have hba : b * a = a * b := hcomm.symm
  have hab2 : (a * b) * (a * b) = 1 := by
    calc (a * b) * (a * b) = a * (b * (a * b)) := by rw [mul_assoc]
      _ = a * ((b * a) * b) := by rw [← mul_assoc b a b]
      _ = a * ((a * b) * b) := by rw [hba]
      _ = a * (a * (b * b)) := by rw [mul_assoc a b b]
      _ = a * (a * 1) := by rw [hb2]
      _ = a * a := by rw [mul_one]
      _ = 1 := ha2
  have h1 : a * (a * b) = b := by rw [← mul_assoc, ha2, one_mul]
  have h4 : b * (a * b) = a := by rw [← mul_assoc, hba, mul_assoc, hb2, mul_one]
  have h5 : (a * b) * a = b := by rw [mul_assoc, hba, ← mul_assoc, ha2, one_mul]
  have h6 : (a * b) * b = a := by rw [mul_assoc, hb2, mul_one]
  have hmul : ∀ y z : G, (y = 1 ∨ y = a ∨ y = b ∨ y = a * b) →
      (z = 1 ∨ z = a ∨ z = b ∨ z = a * b) →
      (y * z = 1 ∨ y * z = a ∨ y * z = b ∨ y * z = a * b) := by
    intro y z hy hz
    rcases hy with h | h | h | h
    · rcases hz with h' | h' | h' | h'
      · rw [h, h']; exact Or.inl (one_mul 1)
      · rw [h, h']; exact Or.inr (Or.inl (one_mul a))
      · rw [h, h']; exact Or.inr (Or.inr (Or.inl (one_mul b)))
      · rw [h, h']; exact Or.inr (Or.inr (Or.inr (one_mul (a * b))))
    · rcases hz with h' | h' | h' | h'
      · rw [h, h']; exact Or.inr (Or.inl (mul_one a))
      · rw [h, h']; exact Or.inl ha2
      · rw [h, h']; exact Or.inr (Or.inr (Or.inr rfl))
      · rw [h, h']; exact Or.inr (Or.inr (Or.inl h1))
    · rcases hz with h' | h' | h' | h'
      · rw [h, h']; exact Or.inr (Or.inr (Or.inl (mul_one b)))
      · rw [h, h']; exact Or.inr (Or.inr (Or.inr hba))
      · rw [h, h']; exact Or.inl hb2
      · rw [h, h']; exact Or.inr (Or.inl h4)
    · rcases hz with h' | h' | h' | h'
      · rw [h, h']; exact Or.inr (Or.inr (Or.inr (mul_one (a * b))))
      · rw [h, h']; exact Or.inr (Or.inr (Or.inl h5))
      · rw [h, h']; exact Or.inr (Or.inl h6)
      · rw [h, h']; exact Or.inl hab2
  have hinv : ∀ y : G, (y = 1 ∨ y = a ∨ y = b ∨ y = a * b) →
      (y⁻¹ = 1 ∨ y⁻¹ = a ∨ y⁻¹ = b ∨ y⁻¹ = a * b) := by
    intro y hy
    rcases hy with h | h | h | h <;> rw [h]
    · exact Or.inl (by rw [inv_one])
    · exact Or.inr (Or.inl (inv_eq_of_mul_eq_one_left ha2))
    · exact Or.inr (Or.inr (Or.inl (inv_eq_of_mul_eq_one_left hb2)))
    · exact Or.inr (Or.inr (Or.inr (inv_eq_of_mul_eq_one_left hab2)))
  set W : Subgroup G :=
    { carrier := {x | x = 1 ∨ x = a ∨ x = b ∨ x = a * b}
      one_mem' := Or.inl rfl
      mul_mem' := fun hx hy => hmul _ _ hx hy
      inv_mem' := fun hx => hinv _ hx }
  have hle : Subgroup.closure ({a, b} : Set G) ≤ W := by
    rw [Subgroup.closure_le]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
  intro x hx
  exact hle hx

/-- **The abstract four-group generation theorem** (Gorenstein 5.3.16 for `q = 2`): a finite
group of odd order on which the four-group `{1,a,b,ab}` acts by automorphisms is generated by
the centralisers of the three involutions. -/
theorem fourGroup_elemCent_sup_eq_top [Finite V] [Finite G] {a b : V}
    (ha : a ≠ 1) (hb : b ≠ 1) (hne : a ≠ b)
    (ha2 : a * a = 1) (hb2 : b * b = 1) (hcomm : a * b = b * a)
    (hV : ∀ v : V, v = 1 ∨ v = a ∨ v = b ∨ v = a * b)
    (hodd : Odd (Nat.card G)) :
    elemCent (G := G) a ⊔ elemCent b ⊔ elemCent (a * b) = ⊤ :=
  fourGroup_aux (V := V) a b (natCard_eq_four ha hb hne ha2 hb2 hV) ha hb hne ha2 hb2 hcomm hV
    (Nat.card G) G rfl hodd

/-- For the conjugation action of a subgroup `A ≤ X` on a subgroup `H ≤ X` it normalises, the
centraliser of `v ∈ A` inside `H` is the trace of the centraliser of `v` in `X`. -/
theorem elemCent_conj_map {X : Type*} [Group X] {A H : Subgroup X} [FT.Normalizes A H] (v : A) :
    (elemCent (G := ↥H) v).map H.subtype =
      Subgroup.centralizer ({(v : X)} : Set X) ⊓ H := by
  ext x
  rw [Subgroup.mem_map, Subgroup.mem_inf]
  constructor
  · rintro ⟨y, hy, hxy⟩
    refine ⟨?_, hxy ▸ y.property⟩
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    subst hw
    rw [mem_elemCent] at hy
    have hcoe := congrArg Subtype.val hy
    rw [FT.conj_smul_coe] at hcoe
    rw [← hxy]
    calc (v : X) * (y : X) = (v : X) * (y : X) * (v : X)⁻¹ * (v : X) := by group
      _ = (y : X) * (v : X) := by rw [hcoe]
  · rintro ⟨hx, hxH⟩
    refine ⟨⟨x, hxH⟩, ?_, rfl⟩
    rw [mem_elemCent]
    apply Subtype.ext
    rw [FT.conj_smul_coe]
    rw [Subgroup.mem_centralizer_iff] at hx
    have h := hx (v : X) (Set.mem_singleton (v : X))
    rw [h, mul_assoc, mul_inv_cancel, mul_one]

end Work.ThreePoints
