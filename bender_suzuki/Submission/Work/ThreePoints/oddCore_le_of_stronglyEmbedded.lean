/-!
# `O_{2'}(G) ≤ H` for a strongly embedded `H` in a group of 2-rank `≥ 2`

This file proves Peterfalvi I Ch. I §1 (9) in the special case `p = 2`:

> If `G` is a finite group with `2`-rank `≥ 2` and `H` is a strongly embedded subgroup
> (`Bender` group for `p = 2`), then `O_{2'}(G) ≤ H`.

Here `O_{2'}(G)` is `Submission.Blueprint.oddCore G`, the largest normal subgroup of `G` of odd
order ("`2`-rank `≥ 2`" is the hypothesis `Submission.Blueprint.HasFourGroup G`).

The argument is the one in the source.

* A strongly embedded subgroup contains a Sylow `2`-subgroup of `G`
  (`Work.ThreePoints.exists_sylow_le`); since `G` has a four-group, `H` itself contains two
  distinct commuting involutions `a`, `b` (conjugate the four-group into the Sylow of `H`).
* For an involution `x ∈ H`, `C_G(x) ≤ H` (`Work.Reductions.stronglyEmbedded_centralizer_le`).
* Coprime action (Huppert I.18.6 / Gorenstein 5.3.16, here
  `Work.ThreePoints.sup_centralizer_eq_of_fourGroup`): an odd-order group on which the four-group
  `{1,a,b,ab}` acts by conjugation is generated by the centralisers of `a`, `b`, `ab`.

Applying the last point to a normal odd-order subgroup `N ⊴ G` gives
`N ≤ C_G(a) ⊔ C_G(b) ⊔ C_G(ab) ≤ H`, and `O_{2'}(G)` is the supremum of such `N`.
-/

open scoped Pointwise

namespace Work.ThreePoints

/-! ## A four-group inside a strongly embedded subgroup -/

/-- A strongly embedded subgroup of a finite group of `2`-rank `≥ 2` contains two distinct
commuting involutions.

Let `S ≤ H` be a Sylow `2`-subgroup of `G` (`Work.ThreePoints.exists_sylow_le`).  The four-group
`V = ⟨a₀, b₀⟩` supplied by `HasFourGroup G` is a `2`-subgroup, hence lies in some Sylow
`2`-subgroup `T`; Sylow conjugacy gives `T = g • S`, so `V^{g⁻¹} ≤ S ≤ H`.  The images of `a₀`,
`b₀` under `MulAut.conj g⁻¹` are the required involutions. -/
private theorem exists_involutions_mem_aux {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H)
    (hfour : Submission.Blueprint.HasFourGroup G) :
    ∃ a b : G, a ∈ H ∧ b ∈ H ∧ orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a := by
  obtain ⟨a₀, b₀, ha₀, hb₀, hne₀, hcomm₀⟩ := hfour
  have ha₀_mul : a₀ * a₀ = 1 := by
    have h := pow_orderOf_eq_one a₀; rw [ha₀] at h; simpa [pow_two] using h
  have hb₀_mul : b₀ * b₀ = 1 := by
    have h := pow_orderOf_eq_one b₀; rw [hb₀] at h; simpa [pow_two] using h
  let V : Subgroup G := Subgroup.closure ({a₀, b₀} : Set G)
  have hVmem : ∀ x ∈ V, x = 1 ∨ x = a₀ ∨ x = b₀ ∨ x = a₀ * b₀ :=
    fun x hx => Work.ThreePoints.closure_pair_mem_four ha₀_mul hb₀_mul hcomm₀ x hx
  have hsq : ∀ x ∈ V, x ^ 2 = 1 := by
    intro x hx
    rcases hVmem x hx with h | h | h | h
    · rw [h]; simp
    · rw [h, pow_two]; exact ha₀_mul
    · rw [h, pow_two]; exact hb₀_mul
    · rw [h]
      calc (a₀ * b₀) ^ 2 = a₀ * (b₀ * (a₀ * b₀)) := by rw [pow_two, mul_assoc]
        _ = a₀ * ((b₀ * a₀) * b₀) := by rw [mul_assoc b₀ a₀ b₀]
        _ = a₀ * ((a₀ * b₀) * b₀) := by rw [hcomm₀]
        _ = a₀ * (a₀ * (b₀ * b₀)) := by rw [mul_assoc a₀ b₀ b₀]
        _ = (a₀ * a₀) * (b₀ * b₀) := by rw [← mul_assoc a₀ a₀ (b₀ * b₀)]
        _ = 1 := by rw [ha₀_mul, hb₀_mul, mul_one]
  have hVpg : IsPGroup 2 V := by
    rw [isPGroup_iff_orderOf_dvd_pow]
    intro y
    refine ⟨1, ?_⟩
    rw [pow_one, ← Subgroup.orderOf_coe y, orderOf_dvd_iff_pow_eq_one]
    exact hsq (y : G) y.2
  obtain ⟨S, hSH⟩ := Work.ThreePoints.exists_sylow_le hH
  obtain ⟨T, hVT⟩ := hVpg.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G S T
  have key : ∀ v ∈ V, (MulAut.conj g⁻¹) v ∈ H := by
    intro v hv
    have hsm : v ∈ MulAut.conj g • (S : Set G) := by
      rw [← Sylow.coe_smul, hg]
      exact hVT hv
    rw [Set.mem_smul_set] at hsm
    obtain ⟨s, hs, hsv⟩ := hsm
    rw [MulAut.smul_def, MulAut.conj_apply] at hsv
    have : (MulAut.conj g⁻¹) v = s := by rw [MulAut.conj_apply, ← hsv]; group
    rw [this]
    exact hSH hs
  refine ⟨(MulAut.conj g⁻¹) a₀, (MulAut.conj g⁻¹) b₀, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact key a₀ (Subgroup.subset_closure (by simp))
  · exact key b₀ (Subgroup.subset_closure (by simp))
  · rw [(MulAut.conj g⁻¹).orderOf_eq a₀]; exact ha₀
  · rw [(MulAut.conj g⁻¹).orderOf_eq b₀]; exact hb₀
  · intro h
    apply hne₀
    have := congrArg (MulAut.conj g) h
    simpa using this
  · rw [← map_mul, ← map_mul, hcomm₀]

/-! ## Normal odd-order subgroups lie in `H` -/

/-- If `H` is strongly embedded and contains two distinct commuting involutions `a`, `b`, then
every normal subgroup `N ⊴ G` of odd order is contained in `H`.

Indeed `{1,a,b,ab}` is a four-group acting on the odd-order normal subgroup `N` by conjugation,
so by coprime action (`Work.ThreePoints.sup_centralizer_eq_of_fourGroup`)
`N ≤ C_G(a) ⊔ C_G(b) ⊔ C_G(ab)`, and each of these centralisers lies in `H` because `a`, `b`,
`ab` are involutions of `H`. -/
private theorem normal_odd_le_aux {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H) {a b : G}
    (ha : a ∈ H) (hb : b ∈ H) (ha2 : orderOf a = 2) (hb2 : orderOf b = 2)
    (hne : a ≠ b) (hcomm : a * b = b * a)
    {N : Subgroup G} (hNn : N.Normal) (hNo : Odd (Nat.card N)) : N ≤ H := by
  have ha_sq : a ^ 2 = 1 := by have h := pow_orderOf_eq_one a; rwa [ha2] at h
  have hb_sq : b ^ 2 = 1 := by have h := pow_orderOf_eq_one b; rwa [hb2] at h
  have ha_mul : a * a = 1 := by rw [← pow_two]; exact ha_sq
  have hb_mul : b * b = 1 := by rw [← pow_two]; exact hb_sq
  have hab_sq : (a * b) ^ 2 = 1 := by
    calc (a * b) ^ 2 = a * (b * (a * b)) := by rw [pow_two, mul_assoc]
      _ = a * ((b * a) * b) := by rw [mul_assoc b a b]
      _ = a * ((a * b) * b) := by rw [hcomm]
      _ = a * (a * (b * b)) := by rw [mul_assoc a b b]
      _ = (a * a) * (b * b) := by rw [← mul_assoc a a (b * b)]
      _ = 1 := by rw [ha_mul, hb_mul, mul_one]
  have hab_ne1 : a * b ≠ 1 := by
    intro h
    apply hne
    calc a = a * 1 := (mul_one a).symm
      _ = a * (b * b) := by rw [hb_mul]
      _ = (a * b) * b := by rw [mul_assoc]
      _ = 1 * b := by rw [h]
      _ = b := one_mul b
  have hab2 : orderOf (a * b) = 2 := by
    have h2 : orderOf (a * b) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hab_sq
    rcases (Nat.dvd_prime Nat.prime_two).mp h2 with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hab_ne1
    · exact h
  have hCa : Subgroup.centralizer ({a} : Set G) ≤ H :=
    Work.Reductions.stronglyEmbedded_centralizer_le hH ha ha2
  have hCb : Subgroup.centralizer ({b} : Set G) ≤ H :=
    Work.Reductions.stronglyEmbedded_centralizer_le hH hb hb2
  have hCab : Subgroup.centralizer ({a * b} : Set G) ≤ H :=
    Work.Reductions.stronglyEmbedded_centralizer_le hH (H.mul_mem ha hb) hab2
  have hAO : Subgroup.closure ({a, b} : Set G) ≤ Subgroup.normalizer (N : Set G) := by
    rw [Subgroup.normalizer_eq_top_iff.mpr hNn]; exact le_top
  have hgen : N ≤ Subgroup.centralizer ({a} : Set G) ⊔ Subgroup.centralizer ({b} : Set G) ⊔
      Subgroup.centralizer ({a * b} : Set G) :=
    Work.ThreePoints.sup_centralizer_eq_of_fourGroup ha2 hb2 hne hcomm hNo hAO
  exact le_trans hgen (sup_le (sup_le hCa hCb) hCab)

/-! ## The main lemma -/

/-- **Peterfalvi I Ch. I §1 (9) for `p = 2`.**  In a finite group `G` with `2`-rank `≥ 2`
(`Submission.Blueprint.HasFourGroup G`), the `2'`-core `O_{2'}(G) = Submission.Blueprint.oddCore G`
of every strongly embedded subgroup `H` is contained in `H`. -/
theorem oddCore_le_of_stronglyEmbedded {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H)
    (hfour : Submission.Blueprint.HasFourGroup G) : Submission.Blueprint.oddCore G ≤ H := by
  obtain ⟨a, b, haH, hbH, ha2, hb2, hne, hcomm⟩ := exists_involutions_mem_aux hH hfour
  rw [Submission.Blueprint.oddCore]
  refine sSup_le ?_
  rintro N ⟨hNn, hNo⟩
  exact normal_odd_le_aux hH haH hbH ha2 hb2 hne hcomm hNn hNo

end Work.ThreePoints
