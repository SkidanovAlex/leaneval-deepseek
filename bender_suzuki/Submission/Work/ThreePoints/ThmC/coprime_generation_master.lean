open scoped Pointwise

namespace Work.ThreePoints.ThmC

/-! ## The master lemma: strong induction on `|Y|` -/

section Master

variable {G : Type} [Group G] [Finite G] {S : Set G} {u : G}

/-- **Master lemma.**  Let `S ⊆ G` consist of elements inverted by the involution `u`, suppose
that `S ∪ {u}` generates `G` and that `⟨S⟩` has odd order, and let `Y` be a finite solvable
`G`-group of order coprime to `|G|`.  Then `Y = Ksub S Y`. -/
theorem Ksub_eq_top_aux (hu : orderOf u = 2) (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) (hgen : M₀ S u = ⊤)
    (hSodd : Odd (Nat.card ↥(Subgroup.closure S))) :
    ∀ (n : ℕ) (Y : Type) [Group Y] [Finite Y] [MulDistribMulAction G Y],
      Nat.card Y = n → Nat.Coprime (Nat.card G) (Nat.card Y) → Group.IsSolvable Y →
      Ksub S Y = ⊤ := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro Y _ _ _ hcard hcop hsolv
    by_cases hab : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ = ⊥
    · -- ## `Y` commutative: quotient by `Ksub S Y`
      haveI : IsMulCommutative Y := IsMulCommutative.of_comm fun a b => by
        have ha : a ∈ Subgroup.centralizer ((⊤ : Subgroup Y) : Set Y) :=
          Subgroup.commutator_eq_bot_iff_le_centralizer.mp hab (Subgroup.mem_top a)
        exact ((Subgroup.mem_centralizer_iff.mp ha) b (Subgroup.mem_top b)).symm
      haveI hKn : (Ksub S Y).Normal := (Ksub S Y).normal_of_isMulCommutative
      haveI hKi : FT.IsInvariant G (Ksub S Y) := Ksub_invariant_top hSinv hSclosed hgen
      have hdvdS : Nat.card ↥(Subgroup.closure S) ∣ Nat.card G := by
        simpa using Subgroup.card_dvd_of_le (le_top : Subgroup.closure S ≤ ⊤)
      have hsub : Subsingleton (Y ⧸ Ksub S Y) := by
        refine subsingleton_of_fix_eq_bot (M := G) (Y := Y ⧸ Ksub S Y) (S := S) (u := u)
          hu hSinv hSodd ?_ ?_
        · -- fixed points of `⟨S⟩` in the quotient are trivial
          intro z hz
          have hz' : z ∈ FT.fixedPoints ↥(Subgroup.closure S) (Y ⧸ Ksub S Y) := by
            rw [FT.mem_fixedPoints]
            intro a
            exact fixed_of_mem_closure hz a a.2
          haveI : FT.IsInvariant ↥(Subgroup.closure S) (Ksub S Y) :=
            Ksub_invariant_closure hSinv hSclosed
          have hq : (FT.fixedPoints ↥(Subgroup.closure S) Y).map
                (QuotientGroup.mk' (Ksub S Y))
              = FT.fixedPoints ↥(Subgroup.closure S) (Y ⧸ Ksub S Y) :=
            Work.Coprime.fixedPoints_quotient ↥(Subgroup.closure S)
              (hcop.coprime_dvd_left hdvdS) (Or.inr hsolv) (Ksub S Y)
          have hone : FT.fixedPoints ↥(Subgroup.closure S) (Y ⧸ Ksub S Y) = ⊥ :=
            hq.symm.trans (Subgroup.map_eq_bot_iff _ |>.mpr
              (le_trans (fixedPoints_le_Ksub S) (by rw [QuotientGroup.ker_mk'])))
          rw [hone] at hz'
          exact hz'
        · -- fixed points of an involution in the quotient are trivial
          intro v hv z hz
          have hz' : z ∈ FT.fixedPoints ↥(Subgroup.zpowers v) (Y ⧸ Ksub S Y) := by
            rw [FT.mem_fixedPoints]
            intro a
            have hv_fix : v ∈ fixator (G := G) (Y := Y ⧸ Ksub S Y) z := hz
            exact (Subgroup.zpowers_le (H := fixator (G := G) (Y := Y ⧸ Ksub S Y) z)).mpr
              hv_fix a.2
          have hdvdz : Nat.card ↥(Subgroup.zpowers v) ∣ Nat.card G := by
            simpa using Subgroup.card_dvd_of_le (le_top : Subgroup.zpowers v ≤ ⊤)
          have hvM : Subgroup.zpowers v ≤ M₀ S u := fun a _ => by
            rw [hgen]
            exact Subgroup.mem_top a
          haveI : FT.IsInvariant ↥(Subgroup.zpowers v) (Ksub S Y) :=
            Ksub_invariant_of_le hSinv hSclosed hvM
          have hq : (FT.fixedPoints ↥(Subgroup.zpowers v) Y).map
                (QuotientGroup.mk' (Ksub S Y))
              = FT.fixedPoints ↥(Subgroup.zpowers v) (Y ⧸ Ksub S Y) :=
            Work.Coprime.fixedPoints_quotient ↥(Subgroup.zpowers v)
              (hcop.coprime_dvd_left hdvdz) (Or.inr hsolv) (Ksub S Y)
          have hone : FT.fixedPoints ↥(Subgroup.zpowers v) (Y ⧸ Ksub S Y) = ⊥ :=
            hq.symm.trans (Subgroup.map_eq_bot_iff _ |>.mpr
              (le_trans (fixedPoints_zpowers_le_Ksub S hv) (by rw [QuotientGroup.ker_mk'])))
          rw [hone] at hz'
          exact hz'
      rw [QuotientGroup.subsingleton_iff] at hsub
      exact hsub
    · -- ## `Y` not commutative: split off the derived subgroup
      haveI := hsolv
      have htopne : (⊤ : Subgroup Y) ≠ ⊥ := fun h => hab (by rw [h]; simp)
      have hLlt' : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ < ⊤ :=
        Group.IsSolvable.commutator_lt_of_ne_bot (H := ⊤) htopne
      set L : Subgroup Y := ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ with hL
      have hLne : L ≠ ⊥ := by rw [hL]; exact hab
      have hLnormal : L.Normal := by rw [hL]; infer_instance
      haveI : L.Normal := hLnormal
      have hLchar : L.Characteristic := by rw [hL]; infer_instance
      haveI : FT.IsInvariant G L := FT.IsInvariant.of_characteristic hLchar
      have hLlt : L < ⊤ := by rw [hL]; exact hLlt'
      have hLcard : Nat.card ↥L < Nat.card Y := by
        simpa using Subgroup.card_lt_of_lt hLlt
      have hLcop : Nat.Coprime (Nat.card G) (Nat.card ↥L) :=
        hcop.coprime_dvd_right (by
          simpa using Subgroup.card_dvd_of_le (le_top : L ≤ ⊤))
      have hLsolv : Group.IsSolvable ↥L := Group.isSolvable_of_isSolvable_injective L.subtype_injective
      have hIH_L : Ksub S ↥L = ⊤ :=
        ih (Nat.card ↥L) (by rw [← hcard]; exact hLcard) ↥L rfl hLcop hLsolv
      have hLK : L ≤ Ksub S Y := by
        have h := map_Ksub_subgroup (M := G) (Y := Y) S L
        rw [hIH_L, Subgroup.map_top, Subgroup.range_subtype] at h
        exact h
      have hQcard : Nat.card (Y ⧸ L) < Nat.card Y := by
        rw [← Subgroup.index_eq_card]
        have hpos : 0 < L.index := by
          rw [Subgroup.index_eq_card]
          exact Nat.card_pos
        have h1 : 1 < Nat.card ↥L := (Subgroup.one_lt_card_iff_ne_bot L).mpr hLne
        calc L.index = L.index * 1 := (mul_one _).symm
          _ < L.index * Nat.card ↥L := Nat.mul_lt_mul_of_pos_left h1 hpos
          _ = Nat.card Y := by rw [mul_comm, Subgroup.card_mul_index]
      have hQcop : Nat.Coprime (Nat.card G) (Nat.card (Y ⧸ L)) := by
        rw [← Subgroup.index_eq_card]
        exact hcop.coprime_dvd_right ⟨Nat.card ↥L, by rw [mul_comm, Subgroup.card_mul_index]⟩
      have hQsolv : Group.IsSolvable (Y ⧸ L) :=
        Group.isSolvable_of_surjective (QuotientGroup.mk'_surjective L)
      have hIH_Q : Ksub S (Y ⧸ L) = ⊤ :=
        ih (Nat.card (Y ⧸ L)) (by rw [← hcard]; exact hQcard) (Y ⧸ L) rfl hQcop hQsolv
      have htop : Ksub S Y ⊔ L = ⊤ := by
        have hmap := map_Ksub_quotient (M := G) (Y := Y) S hcop hsolv L
        rw [hIH_Q] at hmap
        have h1 : Subgroup.comap (QuotientGroup.mk' L)
            ((Ksub S Y ⊔ L).map (QuotientGroup.mk' L)) = Ksub S Y ⊔ L := by
          rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk']
          exact sup_eq_left.mpr le_sup_right
        rw [hmap, Subgroup.comap_top] at h1
        exact h1.symm
      have hsup : Ksub S Y ⊔ L = Ksub S Y := sup_eq_left.mpr hLK
      rw [hsup] at htop
      exact htop

end Master

end Work.ThreePoints.ThmC
