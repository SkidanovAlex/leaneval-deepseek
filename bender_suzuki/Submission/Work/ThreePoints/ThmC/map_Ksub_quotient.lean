/-
# `Work.ThreePoints.ThmC.map_Ksub_quotient`

`Ksub S Y` (see `Submission/Work/ThreePoints/ThmC/CoprimeGenDefs.lean`) is the subgroup of `Y`
generated by the fixed points of `A = ⟨S⟩ ≤ M` and by the fixed points of the involutions of `M`.
For Peterfalvi's coprime generation lemma (I Ch. I §6 Lemma 2) one needs the compatibility of
this subgroup with the passage to a quotient `Y ⧸ N` of `Y` by an `M`-invariant normal subgroup:

    (Ksub S Y ⊔ N) / N = Ksub S (Y / N).

Both inclusions are formal consequences of the coprime-action fixed-point lifting theorem

    C_{Y/N}(A) = C_Y(A)·N/N        (`Work.Coprime.fixedPoints_quotient`)

applied to each kind of generator of `Ksub S (Y ⧸ N)`:

* the fixed points of `A = ⟨S⟩` in `Y ⧸ N` lift to fixed points of `A` in `Y` (the acting group
  is `↥(Subgroup.closure S)`, of order dividing `Nat.card M`);
* the fixed points of an element `v : M` with `orderOf v = 2` lift to fixed points of `v` in `Y`
  — here the acting group is the cyclic group `⟨v⟩` of order `2` — and such fixed points lie in
  `Ksub S Y` by definition, since `v` is an involution of `M`.

The hypothesis `Group.IsSolvable Y` is exactly the solvability hypothesis needed by the lifting
theorem (its proof is the conjugacy part of Schur–Zassenhaus); the coprimality
`Nat.Coprime (Nat.card M) (Nat.card Y)` passes to every subgroup of `M` that acts.
-/
import Mathlib
import Submission.Work.ThreePoints.ThmC.CoprimeGenDefs
import Submission.Work.Coprime.fixedPoints_quotient

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped Pointwise

namespace Work.ThreePoints.ThmC

/-- An `M`-invariant subgroup of `Y` is invariant under the restricted action of any subgroup
`A ≤ M` (the action of `↥A` on `Y` is the restriction of the `M`-action, so the pointwise
`↥A`-translates of a subgroup are its `M`-translates). -/
theorem isInvariant_subtype {M Y : Type} [Group M] [Group Y] [MulDistribMulAction M Y]
    (A : Subgroup M) (N : Subgroup Y) [FT.IsInvariant M N] : FT.IsInvariant ↥A N :=
  ⟨fun a => (inferInstance : FT.IsInvariant M N).smul_eq_self (a : M)⟩

/-- `Nat.card ↥A` divides `Nat.card M`, so coprimality of the latter with `n` passes to every
subgroup `A ≤ M`. -/
theorem coprime_natCard_subtype {M : Type} [Group M] {A : Subgroup M} {n : ℕ}
    (h : Nat.Coprime (Nat.card M) n) : Nat.Coprime (Nat.card ↥A) n :=
  h.coprime_dvd_left (Subgroup.card_subgroup_dvd_card A)

/-- **`(Ksub S Y ⊔ N) / N = Ksub S (Y / N)`.**  For a finite group `M` acting by automorphisms
on a finite *solvable* group `Y` with `Nat.Coprime (Nat.card M) (Nat.card Y)`, and an
`M`-invariant normal subgroup `N ⊴ Y`, the image of `Ksub S Y ⊔ N` in `Y ⧸ N` is
`Ksub S (Y ⧸ N)`. -/
theorem map_Ksub_quotient {M Y : Type} [Group M] [Finite M] [Group Y] [Finite Y]
    [MulDistribMulAction M Y] (S : Set M)
    (hcop : Nat.Coprime (Nat.card M) (Nat.card Y)) (hsolv : Group.IsSolvable Y)
    (N : Subgroup Y) [N.Normal] [FT.IsInvariant M N] :
    (Ksub S Y ⊔ N).map (QuotientGroup.mk' N) = Ksub S (Y ⧸ N) := by
  refine le_antisymm ?_ ?_
  · -- `⊆`: every element of `Ksub S Y` is fixed modulo `N` by the corresponding element of `M`.
    rw [Subgroup.map_sup]
    refine sup_le ?_ ?_
    · rw [Subgroup.map_le_iff_le_comap]
      refine (Subgroup.closure_le _).mpr ?_
      intro y hy
      rw [SetLike.mem_coe, Subgroup.mem_comap]
      rcases hy with hy | hy
      · -- `y` is fixed by `A = ⟨S⟩`, hence its image is fixed by `A` in the quotient.
        refine Subgroup.subset_closure (Or.inl ?_)
        change (QuotientGroup.mk' N y) ∈ FT.fixedPoints ↥(Subgroup.closure S) (Y ⧸ N)
        rw [FT.mem_fixedPoints]
        intro a
        rw [QuotientGroup.mk'_apply, Subgroup.smul_def, FT.quotient_smul_mk]
        rw [show (a : M) • y = y from hy a]
      · -- `y` is fixed by an involution `v` of `M`, hence its image is as well.
        obtain ⟨v, hv, hyv⟩ := Set.mem_iUnion₂.mp hy
        refine Subgroup.subset_closure (Or.inr (Set.mem_iUnion₂.mpr ⟨v, hv, ?_⟩))
        show v • (QuotientGroup.mk' N y) = (QuotientGroup.mk' N y)
        rw [QuotientGroup.mk'_apply, FT.quotient_smul_mk, hyv]
    · -- `N` itself is killed by the quotient map.
      rintro x ⟨n, hn, rfl⟩
      show (n : Y ⧸ N) ∈ Ksub S (Y ⧸ N)
      rw [(QuotientGroup.eq_one_iff n).mpr hn]
      exact Subgroup.one_mem _
  · -- `⊇`: every generator of `Ksub S (Y ⧸ N)` lifts to `Ksub S Y`.
    refine (Subgroup.closure_le _).mpr ?_
    intro x hx
    rcases hx with hx | hx
    · -- Fixed points of `A = ⟨S⟩` in the quotient lift to `C_Y(A) ≤ Ksub S Y`.
      haveI := isInvariant_subtype (Subgroup.closure S) N
      have hlift := Work.Coprime.fixedPoints_quotient ↥(Subgroup.closure S)
        (coprime_natCard_subtype (A := Subgroup.closure S) hcop) (Or.inr hsolv) N
      have hle : (FT.fixedPoints ↥(Subgroup.closure S) (Y ⧸ N) : Subgroup (Y ⧸ N)) ≤
          (FT.fixedPoints ↥(Subgroup.closure S) Y).map (QuotientGroup.mk' N) := hlift.ge
      obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp (hle hx)
      exact Subgroup.mem_map.mpr
        ⟨y, Subgroup.mem_sup_left (Subgroup.subset_closure (Or.inl hy)), hxy⟩
    · -- Fixed points of an involution `v` of `M` lift to `C_Y(v) ≤ Ksub S Y`.
      obtain ⟨v, hv, hxv⟩ := Set.mem_iUnion₂.mp hx
      haveI := isInvariant_subtype (Subgroup.zpowers v) N
      have hlift := Work.Coprime.fixedPoints_quotient ↥(Subgroup.zpowers v)
        (coprime_natCard_subtype (A := Subgroup.zpowers v) hcop) (Or.inr hsolv) N
      have hle : (FT.fixedPoints ↥(Subgroup.zpowers v) (Y ⧸ N) : Subgroup (Y ⧸ N)) ≤
          (FT.fixedPoints ↥(Subgroup.zpowers v) Y).map (QuotientGroup.mk' N) := hlift.ge
      -- `x` is fixed by all of `⟨v⟩`, since `v` fixes it.
      have hfix : x ∈ FT.fixedPoints ↥(Subgroup.zpowers v) (Y ⧸ N) := by
        rw [FT.mem_fixedPoints]
        intro a
        let Stab : Subgroup M :=
          { carrier := {m : M | m • x = x}
            mul_mem' := by intro p q hp hq; show (p * q) • x = x; rw [mul_smul, hq, hp]
            one_mem' := by show (1 : M) • x = x; rw [one_smul]
            inv_mem' := by
              intro p hp
              show p⁻¹ • x = x
              have h2 : p⁻¹ • x = p⁻¹ • (p • x) := by rw [hp]
              rw [h2, inv_smul_smul] }
        have hvS : v ∈ Stab := hxv
        have hle2 : Subgroup.zpowers v ≤ Stab := Subgroup.zpowers_le.mpr hvS
        show (a : M) • x = x
        exact hle2 a.2
      obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp (hle hfix)
      -- `y` is fixed by `v`, and `v` is an involution, so `y ∈ Ksub S Y`.
      have hyv : v • y = y := by
        have h1 : (⟨v, Subgroup.mem_zpowers v⟩ : ↥(Subgroup.zpowers v)) • y = y := hy _
        rwa [Subgroup.smul_def] at h1
      exact Subgroup.mem_map.mpr ⟨y, Subgroup.mem_sup_left
        (Subgroup.subset_closure (Or.inr (Set.mem_iUnion₂.mpr ⟨v, hv, hyv⟩))), hxy⟩

end Work.ThreePoints.ThmC
