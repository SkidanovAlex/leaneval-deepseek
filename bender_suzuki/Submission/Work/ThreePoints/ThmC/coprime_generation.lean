/-
# Peterfalvi I Ch. I §6 Lemma 2 (pp. 159–160): coprime generation

Let `X` be a finite group of odd order, `u` an involution acting on `X` (so that `M = X⟨u⟩`),
and suppose `M` acts on a finite solvable group `Y` of order prime to `|M|`.  Then `Y` is
generated by the common fixed points of `J(X,u) = {x ∈ X | u x u⁻¹ = x⁻¹}` together with the
fixed points of the involutions of `M`.

Write `S = invSet X u` for the set of elements of `X` inverted by `u`, `A = ⟨S⟩`, and
`K = Ksub S Y = ⟨C_Y(A) ∪ ⋃_{v ∈ M, v² = 1} C_Y(v)⟩`.  The main theorem is proved by applying
the master lemma `Ksub_eq_top_aux` to the acting group `H = M₀ S u = ⟨S,u⟩` (so that `S ∪ {u}`
generates the acting group) and to the transported data `S' = {a : ↥H | (a : M) ∈ S}`,
`u' = ⟨u, _⟩`:

* `⟨S⟩ = ⟨S'⟩` as subgroups of `M`, so the fixed point subgroups agree;
* every involution of `↥H` is an involution of `M`, so `Ksub S' Y ≤ Ksub S Y`;
* `|⟨S'⟩| = |⟨S⟩|` is odd (it divides the odd number `|X|`), `orderOf u' = 2`, and the
  coprimality and solvability hypotheses transport.

Since `Ksub (invSet X u) Y` is exactly the closure appearing in the statement (the first
generator set being the common fixed points of the inverted elements, i.e. of `⟨S⟩`), the
claim follows.
-/
import Mathlib
import Submission.Work.ThreePoints.ThmC.Defs
import Submission.Work.Coprime.Basic
import Submission.Work.Coprime.fixedPoints_quotient
import Submission.Work.ThreePoints.ThmC.CoprimeGenDefs
import Submission.Work.ThreePoints.ThmC.map_Ksub_quotient
import Submission.Work.ThreePoints.ThmC.coprime_generation_master

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedVariables false

open scoped Pointwise

namespace Work.ThreePoints.ThmC

variable {M : Type*} [Group M]

/-- The set of elements of `X` inverted by `u` is contained in `X`. -/
theorem invSet_subset (X : Subgroup M) (u : M) : invSet X u ⊆ X := fun _ hx => hx.1

/-- The statement's first generator set is the fixed point subgroup of `⟨invSet X u⟩`. -/
theorem fixedPts_eq_fixedPoints_invSet {M Y : Type} [Group M] [Group Y]
    [MulDistribMulAction M Y] (X : Subgroup M) (u : M) :
    ({y : Y | ∀ x : M, x ∈ X → u * x * u⁻¹ = x⁻¹ → x • y = y} : Set Y)
      = (FT.fixedPoints ↥(Subgroup.closure (invSet X u)) Y : Set Y) := by
  refine Set.Subset.antisymm ?_ ?_
  · intro y hy
    rw [SetLike.mem_coe, FT.mem_fixedPoints]
    intro a
    exact fixed_of_mem_closure (fun x hx => hy x hx.1 hx.2) a a.2
  · intro y hy x hx hxu
    rw [SetLike.mem_coe, FT.mem_fixedPoints] at hy
    exact hy ⟨x, Subgroup.subset_closure ⟨hx, hxu⟩⟩

section Transport

variable {X : Subgroup M} {u : M}

/-- `S' = {a : ↥⟨S,u⟩ | a ∈ S}`: the transport of `S` to the acting group `⟨S,u⟩`. -/
def invSetSub (S : Set M) (u : M) : Set ↥(M₀ S u) := {a : ↥(M₀ S u) | (a : M) ∈ S}

/-- The transport of `u` to the acting group `⟨S,u⟩`. -/
def uSub (S : Set M) (u : M) : ↥(M₀ S u) :=
  ⟨u, Subgroup.subset_closure (Set.mem_union_right _ rfl)⟩

theorem uSub_orderOf {S : Set M} {u : M} (hu : orderOf u = 2) :
    orderOf (uSub S u) = 2 := by
  have h : ((uSub S u : ↥(M₀ S u)) : M) = u := rfl
  rw [← Subgroup.orderOf_coe (uSub S u), h]
  exact hu

theorem invSetSub_inv {S : Set M} {u : M} (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S)
    {x : ↥(M₀ S u)} (hx : x ∈ invSetSub S u) : x⁻¹ ∈ invSetSub S u := by
  have h : ((x⁻¹ : ↥(M₀ S u)) : M) = (x : M)⁻¹ := rfl
  rw [invSetSub, Set.mem_ofPred_eq] at hx ⊢
  rw [h]
  exact hSclosed (x : M) hx

theorem invSetSub_conj {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    {x : ↥(M₀ S u)} (hx : x ∈ invSetSub S u) :
    uSub S u * x * (uSub S u)⁻¹ = x⁻¹ := by
  refine Subtype.ext ?_
  have h : ((uSub S u * x * (uSub S u)⁻¹ : ↥(M₀ S u)) : M) = u * (x : M) * u⁻¹ := rfl
  have h2 : ((x⁻¹ : ↥(M₀ S u)) : M) = (x : M)⁻¹ := rfl
  rw [h, h2]
  exact hSinv (x : M) (by simpa [invSetSub] using hx)

theorem invSetSub_gen {S : Set M} {u : M} : M₀ (invSetSub S u) (uSub S u) = ⊤ := by
  have hle : Subgroup.closure (S ∪ {u}) ≤
      (Subgroup.closure (invSetSub S u ∪ {uSub S u})).map (M₀ S u).subtype := by
    rw [Subgroup.closure_le]
    rintro y (hy | hy)
    · refine Subgroup.mem_map.mpr ⟨⟨y, Subgroup.subset_closure (Set.mem_union_left _ hy)⟩, ?_, rfl⟩
      exact Subgroup.subset_closure (Set.mem_union_left _
        (show (⟨y, Subgroup.subset_closure (Set.mem_union_left _ hy)⟩ : ↥(M₀ S u))
          ∈ invSetSub S u from hy))
    · have hyu : y = u := by simpa using hy
      rw [hyu]
      exact Subgroup.mem_map.mpr ⟨uSub S u, Subgroup.subset_closure (Set.mem_union_right _ rfl), rfl⟩
  refine eq_top_iff.mpr fun a _ => ?_
  have ha : (a : M) ∈ (Subgroup.closure (invSetSub S u ∪ {uSub S u})).map (M₀ S u).subtype :=
    hle a.2
  obtain ⟨b, hb, hba⟩ := Subgroup.mem_map.mp ha
  have hba' : b = a := Subtype.ext hba
  rwa [hba'] at hb

theorem invSetSub_closure_map {S : Set M} {u : M} :
    (Subgroup.closure (invSetSub S u)).map (M₀ S u).subtype = Subgroup.closure S := by
  have hset : (M₀ S u).subtype '' invSetSub S u = S := by
    refine Set.Subset.antisymm ?_ ?_
    · rintro y ⟨x, hx, rfl⟩
      exact hx
    · intro y hy
      exact ⟨⟨y, Subgroup.subset_closure (Set.mem_union_left _ hy)⟩, hy, rfl⟩
  rw [MonoidHom.map_closure, hset]

theorem invSetSub_odd {S : Set M} {u : M} (hSodd : Odd (Nat.card ↥(Subgroup.closure S))) :
    Odd (Nat.card ↥(Subgroup.closure (invSetSub S u))) := by
  have hcard : Nat.card ↥(Subgroup.closure (invSetSub S u)) = Nat.card ↥(Subgroup.closure S) := by
    rw [← invSetSub_closure_map (S := S) (u := u)]
    exact (Subgroup.card_map_of_injective (K := Subgroup.closure (invSetSub S u))
      (M₀ S u).subtype_injective).symm
  rw [hcard]
  exact hSodd

/-- The transported `K` is contained in the original `K`. -/
theorem Ksub_subtype_le {Y : Type} [Group Y] [MulDistribMulAction M Y] (S : Set M) (u : M) :
    Ksub (invSetSub S u) Y ≤ Ksub S Y := by
  refine (Subgroup.closure_le (Ksub S Y)).mpr fun y hy => ?_
  rw [Set.mem_union] at hy
  rcases hy with hy | hy
  · -- fixed points of `⟨S'⟩` are fixed points of `⟨S⟩`
    rw [SetLike.mem_coe, FT.mem_fixedPoints] at hy
    refine Subgroup.subset_closure (Or.inl ?_)
    rw [SetLike.mem_coe, FT.mem_fixedPoints]
    intro a
    refine fixed_of_mem_closure (S := S) (fun x hx => ?_) (a : M) a.2
    have hx' : (⟨x, Subgroup.subset_closure (Set.mem_union_left _ hx)⟩ : ↥(M₀ S u))
        ∈ invSetSub S u := by simpa [invSetSub] using hx
    let a₀ : ↥(Subgroup.closure (invSetSub S u)) :=
      Subtype.mk (Subtype.mk x (Subgroup.subset_closure (Set.mem_union_left _ hx)))
        (Subgroup.subset_closure (show
          (Subtype.mk x (Subgroup.subset_closure (Set.mem_union_left _ hx)) : ↥(M₀ S u))
            ∈ invSetSub S u from hx))
    exact hy a₀
  · -- involutions of `↥⟨S,u⟩` are involutions of `M`
    rw [Set.mem_iUnion₂] at hy
    obtain ⟨v, hv, hyv⟩ := hy
    rw [Set.mem_ofPred_eq] at hv
    refine Subgroup.subset_closure (Or.inr ?_)
    rw [Set.mem_iUnion₂]
    refine ⟨(v : M), ?_, ?_⟩
    · rw [Set.mem_ofPred_eq, ← Subgroup.orderOf_mk (v : M) v.2]
      exact hv
    · rw [Set.mem_ofPred_eq] at hyv ⊢
      exact hyv

end Transport

/-- **Peterfalvi I Ch. I §6 Lemma 2 (pp. 159-160).**  Let `X` be a finite group of odd order, `u`
an involution acting on `X` (so that `M = X⟨u⟩`), and suppose `M` acts on a finite solvable group
`Y` of order prime to `|M|`.  Then `Y` is generated by the common fixed points of
`J(X,u) = {x ∈ X | u x u⁻¹ = x⁻¹}` together with the fixed points of the involutions of `M`:
`Y = ⟨C_Y(⟨J(X,u)⟩) ∪ ⋃_{v ∈ Inv(M)} C_Y(v)⟩`. -/
theorem coprime_generation {M Y : Type} [Group M] [Finite M] [Group Y] [Finite Y]
    [MulDistribMulAction M Y] {X : Subgroup M} (hXodd : Odd (Nat.card X)) {u : M}
    (hu : orderOf u = 2) (huX : ∀ x ∈ X, u * x * u⁻¹ ∈ X)
    (htop : X ⊔ Subgroup.zpowers u = ⊤)
    (hcop : Nat.Coprime (Nat.card M) (Nat.card Y)) (hsolv : Group.IsSolvable Y) :
    Subgroup.closure
      (({y : Y | ∀ x : M, x ∈ X → u * x * u⁻¹ = x⁻¹ → x • y = y} : Set Y) ∪
        (⋃ v ∈ ({v : M | orderOf v = 2} : Set M), ({y : Y | v • y = y} : Set Y))) = ⊤ := by
  -- the set of inverted elements of `X`
  set S : Set M := invSet X u with hSdef
  have hSX : S ⊆ X := invSet_subset X u
  have hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹ := fun x hx => hx.2
  have hSclosed : ∀ x ∈ S, x⁻¹ ∈ S := fun x hx => invSet_inv hx
  have hSodd : Odd (Nat.card ↥(Subgroup.closure S)) :=
    Odd.of_dvd (Subgroup.card_dvd_of_le ((Subgroup.closure_le X).mpr hSX)) hXodd
  -- the acting group
  have hinter : Nat.card ↥(M₀ S u) ∣ Nat.card M := by
    simpa using Subgroup.card_dvd_of_le (le_top : M₀ S u ≤ ⊤)
  have hcop' : Nat.Coprime (Nat.card ↥(M₀ S u)) (Nat.card Y) := hcop.coprime_dvd_left hinter
  -- apply the master lemma to the acting group `⟨S,u⟩` and the transported data
  have hSinv' : ∀ x ∈ invSetSub S u, uSub S u * x * (uSub S u)⁻¹ = x⁻¹ :=
    fun x hx => invSetSub_conj hSinv hx
  have hSclosed' : ∀ x ∈ invSetSub S u, x⁻¹ ∈ invSetSub S u :=
    fun x hx => invSetSub_inv hSclosed hx
  have hmaster : Ksub (invSetSub S u) Y = ⊤ :=
    Ksub_eq_top_aux (G := ↥(M₀ S u)) (S := invSetSub S u) (u := uSub S u)
      (uSub_orderOf hu) hSinv' hSclosed' invSetSub_gen (invSetSub_odd hSodd)
      (Nat.card Y) Y rfl hcop' hsolv
  have hK : Ksub S Y = ⊤ :=
    eq_top_iff.mpr (le_trans (le_of_eq hmaster.symm) (Ksub_subtype_le S u))
  -- identify the closure of the statement with `Ksub S Y`
  rw [fixedPts_eq_fixedPoints_invSet X u, ← hSdef]
  exact hK

end Work.ThreePoints.ThmC
