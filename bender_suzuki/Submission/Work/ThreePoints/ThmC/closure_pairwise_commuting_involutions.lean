namespace Work.ThreePoints.ThmC

/-- In a group `G`, if `S` is a set of pairwise commuting elements each of square `1`, then the
subgroup generated by `S` is abelian, of exponent `2`, and a `2`-group. -/
theorem closure_pairwise_commuting_involutions {G : Type*} [Group G] {S : Set G}
    (h2 : ∀ x ∈ S, x * x = 1) (hc : ∀ x ∈ S, ∀ y ∈ S, x * y = y * x) :
    IsMulCommutative ↥(Subgroup.closure S) ∧
      (∀ x : ↥(Subgroup.closure S), x ^ 2 = 1) ∧ IsPGroup 2 ↥(Subgroup.closure S) := by
  -- Every element of `S` commutes with every element of the subgroup it generates.
  have hcent : S ⊆ Subgroup.centralizer ((Subgroup.closure S : Subgroup G) : Set G) := by
    intro x hx
    refine Subgroup.mem_centralizer_iff.mpr ?_
    intro y hy
    induction hy using Subgroup.closure_induction with
    | mem z hz => exact hc z hz x hx
    | one => simp
    | mul a b ha hb ha' hb' => rw [mul_assoc, hb', ← mul_assoc, ha', mul_assoc]
    | inv a ha ha' => exact ((show Commute a x from ha').inv_left).eq
  have hle : Subgroup.closure S ≤
      Subgroup.centralizer ((Subgroup.closure S : Subgroup G) : Set G) :=
    (Subgroup.closure_le
      (Subgroup.centralizer ((Subgroup.closure S : Subgroup G) : Set G))).mpr hcent
  -- Hence the generated subgroup is abelian.
  have hcomm : ∀ a ∈ Subgroup.closure S, ∀ b ∈ Subgroup.closure S, a * b = b * a := by
    intro a ha b hb
    have h1 : a ∈ Subgroup.centralizer ((Subgroup.closure S : Subgroup G) : Set G) := hle ha
    exact ((Subgroup.mem_centralizer_iff.mp h1) b hb).symm
  -- ...and has exponent `2`.
  have hpow : ∀ g ∈ Subgroup.closure S, g ^ 2 = 1 := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem x hx => simpa [pow_two] using h2 x hx
    | one => simp
    | mul a b ha hb ha' hb' =>
        have hcab : Commute a b := hcomm a ha b hb
        calc (a * b) ^ 2 = a ^ 2 * b ^ 2 := hcab.mul_pow 2
          _ = 1 := by rw [ha', hb', mul_one]
    | inv a ha ha' => rw [inv_pow, ha', inv_one]
  refine ⟨?_, ?_, ?_⟩
  · rw [isMulCommutative_iff]
    intro a b
    apply Subtype.ext
    exact hcomm a a.2 b b.2
  · intro x
    exact Subtype.ext (by rw [Subgroup.coe_pow, Subgroup.coe_one]; exact hpow x.1 x.2)
  · intro x
    refine ⟨1, ?_⟩
    rw [pow_one]
    exact Subtype.ext (by rw [Subgroup.coe_pow, Subgroup.coe_one]; exact hpow x.1 x.2)

end Work.ThreePoints.ThmC
