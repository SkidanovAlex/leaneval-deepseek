open Pointwise

namespace Work.ThreePoints.ThmC

/-- The subgroup generated by a finite `p`-group `K ≤ G` together with an involution `s` that
normalises `K` is solvable (an extension of the nilpotent group `K` by a group of order `≤ 2`). -/
theorem isSolvable_sup_zpowers {G : Type} [Group G] [Finite G] {p : ℕ} {K : Subgroup G} {s : G}
    (hp : p.Prime) (hKp : IsPGroup p K) (hs : orderOf s = 2)
    (hKs : Submission.Blueprint.conj s K = K) :
    Group.IsSolvable ↥(K ⊔ Subgroup.zpowers s) := by
  -- The quotient of `L = K ⊔ ⟨s⟩` by `K` is generated by the image of `s`, hence solvable;
  -- `K` itself is a `p`-group, hence nilpotent, hence solvable; a solvable extension of a
  -- solvable group is solvable.
  set L : Subgroup G := K ⊔ Subgroup.zpowers s with hL
  have hKL : K ≤ L := by rw [hL]; exact le_sup_left
  have hZL : Subgroup.zpowers s ≤ L := by rw [hL]; exact le_sup_right
  -- `s` lies in the normaliser of `K` (this is the meaning of `conj s K = K`)
  have hs_norm : s ∈ Subgroup.normalizer (K : Set G) := by
    have key : ∀ x : G, (MulAut.conj s).symm (s * x * s⁻¹) = x := by
      intro x; rw [MulAut.conj_symm_apply]; group
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · intro hh
      rw [← hKs, Subgroup.mem_map_equiv, key]; exact hh
    · intro hh
      rw [← hKs] at hh
      rw [Subgroup.mem_map_equiv, key] at hh
      exact hh
  -- hence `L = K ⊔ ⟨s⟩` lies in that normaliser, so `K` is normal in `L`
  have hL_norm : L ≤ Subgroup.normalizer (K : Set G) := by
    rw [hL]
    exact sup_le Subgroup.le_normalizer (Subgroup.zpowers_le.mpr hs_norm)
  have hHnorm : (K.subgroupOf L).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hKL]
    intro h k hh hk
    exact (Subgroup.le_normalizer_iff.mp hL_norm k hk) h hh
  haveI : (K.subgroupOf L).Normal := hHnorm
  -- `K`, viewed inside `L`, is solvable (a finite `p`-group is nilpotent, hence solvable)
  haveI : Group.IsSolvable ↥(K.subgroupOf L) := by
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : Group.IsNilpotent ↥K := IsPGroup.isNilpotent hKp
    haveI : Group.IsSolvable ↥K := inferInstance
    exact Group.isSolvable_of_isSolvable_injective
      (f := (Subgroup.subgroupOfEquivOfLe hKL).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hKL).injective
  -- `⟨s⟩` viewed inside `L` is solvable (cyclic)
  set Z : Subgroup ↥L := (Subgroup.zpowers s).subgroupOf L with hZ
  haveI : Group.IsSolvable ↥Z := by
    haveI : Group.IsSolvable ↥(Subgroup.zpowers s) := inferInstance
    exact Group.isSolvable_of_isSolvable_injective
      (f := (Subgroup.subgroupOfEquivOfLe hZL).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hZL).injective
  -- `K ⊔ ⟨s⟩ = L`, so `⊤ = K.subgroupOf L ⊔ Z` inside `L`
  have hHZ : K.subgroupOf L ⊔ Z = ⊤ := by
    have key := Subgroup.subgroupOf_sup hKL hZL
    rw [← hL, Subgroup.subgroupOf_self] at key
    rw [hZ, ← key]
  -- The quotient `L ⧸ K` is a quotient of the cyclic group `⟨s⟩`
  haveI : Group.IsSolvable (↥L ⧸ (K.subgroupOf L)) := by
    apply Group.isSolvable_of_surjective
      (f := (QuotientGroup.mk' (K.subgroupOf L)).comp Z.subtype)
    intro y
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (K.subgroupOf L) y
    -- every element of `L` is a product of an element of `K` and an element of `⟨s⟩`,
    -- since `K` is normal in `L`
    have hmem : g ∈ ((K.subgroupOf L : Set ↥L) * (Z : Set ↥L)) := by
      rw [← Subgroup.normal_mul (K.subgroupOf L) Z, hHZ]
      trivial
    obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp hmem
    refine ⟨⟨b, hb⟩, ?_⟩
    show QuotientGroup.mk' (K.subgroupOf L) b = QuotientGroup.mk' (K.subgroupOf L) g
    have ha1 : QuotientGroup.mk' (K.subgroupOf L) a = 1 := by
      rw [QuotientGroup.mk'_apply]
      exact (QuotientGroup.eq_one_iff a).mpr ha
    rw [← hab, map_mul, ha1, one_mul]
  exact Group.isSolvable_of_subgroup_quotient (K.subgroupOf L)

end Work.ThreePoints.ThmC
