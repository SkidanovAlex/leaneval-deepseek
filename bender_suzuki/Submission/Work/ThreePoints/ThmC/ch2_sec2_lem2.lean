/-
# `Work.ThreePoints.ThmC.ch2_sec2_lem2` — Peterfalvi I Ch. II §2 (p. 165), second item

If `D = H ∩ H^t` has a nontrivial normal subgroup `A` normalised by `t ∈ Inv(G∖H)` and by an
involution of `H`, and the involutions of `H` fail to commute, then `O_{2'}(G) ≠ 1`.

Proof (the source's).  Put `N = N_G(A)`.  `N ∩ H` is a strongly embedded subgroup of `N`,
`Inv(H) ⊆ N` (because `D ≤ N` and `D` is transitive on `Inv(H)`), so (B1-a)
(`Work.ThreePoints.involutions_commute_of_below`) applies to `N`: the subgroup `E` of `G` generated
by the commutators of involutions of `H` lies in `O_{2'}(N)`.  Ch. I §1 (9) in `N`
(`Work.ThreePoints.oddCore_le_of_stronglyEmbedded`) applied to `N ∩ H` and to its `t`-conjugate
gives `E ≤ H ∩ H^t = D`.  Finally `E ⊴ H` and `E ≤ D`, so 2-transitivity of `G` on `Ω = G ⧸ H`
(the hypothesis `h2t`) puts `E` inside every conjugate of `H`, i.e. inside
`O_{2'}(G) = ⋂_x H^x` (Ch. I §1 (9) in `G`).
-/
import Mathlib
import Submission.Work.ThreePoints.ThmC.Base
import Submission.Work.ThreePoints.involutions_commute_of_below
import Submission.Work.ThreePoints.TwoPointTransitive
import Submission.Work.DoubleTransitivity.App2.app2_2

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedVariables false

open LeanEval.GroupTheory.Defs

namespace Work.ThreePoints.ThmC

open Submission.Blueprint

/-- **Peterfalvi I Ch. II §2, second numbered item (p. 165).** -/
theorem ch2_sec2_lem2 {G : Type} [Group G] [Finite G]
    (hB1 : ThmBBelow (Nat.card G)) (hMod : ModelFactsProp) (hfour : HasFourGroup G)
    {H : Subgroup G} (hH : IsStronglyEmbedded H) (h2t : IsTwoTransitiveOn H)
    {t : G} (ht : orderOf t = 2) (htH : t ∉ H)
    {A : Subgroup G} (hA : A ≤ twoPoint H t)
    (hAnorm : ∀ d ∈ twoPoint H t, conj d A = A) (hAne : A ≠ ⊥)
    (hAt : t ∈ Subgroup.normalizer (A : Set G))
    (hAu : ∃ u ∈ involutions (H : Set G), u ∈ Subgroup.normalizer (A : Set G))
    (hnc : ∃ u v : G, u ∈ involutions (H : Set G) ∧ v ∈ involutions (H : Set G) ∧
      u * v ≠ v * u) :
    oddCore G ≠ ⊥ := by
  classical
  -- `E`: the subgroup generated by the commutators of involutions of `H`
  set E : Subgroup G := Subgroup.closure
    {w | ∃ u v : G, u ∈ involutions (H : Set G) ∧ v ∈ involutions (H : Set G) ∧
      w = u * v * u⁻¹ * v⁻¹} with hE
  have hEne : E ≠ ⊥ := by
    obtain ⟨u, v, hu, hv, huv⟩ := hnc
    intro hbot
    have hmem : u * v * u⁻¹ * v⁻¹ ∈ E := by
      rw [hE]; exact Subgroup.subset_closure ⟨u, v, hu, hv, rfl⟩
    rw [hbot] at hmem
    have h1 : u * v * u⁻¹ * v⁻¹ = 1 := Subgroup.mem_bot.mp hmem
    refine huv ?_
    calc u * v = (u * v * u⁻¹ * v⁻¹) * (v * u) := by group
      _ = 1 * (v * u) := by rw [h1]
      _ = v * u := one_mul _
  by_cases hNtop : Subgroup.normalizer (A : Set G) = ⊤
  · -- `A ⊴ G`, hence `A ≤ O(G)`
    have hAnormal : A.Normal := Subgroup.normalizer_eq_top_iff.mp hNtop
    have hAodd : Odd (Nat.card A) :=
      Odd.of_dvd (Subgroup.card_dvd_of_le hA) (hH.2.2 t htH)
    intro hbot
    exact hAne (le_bot_iff.mp (hbot ▸ Work.BrauerSuzuki.OddCore.le_of_normal_odd hAnormal hAodd))
  · -- main case: `N = N_G(A) ≠ ⊤`
    set N : Subgroup G := Subgroup.normalizer (A : Set G) with hNdef
    have htN : t ∈ N := hAt
    have hD_le_N : twoPoint H t ≤ N := by
      intro d hd
      exact (Work.DoubleTransitivity.conj_eq_self_iff_mem_normalizer d A).mp (hAnorm d hd)
    obtain ⟨u₀, hu₀, hu₀N⟩ := hAu
    have hInvH_le_N : involutions (H : Set G) ⊆ (N : Set G) := by
      intro w hw
      obtain ⟨d, hd, hdw⟩ :=
        Work.ThreePoints.twoPoint_transitive_on_involutions hH ht htH hu₀ hw
      rw [← hdw]
      exact N.mul_mem (N.mul_mem (hD_le_N hd) hu₀N) (N.inv_mem (hD_le_N hd))
    have hfourN : HasFourGroup ↥N := by
      obtain ⟨a, b, haH, hbH, ha2, hb2, hane, hcomm⟩ :=
        exists_involutions_mem_of_stronglyEmbedded hH hfour
      have haN : a ∈ N := hInvH_le_N ⟨haH, ha2⟩
      have hbN : b ∈ N := hInvH_le_N ⟨hbH, hb2⟩
      refine ⟨⟨a, haN⟩, ⟨b, hbN⟩, ?_, ?_, ?_, ?_⟩
      · rw [Subgroup.orderOf_mk]; exact ha2
      · rw [Subgroup.orderOf_mk]; exact hb2
      · intro h; exact hane (Subtype.ext_iff.mp h)
      · exact Subtype.ext (by simpa using hcomm)
    have hHNstrong : IsStronglyEmbedded ((H ⊓ N).subgroupOf N) := by
      have h := IsStronglyEmbedded.subgroupOf_inf (X := N) hH (by
        intro htop
        have hle : N ≤ H := by
          intro n hn
          have hmem : (⟨n, hn⟩ : ↥N) ∈ (N ⊓ H).subgroupOf N := by rw [htop]; trivial
          exact (Subgroup.mem_subgroupOf.mp hmem).2
        exact htH (hle htN)) (by
        have hmem : u₀ ∈ N ⊓ H := ⟨hInvH_le_N hu₀, hu₀.1⟩
        refine even_iff_two_dvd.mpr ?_
        have h2 := orderOf_dvd_natCard (⟨u₀, hmem⟩ : ↥(N ⊓ H))
        rw [Subgroup.orderOf_mk, hu₀.2] at h2
        exact h2)
      rwa [inf_comm] at h
    have hlt : Nat.card ↥N < Nat.card G := by
      have hidx : N.index ≠ 1 := fun h => hNtop (Subgroup.index_eq_one.mp h)
      have hne : N.index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have hgt : 1 < N.index := by omega
      have hNpos : 0 < Nat.card ↥N := Nat.card_pos
      have hmul : Nat.card ↥N * N.index = Nat.card G := Subgroup.card_mul_index N
      calc Nat.card ↥N = Nat.card ↥N * 1 := (mul_one _).symm
        _ < Nat.card ↥N * N.index := Nat.mul_lt_mul_of_pos_left hgt hNpos
        _ = Nat.card G := hmul
    -- (B1-a) applied to `N`
    have hE_le_ON : E ≤ (oddCore ↥N).map N.subtype := by
      rw [hE]
      refine (Subgroup.closure_le _).mpr ?_
      rintro w ⟨u, v, hu, hv, rfl⟩
      have huN : (⟨u, hInvH_le_N hu⟩ : ↥N) ∈
          involutions (((H ⊓ N).subgroupOf N : Subgroup ↥N) : Set ↥N) :=
        ⟨Subgroup.mem_subgroupOf.mpr ⟨hu.1, hInvH_le_N hu⟩, by
          rw [Subgroup.orderOf_mk]; exact hu.2⟩
      have hvN : (⟨v, hInvH_le_N hv⟩ : ↥N) ∈
          involutions (((H ⊓ N).subgroupOf N : Subgroup ↥N) : Set ↥N) :=
        ⟨Subgroup.mem_subgroupOf.mpr ⟨hv.1, hInvH_le_N hv⟩, by
          rw [Subgroup.orderOf_mk]; exact hv.2⟩
      have hcomm := Work.ThreePoints.involutions_commute_of_below (n := Nat.card G) hB1 hMod
        hlt hfourN hHNstrong huN hvN
      refine Subgroup.mem_map.mpr ⟨_, hcomm, ?_⟩
      rfl
    have hE_le_H : E ≤ H := by
      refine le_trans hE_le_ON ?_
      have h := Work.ThreePoints.oddCore_le_of_stronglyEmbedded (H := (H ⊓ N).subgroupOf N)
        hHNstrong hfourN
      calc (oddCore ↥N).map N.subtype ≤ ((H ⊓ N).subgroupOf N).map N.subtype :=
            Subgroup.map_mono h
        _ = H ⊓ N := by
            rw [Subgroup.subgroupOf_map_subtype]; simp
        _ ≤ H := inf_le_left
    have hE_le_conj_t : E ≤ conj t H := by
      intro w hw
      obtain ⟨w', hw'O, hw'eq⟩ := Subgroup.mem_map.mp (hE_le_ON hw)
      have hwN : w ∈ N := hw'eq ▸ w'.2
      have hstrong2 : IsStronglyEmbedded
          (conj (⟨t, htN⟩ : ↥N) ((H ⊓ N).subgroupOf N)) :=
        Work.ThreePoints.conj_stronglyEmbedded hHNstrong (⟨t, htN⟩ : ↥N)
      have hO := Work.ThreePoints.oddCore_le_of_stronglyEmbedded
        (H := conj (⟨t, htN⟩ : ↥N) ((H ⊓ N).subgroupOf N)) hstrong2 hfourN
      have heq : (⟨w, hwN⟩ : ↥N) = w' := Subtype.ext hw'eq.symm
      have hmem : (⟨w, hwN⟩ : ↥N) ∈ oddCore ↥N := by rw [heq]; exact hw'O
      have hconjmem : (⟨w, hwN⟩ : ↥N) ∈ conj (⟨t, htN⟩ : ↥N) ((H ⊓ N).subgroupOf N) := hO hmem
      rw [Work.ThreePoints.mem_conj_iff] at hconjmem
      rw [Work.ThreePoints.mem_conj_iff]
      have hh := (Subgroup.mem_subgroupOf.mp hconjmem).1
      simpa using hh
    -- `E ⊴ H`
    have hconj_le : ∀ y ∈ H, conj y E ≤ E := by
      intro y hy
      rw [conj, Subgroup.map_le_iff_le_comap]
      refine (Subgroup.closure_le _).mpr ?_
      rintro w ⟨u, v, hu, hv, rfl⟩
      refine Subgroup.mem_comap.mpr ?_
      refine Subgroup.subset_closure ⟨(MulAut.conj y) u, (MulAut.conj y) v, ?_, ?_, ?_⟩
      · refine ⟨H.mul_mem (H.mul_mem hy hu.1) (H.inv_mem hy), ?_⟩
        rw [(MulAut.conj y).orderOf_eq u]; exact hu.2
      · refine ⟨H.mul_mem (H.mul_mem hy hv.1) (H.inv_mem hy), ?_⟩
        rw [(MulAut.conj y).orderOf_eq v]; exact hv.2
      · simp only [map_mul, map_inv]; rfl
    have hE_conj : ∀ y ∈ H, conj y E = E := by
      intro y hy
      have h5 : conj y (conj y⁻¹ E) = E := by
        rw [← Work.DoubleTransitivity.conj_mul, mul_inv_cancel,
          Work.DoubleTransitivity.conj_one]
      have h4 : conj y (conj y⁻¹ E) ≤ conj y E :=
        Subgroup.map_mono (hconj_le y⁻¹ (H.inv_mem hy))
      rw [h5] at h4
      exact le_antisymm (hconj_le y hy) h4
    -- `E ≤ O(G)`
    have hE_le_oddCore : E ≤ oddCore G := by
      rw [oddCore_eq_iInf_conj hH hfour]
      refine le_iInf fun x => ?_
      by_cases hx : conj x H = H
      · rw [hx]; exact hE_le_H
      · have hpt1 : ((1 : G) : G ⧸ H) ≠ ((t : G) : G ⧸ H) := by
          intro h
          have h' := congrArg (MulAction.stabilizer G) h
          rw [Work.ThreePoints.stabilizer_mk H 1, Work.ThreePoints.stabilizer_mk H t,
            Work.ThreePoints.conj_one] at h'
          have htmem : t ∈ Subgroup.normalizer (H : Set G) :=
            (Work.DoubleTransitivity.conj_eq_self_iff_mem_normalizer t H).mp h'.symm
          rw [Work.ThreePoints.IsStronglyEmbedded.normalizer_eq hH] at htmem
          exact htH htmem
        have hpt2 : ((1 : G) : G ⧸ H) ≠ ((x : G) : G ⧸ H) := by
          intro h
          have h' := congrArg (MulAction.stabilizer G) h
          rw [Work.ThreePoints.stabilizer_mk H 1, Work.ThreePoints.stabilizer_mk H x,
            Work.ThreePoints.conj_one] at h'
          exact hx h'.symm
        obtain ⟨y, hy1, hy2⟩ := (MulAction.is_two_pretransitive_iff.mp h2t) hpt1 hpt2
        have hyH : y ∈ H := by
          have hstab : y ∈ MulAction.stabilizer G ((1 : G) : G ⧸ H) :=
            MulAction.mem_stabilizer_iff.mpr hy1
          rwa [Work.ThreePoints.stabilizer_mk H 1, Work.ThreePoints.conj_one] at hstab
        have hconjy : conj y (conj t H) = conj x H := by
          have h := congrArg (MulAction.stabilizer G) hy2
          rw [Work.DoubleTransitivity.App2.stabilizer_smul_eq_conj y (t : G ⧸ H),
            Work.ThreePoints.stabilizer_mk H t, Work.ThreePoints.stabilizer_mk H x] at h
          exact h
        rw [← hconjy, ← hE_conj y hyH]
        exact Subgroup.map_mono hE_le_conj_t
    intro hbot
    exact hEne (le_bot_iff.mp (hbot ▸ hE_le_oddCore))

end Work.ThreePoints.ThmC
