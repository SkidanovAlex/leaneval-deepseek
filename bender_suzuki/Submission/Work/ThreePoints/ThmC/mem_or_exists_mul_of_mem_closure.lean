namespace Work.ThreePoints.ThmC

/-- If `u` is an involution (`u * u = 1`) normalising a subgroup `C ≤ G`, then the subgroup
generated by `C` and `u` is contained in `C ∪ u·C`: every element of `⟨C, u⟩` lies in `C` or is of
the form `u * c` with `c ∈ C`.  (Used to write an involution of a group `C⟨u⟩` with `C` odd as
`u * c`.) -/
theorem mem_or_exists_mul_of_mem_closure {G : Type} [Group G] {C : Subgroup G} {u : G}
    (hCu : ∀ c ∈ C, u * c * u⁻¹ ∈ C) (hu : u * u = 1) {x : G}
    (hx : x ∈ Subgroup.closure ((C : Set G) ∪ {u})) : x ∈ C ∨ ∃ c ∈ C, x = u * c := by
  have hu' : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu
  -- `u` normalises `C` also in the form `u * c * u ∈ C`
  have hCu' : ∀ c ∈ C, u * c * u ∈ C := by
    intro c hc
    have h := hCu c hc
    rwa [hu'] at h
  -- conjugating an element by the involution `u` on the right
  have key : ∀ a : G, a * u = u * (u * a * u) := by
    intro a
    calc a * u = ((u * u) * a) * u := by rw [hu, one_mul]
      _ = (u * (u * a)) * u := by rw [mul_assoc u u a]
      _ = u * (u * a * u) := by rw [mul_assoc u (u * a) u]
  refine Subgroup.closure_induction
    (p := fun x _ => x ∈ C ∨ ∃ c ∈ C, x = u * c) ?_ ?_ ?_ ?_ hx
  · intro y hy
    rcases hy with hy | hy
    · exact Or.inl hy
    · rw [Set.mem_singleton_iff] at hy
      exact Or.inr ⟨1, C.one_mem, by rw [hy, mul_one]⟩
  · exact Or.inl C.one_mem
  · intro a b ha hb hpa hpb
    rcases hpa with ha | ⟨c, hc, rfl⟩
    · rcases hpb with hb | ⟨d, hd, rfl⟩
      · exact Or.inl (C.mul_mem ha hb)
      · refine Or.inr ⟨(u * a * u) * d, C.mul_mem (hCu' a ha) hd, ?_⟩
        rw [← mul_assoc a u d, key a, mul_assoc]
    · rcases hpb with hb | ⟨d, hd, rfl⟩
      · exact Or.inr ⟨c * b, C.mul_mem hc hb, by rw [mul_assoc]⟩
      · refine Or.inl ?_
        rw [← mul_assoc]
        exact C.mul_mem (hCu' c hc) hd
  · intro a ha hpa
    rcases hpa with ha | ⟨c, hc, rfl⟩
    · exact Or.inl (C.inv_mem ha)
    · refine Or.inr ⟨u * c⁻¹ * u, hCu' c⁻¹ (C.inv_mem hc), ?_⟩
      rw [mul_inv_rev, hu', key]

end Work.ThreePoints.ThmC
