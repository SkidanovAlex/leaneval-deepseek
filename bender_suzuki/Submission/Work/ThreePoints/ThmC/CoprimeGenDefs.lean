/-
# Definitions and elementary API for `Work.ThreePoints.ThmC.coprime_generation`
(Peterfalvi I Ch. I §6 Lemma 2, coprime generation).

Setting: `M` is a group acting by automorphisms on a group `Y` (`[MulDistribMulAction M Y]`),
`S ⊆ M` is a set of "inverted" elements (`u * x * u⁻¹ = x⁻¹` for `x ∈ S`), and
`M₀ S u = ⟨S, u⟩ ≤ M`.

Main definitions:

* `invSet X u = {x ∈ X | u * x * u⁻¹ = x⁻¹}` — Peterfalvi's `J(X,u)`;
* `M₀ S u = Subgroup.closure (S ∪ {u})`;
* `Ksub S Y` — the subgroup generated by the fixed points of `A = ⟨S⟩` together with the fixed
  points of all involutions of `M`, i.e. the right hand side of the coprime generation lemma.
-/
import Mathlib
import Submission.Work.Coprime.Basic
import Submission.Work.Coprime.Normalizer

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedVariables false

open scoped Pointwise

namespace Work.ThreePoints.ThmC

variable {M : Type*} [Group M]

/-- `invSet X u`: the elements of the subgroup `X` that are inverted by `u`. -/
def invSet (X : Subgroup M) (u : M) : Set M := {x : M | x ∈ X ∧ u * x * u⁻¹ = x⁻¹}

/-- `M₀ S u = ⟨S, u⟩`, the subgroup of `M` generated by `S` and `u`. -/
abbrev M₀ (S : Set M) (u : M) : Subgroup M := Subgroup.closure (S ∪ {u})

/-- `Ksub S Y`: the subgroup generated by the fixed points of `A = ⟨S⟩` and by the fixed points
of the involutions of `M`. -/
def Ksub (S : Set M) (Y : Type*) [Group Y] [MulDistribMulAction M Y] : Subgroup Y :=
  Subgroup.closure ((FT.fixedPoints (Subgroup.closure S) Y : Set Y) ∪
    (⋃ v ∈ ({v : M | orderOf v = 2} : Set M), ({y : Y | v • y = y} : Set Y)))

/-! ## Elementary API for `invSet` -/

theorem mem_invSet {X : Subgroup M} {u x : M} :
    x ∈ invSet X u ↔ x ∈ X ∧ u * x * u⁻¹ = x⁻¹ := Iff.rfl

theorem invSet_inv {X : Subgroup M} {u : M} {x : M} (hx : x ∈ invSet X u) :
    x⁻¹ ∈ invSet X u := by
  refine ⟨X.inv_mem hx.1, ?_⟩
  have h : u * x⁻¹ * u⁻¹ = (u * x * u⁻¹)⁻¹ := by group
  rw [h, hx.2, inv_inv]

/-- `u` normalizes `⟨S⟩` when `u` inverts every element of `S` and `S` is closed under
inversion. -/
theorem u_mem_normalizer_closure {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) :
    u ∈ Subgroup.normalizer ((Subgroup.closure S : Subgroup M) : Set M) := by
  have himg : Subgroup.map (MulAut.conj u).toMonoidHom (Subgroup.closure S) =
      Subgroup.closure S := by
    rw [MonoidHom.map_closure]
    congr 1
    refine Set.Subset.antisymm ?_ ?_
    · rintro y ⟨x, hx, rfl⟩
      have h1 : u * x * u⁻¹ ∈ S := by rw [hSinv x hx]; exact hSclosed x hx
      simpa [MulAut.conj_apply] using h1
    · intro y hy
      refine ⟨u * y * u⁻¹, hSinv y hy ▸ hSclosed y hy, ?_⟩
      calc (MulAut.conj u).toMonoidHom (u * y * u⁻¹) = u * (u * y * u⁻¹) * u⁻¹ := by
            simp [MulAut.conj_apply]
        _ = u * y⁻¹ * u⁻¹ := by rw [hSinv y hy]
        _ = (u * y * u⁻¹)⁻¹ := by group
        _ = (y⁻¹)⁻¹ := by rw [hSinv y hy]
        _ = y := by rw [inv_inv]
  rwa [Subgroup.mem_normalizer_iff_map_conj_eq]

/-- `M₀ S u = ⟨S,u⟩` normalizes `⟨S⟩`. -/
theorem M₀_le_normalizer {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) :
    M₀ S u ≤ Subgroup.normalizer ((Subgroup.closure S : Subgroup M) : Set M) := by
  rw [M₀, Subgroup.closure_le]
  intro x hx
  rcases hx with hx | rfl
  · exact Subgroup.le_normalizer (Subgroup.subset_closure hx)
  · exact u_mem_normalizer_closure hSinv hSclosed

/-- A finite group has no fixed-point-free involutive automorphism unless the automorphism is
inversion: if `v * v = 1` and `v` fixes only `1`, then `v` acts as `y ↦ y⁻¹`.

This is `MonoidHom.FixedPointFree.coe_eq_inv_of_sq_eq_one` applied to the monoid endomorphism
`y ↦ v • y` of `Y`. -/
theorem smul_eq_inv_of_fixed_eq_bot {M Y : Type*} [Group M] [Group Y] [Finite Y]
    [MulDistribMulAction M Y] {v : M} (hv : v * v = 1)
    (hfix : ∀ y : Y, v • y = y → y = 1) : ∀ y : Y, v • y = y⁻¹ := by
  let φ : Y →* Y := (MulDistribMulAction.toMulAut M Y v).toMonoidHom
  have hφ : ∀ y : Y, φ y = v • y := fun y => rfl
  have hfpf : MonoidHom.FixedPointFree φ := fun y hy => hfix y (by rw [← hφ y]; exact hy)
  have h2 : φ^[2] = id := by
    ext y
    show φ (φ y) = y
    rw [hφ, hφ, smul_smul, hv, one_smul]
  have hmain : ⇑φ = fun y : Y => y⁻¹ := MonoidHom.FixedPointFree.coe_eq_inv_of_sq_eq_one hfpf h2
  intro y
  rw [← hφ y]
  exact congrFun hmain y

/-- **The `K = ⊥` lemma.**  Let `S ⊆ M` consist of elements inverted by the involution `u` and
suppose `⟨S⟩` has odd order.  If the fixed points of every element of `S` and of every involution
of `M` are trivial, then `Y` is trivial.

Indeed `u = 1 * u` is an involution of `M` (since `1 ∈ ⟨S⟩` has trivial fixed points… more
precisely `u` itself is an involution of `M`), hence acts by inversion; for `x ∈ S` the element
`x * u` is an involution (it has order `2` because `x * u ≠ 1`: otherwise `u = x⁻¹ ∈ ⟨S⟩` would
have order `2` dividing the odd number `|⟨S⟩|`), hence also acts by inversion, and therefore `x`
acts trivially.  Thus every `y : Y` is fixed by all of `S`, i.e. by `⟨S⟩`, and is trivial by
hypothesis. -/
theorem subsingleton_of_fix_eq_bot {M Y : Type*} [Group M] [Group Y] [Finite Y]
    [MulDistribMulAction M Y] {S : Set M} {u : M} (hu : orderOf u = 2)
    (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSodd : Odd (Nat.card ↥(Subgroup.closure S)))
    (hA : ∀ y : Y, (∀ x ∈ S, x • y = y) → y = 1)
    (hinv : ∀ v : M, orderOf v = 2 → ∀ y : Y, v • y = y → y = 1) :
    Subsingleton Y := by
  have hu2 : u * u = 1 := by
    have h := pow_orderOf_eq_one u
    rw [hu, pow_two] at h
    exact h
  have huinv : ∀ y : Y, u • y = y⁻¹ := smul_eq_inv_of_fixed_eq_bot hu2 (hinv u hu)
  have key : ∀ y : Y, y = 1 := by
    intro y
    refine hA y fun x hx => ?_
    have hxu2 : (x * u) * (x * u) = 1 := by
      calc (x * u) * (x * u) = x * (u * x * u⁻¹) * (u * u) := by group
        _ = x * x⁻¹ * 1 := by rw [hSinv x hx, hu2]
        _ = 1 := by group
    have hxu_ne : x * u ≠ 1 := by
      intro h
      have hx_eq : x = u := by
        have h1 := congrArg (· * u) h
        simpa [mul_assoc, hu2] using h1
      have hmem : u ∈ Subgroup.closure S := hx_eq ▸ Subgroup.subset_closure hx
      have hdvd : orderOf u ∣ Nat.card ↥(Subgroup.closure S) :=
        Subgroup.orderOf_dvd_natCard (Subgroup.closure S) hmem
      rw [hu] at hdvd
      exact (Nat.not_even_iff_odd.mpr hSodd) (even_iff_two_dvd.mpr hdvd)
    have hord : orderOf (x * u) = 2 :=
      orderOf_eq_prime (p := 2) (by simpa [pow_two] using hxu2) hxu_ne
    have hxuinv : ∀ y : Y, (x * u) • y = y⁻¹ :=
      smul_eq_inv_of_fixed_eq_bot hxu2 (fun y hy => hinv (x * u) hord y hy)
    calc x • y = ((x * u) * u) • y := by rw [mul_assoc, hu2, mul_one]
      _ = (x * u) • (u • y) := by rw [mul_smul]
      _ = (x * u) • y⁻¹ := by rw [huinv]
      _ = (y⁻¹)⁻¹ := hxuinv y⁻¹
      _ = y := inv_inv y
  exact ⟨fun y y' => by rw [key y, key y']⟩

/-! ## Invariance of the fixed points and of `Ksub` -/

/-- The pointwise action of a subtype element of a subgroup agrees with the action of its
underlying element. -/
theorem smul_subgroup_eq {G Y : Type*} [Group G] [Group Y] [MulDistribMulAction G Y]
    {G₀ : Subgroup G} (a : ↥G₀) (K : Subgroup Y) : a • K = (a : G) • K := by
  refine Subgroup.ext fun y => ?_
  change y ∈ (a • (K : Set Y) : Set Y) ↔ y ∈ ((a : G) • (K : Set Y) : Set Y)
  rw [Set.mem_smul_set_iff_inv_smul_mem, Set.mem_smul_set_iff_inv_smul_mem]
  rfl

/-- An element of the normalizer of `A ≤ M` preserves the fixed points of `A` in `Y`. -/
theorem smul_fixedPoints_of_mem_normalizer {M Y : Type*} [Group M] [Group Y]
    [MulDistribMulAction M Y] {a : M} {A : Subgroup M}
    (ha : a ∈ Subgroup.normalizer (A : Set M)) :
    a • (FT.fixedPoints A Y : Subgroup Y) = FT.fixedPoints A Y := by
  have hmap : ∀ x : M, x ∈ A ↔ a * x * a⁻¹ ∈ A := Subgroup.mem_normalizer_iff.mp ha
  refine le_antisymm ?_ ?_
  · intro c hc
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hc
    rw [FT.mem_fixedPoints] at hc ⊢
    intro x
    have hmem : a⁻¹ * (x : M) * a ∈ A := (hmap _).mpr (by
      rw [show a * (a⁻¹ * (x : M) * a) * a⁻¹ = (x : M) by group]
      exact x.2)
    have h2 : (a⁻¹ * (x : M) * a) • (a⁻¹ • c) = a⁻¹ • c := hc ⟨a⁻¹ * (x : M) * a, hmem⟩
    show (x : M) • c = c
    calc (x : M) • c = a • ((a⁻¹ * (x : M) * a) • (a⁻¹ • c)) := by
          rw [← mul_smul, ← mul_smul]
          rw [show a * (a⁻¹ * (x : M) * a) * a⁻¹ = (x : M) by group]
      _ = a • (a⁻¹ • c) := by rw [h2]
      _ = c := by rw [smul_smul, mul_inv_cancel, one_smul]
  · intro c hc
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
    rw [FT.mem_fixedPoints] at hc ⊢
    intro x
    have hmem : a * (x : M) * a⁻¹ ∈ A := (hmap (x : M)).mp x.2
    have h2 : (a * (x : M) * a⁻¹) • c = c := hc ⟨a * (x : M) * a⁻¹, hmem⟩
    show (x : M) • (a⁻¹ • c) = a⁻¹ • c
    calc (x : M) • (a⁻¹ • c) = a⁻¹ • ((a * (x : M) * a⁻¹) • c) := by
          rw [← mul_smul, ← mul_smul]
          rw [show a⁻¹ * (a * (x : M) * a⁻¹) = (x : M) * a⁻¹ by group]
      _ = a⁻¹ • c := by rw [h2]

/-- `FT.IsInvariant` restricts to subgroups of the acting group. -/
theorem IsInvariant.of_le {G Y : Type*} [Group G] [Group Y] [MulDistribMulAction G Y]
    {H G₀ : Subgroup G} (hle : H ≤ G₀) (K : Subgroup Y) [FT.IsInvariant ↥G₀ K] :
    FT.IsInvariant ↥H K :=
  ⟨fun a => by
    refine Subgroup.ext fun y => ?_
    change y ∈ (a • (K : Set Y) : Set Y) ↔ y ∈ (K : Set Y)
    rw [Set.mem_smul_set_iff_inv_smul_mem]
    change ((a : G))⁻¹ • y ∈ K ↔ y ∈ K
    have h := FT.IsInvariant.mem_smul_iff (A := ↥G₀) (H := K) (inferInstance : FT.IsInvariant ↥G₀ K)
      (⟨(a : G), hle a.2⟩ : ↥G₀)⁻¹ y
    change ((a : G))⁻¹ • y ∈ K ↔ y ∈ K at h
    exact h⟩

/-- `FT.IsInvariant` for the top subgroup of the acting group is invariance for the whole
acting group. -/
theorem IsInvariant.of_eq_top {G Y : Type*} [Group G] [Group Y] [MulDistribMulAction G Y]
    {G₀ : Subgroup G} (h : G₀ = ⊤) (K : Subgroup Y) [FT.IsInvariant ↥G₀ K] :
    FT.IsInvariant G K := by
  subst h
  refine ⟨fun a => ?_⟩
  refine Subgroup.ext fun y => ?_
  change y ∈ (a • (K : Set Y) : Set Y) ↔ y ∈ (K : Set Y)
  rw [Set.mem_smul_set_iff_inv_smul_mem]
  change (a⁻¹) • y ∈ K ↔ y ∈ K
  have h := FT.IsInvariant.mem_smul_iff (A := ↥(⊤ : Subgroup G)) (H := K)
    (inferInstance : FT.IsInvariant ↥(⊤ : Subgroup G) K) (⟨a, trivial⟩ : ↥(⊤ : Subgroup G))⁻¹ y
  change (a⁻¹) • y ∈ K ↔ y ∈ K at h
  exact h

/-- **`Ksub S Y` is invariant under every element of `M₀ = ⟨S,u⟩`.** -/
theorem Ksub_invariant_elem {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) :
    ∀ a : M, a ∈ M₀ S u → a • Ksub S Y = Ksub S Y := by
  intro a ha
  rw [Ksub, Subgroup.smul_closure]
  congr 1
  rw [Set.smul_set_union]
  congr 1
  · rw [← Subgroup.coe_pointwise_smul]
    rw [smul_fixedPoints_of_mem_normalizer (M₀_le_normalizer hSinv hSclosed ha)]
  · -- the union over the involutions of `M` is preserved by every element of `M`
    refine le_antisymm ?_ ?_
    · rintro y ⟨y₀, hy₀, rfl⟩
      obtain ⟨v, hv, hyv⟩ := Set.mem_iUnion₂.mp hy₀
      rw [Set.mem_ofPred_eq] at hv
      rw [Set.mem_ofPred_eq] at hyv
      refine Set.mem_iUnion₂.mpr ⟨a * v * a⁻¹, ?_, ?_⟩
      · have hord : orderOf ((MulAut.conj a) v) = 2 := by
          rw [(MulAut.conj a).orderOf_eq v]
          exact hv
        simpa [MulAut.conj_apply] using hord
      · rw [Set.mem_ofPred_eq]
        have h1 : (a * v * a⁻¹) • (a • y₀) = (a * v) • y₀ := by
          rw [← mul_smul, show a * v * a⁻¹ * a = a * v by group]
        have h2 : (a * v) • y₀ = a • (v • y₀) := mul_smul a v y₀
        rw [h1, h2, hyv]
    · rintro y hy
      obtain ⟨w, hw, hy'⟩ := Set.mem_iUnion₂.mp hy
      rw [Set.mem_ofPred_eq] at hw
      rw [Set.mem_ofPred_eq] at hy'
      rw [Set.mem_smul_set_iff_inv_smul_mem]
      refine Set.mem_iUnion₂.mpr ⟨a⁻¹ * w * a, ?_, ?_⟩
      · have hord : orderOf ((MulAut.conj a⁻¹) w) = 2 := by
          rw [(MulAut.conj a⁻¹).orderOf_eq w]
          exact hw
        simpa [MulAut.conj_apply] using hord
      · rw [Set.mem_ofPred_eq]
        have h1 : (a⁻¹ * w * a) • (a⁻¹ • y) = (a⁻¹ * w) • y := by
          rw [← mul_smul, show a⁻¹ * w * a * a⁻¹ = a⁻¹ * w by group]
        have h2 : (a⁻¹ * w) • y = a⁻¹ • (w • y) := mul_smul a⁻¹ w y
        rw [h1, h2, hy']

/-- **`Ksub S Y` is invariant under `M₀ = ⟨S,u⟩`.** -/
theorem Ksub_invariant {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) :
    FT.IsInvariant ↥(M₀ S u) (Ksub S Y) :=
  ⟨fun a => by
    refine Subgroup.ext fun y => ?_
    change y ∈ (a • (Ksub S Y : Set Y) : Set Y) ↔ y ∈ (Ksub S Y : Set Y)
    rw [Set.mem_smul_set_iff_inv_smul_mem]
    change ((a : M))⁻¹ • y ∈ Ksub S Y ↔ y ∈ Ksub S Y
    have h3 : ((a : M))⁻¹ • y ∈ Ksub S Y ↔ y ∈ Ksub S Y := by
      rw [← Subgroup.mem_pointwise_smul_iff_inv_smul_mem (a := (a : M)) (S := Ksub S Y),
        Ksub_invariant_elem hSinv hSclosed (a : M) a.2]
    exact h3⟩

/-- **`Ksub S Y` is invariant under any subgroup `H ≤ M₀ = ⟨S,u⟩`.** -/
theorem Ksub_invariant_of_le {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) {H : Subgroup M} (hH : H ≤ M₀ S u) :
    FT.IsInvariant ↥H (Ksub S Y) :=
  haveI := Ksub_invariant (Y := Y) hSinv hSclosed
  IsInvariant.of_le (G := M) (Y := Y) hH (Ksub S Y)

/-- **`Ksub S Y` is invariant under the whole acting group** when the acting group is generated
by `S` and `u`. -/
theorem Ksub_invariant_top {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) (hgen : M₀ S u = ⊤) :
    FT.IsInvariant M (Ksub S Y) :=
  haveI := Ksub_invariant (Y := Y) hSinv hSclosed
  IsInvariant.of_eq_top (G := M) (Y := Y) hgen (Ksub S Y)

/-- The `K` of an `M`-invariant subgroup `L ≤ Y` maps into the `K` of `Y`. -/
theorem map_Ksub_subgroup {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    (S : Set M) (L : Subgroup Y) [FT.IsInvariant M L] :
    (Ksub S ↥L).map L.subtype ≤ Ksub S Y := by
  rw [Subgroup.map_le_iff_le_comap, Ksub, Subgroup.closure_le]
  intro x hx
  rw [Set.mem_union] at hx
  rcases hx with hx | hx
  · rw [SetLike.mem_coe, FT.mem_fixedPoints] at hx
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    refine Subgroup.subset_closure (Or.inl ?_)
    rw [SetLike.mem_coe, FT.mem_fixedPoints]
    intro a
    exact congrArg Subtype.val (hx a)
  · rw [Set.mem_iUnion₂] at hx
    obtain ⟨v, hv, hx⟩ := hx
    rw [Set.mem_ofPred_eq] at hv hx
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    refine Subgroup.subset_closure (Or.inr ?_)
    rw [Set.mem_iUnion₂]
    exact ⟨v, hv, congrArg Subtype.val hx⟩

/-- The subgroup of elements fixing a given point `y` of a `G`-set (with a multiplicative
`G`-action on a group `Y`). -/
def fixator {G Y : Type*} [Group G] [Group Y] [MulDistribMulAction G Y] (y : Y) : Subgroup G where
  carrier := {a : G | a • y = y}
  one_mem' := one_smul G y
  mul_mem' := fun {a b} ha hb => by
    show (a * b) • y = y
    rw [mul_smul, hb, ha]
  inv_mem' := fun {a} ha => by
    show a⁻¹ • y = y
    have h2 : a⁻¹ • (a • y) = a⁻¹ • y := congrArg (fun w => a⁻¹ • w) ha
    rw [← mul_smul, inv_mul_cancel, one_smul] at h2
    exact h2.symm

/-- If every element of `S` fixes `y`, then so does every element of `⟨S⟩`. -/
theorem fixed_of_mem_closure {G Y : Type*} [Group G] [Group Y] [MulDistribMulAction G Y]
    {S : Set G} {y : Y} (h : ∀ x ∈ S, x • y = y) :
    ∀ a : G, a ∈ Subgroup.closure S → a • y = y :=
  fun _ ha => (Subgroup.closure_le (fixator y)).mpr h ha

/-- The fixed points of `⟨S⟩` lie in `Ksub S Y`. -/
theorem fixedPoints_le_Ksub {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    (S : Set M) : FT.fixedPoints ↥(Subgroup.closure S) Y ≤ Ksub S Y :=
  fun _ hy => Subgroup.subset_closure (Or.inl hy)

/-- The fixed points of an involution of `M` lie in `Ksub S Y`. -/
theorem fixedPoints_zpowers_le_Ksub {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    (S : Set M) {v : M} (hv : orderOf v = 2) :
    FT.fixedPoints ↥(Subgroup.zpowers v) Y ≤ Ksub S Y := by
  intro y hy
  refine Subgroup.subset_closure (Or.inr ?_)
  rw [Set.mem_iUnion₂]
  refine ⟨v, hv, ?_⟩
  rw [FT.mem_fixedPoints] at hy
  rw [Set.mem_ofPred_eq]
  exact hy ⟨v, Subgroup.mem_zpowers v⟩

/-- `Ksub S Y` is invariant under `⟨S⟩` (a subgroup of `M₀ = ⟨S,u⟩`). -/
theorem Ksub_invariant_closure {M Y : Type*} [Group M] [Group Y] [MulDistribMulAction M Y]
    {S : Set M} {u : M} (hSinv : ∀ x ∈ S, u * x * u⁻¹ = x⁻¹)
    (hSclosed : ∀ x ∈ S, x⁻¹ ∈ S) :
    FT.IsInvariant ↥(Subgroup.closure S) (Ksub S Y) :=
  haveI := Ksub_invariant (Y := Y) hSinv hSclosed
  IsInvariant.of_le (G := M) (Y := Y) (H := Subgroup.closure S) (G₀ := M₀ S u)
    (Subgroup.closure_mono (Set.subset_union_left)) (Ksub S Y)

end Work.ThreePoints.ThmC
