/-
# The four-group coprime action on an abelian group of odd order

Fix a group `V` acting by automorphisms on a group `G` (`MulDistribMulAction V G`).  For
`v : V`, `elemCent v = {g : G | v • g = g}` is the centraliser of a single element of the
acting group (see `Submission/Work/ThreePoints/FourGroupCoprimeDefs.lean`).

The main result of this file is the basic case of the coprime-action theorem
(Gorenstein, *Finite Groups*, Theorem 5.3.16 = Huppert I.18.6) that is used in the
Bender–Suzuki proof:

  if `a`, `b` are commuting involutions of `V` and `G` is **abelian of odd order**, then
  `G` is generated by `C_G(a)`, `C_G(b)` and `C_G(ab)`:

  `elemCent a ⊔ elemCent b ⊔ elemCent (a * b) = ⊤`.

The proof is elementary.  For an involution `c` of the acting group, write

* `antiCent c = {g : G | c • g = g⁻¹}` for the *inverted* points of `c` (a subgroup, because
  `G` is commutative).

Since `G` has odd order, `g ↦ g ^ 2` is a bijection, and for every `g`

* `g * (c • g) ∈ elemCent c`,  `g * (c • g)⁻¹ ∈ antiCent c`,  `g ^ 2 = (g * (c • g)) * (g * (c • g)⁻¹)`,

so `g ^ 2 ∈ elemCent c ⊔ antiCent c`, and `g = (g ^ 2) ^ k` with `k = (|G| + 1) / 2` lands in the
same subgroup.  Hence `⊤ = elemCent c ⊔ antiCent c`.  Applying this first to `c = a` and then,
inside the `b`-invariant subgroup `antiCent a`, to `c = b`, and using
`antiCent a ⊓ antiCent b ≤ elemCent (a * b)`, gives the result.

The auxiliary lemma `le_sup_elemCent_inf_antiCent` states the needed relative form: for any
`c`-invariant subgroup `H ≤ G`, one has
`H ≤ (elemCent c ⊓ H) ⊔ (antiCent c ⊓ H)`.
-/
import Mathlib
import Submission.Work.ThreePoints.FourGroupCoprimeDefs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

-- Needed to use the (bundled) commutative-group library for the unbundled hypothesis
-- `IsMulCommutative G`: the scoped instances turn `Group G + IsMulCommutative G` into
-- `CommGroup G`.
open scoped IsMulCommutative

namespace Work.ThreePoints

section AbelianCoprime

variable {V : Type*} [Group V] {G : Type*} [Group G] [IsMulCommutative G]
  [MulDistribMulAction V G]

/-- The **inverted** points of an element `v` of the acting group:
`antiCent v = {g : G | v • g = g⁻¹}`.  This is a subgroup when `G` is commutative (then
`(xy)⁻¹ = x⁻¹ y⁻¹`) — the reason for the `IsMulCommutative` hypothesis. -/
def antiCent (v : V) : Subgroup G where
  carrier := {g | v • g = g⁻¹}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    show v • (x * y) = (x * y)⁻¹
    rw [smul_mul', hx, hy, mul_inv_rev, mul_comm']
  inv_mem' := by
    intro x hx
    show v • x⁻¹ = (x⁻¹)⁻¹
    rw [smul_inv', hx]

@[simp] theorem mem_antiCent {v : V} {g : G} : g ∈ antiCent v ↔ v • g = g⁻¹ := Iff.rfl

end AbelianCoprime

section SmulSelf

variable {V : Type*} [Group V] {G : Type*} [Group G] [MulDistribMulAction V G]

/-- `v • (v • g) = g` when `v` is an involution of the acting group. -/
theorem smul_smul_self {v : V} (hv : v * v = 1) (g : G) : v • (v • g) = g := by
  rw [← mul_smul, hv, one_smul]

end SmulSelf

section AbelianCoprime

variable {V : Type*} [Group V] {G : Type*} [Group G] [IsMulCommutative G]
  [MulDistribMulAction V G]

/-- A small rearrangement in a commutative group: `(x * y) * (x * y⁻¹) = x ^ 2`. -/
theorem mul_mul_inv_eq_sq (x y : G) : (x * y) * (x * y⁻¹) = x ^ 2 := by
  have h1 : y * (x * y⁻¹) = x * (y * y⁻¹) := by
    rw [← mul_assoc, mul_comm' y x, mul_assoc]
  rw [mul_assoc, h1, mul_inv_cancel, mul_one, ← pow_two]

/-- **Coprime involution decomposition, relative form.**  Let `c` be an involution of the acting
group and let `H ≤ G` be a `c`-invariant subgroup.  If `G` is a finite abelian group of odd
order, then every element of `H` is a product of an element of `H` fixed by `c` and an element of
`H` inverted by `c`; equivalently `H ≤ (elemCent c ⊓ H) ⊔ (antiCent c ⊓ H)`. -/
theorem le_sup_elemCent_inf_antiCent [Finite G] {c : V} (hc : c * c = 1) (H : Subgroup G)
    (hH : ∀ x ∈ H, c • x ∈ H) (hodd : Odd (Nat.card G)) :
    H ≤ (elemCent c ⊓ H) ⊔ (antiCent c ⊓ H) := by
  intro g hg
  -- `k = (|G| + 1) / 2` satisfies `2 * k = |G| + 1`, so that `(g ^ 2) ^ k = g`.
  set k : ℕ := (Nat.card G + 1) / 2 with hkdef
  have hk : 2 * k = Nat.card G + 1 := by
    rw [hkdef, Nat.mul_comm]
    exact Nat.div_two_mul_two_of_even hodd.add_one
  have hcard : g ^ Nat.card G = 1 := by
    haveI : Fintype G := Fintype.ofFinite G
    rw [Nat.card_eq_fintype_card]
    exact pow_card_eq_one
  have hgexp : g ^ (Nat.card G + 1) = g := by
    rw [pow_succ, hcard, one_mul]
  have hpow : (g ^ 2) ^ k = g := by
    rw [← pow_mul, hk, hgexp]
  -- The fixed and inverted factors of `g`.
  have hcfix : c • (g * (c • g)) = g * (c • g) := by
    rw [smul_mul', smul_smul_self hc g]
    exact mul_comm' _ _
  have hcanti : c • (g * (c • g)⁻¹) = (g * (c • g)⁻¹)⁻¹ := by
    rw [smul_mul', smul_inv', smul_smul_self hc g, mul_inv_rev, inv_inv]
  have hu : g * (c • g) ∈ elemCent c ⊓ H :=
    Subgroup.mem_inf.mpr ⟨hcfix, H.mul_mem hg (hH g hg)⟩
  have hv : g * (c • g)⁻¹ ∈ antiCent c ⊓ H :=
    Subgroup.mem_inf.mpr ⟨hcanti, H.mul_mem hg (H.inv_mem (hH g hg))⟩
  -- `g ^ 2` is the product of the two factors, hence lies in the join.
  have hsq : g ^ 2 ∈ (elemCent c ⊓ H) ⊔ (antiCent c ⊓ H) := by
    rw [← mul_mul_inv_eq_sq g (c • g)]
    exact Subgroup.mul_mem_sup hu hv
  -- A subgroup is closed under powers, and `g = (g ^ 2) ^ k`.
  have hfin : (g ^ 2) ^ k ∈ (elemCent c ⊓ H) ⊔ (antiCent c ⊓ H) :=
    ((elemCent c ⊓ H) ⊔ (antiCent c ⊓ H)).pow_mem hsq k
  rwa [hpow] at hfin

end AbelianCoprime

theorem abelian_elemCent_sup_eq_top {V G : Type*} [Group V] [Group G] [Finite G]
    [MulDistribMulAction V G] [IsMulCommutative G] {a b : V}
    (ha2 : a * a = 1) (hb2 : b * b = 1) (hcomm : a * b = b * a)
    (hodd : Odd (Nat.card G)) :
    Work.ThreePoints.elemCent (G := G) a ⊔ Work.ThreePoints.elemCent b ⊔
      Work.ThreePoints.elemCent (a * b) = ⊤ := by
  -- `⊤ = elemCent a ⊔ antiCent a`.
  have htopa : elemCent (G := G) a ⊔ antiCent a = ⊤ := by
    rw [eq_top_iff]
    calc ⊤ ≤ (elemCent (G := G) a ⊓ ⊤) ⊔ (antiCent a ⊓ ⊤) :=
          le_sup_elemCent_inf_antiCent (H := ⊤) ha2 (fun x _ => Subgroup.mem_top x) hodd
      _ = elemCent (G := G) a ⊔ antiCent a := by rw [inf_top_eq, inf_top_eq]
  -- `antiCent a` is invariant under `b` (as `a` and `b` commute).
  have hb_inv : ∀ x : G, x ∈ antiCent a → b • x ∈ antiCent a := by
    intro x hx
    rw [mem_antiCent] at hx ⊢
    rw [← mul_smul, hcomm, mul_smul, hx, smul_inv']
  -- Decompose `antiCent a` along `b`; both pieces stay inside `antiCent a`.
  have hstep2 : antiCent a ≤ elemCent (G := G) b ⊔ (antiCent a ⊓ antiCent b) := by
    calc antiCent a ≤ (elemCent (G := G) b ⊓ antiCent a) ⊔ (antiCent b ⊓ antiCent a) :=
          le_sup_elemCent_inf_antiCent (H := antiCent a) hb2 hb_inv hodd
      _ ≤ elemCent (G := G) b ⊔ (antiCent a ⊓ antiCent b) := by
          apply sup_le
          · exact le_sup_of_le_left inf_le_left
          · exact le_sup_of_le_right (le_of_eq (inf_comm (antiCent b) (antiCent a)))
  -- Points inverted by both `a` and `b` are fixed by `a * b`.
  have hstep3 : antiCent a ⊓ antiCent b ≤ elemCent (G := G) (a * b) := by
    intro x hx
    rw [Subgroup.mem_inf, mem_antiCent, mem_antiCent] at hx
    rw [mem_elemCent, mul_smul, hx.2, smul_inv', hx.1, inv_inv]
  apply eq_top_iff.mpr
  rw [← htopa]
  apply sup_le
  · exact le_trans le_sup_left le_sup_left
  · calc antiCent a ≤ elemCent (G := G) b ⊔ (antiCent a ⊓ antiCent b) := hstep2
      _ ≤ (elemCent (G := G) a ⊔ elemCent (G := G) b) ⊔ elemCent (G := G) (a * b) := by
          apply sup_le
          · exact le_trans le_sup_right le_sup_left
          · exact le_trans hstep3 le_sup_right

end Work.ThreePoints
