namespace Work.FeitSibley.Coherence

open scoped commutatorElement

/-- `⁅Z, Q⁆ ≤ Q₃` whenever `Z ≤ Q₁`, `H` normalises `Q₃`, and `Z` commutes with `Q₁` modulo
`Q₃`.

Writing `q ∈ Q` uniquely as `q = a * b` with `a ∈ S` and `b ∈ Q₁` (`h.mem_Q_decomp`), and
using that `S` and `Q₁` commute elementwise, a commutator `⁅z, q⁆` with `z ∈ Z ≤ Q₁` splits as
`⁅z, a * b⁆ = a * ⁅z, b⁆ * a⁻¹`: the `S`-part `a` contributes nothing (`⁅z, a⁆ = 1`), and the
`Q₁`-part `b` contributes `⁅z, b⁆ ∈ Q₃` by hypothesis.  Conjugating by `a ∈ S ≤ H`, which
normalises `Q₃`, keeps us inside `Q₃`.  Since `⁅Z, Q⁆` is generated by these commutators, it is
contained in `Q₃`. -/
theorem commutator_Z_Q_le_Q3_of_le_center_quotient {G : Type} [Group G] [Fintype G]
    (h : Work.FeitSibley.FSData G) (Z Q3 : Subgroup G) (hZQ1 : Z ≤ h.Q1)
    (hQ3n : h.H ≤ Subgroup.normalizer (Q3 : Set G))
    (hZcen : ∀ x : G, x ∈ Z → ∀ y : G, y ∈ h.Q1 → x * y * x⁻¹ * y⁻¹ ∈ Q3) :
    ⁅Z, h.Q⁆ ≤ Q3 := by
  rw [Subgroup.commutator_le]
  intro z hz q hq
  -- split `q = a * b` with `a ∈ S`, `b ∈ Q₁`.
  obtain ⟨a, ha, b, hb, rfl⟩ := h.mem_Q_decomp hq
  -- `z ∈ Z ≤ Q₁` commutes with `a ∈ S`, so `⁅z, a⁆ = 1`.
  have hza : ⁅z, a⁆ = 1 :=
    commutatorElement_eq_one_iff_mul_comm.mpr (h.commute a ha z (hZQ1 hz)).symm
  -- `⁅z, b⁆ ∈ Q₃` by hypothesis (`z ∈ Z`, `b ∈ Q₁`).
  have hzb : ⁅z, b⁆ ∈ Q3 := hZcen z hz b hb
  -- Reduce the commutator to a conjugate of `⁅z, b⁆` by `a`.
  have key : ⁅z, a * b⁆ = a * ⁅z, b⁆ * a⁻¹ := by
    rw [commutatorElement_mul_right_eq_mul_conj, hza]
    simp
  rw [key]
  -- `a ∈ S ≤ H ≤ N(Q₃)` conjugates `Q₃` into itself.
  have haQ3 : a ∈ Subgroup.normalizer (Q3 : Set G) := hQ3n (h.S_le_H ha)
  exact (Subgroup.mem_normalizer_iff.mp haQ3 ⁅z, b⁆).mp hzb

end Work.FeitSibley.Coherence
