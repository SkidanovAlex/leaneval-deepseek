variable {H G : Type*} [Group H] [Fintype H] [Group G] [Fintype G]

/-- The **linear shift** of `τ` by `a`:
`f ↦ ∑_{χ ∈ S} ⟨f, χ⟩ • (τ χ + χ(1) • a)`.

Its defining property is that `linearShift S τ a χ = τ χ + χ(1) • a` for `χ ∈ S` (because `S` is
orthonormal), while for `α ∈ ℤ[S]⁰` (where the total degree `∑ c_χ χ(1)` vanishes) it reduces to
`τ α`. -/
def linearShift (S : Finset (H → ℂ)) (τ : (H → ℂ) →ₗ[ℤ] (G → ℂ)) (a : G → ℂ) :
    (H → ℂ) →ₗ[ℤ] (G → ℂ) where
  toFun f := ∑ χ : S, Work.Coherence.cfInner f (χ : H → ℂ) •
    (τ (χ : H → ℂ) + ((χ : H → ℂ) 1) • a)
  map_add' f g := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun χ _ => ?_
    rw [Work.Coherence.cfInner_add_left, add_smul]
  map_smul' n f := by
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun χ _ => ?_
    rw [Work.Coherence.cfInner_zsmul_left, mul_smul, Int.cast_smul_eq_zsmul]
    simp only [RingHom.id_apply]

@[simp] theorem linearShift_apply (S : Finset (H → ℂ)) (τ : (H → ℂ) →ₗ[ℤ] (G → ℂ))
    (a : G → ℂ) (f : H → ℂ) :
    linearShift S τ a f =
      ∑ χ : S, Work.Coherence.cfInner f (χ : H → ℂ) •
        (τ (χ : H → ℂ) + ((χ : H → ℂ) 1) • a) := rfl

variable {S : Finset (H → ℂ)} {τ : (H → ℂ) →ₗ[ℤ] (G → ℂ)} {a : G → ℂ}

/-- `τ` applied to an element of `ℤ[S]` (`S` orthonormal) is the integral combination of the
`τ χ` with the coefficients `⟨α, χ⟩`. -/
theorem map_sum_cfInner_smul (hS : Work.Coherence.Orthonormal S)
    (τ : (H → ℂ) →ₗ[ℤ] (G → ℂ)) {α : H → ℂ} (hα : α ∈ Work.Coherence.ZSpan S) :
    ∑ x : S, Work.Coherence.cfInner α (x : H → ℂ) • τ (x : H → ℂ) = τ α := by
  have hsum : α = ∑ x : S, Work.Coherence.cfInner α (x : H → ℂ) • (x : H → ℂ) :=
    Work.Coherence.eq_sum_coeff hS hα
  conv_rhs => rw [hsum]
  rw [map_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  obtain ⟨n, hn⟩ := Work.Coherence.exists_int_coeff hS hα x
  rw [hn]
  simp only [Int.cast_smul_eq_zsmul]
  rw [map_zsmul]

theorem linearShift_apply_mem (hS : Work.Coherence.Orthonormal S) {χ : H → ℂ} (hχ : χ ∈ S) :
    linearShift S τ a χ = τ χ + (χ 1) • a := by
  rw [linearShift_apply]
  rw [Finset.sum_eq_single (⟨χ, hχ⟩ : S)]
  · rw [hS χ hχ χ hχ]; simp
  · intro b _ hb
    have hne : (b : H → ℂ) ≠ χ := fun h => hb (Subtype.ext h)
    rw [hS χ hχ (b : H → ℂ) b.2]
    simp [Ne.symm hne]
  · intro h; exact absurd (Finset.mem_univ _) h

/-- **The linear-shift extension engine.**  If `S` is orthonormal, the shifted family
`χ ↦ τ χ + χ(1) • a` consists of virtual characters and has the Gram matrix of `S`, then `S` is
`τ`-coherent. -/
theorem coherent_of_linearShift (hS : Work.Coherence.Orthonormal S)
    (hshift : ∀ χ ∈ S, Work.Coherence.IsVChar (τ χ + (χ 1) • a))
    (hgram : ∀ χ ∈ S, ∀ ψ ∈ S,
      Work.Coherence.cfInner (τ χ + (χ 1) • a) (τ ψ + (ψ 1) • a) =
        Work.Coherence.cfInner χ ψ) :
    Work.Coherence.Coherent S τ := by
  refine ⟨linearShift S τ a, ?_, ?_, ?_⟩
  · -- agreement with `τ` on `ℤ[S]⁰`
    intro α hα
    rw [linearShift_apply]
    have hmap := map_sum_cfInner_smul hS τ hα.1
    have hsplit : ∑ x : S, Work.Coherence.cfInner α (x : H → ℂ) •
          (τ (x : H → ℂ) + ((x : H → ℂ) 1) • a)
        = (∑ x : S, Work.Coherence.cfInner α (x : H → ℂ) • τ (x : H → ℂ))
          + (∑ x : S, (Work.Coherence.cfInner α (x : H → ℂ) * ((x : H → ℂ) 1)) • a) := by
      simp only [smul_add, Finset.sum_add_distrib, smul_smul]
    rw [hsplit, hmap, ← Finset.sum_smul]
    have h3 : ∑ x : S, Work.Coherence.cfInner α (x : H → ℂ) * ((x : H → ℂ) 1) = α 1 := by
      have hsum := Work.Coherence.eq_sum_coeff hS hα.1
      have hc := congrArg (fun f : H → ℂ => f 1) hsum
      simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hc.symm
    have h0 : α 1 = 0 := hα.2
    rw [h3, h0, zero_smul, add_zero]
  · -- isometry on all of `ℤ[S]`
    refine Work.Coherence.isometryOnAll_of_gram (fun x hx y hy => ?_)
    rw [linearShift_apply_mem hS hx, linearShift_apply_mem hS hy]
    exact hgram x hx y hy
  · -- virtual-character values on `S`
    intro χ hχ
    rw [linearShift_apply_mem hS hχ]
    exact hshift χ hχ

/-! ## Elementary coherence criteria

The first two lemmas are the general tools used below: a `Finset` of at most one character of
non-zero degree is coherent for any `τ` (there are no degree-zero relations), and the contrapositive
of Feit's criterion (`coherent_union_singleton`) — the form in which the chief-series inductions of
Peterfalvi's App. XII steps (1)–(3) use it. -/

/-- **A set of at most one character of non-zero degree is coherent for any `τ`.**  When `S = {x}`
with `x 1 ≠ 0`, the degree-zero lattice `ℤ[S]⁰` is trivial, so any lift of the single generator to
`±Irr G` extends `τ`. -/
theorem coherent_of_card_le_one {H G : Type*} [Group H] [Fintype H] [Group G] [Fintype G]
    {S : Finset (H → ℂ)} {τ : (H → ℂ) →ₗ[ℤ] (G → ℂ)}
    (hcard : S.card ≤ 1) (horth : Work.Coherence.Orthonormal S)
    (hdeg : ∀ x ∈ S, x 1 ≠ 0) : Work.Coherence.Coherent S τ := by
  classical
  by_cases hS : S = ∅
  · rw [hS]; exact Work.Coherence.coherent_empty
  · obtain ⟨x, hx⟩ := Finset.nonempty_iff_ne_empty.mpr hS
    have huniq : ∀ y ∈ S, y = x := fun y hy => (Finset.card_le_one.mp hcard) y hy x hx
    have hSeq : S = {x} := by
      refine Finset.Subset.antisymm ?_ ?_
      · intro y hy; rw [Finset.mem_singleton]; exact huniq y hy
      · intro y hy; rw [Finset.mem_singleton] at hy; rw [hy]; exact hx
    have hxx : Work.Coherence.cfInner x x = 1 := by
      simpa using horth x hx x hx
    obtain ⟨V, hVIrr⟩ := Work.CharCore.Irr_nonempty (G := G)
    have hVIrr' : V ∈ Work.Coherence.Irr G := (Work.CharCore.mem_Irr_iff_coherence).mp hVIrr
    have hx1 : x 1 ≠ 0 := hdeg x hx
    let φ : (H → ℂ) →ₗ[ℤ] ℂ :=
      (((LinearMap.proj (R := ℂ) (φ := fun _ : H => ℂ)) (1 : H)).restrictScalars ℤ).smulRight
        ((x 1)⁻¹)
    let τ' : (H → ℂ) →ₗ[ℤ] (G → ℂ) := φ.smulRight V
    have hφx : φ x = 1 := by
      simp only [φ, LinearMap.smulRight_apply, LinearMap.restrictScalars_apply,
        LinearMap.proj_apply, smul_eq_mul]
      rw [mul_inv_cancel₀ hx1]
    have hτ'x : τ' x = V := by
      simp only [τ', LinearMap.smulRight_apply, hφx, one_smul]
    refine ⟨τ', ?_, ?_, ?_⟩
    · intro α hα
      have hα0 : α = 0 := by
        rw [hSeq] at hα
        obtain ⟨hαmem, hα1⟩ := (Work.Coherence.mem_zSpan0).mp hα
        rw [Work.Coherence.zSpan_singleton] at hαmem
        obtain ⟨n, hn⟩ := AddSubgroup.mem_closure_singleton.mp hαmem
        have hn0 : n = 0 := by
          have h2 : (n : ℂ) * (x 1) = 0 := by
            have := hα1
            rw [← hn] at this
            simpa only [Pi.smul_apply, zsmul_eq_mul] using this
          have h3 : (n : ℂ) = 0 := (mul_eq_zero.mp h2).resolve_right hx1
          exact_mod_cast h3
        rw [← hn, hn0, zero_smul]
      rw [hα0, map_zero, map_zero]
    · refine Work.Coherence.isometryOnAll_of_gram fun y hy z hz => ?_
      rw [huniq y hy, huniq z hz, hτ'x]
      rw [Work.Coherence.irr_cfInner hVIrr' hVIrr', hxx]; simp
    · intro y hy
      rw [huniq y hy, hτ'x]
      exact Work.Coherence.isVChar_of_mem_Irr hVIrr'

/-- **Contrapositive of Feit's criterion** (`Coherence.coherent_union_singleton`, Isaacs 7.14):
if `S₀ ∪ {χ}` is *not* coherent while `S₀` is, then for every `ψ ∈ S₀` whose degree divides `χ(1)`
the "Feit inequality" fails, i.e. `∑_{ξ∈S₀} ξ(1)² ≤ 2 ψ(1) χ(1)`.

This is the form in which Peterfalvi II, App. XII uses Lemma 1(a) in the chief-series inductions of
steps (1)–(3). -/
theorem not_coherent_union_singleton {H G : Type*} [Group H] [Fintype H] [Group G] [Fintype G]
    {S0 : Finset (H → ℂ)} {chi : H → ℂ} {tau : (H → ℂ) →ₗ[ℤ] (G → ℂ)}
    (hchi : chi ∉ S0)
    (hIrr : ∀ xi ∈ S0 ∪ {chi}, xi ∈ Work.CharCore.Irr H)
    (htau : Work.Coherence.IsometryOn (S0 ∪ {chi}) tau)
    (htauV : ∀ alpha ∈ Work.Coherence.ZSpan0 (S0 ∪ {chi}),
      Work.Coherence.IsVChar (tau alpha) ∧ tau alpha 1 = 0)
    (hcoh : Work.Coherence.Coherent S0 tau)
    (hnot : ¬ Work.Coherence.Coherent (S0 ∪ {chi}) tau) :
    ∀ psi ∈ S0, ∀ d : ℕ, chi 1 = (d : ℂ) * psi 1 →
      ∑ xi ∈ S0, (Work.CharCore.irrDeg xi) ^ 2 ≤ 2 * Work.CharCore.irrDeg psi *
        Work.CharCore.irrDeg chi := by
  intro psi hpsi d hd
  by_contra hcon
  push_neg at hcon
  exact hnot (coherent_union_singleton hchi hIrr htau htauV hcoh ⟨psi, hpsi, d, hd, hcon⟩)

/-! ## Milestone A: `𝒮(Q')` is coherent (Peterfalvi II, App. XII, p. 288)

`Q' = ⁅Q,Q⁆`, and every member of `𝒮(Q')` has degree `d = |D|` (`scriptSR_deg_Qcomm`), so
`𝒮(Q')` is coherent by Isaacs 7.15 (`Coherence.coherent_of_norm_two_lift`) — or, under
`|𝒮(Q')| ≤ 1`, trivially by `coherent_of_card_le_one`. -/

theorem scriptSR_Qcomm_le_Q {G : Type} [Group G] [Fintype G] (h : Work.FeitSibley.FSData G) :
    FSQcomm h ≤ h.Q := by
  rw [FSQcomm]
  exact (Subgroup.commutator_le_sup h.Q h.Q).trans (le_of_eq (sup_idem _))

theorem scriptSR_Qcomm_deg {G : Type} [Group G] [Fintype G] (h : Work.FeitSibley.FSData G)
    {χ : ↥h.H → ℂ} (hχ : χ ∈ Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h)) :
    χ 1 = (Nat.card h.D : ℂ) :=
  scriptSR_deg_Qcomm h (scriptSR_Qcomm_le_Q h) le_rfl hχ

theorem scriptSR_Qcomm_orthonormal {G : Type} [Group G] [Fintype G]
    (h : Work.FeitSibley.FSData G) :
    Work.Coherence.Orthonormal (Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h)) := by
  refine Work.Coherence.irr_orthonormal_finset fun x hx => ?_
  have hxS := scriptSR_subset_scriptS h (FSQcomm h) hx
  have hxIrr : x ∈ Work.CharCore.Irr ↥h.H := (Finset.mem_filter.mp hxS).1
  exact (Work.CharCore.mem_Irr_iff_coherence).mp hxIrr

theorem scriptSR_Qcomm_isometryOn {G : Type} [Group G] [Fintype G]
    (h : Work.FeitSibley.FSData G) :
    Work.Coherence.IsometryOn (Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h))
      (Work.FeitSibley.indLin h.H) :=
  ⟨fun α hα β hβ =>
    (Work.FeitSibley.CharQ.isometry_indLin h).inner_eq α
      (Work.Coherence.zSpan0_mono (scriptSR_subset_scriptS h (FSQcomm h)) hα) β
      (Work.Coherence.zSpan0_mono (scriptSR_subset_scriptS h (FSQcomm h)) hβ)⟩

theorem coherent_scriptSR_Qcomm {G : Type} [Group G] [Fintype G] (h : Work.FeitSibley.FSData G) :
    Work.Coherence.Coherent (Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h))
      (Work.FeitSibley.indLin h.H) := by
  classical
  have hD0 : (Nat.card h.D : ℂ) ≠ 0 := by
    have hpos : 0 < Nat.card h.D := by
      rw [Nat.card_eq_fintype_card]; exact Fintype.card_pos
    exact_mod_cast hpos.ne'
  by_cases hcard : (Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h)).card ≤ 1
  · exact coherent_of_card_le_one hcard (scriptSR_Qcomm_orthonormal h)
      (fun x hx => by rw [scriptSR_Qcomm_deg h hx]; exact hD0)
  · have hcard2 : 1 < (Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h)).card :=
      Nat.lt_of_not_le hcard
    have hc2 : 2 ≤ (Work.FeitSibley.scriptSR h.H h.Q1 (FSQcomm h)).card :=
      Nat.succ_le_of_lt hcard2
    obtain ⟨η₁, hη₁⟩ := Finset.card_pos.mp (lt_trans Nat.zero_lt_one hcard2)
    refine Work.Coherence.coherent_of_norm_two_lift (scriptSR_Qcomm_orthonormal h) hη₁
      (fun x hx => by rw [scriptSR_Qcomm_deg h hx, scriptSR_Qcomm_deg h hη₁])
      (by rw [scriptSR_Qcomm_deg h hη₁]; exact hD0) (scriptSR_Qcomm_isometryOn h) ?_ ?_ hc2
    · intro x hx
      rw [map_sub]
      exact ((isVChar_indLin_scriptS h (scriptSR_subset_scriptS h _ hx)).sub
        (isVChar_indLin_scriptS h (scriptSR_subset_scriptS h _ hη₁)))
    · intro x hx
      rw [map_sub, Pi.sub_apply, Work.FeitSibley.indLin_apply, Work.FeitSibley.indLin_apply,
        Work.Induction.indFun_apply_one, Work.Induction.indFun_apply_one,
        scriptSR_Qcomm_deg h hx, scriptSR_Qcomm_deg h hη₁]
      ring

/-- **The "Feit step".**  To prove that `S` is `τ`-coherent it suffices to rule out, for every
`χ ∈ S ∖ S₀`, the situation in which Feit's criterion (`Coherence.coherent_union_singleton`)
supplies a *strict* inequality against `S₀`.

This is the shape in which the chief-series inductions of Peterfalvi II, App. XII, steps (1)–(3)
use Lemma 1(a): one derives from `¬ Coherent S τ` (via `exists_chi_not_coherent`) an element `χ`
obeying the non-strict inequality, and contradicts it with a bound on `χ(1)`. -/
theorem coherent_of_feit_step {H G : Type*} [Group H] [Fintype H] [Group G] [Fintype G]
    {S0 S : Finset (H → ℂ)} {τ : (H → ℂ) →ₗ[ℤ] (G → ℂ)}
    (hsub : S0 ⊆ S) (hIrr : ∀ x ∈ S, x ∈ Work.CharCore.Irr H)
    (hτ : Work.Coherence.IsometryOn S τ)
    (hτV : ∀ α ∈ Work.Coherence.ZSpan0 S,
      Work.Coherence.IsVChar (τ α) ∧ τ α 1 = 0)
    (hcoh : Work.Coherence.Coherent S0 τ)
    (hcontr : ∀ χ ∈ S, χ ∉ S0 →
      (∀ ψ ∈ S0, ∀ d : ℕ, χ 1 = (d : ℂ) * ψ 1 →
        ∑ ξ ∈ S0, (Work.CharCore.irrDeg ξ) ^ 2 ≤
          2 * Work.CharCore.irrDeg ψ * Work.CharCore.irrDeg χ) → False) :
    Work.Coherence.Coherent S τ := by
  by_contra hnot
  obtain ⟨χ, hχS, hχ0, hineq⟩ :=
    exists_chi_not_coherent hsub hIrr hτ hτV hcoh hnot
  exact hcontr χ hχS hχ0 hineq

/-! ### Size bounds for `D`-invariant subgroups of `Q₁` -/

/-- **`2·|D| + 1 ≤ |A|` for a `D`-invariant `A ≤ Q₁` whose order is not `|D| + 1`.**

`D` acts fixed point freely on `A` (`Work.FeitSibley.GroupTheory.D_dvd_card_sub_one`), so
`|A| - 1 = k·|D|` with `k ≥ 1` (as `A ≠ ⊥` gives `|A| ≥ 2`).  The value `k = 1`, i.e.
`|A| = |D| + 1`, is exactly the excluded case; hence `k ≥ 2` and `|A| ≥ 2|D| + 1`.

This is the form used in the arithmetic of Peterfalvi II, App. XII, steps (1)–(2), where
`A = Q₁` or `A = Z(Q₁)` and the case `|A| = |D| + 1` is excluded by `Q₁` not being a
`2`-group (`|D|` is odd, so `|D| + 1` is even and `D` acts *regularly* on `A^#` when
`|A| = |D| + 1`, forcing `A` to be elementary abelian of `2`-power order). -/
theorem two_mul_card_D_add_one_le_card_of_ne {G : Type} [Group G] [Fintype G]
    (h : Work.FeitSibley.FSData G) (A : Subgroup G) (hA : A ≤ h.Q1)
    (hAn : h.D ≤ Subgroup.normalizer (A : Set G)) (hAne : A ≠ ⊥)
    (hne : Nat.card ↥A ≠ Nat.card h.D + 1) :
    2 * Nat.card h.D + 1 ≤ Nat.card ↥A := by
  obtain ⟨k, hk⟩ := Work.FeitSibley.GroupTheory.D_dvd_card_sub_one h A hA hAn
  have hA2 : 2 ≤ Nat.card ↥A := Work.FeitSibley.FSData.two_le_card_of_ne_bot A hAne
  have hAeq : Nat.card ↥A = Nat.card h.D * k + 1 :=
    (Nat.sub_eq_iff_eq_add (by omega : 1 ≤ Nat.card ↥A)).mp hk
  have hk2 : 2 ≤ k := by
    rcases Nat.lt_or_ge k 2 with hlt | hge
    · interval_cases k
      · exact absurd hAeq (by omega)
      · exact absurd (by omega : Nat.card ↥A = Nat.card h.D + 1) hne
    · exact hge
  calc 2 * Nat.card h.D + 1 ≤ Nat.card h.D * k + 1 := by
        have hmul : 2 * Nat.card h.D ≤ Nat.card h.D * k := by
          calc 2 * Nat.card h.D = Nat.card h.D * 2 := by ring
            _ ≤ Nat.card h.D * k := Nat.mul_le_mul_left _ hk2
        omega
    _ = Nat.card ↥A := hAeq.symm

/-! ### The lower central series of `S` is `H`-invariant -/

/-- The terms of the lower central series of `h.S` are characteristic in `h.S`, hence normalised by
`h.H` (which normalises `h.S`).  These are the subgroups `S₁ ⊴ H`, `S₁ ⊆ S'` of Peterfalvi II,
App. XII, step (2). -/
theorem H_le_normalizer_lowerCentralSeries {G : Type} [Group G] [Fintype G]
    (h : Work.FeitSibley.FSData G) (n : ℕ) :
    h.H ≤ Subgroup.normalizer (((h.S).lowerCentralSeries n : Subgroup G) : Set G) := by
  intro x hx
  have hx' : x ∈ Subgroup.normalizer ((h.S : Subgroup G) : Set G) := h.S_normal_in_H hx
  have hmem : ∀ y : G, y ∈ (h.S : Set G) ↔ (MulAut.conj x) y ∈ (h.S : Set G) := by
    intro y
    simpa [MulAut.conj_apply] using (Subgroup.mem_set_normalizer_iff.mp hx' y)
  have hSmap : (h.S).map (MulAut.conj x).toMonoidHom = h.S := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩; exact (hmem z).mp hz
    · intro hy
      refine ⟨(MulAut.conj x).symm y, (hmem _).mpr ?_, ?_⟩
      · rw [MulEquiv.apply_symm_apply]; exact hy
      · exact MulEquiv.apply_symm_apply (MulAut.conj x) y
  have key : ∀ m : ℕ, ((h.S).lowerCentralSeries m).map (MulAut.conj x).toMonoidHom
      = (h.S).lowerCentralSeries m := by
    intro m
    rw [Subgroup.map_lowerCentralSeries, hSmap]
  rw [Subgroup.mem_set_normalizer_iff]
  intro y
  have hiff : y ∈ (h.S).lowerCentralSeries n ↔
      (MulAut.conj x) y ∈ (h.S).lowerCentralSeries n := by
    constructor
    · intro hy
      have h2 : (MulAut.conj x) y ∈ ((h.S).lowerCentralSeries n).map
          (MulAut.conj x).toMonoidHom := ⟨y, hy, rfl⟩
      rwa [key n] at h2
    · intro hy
      have h2 : (MulAut.conj x) y ∈ ((h.S).lowerCentralSeries n).map
          (MulAut.conj x).toMonoidHom := by rwa [key n]
      obtain ⟨z, hz, hzy⟩ := h2
      have hzy' : (MulAut.conj x) z = (MulAut.conj x) y := by
        simpa only [MulEquiv.coe_toMonoidHom] using hzy
      have hzy'' : z = y := (MulAut.conj x).injective hzy'
      rw [hzy''] at hz
      exact hz
  exact hiff


end

