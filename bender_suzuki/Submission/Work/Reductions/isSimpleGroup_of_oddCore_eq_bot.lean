/-!
# The simple case of the reduction of Theorem B

Peterfalvi I Ch. I §6 Cor. 3 (p. 162): if `O(G) = 1` and `O^{2'}(G) = G`, then `G` is simple.
The proof compresses as follows.  Let `L = ⟨Inv G⟩` be the subgroup generated by the involutions
of `G` (the paper's `L`), a normal subgroup; it contains every involution, and the involutions of
`G` are a single conjugacy class, so `L` has no proper normal subgroup of even order.

1. `L ⊄ H` (otherwise, for `g ∉ H`, the involution `u ∈ H` would lie in the odd-order group
   `H ⊓ H^g`, since `L ⊴ G`), while `H ⊓ L` contains an involution, so `(H ⊓ L).subgroupOf L` is
   strongly embedded in `L` and `L` has 2-rank ≥ 2; by Theorem A (`hA`) `L` is doubly transitive
   on its conjugates of `H ⊓ L`, which — because `L` is transitive on `Ω = G ⧸ H` — is doubly
   transitive on `Ω` (`transfer_twoTransitive`).
2. Hence `H ⊓ L` is transitive on the points of `Ω` different from `ω` (the point stabilised by
   `H`): for `h ∈ H` there is `l ∈ H ⊓ L` with `l • (g₀ • ω) = h • (g₀ • ω)` where `g₀ ∉ H`, so
   `h = l · (l⁻¹ h)` with `l⁻¹ h ∈ H ⊓ H^{g₀}`; thus `H ≤ (H ⊓ L) ⊔ (H ⊓ H^{g₀})`.
3. With `G = LH` (from the transitivity of `L` on `Ω`) this gives `G = L ⊔ (H ⊓ H^{g₀})`, and
   `H ⊓ H^{g₀}` has odd order since `g₀ ∉ H`; hence `[G : L]` is odd, and since `O^{2'}(G) = G`
   is the smallest normal subgroup of odd index, `L = G`.
4. Finally `G = ⟨Inv G⟩` together with `O(G) = 1` makes `G` simple.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open Submission.Blueprint
open LeanEval.GroupTheory.Defs

namespace Work.Reductions

/-- Every point of `Ω = G ⧸ H` is the unique fixed point of some involution of `G`: the
stabiliser of a point is a conjugate of `H`, hence has even order and contains an involution,
whose fixed point is unique (Peterfalvi I Ch. I §2). -/
theorem exists_involution_unique_fixed {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : IsStronglyEmbedded H) (ω : G ⧸ H) :
    ∃ t : G, orderOf t = 2 ∧ t • ω = ω ∧ ∀ ω' : G ⧸ H, t • ω' = ω' → ω' = ω := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective ω
  have hse : IsStronglyEmbedded (conj x H) := Work.ThreePoints.conj_stronglyEmbedded hH x
  have h2 : 2 ∣ Nat.card ↥(conj x H) := even_iff_two_dvd.mp hse.2.1
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' 2 (G := ↥(conj x H)) h2
  have hu2 : orderOf (u : G) = 2 := by rw [Subgroup.orderOf_coe]; exact hu
  have hfix : (u : G) • (QuotientGroup.mk x : G ⧸ H) = QuotientGroup.mk x := by
    have hmem : (u : G) ∈ MulAction.stabilizer G (QuotientGroup.mk x : G ⧸ H) := by
      rw [Work.ThreePoints.stabilizer_mk H x]
      exact u.2
    exact MulAction.mem_stabilizer_iff.mp hmem
  refine ⟨(u : G), hu2, hfix, ?_⟩
  intro ω' hω'
  obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective ω'
  have hy : (u : G) ∈ conj y H := by
    rw [← Work.ThreePoints.stabilizer_mk H y]
    exact MulAction.mem_stabilizer_iff.mpr hω'
  have heq : conj x H = conj y H := stronglyEmbedded_eq_of_mem_conj hH hu2 u.2 hy
  exact (Work.ThreePoints.mk_eq_of_conj_eq hH heq).symm

/-- A normal subgroup containing all involutions is transitive on `Ω = G ⧸ H`: any two points
are the unique fixed points of involutions, and those are conjugate inside `L`, because
`(H ⊓ L).subgroupOf L` is strongly embedded in `L` (Peterfalvi I Ch. I §1 (6) and §2 Prop. 1). -/
theorem isPretransitive_of_involutions_aux {G : Type} [Group G] [Finite G] {H L : Subgroup G}
    (hH : IsStronglyEmbedded H) (hL : L.Normal)
    (hinv : ∀ x : G, orderOf x = 2 → x ∈ L)
    (hproper : ¬ L ≤ H) (heven : Even (Nat.card ↥(H ⊓ L))) :
    ∀ ω : G ⧸ H, ∃ l : L, (l : G) • (QuotientGroup.mk (1 : G) : G ⧸ H) = ω := by
  classical
  intro ω
  have hHne : H ⊓ L ≠ L := fun hle => hproper (by rw [← hle]; exact inf_le_left)
  have hseL : IsStronglyEmbedded ((H ⊓ L).subgroupOf L) :=
    stronglyEmbedded_subgroupOf hH hHne heven
  have hconjL : ∀ u v : L, orderOf u = 2 → orderOf v = 2 → ∃ g : L, g * u * g⁻¹ = v :=
    fun u v hu hv => stronglyEmbedded_involutions_conj hseL hu hv
  obtain ⟨t, ht2, htfix, htuniq⟩ := exists_involution_unique_fixed hH ω
  obtain ⟨t₀, ht₀2, ht₀fix, ht₀uniq⟩ :=
    exists_involution_unique_fixed hH (QuotientGroup.mk (1 : G) : G ⧸ H)
  have htL : t ∈ L := hinv t ht2
  have ht₀L : t₀ ∈ L := hinv t₀ ht₀2
  obtain ⟨g, hg⟩ := hconjL ⟨t₀, ht₀L⟩ ⟨t, htL⟩
    (by rw [Subgroup.orderOf_mk]; exact ht₀2) (by rw [Subgroup.orderOf_mk]; exact ht2)
  have hgG : (g : G) * t₀ * (g : G)⁻¹ = t := congrArg Subtype.val hg
  have hfixg : (g : G) • (QuotientGroup.mk (1 : G) : G ⧸ H) = ω := by
    have h1 : t • ((g : G) • (QuotientGroup.mk (1 : G) : G ⧸ H)) =
        (g : G) • (QuotientGroup.mk (1 : G) : G ⧸ H) := by
      have h2 := congrArg (fun z => z • ((g : G) • (QuotientGroup.mk (1 : G) : G ⧸ H))) hgG
      simp only [mul_smul] at h2
      rw [← h2]
      simp [ht₀fix]
    exact htuniq _ h1
  exact ⟨g, hfixg⟩

/-- `⟨Inv G⟩`: the subgroup of `G` generated by the involutions of `G`. -/
def involutionsSubgroup (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | orderOf x = 2}

/-- Every involution lies in `⟨Inv G⟩`. -/
theorem mem_involutionsSubgroup {G : Type*} [Group G] {x : G} (hx : orderOf x = 2) :
    x ∈ involutionsSubgroup G :=
  Subgroup.subset_closure hx

/-- The set of involutions is invariant under conjugation, so `⟨Inv G⟩` is normal. -/
theorem involutionsSubgroup_normal (G : Type*) [Group G] : (involutionsSubgroup G).Normal := by
  rw [Subgroup.normal_iff_map_conj_eq]
  intro g
  unfold involutionsSubgroup
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    show orderOf (MulAut.conj g y) = 2
    rw [MulEquiv.orderOf_eq, hy]
  · intro hx
    refine ⟨(MulAut.conj g⁻¹) x, ?_, ?_⟩
    · show orderOf ((MulAut.conj g⁻¹) x) = 2
      rw [MulEquiv.orderOf_eq, hx]
    · show MulAut.conj g (MulAut.conj g⁻¹ x) = x
      rw [MulAut.conj_apply, MulAut.conj_apply]
      group

/-- `⟨Inv G⟩` is contained in every normal subgroup containing all involutions of `G`. -/
theorem involutionsSubgroup_le {G : Type*} [Group G] {N : Subgroup G} (hN : N.Normal)
    (h : ∀ x : G, orderOf x = 2 → x ∈ N) : involutionsSubgroup G ≤ N := by
  intro x hx
  refine Subgroup.closure_induction (p := fun y _ => y ∈ N) (fun y hy => h y hy) N.one_mem
    (fun y z _ _ hy hz => N.mul_mem hy hz) (fun y _ hy => N.inv_mem hy) hx

/-- A strongly embedded subgroup has even order, hence contains an involution. -/
theorem exists_involution_mem {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : IsStronglyEmbedded H) : ∃ u : G, u ∈ H ∧ orderOf u = 2 := by
  have h2 : 2 ∣ Nat.card ↥H := even_iff_two_dvd.mp hH.2.1
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' 2 (G := ↥H) h2
  exact ⟨(u : G), u.2, by rw [Subgroup.orderOf_coe]; exact hu⟩

/-- The stabiliser of the base point of `Ω = G ⧸ H` is `H`. -/
theorem stabilizer_base {G : Type} [Group G] (H : Subgroup G) :
    MulAction.stabilizer G (QuotientGroup.mk (1 : G) : G ⧸ H) = H := by
  rw [Work.ThreePoints.stabilizer_mk H 1]
  ext x
  constructor
  · intro hx
    simpa using (Work.ThreePoints.mem_conj_iff (g := (1 : G)) (x := x) (H := H)).mp hx
  · intro hx
    exact (Work.ThreePoints.mem_conj_iff (g := (1 : G)) (x := x) (H := H)).mpr (by simpa using hx)

/-- An element of `G` fixing the base point of `Ω = G ⧸ H` lies in `H`. -/
theorem mem_of_smul_base_eq {G : Type} [Group G] {H : Subgroup G} {x : G}
    (hx : x • (QuotientGroup.mk (1 : G) : G ⧸ H) = QuotientGroup.mk (1 : G)) : x ∈ H := by
  rw [← stabilizer_base H, MulAction.mem_stabilizer_iff]
  exact hx

/-- An involution outside `H`: for `g ∉ H` the conjugate `H^g` has even order, so contains an
involution, and such an involution cannot lie in `H` because `H ⊓ H^g` has odd order. -/
theorem exists_involution_not_mem {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : IsStronglyEmbedded H) : ∃ t : G, orderOf t = 2 ∧ t ∉ H := by
  obtain ⟨g, hg⟩ : ∃ g : G, g ∉ H := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hH.1 (le_antisymm le_top (fun x _ => h x))
  have hse : IsStronglyEmbedded (conj g H) := Work.ThreePoints.conj_stronglyEmbedded hH g
  have h2 : 2 ∣ Nat.card ↥(conj g H) := even_iff_two_dvd.mp hse.2.1
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' 2 (G := ↥(conj g H)) h2
  have hu2 : orderOf (u : G) = 2 := by rw [Subgroup.orderOf_coe]; exact hu
  refine ⟨(u : G), hu2, ?_⟩
  intro hmem
  have hmem2 : (u : G) ∈ H ⊓ conj g H := ⟨hmem, u.2⟩
  have hdvd : 2 ∣ Nat.card ↥(H ⊓ conj g H) := by
    have hle : Subgroup.zpowers (u : G) ≤ H ⊓ conj g H := Subgroup.zpowers_le.mpr hmem2
    have h := Subgroup.card_dvd_of_le hle
    rwa [Nat.card_zpowers, hu2] at h
  exact (Nat.not_even_iff_odd.mpr (hH.2.2 g hg)) (even_iff_two_dvd.mpr hdvd)

theorem isSimpleGroup_of_oddCore_eq_bot {G : Type} [Group G] [Finite G]
    (hA : Submission.Blueprint.ThmAProp) (hfour : Submission.Blueprint.HasFourGroup G)
    {H : Subgroup G} (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H)
    (hc : Submission.Blueprint.oddCore G = ⊥) (hr : Submission.Blueprint.oddResidual G = ⊤) :
    IsSimpleGroup G := by
  classical
  set L : Subgroup G := involutionsSubgroup G with hLdef
  have hinv : ∀ x : G, orderOf x = 2 → x ∈ L := fun x hx => mem_involutionsSubgroup hx
  have hLnorm : L.Normal := involutionsSubgroup_normal G
  obtain ⟨u₀, hu₀H, hu₀2⟩ := exists_involution_mem hH
  -- ## Step 1: `L ⊄ H`, and `H ⊓ L` has even order
  have hproper : ¬ L ≤ H := by
    intro hLH
    obtain ⟨g, hg⟩ : ∃ g : G, g ∉ H := by
      by_contra h
      simp only [not_exists, not_not] at h
      exact hH.1 (le_antisymm le_top (fun x _ => h x))
    have hmem : u₀ ∈ H ⊓ conj g H := by
      refine ⟨hu₀H, ?_⟩
      exact Subgroup.mem_map.mpr ⟨g⁻¹ * u₀ * g,
        hLH (by simpa using hLnorm.conj_mem u₀ (hinv u₀ hu₀2) g⁻¹),
        by simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]; group⟩
    have hdvd : 2 ∣ Nat.card ↥(H ⊓ conj g H) := by
      have hle : Subgroup.zpowers u₀ ≤ H ⊓ conj g H := Subgroup.zpowers_le.mpr hmem
      have h := Subgroup.card_dvd_of_le hle
      rwa [Nat.card_zpowers, hu₀2] at h
    exact (Nat.not_even_iff_odd.mpr (hH.2.2 g hg)) (even_iff_two_dvd.mpr hdvd)
  have heven : Even (Nat.card ↥(H ⊓ L)) := by
    have hle : Subgroup.zpowers u₀ ≤ H ⊓ L :=
      Subgroup.zpowers_le.mpr ⟨hu₀H, hinv u₀ hu₀2⟩
    have h := Subgroup.card_dvd_of_le hle
    rw [Nat.card_zpowers, hu₀2] at h
    exact even_iff_two_dvd.mpr h
  have hHne : H ⊓ L ≠ L := fun hle => hproper (by rw [← hle]; exact inf_le_left)
  -- ## Step 2: `L` is transitive and doubly transitive on `Ω = G ⧸ H`
  have hseL : IsStronglyEmbedded ((H ⊓ L).subgroupOf L) :=
    stronglyEmbedded_subgroupOf hH hHne heven
  have hfourL : HasFourGroup ↥L := by
    obtain ⟨a, b, ha2, hb2, hab, hcomm⟩ := hfour
    exact ⟨⟨a, hinv a ha2⟩, ⟨b, hinv b hb2⟩, by rw [Subgroup.orderOf_mk]; exact ha2,
      by rw [Subgroup.orderOf_mk]; exact hb2, fun hh => hab (Subtype.ext_iff.mp hh),
      Subtype.ext (by simpa using hcomm)⟩
  have h2L : MulAction.IsMultiplyPretransitive ↥L (↥L ⧸ (L ⊓ H).subgroupOf L) 2 := by
    have h := hA ↥L hfourL ((H ⊓ L).subgroupOf L) hseL
    have hsub : (H ⊓ L).subgroupOf L = (L ⊓ H).subgroupOf L := by rw [inf_comm]
    rwa [hsub] at h
  have htrans : ∀ ω : G ⧸ H, ∃ l : L, (l : G) • (QuotientGroup.mk (1 : G) : G ⧸ H) = ω :=
    isPretransitive_of_involutions_aux hH hLnorm hinv hproper heven
  have h2Ω : ∀ a b c d : G ⧸ H, a ≠ b → c ≠ d →
      ∃ l : L, (l : G) • a = c ∧ (l : G) • b = d :=
    fun a b c d hab hcd => transfer_twoTransitive h2L htrans a b c d hab hcd
  -- ## Step 3: `G = L·H`
  have hGH : L ⊔ H = ⊤ := by
    rw [eq_top_iff]
    intro g _
    obtain ⟨l, hl⟩ := htrans ((g : G) • (QuotientGroup.mk (1 : G) : G ⧸ H))
    have hfix : ((l : G)⁻¹ * g) • (QuotientGroup.mk (1 : G) : G ⧸ H) =
        QuotientGroup.mk (1 : G) := by
      have h2 := congrArg (fun x => (l : G)⁻¹ • x) hl
      simpa [mul_smul] using h2.symm
    have hmem : ((l : G)⁻¹ * g) ∈ H := mem_of_smul_base_eq hfix
    have hmem' : (l : G) * ((l : G)⁻¹ * g) ∈ L ⊔ H := Subgroup.mul_mem_sup l.2 hmem
    rwa [mul_inv_cancel_left] at hmem'
  -- ## Step 4: `H ≤ (H ⊓ L) ⊔ (H ⊓ H^{g₀})` for an involution `t ∉ H` with `H^t ≠ H`
  obtain ⟨t, ht2, htH⟩ := exists_involution_not_mem hH
  obtain ⟨g₀, hg₀⟩ := stronglyEmbedded_exists_conj_mem hH ht2
  have hg₀H : g₀ ∉ H := by
    intro hmem
    exact htH (by rwa [Work.ThreePoints.conj_eq_self_of_mem hmem] at hg₀)
  have hg₀ne : (QuotientGroup.mk g₀ : G ⧸ H) ≠ QuotientGroup.mk (1 : G) := by
    intro hcon
    exact hg₀H (by simpa using (QuotientGroup.eq.mp hcon : g₀⁻¹ * 1 ∈ H))
  have hHD : H ≤ (H ⊓ L) ⊔ (H ⊓ conj g₀ H) := by
    intro h hhH
    have hne : (h • (QuotientGroup.mk g₀ : G ⧸ H)) ≠ QuotientGroup.mk (1 : G) := by
      intro hcon
      have h1 : h⁻¹ • (h • (QuotientGroup.mk g₀ : G ⧸ H)) =
          h⁻¹ • (QuotientGroup.mk (1 : G) : G ⧸ H) := by rw [hcon]
      rw [← mul_smul, inv_mul_cancel, one_smul] at h1
      have h2 : h⁻¹ • (QuotientGroup.mk (1 : G) : G ⧸ H) = QuotientGroup.mk (1 : G) :=
        MulAction.mem_stabilizer_iff.mp (by
          rw [stabilizer_base H]; exact H.inv_mem hhH)
      exact hg₀ne (h1.trans h2)
    obtain ⟨l, hl1, hl2⟩ := h2Ω (QuotientGroup.mk (1 : G)) (QuotientGroup.mk g₀)
      (QuotientGroup.mk (1 : G)) (h • (QuotientGroup.mk g₀ : G ⧸ H)) hg₀ne.symm hne.symm
    have hlH : (l : G) ∈ H := mem_of_smul_base_eq hl1
    have hfix : ((l : G)⁻¹ * h) • (QuotientGroup.mk g₀ : G ⧸ H) =
        QuotientGroup.mk g₀ := by
      have h2 : (l : G)⁻¹ • ((l : G) • (QuotientGroup.mk g₀ : G ⧸ H)) =
          (l : G)⁻¹ • (h • (QuotientGroup.mk g₀ : G ⧸ H)) := by rw [hl2]
      simpa [mul_smul] using h2.symm
    have hmem2 : ((l : G)⁻¹ * h) ∈ H ⊓ conj g₀ H := by
      refine ⟨H.mul_mem (H.inv_mem hlH) hhH, ?_⟩
      rw [← Work.ThreePoints.stabilizer_mk H g₀]
      exact MulAction.mem_stabilizer_iff.mpr hfix
    have hprod : (l : G) * ((l : G)⁻¹ * h) = h := mul_inv_cancel_left (l : G) h
    rw [← hprod]
    exact Subgroup.mul_mem_sup ⟨hlH, l.2⟩ hmem2
  -- ## Step 5: `G = L ⊔ (H ⊓ H^{g₀})`
  have hGD : L ⊔ (H ⊓ conj g₀ H) = ⊤ := by
    have hHle : H ≤ L ⊔ (H ⊓ conj g₀ H) :=
      le_trans hHD (sup_le (le_trans inf_le_right le_sup_left) le_sup_right)
    have htop : (⊤ : Subgroup G) ≤ L ⊔ (H ⊓ conj g₀ H) := by
      rw [← hGH]
      exact sup_le le_sup_left hHle
    exact top_le_iff.mp htop
  -- ## Step 6: `[G : L]` is odd, hence `L = G`
  have hLodd : Odd L.index := odd_index_of_sup_eq_top hLnorm hGD (hH.2.2 g₀ hg₀H)
  have hLtop : L = ⊤ := by
    have h1 : Submission.Blueprint.oddResidual G ≤ L :=
      oddResidual_basic.2.2.1 L hLnorm hLodd
    rw [hr] at h1
    exact top_le_iff.mp h1
  -- ## Step 7: `G` is simple
  haveI : Nontrivial G := by
    obtain ⟨a, b, -, -, hab, -⟩ := hfour
    exact ⟨⟨a, b, hab⟩⟩
  refine IsSimpleGroup.mk (fun N hN => ?_)
  by_cases hoddN : Odd (Nat.card N)
  · left
    have h1 : N ≤ Submission.Blueprint.oddCore G :=
      Work.BrauerSuzuki.OddCore.le_of_normal_odd hN hoddN
    rw [hc] at h1
    exact le_bot_iff.mp h1
  · right
    have h2div : 2 ∣ Nat.card N := by
      rcases Nat.even_or_odd (Nat.card N) with h | h
      · exact even_iff_two_dvd.mp h
      · exact absurd h hoddN
    obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' 2 (G := N) h2div
    have hu2 : orderOf (u : G) = 2 := by rw [Subgroup.orderOf_coe]; exact hu
    have hLN : L ≤ N := by
      rw [hLdef]
      refine involutionsSubgroup_le hN (fun v hv => ?_)
      obtain ⟨g, hg⟩ := stronglyEmbedded_involutions_conj hH hu2 hv
      rw [← hg]
      exact hN.conj_mem (u : G) u.2 g
    exact top_le_iff.mp (hLtop ▸ hLN)

end Work.Reductions
