namespace Commons.GroupTheory.Commutator

theorem commutator_eq_top_of_sup_zpowers_eq_top_of_odd_index {G : Type*} [Group G] [Finite G]
    (H : Subgroup G) (w : G) (hw : w ^ 2 = 1) (htop : H ⊔ Subgroup.zpowers w = ⊤)
    (hH : H ≤ commutator G) (hodd : Odd H.index) : commutator G = ⊤ := by
  -- `G` is generated by the commutator subgroup together with `w`.
  have hW : commutator G ⊔ Subgroup.zpowers w = ⊤ := by
    have : (⊤ : Subgroup G) ≤ commutator G ⊔ Subgroup.zpowers w := by
      rw [← htop]
      exact sup_le (hH.trans le_sup_left) le_sup_right
    exact top_le_iff.mp this
  -- The index of the commutator subgroup equals the relative index in `⟨w⟩`.
  have h1 : (commutator G).index = (commutator G).relIndex (Subgroup.zpowers w) := by
    rw [← Subgroup.relIndex_top_right (commutator G), ← hW,
      Subgroup.relIndex_sup_left (Subgroup.zpowers w) (commutator G)]
  -- `⟨w⟩` has at most two elements, since `w ^ 2 = 1`.
  have hdvd : Nat.card ↥(Subgroup.zpowers w) ∣ 2 := by
    rw [Nat.card_zpowers]
    exact orderOf_dvd_iff_pow_eq_one.mpr hw
  -- Hence the index of the commutator subgroup is at most two.
  have hle2 : (commutator G).index ≤ 2 := by
    rw [h1]
    exact Nat.le_of_dvd (by norm_num)
      (dvd_trans (Subgroup.relIndex_dvd_card (commutator G) (Subgroup.zpowers w)) hdvd)
  -- And it is odd, since it divides the odd index of `H`.
  have hoddK : Odd (commutator G).index :=
    Odd.of_dvd_nat hodd (Subgroup.index_dvd_of_le hH)
  have hone : (commutator G).index = 1 := by
    rcases hoddK with ⟨m, hm⟩
    omega
  exact Subgroup.index_eq_one.mp hone

end Commons.GroupTheory.Commutator