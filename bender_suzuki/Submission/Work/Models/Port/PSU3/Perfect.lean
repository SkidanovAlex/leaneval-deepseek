/-! ## The opposite unipotent radical -/

/-- The opposite unipotent radical `U⁻ = w U w`. -/
noncomputable def suUinv (n : ℕ) : Subgroup (GL (Fin 3) (F n)) :=
  (suU n).map (MulAut.conj (suSg n)).toMonoidHom

lemma suUinvg_eq_conj (n : ℕ) (b c : F n) :
    suUinvg n b c = MulAut.conj (suSg n) (suUg n b c) := by
  rw [suUinvg, MulAut.conj_apply, suSg_inv]

lemma suUinvg_mem_suUinv (n : ℕ) (b c : F n)
    (hc : c + c ^ (2 ^ n) = b ^ (2 ^ n + 1)) : suUinvg n b c ∈ suUinv n :=
  Subgroup.mem_map.mpr ⟨suUg n b c, ⟨b, c, hc, rfl⟩, (suUinvg_eq_conj n b c).symm⟩

lemma suUinv_le_SU3 (n : ℕ) : suUinv n ≤ SU3 n := by
  rintro A ⟨B, hB, rfl⟩
  exact (SU3 n).mul_mem ((SU3 n).mul_mem (suSg_mem_SU3 n) (suU_le_SU3 n hB))
    ((SU3 n).inv_mem (suSg_mem_SU3 n))

/-! ## The Weyl element as a word in `U ∪ U⁻` -/

lemma su_cond_zero_one (n : ℕ) :
    (1 : F n) + 1 ^ (2 ^ n) = (0 : F n) ^ (2 ^ n + 1) := by
  rw [one_pow, CharTwo.add_self_eq_zero, zero_pow (by positivity)]

/-- `w = u(0,1) · v(0,1) · u(0,1)`, the `SL(2,2)` relation. -/
theorem suSg_eq_suUg_mul (n : ℕ) :
    suSg n = suUg n 0 1 * suUinvg n 0 1 * suUg n 0 1 := by
  rw [suUinvg]
  apply Units.ext
  simp only [Matrix.GeneralLinearGroup.coe_mul, suSg_coe, suUg_coe, suUmat, J3]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, CharTwo.add_self_eq_zero]

/-! ## The commutator of a torus element with a unipotent element -/

lemma suTg_inv (n : ℕ) (a : (F n)ˣ) : suTg n a⁻¹ = (suTg n a)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, suTg_mul, inv_mul_cancel, suTg_one]

lemma suTg_conj_suUg' (n : ℕ) (a : (F n)ˣ) (b c : F n) :
    (suTg n a)⁻¹ * suUg n b c * suTg n a =
      suUg n ((a : F n)⁻¹ * b * (a : F n) ^ (2 ^ n - 1))
            ((a : F n)⁻¹ * c * ((a : F n) ^ (2 ^ n))⁻¹) := by
  have h := suTg_conj_suUg n a⁻¹ b c
  rw [suTg_inv] at h
  simpa [inv_inv] using h

/-- **The commutator `[t(a), u(b,c)]` of a torus element with a unipotent element.** -/
theorem suTg_commutator_suUg (n : ℕ) (a : (F n)ˣ) (b c : F n) :
    suTg n a * suUg n b c * (suTg n a)⁻¹ * (suUg n b c)⁻¹ =
      suUg n (b * ((a : F n) * ((a : F n) ^ (2 ^ n - 1))⁻¹ + 1))
        (c * ((a : F n) ^ (2 ^ n + 1) + 1) +
          b ^ (2 ^ n + 1) * (1 + (a : F n) * ((a : F n) ^ (2 ^ n - 1))⁻¹)) := by
  rw [suTg_conj_suUg, ← suUg_inv, suUg_mul]
  congr 1
  · ring
  · have h1 : (a : F n) ^ (2 ^ n + 1) = (a : F n) * (a : F n) ^ (2 ^ n) := pow_succ' _ _
    have h2 : b ^ (2 ^ n + 1) = b * b ^ (2 ^ n) := pow_succ' _ _
    rw [h1, h2]
    ring

/-! ## `U` consists of commutators with the torus -/

lemma suUg_inj (n : ℕ) {b c b' c' : F n} (h : suUg n b c = suUg n b' c') :
    b = b' ∧ c = c' := by
  have h' : (fun p : F n × F n => suUg n p.1 p.2) (b, c) =
      (fun p : F n × F n => suUg n p.1 p.2) (b', c') := h
  exact Prod.ext_iff.mp (suUg_injective n h')

lemma suU_conj_mem (n : ℕ) (a : (F n)ˣ) {v : GL (Fin 3) (F n)} (hv : v ∈ suU n) :
    suTg n a * v * (suTg n a)⁻¹ ∈ suU n := by
  obtain ⟨b, c, hc, rfl⟩ := hv
  rw [suTg_conj_suUg]
  exact ⟨_, _, suU_cond_conj n a b c hc, rfl⟩

/-- The map `v ↦ [t(a), v]` on the unipotent radical. -/
noncomputable def suUConjMap (n : ℕ) (a : (F n)ˣ) (v : ↥(suU n)) : ↥(suU n) :=
  ⟨suTg n a * (v : GL (Fin 3) (F n)) * (suTg n a)⁻¹ * (v : GL (Fin 3) (F n))⁻¹,
    (suU n).mul_mem (suU_conj_mem n a v.2) ((suU n).inv_mem v.2)⟩

lemma suUConjMap_coe (n : ℕ) (a : (F n)ˣ) (v : ↥(suU n)) :
    (suUConjMap n a v : GL (Fin 3) (F n)) =
      suTg n a * (v : GL (Fin 3) (F n)) * (suTg n a)⁻¹ * (v : GL (Fin 3) (F n))⁻¹ :=
  rfl

lemma suUConjMap_injective (n : ℕ) (a : (F n)ˣ)
    (hB : (a : F n) * ((a : F n) ^ (2 ^ n - 1))⁻¹ + 1 ≠ 0)
    (hC : (a : F n) ^ (2 ^ n + 1) + 1 ≠ 0) :
    Function.Injective (suUConjMap n a) := by
  intro v v' h
  obtain ⟨b, c, hc, hv⟩ := v.2
  obtain ⟨b', c', hc', hv'⟩ := v'.2
  have hgl : suTg n a * suUg n b c * (suTg n a)⁻¹ * (suUg n b c)⁻¹ =
      suTg n a * suUg n b' c' * (suTg n a)⁻¹ * (suUg n b' c')⁻¹ := by
    have h1 := congrArg Subtype.val h
    rw [suUConjMap_coe, suUConjMap_coe, hv, hv'] at h1
    exact h1
  rw [suTg_commutator_suUg, suTg_commutator_suUg] at hgl
  have h2 := suUg_inj n hgl
  have hb : b = b' := mul_right_cancel₀ hB h2.1
  have hc' : c = c' := by
    rw [hb] at h2
    have : c * ((a : F n) ^ (2 ^ n + 1) + 1) = c' * ((a : F n) ^ (2 ^ n + 1) + 1) :=
      add_right_cancel h2.2
    exact mul_right_cancel₀ hC this
  apply Subtype.ext
  rw [hv, hv', hb, hc']

lemma suU_conj_surjective (n : ℕ) (a : (F n)ˣ)
    (hB : (a : F n) * ((a : F n) ^ (2 ^ n - 1))⁻¹ + 1 ≠ 0)
    (hC : (a : F n) ^ (2 ^ n + 1) + 1 ≠ 0) :
    Function.Surjective (suUConjMap n a) :=
  Finite.surjective_of_injective (suUConjMap_injective n a hB hC)

/-- **Every element of `U` is a commutator** `[t,v]` with `t` a torus element and `v ∈ U`. -/
theorem suU_le_commutator (n : ℕ) (hn : 2 ≤ n) :
    (suU n).subgroupOf (SU3 n) ≤ commutator ↥(SU3 n) := by
  obtain ⟨a₀, ha₀⟩ := IsCyclic.exists_generator (α := (F n)ˣ)
  have horder : orderOf a₀ = 2 ^ (2 * n) - 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers ha₀, Nat.card_units,
      GaloisField.card 2 (2 * n) (by omega)]
  have hpn : 4 ≤ 2 ^ n := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hple : 2 ^ n ≤ 2 ^ (2 * n) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hltp : 2 ^ n < 2 ^ (2 * n) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  have hpos1 : 0 < 2 ^ n - 2 := by omega
  have hpos2 : 0 < 2 ^ n + 1 := by omega
  have hlt1 : 2 ^ n - 2 < 2 ^ (2 * n) - 1 := by
    have h1 : 2 ^ n - 2 < 2 ^ n := by omega
    exact lt_of_lt_of_le h1 (Nat.le_sub_one_of_lt hltp)
  have hlt2 : 2 ^ n + 1 < 2 ^ (2 * n) - 1 := by
    have h5 : 2 ^ n + 2 < 2 ^ (2 * n) := by
      have h4 : 2 ^ (2 * n) = 2 ^ n * 2 ^ n := by rw [← pow_add]; ring_nf
      rw [h4]; nlinarith [hpn]
    calc 2 ^ n + 1 < 2 ^ n + 2 := by omega
      _ ≤ 2 ^ (2 * n) - 1 := Nat.le_sub_one_of_lt h5
  have hB : (a₀ : F n) * ((a₀ : F n) ^ (2 ^ n - 1))⁻¹ + 1 ≠ 0 := by
    intro h
    have hx : (a₀ : F n) * ((a₀ : F n) ^ (2 ^ n - 1))⁻¹ = 1 := by
      have h' := add_eq_zero_iff_eq_neg.mp h
      simpa [CharTwo.neg_eq] using h'
    have hpow : (a₀ : F n) ^ (2 ^ n - 2) = 1 := by
      have hne : (a₀ : F n) ^ (2 ^ n - 1) ≠ 0 := pow_ne_zero _ (Units.ne_zero a₀)
      have haeq : (a₀ : F n) = (a₀ : F n) ^ (2 ^ n - 1) := by
        have h := congrArg (· * (a₀ : F n) ^ (2 ^ n - 1)) hx
        simpa [mul_assoc, inv_mul_cancel₀ hne] using h
      have h2 : (a₀ : F n) ^ (2 ^ n - 1) = (a₀ : F n) ^ (2 ^ n - 2) * (a₀ : F n) := by
        rw [show 2 ^ n - 1 = (2 ^ n - 2) + 1 by omega, pow_succ]
      rw [h2] at haeq
      exact mul_right_cancel₀ (Units.ne_zero a₀) (haeq.symm.trans (one_mul _).symm)
    have hdvd : orderOf a₀ ∣ 2 ^ n - 2 :=
      orderOf_dvd_iff_pow_eq_one.mpr (Units.ext hpow)
    rw [horder] at hdvd
    exact Nat.not_dvd_of_pos_of_lt hpos1 hlt1 hdvd
  have hC : (a₀ : F n) ^ (2 ^ n + 1) + 1 ≠ 0 := by
    intro h
    have hx : (a₀ : F n) ^ (2 ^ n + 1) = 1 := by
      have h' := add_eq_zero_iff_eq_neg.mp h
      simpa [CharTwo.neg_eq] using h'
    have hdvd : orderOf a₀ ∣ 2 ^ n + 1 :=
      orderOf_dvd_iff_pow_eq_one.mpr (Units.ext hx)
    rw [horder] at hdvd
    exact Nat.not_dvd_of_pos_of_lt hpos2 hlt2 hdvd
  intro x hx
  have hxU : (x : GL (Fin 3) (F n)) ∈ suU n := hx
  obtain ⟨v, hv⟩ := suU_conj_surjective n a₀ hB hC
    (⟨(x : GL (Fin 3) (F n)), hxU⟩ : ↥(suU n))
  have hval : suTg n a₀ * (v : GL (Fin 3) (F n)) * (suTg n a₀)⁻¹ *
      (v : GL (Fin 3) (F n))⁻¹ = (x : GL (Fin 3) (F n)) := by
    have h1 := congrArg Subtype.val hv
    rwa [suUConjMap_coe] at h1
  have hcomm : ⁅(⟨suTg n a₀, suTg_isSU3 n a₀⟩ : ↥(SU3 n)),
      (⟨(v : GL (Fin 3) (F n)), suU_le_SU3 n v.2⟩ : ↥(SU3 n))⁆ = x := by
    apply Subtype.ext
    simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv]
    exact hval
  rw [← hcomm]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)


/-! ## The torus element as a word in `U ∪ U⁻` -/

/-- **The torus element `t(a)` as a word in the unipotent radicals.**  If `b^(q+1) = a + a^q`
then `t(a) = u(b,a) · v(b/a, a^(-q)) · u(b a^(q-1), a) · w`. -/
theorem suTg_eq_word (n : ℕ) (a : (F n)ˣ) (b : F n)
    (hb : b ^ (2 ^ n + 1) = (a : F n) + (a : F n) ^ (2 ^ n)) :
    suTg n a =
      suUg n b (a : F n) * suUinvg n (b * ((a : F n))⁻¹) (((a : F n) ^ (2 ^ n))⁻¹) *
        suUg n (b * (a : F n) ^ (2 ^ n - 1)) (a : F n) * suSg n := by
  have ha0 : (a : F n) ≠ 0 := Units.ne_zero a
  have hsq : ((a : F n) ^ (2 ^ n)) ^ (2 ^ n) = (a : F n) := by
    rw [← pow_mul, show 2 ^ n * 2 ^ n = 2 ^ (2 * n) by ring, pow_card_sq]
  have haq1 : (a : F n) ^ (2 ^ n - 1) = (a : F n) ^ (2 ^ n) * (a : F n)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ ha0]
    rw [← pow_succ, Nat.sub_add_cancel Nat.one_le_two_pow]
  have haq1q : ((a : F n) ^ (2 ^ n - 1)) ^ (2 ^ n) = (a : F n) * ((a : F n) ^ (2 ^ n))⁻¹ := by
    rw [haq1, mul_pow, hsq, inv_pow]
  have hinv : (b * ((a : F n))⁻¹) ^ (2 ^ n) = b ^ (2 ^ n) * ((a : F n) ^ (2 ^ n))⁻¹ := by
    rw [mul_pow, inv_pow]
  have hbpow : (b * (a : F n) ^ (2 ^ n - 1)) ^ (2 ^ n) =
      b ^ (2 ^ n) * ((a : F n) * ((a : F n) ^ (2 ^ n))⁻¹) := by
    rw [mul_pow, haq1q]
  have hb2 : b * b ^ (2 ^ n) = (a : F n) + (a : F n) ^ (2 ^ n) := by
    rw [← pow_succ']
    exact hb
  have hbq' : ∀ X : F n, b ^ (2 ^ n) * (b * X) = ((a : F n) + (a : F n) ^ (2 ^ n)) * X :=
    fun X => by rw [← mul_assoc, mul_comm (b ^ (2 ^ n)) b, hb2]
  apply Units.ext
  simp only [Matrix.GeneralLinearGroup.coe_mul, suTg_coe, suUg_coe, suUinvg_coe, suSg_coe,
    suUmat, suTmat, J3]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_three]
  all_goals first
    | (rw [hinv, hbpow]; field_simp; ring_nf; grind)
    | (rw [hinv]; field_simp; ring_nf; grind)
    | (rw [hbpow]; field_simp; ring_nf; grind)
    | (rw [hinv, hbpow, hbq']; field_simp; ring_nf; grind)
    | (field_simp; ring_nf; grind)

lemma suU_cond_div_inv (n : ℕ) (hn : 1 ≤ n) (a : (F n)ˣ) (b : F n)
    (hb : b ^ (2 ^ n + 1) = (a : F n) + (a : F n) ^ (2 ^ n)) :
    ((a : F n) ^ (2 ^ n))⁻¹ + (((a : F n) ^ (2 ^ n))⁻¹) ^ (2 ^ n)
      = (b * (a : F n)⁻¹) ^ (2 ^ n + 1) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have ha0 : (a : F n) ≠ 0 := Units.ne_zero a
  have hsq0 : ((a : F n) ^ (2 ^ n)) ^ (2 ^ n) = (a : F n) := by
    rw [← pow_mul, show 2 ^ n * 2 ^ n = 2 ^ (2 * n) by ring, pow_card_sq]
  have hb2 : b * b ^ (2 ^ n) = (a : F n) + (a : F n) ^ (2 ^ n) := by
    rw [← pow_succ']; exact hb
  rw [inv_pow, hsq0, pow_succ', mul_pow, inv_pow]
  field_simp
  ring_nf
  grind

lemma suU_cond_mul_pow (n : ℕ) (hn : 1 ≤ n) (a : (F n)ˣ) (b : F n)
    (hb : b ^ (2 ^ n + 1) = (a : F n) + (a : F n) ^ (2 ^ n)) :
    (a : F n) + (a : F n) ^ (2 ^ n)
      = (b * (a : F n) ^ (2 ^ n - 1)) ^ (2 ^ n + 1) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have ha0 : (a : F n) ≠ 0 := Units.ne_zero a
  have hsq0 : ((a : F n) ^ (2 ^ n)) ^ (2 ^ n) = (a : F n) := by
    rw [← pow_mul, show 2 ^ n * 2 ^ n = 2 ^ (2 * n) by ring, pow_card_sq]
  have haq1 : (a : F n) ^ (2 ^ n - 1) = (a : F n) ^ (2 ^ n) * (a : F n)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ ha0]
    rw [← pow_succ, Nat.sub_add_cancel Nat.one_le_two_pow]
  have hb2 : b * b ^ (2 ^ n) = (a : F n) + (a : F n) ^ (2 ^ n) := by
    rw [← pow_succ']; exact hb
  have haq1q : ((a : F n) ^ (2 ^ n - 1)) ^ (2 ^ n) = (a : F n) * ((a : F n) ^ (2 ^ n))⁻¹ := by
    rw [haq1, mul_pow, hsq0, inv_pow]
  rw [pow_succ', mul_pow, haq1q]
  field_simp
  ring_nf
  rw [show 2 ^ n * 2 = 2 ^ n + 2 ^ n by ring, pow_add]
  grind

/-- The opposite unipotent radical also consists of commutators. -/
theorem suUinv_le_commutator (n : ℕ) (hn : 2 ≤ n) :
    (suUinv n).subgroupOf (SU3 n) ≤ commutator ↥(SU3 n) := by
  intro x hx
  obtain ⟨u, hu, hux⟩ := Subgroup.mem_map.mp hx
  have huC : (⟨u, suU_le_SU3 n hu⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suU_le_commutator n hn (Subgroup.mem_subgroupOf.mpr hu)
  have hx' : x = ⁅(⟨suSg n, suSg_isSU3 n⟩ : ↥(SU3 n)),
      (⟨u, suU_le_SU3 n hu⟩ : ↥(SU3 n))⁆ * (⟨u, suU_le_SU3 n hu⟩ : ↥(SU3 n)) := by
    apply Subtype.ext
    simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv]
    have h1 : MulAut.conj (suSg n) u = (x : GL (Fin 3) (F n)) := hux
    rw [← h1, MulAut.conj_apply, suSg_inv]
    group
  rw [hx']
  exact (commutator ↥(SU3 n)).mul_mem
    (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)) huC

/-- `suTg n` as a monoid homomorphism. -/
noncomputable def suThom (n : ℕ) : (F n)ˣ →* GL (Fin 3) (F n) where
  toFun := suTg n
  map_one' := suTg_one n
  map_mul' := fun a b => (suTg_mul n a b).symm

lemma suSg_mem_commutator (n : ℕ) (hn : 2 ≤ n) :
    (⟨suSg n, suSg_isSU3 n⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) := by
  have h01 : (1 : F n) + 1 ^ (2 ^ n) = (0 : F n) ^ (2 ^ n + 1) := su_cond_zero_one n
  have hA : (⟨suUg n 0 1, suUg_isSU3 n 0 1 h01⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suU_le_commutator n hn (Subgroup.mem_subgroupOf.mpr ⟨0, 1, h01, rfl⟩)
  have hB : (⟨suUinvg n 0 1, suUinv_le_SU3 n (suUinvg_mem_suUinv n 0 1 h01)⟩ : ↥(SU3 n))
      ∈ commutator ↥(SU3 n) :=
    suUinv_le_commutator n hn
      (Subgroup.mem_subgroupOf.mpr (suUinvg_mem_suUinv n 0 1 h01))
  have heq : (⟨suSg n, suSg_isSU3 n⟩ : ↥(SU3 n)) =
      (⟨suUg n 0 1, suUg_isSU3 n 0 1 h01⟩ : ↥(SU3 n)) *
        ⟨suUinvg n 0 1, suUinv_le_SU3 n (suUinvg_mem_suUinv n 0 1 h01)⟩ *
        ⟨suUg n 0 1, suUg_isSU3 n 0 1 h01⟩ := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    exact suSg_eq_suUg_mul n
  rw [heq]
  exact (commutator ↥(SU3 n)).mul_mem
    ((commutator ↥(SU3 n)).mul_mem hA hB) hA

/-- Every torus element is a commutator. -/
theorem suT_le_commutator (n : ℕ) (hn : 2 ≤ n) :
    (suT n).subgroupOf (SU3 n) ≤ commutator ↥(SU3 n) := by
  have hn1 : 1 ≤ n := by omega
  obtain ⟨a₀, ha₀⟩ := IsCyclic.exists_generator (α := (F n)ˣ)
  have hcard : Nat.card (F n)ˣ = 2 ^ (2 * n) - 1 := by
    rw [Nat.card_units, GaloisField.card 2 (2 * n) (by omega)]
  have horder : orderOf a₀ = 2 ^ (2 * n) - 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers ha₀, hcard]
  have hsq0 : ((a₀ : F n) ^ (2 ^ n)) ^ (2 ^ n) = (a₀ : F n) := by
    rw [← pow_mul, show 2 ^ n * 2 ^ n = 2 ^ (2 * n) by ring, pow_card_sq]
  have hne : (a₀ : F n) ^ (2 ^ n) ≠ (a₀ : F n) := by
    intro h
    have h' : a₀ ^ (2 ^ n - 1) = 1 := by
      have h2 : a₀ ^ (2 ^ n) = a₀ := Units.ext h
      have h3 : a₀ ^ (2 ^ n - 1) * a₀ = 1 * a₀ := by
        rw [← pow_succ, Nat.sub_add_cancel Nat.one_le_two_pow, h2, one_mul]
      exact mul_right_cancel h3
    have hdvd : orderOf a₀ ∣ 2 ^ n - 1 := orderOf_dvd_iff_pow_eq_one.mpr h'
    rw [horder] at hdvd
    have hltp : 2 ^ n < 2 ^ (2 * n) := Nat.pow_lt_pow_right (by norm_num) (by omega)
    have h2n : 1 < 2 ^ n := by
      calc 1 < 2 ^ 1 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega)
    have hlt : 2 ^ n - 1 < 2 ^ (2 * n) - 1 := by
      have h1 : 2 ^ n - 1 < 2 ^ n := Nat.sub_lt_self (by positivity) Nat.one_le_two_pow
      exact lt_of_lt_of_le h1 (Nat.le_sub_one_of_lt hltp)
    have h2n : 1 < 2 ^ n := by
      calc 1 < 2 ^ 1 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact Nat.not_dvd_of_pos_of_lt (Nat.sub_pos_of_lt h2n) hlt hdvd
  have htr : (a₀ : F n) + (a₀ : F n) ^ (2 ^ n) ≠ 0 := by
    intro h
    refine hne ?_
    have h' : (a₀ : F n) = (a₀ : F n) ^ (2 ^ n) := by
      have h'' := add_eq_zero_iff_eq_neg.mp h
      simpa [CharTwo.neg_eq] using h''
    exact h'.symm
  have hy : (((a₀ : F n) + (a₀ : F n) ^ (2 ^ n)) ^ (2 ^ n))
      = (a₀ : F n) + (a₀ : F n) ^ (2 ^ n) := by
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    rw [add_pow_char_pow, hsq0, add_comm]
  obtain ⟨b, hb⟩ :=
    Commons.FieldTheory.FiniteField.exists_pow_card_add_one_eq_of_pow_eq_self hn1 hy
  have hc1 := suU_cond_div_inv n hn1 a₀ b hb
  have hc2 := suU_cond_mul_pow n hn1 a₀ b hb
  have hword := suTg_eq_word n a₀ b hb
  have hA : (⟨suUg n b (a₀ : F n), suUg_isSU3 n b (a₀ : F n) hb.symm⟩ : ↥(SU3 n))
      ∈ commutator ↥(SU3 n) :=
    suU_le_commutator n hn (Subgroup.mem_subgroupOf.mpr ⟨b, (a₀ : F n), hb.symm, rfl⟩)
  have hB : (⟨suUinvg n (b * (a₀ : F n)⁻¹) (((a₀ : F n) ^ (2 ^ n))⁻¹),
        suUinv_le_SU3 n (suUinvg_mem_suUinv n _ _ hc1)⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suUinv_le_commutator n hn (Subgroup.mem_subgroupOf.mpr (suUinvg_mem_suUinv n _ _ hc1))
  have hC : (⟨suUg n (b * (a₀ : F n) ^ (2 ^ n - 1)) (a₀ : F n),
        suUg_isSU3 n _ _ hc2⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suU_le_commutator n hn (Subgroup.mem_subgroupOf.mpr ⟨_, _, hc2, rfl⟩)
  have hW : (⟨suSg n, suSg_isSU3 n⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suSg_mem_commutator n hn
  have hT0 : (⟨suTg n a₀, suTg_isSU3 n a₀⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) := by
    have heq : (⟨suTg n a₀, suTg_isSU3 n a₀⟩ : ↥(SU3 n)) =
        (⟨suUg n b (a₀ : F n), suUg_isSU3 n b (a₀ : F n) hb.symm⟩ : ↥(SU3 n)) *
          (⟨suUinvg n (b * (a₀ : F n)⁻¹) (((a₀ : F n) ^ (2 ^ n))⁻¹),
            suUinv_le_SU3 n (suUinvg_mem_suUinv n _ _ hc1)⟩ : ↥(SU3 n)) *
          (⟨suUg n (b * (a₀ : F n) ^ (2 ^ n - 1)) (a₀ : F n),
            suUg_isSU3 n _ _ hc2⟩ : ↥(SU3 n)) *
          (⟨suSg n, suSg_isSU3 n⟩ : ↥(SU3 n)) := by
      apply Subtype.ext
      simp only [Subgroup.coe_mul]
      exact hword
    rw [heq]
    exact (commutator ↥(SU3 n)).mul_mem ((commutator ↥(SU3 n)).mul_mem
      ((commutator ↥(SU3 n)).mul_mem hA hB) hC) hW
  intro x hx
  have hxU : (x : GL (Fin 3) (F n)) ∈ suT n := hx
  obtain ⟨a, ha⟩ := hxU
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (ha₀ a)
  have hx' : x = (⟨suTg n a₀, suTg_isSU3 n a₀⟩ : ↥(SU3 n)) ^ k := by
    apply Subtype.ext
    have h1 : (x : GL (Fin 3) (F n)) = suTg n a := ha
    show (x : GL (Fin 3) (F n)) = (suTg n a₀) ^ k
    rw [h1, ← hk]
    exact map_zpow (suThom n) a₀ k
  rw [hx']
  exact (commutator ↥(SU3 n)).zpow_mem hT0 k

/-- The Borel subgroup consists of commutators. -/
theorem suB_le_commutator (n : ℕ) (hn : 2 ≤ n) :
    (suB n).subgroupOf (SU3 n) ≤ commutator ↥(SU3 n) := by
  intro x hx
  have hx' : (x : GL (Fin 3) (F n)) ∈ suB n := hx
  obtain ⟨u, hu, t, ht, hut⟩ := suB_mem_decomp n hx'
  have huC : (⟨u, suU_le_SU3 n hu⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suU_le_commutator n hn (Subgroup.mem_subgroupOf.mpr hu)
  have htC : (⟨t, suT_le_SU3 n ht⟩ : ↥(SU3 n)) ∈ commutator ↥(SU3 n) :=
    suT_le_commutator n hn (Subgroup.mem_subgroupOf.mpr ht)
  have hx'' : x = (⟨u, suU_le_SU3 n hu⟩ : ↥(SU3 n)) * (⟨t, suT_le_SU3 n ht⟩ : ↥(SU3 n)) := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    exact hut
  rw [hx'']
  exact (commutator ↥(SU3 n)).mul_mem huC htC

/-- **`SU(3,2^n)` is perfect** for `n ≥ 2`. -/
theorem commutator_SU3_eq_top (n : ℕ) (hn : 2 ≤ n) :
    commutator ↥(SU3 n) = ⊤ := by
  have hn1 : 1 ≤ n := by omega
  have hB : (suB n).subgroupOf (SU3 n) ≤ commutator ↥(SU3 n) := suB_le_commutator n hn
  rw [eq_top_iff]
  intro x _
  rcases suSg_bruhat_cover n hn1 x.2 with hx | ⟨b₁, hb₁, b₂, hb₂, hx'⟩
  · exact hB hx
  · have hx'' : x = (⟨b₁, suB_le_SU3 n hb₁⟩ : ↥(SU3 n)) *
        (⟨suSg n, suSg_isSU3 n⟩ : ↥(SU3 n)) * (⟨b₂, suB_le_SU3 n hb₂⟩ : ↥(SU3 n)) := by
      apply Subtype.ext
      simp only [Subgroup.coe_mul]
      exact hx'
    rw [hx'']
    exact (commutator ↥(SU3 n)).mul_mem ((commutator ↥(SU3 n)).mul_mem
      (hB (Subgroup.mem_subgroupOf.mpr hb₁)) (suSg_mem_commutator n hn))
      (hB (Subgroup.mem_subgroupOf.mpr hb₂))

/-- **`SU(3,2^n)` is perfect** for `n ≥ 2`. -/
theorem isPerfect_SU3 (n : ℕ) (hn : 2 ≤ n) : Group.IsPerfect ↥(SU3 n) :=
  ⟨commutator_SU3_eq_top n hn⟩


