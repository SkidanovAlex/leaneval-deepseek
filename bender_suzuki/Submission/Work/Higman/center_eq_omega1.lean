variable {P : Type} [Group P] [Finite P]

/-! ## The squares of the central elements

Write `Z² = {z * z | z ∈ Z(P)}`, a subgroup since the centre is abelian.  The first fact here
(`mem_center_of_sq_mem_centerSq`) is the key easy half of Higman's Lemma 2: an element whose
square is a square of a central element is itself central.  The second (`omega1_le_centerSq`)
uses the transitivity of `ξ` on the involutions: as soon as `Z ≠ Ω₁`, every involution is a
square of a central element, i.e. `Ω₁(P) ≤ Z(P)²`. -/

/-- The squaring map on the centre, as a homomorphism (the centre is abelian). -/
def centerSqHom (P : Type*) [Group P] : ↥(Subgroup.center P) →* P where
  toFun z := (z : P) * (z : P)
  map_one' := by simp
  map_mul' x y := by
    have hc : (y : P) * (x : P) = (x : P) * (y : P) :=
      (Subgroup.mem_center_iff.mp y.2 (x : P)).symm
    calc (x : P) * (y : P) * ((x : P) * (y : P))
        = (x : P) * ((y : P) * (x : P)) * (y : P) := by group
      _ = (x : P) * ((x : P) * (y : P)) * (y : P) := by rw [hc]
      _ = (x : P) * (x : P) * ((y : P) * (y : P)) := by group

/-- `Z(P)²`, the subgroup generated by the squares of the central elements. -/
def centerSq (P : Type*) [Group P] : Subgroup P :=
  (⊤ : Subgroup ↥(Subgroup.center P)).map (centerSqHom P)

theorem mem_centerSq {x : P} :
    x ∈ centerSq P ↔ ∃ z : P, z ∈ Subgroup.center P ∧ z * z = x := by
  rw [centerSq, Subgroup.mem_map]
  simp only [Subgroup.mem_top, true_and]
  exact ⟨fun ⟨z, hz⟩ => ⟨z, z.2, hz⟩, fun ⟨z, hz, hzx⟩ => ⟨⟨z, hz⟩, hzx⟩⟩

theorem centerSq_le_center : centerSq P ≤ Subgroup.center P := by
  intro x hx
  obtain ⟨z, hz, rfl⟩ := mem_centerSq.mp hx
  exact Subgroup.mul_mem _ hz hz

theorem sq_mem_centerSq {z : P} (hz : z ∈ Subgroup.center P) : z * z ∈ centerSq P :=
  mem_centerSq.mpr ⟨z, hz, rfl⟩

/-- The centre is invariant under every automorphism. -/
theorem mulAut_mem_center (φ : MulAut P) {z : P} (hz : z ∈ Subgroup.center P) :
    φ z ∈ Subgroup.center P := by
  rw [Subgroup.mem_center_iff] at hz ⊢
  intro g
  calc g * φ z = φ (φ.symm g * z) := by rw [map_mul, MulEquiv.apply_symm_apply]
    _ = φ (z * φ.symm g) := by rw [hz (φ.symm g)]
    _ = φ z * g := by rw [map_mul, MulEquiv.apply_symm_apply]

theorem xi_mem_center {h : IsSuzuki2Grp P} {z : P} (hz : z ∈ Subgroup.center P) :
    h.xi z ∈ Subgroup.center P := mulAut_mem_center _ hz

/-- **Higman's Lemma 2, easy case.**  If the square of `u` is the square of a central element,
then `u` itself is central. -/
theorem mem_center_of_sq_mem_centerSq (h : IsSuzuki2Grp P) {u : P}
    (hu : u ^ 2 ∈ centerSq P) : u ∈ Subgroup.center P := by
  obtain ⟨z, hz, hzu⟩ := mem_centerSq.mp hu
  have hzu' : z * z = u ^ 2 := hzu
  have hcomm : u * z = z * u := (Subgroup.mem_center_iff.mp hz) u
  have hcu : Commute u z := hcomm
  have hcz : Commute z⁻¹ u := hcu.inv_right.symm
  have ha2 : (z⁻¹ * u) ^ 2 = 1 := by
    rw [hcz.mul_pow 2, inv_pow, ← hzu', pow_two, inv_mul_cancel]
  have ha : z⁻¹ * u ∈ Subgroup.center P := h.omega1_le_center (h.mem_omega1.mpr ha2)
  have hu_eq : u = z * (z⁻¹ * u) := by group
  rw [hu_eq]
  exact Subgroup.mul_mem _ hz ha

/-- If the centre is strictly bigger than `Ω₁` then every involution is a square of a central
element: `Ω₁(P) ≤ Z(P)²`.  (Transitivity of `ξ` on the involutions, applied to the non-trivial
involution obtained by squaring up a central element of order `> 2`.) -/
theorem omega1_le_centerSq (h : IsSuzuki2Grp P)
    (hne : ∃ z ∈ Subgroup.center P, z ^ 2 ≠ 1) : omega1 P ≤ centerSq P := by
  classical
  obtain ⟨z, hz, hz2⟩ := hne
  obtain ⟨j, hj⟩ := h.isPGroup.exists_orderOf_eq_pow z
  have hz1 : z ≠ 1 := by rintro rfl; exact hz2 (by simp)
  -- the exponent of `z` is at least `4`
  have hj2 : 2 ≤ j := by
    rcases Nat.lt_or_ge j 2 with hlt | hge
    · interval_cases j
      · simp at hj
        exact absurd hj hz1
      · exfalso
        exact hz2 (by rw [← orderOf_dvd_iff_pow_eq_one, hj]; norm_num)
    · exact hge
  have hzpow : z ^ 2 ^ j = 1 := by rw [← hj]; exact pow_orderOf_eq_one z
  -- the involution `v = z ^ 2 ^ (j - 1)` is a square of the central element `z ^ 2 ^ (j - 2)`
  have hv2 : (z ^ 2 ^ (j - 1)) ^ 2 = 1 := by
    rw [← pow_mul, ← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ j)]
    exact hzpow
  have hv1 : z ^ 2 ^ (j - 1) ≠ 1 := by
    intro hv
    have hdvd : 2 ^ j ∣ 2 ^ (j - 1) := by
      rw [← hj]; exact orderOf_dvd_iff_pow_eq_one.mpr hv
    have hpos : 0 < 2 ^ (j - 1) := pow_pos (by norm_num) _
    have hlt : 2 ^ (j - 1) < 2 ^ j := Nat.pow_lt_pow_right (by norm_num) (by omega)
    exact not_le_of_gt hlt (Nat.le_of_dvd hpos hdvd)
  have hv_mem : z ^ 2 ^ (j - 1) ∈ centerSq P := by
    have hsplit : z ^ 2 ^ (j - 1) = z ^ 2 ^ (j - 2) * z ^ 2 ^ (j - 2) := by
      have hexp : 2 ^ (j - 2) * 2 = 2 ^ (j - 1) := by
        rw [← pow_succ]
        congr 1
        omega
      rw [← pow_two, ← pow_mul, hexp]
    rw [hsplit]
    exact sq_mem_centerSq (Subgroup.pow_mem _ hz _)
  have hv_ord : orderOf (z ^ 2 ^ (j - 1)) = 2 := by
    have hd : orderOf (z ^ 2 ^ (j - 1)) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hv2
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
    · exact absurd (orderOf_eq_one_iff.mp h1) hv1
    · exact h2
  intro w hw
  rcases eq_or_ne w 1 with rfl | hw1
  · exact Subgroup.one_mem _
  · have hw2 : orderOf w = 2 := by
      have hd : orderOf w ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp hw)
      rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
      · exact absurd (orderOf_eq_one_iff.mp h1) hw1
      · exact h2
    obtain ⟨k, hk⟩ := h.trans _ w hv_ord hw2
    rw [← hk]
    obtain ⟨y, hy, hyv⟩ := mem_centerSq.mp hv_mem
    rw [← hyv, map_mul]
    exact sq_mem_centerSq (mulAut_mem_center _ hy)

/-- The cardinality of `Z(P)²`: the squaring map on the centre has kernel `Ω₁`, so
`|Z(P)| = |Ω₁(P)| * |Z(P)²|`. -/
theorem card_center_eq_card_omega1_mul_card_centerSq (h : IsSuzuki2Grp P) :
    Nat.card ↥(Subgroup.center P) = Nat.card ↥(omega1 P) * Nat.card ↥(centerSq P) := by
  have hcard : Nat.card ↥((centerSqHom P).ker) * Nat.card ↥((centerSqHom P).range) =
      Nat.card ↥(Subgroup.center P) := by
    have h := Subgroup.card_mul_index (centerSqHom P).ker
    rwa [Subgroup.index_ker (centerSqHom P)] at h
  have hrange : (centerSqHom P).range = centerSq P := by
    rw [MonoidHom.range_eq_map]
    rfl
  rw [hrange] at hcard
  rw [← hcard]
  congr 1
  -- the kernel of the squaring map on the centre is `Ω₁`
  refine Nat.card_congr ?_
  refine Equiv.ofBijective (fun z : ↥(centerSqHom P).ker =>
    (⟨((z : ↥(Subgroup.center P)) : P), h.mem_omega1.mpr ?_⟩ : ↥(omega1 P))) ?_
  · rw [pow_two]
    exact z.2
  · constructor
    · intro z z' hzz'
      refine Subtype.ext (Subtype.ext ?_)
      exact congrArg (fun t : ↥(omega1 P) => (t : P)) hzz'
    · intro u
      refine ⟨⟨⟨(u : P), h.omega1_le_center u.2⟩, ?_⟩, ?_⟩
      · show (((u : P)) : P) * (((u : P)) : P) = 1
        rw [← pow_two, h.mem_omega1.mp u.2]
      · exact Subtype.ext rfl

/-- `Ω₁(P)` is `ξ`-irreducible: a `ξ`-invariant subgroup of `Ω₁(P)` is `1` or `Ω₁(P)`
(transitivity of `ξ` on the involutions). -/
theorem eq_omega1_of_le_omega1_of_invariant (h : IsSuzuki2Grp P) {H : Subgroup P}
    (hH : H ≤ omega1 P) (hinv : H.map (h.xi : MulAut P).toMonoidHom = H) (hne : H ≠ ⊥) :
    H = omega1 P := by
  have hxinv : ∀ k : ℕ, ∀ x : P, x ∈ H → (h.xi ^ k) x ∈ H := by
    intro k
    induction k with
    | zero => intro x hx; simpa using hx
    | succ k ih =>
      intro x hx
      have hmem : h.xi ((h.xi ^ k) x) ∈ H := by
        have h1 : h.xi.toMonoidHom ((h.xi ^ k) x) ∈ H.map (h.xi : MulAut P).toMonoidHom :=
          Subgroup.mem_map_of_mem _ (ih x hx)
        rwa [hinv] at h1
      simpa [pow_succ'] using hmem
  have hsub : omega1 P ≤ H := by
    intro g hg
    rcases eq_or_ne g 1 with rfl | hg1
    · exact H.one_mem
    · have hg2 : orderOf g = 2 := by
        have hd : orderOf g ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp hg)
        rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
        · exact absurd (orderOf_eq_one_iff.mp h1) hg1
        · exact h2
      have hex : ∃ x ∈ H, x ≠ 1 := by
        by_contra hcon
        push_neg at hcon
        exact hne (le_antisymm (fun x hx => by simpa using hcon x hx) bot_le)
      obtain ⟨x, hxH, hx1⟩ := hex
      have hx2 : orderOf x = 2 := by
        have hd : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp (hH hxH))
        rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
        · exact absurd (orderOf_eq_one_iff.mp h1) hx1
        · exact h2
      obtain ⟨k, hk⟩ := h.trans x g hx2 hg2
      rw [← hk]
      exact hxinv k x hxH
  exact le_antisymm hH hsub

section ClassTwo

/-- `P' ≤ Ω₁` puts every commutator into `Ω₁`. -/
theorem commutator_mem_omega1 {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P) (x y : P) : ⁅x, y⁆ ∈ omega1 P :=
  hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))

/-- `P' ≤ Ω₁` makes every commutator central: the group has class `2`. -/
theorem commutator_mem_center {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P) (x y : P) : ⁅x, y⁆ ∈ Subgroup.center P :=
  h.omega1_le_center (commutator_mem_omega1 h hcomm x y)

/-- Every commutator is an involution. -/
theorem commutator_sq_eq_one {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P) (x y : P) : ⁅x, y⁆ * ⁅x, y⁆ = 1 := by
  have h1 := h.mem_omega1.mp (commutator_mem_omega1 h hcomm x y)
  rwa [pow_two] at h1

/-- `⁅x, y⁆ = 1` means precisely that `x` and `y` commute. -/
theorem commutator_eq_one_iff (x y : P) : ⁅x, y⁆ = 1 ↔ x * y = y * x := by
  rw [commutatorElement_def]
  constructor
  · intro h1
    calc x * y = x * y * x⁻¹ * y⁻¹ * (y * x) := by group
      _ = 1 * (y * x) := by rw [h1]
      _ = y * x := one_mul _
  · intro h1
    rw [h1]
    group

/-- In class `2` the square of every element is central.

Renamed from `sq_mem_center` (area owner, 2026-10-05): the live, unconditional form
`Work.Higman.sq_mem_center` lives in `Submission/Work/Higman/sq_mem_center.lean`, and this
superseded conditional form clashed with it (see `SUPERSEDED.md`). -/
theorem sq_mem_center_of_comm {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P) (x : P) : x ^ 2 ∈ Subgroup.center P := by
  rw [Subgroup.mem_center_iff]
  intro y
  have hc : ⁅x, y⁆ ∈ Subgroup.center P := commutator_mem_center h hcomm x y
  have hxy : x * y * x⁻¹ = ⁅x, y⁆ * y := by
    rw [commutatorElement_def]; group
  have hcx : x * ⁅x, y⁆ = ⁅x, y⁆ * x := (Subgroup.mem_center_iff.mp hc) x
  have hkey : x * x * y * (x * x)⁻¹ * y⁻¹ = 1 := by
    calc x * x * y * (x * x)⁻¹ * y⁻¹
        = x * (x * y * x⁻¹) * x⁻¹ * y⁻¹ := by group
      _ = x * (⁅x, y⁆ * y) * x⁻¹ * y⁻¹ := by rw [hxy]
      _ = x * ⁅x, y⁆ * y * x⁻¹ * y⁻¹ := by group
      _ = ⁅x, y⁆ * x * y * x⁻¹ * y⁻¹ := by rw [hcx]
      _ = ⁅x, y⁆ * (x * y * x⁻¹ * y⁻¹) := by group
      _ = ⁅x, y⁆ * ⁅x, y⁆ := by rw [commutatorElement_def]
      _ = 1 := commutator_sq_eq_one h hcomm x y
  have h3 : (x * x) * y = y * (x * x) := (commutator_eq_one_iff (x * x) y).mp hkey
  simpa [pow_two] using h3.symm

end ClassTwo

section Homocyclic

/-- The centre is `ξ`-invariant (it is characteristic). -/
theorem center_map_xi (h : IsSuzuki2Grp P) :
    (Subgroup.center P).map (h.xi : MulAut P).toMonoidHom = Subgroup.center P := by
  ext z
  constructor
  · rintro ⟨w, hw, rfl⟩
    exact mulAut_mem_center _ hw
  · intro hz
    refine ⟨(h.xi : MulAut P).symm z, ?_, by simp⟩
    exact mulAut_mem_center _ hz

/-- **Higman's Lemma 1 for the centre.**  The centre is homocyclic: with `2 ^ e` its exponent,
`|Z(P)| = |Ω₁(P)| ^ e`, and the `2 ^ (e-1)`-st power map carries the centre onto `Ω₁(P)`. -/
theorem exists_center_exp (h : IsSuzuki2Grp P) :
    ∃ e : ℕ, (∀ z ∈ Subgroup.center P, z ^ 2 ^ e = 1) ∧
      (∃ z ∈ Subgroup.center P, orderOf z = 2 ^ e) ∧
      Nat.card ↥(Subgroup.center P) = Nat.card ↥(omega1 P) ^ e ∧
      (∀ u ∈ omega1 P, ∃ z ∈ Subgroup.center P, z ^ 2 ^ (e - 1) = u) := by
  obtain ⟨e, he1, he2, he3⟩ :=
    higman_lemma1 h (A := Subgroup.center P)
      (fun x hx y hy => (Subgroup.mem_center_iff.mp hx y).symm) (center_map_xi h)
  refine ⟨e, he1, he2, ?_, ?_⟩
  · rw [he3, inf_eq_right.mpr h.omega1_le_center]
  · -- every element of `Ω₁` is a `2 ^ (e-1)`-st power of a central element
    obtain ⟨a, ha, haord⟩ := he2
    have hae : a ^ 2 ^ e = 1 := he1 a ha
    have hepos : 1 ≤ e := by
      rcases Nat.eq_zero_or_pos e with h0 | hpos
      · exfalso
        rw [h0, pow_zero] at he3
        have hle : Nat.card ↥(omega1 P) ≤ Nat.card ↥(Subgroup.center P) :=
          Nat.le_of_dvd (Nat.card_pos) (Subgroup.card_dvd_of_le h.omega1_le_center)
        have h4 := h.omega1_card_ge_four
        omega
      · exact hpos
    set x : P := a ^ 2 ^ (e - 1) with hxdef
    have hx2 : x ^ 2 = 1 := by
      rw [hxdef, ← pow_mul, ← pow_succ, Nat.sub_add_cancel hepos]
      exact hae
    have hx1 : x ≠ 1 := by
      intro hx
      have hdvd : 2 ^ e ∣ 2 ^ (e - 1) := by
        rw [← haord]
        exact orderOf_dvd_iff_pow_eq_one.mpr (by rw [← hxdef]; exact hx)
      have hpos : 0 < 2 ^ (e - 1) := pow_pos (by norm_num) _
      have hlt : 2 ^ (e - 1) < 2 ^ e := Nat.pow_lt_pow_right (by norm_num) (by omega)
      exact not_le_of_gt hlt (Nat.le_of_dvd hpos hdvd)
    have hxmem : x ∈ Subgroup.center P := Subgroup.pow_mem _ ha _
    have hpow : ∃ y ∈ Subgroup.center P, y ^ 2 ^ (e - 1) = x := ⟨a, ha, rfl⟩
    intro u hu
    exact exists_pow_eq_of_mem_invol h (center_map_xi h) (s := e - 1) hxmem hx2 hx1 hpow
      u (h.omega1_le_center hu) (h.mem_omega1.mp hu)

end Homocyclic

/-! ## Higman's Lemma 9, first part

The inputs are all the *clean* forms in the workspace: Higman's Lemma 3 (`CommAux.lemma3`),
Higman's Lemma 7 (`MSA.higman_lemma7_msa`) and Higman's Lemma 8 (`MSA.lemma8_clean`) feed
`MSA.powSub_four_bot_of_maximal`. -/

section HigmanNine

/-- **Higman 1963, Lemma 9, first part** (assembled form).  A maximal `ξ`-invariant abelian
normal subgroup `A` of a Suzuki 2-group has exponent dividing `4`: `A ^ (4) = ⊥`. -/
theorem powSub_four_eq_bot_of_maximal {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    {A : Subgroup P} (hA : IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A) :
    powSub A 4 = ⊥ :=
  MSA.powSub_four_bot_of_maximal h hA hmax
    (fun hA' hCn hCinv hAC hACne hcover hPhi =>
      CommAux.lemma3 h hA' hCn hCinv hAC hACne hcover hPhi)
    (fun hA' hCn hCinv hAC hACne hcover hPhi hCd2 =>
      MSA.higman_lemma7_msa h hA' hCn hCinv hAC hACne hcover hPhi hCd2)
    (fun hA' hCn hCinv hAC hACne hcover hC2 hCd =>
      MSA.lemma8_clean h hA' hCn hCinv hAC hACne hcover hC2 hCd)

end HigmanNine

/-! ## The Gorenstein–Thompson step

The centre of a Suzuki 2-group with `⁅P,P⁆ ≤ Ω₁(P)` (equivalently: of nilpotency class two) lies
in `Ω₁(P)`.  The commutator pairing `(x, y) ↦ ⁅x,y⁆` of the class-two group `P` only depends on
the classes of `x` and `y` modulo the centre, and the `2 ^ E`-th power map (`2 ^ E` the exponent
of the centre) is a `ξ`-equivariant homomorphism `s : P → Ω₁(P)` with kernel exactly `Z(P)`; by
irreducibility of `Ω₁(P)` under `ξ` it is surjective, i.e. `P / Z(P) ≅ Ω₁(P)`.  Transporting the
pairing along a section of `s` gives a `ξ`-equivariant alternating bihomomorphism
`Ω₁(P) → Ω₁(P) → Ω₁(P)`, which vanishes by Gorenstein–Thompson
(`Work.Higman.equivariant_bihom_trivial`); then every commutator of `P` is trivial. -/

section GTStep

open scoped commutatorElement

/-- In a class-two group, `⁅z, x * y⁆ = ⁅z, x⁆ * ⁅z, y⁆` (named to avoid a clash with
`Work.Higman.commutator_mul_right_center` in `Submission/Work/Higman/suzuki_exp_four.lean`). -/
theorem ceo_commutator_mul_right {G : Type} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    ⁅z, x * y⁆ = ⁅z, x⁆ * ⁅z, y⁆ := by
  have h1 : ⁅z, x * y⁆ = ⁅x * y, z⁆⁻¹ := by rw [← commutatorElement_inv]
  rw [h1, commutator_mul_left hZ x y z, mul_inv_rev, commutatorElement_inv,
    commutatorElement_inv]
  exact (commutator_central_comm hZ z y ⁅z, x⁆).symm

/-- **Gorenstein–Thompson step.**  If the derived subgroup of a Suzuki 2-group lies in `Ω₁(P)`,
then the centre lies in `Ω₁(P)` as well. -/
theorem center_le_omega1_of_comm_le {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P) : Subgroup.center P ≤ omega1 P := by
  classical
  letI : CommGroup ↥(omega1 P) :=
    { (inferInstance : Group ↥(omega1 P)) with
      mul_comm := fun a b => Subtype.ext (h.omega1_comm a.2 b.2) }
  by_contra hcon
  have hex : ∃ z ∈ Subgroup.center P, z ∉ omega1 P := by
    by_contra hc
    push Not at hc
    exact hcon fun w hw => hc w hw
  obtain ⟨z, hz, hzOm⟩ := hex
  have hne : Subgroup.center P ≠ omega1 P := fun heq => hzOm (heq ▸ hz)
  -- class two: every square of `P` is central
  have hsqZ : ∀ x : P, x ^ 2 ∈ Subgroup.center P := fun x => sq_mem_center_of_comm h hcomm x
  -- the centre is an admissible (ξ-invariant abelian normal) subgroup
  have hZxi : IsXiAbelNormal h (Subgroup.center P) :=
    ⟨(Subgroup.center P).normal_of_le_center le_rfl, center_map_xi h,
      fun x hx y hy => (Subgroup.mem_center_iff.mp hx y).symm⟩
  -- Higman's Lemma 1 for the centre: `2 ^ E` is its exponent
  obtain ⟨E, hEexp, -, hEkey⟩ := mem_powSub_two_iff h hZxi
  have hE : 2 ≤ E := by
    rcases Nat.lt_or_ge E 2 with hlt | hge
    · exfalso
      interval_cases E
      · refine hne (le_antisymm (fun w hw => ?_) h.omega1_le_center)
        have h1 : w = 1 := by simpa using hEexp w hw
        rw [h1]
        exact Subgroup.one_mem _
      · refine hne (le_antisymm (fun w hw => ?_) h.omega1_le_center)
        exact h.mem_omega1.mpr (by simpa using hEexp w hw)
    · exact hge
  -- `powSub Z 2 = Z²`
  have hZ2 : powSub (Subgroup.center P) 2 = centerSq P := by
    ext y
    rw [mem_powSub_iff (fun a ha b hb => (Subgroup.mem_center_iff.mp ha b).symm), mem_centerSq]
    constructor
    · rintro ⟨w, hw, hw'⟩
      exact ⟨w, hw, by rw [← pow_two, hw']⟩
    · rintro ⟨w, hw, hw'⟩
      exact ⟨w, hw, by rwa [← pow_two] at hw'⟩
  -- the `2 ^ E`-th power map is a homomorphism `P → Ω₁(P)`
  have h2E : 2 ^ E = 2 * 2 ^ (E - 1) := by
    nth_rewrite 1 [show E = (E - 1) + 1 by omega]
    rw [pow_succ']
  have hfold : ∀ t : P, t ^ 2 ^ E = (t ^ 2) ^ 2 ^ (E - 1) := by
    intro t
    rw [← pow_mul, h2E]
  have hfmem : ∀ x : P, x ^ 2 ^ E ∈ omega1 P := by
    intro x
    have hx2 : x ^ 2 ∈ Subgroup.center P := hsqZ x
    have h2 : ((x ^ 2) ^ 2 ^ (E - 1)) ^ 2 = 1 := by
      rw [← pow_mul, show 2 ^ (E - 1) * 2 = 2 ^ E by rw [← pow_succ]; congr 1; omega]
      exact hEexp (x ^ 2) hx2
    rw [h.mem_omega1, hfold x]
    exact h2
  let s : P →* ↥(omega1 P) :=
    { toFun := fun x => ⟨x ^ 2 ^ E, hfmem x⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x y => Subtype.ext (pow_two_pow_mul h hcomm hE x y) }
  have hsval : ∀ x : P, ((s x : ↥(omega1 P)) : P) = x ^ 2 ^ E := fun _ => rfl
  have hsxi : ∀ x : P, ((s (h.xi x) : ↥(omega1 P)) : P) = h.xi ((s x : ↥(omega1 P)) : P) := by
    intro x
    rw [hsval (h.xi x), hsval x, map_pow]
  -- the kernel of `s` is exactly the centre
  have hker : ∀ x : P, s x = 1 ↔ x ∈ Subgroup.center P := by
    intro x
    constructor
    · intro hx
      have hx' : x ^ 2 ^ E = 1 := by
        have hc := congrArg (fun t : ↥(omega1 P) => (t : P)) hx
        rw [hsval x] at hc
        simpa using hc
      have hx'' : (x ^ 2) ^ 2 ^ (E - 1) = 1 := by rw [← hfold x]; exact hx'
      have hmem : x ^ 2 ∈ powSub (Subgroup.center P) 2 := (hEkey (x ^ 2) (hsqZ x)).mpr hx''
      rw [hZ2] at hmem
      exact mem_center_of_sq_mem_centerSq h hmem
    · intro hx
      refine Subtype.ext ?_
      rw [hsval x]
      exact hEexp x hx
  -- the image of `s`, viewed in `P`, is `Ω₁(P)`; hence `s` is surjective
  have hmemS : ∀ x : P,
      x ∈ (s.range).map (Subgroup.subtype (omega1 P)) ↔ ∃ w : P,
        ((s w : ↥(omega1 P)) : P) = x := by
    intro x
    rw [Subgroup.mem_map]
    constructor
    · rintro ⟨u, hu, hux⟩
      rw [MonoidHom.mem_range] at hu
      obtain ⟨w, hw⟩ := hu
      exact ⟨w, by simpa [hw] using hux⟩
    · rintro ⟨w, hw⟩
      exact ⟨s w, ⟨w, rfl⟩, by simpa using hw⟩
  have hsurj : Function.Surjective s := by
    have hSle : (s.range).map (Subgroup.subtype (omega1 P)) ≤ omega1 P := by
      intro x hx
      obtain ⟨w, hw⟩ := (hmemS x).mp hx
      rw [← hw]
      exact (s w).2
    have hSinv : ((s.range).map (Subgroup.subtype (omega1 P))).map
        (h.xi : MulAut P).toMonoidHom = (s.range).map (Subgroup.subtype (omega1 P)) := by
      refine le_antisymm ?_ ?_
      · intro x hx
        rw [Subgroup.mem_map] at hx
        obtain ⟨w, hw, hwx⟩ := hx
        obtain ⟨t, ht⟩ := (hmemS w).mp hw
        refine (hmemS x).mpr ⟨h.xi t, ?_⟩
        rw [hsxi t, ht]
        exact hwx
      · intro x hx
        obtain ⟨t, ht⟩ := (hmemS x).mp hx
        refine Subgroup.mem_map.mpr
          ⟨(s ((h.xi : MulAut P).symm t) : ↥(omega1 P)), ?_, ?_⟩
        · exact (hmemS _).mpr ⟨(h.xi : MulAut P).symm t, rfl⟩
        · change h.xi ((s ((h.xi : MulAut P).symm t) : ↥(omega1 P)) : P) = x
          rw [← hsxi ((h.xi : MulAut P).symm t), MulEquiv.apply_symm_apply, ht]
    have hSne : (s.range).map (Subgroup.subtype (omega1 P)) ≠ ⊥ := by
      intro hbot
      have hall : ∀ w : P, w ∈ Subgroup.center P := by
        intro w
        have hmem : ((s w : ↥(omega1 P)) : P)
            ∈ (s.range).map (Subgroup.subtype (omega1 P)) := (hmemS _).mpr ⟨w, rfl⟩
        rw [hbot] at hmem
        have h1 : ((s w : ↥(omega1 P)) : P) = 1 := by simpa using hmem
        exact (hker w).mp (Subtype.ext h1)
      obtain ⟨x, y, hxy⟩ := h.noncomm
      exact hxy (by rw [(Subgroup.mem_center_iff.mp (hall x) y).symm])
    rcases omega1_eq_bot_or_top_of_invariant h hSle hSinv with hbot | htop
    · exact absurd hbot hSne
    · intro a
      have ha : (a : P) ∈ (s.range).map (Subgroup.subtype (omega1 P)) := by
        rw [htop]
        exact a.2
      obtain ⟨w, hw⟩ := (hmemS (a : P)).mp ha
      exact ⟨w, Subtype.ext hw⟩
  -- a section of `s`
  let r : ↥(omega1 P) → P := fun a => Classical.choose (hsurj a)
  have hr : ∀ a : ↥(omega1 P), s (r a) = a := fun a => Classical.choose_spec (hsurj a)
  -- the transported commutator pairing
  have hc_mem : ∀ x y : P, ⁅x, y⁆ ∈ omega1 P := fun x y =>
    hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))
  let c : ↥(omega1 P) → ↥(omega1 P) → ↥(omega1 P) :=
    fun u v => ⟨⁅r u, r v⁆, hc_mem _ _⟩
  have hcent : ∀ w ∈ Subgroup.center P, ∀ x : P, x * w = w * x :=
    fun w hw x => Subgroup.mem_center_iff.mp hw x
  have hcz : ∀ (a b t : P), t ∈ Subgroup.center P → ⁅a * t, b⁆ = ⁅a, b⁆ := by
    intro a b t ht
    rw [commutatorElement_def]
    show a * t * b * (a * t)⁻¹ * b⁻¹ = a * b * a⁻¹ * b⁻¹
    rw [show a * t * b * (a * t)⁻¹ * b⁻¹ = a * (t * b) * (t⁻¹ * a⁻¹) * b⁻¹ from by group,
      (hcent t ht b).symm]
    group
  have hcz2 : ∀ (a b t : P), t ∈ Subgroup.center P → ⁅a, b * t⁆ = ⁅a, b⁆ := by
    intro a b t ht
    rw [commutatorElement_def]
    show a * (b * t) * a⁻¹ * (b * t)⁻¹ = a * b * a⁻¹ * b⁻¹
    rw [show a * (b * t) * a⁻¹ * (b * t)⁻¹ = a * b * (t * a⁻¹) * t⁻¹ * b⁻¹ from by group,
      (hcent t ht a⁻¹).symm]
    group
  have hcongr : ∀ (x x' y y' : P), x⁻¹ * x' ∈ Subgroup.center P →
      y⁻¹ * y' ∈ Subgroup.center P → ⁅x, y⁆ = ⁅x', y'⁆ := by
    intro x x' y y' hx hy
    obtain ⟨t, ht, htx⟩ : ∃ t ∈ Subgroup.center P, x' = x * t := ⟨x⁻¹ * x', hx, by group⟩
    obtain ⟨t', ht', hty⟩ : ∃ t ∈ Subgroup.center P, y' = y * t := ⟨y⁻¹ * y', hy, by group⟩
    rw [htx, hty, hcz _ _ t ht, hcz2 _ _ t' ht']
  have hcong : ∀ u v : P, s u = s v → u⁻¹ * v ∈ Subgroup.center P := by
    intro u v huv
    have h1 : s (u⁻¹ * v) = 1 := by rw [map_mul, map_inv, huv, inv_mul_cancel]
    exact (hker (u⁻¹ * v)).mp h1
  have hone : ∀ y : P, y⁻¹ * y ∈ Subgroup.center P := fun y => by
    rw [inv_mul_cancel]
    exact Subgroup.one_mem _
  -- biadditivity, alternation, `ξ`-equivariance
  have hmul : ∀ a b d : ↥(omega1 P), c (a * b) d = c a d * c b d := by
    intro a b d
    have h1 : (r (a * b))⁻¹ * (r a * r b) ∈ Subgroup.center P := by
      refine hcong _ _ ?_
      rw [map_mul, hr (a * b), hr a, hr b]
    apply Subtype.ext
    show ⁅r (a * b), r d⁆ = ⁅r a, r d⁆ * ⁅r b, r d⁆
    rw [hcongr _ _ _ _ h1 (hone (r d)),
      commutator_mul_left (hcomm.trans h.omega1_le_center)]
  have hmulR : ∀ a b d : ↥(omega1 P), c a (b * d) = c a b * c a d := by
    intro a b d
    have h1 : (r (b * d))⁻¹ * (r b * r d) ∈ Subgroup.center P := by
      refine hcong _ _ ?_
      rw [map_mul, hr (b * d), hr b, hr d]
    apply Subtype.ext
    show ⁅r a, r (b * d)⁆ = ⁅r a, r b⁆ * ⁅r a, r d⁆
    rw [hcongr _ _ _ _ (hone (r a)) h1,
      ceo_commutator_mul_right (hcomm.trans h.omega1_le_center)]
  have halt : ∀ a : ↥(omega1 P), c a a = 1 := by
    intro a
    apply Subtype.ext
    show ⁅r a, r a⁆ = (1 : P)
    rw [commutatorElement_def]; group
  -- the action of `ξ` on `Ω₁(P)`
  have hxi_mem : ∀ u : ↥(omega1 P), h.xi (u : P) ∈ omega1 P := fun u => by
    have h1 := map_xi_omega1 h
    have h2 : h.xi (u : P) ∈ (omega1 P).map (h.xi : MulAut P).toMonoidHom :=
      Subgroup.mem_map_of_mem _ u.2
    rwa [h1] at h2
  let ξV : MulAut ↥(omega1 P) :=
    { toFun := fun u => ⟨h.xi (u : P), hxi_mem u⟩
      invFun := fun u => ⟨(h.xi : MulAut P).symm (u : P),
        symm_mem_of_map_eq (h.xi : MulAut P) (map_xi_omega1 h) u.2⟩
      left_inv := fun u => by ext; simp
      right_inv := fun u => by ext; simp
      map_mul' := fun u v => by ext; simp }
  have hξVval : ∀ u : ↥(omega1 P), ((ξV u : ↥(omega1 P)) : P) = h.xi (u : P) := fun _ => rfl
  have hξVpow : ∀ (k : ℕ) (u : ↥(omega1 P)), ((ξV ^ k) u : P) = (h.xi ^ k) (u : P) := by
    intro k
    induction k with
    | zero => intro u; simp
    | succ k ih =>
        intro u
        have h1 : ((ξV ^ (k + 1)) u : ↥(omega1 P)) = ξV ((ξV ^ k) u) := by
          rw [pow_succ', MulAut.mul_apply]
        rw [h1]
        show h.xi (((ξV ^ k) u : ↥(omega1 P)) : P) = (h.xi ^ (k + 1)) (u : P)
        rw [ih u, pow_succ', MulAut.mul_apply]
  have h2 : ∀ a : ↥(omega1 P), a * a = 1 := fun a => by
    rw [← pow_two]
    exact Subtype.ext (h.mem_omega1.mp a.2)
  have htrans : ∀ a b : ↥(omega1 P), a ≠ 1 → b ≠ 1 → ∃ k : ℕ, (ξV ^ k) a = b := by
    intro a b ha hb
    have key : ∀ u : ↥(omega1 P), u ≠ 1 → orderOf (u : P) = 2 := by
      intro u hu
      have hd : orderOf (u : P) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp u.2)
      rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2'
      · exact absurd (Subtype.ext (orderOf_eq_one_iff.mp h1)) hu
      · exact h2'
    obtain ⟨k, hk⟩ := h.trans (a : P) (b : P) (key a ha) (key b hb)
    exact ⟨k, Subtype.ext (by rw [hξVpow k a]; exact hk)⟩
  have heq : ∀ a b : ↥(omega1 P), ξV (c a b) = c (ξV a) (ξV b) := by
    intro a b
    apply Subtype.ext
    show h.xi (⁅r a, r b⁆) = ⁅r (ξV a), r (ξV b)⁆
    have hcommut : h.xi ⁅r a, r b⁆ = ⁅h.xi (r a), h.xi (r b)⁆ := by
      simp only [commutatorElement_def, map_mul, map_inv]
    rw [hcommut]
    refine hcongr _ _ _ _ ?_ ?_
    · refine hcong _ _ (Subtype.ext ?_)
      show ((s (h.xi (r a)) : ↥(omega1 P)) : P) = ((s (r (ξV a)) : ↥(omega1 P)) : P)
      rw [hsxi (r a), hr a, hr (ξV a)]
      rfl
    · refine hcong _ _ (Subtype.ext ?_)
      show ((s (h.xi (r b)) : ↥(omega1 P)) : P) = ((s (r (ξV b)) : ↥(omega1 P)) : P)
      rw [hsxi (r b), hr b, hr (ξV b)]
      rfl
  have key := equivariant_bihom_trivial h2 ξV htrans c hmul hmulR halt heq
  -- consequently `P` is abelian, contradicting `h.noncomm`
  obtain ⟨x, y, hxy⟩ := h.noncomm
  have h1 : c (s x) (s y) = 1 := key _ _
  have h2' : ⁅x, y⁆ = ⁅r (s x), r (s y)⁆ :=
    hcongr x (r (s x)) y (r (s y)) (hcong _ _ (hr (s x)).symm) (hcong _ _ (hr (s y)).symm)
  have h3 : ⁅x, y⁆ = 1 := by
    rw [h2']
    exact congrArg (fun t : ↥(omega1 P) => (t : P)) h1
  exact hxy ((commutator_eq_one_iff x y).mp h3)

end GTStep

/-- In a Suzuki 2-group the centre consists exactly of the elements of order dividing two
(Higman 1963, §2: `Ω₁(P) = Z(P)`). -/
theorem center_eq_omega1 {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) :
    Subgroup.center P = Work.Higman.omega1 P := by
  refine le_antisymm ?_ h.omega1_le_center
  -- a maximal `ξ`-invariant abelian normal subgroup, of exponent dividing `4`, containing
  -- `Ω₁(P)`, `Z(P)`, the commutator subgroup and the squares of all elements
  obtain ⟨A, hA, hmax⟩ := exists_maximal_isXiAbelNormal h
  have hA4 : powSub A 4 = ⊥ := powSub_four_eq_bot_of_maximal h hA hmax
  have hPhi : powSub (⊤ : Subgroup P) 2 ⊔ ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A :=
    MSA.phi_le_of_maximal h hA hmax hA4
  have hsqA : ∀ x : P, x ^ 2 ∈ A := fun x =>
    hPhi (Subgroup.mem_sup_left (pow_mem_powSub (Subgroup.mem_top x)))
  have hDA : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A := le_trans le_sup_right hPhi
  -- `A` is homocyclic, and every `ξ`-invariant subgroup of `A` is a power subgroup
  obtain ⟨e, -, -, htop, hsub⟩ := homogeneous_structure h hA.abelian hA.map_eq
  have hZleA : Subgroup.center P ≤ A := center_le_of_maximal h hA hmax
  obtain ⟨i, hi⟩ := hsub (Subgroup.center P) hZleA (center_map_xi h)
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · -- `Z(P) = A`: in particular every square of `P` is central, and Gorenstein–Thompson
    -- (with `⁅P,P⁆ ≤ Ω₁(P)`) forces `Z(P) ≤ Ω₁(P)`
    have hZA : Subgroup.center P = A := by rw [hi, hi0, pow_zero, powSub_one_eq]
    have hsqZ : ∀ x : P, x ^ 2 ∈ Subgroup.center P := by
      intro x
      rw [hZA]
      exact hsqA x
    have hP'Z : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P := by
      rw [hZA]
      exact hDA
    -- class two: commutators are involutions
    have hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P := by
      rw [Subgroup.commutator_le]
      intro x _ y _
      have h1 : ⁅x, y⁆ ^ 2 = ⁅x ^ 2, y⁆ := commutator_sq_eq hP'Z x y
      have h2 : ⁅x ^ 2, y⁆ = 1 :=
        (commutator_eq_one_iff (x ^ 2) y).mpr ((Subgroup.mem_center_iff.mp (hsqZ x) y).symm)
      exact h.mem_omega1.mpr (by rw [h1, h2])
    exact center_le_omega1_of_comm_le h hcomm
  · -- `Z(P) ≤ A ^ 2 ≤ Ω₁(P)`, because `A` has exponent dividing `4`
    have hZleA2 : Subgroup.center P ≤ powSub A 2 := by
      rw [hi]
      exact powSub_le_of_dvd hA.abelian ⟨2 ^ (i - 1), by rw [← pow_succ']; congr 1; omega⟩
    have hA2le : powSub A 2 ≤ omega1 P := by
      intro a ha
      obtain ⟨b, hb, rfl⟩ := (mem_powSub_iff hA.abelian).mp ha
      refine h.mem_omega1.mpr ?_
      have hmem : b ^ 4 ∈ powSub A 4 := pow_mem_powSub hb
      rw [hA4] at hmem
      have hb4 : b ^ 4 = 1 := by simpa using hmem
      calc (b ^ 2) ^ 2 = b ^ (2 * 2) := (pow_mul b 2 2).symm
        _ = b ^ 4 := by norm_num
        _ = 1 := hb4
    exact fun z hz => hA2le (hZleA2 hz)

end Work.Higman
