namespace Work.Higman.Layers

open Polynomial

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]

/-- **The minimal polynomial of a "simple" endomorphism is irreducible.**

If the only `T`-invariant subspaces of the finite non-trivial `𝔽₂`-space `V` are `⊥` and `⊤`
(i.e. `V` is a simple `𝔽₂[X]`-module with `X ↦ T`), then `minpoly 𝔽₂ T` is irreducible.

Indeed a non-trivial factorisation `m = f * g` gives `aeval T f * aeval T g = 0` with both
factors non-zero, so `ker (aeval T f)` is a `T`-invariant subspace which is neither `⊥` (else
`aeval T f` is injective and forces `aeval T g = 0`) nor `⊤` (else `aeval T f = 0`). -/
theorem irreducible_minpoly_of_no_invariant [Nontrivial V] (T : V →ₗ[ZMod 2] V)
    (hirr : ∀ U : Submodule (ZMod 2) V, (∀ u ∈ U, T u ∈ U) → U = ⊥ ∨ U = ⊤) :
    Irreducible (minpoly (ZMod 2) T) := by
  classical
  have hint : IsIntegral (ZMod 2) T := IsIntegral.of_finite (ZMod 2) T
  have hmonic : (minpoly (ZMod 2) T).Monic := minpoly.monic hint
  rw [Polynomial.Monic.irreducible_iff_natDegree hmonic]
  refine ⟨minpoly.ne_one (ZMod 2) T, ?_⟩
  intro f g hf hg hfg
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨hfdeg, hgdeg⟩ := hcon
  have hfne : f ≠ 0 := hf.ne_zero
  have hgne : g ≠ 0 := hg.ne_zero
  have hdeg : (minpoly (ZMod 2) T).natDegree = f.natDegree + g.natDegree := by
    rw [← hfg, hf.natDegree_mul hg]
  have hfaeval : Polynomial.aeval T f ≠ 0 := by
    intro hzero
    have hdvd : minpoly (ZMod 2) T ∣ f := minpoly.dvd_iff.mpr hzero
    have hle := Polynomial.natDegree_le_of_dvd hdvd hfne
    omega
  have hgaeval : Polynomial.aeval T g ≠ 0 := by
    intro hzero
    have hdvd : minpoly (ZMod 2) T ∣ g := minpoly.dvd_iff.mpr hzero
    have hle := Polynomial.natDegree_le_of_dvd hdvd hgne
    omega
  have hprod : Polynomial.aeval T f * Polynomial.aeval T g = 0 := by
    rw [← Polynomial.aeval_mul, hfg]
    exact minpoly.aeval (ZMod 2) T
  have hcomm : Polynomial.aeval T f * T = T * Polynomial.aeval T f := by
    have h1 : Polynomial.aeval T (f * (Polynomial.X : Polynomial (ZMod 2))) =
              Polynomial.aeval T ((Polynomial.X : Polynomial (ZMod 2)) * f) := by
      rw [mul_comm]
    rw [Polynomial.aeval_mul, Polynomial.aeval_mul] at h1
    rw [Polynomial.aeval_X] at h1
    exact h1
  have hker_bot : LinearMap.ker (Polynomial.aeval T f) ≠ ⊥ := by
    intro hk
    have hinj : Function.Injective (Polynomial.aeval T f) := LinearMap.ker_eq_bot.mp hk
    have hgz : Polynomial.aeval T g = 0 := by
      ext v
      apply hinj
      have hp := congrArg (fun e : Module.End (ZMod 2) V => e v) hprod
      rw [Module.End.mul_apply] at hp
      simpa using hp
    exact hgaeval hgz
  have hker_top : LinearMap.ker (Polynomial.aeval T f) ≠ ⊤ := by
    intro hk
    have hz : Polynomial.aeval T f = 0 := by
      ext v
      have hv : v ∈ LinearMap.ker (Polynomial.aeval T f) := by rw [hk]; exact Submodule.mem_top
      exact LinearMap.mem_ker.mp hv
    exact hfaeval hz
  have hinv : ∀ v ∈ LinearMap.ker (Polynomial.aeval T f),
      T v ∈ LinearMap.ker (Polynomial.aeval T f) := by
    intro v hv
    rw [LinearMap.mem_ker] at hv ⊢
    have hcv : (Polynomial.aeval T f * T) v = (T * Polynomial.aeval T f) v := by rw [hcomm]
    rw [Module.End.mul_apply, Module.End.mul_apply, hv, map_zero] at hcv
    exact hcv
  rcases hirr (LinearMap.ker (Polynomial.aeval T f)) hinv with h | h
  · exact hker_bot h
  · exact hker_top h

/-- **The dimension of a "simple" `𝔽₂[T]`-module is `natDegree (minpoly 𝔽₂ T)`.**

If the only `T`-invariant subspaces are `⊥` and `⊤`, then `V` is a simple module over the PID
`𝔽₂[X]` (with `X ↦ T`); it is therefore a quotient of `𝔽₂[X]` by its annihilator, which is the
ideal generated by the minimal polynomial of `T`.  -/
theorem natDegree_minpoly_eq_finrank_of_no_invariant [Nontrivial V] (T : V →ₗ[ZMod 2] V)
    (hirr : ∀ U : Submodule (ZMod 2) V, (∀ u ∈ U, T u ∈ U) → U = ⊥ ∨ U = ⊤) :
    (minpoly (ZMod 2) T).natDegree = Module.finrank (ZMod 2) V := by
  let K := ZMod 2
  let R := Polynomial K
  have hsimple : IsSimpleModule R (Module.AEval' T) := by
    have : Nontrivial (Module.AEval' T) := inferInstanceAs (Nontrivial V)
    rw [isSimpleModule_iff]
    refine IsSimpleOrder.mk ?_
    intro N
    -- The underlying `K`-subspace of a `K[X]`-submodule is `T`-invariant.
    have hinv : ∀ v ∈ (N.restrictScalars K : Submodule K (Module.AEval' T)),
        T v ∈ (N.restrictScalars K : Submodule K (Module.AEval' T)) := by
      intro v hv
      have hvN : v ∈ N := (Submodule.restrictScalars_mem K N v).mp hv
      have h := N.smul_mem (Polynomial.X : R) hvN
      have h2 : (Polynomial.X : R) • v = T v := Module.AEval'.X_smul_of T v
      have haN : T v ∈ N := by rwa [h2] at h
      exact (Submodule.restrictScalars_mem K N (T v)).mpr haN
    rcases hirr (N.restrictScalars K) hinv with h | h
    · left
      rw [Submodule.eq_bot_iff]
      intro v hv
      have hvK : v ∈ (N.restrictScalars K : Submodule K (Module.AEval' T)) :=
        (Submodule.restrictScalars_mem K N v).mpr hv
      rw [h] at hvK
      exact (Submodule.mem_bot K).mp hvK
    · right
      rw [Submodule.eq_top_iff']
      intro v
      have hvK : v ∈ (N.restrictScalars K : Submodule K (Module.AEval' T)) := by
        rw [h]; trivial
      exact (Submodule.restrictScalars_mem K N v).mp hvK
  -- A simple module over a commutative ring is a quotient of the ring by its annihilator, and
  -- the annihilator of `AEval' T` is generated by the minimal polynomial.
  obtain ⟨I, _hImax, ⟨e⟩⟩ := isSimpleModule_iff_quot_maximal.mp hsimple
  have hann : Module.annihilator R (Module.AEval' T) = I := by
    rw [e.annihilator_eq, Ideal.annihilator_quotient]
  have hI : I = Ideal.span {minpoly K T} := by
    rw [← hann, ← Polynomial.span_minpoly_eq_annihilator K T]
  calc (minpoly K T).natDegree
      = Module.finrank K (R ⧸ Ideal.span {minpoly K T}) := by
        rw [finrank_quotient_span_eq_natDegree]
    _ = Module.finrank K (R ⧸ I) := by rw [hI]
    _ = Module.finrank K (Module.AEval' T) := ((e.restrictScalars K).finrank_eq).symm
    _ = Module.finrank K V := ((Module.AEval'.of T).finrank_eq).symm

/-- **If the only invariant subspaces of `V` are `⊥` and `⊤` and `T ^ (2 ^ n - 1) = 1`, then
`n` is divisible by `finrank V`.**

Indeed `minpoly T` is irreducible (previous lemma), has degree `finrank V` (previous lemma) and
divides `X ^ (2 ^ n - 1) - 1`; an irreducible factor of `X ^ (2 ^ n - 1) - 1` over `𝔽₂` has
degree dividing `n` (`Work.Higman.Q3.irred_natDegree_dvd_of_dvd_X_pow_sub_one`). -/
theorem finrank_dvd_of_no_invariant [Nontrivial V] (T : V →ₗ[ZMod 2] V) {n : ℕ} (hn : 1 ≤ n)
    (hT : T ^ (2 ^ n - 1) = 1)
    (hirr : ∀ U : Submodule (ZMod 2) V, (∀ u ∈ U, T u ∈ U) → U = ⊥ ∨ U = ⊤) :
    Module.finrank (ZMod 2) V ∣ n := by
  have hdiv : minpoly (ZMod 2) T ∣ Polynomial.X ^ (2 ^ n - 1) - 1 := by
    apply minpoly.dvd
    rw [map_sub, map_pow, aeval_X, map_one, hT, sub_self]
  have hdeg := natDegree_minpoly_eq_finrank_of_no_invariant T hirr
  have hμirr := irreducible_minpoly_of_no_invariant T hirr
  have h :=
    Work.Higman.Q3.irred_natDegree_dvd_of_dvd_X_pow_sub_one (minpoly (ZMod 2) T) hμirr hdiv
  rwa [hdeg] at h

/-- `V` is not `σ`-irreducible: there is a non-zero, proper `σ`-invariant subspace.

If every invariant subspace were `⊥` or `⊤`, then `V` would be a simple `𝔽₂[X]`-module (with
`X ↦ σ`), so its minimal polynomial would be irreducible of degree `finrank V = 2 * n` and would
divide `X ^ (2 ^ n - 1) - 1`; the finite-field lemma
`Work.Higman.Q3.irred_natDegree_dvd_of_dvd_X_pow_sub_one` says its degree divides `n`, whence
`2 * n ∣ n`, impossible since `1 ≤ n`.

Note that `Work.Higman.Q3.false_of_irreducible_pow_eq_self` in
`Submission.Work.Higman.Q3.exists_invariant_decomposition` is exactly this contradiction
(it needs `T ^ 2 ^ n = T`, which follows from `orderOf σ = 2 ^ n - 1` and `1 ≤ n`). -/
theorem exists_isInv_ne_bot_ne_top {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    {σ : V →ₗ[ZMod 2] V} {n : ℕ} (hn : 1 ≤ n) (hcard : Nat.card V = 2 ^ (2 * n))
    (horder : orderOf σ = 2 ^ n - 1) :
    ∃ U : Submodule (ZMod 2) V, Work.Higman.Layers.IsInv σ U ∧ U ≠ ⊥ ∧ U ≠ ⊤ := by
  by_contra hcon
  have hnpos : 0 < n := hn
  -- `σ ^ (2 ^ n - 1) = 1`
  have hT1 : σ ^ (2 ^ n - 1) = 1 := by
    rw [← horder]
    exact pow_orderOf_eq_one σ
  -- `V` is non-trivial because `|V| = 2 ^ (2 * n) ≥ 4`
  haveI : Nontrivial V := by
    have h4 : 1 < Nat.card V := by
      rw [hcard]
      calc 1 < 2 ^ 2 := by norm_num
        _ ≤ 2 ^ (2 * n) := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact Finite.one_lt_card_iff_nontrivial.mp h4
  -- if there is no non-zero proper invariant subspace, every invariant subspace is `⊥` or `⊤`
  have hirr : ∀ U : Submodule (ZMod 2) V,
      (∀ v ∈ U, σ v ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    by_cases h1 : U = ⊥
    · exact Or.inl h1
    · by_cases h2 : U = ⊤
      · exact Or.inr h2
      · exact absurd ⟨U, hU, h1, h2⟩ hcon
  -- `finrank V = 2 * n`
  have hfinV : Module.finrank (ZMod 2) V = 2 * n := by
    have hv : Nat.card V = 2 ^ Module.finrank (ZMod 2) V := by
      rw [Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)]
      norm_num
    have h : 2 ^ (2 * n) = 2 ^ Module.finrank (ZMod 2) V := by rw [← hv, hcard]
    exact (Nat.pow_right_injective (le_refl 2) h).symm
  -- but `finrank V ∣ n` and `finrank V = 2 * n > n`
  have hdvd : Module.finrank (ZMod 2) V ∣ n :=
    finrank_dvd_of_no_invariant σ hn hT1 hirr
  have hle : Module.finrank (ZMod 2) V ≤ n := Nat.le_of_dvd hnpos hdvd
  omega

end Work.Higman.Layers
