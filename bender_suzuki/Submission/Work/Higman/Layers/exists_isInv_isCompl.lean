namespace Work.Higman.Layers

/-- In a `ZMod 2`-module an odd multiple of a vector is the vector itself. -/
theorem zmod2_nsmul_eq_of_odd {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] {D : ℕ}
    (hD : Odd D) (v : V) : D • v = v := by
  have h : (D : ZMod 2) = ((1 : ℕ) : ZMod 2) := by
    rw [ZMod.natCast_eq_natCast_iff']
    rw [Nat.odd_iff.mp hD]
  rw [← Nat.cast_smul_eq_nsmul (ZMod 2) D v, h, Nat.cast_one, one_smul]

/-- **Invariant complements (Maschke for odd order).**  If `σ ^ D = 1` with `D` odd, then every
`σ`-invariant subspace `C` has a `σ`-invariant complement: averaging an arbitrary projection onto
`C` over the cyclic group generated by `σ` (of odd order dividing `D`, so that `1/D = 1` in
characteristic two) gives an equivariant projection whose kernel is the complement.

A proof template (in the `AddSubgroup`/`AddExpTwo` setting, with `τ : V ≃+ V` and `τ^[D] = id`)
is `Work.Higman.Q3.exists_invariant_complement` in
`Submission.Work.Higman.Q3.exists_invariant_decomposition`; here one needs the `Submodule` form,
and `σ ^ D = 1` implies `σ` is bijective (inverse `σ ^ (D - 1)`). -/
theorem exists_isInv_isCompl {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    {σ : V →ₗ[ZMod 2] V} {D : ℕ} (hD : Odd D) (hσD : σ ^ D = 1)
    {C : Submodule (ZMod 2) V} (hC : Work.Higman.Layers.IsInv σ C) :
    ∃ C' : Submodule (ZMod 2) V,
      Work.Higman.Layers.IsInv σ C' ∧ C ⊓ C' = ⊥ ∧ C ⊔ C' = ⊤ := by
  classical
  have hDpos : 0 < D := by obtain ⟨e, he⟩ := hD; omega
  -- `σ` is invertible, with inverse `σ ^ (D - 1)`.
  let σinv : V →ₗ[ZMod 2] V := σ ^ (D - 1)
  have hσinv_eq : σinv = σ ^ (D - 1) := rfl
  have hσinvσ : σinv * σ = 1 := by
    rw [hσinv_eq, ← pow_succ, Nat.sub_add_cancel hDpos]
    exact hσD
  have hσσinv : σ * σinv = 1 := by
    rw [hσinv_eq, ← pow_succ', Nat.sub_add_cancel hDpos]
    exact hσD
  have hσinvD : σinv ^ D = 1 := by
    rw [hσinv_eq, ← pow_mul, show (D - 1) * D = D * (D - 1) from by ring, pow_mul, hσD,
      one_pow]
  have hcomm : Commute σ σinv := hσσinv.trans hσinvσ.symm
  have hmulpow : ∀ k : ℕ, (σ ^ k) * (σinv ^ k) = 1 := fun k => by
    rw [(hcomm.mul_pow k).symm, hσσinv, one_pow]
  -- `C` is invariant under all the powers of `σ` and of `σ⁻¹`.
  have hCpow : ∀ k : ℕ, IsInv (σ ^ k) C := by
    intro k
    induction k with
    | zero => intro v hv; simpa using hv
    | succ k ih =>
      intro v hv
      rw [pow_succ', Module.End.mul_apply]
      exact hC _ (ih v hv)
  have hCinvpow : ∀ k : ℕ, IsInv (σinv ^ k) C := by
    intro k v hv
    have h : σinv ^ k = σ ^ ((D - 1) * k) := by rw [hσinv_eq, ← pow_mul]
    rw [h]
    exact hCpow ((D - 1) * k) v hv
  -- an arbitrary linear projection onto `C`
  obtain ⟨W, hW⟩ := Submodule.exists_isCompl C
  let π₀ : V →ₗ[ZMod 2] V := C.projection W hW
  have hπ₀mem : ∀ v : V, π₀ v ∈ C := fun v => Submodule.projection_apply_mem hW v
  have hπ₀id : ∀ u : V, u ∈ C → π₀ u = u :=
    fun u hu => Submodule.projection_apply_of_mem_left hW hu
  -- the averaged projection
  let P : V →ₗ[ZMod 2] V := ∑ k ∈ Finset.range D, σ ^ k * (π₀ * σinv ^ k)
  have hPdef : P = ∑ k ∈ Finset.range D, σ ^ k * (π₀ * σinv ^ k) := rfl
  have hPapply : ∀ v : V, P v = ∑ k ∈ Finset.range D, (σ ^ k) (π₀ ((σinv ^ k) v)) := by
    intro v
    rw [hPdef, LinearMap.sum_apply]
    exact Finset.sum_congr rfl fun k _ => by rw [Module.End.mul_apply, Module.End.mul_apply]
  have hPmem : ∀ v : V, P v ∈ C := by
    intro v
    rw [hPapply]
    exact Submodule.sum_mem _ fun k _ => hCpow k _ (hπ₀mem _)
  have hPid : ∀ u : V, u ∈ C → P u = u := by
    intro u hu
    have hterm : ∀ k ∈ Finset.range D, (σ ^ k) (π₀ ((σinv ^ k) u)) = u := by
      intro k _
      have h2 : (σ ^ k) ((σinv ^ k) u) = u := by
        rw [← Module.End.mul_apply, hmulpow k, Module.End.one_apply]
      rw [hπ₀id _ (hCinvpow k u hu), h2]
    have hsum : (∑ _ ∈ Finset.range D, (u : V)) = D • u := by
      rw [Finset.sum_const (b := u), Finset.card_range]
    rw [hPapply, Finset.sum_congr rfl hterm, hsum]
    exact zmod2_nsmul_eq_of_odd hD u
  have hPcomm : P * σ = σ * P := by
    have h := cyclic_average_comm (a := σ) (b := σinv) (p := π₀) hDpos hσD hσinvD hσinvσ
    rw [← hPdef] at h
    exact h
  obtain ⟨hinv, hdisj, hsup⟩ :=
    ker_projection_isInv_isCompl (σ := σ) (P := P) (C := C) hPcomm hPmem hPid
  exact ⟨LinearMap.ker P, hinv, hdisj, hsup⟩

end Work.Higman.Layers
