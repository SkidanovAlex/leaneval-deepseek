# The minimal annihilator of a cyclic vector

For a non-zero vector `v` of a finite `𝔽₂`-space `V` with an endomorphism `σ`, the set of
polynomials `g` with `g(σ) v = 0` is generated by a polynomial `f` (`f ≠ 0`, necessarily monic
over `𝔽₂`), and `f.natDegree = finrank (cycSpan σ v)`: the `𝔽₂[σ]`-span of `v` is cyclic of
dimension `deg f`.
-/

import Mathlib
import Submission.Work.Higman.Layers.Defs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1600000

noncomputable section

namespace Work.Higman.Layers

open Polynomial

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]

theorem exists_minpoly_vec {σ : V →ₗ[ZMod 2] V} {v : V} (hv : v ≠ 0) :
    ∃ f : Polynomial (ZMod 2), f ≠ 0 ∧ (Polynomial.aeval σ f) v = 0 ∧
      (∀ g : Polynomial (ZMod 2), (Polynomial.aeval σ g) v = 0 ↔ f ∣ g) ∧
      f.natDegree = Module.finrank (ZMod 2) (cycSpan σ v) := by
  classical
  -- the annihilator ideal of `v`
  let I : Ideal (Polynomial (ZMod 2)) :=
    { carrier := {g | (aeval σ g) v = 0}
      zero_mem' := by simp
      add_mem' := by
        intro g h hg hh
        simp only [Set.mem_ofPred_eq] at hg hh ⊢
        rw [map_add]
        simp [hg, hh]
      smul_mem' := by
        intro c g hg
        simp only [Set.mem_ofPred_eq] at hg ⊢
        rw [smul_eq_mul, map_mul]
        rw [show ((aeval σ c) * (aeval σ g)) v = (aeval σ c) ((aeval σ g) v) from rfl, hg,
          map_zero] }
  haveI : I.IsPrincipal := IsPrincipalIdealRing.principal I
  set f : Polynomial (ZMod 2) := Submodule.IsPrincipal.generator I with hfdef
  have hspan : Ideal.span {f} = I := Submodule.IsPrincipal.span_singleton_generator I
  have hdiv : ∀ g : Polynomial (ZMod 2), (aeval σ g) v = 0 ↔ f ∣ g := by
    intro g
    rw [show ((aeval σ g) v = 0) ↔ g ∈ I from Iff.rfl, ← hspan, Ideal.mem_span_singleton]
  have hI : I ≠ ⊥ := by
    intro hbot
    haveI : Fintype V := Fintype.ofFinite V
    obtain ⟨i, j, hij, hijk⟩ := Fintype.exists_ne_map_eq_of_card_lt
      (fun k : Fin (Nat.card V + 1) => (σ ^ (k : ℕ)) v) (by simp)
    have hneq : (X : Polynomial (ZMod 2)) ^ (i : ℕ) - X ^ (j : ℕ) ≠ 0 := by
      intro hcon
      refine hij (Fin.ext ?_)
      have h2 := congrArg Polynomial.natDegree (sub_eq_zero.mp hcon)
      rwa [Polynomial.natDegree_X_pow, Polynomial.natDegree_X_pow] at h2
    have hmem : (X : Polynomial (ZMod 2)) ^ (i : ℕ) - X ^ (j : ℕ) ∈ I := by
      show (aeval σ (X ^ (i : ℕ) - X ^ (j : ℕ))) v = 0
      rw [map_sub, aeval_X_pow, aeval_X_pow, LinearMap.sub_apply, sub_eq_zero]
      exact hijk
    rw [hbot] at hmem
    exact hneq (by simpa using hmem)
  have hf0 : f ≠ 0 := by
    intro h0
    exact hI (by rw [← hspan, h0]; exact Ideal.span_singleton_eq_bot.mpr rfl)
  have hfv : (aeval σ f) v = 0 := (hdiv f).mpr (dvd_refl f)
  have hf1 : f ≠ 1 := by
    intro h1
    rw [h1] at hfv
    exact hv (by simpa using hfv)
  have hfmonic : f.Monic := by
    show f.leadingCoeff = 1
    have hne : f.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hf0
    revert hne
    generalize f.leadingCoeff = a
    intro ha
    fin_cases a
    · exact absurd rfl ha
    · rfl
  -- the evaluation map
  let Φ : Polynomial (ZMod 2) →ₗ[ZMod 2] V :=
    { toFun := fun g => (aeval σ g) v
      map_add' := by
        intro g h
        rw [map_add]
        rfl
      map_smul' := by
        intro c g
        rw [map_smul]
        rfl }
  have hΦ : ∀ g : Polynomial (ZMod 2), Φ g = (aeval σ g) v := fun g => rfl
  have hker : ∀ g : Polynomial (ZMod 2), Φ g = 0 ↔ f ∣ g := fun g => by
    rw [hΦ g]; exact hdiv g
  have hrange : Φ.range = cycSpan σ v := by
    rw [cycSpan]
    refine le_antisymm ?_ ?_
    · rintro x ⟨g, rfl⟩
      rw [hΦ, aeval_eq_sum_range]
      rw [show (∑ i ∈ Finset.range (g.natDegree + 1), g.coeff i • (σ ^ i : Module.End (ZMod 2) V)) v
          = ∑ i ∈ Finset.range (g.natDegree + 1), g.coeff i • ((σ ^ i) v) by
        simp]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · rw [Submodule.span_le]
      rintro x ⟨k, rfl⟩
      exact ⟨X ^ k, by rw [hΦ, aeval_X_pow]⟩
  have hsmall : ∀ g : Polynomial (ZMod 2),
      ∃ r : Polynomial (ZMod 2), r.natDegree < f.natDegree ∧ Φ r = Φ g := by
    intro g
    refine ⟨g %ₘ f, natDegree_modByMonic_lt g hfmonic hf1, ?_⟩
    have h3 : (aeval σ (f * (g /ₘ f))) v = 0 :=
      (hdiv _).mpr (dvd_mul_right f (g /ₘ f))
    have h5 : (aeval σ (g %ₘ f)) v + (aeval σ (f * (g /ₘ f))) v = (aeval σ g) v := by
      have h6 := congrArg (fun p : Polynomial (ZMod 2) => (aeval σ p) v) (modByMonic_add_div g f)
      simpa [map_add] using h6
    rw [h3, add_zero] at h5
    rw [hΦ, hΦ]
    exact h5
  have hker_bot : ∀ r : Polynomial (ZMod 2), r.natDegree < f.natDegree → Φ r = 0 → r = 0 := by
    intro r hr h0
    have h1 : f ∣ r := (hker r).mp h0
    by_contra hr0
    have h2 := natDegree_le_of_dvd h1 hr0
    omega
  -- the dimension count
  have hfin : f.natDegree = Module.finrank (ZMod 2) (cycSpan σ v) := by
    have hmemdeg : ∀ r : Polynomial (ZMod 2), r.natDegree < f.natDegree →
        r ∈ Polynomial.degreeLT (ZMod 2) f.natDegree := by
      intro r hr
      rw [Polynomial.mem_degreeLT]
      rcases eq_or_ne r 0 with h0 | h0
      · rw [h0, Polynomial.degree_zero]
        rw [WithBot.bot_lt_iff_ne_bot]
        have hr' : 0 < f.natDegree := by
          rw [h0, Polynomial.natDegree_zero] at hr
          exact hr
        simpa using hr'.ne'
      · exact (Polynomial.natDegree_lt_iff_degree_lt h0).mp hr
    let ψ : Polynomial.degreeLT (ZMod 2) f.natDegree →ₗ[ZMod 2] V :=
      Φ.comp (Polynomial.degreeLT (ZMod 2) f.natDegree).subtype
    have hrangeψ : ψ.range = cycSpan σ v := by
      rw [← hrange]
      refine le_antisymm ?_ ?_
      · rintro x ⟨g, rfl⟩
        exact ⟨(g : Polynomial (ZMod 2)), rfl⟩
      · rintro x ⟨g, rfl⟩
        obtain ⟨r, hr, hre⟩ := hsmall g
        exact ⟨⟨r, hmemdeg r hr⟩, hre⟩
    have hinj : Function.Injective ψ := by
      intro a b hab
      have h1 : Φ ((a : Polynomial (ZMod 2)) - (b : Polynomial (ZMod 2))) = 0 := by
        have hab' : Φ (a : Polynomial (ZMod 2)) = Φ (b : Polynomial (ZMod 2)) := hab
        rw [map_sub, hab', sub_self]
      rcases eq_or_ne ((a : Polynomial (ZMod 2)) - (b : Polynomial (ZMod 2))) 0 with h | h
      · exact Subtype.ext (sub_eq_zero.mp h)
      · have ha := a.2
        have hb := b.2
        rw [Polynomial.mem_degreeLT] at ha hb
        have h2 : ((a : Polynomial (ZMod 2)) - (b : Polynomial (ZMod 2))).natDegree <
            f.natDegree := by
          rw [Polynomial.natDegree_lt_iff_degree_lt h]
          exact lt_of_le_of_lt (Polynomial.degree_sub_le _ _) (max_lt ha hb)
        exact Subtype.ext (sub_eq_zero.mp (hker_bot _ h2 h1))
    have h4 : Module.finrank (ZMod 2) (cycSpan σ v) =
        Module.finrank (ZMod 2) (Polynomial.degreeLT (ZMod 2) f.natDegree) := by
      rw [← hrangeψ]
      exact (LinearEquiv.ofInjective ψ hinj).finrank_eq.symm
    rw [h4, (Polynomial.degreeLTEquiv (ZMod 2) f.natDegree).finrank_eq]
    simp [Module.finrank_fin_fun]
  exact ⟨f, hf0, hfv, hdiv, hfin⟩

end Work.Higman.Layers
