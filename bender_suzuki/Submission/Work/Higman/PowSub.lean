import Mathlib
import Submission.Work.Higman.Defs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.Higman

variable {P : Type} [Group P]

/-- `A ^ (n)` -- the subgroup generated by the `n`-th powers of the elements of `A`.
For abelian `A` this is the set of `n`-th powers of elements of `A` (`mem_powSub_iff`). -/
def powSub (A : Subgroup P) (n : ℕ) : Subgroup P :=
  Subgroup.closure {y : P | ∃ x ∈ A, x ^ n = y}

theorem mem_powSub {A : Subgroup P} {n : ℕ} {y : P} :
    y ∈ powSub A n ↔ y ∈ Subgroup.closure {y : P | ∃ x ∈ A, x ^ n = y} := Iff.rfl

theorem pow_mem_powSub {A : Subgroup P} {n : ℕ} {x : P} (hx : x ∈ A) :
    x ^ n ∈ powSub A n := Subgroup.subset_closure ⟨x, hx, rfl⟩

/-- If `A` is abelian the set of `n`-th powers of its elements is already a subgroup. -/
theorem mem_powSub_iff {A : Subgroup P} (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) {n : ℕ}
    {y : P} : y ∈ powSub A n ↔ ∃ x ∈ A, x ^ n = y := by
  constructor
  · intro hy
    induction hy using Subgroup.closure_induction with
    | mem y hy => exact hy
    | one => exact ⟨1, A.one_mem, one_pow n⟩
    | mul u v hu hv ihu ihv =>
        obtain ⟨x, hx, rfl⟩ := ihu
        obtain ⟨z, hz, rfl⟩ := ihv
        exact ⟨x * z, A.mul_mem hx hz, Commute.mul_pow (hab x hx z hz) n⟩
    | inv u hu ihu =>
        obtain ⟨x, hx, rfl⟩ := ihu
        exact ⟨x⁻¹, A.inv_mem hx, by rw [inv_pow]⟩
  · rintro ⟨x, hx, rfl⟩
    exact pow_mem_powSub hx

theorem powSub_zero (A : Subgroup P) : powSub A 0 = ⊥ := by
  rw [powSub]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    simp
  · exact bot_le

theorem powSub_le {A : Subgroup P} {n : ℕ} (hn : 0 < n) : powSub A n ≤ A := by
  rw [powSub, Subgroup.closure_le]
  rintro y ⟨x, hx, rfl⟩
  exact Subgroup.pow_mem A hx n

theorem powSub_mono {A B : Subgroup P} {n : ℕ} (h : A ≤ B) : powSub A n ≤ powSub B n := by
  rw [powSub, powSub, Subgroup.closure_le]
  rintro y ⟨x, hx, rfl⟩
  exact Subgroup.subset_closure ⟨x, h hx, rfl⟩

/-- The inverse image of an invariant subgroup is itself. -/
theorem symm_mem_of_map_eq (φ : MulAut P) {A : Subgroup P}
    (hinv : A.map (φ : MulAut P).toMonoidHom = A) {x : P} (hx : x ∈ A) :
    (φ : MulAut P).symm x ∈ A := by
  have h1 : x ∈ A.map (φ : MulAut P).toMonoidHom := by rw [hinv]; exact hx
  obtain ⟨y, hy, hyx⟩ := h1
  have h2 : (φ : MulAut P).symm x = y := by rw [← hyx]; simp
  rwa [h2]

/-- The `n`-th power subgroup is invariant under an automorphism preserving `A`. -/
theorem map_powSub (φ : MulAut P) {A : Subgroup P}
    (hinv : A.map (φ : MulAut P).toMonoidHom = A) (n : ℕ) :
    (powSub A n).map (φ : MulAut P).toMonoidHom = powSub A n := by
  let f : P →* P := (φ : MulAut P).toMonoidHom
  change (powSub A n).map f = powSub A n
  have hmap : A.map f = A := hinv
  have hA : ∀ x : P, x ∈ A → f x ∈ A := by
    intro x hx
    have h := Subgroup.mem_map_of_mem (f := f) hx
    rwa [hmap] at h
  have hsymm : ∀ x : P, x ∈ A → (φ : MulAut P).symm x ∈ A := fun x hx =>
    symm_mem_of_map_eq φ hinv hx
  apply le_antisymm
  · rw [powSub, Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    exact Subgroup.subset_closure ⟨f x, hA x hx, by rw [map_pow]⟩
  · rw [powSub, Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    have hx' : (φ : MulAut P).symm x ∈ A := hsymm x hx
    have h2 : f ((φ : MulAut P).symm x ^ n) ∈ (powSub A n).map f :=
      Subgroup.mem_map_of_mem (f := f) (pow_mem_powSub hx')
    rw [map_pow] at h2
    have h3 : (f ((φ : MulAut P).symm x)) = x := by
      change (φ : MulAut P) ((φ : MulAut P).symm x) = x
      exact MulEquiv.apply_symm_apply (φ : MulAut P) x
    rw [h3] at h2
    exact h2

end Work.Higman
