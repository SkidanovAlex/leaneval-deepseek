open LeanEval.GroupTheory.Defs

variable {P : Type} [Group P] [Finite P]

/-- The subgroup of `MulAut P` of automorphisms fixing `Ω₁(P)` pointwise. -/
def omega1Fixer (P : Type) [Group P] : Subgroup (MulAut P) where
  carrier := {φ : MulAut P | ∀ z : P, z ∈ omega1 P → φ z = z}
  one_mem' := fun _ _ => rfl
  mul_mem' := by
    intro φ ψ hφ hψ z hz
    show (φ * ψ) z = z
    rw [MulAut.mul_apply, hψ z hz, hφ z hz]
  inv_mem' := by
    intro φ hφ z hz
    show (φ : MulAut P)⁻¹ z = z
    calc (φ : MulAut P)⁻¹ z = (φ : MulAut P)⁻¹ ((φ : MulAut P) z) := by rw [hφ z hz]
      _ = z := MulEquiv.symm_apply_apply φ z

/-- **Crux (Higman 1963, Theorem 1).**  An automorphism of a Suzuki 2-group fixing `Ω₁(P)`
pointwise has order coprime to the number of involutions. -/
private theorem orderOf_fixes_omega1_coprime (h : IsSuzuki2Grp P) (φ : MulAut P)
    (hφ : ∀ z : P, z ∈ omega1 P → φ z = z) :
    Nat.Coprime (orderOf φ) (Invol P).ncard := by
  sorry

/-- A non-identity element of `Ω₁(P)` has order two. -/
theorem orderOf_eq_two_of_mem_omega1' (h : IsSuzuki2Grp P) {x : P} (hx : x ∈ omega1 P)
    (hx1 : x ≠ 1) : orderOf x = 2 := by
  have hd : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr ((h.mem_omega1).mp hx)
  rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
  · exact absurd (orderOf_eq_one_iff.mp h1) hx1
  · exact h2

/-- The orbit of an involution under the cyclic group generated by `h.xi` is the set of all
involutions. -/
theorem orbit_zpowers_eq_Invol (h : IsSuzuki2Grp P) {x : P} (hx : orderOf x = 2) :
    (MulAction.orbit (Subgroup.zpowers h.xi) x : Set P) = Invol P := by
  ext z
  rw [MulAction.mem_orbit_iff, mem_Invol]
  refine ⟨?_, ?_⟩
  · rintro ⟨ψ, rfl⟩
    show orderOf (ψ • x) = 2
    rw [show ψ • x = (ψ : MulAut P) x from rfl, MulEquiv.orderOf_eq, hx]
  · intro hz
    obtain ⟨k, hk⟩ := h.trans x z hx hz
    exact ⟨⟨h.xi ^ k, Subgroup.pow_mem (Subgroup.zpowers h.xi)
      (Subgroup.mem_zpowers h.xi) k⟩, hk⟩

/-- If an element of `⟨h.xi⟩` fixes one involution it fixes `Ω₁(P)` pointwise. -/
theorem fixes_omega1_of_mem_zpowers_fixes_invol (h : IsSuzuki2Grp P) {z₀ : P}
    (hz₀ : orderOf z₀ = 2) {φ : MulAut P} (hφK : φ ∈ Subgroup.zpowers h.xi)
    (hφz : φ z₀ = z₀) : ∀ w : P, w ∈ omega1 P → φ w = w := by
  intro w hw
  rcases eq_or_ne w 1 with rfl | hw1
  · simp
  · have hw2 : orderOf w = 2 := orderOf_eq_two_of_mem_omega1' h hw hw1
    have hworb : w ∈ MulAction.orbit (Subgroup.zpowers h.xi) z₀ := by
      rw [orbit_zpowers_eq_Invol h hz₀, mem_Invol]; exact hw2
    rw [MulAction.mem_orbit_iff] at hworb
    obtain ⟨ψ, hψw⟩ := hworb
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hφK
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp ψ.2
    have hψz : ψ.1 z₀ = w := hψw
    calc φ w = φ (ψ.1 z₀) := by rw [hψz]
      _ = (φ * ψ.1) z₀ := by rw [MulAut.mul_apply]
      _ = ((h.xi ^ i) * (h.xi ^ j)) z₀ := by rw [← hi, ← hj]
      _ = (h.xi ^ (i + j)) z₀ := by rw [zpow_add]
      _ = (h.xi ^ (j + i)) z₀ := by rw [add_comm]
      _ = ((h.xi ^ j) * (h.xi ^ i)) z₀ := by rw [zpow_add]
      _ = (ψ.1 * φ) z₀ := by rw [← hi, ← hj]
      _ = ψ.1 (φ z₀) := by rw [MulAut.mul_apply]
      _ = ψ.1 z₀ := by rw [hφz]
      _ = w := hψz

theorem xi_regular {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P) :
    ∃ ξ : MulAut P, orderOf ξ = (Work.Higman.Invol P).ncard ∧
      (∀ x y : P, orderOf x = 2 → orderOf y = 2 → ∃ k : ℕ, (ξ ^ k) x = y) ∧
      (∀ x : P, x ≠ 1 → ξ x ≠ x) := by
  classical
  set n : ℕ := (Invol P).ncard with hn
  set g : MulAut P := h.xi with hg
  set m : ℕ := orderOf g with hm
  have hdiv : n ∣ m := by rw [hn, hm, hg]; exact invol_ncard_dvd_orderOf_xi h
  set b : ℕ := m / n with hb
  have hnb : n * b = m := Nat.mul_div_cancel' hdiv
  have hn2 : 2 ≤ n := by
    rw [hn]
    obtain ⟨a, c, ha2, hc2, hac⟩ := h.manyInvol
    have hsub : ({a, c} : Set P) ⊆ Invol P := by
      intro w hw
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
      rcases hw with rfl | rfl
      · exact mem_Invol.mpr ha2
      · exact mem_Invol.mpr hc2
    have hcard : ({a, c} : Set P).ncard = 2 := by
      rw [Set.ncard_insert_of_notMem (by simpa using hac) (Set.toFinite _),
        Set.ncard_singleton]
    calc 2 = ({a, c} : Set P).ncard := hcard.symm
      _ ≤ (Invol P).ncard := Set.ncard_le_ncard hsub (Set.toFinite _)
  have hnpos : 0 < n := by omega
  have hmpos : 0 < m := by
    rw [hm, orderOf_pos_iff]; exact isOfFinOrder_of_finite g
  have hbpos : 0 < b := by rw [hb, Nat.div_pos_iff]; exact ⟨hnpos, Nat.le_of_dvd hmpos hdiv⟩
  obtain ⟨u, hu2⟩ : ∃ u : P, orderOf u = 2 := by
    obtain ⟨a, c, ha2, -, -⟩ := h.manyInvol
    exact ⟨a, ha2⟩
  have horb : (MulAction.orbit (Subgroup.zpowers g) u : Set P) = Invol P := by
    rw [hg]; exact orbit_zpowers_eq_Invol h hu2
  -- `S` is the stabiliser of `u` inside `⟨g⟩`, viewed in `MulAut P`
  set S : Subgroup (MulAut P) :=
    (MulAction.stabilizer (Subgroup.zpowers g) u).map (Subgroup.subtype (Subgroup.zpowers g))
    with hS
  have hScard : Nat.card ↥S = b := by
    rw [hS, Subgroup.card_subtype]
    have hos := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup (Subgroup.zpowers g) u)
    rw [Nat.card_prod, Nat.card_zpowers] at hos
    have horbcard : Nat.card (MulAction.orbit (Subgroup.zpowers g) u) = n := by
      rw [hn, Nat.card_coe_set_eq, horb]
    rw [horbcard] at hos
    exact Nat.mul_left_cancel hnpos (by rw [hos, hnb])
  have hSle : S ≤ omega1Fixer P := by
    intro y hy
    rw [hS, Subgroup.mem_map] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    rw [MulAction.mem_stabilizer_iff] at hx
    exact fixes_omega1_of_mem_zpowers_fixes_invol h hu2 x.2 hx
  have hcop : Nat.Coprime b n := by
    rw [← hScard]
    by_contra hcon
    rw [Nat.Prime.not_coprime_iff_dvd] at hcon
    obtain ⟨p, hp, hpS, hpn⟩ := hcon
    haveI : Fact (Nat.Prime p) := ⟨hp⟩
    obtain ⟨x, hxord⟩ := exists_prime_orderOf_dvd_card' p hpS
    set φ : MulAut P := (x : MulAut P) with hφ
    have hφF : φ ∈ omega1Fixer P := hSle x.2
    have hord : orderOf φ = p := by rw [hφ, Subgroup.orderOf_coe]; exact hxord
    have hc := orderOf_fixes_omega1_coprime h φ hφF
    rw [hord] at hc
    rw [← hn] at hc
    have hp1 : p ∣ 1 := by
      rw [← Nat.Coprime.gcd_eq_one hc]
      exact Nat.dvd_gcd (dvd_refl p) hpn
    exact hp.not_dvd_one hp1
  have hξord : orderOf (g ^ b) = n := by
    rw [orderOf_pow]
    have hbdvd : b ∣ m := ⟨n, by rw [← hnb, mul_comm]⟩
    rw [Nat.gcd_eq_right hbdvd, ← hm, ← hnb, mul_comm n b, Nat.mul_div_right n hbpos]
  -- any element of `⟨g^b⟩` fixing an involution is trivial
  have key : ∀ z : P, orderOf z = 2 → ∀ ψ : MulAut P,
      ψ ∈ Subgroup.zpowers (g ^ b) → ψ z = z → ψ = 1 := by
    intro z hz ψ hψ hfix
    have hψK : ψ ∈ Subgroup.zpowers g :=
      Subgroup.zpowers_le.mpr
        (Subgroup.pow_mem (Subgroup.zpowers g) (Subgroup.mem_zpowers g) b) hψ
    have hfixall := fixes_omega1_of_mem_zpowers_fixes_invol h hz hψK hfix
    have hc := orderOf_fixes_omega1_coprime h ψ hfixall
    rw [← hn] at hc
    have hdvd : orderOf ψ ∣ n := by
      rw [← hξord]
      exact orderOf_dvd_of_mem_zpowers hψ
    have hone : orderOf ψ = 1 := by
      have h1 : orderOf ψ ∣ 1 := by
        rw [← Nat.Coprime.gcd_eq_one hc]
        exact Nat.dvd_gcd (dvd_refl (orderOf ψ)) hdvd
      exact Nat.dvd_one.mp h1
    exact orderOf_eq_one_iff.mp hone
  have hstabbot : ∀ z : P, orderOf z = 2 →
      MulAction.stabilizer (Subgroup.zpowers (g ^ b)) z = ⊥ := by
    intro z hz
    rw [Subgroup.eq_bot_iff_forall]
    intro ψ hψ
    rw [MulAction.mem_stabilizer_iff] at hψ
    have hψz : ψ.1 z = z := hψ
    exact Subtype.ext (key z hz ψ.1 ψ.2 hψz)
  refine ⟨g ^ b, hξord, ?_, ?_⟩
  · intro x y hx2 hy2
    have hxorbit : (MulAction.orbit (Subgroup.zpowers (g ^ b)) x : Set P) = Invol P := by
      refine Set.eq_of_subset_of_ncard_le ?_ ?_ (Set.toFinite _)
      · intro w hw
        rw [MulAction.mem_orbit_iff] at hw
        obtain ⟨ψ, hψw⟩ := hw
        rw [mem_Invol, ← hψw]
        rw [show ψ • x = (ψ : MulAut P) x from rfl, MulEquiv.orderOf_eq, hx2]
      · have hcard : (MulAction.orbit (Subgroup.zpowers (g ^ b)) x).ncard = n := by
          rw [← Nat.card_coe_set_eq]
          have hos := Nat.card_congr
            (MulAction.orbitProdStabilizerEquivGroup (Subgroup.zpowers (g ^ b)) x)
          rw [Nat.card_prod, Nat.card_zpowers, hξord] at hos
          rw [hstabbot x hx2, Subgroup.card_bot, mul_one] at hos
          exact hos
        rw [hcard, hn]
    have hy : y ∈ MulAction.orbit (Subgroup.zpowers (g ^ b)) x := by
      rw [hxorbit]; exact mem_Invol.mpr hy2
    rw [MulAction.mem_orbit_iff] at hy
    obtain ⟨ψ, hψ⟩ := hy
    obtain ⟨k, hk⟩ : ∃ k : ℕ, (g ^ b) ^ k = ψ.1 := by
      have hfin := isOfFinOrder_of_finite (g ^ b)
      have h2 := (IsOfFinOrder.mem_zpowers_iff_mem_range_orderOf hfin).mp ψ.2
      rcases Finset.mem_image.mp h2 with ⟨k, -, hk⟩
      exact ⟨k, hk⟩
    exact ⟨k, by rw [hk]; exact hψ⟩
  · intro x hx1 hfix
    obtain ⟨k, hk⟩ := h.isPGroup.exists_orderOf_eq_pow x
    have hk1 : 1 ≤ k := by
      rcases Nat.eq_zero_or_pos k with h0 | hpos
      · exfalso; rw [h0] at hk; simp at hk
        exact hx1 hk
      · exact hpos
    set z : P := x ^ 2 ^ (k - 1) with hz
    have hzord : orderOf z = 2 := by
      rw [hz, orderOf_pow, hk]
      have hgcd : (2 ^ k).gcd (2 ^ (k - 1)) = 2 ^ (k - 1) :=
        Nat.gcd_eq_right (Nat.pow_dvd_pow 2 (Nat.sub_le k 1))
      rw [hgcd]
      have hsplit : 2 ^ k = 2 ^ (k - 1) * 2 := by
        rw [← pow_succ, Nat.sub_add_cancel hk1]
      rw [hsplit, Nat.mul_div_right 2 (pow_pos (by norm_num) (k - 1))]
    have hzfix : (g ^ b) z = z := by
      rw [hz, map_pow, hfix]
    have h1 := key z hzord (g ^ b) (Subgroup.mem_zpowers (g ^ b)) hzfix
    rw [h1] at hξord
    simp only [orderOf_one] at hξord
    omega

end Work.Higman
