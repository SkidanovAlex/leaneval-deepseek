namespace Work.Higman.Q3

theorem minpoly_natDegree_eq_finrank_of_irreducible
    {V : Type} [AddCommGroup V] [Module (ZMod 2) V] [Finite V] [Nontrivial V]
    (a : V →ₗ[ZMod 2] V)
    (hirr : ∀ U : Submodule (ZMod 2) V, (∀ v ∈ U, a v ∈ U) → U = ⊥ ∨ U = ⊤) :
    (minpoly (ZMod 2) a).natDegree = Module.finrank (ZMod 2) V := by
  -- `V`, together with the action of `a`, is a module over the PID `K[X]` (`K = 𝔽₂`); the
  -- hypothesis `hirr` says precisely that this module is simple.
  let K := ZMod 2
  let R := Polynomial K
  have hsimple : IsSimpleModule R (Module.AEval' a) := by
    have : Nontrivial (Module.AEval' a) := inferInstanceAs (Nontrivial V)
    rw [isSimpleModule_iff]
    refine IsSimpleOrder.mk ?_
    intro N
    -- The underlying `K`-subspace of a `K[X]`-submodule is `a`-invariant.
    have hinv : ∀ v ∈ (N.restrictScalars K : Submodule K (Module.AEval' a)),
        a v ∈ (N.restrictScalars K : Submodule K (Module.AEval' a)) := by
      intro v hv
      have hvN : v ∈ N := (Submodule.restrictScalars_mem K N v).mp hv
      have h := N.smul_mem (Polynomial.X : R) hvN
      have h2 : (Polynomial.X : R) • v = a v := Module.AEval'.X_smul_of a v
      have haN : a v ∈ N := by rwa [h2] at h
      exact (Submodule.restrictScalars_mem K N (a v)).mpr haN
    rcases hirr (N.restrictScalars K) hinv with h | h
    · left
      rw [Submodule.eq_bot_iff]
      intro v hv
      have hvK : v ∈ (N.restrictScalars K : Submodule K (Module.AEval' a)) :=
        (Submodule.restrictScalars_mem K N v).mpr hv
      rw [h] at hvK
      exact (Submodule.mem_bot K).mp hvK
    · right
      rw [Submodule.eq_top_iff']
      intro v
      have hvK : v ∈ (N.restrictScalars K : Submodule K (Module.AEval' a)) := by
        rw [h]; trivial
      exact (Submodule.restrictScalars_mem K N v).mp hvK
  -- A simple module over a commutative ring is a quotient of the ring by its annihilator, and
  -- the annihilator of `AEval' a` is generated by the minimal polynomial.
  obtain ⟨I, _hImax, ⟨e⟩⟩ := isSimpleModule_iff_quot_maximal.mp hsimple
  have hann : Module.annihilator R (Module.AEval' a) = I := by
    rw [e.annihilator_eq, Ideal.annihilator_quotient]
  have hI : I = Ideal.span {minpoly K a} := by
    rw [← hann, ← Polynomial.span_minpoly_eq_annihilator K a]
  calc (minpoly K a).natDegree
      = Module.finrank K (R ⧸ Ideal.span {minpoly K a}) := by
        rw [finrank_quotient_span_eq_natDegree]
    _ = Module.finrank K (R ⧸ I) := by rw [hI]
    _ = Module.finrank K (Module.AEval' a) := ((e.restrictScalars K).finrank_eq).symm
    _ = Module.finrank K V := ((Module.AEval'.of a).finrank_eq).symm

end Work.Higman.Q3
