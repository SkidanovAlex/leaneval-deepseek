open scoped commutatorElement

namespace Work.Higman.Q3

/-- For a Suzuki 2-group `P` with automorphism `ξ`, an `⟨ξ⟩`-invariant normal subgroup `A`
containing the commutator subgroup `[P,P]`, and any `x : P`, the subgroup generated by `A`
together with the `ξ`-orbit of `x` is normal, `ξ`-invariant, contains `A`, and contains `x`.

The heart of the argument is that a conjugate of a generator of the form `ξ^k x` is
`g (ξ^k x) g⁻¹ = ⁅g, ξ^k x⁆ · (ξ^k x)`, and the commutator `⁅g, ξ^k x⁆` lies in `[P,P] ≤ A`;
the conjugates of elements of `A` stay in `A` because `A` is normal. -/
theorem ex_subgroup_c4 {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAn : A.Normal)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A) (x : P) :
    (Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) x))).Normal ∧
    (Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) x))).map
        (h.xi : MulAut P).toMonoidHom
      = Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) x)) ∧
    A ≤ Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) x)) ∧
    x ∈ Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) x)) := by
  set S : Set P := (A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) x) with hS
  set K : Subgroup P := Subgroup.closure S with hK
  have hAK : A ≤ K := fun a ha => Subgroup.subset_closure (Or.inl ha)
  have hxK : x ∈ K := Subgroup.subset_closure (Or.inr (Set.mem_range_self 0))
  -- Conjugation carries every generator back into `K`.
  have hgen : ∀ s ∈ S, ∀ g : P, g * s * g⁻¹ ∈ K := by
    intro s hs g
    rcases hs with hsA | hsR
    · exact hAK (hAn.conj_mem s hsA g)
    · obtain ⟨k, rfl⟩ := hsR
      rw [Work.Higman.mul_mul_inv_eq_commutator_mul]
      exact K.mul_mem
        (hAK (hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top g)
          (Subgroup.mem_top ((h.xi ^ k) x)))))
        (Subgroup.subset_closure (Or.inr (Set.mem_range_self k)))
  have hKnormal : K.Normal := by
    refine Subgroup.Normal.mk ?_
    intro n hn g
    have hn' : n ∈ Subgroup.closure S := hK ▸ hn
    clear hn
    induction hn' using Subgroup.closure_induction with
    | mem s hs => exact hgen s hs g
    | one => simp
    | mul a b ha hb iha ihb =>
        rw [show g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) by group]
        exact K.mul_mem iha ihb
    | inv a ha iha =>
        rw [show g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ by group]
        exact K.inv_mem iha
  -- `ξ` maps the generating set into itself, and (using finiteness of `ξ`) onto it.
  have hKxi : K.map (h.xi : MulAut P).toMonoidHom = K := by
    apply le_antisymm
    · rw [hK, MonoidHom.map_closure]
      apply (Subgroup.closure_le K).mpr
      rintro y ⟨s, hs, rfl⟩
      rcases hs with hsA | hsR
      · have hm : (h.xi : MulAut P) s ∈ A.map (h.xi : MulAut P).toMonoidHom :=
          Subgroup.mem_map_of_mem _ hsA
        rw [hAxi] at hm
        exact hAK hm
      · obtain ⟨k, rfl⟩ := hsR
        have hstep : (h.xi : MulAut P).toMonoidHom ((h.xi ^ k) x) = (h.xi ^ (k + 1)) x := by
          rw [pow_succ', MulAut.mul_apply]
          rfl
        rw [hstep]
        exact Subgroup.subset_closure (Or.inr (Set.mem_range_self (k + 1)))
    · rw [hK, MonoidHom.map_closure]
      apply (Subgroup.closure_le _).mpr
      intro s hs
      rcases hs with hsA | hsR
      · have hsA' : s ∈ A.map (h.xi : MulAut P).toMonoidHom := hAxi.ge hsA
        obtain ⟨b, hb, hbs⟩ := Subgroup.mem_map.mp hsA'
        rw [← hbs]
        exact Subgroup.subset_closure ⟨b, Or.inl hb, rfl⟩
      · obtain ⟨k, hk⟩ := hsR
        have hmem : ∀ j : ℕ, (h.xi ^ j) x ∈
            Subgroup.closure (⇑(h.xi : MulAut P).toMonoidHom '' S) := by
          intro j
          rcases Nat.eq_zero_or_pos j with hj | hj
          · subst hj
            have hx0 : (h.xi ^ 0) x = x := by simp
            rw [hx0]
            obtain ⟨n, hnpos, hnpow⟩ :=
              isOfFinOrder_iff_pow_eq_one.mp (isOfFinOrder_of_finite (h.xi : MulAut P))
            have heq : x = (h.xi : MulAut P) ((h.xi ^ (n - 1)) x) := by
              rw [← MulAut.mul_apply]
              rw [show (h.xi : MulAut P) * h.xi ^ (n - 1) = h.xi ^ n by
                rw [← pow_succ', show n - 1 + 1 = n by omega]]
              rw [hnpow]
              simp
            rw [heq]
            exact Subgroup.subset_closure
              ⟨(h.xi ^ (n - 1)) x, Or.inr (Set.mem_range_self (n - 1)), rfl⟩
          · have heq : (h.xi ^ j) x = (h.xi : MulAut P) ((h.xi ^ (j - 1)) x) := by
              conv_lhs => rw [show j = j - 1 + 1 by omega]
              rw [pow_succ', MulAut.mul_apply]
            rw [heq]
            exact Subgroup.subset_closure
              ⟨(h.xi ^ (j - 1)) x, Or.inr (Set.mem_range_self (j - 1)), rfl⟩
        rw [← hk]
        exact hmem k
  exact ⟨hKnormal, hKxi, hAK, hxK⟩

end Work.Higman.Q3
