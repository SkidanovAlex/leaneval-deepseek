/-! ## The quotient `P ⧸ A` when `[P,P] ≤ A` -/

/-- If `A` contains the commutator subgroup then `P ⧸ A` is abelian. -/
theorem nsdL1_quotA_mul_comm {A : Subgroup P} [A.Normal] (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A)
    (a b : P ⧸ A) : a * b = b * a := by
  refine Quotient.inductionOn a (fun x => ?_)
  refine Quotient.inductionOn b (fun y => ?_)
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
  have key : (x * y)⁻¹ * (y * x) = ⁅y⁻¹, x⁻¹⁆ := by
    simp only [commutatorElement_def, mul_inv_rev, inv_inv, mul_assoc]
  rw [key]
  exact hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top y⁻¹) (Subgroup.mem_top x⁻¹))

/-- The `CommGroup` structure on `P ⧸ A` (its group structure is abelian). -/
@[instance_reducible]
noncomputable def nsdL1_quotACommGroup {A : Subgroup P} [A.Normal]
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A) : CommGroup (P ⧸ A) :=
  { (inferInstance : Group (P ⧸ A)) with mul_comm := nsdL1_quotA_mul_comm hcomm }

/-- `[x * y, z] = x * [y, z] * x⁻¹ * [x, z]`. -/
theorem nsdL1_commutator_mul_left_eq'_ (x y z : P) :
    ⁅x * y, z⁆ = x * ⁅y, z⁆ * x⁻¹ * ⁅x, z⁆ := by
  simp only [commutatorElement_def]
  group

/-- `[x, y * z] = [x, y] * (y * [x, z] * y⁻¹)`. -/
theorem nsdL1_commutator_mul_right_eq'_ (x y z : P) :
    ⁅x, y * z⁆ = ⁅x, y⁆ * (y * ⁅x, z⁆ * y⁻¹) := by
  simp only [commutatorElement_def]
  group

/-- **The first layer `P/A` is a finite field with a Singer cycle.**

In the `C₄` setting (a Suzuki 2-group `P`, a `ξ`-invariant abelian normal `A` with `Ω₁(P) ≤ A`,
`[P,P] = A`, all squares of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`, with no
normal `ξ`-invariant subgroup strictly between `A` and `P`) the quotient `P/A` has the same order
as `Ω₁(P)`, say `2 ^ n` with `n ≥ 2`, and `ξ` acts on it as multiplication by a generator of the
multiplicative group of a finite field.

**Do not use `Work.Higman.no_square_derived` or `Work.Higman.nsd_false_of_irreducible`** (they
have the same hypotheses and are unfinished; using them would be circular and would leave
`sorryAx` in the proof).

Route.  `|Ω₁(P)| = 2 ^ n` for a unique `n ≥ 2` (`Work.Higman.exists_card_omega1_eq_two_pow`,
`omega1_card_ge_four`).  `P/A` is an elementary abelian `2`-group (`hGs` makes it abelian, `hsq`
gives exponent `2`), hence a `ZMod 2`-module on which `ξ` acts linearly.
(a) The squaring map `P → P/A` descends to a well defined *injection*: by `hirr` its kernel is a
`ξ`-invariant normal subgroup between `A` and `P`, hence `A` or `P`, and it is not `P`; use
`Work.Higman.aux_sq4` (`(u*a)^4 = u^4` for `a ∈ A`, in `Submission/Work/Higman/nsd_transfer.lean`)
to see that the fourth powers of two elements of the same coset of `A` agree.  Hence
`|P/A| ≤ |Ω₁(P)| = 2 ^ n`.
(b) `orderOf ξ = 2 ^ n - 1` on `P/A`.  If `η = ξ^k` is the identity on `Ω₁(P)` then it is the
identity on `P/A`: for `a ∈ A` the map `u ↦ ⁅u, a⁆ ∈ A² = Ω₁(P)` is `ξ`-equivariant and
non-degenerate (`⁅u, a⁆ = 1` for all `a ∈ A` implies `u ∈ C_P(A) = A` by `hirr`), so `η u = u`.
Conversely `[P,P] = A` (with `A/A² ≅ Ω₁(P)`) is generated by commutators, so if `η` is trivial on
`P/A` it is trivial on `Ω₁(P)`;  hence the actions of `⟨ξ⟩` on `P/A` and on `Ω₁(P)` have the same
kernel and `orderOf ξ = 2 ^ n - 1`.
(c) `ξ` is fixed-point free on `(P/A) \ {A}` (a fixed point generates the irreducible module), so
all `ξ`-orbits there have size `2 ^ n - 1`;  hence `2 ^ n - 1 ∣ |P/A| - 1`.  Combined with
`|P/A| ≤ 2 ^ n` this gives `|P/A| = 2 ^ n`.
(d) Apply `Work.Higman.exists_singer_iso` (`Submission/Work/Higman/exists_singer_iso.lean`) to the
`ZMod 2`-module `P/A` and the linear automorphism induced by `ξ`, and transport along the
`ZMod 2`-linear isomorphism to get `ζ` (and take `λ` the generator of `GaloisField 2 nˣ`);
the equivariance statement follows from the definition of the induced action, and
`Work.Higman.aux_sq_wd`/`L1_sq_eq_one`-style facts give additivity of `ζ`. -/
theorem nsdL1_orbit_invol (h : IsSuzuki2Grp P) {u : P} (hu : orderOf u = 2) :
    (MulAction.orbit (Subgroup.zpowers h.xi) u : Set P) = Invol P := by
  ext z
  rw [MulAction.mem_orbit_iff, mem_Invol]
  constructor
  · rintro ⟨g, rfl⟩
    show orderOf (g • u) = 2
    rw [show g • u = (g : MulAut P) u from rfl, MulEquiv.orderOf_eq, hu]
  · intro hz
    obtain ⟨k, hk⟩ := h.trans u z hu hz
    refine ⟨⟨h.xi ^ k, ?_⟩, hk⟩
    exact Subgroup.pow_mem (Subgroup.zpowers h.xi) (Subgroup.mem_zpowers h.xi) k

/-- Every orbit of `⟨ξ⟩` on `P \ {1}` has cardinality divisible by `|Ω₁(P)| - 1`. -/
theorem nsdL1_invol_ncard_dvd_orbit (h : IsSuzuki2Grp P) {x : P} (hx : x ≠ 1) :
    (Invol P).ncard ∣ Nat.card ↥(MulAction.orbit (Subgroup.zpowers h.xi) x) := by
  classical
  set K : Subgroup (MulAut P) := Subgroup.zpowers h.xi with hK
  obtain ⟨u, -, hu2, -, -⟩ := h.manyInvol
  -- orbit–stabiliser for the involution `u`
  have horb_u : Nat.card ↥(MulAction.orbit K u) = (Invol P).ncard := by
    rw [Nat.card_coe_set_eq, nsdL1_orbit_invol h hu2]
  have hos_u : (Invol P).ncard * Nat.card ↥(MulAction.stabilizer K u) = orderOf h.xi := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup K u)
    rw [Nat.card_prod, hK, Nat.card_zpowers] at hh
    rwa [horb_u] at hh
  -- `x` has `2`-power order
  obtain ⟨s, hs⟩ := h.isPGroup.exists_orderOf_eq_pow x
  have hs1 : 1 ≤ s := by
    rcases Nat.eq_zero_or_pos s with h0 | hpos
    · subst h0
      simp only [pow_zero] at hs
      exact absurd (orderOf_eq_one_iff.mp hs) hx
    · exact hpos
  set w : P := x ^ 2 ^ (s - 1) with hw
  have hw1 : w ≠ 1 := by
    intro hcon
    have hdvd : 2 ^ s ∣ 2 ^ (s - 1) := by
      rw [← hs]
      exact orderOf_dvd_iff_pow_eq_one.mpr (by rw [← hw]; exact hcon)
    have hlt : 2 ^ (s - 1) < 2 ^ s := Nat.pow_lt_pow_right (by norm_num) (by omega)
    exact absurd (Nat.le_of_dvd (pow_pos (by norm_num) _) hdvd) (by omega)
  have hw2 : orderOf w = 2 := by
    have hpow : w ^ 2 = 1 := by
      have hexp : 2 ^ (s - 1) * 2 = 2 ^ s := by
        rw [← pow_succ]
        congr 1
        omega
      rw [hw, ← pow_mul, hexp, ← hs, pow_orderOf_eq_one]
    have hd : orderOf w ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hpow
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
    · exact absurd (orderOf_eq_one_iff.mp h1) hw1
    · exact h2
  -- the stabiliser of `x` is contained in that of `w`
  have hstab_le : MulAction.stabilizer K x ≤ MulAction.stabilizer K w := by
    intro γ hγ
    rw [MulAction.mem_stabilizer_iff] at hγ ⊢
    have h1 : (γ : MulAut P) x = x := hγ
    show (γ : MulAut P) w = w
    rw [hw, map_pow, h1]
  -- stabilisers of involutions have the same cardinality
  have hcard_stab_w : Nat.card ↥(MulAction.stabilizer K w) =
      Nat.card ↥(MulAction.stabilizer K u) := by
    have h1 := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup K w)
    rw [Nat.card_prod, hK, Nat.card_zpowers] at h1
    have h2 : Nat.card ↥(MulAction.orbit K w) = (Invol P).ncard := by
      rw [Nat.card_coe_set_eq, nsdL1_orbit_invol h hw2]
    rw [h2] at h1
    have hpos : 0 < (Invol P).ncard :=
      (Set.ncard_pos (Set.toFinite (Invol P))).mpr ⟨u, mem_Invol.mpr hu2⟩
    exact Nat.eq_of_mul_eq_mul_left hpos (by rw [h1, hos_u])
  -- orbit–stabiliser for `x`
  have hos_x : Nat.card ↥(MulAction.orbit K x) * Nat.card ↥(MulAction.stabilizer K x) =
      orderOf h.xi := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup K x)
    rw [Nat.card_prod, hK, Nat.card_zpowers] at hh
    exact hh
  -- `|Stab x|` divides `|Stab u|`
  have hdiv : Nat.card ↥(MulAction.stabilizer K x) ∣
      Nat.card ↥(MulAction.stabilizer K u) := by
    rw [← hcard_stab_w]
    exact Subgroup.card_dvd_of_le hstab_le
  obtain ⟨c, hc⟩ := hdiv
  have key : Nat.card ↥(MulAction.orbit K x) * Nat.card ↥(MulAction.stabilizer K x) =
      (Invol P).ncard * Nat.card ↥(MulAction.stabilizer K u) := by rw [hos_x, hos_u]
  refine ⟨c, ?_⟩
  have hpos : 0 < Nat.card ↥(MulAction.stabilizer K x) := Nat.card_pos
  have h2 : Nat.card ↥(MulAction.orbit K x) * Nat.card ↥(MulAction.stabilizer K x) =
      ((Invol P).ncard * c) * Nat.card ↥(MulAction.stabilizer K x) := by
    rw [key, hc]
    ring
  exact Nat.eq_of_mul_eq_mul_right hpos h2

/-- **Orbit counting.**  `|Ω₁(P)| - 1` divides `|P| - 1` for a Suzuki 2-group `P`. -/
theorem nsdL1_card_omega1_sub_one_dvd_card_sub_one (h : IsSuzuki2Grp P) :
    Nat.card (omega1 P) - 1 ∣ Nat.card P - 1 := by
  classical
  haveI : Fintype P := Fintype.ofFinite P
  set K : Subgroup (MulAut P) := Subgroup.zpowers h.xi with hK
  have hq : Nat.card (omega1 P) - 1 = (Invol P).ncard := by
    rw [h.card_omega1, Nat.add_sub_cancel]
  rw [hq]
  -- `P \ {1}` is the disjoint union of its orbits
  set s : Finset P := Finset.univ.filter (fun x : P => x ≠ 1) with hs
  have hcard_s : s.card = Nat.card P - 1 := by
    rw [hs]
    have h1 : (Finset.univ.filter (fun x : P => x ≠ 1)).card +
        (Finset.univ.filter (fun x : P => ¬ x ≠ 1)).card = (Finset.univ : Finset P).card :=
      Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset P))
        (p := fun x : P => x ≠ 1)
    have h2 : (Finset.univ.filter (fun x : P => ¬ x ≠ 1)).card = 1 := by
      have hset : (Finset.univ.filter (fun x : P => ¬ x ≠ 1)) = {1} := by
        ext x
        simp
      rw [hset]
      simp
    have h3 : (Finset.univ : Finset P).card = Nat.card P := by
      rw [Finset.card_univ, Nat.card_eq_fintype_card]
    omega
  have hpartition := Finset.card_eq_sum_card_image
    (f := fun x : P => MulAction.orbit K x) s
  have hdvd : (Invol P).ncard ∣ s.card := by
    rw [hpartition]
    apply Finset.dvd_sum
    intro b hb
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hb
    have hx1 : x ≠ 1 := by simpa [hs] using hx
    have h1not : (1 : P) ∉ MulAction.orbit K x := by
      intro hmem
      rw [MulAction.mem_orbit_iff] at hmem
      obtain ⟨γ, hγ⟩ := hmem
      have : x = 1 := by
        calc x = γ⁻¹ • (γ • x) := by rw [inv_smul_smul]
          _ = γ⁻¹ • (1 : P) := by rw [hγ]
          _ = 1 := by simp
      exact hx1 this
    have hfiber : (s.filter (fun a : P => MulAction.orbit K a = MulAction.orbit K x)).card =
        Nat.card ↥(MulAction.orbit K x) := by
      have hset : (s.filter (fun a : P => MulAction.orbit K a = MulAction.orbit K x)) =
          ((MulAction.orbit K x : Set P)).toFinset := by
        ext a
        simp only [Finset.mem_filter, Set.mem_toFinset, MulAction.orbit_eq_iff, hs,
          Finset.mem_filter, Finset.mem_univ, true_and]
        constructor
        · rintro ⟨-, ha⟩
          exact ha
        · intro ha
          exact ⟨fun hcon => h1not (hcon ▸ ha), ha⟩
      rw [hset, Set.toFinset_card]
      exact (Nat.card_eq_fintype_card).symm
    rw [hfiber]
    exact nsdL1_invol_ncard_dvd_orbit h hx1
  rw [← hcard_s]
  exact hdvd

theorem L1_iso_field_exp {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hirr : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D = A ∨ D = ⊤)
    (n : ℕ) (hn : Nat.card ↥(Work.Higman.omega1 P) = 2 ^ n) :
    ∃ (F : Type) (_ : Field F) (_ : Fintype F) (_ : DecidableEq F) (_ : CharP F 2)
      (lam : F),
      Fintype.card F = 2 ^ n ∧ 2 ≤ n ∧ orderOf lam = 2 ^ n - 1 ∧ lam ≠ 0 ∧
      ∃ ζ : F ≃ (P ⧸ A), (∀ x y : F, ζ (x + y) = ζ x * ζ y) ∧
        (∀ x : F, ∀ u : P, (u : P ⧸ A) = ζ x → ζ (lam * x) = (h.xi u : P ⧸ A)) := by
  classical
  -- ## 0.  Elementary data
  have hcommA : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A := le_of_eq hGs
  letI qc : CommGroup (P ⧸ A) := nsdL1_quotACommGroup hcommA
  haveI : Finite (P ⧸ A) :=
    Finite.of_surjective (QuotientGroup.mk' A) (QuotientGroup.mk'_surjective A)
  have hq4 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
  have hn2 : 2 ≤ n := by
    have h4 : 4 ≤ 2 ^ n := by rw [← hn]; exact hq4
    by_contra hcon
    have h1 : n ≤ 1 := by omega
    have h2 : 2 ^ n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) h1
    norm_num at h2
    omega
  have hn0 : 0 < n := by omega
  have hqcard : Nat.card ↥(omega1 P) = 2 ^ n := hn
  have hAcard : Nat.card ↥A = 2 ^ (2 * n) := by
    rw [hcard, hn]
    ring_nf
  have hA_ne_top : A ≠ ⊤ := by
    intro hAtop
    obtain ⟨x, y, hxy⟩ := h.noncomm
    have hx : x ∈ A := by rw [hAtop]; trivial
    have hy : y ∈ A := by rw [hAtop]; trivial
    exact hxy (hAab x hx y hy)
  haveI : Nontrivial (P ⧸ A) := by
    by_contra hsub
    rw [not_nontrivial_iff_subsingleton] at hsub
    refine hA_ne_top (le_antisymm le_top (fun x _ => ?_))
    have h1 : (QuotientGroup.mk' A) x = 1 := Subsingleton.elim _ _
    rwa [← MonoidHom.mem_ker, QuotientGroup.ker_mk'] at h1
  -- ## 1.  The `𝔽₂`-vector space `V = P/A`
  let V := Additive (P ⧸ A)
  have h2zero : ∀ x : V, 2 • x = 0 := by
    intro x
    obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = x := ⟨Additive.toMul x, rfl⟩
    have hw : w * w = 1 := by
      refine Quotient.inductionOn w (fun u => ?_)
      show (QuotientGroup.mk' A) u * (QuotientGroup.mk' A) u = 1
      rw [← map_mul, ← MonoidHom.mem_ker, QuotientGroup.ker_mk']
      simpa [pow_two] using hsq u
    calc 2 • (Additive.ofMul w) = Additive.ofMul w + Additive.ofMul w := two_nsmul _
      _ = Additive.ofMul (w * w) := ofMul_mul w w
      _ = 0 := by rw [hw]; rfl
  letI : Module (ZMod 2) V := AddCommGroup.zmodModule h2zero
  -- the automorphism of `P/A` induced by `ξ`
  have hAxi_inv : A.map ((h.xi : MulAut P)⁻¹).toMonoidHom = A := by
    refine le_antisymm ?_ ?_
    · rintro x ⟨y, hy, rfl⟩
      exact symm_mem_of_map_eq h.xi hAxi hy
    · intro x hx
      refine ⟨h.xi x, ?_, by simp⟩
      have h1 := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) hx
      rwa [hAxi] at h1
  let ξQ : (P ⧸ A) ≃* (P ⧸ A) :=
    { toFun := QuotientGroup.map A A (h.xi : MulAut P).toMonoidHom
        (by rw [← Subgroup.map_le_iff_le_comap, hAxi])
      invFun := QuotientGroup.map A A ((h.xi : MulAut P)⁻¹).toMonoidHom
        (by rw [← Subgroup.map_le_iff_le_comap, hAxi_inv])
      left_inv := by
        intro a
        refine Quotient.inductionOn a (fun x => ?_)
        simp only [QuotientGroup.map_mk]
        simp
      right_inv := by
        intro a
        refine Quotient.inductionOn a (fun x => ?_)
        simp only [QuotientGroup.map_mk]
        simp
      map_mul' := fun a b => map_mul _ a b }
  have ξQ_mk : ∀ x : P, ξQ (QuotientGroup.mk x) = QuotientGroup.mk (h.xi x) := fun x =>
    QuotientGroup.map_mk A A (h.xi : MulAut P).toMonoidHom
      (by rw [← Subgroup.map_le_iff_le_comap, hAxi]) x
  have ξQ_mk' : ∀ x : P, ξQ ((QuotientGroup.mk' A) x) = (QuotientGroup.mk' A) (h.xi x) := by
    intro x
    rw [QuotientGroup.mk'_apply A x, QuotientGroup.mk'_apply A (h.xi x), ξQ_mk]
  have ξQ_pow_mk : ∀ (k : ℕ) (x : P),
      (ξQ ^ k) (QuotientGroup.mk x) = QuotientGroup.mk ((h.xi ^ k) x) := by
    intro k
    induction k with
    | zero => intro x; simp
    | succ k ih =>
        intro x
        calc (ξQ ^ (k + 1)) (QuotientGroup.mk x)
            = (ξQ ^ k) (ξQ (QuotientGroup.mk x)) := by
                rw [pow_succ]
                rfl
          _ = (ξQ ^ k) (QuotientGroup.mk (h.xi x)) := by rw [ξQ_mk]
          _ = QuotientGroup.mk ((h.xi ^ k) (h.xi x)) := ih (h.xi x)
          _ = QuotientGroup.mk ((h.xi ^ (k + 1)) x) := by
                rw [pow_succ, MulAut.mul_apply]
  let σlin : V →ₗ[ZMod 2] V := AddMonoidHom.toZModLinearMap 2 (ξQ.toAdditive : V →+ V)
  have hσlin_apply : ∀ x : V, σlin x = ξQ.toAdditive x := fun x => rfl
  have hσlin : Function.Bijective σlin := by
    refine ⟨fun a b hab => ?_, fun b => ?_⟩
    · have hab' : ξQ.toAdditive a = ξQ.toAdditive b := by rw [← hσlin_apply, ← hσlin_apply]; exact hab
      exact ξQ.toAdditive.injective hab'
    · obtain ⟨a, ha⟩ := ξQ.toAdditive.surjective b
      exact ⟨a, by rw [hσlin_apply]; exact ha⟩
  let σ : V ≃ₗ[ZMod 2] V := LinearEquiv.ofBijective σlin hσlin
  have σ_ofMul : ∀ w : P ⧸ A, σ (Additive.ofMul w) = Additive.ofMul (ξQ w) := by
    intro w
    show (AddMonoidHom.toZModLinearMap 2 (ξQ.toAdditive : V →+ V)) (Additive.ofMul w)
      = Additive.ofMul (ξQ w)
    simp only [AddMonoidHom.coe_toZModLinearMap]
    rfl
  have σ_pow_ofMul : ∀ (k : ℕ) (w : P ⧸ A),
      (σ ^ k) (Additive.ofMul w) = Additive.ofMul ((ξQ ^ k) w) := by
    intro k
    induction k with
    | zero => intro w; simp
    | succ k ih =>
        intro w
        rw [pow_succ', LinearEquiv.mul_apply, ih, σ_ofMul, pow_succ']
        rfl
  -- ## 2.  `ξ ^ k` acting trivially on `V` is the same as on the cosets of `A`
  have htrivV : ∀ k : ℕ, ξQ ^ k = 1 ↔ ∀ u : P, ((h.xi ^ k) u) * u⁻¹ ∈ A := by
    intro k
    constructor
    · intro hk u
      have h1 : (ξQ ^ k) (QuotientGroup.mk u) = QuotientGroup.mk u := by rw [hk]; rfl
      rw [ξQ_pow_mk] at h1
      have h2 : ((h.xi ^ k) u)⁻¹ * u ∈ A := QuotientGroup.eq.mp h1
      have h3 : u * (((h.xi ^ k) u)⁻¹ * u) * u⁻¹ ∈ A := hAn.conj_mem _ h2 u
      have h4 : u * ((h.xi ^ k) u)⁻¹ ∈ A := by simpa [mul_assoc] using h3
      have h5 : (u * ((h.xi ^ k) u)⁻¹)⁻¹ ∈ A := A.inv_mem h4
      simpa [mul_inv_rev] using h5
    · intro hk
      refine MulEquiv.ext (fun w => ?_)
      refine Quotient.inductionOn w (fun u => ?_)
      rw [ξQ_pow_mk]
      refine QuotientGroup.eq.mpr ?_
      have h1 : u⁻¹ * (((h.xi ^ k) u) * u⁻¹) * u ∈ A := by
        simpa using hAn.conj_mem (((h.xi ^ k) u) * u⁻¹) (hk u) u⁻¹
      have h2 : u⁻¹ * ((h.xi ^ k) u) ∈ A := by simpa [mul_assoc] using h1
      simpa [mul_inv_rev] using A.inv_mem h2
  -- ## 3.  `ξ` preserves `A`;  `C_P(A) = A`
  have hxiA : ∀ (k : ℕ) (a : P), a ∈ A → (h.xi ^ k) a ∈ A := by
    intro k a ha
    induction k with
    | zero => simpa using ha
    | succ k ih =>
        rw [pow_succ', MulAut.mul_apply]
        have h1 := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) ih
        rwa [hAxi] at h1
  have hCP : Subgroup.centralizer (A : Set P) = A := by
    have hAC : A ≤ Subgroup.centralizer (A : Set P) := by
      intro a ha
      refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
      exact hAab b hb a ha
    have hCn : (Subgroup.centralizer (A : Set P)).Normal := by
      refine ⟨fun x hx g => ?_⟩
      refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
      have hx' : ∀ c ∈ A, c * x = x * c := Subgroup.mem_centralizer_iff.mp hx
      have hgb : g⁻¹ * b * g ∈ A := by
        have h1 := hAn.conj_mem b hb g⁻¹
        simpa [mul_assoc] using h1
      have h1 := hx' (g⁻¹ * b * g) hgb
      calc b * (g * x * g⁻¹) = g * (g⁻¹ * b * g) * x * g⁻¹ := by group
        _ = g * (x * (g⁻¹ * b * g)) * g⁻¹ := by rw [← h1]; group
        _ = (g * x * g⁻¹) * b := by group
    have hCinv : (Subgroup.centralizer (A : Set P)).map (h.xi : MulAut P).toMonoidHom
        = Subgroup.centralizer (A : Set P) := by
      refine le_antisymm ?_ ?_
      · rintro x ⟨y, hy, rfl⟩
        refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
        have hy' : ∀ c ∈ A, c * y = y * c := Subgroup.mem_centralizer_iff.mp hy
        have hb' : (h.xi : MulAut P).symm b ∈ A := symm_mem_of_map_eq h.xi hAxi hb
        have h1 := hy' ((h.xi : MulAut P).symm b) hb'
        have h2 := congrArg (fun t : P => h.xi t) h1
        simpa using h2
      · intro x hx
        refine ⟨(h.xi : MulAut P).symm x, ?_, by simp⟩
        refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
        have hx' : ∀ c ∈ A, c * x = x * c := Subgroup.mem_centralizer_iff.mp hx
        have hb' : h.xi b ∈ A := by
          have h1 := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) hb
          rwa [hAxi] at h1
        have h1 := hx' (h.xi b) hb'
        have h2 := congrArg (fun t : P => (h.xi : MulAut P).symm t) h1
        simpa using h2
    have hCne : Subgroup.centralizer (A : Set P) ≠ ⊤ := by
      intro hCtop
      apply aux_comm_ne_bot h hAab hNA hGs hsq htop
      refine le_bot_iff.mp ?_
      refine Subgroup.commutator_le.mpr (fun a ha g _ => ?_)
      have hg : g ∈ Subgroup.centralizer (A : Set P) := by rw [hCtop]; trivial
      have hg' : ∀ c ∈ A, c * g = g * c := Subgroup.mem_centralizer_iff.mp hg
      rw [commutatorElement_eq_one_iff_mul_comm.mpr (hg' a ha)]
      exact Subgroup.one_mem _
    rcases hirr _ hCn hCinv hAC with h1 | h1
    · exact h1
    · exact absurd h1 hCne
  -- ## 4.  The two kernel inclusions
  have hcen2 : ∀ z ∈ powSub A 2, ∀ y : P, y * z * y⁻¹ = z := aux_conj_eq h htop
  have hcen2' : ∀ z ∈ powSub A 2, ∀ y : P, y * z = z * y := by
    intro z hz y
    have h1 := hcen2 z hz y
    have h2 : y * z * y⁻¹ * y = y * z := by group
    calc y * z = y * z * y⁻¹ * y := h2.symm
      _ = z * y := by rw [h1]
  have hsq_one : ∀ z ∈ powSub A 2, z ^ 2 = 1 := by
    intro z hz
    exact h.mem_omega1.mp (by rw [← htop]; exact hz)
  -- (b₁)  trivial on `P/A` ⟹ trivial on `Ω₁(P)`
  have dir1 : ∀ k : ℕ, (∀ u : P, ((h.xi ^ k) u) * u⁻¹ ∈ A) →
      ∀ z : P, z ∈ omega1 P → (h.xi ^ k) z = z := by
    intro k hk z hz
    have hstep : ∀ a ∈ A, ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := by
      let S : Subgroup P :=
        { carrier := {a : P | a ∈ A ∧ ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2}
          one_mem' := by
            refine ⟨A.one_mem, ?_⟩
            simpa using (powSub A 2).one_mem
          mul_mem' := by
            intro a b ha hb
            refine ⟨A.mul_mem ha.1 hb.1, ?_⟩
            have hηa : (h.xi ^ k) a ∈ A := hxiA k a ha.1
            have hηb : (h.xi ^ k) b ∈ A := hxiA k b hb.1
            have hYV : Commute ((h.xi ^ k) b) b⁻¹ := hAab _ hηb _ (A.inv_mem hb.1)
            have hYU : Commute ((h.xi ^ k) b) a⁻¹ := hAab _ hηb _ (A.inv_mem ha.1)
            have hVU : Commute b⁻¹ a⁻¹ := hAab _ (A.inv_mem hb.1) _ (A.inv_mem ha.1)
            have h1 : (h.xi ^ k) (a * b) * (a * b)⁻¹
                = ((h.xi ^ k) a * a⁻¹) * ((h.xi ^ k) b * b⁻¹) := by
              rw [map_mul, mul_inv_rev]
              calc ((h.xi ^ k) a * (h.xi ^ k) b) * (b⁻¹ * a⁻¹)
                  = ((h.xi ^ k) a * b⁻¹) * ((h.xi ^ k) b * a⁻¹) :=
                    Commute.mul_mul_mul_comm hYV _ _
                _ = ((h.xi ^ k) a * b⁻¹) * (a⁻¹ * (h.xi ^ k) b) := by rw [hYU.eq]
                _ = ((h.xi ^ k) a * a⁻¹) * (b⁻¹ * (h.xi ^ k) b) :=
                      Commute.mul_mul_mul_comm hVU _ _
                _ = ((h.xi ^ k) a * a⁻¹) * ((h.xi ^ k) b * b⁻¹) := by rw [← hYV.eq]
            rw [h1]
            exact (powSub A 2).mul_mem ha.2 hb.2
          inv_mem' := by
            intro a ha
            refine ⟨A.inv_mem ha.1, ?_⟩
            have hηa : (h.xi ^ k) a ∈ A := hxiA k a ha.1
            have h1 : (h.xi ^ k) a⁻¹ * (a⁻¹)⁻¹ = (((h.xi ^ k) a) * a⁻¹)⁻¹ := by
              simp only [map_inv, inv_inv, mul_inv_rev]
              exact hAab _ (A.inv_mem hηa) _ ha.1
            rw [h1]
            exact (powSub A 2).inv_mem ha.2 }
      have hAleS : A ≤ S := by
        rw [← hGs]
        refine Subgroup.commutator_le.mpr (fun u _ v _ => ?_)
        refine ⟨?_, ?_⟩
        · rw [← hGs]
          exact Subgroup.commutator_mem_commutator (Subgroup.mem_top u) (Subgroup.mem_top v)
        · have h1 : (h.xi ^ k) ⁅u, v⁆ = ⁅(h.xi ^ k) u, (h.xi ^ k) v⁆ := by
            simpa using map_commutatorElement (f := ((h.xi ^ k : MulAut P) : P →* P)) u v
          have ha : u⁻¹ * ((h.xi ^ k) u) ∈ A := by
            have h2 := hAn.conj_mem ((h.xi ^ k) u * u⁻¹) (hk u) u⁻¹
            simpa [mul_assoc] using h2
          have hb : v⁻¹ * ((h.xi ^ k) v) ∈ A := by
            have h2 := hAn.conj_mem ((h.xi ^ k) v * v⁻¹) (hk v) v⁻¹
            simpa [mul_assoc] using h2
          have h3 := aux_comm_sq h hAxi hAab hGs htop u v ha hb
          rw [h1]
          simpa [mul_assoc] using h3
      intro a ha
      exact (hAleS ha).2
    -- `z ∈ Ω₁(P) = A²` is a square, and `ξ^k` fixes it
    obtain ⟨a, haA, rfl⟩ :=
      (mem_powSub_iff hAab (n := 2)).mp (by rw [htop]; exact hz)
    have hc : ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := hstep a haA
    have hηa : (h.xi ^ k) a ∈ A := hxiA k a haA
    have hc2 : (((h.xi ^ k) a) * a⁻¹) ^ 2 = 1 := hsq_one _ hc
    have key : ((h.xi ^ k) a) ^ 2 = a ^ 2 := by
      have hcomm : Commute (((h.xi ^ k) a) * a⁻¹) a :=
        hAab _ (A.mul_mem hηa (A.inv_mem haA)) _ haA
      have h1 : (((h.xi ^ k) a) * a⁻¹) * a = (h.xi ^ k) a := by group
      calc ((h.xi ^ k) a) ^ 2
          = ((((h.xi ^ k) a) * a⁻¹) * a) ^ 2 := congrArg (fun t => t ^ 2) h1.symm
        _ = (((h.xi ^ k) a) * a⁻¹) ^ 2 * a ^ 2 := hcomm.mul_pow 2
        _ = a ^ 2 := by rw [hc2, one_mul]
    rw [map_pow]
    exact key
  -- (b₂)  trivial on `Ω₁(P)` ⟹ trivial on `P/A`
  have dir2 : ∀ k : ℕ, (∀ z : P, z ∈ omega1 P → (h.xi ^ k) z = z) →
      ∀ u : P, ((h.xi ^ k) u) * u⁻¹ ∈ A := by
    intro k hk u
    -- (i) for `a ∈ A`: `ξ^k a * a⁻¹ ∈ A²`
    have hstep : ∀ a ∈ A, ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := by
      intro a ha
      have hηa : (h.xi ^ k) a ∈ A := hxiA k a ha
      have h1 : ((h.xi ^ k) a) ^ 2 = a ^ 2 := by
        have h2 := hk (a ^ 2) (by rw [← htop]; exact pow_mem_powSub ha)
        rwa [map_pow] at h2
      have h3 : (((h.xi ^ k) a) * a⁻¹) * (((h.xi ^ k) a) * a⁻¹) = 1 := by
        have hc : Commute ((h.xi ^ k) a) a⁻¹ := hAab _ hηa _ (A.inv_mem ha)
        rw [← pow_two, hc.mul_pow, inv_pow, h1, mul_inv_cancel]
      have h4 : ((h.xi ^ k) a * a⁻¹) ∈ omega1 P := by
        rw [h.mem_omega1, pow_two]
        exact h3
      rwa [← htop] at h4
    -- (ii) `⁅u, a⁆ = ⁅ξ^k u, a⁆` for `a ∈ A`
    have hstep2 : ∀ a ∈ A, ⁅u, a⁆ = ⁅(h.xi ^ k) u, a⁆ := by
      intro a ha
      have h1 : (h.xi ^ k) ⁅u, a⁆ = ⁅(h.xi ^ k) u, (h.xi ^ k) a⁆ := by
        simpa using map_commutatorElement (f := ((h.xi ^ k : MulAut P) : P →* P)) u a
      have h2 : (h.xi ^ k) ⁅u, a⁆ = ⁅u, a⁆ := by
        have hmem : ⁅u, a⁆ ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs u ha
        exact hk _ (by rw [← htop]; exact hmem)
      have hc : ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := hstep a ha
      have hca : (h.xi ^ k) a = (((h.xi ^ k) a) * a⁻¹) * a := by group
      have h3 : ⁅(h.xi ^ k) u, ((h.xi ^ k) a * a⁻¹) * a⁆ = ⁅(h.xi ^ k) u, a⁆ := by
        rw [nsdL1_commutator_mul_right_eq'_]
        have hz : ((h.xi ^ k) a * a⁻¹) * ⁅(h.xi ^ k) u, a⁆ * ((h.xi ^ k) a * a⁻¹)⁻¹
            = ⁅(h.xi ^ k) u, a⁆ := by
          rw [← hcen2' _ hc ⁅(h.xi ^ k) u, a⁆]
          group
        have hz2 : ⁅(h.xi ^ k) u, (h.xi ^ k) a * a⁻¹⁆ = 1 := by
          rw [commutatorElement_eq_one_iff_mul_comm]
          exact hcen2' _ hc _
        rw [hz2, hz, one_mul]
      calc ⁅u, a⁆ = (h.xi ^ k) ⁅u, a⁆ := h2.symm
        _ = ⁅(h.xi ^ k) u, (h.xi ^ k) a⁆ := h1
        _ = ⁅(h.xi ^ k) u, ((h.xi ^ k) a * a⁻¹) * a⁆ := by rw [← hca]
        _ = ⁅(h.xi ^ k) u, a⁆ := h3
    -- (iii) `[ξ^k u * u⁻¹, a] = 1`
    have hstep3 : ∀ a ∈ A, ⁅((h.xi ^ k) u) * u⁻¹, a⁆ = 1 := by
      intro a ha
      have hYa : ⁅u, a⁆ ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs u ha
      have hX : ⁅u⁻¹, a⁆ = (⁅u, a⁆)⁻¹ := by
        have h1 : ⁅u⁻¹, a⁆ = u⁻¹ * (⁅u, a⁆)⁻¹ * u := by
          rw [commutatorElement_inv_left, ← commutatorElement_inv u a]
        rw [h1, hcen2' _ (Subgroup.inv_mem _ hYa) u⁻¹]
        group
      have hY : ⁅u⁻¹, a⁆ ∈ powSub A 2 := hX ▸ Subgroup.inv_mem _ hYa
      calc ⁅((h.xi ^ k) u) * u⁻¹, a⁆
          = (((h.xi ^ k) u) * ⁅u⁻¹, a⁆ * ((h.xi ^ k) u)⁻¹) * ⁅(h.xi ^ k) u, a⁆ :=
            nsdL1_commutator_mul_left_eq'_ _ _ _
        _ = ⁅u⁻¹, a⁆ * ⁅(h.xi ^ k) u, a⁆ := by
              rw [hcen2' _ hY ((h.xi ^ k) u)]
              group
        _ = ⁅u, a⁆⁻¹ * ⁅u, a⁆ := by rw [hX, ← hstep2 a ha]
        _ = 1 := inv_mul_cancel _
    rw [← hCP]
    refine Subgroup.mem_centralizer_iff.mpr (fun a ha => ?_)
    have h1 : ⁅a, ((h.xi ^ k) u) * u⁻¹⁆ = 1 := by
      rw [(commutatorElement_inv (((h.xi ^ k) u) * u⁻¹) a).symm, hstep3 a ha, inv_one]
    exact commutatorElement_eq_one_iff_mul_comm.mp h1
  -- ## 5.  `V` is irreducible for `σ`
  have hirrV : ∀ U : Submodule (ZMod 2) V, (∀ v ∈ U, σ v ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    have hUeq : σ '' (U : Set V) = U := by
      refine Set.eq_of_subset_of_ncard_le (fun v hv => ?_) ?_
      · rcases hv with ⟨w, hw, rfl⟩
        exact hU w hw
      · rw [Set.ncard_image_of_injective _ σ.injective]
    let D : Subgroup P :=
      { carrier := {y : P | Additive.ofMul ((QuotientGroup.mk' A) y) ∈ U}
        one_mem' := by
          show Additive.ofMul ((QuotientGroup.mk' A) 1) ∈ U
          rw [map_one]
          exact U.zero_mem
        mul_mem' := by
          intro x y hx hy
          show Additive.ofMul ((QuotientGroup.mk' A) (x * y)) ∈ U
          rw [map_mul, ofMul_mul]
          exact U.add_mem hx hy
        inv_mem' := by
          intro x hx
          show Additive.ofMul ((QuotientGroup.mk' A) x⁻¹) ∈ U
          rw [map_inv, ofMul_inv]
          exact U.neg_mem hx }
    have hDn : D.Normal := by
      refine ⟨fun y hy g => ?_⟩
      show Additive.ofMul ((QuotientGroup.mk' A) (g * y * g⁻¹)) ∈ U
      have h1 : (QuotientGroup.mk' A) (g * y * g⁻¹) = (QuotientGroup.mk' A) y := by
        rw [map_mul, map_mul, map_inv]
        calc (QuotientGroup.mk' A) g * (QuotientGroup.mk' A) y * ((QuotientGroup.mk' A) g)⁻¹
            = (QuotientGroup.mk' A) y * ((QuotientGroup.mk' A) g * ((QuotientGroup.mk' A) g)⁻¹) := by
              rw [mul_comm ((QuotientGroup.mk' A) g) ((QuotientGroup.mk' A) y)]
              group
          _ = (QuotientGroup.mk' A) y := by rw [mul_inv_cancel, mul_one]
      rw [h1]
      exact hy
    have hDinv : D.map (h.xi : MulAut P).toMonoidHom = D := by
      refine le_antisymm ?_ ?_
      · rintro y ⟨x, hx, rfl⟩
        show Additive.ofMul ((QuotientGroup.mk' A) (h.xi x)) ∈ U
        have h2 : Additive.ofMul ((QuotientGroup.mk' A) (h.xi x))
            = σ (Additive.ofMul ((QuotientGroup.mk' A) x)) := by
          rw [σ_ofMul, ξQ_mk']
        rw [h2]
        exact hU _ hx
      · intro y hy
        refine ⟨(h.xi : MulAut P).symm y, ?_, by simp⟩
        show Additive.ofMul ((QuotientGroup.mk' A) ((h.xi : MulAut P).symm y)) ∈ U
        have h1 : σ (Additive.ofMul ((QuotientGroup.mk' A) ((h.xi : MulAut P).symm y)))
            = Additive.ofMul ((QuotientGroup.mk' A) y) := by
          rw [σ_ofMul, ξQ_mk', MulEquiv.apply_symm_apply]
        have hmem : Additive.ofMul ((QuotientGroup.mk' A) y) ∈ σ '' (U : Set V) := by
          rw [hUeq]; exact hy
        obtain ⟨w, hw, hwv⟩ := hmem
        have h2 : Additive.ofMul ((QuotientGroup.mk' A) ((h.xi : MulAut P).symm y)) = w := by
          apply σ.injective
          rw [h1, hwv]
        rw [h2]
        exact hw
    have hAD : A ≤ D := by
      intro a ha
      show Additive.ofMul ((QuotientGroup.mk' A) a) ∈ U
      rw [show (QuotientGroup.mk' A) a = 1 from by
        rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']; exact ha]
      exact U.zero_mem
    rcases hirr D hDn hDinv hAD with h1 | h1
    · left
      rw [Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = x := ⟨Additive.toMul x, rfl⟩
      obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective A w
      have hwmem : Additive.ofMul w ∈ U := hx
      have hyU : Additive.ofMul ((QuotientGroup.mk' A) y) ∈ U := by rw [hy]; exact hwmem
      have hyD : y ∈ D := hyU
      rw [h1] at hyD
      have hyA : y ∈ A := hyD
      have hzero : (QuotientGroup.mk' A) y = 1 := by
        rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']; exact hyA
      rw [← hy, hzero]
      rfl
    · right
      rw [Submodule.eq_top_iff']
      intro x
      obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = x := ⟨Additive.toMul x, rfl⟩
      obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective A w
      have hyD : y ∈ D := h1 ▸ Subgroup.mem_top y
      show Additive.ofMul w ∈ U
      rw [← hy]
      exact hyD
  -- ## 6.  `ξ ^ k` acts trivially on `V` exactly for the multiples of `2 ^ n - 1`
  have homega : ∀ k : ℕ, (∀ z : P, z ∈ omega1 P → (h.xi ^ k) z = z) ↔ (2 ^ n - 1) ∣ k := by
    intro k
    rw [← hqcard]
    exact xi_pow_triv_omega1_iff h k
  have hker : ∀ k : ℕ, ξQ ^ k = 1 ↔ (2 ^ n - 1) ∣ k := by
    intro k
    rw [htrivV k]
    constructor
    · intro hk
      exact (homega k).mp (dir1 k hk)
    · intro hk
      exact dir2 k ((homega k).mpr hk)
  have hσQ : ∀ k : ℕ, σ ^ k = 1 ↔ ξQ ^ k = 1 := by
    intro k
    constructor
    · intro hk
      refine MulEquiv.ext (fun w => ?_)
      have h1 : (σ ^ k) (Additive.ofMul w) = (Additive.ofMul w) := by
        simpa using congrArg (fun f : V ≃ₗ[ZMod 2] V => f (Additive.ofMul w)) hk
      rw [σ_pow_ofMul] at h1
      exact Additive.ofMul.injective h1
    · intro hk
      refine LinearEquiv.ext (fun v => ?_)
      obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = v := ⟨Additive.toMul v, rfl⟩
      rw [σ_pow_ofMul, hk]
      rfl
  -- ## 7.  `dim V = n`, hence `|V| = 2 ^ n`
  have hquotcard : Nat.card (P ⧸ A) = 2 ^ Module.finrank (ZMod 2) V := by
    have h1 := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)
    rw [Nat.card_zmod] at h1
    rw [← h1]
    exact Nat.card_congr (Additive.ofMul : P ⧸ A ≃ V)
  have hnm : n ∣ Module.finrank (ZMod 2) V := by
    have h1 := nsdL1_card_omega1_sub_one_dvd_card_sub_one h
    rw [hqcard] at h1
    have hP : Nat.card P = 2 ^ (2 * n + Module.finrank (ZMod 2) V) := by
      have h2 : Nat.card P = Nat.card (P ⧸ A) * Nat.card ↥A :=
        Subgroup.card_eq_card_quotient_mul_card_subgroup A
      rw [h2, hAcard, hquotcard, ← pow_add]
      ring_nf
    rw [hP] at h1
    have h3 : n ∣ 2 * n + Module.finrank (ZMod 2) V :=
      (Q3.pow_sub_one_dvd_pow_sub_one_iff (x := 2) (m := n)
        (k := 2 * n + Module.finrank (ZMod 2) V) (by norm_num) (by omega)).mp h1
    have h4 : n ∣ 2 * n := ⟨2, by ring⟩
    have h5 : n ∣ (2 * n + Module.finrank (ZMod 2) V) - 2 * n := Nat.dvd_sub h3 h4
    have h6 : (2 * n + Module.finrank (ZMod 2) V) - 2 * n = Module.finrank (ZMod 2) V := by
      omega
    rwa [h6] at h5
  have hmn : Module.finrank (ZMod 2) V ∣ n :=
    Q3.finrank_dvd_of_irreducible_pow_sub_one σ (by omega)
      ((hσQ (2 ^ n - 1)).mpr ((hker (2 ^ n - 1)).mpr (dvd_refl _))) hirrV
  have hmn_eq : Module.finrank (ZMod 2) V = n := Nat.dvd_antisymm hmn hnm
  have hVcard : Nat.card V = 2 ^ n := by
    have h1 := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)
    rw [Nat.card_zmod, hmn_eq] at h1
    exact h1
  -- ## 8.  `σ` is fixed point free
  have hfree : ∀ v : V, σ v = v → v = 0 := by
    intro v hv
    by_contra hv0
    have hspan : Submodule.span (ZMod 2) ({v} : Set V) = ⊤ := by
      have hmem : ∀ w ∈ Submodule.span (ZMod 2) ({v} : Set V),
          σ w ∈ Submodule.span (ZMod 2) ({v} : Set V) := by
        intro w hw
        rw [Submodule.mem_span_singleton] at hw ⊢
        obtain ⟨c, rfl⟩ := hw
        exact ⟨c, by rw [map_smul, hv]⟩
      rcases hirrV _ hmem with h | h
      · exfalso
        have h1 : v ∈ (⊥ : Submodule (ZMod 2) V) := by
          rw [← h]
          exact Submodule.mem_span_singleton.mpr ⟨1, one_smul _ _⟩
        exact hv0 (by simpa using h1)
      · exact h
    have hcard2 : Nat.card V ≤ 2 := by
      have hsurj : Function.Surjective (fun c : ZMod 2 => c • v) := by
        intro x
        have hx : x ∈ Submodule.span (ZMod 2) ({v} : Set V) := by rw [hspan]; trivial
        rw [Submodule.mem_span_singleton] at hx
        obtain ⟨c, hc⟩ := hx
        exact ⟨c, hc⟩
      haveI : Fintype V := Fintype.ofFinite V
      have h1 : Fintype.card V ≤ Fintype.card (ZMod 2) := Fintype.card_le_of_surjective _ hsurj
      have h2 : Nat.card V = Fintype.card V := Nat.card_eq_fintype_card
      rw [h2]
      calc Fintype.card V ≤ Fintype.card (ZMod 2) := h1
        _ = 2 := ZMod.card 2
    rw [hVcard] at hcard2
    have h4 : 4 ≤ 2 ^ n := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn2
    omega
  -- ## 9.  the order of `σ`
  have hordσ : orderOf σ = 2 ^ n - 1 := by
    refine (orderOf_eq_iff (x := σ) (show 0 < 2 ^ n - 1 by omega)).mpr ⟨?_, ?_⟩
    · rw [hσQ, hker]
    · intro m hm hmlt hcon
      have h1 : (2 ^ n - 1) ∣ m := (hker m).mp ((hσQ m).mp hcon)
      have h2 : 0 < 2 ^ n - 1 := by omega
      obtain ⟨t, ht⟩ := h1
      have h3 : 1 ≤ t := by
        rcases Nat.eq_zero_or_pos t with h0 | hpos
        · rw [h0, mul_zero] at ht
          omega
        · exact hpos
      have h4 : 2 ^ n - 1 ≤ m := by
        rw [ht]
        calc 2 ^ n - 1 = (2 ^ n - 1) * 1 := (mul_one _).symm
          _ ≤ (2 ^ n - 1) * t := Nat.mul_le_mul_left _ h3
      omega
  -- ## 10.  the Singer isomorphism and the assembly
  obtain ⟨φ, lam0, hlam0ord, hφ⟩ := exists_singer_iso hn0 hVcard σ hordσ hfree
  haveI : Fintype (GaloisField 2 n) := Fintype.ofFinite _
  let ζ : GaloisField 2 n ≃ (P ⧸ A) :=
    (φ.symm : GaloisField 2 n ≃ V).trans (Additive.toMul : V ≃ (P ⧸ A))
  refine ⟨GaloisField 2 n, inferInstance, inferInstance, inferInstance, inferInstance,
    (lam0 : GaloisField 2 n), ?_, hn2, ?_, ?_, ?_⟩
  · rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 2 n hn0.ne'
  · rw [orderOf_units]
    exact hlam0ord
  · exact Units.ne_zero lam0
  · refine ⟨ζ, ?_, ?_⟩
    · intro x y
      show Additive.toMul (φ.symm (x + y)) = Additive.toMul (φ.symm x) * Additive.toMul (φ.symm y)
      rw [map_add, toMul_add]
    · intro x u hu
      have h1 : φ.symm ((lam0 : GaloisField 2 n) * x) = σ (φ.symm x) := by
        apply φ.injective
        rw [LinearEquiv.apply_symm_apply, hφ (φ.symm x), LinearEquiv.apply_symm_apply]
      have hw : Additive.ofMul ((u : P ⧸ A)) = φ.symm x := by
        rw [hu, show ζ x = Additive.toMul (φ.symm x) from rfl]
        exact ofMul_toMul _
      have h2 : Additive.toMul (σ (φ.symm x)) = ξQ ((u : P ⧸ A)) := by
        rw [← hw, σ_ofMul]
        simp
      show Additive.toMul (φ.symm ((lam0 : GaloisField 2 n) * x)) = (h.xi u : P ⧸ A)
      rw [h1, h2]
      exact ξQ_mk u

end Work.Higman.H8.Clean
