/-!
# Auxiliary lemmas for the Higman H8 `eq_bot_or_top` target

These are the polynomial-algebra and invariant-subspace facts underlying the main argument:
the `𝔽₂[X]`-module structure on `V` induced by an endomorphism, the identification of the
subspace generated by the `σ`-orbit of a vector with the range of `p ↦ p(σ) v`, and the
square-freeness of `X ^ n - 1` over `𝔽₂` for odd `n`.
-/

namespace Work.Higman.H8

open Polynomial

/-- Two polynomial expressions in the same endomorphism commute. -/
theorem aeval_commute {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (T : V →ₗ[ZMod 2] V) (p q : Polynomial (ZMod 2)) :
    (Polynomial.aeval T) p * (Polynomial.aeval T) q
      = (Polynomial.aeval T) q * (Polynomial.aeval T) p := by
  rw [← map_mul, mul_comm, map_mul]

/-- The power of a linear equivalence, viewed as an endomorphism, is the coercion of its
power in the group of linear equivalences. -/
theorem coe_pow_eq {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : V ≃ₗ[ZMod 2] V) (k : ℕ) :
    ((σ : V →ₗ[ZMod 2] V) ^ k) = ((σ ^ k : V ≃ₗ[ZMod 2] V) : V →ₗ[ZMod 2] V) := by
  induction k with
  | zero => rw [pow_zero, pow_zero, LinearEquiv.coe_toLinearMap_one]; rfl
  | succ m ih => rw [pow_succ, pow_succ, LinearEquiv.coe_toLinearMap_mul, ih]

/-- `p(σ)` applied to a generator of a `σ`-invariant subspace stays in that subspace. -/
theorem aeval_mem_of_invariant {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (T : V →ₗ[ZMod 2] V) {Z : Submodule (ZMod 2) V} (hZ : ∀ w ∈ Z, T w ∈ Z)
    {v : V} (hv : v ∈ Z) (p : Polynomial (ZMod 2)) :
    (Polynomial.aeval T) p v ∈ Z := by
  refine Polynomial.induction_on (motive := fun q => (Polynomial.aeval T) q v ∈ Z) p ?_ ?_ ?_
  · intro a
    rw [Polynomial.aeval_C, Algebra.algebraMap_eq_smul_one, LinearMap.smul_apply,
      Module.End.one_apply]
    exact Z.smul_mem a hv
  · intro p q hp hq
    rw [map_add, LinearMap.add_apply]
    exact Z.add_mem hp hq
  · intro n a ih
    have hpoly : (Polynomial.C a * Polynomial.X ^ (n + 1) : Polynomial (ZMod 2))
        = Polynomial.X * (Polynomial.C a * Polynomial.X ^ n) := by
      rw [pow_succ]; ring
    rw [hpoly, map_mul, Polynomial.aeval_X, Module.End.mul_apply]
    exact hZ _ ih

/-- The span of the `σ`-orbit of `v` is invariant under `σ`. -/
theorem span_orbit_invariant {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : V ≃ₗ[ZMod 2] V) (v : V) :
    ∀ w ∈ Submodule.span (ZMod 2) (Set.range (fun k : ℕ => (σ ^ k) v)),
      (σ : V →ₗ[ZMod 2] V) w ∈ Submodule.span (ZMod 2) (Set.range (fun k : ℕ => (σ ^ k) v)) := by
  have hmap : Submodule.map (σ : V →ₗ[ZMod 2] V)
      (Submodule.span (ZMod 2) (Set.range (fun k : ℕ => (σ ^ k) v)))
      ≤ Submodule.span (ZMod 2) (Set.range (fun k : ℕ => (σ ^ k) v)) := by
    rw [Submodule.map_le_iff_le_comap, Submodule.span_le]
    rintro x ⟨k, rfl⟩
    simp only [SetLike.mem_coe, Submodule.mem_comap]
    have hx : (σ : V →ₗ[ZMod 2] V) ((σ ^ k) v) = (σ ^ (k + 1)) v := by
      rw [pow_succ']
      exact (LinearEquiv.mul_apply σ (σ ^ k) v).symm
    rw [hx]
    exact Submodule.subset_span ⟨k + 1, rfl⟩
  intro w hw
  exact hmap ⟨w, hw, rfl⟩

/-- The range of `p ↦ p(σ) v` is the span of the `σ`-orbit of `v`. -/
theorem evalAt_range_eq_span {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : V ≃ₗ[ZMod 2] V) (v : V) :
    LinearMap.range (evalAt (σ : V →ₗ[ZMod 2] V) v)
      = Submodule.span (ZMod 2) (Set.range (fun k : ℕ => (σ ^ k) v)) := by
  apply le_antisymm
  · rintro x ⟨p, rfl⟩
    exact aeval_mem_of_invariant (σ : V →ₗ[ZMod 2] V) (span_orbit_invariant σ v)
      (Submodule.subset_span ⟨0, by simp⟩) p
  · rw [Submodule.span_le]
    rintro x ⟨k, rfl⟩
    refine ⟨Polynomial.X ^ k, ?_⟩
    rw [evalAt_apply, Polynomial.aeval_X_pow, coe_pow_eq]
    rfl

/-- `X ^ n - 1` annihilates `V` under `σ` when `n` is the order of `σ`. -/
theorem aeval_X_pow_orderOf_sub_one {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : V ≃ₗ[ZMod 2] V) :
    (Polynomial.aeval (σ : V →ₗ[ZMod 2] V))
      ((Polynomial.X : Polynomial (ZMod 2)) ^ orderOf σ - 1) = 0 := by
  have hpow : ((σ : V →ₗ[ZMod 2] V) ^ orderOf σ) = 1 := by
    rw [coe_pow_eq, pow_orderOf_eq_one, LinearEquiv.coe_toLinearMap_one]; rfl
  show (Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) (Polynomial.X ^ orderOf σ - 1) = 0
  rw [map_sub, map_one, Polynomial.aeval_X_pow, hpow, sub_self]

/-- Splitting of `V` along two coprime polynomials annihilated in product by `T`. -/
theorem ker_add_ker_of_coprime {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (T : V →ₗ[ZMod 2] V) {f g : Polynomial (ZMod 2)} (hcop : IsCoprime f g)
    (hfg : (Polynomial.aeval T) (f * g) = 0) :
    LinearMap.ker ((Polynomial.aeval T) f) ⊔ LinearMap.ker ((Polynomial.aeval T) g) = ⊤ := by
  rw [Polynomial.sup_ker_aeval_eq_ker_aeval_mul_of_coprime T hcop, hfg]
  exact LinearMap.ker_zero

/-- `X ^ n - 1` is square-free over `𝔽₂` when `n` is odd. -/
theorem squarefree_X_pow_sub_one {n : ℕ} (hn : Odd n) :
    Squarefree ((Polynomial.X : Polynomial (ZMod 2)) ^ n - 1) := by
  have h : ((n : ZMod 2)) ≠ 0 := by
    intro h0
    rw [CharP.cast_eq_zero_iff (ZMod 2) 2 n] at h0
    obtain ⟨k, hk⟩ := hn
    omega
  exact Polynomial.Separable.squarefree (Polynomial.X_pow_sub_one_separable_iff.mpr h)

/-- If `v` lies in the kernel of `f(σ)` and generates `V` under `σ`, then `f(σ) = 0`. -/
theorem aeval_eq_zero_of_mem_ker_orbit_top {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : V ≃ₗ[ZMod 2] V) (f : Polynomial (ZMod 2)) {v : V}
    (hv : v ∈ LinearMap.ker ((Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f))
    (hspan : Submodule.span (ZMod 2) (Set.range (fun k : ℕ => (σ ^ k) v)) = ⊤) :
    (Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f = 0 := by
  rw [← LinearMap.ker_eq_top, eq_top_iff, ← hspan, Submodule.span_le]
  rintro x ⟨k, rfl⟩
  have hcomm : (Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f * (σ : V →ₗ[ZMod 2] V)
      = (σ : V →ₗ[ZMod 2] V) * (Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f := by
    have h := aeval_commute (σ : V →ₗ[ZMod 2] V) f Polynomial.X
    rwa [Polynomial.aeval_X] at h
  have hinv : ∀ w ∈ LinearMap.ker ((Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f),
      (σ : V →ₗ[ZMod 2] V) w ∈ LinearMap.ker ((Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f) := by
    intro w hw
    rw [LinearMap.mem_ker] at hw ⊢
    rw [← Module.End.mul_apply, hcomm, Module.End.mul_apply, hw, map_zero]
  induction k with
  | zero => simpa using hv
  | succ j ih =>
      have hstep : (σ ^ (j + 1)) v = (σ : V →ₗ[ZMod 2] V) ((σ ^ j) v) := by
        rw [pow_succ']; exact LinearEquiv.mul_apply σ (σ ^ j) v
      change (σ ^ (j + 1)) v ∈ ↑((Polynomial.aeval (σ : V →ₗ[ZMod 2] V)) f).ker
      rw [hstep]; exact hinv _ ih

end Work.Higman.H8
