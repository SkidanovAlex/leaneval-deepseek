namespace Work.Higman.H8

/-- If a subgroup `A` of a group `P` is invariant under an automorphism `φ`, it is invariant
under every element of the cyclic subgroup `⟨φ⟩` generated by `φ`.

Proof: the set of automorphisms preserving `A` is a subgroup of `MulAut P` (one checks
`1`, products and inverses: use `Subgroup.map_map` and, for inverses,
`Subgroup.map φ⁻¹ = A ↔ Subgroup.map φ (Subgroup.map φ⁻¹ A) = Subgroup.map φ A` together with
`φ * φ⁻¹ = 1`), and it contains `φ`, so it contains `Subgroup.zpowers φ` by
`Subgroup.zpowers_le`.  Note the group `⟨φ⟩` may contain `φ⁻¹`, so the statement is *not*
immediate; it is true because `map φ⁻¹ A = A` follows from `map φ A = A` by applying `map φ`
and using injectivity of `Subgroup.map` for the bijection `φ`. -/
theorem map_eq_of_mem_zpowers {P : Type} [Group P] {A : Subgroup P} {φ : MulAut P}
    (hφ : A.map (φ : MulAut P).toMonoidHom = A) :
    ∀ ψ ∈ Subgroup.zpowers φ, A.map (ψ : MulAut P).toMonoidHom = A := by
  -- The set of automorphisms preserving `A` is a subgroup of `MulAut P`.
  set S : Subgroup (MulAut P) :=
    { carrier := {ψ | A.map (ψ : MulAut P).toMonoidHom = A}
      mul_mem' := by
        intro x y hx hy
        show A.map (x * y).toMonoidHom = A
        rw [show (x * y).toMonoidHom = x.toMonoidHom.comp y.toMonoidHom from rfl,
            ← Subgroup.map_map A x.toMonoidHom y.toMonoidHom, hy, hx]
      one_mem' := by
        show A.map (1 : MulAut P).toMonoidHom = A
        rw [show (1 : MulAut P).toMonoidHom = MonoidHom.id P from rfl, Subgroup.map_id]
      inv_mem' := by
        intro x hx
        -- `map x.toMonoidHom` is injective, so it suffices to compare images.
        apply Subgroup.map_injective (f := x.toMonoidHom) x.injective
        rw [Subgroup.map_map]
        rw [show x.toMonoidHom.comp (x⁻¹).toMonoidHom = (x * x⁻¹).toMonoidHom from rfl,
            mul_inv_cancel, show (1 : MulAut P).toMonoidHom = MonoidHom.id P from rfl,
            Subgroup.map_id, hx] } with hS
  have hφS : φ ∈ S := hφ
  intro ψ hψ
  exact (Subgroup.zpowers_le.mpr hφS) hψ

end Work.Higman.H8
