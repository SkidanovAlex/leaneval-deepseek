open scoped commutatorElement

namespace Work.Higman.H8

variable {P : Type} [Group P]

/-- For a central subgroup `Z ≤ Z(P)` and a fixed element `g`, the set of elements `y` whose
commutator `⁅g, y⁆ = g*y*g⁻¹*y⁻¹` with `g` lies in `Z` is a subgroup of `P`. (This is the
preimage in `P` of the centralizer of the image of `g` in `P ⧸ Z`.) -/
def commZ (Z : Subgroup P) (hZc : Z ≤ Subgroup.center P) (g : P) : Subgroup P where
  carrier := {y : P | ⁅g, y⁆ ∈ Z}
  mul_mem' := by
    intro a b ha hb
    change ⁅g, a * b⁆ ∈ Z
    have hconj : a * ⁅g, b⁆ * a⁻¹ = ⁅g, b⁆ := by
      have hcomm : a * ⁅g, b⁆ = ⁅g, b⁆ * a := Subgroup.mem_center_iff.mp (hZc hb) a
      rw [hcomm]; group
    rw [commutatorElement_mul_right_eq_mul_conj]
    rw [show ⁅g, a⁆ * a * ⁅g, b⁆ * a⁻¹ = ⁅g, a⁆ * (a * ⁅g, b⁆ * a⁻¹) by group, hconj]
    exact Z.mul_mem ha hb
  one_mem' := by
    change ⁅g, 1⁆ ∈ Z
    rw [commutatorElement_one_right]; exact Z.one_mem
  inv_mem' := by
    intro a ha
    change ⁅g, a⁻¹⁆ ∈ Z
    have h2 : ⁅a, g⁆ ∈ Z := by rw [← commutatorElement_inv]; exact Z.inv_mem ha
    have hconj : a⁻¹ * ⁅a, g⁆ * a = ⁅a, g⁆ := by
      have hcomm : a⁻¹ * ⁅a, g⁆ = ⁅a, g⁆ * a⁻¹ := Subgroup.mem_center_iff.mp (hZc h2) a⁻¹
      rw [hcomm]; group
    rw [commutatorElement_inv_right, hconj]
    exact h2

/-- Elementary group-theory lemma (no finiteness, no Suzuki hypothesis). Let `Z` be a central subgroup of `P` (i.e. `Z ≤ Subgroup.center P`) and let `H ≤ P`, `x : P` satisfy: every square of an element of `H` lies in `Z`, every commutator `h₁h₂h₁⁻¹h₂⁻¹` of elements of `H` lies in `Z`, `x*x ∈ Z`, and `x h x⁻¹ h⁻¹ ∈ Z` for every `h ∈ H`. Then the subgroup `M := H ⊔ ⟨x⟩` generated by `H` and `x` satisfies `M² ⊆ Z` and all commutators of elements of `M` lie in `Z`.

Proof sketch: put `T := {m : P | m ∈ M ∧ m*m ∈ Z ∧ (∀ b ∈ M, m*b*m⁻¹*b⁻¹ ∈ Z) ∧ (∀ b ∈ M, b*m*b⁻¹*m⁻¹ ∈ Z)}`. `T` is a subgroup of `P`: use that `Z` is central hence normal, `y*z*y⁻¹*z⁻¹ = (z*y*z⁻¹*y⁻¹)⁻¹`, the general identity `(a*b)*(a*b) = (a*b*a⁻¹*b⁻¹) * (a*a) * (b*b)` valid when `a*a` is central, and the general identities `(g₁g₂)z(g₁g₂)⁻¹z⁻¹ = g₁(g₂zg₂⁻¹z⁻¹)g₁⁻¹ * (g₁zg₁⁻¹z⁻¹)` and `z(g₁g₂)z⁻¹(g₁g₂)⁻¹ = (zg₁z⁻¹g₁⁻¹) * g₁(zg₂z⁻¹g₂⁻¹)g₁⁻¹`. For fixed `h ∈ H` the set `{g : P | h*g*h⁻¹*g⁻¹ ∈ Z}` is a subgroup containing both `H` and `x`; hence it contains `M`, so every element of `M` commutes with `h` modulo `Z` in both orders. The same holds with `x` in place of `h`. Therefore `H ∪ {x} ⊆ T`; as `M` is generated by `H ∪ {x}` and `T` is a subgroup, `M ≤ T`, which is exactly the two conclusions. -/
theorem powSub_sup_zpowers_le {P : Type} [Group P] (Z : Subgroup P)
    (hZc : Z ≤ Subgroup.center P) {H : Subgroup P} {x : P}
    (hH2 : ∀ h ∈ H, h * h ∈ Z)
    (hHd : ∀ h₁ ∈ H, ∀ h₂ ∈ H, h₁ * h₂ * h₁⁻¹ * h₂⁻¹ ∈ Z)
    (hx2 : x * x ∈ Z)
    (hxd : ∀ h ∈ H, x * h * x⁻¹ * h⁻¹ ∈ Z) :
    Work.Higman.powSub (H ⊔ Subgroup.zpowers x) 2 ≤ Z ∧
      ∀ a ∈ H ⊔ Subgroup.zpowers x, ∀ b ∈ H ⊔ Subgroup.zpowers x,
        a * b * a⁻¹ * b⁻¹ ∈ Z := by
  -- Every element of `H` commutes with every element of `M := H ⊔ ⟨x⟩` modulo `Z`.
  have chM : ∀ h ∈ H, ∀ m ∈ H ⊔ Subgroup.zpowers x, ⁅h, m⁆ ∈ Z := by
    intro h hh m hm
    have hle : H ⊔ Subgroup.zpowers x ≤ commZ Z hZc h := by
      apply sup_le
      · intro h' hh'
        change ⁅h, h'⁆ ∈ Z
        rw [commutatorElement_def]
        exact hHd h hh h' hh'
      · rw [Subgroup.zpowers_le]
        change ⁅h, x⁆ ∈ Z
        rw [commutatorElement_def]
        have := Z.inv_mem (hxd h hh)
        rwa [show (x * h * x⁻¹ * h⁻¹)⁻¹ = h * x * h⁻¹ * x⁻¹ by group] at this
    exact hle hm
  -- Every element of `M` commutes with `x` modulo `Z`.
  have cxM : ∀ m ∈ H ⊔ Subgroup.zpowers x, ⁅x, m⁆ ∈ Z := by
    intro m hm
    have hle : H ⊔ Subgroup.zpowers x ≤ commZ Z hZc x := by
      apply sup_le
      · intro h' hh'
        change ⁅x, h'⁆ ∈ Z
        rw [commutatorElement_def]
        exact hxd h' hh'
      · rw [Subgroup.zpowers_le]
        change ⁅x, x⁆ ∈ Z
        rw [commutatorElement_self]
        exact Z.one_mem
    exact hle hm
  -- The subgroup `T` of the proof sketch.
  let T : Subgroup P :=
    { carrier := {m : P | m ∈ H ⊔ Subgroup.zpowers x ∧ m * m ∈ Z ∧
        (∀ b ∈ H ⊔ Subgroup.zpowers x, ⁅m, b⁆ ∈ Z) ∧
        (∀ b ∈ H ⊔ Subgroup.zpowers x, ⁅b, m⁆ ∈ Z)}
      mul_mem' := by
        intro a b ha hb
        obtain ⟨haM, ha2, haF, haB⟩ := ha
        obtain ⟨hbM, hb2, hbF, hbB⟩ := hb
        refine ⟨?_, ?_, ?_, ?_⟩
        · exact (H ⊔ Subgroup.zpowers x).mul_mem haM hbM
        · -- `(a*b)² = ⁅a,b⁆ * a² * b²`, all three factors of which lie in `Z`.
          have hab : a * b = ⁅a, b⁆ * b * a := by
            rw [← conj_eq_commutatorElement_mul, MulAut.conj_apply]; group
          have hc : (a*a) * b = b * (a*a) := (Subgroup.mem_center_iff.mp (hZc ha2) b).symm
          have hc2 : (b*b) * (a*a) = (a*a) * (b*b) :=
            Subgroup.mem_center_iff.mp (hZc ha2) (b*b)
          have hsq : (a*b)*(a*b) = ⁅a,b⁆ * (a*a) * (b*b) := by
            calc (a*b)*(a*b) = (⁅a,b⁆ * b * a) * (a*b) := by rw [hab]
              _ = ⁅a,b⁆ * (b * ((a*a) * b)) := by group
              _ = ⁅a,b⁆ * ((b*b) * (a*a)) := by rw [hc]; group
              _ = ⁅a,b⁆ * ((a*a) * (b*b)) := by rw [hc2]
              _ = ⁅a,b⁆ * (a*a) * (b*b) := by group
          rw [hsq]
          exact Z.mul_mem (Z.mul_mem (haF b hbM) ha2) hb2
        · -- `⁅a*b, c⁆ = a·⁅b,c⁆·a⁻¹ · ⁅a,c⁆`.
          intro c hcM
          rw [commutatorElement_mul_left_eq_conj_mul]
          rw [show a * ⁅b, c⁆ * a⁻¹ = ⁅b, c⁆ by
            have hcomm := Subgroup.mem_center_iff.mp (hZc (hbF c hcM)) a
            rw [hcomm]; group]
          exact Z.mul_mem (hbF c hcM) (haF c hcM)
        · -- `⁅c, a*b⁆ = ⁅c,a⁆ · a·⁅c,b⁆·a⁻¹`.
          intro c hcM
          rw [commutatorElement_mul_right_eq_mul_conj]
          rw [show ⁅c, a⁆ * a * ⁅c, b⁆ * a⁻¹ = ⁅c, a⁆ * (a * ⁅c, b⁆ * a⁻¹) by group]
          rw [show a * ⁅c, b⁆ * a⁻¹ = ⁅c, b⁆ by
            have hcomm := Subgroup.mem_center_iff.mp (hZc (hbB c hcM)) a
            rw [hcomm]; group]
          exact Z.mul_mem (haB c hcM) (hbB c hcM)
      one_mem' := by
        refine ⟨(H ⊔ Subgroup.zpowers x).one_mem, ?_, ?_, ?_⟩
        · simp
        · intro b _; rw [commutatorElement_one_left]; exact Z.one_mem
        · intro b _; rw [commutatorElement_one_right]; exact Z.one_mem
      inv_mem' := by
        intro a ha
        obtain ⟨haM, ha2, haF, haB⟩ := ha
        refine ⟨(H ⊔ Subgroup.zpowers x).inv_mem haM, ?_, ?_, ?_⟩
        · have h : a⁻¹ * a⁻¹ = (a*a)⁻¹ := by group
          rw [h]; exact Z.inv_mem ha2
        · intro c hcM
          rw [commutatorElement_inv_left]
          rw [show a⁻¹ * ⁅c, a⁆ * a = ⁅c, a⁆ by
            have hcomm := Subgroup.mem_center_iff.mp (hZc (haB c hcM)) a⁻¹
            rw [hcomm]; group]
          exact haB c hcM
        · intro c hcM
          rw [commutatorElement_inv_right]
          rw [show a⁻¹ * ⁅a, c⁆ * a = ⁅a, c⁆ by
            have hcomm := Subgroup.mem_center_iff.mp (hZc (haF c hcM)) a⁻¹
            rw [hcomm]; group]
          exact haF c hcM }
  -- Both `H` and `x` lie in `T`, so `M ≤ T`.
  have hMT : H ⊔ Subgroup.zpowers x ≤ T := by
    apply sup_le
    · intro h hh
      refine ⟨Subgroup.mem_sup_left hh, hH2 h hh, ?_, ?_⟩
      · intro b hb; exact chM h hh b hb
      · intro b hb; rw [← commutatorElement_inv]; exact Z.inv_mem (chM h hh b hb)
    · rw [Subgroup.zpowers_le]
      refine ⟨Subgroup.mem_sup_right (Subgroup.mem_zpowers x), hx2, ?_, ?_⟩
      · intro b hb; exact cxM b hb
      · intro b hb; rw [← commutatorElement_inv]; exact Z.inv_mem (cxM b hb)
  constructor
  · -- `M² ⊆ Z`: the generators `m²` (`m ∈ M`) of `powSub M 2` all lie in `Z`.
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨m, hm, rfl⟩
    obtain ⟨-, hm2, -, -⟩ := hMT hm
    rwa [pow_two]
  · -- Commutators of elements of `M` lie in `Z`.
    intro a ha b hb
    obtain ⟨-, -, haF, -⟩ := hMT ha
    exact haF b hb

end Work.Higman.H8
