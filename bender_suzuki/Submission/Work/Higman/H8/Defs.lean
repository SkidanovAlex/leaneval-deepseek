/-!
# Shared definitions for the Higman H8 `eq_bot_or_top` lemma

We work with a finite `𝔽₂`-module `V` and a linear automorphism `σ`.  The main ingredient of the
corresponding proof is the `𝔽₂[X]`-module structure on `V` induced by `σ`, where a polynomial `p`
acts by `p(σ)`.  For a fixed vector `v` the map `p ↦ p(σ) v` is `𝔽₂`-linear; its range is the
`σ`-invariant subspace generated by `v`, and the target statement becomes the assertion that this
range is everything for every non-zero `v`.
-/

namespace Work.Higman.H8

/-- The `𝔽₂`-linear map `𝔽₂[X] → V`, `p ↦ p(T) v`, where the polynomial `p` acts on `V` through
the endomorphism `T`. -/
noncomputable def evalAt {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (T : V →ₗ[ZMod 2] V) (v : V) : Polynomial (ZMod 2) →ₗ[ZMod 2] V where
  toFun p := (Polynomial.aeval T) p v
  map_add' p q := by
    rw [map_add, LinearMap.add_apply]
  map_smul' c p := by
    rw [map_smul, LinearMap.smul_apply, RingHom.id_apply]

@[simp]
lemma evalAt_apply {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (T : V →ₗ[ZMod 2] V) (v : V) (p : Polynomial (ZMod 2)) :
    evalAt T v p = (Polynomial.aeval T) p v := rfl

@[simp]
lemma evalAt_X {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (T : V →ₗ[ZMod 2] V) (v : V) :
    evalAt T v (Polynomial.X : Polynomial (ZMod 2)) = T v := by
  simp [evalAt_apply]

end Work.Higman.H8
