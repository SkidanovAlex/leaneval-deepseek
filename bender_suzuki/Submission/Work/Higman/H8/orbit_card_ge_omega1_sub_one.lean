variable {P : Type} [Group P] [Finite P]

/-- In a finite group, every element of the cyclic subgroup generated by `a` is a non-negative
power of `a`.  (Mathlib only provides the version with integer exponents,
`Subgroup.mem_zpowers_iff`; here we reduce a negative exponent modulo `orderOf a`.) -/
theorem zpowers_exists_nat_pow {H : Type*} [Group H] [Finite H] (a : H) {g : H}
    (hg : g ∈ Subgroup.zpowers a) : ∃ j : ℕ, g = a ^ j := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hg
  have hn : a ^ orderOf a = 1 := pow_orderOf_eq_one a
  have hne : (orderOf a : ℤ) ≠ 0 := by
    have hpos : 0 < orderOf a := orderOf_pos a
    exact_mod_cast hpos.ne'
  refine ⟨((k % (orderOf a : ℤ))).toNat, ?_⟩
  have h1 : a ^ k = a ^ (k % (orderOf a : ℤ)) := zpow_eq_zpow_emod' k hn
  have h3 : k % (orderOf a : ℤ) = ((k % (orderOf a : ℤ)).toNat : ℤ) :=
    (Int.toNat_of_nonneg (Int.emod_nonneg k hne)).symm
  have h4 : a ^ ((k % (orderOf a : ℤ)).toNat) = a ^ (k % (orderOf a : ℤ)) := by
    conv_rhs => rw [h3]
    exact (zpow_natCast a _).symm
  rw [← hk, h1, ← h4]

/-- **The orbit of an involution under `⟨ξ⟩` is the whole set of involutions** (this is just the
transitivity of `ξ` on the involutions). -/
theorem orbit_invol_xi (h : Work.Higman.IsSuzuki2Grp P) {u : P} (hu : orderOf u = 2) :
    (MulAction.orbit (Subgroup.zpowers (h.xi : MulAut P)) u : Set P) = Work.Higman.Invol P := by
  ext z
  rw [MulAction.mem_orbit_iff, Work.Higman.mem_Invol]
  constructor
  · rintro ⟨g, rfl⟩
    show orderOf (g • u) = 2
    rw [show g • u = (g : MulAut P) u from rfl, MulEquiv.orderOf_eq, hu]
  · intro hz
    obtain ⟨k, hk⟩ := h.trans u z hu hz
    refine ⟨⟨h.xi ^ k, ?_⟩, hk⟩
    exact Subgroup.pow_mem (Subgroup.zpowers (h.xi : MulAut P)) (Subgroup.mem_zpowers _) k

/-- **Every `⟨ξ⟩`-orbit on `(P/A) \ {0}` has at least `|Ω₁(P)| - 1` elements.**

Situation: `P` is a Suzuki 2-group, `A ⊴ P` is abelian and `ξ`-invariant with `Ω₁(P) ≤ A`,
`A² = Ω₁(P)`, and every square of `P` lies in `A`.  Then for `x ∉ A` the set of cosets
`ξ ^ j x · A` (`j ∈ ℕ`) has at least `|Ω₁(P)| - 1` elements.

Proof strategy.  `Work.Higman.fixed_coset_of_nontrivial_omega1` (imported; sorry-free) says that
the stabiliser in `⟨ξ⟩` of the coset `xA` is contained in the kernel `K` of the action of `⟨ξ⟩`
on `Ω₁(P)`.  Orbit–stabiliser for the action of `G := ⟨h.xi⟩` (a subgroup of `MulAut P`) on the
coset space `P ⧸ A` gives `|orbit| = |G| / |Stab| ≥ |G| / |K|`, and `|G| / |K| = |Ω₁(P)| - 1`
because `ξ` acts transitively on `Ω₁(P) \ {1}` (`Work.Higman.IsSuzuki2Grp.trans`, which produces
for any two involutions `z, w` a `j` with `(ξ ^ j) z = w`) with stabiliser exactly `K`
(`Work.Higman.fix_all_omega1_of_fix`: fixing one non-trivial element of `Ω₁(P)` fixes them all).
Since `|Ω₁(P)| = q ≥ 4` there is at least one non-trivial involution, so the orbit size `q - 1`
is realised. -/
theorem orbit_card_ge_omega1_sub_one {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P} [A.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A) (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ A) {x : P} (hxA : x ∉ A) :
    Nat.card ↥(Work.Higman.omega1 P) - 1 ≤
      Nat.card {q : P ⧸ A // ∃ j : ℕ, q = QuotientGroup.mk ((h.xi ^ j) x)} := by
  classical
  -- ## 0.  The acting group `G = ⟨ξ⟩ ≤ MulAut P` and invariance of `A`
  set G : Subgroup (MulAut P) := Subgroup.zpowers (h.xi : MulAut P) with hG
  have hGinv : ∀ g ∈ G, A.map (g : MulAut P).toMonoidHom = A := by
    intro g hg
    exact map_eq_of_mem_zpowers (φ := (h.xi : MulAut P)) hAinv g (by rwa [hG] at hg)
  -- ## 1.  An involution of `P`
  obtain ⟨u, -, hu2, -, -⟩ := h.manyInvol
  have hu_sq : u ^ 2 = 1 := by rw [← orderOf_dvd_iff_pow_eq_one, hu2]
  have hu_om : u ∈ Work.Higman.omega1 P := h.mem_omega1.mpr hu_sq
  -- ## 2.  Orbit–stabiliser for the involution `u`: `|Invol P| * |K| = |G| = orderOf ξ`
  have horb_u : Nat.card ↥(MulAction.orbit G u) = (Work.Higman.Invol P).ncard := by
    rw [hG, Nat.card_coe_set_eq, orbit_invol_xi h hu2]
  have hos_u : (Work.Higman.Invol P).ncard * Nat.card ↥(MulAction.stabilizer G u) =
      orderOf h.xi := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup G u)
    rw [Nat.card_prod, hG, Nat.card_zpowers] at hh
    rwa [horb_u] at hh
  -- ## 3.  The stabiliser of the coset `xA` is contained in the stabiliser of `u`
  have hle : Nat.card {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} ≤
      Nat.card ↥(MulAction.stabilizer G u) := by
    let f : {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} → ↥(MulAction.stabilizer G u) :=
      fun g => ⟨g.1, by
        rw [MulAction.mem_stabilizer_iff]
        obtain ⟨j, hj⟩ := zpowers_exists_nat_pow (H := MulAut P) (h.xi : MulAut P)
          (by rw [← hG]; exact g.1.2)
        have hfix : ((h.xi ^ j) x) * x⁻¹ ∈ A := by rw [← hj]; exact g.2
        have hfixall : ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ j) w = w :=
          Work.Higman.fixed_coset_imp_fix_all h (inferInstance : A.Normal) hAinv hAab hNA htop hsq
            hxA hfix
        show (g.1 : G) • u = u
        rw [show (g.1 : G) • u = (g.1 : MulAut P) u from rfl, hj]
        exact hfixall u hu_om⟩
    refine Nat.card_le_card_of_injective f ?_
    intro a b hab
    exact Subtype.ext (congrArg (fun t : ↥(MulAction.stabilizer G u) => (t : G)) hab)
  -- ## 4.  Orbit–stabiliser for the coset `xA`: `|orbit| * |Stab| = |G|`
  have hos_x : Nat.card {w : P ⧸ A // ∃ g : G, w = QuotientGroup.mk ((g : MulAut P) x)} *
      Nat.card {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} = Nat.card ↥G :=
    card_orbit_coset_mul_card_stab G hGinv x
  have hcardG : Nat.card ↥G = orderOf h.xi := by rw [hG, Nat.card_zpowers]
  have hs_pos : 0 < Nat.card {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} := by
    haveI : Nonempty {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} := ⟨⟨1, by simp⟩⟩
    exact Nat.card_pos
  -- ## 5.  The orbit of `xA` has at least `|Invol P| = |Ω₁(P)| - 1` elements
  have hmain : (Work.Higman.Invol P).ncard ≤
      Nat.card {w : P ⧸ A // ∃ g : G, w = QuotientGroup.mk ((g : MulAut P) x)} := by
    have h1 : (Work.Higman.Invol P).ncard * Nat.card {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} ≤
        Nat.card {w : P ⧸ A // ∃ g : G, w = QuotientGroup.mk ((g : MulAut P) x)} *
          Nat.card {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A} := by
      rw [hos_x, hcardG]
      calc (Work.Higman.Invol P).ncard * Nat.card {g : G // ((g : MulAut P) x) * x⁻¹ ∈ A}
          ≤ (Work.Higman.Invol P).ncard * Nat.card ↥(MulAction.stabilizer G u) :=
            Nat.mul_le_mul_left _ hle
        _ = orderOf h.xi := hos_u
    exact Nat.le_of_mul_le_mul_right h1 hs_pos
  -- ## 6.  Identification of the orbit with the set of `ξ`-powers of `x`
  have hset : Nat.card {w : P ⧸ A // ∃ g : G, w = QuotientGroup.mk ((g : MulAut P) x)} =
      Nat.card {q : P ⧸ A // ∃ j : ℕ, q = QuotientGroup.mk ((h.xi ^ j) x)} :=
    Nat.card_congr (Equiv.subtypeEquivRight (fun w => ⟨fun ⟨g, hg⟩ => by
      obtain ⟨j, hj⟩ := zpowers_exists_nat_pow (H := MulAut P) (h.xi : MulAut P)
        (by rw [← hG]; exact g.2)
      exact ⟨j, by rw [hg, hj]⟩, fun ⟨j, hj⟩ => by
      exact ⟨⟨(h.xi : MulAut P) ^ j, by
        rw [hG]; exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) j⟩, hj⟩⟩))
  -- ## 7.  Conclusion
  have h5 : (Work.Higman.Invol P).ncard = Nat.card ↥(Work.Higman.omega1 P) - 1 := by
    rw [h.card_omega1]
    omega
  calc Nat.card ↥(Work.Higman.omega1 P) - 1
      = (Work.Higman.Invol P).ncard := h5.symm
    _ ≤ Nat.card {w : P ⧸ A // ∃ g : G, w = QuotientGroup.mk ((g : MulAut P) x)} := hmain
    _ = Nat.card {q : P ⧸ A // ∃ j : ℕ, q = QuotientGroup.mk ((h.xi ^ j) x)} := hset

end Work.Higman.H8
