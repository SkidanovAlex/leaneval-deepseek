namespace Work.Higman

variable {P : Type} [Group P] [Finite P]

/-! ## The map `φ_v(a) = a · (v⁻¹ a v)` -/

/-- `a · (v⁻¹ a v)`. -/
def phiVal (v a : P) : P := a * (v⁻¹ * a * v)

@[simp] theorem phiVal_one (v : P) : phiVal v 1 = 1 := by
  simp [phiVal]

theorem phiVal_mul {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) (v : P) {a b : P} (ha : a ∈ A) (hb : b ∈ A) :
    phiVal v (a * b) = phiVal v a * phiVal v b := by
  have hc : v⁻¹ * a * v ∈ A := by simpa using hAn.conj_mem a ha v⁻¹
  have hcomm : b * (v⁻¹ * a * v) = (v⁻¹ * a * v) * b := hAb b hb _ hc
  simp only [phiVal]
  rw [show v⁻¹ * (a * b) * v = (v⁻¹ * a * v) * (v⁻¹ * b * v) from by group]
  rw [show a * b * ((v⁻¹ * a * v) * (v⁻¹ * b * v))
      = a * (b * (v⁻¹ * a * v)) * (v⁻¹ * b * v) from by group, hcomm]
  group

theorem phiVal_inv {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) (v : P) {a : P} (ha : a ∈ A) :
    phiVal v a⁻¹ = (phiVal v a)⁻¹ := by
  have hc : v⁻¹ * a * v ∈ A := by simpa using hAn.conj_mem a ha v⁻¹
  have hcomm : (v⁻¹ * a * v)⁻¹ * a⁻¹ = a⁻¹ * (v⁻¹ * a * v)⁻¹ :=
    hAb _ (A.inv_mem hc) _ (A.inv_mem ha)
  have h3 : phiVal v a⁻¹ = a⁻¹ * (v⁻¹ * a * v)⁻¹ := by
    show a⁻¹ * (v⁻¹ * a⁻¹ * v) = a⁻¹ * (v⁻¹ * a * v)⁻¹
    rw [show v⁻¹ * a⁻¹ * v = (v⁻¹ * a * v)⁻¹ from by group]
  have h4 : (phiVal v a)⁻¹ = (v⁻¹ * a * v)⁻¹ * a⁻¹ := by
    show (a * (v⁻¹ * a * v))⁻¹ = (v⁻¹ * a * v)⁻¹ * a⁻¹
    rw [mul_inv_rev]
  rw [h3, h4, hcomm]

/-- `ξ` commutes with forming `phiVal`. -/
theorem phiVal_xi (h : IsSuzuki2Grp P) (v a : P) :
    h.xi (phiVal v a) = phiVal (h.xi v) (h.xi a) := by
  simp only [phiVal, map_mul, map_inv]

/-- Elements of the same `A`-coset induce the same conjugation on `A`. -/
theorem coset_conj_eq {A : Subgroup P} (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) {v u : P}
    (hv : v * u⁻¹ ∈ A) {x : P} (hx : x ∈ A) : v⁻¹ * x * v = u⁻¹ * x * u := by
  have hcomm : (v * u⁻¹)⁻¹ * x = x * (v * u⁻¹)⁻¹ := hAb _ (A.inv_mem hv) _ hx
  calc v⁻¹ * x * v = u⁻¹ * (v * u⁻¹)⁻¹ * x * ((v * u⁻¹) * u) := by group
    _ = u⁻¹ * ((v * u⁻¹)⁻¹ * x) * ((v * u⁻¹) * u) := by group
    _ = u⁻¹ * (x * (v * u⁻¹)⁻¹) * ((v * u⁻¹) * u) := by rw [hcomm]
    _ = u⁻¹ * x * u := by group

/-- `(b * u)² = u² * φ_u(b)` when `b, u² ∈ A` and `A` is abelian and normal. -/
theorem sq_mul_eq_phiVal {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) {u b : P}
    (hb : b ∈ A) (hu2 : u ^ 2 ∈ A) : (b * u) ^ 2 = u ^ 2 * phiVal u b := by
  have hc : u⁻¹ * b * u ∈ A := by simpa using hAn.conj_mem b hb u⁻¹
  have hup : u ^ 2 * (u⁻¹ * b * u) = (u⁻¹ * b * u) * u ^ 2 := hAb _ hu2 _ hc
  have h1 : u * b * u⁻¹ = u⁻¹ * b * u := by
    have h2 : u ^ 2 * (u⁻¹ * b * u) * (u ^ 2)⁻¹ = u⁻¹ * b * u := by rw [hup]; group
    calc u * b * u⁻¹ = u ^ 2 * (u⁻¹ * b * u) * (u ^ 2)⁻¹ := by group
      _ = u⁻¹ * b * u := h2
  have hmem : b * (u⁻¹ * b * u) ∈ A := A.mul_mem hb hc
  have huu : u * u ∈ A := by rw [← pow_two]; exact hu2
  have key : (b * u) * (b * u) = (u * u) * (b * (u⁻¹ * b * u)) := by
    calc (b * u) * (b * u) = b * (u * b * u⁻¹) * u * u := by group
      _ = b * (u⁻¹ * b * u) * u * u := by rw [h1]
      _ = (b * (u⁻¹ * b * u)) * (u * u) := by group
      _ = (u * u) * (b * (u⁻¹ * b * u)) := hAb _ hmem _ huu
  rw [pow_two, pow_two, phiVal]
  exact key

/-! ## The subgroup `φ_u(A)` and its `ξ`-invariance -/

/-- The subgroup generated by the values `φ_v(a)`, `a ∈ A`. -/
def phiA (v : P) (A : Subgroup P) : Subgroup P :=
  Subgroup.closure {y : P | ∃ a ∈ A, y = phiVal v a}

theorem mem_phiA {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) (v : P) {y : P} :
    y ∈ phiA v A ↔ ∃ a ∈ A, y = phiVal v a := by
  constructor
  · intro hy
    rw [phiA] at hy
    induction hy using Subgroup.closure_induction with
    | mem y hy => exact hy
    | one => exact ⟨1, A.one_mem, by simp⟩
    | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha, rfl⟩ := ihx
        obtain ⟨b, hb, rfl⟩ := ihy
        exact ⟨a * b, A.mul_mem ha hb, (phiVal_mul hAn hAb v ha hb).symm⟩
    | inv x hx ih =>
        obtain ⟨a, ha, rfl⟩ := ih
        exact ⟨a⁻¹, A.inv_mem ha, (phiVal_inv hAn hAb v ha).symm⟩
  · rintro ⟨a, ha, rfl⟩
    exact Subgroup.subset_closure ⟨a, ha, rfl⟩

theorem phiA_le {A : Subgroup P} (hAn : A.Normal) (v : P) : phiA v A ≤ A := by
  rw [phiA, Subgroup.closure_le]
  rintro y ⟨a, ha, rfl⟩
  exact A.mul_mem ha (by simpa using hAn.conj_mem a ha v⁻¹)

/-- The `ξ`-image of `φ_u(A)` is contained in `φ_u(A)`. -/
theorem phiA_xi_map_le (h : IsSuzuki2Grp P) {A C : Subgroup P} (hA : IsXiAbelNormal h A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) {u : P} (huC : u ∈ C) (huA : u ∉ A)
    (hcoset : ∀ v ∈ C, v ∉ A → v * u⁻¹ ∈ A) :
    (phiA u A).map (h.xi : MulAut P).toMonoidHom ≤ phiA u A := by
  have hAn := hA.normal
  have hAb := hA.abelian
  have hAinv := hA.map_eq
  have hxiuC : h.xi u ∈ C := by
    have hh := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom huC
    rwa [hCinv] at hh
  have hxiuA : h.xi u ∉ A := by
    intro hc
    exact huA (by simpa using symm_mem_of_map_eq h.xi hAinv hc)
  have hb0 : h.xi u * u⁻¹ ∈ A := hcoset _ hxiuC hxiuA
  rw [Subgroup.map_le_iff_le_comap, phiA, Subgroup.closure_le]
  rintro y ⟨a, ha, rfl⟩
  rw [SetLike.mem_coe, Subgroup.mem_comap]
  show h.xi (phiVal u a) ∈ phiA u A
  rw [phiVal_xi]
  have hxa : h.xi a ∈ A := by
    have hh := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom ha
    rwa [hAinv] at hh
  have hconj : (h.xi u)⁻¹ * (h.xi a) * (h.xi u) = u⁻¹ * (h.xi a) * u :=
    coset_conj_eq hAb hb0 hxa
  rw [phiVal, hconj]
  exact Subgroup.subset_closure ⟨h.xi a, hxa, rfl⟩

/-- The reverse inclusion. -/
theorem phiA_le_xi_map (h : IsSuzuki2Grp P) {A C : Subgroup P} (hA : IsXiAbelNormal h A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) {u : P} (huC : u ∈ C) (huA : u ∉ A)
    (hcoset : ∀ v ∈ C, v ∉ A → v * u⁻¹ ∈ A) :
    phiA u A ≤ (phiA u A).map (h.xi : MulAut P).toMonoidHom := by
  have hAn := hA.normal
  have hAb := hA.abelian
  have hAinv := hA.map_eq
  have hxiuC : (h.xi : MulAut P).symm u ∈ C := symm_mem_of_map_eq h.xi hCinv huC
  have hxiuA : (h.xi : MulAut P).symm u ∉ A := by
    intro hc
    have hh := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom hc
    rw [hAinv] at hh
    exact huA (by simpa using hh)
  have hb1 : (h.xi : MulAut P).symm u * u⁻¹ ∈ A := hcoset _ hxiuC hxiuA
  show Subgroup.closure {y : P | ∃ a ∈ A, y = phiVal u a}
    ≤ (phiA u A).map (h.xi : MulAut P).toMonoidHom
  rw [Subgroup.closure_le]
  rintro y ⟨a, ha, rfl⟩
  refine Subgroup.mem_map.mpr ⟨phiVal ((h.xi : MulAut P).symm u) ((h.xi : MulAut P).symm a),
    ?_, ?_⟩
  · rw [mem_phiA hAn hAb]
    refine ⟨(h.xi : MulAut P).symm a, symm_mem_of_map_eq h.xi hAinv ha, ?_⟩
    have hconj : ((h.xi : MulAut P).symm u)⁻¹ * ((h.xi : MulAut P).symm a)
        * ((h.xi : MulAut P).symm u) = u⁻¹ * ((h.xi : MulAut P).symm a) * u :=
      coset_conj_eq hAb hb1 (symm_mem_of_map_eq h.xi hAinv ha)
    rw [phiVal, phiVal, hconj]
  · show (h.xi : MulAut P) (phiVal ((h.xi : MulAut P).symm u) ((h.xi : MulAut P).symm a))
      = phiVal u a
    rw [phiVal_xi]
    simp

/-- `φ_u(A)` is `ξ`-invariant. -/
theorem phiA_xi_inv (h : IsSuzuki2Grp P) {A C : Subgroup P} (hA : IsXiAbelNormal h A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) {u : P} (huC : u ∈ C) (huA : u ∉ A)
    (hcoset : ∀ v ∈ C, v ∉ A → v * u⁻¹ ∈ A) :
    (phiA u A).map (h.xi : MulAut P).toMonoidHom = phiA u A :=
  le_antisymm (phiA_xi_map_le h hA hCinv huC huA hcoset)
    (phiA_le_xi_map h hA hCinv huC huA hcoset)

/-! ## The subgroup `⟨φ_u(A), u²⟩` -/

/-- The subgroup generated by `φ_u(A)` and `u²`. -/
def Bsub (v : P) (A : Subgroup P) : Subgroup P :=
  Subgroup.closure ((phiA v A : Set P) ∪ {v ^ 2})

theorem Bsub_le {A : Subgroup P} (hAn : A.Normal) {u : P} (hu2 : u ^ 2 ∈ A) :
    Bsub u A ≤ A := by
  rw [Bsub, Subgroup.closure_le]
  rintro y (hy | hy)
  · exact phiA_le hAn u hy
  · rw [Set.mem_singleton_iff] at hy
    rw [hy]; exact hu2

theorem mem_Bsub_left {v : P} {A : Subgroup P} {y : P} (hy : y ∈ phiA v A) :
    y ∈ Bsub v A :=
  Subgroup.subset_closure (Or.inl hy)

theorem mem_Bsub_sq {v : P} {A : Subgroup P} : v ^ 2 ∈ Bsub v A :=
  Subgroup.subset_closure (Or.inr (Set.mem_singleton _))

/-- Every element of `⟨φ_u(A), u²⟩` lies in `φ_u(A) ∪ φ_u(A)·u²`. -/
theorem Bsub_cover {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) {u : P} (hu2 : u ^ 2 ∈ A)
    (hu4 : u ^ 4 ∈ phiA u A) {y : P} (hy : y ∈ Bsub u A) :
    y ∈ phiA u A ∨ ∃ z ∈ phiA u A, y = z * u ^ 2 := by
  have hphi_le : phiA u A ≤ A := phiA_le hAn u
  have hcomm : ∀ z ∈ phiA u A, u ^ 2 * z = z * u ^ 2 := fun z hz => hAb _ hu2 _ (hphi_le hz)
  rw [Bsub] at hy
  induction hy using Subgroup.closure_induction with
  | mem y hy =>
      rcases hy with hy | hy
      · exact Or.inl hy
      · right
        rw [Set.mem_singleton_iff] at hy
        exact ⟨1, (phiA u A).one_mem, by rw [one_mul, hy]⟩
  | one => exact Or.inl (phiA u A).one_mem
  | mul x y hx hy ihx ihy =>
      rcases ihx with hx1 | ⟨w, hw, rfl⟩
      · rcases ihy with hy1 | ⟨z, hz, rfl⟩
        · exact Or.inl (mul_mem hx1 hy1)
        · exact Or.inr ⟨x * z, mul_mem hx1 hz, by rw [mul_assoc]⟩
      · rcases ihy with hy1 | ⟨z, hz, rfl⟩
        · refine Or.inr ⟨w * y, mul_mem hw hy1, ?_⟩
          simp only [mul_assoc, hcomm y hy1]
        · refine Or.inl ?_
          have hkey : (w * u ^ 2) * (z * u ^ 2) = (w * z) * u ^ 4 := by
            calc (w * u ^ 2) * (z * u ^ 2) = w * (u ^ 2 * z) * u ^ 2 := by group
              _ = w * (z * u ^ 2) * u ^ 2 := by rw [hcomm z hz]
              _ = (w * z) * (u ^ 2 * u ^ 2) := by group
              _ = (w * z) * u ^ 4 := by group
          rw [hkey]
          exact mul_mem (mul_mem hw hz) hu4
  | inv x hx ih =>
      rcases ih with hx1 | ⟨w, hw, rfl⟩
      · exact Or.inl (inv_mem hx1)
      · refine Or.inr ⟨w⁻¹ * (u ^ 4)⁻¹, mul_mem (inv_mem hw) (inv_mem hu4), ?_⟩
        have hcomm' : (u ^ 2)⁻¹ * w⁻¹ = w⁻¹ * (u ^ 2)⁻¹ :=
          hAb _ (A.inv_mem hu2) _ (A.inv_mem (hphi_le hw))
        rw [mul_inv_rev, show (w⁻¹ * (u ^ 4)⁻¹) * u ^ 2 = w⁻¹ * (u ^ 2)⁻¹ from by group]
        exact hcomm'

/-- `⟨φ_u(A), u²⟩` is `ξ`-invariant. -/
theorem Bsub_xi_inv (h : IsSuzuki2Grp P) {A C : Subgroup P} (hA : IsXiAbelNormal h A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) {u : P} (huC : u ∈ C) (huA : u ∉ A)
    (hcoset : ∀ v ∈ C, v ∉ A → v * u⁻¹ ∈ A) (hu2 : u ^ 2 ∈ A) :
    (Bsub u A).map (h.xi : MulAut P).toMonoidHom = Bsub u A := by
  have hAn := hA.normal
  have hAb := hA.abelian
  have hAinv := hA.map_eq
  have hphiinv := phiA_xi_inv h hA hCinv huC huA hcoset
  have hxiuC : h.xi u ∈ C := by
    have hh := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom huC
    rwa [hCinv] at hh
  have hxiuA : h.xi u ∉ A := by
    intro hc
    exact huA (by simpa using symm_mem_of_map_eq h.xi hAinv hc)
  have hb0 : h.xi u * u⁻¹ ∈ A := hcoset _ hxiuC hxiuA
  have hxiu_sq : (h.xi u) ^ 2 = u ^ 2 * phiVal u (h.xi u * u⁻¹) := by
    conv_lhs => rw [show h.xi u = (h.xi u * u⁻¹) * u from by group]
    exact sq_mul_eq_phiVal hAn hAb hb0 hu2
  have hphi0 : phiVal u (h.xi u * u⁻¹) ∈ phiA u A :=
    Subgroup.subset_closure ⟨_, hb0, rfl⟩
  have hxiu2C : (h.xi : MulAut P).symm u ∈ C := symm_mem_of_map_eq h.xi hCinv huC
  have hxiu2A : (h.xi : MulAut P).symm u ∉ A := by
    intro hc
    have hh := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom hc
    rw [hAinv] at hh
    exact huA (by simpa using hh)
  have hb1 : (h.xi : MulAut P).symm u * u⁻¹ ∈ A := hcoset _ hxiu2C hxiu2A
  have hsq1 : ((h.xi : MulAut P).symm u) ^ 2
      = u ^ 2 * phiVal u ((h.xi : MulAut P).symm u * u⁻¹) := by
    conv_lhs => rw [show (h.xi : MulAut P).symm u = ((h.xi : MulAut P).symm u * u⁻¹) * u
      from by group]
    exact sq_mul_eq_phiVal hAn hAb hb1 hu2
  have hphi1 : phiVal u ((h.xi : MulAut P).symm u * u⁻¹) ∈ phiA u A :=
    Subgroup.subset_closure ⟨_, hb1, rfl⟩
  apply le_antisymm
  · rw [Bsub, Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
    rintro y (hy | hy)
    · show (h.xi : MulAut P).toMonoidHom y ∈ Subgroup.closure ((phiA u A : Set P) ∪ {u ^ 2})
      exact mem_Bsub_left (phiA_xi_map_le h hA hCinv huC huA hcoset
        (Subgroup.mem_map_of_mem _ hy))
    · rw [Set.mem_singleton_iff] at hy
      show (h.xi : MulAut P).toMonoidHom y ∈ Subgroup.closure ((phiA u A : Set P) ∪ {u ^ 2})
      rw [hy, map_pow]
      change (h.xi : MulAut P) u ^ 2 ∈ Subgroup.closure ((phiA u A : Set P) ∪ {u ^ 2})
      rw [hxiu_sq]
      exact Subgroup.mul_mem _ mem_Bsub_sq (mem_Bsub_left hphi0)
  · rw [Bsub, Subgroup.closure_le]
    rintro y (hy | hy)
    · refine Subgroup.mem_map.mpr ?_
      obtain ⟨z, hz, hzy⟩ :=
        Subgroup.mem_map.mp (phiA_le_xi_map h hA hCinv huC huA hcoset hy)
      exact ⟨z, mem_Bsub_left hz, hzy⟩
    · rw [Set.mem_singleton_iff] at hy
      refine Subgroup.mem_map.mpr ⟨((h.xi : MulAut P).symm u) ^ 2, ?_, ?_⟩
      · rw [hsq1]
        exact Subgroup.mul_mem _ mem_Bsub_sq (mem_Bsub_left hphi1)
      · show (h.xi : MulAut P) ((h.xi : MulAut P).symm u ^ 2) = y
        rw [map_pow, hy]
        simp

/-- `(u * b)² = u² * φ_u(b)` when `b ∈ A` and `A` is abelian and normal. -/
theorem sq_mul_eq_phiVal' {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) {u b : P} (hb : b ∈ A) :
    (u * b) ^ 2 = u ^ 2 * phiVal u b := by
  have hc : u⁻¹ * b * u ∈ A := by simpa using hAn.conj_mem b hb u⁻¹
  have hcomm : (u⁻¹ * b * u) * b = b * (u⁻¹ * b * u) := hAb _ hc _ hb
  rw [pow_two, pow_two, phiVal]
  rw [show u * b * (u * b) = (u * u) * ((u⁻¹ * b * u) * b) from by group, hcomm]

/-- `⟨φ_u(A), u²⟩` is covered by two cosets of its square subgroup. -/
theorem Bsub_sq_cover {A : Subgroup P} (hAn : A.Normal)
    (hAb : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) {u : P} (hu2A : u ^ 2 ∈ A)
    (hphi : phiA u A ≤ powSub (Bsub u A) 2) {y : P} (hy : y ∈ Bsub u A) :
    y ∈ powSub (Bsub u A) 2 ∨ y * (u ^ 2)⁻¹ ∈ powSub (Bsub u A) 2 := by
  have hB_le : Bsub u A ≤ A := Bsub_le hAn hu2A
  have hu2B : u ^ 2 ∈ Bsub u A := mem_Bsub_sq
  have hu4H : u ^ 4 ∈ powSub (Bsub u A) 2 := by
    have h := pow_mem_powSub (A := Bsub u A) (n := 2) hu2B
    have h2 : (u ^ 2) ^ 2 = u ^ 4 := by group
    rwa [h2] at h
  have hcomm : ∀ z ∈ powSub (Bsub u A) 2, u ^ 2 * z = z * u ^ 2 := by
    intro z hz
    exact hAb _ hu2A _ (hB_le (powSub_le (by norm_num : 0 < 2) hz))
  have hcommi : ∀ z ∈ powSub (Bsub u A) 2, (u ^ 2)⁻¹ * z = z * (u ^ 2)⁻¹ := by
    intro z hz
    exact hAb _ (A.inv_mem hu2A) _ (hB_le (powSub_le (by norm_num : 0 < 2) hz))
  rw [Bsub] at hy
  induction hy using Subgroup.closure_induction with
  | mem y hy =>
      rcases hy with hy | hy
      · exact Or.inl (hphi hy)
      · rw [Set.mem_singleton_iff] at hy
        exact Or.inr (by rw [hy, mul_inv_cancel]; exact (powSub (Bsub u A) 2).one_mem)
  | one => exact Or.inl (powSub (Bsub u A) 2).one_mem
  | mul x y hx hy ihx ihy =>
      rcases ihx with hx1 | hx1
      · rcases ihy with hy1 | hy1
        · exact Or.inl (mul_mem hx1 hy1)
        · exact Or.inr (by rw [mul_assoc]; exact mul_mem hx1 hy1)
      · rcases ihy with hy1 | hy1
        · refine Or.inr ?_
          rw [show x * y * (u ^ 2)⁻¹ = x * (y * (u ^ 2)⁻¹) from by group, ← hcommi y hy1,
            ← mul_assoc]
          exact mul_mem hx1 hy1
        · refine Or.inl ?_
          have hzc : u ^ 2 * (y * (u ^ 2)⁻¹) * (u ^ 2)⁻¹ = y * (u ^ 2)⁻¹ := by
            rw [hcomm _ hy1]; group
          have hxy : x * y = (x * (u ^ 2)⁻¹ * (y * (u ^ 2)⁻¹)) * u ^ 4 := by
            calc x * y = ((x * (u ^ 2)⁻¹) * u ^ 2) * ((y * (u ^ 2)⁻¹) * u ^ 2) := by
                  conv_lhs => rw [show x = (x * (u ^ 2)⁻¹) * u ^ 2 from by group,
                    show y = (y * (u ^ 2)⁻¹) * u ^ 2 from by group]
              _ = (x * (u ^ 2)⁻¹) * (u ^ 2 * (y * (u ^ 2)⁻¹) * (u ^ 2)⁻¹) * (u ^ 2 * u ^ 2) := by
                  group
              _ = (x * (u ^ 2)⁻¹) * (y * (u ^ 2)⁻¹) * (u ^ 2 * u ^ 2) := by rw [hzc]
              _ = (x * (u ^ 2)⁻¹ * (y * (u ^ 2)⁻¹)) * u ^ 4 := by
                  rw [show u ^ 2 * u ^ 2 = u ^ 4 from by group]
          rw [hxy]
          exact mul_mem (mul_mem hx1 hy1) hu4H
  | inv x hx ih =>
      rcases ih with hx1 | hx1
      · exact Or.inl (inv_mem hx1)
      · refine Or.inr ?_
        have hcommi' : (u ^ 2)⁻¹ * (x * (u ^ 2)⁻¹)⁻¹ = (x * (u ^ 2)⁻¹)⁻¹ * (u ^ 2)⁻¹ :=
          hcommi _ (inv_mem hx1)
        have h4' : (u ^ 2)⁻¹ * (u ^ 2)⁻¹ = (u ^ 4)⁻¹ := by
          rw [← mul_inv_rev, show u ^ 2 * u ^ 2 = u ^ 4 from by group]
        rw [show x⁻¹ * (u ^ 2)⁻¹
              = (x * (u ^ 2)⁻¹)⁻¹ * ((u ^ 2)⁻¹ * (u ^ 2)⁻¹) from by
            rw [show x⁻¹ = (u ^ 2)⁻¹ * (x * (u ^ 2)⁻¹)⁻¹ from by group, hcommi']
            group]
        rw [h4']
        exact mul_mem (inv_mem hx1) (inv_mem hu4H)

/-- Two cosets cover: `|B| ≤ 2|H|`. -/
theorem nat_card_le_two_mul_of_subset_two_cosets {G : Type*} [Group G] [Finite G]
    {B H : Subgroup G} {g : G}
    (h : (B : Set G) ⊆ (H : Set G) ∪ (fun z => z * g) '' (H : Set G)) :
    Nat.card ↥B ≤ 2 * Nat.card ↥H := by
  have hB : Nat.card ↥B = (B : Set G).ncard := Nat.card_coe_set_eq (B : Set G)
  have hH : Nat.card ↥H = (H : Set G).ncard := Nat.card_coe_set_eq (H : Set G)
  rw [hB, hH]
  calc (B : Set G).ncard
      ≤ ((H : Set G) ∪ (fun z => z * g) '' (H : Set G)).ncard :=
        Set.ncard_le_ncard h (Set.toFinite _)
    _ ≤ (H : Set G).ncard + ((fun z => z * g) '' (H : Set G)).ncard := Set.ncard_union_le _ _
    _ = (H : Set G).ncard + (H : Set G).ncard := by
        rw [Set.ncard_image_of_injective _ (fun a b hab => mul_right_cancel hab)]
    _ = 2 * (H : Set G).ncard := by ring

end Work.Higman
