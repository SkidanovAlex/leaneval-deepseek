/-! ## Elementary helpers -/

/-- For subgroups of a finite group, `S ≤ T` gives `|S| ≤ |T|`. -/
theorem natCard_subgroup_le_of_le {G : Type} [Group G] [Finite G] {S T : Subgroup G}
    (h : S ≤ T) : Nat.card ↥S ≤ Nat.card ↥T :=
  Nat.card_le_card_of_injective (fun x : ↥S => (⟨(x : G), h x.2⟩ : ↥T))
    (fun a b hab => Subtype.ext (by
      have h1 := congrArg (fun x : ↥T => (x : G)) hab
      simpa using h1))

/-- In a group of class two (all commutators central) the commutator is additive in the
*second* variable: `⁅x, y * z⁆ = ⁅x, y⁆ * ⁅x, z⁆`. -/
theorem commutator_mul_right_of_central {G : Type} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    ⁅x, y * z⁆ = ⁅x, y⁆ * ⁅x, z⁆ := by
  have h1 : ⁅x, y * z⁆ = ⁅y * z, x⁆⁻¹ := by rw [← commutatorElement_inv]
  rw [h1, commutator_mul_left hZ y z x, mul_inv_rev, commutatorElement_inv,
    commutatorElement_inv]
  exact (Subgroup.mem_center_iff.mp
    (hZ (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top z)))
    ⁅x, y⁆).symm

/-! ## `Z(P) = Ω₁(P)` assuming `[P,P] ≤ Ω₁(P)`: the Gorenstein–Thompson argument -/

/-- **Higman's Lemma 2 plus Gorenstein–Thompson.**  If in a Suzuki 2-group every commutator is an
involution, then the centre is exactly `Ω₁(P)`.

Suppose `Z(P) ≠ Ω₁(P)`; since `Ω₁(P) ≤ Z(P)`, the squaring map `P / Z(P) → Z(P) / Z(P)²` is a
well defined `ξ`-equivariant homomorphism (the class-two squaring identity `(xy)² = x²y²⁅y,x⁆`
with `⁅y,x⁆ ∈ Ω₁(P) ⊆ Z(P)²`), and it is injective by Higman's Lemma 2
(`x² ∈ Z(P)² ⟹ x ∈ Z(P)`), hence — its image being a non-zero `ξ`-submodule of the irreducible
module `Z(P)/Z(P)² ≅ Ω₁(P)` — an isomorphism.  Transporting the commutator pairing along it gives
a non-trivial `ξ`-equivariant alternating biadditive map on `Ω₁(P)`, on whose non-identity
elements `ξ` acts transitively — contradicting Gorenstein–Thompson
(`equivariant_bihom_trivial`).  So every commutator is trivial, contradicting
non-commutativity. -/
theorem center_eq_omega1_of_commutator_le (h : Work.Higman.IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.omega1 P) :
    Subgroup.center P = Work.Higman.omega1 P := by
  classical
  by_contra hne
  obtain ⟨e, he⟩ := quot_center_omega1_iso h hcomm hne
  -- `Ω₁(P)` is abelian
  letI : CommGroup ↥(omega1 P) :=
    { mul_comm := fun a b => Subtype.ext (h.omega1_comm a.2 b.2) }
  -- the action of `ξ` on `Ω₁(P)`
  have hxi_mem : ∀ u : ↥(omega1 P), h.xi (u : P) ∈ omega1 P := fun u => by
    have h1 := map_xi_omega1 h
    have h2 : h.xi (u : P) ∈ (omega1 P).map (h.xi : MulAut P).toMonoidHom :=
      Subgroup.mem_map_of_mem _ u.2
    rwa [h1] at h2
  let ξV : MulAut ↥(omega1 P) :=
    { toFun := fun u => ⟨h.xi u, hxi_mem u⟩
      invFun := fun u => ⟨(h.xi : MulAut P).symm u, symm_mem_of_map_eq h.xi (map_xi_omega1 h) u.2⟩
      left_inv := fun u => by ext; simp
      right_inv := fun u => by ext; simp
      map_mul' := fun u v => by ext; simp }
  have ξV_pow : ∀ (k : ℕ) (u : ↥(omega1 P)), ((ξV ^ k) u : P) = (h.xi ^ k) (u : P) := by
    intro k
    induction k with
    | zero => intro u; simp
    | succ k ih =>
        intro u
        have h1 : ((ξV ^ (k + 1)) u : ↥(omega1 P)) = ξV ((ξV ^ k) u) := by
          rw [pow_succ', MulAut.mul_apply]
        rw [h1]
        show h.xi (((ξV ^ k) u : ↥(omega1 P)) : P) = (h.xi ^ (k + 1)) (u : P)
        rw [ih u, pow_succ', MulAut.mul_apply]
  -- `Ω₁(P)` has exponent two and `ξ` permutes its non-identity elements transitively
  have h2 : ∀ a : ↥(omega1 P), a * a = 1 := fun a => by
    rw [← pow_two]
    exact Subtype.ext (h.mem_omega1.mp a.2)
  have htrans : ∀ a b : ↥(omega1 P), a ≠ 1 → b ≠ 1 → ∃ k : ℕ, (ξV ^ k) a = b := by
    intro a b ha hb
    have key : ∀ u : ↥(omega1 P), u ≠ 1 → orderOf (u : P) = 2 := by
      intro u hu
      have hd : orderOf (u : P) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp u.2)
      rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2'
      · exact absurd (Subtype.ext (orderOf_eq_one_iff.mp h1)) hu
      · exact h2'
    obtain ⟨k, hk⟩ := h.trans (a : P) (b : P) (key a ha) (key b hb)
    exact ⟨k, Subtype.ext (by rw [ξV_pow k a]; exact hk)⟩
  -- a lift of an element of `P/Z(P)` to `P`
  let rep : (P ⧸ Subgroup.center P) → P :=
    fun q => Classical.choose (Quotient.exists_rep q)
  have rep_spec : ∀ q : (P ⧸ Subgroup.center P), QuotientGroup.mk (rep q) = q :=
    fun q => Classical.choose_spec (Quotient.exists_rep q)
  -- the commutator bihomomorphism
  have hc_mem : ∀ x y : P, ⁅x, y⁆ ∈ omega1 P := fun x y =>
    hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))
  let c : ↥(omega1 P) → ↥(omega1 P) → ↥(omega1 P) :=
    fun u v => ⟨⁅rep (e.symm u), rep (e.symm v)⁆, hc_mem _ _⟩
  -- the value of `c` at classes of elements of `P`
  have hZcent : ∀ z ∈ Subgroup.center P, ∀ x : P, x * z = z * x :=
    fun z hz x => Subgroup.mem_center_iff.mp hz x
  have hcz : ∀ (a b z : P), z ∈ Subgroup.center P → ⁅a * z, b⁆ = ⁅a, b⁆ := by
    intro a b z hz
    rw [commutatorElement_def]
    show a * z * b * (a * z)⁻¹ * b⁻¹ = a * b * a⁻¹ * b⁻¹
    rw [show a * z * b * (a * z)⁻¹ * b⁻¹ = a * (z * b) * (z⁻¹ * a⁻¹) * b⁻¹ from by group,
      (hZcent z hz b).symm]
    group
  have hcz2 : ∀ (a b z : P), z ∈ Subgroup.center P → ⁅a, b * z⁆ = ⁅a, b⁆ := by
    intro a b z hz
    rw [commutatorElement_def]
    show a * (b * z) * a⁻¹ * (b * z)⁻¹ = a * b * a⁻¹ * b⁻¹
    rw [show a * (b * z) * a⁻¹ * (b * z)⁻¹ = a * b * (z * a⁻¹) * z⁻¹ * b⁻¹ from by group,
      (hZcent z hz a⁻¹).symm]
    group
  have hcongr : ∀ (x x' y y' : P), x⁻¹ * x' ∈ Subgroup.center P →
      y⁻¹ * y' ∈ Subgroup.center P → ⁅x, y⁆ = ⁅x', y'⁆ := by
    intro x x' y y' hx hy
    obtain ⟨z, hz, hzx⟩ : ∃ z ∈ Subgroup.center P, x' = x * z := ⟨x⁻¹ * x', hx, by group⟩
    obtain ⟨w, hw, hwy⟩ : ∃ w ∈ Subgroup.center P, y' = y * w := ⟨y⁻¹ * y', hy, by group⟩
    rw [hzx, hwy, hcz _ _ z hz, hcz2 _ _ w hw]
  have c_mk : ∀ x y : P,
      c (e (QuotientGroup.mk x)) (e (QuotientGroup.mk y)) = ⟨⁅x, y⁆, hc_mem x y⟩ := by
    intro x y
    have hx0 : e.symm (e (QuotientGroup.mk x)) = QuotientGroup.mk x :=
      MulEquiv.symm_apply_apply e _
    have hy0 : e.symm (e (QuotientGroup.mk y)) = QuotientGroup.mk y :=
      MulEquiv.symm_apply_apply e _
    obtain ⟨z1, hz1, h1⟩ : ∃ z ∈ Subgroup.center P, x = rep (QuotientGroup.mk x) * z :=
      ⟨(rep (QuotientGroup.mk x))⁻¹ * x,
        QuotientGroup.eq.mp (rep_spec (QuotientGroup.mk x)), by group⟩
    obtain ⟨z2, hz2, h2⟩ : ∃ z ∈ Subgroup.center P, y = rep (QuotientGroup.mk y) * z :=
      ⟨(rep (QuotientGroup.mk y))⁻¹ * y,
        QuotientGroup.eq.mp (rep_spec (QuotientGroup.mk y)), by group⟩
    have hmain : ⁅x, y⁆ = ⁅rep (QuotientGroup.mk x), rep (QuotientGroup.mk y)⁆ := by
      conv_lhs => rw [h1, h2]
      rw [hcz _ _ z1 hz1, hcz2 _ _ z2 hz2]
    apply Subtype.ext
    show ⁅rep (e.symm (e (QuotientGroup.mk x))), rep (e.symm (e (QuotientGroup.mk y)))⁆
      = ⁅x, y⁆
    rw [hx0, hy0, ← hmain]
  have hmul : ∀ a b d : ↥(omega1 P), c (a * b) d = c a d * c b d := by
    intro a b d
    have h1 : (rep (e.symm (a * b)))⁻¹ * (rep (e.symm a) * rep (e.symm b))
        ∈ Subgroup.center P := by
      have hA : QuotientGroup.mk (rep (e.symm (a * b))) = e.symm (a * b) :=
        rep_spec (e.symm (a * b))
      have hB : QuotientGroup.mk (rep (e.symm a) * rep (e.symm b)) = e.symm (a * b) := by
        rw [QuotientGroup.mk_mul, rep_spec (e.symm a), rep_spec (e.symm b)]
        exact (map_mul e.symm a b).symm
      exact QuotientGroup.eq.mp (hA.trans hB.symm)
    have h2 : rep (e.symm (a * b))
        = rep (e.symm a) * rep (e.symm b)
          * ((rep (e.symm (a * b)))⁻¹ * (rep (e.symm a) * rep (e.symm b)))⁻¹ := by group
    have h3 : ⁅rep (e.symm (a * b)), rep (e.symm d)⁆
        = ⁅rep (e.symm a) * rep (e.symm b), rep (e.symm d)⁆ := by
      rw [h2]
      exact hcz _ _ _ (Subgroup.inv_mem _ h1)
    apply Subtype.ext
    show ⁅rep (e.symm (a * b)), rep (e.symm d)⁆
      = ⁅rep (e.symm a), rep (e.symm d)⁆ * ⁅rep (e.symm b), rep (e.symm d)⁆
    rw [h3, commutator_mul_left (hcomm.trans h.omega1_le_center)]
  have hmulR : ∀ a b d : ↥(omega1 P), c a (b * d) = c a b * c a d := by
    intro a b d
    have h1 : (rep (e.symm (b * d)))⁻¹ * (rep (e.symm b) * rep (e.symm d))
        ∈ Subgroup.center P := by
      have hA : QuotientGroup.mk (rep (e.symm (b * d))) = e.symm (b * d) :=
        rep_spec (e.symm (b * d))
      have hB : QuotientGroup.mk (rep (e.symm b) * rep (e.symm d)) = e.symm (b * d) := by
        rw [QuotientGroup.mk_mul, rep_spec (e.symm b), rep_spec (e.symm d)]
        exact (map_mul e.symm b d).symm
      exact QuotientGroup.eq.mp (hA.trans hB.symm)
    have h2 : rep (e.symm (b * d))
        = rep (e.symm b) * rep (e.symm d)
          * ((rep (e.symm (b * d)))⁻¹ * (rep (e.symm b) * rep (e.symm d)))⁻¹ := by group
    have h3 : ⁅rep (e.symm a), rep (e.symm (b * d))⁆
        = ⁅rep (e.symm a), rep (e.symm b) * rep (e.symm d)⁆ := by
      rw [h2]
      exact hcz2 _ _ _ (Subgroup.inv_mem _ h1)
    apply Subtype.ext
    show ⁅rep (e.symm a), rep (e.symm (b * d))⁆
      = ⁅rep (e.symm a), rep (e.symm b)⁆ * ⁅rep (e.symm a), rep (e.symm d)⁆
    rw [h3, commutator_mul_right_of_central (hcomm.trans h.omega1_le_center)]
  have halt : ∀ a : ↥(omega1 P), c a a = 1 := by
    intro a
    show (⟨⁅rep (e.symm a), rep (e.symm a)⁆, hc_mem _ _⟩ : ↥(omega1 P)) = 1
    apply Subtype.ext
    show ⁅rep (e.symm a), rep (e.symm a)⁆ = (1 : P)
    rw [commutatorElement_def]; group
  have hrep_eq : ∀ u : ↥(omega1 P),
      (rep (e.symm (ξV u)))⁻¹ * h.xi (rep (e.symm u)) ∈ Subgroup.center P := by
    intro u
    have h1 : QuotientGroup.mk (rep (e.symm (ξV u))) = e.symm (ξV u) :=
      rep_spec (e.symm (ξV u))
    have h2 : e (QuotientGroup.mk (h.xi (rep (e.symm u)))) = ξV u := by
      apply Subtype.ext
      show (e (QuotientGroup.mk (h.xi (rep (e.symm u)))) : P) = (ξV u : P)
      rw [he]
      have h3 : e (QuotientGroup.mk (rep (e.symm u))) = e (e.symm u) := by rw [rep_spec]
      rw [h3, MulEquiv.apply_symm_apply]
      rfl
    have h3 : QuotientGroup.mk (h.xi (rep (e.symm u))) = e.symm (ξV u) :=
      e.injective (by rw [h2, MulEquiv.apply_symm_apply])
    have h4 : (QuotientGroup.mk (rep (e.symm (ξV u))) : P ⧸ Subgroup.center P)
        = QuotientGroup.mk (h.xi (rep (e.symm u))) := by
      rw [rep_spec (e.symm (ξV u)), h3]
    exact QuotientGroup.eq.mp h4
  have heq : ∀ a b : ↥(omega1 P), ξV (c a b) = c (ξV a) (ξV b) := by
    intro a b
    have hra := hrep_eq a
    have hrb := hrep_eq b
    apply Subtype.ext
    show h.xi (⁅rep (e.symm a), rep (e.symm b)⁆)
      = ⁅rep (e.symm (ξV a)), rep (e.symm (ξV b))⁆
    have hcommut : h.xi ⁅rep (e.symm a), rep (e.symm b)⁆
        = ⁅h.xi (rep (e.symm a)), h.xi (rep (e.symm b))⁆ := by
      simp only [commutatorElement_def, map_mul, map_inv]
    rw [hcommut]
    refine hcongr _ _ _ _ ?_ ?_
    · simpa [mul_inv_rev] using Subgroup.inv_mem _ hra
    · simpa [mul_inv_rev] using Subgroup.inv_mem _ hrb
  have key := equivariant_bihom_trivial h2 ξV htrans c hmul hmulR halt heq
  -- now every commutator is trivial, contradicting non-commutativity
  obtain ⟨x, y, hxy⟩ := h.noncomm
  have h1 : c (e (QuotientGroup.mk x)) (e (QuotientGroup.mk y)) = 1 := key _ _
  rw [c_mk x y] at h1
  have h3 : ⁅x, y⁆ = 1 := congrArg Subtype.val h1
  exact hxy (by
    rw [commutatorElement_def] at h3
    calc x * y = x * y * x⁻¹ * y⁻¹ * (y * x) := by group
      _ = 1 * (y * x) := by rw [h3]
      _ = y * x := one_mul _)

/-! ## The dichotomy for `ξ`-invariant subgroups of a homocyclic abelian `ξ`-subgroup -/

/-- Let `A` be a `ξ`-invariant abelian subgroup of a Suzuki 2-group `P` with `Ω₁(P) ≤ A` and
`A ^ (4) = ⊥`.  Then the only `ξ`-invariant subgroups of `A` containing `Ω₁(P)` are `Ω₁(P)` and
`A` itself.

By Higman's Lemma 1 (`homogeneous_structure`) `A` is homocyclic of exponent `2 ^ e` with
`A ^ (2 ^ (e - 1)) = A ⊓ Ω₁(P) = Ω₁(P)`, and every `ξ`-invariant subgroup of `A` is a power
subgroup `A ^ (2 ^ i)`.  The hypothesis `A ^ 4 = ⊥` forces `e ≤ 2` (while `e ≥ 1` because
`Ω₁(P) ≠ 1`), so the only power subgroups containing `Ω₁(P) = A ^ (2 ^ (e - 1))` are
`A ^ (2 ^ (e - 1)) = Ω₁(P)` and `A`. -/
theorem xi_invariant_sub_eq_omega1_or_self (h : IsSuzuki2Grp P) {A B : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : Subgroup.map (h.xi : MulAut P).toMonoidHom A = A)
    (hNA : omega1 P ≤ A) (hA4 : powSub A 4 = ⊥)
    (hBA : B ≤ A) (hBxi : Subgroup.map (h.xi : MulAut P).toMonoidHom B = B)
    (hOB : omega1 P ≤ B) :
    B = omega1 P ∨ B = A := by
  classical
  have hAinf : A ⊓ omega1 P = omega1 P := inf_eq_right.mpr hNA
  obtain ⟨e, hexp, hcard, htop, hsub⟩ := homogeneous_structure h hAab hAxi
  -- `A ^ (2 ^ (e - 1)) = Ω₁(P)`
  have hOmeq : powSub A (2 ^ (e - 1)) = omega1 P := by rw [htop, hAinf]
  -- `e ≥ 1`, since `Ω₁(P) ≠ 1`
  have he1 : 1 ≤ e := by
    rcases Nat.eq_zero_or_pos e with h0 | hpos
    · exfalso
      have hA0 : A = ⊥ := by
        rw [Subgroup.eq_bot_iff_forall]
        intro x hx
        have h1 := hexp x hx
        rw [h0] at h1
        simpa using h1
      have hbot : omega1 P = ⊥ := by
        rw [← hOmeq, h0, show (2 : ℕ) ^ (0 - 1) = 1 by norm_num, powSub_one_eq, hA0]
      have h4 := h.omega1_card_ge_four
      rw [hbot, Subgroup.card_bot] at h4
      omega
    · exact hpos
  -- `e ≤ 2`, since `A ^ 4 = ⊥` and `|A ^ 4| = |Ω₁(P)| ^ (e - 2)`
  have he2 : e ≤ 2 := by
    rcases Nat.lt_or_ge e 2 with hlt | hge
    · omega
    · have hc := hcard 2 hge
      rw [show (2 : ℕ) ^ 2 = 4 by norm_num, hA4, hAinf, Subgroup.card_bot] at hc
      have hq1 : Nat.card ↥(omega1 P) ≠ 1 := by
        have := h.omega1_card_ge_four
        omega
      have hz : e - 2 = 0 := (Nat.pow_eq_one.mp hc.symm).resolve_left hq1
      omega
  -- `B = A ^ (2 ^ i)` with `Ω₁(P) ≤ B`, hence `i ≤ e - 1`
  obtain ⟨i, hi⟩ := hsub B hBA hBxi
  have hile : i ≤ e - 1 := by
    by_cases hie : i ≤ e
    · have hc1 := hcard i hie
      have hc2 := hcard (e - 1) (by omega : e - 1 ≤ e)
      have hle : powSub A (2 ^ (e - 1)) ≤ powSub A (2 ^ i) := by
        rw [hOmeq, ← hi]
        exact hOB
      have hcardle : Nat.card ↥(powSub A (2 ^ (e - 1))) ≤ Nat.card ↥(powSub A (2 ^ i)) :=
        natCard_subgroup_le_of_le hle
      rw [hc1, hc2] at hcardle
      have hee : e - (e - 1) = 1 := by omega
      rw [hee] at hcardle
      have hq1 : 1 < Nat.card ↥(A ⊓ omega1 P) := by
        have hcardOm : Nat.card ↥(A ⊓ omega1 P) = Nat.card ↥(omega1 P) :=
          congrArg (fun S : Subgroup P => Nat.card ↥S) hAinf
        rw [hcardOm]
        have := h.omega1_card_ge_four
        omega
      have hone : 1 ≤ e - i := (Nat.pow_le_pow_iff_right hq1).mp hcardle
      omega
    · exfalso
      push_neg at hie
      have hb : powSub A (2 ^ i) = ⊥ :=
        powSub_eq_bot_of_exp hAab (show e ≤ i by omega) hexp
      have hBbot : B = ⊥ := by rw [hi, hb]
      have hlebot : omega1 P ≤ (⊥ : Subgroup P) := by rw [← hBbot]; exact hOB
      have h4 := h.omega1_card_ge_four
      rw [le_bot_iff.mp hlebot, Subgroup.card_bot] at h4
      omega
  -- conclude
  rcases (show e = 1 ∨ e = 2 by omega) with he | he
  · have hi0 : i = 0 := by omega
    left
    have hAeq : A = omega1 P := by
      rw [← hOmeq, he, show (2 : ℕ) ^ (1 - 1) = 1 by norm_num, powSub_one_eq]
    rw [hi, hi0, show (2 : ℕ) ^ 0 = 1 by norm_num, powSub_one_eq]
    exact hAeq
  · rcases (show i = 0 ∨ i = 1 by omega) with hi0 | hi1
    · right
      rw [hi, hi0, show (2 : ℕ) ^ 0 = 1 by norm_num, powSub_one_eq]
    · left
      rw [hi, hi1, show (2 : ℕ) ^ 1 = 2 by norm_num, ← hOmeq, he]
      norm_num

/-! ## The target -/

/-- In a Suzuki 2-group the centre consists exactly of the elements of order dividing two
(Higman 1963, §2: `Ω₁(P) = Z(P)`). -/
theorem center_eq_omega1_aux {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) :
    Subgroup.center P = Work.Higman.omega1 P := by
  classical
  -- Higman's Lemma 9: a maximal `ξ`-invariant abelian normal subgroup `A`
  obtain ⟨A, hAn, hAxi, hAab, hAmax, hNA, hDA, hsq, hA4⟩ := lemma9_maximal_abelian h
  -- `Z(P) ≤ A` by maximality
  have hZA : Subgroup.center P ≤ A :=
    center_le_of_maximal h ⟨hAn, hAxi, hAab⟩
      (fun B hB hAB => hAmax B hB.normal hB.map_eq hB.abelian hAB)
  have hZxi : (Subgroup.center P).map (h.xi : MulAut P).toMonoidHom = Subgroup.center P :=
    center_map_xi h
  -- the dichotomy
  rcases xi_invariant_sub_eq_omega1_or_self h hAab hAxi hNA hA4 hZA hZxi h.omega1_le_center
    with hZ | hZ
  · exact hZ
  · -- `Z(P) = A`: the group has class two, so `[P,P] ≤ Ω₁(P)`, and the Gorenstein–Thompson
    -- argument gives `Z(P) = Ω₁(P)` after all
    have hclass : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P := by rw [hZ]; exact hDA
    have hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ omega1 P := by
      rw [Subgroup.commutator_le]
      intro x _ y _
      refine h.mem_omega1.mpr ?_
      have hx : x ^ 2 * y = y * x ^ 2 :=
        ((Subgroup.mem_center_iff.mp (by rw [hZ]; exact hsq x)) y).symm
      rw [commutator_sq_eq hclass x y, commutatorElement_def, hx]
      group
    exact center_eq_omega1_of_commutator_le h hcomm

end Work.Higman
