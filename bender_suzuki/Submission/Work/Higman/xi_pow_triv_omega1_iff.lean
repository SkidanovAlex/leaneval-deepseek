/-- Number-theoretic helper.  For `g` in any group, if `n` divides the order of `g` then
`g ^ k` lies in the cyclic subgroup generated by `g ^ n` exactly when `n ∣ k`. -/
theorem pow_mem_zpowers_pow_iff {G : Type*} [Group G] (g : G) {n k : ℕ}
    (hdvd : n ∣ orderOf g) :
    g ^ k ∈ Subgroup.zpowers (g ^ n) ↔ n ∣ k := by
  constructor
  · intro hmem
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp hmem
    have hEq : g ^ ((n : ℤ) * j) = g ^ (k : ℤ) := by
      have h2 : (g ^ (n : ℤ)) ^ j = g ^ (k : ℤ) := by
        rw [zpow_natCast, zpow_natCast]
        exact hj
      rwa [← zpow_mul] at h2
    have h1 : g ^ ((n : ℤ) * j - (k : ℤ)) = 1 := by
      rw [sub_eq_add_neg, zpow_add, zpow_neg, hEq, mul_inv_cancel]
    have h3 : (orderOf g : ℤ) ∣ ((n : ℤ) * j - (k : ℤ)) :=
      orderOf_dvd_iff_zpow_eq_one.mpr h1
    have hnZ : (n : ℤ) ∣ (orderOf g : ℤ) := Int.natCast_dvd_natCast.mpr hdvd
    have h4 : (n : ℤ) ∣ ((n : ℤ) * j) := dvd_mul_right _ _
    have h5 : (n : ℤ) ∣ (k : ℤ) := by
      have hh := dvd_sub h4 (hnZ.trans h3)
      simpa using hh
    exact Int.natCast_dvd_natCast.mp h5
  · rintro ⟨t, rfl⟩
    rw [pow_mul]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) t

theorem xi_pow_triv_omega1_iff {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    (k : ℕ) :
    (∀ z : P, z ∈ Work.Higman.omega1 P → (h.xi ^ k) z = z) ↔
      (Nat.card ↥(Work.Higman.omega1 P) - 1) ∣ k := by
  classical
  set n : ℕ := (Invol P).ncard with hn
  -- `|Ω₁(P)| - 1 = |Invol P|`
  have hncard : Nat.card ↥(omega1 P) - 1 = n := by
    rw [h.card_omega1, hn]
    simp
  rw [hncard]
  -- `n ≥ 2 > 0`
  have hn2 : 2 ≤ n := by
    rw [hn]
    obtain ⟨a, c, ha2, hc2, hac⟩ := h.manyInvol
    have hsub : ({a, c} : Set P) ⊆ Invol P := by
      intro w hw
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
      rcases hw with rfl | rfl
      · exact mem_Invol.mpr ha2
      · exact mem_Invol.mpr hc2
    have hcard : ({a, c} : Set P).ncard = 2 := by
      rw [Set.ncard_insert_of_notMem (by simpa using hac) (Set.toFinite _),
        Set.ncard_singleton]
    calc 2 = ({a, c} : Set P).ncard := hcard.symm
      _ ≤ (Invol P).ncard := Set.ncard_le_ncard hsub (Set.toFinite _)
  have hnpos : 0 < n := by omega
  -- `n` divides the order of `ξ`
  have hndvdm : n ∣ orderOf h.xi := by
    rw [hn]
    exact invol_ncard_dvd_orderOf_xi h
  -- an involution `u`
  obtain ⟨u, hu2⟩ : ∃ u : P, orderOf u = 2 := by
    obtain ⟨a, b, ha, _, _⟩ := h.manyInvol
    exact ⟨a, ha⟩
  have hu_sq : u ^ 2 = 1 := by
    rw [← orderOf_dvd_iff_pow_eq_one, hu2]
  have hu_omega1 : u ∈ omega1 P := (h.mem_omega1 (x := u)).mpr hu_sq
  -- the cyclic group generated by `ξ`
  set A : Subgroup (MulAut P) := Subgroup.zpowers h.xi with hA
  have horbit : (MulAction.orbit A u : Set P) = Invol P := by
    ext z
    rw [MulAction.mem_orbit_iff, mem_Invol]
    constructor
    · rintro ⟨φ, rfl⟩
      show orderOf (φ • u) = 2
      rw [show φ • u = (φ : MulAut P) u from rfl, MulEquiv.orderOf_eq, hu2]
    · intro hz
      obtain ⟨j, hj⟩ := h.trans u z hu2 hz
      refine ⟨⟨h.xi ^ j, ?_⟩, hj⟩
      exact Subgroup.pow_mem (Subgroup.zpowers h.xi) (Subgroup.mem_zpowers h.xi) j
  -- the stabiliser `K` of `u` in `A`
  set K : Subgroup A := MulAction.stabilizer A u with hK
  have hKcard : Nat.card K * n = orderOf h.xi := by
    have hos := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup A u)
    rw [Nat.card_prod] at hos
    have horbcard : Nat.card ↥(MulAction.orbit A u) = n := by
      rw [Nat.card_coe_set_eq, horbit, hn]
    have hAcard : Nat.card ↥A = orderOf h.xi := by
      rw [hA]
      exact Nat.card_zpowers h.xi
    rw [horbcard, hAcard] at hos
    rw [hK, mul_comm]
    exact hos
  have hKdiv : Nat.card K = orderOf h.xi / n := by
    rw [← hKcard, mul_comm (Nat.card K) n, Nat.mul_div_right _ hnpos]
  -- a generator `g` of `A`
  set g : A := ⟨h.xi, Subgroup.mem_zpowers h.xi⟩ with hg
  have hgord : orderOf g = orderOf h.xi := by
    rw [← Subgroup.orderOf_coe g, hg]
  have hgdvd : n ∣ orderOf g := by
    rw [hgord]
    exact hndvdm
  -- the stabiliser of `u` is exactly `⟨ξ ^ n⟩`
  have hK_eq : K = Subgroup.zpowers (g ^ n) := by
    refine (IsCyclic.subgroup_eq_iff_card_eq).mpr ?_
    rw [Nat.card_zpowers, orderOf_pow, hgord, Nat.gcd_eq_right hndvdm, ← hKdiv]
  -- `g ^ m` is `ξ ^ m` inside `A`
  have hpow : ∀ m : ℕ,
      (g ^ m : A) = ⟨h.xi ^ m, Subgroup.pow_mem (Subgroup.zpowers h.xi)
        (Subgroup.mem_zpowers h.xi) m⟩ := by
    intro m
    apply Subtype.ext
    simp [hg]
  -- the crux: `ξ ^ k` lies in `K` iff `n ∣ k`
  have hKey : ∀ m : ℕ, (⟨h.xi ^ m, Subgroup.pow_mem (Subgroup.zpowers h.xi)
        (Subgroup.mem_zpowers h.xi) m⟩ : A) ∈ K ↔ n ∣ m := by
    intro m
    rw [hK_eq, ← hpow m]
    exact pow_mem_zpowers_pow_iff g (k := m) hgdvd
  constructor
  · intro hfix
    have hfixu : (h.xi ^ k) u = u := hfix u hu_omega1
    apply (hKey k).mp
    rw [hK, MulAction.mem_stabilizer_iff]
    simpa using hfixu
  · intro hnk z hz
    have hmemK : (⟨h.xi ^ k, Subgroup.pow_mem (Subgroup.zpowers h.xi)
        (Subgroup.mem_zpowers h.xi) k⟩ : A) ∈ K := (hKey k).mpr hnk
    have hfixu : (h.xi ^ k) u = u := by
      have h1 := hmemK
      rw [hK, MulAction.mem_stabilizer_iff] at h1
      simpa using h1
    exact fixes_omega1_of_mem_zpowers_fixes_invol h hu2
      (Subgroup.pow_mem (Subgroup.zpowers h.xi) (Subgroup.mem_zpowers h.xi) k) hfixu z hz

end Work.Higman
