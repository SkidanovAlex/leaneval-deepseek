/-! ## A trivial alternating pairing -/

/-- **A biadditive alternating `ξ`-equivariant pairing whose target is `ξ`-isomorphic to its
source is trivial** (Gorenstein–Thompson Lemma 4 form).  Here `W` is a finite elementary abelian
group with `ξ` transitive on `W ∖ {1}` (so `W` is an irreducible `ξ`-module), `T` is a commutative
group with a `ξ`-action making it `ξ`-isomorphic to `W` via `e`, and `c : W → W → T` is
biadditive, alternating and `ξ`-equivariant.

Proof: transport along `e` and apply `Work.Higman.equivariant_bihom_trivial`.  (The hypothesis
that the target is `ξ`-isomorphic to the source is essential: for an arbitrary target there are
counterexamples, e.g. `W = 𝔽₄` with the determinant form into the trivial module `𝔽₂`.) -/
theorem eq_one_of_alt_of_target_iso {W T : Type*} [CommGroup W] [CommGroup T] [Finite W]
    (h2 : ∀ a : W, a * a = 1) (ξW : MulAut W) (ξT : MulAut T)
    (htrans : ∀ a b : W, a ≠ 1 → b ≠ 1 → ∃ k : ℕ, (ξW ^ k) a = b)
    (c : W → W → T)
    (hmul : ∀ a b d : W, c (a * b) d = c a d * c b d)
    (hmul' : ∀ a b d : W, c a (b * d) = c a b * c a d)
    (halt : ∀ a : W, c a a = 1)
    (heq : ∀ a b : W, c (ξW a) (ξW b) = ξT (c a b))
    (e : T ≃* W) (he : ∀ t : T, e (ξT t) = ξW (e t)) :
    ∀ a b : W, c a b = 1 := by
  have hfun : ∀ a b : W, ξW (e (c a b)) = e (c (ξW a) (ξW b)) := by
    intro a b
    rw [← he, heq a b]
  have h := Work.Higman.equivariant_bihom_trivial h2 ξW htrans (fun a b => e (c a b))
    (fun a b d => by rw [hmul, map_mul]) (fun a b d => by rw [hmul', map_mul])
    (fun a => by rw [halt, map_one]) hfun
  intro a b
  exact e.injective (by rw [h a b, map_one])

/-! ## Minimal coverings -/

/-- **A minimal `ξ`-invariant normal subgroup over `A`.**  Given a `ξ`-invariant normal subgroup
`M ⊋ A`, there is a `ξ`-invariant normal subgroup `C` with `A < C ≤ M`, minimal with these
properties; in particular there is no `ξ`-invariant normal subgroup strictly between `A` and
`C`. -/
theorem exists_minimal_covering {P : Type} [Group P] [Finite P]
    (h : IsSuzuki2Grp P) {A M : Subgroup P}
    (hMn : M.Normal) (hMinv : M.map (h.xi : MulAut P).toMonoidHom = M)
    (hAM : A ≤ M) (hMA : M ≠ A) :
    ∃ C : Subgroup P, C.Normal ∧ C.map (h.xi : MulAut P).toMonoidHom = C ∧
      A ≤ C ∧ C ≤ M ∧ C ≠ A ∧
      (∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
        A ≤ D → D ≤ C → D = A ∨ D = C) := by
  classical
  set S : Set (Subgroup P) := {D | D.Normal ∧ D.map (h.xi : MulAut P).toMonoidHom = D ∧
    A ≤ D ∧ D ≤ M ∧ D ≠ A} with hS
  have hSne : S.Nonempty := ⟨M, hMn, hMinv, hAM, le_rfl, hMA⟩
  have hSfin : S.Finite := Set.finite_univ.subset (fun _ _ => trivial)
  obtain ⟨C, hCs, hCmin⟩ := hSfin.exists_minimal hSne
  obtain ⟨hCn, hCinv, hAC, hCM, hCA⟩ := hCs
  refine ⟨C, hCn, hCinv, hAC, hCM, hCA, ?_⟩
  intro D hDn hDinv hAD hDC
  rcases eq_or_ne D A with rfl | hDA
  · exact Or.inl rfl
  · right
    have hDS : D ∈ S := ⟨hDn, hDinv, hAD, hDC.trans hCM, hDA⟩
    exact le_antisymm hDC (hCmin hDS hDC)

/-! ## The Frattini subgroup of a minimal covering -/

/-- The Frattini subgroup of a `2`-group is not generated by a proper subgroup together with
itself: if `A ⊔ Φ(C) = C` for `A ≤ C` in a finite `2`-group `C`, then `A = C`. -/
theorem eq_of_sup_powSub_commutator_eq {P : Type} [Group P] [Finite P] (hP : IsPGroup 2 P) {A C : Subgroup P}
    (hAC : A ≤ C) (h : A ⊔ (powSub C 2 ⊔ ⁅C, C⁆) = C) : A = C := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hpow : powSub C 2 = Work.PGroup.agemo 2 1 C := by
    simp only [Work.Higman.powSub, Work.PGroup.agemo]
    congr 1
  have hfr : Work.PGroup.frattiniIn C = powSub C 2 ⊔ ⁅C, C⁆ := by
    rw [Work.PGroup.frattini_eq_agemo_sup_commutator Nat.prime_two C (hP.to_subgroup C), hpow]
  refine Work.PGroup.eq_of_sup_frattiniIn_eq C A (hP.to_subgroup C) hAC ?_
  rw [hfr]
  exact h

/-- **The Frattini subgroup of a minimal covering lies in the smaller subgroup.**  If `C > A` is
a minimal `ξ`-invariant normal subgroup over `A` (so there is no `ξ`-invariant normal subgroup
strictly between `A` and `C`), then `Φ(C) = powSub C 2 ⊔ ⁅C,C⁆ ≤ A`.

Proof: `D := A ⊔ Φ(C)` is normal in `P` and `ξ`-invariant, and `A ≤ D ≤ C`; `hcover` gives
`D = A` (which is the claim) or `D = C`; in the latter case the non-generation property of the
Frattini subgroup (`eq_of_sup_powSub_commutator_eq`) gives `A = C`, contradicting `A ≠ C`. -/
theorem phi_le_of_minimal_covering {P : Type} [Group P] [Finite P]
    (h : IsSuzuki2Grp P) {A C : Subgroup P} (hAn : A.Normal)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C) :
    powSub C 2 ⊔ ⁅C, C⁆ ≤ A := by
  by_contra hle
  have hCconj : ∀ g : P, C.map (MulAut.conj g).toMonoidHom = C :=
    (Subgroup.normal_iff_map_conj_eq.mp hCn)
  have hpow_n : (powSub C 2).Normal :=
    (Subgroup.normal_iff_map_conj_eq).mpr
      (fun g => map_powSub (MulAut.conj g) (hCconj g) 2)
  have hcom_n : (⁅C, C⁆ : Subgroup P).Normal := Subgroup.commutator_normal C C
  have hDn : (A ⊔ (powSub C 2 ⊔ ⁅C, C⁆)).Normal := Subgroup.sup_normal A (powSub C 2 ⊔ ⁅C, C⁆)
  have hDinv : (A ⊔ (powSub C 2 ⊔ ⁅C, C⁆)).map (h.xi : MulAut P).toMonoidHom
      = A ⊔ (powSub C 2 ⊔ ⁅C, C⁆) := by
    rw [Subgroup.map_sup, Subgroup.map_sup, hAinv, map_powSub (h.xi : MulAut P) hCinv 2,
      Subgroup.map_commutator, hCinv]
  have hAD : A ≤ A ⊔ (powSub C 2 ⊔ ⁅C, C⁆) := le_sup_left
  have hDC : A ⊔ (powSub C 2 ⊔ ⁅C, C⁆) ≤ C :=
    sup_le hAC (sup_le (powSub_le (by norm_num)) (Subgroup.commutator_le_self C))
  have hDA : A ⊔ (powSub C 2 ⊔ ⁅C, C⁆) ≠ A := fun hEq => hle (hEq ▸ le_sup_right)
  rcases hcover _ hDn hDinv hAD hDC with h1 | h1
  · exact hDA h1
  · exact hCA (eq_of_sup_powSub_commutator_eq h.isPGroup hAC h1)

