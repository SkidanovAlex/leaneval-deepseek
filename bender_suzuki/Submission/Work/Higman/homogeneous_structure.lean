/-! ## Elementary calculus of power subgroups

`powSub A n` is the subgroup generated by the `n`-th powers of the elements of `A`; for abelian
`A` it is the set of those powers (`Work.Higman.mem_powSub_iff`).  We record the elementary
properties used in the counting argument below. -/

/-- `powSub A 1 = A`. -/
theorem powSub_one_eq (A : Subgroup P) : powSub A 1 = A := by
  rw [powSub]
  have h : {y : P | ∃ x ∈ A, x ^ 1 = y} = (A : Set P) := by
    ext y; constructor
    · rintro ⟨x, hx, rfl⟩; simpa using hx
    · intro hy; exact ⟨y, hy, by simp⟩
  rw [h, Subgroup.closure_eq]

/-- If `m ∣ n` then the `n`-th power subgroup is contained in the `m`-th one. -/
theorem powSub_le_of_dvd {A : Subgroup P} {m n : ℕ}
    (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) (h : m ∣ n) :
    powSub A n ≤ powSub A m := by
  intro y hy
  rw [mem_powSub_iff hab] at hy ⊢
  obtain ⟨x, hx, rfl⟩ := hy
  obtain ⟨k, rfl⟩ := h
  exact ⟨x ^ k, Subgroup.pow_mem A hx k, by rw [← pow_mul, Nat.mul_comm]⟩

/-- Power subgroups of an abelian subgroup are abelian. -/
theorem powSub_comm {A : Subgroup P} (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) (m : ℕ) :
    ∀ x ∈ powSub A m, ∀ y ∈ powSub A m, x * y = y * x := by
  intro x hx y hy
  rcases Nat.eq_zero_or_pos m with h0 | hpos
  · rw [h0, powSub_zero] at hx hy
    rw [Subgroup.mem_bot.mp hx, Subgroup.mem_bot.mp hy]
  · exact hab x (powSub_le hpos hx) y (powSub_le hpos hy)

/-- Iterated power subgroups: `(A ^ (m)) ^ (n) = A ^ (m * n)`. -/
theorem powSub_powSub {A : Subgroup P} (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (m n : ℕ) : powSub (powSub A m) n = powSub A (m * n) := by
  apply le_antisymm
  · intro y hy
    rw [mem_powSub_iff (powSub_comm hab m)] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    rw [mem_powSub_iff hab] at hz
    obtain ⟨x, hx, rfl⟩ := hz
    rw [mem_powSub_iff hab]
    exact ⟨x, hx, by rw [pow_mul]⟩
  · intro y hy
    rw [mem_powSub_iff hab] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    rw [mem_powSub_iff (powSub_comm hab m)]
    exact ⟨x ^ m, pow_mem_powSub hx, by rw [pow_mul]⟩

/-- Past the exponent the power subgroups vanish. -/
theorem powSub_eq_bot_of_exp {A : Subgroup P} (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    {e k : ℕ} (h : e ≤ k) (h1 : ∀ x ∈ A, x ^ 2 ^ e = 1) :
    powSub A (2 ^ k) = ⊥ := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk
    have he : e = 0 := Nat.le_zero.mp h
    rw [pow_zero, powSub_one_eq, Subgroup.eq_bot_iff_forall]
    intro x hx
    simpa [he] using h1 x hx
  · apply le_antisymm _ bot_le
    intro y hy
    rw [Subgroup.mem_bot]
    rw [mem_powSub_iff hab] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    have hk2 : (2:ℕ) ^ k = 2 ^ e * 2 ^ (k - e) := by
      rw [← pow_add, Nat.add_sub_cancel' h]
    rw [hk2, pow_mul, h1 x hx, one_pow]

/-! ## The cardinality of the squaring map -/

/-- For a homomorphism of groups, `|ker f| * |range f| = |G|`. -/
theorem card_ker_mul_card_range {G G' : Type*} [Group G] [Group G'] (f : G →* G') :
    Nat.card f.ker * Nat.card f.range = Nat.card G := by
  have h := Subgroup.card_mul_index f.ker
  rwa [Subgroup.index_ker f] at h

/-- **The squaring map on a subgroup of an abelian subgroup.**  Let `A` be an abelian subgroup
(`hab`) of a finite group `P`, let `W` be given by `x ^ 2 = 1 ↔ x ∈ W` for `x ∈ A`, and let
`B ≤ A`.  Then `|B| = |B ^ 2| * |B ⊓ W|`. -/
theorem card_powSub_two_mul_card_inf {P : Type} [Group P] [Finite P] (W : Subgroup P)
    {A B : Subgroup P} (hBA : B ≤ A)
    (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hWmem : ∀ x ∈ A, x ^ 2 = 1 ↔ x ∈ W) :
    Nat.card ↥B = Nat.card ↥(powSub B 2) * Nat.card ↥(B ⊓ W) := by
  have hcomB : ∀ x : ↥B, ∀ y : ↥B, Commute x y :=
    fun x y => Subtype.ext (hab x (hBA x.2) y (hBA y.2))
  have habB : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x := fun x hx y hy => hab x (hBA hx) y (hBA hy)
  let sq : ↥B →* ↥B :=
    { toFun := fun x => x ^ 2
      map_one' := by simp
      map_mul' := fun x y => by
        show (x * y) ^ 2 = x ^ 2 * y ^ 2
        exact Commute.mul_pow (hcomB x y) 2 }
  have hker : Nat.card ↥(sq.ker) = Nat.card ↥(B ⊓ W) := by
    refine Nat.card_eq_of_bijective
      (fun x : ↥(sq.ker) =>
        (⟨((x.1 : ↥B) : P), Subgroup.mem_inf.mpr ⟨x.1.2, ?_⟩⟩ : ↥(B ⊓ W))) ?_
    · refine (hWmem ((x.1 : ↥B) : P) (hBA x.1.2)).mp ?_
      have h2 : (x.1 : ↥B) ^ 2 = 1 := (MonoidHom.mem_ker).mp x.2
      simpa [pow_two, Subgroup.coe_pow] using congrArg (fun t : ↥B => (t : P)) h2
    · constructor
      · intro x y hxy
        exact Subtype.ext (Subtype.ext (congrArg (fun t : ↥(B ⊓ W) => (t : P)) hxy))
      · intro y
        have hyB : (y : P) ∈ B := (Subgroup.mem_inf.mp y.2).1
        have hyW : (y : P) ∈ W := (Subgroup.mem_inf.mp y.2).2
        have hsq1 : (⟨(y : P), hyB⟩ : ↥B) ^ 2 = 1 :=
          Subtype.ext (by
            rw [Subgroup.coe_pow, Subgroup.coe_one]
            exact (hWmem (y : P) (hBA hyB)).mpr hyW)
        refine ⟨⟨⟨(y : P), hyB⟩, ?_⟩, Subtype.ext rfl⟩
        show sq _ = 1
        exact hsq1
  have hmem : ∀ y : ↥B, y ∈ sq.range ↔ ∃ z : ↥B, z ^ 2 = y := by
    intro y
    rw [MonoidHom.mem_range]
    constructor
    · rintro ⟨z, hz⟩; exact ⟨z, hz⟩
    · rintro ⟨z, hz⟩; exact ⟨z, hz⟩
  have hrange : Subgroup.map B.subtype sq.range = powSub B 2 := by
    apply le_antisymm
    · rintro x ⟨y, hy, rfl⟩
      obtain ⟨z, rfl⟩ := (hmem y).mp hy
      rw [mem_powSub_iff habB]
      exact ⟨(z : P), z.2, rfl⟩
    · intro x hx
      rw [mem_powSub_iff habB] at hx
      obtain ⟨z, hz, rfl⟩ := hx
      refine ⟨(⟨z, hz⟩ : ↥B) * ⟨z, hz⟩, ?_, ?_⟩
      · refine (hmem _).mpr ⟨⟨z, hz⟩, ?_⟩
        rw [pow_two]
      · simp [pow_two]
  have hrangecard : Nat.card ↥sq.range = Nat.card ↥(powSub B 2) := by
    rw [← Subgroup.card_subtype B sq.range, hrange]
  have hmain := card_ker_mul_card_range sq
  rw [hker, hrangecard] at hmain
  rw [mul_comm]
  exact hmain.symm

/-! ## The tower of power subgroups of an abelian subgroup -/

/-- **The power subgroups of an abelian subgroup form a uniform tower.**  Let `A` be an abelian
subgroup of a finite group `P` (`hab`), all of whose elements satisfy `x ^ (2 ^ e) = 1`, and let
`W` be the elements of `A` with `x ^ 2 = 1`.  If `|A| = |W| ^ e` then the `2 ^ k`-th power
subgroups of `A` all have order `|W| ^ (e - k)`, and the `2 ^ (e - 1)`-st power subgroup of `A`
is exactly `W`.

The squaring map `↥(powSub A (2 ^ k)) → ↥(powSub A (2 ^ (k + 1)))` is onto with kernel
`powSub A (2 ^ k) ⊓ W`, so `|A| = ∏_{k < e} |powSub A (2 ^ k) ⊓ W|`; those factors decrease with
`k` and are at most `|A ⊓ W| = |W|`, while their product is `|W| ^ e`, so all are equal to
`|W|`. -/
theorem powSub_chain_card {P : Type} [Group P] [Finite P] (W : Subgroup P) {A : Subgroup P}
    (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hWle : W ≤ A)
    (hWmem : ∀ x ∈ A, x ^ 2 = 1 ↔ x ∈ W)
    (e : ℕ) (h1 : ∀ x ∈ A, x ^ 2 ^ e = 1)
    (hcard : Nat.card ↥A = (Nat.card ↥W) ^ e) :
    (∀ k ≤ e, Nat.card ↥(powSub A (2 ^ k)) = (Nat.card ↥W) ^ (e - k)) ∧
      powSub A (2 ^ (e - 1)) = W := by
  rcases Nat.eq_zero_or_pos e with he0 | hepos
  · subst he0
    have hA1 : Nat.card ↥A = 1 := by simpa using hcard
    have hsub : Subsingleton ↥A := (Nat.card_eq_one_iff_unique.mp hA1).1
    haveI := hsub
    have hAbot : A = ⊥ := by
      rw [Subgroup.eq_bot_iff_forall]
      intro x hx
      exact congrArg Subtype.val (Subsingleton.elim (⟨x, hx⟩ : ↥A) 1)
    constructor
    · intro k hk
      have hk0 : k = 0 := Nat.le_zero.mp hk
      subst hk0
      rw [pow_zero, powSub_one_eq, hAbot, Subgroup.card_bot]
      simp
    · rw [show (2:ℕ) ^ (0 - 1) = 1 from by norm_num, powSub_one_eq, hAbot]
      exact le_antisymm bot_le (hWle.trans (le_of_eq hAbot))
  haveI hWne : Nonempty ↥W := ⟨⟨1, W.one_mem⟩⟩
  let N : ℕ := Nat.card ↥W
  let a : ℕ → ℕ := fun k => Nat.card ↥(powSub A (2 ^ k))
  let c : ℕ → ℕ := fun k => Nat.card ↥(powSub A (2 ^ k) ⊓ W)
  have hNpos : 0 < N := Nat.card_pos
  have hstep : ∀ k, a k = a (k + 1) * c k := by
    intro k
    have hBsub : powSub A (2 ^ k) ≤ A := by
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk; rw [pow_zero, powSub_one_eq]
      · exact powSub_le (pow_pos (by norm_num) k)
    have hmain := card_powSub_two_mul_card_inf (W := W) (A := A)
      (B := powSub A (2 ^ k)) hBsub hab hWmem
    have hcomp : powSub (powSub A (2 ^ k)) 2 = powSub A (2 ^ (k + 1)) := by
      rw [powSub_powSub hab, pow_succ]
    rw [hcomp] at hmain
    exact hmain
  have hcle : ∀ k, c k ≤ N := by
    intro k
    exact Nat.card_le_card_of_injective
      (fun x : ↥(powSub A (2 ^ k) ⊓ W) =>
        (⟨(x : P), (Subgroup.mem_inf.mp x.2).2⟩ : ↥W))
      (fun x y hxy => Subtype.ext (congrArg (fun t : ↥W => (t : P)) hxy))
  have hbmono : ∀ k, k + 1 ≤ e → a k * N ^ k ≤ a (k + 1) * N ^ (k + 1) := by
    intro k hk
    rw [hstep k]
    calc a (k + 1) * c k * N ^ k ≤ a (k + 1) * N * N ^ k :=
          Nat.mul_le_mul (Nat.mul_le_mul_left _ (hcle k)) (le_refl _)
      _ = a (k + 1) * N ^ (k + 1) := by rw [pow_succ]; ring
  have hb : ∀ k, k ≤ e → a k * N ^ k = N ^ e := by
    intro k hk
    have h1' : a 0 * N ^ 0 ≤ a k * N ^ k :=
      (Nat.le_induction (m := 0) (P := fun j _ => j ≤ e → a 0 * N ^ 0 ≤ a j * N ^ j)
        (fun _ => le_refl _)
        (fun n _ ih hn => le_trans (ih (by omega)) (hbmono n hn))
        k (Nat.zero_le k)) hk
    have h2' : a k * N ^ k ≤ a e * N ^ e :=
      (Nat.le_induction (m := k) (P := fun j _ => j ≤ e → a k * N ^ k ≤ a j * N ^ j)
        (fun _ => le_refl _)
        (fun n _ ih hn => le_trans (ih (by omega)) (hbmono n hn))
        e hk) le_rfl
    have h0 : a 0 * N ^ 0 = N ^ e := by
      have hA0 : a 0 = Nat.card ↥A := by
        show Nat.card ↥(powSub A (2 ^ 0)) = Nat.card ↥A
        rw [pow_zero, powSub_one_eq]
      rw [hA0, pow_zero, mul_one]
      exact hcard
    have he' : a e * N ^ e = N ^ e := by
      have hae : a e = 1 := by
        show Nat.card ↥(powSub A (2 ^ e)) = 1
        rw [powSub_eq_bot_of_exp hab le_rfl h1, Subgroup.card_bot]
      rw [hae, one_mul]
    exact le_antisymm (le_trans h2' (le_of_eq he')) (h0 ▸ h1')
  have hcard_pow : ∀ k ≤ e, a k = N ^ (e - k) := by
    intro k hk
    have hb' := hb k hk
    have hthis : N ^ (e - k) * N ^ k = N ^ e := by rw [← pow_add, Nat.sub_add_cancel hk]
    exact Nat.eq_of_mul_eq_mul_right (pow_pos hNpos k) (hb'.trans hthis.symm)
  have hc_eq : ∀ k, k ≤ e - 1 → c k = N := by
    intro k hk
    have hk1 : k + 1 ≤ e := by omega
    have h3 := hstep k
    have h1' := hcard_pow k (by omega)
    have h2' := hcard_pow (k + 1) hk1
    rw [h1', h2'] at h3
    rw [show e - (k + 1) = e - k - 1 from by omega] at h3
    have hsplit : N ^ (e - k) = N ^ (e - k - 1) * N := by
      rw [← pow_succ, show e - k - 1 + 1 = e - k from by omega]
    rw [hsplit] at h3
    exact (Nat.eq_of_mul_eq_mul_left (pow_pos hNpos _) h3).symm
  have hkey : powSub A (2 ^ (e - 1)) = W := by
    have hc := hc_eq (e - 1) (by omega)
    have hinf : powSub A (2 ^ (e - 1)) ⊓ W = W :=
      Subgroup.eq_of_le_of_card_ge inf_le_right (le_of_eq hc.symm)
    have hle1 : W ≤ powSub A (2 ^ (e - 1)) := hinf ▸ inf_le_left
    have hle2 : powSub A (2 ^ (e - 1)) ≤ W := by
      intro x hx
      rw [mem_powSub_iff hab] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      refine (hWmem (y ^ 2 ^ (e - 1)) (Subgroup.pow_mem A hy _)).mp ?_
      rw [← pow_mul, show 2 ^ (e - 1) * 2 = 2 ^ e from by rw [← pow_succ]; congr 1; omega,
        h1 y hy]
    exact le_antisymm hle2 hle1
  exact ⟨hcard_pow, hkey⟩

/-! ## Irreducibility of `A ⊓ Ω₁(P)` under `ξ` -/

/-- **`A ⊓ Ω₁(P)` is irreducible under `ξ`.**  In a Suzuki 2-group, a `ξ`-invariant subgroup of
`A ⊓ Ω₁(P)` is either trivial or all of `A ⊓ Ω₁(P)`. -/
theorem invariant_subgroup_inf_omega1 {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) (A : Subgroup P) {T : Subgroup P}
    (hT : T ≤ A ⊓ Work.Higman.omega1 P)
    (hinvT : T.map (h.xi : MulAut P).toMonoidHom = T) :
    T = ⊥ ∨ T = A ⊓ Work.Higman.omega1 P := by
  rcases eq_or_ne T ⊥ with hbot | hne
  · exact Or.inl hbot
  · right
    obtain ⟨x0, hx1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hne
    have hxT : ((x0 : ↥T) : P) ∈ T := x0.2
    have hx1' : ((x0 : ↥T) : P) ≠ 1 := fun hc => hx1 (Subtype.ext hc)
    have hxW : ((x0 : ↥T) : P) ∈ A ⊓ Work.Higman.omega1 P := hT hxT
    have hx2 : orderOf ((x0 : ↥T) : P) = 2 := by
      have hd : orderOf ((x0 : ↥T) : P) ∣ 2 :=
        orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp (Subgroup.mem_inf.mp hxW).2)
      rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
      · exact absurd (orderOf_eq_one_iff.mp h1) hx1'
      · exact h2
    have hpres : ∀ k : ℕ, ∀ y : P, y ∈ T → (h.xi ^ k) y ∈ T := by
      intro k
      induction k with
      | zero => intro y hy; simpa using hy
      | succ k ih =>
        intro y hy
        have hz : (h.xi ^ k) y ∈ T := ih y hy
        have hgoal : (h.xi ^ (k + 1)) y = h.xi.toMonoidHom ((h.xi ^ k) y) := by
          rw [pow_succ', MulAut.mul_apply]; rfl
        rw [hgoal]
        have hmem : h.xi.toMonoidHom ((h.xi ^ k) y) ∈ T.map (h.xi : MulAut P).toMonoidHom :=
          Subgroup.mem_map_of_mem _ hz
        rwa [hinvT] at hmem
    apply le_antisymm hT
    intro y hy
    rcases eq_or_ne y 1 with rfl | hy1
    · exact T.one_mem
    · have hy2 : orderOf y = 2 := by
        have hd : orderOf y ∣ 2 :=
          orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp (Subgroup.mem_inf.mp hy).2)
        rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
        · exact absurd (orderOf_eq_one_iff.mp h1) hy1
        · exact h2
      obtain ⟨k, hk⟩ := h.trans ((x0 : ↥T) : P) y hx2 hy2
      rw [← hk]
      exact hpres k ((x0 : ↥T) : P) hxT

/-! ## The induction: invariant subgroups are power subgroups -/

/-- **Higman (1963), Lemma 1, structural part.**  In the situation of the tower above (`A`
abelian, `W` the elements of `A` with `x ^ 2 = 1`, invariant under the automorphism `φ`, with
`W` irreducible under `φ`, exponent `2 ^ e` and `|A| = |W| ^ e`), every `φ`-invariant subgroup
of `A` is a power subgroup `powSub A (2 ^ k)`.

This is proved by strong induction on the exponent: a non-trivial invariant `B ≤ A` contains a
non-trivial involution, hence `W ≤ B`; if `B ⊄ W` then `B ^ 2` is a non-trivial invariant
subgroup of the smaller-exponent group `A ^ 2`, so `B ^ 2 = A ^ (2 ^ (j + 1))` by induction,
and then `B ⊆ A ^ (2 ^ j)` (an element of `B` squaring into `A ^ (2 ^ (j + 1))` differs from a
`2 ^ j`-th power by an element of `W`) with `|B| = |A ^ (2 ^ j)|`, so `B = A ^ (2 ^ j)`. -/
theorem invariant_subgroup_eq_powSub {P : Type} [Group P] [Finite P] {φ : MulAut P}
    {W : Subgroup P} (hWinv : W.map (φ : MulAut P).toMonoidHom = W) :
    ∀ (e : ℕ) (A : Subgroup P),
      (∀ x ∈ A, ∀ y ∈ A, x * y = y * x) →
      (∀ x ∈ A, x ^ 2 = 1 ↔ x ∈ W) →
      (∀ T : Subgroup P, T ≤ W → T.map (φ : MulAut P).toMonoidHom = T → T = ⊥ ∨ T = W) →
      (∀ x ∈ A, x ^ 2 ^ e = 1) →
      Nat.card ↥A = (Nat.card ↥W) ^ e →
      powSub A (2 ^ (e - 1)) = W →
      ∀ B : Subgroup P, B ≤ A → B.map (φ : MulAut P).toMonoidHom = B →
        ∃ k : ℕ, B = powSub A (2 ^ k) := by
  classical
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
    intro A hab hWmem hirr h1 hcard hker B hBA hBinv
    have hWleA : W ≤ A := by
      rw [← hker]
      rcases Nat.eq_zero_or_pos e with he | he
      · subst he
        rw [show (2:ℕ) ^ (0 - 1) = 1 from by norm_num, powSub_one_eq]
      · exact powSub_le (pow_pos (by norm_num) (e - 1))
    rcases eq_or_ne B ⊥ with hBbot | hBne
    · refine ⟨e, ?_⟩
      rw [hBbot]
      exact (powSub_eq_bot_of_exp hab le_rfl h1).symm
    · have hBWne : B ⊓ W ≠ ⊥ := by
        intro hbot
        obtain ⟨x, hx1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hBne
        have hxP : ((x : ↥B) : P) ∈ A := hBA x.2
        have hex : ∃ n, ((x : ↥B) : P) ^ 2 ^ n = 1 := ⟨e, h1 _ hxP⟩
        have hspec : ((x : ↥B) : P) ^ 2 ^ (Nat.find hex) = 1 := Nat.find_spec hex
        have hpos : 1 ≤ Nat.find hex := by
          rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | hpos
          · exfalso
            rw [h0] at hspec
            exact hx1 (Subtype.ext (by simpa using hspec))
          · exact hpos
        have hprev : ((x : ↥B) : P) ^ 2 ^ (Nat.find hex - 1) ≠ 1 :=
          Nat.find_min hex (by omega)
        have hmemB : ((x : ↥B) : P) ^ 2 ^ (Nat.find hex - 1) ∈ B :=
          Subgroup.pow_mem B x.2 _
        have hmemW : ((x : ↥B) : P) ^ 2 ^ (Nat.find hex - 1) ∈ W := by
          refine (hWmem _ (hBA hmemB)).mp ?_
          rw [← pow_mul, show 2 ^ (Nat.find hex - 1) * 2 = 2 ^ Nat.find hex from by
            rw [← pow_succ]; congr 1; omega, hspec]
        have : ((x : ↥B) : P) ^ 2 ^ (Nat.find hex - 1) ∈ (⊥ : Subgroup P) := by
          rw [← hbot]; exact ⟨hmemB, hmemW⟩
        exact hprev (Subgroup.mem_bot.mp this)
      have hWleB : W ≤ B := by
        have hinv_inf : (B ⊓ W).map (φ : MulAut P).toMonoidHom = B ⊓ W := by
          rw [Subgroup.map_inf B W (φ : MulAut P).toMonoidHom (φ : MulAut P).injective,
            hBinv, hWinv]
        rcases hirr (B ⊓ W) inf_le_right hinv_inf with h | h
        · exact absurd h hBWne
        · rw [← h]; exact inf_le_left
      by_cases hBW : B ≤ W
      · refine ⟨e - 1, ?_⟩
        rw [hker]
        exact le_antisymm hBW hWleB
      · have hB2ne : powSub B 2 ≠ ⊥ := by
          intro hbot
          exact hBW (fun x hx => (hWmem x (hBA hx)).mp (by
            have hx2 : x ^ 2 ∈ (⊥ : Subgroup P) := by rw [← hbot]; exact pow_mem_powSub hx
            simpa using Subgroup.mem_bot.mp hx2))
        have he2 : 2 ≤ e := by
          by_contra hlt
          have hWA : W = A := by
            have he01 : e = 0 ∨ e = 1 := by omega
            rcases he01 with h | h
            · rw [h] at hker
              rw [show (2:ℕ) ^ (0 - 1) = 1 from by norm_num, powSub_one_eq] at hker
              exact hker.symm
            · rw [h] at hker
              rw [show (2:ℕ) ^ (1 - 1) = 1 from by norm_num, powSub_one_eq] at hker
              exact hker.symm
          exact hBW (hBA.trans (le_of_eq hWA.symm))
        have hA1sub : powSub A 2 ≤ A := powSub_le (by norm_num)
        have hA1mem : ∀ x ∈ powSub A 2, x ^ 2 ^ (e - 1) = 1 := by
          intro x hx
          rw [mem_powSub_iff hab] at hx
          obtain ⟨y, hy, rfl⟩ := hx
          rw [← pow_mul, show 2 * 2 ^ (e - 1) = 2 ^ e from by rw [← pow_succ']; congr 1; omega,
            h1 y hy]
        have hWleA1 : W ≤ powSub A 2 := by
          rw [← hker]
          exact powSub_le_of_dvd hab ⟨2 ^ (e - 2), by rw [← pow_succ']; congr 1; omega⟩
        have hcardA1 : Nat.card ↥(powSub A 2) = (Nat.card ↥W) ^ (e - 1) := by
          have h := (powSub_chain_card W hab hWleA hWmem e h1 hcard).1 1 (by omega)
          simpa using h
        have hkerA1 : powSub (powSub A 2) (2 ^ ((e - 1) - 1)) = W :=
          (powSub_chain_card W (fun x hx y hy => hab x (hA1sub hx) y (hA1sub hy))
            hWleA1 (fun x hx => hWmem x (hA1sub hx)) (e - 1) hA1mem hcardA1).2
        have hB2sub : powSub B 2 ≤ powSub A 2 := powSub_mono hBA
        have hB2inv : (powSub B 2).map (φ : MulAut P).toMonoidHom = powSub B 2 :=
          map_powSub φ hBinv 2
        obtain ⟨j, hj⟩ := ih (e - 1) (by omega) (powSub A 2)
          (fun x hx y hy => hab x (hA1sub hx) y (hA1sub hy))
          (fun x hx => hWmem x (hA1sub hx)) hirr hA1mem hcardA1 hkerA1
          (powSub B 2) hB2sub hB2inv
        have hj' : powSub B 2 = powSub A (2 ^ (j + 1)) := by
          rw [hj, powSub_powSub hab, pow_succ']
        have hjle : j + 1 ≤ e - 1 := by
          by_contra hcon
          have hge : e ≤ j + 1 := by omega
          have hbot : powSub A (2 ^ (j + 1)) = ⊥ := powSub_eq_bot_of_exp hab hge h1
          exact hB2ne (by rw [hj', hbot])
        have hWle_pow : W ≤ powSub A (2 ^ j) := by
          rw [← hker]
          exact powSub_le_of_dvd hab (Nat.pow_dvd_pow 2 (by omega))
        have hBle : B ≤ powSub A (2 ^ j) := by
          intro x hx
          have hx2 : x ^ 2 ∈ powSub A (2 ^ (j + 1)) := by
            rw [← hj']; exact pow_mem_powSub hx
          rw [mem_powSub_iff hab] at hx2
          obtain ⟨y, hy, hyx⟩ := hx2
          have hzy : (y ^ 2 ^ j) ^ 2 = x ^ 2 := by
            rw [← pow_mul, show 2 ^ j * 2 = 2 ^ (j + 1) from by rw [← pow_succ], hyx]
          have hmemW : x * (y ^ 2 ^ j)⁻¹ ∈ W := by
            refine (hWmem _ (A.mul_mem (hBA hx) (A.inv_mem (Subgroup.pow_mem A hy _)))).mp ?_
            have hcomm : Commute x (y ^ 2 ^ j) := hab x (hBA hx) _ (Subgroup.pow_mem A hy _)
            rw [Commute.mul_pow (hcomm.inv_right) 2, inv_pow, hzy, mul_inv_cancel]
          have h1' : x * (y ^ 2 ^ j)⁻¹ ∈ powSub A (2 ^ j) := hWle_pow hmemW
          have h2' : y ^ 2 ^ j ∈ powSub A (2 ^ j) := pow_mem_powSub hy
          have hxeq : (x * (y ^ 2 ^ j)⁻¹) * (y ^ 2 ^ j) = x := by group
          rw [← hxeq]
          exact Subgroup.mul_mem _ h1' h2'
        have hcardB : Nat.card ↥B = (Nat.card ↥W) ^ (e - j) := by
          have hmain := card_powSub_two_mul_card_inf (W := W) (A := A) (B := B) hBA hab hWmem
          have hBW_eq : B ⊓ W = W := le_antisymm inf_le_right (le_inf hWleB le_rfl)
          rw [hBW_eq, hj'] at hmain
          have hchain := (powSub_chain_card W hab hWleA hWmem e h1 hcard).1 (j + 1) (by omega)
          rw [hchain] at hmain
          rw [hmain, ← pow_succ, show e - (j + 1) + 1 = e - j from by omega]
        refine ⟨j, ?_⟩
        exact Subgroup.eq_of_le_of_card_ge hBle (by
          have hchain := (powSub_chain_card W hab hWleA hWmem e h1 hcard).1 j (by omega)
          rw [hchain, hcardB])

/-! ## Higman's Lemma 1 -/

/-- **Higman 1963, Lemma 1 (homocyclic structure).**  Let `A` be a `ξ`-invariant abelian
subgroup of a Suzuki 2-group `P`.  Then `A` is homocyclic: with `2 ^ e` its exponent, the
`2 ^ i`-th power subgroups `A ^ (2 ^ i)` all have order `|A ⊓ Ω₁(P)| ^ (e - i)`,
`A ^ (2 ^ (e - 1))` is exactly the set of involutions of `A`, i.e. `A ⊓ Ω₁(P)`, and *every*
`ξ`-invariant subgroup of `A` is one of the power subgroups `A ^ (2 ^ i)`. -/
theorem homogeneous_structure {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hinv : A.map (h.xi : MulAut P).toMonoidHom = A) :
    ∃ e : ℕ,
      (∀ x ∈ A, x ^ 2 ^ e = 1) ∧
      (∀ i ≤ e, Nat.card ↥(Work.Higman.powSub A (2 ^ i))
        = (Nat.card ↥(A ⊓ Work.Higman.omega1 P)) ^ (e - i)) ∧
      (Work.Higman.powSub A (2 ^ (e - 1)) = A ⊓ Work.Higman.omega1 P) ∧
      (∀ B : Subgroup P, B ≤ A → B.map (h.xi : MulAut P).toMonoidHom = B →
        ∃ i : ℕ, B = Work.Higman.powSub A (2 ^ i)) := by
  obtain ⟨e, h1, -, hcard⟩ := higman_lemma1 h hab hinv
  set W : Subgroup P := A ⊓ Work.Higman.omega1 P with hW
  have hWle : W ≤ A := inf_le_left
  have hWmem : ∀ x ∈ A, x ^ 2 = 1 ↔ x ∈ W := by
    intro x hx
    constructor
    · intro h2
      exact Subgroup.mem_inf.mpr ⟨hx, h.mem_omega1.mpr h2⟩
    · intro hxW
      exact h.mem_omega1.mp (Subgroup.mem_inf.mp hxW).2
  have hominv : (Work.Higman.omega1 P).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.omega1 P := by
    apply le_antisymm
    · rintro x ⟨y, hy, rfl⟩
      rw [h.mem_omega1, ← map_pow, h.mem_omega1.mp hy, map_one]
    · intro x hx
      refine ⟨(h.xi : MulAut P).symm x, ?_, by simp⟩
      have h2 : ((h.xi : MulAut P).symm x) ^ 2 = 1 := by
        apply (h.xi : MulAut P).injective
        rw [map_pow, MulEquiv.apply_symm_apply, map_one, h.mem_omega1.mp hx]
      simpa using (h.mem_omega1.mpr h2)
  have hWinv : W.map (h.xi : MulAut P).toMonoidHom = W := by
    rw [hW, Subgroup.map_inf A (Work.Higman.omega1 P) (h.xi : MulAut P).toMonoidHom
      (h.xi : MulAut P).injective, hinv, hominv]
  have hchain := powSub_chain_card W hab hWle hWmem e h1 hcard
  refine ⟨e, h1, hchain.1, ?_, ?_⟩
  · simpa [hW] using hchain.2
  · intro B hBA hBinv
    exact invariant_subgroup_eq_powSub (φ := h.xi) (W := W) hWinv e A hab hWmem
      (fun T hT hTinv => invariant_subgroup_inf_omega1 h A hT hTinv) h1 hcard hchain.2
      B hBA hBinv

end Work.Higman
