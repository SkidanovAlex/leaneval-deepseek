# Named subgroups occurring in the `FpfXi` analysis of a Suzuki 2-group

The reduction of `Work.Higman.LayersAlt.sq_mem_center_fpf` (every square of a Suzuki 2-group
with a fixed-point-free `ξ` of order `|Z(P)| - 1` is central) goes through a case split on
whether `P` is of class `2`, and in the non-class-two case through the named subgroups

* `derivTop P = ⁅P, P⁆`  (the derived subgroup),
* `derivDerivTop P = ⁅P', P'⁆` (the second derived subgroup),
* `sqSub P = P² = powSub ⊤ 2` (the subgroup generated by the squares).

They are introduced here (rather than in the target file) so that the two case-exclusion lemmas
that the target file delegates (`class_two_target`, `class_three_exclusion`) can be *stated* in
the same vocabulary without importing the target file itself.
-/

import Mathlib
import Submission.Work.Higman.Defs
import Submission.Work.Higman.Basic
import Submission.Work.Higman.PowSub

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped commutatorElement

namespace Work.Higman.LayersAlt

/-- The derived subgroup `⁅P, P⁆` of a group, as a named subgroup. -/
def derivTop (P : Type) [Group P] : Subgroup P := ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆

/-- The second derived subgroup `⁅P', P'⁆`, where `P' = derivTop P`. -/
def derivDerivTop (P : Type) [Group P] : Subgroup P := ⁅derivTop P, derivTop P⁆

/-- The subgroup generated by the squares of a group, `powSub ⊤ 2`. -/
def sqSub (P : Type) [Group P] : Subgroup P := Work.Higman.powSub (⊤ : Subgroup P) 2

variable {P : Type} [Group P]

theorem derivTop_eq : derivTop P = ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ := rfl

theorem derivDerivTop_eq : derivDerivTop P = ⁅derivTop P, derivTop P⁆ := rfl

theorem sqSub_eq : sqSub P = Work.Higman.powSub (⊤ : Subgroup P) 2 := rfl

/-- `derivTop` is invariant under every automorphism of `P`. -/
theorem map_derivTop (ξ : MulAut P) : (derivTop P).map ξ.toMonoidHom = derivTop P := by
  rw [derivTop, Subgroup.map_commutator]
  rw [Subgroup.map_top_of_surjective _ ξ.surjective]

/-- `derivDerivTop` is invariant under every automorphism of `P`. -/
theorem map_derivDerivTop (ξ : MulAut P) :
    (derivDerivTop P).map ξ.toMonoidHom = derivDerivTop P := by
  rw [derivDerivTop, Subgroup.map_commutator, map_derivTop]

/-- `sqSub P = P²` is invariant under every automorphism of `P`. -/
theorem map_sqSub (ξ : MulAut P) : (sqSub P).map ξ.toMonoidHom = sqSub P := by
  rw [sqSub]
  exact Work.Higman.map_powSub ξ (Subgroup.map_top_of_surjective _ ξ.surjective) 2

/-- `P' ≤ P²`: in any group, `⁅x, y⁆ = x² · (x⁻¹ * y)² · (y²)⁻¹` lies in the subgroup generated
by the squares. -/
theorem derivTop_le_sqSub : derivTop P ≤ sqSub P := by
  rw [derivTop, sqSub, Subgroup.commutator_le]
  intro x _ y _
  have key : ⁅x, y⁆ = x ^ 2 * (x⁻¹ * y) ^ 2 * (y ^ 2)⁻¹ := by
    rw [commutatorElement_def, pow_two (a := x), pow_two (a := x⁻¹ * y), pow_two (a := y)]
    group
  rw [key]
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Work.Higman.pow_mem_powSub (Subgroup.mem_top x))
      (Work.Higman.pow_mem_powSub (Subgroup.mem_top (x⁻¹ * y))))
    (Subgroup.inv_mem _ (Work.Higman.pow_mem_powSub (Subgroup.mem_top y)))

/-- A nontrivial finite `2`-group is not perfect: `P = P'` is impossible. -/
theorem derivTop_ne_top {P : Type} [Group P] [Finite P] (hP : IsPGroup 2 P)
    [Nontrivial P] : derivTop P ≠ ⊤ := by
  intro hc
  have hnil : Group.IsNilpotent P := hP.isNilpotent
  obtain ⟨n, hn⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp hnil
  have hle : ∀ m : ℕ, ⊤ ≤ Subgroup.lowerCentralSeries (⊤ : Subgroup P) m := by
    intro m
    induction m with
    | zero => rw [Subgroup.lowerCentralSeries_zero]
    | succ m ih =>
        rw [Subgroup.lowerCentralSeries_succ]
        calc (⊤ : Subgroup P) = derivTop P := hc.symm
          _ ≤ ⁅Subgroup.lowerCentralSeries (⊤ : Subgroup P) m, (⊤ : Subgroup P)⁆ := by
              rw [derivTop]
              exact Subgroup.commutator_mono ih le_rfl
  have hbot : (⊤ : Subgroup P) ≤ ⊥ := by
    have h1 := hle n
    rwa [hn] at h1
  obtain ⟨a, b, hab⟩ := ‹Nontrivial P›.exists_pair_ne
  have ha : a = 1 := Subgroup.mem_bot.mp (hbot (Subgroup.mem_top a))
  have hb : b = 1 := Subgroup.mem_bot.mp (hbot (Subgroup.mem_top b))
  exact hab (ha.trans hb.symm)

end Work.Higman.LayersAlt
