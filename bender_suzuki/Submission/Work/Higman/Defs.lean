# Suzuki 2-groups: definitions

Higman, *Suzuki 2-groups*, Illinois J. Math. 7 (1963), 79--96.
`REFS/higman_suzuki2groups.md`.

A *Suzuki 2-group* is a finite non-abelian 2-group `P` with more than one involution
admitting a cyclic group of automorphisms permuting its involutions transitively.

This file contains the vocabulary used by the rest of `Submission.Work.Higman`:
* `Invol P` -- the set of involutions of `P`;
* `sqOne P` -- the set of elements of `P` with `x ^ 2 = 1`;
* `omega1 P` -- `Ω₁(P)`, the subgroup generated by the elements of order dividing `2`;
* `IsSuzuki2Grp P` -- the Suzuki 2-group hypothesis, *exposing* the automorphism `ξ`
  (so that later statements can refer to it);
* the bridge to the interface `Submission.Blueprint.IsSuzukiTwoGroup`.

Conventions.  Everything is about groups in `Type`.  `ξ` acts on the *left* (`ξ x`,
`(ξ ^ k) x`); Higman writes his maps on the right -- when transcribing a formula of his,
remember that his `u ξ` is our `ξ u`, and his `(u)^{(2)}` is our squaring map.
-/

import Submission.Blueprint.Interfaces

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option autoImplicit false

namespace Work.Higman

open LeanEval.GroupTheory.Defs

variable {P : Type}

/-! ## Elementary vocabulary -/

section Vocabulary

variable [Group P]

/-- The set of involutions of `P`. -/
def Invol (P : Type*) [Group P] : Set P := {x : P | orderOf x = 2}

/-- The set of elements of `P` whose square is `1`. -/
def sqOne (P : Type*) [Group P] : Set P := {x : P | x ^ 2 = 1}

/-- `Ω₁(P)`: the subgroup generated by the elements of order dividing `2`. -/
def omega1 (P : Type*) [Group P] : Subgroup P := Subgroup.closure (sqOne P)

@[simp] theorem mem_Invol {x : P} : x ∈ Invol P ↔ orderOf x = 2 := Iff.rfl

@[simp] theorem mem_sqOne {x : P} : x ∈ sqOne P ↔ x ^ 2 = 1 := Iff.rfl

theorem sqOne_eq_Invol_insert_one : sqOne P = insert 1 (Invol P) := by
  ext x
  simp only [mem_sqOne, Set.mem_insert_iff, mem_Invol, ← orderOf_dvd_iff_pow_eq_one]
  constructor
  · intro h
    rcases (Nat.dvd_prime Nat.prime_two).mp h with h1 | h2
    · exact Or.inl (orderOf_eq_one_iff.mp h1)
    · exact Or.inr h2
  · rintro (rfl | h)
    · simp
    · rw [h]

end Vocabulary

/-! ## The Suzuki 2-group hypothesis -/

/-- A finite non-abelian 2-group with more than one involution, together with a cyclic
group `⟨ξ⟩` of automorphisms permuting the involutions transitively.

This is `Submission.Blueprint.IsSuzukiTwoGroup` with the automorphism `ξ` exposed. -/
structure IsSuzuki2Grp (P : Type) [Group P] [Finite P] where
  /-- `P` is a 2-group. -/
  isPGroup : IsPGroup 2 P
  /-- `P` is not abelian. -/
  noncomm : ∃ x y : P, x * y ≠ y * x
  /-- `P` has more than one involution. -/
  manyInvol : ∃ x y : P, orderOf x = 2 ∧ orderOf y = 2 ∧ x ≠ y
  /-- The automorphism generating the cyclic group acting on the involutions. -/
  xi : MulAut P
  /-- `ξ` permutes the involutions of `P` transitively. -/
  trans : ∀ x y : P, orderOf x = 2 → orderOf y = 2 → ∃ k : ℕ, (xi ^ k) x = y

variable [Group P] [Finite P]

theorem isSuzukiTwoGroup_iff_nonempty_isSuzuki2Grp :
    Submission.Blueprint.IsSuzukiTwoGroup P ↔ Nonempty (IsSuzuki2Grp P) := by
  constructor
  · rintro ⟨hP, hnc, hinv, ξ, hξ⟩
    exact ⟨⟨hP, hnc, hinv, ξ, hξ⟩⟩
  · rintro ⟨h⟩
    exact ⟨h.isPGroup, h.noncomm, h.manyInvol, h.xi, h.trans⟩

end Work.Higman
