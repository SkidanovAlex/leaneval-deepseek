/-!
# Area `ThmF`: the Chapter V vocabulary (Peterfalvi II, Ch. V)

This file fixes the notation of Peterfalvi, *Le théorème de Bender–Suzuki II*,
Chapter V (pp. 240–256): the family `𝓕` of split rank-one groups, its kernel `𝒩(L)`, the
canonical form, the distinguished involution, the sets `Q₀`, `K = J(D,t)`, `W = C_V(K)`.

Everything here is a definition or an elementary consequence of `IsSplitRankOne`.  The shared
vocabulary of `Submission.Blueprint.Interfaces` (`conj`, `involutions`, `twoPoint`,
`invertedBy`, `IsStronglyEmbedded`) is imported from `Work.Models.Basic`; the mathematical
results of this area live in the sibling directories `Bender/`, `ChV12/`, `ChV3/`.

Conventions (matched to `Submission/Blueprint/Interfaces.lean`):
* `conj g H = g H g⁻¹` (the challenge's conjugation), while Peterfalvi writes `H^g = g⁻¹Hg`
  and acts on the right.  Peterfalvi's `J(X,t) = {x ∈ X | x^t = x⁻¹}` becomes
  `x ∈ X ∧ t x t⁻¹ = x⁻¹`, i.e. `Submission.Blueprint.invertedBy X t`.
* `twoPoint H t = D = H ∩ H^t`, `centD H t = V = C_D(t)`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open LeanEval.GroupTheory.Defs

namespace Work.ThmF

open Submission.Blueprint

variable {G : Type*} [Group G]

/-! ## The sets `Q₀`, `K`, `W` -/

/-- `Q₀ = Inv(H) ∪ {1}` (Peterfalvi II Ch. V §1). -/
def Q0 (H : Subgroup G) : Set G := involutions (H : Set G) ∪ {1}

@[simp] theorem one_mem_Q0 (H : Subgroup G) : (1 : G) ∈ Q0 H := Or.inr rfl

theorem mem_Q0_iff {H : Subgroup G} {x : G} :
    x ∈ Q0 H ↔ (x ∈ H ∧ orderOf x = 2) ∨ x = 1 := by
  simp only [Q0, Set.mem_union, Set.mem_singleton_iff, involutions, Set.mem_setOf_eq]
  tauto

theorem Q0_subset (H : Subgroup G) : Q0 H ⊆ H := by
  intro x hx
  rcases mem_Q0_iff.mp hx with ⟨hxH, -⟩ | rfl
  · exact hxH
  · exact H.one_mem

theorem involutions_subset_Q0 (H : Subgroup G) : involutions (H : Set G) ⊆ Q0 H :=
  fun _ hx => Or.inl hx

/-- `Q₀` as a subgroup (`⟨Inv H⟩`). -/
def Q0sub (H : Subgroup G) : Subgroup G := Subgroup.closure (Q0 H)

theorem Q0_le_Q0sub (H : Subgroup G) : Q0 H ⊆ Q0sub H := Subgroup.subset_closure

theorem Q0sub_le (H : Subgroup G) : Q0sub H ≤ H :=
  (Subgroup.closure_le H).mpr (Q0_subset H)

/-- `q = |Q₀|`. -/
noncomputable def Q0card (H : Subgroup G) : ℕ := (Q0 H).ncard

/-- `n = |Inv(H)|`. -/
noncomputable def invCard (H : Subgroup G) : ℕ := (involutions (H : Set G)).ncard

/-- `K = J(D,t) = {x ∈ D | t x t⁻¹ = x⁻¹}`, Peterfalvi's `K` (a set, a priori). -/
def Kset (H : Subgroup G) (t : G) : Set G := invertedBy (twoPoint H t) t

/-- `⟨K⟩`, the subgroup generated by `K = J(D,t)`. -/
def Ksub (H : Subgroup G) (t : G) : Subgroup G := Subgroup.closure (Kset H t)

theorem mem_Kset_iff {H : Subgroup G} {t x : G} :
    x ∈ Kset H t ↔ x ∈ twoPoint H t ∧ t * x * t⁻¹ = x⁻¹ := Iff.rfl

theorem Kset_subset (H : Subgroup G) (t : G) : Kset H t ⊆ twoPoint H t := fun _ hx => hx.1

theorem Kset_le_Ksub (H : Subgroup G) (t : G) : Kset H t ⊆ Ksub H t := Subgroup.subset_closure

theorem one_mem_Kset (H : Subgroup G) (t : G) : (1 : G) ∈ Kset H t :=
  ⟨(twoPoint H t).one_mem, by simp⟩

/-- `K` is closed under powers (it is `{x ∈ D | t x t⁻¹ = x⁻¹}`). -/
theorem pow_mem_Kset {H : Subgroup G} {t x : G} (hx : x ∈ Kset H t) (n : ℕ) :
    x ^ n ∈ Kset H t := by
  obtain ⟨hxD, hxinv⟩ := hx
  refine ⟨Subgroup.pow_mem _ hxD n, ?_⟩
  have h2 : t * x ^ n * t⁻¹ = (t * x * t⁻¹) ^ n := by
    have := map_pow (MulAut.conj t).toMonoidHom x n
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using this
  rw [h2, hxinv, inv_pow]

/-- `W = C_V(K)` (Peterfalvi II pp. 236, 242). -/
def W (H : Subgroup G) (t : G) : Subgroup G :=
  centD H t ⊓ Subgroup.centralizer (Kset H t)

theorem W_le_centD (H : Subgroup G) (t : G) : W H t ≤ centD H t :=
  fun _ hx => (Subgroup.mem_inf.mp hx).1

theorem le_W_iff {H : Subgroup G} {t : G} {x : G} :
    x ∈ W H t ↔ x ∈ centD H t ∧ ∀ k ∈ Kset H t, k * x = x * k := by
  simp [W, Subgroup.mem_inf, Subgroup.mem_centralizer_iff]

/-- `W = C_D(Inv H)` (Ch. II §4 Prop. 4); recorded as a predicate so that consumers can name
the coincidence. -/
def W_eq_centralizerInv (H : Subgroup G) (t : G) : Prop :=
  (W H t : Set G) = (twoPoint H t ⊓ Subgroup.centralizer (involutions (H : Set G)) : Set G)

/-- The centre `Z(Q)` of a subgroup `Q ≤ G`, viewed as a subgroup of `G`:
`Q` intersected with the centraliser of `Q`. -/
def centerOf (Q : Subgroup G) : Subgroup G := Q ⊓ Subgroup.centralizer (Q : Set G)

theorem mem_centerOf {Q : Subgroup G} {x : G} :
    x ∈ centerOf Q ↔ x ∈ Q ∧ ∀ y ∈ Q, x * y = y * x := by
  rw [centerOf, Subgroup.mem_inf, Subgroup.mem_centralizer_iff]
  exact ⟨fun h => ⟨h.1, fun y hy => (h.2 y hy).symm⟩, fun h => ⟨h.1, fun y hy => (h.2 y hy).symm⟩⟩

/-- `O_2(X)`: the subgroup generated by the elements of `X` of 2-power order (Peterfalvi's
`S` when `X = Q`).  For finite nilpotent `X` this is the unique Sylow 2-subgroup of `X`. -/
def twoPart (X : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ X ∧ ∃ n : ℕ, x ^ 2 ^ n = 1}

/-- `O_{2'}(X)`: the subgroup generated by the odd-order elements of `X` (Peterfalvi's `Q₁`).
For finite nilpotent `X` this is the Hall `2'`-subgroup of `X`. -/
def oddPart (X : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ X ∧ Odd (orderOf x)}

theorem twoPart_le (X : Subgroup G) : twoPart X ≤ X :=
  (Subgroup.closure_le X).mpr fun _ hx => hx.1

theorem oddPart_le (X : Subgroup G) : oddPart X ≤ X :=
  (Subgroup.closure_le X).mpr fun _ hx => hx.1

theorem one_mem_oddPart (X : Subgroup G) : (1 : G) ∈ oddPart X :=
  Subgroup.subset_closure ⟨X.one_mem, by simp [orderOf_one]⟩

theorem mem_oddPart_of_odd (X : Subgroup G) {x : G} (hx : x ∈ X) (h : Odd (orderOf x)) :
    x ∈ oddPart X := Subgroup.subset_closure ⟨hx, h⟩

/-- `G` has a normal subgroup of index `p` — hypothesis (F2) of Peterfalvi II Ch. V §3
(p. 247). -/
def HasNormalIndexP (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ N : Subgroup G, N.Normal ∧ N.index = p

/-! ## The family `𝓕` (Peterfalvi II Ch. V §2, p. 242) -/

/-- `(L,M) ∈ 𝓕`: `L` is finite, `M` is a proper subgroup of even order, `L` acts
2-transitively on the conjugates of `M`, and for `x ∈ L-M` the intersection `M ∩ M^x` has odd
order and has a normal complement in `M`. -/
structure IsBenderFamily (L : Type*) [Group L] (M : Subgroup L) : Prop where
  ne_top : M ≠ ⊤
  even_card : Even (Nat.card M)
  twoTransitive : IsTwoTransitiveOn M
  odd_inter : ∀ x : L, x ∉ M → Odd (Nat.card ↥(M ⊓ conj x M))
  normalComplement : ∀ x : L, x ∉ M → ∃ Q : Subgroup L,
    Q ≤ M ∧ M ≤ Subgroup.normalizer (Q : Set L) ∧ Q ⊓ (M ⊓ conj x M) = ⊥ ∧
      Q ⊔ (M ⊓ conj x M) = M

/-- The kernel `𝒩(L) = ⋂_{x∈L} M^x` of `(L,M) ∈ 𝓕` (Mathlib's `normalCore`). -/
abbrev benderKernel {L : Type*} [Group L] (M : Subgroup L) : Subgroup L := M.normalCore

theorem benderKernel_le {L : Type*} [Group L] (M : Subgroup L) : benderKernel M ≤ M :=
  Subgroup.normalCore_le M

theorem benderKernel_le_self {L : Type*} [Group L] (M : Subgroup L) : benderKernel M ≤ M :=
  benderKernel_le M

theorem benderKernel_normal {L : Type*} [Group L] (M : Subgroup L) :
    (benderKernel M).Normal := Subgroup.normalCore_normal M

theorem benderKernel_eq_iInf {L : Type*} [Group L] (M : Subgroup L) :
    benderKernel M = ⨅ g : L, conj g M := by
  rw [benderKernel, Subgroup.normalCore_eq_iInf_map_conj]
  rfl

theorem le_benderKernel_iff {L : Type*} [Group L] {M N : Subgroup L} :
    N ≤ benderKernel M ↔ ∀ g : L, N ≤ conj g M := by
  rw [benderKernel_eq_iInf, le_iInf_iff]

/-! ## Split rank-one data -/

/-- The data used throughout Chapter V (and Chapter VII): `M ≤ L` is a Bender subgroup, `t` an
involution outside it, `M = Q ⋊ (M ∩ M^t)`.  This is `IsSplitRankOne` with `IsStronglyEmbedded`
replaced by the explicit list of its consequences (so that it can also be used for `C_G(P)`,
whose Bender subgroup is not strongly embedded *in `G`*). -/
structure IsSplitRankOneData (L : Type*) [Group L]
    (M Q : Subgroup L) (t : L) : Prop where
  ne_top : M ≠ ⊤
  even_card : Even (Nat.card M)
  twoTransitive : IsTwoTransitiveOn M
  odd_inter : ∀ x : L, x ∉ M → Odd (Nat.card ↥(M ⊓ conj x M))
  invol : orderOf t = 2
  not_mem : t ∉ M
  le : Q ≤ M
  normal : M ≤ Subgroup.normalizer (Q : Set L)
  inf_eq : Q ⊓ (M ⊓ conj t M) = ⊥
  sup_eq : Q ⊔ (M ⊓ conj t M) = M

/-- `IsSplitRankOne` is a special case of `IsSplitRankOneData`. -/
theorem IsSplitRankOne.toData {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    IsSplitRankOneData G H Q t where
  ne_top := h.stronglyEmbedded.1
  even_card := h.stronglyEmbedded.2.1
  twoTransitive := h.twoTransitive
  odd_inter x hx := h.stronglyEmbedded.2.2 x hx
  invol := h.invol
  not_mem := h.not_mem
  le := h.le
  normal := h.normal
  inf_eq := h.inf_eq
  sup_eq := h.sup_eq

/-- The family conditions give `IsSplitRankOneData` with the normal complement at `t`. -/
theorem IsBenderFamily.toData {L : Type*} [Group L] {M Q : Subgroup L} {t : L}
    (hF : IsBenderFamily L M) (hinvol : orderOf t = 2) (hnot : t ∉ M) (hle : Q ≤ M)
    (hnormal : M ≤ Subgroup.normalizer (Q : Set L)) (hinf : Q ⊓ (M ⊓ conj t M) = ⊥)
    (hsup : Q ⊔ (M ⊓ conj t M) = M) : IsSplitRankOneData L M Q t where
  ne_top := hF.ne_top
  even_card := hF.even_card
  twoTransitive := hF.twoTransitive
  odd_inter := hF.odd_inter
  invol := hinvol
  not_mem := hnot
  le := hle
  normal := hnormal
  inf_eq := hinf
  sup_eq := hsup

/-! ## Elementary consequences of `IsSplitRankOne` -/

theorem split_ne_top {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) : H ≠ ⊤ :=
  h.stronglyEmbedded.1

theorem split_even_card_H {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    Even (Nat.card H) := h.stronglyEmbedded.2.1

/-- `D = H ∩ H^t` has odd order (strong embeddedness, `t ∉ H`). -/
theorem split_odd_card_twoPoint {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    Odd (Nat.card (twoPoint H t)) :=
  h.stronglyEmbedded.2.2 t h.not_mem

theorem split_twoPoint_eq {H Q : Subgroup G} {t : G} (_ : IsSplitRankOne H Q t) :
    twoPoint H t = H ⊓ conj t H := rfl

theorem split_inf_eq {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    Q ⊓ twoPoint H t = ⊥ := h.inf_eq

theorem split_sup_eq {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    Q ⊔ twoPoint H t = H := h.sup_eq

theorem split_le_normalizer {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    H ≤ Subgroup.normalizer (Q : Set G) := h.normal

theorem split_Q_le {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) : Q ≤ H := h.le

theorem split_t_not_mem {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) : t ∉ H := h.not_mem

theorem split_orderOf_t {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    orderOf t = 2 := h.invol

theorem split_twoTransitive {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    IsTwoTransitiveOn H := h.twoTransitive

/-- `Q ⊴ H`. -/
theorem split_Q_normal_in_H {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    (Q.subgroupOf H).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer h.le).mpr h.normal

theorem split_le_normalizer_twoPoint {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    twoPoint H t ≤ Subgroup.normalizer (Q : Set G) :=
  fun _ hx => h.normal (Subgroup.mem_inf.mp hx).1

/-- Every element of `H` factors uniquely as `d * q` with `d ∈ D`, `q ∈ Q`. -/
theorem split_exists_unique_factor {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t)
    {x : G} (hx : x ∈ H) :
    ∃! p : G × G, p.1 ∈ twoPoint H t ∧ p.2 ∈ Q ∧ p.1 * p.2 = x := by
  have hx' : x ∈ (↑(twoPoint H t ⊔ Q) : Set G) := by
    rw [sup_comm, h.sup_eq]; exact hx
  rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ (split_le_normalizer_twoPoint h)] at hx'
  rw [Set.mem_mul] at hx'
  obtain ⟨d, hd, q, hq, hdq⟩ := hx'
  refine ⟨(d, q), ⟨hd, hq, hdq⟩, ?_⟩
  rintro ⟨d', q'⟩ ⟨hd', hq', hd'q'⟩
  have h1 : d * q = d' * q' := by rw [hdq, hd'q']
  have h5 : d' = d * q * q'⁻¹ := by
    have := congrArg (fun z => z * q'⁻¹) h1
    simpa [mul_assoc] using this.symm
  have hmem : d⁻¹ * d' ∈ twoPoint H t ⊓ Q := by
    refine ⟨(twoPoint H t).mul_mem ((twoPoint H t).inv_mem hd) hd', ?_⟩
    have : d⁻¹ * d' = q * q'⁻¹ := by rw [h5]; group
    rw [this]
    exact Q.mul_mem hq (Q.inv_mem hq')
  rw [inf_comm, h.inf_eq, Subgroup.mem_bot] at hmem
  have hdd : d' = d := by
    have := congrArg (fun z => d * z) hmem
    simpa using this
  have hqq : q' = q := by
    have h2 : d * q = d * q' := by
      calc d * q = x := hdq
        _ = d' * q' := hd'q'.symm
        _ = d * q' := by rw [hdd]
    exact (mul_left_cancel h2).symm
  simp [hdd, hqq]

/-- The multiplication map `D × Q → H`. -/
noncomputable def splitEquiv {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    (twoPoint H t) × Q ≃ H :=
  Equiv.ofBijective
    (fun p : (twoPoint H t) × Q =>
      (⟨(p.1 : G) * (p.2 : G), H.mul_mem (Subgroup.mem_inf.mp p.1.2).1 (h.le p.2.2)⟩ : H))
    (by
      constructor
      · intro p q hpq
        have hval : (p.1 : G) * (p.2 : G) = (q.1 : G) * (q.2 : G) := by
          simpa using congrArg (fun z : H => (z : G)) hpq
        have h5 : (q.1 : G) = (p.1 : G) * (p.2 : G) * (q.2 : G)⁻¹ := by
          have := congrArg (fun z => z * (q.2 : G)⁻¹) hval
          simpa [mul_assoc] using this.symm
        have hmem : (p.1 : G)⁻¹ * (q.1 : G) ∈ twoPoint H t ⊓ Q := by
          refine ⟨(twoPoint H t).mul_mem ((twoPoint H t).inv_mem p.1.2) q.1.2, ?_⟩
          have : (p.1 : G)⁻¹ * (q.1 : G) = (p.2 : G) * (q.2 : G)⁻¹ := by rw [h5]; group
          rw [this]
          exact Q.mul_mem p.2.2 (Q.inv_mem q.2.2)
        rw [inf_comm, h.inf_eq, Subgroup.mem_bot] at hmem
        have h1 : (q.1 : G) = (p.1 : G) := by
          have := congrArg (fun z => (p.1 : G) * z) hmem
          simpa using this
        have h2 : (q.2 : G) = (p.2 : G) := by
          have h8 : (p.1 : G) * ((p.2 : G) * (q.2 : G)⁻¹) = (p.1 : G) * 1 := by
            rw [mul_one, ← mul_assoc, h5.symm, h1]
          have h9 : (p.2 : G) * (q.2 : G)⁻¹ = 1 := mul_left_cancel h8
          have h10 : (p.2 : G) = (q.2 : G) := by
            have h11 := congrArg (fun z => z * (q.2 : G)) h9
            simpa [mul_assoc] using h11
          exact h10.symm
        exact Prod.ext (Subtype.ext h1.symm) (Subtype.ext h2.symm)
      · intro x
        have hx' : (x : G) ∈ (↑(twoPoint H t ⊔ Q) : Set G) := by
          rw [sup_comm, h.sup_eq]; exact x.2
        rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ (split_le_normalizer_twoPoint h)] at hx'
        rw [Set.mem_mul] at hx'
        obtain ⟨d, hd, q, hq, hdq⟩ := hx'
        refine ⟨(⟨d, hd⟩, ⟨q, hq⟩), ?_⟩
        exact Subtype.ext hdq)

/-- `|H| = |Q| * |D|`. -/
theorem split_card_H {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    Nat.card H = Nat.card Q * Nat.card (twoPoint H t) := by
  have : Nat.card H = Nat.card ((twoPoint H t) × Q) :=
    Nat.card_congr (splitEquiv h).symm
  rw [this, Nat.card_prod, Nat.mul_comm]

theorem split_card_twoPoint_dvd {H Q : Subgroup G} {t : G} (h : IsSplitRankOne H Q t) :
    Nat.card (twoPoint H t) ∣ Nat.card H := by
  rw [split_card_H h]
  exact dvd_mul_left _ _

end Work.ThmF
