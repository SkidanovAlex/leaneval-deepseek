/-!
# Every involution lies in a conjugate of a strongly embedded subgroup

Peterfalvi I, Ch. I §1 (3) and §1 (10) (a): if `H` is strongly embedded in the finite group `G`,
then every Sylow 2-subgroup of `H` is a Sylow 2-subgroup of `G`; consequently, by Sylow's
theorem, every involution of `G` lies in some conjugate of `H`.

The proof here is the classical one:
* pick a Sylow 2-subgroup `Q` of `H`, and let `P₀` be its image in `G`.  Since `|H|` is even,
  `|P₀| = |Q|` is even, so by §1 (2) (`IsStronglyEmbedded.normalizer_le_of_le`) we have
  `N_G(P₀) ≤ H`;
* `P₀` is maximal among the 2-subgroups of `H` (it is the image of a Sylow subgroup of `H`),
  and `P₀ ⊴ N_G(P₀) ≤ H`, so `P₀` is maximal among the 2-subgroups of `G` as well
  (`pgroupLeOfInfLe`: a proper subgroup of a finite 2-group is properly contained in its
  normalizer, Mathlib's `NormalizerCondition` for nilpotent groups);
* the subgroup generated by an involution `u` is a 2-group, so it is contained in a Sylow
  2-subgroup `S` of `G`; all Sylow 2-subgroups are conjugate, `S = S₀^g` with `S₀ ≅ P₀ ≤ H`,
  whence `u ∈ conj g H`.
-/

open scoped Pointwise

namespace Work.ThmF.Bender

open LeanEval.GroupTheory.Defs Submission.Blueprint in theorem involutionMemConj {G : Type*} [Group G] [Finite G] {H : Subgroup G} (hH : IsStronglyEmbedded H) {u : G} (hu2 : orderOf u = 2) : ∃ g : G, u ∈ conj g H := by
  classical
  have hHeven : Even (Nat.card H) := hH.2.1
  -- a Sylow 2-subgroup `Q` of `H` and its image `P₀` in `G`
  let Q : Sylow 2 ↥H := default
  set P0 : Subgroup G := (Q : Subgroup ↥H).map H.subtype with hP0
  have hP0_le : P0 ≤ H := by
    rw [hP0]
    intro x hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact y.2
  have hP0_even : Even (Nat.card P0) := by
    rw [hP0]; exact evenCardMapSylow hHeven Q
  have hP0_pg : IsPGroup 2 P0 := by
    rw [hP0]; exact (Q.isPGroup').map H.subtype
  -- §1 (2): the normaliser of an even-order subgroup of `H` lies in `H`
  have hN : Subgroup.normalizer (P0 : Set G) ≤ H :=
    Work.Models.IsStronglyEmbedded.normalizer_le_of_le hH hP0_le hP0_even
  -- `P₀` is maximal among the 2-subgroups of `H`
  have hmaxH : ∀ S : Subgroup G, IsPGroup 2 S → S ≤ H → P0 ≤ S → S ≤ P0 := by
    intro S hS hSH hle
    rw [hP0] at hle ⊢
    exact mapSylowMaximal Q S hS hSH hle
  -- ... hence among the 2-subgroups of `G`
  have hmaxG : ∀ R : Subgroup G, IsPGroup 2 R → P0 ≤ R → R ≤ P0 := by
    intro R hR hle
    exact pgroupLeOfInfLe hR hle hN (hmaxH (R ⊓ H) hR.to_inf_left inf_le_right (le_inf hle hP0_le))
  -- turn `P₀` into a genuine `Sylow 2 G`
  obtain ⟨S0, hS0⟩ := hP0_pg.exists_le_sylow
  have hS0eq : (S0 : Subgroup G) = P0 := le_antisymm (hmaxG (S0 : Subgroup G) S0.isPGroup' hS0) hS0
  have hS0H : (S0 : Subgroup G) ≤ H := hS0eq ▸ hP0_le
  -- the subgroup generated by `u` is a 2-group, so sits in some Sylow 2-subgroup
  have hzp : IsPGroup 2 (Subgroup.zpowers u) := by
    apply IsPGroup.of_card (n := 1)
    rw [Nat.card_zpowers, hu2]
    norm_num
  obtain ⟨S, hSu⟩ := hzp.exists_le_sylow
  -- Sylow conjugacy
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G S0 S
  refine ⟨g, ?_⟩
  have hu : u ∈ ((g • S0 : Sylow 2 G) : Set G) := by
    rw [hg]
    exact hSu (Subgroup.mem_zpowers u)
  have h2 : u ∈ MulAut.conj g • (S0 : Set G) := by
    rw [← Sylow.coe_smul]
    exact hu
  rw [Set.mem_smul_set] at h2
  obtain ⟨y, hy, hyu⟩ := h2
  rw [MulAut.smul_def, MulAut.conj_apply] at hyu
  rw [Submission.Blueprint.conj, Subgroup.mem_map]
  refine ⟨y, hS0H hy, ?_⟩
  rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
  exact hyu

end Work.ThmF.Bender
