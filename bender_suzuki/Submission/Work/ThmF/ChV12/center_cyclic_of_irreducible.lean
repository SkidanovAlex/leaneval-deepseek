/-!
# The center of an irreducible faithful linear group over `𝔽₂` is cyclic

Let `P` be a finite group acting faithfully and irreducibly on a finite `𝔽₂`-vector
space `V` (here `ρ : P →* (V ≃ₗ[ZMod 2] V)` is the action, `hfaith` says it is faithful
and `hirr` says the only `P`-invariant subspaces are `⊥` and `⊤`).  Then the center
`Z(P)` is cyclic.

The argument is Schur's lemma in the following form.  Let
`A = 𝔽₂[ρ(Z(P))] ⊆ End_{𝔽₂}(V)` be the commutative `𝔽₂`-subalgebra generated by the
image of the center.  Every element of `A` commutes with the whole image of `ρ` (the
generators `ρ z`, `z ∈ Z(P)`, do).  Hence, for `0 ≠ a ∈ A`, the kernel of `a` is a
`P`-invariant submodule of `V`; it is not all of `V`, so by irreducibility it is `⊥`.
Thus `A` is a finite ring without zero divisors, i.e. a domain.  The center `Z(P)`
embeds into `A` (faithfulness of `ρ`), so `Z(P)` is a finite subgroup of the
multiplicative monoid of a domain, which is cyclic (`isCyclic_of_injective_ringHom`).
-/

set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

namespace Work.ThmF.ChV12

theorem center_cyclic_of_irreducible
    {P : Type*} [Group P] [Finite P]
    {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : P →* (V ≃ₗ[ZMod 2] V)) (hfaith : Function.Injective ρ)
    (hirr : ∀ W : Submodule (ZMod 2) V, W ≠ ⊥ →
      (∀ g : P, ∀ x ∈ W, ρ g x ∈ W) → W = ⊤) :
    IsCyclic ↥(Subgroup.center P) := by
  classical
  by_cases hV : Nontrivial V
  · haveI : Nontrivial V := hV
    -- The set of generators of the algebra `A`: the image of the center under `ρ`.
    let S : Set (Module.End (ZMod 2) V) :=
      Set.range (fun z : ↥(Subgroup.center P) => (ρ (z : P) : V →ₗ[ZMod 2] V))
    let A : Subalgebra (ZMod 2) (Module.End (ZMod 2) V) := Algebra.adjoin (ZMod 2) S
    -- The generators pairwise commute (the center is abelian).
    have hScomm : S.Pairwise Commute := by
      rintro x ⟨z, rfl⟩ y ⟨w, rfl⟩ _
      rw [Commute, SemiconjBy]
      ext v
      rw [Module.End.mul_apply, Module.End.mul_apply]
      change (ρ (z : P) : V ≃ₗ[ZMod 2] V) ((ρ (w : P) : V ≃ₗ[ZMod 2] V) v)
        = (ρ (w : P) : V ≃ₗ[ZMod 2] V) ((ρ (z : P) : V ≃ₗ[ZMod 2] V) v)
      rw [← LinearEquiv.mul_apply, ← LinearEquiv.mul_apply, ← map_mul, ← map_mul,
        Subgroup.mem_center_iff.mp z.2 w]
    haveI : IsMulCommutative A := Algebra.isMulCommutative_adjoin (ZMod 2) hScomm
    letI : CommRing A :=
      { (inferInstance : Ring A) with
        mul_comm := fun a b => isMulCommutative_iff.mp inferInstance a b }
    -- Every element of `A` commutes with the whole action `ρ`.
    have hcomm_adjoin : ∀ a ∈ A, ∀ g : P,
        (ρ g : V →ₗ[ZMod 2] V) * a = a * (ρ g : V →ₗ[ZMod 2] V) := by
      intro a ha g
      exact Algebra.commute_of_mem_adjoin_of_forall_mem_commute (R := ZMod 2)
        (a := (ρ g : V →ₗ[ZMod 2] V)) (s := S) ha (fun b hb => by
          obtain ⟨z, rfl⟩ := hb
          rw [Commute, SemiconjBy]
          ext v
          rw [Module.End.mul_apply, Module.End.mul_apply]
          change (ρ g : V ≃ₗ[ZMod 2] V) ((ρ (z : P) : V ≃ₗ[ZMod 2] V) v)
            = (ρ (z : P) : V ≃ₗ[ZMod 2] V) ((ρ g : V ≃ₗ[ZMod 2] V) v)
          rw [← LinearEquiv.mul_apply, ← LinearEquiv.mul_apply, ← map_mul, ← map_mul,
            Subgroup.mem_center_iff.mp z.2 g])
    -- Schur's lemma: a nonzero element of `A` has trivial kernel.
    have hker : ∀ a : Module.End (ZMod 2) V, a ∈ A → a ≠ 0 →
        LinearMap.ker a = ⊥ := by
      intro a ha hane
      rcases eq_or_ne (LinearMap.ker a) ⊥ with h | h
      · exact h
      · exfalso
        have hinv : ∀ g : P, ∀ x ∈ LinearMap.ker a, ρ g x ∈ LinearMap.ker a := by
          intro g x hx
          rw [LinearMap.mem_ker] at hx ⊢
          calc a (ρ g x) = a ((ρ g : V →ₗ[ZMod 2] V) x) := rfl
            _ = (a * (ρ g : V →ₗ[ZMod 2] V)) x := by rw [Module.End.mul_apply]
            _ = ((ρ g : V →ₗ[ZMod 2] V) * a) x := by rw [← hcomm_adjoin a ha g]
            _ = (ρ g : V →ₗ[ZMod 2] V) (a x) := by rw [Module.End.mul_apply]
            _ = 0 := by rw [hx, map_zero]
        have htop : LinearMap.ker a = ⊤ := hirr _ h hinv
        apply hane
        apply LinearMap.ext
        intro v
        have hv : v ∈ LinearMap.ker a := by rw [htop]; trivial
        rw [LinearMap.mem_ker] at hv
        simpa using hv
    -- `A` is nontrivial since `V` is.
    have h10 : (1 : A) ≠ 0 := by
      intro h
      have h' : (1 : Module.End (ZMod 2) V) = 0 := by
        simpa using congrArg (fun z : A => (z : Module.End (ZMod 2) V)) h
      obtain ⟨x, hx⟩ := exists_ne (0 : V)
      have hx0 : x = 0 := by
        have := congrArg (fun f : Module.End (ZMod 2) V => f x) h'
        rw [Module.End.one_apply, LinearMap.zero_apply] at this
        exact this
      exact hx hx0
    haveI : Nontrivial A := ⟨1, 0, h10⟩
    -- `A` has no zero divisors, using Schur's lemma.
    haveI : NoZeroDivisors A := ⟨by
      intro a b hab
      by_cases ha : a = 0
      · exact Or.inl ha
      · right
        have hane : (a : Module.End (ZMod 2) V) ≠ 0 := by
          intro h; exact ha (Subtype.ext h)
        have hinj : Function.Injective (a : V →ₗ[ZMod 2] V) := by
          rw [← LinearMap.ker_eq_bot]; exact hker (a : Module.End (ZMod 2) V) a.2 hane
        apply Subtype.ext
        apply LinearMap.ext
        intro x
        have h0 : (a : V →ₗ[ZMod 2] V) ((b : V →ₗ[ZMod 2] V) x) = 0 := by
          have h1 : ((a * b : A) : Module.End (ZMod 2) V) x = 0 := by
            rw [hab, Subalgebra.coe_zero, LinearMap.zero_apply]
          rwa [Subalgebra.coe_mul, Module.End.mul_apply] at h1
        have h2 : (a : V →ₗ[ZMod 2] V) ((b : V →ₗ[ZMod 2] V) x)
            = (a : V →ₗ[ZMod 2] V) 0 := by rw [map_zero]; exact h0
        exact hinj h2⟩
    haveI : IsDomain A := IsDomain.mk
    haveI : Finite ↥(Subgroup.center P) := Subtype.finite
    -- The center embeds into the domain `A` via `ρ`.
    let ρA : ↥(Subgroup.center P) →* A :=
      { toFun := fun z =>
          ⟨(ρ (z : P) : V →ₗ[ZMod 2] V), Algebra.subset_adjoin (Set.mem_range_self z)⟩
        map_one' := by
          apply Subtype.ext
          show (ρ ((1 : ↥(Subgroup.center P)) : P) : V →ₗ[ZMod 2] V)
            = (1 : Module.End (ZMod 2) V)
          rw [Subgroup.coe_one, map_one]
          rfl
        map_mul' := by
          intro z w
          apply Subtype.ext
          show (ρ (((z * w : ↥(Subgroup.center P)) : P)) : V →ₗ[ZMod 2] V)
            = (ρ (z : P) : V →ₗ[ZMod 2] V) * (ρ (w : P) : V →ₗ[ZMod 2] V)
          rw [Subgroup.coe_mul, map_mul, LinearEquiv.coe_toLinearMap_mul] }
    have hρAinj : Function.Injective ρA := by
      intro z w h
      have h' : ((ρ (z : P) : V ≃ₗ[ZMod 2] V) : V →ₗ[ZMod 2] V)
          = ((ρ (w : P) : V ≃ₗ[ZMod 2] V) : V →ₗ[ZMod 2] V) :=
        congrArg (fun u : A => (u : Module.End (ZMod 2) V)) h
      exact Subtype.ext (hfaith (LinearEquiv.toLinearMap_injective h'))
    -- A finite subgroup of the multiplicative monoid of a domain is cyclic.
    exact isCyclic_of_injective_ringHom ρA hρAinj
  · -- Degenerate case: `V` is the zero module, so `P` is trivial.
    haveI : Subsingleton V := ⟨fun a b => by
      by_contra h
      exact hV ⟨a, b, h⟩⟩
    haveI : Subsingleton (V ≃ₗ[ZMod 2] V) :=
      ⟨fun f g => LinearEquiv.ext (fun x => Subsingleton.elim _ _)⟩
    haveI : Subsingleton P := ⟨fun a b => hfaith (Subsingleton.elim _ _)⟩
    haveI : Subsingleton ↥(Subgroup.center P) :=
      ⟨fun a b => Subtype.ext (Subsingleton.elim _ _)⟩
    infer_instance

end Work.ThmF.ChV12
