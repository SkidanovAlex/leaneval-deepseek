/-!
# Peterfalvi II, Ch. V, §3: `V/W` is cyclic (Bender–Suzuki)

Peterfalvi's Proposition 3 of Chapter V (p. 247 of *Le théorème de Bender–Suzuki II*) attaches to
the split rank-one configuration a field `F` of order `2 ^ n`, on whose additive group `Q₀ = Inv(H)`
is modelled (`e : Q₀ ≃* Multiplicative F`), together with an action `ρ` of `V = C_D(t)` on `F` by
*ring* automorphisms whose kernel is `W = C_V(K)`.

Since `F` is a finite field of characteristic `2`, it has `2^n` elements and its ring automorphism
group is `Gal(F/𝔽₂) ≅ ℤ/n`, generated by the Frobenius.  Hence `ρ.range` is a subgroup of a cyclic
group of order `n`, so `V/W ≅ ρ.range` is cyclic, generated by the image `v₀` of a generator, with
`v₀ ^ n ∈ W` (Lagrange).  This is exactly the statement of `prop3_quot_cyclic`.

The two field-theoretic inputs (`Work.ThmF.ChV12.isCyclic_ringEquiv_finiteField`,
`Work.ThmF.ChV12.natCard_ringEquiv_finiteField`) and the abstract group-theoretic extraction of the
generator (`Work.ThmF.ChV12.existsPowOfCyclic`) are separate lemmas, proved in the sibling files.
-/

namespace Work.ThmF.ChV12

open Classical Submission.Blueprint in theorem prop3_quot_cyclic {G : Type} [Group G] [Finite G] (n : ℕ) (H Q : Subgroup G) (t : G) (hQ0 : Nat.card ↥(Work.ThmF.Q0sub H) = 2 ^ n) (hstr : ∃ (F : Type) (_ : Field F) (_ : Fintype F) (e : ↥(Work.ThmF.Q0sub H) ≃* Multiplicative F) (ρ : ↥(centD H t) →* (F ≃+* F)), ρ.ker = (Work.ThmF.W H t).subgroupOf (centD H t)) : ∃ v₀ ∈ centD H t, v₀ ^ n ∈ Work.ThmF.W H t ∧ ∀ v ∈ centD H t, ∃ m : ℕ, v * (v₀ ^ m)⁻¹ ∈ Work.ThmF.W H t := by
  -- unfold the field `F` and the action `ρ`
  obtain ⟨F, hField, hFintype, e, ρ, hker⟩ := hstr
  letI : Field F := hField
  letI : Fintype F := hFintype
  -- `|F| = 2 ^ n`, transported from `Q₀` along `e`
  have hcardF : Nat.card F = 2 ^ n := by
    have h := Nat.card_congr e.toEquiv
    rw [hQ0] at h
    exact h.symm
  -- `n ≠ 0` (a field has at least two elements)
  have hn0 : n ≠ 0 := by
    intro hn
    have h1 : Nat.card F = 1 := by rw [hcardF, hn, pow_zero]
    have h2 : 2 ≤ Nat.card F := by
      rw [← Fintype.card_eq_nat_card]
      exact Fintype.one_lt_card
    omega
  -- the characteristic of `F` is `2`: it divides `|F| = 2 ^ n`
  obtain ⟨p, hcharp⟩ := CharP.exists F
  obtain ⟨k, hkprime, hkcard⟩ := FiniteField.card F p
  have hp2 : p = 2 := by
    have hpk : p ^ (k : ℕ) = 2 ^ n := by
      rw [← hkcard, Fintype.card_eq_nat_card, hcardF]
    have hdvd : p ∣ 2 ^ n := by
      rw [← hpk]
      exact dvd_pow_self p k.ne_zero
    have hdvd2 : p ∣ 2 := Nat.Prime.dvd_of_dvd_pow hkprime hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h | h
    · exact absurd h hkprime.ne_one
    · exact h
  haveI : CharP F 2 := hp2 ▸ hcharp
  -- view `F` as an `𝔽₂`-algebra, so that `F ≃+* F = Gal(F/𝔽₂)`
  letI : Algebra (ZMod 2) F := ZMod.algebra F 2
  -- `[F : 𝔽₂] = n`, since `|F| = 2 ^ n`
  have hfinrank : Module.finrank (ZMod 2) F = n := by
    have h1 : 2 ^ Module.finrank (ZMod 2) F = Nat.card F :=
      FiniteField.pow_finrank_eq_natCard 2 F
    rw [hcardF] at h1
    exact Nat.pow_right_injective (le_refl 2) h1
  -- `Aut(F)` is cyclic of order `n`
  haveI : IsCyclic (F ≃+* F) := isCyclic_ringEquiv_finiteField
  have hcardAut : Nat.card (F ≃+* F) = n := natCard_ringEquiv_finiteField n hcardF
  haveI : Finite (F ≃+* F) := (Nat.card_ne_zero.mp (by rw [hcardAut]; exact hn0)).2
  -- extract a generator `v₀` of `V` for the cyclic group `ρ.range`
  obtain ⟨v₀, hv₀pow, hv₀gen⟩ := existsPowOfCyclic n hcardAut ρ
  refine ⟨(v₀ : G), v₀.2, ?_, ?_⟩
  · -- `v₀ ^ n ∈ W`, since it lies in `ker ρ = W`
    have hmem : v₀ ^ n ∈ ρ.ker := by
      rw [MonoidHom.mem_ker, map_pow, hv₀pow]
    rw [hker, Subgroup.mem_subgroupOf] at hmem
    simpa using hmem
  · -- every `v` is `v₀ ^ m` modulo `W`
    intro v hv
    obtain ⟨m, hm⟩ := hv₀gen ⟨v, hv⟩
    refine ⟨m, ?_⟩
    have hmem : (⟨v, hv⟩ : ↥(centD H t)) * (v₀ ^ m)⁻¹ ∈ ρ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hm]
      simp [map_pow]
    rw [hker, Subgroup.mem_subgroupOf] at hmem
    simpa using hmem

end Work.ThmF.ChV12
