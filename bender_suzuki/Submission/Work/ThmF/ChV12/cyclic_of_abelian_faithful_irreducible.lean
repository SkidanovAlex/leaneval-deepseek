/-!
# An abelian irreducible faithful group of linear automorphisms of an `𝔽₂`-space

Let `Q` be a finite nonzero vector space over `𝔽₂ = ZMod 2` and let `T` be a finite
abelian group acting faithfully and irreducibly on `Q` by linear automorphisms
(`ρ : T →* (Q ≃ₗ[𝔽₂] Q)`).  Then `T` is cyclic and `|T|` divides `|Q| - 1`.

The mathematical content is Schur's lemma in the following form.  Let
`A = Algebra.adjoin 𝔽₂ (range ρ)` be the commutative `𝔽₂`-subalgebra of `End Q`
generated by the image of `ρ`.  Since `Q` is irreducible over `T` (equivalently over
`A`), the kernel of every nonzero `a ∈ A` is a `T`-invariant submodule, hence `⊥`;
so `A` is a finite domain, hence a field of order `|Q|`.  The action map
`a ↦ a x₀` (for a fixed `x₀ ≠ 0`) is a bijection `A ≃ Q`, so `|A| = |Q|`, and every
element of `T` is a unit of the field `A`.  Thus `T` embeds into `Aˣ`, a finite
subgroup of the multiplicative group of a field, which is cyclic of order `|Q| - 1`.
-/

theorem cyclic_of_abelian_faithful_irreducible
    {Q : Type} [AddCommGroup Q] [Module (ZMod 2) Q] [Fintype Q] [Nontrivial Q]
    {T : Type} [Group T] [Finite T]
    (hTcomm : ∀ a b : T, a * b = b * a)
    (ρ : T →* (Q ≃ₗ[ZMod 2] Q)) (hfaith : Function.Injective ρ)
    (hirr : ∀ W : Submodule (ZMod 2) Q, W ≠ ⊥ →
      (∀ t : T, ∀ x ∈ W, ρ t x ∈ W) → W = ⊤) :
    IsCyclic T ∧ Nat.card T ∣ Nat.card Q - 1 := by
  classical
  let E := Module.End (ZMod 2) Q
  let S : Set E := Set.range (fun t : T => (ρ t : Q →ₗ[ZMod 2] Q))
  let A : Subalgebra (ZMod 2) E := Algebra.adjoin (ZMod 2) S
  haveI : Finite E := Finite.of_injective (fun f : E => (f : Q → Q)) DFunLike.coe_injective
  haveI : Fintype E := Fintype.ofFinite E
  haveI : Fintype A := inferInstance
  -- the generators `ρ t` commute pairwise, so `A` is commutative
  have hScomm : S.Pairwise Commute := by
    rintro x ⟨t, rfl⟩ y ⟨s, rfl⟩ _
    rw [Commute, SemiconjBy]
    ext q
    rw [Module.End.mul_apply, Module.End.mul_apply]
    change (ρ t : Q ≃ₗ[ZMod 2] Q) ((ρ s : Q ≃ₗ[ZMod 2] Q) q) = (ρ s) ((ρ t) q)
    rw [← LinearEquiv.mul_apply, ← LinearEquiv.mul_apply, ← map_mul, ← map_mul, hTcomm t s]
  haveI : IsMulCommutative A := Algebra.isMulCommutative_adjoin (ZMod 2) hScomm
  have hAcomm : ∀ a b : A, a * b = b * a := fun a b => isMulCommutative_iff.mp inferInstance a b
  letI : CommRing A := { (inferInstance : Ring A) with mul_comm := hAcomm }
  have hmem : ∀ t : T, (ρ t : Q →ₗ[ZMod 2] Q) ∈ A :=
    fun t => Algebra.subset_adjoin (Set.mem_range_self t)
  let ρA : T →* A :=
    { toFun := fun t => ⟨(ρ t : Q →ₗ[ZMod 2] Q), hmem t⟩
      map_one' := by
        apply Subtype.ext
        show (ρ 1 : Q →ₗ[ZMod 2] Q) = (1 : E)
        rw [map_one]; rfl
      map_mul' := by
        intro t s
        apply Subtype.ext
        show (ρ (t * s) : Q →ₗ[ZMod 2] Q) = (ρ t : Q →ₗ[ZMod 2] Q) * (ρ s : Q →ₗ[ZMod 2] Q)
        rw [map_mul]; rfl }
  -- Schur's lemma: the kernel of a nonzero element of `A` is trivial
  have hker : ∀ a : A, a ≠ 0 → LinearMap.ker (a : Q →ₗ[ZMod 2] Q) = ⊥ := by
    intro a ha
    rcases eq_or_ne (LinearMap.ker (a : Q →ₗ[ZMod 2] Q)) ⊥ with h | h
    · exact h
    · exfalso
      -- the kernel is `T`-invariant, so it is `⊥` or `⊤`; it is not `⊤`
      have hinv : ∀ t : T, ∀ x ∈ LinearMap.ker (a : Q →ₗ[ZMod 2] Q),
          ρ t x ∈ LinearMap.ker (a : Q →ₗ[ZMod 2] Q) := by
        intro t x hx
        rw [LinearMap.mem_ker] at hx ⊢
        have hcoe : (a : E) * (ρA t : E) = (ρA t : E) * (a : E) := by
          simpa only [Subalgebra.coe_mul] using congrArg (fun z : A => (z : E)) (hAcomm a (ρA t))
        calc (a : Q →ₗ[ZMod 2] Q) (ρ t x)
            = ((a : E) * (ρA t : E)) x := by rw [Module.End.mul_apply]; rfl
          _ = ((ρA t : E) * (a : E)) x := by rw [hcoe]
          _ = (ρA t : E) ((a : E) x) := by rw [Module.End.mul_apply]
          _ = (ρA t : E) 0 := by rw [hx]
          _ = 0 := map_zero _
      have htop := hirr _ h hinv
      apply ha
      apply Subtype.ext
      show (a : E) = 0
      apply LinearMap.ext
      intro q
      have hqq : q ∈ LinearMap.ker (a : Q →ₗ[ZMod 2] Q) := by rw [htop]; trivial
      rw [LinearMap.mem_ker] at hqq
      exact hqq
  -- `ρA` is injective
  have hρAinj : Function.Injective ρA := by
    intro t s h
    have h' : ((ρ t : Q ≃ₗ[ZMod 2] Q) : Q →ₗ[ZMod 2] Q) =
        ((ρ s : Q ≃ₗ[ZMod 2] Q) : Q →ₗ[ZMod 2] Q) :=
      congrArg (fun z : A => (z : E)) h
    exact hfaith (LinearEquiv.toLinearMap_injective h')
  -- `A` is nontrivial, a domain, hence a field
  have h10 : (1 : A) ≠ 0 := by
    intro h
    have h' : (1 : E) = 0 := by
      simpa only [Subalgebra.coe_one, Subalgebra.coe_zero] using congrArg (fun z : A => (z : E)) h
    obtain ⟨x, hx⟩ := exists_ne (0 : Q)
    have hx' : x = 0 := by
      have := congrArg (fun f : E => f x) h'
      rw [Module.End.one_apply, LinearMap.zero_apply] at this
      exact this
    exact hx hx'
  haveI : Nontrivial A := ⟨1, 0, h10⟩
  haveI : NoZeroDivisors A := ⟨by
    intro a b hab
    by_cases ha : a = 0
    · exact Or.inl ha
    · right
      have hinj : Function.Injective (a : Q →ₗ[ZMod 2] Q) := by
        rw [← LinearMap.ker_eq_bot]; exact hker a ha
      apply Subtype.ext
      show (b : E) = 0
      apply LinearMap.ext
      intro x
      have h0 : (a : E) ((b : E) x) = 0 := by
        have h1 : ((a * b : A) : E) x = 0 := by
          rw [hab, Subalgebra.coe_zero, LinearMap.zero_apply]
        rwa [Subalgebra.coe_mul, Module.End.mul_apply] at h1
      have h0' : (a : Q →ₗ[ZMod 2] Q) ((b : E) x) = (a : Q →ₗ[ZMod 2] Q) 0 := by
        rw [map_zero]; exact h0
      exact hinj h0'⟩
  haveI : IsDomain A := IsDomain.mk
  haveI : DecidableEq A := Classical.decEq A
  letI : Field A := Fintype.fieldOfDomain A
  have hcyc : IsCyclic T := isCyclic_of_injective_ringHom ρA hρAinj
  -- the orbit map `a ↦ a • x₀` is a bijection `A ≃ Q`, so `|A| = |Q|`
  obtain ⟨x₀, hx₀⟩ := exists_ne (0 : Q)
  let ev : E →ₗ[ZMod 2] Q :=
    { toFun := fun f => f x₀
      map_add' := fun f g => LinearMap.add_apply f g x₀
      map_smul' := fun c f => LinearMap.smul_apply c f x₀ }
  let incl : A →ₗ[ZMod 2] E :=
    { toFun := fun a => (a : E)
      map_add' := fun a b => Subalgebra.coe_add A a b
      map_smul' := fun c a => Subalgebra.coe_smul A c a }
  let W : Submodule (ZMod 2) Q := (ev.comp incl).range
  have hx0W : x₀ ∈ W := by
    refine ⟨1, ?_⟩
    show ((1 : A) : E) x₀ = x₀
    rw [Subalgebra.coe_one, Module.End.one_apply]
  have hWne : W ≠ ⊥ := by
    intro hbot
    have : x₀ ∈ (⊥ : Submodule (ZMod 2) Q) := hbot ▸ hx0W
    rw [Submodule.mem_bot] at this
    exact hx₀ this
  have hWinv : ∀ t : T, ∀ x ∈ W, ρ t x ∈ W := by
    rintro t x ⟨a, ha⟩
    refine ⟨ρA t * a, ?_⟩
    show ((ρA t * a : A) : E) x₀ = ρ t x
    rw [Subalgebra.coe_mul, Module.End.mul_apply]
    have ha' : ((a : A) : E) x₀ = x := ha
    rw [ha']
    rfl
  have hcard : Nat.card A = Nat.card Q := by
    have hinj : Function.Injective (fun a : A => (a : E) x₀) := by
      intro a b hab
      by_contra hne
      have hsub : a - b ≠ 0 := sub_ne_zero.mpr hne
      have hab' : ((a : A) : E) x₀ = ((b : A) : E) x₀ := hab
      have hmem : x₀ ∈ LinearMap.ker ((a - b : A) : Q →ₗ[ZMod 2] Q) := by
        rw [LinearMap.mem_ker]
        have : ((a - b : A) : E) x₀ = (a : E) x₀ - (b : E) x₀ := by
          rw [Subalgebra.coe_sub]; rfl
        rw [this, hab', sub_self]
      rw [hker (a - b) hsub, Submodule.mem_bot] at hmem
      exact hx₀ hmem
    have hsurj : Function.Surjective (fun a : A => (a : E) x₀) := by
      intro y
      have hy : y ∈ W := by rw [hirr W hWne hWinv]; trivial
      obtain ⟨a, ha⟩ := hy
      exact ⟨a, ha⟩
    exact Nat.card_congr (Equiv.ofBijective _ ⟨hinj, hsurj⟩)
  -- every `ρA t` is a nonzero, hence invertible, element of the field `A`
  have hne : ∀ t : T, (ρA t : A) ≠ 0 := by
    intro t ht
    have h' : (ρA t : E) = 0 := by
      simpa only [Subalgebra.coe_zero] using congrArg (fun z : A => (z : E)) ht
    obtain ⟨x, hx⟩ := exists_ne (0 : Q)
    have hx0 : ((ρ t : Q ≃ₗ[ZMod 2] Q) : Q →ₗ[ZMod 2] Q) x = 0 := by
      have := congrArg (fun f : E => f x) h'
      rw [LinearMap.zero_apply] at this
      exact this
    have : x = 0 := (ρ t).injective (by simpa using hx0)
    exact hx this
  let ρU : T →* Aˣ :=
    { toFun := fun t => Units.mk0 (ρA t) (hne t)
      map_one' := by
        apply Units.ext
        show (ρA 1 : A) = 1
        rw [map_one]
      map_mul' := by
        intro t s
        apply Units.ext
        show (ρA (t * s) : A) = (ρA t : A) * (ρA s : A)
        rw [map_mul] }
  have hρUinj : Function.Injective ρU := by
    intro t s h
    have h2 : ((ρU t : Aˣ) : A) = ((ρU s : Aˣ) : A) := congrArg (fun u : Aˣ => (u : A)) h
    have ht : ((ρU t : Aˣ) : A) = ρA t := Units.val_mk0 (hne t)
    have hs : ((ρU s : Aˣ) : A) = ρA s := Units.val_mk0 (hne s)
    rw [ht, hs] at h2
    exact hρAinj h2
  refine ⟨hcyc, ?_⟩
  have h1 : Nat.card T = Nat.card ρU.range :=
    Nat.card_congr (MonoidHom.ofInjective hρUinj).toEquiv
  rw [h1]
  have h2 : Nat.card Aˣ = Nat.card Q - 1 := by rw [Nat.card_units, hcard]
  rw [← h2]
  exact Subgroup.card_subgroup_dvd_card ρU.range

end Work.ThmF.ChV12
