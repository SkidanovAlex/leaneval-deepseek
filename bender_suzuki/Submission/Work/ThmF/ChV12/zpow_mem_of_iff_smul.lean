namespace Work.ThmF.ChV12

/-- If a set `S ⊆ X` is invariant under `σ` acting on `X`, in the strong sense that
`χ ∈ S ↔ σ • χ ∈ S` for every `χ`, then `S` is invariant under every element of the
cyclic subgroup generated by `σ`.

The equivalence `h` yields both directions: `σ` maps `S` into itself, and `σ` maps the
complement of `S` into itself, i.e. `σ • χ ∈ S → χ ∈ S`. Thus the argument runs by
integer induction on the exponent: the successor step pushes `σ` across once (using `h`
forwards), and the predecessor step pulls `σ` back out (using `h` backwards). -/
theorem zpow_mem_of_iff_smul
    {G X : Type*} [Group G] [MulAction G X]
    {S : Set X} {σ : G} (h : ∀ χ, χ ∈ S ↔ σ • χ ∈ S) :
    ∀ g ∈ Subgroup.zpowers σ, ∀ χ, χ ∈ S → g • χ ∈ S := by
  -- Every integer power of `σ` preserves `S`.
  have key : ∀ n : ℤ, ∀ χ, χ ∈ S → σ ^ n • χ ∈ S := by
    intro n
    refine Int.induction_on (motive := fun n => ∀ χ, χ ∈ S → σ ^ n • χ ∈ S) n ?_ ?_ ?_
    · -- `n = 0`
      intro χ hχ
      simpa using hχ
    · -- `n = ↑i ↦ ↑i + 1`
      intro i ih χ hχ
      rw [zpow_add_one, mul_smul]
      exact ih (σ • χ) ((h χ).mp hχ)
    · -- `n = -↑i ↦ -↑i - 1`
      intro i ih χ hχ
      have heq : σ * σ ^ (-(i : ℤ) - 1) = σ ^ (-(i : ℤ)) := by
        rw [← zpow_one_add]; congr 1; ring
      have hmul : σ • (σ ^ (-(i : ℤ) - 1) • χ) ∈ S := by
        rw [← mul_smul, heq]
        exact ih χ hχ
      exact (h (σ ^ (-(i : ℤ) - 1) • χ)).mpr hmul
  intro g hg χ hχ
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
  exact key n χ hχ

end Work.ThmF.ChV12
