/-!
# `Work.ThmF.ChV12.adjoin_sigma_card_and_domain`

Let `Q` be a finite nontrivial `𝔽₂`-vector space and `σ : Q ≃ₗ[𝔽₂] Q` an automorphism whose only
`σ`-invariant subspaces are `⊥` and `⊤`.  Then the `𝔽₂`-subalgebra `A = 𝔽₂[σ] ⊆ End Q` generated
by `σ` is an integral domain, commutative, and `|A| = |Q|`.

Mathematically `A` is the finite field `𝔽₂[x]/(m)` where `m` is the (irreducible) minimal
polynomial of `σ`, acting on `Q`; `Q` is a cyclic `A`-module, so `A ≅ Q`.

The proof here avoids polynomials entirely.  Because `A = 𝔽₂[σ]` is generated by a single element,
- every `a ∈ A` commutes with `σ` (Mathlib's `Algebra.commute_of_mem_adjoin_self`), so the range of
  `a` as an endomorphism is `σ`-invariant;
- a nonzero `a ∈ A` therefore has range `⊤` by `hirr`, and being a surjective endomorphism of the
  finite-dimensional space `Q` it is injective, hence bijective; this gives that `A` has no zero
  divisors;
- the evaluation map `A → Q`, `a ↦ a v` (for `0 ≠ v : Q`) is `𝔽₂`-linear with `σ`-invariant range,
  hence surjective, and injective because a nonzero element is injective; so `A ≃ Q`.
-/

namespace Work.ThmF.ChV12

theorem adjoin_sigma_card_and_domain {Q : Type} [AddCommGroup Q] [Module (ZMod 2) Q]
    [Finite Q] [Nontrivial Q] (σ : Q ≃ₗ[ZMod 2] Q)
    (hirr : ∀ W : Submodule (ZMod 2) Q, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤) :
    let A : Subalgebra (ZMod 2) (Module.End (ZMod 2) Q) :=
      Algebra.adjoin (ZMod 2) ({(σ : Q →ₗ[ZMod 2] Q)} : Set (Module.End (ZMod 2) Q))
    IsDomain A ∧ IsMulCommutative A ∧ Nat.card A = Nat.card Q := by
  classical
  let A : Subalgebra (ZMod 2) (Module.End (ZMod 2) Q) :=
    Algebra.adjoin (ZMod 2) ({(σ : Q →ₗ[ZMod 2] Q)} : Set (Module.End (ZMod 2) Q))
  show IsDomain A ∧ IsMulCommutative A ∧ Nat.card A = Nat.card Q
  let σL : Module.End (ZMod 2) Q := (σ : Q →ₗ[ZMod 2] Q)
  have hmem : σL ∈ A := Algebra.subset_adjoin (Set.mem_singleton σL)
  -- Every element of `A` commutes with `σ`.
  have hcomm : ∀ u : A,
      (u : Module.End (ZMod 2) Q) * σL = σL * (u : Module.End (ZMod 2) Q) := by
    intro u
    exact (Algebra.commute_of_mem_adjoin_self (a := σL) (b := (u : Module.End (ZMod 2) Q))
      u.2).eq.symm
  -- A nonzero element of `A` has full range.
  have hrange : ∀ u : A, u ≠ 0 → LinearMap.range (u : Module.End (ZMod 2) Q) = ⊤ := by
    intro u hu
    refine hirr (LinearMap.range (u : Module.End (ZMod 2) Q)) ?_ ?_
    · intro hbot
      rw [LinearMap.range_eq_bot] at hbot
      exact hu (Subtype.ext hbot)
    · intro x hx
      obtain ⟨y, hy⟩ := LinearMap.mem_range.mp hx
      refine LinearMap.mem_range.mpr ⟨σL y, ?_⟩
      rw [← hy]
      change (u : Module.End (ZMod 2) Q) (σL y) = σL ((u : Module.End (ZMod 2) Q) y)
      rw [← Module.End.mul_apply, ← Module.End.mul_apply, hcomm u]
  -- Hence a nonzero element of `A` is bijective.
  have hbij : ∀ u : A, u ≠ 0 → Function.Bijective (u : Module.End (ZMod 2) Q) := by
    intro u hu
    have htop := hrange u hu
    rw [LinearMap.range_eq_top] at htop
    haveI : FiniteDimensional (ZMod 2) Q := Module.Finite.of_finite
    exact ⟨(LinearMap.injective_iff_surjective (f := (u : Module.End (ZMod 2) Q))).mpr htop,
      htop⟩
  -- `A` is nontrivial.
  haveI hEnd : Nontrivial (Module.End (ZMod 2) Q) := inferInstance
  have hE01 : (0 : Module.End (ZMod 2) Q) ≠ 1 := zero_ne_one
  have hA01 : (0 : A) ≠ 1 := fun h => hE01 (by
    simpa [Subalgebra.coe_zero, Subalgebra.coe_one] using congrArg Subtype.val h)
  haveI hnt : Nontrivial A := Nontrivial.mk ⟨0, 1, hA01⟩
  -- `A` is an integral domain.
  have hdom : IsDomain A := by
    haveI : NoZeroDivisors A :=
      ⟨fun {a b} hab => by
        by_cases ha : a = 0
        · exact Or.inl ha
        · refine Or.inr (Subtype.ext ?_)
          have hinj := (hbij a ha).1
          have habE : (a : Module.End (ZMod 2) Q) * (b : Module.End (ZMod 2) Q) = 0 := by
            have hcoe := congrArg (fun c : A => (c : Module.End (ZMod 2) Q)) hab
            simpa using hcoe
          ext x
          have key : (a : Module.End (ZMod 2) Q) ((b : Module.End (ZMod 2) Q) x)
              = (a : Module.End (ZMod 2) Q) 0 := by
            rw [map_zero, ← Module.End.mul_apply, habE, LinearMap.zero_apply]
          simpa using hinj key⟩
    exact NoZeroDivisors.to_isDomain A
  -- `A` is commutative.
  have hcommA : IsMulCommutative A := inferInstance
  -- `|A| = |Q|`.
  have hcard : Nat.card A = Nat.card Q := by
    obtain ⟨v, hv⟩ := exists_ne (0 : Q)
    let φ : A →ₗ[ZMod 2] Q :=
      { toFun := fun u => (u : Module.End (ZMod 2) Q) v
        map_add' := by intro a b; simp only [Subalgebra.coe_add, LinearMap.add_apply]
        map_smul' := by
          intro c a
          simp only [Subalgebra.coe_smul, LinearMap.smul_apply, RingHom.id_apply] }
    have hφinj : Function.Injective φ := by
      intro a b hab
      have hsub : φ (a - b) = 0 := by rw [map_sub, hab, sub_self]
      have hsubE : ((a - b : A) : Module.End (ZMod 2) Q) v = 0 := by
        simpa [φ] using hsub
      by_contra hne
      have hc : (a - b : A) ≠ 0 := sub_ne_zero.mpr hne
      have hinjab := (hbij (a - b) hc).1
      have : v = 0 := hinjab (by rw [hsubE, map_zero])
      exact hv this
    have hφsurj : Function.Surjective φ := by
      rw [← LinearMap.range_eq_top]
      refine hirr (LinearMap.range φ) ?_ ?_
      · intro hbot
        have hvmem : v ∈ LinearMap.range φ := ⟨1, by simp [φ]⟩
        rw [hbot] at hvmem
        exact hv (by simpa using hvmem)
      · intro x hx
        obtain ⟨a, ha⟩ := LinearMap.mem_range.mp hx
        refine LinearMap.mem_range.mpr ⟨a * ⟨σL, hmem⟩, ?_⟩
        rw [← ha]
        change ((a * ⟨σL, hmem⟩ : A) : Module.End (ZMod 2) Q) v
          = σL ((a : Module.End (ZMod 2) Q) v)
        rw [Subalgebra.coe_mul]
        change ((a : Module.End (ZMod 2) Q) * σL) v = σL ((a : Module.End (ZMod 2) Q) v)
        rw [hcomm a, Module.End.mul_apply]
    exact Nat.card_congr (Equiv.ofBijective φ ⟨hφinj, hφsurj⟩)
  exact ⟨hdom, hcommA, hcard⟩

end Work.ThmF.ChV12
