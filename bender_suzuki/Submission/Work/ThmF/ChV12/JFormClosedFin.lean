/-!
# `JFormClosed` (finite form) from `TransitiveLinearSolvable`

`Work.ThmF.ChV12.JFormClosed` (`Submission/Work/ThmF/ChV12/L5bridge.lean`) is the classical closure
statement behind Peterfalvi II Ch. V §1 Prop. 2: in an odd-order group `D` acting faithfully on an
elementary abelian `2`-group `A`, with `τ` an involutory automorphism of `D` whose *inverted* set
`J = {j ∈ D | τ j τ⁻¹ = j⁻¹}` is a regular (sharply transitive) transversal of `A ∖ {1}`, the set
`J` is closed under multiplication.

This file proves the finite form `JFormClosedFin` from the single input
`Work.ThmF.ChV12.TransitiveLinearSolvable` (whose own reduction is in
`Submission/Work/ThmF/ChV12/transitiveLinearSolvable_of_ppd.lean`).

The trick is that one does **not** need `D = ⟨J⟩`: apply
`Work.ThmF.ChV12.jformOfSolvable_of_generated` to the subgroup `D' := ⟨J⟩` generated by the
inverted set instead of to `D` itself.  For `D'`:

* `D'` has odd order, `τ` normalises `D'` (it permutes `J`), and `D'` acts faithfully on `A`;
* the *regular transversal* property of `J` upgrades to the `∃!`-form needed by
  `jformOfSolvable_of_generated` (a `J`-element mapping `a` to `b` is inverted, hence lies in
  `J ⊆ D'`, and uniqueness holds among the larger group `D ⊇ D'`);
* `D' = ⟨J⟩` is exactly the generation hypothesis `hgen`;
* `D'` is solvable by `TransitiveLinearSolvable`, because `J ⊆ D'` is sharply transitive on
  `A ∖ {1}`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.ThmF.ChV12

open LeanEval.GroupTheory.Defs

/-- `(⊤ : Subgroup ↥H).map H.subtype = H`. -/
private theorem map_subtype_top_eq {G : Type} [Group G] (H : Subgroup G) :
    (⊤ : Subgroup ↥H).map H.subtype = H := by
  ext x; constructor
  · rintro ⟨y, -, rfl⟩; exact y.2
  · intro hx; exact ⟨⟨x, hx⟩, trivial, rfl⟩

/-- **The finite form of `JFormClosed`.**  Same statement as
`Work.ThmF.ChV12.JFormClosed`, with the ambient group assumed finite (which makes the subgroups
finite as well, as `jformOfSolvable_of_generated` requires). -/
def JFormClosedFin : Prop :=
  ∀ (G : Type) [Group G] [Finite G], ∀ (A D : Subgroup G) (τ : G),
    (∀ x ∈ A, x * x = 1) →
    (∀ x ∈ A, ∀ y ∈ A, x * y = y * x) →
    D ≤ Subgroup.normalizer (A : Set G) →
    Odd (Nat.card ↥D) →
    τ * τ = 1 →
    τ ∈ Subgroup.normalizer (D : Set G) →
    (∀ a ∈ A, a ≠ 1 → ∀ b ∈ A, b ≠ 1 →
      ∃! j : G, (j ∈ D ∧ τ * j * τ⁻¹ = j⁻¹) ∧ j * a * j⁻¹ = b) →
    D ⊓ Subgroup.centralizer (A : Set G) = ⊥ →
    ∀ j₁ ∈ D, τ * j₁ * τ⁻¹ = j₁⁻¹ → ∀ j₂ ∈ D, τ * j₂ * τ⁻¹ = j₂⁻¹ →
      τ * (j₁ * j₂) * τ⁻¹ = (j₁ * j₂)⁻¹

/-- **`JFormClosed` (finite form) from `TransitiveLinearSolvable`.** -/
theorem JFormClosedFin_of_transitiveLinearSolvable (h : TransitiveLinearSolvable) :
    JFormClosedFin := by
  intro G _ _ A D τ hA2 hAc hDN hodd hτ2 hτN htrans hfaith
  classical
  -- the set of elements of `D` inverted by `τ`
  let Jg : Set G := {j : G | j ∈ D ∧ τ * j * τ⁻¹ = j⁻¹}
  have hJmem : ∀ j : G, j ∈ Jg ↔ j ∈ D ∧ τ * j * τ⁻¹ = j⁻¹ := fun j => Iff.rfl
  have h1J : (1 : G) ∈ Jg := ⟨D.one_mem, by simp⟩
  have hJinv : ∀ j ∈ Jg, j⁻¹ ∈ Jg := by
    intro j hj
    refine ⟨D.inv_mem hj.1, ?_⟩
    have h' : τ * j⁻¹ * τ⁻¹ = (τ * j * τ⁻¹)⁻¹ := by group
    rw [h', hj.2, inv_inv]
  have hτJ : ∀ j ∈ Jg, τ * j * τ⁻¹ ∈ Jg := by
    intro j hj
    have hD' : τ * j * τ⁻¹ ∈ D := (Subgroup.mem_normalizer_iff.mp hτN j).mp hj.1
    refine ⟨hD', ?_⟩
    rw [show τ * (τ * j * τ⁻¹) * τ⁻¹ = (τ * τ) * j * (τ⁻¹ * τ⁻¹) by group, hτ2, one_mul,
      ← mul_inv_rev, hτ2, inv_one, mul_one]
    rw [hj.2, inv_inv]
  have hτJiff : ∀ x : G, τ * x * τ⁻¹ ∈ Jg ↔ x ∈ Jg := by
    intro x
    constructor
    · intro hx
      have h' := hτJ (τ * x * τ⁻¹) hx
      rw [show τ * (τ * x * τ⁻¹) * τ⁻¹ = (τ * τ) * x * (τ⁻¹ * τ⁻¹) by group, hτ2, one_mul,
        ← mul_inv_rev, hτ2, inv_one, mul_one] at h'
      exact h'
    · intro hx
      exact hτJ x hx
  -- the subgroup `D' = ⟨J⟩`
  set D' : Subgroup G := Subgroup.closure Jg with hD'def
  have hJD' : Jg ⊆ (D' : Set G) := Subgroup.subset_closure
  have hD'D : D' ≤ D := (Subgroup.closure_le D).mpr (fun j hj => hj.1)
  have hD'N : D' ≤ Subgroup.normalizer (A : Set G) := hD'D.trans hDN
  have hodd' : Odd (Nat.card ↥D') :=
    Odd.of_dvd_nat hodd (Subgroup.card_dvd_of_le hD'D)
  have hτN' : τ ∈ Subgroup.normalizer (D' : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    rw [hD'def, MonoidHom.map_closure]
    have hcl : Subgroup.closure ((↑(MulAut.conj τ) : G → G) '' Jg) = Subgroup.closure Jg := by
      refine le_antisymm ?_ ?_
      · exact (Subgroup.closure_le _).mpr (fun x hx => by
          obtain ⟨j, hj, rfl⟩ := hx
          exact Subgroup.subset_closure (by simpa [MulAut.conj_apply] using hτJ j hj))
      · exact (Subgroup.closure_le _).mpr (fun j hj => by
          refine Subgroup.subset_closure ⟨(MulAut.conj τ) j, hτJ j hj, ?_⟩
          show (MulAut.conj τ) ((MulAut.conj τ) j) = j
          rw [MulAut.conj_apply, MulAut.conj_apply]
          rw [show τ * (τ * j * τ⁻¹) * τ⁻¹ = (τ * τ) * j * (τ⁻¹ * τ⁻¹) by group, hτ2, one_mul,
            ← mul_inv_rev, hτ2, inv_one, mul_one])
    exact hcl
  have hfaith' : D' ⊓ Subgroup.centralizer (A : Set G) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hx1 : x ∈ D ⊓ Subgroup.centralizer (A : Set G) :=
      ⟨hD'D (Subgroup.mem_inf.mp hx).1, (Subgroup.mem_inf.mp hx).2⟩
    rw [hfaith] at hx1
    exact hx1
  have htrans' : ∀ a ∈ A, a ≠ 1 → ∀ b ∈ A, b ≠ 1 →
      ∃! j : G, (j ∈ D' ∧ τ * j * τ⁻¹ = j⁻¹) ∧ j * a * j⁻¹ = b := by
    intro a ha ha1 b hb hb1
    obtain ⟨j, hj, huniq⟩ := htrans a ha ha1 b hb hb1
    exact ⟨j, ⟨⟨hJD' hj.1, hj.1.2⟩, hj.2⟩,
      fun y hy => huniq y ⟨⟨hD'D hy.1.1, hy.1.2⟩, hy.2⟩⟩
  have hgen' : Subgroup.closure {y : ↥D' | jConj D' τ hτN' y = y⁻¹} = ⊤ := by
    have hset : {y : ↥D' | jConj D' τ hτN' y = y⁻¹} = D'.subtype ⁻¹' Jg := by
      ext y
      rw [Set.mem_setOf_eq, Set.mem_preimage, hJmem]
      constructor
      · intro hy
        refine ⟨hD'D y.2, ?_⟩
        have := congrArg (fun z : ↥D' => (z : G)) hy
        simpa [jConj_coe] using this
      · rintro ⟨-, hy⟩
        apply Subtype.ext
        simpa [jConj_coe] using hy
    rw [hset]
    have himg : D'.subtype '' (D'.subtype ⁻¹' Jg) = Jg := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        exact ⟨⟨x, hJD' hx⟩, hx, rfl⟩
    have hmaptop : Subgroup.map D'.subtype (⊤ : Subgroup ↥D') = D' := by
      ext x; constructor
      · rintro ⟨y, -, rfl⟩; exact y.2
      · intro hx; exact ⟨⟨x, hx⟩, trivial, rfl⟩
    have h2 : Subgroup.map D'.subtype (Subgroup.closure (D'.subtype ⁻¹' Jg)) =
        Subgroup.map D'.subtype (⊤ : Subgroup ↥D') := by
      have hmap := MonoidHom.map_closure D'.subtype (D'.subtype ⁻¹' Jg)
      rw [himg] at hmap
      rw [hmap, hmaptop]
    exact Subgroup.map_injective D'.subtype_injective h2
  have hDsolv' : Group.IsSolvable ↥D' := by
    have hinj : Function.Injective (jAct A D' hD'N) := by
      rw [← MonoidHom.ker_eq_bot_iff]
      rw [eq_bot_iff]
      intro x hx
      rw [MonoidHom.mem_ker] at hx
      have hcent : ((x : ↥D') : G) ∈ Subgroup.centralizer (A : Set G) := by
        rw [Subgroup.mem_centralizer_iff]
        intro a ha
        have h := congrArg (fun f : MulAut ↥A => ((f ⟨a, ha⟩ : ↥A) : G)) hx
        simp only [MulAut.one_apply, jAct_coe, Subgroup.coe_mk] at h
        calc a * (x : G) = ((x : G) * a * (x : G)⁻¹) * (x : G) := by rw [h]
          _ = (x : G) * a := by group
      have hmem : ((x : ↥D') : G) ∈ D' ⊓ Subgroup.centralizer (A : Set G) :=
        ⟨x.2, hcent⟩
      rw [hfaith', Subgroup.mem_bot] at hmem
      exact Subgroup.mem_bot.mpr (Subtype.ext hmem)
    have htransρ : ∀ a b : ↥A, a ≠ 1 → b ≠ 1 → ∃ d : ↥D', jAct A D' hD'N d a = b := by
      intro a b ha hb
      obtain ⟨j, ⟨⟨hjD', _⟩, hja⟩, _⟩ :=
        htrans' (a : G) a.2 (fun h => ha (Subtype.ext h)) (b : G) b.2 (fun h => hb (Subtype.ext h))
      exact ⟨⟨j, hjD'⟩, by ext; rw [jAct_coe]; exact hja⟩
    exact h (fun x : ↥A => Subtype.ext (by simpa using hA2 (x : G) x.2))
      (fun x y : ↥A => Subtype.ext (by simpa using hAc (x : G) x.2 (y : G) y.2))
      hodd' (jAct A D' hD'N) hinj htransρ
  intro j₁ hj₁ h₁ j₂ hj₂ h₂
  exact jformOfSolvable_of_generated A D' τ hA2 hAc hD'N hodd' hτ2 hτN' htrans' hfaith' hgen'
    hDsolv' j₁ (hJD' ⟨hj₁, h₁⟩) h₁ j₂ (hJD' ⟨hj₂, h₂⟩) h₂

end Work.ThmF.ChV12
