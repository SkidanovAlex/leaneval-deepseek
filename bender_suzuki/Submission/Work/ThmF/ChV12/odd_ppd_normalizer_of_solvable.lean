/-- Conjugates have the same order. -/
theorem orderOf_conj_eq {G : Type*} [Group G] (a x : G) : orderOf (a * x * a⁻¹) = orderOf x := by
  rw [← MulAut.conj_apply a x]
  exact orderOf_injective (MulAut.conj a).toMonoidHom (MulAut.conj a).injective x

/-- **The semilinearity endgame.**

If a faithful action `ρ : D →* MulAut A` on an elementary abelian `2`-group `A` (`x * x = 1`,
`|A| = 2 ^ k`) is *semilinear* — i.e. `D` lies in `ΓL(1, 2 ^ k)`, the conclusion of
`semilinear_of_cyclic_normal_irreducible_mulAut` — and `σ : D` has prime order `q` with
`orderOf (2 : ZMod q) = k`, then the cyclic subgroup generated by `σ` is **normal** in `D`.

Indeed, via `semilinear_hom_of_exists` the action gives a homomorphism
`φ : D →* (𝔽_{2ⁿ} ≃+* 𝔽_{2ⁿ})` together with a scalar cocycle `c`; `φ σ = 1` because
`orderOf (φ σ)` divides `gcd(q, n)` (and `q ∤ n`); the kernel of `φ` embeds through `c` into the
*commutative* group `𝔽_{2ⁿ}ˣ`, hence is commutative; both `σ` and `d σ d⁻¹` lie in it, so they
commute, and `zpowers_eq_of_commute_of_orderOf_prime` finishes. -/
theorem zpowers_normal_of_semilinear {A D : Type} [Group A] [Finite A] [Group D] [Finite D]
    (hA2 : ∀ x : A, x * x = 1) (hAc : ∀ x y : A, x * y = y * x) {k q : ℕ}
    (hk1 : 1 ≤ k) (hk : Nat.card A = 2 ^ k) (hq : Nat.Prime q)
    (hord : orderOf (2 : ZMod q) = k)
    (ρ : D →* MulAut A) (hfaith : Function.Injective ρ)
    (σ : D) (hσ : orderOf σ = q)
    (h : ∃ (n : ℕ) (e : Additive A ≃+ GaloisField 2 n),
      Nat.Coprime q n ∧
      ∀ d : D, ∃ (a : (GaloisField 2 n)ˣ) (σ' : GaloisField 2 n ≃+* GaloisField 2 n),
        ∀ x : A, e (Additive.ofMul (ρ d x)) = (a : GaloisField 2 n) * σ' (e (Additive.ofMul x))) :
    ∀ d : D, ∃ i : ℤ, d * σ * d⁻¹ = σ ^ i := by
  classical
  obtain ⟨n, e, hcop, he⟩ := h
  obtain ⟨φ, c, hP1, hP2, hP3, hP4⟩ := semilinear_hom_of_exists e ρ hfaith he
  haveI : Fact q.Prime := ⟨hq⟩
  -- `n ≠ 0` (else `gcd(q,n) = q = 1`)
  have hn0 : n ≠ 0 := by
    rintro rfl
    have h1 : q = 1 := by simpa [Nat.Coprime, Nat.gcd_zero_right] using hcop
    exact hq.ne_one h1
  -- the automorphism group of `𝔽_{2ⁿ}` has `n` elements
  have haut : Nat.card (GaloisField 2 n ≃+* GaloisField 2 n) = n :=
    natCard_ringEquiv_finiteField n (GaloisField.card 2 n hn0)
  -- `φ σ = 1`
  have hφσ : φ σ = 1 := by
    have h1 : orderOf (φ σ) ∣ orderOf σ := orderOf_map_dvd φ σ
    rw [hσ] at h1
    have h2 : orderOf (φ σ) ∣ n := by
      have h2' : orderOf (φ σ) ∣ Nat.card (GaloisField 2 n ≃+* GaloisField 2 n) :=
        orderOf_dvd_natCard (φ σ)
      rwa [haut] at h2'
    have h3 : orderOf (φ σ) ∣ Nat.gcd q n := Nat.dvd_gcd h1 h2
    rw [hcop.gcd_eq_one] at h3
    exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp h3)
  -- the kernel of `φ` is commutative: it embeds into `𝔽_{2ⁿ}ˣ` through `c`
  have hScomm : ∀ s t : ↥(φ.ker), s * t = t * s := by
    intro s t
    have hmemS : ∀ u : ↥(φ.ker), φ (u : D) = 1 := fun u => MonoidHom.mem_ker.mp u.2
    let ψ : ↥(φ.ker) →* (GaloisField 2 n)ˣ :=
      { toFun := fun u => c (u : D)
        map_one' := by
          apply Units.ext
          show (c ((1 : ↥(φ.ker)) : D) : GaloisField 2 n) = 1
          rw [Subgroup.coe_one]
          exact hP3
        map_mul' := by
          intro u v
          have hu : φ (u : D) = 1 := hmemS u
          refine Units.ext ?_
          change (c ((u * v : ↥(φ.ker)) : D) : GaloisField 2 n) = ↑(c (u : D) * c (v : D))
          rw [Subgroup.coe_mul, Units.val_mul, hP2 (u : D) (v : D), hu]
          simp }
    have hψinj : Function.Injective ψ := by
      intro u v huv
      have h1 : ψ (u * v⁻¹) = 1 := by rw [map_mul, map_inv, ← huv, mul_inv_cancel]
      have h2 : c (((u * v⁻¹ : ↥(φ.ker)) : D)) = 1 := h1
      have h3 : φ (((u * v⁻¹ : ↥(φ.ker)) : D)) = 1 := hmemS (u * v⁻¹)
      have h4 : (((u * v⁻¹ : ↥(φ.ker)) : D)) = 1 := hP4 _ h3 h2
      rw [Subgroup.coe_mul, Subgroup.coe_inv] at h4
      exact Subtype.ext (mul_inv_eq_one.mp h4)
    refine hψinj ?_
    rw [map_mul, map_mul, mul_comm]
  intro d
  have hσker : σ ∈ φ.ker := MonoidHom.mem_ker.mpr hφσ
  have hdker : d * σ * d⁻¹ ∈ φ.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_mul, map_inv, hφσ, mul_one, mul_inv_cancel]
  have hcommD : σ * (d * σ * d⁻¹) = (d * σ * d⁻¹) * σ := by
    have h1 := hScomm ⟨σ, hσker⟩ ⟨d * σ * d⁻¹, hdker⟩
    simpa using congrArg (fun x : ↥(φ.ker) => (x : D)) h1
  have hcomm : ρ σ * ρ (d * σ * d⁻¹) = ρ (d * σ * d⁻¹) * ρ σ := by
    rw [← map_mul, ← map_mul, hcommD]
  have hord1 : orderOf (ρ σ) = q := (orderOf_injective ρ hfaith σ).trans hσ
  have hord2 : orderOf (ρ (d * σ * d⁻¹)) = q := by
    rw [map_mul, map_mul, map_inv, orderOf_conj_eq (ρ d) (ρ σ), ← hord1]
  have heq := zpowers_eq_of_commute_of_orderOf_prime hA2 hAc hk hq hord
    (ρ σ) (ρ (d * σ * d⁻¹)) hord1 hord2 hcomm
  have hmem : ρ (d * σ * d⁻¹) ∈ Subgroup.zpowers (ρ σ) := by
    rw [heq]; exact Subgroup.mem_zpowers _
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hmem
  refine ⟨i, ?_⟩
  apply hfaith
  rw [map_zpow]
  exact hi.symm

/-- **Two `q`-elements of the Fitting subgroup commute.**

Let `ρ : D →* MulAut A` be faithful with `A` elementary abelian of order `2 ^ k` and `q` a prime
with `orderOf (2 : ZMod q) = k`.  Then any two elements `x y` of the Fitting subgroup `F(D)` of
order `q` satisfy `ρ x * ρ y = ρ y * ρ x`.

Proof: `F(D)` is nilpotent, so its Sylow `q`-subgroup `P` is normal, and a `q`-element of `F(D)`
must lie in `P` (its image in `F(D)/P` has order dividing both `q` and the `q'`-number
`[F(D) : P]`).  The image of `P` in `MulAut A` is a `q`-subgroup of `GL_k(2)` containing the
irreducible image of `x`, so it is commutative (`isMulCommutative_of_isPGroup_of_irreducible`,
using `q` odd and `k < q`). -/
theorem commute_of_mem_fitting_of_orderOf {A D : Type} [Group A] [Finite A] [Group D] [Finite D]
    (hA2 : ∀ x : A, x * x = 1) (hAc : ∀ x y : A, x * y = y * x) {k q : ℕ}
    (hk1 : 1 ≤ k) (hk : Nat.card A = 2 ^ k) (hq : Nat.Prime q)
    (hord : orderOf (2 : ZMod q) = k)
    (ρ : D →* MulAut A) (hfaith : Function.Injective ρ)
    {x y : D} (hx : x ∈ Work.Fitting.fitting D) (hy : y ∈ Work.Fitting.fitting D)
    (hxo : orderOf x = q) (hyo : orderOf y = q) :
    ρ x * ρ y = ρ y * ρ x := by
  classical
  haveI : Fact q.Prime := ⟨hq⟩
  have hqodd : q ≠ 2 := by
    rintro rfl
    have hz : (2 : ZMod 2) = 0 := (CharP.cast_eq_zero_iff (ZMod 2) 2 2).mpr (dvd_refl 2)
    rw [hz, orderOf_zero (ZMod 2)] at hord
    omega
  have hkq : k < q := lt_prime_of_orderOf_two hq hord
  let F : Subgroup D := Work.Fitting.fitting D
  have hxF : (⟨x, hx⟩ : ↥F) ∈ (⊤ : Subgroup ↥F) := Subgroup.mem_top _
  have hyF : (⟨y, hy⟩ : ↥F) ∈ (⊤ : Subgroup ↥F) := Subgroup.mem_top _
  --- the Fitting subgroup is nilpotent, so has a normal Sylow `q`-subgroup
  haveI : Group.IsNilpotent ↥F := Work.Fitting.fitting_isNilpotent D
  obtain ⟨P⟩ := Sylow.nonempty (p := q) (G := ↥F)
  haveI hPn : (P : Subgroup ↥F).Normal := inferInstance
  haveI : (P : Subgroup ↥F).FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  --- any `q`-element of `F` lies in `P`
  have hmemP : ∀ z : ↥F, orderOf z = q → z ∈ (P : Subgroup ↥F) := by
    intro z hz
    rw [← QuotientGroup.eq_one_iff z]
    have h1 : orderOf (QuotientGroup.mk' (P : Subgroup ↥F) z) ∣ q := by
      have := orderOf_map_dvd (QuotientGroup.mk' (P : Subgroup ↥F)) z
      rwa [hz] at this
    have h2 : orderOf (QuotientGroup.mk' (P : Subgroup ↥F) z) ∣ (P : Subgroup ↥F).index := by
      rw [Subgroup.index_eq_card]
      exact orderOf_dvd_natCard _
    have h3 : ¬ q ∣ (P : Subgroup ↥F).index := P.not_dvd_index
    have h4 : Nat.Coprime q ((P : Subgroup ↥F).index) :=
      (Nat.Prime.coprime_iff_not_dvd hq).mpr h3
    have h5 : orderOf (QuotientGroup.mk' (P : Subgroup ↥F) z) ∣ 1 := by
      rw [← h4.gcd_eq_one]
      exact Nat.dvd_gcd h1 h2
    exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp h5)
  have hxoF : orderOf (⟨x, hx⟩ : ↥F) = q := by
    have := orderOf_injective F.subtype F.subtype_injective (⟨x, hx⟩ : ↥F)
    rw [show F.subtype (⟨x, hx⟩ : ↥F) = x from rfl, hxo] at this
    exact this.symm
  have hyoF : orderOf (⟨y, hy⟩ : ↥F) = q := by
    have := orderOf_injective F.subtype F.subtype_injective (⟨y, hy⟩ : ↥F)
    rw [show F.subtype (⟨y, hy⟩ : ↥F) = y from rfl, hyo] at this
    exact this.symm
  --- the image `Q` of `P` in `MulAut A` is a commutative `q`-group
  let Q : Subgroup (MulAut A) := Subgroup.map (ρ.comp F.subtype) (P : Subgroup ↥F)
  haveI hQp : IsPGroup q ↥Q := P.isPGroup'.map (ρ.comp F.subtype)
  have hxQ : ρ x ∈ Q := ⟨⟨x, hx⟩, hmemP _ hxoF, rfl⟩
  have hyQ : ρ y ∈ Q := ⟨⟨y, hy⟩, hmemP _ hyoF, rfl⟩
  have hxirr : ∀ W : Subgroup A, W ≠ ⊥ → (∀ a ∈ W, ρ x a ∈ W) → W = ⊤ :=
    irreducible_of_orderOf_prime hA2 hAc hk hq hord (ρ x)
      ((orderOf_injective ρ hfaith x).trans hxo)
  have hQcomm : IsMulCommutative ↥Q :=
    isMulCommutative_of_isPGroup_of_irreducible hA2 hAc hk hq hqodd hkq Q hQp
      ⟨ρ x, hxQ, hxirr⟩
  rw [isMulCommutative_iff] at hQcomm
  exact congrArg Subtype.val (hQcomm ⟨ρ x, hxQ⟩ ⟨ρ y, hyQ⟩)

theorem odd_ppd_normalizer_of_solvable {A : Type} [Group A] [Finite A]
    (hA2 : ∀ x : A, x * x = 1) (hAc : ∀ x y : A, x * y = y * x) {k q : ℕ}
    (hk1 : 1 ≤ k) (hk : Nat.card A = 2 ^ k) (hq : Nat.Prime q)
    (hord : orderOf (2 : ZMod q) = k)
    (G : Subgroup (MulAut A)) (hodd : Odd (Nat.card G)) (hsol : Group.IsSolvable G)
    (σ : MulAut A) (hσG : σ ∈ G) (hσ : orderOf σ = q) :
    ∀ g ∈ G, ∃ i : ℤ, g * σ * g⁻¹ = σ ^ i := by
  classical
  intro g hg
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : Group.IsSolvable ↥G := hsol
  -- ## Step 1: every `q`-element of `↥G` lies in the Fitting subgroup of `↥G`.
  have key : ∀ y : ↥G, orderOf y = q → y ∈ Work.Fitting.fitting ↥G := by
    intro y hy
    rw [Work.Fitting.fitting_eq_sInf_chiefFactor_centralizer ↥G]
    refine Subgroup.mem_sInf.mpr ?_
    rintro C ⟨H, K, hHn, hcf, rfl⟩
    haveI : H.Normal := hHn
    rw [Work.Fitting.mem_sectionCentralizer_iff_commutator]
    intro k hkK
    -- the abelian-normal-section lemma applied to the chief factor `K/H`
    have hsec := ppd_trivial_on_abelian_normal_section hA2 hAc hk1 hk hq hord
      G.subtype G.subtype_injective y hy (K : Subgroup ↥G) hcf.2.1 (H : Subgroup ↥G) hHn
      (le_of_lt hcf.2.2.1) (chiefFactor_commutator_le_of_solvable hcf)
    have hmem := hsec k hkK
    have hmem' : G.subtype (y * k * y⁻¹ * k⁻¹)
        ∈ Subgroup.map G.subtype (H : Subgroup ↥G) := by
      rw [map_mul, map_mul, map_inv, map_inv]; exact hmem
    obtain ⟨u, huH, hu⟩ := Subgroup.mem_map.mp hmem'
    have hthis : u = y * k * y⁻¹ * k⁻¹ := G.subtype_injective hu
    rw [← hthis]; exact huH
  -- ## Step 2: `σ` and its conjugate `g σ g⁻¹` both lie in `F(↥G)`.
  have hσord : orderOf (⟨σ, hσG⟩ : ↥G) = q := by
    have h := orderOf_injective G.subtype G.subtype_injective (⟨σ, hσG⟩ : ↥G)
    rw [show G.subtype (⟨σ, hσG⟩ : ↥G) = σ from rfl, hσ] at h
    exact h.symm
  have hσF : (⟨σ, hσG⟩ : ↥G) ∈ Work.Fitting.fitting ↥G := key _ hσord
  have hcjord : orderOf (⟨g, hg⟩ * ⟨σ, hσG⟩ * (⟨g, hg⟩ : ↥G)⁻¹) = q := by
    rw [orderOf_conj_eq]; exact hσord
  have hcjF : (⟨g, hg⟩ * ⟨σ, hσG⟩ * (⟨g, hg⟩ : ↥G)⁻¹) ∈ Work.Fitting.fitting ↥G :=
    key _ hcjord
  -- ## Step 3: they commute (two `q`-elements of the Fitting subgroup).
  have hcomm' := commute_of_mem_fitting_of_orderOf hA2 hAc hk1 hk hq hord
    G.subtype G.subtype_injective hσF hcjF hσord hcjord
  have hcomm : σ * (g * σ * g⁻¹) = (g * σ * g⁻¹) * σ := by
    have := hcomm'
    simpa only [map_mul, map_inv, Subgroup.coe_subtype] using this
  -- ## Step 4: hence `g σ g⁻¹ ∈ ⟨σ⟩`.
  have hcjord' : orderOf (g * σ * g⁻¹) = q := by
    rw [orderOf_conj_eq g σ, hσ]
  have heq := zpowers_eq_of_commute_of_orderOf_prime hA2 hAc hk hq hord σ (g * σ * g⁻¹)
    hσ hcjord' hcomm
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp
    (show g * σ * g⁻¹ ∈ Subgroup.zpowers σ by rw [heq]; exact Subgroup.mem_zpowers _)
  exact ⟨i, hi.symm⟩

