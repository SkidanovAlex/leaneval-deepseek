/-!
# The centralizer of an irreducible automorphism is commutative

Let `A` be a commutative group and `σ : MulAut A` an automorphism whose only `σ`-invariant
subgroups are `⊥` and `⊤`.  Then the centralizer of `σ` in `MulAut A` is commutative
(`mulAut_mul_comm_of_commute_of_irreducible`).

The proof is the "simple module is cyclic" argument, carried out with the polynomial action
`polyEnd σ : ℤ[X] →+* End M` of `PolyEndDefs.lean` on the additive group `M = Additive A`
(`X` acts as `σ`).  A `σ`-invariant additive subgroup of `M` is precisely a `ℤ[X]`-submodule, so
the hypothesis says that `M` is a simple `ℤ[X]`-module.

* `exists_polyEnd_eq`: a simple module is cyclic — for `a ≠ 0` every element of `M` is `p(σ) a`.
* `eq_polyEnd_of_commutes`: an additive endomorphism `u` commuting with `σ` and with
  `u a = q(σ) a` for some nonzero `a` agrees with `q(σ)` everywhere (the kernel of
  `u - q(σ)` is `σ`-invariant and nonzero, hence everything).
* `addEquiv_comm_of_irreducible`: consequently `u v = v u` for all `u, v` commuting with `σ`,
  since both are polynomials in `σ`, and polynomials in `σ` commute pairwise.
* `hirr_additive` and finally the target theorem transport this from `M = Additive A` back to `A`.
-/

namespace Work.ThmF.ChV12

/-- If the only `σ`-invariant additive subgroups of `M` are `⊥` and `⊤`, then for any nonzero
`a` every element of `M` is `p(σ) a` for some polynomial `p : ℤ[X]`; i.e. `M` is a cyclic
`ℤ[σ]`-module generated by `a`. -/
theorem exists_polyEnd_eq {M : Type*} [AddCommGroup M] (σ : M ≃+ M)
    (hirr : ∀ W : AddSubgroup M, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤)
    (a : M) (ha : a ≠ 0) (y : M) :
    ∃ p : Polynomial ℤ, polyEnd σ p a = y := by
  -- the additive hom `p ↦ p(σ) a`, whose range is the `ℤ[σ]`-submodule generated by `a`
  let g : Polynomial ℤ →+ M := AddMonoidHom.mk' (fun p => polyEnd σ p a)
    (fun p q => by rw [map_add]; rfl)
  have hg : ∀ p : Polynomial ℤ, g p = polyEnd σ p a := fun p => rfl
  have htop : g.range = ⊤ := by
    refine hirr _ ?_ ?_
    · -- the range is nontrivial, as it contains `a ≠ 0`
      intro hbot
      have ha' : a ∈ (⊥ : AddSubgroup M) := by
        rw [← hbot, AddMonoidHom.mem_range]
        exact ⟨1, by rw [hg]; simp⟩
      exact ha (by simpa [AddSubgroup.mem_bot] using ha')
    · -- and it is `σ`-invariant, since `σ (p(σ) a) = (X * p)(σ) a`
      intro x hx
      rw [AddMonoidHom.mem_range] at hx ⊢
      obtain ⟨p, hp⟩ := hx
      refine ⟨Polynomial.X * p, ?_⟩
      rw [hg, ← hp, hg]
      exact (polyEnd_X_mul_apply σ p a).symm
  have hy : y ∈ g.range := by rw [htop]; exact AddSubgroup.mem_top y
  obtain ⟨p, hp⟩ := AddMonoidHom.mem_range.mp hy
  exact ⟨p, by rw [← hg p]; exact hp⟩

/-- If `u` commutes with `σ` and `u a = q(σ) a` for a nonzero element `a` of a `σ`-irreducible
additive group `M`, then `u` agrees with `q(σ)` on all of `M`. -/
theorem eq_polyEnd_of_commutes {M : Type*} [AddCommGroup M] (σ : M ≃+ M)
    (hirr : ∀ W : AddSubgroup M, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤)
    (u : M ≃+ M) (hu : ∀ x, u (σ x) = σ (u x)) (a : M) (ha : a ≠ 0) (q : Polynomial ℤ)
    (h : u a = polyEnd σ q a) :
    ∀ x, u x = polyEnd σ q x := by
  let w : M →+ M := polyEnd σ q
  have hw : ∀ x : M, w x = polyEnd σ q x := fun x => rfl
  -- `ker (u - q(σ))` is the equalizer of `u` and `q(σ)`
  have hmem : ∀ x : M, x ∈ (u.toAddMonoidHom - w).ker ↔ u x = w x := by
    intro x
    rw [AddMonoidHom.mem_ker, AddMonoidHom.sub_apply, sub_eq_zero]
    simp only [AddEquiv.coe_toAddMonoidHom]
  have htop : (u.toAddMonoidHom - w).ker = ⊤ := by
    refine hirr _ ?_ ?_
    · -- the kernel contains `a ≠ 0`
      intro hbot
      have ha' : a ∈ (⊥ : AddSubgroup M) := by
        rw [← hbot, hmem, hw]
        exact h
      exact ha (by simpa [AddSubgroup.mem_bot] using ha')
    · -- the kernel is `σ`-invariant: both `u` and `q(σ)` commute with `σ`
      intro x hx
      rw [hmem] at hx ⊢
      calc u (σ x) = σ (u x) := hu x
        _ = σ (w x) := by rw [hx]
        _ = σ (polyEnd σ q x) := by rw [hw]
        _ = polyEnd σ (Polynomial.X * q) x := polyEnd_X_mul_apply σ q x
        _ = polyEnd σ (q * Polynomial.X) x := by rw [mul_comm]
        _ = polyEnd σ q (polyEnd σ Polynomial.X x) := polyEnd_mul_apply σ q Polynomial.X x
        _ = polyEnd σ q (σ x) := by rw [polyEnd_X_apply]
        _ = w (σ x) := (hw (σ x)).symm
  have hall : ∀ x, u x = w x := by
    intro x
    rw [← hmem, htop]
    exact AddSubgroup.mem_top x
  intro x
  rw [hall x, hw x]

/-- Transport of the irreducibility hypothesis along the equivalence `A ≃ Additive A`: if the only
`σ`-invariant subgroups of the commutative group `A` are `⊥` and `⊤`, then the same holds for the
`σ`-invariant additive subgroups of `Additive A`. -/
theorem hirr_additive {A : Type*} [CommGroup A] (σ : MulAut A)
    (hirr : ∀ W : Subgroup A, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤) :
    ∀ W : AddSubgroup (Additive A), W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤ := by
  intro W hWne hWinv
  have htop : AddSubgroup.toSubgroup' W = ⊤ := by
    refine hirr _ ?_ ?_
    · rintro hbot
      exact hWne (AddSubgroup.toSubgroup'.injective
        (by rw [hbot, OrderIso.map_bot] : AddSubgroup.toSubgroup' W
          = AddSubgroup.toSubgroup' (⊥ : AddSubgroup (Additive A))))
    · intro x hx
      rw [AddSubgroup.mem_toSubgroup'] at hx ⊢
      exact hWinv _ hx
  exact AddSubgroup.toSubgroup'.injective
    (by rw [htop, OrderIso.map_top] : AddSubgroup.toSubgroup' W
      = AddSubgroup.toSubgroup' (⊤ : AddSubgroup (Additive A)))

/-- Additive form: if the only `σ`-invariant additive subgroups of `M` are `⊥` and `⊤`, then any
two additive automorphisms of `M` commuting with `σ` commute with each other. -/
theorem addEquiv_comm_of_irreducible {M : Type*} [AddCommGroup M] (σ : M ≃+ M)
    (hirr : ∀ W : AddSubgroup M, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤)
    (u v : M ≃+ M) (hu : ∀ x, u (σ x) = σ (u x)) (hv : ∀ x, v (σ x) = σ (v x)) :
    ∀ x, u (v x) = v (u x) := by
  by_cases htriv : ∀ x : M, x = 0
  · -- a one-element group: everything commutes
    intro x
    rw [htriv (u (v x)), htriv (v (u x))]
  · simp only [not_forall] at htriv
    obtain ⟨a, ha⟩ := htriv
    -- `M = ℤ[σ] · a`, so `u` and `v` are both polynomials in `σ`
    obtain ⟨q, hq⟩ := exists_polyEnd_eq σ hirr a ha (u a)
    obtain ⟨r, hr⟩ := exists_polyEnd_eq σ hirr a ha (v a)
    have hqu : ∀ x, u x = polyEnd σ q x := eq_polyEnd_of_commutes σ hirr u hu a ha q hq.symm
    have hrv : ∀ x, v x = polyEnd σ r x := eq_polyEnd_of_commutes σ hirr v hv a ha r hr.symm
    intro x
    -- and polynomials in `σ` commute, `ℤ[X]` being commutative
    have key : polyEnd σ q (polyEnd σ r x) = polyEnd σ r (polyEnd σ q x) := by
      rw [← polyEnd_mul_apply σ q r x, ← polyEnd_mul_apply σ r q x, mul_comm]
    calc u (v x) = polyEnd σ q (v x) := hqu (v x)
      _ = polyEnd σ q (polyEnd σ r x) := by rw [hrv x]
      _ = polyEnd σ r (polyEnd σ q x) := key
      _ = polyEnd σ r (u x) := by rw [← hqu x]
      _ = v (u x) := (hrv (u x)).symm

/-- If `σ ∈ MulAut A` makes the commutative group `A` irreducible (its only `σ`-invariant
subgroups are `⊥` and `⊤`), then the centralizer of `σ` in `MulAut A` is commutative.

Proof route (the equalizer argument alone is NOT enough: the equalizer of `u v` and `v u` is a
`σ`-invariant subgroup containing `1`, but that only gives it `= ⊥` or `= ⊤`, and `1 ∈ E` does
not rule out `E = ⊥`).  The real argument uses cyclicity: for `a ≠ 1`, the subgroup generated by
`{σ^k a : k : ℤ}` is `σ`-invariant and nontrivial, hence `= ⊤`; so `A` is a cyclic module over the
commutative ring `R = ℤ[σ]`.  Then every `σ`-commuting endomorphism is `R`-linear, hence equals a
`ℤ`-linear combination `∑ n_i • σ^{k_i}` of powers of `σ` (it is determined by its value at a
generator `a`, since `A = R·a`), and such combinations commute. -/
theorem mulAut_mul_comm_of_commute_of_irreducible {A : Type} [CommGroup A]
    (σ : MulAut A)
    (hirr : ∀ W : Subgroup A, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤)
    (u v : MulAut A)
    (hu : ∀ x : A, u (σ x) = σ (u x))
    (hv : ∀ x : A, v (σ x) = σ (v x)) :
    u * v = v * u := by
  have h := addEquiv_comm_of_irreducible (M := Additive A) σ.toAdditive (hirr_additive σ hirr)
      u.toAdditive v.toAdditive (fun x => hu x) (fun x => hv x)
  refine MulEquiv.ext (fun x => ?_)
  have hx := h (Additive.ofMul x)
  simp only [MulEquiv.toAdditive_apply_apply, toMul_ofMul] at hx
  simpa using hx

end Work.ThmF.ChV12
