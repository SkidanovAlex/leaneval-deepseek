/-!
# `Work.ThmF.ChV12.prop3_frobenius_power`

Peterfalvi II Ch. V §3: if the action of `V = C_D(t)` on `K = J(D,t)` is realised (through an
isomorphism `κ : K ≃* Fˣ`) as the Galois action `ρ v ∈ Aut(F)` on a finite field `F` of
characteristic `2`, then the conjugation action of each `v ∈ V` on `K` is a power of the
Frobenius, i.e. `k ↦ k ^ (2 ^ i)` for some `i : ℕ`.

Two independent ingredients:

* `ringAut_charTwo_eq_frobenius_pow` — every ring automorphism of a finite field of
  characteristic `2` is an iterate of the Frobenius `x ↦ x ^ (2 ^ i)`;
* `conj_mem_Ksub` — conjugation by `v ∈ V = C_D(t)` preserves `K = ⟨J(D,t)⟩`, so the structural
  hypothesis applies to *every* `k ∈ K` (not only to those whose conjugate happens to lie in `K`).
-/

namespace Work.ThmF.ChV12

open Classical Submission.Blueprint

/-- Every ring automorphism of a finite field of characteristic `2` is a power of the Frobenius:
`σ = (· ^ (2 ^ i))`. -/
theorem ringAut_charTwo_eq_frobenius_pow {F : Type} [Field F] [Fintype F] [CharP F 2]
    (σ : F ≃+* F) : ∃ i : ℕ, ∀ x : F, σ x = x ^ (2 ^ i) := by
  letI : Algebra (ZMod 2) F := ZMod.algebra F 2
  haveI : Finite F := Finite.of_fintype F
  -- every ring automorphism of `F` fixes the prime field `𝔽₂`, hence is an `𝔽₂`-algebra automorphism
  let σ' : F ≃ₐ[ZMod 2] F :=
    { toRingEquiv := σ
      commutes' := by
        intro a
        obtain ⟨k, rfl⟩ := ZMod.natCast_zmod_surjective a
        simp }
  -- `Gal(F/𝔽₂)` is cyclic, generated by the Frobenius
  obtain ⟨n, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) F).2 σ'
  refine ⟨n.1, fun x => ?_⟩
  have hx : σ x = σ' x := rfl
  rw [hx, ← hn]
  simp only [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
  simp [ZMod.card]

/-- Conjugation by an element `v` of `centD H t = C_D(t)` maps `Ksub H t` into itself.

On a generator `k ∈ Kset H t = J(D,t)` this is the computation
`t (v k v⁻¹) t⁻¹ = (t v t⁻¹)(t k t⁻¹)(t v⁻¹ t⁻¹) = v k⁻¹ v⁻¹ = (v k v⁻¹)⁻¹`
(using `t v t⁻¹ = v`), and the property is preserved by group operations. -/
theorem conj_mem_Ksub {G : Type} [Group G] (H : Subgroup G) (t : G) {v : G}
    (hv : v ∈ centD H t) : ∀ k ∈ Ksub H t, v * k * v⁻¹ ∈ Ksub H t := by
  have hKset : ∀ k ∈ Kset H t, v * k * v⁻¹ ∈ Ksub H t := by
    intro k hk
    obtain ⟨hkD, hkinv⟩ := hk
    have hvD : v ∈ twoPoint H t := (Subgroup.mem_inf.mp hv).1
    have hvC : v ∈ Subgroup.centralizer ({t} : Set G) := (Subgroup.mem_inf.mp hv).2
    have hvt : t * v = v * t := (Subgroup.mem_centralizer_iff.mp hvC) t (by simp)
    have hmod : t * (v * k * v⁻¹) * t⁻¹ = (v * k * v⁻¹)⁻¹ := by
      have h1 : t * v * t⁻¹ = v := by rw [hvt]; group
      have h2 : t * v⁻¹ * t⁻¹ = v⁻¹ := by
        simpa only [mul_inv_rev, inv_inv, mul_assoc] using congrArg (fun z => z⁻¹) h1
      calc t * (v * k * v⁻¹) * t⁻¹
          = (t * v * t⁻¹) * (t * k * t⁻¹) * (t * v⁻¹ * t⁻¹) := by group
        _ = v * k⁻¹ * v⁻¹ := by rw [h1, h2, hkinv]
        _ = (v * k * v⁻¹)⁻¹ := by group
    exact Kset_le_Ksub H t
      ⟨(twoPoint H t).mul_mem ((twoPoint H t).mul_mem hvD hkD) ((twoPoint H t).inv_mem hvD),
        hmod⟩
  intro k hk
  refine Subgroup.closure_induction (p := fun x _ => v * x * v⁻¹ ∈ Ksub H t)
    (fun x hx => hKset x hx) ?_ ?_ ?_ hk
  · simpa using (Ksub H t).one_mem
  · intro x y hx hy hpx hpy
    have : v * (x * y) * v⁻¹ = (v * x * v⁻¹) * (v * y * v⁻¹) := by group
    rw [this]; exact (Ksub H t).mul_mem hpx hpy
  · intro x hx hpx
    have : v * x⁻¹ * v⁻¹ = (v * x * v⁻¹)⁻¹ := by group
    rw [this]; exact (Ksub H t).inv_mem hpx

open Classical Submission.Blueprint in theorem prop3_frobenius_power {G : Type} [Group G] [Finite G] (H Q : Subgroup G) (t : G) (hstr : ∃ (F : Type) (_ : Field F) (_ : Fintype F) (_ : CharP F 2) (κ : ↥(Work.ThmF.Ksub H t) ≃* Fˣ) (ρ : ↥(centD H t) →* (F ≃+* F)), ∀ (v : ↥(centD H t)) (k : ↥(Work.ThmF.Ksub H t)) (hk : (v : G) * k * (v : G)⁻¹ ∈ Work.ThmF.Ksub H t), (κ ⟨(v : G) * k * (v : G)⁻¹, hk⟩ : F) = ρ v (κ k)) : ∀ v ∈ centD H t, ∃ i : ℕ, ∀ k ∈ Work.ThmF.Ksub H t, v * k * v⁻¹ = k ^ (2 ^ i) := by
  obtain ⟨F, hF, hFintype, hCharP, κ, ρ, hκ⟩ := hstr
  letI := hF; letI := hFintype; letI := hCharP
  intro v hv
  obtain ⟨i, hi⟩ := ringAut_charTwo_eq_frobenius_pow (F := F) (ρ ⟨v, hv⟩)
  refine ⟨i, fun k hk => ?_⟩
  -- conjugation by `v` preserves `K`, so the structural relation applies to every `k ∈ K`
  have hconj : v * k * v⁻¹ ∈ Ksub H t := conj_mem_Ksub H t hv k hk
  have h1 : (κ ⟨v * k * v⁻¹, hconj⟩ : F) = ρ ⟨v, hv⟩ ((κ ⟨k, hk⟩ : Fˣ) : F) :=
    hκ ⟨v, hv⟩ ⟨k, hk⟩ hconj
  have h2 : ρ ⟨v, hv⟩ ((κ ⟨k, hk⟩ : Fˣ) : F) = ((κ ⟨k, hk⟩ : Fˣ) : F) ^ (2 ^ i) := hi _
  have hkey : κ ⟨v * k * v⁻¹, hconj⟩ = κ (⟨k, hk⟩ ^ (2 ^ i)) := by
    rw [map_pow]
    apply Units.ext
    rw [Units.val_pow_eq_pow_val]
    rw [h1, h2]
  have h3 := congrArg Subtype.val (κ.injective hkey)
  simpa using h3

end Work.ThmF.ChV12
