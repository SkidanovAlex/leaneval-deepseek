open Polynomial

variable {F V : Type*} [Field F] [Finite F] [AddCommGroup V] [Module F V] [FiniteDimensional F V]

/-- The monoid homomorphism `↥A →* End_F(V)`, sending a linear equivalence to its underlying
linear map.  Multiplication in `End_F(V)` is composition. -/
private noncomputable def rho (A : Subgroup (V ≃ₗ[F] V)) : ↥A →* Module.End F V where
  toFun a := (a : V →ₗ[F] V)
  map_one' := rfl
  map_mul' := fun _ _ => rfl

private theorem rho_injective (A : Subgroup (V ≃ₗ[F] V)) : Function.Injective (rho A) := by
  intro a b h
  apply Subtype.ext
  apply LinearEquiv.ext
  intro v
  exact DFunLike.congr_fun h v

/-- The "member" attached to a non-identity `x`: the centraliser `C_A(x)`. -/
private def Msub (A : Subgroup (V ≃ₗ[F] V)) (x : ↥A) : Subgroup ↥A :=
  Subgroup.centralizer ({x} : Set ↥A)

private theorem mem_Msub (A : Subgroup (V ≃ₗ[F] V)) (x w : ↥A) :
    w ∈ Msub A x ↔ (rho A w) * (rho A x) = (rho A x) * (rho A w) := by
  rw [Msub, Subgroup.mem_centralizer_iff]
  constructor
  · intro h
    have h1 : x * w = w * x := h x (Set.mem_singleton x)
    rw [← map_mul, ← map_mul, h1]
  · intro h
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact rho_injective A (by rw [map_mul, map_mul]; exact h.symm)

private theorem self_mem_Msub (A : Subgroup (V ≃ₗ[F] V)) (x : ↥A) : x ∈ Msub A x := by
  rw [Msub, Subgroup.mem_centralizer_iff]
  intro y hy
  rw [Set.mem_singleton_iff] at hy
  rw [hy]

/-- A non-identity element is not a scalar endomorphism. -/
private theorem hns_of_ne (A : Subgroup (V ≃ₗ[F] V)) (h2 : Module.finrank F V = 2)
    (hno : ∀ a ∈ A, a ≠ 1 → ∀ (c : F) (v : V), v ≠ 0 → (a : V ≃ₗ[F] V) v ≠ c • v)
    (x : ↥A) (hx : x ≠ 1) : ∀ c : F, rho A x ≠ c • (1 : V →ₗ[F] V) := by
  intro c hc
  haveI : Nontrivial V := Module.finrank_pos_iff.mp (by rw [h2]; norm_num)
  obtain ⟨v, hv⟩ := exists_ne (0 : V)
  have ha : (x : V ≃ₗ[F] V) ≠ 1 := fun hh => hx (Subtype.ext hh)
  refine hno (x : V ≃ₗ[F] V) x.2 ha c v hv ?_
  have : (rho A x) v = c • v := by rw [hc]; rfl
  exact this

/-- A non-identity element has no eigenvector. -/
private theorem hreg_of_ne (A : Subgroup (V ≃ₗ[F] V))
    (hno : ∀ a ∈ A, a ≠ 1 → ∀ (c : F) (v : V), v ≠ 0 → (a : V ≃ₗ[F] V) v ≠ c • v)
    (x : ↥A) (hx : x ≠ 1) : ∀ c : F, ∀ v : V, v ≠ 0 → (rho A x) v ≠ c • v :=
  fun c v hv => hno (x : V ≃ₗ[F] V) x.2 (fun hh => hx (Subtype.ext hh)) c v hv

private theorem trace_conj_units (u v r : Module.End F V) (hvu : v * u = 1) :
    LinearMap.trace F V (u * r * v) = LinearMap.trace F V r := by
  rw [mul_assoc, LinearMap.trace_mul_comm, mul_assoc, hvu, mul_one]

private theorem det_conj_units (u v r : Module.End F V) (huv : u * v = 1) :
    LinearMap.det (u * r * v) = LinearMap.det r := by
  rw [mul_assoc, map_mul LinearMap.det, map_mul LinearMap.det]
  have h1 : LinearMap.det u * LinearMap.det v = 1 := by
    rw [← map_mul LinearMap.det, huv, map_one]
  rw [mul_comm (LinearMap.det r) (LinearMap.det v), ← mul_assoc, h1, one_mul]

/-- Membership in `Msub` in terms of the polynomial algebra generated by `rho A x`. -/
private theorem hmemrange (A : Subgroup (V ≃ₗ[F] V)) (h2 : Module.finrank F V = 2)
    (a w : ↥A) (hnsa : ∀ c : F, rho A a ≠ c • (1 : V →ₗ[F] V)) :
    w ∈ Msub A a ↔ rho A w ∈ (aeval (R := F) (rho A a)).range := by
  rw [mem_Msub A]
  constructor
  · intro h
    obtain ⟨p, hp⟩ := Gl2Cyclic.centralizer_eq_polynomials h2 hnsa h
    exact ⟨p, hp⟩
  · rintro ⟨p, hp⟩
    rw [← hp]
    have h1 : aeval (R := F) (rho A a) p * aeval (R := F) (rho A a) (Polynomial.X) =
        aeval (R := F) (rho A a) (Polynomial.X) * aeval (R := F) (rho A a) p := by
      rw [← map_mul, ← map_mul, mul_comm]
    simpa using h1

/-- If `b` centralises `a` (both non-identity) then the members coincide. -/
private theorem Msub_eq_of_mem (A : Subgroup (V ≃ₗ[F] V)) (h2 : Module.finrank F V = 2)
    (a b : ↥A) (hnsa : ∀ c : F, rho A a ≠ c • (1 : V →ₗ[F] V))
    (hnsb : ∀ c : F, rho A b ≠ c • (1 : V →ₗ[F] V)) (hab : b ∈ Msub A a) :
    Msub A a = Msub A b := by
  have hcomm : (rho A b) * (rho A a) = (rho A a) * (rho A b) := (mem_Msub A a b).mp hab
  have hba : rho A b ∈ (aeval (R := F) (rho A a)).range :=
    (hmemrange A h2 a b hnsa).mp hab
  have ha_mem : a ∈ Msub A b := (mem_Msub A b a).mpr hcomm.symm
  have hab' : rho A a ∈ (aeval (R := F) (rho A b)).range :=
    (hmemrange A h2 b a hnsb).mp ha_mem
  have hrange : (aeval (R := F) (rho A a)).range = (aeval (R := F) (rho A b)).range := by
    apply le_antisymm
    · rw [← Algebra.adjoin_singleton_eq_range_aeval F, ← Algebra.adjoin_singleton_eq_range_aeval F]
      apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff]
      rwa [Algebra.adjoin_singleton_eq_range_aeval F]
    · rw [← Algebra.adjoin_singleton_eq_range_aeval F, ← Algebra.adjoin_singleton_eq_range_aeval F]
      apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff]
      rwa [Algebra.adjoin_singleton_eq_range_aeval F]
  ext w
  rw [hmemrange A h2 a w hnsa, hmemrange A h2 b w hnsb, hrange]

/-- The centraliser of `x` is abelian. -/
private theorem hab_of (A : Subgroup (V ≃ₗ[F] V)) (h2 : Module.finrank F V = 2)
    (hno : ∀ a ∈ A, a ≠ 1 → ∀ (c : F) (v : V), v ≠ 0 → (a : V ≃ₗ[F] V) v ≠ c • v)
    (x : ↥A) (hx : x ∉ (⊥ : Subgroup ↥A)) : IsMulCommutative (Msub A x) := by
  rw [isMulCommutative_iff]
  intro y z
  have hxne : x ≠ 1 := by simpa using hx
  have hnsx : ∀ c : F, rho A x ≠ c • (1 : V →ₗ[F] V) := hns_of_ne A h2 hno x hxne
  have hyc : (rho A (y : ↥A)) * (rho A x) = (rho A x) * (rho A (y : ↥A)) :=
    (mem_Msub A x (y : ↥A)).mp y.2
  have hzc : (rho A (z : ↥A)) * (rho A x) = (rho A x) * (rho A (z : ↥A)) :=
    (mem_Msub A x (z : ↥A)).mp z.2
  obtain ⟨p, hp⟩ := Gl2Cyclic.centralizer_eq_polynomials h2 hnsx hyc
  obtain ⟨q, hq⟩ := Gl2Cyclic.centralizer_eq_polynomials h2 hnsx hzc
  apply Subtype.ext
  apply rho_injective A
  simp only [Subgroup.coe_mul, map_mul]
  rw [← hp, ← hq, ← map_mul, ← map_mul, mul_comm]

/-- Two members are equal, or meet in the trivial subgroup. -/
private theorem hint_of (A : Subgroup (V ≃ₗ[F] V)) (h2 : Module.finrank F V = 2)
    (hno : ∀ a ∈ A, a ≠ 1 → ∀ (c : F) (v : V), v ≠ 0 → (a : V ≃ₗ[F] V) v ≠ c • v)
    (x y : ↥A) (hx : x ∉ (⊥ : Subgroup ↥A)) (hy : y ∉ (⊥ : Subgroup ↥A)) :
    Msub A x = Msub A y ∨ Msub A x ⊓ Msub A y = ⊥ := by
  by_cases hbot : Msub A x ⊓ Msub A y = ⊥
  · exact Or.inr hbot
  · left
    obtain ⟨z, hz, hzne⟩ : ∃ z ∈ Msub A x ⊓ Msub A y, z ≠ 1 := by
      by_contra h
      push Not at h
      exact hbot ((Subgroup.eq_bot_iff_forall _).mpr (fun z hz => h z hz))
    have hxne : x ≠ 1 := by simpa using hx
    have hyne : y ≠ 1 := by simpa using hy
    rw [Msub_eq_of_mem A h2 x z (hns_of_ne A h2 hno x hxne) (hns_of_ne A h2 hno z hzne) hz.1,
      Msub_eq_of_mem A h2 y z (hns_of_ne A h2 hno y hyne) (hns_of_ne A h2 hno z hzne) hz.2]

/-- Every member is its own normaliser. -/
private theorem hnorm_of (A : Subgroup (V ≃ₗ[F] V)) (h2 : Module.finrank F V = 2)
    (hodd : Odd (Nat.card ↥A))
    (hno : ∀ a ∈ A, a ≠ 1 → ∀ (c : F) (v : V), v ≠ 0 → (a : V ≃ₗ[F] V) v ≠ c • v)
    (x : ↥A) (hx : x ∉ (⊥ : Subgroup ↥A)) :
    Subgroup.normalizer ((Msub A x : Subgroup ↥A) : Set ↥A) = Msub A x := by
  apply le_antisymm
  · intro n hn
    have hxne : x ≠ 1 := by simpa using hx
    have hnsx : ∀ c : F, rho A x ≠ c • (1 : V →ₗ[F] V) := hns_of_ne A h2 hno x hxne
    have hregx : ∀ c : F, ∀ v : V, v ≠ 0 → (rho A x) v ≠ c • v := hreg_of_ne A hno x hxne
    have hconj_mem : n * x * n⁻¹ ∈ Msub A x :=
      ((Subgroup.mem_normalizer_iff.mp hn) x).mp (self_mem_Msub A x)
    have hcomm : (rho A (n * x * n⁻¹)) * (rho A x) = (rho A x) * (rho A (n * x * n⁻¹)) :=
      (mem_Msub A x (n * x * n⁻¹)).mp hconj_mem
    have hvu : (rho A n⁻¹) * (rho A n) = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
    have huv : (rho A n) * (rho A n⁻¹) = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
    have h1 : rho A (n * x * n⁻¹) = rho A n * rho A x * rho A n⁻¹ := by rw [map_mul, map_mul]
    have htr : LinearMap.trace F V (rho A (n * x * n⁻¹)) = LinearMap.trace F V (rho A x) := by
      rw [h1]; exact trace_conj_units _ _ _ hvu
    have hdet : LinearMap.det (rho A (n * x * n⁻¹)) = LinearMap.det (rho A x) := by
      rw [h1]; exact det_conj_units _ _ _ huv
    rcases Gl2Cyclic.eq_or_eq_trace_smul_sub_of_commute h2 hnsx hregx hcomm htr hdet with
      hcase | hcase
    · have hnx : n * x = x * n := by
        have h1' : n * x * n⁻¹ = x := rho_injective A hcase
        calc n * x = n * x * n⁻¹ * n := by group
          _ = x * n := by rw [h1']
      exact (mem_Msub A x n).mpr (by rw [← map_mul, ← map_mul, hnx])
    · have hn2 : n ^ 2 ∈ Msub A x := by
        have heq : n ^ 2 * x * (n ^ 2)⁻¹ = n * (n * x * n⁻¹) * n⁻¹ := by rw [pow_two]; group
        have hkey : rho A (n ^ 2 * x * (n ^ 2)⁻¹) = rho A x := by
          rw [heq, map_mul, map_mul, hcase]
          rw [mul_sub, sub_mul, Algebra.mul_smul_comm, mul_one, Algebra.smul_mul_assoc, huv]
          rw [← h1, hcase]
          abel
        have hg : n ^ 2 * x = x * n ^ 2 := by
          have h1' : n ^ 2 * x * (n ^ 2)⁻¹ = x := rho_injective A hkey
          calc n ^ 2 * x = n ^ 2 * x * (n ^ 2)⁻¹ * n ^ 2 := by group
            _ = x * n ^ 2 := by rw [h1']
        rw [mem_Msub, ← map_mul, ← map_mul, hg]
      have hoddn : Odd (orderOf n) := hodd.of_dvd_nat (orderOf_dvd_natCard n)
      obtain ⟨k, hk⟩ := hoddn
      have hn_eq : n = (n ^ 2) ^ (k + 1) := by
        rw [← pow_mul, show 2 * (k + 1) = orderOf n + 1 by rw [hk]; ring, pow_succ,
          pow_orderOf_eq_one, one_mul]
      rw [hn_eq]
      exact pow_mem hn2 (k + 1)
  · exact Subgroup.le_normalizer

/-- The centraliser of a singleton is conjugated to the centraliser of the conjugate. -/
private theorem map_conj_centralizer {G : Type*} [Group G] (g x : G) :
    (Subgroup.centralizer ({x} : Set G)).map (MulAut.conj g).toMonoidHom
      = Subgroup.centralizer ({g * x * g⁻¹} : Set G) := by
  ext w
  rw [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff]
  constructor
  · rintro ⟨u, hu, huw⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at hu
    change g * u * g⁻¹ = w at huw
    rw [← huw]
    calc (g * u * g⁻¹) * (g * x * g⁻¹) = g * (u * x) * g⁻¹ := by group
      _ = g * (x * u) * g⁻¹ := by rw [hu]
      _ = (g * x * g⁻¹) * (g * u * g⁻¹) := by group
  · intro hw
    refine ⟨g⁻¹ * w * g, ?_, ?_⟩
    · rw [Subgroup.mem_centralizer_singleton_iff]
      calc (g⁻¹ * w * g) * x = g⁻¹ * (w * (g * x * g⁻¹)) * g := by group
        _ = g⁻¹ * ((g * x * g⁻¹) * w) * g := by rw [hw]
        _ = x * (g⁻¹ * w * g) := by group
    · change g * (g⁻¹ * w * g) * g⁻¹ = w; group

private theorem map_conj_Msub (A : Subgroup (V ≃ₗ[F] V)) (g x : ↥A) :
    (Msub A x).map (MulAut.conj g).toMonoidHom = Msub A (g * x * g⁻¹) :=
  map_conj_centralizer g x

theorem gl2_isCyclic_of_odd_no_eigen {F : Type} [Field F] [Finite F] {V : Type}
    [AddCommGroup V] [Module F V] [FiniteDimensional F V] (h2 : Module.finrank F V = 2)
    (A : Subgroup (V ≃ₗ[F] V)) (hodd : Odd (Nat.card ↥A))
    (hno : ∀ a ∈ A, a ≠ 1 → ∀ (c : F) (v : V), v ≠ 0 → (a : V ≃ₗ[F] V) v ≠ c • v) :
    IsCyclic ↥A := by
  classical
  by_cases htriv : Subsingleton ↥A
  · exact isCyclic_of_subsingleton
  · have hnt : ∃ a : ↥A, a ≠ 1 := by
      by_contra h
      push Not at h
      exact htriv ⟨fun a b => by rw [h a, h b]⟩
    obtain ⟨x0, hx0⟩ := hnt
    haveI : Finite ↥A := by
      haveI : Finite V := Module.finite_of_finite F
      have hGL : Finite (V ≃ₗ[F] V) :=
        Finite.of_injective (fun f : V ≃ₗ[F] V => (f : V → V)) LinearEquiv.coe_injective
      exact Finite.of_injective (fun a : ↥A => (a : V ≃ₗ[F] V)) (fun _ _ h => Subtype.ext h)
    have hab : ∀ x : ↥A, x ∉ (⊥ : Subgroup ↥A) → IsMulCommutative (Msub A x) :=
      fun x hx => hab_of A h2 hno x hx
    have hint : ∀ x y : ↥A, x ∉ (⊥ : Subgroup ↥A) → y ∉ (⊥ : Subgroup ↥A) →
        Msub A x = Msub A y ∨ Msub A x ⊓ Msub A y = ⊥ :=
      fun x y hx hy => hint_of A h2 hno x y hx hy
    have hnorm : ∀ x : ↥A, x ∉ (⊥ : Subgroup ↥A) →
        Subgroup.normalizer ((Msub A x : Subgroup ↥A) : Set ↥A) = Msub A x :=
      fun x hx => hnorm_of A h2 hodd hno x hx
    have hconj : ∀ x : ↥A, x ∉ (⊥ : Subgroup ↥A) → ∀ g : ↥A,
        (Msub A x).map (MulAut.conj g).toMonoidHom = Msub A (g * x * g⁻¹) :=
      fun x hx g => map_conj_Msub A g x
    have hcomm := Work.SmallRank.isMulCommutative_of_member_family hodd (⊥ : Subgroup ↥A) bot_le (Msub A)
      (fun x hx => bot_le) (fun x hx => self_mem_Msub A x) hab hint hnorm hconj
    have hirr : Irreducible (minpoly F (rho A x0)) :=
      Gl2Cyclic.minpoly_irreducible_of_no_eigen h2 (hns_of_ne A h2 hno x0 hx0)
        (hreg_of_ne A hno x0 hx0)
    refine Gl2Cyclic.isCyclic_of_le_aeval hirr A ?_
    intro a ha
    have hacomm : (rho A ⟨a, ha⟩) * (rho A x0) = (rho A x0) * (rho A ⟨a, ha⟩) := by
      have h1 := (isMulCommutative_iff.mp hcomm) ⟨a, ha⟩ x0
      rw [← map_mul, ← map_mul, h1]
    exact Gl2Cyclic.centralizer_eq_polynomials h2 (hns_of_ne A h2 hno x0 hx0) hacomm

end Work.ThmF.ChV12
