/-!
# `Work.ThmF.ChV12.isCyclic_ringEquiv_finiteField`

The automorphism group of a finite field `F` of characteristic `2` is cyclic.

Indeed, `F` has `2 ^ n` elements for some `n ≥ 1`, and every ring automorphism of `F` fixes the
prime field `𝔽₂ = ZMod 2`.  Hence `F ≃+* F` is the Galois group `Gal(F/𝔽₂)`, which is generated by
the Frobenius `x ↦ x ^ 2` (Mathlib: `FiniteField.frobeniusAlgEquivOfAlgebraic`, cyclic by
`FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow`).

So it suffices to (a) observe that every ring automorphism of `F` is automatically `𝔽₂`-linear,
i.e. restricts to an element of `Gal(F/𝔽₂)`, and (b) transfer the generator of `Gal(F/𝔽₂)` to
`F ≃+* F` along the coercion `AlgEquiv.toRingEquiv`, which is compatible with powers
(`coe_pow_toRingEquiv`).  This is exactly what the Bender–Suzuki argument needs: the automorphisms
of `F` occurring there are all powers of the Frobenius.
-/

namespace Work.ThmF.ChV12

/-- Coercing a power of an `𝔽₂`-algebra automorphism to a ring automorphism agrees with the
corresponding power of its coercion: `AlgEquiv.toRingEquiv` is compatible with `^ n`. -/
private theorem coe_pow_toRingEquiv {F : Type*} [Field F] [Algebra (ZMod 2) F]
    (e : F ≃ₐ[ZMod 2] F) (n : ℕ) :
    ((e ^ n : F ≃ₐ[ZMod 2] F) : F ≃+* F) = (e : F ≃+* F) ^ n := by
  ext x
  -- both sides are the `n`-fold iterate of `e`, see `AlgEquiv.coe_pow` and `RingAut.coe_pow`
  simp [AlgEquiv.coe_pow]

theorem isCyclic_ringEquiv_finiteField {F : Type*} [Field F] [Finite F] [CharP F 2] :
    IsCyclic (F ≃+* F) := by
  -- view `F` as an `𝔽₂`-algebra, so that ring automorphisms of `F` may be compared with
  -- `𝔽₂`-algebra automorphisms
  let _ : Algebra (ZMod 2) F := ZMod.algebra F 2
  -- the generator: the Frobenius `x ↦ x ^ 2`, as a ring automorphism
  let φ : F ≃+* F := (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) F : F ≃+* F)
  refine ⟨φ, fun σ => ?_⟩
  -- every ring automorphism of `F` fixes `1`, hence `ℤ`, hence the prime field `𝔽₂`
  let σ' : F ≃ₐ[ZMod 2] F :=
    { toRingEquiv := σ
      commutes' := by
        intro a
        obtain ⟨k, rfl⟩ := ZMod.natCast_zmod_surjective a
        simp }
  -- `Gal(F/𝔽₂)` is generated by the Frobenius, so `σ'` is a power of it, say `σ' = frob ^ i`
  obtain ⟨i, hi⟩ :=
    (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) F).2 σ'
  refine ⟨((i : ℕ) : ℤ), ?_⟩
  -- transfer `σ' = frob ^ i` along `AlgEquiv.toRingEquiv`: `σ = φ ^ i`
  have h2 : φ ^ (i : ℕ) = σ := by
    rw [← coe_pow_toRingEquiv (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) F) (i : ℕ)]
    exact congrArg (fun e : F ≃ₐ[ZMod 2] F => (e : F ≃+* F)) hi
  -- `(i : ℕ)` viewed in `ℤ` is the exponent whose power we need
  simpa using h2

end Work.ThmF.ChV12
