/-!
# `Work.ThmF.ChV12.JformReduction` — the crux reduced to solvability of the inverted group

The whole remaining content of `Work.ThmF.ChV12.SharpInvertingClosed` / `JFormClosed` (the
classical closure statement, = Peterfalvi II Ch. V §1 Prop. 2 / Zassenhaus's near-field theorem)
is isolated here in two provable steps.

## The two inputs of `jformOfSolvable`, and how each is discharged

`Work.ThmF.ChV12.jformOfSolvable` proves the `J`-form conclusion

  `∀ j₁ j₂ ∈ D, τj₁τ⁻¹ = j₁⁻¹ → τj₂τ⁻¹ = j₂⁻¹ → τ(j₁j₂)τ⁻¹ = (j₁j₂)⁻¹`

from two extra hypotheses beyond the structural ones:

* `hgen : ∀ x : ↥D, σ x * x ∈ ⁅⊤, ⊤⁆` — **discharged here** by
  `commutator_mem_of_generated_by_inverted`: it holds whenever `D` is generated by its
  `τ`-inverted elements (`⟨J(D,τ)⟩ = D`), because on the abelianisation `D/D'` the map `σ = conj τ`
  is inversion on the generators `J(D,τ)` and hence everywhere.  In the source's situation one
  always has `⟨Kset H t⟩ = D` in the interesting branch, so this is not a restriction.
* `hDsolv : Group.IsSolvable ↥D` — **reduced here** (`jformOfSolvable_of_cyclic_normal_irreducible`)
  to the existence of a `τ`-invariant-free structural witness: a **cyclic normal subgroup
  `N ⊴ D` acting irreducibly on `A`**.  By
  `Work.ThmF.ChV12.solvable_of_cyclic_normal_irreducible` such an `N` makes `D` metabelian
  (this is Feit–Thompson-free: `D/C_D(N) ↪ Aut(N)` abelian and `C_D(N)` commutative by
  `mulAut_mul_comm_of_commute_of_irreducible`), so `N` is exactly the input that replaces
  `hFT`.

## The remaining mathematical input

So the crux is **equivalent** (given the structural hypotheses, in which `A` is automatically
irreducible as an `𝔽₂[D]`-module) to

> *`D` (of odd order, acting faithfully and transitively on `A∖{1}`, `A` elementary abelian
> `2`-group) has a **cyclic normal subgroup acting irreducibly** on `A`.*

This is the hypothesis `type I` of Huppert–Blackburn, *Finite Groups III*, XII §9.2; the theorem
`HB3 XII 9.4` (Zassenhaus) shows that the alternatives (types II and III) only occur for
`p^f ∈ {5², 7², 11², 23², 29², 59²}`, i.e. **never in characteristic `2`** — which is precisely
the classical input that is still missing from this library (see
`Submission/Work/ThmF/ChV12/SharpInvertingClosed` and `NOTES_lemma5_state.md` §9.2, §11.2).
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.ThmF.ChV12

open LeanEval.GroupTheory.Defs

/-! ## Step 1: `τ` inverts `D/D'` when `D` is generated by its `τ`-inverted elements -/

/-- **`τ` acts as inversion on the abelianisation `D/D'`** as soon as `D` is generated by its
`τ`-inverted elements.

Equivalently: `σ x * x ∈ [D,D]` for every `x ∈ D`, where `σ = conj τ`.  On the abelian quotient
`D/D'` the map `x ↦ σ x * x` is a *homomorphism* (product of the two homomorphisms `σ` and `id`
into an abelian group), so it suffices to check it on a generating set; and on an inverted element
`y` it is `y⁻¹ * y = 1`. -/
theorem commutator_mem_of_generated_by_inverted {G : Type} [Group G] {D : Subgroup G} {τ : G}
    (hτN : τ ∈ Subgroup.normalizer (D : Set G))
    (hgen : Subgroup.closure {y : ↥D | jConj D τ hτN y = y⁻¹} = ⊤) :
    ∀ x : ↥D, jConj D τ hτN x * x ∈ ⁅(⊤ : Subgroup ↥D), (⊤ : Subgroup ↥D)⁆ := by
  classical
  set Nc : Subgroup ↥D := ⁅(⊤ : Subgroup ↥D), (⊤ : Subgroup ↥D)⁆ with hNc
  have hNcN : Nc.Normal := by rw [hNc]; exact Subgroup.commutator_normal _ _
  haveI := hNcN
  let A := ↥D ⧸ Nc
  have hle : commutator ↥D ≤ Nc := by rw [hNc]; unfold commutator; exact le_rfl
  haveI hAcomm : IsMulCommutative A :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hle
  let q : ↥D →* A := QuotientGroup.mk' Nc
  let σ : MulAut ↥D := jConj D τ hτN
  let Ψ : ↥D →* A :=
    { toFun := fun x => q (σ x) * q x
      map_one' := by simp
      map_mul' := fun x y => by
        show q (σ (x * y)) * q (x * y) = (q (σ x) * q x) * (q (σ y) * q y)
        rw [show σ (x * y) = σ x * σ y from map_mul σ x y, map_mul, map_mul]
        ac_rfl }
  have hker : Ψ.ker = ⊤ := by
    refine top_le_iff.mp ?_
    rw [← hgen]
    refine (Subgroup.closure_le _).mpr ?_
    intro y hy
    show q (σ y) * q y = 1
    rw [show σ y = y⁻¹ from hy, map_inv]
    exact inv_mul_cancel (q y)
  intro x
  have hx1 : Ψ x = 1 := by
    have := Subgroup.mem_top x
    rw [← hker] at this
    exact this
  change q (σ x) * q x = 1 at hx1
  have h2 : q (σ x * x) = 1 := by rw [map_mul]; exact hx1
  have h3 : σ x * x ∈ Nc := (QuotientGroup.eq_one_iff _).mp h2
  rw [hNc] at h3
  exact h3

/-- **The `J`-form conclusion from the generation hypothesis alone.**  This is
`Work.ThmF.ChV12.jformOfSolvable` with its `hgen` input discharged by
`commutator_mem_of_generated_by_inverted`; the only remaining input is solvability of `↥D`. -/
theorem jformOfSolvable_of_generated {G : Type} [Group G] (A D : Subgroup G) (τ : G)
    (hA2 : ∀ x ∈ A, x * x = 1) (hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hDN : D ≤ Subgroup.normalizer (A : Set G)) (hodd : Odd (Nat.card ↥D))
    (hτ2 : τ * τ = 1) (hτN : τ ∈ Subgroup.normalizer (D : Set G))
    [Finite ↥D] [Finite ↥A]
    (htrans : ∀ a ∈ A, a ≠ 1 → ∀ b ∈ A, b ≠ 1 →
      ∃! j : G, (j ∈ D ∧ τ * j * τ⁻¹ = j⁻¹) ∧ j * a * j⁻¹ = b)
    (hfaith : D ⊓ Subgroup.centralizer (A : Set G) = ⊥)
    (hgen : Subgroup.closure {y : ↥D | jConj D τ hτN y = y⁻¹} = ⊤)
    (hDsolv : Group.IsSolvable ↥D) :
    ∀ j₁ ∈ D, τ * j₁ * τ⁻¹ = j₁⁻¹ → ∀ j₂ ∈ D, τ * j₂ * τ⁻¹ = j₂⁻¹ →
      τ * (j₁ * j₂) * τ⁻¹ = (j₁ * j₂)⁻¹ :=
  jformOfSolvable A D τ hA2 hAc hDN hodd hτ2 hτN htrans hfaith
    (commutator_mem_of_generated_by_inverted hτN hgen) hDsolv

/-! ## Step 2: the action is faithful, and a cyclic normal irreducible `N` makes `D` solvable -/

/-- `D` acts faithfully on `A` (`ρ = jAct A D hDN` is injective) as soon as
`D ⊓ C_G(A) = ⊥`: any `d` acting trivially on `A` lies in `D ⊓ C_G(A)`. -/
theorem injective_jAct {G : Type} [Group G] {A D : Subgroup G}
    (hDN : D ≤ Subgroup.normalizer (A : Set G))
    (hfaith : D ⊓ Subgroup.centralizer (A : Set G) = ⊥) :
    Function.Injective (jAct A D hDN) := by
  intro d e hde
  have hmem : ((e⁻¹ * d : ↥D) : G) ∈ D ⊓ Subgroup.centralizer (A : Set G) := by
    refine ⟨(e⁻¹ * d).2, ?_⟩
    exact Subgroup.mem_centralizer_iff.mpr (fun a ha => by
      have h := congrArg (fun (f : MulAut ↥A) => ((f ⟨a, ha⟩ : ↥A) : G)) hde
      simp only [jAct_coe] at h
      have h2 : ((e⁻¹ * d : ↥D) : G) * a * ((e⁻¹ * d : ↥D) : G)⁻¹ = a := by
        have hdd : (d : G) * a * (d : G)⁻¹ = (e : G) * a * (e : G)⁻¹ := h
        simp only [Subgroup.coe_mul, Subgroup.coe_inv]
        calc (e : G)⁻¹ * (d : G) * a * ((e : G)⁻¹ * (d : G))⁻¹
            = (e : G)⁻¹ * ((d : G) * a * (d : G)⁻¹) * (e : G) := by group
          _ = (e : G)⁻¹ * ((e : G) * a * (e : G)⁻¹) * (e : G) := by rw [hdd]
          _ = a := by group
      have hxa : ((e⁻¹ * d : ↥D) : G) * a = a * ((e⁻¹ * d : ↥D) : G) := by
        calc ((e⁻¹ * d : ↥D) : G) * a
            = (((e⁻¹ * d : ↥D) : G) * a * ((e⁻¹ * d : ↥D) : G)⁻¹)
                * ((e⁻¹ * d : ↥D) : G) := by group
          _ = a * ((e⁻¹ * d : ↥D) : G) := by rw [h2]
      exact hxa.symm)
  rw [hfaith, Subgroup.mem_bot] at hmem
  have h1 : (e⁻¹ * d : ↥D) = 1 := Subtype.ext hmem
  have : e * (e⁻¹ * d) = e * 1 := by rw [h1]
  simpa using this

/-- **`D` is solvable** as soon as it has a cyclic normal subgroup `N` acting irreducibly on the
elementary abelian `2`-group `A` (`Work.ThmF.ChV12.solvable_of_cyclic_normal_irreducible`,
transported to the subgroup setting). -/
theorem isSolvable_of_cyclic_normal_irreducible {G : Type} [Group G] {A D : Subgroup G}
    (hA2 : ∀ x ∈ A, x * x = 1) (hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hDN : D ≤ Subgroup.normalizer (A : Set G))
    [Finite ↥D] [Finite ↥A]
    (hfaith : D ⊓ Subgroup.centralizer (A : Set G) = ⊥)
    (N : Subgroup ↥D) (hNnorm : N.Normal) (hNcyc : IsCyclic ↥N)
    (hirr : ∀ W : Subgroup ↥A, W ≠ ⊥ →
      (∀ t ∈ N, ∀ x ∈ W, jAct A D hDN t x ∈ W) → W = ⊤) :
    Group.IsSolvable ↥D :=
  solvable_of_cyclic_normal_irreducible
    (fun x => Subtype.ext (by simpa [Subgroup.coe_mul] using hA2 (x : G) x.2))
    (fun x y => Subtype.ext (by simpa [Subgroup.coe_mul] using hAc (x : G) x.2 (y : G) y.2))
    (jAct A D hDN) (injective_jAct hDN hfaith) N hNnorm hNcyc hirr

/-! ## Step 3: the assembled reduction -/

/-- **The classical closure statement from a cyclic normal irreducible subgroup.**

This is the sharpest form of the reduction of the crux: with the structural hypotheses of
`Work.ThmF.ChV12.SharpInvertingClosed` (odd-order `D` acting faithfully and transitively on the
nonidentity elements of an elementary abelian `2`-group `A`, `τ` an involution normalising `D`
and inverting the sharply transitive set), **and** the assumption that `D` is generated by its
`τ`-inverted elements, the conclusion holds as soon as `D` has a cyclic normal subgroup `N` acting
irreducibly on `A`.

The proof is `Step 1` (generation gives `hgen`) + `Step 2` (`N` gives solvability) +
`jformOfSolvable`. -/
theorem jformOf_of_cyclic_normal_irreducible {G : Type} [Group G] (A D : Subgroup G) (τ : G)
    (hA2 : ∀ x ∈ A, x * x = 1) (hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hDN : D ≤ Subgroup.normalizer (A : Set G)) (hodd : Odd (Nat.card ↥D))
    (hτ2 : τ * τ = 1) (hτN : τ ∈ Subgroup.normalizer (D : Set G))
    [Finite ↥D] [Finite ↥A]
    (htrans : ∀ a ∈ A, a ≠ 1 → ∀ b ∈ A, b ≠ 1 →
      ∃! j : G, (j ∈ D ∧ τ * j * τ⁻¹ = j⁻¹) ∧ j * a * j⁻¹ = b)
    (hfaith : D ⊓ Subgroup.centralizer (A : Set G) = ⊥)
    (hgen : Subgroup.closure {y : ↥D | jConj D τ hτN y = y⁻¹} = ⊤)
    (N : Subgroup ↥D) (hNnorm : N.Normal) (hNcyc : IsCyclic ↥N)
    (hirr : ∀ W : Subgroup ↥A, W ≠ ⊥ →
      (∀ t ∈ N, ∀ x ∈ W, jAct A D hDN t x ∈ W) → W = ⊤) :
    ∀ j₁ ∈ D, τ * j₁ * τ⁻¹ = j₁⁻¹ → ∀ j₂ ∈ D, τ * j₂ * τ⁻¹ = j₂⁻¹ →
      τ * (j₁ * j₂) * τ⁻¹ = (j₁ * j₂)⁻¹ :=
  jformOfSolvable_of_generated A D τ hA2 hAc hDN hodd hτ2 hτN htrans hfaith hgen
    (isSolvable_of_cyclic_normal_irreducible hA2 hAc hDN hfaith N hNnorm hNcyc hirr)

/-- **The configuration of the `J`-form: `D` is solvable.**  This is the odd order theorem for
`D` — the one input the FT-route to the crux consumes — isolated as a `Prop`. -/
def TransitiveLinearSolvable : Prop :=
  ∀ {A D : Type} [Group A] [Group D] [Finite A] [Finite D],
    (∀ x : A, x * x = 1) → (∀ x y : A, x * y = y * x) →
    Odd (Nat.card D) → (ρ : D →* MulAut A) → Function.Injective ρ →
    (∀ a b : A, a ≠ 1 → b ≠ 1 → ∃ d : D, ρ d a = b) → Group.IsSolvable D

/-- **The residual input, isolated.**  In the `J`-form configuration (odd-order `D` acting
faithfully and transitively on the nonidentity elements of an elementary abelian `2`-group `A`),
`D` has a **cyclic normal subgroup acting irreducibly** on `A`.

This is hypothesis *type I* of Huppert–Blackburn III, XII §9.2.  Zassenhaus's theorem
(`HB3 XII 9.4`: the alternatives — types II and III — occur only for `p^f ∈
{5², 7², 11², 23², 29², 59²}`, all of odd characteristic) says it **always holds in
characteristic `2`**; that classical statement is exactly what is still missing from this library.

By `Work.ThmF.ChV12.isSolvable_of_cyclic_normal_irreducible` and
`Work.ThmF.ChV12.cyclic_normal_irreducible_of_solvable` (both below/above),
`CyclicNormalIrreducibleProp ↔ TransitiveLinearSolvable`: the existence of `N` is *equivalent* to
solvability of `D` in this configuration. -/
def CyclicNormalIrreducibleProp : Prop :=
  ∀ {A D : Type} [Group A] [Group D] [Finite A] [Finite D],
    (∀ x : A, x * x = 1) → (∀ x y : A, x * y = y * x) →
    Odd (Nat.card D) → (ρ : D →* MulAut A) → Function.Injective ρ →
    (∀ a b : A, a ≠ 1 → b ≠ 1 → ∃ d : D, ρ d a = b) →
    ∃ N : Subgroup D, N.Normal ∧ IsCyclic ↥N ∧
      (∀ W : Subgroup A, W ≠ ⊥ → (∀ t ∈ N, ∀ x ∈ W, ρ t x ∈ W) → W = ⊤)

/-- **Solvability gives the cyclic normal irreducible subgroup**, namely the Fitting subgroup
`F(D)`: `F(D)` is cyclic (Huppert's Appendix X, `Work.ThmF.ChV12.Fitting_cyclic_fpf`) and, when
`D` is solvable, acts irreducibly (`Work.ThmF.ChV12.fitting_irreducible_of_transitive_of_solvable`,
via the orbit count `fitting_card_lt_centralizer` and Fitting's theorem). -/
theorem cyclic_normal_irreducible_of_solvable {A D : Type} [Group A] [Finite A] [Group D]
    [Finite D]
    (hA2 : ∀ x : A, x * x = 1) (hAc : ∀ x y : A, x * y = y * x)
    (hodd : Odd (Nat.card D)) (ρ : D →* MulAut A) (hfaith : Function.Injective ρ)
    (htrans : ∀ a b : A, a ≠ 1 → b ≠ 1 → ∃ d : D, ρ d a = b)
    (hsol : Group.IsSolvable D) :
    ∃ N : Subgroup D, N.Normal ∧ IsCyclic ↥N ∧
      (∀ W : Subgroup A, W ≠ ⊥ → (∀ t ∈ N, ∀ x ∈ W, ρ t x ∈ W) → W = ⊤) :=
  ⟨Work.Fitting.fitting D, Work.Fitting.fitting_normal' D,
    (Fitting_cyclic_fpf hA2 hAc hodd ρ hfaith htrans).1,
    fitting_irreducible_of_transitive_of_solvable hA2 hAc hodd ρ hfaith htrans hsol⟩

/-- `CyclicNormalIrreducibleProp` from `TransitiveLinearSolvable` (Fitting subgroup). -/
theorem cyclicNormalIrreducible_of_solvable (h : TransitiveLinearSolvable) :
    CyclicNormalIrreducibleProp :=
  fun hA2 hAc hodd ρ hfaith htrans =>
    cyclic_normal_irreducible_of_solvable hA2 hAc hodd ρ hfaith htrans
      (h hA2 hAc hodd ρ hfaith htrans)

/-- `TransitiveLinearSolvable` from `CyclicNormalIrreducibleProp` — this is the direction in which
the *crux* uses the input. -/
theorem solvable_of_cyclicNormalIrreducible (h : CyclicNormalIrreducibleProp) :
    TransitiveLinearSolvable := by
  intro A D _ _ _ _ hA2 hAc hodd ρ hfaith htrans
  obtain ⟨N, hNnorm, hNcyc, hirr⟩ := h hA2 hAc hodd ρ hfaith htrans
  exact solvable_of_cyclic_normal_irreducible hA2 hAc ρ hfaith N hNnorm hNcyc hirr

/-- **The residual input is exactly solvability.**  In the `J`-form configuration, `D` has a
cyclic normal subgroup acting irreducibly on `A` **if and only if** `D` is solvable.  So the crux
`Work.ThmF.ChV12.jformOf_of_cyclicNormalIrreducibleProp` is precisely the FT-route, and the
FT-free Zassenhaus/Hering route (`HB3 XII 9.4`) is the only way to avoid it. -/
theorem cyclicNormalIrreducibleProp_iff_solvable :
    CyclicNormalIrreducibleProp ↔ TransitiveLinearSolvable :=
  ⟨solvable_of_cyclicNormalIrreducible, cyclicNormalIrreducible_of_solvable⟩

/-- **The crux from the residual input `CyclicNormalIrreducibleProp`.**

Given the residual classical input plus the (mild, always available in the source's branch)
generation hypothesis `⟨J(D,τ)⟩ = D`, the `J`-form closure statement holds. -/
theorem jformOf_of_cyclicNormalIrreducibleProp (h : CyclicNormalIrreducibleProp)
    {G : Type} [Group G] {A D : Subgroup G} {τ : G}
    (hA2 : ∀ x ∈ A, x * x = 1) (hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hDN : D ≤ Subgroup.normalizer (A : Set G)) (hodd : Odd (Nat.card ↥D))
    (hτ2 : τ * τ = 1) (hτN : τ ∈ Subgroup.normalizer (D : Set G))
    [Finite ↥D] [Finite ↥A]
    (htrans : ∀ a ∈ A, a ≠ 1 → ∀ b ∈ A, b ≠ 1 →
      ∃! j : G, (j ∈ D ∧ τ * j * τ⁻¹ = j⁻¹) ∧ j * a * j⁻¹ = b)
    (hfaith : D ⊓ Subgroup.centralizer (A : Set G) = ⊥)
    (hgen : Subgroup.closure {y : ↥D | jConj D τ hτN y = y⁻¹} = ⊤) :
    ∀ j₁ ∈ D, τ * j₁ * τ⁻¹ = j₁⁻¹ → ∀ j₂ ∈ D, τ * j₂ * τ⁻¹ = j₂⁻¹ →
      τ * (j₁ * j₂) * τ⁻¹ = (j₁ * j₂)⁻¹ := by
  -- transitivity of `D` on `A#` in the abstract groups `↥D`, `↥A`, for the action `jAct`
  have htransρ : ∀ a b : ↥A, a ≠ 1 → b ≠ 1 → ∃ d : ↥D, jAct A D hDN d a = b := by
    intro a b ha hb
    obtain ⟨j, ⟨⟨hjD, -⟩, hja⟩, -⟩ :=
      htrans (a : G) a.2 (fun h => ha (Subtype.ext h)) (b : G) b.2 (fun h => hb (Subtype.ext h))
    exact ⟨⟨j, hjD⟩, Subtype.ext (by rw [jAct_coe]; exact hja)⟩
  obtain ⟨N, hNnorm, hNcyc, hirr⟩ :=
    h (fun x => Subtype.ext (by simpa [Subgroup.coe_mul] using hA2 (x : G) x.2))
      (fun x y => Subtype.ext (by simpa [Subgroup.coe_mul] using hAc (x : G) x.2 (y : G) y.2))
      hodd (jAct A D hDN) (injective_jAct hDN hfaith) htransρ
  exact jformOf_of_cyclic_normal_irreducible A D τ hA2 hAc hDN hodd hτ2 hτN htrans hfaith
    hgen N hNnorm hNcyc hirr

end Work.ThmF.ChV12
