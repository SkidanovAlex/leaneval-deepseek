/-!
# Peterfalvi II, Ch. V §1, Corollary of Prop. 2 (p. 241)

> **Corollary.** *The Sylow 2-subgroup `S` of `Q` is abelian or is a Suzuki 2-group.*
> (Indeed `K` acts regularly on `Inv(S) = Inv(H)`, Ch. I §2.)

The three ingredients built here are:

* `sylowTwo_exists_invariant` — the Sylow 2-subgroup `S` of a finite nilpotent `Q ≤ G` exists,
  has odd index in `Q`, and is invariant under conjugation by `N_G(Q)` (nilpotent groups have a
  unique Sylow 2-subgroup, hence a characteristic one);
* `involutions_S_eq_involutions_H` — since `K` acts on `S` by conjugation and transitively on
  `Inv(H)`, the set of involutions of `S` is exactly `Inv(H)` (both are nonempty: `|Q|` is even
  because `|H| = |Q| · |D|` with `|H|` even and `D = H ∩ H^t` of odd order);
* `isSuzukiTwoGroup_of_Ksub_cyclic` — `K` (cyclic) is generated by one element `k₀`, and
  conjugation by `k₀` is an automorphism of `S` whose powers are transitive on `Inv(S)`; since
  `Inv(S) = Inv(H)` has at least two elements (`cardInvGeTwo`, using the four-group that
  `Situation G` provides), `S` is a Suzuki 2-group as soon as it is non-abelian.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open LeanEval.GroupTheory.Defs Submission.Blueprint Work.ThmF

namespace Work.ThmF.ChV12

/-! ## Auxiliary: negative powers of an element of a finite group -/

/-- In a finite group, an integral power of `x` is a natural power of `x`. -/
lemma exists_nat_pow_eq_of_zpow_eq {G : Type} [Group G] [Finite G] {x y : G} {n : ℤ}
    (h : x ^ n = y) : ∃ m : ℕ, x ^ m = y := by
  have hN : (0 : ℤ) < (orderOf x : ℕ) := by exact_mod_cast orderOf_pos x
  refine ⟨(n % (orderOf x : ℤ)).toNat, ?_⟩
  have hmod : 0 ≤ n % (orderOf x : ℤ) := Int.emod_nonneg n hN.ne'
  have hz : x ^ (n % (orderOf x : ℤ)) = x ^ n := by
    have h1 : n = n % (orderOf x : ℤ) + (orderOf x : ℤ) * (n / (orderOf x : ℤ)) :=
      (Int.emod_add_mul_ediv n (orderOf x : ℤ)).symm
    conv_rhs => rw [h1]
    rw [zpow_add, zpow_mul, zpow_natCast, pow_orderOf_eq_one, one_zpow, mul_one]
  rw [← zpow_natCast x ((n % (orderOf x : ℤ)).toNat), Int.toNat_of_nonneg hmod]
  exact hz.trans h

/-! ## §1. The Sylow 2-subgroup of a finite nilpotent `Q` -/

/-- **Sylow 2-subgroup of a finite nilpotent `Q ≤ G`.** It exists, has odd index in `Q`, and is
invariant under conjugation by every element of `N_G(Q)`.

(The invariance rests on `Q` being nilpotent: then the Sylow 2-subgroup `P` of `Q` is normal in
`Q`, hence the only Sylow 2-subgroup of `Q`, and conjugation by `g ∈ N_G(Q)` maps it to
another one.) -/
theorem sylowTwo_exists_invariant {G : Type} [Group G] [Finite G] (Q : Subgroup G)
    (hnil : Group.IsNilpotent ↥Q) :
    ∃ S : Subgroup G, S ≤ Q ∧ IsPGroup 2 S ∧ ¬ 2 ∣ (S.subgroupOf Q).index ∧
      ∀ g ∈ Subgroup.normalizer (Q : Set G), ∀ x ∈ S, g * x * g⁻¹ ∈ S := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨P⟩ := (Sylow.nonempty (p := 2) (G := ↥Q))
  have hPnorm : (P : Subgroup ↥Q).Normal := inferInstance
  -- every `2`-subgroup of `Q` of odd index is this Sylow subgroup
  have huniq : ∀ T : Subgroup ↥Q, IsPGroup 2 T → ¬ 2 ∣ T.index → T = (P : Subgroup ↥Q) := by
    intro T hT hTidx
    haveI := Sylow.unique_of_normal P hPnorm
    have h := Subsingleton.elim (hT.toSylow hTidx) ((P.isPGroup').toSylow (Sylow.not_dvd_index P))
    exact congrArg (fun s : Sylow 2 ↥Q => (s : Subgroup ↥Q)) h
  refine ⟨(P : Subgroup ↥Q).map Q.subtype, Subgroup.map_subtype_le _, (P.isPGroup').map Q.subtype,
    ?_, ?_⟩
  · have hsub : ((P : Subgroup ↥Q).map Q.subtype).subgroupOf Q = (P : Subgroup ↥Q) := by
      ext x
      simp [Subgroup.mem_subgroupOf, Subgroup.mem_map]
    rw [hsub]
    exact Sylow.not_dvd_index P
  · intro g hg x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
    have hmem : ∀ z : ↥Q, g * (z : G) * g⁻¹ ∈ Q :=
      fun z => (Subgroup.mem_normalizer_iff.mp hg (z : G)).mp z.2
    let f : ↥Q →* ↥Q :=
      { toFun := fun z => ⟨g * (z : G) * g⁻¹, hmem z⟩
        map_one' := by ext; simp
        map_mul' := by
          intro a b
          ext
          simp only [Subgroup.coe_mul]
          group }
    have hfinj : Function.Injective f := by
      intro a b hab
      have h : g * (a : G) * g⁻¹ = g * (b : G) * g⁻¹ := congrArg Subtype.val hab
      exact Subtype.ext (mul_left_cancel (mul_right_cancel h))
    have hTeq : P.map f = (P : Subgroup ↥Q) := by
      refine huniq (P.map f) ((P.isPGroup').map f) ?_
      have hcard : Nat.card ↥(P.map f) = Nat.card ↥(P : Subgroup ↥Q) :=
        Subgroup.card_map_of_injective hfinj
      have h1 := Subgroup.card_mul_index (P.map f)
      have h2 := Subgroup.card_mul_index (P : Subgroup ↥Q)
      have h3 : Nat.card ↥(P.map f) * (P.map f).index
          = Nat.card ↥(P.map f) * (P : Subgroup ↥Q).index := by
        calc Nat.card ↥(P.map f) * (P.map f).index = Nat.card ↥Q := h1
          _ = Nat.card ↥(P : Subgroup ↥Q) * (P : Subgroup ↥Q).index := h2.symm
          _ = Nat.card ↥(P.map f) * (P : Subgroup ↥Q).index := by rw [hcard]
      have h4 : (P.map f).index = (P : Subgroup ↥Q).index :=
        Nat.mul_left_cancel Nat.card_pos h3
      rw [h4]
      exact Sylow.not_dvd_index P
    refine Subgroup.mem_map.mpr ⟨f y, ?_, rfl⟩
    rw [← hTeq]
    exact Subgroup.mem_map.mpr ⟨y, hy, rfl⟩

/-! ## §2. `Inv(S) = Inv(H)` -/

/-- **`Inv(S) = Inv(H)`** for `S` a `2`-subgroup of `Q` of odd index, stabilised by `K = Ksub H t`,
when `K` is transitive on `Inv(H)`.

`S` is a Sylow `2`-subgroup of `Q`; since `|H| = |Q| · |D|` with `|H|` even and `|D|` odd, `|Q|`
(and hence `|S|`) is even, so `S` contains an involution `u`; the `K`-orbit of `u` is all of
`Inv(H)` and lies in `Inv(S)`. -/
theorem involutions_S_eq_involutions_H {G : Type} [Group G] [Finite G] (H Q : Subgroup G) (t : G)
    (h : IsSplitRankOne H Q t) (S : Subgroup G) (hSQ : S ≤ Q) (hSp : IsPGroup 2 S)
    (hidx : ¬ 2 ∣ (S.subgroupOf Q).index)
    (hStab : ∀ k ∈ Ksub H t, ∀ x ∈ S, k * x * k⁻¹ ∈ S)
    (hKset : (Ksub H t : Set G) = Kset H t)
    (hKtrans : ∀ a ∈ involutions (H : Set G), ∀ b ∈ involutions (H : Set G),
      ∃ k ∈ Kset H t, k * a * k⁻¹ = b) :
    (involutions (S : Set G)) = involutions (H : Set G) := by
  -- `|Q|` is even
  have hQeven : Even (Nat.card ↥Q) := by
    have hDodd : Odd (Nat.card ↥(twoPoint H t)) := split_odd_card_twoPoint h
    have h1 : Even (Nat.card ↥Q * Nat.card ↥(twoPoint H t)) := by
      rw [← split_card_H h]; exact split_even_card_H h
    rw [Nat.even_mul] at h1
    exact h1.resolve_right (Nat.not_even_iff_odd.mpr hDodd)
  -- `|S|` is even
  have hSeven : Even (Nat.card ↥S) := by
    have hcard : Nat.card ↥(S.subgroupOf Q) = Nat.card ↥S :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hSQ).toEquiv
    have h1 : Nat.card ↥(S.subgroupOf Q) * (S.subgroupOf Q).index = Nat.card ↥Q :=
      Subgroup.card_mul_index _
    have h2 : Nat.card ↥S * (S.subgroupOf Q).index = Nat.card ↥Q := by rw [← hcard]; exact h1
    have h3 : 2 ∣ Nat.card ↥S * (S.subgroupOf Q).index := by
      rw [h2]; exact even_iff_two_dvd.mp hQeven
    rcases Nat.prime_two.dvd_mul.mp h3 with h4 | h4
    · exact even_iff_two_dvd.mpr h4
    · exact absurd h4 hidx
  -- an involution of `S`
  obtain ⟨zs, hzs⟩ := exists_prime_orderOf_dvd_card' (G := ↥S) 2 (even_iff_two_dvd.mp hSeven)
  have hzS : ((zs : ↥S) : G) ∈ S := zs.2
  have hz2 : orderOf ((zs : ↥S) : G) = 2 := by rw [Subgroup.orderOf_coe, hzs]
  ext u
  constructor
  · rintro ⟨huS, hu2⟩
    exact ⟨h.le (hSQ huS), hu2⟩
  · rintro ⟨huH, hu2⟩
    obtain ⟨k, hkKset, hk⟩ := hKtrans (((zs : ↥S) : G)) ⟨h.le (hSQ hzS), hz2⟩ u ⟨huH, hu2⟩
    have hkKsub : k ∈ Ksub H t := by
      have : k ∈ (Ksub H t : Set G) := by rw [hKset]; exact hkKset
      exact this
    refine ⟨?_, hu2⟩
    rw [← hk]
    exact hStab k hkKsub ((zs : ↥S) : G) hzS

/-! ## §3. The non-abelian case: `S` is a Suzuki 2-group -/

/-- **A `2`-group on which a cyclic group acts transitively on the involutions, with at least two
involutions and non-abelian, is a Suzuki 2-group.**

`K = Ksub H t` is cyclic, say generated by `k₀`; conjugation by `k₀` is an automorphism `ξ` of
`S`. Every element of `K` is a natural power of `k₀`, and `K` is transitive on `Inv(H) ⊇ Inv(S)`
by `hKtrans`, so the powers of `ξ` are transitive on `Inv(S)`. -/
theorem isSuzukiTwoGroup_of_Ksub_cyclic {G : Type} [Group G] [Finite G] (H : Subgroup G) (t : G)
    (S : Subgroup G) (hSH : S ≤ H) (hSp : IsPGroup 2 S)
    (hStab : ∀ k ∈ Ksub H t, ∀ x ∈ S, k * x * k⁻¹ ∈ S)
    (hcard : 2 ≤ (involutions (S : Set G)).ncard) (hnab : ¬ IsAbelianSubgroup S)
    (hKcyc : IsCyclic ↥(Ksub H t)) (hKset : (Ksub H t : Set G) = Kset H t)
    (hKtrans : ∀ a ∈ involutions (H : Set G), ∀ b ∈ involutions (H : Set G),
      ∃ k ∈ Kset H t, k * a * k⁻¹ = b) :
    IsSuzukiTwoGroup ↥S := by
  -- (1) a non-commuting pair
  have hnc : ∃ x y : ↥S, x * y ≠ y * x := by
    by_contra hcon
    refine hnab ?_
    intro x hx y hy
    by_contra hxy
    exact hcon ⟨⟨x, hx⟩, ⟨y, hy⟩, fun h => hxy (by simpa using congrArg Subtype.val h)⟩
  -- (2) two distinct involutions of `S`
  have hinv : ∃ x y : ↥S, orderOf x = 2 ∧ orderOf y = 2 ∧ x ≠ y := by
    have h1 : 1 < (involutions (S : Set G)).ncard := by omega
    obtain ⟨a, ha, b, hb, hne⟩ := (Set.one_lt_ncard (s := involutions (S : Set G))).mp h1
    refine ⟨⟨a, ha.1⟩, ⟨b, hb.1⟩, ?_, ?_, ?_⟩
    · rw [← Subgroup.orderOf_coe (⟨a, ha.1⟩ : ↥S)]; exact ha.2
    · rw [← Subgroup.orderOf_coe (⟨b, hb.1⟩ : ↥S)]; exact hb.2
    · intro hab
      exact hne (by simpa using congrArg Subtype.val hab)
  -- (3) a generator `k₀` of `K = Ksub H t`
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥(Ksub H t))
  let k0 : G := (g : G)
  have hk0 : k0 ∈ Ksub H t := g.2
  have hpow : ∀ k ∈ Ksub H t, ∃ m : ℕ, k0 ^ m = k := by
    intro k hk
    have h1 : (⟨k, hk⟩ : ↥(Ksub H t)) ∈ Subgroup.zpowers g := hg ⟨k, hk⟩
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp h1
    have hn' : k0 ^ n = k := by simpa [k0] using congrArg Subtype.val hn
    exact exists_nat_pow_eq_of_zpow_eq hn'
  -- (4) conjugation by `k₀` as an automorphism of `S`
  let phi : MulAut ↥S :=
    { toFun := fun x => ⟨k0 * (x : G) * k0⁻¹, hStab k0 hk0 x x.2⟩
      invFun := fun x => ⟨k0⁻¹ * (x : G) * k0⁻¹⁻¹, hStab k0⁻¹ ((Ksub H t).inv_mem hk0) x x.2⟩
      left_inv := by
        intro x
        apply Subtype.ext
        group
      right_inv := by
        intro x
        apply Subtype.ext
        group
      map_mul' := by
        intro a b
        apply Subtype.ext
        simp only [Subgroup.coe_mul]
        group }
  -- (5) the powers of `phi` are transitive on the involutions of `S`
  refine ⟨hSp, hnc, hinv, phi, ?_⟩
  intro x y hx2 hy2
  have hxH : (x : G) ∈ involutions (H : Set G) :=
    ⟨hSH x.2, by rw [Subgroup.orderOf_coe]; exact hx2⟩
  have hyH : (y : G) ∈ involutions (H : Set G) :=
    ⟨hSH y.2, by rw [Subgroup.orderOf_coe]; exact hy2⟩
  obtain ⟨k, hkKset, hk⟩ := hKtrans (x : G) hxH (y : G) hyH
  have hkKsub : k ∈ Ksub H t := by
    have : k ∈ (Ksub H t : Set G) := by rw [hKset]; exact hkKset
    exact this
  obtain ⟨m, hm⟩ := hpow k hkKsub
  refine ⟨m, ?_⟩
  have hphi : ∀ j : ℕ, (((phi ^ j) x : ↥S) : G) = k0 ^ j * (x : G) * (k0 ^ j)⁻¹ := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      have hstep : (phi ^ (j + 1)) x = phi ((phi ^ j) x) := by
        rw [pow_succ', MulAut.mul_apply]
      rw [hstep]
      show k0 * ((((phi ^ j) x : ↥S)) : G) * k0⁻¹
        = k0 ^ (j + 1) * (x : G) * (k0 ^ (j + 1))⁻¹
      rw [ih]
      group
  have hy : (y : G) = k0 ^ m * (x : G) * (k0 ^ m)⁻¹ := by rw [← hk, hm]
  exact Subtype.ext (by rw [hphi m, hy])

/-! ## §4. The corollary -/

open LeanEval.GroupTheory.Defs Submission.Blueprint Work.ThmF in theorem corProp2 {G : Type} [Group G] [Finite G] (hS : Situation G) (H Q : Subgroup G) (t : G) (h : IsSplitRankOne H Q t) (hnil : Group.IsNilpotent ↥Q) (hKcyc : IsCyclic ↥(Ksub H t)) (hKset : (Ksub H t : Set G) = Kset H t) (hKtrans : ∀ a ∈ involutions (H : Set G), ∀ b ∈ involutions (H : Set G), ∃ k ∈ Kset H t, k * a * k⁻¹ = b) : ∃ S : Subgroup G, S ≤ Q ∧ IsPGroup 2 S ∧ ¬ 2 ∣ (S.subgroupOf Q).index ∧ (IsAbelianSubgroup S ∨ IsSuzukiTwoGroup ↥S) := by
  -- the Sylow 2-subgroup `S` of `Q` and its invariance under `N_G(Q)`
  obtain ⟨S, hSQ, hSp, hidx, hSinv⟩ := sylowTwo_exists_invariant Q hnil
  have hKN : Ksub H t ≤ Subgroup.normalizer (Q : Set G) := by
    refine (Subgroup.closure_le _).mpr ?_
    intro k hk
    exact h.normal (Work.Models.twoPoint_le_left H t (Kset_subset H t hk))
  have hStab : ∀ k ∈ Ksub H t, ∀ x ∈ S, k * x * k⁻¹ ∈ S :=
    fun k hk x hx => hSinv k (hKN hk) x hx
  refine ⟨S, hSQ, hSp, hidx, ?_⟩
  by_cases hab : IsAbelianSubgroup S
  · exact Or.inl hab
  · refine Or.inr (isSuzukiTwoGroup_of_Ksub_cyclic H t S (hSQ.trans h.le) hSp hStab ?_ hab
      hKcyc hKset hKtrans)
    rw [involutions_S_eq_involutions_H H Q t h S hSQ hSp hidx hStab hKset hKtrans]
    exact Work.ThmF.Bender.cardInvGeTwo h.stronglyEmbedded hS.1.1

