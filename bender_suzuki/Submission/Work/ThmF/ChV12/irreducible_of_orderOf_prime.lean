/-!
# Irreducibility of an automorphism of order a primitive prime divisor

Let `A` be a finite group with `|A| = 2 ^ k`, and let `σ : MulAut A` be an automorphism whose
order is a prime `p` such that `2` has multiplicative order exactly `k` in `ZMod p`
(equivalently `p` is a primitive prime divisor of `2 ^ k - 1`).  Then `σ` acts *irreducibly*:
the only `σ`-invariant subgroups of `A` are `⊥` and `⊤`.

The proof is an elementary orbit count, valid for an arbitrary finite group `A` (no abelian /
exponent-two hypothesis is needed).  Let `G = ⟨σ⟩`, of order `p`.  Since `G` is a `p`-group,
`IsPGroup.card_modEq_card_fixedPoints` gives, for any finite `G`-set `X`,

`|X| ≡ |X ^ G|  [MOD p]`.

* Applied to `X = A`: `|A| ≡ |Fix(σ)|`.  Since `|Fix(σ)| ∣ |A| = 2 ^ k`, we have
  `|Fix(σ)| = 2 ^ d` with `d ≤ k`; the congruence reads `2 ^ d ≡ 2 ^ k ≡ 1 (mod p)`, so
  `k ∣ d`, hence `d = 0` (the case `d = k` would force `σ = 1`).  Thus `σ` has no nontrivial
  fixed points.
* Applied to an invariant subgroup `W ≠ ⊥` (via the sub-`G`-action `invSubAction`): the fixed
  points on `W` are `W ∩ Fix(σ) = ⊥`, so `|W| ≡ 1 (mod p)`.  Writing `|W| = 2 ^ m` with `m ≤ k`,
  this gives `k ∣ m`, and `1 ≤ m ≤ k` forces `m = k`, i.e. `W = A`.

-/

namespace Work.ThmF.ChV12

/-- The subgroup of fixed points of an automorphism `σ` of a group `A`. -/
def fixedSubgroup {A : Type} [Group A] (σ : MulAut A) : Subgroup A where
  carrier := {a | σ a = a}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq] at ha hb ⊢
    rw [map_mul, ha, hb]
  inv_mem' := by
    intro a ha
    simp only [Set.mem_ofPred_eq] at ha ⊢
    rw [map_inv, ha]

@[simp]
lemma mem_fixedSubgroup {A : Type} [Group A] {σ : MulAut A} {a : A} :
    a ∈ fixedSubgroup σ ↔ σ a = a := Iff.rfl

/-- The fixed points of the cyclic group generated by `σ` on `A` are exactly the fixed points
of `σ`. -/
lemma fixedPoints_zpowers_eq {A : Type} [Group A] (σ : MulAut A) :
    MulAction.fixedPoints (Subgroup.zpowers σ) A = (fixedSubgroup σ : Set A) := by
  ext a
  rw [MulAction.mem_fixedPoints]
  constructor
  · intro h; exact h ⟨σ, Subgroup.mem_zpowers σ⟩
  · intro h g
    have h2 : Subgroup.zpowers σ ≤ MulAction.stabilizer (MulAut A) a := by
      rw [Subgroup.zpowers_le]; rwa [MulAction.mem_stabilizer_iff]
    exact h2 g.2

lemma card_fixedPoints_zpowers {A : Type} [Group A] (σ : MulAut A) :
    Nat.card (MulAction.fixedPoints (Subgroup.zpowers σ) A) = Nat.card (fixedSubgroup σ) := by
  rw [fixedPoints_zpowers_eq]; rfl

/-- If `σ : MulAut A` has order a prime `p` with `orderOf (2 : ZMod p) = k` and
`Nat.card A = 2 ^ k`, then `σ` has no nontrivial fixed points. -/
theorem fixedSubgroup_eq_bot {A : Type} [Group A] [Finite A] {k p : ℕ}
    (hk : Nat.card A = 2 ^ k) (hp : Nat.Prime p) (hord : orderOf (2 : ZMod p) = k)
    (σ : MulAut A) (hσ : orderOf σ = p) :
    fixedSubgroup σ = ⊥ := by
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  have hGcard : Nat.card (Subgroup.zpowers σ) = p := by
    rw [Nat.card_zpowers, hσ]
  have hGp : IsPGroup p (Subgroup.zpowers σ) :=
    IsPGroup.of_card (n := 1) (by rw [hGcard, pow_one])
  have hcong := IsPGroup.card_modEq_card_fixedPoints (p := p) hGp A
  rw [card_fixedPoints_zpowers σ] at hcong
  -- `hcong : Nat.card A ≡ Nat.card (fixedSubgroup σ) [MOD p]`
  have h1 : Nat.card (fixedSubgroup σ) ≡ 2 ^ k [MOD p] := by
    have := hcong.symm
    rwa [hk] at this
  have h2 : ((2 : ZMod p)) ^ k = 1 := by
    rw [← hord]; exact pow_orderOf_eq_one _
  have h3 : (Nat.card (fixedSubgroup σ) : ZMod p) = 1 := by
    have h4 : (Nat.card (fixedSubgroup σ) : ZMod p) = ((2 ^ k : ℕ) : ZMod p) :=
      (ZMod.natCast_eq_natCast_iff _ _ p).mpr h1
    rw [h4]
    simp only [Nat.cast_pow, Nat.cast_ofNat]
    exact h2
  have hdvd : Nat.card (fixedSubgroup σ) ∣ 2 ^ k := by
    rw [← hk]; exact Subgroup.card_subgroup_dvd_card _
  obtain ⟨d, hdk, hd⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  have h4 : ((2 : ZMod p)) ^ d = 1 := by
    have h5 : (Nat.card (fixedSubgroup σ) : ZMod p) = ((2 : ZMod p)) ^ d := by
      rw [hd]
      simp only [Nat.cast_pow, Nat.cast_ofNat]
    rw [← h5]; exact h3
  have hkd : k ∣ d := by
    rw [← hord]; exact orderOf_dvd_iff_pow_eq_one.mpr h4
  have hd0 : d = 0 := by
    rcases eq_or_ne d 0 with h | h
    · exact h
    · exfalso
      have hle : k ≤ d := Nat.le_of_dvd (Nat.pos_of_ne_zero h) hkd
      have hdk' : d = k := le_antisymm hdk hle
      have hFA : fixedSubgroup σ = ⊤ := by
        apply Subgroup.eq_top_of_card_eq
        rw [hd, hdk', ← hk]
      have hσ1 : σ = 1 := by
        apply MulEquiv.ext
        intro a
        have : a ∈ fixedSubgroup σ := by rw [hFA]; exact Subgroup.mem_top a
        exact this
      have : orderOf σ = 1 := by rw [hσ1]; exact orderOf_one
      rw [hσ] at this
      exact hp.ne_one this
  have : Nat.card (fixedSubgroup σ) = 1 := by rw [hd, hd0, pow_zero]
  exact Subgroup.eq_bot_of_card_eq _ this

/-- If `g` maps a subgroup `W` into itself, then so does `g⁻¹` (because `g` restricts to an
injective self-map of the finite group `W`). -/
lemma mulAut_symm_mapsInto {A : Type} [Group A] [Finite A] (g : MulAut A) (W : Subgroup A)
    (h : ∀ x ∈ W, g x ∈ W) : ∀ x ∈ W, g.symm x ∈ W := by
  have hle : Subgroup.map (g : A →* A) W ≤ W := by
    rintro y hy
    rw [Subgroup.mem_map] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact h x hx
  have hcard : Nat.card (Subgroup.map (g : A →* A) W) = Nat.card W :=
    Nat.card_congr (Subgroup.equivMapOfInjective W (g : A →* A) g.injective).toEquiv.symm
  have heq : Subgroup.map (g : A →* A) W = W :=
    Subgroup.eq_of_le_of_card_ge hle (by rw [hcard])
  intro x hx
  have hx' : x ∈ Subgroup.map (g : A →* A) W := by rw [heq]; exact hx
  rw [Subgroup.mem_map] at hx'
  obtain ⟨y, hy, hyx⟩ := hx'
  have : g.symm x = y := by rw [← hyx]; simp
  rw [this]; exact hy

/-- The subgroup of `MulAut A` consisting of the automorphisms mapping `W` into itself. -/
def mapsIntoSelf {A : Type} [Group A] [Finite A] (W : Subgroup A) : Subgroup (MulAut A) where
  carrier := {g | ∀ x ∈ W, g x ∈ W}
  one_mem' := by intro x hx; simpa using hx
  mul_mem' := by
    intro g h hg hh
    simp only [Set.mem_ofPred_eq] at hg hh ⊢
    intro x hx
    exact hg _ (hh x hx)
  inv_mem' := by
    intro g hg
    simp only [Set.mem_ofPred_eq] at hg ⊢
    exact mulAut_symm_mapsInto g W hg

/-- The invariant subgroup `W` of `A`, viewed as a `⟨σ⟩`-set (a `SubMulAction`). -/
def invSubAction {A : Type} [Group A] [Finite A] (σ : MulAut A) (W : Subgroup A)
    (hWinv : ∀ x ∈ W, σ x ∈ W) : SubMulAction (Subgroup.zpowers σ) A :=
  { carrier := (W : Set A)
    smul_mem' := fun g x hx =>
      ((Subgroup.zpowers_le (H := mapsIntoSelf W)).mpr hWinv) g.2 x hx }

/-- If `σ` has no nontrivial fixed points, then every `σ`-invariant subgroup is trivial or
everything. -/
theorem invariant_eq_top {A : Type} [Group A] [Finite A] {k p : ℕ}
    (hk : Nat.card A = 2 ^ k) (hp : Nat.Prime p) (hord : orderOf (2 : ZMod p) = k)
    (σ : MulAut A) (hσ : orderOf σ = p) (hFbot : fixedSubgroup σ = ⊥) :
    ∀ W : Subgroup A, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤ := by
  intro W hWne hWinv
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  have hGcard : Nat.card (Subgroup.zpowers σ) = p := by rw [Nat.card_zpowers, hσ]
  have hGp : IsPGroup p (Subgroup.zpowers σ) :=
    IsPGroup.of_card (n := 1) (by rw [hGcard, pow_one])
  -- the fixed points of the action on `W` are trivial
  have hfix :
      Nat.card (MulAction.fixedPoints (Subgroup.zpowers σ) ↥(invSubAction σ W hWinv)) = 1 := by
    let z : ↥(invSubAction σ W hWinv) := ⟨1, W.one_mem⟩
    have hval : ∀ x : MulAction.fixedPoints (Subgroup.zpowers σ) ↥(invSubAction σ W hWinv),
        (x.1 : A) = 1 := by
      intro x
      have h := congrArg Subtype.val (x.2 ⟨σ, Subgroup.mem_zpowers σ⟩)
      rw [SubMulAction.val_smul, Subgroup.smul_def] at h
      have h2 : σ (x.1 : A) = (x.1 : A) := h
      have : (x.1 : A) ∈ fixedSubgroup σ := h2
      rw [hFbot] at this
      simpa using this
    rw [Nat.card_eq_one_iff_unique]
    refine ⟨⟨fun x y => ?_⟩, ⟨⟨z, fun g => Subtype.ext ?_⟩⟩⟩
    · have hxz : x.1 = z := Subtype.ext (hval x)
      have hyz : y.1 = z := Subtype.ext (hval y)
      exact Subtype.ext (by rw [hxz, hyz])
    · rw [SubMulAction.val_smul, Subgroup.smul_def]; exact map_one (g : MulAut A)
  have hcong := IsPGroup.card_modEq_card_fixedPoints (p := p) hGp ↥(invSubAction σ W hWinv)
  rw [hfix] at hcong
  -- transport the count back to the subgroup `W`
  have hcardW : Nat.card ↥(invSubAction σ W hWinv) = Nat.card W := rfl
  rw [hcardW] at hcong
  -- `hcong : Nat.card W ≡ 1 [MOD p]`
  have hdvd : Nat.card W ∣ 2 ^ k := by
    rw [← hk]; exact Subgroup.card_subgroup_dvd_card W
  obtain ⟨m, hmk, hm⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  have hmod : 2 ^ m ≡ 1 [MOD p] := by rw [← hm]; exact hcong
  have hm0 : k ∣ m := by
    rw [← hord]
    refine orderOf_dvd_iff_pow_eq_one.mpr ?_
    have hc := (ZMod.natCast_eq_natCast_iff (2 ^ m : ℕ) 1 p).mpr hmod
    simpa only [Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one] using hc
  have hmpos : 1 ≤ m := by
    by_contra h
    rw [not_le] at h
    have hmz : m = 0 := Nat.lt_one_iff.mp h
    rw [hmz, pow_zero] at hm
    exact hWne (Subgroup.eq_bot_of_card_eq W hm)
  apply Subgroup.eq_top_of_card_eq
  rw [hm, le_antisymm hmk (Nat.le_of_dvd hmpos hm0), ← hk]

theorem irreducible_of_orderOf_prime {A : Type} [Group A] [Finite A]
    (hA2 : ∀ x : A, x * x = 1) (hAc : ∀ x y : A, x * y = y * x) {k p : ℕ}
    (hk : Nat.card A = 2 ^ k) (hp : Nat.Prime p) (hord : orderOf (2 : ZMod p) = k)
    (σ : MulAut A) (hσ : orderOf σ = p) :
    ∀ W : Subgroup A, W ≠ ⊥ → (∀ x ∈ W, σ x ∈ W) → W = ⊤ := by
  intro W hWne hWinv
  exact invariant_eq_top hk hp hord σ hσ
    (fixedSubgroup_eq_bot hk hp hord σ hσ) W hWne hWinv

