/-!
# `Work.ThmF.ChV12.L5Struct` — the Bruhat decomposition of `X = ⟨Q₀, K, t⟩`

Let `(H,Q,t,s)` satisfy `Hyp5` and let `B := Q₀sub H ⊔ Ksub H t` ("the Borel of `X`").
The main theorem `X5_eq_borel` of this file is

  `X5 H t = B ∪ B·t·B`   (as subsets of `G`),

the "two double cosets" statement underlying Peterfalvi II Ch. V §2, Lemma 5: it is what makes
`B = X5 ∩ H` a strongly embedded subgroup of `X5` with `X5` 2-transitive on `X5 ⧸ B`, and it is
the first half of the source's proof (`X = Q₀K ∪ Q₀KtQ₀`).

The mathematical inputs are exactly the ones available without Feit–Thompson:

* `t s t = s t s` (from `orderOf (s*t) = 3`);
* the elements of `K = J(D,t)` are inverted by `t` (`mem_Kset_iff`), and `K` acts regularly on
  `Q₀^# = Inv H` (`Work.ThmF.L5.Kset_regular`);
* the involutions of `H` commute (`Work.ThmF.L5.involutions_commute`), so `Q₀sub H = Q₀ H`.

From the regularity one gets the key relation

  `t (k s k⁻¹) t = (k⁻¹ s k · k⁻²) · t · (k⁻¹ s k)`   (`t_conj_Q0sub`),

which says `t Q₀ t ⊆ B · t · Q₀ ⊆ B ∪ B t B`; together with `t K t = K` this gives
`t B t ⊆ B ∪ B t B`, and then `B ∪ B t B` is closed under multiplication and inversion, hence is
the subgroup generated by `Q₀ ∪ K ∪ {t} = X5`.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option linter.unusedVariables false

open scoped Pointwise

open LeanEval.GroupTheory.Defs

namespace Work.ThmF.L5

open Submission.Blueprint

variable {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s : G}

/-! ## Elementary facts about `K = J(D,t)`, `Q₀` and `t` -/

/-- `t` is an involution inside `Hyp5`. -/
theorem ht_mul_self (h : Work.ThmF.Lemma5.Hyp5 H Q t s) : t * t = 1 := by
  have h1 : t ^ 2 = 1 := by simpa [h.split.invol] using pow_orderOf_eq_one t
  simpa [pow_two] using h1

theorem ht_inv (h : Work.ThmF.Lemma5.Hyp5 H Q t s) : t⁻¹ = t :=
  inv_eq_of_mul_eq_one_right (ht_mul_self h)

/-- Conjugating a product by the involution `t`. -/
theorem conj_mul (h : Work.ThmF.Lemma5.Hyp5 H Q t s) (a b : G) :
    t * (a * b) * t = (t * a * t) * (t * b * t) := by
  have ht := ht_mul_self h
  simp only [mul_assoc]
  rw [← mul_assoc t t (b * t), ht, one_mul]

/-- Conjugating an inverse by the involution `t`. -/
theorem conj_inv (h : Work.ThmF.Lemma5.Hyp5 H Q t s) (a : G) :
    t * a⁻¹ * t = (t * a * t)⁻¹ := by
  rw [mul_inv_rev, mul_inv_rev, ht_inv h]
  group

/-- `s` is an involution of `H`. -/
theorem s_mem_involutions (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    s ∈ Submission.Blueprint.involutions (H : Set G) :=
  ⟨h.split.le h.s_mem, h.s_inv⟩

/-- Conjugation by `t` inverts every element of `K = J(D,t)`. -/
theorem t_conj_Kset (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Kset H t) : t * k * t = k⁻¹ := by
  have h1 : t * k * t⁻¹ = k⁻¹ := (Work.ThmF.mem_Kset_iff.mp hk).2
  simpa [ht_inv h] using h1

/-- `Kset` is closed under inverses. -/
theorem Kset_inv_mem (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Kset H t) : k⁻¹ ∈ Work.ThmF.Kset H t := by
  obtain ⟨hkD, hkinv⟩ := Work.ThmF.mem_Kset_iff.mp hk
  refine Work.ThmF.mem_Kset_iff.mpr ⟨(twoPoint H t).inv_mem hkD, ?_⟩
  rw [show t * k⁻¹ * t⁻¹ = (t * k * t⁻¹)⁻¹ by group, hkinv]

/-- `Kset` is invariant under conjugation by `t`. -/
theorem t_conj_Kset_mem (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Kset H t) : t * k * t ∈ Work.ThmF.Kset H t := by
  rw [t_conj_Kset h hk]
  exact Kset_inv_mem h hk

/-- `Ksub` is invariant under conjugation by `t`. -/
theorem t_conj_Ksub_mem (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Ksub H t) : t * k * t ∈ Work.ThmF.Ksub H t := by
  refine Subgroup.closure_induction (p := fun x _ => t * x * t ∈ Work.ThmF.Ksub H t)
    (fun y hy => Work.ThmF.Kset_le_Ksub H t (t_conj_Kset_mem h hy)) ?_
    (fun a b _ _ iha ihb => ?_) (fun a _ iha => ?_) hk
  · rw [mul_one, ht_mul_self h]
    exact (Work.ThmF.Ksub H t).one_mem
  · rw [conj_mul h a b]
    exact (Work.ThmF.Ksub H t).mul_mem iha ihb
  · rw [conj_inv h a]
    exact (Work.ThmF.Ksub H t).inv_mem iha

/-- Conjugation by an element of `Kset` preserves `Q₀ = Inv H ∪ {1}`. -/
theorem Kset_conj_Q0 (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Kset H t) {q : G} (hq : q ∈ Work.ThmF.Q0 H) :
    k * q * k⁻¹ ∈ Work.ThmF.Q0 H := by
  have hkD : k ∈ twoPoint H t := (Work.ThmF.mem_Kset_iff.mp hk).1
  have hkH : k ∈ H := (Subgroup.mem_inf.mp hkD).1
  rcases hq with ⟨hqH, hq2⟩ | rfl
  · refine Or.inl ⟨H.mul_mem (H.mul_mem hkH hqH) (H.inv_mem hkH), ?_⟩
    rw [show k * q * k⁻¹ = (MulAut.conj k) q by rw [MulAut.conj_apply]]
    exact (orderOf_injective (MulAut.conj k).toMonoidHom (MulAut.conj k).injective q).trans hq2
  · simp

/-! ## `Q₀sub = Q₀` and the normaliser of `Q₀sub` -/

/-- Membership in `Q₀sub H` is membership in `Q₀ H`, when the involutions of `H` commute. -/
theorem mem_Q0sub_iff (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) (q : G) :
    q ∈ Work.ThmF.Q0sub H ↔ q ∈ Work.ThmF.Q0 H :=
  Set.ext_iff.mp (Q0sub_eq_Q0 (H := H) (involutions_commute h.sit hC4 h.split)) q

/-- `Ksub ≤ N_G(Q₀sub)`. -/
theorem Ksub_le_normalizer_Q0sub (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    Work.ThmF.Ksub H t ≤ Subgroup.normalizer (Work.ThmF.Q0sub H : Set G) := by
  refine (Subgroup.closure_le _).mpr ?_
  intro k hk
  change k ∈ Subgroup.normalizer (Work.ThmF.Q0sub H : Set G)
  rw [Subgroup.mem_normalizer_iff]
  intro q
  constructor
  · intro hq
    have hq0 : q ∈ Work.ThmF.Q0 H := (mem_Q0sub_iff hC4 h q).mp hq
    exact (mem_Q0sub_iff hC4 h _).mpr (Kset_conj_Q0 h hk hq0)
  · intro hq
    have hq0 : k * q * k⁻¹ ∈ Work.ThmF.Q0 H := (mem_Q0sub_iff hC4 h _).mp hq
    have h1 : k⁻¹ * (k * q * k⁻¹) * k ∈ Work.ThmF.Q0 H := by
      simpa using Kset_conj_Q0 h (Kset_inv_mem h hk) hq0
    have h2 : q ∈ Work.ThmF.Q0 H := by
      rwa [show k⁻¹ * (k * q * k⁻¹) * k = q by group] at h1
    exact (mem_Q0sub_iff hC4 h q).mpr h2

/-- A conjugate of `s` by an element of `Kset` lies in `Q₀sub`. -/
theorem conj_s_mem_Q0sub (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {k : G}
    (hk : k ∈ Work.ThmF.Kset H t) : k * s * k⁻¹ ∈ Work.ThmF.Q0sub H := by
  have hkD : k ∈ twoPoint H t := (Work.ThmF.mem_Kset_iff.mp hk).1
  have hkH : k ∈ H := (Subgroup.mem_inf.mp hkD).1
  refine Work.ThmF.Q0_le_Q0sub H (Or.inl ⟨?_, ?_⟩)
  · exact H.mul_mem (H.mul_mem hkH (s_mem_involutions h).1) (H.inv_mem hkH)
  · rw [show k * s * k⁻¹ = (MulAut.conj k) s by rw [MulAut.conj_apply]]
    exact (orderOf_injective (MulAut.conj k).toMonoidHom (MulAut.conj k).injective s).trans
      (s_mem_involutions h).2

/-- **The key relation.**  For `q ∈ Q₀^#` (with `q = k s k⁻¹`, `k ∈ K` the unique such element)
one has `t q t = (k⁻¹ s k · k⁻²) · t · (k⁻¹ s k)`; in particular `t q t ∈ B · t · Q₀` where
`B = Q₀sub H ⊔ Ksub H t`. -/
theorem t_conj_Q0sub (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {q : G}
    (hq : q ∈ Work.ThmF.Q0sub H) (hq1 : q ≠ 1) :
    ∃ m ∈ (Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t : Subgroup G),
      ∃ y ∈ Work.ThmF.Q0sub H, t * q * t = m * t * y := by
  have hq0 : q ∈ Work.ThmF.Q0 H := (mem_Q0sub_iff hC4 h q).mp hq
  have hqInv : q ∈ Submission.Blueprint.involutions (H : Set G) := by
    rcases hq0 with h' | h'
    · exact h'
    · exact absurd h' hq1
  obtain ⟨k, ⟨hkK, hkq⟩, -⟩ := Kset_regular h.split s (s_mem_involutions h) q hqInv
  have htk : t * k * t = k⁻¹ := t_conj_Kset h hkK
  have htik : t * k⁻¹ * t = k := by
    rw [conj_inv h k, htk, inv_inv]
  have hy : k⁻¹ * s * k ∈ Work.ThmF.Q0sub H := by
    have hki : k⁻¹ ∈ Work.ThmF.Kset H t := Kset_inv_mem h hkK
    have h1 : k⁻¹ * s * (k⁻¹)⁻¹ ∈ Work.ThmF.Q0sub H := conj_s_mem_Q0sub h hki
    rwa [inv_inv] at h1
  refine ⟨(k⁻¹ * s * k) * (k ^ 2)⁻¹, ?_, k⁻¹ * s * k, hy, ?_⟩
  · have h1 : k⁻¹ * s * k ∈ (Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t : Subgroup G) :=
      (le_sup_left : (Work.ThmF.Q0sub H : Subgroup G) ≤
        (Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t : Subgroup G)) hy
    have h2 : (k ^ 2)⁻¹ ∈ (Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t : Subgroup G) :=
      (le_sup_right : (Work.ThmF.Ksub H t : Subgroup G) ≤
        (Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t : Subgroup G))
        ((Work.ThmF.Ksub H t).inv_mem
          ((Work.ThmF.Ksub H t).pow_mem (Work.ThmF.Kset_le_Ksub H t hkK) 2))
    exact (Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t).mul_mem h1 h2
  · have hsts : t * s * t = s * t * s := Work.ThmF.Lemma5.tst_eq_sts h
    have hkey : k⁻¹ * t * k⁻¹ = t := by
      have h1 : t * k⁻¹ = k * t := by
        calc t * k⁻¹ = t * (t * k * t) := by rw [← htk]
          _ = (t * t) * (k * t) := by group
          _ = k * t := by rw [ht_mul_self h, one_mul]
      calc k⁻¹ * t * k⁻¹ = k⁻¹ * (t * k⁻¹) := by group
        _ = k⁻¹ * (k * t) := by rw [h1]
        _ = t := by group
    have hkk : k * (k ^ 2)⁻¹ = k⁻¹ := by
      rw [pow_two, mul_inv_rev]
      group
    have hsimp : (k⁻¹ * s * k) * (k ^ 2)⁻¹ = k⁻¹ * s * k⁻¹ := by
      rw [mul_assoc (k⁻¹ * s) k (k ^ 2)⁻¹, hkk]
    have hfinal : ((k⁻¹ * s * k) * (k ^ 2)⁻¹) * t * (k⁻¹ * s * k) = k⁻¹ * s * t * s * k := by
      rw [hsimp]
      calc (k⁻¹ * s * k⁻¹) * t * (k⁻¹ * s * k)
          = k⁻¹ * s * (k⁻¹ * t * k⁻¹) * s * k := by group
        _ = k⁻¹ * s * t * s * k := by rw [hkey]
    have h1 : t * q * t = k⁻¹ * s * t * s * k := by
      have hqq : k * s * k⁻¹ = k * (s * k⁻¹) := by group
      rw [← hkq, hqq, conj_mul h k (s * k⁻¹), conj_mul h s k⁻¹, htk, hsts, htik]
      group
    exact h1.trans hfinal.symm


/-! ## `Inv H ⊆ Q`, `Q₀ ⊆ Q` -/

/-- The involutions of `H` lie in `Q` (since `H = Q ⋊ D` with `D` of odd order). -/
theorem involution_mem_Q (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {x : G}
    (hx : x ∈ Submission.Blueprint.involutions (H : Set G)) : x ∈ Q := by
  obtain ⟨hxH, hx2⟩ := hx
  obtain ⟨p, hp, -⟩ := Work.ThmF.split_exists_unique_factor h.split hxH
  obtain ⟨hd, hq, hdq⟩ := hp
  have hdH : p.1 ∈ H := (inf_le_left : twoPoint H t ≤ H) hd
  have hsq : p.1 * p.2 * (p.1 * p.2) = 1 := by
    have h1 : x * x = 1 := by rw [← pow_two, ← hx2]; exact pow_orderOf_eq_one x
    rw [hdq]
    exact h1
  have hdN : p.1⁻¹ ∈ Subgroup.normalizer (Q : Set G) :=
    (Subgroup.normalizer (Q : Set G)).inv_mem (h.split.normal hdH)
  have hqdq : p.1⁻¹ * p.2 * p.1 ∈ Q := by
    simpa using (Subgroup.mem_normalizer_iff.mp hdN p.2).mp hq
  have hsq2 : p.1 * p.1 * (p.1⁻¹ * p.2 * p.1) * p.2 = 1 := by
    rw [← hsq]
    group
  have hd2Q : p.1 ^ 2 ∈ Q := by
    have h1 : p.1 * p.1 = ((p.1⁻¹ * p.2 * p.1) * p.2)⁻¹ := by
      calc p.1 * p.1 = (p.1 * p.1 * (p.1⁻¹ * p.2 * p.1) * p.2) *
            ((p.1⁻¹ * p.2 * p.1) * p.2)⁻¹ := by group
        _ = 1 * ((p.1⁻¹ * p.2 * p.1) * p.2)⁻¹ := by rw [hsq2]
        _ = ((p.1⁻¹ * p.2 * p.1) * p.2)⁻¹ := by rw [one_mul]
    rw [pow_two, h1]
    exact Q.inv_mem (Q.mul_mem hqdq hq)
  have hd2bot : p.1 ^ 2 ∈ (⊥ : Subgroup G) := by
    have h5 : p.1 ^ 2 ∈ Q ⊓ twoPoint H t := ⟨hd2Q, (twoPoint H t).pow_mem hd 2⟩
    rwa [h.split.inf_eq] at h5
  have hd2 : p.1 ^ 2 = 1 := Subgroup.mem_bot.mp hd2bot
  have hd1 : p.1 = 1 := by
    have hdvd : orderOf p.1 ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hd2
    have hodd : Odd (orderOf p.1) :=
      Odd.of_dvd_nat (Work.ThmF.split_odd_card_twoPoint h.split)
        (Subgroup.orderOf_dvd_natCard (twoPoint H t) hd)
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h1
    · exact orderOf_eq_one_iff.mp h1
    · rw [h1] at hodd
      exact absurd hodd (Nat.not_odd_iff_even.mpr even_two)
  rw [← hdq, hd1, one_mul]
  exact hq

/-- `Q₀ ⊆ Q`. -/
theorem Q0_le_Q (h : Work.ThmF.Lemma5.Hyp5 H Q t s) : Work.ThmF.Q0 H ⊆ Q := by
  intro x hx
  rw [Work.ThmF.mem_Q0_iff] at hx
  rcases hx with ⟨hxH, hx2⟩ | rfl
  · exact involution_mem_Q h ⟨hxH, hx2⟩
  · exact Q.one_mem

/-- `Q₀sub ≤ Q`. -/
theorem Q0sub_le_Q (h : Work.ThmF.Lemma5.Hyp5 H Q t s) : Work.ThmF.Q0sub H ≤ Q :=
  (Subgroup.closure_le Q).mpr (Q0_le_Q h)

/-! ## The subgroup `B ∪ B t B` -/

/-- The "Borel" `B = Q₀sub H ⊔ Ksub H t` as a subgroup of `G`. -/
abbrev bor (H : Subgroup G) (t : G) : Subgroup G := Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t

/-- The candidate subgroup `B ∪ B t B`. -/
def Zset (H : Subgroup G) (t : G) : Set G :=
  {x : G | x ∈ bor H t ∨ ∃ b₁ ∈ bor H t, ∃ b₂ ∈ bor H t, x = b₁ * t * b₂}

theorem mem_Zset_bor {H : Subgroup G} {t z : G} (hz : z ∈ bor H t) : z ∈ Zset H t := Or.inl hz

theorem mem_Zset_mul {H : Subgroup G} {t a b z : G} (ha : a ∈ bor H t) (hb : b ∈ bor H t)
    (h : z = a * t * b) : z ∈ Zset H t := Or.inr ⟨a, ha, b, hb, h⟩

/-- Every element of `B` is a product `k * q` with `q ∈ Q₀sub`, `k ∈ Ksub`. -/
theorem bor_factor (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {y : G}
    (hy : y ∈ bor H t) : ∃ q ∈ Work.ThmF.Q0sub H, ∃ k ∈ Work.ThmF.Ksub H t, k * q = y := by
  have hKN : Work.ThmF.Ksub H t ≤ Subgroup.normalizer (Work.ThmF.Q0sub H : Set G) :=
    Ksub_le_normalizer_Q0sub hC4 h
  have hN : ∀ c ∈ Work.ThmF.Ksub H t, ∀ a ∈ Work.ThmF.Q0sub H,
      c * a * c⁻¹ ∈ Work.ThmF.Q0sub H ∧ c⁻¹ * a * c ∈ Work.ThmF.Q0sub H := by
    intro c hc a ha
    refine ⟨?_, ?_⟩
    · exact (Subgroup.mem_normalizer_iff.mp (hKN hc) a).mp ha
    · have h1 := (Subgroup.mem_normalizer_iff.mp (hKN ((Work.ThmF.Ksub H t).inv_mem hc)) a).mp ha
      simpa using h1
  change y ∈ Work.ThmF.Q0sub H ⊔ Work.ThmF.Ksub H t at hy
  rw [Subgroup.sup_eq_closure] at hy
  refine Subgroup.closure_induction
    (p := fun y _ => ∃ q ∈ Work.ThmF.Q0sub H, ∃ k ∈ Work.ThmF.Ksub H t, k * q = y)
    (fun z hz => ?_) ?_ (fun a b _ _ iha ihb => ?_) (fun a _ iha => ?_) hy
  · rcases hz with hz | hz
    · exact ⟨z, hz, 1, (Work.ThmF.Ksub H t).one_mem, one_mul z⟩
    · exact ⟨1, (Work.ThmF.Q0sub H).one_mem, z, hz, mul_one z⟩
  · exact ⟨1, (Work.ThmF.Q0sub H).one_mem, 1, (Work.ThmF.Ksub H t).one_mem, one_mul 1⟩
  · obtain ⟨q₁, hq₁, k₁, hk₁, hkq₁⟩ := iha
    obtain ⟨q₂, hq₂, k₂, hk₂, hkq₂⟩ := ihb
    refine ⟨k₂⁻¹ * q₁ * k₂ * q₂, (Work.ThmF.Q0sub H).mul_mem (hN k₂ hk₂ q₁ hq₁).2 hq₂,
      k₁ * k₂, (Work.ThmF.Ksub H t).mul_mem hk₁ hk₂, ?_⟩
    rw [← hkq₁, ← hkq₂]
    group
  · obtain ⟨q, hq, k, hk, hkq⟩ := iha
    refine ⟨k * q⁻¹ * k⁻¹, (hN k hk q⁻¹ ((Work.ThmF.Q0sub H).inv_mem hq)).1,
      k⁻¹, (Work.ThmF.Ksub H t).inv_mem hk, ?_⟩
    rw [← hkq]
    group

/-- **`t B t ⊆ B ∪ B t B`.** -/
theorem t_conj_bor (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {b : G}
    (hb : b ∈ bor H t) : t * b * t ∈ Zset H t := by
  obtain ⟨q, hq, k, hk, hkq⟩ := bor_factor hC4 h hb
  have htk : t * k * t ∈ Work.ThmF.Ksub H t := t_conj_Ksub_mem h hk
  have htkB : t * k * t ∈ bor H t :=
    (le_sup_right : (Work.ThmF.Ksub H t : Subgroup G) ≤ bor H t) htk
  rcases eq_or_ne q 1 with hq1 | hq1
  · have h1 : t * b * t = t * k * t := by rw [← hkq, hq1, mul_one]
    rw [h1]
    exact mem_Zset_bor htkB
  · obtain ⟨m, hm, y, hy, hmy⟩ := t_conj_Q0sub hC4 h hq hq1
    have hyB : y ∈ bor H t := (le_sup_left : (Work.ThmF.Q0sub H : Subgroup G) ≤ bor H t) hy
    have hkm : (t * k * t) * m ∈ bor H t := (bor H t).mul_mem htkB hm
    refine mem_Zset_mul hkm hyB ?_
    rw [← hkq, show t * (k * q) * t = (t * k * t) * (t * q * t) from conj_mul h k q, hmy]
    group

/-- `Zset` is closed under multiplication. -/
theorem Zset_mul_mem (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {x y : G}
    (hx : x ∈ Zset H t) (hy : y ∈ Zset H t) : x * y ∈ Zset H t := by
  rcases hx with hx | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rcases hy with hy | ⟨c₁, hc₁, c₂, hc₂, rfl⟩
    · exact mem_Zset_bor ((bor H t).mul_mem hx hy)
    · refine mem_Zset_mul ((bor H t).mul_mem hx hc₁) hc₂ ?_
      group
  · rcases hy with hy | ⟨c₁, hc₁, c₂, hc₂, rfl⟩
    · refine mem_Zset_mul hb₁ ((bor H t).mul_mem hb₂ hy) ?_
      group
    · have h1 : t * (b₂ * c₁) * t ∈ Zset H t := t_conj_bor hC4 h ((bor H t).mul_mem hb₂ hc₁)
      rcases h1 with h1 | ⟨d₁, hd₁, d₂, hd₂, h1eq⟩
      · refine mem_Zset_bor ?_
        rw [show (b₁ * t * b₂) * (c₁ * t * c₂) = b₁ * (t * (b₂ * c₁) * t) * c₂ by group]
        exact (bor H t).mul_mem ((bor H t).mul_mem hb₁ h1) hc₂
      · refine mem_Zset_mul ((bor H t).mul_mem hb₁ hd₁) ((bor H t).mul_mem hd₂ hc₂) ?_
        rw [show (b₁ * t * b₂) * (c₁ * t * c₂) = b₁ * (t * (b₂ * c₁) * t) * c₂ by group, h1eq]
        group

/-- `Zset` is closed under inverses. -/
theorem Zset_inv_mem (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) {x : G}
    (hx : x ∈ Zset H t) : x⁻¹ ∈ Zset H t := by
  rcases hx with hx | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · exact mem_Zset_bor ((bor H t).inv_mem hx)
  · refine mem_Zset_mul ((bor H t).inv_mem hb₂) ((bor H t).inv_mem hb₁) ?_
    rw [show (b₁ * t * b₂)⁻¹ = b₂⁻¹ * t⁻¹ * b₁⁻¹ by group]
    rw [ht_inv h]

/-- `Zset` is a subgroup of `G`. -/
def Zsub (H : Subgroup G) (t : G) (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    Subgroup G where
  carrier := Zset H t
  mul_mem' := Zset_mul_mem hC4 h
  one_mem' := mem_Zset_bor (bor H t).one_mem
  inv_mem' := Zset_inv_mem hC4 h

/-- `Zset = X5 H t`. -/
theorem X5_eq_Zset (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    (Work.ThmF.Lemma5.X5 H t : Set G) = Zset H t := by
  have hBX : bor H t ≤ Work.ThmF.Lemma5.X5 H t := by
    refine sup_le ?_ ?_
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Q0_subset_X5 H t hz)
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Kset_subset_X5 H t hz)
  have htX : t ∈ Work.ThmF.Lemma5.X5 H t := Work.ThmF.Lemma5.t_mem_X5 H t
  refine Set.Subset.antisymm ?_ ?_
  · refine (Subgroup.closure_le (Zsub H t hC4 h)).mpr ?_
    intro z hz
    rcases hz with hz | hz
    · rcases hz with hz | hz
      · exact mem_Zset_bor ((le_sup_left : (Work.ThmF.Q0sub H : Subgroup G) ≤ bor H t)
          (Work.ThmF.Q0_le_Q0sub H hz))
      · exact mem_Zset_bor ((le_sup_right : (Work.ThmF.Ksub H t : Subgroup G) ≤ bor H t)
          (Work.ThmF.Kset_le_Ksub H t hz))
    · rw [hz]
      exact mem_Zset_mul (bor H t).one_mem (bor H t).one_mem (by group)
  · intro z hz
    rcases hz with hz | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    · exact hBX hz
    · exact (Work.ThmF.Lemma5.X5 H t).mul_mem
        ((Work.ThmF.Lemma5.X5 H t).mul_mem (hBX hb₁) htX) (hBX hb₂)

/-- **The Bruhat decomposition of `X = ⟨Q₀,K,t⟩`**: `X = B ∪ B t B`. -/
theorem X5_eq_borel (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    (Work.ThmF.Lemma5.X5 H t : Set G) =
      ((bor H t : Subgroup G) : Set G) ∪
        (((bor H t : Subgroup G) : Set G) * ({t} : Set G) * (((bor H t : Subgroup G) : Set G))) := by
  rw [X5_eq_Zset hC4 h]
  refine Set.Subset.antisymm ?_ ?_
  · intro z hz
    rcases hz with hz | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    · exact Or.inl hz
    · refine Or.inr ?_
      rw [Set.mem_mul]
      exact ⟨b₁ * t, by rw [Set.mem_mul]; exact ⟨b₁, hb₁, t, rfl, rfl⟩, b₂, hb₂, rfl⟩
  · intro z hz
    rcases hz with hz | hz
    · exact Or.inl hz
    · rw [Set.mem_mul] at hz
      obtain ⟨a, ha, b₂, hb₂, rfl⟩ := hz
      rw [Set.mem_mul] at ha
      obtain ⟨b₁, hb₁, c, hc, hac⟩ := ha
      rw [Set.mem_singleton_iff] at hc
      subst hc
      refine Or.inr ⟨b₁, hb₁, b₂, hb₂, ?_⟩
      rw [← hac]

/-- `X5 ∩ H = B`. -/
theorem X5_inf_H (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    Work.ThmF.Lemma5.X5 H t ⊓ H = bor H t := by
  have hBX : bor H t ≤ Work.ThmF.Lemma5.X5 H t := by
    refine sup_le ?_ ?_
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Q0_subset_X5 H t hz)
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Kset_subset_X5 H t hz)
  have hBH : bor H t ≤ H :=
    sup_le (Work.ThmF.Q0sub_le H) ((Work.ThmF.Ksub_le_twoPoint (H := H) t).trans inf_le_left)
  refine le_antisymm ?_ (le_inf hBX hBH)
  intro z hz
  obtain ⟨hzX, hzH⟩ := Subgroup.mem_inf.mp hz
  have hz' : z ∈ Zset H t := by
    rw [← X5_eq_Zset hC4 h]; exact hzX
  rcases hz' with hz' | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · exact hz'
  · exfalso
    have h1 : t ∈ H := by
      have h2 := H.mul_mem (H.mul_mem (H.inv_mem (hBH hb₁)) hzH) (H.inv_mem (hBH hb₂))
      rwa [show b₁⁻¹ * (b₁ * t * b₂) * b₂⁻¹ = t by group] at h2
    exact h.split.not_mem h1

/-- `B ∩ Q = Q₀sub`. -/
theorem Q_inf_bor (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    bor H t ⊓ Q = Work.ThmF.Q0sub H := by
  refine le_antisymm ?_ ?_
  · intro z hz
    obtain ⟨hzb, hzQ⟩ := Subgroup.mem_inf.mp hz
    obtain ⟨q, hq, k, hk, hkq⟩ := bor_factor hC4 h hzb
    have hkQ : k ∈ Q := by
      have h1 : k = z * q⁻¹ := by rw [← hkq]; group
      rw [h1]
      exact Q.mul_mem hzQ (Q.inv_mem (Q0sub_le_Q h hq))
    have hkD : k ∈ twoPoint H t := Work.ThmF.Ksub_le_twoPoint (H := H) t hk
    have hkbot : k ∈ (⊥ : Subgroup G) := by
      have h2 : k ∈ Q ⊓ twoPoint H t := ⟨hkQ, hkD⟩
      rwa [h.split.inf_eq] at h2
    have hk1 : k = 1 := Subgroup.mem_bot.mp hkbot
    rw [hk1, one_mul] at hkq
    rw [← hkq]
    exact hq
  · exact le_inf ((le_sup_left : (Work.ThmF.Q0sub H : Subgroup G) ≤ bor H t))
      (Q0sub_le_Q h)

/-- `B ∩ D = Ksub`. -/
theorem D_inf_bor (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    bor H t ⊓ twoPoint H t = Work.ThmF.Ksub H t := by
  refine le_antisymm ?_ ?_
  · intro z hz
    obtain ⟨hzb, hzD⟩ := Subgroup.mem_inf.mp hz
    obtain ⟨q, hq, k, hk, hkq⟩ := bor_factor hC4 h hzb
    have hkD : k ∈ twoPoint H t := Work.ThmF.Ksub_le_twoPoint (H := H) t hk
    have hqD : q ∈ twoPoint H t := by
      have h1 : q = k⁻¹ * z := by rw [← hkq]; group
      rw [h1]
      exact (twoPoint H t).mul_mem ((twoPoint H t).inv_mem hkD) hzD
    have hqbot : q ∈ (⊥ : Subgroup G) := by
      have h2 : q ∈ Q ⊓ twoPoint H t := ⟨Q0sub_le_Q h hq, hqD⟩
      rwa [h.split.inf_eq] at h2
    have hq1 : q = 1 := Subgroup.mem_bot.mp hqbot
    rw [hq1, mul_one] at hkq
    rw [← hkq]
    exact hk
  · exact le_inf ((le_sup_right : (Work.ThmF.Ksub H t : Subgroup G) ≤ bor H t))
      (Work.ThmF.Ksub_le_twoPoint (H := H) t)

/-- `X5 ∩ Q = Q₀sub`. -/
theorem X5_inf_Q (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    Work.ThmF.Lemma5.X5 H t ⊓ Q = Work.ThmF.Q0sub H := by
  have hBX : bor H t ≤ Work.ThmF.Lemma5.X5 H t := by
    refine sup_le ?_ ?_
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Q0_subset_X5 H t hz)
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Kset_subset_X5 H t hz)
  have hBH : bor H t ≤ H :=
    sup_le (Work.ThmF.Q0sub_le H) ((Work.ThmF.Ksub_le_twoPoint (H := H) t).trans inf_le_left)
  have hBX5 : Work.ThmF.Q0sub H ≤ Work.ThmF.Lemma5.X5 H t :=
    (le_sup_left : (Work.ThmF.Q0sub H : Subgroup G) ≤ bor H t) |>.trans hBX
  refine le_antisymm ?_ (le_inf hBX5 (Q0sub_le_Q h))
  intro z hz
  obtain ⟨hzX, hzQ⟩ := Subgroup.mem_inf.mp hz
  have hz' : z ∈ Zset H t := by
    rw [← X5_eq_Zset hC4 h]; exact hzX
  rcases hz' with hz' | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · have : z ∈ bor H t ⊓ Q := ⟨hz', hzQ⟩
    rwa [Q_inf_bor hC4 h] at this
  · exfalso
    have h1 : t ∈ H := by
      have hzH : b₁ * t * b₂ ∈ H := h.split.le hzQ
      have h2 := H.mul_mem (H.mul_mem (H.inv_mem (hBH hb₁)) hzH) (H.inv_mem (hBH hb₂))
      rwa [show b₁⁻¹ * (b₁ * t * b₂) * b₂⁻¹ = t by group] at h2
    exact h.split.not_mem h1

/-- `X5 ∩ D = Ksub`. -/
theorem X5_inf_D (hC4 : ChIIFourProp) (h : Work.ThmF.Lemma5.Hyp5 H Q t s) :
    Work.ThmF.Lemma5.X5 H t ⊓ twoPoint H t = Work.ThmF.Ksub H t := by
  have hBX : bor H t ≤ Work.ThmF.Lemma5.X5 H t := by
    refine sup_le ?_ ?_
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Q0_subset_X5 H t hz)
    · exact (Subgroup.closure_le _).mpr (fun z hz => Work.ThmF.Lemma5.Kset_subset_X5 H t hz)
  have hBX5 : Work.ThmF.Ksub H t ≤ Work.ThmF.Lemma5.X5 H t :=
    (le_sup_right : (Work.ThmF.Ksub H t : Subgroup G) ≤ bor H t) |>.trans hBX
  refine le_antisymm ?_ (le_inf hBX5 (Work.ThmF.Ksub_le_twoPoint (H := H) t))
  intro z hz
  obtain ⟨hzX, hzD⟩ := Subgroup.mem_inf.mp hz
  have hz' : z ∈ Zset H t := by
    rw [← X5_eq_Zset hC4 h]; exact hzX
  rcases hz' with hz' | ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · have : z ∈ bor H t ⊓ twoPoint H t := ⟨hz', hzD⟩
    rwa [D_inf_bor hC4 h] at this
  · exfalso
    have hBH : bor H t ≤ H :=
      sup_le (Work.ThmF.Q0sub_le H) ((Work.ThmF.Ksub_le_twoPoint (H := H) t).trans inf_le_left)
    have hzD : b₁ * t * b₂ ∈ twoPoint H t := (inf_le_right : _ ≤ twoPoint H t) hz
    have hzH : b₁ * t * b₂ ∈ H := (inf_le_left : twoPoint H t ≤ H) hzD
    have h1 : t ∈ H := by
      have h2 := H.mul_mem (H.mul_mem (H.inv_mem (hBH hb₁)) hzH) (H.inv_mem (hBH hb₂))
      rwa [show b₁⁻¹ * (b₁ * t * b₂) * b₂⁻¹ = t by group] at h2
    exact h.split.not_mem h1

end Work.ThmF.L5
