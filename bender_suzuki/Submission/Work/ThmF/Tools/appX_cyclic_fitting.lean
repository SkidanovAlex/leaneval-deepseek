/-!
# `F(G)` is cyclic when all its `p`-cores are

Let `G` be a finite group such that `O_p(G)` is cyclic for every prime `p` dividing `|G|`.
The Fitting subgroup of `G` is generated by these `p`-cores
(`Work.Fitting.fitting_eq_iSup_pCore`),

  `F(G) = ⨆_{p ∣ |G|} O_p(G)`,

for `p ≠ q` the subgroups `O_p(G)` and `O_q(G)` commute (they are normal and disjoint, being a
`p`-group and a `q`-group), and their orders are pairwise coprime.  Consequently

* `|F(G)| = ∏_{p ∣ |G|} |O_p(G)|` (`card_fitting_eq_prod_card_pCore`);
* if `g_p` generates `O_p(G)`, then `g = ∏_p g_p` has order `∏_p |O_p(G)| = |F(G)|`
  (`orderOf_noncommProd`), and `g ∈ F(G)`.

Hence `〈g〉 ≤ F(G)` has the same cardinality as `F(G)`, so `〈g〉 = F(G)` and `F(G)` is cyclic.
-/

noncomputable section

open scoped Classical

namespace Work.ThmF.Tools

/-- The order of a product of pairwise commuting elements of pairwise coprime order is the
product of the orders.

This is proved by induction on the finite set, using the two-element case
`Commute.orderOf_mul_eq_mul_orderOf_of_coprime`. -/
theorem orderOf_noncommProd {M : Type*} [Monoid M] {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι → M) (comm : (s : Set ι).Pairwise (Function.onFun Commute f))
    (hcop : (s : Set ι).Pairwise (Function.onFun Nat.Coprime (fun a => orderOf (f a)))) :
    orderOf (s.noncommProd f comm) = ∏ a ∈ s, orderOf (f a) := by
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.noncommProd_insert_of_notMem s a f comm ha]
    set c' := comm.mono (fun _ => Finset.mem_insert_of_mem) with hc'
    have hcop' : (s : Set ι).Pairwise (Function.onFun Nat.Coprime (fun a => orderOf (f a))) :=
      fun x hx y hy hxy => hcop (Finset.mem_insert_of_mem hx) (Finset.mem_insert_of_mem hy) hxy
    have hne : ∀ b ∈ s, a ≠ b := fun b hb hab => ha (hab.symm ▸ hb)
    have hcommA : Commute (f a) (s.noncommProd f c') :=
      Finset.noncommProd_commute s f c' (f a)
        (fun b hb => comm (Finset.mem_insert_self a s) (Finset.mem_insert_of_mem hb) (hne b hb))
    have hco : (orderOf (f a)).Coprime (orderOf (s.noncommProd f c')) := by
      rw [ih c' hcop']
      exact Nat.Coprime.prod_right fun b hb =>
        hcop (Finset.mem_insert_self a s) (Finset.mem_insert_of_mem hb) (hne b hb)
    rw [Commute.orderOf_mul_eq_mul_orderOf_of_coprime hcommA hco, ih c' hcop',
      Finset.prod_insert ha]

/-- In a finite group, the order of the Fitting subgroup is the product of the orders of the
`p`-cores `O_p(G)`, `p` ranging over the prime divisors of `|G|`.

The `p`-cores are normal subgroups of pairwise coprime order, hence independent, so the product
map `∏_p O_p(G) → F(G)` is a bijection. -/
theorem card_fitting_eq_prod_card_pCore (G : Type) [Group G] [Finite G] :
    Nat.card ↥(Work.Fitting.fitting G) =
      ∏ p : ↑(Nat.card G).primeFactors, Nat.card ↥(Work.Fitting.pCore (p : ℕ) G) := by
  classical
  have hcomm : Pairwise fun p q : ↑(Nat.card G).primeFactors =>
      ∀ x y : G, x ∈ Work.Fitting.pCore (p : ℕ) G →
        y ∈ Work.Fitting.pCore (q : ℕ) G → Commute x y := by
    intro p q hpq
    have hp : (p : ℕ).Prime := Nat.prime_of_mem_primeFactors p.2
    have hq : (q : ℕ).Prime := Nat.prime_of_mem_primeFactors q.2
    haveI : Fact (p : ℕ).Prime := ⟨hp⟩
    haveI : Fact (q : ℕ).Prime := ⟨hq⟩
    have hne : (p : ℕ) ≠ (q : ℕ) := fun hh => hpq (Subtype.ext hh)
    exact Subgroup.commute_of_normal_of_disjoint _ _ inferInstance inferInstance
      (IsPGroup.disjoint_of_ne (p : ℕ) (q : ℕ) hne _ _
        (Work.Fitting.isPGroup_pCore hp) (Work.Fitting.isPGroup_pCore hq))
  have hfin : ∀ p : ↑(Nat.card G).primeFactors,
      Fintype ↥(Work.Fitting.pCore (p : ℕ) G) := fun p => Fintype.ofFinite _
  haveI := hfin
  have hinj : Function.Injective (Subgroup.noncommPiCoprod hcomm) := by
    apply Subgroup.injective_noncommPiCoprod_of_iSupIndep
    apply Subgroup.independent_of_coprime_order hcomm
    intro p q hpq
    have hp : (p : ℕ).Prime := Nat.prime_of_mem_primeFactors p.2
    have hq : (q : ℕ).Prime := Nat.prime_of_mem_primeFactors q.2
    haveI : Fact (p : ℕ).Prime := ⟨hp⟩
    haveI : Fact (q : ℕ).Prime := ⟨hq⟩
    have hne : (p : ℕ) ≠ (q : ℕ) := fun hh => hpq (Subtype.ext hh)
    simp only [← Nat.card_eq_fintype_card]
    exact IsPGroup.coprime_card_of_ne (p : ℕ) (q : ℕ) hne _ _
      (Work.Fitting.isPGroup_pCore hp) (Work.Fitting.isPGroup_pCore hq)
  have hrange : (Subgroup.noncommPiCoprod hcomm).range = Work.Fitting.fitting G := by
    rw [Subgroup.noncommPiCoprod_range, iSup_subtype, ← Work.Fitting.fitting_eq_iSup_pCore G]
  set f := Subgroup.noncommPiCoprod hcomm with hf
  have hbij : Function.Bijective f.rangeRestrict :=
    ⟨fun x y hxy => hinj (by simpa using congrArg Subtype.val hxy),
      f.rangeRestrict_surjective⟩
  let e : ((p : ↑(Nat.card G).primeFactors) → ↥(Work.Fitting.pCore (p : ℕ) G)) ≃* ↥f.range :=
    MulEquiv.ofBijective f.rangeRestrict hbij
  calc Nat.card ↥(Work.Fitting.fitting G)
      = Nat.card ↥f.range := by rw [hrange]
    _ = Nat.card ((p : ↑(Nat.card G).primeFactors) → ↥(Work.Fitting.pCore (p : ℕ) G)) :=
        (Nat.card_congr e.toEquiv).symm
    _ = ∏ p : ↑(Nat.card G).primeFactors, Nat.card ↥(Work.Fitting.pCore (p : ℕ) G) := Nat.card_pi

/-- **Main result.**  If `O_p(G)` is cyclic for every prime `p` dividing `|G|`, then the Fitting
subgroup `F(G)` is cyclic.

Indeed `F(G) = ⨆_p O_p(G)`, the `p`-cores are normal with pairwise coprime orders, and the
product of generators `g_p` of the `p`-cores is an element of `F(G)` of order
`∏_p |O_p(G)| = |F(G)|`. -/
theorem appX_cyclic_fitting {G : Type} [Group G] [Finite G]
    (h : ∀ p ∈ (Nat.card G).primeFactors, IsCyclic ↥(Work.Fitting.pCore p G)) :
    IsCyclic ↥(Work.Fitting.fitting G) := by
  classical
  haveI hcyc : ∀ p : ↑(Nat.card G).primeFactors,
      IsCyclic ↥(Work.Fitting.pCore (p : ℕ) G) := fun p => h (p : ℕ) p.2
  have hcomm : Pairwise fun p q : ↑(Nat.card G).primeFactors =>
      ∀ x y : G, x ∈ Work.Fitting.pCore (p : ℕ) G →
        y ∈ Work.Fitting.pCore (q : ℕ) G → Commute x y := by
    intro p q hpq
    have hp : (p : ℕ).Prime := Nat.prime_of_mem_primeFactors p.2
    have hq : (q : ℕ).Prime := Nat.prime_of_mem_primeFactors q.2
    haveI : Fact (p : ℕ).Prime := ⟨hp⟩
    haveI : Fact (q : ℕ).Prime := ⟨hq⟩
    have hne : (p : ℕ) ≠ (q : ℕ) := fun hh => hpq (Subtype.ext hh)
    exact Subgroup.commute_of_normal_of_disjoint _ _ inferInstance inferInstance
      (IsPGroup.disjoint_of_ne (p : ℕ) (q : ℕ) hne _ _
        (Work.Fitting.isPGroup_pCore hp) (Work.Fitting.isPGroup_pCore hq))
  -- a generator of each `p`-core, whose order is therefore the order of that core
  have hgen : ∀ p : ↑(Nat.card G).primeFactors,
      ∃ g : ↥(Work.Fitting.pCore (p : ℕ) G),
        orderOf g = Nat.card ↥(Work.Fitting.pCore (p : ℕ) G) := by
    intro p
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥(Work.Fitting.pCore (p : ℕ) G))
    exact ⟨g, orderOf_eq_card_of_forall_mem_zpowers hg⟩
  choose gp hgp using hgen
  -- the product of the generators, an element of `G`
  set gcomm : ((Finset.univ : Finset ↑(Nat.card G).primeFactors) : Set _).Pairwise
      (Function.onFun Commute fun p : ↑(Nat.card G).primeFactors => (gp p : G)) :=
    fun p _ q _ hpq => hcomm hpq (gp p) (gp q) (gp p).2 (gp q).2 with hgcomm_def
  set g : G := (Finset.univ : Finset ↑(Nat.card G).primeFactors).noncommProd
      (fun p => (gp p : G)) gcomm with hg_def
  have hgF : g ∈ Work.Fitting.fitting G := by
    rw [hg_def]
    exact Subgroup.noncommProd_mem _ gcomm
      (fun p _ => Work.Fitting.pCore_le_fitting G (p : ℕ) (gp p).2)
  -- the order of `g` is the product of the orders of the `p`-cores
  have hcoporders : ((Finset.univ : Finset ↑(Nat.card G).primeFactors) : Set _).Pairwise
      (Function.onFun Nat.Coprime fun p : ↑(Nat.card G).primeFactors => orderOf (gp p : G)) := by
    intro p _ q _ hpq
    have hp : (p : ℕ).Prime := Nat.prime_of_mem_primeFactors p.2
    have hq : (q : ℕ).Prime := Nat.prime_of_mem_primeFactors q.2
    haveI : Fact (p : ℕ).Prime := ⟨hp⟩
    haveI : Fact (q : ℕ).Prime := ⟨hq⟩
    have hne : (p : ℕ) ≠ (q : ℕ) := fun hh => hpq (Subtype.ext hh)
    show Nat.Coprime (orderOf (gp p : G)) (orderOf (gp q : G))
    rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe, hgp p, hgp q]
    exact IsPGroup.coprime_card_of_ne (p : ℕ) (q : ℕ) hne _ _
      (Work.Fitting.isPGroup_pCore hp) (Work.Fitting.isPGroup_pCore hq)
  have horder : orderOf g =
      ∏ p : ↑(Nat.card G).primeFactors, Nat.card ↥(Work.Fitting.pCore (p : ℕ) G) := by
    rw [hg_def, orderOf_noncommProd (s := (Finset.univ : Finset ↑(Nat.card G).primeFactors))
      (f := fun p => (gp p : G)) (comm := gcomm) (hcop := hcoporders)]
    exact Finset.prod_congr rfl fun p _ => by rw [Subgroup.orderOf_coe, hgp p]
  have hcard := card_fitting_eq_prod_card_pCore G
  -- the cyclic subgroup generated by `g` has the cardinality of `F(G)`
  have htop : Subgroup.zpowers (⟨g, hgF⟩ : ↥(Work.Fitting.fitting G)) = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers, ← Subgroup.orderOf_coe, horder]
    exact hcard.symm
  exact isCyclic_iff_exists_zpowers_eq_top.mpr ⟨⟨g, hgF⟩, htop⟩

end Work.ThmF.Tools
