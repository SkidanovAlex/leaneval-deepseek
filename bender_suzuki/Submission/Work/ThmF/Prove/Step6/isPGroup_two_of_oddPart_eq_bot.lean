/-!
# `O_{2'}(X) = 1` forces `X` to be a `2`-group

`Work.ThmF.oddPart X = O_{2'}(X)` is the subgroup of `G` generated by the elements of `X`
of odd order (Peterfalvi's `Q₁`).  For a finite `X` the vanishing of `O_{2'}(X)` means
exactly that `X` is a `2`-group: `isPGroup_two_of_oddPart_eq_bot`.

The argument is Cauchy's theorem plus the definition of `oddPart`:

* if a prime `q ∣ |X|` were different from `2`, Cauchy would produce `g ∈ X` of order `q`;
  `q` is then odd, so `g ∈ O_{2'}(X) = ⊥`, i.e. `g = 1`, contradicting `orderOf g = q ≠ 1`;
* hence `2` is the unique prime divisor of `|X|`, so `|X| = 2 ^ k`
  (`Nat.eq_prime_pow_of_unique_prime_dvd`), and a finite group whose order is a power of `2`
  is a `2`-group (`IsPGroup.iff_card`).
-/

namespace Work.ThmF.Prove.Step6

/-- If `O_{2'}(X) = oddPart X` is trivial, then every element of `X` has `2`-power order:
`X` is a `2`-group. -/
theorem isPGroup_two_of_oddPart_eq_bot {G : Type} [Group G] [Finite G] (X : Subgroup G)
    (h : Work.ThmF.oddPart X = ⊥) : IsPGroup 2 ↥X := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  -- It suffices to know that the order of `X` is a power of `2`.
  rw [IsPGroup.iff_card]
  haveI : Fintype ↥X := Fintype.ofFinite ↥X
  refine ⟨(Nat.card ↥X).primeFactorsList.length,
    Nat.eq_prime_pow_of_unique_prime_dvd Nat.card_pos.ne' ?_⟩
  -- Every prime divisor `q` of `|X|` is `2`.
  intro q hq hdvd
  have hdvd' : q ∣ Fintype.card ↥X := by rwa [← Nat.card_eq_fintype_card]
  haveI : Fact (Nat.Prime q) := ⟨hq⟩
  -- Cauchy's theorem: an element of order `q` exists in `X`.
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card q hdvd'
  by_contra hq2
  -- That element has odd order `q`, hence lies in `O_{2'}(X) = ⊥`.
  have hodd : Odd (orderOf (g : G)) := by
    rw [Subgroup.orderOf_coe, hg]
    exact hq.odd_of_ne_two hq2
  have hx : (g : G) ∈ Work.ThmF.oddPart X := Work.ThmF.mem_oddPart_of_odd X g.2 hodd
  have hx1 : (g : G) = 1 := Subgroup.mem_bot.mp (h ▸ hx)
  -- So `g = 1` and `q = orderOf g = 1`, contradicting primality of `q`.
  have hg1 : g = 1 := Subtype.ext hx1
  rw [hg1] at hg
  simp at hg
  exact hq.ne_one hg.symm

end Work.ThmF.Prove.Step6
