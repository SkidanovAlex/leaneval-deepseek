import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.ThmF.Prove

/-- If `w * g * w⁻¹ = g ^ l`, then `(g ^ k * w) ^ n = g ^ (k * ∑_{i<n} l ^ i) * w ^ n`.

This is the standard "conjugate-power" bookkeeping identity: `w` acts on the cyclic
subgroup generated by `g` by the `l`-th-power map, and the accumulated exponent over
`n` copies of `w` is the geometric sum `1 + l + ⋯ + l ^ (n-1)`. -/
theorem powMulZpow {G : Type*} [Group G] {g w : G} {l : ℤ}
    (hl : w * g * w⁻¹ = g ^ l) (k : ℤ) (n : ℕ) :
    (g ^ k * w) ^ n = g ^ (k * ∑ i ∈ Finset.range n, l ^ i) * w ^ n := by
  -- Conjugation by `w ^ m` raises `g` to the power `l ^ m`.
  have hmain : ∀ m : ℕ, ((MulAut.conj w) ^ m) g = g ^ (l ^ m) := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, MulAut.mul_apply, MulAut.conj_apply, hl, map_zpow, ih, ← zpow_mul,
        pow_succ]
  -- Conjugation by `w ^ m` sends `g ^ a` to `g ^ (l ^ m * a)`.
  have hconj : ∀ (m : ℕ) (a : ℤ), w ^ m * g ^ a * (w ^ m)⁻¹ = g ^ (l ^ m * a) := by
    intro m a
    have key : MulAut.conj (w ^ m) = (MulAut.conj w) ^ m := map_pow (MulAut.conj) w m
    have hg : (MulAut.conj (w ^ m)) g = g ^ (l ^ m) := by rw [key, hmain m]
    calc w ^ m * g ^ a * (w ^ m)⁻¹ = (MulAut.conj (w ^ m)) (g ^ a) := by
          rw [MulAut.conj_apply]
      _ = ((MulAut.conj (w ^ m)) g) ^ a := by rw [map_zpow]
      _ = (g ^ (l ^ m)) ^ a := by rw [hg]
      _ = g ^ (l ^ m * a) := by rw [← zpow_mul]
  -- Moving `w ^ m` past `g ^ k`.
  have hshift : ∀ m : ℕ, w ^ m * g ^ k = g ^ (l ^ m * k) * w ^ m := by
    intro m
    have h := hconj m k
    have heq : w ^ m * g ^ k = (w ^ m * g ^ k * (w ^ m)⁻¹) * w ^ m := by group
    rw [heq, h]
  induction n with
  | zero => simp
  | succ n ih =>
    have hexp : k * (∑ i ∈ Finset.range n, l ^ i) + l ^ n * k
        = k * (∑ i ∈ Finset.range (n + 1), l ^ i) := by
      rw [Finset.sum_range_succ]
      ring
    calc (g ^ k * w) ^ (n + 1)
        = (g ^ k * w) ^ n * (g ^ k * w) := by rw [pow_succ]
      _ = (g ^ (k * ∑ i ∈ Finset.range n, l ^ i) * w ^ n) * (g ^ k * w) := by rw [ih]
      _ = g ^ (k * ∑ i ∈ Finset.range n, l ^ i) * g ^ (l ^ n * k) * w ^ n * w := by
            rw [show (g ^ (k * ∑ i ∈ Finset.range n, l ^ i) * w ^ n) * (g ^ k * w)
                  = g ^ (k * ∑ i ∈ Finset.range n, l ^ i) * (w ^ n * g ^ k) * w from
                by group]
            rw [hshift n]
            group
      _ = g ^ ((k * ∑ i ∈ Finset.range n, l ^ i) + l ^ n * k) * w ^ (n + 1) := by
            rw [← zpow_add, mul_assoc, ← pow_succ]
      _ = g ^ (k * ∑ i ∈ Finset.range (n + 1), l ^ i) * w ^ (n + 1) := by rw [hexp]

end Work.ThmF.Prove
