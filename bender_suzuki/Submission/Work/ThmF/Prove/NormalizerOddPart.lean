namespace Work.ThmF.Prove

/-- A subgroup of `G` that normalizes `Q` also normalizes `O_{2'}(Q)`.

`O_{2'}(Q)` is generated by the odd-order elements of `Q`; conjugation maps that generating
set into itself because it preserves `Q` (by hypothesis) and preserves element orders.  Hence
`N(Q)` normalizes the subgroup the generating set spans, i.e. `oddPart Q`.

The statement is the `Work.ThmF` instance of `Work.ThmG.oddPart_le_normalizer`: the two
`oddPart` definitions coincide, so the `ThmG` lemma applies verbatim with `H = N(Q)`. -/
theorem NormalizerOddPart {G : Type} [Group G] (Q : Subgroup G) :
    Subgroup.normalizer (Q : Set G) ≤
      Subgroup.normalizer (((Work.ThmF.oddPart Q)) : Set G) :=
  Work.ThmG.oddPart_le_normalizer le_rfl

end Work.ThmF.Prove
