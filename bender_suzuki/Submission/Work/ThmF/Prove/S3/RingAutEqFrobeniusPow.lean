namespace Work.ThmF.Prove.S3

/-- Over a finite field `F` of prime characteristic `ℓ`, the group of ring automorphisms is
cyclic, generated by the Frobenius `x ↦ x ^ ℓ`. This is the classical fact that
`Gal(F / 𝔽_ℓ)` is cyclic of order `[F : 𝔽_ℓ]`, generated by the Frobenius automorphism. -/
theorem ringAut_eq_frobenius_pow {F : Type} [Field F] [Fintype F] {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hchar : CharP F ℓ) (σ : F ≃+* F) : ∃ i : ℕ, ∀ x : F, σ x = x ^ ℓ ^ i := by
  classical
  -- View `F` as an algebra over its prime field `𝔽_ℓ = ZMod ℓ`.
  letI : Fact ℓ.Prime := ⟨hℓ⟩
  letI : Algebra (ZMod ℓ) F := ZMod.algebra F ℓ
  -- Any ring automorphism of `F` fixes the prime field, i.e. commutes with `algebraMap`.
  have hfix : ∀ x : ZMod ℓ, σ (algebraMap (ZMod ℓ) F x) = algebraMap (ZMod ℓ) F x := by
    intro x
    obtain ⟨k, rfl⟩ := ZMod.intCast_surjective x
    have h : (algebraMap (ZMod ℓ) F) (k : ZMod ℓ) = (k : F) := ZMod.cast_intCast' k
    rw [h]
    exact map_intCast σ k
  -- Promote `σ` to a `ZMod ℓ`-algebra automorphism of `F`.
  let τ : F ≃ₐ[ZMod ℓ] F := AlgEquiv.ofRingEquiv (f := σ) hfix
  -- The Frobenius generates `Gal(F/ZMod ℓ)`; its powers run over all `ZMod ℓ`-algebra
  -- automorphisms.
  obtain ⟨i, hi⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod ℓ) F).2 τ
  refine ⟨i.1, fun x => ?_⟩
  -- The `i`-th power of the Frobenius is `x ↦ x ^ (ℓ ^ i)`.
  have hχ : (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod ℓ) F ^ i.1) x = x ^ ℓ ^ i.1 := by
    rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate, ZMod.card]
  have hi' : τ = FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod ℓ) F ^ i.1 := hi.symm
  have hτ : τ x = x ^ ℓ ^ i.1 := by rw [hi']; exact hχ
  rw [show σ x = τ x from rfl, hτ]

end Work.ThmF.Prove.S3
