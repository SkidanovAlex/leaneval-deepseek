/-- **N1.** In the standing context, step (3)'s output rules out `p = |P|` dividing `|Q|`:
if `z ∈ Q` had order `p` it would be an odd-order element, hence lie in `O_{2'}(Q)`, and step (3)
at `ℓ = p` would give `p ≠ p`. -/
theorem not_dvd_card_Q {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G}
    {P : Subgroup G} (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h3 : Step3Out Q P) :
    ¬ Nat.card P ∣ Nat.card Q := by
  intro hdvd
  have hp : (Nat.card P).Prime := c.P_prime
  have hpodd : Odd (Nat.card P) :=
    Nat.odd_iff.mpr (hp.eq_two_or_odd.resolve_left (Work.S3.P_card_ne_two c))
  have hfact : Fact (Nat.card P).Prime := ⟨hp⟩
  obtain ⟨z, hz⟩ := @exists_prime_orderOf_dvd_card' ↥Q _ _ (Nat.card P) hfact hdvd
  have hzG : orderOf ((z : Q) : G) = Nat.card P := by rw [Subgroup.orderOf_coe, hz]
  have hzmem : ((z : Q) : G) ∈ Work.ThmF.oddPart Q :=
    Work.ThmF.mem_oddPart_of_odd Q z.2 (by rw [hzG]; exact hpodd)
  have hpQ1 : Nat.card P ∣ Nat.card ↥(Work.ThmF.oddPart Q) := by
    have hle : Subgroup.zpowers (((z : Q) : G)) ≤ Work.ThmF.oddPart Q :=
      Subgroup.zpowers_le.mpr hzmem
    have hcard : Nat.card ↥(Subgroup.zpowers (((z : Q) : G))) = Nat.card P := by
      rw [Nat.card_zpowers, hzG]
    have hdvd' := Subgroup.card_subgroup_dvd_card
      ((Subgroup.zpowers (((z : Q) : G))).subgroupOf (Work.ThmF.oddPart Q))
    have heq : Nat.card ↥((Subgroup.zpowers (((z : Q) : G))).subgroupOf (Work.ThmF.oddPart Q))
        = Nat.card ↥(Subgroup.zpowers (((z : Q) : G))) :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv
    rw [heq, hcard] at hdvd'
    exact hdvd'
  exact absurd rfl (h3 (Nat.card P) hp hpQ1).2

/-- `W = C_V(K)` normalises `O_{2'}(Q)`: `W ≤ D ≤ H` and `H` normalises `Q`, while `O_{2'}(Q)` is
the subgroup generated by the odd-order elements of `Q`, a characteristic subgroup of `Q`. -/
theorem W_le_normalizer_oddPart {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G}
    {P : Subgroup G} (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    Work.ThmF.W H t ≤ Subgroup.normalizer (Work.ThmF.oddPart Q : Set G) := by
  rw [Subgroup.le_normalizer_iff]
  intro w hw x hx
  exact Work.ThmF.ChV3.conj_mem_oddPart
    (le_trans (le_trans (Work.ThmF.W_le_centD H t) inf_le_left) inf_le_left hw)
    c.split.normal hx

/-- A finite group with a normal subgroup of odd prime index `p` and even order is not simple.
(Used to turn `HasNormalIndexP p G` into `False`.) -/
theorem simple_not_hasNormalIndexP {G : Type} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hs : IsSimpleGroup G) (heven : Even (Nat.card G)) :
    ¬ Work.ThmF.HasNormalIndexP p G := by
  rintro ⟨K, hKn, hKi⟩
  haveI : K.Normal := hKn
  have hpodd : Odd p := Nat.odd_iff.mpr (hp.eq_two_or_odd.resolve_left hp2)
  rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal _ _ _ K hKn with h | h
  · rw [h, Subgroup.index_bot] at hKi
    rw [hKi] at heven
    exact (Nat.not_even_iff_odd.mpr hpodd) heven
  · rw [h, Subgroup.index_top] at hKi
    exact hp.ne_one hKi.symm

theorem step9X {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G} {P : Subgroup G}
    (hC4 : Submission.Blueprint.ChIIFourProp)
    (hHW : Work.ThmF.HallWielandtProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P)
    (h3 : Work.ThmF.Prove.Step3Out Q P) (h8 : Work.ThmF.Prove.Step8Out H Q t P)
    (hQ1 : Work.ThmF.oddPart Q ≠ ⊥)
    (hG : Nat.card G = (Nat.card Q + 1) * Nat.card ↥H)
    (hH : Nat.card ↥H = Nat.card Q * Nat.card ↥(Submission.Blueprint.twoPoint H t))
    (hD : Nat.card ↥(Submission.Blueprint.twoPoint H t) =
      (2 ^ Nat.card P - 1) * Nat.card ↥(Work.ThmF.W H t) * Nat.card P)
    (hV : Nat.card ↥(Submission.Blueprint.centD H t) = Nat.card ↥(Work.ThmF.W H t) * Nat.card P)
    (hPW : P ⊓ Work.ThmF.W H t = ⊥)
    (hWV : ∀ a ∈ Submission.Blueprint.centD H t, ∀ b ∈ Work.ThmF.W H t,
      a * b * a⁻¹ ∈ Work.ThmF.W H t)
    (hfpfW : ∀ w ∈ Work.ThmF.W H t, w ≠ 1 →
      Work.ThmF.oddPart Q ⊓ Subgroup.centralizer ({w} : Set G) = ⊥)
    (hVW : ∀ a ∈ Submission.Blueprint.centD H t, ∀ b ∈ Submission.Blueprint.centD H t,
      a * b * a⁻¹ * b⁻¹ ∈ Work.ThmF.W H t)
    (hL2b : ∀ X : Subgroup G, X ≤ Submission.Blueprint.centD H t → X ≠ ⊥ →
      Subgroup.normalizer (X : Set G) =
        Subgroup.centralizer (X : Set G) ⊔ (Submission.Blueprint.centD H t ⊓ Subgroup.normalizer (X : Set G))) :
    Nat.card P ∣ Nat.card (G ⧸ H) := by
  classical
  set p : ℕ := Nat.card P with hp_def
  have hp : p.Prime := c.P_prime
  have hp2 : p ≠ 2 := Work.S3.P_card_ne_two c
  haveI : Fact p.Prime := ⟨hp⟩
  by_contra hX
  -- ## (N1) and (N2)
  have hpQ : ¬ p ∣ Nat.card Q := not_dvd_card_Q c h3
  have hfac : (Nat.card ↥(Submission.Blueprint.centD H t)).factorization p =
      (Nat.card G).factorization p := step9N2 hp hpQ hG hH hD hV hX
  -- ## abbreviations
  set V : Subgroup G := Submission.Blueprint.centD H t with hVdef
  set W : Subgroup G := Work.ThmF.W H t with hWdef
  have hWleV : W ≤ V := Work.ThmF.W_le_centD H t
  have hWVn : V ≤ Subgroup.normalizer (W : Set G) := Subgroup.le_normalizer_iff.mpr hWV
  have hVcard : Nat.card ↥V = Nat.card ↥W * p := hV
  have hPV : P ≤ V := c.P_le
  have hPcard : Nat.card ↥P = p := hp_def.symm
  have hPW' : P ⊓ W = ⊥ := hPW
  have hVW' : ∀ a ∈ V, ∀ b ∈ V, a * b * a⁻¹ * b⁻¹ ∈ W := hVW
  -- ## a Sylow `p`-subgroup `S` of `G` with `P ≤ S ≤ V`
  have hPsubV : IsPGroup p ↥(P.subgroupOf V) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [pow_one]
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe c.P_le).toEquiv]
  obtain ⟨S0, hPS0⟩ := IsPGroup.exists_le_sylow hPsubV
  let Sval : Subgroup G := (S0 : Subgroup ↥V).map V.subtype
  have hSvalcard : Nat.card ↥Sval = p ^ (Nat.card G).factorization p := by
    show Nat.card ↥((S0 : Subgroup ↥V).map V.subtype) = p ^ (Nat.card G).factorization p
    rw [Subgroup.card_map_of_injective V.subtype_injective, Sylow.card_eq_multiplicity, hfac]
  let S : Sylow p G := Sylow.ofCard Sval hSvalcard
  have hScoe : (S : Subgroup G) = Sval := Sylow.coe_ofCard Sval hSvalcard
  have hScard : Nat.card ↥(S : Subgroup G) = p ^ (Nat.card G).factorization p := by
    rw [hScoe]; exact hSvalcard
  have hSV : (S : Subgroup G) ≤ V := by
    rw [hScoe]
    intro x hx
    obtain ⟨y, -, rfl⟩ := Subgroup.mem_map.mp hx
    exact y.2
  have hPS : P ≤ (S : Subgroup G) := by
    rw [hScoe]
    intro x hx
    exact Subgroup.mem_map.mpr
      ⟨⟨x, c.P_le hx⟩, hPS0 (Subgroup.mem_subgroupOf.mpr hx), rfl⟩
  -- ## `T = S ⊓ W`
  set T : Subgroup G := (S : Subgroup G) ⊓ W with hTdef
  have hTW : T ≤ W := inf_le_right
  have hTS : T ≤ (S : Subgroup G) := inf_le_left
  have hTp : IsPGroup p T := S.isPGroup'.to_le hTS
  have hTQ : T ≤ Subgroup.normalizer (Work.ThmF.oddPart Q : Set G) :=
    le_trans hTW (W_le_normalizer_oddPart c)
  have hnotpQ1 : ¬ p ∣ Nat.card ↥(Work.ThmF.oddPart Q) := fun h =>
    hpQ (Nat.dvd_trans h (Subgroup.card_dvd_of_le (Work.ThmF.oddPart_le Q)))
  have hTcyc : IsCyclic ↥T := step9N3a hp hp2 hTW hTp hQ1 hnotpQ1 hTQ hfpfW
  -- ## `S = T ⋊ P`
  obtain ⟨hrelT, hSTP⟩ :
      ((S : Subgroup G) ⊓ W).relIndex (S : Subgroup G) = p ∧
        (S : Subgroup G) = ((S : Subgroup G) ⊓ W) ⊔ P :=
    step9SylowW hp hWleV hWVn hVcard hPV hPcard hPW' S hPS hSV
  -- ## a generator `y` of `P`
  obtain ⟨y0, hy0ord⟩ := @exists_prime_orderOf_dvd_card' ↥P _ _ p ⟨hp⟩ (dvd_refl p)
  let y : G := (y0 : G)
  have hyP : y ∈ P := y0.2
  have hordy : orderOf y = p := by
    show orderOf ((y0 : ↥P) : G) = p
    rw [Subgroup.orderOf_coe, hy0ord]
  have hygen : P = Subgroup.zpowers y := by
    have hle : Subgroup.zpowers y ≤ P := Subgroup.zpowers_le.mpr hyP
    have hcard : Nat.card ↥(Subgroup.zpowers y) = Nat.card ↥P := by
      rw [Nat.card_zpowers, hordy]
    exact (Subgroup.eq_of_le_of_card_ge hle (le_of_eq hcard.symm)).symm
  have hSzy : (S : Subgroup G) = T ⊔ Subgroup.zpowers y := by
    rw [hSTP, hygen]
  have hyS : y ∈ (S : Subgroup G) := by
    rw [hSzy]; exact Subgroup.mem_sup_right (Subgroup.mem_zpowers y)
  have hy1 : y ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hordy
    exact hp.ne_one hordy.symm
  have hyT : y ∉ T := by
    intro hy
    have h2 : y ∈ P ⊓ W := ⟨hyP, hTW hy⟩
    rw [hPW'] at h2
    exact hy1 (Subgroup.mem_bot.mp h2)
  -- ## `|C_T(y)| ≤ p`
  have hC : Nat.card ↥(T ⊓ Subgroup.centralizer ({y} : Set G)) ≤ p := by
    have hle1 : T ⊓ Subgroup.centralizer ({y} : Set G) ≤ Work.ThmF.ChV3.Sig H t P := by
      intro x hx
      obtain ⟨hxT, hxc⟩ := Subgroup.mem_inf.mp hx
      refine Subgroup.mem_inf.mpr ⟨hTW hxT, ?_⟩
      rw [Subgroup.mem_centralizer_iff]
      intro q hq
      have hqy : q ∈ Subgroup.zpowers y := by rw [← hygen]; exact hq
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hqy
      have hxy : Commute x y := Subgroup.mem_centralizer_singleton_iff.mp hxc
      rw [← hk]
      exact ((Commute.zpow_right hxy k).eq).symm
    have hdvd1 : Nat.card ↥(T ⊓ Subgroup.centralizer ({y} : Set G)) ∣
        Nat.card ↥(Work.ThmF.ChV3.Sig H t P) := Subgroup.card_dvd_of_le hle1
    rcases eq_or_ne (Work.ThmF.ChV3.Sig H t P) ⊥ with hSig | hSig
    · rw [hSig, Subgroup.card_bot, Nat.dvd_one] at hdvd1
      rw [hdvd1]; exact hp.one_le
    · have hprime := (h8 hSig).1
      rcases (Nat.dvd_prime hprime).mp hdvd1 with h1 | h1
      · rw [h1]; exact hp.one_le
      · rw [h1]
        have hdvdT1 : Nat.card ↥(T ⊓ Subgroup.centralizer ({y} : Set G)) ∣ Nat.card ↥T :=
          Subgroup.card_dvd_of_le inf_le_left
        obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hTp
        have hpk : Nat.card ↥(Work.ThmF.ChV3.Sig H t P) ∣ p ^ k := by
          rw [h1, hk] at hdvdT1; exact hdvdT1
        have hdvd2 : Nat.card ↥(Work.ThmF.ChV3.Sig H t P) ∣ p := hprime.dvd_of_dvd_pow hpk
        rcases (Nat.dvd_prime hp).mp hdvd2 with h2 | h2
        · exact absurd h2 hprime.ne_one
        · exact le_of_eq h2
  -- ## `Ω₁(S) = C_T(y) ⊔ ⟨y⟩` is abelian
  have hTn : ∀ g ∈ (S : Subgroup G), ∀ x ∈ T, g * x * g⁻¹ ∈ T := by
    intro g hg x hx
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · exact (S : Subgroup G).mul_mem ((S : Subgroup G).mul_mem hg (hTS hx))
        ((S : Subgroup G).inv_mem hg)
    · exact Subgroup.le_normalizer_iff.mp hWVn g (hSV hg) x (hTW hx)
  obtain ⟨hAi, hAab'⟩ :=
    step9Omega1 (S := (S : Subgroup G)) (T := T) (y := y)
      hp hp2 hyS hyT hordy hTcyc hTp hTn hSzy hC
  set Z : Subgroup G := T ⊓ Subgroup.centralizer ({y} : Set G) with hZdef
  set A : Subgroup G := Z ⊔ Subgroup.zpowers y with hAdef
  have hAi' : ∀ x ∈ (S : Subgroup G), x ^ p = 1 ↔ x ∈ A := hAi
  have hZA : Z ≤ A := by rw [hAdef]; exact le_sup_left
  have hAleS : A ≤ (S : Subgroup G) := by
    rw [hAdef]
    exact sup_le (le_trans inf_le_left hTS) (by rw [hSzy]; exact le_sup_right)
  have hZleS : Z ≤ (S : Subgroup G) := le_trans hZA hAleS
  have hAleV : A ≤ V := le_trans hAleS hSV
  have hAne : A ≠ ⊥ := by
    intro h
    have hyA : y ∈ A := by rw [hAdef]; exact Subgroup.mem_sup_right (Subgroup.mem_zpowers y)
    rw [h] at hyA
    exact hy1 (Subgroup.mem_bot.mp hyA)
  have hAab : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := hAab'
  -- `A ⊓ W = Z`
  have hAinfW : A ⊓ W = Z := by
    refine le_antisymm ?_ ?_
    · intro x hx
      obtain ⟨hxA, hxW⟩ := Subgroup.mem_inf.mp hx
      have hyZ : Subgroup.zpowers y ≤ Subgroup.normalizer (Z : Set G) := by
        rw [Subgroup.le_normalizer_iff]
        intro w hw z hz
        obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hw
        rw [← hk]
        have hzy : z * y = y * z :=
          Subgroup.mem_centralizer_singleton_iff.mp (Subgroup.mem_inf.mp hz).2
        have hzc : Commute y z := hzy.symm
        rw [(hzc.zpow_left k).eq, mul_inv_cancel_right]
        exact hz
      have hdec : ∀ s : G, s ∈ A ↔ ∃ z ∈ Z, ∃ w ∈ Subgroup.zpowers y, z * w = s := by
        intro s
        rw [hAdef, ← SetLike.mem_coe,
          Subgroup.coe_mul_of_right_le_normalizer_left Z (Subgroup.zpowers y) hyZ]
        exact Set.mem_mul
      obtain ⟨z, hz, w, hw, hzw⟩ := (hdec x).mp hxA
      have hzW : z ∈ W := hTW (Subgroup.mem_inf.mp hz).1
      have hwW : w ∈ W := by
        have hweq : w = z⁻¹ * (z * w) := by group
        rw [hweq]
        exact W.mul_mem (W.inv_mem hzW) (hzw ▸ hxW)
      have hwP : w ∈ P := by rw [hygen]; exact hw
      have hwbot : w ∈ P ⊓ W := ⟨hwP, hwW⟩
      rw [hPW'] at hwbot
      have hw1 : w = 1 := Subgroup.mem_bot.mp hwbot
      rw [← hzw, hw1, mul_one]
      exact hz
    · intro x hx
      exact Subgroup.mem_inf.mpr ⟨hZA hx, hTW (Subgroup.mem_inf.mp hx).1⟩
  -- ## the commutator `[S,S]` lies in `Z`
  have hcommSZ : ∀ a ∈ (S : Subgroup G), ∀ b ∈ (S : Subgroup G),
      a * b * a⁻¹ * b⁻¹ ∈ Z :=
    step9Omega2 (S := (S : Subgroup G)) (T := T) (y := y)
      hp hp2 hSzy hTn hTcyc hTp hyT hordy hC
  -- ## `N_G(S) ≤ N_G(A)`, where `A = Ω₁(S)`
  have hAlchar : Subgroup.normalizer ((S : Subgroup G) : Set G) ≤
      Subgroup.normalizer (A : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro g hg a ha
    have hgN : g ∈ Subgroup.normalizer ((S : Subgroup G) : Set G) := hg
    have haS : a ∈ (S : Subgroup G) := hAleS ha
    have hgaS : g * a * g⁻¹ ∈ (S : Subgroup G) :=
      (Subgroup.mem_normalizer_iff.mp hgN a).mp haS
    have hap : a ^ p = 1 := (hAi' a haS).mpr ha
    refine (hAi' (g * a * g⁻¹) hgaS).mp ?_
    have hmap : (g * a * g⁻¹) ^ p = (MulAut.conj g) (a ^ p) := by
      rw [map_pow]; rfl
    rw [hmap, hap, map_one]
  have hSN : (S : Subgroup G) ≤ Subgroup.normalizer (A : Set G) :=
    fun g hg => hAlchar (Subgroup.le_normalizer (H := (S : Subgroup G)) hg)
  -- ## Hall–Wielandt in `G` with `A`
  have hwc : ∀ g : G, A.map (MulAut.conj g).toMonoidHom ≤ (S : Subgroup G) →
      A.map (MulAut.conj g).toMonoidHom = A := by
    intro g hg
    have hle : A.map (MulAut.conj g).toMonoidHom ≤ A := by
      intro x hx
      obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hx
      have hxS : g * a * g⁻¹ ∈ (S : Subgroup G) := hg (Subgroup.mem_map.mpr ⟨a, ha, rfl⟩)
      refine (hAi' (g * a * g⁻¹) hxS).mp ?_
      have hmap : (g * a * g⁻¹) ^ p = (MulAut.conj g) (a ^ p) := by rw [map_pow]; rfl
      rw [hmap, (hAi' a (hAleS ha)).mpr ha, map_one]
    exact Subgroup.eq_of_le_of_card_ge hle (le_of_eq
      (Subgroup.card_map_of_injective (f := (MulAut.conj g).toMonoidHom)
        (MulAut.conj g).injective).symm)
  have hHW1 := hHW G p hp S A hAleS hwc hAab
  set N : Subgroup G := Subgroup.normalizer (A : Set G) with hNdef
  have hSN' : (S : Subgroup G) ≤ N := hSN
  have hNGSle : Subgroup.normalizer ((S : Subgroup G) : Set G) ≤ N := hAlchar
  have hSp : IsPGroup p ↥(S : Subgroup G) := S.isPGroup'
  -- ## `S` is a Sylow `p`-subgroup of `N = N_G(A)`
  have hSidx : ¬ p ∣ (S : Subgroup G).relIndex N := by
    intro hdiv
    have hdiv' : p ∣ ((S : Subgroup G).subgroupOf N).index := hdiv
    have hcardmul : Nat.card ↥((S : Subgroup G).subgroupOf N) *
        ((S : Subgroup G).subgroupOf N).index = Nat.card ↥N := Subgroup.card_mul_index _
    have hcardS : Nat.card ↥((S : Subgroup G).subgroupOf N) =
        p ^ (Nat.card G).factorization p := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hSN').toEquiv]
      exact hScard
    have hdvdN : p ^ ((Nat.card G).factorization p + 1) ∣ Nat.card ↥N := by
      rw [← hcardmul, hcardS, pow_succ]
      exact Nat.mul_dvd_mul_left _ hdiv'
    have hdvdG : p ^ ((Nat.card G).factorization p + 1) ∣ Nat.card G :=
      Nat.dvd_trans hdvdN (Subgroup.card_subgroup_dvd_card N)
    have hNnz : Nat.card ↥N ≠ 0 := Nat.card_pos.ne'
    have hGnz : Nat.card G ≠ 0 := Nat.card_pos.ne'
    have hleN : (p ^ ((Nat.card G).factorization p + 1)).factorization ≤
        (Nat.card ↥N).factorization :=
      (Nat.factorization_le_iff_dvd (pow_ne_zero _ hp.pos.ne') hNnz).mpr hdvdN
    have hleG : (Nat.card ↥N).factorization ≤ (Nat.card G).factorization :=
      (Nat.factorization_le_iff_dvd hNnz hGnz).mpr (Subgroup.card_subgroup_dvd_card N)
    have hfp : (p ^ ((Nat.card G).factorization p + 1)).factorization p =
        (Nat.card G).factorization p + 1 := Nat.factorization_pow_self hp
    have h2 : (Nat.card G).factorization p + 1 ≤ (Nat.card G).factorization p := by
      have h3 := le_trans (hleN p) (hleG p)
      rwa [hfp] at h3
    omega
  -- ## `Z = C_T(y)` is a normal subgroup of `N`
  have hZleN : Z ≤ N := le_trans hZA (by rw [hNdef]; exact Subgroup.le_normalizer (H := A))
  have hNdecomp : N = Subgroup.centralizer (A : Set G) ⊔ (V ⊓ N) := hL2b A hAleV hAne
  -- `N_G(A)` normalises `Z = C_T(y)`: both `C_G(A)` and `V ⊓ N_G(A)` do
  have hZGnormZ : Subgroup.centralizer (A : Set G) ≤ Subgroup.normalizer (Z : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro c hc z hz
    have h2 : c * z = z * c := (Subgroup.mem_centralizer_iff.mp hc z (hZA hz)).symm
    have h4 : c * z * c⁻¹ = z := by rw [h2]; group
    rw [h4]; exact hz
  have hZGNnormZ : V ⊓ N ≤ Subgroup.normalizer (Z : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro d hd z hz
    have hdV : d ∈ V := (Subgroup.mem_inf.mp hd).1
    have hdN : d ∈ N := (Subgroup.mem_inf.mp hd).2
    have hzaA : z ∈ A := hZA hz
    have hdzW : d * z * d⁻¹ * z⁻¹ ∈ W := hVW' d hdV z (hAleV hzaA)
    have hdzA : d * z * d⁻¹ * z⁻¹ ∈ A := by
      refine A.mul_mem ?_ (A.inv_mem hzaA)
      exact (Subgroup.mem_normalizer_iff.mp hdN z).mp hzaA
    have hdzZ : d * z * d⁻¹ * z⁻¹ ∈ Z := by
      have hmem : d * z * d⁻¹ * z⁻¹ ∈ A ⊓ W := ⟨hdzA, hdzW⟩
      rwa [hAinfW] at hmem
    have h3 : d * z * d⁻¹ = (d * z * d⁻¹ * z⁻¹) * z := by group
    rw [h3]
    exact Z.mul_mem hdzZ hz
  have hZN' : N ≤ Subgroup.normalizer (Z : Set G) := by
    rw [hNdecomp]
    exact sup_le hZGnormZ hZGNnormZ
  have hZN : (Z.subgroupOf N).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hZleN).mpr hZN'
  -- ## `N_G(S)` has a normal subgroup of index `p` containing `Z` (input N4)
  have hSne : (S : Subgroup G) ≠ ⊥ := by
    intro h
    have hy' : y ∈ (⊥ : Subgroup G) := by rw [← h]; exact hyS
    exact hy1 (Subgroup.mem_bot.mp hy')
  have hSGsyl : ¬ p ∣ (S : Subgroup G).relIndex
      (Subgroup.normalizer ((S : Subgroup G) : Set G)) := fun h =>
    Sylow.not_dvd_index S (Nat.dvd_trans h
      (Subgroup.relIndex_dvd_index_of_le (Subgroup.le_normalizer (H := (S : Subgroup G)))))
  obtain ⟨M, hMn, hMidx, hMle⟩ :=
    step9N4 (H := H) (Q := Q) (t := t) (s := s) (r := r) (P := P) (S₁ := (S : Subgroup G))
      hp hSV hSne S.isPGroup' hSGsyl hrelT hWV hVW hL2b
  have hZleM : Z ≤ Subgroup.map (Subgroup.normalizer ((S : Subgroup G) : Set G)).subtype M := by
    intro z hz
    have hzT : z ∈ T := (Subgroup.mem_inf.mp hz).1
    have hzG : z ∈ (S : Subgroup G) := hTS hzT
    have hzNGS : z ∈ Subgroup.normalizer ((S : Subgroup G) : Set G) :=
      Subgroup.le_normalizer (H := (S : Subgroup G)) hzG
    refine Subgroup.mem_map.mpr ⟨⟨z, hzNGS⟩, ?_, rfl⟩
    exact hMle (Subgroup.mem_subgroupOf.mpr hzT)
  -- ## assemble
  have hcommS : ∀ a ∈ (S : Subgroup G), ∀ b ∈ (S : Subgroup G),
      a * b * a⁻¹ * b⁻¹ ∈ Z := fun a ha b hb => hcommSZ a ha b hb
  have hNI : Work.ThmF.HasNormalIndexP p ↥N :=
    hasNormalIndexP_of_sylow_commutator (N := N) (S := (S : Subgroup G)) (Z := Z)
      hHW hSN' hZleN hZN hZleS hSp hSidx hNGSle hcommS M hMn hMidx hZleM
  have hHG : Work.ThmF.HasNormalIndexP p G := hHW1.mpr hNI
  have hGeven : Even (Nat.card G) := by
    obtain ⟨u, hu⟩ := Work.ThmF.split_even_card_H c.split
    rw [hG, hu]
    exact ⟨(Nat.card Q + 1) * u, by ring⟩
  exact simple_not_hasNormalIndexP hp hp2 c.simple hGeven hHG

end Work.ThmF.Prove
