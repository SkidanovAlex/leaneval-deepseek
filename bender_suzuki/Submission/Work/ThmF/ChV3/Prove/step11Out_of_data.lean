/-!
# `Work.ThmF.ChV3.Prove.step11Out_of_data` — step (11)'s output from the data

Peterfalvi II, Ch. V §3 step (11) (p. 251) has two halves:

* `R` is abelian (the non-abelian branch is killed by the `p`-part of step (10)); and then
* with `T = [R, s]`, `R = T × P`, `C_Q(P)·C_W(P) ≤ N_G(T)`, and `C_Q(P)` acts **regularly** on
  the order-`|P|` subgroups of `R` that are neither contained in `T` nor equal to `P`.

The statement here takes the first half (`hcomm`), together with the exponent bound
`hexp : ∀ x ∈ R, x ^ |P| = 1` (so that `R` is elementary abelian of order `|P| ^ (m+1)`), and
*constructs* the second half: there is `T` with `Step11Out H Q t P h15.R T`.

## The proof

`R` is abelian of order `|P| ^ (m+1)` (`h15.hcardR`, `h7`, `hpf`) with exponent `|P|`, and
`|C_Q(P)| = |P| ^ m - 1` (`h15.hcq`, `hpf`) — so `|P|` is odd.  Writing `σ` for conjugation by
the involution `s` (which normalises `R`, because `s ∈ C_G(P) ≤ N_G(R)`), the subgroup

`T := ⟨x * s * x⁻¹ * s⁻¹ | x ∈ R⟩ = im(1 - σ)`

is the `(-1)`-eigenspace of `σ`: for `a ∈ R` one has `a ∈ T ↔ s * a * s⁻¹ = a⁻¹`
(`Prove.step11Out_T_exists`, using `h15.hfpf` to see `C_R(σ) = P`, and `hexp` for `1 + σ = 2`);
it satisfies `T ⊓ P = ⊥`, `T ⊔ P = R`, `|T| = |P| ^ m`, and every `x ∈ R` is a product
`p₀ * w` with `p₀ ∈ P`, `w ∈ T`.  `h15.hfpf` gives that `C_Q(P)` acts *freely* on `(R/P)^#`
(and hence on `T^#`), while `hsC`/`hsS` propagate the inversion identity, giving
`C_Q(P) ⊔ C_W(P) ≤ N_G(T)`.

* **Uniqueness** in `Step11Out.reg` is the freeness of `C_Q(P)` on the lines of `R` outside `T`
  (`Prove.step11Out_free_lines`): if `y ∈ C_Q(P)` preserves such a line `A = ⟨a⟩` with
  `a = p₀ * w` (`p₀ ∈ P`, `w ∈ T`), then `y a y⁻¹ = a ^ i`; conjugating by `σ` and multiplying
  gives `y (a σ a) y⁻¹ = (a σ a) ^ i`, and `a σ a ∈ P` is fixed by `y ∈ C_G(P)` and has order
  `|P|`, so `i ≡ 1 (mod |P|)` and `a ^ i = a` (`hexp`), whence `y = 1` by `h15.hfpf`.
* **Existence** uses the transitivity of `C_Q(P)` on `T^#`
  (`Prove.step11Out_transitive`: freeness plus `|C_Q(P)| = |T| - 1`): given lines `A = ⟨p₀ w⟩`,
  `B = ⟨q₀ v⟩` one picks `i` with `p₀ ^ i = q₀` (both lie in the prime-order group `P`) and
  `y ∈ C_Q(P)` with `y wⁱ y⁻¹ = v`, so that `y (p₀ wⁱ) y⁻¹ = q₀ v` and `A^y = B`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ThmF.ChV3.Prove

open Classical LeanEval.GroupTheory.Defs Submission.Blueprint

variable {G : Type} [Group G] [Finite G]

/-- Commutativity of two elements of a commutative subgroup. -/
private theorem mul_comm_of_mem_aux {R : Subgroup G} (hc : IsMulCommutative ↥R)
    {a b : G} (ha : a ∈ R) (hb : b ∈ R) : a * b = b * a := by
  haveI := hc
  simpa using congrArg Subtype.val (mul_comm' (⟨a, ha⟩ : ↥R) (⟨b, hb⟩ : ↥R))

/-- The image of `zpowers x` under conjugation by `g`. -/
private theorem map_zpowers_conj_aux (g x : G) :
    (Subgroup.zpowers x).map (MulAut.conj g).toMonoidHom = Subgroup.zpowers (g * x * g⁻¹) := by
  rw [MonoidHom.map_zpowers]
  simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]

/-- In a subgroup of prime order, every non-identity element generates. -/
private theorem zpowers_eq_of_prime_card {P : Subgroup G} {x : G} (hp : (Nat.card P).Prime)
    (hxP : x ∈ P) (hxne : x ≠ 1) : Subgroup.zpowers x = P := by
  have hdvd : orderOf x ∣ Nat.card P := Subgroup.orderOf_dvd_natCard P hxP
  rcases (Nat.dvd_prime hp).mp hdvd with h | h
  · exact absurd (orderOf_eq_one_iff.mp h) hxne
  · refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hxP) ?_
    rw [Nat.card_zpowers, h]

/-- A subgroup `A` with `|A| = |P|` (`P` of prime order) is generated by each of its elements. -/
private theorem eq_zpowers_of_mem_of_card {P A : Subgroup G} {x : G} (hp : (Nat.card P).Prime)
    (hAcard : Nat.card ↥A = Nat.card P) (hxA : x ∈ A) (hxne : x ≠ 1) :
    A = Subgroup.zpowers x := by
  have hdvd : orderOf x ∣ Nat.card A := Subgroup.orderOf_dvd_natCard A hxA
  rw [hAcard] at hdvd
  rcases (Nat.dvd_prime hp).mp hdvd with h | h
  · exact absurd (orderOf_eq_one_iff.mp h) hxne
  · refine (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hxA) ?_).symm
    rw [Nat.card_zpowers, h, hAcard]

/-- A generator of `A` avoiding `P` and `T`. -/
private theorem exists_gen_of_card {P A T : Subgroup G} (hp : (Nat.card P).Prime)
    (hAcard : Nat.card ↥A = Nat.card P) (hAnP : A ≠ P) (hAnT : ¬ A ≤ T) :
    ∃ x ∈ A, x ≠ 1 ∧ A = Subgroup.zpowers x ∧ x ∉ P ∧ x ∉ T := by
  have hAne : A ≠ ⊥ := by
    intro hbot
    rw [hbot, Subgroup.card_bot] at hAcard
    have h2 := hp.two_le
    omega
  obtain ⟨x, hxA, hxne⟩ : ∃ x ∈ A, x ≠ 1 := by
    by_contra h
    simp only [not_exists, not_and, not_not] at h
    exact hAne ((Subgroup.eq_bot_iff_forall A).mpr h)
  have hgen : A = Subgroup.zpowers x := eq_zpowers_of_mem_of_card hp hAcard hxA hxne
  refine ⟨x, hxA, hxne, hgen, ?_, ?_⟩
  · intro hxP
    exact hAnP (hgen.trans (zpowers_eq_of_prime_card hp hxP hxne))
  · intro hxT
    exact hAnT (hgen.symm ▸ (Subgroup.zpowers_le.mpr hxT))

theorem step11Out_of_data {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G} {P : Subgroup G}
    (hFT : Submission.Blueprint.FeitThompsonProp) (hC4 : Submission.Blueprint.ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (h7 : Work.ThmF.ChV3.Ker H Q P t = P) (hpf : Nat.card P = orderOf (s * t))
    (hcomm : IsMulCommutative ↥h15.R)
    (hsC : ∀ y ∈ Work.ThmF.ChV3.CQ Q P, y * s * y⁻¹ = s)
    (hsS : ∀ y ∈ Work.ThmF.ChV3.Sig H t P, y * s * y⁻¹ = s)
    (hexp : ∀ x ∈ h15.R, x ^ Nat.card P = 1) :
    ∃ T : Subgroup G, Work.ThmF.ChV3.Step11Out H Q t P h15.R T := by
  classical
  -- ## 0. the subgroup `T` and its structural properties
  obtain ⟨T, hTR, hTP, hTPR, hTn, hTchar, hdecomp, hTcard⟩ :=
    step11Out_T_exists c h15 h7 hpf hcomm hexp hsC hsS
  -- ## 1. standing facts
  have hp : (Nat.card P).Prime := by rw [hpf]; exact h15.hf
  have hPR : P ≤ h15.R := by
    have h := h15.hNR
    rwa [h7] at h
  have hCV : Submission.Blueprint.centD H t ≤ Subgroup.centralizer ({s} : Set G) :=
    Work.ThmF.Prove.centDLowerCentralizerS c.split c.s_mem c.s_inv c.r_mem c.sid
  have hPs : ∀ q ∈ P, q * s = s * q := fun q hq =>
    Subgroup.mem_centralizer_singleton_iff.mp (hCV (c.P_le hq))
  have hsD : s ∈ Work.ThmF.ChV3.CQ Q P :=
    ⟨c.s_mem, Subgroup.mem_centralizer_iff.mpr (fun q hq => hPs q hq)⟩
  have hsCG : s ∈ Subgroup.centralizer (P : Set G) := (Subgroup.mem_inf.mp hsD).2
  have hs2 : s * s = 1 := by
    have h := pow_orderOf_eq_one s
    rw [c.s_inv, pow_two] at h
    exact h
  have hs_ne : s ≠ 1 := by
    intro h1
    have h : (2 : ℕ) = 1 := by rw [← c.s_inv, orderOf_eq_one_iff.mpr h1]
    exact absurd h (by norm_num)
  have hsR : s ∈ Subgroup.normalizer (h15.R : Set G) := h15.hRn hsCG
  have hDCP : Work.ThmF.ChV3.CQ Q P ≤ Subgroup.centralizer (P : Set G) := inf_le_right
  have hfpf' : ∀ x ∈ h15.R, x ∉ P → ∀ y ∈ Work.ThmF.ChV3.CQ Q P,
      y * x * y⁻¹ * x⁻¹ ∈ P → y = 1 := by
    intro x hx hxP y hy hyP
    refine h15.hfpf x hx ?_ y hy ?_
    · intro hk
      rw [h7] at hk
      exact hxP hk
    · show y * x * y⁻¹ * x⁻¹ ∈ Work.ThmF.ChV3.Ker H Q P t
      rw [h7]
      exact hyP
  -- ## 2. freeness of `C_Q(P)` on the order-`|P|` subgroups of `R` outside `T`
  have hfreeA := step11Out_free_lines hcomm hPR hTchar hDCP hs2 hs_ne hsD hsR hp hexp hfpf' hsC
  -- ## 3. freeness on `T \ {1}` and the cardinality `|C_Q(P)| = |T| - 1`
  have hfreeT : ∀ y ∈ Work.ThmF.ChV3.CQ Q P, ∀ x ∈ T, x ≠ 1 → y * x * y⁻¹ = x → y = 1 := by
    intro y hy x hxT hxne hfix
    have hxR : x ∈ h15.R := hTR hxT
    have hxP : x ∉ P := by
      intro hxP
      have hmem : x ∈ T ⊓ P := ⟨hxT, hxP⟩
      rw [hTP, Subgroup.mem_bot] at hmem
      exact hxne hmem
    refine hfpf' x hxR hxP y hy ?_
    rw [hfix, mul_inv_cancel]
    exact P.one_mem
  have hcardD : Nat.card ↥(Work.ThmF.ChV3.CQ Q P) = Nat.card ↥T - 1 := by
    have h : Nat.card ↥(Work.ThmF.ChV3.CQ Q P) + 1 = Nat.card ↥T := by
      rw [h15.hcq, ← hpf, hTcard]
    omega
  have hCNT : Work.ThmF.ChV3.CQ Q P ≤ Subgroup.normalizer (T : Set G) := le_trans le_sup_left hTn
  have htrans := step11Out_transitive hcardD hCNT hfreeT
  -- ## 4. the `reg` clause
  refine ⟨T, hcomm, hTP, hTPR, hTn, ?_⟩
  intro A B hAR hBR hAcard hBcard hAnT hBnT hAneP hBneP
  obtain ⟨x, hxA, hxne, hAx, hxnP, hxnT⟩ := exists_gen_of_card hp hAcard hAneP hAnT
  obtain ⟨p0, hp0P, w, hwT, hx_eq, hxTimp, hxPimp⟩ := hdecomp x (hAR hxA)
  have hp0ne : p0 ≠ 1 := hxTimp hxnT
  have hwne : w ≠ 1 := hxPimp hxnP
  obtain ⟨b, hbB, hbne, hBb, hbnP, hbnT⟩ := exists_gen_of_card hp hBcard hBneP hBnT
  obtain ⟨q0, hq0P, v, hvT, hb_eq, hbTimp, hbPimp⟩ := hdecomp b (hBR hbB)
  have hq0ne : q0 ≠ 1 := hbTimp hbnT
  have hvne : v ≠ 1 := hbPimp hbnP
  -- the discrete logarithm of `q0` with respect to `p0`
  have hp0ord : orderOf p0 = Nat.card P := by
    have hdvd : orderOf p0 ∣ Nat.card P := Subgroup.orderOf_dvd_natCard P hp0P
    rcases (Nat.dvd_prime hp).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hp0ne
    · exact h
  have hq0mem : q0 ∈ Subgroup.zpowers p0 := by
    rw [zpowers_eq_of_prime_card hp hp0P hp0ne]
    exact hq0P
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hq0mem
  have hword : orderOf w = Nat.card P := by
    have hdvd : orderOf w ∣ Nat.card P :=
      orderOf_dvd_iff_pow_eq_one.mpr (hexp w (hTR hwT))
    rcases (Nat.dvd_prime hp).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hwne
    · exact h
  have hpnvd : ¬ ((orderOf p0 : ℤ) ∣ i) := fun hd => hq0ne (by
    rw [← hi]
    exact orderOf_dvd_iff_zpow_eq_one.mp hd)
  set x' : G := x ^ i with hx'def
  set v' : G := w ^ i with hv'def
  have hx'A : x' ∈ A := by
    rw [hAx]
    exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers x) i
  have hv'T : v' ∈ T := by
    rw [hv'def]
    exact T.zpow_mem hwT i
  have hx'eq : x' = q0 * v' := by
    have hcomm' : Commute p0 w :=
      mul_comm_of_mem_aux (R := h15.R) hcomm (hPR hp0P) (hTR hwT)
    rw [hx'def, hv'def, hx_eq, Commute.mul_zpow hcomm', hi]
  have hx'ne : x' ≠ 1 := by
    intro h1
    have hmul : q0 * v' = 1 := by rw [← hx'eq]; exact h1
    have hq0_eq : q0 = v'⁻¹ := eq_inv_of_mul_eq_one_left hmul
    have hq0T : q0 ∈ T := hq0_eq ▸ T.inv_mem hv'T
    have hmem : q0 ∈ T ⊓ P := ⟨hq0T, hq0P⟩
    rw [hTP, Subgroup.mem_bot] at hmem
    exact hq0ne hmem
  have hv'ne : v' ≠ 1 := by
    intro h1
    refine hpnvd ?_
    have hwordp0 : orderOf w = orderOf p0 := by rw [hword, hp0ord]
    have hdvd : (orderOf w : ℤ) ∣ i :=
      orderOf_dvd_iff_zpow_eq_one.mpr (by rw [← hv'def]; exact h1)
    rwa [hwordp0] at hdvd
  obtain ⟨y, hyD, hyconj⟩ := htrans v' hv'T hv'ne v hvT hvne
  have hAeq : A = Subgroup.zpowers x' := eq_zpowers_of_mem_of_card hp hAcard hx'A hx'ne
  have hAy : A.map (MulAut.conj y).toMonoidHom = B := by
    rw [hAeq, map_zpowers_conj_aux]
    have hyq0 : y * q0 * y⁻¹ = q0 := by
      have hcy : q0 * y = y * q0 := Subgroup.mem_centralizer_iff.mp (hDCP hyD) q0 hq0P
      rw [← hcy]
      group
    have h1 : y * x' * y⁻¹ = q0 * v := by
      calc y * x' * y⁻¹ = y * (q0 * v') * y⁻¹ := by rw [hx'eq]
        _ = (y * q0 * y⁻¹) * (y * v' * y⁻¹) := by group
        _ = q0 * v := by rw [hyq0, hyconj]
    rw [h1, ← hb_eq, hBb]
  refine ⟨⟨y, hyD⟩, hAy, ?_⟩
  intro z hz
  have hz_eq : A.map (MulAut.conj (z : G)).toMonoidHom = A.map (MulAut.conj y).toMonoidHom := by
    rw [hz, hAy]
  have hgmem : (((⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P)⁻¹ * z : ↥(Work.ThmF.ChV3.CQ Q P)) : G)
      ∈ Work.ThmF.ChV3.CQ Q P := (⟨y, hyD⟩⁻¹ * z).2
  have hcoeeq : (((⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P)⁻¹ * z : ↥(Work.ThmF.ChV3.CQ Q P)) : G)
      = y⁻¹ * (z : G) := by simp
  have hle : A.map (MulAut.conj (y⁻¹ * (z : G))).toMonoidHom ≤ A := by
    rintro _ ⟨a, haA, rfl⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    have h1 : (MulAut.conj (z : G)).toMonoidHom a ∈ A.map (MulAut.conj (z : G)).toMonoidHom :=
      Subgroup.mem_map.mpr ⟨a, haA, rfl⟩
    rw [hz_eq] at h1
    obtain ⟨a', ha'A, ha'e⟩ := h1
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at ha'e
    have he : y⁻¹ * (z : G) * a * (y⁻¹ * (z : G))⁻¹ = a' := by
      calc y⁻¹ * (z : G) * a * (y⁻¹ * (z : G))⁻¹
          = y⁻¹ * ((z : G) * a * (z : G)⁻¹) * y := by group
        _ = y⁻¹ * (y * a' * y⁻¹) * y := by rw [ha'e]
        _ = a' := by group
    rw [he]
    exact ha'A
  have hcardge : Nat.card ↥A ≤
      Nat.card ↥(A.map (MulAut.conj (y⁻¹ * (z : G))).toMonoidHom) := by
    rw [Subgroup.card_map_of_injective (MulAut.conj (y⁻¹ * (z : G))).injective]
  have heqmap : A.map (MulAut.conj (y⁻¹ * (z : G))).toMonoidHom = A :=
    Subgroup.eq_of_le_of_card_ge hle hcardge
  have hfre := hfreeA (y⁻¹ * (z : G)) (by rw [← hcoeeq]; exact hgmem) A hAR hAcard hAneP hAnT heqmap
  have h1 : ((⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P)⁻¹ * z) = 1 := by
    refine Subtype.ext ?_
    rw [hcoeeq]
    exact hfre
  have hzy : z = (⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P) := by
    calc z = (⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P) * ((⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P)⁻¹ * z) := by
          group
      _ = (⟨y, hyD⟩ : Work.ThmF.ChV3.CQ Q P) := by rw [h1, mul_one]
  exact hzy

end Work.ThmF.ChV3.Prove
