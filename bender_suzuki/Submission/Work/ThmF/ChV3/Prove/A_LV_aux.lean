variable {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G} {P : Subgroup G}

/-- `N_G(A) ⊓ N_G(B) ≤ N_G(A ⊔ B)`. -/
theorem inf_normalizer_le_normalizer_sup {G : Type} [Group G] {A B : Subgroup G} :
    Subgroup.normalizer (A : Set G) ⊓ Subgroup.normalizer (B : Set G) ≤
      Subgroup.normalizer ((A ⊔ B : Subgroup G) : Set G) := by
  intro x hx
  obtain ⟨hxA, hxB⟩ := Subgroup.mem_inf.mp hx
  rw [← cj_eq_self_iff x (A ⊔ B)]
  have h1 : cj x A = A := (cj_eq_self_iff x A).mpr hxA
  have h2 : cj x B = B := (cj_eq_self_iff x B).mpr hxB
  calc cj x (A ⊔ B) = cj x A ⊔ cj x B := Subgroup.map_sup A B (MulAut.conj x).toMonoidHom
    _ = A ⊔ B := by rw [h1, h2]

/-! ## Elementary number theory -/

/-- `3 ∣ k - 1` whenever `3 ∣ k³ - 1`: mod `3`, `k³ = k`. -/
theorem three_dvd_of_dvd_cube_sub_one {k : ℤ} (h : (3 : ℤ) ∣ k ^ 3 - 1) :
    (3 : ℤ) ∣ k - 1 := by
  have hx3 : ∀ x : ZMod 3, x ^ 3 = x := by decide
  have h0 : ((k : ZMod 3)) ^ 3 = 1 := by
    have h1 : (((k ^ 3 - 1 : ℤ)) : ZMod 3) = 0 := by
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]; exact h
    push_cast at h1
    linear_combination h1
  rw [hx3] at h0
  have h2 : (((k - 1 : ℤ)) : ZMod 3) = 0 := by
    push_cast
    rw [h0]; ring
  rwa [ZMod.intCast_zmod_eq_zero_iff_dvd] at h2

/-! ## Cyclic generators and conjugation exponents -/

/-- A finitely generated cyclic group has a generator whose `zpowers` in the ambient group is
exactly the subgroup. -/
theorem exists_gen_zpowers_of_isCyclic {A : Subgroup G} (hcyc : IsCyclic ↥A) :
    ∃ g : G, g ∈ A ∧ Subgroup.zpowers g = A := by
  haveI := hcyc
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥A)
  refine ⟨(g : G), g.2, le_antisymm ?_ ?_⟩
  · rw [Subgroup.zpowers_le]; exact g.2
  · intro y hy
    have hy' : (⟨y, hy⟩ : ↥A) ∈ Subgroup.zpowers g := hg ⟨y, hy⟩
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hy'
    refine Subgroup.mem_zpowers_iff.mpr ⟨k, ?_⟩
    have := congrArg (Subtype.val) hk
    simpa using this

/-- The order of a generator is the cardinality of the subgroup it generates. -/
theorem orderOf_eq_card_of_zpowers_eq {A : Subgroup G} {g : G}
    (hgen : Subgroup.zpowers g = A) : orderOf g = Nat.card ↥A := by
  rw [← Nat.card_zpowers g, hgen]

/-- If `b` normalises the cyclic subgroup generated by `g`, `b ^ 3 = 1` and
`b * g * b⁻¹ = g ^ k`, then `3 ∣ k - 1` whenever `9 ∣ orderOf g`. -/
theorem three_dvd_sub_one_of_conj {g b : G} (k : ℤ) (hbg : b * g * b⁻¹ = g ^ k)
    (hb3 : b ^ 3 = 1) (hord : orderOf g = 9) : (3 : ℤ) ∣ k - 1 := by
  have hc : (MulAut.conj b) g = g ^ k := by
    simpa [MulAut.conj_apply] using hbg
  have h3 : (MulAut.conj b) ^ 3 = 1 := by
    rw [show (MulAut.conj b) ^ 3 = MulAut.conj (b ^ 3) from (map_pow (MulAut.conj) b 3).symm, hb3]
    exact map_one (MulAut.conj : G →* MulAut G)
  have hiter : ∀ n : ℕ, ((MulAut.conj b) ^ n) g = g ^ (k ^ n) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, MulAut.mul_apply, hc, map_zpow, ih, ← zpow_mul]
      congr 1
      rw [pow_succ]
  have hfix : g ^ (k ^ 3) = g := by
    have h := congrArg (fun f : MulAut G => f g) h3
    simp only [MulAut.one_apply] at h
    rw [hiter 3] at h
    exact h
  have h1 : g ^ (k ^ 3 - 1) = 1 := by
    rw [show k ^ 3 - 1 = k ^ 3 + (-1) by ring, zpow_add, hfix, zpow_neg_one, mul_inv_cancel]
  have h2 : (orderOf g : ℤ) ∣ k ^ 3 - 1 := orderOf_dvd_iff_zpow_eq_one.mpr h1
  have h3dvd : (3 : ℤ) ∣ (orderOf g : ℤ) := ⟨3, by rw [hord]; norm_num⟩
  exact three_dvd_of_dvd_cube_sub_one (dvd_trans h3dvd h2)

/-- In a cyclic group of order `9`, the subgroup of order `3` is unique. -/
theorem eq_zpowers_pow3_of_le_of_card {g : G} {M : Subgroup G}
    (hM : M ≤ Subgroup.zpowers g) (hMcard : Nat.card ↥M = 3) (hord : orderOf g = 9) :
    M = Subgroup.zpowers (g ^ 3) := by
  have h9 : Nat.card ↥(Subgroup.zpowers (g ^ 3)) = 3 := by
    rw [Nat.card_zpowers, orderOf_pow, hord]
    norm_num
  refine Subgroup.eq_of_le_of_card_ge ?_ (by rw [h9, hMcard])
  intro x hx
  have hx3 : x ^ 3 = 1 :=
    orderOf_dvd_iff_pow_eq_one.mp (hMcard ▸ Subgroup.orderOf_dvd_natCard M hx)
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hM hx)
  rw [← hm] at hx3
  have h1 : g ^ (m * 3) = 1 := by
    rw [zpow_mul, zpow_ofNat]
    exact hx3
  have h2 : (9 : ℤ) ∣ m * 3 := by
    have := orderOf_dvd_iff_zpow_eq_one.mpr h1
    rwa [hord] at this
  obtain ⟨u, hu⟩ := h2
  have hm3 : m = 3 * u := by omega
  exact Subgroup.mem_zpowers_iff.mpr ⟨u, by
    rw [← hm, hm3, ← zpow_ofNat g 3, ← zpow_mul]⟩

/-! ## The standing-context facts -/

/-- `P` centralises `st`. -/
theorem P_le_Cst (c : Work.ThmF.ChV3.CtxF H Q t s r P) : P ≤ Cst s t := by
  have hVs : centD H t ≤ Subgroup.centralizer ({s} : Set G) :=
    Work.ThmF.Prove.centDLowerCentralizerS c.split c.s_mem c.s_inv c.r_mem c.sid
  have hVt : centD H t ≤ Subgroup.centralizer ({t} : Set G) :=
    fun x hx => (Subgroup.mem_inf.mp hx).2
  intro p hp
  rw [Cst]
  exact centralizer_mul_le_centralizer s t
    (Subgroup.mem_inf.mpr ⟨hVs (c.P_le hp), hVt (c.P_le hp)⟩)

/-- `Z₁ = ⟨st⟩ ≤ C_G(st)`. -/
theorem Z1_le_Cst : Z1 s t ≤ Cst s t := by
  rw [Z1, Cst, Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]

/-- `Z₁ = ⟨st⟩ ≤ L`. -/
theorem Z1_le_Lsub (c : Work.ThmF.ChV3.CtxF H Q t s r P) : Z1 s t ≤ Lsub H s t := by
  rw [Z1, Subgroup.zpowers_le, Lsub, Subgroup.mem_inf]
  refine ⟨?_, Z1_le_Cst (Subgroup.mem_zpowers_iff.mpr ⟨1, zpow_one _⟩)⟩
  have hsQ0 : s ∈ Q0 H := mem_Q0_iff.mpr (Or.inl ⟨c.split.le c.s_mem, c.s_inv⟩)
  exact mul_mem (Lemma5.Q0_subset_X5 H t hsQ0) (Lemma5.t_mem_X5 H t)

/-- `P` normalises `X₅ = ⟨Q₀,K,t⟩`. -/
theorem P_le_normalizer_X5 (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    P ≤ Subgroup.normalizer (Lemma5.X5 H t : Set G) := by
  intro p hp
  rw [← cj_eq_self_iff p (Lemma5.X5 H t)]
  exact V_conj_X5 c.split p (c.P_le hp)

/-- `P` normalises `L = X₅ ∩ C_G(st)`. -/
theorem P_le_normalizer_Lsub (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    P ≤ Subgroup.normalizer (Lsub H s t : Set G) := by
  have hX5 := P_le_normalizer_X5 (H := H) (t := t) c
  have hCst : P ≤ Subgroup.normalizer (Cst s t : Set G) :=
    (P_le_Cst c).trans Subgroup.le_normalizer
  have := (le_inf hX5 hCst).trans
    (inf_normalizer_le_normalizer_inf (A := Lemma5.X5 H t) (B := Cst s t))
  simpa only [Lsub] using this

/-- `P` normalises `C_G(K)`, where `K = J(D,t)`. -/
theorem P_le_normalizer_centralizer_Kset (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    P ≤ Subgroup.normalizer (Subgroup.centralizer (Kset H t) : Set G) := by
  intro p hp
  have hpV : p ∈ centD H t := c.P_le hp
  obtain ⟨hpD, hpc⟩ := Subgroup.mem_inf.mp hpV
  obtain ⟨hpH, -⟩ := Subgroup.mem_inf.mp hpD
  have hpt : t * p = p * t := Subgroup.mem_centralizer_iff.mp hpc t rfl
  have hpt' : t * p⁻¹ = p⁻¹ * t := by
    calc t * p⁻¹ = p⁻¹ * (p * t) * p⁻¹ := by group
      _ = p⁻¹ * (t * p) * p⁻¹ := by rw [← hpt]
      _ = p⁻¹ * t := by group
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy k hk
    have hki : p⁻¹ * k * p ∈ Kset H t := by
      simpa using cj_mem_Kset (H := H) (t := t) (v := p⁻¹) (x := k) (H.inv_mem hpH) hpt' hk
    have hcomm := (Subgroup.mem_centralizer_iff.mp hy) (p⁻¹ * k * p) hki
    calc k * (p * y * p⁻¹) = p * ((p⁻¹ * k * p) * y) * p⁻¹ := by group
      _ = p * (y * (p⁻¹ * k * p)) * p⁻¹ := by rw [hcomm]
      _ = (p * y * p⁻¹) * k := by group
  · intro hy k hk
    have hki : p * k * p⁻¹ ∈ Kset H t :=
      cj_mem_Kset (H := H) (t := t) (v := p) (x := k) hpH hpt hk
    have hcomm := (Subgroup.mem_centralizer_iff.mp hy) (p * k * p⁻¹) hki
    have h2 : p * (k * y) * p⁻¹ = p * (y * k) * p⁻¹ := by
      calc p * (k * y) * p⁻¹ = (p * k * p⁻¹) * (p * y * p⁻¹) := by group
        _ = (p * y * p⁻¹) * (p * k * p⁻¹) := hcomm
        _ = p * (y * k) * p⁻¹ := by group
    calc k * y = p⁻¹ * (p * (k * y) * p⁻¹) * p := by group
      _ = p⁻¹ * (p * (y * k) * p⁻¹) * p := by rw [h2]
      _ = y * k := by group

/-- `P` normalises `W = C_V(K)`. -/
theorem P_le_normalizer_W (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    P ≤ Subgroup.normalizer (W H t : Set G) := by
  have h1 : P ≤ Subgroup.normalizer (centD H t : Set G) :=
    c.P_le.trans Subgroup.le_normalizer
  have h2 := P_le_normalizer_centralizer_Kset (H := H) (t := t) c
  have := (le_inf h1 h2).trans (inf_normalizer_le_normalizer_inf
    (A := centD H t) (B := Subgroup.centralizer (Kset H t)))
  simpa only [W] using this

/-! ## Cardinalities -/

/-- `|Z₁| = 3`. -/
theorem Z1_card (d : Work.ThmF.ChV3.Case102 H Q t s P) : Nat.card ↥(Z1 s t) = 3 := by
  rw [Z1, Nat.card_zpowers, d.f3]

/-- `|Σ| = 3`. -/
theorem Sig_card (d : Work.ThmF.ChV3.Case102 H Q t s P) : Nat.card ↥(Sig H t P) = 3 :=
  d.sig3

/-- `|P| = 3`. -/
theorem P_card (d : Work.ThmF.ChV3.Case102 H Q t s P) : Nat.card ↥P = 3 := d.p3

/-- `|L| = 9`. -/
theorem Lsub_card (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : Nat.card ↥(Lsub H s t) = 9 :=
  (L_facts hFT hC4 c h15 d).2.1

/-- `s` inverts `L`. -/
theorem s_inverts_Lsub (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    ∀ x ∈ Lsub H s t, s * x * s⁻¹ = x⁻¹ :=
  (L_facts hFT hC4 c h15 d).2.2.1

/-- `L` is cyclic. -/
theorem Lsub_isCyclic (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : IsCyclic ↥(Lsub H s t) :=
  (L_facts hFT hC4 c h15 d).1

/-! ## `Ω₁` of the cyclic subgroups `L` and `W` -/

/-- `(g³)^u = g^(3u)`. -/
theorem zpowers_three (g : G) (u : ℤ) : (g ^ 3) ^ u = g ^ (3 * u) := by
  rw [← zpow_ofNat g 3, ← zpow_mul]

/-- `(x^u)³ = (x³)^u`. -/
theorem three_zpow_pow (x : G) (u : ℤ) : (x ^ u) ^ 3 = (x ^ 3) ^ u := by
  rw [← zpow_ofNat (x ^ u) 3, ← zpow_mul, ← zpow_ofNat x 3, ← zpow_mul]
  congr 1
  ring

/-- An element of `⟨g⟩`, with `g` of order `9`, whose cube is trivial lies in `⟨g³⟩`. -/
theorem mem_zpowers_pow3_of_pow3 {g x : G} (hx : x ∈ Subgroup.zpowers g) (h3 : x ^ 3 = 1)
    (hord : orderOf g = 9) : x ∈ Subgroup.zpowers (g ^ 3) := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hx
  rw [← hm] at h3
  have h1 : g ^ (m * 3) = 1 := by
    rw [zpow_mul, zpow_ofNat]
    exact h3
  have h2 : (9 : ℤ) ∣ m * 3 := by
    have := orderOf_dvd_iff_zpow_eq_one.mpr h1
    rwa [hord] at this
  obtain ⟨u, hu⟩ := h2
  have hm3 : m = 3 * u := by omega
  exact Subgroup.mem_zpowers_iff.mpr ⟨u, by
    rw [← hm, hm3, ← zpow_ofNat g 3, ← zpow_mul]⟩

/-- Two elements of a cyclic subgroup commute. -/
theorem commute_of_mem_zpowers {g x y : G} (hx : x ∈ Subgroup.zpowers g)
    (hy : y ∈ Subgroup.zpowers g) : x * y = y * x := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hx
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hy
  rw [← hm, ← hn, ← zpow_add, ← zpow_add, add_comm]

/-- `L ≤ X₅`. -/
theorem Lsub_le_X5 : Lsub H s t ≤ Lemma5.X5 H t := inf_le_left

/-- `L ≤ C_G(st)`. -/
theorem Lsub_le_Cst : Lsub H s t ≤ Cst s t := inf_le_right

/-- `Σ = W ∩ C_G(P) ≤ W`. -/
theorem Sig_le_W : Sig H t P ≤ W H t := inf_le_left

/-- `Σ ≤ C_G(P)`. -/
theorem Sig_le_centralizer_P : Sig H t P ≤ Subgroup.centralizer (P : Set G) := inf_le_right

/-- `P ⊓ Σ = ⊥` (via `P ⊓ W = ⊥`). -/
theorem P_inf_Sig_eq_bot (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P) : P ⊓ Sig H t P = ⊥ := by
  refine le_antisymm ?_ bot_le
  intro x hx
  obtain ⟨hxP, hxS⟩ := Subgroup.mem_inf.mp hx
  have hxW : x ∈ W H t := Sig_le_W hxS
  have h2 : x ∈ W H t ⊓ P := ⟨hxW, hxP⟩
  rw [h15.hWP] at h2
  exact Subgroup.mem_bot.mp h2

/-- If `|W| = 3` then `Σ = W`. -/
theorem Sig_eq_W_of_card_three (d : Work.ThmF.ChV3.Case102 H Q t s P)
    (hW3 : Nat.card ↥(W H t) = 3) : Sig H t P = W H t :=
  Subgroup.eq_of_le_of_card_ge Sig_le_W (by rw [hW3, Sig_card d])

/-! ## `[L, P] ≤ Z₁` and `[W, P] ≤ Σ` -/

/-- `Z₁ = ⟨g³⟩` for a generator `g` of `L`. -/
theorem Z1_eq_zpowers_gen_pow3 (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) {g : G} (hgen : Subgroup.zpowers g = Lsub H s t) :
    Z1 s t = Subgroup.zpowers (g ^ 3) :=
  eq_zpowers_pow3_of_le_of_card (hgen.symm ▸ Z1_le_Lsub c) (Z1_card d)
    (by rw [orderOf_eq_card_of_zpowers_eq hgen, Lsub_card hFT hC4 c h15 d])

/-- `l³ ∈ Z₁` for `l ∈ L`. -/
theorem Lsub_pow3_mem_Z1 (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : ∀ l ∈ Lsub H s t, l ^ 3 ∈ Z1 s t := by
  obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic (Lsub_isCyclic hFT hC4 c h15 d)
  have hord : orderOf g = 9 := by
    rw [orderOf_eq_card_of_zpowers_eq hgen, Lsub_card hFT hC4 c h15 d]
  have hZ1 : Z1 s t = Subgroup.zpowers (g ^ 3) := Z1_eq_zpowers_gen_pow3 hFT hC4 c h15 d hgen
  intro l hl
  rw [hZ1]
  refine mem_zpowers_pow3_of_pow3 (Subgroup.pow_mem (Subgroup.zpowers g) (hgen.symm ▸ hl) 3) ?_ hord
  have h9 : l ^ 9 = 1 :=
    orderOf_dvd_iff_pow_eq_one.mp (by
      rw [← Lsub_card hFT hC4 c h15 d]
      exact Subgroup.orderOf_dvd_natCard (Lsub H s t) hl)
  calc (l ^ 3) ^ 3 = l ^ 9 := by rw [← pow_mul]
    _ = 1 := h9

/-- `l³ = 1 ↔ l ∈ Z₁` for `l ∈ L`. -/
theorem Lsub_pow3_eq_one_iff (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    ∀ l ∈ Lsub H s t, l ^ 3 = 1 ↔ l ∈ Z1 s t := by
  obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic (Lsub_isCyclic hFT hC4 c h15 d)
  have hord : orderOf g = 9 := by
    rw [orderOf_eq_card_of_zpowers_eq hgen, Lsub_card hFT hC4 c h15 d]
  have hZ1 : Z1 s t = Subgroup.zpowers (g ^ 3) := Z1_eq_zpowers_gen_pow3 hFT hC4 c h15 d hgen
  intro l hl
  constructor
  · intro h3
    rw [hZ1]
    exact mem_zpowers_pow3_of_pow3 (hgen.symm ▸ hl) h3 hord
  · intro hlZ
    rw [hZ1] at hlZ
    obtain ⟨u, hu⟩ := Subgroup.mem_zpowers_iff.mp hlZ
    have hg9 : (g ^ 3) ^ 3 = 1 := by
      have h9 : g ^ 9 = 1 := orderOf_dvd_iff_pow_eq_one.mp ⟨1, by rw [hord]⟩
      calc (g ^ 3) ^ 3 = g ^ 9 := by rw [← pow_mul]
        _ = 1 := h9
    calc l ^ 3 = ((g ^ 3) ^ u) ^ 3 := by rw [← hu]
      _ = ((g ^ 3) ^ 3) ^ u := three_zpow_pow (g ^ 3) u
      _ = 1 := by rw [hg9, one_zpow]

/-- `[L, P] ≤ Z₁`. -/
theorem commutator_L_P (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    ∀ l ∈ Lsub H s t, ∀ b ∈ P, b * l * b⁻¹ * l⁻¹ ∈ Z1 s t := by
  obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic (Lsub_isCyclic hFT hC4 c h15 d)
  have hord : orderOf g = 9 := by
    rw [orderOf_eq_card_of_zpowers_eq hgen, Lsub_card hFT hC4 c h15 d]
  intro l hl b hb
  have hb3 : b ^ 3 = 1 :=
    orderOf_dvd_iff_pow_eq_one.mp (by rw [← P_card d]; exact Subgroup.orderOf_dvd_natCard P hb)
  have hgL : g ∈ Lsub H s t := by
    rw [← hgen]; exact Subgroup.mem_zpowers_iff.mpr ⟨1, zpow_one g⟩
  have hgl : b * g * b⁻¹ ∈ Subgroup.zpowers g := by
    rw [hgen]
    exact (Subgroup.mem_normalizer_iff.mp (P_le_normalizer_Lsub c hb) g).mp hgL
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hgl
  have h3k : (3 : ℤ) ∣ k - 1 := three_dvd_sub_one_of_conj k hk.symm hb3 hord
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hgen.symm ▸ hl)
  have hbl : b * l * b⁻¹ = l ^ k := by
    rw [← hm]
    have h1 : b * g ^ m * b⁻¹ = (b * g * b⁻¹) ^ m := by
      rw [show b * g ^ m * b⁻¹ = (MulAut.conj b) (g ^ m) by simp [MulAut.conj_apply],
        map_zpow, MulAut.conj_apply]
    have h2 : (g ^ m) ^ k = g ^ (m * k) := by rw [zpow_mul]
    rw [h1, hk.symm, h2, ← zpow_mul, mul_comm]
  obtain ⟨u, hu⟩ := h3k
  have hu' : k + (-1) = 3 * u := by rw [← Int.sub_eq_add_neg]; exact hu
  have key : b * l * b⁻¹ * l⁻¹ = (l ^ 3) ^ u := by
    rw [hbl, ← zpow_neg_one l, ← zpow_add, hu', zpow_mul, zpow_ofNat]
  rw [key]
  exact Subgroup.zpow_mem (Z1 s t) (Lsub_pow3_mem_Z1 hFT hC4 c h15 d l hl) u

/-- `Σ = ⟨g³⟩` for a generator `g` of `W` of order `9`. -/
theorem Sig_eq_zpowers_gen_pow3 {g : G} (d : Work.ThmF.ChV3.Case102 H Q t s P)
    (hgen : Subgroup.zpowers g = W H t) (hord : orderOf g = 9) :
    Sig H t P = Subgroup.zpowers (g ^ 3) :=
  eq_zpowers_pow3_of_le_of_card (hgen.symm ▸ Sig_le_W) (Sig_card d) hord

/-- `w³ ∈ Σ` for `w ∈ W`. -/
theorem W_pow3_mem_Sig (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : ∀ w ∈ W H t, w ^ 3 ∈ Sig H t P := by
  intro w hw
  rcases d.W39 with hW3 | hW9
  · rw [Sig_eq_W_of_card_three d hW3]
    have h3 : w ^ 3 = 1 := orderOf_dvd_iff_pow_eq_one.mp
      (by rw [← hW3]; exact Subgroup.orderOf_dvd_natCard (W H t) hw)
    rw [h3]
    exact (W H t).one_mem
  · obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic d.Wcyc
    have hord : orderOf g = 9 := by rw [orderOf_eq_card_of_zpowers_eq hgen, hW9]
    have hSig : Sig H t P = Subgroup.zpowers (g ^ 3) := Sig_eq_zpowers_gen_pow3 d hgen hord
    rw [hSig]
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hgen.symm ▸ hw)
    rw [← hm]
    exact Subgroup.mem_zpowers_iff.mpr ⟨m, by
      rw [zpowers_three, ← zpow_ofNat (g ^ m) 3, ← zpow_mul]
      congr 1
      ring⟩

/-- `[W, P] ≤ Σ`. -/
theorem commutator_W_P (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    ∀ w ∈ W H t, ∀ b ∈ P, b * w * b⁻¹ * w⁻¹ ∈ Sig H t P := by
  intro w hw b hb
  rcases d.W39 with hW3 | hW9
  · rw [Sig_eq_W_of_card_three d hW3]
    exact (W H t).mul_mem
      ((Subgroup.mem_normalizer_iff.mp (P_le_normalizer_W c hb) w).mp hw) ((W H t).inv_mem hw)
  · obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic d.Wcyc
    have hord : orderOf g = 9 := by rw [orderOf_eq_card_of_zpowers_eq hgen, hW9]
    have hb3 : b ^ 3 = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp (by rw [← P_card d]; exact Subgroup.orderOf_dvd_natCard P hb)
    have hgW : g ∈ W H t := by
      rw [← hgen]; exact Subgroup.mem_zpowers_iff.mpr ⟨1, zpow_one g⟩
    have hgl : b * g * b⁻¹ ∈ Subgroup.zpowers g := by
      rw [hgen]
      exact (Subgroup.mem_normalizer_iff.mp (P_le_normalizer_W c hb) g).mp hgW
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hgl
    have h3k : (3 : ℤ) ∣ k - 1 := three_dvd_sub_one_of_conj k hk.symm hb3 hord
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hgen.symm ▸ hw)
    have hbw : b * w * b⁻¹ = w ^ k := by
      rw [← hm]
      have h1 : b * g ^ m * b⁻¹ = (b * g * b⁻¹) ^ m := by
        rw [show b * g ^ m * b⁻¹ = (MulAut.conj b) (g ^ m) by simp [MulAut.conj_apply],
          map_zpow, MulAut.conj_apply]
      have h2 : (g ^ m) ^ k = g ^ (m * k) := by rw [zpow_mul]
      rw [h1, hk.symm, h2, ← zpow_mul, mul_comm]
    obtain ⟨u, hu⟩ := h3k
    have hu' : k + (-1) = 3 * u := by rw [← Int.sub_eq_add_neg]; exact hu
    have key : b * w * b⁻¹ * w⁻¹ = (w ^ 3) ^ u := by
      rw [hbw, ← zpow_neg_one w, ← zpow_add, hu', zpow_mul, zpow_ofNat]
    rw [key]
    exact Subgroup.zpow_mem (Sig H t P) (W_pow3_mem_Sig hFT hC4 c h15 d w hw) u

/-- `w³ = 1 ↔ w ∈ Σ` for `w ∈ W`. -/
theorem W_pow3_eq_one_iff (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : ∀ w ∈ W H t, w ^ 3 = 1 ↔ w ∈ Sig H t P := by
  intro w hw
  rcases d.W39 with hW3 | hW9
  · rw [Sig_eq_W_of_card_three d hW3]
    exact ⟨fun _ => hw, fun _ => orderOf_dvd_iff_pow_eq_one.mp
      (by rw [← hW3]; exact Subgroup.orderOf_dvd_natCard (W H t) hw)⟩
  · obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic d.Wcyc
    have hord : orderOf g = 9 := by rw [orderOf_eq_card_of_zpowers_eq hgen, hW9]
    have hSig : Sig H t P = Subgroup.zpowers (g ^ 3) := Sig_eq_zpowers_gen_pow3 d hgen hord
    constructor
    · intro h3
      rw [hSig]
      exact mem_zpowers_pow3_of_pow3 (hgen.symm ▸ hw) h3 hord
    · intro hwS
      rw [hSig] at hwS
      obtain ⟨u, hu⟩ := Subgroup.mem_zpowers_iff.mp hwS
      have hg9 : (g ^ 3) ^ 3 = 1 := by
        have h9 : g ^ 9 = 1 := orderOf_dvd_iff_pow_eq_one.mp ⟨1, by rw [hord]⟩
        calc (g ^ 3) ^ 3 = g ^ 9 := by rw [← pow_mul]
          _ = 1 := h9
      calc w ^ 3 = ((g ^ 3) ^ u) ^ 3 := by rw [← hu]
        _ = ((g ^ 3) ^ 3) ^ u := three_zpow_pow (g ^ 3) u
        _ = 1 := by rw [hg9, one_zpow]

/-! ## Intersections and invariance of `L ⊔ W` -/

/-- `L` commutes with `W` (step (15b) of §3). -/
theorem comm_Lsub_W (hC4 : ChIIFourProp) (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    ∀ l ∈ Lsub H s t, ∀ w ∈ W H t, l * w = w * l := by
  intro l hl w hw
  exact ((W_V_on_L hC4 c).1 w hw l (Lsub_le_X5 hl)).symm

/-- `W` normalises `L`. -/
theorem W_le_normalizer_Lsub (hC4 : ChIIFourProp) (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    W H t ≤ Subgroup.normalizer (Lsub H s t : Set G) := by
  intro w hw
  rw [← cj_eq_self_iff w (Lsub H s t)]
  apply le_antisymm
  · rintro y ⟨x, hx, rfl⟩
    have hc := comm_Lsub_W hC4 c x hx w hw
    have hcx : w * x * w⁻¹ = x := by rw [← hc]; group
    simpa [MulAut.conj_apply, hcx] using hx
  · intro y hy
    refine ⟨y, hy, ?_⟩
    have hc := comm_Lsub_W hC4 c y hy w hw
    have hcy : w * y * w⁻¹ = y := by rw [← hc]; group
    simpa [MulAut.conj_apply, hcy]

/-- `L ⊓ V = ⊥`. -/
theorem Lsub_inf_centD_eq_bot (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : Lsub H s t ⊓ centD H t = ⊥ := by
  obtain ⟨-, -, hinv, -⟩ := L_facts hFT hC4 c h15 d
  have hoddD : Odd (Nat.card ↥(twoPoint H t)) :=
    c.split.stronglyEmbedded.2.2 t c.split.not_mem
  have hVs : centD H t ≤ Subgroup.centralizer ({s} : Set G) :=
    Work.ThmF.Prove.centDLowerCentralizerS c.split c.s_mem c.s_inv c.r_mem c.sid
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  obtain ⟨hxL, hxV⟩ := Subgroup.mem_inf.mp hx
  have hxinvs : s * x * s⁻¹ = x⁻¹ := hinv x hxL
  have hxsx : x * s = s * x := Subgroup.mem_centralizer_singleton_iff.mp (hVs hxV)
  have hxx : x = x⁻¹ := by
    calc x = s * x * s⁻¹ := by rw [← hxsx]; group
      _ = x⁻¹ := hxinvs
  have hx2 : x * x = 1 := by
    nth_rewrite 2 [hxx]
    exact mul_inv_cancel x
  have hodd : Odd (orderOf x) := hoddD.of_dvd_nat
    (Subgroup.orderOf_dvd_natCard (twoPoint H t) (Subgroup.mem_inf.mp hxV).1)
  have hdvd : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (by rw [pow_two]; exact hx2)
  have hle : orderOf x ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
  have h1 : orderOf x = 1 := by
    rcases hodd with ⟨j, hj⟩
    omega
  exact orderOf_eq_one_iff.mp h1

/-- `L ⊓ W = ⊥`. -/
theorem Lsub_inf_W_eq_bot (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : Lsub H s t ⊓ W H t = ⊥ := by
  have h : Lsub H s t ⊓ W H t ≤ Lsub H s t ⊓ centD H t :=
    le_inf inf_le_left (inf_le_right.trans (W_le_centD H t))
  rw [Lsub_inf_centD_eq_bot hFT hC4 c h15 d, le_bot_iff] at h
  exact h

/-- `Z₁ ⊓ P = ⊥`. -/
theorem Z1_inf_P_eq_bot (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : Z1 s t ⊓ P = ⊥ := by
  have h : Z1 s t ⊓ P ≤ Lsub H s t ⊓ centD H t :=
    le_inf (inf_le_left.trans (Z1_le_Lsub c)) (inf_le_right.trans c.P_le)
  rw [Lsub_inf_centD_eq_bot hFT hC4 c h15 d, le_bot_iff] at h
  exact h

/-- `Z₁ ⊓ Σ = ⊥`. -/
theorem Z1_inf_Sig_eq_bot (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : Z1 s t ⊓ Sig H t P = ⊥ := by
  have h : Z1 s t ⊓ Sig H t P ≤ Lsub H s t ⊓ centD H t :=
    le_inf (inf_le_left.trans (Z1_le_Lsub c))
      (inf_le_right.trans (Sig_le_W.trans (W_le_centD H t)))
  rw [Lsub_inf_centD_eq_bot hFT hC4 c h15 d, le_bot_iff] at h
  exact h

/-- `Z₁ ⊓ (P ⊔ Σ) = ⊥`. -/
theorem Z1_inf_P_sup_Sig_eq_bot (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : Z1 s t ⊓ (P ⊔ Sig H t P) = ⊥ := by
  have h : Z1 s t ⊓ (P ⊔ Sig H t P) ≤ Lsub H s t ⊓ centD H t :=
    le_inf (inf_le_left.trans (Z1_le_Lsub c))
      (inf_le_right.trans (sup_le c.P_le (Sig_le_W.trans (W_le_centD H t))))
  rw [Lsub_inf_centD_eq_bot hFT hC4 c h15 d, le_bot_iff] at h
  exact h

/-- `(L ⊔ W) ⊓ P = ⊥`. -/
theorem Lsub_sup_W_inf_P_eq_bot (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) : (Lsub H s t ⊔ W H t) ⊓ P = ⊥ := by
  have hcoe : (↑(Lsub H s t ⊔ W H t) : Set G) =
      (Lsub H s t : Set G) * (W H t : Set G) :=
    Subgroup.coe_mul_of_right_le_normalizer_left (Lsub H s t) (W H t)
      (W_le_normalizer_Lsub hC4 c)
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  obtain ⟨hxLW, hxP⟩ := Subgroup.mem_inf.mp hx
  have hx' : x ∈ (Lsub H s t : Set G) * (W H t : Set G) := by rw [← hcoe]; exact hxLW
  obtain ⟨l, hl, w, hw, hlw⟩ := Set.mem_mul.mp hx'
  have hlV : l ∈ centD H t := by
    have hl' : l = x * w⁻¹ := by rw [← hlw]; group
    rw [hl']
    exact (centD H t).mul_mem (c.P_le hxP) ((centD H t).inv_mem (W_le_centD H t hw))
  have h1 : l = 1 := by
    have hmem : l ∈ Lsub H s t ⊓ centD H t := ⟨hl, hlV⟩
    rw [Lsub_inf_centD_eq_bot hFT hC4 c h15 d] at hmem
    exact Subgroup.mem_bot.mp hmem
  have hxw : x = w := by rw [← hlw, h1, one_mul]
  have hmem : x ∈ W H t ⊓ P := ⟨hxw ▸ hw, hxP⟩
  rw [h15.hWP] at hmem
  exact Subgroup.mem_bot.mp hmem

/-- `P` normalises `L ⊔ W`. -/
theorem P_le_normalizer_Lsub_sup_W (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    P ≤ Subgroup.normalizer (((Lsub H s t ⊔ W H t : Subgroup G)) : Set G) :=
  (le_inf (P_le_normalizer_Lsub c) (P_le_normalizer_W c)).trans
    (inf_normalizer_le_normalizer_sup (A := Lsub H s t) (B := W H t))

/-! ## Centralising subgroups -/

/-- `Z₁` commutes with `L`. -/
theorem Z1_le_centralizer_Lsub (hFT : FeitThompsonProp) (hC4 : ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    Z1 s t ≤ Subgroup.centralizer (Lsub H s t : Set G) := by
  obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic (Lsub_isCyclic hFT hC4 c h15 d)
  intro z hz
  rw [Subgroup.mem_centralizer_iff]
  intro l hl
  exact commute_of_mem_zpowers (hgen.symm ▸ hl) (hgen.symm ▸ (Z1_le_Lsub c hz))

/-- `Z₁` commutes with `W` (step (15b)). -/
theorem Z1_le_centralizer_W (hC4 : ChIIFourProp) (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    Z1 s t ≤ Subgroup.centralizer (W H t : Set G) := by
  intro z hz
  rw [Subgroup.mem_centralizer_iff]
  intro w hw
  have hzX : z ∈ Lemma5.X5 H t := Lsub_le_X5 (Z1_le_Lsub c hz)
  exact (W_V_on_L hC4 c).1 w hw z hzX

/-- `P` centralises `Z₁`. -/
theorem Z1_le_centralizer_P (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    Z1 s t ≤ Subgroup.centralizer (P : Set G) := by
  intro z hz
  rw [Subgroup.mem_centralizer_iff]
  intro p hp
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp hz
  have hcomm : p * (s * t) = (s * t) * p :=
    Subgroup.mem_centralizer_singleton_iff.mp (P_le_Cst c hp)
  have h2 : p * (s * t) ^ j * p⁻¹ = (s * t) ^ j := by
    rw [show p * (s * t) ^ j * p⁻¹ = (MulAut.conj p) ((s * t) ^ j) by
      simp [MulAut.conj_apply], map_zpow]
    rw [show (MulAut.conj p) (s * t) = s * t by rw [MulAut.conj_apply, hcomm]; group]
  rw [← hj]
  calc p * (s * t) ^ j = (p * (s * t) ^ j * p⁻¹) * p := by group
    _ = (s * t) ^ j * p := by rw [h2]

/-- `Σ` commutes with `L`. -/
theorem Sig_le_centralizer_Lsub (hC4 : ChIIFourProp) (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    Sig H t P ≤ Subgroup.centralizer (Lsub H s t : Set G) := by
  intro σ hσ
  rw [Subgroup.mem_centralizer_iff]
  intro l hl
  exact comm_Lsub_W hC4 c l hl σ (Sig_le_W hσ)

/-- `Σ` commutes with `W`. -/
theorem Sig_le_centralizer_W (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    Sig H t P ≤ Subgroup.centralizer (W H t : Set G) := by
  obtain ⟨g, -, hgen⟩ := exists_gen_zpowers_of_isCyclic d.Wcyc
  intro σ hσ
  rw [Subgroup.mem_centralizer_iff]
  intro w hw
  exact commute_of_mem_zpowers (hgen.symm ▸ hw) (hgen.symm ▸ Sig_le_W hσ)

end Work.ThmF.ChV3.Prove
