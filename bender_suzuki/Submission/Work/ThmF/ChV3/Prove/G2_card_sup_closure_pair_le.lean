namespace Work.ThmF.ChV3.Prove

/-- **G2** (generic class-2 bound).  If `Z` commutes with `x, y`, `x³, y³ ∈ Z` and `[x, y]`
commutes with `x` and `y` modulo `Z`, then `|Z ⟨x, y⟩| ≤ 27 |Z|`.

The subgroup `H := Z ⊔ ⟨x,y⟩` is generated by `Z` together with `x` and `y`; since `x` and `y`
commute with `Z` (and `Z` is a subgroup, hence closed under its own conjugation), `Z` is normal
in `H`.  In the quotient `H/Z` the images `ū, v̄` of `x, y` satisfy `ū³ = v̄³ = 1` and the
commutator `c̄ = [ū, v̄]` is central (its commutators with `ū` and `v̄` are the images of
`[[x,y],x]` resp. `[[x,y],y]`, which lie in `Z`).  Hence `H/Z` is generated by `ū, v̄` and has at
most `27` elements by `card_closure_pair_le_27`.  Finally
`|H| = |H/Z| · |Z| ≤ 27 |Z|`. -/
theorem G2_card_sup_closure_pair_le {G : Type} [Group G] [Finite G] (Z : Subgroup G) (x y : G)
    (hZ : ∀ z ∈ Z, z * x = x * z ∧ z * y = y * z) (hx : x ^ 3 ∈ Z) (hy : y ^ 3 ∈ Z)
    (hcx : (x * y * x⁻¹ * y⁻¹) * x * (x * y * x⁻¹ * y⁻¹)⁻¹ * x⁻¹ ∈ Z)
    (hcy : (x * y * x⁻¹ * y⁻¹) * y * (x * y * x⁻¹ * y⁻¹)⁻¹ * y⁻¹ ∈ Z) :
    Nat.card ↥(Z ⊔ Subgroup.closure ({x, y} : Set G)) ≤ 27 * Nat.card Z := by
  let H : Subgroup G := Z ⊔ Subgroup.closure ({x, y} : Set G)
  change Nat.card ↥H ≤ 27 * Nat.card Z
  have hZH : Z ≤ H := le_sup_left
  have hxH : x ∈ H := Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))
  have hyH : y ∈ H := Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))
  have hcH : x * y * x⁻¹ * y⁻¹ ∈ H :=
    H.mul_mem (H.mul_mem (H.mul_mem hxH hyH) (H.inv_mem hxH)) (H.inv_mem hyH)
  -- `Z` is normal in `H`: both `Z` (a subgroup) and `x, y` lie in the normalizer of `Z`.
  have hnorm : (Z.subgroupOf H).Normal := by
    rw [Subgroup.normal_subgroupOf_iff_le_normalizer hZH]
    change Z ⊔ Subgroup.closure ({x, y} : Set G) ≤ Subgroup.normalizer (Z : Set G)
    refine sup_le Subgroup.le_normalizer ?_
    rw [Subgroup.closure_le]
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact Subgroup.centralizer_le_normalizer (Z : Set G)
        ((Subgroup.mem_centralizer_iff).mpr fun z hz => (hZ z hz).1)
    · exact Subgroup.centralizer_le_normalizer (Z : Set G)
        ((Subgroup.mem_centralizer_iff).mpr fun z hz => (hZ z hz).2)
  haveI := hnorm
  -- The quotient `H ⧸ Z` has at most 27 elements.
  have hcard : Nat.card (↥H ⧸ Z.subgroupOf H) ≤ 27 := by
    set u : ↥H ⧸ Z.subgroupOf H :=
      QuotientGroup.mk (s := Z.subgroupOf H) (⟨x, hxH⟩ : ↥H) with hu_def
    set v : ↥H ⧸ Z.subgroupOf H :=
      QuotientGroup.mk (s := Z.subgroupOf H) (⟨y, hyH⟩ : ↥H) with hv_def
    set cq : ↥H ⧸ Z.subgroupOf H :=
      QuotientGroup.mk (s := Z.subgroupOf H) (⟨x * y * x⁻¹ * y⁻¹, hcH⟩ : ↥H) with hc_def
    have hgen : Subgroup.closure ({u, v} : Set (↥H ⧸ Z.subgroupOf H)) = ⊤ := by
      rw [hu_def, hv_def]
      exact closure_mk_eq_top Z x y hxH hyH
    have hu : u ^ 3 = 1 := by
      rw [hu_def, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
      simpa using hx
    have hv : v ^ 3 = 1 := by
      rw [hv_def, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
      simpa using hy
    have huv : u * v = cq * (v * u) := by
      rw [hu_def, hv_def, hc_def]
      simp only [← QuotientGroup.mk_mul]
      congr 1
      apply Subtype.ext
      simp only [Subgroup.coe_mul]
      group
    have hcu : Commute cq u := by
      show cq * u = u * cq
      have key : cq * u * cq⁻¹ * u⁻¹ = 1 := by
        rw [hc_def, hu_def]
        simp only [← QuotientGroup.mk_mul, ← QuotientGroup.mk_inv]
        rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
        simpa using hcx
      rw [show cq * u = (cq * u * cq⁻¹ * u⁻¹) * (u * cq) from by group, key, one_mul]
    have hcv : Commute cq v := by
      show cq * v = v * cq
      have key : cq * v * cq⁻¹ * v⁻¹ = 1 := by
        rw [hc_def, hv_def]
        simp only [← QuotientGroup.mk_mul, ← QuotientGroup.mk_inv]
        rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
        simpa using hcy
      rw [show cq * v = (cq * v * cq⁻¹ * v⁻¹) * (v * cq) from by group, key, one_mul]
    have hb := card_closure_pair_le_27 u v cq hu hv huv hcu hcv
    rwa [hgen, Subgroup.card_top] at hb
  have hZcard : Nat.card ↥(Z.subgroupOf H) = Nat.card ↥Z := by
    rw [← Subgroup.card_map_of_injective (f := Subgroup.subtype H) (K := Z.subgroupOf H)
        (Subgroup.subtype_injective H),
      Subgroup.map_subgroupOf_eq_of_le hZH]
  calc Nat.card ↥H = Nat.card (↥H ⧸ Z.subgroupOf H) * Nat.card ↥(Z.subgroupOf H) :=
        Subgroup.card_eq_card_quotient_mul_card_subgroup (Z.subgroupOf H)
    _ ≤ 27 * Nat.card ↥Z := by rw [hZcard]; exact Nat.mul_le_mul_right _ hcard

end Work.ThmF.ChV3.Prove
