/-!
# `Work.ThmF.ChV3.Prove.Kset_card_seven`

Peterfalvi II, Ch. V §3, case (10-2) (`Work.ThmF.ChV3.Case102`, the case `|P| = 3`,
`|C_Q(P)| = 8`, `|W| ∈ {3, 9}`): in that case the chain (1)–(5) gives
`|Q₀sub H| = 2 ^ |P| = 2³ = 8` (step (1), `Chain15.hQ0`), and since

* `K̄ = ⟨K(D,t)⟩ = K(D,t)` is a **cyclic normal subgroup** of `D = H ∩ Hᵗ`
  (Ch. V §1 Prop. 2, `Work.ThmF.ChV12.Ksub_cyclic_normal`),
* `|K(D,t)| = |Inv H|` (Ch. I §2 Prop. 1 (c), `Work.ThmF.Bender.cardKsetEqInv`),
* `Q₀sub H = Inv(H) ∪ {1}` (Ch. V §1 Prop. 1 (b)/(c), `Work.ThmF.L5.Q0sub_eq_Q0`),

the kernel `K = J(D,t)` has exactly `8 - 1 = 7` elements; being cyclic of prime order, it is
generated by each of its non-identity elements.

## Contents

* `Q0sub_eq_involutions_union` — `Q₀sub H = Inv(H) ∪ {1}` under commutativity of the
  involutions of `H`;
* `ncard_Kset_eq_Q0sub_sub_one` — the count `|K(D,t)| = |Q₀sub H| - 1` (Peterfalvi's
  `|K| = q - 1` with `q = |Q₀|`);
* `Kset_card_seven` — the target.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ThmF.ChV3.Prove

open LeanEval.GroupTheory.Defs

/-- `Q₀sub H = ⟨Q₀ H⟩ = Inv(H) ∪ {1}` as soon as the involutions of `H` commute pairwise
(Peterfalvi II, Ch. V §1 Prop. 1 (c): they always do in the split rank-one situation, see
`Work.ThmF.L5.involutions_commute`). -/
theorem Q0sub_eq_involutions_union {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hcomm : ∀ a ∈ Submission.Blueprint.involutions (H : Set G),
      ∀ b ∈ Submission.Blueprint.involutions (H : Set G), a * b = b * a) :
    (Work.ThmF.Q0sub H : Set G) =
      Submission.Blueprint.involutions (H : Set G) ∪ {1} := by
  rw [Work.ThmF.L5.Q0sub_eq_Q0 hcomm, Work.ThmF.Q0]

/-- **Peterfalvi II, Ch. V §1: `|K(D,t)| = |Q₀| - 1`.**  `K = J(D,t) = Kset H t` has as many
elements as `Q₀sub H` has non-identity elements: `|K| = |Inv H|` (Ch. I §2 Prop. 1 (c)) and
`Q₀sub H = Inv(H) ∪ {1}`. -/
theorem ncard_Kset_eq_Q0sub_sub_one {G : Type} [Group G] [Finite G] {H : Subgroup G} {t : G}
    (hcomm : ∀ a ∈ Submission.Blueprint.involutions (H : Set G),
      ∀ b ∈ Submission.Blueprint.involutions (H : Set G), a * b = b * a)
    (hSE : IsStronglyEmbedded H) (ht : orderOf t = 2) (htH : t ∉ H) :
    (Work.ThmF.Kset H t).ncard = Nat.card ↥(Work.ThmF.Q0sub H) - 1 := by
  have hcard := Work.ThmF.Bender.cardKsetEqInv hSE ht htH
  have hset := Q0sub_eq_involutions_union (H := H) hcomm
  have h1notin : (1 : G) ∉ Submission.Blueprint.involutions (H : Set G) := by
    rintro ⟨-, h⟩
    exact absurd h (by norm_num)
  have hncard : ((Work.ThmF.Q0sub H : Set G)).ncard
      = (Submission.Blueprint.involutions (H : Set G)).ncard + 1 := by
    rw [hset, Set.union_singleton, Set.ncard_insert_of_notMem h1notin (Set.toFinite _)]
  have hcoe : ((Work.ThmF.Q0sub H : Set G)).ncard = Nat.card (Work.ThmF.Q0sub H) :=
    (Nat.card_coe_set_eq (Work.ThmF.Q0sub H : Set G)).symm
  rw [hcard]
  omega

/-- **Case (10-2) of Ch. V §3: `K = J(D,t)` is a cyclic group of order `7`, and every
non-identity element of `K` generates it.**

From the chain (1)–(5), `|Q₀sub H| = 2 ^ |P|`, and `Case102` gives `|P| = 3`, so
`|Q₀| = 8`.  Ch. V §1 Prop. 2 makes `Ksub H t = ⟨Kset H t⟩` equal to `Kset H t` and cyclic,
while `|Kset H t| = |Q₀| - 1 = 7` (Ch. I §2 Prop. 1 (c) plus `Q₀ = Inv(H) ∪ {1}`).  A cyclic
group of prime order `7` is generated by each of its non-identity elements. -/
theorem Kset_card_seven {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G} {P : Subgroup G}
    (hFT : Submission.Blueprint.FeitThompsonProp) (hC4 : Submission.Blueprint.ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (h15 : Work.ThmF.ChV3.Chain15 H Q t s r P)
    (d : Work.ThmF.ChV3.Case102 H Q t s P) :
    (Work.ThmF.Ksub H t : Set G) = Work.ThmF.Kset H t ∧
      IsCyclic ↥(Work.ThmF.Ksub H t) ∧
      Nat.card ↥(Work.ThmF.Ksub H t) = 7 ∧
      (∀ k ∈ Work.ThmF.Kset H t, k ≠ 1 → Subgroup.zpowers k = Work.ThmF.Ksub H t) := by
  -- Ch. V §1 Prop. 2: `K̄ = K` is cyclic.
  obtain ⟨hcyc, hKsub_eq, -⟩ :=
    Work.ThmF.ChV12.Ksub_cyclic_normal hFT hC4 c.sit c.split
  have hcomm := Work.ThmF.L5.involutions_commute c.sit hC4 c.split
  -- step (1) plus `|P| = 3`: `|Q₀sub H| = 8`.
  have hQ0card : Nat.card ↥(Work.ThmF.Q0sub H) = 8 := by
    rw [h15.hQ0, d.p3]
    norm_num
  -- `|Kset H t| = |Q₀sub H| - 1 = 7`.
  have hKsetcard : (Work.ThmF.Kset H t).ncard = 7 := by
    have h := ncard_Kset_eq_Q0sub_sub_one (H := H) (t := t) hcomm c.split.stronglyEmbedded
      c.split.invol c.split.not_mem
    omega
  -- `|K̄| = |Kset| = 7`.
  have hKsubcard : Nat.card ↥(Work.ThmF.Ksub H t) = 7 := by
    rw [← Set.ncard_univ (α := ↥(Work.ThmF.Ksub H t)), Set.ncard_coe, hKsub_eq]
    exact hKsetcard
  refine ⟨hKsub_eq, hcyc, hKsubcard, ?_⟩
  -- a cyclic group of order `7` is generated by each non-identity element
  intro k hk hk1
  have hkK : k ∈ Work.ThmF.Ksub H t := by
    have h2 : k ∈ ((Work.ThmF.Ksub H t : Set G)) := by rw [hKsub_eq]; exact hk
    exact h2
  have hdvd : orderOf k ∣ 7 := by
    have h := Subgroup.orderOf_dvd_natCard (Work.ThmF.Ksub H t) hkK
    rwa [hKsubcard] at h
  have hne : orderOf k ≠ 1 := fun h => hk1 (orderOf_eq_one_iff.mp h)
  have hord : orderOf k = 7 := by
    rcases (Nat.dvd_prime Nat.prime_seven).mp hdvd with h | h
    · exact absurd h hne
    · exact h
  have hle : Subgroup.zpowers k ≤ Work.ThmF.Ksub H t := Subgroup.zpowers_le.mpr hkK
  have hcard : Nat.card ↥(Work.ThmF.Ksub H t) ≤ Nat.card ↥(Subgroup.zpowers k) := by
    rw [hKsubcard, Nat.card_zpowers, hord]
  exact Subgroup.eq_of_le_of_card_ge hle hcard

end Work.ThmF.ChV3.Prove
