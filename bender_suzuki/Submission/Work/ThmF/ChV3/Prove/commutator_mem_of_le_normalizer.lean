open scoped Pointwise

namespace Work.ThmF.ChV3.Prove

/-- If `P` lies in the normalizer of `W` and `P` is abelian, then every element of the
subgroup generated by `W` and `P` is a product `w * p` with `w ∈ W`, `p ∈ P`; hence the
quotient `(W ⊔ P)/W` is abelian and every commutator of two elements of `W ⊔ P` lies in `W`. -/
theorem commutator_mem_of_le_normalizer {G : Type} [Group G] {W P : Subgroup G}
    (hPW : P ≤ Subgroup.normalizer (W : Set G))
    (hPcomm : ∀ p ∈ P, ∀ q ∈ P, p * q = q * p) :
    ∀ a ∈ W ⊔ P, ∀ b ∈ W ⊔ P, a * b * a⁻¹ * b⁻¹ ∈ W := by
  intro a ha b hb
  -- Every element of `W ⊔ P` is of the form `w * p`.
  have hset : (↑(W ⊔ P) : Set G) = (W : Set G) * (P : Set G) :=
    Subgroup.coe_mul_of_right_le_normalizer_left W P hPW
  have ha' : a ∈ (↑(W ⊔ P) : Set G) := ha
  have hb' : b ∈ (↑(W ⊔ P) : Set G) := hb
  rw [hset] at ha' hb'
  obtain ⟨w1, hw1, p1, hp1, ha_eq⟩ := ha'
  obtain ⟨w2, hw2, p2, hp2, hb_eq⟩ := hb'
  subst ha_eq
  subst hb_eq
  -- `p₁ p₂ p₁⁻¹ = p₂` since `P` is abelian.
  have hab : p1 * p2 * p1⁻¹ = p2 := by
    rw [hPcomm p1 hp1 p2 hp2]; group
  -- The two conjugates lie in `W` because `P` normalizes `W`.
  have hu : p1 * w2 * p1⁻¹ ∈ W := (Subgroup.le_normalizer_iff.mp hPW) p1 hp1 w2 hw2
  have hv : p2 * w1⁻¹ * p2⁻¹ ∈ W :=
    (Subgroup.le_normalizer_iff.mp hPW) p2 hp2 w1⁻¹ (W.inv_mem hw1)
  have hE : (w1 * p1) * (w2 * p2) * (w1 * p1)⁻¹ * (w2 * p2)⁻¹
      = w1 * (p1 * w2 * p1⁻¹) * (p2 * w1⁻¹ * p2⁻¹) * w2⁻¹ := by
    calc (w1 * p1) * (w2 * p2) * (w1 * p1)⁻¹ * (w2 * p2)⁻¹
        = w1 * (p1 * w2 * p1⁻¹) * (p1 * p2 * p1⁻¹) * (w1⁻¹ * p2⁻¹) * w2⁻¹ := by group
      _ = w1 * (p1 * w2 * p1⁻¹) * p2 * (w1⁻¹ * p2⁻¹) * w2⁻¹ := by rw [hab]
      _ = w1 * (p1 * w2 * p1⁻¹) * (p2 * w1⁻¹ * p2⁻¹) * w2⁻¹ := by group
  rw [hE]
  exact W.mul_mem (W.mul_mem (W.mul_mem hw1 hu) hv) (W.inv_mem hw2)

end Work.ThmF.ChV3.Prove
