import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.ThmF.ChV3.Prove

/-- In an abelian subgroup `R`, if `T ≤ R`, `P ≤ R` with `T ⊓ P = ⊥` and `P` of prime order,
then for `x₀ ∈ T` of order dividing `|P|` (with `x₀ ≠ 1`) and `1 ≠ b₀ ∈ P`, the cyclic group
generated by `x₀ * b₀` lies in `R`, has order `|P|`, is not contained in `T` and is not equal
to `P`. -/
theorem zpowers_mul_outside_T {G : Type} [Group G] [Finite G] {R T P : Subgroup G}
    (hcomm : IsMulCommutative ↥R) (hTR : T ≤ R) (hPR : P ≤ R) (hTP : T ⊓ P = ⊥)
    (hp : (Nat.card P).Prime) {x₀ b₀ : G} (hx₀T : x₀ ∈ T)
    (hx₀p : x₀ ^ Nat.card P = 1) (hx₀ne : x₀ ≠ 1)
    (hb₀P : b₀ ∈ P) (hb₀ne : b₀ ≠ 1) :
    Subgroup.zpowers (x₀ * b₀) ≤ R ∧ Nat.card ↥(Subgroup.zpowers (x₀ * b₀)) = Nat.card P ∧
      ¬ Subgroup.zpowers (x₀ * b₀) ≤ T ∧ Subgroup.zpowers (x₀ * b₀) ≠ P := by
  set y := x₀ * b₀ with hy_def
  have hxR : x₀ ∈ R := hTR hx₀T
  have hbR : b₀ ∈ R := hPR hb₀P
  -- `x₀` and `b₀` commute because both live in the abelian subgroup `R`.
  have hcomm' : Commute x₀ b₀ := by
    rw [commute_iff_eq]
    have h : (⟨x₀, hxR⟩ : ↥R) * ⟨b₀, hbR⟩ = ⟨b₀, hbR⟩ * ⟨x₀, hxR⟩ :=
      IsMulCommutative.is_comm.comm _ _
    simpa using congrArg Subtype.val h
  -- `b₀` has order dividing `|P|`, hence `b₀ ^ |P| = 1`.
  have hb₀_dvd : orderOf b₀ ∣ Nat.card P := Subgroup.orderOf_dvd_natCard P hb₀P
  have hb₀_pow : b₀ ^ Nat.card P = 1 := (orderOf_dvd_iff_pow_eq_one).mp hb₀_dvd
  have hy_pow : y ^ Nat.card P = 1 := by
    rw [hy_def, hcomm'.mul_pow, hx₀p, hb₀_pow, one_mul]
  -- `y ≠ 1`, else `b₀ = x₀⁻¹ ∈ T` contradicting `T ⊓ P = ⊥`.
  have hy_ne : y ≠ 1 := by
    intro hy1
    have hb₀T : b₀ ∈ T := by
      have h : b₀ = x₀⁻¹ := by
        have := congrArg (fun z => x₀⁻¹ * z) hy1
        simpa [hy_def, mul_assoc] using this
      rw [h]
      exact T.inv_mem hx₀T
    have : b₀ ∈ (T ⊓ P : Subgroup G) := ⟨hb₀T, hb₀P⟩
    rw [hTP] at this
    exact hb₀ne (Subgroup.mem_bot.mp this)
  have : Fact (Nat.card P).Prime := ⟨hp⟩
  -- Since `|P|` is prime, `y ^ |P| = 1` and `y ≠ 1` force `orderOf y = |P|`.
  have horder : orderOf y = Nat.card P := orderOf_eq_prime hy_pow hy_ne
  have hcard : Nat.card ↥(Subgroup.zpowers (x₀ * b₀)) = Nat.card P := by
    rw [Nat.card_zpowers]
    simpa [hy_def] using horder
  have hleR : Subgroup.zpowers (x₀ * b₀) ≤ R :=
    Subgroup.zpowers_le.mpr (R.mul_mem hxR hbR)
  have hnotT : ¬ Subgroup.zpowers (x₀ * b₀) ≤ T := by
    intro hle
    have hyT : x₀ * b₀ ∈ T := hle (Subgroup.mem_zpowers (x₀ * b₀))
    have hb₀T : b₀ ∈ T := by
      have hmem : x₀⁻¹ * (x₀ * b₀) ∈ T := T.mul_mem (T.inv_mem hx₀T) hyT
      simpa [mul_assoc] using hmem
    have : b₀ ∈ (T ⊓ P : Subgroup G) := ⟨hb₀T, hb₀P⟩
    rw [hTP] at this
    exact hb₀ne (Subgroup.mem_bot.mp this)
  have hneP : Subgroup.zpowers (x₀ * b₀) ≠ P := by
    intro heq
    have hyP : x₀ * b₀ ∈ P := heq ▸ Subgroup.mem_zpowers (x₀ * b₀)
    have hx₀P : x₀ ∈ P := by
      have hmem : (x₀ * b₀) * b₀⁻¹ ∈ P := P.mul_mem hyP (P.inv_mem hb₀P)
      simpa [mul_assoc] using hmem
    have : x₀ ∈ (T ⊓ P : Subgroup G) := ⟨hx₀T, hx₀P⟩
    rw [hTP] at this
    exact hx₀ne (Subgroup.mem_bot.mp this)
  exact ⟨hleR, hcard, hnotT, hneP⟩

end Work.ThmF.ChV3.Prove
