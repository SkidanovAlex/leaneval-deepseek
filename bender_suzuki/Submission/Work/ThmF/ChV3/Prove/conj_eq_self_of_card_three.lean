/-!
# An element of order `3` normalising a subgroup of order `3` centralises it

Let `A ≤ G` be a subgroup of order `3` and let `b ∈ N_G(A)` with `b ^ 3 = 1`.
Then `b` centralises `A`: `b * a * b⁻¹ = a` for every `a ∈ A`.

Conjugation by `b` restricts to an automorphism `φ` of `A` with `φ ^ 3 = 1`.  Since
`|A| = 3`, the group `A` is cyclic of order `3`, generated by any `a ≠ 1`; writing
`φ a = a ^ k` with `k ∈ {1, 2}` we get a contradiction in the case `k = 2`, because
`φ ^ 3 a = a` while `φ ^ 2 a = a` forces `φ a = a`.  Hence `φ a = a` for every generator,
i.e. `φ = 1`.
-/

/-- The automorphism of `X` induced by conjugation with an element `u` of `N_G(X)`. -/
private noncomputable def conjAutOf {G : Type*} [Group G] {X : Subgroup G} {u : G}
    (hu : u ∈ Subgroup.normalizer (X : Set G)) : MulAut ↥X :=
  Subgroup.normalizerMonoidHom X ⟨u, hu⟩

/-- `conjAutOf hu` acts on a point by conjugation by `u` in the ambient group. -/
private lemma conjAutOf_coe {G : Type*} [Group G] {X : Subgroup G} {u : G}
    (hu : u ∈ Subgroup.normalizer (X : Set G)) (x : ↥X) :
    ((conjAutOf hu x : ↥X) : G) = u * (x : G) * u⁻¹ := by
  rw [conjAutOf,
    show Subgroup.normalizerMonoidHom X ⟨u, hu⟩
        = MulDistribMulAction.toMulAut ↥(Subgroup.normalizer (X : Set G)) ↥X ⟨u, hu⟩ from rfl,
    MulDistribMulAction.toMulAut_apply, MulDistribMulAction.toMulEquiv_apply]
  exact Subgroup.smul_coe X ⟨u, hu⟩ x

/-- If `u ^ 3 = 1` then the induced automorphism also satisfies `conjAutOf hu ^ 3 = 1`. -/
private lemma conjAutOf_pow_three {G : Type*} [Group G] {X : Subgroup G} {u : G}
    (hu : u ∈ Subgroup.normalizer (X : Set G)) (hu3 : u ^ 3 = 1) :
    conjAutOf hu ^ 3 = 1 := by
  rw [conjAutOf, ← map_pow]
  have h3 : (⟨u, hu⟩ : ↥(Subgroup.normalizer (X : Set G))) ^ 3 = 1 := by
    apply Subtype.ext
    simpa using hu3
  rw [h3, map_one]

/-- In a group, the cyclic subgroup generated by an element `x` with `x ^ 3 = 1` consists only
of `1`, `x` and `x ^ 2`. -/
private lemma mem_zpowers_eq_one_or_self_or_sq {H : Type*} [Group H] {x y : H}
    (hx : x ^ 3 = 1) (hy : y ∈ Subgroup.zpowers x) :
    y = 1 ∨ y = x ∨ y = x ^ 2 := by
  rw [Subgroup.mem_zpowers_iff] at hy
  obtain ⟨n, rfl⟩ := hy
  have h1 : x ^ n = x ^ (n % (3:ℤ)) := zpow_eq_zpow_emod' n hx
  rw [h1]
  have hcases : n % (3:ℤ) = 0 ∨ n % (3:ℤ) = 1 ∨ n % (3:ℤ) = 2 := by
    have hge := Int.emod_nonneg n (by norm_num : (3:ℤ) ≠ 0)
    have hlt := Int.emod_lt_of_pos n (by norm_num : (0:ℤ) < 3)
    omega
  rcases hcases with h | h | h
  · left; rw [h]; simp
  · right; left; rw [h]; simp
  · right; right; rw [h]; simp [pow_two]

theorem conj_eq_self_of_card_three {G : Type*} [Group G] {A : Subgroup G} {b : G}
    (hcard : Nat.card ↥A = 3) (hb : b ∈ Subgroup.normalizer (A : Set G)) (hb3 : b ^ 3 = 1) :
    ∀ a ∈ A, b * a * b⁻¹ = a := by
  have hfin : Finite ↥A := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  haveI := hfin
  -- The automorphism of `A` induced by conjugation with `b`.
  set φ : MulAut ↥A := conjAutOf hb with hφdef
  have hφcoe : ∀ x : ↥A, ((φ x : ↥A) : G) = b * (x : G) * b⁻¹ := by
    intro x; rw [hφdef]; exact conjAutOf_coe hb x
  have hφ3 : φ ^ 3 = 1 := by rw [hφdef]; exact conjAutOf_pow_three hb hb3
  -- Every element of `A` is fixed by `φ`.
  have hfix : ∀ y : ↥A, φ y = y := by
    intro y
    by_cases hy1 : y = 1
    · rw [hy1, map_one]
    · -- `y ≠ 1`, so `y` has order `3` and generates `A`.
      have hy3 : orderOf y = 3 := by
        have hdvd : orderOf y ∣ Nat.card ↥A := orderOf_dvd_natCard y
        rw [hcard] at hdvd
        rcases Nat.prime_three.eq_one_or_self_of_dvd (orderOf y) hdvd with h | h
        · exact absurd (orderOf_eq_one_iff.mp h) hy1
        · exact h
      have hy3n : y ^ 3 = 1 := by rw [← hy3]; exact pow_orderOf_eq_one y
      have htop : Subgroup.zpowers y = ⊤ :=
        Subgroup.eq_top_of_card_eq (Subgroup.zpowers y)
          (by rw [Nat.card_zpowers, hy3, hcard])
      have hmem : φ y ∈ Subgroup.zpowers y := by rw [htop]; exact Subgroup.mem_top _
      -- `φ y` is a power of `y`, hence `1`, `y` or `y ^ 2`.
      rcases mem_zpowers_eq_one_or_self_or_sq hy3n hmem with h | h | h
      · exact absurd (φ.injective (by rw [h, map_one])) hy1
      · exact h
      · -- Case `φ y = y ^ 2`: applying `φ` twice returns `y`, so `φ y = φ ^ 3 y = y`.
        exfalso
        have hy4 : y ^ 4 = y := by
          rw [show (4:ℕ) = 3 + 1 by norm_num, pow_add, hy3n, one_mul, pow_one]
        have hφ2 : φ (φ y) = y := by
          rw [h, map_pow, h, ← pow_mul, show (2:ℕ) * 2 = 4 by norm_num, hy4]
        have hcontra : φ y = y := by
          have h1 : φ (φ (φ y)) = φ y := congrArg φ hφ2
          have h2 : φ (φ (φ y)) = y := by
            have h3y : (φ ^ 3) y = y := by rw [hφ3]; rfl
            have e : φ (φ (φ y)) = (φ ^ 3) y := by rw [pow_three]; rfl
            rw [e, h3y]
          rw [← h1, h2]
        have hyy : y = y ^ 2 := hcontra.symm.trans h
        have hy1' : y = 1 := by
          have hh : y * 1 = y * y := by rw [mul_one, ← pow_two]; exact hyy
          exact (mul_left_cancel hh).symm
        exact hy1 hy1'
  intro a ha
  have hfixa := hfix ⟨a, ha⟩
  have hcoe := hφcoe ⟨a, ha⟩
  rw [hfixa] at hcoe
  exact hcoe.symm

end Work.ThmF.ChV3.Prove
