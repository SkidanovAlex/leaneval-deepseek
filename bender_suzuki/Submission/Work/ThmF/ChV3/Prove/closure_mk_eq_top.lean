namespace Work.ThmF.ChV3.Prove

/-- Auxiliary form of `closure_mk_eq_top`, stated for an abstract subgroup `H` that is
generated by `Z` together with `x` and `y`.  In `H ⧸ (Z.subgroupOf H)` the images of
`x` and `y` generate the whole quotient. -/
private lemma aux {G : Type*} [Group G] (Z H : Subgroup G) (x y : G)
    (hxH : x ∈ H) (hyH : y ∈ H) (hH : H = Z ⊔ Subgroup.closure ({x, y} : Set G))
    [hN : (Z.subgroupOf H).Normal] :
    Subgroup.closure
      ({(QuotientGroup.mk (s := Z.subgroupOf H) (⟨x, hxH⟩ : H)),
        (QuotientGroup.mk (s := Z.subgroupOf H) (⟨y, hyH⟩ : H))}
        : Set (H ⧸ Z.subgroupOf H)) = ⊤ := by
  -- `Z` is a subgroup of `H`
  have hZH : Z ≤ H := hH ▸ le_sup_left
  -- the quotient projection
  let φ : H →* (H ⧸ Z.subgroupOf H) := QuotientGroup.mk' (Z.subgroupOf H)
  have hφsurj : Function.Surjective φ := QuotientGroup.mk'_surjective (Z.subgroupOf H)
  -- `H` is generated, inside itself, by `Z` and the two elements `x`, `y`
  have hgen : Subgroup.closure
      ((Z.subgroupOf H : Set H) ∪ ({⟨x, hxH⟩, ⟨y, hyH⟩} : Set H)) = ⊤ := by
    apply Subgroup.map_injective (Subgroup.subtype_injective H)
    rw [Subgroup.map_top, Subgroup.range_subtype]
    rw [MonoidHom.map_closure, Set.image_union]
    have himgZ : H.subtype '' (Z.subgroupOf H : Set H) = (Z : Set G) := by
      ext g
      constructor
      · rintro ⟨h, hh, rfl⟩
        exact Subgroup.mem_subgroupOf.mp hh
      · intro hg
        exact ⟨⟨g, hZH hg⟩, Subgroup.mem_subgroupOf.mpr hg, rfl⟩
    have himgxy : H.subtype '' ({⟨x, hxH⟩, ⟨y, hyH⟩} : Set H) = ({x, y} : Set G) := by
      rw [Set.image_pair]; rfl
    rw [himgZ, himgxy, Subgroup.closure_union, Subgroup.closure_eq, ← hH]
  -- the subgroup generated by the two images in the quotient
  set M : Subgroup (H ⧸ Z.subgroupOf H) :=
    Subgroup.closure ({(QuotientGroup.mk (s := Z.subgroupOf H) (⟨x, hxH⟩ : H)),
        (QuotientGroup.mk (s := Z.subgroupOf H) (⟨y, hyH⟩ : H))} : Set (H ⧸ Z.subgroupOf H))
    with hM
  have hφker : φ.ker = Z.subgroupOf H := QuotientGroup.ker_mk' (Z.subgroupOf H)
  -- the preimage of `M` is everything
  have hC : Subgroup.closure ((Z.subgroupOf H : Set H) ∪ ({⟨x, hxH⟩, ⟨y, hyH⟩} : Set H)) ≤
      Subgroup.comap φ M := by
    rw [Subgroup.closure_le]
    rintro g (hg | hg)
    · have hg1 : φ g = 1 := MonoidHom.mem_ker.mp (by rw [hφker]; simpa using hg)
      exact Subgroup.mem_comap.mpr (by rw [hg1]; exact Subgroup.one_mem M)
    · refine Subgroup.mem_comap.mpr ?_
      rw [hM]
      rcases hg with rfl | rfl
      · exact Subgroup.subset_closure
          (by rw [Set.mem_insert_iff, Set.mem_singleton_iff]; exact Or.inl rfl)
      · exact Subgroup.subset_closure
          (by rw [Set.mem_insert_iff, Set.mem_singleton_iff]; exact Or.inr rfl)
  have hcomap : Subgroup.comap φ M = ⊤ := by
    rw [eq_top_iff]
    calc (⊤ : Subgroup H) =
          Subgroup.closure ((Z.subgroupOf H : Set H) ∪ ({⟨x, hxH⟩, ⟨y, hyH⟩} : Set H)) :=
          hgen.symm
      _ ≤ Subgroup.comap φ M := hC
  -- hence `M` is everything
  have hMtop : M = ⊤ := by
    have hφrange : φ.range = ⊤ := QuotientGroup.range_mk' (Z.subgroupOf H)
    calc M = (⊤ : Subgroup (H ⧸ Z.subgroupOf H)) ⊓ M := (top_inf_eq M).symm
      _ = φ.range ⊓ M := by rw [hφrange]
      _ = Subgroup.map φ (Subgroup.comap φ M) := (Subgroup.map_comap_eq φ M).symm
      _ = Subgroup.map φ ⊤ := by rw [hcomap]
      _ = ⊤ := Subgroup.map_top_of_surjective φ hφsurj
  exact hMtop

theorem closure_mk_eq_top {G : Type*} [Group G] (Z : Subgroup G) (x y : G)
    (hxH : x ∈ Z ⊔ Subgroup.closure ({x, y} : Set G))
    (hyH : y ∈ Z ⊔ Subgroup.closure ({x, y} : Set G))
    [hN : (Z.subgroupOf (Z ⊔ Subgroup.closure ({x, y} : Set G))).Normal] :
    Subgroup.closure
      ({(QuotientGroup.mk (s := Z.subgroupOf (Z ⊔ Subgroup.closure ({x, y} : Set G)))
            (⟨x, hxH⟩ : ↥(Z ⊔ Subgroup.closure ({x, y} : Set G)))),
        (QuotientGroup.mk (s := Z.subgroupOf (Z ⊔ Subgroup.closure ({x, y} : Set G)))
            (⟨y, hyH⟩ : ↥(Z ⊔ Subgroup.closure ({x, y} : Set G))))}
        : Set (↥(Z ⊔ Subgroup.closure ({x, y} : Set G)) ⧸ Z.subgroupOf (Z ⊔ Subgroup.closure ({x, y} : Set G)))) = ⊤ := by
  exact aux Z (Z ⊔ Subgroup.closure ({x, y} : Set G)) x y hxH hyH rfl

end Work.ThmF.ChV3.Prove
