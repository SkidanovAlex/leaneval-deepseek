import Mathlib
import Submission.Work.ThmF.ChV12.L6basic
import Submission.Work.ThmF.ChV12.Lemma5Defs

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `W` centralises `X = ⟨Q₀, K, t⟩`

Peterfalvi II, Ch. V §2 Lemma 5: with `X = ⟨Q₀, K, t⟩` (`Work.ThmF.Lemma5.X5`), the subgroup
`W = C_V(K)` (`Work.ThmF.W`) centralises `X`.  Since `X` is generated by the three sets
`Q₀ = Inv(H) ∪ {1}`, `K = J(D,t)` and `{t}`, and centralising a generated subgroup is the same as
centralising a generating set, this reduces to three commuting statements:

* `W ≤ C(t)`: `W ≤ centD H t = twoPoint H t ⊓ C({t})` (definitional);
* `W ≤ C(K)`: `W = centD H t ⊓ C(Kset H t)` (definitional);
* `W ≤ C(Q₀ ⊆ Q₀sub)`: `W ≤ C(Q0sub H)` is `Work.ThmF.ChV12.W_le_centralizer_Q0sub`, which is
  exactly Peterfalvi II Ch. II §4 Prop. 4, `W = D ⊓ C_G(Inv H)` — the one place where the
  hypothesis `hC4 : ChIIFourProp` is used.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ThmF.ChV3.Prove

theorem W_le_centralizer_X5 {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t : G}
    (hC4 : Submission.Blueprint.ChIIFourProp) (hS : Submission.Blueprint.Situation G)
    (h : Submission.Blueprint.IsSplitRankOne H Q t) :
    Work.ThmF.W H t ≤ Subgroup.centralizer (Work.ThmF.Lemma5.X5 H t : Set G) := by
  -- `W` centralises `Q₀`: `W ≤ C(Q0sub H)` (Ch. II §4 Prop. 4) and `Q₀ ⊆ Q0sub H`.
  have hQ0 : Work.ThmF.W H t ≤ Subgroup.centralizer (Work.ThmF.Q0 H : Set G) :=
    (Work.ThmF.ChV12.W_le_centralizer_Q0sub hC4 hS h).trans
      (Subgroup.centralizer_le (s := Work.ThmF.Q0 H)
        (t := (Work.ThmF.Q0sub H : Set G)) (Work.ThmF.Q0_le_Q0sub H))
  -- `W` centralises `K` (definitional, second factor of `W = centD H t ⊓ C(Kset H t)`).
  have hK : Work.ThmF.W H t ≤ Subgroup.centralizer (Work.ThmF.Kset H t : Set G) :=
    fun x hx => (Subgroup.mem_inf.mp hx).2
  -- `W` centralises `t` (`W ≤ centD H t ≤ C({t})`).
  have ht : Work.ThmF.W H t ≤ Subgroup.centralizer ({t} : Set G) :=
    fun x hx => (Subgroup.mem_inf.mp (Work.ThmF.W_le_centD H t hx)).2
  intro x hx
  -- `X = ⟨Q₀ ∪ K ∪ {t}⟩`; centralising a closure is centralising the generating set.
  rw [Work.ThmF.Lemma5.X5, Subgroup.centralizer_closure, Subgroup.mem_centralizer_iff]
  intro y hy
  rcases hy with (hyQ0 | hyK) | hyt
  · exact Subgroup.mem_centralizer_iff.mp (hQ0 hx) y hyQ0
  · exact Subgroup.mem_centralizer_iff.mp (hK hx) y hyK
  · exact Subgroup.mem_centralizer_iff.mp (ht hx) y hyt

end Work.ThmF.ChV3.Prove
