/-!
# Peterfalvi I Ch. I §6 Lemma 2 (coprime generation)

Let `X` be a subgroup of odd order of a finite group `M`, `u` an involution normalising `X` with
`X ⊔ ⟨u⟩ = ⊤`, and `M` acts by automorphisms on a finite **solvable** group `Y` of order prime to
`|M|`.  Then `Y` is generated by the common fixed points of `J(X,u) = {x ∈ X | u x u⁻¹ = x⁻¹}`
together with the fixed points of the involutions of `M`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

open scoped Pointwise
open LeanEval.GroupTheory.Defs

namespace Work.DoubleTransitivity.Sec6

variable {M : Type} [Group M] [Finite M]

/-- The set `J(X,u) = {x ∈ X | u x u⁻¹ = x⁻¹}` (Peterfalvi's `J(X,u)`). -/
def Jset (X : Subgroup M) (u : M) : Set M := {x : M | x ∈ X ∧ u * x * u⁻¹ = x⁻¹}

theorem mem_Jset {X : Subgroup M} {u x : M} :
    x ∈ Jset X u ↔ x ∈ X ∧ u * x * u⁻¹ = x⁻¹ := Iff.rfl

theorem Jset_subset (X : Subgroup M) (u : M) : Jset X u ⊆ X := fun _ hx => hx.1

theorem Jset_inv {X : Subgroup M} {u : M} {x : M} (hx : x ∈ Jset X u) :
    x⁻¹ ∈ Jset X u := by
  refine ⟨X.inv_mem hx.1, ?_⟩
  have h : u * x⁻¹ * u⁻¹ = (u * x * u⁻¹)⁻¹ := by group
  rw [h, hx.2]

/-- `J(X,u)` agrees with `Work.DoubleTransitivity.commutatorSet u X` (Peterfalvi App. I (1)(b)). -/
theorem commutatorSet_eq_Jset {X : Subgroup M} {u : M} (hu : orderOf u = 2)
    (hodd : Odd (Nat.card ↥X)) (hnorm : u ∈ Subgroup.normalizer (X : Set M)) :
    Work.DoubleTransitivity.commutatorSet u X = Jset X u := by
  apply Set.Subset.antisymm
  · exact Work.DoubleTransitivity.App1.commutatorSet_subset_invertedBy hu hnorm
  · exact Work.DoubleTransitivity.App1.invertedBy_subset_commutatorSet hu hodd

/-- Elements of `J(X,u)` are commutators `u⁻¹ z⁻¹ u z` with `z ∈ X`. -/
theorem exists_commutator_of_mem_Jset {X : Subgroup M} {u x : M} (hu : orderOf u = 2)
    (hodd : Odd (Nat.card ↥X)) (hnorm : u ∈ Subgroup.normalizer (X : Set M))
    (hx : x ∈ Jset X u) : ∃ z ∈ X, x = u⁻¹ * z⁻¹ * u * z := by
  rw [← commutatorSet_eq_Jset hu hodd hnorm] at hx
  obtain ⟨z, hz, rzx⟩ := hx
  exact ⟨z, hz, rzx⟩

/-- The commutator identity of App. I (4): `y⁻¹ [u,z] y = [u,y]⁻¹ [u,zy]`, written with the
inverse `u⁻¹` so that it is a free-group identity. -/
theorem conj_commutator_identity (u y z : M) :
    y⁻¹ * (u⁻¹ * z⁻¹ * u * z) * y
      = (u⁻¹ * y⁻¹ * u * y)⁻¹ * (u⁻¹ * (z * y)⁻¹ * u * (z * y)) := by
  group

/-- A commutator of an element of `X` lies in `⟨J(X,u)⟩`. -/
theorem commutator_mem_closure_Jset {X : Subgroup M} {u : M} (hu : orderOf u = 2)
    (hodd : Odd (Nat.card ↥X)) (hnorm : u ∈ Subgroup.normalizer (X : Set M))
    {w : M} (hw : w ∈ X) :
    u⁻¹ * w⁻¹ * u * w ∈ Subgroup.closure (Jset X u) := by
  refine Subgroup.subset_closure ?_
  rw [← commutatorSet_eq_Jset hu hodd hnorm]
  exact ⟨w, hw, rfl⟩

/-- `X` normalises `⟨J(X,u)⟩`. -/
theorem conj_mem_closure_Jset {X : Subgroup M} {u : M} (hu : orderOf u = 2)
    (hodd : Odd (Nat.card ↥X)) (hnorm : u ∈ Subgroup.normalizer (X : Set M)) :
    ∀ y ∈ X, ∀ s ∈ Jset X u, y * s * y⁻¹ ∈ Subgroup.closure (Jset X u) := by
  intro y hy s hs
  obtain ⟨z, hz, rfl⟩ := exists_commutator_of_mem_Jset hu hodd hnorm hs
  rw [show y * (u⁻¹ * z⁻¹ * u * z) * y⁻¹
      = (y⁻¹)⁻¹ * (u⁻¹ * z⁻¹ * u * z) * y⁻¹ from by group]
  rw [conj_commutator_identity]
  have h1 := commutator_mem_closure_Jset hu hodd hnorm (X.inv_mem hy)
  have h2 := commutator_mem_closure_Jset hu hodd hnorm (X.mul_mem hz (X.inv_mem hy))
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _ h1) h2

/-- `u` normalises `⟨J(X,u)⟩`. -/
theorem conj_u_closure_Jset {X : Subgroup M} {u : M} (hu : orderOf u = 2) :
    ∀ s ∈ Jset X u, u * s * u⁻¹ ∈ Subgroup.closure (Jset X u) := by
  intro s hs
  have hsu : u * s * u⁻¹ = s⁻¹ := hs.2
  rw [hsu]
  exact Subgroup.subset_closure (Jset_inv hs)

/-! ## The main theorem -/

theorem coprime_generation_aux {M : Type} [Group M] [Finite M]
    {X : Subgroup M} (hXodd : Odd (Nat.card X)) {u : M} (hu : orderOf u = 2)
    (huX : ∀ x ∈ X, u * x * u⁻¹ ∈ X) (htop : X ⊔ Subgroup.zpowers u = ⊤) :
    ∀ (n : ℕ), ∀ (Y : Type) [Group Y] [Finite Y] [MulDistribMulAction M Y],
      Nat.card Y = n → Nat.Coprime (Nat.card M) (Nat.card Y) → Group.IsSolvable Y →
      Subgroup.closure
        (({y : Y | ∀ x : M, x ∈ X → u * x * u⁻¹ = x⁻¹ → x • y = y} : Set Y) ∪
          (⋃ v ∈ ({v : M | orderOf v = 2} : Set M), ({y : Y | v • y = y} : Set Y))) = ⊤ := by
  intro n
  refine Nat.strong_induction_on n ?_
  intro n ih Y _GY _FY _actY hYcard hcop hsolv
  have hu2 : u * u = 1 := Work.DoubleTransitivity.App1.mul_self_eq_one_of_orderOf_eq_two hu
  have hnorm : u ∈ Subgroup.normalizer (X : Set M) := by
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx; exact huX x hx
    · intro hx
      have h := huX (u * x * u⁻¹) hx
      rwa [show u * (u * x * u⁻¹) * u⁻¹ = x from by
        calc u * (u * x * u⁻¹) * u⁻¹ = (u*u) * x * (u⁻¹*u⁻¹) := by group
          _ = x := by rw [hu2, ← mul_inv_rev, hu2, inv_one, one_mul, mul_one]] at h
  let A : Subgroup M := Subgroup.closure (Jset X u)
  have hAleX : A ≤ X := (Subgroup.closure_le X).mpr (Jset_subset X u)
  have hAodd : Odd (Nat.card ↥A) :=
    Nat.not_even_iff_odd.mp fun hev =>
      (Nat.not_even_iff_odd.mpr hXodd)
        (even_iff_two_dvd.mpr
          (dvd_trans (even_iff_two_dvd.mp hev) (Subgroup.card_dvd_of_le hAleX)))
  -- `X` normalises `A`
  have hXnorm : X ≤ Subgroup.normalizer (A : Set M) := by
    rw [Subgroup.le_normalizer_iff]
    intro y hy n hn
    have hmap : A ≤ Subgroup.comap (MulAut.conj y).toMonoidHom A := by
      show Subgroup.closure (Jset X u) ≤ Subgroup.comap (MulAut.conj y).toMonoidHom A
      rw [Subgroup.closure_le]
      intro s hs
      exact Subgroup.mem_comap.mpr (by
        simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using
          conj_mem_closure_Jset hu hXodd hnorm y hy s hs)
    have h2 : (MulAut.conj y).toMonoidHom n ∈ A := Subgroup.mem_comap.mp (hmap hn)
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using h2
  -- `u` normalises `A`
  have huNorm : u ∈ Subgroup.normalizer (A : Set M) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    have hφ : A.map (MulAut.conj u).toMonoidHom ≤ A := by
      have h1 : A.map (MulAut.conj u).toMonoidHom =
          Subgroup.closure ((MulAut.conj u).toMonoidHom '' Jset X u) := by
        rw [show A = Subgroup.closure (Jset X u) from rfl, MonoidHom.map_closure]
      rw [h1]
      refine (Subgroup.closure_le A).mpr ?_
      rintro s ⟨x, hx, rfl⟩
      simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, A, SetLike.mem_coe] using
        conj_u_closure_Jset hu x hx
    have hcard : Nat.card ↥(A.map (MulAut.conj u).toMonoidHom) = Nat.card ↥A :=
      Subgroup.card_map_of_injective (MulAut.conj u).injective
    exact Subgroup.eq_of_le_of_card_ge hφ (le_of_eq hcard.symm)
  have hA_normal : A.Normal := by
    have htopN : (⊤ : Subgroup M) ≤ Subgroup.normalizer (A : Set M) := by
      rw [← htop]
      exact sup_le hXnorm (Subgroup.zpowers_le.mpr huNorm)
    refine Subgroup.Normal.mk fun n hn g => ?_
    exact (Subgroup.mem_normalizer_iff.mp (htopN (Subgroup.mem_top g)) n).mp hn
  -- The `M`-invariant set of generators and its closure
  let Iv : Set M := {v : M | orderOf v = 2}
  let T : Set Y := (Work.DoubleTransitivity.fixedBySub A : Set Y) ∪
    (⋃ v ∈ Iv, ({y : Y | v • y = y} : Set Y))
  let Z : Subgroup Y := Subgroup.closure T
  have hTx : ({y : Y | ∀ x : M, x ∈ X → u * x * u⁻¹ = x⁻¹ → x • y = y} : Set Y)
      = (Work.DoubleTransitivity.fixedBySub A : Set Y) := by
    ext y
    constructor
    · intro h
      rw [Work.DoubleTransitivity.mem_fixedBySub]
      intro a ha
      have hstab : A ≤ MulAction.stabilizer M y := by
        show Subgroup.closure (Jset X u) ≤ MulAction.stabilizer M y
        rw [Subgroup.closure_le]
        intro s hs
        exact MulAction.mem_stabilizer_iff.mpr (h s hs.1 hs.2)
      exact MulAction.mem_stabilizer_iff.mp (hstab ha)
    · intro h
      rw [Work.DoubleTransitivity.mem_fixedBySub] at h
      intro x hxX hxu
      exact h x (Subgroup.subset_closure (show x ∈ Jset X u from ⟨hxX, hxu⟩))
  have hZinv : FT.IsInvariant M Z := by
    refine FT.IsInvariant.closure ?_
    intro m
    ext z
    constructor
    · rintro ⟨t, ht, rfl⟩
      rcases ht with ht | ht
      · left
        rw [Work.DoubleTransitivity.mem_fixedBySub] at ht ⊢
        intro a ha
        have ham : m⁻¹ * a * m ∈ A := hA_normal.conj_mem' a ha m
        calc a • (m • t) = (a * m) • t := (mul_smul a m t).symm
          _ = (m * (m⁻¹ * a * m)) • t := by rw [show m * (m⁻¹ * a * m) = a * m from by group]
          _ = m • ((m⁻¹ * a * m) • t) := mul_smul m _ t
          _ = m • t := by rw [ht _ ham]
      · right
        rw [Set.mem_iUnion₂] at ht
        obtain ⟨v, hv, htv⟩ := ht
        change orderOf v = 2 at hv
        rw [Set.mem_iUnion₂]
        refine ⟨m * v * m⁻¹, ?_, ?_⟩
        · change orderOf (m * v * m⁻¹) = 2
          have h := MulEquiv.orderOf_eq (MulAut.conj m) v
          rwa [MulAut.conj_apply, hv] at h
        · change (m * v * m⁻¹) • (m • t) = m • t
          have h1 : (m * v * m⁻¹) • (m • t) = (m * v) • (m⁻¹ • (m • t)) := by rw [mul_smul]
          have h2 : m⁻¹ • (m • t) = t := by
            have hh := smul_inv_smul m⁻¹ t
            rwa [inv_inv] at hh
          rw [h1, h2, mul_smul, htv]
    · rintro h
      refine ⟨m⁻¹ • z, ?_, ?_⟩
      · rcases h with h | h
        · left
          rw [Work.DoubleTransitivity.mem_fixedBySub] at h ⊢
          intro a ha
          have ham : m * a * m⁻¹ ∈ A := hA_normal.conj_mem a ha m
          calc a • (m⁻¹ • z) = (a * m⁻¹) • z := (mul_smul a m⁻¹ z).symm
            _ = (m⁻¹ * (m * a * m⁻¹)) • z := by
                  rw [show m⁻¹ * (m * a * m⁻¹) = a * m⁻¹ from by group]
            _ = m⁻¹ • ((m * a * m⁻¹) • z) := mul_smul m⁻¹ _ z
            _ = m⁻¹ • z := by rw [h _ ham]
        · right
          rw [Set.mem_iUnion₂] at h
          obtain ⟨v, hv, htv⟩ := h
          change orderOf v = 2 at hv
          rw [Set.mem_iUnion₂]
          refine ⟨m⁻¹ * v * m, ?_, ?_⟩
          · change orderOf (m⁻¹ * v * m) = 2
            have h := MulEquiv.orderOf_eq (MulAut.conj m⁻¹) v
            rwa [MulAut.conj_apply, inv_inv, hv] at h
          · change (m⁻¹ * v * m) • (m⁻¹ • z) = m⁻¹ • z
            have h1 : (m⁻¹ * v * m) • (m⁻¹ • z) = (m⁻¹ * v) • (m • (m⁻¹ • z)) := by
              rw [mul_smul]
            have h2 : m • (m⁻¹ • z) = z := smul_inv_smul m z
            rw [h1, h2, mul_smul, htv]
      · show m • (m⁻¹ • z) = z
        rw [smul_inv_smul]
  rw [hTx]
  change Z = ⊤
  -- Case split on whether `Y` is trivial.
  have htriv_of : commutator Y = ⊤ → Subsingleton Y := by
    intro hconn
    have hder : derivedSeries Y 1 = ⊤ := by rw [derivedSeries_one]; exact hconn
    have hderall : ∀ k, derivedSeries Y (k+1) = ⊤ := by
      intro k
      induction k with
      | zero => simpa using hder
      | succ k ihk =>
        rw [show k + 1 + 1 = (k+1) + 1 from rfl, derivedSeries_succ, ihk]
        have h1 : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ = ⊤ := by
          have := derivedSeries_succ Y 0
          rw [derivedSeries_zero] at this
          rw [← this]; exact hder
        exact h1
    obtain ⟨j, hj⟩ := (Group.isSolvable_def Y).mp hsolv
    have hj' : (⊤ : Subgroup Y) = ⊥ := by
      cases j with
      | zero => rw [derivedSeries_zero] at hj; exact hj
      | succ i => rw [hderall i] at hj; exact hj
    refine ⟨fun a b => ?_⟩
    have ha : a = 1 := Subgroup.mem_bot.mp (hj' ▸ Subgroup.mem_top a)
    have hb : b = 1 := Subgroup.mem_bot.mp (hj' ▸ Subgroup.mem_top b)
    rw [ha, hb]
  by_cases hconn : commutator Y = ⊤
  · haveI : Subsingleton Y := htriv_of hconn
    refine (Subgroup.eq_top_iff' Z).mpr fun y => ?_
    have hy : y = 1 := Subsingleton.elim y 1
    rw [hy]; exact Z.one_mem
  · -- `Y' ≤ Z` from the induction hypothesis
    haveI hchar : (commutator Y).Characteristic :=
      derivedSeries_one Y ▸ derivedSeries_characteristic Y 1
    haveI : FT.IsInvariant M (commutator Y) := FT.IsInvariant.of_characteristic hchar
    have hY'card : Nat.card ↥(commutator Y) < n := by
      have h1 := Subgroup.card_lt_of_lt (K := (⊤ : Subgroup Y))
        (lt_top_iff_ne_top.mpr hconn)
      have h2 : Nat.card ↥(⊤ : Subgroup Y) = Nat.card Y :=
        Nat.card_congr (Subgroup.topEquiv).toEquiv
      rw [h2, hYcard] at h1
      exact h1
    have hcY : Nat.card ↥(⊤ : Subgroup Y) = Nat.card Y :=
      Nat.card_congr (Subgroup.topEquiv).toEquiv
    have hY'dvd : Nat.card ↥(commutator Y) ∣ Nat.card Y := by
      rw [← hcY]; exact Subgroup.card_dvd_of_le le_top
    have hcop' : Nat.Coprime (Nat.card M) (Nat.card ↥(commutator Y)) :=
      hcop.coprime_dvd_right hY'dvd
    have hsolv' : Group.IsSolvable ↥(commutator Y) :=
      Group.isSolvable_of_isSolvable_injective (f := (commutator Y).subtype) Subtype.coe_injective
    have hIH := ih (Nat.card ↥(commutator Y)) hY'card ↥(commutator Y) rfl hcop' hsolv'
    have hY'leZ : commutator Y ≤ Z := by
      intro y hy
      have hy' : (⟨y, hy⟩ : ↥(commutator Y)) ∈ Z.subgroupOf (commutator Y) := by
        have hle : (⊤ : Subgroup ↥(commutator Y)) ≤ Z.subgroupOf (commutator Y) := by
          rw [← hIH]
          refine (Subgroup.closure_le _).mpr fun t ht => Subgroup.mem_subgroupOf.mpr ?_
          rcases ht with ht | ht
          · rw [Set.mem_setOf_eq] at ht
            have hstab : A ≤ MulAction.stabilizer M t := by
              show Subgroup.closure (Jset X u) ≤ MulAction.stabilizer M t
              rw [Subgroup.closure_le]
              intro a ha
              exact MulAction.mem_stabilizer_iff.mpr (ht a ha.1 ha.2)
            refine Subgroup.subset_closure (Or.inl ?_)
            rw [Work.DoubleTransitivity.mem_fixedBySub]
            intro a ha
            have h1 : a • t = t := MulAction.mem_stabilizer_iff.mp (hstab ha)
            have h2 : ((a • t : ↥(commutator Y)) : Y) = (t : Y) := congrArg (Subtype.val) h1
            exact (FT.coe_subgroup_smul a t).symm.trans h2
          · rw [Set.mem_iUnion] at ht
            obtain ⟨v, ht⟩ := ht
            rw [Set.mem_iUnion] at ht
            obtain ⟨hv, htv⟩ := ht
            refine Subgroup.subset_closure (Or.inr ?_)
            rw [Set.mem_iUnion]
            refine ⟨v, ?_⟩
            rw [Set.mem_iUnion]
            refine ⟨?_, ?_⟩
            · change orderOf v = 2; exact hv
            · have h2 : ((v • t : ↥(commutator Y)) : Y) = (t : Y) := congrArg (Subtype.val) htv
              exact (FT.coe_subgroup_smul v t).symm.trans h2
        exact hle (Subgroup.mem_top _)
      exact Subgroup.mem_subgroupOf.mp hy'
    haveI hZnormal : Z.Normal := Subgroup.Normal.of_commutator_le Y hY'leZ
    haveI : FT.IsInvariant M Z := hZinv
    have hAdvd : Nat.card ↥A ∣ Nat.card M := by
      have h1 : Nat.card ↥(⊤ : Subgroup M) = Nat.card M :=
        Nat.card_congr (Subgroup.topEquiv).toEquiv
      rw [← h1]; exact Subgroup.card_dvd_of_le le_top
    have key : Subsingleton (Y ⧸ Z) := by
      refine Work.ThreePoints.ThmC.subsingleton_of_fix_eq_bot (Y := Y ⧸ Z) hu
        (fun x hx => hx.2) hAodd ?_ ?_
      · intro y hy
        haveI : FT.IsInvariant ↥A Z := ⟨fun a => hZinv.smul_eq_self (a : M)⟩
        have hact : ∀ (a : ↥A) (w : Y ⧸ Z), a • w = (a : M) • w := by
          intro a w
          refine Quotient.inductionOn w ?_
          intro g
          rw [FT.quotient_smul_mk, FT.quotient_smul_mk]
          rfl
        have hmem : y ∈ FT.fixedPoints ↥A (Y ⧸ Z) := by
          refine FT.mem_fixedPoints.mpr ?_
          intro a
          have hstab : A ≤ MulAction.stabilizer M y := by
            show Subgroup.closure (Jset X u) ≤ MulAction.stabilizer M y
            rw [Subgroup.closure_le]
            intro s hs
            exact MulAction.mem_stabilizer_iff.mpr (hy s hs)
          exact (hact a y).trans (MulAction.mem_stabilizer_iff.mp (hstab a.2))
        have hlift := Work.Coprime.fixedPoints_quotient ↥A
          ((hcop.symm.coprime_dvd_right hAdvd).symm) (Or.inr hsolv) Z
        have hmem' : y ∈ (FT.fixedPoints ↥A Y).map (QuotientGroup.mk' Z) :=
          Eq.mp (congrArg (fun S => y ∈ S) hlift.symm) hmem
        obtain ⟨n, hn, hnz⟩ := Subgroup.mem_map.mp hmem'
        have hnZ : n ∈ Z := by
          have hfix : n ∈ (Work.DoubleTransitivity.fixedBySub A : Set Y) := by
            rw [Work.DoubleTransitivity.mem_fixedBySub]
            intro a ha
            exact FT.mem_fixedPoints.mp hn ⟨a, ha⟩
          exact Subgroup.subset_closure (Or.inl hfix)
        rw [← hnz]
        show (n : Y ⧸ Z) = 1
        rw [QuotientGroup.eq_one_iff]
        exact hnZ
      · intro v hv y hy
        have hv2 : v * v = 1 := by rw [← pow_two, ← hv, pow_orderOf_eq_one]
        haveI : FT.IsInvariant ↥(Subgroup.zpowers v) Z :=
          ⟨fun a => hZinv.smul_eq_self (a : M)⟩
        have hact : ∀ (a : ↥(Subgroup.zpowers v)) (w : Y ⧸ Z), a • w = (a : M) • w := by
          intro a w
          refine Quotient.inductionOn w ?_
          intro g
          rw [FT.quotient_smul_mk, FT.quotient_smul_mk]
          rfl
        have hmem : y ∈ FT.fixedPoints ↥(Subgroup.zpowers v) (Y ⧸ Z) := by
          refine FT.mem_fixedPoints.mpr ?_
          intro a
          have hva : (a : M) = 1 ∨ (a : M) = v := by
            obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp a.2
            have h2z : v ^ (2 : ℤ) = 1 := by
              have hd : ((orderOf v : ℕ) : ℤ) ∣ (2 : ℤ) := by rw [hv]; norm_num
              exact (orderOf_dvd_iff_zpow_eq_one).mp hd
            have hred : v ^ k = v ^ (k % 2) := by
              conv_lhs =>
                rw [show k = k % 2 + 2 * (k / 2) from (Int.emod_add_mul_ediv k 2).symm]
              rw [zpow_add, zpow_mul, h2z, one_zpow, mul_one]
            rcases Int.emod_two_eq_zero_or_one k with h | h
            · left
              rw [← hk, hred, h]
              simp
            · right
              rw [← hk, hred, h]
              simp
          rcases hva with h1 | hv'
          · exact (hact a y).trans (by rw [h1, one_smul])
          · exact (hact a y).trans (by rw [hv']; exact hy)
        have hzdvd : Nat.card ↥(Subgroup.zpowers v) ∣ Nat.card M := by
          have h1 : Nat.card ↥(⊤ : Subgroup M) = Nat.card M :=
            Nat.card_congr (Subgroup.topEquiv).toEquiv
          rw [← h1]
          exact Subgroup.card_dvd_of_le (Subgroup.zpowers_le.mpr (Subgroup.mem_top v))
        have hlift := Work.Coprime.fixedPoints_quotient ↥(Subgroup.zpowers v)
          ((hcop.symm.coprime_dvd_right hzdvd).symm) (Or.inr hsolv) Z
        have hmem' : y ∈ (FT.fixedPoints ↥(Subgroup.zpowers v) Y).map (QuotientGroup.mk' Z) :=
          Eq.mp (congrArg (fun S => y ∈ S) hlift.symm) hmem
        obtain ⟨n, hn, hnz⟩ := Subgroup.mem_map.mp hmem'
        have hnZ : n ∈ Z := by
          have hmem2 : n ∈ (⋃ w ∈ Iv, ({y : Y | w • y = y} : Set Y)) := by
            rw [Set.mem_iUnion]
            refine ⟨v, ?_⟩
            rw [Set.mem_iUnion]
            refine ⟨?_, ?_⟩
            · change orderOf v = 2; exact hv
            · exact FT.mem_fixedPoints.mp hn ⟨v, Subgroup.mem_zpowers v⟩
          exact Subgroup.subset_closure (Or.inr hmem2)
        rw [← hnz]
        show (n : Y ⧸ Z) = 1
        rw [QuotientGroup.eq_one_iff]
        exact hnZ
    refine (Subgroup.eq_top_iff' Z).mpr fun y => ?_
    have hy : (y : Y ⧸ Z) = 1 := Subsingleton.elim _ _
    exact (QuotientGroup.eq_one_iff y).mp hy

/-- **Peterfalvi I Ch. I §6 Lemma 2 (pp. 159-160).** -/
theorem coprime_generation {M Y : Type} [Group M] [Finite M] [Group Y] [Finite Y]
    [MulDistribMulAction M Y] {X : Subgroup M} (hXodd : Odd (Nat.card X)) {u : M}
    (hu : orderOf u = 2) (huX : ∀ x ∈ X, u * x * u⁻¹ ∈ X)
    (htop : X ⊔ Subgroup.zpowers u = ⊤)
    (hcop : Nat.Coprime (Nat.card M) (Nat.card Y)) (hsolv : Group.IsSolvable Y) :
    Subgroup.closure
      (({y : Y | ∀ x : M, x ∈ X → u * x * u⁻¹ = x⁻¹ → x • y = y} : Set Y) ∪
        (⋃ v ∈ ({v : M | orderOf v = 2} : Set M), ({y : Y | v • y = y} : Set Y))) = ⊤ :=
  coprime_generation_aux hXodd hu huX htop (Nat.card Y) Y rfl hcop hsolv

end Work.DoubleTransitivity.Sec6
