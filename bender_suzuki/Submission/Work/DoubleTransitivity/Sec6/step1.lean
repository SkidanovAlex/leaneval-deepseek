/-!
# `Work.DoubleTransitivity.Sec6.step1` — Peterfalvi I, Ch. I §6, Prop. 2, Step 1

Let `H` be strongly embedded in the finite group `G`, `H₁, H₂` conjugates of `H`, `s` an
involution of `H₁`, and `K ≤ H₁ ⊓ H₂` a `p`-subgroup with `K^s = K`.  If `H₂ ⊓ H₂^s` has odd
order and `C_G(⟨J(K,s)⟩) ⊓ H₂ ⊓ H₂^s ≤ H₁`, then

`O_{p'}(H₂ ⊓ H₂^s) ≤ O_{p'}(H₁ ⊓ H₂ ⊓ H₂^s)`.

This is Step 1 of the proof of Proposition 2 of Peterfalvi I §6.  Put `D = H₂ ⊓ H₂^s`,
`Y = O_{p'}(D)` and `M = K⟨s⟩ ≤ H₁` (the latter since `K ≤ H₁` and `s ∈ H₁`).  Since
`K ≤ H₂` and `K^s = K` we have `K ≤ D`, and `s` normalises `D`, so `M` acts on `Y` by
conjugation, coprimely (as `|Y| ∣ |D|` is odd and prime to `p`, while `|M| ∣ 2|K|`, `|K|` a
`p`-power of odd order).  Peterfalvi's coprime generation lemma (§6 Lemma 2,
`Sec6.coprime_generation`) therefore expresses `Y` as generated by the common fixed points of
`J(K,s) = {x ∈ K | s x s⁻¹ = x⁻¹}` and the fixed points of the involutions of `M`.  Each of
these lies in `H₁`: the involutions `v` of `M` lie in `H₁` and `C_G(v) ≤ H₁` by §1 (2), while
the fixed points of `J(K,s)` lie in `C_G(⟨J(K,s)⟩) ⊓ H₂ ⊓ H₂^s ≤ H₁` by hypothesis.  Hence
`Y ≤ H₁ ⊓ D`.  As `Y` is normal in `D`, it is normal (and of `p'`-order) in `H₁ ⊓ D`, so it is
contained in `O_{p'}(H₁ ⊓ D)`, as claimed.
-/

set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped Pointwise
open LeanEval.GroupTheory.Defs
open Submission.Blueprint

namespace Work.DoubleTransitivity.Sec6

theorem step1 {G : Type} [Group G] [Finite G] (hFT : Submission.Blueprint.FeitThompsonProp)
    {H : Subgroup G} (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H) {p : ℕ} (hp : p.Prime)
    {H₁ H₂ K : Subgroup G} {s : G}
    (hH₁ : ∃ g : G, H₁ = Submission.Blueprint.conj g H)
    (hH₂ : ∃ g : G, H₂ = Submission.Blueprint.conj g H)
    (hs : orderOf s = 2) (hsH₁ : s ∈ H₁)
    (hKH₁ : K ≤ H₁) (hKH₂ : K ≤ H₂) (hKs : Submission.Blueprint.conj s K = K)
    (hKp : IsPGroup p K)
    (hodd : Odd (Nat.card (H₂ ⊓ Submission.Blueprint.conj s H₂ : Subgroup G)))
    (hC : Subgroup.centralizer
        (Subgroup.closure (Submission.Blueprint.invertedBy K s) : Set G) ⊓ H₂ ⊓
        Submission.Blueprint.conj s H₂ ≤ H₁) :
    Work.DoubleTransitivity.pPrimeCoreSub p (H₂ ⊓ Submission.Blueprint.conj s H₂) ≤
      Work.DoubleTransitivity.pPrimeCoreSub p (H₁ ⊓ H₂ ⊓ Submission.Blueprint.conj s H₂) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  -- ## Bookkeeping
  obtain ⟨g₁, hg₁⟩ := hH₁
  obtain ⟨g₂, hg₂⟩ := hH₂
  have hH1se : IsStronglyEmbedded H₁ := by rw [hg₁]; exact Work.ThreePoints.conj_stronglyEmbedded hH g₁
  have hH2se : IsStronglyEmbedded H₂ := by rw [hg₂]; exact Work.ThreePoints.conj_stronglyEmbedded hH g₂
  have hs1 : s * s = 1 := by
    have h := pow_orderOf_eq_one s
    rw [hs] at h
    simpa [pow_two] using h
  have hconj_ss : ∀ X : Subgroup G, conj s (conj s X) = X := fun X => by
    rw [← conj_mul, hs1, conj_one]
  have hconj_inf : ∀ (g : G) (A B : Subgroup G), conj g (A ⊓ B) = conj g A ⊓ conj g B :=
    fun g A B => Subgroup.map_inf A B (MulAut.conj g).toMonoidHom (MulAut.conj g).injective
  -- ## The two-point stabiliser `D = H₂ ⊓ H₂^s`, and `Y = O_{p'}(D)`
  set D : Subgroup G := H₂ ⊓ conj s H₂ with hDdef
  set Y : Subgroup G := pPrimeCoreSub p D with hYdef
  have hDodd : Odd (Nat.card ↥D) := by rw [hDdef]; exact hodd
  have hDconj : conj s D = D := by
    rw [hDdef, hconj_inf s, hconj_ss, inf_comm]
  have hYD : Y ≤ D := by rw [hYdef]; exact Subgroup.map_subtype_le _
  have hYH2 : Y ≤ H₂ := hYD.trans (by rw [hDdef]; exact inf_le_left)
  have hYH2s : Y ≤ conj s H₂ := hYD.trans (by rw [hDdef]; exact inf_le_right)
  have hoddY : Odd (Nat.card ↥Y) := Odd.of_dvd_nat hDodd (Subgroup.card_dvd_of_le hYD)
  -- `Y` is a `p'`-group
  have hcopY : Nat.Coprime (Nat.card ↥Y) p := by
    have hcard : Nat.card ↥Y = Nat.card ↥(Submission.Blueprint.pPrimeCore p ↥D) := by
      rw [hYdef]; exact Subgroup.card_map_of_injective (Subgroup.subtype_injective D)
    rw [hcard, Work.GlaubermanZJ.pPrimeCore_eq_fitting p hp]
    exact (Work.GlaubermanZJ.isPiNat_ne_iff_coprime hp).mp
      (Work.Fitting.piCore_isPiNat ↥D (fun q => q ≠ p))
  -- `K ≤ D`
  have hKD : K ≤ D := by
    rw [hDdef]
    refine le_inf hKH₂ ?_
    rw [← hKs]
    exact Subgroup.map_mono hKH₂
  have hKodd : Odd (Nat.card ↥K) := Odd.of_dvd_nat hDodd (Subgroup.card_dvd_of_le hKD)
  -- `s` and `D` normalise `Y`
  have hpcs_conj : ∀ (X : Subgroup G) (g : G),
      pPrimeCoreSub p (conj g X) = conj g (pPrimeCoreSub p X) :=
    fun X g => Work.ThreePoints.ThmC.pPrimeCoreSub_conj p hp X g
  have hYs : conj s Y = Y := by
    show conj s (pPrimeCoreSub p D) = pPrimeCoreSub p D
    rw [← hpcs_conj D s, hDconj]
  have hsNY : s ∈ Subgroup.normalizer (Y : Set G) :=
    (conj_eq_self_iff_mem_normalizer s Y).mp hYs
  have hDNY : D ≤ Subgroup.normalizer (Y : Set G) := by
    intro d hd
    rw [← conj_eq_self_iff_mem_normalizer d Y]
    have hdA : d ∈ H₂ := (Subgroup.mem_inf.mp (hDdef ▸ hd)).1
    have hdB : d ∈ conj s H₂ := (Subgroup.mem_inf.mp (hDdef ▸ hd)).2
    have hN2 : Subgroup.normalizer (H₂ : Set G) = H₂ :=
      Work.ThreePoints.IsStronglyEmbedded.normalizer_eq hH2se
    have hN2s : Subgroup.normalizer (conj s H₂ : Set G) = conj s H₂ :=
      Work.ThreePoints.IsStronglyEmbedded.normalizer_eq (Work.ThreePoints.conj_stronglyEmbedded hH2se s)
    have h1 : conj d H₂ = H₂ :=
      (conj_eq_self_iff_mem_normalizer d H₂).mpr (by rw [hN2]; exact hdA)
    have h2 : conj d (conj s H₂) = conj s H₂ :=
      (conj_eq_self_iff_mem_normalizer d (conj s H₂)).mpr (by rw [hN2s]; exact hdB)
    show conj d (pPrimeCoreSub p D) = pPrimeCoreSub p D
    rw [← hpcs_conj D d, hDdef, hconj_inf d, h1, h2]
  -- ## The acting group `M = K⟨s⟩`
  set M : Subgroup G := K ⊔ Subgroup.zpowers s with hMdef
  have hMle : M ≤ Subgroup.normalizer (Y : Set G) :=
    sup_le (hKD.trans hDNY) (Subgroup.zpowers_le.mpr hsNY)
  have hMleH1 : M ≤ H₁ := sup_le hKH₁ (Subgroup.zpowers_le.mpr hsH₁)
  haveI : FT.Normalizes M Y := ⟨hMle⟩
  have hcopM : Nat.Coprime (Nat.card ↥M) (Nat.card ↥Y) := by
    refine Nat.Coprime.coprime_dvd_left
      (Work.ThreePoints.ThmC.card_sup_zpowers_dvd (G := G) hs hKs) ?_
    obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hKp
    rw [ha, Nat.coprime_mul_iff_left]
    refine ⟨?_, Nat.Coprime.pow_left a hcopY.symm⟩
    rw [Nat.Prime.coprime_iff_not_dvd (by norm_num : Nat.Prime 2)]
    rintro ⟨b, hb⟩
    obtain ⟨c, hc⟩ := hoddY
    omega
  have hsolvY : Group.IsSolvable ↥Y := hFT ↥Y hoddY
  -- elements of `M` lying over `K` resp. over `s`
  have hsupL : ∀ {x : G}, x ∈ K → x ∈ M :=
    fun hx => (le_sup_left : (K : Subgroup G) ≤ K ⊔ Subgroup.zpowers s) hx
  have hsupR : ∀ {x : G}, x ∈ Subgroup.zpowers s → x ∈ M :=
    fun hx => (le_sup_right : (Subgroup.zpowers s : Subgroup G) ≤ K ⊔ Subgroup.zpowers s) hx
  let u : ↥M := ⟨s, hsupR (Subgroup.mem_zpowers s)⟩
  have hu : orderOf u = 2 := by
    rw [← Subgroup.orderOf_coe u]
    exact hs
  have hXodd : Odd (Nat.card ↥(K.subgroupOf M)) := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe le_sup_left).toEquiv]
    exact hKodd
  have huX : ∀ x ∈ K.subgroupOf M, u * x * u⁻¹ ∈ K.subgroupOf M := by
    intro x hx
    rw [Subgroup.mem_subgroupOf] at hx ⊢
    show s * (x : G) * s⁻¹ ∈ K
    have hmem : (MulAut.conj s) (x : G) ∈ conj s K := Subgroup.mem_map_of_mem _ hx
    rw [hKs] at hmem
    simpa [MulAut.conj_apply] using hmem
  have htop : K.subgroupOf M ⊔ Subgroup.zpowers u = ⊤ := by
    have hle_sK : Subgroup.zpowers s ≤ Subgroup.normalizer (K : Set G) :=
      Subgroup.zpowers_le.mpr ((conj_eq_self_iff_mem_normalizer s K).mp hKs)
    have hcoe : (↑M : Set G) = (K : Set G) * (Subgroup.zpowers s : Set G) :=
      Subgroup.coe_mul_of_right_le_normalizer_left K (Subgroup.zpowers s) hle_sK
    rw [eq_top_iff]
    intro m _
    have hm : (m : G) ∈ (K : Set G) * (Subgroup.zpowers s : Set G) := by
      have hm' : (m : G) ∈ (↑M : Set G) := m.2
      rwa [hcoe] at hm'
    obtain ⟨k, hk, t, ht, hkt⟩ := hm
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp ht
    have hut : (⟨t, hsupR ht⟩ : ↥M) = u ^ n := by
      apply Subtype.ext
      show t = s ^ n
      exact hn.symm
    have hmul : m = (⟨k, hsupL hk⟩ : ↥M) * (⟨t, hsupR ht⟩ : ↥M) := by
      apply Subtype.ext
      rw [Subgroup.coe_mul]
      exact hkt.symm
    rw [hmul, hut]
    refine Subgroup.mul_mem _ ?_ ?_
    · exact (le_sup_left : (K.subgroupOf M : Subgroup ↥M) ≤ K.subgroupOf M ⊔ Subgroup.zpowers u)
        (Subgroup.mem_subgroupOf.mpr hk)
    · exact (le_sup_right : (Subgroup.zpowers u : Subgroup ↥M) ≤ K.subgroupOf M ⊔ Subgroup.zpowers u)
        (Subgroup.mem_zpowers_iff.mpr ⟨n, rfl⟩)
  -- ## Coprime generation of `Y` by fixed points of `J(K,s)` and of the involutions of `M`
  have hgen := coprime_generation (M := ↥M) (Y := ↥Y) (X := K.subgroupOf M) (u := u)
    hXodd hu huX htop hcopM hsolvY
  -- ## Every generator lies in `H₁`
  have hYH1 : Y ≤ H₁ := by
    have hsub : (⊤ : Subgroup ↥Y) ≤ (H₁ ⊓ Y).subgroupOf Y := by
      rw [← hgen, Subgroup.closure_le]
      rintro y (hy | hy)
      · rw [Set.mem_ofPred_eq] at hy
        have hyH2 : (y : G) ∈ H₂ := hYH2 y.2
        have hyH2s : (y : G) ∈ conj s H₂ := hYH2s y.2
        have hycent : (y : G) ∈
            Subgroup.centralizer (Subgroup.closure (invertedBy K s) : Set G) := by
          rw [Subgroup.centralizer_closure, Subgroup.mem_centralizer_iff]
          intro z hz
          obtain ⟨hzK, hzinv⟩ := hz
          have hx : (⟨z, hsupL hzK⟩ : ↥M) ∈ K.subgroupOf M := Subgroup.mem_subgroupOf.mpr hzK
          have hux : u * (⟨z, hsupL hzK⟩ : ↥M) * u⁻¹ = (⟨z, hsupL hzK⟩ : ↥M)⁻¹ := by
            apply Subtype.ext
            simpa [u, Subgroup.coe_mul, Subgroup.coe_inv] using hzinv
          have hfix : (⟨z, hsupL hzK⟩ : ↥M) • y = y := hy _ hx hux
          have hfix' : z * (y : G) * z⁻¹ = (y : G) := by
            have hh := congrArg (Subtype.val) hfix
            rwa [FT.conj_smul_coe] at hh
          show z * (y : G) = (y : G) * z
          have h := congrArg (· * z) hfix'
          simpa [mul_assoc] using h
        exact Subgroup.mem_subgroupOf.mpr ⟨hC ⟨⟨hycent, hyH2⟩, hyH2s⟩, y.2⟩
      · rw [Set.mem_iUnion] at hy
        obtain ⟨v, hyv⟩ := hy
        rw [Set.mem_iUnion] at hyv
        obtain ⟨hv2, hyfix⟩ := hyv
        rw [Set.mem_ofPred_eq] at hv2 hyfix
        have hvH1 : (v : G) ∈ H₁ := hMleH1 v.2
        have hvord : orderOf (v : G) = 2 := by
          rw [Subgroup.orderOf_coe]
          exact hv2
        have hvfix : (v : G) * (y : G) * (v : G)⁻¹ = (y : G) := by
          have hh := congrArg (Subtype.val) hyfix
          rwa [FT.conj_smul_coe] at hh
        have hcent : (y : G) ∈ Subgroup.centralizer ({(v : G)} : Set G) := by
          rw [Subgroup.mem_centralizer_singleton_iff]
          have h := congrArg (· * (v : G)) hvfix
          have h' : (v : G) * (y : G) = (y : G) * (v : G) := by simpa [mul_assoc] using h
          exact h'.symm
        exact Subgroup.mem_subgroupOf.mpr
          ⟨Work.ThreePoints.IsStronglyEmbedded.centralizer_le hH1se hvH1 (by omega) hcent, y.2⟩
    intro x hx
    exact (Subgroup.mem_subgroupOf.mp (hsub (Subgroup.mem_top (⟨x, hx⟩ : ↥Y)))).1
  -- ## `Y ≤ O_{p'}(H₁ ⊓ H₂ ⊓ H₂^s)`
  set NN : Subgroup G := H₁ ⊓ H₂ ⊓ conj s H₂ with hNNdef
  have hYleN : Y ≤ NN := le_inf (le_inf hYH1 hYH2) hYH2s
  have hNleD : NN ≤ D := by
    rw [hNNdef, hDdef]
    exact le_inf (inf_le_left.trans inf_le_right) inf_le_right
  have hNnorm : (Y.subgroupOf NN).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hYleN]
    intro y n hy hn
    exact (Subgroup.mem_normalizer_iff.mp (hDNY (hNleD hn)) y).mp hy
  have hpi : Work.Fitting.IsPiNat (fun q => q ≠ p) (Nat.card ↥(Y.subgroupOf NN)) := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hYleN).toEquiv]
    exact (Work.GlaubermanZJ.isPiNat_ne_iff_coprime hp).mpr hcopY
  have hcore : Y.subgroupOf NN ≤ Work.Fitting.pPrimeCore p ↥NN :=
    Work.Fitting.le_piCore hNnorm hpi
  have hfinal : Y ≤ pPrimeCoreSub p NN := by
    have h1 : Y ≤ (Work.Fitting.pPrimeCore p ↥NN).map NN.subtype := by
      calc Y = (Y.subgroupOf NN).map NN.subtype := (Subgroup.map_subgroupOf_eq_of_le hYleN).symm
        _ ≤ _ := Subgroup.map_mono hcore
    have h2 : (Work.Fitting.pPrimeCore p ↥NN) = Submission.Blueprint.pPrimeCore p ↥NN :=
      (Work.GlaubermanZJ.pPrimeCore_eq_fitting p hp).symm
    rw [h2] at h1
    exact h1
  rw [hYdef, hDdef, hNNdef] at hfinal
  exact hfinal

end Work.DoubleTransitivity.Sec6
