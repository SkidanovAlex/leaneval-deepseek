/-!
# `Work.DoubleTransitivity.Sec5.lemma1`

Peterfalvi, *Le théorème de Bender–Suzuki I*, Ch. I §5, **Lemma 1** (p. 157).

Fix `D ∈ 𝒟`, `H ∈ Ω` and an involution `t ∉ H` with `D = H ∩ H^t`.  Then
(a) `|N_H(D)|` is odd, and (b) there is an odd prime `p` with `(D,H) ∉ 𝒞_p`.

The proof follows the source.

(a) was delegated piecewise: if `u ∈ N_H(D)` were an involution, then, `D` acting transitively on
`Inv(H)` (§2 Prop. 2), every involution of `H` would lie in `⟨D,u⟩`, a group of order `2|D|` with
`|D|` odd, so it would contain no four-group; hence `H` has no four-group.  Since `H` contains a
Sylow 2-subgroup of `G`, that contradicts hypothesis (A1) (`HasFourGroup G`).

(b) Suppose `(D,H) ∈ 𝒞_p` for every odd prime `p`.  Pick an involution `u ∈ H`; by §4 Lemma 1
(`exists_sylow_normalized_of_regularIntersection`) `u` normalizes a `p`-Sylow of `D` for each
prime `p`, and `D` is generated by these Sylows (`sylow_iSup_eq`), so `u ∈ N_H(D)`, contradicting
(a).
-/

set_option autoImplicit false

open LeanEval.GroupTheory.Defs

namespace Work.DoubleTransitivity.Sec5

open Submission.Blueprint
open Work.DoubleTransitivity

/-- The product of two distinct commuting involutions has order `2`. -/
private lemma orderOf_mul_eq_two_of_commuting {G : Type} [Group G] {a b : G}
    (ha : orderOf a = 2) (hb : orderOf b = 2) (hne : a ≠ b) (hcomm : a * b = b * a) :
    orderOf (a * b) = 2 := by
  have haa : a * a = 1 := by rw [← pow_two, ← ha]; exact pow_orderOf_eq_one a
  have hbb : b * b = 1 := by rw [← pow_two, ← hb]; exact pow_orderOf_eq_one b
  refine orderOf_eq_prime ?_ ?_
  · rw [pow_two]
    calc (a * b) * (a * b) = a * (b * a) * b := by group
      _ = a * (a * b) * b := by rw [← hcomm]
      _ = (a * a) * (b * b) := by group
      _ = 1 := by rw [haa, hbb, mul_one]
  · intro h1
    have : a = b := by
      calc a = a * 1 := (mul_one a).symm
        _ = a * (a * b) := by rw [h1]
        _ = (a * a) * b := by group
        _ = b := by rw [haa, one_mul]
    exact hne this

theorem lemma1 {G : Type} [Group G] [Finite G] {H : Subgroup G}
    (hH : LeanEval.GroupTheory.Defs.IsStronglyEmbedded H)
    (h4 : Submission.Blueprint.HasFourGroup G) {t : G} (ht : orderOf t = 2) (htH : t ∉ H) :
    Odd (Nat.card ↥(Subgroup.normalizer (Submission.Blueprint.twoPoint H t : Set G) ⊓ H)) ∧
    (∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧
      ¬ Work.DoubleTransitivity.IsRegularIntersection p (Submission.Blueprint.twoPoint H t) H) := by
  have hbender : IsBender H := ((isStronglyEmbedded_iff H).mp hH).2
  have hne : H ≠ ⊤ := ((isStronglyEmbedded_iff H).mp hH).1
  -- Write `D = H ∩ H^t` for the two-point stabiliser.
  set D : Subgroup G := Submission.Blueprint.twoPoint H t with hD
  have hDodd : Odd (Nat.card ↥D) := by
    rw [hD]
    simpa [Submission.Blueprint.twoPoint, Submission.Blueprint.conj] using hH.2.2 t htH
  -- ## Part (a): `|N_H(D)|` is odd.
  have hpart_a : Odd (Nat.card ↥(Subgroup.normalizer (D : Set G) ⊓ H)) := by
    rw [← Nat.not_even_iff_odd]
    intro hMeven
    obtain ⟨u, hu2⟩ :=
      exists_prime_orderOf_dvd_card' (G := ↥(Subgroup.normalizer (D : Set G) ⊓ H)) 2
        (even_iff_two_dvd.mp hMeven)
    have hu2G : orderOf ((u : G)) = 2 := by rw [Subgroup.orderOf_coe, hu2]
    have hu_mem : (u : G) ∈ Subgroup.normalizer (D : Set G) ⊓ H := u.2
    have hu_norm : (u : G) ∈ Subgroup.normalizer (D : Set G) := (Subgroup.mem_inf.mp hu_mem).1
    have hu_H : (u : G) ∈ H := (Subgroup.mem_inf.mp hu_mem).2
    have hu_invH : (u : G) ∈ Submission.Blueprint.involutions (H : Set G) := ⟨hu_H, hu2G⟩
    -- A four-group of `G`, pushed into a conjugate of `H`.
    obtain ⟨a, b, ha2, hb2, hab_ne, hab_comm⟩ := h4
    obtain ⟨g, hag, hbg⟩ :=
      exists_conj_of_commuting_involutions (H := H) hbender ha2 hb2 hab_ne hab_comm
    have ha'H : g⁻¹ * a * g ∈ H := (mem_conj g a H).mp hag
    have hb'H : g⁻¹ * b * g ∈ H := (mem_conj g b H).mp hbg
    have ha'2 : orderOf (g⁻¹ * a * g) = 2 := by
      have h := MulEquiv.orderOf_eq (MulAut.conj g⁻¹) a
      rw [ha2] at h
      simpa [MulAut.conj_apply] using h
    have hb'2 : orderOf (g⁻¹ * b * g) = 2 := by
      have h := MulEquiv.orderOf_eq (MulAut.conj g⁻¹) b
      rw [hb2] at h
      simpa [MulAut.conj_apply] using h
    have ha'inv : g⁻¹ * a * g ∈ Submission.Blueprint.involutions (H : Set G) := ⟨ha'H, ha'2⟩
    have hb'inv : g⁻¹ * b * g ∈ Submission.Blueprint.involutions (H : Set G) := ⟨hb'H, hb'2⟩
    have hprod2 : orderOf ((g⁻¹ * a * g) * (g⁻¹ * b * g)) = 2 := by
      have hab2 : orderOf (a * b) = 2 :=
        orderOf_mul_eq_two_of_commuting ha2 hb2 hab_ne hab_comm
      have h := MulEquiv.orderOf_eq (MulAut.conj g⁻¹) (a * b)
      rw [hab2] at h
      have heq : (g⁻¹ * a * g) * (g⁻¹ * b * g) = MulAut.conj g⁻¹ (a * b) := by
        rw [MulAut.conj_apply]
        group
      rw [heq]
      exact h
    -- `D` is transitive on `Inv(H)` (§2 Prop. 2 (b)).
    obtain ⟨htrans, -, -⟩ := Work.DoubleTransitivity.Sec2.prop2 hbender hne ht htH
    obtain ⟨d1, hd1D, hd1⟩ := htrans (u : G) (g⁻¹ * a * g) hu_invH ha'inv
    obtain ⟨d2, hd2D, hd2⟩ := htrans (u : G) (g⁻¹ * b * g) hu_invH hb'inv
    exact no_involution_in_normalizer_of_odd hDodd hu2G hu_norm
      ⟨d1, hd1D, hd1⟩ ⟨d2, hd2D, hd2⟩ hprod2
  -- ## Part (b): some odd prime `p` has `(D,H) ∉ 𝒞_p`.
  refine ⟨hpart_a, ?_⟩
  by_contra hcon
  have hcon' : ∀ p, p.Prime → p ≠ 2 → IsRegularIntersection p D H := by
    intro p hp hp2
    by_contra h
    exact hcon ⟨p, hp, hp2, h⟩
  -- An involution `u₀ ∈ H`.
  obtain ⟨u₀, hu₀⟩ := exists_prime_orderOf_dvd_card' (G := ↥H) 2 hbender.1
  have hu₀G : orderOf ((u₀ : G)) = 2 := by rw [Subgroup.orderOf_coe, hu₀]
  have hu₀H : (u₀ : G) ∈ H := u₀.2
  have hu₀inv : (u₀ : G) ∈ Submission.Blueprint.involutions (H : Set G) := ⟨hu₀H, hu₀G⟩
  -- For every prime `p`, a `p`-Sylow of `D` normalised by `u₀`.
  have hexists : ∀ p : {p : ℕ // p.Prime}, ∃ Q : Subgroup G,
      IsSylowSubgroupOf p.1 Q D ∧ (u₀ : G) ∈ Subgroup.normalizer (Q : Set G) := by
    intro p
    by_cases hpdvd : p.1 ∣ Nat.card ↥D
    · have hp2 : p.1 ≠ 2 := by
        intro h2
        exact (odd_iff_not_two_dvd (Nat.card ↥D)).mp hDodd (h2 ▸ hpdvd)
      exact exists_sylow_normalized_of_regularIntersection hbender hne ht htH
        (hcon' p.1 p.2 hp2) hu₀inv
    · refine ⟨⊥, ?_, ?_⟩
      · refine ⟨bot_le, IsPGroup.of_bot, ?_⟩
        rw [Subgroup.bot_subgroupOf, Subgroup.index_bot]
        exact hpdvd
      · rw [Subgroup.normalizer_eq_top]
        exact Subgroup.mem_top _
  let Q₀ : {p : ℕ // p.Prime} → Subgroup G := fun p => Classical.choose (hexists p)
  have hQ₀syl : ∀ p, IsSylowSubgroupOf p.1 (Q₀ p) D :=
    fun p => (Classical.choose_spec (hexists p)).1
  have hQ₀norm : ∀ p, (u₀ : G) ∈ Subgroup.normalizer (Q₀ p : Set G) :=
    fun p => (Classical.choose_spec (hexists p)).2
  let Q : ∀ p : ℕ, Subgroup G := fun p => if hp : p.Prime then Q₀ ⟨p, hp⟩ else ⊥
  have hQsyl : ∀ p, p.Prime → IsSylowSubgroupOf p (Q p) D := by
    intro p hp
    dsimp only [Q]
    rw [dif_pos hp]
    exact hQ₀syl ⟨p, hp⟩
  have hQnorm : ∀ p, p.Prime → (u₀ : G) ∈ Subgroup.normalizer (Q p : Set G) := by
    intro p hp
    dsimp only [Q]
    rw [dif_pos hp]
    exact hQ₀norm ⟨p, hp⟩
  -- `D` is generated by the chosen Sylows, hence normalised by `u₀`.
  have hDiSup : D = ⨆ p : {p : ℕ // p.Prime}, Q p.1 := sylow_iSup_eq Q hQsyl
  have hconj_iSup : Submission.Blueprint.conj (u₀ : G)
      (⨆ p : {p : ℕ // p.Prime}, Q p.1) = ⨆ p : {p : ℕ // p.Prime}, Q p.1 := by
    rw [show Submission.Blueprint.conj (u₀ : G) (⨆ p : {p : ℕ // p.Prime}, Q p.1)
          = (⨆ p : {p : ℕ // p.Prime}, Q p.1).map (MulAut.conj (u₀ : G)).toMonoidHom
        from rfl,
      Subgroup.map_iSup]
    exact iSup_congr (fun p =>
      (conj_eq_self_iff_mem_normalizer (u₀ : G) (Q p.1)).mpr (hQnorm p.1 p.2))
  have hu_norm_D : (u₀ : G) ∈ Subgroup.normalizer (D : Set G) := by
    rw [hDiSup]
    exact (conj_eq_self_iff_mem_normalizer (u₀ : G)
      (⨆ p : {p : ℕ // p.Prime}, Q p.1)).mp hconj_iSup
  have hu_mem : (u₀ : G) ∈ Subgroup.normalizer (D : Set G) ⊓ H :=
    Subgroup.mem_inf.mpr ⟨hu_norm_D, hu₀H⟩
  -- Contradiction with part (a).
  have h2dvd : 2 ∣ Nat.card ↥(Subgroup.normalizer (D : Set G) ⊓ H) := by
    have hx2 : orderOf (⟨(u₀ : G), hu_mem⟩ : ↥(Subgroup.normalizer (D : Set G) ⊓ H)) = 2 := by
      rw [← Subgroup.orderOf_coe]
      exact hu₀G
    have h := orderOf_dvd_natCard
      (⟨(u₀ : G), hu_mem⟩ : ↥(Subgroup.normalizer (D : Set G) ⊓ H))
    rwa [hx2] at h
  exact absurd h2dvd
    ((odd_iff_not_two_dvd (Nat.card ↥(Subgroup.normalizer (D : Set G) ⊓ H))).mp hpart_a)

end Work.DoubleTransitivity.Sec5
