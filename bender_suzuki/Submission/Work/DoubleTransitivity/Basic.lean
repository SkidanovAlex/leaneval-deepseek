/-!
# `Work.DoubleTransitivity.Basic` — vocabulary for Bender's double transitivity theorem

Peterfalvi, *Le théorème de Bender–Suzuki I*, Chapters I–II and Appendices I–IV.

This area proves **Theorem A**: a finite group `G` of 2-rank `≥ 2` acts doubly transitively on
the conjugates of one of its proper Bender subgroups (`Submission.Blueprint.ThmAProp`).

The present module fixes the vocabulary and its first API:

* `IsBenderFor p H := p ∣ |H| ∧ ∀ x ∉ H, ¬ p ∣ |H ∩ H^x|` (Peterfalvi I §1 (1));
* `IsBender H := IsBenderFor 2 H` (from §2 on, "Bender group" means Bender group for `p = 2`);
* `Omega H := G ⧸ H`, the set of conjugates of `H` on which `G` acts by left translation,
  with canonical point `pt H` stabilised by `H`;
* `mem_conj`, `conj_eq_self_iff_mem_normalizer`, and the two halves of Peterfalvi I §1 (2).

Everything is phrased with the challenge's `conj g H = g H g⁻¹` and with the action of `G` on
the left cosets `g H`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open LeanEval.GroupTheory.Defs

namespace Work.DoubleTransitivity

open Submission.Blueprint

variable {G : Type} [Group G]

/-! ## 1. Bender subgroups -/

/-- `H` is a *Bender subgroup for `p`* of `G` (Peterfalvi I §1 (1)): `p` divides `|H|` and
`p` does not divide `|H ∩ H^x|` for every `x ∉ H` (here `H^x` is
`Submission.Blueprint.conj x H`, i.e. `x H x⁻¹`). -/
def IsBenderFor (p : ℕ) (H : Subgroup G) : Prop :=
  p ∣ Nat.card H ∧ ∀ x : G, x ∉ H → ¬ p ∣ Nat.card ↥(H ⊓ conj x H)

/-- A *Bender subgroup* of `G`: a Bender subgroup for `p = 2` (Peterfalvi I §2). -/
def IsBender (H : Subgroup G) : Prop := IsBenderFor 2 H

/-- A *proper* Bender subgroup: the challenge's `IsStronglyEmbedded`. -/
def IsProperBender (H : Subgroup G) : Prop := H ≠ ⊤ ∧ IsBender H

/-- The set `Ω = G ⧸ H` of conjugates of `H`, on which `G` acts by left translation. -/
abbrev Omega (H : Subgroup G) : Type := G ⧸ H

/-- `2 ∣ n ↔ Even n` and `¬ 2 ∣ n ↔ Odd n`, as a rewrite rule. -/
theorem odd_iff_not_two_dvd (n : ℕ) : Odd n ↔ ¬ 2 ∣ n := by
  rw [← Nat.not_even_iff_odd, even_iff_two_dvd]

/-- The challenge's `IsStronglyEmbedded H` is exactly "`H ≠ ⊤` and `H` is a Bender subgroup"
(Peterfalvi I §1 (1), §2). -/
theorem isStronglyEmbedded_iff (H : Subgroup G) :
    IsStronglyEmbedded H ↔ IsProperBender H := by
  rw [IsProperBender, IsBender, IsBenderFor]
  constructor
  · rintro ⟨hne, hev, hodd⟩
    exact ⟨hne, even_iff_two_dvd.mp hev, fun x hx => (odd_iff_not_two_dvd _).mp (hodd x hx)⟩
  · rintro ⟨hne, hev, hodd⟩
    exact ⟨hne, even_iff_two_dvd.mpr hev, fun x hx => (odd_iff_not_two_dvd _).mpr (hodd x hx)⟩

/-! ## 2. The conjugation API -/

/-- Membership in `conj g H = g H g⁻¹`. -/
theorem mem_conj (g y : G) (H : Subgroup G) : y ∈ conj g H ↔ g⁻¹ * y * g ∈ H := by
  rw [Submission.Blueprint.conj, Subgroup.mem_map]
  constructor
  · rintro ⟨z, hz, hzy⟩
    have h1 : g * z * g⁻¹ = y := by
      simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using hzy
    have : g⁻¹ * y * g = z := by rw [← h1]; group
    rw [this]; exact hz
  · intro h
    exact ⟨g⁻¹ * y * g, h, by simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]; group⟩

/-- `MulAut.conj g x = x` iff `g` and `x` commute. -/
theorem conj_eq_iff_mul_comm (g x : G) : MulAut.conj g x = x ↔ g * x = x * g := by
  rw [MulAut.conj_apply]
  constructor
  · intro h
    calc g * x = (g * x * g⁻¹) * g := by group
      _ = x * g := by rw [h]
  · intro h
    calc g * x * g⁻¹ = (x * g) * g⁻¹ := by rw [h]
      _ = x := by group

theorem conj_one (H : Subgroup G) : conj (1 : G) H = H := by
  apply Subgroup.ext
  intro x
  rw [mem_conj]
  simp

theorem conj_mul (g h : G) (H : Subgroup G) : conj (g * h) H = conj g (conj h H) := by
  apply Subgroup.ext
  intro x
  rw [mem_conj, mem_conj, mem_conj,
    show (g * h)⁻¹ * x * (g * h) = h⁻¹ * (g⁻¹ * x * g) * h from by group]

theorem conj_conj_inv (g : G) (H : Subgroup G) : conj g (conj g⁻¹ H) = H := by
  rw [← conj_mul, mul_inv_cancel, conj_one]

theorem conj_inv_conj (g : G) (H : Subgroup G) : conj g⁻¹ (conj g H) = H := by
  rw [← conj_mul, inv_mul_cancel, conj_one]

theorem conj_injective (g : G) : Function.Injective (conj g : Subgroup G → Subgroup G) :=
  fun A B h => by
    have := congrArg (conj g⁻¹) h
    simpa [conj_inv_conj] using this

/-- Conjugation carries the cyclic subgroup generated by `x` to that generated by `conj g x`. -/
theorem conj_zpowers (g x : G) :
    conj g (Subgroup.zpowers x) = Subgroup.zpowers (MulAut.conj g x) := by
  change Subgroup.map (MulAut.conj g).toMonoidHom (Subgroup.zpowers x) = _
  rw [MonoidHom.map_zpowers]
  rfl

theorem conj_eq_self_iff_mem_normalizer (g : G) (H : Subgroup G) :
    conj g H = H ↔ g ∈ Subgroup.normalizer (H : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  constructor
  · intro h y
    constructor
    · intro hy
      have h1 := Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hy
      rw [show H.map (MulAut.conj g).toMonoidHom = H from h] at h1
      simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using h1
    · intro hy
      have h2 : g * y * g⁻¹ ∈ conj g H := by rw [h]; exact hy
      have h3 := (mem_conj g (g * y * g⁻¹) H).mp h2
      rwa [show g⁻¹ * (g * y * g⁻¹) * g = y from by group] at h3
  · intro h
    apply Subgroup.ext
    intro y
    rw [mem_conj]
    constructor
    · intro hy
      have h1 : g * (g⁻¹ * y * g) * g⁻¹ ∈ H := (h (g⁻¹ * y * g)).mp hy
      rwa [show g * (g⁻¹ * y * g) * g⁻¹ = y from by group] at h1
    · intro hy
      exact (h (g⁻¹ * y * g)).mpr
        (by rw [show g * (g⁻¹ * y * g) * g⁻¹ = y from by group]; exact hy)

/-- **Peterfalvi I §1 (2)**, first part: a subgroup of `H` of order divisible by `p` has its
normaliser inside `H`. -/
theorem IsBenderFor.normalizer_le {p : ℕ} {H X : Subgroup G} (h : IsBenderFor p H)
    (hX : X ≤ H) (hp : p ∣ Nat.card X) :
    Subgroup.normalizer (X : Set G) ≤ H := by
  intro g hg
  by_contra hgH
  have hconj : conj g X = X := (conj_eq_self_iff_mem_normalizer g X).mpr hg
  have hle : X ≤ H ⊓ conj g H := le_inf hX (hconj.symm ▸ Subgroup.map_mono hX)
  have hdvd : p ∣ Nat.card ↥(H ⊓ conj g H) := dvd_trans hp (Subgroup.card_dvd_of_le hle)
  exact h.2 g hgH hdvd

/-- **Peterfalvi I §1 (2)**, second part: an element of `H` of order divisible by `p` has its
centraliser inside `H`. -/
theorem IsBenderFor.centralizer_le {p : ℕ} {H : Subgroup G} (h : IsBenderFor p H)
    {x : G} (hxH : x ∈ H) (hpx : p ∣ orderOf x) :
    Subgroup.centralizer ({x} : Set G) ≤ H := by
  refine le_trans ?_ (h.normalizer_le (Subgroup.zpowers_le.mpr hxH) ?_)
  · intro g hg
    refine (conj_eq_self_iff_mem_normalizer g (Subgroup.zpowers x)).mp ?_
    have hgx : g * x = x * g := Subgroup.mem_centralizer_singleton_iff.mp hg
    rw [conj_zpowers, (conj_eq_iff_mul_comm g x).mpr hgx]
  · rw [Nat.card_zpowers]; exact hpx

/-! ## 3. The set `Ω = G ⧸ H` -/

/-- The canonical point of `Ω = G ⧸ H`, whose stabiliser is `H`. -/
abbrev pt (H : Subgroup G) : Omega H := QuotientGroup.mk 1

@[simp] theorem smul_pt (g : G) (H : Subgroup G) : g • pt H = QuotientGroup.mk g := by
  simp [pt]

theorem smul_mk (g x : G) (H : Subgroup G) :
    g • (QuotientGroup.mk x : Omega H) = QuotientGroup.mk (g * x) := rfl

theorem mk_eq_mk_iff {x y : G} {H : Subgroup G} :
    (QuotientGroup.mk x : Omega H) = QuotientGroup.mk y ↔ x⁻¹ * y ∈ H :=
  QuotientGroup.eq

theorem mk_one_eq_iff {x : G} {H : Subgroup G} :
    (QuotientGroup.mk x : Omega H) = pt H ↔ x ∈ H := by
  rw [mk_eq_mk_iff]; simp

theorem smul_mk_eq_mk_iff {g x : G} {H : Subgroup G} :
    g • (QuotientGroup.mk x : Omega H) = QuotientGroup.mk x ↔ g ∈ conj x H := by
  rw [smul_mk, mk_eq_mk_iff, mem_conj,
    show (g * x)⁻¹ * x = (x⁻¹ * g * x)⁻¹ from by group]
  exact Subgroup.inv_mem_iff H

/-- The stabiliser of the point `QuotientGroup.mk x` is `conj x H = x H x⁻¹`. -/
theorem mem_conj_iff_smul_fixed {g x : G} {H : Subgroup G} :
    g ∈ conj x H ↔ g • (QuotientGroup.mk x : Omega H) = QuotientGroup.mk x :=
  smul_mk_eq_mk_iff.symm

/-- `X` fixes the point `pt H` iff `X ≤ H`. -/
theorem pt_mem_fixedPts_iff (X H : Subgroup G) :
    pt H ∈ fixedPts H X ↔ X ≤ H := by
  simp only [fixedPts, Set.mem_ofPred_eq, SetLike.le_def]
  constructor
  · intro h x hx
    have := h x hx
    rw [smul_pt] at this
    exact mk_one_eq_iff.mp this
  · intro h x hx
    have := h hx
    rw [smul_pt]
    exact mk_one_eq_iff.mpr this

/-- `X` fixes the point `QuotientGroup.mk g` iff `X ≤ conj g H`. -/
theorem mk_mem_fixedPts_iff (X H : Subgroup G) (g : G) :
    (QuotientGroup.mk g : Omega H) ∈ fixedPts H X ↔ X ≤ conj g H := by
  simp only [fixedPts, Set.mem_ofPred_eq, SetLike.le_def]
  constructor
  · intro h x hx
    exact smul_mk_eq_mk_iff.mp (h x hx)
  · intro h x hx
    exact smul_mk_eq_mk_iff.mpr (h hx)

end Work.DoubleTransitivity
