import Mathlib
import Submission.Work.AppXIShadow.Basic
import Submission.Work.AppXIShadow.AppII7

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `⟨st⟩ ∩ KerIn H Q P t = 1` (Ch. V §3, step (2), App. XI Prop. 1)

In the standing context `CtxF H Q t s r P`, the cyclic subgroup generated by `st` in `C_G(P)`
meets the kernel `KerIn H Q P t = (Ker H Q P t).subgroupOf C_G(P)` trivially.

The argument is elementary: for `g` in the intersection put `x = (g : G)`.

* `x ∈ Ker H Q P t ≤ C_G(C_Q(P))` and `s ∈ C_Q(P)`, so `s` commutes with `x`, i.e. `s x s = x`;
* `x ∈ ⟨st⟩` and `s (st) s = (st)⁻¹` (both `s` and `t` are involutions), so `s x s = x⁻¹`
  (`conj_zpow_eq_inv_of_mul_eq_inv`);
* hence `x = x⁻¹`, so `x ^ 2 = 1`, and `x ∈ twoPoint H t ⊓ …` where `twoPoint H t` has odd
  order (`odd_card_twoPoint c`); a divisor of `2` of odd order is `1`, so `x = 1`.
-/

set_option autoImplicit false

open Work.ThmF.ChV3 Submission.Blueprint

namespace Work.AppXIShadow

/-- If `b` is an involution, conjugation by `b` commutes with integer powers:
`b * a ^ n * b = (b * a * b) ^ n`. -/
lemma mul_zpow_mul_eq_of_sq_eq_one {G : Type} [Group G] {b a : G} (hb : b * b = 1) (n : ℤ) :
    b * a ^ n * b = (b * a * b) ^ n := by
  have hb' : b⁻¹ = b := inv_eq_of_mul_eq_one_left hb
  have h1 : (MulAut.conj b) (a ^ n) = ((MulAut.conj b) a) ^ n := map_zpow _ _ _
  rw [MulAut.conj_apply] at h1
  rw [hb'] at h1
  rw [MulAut.conj_apply] at h1
  rw [hb'] at h1
  exact h1

/-- If an involution `b` inverts `a` (`b * a * b = a⁻¹`), then it inverts every integer power of
`a`. -/
lemma conj_zpow_eq_inv_of_mul_eq_inv {G : Type} [Group G] {b a : G} (hb : b * b = 1)
    (h : b * a * b = a⁻¹) (n : ℤ) : b * a ^ n * b = (a ^ n)⁻¹ := by
  rw [mul_zpow_mul_eq_of_sq_eq_one hb n, h, inv_zpow]

theorem zpowers_sMulT_inf_KerIn_eq_bot {G : Type} [Group G] [Finite G] {H Q : Subgroup G}
    {t s r : G} {P : Subgroup G} (c : Work.ThmF.ChV3.CtxF H Q t s r P) :
    Subgroup.zpowers (Work.AppXIShadow.sMulT c) ⊓ Work.AppXIShadow.KerIn H Q P t = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro g hg
  rw [Subgroup.mem_inf] at hg
  obtain ⟨hgz, hgK⟩ := hg
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hgz
  have hxK : ((g : ↥(centP P)) : G) ∈ Ker H Q P t := Subgroup.mem_subgroupOf.mp hgK
  have hx12 := (Subgroup.mem_inf.mp hxK).1
  have hxD : ((g : ↥(centP P)) : G) ∈ twoPoint H t := (Subgroup.mem_inf.mp hx12).1
  have hxCCQ : ((g : ↥(centP P)) : G) ∈ Subgroup.centralizer ((CQ Q P : Subgroup G) : Set G) :=
    (Subgroup.mem_inf.mp hx12).2
  have hxeq : ((g : ↥(centP P)) : G) = (s * t) ^ k := by
    rw [← hk]
    simp only [SubgroupClass.coe_zpow]
  have hs2 : s * s = 1 := s_mul_s c
  have ht2 : t * t = 1 := t_mul_t c
  have hst : s * (s * t) * s = (s * t)⁻¹ := by
    have hs' : s⁻¹ = s := inv_eq_of_mul_eq_one_left hs2
    have ht' : t⁻¹ = t := inv_eq_of_mul_eq_one_left ht2
    rw [mul_inv_rev, hs', ht']
    rw [← mul_assoc s s t, hs2, one_mul]
  have hconj : s * ((g : ↥(centP P)) : G) * s = (((g : ↥(centP P)) : G))⁻¹ := by
    rw [hxeq]
    exact conj_zpow_eq_inv_of_mul_eq_inv hs2 hst k
  have hcomm : s * ((g : ↥(centP P)) : G) = ((g : ↥(centP P)) : G) * s :=
    (Subgroup.mem_centralizer_iff.mp hxCCQ) s (s_mem_CQ c)
  have hcent : s * ((g : ↥(centP P)) : G) * s = ((g : ↥(centP P)) : G) := by
    rw [hcomm, mul_assoc, hs2, mul_one]
  have hxx : ((g : ↥(centP P)) : G) = (((g : ↥(centP P)) : G))⁻¹ := by
    rw [← hconj, hcent]
  have hx2 : ((g : ↥(centP P)) : G) ^ 2 = 1 := by
    rw [pow_two]
    exact eq_inv_iff_mul_eq_one.mp hxx
  have hdvd2 : orderOf ((g : ↥(centP P)) : G) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hx2
  have hdvdD : orderOf ((g : ↥(centP P)) : G) ∣ Nat.card ↥(twoPoint H t) :=
    Subgroup.orderOf_dvd_natCard (twoPoint H t) hxD
  have hodd : Odd (orderOf ((g : ↥(centP P)) : G)) := Odd.of_dvd_nat (odd_card_twoPoint c) hdvdD
  have hone : orderOf ((g : ↥(centP P)) : G) = 1 := by
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h | h
    · exact h
    · exact absurd (h ▸ hodd) (by norm_num)
  have hxone : ((g : ↥(centP P)) : G) = 1 := orderOf_eq_one_iff.mp hone
  exact Subtype.ext (by simpa using hxone)

end Work.AppXIShadow
