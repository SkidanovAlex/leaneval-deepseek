/-! ## Idempotent lifting for the group algebra `𝔽_p[F]`

The main theorem is `Work.BSLit.Wielandt.LiftIdempotentMatrix`.  The route is the one spelled out
there: the entrywise reduction `M_n((ℤ/p^k)[F]) → M_n(𝔽_p[F])` is a surjective ring homomorphism
whose kernel is nilpotent (`p^k = 0` in `ZMod (p^k)`), so Mathlib's
`exists_isIdempotentElem_eq_of_ker_isNilpotent` lifts idempotents.

The two auxiliary facts it rests on are proved separately:
* `Work.BSLit.Wielandt.exists_eq_mul_of_castHom_eq_zero`: the kernel of the reduction
  `ZMod n →+* ZMod m` (`m ∣ n`) is the ideal generated by `m`;
* `Work.BSLit.Wielandt.exists_eq_algebraMap_mul_of_mapRingHom_eq_zero`: coefficientwise, an
  element of `A[M]` killed by `A[M] →+* B[M]` is a left multiple of `algebraMap A A[M] r`
  when every element of `ker ψ` is a left multiple of `r`.
-/

/-- A matrix all of whose entries are multiples of a central element `r` with `r ^ N = 0` has
`N`-th power zero (specialised to `N = k`, the exponent for which `p ^ k = 0`). -/
private theorem smul_pow_eq_zero {R : Type*} [Ring R] {m : ℕ} (r : R)
    (hr : ∀ s : R, Commute r s) (Z : Matrix (Fin m) (Fin m) R) (N : ℕ) (hrN : r ^ N = 0) :
    (r • Z) ^ N = 0 := by
  have hmul : r • Z = (Matrix.scalar (Fin m) r) * Z := by
    rw [Matrix.scalar_apply, Matrix.smul_eq_diagonal_mul]
  rw [hmul, Commute.mul_pow (Matrix.scalar_commute r hr Z) N]
  rw [← map_pow (Matrix.scalar (Fin m)) r N, hrN, map_zero, zero_mul]

/-- **Idempotent lifting for the group algebra.**  Let `F` be a finite group, `p` a prime,
`k ≥ 1` and `n : ℕ`.  Every idempotent `n × n` matrix `E` over the group algebra `𝔽_p[F]` lifts
to an idempotent matrix `E'` over `(ℤ/p^k)[F]` whose coefficientwise reduction is `E`
(the reduction being the ring homomorphism `MonoidAlgebra.mapRingHom F (ZMod.castHom …)`
induced by `ZMod (p^k) →+* ZMod p`).

Route: the reduction `M_n((ℤ/p^k)[F]) → M_n(𝔽_p[F])` is a surjective ring homomorphism whose
kernel `p • M_n((ℤ/p^k)[F])` is nilpotent (`(p·x)^k = p^k·x^k = 0`), so the idempotent `E` lifts
by Mathlib's `exists_isIdempotentElem_eq_of_ker_isNilpotent`; surjectivity is coefficientwise
lift of entries along the surjection `ZMod (p^k) → ZMod p` (`ZMod.castHom_surjective`).  Note
Mathlib has no bundled entrywise ring homomorphism `M_n(A) →+* M_n(B)` for a ring hom
`A →+* B`, so it has to be built by hand (`Matrix.map` is additive and multiplicative). -/
theorem LiftIdempotentMatrix {F : Type*} [Group F] [Fintype F] {p k : ℕ} [Fact p.Prime]
    (hk : 1 ≤ k) {n : ℕ} (E : Matrix (Fin n) (Fin n) (MonoidAlgebra (ZMod p) F))
    (hE : E * E = E) :
    ∃ E' : Matrix (Fin n) (Fin n) (MonoidAlgebra (ZMod (p^k)) F),
      E' * E' = E' ∧
      E'.map (MonoidAlgebra.mapRingHom F
        (ZMod.castHom (dvd_pow_self p (Nat.pos_iff_ne_zero.mp hk)) (ZMod p))) = E := by
  classical
  -- the coefficientwise reduction `(ℤ/p^k)[F] → 𝔽_p[F]`, and its entrywise extension to matrices
  let ψ : ZMod (p ^ k) →+* ZMod p :=
    ZMod.castHom (dvd_pow_self p (Nat.pos_iff_ne_zero.mp hk)) (ZMod p)
  let φ : MonoidAlgebra (ZMod (p ^ k)) F →+* MonoidAlgebra (ZMod p) F :=
    MonoidAlgebra.mapRingHom F ψ
  let f : Matrix (Fin n) (Fin n) (MonoidAlgebra (ZMod (p ^ k)) F) →+*
      Matrix (Fin n) (Fin n) (MonoidAlgebra (ZMod p) F) := RingHom.mapMatrix φ
  have hφsurj : Function.Surjective φ :=
    MonoidAlgebra.map_surjective (M := F) ψ.toAddMonoidHom
      (ZMod.castHom_surjective (dvd_pow_self p (Nat.pos_iff_ne_zero.mp hk)))
  -- every element of `ker ψ` is a multiple of `p`
  have hdiv : ∀ a : ZMod (p ^ k), ψ a = 0 → ∃ b : ZMod (p ^ k), a = (p : ZMod (p ^ k)) * b :=
    fun a ha => exists_eq_mul_of_castHom_eq_zero (dvd_pow_self p (Nat.pos_iff_ne_zero.mp hk)) a ha
  -- hence the kernel of `f` is nilpotent
  have hker : ∀ x ∈ RingHom.ker f, IsNilpotent x := by
    intro x hx
    rw [RingHom.mem_ker] at hx
    have hxij : ∀ i j, φ (x i j) = 0 := by
      intro i j
      have h := congrArg (fun M => M i j) hx
      simpa [f, RingHom.mapMatrix_apply, Matrix.map_apply] using h
    choose z hz using fun i j =>
      exists_eq_algebraMap_mul_of_mapRingHom_eq_zero ψ (p : ZMod (p ^ k)) hdiv (x i j) (hxij i j)
    have hp_eq : (p : MonoidAlgebra (ZMod (p ^ k)) F) =
        algebraMap (ZMod (p ^ k)) (MonoidAlgebra (ZMod (p ^ k)) F) (p : ZMod (p ^ k)) :=
      (map_natCast (algebraMap (ZMod (p ^ k)) (MonoidAlgebra (ZMod (p ^ k)) F)) p).symm
    have hpk : (p : MonoidAlgebra (ZMod (p ^ k)) F) ^ k = 0 := by
      rw [hp_eq, ← map_pow, ← Nat.cast_pow, CharP.cast_eq_zero, map_zero]
    have hcent : ∀ s : MonoidAlgebra (ZMod (p ^ k)) F,
        Commute (p : MonoidAlgebra (ZMod (p ^ k)) F) s := by
      intro s
      rw [hp_eq]
      exact Algebra.commutes _ s
    have hxsmul : x = (p : MonoidAlgebra (ZMod (p ^ k)) F) • Matrix.of (fun i j => z i j) := by
      apply Matrix.ext
      intro i j
      rw [Matrix.smul_apply, Matrix.of_apply, smul_eq_mul, hz i j, hp_eq]
    exact ⟨k, by rw [hxsmul]; exact smul_pow_eq_zero _ hcent _ k hpk⟩
  -- `E` lies in the range of `f`, i.e. it can be lifted entrywise along `φ`
  have hmem : E ∈ f.range := by
    refine Set.mem_range.mpr ⟨E.map fun a => Classical.choose (hφsurj a), ?_⟩
    show (RingHom.mapMatrix φ) (E.map fun a => Classical.choose (hφsurj a)) = E
    apply Matrix.ext
    intro i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.map_apply]
    exact Classical.choose_spec (hφsurj (E i j))
  obtain ⟨E', hE'idem, hE'map⟩ := exists_isIdempotentElem_eq_of_ker_isNilpotent f hker E hmem hE
  refine ⟨E', hE'idem, ?_⟩
  show (RingHom.mapMatrix φ) E' = E
  exact hE'map

end Work.BSLit.Wielandt
