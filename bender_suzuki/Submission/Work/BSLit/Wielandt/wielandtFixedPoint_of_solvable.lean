/-- Conjugation in a subgroup agrees with the conjugation in the ambient group. -/
theorem subtype_conj {Q : Type*} [Group Q] (F : Subgroup (MulAut Q)) (k y : ↥F) :
    F.subtype (MulAut.conj k y) = MulAut.conj (F.subtype k) (F.subtype y) := by
  simp only [MulAut.conj_apply, map_mul, map_inv]

/-- Conjugation in a subgroup is compatible with `Subgroup.comap` along the inclusion. -/
theorem comap_conj_map {Q : Type*} [Group Q] (F H : Subgroup (MulAut Q)) (k : ↥F) :
    (H.comap F.subtype).map (MulAut.conj k).toMonoidHom =
      (H.map (MulAut.conj (F.subtype k)).toMonoidHom).comap F.subtype := by
  ext x
  constructor
  · intro hx
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
    rw [Subgroup.mem_comap, Subgroup.mem_map]
    refine ⟨F.subtype y, hy, ?_⟩
    rw [← hyx]
    exact (subtype_conj F k y).symm
  · intro hx
    rw [Subgroup.mem_comap] at hx
    obtain ⟨h, hh, hhx⟩ := Subgroup.mem_map.mp hx
    have hhx' : MulAut.conj (F.subtype k) h = F.subtype x := hhx
    rw [MulAut.conj_apply] at hhx'
    have hF : h ∈ F := by
      have h1 : h = (F.subtype k)⁻¹ * F.subtype x * F.subtype k := by
        rw [← hhx']
        group
      rw [h1]
      exact F.mul_mem (F.mul_mem (F.inv_mem k.2) x.2) k.2
    refine Subgroup.mem_map.mpr ⟨⟨h, hF⟩, hh, ?_⟩
    apply Subtype.ext
    change F.subtype (MulAut.conj k ⟨h, hF⟩) = F.subtype x
    rw [subtype_conj]
    simpa using hhx'

/-- **Wielandt's fixed point formula, solvable case.** Let `Q` be a finite solvable group, `p` a prime, and `K, P ≤ MulAut Q` with `(|K| · |P|, |Q|) = 1`, `C_Q(K) = 1`, `|P| = p`, `P` normalising `K` and `P ⊓ P ^ k = ⊥` for `k ∈ K^#`. Then `|Q| = |C_Q(P)| ^ p`. Route: if `K = ⊥` then `C_Q(K) = Q = 1` and both sides are `1`. Otherwise put `F := K ⊔ P ≤ MulAut Q`; `K ⊓ P = ⊥` (a nontrivial element of `K ⊓ P` would contradict the TI hypothesis, since `P ^ x = P` for `x ∈ P`), so `|F| = |K| · |P|` is coprime to `|Q|` (prove `Nat.card ↥(K ⊔ P) = Nat.card K * Nat.card P` from `K ⊓ P = ⊥` and `P` normalising `K` via the bijection `K × P → K ⊔ P`, `(k,p) ↦ k * p`), `F` acts on `Q` through `F.subtype : ↥F →* MulAut Q`, and `Work.BSLit.Wielandt.FrobeniusProduct` applied to `K' := K.comap F.subtype`, `P' := P.comap F.subtype` (with `K' ⊔ P' = ⊤` and the hypotheses transported along the inclusion, `Nat.card P' = Nat.card P`, `Nat.card K' = Nat.card K`) gives `|C_Q(P)| ^ (p * |K|) · |C_Q(K)| ^ |K| = |C_Q(F)| ^ (p * |K|) · |Q| ^ |K|`; now `C_Q(K) = 1` and `C_Q(F) = C_Q(K) ⊓ C_Q(P) = 1`, so `|C_Q(P)| ^ p = |Q|` (take `|K|`-th roots; `|K| ≥ 1`, so `x ^ |K| = y ^ |K| ⟹ x = y`). The conversion between `Nat.card (fixedBy F.subtype P')` and `Nat.card (fixedBy ...)` for the ambient subgroups uses `Work.BSLit.mem_fixedBy` and `Subgroup.mem_comap`, and `Work.BSLit.card_fixedBy_eq_ncard` relates the latter to the `Set.ncard` in the conclusion. -/
theorem wielandtFixedPoint_of_solvable {Q : Type*} [Group Q] [Finite Q] {p : ℕ} (hp : p.Prime)
    (K P : Subgroup (MulAut Q)) (hsol : Group.IsSolvable Q)
    (hcop : Nat.Coprime (Nat.card K * Nat.card P) (Nat.card Q))
    (hCK : ∀ q : Q, (∀ k ∈ K, k q = q) → q = 1)
    (hcardP : Nat.card P = p)
    (hPK : ∀ g ∈ P, ∀ k ∈ K, g * k * g⁻¹ ∈ K)
    (hTI : ∀ k ∈ K, k ≠ 1 → P ⊓ P.map (MulAut.conj k⁻¹).toMonoidHom = ⊥) :
    Nat.card Q = (Set.ncard {q : Q | ∀ g ∈ P, g q = q}) ^ p := by
  classical
  haveI : Fintype ↥(K ⊔ P : Subgroup (MulAut Q)) := Fintype.ofFinite _
  haveI : Group.IsSolvable Q := hsol
  -- the group `F = K ⊔ P` generated by `K` and `P`
  set F : Subgroup (MulAut Q) := K ⊔ P with hFdef
  have hKle : K ≤ F := le_sup_left
  have hPle : P ≤ F := le_sup_right
  set K' : Subgroup ↥F := K.comap F.subtype with hK'def
  set P' : Subgroup ↥F := P.comap F.subtype with hP'def
  -- the cardinalities of `K'` and `P'`
  have hcardK' : Nat.card ↥K' = Nat.card ↥K := by
    refine Nat.card_congr ?_
    refine
      { toFun := fun x => ⟨(x.1 : MulAut Q), x.2⟩
        invFun := fun y => ⟨⟨(y.1 : MulAut Q), hKle y.2⟩, y.2⟩
        left_inv := fun x => by ext; rfl
        right_inv := fun y => by ext; rfl }
  have hcardP' : Nat.card ↥P' = Nat.card ↥P := by
    refine Nat.card_congr ?_
    refine
      { toFun := fun x => ⟨(x.1 : MulAut Q), x.2⟩
        invFun := fun y => ⟨⟨(y.1 : MulAut Q), hPle y.2⟩, y.2⟩
        left_inv := fun x => by ext; rfl
        right_inv := fun y => by ext; rfl }
  -- the transported hypotheses
  have hK'map : K'.map F.subtype = K := by
    rw [hK'def, Subgroup.map_comap_eq, Subgroup.range_subtype]
    exact inf_eq_right.mpr hKle
  have hP'map : P'.map F.subtype = P := by
    rw [hP'def, Subgroup.map_comap_eq, Subgroup.range_subtype]
    exact inf_eq_right.mpr hPle
  have hsup' : K' ⊔ P' = ⊤ := by
    apply Subgroup.map_injective F.subtype_injective
    rw [Subgroup.map_sup, hK'map, hP'map, Subgroup.map_top, Subgroup.range_subtype, hFdef]
  have hdisj' : K' ⊓ P' = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Subgroup.mem_bot]
    apply Subtype.ext
    have h1 : (x : MulAut Q) ∈ K ⊓ P :=
      Subgroup.mem_inf.mpr ⟨(Subgroup.mem_inf.mp hx).1, (Subgroup.mem_inf.mp hx).2⟩
    rw [TIInfBot K P hTI] at h1
    exact Subgroup.mem_bot.mp h1
  have hnorm' : ∀ g ∈ P', ∀ k ∈ K', g * k * g⁻¹ ∈ K' := by
    intro g hg k hk
    rw [Subgroup.mem_comap] at hg hk ⊢
    simpa using hPK (g : MulAut Q) hg (k : MulAut Q) hk
  have hTI' : ∀ k ∈ K', k ≠ 1 → P' ⊓ P'.map (MulAut.conj k⁻¹).toMonoidHom = ⊥ := by
    intro k hk hk1
    have hdisj := hTI (F.subtype k) hk (fun h => hk1 (Subtype.ext h))
    have hmap : P'.map (MulAut.conj k⁻¹).toMonoidHom =
        (P.map (MulAut.conj (F.subtype k)⁻¹).toMonoidHom).comap F.subtype := by
      have h := comap_conj_map F P (k⁻¹)
      rw [hP'def, map_inv]
      exact h
    rw [hmap, hP'def, ← Subgroup.comap_inf, hdisj, MonoidHom.comap_bot,
      (MonoidHom.ker_eq_bot_iff F.subtype).mpr F.subtype_injective]
  -- coprimality and the fixed point hypothesis, transported to `↥F`
  have hcardF : Nat.card ↥F = Nat.card ↥K * Nat.card ↥P := by
    have h := card_mul_card_sup K' P' hsup' hnorm' hdisj'
    rw [hsup', Subgroup.card_top] at h
    rw [← hcardK', ← hcardP']
    exact h.symm
  have hcopF : Nat.Coprime (Nat.card ↥F) (Nat.card Q) := by
    rw [hcardF]
    exact hcop
  have hCK' : ∀ q : Q, (∀ k ∈ K', F.subtype k q = q) → q = 1 := by
    intro q hq
    exact hCK q fun k hk => hq ⟨k, hKle hk⟩ (Subgroup.mem_comap.mpr hk)
  -- Wielandt's counting formula for `Q` with the action of `↥F`
  have hmain : Nat.card Q = (Nat.card ↥(fixedBy F.subtype P')) ^ Nat.card P' :=
    frobeniusProduct_of_fsimple hp K' P' hsup' (hcardP'.trans hcardP) hnorm' hTI'
      (fun q _ M _ _ hexp ρ' hq hsimple hCK'' =>
        frobeniusFSimpleCase hexp hp ρ' hq hsimple K' P' hsup' (hcardP'.trans hcardP)
          hnorm' hTI' hCK'')
      Q F.subtype hcopF hCK'
  rw [hcardP', hcardP] at hmain
  -- the fixed points of `P'` are the set appearing in the statement
  have hset : Nat.card ↥(fixedBy F.subtype P') = Set.ncard {q : Q | ∀ g ∈ P, g q = q} := by
    rw [card_fixedBy_eq_ncard]
    congr 1
    ext q
    constructor
    · intro h g hg
      exact h ⟨g, hPle hg⟩ (Subgroup.mem_comap.mpr hg)
    · intro h x hx
      exact h x (Subgroup.mem_comap.mp hx)
  rw [hset] at hmain
  exact hmain

end Work.BSLit.Wielandt
