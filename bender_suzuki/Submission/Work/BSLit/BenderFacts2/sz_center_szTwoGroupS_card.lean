namespace Work.BSLit.BenderFacts2

open LeanEval.GroupTheory.Defs

/-- Every element of the Suzuki `2`-group is a root element `u(a,b)`:
`szTwoGroupS n` is `szTwoGroup n` (whose elements are the `u(a,b)`) viewed inside
`SzModel n`. -/
lemma exists_szUgS_of_mem (n : ℕ) (x : ↥(Submission.Sz.szTwoGroupS n)) :
    ∃ a b : Submission.Sz.SzField n, (x : SzModel n) = szUgS n a b := by
  have h : (x : SzModel n) ∈ (Submission.Sz.szTwoGroup n).subgroupOf (SzModel n) := x.2
  have hx' : ((x : SzModel n) : GL (Fin 4) (Submission.Sz.SzField n)) ∈
      Submission.Sz.szTwoGroup n := Subgroup.mem_subgroupOf.mp h
  obtain ⟨a, b, hab⟩ := hx'
  exact ⟨a, b, Subtype.ext (by simpa using hab)⟩

/-- **The centre of the Suzuki `2`-group**: an element is central if and only if it is a
root element `u(0,b)` with `b` in the *second* coordinate, i.e. `Z(U) = {u(0,b)}`. -/
theorem mem_center_szTwoGroupS_iff (n : ℕ) (hn : 1 ≤ n)
    (x : ↥(Submission.Sz.szTwoGroupS n)) :
    x ∈ Subgroup.center ↥(Submission.Sz.szTwoGroupS n) ↔
      ∃ b : Submission.Sz.SzField n, (x : SzModel n) = szUgS n 0 b := by
  constructor
  · intro hx
    obtain ⟨a, b, hab⟩ := exists_szUgS_of_mem n x
    have hcent := Subgroup.mem_center_iff.mp hx
    -- centrality forces `a = 0`
    have ha : a = 0 := by
      by_contra ha
      refine szUgS_not_central_of_ne_zero n hn a b ha fun c d => ?_
      have h := hcent ⟨szUgS n c d, szUgS_mem_U n c d⟩
      have h'' : szUgS n c d * (x : SzModel n) = (x : SzModel n) * szUgS n c d := by
        simpa only [Subgroup.coe_mul] using Subtype.ext_iff.mp h
      simpa only [hab] using h''.symm
    exact ⟨b, by rw [hab, ha]⟩
  · rintro ⟨b, hb⟩
    have hx' : x = ⟨szUgS n 0 b, szUgS_mem_U n 0 b⟩ := Subtype.ext (by simpa using hb)
    rw [hx']
    exact szUgS_zero_mem_center n b

/-- The centre of the Suzuki `2`-group has order `q = 2^(2n+1)`: the parametrisation
`b ↦ u(0,b)` is a bijection from the additive group of `GF(2^(2n+1))` onto it. -/
theorem sz_center_szTwoGroupS_card (n : ℕ) (hn : 1 ≤ n) :
    Nat.card ↥(Subgroup.center ↥(Submission.Sz.szTwoGroupS n)) = 2 ^ (2 * n + 1) := by
  rw [← Submission.Sz.card_szField n]
  refine (Nat.card_congr (Equiv.ofBijective
    (fun b : Submission.Sz.SzField n =>
      (⟨⟨szUgS n 0 b, szUgS_mem_U n 0 b⟩, szUgS_zero_mem_center n b⟩ :
        ↥(Subgroup.center ↥(Submission.Sz.szTwoGroupS n))))
    ⟨?_, ?_⟩)).symm
  · intro b₁ b₂ h
    exact szUgS_zero_injective n (congrArg Subtype.val h)
  · rintro ⟨x, hx⟩
    obtain ⟨b, hb⟩ := (mem_center_szTwoGroupS_iff n hn x).mp hx
    exact ⟨b, Subtype.ext (Subtype.ext hb.symm)⟩

end Work.BSLit.BenderFacts2
