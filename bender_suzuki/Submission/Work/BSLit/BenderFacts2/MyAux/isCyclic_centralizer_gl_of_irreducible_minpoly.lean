open Polynomial Matrix

set_option maxHeartbeats 800000 in
/-- **The centraliser of a matrix in `Mₙ(F)` is the algebra generated by it, when the minimal
polynomial has degree `n`.**

Let `A : Matrix n n F` for a field `F` and a nonempty finite index type `n`, and assume that the
minimal polynomial `m := minpoly F A` is irreducible with `natDegree m = Fintype.card n`.  Then
the centraliser of `A` inside `Mₙ(F)` is exactly the subalgebra `F[A] = range (aeval A)` generated
by `A`.

Indeed, `F[A] ≅ F[X]/(m) = AdjoinRoot m` is a field (as `m` is irreducible) of `F`-dimension
`n = dim_F (n → F)`; hence a nonzero vector `v` gives an injective — and, by dimension, bijective
— `F`-linear map `F[A] → (n → F)`, `T ↦ T *ᵥ v`.  An element `B` commuting with `A` commutes with
all of `F[A]`, so it is determined by its value on `v`, which shows `B ∈ F[A]`. -/
private theorem centralizer_eq_aeval_range_aux {F : Type*} [Field F] {n : Type*} [Fintype n]
    [DecidableEq n] [Nonempty n] (A : Matrix n n F)
    (hirr : Irreducible (minpoly F A))
    (hdeg : (minpoly F A).natDegree = Fintype.card n) :
    Subalgebra.centralizer F ({A} : Set (Matrix n n F)) =
      (Polynomial.aeval A : Polynomial F →ₐ[F] Matrix n n F).range := by
  classical
  set m : Polynomial F := minpoly F A with hm
  haveI : Fact (Irreducible m) := ⟨hirr⟩
  have hAint : IsIntegral F A := IsIntegral.of_finite F A
  have hmonic : m.Monic := minpoly.monic hAint
  let Φ : Polynomial F →ₐ[F] Matrix n n F := Polynomial.aeval A
  have hS : IsAdjoinRoot ↥Φ.range m := by
    refine ⟨Φ.rangeRestrict, Φ.rangeRestrict_surjective, ?_⟩
    rw [AlgHom.ker_rangeRestrict, minpoly.ker_aeval_eq_span_minpoly]
  have hSM : IsAdjoinRootMonic ↥Φ.range m := { hS with monic := hmonic }
  have hfr : Module.finrank F ↥Φ.range = Module.finrank F (n → F) := by
    rw [PowerBasis.finrank hSM.powerBasis, IsAdjoinRootMonic.powerBasis_dim,
      Module.finrank_fintype_fun_eq_card]
    exact hdeg
  have hfield : IsField ↥Φ.range :=
    (MulEquiv.isField_congr hS.adjoinRootAlgEquiv.toMulEquiv).mp
      (AdjoinRoot.isField_iff_irreducible.mpr hirr)
  letI : Field ↥Φ.range := hfield.toField
  let i0 : n := Classical.arbitrary n
  let v : n → F := Pi.single i0 1
  have hv : v ≠ 0 := by
    intro h
    have := congrFun h i0
    simpa [v] using this
  let ψ : ↥Φ.range →ₗ[F] (n → F) :=
    { toFun := fun T => (T : Matrix n n F) *ᵥ v
      map_add' := by intro a b; rw [Subalgebra.coe_add, Matrix.add_mulVec]
      map_smul' := by
        intro c a
        simp only [Subalgebra.coe_smul, Matrix.smul_mulVec, RingHom.id_apply] }
  have key : ∀ T : ↥Φ.range, ψ T = 0 → T = 0 := by
    intro T hT
    have hT' : ((T : ↥Φ.range) : Matrix n n F) *ᵥ v = 0 := hT
    by_contra hne
    have hcoe : ((T⁻¹ * T : ↥Φ.range) : Matrix n n F) = 1 := by
      rw [inv_mul_cancel₀ hne, Subalgebra.coe_one]
    have hzero : v = 0 := by
      calc v = (1 : Matrix n n F) *ᵥ v := by rw [Matrix.one_mulVec]
        _ = ((T⁻¹ * T : ↥Φ.range) : Matrix n n F) *ᵥ v := by rw [hcoe]
        _ = ((T⁻¹ : ↥Φ.range) : Matrix n n F) *ᵥ (((T : ↥Φ.range) : Matrix n n F) *ᵥ v) := by
              rw [Subalgebra.coe_mul, Matrix.mulVec_mulVec]
        _ = ((T⁻¹ : ↥Φ.range) : Matrix n n F) *ᵥ 0 := by rw [hT']
        _ = 0 := Matrix.mulVec_zero _
    exact hv hzero
  have hψinj : Function.Injective ψ := by
    intro a b hab
    have h1 : a - b = 0 := key (a - b) (by rw [map_sub, hab, sub_self])
    exact sub_eq_zero.mp h1
  have hψsurj : Function.Surjective ψ :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfr).mp hψinj
  refine le_antisymm ?_ ?_
  · intro B hB
    rw [Subalgebra.mem_centralizer_iff] at hB
    have hBA : A * B = B * A := hB A (by simp)
    have hSB : Φ.range ≤ Subalgebra.centralizer F ({B} : Set (Matrix n n F)) := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval F A]
      refine Algebra.adjoin_le ?_
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      refine (Subalgebra.mem_centralizer_iff F).mpr ?_
      intro g hg
      rw [Set.mem_singleton_iff] at hg
      subst hg
      exact hBA.symm
    have hcomm : ∀ U : ↥Φ.range, (U : Matrix n n F) * B = B * (U : Matrix n n F) := by
      intro U
      exact ((Subalgebra.mem_centralizer_iff F).mp (hSB U.2) B (by simp)).symm
    obtain ⟨T, hT⟩ := hψsurj (B *ᵥ v)
    have hpoint : ∀ w : n → F, B *ᵥ w = (T : Matrix n n F) *ᵥ w := by
      intro w
      obtain ⟨U, rfl⟩ := hψsurj w
      have hUT : (U : Matrix n n F) * (T : Matrix n n F)
          = (T : Matrix n n F) * (U : Matrix n n F) := by
        rw [← Subalgebra.coe_mul, ← Subalgebra.coe_mul, mul_comm]
      have hT' : (T : Matrix n n F) *ᵥ v = B *ᵥ v := hT
      calc B *ᵥ ψ U
          = B *ᵥ ((U : Matrix n n F) *ᵥ v) := rfl
        _ = (B * (U : Matrix n n F)) *ᵥ v := Matrix.mulVec_mulVec v B (U : Matrix n n F)
        _ = ((U : Matrix n n F) * B) *ᵥ v := by rw [← hcomm U]
        _ = (U : Matrix n n F) *ᵥ (B *ᵥ v) :=
              (Matrix.mulVec_mulVec v (U : Matrix n n F) B).symm
        _ = (U : Matrix n n F) *ᵥ ((T : Matrix n n F) *ᵥ v) := by rw [← hT']
        _ = ((U : Matrix n n F) * (T : Matrix n n F)) *ᵥ v :=
              Matrix.mulVec_mulVec v (U : Matrix n n F) (T : Matrix n n F)
        _ = ((T : Matrix n n F) * (U : Matrix n n F)) *ᵥ v := by rw [hUT]
        _ = (T : Matrix n n F) *ᵥ ((U : Matrix n n F) *ᵥ v) :=
              (Matrix.mulVec_mulVec v (T : Matrix n n F) (U : Matrix n n F)).symm
        _ = (T : Matrix n n F) *ᵥ ψ U := rfl
    have hcol : ∀ j, B.col j = (T : Matrix n n F).col j := by
      intro j
      have h := hpoint (Pi.single j 1)
      simpa [Matrix.mulVec_single] using h
    have hBTeq : B = (T : Matrix n n F) := by
      ext i j
      exact congrFun (hcol j) i
    rw [hBTeq]
    obtain ⟨p, hp⟩ := Φ.rangeRestrict_surjective T
    exact (AlgHom.mem_range Φ).mpr
      ⟨p, congrArg (fun z : ↥Φ.range => (z : Matrix n n F)) hp⟩
  · intro B hB
    obtain ⟨p, rfl⟩ := (AlgHom.mem_range Φ).mp hB
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    rw [hg]
    have hX : A = Φ Polynomial.X := (Polynomial.aeval_X A).symm
    rw [hX, ← map_mul, ← map_mul]
    congr 1
    exact mul_comm _ _

/-- **The centraliser in `GL₄(F)` of an element `A` with irreducible minimal polynomial of
degree `4` is cyclic.**

Let `A ∈ GL₄(F)` for a finite field `F`, with `m := minpoly F A` irreducible of degree `4`.
Then:

* `E := AdjoinRoot m = F[X]/(m)` is a field (as `m` is irreducible), and the evaluation map
  `Φ := aeval A : F[X] →ₐ[F] M₄(F)` realises `E` as the subalgebra `F[A] = Φ.range` of `M₄(F)`
  (via `IsAdjoinRoot`), so that `F[A] ≅ E`;
* since `deg m = 4 = dim_F F⁴`, the underlying space `F⁴` is `1`-dimensional over the field
  `F[A]`, hence the matrix centraliser `Subalgebra.centralizer F {A}` coincides with `F[A]`
  (`centralizer_eq_aeval_range_aux`);
* consequently the centraliser `C` of `A` in `GL₄(F)` is the unit group of `F[A] ≅ E`, and the
  composite `C →* F[A] →* E` is an injective ring homomorphism from the finite group `C` into the
  integral domain `E`; a finite subgroup of the units of an integral domain is cyclic
  (`isCyclic_of_injective_ringHom`). -/
theorem isCyclic_centralizer_gl_of_irreducible_minpoly {F : Type*} [Field F] [Finite F]
    (A : Matrix.GeneralLinearGroup (Fin 4) F)
    (hirr : Irreducible (minpoly F (A : Matrix (Fin 4) (Fin 4) F)))
    (hdeg : (minpoly F (A : Matrix (Fin 4) (Fin 4) F)).natDegree = 4) :
    IsCyclic ↥(Subgroup.centralizer ({A} : Set (Matrix.GeneralLinearGroup (Fin 4) F))) := by
  classical
  -- `A₀` is the underlying matrix of `A`, and `m = minpoly F A₀` is irreducible of degree `4`.
  set A₀ : Matrix (Fin 4) (Fin 4) F := (A : Matrix (Fin 4) (Fin 4) F) with hA₀
  set m : Polynomial F := minpoly F A₀ with hm
  haveI : Fact (Irreducible m) := ⟨hirr⟩
  have hmcard : m.natDegree = Fintype.card (Fin 4) := by rw [hdeg, Fintype.card_fin]
  -- The evaluation map `F[X] →ₐ[F] M₄(F)`, `X ↦ A₀`.
  let Φ : Polynomial F →ₐ[F] Matrix (Fin 4) (Fin 4) F := Polynomial.aeval A₀
  -- `F[A₀] = Φ.range` is generated by a root of `m`, hence is `AdjoinRoot m`.
  have hS : IsAdjoinRoot ↥Φ.range m := by
    refine ⟨Φ.rangeRestrict, Φ.rangeRestrict_surjective, ?_⟩
    rw [AlgHom.ker_rangeRestrict, minpoly.ker_aeval_eq_span_minpoly]
  let e : AdjoinRoot m ≃ₐ[F] ↥Φ.range := hS.adjoinRootAlgEquiv
  -- The centraliser of `A₀` in `M₄(F)` is `F[A₀]`.
  have hCent : Subalgebra.centralizer F ({A₀} : Set (Matrix (Fin 4) (Fin 4) F)) = Φ.range :=
    centralizer_eq_aeval_range_aux A₀ hirr hmcard
  -- The inclusion of the group centraliser into the matrix centraliser.
  let fC : ↥(Subgroup.centralizer ({A} : Set (Matrix.GeneralLinearGroup (Fin 4) F)))
        →* ↥(Subalgebra.centralizer F ({A₀} : Set (Matrix (Fin 4) (Fin 4) F))) :=
    { toFun := fun B =>
        ⟨((B : Matrix.GeneralLinearGroup (Fin 4) F) : Matrix (Fin 4) (Fin 4) F), by
          rw [Subalgebra.mem_centralizer_iff]
          intro g hg
          rw [Set.mem_singleton_iff] at hg
          subst hg
          have hB : A * (B : Matrix.GeneralLinearGroup (Fin 4) F)
              = (B : Matrix.GeneralLinearGroup (Fin 4) F) * A :=
            (Subgroup.mem_centralizer_iff.mp B.2) A (by simp)
          have := congrArg (fun u : Matrix.GeneralLinearGroup (Fin 4) F =>
            (u : Matrix (Fin 4) (Fin 4) F)) hB
          simpa [hA₀] using this⟩
      map_one' := by ext; rfl
      map_mul' := by intro x y; ext; rfl }
  -- `AdjoinRoot m ≃ F[A₀] = centralizer(A₀)`.
  let e2 : AdjoinRoot m ≃ₐ[F]
      ↥(Subalgebra.centralizer F ({A₀} : Set (Matrix (Fin 4) (Fin 4) F))) :=
    e.trans (Subalgebra.equivOfEq Φ.range _ hCent.symm)
  -- An injective ring homomorphism from the finite group `C` into the field `E`.
  let f : ↥(Subgroup.centralizer ({A} : Set (Matrix.GeneralLinearGroup (Fin 4) F)))
      →* AdjoinRoot m := e2.symm.toRingEquiv.toMonoidHom.comp fC
  refine isCyclic_of_injective_ringHom f ?_
  intro x y hxy
  have h1 : fC x = fC y := e2.symm.injective hxy
  have h2 : ((fC x : ↥(Subalgebra.centralizer F ({A₀} : Set (Matrix (Fin 4) (Fin 4) F))))
      : Matrix (Fin 4) (Fin 4) F)
      = ((fC y : ↥(Subalgebra.centralizer F ({A₀} : Set (Matrix (Fin 4) (Fin 4) F))))
      : Matrix (Fin 4) (Fin 4) F) := by rw [h1]
  exact Subtype.ext (Units.ext h2)

end Work.BSLit.BenderFacts2.MyAux
