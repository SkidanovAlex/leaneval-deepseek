namespace Work.HallHigman

universe u v w

/-- A nilpotent endomorphism of a nontrivial module has a nonzero kernel vector: if `f ^ n = 0` then
`f` cannot be injective, because the `n`-fold iterate of an injective map is injective while `0` is
not injective on a nontrivial module. -/
lemma exists_ne_zero_of_pow_eq_zero {K : Type u} [Field K] {V : Type w} [AddCommGroup V]
    [Module K V] (f : Module.End K V) {n : ℕ} (hfn : f ^ n = 0) (hV : Nontrivial V) :
    ∃ v : V, v ≠ 0 ∧ f v = 0 := by
  have hker : f.ker ≠ ⊥ := by
    intro hbot
    have hinj : Function.Injective f := (LinearMap.ker_eq_bot).mp hbot
    have hiter : Function.Injective f^[n] := hinj.iterate n
    have h0 : f^[n] = fun _ => (0 : V) := by
      funext v
      rw [← Module.End.pow_apply f n v, hfn]
      simp
    have hsub : Subsingleton V := by
      refine ⟨fun a b => ?_⟩
      apply hiter
      rw [h0]
    exact not_nontrivial_iff_subsingleton.mpr hsub hV
  obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff f.ker).mp hker
  exact ⟨v, hv0, LinearMap.mem_ker.mp hv⟩

/-- **A finite `p`-group acting `K`-linearly on a nonzero `K`-module over a field of characteristic
`p` has a nonzero fixed vector.**

Induction on `|H|`: pick a central element `z ≠ 1` (finite `p`-groups have nontrivial centre), let
`W` be the fixed space of `z`.  Since `z` has `p`-power order and `K` has characteristic `p`, the
endomorphism `ρ z - 1` is nilpotent, so `W ≠ 0`.  The subgroup `⟨z⟩` is normal (it lies in the
centre) and acts trivially on `W`, so `W` is a module for the quotient `H ⧸ ⟨z⟩`, which is a
`p`-group of strictly smaller order; the induction hypothesis produces a nonzero vector fixed by the
quotient, hence by all of `H`. -/
theorem exists_ne_zero_fixed_of_isPGroup_self {K : Type u} [Field K] {p : ℕ} [CharP K p]
    [Fact p.Prime] {H : Type v} [Group H] [Finite H] (hH : IsPGroup p H)
    {V : Type w} [AddCommGroup V] [Module K V]
    (ρ : Representation K H V) (hV : Nontrivial V) :
    ∃ v : V, v ≠ 0 ∧ ∀ g : H, ρ g v = v := by
  classical
  have key : ∀ n, ∀ (H : Type v) [Group H] [Finite H], Nat.card H = n →
      IsPGroup p H → ∀ {V : Type w} [AddCommGroup V] [Module K V],
      Nontrivial V → ∀ ρ : Representation K H V, ∃ v : V, v ≠ 0 ∧ ∀ g : H, ρ g v = v := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro H _ _ hcard hH V _ _ hV ρ
      haveI := hV
      by_cases hnt : Nontrivial H
      · haveI := hnt
        -- a nontrivial central element `z`
        haveI hcnt : Nontrivial (Subgroup.center H) := IsPGroup.center_nontrivial hH
        obtain ⟨x, hx⟩ := exists_ne (1 : Subgroup.center H)
        obtain ⟨z, hzmem, hzne⟩ : ∃ z : H, z ∈ Subgroup.center H ∧ z ≠ 1 :=
          ⟨(x : H), x.2, by intro h; exact hx (Subtype.ext h)⟩
        -- the cyclic (normal) subgroup generated by `z`
        let Z : Subgroup H := Subgroup.zpowers z
        have hZle : Z ≤ Subgroup.center H := Subgroup.zpowers_le.mpr hzmem
        haveI hZn : Z.Normal := Subgroup.normal_of_le_center hZle
        have hZlt : 1 < Nat.card Z := by
          rw [Subgroup.one_lt_card_iff_ne_bot]
          intro hbot
          have hmem : z ∈ (⊥ : Subgroup H) := by
            rw [← hbot]
            exact Subgroup.mem_zpowers z
          exact hzne (Subgroup.mem_bot.mp hmem)
        -- the fixed space of `z`
        let W : Submodule K V := (ρ z - 1).ker
        have hWmem : ∀ x : V, x ∈ W ↔ ρ z x = x := by
          intro x
          show x ∈ (ρ z - 1).ker ↔ ρ z x = x
          rw [LinearMap.mem_ker, LinearMap.sub_apply, Module.End.one_apply, sub_eq_zero]
        -- `ρ z - 1` is nilpotent in characteristic `p`
        obtain ⟨k, hk⟩ := hH.exists_orderOf_eq_pow z
        have hzpk : z ^ p ^ k = 1 := by rw [← hk]; exact pow_orderOf_eq_one z
        have hnil : (ρ z - 1) ^ (p ^ k) = 0 := by
          haveI : CharP (V →ₗ[K] V) p := Module.charP_end (p := p) (by
            obtain ⟨x, hx⟩ := exists_ne (0 : V)
            exact ⟨x, (Ideal.torsionOf_eq_bot_iff_of_isTorsionFree K x).mpr hx⟩)
          have hzpow : (ρ z) ^ (p ^ k) = 1 := by rw [← map_pow, hzpk, map_one]
          rw [sub_pow_char_pow_of_commute p k (Commute.one_right (ρ z)), hzpow, one_pow,
            sub_self]
        have hWne : W ≠ ⊥ := by
          intro hbot
          obtain ⟨v, hvne, hv0⟩ := exists_ne_zero_of_pow_eq_zero (ρ z - 1) hnil hV
          have hmem : v ∈ W := LinearMap.mem_ker.mpr hv0
          rw [hbot] at hmem
          exact hvne (by simpa using hmem)
        have hWnt : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hWne
        -- `W` is `H`-invariant because `z` is central
        have hinv : ∀ (g : H) {x : V}, x ∈ W → ρ g x ∈ W := by
          intro g x hx
          rw [hWmem] at hx ⊢
          have hcomm : z * g = g * z := ((Subgroup.mem_center_iff.mp hzmem) g).symm
          calc ρ z (ρ g x) = (ρ z * ρ g) x := (Module.End.mul_apply (ρ z) (ρ g) x).symm
            _ = ρ (z * g) x := by rw [map_mul]
            _ = ρ (g * z) x := by rw [hcomm]
            _ = (ρ g * ρ z) x := by rw [map_mul]
            _ = ρ g (ρ z x) := Module.End.mul_apply (ρ g) (ρ z) x
            _ = ρ g x := by rw [hx]
        -- the action of `H` on `W`
        let φfun : H → (W →ₗ[K] W) := fun g => (ρ g).restrict (fun x hx => hinv g hx)
        have hφfun : ∀ (g : H) (xu : W), ((φfun g) xu : V) = ρ g (xu : V) := by
          intro g xu
          simp [φfun, LinearMap.restrict_apply]
        let φ : H →* (W →ₗ[K] W) :=
          { toFun := φfun
            map_one' := by
              apply LinearMap.ext; intro xu; apply Subtype.ext
              rw [hφfun, map_one, Module.End.one_apply, Module.End.one_apply]
            map_mul' := by
              intro g h
              apply LinearMap.ext; intro xu; apply Subtype.ext
              simp only [Module.End.mul_apply, hφfun, map_mul] }
        have hφ : ∀ (g : H) (xu : W), ((φ g) xu : V) = ρ g (xu : V) := hφfun
        -- `Z` acts trivially, so `φ` descends to the quotient
        have hzker : z ∈ φ.ker := by
          rw [MonoidHom.mem_ker]
          apply LinearMap.ext
          intro xu
          apply Subtype.ext
          rw [hφ z xu, Module.End.one_apply]
          exact (hWmem (xu : V)).mp xu.2
        have hZker : Z ≤ φ.ker := Subgroup.zpowers_le.mpr hzker
        let ρbar : H ⧸ Z →* (W →ₗ[K] W) := QuotientGroup.lift Z φ hZker
        have hHN : IsPGroup p (H ⧸ Z) :=
          hH.of_surjective (QuotientGroup.mk' Z) (QuotientGroup.mk'_surjective Z)
        have hcardZ : Nat.card (H ⧸ Z) * Nat.card Z = n := by
          rw [← hcard]
          exact (Subgroup.card_eq_card_quotient_mul_card_subgroup Z).symm
        have hlt : Nat.card (H ⧸ Z) < n := by
          have hZ2 : 2 ≤ Nat.card Z := hZlt
          have hQpos : 0 < Nat.card (H ⧸ Z) := Nat.card_pos
          calc Nat.card (H ⧸ Z) = Nat.card (H ⧸ Z) * 1 := (Nat.mul_one _).symm
            _ < Nat.card (H ⧸ Z) * 2 := (Nat.mul_lt_mul_left hQpos).mpr (by decide)
            _ ≤ Nat.card (H ⧸ Z) * Nat.card Z := Nat.mul_le_mul_left _ hZ2
            _ = n := hcardZ
        -- induction hypothesis on the smaller `p`-group `H ⧸ Z`
        obtain ⟨w, hwne, hwfix⟩ := ih (Nat.card (H ⧸ Z)) hlt (H ⧸ Z) rfl hHN hWnt ρbar
        refine ⟨(w : V), ?_, ?_⟩
        · intro h0
          exact hwne (Subtype.ext (by simpa using h0))
        · intro g
          have h2 : ((ρbar (g : H ⧸ Z)) w : V) = (w : V) :=
            congrArg Subtype.val (hwfix (g : H ⧸ Z))
          rw [show ρbar (g : H ⧸ Z) = φ g from rfl, hφ g w] at h2
          exact h2
      · -- the trivial `p`-group: every vector is fixed
        haveI : Subsingleton H := not_nontrivial_iff_subsingleton.mp hnt
        obtain ⟨v, hv⟩ := exists_ne (0 : V)
        exact ⟨v, hv, fun g => by rw [Subsingleton.elim g 1, map_one, Module.End.one_apply]⟩
  exact key (Nat.card H) H rfl hH hV ρ

/-- A `p`-group `P` acting `K`-linearly on a nonzero module `V` over a field `K` of characteristic
`p` has a nonzero fixed vector.  (This generalises `exists_ne_zero_fixed_of_isPGroup`, which is
proved by orbit counting over the finite field `ZMod p`, to an arbitrary field of characteristic
`p`; the proof uses a central element `z ≠ 1` of `P`, `(ρ z - 1) ^ (p ^ n) = 0`, and induction on
`|P|` through the quotient `P ⧸ ⟨z⟩`.) -/
theorem exists_ne_zero_fixed_of_isPGroup_field {K : Type u} [Field K] {p : ℕ} [CharP K p]
    [Fact p.Prime] {G : Type v} [Group G] [Finite G] {V : Type w} [AddCommGroup V] [Module K V]
    (ρ : Representation K G V) {P : Subgroup G} (hP : IsPGroup p P) (hV : Nontrivial V) :
    ∃ v : V, v ≠ 0 ∧ ∀ g ∈ P, ρ g v = v := by
  obtain ⟨v, hv, hfix⟩ := exists_ne_zero_fixed_of_isPGroup_self hP (ρ.comp P.subtype) hV
  exact ⟨v, hv, fun g hg => by simpa using hfix ⟨g, hg⟩⟩

end Work.HallHigman
