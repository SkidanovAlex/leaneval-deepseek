/-
Area A10 of the Feit--Thompson (odd order theorem) drive:
modular representations and the Hall--Higman theorem B, odd order form.

This file sets up the basic vocabulary of the area: `π`-numbers, the `π`-core `O_π(G)`,
the subgroups `O_p(G)`, `O_{p'}(G)`, `O_{p',p}(G)`, the subgroup `O^p(G)`, `p`-solvability
and the upper `p`-series.

Conventions (shared with the other areas of the drive):
* `π`-sets are predicates `π : ℕ → Prop`, `IsPiNat π n := ∀ p, p.Prime → p ∣ n → π p`;
* conjugates of subgroups are written `MulAut.conj g • H` (Mathlib's pointwise action);
* everything is universe polymorphic.

Main definitions of this file:
`Work.HallHigman.IsPiNat`, `Work.HallHigman.piCore` (`O_π`), `Work.HallHigman.pCore` (`O_p`),
`Work.HallHigman.opCore` (`O_{p'}`), `Work.HallHigman.oppCore` (`O_{p',p}`),
`Work.HallHigman.opSubgroup` (`O^p`), `Work.HallHigman.IsPSolvable`,
`Work.HallHigman.upperPSeries`.
-/
import Mathlib

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

universe u v w

namespace Work.HallHigman

/-! ### `π`-numbers and `π`-cores -/

/-- A natural number is a `π`-number if all of its prime divisors lie in `π`. -/
def IsPiNat (π : ℕ → Prop) (n : ℕ) : Prop := ∀ p, p.Prime → p ∣ n → π p

variable {π σ : ℕ → Prop} {G : Type*} [Group G] {p : ℕ}

lemma IsPiNat.mono (h : ∀ p, π p → σ p) {n : ℕ} (hn : IsPiNat π n) : IsPiNat σ n :=
  fun p hp hpn => h p (hn p hp hpn)

lemma IsPiNat.of_dvd {m n : ℕ} (h : IsPiNat π n) (hmn : m ∣ n) : IsPiNat π m :=
  fun p hp hpm => h p hp (hpm.trans hmn)

lemma IsPiNat.one : IsPiNat π 1 := fun _ hp h => (hp.not_dvd_one h).elim

lemma IsPiNat.mul {m n : ℕ} (hm : IsPiNat π m) (hn : IsPiNat π n) : IsPiNat π (m * n) :=
  fun p hp hpn => (Nat.Prime.dvd_mul hp).mp hpn |>.elim (hm p hp) (hn p hp)

/-- For a prime `q`, being a `π`-number for `π = {p}` means being equal to `p`. -/
lemma isPiNat_eq_prime_iff {p q : ℕ} (hq : q.Prime) : IsPiNat (· = p) q ↔ q = p := by
  refine ⟨fun h => h q hq dvd_rfl, ?_⟩
  intro h r hr hrd
  rw [← h]
  exact (Nat.prime_dvd_prime_iff_eq hr hq).mp hrd

/-- `O_π(G)`, the largest normal `π`-subgroup of `G`. -/
def piCore (π : ℕ → Prop) (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ IsPiNat π (Nat.card N)}

lemma piCore_normal : (piCore π G).Normal :=
  Subgroup.sSup_normal _ fun _ hN => hN.1

instance : (piCore π G).Normal := piCore_normal

lemma le_piCore {N : Subgroup G} (hN : N.Normal) (h : IsPiNat π (Nat.card N)) :
    N ≤ piCore π G :=
  le_sSup ⟨hN, h⟩

/-- `O_p(G)`, the largest normal `p`-subgroup of `G`. -/
def pCore (p : ℕ) (G : Type*) [Group G] : Subgroup G := piCore (· = p) G

lemma pCore_normal : (pCore p G).Normal := piCore_normal
instance : (pCore p G).Normal := pCore_normal

lemma le_pCore {N : Subgroup G} (hN : N.Normal) (h : IsPiNat (· = p) (Nat.card N)) :
    N ≤ pCore p G := le_piCore hN h

/-- `O_{p'}(G)`, the largest normal subgroup of order prime to `p`. -/
def opCore (p : ℕ) (G : Type*) [Group G] : Subgroup G := piCore (· ≠ p) G

lemma opCore_normal : (opCore p G).Normal := piCore_normal
instance : (opCore p G).Normal := opCore_normal

lemma le_opCore {N : Subgroup G} (hN : N.Normal) (h : IsPiNat (· ≠ p) (Nat.card N)) :
    N ≤ opCore p G := le_piCore hN h

/-- `O_{p',p}(G)`, the preimage in `G` of `O_p(G/O_{p'}(G))`. -/
def oppCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  (pCore p (G ⧸ opCore p G)).comap (QuotientGroup.mk' (opCore p G))

lemma oppCore_normal : (oppCore p G).Normal :=
  piCore_normal.comap _

instance : (oppCore p G).Normal := oppCore_normal

/-- `O^p(G)`, the subgroup generated by the elements of `p`-power order. -/
def opSubgroup (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {x : G | ∃ k : ℕ, x ^ p ^ k = 1}

/-! ### `p`-solvability -/

/-- A group is `p`-solvable if it possesses a normal series whose factors are `p`-groups
or `p'`-groups. -/
def IsPSolvable (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ (n : ℕ) (f : Fin (n + 1) → Subgroup G),
    f ⟨0, Nat.succ_pos n⟩ = ⊥ ∧ f (Fin.last n) = ⊤ ∧ (∀ i, (f i).Normal) ∧
      ∀ i : Fin n,
        ¬ p ∣ ((f i.castSucc).subgroupOf (f i.succ)).index ∨
          ∃ k : ℕ, ((f i.castSucc).subgroupOf (f i.succ)).index = p ^ k

/-- Auxiliary version of the upper `p`-series, carrying the normality proof. -/
def upperPSeriesAux (p : ℕ) (G : Type*) [Group G] : (n : ℕ) → {H : Subgroup G // H.Normal}
  | 0 => ⟨⊥, Subgroup.normal_bot⟩
  | n + 1 =>
      let H := upperPSeriesAux p G n
      haveI : H.1.Normal := H.2
      ⟨(oppCore p (G ⧸ H.1)).comap (QuotientGroup.mk' H.1),
        (oppCore_normal (p := p) (G := G ⧸ H.1)).comap _⟩

/-- The upper `p`-series `1 = G_0 ≤ G_1 ≤ ...` of `G`, defined by
`G_{n+1}/G_n = O_{p',p}(G/G_n)`. -/
def upperPSeries (p : ℕ) (G : Type*) [Group G] (n : ℕ) : Subgroup G :=
  (upperPSeriesAux p G n).1

instance instNormalUpperPSeries (p : ℕ) (G : Type*) [Group G] (n : ℕ) :
    (upperPSeries p G n).Normal :=
  (upperPSeriesAux p G n).2

end Work.HallHigman
