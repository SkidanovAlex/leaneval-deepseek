namespace Work.HallHigman.GLCore

open MulAction Subgroup
open scoped Pointwise

/-- Auxiliary form of `exists_invariant_sylow`: if `φ` is an automorphism of a finite group `Q`
whose order divides the prime `p`, and `p ∤ |Q|`, then for every prime `q` there is a Sylow
`q`-subgroup of `Q` which is `φ`-invariant.

This is the Frattini argument in the form needed: `⟨φ⟩` is a `p`-group acting on the finite set
`Sylow q Q`, whose cardinality divides `|Q|` and hence is not divisible by `p`; the fixed point
count is congruent to that cardinality mod `p`, so a fixed point exists. -/
lemma exists_invariant_sylow_of_mulAut {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (φ : MulAut Q) (hφ : φ ^ p = 1) (hpQ : ¬ p ∣ Nat.card Q) (q : ℕ) [Fact q.Prime] :
    ∃ S : Subgroup Q, IsPGroup q S ∧ Nat.card S = q ^ (Nat.card Q).factorization q ∧
      ∀ s ∈ S, φ s ∈ S := by
  classical
  -- the subgroup generated by `φ` is a `p`-group
  have hP : IsPGroup p (Subgroup.zpowers φ) := by
    have hdiv : Nat.card ↥(Subgroup.zpowers φ) ∣ p := by
      rw [Nat.card_zpowers]
      exact orderOf_dvd_iff_pow_eq_one.mpr hφ
    rcases (Nat.dvd_prime (Fact.out (p := Nat.Prime p))).mp hdiv with h | h
    · exact IsPGroup.of_card (n := 0) (by rw [h]; rfl)
    · exact IsPGroup.of_card (n := 1) (by rw [h, pow_one])
  -- the number of Sylow `q`-subgroups divides `|Q|`, so is prime to `p`
  have hcard : ¬ p ∣ Nat.card (Sylow q Q) := by
    intro hp
    refine hpQ (dvd_trans hp ?_)
    exact dvd_trans (Sylow.card_dvd_index (Sylow.nonempty.some)) (Subgroup.index_dvd_card _)
  -- hence the action on `Sylow q Q` has a fixed point
  obtain ⟨S, hS⟩ := hP.nonempty_fixed_point_of_prime_not_dvd_card (Sylow q Q) hcard
  have hfix : (φ : MulAut Q) • S = S := by
    have h := (MulAction.mem_fixedPoints.mp hS) ⟨φ, Subgroup.mem_zpowers φ⟩
    simpa using h
  have hfix' : (φ : MulAut Q) • (S : Subgroup Q) = (S : Subgroup Q) := by
    have := congrArg (fun T : Sylow q Q => (T : Subgroup Q)) hfix
    simpa [Sylow.pointwise_smul_def] using this
  refine ⟨(S : Subgroup Q), S.isPGroup', Sylow.card_eq_multiplicity S, ?_⟩
  intro s hs
  rw [← hfix', Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
  simpa [MulAut.smul_def] using hs

/-- **L2 of the GL-core design** (Step 3 of the proof of Hall--Higman B, see
`NOTES_LEAD_ft_hallhigman.md` §2.2): a `q`-subgroup of `Q` invariant under an automorphism `X` of
`Q` of order `p` prime to `|Q|`: the Frattini argument gives a Sylow `q`-subgroup of `Q` normalised
by `X` (inside `Q ⊔ zpowers X`, whose Sylow `p`-subgroups are conjugate). -/
lemma exists_invariant_sylow {H : Type*} [Group H] {p : ℕ} [Fact p.Prime] (Q : Subgroup H)
    [Finite Q] (X : H) (hXp : X ^ p = 1) (hnorm : ∀ a ∈ Q, X * a * X⁻¹ ∈ Q)
    (hQp : ¬ p ∣ Nat.card Q) (q : ℕ) [Fact q.Prime] :
    ∃ S : Subgroup H, S ≤ Q ∧ IsPGroup q S ∧ Nat.card S = q ^ (Nat.card Q).factorization q ∧
      ∀ s ∈ S, X * s * X⁻¹ ∈ S := by
  classical
  -- conjugation by `X` maps `Q` into `Q`, and is injective; since `Q` is finite it is bijective
  let f : Q →* Q :=
    { toFun := fun a => ⟨X * (a : H) * X⁻¹, hnorm a a.2⟩
      map_one' := by ext; simp
      map_mul' := fun a b => by ext; simp [mul_assoc] }
  have hf_inj : Function.Injective f := by
    intro a b hab
    have h1 : X * (a : H) * X⁻¹ = X * (b : H) * X⁻¹ := congrArg (fun c : Q => (c : H)) hab
    refine Subtype.ext ?_
    have h2 := congrArg (fun y : H => X⁻¹ * y * X) h1
    group at h2
    exact h2
  have hf_bij : Function.Bijective f := ⟨hf_inj, Finite.surjective_of_injective hf_inj⟩
  let φ : MulAut Q := MulEquiv.ofBijective f hf_bij
  have hcoef : ∀ a : Q, (φ a : H) = X * (a : H) * X⁻¹ := fun a => rfl
  -- `φ` is conjugation by `X`, hence `φ ^ p = 1` since `X ^ p = 1`
  have hiter : ∀ n : ℕ, ∀ a : Q, ((φ ^ n) a : H) = X ^ n * (a : H) * (X ^ n)⁻¹ := by
    intro n
    induction n with
    | zero => intro a; simp
    | succ n ih =>
        intro a
        rw [pow_succ, MulAut.mul_apply, ih, hcoef a]
        group
  have hφp : φ ^ p = 1 := by
    refine MulEquiv.ext (fun a => ?_)
    have h := hiter p a
    rw [hXp] at h
    exact Subtype.ext (by simpa using h)
  obtain ⟨S, hSq, hScard, hSinv⟩ := exists_invariant_sylow_of_mulAut φ hφp hQp q
  refine ⟨S.map Q.subtype, Subgroup.map_subtype_le S, hSq.map Q.subtype, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective Q)]
    exact hScard
  · intro s hs
    obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hs
    refine Subgroup.mem_map.mpr ⟨φ t, hSinv t ht, ?_⟩
    exact hcoef t

end Work.HallHigman.GLCore
