open scoped commutatorElement

/-! ## Auxiliary group-theoretic facts

The proof of `nonabelian_structure` needs four small facts, none of which is in Mathlib:

* `commutator_lt_self_of_isPGroup`: a nontrivial finite `q`-group has proper derived subgroup
  (a finite `q`-group is nilpotent, hence solvable, and a nontrivial solvable group has proper
  commutator subgroup);
* conjugation by a normalizing element is a bijection of the subgroup;
* the derived subgroup of `Q` is invariant under conjugation by a normalizer of `Q`;
* `commutator_zpowers_eq_of_min`: under the minimality hypothesis, `⁅⟨X⟩, Q⁆ = Q`.
-/

/-- Conjugation by `X`, as a monoid homomorphism. -/
private def conjBy {H : Type*} [Group H] (X : H) : H →* H where
  toFun a := X * a * X⁻¹
  map_one' := by simp
  map_mul' a b := by group

@[simp] private lemma conjBy_apply {H : Type*} [Group H] (X a : H) :
    conjBy X a = X * a * X⁻¹ := rfl

/-- A nontrivial finite `q`-group has proper derived subgroup: a finite `q`-group is nilpotent
(hence solvable), and a nontrivial solvable group has `⁅G, G⁆ < G`. -/
lemma commutator_lt_self_of_isPGroup {H : Type*} [Group H] {Q : Subgroup H} [Finite Q]
    {q : ℕ} (hq : q.Prime) (hQq : IsPGroup q Q) (hnab : ¬ IsMulCommutative Q) :
    ⁅Q, Q⁆ < Q := by
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : Nontrivial ↥Q := by
    by_contra hnt
    haveI : Subsingleton ↥Q := not_nontrivial_iff_subsingleton.mp hnt
    exact hnab inferInstance
  haveI : Group.IsNilpotent ↥Q := IsPGroup.isNilpotent hQq
  haveI : Group.IsSolvable ↥Q := inferInstance
  have h := Group.IsSolvable.commutator_lt_top_of_nontrivial ↥Q
  have h2 : (_root_.commutator ↥Q).map Q.subtype < (⊤ : Subgroup ↥Q).map Q.subtype :=
    Subgroup.map_subtype_lt_map_subtype.mpr h
  rw [Subgroup.map_subtype_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype] at h2
  exact h2

/-- If `X ∈ H` normalizes a finite subgroup `Q`, then `h ∈ Q ↔ X h X⁻¹ ∈ Q`: conjugation by `X`
is an injective (hence bijective) self-map of `Q`. -/
private lemma mem_iff_conj_mem {H : Type*} [Group H] {Q : Subgroup H} [Finite Q] (X : H)
    (hnorm : ∀ a ∈ Q, X * a * X⁻¹ ∈ Q) (h : H) : h ∈ Q ↔ X * h * X⁻¹ ∈ Q := by
  refine ⟨hnorm h, fun hh => ?_⟩
  let f : ↥Q → ↥Q := fun a => ⟨X * (a : H) * X⁻¹, hnorm a a.2⟩
  have hinj : Function.Injective f := by
    intro a b hab
    have h1 : X * (a : H) * X⁻¹ = X * (b : H) * X⁻¹ := congrArg Subtype.val hab
    refine Subtype.ext ?_
    have h2 := congrArg (fun y : H => X⁻¹ * y * X) h1
    group at h2
    exact h2
  obtain ⟨a, ha⟩ := Finite.surjective_of_injective hinj (⟨X * h * X⁻¹, hh⟩ : ↥Q)
  have h1 : X * (a : H) * X⁻¹ = X * h * X⁻¹ := congrArg Subtype.val ha
  have h2 : (a : H) = h := by
    have h3 := congrArg (fun y : H => X⁻¹ * y * X) h1
    group at h3
    exact h3
  rw [← h2]
  exact a.2

/-- The derived subgroup of `Q` is invariant under conjugation by any normalizer of `Q`. -/
private lemma commutator_self_conj_le {H : Type*} [Group H] {Q : Subgroup H}
    (X : H) (hnorm : ∀ a ∈ Q, X * a * X⁻¹ ∈ Q) :
    ∀ a ∈ ⁅Q, Q⁆, X * a * X⁻¹ ∈ ⁅Q, Q⁆ := by
  have hmapQ : Q.map (conjBy X) ≤ Q := by
    rw [Subgroup.map_le_iff_le_comap]
    intro a ha
    exact hnorm a ha
  have hR : (⁅Q, Q⁆).map (conjBy X) ≤ ⁅Q, Q⁆ := by
    rw [Subgroup.map_commutator]
    exact Subgroup.commutator_mono hmapQ hmapQ
  intro a ha
  exact hR (Subgroup.mem_map_of_mem (conjBy X) ha)

/-- **L4 of the GL-core design** (Step 3 of the proof of Hall--Higman B, see
`NOTES_LEAD_ft_hallhigman.md` §2.2): under the minimality hypothesis `hmin`, with `Q` a finite
`p'`-group normalised by `X` of order `p` and not commuting with `X`, the subgroup `Q` is
generated by the commutators `⁅X, a⁆`, `a ∈ Q`, i.e. `⁅⟨X⟩, Q⁆ = Q`.

Indeed `R := ⁅⟨X⟩, Q⁆` is `X`-invariant and contained in `Q`; if it were proper, `hmin` would
make every `⁅X, a⁆ ∈ R` commute with `X`, and L1 (`commutator_eq_one_of_commute`) would force
`⁅X, a⁆ = 1`, contradicting `hnc`. -/
lemma commutator_zpowers_eq_of_min {H : Type*} [Group H] {p : ℕ} [Fact p.Prime]
    {Q : Subgroup H} [Finite Q] (X : H) (hXp : X ^ p = 1)
    (hnorm : ∀ a ∈ Q, X * a * X⁻¹ ∈ Q) (hcop : ¬ p ∣ Nat.card Q)
    (hmin : ∀ R : Subgroup H, R < Q → (∀ a ∈ R, X * a * X⁻¹ ∈ R) →
      ∀ a ∈ R, a * X = X * a)
    (hnc : ∃ a ∈ Q, a * X ≠ X * a) :
    ⁅Subgroup.zpowers X, Q⁆ = Q := by
  have hmapQ : Q.map (conjBy X) ≤ Q := by
    rw [Subgroup.map_le_iff_le_comap]
    intro a ha
    exact hnorm a ha
  have hmapZ : (Subgroup.zpowers X).map (conjBy X) ≤ Subgroup.zpowers X := by
    rw [Subgroup.map_le_iff_le_comap]
    intro b hb
    rw [Subgroup.mem_zpowers_iff] at hb
    rw [Subgroup.mem_comap, Subgroup.mem_zpowers_iff]
    obtain ⟨k, rfl⟩ := hb
    exact ⟨k, by rw [conjBy_apply]; group⟩
  have hRQ : ⁅Subgroup.zpowers X, Q⁆ ≤ Q := by
    have hXnorm : X ∈ Subgroup.normalizer (Q : Set H) :=
      Subgroup.mem_normalizer_iff.mpr (mem_iff_conj_mem X hnorm)
    have hzX : Subgroup.zpowers X ≤ Subgroup.normalizer (Q : Set H) :=
      Subgroup.zpowers_le.mpr hXnorm
    rw [Subgroup.commutator_comm]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp hzX
  have hRinv : ∀ a ∈ ⁅Subgroup.zpowers X, Q⁆, X * a * X⁻¹ ∈ ⁅Subgroup.zpowers X, Q⁆ := by
    have hR : (⁅Subgroup.zpowers X, Q⁆).map (conjBy X) ≤ ⁅Subgroup.zpowers X, Q⁆ := by
      rw [Subgroup.map_commutator]
      exact Subgroup.commutator_mono hmapZ hmapQ
    intro a ha
    exact hR (Subgroup.mem_map_of_mem (conjBy X) ha)
  rcases lt_or_eq_of_le hRQ with hlt | heq
  · exfalso
    have hcomm : ∀ a ∈ ⁅Subgroup.zpowers X, Q⁆, a * X = X * a := hmin _ hlt hRinv
    obtain ⟨a, ha, hne⟩ := hnc
    have hmem : X * a * X⁻¹ * a⁻¹ ∈ ⁅Subgroup.zpowers X, Q⁆ := by
      have : X * a * X⁻¹ * a⁻¹ = ⁅X, a⁆ := by rw [commutatorElement_def]
      rw [this]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_zpowers X) ha
    have hccomm : Commute (X * a * X⁻¹ * a⁻¹) X := by
      rw [commute_iff_eq]
      have := hcomm _ hmem
      simpa [commutatorElement_def] using this
    have h1 : X * a * X⁻¹ * a⁻¹ = 1 :=
      commutator_eq_one_of_commute hcop hXp (mul_mem (hnorm a ha) (inv_mem ha)) hccomm
    have h3 : X * a * X⁻¹ = a := by
      have hh : X * a * X⁻¹ = (X * a * X⁻¹ * a⁻¹) * a := by group
      rw [hh, h1, one_mul]
    have h4 : X * a = a * X := by
      have hh : X * a = (X * a * X⁻¹) * X := by group
      rw [hh, h3]
    exact hne h4.symm
  · exact heq

/-- **L5 of the GL-core design** (Step 4b(3)–(5) of the proof of Hall--Higman B, see
`NOTES_LEAD_ft_hallhigman.md` §2.2): under the minimality hypothesis `hmin` (every proper
`X`-invariant subgroup of `Q` commutes with `X`), with `Q` a `q`-group not commuting with `X`:
(a) every element of `Q` commuting with `X` is central in `Q`;
(b) `⁅Q, Q⁆` is central in `Q`;
(c) if `X e X⁻¹ e⁻¹` is central in `Q` then `e` is central in `Q`.

Uses the three-subgroups lemma (`Subgroup.commutator_commutator_eq_bot_of_rotate`), L1
(`commutator_eq_one_of_commute`), and the fact that a nontrivial `q`-group has `⁅Q,Q⁆ < Q`
(via nilpotency of `q`-groups). -/
lemma nonabelian_structure {H : Type*} [Group H] {p : ℕ} [Fact p.Prime] {Q : Subgroup H}
    (X : H) (hXp : X ^ p = 1) (hnorm : ∀ a ∈ Q, X * a * X⁻¹ ∈ Q) (hcop : ¬ p ∣ Nat.card Q)
    (hmin : ∀ R : Subgroup H, R < Q → (∀ a ∈ R, X * a * X⁻¹ ∈ R) → ∀ a ∈ R, a * X = X * a)
    (hnc : ∃ a ∈ Q, a * X ≠ X * a)
    {q : ℕ} (hq : q.Prime) (hQq : IsPGroup q Q) (hnab : ¬ IsMulCommutative Q) :
    (∀ a ∈ Q, a * X = X * a → a ∈ Subgroup.centralizer (Q : Set H)) ∧
    (⁅Q, Q⁆ ≤ Subgroup.centralizer (Q : Set H)) ∧
    (∀ e ∈ Q, X * e * X⁻¹ * e⁻¹ ∈ Subgroup.centralizer (Q : Set H) →
      e ∈ Subgroup.centralizer (Q : Set H)) := by
  -- `Q` is finite, since `p ∤ |Q|`
  have hcard : Nat.card ↥Q ≠ 0 := by
    intro h0
    exact hcop (by rw [h0]; exact dvd_zero p)
  haveI : Finite ↥Q := (Nat.card_ne_zero.mp hcard).2
  -- `D := C_Q(X)`, the elements of `Q` commuting with `X`
  set D : Subgroup H := Q ⊓ Subgroup.centralizer ({X} : Set H) with hDdef
  have hDmem : ∀ x : H, x ∈ D ↔ x ∈ Q ∧ x ∈ Subgroup.centralizer ({X} : Set H) := by
    intro x; rw [hDdef]; exact Subgroup.mem_inf
  have hDleQ : D ≤ Q := fun x hx => ((hDmem x).mp hx).1
  have hDleX : D ≤ Subgroup.centralizer ({X} : Set H) := fun x hx => ((hDmem x).mp hx).2
  -- the derived subgroup of `Q` is proper
  have hQ'lt : ⁅Q, Q⁆ < Q := commutator_lt_self_of_isPGroup hq hQq hnab
  have hQ'inv : ∀ a ∈ ⁅Q, Q⁆, X * a * X⁻¹ ∈ ⁅Q, Q⁆ := commutator_self_conj_le X hnorm
  -- `Q'` is `X`-invariant and proper, so by minimality it is centralized by `X`
  have hQ'le : ⁅Q, Q⁆ ≤ Subgroup.centralizer ({X} : Set H) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff.mp hh]
    exact (hmin ⁅Q, Q⁆ hQ'lt hQ'inv a ha).symm
  have hQ'leD : ⁅Q, Q⁆ ≤ D := by
    intro a ha
    rw [hDmem]
    exact ⟨Subgroup.commutator_le_self Q ha, hQ'le ha⟩
  -- elements of `D` commute with every power of `X`
  have hDcent : D ≤ Subgroup.centralizer (Subgroup.zpowers X : Set H) := by
    intro a ha
    have haX : a ∈ Subgroup.centralizer ({X} : Set H) := hDleX ha
    rw [Subgroup.mem_centralizer_iff] at haX
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    have hb' : b ∈ Subgroup.zpowers X := hb
    rw [Subgroup.mem_zpowers_iff] at hb'
    obtain ⟨k, rfl⟩ := hb'
    have hXa : Commute a X := (commute_iff_eq a X).mpr (haX X (by simp)).symm
    exact (hXa.zpow_right k).eq.symm
  -- `⁅Q, D⁆ ≤ Q' ≤ D`
  have hQD : ⁅Q, D⁆ ≤ D := (Subgroup.commutator_mono le_rfl hDleQ).trans hQ'leD
  -- the three subgroups lemma, with `H₁ = ⟨X⟩`, `H₂ = Q`, `H₃ = D`
  have h1 : ⁅⁅Q, D⁆, Subgroup.zpowers X⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hQD.trans hDcent
  have h2 : ⁅⁅D, Subgroup.zpowers X⁆, Q⁆ = ⊥ := by
    have hDX : ⁅D, Subgroup.zpowers X⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      exact hDcent
    rw [hDX]
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr bot_le
  have h3 : ⁅⁅Subgroup.zpowers X, Q⁆, D⁆ = ⊥ :=
    Subgroup.commutator_commutator_eq_bot_of_rotate h1 h2
  -- `⁅⟨X⟩, Q⁆ = Q`, so `⁅Q, D⁆ = ⊥`, i.e. `D ≤ C(Q)`
  have hL4 : ⁅Subgroup.zpowers X, Q⁆ = Q :=
    commutator_zpowers_eq_of_min X hXp hnorm hcop hmin hnc
  have hQDbot : ⁅Q, D⁆ = ⊥ := by rw [← hL4]; exact h3
  have hDcentQ : D ≤ Subgroup.centralizer (Q : Set H) :=
    Subgroup.le_centralizer_iff.mp (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hQDbot)
  refine ⟨?_, ?_, ?_⟩
  · -- (a) `C_Q(X) ≤ Z(Q)`
    intro a ha haX
    apply hDcentQ
    rw [hDmem]
    refine ⟨ha, ?_⟩
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff.mp hh]
    exact haX.symm
  · -- (b) `⁅Q, Q⁆ ≤ Z(Q)`
    exact hQ'leD.trans hDcentQ
  · -- (c) `X e X⁻¹ e⁻¹ ∈ Z(Q) → e ∈ Z(Q)`
    intro e he hc
    set Z : Subgroup H := Q ⊓ Subgroup.centralizer (Q : Set H) with hZdef
    have hZmem : ∀ x : H, x ∈ Z ↔ x ∈ Q ∧ x ∈ Subgroup.centralizer (Q : Set H) := by
      intro x; rw [hZdef]; exact Subgroup.mem_inf
    have hcQ : X * e * X⁻¹ * e⁻¹ ∈ Q := mul_mem (hnorm e he) (inv_mem he)
    have hcZ : X * e * X⁻¹ * e⁻¹ ∈ Z := (hZmem _).mpr ⟨hcQ, hc⟩
    -- `Z(Q) < Q` because `Q` is not abelian
    have hZlt : Z < Q := by
      obtain ⟨g, h, hgh⟩ : ∃ g h : ↥Q, g * h ≠ h * g := by
        by_contra hcon
        apply hnab
        rw [isMulCommutative_iff]
        intro a b
        by_contra hab
        exact hcon ⟨a, b, hab⟩
      refine lt_of_le_of_ne (fun x hx => ((hZmem x).mp hx).1) ?_
      intro hZQ
      have hgZ : (g : H) ∈ Z := by rw [hZQ]; exact g.2
      have hg2 := (hZmem (g : H)).mp hgZ
      rw [Subgroup.mem_centralizer_iff] at hg2
      exact hgh (Subtype.ext (hg2.2 (h : H) h.2).symm)
    -- `Z(Q)` is `X`-invariant
    have hZinv : ∀ a ∈ Z, X * a * X⁻¹ ∈ Z := by
      intro a ha
      have haQ : a ∈ Q := ((hZmem a).mp ha).1
      have hac : a ∈ Subgroup.centralizer (Q : Set H) := ((hZmem a).mp ha).2
      rw [Subgroup.mem_centralizer_iff] at hac
      apply (hZmem _).mpr
      refine ⟨hnorm a haQ, ?_⟩
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      have hy' : X⁻¹ * y * X ∈ Q := by
        refine (mem_iff_conj_mem X hnorm (X⁻¹ * y * X)).mpr ?_
        rw [show X * (X⁻¹ * y * X) * X⁻¹ = y from by group]
        exact hy
      calc y * (X * a * X⁻¹) = X * (X⁻¹ * y * X) * a * X⁻¹ := by group
        _ = X * ((X⁻¹ * y * X) * a) * X⁻¹ := by group
        _ = X * (a * (X⁻¹ * y * X)) * X⁻¹ := by rw [hac (X⁻¹ * y * X) hy']
        _ = (X * a * X⁻¹) * y := by group
    -- by minimality `Z(Q)` is centralized by `X`, so `X e X⁻¹ e⁻¹` commutes with `X`
    have hZcomm : ∀ a ∈ Z, a * X = X * a := hmin Z hZlt hZinv
    have hcX : Commute (X * e * X⁻¹ * e⁻¹) X :=
      (commute_iff_eq _ _).mpr (hZcomm _ hcZ)
    -- L1 gives `X e X⁻¹ e⁻¹ = 1`, so `e` commutes with `X` and hence lies in `D`
    have hc1 : X * e * X⁻¹ * e⁻¹ = 1 :=
      commutator_eq_one_of_commute hcop hXp hcQ hcX
    apply hDcentQ
    rw [hDmem]
    refine ⟨he, ?_⟩
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff.mp hh]
    have hh2 : X * e * X⁻¹ = e := by
      have : X * e * X⁻¹ = (X * e * X⁻¹ * e⁻¹) * e := by group
      rw [this, hc1, one_mul]
    have hmid : X * e = (X * e * X⁻¹) * X := by group
    rw [hmid, hh2]

end Work.HallHigman.GLCore
