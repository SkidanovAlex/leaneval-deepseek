/-- A finite group `E` with an automorphism `α` of order dividing the prime `p` acting
fixed-point-freely on `E / Z(E)` has `|E/Z(E)| ≡ 1 (mod p)`. -/
lemma dvd_centerQuotient_sub_one {E : Type*} [Group E] [Finite E] {p : ℕ} [Fact p.Prime]
    (α : E ≃* E) (hαp : α ^ p = 1)
    (hfpf : ∀ e, α e * e⁻¹ ∈ Subgroup.center E → e ∈ Subgroup.center E) :
    p ∣ Nat.card (E ⧸ Subgroup.center E) - 1 := by
  classical
  -- The center is characteristic, so `α` descends to an automorphism `αbar` of `E ⧸ Z(E)`.
  have hmap : Subgroup.map (α : E →* E) (Subgroup.center E) = Subgroup.center E :=
    Subgroup.map_center_eq α
  let αbar : E ⧸ Subgroup.center E ≃* E ⧸ Subgroup.center E :=
    QuotientGroup.congr (Subgroup.center E) (Subgroup.center E) α hmap
  have hαbar_apply : ∀ e : E, αbar (QuotientGroup.mk e) = QuotientGroup.mk (α e) :=
    fun e => QuotientGroup.congr_mk _ _ α hmap e
  -- `αbar ^ n` acts on a coset by applying `α ^ n` to a representative.
  have hpow : ∀ n : ℕ, ∀ e : E,
      (αbar ^ n) (QuotientGroup.mk e) = QuotientGroup.mk ((α ^ n) e) := by
    intro n
    induction n with
    | zero => intro e; simp [MulAut.one_apply]
    | succ n ih =>
        intro e
        simp only [pow_succ, MulAut.mul_apply]
        rw [hαbar_apply, ih]
  have hαbar_pow : αbar ^ p = 1 := by
    ext x
    obtain ⟨e, rfl⟩ := QuotientGroup.mk_surjective x
    rw [hpow p e, hαp, MulAut.one_apply, MulAut.one_apply]
  -- The cyclic group generated by `αbar`, acting on the quotient, is a `p`-group.
  let H : Subgroup (MulAut (E ⧸ Subgroup.center E)) := Subgroup.zpowers αbar
  letI : MulAction H (E ⧸ Subgroup.center E) :=
    { smul := fun h x => (h : MulAut (E ⧸ Subgroup.center E)) x
      one_smul := fun x => MulAut.one_apply _ x
      mul_smul := fun a b x => MulAut.mul_apply _ _ _ _ }
  -- Its only fixed point is the identity, by the fixed-point-free hypothesis.
  have hfix : MulAction.fixedPoints H (E ⧸ Subgroup.center E) = {1} := by
    rw [Set.eq_singleton_iff_unique_mem]
    refine ⟨?_, ?_⟩
    · rw [MulAction.mem_fixedPoints]
      intro h
      show (h : MulAut (E ⧸ Subgroup.center E)) 1 = 1
      simp
    · intro x hx
      rw [MulAction.mem_fixedPoints] at hx
      obtain ⟨e, rfl⟩ := QuotientGroup.mk_surjective x
      have hαx : αbar (QuotientGroup.mk e) = QuotientGroup.mk e :=
        hx ⟨αbar, Subgroup.mem_zpowers αbar⟩
      rw [hαbar_apply] at hαx
      have hZ : e⁻¹ * α e ∈ Subgroup.center E := QuotientGroup.eq.mp hαx.symm
      have hZ' : α e * e⁻¹ ∈ Subgroup.center E := by
        have h := Subgroup.Normal.conj_mem (H := Subgroup.center E)
          (inferInstance : (Subgroup.center E).Normal) (e⁻¹ * α e) hZ (α e)
        rwa [show (α e) * (e⁻¹ * α e) * (α e)⁻¹ = α e * e⁻¹ from by group] at h
      exact (QuotientGroup.eq_one_iff e).mpr (hfpf e hZ')
  have hcard : Nat.card (MulAction.fixedPoints H (E ⧸ Subgroup.center E)) = 1 := by
    rw [hfix]
    refine Nat.card_eq_one_iff_unique.mpr ⟨⟨fun a b => ?_⟩, ⟨⟨1, by simp⟩⟩⟩
    exact Subtype.ext ((Set.mem_singleton_iff.mp a.2).trans (Set.mem_singleton_iff.mp b.2).symm)
  have hIsp : IsPGroup p H := by
    have hord : orderOf αbar ∣ p := orderOf_dvd_of_pow_eq_one hαbar_pow
    have hcardH : Nat.card H = 1 ∨ Nat.card H = p := by
      have hz : Nat.card H = orderOf αbar := Nat.card_zpowers αbar
      rw [hz]
      rcases (Fact.out : p.Prime).eq_one_or_self_of_dvd (orderOf αbar) hord with h | h
      · exact Or.inl h
      · exact Or.inr h
    rcases hcardH with h | h
    · exact IsPGroup.of_card (n := 0) (by rw [h, pow_zero])
    · exact IsPGroup.of_card (n := 1) (by rw [h, pow_one])
  -- The `p`-group fixed-point congruence `|α| ≡ |Fix| (mod p)` with `|Fix| = 1`.
  have hmod : Nat.card (E ⧸ Subgroup.center E) ≡
      Nat.card (MulAction.fixedPoints H (E ⧸ Subgroup.center E)) [MOD p] :=
    IsPGroup.card_modEq_card_fixedPoints hIsp _
  rw [hcard] at hmod
  have hpos : 1 ≤ Nat.card (E ⧸ Subgroup.center E) :=
    Nat.card_pos_iff.mpr ⟨⟨1⟩, inferInstance⟩
  exact (Nat.modEq_iff_dvd' hpos).mp hmod.symm

end Work.HallHigman.GLCore
