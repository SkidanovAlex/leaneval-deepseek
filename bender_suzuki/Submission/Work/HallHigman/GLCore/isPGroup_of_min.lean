namespace Work.HallHigman.GLCore

set_option linter.style.haveILetI false

open Subgroup

/-- **Auxiliary form of L3 of the GL-core design** (Step 3 of the proof of Hall--Higman B, see
`NOTES_LEAD_ft_hallhigman.md` §2.2), stated for a group `Q` equipped with an automorphism `φ`.

If `φ` is an automorphism of a finite group `Q` of order dividing the prime `p` with `p ∤ |Q|`,
if every proper `φ`-invariant subgroup of `Q` is fixed pointwise by `φ`, and if `φ` is not the
identity, then `Q` is a `q`-group for some prime `q`.

The proof is the Frattini argument plus the minimality hypothesis: for every prime `q` dividing
`|Q|` there is a `φ`-invariant Sylow `q`-subgroup `S_q`; if `Q` were not a `q`-group every `S_q`
would be proper, hence fixed pointwise, so the subgroup generated by the `S_q` (which is all of
`Q`) would lie in the fixed-point subgroup of `φ`, contradicting `φ ≠ 1`.  That the `S_q` do
generate `Q` is seen from the index: if `L = ⟨S_q⟩` had index `≠ 1`, a prime `r` would divide
both `L.index` and `Nat.card Q`, whence `r ∣ (S_r).index`, contradicting that `S_r` is a Sylow
`r`-subgroup. -/
lemma isPGroup_of_min_aut {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (φ : MulAut Q) (hφ : φ ^ p = 1) (hcop : ¬ p ∣ Nat.card Q)
    (hmin : ∀ R : Subgroup Q, R < ⊤ → (∀ a ∈ R, φ a ∈ R) → ∀ a ∈ R, φ a = a)
    (hnc : φ ≠ 1) : ∃ q, q.Prime ∧ IsPGroup q Q := by
  classical
  by_contra hcon
  have hnot : ∀ q, Nat.Prime q → ¬ IsPGroup q Q := by
    intro q hq hqg
    exact hcon ⟨q, hq, hqg⟩
  -- the fixed-point subgroup of `φ`
  let F : Subgroup Q :=
    { carrier := {x | φ x = x}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq] at *
        rw [map_mul, ha, hb]
      inv_mem' := by
        intro a ha
        simp only [Set.mem_ofPred_eq] at *
        rw [map_inv, ha] }
  -- for each prime `q` dividing `|Q|`, a `φ`-invariant Sylow `q`-subgroup, which is proper and
  -- hence fixed pointwise
  have hS : ∀ q : (Nat.card Q).primeFactors, ∃ S : Subgroup Q,
      IsPGroup q.1 S ∧ Nat.card S = q.1 ^ (Nat.card Q).factorization q.1 ∧
      (∀ s ∈ S, φ s ∈ S) ∧ S < ⊤ ∧ S ≤ F := by
    intro q
    haveI : Fact (Nat.Prime q.1) := ⟨Nat.prime_of_mem_primeFactors q.2⟩
    obtain ⟨S, hSq, hScard, hSinv⟩ := exists_invariant_sylow_of_mulAut φ hφ hcop q.1
    have hSlt : S < ⊤ := by
      rw [lt_top_iff_ne_top]
      intro htop
      exact hnot q.1 (Nat.prime_of_mem_primeFactors q.2)
        (hSq.of_equiv (htop.symm ▸ Subgroup.topEquiv))
    have hSF : S ≤ F := fun s hs => hmin S hSlt hSinv s hs
    exact ⟨S, hSq, hScard, hSinv, hSlt, hSF⟩
  choose S hS using hS
  -- the subgroup generated by the invariant Sylow subgroups is all of `Q`
  let L : Subgroup Q := ⨆ q : (Nat.card Q).primeFactors, S q
  have hLF : L ≤ F := iSup_le (fun q => (hS q).2.2.2.2)
  have hLtop : L = ⊤ := by
    rw [← Subgroup.index_eq_one]
    by_contra hne
    obtain ⟨r, hrprime, hrdvd⟩ := Nat.exists_prime_and_dvd hne
    have hrmem : r ∈ (Nat.card Q).primeFactors := by
      rw [Nat.mem_primeFactors]
      exact ⟨hrprime, hrdvd.trans (Subgroup.index_dvd_card L), (Nat.card_pos (α := Q)).ne'⟩
    let q0 : (Nat.card Q).primeFactors := ⟨r, hrmem⟩
    haveI : Fact (Nat.Prime q0.1) := ⟨Nat.prime_of_mem_primeFactors q0.2⟩
    have hdiv : L.index ∣ (S q0).index :=
      Subgroup.index_dvd_of_le (le_iSup (fun q : (Nat.card Q).primeFactors => S q) q0)
    have hrdvd2 : q0.1 ∣ (S q0).index := hrdvd.trans hdiv
    have hcard : Nat.card ↥(S q0) = q0.1 ^ (Nat.card Q).factorization q0.1 := (hS q0).2.1
    exact absurd hrdvd2 (Sylow.not_dvd_index (Sylow.ofCard (S q0) hcard))
  have hFtop : F = ⊤ := top_le_iff.mp (hLtop ▸ hLF)
  -- hence `φ` fixes everything, i.e. is the identity
  apply hnc
  apply MulEquiv.ext
  intro x
  have hx : x ∈ F := by rw [hFtop]; exact Subgroup.mem_top x
  exact hx

/-- **L3 of the GL-core design** (Step 3 of the proof of Hall--Higman B, see `NOTES_LEAD_ft_hallhigman.md` §2.2): under the minimality hypothesis `hmin` (every proper `X`-invariant subgroup of `Q` is centralized elementwise by `X`), with `Q` a finite subgroup on which `X` of order `p` acts by conjugation (`hnorm`), `p ∤ |Q|` and `X` not commuting with `Q`, the group `Q` is a `q`-group for some prime `q`. -/
lemma isPGroup_of_min {H : Type*} [Group H] {p : ℕ} [Fact p.Prime] {Q : Subgroup H}
    [Finite Q] (X : H) (hXp : X ^ p = 1) (hnorm : ∀ a ∈ Q, X * a * X⁻¹ ∈ Q)
    (hcop : ¬ p ∣ Nat.card Q)
    (hmin : ∀ R : Subgroup H, R < Q → (∀ a ∈ R, X * a * X⁻¹ ∈ R) → ∀ a ∈ R, a * X = X * a)
    (hnc : ∃ a ∈ Q, a * X ≠ X * a) : ∃ q, q.Prime ∧ IsPGroup q Q := by
  classical
  -- conjugation by `X` as an automorphism of `Q` (it is a bijection by finiteness)
  let f : Q →* Q :=
    { toFun := fun a => ⟨X * (a : H) * X⁻¹, hnorm a a.2⟩
      map_one' := by ext; simp
      map_mul' := fun a b => by ext; simp [mul_assoc] }
  have hf_inj : Function.Injective f := by
    intro a b hab
    have h1 : X * (a : H) * X⁻¹ = X * (b : H) * X⁻¹ := congrArg (fun c : Q => (c : H)) hab
    refine Subtype.ext ?_
    have h2 := congrArg (fun y : H => X⁻¹ * y * X) h1
    group at h2
    exact h2
  let φ : MulAut Q := MulEquiv.ofBijective f ⟨hf_inj, Finite.surjective_of_injective hf_inj⟩
  have hφcoe : ∀ a : Q, ((φ a : Q) : H) = X * (a : H) * X⁻¹ := fun a => rfl
  have hiter : ∀ n : ℕ, ∀ a : Q, ((φ ^ n) a : H) = X ^ n * (a : H) * (X ^ n)⁻¹ := by
    intro n
    induction n with
    | zero => intro a; simp
    | succ n ih =>
        intro a
        rw [pow_succ, MulAut.mul_apply, ih, hφcoe a]
        group
  have hφp : φ ^ p = 1 := by
    refine MulEquiv.ext (fun a => ?_)
    have h := hiter p a
    rw [hXp] at h
    exact Subtype.ext (by simpa using h)
  -- the minimality hypothesis transfers to the automorphism `φ`
  have hmin' : ∀ R : Subgroup Q, R < ⊤ → (∀ a ∈ R, φ a ∈ R) → ∀ a ∈ R, φ a = a := by
    intro R hRlt hRinv a ha
    have hR'lt : R.map Q.subtype < Q := by
      refine lt_of_le_of_ne (Subgroup.map_subtype_le R) ?_
      intro hQeq
      have hmap : Subgroup.map Q.subtype R = Subgroup.map Q.subtype ⊤ := by
        rw [Subgroup.map_top, Subgroup.range_subtype]
        exact hQeq
      exact absurd (Subgroup.map_injective (Subgroup.subtype_injective Q) hmap) hRlt.ne
    have hXRinv : ∀ b ∈ R.map Q.subtype, X * b * X⁻¹ ∈ R.map Q.subtype := by
      intro b hb
      obtain ⟨r, hr, rfl⟩ := Subgroup.mem_map.mp hb
      exact Subgroup.mem_map.mpr ⟨φ r, hRinv r hr, hφcoe r⟩
    have hmem : (a : H) ∈ R.map Q.subtype := Subgroup.mem_map.mpr ⟨a, ha, rfl⟩
    have hcomm := hmin (R.map Q.subtype) hR'lt hXRinv (a : H) hmem
    apply Subtype.ext
    rw [hφcoe]
    rw [← hcomm]
    group
  -- `φ ≠ 1` because `X` does not commute with `Q`
  have hnc' : φ ≠ 1 := by
    intro h1
    obtain ⟨a, ha, hne⟩ := hnc
    apply hne
    have hae : φ ⟨a, ha⟩ = ⟨a, ha⟩ := by rw [h1]; rfl
    have h2 : X * a * X⁻¹ = a := by
      have := congrArg (fun c : Q => (c : H)) hae
      rwa [hφcoe, Subgroup.coe_mk] at this
    calc a * X = (X * a * X⁻¹) * X := by rw [h2]
      _ = X * a := by group
  exact isPGroup_of_min_aut φ hφp hcop hmin' hnc'

end Work.HallHigman.GLCore
