/-
Area A10 of the Feit--Thompson (odd order theorem) drive:
Feit--Thompson, *Solvability of groups of odd order*, Chapter II, **Lemma 7.1**:

  "If `H` is a `p`-solvable linear group of odd order over a field of characteristic `p`, then
  `O_p(H)` contains every element whose minimal polynomial is `(x - I) ^ 2`."

(The 1963 text's OCR is ambiguous between `O_p` and `O^p`; the `p`-core reading is the one used by
the paper's own proof and the only one in which the lemma is non-trivial — see the note at
`FTLemma71` below.)

This is the first of the two "Hall--Higman type" results that the local analysis of the odd order
theorem uses (the second is Lemma 7.2, see `Work.HallHigman.FT72`).

This file
* defines the subgroup `O^p(H)` (in `Work.HallHigman.Basic`) and proves its basic API
  (`opSubgroup_normal`, `mem_opSubgroup_of_pow_eq_one`, `opSubgroup_le_of_not_dvd_index`) — this is
  used by Feit--Thompson §7 in the form "`O^p(H mod 𝔛)`", and is exposed here for downstream use;
* records the statement as a named proposition `FTLemma71`;
* proves the two "engine room" facts of its proof that come from Hall--Higman Theorem B:
  if `x` has minimal polynomial `(X - 1) ^ 2` on a faithful module of characteristic `p ≠ 2`, then
  `O_p(H) ≠ 1` (`pCore_ne_bot_of_minpoly_sq`), and the fixed space of `O_p(H)` is then a nonzero
  (`fixedBy_pCore_ne_bot`) proper (`fixedBy_pCore_ne_top`) `x`-invariant subspace.  These are the
  inputs of the induction on `dim V` that constitutes the paper's proof.
-/
import Mathlib
import Submission.Work.HallHigman.Basic
import Submission.Work.HallHigman.HallHigmanB
import Submission.Work.HallHigman.ModRep
import Submission.Work.HallHigman.orderOf_eq_prime_pow_of_sq_sub_one_eq_zero

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

universe u v

namespace Work.HallHigman

open Polynomial

set_option linter.unusedSectionVars false

/-! ### The subgroup `O^p(G)` -/

section OpSubgroup

variable {p : ℕ} {G : Type*} [Group G]

/-- The set of elements of `p`-power order is closed under conjugation. -/
lemma conj_mem_pow_eq_one {g x : G} {k : ℕ} (h : x ^ p ^ k = 1) :
    (g * x * g⁻¹) ^ p ^ k = 1 := by
  rw [show g * x * g⁻¹ = MulAut.conj g x from rfl, ← map_pow, h, map_one]

/-- `O^p(G)`, the subgroup generated by the elements of `p`-power order, is normal. -/
theorem opSubgroup_normal : (opSubgroup p G).Normal where
  conj_mem := by
    intro x hx g
    refine Subgroup.closure_induction (fun y hy => Subgroup.subset_closure ?_) (by simp)
      (fun y z _ _ hy hz => by simpa [mul_assoc] using mul_mem hy hz)
      (fun y _ hy => by simpa [mul_assoc] using inv_mem hy) hx
    obtain ⟨k, hk⟩ := hy
    exact ⟨k, conj_mem_pow_eq_one hk⟩

instance : (opSubgroup p G).Normal := opSubgroup_normal

/-- Elements of `p`-power order lie in `O^p(G)`. -/
theorem mem_opSubgroup_of_pow_eq_one {x : G} {k : ℕ} (h : x ^ p ^ k = 1) :
    x ∈ opSubgroup p G :=
  Subgroup.subset_closure ⟨k, h⟩

/-- The universal property of `O^p(G)`: it is the smallest normal subgroup whose quotient is a
`p'`-group. -/
theorem opSubgroup_le_of_not_dvd_index {N : Subgroup G} (hp : p.Prime) (hN : N.Normal)
    (h : ¬ p ∣ N.index) : opSubgroup p G ≤ N := by
  rw [opSubgroup, Subgroup.closure_le]
  rintro x ⟨k, hk⟩
  refine (QuotientGroup.eq_one_iff (N := N) x).mp ?_
  rw [← orderOf_eq_one_iff]
  have hdvd1 : orderOf (QuotientGroup.mk' N x) ∣ N.index := by
    rw [Subgroup.index_eq_card]
    exact orderOf_dvd_natCard _
  have hdvd2 : orderOf (QuotientGroup.mk' N x) ∣ p ^ k := by
    rw [orderOf_dvd_iff_pow_eq_one, ← map_pow, hk, map_one]
  have hcop : Nat.Coprime (p ^ k) N.index :=
    ((Nat.Prime.coprime_iff_not_dvd hp).mpr h).pow_left k
  have hone : orderOf (QuotientGroup.mk' N x) = 1 := by
    have hd : orderOf (QuotientGroup.mk' N x) ∣ 1 := by
      have hgd := Nat.dvd_gcd hdvd2 hdvd1
      rwa [hcop.gcd_eq_one] at hgd
    exact Nat.dvd_one.mp hd
  exact hone

end OpSubgroup

/-! ### The statement of Lemma 7.1 -/

/-- **Feit--Thompson, Lemma 7.1** (Chapter II, p. 791).  If `H` is a `p`-solvable linear group of
odd order over a field `K` of characteristic `p`, then the **`p`-core** `O_p(H)` contains every
element whose minimal polynomial on the space is `(X - 1) ^ 2`.

Note: the 1963 text's `O_p`/`O^p` are typeset ambiguously in the OCR of `ft1963/ch2.txt`; the
reading as the `p`-core is forced by the paper's own proof, which uses that "`O_p(H)` is a
`p`-group" to produce a nonzero fixed space and then argues by induction on `dim V` with
`O_p(H mod 𝔛_i)` (the `p`-core of the quotients), and it is also the reading in which the lemma is
non-trivial: with `O^p(H)` (the subgroup generated by the `p`-elements) the statement would be
immediate, since an element with minimal polynomial `(X - 1) ^ 2` already has `p`-power order
(`orderOf_eq_prime_pow_of_minpoly_eq_sq`, proved below without any group theoretic hypothesis). -/
def FTLemma71 (K : Type u) [Field K] (p : ℕ) [CharP K p] : Prop :=
  ∀ (H : Type v) [Group H] [Finite H], IsPSolvable p H → Odd (Nat.card H) →
    ∀ (V : FDRep K H), Function.Injective V.ρ → ∀ x : H,
      minpoly K (V.ρ x) = (X - 1) ^ 2 → x ∈ pCore p H

/-! ### The engine room of the proof (from Hall--Higman Theorem B) -/

section Engine

variable {p : ℕ} [Fact p.Prime] {H V : Type u} [Group H] [Finite H] [AddCommGroup V]
  [Module (ZMod p) V]

/-- An element whose minimal polynomial is `(X - 1) ^ 2` has `p`-power order (for a faithful
representation in characteristic `p`): the hypothesis of FT Lemma 7.1 is thus of the shape required
by Hall--Higman Theorem B. -/
theorem orderOf_eq_prime_pow_of_minpoly_eq_sq {G V : Type*} [Group G] [Finite G]
    [AddCommGroup V] [Module (ZMod p) V] (ρ : Representation (ZMod p) G V)
    (hfaith : Function.Injective ρ) {x : G}
    (h : minpoly (ZMod p) (ρ x) = (X - 1) ^ 2) : ∃ n : ℕ, orderOf x = p ^ n := by
  refine orderOf_eq_prime_pow_of_sq_sub_one_eq_zero ρ hfaith ?_
  have hzero : (aeval (ρ x)) (minpoly (ZMod p) (ρ x)) = 0 := minpoly.aeval _ _
  rw [h, map_pow, map_sub, map_one, aeval_X] at hzero
  exact hzero

/-- **Step 1 of the proof of Lemma 7.1** (from Hall--Higman Theorem B):  if an element `x` of
`p`-power order `p ^ n`, `n > 0`, has minimal polynomial `(X - 1) ^ 2` on a faithful module in
characteristic `p ≠ 2`, then `O_p(H) ≠ 1`. -/
theorem pCore_ne_bot_of_minpoly_sq (hB : HallHigmanB.{0, u} (ZMod p) p) (hp : p ≠ 2)
    (hsol : IsPSolvable p H) (hodd : Odd (Nat.card H)) (W : FDRep (ZMod p) H)
    (hfaith : Function.Injective W.ρ) {x : H} {n : ℕ} (hn : 0 < n) (hx : orderOf x = p ^ n)
    (hmin : minpoly (ZMod p) (W.ρ x) = (X - 1) ^ 2) : pCore p H ≠ ⊥ := by
  intro hbot
  exact minpoly_ne_sq_of_minpoly_eq_pow (K := ZMod p) hn hp
    (hB H hsol hodd W hfaith hbot x n hx) hmin

/-- **Step 2 of the proof of Lemma 7.1**:  the fixed space of `O_p(H)` is nonzero. -/
theorem fixedBy_pCore_ne_bot [Finite V] (ρ : Representation (ZMod p) H V) (hV : Nontrivial V) :
    fixedBy ρ (pCore p H) ≠ ⊥ := by
  intro hbot
  obtain ⟨w, hw, hfix⟩ := exists_ne_zero_fixed_of_isPGroup ρ isPGroup_pCore hV
  have hmem : w ∈ fixedBy ρ (pCore p H) := (mem_fixedBy_iff ρ (pCore p H) w).mpr hfix
  rw [hbot] at hmem
  exact hw (by simpa using hmem)

/-- **Step 3 of the proof of Lemma 7.1**:  the fixed space of `O_p(H)` is proper, because `H` acts
faithfully and `O_p(H) ≠ 1`. -/
theorem fixedBy_pCore_ne_top (ρ : Representation (ZMod p) H V) (hfaith : Function.Injective ρ)
    (hP : pCore p H ≠ ⊥) : fixedBy ρ (pCore p H) ≠ ⊤ := by
  intro htop
  have hle : pCore p H ≤ repKernel ρ := by
    intro g hg
    rw [mem_repKernel_iff]
    intro v
    have : v ∈ fixedBy ρ (pCore p H) := by rw [htop]; trivial
    exact (mem_fixedBy_iff ρ (pCore p H) v).mp this g hg
  have hbot : pCore p H ≤ ⊥ := by
    rw [← (repKernel_eq_bot_iff ρ).mpr hfaith]
    exact hle
  exact hP (le_bot_iff.mp hbot)

end Engine

/-! ### The final step of the proof of Lemma 7.1 -/

section FinalStep

variable {p : ℕ} [Fact p.Prime] {H V : Type u} [Group H] [Finite H]
  [AddCommGroup V] [Module (ZMod p) V]

/-- **The final step of the proof of Feit--Thompson's Lemma 7.1.**  If `P ≤ H` preserves a subspace
`Z ≤ V` and every `y ∈ P` has *some* `p`-power acting trivially on `Z` and *some* `p`-power acting
trivially on `V ⧸ Z`, then `P` is a `p`-group.

In the paper the subgroup `P` is `P₀ ∩ P₁`, where `Pᵢ` is the preimage in `H` of `O_p(H/Hᵢ)`, `H₀`
is the kernel of the action on the fixed space `Z` of `O_p(H)` and `H₁` the kernel of the action on
`V ⧸ Z`; the induction hypothesis applied to the two smaller modules gives the hypotheses of the
lemma, and the conclusion "`P₀ ∩ P₁` is a normal `p`-subgroup of `H`" then gives `x ∈ O_p(H)` for
every `x ∈ P₀ ∩ P₁`. -/
theorem isPGroup_of_forall_pow_trivial (ρ : Representation (ZMod p) H V)
    (hfaith : Function.Injective ρ) {Z : Submodule (ZMod p) V} {P : Subgroup H}
    (hZinv : ∀ y ∈ P, ∀ v ∈ Z, ρ y v ∈ Z)
    (hZ : ∀ y ∈ P, ∃ k : ℕ, ∀ v ∈ Z, ρ (y ^ p ^ k) v = v)
    (hQ : ∀ y ∈ P, ∃ k : ℕ, ∀ v : V, ρ (y ^ p ^ k) v - v ∈ Z) :
    IsPGroup p P := by
  rw [IsPGroup.iff_orderOf]
  intro y
  obtain ⟨kZ, hkZ⟩ := hZ y y.2
  obtain ⟨kQ, hkQ⟩ := hQ y y.2
  -- the two triviality properties are preserved when passing to powers
  have hpowZ : ∀ (g : P) (m : ℕ), (∀ v ∈ Z, ρ (g : H) v = v) →
      ∀ v ∈ Z, ρ ((g : H) ^ m) v = v := by
    intro g m
    induction m with
    | zero => intro _ v _; simp
    | succ j ih =>
      intro hg v hv
      rw [pow_succ', map_mul, Module.End.mul_apply, ih hg v hv]
      exact hg v hv
  have hpowQ : ∀ (g : P) (m : ℕ), (∀ v : V, ρ (g : H) v - v ∈ Z) →
      ∀ v : V, ρ ((g : H) ^ m) v - v ∈ Z := by
    intro g m
    induction m with
    | zero => intro _ v; simp
    | succ j ih =>
      intro hg v
      have h1 : ρ (g : H) (ρ ((g : H) ^ j) v) - ρ (g : H) v ∈ Z := by
        have := hZinv g g.2 (ρ ((g : H) ^ j) v - v) (ih hg v)
        simpa [map_sub] using this
      have h2 : ρ (g : H) v - v ∈ Z := hg v
      have hsum := Z.add_mem h1 h2
      rw [pow_succ', map_mul, Module.End.mul_apply]
      convert hsum using 1
      abel
  -- take the maximal exponent
  obtain ⟨k, hk⟩ : ∃ k, kZ ≤ k ∧ kQ ≤ k := ⟨max kZ kQ, le_max_left _ _, le_max_right _ _⟩
  have hgf : (y : H) ^ p ^ k = ((y : H) ^ p ^ kZ) ^ p ^ (k - kZ) := by
    rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hk.1]
  have hgq : (y : H) ^ p ^ k = ((y : H) ^ p ^ kQ) ^ p ^ (k - kQ) := by
    rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hk.2]
  have hZtriv : ∀ v ∈ Z, ρ ((y : H) ^ p ^ k) v = v := by
    intro v hv
    rw [hgf]
    exact hpowZ ⟨(y : H) ^ p ^ kZ, P.pow_mem y.2 _⟩ (p ^ (k - kZ))
      (fun w hw => hkZ w hw) v hv
  have hQtriv : ∀ v : V, ρ ((y : H) ^ p ^ k) v - v ∈ Z := by
    intro v
    rw [hgq]
    exact hpowQ ⟨(y : H) ^ p ^ kQ, P.pow_mem y.2 _⟩ (p ^ (k - kQ)) (fun w => hkQ w) v
  -- such an element is unipotent of index two on `V`, hence has `p`-power order
  have hunip : ((ρ.comp P.subtype) ⟨(y : H) ^ p ^ k, P.pow_mem y.2 _⟩ - 1) ^ 2 = 0 := by
    rw [pow_two]
    change ((ρ ((y : H) ^ p ^ k) - 1) * (ρ ((y : H) ^ p ^ k) - 1)) = 0
    refine LinearMap.ext fun v => ?_
    have h1 : ρ ((y : H) ^ p ^ k) v - v ∈ Z := hQtriv v
    have h2 : ρ ((y : H) ^ p ^ k) (ρ ((y : H) ^ p ^ k) v - v)
        = ρ ((y : H) ^ p ^ k) v - v := hZtriv _ h1
    simp only [Module.End.mul_apply, LinearMap.sub_apply, Module.End.one_apply, LinearMap.zero_apply]
    rw [h2, sub_self]
  have hfaith' : Function.Injective (ρ.comp P.subtype) :=
    fun a b hab => Subtype.coe_injective (hfaith hab)
  obtain ⟨n, hn⟩ := orderOf_eq_prime_pow_of_sq_sub_one_eq_zero (ρ.comp P.subtype) hfaith' hunip
  -- conclude that `orderOf y` itself is a prime power
  have hge : (⟨(y : H) ^ p ^ k, P.pow_mem y.2 _⟩ : P) = y ^ p ^ k := rfl
  rw [hge, orderOf_pow] at hn
  obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Fact.out).mp (Nat.gcd_dvd_right (orderOf y) (p ^ k))
  refine ⟨n + j, ?_⟩
  have hdiv := Nat.div_mul_cancel (Nat.gcd_dvd_left (orderOf y) (p ^ k))
  rw [hn, hj] at hdiv
  rw [← hdiv, pow_add]

end FinalStep

end Work.HallHigman
