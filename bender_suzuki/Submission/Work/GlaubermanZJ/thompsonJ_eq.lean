import Mathlib
import Submission.Work.GlaubermanZJ.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# The bridge `Blueprint.thompsonJ = Work.PGroup.thompsonJ`

`Submission.Blueprint.thompsonJ P` is the supremum of the abelian subgroups of `P` of maximal
order, written as a `⨆` over the family of such subgroups; `Work.PGroup.thompsonJ P` is the
closure of the union of the abelian subgroups `A ≤ P` with `Nat.card A = maxAbelianOrder P`.
The two encode the same subgroup: "the subgroup generated by the abelian subgroups of `P` of
maximal order".

The only content is that the two descriptions of "abelian subgroup of `P` of maximal order"
agree:
* `Submission.Blueprint.IsAbelianSubgroup A` is the elementwise form of `IsMulCommutative A`;
* by definition `Work.PGroup.maxAbelianOrder P` is the supremum of the orders of the abelian
  subgroups of `P`; for finite `P` this supremum is attained, and an abelian `A ≤ P` dominating
  the order of every abelian `B ≤ P` computes it (and conversely an abelian `A ≤ P` of order
  `maxAbelianOrder P` dominates every abelian `B ≤ P`).

Finally `⨆` of a family of subgroups is the closure of their union, so the blueprint's `⨆` and
the delivered `Subgroup.closure` of the same family coincide.
-/

set_option autoImplicit false

namespace Work.GlaubermanZJ

/-- The blueprint's elementwise form of "abelian" is Mathlib's `IsMulCommutative` for the
subtype. -/
theorem isAbelianSubgroup_iff_isMulCommutative {G : Type*} [Group G] (A : Subgroup G) :
    Submission.Blueprint.IsAbelianSubgroup A ↔ IsMulCommutative A := by
  constructor
  · intro h
    exact isMulCommutative_iff.mpr fun a b => Subtype.ext (h a.1 a.2 b.1 b.2)
  · intro h x hx y hy
    exact congrArg Subtype.val (isMulCommutative_iff.mp h ⟨x, hx⟩ ⟨y, hy⟩)

/-- A subgroup satisfying the blueprint's "abelian of maximal order in `P`" conditions is
contained in the blueprint's `thompsonJ P`. -/
theorem le_blueprint_thompsonJ {G : Type*} [Group G] {P A : Subgroup G} (hA : A ≤ P)
    (hab : Submission.Blueprint.IsAbelianSubgroup A)
    (hmax : ∀ B : Subgroup G, B ≤ P → Submission.Blueprint.IsAbelianSubgroup B →
      Nat.card B ≤ Nat.card A) :
    A ≤ Submission.Blueprint.thompsonJ P := by
  intro x hx
  unfold Submission.Blueprint.thompsonJ
  exact le_iSup (f := fun A : Subgroup G => ⨆ (_ : A ≤ P ∧
      Submission.Blueprint.IsAbelianSubgroup A ∧ ∀ B : Subgroup G, B ≤ P →
        Submission.Blueprint.IsAbelianSubgroup B → Nat.card B ≤ Nat.card A), A) A
    (le_iSup (f := fun _ : A ≤ P ∧ Submission.Blueprint.IsAbelianSubgroup A ∧
      ∀ B : Subgroup G, B ≤ P → Submission.Blueprint.IsAbelianSubgroup B →
        Nat.card B ≤ Nat.card A => A) ⟨hA, hab, hmax⟩ hx)

theorem thompsonJ_eq {G : Type*} [Group G] (P : Subgroup G) [Finite P] :
    Submission.Blueprint.thompsonJ P = Work.PGroup.thompsonJ P := by
  apply le_antisymm
  · -- each term of the blueprint's supremum is one of the delivered generators
    unfold Submission.Blueprint.thompsonJ
    refine iSup_le fun A => iSup_le fun hA => ?_
    have hcom : IsMulCommutative A :=
      (isAbelianSubgroup_iff_isMulCommutative A).mp hA.2.1
    have hcard : Nat.card A = Work.PGroup.maxAbelianOrder P := by
      refine le_antisymm ?_ ?_
      · rw [Work.PGroup.maxAbelianOrder]
        refine le_csSup ?_ ⟨A, hA.1, hcom, rfl⟩
        exact ⟨Nat.card P, fun n hn => by
          obtain ⟨B, hB, -, rfl⟩ := hn
          exact Subgroup.card_le_of_le hB⟩
      · rw [Work.PGroup.maxAbelianOrder]
        refine csSup_le ?_ ?_
        · exact ⟨1, ⊥, bot_le, IsMulCommutative.of_comm (fun _ _ => Subsingleton.elim _ _),
            Subgroup.card_bot⟩
        · rintro n ⟨B, hB, hBcom, rfl⟩
          exact hA.2.2 B hB ((isAbelianSubgroup_iff_isMulCommutative B).mpr hBcom)
    exact Work.PGroup.le_thompsonJ hA.1 hcom hcard
  · -- conversely each generator of the delivered `thompsonJ` is abelian of maximal order
    unfold Work.PGroup.thompsonJ
    rw [Subgroup.closure_le]
    rintro x ⟨A, hA, hcom, hcard, hx⟩
    refine le_blueprint_thompsonJ hA ((isAbelianSubgroup_iff_isMulCommutative A).mpr hcom) ?_ hx
    intro B hB hBab
    rw [hcard, Work.PGroup.maxAbelianOrder]
    refine le_csSup ?_ ⟨B, hB, (isAbelianSubgroup_iff_isMulCommutative B).mp hBab, rfl⟩
    exact ⟨Nat.card P, fun n hn => by
      obtain ⟨C, hC, -, rfl⟩ := hn
      exact Subgroup.card_le_of_le hC⟩

end Work.GlaubermanZJ
