namespace Work.GlaubermanZJ

/-!
# Glauberman 1968, Lemma 3.5 (b)

If `J(S) ≤ P ≤ S` for a finite subgroup `S` of a group `G`, then the Thompson subgroups
`J(S)` and `J(P)` coincide.

The proof is short and does not use that `S` is a `p`-group or that `p` is odd, only the
definition of Thompson's subgroup as the subgroup generated by the abelian subgroups of maximal
order.

* `maxAbelianOrder` is monotone in the subgroup, so `maxAbelianOrder P ≤ maxAbelianOrder S`
  because `P ≤ S`.
* Conversely, `maxAbelianOrder S` is attained by some abelian `A ≤ S`
  (`Work.PGroup.maxAbelianOrder_attained`); that `A` is contained in `J(S) ≤ P`, hence is an
  abelian subgroup of `P` and `maxAbelianOrder S ≤ maxAbelianOrder P`.

So `d(P) = d(S)`. Then:

* `J(S) ≤ J(P)`: a generator `A` of `J(S)` is an abelian `A ≤ S` with `|A| = d(S)`; it lies in
  `J(S) ≤ P`, hence is an abelian subgroup of `P` of order `d(S) = d(P)`, so it is one of the
  generators of `J(P)`.
* `J(P) ≤ J(S)`: a generator `A` of `J(P)` is an abelian `A ≤ P ≤ S` of order `d(P) = d(S)`,
  hence a generator of `J(S)`.
-/

-- Glauberman 1968, Lemma 3.5 (b): if `J(S) ≤ P ≤ S` then `J(S) = J(P)`.
theorem lemma3_5_b {G : Type*} [Group G] (S P : Subgroup G) [Finite S]
    (hJ : Work.PGroup.thompsonJ S ≤ P) (hPS : P ≤ S) :
    Work.PGroup.thompsonJ S = Work.PGroup.thompsonJ P := by
  -- Step 1: the maximal order of an abelian subgroup is the same for `P` and `S`.
  have hcard : Work.PGroup.maxAbelianOrder P = Work.PGroup.maxAbelianOrder S := by
    apply le_antisymm
    · -- `d(P) ≤ d(S)`: abelian subgroups of `P` are abelian subgroups of `S`.
      rw [Work.PGroup.maxAbelianOrder, Work.PGroup.maxAbelianOrder]
      refine csSup_le
        ⟨1, ⊥, bot_le, IsMulCommutative.of_comm (fun a b => Subsingleton.elim _ _),
          Subgroup.card_bot⟩ ?_
      rintro n ⟨A, hAP, hAcomm, rfl⟩
      refine le_csSup ⟨Nat.card S, ?_⟩ ⟨A, hAP.trans hPS, hAcomm, rfl⟩
      rintro m ⟨B, hBS, -, rfl⟩
      exact Subgroup.card_le_of_le hBS
    · -- `d(S) ≤ d(P)`: an abelian `A ≤ S` of order `d(S)` lies in `J(S) ≤ P`.
      obtain ⟨A, hAS, hAcomm, hAcard⟩ := Work.PGroup.maxAbelianOrder_attained S
      have hAP : A ≤ P := (Work.PGroup.le_thompsonJ hAS hAcomm hAcard).trans hJ
      rw [← hAcard, Work.PGroup.maxAbelianOrder]
      refine le_csSup ?_ ⟨A, hAP, hAcomm, rfl⟩
      exact ⟨Nat.card S, fun n hn => by
        obtain ⟨B, hBP, -, rfl⟩ := hn
        exact Subgroup.card_le_of_le (hBP.trans hPS)⟩
  -- Step 2: compare the two Thompson subgroups through their generators.
  refine le_antisymm ?_ ?_
  · -- `J(S) ≤ J(P)`: each generator of `J(S)` is a generator of `J(P)`.
    rw [Work.PGroup.thompsonJ, Subgroup.closure_le]
    rintro x ⟨A, hAS, hAcomm, hAcard, hxA⟩
    have hAP : A ≤ P := (Work.PGroup.le_thompsonJ hAS hAcomm hAcard).trans hJ
    exact Work.PGroup.le_thompsonJ hAP hAcomm (hAcard.trans hcard.symm) hxA
  · -- `J(P) ≤ J(S)`: each generator of `J(P)` is a generator of `J(S)`.
    rw [Work.PGroup.thompsonJ, Subgroup.closure_le]
    rintro x ⟨A, hAP, hAcomm, hAcard, hxA⟩
    exact Work.PGroup.le_thompsonJ (hAP.trans hPS) hAcomm (hAcard.trans hcard) hxA

end Work.GlaubermanZJ
