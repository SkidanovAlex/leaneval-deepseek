import Mathlib
import Submission.Work.GlaubermanZJ.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `Z(J(P)) ≤ P`

`Submission.Blueprint.ZJ P = J(P) ∩ C_G(J(P))`, so everything in it lies in `J(P)`, and `J(P)`
is by construction generated by subgroups of `P`:

`Submission.Blueprint.thompsonJ P = ⨆ (A : Subgroup G) (_ : A ≤ P ∧ …), A`

is a supremum of subgroups, every one of which is contained in `P`; a supremum of subgroups
contained in `P` is contained in `P`.  Hence `J(P) ≤ P` and `Z(J(P)) ≤ J(P) ≤ P`.

The two step lemmas are stated here (`blueprint_thompsonJ_le`,
`blueprint_ZJ_le_thompsonJ`) so that later files in the area can reuse them without unfolding
`ZJ`.
-/

set_option autoImplicit false

namespace Work.GlaubermanZJ

/-- Thompson's subgroup `J(P) = Submission.Blueprint.thompsonJ P` is contained in `P`: it is the
supremum of the subgroups `A ≤ P` that are abelian of maximal order in `P`, and a supremum of
subgroups contained in `P` is contained in `P`. -/
theorem blueprint_thompsonJ_le {G : Type*} [Group G] (P : Subgroup G) :
    Submission.Blueprint.thompsonJ P ≤ P := by
  unfold Submission.Blueprint.thompsonJ
  exact iSup_le fun A => iSup_le fun hA => hA.1

/-- `Z(J(P)) ≤ J(P)` for the blueprint's `ZJ`, i.e. `J(P) ⊓ C_G(J(P)) ≤ J(P)`. -/
theorem blueprint_ZJ_le_thompsonJ {G : Type*} [Group G] (P : Subgroup G) :
    Submission.Blueprint.ZJ P ≤ Submission.Blueprint.thompsonJ P :=
  inf_le_left

/-- `Z(J(P)) ≤ P`: `Z(J(P)) ≤ J(P) ≤ P`. -/
theorem ZJ_le {G : Type*} [Group G] (P : Subgroup G) : Submission.Blueprint.ZJ P ≤ P :=
  le_trans (blueprint_ZJ_le_thompsonJ P) (blueprint_thompsonJ_le P)

end Work.GlaubermanZJ
