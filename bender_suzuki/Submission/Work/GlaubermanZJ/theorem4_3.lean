/-!
# Glauberman's Theorem 4.3: `Z(J(S)) ∩ B ⊴ G` for an arbitrary normal `p`-subgroup `B`

Glauberman, *A characteristic subgroup of a `p`-stable group*, Canad. J. Math. **20** (1968),
Theorem 4.3 (pp. 1113-1114):

> Let `p` be an odd prime and `S` a Sylow `p`-subgroup of a finite group `G`. Suppose that `B` is
> a normal `p`-subgroup of `G`. If `G` is `p`-stable, then `Z(J(S)) ∩ B` is a normal subgroup
> of `G`.

The paper derives this from Theorem 4.2 (the same statement under the additional hypothesis that
`B` has nilpotence class at most two and `[B,B] ≤ Z(J(S))`).  The argument is a minimal
counterexample argument **on the order of `B`**, for a *fixed* group `X`:

* `Z := Z(J(S))`, `C := Z ∩ B`.  If `C` is not normal, let `B₁` be the normal closure of `C`
  in `X` ("the normal subgroup of `G` generated by all the conjugates of `Z ∩ B`").  Then
  `B₁ ≤ B` because `B ⊴ X` and `C ≤ B`, and `Z ∩ B₁ = Z ∩ B = C` is still not normal, so if
  `B₁ < B` minimality of `B` gives a contradiction.  Hence `B = B₁`: `B` is the smallest normal
  subgroup of `X` containing `C`.
* Let `B' := [B,B] < B` (a nontrivial finite `p`-group is not its own commutator).  By minimality
  applied to the normal `p`-subgroup `B'`, the subgroup `Z ∩ B'` is normal in `X`.
* `[C,B] ≤ Z` (as `C ≤ Z` and `B ≤ S ≤ N_X(Z)`) and `[C,B] ≤ [B,B] = B'`, so `[C,B] ≤ Z ∩ B'`;
  since `B` is the normal closure of `C` and `Z ∩ B'` is normal, `[B,B] ≤ Z ∩ B'`, in particular
  `[B,B] ≤ Z`.
* `C ≤ C_X(B')` (as `C ≤ Z` and `B' ≤ Z ≤ C_X(J(S))` is abelian), and `B` is the normal closure
  of `C` while `B' ⊴ X`, so `B ≤ C_X(B')`.  Hence `[B,B'] = 1`, i.e. `B' ≤ Z(B) = Work.PGroup.centerIn B`.
* The hypotheses of Theorem 4.2 hold for `B`, so `Z ∩ B = C` is normal in `X` after all: the
  assumed counterexample cannot exist.

The `p`-solvability and "`5 ≤ p` or abelian Sylow 2" hypotheses are the standing hypotheses of the
area (`GlaubermanZJProp`); they are unused here and are simply threaded through to Theorem 4.2.
-/

open scoped Classical Pointwise

namespace Work.GlaubermanZJ

/-- **Normal-closure criterion for `[B,B] ≤ N`.**  If `B` is the normal closure of `C`, if
`B ⊴ G`, `N ⊴ G` and `[C,B] ≤ N`, then `[B,B] ≤ N`.

Indeed, in `G ⧸ N` the image of `B` is the normal closure of the image of `C` (the quotient map is
surjective, so `Subgroup.map_normalClosure` applies), the image of `C` lies in the centralizer of
the image of `B` (which is normal since the image of `B` is), so by minimality of the normal
closure the image of `B` centralizes itself; hence the image of `B` is commutative and
`[B,B] ≤ N`. -/
theorem commutator_le_of_eq_normalClosure {G : Type*} [Group G] {C B N : Subgroup G}
    (hBnorm : B.Normal) (hN : N.Normal) (hB : B = Subgroup.normalClosure (C : Set G))
    (hCB : ⁅C, B⁆ ≤ N) : ⁅B, B⁆ ≤ N := by
  haveI : B.Normal := hBnorm
  haveI : N.Normal := hN
  have hker : ⁅C, B⁆ ≤ (QuotientGroup.mk' N).ker := by
    rw [QuotientGroup.ker_mk']; exact hCB
  have h1 : ⁅C.map (QuotientGroup.mk' N), B.map (QuotientGroup.mk' N)⁆ = ⊥ := by
    rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff]
    exact hker
  have h2 : B.map (QuotientGroup.mk' N) =
      Subgroup.normalClosure ((C.map (QuotientGroup.mk' N) : Subgroup (G ⧸ N)) : Set (G ⧸ N)) := by
    rw [hB, Subgroup.map_normalClosure _ _ (QuotientGroup.mk'_surjective N), Subgroup.coe_map]
  have hBbar : (B.map (QuotientGroup.mk' N)).Normal :=
    hBnorm.map _ (QuotientGroup.mk'_surjective N)
  have h3 : B.map (QuotientGroup.mk' N) ≤
      Subgroup.centralizer ((B.map (QuotientGroup.mk' N) : Subgroup (G ⧸ N)) : Set (G ⧸ N)) := by
    haveI : (B.map (QuotientGroup.mk' N)).Normal := hBbar
    conv_lhs => rw [h2]
    exact Subgroup.normalClosure_le_normal (Subgroup.commutator_eq_bot_iff_le_centralizer.mp h1)
  have h4 : ⁅B.map (QuotientGroup.mk' N), B.map (QuotientGroup.mk' N)⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr h3
  rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff] at h4
  rwa [QuotientGroup.ker_mk'] at h4

-- Glauberman 1968, Theorem 4.3 (p. 1113): `p` odd, `S` a Sylow `p`-subgroup of a finite group
-- `G`, `B ⊴ G` a normal `p`-subgroup; if `G` is `p`-stable then `Z(J(S)) ∩ B ⊴ G`.
-- (Proof: minimal counterexample, reducing to Theorem 4.2, pp. 1113-1114.)
theorem theorem4_3 {X : Type*} [Group X] [Finite X] {p : ℕ} (hp : p.Prime) (hpne : p ≠ 2)
    (hps : Work.HallHigman.IsPSolvable p X)
    (h2 : 5 ≤ p ∨ Work.GlaubermanZJ.HasAbelianSylowTwo X)
    (hstab : Work.GlaubermanZJ.IsPStable p X) (S : Sylow p X)
    (B : Subgroup X) [B.Normal] (hBp : IsPGroup p B) :
    (Submission.Blueprint.ZJ (S : Subgroup X) ⊓ B).Normal := by
  set Z : Subgroup X := Submission.Blueprint.ZJ (S : Subgroup X) with hZ
  -- `Z = Z(J(S))` is normalized by `S`, since it is characteristic in `S`.
  have hSNZ : (S : Subgroup X) ≤ Subgroup.normalizer (Z : Set X) := by
    rw [hZ]
    exact (Subgroup.le_normalizer (H := (S : Subgroup X))).trans
      (Work.ThompsonFrobenius.normalizer_le_normalizer_ZJ (S : Subgroup X))
  -- Minimal counterexample argument, by strong induction on the order of `B`.
  have key : ∀ n, ∀ (B : Subgroup X), B.Normal → IsPGroup p ↥B → Nat.card ↥B = n →
      (Z ⊓ B).Normal := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih B hBn hBp hcard
    haveI : B.Normal := hBn
    have ih' : ∀ (B' : Subgroup X), B'.Normal → IsPGroup p ↥B' → Nat.card ↥B' < n →
        (Z ⊓ B').Normal := fun B' h1 h2 h3 => ih (Nat.card ↥B') h3 B' h1 h2 rfl
    by_contra hnot
    -- `C = Z ∩ B` and `B₁ =` normal closure of `C`
    set C : Subgroup X := Z ⊓ B with hC
    set B₁ : Subgroup X := Subgroup.normalClosure (C : Set X) with hB₁
    have hB₁le : B₁ ≤ B := by
      rw [hB₁]
      exact Subgroup.normalClosure_le_normal (by rw [hC]; exact Set.inter_subset_right)
    have hZ₁ : Z ⊓ B₁ = Z ⊓ B := by
      refine le_antisymm (le_inf inf_le_left (le_trans inf_le_right hB₁le)) ?_
      exact le_inf inf_le_left
        ((le_of_eq hC.symm).trans (by rw [hB₁]; exact Subgroup.le_normalClosure))
    -- If the normal closure were proper, minimality would apply to it
    have hB₁eqB : B₁ = B := by
      by_contra hne
      have hlt : B₁ < B := lt_of_le_of_ne hB₁le hne
      have hcard_lt : Nat.card ↥B₁ < n := by
        rw [← hcard]; exact Subgroup.card_lt_of_lt hlt
      have hB₁n : B₁.Normal := by rw [hB₁]; infer_instance
      have hB₁p : IsPGroup p ↥B₁ := hBp.to_le hB₁le
      have := ih' B₁ hB₁n hB₁p hcard_lt
      rw [hZ₁] at this
      exact hnot this
    have hBeq : B = Subgroup.normalClosure (C : Set X) := hB₁eqB.symm.trans hB₁
    -- `B' = [B,B]` is a normal `p`-subgroup of smaller order
    set B' : Subgroup X := ⁅B, B⁆ with hB'
    have hB'le : B' ≤ B := by rw [hB']; exact Subgroup.commutator_le_left B B
    have hB'normal : B'.Normal := by
      refine Subgroup.Normal.of_conjugate_fixed fun g => ?_
      have hmem : g ∈ Subgroup.normalizer (B : Set X) := by
        rw [Subgroup.normalizer_eq_top_iff.mpr hBn]; exact Subgroup.mem_top g
      have hconjB : B.map (MulAut.conj g).toMonoidHom = B :=
        Subgroup.mem_normalizer_iff_map_conj_eq.mp hmem
      show MulAut.conj g • ⁅B, B⁆ = ⁅B, B⁆
      calc MulAut.conj g • ⁅B, B⁆
          = (⁅B, B⁆).map (MulAut.conj g).toMonoidHom := Subgroup.pointwise_smul_def _
        _ = ⁅B.map (MulAut.conj g).toMonoidHom, B.map (MulAut.conj g).toMonoidHom⁆ :=
              Subgroup.map_commutator B B _
        _ = ⁅B, B⁆ := by rw [hconjB]
    have hB'p : IsPGroup p ↥B' := hBp.to_le hB'le
    have hBne : B ≠ ⊥ := by
      rintro rfl
      apply hnot
      rw [hC, inf_bot_eq]
      exact Subgroup.Normal.mk (fun n hn g => by
        rw [Subgroup.mem_bot] at hn ⊢
        rw [hn, mul_one, mul_inv_cancel])
    have hne' : B' ≠ B := by
      rw [hB']
      exact Work.LocalPrelim.pgroup_commutator_ne_self hp hBp hBp
        (Subgroup.le_normalizer (H := B)) hBne
    have hlt' : B' < B := lt_of_le_of_ne hB'le hne'
    have hcard' : Nat.card ↥B' < n := by
      rw [← hcard]; exact Subgroup.card_lt_of_lt hlt'
    -- minimality: `Z ∩ B'` is normal in `X`
    have hN : (Z ⊓ B').Normal := ih' B' hB'normal hB'p hcard'
    have hB_le_S : B ≤ (S : Subgroup X) := IsPGroup.le_sylow_of_normal hBp S
    have hB_NZ : B ≤ Subgroup.normalizer (Z : Set X) := hB_le_S.trans hSNZ
    have hCBZ : ⁅C, B⁆ ≤ Z := by
      rw [hC]
      calc ⁅Z ⊓ B, B⁆ ≤ ⁅Z, B⁆ := Subgroup.commutator_mono inf_le_left le_rfl
        _ ≤ Z := Subgroup.le_normalizer_iff_commutator_le_left.mp hB_NZ
    have hCB_B' : ⁅C, B⁆ ≤ B' := by
      rw [hC, hB']
      exact Subgroup.commutator_mono inf_le_right le_rfl
    have hCBN : ⁅C, B⁆ ≤ Z ⊓ B' := le_inf hCBZ hCB_B'
    -- hence `[B,B] ≤ Z`
    have hB'B : ⁅B, B⁆ ≤ Z :=
      (commutator_le_of_eq_normalClosure hBn hN hBeq hCBN).trans inf_le_left
    have hB'Z : B' ≤ Z := by rw [hB']; exact hB'B
    -- `C` centralizes `B'` (as `C ≤ Z` and `B' ≤ Z`, with `Z` abelian), and `B` is the normal
    -- closure of `C`, so `B` centralizes `B'`: `B` has nilpotence class at most two
    have hC_cent : C ≤ Subgroup.centralizer (B' : Set X) := by
      intro c hc
      rw [Subgroup.mem_centralizer_iff]
      intro b hb
      rw [hC] at hc
      exact isAbelianSubgroup_ZJ (S : Subgroup X) b (hZ ▸ hB'Z hb) c (hZ ▸ hc.1)
    have hB_cent : B ≤ Subgroup.centralizer (B' : Set X) := by
      haveI : B'.Normal := hB'normal
      rw [hBeq]
      exact Subgroup.normalClosure_le_normal hC_cent
    have hcomm : ⁅B, B'⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hB_cent
    have hcomm' : ⁅B', B⁆ = ⊥ := by rw [Subgroup.commutator_comm]; exact hcomm
    have hB'cent : B' ≤ Subgroup.centralizer (B : Set X) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm'
    have hclass : ⁅B, B⁆ ≤ Work.PGroup.centerIn B := by
      rw [← Work.GlaubermanZJ.inf_centralizer_eq_centerIn]
      exact le_inf hB'le hB'cent
    have hcenter : ⁅B, B⁆ ≤ Submission.Blueprint.ZJ (S : Subgroup X) := hZ ▸ hB'B
    -- Theorem 4.2 rules out the counterexample
    have h42 : C.Normal := theorem4_2 hp hpne hps h2 hstab S B hBp hclass hcenter
    exact hnot h42
  exact key (Nat.card ↥B) B inferInstance hBp rfl

end Work.GlaubermanZJ
