/-!
# Glauberman's commutator convention and its calculus

Glauberman (*A characteristic subgroup of a p-stable group*, Canad. J. Math. **20** (1968),
1101–1135) uses the commutator convention `[u,v] = u⁻¹v⁻¹uv` and the conjugation
`u^v = v⁻¹uv`.  Mathlib's element commutator `⁅u,v⁆` is the *other* convention
(`⁅u,v⁆ = u v u⁻¹ v⁻¹`); at the level of *subgroups* the two generate the same subgroups, but
the element-level identities needed for the proof of Glauberman's Theorem 4.1 (the Hall–Witt
identity, the identities `[u⁻¹,v] = u[u,v]⁻¹u⁻¹`, and the "class two" distributive laws) are
stated most conveniently in Glauberman's convention.

This file introduces `pcomm u v = u⁻¹v⁻¹uv`, records its relation to Mathlib's `⁅·,·⁆`, proves
the element-level calculus, and shows that the *subgroup* generated by the `pcomm`-commutators
of `H` and `K` is exactly Mathlib's `⁅H,K⁆`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open scoped commutatorElement

namespace Work.GlaubermanZJ

variable {G : Type*} [Group G]

/-- Glauberman's commutator of two elements: `pcomm u v = u⁻¹ v⁻¹ u v`.

(Equivalently `pcomm u v = ⁅u⁻¹, v⁻¹⁆` for Mathlib's element commutator `⁅·,·⁆`.) -/
def pcomm (u v : G) : G := u⁻¹ * v⁻¹ * u * v

theorem pcomm_eq_commutatorElement_inv (u v : G) : pcomm u v = ⁅u⁻¹, v⁻¹⁆ := by
  simp [pcomm, commutatorElement_def]

theorem commutatorElement_eq_pcomm_inv (u v : G) : ⁅u, v⁆ = pcomm u⁻¹ v⁻¹ := by
  simp [pcomm, commutatorElement_def]

@[simp]
theorem pcomm_self (u : G) : pcomm u u = 1 := by
  simp [pcomm]

@[simp]
theorem pcomm_one_right (u : G) : pcomm u 1 = 1 := by
  simp [pcomm]

@[simp]
theorem pcomm_one_left (u : G) : pcomm 1 u = 1 := by
  simp [pcomm]

theorem pcomm_eq_one_iff (u v : G) : pcomm u v = 1 ↔ u * v = v * u := by
  rw [pcomm_eq_commutatorElement_inv, commutatorElement_eq_one_iff_mul_comm]
  constructor
  · intro h; rw [← inv_inj, mul_inv_rev, mul_inv_rev]; simpa using h.symm
  · intro h; rw [← inv_inj, mul_inv_rev, mul_inv_rev]; simpa using h.symm

theorem pcomm_eq_one_iff_commute (u v : G) : pcomm u v = 1 ↔ Commute u v := by
  rw [pcomm_eq_one_iff, commute_iff_eq]

/-- `pcomm` is antisymmetric: `[u,v] = [v,u]⁻¹`. -/
theorem pcomm_inv_eq (u v : G) : pcomm u v = (pcomm v u)⁻¹ := by
  simp only [pcomm]
  group

/-- `[u,v]⁻¹ = [v,u]`. -/
theorem pcomm_inv (u v : G) : (pcomm u v)⁻¹ = pcomm v u := by
  rw [pcomm_inv_eq, inv_inv]

/-- Conjugation of a `pcomm`: `[u^g, v^g] = [u,v]^g` for `u^g = g⁻¹ug`. -/
theorem pcomm_conj (u v g : G) : pcomm (g⁻¹ * u * g) (g⁻¹ * v * g) = g⁻¹ * pcomm u v * g := by
  simp only [pcomm]
  group

/-- `[u⁻¹,v] = u [u,v]⁻¹ u⁻¹`. -/
theorem pcomm_inv_left (u v : G) : pcomm u⁻¹ v = u * (pcomm u v)⁻¹ * u⁻¹ := by
  simp only [pcomm]
  group

/-- `[u,v⁻¹] = v [u,v]⁻¹ v⁻¹`. -/
theorem pcomm_inv_right (u v : G) : pcomm u v⁻¹ = v * (pcomm u v)⁻¹ * v⁻¹ := by
  simp only [pcomm]
  group

/-- The "left distributive law": `[u₁u₂, v] = u₂⁻¹ [u₁,v] u₂ · [u₂,v]`. -/
theorem pcomm_mul_left (u₁ u₂ v : G) :
    pcomm (u₁ * u₂) v = u₂⁻¹ * pcomm u₁ v * u₂ * pcomm u₂ v := by
  simp only [pcomm]
  group

/-- The "right distributive law": `[u, v₁v₂] = [u,v₂] · v₂⁻¹ [u,v₁] v₂`. -/
theorem pcomm_mul_right (u v₁ v₂ : G) :
    pcomm u (v₁ * v₂) = pcomm u v₂ * (v₂⁻¹ * pcomm u v₁ * v₂) := by
  simp only [pcomm]
  group

/-- In a "class two" situation (`[u₁,v]` and `[u₂,v]` central in the relevant subgroup) the
commutator is additive in the first argument.  Stated with the explicit commensurability
hypothesis: both `[u₁,v]` and `[u₂,v]` commute with `u₂`. -/
theorem pcomm_mul_left_of_comm (u₁ u₂ v : G) (h : Commute u₂ (pcomm u₁ v)) :
    pcomm (u₁ * u₂) v = pcomm u₁ v * pcomm u₂ v := by
  have h1 : u₂⁻¹ * pcomm u₁ v * u₂ = pcomm u₁ v := by
    calc u₂⁻¹ * pcomm u₁ v * u₂ = u₂⁻¹ * (pcomm u₁ v * u₂) := by rw [mul_assoc]
      _ = u₂⁻¹ * (u₂ * pcomm u₁ v) := by rw [← h.eq]
      _ = pcomm u₁ v := by rw [← mul_assoc, inv_mul_cancel, one_mul]
  rw [pcomm_mul_left, h1]

/-- In a "class two" situation the commutator is additive in the second argument. -/
theorem pcomm_mul_right_of_comm (u v₁ v₂ : G) (h : Commute v₂ (pcomm u v₁)) :
    pcomm u (v₁ * v₂) = pcomm u v₂ * pcomm u v₁ := by
  have h1 : v₂⁻¹ * pcomm u v₁ * v₂ = pcomm u v₁ := by
    calc v₂⁻¹ * pcomm u v₁ * v₂ = v₂⁻¹ * (pcomm u v₁ * v₂) := by rw [mul_assoc]
      _ = v₂⁻¹ * (v₂ * pcomm u v₁) := by rw [← h.eq]
      _ = pcomm u v₁ := by rw [← mul_assoc, inv_mul_cancel, one_mul]
  rw [pcomm_mul_right, h1]

/-- **The Hall–Witt identity** (P. Hall), in Glauberman's convention with the conjugation
`g^h = h⁻¹gh`: `[x,y⁻¹,z]^y · [y,z⁻¹,x]^z · [z,x⁻¹,y]^x = 1`. -/
theorem pcomm_hallWitt (x y z : G) :
    y⁻¹ * pcomm (pcomm x y⁻¹) z * y * (z⁻¹ * pcomm (pcomm y z⁻¹) x * z)
      * (x⁻¹ * pcomm (pcomm z x⁻¹) y * x) = 1 := by
  simp only [pcomm]
  group

/-! ## The subgroup generated by the `pcomm`-commutators -/

/-- The subgroup generated by the `pcomm`-commutators `[u,v]` with `u ∈ H`, `v ∈ K`. -/
def pcommSub (H K : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | ∃ u ∈ H, ∃ v ∈ K, x = pcomm u v}

theorem pcomm_mem_pcommSub {H K : Subgroup G} {u v : G} (hu : u ∈ H) (hv : v ∈ K) :
    pcomm u v ∈ pcommSub H K :=
  Subgroup.subset_closure ⟨u, hu, v, hv, rfl⟩

theorem pcommSub_le {H K L : Subgroup G} (h : ∀ u ∈ H, ∀ v ∈ K, pcomm u v ∈ L) :
    pcommSub H K ≤ L := by
  rw [pcommSub, Subgroup.closure_le]
  rintro x ⟨u, hu, v, hv, rfl⟩
  exact h u hu v hv

theorem le_pcommSub_iff {H K L : Subgroup G} :
    pcommSub H K ≤ L ↔ ∀ u ∈ H, ∀ v ∈ K, pcomm u v ∈ L :=
  ⟨fun h u hu v hv => h (pcomm_mem_pcommSub hu hv), pcommSub_le⟩

/-- The subgroup generated by the `pcomm`-commutators of `H` and `K` is Mathlib's `⁅H,K⁆`. -/
theorem pcommSub_eq_commutator (H K : Subgroup G) : pcommSub H K = ⁅H, K⁆ := by
  apply le_antisymm
  · refine pcommSub_le fun u hu v hv => ?_
    rw [pcomm_eq_commutatorElement_inv]
    exact Subgroup.commutator_mem_commutator (H.inv_mem hu) (K.inv_mem hv)
  · rw [Subgroup.commutator_def, Subgroup.closure_le]
    rintro x ⟨u, hu, v, hv, rfl⟩
    have : ⁅u, v⁆ = pcomm u⁻¹ v⁻¹ := commutatorElement_eq_pcomm_inv u v
    rw [this]
    exact pcomm_mem_pcommSub (H.inv_mem hu) (K.inv_mem hv)

theorem pcommSub_mono {H₁ H₂ K₁ K₂ : Subgroup G} (hH : H₁ ≤ H₂) (hK : K₁ ≤ K₂) :
    pcommSub H₁ K₁ ≤ pcommSub H₂ K₂ := by
  refine pcommSub_le fun u hu v hv => pcomm_mem_pcommSub (hH hu) (hK hv)

theorem pcommSub_comm (H K : Subgroup G) : pcommSub H K = pcommSub K H := by
  rw [pcommSub_eq_commutator, pcommSub_eq_commutator, Subgroup.commutator_comm]

end Work.GlaubermanZJ
