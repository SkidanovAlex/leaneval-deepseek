/-!
# Glauberman 1968, Lemma 3.5 (a)

If `A` is an abelian subgroup of `S` of maximal order (`A ∈ 𝓐(S)`) and `A ≤ P ≤ S`, then
`Z(J(S)) ≤ A` and `Z(J(S)) ≤ Z(J(P))`.

Here `Z(J(-))` is `Submission.Blueprint.ZJ = thompsonJ(-) ⊓ C_G(thompsonJ(-))` and `J(-)` is
`Submission.Blueprint.thompsonJ`, the supremum of the abelian subgroups of maximal order.

The argument (Glauberman, *A characteristic subgroup of a p-stable group*, p. 1108; the Sylow
hypothesis there is irrelevant) is short.

* `A` itself satisfies the "dominates every abelian subgroup in order" condition, so `A ≤ J(S)`.
* The same holds for `A` inside `P`, using `A ≤ P ≤ S`; hence `A ≤ J(P)`.
* `d(P) = d(S) = |A|`: any maximal-order abelian subgroup `B ≤ P` has `|B| = |A|` (it is
  abelian in `S` as well and `A` dominates it, while `A ≤ P` dominates it in `P`).  Consequently
  every maximal-order abelian subgroup `B` of `P` is a maximal-order abelian subgroup of `S`,
  so `J(P) ≤ J(S)`.
* For the first assertion, fix `z ∈ Z(J(S))`.  Then `z` centralises `J(S)`, hence `A`, and
  `z ∈ J(S) ≤ S`; so `⟨A, z⟩` is an abelian subgroup of `S` containing `A`, and maximality of
  `|A|` forces `⟨A, z⟩ = A`, i.e. `z ∈ A`.
* For the second, `z ∈ J(S)` centralises `J(S) ≥ J(P)` and `z ∈ A ≤ J(P)`, so
  `z ∈ J(P) ⊓ C_G(J(P)) = Z(J(P))`.
-/

set_option autoImplicit false

namespace Work.GlaubermanZJ

/-- **Glauberman 1968, Lemma 3.5 (a).** If `A` is an abelian subgroup of `S` of maximal order
and `A ≤ P ≤ S`, then `Z(J(S)) ≤ A` and `Z(J(S)) ≤ Z(J(P))`. -/
theorem lemma3_5_a {G : Type*} [Group G] (S P A : Subgroup G) [Finite S]
    (hA : Work.GlaubermanZJ.IsMaxAbelianSubgroup S A) (hAP : A ≤ P) (hPS : P ≤ S) :
    Submission.Blueprint.ZJ S ≤ A ∧ Submission.Blueprint.ZJ S ≤ Submission.Blueprint.ZJ P := by
  obtain ⟨hAS, hAab, hAmax⟩ := hA
  -- `A` is a maximal-order abelian subgroup of `S`, hence contained in `J(S)`.
  have hAJ : A ≤ Submission.Blueprint.thompsonJ S := le_blueprint_thompsonJ hAS hAab hAmax
  -- `A` is also a maximal-order abelian subgroup of `P`.
  have hAJP : A ≤ Submission.Blueprint.thompsonJ P :=
    le_blueprint_thompsonJ hAP hAab fun B hBP hBab => hAmax B (le_trans hBP hPS) hBab
  -- Every maximal-order abelian subgroup of `P` is a maximal-order abelian subgroup of `S`.
  have hJPS : Submission.Blueprint.thompsonJ P ≤ Submission.Blueprint.thompsonJ S := by
    unfold Submission.Blueprint.thompsonJ
    refine iSup_le fun B => iSup_le fun hB => ?_
    have hBS : B ≤ S := le_trans hB.1 hPS
    have hcard : Nat.card B = Nat.card A :=
      le_antisymm (hAmax B hBS hB.2.1) (hB.2.2 A hAP hAab)
    exact le_blueprint_thompsonJ hBS hB.2.1 fun C hCS hCab => hcard ▸ hAmax C hCS hCab
  -- First assertion: `Z(J(S)) ≤ A`.
  have hZJA : Submission.Blueprint.ZJ S ≤ A := by
    intro z hz
    rw [Submission.Blueprint.ZJ, Subgroup.mem_inf] at hz
    obtain ⟨hzJ, hzC⟩ := hz
    have hzS : z ∈ S := blueprint_thompsonJ_le S hzJ
    -- `z` centralises `A`, because `A ≤ J(S)` and `z ∈ C_G(J(S))`.
    have hzcentA : z ∈ Subgroup.centralizer (A : Set G) := Subgroup.centralizer_le hAJ hzC
    have hzcomm : ∀ a ∈ A, a * z = z * a := fun a ha =>
      Subgroup.mem_centralizer_iff.mp hzcentA a ha
    -- The subgroup generated by `A` and `z` is abelian and contained in `S`.
    let K : Subgroup G := Subgroup.closure ((A : Set G) ∪ {z})
    have hAK : A ≤ K := fun a ha => Subgroup.subset_closure (Set.mem_union_left {z} ha)
    have hzK : z ∈ K :=
      Subgroup.subset_closure (Set.mem_union_right (A : Set G) (Set.mem_singleton z))
    have hKS : K ≤ S := by
      rw [Subgroup.closure_le]
      intro x hx
      rcases (Set.mem_union x (A : Set G) {z}).mp hx with hx | hx
      · exact hAS hx
      · rw [Set.mem_singleton_iff.mp hx]; exact hzS
    have hpair : ((A : Set G) ∪ {z}).Pairwise Commute := by
      rw [Set.pairwise_union]
      refine ⟨?_, Set.pairwise_singleton z Commute, ?_⟩
      · intro a ha b hb _
        exact (commute_iff_eq a b).mpr (hAab a ha b hb)
      · intro a ha b hb _
        rw [Set.mem_singleton_iff.mp hb]
        exact ⟨(commute_iff_eq a z).mpr (hzcomm a ha), (commute_iff_eq z a).mpr (hzcomm a ha).symm⟩
    have hKab : Submission.Blueprint.IsAbelianSubgroup K :=
      isAbelianSubgroup_iff.mpr (Subgroup.isMulCommutative_closure hpair)
    haveI hfinK : Finite ↥K :=
      Finite.of_injective (Subgroup.inclusion hKS) (Subgroup.inclusion_injective hKS)
    -- Maximality of `A` forces `K = A`, whence `z ∈ A`.
    have hEq : A = K := Subgroup.eq_of_le_of_card_ge hAK (hAmax K hKS hKab)
    rw [hEq]
    exact hzK
  refine ⟨hZJA, ?_⟩
  -- Second assertion: `Z(J(S)) ≤ Z(J(P))`.
  intro z hz
  rw [Submission.Blueprint.ZJ, Subgroup.mem_inf] at hz
  obtain ⟨hzJ, hzC⟩ := hz
  rw [Submission.Blueprint.ZJ, Subgroup.mem_inf]
  exact ⟨hAJP (hZJA ⟨hzJ, hzC⟩), Subgroup.centralizer_le hJPS hzC⟩

end Work.GlaubermanZJ
