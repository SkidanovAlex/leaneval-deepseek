import Submission.Work.Step7Comm.Defs
import Submission.Work.Step7Comm.Basic
import Submission.Work.Step7Comm.isElementaryAbelianTwo_Q0sub
import Submission.Work.ThmF.Prove.trichotomySingle
import Submission.Work.ThmF.Prove.trichotomyOfPrimeNil
import Submission.Work.ThmF.ChV12.L5Base
import Submission.Work.ThmF.ChV12.Q0sub_elementary

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `Work.Step7Comm.trichotomy_at_mem_W`

Ch. V §2 Lemma 2 (c) (`Prove/trichotomyOfPrimeNil`) applied at the prime-order subgroup
`P' = ⟨w⟩` generated by an element `w ∈ W = C_D(Inv H)` of prime order.

Two inputs of that trichotomy are cheap here and are provided by the Step7Comm area:

* `w ∈ W` centralises every involution of `H` (Ch. II §4 Prop. 4), hence
  `Q₀sub H ≤ C_G(⟨w⟩)` (`Step7Comm.Basic`), so the "`ℓ`" of the trichotomy is
  `|Q₀sub H|` (the `Q₀sub H ⊓ C_G(⟨w⟩)` of the general statement collapses to `Q₀sub H`);
* `Q₀sub H` is elementary abelian of exponent two and `|Q₀sub H| = 2^{|P|} ≥ 4`, so
  `C_G(⟨w⟩)` contains a four-group — the hypothesis `hB3` of §2 Lemma 2 (c).

The centraliser `C_G(⟨w⟩)` of the subgroup generated by `w` coincides with the centraliser
`C_G({w})` of the singleton, so the conclusion is stated with the latter.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

noncomputable section

namespace Work.Step7Comm

theorem trichotomy_at_mem_W {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G}
    {P : Subgroup G} (hC4 : Submission.Blueprint.ChIIFourProp)
    (c : Work.ThmF.ChV3.CtxF H Q t s r P) (hQ2 : IsPGroup 2 ↥Q)
    (hQ0 : Nat.card ↥(Work.ThmF.Q0sub H) = 2 ^ Nat.card P) {w : G}
    (hw : w ∈ Work.ThmF.W H t) (hwprime : (orderOf w).Prime) :
    (orderOf (s * t) = 3 ∧
        Nat.card ↥(Q ⊓ Subgroup.centralizer ({w} : Set G)) = Nat.card ↥(Work.ThmF.Q0sub H)) ∨
      (orderOf (s * t) = 5 ∧
        Nat.card ↥(Q ⊓ Subgroup.centralizer ({w} : Set G)) =
          Nat.card ↥(Work.ThmF.Q0sub H) ^ 2) ∨
      (orderOf (s * t) = 3 ∧
        Nat.card ↥(Q ⊓ Subgroup.centralizer ({w} : Set G)) =
          Nat.card ↥(Work.ThmF.Q0sub H) ^ 3) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  -- `Q` is nilpotent, being a `2`-group
  have hnil : Group.IsNilpotent ↥Q := hQ2.isNilpotent
  -- `P' = ⟨w⟩` has prime order `o(w)`
  have hprime : (Nat.card ↥(Subgroup.zpowers w : Subgroup G)).Prime := by
    rw [Nat.card_zpowers]
    exact hwprime
  -- `P' ≤ V = centD H t`: `w ∈ W ≤ centD H t`
  have hP : (Subgroup.zpowers w : Subgroup G) ≤ Submission.Blueprint.centD H t :=
    Subgroup.zpowers_le.mpr (Work.ThmF.W_le_centD H t hw)
  -- `Q₀sub H ≤ C_G(⟨w⟩)`: `w ∈ W = C_D(Inv H)`
  have hQ0le : Work.ThmF.Q0sub H ≤
      Subgroup.centralizer ((Subgroup.zpowers w : Subgroup G) : Set G) :=
    Q0sub_le_centralizer_zpowers_of_mem_W c hC4 hw
  -- `4 ≤ |Q₀sub H| = 2^{|P|}`
  have hcard4 : 4 ≤ Nat.card ↥(Work.ThmF.Q0sub H) := by
    rw [hQ0]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ Nat.card P := Nat.pow_le_pow_right (by norm_num) c.P_prime.two_le
  -- `Q₀sub H` is elementary abelian of exponent two
  have hel : IsElementaryAbelianTwo (Work.ThmF.Q0sub H) :=
    isElementaryAbelianTwo_Q0sub_of_nilpotent c hnil
  -- hence `C_G(⟨w⟩)` contains a four-group: hypothesis (B3) of §2 Lemma 2 (c)
  have hB3 : Submission.Blueprint.HasFourGroup
      ↥(Subgroup.centralizer ((Subgroup.zpowers w : Subgroup G) : Set G)) :=
    hasFourGroup_centralizer_of_isElementaryAbelianTwo hQ0le hel hcard4
  -- §2 Lemma 2 (c) at the prime-order subgroup `⟨w⟩`
  have htri := Work.ThmF.Prove.trichotomyOfPrimeNil (H := H) (Q := Q) (t := t)
    (P := Subgroup.zpowers w) c.sit c.simple c.split hC4 hnil hB3
    c.s_mem c.s_inv c.r_mem c.sid hP hprime
  dsimp only at htri
  -- `C_G(⟨w⟩) = C_G({w})` and `Q₀sub H ⊓ C_G(⟨w⟩) = Q₀sub H`
  have hcent_eq : Subgroup.centralizer ((Subgroup.zpowers w : Subgroup G) : Set G)
      = Subgroup.centralizer ({w} : Set G) := by
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  have hQ0inf : Work.ThmF.Q0sub H ⊓
      Subgroup.centralizer ((Subgroup.zpowers w : Subgroup G) : Set G)
      = Work.ThmF.Q0sub H :=
    inf_eq_left.mpr hQ0le
  rcases htri with ⟨h1, -, h3⟩ | ⟨h1, -, h3, -⟩ | ⟨h1, h3, -⟩
  · exact Or.inl ⟨h1, by rw [← hcent_eq, h3, hQ0inf]⟩
  · exact Or.inr (Or.inl ⟨h1, by rw [← hcent_eq, h3, hQ0inf]⟩)
  · exact Or.inr (Or.inr ⟨h1, by rw [← hcent_eq, h3, hQ0inf]⟩)

end Work.Step7Comm
