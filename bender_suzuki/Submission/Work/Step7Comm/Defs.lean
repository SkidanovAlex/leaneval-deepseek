/-!
# `Work.Step7Comm` — Peterfalvi II, Ch. V §3, step (7): the commutative branch of `C_Q(P)`

Source: D. Gorenstein, R. Lyons, R. Solomon, *The classification of the finite simple groups,
Number 2* (the Bender–Suzuki theorem), as transcribed in `REFS/peterfalvi_II_ch5_6.md`,
Ch. V §3 step (7) (pp. 250–251).

Step (7) of the chain proves `Ker H Q P t = P`, equivalently (with step (1)) that

`Σ ⊓ C_G(C_Q(P)) = 1`,   where `Σ = C_W(P)`.

`Prove/step7Direct.lean` splits this into two branches: the non-commutative one
(`W_inf_eq_bot_of_noncomm`, using that `|C_Q(P)| = 8` when `C_Q(P)` is not abelian) and the
commutative one.  The design's commutative branch used App. XI Prop. 1 (2)b) — the *injective*
action of `Σ` on the near-field `F` — which is precisely the statement of step (7) itself
(a circularity).  This area proves the commutative branch **directly**, from the arithmetic
input `ArithmeticNineTwoSeven` and Ch. V §2 Lemma 2 (c) (`Prove/trichotomySingle`), with no
near-field input.

## The mathematics (source step (7))

Let `P` be the prime-order subgroup of the standing context `CtxF`, `f = o(st)` and let

`w ≠ 1` lie in `Σ ⊓ C_G(C_Q(P))`.

* `sigLemma2c` (§2 Lemma 2 (c)) gives that `Q ⊓ C_G(w)` is a `2`-group and that `f ∈ {3,5}`.
  Since `w` centralises `C_Q(P)`, the latter is a `2`-group, so `|C_Q(P)| = 2^b`.
* `h15.hcq` says `|C_Q(P)| + 1 = f^m`; the arithmetic lemma [HB] IX (2-7) (`hA`) applied to
  `f^m = 2^b + 1` leaves only `m = 1` or `f^m = 9`, so
  `|C_Q(P)| = 2, f = 3`, or `|C_Q(P)| = 4, f = 5`, or `|C_Q(P)| = 8, f = 3`.
* `Q` is a `2`-group (`|Q| = |C_Q(P)|^{|P|}`, step (4)), so §2 Lemma 2 (c) at the prime-order
  subgroup `⟨w⟩` applies (`trichotomy_of_prime`), with `C = Q ⊓ C_G(w)` and
  `ℓ = |Q₀sub H ⊓ C_G(⟨w⟩)| = |Q₀sub H|`: either `f = 3`, `C` abelian, `|C| = ℓ`, or `f = 5`,
  `|C| = ℓ²`, or `f = 3`, `|C| = ℓ³`.
* Comparing with `|Q| = |C_Q(P)|^{|P|}` and `ℓ = 2^{|P|}` (step (1)):
  * `|C_Q(P)| = 2`, case `|C| = ℓ`: `|C| = 2^{|P|} = |Q|`, so `C = Q`; `w` centralises `Q`,
    contradicting `ChV12.eq_one_of_centralizes_Q` (faithfulness of `D = H ⊓ H^t` on `Q`);
  * `|C_Q(P)| = 4`, case `|C| = ℓ²`: `ℓ² = 4^{|P|} = |Q|`, so again `C = Q` — impossible;
  * `|C_Q(P)| = 8`, case `|C| = ℓ³`: `ℓ³ = 8^{|P|} = |Q|`, so again `C = Q` — impossible;
  * `|C_Q(P)| = 8`, case `|C| = ℓ`: then `Q₀sub H ≤ C` and `|Q₀sub H| = ℓ = |C|` force
    `C = Q₀sub H`; so `C_Q(P) ≤ Q₀sub H`, whence `C_Q(P)` (of order `8`, abelian by hypothesis)
    is elementary abelian and contains a four-group — contradicting the standing hypothesis
    `c.F1 : ¬ HasFourGroup (C_G(P))`.

## This file

The notions this area is built on, together with their trivial API.  Everything is stated for
subgroups of an abstract finite group `G` so that the lemmas can be reused by the sibling areas
(`NearFieldFieldPropNI`, the near-field reconstruction) without any extra hypotheses.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

noncomputable section

open Classical LeanEval.GroupTheory.Defs Submission.Blueprint

namespace Work.Step7Comm

variable {G : Type} [Group G]

/-- **Ch. V §3 step (7), the group shown to be trivial (commutative branch).**
`Σ ⊓ C_G(C_Q(P))`, where `Σ = Sig H t P = C_W(P)` and `C_Q(P) = CQ Q P`. -/
abbrev SigCQ (H : Subgroup G) (t : G) (Q P : Subgroup G) : Subgroup G :=
  Work.ThmF.ChV3.Sig H t P ⊓ Subgroup.centralizer ((Work.ThmF.ChV3.CQ Q P : Subgroup G) : Set G)

/-- `Y` is *elementary abelian of exponent two*: every element of `Y` is an involution and `Y` is
abelian.  This is the 2-rank-one feature of `C_Q(P)` (via the standing hypothesis (F1)) and of
`Q₀sub H` (which is generated by the pairwise-commuting involutions of `H`). -/
def IsElementaryAbelianTwo (Y : Subgroup G) : Prop :=
  (∀ y ∈ Y, y * y = 1) ∧ (∀ y ∈ Y, ∀ z ∈ Y, y * z = z * y)

/-- The three possibilities for `(f, |C_Q(P)|)` left by the arithmetic lemma [HB] IX (2-7):
`(|C_Q(P)|, f) = (2,3)`, `(4,5)` or `(8,3)`. -/
def CommCQCase (f c : ℕ) : Prop :=
  (c = 2 ∧ f = 3) ∨ (c = 4 ∧ f = 5) ∨ (c = 8 ∧ f = 3)

/-! ## Elementary API -/

theorem isElementaryAbelianTwo_iff {Y : Subgroup G} :
    IsElementaryAbelianTwo Y ↔
      (∀ y ∈ Y, y * y = 1) ∧ (∀ y ∈ Y, ∀ z ∈ Y, y * z = z * y) := Iff.rfl

/-- A subgroup of an elementary abelian group of exponent two is again elementary abelian of
exponent two. -/
theorem IsElementaryAbelianTwo.mono {Y Z : Subgroup G} (h : Y ≤ Z)
    (hZ : IsElementaryAbelianTwo Z) : IsElementaryAbelianTwo Y :=
  ⟨fun y hy => hZ.1 y (h hy), fun y hy z hz => hZ.2 y (h hy) z (h hz)⟩

/-- An elementary abelian group of exponent two of order `≥ 4` contains a four-group. -/
theorem IsElementaryAbelianTwo.hasFourGroup {Y : Subgroup G} [Finite ↥Y]
    (hY : IsElementaryAbelianTwo Y) (hcard : 4 ≤ Nat.card ↥Y) : HasFourGroup ↥Y := by
  classical
  have horder2 : ∀ y : ↥Y, y ≠ 1 → orderOf y = 2 := by
    intro y hy
    have h2 : y ^ 2 = 1 := Subtype.ext (by simpa [pow_two] using hY.1 y y.2)
    have hdvd : orderOf y ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr h2
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hy
    · exact h
  -- two distinct non-identity elements
  obtain ⟨a, ha⟩ : ∃ a : ↥Y, a ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hsub : Subsingleton ↥Y := ⟨fun x y => by rw [hcon x, hcon y]⟩
    have : Nat.card ↥Y = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hsub, ⟨1⟩⟩
    omega
  obtain ⟨b, hb⟩ : ∃ b : ↥Y, b ≠ 1 ∧ b ≠ a := by
    by_contra hcon
    push Not at hcon
    have hsub : (Set.univ : Set ↥Y) ⊆ ({a, 1} : Set ↥Y) := by
      intro x _
      by_cases hx : x = 1
      · exact Or.inr hx
      · exact Or.inl (hcon x hx)
    have hle := Set.ncard_le_ncard hsub (Set.toFinite _)
    rw [Set.ncard_univ] at hle
    have h2 : ({a, 1} : Set ↥Y).ncard ≤ 2 := by
      simpa using Set.ncard_insert_le a ({(1 : ↥Y)} : Set ↥Y)
    omega
  have hab : a * b = b * a := Subtype.ext (hY.2 a a.2 b b.2)
  exact ⟨a, b, horder2 a ha, horder2 b hb.1, fun h => hb.2 h.symm, hab⟩

/-- `HasFourGroup` is monotone under passing to a larger subgroup of `G`. -/
theorem hasFourGroup_of_le {Y Z : Subgroup G} (h : Y ≤ Z) (hY : HasFourGroup ↥Y) :
    HasFourGroup ↥Z := by
  obtain ⟨a, b, ha, hb, hab, hcomm⟩ := hY
  refine ⟨⟨(a : G), h a.2⟩, ⟨(b : G), h b.2⟩, ?_, ?_, ?_, ?_⟩
  · exact ((Subgroup.orderOf_mk (a : G) (h a.2)).trans
      ((Subgroup.orderOf_coe a).trans ha))
  · exact ((Subgroup.orderOf_mk (b : G) (h b.2)).trans
      ((Subgroup.orderOf_coe b).trans hb))
  · intro hEq
    exact hab (Subtype.ext (by simpa using congrArg (fun z : ↥Z => (z : G)) hEq))
  · exact Subtype.ext (by simpa using congrArg (fun z : ↥Y => (z : G)) hcomm)

/-- If `Y ≤ C_G(X)` is elementary abelian of exponent two of order `≥ 4`, then `C_G(X)` contains a
four-group.  This is how hypothesis (F1) is used: `C_Q(P)` of order `8` inside an elementary
abelian `Q₀sub H` would produce a four-group in `C_G(P)`. -/
theorem hasFourGroup_centralizer_of_isElementaryAbelianTwo {X Y : Subgroup G} [Finite ↥Y]
    (hY : Y ≤ Subgroup.centralizer (X : Set G)) (hel : IsElementaryAbelianTwo Y)
    (hcard : 4 ≤ Nat.card ↥Y) :
    HasFourGroup ↥(Subgroup.centralizer (X : Set G)) :=
  hasFourGroup_of_le hY (hel.hasFourGroup hcard)

/-- The "cardinality pinching" used by the final case analysis: a subgroup of `Q` with `|Q|`
elements is `Q`. -/
theorem eq_of_le_of_card_le {X Q : Subgroup G} [Finite ↥Q] (h : X ≤ Q)
    (hcard : Nat.card ↥Q ≤ Nat.card ↥X) : X = Q :=
  Subgroup.eq_of_le_of_card_ge h hcard

/-- **Hypothesis (F1) of the §3 context, in usable form**: `C_G(P)` contains no elementary abelian
subgroup of exponent two and order `≥ 4`.  (`C_Q(P)` of order `8` lying in an elementary abelian
`Q₀sub H` produces such a subgroup — this is the last case of step (7).) -/
theorem false_of_isElementaryAbelianTwo_le_centralizer [Finite G] {H Q : Subgroup G} {t s r : G}
    {P : Subgroup G} (c : Work.ThmF.ChV3.CtxF H Q t s r P) {Y : Subgroup G} [Finite ↥Y]
    (hY : Y ≤ Subgroup.centralizer (P : Set G)) (hel : IsElementaryAbelianTwo Y)
    (hcard : 4 ≤ Nat.card ↥Y) : False :=
  c.F1 (hasFourGroup_centralizer_of_isElementaryAbelianTwo hY hel hcard)

end Work.Step7Comm
