/-!
# `Work.Coherence.isVChar_conj`

The complex conjugate of a virtual character is a virtual character:
`IsVChar f → IsVChar (fun g => conj (f g))`.

`Work.Coherence.IsVChar f` is membership of `f` in the additive subgroup of `G → ℂ` generated by
the irreducible complex characters `Irr G` (`Work.Coherence.Defs`).  Hence it suffices that `Irr G`
be stable under complex conjugation.  The conjugate of an irreducible character is the character of
the *contragredient* (dual) representation, which is again irreducible; this is
`Work.Coherence.isIrreducible_dual` below.  Since the character of the dual representation is
`g ↦ χ g⁻¹` and for a finite group `χ g⁻¹ = conj (χ g)` (`Work.Coherence.char_inv_eq_conj`), the
conjugate of `χ` lies again in `Irr G`, and the result follows from closure of `IsVChar` under
addition and negation.

## Contents

* `Work.Coherence.isIrreducible_dual` — the dual of an irreducible representation is irreducible.
* `Work.Coherence.irr_conj'` — `Irr G` is closed under complex conjugation.
* `Work.Coherence.isVChar_conj` — the conjugate of a virtual character is a virtual character.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

noncomputable section

open Classical

namespace Work.Coherence

universe u

/-! ## The contragredient of an irreducible representation is irreducible -/

section DualIrreducible

variable {G V : Type*} [Group G] [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
  {ρ : Representation ℂ G V}

/-- The value of the contragredient representation: `((ρᵛ g) φ) v = φ (ρ g⁻¹ v)`. -/
@[simp] lemma dual_apply_apply (g : G) (φ : Module.Dual ℂ V) (v : V) :
    ((ρ.dual g) φ) v = φ (ρ g⁻¹ v) := rfl

/-- The coannihilator of a subrepresentation `S` of the contragredient representation
`ρᵛ = ρ.dual`, viewed as a subrepresentation of `ρ`.  It is the subspace
`{v | ∀ φ ∈ S, φ v = 0}`, which is stable under `ρ` because `S` is stable under `ρᵛ`. -/
def dualCoannSubrep (S : Subrepresentation ρ.dual) : Subrepresentation ρ where
  toSubmodule := S.toSubmodule.dualCoannihilator
  apply_mem_toSubmodule := fun g v hv => by
    rw [Submodule.mem_dualCoannihilator] at hv ⊢
    intro φ hφ
    have hmem : (ρ.dual g⁻¹) φ ∈ S.toSubmodule := S.apply_mem_toSubmodule g⁻¹ hφ
    have h0 : ((ρ.dual g⁻¹) φ) v = 0 := hv _ hmem
    rw [dual_apply_apply, inv_inv] at h0
    exact h0

/-- The annihilator of a subrepresentation `T` of `ρ`, viewed as a subrepresentation of the
contragredient representation `ρᵛ`.  It is the subspace `T.dualAnnihilator = {φ | ∀ v ∈ T, φ v = 0}`,
which is stable under `ρᵛ` because `T` is stable under `ρ`. -/
def dualAnnSubrep (T : Subrepresentation ρ) : Subrepresentation ρ.dual where
  toSubmodule := T.toSubmodule.dualAnnihilator
  apply_mem_toSubmodule := fun g φ hφ => by
    rw [Submodule.mem_dualAnnihilator] at hφ ⊢
    intro v hv
    have hmem : ρ g⁻¹ v ∈ T.toSubmodule := T.apply_mem_toSubmodule g⁻¹ hv
    rw [dual_apply_apply]
    exact hφ _ hmem

/-- The annihilator construction is injective: over a finite-dimensional space, a subspace of `V`
is recovered from its annihilator by taking the coannihilator. -/
lemma dualAnnSubrep_injective : Function.Injective (dualAnnSubrep (ρ := ρ)) := by
  intro T₁ T₂ h
  have h' : T₁.toSubmodule.dualAnnihilator = T₂.toSubmodule.dualAnnihilator :=
    congrArg Subrepresentation.toSubmodule h
  apply Subrepresentation.toSubmodule_injective
  calc T₁.toSubmodule = T₁.toSubmodule.dualAnnihilator.dualCoannihilator :=
        (Subspace.dualAnnihilator_dualCoannihilator_eq).symm
    _ = T₂.toSubmodule.dualAnnihilator.dualCoannihilator := by rw [h']
    _ = T₂.toSubmodule := Subspace.dualAnnihilator_dualCoannihilator_eq

/-- **The contragredient of an irreducible representation is irreducible.** -/
theorem isIrreducible_dual (h : ρ.IsIrreducible) : ρ.dual.IsIrreducible := by
  haveI := h
  -- Nontriviality: the annihilator construction is injective out of the nontrivial lattice of
  -- subrepresentations of `ρ`.
  haveI : Nontrivial (Subrepresentation ρ.dual) := by
    obtain ⟨a, b, hab⟩ := exists_pair_ne (Subrepresentation ρ)
    exact ⟨dualAnnSubrep a, dualAnnSubrep b,
      fun hh => hab (dualAnnSubrep_injective hh)⟩
  -- Simplicity: the coannihilator is an order-reversing involution between the two lattices, so a
  -- proper non-trivial subrepresentation of `ρᵛ` would give one of `ρ`.
  refine IsSimpleOrder.of_forall_eq_top (fun S hS => ?_)
  rcases IsSimpleOrder.eq_bot_or_eq_top (dualCoannSubrep S) with hT | hT
  · have hsub : S.toSubmodule = ⊤ := by
      calc S.toSubmodule
          = S.toSubmodule.dualCoannihilator.dualAnnihilator :=
            (Subspace.dualCoannihilator_dualAnnihilator_eq).symm
        _ = (⊥ : Submodule ℂ V).dualAnnihilator := by
              rw [show S.toSubmodule.dualCoannihilator = ⊥ from
                congrArg Subrepresentation.toSubmodule hT]
        _ = ⊤ := Submodule.dualAnnihilator_bot
    refine Subrepresentation.toSubmodule_injective ?_
    rw [hsub]
    rfl
  · exfalso
    apply hS
    refine Subrepresentation.toSubmodule_injective ?_
    have hsub : S.toSubmodule = ⊥ := by
      calc S.toSubmodule
          = S.toSubmodule.dualCoannihilator.dualAnnihilator :=
            (Subspace.dualCoannihilator_dualAnnihilator_eq).symm
        _ = (⊤ : Submodule ℂ V).dualAnnihilator := by
              rw [show S.toSubmodule.dualCoannihilator = ⊤ from
                congrArg Subrepresentation.toSubmodule hT]
        _ = ⊥ := Submodule.dualAnnihilator_top
    rw [hsub]
    rfl

end DualIrreducible

/-! ## Conjugation of irreducible and virtual characters -/

section IrrConj

variable {G : Type*} [Group G] [Fintype G]

/-- **`Irr G` is closed under complex conjugation.**  The conjugate of an irreducible character is
the character of the contragredient representation, which is irreducible by
`Work.Coherence.isIrreducible_dual`. -/
theorem irr_conj' {χ : G → ℂ} (hχ : χ ∈ Irr G) :
    (fun g => starRingEnd ℂ (χ g)) ∈ Irr G := by
  obtain ⟨W, hW, rfl⟩ := hχ
  refine ⟨FDRep.of (Representation.dual W.ρ), ?_, ?_⟩
  · rw [Work.CharCore.fdRep_simple_iff, FDRep.of_ρ']
    exact isIrreducible_dual ((Work.CharCore.fdRep_simple_iff W).mp hW)
  · ext g
    rw [FDRep.char_dual]
    exact char_inv_eq_conj W g

end IrrConj

/-- **The complex conjugate of a virtual character is a virtual character.** -/
theorem isVChar_conj {G : Type*} [Group G] [Fintype G] {f : G → ℂ} (hf : IsVChar f) :
    IsVChar (fun g => starRingEnd ℂ (f g)) := by
  refine AddSubgroup.closure_induction (p := fun f _ => IsVChar (fun g => starRingEnd ℂ (f g)))
    ?_ ?_ ?_ ?_ hf
  · intro χ hχ
    exact isVChar_of_mem_Irr (irr_conj' hχ)
  · rw [show (fun g => starRingEnd ℂ ((0 : G → ℂ) g)) = 0 by ext g; simp]
    exact IsVChar.zero
  · intro a b _ _ ha hb
    rw [show (fun g => starRingEnd ℂ ((a + b) g))
        = (fun g => starRingEnd ℂ (a g)) + (fun g => starRingEnd ℂ (b g)) by
      ext g; simp]
    exact ha.add hb
  · intro a _ ha
    rw [show (fun g => starRingEnd ℂ ((-a) g)) = -(fun g => starRingEnd ℂ (a g)) by
      ext g; simp]
    exact ha.neg


end Work.Coherence
