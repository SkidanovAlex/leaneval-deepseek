/-
# The block decomposition of the fixed points of an element of a `p`-group

Main theorem (`Work.LocalPrelim.rsf_block_decomposition`): if a finite `p`-group `Q` acts on a
finite set `α` with a unique `Q`-fixed point `base`, then for every `x : Q` the set of `x`-fixed
points other than `base` splits into pairwise disjoint `p`-element blocks, each of which is
cyclically permuted by an element of `Q` whose `p`-th power fixes the block pointwise.

The proof proceeds in three steps.

* `exists_isBlockDecomp_of_card_eq_prime` (base case): if `P` is a finite `p`-group acting
  transitively on `O` with `Nat.card O = p`, then the fixed point set of any `x : P` is either
  empty or all of `O`, and in the latter case it is a single block.
* `exists_isBlockDecomp_of_isPretransitive` (transitive case): proved by strong induction on
  `Nat.card P`.  For `|O| = p` this is the base case; otherwise one passes to a subgroup `M ≤ P`
  of index `p` containing the stabilizer of a fixed point `a₀`, and the `M`-orbits — each of
  cardinality divisible by `p` — are pieces on which the induction hypothesis applies.
* `rsf_block_decomposition` assembles the decomposition of `α` out of the transitive
  decompositions of the `Q`-orbits of `α \ {base}`.
-/
import Mathlib
import Submission.Work.LocalPrelim.BlockDecomp
import Submission.Work.LocalPrelim.relIndex_sup_eq_relIndex_inf

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

namespace Work.LocalPrelim

open MulAction

universe u v

variable {p : ℕ}

/-! ### Elementary orbit facts -/

/-- The cardinality of an orbit is the index of the point stabilizer. -/
theorem card_orbit_eq_index_stabilizer {G : Type u} {O : Type v} [Group G] [MulAction G O]
    (a : O) : Nat.card (MulAction.orbit G a) = (MulAction.stabilizer G a).index := by
  rw [Subgroup.index_eq_card]
  exact Nat.card_congr (MulAction.orbitEquivQuotientStabilizer G a)

/-- In a pretransitive action every orbit is the whole space. -/
theorem orbit_eq_univ_of_isPretransitive {G : Type u} {O : Type v} [Group G] [MulAction G O]
    (h : MulAction.IsPretransitive G O) (a : O) : MulAction.orbit G a = Set.univ :=
  (MulAction.isPretransitive_iff_orbit_eq_univ a).mp h

/-- In a pretransitive action every orbit has the cardinality of the whole space. -/
theorem card_orbit_eq_card_of_isPretransitive {G : Type u} {O : Type v} [Group G] [MulAction G O]
    (h : MulAction.IsPretransitive G O) (a : O) :
    Nat.card (MulAction.orbit G a) = Nat.card O := by
  rw [orbit_eq_univ_of_isPretransitive h a, Nat.card_coe_set_eq, Set.ncard_univ]

/-- The set of points fixed by the subgroup generated by `x` is the fixed point set of `x`. -/
theorem fixedPoints_zpowers_eq {G : Type u} {O : Type v} [Group G] [MulAction G O] (x : G) :
    MulAction.fixedPoints (Subgroup.zpowers x) O = {a : O | x • a = a} := by
  ext a
  rw [MulAction.mem_fixedPoints]
  exact ⟨fun h => h ⟨x, Subgroup.mem_zpowers x⟩, fun h g => by
    have hx : x ∈ MulAction.stabilizer G a := MulAction.mem_stabilizer_iff.mpr h
    exact MulAction.mem_stabilizer_iff.mp (Subgroup.zpowers_le.mpr hx g.2)⟩

/-! ### The base case: `|O| = p` -/

theorem exists_isBlockDecomp_of_card_eq_prime {p : ℕ} (hp : p.Prime) {P : Type u} {O : Type v}
    [Group P] [Finite P] [MulAction P O] [Finite O] (hP : IsPGroup p P)
    (htrans : MulAction.IsPretransitive P O) (hcard : Nat.card O = p) (x : P) :
    ∃ (n : ℕ) (e : Fin n → ZMod p → O) (y : Fin n → P),
      IsBlockDecomp p x {a : O | x • a = a} n e y := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  by_cases hΩ : ∃ a : O, x • a = a
  · obtain ⟨a₀, ha₀⟩ := hΩ
    -- some element moves `a₀`, otherwise `O` is a single point
    have hy_exists : ∃ y : P, y • a₀ ≠ a₀ := by
      by_contra h
      push_neg at h
      have hsub : Subsingleton O := ⟨fun a b => by
        obtain ⟨g, hg⟩ := htrans.exists_smul_eq a₀ a
        obtain ⟨g', hg'⟩ := htrans.exists_smul_eq a₀ b
        rw [← hg, ← hg', h g, h g']⟩
      have h1 : Nat.card O = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hsub, ⟨a₀⟩⟩
      have := hp.two_le
      omega
    obtain ⟨y, hy⟩ := hy_exists
    -- the orbit of `a₀` under `⟨y⟩` has `p` elements
    haveI : Fintype ↥(MulAction.orbit (Subgroup.zpowers y) a₀) := Fintype.ofFinite _
    have horb : Nat.card ↥(MulAction.orbit (Subgroup.zpowers y) a₀) = p := by
      have hle : Nat.card ↥(MulAction.orbit (Subgroup.zpowers y) a₀) ≤ p := by
        rw [← hcard]
        exact Nat.card_le_card_of_injective _ Subtype.coe_injective
      obtain ⟨k, hk⟩ := (hP.to_subgroup (Subgroup.zpowers y)).card_orbit a₀
      have h2 : 1 < Nat.card ↥(MulAction.orbit (Subgroup.zpowers y) a₀) := by
        rw [Finite.one_lt_card_iff_nontrivial]
        refine ⟨⟨⟨a₀, MulAction.mem_orbit_self a₀⟩,
          ⟨⟨y, Subgroup.mem_zpowers y⟩ • a₀, MulAction.mem_orbit _ _⟩, ?_⟩⟩
        intro hcon
        exact hy (by simpa using (congrArg Subtype.val hcon).symm)
      have hk1 : 1 ≤ k := by
        rcases Nat.eq_zero_or_pos k with h0 | h0
        · rw [h0, pow_zero] at hk
          omega
        · exact h0
      have hpk : p ≤ Nat.card ↥(MulAction.orbit (Subgroup.zpowers y) a₀) :=
        calc p ≤ p ^ k := by simpa using Nat.pow_le_pow_right hp.one_le hk1
          _ = _ := hk.symm
      omega
    -- hence the period of `y` on `a₀` is `p`
    have hd : MulAction.period y a₀ = p := by
      rw [MulAction.period_eq_minimalPeriod, MulAction.minimalPeriod_eq_card,
        Fintype.card_eq_nat_card]
      exact horb
    subst hd
    -- now the modulus is the period of `y` on `a₀`
    haveI : NeZero (MulAction.period y a₀) := ⟨hp.ne_zero⟩
    haveI : Fact (1 < MulAction.period y a₀) := ⟨hp.one_lt⟩
    -- `x` fixes every point: `Nat.card (fix x) ≡ Nat.card O ≡ 0 [MOD p]` and it is `≤ p`
    have hfixall : ∀ a : O, x • a = a := by
      have hdvd : MulAction.period y a₀ ∣ ({a : O | x • a = a} : Set O).ncard := by
        have h1 := (hP.to_subgroup (Subgroup.zpowers x)).card_modEq_card_fixedPoints O
        rw [hcard, Nat.card_coe_set_eq, fixedPoints_zpowers_eq] at h1
        exact Nat.modEq_zero_iff_dvd.mp
          (h1.symm.trans (Nat.modEq_zero_iff_dvd.mpr (dvd_refl _)))
      have hle : ({a : O | x • a = a} : Set O).ncard ≤ MulAction.period y a₀ := by
        rw [← hcard, ← Set.ncard_univ]
        exact Set.ncard_le_ncard (Set.subset_univ _)
      have hpos : 0 < ({a : O | x • a = a} : Set O).ncard := by
        rw [← Nat.card_coe_set_eq]
        exact Nat.card_pos_iff.mpr ⟨⟨a₀, ha₀⟩, inferInstance⟩
      have heq : ({a : O | x • a = a} : Set O).ncard = MulAction.period y a₀ :=
        le_antisymm hle (Nat.le_of_dvd hpos hdvd)
      have huniv : ({a : O | x • a = a} : Set O) = Set.univ := by
        rw [Set.eq_univ_iff_ncard]
        exact heq.trans hcard.symm
      intro a
      have : a ∈ ({a : O | x • a = a} : Set O) := by rw [huniv]; trivial
      exact this
    -- an enumeration of the orbit, the orbit being all of `O`
    let E : ZMod (MulAction.period y a₀) → O := fun k => y ^ k.val • a₀
    have hEinj : Function.Injective E := by
      have hkey : ∀ k l : ZMod (MulAction.period y a₀), l.val ≤ k.val → E k = E l → k = l := by
        intro k l hle hkl
        have h1 : y ^ (l.val + (k.val - l.val)) • a₀ = y ^ l.val • a₀ := by
          rw [Nat.add_sub_of_le hle]
          exact hkl
        rw [pow_add, mul_smul] at h1
        have h2 : y ^ (k.val - l.val) • a₀ = a₀ := by
          refine Equiv.injective (MulAction.toPerm (y ^ l.val)) ?_
          simpa only [MulAction.toPerm_apply] using h1
        have hdvd : MulAction.period y a₀ ∣ k.val - l.val :=
          MulAction.pow_smul_eq_iff_period_dvd.mp h2
        have hlt : k.val - l.val < MulAction.period y a₀ :=
          lt_of_le_of_lt (Nat.sub_le _ _) (ZMod.val_lt k)
        have hzero : k.val - l.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
        have hvv : k.val = l.val := by omega
        exact ZMod.val_injective _ hvv
      intro k l hkl
      rcases le_total l.val k.val with hle | hle
      · exact hkey k l hle hkl
      · exact (hkey l k hle hkl.symm).symm
    have horb_univ : MulAction.orbit (Subgroup.zpowers y) a₀ = Set.univ := by
      rw [Set.eq_univ_iff_ncard, ← Nat.card_coe_set_eq]
      exact horb.trans hcard.symm
    have hEsu : Function.Surjective E := by
      have hsub : Set.range E ⊆ MulAction.orbit (Subgroup.zpowers y) a₀ := by
        rintro _ ⟨k, rfl⟩
        exact MulAction.mem_orbit_iff.mpr
          ⟨⟨y ^ k.val, Subgroup.mem_zpowers_iff.mpr ⟨(k.val : ℤ), by rw [zpow_natCast]⟩⟩, rfl⟩
      have hcardrange : Nat.card ↥(Set.range E) =
          Nat.card ↥(MulAction.orbit (Subgroup.zpowers y) a₀) := by
        rw [← Nat.card_congr (Equiv.ofInjective E hEinj), Nat.card_zmod]
        exact horb.symm
      have hrange : Set.range E = MulAction.orbit (Subgroup.zpowers y) a₀ :=
        Set.eq_of_subset_of_ncard_le hsub (by
          rw [← Nat.card_coe_set_eq, ← Nat.card_coe_set_eq, hcardrange])
      intro a
      have : a ∈ Set.range E := by rw [hrange, horb_univ]; trivial
      exact this
    have hshift : ∀ k : ZMod (MulAction.period y a₀), y • E k = E (k + 1) := by
      intro k
      have h1 : y • E k = y ^ (k.val + 1) • a₀ := by
        change y • (y ^ k.val • a₀) = y ^ (k.val + 1) • a₀
        rw [← mul_smul, ← pow_succ']
      have h2 : E (k + 1) = y ^ ((k + 1).val) • a₀ := rfl
      rw [h1, h2, ZMod.val_add, ZMod.val_one]
      exact (MulAction.pow_mod_period_smul (k.val + 1)).symm
    have hpowfix : ∀ k : ZMod (MulAction.period y a₀),
        y ^ MulAction.period y a₀ • E k = E k := by
      intro k
      change y ^ MulAction.period y a₀ • (y ^ k.val • a₀) = y ^ k.val • a₀
      rw [← mul_smul, ← pow_add, Nat.add_comm (MulAction.period y a₀) k.val,
        MulAction.pow_add_period_smul]
    refine ⟨1, fun _ => E, fun _ => y, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro i
      exact hEinj
    · intro i k
      exact hshift k
    · intro i k
      exact hpowfix k
    · intro i k
      exact hfixall (E k)
    · intro a _
      obtain ⟨k, hk⟩ := hEsu a
      exact ⟨0, k, hk⟩
    · intro i k j l h
      have hij : i = j := Subsingleton.elim i j
      subst hij
      exact ⟨rfl, hEinj h⟩
  · -- no fixed point at all: the empty decomposition
    refine ⟨0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro i
      exact Fin.elim0 i
    · intro i
      exact Fin.elim0 i
    · intro i
      exact Fin.elim0 i
    · intro i
      exact Fin.elim0 i
    · intro a ha
      exact (hΩ ⟨a, ha⟩).elim
    · intro i
      exact Fin.elim0 i

/-! ### Gluing block decompositions -/

section Gluing

variable {P : Type u} {O : Type v} [Group P] [MulAction P O]

/-- Two block decompositions of disjoint sets glue to a block decomposition of the union. -/
theorem IsBlockDecomp.union {x : P} {Ω₁ Ω₂ : Set O} (hdisj : Disjoint Ω₁ Ω₂)
    {n₁ : ℕ} {e₁ : Fin n₁ → ZMod p → O} {y₁ : Fin n₁ → P} (h₁ : IsBlockDecomp p x Ω₁ n₁ e₁ y₁)
    {n₂ : ℕ} {e₂ : Fin n₂ → ZMod p → O} {y₂ : Fin n₂ → P} (h₂ : IsBlockDecomp p x Ω₂ n₂ e₂ y₂) :
    ∃ (n : ℕ) (e : Fin n → ZMod p → O) (y : Fin n → P),
      IsBlockDecomp p x (Ω₁ ∪ Ω₂) n e y := by
  classical
  refine ⟨n₁ + n₂, fun k => Sum.elim e₁ e₂ (finSumFinEquiv.symm k),
    fun k => Sum.elim y₁ y₂ (finSumFinEquiv.symm k), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro k
    rcases hk : finSumFinEquiv.symm k with a | a <;>
      · intro u v huv
        first
          | exact h₁.injective a (by simpa only [Sum.elim_inl, hk] using huv)
          | exact h₂.injective a (by simpa only [Sum.elim_inr, hk] using huv)
  · intro k r
    rcases hk : finSumFinEquiv.symm k with a | a <;>
      · first
          | exact h₁.shift a r
          | exact h₂.shift a r
  · intro k r
    rcases hk : finSumFinEquiv.symm k with a | a <;>
      · first
          | exact h₁.pow_fix a r
          | exact h₂.pow_fix a r
  · intro k r
    rcases hk : finSumFinEquiv.symm k with a | a
    · exact Or.inl (h₁.mem a r)
    · exact Or.inr (h₂.mem a r)
  · intro a ha
    rcases ha with ha | ha
    · obtain ⟨i, r, hr⟩ := h₁.exists_of_mem a ha
      exact ⟨finSumFinEquiv (Sum.inl i), r, by
        simpa only [Equiv.symm_apply_apply, Sum.elim_inl] using hr⟩
    · obtain ⟨i, r, hr⟩ := h₂.exists_of_mem a ha
      exact ⟨finSumFinEquiv (Sum.inr i), r, by
        simpa only [Equiv.symm_apply_apply, Sum.elim_inr] using hr⟩
  · intro k r k' r' hkk
    rcases hk : finSumFinEquiv.symm k with a | a <;> rcases hk' : finSumFinEquiv.symm k' with a' | a'
    · obtain ⟨h1, h2⟩ := h₁.eq_iff a r a' r' (by
        simpa only [Sum.elim_inl, hk, hk'] using hkk)
      refine ⟨?_, h2⟩
      have : finSumFinEquiv.symm k = finSumFinEquiv.symm k' := by rw [hk, hk', h1]
      exact finSumFinEquiv.symm.injective this
    · exfalso
      have hm1 : (Sum.elim e₁ e₂ (finSumFinEquiv.symm k)) r ∈ Ω₁ := by
        rw [hk]; exact h₁.mem a r
      have hm2 : (Sum.elim e₁ e₂ (finSumFinEquiv.symm k')) r' ∈ Ω₂ := by
        rw [hk']; exact h₂.mem a' r'
      exact (Set.disjoint_left.mp hdisj hm1) (by rwa [← hkk] at hm2)
    · exfalso
      have hm1 : (Sum.elim e₁ e₂ (finSumFinEquiv.symm k)) r ∈ Ω₂ := by
        rw [hk]; exact h₂.mem a r
      have hm2 : (Sum.elim e₁ e₂ (finSumFinEquiv.symm k')) r' ∈ Ω₁ := by
        rw [hk']; exact h₁.mem a' r'
      exact (Set.disjoint_left.mp hdisj.symm hm1) (by rwa [← hkk] at hm2)
    · obtain ⟨h1, h2⟩ := h₂.eq_iff a r a' r' (by
        simpa only [Sum.elim_inr, hk, hk'] using hkk)
      refine ⟨?_, h2⟩
      have : finSumFinEquiv.symm k = finSumFinEquiv.symm k' := by rw [hk, hk', h1]
      exact finSumFinEquiv.symm.injective this

/-- A finite family of pairwise disjoint block decompositions glues to a block decomposition of the
union. -/
theorem BlockDecomp_iUnion {x : P} :
    ∀ (c : ℕ) (ι : Type*) [Fintype ι], Fintype.card ι = c → ∀ (Ω : ι → Set O),
      (∀ i j, i ≠ j → Disjoint (Ω i) (Ω j)) →
      (∀ i, ∃ (n : ℕ) (e : Fin n → ZMod p → O) (y : Fin n → P),
        IsBlockDecomp p x (Ω i) n e y) →
      ∃ (n : ℕ) (e : Fin n → ZMod p → O) (y : Fin n → P),
        IsBlockDecomp p x (⋃ i, Ω i) n e y := by
  classical
  intro c
  induction c using Nat.strong_induction_on with
  | _ c ih =>
    intro ι _ hc Ω hdisj h
    rcases Nat.eq_zero_or_pos c with h0 | hpos
    · -- empty index type
      haveI : IsEmpty ι := Fintype.card_eq_zero_iff.mp (hc ▸ h0)
      refine ⟨0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro i; exact Fin.elim0 i
      · intro i; exact Fin.elim0 i
      · intro i; exact Fin.elim0 i
      · intro i; exact Fin.elim0 i
      · intro a ha
        obtain ⟨i, _⟩ := Set.mem_iUnion.mp ha
        exact (IsEmpty.false i).elim
      · intro i; exact Fin.elim0 i
    · obtain ⟨i₀⟩ : Nonempty ι := Fintype.card_pos_iff.mp (hc ▸ hpos)
      have hdisj' : Disjoint (Ω i₀) (⋃ i : {j : ι // j ≠ i₀}, Ω i) := by
        rw [Set.disjoint_iUnion_right]
        intro i
        exact hdisj i₀ i (by simpa [eq_comm] using i.2)
      obtain ⟨n₁, e₁, y₁, h₁⟩ := h i₀
      have hcard_lt : Fintype.card {j : ι // j ≠ i₀} < c := by
        have := Fintype.card_subtype_lt (α := ι) (p := fun j => j ≠ i₀) (x := i₀) (by simp)
        rwa [hc] at this
      obtain ⟨n₂, e₂, y₂, h₂⟩ :=
        ih _ hcard_lt {j : ι // j ≠ i₀} rfl (fun i => Ω (i : ι))
          (fun i j hij => hdisj i j (fun h => hij (Subtype.ext h))) (fun i => h i)
      obtain ⟨n, e, y, hdec⟩ := h₁.union hdisj' h₂
      refine ⟨n, e, y, ?_⟩
      convert hdec using 2
      ext a
      simp only [Set.mem_iUnion, Set.mem_union]
      constructor
      · rintro ⟨i, hi⟩
        by_cases hii : i = i₀
        · exact Or.inl (hii ▸ hi)
        · exact Or.inr ⟨⟨i, hii⟩, hi⟩
      · rintro (h | ⟨i, hi⟩)
        · exact ⟨i₀, h⟩
        · exact ⟨i, hi⟩

end Gluing

/-! ### Orbit sizes relative to a subgroup of index `p` -/

theorem dvd_card_orbit_of_index_lt {p : ℕ} (hp : p.Prime) {P : Type u} {O : Type v}
    [Group P] [Finite P] [MulAction P O] [Finite O] (hP : IsPGroup p P) {M : Subgroup P}
    {b : O} (hb : M.index < Nat.card (MulAction.orbit P b)) :
    p ∣ Nat.card (MulAction.orbit M b) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨k, hk⟩ := (hP.to_subgroup M).card_orbit b
  have hne1 : Nat.card (MulAction.orbit M b) ≠ 1 := by
    intro h1
    have hMs : M ≤ MulAction.stabilizer P b := by
      haveI : Subsingleton ↥(MulAction.orbit M b) := (Nat.card_eq_one_iff_unique.mp h1).1
      intro g hg
      rw [MulAction.mem_stabilizer_iff]
      have hmem : (⟨g • b, MulAction.mem_orbit_iff.mpr ⟨⟨g, hg⟩, rfl⟩⟩ : ↥(MulAction.orbit M b)) =
          ⟨b, MulAction.mem_orbit_self b⟩ := Subsingleton.elim _ _
      simpa using congrArg Subtype.val hmem
    have hkey : M.relIndex (MulAction.stabilizer P b) *
        (MulAction.stabilizer P b).index = M.index :=
      Subgroup.relIndex_mul_index hMs
    rw [← card_orbit_eq_index_stabilizer (G := P) b] at hkey
    have hpos : 0 < M.relIndex (MulAction.stabilizer P b) := by
      refine Nat.pos_of_ne_zero fun hz => ?_
      rw [hz, zero_mul] at hkey
      have hne : M.index ≠ 0 := by
        rw [Subgroup.index_eq_card]
        exact Nat.card_pos.ne'
      exact hne hkey.symm
    have hle : Nat.card (MulAction.orbit P b) ≤ M.index := by
      rw [← hkey]
      exact Nat.le_mul_of_pos_left _ hpos
    omega
  rcases Nat.eq_zero_or_pos k with hk0 | hkpos
  · rw [hk0, pow_zero] at hk
    exact absurd hk hne1
  · rw [hk]
    exact dvd_pow_self p hkpos.ne'

/-! ### Intermediate subgroups -/

/-- If the index of `T` in a finite `p`-group `P` is bigger than `p`, then `T` lies strictly below a
proper subgroup of `P`. -/
theorem exists_lt_and_lt_top_of_index {p : ℕ} (hp : p.Prime) :
    ∀ (c : ℕ) (P : Type u) [Group P] [Finite P], Nat.card P = c → IsPGroup p P →
      ∀ (T : Subgroup P), T < ⊤ → p < T.index → ∃ M : Subgroup P, T < M ∧ M < ⊤ := by
  intro c
  refine Nat.strong_induction_on c ?_
  intro c ih P hPgrp hPfin hPc hP T hT hTindex
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  -- `P` is nontrivial
  have hnt : Nontrivial P := by
    obtain ⟨x, hx⟩ : ∃ x, x ∉ T := by
      by_contra h
      simp only [not_exists, not_not] at h
      exact hT.ne (le_antisymm le_top fun x _ => h x)
    exact ⟨x, 1, fun h => hx (h ▸ T.one_mem)⟩
  -- the center contains an element of order `p`
  have hZne : Nat.card ↥(Subgroup.center P) ≠ 1 := by
    intro h1
    exact (bot_lt_iff_ne_bot.mp hP.bot_lt_center) (Subgroup.card_eq_one.mp h1)
  obtain ⟨z, hzorder⟩ : ∃ z : ↥(Subgroup.center P), orderOf z = p := by
    obtain ⟨k, hk⟩ := (hP.to_subgroup (Subgroup.center P)).exists_card_eq
    refine exists_prime_orderOf_dvd_card' p (G := ↥(Subgroup.center P)) ?_
    have hk1 : 1 ≤ k := by
      rcases Nat.eq_zero_or_pos k with h0 | h0
      · rw [h0, pow_zero] at hk
        exact absurd hk hZne
      · exact h0
    rw [hk]
    exact dvd_pow_self p (Nat.one_le_iff_ne_zero.mp hk1)
  let N : Subgroup P := Subgroup.zpowers (z : P)
  have hNcard : Nat.card ↥N = p := by
    rw [Nat.card_zpowers, Subgroup.orderOf_coe]
    exact hzorder
  have hNnormal : N.Normal := Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr z.2)
  haveI : N.Normal := hNnormal
  by_cases hNT : N ≤ T
  · -- case 1: `N ≤ T`; pass to the quotient `P ⧸ N`
    have hker : (QuotientGroup.mk' N).ker = N := QuotientGroup.ker_mk' N
    have hTmap_index : (T.map (QuotientGroup.mk' N)).index = T.index :=
      Subgroup.index_map_eq T (QuotientGroup.mk'_surjective N) (by rw [hker]; exact hNT)
    have hTmap_lt : T.map (QuotientGroup.mk' N) < ⊤ := by
      refine lt_of_le_of_ne le_top fun htop => ?_
      have hone : (T.map (QuotientGroup.mk' N)).index = 1 := by rw [htop, Subgroup.index_top]
      rw [hTmap_index] at hone
      have := hp.two_le
      omega
    have hcard_lt : Nat.card (P ⧸ N) < c := by
      have h1 : p * Nat.card (P ⧸ N) = Nat.card P := by
        have h := Subgroup.card_mul_index N
        rw [hNcard, Subgroup.index_eq_card N] at h
        exact h
      have hpos : 0 < Nat.card (P ⧸ N) := Nat.card_pos
      have h2 : Nat.card (P ⧸ N) < p * Nat.card (P ⧸ N) := by
        have h := Nat.mul_lt_mul_of_pos_left hp.one_lt hpos
        rw [mul_one, mul_comm] at h
        exact h
      rw [h1, hPc] at h2
      exact h2
    obtain ⟨Mbar, hTMbar, hMbar_lt⟩ :=
      ih _ hcard_lt (P ⧸ N) rfl (hP.to_quotient N) (T.map (QuotientGroup.mk' N)) hTmap_lt
        (by rw [hTmap_index]; exact hTindex)
    refine ⟨Mbar.comap (QuotientGroup.mk' N), ?_, ?_⟩
    · refine lt_of_le_of_ne (Subgroup.map_le_iff_le_comap.mp hTMbar.le) fun hEq => ?_
      have hmap : T.map (QuotientGroup.mk' N) = Mbar := by
        rw [hEq,
          Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective N) Mbar]
      exact hTMbar.ne hmap
    · refine lt_of_le_of_ne le_top fun htop => ?_
      have hmap : Mbar = ⊤ := by
        rw [← Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective N) Mbar,
          htop, Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)]
      exact hMbar_lt.ne hmap
  · -- case 2: `T ⊔ N` works
    have hrel : (T ⊓ N).relIndex N = p := by
      haveI : Fact (Nat.card ↥N).Prime := ⟨hNcard ▸ hp⟩
      rcases ((T ⊓ N).subgroupOf N).eq_bot_or_eq_top_of_prime_card with h | h
      · rw [Subgroup.relIndex, h, Subgroup.index_bot]
        exact hNcard
      · exfalso
        have h1 : (T ⊓ N).relIndex N = 1 := by
          rw [Subgroup.relIndex, h, Subgroup.index_top]
        exact hNT ((Subgroup.relIndex_eq_one.mp h1).trans inf_le_left)
    refine ⟨T ⊔ N, lt_of_le_of_ne le_sup_left fun h => hNT (sup_eq_left.mp h.symm), ?_⟩
    refine lt_of_le_of_ne le_top fun htop => ?_
    have hnorm : T ≤ Subgroup.normalizer (N : Set P) := by
      intro t ht
      rw [Subgroup.mem_normalizer_iff]
      intro n
      constructor
      · intro hn
        have hc : t * n = n * t :=
          Subgroup.mem_center_iff.mp (Subgroup.zpowers_le.mpr z.2 hn) t
        rwa [hc, mul_assoc, mul_inv_cancel, mul_one]
      · intro hn
        have hc : t * (t * n * t⁻¹) = (t * n * t⁻¹) * t :=
          Subgroup.mem_center_iff.mp (Subgroup.zpowers_le.mpr z.2 hn) t
        have h1 : t * n * t⁻¹ = n := by
          calc t * n * t⁻¹ = t⁻¹ * (t * (t * n * t⁻¹)) := by group
            _ = t⁻¹ * ((t * n * t⁻¹) * t) := by rw [hc]
            _ = n := by group
        rwa [h1] at hn
    have h2 : T.relIndex (T ⊔ N) = (T ⊓ N).relIndex N :=
      relIndex_sup_eq_relIndex_inf_auxL hnorm
    rw [htop, Subgroup.relIndex_top_right] at h2
    rw [← h2] at hrel
    omega

/-! ### The transitive case -/

theorem exists_isBlockDecomp_of_isPretransitive {p : ℕ} (hp : p.Prime) :
    ∀ (n : ℕ) (P : Type u) [Group P] [Finite P], Nat.card P = n → IsPGroup p P →
      ∀ (O : Type v) [MulAction P O] [Finite O], MulAction.IsPretransitive P O →
        p ∣ Nat.card O → ∀ x : P,
          ∃ (m : ℕ) (e : Fin m → ZMod p → O) (y : Fin m → P),
            IsBlockDecomp p x {a : O | x • a = a} m e y := by
  intro n
  refine Nat.strong_induction_on n ?_
  intro n ih P hPgrp hPfin hPn hP O hOs hOfin htrans hdiv x
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  by_cases hO0 : Nat.card O = 0
  · -- `O` is empty
    haveI : Fintype O := Fintype.ofFinite O
    have hOempty : IsEmpty O := by
      rw [← Fintype.card_eq_zero_iff, Fintype.card_eq_nat_card]
      exact hO0
    refine ⟨0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · intro a _
      exact (hOempty.false a).elim
    · intro i; exact Fin.elim0 i
  by_cases hcard : Nat.card O = p
  · exact exists_isBlockDecomp_of_card_eq_prime hp hP htrans hcard x
  · -- `p < |O|`
    have hOgt : p < Nat.card O := by
      obtain ⟨c, hc⟩ := hdiv
      have hcne0 : c ≠ 0 := by
        rintro rfl
        simp only [mul_zero] at hc
        exact hO0 hc
      have hcne1 : c ≠ 1 := by
        rintro rfl
        simp only [mul_one] at hc
        exact hcard hc
      have hc2 : 1 < c := by omega
      have h := Nat.mul_lt_mul_of_pos_left hc2 hp.pos
      rw [mul_one] at h
      rwa [← hc] at h
    by_cases hΩ : ∃ a : O, x • a = a
    · obtain ⟨a₀, ha₀⟩ := hΩ
      -- the stabilizer of `a₀` is proper and has index `|O| > p`
      have hKlt : MulAction.stabilizer P a₀ < ⊤ := by
        refine lt_of_le_of_ne le_top fun htop => ?_
        have h1 : (MulAction.stabilizer P a₀).index = 1 := by rw [htop, Subgroup.index_top]
        rw [← card_orbit_eq_index_stabilizer (G := P) a₀,
          card_orbit_eq_card_of_isPretransitive htrans a₀] at h1
        rw [h1] at hOgt
        have hp2 := hp.two_le
        omega
      have hKindex : p < (MulAction.stabilizer P a₀).index := by
        rw [← card_orbit_eq_index_stabilizer (G := P) a₀,
          card_orbit_eq_card_of_isPretransitive htrans a₀]
        exact hOgt
      obtain ⟨M, hKM, hMP⟩ :=
        exists_lt_and_lt_top_of_index hp n P hPn hP (MulAction.stabilizer P a₀) hKlt hKindex
      have hxM : x ∈ M := hKM.le ha₀
      -- `Nat.card M < n`
      have hMlt_n : Nat.card ↥M < n := by
        have h1 : Nat.card ↥M * M.index = Nat.card P := Subgroup.card_mul_index M
        have hpos : 0 < M.index := by
          rw [Subgroup.index_eq_card]
          exact Nat.card_pos
        have h2 : M.index ≠ 1 := fun h => hMP.ne ((Subgroup.index_eq_one.mp h))
        have h3 : 1 < M.index := by omega
        have h4 : Nat.card ↥M * 1 < Nat.card ↥M * M.index :=
          Nat.mul_lt_mul_of_pos_left h3 Nat.card_pos
        rw [mul_one, h1, hPn] at h4
        exact h4
      -- the index of `M` is smaller than `|O|`
      have hMindex_lt : M.index < Nat.card O := by
        have h1 : (MulAction.stabilizer P a₀).relIndex M * M.index =
            (MulAction.stabilizer P a₀).index :=
          Subgroup.relIndex_mul_index hKM.le
        rw [← card_orbit_eq_index_stabilizer (G := P) a₀,
          card_orbit_eq_card_of_isPretransitive htrans a₀] at h1
        have h2 : 2 ≤ (MulAction.stabilizer P a₀).relIndex M := by
          have hne1 : (MulAction.stabilizer P a₀).relIndex M ≠ 1 := fun h =>
            hKM.ne (le_antisymm hKM.le (Subgroup.relIndex_eq_one.mp h))
          have hpos : 0 < (MulAction.stabilizer P a₀).relIndex M := by
            rw [Subgroup.relIndex, Subgroup.index_eq_card]
            exact Nat.card_pos
          omega
        have h3 : 2 * M.index ≤ (MulAction.stabilizer P a₀).relIndex M * M.index :=
          Nat.mul_le_mul_right _ h2
        rw [h1] at h3
        have h4 : 1 ≤ M.index := by
          rw [Subgroup.index_eq_card]
          exact Nat.card_pos
        omega
      -- the `M`-orbits
      haveI : Fintype (MulAction.orbitRel.Quotient M O) := Fintype.ofFinite _
      have hpiece : ∀ j : MulAction.orbitRel.Quotient M O,
          ∃ (m : ℕ) (e : Fin m → ZMod p → O) (y : Fin m → P),
            IsBlockDecomp p x {b : O | b ∈ j.orbit ∧ x • b = b} m e y := by
        intro j
        have hdivj : p ∣ Nat.card ↥(j.orbit) := by
          rw [MulAction.orbitRel.Quotient.orbit_eq_orbit_out j Quotient.out_eq']
          refine dvd_card_orbit_of_index_lt hp hP ?_
          rw [card_orbit_eq_card_of_isPretransitive htrans]
          exact hMindex_lt
        obtain ⟨m, e, y, hdec⟩ :=
          ih (Nat.card ↥M) hMlt_n ↥M rfl (hP.to_subgroup M) ↥(j.orbit)
            (inferInstance : MulAction.IsPretransitive ↥M ↥(j.orbit)) hdivj ⟨x, hxM⟩
        have hmap : IsBlockDecomp p x
            (Subtype.val '' {a : ↥(j.orbit) | (⟨x, hxM⟩ : ↥M) • a = a}) m
            (fun i k => (e i k : O)) (fun i => ((y i : ↥M) : P)) :=
          hdec.map (Subgroup.subtype M) Subtype.coe_injective fun g a => rfl
        have hset : (Subtype.val '' {a : ↥(j.orbit) | (⟨x, hxM⟩ : ↥M) • a = a}) =
            {b : O | b ∈ j.orbit ∧ x • b = b} := by
          ext b
          constructor
          · rintro ⟨u, hu, rfl⟩
            refine ⟨u.2, ?_⟩
            rw [Set.mem_setOf_eq] at hu
            simpa only [Subgroup.smul_def, MulAction.orbitRel.Quotient.orbit.coe_smul] using
              congrArg Subtype.val hu
          · rintro ⟨hb, hxb⟩
            refine ⟨⟨b, hb⟩, ?_, rfl⟩
            rw [Set.mem_setOf_eq]
            exact Subtype.ext (by
              simpa only [Subgroup.smul_def, MulAction.orbitRel.Quotient.orbit.coe_smul] using hxb)
        rw [hset] at hmap
        exact ⟨m, _, _, hmap⟩
      have hdisj : ∀ i j : MulAction.orbitRel.Quotient M O, i ≠ j →
          Disjoint {b : O | b ∈ i.orbit ∧ x • b = b} {b : O | b ∈ j.orbit ∧ x • b = b} := by
        rintro i j hij
        refine Set.disjoint_left.mpr fun b hbi hbj => hij ?_
        rw [Set.mem_setOf_eq] at hbi hbj
        obtain ⟨hbi, -⟩ := hbi
        obtain ⟨hbj, -⟩ := hbj
        rw [MulAction.orbitRel.Quotient.mem_orbit] at hbi hbj
        exact hbi.symm.trans hbj
      obtain ⟨m, e, y, hdec⟩ :=
        BlockDecomp_iUnion (p := p) (x := x) (Fintype.card (MulAction.orbitRel.Quotient M O))
          (MulAction.orbitRel.Quotient M O) rfl
          (fun j => {b : O | b ∈ j.orbit ∧ x • b = b}) hdisj hpiece
      have hUnion : (⋃ j : MulAction.orbitRel.Quotient M O,
          {b : O | b ∈ j.orbit ∧ x • b = b}) = {a : O | x • a = a} := by
        ext a
        rw [Set.mem_iUnion]
        constructor
        · rintro ⟨j, _, ha⟩
          exact ha
        · intro ha
          exact ⟨Quotient.mk'' a, by rw [MulAction.orbitRel.Quotient.mem_orbit], ha⟩
      rw [hUnion] at hdec
      exact ⟨m, e, y, hdec⟩
    · -- no fixed point: empty decomposition
      refine ⟨0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro i; exact Fin.elim0 i
      · intro i; exact Fin.elim0 i
      · intro i; exact Fin.elim0 i
      · intro i; exact Fin.elim0 i
      · intro a ha
        exact (hΩ ⟨a, ha⟩).elim
      · intro i; exact Fin.elim0 i

theorem rsf_block_decomposition {p : ℕ} {Q α : Type*} [Group Q] [Finite Q] [MulAction Q α]
    [Finite α] (hp : p.Prime) (hQ : IsPGroup p Q) (x : Q) (base : α)
    (hbase : ∀ q : Q, q • base = base)
    (huniq : ∀ a : α, (∀ q : Q, q • a = a) → a = base) :
    ∃ (ι : Type) (_ : Fintype ι) (e : ι → ZMod p → α) (y : ι → Q),
      (∀ i, Function.Injective (e i)) ∧
      (∀ i k, y i • e i k = e i (k + 1)) ∧
      (∀ i k, (y i) ^ p • e i k = e i k) ∧
      (∀ i k, x • e i k = e i k) ∧
      (∀ a : α, (x • a = a ∧ a ≠ base) ↔ ∃ i k, e i k = a) ∧
      (∀ i k j l, e i k = e j l → i = j ∧ k = l) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  -- the complement of `base` is `Q`-invariant
  have hS : ∀ (q : Q) {a : α}, a ≠ base → q • a ≠ base := by
    intro q a ha h
    have h1 := congrArg (fun b => q⁻¹ • b) h
    simp only [← mul_smul, inv_mul_cancel, one_smul, hbase] at h1
    exact ha h1
  let S : SubMulAction Q α := ⟨{a : α | a ≠ base}, fun q a ha => hS q ha⟩
  haveI : Fintype ↥S := Fintype.ofFinite _
  haveI : Fintype (MulAction.orbitRel.Quotient Q ↥S) := Fintype.ofFinite _
  -- every `Q`-orbit of `S` has cardinality divisible by `p`
  have horbit : ∀ j : MulAction.orbitRel.Quotient Q ↥S, p ∣ Nat.card ↥(j.orbit) := by
    intro j
    rw [MulAction.orbitRel.Quotient.orbit_eq_orbit_out j Quotient.out_eq']
    have hne1 : Nat.card (MulAction.orbit Q (Quotient.out j)) ≠ 1 := by
      intro h1
      haveI : Subsingleton ↥(MulAction.orbit Q (Quotient.out j)) :=
        (Nat.card_eq_one_iff_unique.mp h1).1
      have hfix : ∀ q : Q, q • (Quotient.out j : ↥S) = Quotient.out j := by
        intro q
        have hmem : (⟨q • (Quotient.out j), MulAction.mem_orbit_iff.mpr ⟨q, rfl⟩⟩ :
            ↥(MulAction.orbit Q (Quotient.out j))) =
            ⟨Quotient.out j, MulAction.mem_orbit_self (Quotient.out j)⟩ := Subsingleton.elim _ _
        exact congrArg Subtype.val hmem
      exact (Quotient.out j).2 (huniq ((Quotient.out j : ↥S) : α) fun q => by
        simpa only [SubMulAction.val_smul] using congrArg Subtype.val (hfix q))
    obtain ⟨k, hk⟩ := hQ.card_orbit (Quotient.out j)
    rcases Nat.eq_zero_or_pos k with hk0 | hkpos
    · rw [hk0, pow_zero] at hk
      exact absurd hk hne1
    · rw [hk]
      exact dvd_pow_self p (Nat.one_le_iff_ne_zero.mp hkpos)
  -- each orbit carries a block decomposition
  have hpiece : ∀ j : MulAction.orbitRel.Quotient Q ↥S,
      ∃ (m : ℕ) (e : Fin m → ZMod p → α) (y : Fin m → Q),
        IsBlockDecomp p x ((fun u : ↥(j.orbit) => ((u : ↥S) : α)) ''
          {u : ↥(j.orbit) | x • u = u}) m e y := by
    intro j
    obtain ⟨m, e, y, hdec⟩ := exists_isBlockDecomp_of_isPretransitive hp (Nat.card Q) Q rfl hQ
      ↥(j.orbit) (inferInstance : MulAction.IsPretransitive Q ↥(j.orbit)) (horbit j) x
    have hmap : IsBlockDecomp p x
        ((fun u : ↥(j.orbit) => ((u : ↥S) : α)) '' {u : ↥(j.orbit) | x • u = u}) m
        (fun i k => (((e i k : ↥(j.orbit)) : ↥S) : α))
        (fun i => y i) :=
      hdec.map (f := fun u : ↥(j.orbit) => ((u : ↥S) : α)) (MonoidHom.id Q)
        (fun a b h => Subtype.ext (Subtype.ext h)) fun g a => rfl
    exact ⟨m, _, _, hmap⟩
  -- the pieces are pairwise disjoint
  have hdisj : ∀ i j : MulAction.orbitRel.Quotient Q ↥S, i ≠ j →
      Disjoint ((fun u : ↥(i.orbit) => ((u : ↥S) : α)) '' {u : ↥(i.orbit) | x • u = u})
        ((fun u : ↥(j.orbit) => ((u : ↥S) : α)) '' {u : ↥(j.orbit) | x • u = u}) := by
    rintro i j hij
    refine Set.disjoint_left.mpr fun a ⟨u, _, hu⟩ ⟨v, _, hv⟩ => hij ?_
    have huv : (u : ↥S) = (v : ↥S) := Subtype.ext (hu.trans hv.symm)
    have h1 := MulAction.orbitRel.Quotient.mem_orbit.mp u.2
    have h2 := MulAction.orbitRel.Quotient.mem_orbit.mp v.2
    rw [← huv] at h2
    exact h1.symm.trans h2
  obtain ⟨m, e, y, hdec⟩ :=
    BlockDecomp_iUnion (p := p) (x := x) (Fintype.card (MulAction.orbitRel.Quotient Q ↥S))
      (MulAction.orbitRel.Quotient Q ↥S) rfl
      (fun j => (fun u : ↥(j.orbit) => ((u : ↥S) : α)) '' {u : ↥(j.orbit) | x • u = u})
      hdisj hpiece
  have hUnion : (⋃ j : MulAction.orbitRel.Quotient Q ↥S,
      (fun u : ↥(j.orbit) => ((u : ↥S) : α)) '' {u : ↥(j.orbit) | x • u = u}) =
      {a : α | x • a = a ∧ a ≠ base} := by
    ext a
    rw [Set.mem_iUnion]
    constructor
    · rintro ⟨j, u, hu, rfl⟩
      exact ⟨by
        have h1 := congrArg Subtype.val hu
        rw [MulAction.orbitRel.Quotient.orbit.coe_smul] at h1
        simpa only [SubMulAction.val_smul] using congrArg Subtype.val h1, (u : ↥S).2⟩
    · rintro ⟨hxa, hane⟩
      refine ⟨Quotient.mk'' ⟨a, hane⟩, ⟨⟨a, hane⟩, ?_⟩, ?_, rfl⟩
      · rw [MulAction.orbitRel.Quotient.orbit_mk]
        exact MulAction.mem_orbit_self _
      · exact Subtype.ext (by
          rw [MulAction.orbitRel.Quotient.orbit.coe_smul]
          exact Subtype.ext (by simpa only [SubMulAction.val_smul] using hxa))
  rw [hUnion] at hdec
  refine ⟨Fin m, inferInstance, e, y, hdec.injective, hdec.shift, hdec.pow_fix, ?_, ?_, hdec.eq_iff⟩
  · intro i k
    exact (hdec.mem i k).1
  · intro a
    constructor
    · rintro ⟨hxa, hane⟩
      exact hdec.exists_of_mem a ⟨hxa, hane⟩
    · rintro ⟨i, k, hik⟩
      rw [← hik]
      exact hdec.mem i k

end Work.LocalPrelim
