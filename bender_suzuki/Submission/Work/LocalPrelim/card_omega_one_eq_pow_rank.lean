/-!
# The order of `Ω₁(A)` for a finite abelian `p`-group `A`

Feit–Thompson 1963, local preliminaries: if `A` is a finite abelian `p`-group then the subgroup
`Ω₁(A)` generated by the elements of order dividing `p` is elementary abelian, and its order is
`p ^ d(A)` where `d(A) = Group.rank A` is the minimal number of generators of `A`.

Indeed `A` is a direct sum of cyclic `p`-groups, `d(A)` is the number of summands, and `Ω₁(A)`
is the direct sum of the `p`-torsion subgroups of the summands, i.e. the elementary abelian
`𝔽_p`-vector space of the same dimension `d(A)`; hence `|Ω₁(A)| = p ^ d(A)`.  The proof below
avoids the classification: `Ω₁(A)` is elementary abelian, so
`|Ω₁(A)| = p ^ Module.finrank (𝔽_p) Ω₁(A) = p ^ Group.rank Ω₁(A)` (the rank of an elementary
abelian `p`-group is the dimension of the corresponding `𝔽_p`-vector space), and
`Group.rank Ω₁(A) = Group.rank A` (`Work.LocalPrelim.rank_omega_eq_rank`).
-/

set_option linter.style.haveILetI false

open scoped IsMulCommutative

namespace Work.LocalPrelim

/-- For a finite elementary abelian `p`-subgroup `E` the order is `p ^ Group.rank E`: an
elementary abelian `p`-group of order `p ^ n` is an `n`-dimensional `𝔽_p`-vector space, and `n`
is both its `p`-logarithm and its minimal number of generators. -/
theorem card_eq_pow_rank_of_isElementaryAbelian {G : Type*} [Group G] {p : ℕ} (hp : p.Prime)
    (E : Subgroup G) [Finite E] (hE : Work.PGroup.IsElementaryAbelian p E) :
    Nat.card ↥E = p ^ Group.rank ↥E := by
  classical
  haveI : IsMulCommutative ↥E := hE.comm
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Nonempty ↥E := ⟨⟨1, E.one_mem⟩⟩
  -- `E` is an `𝔽_p`-vector space.
  haveI hmod : Module (ZMod p) (Additive ↥E) := AddCommGroup.zmodModule (fun x => by
    refine Additive.ext ?_
    rw [toMul_nsmul, toMul_zero]
    exact hE.pow_eq_one x.toMul)
  haveI : Module.Finite (ZMod p) (Additive ↥E) := Module.Finite.of_finite
  -- The order is `p` to the dimension.
  have hcard : Nat.card ↥E = p ^ Module.finrank (ZMod p) (Additive ↥E) := by
    rw [Nat.card_congr (Additive.ofMul (α := ↥E)),
      Module.natCard_eq_pow_finrank (K := ZMod p) (V := Additive ↥E), Nat.card_zmod]
  -- and the dimension is the minimal number of generators.
  have hrank : Group.rank ↥E = Module.finrank (ZMod p) (Additive ↥E) := by
    rw [Work.PGroup.rank_eq_log_card_of_isElementaryAbelian (G := G) hp E hE, hcard,
      Nat.log_pow hp.one_lt]
  rw [hcard, ← hrank]

theorem card_omega_one_eq_pow_rank {X : Type*} [Group X] [Finite X] {p : ℕ} (hp : p.Prime)
    {A : Subgroup X} (hA : IsMulCommutative ↥A) (hAp : IsPGroup p A) :
    Nat.card ↥(Work.PGroup.omega p 1 A) = p ^ Group.rank A := by
  classical
  haveI : Finite ↥A := Subtype.finite
  haveI : Finite ↥(Work.PGroup.omega p 1 A) := Subtype.finite
  -- `Ω₁(A)` is elementary abelian: it is commutative (as a subgroup of the commutative `A`)
  -- and of exponent `p` (by construction).
  have hΩel : Work.PGroup.IsElementaryAbelian p (Work.PGroup.omega p 1 A) := by
    refine ⟨?_, ?_⟩
    · rw [Work.PGroup.omega_one_eq_omega1]
      exact Work.PGroup.omega1_isMulCommutative hA
    · intro x
      have hx : (x : X) ∈ Work.PGroup.omega1 X p A := by
        rw [← Work.PGroup.omega_one_eq_omega1]
        exact x.2
      refine Subtype.ext ?_
      simpa using Work.PGroup.omega1_pow_eq_one hA hx
  rw [card_eq_pow_rank_of_isElementaryAbelian hp (Work.PGroup.omega p 1 A) hΩel,
    rank_omega_eq_rank hp hA hAp]

end Work.LocalPrelim
