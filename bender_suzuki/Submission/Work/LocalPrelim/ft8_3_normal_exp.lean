/-! ### Auxiliary lemmas for `ft8_3_normal_exp` -/

/-- For odd `p`, `p.choose 2` is a multiple of `p`. -/
lemma exists_choose_two_eq_mul {p : ℕ} (hp : Odd p) : ∃ m, p.choose 2 = p * m := by
  obtain ⟨k, hk⟩ := hp
  refine ⟨k, ?_⟩
  subst hk
  rw [Nat.choose_two_right]
  rw [show (2 * k + 1) - 1 = 2 * k by omega]
  rw [show (2 * k + 1) * (2 * k) / 2 = (2 * k + 1) * k by
    rw [Nat.mul_div_assoc (2 * k + 1) (show 2 ∣ 2*k from ⟨k, by ring⟩)]
    rw [show (2*k : ℕ) / 2 = k from Nat.mul_div_right k (by norm_num)]]

/-- If `d` commutes with `a` and `b`, it commutes with `⁅a,b⁆`. -/
lemma Commute.commutatorElement' {G : Type*} [Group G] {a b d : G}
    (ha : Commute a d) (hb : Commute b d) : Commute ⁅a, b⁆ d := by
  rw [commutatorElement_def, commute_iff_eq]
  conv_lhs =>
    rw [show a * b * a⁻¹ * b⁻¹ * d = a * b * a⁻¹ * (b⁻¹ * d) from by group]
    rw [hb.inv_left.eq]
    rw [show a * b * a⁻¹ * (d * b⁻¹) = a * b * (a⁻¹ * d) * b⁻¹ from by group]
    rw [ha.inv_left.eq]
    rw [show a * b * (d * a⁻¹) * b⁻¹ = a * (b * d) * a⁻¹ * b⁻¹ from by group]
    rw [hb.eq]
    rw [show a * (d * b) * a⁻¹ * b⁻¹ = a * d * b * a⁻¹ * b⁻¹ from by group]
    rw [ha.eq]
  group

/-- A nilpotent class-two group generated by elements of order dividing an odd prime `p` has
exponent `p`: if `H = ⟨S⟩`, every `s ∈ S` satisfies `s ^ p = 1`, and `⁅H,H⁆` is centralised by
`H`, then every element of `H` has `p`-th power `1`. -/
theorem pow_eq_one_of_class_two {G : Type*} [Group G] {p : ℕ} (hpodd : Odd p)
    {H : Subgroup G} (hcen : ⁅H, H⁆ ≤ Subgroup.centralizer (H : Set G)) {S : Set G}
    (hS : ∀ s ∈ S, s ^ p = 1) (hgen : H = Subgroup.closure S) :
    ∀ g ∈ H, g ^ p = 1 := by
  obtain ⟨m, hm⟩ := exists_choose_two_eq_mul hpodd
  have key : ∀ g ∈ Subgroup.closure S, g ^ p = 1 := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem s hs => exact hS s hs
    | one => simp
    | mul a b ha hb iha ihb =>
        have haH : a ∈ H := by rw [hgen]; exact ha
        have hbH : b ∈ H := by rw [hgen]; exact hb
        have hmem : ⁅b, a⁆ ∈ Subgroup.centralizer (H : Set G) :=
          hcen (Subgroup.commutator_mem_commutator hbH haH)
        have hcb : ∀ z ∈ H, Commute z ⁅b, a⁆ := fun z hz =>
          (commute_iff_eq z ⁅b, a⁆).mpr ((Subgroup.mem_centralizer_iff.mp hmem) z hz)
        have hcpa : ⁅b, a⁆ ^ p = 1 := by
          rw [(hcb b hbH).commutatorElement_pow_left p, ihb, commutatorElement_one_left]
        rw [mul_pow_eq_pow_mul_pow_mul_commutator_pow (hcb a haH) (hcb b hbH) p,
          iha, ihb, hm, pow_mul, hcpa]
        simp
    | inv a ha iha => rw [inv_pow, iha, inv_one]
  intro g hg
  rw [hgen] at hg
  exact key g hg

/-- Commutator/power identity in a group of nilpotency class at most three: if `d = ⁅⁅x,y⁆,x⁆`
commutes with `x` and `y`, then `⁅x^n, y⁆ * d ^ (n.choose 2) = ⁅x, y⁆ ^ n`. -/
theorem commutator_pow_eq {G : Type*} [Group G] {x y : G}
    (hxd : Commute x ⁅⁅x, y⁆, x⁆) (hyd : Commute y ⁅⁅x, y⁆, x⁆) (n : ℕ) :
    ⁅x ^ n, y⁆ * ⁅⁅x, y⁆, x⁆ ^ n.choose 2 = ⁅x, y⁆ ^ n := by
  have hcd : Commute ⁅x, y⁆ ⁅⁅x, y⁆, x⁆ := Commute.commutatorElement' hxd hyd
  have hxd' : ∀ m, Commute ⁅x ^ m, y⁆ ⁅⁅x, y⁆, x⁆ := fun m =>
    Commute.commutatorElement' (hxd.pow_left m) hyd
  have hconj : ∀ {a X : G}, Commute a X → a⁻¹ * X * a = X := by
    intro a X h
    rw [mul_assoc, ← h.eq, ← mul_assoc, inv_mul_cancel, one_mul]
  induction n with
  | zero => simp
  | succ n ih =>
    have hcxA : x * ⁅x ^ n, y⁆ * x⁻¹ = ⁅x, ⁅x ^ n, y⁆⁆ * ⁅x ^ n, y⁆ := by
      rw [commutatorElement_def]; group
    have hA : ⁅⁅x ^ n, y⁆, x⁆ = ⁅⁅x, y⁆, x⁆ ^ n := by
      have hB1 : ⁅⁅⁅x, y⁆, x⁆ ^ n.choose 2, x⁆ = 1 := by
        rw [commutatorElement_eq_one_iff_mul_comm]
        exact ((hxd.pow_right (n.choose 2)).eq).symm
      have h2 : ⁅⁅x ^ n, y⁆ * ⁅⁅x, y⁆, x⁆ ^ n.choose 2, x⁆ = ⁅⁅x, y⁆, x⁆ ^ n := by
        rw [ih, ← (hcd).commutatorElement_pow_left n]
      rw [commutatorElement_mul_left_eq_conj_mul, hB1] at h2
      simp only [mul_one, mul_inv_cancel, one_mul] at h2
      exact h2
    have hB : ⁅x ^ (n + 1), y⁆ * ⁅⁅x, y⁆, x⁆ ^ n = ⁅x ^ n, y⁆ * ⁅x, y⁆ := by
      have hY : Commute (⁅⁅x, y⁆, x⁆ ^ n) (⁅x ^ n, y⁆ * ⁅x, y⁆) :=
        ((hxd' n).symm.pow_left n).mul_right (hcd.symm.pow_left n)
      rw [show x ^ (n + 1) = x * x ^ n by rw [pow_succ'],
        commutatorElement_mul_left_eq_conj_mul,
        hcxA, (commutatorElement_inv (g₁ := ⁅x ^ n, y⁆) (g₂ := x)).symm, hA]
      rw [show (⁅⁅x, y⁆, x⁆ ^ n)⁻¹ * ⁅x ^ n, y⁆ * ⁅x, y⁆ * ⁅⁅x, y⁆, x⁆ ^ n
          = (⁅⁅x, y⁆, x⁆ ^ n)⁻¹ * (⁅x ^ n, y⁆ * ⁅x, y⁆) * ⁅⁅x, y⁆, x⁆ ^ n from by group]
      exact hconj hY
    have hcc : Commute (⁅⁅x, y⁆, x⁆ ^ n.choose 2) ⁅x, y⁆ := (hcd.pow_right (n.choose 2)).symm
    have hmain : ⁅x, y⁆ ^ (n + 1) =
        ⁅x ^ (n + 1), y⁆ * ⁅⁅x, y⁆, x⁆ ^ (n + n.choose 2) := by
      rw [pow_succ, ← ih, mul_assoc, hcc.eq, ← mul_assoc, ← hB, mul_assoc, ← pow_add]
    rw [show (n + 1).choose 2 = n + n.choose 2 from by
      rw [Nat.choose_succ_succ, Nat.choose_one_right], hmain]

/-- If `x ^ p = 1` and both `x` and `y` commute with `d = ⁅⁅x,y⁆,x⁆`, and `d ^ p = 1`, then
`⁅x,y⁆ ^ p = 1`.  (Uses the fact that `⁅x,y⁆ ^ p ∈ γ₃` for `x` of order `p`.)  As a corollary of
`commutator_pow_eq` we get the slightly more general form where only `⁅x^p, y⁆ = 1` is assumed. -/
theorem commutator_pow_eq_one {G : Type*} [Group G] {p : ℕ} (hpodd : Odd p) {x y : G}
    (hxd : Commute x ⁅⁅x, y⁆, x⁆) (hyd : Commute y ⁅⁅x, y⁆, x⁆)
    (hxp : ⁅x ^ p, y⁆ = 1) (hdp : ⁅⁅x, y⁆, x⁆ ^ p = 1) : ⁅x, y⁆ ^ p = 1 := by
  obtain ⟨m, hm⟩ := exists_choose_two_eq_mul hpodd
  have h := commutator_pow_eq hxd hyd p
  rw [hxp, one_mul, hm] at h
  rw [← h, pow_mul, hdp, one_pow]

/-- If `⁅x,y⁆ ∈ N` for a normal subgroup `N`, then also `⁅x⁻¹,y⁻¹⁆ ∈ N`. -/
lemma commutatorElement_inv_inv_mem {G : Type*} [Group G] {N : Subgroup G} (hN : N.Normal)
    {x y : G} (h : ⁅x, y⁆ ∈ N) : ⁅x⁻¹, y⁻¹⁆ ∈ N := by
  have h' : x * y * x⁻¹ * y⁻¹ ∈ N := by simpa [commutatorElement_def] using h
  have h1 : x⁻¹ * (x * y * x⁻¹ * y⁻¹) * x ∈ N := by simpa using hN.conj_mem _ h' x⁻¹
  have h2 : y⁻¹ * (x⁻¹ * (x * y * x⁻¹ * y⁻¹) * x) * y ∈ N := by
    simpa using hN.conj_mem _ h1 y⁻¹
  rw [show ⁅x⁻¹, y⁻¹⁆ = y⁻¹ * (x⁻¹ * (x * y * x⁻¹ * y⁻¹) * x) * y from by
    rw [commutatorElement_def]; group]
  exact h2

/-- **Feit–Thompson 8.3, exponent-`p` step.**

Let `X` be a finite `p`-group (`p` odd), `A₀ ≤ D` normal subgroups of `X` with `D ≠ A₀`, `A₀` of
exponent `p`, `D` generated by its elements of order `p`, `⁅⁅D,D⁆,D⁆ ≤ A₀` and `A₀` central in `D`.
Then there is a normal subgroup `N` of `X` with `A₀ ≤ N ≤ D`, `N ≠ A₀` and `N` of exponent `p`. -/
theorem ft8_3_normal_exp {X : Type*} [Group X] [Finite X] {p : ℕ} (hp : p.Prime) (hpodd : Odd p)
    (hX : IsPGroup p X) {A0 D : Subgroup X} [hA0n : A0.Normal] [hDn : D.Normal]
    (hA0exp : ∀ a ∈ A0, a ^ p = 1) (hA0leD : A0 ≤ D) (hDne : D ≠ A0)
    (hgen : D = Subgroup.closure {y : X | y ∈ D ∧ y ^ p = 1})
    (hgamma3 : ⁅⁅D, D⁆, D⁆ ≤ A0) (hcent : ∀ d ∈ D, ∀ a ∈ A0, a * d = d * a) :
    ∃ N : Subgroup X, N ≤ D ∧ N.Normal ∧ A0 ≤ N ∧ N ≠ A0 ∧ (∀ n ∈ N, n ^ p = 1) := by
  classical
  have hA0cent : A0 ≤ Subgroup.centralizer (D : Set X) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro d hd
    exact (hcent d hd a ha).symm
  have hcentA0 : ∀ a ∈ A0, ∀ d ∈ D, a * d = d * a := fun a ha d hd => hcent d hd a ha
  -- ## Step 1 : `D ^ p ≤ A₀` (via the quotient `D / A₀`, which is class two).
  have hDpow : ∀ x ∈ D, x ^ p ∈ A0 := by
    let N0 : Subgroup ↥D := A0.subgroupOf D
    haveI hN0n : N0.Normal := hA0n.subgroupOf D
    have hgenD : (⊤ : Subgroup ↥D) = Subgroup.closure {w : ↥D | w ^ p = 1} := by
      refine Subgroup.map_injective (Subgroup.subtype_injective D) ?_
      rw [Subgroup.map_top, Subgroup.range_subtype, MonoidHom.map_closure]
      have hspec : ((Subgroup.subtype D) '' {w : ↥D | w ^ p = 1})
          = {y : X | y ∈ D ∧ y ^ p = 1} := by
        ext z
        constructor
        · rintro ⟨w, hw, rfl⟩
          refine ⟨w.2, ?_⟩
          have hsub : (Subgroup.subtype D) (w ^ p) = (Subgroup.subtype D) w ^ p := map_pow _ w p
          rw [← hsub, hw, map_one]
        · rintro ⟨hzD, hzp⟩
          exact ⟨⟨z, hzD⟩, Subtype.ext (by rw [Subgroup.coe_pow, Subgroup.coe_one]; exact hzp), rfl⟩
      rw [hspec, ← hgen]
    have hmaptop : (⊤ : Subgroup ↥D).map (QuotientGroup.mk' N0) = ⊤ := by
      rw [Subgroup.map_top, MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective N0)]
    have hQgen : (⊤ : Subgroup (↥D ⧸ N0)) = Subgroup.closure {z : ↥D ⧸ N0 | z ^ p = 1} := by
      refine le_antisymm ?_ le_top
      have haux : (⊤ : Subgroup ↥D).map (QuotientGroup.mk' N0) ≤
          Subgroup.closure {z : ↥D ⧸ N0 | z ^ p = 1} := by
        rw [hgenD, MonoidHom.map_closure]
        apply Subgroup.closure_mono
        rintro z ⟨w, hw, rfl⟩
        simp only [Set.mem_setOf_eq] at hw ⊢
        rw [← map_pow, hw, map_one]
      rwa [hmaptop] at haux
    have hQclass : ⁅(⊤ : Subgroup (↥D ⧸ N0)), (⊤ : Subgroup (↥D ⧸ N0))⁆ ≤
        Subgroup.centralizer (((⊤ : Subgroup (↥D ⧸ N0))) : Set (↥D ⧸ N0)) := by
      have h3 : ⁅⁅(⊤ : Subgroup (↥D ⧸ N0)), (⊤ : Subgroup (↥D ⧸ N0))⁆,
          (⊤ : Subgroup (↥D ⧸ N0))⁆ = ⊥ := by
        rw [Subgroup.commutator_eq_bot_iff_le_centralizer, Subgroup.commutator_le]
        intro x _ y _
        rw [Subgroup.mem_centralizer_iff]
        intro z _
        obtain ⟨x', rfl⟩ := QuotientGroup.mk'_surjective N0 x
        obtain ⟨y', rfl⟩ := QuotientGroup.mk'_surjective N0 y
        obtain ⟨z', rfl⟩ := QuotientGroup.mk'_surjective N0 z
        have hmem : ⁅⁅x', y'⁆, z'⁆ ∈ N0 := by
          rw [Subgroup.mem_subgroupOf]
          show ((Subgroup.subtype D) ⁅⁅x', y'⁆, z'⁆) ∈ A0
          rw [map_commutatorElement, map_commutatorElement]
          exact hgamma3 (Subgroup.commutator_mem_commutator
            (Subgroup.commutator_mem_commutator x'.2 y'.2) z'.2)
        rw [← map_commutatorElement (QuotientGroup.mk' N0) x' y',
          ← map_mul, ← map_mul,
          show (QuotientGroup.mk' N0) (z' * ⁅x', y'⁆) = (QuotientGroup.mk' N0) (⁅x', y'⁆ * z')
            ↔ (z' * ⁅x', y'⁆)⁻¹ * (⁅x', y'⁆ * z') ∈ N0 from QuotientGroup.eq]
        rw [show (z' * ⁅x', y'⁆)⁻¹ * (⁅x', y'⁆ * z') = ⁅(⁅x', y'⁆)⁻¹, z'⁻¹⁆ from by
          rw [commutatorElement_def]; group]
        exact commutatorElement_inv_inv_mem hN0n hmem
      intro x hx
      rw [Subgroup.mem_centralizer_iff]
      intro z _
      exact Subgroup.mem_center_iff.mp
        ((Subgroup.commutator_top_right_eq_bot_iff_le_center.mp h3) hx) z
    have hQexp : ∀ z : ↥D ⧸ N0, z ^ p = 1 := fun z =>
      pow_eq_one_of_class_two hpodd hQclass (fun s hs => hs) hQgen z (Subgroup.mem_top z)
    intro x hx
    have h := hQexp (QuotientGroup.mk' N0 ⟨x, hx⟩)
    have h2 : (QuotientGroup.mk' N0) (⟨x, hx⟩ ^ p) = 1 := by rw [map_pow]; exact h
    have hker : (⟨x, hx⟩ : ↥D) ^ p ∈ (QuotientGroup.mk' N0).ker := MonoidHom.mem_ker.mpr h2
    rw [QuotientGroup.ker_mk'] at hker
    rw [Subgroup.mem_subgroupOf] at hker
    simpa using hker
  -- ## Step 2/3 : case analysis.
  by_cases hcase : ⁅D, D⁆ ≤ A0
  · -- `D' ≤ A₀`: then `D` is of class two and generated by its order-`p` elements, so `D ^ p = 1`.
    refine ⟨D, le_rfl, hDn, hA0leD, hDne, ?_⟩
    have hcen : ⁅D, D⁆ ≤ Subgroup.centralizer (D : Set X) := hcase.trans hA0cent
    exact pow_eq_one_of_class_two hpodd hcen (fun s hs => hs.2) hgen
  · -- `D' ⊄ A₀`: take `N = A₀ ⊔ D'`.
    have hD'exp : ∀ c ∈ ⁅D, D⁆, c ^ p = 1 := by
      refine pow_eq_one_of_class_two hpodd ?_ ?_ (Subgroup.commutator_def D D)
      · intro z hz
        rw [Subgroup.mem_centralizer_iff]
        intro c hc
        have hzA0 : z ∈ A0 := hgamma3 ((Subgroup.commutator_mono le_rfl
          (Subgroup.commutator_le_left D D)) hz)
        exact (Subgroup.mem_centralizer_iff.mp (hA0cent hzA0)) c
          (Subgroup.commutator_le_left D D hc)
      · intro s hs
        obtain ⟨g₁, hg₁, g₂, hg₂, rfl⟩ := hs
        have hdA0 : ⁅⁅g₁, g₂⁆, g₁⁆ ∈ A0 := hgamma3 (Subgroup.commutator_mem_commutator
          (Subgroup.commutator_mem_commutator hg₁ hg₂) hg₁)
        refine commutator_pow_eq_one hpodd ?_ ?_ ?_ ?_
        · exact (commute_iff_eq g₁ ⁅⁅g₁, g₂⁆, g₁⁆).mpr
            (hcentA0 ⁅⁅g₁, g₂⁆, g₁⁆ hdA0 g₁ hg₁).symm
        · exact (commute_iff_eq g₂ ⁅⁅g₁, g₂⁆, g₁⁆).mpr
            (hcentA0 ⁅⁅g₁, g₂⁆, g₁⁆ hdA0 g₂ hg₂).symm
        · exact commutatorElement_eq_one_iff_mul_comm.mpr
            (hcentA0 (g₁ ^ p) (hDpow g₁ hg₁) g₂ hg₂)
        · exact hA0exp ⁅⁅g₁, g₂⁆, g₁⁆ hdA0
    refine ⟨A0 ⊔ ⁅D, D⁆, ?_, ?_, le_sup_left, ?_, ?_⟩
    · exact sup_le hA0leD (Subgroup.commutator_le_left D D)
    · infer_instance
    · intro h
      exact hcase (le_of_le_of_eq le_sup_right h)
    · intro n hn
      have hn' : n ∈ (↑(A0 ⊔ ⁅D, D⁆) : Set X) := hn
      rw [Subgroup.normal_mul A0 ⁅D, D⁆, Set.mem_mul] at hn'
      obtain ⟨a, ha, c, hc, rfl⟩ := hn'
      have hac : Commute a c :=
        (commute_iff_eq a c).mpr (hcentA0 a ha c (Subgroup.commutator_le_left D D hc))
      rw [hac.mul_pow p, hA0exp a ha, hD'exp c hc, one_mul]

end Work.LocalPrelim
