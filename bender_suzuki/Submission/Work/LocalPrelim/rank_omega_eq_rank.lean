/-!
# `m(Ω₁(A)) = m(A)` for an abelian finite `p`-group `A`

For a finite abelian `p`-group `A` the minimal number of generators of `A` equals that of the
subgroup `Ω₁(A)` generated by the elements of order dividing `p`.  This is the elementary
abelian/Burnside form of the structure of a finite abelian `p`-group: `A` is a direct sum of
cyclic `p`-groups, and both `m(A)` and `m(Ω₁(A))` equal the number of summands.

The proof does not use the classification of finite abelian groups.  Writing `B := ↥A`,
`Ω := Ω₁(B) = ker(φ)` and `℧ := ℧¹(B) = range(φ)` for the `p`-th power map
`φ : B →* B, x ↦ x ^ p`, one has

* `Group.rank B = Group.rank (B ⧸ Φ(B))` (Burnside's basis theorem,
  `Work.PGroup.rank_eq_rank_quotient_frattini`);
* `Φ(B) = ℧` because `B` is commutative (`Work.PGroup.frattini_eq_powClosure_sup_commutator`);
* the quotient `B ⧸ Φ(B)` and `Ω` are elementary abelian, so their ranks are `log_p` of their
  orders (`Work.PGroup.rank_eq_log_card_of_isElementaryAbelian`);
* `|B ⧸ ℧| = |Ω|`: indeed `|B| = |B ⧸ ker φ| · |ker φ| = |range φ| · |ker φ|`
  (`QuotientGroup.quotientKerEquivRange`) while `|B| = |B ⧸ ℧| · |℧|`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open Subgroup

namespace Work.LocalPrelim

/-- For a finite `p`-group `H`, the Frattini quotient `H ⧸ Φ(H)` is elementary abelian: it is
commutative with exponent dividing `p`.  (Group-level form of
`Work.PGroup.frattini_quotient_elementary`.) -/
theorem frattini_quotient_elementary_of_group {H : Type*} [Group H] [Finite H] {p : ℕ}
    (hp : p.Prime) (hH : IsPGroup p H) :
    IsMulCommutative (H ⧸ frattini H) ∧ Monoid.exponent (H ⧸ frattini H) ∣ p := by
  constructor
  · exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr
      (Work.PGroup.commutator_le_frattini hp hH)
  · rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (frattini H) q
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact Work.PGroup.pow_mem_frattini hp hH x

/-- For a finite commutative `p`-group `B`, the subgroup `Ω₁(B)` generated by the elements of
order dividing `p` has the same minimal number of generators as `B`. -/
theorem rank_closure_pow_eq_rank {B : Type*} [Group B] [Finite B] {p : ℕ} (hp : p.Prime)
    (hBab : IsMulCommutative B) (hBp : IsPGroup p B) :
    Group.rank ↥(Subgroup.closure {x : B | x ^ p = 1}) = Group.rank B := by
  classical
  letI : CommGroup B := { ‹Group B› with mul_comm := fun a b => isMulCommutative_iff.mp hBab a b }
  set Ω : Subgroup B := Subgroup.closure {x : B | x ^ p = 1} with hΩdef
  -- the `p`-th power endomorphism of `B`
  let φ : B →* B :=
    { toFun := fun x => x ^ p, map_one' := one_pow p, map_mul' := fun a b => mul_pow a b p }
  have hφx : ∀ x : B, φ x = x ^ p := fun x => rfl
  have hker : φ.ker = Ω := by
    rw [hΩdef]
    refine (Subgroup.closure_eq_of_le φ.ker ?_ ?_).symm
    · intro x hx
      exact MonoidHom.mem_ker.mpr (by rw [hφx]; exact hx)
    · intro x hx
      exact Subgroup.subset_closure (by rw [MonoidHom.mem_ker, hφx] at hx; exact hx)
  have hrange : φ.range = Subgroup.closure (Set.range fun x : B => x ^ p) := by
    refine (Subgroup.closure_eq_of_le φ.range ?_ ?_).symm
    · rintro y ⟨x, rfl⟩
      exact MonoidHom.mem_range.mpr ⟨x, rfl⟩
    · rintro y ⟨x, rfl⟩
      exact Subgroup.subset_closure ⟨x, rfl⟩
  -- The Frattini subgroup is the subgroup of `p`-th powers.
  have hbot : ⁅(⊤ : Subgroup B), (⊤ : Subgroup B)⁆ = ⊥ := by
    rw [Subgroup.commutator_top_right_eq_bot_iff_le_center]
    exact le_of_eq (Subgroup.center_eq_top_iff.mpr hBab).symm
  have hfratt : frattini B = Subgroup.closure (Set.range fun x : B => x ^ p) := by
    rw [Work.PGroup.frattini_eq_powClosure_sup_commutator hp hBp, hbot, sup_bot_eq]
  -- Cardinality bookkeeping.
  have hcard_ker : Nat.card B = Nat.card φ.range * Nat.card φ.ker := by
    have h1 : Nat.card B = Nat.card (B ⧸ φ.ker) * Nat.card φ.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
    have h2 : Nat.card (B ⧸ φ.ker) = Nat.card φ.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
    rw [h1, h2]
  have hcard_fratt : Nat.card B
      = Nat.card (B ⧸ frattini B) * Nat.card (Subgroup.closure (Set.range fun x : B => x ^ p)) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (frattini B), hfratt]
  have hpos : 0 < Nat.card φ.range := Nat.card_pos
  have hfinal : Nat.card (B ⧸ frattini B) = Nat.card Ω := by
    have key : Nat.card (B ⧸ frattini B) * Nat.card φ.range
        = Nat.card φ.range * Nat.card Ω := by
      have h := hcard_fratt.symm.trans hcard_ker
      simpa only [hrange, hker] using h
    rw [Nat.mul_comm (Nat.card φ.range) (Nat.card Ω)] at key
    exact Nat.mul_right_cancel hpos key
  -- The two ranks.
  have hΩel : Work.PGroup.IsElementaryAbelian p Ω := by
    constructor
    · exact isMulCommutative_iff.mpr fun a b => Subtype.ext (mul_comm (a : B) (b : B))
    · intro x
      have hx : (x : B) ∈ φ.ker := by rw [hker]; exact x.2
      refine Subtype.ext ?_
      have h1 : φ (x : B) = 1 := MonoidHom.mem_ker.mp hx
      rwa [hφx] at h1
  have hrankΩ : Group.rank ↥Ω = Nat.log p (Nat.card ↥Ω) :=
    Work.PGroup.rank_eq_log_card_of_isElementaryAbelian (G := B) hp Ω hΩel
  have hQel : Work.PGroup.IsElementaryAbelian p (⊤ : Subgroup (B ⧸ frattini B)) := by
    obtain ⟨hcomm, hexp⟩ := frattini_quotient_elementary_of_group hp hBp
    constructor
    · exact isMulCommutative_iff.mpr
        fun a b => Subtype.ext (isMulCommutative_iff.mp hcomm (a : B ⧸ frattini B) (b : B ⧸ frattini B))
    · intro x
      refine Subtype.ext ?_
      exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp hexp (x : B ⧸ frattini B)
  have hQrank : Group.rank (B ⧸ frattini B) = Nat.log p (Nat.card (B ⧸ frattini B)) := by
    have h := Work.PGroup.rank_eq_log_card_of_isElementaryAbelian
      (G := B ⧸ frattini B) hp (⊤ : Subgroup (B ⧸ frattini B)) hQel
    rw [Group.rank_congr (Subgroup.topEquiv (G := B ⧸ frattini B)),
      Nat.card_congr (Subgroup.topEquiv (G := B ⧸ frattini B)).toEquiv] at h
    exact h
  calc Group.rank ↥Ω = Nat.log p (Nat.card ↥Ω) := hrankΩ
    _ = Nat.log p (Nat.card (B ⧸ frattini B)) := by rw [hfinal]
    _ = Group.rank (B ⧸ frattini B) := hQrank.symm
    _ = Group.rank B := (Work.PGroup.rank_eq_rank_quotient_frattini (H := B)).symm

theorem rank_omega_eq_rank {H : Type*} [Group H] [Finite H] {p : ℕ} (hp : p.Prime)
    {A : Subgroup H} (hAab : IsMulCommutative A) (hAp : IsPGroup p A) :
    Group.rank ↥(Work.PGroup.omega p 1 A) = Group.rank ↥A := by
  classical
  have hmap : Subgroup.map A.subtype (Subgroup.closure {x : ↥A | x ^ p = 1})
      = Work.PGroup.omega p 1 A := by
    have hset : A.subtype '' ({x : ↥A | x ^ p = 1} : Set ↥A)
        = ({x : H | x ∈ A ∧ x ^ p = 1} : Set H) := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact ⟨x.2, by simpa using congrArg (fun z : ↥A => (z : H)) hx⟩
      · rintro ⟨hyA, hyp⟩
        exact ⟨⟨y, hyA⟩, by ext; simpa using hyp, rfl⟩
    rw [Work.PGroup.omega_one_eq_omega1]
    unfold Work.PGroup.omega1
    rw [MonoidHom.map_closure, hset]
  have hrank : Group.rank ↥(Work.PGroup.omega p 1 A)
      = Group.rank ↥(Subgroup.closure {x : ↥A | x ^ p = 1}) := by
    rw [← hmap]
    exact (Group.rank_congr (Subgroup.equivMapOfInjective
      (Subgroup.closure {x : ↥A | x ^ p = 1}) A.subtype A.subtype_injective)).symm
  rw [hrank]
  exact rank_closure_pow_eq_rank hp hAab hAp

end Work.LocalPrelim
