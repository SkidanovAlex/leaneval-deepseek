/-!
# Rank of a subgroup of a finite commutative group

For a finite commutative group `B` and a subgroup `E ≤ B`, the minimum number of
generators of `E` is at most the minimum number of generators of `B`
(`Group.rank E ≤ Group.rank B`).

The mathematical content is the classical fact that a subgroup of a `d`-generated
abelian group is `d`-generated. The proof here is an induction on a generating
finset of `B`: writing `B = ⟨S'⟩ ⊔ ⟨a⟩` and using that a subgroup of a cyclic
group is cyclic, one shows that `E` is generated by `E ∩ ⟨S'⟩` together with a
single further element.
-/

set_option linter.style.haveILetI false

namespace Work.LocalPrelim

open Subgroup

/-- **Key step.** Let `C ≤ B` be a subgroup and `a ∈ B`. If a subgroup `E ≤ B`
satisfies `E ≤ C ⊔ ⟨a⟩`, then `E` is generated by `E ⊓ C` together with a single
further element `y ∈ E`: `E = (E ⊓ C) ⊔ ⟨y⟩`.

The reason is that `E / (E ⊓ C)` embeds into the cyclic group
`(C ⊔ ⟨a⟩)/C ≅ ⟨aC⟩`, hence is cyclic (a subgroup of a cyclic group is cyclic);
a generator of this quotient lifts to the required `y`. -/
theorem exists_generator_of_le_sup_zpowers {B : Type*} [CommGroup B]
    (C : Subgroup B) (a : B) (E : Subgroup B) (hE : E ≤ C ⊔ Subgroup.zpowers a) :
    ∃ y ∈ E, E = (E ⊓ C) ⊔ Subgroup.zpowers y := by
  classical
  let π : B →* B ⧸ C := QuotientGroup.mk' C
  have hker : π.ker = C := QuotientGroup.ker_mk' C
  let E' : Subgroup (B ⧸ C) := E.map π
  have hE'map : E' ≤ Subgroup.zpowers (π a) := by
    have h1 : E' ≤ (C ⊔ Subgroup.zpowers a).map π := Subgroup.map_mono hE
    rwa [Subgroup.map_sup, (Subgroup.map_eq_bot_iff C).mpr (by rw [hker]),
      MonoidHom.map_zpowers, bot_sup_eq] at h1
  haveI : IsCyclic ↥E' := Subgroup.isCyclic_of_le hE'map
  obtain ⟨z, hz⟩ := IsCyclic.exists_generator (α := ↥E')
  obtain ⟨y, hyE, hyz⟩ : ∃ y ∈ E, π y = (z : B ⧸ C) := by
    have hzmem : (z : B ⧸ C) ∈ E' := z.2
    rw [Subgroup.mem_map] at hzmem
    obtain ⟨x, hx, hxz⟩ := hzmem
    exact ⟨x, hx, hxz⟩
  refine ⟨y, hyE, le_antisymm ?_ ?_⟩
  · intro e he
    have hmem : (⟨π e, Subgroup.mem_map.mpr ⟨e, he, rfl⟩⟩ : ↥E') ∈ Subgroup.zpowers z :=
      hz _
    rw [Subgroup.mem_zpowers_iff] at hmem
    obtain ⟨n, hn⟩ := hmem
    have hπn : (z : B ⧸ C) ^ n = π e := by
      have h := congrArg (fun w : ↥E' => (w : B ⧸ C)) hn
      simpa using h
    have hyme : (π y) ^ n = π e := by rw [hyz]; exact hπn
    have hmem2 : y ^ n * e⁻¹ ∈ E ⊓ C := by
      rw [Subgroup.mem_inf]
      refine ⟨?_, ?_⟩
      · exact mul_mem (Subgroup.zpow_mem E hyE n) (Subgroup.inv_mem E he)
      · rw [← hker, MonoidHom.mem_ker, map_mul, map_inv, MonoidHom.map_zpow, hyme]
        simp
    have hmem3 : e * y ^ (-n) ∈ E ⊓ C := by
      have h := (E ⊓ C).inv_mem hmem2
      convert h using 1
      group
    refine Subgroup.mem_sup.mpr ⟨e * y ^ (-n), hmem3, y ^ n,
      Subgroup.mem_zpowers_iff.mpr ⟨n, rfl⟩, ?_⟩
    group
  · exact sup_le inf_le_left (Subgroup.zpowers_le.mpr hyE)

/-- **Induction.** If `S` is a finite set of elements of a commutative group `B`
that generates `B`, then every subgroup `E ≤ ⟨S⟩` can be generated by at most
`S.card` elements. -/
theorem exists_small_generating_finset {B : Type*} [CommGroup B] (S : Finset B) :
    ∀ E : Subgroup B, E ≤ Subgroup.closure (S : Set B) →
      ∃ T : Finset E, Subgroup.closure (T : Set E) = ⊤ ∧ T.card ≤ S.card := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    intro E hE
    rw [Finset.coe_empty, Subgroup.closure_empty] at hE
    rw [le_bot_iff] at hE
    subst hE
    exact ⟨∅, Subsingleton.elim _ _, by simp⟩
  | insert a S' ha ih =>
    intro E hE
    set C : Subgroup B := Subgroup.closure (S' : Set B)
    have hcl : Subgroup.closure ((insert a S' : Finset B) : Set B) = C ⊔ Subgroup.zpowers a := by
      rw [Finset.coe_insert, Set.insert_eq, Set.union_comm, Subgroup.closure_union,
        Subgroup.zpowers_eq_closure]
    rw [hcl] at hE
    obtain ⟨y, hyE, hEy⟩ := exists_generator_of_le_sup_zpowers C a E hE
    obtain ⟨T', hT'gen, hT'card⟩ := ih (E ⊓ C) inf_le_right
    let φ : ↥(E ⊓ C) →* ↥E := Subgroup.inclusion inf_le_left
    have hmapT' : Subgroup.closure ((T'.image φ : Finset ↥E) : Set ↥E) = φ.range := by
      rw [Finset.coe_image, ← MonoidHom.map_closure, hT'gen, Subgroup.map_top]
    refine ⟨insert ⟨y, hyE⟩ (T'.image φ), ?_, ?_⟩
    · rw [Finset.coe_insert, Set.insert_eq, Set.union_comm, Subgroup.closure_union, hmapT',
        ← Subgroup.zpowers_eq_closure]
      have htop : φ.range ⊔ Subgroup.zpowers ⟨y, hyE⟩ = ⊤ := by
        apply le_antisymm le_top
        intro g _
        have hg : (g : B) ∈ (E ⊓ C) ⊔ Subgroup.zpowers y := by
          rw [← hEy]; exact g.2
        rw [Subgroup.mem_sup] at hg
        obtain ⟨w, hw, k, hk, hwk⟩ := hg
        have hwE : w ∈ E := hw.1
        have hkE : k ∈ E := Subgroup.zpowers_le.mpr hyE hk
        obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hk
        refine Subgroup.mem_sup.mpr ⟨⟨w, hwE⟩, ?_, ⟨k, hkE⟩, ?_, ?_⟩
        · exact MonoidHom.mem_range.mpr ⟨⟨w, hw⟩, rfl⟩
        · rw [Subgroup.mem_zpowers_iff]
          exact ⟨n, by ext; simpa using hn⟩
        · ext
          simpa using hwk
      exact htop
    · calc (insert ⟨y, hyE⟩ (T'.image φ)).card ≤ (T'.image φ).card + 1 :=
            Finset.card_insert_le _ _
        _ ≤ T'.card + 1 := Nat.add_le_add_right Finset.card_image_le 1
        _ ≤ S'.card + 1 := Nat.add_le_add_right hT'card 1
        _ = (insert a S').card := (Finset.card_insert_of_notMem ha).symm

/-- The rank of a subgroup of a finite commutative group is at most the rank of
the group. -/
theorem rank_le_of_commutative_subgroup {B : Type*} [CommGroup B] [Finite B] (E : Subgroup B) :
    Group.rank E ≤ Group.rank B := by
  obtain ⟨S, hScard, hSgen⟩ := Group.rank_spec B
  have hE : E ≤ Subgroup.closure (S : Set B) := by rw [hSgen]; exact le_top
  obtain ⟨T, hTgen, hTcard⟩ := exists_small_generating_finset S E hE
  calc Group.rank E ≤ T.card := Group.rank_le hTgen
    _ ≤ S.card := hTcard
    _ = Group.rank B := hScard

end Work.LocalPrelim
