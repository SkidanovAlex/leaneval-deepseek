/-!
# `Work.AppXIDickson.L0.subring_eq_top_of_card`

A finite field has no proper subring of "more than half" its size.  Equivalently: if `S` is a
subring of a finite field `K` with `|K| + 1 ≤ 2 * |S|`, then `S = K`.

The argument is the standard one (Dickson/App. XI Prop. 2, "the ring is generated by the
action"):

* Every nonzero element of `S` is invertible *in* `S`: multiplication by it is an injective
  self-map of the finite set `↥S`, hence surjective, so it hits `1`
  (`subring_exists_mul_eq_one`).
* If `S ≠ ⊤`, pick `x ∉ S`.  Then `S × S → K`, `(a,b) ↦ a + b * x`, is injective: from
  `b₁ ≠ b₂` the identity `(b₁ - b₂) * x = a₂ - a₁` exhibits `x` as a quotient of elements of
  `S`, contradicting `x ∉ S`.  Hence `|S|² ≤ |K|` (`card_sq_le_of_ne_top`).
* Combining with `|K| ≤ 2|S| - 1` gives `|S|² < 2|S|`, i.e. `|S| < 2`, whereas `0 ≠ 1` in `S`
  forces `|S| ≥ 2`.  Contradiction.
-/

namespace Work.AppXIDickson.L0

/-- In a finite field `K`, a nonzero element `x` of a subring `S` has its inverse inside `S`:
multiplication by `x` is an injective self-map of the finite set `↥S`, hence surjective, so
some `y ∈ S` satisfies `x * y = 1`. -/
theorem subring_exists_mul_eq_one {K : Type} [Field K] [Fintype K] (S : Subring K)
    {x : K} (hx : x ∈ S) (hx0 : x ≠ 0) : ∃ y ∈ S, x * y = 1 := by
  let f : ↥S → ↥S := fun y => ⟨x * (y : K), S.mul_mem hx y.2⟩
  have hf : Function.Injective f := by
    intro a b hab
    have h1 : x * (a : K) = x * (b : K) := congrArg Subtype.val hab
    have h2 : (a : K) = (b : K) := mul_left_cancel₀ hx0 h1
    exact Subtype.ext h2
  have hsurj : Function.Surjective f := Finite.surjective_of_injective hf
  obtain ⟨y, hy⟩ := hsurj 1
  refine ⟨(y : K), y.2, ?_⟩
  have h3 : (f y : K) = ((1 : ↥S) : K) := congrArg Subtype.val hy
  simpa [f] using h3

/-- If `S` is a proper subring of a finite field `K`, then `|S|² ≤ |K|`.  Indeed for `x ∉ S`
the map `S × S → K`, `(a,b) ↦ a + b * x`, is injective. -/
theorem card_sq_le_of_ne_top {K : Type} [Field K] [Fintype K] (S : Subring K) (hS : S ≠ ⊤) :
    Nat.card ↥S * Nat.card ↥S ≤ Nat.card K := by
  obtain ⟨x, hx⟩ : ∃ x : K, x ∉ S := by
    by_contra hc
    simp only [not_exists, not_not] at hc
    exact hS (Subring.ext fun y => ⟨fun _ => Subring.mem_top y, fun _ => hc y⟩)
  have hg : Function.Injective (fun p : ↥S × ↥S => (p.1 : K) + (p.2 : K) * x) := by
    rintro ⟨a1, b1⟩ ⟨a2, b2⟩ heq
    dsimp only at heq
    have hb : b1 = b2 := by
      by_contra hne
      have hd0 : ((b1 - b2 : ↥S) : K) ≠ 0 := by
        intro h0
        exact hne (sub_eq_zero.mp (Subtype.ext h0))
      obtain ⟨c, hcS, hc⟩ := subring_exists_mul_eq_one S (b1 - b2).2 hd0
      let cS : ↥S := ⟨c, hcS⟩
      have hdx : ((b1 - b2 : ↥S) : K) * x = (a2 : K) - (a1 : K) := by
        have hlin : ((b1 : ↥S) : K) * x - ((b2 : ↥S) : K) * x = (a2 : K) - (a1 : K) := by
          rw [sub_eq_sub_iff_add_eq_add]
          rw [add_comm (((b1 : ↥S) : K) * x) (a1 : K), heq]
        rw [show ((b1 - b2 : ↥S) : K) = ((b1 : ↥S) : K) - ((b2 : ↥S) : K) from rfl, sub_mul]
        exact hlin
      have hxexpr : x = (c : K) * ((a2 : K) - (a1 : K)) := by
        rw [← hdx, ← mul_assoc, mul_comm (c : K) (((b1 - b2 : ↥S) : K)), hc, one_mul]
      have hmem : (c : K) * ((a2 : K) - (a1 : K)) ∈ S := by
        have hcast : (c : K) * ((a2 : K) - (a1 : K)) = ((cS * a2 - cS * a1 : ↥S) : K) := by
          show (c : K) * ((a2 : K) - (a1 : K)) = ((cS * a2 : ↥S) : K) - ((cS * a1 : ↥S) : K)
          rw [mul_sub]
          rfl
        rw [hcast]
        exact (cS * a2 - cS * a1).2
      rw [hxexpr] at hx
      exact hx hmem
    have ha : a1 = a2 := by
      have h' : (a1 : K) + (b1 : K) * x = (a2 : K) + (b1 : K) * x := by
        rw [← hb] at heq
        exact heq
      exact Subtype.ext (add_right_cancel h')
    exact Prod.ext ha hb
  have hle := Nat.card_le_card_of_injective (fun p : ↥S × ↥S => (p.1 : K) + (p.2 : K) * x) hg
  rwa [Nat.card_prod] at hle

theorem subring_eq_top_of_card {K : Type} [Field K] [Fintype K] (S : Subring K)
    (h : Nat.card K + 1 ≤ 2 * Nat.card S) : S = ⊤ := by
  by_contra hS
  have hle := card_sq_le_of_ne_top S hS
  have hnt : Nontrivial ↥S := ⟨0, 1, by
    intro hh
    exact zero_ne_one (Subtype.ext_iff.mp hh)⟩
  have h2 : 2 ≤ Nat.card ↥S := by
    have := @Finite.one_lt_card ↥S _ hnt
    omega
  have hkey : Nat.card ↥S * Nat.card ↥S + 1 ≤ 2 * Nat.card ↥S :=
    le_trans (Nat.add_le_add_right hle 1) h
  have h1 : 2 * Nat.card ↥S ≤ Nat.card ↥S * Nat.card ↥S := by
    have := Nat.mul_le_mul_left (Nat.card ↥S) h2
    rwa [Nat.mul_comm (Nat.card ↥S) 2] at this
  omega

end Work.AppXIDickson.L0
