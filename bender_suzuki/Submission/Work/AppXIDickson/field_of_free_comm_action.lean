/-!
# L0 — App. XI Prop. 2, first half (Schur + little Wedderburn)

`Work.AppXIDickson.field_of_free_comm_action`: let `V` be a finite additive group of order `> 1`,
`A` a finite abelian group acting fixed-point freely on `V \ {0}`, `B` a group acting compatibly
on `V` and on `A`, and `|V| ≤ 2|A| + 1`.  Then `V` is the additive group of a finite field `K`,
`A` embeds in `Kˣ` acting by multiplication, `B` acts by field automorphisms compatibly, and two
field automorphisms agreeing on `ι(A)` are equal.

Route.  `R = actSubring A V ≤ AddMonoid.End V` is a commutative ring; `V` is a simple
`R`-module (counting: a nonzero proper `A`-invariant additive subgroup `W` satisfies
`|W| ≥ |A| + 1` and `2|W| ≤ |V| ≤ 2|A| + 1`, absurd); hence `K := Module.End ↥R V`, the ring of
`A`-equivariant additive endomorphisms of `V`, is a division ring (Schur) and a field (little
Wedderburn), and `V` is a one-dimensional `K`-vector space.  The action of `A` gives
`ι : A ↪ Kˣ` (left multiplication by `a` is `R`-linear because `A` is commutative) and the action
of `B` gives `σ : B →* (K ≃+* K)` by conjugation (`b ∘ k ∘ b⁻¹`, which preserves `R`-linearity by
`hcompat`).  Finally `K` is generated as a ring by `ι(A)` (a finite subring `S` of a finite field
`K` with `2|S| ≥ |K| + 1` is everything), which gives the uniqueness of `τ` on `ι(A)`.

Helpers used from the workspace: `Work.AppXIField.Defs.actSubring`, `actEnd`, `actSubring_smul`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

noncomputable section
open Classical
open Work.AppXIField

namespace Work.AppXIDickson

/-! ## The action subring is commutative -/

/-- The subring of `AddMonoid.End V` generated by the action of the commutative group `A` is
commutative.  Packaged as a class so that the definitions below can use it silently. -/
class ActSubringComm (A V : Type*) [CommGroup A] [AddCommGroup V] [DistribMulAction A V] :
    Prop where
  out : ∀ r s : ↥(actSubring A V), r * s = s * r

instance instActSubringComm (A V : Type*) [CommGroup A] [AddCommGroup V]
    [DistribMulAction A V] : ActSubringComm A V :=
  ⟨fun r s => L0.actSubring_mul_comm A V r s⟩

section Mult

variable {V A : Type*} [AddCommGroup V] [CommGroup A] [DistribMulAction A V]

/-- Left multiplication by an element of the action subring, as an `R`-linear endomorphism of
`V` (this is where commutativity of `R` is used). -/
def leftMul [ActSubringComm A V] (r : ↥(actSubring A V)) :
    Module.End ↥(actSubring A V) V where
  toFun v := r • v
  map_add' x y := map_add (r : AddMonoid.End V) x y
  map_smul' s x := by
    show r • (s • x) = s • (r • x)
    rw [← mul_smul, ← mul_smul, ActSubringComm.out r s]

theorem leftMul_apply [ActSubringComm A V] (r : ↥(actSubring A V)) (v : V) :
    leftMul (A := A) (V := V) r v = r • v := rfl

/-- `r ↦ (v ↦ r • v)` is a ring homomorphism `↥R →+* Module.End ↥R V`. -/
def leftMulHom [ActSubringComm A V] :
    ↥(actSubring A V) →+* Module.End ↥(actSubring A V) V where
  toFun := leftMul (A := A) (V := V)
  map_one' := LinearMap.ext fun x => by
    show leftMul (1 : ↥(actSubring A V)) x = x
    rw [leftMul_apply, one_smul]
  map_zero' := LinearMap.ext fun x => by
    show leftMul (0 : ↥(actSubring A V)) x = 0
    rw [leftMul_apply, zero_smul]
  map_add' r s := LinearMap.ext fun x => by
    show leftMul (r + s) x = leftMul r x + leftMul s x
    rw [leftMul_apply, leftMul_apply, leftMul_apply, add_smul]
  map_mul' r s := LinearMap.ext fun x => by
    show leftMul (r * s) x = leftMul r (leftMul s x)
    rw [leftMul_apply, leftMul_apply, leftMul_apply, mul_smul]

/-- `a ↦ actEnd A V a` as a monoid homomorphism `A →* ↥R`. -/
def actEndMonoidHom : A →* ↥(actSubring A V) where
  toFun a := ⟨actEnd A V a, actEnd_mem_actSubring A V a⟩
  map_one' := Subtype.ext (by ext v; show (1 : A) • v = v; rw [one_smul])
  map_mul' a b := Subtype.ext (by ext v; show (a * b) • v = a • (b • v); rw [mul_smul])

/-- The action of `A` on `V`, as a monoid homomorphism `A →* Module.End ↥R V`. -/
def iotaLin [ActSubringComm A V] : A →* Module.End ↥(actSubring A V) V :=
  (leftMulHom (A := A) (V := V)).toMonoidHom.comp (actEndMonoidHom (A := A) (V := V))

theorem iotaLin_apply [ActSubringComm A V] (a : A) (v : V) :
    iotaLin (A := A) (V := V) a v = a • v := by
  show leftMul (A := A) (V := V) ⟨actEnd A V a, actEnd_mem_actSubring A V a⟩ v = a • v
  rw [leftMul_apply]
  rfl

/-- `iotaLin a` as a unit of `K = Module.End ↥R V` (the inverse is `iotaLin a⁻¹`). -/
def iotaUnit [ActSubringComm A V] (a : A) : (Module.End ↥(actSubring A V) V)ˣ where
  val := iotaLin (A := A) (V := V) a
  inv := iotaLin (A := A) (V := V) a⁻¹
  val_inv := by rw [← map_mul, mul_inv_cancel, map_one]
  inv_val := by rw [← map_mul, inv_mul_cancel, map_one]

theorem iotaUnit_coe [ActSubringComm A V] (a : A) :
    ((iotaUnit (A := A) (V := V) a : (Module.End ↥(actSubring A V) V)ˣ) :
      Module.End ↥(actSubring A V) V) = iotaLin (A := A) (V := V) a := rfl

/-- The embedding `A →* Kˣ`, `a ↦ (v ↦ a • v)`. -/
def iota [ActSubringComm A V] : A →* (Module.End ↥(actSubring A V) V)ˣ where
  toFun := iotaUnit (A := A) (V := V)
  map_one' := Units.ext (map_one (iotaLin (A := A) (V := V)))
  map_mul' a b := Units.ext (map_mul (iotaLin (A := A) (V := V)) a b)

theorem iota_coe [ActSubringComm A V] (a : A) :
    ((iota (A := A) (V := V) a : (Module.End ↥(actSubring A V) V)ˣ) :
      Module.End ↥(actSubring A V) V) = iotaLin (A := A) (V := V) a := rfl

end Mult

/-! ## Conjugation by the action of `B` -/

section Conj

variable {V B : Type*} [AddCommGroup V] [Group B] [DistribMulAction B V]

/-- Conjugation by an additive automorphism `e` of `V`, as a ring automorphism of
`AddMonoid.End V`. -/
def conjEnd (e : V ≃+ V) : AddMonoid.End V ≃+* AddMonoid.End V where
  toFun f :=
    { toFun := fun v => e (f (e.symm v))
      map_zero' := by simp
      map_add' := by intro x y; simp [map_add] }
  invFun f :=
    { toFun := fun v => e.symm (f (e v))
      map_zero' := by simp
      map_add' := by intro x y; simp [map_add] }
  left_inv f := by
    ext v
    show e.symm (e (f (e.symm (e v)))) = f v
    simp only [AddEquiv.symm_apply_apply]
  right_inv f := by
    ext v
    show e (e.symm (f (e (e.symm v)))) = f v
    simp only [AddEquiv.apply_symm_apply]
  map_mul' f g := by
    ext v
    show e (f (g (e.symm v))) = e (f (e.symm (e (g (e.symm v)))))
    simp only [AddEquiv.symm_apply_apply]
  map_add' f g := by
    ext v
    show e ((f + g) (e.symm v)) = e (f (e.symm v)) + e (g (e.symm v))
    rw [show (f + g) (e.symm v) = f (e.symm v) + g (e.symm v) from rfl, map_add]

theorem conjEnd_apply (e : V ≃+ V) (f : AddMonoid.End V) (v : V) :
    conjEnd e f v = e (f (e.symm v)) := rfl

/-- The additive automorphism `v ↦ b • v` of `V`. -/
def bEnd (b : B) : V ≃+ V where
  toFun v := b • v
  invFun v := b⁻¹ • v
  left_inv v := by show b⁻¹ • (b • v) = v; rw [← mul_smul, inv_mul_cancel, one_smul]
  right_inv v := by show b • (b⁻¹ • v) = v; rw [← mul_smul, mul_inv_cancel, one_smul]
  map_add' v w := smul_add b v w

theorem bEnd_apply (b : B) (v : V) : bEnd b v = b • v := rfl
theorem bEnd_symm_apply (b : B) (v : V) : (bEnd b).symm v = b⁻¹ • v := rfl

theorem smul_conjEnd (b : B) (s : AddMonoid.End V) (y : V) :
    b • s y = (conjEnd (bEnd b) s) (b • y) := by
  rw [conjEnd_apply, bEnd_symm_apply]
  rw [show b⁻¹ • (b • y) = y from by rw [← mul_smul, inv_mul_cancel, one_smul], bEnd_apply]

theorem conjEnd_bEnd_inv_apply (b : B) (s : AddMonoid.End V) :
    conjEnd (bEnd b) (conjEnd (bEnd (V := V) (b⁻¹)) s) = s := by
  ext v
  rw [conjEnd_apply, conjEnd_apply, bEnd_symm_apply, bEnd_symm_apply]
  rw [show (b⁻¹)⁻¹ • (b⁻¹ • v) = v from by
    rw [inv_inv, ← mul_smul, mul_inv_cancel, one_smul]]
  rw [show bEnd b (bEnd (V := V) (b⁻¹) (s v)) = s v from by
    rw [bEnd_apply, bEnd_apply, ← mul_smul, mul_inv_cancel, one_smul]]

end Conj

section Compat

variable {V A B : Type*} [AddCommGroup V] [CommGroup A] [DistribMulAction A V]
  [Group B] [DistribMulAction B V] (φ : B →* MulAut A)

/-- `hcompat` says that conjugation by `b` sends the generator `actEnd a` of `R` to
`actEnd (φ b a)`. -/
theorem conjEnd_bEnd_actEnd (b : B) (a : A)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v)) :
    conjEnd (bEnd b) (actEnd A V a) = actEnd A V (φ b a) := by
  ext v
  show b • (actEnd A V a (b⁻¹ • v)) = (φ b a) • v
  show b • (a • (b⁻¹ • v)) = (φ b a) • v
  rw [hcompat b a (b⁻¹ • v)]
  rw [show b • (b⁻¹ • v) = v from by rw [← mul_smul, mul_inv_cancel, one_smul]]

/-- Conjugation by `b` preserves the action subring. -/
theorem conjEnd_bEnd_mem_actSubring (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v)) :
    ∀ r ∈ actSubring A V, conjEnd (bEnd b) r ∈ actSubring A V := by
  have hcl : Subring.closure (Set.range (actEnd A V)) ≤
      Subring.comap (conjEnd (bEnd b)).toRingHom (actSubring A V) := by
    rw [Subring.closure_le]
    rintro x ⟨a, rfl⟩
    show conjEnd (bEnd b) (actEnd A V a) ∈ actSubring A V
    rw [conjEnd_bEnd_actEnd (A := A) φ b a hcompat]
    exact Subring.subset_closure ⟨φ b a, rfl⟩
  intro r hr
  exact hcl hr

/-- The conjugation permutation of `K = Module.End ↥R V` induced by `b : B`. -/
def sigmaFun (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v))
    (k : Module.End ↥(actSubring A V) V) : Module.End ↥(actSubring A V) V where
  toFun v := b • (k (b⁻¹ • v))
  map_add' x y := by simp [smul_add, map_add]
  map_smul' r x := by
    have hmem : conjEnd (bEnd (V := V) (b⁻¹)) (r : AddMonoid.End V) ∈ actSubring A V :=
      conjEnd_bEnd_mem_actSubring (A := A) φ (b⁻¹) hcompat r r.2
    have h1 : b⁻¹ • (r • x)
        = (⟨conjEnd (bEnd (V := V) (b⁻¹)) (r : AddMonoid.End V), hmem⟩ :
            ↥(actSubring A V)) • (b⁻¹ • x) := by
      show b⁻¹ • (r • x) = conjEnd (bEnd (V := V) (b⁻¹)) (r : AddMonoid.End V) (b⁻¹ • x)
      exact smul_conjEnd (V := V) (b⁻¹) (r : AddMonoid.End V) x
    rw [h1, k.map_smul]
    show b • conjEnd (bEnd (V := V) (b⁻¹)) (r : AddMonoid.End V) (k (b⁻¹ • x))
        = r • (b • (k (b⁻¹ • x)))
    rw [smul_conjEnd (V := V) b (conjEnd (bEnd (V := V) (b⁻¹)) (r : AddMonoid.End V))
      (k (b⁻¹ • x)), conjEnd_bEnd_inv_apply]
    rfl

theorem sigmaFun_apply (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v))
    (k : Module.End ↥(actSubring A V) V) (v : V) :
    sigmaFun (A := A) (V := V) φ b hcompat k v = b • (k (b⁻¹ • v)) := rfl

/-- `sigmaFun b` viewed as a ring endomorphism of `K`. -/
def sigmaRingHom (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v)) :
    Module.End ↥(actSubring A V) V →+* Module.End ↥(actSubring A V) V where
  toFun := sigmaFun (A := A) (V := V) φ b hcompat
  map_one' := LinearMap.ext fun v => by
    show b • ((1 : Module.End ↥(actSubring A V) V) (b⁻¹ • v)) = v
    rw [show (1 : Module.End ↥(actSubring A V) V) (b⁻¹ • v) = b⁻¹ • v from rfl]
    rw [show b • (b⁻¹ • v) = v from by rw [← mul_smul, mul_inv_cancel, one_smul]]
  map_zero' := LinearMap.ext fun v => by
    show b • ((0 : Module.End ↥(actSubring A V) V) (b⁻¹ • v)) = 0
    simp
  map_add' k₁ k₂ := LinearMap.ext fun v => by
    show b • ((k₁ + k₂) (b⁻¹ • v)) = b • (k₁ (b⁻¹ • v)) + b • (k₂ (b⁻¹ • v))
    rw [show (k₁ + k₂) (b⁻¹ • v) = k₁ (b⁻¹ • v) + k₂ (b⁻¹ • v) from rfl, smul_add]
  map_mul' k₁ k₂ := LinearMap.ext fun v => by
    show b • ((k₁ * k₂) (b⁻¹ • v)) = b • (k₁ (b⁻¹ • (b • (k₂ (b⁻¹ • v)))))
    rw [show (k₁ * k₂) (b⁻¹ • v) = k₁ (k₂ (b⁻¹ • v)) from rfl]
    rw [show b⁻¹ • (b • (k₂ (b⁻¹ • v))) = k₂ (b⁻¹ • v) from by
      rw [← mul_smul, inv_mul_cancel, one_smul]]

theorem sigmaRingHom_inv_inv (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v))
    (k : Module.End ↥(actSubring A V) V) :
    sigmaRingHom (A := A) (V := V) φ (b⁻¹) hcompat
        (sigmaRingHom (A := A) (V := V) φ b hcompat k) = k := by
  ext v
  show sigmaFun (A := A) (V := V) φ (b⁻¹) hcompat
      (sigmaFun (A := A) (V := V) φ b hcompat k) v = k v
  show b⁻¹ • (sigmaFun (A := A) (V := V) φ b hcompat k ((b⁻¹)⁻¹ • v)) = k v
  rw [show (b⁻¹)⁻¹ • v = b • v from by rw [inv_inv]]
  show b⁻¹ • (b • (k (b⁻¹ • (b • v)))) = k v
  rw [show b⁻¹ • (b • v) = v from by rw [← mul_smul, inv_mul_cancel, one_smul]]
  rw [show b⁻¹ • (b • (k v)) = k v from by rw [← mul_smul, inv_mul_cancel, one_smul]]

theorem sigmaRingHom_inv (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v))
    (k : Module.End ↥(actSubring A V) V) :
    sigmaRingHom (A := A) (V := V) φ b hcompat
        (sigmaRingHom (A := A) (V := V) φ (b⁻¹) hcompat k) = k := by
  ext v
  show sigmaFun (A := A) (V := V) φ b hcompat
      (sigmaFun (A := A) (V := V) φ (b⁻¹) hcompat k) v = k v
  show b • (b⁻¹ • (k ((b⁻¹)⁻¹ • (b⁻¹ • v)))) = k v
  rw [show (b⁻¹)⁻¹ • (b⁻¹ • v) = v from by
    rw [inv_inv, ← mul_smul, mul_inv_cancel, one_smul]]
  rw [show b • (b⁻¹ • (k v)) = k v from by rw [← mul_smul, mul_inv_cancel, one_smul]]

theorem sigmaRingHom_bijective (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v)) :
    Function.Bijective (sigmaRingHom (A := A) (V := V) φ b hcompat) := by
  constructor
  · intro k₁ k₂ h
    have h2 := congrArg (sigmaRingHom (A := A) (V := V) φ (b⁻¹) hcompat) h
    rwa [sigmaRingHom_inv_inv, sigmaRingHom_inv_inv] at h2
  · intro k
    exact ⟨sigmaRingHom (A := A) (V := V) φ (b⁻¹) hcompat k,
      sigmaRingHom_inv (A := A) (V := V) φ b hcompat k⟩

/-- The conjugation action of `b : B` on `K = Module.End ↥R V`, as a ring automorphism. -/
def sigmaEquiv (b : B)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v)) :
    Module.End ↥(actSubring A V) V ≃+* Module.End ↥(actSubring A V) V :=
  RingEquiv.ofBijective (sigmaRingHom (A := A) (V := V) φ b hcompat)
    (sigmaRingHom_bijective (A := A) (V := V) φ b hcompat)

/-- The action of `B` on `K = Module.End ↥R V` by field automorphisms. -/
def sigmaHom
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v)) :
    B →* (Module.End ↥(actSubring A V) V ≃+* Module.End ↥(actSubring A V) V) where
  toFun b := sigmaEquiv (A := A) (V := V) φ b hcompat
  map_one' := RingEquiv.ext fun k => LinearMap.ext fun v => by
    show (1 : B) • (k ((1 : B)⁻¹ • v)) = k v
    rw [one_smul, inv_one, one_smul]
  map_mul' b₁ b₂ := RingEquiv.ext fun k => LinearMap.ext fun v => by
    show (b₁ * b₂) • (k ((b₁ * b₂)⁻¹ • v)) = b₁ • (b₂ • (k (b₂⁻¹ • (b₁⁻¹ • v))))
    rw [mul_smul b₁ b₂, mul_inv_rev, mul_smul (b₂⁻¹) (b₁⁻¹) v]

end Compat
/-! ## The main statement -/

/-- **L0** (App. XI Prop. 2, first half; Schur + little Wedderburn; verbatim from the pass-17
design).  Let `V` be a finite additive group of odd order `> 1`, `A` a finite abelian group
acting on `V`, fixed-point freely on `V \ {0}`, `B` a group acting on `V` and on `A` through
`φ : B →* MulAut A` compatibly (`b • (a • v) = (φ b a) • (b • v)`), and `|V| ≤ 2|A| + 1`.  Then
`V` is the additive group of a finite field `K` (`e : V ≃+ K`), `A` embeds in `Kˣ` (`ι`,
injective) acting by multiplication, `B` acts by field automorphisms `σ` compatible with `φ`, and
two field automorphisms agreeing on `ι(A)` are equal.

Route (reviewed).  Let `R` be the subring of `AddMonoid.End V` generated by the action of `A`
(equivalently `Subring.closure (Set.range fun a => (· • ·) a)`); an additive subgroup of `V` is an
`R`-submodule iff it is `A`-invariant, and `V` is a simple `R`-module: `hfree` makes every
`A`-orbit in `V \ {0}` have `|A|` elements, while an `A`-invariant `0 < W < V` has at least two
non-zero `A`-orbits in `V/W` and `W`, forcing `|V| ≥ 3|A| + 1 > 2|A| + 1`, against `hbig`.
By Schur `K := Module.End ↥R V` is a division ring; it is finite, hence a field (little Wedderburn:
a finite division ring is a field).  Fix `v₀ ≠ 0`; `K → V, k ↦ k v₀` is injective (its kernel is an
ideal of the division ring `K`), and its image is `R`-invariant, hence all of `V` (it is non-zero
and `V` is simple); so `V` is a one-dimensional `K`-vector space and `e` is the inverse of this
bijection.  `ι : A →* Kˣ` sends `a` to multiplication by `a` on `V ≅ K`; it is injective by
`hfree`.  For `b : B`, `k ↦ e (b • (e⁻¹ k)) / e (b • v₀)` is a ring automorphism `σ b`
(`K` is generated as a ring by `ι(A)`: `2|A| + 1 ≥ |K| = |Kˣ| + 1` makes `ι(A)` of index `≤ 2` in
`Kˣ`, hence generating `Kˣ`, and `K = Kˣ ∪ {0}`), it is multiplicative in `b` by `hcompat`, and
`σ b (ι a) = ι (φ b a)`.  The last conjunct is `σ b` being determined by its values on `ι(A)`.
Helpers available in this workspace: `Work.AppXIField.Defs.actSubring`, `actEnd`,
`actSubring_smul`. -/
theorem field_of_free_comm_action {V A B : Type} [AddCommGroup V] [Finite V] [CommGroup A]
    [Finite A] [Group B] [DistribMulAction A V] [DistribMulAction B V] (φ : B →* MulAut A)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v))
    (hV : 1 < Nat.card V) (hodd : Odd (Nat.card V))
    (hfree : ∀ (a : A) (v : V), v ≠ 0 → a • v = v → a = 1)
    (hbig : Nat.card V ≤ 2 * Nat.card A + 1) :
    ∃ (K : Type) (_ : Field K) (_ : Fintype K) (e : V ≃+ K) (ι : A →* Kˣ)
      (σ : B →* (K ≃+* K)),
      Function.Injective ι ∧ (∀ (a : A) (v : V), e (a • v) = (ι a : K) * e v) ∧
      (∀ (b : B) (a : A), σ b (ι a : K) = (ι (φ b a) : K)) ∧
      (∀ τ₁ τ₂ : K ≃+* K, (∀ a : A, τ₁ (ι a : K) = τ₂ (ι a : K)) → τ₁ = τ₂) := by
  classical
  -- `V` is an irreducible module over the action subring
  haveI hsimple : IsSimpleModule ↥(actSubring A V) V :=
    L0.isSimpleModule_actSubring hV hfree hbig
  -- `K = End_R V` is a finite division ring, hence a field
  haveI hFinK : Finite (Module.End ↥(actSubring A V) V) :=
    Finite.of_injective (fun f : Module.End ↥(actSubring A V) V => (f : V → V))
      (fun f g h => LinearMap.ext fun v => congrFun h v)
  -- a nonzero vector
  haveI : Fintype V := Fintype.ofFinite V
  haveI hnt : Nontrivial V := by
    have hcard : 1 < Fintype.card V := by rw [← Nat.card_eq_fintype_card]; exact hV
    exact ⟨Fintype.one_lt_card_iff.mp hcard⟩
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  -- the `K`-linear map `k ↦ k v₀`
  let Φ : Module.End ↥(actSubring A V) V →ₗ[Module.End ↥(actSubring A V) V] V :=
    LinearMap.toSpanSingleton _ V v₀
  have hΦ : ∀ k : Module.End ↥(actSubring A V) V, Φ k = k • v₀ := fun k =>
    LinearMap.toSpanSingleton_apply _ _ _ k
  -- `v₀` spans `V` over `R`
  have hspan : Submodule.span ↥(actSubring A V) ({v₀} : Set V) = ⊤ := by
    rcases eq_bot_or_eq_top (Submodule.span ↥(actSubring A V) ({v₀} : Set V)) with h | h
    · exact absurd (Submodule.span_singleton_eq_bot.mp h) hv₀
    · exact h
  have hsurj : Function.Surjective ⇑Φ := by
    intro v
    have hv : v ∈ Submodule.span ↥(actSubring A V) ({v₀} : Set V) := by rw [hspan]; trivial
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hv
    refine ⟨leftMul r, ?_⟩
    rw [hΦ]
    show leftMul r v₀ = v
    rw [leftMul_apply]
    exact hr
  -- every nonzero `R`-endomorphism of `V` is injective, since `V` is a simple `R`-module
  have hker : ∀ k : Module.End ↥(actSubring A V) V, k ≠ 0 → Function.Injective ⇑k := by
    intro k hk
    have h : LinearMap.ker k = ⊥ := by
      rcases eq_bot_or_eq_top (LinearMap.ker k) with h | h
      · exact h
      · exfalso
        refine hk (LinearMap.ext fun x => ?_)
        have hx : x ∈ LinearMap.ker k := h.symm ▸ Submodule.mem_top
        rw [LinearMap.mem_ker.mp hx]
        exact (map_zero (0 : Module.End ↥(actSubring A V) V)).symm
    exact LinearMap.ker_eq_bot.mp h
  have hinj : Function.Injective ⇑Φ := by
    intro k₁ k₂ hk
    by_contra hne
    have hsub : k₁ - k₂ ≠ 0 := sub_ne_zero.mpr hne
    have hk' : k₁ v₀ = k₂ v₀ := by
      show k₁ • v₀ = k₂ • v₀
      rw [← hΦ k₁, ← hΦ k₂]
      exact hk
    have hk0 : (k₁ - k₂) v₀ = 0 := by
      rw [show (k₁ - k₂) v₀ = k₁ v₀ - k₂ v₀ from rfl, hk', sub_self]
    exact hv₀ (hker (k₁ - k₂) hsub (by rw [hk0, map_zero]))
  have hbij : Function.Bijective ⇑Φ := ⟨hinj, hsurj⟩
  -- the additive isomorphism `e : V ≃+ K`
  let e : V ≃+ Module.End ↥(actSubring A V) V := (AddEquiv.ofBijective Φ hbij).symm
  have heΦ : ∀ x : V, Φ (e x) = x := fun x =>
    (AddEquiv.ofBijective Φ hbij).apply_symm_apply x
  have heΦ' : ∀ x : V, (e x) • v₀ = x := fun x => by rw [← hΦ]; exact heΦ x
  -- the embedding `ι : A →* Kˣ`
  let ι : A →* (Module.End ↥(actSubring A V) V)ˣ := iota (A := A) (V := V)
  have hιinj : Function.Injective ι := by
    intro a b hab
    have h1 : iotaLin (A := A) (V := V) a = iotaLin (A := A) (V := V) b := by
      have := congrArg (fun u : (Module.End ↥(actSubring A V) V)ˣ =>
        (u : Module.End ↥(actSubring A V) V)) hab
      simpa only [ι, iota_coe] using this
    have h2 : a • v₀ = b • v₀ := by
      have := congrArg (fun k : Module.End ↥(actSubring A V) V => k v₀) h1
      simpa [iotaLin_apply] using this
    have h3 : (b⁻¹ * a) • v₀ = v₀ := by
      rw [mul_smul, h2, ← mul_smul, inv_mul_cancel, one_smul]
    have h4 : b⁻¹ * a = 1 := hfree (b⁻¹ * a) v₀ hv₀ h3
    exact (inv_mul_eq_one.mp h4).symm
  -- `ι` acts by multiplication
  have hε : ∀ (a : A) (v : V), e (a • v)
      = (ι a : Module.End ↥(actSubring A V) V) * e v := by
    intro a v
    apply hinj
    rw [heΦ, hΦ]
    rw [mul_smul]
    rw [show (e v) • v₀ = v from heΦ' v]
    show a • v = iotaLin (A := A) (V := V) a v
    rw [iotaLin_apply]
  -- `σ b (ι a) = ι (φ b a)`
  have hσ : ∀ (b : B) (a : A),
      (sigmaHom (A := A) (V := V) φ hcompat b) (ι a : Module.End ↥(actSubring A V) V)
        = (ι (φ b a) : Module.End ↥(actSubring A V) V) := by
    intro b a
    show sigmaRingHom (A := A) (V := V) φ b hcompat (iotaLin (A := A) (V := V) a)
      = iotaLin (A := A) (V := V) (φ b a)
    apply LinearMap.ext
    intro v
    show sigmaFun (A := A) (V := V) φ b hcompat (iotaLin (A := A) (V := V) a) v
      = iotaLin (A := A) (V := V) (φ b a) v
    show b • (iotaLin (A := A) (V := V) a (b⁻¹ • v)) = (φ b a) • v
    show b • (a • (b⁻¹ • v)) = (φ b a) • v
    rw [hcompat b a (b⁻¹ • v)]
    rw [show b • (b⁻¹ • v) = v from by rw [← mul_smul, mul_inv_cancel, one_smul]]
  -- `K` is generated as a ring by `ι(A)`
  have hgen : ∀ τ₁ τ₂ : Module.End ↥(actSubring A V) V ≃+* Module.End ↥(actSubring A V) V,
      (∀ a : A, τ₁ (ι a : Module.End ↥(actSubring A V) V)
        = τ₂ (ι a : Module.End ↥(actSubring A V) V)) → τ₁ = τ₂ := by
    intro τ₁ τ₂ h
    have htop : Subring.closure (Set.range (fun a : A =>
        (ι a : Module.End ↥(actSubring A V) V))) = ⊤ := by
      refine @L0.subring_eq_top_of_card (Module.End ↥(actSubring A V) V) inferInstance
        (Fintype.ofFinite _) _ ?_
      have hK : Nat.card (Module.End ↥(actSubring A V) V) = Nat.card V :=
        Nat.card_congr e.symm.toEquiv
      have hS : Nat.card A + 1 ≤ Nat.card ↥(Subring.closure (Set.range (fun a : A =>
          (ι a : Module.End ↥(actSubring A V) V)))) := by
        have hinj2 : Function.Injective (fun x : A ⊕ Unit =>
            match x with
            | Sum.inl a => (⟨(ι a : Module.End ↥(actSubring A V) V),
                Subring.subset_closure ⟨a, rfl⟩⟩ :
                ↥(Subring.closure (Set.range (fun a : A =>
                  (ι a : Module.End ↥(actSubring A V) V)))))
            | Sum.inr _ => (⟨0, (Subring.closure (Set.range (fun a : A =>
                (ι a : Module.End ↥(actSubring A V) V)))).zero_mem⟩ :
                ↥(Subring.closure (Set.range (fun a : A =>
                  (ι a : Module.End ↥(actSubring A V) V)))))) := by
          rintro (a | ⟨⟩) (b | ⟨⟩) hab
          · have h' : (ι a : Module.End ↥(actSubring A V) V)
                = (ι b : Module.End ↥(actSubring A V) V) := Subtype.ext_iff.mp hab
            have h'' : (ι a : (Module.End ↥(actSubring A V) V)ˣ) = ι b := Units.ext h'
            rw [hιinj h'']
          · exfalso
            have h' : (ι a : Module.End ↥(actSubring A V) V) = 0 := Subtype.ext_iff.mp hab
            exact (Units.ne_zero (ι a)) h'
          · exfalso
            have h' : (0 : Module.End ↥(actSubring A V) V)
                = (ι b : Module.End ↥(actSubring A V) V) := Subtype.ext_iff.mp hab
            exact (Units.ne_zero (ι b)) h'.symm
          · rfl
        have hle := Nat.card_le_card_of_injective _ hinj2
        rwa [Nat.card_sum, Nat.card_unique (α := Unit)] at hle
      have h2 : 2 * (Nat.card A + 1) ≤ 2 * Nat.card ↥(Subring.closure (Set.range (fun a : A =>
          (ι a : Module.End ↥(actSubring A V) V)))) := Nat.mul_le_mul_left 2 hS
      have h3 : Nat.card V + 1 ≤ 2 * (Nat.card A + 1) := by
        have h4 : 2 * (Nat.card A + 1) = 2 * Nat.card A + 2 := by ring
        omega
      omega
    apply RingEquiv.ext
    intro x
    have hx : x ∈ Subring.closure (Set.range (fun a : A =>
        (ι a : Module.End ↥(actSubring A V) V))) := by rw [htop]; trivial
    have hle : Subring.closure (Set.range (fun a : A =>
        (ι a : Module.End ↥(actSubring A V) V))) ≤
        RingHom.eqLocus τ₁.toRingHom τ₂.toRingHom := by
      rw [Subring.closure_le]
      rintro y ⟨a, rfl⟩
      show (ι a : Module.End ↥(actSubring A V) V) ∈
        RingHom.eqLocus τ₁.toRingHom τ₂.toRingHom
      rw [RingHom.mem_eqLocus]
      exact h a
    have hx' : x ∈ RingHom.eqLocus τ₁.toRingHom τ₂.toRingHom := hle hx
    exact RingHom.mem_eqLocus.mp hx'
  exact ⟨Module.End ↥(actSubring A V) V, inferInstance, Fintype.ofFinite _, e, ι,
    sigmaHom (A := A) (V := V) φ hcompat, hιinj, hε, hσ, hgen⟩

end Work.AppXIDickson
