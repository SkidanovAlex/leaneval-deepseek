/-! ## The verbatim interface of Brief 4 -/

/-- The step-(2) shadow plus `[R,R] ≤ N` (what App. III (2) actually gives).
Copied verbatim from `_design17/ThmF17_AppXI.lean`. -/
def NearFieldAppXIPropPlus : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (H Q : Subgroup G) (t s r : G) (P : Subgroup G),
    CtxF H Q t s r P →
    ∃ (m : ℕ) (R N : Subgroup G), N = Ker H Q P t ∧
      1 ≤ m ∧ (orderOf (s * t)).Prime ∧ N ≤ R ∧
      R ≤ Subgroup.centralizer (P : Set G) ∧
      Subgroup.centralizer (P : Set G) ≤ Subgroup.normalizer (R : Set G) ∧
      Subgroup.centralizer (P : Set G) ≤ Subgroup.normalizer (N : Set G) ∧
      Nat.card R = Nat.card N * orderOf (s * t) ^ m ∧
      Nat.card ↥(CQ Q P) + 1 = orderOf (s * t) ^ m ∧
      (∀ x ∈ R, x ∉ N → ∀ y ∈ CQ Q P, y * x * y⁻¹ * x⁻¹ ∈ N → y = 1) ∧
      (∀ x ∈ R, ∀ y ∈ R, x * y * x⁻¹ * y⁻¹ ∈ N)

/-- `NearFieldAppXIProp` — the step-(2) shadow (see `Work.ThmF.ChV3.NearField`). -/
theorem NearFieldAppXIPropPlus.toShadow (h : NearFieldAppXIPropPlus) : NearFieldAppXIProp := by
  intro G _ _ H Q t s r P c
  obtain ⟨m, R, N, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, -⟩ := h G H Q t s r P c
  exact ⟨m, R, N, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩

/-- `NearFieldFieldProp` minus `Function.Injective act` (the genuine App. XI Prop. 1 (2)b
content).  Copied verbatim from `_design17/ThmF17_AppXI.lean`; this is the conclusion of the
area's target `nearFieldFieldPropNI_of`. -/
def NearFieldFieldPropNI : Prop :=
  ∀ {G : Type} [Group G] [Finite G] {H Q : Subgroup G} {t s r : G} {P : Subgroup G} {m : ℕ},
    CtxF H Q t s r P →
    1 ≤ m →
    Nat.card ↥(CQ Q P) + 1 = orderOf (s * t) ^ m →
    IsMulCommutative ↥(CQ Q P) →
    ∃ (F : Type) (_ : Field F) (_ : Fintype F)
      (_ : CharP F (orderOf (s * t))) (_ : Fact (orderOf (s * t)).Prime)
      (act : ↥(Sig H t P) →* (F ≃+* F)),
      Nat.card F = orderOf (s * t) ^ m ∧
      (∀ w : ↥(Sig H t P), w ≠ 1 →
        Nat.card (Function.fixedPoints (act w)) =
          Nat.card ↥(CQ Q P ⊓ Subgroup.centralizer ({(w : G)} : Set G)) + 1)

/-! ## Vocabulary for `L0`: the `A`-module structure on `V`

`R := actSubring A V` is the subring of `AddMonoid.End V` generated by the action of `A`; `V`
is an `R`-module with `r • v = (r : AddMonoid.End V) v`, so that `R`-submodules of `V` are
exactly the `A`-invariant additive subgroups, and `Module.End ↥R V` is the ring `End_A V` of
`A`-equivariant additive endomorphisms (a division ring by Schur when `V` is irreducible). -/

/-- The additive endomorphism `v ↦ a • v` of `V` attached to `a : A`. -/
def actEnd (A V : Type*) [CommGroup A] [AddCommGroup V] [DistribMulAction A V] (a : A) :
    AddMonoid.End V where
  toFun v := a • v
  map_zero' := smul_zero a
  map_add' x y := smul_add a x y

/-- The subring of `AddMonoid.End V` generated by the action of `A` on `V`. -/
def actSubring (A V : Type*) [CommGroup A] [AddCommGroup V] [DistribMulAction A V] :
    Subring (AddMonoid.End V) := Subring.closure (Set.range (actEnd A V))

instance instSMulActSubring (A V : Type*) [CommGroup A] [AddCommGroup V]
    [DistribMulAction A V] : SMul ↥(actSubring A V) V :=
  ⟨fun r v => (r : AddMonoid.End V) v⟩

instance instModuleActSubring (A V : Type*) [CommGroup A] [AddCommGroup V]
    [DistribMulAction A V] : Module ↥(actSubring A V) V where
  smul_add r x y := (r : AddMonoid.End V).map_add x y
  add_smul r s x := rfl
  zero_smul x := rfl
  one_smul x := rfl
  mul_smul r s x := rfl
  smul_zero r := (r : AddMonoid.End V).map_zero

/-- `actEnd A V a` lies in `actSubring A V`. -/
theorem actEnd_mem_actSubring (A V : Type*) [CommGroup A] [AddCommGroup V]
    [DistribMulAction A V] (a : A) : actEnd A V a ∈ actSubring A V :=
  Subring.subset_closure ⟨a, rfl⟩

/-- The defining property of the `Module ↥(actSubring A V) V` instance. -/
theorem actSubring_smul (A V : Type*) [CommGroup A] [AddCommGroup V] [DistribMulAction A V]
    (a : A) (v : V) :
    (⟨actEnd A V a, actEnd_mem_actSubring A V a⟩ : ↥(actSubring A V)) • v = a • v := rfl

/-! ## Vocabulary for `Main`: the near-field quotient `R/N` -/

/-- The underlying additive group `V = R/N` of the near-field of Ch. V §3 step (2) (the
quotient of the subgroup `R` by `N`, transported to additive notation). -/
abbrev QuotV (G : Type*) [Group G] (R N : Subgroup G) : Type _ := Additive (↥R ⧸ N.subgroupOf R)

/-! ## Plumbing: turning a monoid hom into `MulAut` into actions

A `MulAut Q`-valued monoid hom `f : A →* MulAut Q` is the shape in which the conjugation
actions on the near-field quotient `R/N` are produced (`Main/exists_conjAction_quot`); these
three definitions turn it into a `MulDistribMulAction A Q` and into a `DistribMulAction` on
`Additive Q`, to be introduced with `letI` (they need the non-inferable argument `f`, so they
are definitions rather than instances). -/

/-- The action of `A` on `Additive Q` induced by a monoid hom into `MulAut Q`. -/
def smulAdditiveOfHom (A Q : Type*) [Monoid A] [Monoid Q] (f : A →* MulAut Q) :
    SMul A (Additive Q) :=
  ⟨fun a x => f a (Additive.toMul x)⟩

/-- The multiplicative action by group automorphisms of `Q` induced by `f : A →* MulAut Q`. -/
def mulDistribMulActionOfHom (A Q : Type*) [Monoid A] [Monoid Q] (f : A →* MulAut Q) :
    MulDistribMulAction A Q where
  smul a q := f a q
  one_smul q := show f 1 q = q from by rw [map_one]; rfl
  mul_smul a b q := show f (a * b) q = f a (f b q) from by rw [map_mul]; rfl
  smul_one a := map_one (f a)
  smul_mul a x y := map_mul (f a) x y

/-- The additive action on `Additive Q` induced by `f : A →* MulAut Q`, usable as
`letI := distribMulActionAdditiveOfHom A Q f`. -/
def distribMulActionAdditiveOfHom (A Q : Type*) [Monoid A] [Monoid Q] (f : A →* MulAut Q) :
    DistribMulAction A (Additive Q) where
  smul := (smulAdditiveOfHom A Q f).smul
  one_smul x := show f 1 (Additive.toMul x) = x from by rw [map_one]; rfl
  mul_smul a b x := show f (a * b) (Additive.toMul x) = f a (f b (Additive.toMul x)) from by
    rw [map_mul]; rfl
  smul_zero a := congrArg Additive.ofMul (map_one (f a))
  smul_add a x y := show f a (Additive.toMul (x + y)) =
      Additive.ofMul (Additive.toMul (f a (Additive.toMul x)) *
        Additive.toMul (f a (Additive.toMul y))) from by
    rw [show Additive.toMul (x + y) = Additive.toMul x * Additive.toMul y from rfl, map_mul]
    rfl

