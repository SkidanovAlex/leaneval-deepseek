/-!
# The additive isomorphism `V ≃+ End_A V` (Appendix XI, step 4 of L0)

Let `V` be a finite additive group on which the finite abelian group `A` acts, with
`1 < |V|`, `|V| ≤ 2|A| + 1`, and with `V` a *simple* module over the subring
`R = actSubring A V ≤ AddMonoid.End V` generated by the action of `A`.  Then the evaluation
map `Φ : End_A V →+ V`, `k ↦ k v₀`, at a nonzero `v₀` is bijective, so
`e := Φ.symm : V ≃+ End_A V` is an additive isomorphism; and if `ι : A →* (End_A V)ˣ`
realises the action of `A` (`(ι a) v = a • v`), then `e (a • v) = ι a * e v`.

The mathematics is the one described in `Work.AppXIField.Defs`: `End_A V` is a division ring
(Schur, since `V` is simple over `R`), the units of which contain an isomorphic copy of `A`,
so `|A| + 1 ≤ |End_A V|`; and if `Φ` were not surjective then `|V| ≥ 2|End_A V| ≥ 2|A| + 2`,
against `|V| ≤ 2|A| + 1`.

The three ingredients are proved in sibling files:
* `addHom_surjective_of_card_le` — the counting dichotomy,
* `moduleEnd_eval_injective` — injectivity of evaluation (Schur),
* `addEquiv_symm_smul_eq_mul` — the intertwining property of `Φ.symm`.
-/

set_option autoImplicit false

noncomputable section

open Classical

namespace Work.AppXIField.L0

/-- **The additive isomorphism `V ≃+ End_A V`.** -/
theorem exists_addEquiv_moduleEnd {V A : Type} [AddCommGroup V] [Finite V] [CommGroup A] [Finite A]
    [DistribMulAction A V] (hV : 1 < Nat.card V) (hbig : Nat.card V ≤ 2 * Nat.card A + 1)
    (hS : IsSimpleModule ↥(Work.AppXIField.actSubring A V) V)
    (ι : A →* (Module.End ↥(Work.AppXIField.actSubring A V) V)ˣ)
    (hιinj : Function.Injective ι)
    (hιact : ∀ (a : A) (v : V),
        ((ι a : Module.End ↥(Work.AppXIField.actSubring A V) V) : V → V) v = a • v) :
    ∃ e : V ≃+ Module.End ↥(Work.AppXIField.actSubring A V) V,
      ∀ (a : A) (v : V),
        e (a • v) = (ι a : Module.End ↥(Work.AppXIField.actSubring A V) V) * e v := by
  classical
  haveI hS' : IsSimpleModule ↥(Work.AppXIField.actSubring A V) V := hS
  -- the endomorphism ring is finite (it embeds into the functions `V → V`)
  haveI hfinK : Finite (Module.End ↥(Work.AppXIField.actSubring A V) V) := by
    refine Finite.of_injective
      (fun f : Module.End ↥(Work.AppXIField.actSubring A V) V => ⇑f) ?_
    intro f g h
    exact LinearMap.ext (fun x => congrFun h x)
  -- a nonzero vector, from `1 < |V|`
  haveI : Fintype V := Fintype.ofFinite V
  have hv' : 1 < Fintype.card V := by rw [← Nat.card_eq_fintype_card]; exact hV
  haveI : Nontrivial V := Fintype.one_lt_card_iff_nontrivial.mp hv'
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  -- evaluation at `v₀`
  let Φ₀ : Module.End ↥(Work.AppXIField.actSubring A V) V →+ V :=
    { toFun := fun k => (k : V → V) v₀
      map_zero' := rfl
      map_add' := fun f g => rfl }
  have hinj : Function.Injective Φ₀ := fun k l h => moduleEnd_eval_injective v₀ hv₀ h
  -- `|A| + 1 ≤ |End_A V|`, via the units of the (division) ring `End_A V` containing `A`:
  -- the map `A ⊕ Unit → End_A V`, `(a, ·) ↦ ι a`, `(·, ()) ↦ 0` is injective.
  have hcard : Nat.card A + 1 ≤ Nat.card (Module.End ↥(Work.AppXIField.actSubring A V) V) := by
    have hinj2 : Function.Injective
        (fun x : A ⊕ Unit => Sum.elim (fun a : A =>
          (ι a : Module.End ↥(Work.AppXIField.actSubring A V) V)) (fun _ : Unit => 0) x) := by
      rintro (a | u) (b | v) h
      · simp only [Sum.elim_inl] at h
        exact congrArg Sum.inl (hιinj (Units.ext h))
      · simp only [Sum.elim_inl, Sum.elim_inr] at h
        exact absurd h (Units.ne_zero (ι a))
      · simp only [Sum.elim_inl, Sum.elim_inr] at h
        exact absurd h.symm (Units.ne_zero (ι b))
      · exact congrArg Sum.inr (Subsingleton.elim u v)
    have h2 := Nat.card_le_card_of_injective _ hinj2
    rw [Nat.card_sum, Nat.card_unique (α := Unit)] at h2
    omega
  -- the counting dichotomy: `Φ₀` is bijective
  have hsurj : Function.Surjective Φ₀ :=
    addHom_surjective_of_card_le Φ₀ hinj (n := Nat.card A) hcard hbig
  -- and finally the intertwining property of `Φ₀.symm`
  refine ⟨(AddEquiv.ofBijective Φ₀ ⟨hinj, hsurj⟩).symm, ?_⟩
  exact addEquiv_symm_smul_eq_mul v₀ ι hιact Φ₀ (fun k => rfl) ⟨hinj, hsurj⟩

end Work.AppXIField.L0
