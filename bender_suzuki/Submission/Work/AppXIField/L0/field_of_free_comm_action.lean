/-- Two ring homomorphisms out of a ring that agree on a set generating it as a subring agree
everywhere. -/
lemma ringHom_ext_of_closure_eq_top {K K' : Type*} [Ring K] [Ring K'] (f g : K →+* K')
    {s : Set K} (hs : Subring.closure s = ⊤) (h : ∀ x ∈ s, f x = g x) : f = g := by
  ext x
  have hx : x ∈ Subring.closure s := by rw [hs]; trivial
  exact Subring.closure_induction (p := fun y _ => f y = g y)
    (fun y hy => h y hy) (by simp) (by simp)
    (fun y z _ _ ihy ihz => by simp [map_add, ihy, ihz])
    (fun y _ ihy => by simp [ihy])
    (fun y z _ _ ihy ihz => by simp [map_mul, ihy, ihz]) hx

/-! ## The target -/

theorem field_of_free_comm_action {V A B : Type} [AddCommGroup V] [Finite V] [CommGroup A]
    [Finite A] [Group B] [DistribMulAction A V] [DistribMulAction B V] (φ : B →* MulAut A)
    (hcompat : ∀ (b : B) (a : A) (v : V), b • (a • v) = (φ b a) • (b • v))
    (hV : 1 < Nat.card V) (hodd : Odd (Nat.card V))
    (hfree : ∀ (a : A) (v : V), v ≠ 0 → a • v = v → a = 1)
    (hbig : Nat.card V ≤ 2 * Nat.card A + 1) :
    ∃ (K : Type) (_ : Field K) (_ : Fintype K) (e : V ≃+ K) (ι : A →* Kˣ)
      (σ : B →* (K ≃+* K)),
      Function.Injective ι ∧ (∀ (a : A) (v : V), e (a • v) = (ι a : K) * e v) ∧
      (∀ (b : B) (a : A), σ b (ι a : K) = (ι (φ b a) : K)) ∧
      (∀ τ₁ τ₂ : K ≃+* K, (∀ a : A, τ₁ (ι a : K) = τ₂ (ι a : K)) → τ₁ = τ₂) := by
  classical
  -- Step 1: `V` is a simple module over the ring generated by the action of `A`.
  haveI hS : IsSimpleModule ↥(actSubring A V) V :=
    Work.AppXIDickson.L0.isSimpleModule_actSubring hV hfree hbig
  -- Step 2: `K := End_A V` is finite; by Schur's lemma it is a division ring, hence a field
  -- (`littleWedderburn`); the `Field` instance is left unnamed so that the canonical ring
  -- operations of `K` are used throughout.
  haveI hfin : Finite (Module.End ↥(actSubring A V) V) :=
    Finite.of_injective (fun f : Module.End ↥(actSubring A V) V => (f : V → V))
      (fun f g h => LinearMap.ext (congrFun h))
  haveI hFintype : Fintype (Module.End ↥(actSubring A V) V) := Fintype.ofFinite _
  -- Step 3: `A ↪ Kˣ`.
  obtain ⟨ι, hιinj, hιact⟩ := exists_iota_hom (V := V) (A := A) hV hfree
  -- Step 4: `V ≅ K` additively, compatibly with the `A`-action.
  obtain ⟨e, he⟩ := exists_addEquiv_moduleEnd (V := V) (A := A) hV hbig hS ι hιinj hιact
  have hKeq : Nat.card (Module.End ↥(actSubring A V) V) = Nat.card V :=
    (Nat.card_congr e.toEquiv).symm
  have hKcard : Nat.card (Module.End ↥(actSubring A V) V) ≤ 2 * Nat.card A + 1 := by omega
  -- Step 5: `ι(A)` generates `K` as a ring.
  have hSgen : Nat.card A + 1 ≤
      Nat.card ↥(Subring.closure (Set.range fun a : A => (ι a : Module.End ↥(actSubring A V) V))) := by
    set S : Subring (Module.End ↥(actSubring A V) V) :=
      Subring.closure (Set.range fun a : A => (ι a : Module.End ↥(actSubring A V) V)) with hSdef
    have hmem : ∀ a : A, (ι a : Module.End ↥(actSubring A V) V) ∈ S :=
      fun a => Subring.subset_closure ⟨a, rfl⟩
    have hne0 : ∀ a : A, (⟨(ι a : Module.End ↥(actSubring A V) V), hmem a⟩ : ↥S) ≠ 0 := by
      intro a hzero
      refine Units.ne_zero (ι a) ?_
      exact congrArg (fun x : ↥S => (x : Module.End ↥(actSubring A V) V)) hzero
    have hinj : Function.Injective
        (fun a : A => (⟨(ι a : Module.End ↥(actSubring A V) V), hmem a⟩ : ↥S)) := by
      intro a b hab
      refine hιinj (Units.ext ?_)
      exact congrArg (fun x : ↥S => (x : Module.End ↥(actSubring A V) V)) hab
    have hle : Nat.card A ≤ Nat.card {x : ↥S // x ≠ 0} := by
      refine Nat.card_le_card_of_injective
        (fun a : A =>
          (⟨⟨(ι a : Module.End ↥(actSubring A V) V), hmem a⟩, hne0 a⟩ : {x : ↥S // x ≠ 0}))
        (fun a b hab => hinj (congrArg (fun x : {x : ↥S // x ≠ 0} => (x : ↥S)) hab))
    have hlt : Nat.card A < Nat.card ↥S :=
      lt_of_le_of_lt hle
        (Finite.card_subtype_lt (p := fun x : ↥S => x ≠ 0) (x := 0) (by intro h; exact h rfl))
    omega
  have hgen : Subring.closure (Set.range fun a : A => (ι a : Module.End ↥(actSubring A V) V)) = ⊤ :=
    Work.AppXIDickson.L0.subring_eq_top_of_card _ (by omega)
  -- Step 6: the `B`-action.
  obtain ⟨σ, hσ⟩ := exists_sigma_of_iota (V := V) (A := A) (B := B) φ hcompat e ι he hgen
  refine ⟨Module.End ↥(actSubring A V) V, inferInstance, Fintype.ofFinite _, e, ι, σ,
    hιinj, he, hσ, ?_⟩
  intro τ₁ τ₂ hτ
  refine RingEquiv.ext fun x => ?_
  have hx : x ∈ Subring.closure (Set.range fun a : A => (ι a : Module.End ↥(actSubring A V) V)) := by
    rw [hgen]; trivial
  exact Subring.closure_induction (p := fun y _ => τ₁ y = τ₂ y)
    (fun y hy => by obtain ⟨a, rfl⟩ := hy; exact hτ a) (by simp) (by simp)
    (fun y z _ _ ihy ihz => by simp [map_add, ihy, ihz])
    (fun y _ ihy => by simp [ihy])
    (fun y z _ _ ihy ihz => by simp [map_mul, ihy, ihz]) hx

end Work.AppXIField.L0
