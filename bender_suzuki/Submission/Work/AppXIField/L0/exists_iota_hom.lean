open Work.AppXIField

/-- Every element of the subring `actSubring A V` generated by the action of `A` commutes with
the elementary endomorphism `actEnd A V a` (`A` is commutative).  This is what makes `v ↦ a • v`
`actSubring A V`-linear. -/
private lemma actEnd_mul_actSubring_comm {V A : Type} [AddCommGroup V] [CommGroup A]
    [DistribMulAction A V] (a : A) (r : ↥(actSubring A V)) :
    (actEnd A V a : AddMonoid.End V) * (r : AddMonoid.End V)
      = (r : AddMonoid.End V) * actEnd A V a := by
  have hmem : ∀ b : A,
      actEnd A V b ∈ Subring.centralizer ({actEnd A V a} : Set (AddMonoid.End V)) := by
    intro b
    rw [Subring.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    ext v
    change a • (b • v) = b • (a • v)
    rw [smul_smul, mul_comm, ← smul_smul]
  have hle : actSubring A V ≤
      Subring.centralizer ({actEnd A V a} : Set (AddMonoid.End V)) :=
    Subring.closure_le.mpr (by rintro x ⟨b, rfl⟩; exact hmem b)
  exact (Subring.mem_centralizer_iff.mp (hle r.2)) _ (Set.mem_singleton _)

/-- The `↥(actSubring A V)`-linear endomorphism `v ↦ a • v` of `V`. -/
private noncomputable def actLinearMap {V A : Type} [AddCommGroup V] [CommGroup A]
    [DistribMulAction A V] (a : A) : Module.End ↥(actSubring A V) V where
  toFun v := a • v
  map_add' x y := smul_add a x y
  map_smul' r v := by
    have h := actEnd_mul_actSubring_comm (V := V) (A := A) a r
    exact congrFun (congrArg (fun f : AddMonoid.End V => (f : V → V)) h) v

/-- `v ↦ a • v` as a unit of `Module.End ↥(actSubring A V) V`, with inverse `v ↦ a⁻¹ • v`. -/
private noncomputable def actUnit {V A : Type} [AddCommGroup V] [CommGroup A]
    [DistribMulAction A V] (a : A) : (Module.End ↥(actSubring A V) V)ˣ :=
  Units.mk (actLinearMap (V := V) (A := A) a) (actLinearMap (V := V) (A := A) a⁻¹)
    (by ext v; show a • (a⁻¹ • v) = v; rw [smul_smul, mul_inv_cancel, one_smul])
    (by ext v; show a⁻¹ • (a • v) = v; rw [smul_smul, inv_mul_cancel, one_smul])

theorem exists_iota_hom {V A : Type} [AddCommGroup V] [Finite V] [CommGroup A] [Finite A]
    [DistribMulAction A V] (hV : 1 < Nat.card V)
    (hfree : ∀ (a : A) (v : V), v ≠ 0 → a • v = v → a = 1) :
    ∃ ι : A →* (Module.End ↥(Work.AppXIField.actSubring A V) V)ˣ, Function.Injective ι ∧
      ∀ (a : A) (v : V),
        ((ι a : Module.End ↥(Work.AppXIField.actSubring A V) V) : V → V) v = a • v := by
  refine ⟨MonoidHom.mk' (actUnit (V := V) (A := A)) ?_, ?_, ?_⟩
  · intro a b
    apply Units.ext
    show actLinearMap (V := V) (A := A) (a * b)
        = actLinearMap (V := V) (A := A) a * actLinearMap (V := V) (A := A) b
    ext v
    simp only [actLinearMap, Module.End.mul_apply]
    exact (smul_smul a b v).symm
  · intro a b hab
    have h1 : ∀ v : V, a • v = b • v := by
      intro v
      have h := congrArg (fun u : (Module.End ↥(actSubring A V) V)ˣ =>
          ((u : Module.End ↥(actSubring A V) V)) v) hab
      change (actLinearMap (V := V) (A := A) a) v
        = (actLinearMap (V := V) (A := A) b) v at h
      exact h
    have hex : ∃ v : V, v ≠ 0 := by
      by_contra h
      simp only [not_exists, not_not] at h
      have hsub : Subsingleton V := ⟨fun x y => by rw [h x, h y]⟩
      have := (Finite.card_le_one_iff_subsingleton (α := V)).mpr hsub
      omega
    obtain ⟨v, hv⟩ := hex
    have h2 : (b⁻¹ * a) • v = v := by
      rw [mul_smul, h1 v, inv_smul_smul]
    have h3 := hfree (b⁻¹ * a) v hv h2
    rw [inv_mul_eq_one] at h3
    exact h3.symm
  · intro a v
    rfl

end Work.AppXIField.L0
