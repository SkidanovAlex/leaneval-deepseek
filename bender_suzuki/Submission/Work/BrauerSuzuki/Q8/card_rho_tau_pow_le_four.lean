namespace Work.BrauerSuzuki.Q8

/-- In a generalized quaternion group in normal form with `n = 2` (that is, `Q₈`), the cyclic
subgroup `⟨tau⟩` is generated by `tau` of order `4`, so the set of all elements of the form
`rho * tau ^ i` (`i : ℕ`) is the coset `rho * ⟨tau⟩` and has at most `4` elements.

Since `tau ^ 4 = 1`, the map `r ↦ rho * tau ^ r` is a surjection from `Fin 4` onto this set, and
`Nat.card` of a surjective image is bounded by the cardinality of the source. -/
theorem card_rho_tau_pow_le_four {P : Type*} [Group P] [Finite P]
    (d : Work.BrauerSuzuki.GenQuaternionData P) (h2 : d.n = 2) :
    Nat.card {x : P // ∃ i : ℕ, x = d.rho * d.tau ^ i} ≤ 4 := by
  -- `tau` has order `2 ^ n = 4`, hence `tau ^ 4 = 1`.
  have htau4 : d.tau ^ 4 = 1 := by
    have hord : orderOf d.tau = 4 := by rw [d.tau_order, h2]; norm_num
    rw [← hord]; exact pow_orderOf_eq_one d.tau
  -- Every element `rho * tau ^ i` is already of the form `rho * tau ^ r` with `r = i % 4 < 4`.
  have hsurj : Function.Surjective (fun r : Fin 4 =>
      (⟨d.rho * d.tau ^ (r : ℕ), ⟨(r : ℕ), rfl⟩⟩ :
        {x : P // ∃ i : ℕ, x = d.rho * d.tau ^ i})) := by
    rintro ⟨x, i, rfl⟩
    refine ⟨⟨i % 4, Nat.mod_lt _ (by norm_num)⟩, ?_⟩
    simp only [Subtype.mk.injEq]
    conv_rhs => rw [← Nat.div_add_mod i 4]
    rw [pow_add, pow_mul, htau4, one_pow, one_mul]
  have hle := Nat.card_le_card_of_surjective _ hsurj
  have h4 : Nat.card (Fin 4) = 4 := by rw [Nat.card_eq_fintype_card, Fintype.card_fin]
  omega

end Work.BrauerSuzuki.Q8
