/-!
# Sylow `2`-structure and the centralizer of an order-`4` element in the `Q₈` case

If `S` is a Sylow `2`-subgroup of a finite group `G` whose generalised quaternion normal form
`d` has `d.n = 2` (i.e. `S ≅ Q₈`), then:

* every `2`-subgroup of `G` has order `≤ 8` (it lies in a conjugate of `S`),
* no subgroup of order `8` is abelian (an order-`8` `2`-subgroup is a Sylow subgroup, hence
  conjugate to `S ≅ Q₈`),
* if `x ∈ S` has order `4`, then every `2`-element `y` of `G` commuting with `x` lies in
  `⟨x⟩`.

The last statement follows from the first two: `⟨x, y⟩` is an abelian `2`-subgroup containing
the order-`4` subgroup `⟨x⟩`, so if it were strictly larger it would be abelian of order `8`.
-/

/-- A power of a power: if `g ^ (2 ^ m) = 1` and `m ≤ N`, then `g ^ (2 ^ N) = 1`. -/
private lemma pow_two_pow_eq_one_of_le {G : Type*} [Monoid G] {g : G} {m N : ℕ}
    (h : g ^ 2 ^ m = 1) (hmN : m ≤ N) : g ^ 2 ^ N = 1 := by
  rw [show (2 : ℕ) ^ N = 2 ^ m * 2 ^ (N - m) by rw [← pow_add]; congr 1; omega]
  rw [pow_mul, h, one_pow]

/-- The subgroup generated by two commuting elements of `2`-power order is a `2`-group.
(`x` has order exactly `4` here, but only that its order is a power of `2` is used.) -/
theorem isPGroup_closure_commute_pair {G : Type*} [Group G] {x y : G} (hcomm : Commute x y)
    (hx : orderOf x = 4) (hy : ∃ k : ℕ, orderOf y = 2 ^ k) :
    IsPGroup 2 ↥(Subgroup.closure ({x, y} : Set G)) := by
  have hpair : ({x, y} : Set G).Pairwise Commute := by
    intro a ha b hb _
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with ha | ha
    · rw [ha]
      rcases hb with hb | hb
      · rw [hb]
      · rw [hb]; exact hcomm
    · rw [ha]
      rcases hb with hb | hb
      · rw [hb]; exact hcomm.symm
      · rw [hb]
  haveI : IsMulCommutative ↥(Subgroup.closure ({x, y} : Set G)) :=
    Subgroup.isMulCommutative_closure hpair
  rw [isPGroup_iff_pow_pow_eq_one]
  intro a
  have key : ∀ g ∈ (Subgroup.closure ({x, y} : Set G)), ∃ N : ℕ, g ^ 2 ^ N = 1 := by
    intro g hg
    refine Subgroup.closure_induction (p := fun g _ => ∃ N : ℕ, g ^ 2 ^ N = 1) ?_ ?_ ?_ ?_ hg
    · intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with hz | hz
      · rw [hz]
        exact ⟨2, by rw [show (2 : ℕ) ^ (2 : ℕ) = 4 from rfl, ← hx, pow_orderOf_eq_one]⟩
      · rw [hz]
        obtain ⟨k, hk⟩ := hy
        exact ⟨k, by rw [← hk, pow_orderOf_eq_one]⟩
    · exact ⟨0, by simp⟩
    · intro p q hp hq ihp ihq
      obtain ⟨m, hm⟩ := ihp
      obtain ⟨n, hn⟩ := ihq
      have hpq_comm : Commute p q :=
        congrArg Subtype.val (mul_comm' (⟨p, hp⟩ : ↥(Subgroup.closure ({x, y} : Set G)))
          (⟨q, hq⟩ : ↥(Subgroup.closure ({x, y} : Set G))))
      refine ⟨max m n, ?_⟩
      rw [hpq_comm.mul_pow, pow_two_pow_eq_one_of_le hm (le_max_left m n),
        pow_two_pow_eq_one_of_le hn (le_max_right m n), mul_one]
    · intro p hp ihp
      obtain ⟨m, hm⟩ := ihp
      exact ⟨m, by rw [inv_pow, hm, inv_one]⟩
  obtain ⟨N, hN⟩ := key (a : G) a.2
  exact ⟨N, Subtype.ext (by simpa using hN)⟩

/-- Non-commutativity transfers across a multiplicative equivalence. -/
private lemma exists_not_commute_of_mulEquiv {H K : Type*} [Group H] [Group K]
    (e : H ≃* K) (h : ∃ a b : K, a * b ≠ b * a) : ∃ a b : H, a * b ≠ b * a := by
  obtain ⟨a, b, hab⟩ := h
  exact ⟨e.symm a, e.symm b, fun hc => hab (by simpa using congrArg e hc)⟩

/-- A subgroup of `G` is abelian (as a subset of `G`) iff its coercion to a type is abelian. -/
private lemma not_comm_iff_exists {G : Type*} [Group G] (A : Subgroup G) :
    (¬ (∀ a ∈ A, ∀ b ∈ A, a * b = b * a)) ↔ ∃ x y : ↥A, x * y ≠ y * x := by
  constructor
  · intro h
    by_contra hcon
    push_neg at hcon
    exact h fun a ha b hb => congrArg Subtype.val (hcon ⟨a, ha⟩ ⟨b, hb⟩)
  · rintro ⟨x, y, hxy⟩ h
    exact hxy (Subtype.ext (h x x.2 y y.2))

/-- If `m` is a power of two with `4 < m ≤ 8`, then `m = 8`. -/
private lemma eq_eight_of_two_pow {m : ℕ} (hm : ∃ n, m = 2 ^ n) (h4 : 4 < m) (h8 : m ≤ 8) :
    m = 8 := by
  obtain ⟨n, rfl⟩ := hm
  have h43 : (2 : ℕ) ^ 2 = 4 := by norm_num
  have h83 : (2 : ℕ) ^ 3 = 8 := by norm_num
  have hn : n = 3 := by
    have hlt : (2 : ℕ) ^ 2 < 2 ^ n := by rw [h43]; exact h4
    have hle : (2 : ℕ) ^ n ≤ 2 ^ 3 := by rw [h83]; exact h8
    have h1 : 2 < n := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < (2 : ℕ))).mp hlt
    have h2 : n ≤ 3 := (Nat.pow_le_pow_iff_right (by norm_num : 1 < (2 : ℕ))).mp hle
    omega
  rw [hn]
  exact h83

theorem sylow_two_structure_and_centralizer {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (d : Work.BrauerSuzuki.GenQuaternionData ↥S) (h2 : d.n = 2) :
    (∀ A : Subgroup G, IsPGroup 2 A → Nat.card ↥A ≤ 8) ∧
      (∀ A : Subgroup G, IsPGroup 2 A → Nat.card ↥A = 8 →
        ¬(∀ a ∈ A, ∀ b ∈ A, a * b = b * a)) ∧
      ∀ x : G, x ∈ (S : Subgroup G) → orderOf x = 4 → ∀ y : G,
        y * x = x * y → (∃ k : ℕ, orderOf y = 2 ^ k) → y ∈ Subgroup.zpowers x := by
  -- The order of the Sylow subgroup is `2 ^ (d.n + 1) = 8`.
  have hS8 : Nat.card ↥S = 8 := by
    have h := (Work.BrauerSuzuki.Quaternion.genQuaternionData_basic d).1
    rw [h2] at h
    norm_num at h
    exact h
  -- All Sylow `2`-subgroups have cardinality `8`.
  have hsylow : ∀ Q : Sylow 2 G, Nat.card ↥Q = 8 := by
    intro Q
    rw [← hS8]
    exact Nat.card_congr (Sylow.equiv Q S).toEquiv
  -- `S ≅ Q₈` is non-abelian: `ρ τ ρ⁻¹ = τ⁻¹` and `τ` has order `4`.
  have hSnonab : ∃ a b : ↥S, a * b ≠ b * a := by
    refine ⟨d.tau, d.rho, ?_⟩
    intro hcomm
    have hconj : d.rho * d.tau * d.rho⁻¹ = d.tau := by rw [← hcomm]; group
    have htau : d.tau⁻¹ = d.tau := by rw [← d.rho_conj, hconj]
    have hsquare : d.tau ^ 2 = 1 := by rw [sq]; exact mul_eq_one_iff_inv_eq.mpr htau
    have hdvd : orderOf d.tau ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hsquare
    have hnot : ¬ (2 ^ d.n ∣ 2) := by rw [h2]; norm_num
    exact hnot (d.tau_order ▸ hdvd)
  have h1 : ∀ A : Subgroup G, IsPGroup 2 A → Nat.card ↥A ≤ 8 := by
    intro A hA
    obtain ⟨Q, hAQ⟩ := IsPGroup.exists_le_sylow hA
    calc Nat.card ↥A ≤ Nat.card ↥Q := Subgroup.card_le_of_le hAQ
      _ = 8 := hsylow Q
  have h2c : ∀ A : Subgroup G, IsPGroup 2 A → Nat.card ↥A = 8 →
        ¬(∀ a ∈ A, ∀ b ∈ A, a * b = b * a) := by
    intro A hA hAcard hab
    obtain ⟨Q, hAQ⟩ := IsPGroup.exists_le_sylow hA
    have hQA : A = (Q : Subgroup G) := by
      refine Subgroup.eq_of_le_of_card_ge hAQ ?_
      have hQ8 : Nat.card ↥(Q : Subgroup G) = 8 := hsylow Q
      rw [hQ8, hAcard]
    have hQnonab : ∃ p q : ↥Q, p * q ≠ q * p :=
      exists_not_commute_of_mulEquiv (Sylow.equiv Q S) hSnonab
    rw [hQA] at hab
    exact (not_comm_iff_exists (Q : Subgroup G)).mpr hQnonab hab
  refine ⟨h1, h2c, ?_⟩
  intro x _ hx4 y hyx hy2
  by_contra hy
  let A : Subgroup G := Subgroup.closure ({x, y} : Set G)
  have hpair : ({x, y} : Set G).Pairwise Commute := by
    intro a ha b hb _
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with ha | ha
    · rw [ha]
      rcases hb with hb | hb
      · rw [hb]
      · rw [hb]; exact hyx.symm
    · rw [ha]
      rcases hb with hb | hb
      · rw [hb]; exact hyx
      · rw [hb]
  haveI : IsMulCommutative ↥A := Subgroup.isMulCommutative_closure hpair
  have hAab : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (mul_comm' (⟨a, ha⟩ : ↥A) (⟨b, hb⟩ : ↥A))
  have hA2 : IsPGroup 2 ↥A := isPGroup_closure_commute_pair hyx.symm hx4 hy2
  have hxA : x ∈ A := Subgroup.subset_closure (by simp)
  have hyA : y ∈ A := Subgroup.subset_closure (by simp)
  have hle : Subgroup.zpowers x ≤ A := Subgroup.zpowers_le.mpr hxA
  have hlt : Subgroup.zpowers x < A := by
    refine lt_of_le_of_ne hle (fun hEq => ?_)
    rw [← hEq] at hyA
    exact hy hyA
  have hcard4 : 4 < Nat.card ↥A := by
    have hlt' := Subgroup.card_lt_of_lt hlt
    rwa [Nat.card_zpowers, hx4] at hlt'
  have hcardle : Nat.card ↥A ≤ 8 := h1 A hA2
  have hpow : ∃ n, Nat.card ↥A = 2 ^ n := (IsPGroup.iff_card).mp hA2
  have hcard8 : Nat.card ↥A = 8 := eq_eight_of_two_pow hpow hcard4 hcardle
  exact (h2c A hA2 hcard8) hAab

end Work.BrauerSuzuki.Q8
