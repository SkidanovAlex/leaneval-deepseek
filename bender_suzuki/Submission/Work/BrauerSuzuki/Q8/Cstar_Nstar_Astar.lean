/-!
# The `Q₈` case of Brauer–Suzuki: `C^* = X H^*`, `N^* = S H^*`, and `A^* = C^* ∖ T H^*` is a TI set

Let `G` be a finite group whose Sylow `2`-subgroup `S` is generalized quaternion with
`d.n = 2`, i.e. `S ≅ Q₈`, and let `x ∈ S` have order `4`.  With

* `X = ⟨x⟩` (cyclic of order `4`), `T = ⟨x²⟩` (the unique subgroup of order `2`),
* `C^* = C_G(X)`, `N^* = N_G(X)`, `H^* = O_{2'}(C^*)` (viewed as a subgroup of `G`),

the classical first step of Glauberman's treatment of the `Q₈` case (Illinois J. Math. 18
(1974) 60–65, part (1); Gorenstein 12.1.2–12.1.3) asserts

* `C^* = X × H^*` (`X ⊔ H^* = C^*`, `X ⊓ H^* = 1`, elements commute, `|H^*|` odd),
* `S ≤ N^*` and `N^* = S H^*`,
* `A^* = C^* ∖ T H^*` is a TI set with normalizer `N^*`.

This file assembles that statement from the `Q₈` structural lemmas.
-/

namespace Work.BrauerSuzuki.Q8

open Classical

open scoped Pointwise

/-- An element commuting with `x` lies in the centralizer of the cyclic subgroup generated by
`x`. -/
private lemma mem_centralizer_zpowers_of_commute {G : Type*} [Group G] {x y : G}
    (h : y * x = x * y) : y ∈ Subgroup.centralizer (Subgroup.zpowers x : Set G) := by
  rw [Subgroup.mem_centralizer_iff]
  intro z hz
  obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
  exact (Commute.zpow_left (show Commute x y from h.symm) i).eq

/-- An element of the centralizer of `⟨x⟩` commutes with `x`. -/
private lemma commute_of_mem_centralizer_zpowers {G : Type*} [Group G] {x y : G}
    (h : y ∈ Subgroup.centralizer (Subgroup.zpowers x : Set G)) : y * x = x * y :=
  (Subgroup.mem_centralizer_iff.mp h x (Subgroup.mem_zpowers x)).symm

/-- Conjugation preserves the order of an element. -/
private lemma orderOf_conj_eq {G : Type*} [Group G] (g x : G) :
    orderOf (g * x * g⁻¹) = orderOf x := by
  have h : orderOf ((MulAut.conj g) x) = orderOf x := (MulAut.conj g).orderOf_eq x
  rwa [MulAut.conj_apply] at h

/-- Conjugation inverts an element that is inverted by `g`. -/
private lemma conj_inv_of_conj_eq_inv {G : Type*} [Group G] {g x : G}
    (h : g * x * g⁻¹ = x⁻¹) : g⁻¹ * x * g = x⁻¹ := by
  have h2 : g * x⁻¹ * g⁻¹ = x := by
    rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group, h, inv_inv]
  calc g⁻¹ * x * g = g⁻¹ * (g * x⁻¹ * g⁻¹) * g := by rw [h2]
    _ = x⁻¹ := by group

/-- If `g * x * g⁻¹ = x`, then `g` commutes with `x`. -/
private lemma commute_of_conj_eq_self {G : Type*} [Group G] {g x : G}
    (h : g * x * g⁻¹ = x) : g * x = x * g := by
  calc g * x = (g * x * g⁻¹) * g := by group
    _ = x * g := by rw [h]

theorem Cstar_Nstar_Astar {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (d : Work.BrauerSuzuki.GenQuaternionData ↥S) (h2 : d.n = 2) {x : G}
    (hxS : x ∈ (S : Subgroup G)) (hx4 : orderOf x = 4) :
    let X : Subgroup G := Subgroup.zpowers x
    let T : Subgroup G := Subgroup.zpowers (x ^ 2)
    let Cstar : Subgroup G := Subgroup.centralizer (X : Set G)
    let Nstar : Subgroup G := Subgroup.normalizer (X : Set G)
    let Hstar : Subgroup G := (Submission.Blueprint.oddCore ↥Cstar).map Cstar.subtype
    X ⊔ Hstar = Cstar ∧ X ⊓ Hstar = ⊥ ∧
      (∀ a ∈ X, ∀ b ∈ Hstar, a * b = b * a) ∧
      Odd (Nat.card Hstar) ∧
      (S : Subgroup G) ≤ Nstar ∧ (S : Subgroup G) ⊔ Hstar = Nstar ∧
      Work.BrauerSuzuki.IsTISet ((Cstar : Set G) \ ((T : Set G) * (Hstar : Set G))) Nstar := by
  dsimp only
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set X : Subgroup G := Subgroup.zpowers x with hXdef
  set Cstar : Subgroup G := Subgroup.centralizer (X : Set G) with hCdef
  set Hstar : Subgroup G := (Submission.Blueprint.oddCore ↥Cstar).map Cstar.subtype with hHdef
  obtain ⟨_hbound, _hnonab, hcentral⟩ := sylow_two_structure_and_centralizer S d h2
  -- ## Basic cardinalities
  have hcardS : Nat.card ↥(S : Subgroup G) = 8 := by
    have h := (Work.BrauerSuzuki.Quaternion.genQuaternionData_basic d).1
    rw [h2] at h
    norm_num at h
    exact h
  have hxX : x ∈ X := by rw [hXdef]; exact Subgroup.mem_zpowers x
  have hXcard : Nat.card ↥X = 4 := by rw [hXdef, Nat.card_zpowers, hx4]
  have hXleC : X ≤ Cstar := by
    rw [hCdef]
    intro y hy
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    rw [hXdef] at hy hz
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
    rw [← zpow_add, ← zpow_add, add_comm]
  have hXS : X ≤ (S : Subgroup G) := by
    rw [hXdef]; exact Subgroup.zpowers_le.mpr hxS
  -- ## `X` is a Sylow `2`-subgroup of `Cstar`
  have hXsub_card : Nat.card ↥(X.subgroupOf Cstar) = 4 := by
    have h1 := Subgroup.card_map_of_injective (K := X.subgroupOf Cstar) (f := Cstar.subtype)
      Cstar.subtype_injective
    rw [Subgroup.subgroupOf_map_subtype, inf_of_le_left hXleC] at h1
    rw [← h1]
    exact hXcard
  have hAnySub : ∀ A : Subgroup ↥Cstar, IsPGroup 2 A → A ≤ X.subgroupOf Cstar := by
    intro A hA y hy
    have hyC : (y : G) ∈ Cstar := y.2
    have hcomm : (y : G) * x = x * (y : G) :=
      (Subgroup.mem_centralizer_iff.mp hyC x hxX).symm
    have h2pow : ∃ k : ℕ, orderOf (y : G) = 2 ^ k := by
      obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp hA) (⟨y, hy⟩ : ↥A)
      exact ⟨k, by
        calc orderOf (y : G) = orderOf y := Subgroup.orderOf_coe y
          _ = orderOf (⟨y, hy⟩ : ↥A) := Subgroup.orderOf_coe (⟨y, hy⟩ : ↥A)
          _ = 2 ^ k := hk⟩
    have hyX : (y : G) ∈ X := hcentral x hxS hx4 (y : G) hcomm h2pow
    exact Subgroup.mem_subgroupOf.mpr hyX
  have hnotdvd : ¬ 2 ∣ (X.subgroupOf Cstar).index := by
    have hXp : IsPGroup 2 ↥(X.subgroupOf Cstar) :=
      IsPGroup.of_card (n := 2) (by rw [hXsub_card]; norm_num)
    obtain ⟨P, hPle⟩ := IsPGroup.exists_le_sylow hXp
    have hPX : (P : Subgroup ↥Cstar) ≤ X.subgroupOf Cstar := hAnySub P P.isPGroup'
    have heq : (P : Subgroup ↥Cstar) = X.subgroupOf Cstar := le_antisymm hPX hPle
    have h := Sylow.not_dvd_index P
    rwa [heq] at h
  -- ## The normal `2`-complement of `Cstar`
  have hXcenter : X.subgroupOf Cstar ≤ Subgroup.center ↥Cstar := by
    intro y hy
    rw [Subgroup.mem_center_iff]
    intro c
    apply Subtype.ext
    have hyX : (y : G) ∈ X := Subgroup.mem_subgroupOf.mp hy
    exact (Subgroup.mem_centralizer_iff.mp c.2 (y : G) hyX).symm
  have hXnormal : (X.subgroupOf Cstar).Normal := Subgroup.normal_of_le_center hXcenter
  haveI : (X.subgroupOf Cstar).Normal := hXnormal
  have hXp : IsPGroup 2 ↥(X.subgroupOf Cstar) :=
    IsPGroup.of_card (n := 2) (by rw [hXsub_card]; norm_num)
  obtain ⟨K, hKnormal, hKcompl⟩ :=
    Work.LocalPrelim.normal_complement_of_central_sylow (G := ↥Cstar) (p := 2)
      (X.subgroupOf Cstar) hXp hnotdvd hXcenter
  have hKcard : Nat.card ↥K = (X.subgroupOf Cstar).index := by
    have hKi : K.index = 4 := by rw [hKcompl.index_eq_card, hXsub_card]
    have h1 : K.index * Nat.card ↥K = Nat.card ↥Cstar := Subgroup.index_mul_card K
    have h2 : Nat.card ↥(X.subgroupOf Cstar) * (X.subgroupOf Cstar).index = Nat.card ↥Cstar :=
      Subgroup.card_mul_index _
    rw [hXsub_card] at h2
    rw [hKi] at h1
    omega
  have hKodd : Odd (Nat.card ↥K) := by
    rw [hKcard]
    exact Nat.not_even_iff_odd.mp fun he => hnotdvd (even_iff_two_dvd.mp he)
  have hK_le_odd : K ≤ Submission.Blueprint.oddCore ↥Cstar := le_sSup ⟨hKnormal, hKodd⟩
  have hodd_le_K : Submission.Blueprint.oddCore ↥Cstar ≤ K := by
    haveI : K.Normal := hKnormal
    intro o ho
    have hdvd1 : orderOf ((QuotientGroup.mk' K) o) ∣
        Nat.card ↥(Submission.Blueprint.oddCore ↥Cstar) := by
      refine (orderOf_map_dvd (QuotientGroup.mk' K) o).trans ?_
      calc orderOf o = orderOf (⟨o, ho⟩ : ↥(Submission.Blueprint.oddCore ↥Cstar)) :=
            Subgroup.orderOf_coe (⟨o, ho⟩ : ↥(Submission.Blueprint.oddCore ↥Cstar))
        _ ∣ Nat.card ↥(Submission.Blueprint.oddCore ↥Cstar) :=
            orderOf_dvd_natCard (⟨o, ho⟩ : ↥(Submission.Blueprint.oddCore ↥Cstar))
    have hodd' : Odd (orderOf ((QuotientGroup.mk' K) o)) :=
      Odd.of_dvd_nat Work.BrauerSuzuki.OddCore.oddCard_oddCore hdvd1
    have hqcard : Nat.card (↥Cstar ⧸ K) = 4 := by
      rw [← Subgroup.index_eq_card, hKcompl.index_eq_card, hXsub_card]
    have hdvd2 : orderOf ((QuotientGroup.mk' K) o) ∣ 2 ^ 2 := by
      have h := orderOf_dvd_natCard ((QuotientGroup.mk' K) o)
      rw [hqcard] at h
      rwa [show (4 : ℕ) = 2 ^ 2 by norm_num] at h
    have hnot2 : ¬ 2 ∣ orderOf ((QuotientGroup.mk' K) o) :=
      fun h => Nat.not_even_iff_odd.mpr hodd' (even_iff_two_dvd.mpr h)
    have hone : orderOf ((QuotientGroup.mk' K) o) = 1 := by
      obtain ⟨i, _hi, hdi⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd2
      have hi0 : i = 0 := by
        rcases Nat.eq_zero_or_pos i with h0 | h0
        · exact h0
        · exact absurd (by rw [hdi]; exact dvd_pow_self 2 (Nat.pos_iff_ne_zero.mp h0)) hnot2
      rw [hi0, pow_zero] at hdi
      exact hdi
    have hq1 : (QuotientGroup.mk' K) o = 1 := by
      rw [← orderOf_eq_one_iff]
      exact hone
    exact (QuotientGroup.eq_one_iff o).mp hq1
  have hKeq : K = Submission.Blueprint.oddCore ↥Cstar := le_antisymm hK_le_odd hodd_le_K
  -- ## The first four conjuncts
  have hmap_top : Subgroup.map Cstar.subtype (⊤ : Subgroup ↥Cstar) = Cstar := by
    refine le_antisymm (Subgroup.map_subtype_le _) ?_
    intro c hc
    exact ⟨⟨c, hc⟩, Subgroup.mem_top _, rfl⟩
  have hmap_sub : Subgroup.map Cstar.subtype (X.subgroupOf Cstar) = X := by
    rw [Subgroup.subgroupOf_map_subtype, inf_of_le_left hXleC]
  have hsup : X ⊔ Hstar = Cstar := by
    have h1 : Subgroup.map Cstar.subtype ((X.subgroupOf Cstar) ⊔ K) =
        Subgroup.map Cstar.subtype (⊤ : Subgroup ↥Cstar) := by rw [hKcompl.sup_eq_top]
    rw [Subgroup.map_sup, hKeq] at h1
    rw [hmap_top, hmap_sub] at h1
    rw [hHdef]
    exact h1
  have hinf : X ⊓ Hstar = ⊥ := by
    rw [eq_bot_iff]
    intro y hy
    have hy2 : y ∈ (Submission.Blueprint.oddCore ↥Cstar).map Cstar.subtype := by
      rw [← hHdef]; exact hy.2
    obtain ⟨k, hkO, hky⟩ := Subgroup.mem_map.mp hy2
    have hkK : k ∈ K := by rw [hKeq]; exact hkO
    have hkX : k ∈ X.subgroupOf Cstar := by
      rw [Subgroup.mem_subgroupOf]
      show (k : G) ∈ X
      rw [show (k : G) = y from hky]
      exact hy.1
    have hkbot : k ∈ (⊥ : Subgroup ↥Cstar) := by
      have hd := hKcompl.disjoint
      rw [disjoint_iff_inf_le] at hd
      exact hd ⟨hkX, hkK⟩
    rw [Subgroup.mem_bot] at hkbot
    rw [Subgroup.mem_bot]
    rw [← hky, hkbot]
    rfl
  have hcommC : ∀ a ∈ X, ∀ b ∈ Hstar, a * b = b * a := by
    intro a ha b hb
    have hb2 : b ∈ (Submission.Blueprint.oddCore ↥Cstar).map Cstar.subtype := by
      rw [← hHdef]; exact hb
    obtain ⟨k, _hk, rfl⟩ := Subgroup.mem_map.mp hb2
    exact Subgroup.mem_centralizer_iff.mp k.2 a ha
  have hoddH : Odd (Nat.card ↥Hstar) := by
    rw [hHdef, Subgroup.card_map_of_injective Cstar.subtype_injective]
    exact Work.BrauerSuzuki.OddCore.oddCard_oddCore
  -- ## `S ≤ Nstar`
  have hSle : (S : Subgroup G) ≤ Subgroup.normalizer (X : Set G) := by
    have hidx : (X.subgroupOf (S : Subgroup G)).index = 2 := by
      have h1 : Nat.card ↥(X.subgroupOf (S : Subgroup G)) = 4 := by
        have h2 := Subgroup.card_map_of_injective (K := X.subgroupOf (S : Subgroup G))
          (f := (S : Subgroup G).subtype) (S : Subgroup G).subtype_injective
        rw [Subgroup.subgroupOf_map_subtype, inf_of_le_left hXS] at h2
        rw [← h2]
        exact hXcard
      have h3 := Subgroup.card_mul_index (X.subgroupOf (S : Subgroup G))
      rw [h1, hcardS] at h3
      omega
    haveI : (X.subgroupOf (S : Subgroup G)).Normal := Subgroup.normal_of_index_eq_two hidx
    rw [Subgroup.le_normalizer_iff]
    intro s hs y hy
    have hyS : y ∈ (S : Subgroup G) := hXS hy
    have hmem : (⟨y, hyS⟩ : ↥(S : Subgroup G)) ∈ X.subgroupOf (S : Subgroup G) :=
      Subgroup.mem_subgroupOf.mpr hy
    have hconj := (inferInstance : (X.subgroupOf (S : Subgroup G)).Normal).conj_mem
      (⟨y, hyS⟩ : ↥(S : Subgroup G)) hmem ⟨s, hs⟩
    rw [Subgroup.mem_subgroupOf] at hconj
    exact hconj
  -- ## `S ⊔ Hstar = Nstar`
  have hHleN : Hstar ≤ Subgroup.normalizer (X : Set G) := by
    rw [hHdef]
    exact (Subgroup.map_subtype_le _).trans (Subgroup.centralizer_le_normalizer (X : Set G))
  have hCleS : Cstar ≤ (S : Subgroup G) ⊔ Hstar := by
    rw [← hsup]
    exact sup_le (hXS.trans le_sup_left) le_sup_right
  have hsupN : (S : Subgroup G) ⊔ Hstar = Subgroup.normalizer (X : Set G) := by
    refine le_antisymm (sup_le hSle hHleN) ?_
    intro n hn
    by_cases hnc : n ∈ Cstar
    · exact hCleS hnc
    · obtain ⟨s, hsS, hsc⟩ := exists_sylow_element_not_commuting S d h2 hxS hx4
      have hsN : s ∈ Subgroup.normalizer (X : Set G) := hSle hsS
      have hs_notC : s ∉ Cstar := by
        rw [hCdef]
        exact fun h => hsc (commute_of_mem_centralizer_zpowers h)
      have hsx : s * x * s⁻¹ = x⁻¹ := by
        have hsmem : s * x * s⁻¹ ∈ X := by
          rw [Subgroup.mem_normalizer_iff] at hsN
          exact (hsN x).mp hxX
        have hso4 : orderOf (s * x * s⁻¹) = 4 := by rw [orderOf_conj_eq, hx4]
        have hsne : s * x * s⁻¹ ≠ x := by
          intro h
          exact hs_notC (mem_centralizer_zpowers_of_commute (commute_of_conj_eq_self h))
        rcases eq_or_eq_inv_of_mem_zpowers_of_orderOf_eq_four hx4 hsmem hso4 with h | h
        · exact absurd h hsne
        · exact h
      have hnx : n * x * n⁻¹ = x⁻¹ := by
        have hnm : n * x * n⁻¹ ∈ X := by
          rw [Subgroup.mem_normalizer_iff] at hn
          exact (hn x).mp hxX
        have hno4 : orderOf (n * x * n⁻¹) = 4 := by rw [orderOf_conj_eq, hx4]
        have hnne : n * x * n⁻¹ ≠ x := by
          intro h
          exact hnc (mem_centralizer_zpowers_of_commute (commute_of_conj_eq_self h))
        rcases eq_or_eq_inv_of_mem_zpowers_of_orderOf_eq_four hx4 hnm hno4 with h | h
        · exact absurd h hnne
        · exact h
      have hkey : (n * s⁻¹) * x * (n * s⁻¹)⁻¹ = x := by
        rw [show (n * s⁻¹) * x * (n * s⁻¹)⁻¹ = n * (s⁻¹ * x * s) * n⁻¹ by group,
          conj_inv_of_conj_eq_inv hsx]
        rw [show n * x⁻¹ * n⁻¹ = (n * x * n⁻¹)⁻¹ by group, hnx, inv_inv]
      have hns_inv : n * s⁻¹ ∈ Cstar := by
        rw [hCdef]
        apply mem_centralizer_zpowers_of_commute
        calc (n * s⁻¹) * x = ((n * s⁻¹) * x * (n * s⁻¹)⁻¹) * (n * s⁻¹) := by group
          _ = x * (n * s⁻¹) := by rw [hkey]
      rw [show n = (n * s⁻¹) * s by group]
      refine ((S : Subgroup G) ⊔ Hstar).mul_mem (hCleS hns_inv) ?_
      exact (show (S : Subgroup G) ≤ (S : Subgroup G) ⊔ Hstar from le_sup_left) hsS
  -- ## The TI-set conjunct
  have hnorm : ∀ n ∈ Subgroup.normalizer (X : Set G), ∀ h ∈ Hstar, n * h * n⁻¹ ∈ Hstar := by
    intro n hn h hh
    have hh2 : h ∈ (Submission.Blueprint.oddCore ↥Cstar).map Cstar.subtype := hh
    have key := oddCore_centralizer_map_normalized (Subgroup.zpowers x) n
      (by simpa only [hXdef] using hn) h (by simpa only [hCdef, hXdef] using hh2)
    simpa only [hCdef, hXdef] using key
  have hTIsup : Subgroup.zpowers x ⊔ Hstar = Subgroup.centralizer (Subgroup.zpowers x : Set G) := by
    rw [← hXdef, ← hCdef]
    exact hsup
  have hTIinf : Subgroup.zpowers x ⊓ Hstar = ⊥ := by
    rw [← hXdef]
    exact hinf
  have hTIcomm : ∀ a ∈ Subgroup.zpowers x, ∀ b ∈ Hstar, a * b = b * a := by
    intro a ha b hb
    exact hcommC a (by rwa [hXdef]) b hb
  have hTInorm : ∀ n ∈ Subgroup.normalizer (Subgroup.zpowers x : Set G), ∀ h ∈ Hstar,
      n * h * n⁻¹ ∈ Hstar := by
    intro n hn h hh
    exact hnorm n (by rwa [hXdef]) h hh
  have hTI := isTISet_cstar_diff hx4 hTIsup hTIinf hTIcomm hoddH hTInorm
  exact ⟨hsup, hinf, hcommC, hoddH, hSle, hsupN, by simpa only [hXdef, hCdef] using hTI⟩

end Work.BrauerSuzuki.Q8
