namespace Work.BrauerSuzuki.Dade

/-- If `x` and `y` commute and their orders are coprime, then `x` lies in the cyclic
subgroup generated by the product `x * y`.

The key point is the Chinese-remainder/Bézout existence: with `m = orderOf x` and
`n = orderOf y` coprime, `k = n * gcdB m n` satisfies `n ∣ k` (so `y ^ k = 1`) and
`m ∣ k - 1` (so `x ^ k = x`); hence `(x * y) ^ k = x ^ k * y ^ k = x`. -/
private theorem mem_zpowers_mul_of_coprime {G : Type*} [Group G] {x y : G}
    (h : Commute x y) (hcop : (orderOf x).Coprime (orderOf y)) :
    x ∈ Subgroup.zpowers (x * y) := by
  have hgcd : (orderOf x).gcd (orderOf y) = 1 := Nat.coprime_iff_gcd_eq_one.mp hcop
  have hbez : (orderOf x : ℤ) * Nat.gcdA (orderOf x) (orderOf y)
      + (orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y) = 1 := by
    have hh := Nat.gcd_eq_gcd_ab (orderOf x) (orderOf y)
    rw [hgcd] at hh
    simpa using hh.symm
  refine Subgroup.mem_zpowers_iff.mpr ⟨(orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y), ?_⟩
  -- `y ^ k = 1` since `orderOf y ∣ k`
  have hb : y ^ ((orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y)) = 1 :=
    orderOf_dvd_iff_zpow_eq_one.mp
      (dvd_mul_right (orderOf y : ℤ) (Nat.gcdB (orderOf x) (orderOf y)))
  -- `x ^ (k - 1) = 1` since `orderOf x ∣ k - 1` (Bézout)
  have hk1 : x ^ ((orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y) - 1) = 1 := by
    rw [← orderOf_dvd_iff_zpow_eq_one]
    refine ⟨-Nat.gcdA (orderOf x) (orderOf y), ?_⟩
    linarith
  -- hence `x ^ k = x`
  have hxk : x ^ ((orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y)) = x := by
    have hk : (orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y)
        = ((orderOf y : ℤ) * Nat.gcdB (orderOf x) (orderOf y) - 1) + 1 := by ring
    rw [hk, zpow_add, hk1, zpow_one, one_mul]
  rw [h.mul_zpow, hxk, hb, mul_one]

theorem zpowers_sup_of_commute_coprime {G : Type*} [Group G] [Finite G] {a b : G}
    (h : a * b = b * a) (hcop : (orderOf a).Coprime (orderOf b)) :
    Subgroup.zpowers a ⊔ Subgroup.zpowers b = Subgroup.zpowers (a * b) := by
  have hc : Commute a b := h
  have ha : a ∈ Subgroup.zpowers (a * b) := mem_zpowers_mul_of_coprime hc hcop
  have hb : b ∈ Subgroup.zpowers (a * b) := by
    have h2 : b ∈ Subgroup.zpowers (b * a) :=
      mem_zpowers_mul_of_coprime hc.symm hcop.symm
    rwa [← h] at h2
  refine le_antisymm ?_ ?_
  · exact sup_le (Subgroup.zpowers_le.mpr ha) (Subgroup.zpowers_le.mpr hb)
  · exact Subgroup.zpowers_le.mpr
      (mul_mem (Subgroup.mem_sup_left (Subgroup.mem_zpowers a))
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers b)))

end Work.BrauerSuzuki.Dade
