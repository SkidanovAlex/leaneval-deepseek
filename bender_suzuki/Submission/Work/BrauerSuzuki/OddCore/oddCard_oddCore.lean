import Mathlib
import Submission.Work.BrauerSuzuki.Defs
import Submission.Work.PGroup.card_sup_mul_card_inf_of_le_normalizer

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# The odd order core `O(G) = O_{2'}(G)` has odd order

`Submission.Blueprint.oddCore G` is the supremum of the normal subgroups of odd order, so a
priori it is only the subgroup generated by the normal odd-order subgroups.  The point of this
file is that it is itself of odd order.

The argument:

* the join `M ⊔ N` of two normal subgroups of odd order has odd order: with `M` normal the
  second isomorphism theorem gives `|M ⊔ N| * |M ⊓ N| = |M| * |N|`
  (`Work.PGroup.card_sup_mul_card_inf_of_le_normalizer`), so `|M ⊔ N|` divides the odd number
  `|M| * |N|`;
* hence the family of normal odd-order subgroups is directed under `⊔`; as it generates `O(G)`,
  every element of `O(G)` lies in a normal subgroup of odd order, so every element of `O(G)`
  has odd order;
* a finite group all of whose elements have odd order has odd order (Cauchy's theorem, in the
  form `exists_prime_orderOf_dvd_card`).
-/

set_option autoImplicit false

namespace Work.BrauerSuzuki.OddCore

open Submission.Blueprint

/-- The normal subgroups of odd order; `O(G)` is their supremum. -/
def oddNormalSubgroups (G : Type*) [Group G] : Set (Subgroup G) :=
  {N | N.Normal ∧ Odd (Nat.card ↥N)}

/-- `O(G)` is the supremum of the normal subgroups of odd order, by definition. -/
theorem oddCore_eq_sSup (G : Type*) [Group G] :
    Submission.Blueprint.oddCore G = sSup (oddNormalSubgroups G) := rfl

/-- Normal odd-order subgroups are closed under joins: `|M ⊔ N|` divides `|M| * |N|`, hence is
odd when `|M|` and `|N|` are. -/
theorem odd_sup_of_normal {G : Type*} [Group G] [Finite G] {M N : Subgroup G} (hM : M.Normal)
    (_hN : N.Normal) (hMo : Odd (Nat.card ↥M)) (hNo : Odd (Nat.card ↥N)) :
    Odd (Nat.card ↥(M ⊔ N)) := by
  have hcard : Nat.card ↥(M ⊔ N) * Nat.card ↥(M ⊓ N) = Nat.card ↥M * Nat.card ↥N :=
    Work.PGroup.card_sup_mul_card_inf_of_le_normalizer (H := M) (K := N)
      (Subgroup.le_normalizer_of_normal (H := M) (K := N))
  exact Odd.of_dvd_nat (Odd.mul hMo hNo) ⟨Nat.card ↥(M ⊓ N), hcard.symm⟩

/-- Every element of `O(G)` lies in a normal subgroup of `G` of odd order. -/
theorem exists_normal_odd_of_mem_oddCore {G : Type*} [Group G] [Finite G] {x : G}
    (hx : x ∈ Submission.Blueprint.oddCore G) :
    ∃ N : Subgroup G, N.Normal ∧ Odd (Nat.card ↥N) ∧ x ∈ N := by
  have hclosure : Submission.Blueprint.oddCore G =
      Subgroup.closure (⋃ N ∈ oddNormalSubgroups G, (N : Set G)) := by
    rw [oddCore_eq_sSup]
    apply le_antisymm
    · refine sSup_le_iff.mpr fun N hN y hy => Subgroup.subset_closure ?_
      exact Set.mem_iUnion.mpr ⟨N, Set.mem_iUnion.mpr ⟨hN, hy⟩⟩
    · rw [Subgroup.closure_le]
      intro y hy
      simp only [Set.mem_iUnion] at hy
      obtain ⟨N, hN, hyN⟩ := hy
      exact le_sSup hN hyN
  rw [hclosure] at hx
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
      simp only [Set.mem_iUnion] at hy
      obtain ⟨N, hN, hyN⟩ := hy
      simp only [oddNormalSubgroups, Set.mem_ofPred_eq] at hN
      exact ⟨N, hN.1, hN.2, hyN⟩
  | one => exact ⟨⊥, inferInstance, by simp, Subgroup.mem_bot.mpr rfl⟩
  | mul y z _ _ ihy ihz =>
      obtain ⟨M, hMnorm, hModd, hyM⟩ := ihy
      obtain ⟨N, hNnorm, hNodd, hzN⟩ := ihz
      exact ⟨M ⊔ N, inferInstance, odd_sup_of_normal hMnorm hNnorm hModd hNodd,
        Subgroup.mul_mem_sup hyM hzN⟩
  | inv y _ ih =>
      obtain ⟨N, hNnorm, hNodd, hyN⟩ := ih
      exact ⟨N, hNnorm, hNodd, N.inv_mem hyN⟩

/-- A finite group all of whose elements have odd order has odd order. -/
theorem odd_card_of_odd_order {H : Type*} [Group H] [Finite H] (h : ∀ x : H, Odd (orderOf x)) :
    Odd (Nat.card H) := by
  have := Fintype.ofFinite H
  by_contra hc
  rw [Nat.not_odd_iff_even, even_iff_two_dvd, Nat.card_eq_fintype_card] at hc
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card 2 hc
  obtain ⟨k, hk⟩ := h x
  rw [hx] at hk
  omega

/-- `|O(G)|` is odd. -/
theorem oddCard_oddCore {G : Type*} [Group G] [Finite G] :
    Odd (Nat.card (Submission.Blueprint.oddCore G)) := by
  have key : ∀ x : G, x ∈ Submission.Blueprint.oddCore G → Odd (orderOf x) := by
    intro x hx
    obtain ⟨N, _, hNodd, hxN⟩ := exists_normal_odd_of_mem_oddCore hx
    have h1 : Odd (orderOf (⟨x, hxN⟩ : N)) :=
      Odd.of_dvd_nat hNodd (orderOf_dvd_natCard (⟨x, hxN⟩ : N))
    have h2 : orderOf (⟨x, hxN⟩ : N) = orderOf x := (Subgroup.orderOf_coe _).symm
    rwa [h2] at h1
  apply odd_card_of_odd_order
  intro y
  have := key (y : G) y.2
  rwa [Subgroup.orderOf_coe] at this

end Work.BrauerSuzuki.OddCore
