/-!
# A nonabelian finite `2`-group with a unique involution has a cyclic subgroup of index `2`

Induction step of Huppert, *Endliche Gruppen I*, III.8.2.  Let `P` be a finite `2`-group with a
unique involution, nonabelian, and assume every proper subgroup of `P` is cyclic or generalized
quaternion.  We show that `P` has a cyclic subgroup of index two.

Arguing by contradiction, suppose no cyclic subgroup of index two exists, and let `M ≤ P` be a
subgroup of index two.  Then `M` is not cyclic, hence generalized quaternion with normal form
`d : GenQuaternionData ↥M`; write `τ = d.tau` and `A₀ = ⟨τ⟩ ≤ P` (so `|A₀| = 2 ^ d.n`,
`A₀ ⊴ P`, `|P : A₀| = 4`).  The proof then considers `x ∉ M`:

* `x² ∈ M`.  If `x² ∉ A₀`, then `x²` inverts `τ` while `x τ x⁻¹ = τ ^ t` is a power of `τ`;
  comparing `x² τ x⁻² = τ ^ (t * t) = τ⁻¹` gives `2 ^ d.n ∣ t² + 1`, impossible for `d.n ≥ 3`.
* If `x² ∈ A₀`, then the subgroup generated by `A₀` and `x` has index two; it is cyclic
  (contradiction) or generalized quaternion, in which case `x` inverts the generator of `A₀`.
  Since `ρ = d.rho` also inverts `A₀`, the element `x * ρ` centralizes `τ`; but any element of
  `P` centralizing `τ` already lies in `A₀`, while `x * ρ ∉ A₀`.

The case `d.n = 2` (`M ≅ Q₈`) is handled separately in
`false_of_index_two_genQuaternionData_two`.
-/

/-! ## Elementary auxiliary lemmas -/

private lemma two_pow_succ (n : ℕ) : (2 : ℕ) ^ (n + 1) = 2 * 2 ^ n := pow_succ' 2 n

private lemma two_pow_add_two (n : ℕ) : (2 : ℕ) ^ (n + 2) = 2 * 2 ^ (n + 1) := by
  have h := pow_succ' 2 (n + 1)
  rw [show n + 1 + 1 = n + 2 by omega] at h
  exact h

private lemma two_pow_add_two_four (n : ℕ) : (2 : ℕ) ^ (n + 2) = 4 * 2 ^ n := by
  rw [two_pow_add_two, two_pow_succ]
  ring

private lemma pow_two_eq_two_mul (m : ℕ) (hm : 1 ≤ m) : (2 : ℕ) ^ m = 2 * 2 ^ (m - 1) := by
  have h := pow_succ' 2 (m - 1)
  rw [show m - 1 + 1 = m by omega] at h
  exact h

/-- In a finite group, membership in a cyclic subgroup is witnessed by a natural exponent. -/
private lemma mem_zpowers_iff_exists_pow {G : Type*} [Group G] [Finite G] {a b : G} :
    b ∈ Subgroup.zpowers a ↔ ∃ n : ℕ, a ^ n = b :=
  (isOfFinOrder_of_finite a).mem_powers_iff_mem_zpowers.symm.trans (Submonoid.mem_powers_iff b a)

/-- Transporting `Subgroup.zpowers` along an inclusion of subgroups. -/
private lemma map_zpowers_subtype_eq {P : Type*} [Group P] (M : Subgroup P) (g : ↥M) :
    (Subgroup.zpowers g).map M.subtype = Subgroup.zpowers (g : P) := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.map_le_iff_le_comap, Subgroup.zpowers_le]
    exact Subgroup.mem_zpowers _
  · rw [Subgroup.zpowers_le, Subgroup.mem_map]
    exact ⟨g, Subgroup.mem_zpowers g, rfl⟩

/-- An element of a finite group whose order is half the order of the group generates a subgroup
of index two. -/
private lemma index_zpowers_eq_two {G : Type*} [Group G] [Finite G] {x : G} {m : ℕ}
    (hcard : Nat.card G = 2 ^ m) (hm : 1 ≤ m) (hord : orderOf x = 2 ^ (m - 1)) :
    (Subgroup.zpowers x).index = 2 := by
  have h1 : (Subgroup.zpowers x).index * 2 ^ (m - 1) = 2 ^ m := by
    have h := Subgroup.index_mul_card (Subgroup.zpowers x)
    rw [Nat.card_zpowers, hord, hcard] at h
    exact h
  rw [pow_two_eq_two_mul m hm] at h1
  exact Nat.mul_right_cancel (by positivity) h1

/-- If `c` conjugates `z` to its inverse, it conjugates every element of `⟨z⟩` to its inverse. -/
private lemma inverts_zpowers_of_inverts {G : Type*} [Group G] {c z : G}
    (h : c * z * c⁻¹ = z⁻¹) : ∀ a ∈ Subgroup.zpowers z, c * a * c⁻¹ = a⁻¹ := by
  intro a ha
  obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
  rw [show c * z ^ j * c⁻¹ = (c * z * c⁻¹) ^ j from (conj_zpow (i := j) (a := c) (b := z)).symm,
    h, inv_zpow]

/-- `τ = τ⁻¹` forces `τ ^ 2 = 1`. -/
private lemma pow_two_eq_one_of_eq_inv {G : Type*} [Group G] {τ : G} (h : τ = τ⁻¹) :
    τ ^ 2 = 1 := by
  rw [pow_two]
  nth_rewrite 2 [h]
  exact mul_inv_cancel τ

/-! ## Elementary facts about the index-two subgroup `M` and `A₀ = ⟨τ⟩` -/

/-- If `M ≤ P` has index two and `d : GenQuaternionData ↥M`, then the cyclic subgroup generated
by `τ = d.tau` has index four in `P`. -/
private lemma zpowers_index_eq_four {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (hMidx : M.index = 2) (d : GenQuaternionData ↥M) :
    (Subgroup.zpowers (d.tau : P)).index = 4 := by
  have hτord : orderOf (d.tau : P) = 2 ^ d.n := by
    rw [Subgroup.orderOf_coe d.tau, d.tau_order]
  have hMcard : Nat.card ↥M = 2 ^ (d.n + 1) := (genQuaternionData_basic d).1
  have hPcard : Nat.card P = 2 ^ (d.n + 2) := by
    have h := Subgroup.index_mul_card M
    rw [hMidx, hMcard] at h
    rw [h.symm, two_pow_add_two (d.n)]
  have h := Subgroup.index_mul_card (Subgroup.zpowers (d.tau : P))
  rw [Nat.card_zpowers, hτord, hPcard, two_pow_add_two_four (d.n)] at h
  exact Nat.mul_right_cancel (by positivity) h

/-- In the situation above, `A₀ = ⟨τ⟩` is normal in `P` when `3 ≤ d.n`: an element of `M` of
order `2 ^ d.n` is already a power of `τ` (all elements outside `⟨τ⟩` have order `4`). -/
private lemma zpowers_normal_of_index_two {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (hMidx : M.index = 2) (d : GenQuaternionData ↥M) (h3 : 3 ≤ d.n) :
    (Subgroup.zpowers (d.tau : P)).Normal := by
  have hMnorm : M.Normal := Subgroup.normal_of_index_eq_two hMidx
  refine ⟨fun n hn g => ?_⟩
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
  have hconjM : g * (d.tau : P) * g⁻¹ ∈ M := hMnorm.conj_mem (d.tau : P) d.tau.2 g
  have hconjord : orderOf (g * (d.tau : P) * g⁻¹) = 2 ^ d.n := by
    rw [orderOf_conj_eq g (d.tau : P), Subgroup.orderOf_coe d.tau, d.tau_order]
  have hmem : (⟨g * (d.tau : P) * g⁻¹, hconjM⟩ : ↥M) ∈ Subgroup.zpowers d.tau :=
    mem_zpowers_tau_of_orderOf d h3 (by rw [Subgroup.orderOf_mk]; exact hconjord)
  have hmemMap : g * (d.tau : P) * g⁻¹ ∈ (Subgroup.zpowers d.tau).map M.subtype :=
    Subgroup.mem_map.mpr ⟨_, hmem, rfl⟩
  rw [map_zpowers_subtype_eq M d.tau] at hmemMap
  rw [show g * (d.tau : P) ^ k * g⁻¹ = (g * (d.tau : P) * g⁻¹) ^ k from
      (conj_zpow (i := k) (a := g) (b := (d.tau : P))).symm]
  exact (Subgroup.zpowers_le.mpr hmemMap) (Subgroup.mem_zpowers_iff.mpr ⟨k, rfl⟩)

/-- An element of `M` of order `2 ^ d.n` (with `3 ≤ d.n`) generates a subgroup of `⟨τ⟩`. -/
private lemma mem_zpowers_of_orderOf_of_mem {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (d : GenQuaternionData ↥M) (h3 : 3 ≤ d.n) {g : P} (hg : g ∈ M)
    (hord : orderOf g = 2 ^ d.n) : g ∈ Subgroup.zpowers (d.tau : P) := by
  have hmem : (⟨g, hg⟩ : ↥M) ∈ Subgroup.zpowers d.tau :=
    mem_zpowers_tau_of_orderOf d h3 (by rw [Subgroup.orderOf_mk]; exact hord)
  have hmap : g ∈ (Subgroup.zpowers d.tau).map M.subtype := Subgroup.mem_map.mpr ⟨_, hmem, rfl⟩
  rwa [map_zpowers_subtype_eq M d.tau] at hmap

/-- An element of `M` lying outside `⟨τ⟩` has order `4` and inverts `τ`. -/
private lemma orderOf_eq_four_of_notMem {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (d : GenQuaternionData ↥M) {g : P} (hg : g ∈ M)
    (hng : g ∉ Subgroup.zpowers (d.tau : P)) :
    orderOf g = 4 ∧ g * (d.tau : P) * g⁻¹ = (d.tau : P)⁻¹ := by
  have hng' : (⟨g, hg⟩ : ↥M) ∉ Subgroup.zpowers d.tau := by
    intro hmem
    have hmap : g ∈ (Subgroup.zpowers d.tau).map M.subtype := Subgroup.mem_map.mpr ⟨_, hmem, rfl⟩
    rw [map_zpowers_subtype_eq M d.tau] at hmap
    exact hng hmap
  have h := (genQuaternionData_basic d).2.2.2.2 ⟨g, hg⟩ hng'
  refine ⟨?_, ?_⟩
  · rw [← Subgroup.orderOf_mk g hg]; exact h.1
  · have h2 := congrArg Subtype.val h.2
    simpa using h2

/-- `τ = τ⁻¹` is incompatible with the generalized quaternion normal form when `3 ≤ d.n`. -/
private lemma false_of_tau_eq_inv {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (d : GenQuaternionData ↥M) (h3 : 3 ≤ d.n) (h : (d.tau : P) = ((d.tau : P))⁻¹) : False := by
  have hτord : orderOf (d.tau : P) = 2 ^ d.n := by
    rw [Subgroup.orderOf_coe d.tau, d.tau_order]
  have h2 : (d.tau : P) ^ 2 = 1 := pow_two_eq_one_of_eq_inv h
  have hdvd : 2 ^ d.n ∣ 2 := by
    rw [← hτord]
    exact orderOf_dvd_iff_pow_eq_one.mpr h2
  have hle : 2 ^ d.n ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
  have hge : 8 ≤ 2 ^ d.n := by
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ d.n := Nat.pow_le_pow_right (by norm_num) h3
  omega

/-! ## The index-two subgroup generated by `A₀` and an element `x` with `x² ∈ A₀` -/

/-- If `A ⊴ P` has index `4` in a finite group `P` and `x ∉ A` satisfies `x ^ 2 ∈ A`, then the
preimage in `P` of the subgroup of `P ⧸ A` generated by the image of `x` has index `2`. -/
private lemma exists_index_two_of_sq_mem {P : Type*} [Group P] [Finite P] {A : Subgroup P}
    (hA : A.Normal) (hAidx : A.index = 4) {x : P} (hx2 : x ^ 2 ∈ A) (hx : x ∉ A) :
    ∃ N : Subgroup P, A ≤ N ∧ x ∈ N ∧ N.index = 2 ∧ A.relIndex N = 2 := by
  haveI : A.Normal := hA
  let q : P →* P ⧸ A := QuotientGroup.mk' A
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective A
  let B : Subgroup (P ⧸ A) := Subgroup.zpowers (q x)
  have hAleN : A ≤ B.comap q := by
    intro a ha
    show q a ∈ B
    rw [show q a = 1 from (QuotientGroup.eq_one_iff (N := A) a).mpr ha]
    exact Subgroup.one_mem B
  have hxN : x ∈ B.comap q := Subgroup.mem_zpowers (q x)
  have hBidx : B.index = 2 := by
    have hQ : Nat.card (P ⧸ A) = 4 := by rw [← Subgroup.index_eq_card A, hAidx]
    have hord : orderOf (q x) = 2 := by
      refine orderOf_eq_prime ?_ ?_
      · show (q x) ^ 2 = 1
        rw [← map_pow]
        exact (QuotientGroup.eq_one_iff (N := A) (x ^ 2)).mpr hx2
      · intro h
        exact hx ((QuotientGroup.eq_one_iff (N := A) x).mp h)
    have hBcard : Nat.card B = 2 := by rw [Nat.card_zpowers, hord]
    have h := Subgroup.index_mul_card B
    rw [hBcard, hQ] at h
    omega
  have hNidx : (B.comap q).index = 2 := by
    rw [Subgroup.index_comap_of_surjective B hq]
    exact hBidx
  refine ⟨B.comap q, hAleN, hxN, hNidx, ?_⟩
  have h := Subgroup.relIndex_mul_index hAleN
  rw [hNidx, hAidx] at h
  omega

/-- In a generalized quaternion group `N` with `3 ≤ dN.n`, a cyclic subgroup of order
`2 ^ dN.n` is the subgroup generated by `dN.tau`. -/
private lemma zpowers_eq_zpowers_tau_of_mem {P : Type*} [Group P] [Finite P] {N : Subgroup P}
    (dN : GenQuaternionData ↥N) (h3 : 3 ≤ dN.n) {z : P} (hzN : z ∈ N)
    (hzord : orderOf z = 2 ^ dN.n) :
    Subgroup.zpowers z = Subgroup.zpowers ((dN.tau : ↥N) : P) := by
  have hmem : z ∈ (Subgroup.zpowers dN.tau).map N.subtype :=
    Subgroup.mem_map.mpr ⟨⟨z, hzN⟩,
      mem_zpowers_tau_of_orderOf dN h3 (by rw [Subgroup.orderOf_mk]; exact hzord), rfl⟩
  rw [map_zpowers_subtype_eq N dN.tau] at hmem
  refine Subgroup.eq_of_le_of_card_ge (by rw [Subgroup.zpowers_le]; exact hmem) ?_
  rw [Nat.card_zpowers, Nat.card_zpowers, Subgroup.orderOf_coe dN.tau, dN.tau_order, hzord]

/-- An element of `N` outside the cyclic index-two subgroup `⟨dN.tau⟩` inverts `dN.tau`, hence
inverts every element of `⟨dN.tau⟩`. -/
private lemma inverts_tau_of_mem_notMem {P : Type*} [Group P] [Finite P] {N : Subgroup P}
    (dN : GenQuaternionData ↥N) {x : P} (hxN : x ∈ N)
    (hx : x ∉ Subgroup.zpowers ((dN.tau : ↥N) : P)) :
    ∀ a ∈ Subgroup.zpowers ((dN.tau : ↥N) : P), x * a * x⁻¹ = a⁻¹ := by
  have hx' : (⟨x, hxN⟩ : ↥N) ∉ Subgroup.zpowers dN.tau := by
    intro hmem
    have hmap : x ∈ (Subgroup.zpowers dN.tau).map N.subtype :=
      Subgroup.mem_map.mpr ⟨_, hmem, rfl⟩
    rw [map_zpowers_subtype_eq N dN.tau] at hmap
    exact hx hmap
  have hinv : (⟨x, hxN⟩ : ↥N) * dN.tau * (⟨x, hxN⟩ : ↥N)⁻¹ = dN.tau⁻¹ :=
    ((genQuaternionData_basic dN).2.2.2.2 ⟨x, hxN⟩ hx').2
  have hconj : x * ((dN.tau : ↥N) : P) * x⁻¹ = (((dN.tau : ↥N) : P))⁻¹ := by
    have := congrArg Subtype.val hinv
    simpa using this
  exact inverts_zpowers_of_inverts hconj

/-! ## The centralizer of `τ`

The key structural input: under the standing contradiction (no cyclic subgroup of index two),
the only elements of `P` commuting with `τ` are the elements of `A₀ = ⟨τ⟩`. -/
private lemma centralizer_tau_eq_zpowers {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (hMidx : M.index = 2) (d : GenQuaternionData ↥M) (h3 : 3 ≤ d.n)
    (hcon : ¬ ∃ A : Subgroup P, IsCyclic A ∧ A.index = 2)
    (ih : ∀ K : Subgroup P, K ≠ ⊤ → Work.BrauerSuzuki.IsCyclicOrGenQuaternion ↥K)
    {g : P} (hg : g * (d.tau : P) * g⁻¹ = (d.tau : P)) :
    g ∈ Subgroup.zpowers (d.tau : P) := by
  have hA₀norm : (Subgroup.zpowers (d.tau : P)).Normal :=
    zpowers_normal_of_index_two hMidx d h3
  have hA₀idx : (Subgroup.zpowers (d.tau : P)).index = 4 :=
    zpowers_index_eq_four hMidx d
  have hA₀leM : Subgroup.zpowers (d.tau : P) ≤ M := by
    rw [Subgroup.zpowers_le]; exact d.tau.2
  have hg2M : g ^ 2 ∈ M := Subgroup.sq_mem_of_index_two hMidx g
  have hg2A₀ : g ^ 2 ∈ Subgroup.zpowers (d.tau : P) := by
    by_contra hnot
    obtain ⟨-, hinv⟩ := orderOf_eq_four_of_notMem d hg2M hnot
    have hstep : g ^ 2 * (d.tau : P) * (g ^ 2)⁻¹
        = g * (g * (d.tau : P) * g⁻¹) * g⁻¹ := by
      rw [pow_two, mul_inv_rev]; group
    have hcent : g ^ 2 * (d.tau : P) * (g ^ 2)⁻¹ = (d.tau : P) := by
      rw [hstep, hg]; exact hg
    exact false_of_tau_eq_inv d h3 (hcent.symm.trans hinv)
  by_cases hgM : g ∈ M
  · by_contra hgA₀
    obtain ⟨-, hinv⟩ := orderOf_eq_four_of_notMem d hgM hgA₀
    exact false_of_tau_eq_inv d h3 (hg.symm.trans hinv)
  · have hgA₀ : g ∉ Subgroup.zpowers (d.tau : P) := fun h => hgM (hA₀leM h)
    obtain ⟨N, hA₀leN, hgN, hNidx, -⟩ :=
      exists_index_two_of_sq_mem hA₀norm hA₀idx hg2A₀ hgA₀
    have hNtop : N ≠ ⊤ := by
      intro h; rw [h, Subgroup.index_top] at hNidx; omega
    rcases ih N hNtop with hNcyc | hNgen
    · exact absurd ⟨N, hNcyc, hNidx⟩ hcon
    · obtain ⟨dN⟩ := hNgen
      have hNcard : Nat.card ↥N = 2 ^ (d.n + 1) := by
        have hPcard : Nat.card P = 2 ^ (d.n + 2) := by
          have h := Subgroup.index_mul_card M
          rw [hMidx, (genQuaternionData_basic d).1] at h
          rw [h.symm, two_pow_add_two (d.n)]
        have h := Subgroup.index_mul_card N
        rw [hNidx, hPcard, two_pow_add_two (d.n)] at h
        exact Nat.mul_left_cancel (by norm_num) h
      have hdNn : dN.n = d.n := by
        have h1 : (2 : ℕ) ^ (dN.n + 1) = 2 ^ (d.n + 1) := by
          rw [← (genQuaternionData_basic dN).1, hNcard]
        exact Nat.add_right_cancel (Nat.pow_right_injective (by norm_num) h1)
      have h3N : 3 ≤ dN.n := by omega
      have hτord : orderOf (d.tau : P) = 2 ^ d.n := by
        rw [Subgroup.orderOf_coe d.tau, d.tau_order]
      have hτNmem : (d.tau : P) ∈ N := hA₀leN (Subgroup.mem_zpowers _)
      have hA₀eq : Subgroup.zpowers (d.tau : P) = Subgroup.zpowers ((dN.tau : ↥N) : P) :=
        zpowers_eq_zpowers_tau_of_mem dN h3N hτNmem (by rw [hτord, hdNn])
      have hgN' : g ∉ Subgroup.zpowers ((dN.tau : ↥N) : P) := by
        rw [← hA₀eq]; exact hgA₀
      have hgtau := inverts_tau_of_mem_notMem dN hgN hgN' (d.tau : P)
        (by rw [← hA₀eq]; exact Subgroup.mem_zpowers _)
      exact (false_of_tau_eq_inv d h3 (hg.symm.trans hgtau)).elim

/-! ## The case `d.n = 2`

Here `M ≅ Q₈` and `|P| = 16`; we show that `P` necessarily has an element of order `8`, so under
the hypothesis that it does not we reach a contradiction: any `x ∉ M` inverts `M` elementwise,
which forces `M` to be commutative, contradicting `M ≅ Q₈`. -/

/-- In a generalized quaternion group with `d.n = 2` (isomorphic to `Q₈`), every element has
order dividing `4`. -/
private lemma orderOf_dvd_four_of_mem {P : Type*} [Group P] [Finite P] {M : Subgroup P}
    (d : GenQuaternionData ↥M) (h2 : d.n = 2) {g : P} (hg : g ∈ M) : orderOf g ∣ 4 := by
  by_cases hA : g ∈ Subgroup.zpowers (d.tau : P)
  · obtain ⟨k, hk⟩ := (mem_zpowers_iff_exists_pow (a := (d.tau : P)) (b := g)).mp hA
    rw [← hk]
    refine (orderOf_pow_dvd k).trans ?_
    rw [Subgroup.orderOf_coe d.tau, d.tau_order, h2]
    norm_num
  · rw [(orderOf_eq_four_of_notMem d hg hA).1]

/-- An element of order `4` has square of order `2`. -/
private lemma orderOf_sq_eq_two_of_orderOf_eq_four {G : Type*} [Group G] {g : G}
    (h : orderOf g = 4) : orderOf (g ^ 2) = 2 := by
  refine orderOf_eq_prime ?_ ?_
  · rw [← pow_mul, show (2 : ℕ) * 2 = 4 by norm_num, ← h]
    exact pow_orderOf_eq_one g
  · intro h1
    have hd : orderOf g ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr h1
    rw [h] at hd
    norm_num at hd

/-- If `orderOf (y ^ 2) = 4` then `orderOf y = 8`. -/
private lemma orderOf_eq_eight_of_orderOf_sq_eq_four {G : Type*} [Group G] {y : G}
    (h4 : orderOf (y ^ 2) = 4) : orderOf y = 8 := by
  have hne : ¬ (y ^ 2) ^ 2 = 1 := by
    intro h
    have := orderOf_dvd_iff_pow_eq_one.mpr h
    rw [h4] at this
    norm_num at this
  have hfin : (y ^ 2) ^ 4 = 1 := by rw [← h4]; exact pow_orderOf_eq_one _
  have hnot4 : ¬ y ^ 4 = 1 := by
    intro h
    apply hne
    have hm := pow_mul y 2 2
    rw [show (2 : ℕ) * 2 = 4 by norm_num] at hm
    rw [← hm]; exact h
  have h8 : y ^ 8 = 1 := by
    have hm := (pow_mul y 2 4).trans hfin
    rw [show (2 : ℕ) * 4 = 8 by norm_num] at hm
    exact hm
  have hdvd : orderOf y ∣ 2 ^ 3 := by
    rw [show (2 : ℕ) ^ 3 = 8 by norm_num]
    exact orderOf_dvd_iff_pow_eq_one.mpr h8
  obtain ⟨j, hjle, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  have hj3 : j = 3 := by
    by_contra h3'
    have hjle2 : j ≤ 2 := by omega
    have hdvd4 : orderOf y ∣ 4 := by
      rw [hj, show (4 : ℕ) = 2 ^ 2 by norm_num]
      exact pow_dvd_pow 2 hjle2
    exact hnot4 (orderOf_dvd_iff_pow_eq_one.mp hdvd4)
  rw [hj, hj3]
  norm_num

/-- In a generalized quaternion group with `d.n = 2` containing an index-two subgroup `M`, if `P`
has no element of order `8` then we reach a contradiction.

(Public rather than `private`, so that the equivalent statement
`Work.BrauerSuzuki.Group.false_of_index_two_genQuaternionData_two` promised by the module
docstring can be derived from it.) -/
lemma false_of_genQuaternionData_two {P : Type*} [Group P] [Finite P]
    (M : Subgroup P) (hMidx : M.index = 2) (d : GenQuaternionData ↥M)
    (h2n : d.n = 2) (hu : Work.BrauerSuzuki.HasUniqueInvolution P)
    (hno : ∀ y : P, orderOf y ≠ 8) : False := by
  obtain ⟨z, hzord, hzuniq⟩ := hu
  have hzcent : ∀ y : P, y * z * y⁻¹ = z := fun y =>
    hzuniq _ (by rw [orderOf_conj_eq y z, hzord])
  have hzinv : z⁻¹ = z := by
    refine inv_eq_of_mul_eq_one_left ?_
    rw [← pow_two, ← hzord]
    exact pow_orderOf_eq_one z
  have hzM : z ∈ M := by
    have hz2 : orderOf (((d.tau : ↥M) ^ (2 ^ (d.n - 1)) : ↥M) : P) = 2 := by
      rw [Subgroup.orderOf_coe]
      exact (genQuaternionData_basic d).2.2.1
    rw [(hzuniq _ hz2).symm]
    simpa using Subgroup.pow_mem M d.tau.2 (2 ^ (d.n - 1))
  have hMtop : M ≠ ⊤ := by
    intro h; rw [h, Subgroup.index_top] at hMidx; omega
  obtain ⟨x, hxM⟩ : ∃ x : P, x ∉ M := by
    by_contra hc
    push_neg at hc
    refine hMtop ?_
    rw [Subgroup.eq_top_iff']; exact hc
  -- an element outside `M` squares to `z`
  have sqz : ∀ y : P, y ∉ M → y ^ 2 = z := by
    intro y hyM
    have hy2M : y ^ 2 ∈ M := Subgroup.sq_mem_of_index_two hMidx y
    have hdvd : orderOf (y ^ 2) ∣ 2 ^ 2 := by
      rw [show (2 : ℕ) ^ 2 = 4 by norm_num]
      exact orderOf_dvd_four_of_mem d h2n hy2M
    have hyne : y ≠ 1 := fun h => hyM (h ▸ Subgroup.one_mem M)
    have hcases : orderOf (y ^ 2) = 1 ∨ orderOf (y ^ 2) = 2 ∨ orderOf (y ^ 2) = 4 := by
      obtain ⟨k, hk2, hkg⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
      interval_cases k
      · left; rw [hkg]; norm_num
      · right; left; rw [hkg]; norm_num
      · right; right; rw [hkg]; norm_num
    rcases hcases with h1 | h2' | h4
    · have hy1 : y ^ 2 = 1 := orderOf_eq_one_iff.mp h1
      have hord : orderOf y = 2 := orderOf_eq_prime hy1 hyne
      rw [hzuniq y hord] at hyM
      exact absurd hzM hyM
    · exact hzuniq (y ^ 2) h2'
    · exact absurd (orderOf_eq_eight_of_orderOf_sq_eq_four h4) (hno y)
  have hx2 : x ^ 2 = z := sqz x hxM
  -- `x` inverts every element of `M`
  have hconj : ∀ g ∈ M, x * g * x⁻¹ = g⁻¹ := by
    intro g hgM
    have hdvd : orderOf g ∣ 2 ^ 2 := by
      rw [show (2 : ℕ) ^ 2 = 4 by norm_num]
      exact orderOf_dvd_four_of_mem d h2n hgM
    have hcases : orderOf g = 1 ∨ orderOf g = 2 ∨ orderOf g = 4 := by
      obtain ⟨k, hk2, hkg⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
      interval_cases k
      · left; rw [hkg]; norm_num
      · right; left; rw [hkg]; norm_num
      · right; right; rw [hkg]; norm_num
    rcases hcases with h1 | h2' | h4
    · rw [orderOf_eq_one_iff.mp h1]; simp
    · rw [hzuniq g h2', hzcent x, hzinv]
    · have hg2 : g ^ 2 = z := hzuniq _ (orderOf_sq_eq_two_of_orderOf_eq_four h4)
      have hxgM : x * g ∉ M := fun h => hxM (by
        have hx' : x = (x * g) * g⁻¹ := by group
        rw [hx']
        exact Subgroup.mul_mem M h (Subgroup.inv_mem M hgM))
      have hxg2 : (x * g) ^ 2 = z := sqz (x * g) hxgM
      have key : x * g * (x * g) = g * g := by
        rw [← pow_two, ← pow_two, hxg2, hg2]
      have hxgeq : x * g = g * x⁻¹ := by
        calc x * g = (x * g * (x * g)) * (g⁻¹ * x⁻¹) := by group
          _ = (g * g) * (g⁻¹ * x⁻¹) := by rw [key]
          _ = g * x⁻¹ := by group
      calc x * g * x⁻¹ = (g * x⁻¹) * x⁻¹ := by rw [hxgeq]
        _ = g * (x ^ 2)⁻¹ := by rw [mul_assoc, ← mul_inv_rev, ← pow_two]
        _ = g * z⁻¹ := by rw [hx2]
        _ = g * z := by rw [hzinv]
        _ = g⁻¹ := by
          rw [← hg2, ← pow_succ']
          refine eq_inv_of_mul_eq_one_left ?_
          rw [← pow_succ, show (2 + 1 : ℕ) + 1 = 4 by norm_num, ← h4]
          exact pow_orderOf_eq_one g
  -- consequently `M` is commutative
  have hcomm : ∀ g h : P, g ∈ M → h ∈ M → g * h = h * g := by
    intro g h hg hh
    have h1 : x * (g * h) * x⁻¹ = (g * h)⁻¹ := hconj (g * h) (Subgroup.mul_mem M hg hh)
    have h2 : x * (g * h) * x⁻¹ = g⁻¹ * h⁻¹ := by
      rw [show x * (g * h) * x⁻¹ = (x * g * x⁻¹) * (x * h * x⁻¹) from by group,
        hconj g hg, hconj h hh]
    rw [h1, mul_inv_rev] at h2
    have := congrArg Inv.inv h2
    simpa using this
  -- but `τ` and `ρ` do not commute
  have hthis : (d.tau : P) * (d.rho : P) = (d.rho : P) * (d.tau : P) :=
    hcomm d.tau d.rho d.tau.2 d.rho.2
  have h1 : (d.rho : P) * (d.tau : P) * (d.rho : P)⁻¹ = ((d.tau : P))⁻¹ := by
    have := congrArg Subtype.val d.rho_conj
    simpa using this
  rw [hthis.symm, mul_assoc, mul_inv_cancel, mul_one] at h1
  have h2 : (d.tau : P) ^ 2 = 1 := by
    rw [pow_two]; nth_rewrite 2 [h1]; exact mul_inv_cancel _
  have hτord' : orderOf (d.tau : P) = 2 ^ d.n := by
    rw [Subgroup.orderOf_coe d.tau, d.tau_order]
  have hdvd : 2 ^ d.n ∣ 2 := by
    rw [← hτord']
    exact orderOf_dvd_iff_pow_eq_one.mpr h2
  rw [h2n, show (2 : ℕ) ^ 2 = 4 by norm_num] at hdvd
  norm_num at hdvd

/-! ## The main theorem -/

theorem exists_cyclic_index_two {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (hu : Work.BrauerSuzuki.HasUniqueInvolution P) (hnc : ¬ IsMulCommutative P)
    (ih : ∀ K : Subgroup P, K ≠ ⊤ → Work.BrauerSuzuki.IsCyclicOrGenQuaternion ↥K) :
    ∃ A : Subgroup P, IsCyclic A ∧ A.index = 2 := by
  by_contra hcon
  obtain ⟨M, hMidx⟩ := exists_index_two_subgroup P hP hnc
  have hMtop : M ≠ ⊤ := by
    intro h; rw [h, Subgroup.index_top] at hMidx; omega
  have hMcyc : ¬ IsCyclic ↥M := fun hc => hcon ⟨M, hc, hMidx⟩
  obtain ⟨d⟩ : Work.BrauerSuzuki.IsGenQuaternion ↥M := (ih M hMtop).resolve_left hMcyc
  have hτord : orderOf (d.tau : P) = 2 ^ d.n := by
    rw [Subgroup.orderOf_coe d.tau, d.tau_order]
  have hMcard : Nat.card ↥M = 2 ^ (d.n + 1) := (genQuaternionData_basic d).1
  have hPcard : Nat.card P = 2 ^ (d.n + 2) := by
    have h := Subgroup.index_mul_card M
    rw [hMidx, hMcard] at h
    rw [h.symm, two_pow_add_two (d.n)]
  have hA₀leM : Subgroup.zpowers (d.tau : P) ≤ M := by
    rw [Subgroup.zpowers_le]; exact d.tau.2
  obtain ⟨x, hxM⟩ : ∃ x : P, x ∉ M := by
    by_contra hc
    push_neg at hc
    refine hMtop ?_
    rw [Subgroup.eq_top_iff']
    exact hc
  rcases lt_or_ge d.n 3 with hn2 | hn3
  · have h2 : d.n = 2 := by have := d.hn; omega
    exact false_of_genQuaternionData_two M hMidx d h2 hu (fun y hy =>
      hcon ⟨Subgroup.zpowers y, Subgroup.isCyclic_zpowers y,
        index_zpowers_eq_two hPcard (by omega) (by rw [hy, h2]; norm_num)⟩)
  · have hA₀norm : (Subgroup.zpowers (d.tau : P)).Normal :=
      zpowers_normal_of_index_two hMidx d hn3
    have hA₀idx : (Subgroup.zpowers (d.tau : P)).index = 4 := zpowers_index_eq_four hMidx d
    have hx2M : x ^ 2 ∈ M := Subgroup.sq_mem_of_index_two hMidx x
    have hxA₀ : x ∉ Subgroup.zpowers (d.tau : P) := fun h => hxM (hA₀leM h)
    by_cases hx2A₀ : x ^ 2 ∈ Subgroup.zpowers (d.tau : P)
    · -- `x ^ 2 ∈ A₀`
      obtain ⟨N, hA₀leN, hxN, hNidx, -⟩ :=
        exists_index_two_of_sq_mem hA₀norm hA₀idx hx2A₀ hxA₀
      have hNtop : N ≠ ⊤ := by
        intro h; rw [h, Subgroup.index_top] at hNidx; omega
      rcases ih N hNtop with hNcyc | hNgen
      · exact hcon ⟨N, hNcyc, hNidx⟩
      · obtain ⟨dN⟩ := hNgen
        have hNcard : Nat.card ↥N = 2 ^ (d.n + 1) := by
          have h := Subgroup.index_mul_card N
          rw [hNidx, hPcard, two_pow_add_two (d.n)] at h
          exact Nat.mul_left_cancel (by norm_num) h
        have hdNn : dN.n = d.n := by
          have h1 : (2 : ℕ) ^ (dN.n + 1) = 2 ^ (d.n + 1) := by
            rw [← (genQuaternionData_basic dN).1, hNcard]
          exact Nat.add_right_cancel (Nat.pow_right_injective (by norm_num) h1)
        have h3N : 3 ≤ dN.n := by omega
        have hτNmem : (d.tau : P) ∈ N := hA₀leN (Subgroup.mem_zpowers _)
        have hA₀eq : Subgroup.zpowers (d.tau : P) = Subgroup.zpowers ((dN.tau : ↥N) : P) :=
          zpowers_eq_zpowers_tau_of_mem dN h3N hτNmem (by rw [hτord, hdNn])
        have hxN' : x ∉ Subgroup.zpowers ((dN.tau : ↥N) : P) := by
          rw [← hA₀eq]; exact hxA₀
        -- `x` inverts `A₀`
        have hxinv : ∀ a ∈ Subgroup.zpowers (d.tau : P), x * a * x⁻¹ = a⁻¹ := by
          have h := inverts_tau_of_mem_notMem dN hxN hxN'
          intro a ha
          rw [hA₀eq] at ha
          exact h a ha
        -- `ρ` inverts `A₀`
        have hρM : (d.rho : P) ∈ M := d.rho.2
        have hρA₀ : (d.rho : P) ∉ Subgroup.zpowers (d.tau : P) := by
          intro h
          have h' : (d.rho : P) ∈ (Subgroup.zpowers d.tau).map M.subtype := by
            rwa [map_zpowers_subtype_eq M d.tau]
          obtain ⟨y, hy, hyeq⟩ := Subgroup.mem_map.mp h'
          have hyρ : y = d.rho := Subtype.ext hyeq
          exact genQuaternionData_rho_notMem_zpowers_tau d (hyρ ▸ hy)
        have hρinv : ∀ a ∈ Subgroup.zpowers (d.tau : P),
            (d.rho : P) * a * (d.rho : P)⁻¹ = a⁻¹ := by
          exact inverts_zpowers_of_inverts (orderOf_eq_four_of_notMem d hρM hρA₀).2
        -- `x * ρ` centralizes `τ`
        have hcent : (x * (d.rho : P)) * (d.tau : P) * (x * (d.rho : P))⁻¹
            = (d.tau : P) := by
          have hx : x * (d.tau : P) * x⁻¹ = (d.tau : P)⁻¹ :=
            hxinv _ (Subgroup.mem_zpowers _)
          have hρ : (d.rho : P) * (d.tau : P) * (d.rho : P)⁻¹ = (d.tau : P)⁻¹ :=
            hρinv _ (Subgroup.mem_zpowers _)
          calc (x * (d.rho : P)) * (d.tau : P) * (x * (d.rho : P))⁻¹
              = x * ((d.rho : P) * (d.tau : P) * (d.rho : P)⁻¹) * x⁻¹ := by
                rw [mul_inv_rev]; group
            _ = x * (d.tau : P)⁻¹ * x⁻¹ := by rw [hρ]
            _ = (x * (d.tau : P) * x⁻¹)⁻¹ := by group
            _ = ((d.tau : P)⁻¹)⁻¹ := by rw [hx]
            _ = (d.tau : P) := inv_inv _
        have hmem := centralizer_tau_eq_zpowers hMidx d hn3 hcon ih hcent
        have hxρA₀ : x * (d.rho : P) ∉ Subgroup.zpowers (d.tau : P) := by
          intro h
          have hm : x * (d.rho : P) ∈ M := hA₀leM h
          have hxM' : x ∈ M := by
            have hxeq : x = (x * (d.rho : P)) * (d.rho : P)⁻¹ := by group
            rw [hxeq]
            exact Subgroup.mul_mem M hm (Subgroup.inv_mem M hρM)
          exact hxM hxM'
        exact hxρA₀ hmem
    · -- `x ^ 2 ∉ A₀`
      obtain ⟨-, hinv⟩ := orderOf_eq_four_of_notMem d hx2M hx2A₀
      have hxconj : x * (d.tau : P) * x⁻¹ ∈ Subgroup.zpowers (d.tau : P) :=
        hA₀norm.conj_mem _ (Subgroup.mem_zpowers _) x
      obtain ⟨k, hk⟩ :=
        (mem_zpowers_iff_exists_pow (a := (d.tau : P))
          (b := x * (d.tau : P) * x⁻¹)).mp hxconj
      have hτpow : (d.tau : P) ^ (2 ^ d.n) = 1 := by
        rw [← hτord]; exact pow_orderOf_eq_one _
      set t : ℕ := k % 2 ^ d.n with ht
      have hτt : (d.tau : P) ^ t = x * (d.tau : P) * x⁻¹ := by
        rw [ht, ← hk]
        exact (pow_eq_pow_mod (a := (d.tau : P)) (n := 2 ^ d.n) k hτpow).symm
      have hstep : x ^ 2 * (d.tau : P) * (x ^ 2)⁻¹
          = x * (x * (d.tau : P) * x⁻¹) * x⁻¹ := by
        rw [pow_two, mul_inv_rev]; group
      have hsq : x ^ 2 * (d.tau : P) * (x ^ 2)⁻¹ = (d.tau : P) ^ (t * t) := by
        rw [hstep, ← hτt]
        rw [show x * (d.tau : P) ^ t * x⁻¹ = ((d.tau : P) ^ t) ^ t from by
          rw [← MulAut.conj_apply x ((d.tau : P) ^ t), map_pow,
            MulAut.conj_apply x (d.tau : P), ← hτt]]
        rw [pow_mul]
      have hdvd : 2 ^ d.n ∣ t ^ 2 + 1 := by
        have h1 : (d.tau : P) ^ (t ^ 2 + 1) = 1 := by
          rw [pow_add, pow_one, pow_two, ← hsq, hinv, inv_mul_cancel]
        rw [← hτord]
        exact orderOf_dvd_iff_pow_eq_one.mpr h1
      exact not_dvd_sq_add_one t d.n hn3 hdvd

end Work.BrauerSuzuki.Group
