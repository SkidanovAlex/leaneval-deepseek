namespace Work.BrauerSuzuki.Quaternion

/-- For a group element `a` whose order is a multiple of `m`, the `i`-th power of `a` lies in
the cyclic subgroup generated by `a ^ m` exactly when `m` divides `i`.  This is the general
form of the two divisibility statements needed for `τ`, whose order `2 ^ n` is divisible by
`2` and by `4`. -/
private theorem zpowers_pow_zpow_mem_iff {G : Type*} [Group G] (a : G) {m : ℕ}
    (hm : (m : ℤ) ∣ (orderOf a : ℤ)) (i : ℤ) :
    a ^ i ∈ Subgroup.zpowers (a ^ m) ↔ (m : ℤ) ∣ i := by
  constructor
  · intro h
    rw [Subgroup.mem_zpowers_iff] at h
    obtain ⟨k, hk⟩ := h
    -- `a ^ (m * k) = a ^ i`, whence `a ^ (m * k - i) = 1`
    have h1 : a ^ ((m : ℤ) * k) = a ^ i := by
      rw [← hk, zpow_mul, zpow_natCast]
    have h2 : a ^ ((m : ℤ) * k - i) = 1 := by
      rw [zpow_sub, h1, mul_inv_cancel]
    -- so `orderOf a ∣ m * k - i`, and since `m ∣ orderOf a` also `m ∣ m * k - i`
    have h3 : (m : ℤ) ∣ ((m : ℤ) * k - i) :=
      dvd_trans hm (orderOf_dvd_iff_zpow_eq_one.mpr h2)
    have h5 : (m : ℤ) ∣ (m : ℤ) * k - ((m : ℤ) * k - i) :=
      dvd_sub (dvd_mul_right _ _) h3
    have h6 : (m : ℤ) * k - ((m : ℤ) * k - i) = i := by ring
    rwa [h6] at h5
  · intro h
    rw [Subgroup.mem_zpowers_iff]
    obtain ⟨k, hk⟩ := h
    exact ⟨k, by rw [hk, ← zpow_natCast a m, ← zpow_mul]⟩

theorem tau_zpow_mem_zpowers_two_four {P : Type*} [Group P]
    (d : Work.BrauerSuzuki.GenQuaternionData P) (i : ℤ) :
    (d.tau ^ i ∈ Subgroup.zpowers (d.tau ^ 2) ↔ (2 : ℤ) ∣ i) ∧
    (d.tau ^ i ∈ Subgroup.zpowers (d.tau ^ 4) ↔ (4 : ℤ) ∣ i) := by
  -- `orderOf τ = 2 ^ n` with `n ≥ 2`, so it is divisible both by `2` and by `4`
  have hm2 : (2 : ℤ) ∣ (orderOf d.tau : ℤ) := by
    rw [d.tau_order]
    have h : (2 : ℕ) ^ 1 ∣ 2 ^ d.n :=
      pow_dvd_pow 2 (le_trans (show (1 : ℕ) ≤ 2 by norm_num) d.hn)
    exact_mod_cast (show (2 : ℕ) ∣ 2 ^ d.n by simpa using h)
  have hm4 : (4 : ℤ) ∣ (orderOf d.tau : ℤ) := by
    rw [d.tau_order]
    have h : (2 : ℕ) ^ 2 ∣ 2 ^ d.n := pow_dvd_pow 2 d.hn
    exact_mod_cast (show (4 : ℕ) ∣ 2 ^ d.n by simpa using h)
  exact ⟨zpowers_pow_zpow_mem_iff d.tau hm2 i, zpowers_pow_zpow_mem_iff d.tau hm4 i⟩

end Work.BrauerSuzuki.Quaternion
