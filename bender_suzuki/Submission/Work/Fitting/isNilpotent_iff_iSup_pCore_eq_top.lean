/-!
# `G` is nilpotent iff it is generated by its `p`-cores

For a finite group `G`,

  `G` is nilpotent  ↔  `⨆_{p ∣ |G|} O_p(G) = ⊤`.

The right-hand side is `F(G) = ⊤` (`Work.Fitting.fitting_eq_iSup_pCore`, valid since `pCore p G`
is trivial for every `p` that is not a prime divisor of `|G|`), and `F(G) = ⊤` holds exactly
when `G` is nilpotent (`Work.Fitting.fitting_eq_top_iff`).
-/

namespace Work.Fitting

theorem isNilpotent_iff_iSup_pCore_eq_top (G : Type*) [Group G] [Finite G] :
    Group.IsNilpotent G ↔ ⨆ p ∈ (Nat.card G).primeFactors, Work.Fitting.pCore p G = ⊤ := by
  rw [← fitting_eq_iSup_pCore G]
  exact (fitting_eq_top_iff G).symm

end Work.Fitting
