/-!
# `F(G) = ⨆_p O_p(G)`

The Fitting subgroup of a finite group is the (direct) product of its `p`-cores:

  `F(G) = ⨆_{p ∣ |G|} O_p(G)`.

The two inclusions are proved separately:

* `O_p(G)` is a normal `p`-subgroup of `G`, hence normal and nilpotent, so it is contained
  in `F(G)`; this gives `⨆_p O_p(G) ≤ F(G)` (no hypothesis beyond finiteness).
* Conversely, every normal nilpotent subgroup `N ≤ G` is contained in `⨆_p O_p(G)`: a finite
  nilpotent group is the internal direct product of its Sylow subgroups
  (`iSup_sylow_eq_top`), each Sylow `p`-subgroup of `N` is characteristic in `N` because `N`
  is nilpotent, hence normal in `G` (`map_characteristic_normal`), and so it is contained in
  `O_p(G)` (`sylow_map_le_pCore`).

Note that the second inclusion never uses that `F(G)` itself is nilpotent: it only needs it
for the individual members of `fittingSet G`.
-/

noncomputable section

set_option linter.style.haveILetI false

open Classical

namespace Work.Fitting

/-! ## Auxiliary facts about nilpotent groups -/

/-- A characteristic subgroup of a normal subgroup is normal in the ambient group. -/
theorem map_characteristic_normal {G : Type*} [Group G] {N : Subgroup G} (hN : N.Normal)
    {K : Subgroup ↥N} (hK : K.Characteristic) : (K.map N.subtype).Normal := by
  haveI := hN
  refine Subgroup.Normal.mk ?_
  intro x hx g
  obtain ⟨y, hy, rfl⟩ := hx
  have hfix : K.map (MulAut.conjNormal g).toMonoidHom = K :=
    Subgroup.characteristic_iff_map_eq.mp hK (MulAut.conjNormal g)
  have hmem : (MulAut.conjNormal g) y ∈ K := by
    rw [← hfix]
    exact ⟨y, hy, rfl⟩
  rw [Subgroup.mem_map]
  exact ⟨(MulAut.conjNormal g) y, hmem, MulAut.conjNormal_apply g y⟩

/-- A Sylow `p`-subgroup of a normal nilpotent subgroup `N ≤ G` is a normal `p`-subgroup of
`G`, hence is contained in `O_p(G)`. -/
theorem sylow_map_le_pCore {G : Type*} [Group G] [Finite G] {N : Subgroup G} (hN : N.Normal)
    [Group.IsNilpotent ↥N] {p : ℕ} (hp : p.Prime) (Q : Sylow p ↥N) :
    ((Q : Subgroup ↥N).map N.subtype) ≤ Work.Fitting.pCore p G := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hQn : (Q : Subgroup ↥N).Normal := inferInstance
  have hchar : (Q : Subgroup ↥N).Characteristic := Sylow.characteristic_of_normal Q hQn
  have hnorm : ((Q : Subgroup ↥N).map N.subtype).Normal := map_characteristic_normal hN hchar
  refine Work.Fitting.le_piCore hnorm ?_
  rw [Work.Fitting.isPiNat_prime_iff_isPGroup hp]
  exact (Q.isPGroup').map N.subtype

/-- A finite nilpotent group is the internal direct product of its Sylow subgroups: it is
generated by (the subgroups in) its Sylow subgroups, one per prime divisor of its order. -/
theorem iSup_sylow_eq_top (H : Type*) [Group H] [Finite H] [Group.IsNilpotent H] :
    (⊤ : Subgroup H) = ⨆ p : (Nat.card H).primeFactors,
      ((default : Sylow (p : ℕ) H) : Subgroup H) := by
  haveI : Fintype H := Fintype.ofFinite H
  set ps := (Nat.card H).primeFactors
  let P : ∀ p, Sylow p H := default
  let Hf : ps → Subgroup H := fun p => (P (p : ℕ) : Subgroup H)
  have hfin : ∀ p : ps, Fintype (Hf p) := fun p => Fintype.ofFinite _
  haveI := hfin
  have hcomm : Pairwise fun p q : ps => ∀ x y : H, x ∈ Hf p → y ∈ Hf q → Commute x y := by
    rintro p q hne
    have hpF : Fact (Nat.Prime (p : ℕ)) := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    have hqF : Fact (Nat.Prime (q : ℕ)) := ⟨Nat.prime_of_mem_primeFactors q.2⟩
    haveI := hpF; haveI := hqF
    have hne' : (p : ℕ) ≠ (q : ℕ) := by simpa using hne
    refine Subgroup.commute_of_normal_of_disjoint _ _ (inferInstance) (inferInstance) ?_
    exact IsPGroup.disjoint_of_ne (p : ℕ) (q : ℕ) hne' _ _ (P _).isPGroup' (P _).isPGroup'
  have hcoprime : Pairwise fun p q : ps => (Fintype.card (Hf p)).Coprime (Fintype.card (Hf q)) := by
    rintro p q hne
    have hpF : Fact (Nat.Prime (p : ℕ)) := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    have hqF : Fact (Nat.Prime (q : ℕ)) := ⟨Nat.prime_of_mem_primeFactors q.2⟩
    haveI := hpF; haveI := hqF
    have hne' : (p : ℕ) ≠ (q : ℕ) := by simpa using hne
    simp only [← Nat.card_eq_fintype_card]
    exact IsPGroup.coprime_card_of_ne (p : ℕ) (q : ℕ) hne' _ _ (P _).isPGroup' (P _).isPGroup'
  have hcard : Nat.card ((p : ps) → Hf p) = Nat.card H := by
    calc Nat.card ((p : ps) → Hf p) = ∏ p : ps, Nat.card (Hf p) := Nat.card_pi
      _ = ∏ p : ps, (p : ℕ) ^ (Nat.card H).factorization (p : ℕ) := by
            apply Finset.prod_congr rfl
            intro p _
            have hpF : Fact (Nat.Prime (p : ℕ)) := ⟨Nat.prime_of_mem_primeFactors p.2⟩
            haveI := hpF
            exact Sylow.card_eq_multiplicity (P (p : ℕ))
      _ = ∏ p ∈ (Nat.card H).primeFactors, p ^ (Nat.card H).factorization p :=
            (Finset.prod_finset_coe (fun p => p ^ (Nat.card H).factorization p) _)
      _ = (Nat.card H).factorization.prod (· ^ ·) := rfl
      _ = Nat.card H := Nat.prod_factorization_pow_eq_self Nat.card_pos.ne'
  have hbij : Function.Bijective (Subgroup.noncommPiCoprod hcomm) := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨?_, ?_⟩
    · apply Subgroup.injective_noncommPiCoprod_of_iSupIndep
      exact Subgroup.independent_of_coprime_order hcomm hcoprime
    · rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
      exact hcard
  have hsurj : Function.Surjective (Subgroup.noncommPiCoprod hcomm) := hbij.2
  rw [← MonoidHom.range_eq_top.mpr hsurj]
  exact Subgroup.noncommPiCoprod_range

/-! ## The two inclusions -/

/-- Every normal nilpotent subgroup is contained in the product of the `p`-cores. -/
theorem le_iSup_pCore {G : Type*} [Group G] [Finite G] {N : Subgroup G} (hN : N.Normal)
    [Group.IsNilpotent ↥N] :
    N ≤ ⨆ p ∈ (Nat.card G).primeFactors, Work.Fitting.pCore p G := by
  have htop := iSup_sylow_eq_top ↥N
  have hmapN : (⊤ : Subgroup ↥N).map N.subtype = N := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  calc N = (⊤ : Subgroup ↥N).map N.subtype := hmapN.symm
    _ = (⨆ p : (Nat.card ↥N).primeFactors,
          ((default : Sylow (p : ℕ) ↥N) : Subgroup ↥N)).map N.subtype := by rw [htop]
    _ = ⨆ p : (Nat.card ↥N).primeFactors,
          (((default : Sylow (p : ℕ) ↥N) : Subgroup ↥N)).map N.subtype := by
            rw [Subgroup.map_iSup]
    _ ≤ ⨆ p ∈ (Nat.card G).primeFactors, Work.Fitting.pCore p G := by
          apply iSup_le
          intro p
          have hp : (p : ℕ).Prime := Nat.prime_of_mem_primeFactors p.2
          have hpdvd : (p : ℕ) ∣ Nat.card ↥N := (Nat.mem_primeFactors.mp p.2).2.1
          have hpg : (p : ℕ) ∈ (Nat.card G).primeFactors := by
            rw [Nat.mem_primeFactors]
            exact ⟨hp, Nat.dvd_trans hpdvd (Subgroup.card_subgroup_dvd_card N),
              Nat.card_pos.ne'⟩
          exact (sylow_map_le_pCore hN hp (default : Sylow (p:ℕ) ↥N)).trans
            (le_iSup₂ (f := fun q (_ : q ∈ (Nat.card G).primeFactors) => Work.Fitting.pCore q G)
              (p : ℕ) hpg)

/-- `O_p(G)` is a `p`-group. -/
theorem isPGroup_pCore {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime) :
    IsPGroup p ↥(Work.Fitting.pCore p G) := by
  haveI : Fact p.Prime := ⟨hp⟩
  rw [Work.Fitting.pCore, Work.Fitting.piCore]
  exact Sylow.sSup_of_normal _
    (fun H hH => (Work.Fitting.isPiNat_prime_iff_isPGroup hp H).mp hH.2)
    (fun H hH => hH.1)

/-! ## The main result -/

theorem fitting_eq_iSup_pCore (G : Type*) [Group G] [Finite G] :
    Work.Fitting.fitting G =
      ⨆ p ∈ (Nat.card G).primeFactors, Work.Fitting.pCore p G := by
  apply le_antisymm
  · rw [Work.Fitting.fitting]
    apply sSup_le
    intro N hN
    rw [Work.Fitting.mem_fittingSet] at hN
    haveI : Group.IsNilpotent ↥N := hN.2
    exact le_iSup_pCore hN.1
  · apply iSup_le
    intro p
    apply iSup_le
    intro hp
    have hpp : p.Prime := Nat.prime_of_mem_primeFactors hp
    haveI : Fact p.Prime := ⟨hpp⟩
    refine Work.Fitting.le_fitting (inferInstance) ?_
    exact (isPGroup_pCore hpp).isNilpotent

end Work.Fitting
