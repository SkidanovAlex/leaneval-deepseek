section

/-!
# Auxiliary lemmas for `Work.Higman.H8.c4_sq_a2`

This file contains the pieces of the `C₄`-exclusion (`Work.Higman.H8.c4_sq_a2`) that are proved
independently of the still-open final case.  It is import-safe for delegated lemmas: the file
with the `sorry` (`H8/c4_sq_a2.lean`) imports *this* file, not the other way round.
-/

namespace Work.Higman.H8

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-- In the `C₄` setting `A ≠ ⊥` (from `|A| = |Ω₁(P)|² ≥ 4`). -/
private theorem c4_A_ne_bot (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) : A ≠ ⊥ := by
  intro hb
  have h1 : Nat.card ↥A = 1 := by rw [hb, Subgroup.card_bot]
  have h4 := h.omega1_card_ge_four
  rw [h1] at hcard
  nlinarith [hcard, h4]

/-- **First step towards the counting.**  In the `C₄` setting with `C_P(A) = A` and
`[A,D] = A²`, the power `ξ ^ (|Ω₁(P)| - 1)` acts trivially on `D/A`: for `x ∈ D`,
`ξ^(q-1) x · x⁻¹ ∈ A` where `q = |Ω₁(P)|`.

Route: `Work.Higman.xi_pow_triv_omega1_iff` shows that `ξ^(q-1)` fixes `Ω₁(P) = A²` pointwise;
since `[D,A] ⊆ [D,D] = A² = Ω₁(P)` is central, `η := ξ^(q-1)` satisfies `[ηx, ηa] = η[x,a] = [x,a]`
for `x ∈ D`, `a ∈ A` (using `ηa · a⁻¹ ∈ A²`, i.e. triviality of `η` on `A/A²` via the
`ξ`-equivariant squaring isomorphism `A/A² ≅ A²`), so `ηx · x⁻¹` centralises `A`, and
`C_P(A) = A` gives `ηx · x⁻¹ ∈ A`.  The collapse `⁅ηx·x⁻¹, y⁆ = 1` is
`Work.Higman.HS.commutator_pow_mul_inv_eq_one`. -/
private theorem c4_sq_a2_xi_pow_sub_one_triv (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hDA : ⁅A, D⁆ = Work.Higman.powSub A 2) :
    ∀ x ∈ D, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A := by
  intro x hx
  have hηΩ : ∀ w ∈ Work.Higman.omega1 P,
      (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) w = w :=
    (xi_pow_triv_omega1_iff h _).mpr (dvd_refl _)
  have hca : ∀ y ∈ A, ((h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹) * y
      = y * ((h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹) := by
    intro y hy
    have h1 : ⁅(h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹, y⁆ = 1 :=
      HS.commutator_pow_mul_inv_eq_one h hA.abelian hA.map_eq htop hDA hηΩ hx hy
    exact commutatorElement_eq_one_iff_mul_comm.mp h1
  have hmem : ((h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹)
      ∈ Subgroup.centralizer (A : Set P) :=
    Subgroup.mem_centralizer_iff.mpr (fun y hy => (hca y hy).symm)
  rwa [hcent] at hmem

end Work.Higman.H8
end

-- ===== from Submission.Work.Higman.H8.c4_sq_a2_card_quot =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.Higman.H8

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-! ## Auxiliary facts -/

/-- `(L8.xiQuot h hAinv hDinv) ^ k` on a representative. -/
private theorem xiQuot_pow_mk {h : Work.Higman.IsSuzuki2Grp P} {A D : Subgroup P} [A.Normal]
    (hAinv : Subgroup.map (MulEquiv.toMonoidHom h.xi) A = A)
    (hDinv : Subgroup.map (MulEquiv.toMonoidHom h.xi) D = D) (k : ℕ) (u : ↥D) :
    ((Work.Higman.MSA.L8.xiQuot h hAinv hDinv) ^ k) (QuotientGroup.mk u)
      = QuotientGroup.mk ((Work.Higman.MSA.L8.xiSubAut h hDinv ^ k) u) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have h1 : ((Work.Higman.MSA.L8.xiQuot h hAinv hDinv) ^ (k + 1)) (QuotientGroup.mk u)
          = Work.Higman.MSA.L8.xiQuot h hAinv hDinv
              (((Work.Higman.MSA.L8.xiQuot h hAinv hDinv) ^ k) (QuotientGroup.mk u)) := by
        rw [pow_succ', MulAut.mul_apply]
      rw [h1, ih, Work.Higman.MSA.l8_xiQuot_mk]
      congr 1
      rw [pow_succ', MulAut.mul_apply]

/-- Cardinality of `A.subgroupOf D` as a subgroup of `D`. -/
private theorem card_subgroupOf_eq (A D : Subgroup P) (hAD : A ≤ D) :
    Nat.card ↥(A.subgroupOf D) = Nat.card ↥A := by
  refine Nat.card_congr ?_
  exact { toFun := fun x => ⟨((x : ↥D) : P), x.2⟩
          invFun := fun a => ⟨⟨(a : P), hAD a.2⟩, a.2⟩
          left_inv := fun x => Subtype.ext (Subtype.ext rfl)
          right_inv := fun a => Subtype.ext rfl }

/-- Pure arithmetic: from `a ∣ k - 1` and `a ∣ m * k - 1` with `1 ≤ m`, `1 ≤ k` deduce
`a ∣ m - 1`. -/
private theorem dvd_sub_one_of_dvd_mul_sub_one {a m k : ℕ} (hm : 1 ≤ m) (hk : 1 ≤ k)
    (h1 : a ∣ k - 1) (h2 : a ∣ m * k - 1) : a ∣ m - 1 := by
  have hid : m * k - 1 = m * (k - 1) + (m - 1) := by
    have hmul : m * k = m * (k - 1) + m := by
      conv_lhs => rw [← Nat.sub_add_cancel hk]
      rw [Nat.mul_succ]
    rw [hmul]
    omega
  have h3 : a ∣ m * (k - 1) := Dvd.dvd.mul_left h1 m
  rw [hid] at h2
  exact (Nat.dvd_add_iff_right h3).mpr h2

/-! ## The main count -/

/-- **The `m = n` count for `D`.**  In the `C₄` setting with `C_P(A) = A`, `[A,D] = A²` and
`D ⊴ P` as in `c4_sq_a2`, the quotient `D/A` has order `|Ω₁(P)|`.

Upper bound: `D/A` is an abelian group of exponent two (`[D,D] = A² ≤ A`, `D² ⊆ A²`), the
`ξ`-action on it is irreducible (hcover; every `E` with `A ≤ E ≤ D` is automatically normal since
`[P,E] ≤ [P,P] = A ≤ E`) and `ξ^(q-1)` acts trivially on it
(`Work.Higman.H8.c4_sq_a2_xi_pow_sub_one_triv`, imported from `H8/c4_sq_a2_aux`), so
`Work.Higman.MSA.l8_card_le` gives `|D/A| ≤ 2^n = q`.

Lower bound: `Work.Higman.card_sub_one_dvd_of_xi_invariant` applied to the `ξ`-invariant
subgroups `A` and `D` gives `(q-1) ∣ |A| - 1` and `(q-1) ∣ |D| - 1`, hence `(q-1) ∣ |D/A| - 1`;
with `D ≠ A` this gives `|D/A| ≥ q`. -/
private theorem c4_sq_a2_card_quot {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : D ≠ A)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hPhi : Work.Higman.powSub D 2 ⊔ ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D)
    (hAD2 : ⁅A, D⁆ = Work.Higman.powSub A 2) :
    Nat.card (↥D ⧸ (A.subgroupOf D)) = Nat.card ↥(Work.Higman.omega1 P) := by
  classical
  haveI hAn : A.Normal := hA.normal
  haveI : Fintype P := Fintype.ofFinite P
  -- elementary containments
  have hA2le : Work.Higman.powSub A 2 ≤ A := Work.Higman.powSub_le (n := 2) (by norm_num)
  have hD2le : Work.Higman.powSub D 2 ≤ A := by
    calc Work.Higman.powSub D 2 ≤ Work.Higman.powSub D 2 ⊔ ⁅D, D⁆ := le_sup_left
      _ = Work.Higman.powSub A 2 := hPhi
      _ ≤ A := hA2le
  -- `[⊤, D] ≤ A`
  have hPC : ⁅(⊤ : Subgroup P), D⁆ ≤ A := by
    calc ⁅(⊤ : Subgroup P), D⁆ ≤ ⁅(⊤ : Subgroup P), ⊤⁆ :=
          Subgroup.commutator_mono le_rfl le_top
      _ = A := hGs
  -- `ξ ^ (q-1)` is trivial on `D/A`
  have htriv : ∀ x ∈ D, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A :=
    c4_sq_a2_xi_pow_sub_one_triv h hA htop hcent hAD2
  -- ## The quotient `D/A` is abelian
  have hcomm_le : ⁅(⊤ : Subgroup ↥D), ⊤⁆ ≤ A.subgroupOf D := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    rw [Subgroup.mem_subgroupOf]
    have hmem : ⁅(x : P), (y : P)⁆ ∈ (⁅D, D⁆ : Subgroup P) :=
      Subgroup.commutator_mem_commutator x.2 y.2
    rw [hDd] at hmem
    have hcoe : ((⁅x, y⁆ : ↥D) : P) = ⁅(x : P), (y : P)⁆ := by
      simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv]
    rw [hcoe]
    exact hA2le hmem
  letI : CommGroup (↥D ⧸ (A.subgroupOf D)) :=
    Work.Higman.SZ.commGroup_quot_of_commutator_le (A.subgroupOf D) hcomm_le
  -- ## The upper bound `|D/A| ≤ q`
  obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
  have hn1 : 1 ≤ n := by
    by_contra hc
    have hn0 : n = 0 := by omega
    have h4 := h.omega1_card_ge_four
    rw [hn, hn0] at h4
    norm_num at h4
  have hxi : (Work.Higman.MSA.L8.xiQuot h hA.map_eq hDinv) ^ (2 ^ n - 1) = 1 := by
    have h2n : 2 ^ n - 1 = Nat.card ↥(Work.Higman.omega1 P) - 1 := by rw [hn]
    rw [h2n]
    apply MulEquiv.ext
    intro z
    obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective z
    show ((Work.Higman.MSA.L8.xiQuot h hA.map_eq hDinv) ^ (Nat.card ↥(Work.Higman.omega1 P) - 1))
        (QuotientGroup.mk u) = QuotientGroup.mk u
    rw [xiQuot_pow_mk (h := h) (hAinv := hA.map_eq) (hDinv := hDinv)]
    rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    rw [Work.Higman.MSA.L8.xiSubAut_pow_apply h hDinv]
    obtain ⟨y, hy, hmem⟩ : ∃ y : P,
        y = (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) (u : P)
          ∧ y * (u : P)⁻¹ ∈ A := ⟨_, rfl, htriv u u.2⟩
    rw [← hy]
    have hid : y⁻¹ * (u : P) = y⁻¹ * (y * (u : P)⁻¹)⁻¹ * (y⁻¹)⁻¹ := by group
    rw [hid]
    exact hAn.conj_mem _ (A.inv_mem hmem) y⁻¹
  have hirr : ∀ K : Subgroup (↥D ⧸ (A.subgroupOf D)),
      K.map (Work.Higman.MSA.L8.xiQuot h hA.map_eq hDinv).toMonoidHom = K →
      K = ⊥ ∨ K = ⊤ :=
    fun K hK => quot_irred_of_cover hA.map_eq hDinv hAD hPC hcover K hK
  have hle : Nat.card (↥D ⧸ (A.subgroupOf D)) ≤ 2 ^ n :=
    Work.Higman.MSA.l8_card_le (V := ↥D ⧸ (A.subgroupOf D))
      (fun v => Work.Higman.MSA.L8.quot_sq_one (A := A) (C := D) hD2le v)
      (Work.Higman.MSA.L8.xiQuot h hA.map_eq hDinv) hn1 hxi hirr
  rw [← hn] at hle
  -- ## The lower bound `q ≤ |D/A|`
  have hqA : Nat.card ↥(Work.Higman.omega1 P) - 1 ∣ Nat.card ↥A - 1 :=
    xi_invariant_card_sub_one_dvd h hA.map_eq
  have hqD : Nat.card ↥(Work.Higman.omega1 P) - 1 ∣ Nat.card ↥D - 1 :=
    xi_invariant_card_sub_one_dvd h hDinv
  have hDcard : Nat.card ↥D
      = Nat.card (↥D ⧸ (A.subgroupOf D)) * Nat.card ↥A := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf D),
      card_subgroupOf_eq A D hAD]
  have hkey : Nat.card ↥(Work.Higman.omega1 P) - 1
      ∣ Nat.card (↥D ⧸ (A.subgroupOf D)) - 1 := by
    refine dvd_sub_one_of_dvd_mul_sub_one (k := Nat.card ↥A)
      (Nat.card_pos (α := ↥D ⧸ (A.subgroupOf D))) (Nat.card_pos (α := ↥A)) hqA ?_
    rw [← hDcard]
    exact hqD
  have hmne : Nat.card (↥D ⧸ (A.subgroupOf D)) ≠ 1 := by
    intro hm1
    apply hADne
    have hcard : Nat.card ↥D = Nat.card ↥A := by rw [hDcard, hm1, one_mul]
    exact (Subgroup.eq_of_le_of_card_ge hAD (le_of_eq hcard)).symm
  have hge : Nat.card ↥(Work.Higman.omega1 P) ≤ Nat.card (↥D ⧸ (A.subgroupOf D)) := by
    have h1le : 1 ≤ Nat.card (↥D ⧸ (A.subgroupOf D)) := Nat.card_pos
    have h2 : 2 ≤ Nat.card (↥D ⧸ (A.subgroupOf D)) := by omega
    have hq1le : Nat.card ↥(Work.Higman.omega1 P) - 1
        ≤ Nat.card (↥D ⧸ (A.subgroupOf D)) - 1 :=
      Nat.le_of_dvd (by omega) hkey
    have h4 := h.omega1_card_ge_four
    omega
  exact le_antisymm hle hge

end Work.Higman.H8
end

-- ===== from Submission.Work.Higman.HS.two_cover_layer_twist =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

namespace Work.Higman.HS

open scoped commutatorElement

/-! ## The Singer/field model of `Ω₁(P)` in `GaloisField` coordinates

This is the `GaloisField 2 n` form of `Work.Higman.HS.omega1_singer_iso`, obtained by the same
route: the `𝔽₂⟨ξ⟩`-module `Ω₁(P)` is identified through `Work.Higman.exists_singer_iso` with
`GF(2 ^ n)` in such a way that `ξ` becomes multiplication by a primitive element `ν`. -/
private theorem two_cover_singer_data {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P) :
    ∃ (n : ℕ) (ν : (GaloisField 2 n)ˣ) (ζ : GaloisField 2 n ≃ ↥(Work.Higman.omega1 P)),
      2 ≤ n ∧ orderOf ν = 2 ^ n - 1 ∧
      (∀ x y : GaloisField 2 n, ζ (x + y) = ζ x * ζ y) ∧
      (∀ x : GaloisField 2 n, ζ ((ν : GaloisField 2 n) * x) = Work.Higman.xiZ h (ζ x)) := by
  classical
  let V := Additive ↥(Work.Higman.omega1 P)
  letI : CommGroup ↥(Work.Higman.omega1 P) :=
    Work.Higman.SZ.commGroup_subtype_of_abelian (fun x hx y hy => h.omega1_comm hx hy)
  have hsq : ∀ z : ↥(Work.Higman.omega1 P), z * z = 1 := fun z => Subtype.ext (by
    show (z : P) * (z : P) = 1
    rw [← pow_two]; exact h.mem_omega1.mp z.2)
  letI : Module (ZMod 2) V := Work.Higman.SZ.module_zmod2_of_sq_one hsq
  let ξZ : ↥(Work.Higman.omega1 P) ≃* ↥(Work.Higman.omega1 P) := Work.Higman.xiZ h
  let ξVadd : V ≃+ V := ξZ.toAdditive
  let σlin : V →ₗ[ZMod 2] V := AddMonoidHom.toZModLinearMap 2 (ξVadd : V →+ V)
  have hσlin_apply : ∀ v : V, σlin v = ξVadd v := fun v => rfl
  have hσlin : Function.Bijective σlin :=
    ⟨fun a b hab => ξVadd.injective (by rw [← hσlin_apply, ← hσlin_apply]; exact hab),
      fun b => ⟨ξVadd.symm b, by rw [hσlin_apply]; exact ξVadd.apply_symm_apply b⟩⟩
  let ξV : V ≃ₗ[ZMod 2] V := LinearEquiv.ofBijective σlin hσlin
  have hξV_apply : ∀ v : V, ξV v = Additive.ofMul (ξZ (Additive.toMul v)) := by
    intro v; show σlin v = _; rw [hσlin_apply]; rfl
  have hξV_pow : ∀ (k : ℕ) (v : V),
      (ξV ^ k) v = Additive.ofMul ((ξZ ^ k) (Additive.toMul v)) := by
    intro k
    induction k with
    | zero => intro v; simp
    | succ k ih =>
        intro v
        rw [pow_succ', LinearEquiv.mul_apply, ih, hξV_apply, toMul_ofMul]
        congr 1
        rw [pow_succ']
        rfl
  have hord_z : ∀ z : ↥(Work.Higman.omega1 P), z ≠ 1 → orderOf ((z : P)) = 2 := by
    intro z hz
    have hz2 : (z : P) ^ 2 = 1 := h.mem_omega1.mp z.2
    have hd : orderOf ((z : P)) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hz2
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h1
    · exact absurd (Subtype.ext (orderOf_eq_one_iff.mp h1)) hz
    · exact h1
  have htrans : ∀ a b : V, a ≠ 0 → b ≠ 0 → ∃ k : ℕ, (ξV ^ k) a = b := by
    intro a b ha hb
    have ha' : Additive.toMul a ≠ 1 := by
      intro h1; exact ha (by rw [← ofMul_toMul a, h1]; rfl)
    have hb' : Additive.toMul b ≠ 1 := by
      intro h1; exact hb (by rw [← ofMul_toMul b, h1]; rfl)
    obtain ⟨k, hk⟩ := h.trans ((Additive.toMul a : ↥(Work.Higman.omega1 P)) : P)
      ((Additive.toMul b : ↥(Work.Higman.omega1 P)) : P)
      (hord_z (Additive.toMul a) ha') (hord_z (Additive.toMul b) hb')
    refine ⟨k, ?_⟩
    rw [hξV_pow, ← ofMul_toMul b]
    congr 1
    refine Subtype.ext ?_
    rw [Work.Higman.xiZ_pow_coe h k (Additive.toMul a)]
    exact hk
  obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
  have hVcard : Nat.card V = 2 ^ n := hn
  have hn2 : 2 ≤ n := by
    by_contra hcon
    push Not at hcon
    have h1 : 2 ^ n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega : n ≤ 1)
    have h4 : 4 ≤ 2 ^ n := by rw [← hn]; exact h.omega1_card_ge_four
    norm_num at h1
    omega
  obtain ⟨hVord, hVfree⟩ := Work.Higman.singer_data_of_transitive hn2 hVcard ξV htrans
  obtain ⟨φ, lam, hlamord, hφ⟩ :=
    Work.Higman.exists_singer_iso (n := n) (V := V) (by omega) hVcard ξV hVord hVfree
  refine ⟨n, lam, φ.symm.toEquiv.trans Additive.toMul, hn2, hlamord, ?_, ?_⟩
  · intro x y
    show Additive.toMul (φ.symm (x + y)) = Additive.toMul (φ.symm x) * Additive.toMul (φ.symm y)
    rw [map_add, toMul_add]
  · intro x
    have h1 : ξV (φ.symm x) = φ.symm (((lam : (GaloisField 2 n)ˣ) : GaloisField 2 n) * x) := by
      apply φ.injective
      rw [hφ (φ.symm x), LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
    show Additive.toMul (φ.symm (((lam : (GaloisField 2 n)ˣ) : GaloisField 2 n) * x))
      = ξZ (Additive.toMul (φ.symm x))
    rw [← h1, hξV_apply, toMul_ofMul]

/-! ## The two-cover layer twist -/

private theorem two_cover_layer_twist {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} [hAn : A.Normal]
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : A ≠ D)
    (hirrD : ∀ F' : Subgroup P, F'.Normal → F'.map (h.xi : MulAut P).toMonoidHom = F' →
      A ≤ F' → F' ≤ D → F' = A ∨ F' = D)
    (hDd : Bracket.bracket D D = Work.Higman.powSub A 2)
    (hDcard : Nat.card ↥D = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3) :
    ∃ (n : ℕ) (F : Type) (_ : Field F) (_ : Fintype F) (_ : DecidableEq F) (_ : CharP F 2)
      (ν : F) (k : ℕ) (φ : P → F),
      Fintype.card F = 2 ^ n ∧ 2 ≤ n ∧ orderOf ν = 2 ^ n - 1 ∧ k < n ∧
      (∀ c c' : P, c ∈ D → c' ∈ D → φ (c * c') = φ c + φ c') ∧
      (∀ c : P, c ∈ D → (φ c = 0 ↔ c ∈ A)) ∧
      (∀ c : P, c ∈ D → φ (h.xi c) = ν ^ (1 - (2 : ℤ) ^ k) * φ c) ∧
      (∀ x : F, ∃ c : P, c ∈ D ∧ φ c = x) := by
  classical
  haveI hpowN : (Work.Higman.powSub A 2).Normal := Work.Higman.powSub_normal hAn 2
  -- ## The Singer data
  obtain ⟨n, νU, ζ, hn2, hνord, hζadd, hζmul⟩ := two_cover_singer_data h
  -- ## The commutator pairing `A/A² × D/A → Ω₁`
  obtain ⟨β, hβdef, hβadd1, hβadd2, hβnondeg⟩ := two_cover_pairing h hA hGs htop hAD hDd hcent
  -- ## The squaring isomorphism `A/A² ≅ Ω₁`
  obtain ⟨Φ, hΦbij, hΦxi⟩ := Work.Higman.H8.c4nocard_nu_iso_xi h hA htop hcard
  let νq : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) ≃* ↥(Work.Higman.omega1 P) :=
    MulEquiv.ofBijective Φ hΦbij
  have hνq_apply : ∀ q, νq q = Φ q := fun q => rfl
  have hxiZeq : Work.Higman.MSA.xiSubAut h (Work.Higman.map_xi_omega1 h) = Work.Higman.xiZ h :=
    MulEquiv.ext (fun z => Subtype.ext rfl)
  -- ## The `ξ`-action on `D/A`
  let ξD : (↥D ⧸ (A.subgroupOf D)) ≃* (↥D ⧸ (A.subgroupOf D)) :=
    QuotientGroup.congr (A.subgroupOf D) (A.subgroupOf D) (Work.Higman.MSA.xiSubAut h hDinv)
      (Work.Higman.MSA.map_xi_subgroupOf h hA.map_eq hDinv)
  have hξD_mk : ∀ d : ↥D,
      ξD (QuotientGroup.mk d) = QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hDinv d) :=
    fun d => QuotientGroup.congr_mk _ _ _ _ d
  -- ## The `ξ`-action on `A/A²`
  have hA2inv : (Work.Higman.powSub A 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub A 2 :=
    Work.Higman.map_powSub (h.xi : MulAut P) hA.map_eq 2
  have hξA2 : Subgroup.map (Work.Higman.MSA.xiSubAut h hA.map_eq)
      ((Work.Higman.powSub A 2).subgroupOf A) = (Work.Higman.powSub A 2).subgroupOf A :=
    Work.Higman.MSA.map_xi_subgroupOf h hA2inv hA.map_eq
  let ξA : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) ≃*
      (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) :=
    QuotientGroup.congr ((Work.Higman.powSub A 2).subgroupOf A)
      ((Work.Higman.powSub A 2).subgroupOf A) (Work.Higman.MSA.xiSubAut h hA.map_eq) hξA2
  have hξA_mk : ∀ a : ↥A,
      ξA (QuotientGroup.mk a) = QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hA.map_eq a) :=
    fun a => QuotientGroup.congr_mk _ _ _ _ a
  have hνqxi : ∀ q : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A),
      νq (ξA q) = Work.Higman.xiZ h (νq q) := by
    intro q
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective q
    rw [hξA_mk a, hνq_apply, hνq_apply, hΦxi a, hxiZeq]
  -- ## `ξ`-equivariance of the pairing
  have hβxi : ∀ (w : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A))
      (v : (↥D ⧸ (A.subgroupOf D))),
      β (ξA w) (ξD v) = Work.Higman.xiZ h (β w v) := by
    intro w v
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective w
    obtain ⟨d, rfl⟩ := QuotientGroup.mk_surjective v
    apply Subtype.ext
    rw [hξA_mk a, hξD_mk d,
      hβdef (Work.Higman.MSA.xiSubAut h hA.map_eq a) (Work.Higman.MSA.xiSubAut h hDinv d),
      Work.Higman.xiZ_apply, hβdef a d, Work.Higman.MSA.xiSubAut_apply h hA.map_eq a,
      Work.Higman.MSA.xiSubAut_apply h hDinv d]
    exact (map_commutatorElement (h.xi : MulAut P) (a : P) (d : P)).symm
  -- ## Elementaries on `ζ`, `νq` and `β`
  have hζ0 : ζ (0 : GaloisField 2 n) = 1 := by
    have h1 := hζadd 0 0
    rw [add_zero] at h1
    have h2 := congrArg (fun t => (ζ 0)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  have hζsymm_mul : ∀ a b : ↥(Work.Higman.omega1 P),
      ζ.symm (a * b) = ζ.symm a + ζ.symm b := by
    intro a b
    apply ζ.injective
    rw [Equiv.apply_symm_apply, hζadd, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hζsymm_one : ζ.symm (1 : ↥(Work.Higman.omega1 P)) = 0 := by
    rw [← hζ0, Equiv.symm_apply_apply]
  have hζsymm_xi : ∀ y : ↥(Work.Higman.omega1 P),
      ζ.symm (Work.Higman.xiZ h y) = (νU : GaloisField 2 n) * ζ.symm y := by
    intro y
    apply ζ.injective
    rw [Equiv.apply_symm_apply, hζmul, Equiv.apply_symm_apply]
  have hβone1 : ∀ v : (↥D ⧸ (A.subgroupOf D)),
      β (1 : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)) v = 1 := by
    intro v
    have h1 := hβadd1 (1 : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A))
      (1 : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)) v
    rw [one_mul] at h1
    have h2 := congrArg (fun t => (β 1 v)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  have hβone2 : ∀ (q : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)),
      β q (1 : (↥D ⧸ (A.subgroupOf D))) = 1 := by
    intro q
    have h1 := hβadd2 q (1 : (↥D ⧸ (A.subgroupOf D))) (1 : (↥D ⧸ (A.subgroupOf D)))
    rw [one_mul] at h1
    have h2 := congrArg (fun t => (β q 1)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  -- ## The function `Ψ` on representatives
  let PsiFun : (↥D ⧸ (A.subgroupOf D)) → GaloisField 2 n → GaloisField 2 n :=
    fun v x => ζ.symm (β (νq.symm (ζ x)) v)
  have hPsi0 : ∀ v, PsiFun v 0 = 0 := by
    intro v
    show ζ.symm (β (νq.symm (ζ 0)) v) = 0
    rw [hζ0, map_one, hβone1, hζsymm_one]
  have hPsiadd : ∀ v x y, PsiFun v (x + y) = PsiFun v x + PsiFun v y := by
    intro v x y
    show ζ.symm (β (νq.symm (ζ (x + y))) v) = ζ.symm (β (νq.symm (ζ x)) v)
      + ζ.symm (β (νq.symm (ζ y)) v)
    rw [hζadd x y, map_mul, hβadd1, hζsymm_mul]
  have hPsimul : ∀ v w x, PsiFun (v * w) x = PsiFun v x + PsiFun w x := by
    intro v w x
    show ζ.symm (β (νq.symm (ζ x)) (v * w)) = ζ.symm (β (νq.symm (ζ x)) v)
      + ζ.symm (β (νq.symm (ζ x)) w)
    rw [hβadd2, hζsymm_mul]
  have hPsi_one : ∀ x, PsiFun 1 x = 0 := by
    intro x
    show ζ.symm (β (νq.symm (ζ x)) 1) = 0
    rw [hβone2, hζsymm_one]
  have hPsiinj : ∀ v : (↥D ⧸ (A.subgroupOf D)), (∀ x, PsiFun v x = 0) → v = 1 := by
    intro v hv
    refine hβnondeg v ?_
    intro q
    obtain ⟨x, hx⟩ := ζ.surjective (νq q)
    have h2 : ζ.symm (β q v) = 0 := by
      have h3 : ζ.symm (β (νq.symm (ζ x)) v) = 0 := hv x
      rwa [show νq.symm (ζ x) = q from by rw [hx]; exact νq.symm_apply_apply q] at h3
    have h4 : β q v = 1 := by
      have h5 := congrArg ζ h2
      rwa [Equiv.apply_symm_apply, hζ0] at h5
    exact h4
  have hPsixi : ∀ v x, PsiFun (ξD v) x
      = (νU : GaloisField 2 n) * PsiFun v ((νU : GaloisField 2 n)⁻¹ * x) := by
    intro v x
    have h1 : νq.symm (ζ x) = ξA (νq.symm (ζ ((νU : GaloisField 2 n)⁻¹ * x))) := by
      apply νq.injective
      rw [MulEquiv.apply_symm_apply, hνqxi, MulEquiv.apply_symm_apply, ← hζmul,
        mul_inv_cancel_left₀ (Units.ne_zero νU)]
    show ζ.symm (β (νq.symm (ζ x)) (ξD v))
      = (νU : GaloisField 2 n) * ζ.symm (β (νq.symm (ζ ((νU : GaloisField 2 n)⁻¹ * x))) v)
    rw [h1, hβxi, hζsymm_xi]
  -- ## The `𝔽₂`-module `V = D/A`
  let V := Additive (↥D ⧸ (A.subgroupOf D))
  have hcommD : ⁅(⊤ : Subgroup ↥D), (⊤ : Subgroup ↥D)⁆ ≤ A.subgroupOf D := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    rw [Subgroup.mem_subgroupOf]
    have hmem : ⁅(x : P), (y : P)⁆ ∈ ⁅D, D⁆ := Subgroup.commutator_mem_commutator x.2 y.2
    rw [hDd] at hmem
    have hcoe : ((⁅x, y⁆ : ↥D) : P) = ⁅(x : P), (y : P)⁆ := map_commutatorElement D.subtype x y
    rw [hcoe]
    exact Work.Higman.powSub_le (by norm_num : 0 < 2) hmem
  letI : CommGroup (↥D ⧸ (A.subgroupOf D)) :=
    Work.Higman.SZ.commGroup_quot_of_commutator_le (A.subgroupOf D) hcommD
  have hV2 : ∀ u : (↥D ⧸ (A.subgroupOf D)), u * u = 1 := by
    intro u
    induction u using QuotientGroup.induction_on with
    | _ d =>
        show (QuotientGroup.mk d) * (QuotientGroup.mk d) = 1
        rw [← QuotientGroup.mk_mul]
        exact (QuotientGroup.eq_one_iff (N := A.subgroupOf D) (d * d)).mpr
          (Subgroup.mem_subgroupOf.mpr (by simpa [pow_two] using hsq (d : P)))
  letI : Module (ZMod 2) V := Work.Higman.SZ.module_zmod2_of_sq_one hV2
  let σlin : V →ₗ[ZMod 2] V := AddMonoidHom.toZModLinearMap 2 (ξD.toAdditive : V →+ V)
  have hσlin_apply : ∀ q, σlin (Additive.ofMul q) = Additive.ofMul (ξD q) := fun q => rfl
  have hσlin_bij : Function.Bijective σlin :=
    ⟨fun a b hab => ξD.toAdditive.injective hab,
      fun b => ⟨ξD.toAdditive.symm b, ξD.toAdditive.apply_symm_apply b⟩⟩
  let ξV : V ≃ₗ[ZMod 2] V := LinearEquiv.ofBijective σlin hσlin_bij
  have hξV_apply : ∀ q, ξV (Additive.ofMul q) = Additive.ofMul (ξD q) := fun q => hσlin_apply q
  -- ## Cardinality of `V`
  have hsubcard : Nat.card ↥(A.subgroupOf D) = Nat.card ↥A := by
    let f : ↥(A.subgroupOf D) → ↥A := fun x => ⟨((x : ↥D) : P), x.2⟩
    let g : ↥A → ↥(A.subgroupOf D) := fun a => ⟨⟨(a : P), hAD a.2⟩, a.2⟩
    exact Nat.card_congr { toFun := f, invFun := g, left_inv := fun x => rfl, right_inv := fun x => rfl }
  have hVcard : Nat.card V = 2 ^ n := by
    have hq : Nat.card ↥(Work.Higman.omega1 P) = 2 ^ n := by
      rw [← Nat.card_congr ζ, Work.Higman.H8.card_galois (by omega)]
    have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf D)
    rw [hsubcard] at hmul
    have hD : Nat.card ↥D = (2 ^ n) ^ 3 := by rw [← hq]; exact hDcard
    have hA' : Nat.card ↥A = (2 ^ n) ^ 2 := by rw [← hq]; exact hcard
    rw [hD, hA'] at hmul
    have hdiv : Nat.card (↥D ⧸ (A.subgroupOf D)) = 2 ^ n := by
      have hmul' : (2 ^ n) * (2 ^ n) ^ 2
          = Nat.card (↥D ⧸ (A.subgroupOf D)) * (2 ^ n) ^ 2 := by
        rw [← hmul]; ring
      exact (Nat.mul_right_cancel (by positivity) hmul').symm
    show Nat.card (Additive (↥D ⧸ (A.subgroupOf D))) = 2 ^ n
    rw [Nat.card_congr Additive.ofMul]
    exact hdiv
  -- ## Simplicity of `V`
  have hnormal_of_contains : ∀ F' : Subgroup P, A ≤ F' → F'.Normal := by
    intro F' hAF
    refine Subgroup.Normal.mk (fun n hn g => ?_)
    have hc : ⁅g, n⁆ ∈ A := by
      have h1 := Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top n)
      rwa [hGs] at h1
    have h2 : g * n * g⁻¹ = ⁅g, n⁆ * n := by
      rw [commutatorElement_def]; group
    rw [h2]
    exact F'.mul_mem (hAF hc) hn
  have hsimple : ∀ W : Submodule (ZMod 2) V, (∀ v ∈ W, ξV v ∈ W) → W = ⊥ ∨ W = ⊤ := by
    intro W hW
    let E : Subgroup (↥D ⧸ (A.subgroupOf D)) :=
      { carrier := {q | Additive.ofMul q ∈ W}
        one_mem' := by
          show Additive.ofMul (1 : ↥D ⧸ (A.subgroupOf D)) ∈ W
          rw [ofMul_one]; exact W.zero_mem
        mul_mem' := by
          intro a b ha hb
          show Additive.ofMul (a * b) ∈ W
          rw [ofMul_mul]; exact W.add_mem ha hb
        inv_mem' := by
          intro a ha
          show Additive.ofMul a⁻¹ ∈ W
          rw [ofMul_inv]; exact W.neg_mem ha }
    have hEmem : ∀ q : (↥D ⧸ (A.subgroupOf D)), q ∈ E ↔ Additive.ofMul q ∈ W := fun q => Iff.rfl
    let Esub : Subgroup ↥D := E.comap (QuotientGroup.mk' (A.subgroupOf D))
    have hEmem2 : ∀ u : ↥D, u ∈ Esub ↔
        (QuotientGroup.mk u : (↥D ⧸ (A.subgroupOf D))) ∈ E := by
      intro u
      rw [Subgroup.mem_comap, QuotientGroup.mk'_apply]
    have hEξ : ∀ u : ↥D, (QuotientGroup.mk u : (↥D ⧸ (A.subgroupOf D))) ∈ E →
        (QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hDinv u)
          : (↥D ⧸ (A.subgroupOf D))) ∈ E := by
      intro u hu
      rw [hEmem] at hu ⊢
      have h1 : ξV (Additive.ofMul (QuotientGroup.mk u)) ∈ W := hW _ hu
      have h2 : ξV (Additive.ofMul (QuotientGroup.mk u))
          = Additive.ofMul (QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hDinv u)) := by
        rw [hξV_apply, hξD_mk]
      rwa [h2] at h1
    set Fp : Subgroup P := Esub.map D.subtype with hFp
    have hAFp : A ≤ Fp := by
      intro a ha
      rw [hFp]
      refine Subgroup.mem_map.mpr ⟨(⟨a, hAD ha⟩ : ↥D), ?_, rfl⟩
      rw [hEmem2, hEmem]
      have h1 : (QuotientGroup.mk (⟨a, hAD ha⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D))) = 1 :=
        (QuotientGroup.eq_one_iff (N := A.subgroupOf D) (⟨a, hAD ha⟩ : ↥D)).mpr
          (Subgroup.mem_subgroupOf.mpr ha)
      rw [h1, ofMul_one]; exact W.zero_mem
    have hFpD : Fp ≤ D := by rw [hFp]; exact Subgroup.map_subtype_le Esub
    have hFpinv_le : Fp.map (h.xi : MulAut P).toMonoidHom ≤ Fp := by
      intro x hx
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
      rw [hFp] at hy ⊢
      obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hy
      refine Subgroup.mem_map.mpr ⟨(Work.Higman.MSA.xiSubAut h hDinv u : ↥D), ?_, ?_⟩
      · rw [hEmem2]
        exact hEξ u ((hEmem2 u).mp hu)
      · exact (Work.Higman.MSA.xiSubAut_apply h hDinv u)
    have hFpinv : Fp.map (h.xi : MulAut P).toMonoidHom = Fp :=
      Subgroup.eq_of_le_of_card_ge hFpinv_le
        (le_of_eq (Subgroup.card_map_of_injective (h.xi : MulAut P).injective).symm)
    have hFpn : Fp.Normal := hnormal_of_contains Fp hAFp
    rcases hirrD Fp hFpn hFpinv hAFp hFpD with hFA | hFD
    · left
      rw [Submodule.eq_bot_iff]
      intro y hy
      obtain ⟨q, rfl⟩ : ∃ q, Additive.ofMul q = y := ⟨Additive.toMul y, rfl⟩
      have hqE : q ∈ E := (hEmem q).mpr hy
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (A.subgroupOf D) q
      have huFp : (u : P) ∈ Fp := by
        rw [hFp]; exact Subgroup.mem_map.mpr ⟨u, (hEmem2 u).mpr hqE, rfl⟩
      rw [hFA] at huFp
      have hq1 : QuotientGroup.mk' (A.subgroupOf D) u = 1 := by
        rw [QuotientGroup.mk'_apply]
        exact (QuotientGroup.eq_one_iff u).mpr (Subgroup.mem_subgroupOf.mpr huFp)
      rw [hq1, ofMul_one]
    · right
      rw [Submodule.eq_top_iff']
      intro y
      obtain ⟨q, rfl⟩ : ∃ q, Additive.ofMul q = y := ⟨Additive.toMul y, rfl⟩
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (A.subgroupOf D) q
      have huFp : (u : P) ∈ Fp := by rw [hFD]; exact u.2
      rw [hFp] at huFp
      obtain ⟨u', hu', hu'eq⟩ := Subgroup.mem_map.mp huFp
      have h1 : u' = u := D.subtype_injective hu'eq
      rw [← h1]
      exact (hEmem (QuotientGroup.mk' (A.subgroupOf D) u')).mp ((hEmem2 u').mp hu')
  -- ## The linear map `Ψ : V → End_{𝔽₂}(GF(2^n))`
  let EndF := GaloisField 2 n →ₗ[ZMod 2] GaloisField 2 n
  let Ψfun : (↥D ⧸ (A.subgroupOf D)) → EndF := fun v =>
    AddMonoidHom.toZModLinearMap 2
      { toFun := PsiFun v, map_zero' := hPsi0 v, map_add' := hPsiadd v }
  have hΨfun_apply : ∀ v x, Ψfun v x = PsiFun v x := fun v x => rfl
  have hΨfun_add : ∀ v w, Ψfun (v * w) = Ψfun v + Ψfun w := by
    intro v w
    ext x
    rw [hΨfun_apply, LinearMap.add_apply, hΨfun_apply, hΨfun_apply]
    exact hPsimul v w x
  have hΨfun_one : Ψfun 1 = 0 := by
    ext x
    rw [hΨfun_apply, LinearMap.zero_apply]
    exact hPsi_one x
  let Ψadd : V →+ EndF :=
    { toFun := fun v => Ψfun (Additive.toMul v)
      map_zero' := by
        show Ψfun (Additive.toMul (0 : V)) = 0
        rw [show Additive.toMul (0 : V) = 1 from rfl]
        exact hΨfun_one
      map_add' := by
        intro v w
        show Ψfun (Additive.toMul (v + w)) = Ψfun (Additive.toMul v) + Ψfun (Additive.toMul w)
        rw [toMul_add]
        exact hΨfun_add _ _ }
  let Ψ : V →ₗ[ZMod 2] EndF := AddMonoidHom.toZModLinearMap 2 Ψadd
  have hΨ_apply : ∀ (v : (↥D ⧸ (A.subgroupOf D))) x, Ψ (Additive.ofMul v) x = PsiFun v x := by
    intro v x
    show Ψadd (Additive.ofMul v) x = PsiFun v x
    rfl
  have hΨinj : Function.Injective Ψ := by
    intro v w hvw
    have h1 : ∀ x, PsiFun (Additive.toMul (v - w)) x = 0 := by
      intro x
      have h2 : Ψ (v - w) = 0 := by rw [map_sub, hvw, sub_self]
      have h3 : Ψ (v - w) x = 0 := by rw [h2]; rfl
      have h4 : Ψ (Additive.ofMul (Additive.toMul (v - w))) x = 0 := h3
      rwa [hΨ_apply] at h4
    have h5 : Additive.toMul (v - w) = 1 := hPsiinj _ h1
    have h6 : v - w = 0 := by
      have h7 := congrArg Additive.ofMul h5
      rw [ofMul_one] at h7
      simpa using h7
    exact sub_eq_zero.mp h6
  have hΨeq : ∀ v : V, Ψ (ξV v) = Work.Higman.H8.FSB.singAct νU (Ψ v) := by
    intro v
    obtain ⟨v', rfl⟩ : ∃ v' : (↥D ⧸ (A.subgroupOf D)), Additive.ofMul v' = v :=
      ⟨Additive.toMul v, rfl⟩
    ext x
    rw [Work.Higman.H8.FSB.singAct_apply, Work.Higman.H8.conjAction_apply,
      Units.val_inv_eq_inv_val]
    show Ψ (ξV (Additive.ofMul v')) x
      = (νU : GaloisField 2 n) * Ψ (Additive.ofMul v') ((νU : GaloisField 2 n)⁻¹ * x)
    rw [hξV_apply, hΨ_apply, hΨ_apply]
    exact hPsixi v' x
  -- ## Apply the abstract layer lemma
  obtain ⟨k, hk, φlin, hφlin0, hφlinxi, hφlinsurj⟩ :=
    Work.Higman.H8.layer_of_end_injection hn2 νU hνord hVcard ξV hsimple Ψ hΨinj hΨeq
  -- ## The coordinate function on `P`
  let φ : P → GaloisField 2 n := fun c =>
    if hc : c ∈ D then φlin (Additive.ofMul (QuotientGroup.mk (⟨c, hc⟩ : ↥D))) else 0
  have hφ_apply : ∀ (c : P) (hc : c ∈ D),
      φ c = φlin (Additive.ofMul (QuotientGroup.mk (⟨c, hc⟩ : ↥D))) := by
    intro c hc
    simp only [φ, dif_pos hc]
  have hlam : ∀ k : ℕ, Work.Higman.H8.lam νU k = (νU : GaloisField 2 n) ^ (1 - (2 : ℤ) ^ k) := by
    intro k
    rw [Work.Higman.H8.lam,
      show (1 : ℤ) - (2 : ℤ) ^ k = 1 + (-((2 : ℤ) ^ k)) from by ring,
      zpow_add₀ (Units.ne_zero νU), zpow_one, zpow_neg,
      show ((2 : ℤ) ^ k) = ((2 ^ k : ℕ) : ℤ) from by push_cast; ring, zpow_natCast]
  have hνord' : orderOf ((νU : GaloisField 2 n)) = 2 ^ n - 1 := by
    rw [orderOf_units]; exact hνord
  refine ⟨n, GaloisField 2 n, inferInstance, Work.Higman.H8.galoisFintype, Work.Higman.H8.galoisDecEq,
    inferInstance, (νU : GaloisField 2 n), k, φ, ?_, hn2, hνord', hk, ?_, ?_, ?_, ?_⟩
  · rw [← Nat.card_eq_fintype_card, Work.Higman.H8.card_galois (by omega)]
  · intro c c' hc hc'
    have h3 : c * c' ∈ D := D.mul_mem hc hc'
    rw [hφ_apply (c * c') h3, hφ_apply c hc, hφ_apply c' hc']
    have hmk : (QuotientGroup.mk (⟨c * c', h3⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D)))
        = QuotientGroup.mk (⟨c, hc⟩ : ↥D) * QuotientGroup.mk (⟨c', hc'⟩ : ↥D) := rfl
    rw [hmk, ofMul_mul, map_add]
  · intro c hc
    rw [hφ_apply c hc, hφlin0]
    constructor
    · intro h
      have h1 : (QuotientGroup.mk (⟨c, hc⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D))) = 1 :=
        ofMul_eq_zero.mp h
      exact Subgroup.mem_subgroupOf.mp
        ((QuotientGroup.eq_one_iff (N := A.subgroupOf D) (⟨c, hc⟩ : ↥D)).mp h1)
    · intro h
      have h1 : (QuotientGroup.mk (⟨c, hc⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D))) = 1 :=
        (QuotientGroup.eq_one_iff (N := A.subgroupOf D) (⟨c, hc⟩ : ↥D)).mpr
          (Subgroup.mem_subgroupOf.mpr h)
      rw [h1, ofMul_one]
  · intro c hc
    have hξc : h.xi c ∈ D := by
      have h1 : h.xi c ∈ D.map (h.xi : MulAut P).toMonoidHom := Subgroup.mem_map_of_mem _ hc
      rwa [hDinv] at h1
    rw [hφ_apply (h.xi c) hξc, hφ_apply c hc]
    have hmk : (QuotientGroup.mk (⟨h.xi c, hξc⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D)))
        = ξD (QuotientGroup.mk (⟨c, hc⟩ : ↥D)) := by
      rw [hξD_mk]
      exact congrArg (fun x : ↥D => (QuotientGroup.mk x : (↥D ⧸ (A.subgroupOf D))))
        (Subtype.ext (Work.Higman.MSA.xiSubAut_apply h hDinv ⟨c, hc⟩).symm)
    rw [hmk, ← hξV_apply, hφlinxi, hlam k]
  · intro x
    obtain ⟨v, hv⟩ := hφlinsurj x
    obtain ⟨q, rfl⟩ : ∃ q : (↥D ⧸ (A.subgroupOf D)), Additive.ofMul q = v :=
      ⟨Additive.toMul v, rfl⟩
    obtain ⟨d, hd⟩ := QuotientGroup.mk_surjective q
    refine ⟨(d : P), d.2, ?_⟩
    rw [hφ_apply (d : P) d.2]
    have hdd : (QuotientGroup.mk (⟨(d : P), d.2⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D))) = q := hd
    rw [hdd]
    exact hv

end Work.Higman.HS
end

-- ===== from Submission.Work.Commutator.two_cover_psi_form_sq =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1600000

namespace Work.Commutator

open scoped commutatorElement

/-- The Frobenius-component form of the layer pairing of a cover `D` of `A`, with the
extra information that the coordinate function `φ` on `D/A` is additive and that the
isomorphism `νq : A/A² ≅ Ω₁(P)` is *the squaring map* `ā ↦ a²`. -/
private theorem two_cover_psi_form_sq {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} [hAn : A.Normal]
    [hN1 : ((Work.Higman.powSub A 2).subgroupOf A).Normal]
    [hN2 : (A.subgroupOf D).Normal]
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : A ≠ D)
    (hirrD : ∀ F' : Subgroup P, F'.Normal → F'.map (h.xi : MulAut P).toMonoidHom = F' →
      A ≤ F' → F' ≤ D → F' = A ∨ F' = D)
    (hDd : Bracket.bracket D D = Work.Higman.powSub A 2)
    (hDcard : Nat.card ↥D = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3) :
    ∃ (n : ℕ) (ν : (GaloisField 2 n)ˣ) (ζ : GaloisField 2 n ≃ ↥(Work.Higman.omega1 P))
      (k : ℕ) (φ : (↥D ⧸ (A.subgroupOf D)) → GaloisField 2 n)
      (νq : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) ≃* ↥(Work.Higman.omega1 P))
      (β : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) →
            (↥D ⧸ (A.subgroupOf D)) → ↥(Work.Higman.omega1 P)),
      2 ≤ n ∧ orderOf ν = 2 ^ n - 1 ∧ k < n ∧
      (∀ x y : GaloisField 2 n, ζ (x + y) = ζ x * ζ y) ∧
      (∀ x : GaloisField 2 n, ζ ((ν : GaloisField 2 n) * x) = Work.Higman.xiZ h (ζ x)) ∧
      (∀ (a : ↥A) (d : ↥D),
        ((β (QuotientGroup.mk a) (QuotientGroup.mk d) : ↥(Work.Higman.omega1 P)) : P)
          = (a : P) * (d : P) * (a : P)⁻¹ * (d : P)⁻¹) ∧
      (∀ v : (↥D ⧸ (A.subgroupOf D)), φ v = 0 ↔ v = 1) ∧
      (∀ (q : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)
         (v : (↥D ⧸ (A.subgroupOf D))),
        ζ.symm (β q v) = φ v * (ζ.symm (νq q)) ^ (2 ^ k)) ∧
      (∀ x y : (↥D ⧸ (A.subgroupOf D)), φ (x * y) = φ x + φ y) ∧
      (∀ a : ↥A, νq (QuotientGroup.mk a)
        = ⟨(a : P) ^ 2, htop ▸ Work.Higman.pow_mem_powSub (n := 2) a.2⟩) := by
  classical
  haveI hpowN : (Work.Higman.powSub A 2).Normal := Work.Higman.powSub_normal hAn 2
  -- ## The Singer data
  obtain ⟨n, νU, ζ, hn2, hνord, hζadd, hζmul⟩ := Work.Higman.HS.two_cover_singer_data h
  -- ## The commutator pairing `A/A² × D/A → Ω₁`
  obtain ⟨β, hβdef, hβadd1, hβadd2, hβnondeg⟩ :=
    Work.Higman.HS.two_cover_pairing h hA hGs htop hAD hDd hcent
  -- ## The squaring isomorphism `A/A² ≅ Ω₁`, built from the *squaring map*
  obtain ⟨Φ, hΦbij, hΦsq⟩ := Work.Higman.H8.c4nocard_nu_iso h hA htop hcard
  have hΦxi : ∀ a : ↥A, Φ (QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hA.map_eq a))
      = Work.Higman.MSA.xiSubAut h (Work.Higman.map_xi_omega1 h) (Φ (QuotientGroup.mk a)) := by
    intro a
    rw [hΦsq (Work.Higman.MSA.xiSubAut h hA.map_eq a), hΦsq a]
    refine Subtype.ext ?_
    change ((Work.Higman.MSA.xiSubAut h hA.map_eq a : ↥A) : P) ^ 2 = h.xi ((a : P) ^ 2)
    rw [Work.Higman.MSA.xiSubAut_apply, ← map_pow]
  let νq : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) ≃* ↥(Work.Higman.omega1 P) :=
    MulEquiv.ofBijective Φ hΦbij
  have hνq_apply : ∀ q, νq q = Φ q := fun q => rfl
  have hxiZeq : Work.Higman.MSA.xiSubAut h (Work.Higman.map_xi_omega1 h) = Work.Higman.xiZ h :=
    MulEquiv.ext (fun z => Subtype.ext rfl)
  -- ## The `ξ`-action on `D/A`
  let ξD : (↥D ⧸ (A.subgroupOf D)) ≃* (↥D ⧸ (A.subgroupOf D)) :=
    QuotientGroup.congr (A.subgroupOf D) (A.subgroupOf D) (Work.Higman.MSA.xiSubAut h hDinv)
      (Work.Higman.MSA.map_xi_subgroupOf h hA.map_eq hDinv)
  have hξD_mk : ∀ d : ↥D,
      ξD (QuotientGroup.mk d) = QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hDinv d) :=
    fun d => QuotientGroup.congr_mk _ _ _ _ d
  -- ## The `ξ`-action on `A/A²`
  have hA2inv : (Work.Higman.powSub A 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub A 2 :=
    Work.Higman.map_powSub (h.xi : MulAut P) hA.map_eq 2
  have hξA2 : Subgroup.map (Work.Higman.MSA.xiSubAut h hA.map_eq)
      ((Work.Higman.powSub A 2).subgroupOf A) = (Work.Higman.powSub A 2).subgroupOf A :=
    Work.Higman.MSA.map_xi_subgroupOf h hA2inv hA.map_eq
  let ξA : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) ≃*
      (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) :=
    QuotientGroup.congr ((Work.Higman.powSub A 2).subgroupOf A)
      ((Work.Higman.powSub A 2).subgroupOf A) (Work.Higman.MSA.xiSubAut h hA.map_eq) hξA2
  have hξA_mk : ∀ a : ↥A,
      ξA (QuotientGroup.mk a) = QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hA.map_eq a) :=
    fun a => QuotientGroup.congr_mk _ _ _ _ a
  have hνqxi : ∀ q : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A),
      νq (ξA q) = Work.Higman.xiZ h (νq q) := by
    intro q
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective q
    rw [hξA_mk a, hνq_apply, hνq_apply, hΦxi a, hxiZeq]
  -- ## `ξ`-equivariance of the pairing
  have hβxi : ∀ (w : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A))
      (v : (↥D ⧸ (A.subgroupOf D))),
      β (ξA w) (ξD v) = Work.Higman.xiZ h (β w v) := by
    intro w v
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective w
    obtain ⟨d, rfl⟩ := QuotientGroup.mk_surjective v
    apply Subtype.ext
    rw [hξA_mk a, hξD_mk d,
      hβdef (Work.Higman.MSA.xiSubAut h hA.map_eq a) (Work.Higman.MSA.xiSubAut h hDinv d),
      Work.Higman.xiZ_apply, hβdef a d, Work.Higman.MSA.xiSubAut_apply h hA.map_eq a,
      Work.Higman.MSA.xiSubAut_apply h hDinv d]
    exact (map_commutatorElement (h.xi : MulAut P) (a : P) (d : P)).symm
  -- ## Elementaries on `ζ`, `νq` and `β`
  have hζ0 : ζ (0 : GaloisField 2 n) = 1 := by
    have h1 := hζadd 0 0
    rw [add_zero] at h1
    have h2 := congrArg (fun t => (ζ 0)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  have hζsymm_mul : ∀ a b : ↥(Work.Higman.omega1 P),
      ζ.symm (a * b) = ζ.symm a + ζ.symm b := by
    intro a b
    apply ζ.injective
    rw [Equiv.apply_symm_apply, hζadd, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hζsymm_one : ζ.symm (1 : ↥(Work.Higman.omega1 P)) = 0 := by
    rw [← hζ0, Equiv.symm_apply_apply]
  have hζsymm_xi : ∀ y : ↥(Work.Higman.omega1 P),
      ζ.symm (Work.Higman.xiZ h y) = (νU : GaloisField 2 n) * ζ.symm y := by
    intro y
    apply ζ.injective
    rw [Equiv.apply_symm_apply, hζmul, Equiv.apply_symm_apply]
  have hβone1 : ∀ v : (↥D ⧸ (A.subgroupOf D)),
      β (1 : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)) v = 1 := by
    intro v
    have h1 := hβadd1 (1 : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A))
      (1 : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)) v
    rw [one_mul] at h1
    have h2 := congrArg (fun t => (β 1 v)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  have hβone2 : ∀ (q : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)),
      β q (1 : (↥D ⧸ (A.subgroupOf D))) = 1 := by
    intro q
    have h1 := hβadd2 q (1 : (↥D ⧸ (A.subgroupOf D))) (1 : (↥D ⧸ (A.subgroupOf D)))
    rw [one_mul] at h1
    have h2 := congrArg (fun t => (β q 1)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  -- ## The function `Ψ` on representatives
  let PsiFun : (↥D ⧸ (A.subgroupOf D)) → GaloisField 2 n → GaloisField 2 n :=
    fun v x => ζ.symm (β (νq.symm (ζ x)) v)
  have hPsi0 : ∀ v, PsiFun v 0 = 0 := by
    intro v
    show ζ.symm (β (νq.symm (ζ 0)) v) = 0
    rw [hζ0, map_one, hβone1, hζsymm_one]
  have hPsiadd : ∀ v x y, PsiFun v (x + y) = PsiFun v x + PsiFun v y := by
    intro v x y
    show ζ.symm (β (νq.symm (ζ (x + y))) v) = ζ.symm (β (νq.symm (ζ x)) v)
      + ζ.symm (β (νq.symm (ζ y)) v)
    rw [hζadd x y, map_mul, hβadd1, hζsymm_mul]
  have hPsimul : ∀ v w x, PsiFun (v * w) x = PsiFun v x + PsiFun w x := by
    intro v w x
    show ζ.symm (β (νq.symm (ζ x)) (v * w)) = ζ.symm (β (νq.symm (ζ x)) v)
      + ζ.symm (β (νq.symm (ζ x)) w)
    rw [hβadd2, hζsymm_mul]
  have hPsi_one : ∀ x, PsiFun 1 x = 0 := by
    intro x
    show ζ.symm (β (νq.symm (ζ x)) 1) = 0
    rw [hβone2, hζsymm_one]
  have hPsiinj : ∀ v : (↥D ⧸ (A.subgroupOf D)), (∀ x, PsiFun v x = 0) → v = 1 := by
    intro v hv
    refine hβnondeg v ?_
    intro q
    obtain ⟨x, hx⟩ := ζ.surjective (νq q)
    have h2 : ζ.symm (β q v) = 0 := by
      have h3 : ζ.symm (β (νq.symm (ζ x)) v) = 0 := hv x
      rwa [show νq.symm (ζ x) = q from by rw [hx]; exact νq.symm_apply_apply q] at h3
    have h4 : β q v = 1 := by
      have h5 := congrArg ζ h2
      rwa [Equiv.apply_symm_apply, hζ0] at h5
    exact h4
  have hPsixi : ∀ v x, PsiFun (ξD v) x
      = (νU : GaloisField 2 n) * PsiFun v ((νU : GaloisField 2 n)⁻¹ * x) := by
    intro v x
    have h1 : νq.symm (ζ x) = ξA (νq.symm (ζ ((νU : GaloisField 2 n)⁻¹ * x))) := by
      apply νq.injective
      rw [MulEquiv.apply_symm_apply, hνqxi, MulEquiv.apply_symm_apply, ← hζmul,
        mul_inv_cancel_left₀ (Units.ne_zero νU)]
    show ζ.symm (β (νq.symm (ζ x)) (ξD v))
      = (νU : GaloisField 2 n) * ζ.symm (β (νq.symm (ζ ((νU : GaloisField 2 n)⁻¹ * x))) v)
    rw [h1, hβxi, hζsymm_xi]
  -- ## The `𝔽₂`-module `V = D/A`
  let V := Additive (↥D ⧸ (A.subgroupOf D))
  have hcommD : ⁅(⊤ : Subgroup ↥D), (⊤ : Subgroup ↥D)⁆ ≤ A.subgroupOf D := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    rw [Subgroup.mem_subgroupOf]
    have hmem : ⁅(x : P), (y : P)⁆ ∈ ⁅D, D⁆ := Subgroup.commutator_mem_commutator x.2 y.2
    rw [hDd] at hmem
    have hcoe : ((⁅x, y⁆ : ↥D) : P) = ⁅(x : P), (y : P)⁆ := map_commutatorElement D.subtype x y
    rw [hcoe]
    exact Work.Higman.powSub_le (by norm_num : 0 < 2) hmem
  letI : CommGroup (↥D ⧸ (A.subgroupOf D)) :=
    Work.Higman.SZ.commGroup_quot_of_commutator_le (A.subgroupOf D) hcommD
  have hV2 : ∀ u : (↥D ⧸ (A.subgroupOf D)), u * u = 1 := by
    intro u
    induction u using QuotientGroup.induction_on with
    | _ d =>
        show (QuotientGroup.mk d) * (QuotientGroup.mk d) = 1
        rw [← QuotientGroup.mk_mul]
        exact (QuotientGroup.eq_one_iff (N := A.subgroupOf D) (d * d)).mpr
          (Subgroup.mem_subgroupOf.mpr (by simpa [pow_two] using hsq (d : P)))
  letI : Module (ZMod 2) V := Work.Higman.SZ.module_zmod2_of_sq_one hV2
  let σlin : V →ₗ[ZMod 2] V := AddMonoidHom.toZModLinearMap 2 (ξD.toAdditive : V →+ V)
  have hσlin_apply : ∀ q, σlin (Additive.ofMul q) = Additive.ofMul (ξD q) := fun q => rfl
  have hσlin_bij : Function.Bijective σlin :=
    ⟨fun a b hab => ξD.toAdditive.injective hab,
      fun b => ⟨ξD.toAdditive.symm b, ξD.toAdditive.apply_symm_apply b⟩⟩
  let ξV : V ≃ₗ[ZMod 2] V := LinearEquiv.ofBijective σlin hσlin_bij
  have hξV_apply : ∀ q, ξV (Additive.ofMul q) = Additive.ofMul (ξD q) := fun q => hσlin_apply q
  -- ## Cardinality of `V`
  have hsubcard : Nat.card ↥(A.subgroupOf D) = Nat.card ↥A := by
    let f : ↥(A.subgroupOf D) → ↥A := fun x => ⟨((x : ↥D) : P), x.2⟩
    let g : ↥A → ↥(A.subgroupOf D) := fun a => ⟨⟨(a : P), hAD a.2⟩, a.2⟩
    exact Nat.card_congr { toFun := f, invFun := g, left_inv := fun x => rfl, right_inv := fun x => rfl }
  have hVcard : Nat.card V = 2 ^ n := by
    have hq : Nat.card ↥(Work.Higman.omega1 P) = 2 ^ n := by
      rw [← Nat.card_congr ζ, Work.Higman.H8.card_galois (by omega)]
    have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf D)
    rw [hsubcard] at hmul
    have hD : Nat.card ↥D = (2 ^ n) ^ 3 := by rw [← hq]; exact hDcard
    have hA' : Nat.card ↥A = (2 ^ n) ^ 2 := by rw [← hq]; exact hcard
    rw [hD, hA'] at hmul
    have hdiv : Nat.card (↥D ⧸ (A.subgroupOf D)) = 2 ^ n := by
      have hmul' : (2 ^ n) * (2 ^ n) ^ 2
          = Nat.card (↥D ⧸ (A.subgroupOf D)) * (2 ^ n) ^ 2 := by
        rw [← hmul]; ring
      exact (Nat.mul_right_cancel (by positivity) hmul').symm
    show Nat.card (Additive (↥D ⧸ (A.subgroupOf D))) = 2 ^ n
    rw [Nat.card_congr Additive.ofMul]
    exact hdiv
  -- ## Simplicity of `V`
  have hnormal_of_contains : ∀ F' : Subgroup P, A ≤ F' → F'.Normal := by
    intro F' hAF
    refine Subgroup.Normal.mk (fun n hn g => ?_)
    have hc : ⁅g, n⁆ ∈ A := by
      have h1 := Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top n)
      rwa [hGs] at h1
    have h2 : g * n * g⁻¹ = ⁅g, n⁆ * n := by
      rw [commutatorElement_def]; group
    rw [h2]
    exact F'.mul_mem (hAF hc) hn
  have hsimple : ∀ W : Submodule (ZMod 2) V, (∀ v ∈ W, ξV v ∈ W) → W = ⊥ ∨ W = ⊤ := by
    intro W hW
    let E : Subgroup (↥D ⧸ (A.subgroupOf D)) :=
      { carrier := {q | Additive.ofMul q ∈ W}
        one_mem' := by
          show Additive.ofMul (1 : ↥D ⧸ (A.subgroupOf D)) ∈ W
          rw [ofMul_one]; exact W.zero_mem
        mul_mem' := by
          intro a b ha hb
          show Additive.ofMul (a * b) ∈ W
          rw [ofMul_mul]; exact W.add_mem ha hb
        inv_mem' := by
          intro a ha
          show Additive.ofMul a⁻¹ ∈ W
          rw [ofMul_inv]; exact W.neg_mem ha }
    have hEmem : ∀ q : (↥D ⧸ (A.subgroupOf D)), q ∈ E ↔ Additive.ofMul q ∈ W := fun q => Iff.rfl
    let Esub : Subgroup ↥D := E.comap (QuotientGroup.mk' (A.subgroupOf D))
    have hEmem2 : ∀ u : ↥D, u ∈ Esub ↔
        (QuotientGroup.mk u : (↥D ⧸ (A.subgroupOf D))) ∈ E := by
      intro u
      rw [Subgroup.mem_comap, QuotientGroup.mk'_apply]
    have hEξ : ∀ u : ↥D, (QuotientGroup.mk u : (↥D ⧸ (A.subgroupOf D))) ∈ E →
        (QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hDinv u)
          : (↥D ⧸ (A.subgroupOf D))) ∈ E := by
      intro u hu
      rw [hEmem] at hu ⊢
      have h1 : ξV (Additive.ofMul (QuotientGroup.mk u)) ∈ W := hW _ hu
      have h2 : ξV (Additive.ofMul (QuotientGroup.mk u))
          = Additive.ofMul (QuotientGroup.mk (Work.Higman.MSA.xiSubAut h hDinv u)) := by
        rw [hξV_apply, hξD_mk]
      rwa [h2] at h1
    set Fp : Subgroup P := Esub.map D.subtype with hFp
    have hAFp : A ≤ Fp := by
      intro a ha
      rw [hFp]
      refine Subgroup.mem_map.mpr ⟨(⟨a, hAD ha⟩ : ↥D), ?_, rfl⟩
      rw [hEmem2, hEmem]
      have h1 : (QuotientGroup.mk (⟨a, hAD ha⟩ : ↥D) : (↥D ⧸ (A.subgroupOf D))) = 1 :=
        (QuotientGroup.eq_one_iff (N := A.subgroupOf D) (⟨a, hAD ha⟩ : ↥D)).mpr
          (Subgroup.mem_subgroupOf.mpr ha)
      rw [h1, ofMul_one]; exact W.zero_mem
    have hFpD : Fp ≤ D := by rw [hFp]; exact Subgroup.map_subtype_le Esub
    have hFpinv_le : Fp.map (h.xi : MulAut P).toMonoidHom ≤ Fp := by
      intro x hx
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
      rw [hFp] at hy ⊢
      obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hy
      refine Subgroup.mem_map.mpr ⟨(Work.Higman.MSA.xiSubAut h hDinv u : ↥D), ?_, ?_⟩
      · rw [hEmem2]
        exact hEξ u ((hEmem2 u).mp hu)
      · exact (Work.Higman.MSA.xiSubAut_apply h hDinv u)
    have hFpinv : Fp.map (h.xi : MulAut P).toMonoidHom = Fp :=
      Subgroup.eq_of_le_of_card_ge hFpinv_le
        (le_of_eq (Subgroup.card_map_of_injective (h.xi : MulAut P).injective).symm)
    have hFpn : Fp.Normal := hnormal_of_contains Fp hAFp
    rcases hirrD Fp hFpn hFpinv hAFp hFpD with hFA | hFD
    · left
      rw [Submodule.eq_bot_iff]
      intro y hy
      obtain ⟨q, rfl⟩ : ∃ q, Additive.ofMul q = y := ⟨Additive.toMul y, rfl⟩
      have hqE : q ∈ E := (hEmem q).mpr hy
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (A.subgroupOf D) q
      have huFp : (u : P) ∈ Fp := by
        rw [hFp]; exact Subgroup.mem_map.mpr ⟨u, (hEmem2 u).mpr hqE, rfl⟩
      rw [hFA] at huFp
      have hq1 : QuotientGroup.mk' (A.subgroupOf D) u = 1 := by
        rw [QuotientGroup.mk'_apply]
        exact (QuotientGroup.eq_one_iff u).mpr (Subgroup.mem_subgroupOf.mpr huFp)
      rw [hq1, ofMul_one]
    · right
      rw [Submodule.eq_top_iff']
      intro y
      obtain ⟨q, rfl⟩ : ∃ q, Additive.ofMul q = y := ⟨Additive.toMul y, rfl⟩
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (A.subgroupOf D) q
      have huFp : (u : P) ∈ Fp := by rw [hFD]; exact u.2
      rw [hFp] at huFp
      obtain ⟨u', hu', hu'eq⟩ := Subgroup.mem_map.mp huFp
      have h1 : u' = u := D.subtype_injective hu'eq
      rw [← h1]
      exact (hEmem (QuotientGroup.mk' (A.subgroupOf D) u')).mp ((hEmem2 u').mp hu')
  -- ## The linear map `Ψ : V → End_{𝔽₂}(GF(2^n))`
  let EndF := GaloisField 2 n →ₗ[ZMod 2] GaloisField 2 n
  let Ψfun : (↥D ⧸ (A.subgroupOf D)) → EndF := fun v =>
    AddMonoidHom.toZModLinearMap 2
      { toFun := PsiFun v, map_zero' := hPsi0 v, map_add' := hPsiadd v }
  have hΨfun_apply : ∀ v x, Ψfun v x = PsiFun v x := fun v x => rfl
  have hΨfun_add : ∀ v w, Ψfun (v * w) = Ψfun v + Ψfun w := by
    intro v w
    ext x
    rw [hΨfun_apply, LinearMap.add_apply, hΨfun_apply, hΨfun_apply]
    exact hPsimul v w x
  have hΨfun_one : Ψfun 1 = 0 := by
    ext x
    rw [hΨfun_apply, LinearMap.zero_apply]
    exact hPsi_one x
  let Ψadd : V →+ EndF :=
    { toFun := fun v => Ψfun (Additive.toMul v)
      map_zero' := by
        show Ψfun (Additive.toMul (0 : V)) = 0
        rw [show Additive.toMul (0 : V) = 1 from rfl]
        exact hΨfun_one
      map_add' := by
        intro v w
        show Ψfun (Additive.toMul (v + w)) = Ψfun (Additive.toMul v) + Ψfun (Additive.toMul w)
        rw [toMul_add]
        exact hΨfun_add _ _ }
  let Ψ : V →ₗ[ZMod 2] EndF := AddMonoidHom.toZModLinearMap 2 Ψadd
  have hΨ_apply : ∀ (v : (↥D ⧸ (A.subgroupOf D))) x, Ψ (Additive.ofMul v) x = PsiFun v x := by
    intro v x
    show Ψadd (Additive.ofMul v) x = PsiFun v x
    rfl
  have hΨinj : Function.Injective Ψ := by
    intro v w hvw
    have h1 : ∀ x, PsiFun (Additive.toMul (v - w)) x = 0 := by
      intro x
      have h2 : Ψ (v - w) = 0 := by rw [map_sub, hvw, sub_self]
      have h3 : Ψ (v - w) x = 0 := by rw [h2]; rfl
      have h4 : Ψ (Additive.ofMul (Additive.toMul (v - w))) x = 0 := h3
      rwa [hΨ_apply] at h4
    have h5 : Additive.toMul (v - w) = 1 := hPsiinj _ h1
    have h6 : v - w = 0 := by
      have h7 := congrArg Additive.ofMul h5
      rw [ofMul_one] at h7
      simpa using h7
    exact sub_eq_zero.mp h6
  have hΨeq : ∀ v : V, Ψ (ξV v) = Work.Higman.H8.FSB.singAct νU (Ψ v) := by
    intro v
    obtain ⟨v', rfl⟩ : ∃ v' : (↥D ⧸ (A.subgroupOf D)), Additive.ofMul v' = v :=
      ⟨Additive.toMul v, rfl⟩
    ext x
    rw [Work.Higman.H8.FSB.singAct_apply, Work.Higman.H8.conjAction_apply,
      Units.val_inv_eq_inv_val]
    show Ψ (ξV (Additive.ofMul v')) x
      = (νU : GaloisField 2 n) * Ψ (Additive.ofMul v') ((νU : GaloisField 2 n)⁻¹ * x)
    rw [hξV_apply, hΨ_apply, hΨ_apply]
    exact hPsixi v' x
  -- ## Apply the strengthened abstract layer lemma
  obtain ⟨k, hk, φlin, hφfrob, hφker, hφxi, hφsurj⟩ :=
    Work.Commutator.layer_end_injection hn2 νU hνord hVcard ξV hsimple Ψ hΨinj hΨeq
  -- ## The coordinate function on `D/A`
  let φ : (↥D ⧸ (A.subgroupOf D)) → GaloisField 2 n := fun v => φlin (Additive.ofMul v)
  have hφ_apply : ∀ v, φ v = φlin (Additive.ofMul v) := fun v => rfl
  refine ⟨n, νU, ζ, k, φ, νq, β, hn2, hνord, hk, hζadd, hζmul, ?_, ?_, ?_, ?_, ?_⟩
  · -- the pairing is the commutator on representatives
    intro a d
    rw [hβdef a d, commutatorElement_def]
  · -- the kernel of `φ` is `A`
    intro v
    rw [hφ_apply v, hφker (Additive.ofMul v), ofMul_eq_zero]
    try exact Iff.rfl
  · -- the Frobenius-component form of the pairing
    intro q v
    have h2 := hφfrob (Additive.ofMul v) (ζ.symm (νq q))
    rw [hΨ_apply] at h2
    rw [show PsiFun v (ζ.symm (νq q)) = ζ.symm (β q v) from by
          show ζ.symm (β (νq.symm (ζ (ζ.symm (νq q)))) v) = ζ.symm (β q v)
          rw [Equiv.apply_symm_apply, MulEquiv.symm_apply_apply]] at h2
    rw [← hφ_apply v] at h2
    exact h2
  · -- the coordinate function `φ` is additive
    intro x y
    rw [hφ_apply x, hφ_apply y, hφ_apply (x * y), ofMul_mul]
    exact map_add φlin _ _
  · -- `νq` is the squaring isomorphism
    intro a
    rw [hνq_apply, hΦsq a]

end Work.Commutator
end

-- ===== from Submission.Work.Commutator.two_cover_relations =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

namespace Work.Commutator

open scoped commutatorElement

/-! ## Auxiliary group-theoretic lemmas

In the `C₄` configuration of Higman's classification of Suzuki 2-groups the two covers
`C, E` of the maximal `ξ`-invariant abelian normal subgroup `A` satisfy a small list of
"two-cover relations".  This file collects them.

We isolate three elementary lemmas.
-/

/-- **Commutator diagonal identity.**  If `x ^ 2` and `y ^ 2` are central then the commutator
`c = x * y * x⁻¹ * y⁻¹` is inverted by conjugation by `x` and by `y`; equivalently
`⁅c, x⁆ = c ^ 2 = ⁅c, y⁆`. -/
private theorem commutator_diag_relations {G : Type} [Group G] (x y : G)
    (hx2 : x ^ 2 ∈ Subgroup.center G) (hy2 : y ^ 2 ∈ Subgroup.center G) :
    ((x * y * x⁻¹ * y⁻¹) * x * (x * y * x⁻¹ * y⁻¹)⁻¹ * x⁻¹ = (x * y * x⁻¹ * y⁻¹) ^ 2) ∧
    ((x * y * x⁻¹ * y⁻¹) * y * (x * y * x⁻¹ * y⁻¹)⁻¹ * y⁻¹ = (x * y * x⁻¹ * y⁻¹) ^ 2) := by
  have hx2' : x * x ∈ Subgroup.center G := by simpa only [pow_two] using hx2
  have hy2' : y * y ∈ Subgroup.center G := by simpa only [pow_two] using hy2
  have inv_conj : ∀ z w : G, w * z * w⁻¹ = z⁻¹ → w * z⁻¹ * w⁻¹ = z := by
    intro z w h
    have h' := congrArg Inv.inv h
    simp only [mul_inv_rev, inv_inv] at h'
    simpa only [mul_assoc] using h'
  have hxc : x * (x * y * x⁻¹ * y⁻¹) * x⁻¹ = (x * y * x⁻¹ * y⁻¹)⁻¹ := by
    have hc : (x * x) * y = y * (x * x) := (Subgroup.mem_center_iff.mp hx2' y).symm
    rw [show (x * y * x⁻¹ * y⁻¹)⁻¹ = y * x * y⁻¹ * x⁻¹ by group]
    calc x * (x * y * x⁻¹ * y⁻¹) * x⁻¹
        = (x * x) * y * (x⁻¹ * y⁻¹ * x⁻¹) := by group
      _ = y * (x * x) * (x⁻¹ * y⁻¹ * x⁻¹) := by rw [hc]
      _ = y * x * y⁻¹ * x⁻¹ := by group
  have hyc : y * (x * y * x⁻¹ * y⁻¹) * y⁻¹ = (x * y * x⁻¹ * y⁻¹)⁻¹ := by
    have hc : x⁻¹ * (y * y)⁻¹ = (y * y)⁻¹ * x⁻¹ :=
      Subgroup.mem_center_iff.mp (Subgroup.inv_mem _ hy2') x⁻¹
    rw [show (x * y * x⁻¹ * y⁻¹)⁻¹ = y * x * y⁻¹ * x⁻¹ by group]
    calc y * (x * y * x⁻¹ * y⁻¹) * y⁻¹
        = y * x * y * (x⁻¹ * (y * y)⁻¹) := by group
      _ = y * x * y * ((y * y)⁻¹ * x⁻¹) := by rw [hc]
      _ = y * x * y⁻¹ * x⁻¹ := by group
  have hxc' : x * (x * y * x⁻¹ * y⁻¹)⁻¹ * x⁻¹ = x * y * x⁻¹ * y⁻¹ :=
    inv_conj _ _ hxc
  have hyc' : y * (x * y * x⁻¹ * y⁻¹)⁻¹ * y⁻¹ = x * y * x⁻¹ * y⁻¹ :=
    inv_conj _ _ hyc
  constructor
  · calc (x * y * x⁻¹ * y⁻¹) * x * (x * y * x⁻¹ * y⁻¹)⁻¹ * x⁻¹
        = (x * y * x⁻¹ * y⁻¹) * (x * (x * y * x⁻¹ * y⁻¹)⁻¹ * x⁻¹) := by group
      _ = (x * y * x⁻¹ * y⁻¹) * (x * y * x⁻¹ * y⁻¹) := by rw [hxc']
      _ = (x * y * x⁻¹ * y⁻¹) ^ 2 := (pow_two _).symm
  · calc (x * y * x⁻¹ * y⁻¹) * y * (x * y * x⁻¹ * y⁻¹)⁻¹ * y⁻¹
        = (x * y * x⁻¹ * y⁻¹) * (y * (x * y * x⁻¹ * y⁻¹)⁻¹ * y⁻¹) := by group
      _ = (x * y * x⁻¹ * y⁻¹) * (x * y * x⁻¹ * y⁻¹) := by rw [hyc']
      _ = (x * y * x⁻¹ * y⁻¹) ^ 2 := (pow_two _).symm

/-- The set of `y` with `⁅c, y⁆ ∈ N` is a subgroup; hence if it contains the generating
subgroups `C` and `E` of `C ⊔ E = ⊤` it is everything. -/
private theorem comm_le_powSub_two_of_sup {P : Type} [Group P] {A C E : Subgroup P}
    [hCn : C.Normal] (hCEsup : C ⊔ E = ⊤) {c : P}
    (hB : (Work.Higman.powSub A 2).Normal)
    (hC : ∀ y ∈ C, c * y * c⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2)
    (hE : ∀ y ∈ E, c * y * c⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2) :
    ∀ y : P, c * y * c⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2 := by
  let N : Subgroup P := Work.Higman.powSub A 2
  have hN : N.Normal := hB
  let K : Subgroup P :=
    { carrier := {y : P | c * y * c⁻¹ * y⁻¹ ∈ N}
      mul_mem' := by
        intro y₁ y₂ h1 h2
        change c * (y₁ * y₂) * c⁻¹ * (y₁ * y₂)⁻¹ ∈ N
        have h2' : c * y₂ * c⁻¹ * y₂⁻¹ ∈ N := h2
        rw [show c * (y₁ * y₂) * c⁻¹ * (y₁ * y₂)⁻¹
              = (c * y₁ * c⁻¹ * y₁⁻¹) * (y₁ * (c * y₂ * c⁻¹ * y₂⁻¹) * y₁⁻¹) by group]
        exact N.mul_mem h1 (hN.conj_mem _ h2' y₁)
      one_mem' := by simp
      inv_mem' := by
        intro y h1
        change c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹ ∈ N
        have h0 : c * (y * y⁻¹) * c⁻¹ * (y * y⁻¹)⁻¹ ∈ N := by simp
        rw [show c * (y * y⁻¹) * c⁻¹ * (y * y⁻¹)⁻¹
              = (c * y * c⁻¹ * y⁻¹) * (y * (c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹) * y⁻¹) by group] at h0
        have h2 : y * (c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹) * y⁻¹ ∈ N := by
          have h1' : (c * y * c⁻¹ * y⁻¹)⁻¹ ∈ N := N.inv_mem h1
          have h3 := N.mul_mem h1' h0
          rwa [show (c * y * c⁻¹ * y⁻¹)⁻¹
                * ((c * y * c⁻¹ * y⁻¹) * (y * (c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹) * y⁻¹))
                = y * (c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹) * y⁻¹ by group] at h3
        have h4 : y⁻¹ * (y * (c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹) * y⁻¹) * (y⁻¹)⁻¹ ∈ N :=
          hN.conj_mem _ h2 y⁻¹
        rwa [show y⁻¹ * (y * (c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹) * y⁻¹) * (y⁻¹)⁻¹
              = c * y⁻¹ * c⁻¹ * (y⁻¹)⁻¹ by group] at h4 }
  have hCK : C ≤ K := fun y hy => hC y hy
  have hEK : E ≤ K := fun y hy => hE y hy
  have htop : (⊤ : Subgroup P) ≤ K := by
    rw [← hCEsup]; exact sup_le hCK hEK
  exact fun y => htop (Subgroup.mem_top y)

/-- **One half of the two-cover relation.**  In the `C₄` configuration, if `S` is a
`ξ`-invariant normal minimal cover of `A` and `T` is the complementary cover with
`S ⊔ T = ⊤`, then every `s ∈ S \ A` has a commutator with some `t ∈ T` that misses `A ^ (2)`.

The hypothesis list is exactly the part of the two-cover configuration used by the argument:
`⁅S,S⁆ = A²`, `⁅S,A⁆ = A²`, `C_S(A) = A` (through the cover property), `S ⊔ T = ⊤`,
`⁅T,T⁆ = A²`. -/
private theorem one_sided_not_mem {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A S T : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hSn : S.Normal) (hSinv : S.map (h.xi : MulAut P).toMonoidHom = S)
    (hAS : A ≤ S)
    (hScover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ S → D = A ∨ D = S)
    (hSd : ⁅S, S⁆ = Work.Higman.powSub A 2)
    (hSAd : ⁅S, A⁆ = Work.Higman.powSub A 2)
    (hSTsup : S ⊔ T = ⊤)
    (hTd : ⁅T, T⁆ = Work.Higman.powSub A 2) :
    ∀ s ∈ S, s ∉ A → ∃ t ∈ T, s * t * s⁻¹ * t⁻¹ ∉ Work.Higman.powSub A 2 := by
  haveI : A.Normal := hA.normal
  haveI : S.Normal := hSn
  have hB : (Work.Higman.powSub A 2).Normal := Work.Higman.powSub_normal hA.normal 2
  intro s hs hsA
  by_contra hcon
  push_neg at hcon
  -- `s` centralises `P` modulo `A ^ (2)`
  have hsErad : s ∈ Work.Higman.HS.Erad h A := by
    rw [Work.Higman.HS.mem_Erad_iff]
    intro y
    have hS' : ∀ y ∈ S, s * y * s⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2 := by
      intro y hy
      have h1 := Subgroup.commutator_mem_commutator hs hy
      rw [hSd] at h1
      simpa [commutatorElement_def] using h1
    exact comm_le_powSub_two_of_sup (A := A) (C := S) (E := T) hSTsup hB hS' hcon y
  -- the subgroup `S ⊓ Erad` is a normal `ξ`-invariant cover of `A` inside `S`
  set D : Subgroup P := S ⊓ Work.Higman.HS.Erad h A with hDdef
  have hAErad : A ≤ Work.Higman.HS.Erad h A :=
    Work.Higman.HS.A_le_Erad (h := h) (A := A) (C := S) hA.abelian hA.map_eq hNA htop hA4 hSAd
  have hAD : A ≤ D := fun x hx => ⟨hAS hx, hAErad hx⟩
  have hDleS : D ≤ S := inf_le_left
  have hsD : s ∈ D := ⟨hs, hsErad⟩
  have hDnorm : D.Normal := by
    refine Subgroup.Normal.mk fun n hn g => ?_
    have h1 : ⁅g, n⁆ ∈ A := by
      rw [← hGs]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top n)
    rw [show g * n * g⁻¹ = ⁅g, n⁆ * n from by rw [commutatorElement_def]; group]
    exact D.mul_mem (hAD h1) hn
  have hDinv : D.map (h.xi : MulAut P).toMonoidHom = D := by
    rw [hDdef, Subgroup.map_inf _ _ _ (h.xi : MulAut P).injective, hSinv,
      Work.Higman.HS.map_xi_Erad (h := h) (A := A) hA.map_eq]
  rcases hScover D hDnorm hDinv hAD hDleS with hDA | hDS
  · exact hsA (hDA ▸ hsD)
  · -- then `S` centralises `P` modulo `A²`, so `⁅⊤,⊤⁆ ≤ A²`
    have hSErad : S ≤ Work.Higman.HS.Erad h A := hDS ▸ inf_le_right
    have hTErad : T ≤ Work.Higman.HS.Erad h A := by
      intro t ht
      rw [Work.Higman.HS.mem_Erad_iff]
      intro y
      have hT' : ∀ y ∈ T, t * y * t⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2 := by
        intro y hy
        have h1 := Subgroup.commutator_mem_commutator ht hy
        rw [hTd] at h1
        simpa [commutatorElement_def] using h1
      have hS'' : ∀ y ∈ S, t * y * t⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2 := by
        intro y hy
        have hyE := hSErad hy
        rw [Work.Higman.HS.mem_Erad_iff] at hyE
        have h1 := (Work.Higman.powSub A 2).inv_mem (hyE t)
        rwa [show (y * t * y⁻¹ * t⁻¹)⁻¹ = t * y * t⁻¹ * y⁻¹ by group] at h1
      exact comm_le_powSub_two_of_sup (A := A) (C := S) (E := T) hSTsup hB hS'' hT' y
    have hle : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.powSub A 2 :=
      Work.Higman.HS.commutator_le_powSub_two_of_sup (h := h) (A := A) (C := S) (E := T)
        hSTsup (le_of_eq hSd) hTErad
    have hAle2 : A ≤ Work.Higman.powSub A 2 := hGs ▸ hle
    exact (Work.Higman.RedAux.ne_powSub_two_of_card h htop hcard)
      (le_antisymm hAle2 (Work.Higman.powSub_le (by norm_num)))

/-- **Two-cover relations.**  In the `C₄` configuration of Higman's classification of
Suzuki 2-groups, the two complementary `ξ`-invariant normal covers `C, E` of the maximal
`ξ`-invariant abelian normal subgroup `A` satisfy:

* `⁅A,⊤⁆ = A ^ (2)`;
* each `c ∈ C \ A` has a commutator with some `e ∈ E` outside `A ^ (2)` (and symmetrically);
* for `c ∈ C`, `e ∈ E`, the commutator `c * e * c⁻¹ * e⁻¹` is inverted by conjugation by
  `c` and by `e`, i.e. `⁅⁅c,e⁆, c⁆ = ⁅c,e⁆ ^ 2 = ⁅⁅c,e⁆, e⁆`. -/
private theorem two_cover_relations {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C E : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hEn : E.Normal)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hEinv : E.map (h.xi : MulAut P).toMonoidHom = E)
    (hAC : A ≤ C) (hAE : A ≤ E)
    (hCcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hEcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ E → D = A ∨ D = E)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) (hEd : ⁅E, E⁆ = Work.Higman.powSub A 2)
    (hCpow2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hEpow2 : Work.Higman.powSub E 2 = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) (hEAd : ⁅E, A⁆ = Work.Higman.powSub A 2)
    (hCE : C ⊓ E = A) (hCEsup : C ⊔ E = ⊤) :
    (⁅(A : Subgroup P), (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2) ∧
    (∀ c ∈ C, c ∉ A → ∃ e ∈ E, c * e * c⁻¹ * e⁻¹ ∉ Work.Higman.powSub A 2) ∧
    (∀ e ∈ E, e ∉ A → ∃ c ∈ C, c * e * c⁻¹ * e⁻¹ ∉ Work.Higman.powSub A 2) ∧
    (∀ c ∈ C, ∀ e ∈ E,
      ((c * e * c⁻¹ * e⁻¹) * c * (c * e * c⁻¹ * e⁻¹)⁻¹ * c⁻¹) = (c * e * c⁻¹ * e⁻¹) ^ 2) ∧
    (∀ c ∈ C, ∀ e ∈ E,
      ((c * e * c⁻¹ * e⁻¹) * e * (c * e * c⁻¹ * e⁻¹)⁻¹ * e⁻¹) = (c * e * c⁻¹ * e⁻¹) ^ 2) := by
  haveI : A.Normal := hA.normal
  have hcent : Work.Higman.powSub A 2 ≤ Subgroup.center P := by
    rw [htop]; exact h.omega1_le_center
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact Work.Higman.HS.comm_A_top_eq_aux (h := h) (A := A) (C := C)
      hA.abelian hA.map_eq hNA htop hA4 hCAd
  · exact one_sided_not_mem (h := h) (A := A) (S := C) (T := E)
      hA hNA hGs htop hA4 hcard hCn hCinv hAC hCcover hCd hCAd hCEsup hEd
  · intro e he heA
    have hsup' : E ⊔ C = ⊤ := by rw [sup_comm]; exact hCEsup
    obtain ⟨c, hc, hce⟩ := one_sided_not_mem (h := h) (A := A) (S := E) (T := C)
      hA hNA hGs htop hA4 hcard hEn hEinv hAE hEcover hEd hEAd hsup' hCd e he heA
    refine ⟨c, hc, fun hcontra => hce ?_⟩
    rw [show e * c * e⁻¹ * c⁻¹ = (c * e * c⁻¹ * e⁻¹)⁻¹ by group]
    exact (Work.Higman.powSub A 2).inv_mem hcontra
  · intro c hc e he
    have hc2 : c ^ 2 ∈ Subgroup.center P := hcent (hCpow2 ▸ Work.Higman.pow_mem_powSub (A := C) hc)
    have he2 : e ^ 2 ∈ Subgroup.center P := hcent (hEpow2 ▸ Work.Higman.pow_mem_powSub (A := E) he)
    exact (commutator_diag_relations c e hc2 he2).1
  · intro c hc e he
    have hc2 : c ^ 2 ∈ Subgroup.center P := hcent (hCpow2 ▸ Work.Higman.pow_mem_powSub (A := C) hc)
    have he2 : e ^ 2 ∈ Subgroup.center P := hcent (hEpow2 ▸ Work.Higman.pow_mem_powSub (A := E) he)
    exact (commutator_diag_relations c e hc2 he2).2

end Work.Commutator
end

-- ===== from Submission.Work.Commutator.two_cover_false =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1600000

open scoped commutatorElement

namespace Work.Commutator

private theorem two_cover_false {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A C E : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hCn : C.Normal) (hEn : E.Normal)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hEinv : E.map (h.xi : MulAut P).toMonoidHom = E)
    (hAC : A ≤ C) (hAE : A ≤ E) (hCA : A ≠ C) (hEA : A ≠ E)
    (hCcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hEcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ E → D = A ∨ D = E)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) (hEd : ⁅E, E⁆ = Work.Higman.powSub A 2)
    (hCpow2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hEpow2 : Work.Higman.powSub E 2 = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) (hEAd : ⁅E, A⁆ = Work.Higman.powSub A 2)
    (hCE : C ⊓ E = A) (hCEsup : C ⊔ E = ⊤) :
    False := by
  classical
  haveI hAn : A.Normal := hA.normal
  haveI hN1 : ((Work.Higman.powSub A 2).subgroupOf A).Normal :=
    (Work.Higman.powSub_normal hAn 2).subgroupOf A
  haveI hN2C : (A.subgroupOf C).Normal := hAn.subgroupOf C
  haveI hN2E : (A.subgroupOf E).Normal := hAn.subgroupOf E
  -- ## The two-cover relations
  obtain ⟨_hcommA, _honeC, _honeE, hrelC, _hrelE⟩ :=
    two_cover_relations (h := h) (A := A) (C := C) (E := E) hA hNA hGs hsq hA4 htop hcard
      hCn hEn hCinv hEinv hAC hAE hCcover hEcover hCd hEd hCpow2 hEpow2 hCAd hEAd hCE hCEsup
  -- ## Cardinalities of the two covers
  have hACA : C ≠ A := fun hh => hCA hh.symm
  have hEAE : E ≠ A := fun hh => hEA hh.symm
  have hPhiC : Work.Higman.powSub C 2 ⊔ ⁅C, C⁆ = Work.Higman.powSub A 2 := by
    rw [hCpow2, hCd, sup_idem]
  have hPhiE : Work.Higman.powSub E 2 ⊔ ⁅E, E⁆ = Work.Higman.powSub A 2 := by
    rw [hEpow2, hEd, sup_idem]
  have hAD2C : ⁅A, C⁆ = Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_comm, hCAd]
  have hAD2E : ⁅A, E⁆ = Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_comm, hEAd]
  have hquotC : Nat.card (↥C ⧸ (A.subgroupOf C)) = Nat.card ↥(Work.Higman.omega1 P) :=
    Work.Higman.H8.c4_sq_a2_card_quot h hA hGs hNA htop hcent hCn hCinv hAC hACA hCd hPhiC
      hCcover hAD2C
  have hquotE : Nat.card (↥E ⧸ (A.subgroupOf E)) = Nat.card ↥(Work.Higman.omega1 P) :=
    Work.Higman.H8.c4_sq_a2_card_quot h hA hGs hNA htop hcent hEn hEinv hAE hEAE hEd hPhiE
      hEcover hAD2E
  have hcardC : Nat.card ↥C = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
    have h1 : Nat.card ↥C = Nat.card (↥C ⧸ (A.subgroupOf C)) * Nat.card ↥(A.subgroupOf C) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf C)
    have h2 : Nat.card ↥(A.subgroupOf C) = Nat.card ↥A :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAC).toEquiv
    rw [h1, hquotC, h2, hcard]; ring
  have hcardE : Nat.card ↥E = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
    have h1 : Nat.card ↥E = Nat.card (↥E ⧸ (A.subgroupOf E)) * Nat.card ↥(A.subgroupOf E) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf E)
    have h2 : Nat.card ↥(A.subgroupOf E) = Nat.card ↥A :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAE).toEquiv
    rw [h1, hquotE, h2, hcard]; ring
  -- ## Frobenius/field data for the cover `C`
  obtain ⟨n, ν, ζ, k, φC, νq, βC, hn2, _hνord, _hk, hζadd, _hζmul, hβdef, hφker, hform,
    hφadd, hνqsq⟩ :=
    two_cover_psi_form_sq (h := h) (A := A) (D := C) hA hNA hGs hsq htop hcard hcent hCn
      hCinv hAC hCA hCcover hCd hcardC
  have hq_n : Nat.card ↥(Work.Higman.omega1 P) = 2 ^ n := by
    rw [← Nat.card_congr ζ]
    exact Work.Higman.H8.card_galois (by omega)
  -- ## Frobenius/field data for the cover `E`
  obtain ⟨nE, _νE, ζE, _kE, φE, _νqE, _βE, _hnE2, _hνEord, _hkE, _hζEadd, _hζEmul, _hβEdef,
    hφEker, _hφEform, hφEadd, _hνqEsq⟩ :=
    two_cover_psi_form_sq (h := h) (A := A) (D := E) hA hNA hGs hsq htop hcard hcent hEn
      hEinv hAE hEA hEcover hEd hcardE
  have hq_nE : Nat.card ↥(Work.Higman.omega1 P) = 2 ^ nE := by
    rw [← Nat.card_congr ζE]
    exact Work.Higman.H8.card_galois (by omega)
  have hnE_eq : nE = n := by
    refine Nat.pow_right_injective (a := 2) (by norm_num) ?_
    change (2 : ℕ) ^ nE = (2 : ℕ) ^ n
    rw [← hq_nE, hq_n]
  subst nE
  -- ## The commutator pairing `C/A × E/A → A/A²`
  obtain ⟨B, hBdef, hBadd1, hBadd2, hBnd1, hBnd2⟩ :=
    two_cover_ce_pairing (h := h) (A := A) (C := C) (E := E) hA hNA hGs hsq hA4 htop hcard
      hcent hCn hEn hCinv hEinv hAC hAE hCcover hEcover hCd hEd hCAd hEAd hCE hCEsup
  -- ## Elementary facts about `ζ`
  have hζ0 : ζ (0 : GaloisField 2 n) = 1 := by
    have h1 := hζadd 0 0
    rw [add_zero] at h1
    have h2 := congrArg (fun t => (ζ 0)⁻¹ * t) h1
    simp only [← mul_assoc, inv_mul_cancel, one_mul] at h2
    exact h2.symm
  have hζsymm_mul : ∀ a b : ↥(Work.Higman.omega1 P),
      ζ.symm (a * b) = ζ.symm a + ζ.symm b := by
    intro a b
    apply ζ.injective
    rw [Equiv.apply_symm_apply, hζadd, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hζsymm_one : ζ.symm (1 : ↥(Work.Higman.omega1 P)) = 0 := by
    rw [← hζ0, Equiv.symm_apply_apply]
  -- ## The `W`-coordinate `ψ = ζ⁻¹ ∘ νq`, with `νq` the squaring map
  let ψ : (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) → GaloisField 2 n :=
    fun q => ζ.symm (νq q)
  have hψadd : ∀ q q', ψ (q * q') = ψ q + ψ q' := by
    intro q q'
    show ζ.symm (νq (q * q')) = ζ.symm (νq q) + ζ.symm (νq q')
    rw [map_mul, hζsymm_mul]
  have hψone : ψ 1 = 0 := by
    show ζ.symm (νq 1) = 0
    rw [map_one, hζsymm_one]
  have hψmem : ∀ q, ψ q = 0 ↔ q = 1 := by
    intro q
    constructor
    · intro hq
      apply νq.injective
      rw [map_one]
      have h1 := congrArg ζ hq
      rwa [Equiv.apply_symm_apply, hζ0] at h1
    · intro hq
      rw [hq, hψone]
  -- ## `φC` and `φE` are bijections
  have hφC_one : φC (1 : (↥C ⧸ (A.subgroupOf C))) = 0 := (hφker 1).mpr rfl
  have hφC_inv : ∀ x : (↥C ⧸ (A.subgroupOf C)), φC x⁻¹ = -φC x := by
    intro x
    have h1 := hφadd x x⁻¹
    rw [mul_inv_cancel, hφC_one] at h1
    rw [eq_neg_iff_add_eq_zero, add_comm]
    exact h1.symm
  have hφC_inj : Function.Injective φC := by
    intro x y hxy
    have h1 : φC (x * y⁻¹) = 0 := by
      rw [hφadd x y⁻¹, hφC_inv y, hxy, add_neg_cancel]
    exact mul_inv_eq_one.mp ((hφker (x * y⁻¹)).mp h1)
  have hφE_one : φE (1 : (↥E ⧸ (A.subgroupOf E))) = 0 := (hφEker 1).mpr rfl
  have hφE_inv : ∀ x : (↥E ⧸ (A.subgroupOf E)), φE x⁻¹ = -φE x := by
    intro x
    have h1 := hφEadd x x⁻¹
    rw [mul_inv_cancel, hφE_one] at h1
    rw [eq_neg_iff_add_eq_zero, add_comm]
    exact h1.symm
  have hφE_inj : Function.Injective φE := by
    intro x y hxy
    have h1 : φE (x * y⁻¹) = 0 := by
      rw [hφEadd x y⁻¹, hφE_inv y, hxy, add_neg_cancel]
    exact mul_inv_eq_one.mp ((hφEker (x * y⁻¹)).mp h1)
  haveI hFgF : Fintype (GaloisField 2 n) := Fintype.ofFinite _
  haveI hFgC : Fintype (↥C ⧸ (A.subgroupOf C)) := Fintype.ofFinite _
  haveI hFgE : Fintype (↥E ⧸ (A.subgroupOf E)) := Fintype.ofFinite _
  have hcardGF : Fintype.card (GaloisField 2 n) = 2 ^ n := by
    rw [← Nat.card_eq_fintype_card, Work.Higman.H8.card_galois (by omega)]
  have hφC_surj : Function.Surjective φC := by
    have hc : Fintype.card (↥C ⧸ (A.subgroupOf C)) = Fintype.card (GaloisField 2 n) := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hquotC, hq_n,
        ← Work.Higman.H8.card_galois (by omega)]
    exact hφC_inj.surjective_of_finite (Fintype.equivOfCardEq hc)
  have hφE_surj : Function.Surjective φE := by
    have hc : Fintype.card (↥E ⧸ (A.subgroupOf E)) = Fintype.card (GaloisField 2 n) := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hquotE, hq_n,
        ← Work.Higman.H8.card_galois (by omega)]
    exact hφE_inj.surjective_of_finite (Fintype.equivOfCardEq hc)
  let eC : (↥C ⧸ (A.subgroupOf C)) ≃ GaloisField 2 n := Equiv.ofBijective φC ⟨hφC_inj, hφC_surj⟩
  have heC : ∀ x, (eC x : GaloisField 2 n) = φC x := fun x => rfl
  let eE : (↥E ⧸ (A.subgroupOf E)) ≃ GaloisField 2 n := Equiv.ofBijective φE ⟨hφE_inj, hφE_surj⟩
  have heE : ∀ x, (eE x : GaloisField 2 n) = φE x := fun x => rfl
  have heC_symm_add : ∀ u u' : GaloisField 2 n, eC.symm (u + u') = eC.symm u * eC.symm u' := by
    intro u u'
    apply eC.injective
    rw [Equiv.apply_symm_apply, heC, hφadd]
    rw [show φC (eC.symm u) = u from by rw [← heC, Equiv.apply_symm_apply],
      show φC (eC.symm u') = u' from by rw [← heC, Equiv.apply_symm_apply]]
  have heE_symm_add : ∀ u u' : GaloisField 2 n, eE.symm (u + u') = eE.symm u * eE.symm u' := by
    intro u u'
    apply eE.injective
    rw [Equiv.apply_symm_apply, heE, hφEadd]
    rw [show φE (eE.symm u) = u from by rw [← heE, Equiv.apply_symm_apply],
      show φE (eE.symm u') = u' from by rw [← heE, Equiv.apply_symm_apply]]
  -- ## The coordinate pairing `b u v = ψ (B (eC.symm u) (eE.symm v))`
  let b : GaloisField 2 n → GaloisField 2 n → GaloisField 2 n :=
    fun u v => ψ (B (eC.symm u) (eE.symm v))
  have hb1 : ∀ u u' v : GaloisField 2 n, b (u + u') v = b u v + b u' v := by
    intro u u' v
    show ψ (B (eC.symm (u + u')) (eE.symm v))
      = ψ (B (eC.symm u) (eE.symm v)) + ψ (B (eC.symm u') (eE.symm v))
    rw [heC_symm_add u u', hBadd1, hψadd]
  have hb2 : ∀ u v v' : GaloisField 2 n, b u (v + v') = b u v + b u v' := by
    intro u v v'
    show ψ (B (eC.symm u) (eE.symm (v + v')))
      = ψ (B (eC.symm u) (eE.symm v)) + ψ (B (eC.symm u) (eE.symm v'))
    rw [heE_symm_add v v', hBadd2, hψadd]
  have heC_one : eC 1 = 0 := by rw [heC]; exact hφC_one
  have heE_one : eE 1 = 0 := by rw [heE]; exact hφE_one
  have hdu : ∀ u : GaloisField 2 n, u ≠ 0 → ∃ v : GaloisField 2 n, b u v ≠ 0 := by
    intro u hu
    have hx1 : eC.symm u ≠ 1 := by
      intro h1
      have h2 : u = eC 1 := by rw [← h1, Equiv.apply_symm_apply]
      exact hu (by rw [h2, heC_one])
    obtain ⟨y, hy⟩ := hBnd1 (eC.symm u) hx1
    refine ⟨eE y, ?_⟩
    show ψ (B (eC.symm u) (eE.symm (eE y))) ≠ 0
    rw [Equiv.symm_apply_apply]
    intro h0
    exact hy ((hψmem _).mp h0)
  have hdv : ∀ v : GaloisField 2 n, v ≠ 0 → ∃ u : GaloisField 2 n, b u v ≠ 0 := by
    intro v hv
    have hy1 : eE.symm v ≠ 1 := by
      intro h1
      have h2 : v = eE 1 := by rw [← h1, Equiv.apply_symm_apply]
      exact hv (by rw [h2, heE_one])
    obtain ⟨x, hx⟩ := hBnd2 (eE.symm v) hy1
    refine ⟨eC x, ?_⟩
    show ψ (B (eC.symm (eC x)) (eE.symm v)) ≠ 0
    rw [Equiv.symm_apply_apply]
    intro h0
    exact hx ((hψmem _).mp h0)
  -- ## The Frobenius-component relation `u * (b u v)^(2^k) = b u v`
  have hU : ∀ u v : GaloisField 2 n, id u * (b u v) ^ (2 ^ k) = 1 * b u v := by
    intro u v
    obtain ⟨c, hc⟩ := QuotientGroup.mk_surjective (eC.symm u)
    obtain ⟨e, he⟩ := QuotientGroup.mk_surjective (eE.symm v)
    have hmem : (c : P) * (e : P) * (c : P)⁻¹ * (e : P)⁻¹ ∈ A := by
      have h1 : ⁅(c : P), (e : P)⁆ ∈ ⁅(⊤ : Subgroup P), ⊤⁆ :=
        Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
      rwa [hGs] at h1
    let z : ↥A := ⟨(c : P) * (e : P) * (c : P)⁻¹ * (e : P)⁻¹, hmem⟩
    have hzP : (z : P) = (c : P) * (e : P) * (c : P)⁻¹ * (e : P)⁻¹ := rfl
    have hdiag : (z : P) * (c : P) * (z : P)⁻¹ * (c : P)⁻¹ = (z : P) ^ 2 := by
      rw [hzP]
      exact hrelC (c : P) c.2 (e : P) e.2
    have hβeq : βC (QuotientGroup.mk z) (QuotientGroup.mk c) = νq (QuotientGroup.mk z) := by
      apply Subtype.ext
      rw [hβdef z c, hνqsq z]
      exact hdiag
    have hBval : B (eC.symm u) (eE.symm v) = QuotientGroup.mk z := by
      rw [← hc, ← he]
      exact hBdef c e z hzP
    have hφC_mk : φC (QuotientGroup.mk c) = u := by
      rw [hc, ← heC, Equiv.apply_symm_apply]
    have hbuv : b u v = ζ.symm (νq (QuotientGroup.mk z)) := by
      show ψ (B (eC.symm u) (eE.symm v)) = ζ.symm (νq (QuotientGroup.mk z))
      rw [hBval]
    have hrel := hform (QuotientGroup.mk z) (QuotientGroup.mk c)
    rw [hβeq] at hrel
    rw [hφC_mk, ← hbuv] at hrel
    change u * (b u v) ^ (2 ^ k) = 1 * b u v
    rw [one_mul, ← hrel]
  -- ## Contradiction
  exact counting_hU_false hn2 hcardGF (1 : GaloisField 2 n) one_ne_zero b hb1 hb2 id
    (fun _ _ => rfl) hdu hdv hU

end Work.Commutator
end

-- ===== from Submission.Work.Higman.H8.c4_hard_core =====
section

namespace Work.Higman.H8

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-- **The `C₄` shape with `[P,D] ⊆ A²` is impossible.**

If `[D,D] = A²`, `A⁴ = 1`, `D ≤ P` and `[P,D] ⊆ A² = Ω₁(P)` (so that every commutator
`⁅u,d⁆` is an involution), then for every `u : P` and `d ∈ D` the identity
`⁅u ^ 2, d⁆ = ⁅u, ⁅u,d⁆⁆ ⁅u,d⁆ ^ 2` collapses to `⁅u ^ 2, d⁆ = 1`: both factors on the right are
`1` because `⁅u,d⁆ ∈ A² = Ω₁(P)` is central and an involution.  Hence `P ^ (2) ⊆ C_P(D)`, and
since `A = P ^ (2)` (as `[P,P] = A ⊆ P ^ (2) ⊆ A`) this gives `A ⊆ C_P(D)`, i.e.
`⁅A,D⁆ = ⊥`, against `⁅A,D⁆ = ⁅D,A⁆ = A² ≠ ⊥`. -/
private theorem false_of_comm_le_powSub_two (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : IsXiAbelNormal h A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥) (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2) (hAD : A ≤ D)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e))
    (hcase : ⁅(⊤ : Subgroup P), D⁆ ≤ Work.Higman.powSub A 2) :
    False := by
  classical
  -- `A² = Ω₁(P)` is central and elementary abelian
  have hA2Z : Work.Higman.powSub A 2 ≤ Subgroup.center P := by
    rw [htop]; exact h.omega1_le_center
  have hA2inv : ∀ x ∈ Work.Higman.powSub A 2, x ^ 2 = 1 := by
    intro x hx
    exact h.mem_omega1.mp (htop ▸ hx)
  -- `[D,A] = A²`, hence `[A,D] = A²`
  have hDAeq : ⁅D, A⁆ = Work.Higman.powSub A 2 := by
    have hle : ⁅D, A⁆ ≤ Work.Higman.powSub A 2 :=
      (Subgroup.commutator_mono le_rfl hAD).trans (hDd ▸ le_rfl)
    have hinv : (⁅D, A⁆).map (h.xi : MulAut P).toMonoidHom = ⁅D, A⁆ := by
      rw [Subgroup.map_commutator, hDinv, IsXiAbelNormal.map_eq hA]
    have hne : ⁅D, A⁆ ≠ ⊥ := by
      intro hbot
      apply hnZ
      intro e he a ha
      have h1 : ⁅e, a⁆ ∈ (⊥ : Subgroup P) := by
        rw [← hbot]
        exact Subgroup.commutator_mem_commutator he ha
      exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1)
    rcases Work.Higman.H8.Clean.nsd_omega1_eq_bot_or_top_of_invariant h
      (htop ▸ hle) hinv with hb | hT
    · exact absurd hb hne
    · rw [hT]; exact htop.symm
  have hADeq : ⁅A, D⁆ = Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_comm]; exact hDAeq
  -- every square commutes with `D`
  have hsq_comm : ∀ u : P, ∀ v : P, v ∈ D → u ^ 2 * v = v * u ^ 2 := by
    intro u v hv
    have h1 : ⁅u, v⁆ ∈ Work.Higman.powSub A 2 :=
      hcase (Subgroup.commutator_mem_commutator (Subgroup.mem_top u) hv)
    have hmem : ⁅u, v⁆ ∈ Subgroup.center P := hA2Z h1
    have h2 : ⁅u, ⁅u, v⁆⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp hmem u)
    have h3 : ⁅u, v⁆ ^ 2 = 1 := hA2inv _ h1
    have h4 : ⁅u ^ 2, v⁆ = 1 := by
      rw [Work.Higman.commutatorElement_sq_self u v, h2, h3, one_mul]
    have h5 : u ^ 2 * v * (u ^ 2)⁻¹ * v⁻¹ = 1 := by
      simpa [commutatorElement_def] using h4
    have h6 : u ^ 2 * v * (u ^ 2)⁻¹ = v := by
      calc u ^ 2 * v * (u ^ 2)⁻¹ = (u ^ 2 * v * (u ^ 2)⁻¹ * v⁻¹) * v := by group
        _ = 1 * v := by rw [h5]
        _ = v := one_mul v
    calc u ^ 2 * v = u ^ 2 * v * (u ^ 2)⁻¹ * u ^ 2 := by group
      _ = v * u ^ 2 := by rw [h6]
  -- `P ^ (2) = A`
  have hP2 : Work.Higman.powSub (⊤ : Subgroup P) 2 = A := by
    refine le_antisymm ?_ ?_
    · rw [Work.Higman.powSub, Subgroup.closure_le]
      rintro y ⟨x, -, rfl⟩
      exact hsq x
    · rw [← hGs, Subgroup.commutator_le]
      intro x _ y _
      exact Work.Higman.H8.Clean.commutator_mem_powSub_top x y
  -- `P ^ (2) ≤ C_P(D)`, hence `A ≤ C_P(D)`
  have hP2C : Work.Higman.powSub (⊤ : Subgroup P) 2 ≤ Subgroup.centralizer (D : Set P) := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact fun v hv => (hsq_comm x v hv).symm
  have hAC : A ≤ Subgroup.centralizer (D : Set P) := hP2 ▸ hP2C
  -- contradiction with `⁅A,D⁆ = A² ≠ ⊥`
  have hbot : ⁅A, D⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hAC
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
    have h2 := h.omega1_card_ge_four
    omega
  exact hA2ne (hADeq ▸ hbot)

/-- **The hard core of `c4_exclusion_sq`.**  The `C₄` setting with `[D,D] = A²`,
`Φ(D) = D² ⊔ [D,D] = A²` and `D` not centralising `A`.  Then contradiction. -/
private theorem c4_hard_core (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : D ≠ A)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D)
    (hPhi : Work.Higman.powSub D 2 ⊔ ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e)) :
    False := by
  classical
  -- Case analysis on `[P,D]`
  by_cases hcase : ⁅(⊤ : Subgroup P), D⁆ ≤ Work.Higman.powSub A 2
  · exact false_of_comm_le_powSub_two h hA hGs hsq hA4 htop hDd hAD hDinv hnZ hcase
  · -- Case II: `[P,D] = A`
    have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
      intro hb
      have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
      have h2 := h.omega1_card_ge_four
      omega
    -- `[P,D] = A`
    have hDP : ⁅(⊤ : Subgroup P), D⁆ = A := by
      have hle : ⁅(⊤ : Subgroup P), D⁆ ≤ A :=
        (Subgroup.commutator_mono (le_refl (⊤ : Subgroup P)) le_top).trans (le_of_eq hGs)
      have hge : Work.Higman.powSub A 2 ≤ ⁅(⊤ : Subgroup P), D⁆ := by
        rw [← hDd]; exact Subgroup.commutator_mono le_top le_rfl
      have hinv : (⁅(⊤ : Subgroup P), D⁆).map (h.xi : MulAut P).toMonoidHom
          = ⁅(⊤ : Subgroup P), D⁆ := by
        rw [Subgroup.map_commutator,
          Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective, hDinv]
      rcases Work.Higman.xi_invariant_eq_powSub_two_or_self h hA hle hge hinv with h1 | h2
      · exact absurd (le_of_eq h1) hcase
      · exact h2
    -- `[D,A] = A²`
    have hDAeq : ⁅D, A⁆ = Work.Higman.powSub A 2 := by
      have hle : ⁅D, A⁆ ≤ Work.Higman.powSub A 2 :=
        (Subgroup.commutator_mono le_rfl hAD).trans (hDd ▸ le_rfl)
      have hinv : (⁅D, A⁆).map (h.xi : MulAut P).toMonoidHom = ⁅D, A⁆ := by
        rw [Subgroup.map_commutator, hDinv, IsXiAbelNormal.map_eq hA]
      have hne : ⁅D, A⁆ ≠ ⊥ := by
        intro hbot
        apply hnZ
        intro e he a ha
        have h1 : ⁅e, a⁆ ∈ (⊥ : Subgroup P) := by
          rw [← hbot]
          exact Subgroup.commutator_mem_commutator he ha
        exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1)
      rcases Work.Higman.H8.Clean.nsd_omega1_eq_bot_or_top_of_invariant h
        (hle.trans (htop ▸ le_rfl)) hinv with hb | hT
      · exact absurd hb hne
      · rw [hT]; exact htop.symm
    -- `[A,P] = A²`
    have hAP : ⁅A, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2 := by
      have hle : ⁅A, (⊤ : Subgroup P)⁆ ≤ Work.Higman.powSub A 2 :=
        Work.Higman.H8.Clean.nsd_comm_le h (IsXiAbelNormal.map_eq hA) (IsXiAbelNormal.abelian hA) hGs
      have hge : Work.Higman.powSub A 2 ≤ ⁅A, (⊤ : Subgroup P)⁆ := by
        rw [← hDAeq, Subgroup.commutator_comm]
        exact Subgroup.commutator_mono le_rfl le_top
      exact le_antisymm hle hge
    -- `Z(P) = A²`
    have hZP : Subgroup.center P = Work.Higman.powSub A 2 := by
      have hZleA : Subgroup.center P ≤ A := Work.Higman.center_le_of_maximal h hA hmax
      have hA2leZ : Work.Higman.powSub A 2 ≤ Subgroup.center P := by
        rw [htop]; exact h.omega1_le_center
      have hZinv : (Subgroup.center P).map (h.xi : MulAut P).toMonoidHom
          = Subgroup.center P := by
        refine le_antisymm ?_ ?_
        · rintro x ⟨z, hz, rfl⟩
          exact Work.Higman.aut_mem_center (h.xi : MulAut P) hz
        · intro x hx
          exact ⟨(h.xi : MulAut P).symm x,
            Work.Higman.aut_mem_center (h.xi : MulAut P).symm hx, by simp⟩
      rcases Work.Higman.xi_invariant_eq_powSub_two_or_self h hA hZleA hA2leZ hZinv with h1 | h2
      · exact h1
      · exfalso
        have hbot : ⁅A, (⊤ : Subgroup P)⁆ = ⊥ := by
          refine Subgroup.commutator_eq_bot_iff_le_centralizer.mpr ?_
          intro a ha
          rw [Subgroup.mem_centralizer_iff]
          intro y _
          exact Subgroup.mem_center_iff.mp (h2 ▸ ha) y
        exact hA2ne (hAP ▸ hbot)
    -- `P² = A`
    have hP2 : Work.Higman.powSub (⊤ : Subgroup P) 2 = A := by
      refine le_antisymm ?_ ?_
      · rw [Work.Higman.powSub, Subgroup.closure_le]
        rintro y ⟨x, -, rfl⟩
        exact hsq x
      · rw [← hGs, Subgroup.commutator_le]
        intro x _ y _
        exact Work.Higman.H8.Clean.commutator_mem_powSub_top x y
    -- `Z(D) = A²`
    have hZD : D ⊓ Subgroup.centralizer (D : Set P) = Work.Higman.powSub A 2 := by
      have hcomm : ∀ x y : P, x * y * x⁻¹ * y⁻¹ ∈ A := by
        intro x y
        rw [← hGs]
        exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
      have hleA : D ⊓ Subgroup.centralizer (D : Set P) ≤ A := by
        intro z hz
        by_contra hzA
        exact Work.Higman.no_cent_elt_outside_maximal h hA hmax hDn hDinv hAD hcomm hz.1
          (fun y hy => Subgroup.mem_centralizer_iff.mp hz.2 y hy) hzA
      have hA2leD : Work.Higman.powSub A 2 ≤ D ⊓ Subgroup.centralizer (D : Set P) := by
        intro z hz
        refine Subgroup.mem_inf.mpr
          ⟨hAD ((Work.Higman.powSub_le (A := A) (n := 2) (by norm_num)) hz), ?_⟩
        rw [Subgroup.mem_centralizer_iff]
        intro y _
        exact Subgroup.mem_center_iff.mp (h.omega1_le_center (htop ▸ hz)) y
      have hinv : (D ⊓ Subgroup.centralizer (D : Set P)).map (h.xi : MulAut P).toMonoidHom
          = D ⊓ Subgroup.centralizer (D : Set P) :=
        Work.Higman.map_inf_centralizer_eq (h.xi : MulAut P) hDinv
      rcases Work.Higman.xi_invariant_eq_powSub_two_or_self h hA hleA hA2leD hinv with h1 | h2
      · exact h1
      · exfalso
        apply hnZ
        intro e he a ha
        have hmem : a ∈ D ⊓ Subgroup.centralizer (D : Set P) := h2 ▸ ha
        exact Subgroup.mem_centralizer_iff.mp hmem.2 e he
    -- `|D| = |Ω₁(P)|³`
    have hDcard : Nat.card ↥D = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
      obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
      obtain ⟨e, he⟩ := (h.isPGroup.to_subgroup D).exists_card_eq
      have hq4 : 4 ≤ 2 ^ n := by rw [← hn]; exact h.omega1_card_ge_four
      have hnpos : 0 < n := by
        rcases Nat.eq_zero_or_pos n with h0 | hpos
        · subst h0; norm_num at hq4
        · exact hpos
      -- the orbit count `2 ^ n - 1 ∣ |D| - 1`
      have hdiv : 2 ^ n - 1 ∣ 2 ^ e - 1 := by
        rw [← hn, ← he]
        exact Work.Higman.H8.card_sub_one_dvd_xi h hDinv
      -- hence `n ∣ e`
      have hned : n ∣ e :=
        (Work.Higman.Q3.pow_sub_one_dvd_pow_sub_one_iff (x := 2) (m := n) (k := e)
          (by norm_num) hnpos).mp hdiv
      -- Chevalley--Warning for `D`: `|D| ≤ (2 ^ n) ^ 3`
      have hDle : Nat.card ↥D ≤ (2 ^ n) ^ 3 := by
        rw [← hn]
        refine Work.Higman.H8.card_le_cube_of_sq_le_omega1 h ?_ ?_ ?_
        · rw [← htop]
          exact (Work.Higman.powSub_le (A := A) (n := 2) (by norm_num)).trans hAD
        · rw [← htop]
          exact le_sup_left.trans_eq hPhi
        · rw [← htop, hDd]
      -- `|A| < |D|`
      have hlt : Nat.card ↥A < Nat.card ↥D := by
        have hne : A.subgroupOf D ≠ ⊤ := by
          intro hc
          exact hADne (le_antisymm (Subgroup.subgroupOf_eq_top.mp hc) hAD)
        have hcard : Nat.card ↥(A.subgroupOf D) = Nat.card ↥A :=
          Nat.card_congr
            { toFun := fun x => (⟨((x : ↥D) : P), x.2⟩ : ↥A)
              invFun := fun a => (⟨⟨(a : P), hAD a.2⟩, a.2⟩ : ↥(A.subgroupOf D))
              left_inv := fun x => Subtype.ext rfl
              right_inv := fun a => Subtype.ext rfl }
        have h1 : Nat.card ↥(A.subgroupOf D) < Nat.card ↥D := by
          have h2 : (A.subgroupOf D : Set ↥D) ≠ Set.univ := fun h' =>
            hne (SetLike.coe_set_eq.mp h')
          have h3 := Set.ncard_lt_card (α := ↥D) h2
          rwa [← Nat.card_coe_set_eq ((A.subgroupOf D) : Set ↥D)] at h3
        rwa [hcard] at h1
      -- `|D| > |A| = (2 ^ n) ^ 2`, so `2 * n < e`
      have hgt : 2 ^ (2 * n) < 2 ^ e := by
        have hAcard : Nat.card ↥A = (2 ^ n) ^ 2 := by rw [hcard, hn]
        calc 2 ^ (2 * n) = (2 ^ n) ^ 2 := by rw [← pow_mul, Nat.mul_comm]
          _ = Nat.card ↥A := hAcard.symm
          _ < Nat.card ↥D := hlt
          _ = 2 ^ e := he
      have he2n : 2 * n < e := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).mp hgt
      -- `e ≤ 3 * n`
      have hele : e ≤ 3 * n := by
        have h1 : 2 ^ e ≤ 2 ^ (3 * n) := by
          calc 2 ^ e = Nat.card ↥D := he.symm
            _ ≤ (2 ^ n) ^ 3 := hDle
            _ = 2 ^ (3 * n) := by rw [← pow_mul, Nat.mul_comm]
        exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp h1
      -- hence `e = 3 * n`
      have he3 : e = 3 * n := by
        rcases hned with ⟨c, hc⟩
        have hc3 : c = 3 := by
          have hcle : c ≤ 3 := by
            have hle' : n * c ≤ n * 3 := by
              rw [← hc]
              exact hele.trans (le_of_eq (Nat.mul_comm 3 n))
            exact Nat.le_of_mul_le_mul_left hle' hnpos
          have hcge : 3 ≤ c := by
            by_contra hcon
            push_neg at hcon
            interval_cases c <;> (rw [hc] at he2n <;> omega)
          omega
        rw [hc, hc3, Nat.mul_comm]
      rw [he, he3, hn, ← pow_mul, Nat.mul_comm]
    -- `|P| = |D|`, so `D = ⊤`
    have hPle : Nat.card P ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 :=
      Work.Higman.H8.card_le_cube_suzuki h
    have hDPle : Nat.card ↥D ≤ Nat.card P :=
      Nat.le_of_dvd Nat.card_pos (Subgroup.card_subgroup_dvd_card D)
    have hPeq : Nat.card P = Nat.card ↥D := le_antisymm (by rw [hDcard]; exact hPle) hDPle
    have hDtop : D = ⊤ := Subgroup.eq_top_of_card_eq D hPeq.symm
    -- `A = A²`, contradiction
    have hAeq : A = Work.Higman.powSub A 2 :=
      calc A = ⁅(⊤ : Subgroup P), ⊤⁆ := hGs.symm
        _ = ⁅D, D⁆ := by rw [hDtop]
        _ = Work.Higman.powSub A 2 := hDd
    have hAne2 : A ≠ Work.Higman.powSub A 2 := by
      intro hEq
      have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
        congrArg (fun s : Subgroup P => Nat.card ↥s) hEq
      rw [htop] at h1
      have hkey : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 :=
        calc Nat.card ↥(Work.Higman.omega1 P) = Nat.card ↥A := h1.symm
          _ = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := hcard
      have h4 := h.omega1_card_ge_four
      have hq2 : Nat.card ↥(Work.Higman.omega1 P)
          * (Nat.card ↥(Work.Higman.omega1 P) - 1) = 0 := by nlinarith [hkey]
      have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P)
          * (Nat.card ↥(Work.Higman.omega1 P) - 1) :=
        Nat.mul_pos Nat.card_pos (by omega)
      omega
    exact hAne2 hAeq

end Work.Higman.H8
end

-- ===== from Submission.Work.Higman.H8.c4_reducible_deriv_eq_A_false =====
section

/-!
# The `[E,E] = A` case of the `C₄` exclusion

This is the case of the `C₄` exclusion in which some `ξ`-invariant normal subgroup `E > A`
covering `A` has derived subgroup exactly `A`.  It is a short corollary of Higman's Lemma 8 in
the strong form (`Work.Higman.MSA.lemma8_clean`, axiom-clean): the conclusion of Lemma 8 is
`exp A ∣ 2`, i.e. `A ≤ Ω₁(P) = A² ≤ A`, contradicting `|A| = |Ω₁(P)|²` with
`|Ω₁(P)| ≥ 4`.
-/

namespace Work.Higman.H8

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-- **The `[E,E] = A` case of the `C₄` exclusion.**  Let `P` be a Suzuki 2-group, `A ⊴ P` a
`ξ`-invariant abelian normal subgroup with `Ω₁(P) ≤ A`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`, and
every square of `P` in `A`.  Let `E ⊴ P` be `ξ`-invariant with `A ≤ E`, `E ≠ A`, `E/A`
irreducible as a `ξ`-module (hypothesis `hcover`) and `[E,E] = A`.  Then `False`. -/
private theorem c4_reducible_deriv_eq_A_false (h : Work.Higman.IsSuzuki2Grp P) {A E : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hEn : E.Normal) (hEinv : E.map (h.xi : MulAut P).toMonoidHom = E)
    (hAE : A ≤ E) (hEA : E ≠ A)
    (hcover : ∀ F : Subgroup P, F.Normal → F.map (h.xi : MulAut P).toMonoidHom = F →
      A ≤ F → F ≤ E → F = A ∨ F = E)
    (hEd : ⁅E, E⁆ = A) :
    False := by
  -- `E ^ (2) ≤ A`, since every square of `P` lies in `A`.
  have hE2 : Work.Higman.powSub E 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  -- Higman's Lemma 8 (strong form, axiom-clean): every element of `A` is an involution.
  have hexp : ∀ a ∈ A, a * a = 1 :=
    Work.Higman.MSA.lemma8_clean h hA hEn hEinv hAE hEA.symm hcover hE2 hEd
  -- Hence `A ≤ Ω₁(P) = A ^ (2) ≤ A`, so `|A| = |Ω₁(P)|`.
  have hAle : A ≤ Work.Higman.powSub A 2 := by
    rw [htop]
    intro a ha
    exact h.mem_omega1.mpr (by rw [pow_two]; exact hexp a ha)
  have hAeq : A = Work.Higman.powSub A 2 :=
    le_antisymm hAle (Work.Higman.powSub_le (n := 2) (by norm_num))
  have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
    congrArg (fun S : Subgroup P => Nat.card ↥S) hAeq
  have h2 : Nat.card ↥A = (Nat.card ↥A) ^ 2 := by
    rw [h1] at hcard
    rw [← htop] at hcard
    rw [h1]
    exact hcard
  have hge : 4 ≤ Nat.card ↥A := by
    rw [hAeq, htop]
    exact h.omega1_card_ge_four
  have hone : 1 < Nat.card ↥A := by omega
  have hlt : Nat.card ↥A < Nat.card ↥A * Nat.card ↥A :=
    calc Nat.card ↥A = Nat.card ↥A * 1 := (mul_one _).symm
      _ < Nat.card ↥A * Nat.card ↥A := Nat.mul_lt_mul_of_pos_left hone (by omega)
  have h3 : Nat.card ↥A * Nat.card ↥A = Nat.card ↥A := by
    rw [← pow_two]; exact h2.symm
  omega

end Work.Higman.H8
end

-- ===== from Submission.Work.Higman.HS.xi_pow_triv_quot_C_A =====
section

open scoped commutatorElement

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.Higman.HS

/-- **`ξ ^ (|Ω₁(P)| - 1)` acts trivially on `C/A`** (Higman's Lemma 6, first step, in the
covering formulation).

Let `P` be a Suzuki 2-group, `A ≤ C` normal subgroups with `A` abelian and `ξ`-invariant,
`[C, A] = A² = Ω₁(P)`, and suppose that the only `ξ`-invariant normal subgroups between `A` and
`C` are `A` and `C` (`hcover`, `A ≠ C`).  Then the power `η := ξ ^ (|Ω₁(P)| - 1)` satisfies
`η x * x⁻¹ ∈ A` for every `x ∈ C`, i.e. `η` induces the identity of `C/A`.

Proof.  Since `ξ` permutes the involutions of `P` transitively, `η` fixes `Ω₁(P) = A²`
pointwise (`xi_pow_triv_omega1_iff`).  Let `δ x := (η x) x⁻¹` for `x ∈ C`, and let `E` be the
normal closure of `A ∪ {δ x : x ∈ C}`.  Then `A ≤ E ≤ C` and `E` is `ξ`-invariant, so `hcover`
gives `E = A` or `E = C`.

* If `E = A` then `δ x ∈ A` for all `x ∈ C`, which is the claim.
* If `E = C`, then `C` centralises `A`:  `A` clearly does, and each `δ x` does by Higman's
  commutator collapse (`commutator_pow_mul_inv_eq_one`: `[η x, η y] = [x, y]^η` for `y ∈ A`,
  and `[x, y] ∈ [C, A] = A² = Ω₁` is fixed by `η`, so `[δ x, y] = 1`); finally `A` being normal,
  conjugates of centralising elements still centralise `A`.  Hence `[C, A] = 1`, contradicting
  `[C, A] = A² ≠ 1` (`A² = Ω₁(P)` has more than one element). -/
private theorem xi_pow_triv_quot_C_A {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    ∀ x ∈ C, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A := by
  haveI : C.Normal := hCn
  set k : ℕ := Nat.card ↥(Work.Higman.omega1 P) - 1 with hk
  have hηΩ : ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w := by
    intro w hw
    rw [hk]
    exact xi_pow_card_sub_one_fixes_omega1 h w hw
  have hCA2 : ⁅A, C⁆ = Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_comm]; exact hCAd
  have homega_ne : Work.Higman.omega1 P ≠ ⊥ := by
    intro hbot
    have h4 := h.omega1_card_ge_four
    rw [hbot, Subgroup.card_bot] at h4
    omega
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by rw [htop]; exact homega_ne
  -- `ξ` commutes with `η = ξ ^ k` (both as an automorphism and as its inverse)
  have hηξ : ∀ y : P, h.xi ((h.xi ^ k) y) = (h.xi ^ k) (h.xi y) := by
    intro y
    have h1 : h.xi ((h.xi ^ k) y) = (h.xi ^ (k + 1)) y := by
      rw [← MulAut.mul_apply, ← pow_succ']
    have h2 : (h.xi ^ k) (h.xi y) = (h.xi ^ (k + 1)) y := by
      rw [← MulAut.mul_apply, ← pow_succ]
    rw [h1, h2]
  have hηsymm : ∀ y : P, (h.xi : MulAut P).symm ((h.xi ^ k) y)
      = (h.xi ^ k) ((h.xi : MulAut P).symm y) := by
    intro y
    apply h.xi.injective
    rw [MulEquiv.apply_symm_apply, hηξ, MulEquiv.apply_symm_apply]
  -- the generating set `A ∪ {δ x : x ∈ C}` and the normal closure `E`
  set G : Set P := (A : Set P) ∪ {e : P | ∃ y : P, y ∈ C ∧ e = (h.xi ^ k) y * y⁻¹} with hG
  set E : Subgroup P := Subgroup.normalClosure G with hE
  have hAE : A ≤ E := by
    intro a ha
    rw [hE]
    exact Subgroup.subset_normalClosure (by rw [hG]; exact Or.inl ha)
  have hEC : E ≤ C := by
    rw [hE]
    refine Subgroup.normalClosure_le_normal ?_
    intro g hg
    rw [hG] at hg
    rcases hg with hgA | ⟨y, hy, rfl⟩
    · exact hAC hgA
    · exact C.mul_mem (mem_of_pow_map_eq (φ := h.xi) hCinv k hy) (C.inv_mem hy)
  -- `G` is `ξ`-invariant, hence so is `E`
  have himg : (⇑(MulEquiv.toMonoidHom h.xi)) '' G = G := by
    apply Set.Subset.antisymm
    · rintro z ⟨w, hw, rfl⟩
      rw [hG] at hw ⊢
      rcases hw with hwA | ⟨y, hy, rfl⟩
      · refine Or.inl ?_
        have h1 : h.xi w ∈ Subgroup.map (h.xi : MulAut P).toMonoidHom A :=
          Subgroup.mem_map_of_mem _ hwA
        rwa [hAxi] at h1
      · refine Or.inr ⟨h.xi y, ?_, ?_⟩
        · have h1 : h.xi y ∈ Subgroup.map (h.xi : MulAut P).toMonoidHom C :=
            Subgroup.mem_map_of_mem _ hy
          rwa [hCinv] at h1
        · show h.xi ((h.xi ^ k) y * y⁻¹) = (h.xi ^ k) (h.xi y) * (h.xi y)⁻¹
          rw [map_mul, map_inv, hηξ]
    · rintro z hz
      rw [hG] at hz
      rcases hz with hzA | ⟨y, hy, rfl⟩
      · refine ⟨(h.xi : MulAut P).symm z, ?_, by simp⟩
        rw [hG]
        exact Or.inl (symm_mem_of_map_eq (h.xi : MulAut P) hAxi hzA)
      · refine ⟨(h.xi : MulAut P).symm ((h.xi ^ k) y * y⁻¹), ?_, by simp⟩
        rw [hG]
        refine Or.inr ⟨(h.xi : MulAut P).symm y,
          symm_mem_of_map_eq (h.xi : MulAut P) hCinv hy, ?_⟩
        rw [map_mul, hηsymm, map_inv]
  have hEinv : E.map (h.xi : MulAut P).toMonoidHom = E := by
    have hmc := Subgroup.map_normalClosure G (h.xi : MulAut P).toMonoidHom h.xi.surjective
    rw [hE, hmc, himg]
  have hEnorm : E.Normal := by rw [hE]; exact Subgroup.normalClosure_normal
  -- a conjugate of an element centralising `A` still centralises `A` (as `A` is normal)
  have hconj_cent : ∀ {g : P}, g ∈ Subgroup.centralizer (A : Set P) → ∀ c : P,
      c * g * c⁻¹ ∈ Subgroup.centralizer (A : Set P) := by
    intro g hg c
    rw [Subgroup.mem_centralizer_iff] at hg ⊢
    intro a ha
    have hca : c⁻¹ * a * c ∈ A := by simpa using hAn.conj_mem a ha c⁻¹
    have h1 : (c⁻¹ * a * c) * g = g * (c⁻¹ * a * c) := hg _ hca
    calc a * (c * g * c⁻¹) = c * (c⁻¹ * a * c) * g * c⁻¹ := by group
      _ = c * ((c⁻¹ * a * c) * g) * c⁻¹ := by group
      _ = c * (g * (c⁻¹ * a * c)) * c⁻¹ := by rw [h1]
      _ = (c * g * c⁻¹) * a := by group
  -- every generator of `E` centralises `A`
  have hGcent : ∀ g ∈ G, g ∈ Subgroup.centralizer (A : Set P) := by
    intro g hg
    rw [hG] at hg
    rcases hg with hgA | ⟨y, hy, rfl⟩
    · refine (Subgroup.mem_centralizer_iff).mpr ?_
      intro a ha
      exact (hAab g hgA a ha).symm
    · refine (Subgroup.mem_centralizer_iff).mpr ?_
      intro a ha
      exact (commutatorElement_eq_one_iff_mul_comm.mp
        (commutator_pow_mul_inv_eq_one h hAab hAxi htop hCA2 hηΩ hy ha)).symm
  have hEcent : E ≤ Subgroup.centralizer (A : Set P) := by
    rw [hE]
    show Subgroup.closure (Group.conjugatesOfSet G) ≤ Subgroup.centralizer (A : Set P)
    rw [Subgroup.closure_le]
    intro z hz
    rw [Group.mem_conjugatesOfSet_iff] at hz
    obtain ⟨g, hg, hconj⟩ := hz
    rw [isConj_iff] at hconj
    obtain ⟨c, hc⟩ := hconj
    rw [← hc]
    exact hconj_cent (hGcent g hg) c
  rcases hcover E hEnorm hEinv hAE hEC with hEA | hEC'
  · intro x hx
    have hmem : (h.xi ^ k) x * x⁻¹ ∈ E := by
      rw [hE]
      apply Subgroup.subset_normalClosure
      rw [hG]
      exact Or.inr ⟨x, hx, rfl⟩
    rw [hEA] at hmem
    exact hmem
  · exfalso
    have hCle : C ≤ Subgroup.centralizer (A : Set P) := hEC' ▸ hEcent
    have hbot : ⁅C, A⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hCle
    rw [hCAd] at hbot
    exact hA2ne hbot

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.card_quot_C_A_eq =====
section

open scoped commutatorElement

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.Higman.HS

variable {P : Type} [Group P] [Finite P]

/-! ## Two structural facts about the quotient `C/A`

Throughout, `A ≤ C` are subgroups of a Suzuki 2-group `P` with `[P,P] = A`, so that every
subgroup lying between `A` and `C` is automatically normal. -/

/-- **`C/A` is abelian** when `[P,P] = A`: `[C,C] ≤ [P,P] = A`. -/
private theorem quot_comm_of_commutator_top_eq (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) :
    ∀ x y : ↥C ⧸ (A.subgroupOf C), x * y = y * x := by
  have hCC : ⁅C, C⁆ ≤ A :=
    (Subgroup.commutator_mono (le_top : C ≤ ⊤) (le_top : C ≤ ⊤)).trans (le_of_eq hGs)
  intro x y
  induction x using QuotientGroup.induction_on with
  | _ a =>
    induction y using QuotientGroup.induction_on with
    | _ b =>
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
      rw [Subgroup.mem_subgroupOf]
      have key : (((a * b)⁻¹ * (b * a) : ↥C) : P) = ⁅(b : P)⁻¹, (a : P)⁻¹⁆ := by
        simp only [Subgroup.coe_mul, Subgroup.coe_inv, commutatorElement_def]
        group
      rw [key]
      exact hCC (Subgroup.commutator_mem_commutator (C.inv_mem b.2) (C.inv_mem a.2))

/-- **Irreducibility of `C/A`** under the induced `ξ`-action, when `[P,P] = A` and the only
`ξ`-invariant normal subgroups between `A` and `C` are `A` and `C`: the only `ξ`-invariant
subgroups of the quotient `C/A` are `⊥` and `⊤`.

This is `Work.Higman.MSA.l8_quot_irred` with the normality of the intermediate subgroups
supplied by `[P,P] = A` (instead of by `[C,C] = A`). -/
private theorem quot_irred_of_commutator_top_eq {P : Type} [Group P] [Finite P]
    {h : IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    {K : Subgroup (↥C ⧸ (A.subgroupOf C))}
    (hK : K.map (Work.Higman.MSA.L8.xiQuot h hAinv hCinv).toMonoidHom = K) :
    K = ⊥ ∨ K = ⊤ := by
  have hW : ∀ v ∈ K, Work.Higman.MSA.L8.xiQuot h hAinv hCinv v ∈ K := by
    intro v hv
    have h1 := Subgroup.mem_map_of_mem (Work.Higman.MSA.L8.xiQuot h hAinv hCinv).toMonoidHom hv
    rwa [hK] at h1
  set D : Subgroup ↥C := K.comap (QuotientGroup.mk' (A.subgroupOf C)) with hD
  have hmemD : ∀ u : ↥C, u ∈ D ↔ QuotientGroup.mk' (A.subgroupOf C) u ∈ K := fun u => Iff.rfl
  set Dp : Subgroup P := D.map C.subtype with hDp
  have hAD : (A.subgroupOf C) ≤ D := by
    intro x hx
    rw [hmemD]
    have hx1 : QuotientGroup.mk' (A.subgroupOf C) x = 1 := by
      rw [QuotientGroup.mk'_apply]
      exact (QuotientGroup.eq_one_iff x).mpr hx
    rw [hx1]
    exact K.one_mem
  have hADp : A ≤ Dp := by
    intro a ha
    rw [hDp]
    exact Subgroup.mem_map.mpr ⟨⟨a, hAC ha⟩, hAD (Subgroup.mem_subgroupOf.mpr ha), rfl⟩
  have hDpC : Dp ≤ C := by
    rw [hDp]
    exact Subgroup.map_subtype_le D
  have hDpinv_le : Dp.map (h.xi : MulAut P).toMonoidHom ≤ Dp := by
    rw [Subgroup.map_le_iff_le_comap]
    intro x hx
    obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.mp hx
    rw [hDp]
    refine Subgroup.mem_map.mpr ⟨(Work.Higman.MSA.L8.xiSubAut h hCinv d : ↥C), ?_, rfl⟩
    rw [hmemD] at hd ⊢
    have h1 : Work.Higman.MSA.L8.xiQuot h hAinv hCinv
        (QuotientGroup.mk' (A.subgroupOf C) d) ∈ K := hW _ hd
    simpa [QuotientGroup.mk'_apply, Work.Higman.MSA.l8_xiQuot_mk] using h1
  have hDpinv : Dp.map (h.xi : MulAut P).toMonoidHom = Dp :=
    Subgroup.eq_of_le_of_card_ge hDpinv_le
      (le_of_eq (Subgroup.card_map_of_injective (h.xi : MulAut P).injective).symm)
  have hKD : K = D.map (QuotientGroup.mk' (A.subgroupOf C)) := by
    ext v
    constructor
    · intro hv
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (A.subgroupOf C) v
      exact ⟨u, (hmemD u).mpr hv, rfl⟩
    · rintro ⟨u, hu, rfl⟩
      exact (hmemD u).mp hu
  have hDpn : Dp.Normal := by
    refine Subgroup.Normal.of_commutator_le P ?_
    rw [show _root_.commutator P = ⁅(⊤ : Subgroup P), ⊤⁆ from rfl, hGs]
    exact hADp
  rcases hcover Dp hDpn hDpinv hADp hDpC with hh | hh
  · left
    have hmap : D.map C.subtype = (A.subgroupOf C).map C.subtype := by
      rw [← hDp, hh, Subgroup.map_subgroupOf_eq_of_le hAC]
    have hDA : D = A.subgroupOf C := Subgroup.map_injective C.subtype_injective hmap
    rw [hKD, hDA, Subgroup.map_eq_bot_iff]
    intro x hx
    rw [QuotientGroup.ker_mk']
    exact hx
  · right
    have hDtop : D = ⊤ := by
      rw [Subgroup.eq_top_iff']
      intro x
      have hx : C.subtype x ∈ Dp := by rw [hh]; exact x.2
      rw [hDp] at hx
      obtain ⟨d, hd, hdx⟩ := Subgroup.mem_map.mp hx
      rwa [C.subtype_injective hdx] at hd
    rw [hKD, hDtop, Subgroup.map_top]
    exact MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective (A.subgroupOf C))

/-- **The easy half of the `m = n` count.**  With `A ≤ C`, `[P,P] = A`, `C² ≤ A`, `C/A` a
minimal normal `ξ`-section and `ξ ^ (|Ω₁(P)| - 1)` trivial on `C/A`, the cardinality of `C/A`
divides `|Ω₁(P)|`.

`C/A` is an elementary abelian `𝔽₂`-module which is irreducible for the induced action of `ξ`,
and `ξ` acts on it with order dividing `|Ω₁(P)| - 1 = 2ⁿ - 1`; hence `finrank 𝔽₂ (C/A) ∣ n`, so
`|C/A| = 2 ^ finrank` divides `2ⁿ = |Ω₁(P)|`. -/
private theorem card_quot_dvd_omega1_aux (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hstep : ∀ x ∈ C, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A) :
    Nat.card (↥C ⧸ (A.subgroupOf C)) ∣ Nat.card ↥(Work.Higman.omega1 P) := by
  classical
  -- the abelian group structure of `C/A` and its `𝔽₂`-module structure
  letI : CommGroup (↥C ⧸ (A.subgroupOf C)) :=
    { (inferInstance : Group (↥C ⧸ (A.subgroupOf C))) with
      mul_comm := quot_comm_of_commutator_top_eq h hGs }
  have hV2 : ∀ x : ↥C ⧸ (A.subgroupOf C), x * x = 1 :=
    fun x => Work.Higman.MSA.L8.quot_sq_one (A := A) (C := C) hC2 x
  letI : Module (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) :=
    Work.Higman.SZ.module_zmod2_of_sq_one (G := ↥C ⧸ (A.subgroupOf C)) hV2
  -- `C/A` is non-trivial
  have hex : ∃ y : ↥C ⧸ (A.subgroupOf C), y ≠ 1 := by
    obtain ⟨x, hxC, hxA⟩ : ∃ x ∈ C, x ∉ A := by
      by_contra hcon
      push Not at hcon
      exact hCA (le_antisymm hAC hcon)
    refine ⟨QuotientGroup.mk (⟨x, hxC⟩ : ↥C), ?_⟩
    intro h1
    rw [QuotientGroup.eq_one_iff] at h1
    exact hxA (Subgroup.mem_subgroupOf.mp h1)
  haveI : Nontrivial (↥C ⧸ (A.subgroupOf C)) := ⟨⟨_, 1, hex.choose_spec⟩⟩
  haveI : Nontrivial (Additive (↥C ⧸ (A.subgroupOf C))) :=
    ⟨⟨Additive.ofMul hex.choose, 0, by
      intro hh
      exact hex.choose_spec (by simpa using congrArg Additive.toMul hh)⟩⟩
  -- `|Ω₁(P)| = 2 ^ n`
  obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
  have hn1 : 1 ≤ n := by
    have h4 : 4 ≤ 2 ^ n := by rw [← hn]; exact h.omega1_card_ge_four
    by_contra hc
    push Not at hc
    interval_cases n <;> norm_num at h4
  -- the induced linear automorphism of `C/A`
  set xiQ := Work.Higman.MSA.L8.xiQuot h hAinv hCinv with hxiQ
  let ξV : Additive (↥C ⧸ (A.subgroupOf C)) ≃ₗ[ZMod 2] Additive (↥C ⧸ (A.subgroupOf C)) :=
    xiQ.toAdditive.toLinearEquiv (by
      intro c x
      fin_cases c
      · show xiQ.toAdditive ((0 : ZMod 2) • x) = (0 : ZMod 2) • xiQ.toAdditive x
        simp
      · show xiQ.toAdditive ((1 : ZMod 2) • x) = (1 : ZMod 2) • xiQ.toAdditive x
        simp)
  have hξV : ∀ x : Additive (↥C ⧸ (A.subgroupOf C)),
      ξV x = Additive.ofMul (xiQ (Additive.toMul x)) := fun x => rfl
  have hξVpow : ∀ (k : ℕ) (x : Additive (↥C ⧸ (A.subgroupOf C))),
      (ξV ^ k) x = Additive.ofMul ((xiQ ^ k) (Additive.toMul x)) := by
    intro k
    induction k with
    | zero => intro x; simp
    | succ k ih =>
        intro x
        rw [pow_succ', pow_succ', LinearEquiv.mul_apply, ih x,
          hξV (Additive.ofMul ((xiQ ^ k) (Additive.toMul x))), toMul_ofMul]
        congr 1
  have hp : ξV ^ (2 ^ n - 1) = 1 := by
    have hord : orderOf xiQ ∣ Nat.card ↥(Work.Higman.omega1 P) - 1 :=
      Work.Higman.HS.orderOf_xiQuot_dvd hAinv hCinv hstep
    have h1 : xiQ ^ (Nat.card ↥(Work.Higman.omega1 P) - 1) = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp hord
    ext x
    rw [← hn, hξVpow, h1]
    rfl
  -- irreducibility of `C/A`
  have hirr : ∀ U : Submodule (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))),
      (∀ x ∈ U, ξV x ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    set Usub : Subgroup (↥C ⧸ (A.subgroupOf C)) :=
      { carrier := {y | Additive.ofMul y ∈ U}
        mul_mem' := by
          intro a b ha hb
          have h1 : Additive.ofMul a + Additive.ofMul b ∈ U := U.add_mem ha hb
          rwa [show Additive.ofMul a + Additive.ofMul b = Additive.ofMul (a * b) from rfl] at h1
        one_mem' := by
          show (0 : Additive (↥C ⧸ (A.subgroupOf C))) ∈ U
          exact U.zero_mem
        inv_mem' := by
          intro a ha
          have h1 : -Additive.ofMul a ∈ U := U.neg_mem ha
          rwa [show -Additive.ofMul a = Additive.ofMul a⁻¹ from rfl] at h1 } with hUsub
    have hmem : ∀ y : ↥C ⧸ (A.subgroupOf C), y ∈ Usub ↔ Additive.ofMul y ∈ U := by
      intro y
      rw [hUsub]
      exact Iff.rfl
    have hpowU : ∀ k : ℕ, ∀ x : Additive (↥C ⧸ (A.subgroupOf C)), x ∈ U → (ξV ^ k) x ∈ U := by
      intro k
      induction k with
      | zero => intro x hx; simpa using hx
      | succ k ih =>
          intro x hx
          rw [pow_succ', LinearEquiv.mul_apply]
          exact hU _ (ih x hx)
    have hUsub_inv : Usub.map xiQ.toMonoidHom = Usub := by
      apply le_antisymm
      · intro y hy
        obtain ⟨v, hv, hvx⟩ := Subgroup.mem_map.mp hy
        rw [MulEquiv.coe_toMonoidHom] at hvx
        have h2 : Additive.ofMul (xiQ v) ∈ U := by
          have h3 : ξV (Additive.ofMul v) ∈ U := hU _ hv
          rwa [hξV (Additive.ofMul v), toMul_ofMul] at h3
        exact (hmem y).mpr (by rwa [hvx] at h2)
      · intro y hy
        rw [hmem] at hy
        refine Subgroup.mem_map.mpr ⟨(xiQ ^ (orderOf xiQ - 1)) y, ?_, ?_⟩
        · rw [hmem]
          have h1 : (ξV ^ (orderOf xiQ - 1)) (Additive.ofMul y) ∈ U := hpowU _ _ hy
          rwa [hξVpow, toMul_ofMul] at h1
        · have h5 : xiQ ((xiQ ^ (orderOf xiQ - 1)) y) = y := by
            rw [← MulAut.mul_apply, ← pow_succ', Nat.sub_add_cancel (orderOf_pos xiQ),
              pow_orderOf_eq_one, MulAut.one_apply]
          rw [MulEquiv.coe_toMonoidHom]
          exact h5
    rw [hxiQ] at hUsub_inv
    rcases quot_irred_of_commutator_top_eq hAinv hCinv hAC hGs hcover hUsub_inv with hbot | htop
    · left
      rw [Submodule.eq_bot_iff]
      intro x hx
      have h1 : Additive.toMul x ∈ Usub := (hmem _).mpr (ofMul_toMul x ▸ hx)
      rw [hbot, Subgroup.mem_bot] at h1
      rw [← ofMul_toMul x, h1]
      exact ofMul_eq_zero.mpr rfl
    · right
      rw [Submodule.eq_top_iff']
      intro x
      have h1 : Additive.toMul x ∈ Usub := by rw [htop]; exact Subgroup.mem_top _
      have h2 := (hmem _).mp h1
      rwa [ofMul_toMul] at h2
  -- the finrank divides `n`
  have hdvd : Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) ∣ n :=
    Work.Higman.Q3.finrank_dvd_of_irreducible_pow_sub_one ξV hn1 hp hirr
  have hcardV : Nat.card (↥C ⧸ (A.subgroupOf C))
      = 2 ^ Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) := by
    have h1 : Nat.card (Additive (↥C ⧸ (A.subgroupOf C)))
        = Nat.card (ZMod 2) ^ Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) :=
      Module.natCard_eq_pow_finrank
    rw [Nat.card_zmod] at h1
    rw [← h1]
    exact (Nat.card_congr Additive.ofMul).symm
  have hdpos : 0 < Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) := by
    by_contra hc
    push Not at hc
    have h0 : Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) = 0 := by omega
    rw [h0, pow_zero] at hcardV
    have hsub : Subsingleton (↥C ⧸ (A.subgroupOf C)) := (Nat.card_eq_one_iff_unique.mp hcardV).1
    exact hex.choose_spec (Subsingleton.elim hex.choose 1)
  calc Nat.card (↥C ⧸ (A.subgroupOf C))
      = 2 ^ Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) := hcardV
    _ ∣ 2 ^ n := Nat.pow_dvd_pow 2 (Nat.le_of_dvd (by omega) hdvd)
    _ = Nat.card ↥(Work.Higman.omega1 P) := hn.symm

private theorem card_quot_C_A_eq {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hstep : ∀ x ∈ C, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A) :
    Nat.card (↥C ⧸ (A.subgroupOf C)) = Nat.card ↥(Work.Higman.omega1 P) := by
  classical
  -- `|Ω₁(P)| = 2 ^ n`
  obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
  have hn1 : 1 ≤ n := by
    have h4 : 4 ≤ 2 ^ n := by rw [← hn]; exact h.omega1_card_ge_four
    by_contra hc
    push Not at hc
    interval_cases n <;> norm_num at h4
  -- the `𝔽₂`-module structure of `V = C/A`
  letI : CommGroup (↥C ⧸ (A.subgroupOf C)) :=
    { (inferInstance : Group (↥C ⧸ (A.subgroupOf C))) with
      mul_comm := quot_comm_of_commutator_top_eq h hGs }
  have hV2 : ∀ x : ↥C ⧸ (A.subgroupOf C), x * x = 1 :=
    fun x => Work.Higman.MSA.L8.quot_sq_one (A := A) (C := C) hC2 x
  letI : Module (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) :=
    Work.Higman.SZ.module_zmod2_of_sq_one (G := ↥C ⧸ (A.subgroupOf C)) hV2
  have hex : ∃ y : ↥C ⧸ (A.subgroupOf C), y ≠ 1 := by
    obtain ⟨x, hxC, hxA⟩ : ∃ x ∈ C, x ∉ A := by
      by_contra hcon
      push Not at hcon
      exact hCA (le_antisymm hAC hcon)
    refine ⟨QuotientGroup.mk (⟨x, hxC⟩ : ↥C), ?_⟩
    intro h1
    rw [QuotientGroup.eq_one_iff] at h1
    exact hxA (Subgroup.mem_subgroupOf.mp h1)
  set d := Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) with hd
  have hVcard : Nat.card (↥C ⧸ (A.subgroupOf C)) = 2 ^ d := by
    have h1 : Nat.card (Additive (↥C ⧸ (A.subgroupOf C)))
        = 2 ^ Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) := by
      have h2 : Nat.card (Additive (↥C ⧸ (A.subgroupOf C)))
          = Nat.card (ZMod 2) ^ Module.finrank (ZMod 2) (Additive (↥C ⧸ (A.subgroupOf C))) :=
        Module.natCard_eq_pow_finrank
      rwa [Nat.card_zmod] at h2
    rw [hd, ← h1]
    exact (Nat.card_congr Additive.ofMul).symm
  -- the upper bound: `|C/A| ∣ |Ω₁(P)|`
  have hVdvd : Nat.card (↥C ⧸ (A.subgroupOf C)) ∣ Nat.card ↥(Work.Higman.omega1 P) :=
    card_quot_dvd_omega1_aux h hAxi hCinv hAC hCA hGs hcover hC2 hstep
  have hdle : d ≤ n := by
    have h1 : 2 ^ d ∣ 2 ^ n := by rw [← hVcard, ← hn]; exact hVdvd
    exact (Nat.pow_le_pow_iff_right (by norm_num)).mp (Nat.le_of_dvd (by positivity) h1)
  -- the orbit count on `C`
  have hCdiv : Nat.card ↥(Work.Higman.omega1 P) - 1 ∣ Nat.card ↥C - 1 :=
    Work.Higman.H8.card_sub_one_dvd_of_xi_invariant_xi h hCinv
  -- `|C| = |C/A| * |A| = 2 ^ (d + 2 * n)`
  have hCcard : Nat.card ↥C = 2 ^ (d + 2 * n) := by
    have h1 : Nat.card ↥C = Nat.card (↥C ⧸ (A.subgroupOf C)) * Nat.card ↥(A.subgroupOf C) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf C)
    have h2 : Nat.card ↥(A.subgroupOf C) = Nat.card ↥A :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAC)
    rw [h2, hcard, hVcard, hn] at h1
    rw [h1, ← pow_mul, ← pow_add]
    congr 1
    ring
  -- the lower bound: `n ∣ d`
  have hnd : n ∣ d := by
    have h1 : 2 ^ n - 1 ∣ 2 ^ (d + 2 * n) - 1 := by
      rw [← hn, ← hCcard]
      exact hCdiv
    have h2 : n ∣ d + 2 * n :=
      (Work.Higman.Q3.pow_sub_one_dvd_pow_sub_one_iff (x := 2) (m := n) (k := d + 2 * n)
        (by norm_num) (by omega)).mp h1
    have h3 : n ∣ 2 * n := ⟨2, by ring⟩
    have h4 : n ∣ d + 2 * n - 2 * n := Nat.dvd_sub h2 h3
    simpa using h4
  -- `d = n`
  have hdpos : 0 < d := by
    by_contra hc
    push Not at hc
    have h0 : d = 0 := by omega
    have h1 : Nat.card (↥C ⧸ (A.subgroupOf C)) = 1 := by rw [hVcard, h0]; norm_num
    have hsub : Subsingleton (↥C ⧸ (A.subgroupOf C)) := (Nat.card_eq_one_iff_unique.mp h1).1
    exact hex.choose_spec (Subsingleton.elim hex.choose 1)
  have hdn : d = n := le_antisymm hdle (Nat.le_of_dvd (by omega) hnd)
  rw [hVcard, hdn, hn]

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.card_C_eq_omega1_cube =====
section

namespace Work.Higman.HS

private theorem card_C_eq_omega1_cube {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A) (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) :
    Nat.card ↥C = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
  -- `η = ξ ^ (|Ω₁(P)| - 1)` acts trivially on `C/A`
  have hstep : ∀ x ∈ C, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A :=
    xi_pow_triv_quot_C_A h (A := A) (C := C) hAxi hAab hNA hCn hCinv hAC hCA hcover hCAd htop
  -- the index `[C : A]` equals `|Ω₁(P)|`
  have hquot : Nat.card (↥C ⧸ (A.subgroupOf C)) = Nat.card ↥(Work.Higman.omega1 P) :=
    card_quot_C_A_eq h (A := A) (C := C) hAxi hAab hNA hGs hsq hA4 htop hcard hCn hCinv hAC
      hCA hcover hC2 hCAd hstep
  -- `|C| = [C : A] * |A|`
  have hCcard : Nat.card ↥C
      = Nat.card (↥C ⧸ (A.subgroupOf C)) * Nat.card ↥(A.subgroupOf C) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf C)
  have hAcard : Nat.card ↥(A.subgroupOf C) = Nat.card ↥A :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAC)
  rw [hCcard, hAcard, hcard, hquot]
  ring

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.powSub_eq_of_deriv_eq =====
section

set_option autoImplicit false

namespace Work.Higman.HS

open scoped commutatorElement

/-- **In the `C₄` configuration with `⁅X,A⁆ = A²`, the square subgroup `X ^ (2)` equals `A ^ (2)`.**

`X ^ (2)` is `ξ`-invariant (`map_powSub`) and contained in `A`; by the dichotomy
`xi_inv_sub_dichotomy` it is `⊥`, `A²` or `A`.  The case `X ^ (2) = ⊥` would force
`⁅X,X⁆ ≤ X ^ (2) = ⊥`, contradicting `⁅X,X⁆ = A² ≠ ⊥`; and `X ^ (2) = A` would give
`⁅X,A⁆ ⊆ ⁅X ^ (2), X⁆ = ⊥` (every commutator of `X` is a central involution, hence
`⁅x²,y⁆ = ⁅x,⁅x,y⁆⁆ ⁅x,y⁆² = 1`), contradicting `⁅X,A⁆ = A² ≠ ⊥`. -/
private theorem powSub_eq_of_deriv_eq {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A X : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hX2 : Work.Higman.powSub X 2 ≤ A)
    (hXinv : X.map (h.xi : MulAut P).toMonoidHom = X)
    (hXd : ⁅X, X⁆ = Work.Higman.powSub A 2)
    (hXAd : ⁅X, A⁆ = Work.Higman.powSub A 2) :
    Work.Higman.powSub X 2 = Work.Higman.powSub A 2 := by
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
    have h2 := h.omega1_card_ge_four
    omega
  -- the derived subgroup of `X` is generated by squares of `X`: `⁅x,y⁆ = x² (x⁻¹ y)² (y²)⁻¹`
  have hcomm_le : ⁅X, X⁆ ≤ Work.Higman.powSub X 2 := by
    rw [Subgroup.commutator_le]
    intro x hx y hy
    have key : ⁅x, y⁆ = x ^ 2 * (x⁻¹ * y) ^ 2 * (y ^ 2)⁻¹ := by
      rw [commutatorElement_def, pow_two (a := x), pow_two (a := x⁻¹ * y), pow_two (a := y)]
      group
    rw [key]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Work.Higman.pow_mem_powSub hx)
      (Work.Higman.pow_mem_powSub (X.mul_mem (X.inv_mem hx) hy)))
      (Subgroup.inv_mem _ (Work.Higman.pow_mem_powSub hy))
  -- every commutator of `X` is a central involution
  have hcomm : ∀ c ∈ X, ∀ d ∈ X, ⁅c, d⁆ ^ 2 = 1 ∧ ⁅c, d⁆ ∈ Subgroup.center P := by
    intro c hc d hd
    have hmem : ⁅c, d⁆ ∈ Work.Higman.powSub A 2 := by
      rw [← hXd]; exact Subgroup.commutator_mem_commutator hc hd
    exact ⟨h.mem_omega1.mp (htop ▸ hmem), h.omega1_le_center (htop ▸ hmem)⟩
  -- `⁅c ^ 2, d⁆ = 1` for `c, d ∈ X`
  have hsq_comm : ∀ c ∈ X, ∀ d ∈ X, ⁅c ^ 2, d⁆ = 1 := by
    intro c hc d hd
    obtain ⟨h2, hcent⟩ := hcomm c hc d hd
    have h1 : ⁅c, ⁅c, d⁆⁆ = 1 := by
      rw [commutatorElement_eq_one_iff_mul_comm]
      exact Subgroup.mem_center_iff.mp hcent c
    rw [Work.Higman.commutatorElement_sq_self c d, h1, h2, one_mul]
  -- hence `⁅X ^ (2), X⁆ = ⊥`
  have hX2X : ⁅Work.Higman.powSub X 2, X⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro d hd
    have hle : Work.Higman.powSub X 2 ≤ Subgroup.centralizer ({d} : Set P) := by
      rw [Work.Higman.powSub, Subgroup.closure_le]
      intro y hy
      obtain ⟨c, hc, rfl⟩ := hy
      show c ^ 2 ∈ Subgroup.centralizer ({d} : Set P)
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact (commutatorElement_eq_one_iff_mul_comm.mp (hsq_comm c hc d hd)).symm
    exact (Subgroup.mem_centralizer_iff.mp (hle hx)) d rfl
  have hX2inv : (Work.Higman.powSub X 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub X 2 := Work.Higman.map_powSub _ hXinv 2
  rcases Work.Higman.HS.xi_inv_sub_dichotomy h hAab hAxi htop hA4 hX2 hX2inv with hb | hb | hb
  · exfalso
    rw [hb] at hcomm_le
    rw [le_bot_iff, hXd] at hcomm_le
    exact hA2ne hcomm_le
  · exact hb
  · exfalso
    have h1 : ⁅X, A⁆ = ⊥ := by
      rw [Subgroup.commutator_comm]
      rw [← hb]
      exact hX2X
    rw [hXAd] at h1
    exact hA2ne h1

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.cover_deriv_eq_A =====
section
/-
Copyright (c) 2024. All rights reserved.

# The two-step cover has derived subgroup `A` (`Work.Higman.HS.cover_deriv_eq_A`)

Let `P` be a Suzuki 2-group and suppose `A ≤ C ≤ M` are subgroups such that

* `A` is `ξ`-invariant abelian normal, `[P,P] = A`, `Ω₁(P) ≤ A`, all squares of `P` lie in `A`,
  `A⁴ = ⊥`, `A² = Ω₁(P)`, `|A| = |Ω₁(P)|²`, and `A` is maximal among the `ξ`-invariant abelian
  normal subgroups;
* `C` is a minimal `ξ`-invariant normal cover of `A`, with `C² ≤ A`, `[C,A] = A²` and
  `[C,C] = A²`;
* `M ≥ C` is any further `ξ`-invariant normal subgroup with `M ≠ C`.

Then `[M,M] = A`.

The proof.  `[M,M]` is normal and `ξ`-invariant with `A² = [C,C] ≤ [M,M] ≤ [P,P] = A`, so the
dichotomy `xi_inv_sub_dichotomy` gives `[M,M] = ⊥`, `[M,M] = A²` or `[M,M] = A`.  The first is
impossible because `A² = Ω₁(P) ≠ ⊥`.  If `[M,M] = A²` then also `[M,A] = A²` (squeezed between
`[C,A] = A²` and `[M,M] = A²`), so `powSub_eq_of_deriv_eq` gives `M² = A² = Ω₁(P)`; then
`M` satisfies the Chevalley–Warning hypotheses (`M² ≤ Ω₁(P)`, `[M,M] ≤ Ω₁(P)`), giving
`|M| ≤ |Ω₁(P)|³`, while the "`m = n` count" `card_quot_C_A_eq` gives `|C| = |Ω₁(P)|³`.  As
`C ≤ M` we get `|C| = |M|`, hence `M = C`, contradiction.  Therefore `[M,M] = A`.

The cardinality of `C` is the delegated fact `card_C_eq_omega1_cube` (from
`xi_pow_triv_quot_C_A` and `card_quot_C_A_eq`).
-/


set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.Higman.HS

open scoped commutatorElement

private theorem cover_deriv_eq_A {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C M : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A) (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hMn : M.Normal) (hMinv : M.map (h.xi : MulAut P).toMonoidHom = M)
    (hCM : C ≤ M) (hCMne : C ≠ M)
    (hMcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      C ≤ D → D ≤ M → D = C ∨ D = M) :
    ⁅M, M⁆ = A := by
  classical
  -- `A² = Ω₁(P) ≠ ⊥`
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
    have h4 := h.omega1_card_ge_four
    omega
  -- `[M,M]` is normal `ξ`-invariant with `A² ≤ [M,M] ≤ A`
  have hMMleA : ⁅M, M⁆ ≤ A := (Subgroup.commutator_mono le_top le_top).trans (le_of_eq hGs)
  have hMMinv : (⁅M, M⁆).map (h.xi : MulAut P).toMonoidHom = ⁅M, M⁆ := by
    rw [Subgroup.map_commutator, hMinv]
  have hA2leMM : Work.Higman.powSub A 2 ≤ ⁅M, M⁆ := by
    calc Work.Higman.powSub A 2 = ⁅C, C⁆ := hCd.symm
      _ ≤ ⁅M, M⁆ := Subgroup.commutator_mono hCM hCM
  -- the dichotomy
  rcases Work.Higman.HS.xi_inv_sub_dichotomy h hAab hAxi htop hA4 hMMleA hMMinv with hb | hb | hb
  · -- `[M,M] = ⊥` is impossible
    exact absurd (le_bot_iff.mp (hA2leMM.trans (le_of_eq hb))) hA2ne
  · -- `[M,M] = A²` would force `M = C`
    exfalso
    -- `[M,A] = A²`
    have hMAd : ⁅M, A⁆ = Work.Higman.powSub A 2 := by
      apply le_antisymm
      · calc ⁅M, A⁆ ≤ ⁅M, M⁆ := Subgroup.commutator_mono le_rfl (hAC.trans hCM)
          _ = Work.Higman.powSub A 2 := hb
      · calc Work.Higman.powSub A 2 = ⁅C, A⁆ := hCAd.symm
          _ ≤ ⁅M, A⁆ := Subgroup.commutator_mono hCM le_rfl
    -- `M² ≤ A`
    have hM2leA : Work.Higman.powSub M 2 ≤ A := by
      rw [Work.Higman.powSub, Subgroup.closure_le]
      rintro y ⟨x, -, rfl⟩
      exact hsq x
    -- `M² = A² = Ω₁(P)`
    have hM2eq : Work.Higman.powSub M 2 = Work.Higman.powSub A 2 :=
      powSub_eq_of_deriv_eq h hAab hAxi htop hA4 hM2leA hMinv hb hMAd
    -- Chevalley–Warning upper bound `|M| ≤ |Ω₁(P)|³`
    have hω_le_M : Work.Higman.omega1 P ≤ M :=
      htop ▸ ((Work.Higman.powSub_le (by norm_num)).trans (hAC.trans hCM))
    have hM2leω : Work.Higman.powSub M 2 ≤ Work.Higman.omega1 P := by rw [hM2eq, htop]
    have hMd_leω : ⁅M, M⁆ ≤ Work.Higman.omega1 P := by rw [hb, ← htop]
    have hMcard : Nat.card ↥M ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 :=
      Work.Higman.H8.card_le_cube_of_sq_le_omega1 h hω_le_M hM2leω hMd_leω
    -- and the exact count `|C| = |Ω₁(P)|³`
    have hCcard : Nat.card ↥C = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 :=
      card_C_eq_omega1_cube h hAxi hAab hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA hcover hC2 hCAd
    -- `C ≤ M` and `|C| = |M|` force `C = M`
    exact hCMne (Subgroup.eq_of_le_of_card_ge hCM (hMcard.trans (le_of_eq hCcard.symm)))
  · -- `[M,M] = A`
    exact hb

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.case_deriv_sq_false =====
section

open scoped commutatorElement

namespace Work.Higman.HS

variable {P : Type} [Group P] [Finite P]

/-- `⁅C,A⁆ ≤ A ^ (2)` in the `C₄` setting (using `⁅A,P⁆ = A ^ (2)`). -/
private theorem commutator_C_A_le (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hGA : ⁅A, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2) :
    (⁅C, A⁆ : Subgroup P) ≤ Work.Higman.powSub A 2 := by
  rw [Subgroup.commutator_comm]
  exact (Subgroup.commutator_mono le_rfl le_top).trans (le_of_eq hGA)

/-- `⁅C,A⁆` is `ξ`-invariant when `A` and `C` are. -/
private theorem map_xi_commutator_C_A (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) :
    (⁅C, A⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅C, A⁆ := by
  rw [Subgroup.map_commutator, hCinv, hAxi]

/-- **Case `⁅C,A⁆ = ⊥` of the `C₄` exclusion of the derived subgroup of square shape.**
`C` centralises `A`, so Gorenstein–Thompson (`H8.alt_pairing_false`) applies: the fourth power
map `C/A → Ω₁(P)` is onto a `ξ`-irreducible module, and the alternating `ξ`-equivariant
commutator pairing on `C/A` with values in `Ω₁(P)` has to be trivial, contradicting
`⁅C,C⁆ = A² ≠ ⊥`. -/
private theorem case_deriv_sq_false_central (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hZ : ∀ c ∈ C, ∀ a ∈ A, c * a = a * c) : False := by
  have hAn : A.Normal := normal_of_commutator_top_eq hGs
  have hA : Work.Higman.IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by
      rw [← htop, hb, Subgroup.card_bot]
    have h4 := h.omega1_card_ge_four
    omega
  have hexp : ∀ a ∈ A, a ^ 4 = 1 := by
    intro a ha
    have hmem : a ^ 4 ∈ Work.Higman.powSub A 4 := Work.Higman.pow_mem_powSub ha
    rw [hA4] at hmem
    simpa using hmem
  exact H8.alt_pairing_false h hA hCn hCinv hAC hCA.symm hcover hZ hC2 hCd htop.symm hA2ne hexp

/-- **`A` is a maximal abelian normal `ξ`-subgroup of `P` once `C_P(A) = A`.**

Any abelian subgroup `B ≥ A` lies in `C_P(A) = A`.  Consequently the hard case of
`case_deriv_sq_false` satisfies verbatim the hypotheses of `Work.Higman.no_square_of_maximal`
(the same obligation in the "maximality" formulation; that theorem's own proof is blocked on the
present case). -/
private theorem isMaxAbelianNormal_of_centralizer_eq_A {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hcent : Subgroup.centralizer (A : Set P) = A) :
    ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A := by
  intro B hB hAB
  have hBle : B ≤ Subgroup.centralizer (A : Set P) := by
    intro b hb
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact Work.Higman.IsXiAbelNormal.abelian hB a (hAB ha) b hb
  rw [hcent] at hBle
  exact le_antisymm hBle hAB

/-- **In the hard case `⁅C,A⁆ = A²`, `A` is a maximal abelian normal `ξ`-subgroup of `P`.**

This is `isMaxAbelianNormal_of_centralizer_eq_A` fed with
`Work.Higman.HS.centralizer_eq_A_of_comm_C_A`, which proves `C_P(A) = A` from the clean
`MSA.lemma8_clean`, `RedAux.deriv_eq_sq_false` and `RedAux.abelian_case`. -/
private theorem isMaxAbelianNormal_of_comm_C_A {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) :
    ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A :=
  isMaxAbelianNormal_of_centralizer_eq_A h
    (Work.Higman.HS.centralizer_eq_A_of_comm_C_A h hAxi hAab hNA hGs hsq hA4 htop hcard hCn hCinv
      hAC hcover hCAd)

private theorem case_deriv_sq_false {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P} (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hGA : ⁅A, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) : False := by
  classical
  -- `A ≠ A²` (from `|A| = |Ω₁(P)|²` and `4 ≤ |Ω₁(P)|`)
  have hAne2 : A ≠ Work.Higman.powSub A 2 := by
    intro heq
    have hc : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
      congrArg (fun X : Subgroup P => Nat.card ↥X) heq
    rw [htop] at hc
    have hq : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
      rw [← hcard, hc]
    have h4 := h.omega1_card_ge_four
    have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
    nlinarith [hq, h4, hpos]
  -- the dichotomy for `⁅C,A⁆`
  have hCAle : (⁅C, A⁆ : Subgroup P) ≤ A :=
    (commutator_C_A_le h hGA).trans (Work.Higman.powSub_le (by norm_num))
  have hCAinv : (⁅C, A⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅C, A⁆ :=
    map_xi_commutator_C_A h hAxi hCinv
  rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hCAle hCAinv with hbot | hmid | hAeq
  · -- Case `⁅C,A⁆ = ⊥`: Gorenstein–Thompson
    exact case_deriv_sq_false_central h hAxi hAab hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA
      hcover hC2 hCd (fun c hc a ha => by
        have h1 : (⁅c, a⁆ : P) ∈ (⊥ : Subgroup P) := by
          rw [← hbot]
          exact Subgroup.commutator_mem_commutator hc ha
        exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1))
  · -- Case `⁅C,A⁆ = A²`: the hard case (`C` is a minimal `ξ`-invariant normal cover of `A`,
    -- `⁅C,C⁆ = C² = A²`, `C_P(A) = A`, `A` maximal `ξ`-abelian normal, `Z(P) = A²`).
    --
    -- If `C = ⊤` then `[P,P] = [C,C] = A² ≠ A = [P,P]`, contradiction.  Otherwise pass to a
    -- minimal `ξ`-invariant normal `M` with `C < M ≤ P`; then `[M,M] ∈ {A², A}` and
    -- `[M,M] = A²` would force `|M| = |C| = |Ω₁(P)|³` (Chevalley–Warning + orbit counting),
    -- i.e. `M = C`; so `[M,M] = A`, which is excluded by the delegated lemma `hard_two_cover`.
    have hAn : A.Normal := normal_of_commutator_top_eq hGs
    haveI : A.Normal := hAn
    have hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A :=
      isMaxAbelianNormal_of_comm_C_A h hAxi hAab hNA hGs hsq hA4 htop hcard hCn hCinv hAC
        hcover hmid
    by_cases hCtop : C = ⊤
    · exact hAne2 (hGs.symm.trans (by rw [← hCtop]; exact hCd))
    · obtain ⟨M, hMn, hMinv, hCM, -, hCMne, hMcover⟩ :=
        Work.Higman.MSA.exists_minimal_covering h Subgroup.normal_top
          (Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective) le_top
          (fun hc => hCtop hc.symm)
      have hMd : ⁅M, M⁆ = A :=
        Work.Higman.HS.cover_deriv_eq_A h hAxi hAab hmax hNA hGs hsq hA4 htop hcard hCn hCinv
          hAC hCA hcover hC2 hmid hCd hMn hMinv hCM hCMne.symm hMcover
      exact Work.Higman.HS.hard_two_cover h hAxi hAab hmax hNA hGs hsq hA4 htop hcard hCn hCinv
        hAC hCA hcover hC2 hmid hCd hMn hMinv hCM hCMne.symm hMcover hMd
  · -- Case `⁅C,A⁆ = A`: impossible, since `⁅C,A⁆ ≤ A²` and `A ≠ A²`
    have hAle2 : A ≤ Work.Higman.powSub A 2 := by
      have h0 : (⁅C, A⁆ : Subgroup P) ≤ Work.Higman.powSub A 2 := commutator_C_A_le h hGA
      rwa [hAeq] at h0
    exact hAne2 (le_antisymm hAle2 (Work.Higman.powSub_le (by norm_num)))

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.case_deriv_sq_A2_false =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.Higman.HS

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-- In any group the derived subgroup of a subgroup is contained in the subgroup generated by its
squares: `⁅x,y⁆ = x² (x⁻¹ y)² (y²)⁻¹`. -/
private theorem commutator_le_powSub_two_aux (D : Subgroup P) : ⁅D, D⁆ ≤ Work.Higman.powSub D 2 := by
  rw [Subgroup.commutator_le]
  intro x hx y hy
  have key : ⁅x, y⁆ = x ^ 2 * (x⁻¹ * y) ^ 2 * (y ^ 2)⁻¹ := by
    rw [commutatorElement_def, pow_two (a := x), pow_two (a := x⁻¹ * y), pow_two (a := y)]
    group
  rw [key]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Work.Higman.pow_mem_powSub hx)
    (Work.Higman.pow_mem_powSub (D.mul_mem (D.inv_mem hx) hy)))
    (Subgroup.inv_mem _ (Work.Higman.pow_mem_powSub hy))

/-- **In the `C₄` configuration with `⁅C,A⁆ = A²`, the square `C ^ (2)` equals `A ^ (2)`.**

`C ^ (2)` is `ξ`-invariant and contained in `A`; by the dichotomy it is `⊥`, `A²` or `A`.
`C ^ (2) = ⊥` would give `⁅C,C⁆ ≤ C ^ (2) = ⊥`, contradicting `⁅C,C⁆ = A² ≠ ⊥`; and `C ^ (2) = A`
would give `⁅A,C⁆ ⊆ ⁅C ^ (2), C⁆ = ⊥` (every commutator `⁅c,d⁆` with `c, d ∈ C` is a central
involution, so `⁅c²,d⁆ = ⁅c,⁅c,d⁆⁆ ⁅c,d⁆² = 1`), contradicting `⁅C,A⁆ = A² ≠ ⊥`. -/
private theorem c4_C_sq_eq {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) :
    Work.Higman.powSub C 2 = Work.Higman.powSub A 2 := by
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
    have h2 := h.omega1_card_ge_four
    omega
  have hcomm : ∀ c ∈ C, ∀ d ∈ C, ⁅c, d⁆ ^ 2 = 1 ∧ ⁅c, d⁆ ∈ Subgroup.center P := by
    intro c hc d hd
    have hmem : ⁅c, d⁆ ∈ Work.Higman.powSub A 2 := by
      rw [← hCd]; exact Subgroup.commutator_mem_commutator hc hd
    exact ⟨h.mem_omega1.mp (htop ▸ hmem), h.omega1_le_center (htop ▸ hmem)⟩
  have hsq_comm : ∀ c ∈ C, ∀ d ∈ C, ⁅c ^ 2, d⁆ = 1 := by
    intro c hc d hd
    obtain ⟨h2, hcent⟩ := hcomm c hc d hd
    have h1 : ⁅c, ⁅c, d⁆⁆ = 1 := by
      rw [commutatorElement_eq_one_iff_mul_comm]
      exact Subgroup.mem_center_iff.mp hcent c
    rw [Work.Higman.commutatorElement_sq_self c d, h1, h2, one_mul]
  have hC2C : ⁅Work.Higman.powSub C 2, C⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro d hd
    have hle : Work.Higman.powSub C 2 ≤ Subgroup.centralizer ({d} : Set P) := by
      rw [Work.Higman.powSub, Subgroup.closure_le]
      intro y hy
      obtain ⟨c, hc, rfl⟩ := hy
      show c ^ 2 ∈ Subgroup.centralizer ({d} : Set P)
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact (commutatorElement_eq_one_iff_mul_comm.mp (hsq_comm c hc d hd)).symm
    exact (Subgroup.mem_centralizer_iff.mp (hle hx)) d rfl
  have hC2inv : (Work.Higman.powSub C 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub C 2 := Work.Higman.map_powSub _ hCinv 2
  rcases Work.Higman.HS.xi_inv_sub_dichotomy h hAab hAxi htop hA4 hC2 hC2inv with hb | hb | hb
  · exfalso
    have hle : ⁅C, C⁆ ≤ Work.Higman.powSub C 2 := commutator_le_powSub_two_aux C
    rw [hb] at hle
    rw [le_bot_iff, hCd] at hle
    exact hA2ne hle
  · exact hb
  · exfalso
    have h1 : ⁅C, A⁆ = ⊥ := by
      rw [Subgroup.commutator_comm]
      rw [← hb]
      exact hC2C
    rw [hCAd] at h1
    exact hA2ne h1

/-- **The `C₄` exclusion in the case `⁅C,A⁆ = A²`** (the remaining case of
`Work.Higman.HS.case_deriv_sq_false`).

The hypotheses are those of the gap case `Work.Higman.H8.c4_gap_false` of Higman's Lemma 8:
`|C| = q³` (Higman's Lemma 13 together with the orbit count) forces `C = P`, whence
`A = [P,P] = [C,C] = A²`.  The maximality of `A` is `Work.Higman.NSM.c4sqAMaximal` and the
square relation `C² = A²` is the clean lemma `c4_C_sq_eq` above. -/
private theorem case_deriv_sq_A2_false {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P} (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) : False := by
  haveI hAn : A.Normal := by
    rw [← hGs]; exact Subgroup.commutator_normal ⊤ ⊤
  have hA : Work.Higman.IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  have hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A :=
    Work.Higman.NSM.c4sqAMaximal h hAxi hAab hNA hGs hsq hA4 htop hcard
  have hC2A2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2 :=
    c4_C_sq_eq hAab hAxi htop hA4 hC2 hCinv hCd hCAd
  exact Work.Higman.H8.c4_gap_false h hA hmax hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA
    hcover hC2 hC2A2 hCd

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.RedAux.step2_eta_triv =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.style.longLine false
set_option maxHeartbeats 1000000

open scoped commutatorElement

namespace Work.Higman.RedAux

variable {P : Type} [Group P] [Finite P]

/-- **`ξ ^ (|Ω₁(P)| - 1)` acts trivially on `P/A`** in the `C₄` configuration.

`P` is a Suzuki 2-group, `A ⊴ P` is `ξ`-invariant abelian and maximal among such (`hmax`) with
`Ω₁(P) ≤ A`, `⁅P,P⁆ = A`, every square of `P` in `A`, `A ^ (4) = ⊥`, `A ^ (2) = Ω₁(P)` and
`|A| = |Ω₁(P)|²`.  Then `η := ξ ^ (|Ω₁(P)| - 1)` fixes `P/A` pointwise, i.e. `η x · x⁻¹ ∈ A`. -/
private theorem xi_pow_triv_quot_full (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hA : IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : powSub A 4 = ⊥)
    (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2) :
    ∀ x : P, (h.xi ^ (Nat.card ↥(omega1 P) - 1)) x * x⁻¹ ∈ A := by
  classical
  haveI hAn : A.Normal := hA.normal
  have hAab := hA.abelian
  have hAne : A ≠ powSub A 2 := ne_powSub_two_of_card h htop hcard
  -- `Z(P) = Ω₁(P) = A²`
  have hZ : Subgroup.center P = omega1 P := center_eq_omega1_new h
  have hA2cent : powSub A 2 ≤ Subgroup.center P := by rw [htop]; exact h.omega1_le_center
  have hAZ : ¬ A ≤ Subgroup.center P := by
    intro hle
    have h1 : A ≤ powSub A 2 := by rw [htop, ← hZ]; exact hle
    exact hAne (le_antisymm h1 (powSub_le (by norm_num)))
  have hcent : Subgroup.centralizer (A : Set P) = A :=
    MSA.centralizer_eq_self h hA hmax hNA hGs hsq hA4 htop hcard hAZ
  -- `⁅A, ⊤⁆ = A²`
  have hAP : ⁅A, (⊤ : Subgroup P)⁆ = powSub A 2 := by
    rcases H8.Clean.nsd_comm_eq_bot_or_omega1 h hA.map_eq hAab hGs htop with hb | hb
    · exact absurd hb (H8.Clean.nsd_comm_eq_bot_false h hAab hNA hGs hsq htop)
    · rw [hb, htop]
  -- (1) every `⁅x,a⁆` with `a ∈ A` lies in `A²`
  have hmem2 : ∀ x : P, ∀ a ∈ A, ⁅x, a⁆ ∈ powSub A 2 := by
    intro x a ha
    have h1 : ⁅x, a⁆ ∈ ⁅(⊤ : Subgroup P), A⁆ :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top x) ha
    have h2 : ⁅(⊤ : Subgroup P), A⁆ = powSub A 2 := by
      rw [Subgroup.commutator_comm]; exact hAP
    rwa [h2] at h1
  -- (2) `χ` is injective: an element commuting with `A` lies in `A`
  have hker : ∀ x : P, (∀ a ∈ A, ⁅x, a⁆ = 1) → x ∈ A := by
    intro x hx
    have h1 : x ∈ Subgroup.centralizer (A : Set P) := by
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      have h2 : ⁅x, a⁆ = 1 := hx a ha
      have h3 : x * a = a * x := by
        rw [commutatorElement_def] at h2
        calc x * a = x * a * x⁻¹ * a⁻¹ * (a * x) := by group
          _ = 1 * (a * x) := by rw [h2]
          _ = a * x := one_mul _
      exact h3.symm
    rwa [hcent] at h1
  -- (3) `η := ξ ^ k` fixes `Ω₁(P)` pointwise, and moves `A` only modulo `A²`
  set k : ℕ := Nat.card ↥(omega1 P) - 1 with hk
  have hηΩ : ∀ w ∈ omega1 P, (h.xi ^ k) w = w := by
    intro w hw; rw [hk]; exact HS.xi_pow_card_sub_one_fixes_omega1 h w hw
  have hηA : ∀ a ∈ A, (h.xi ^ k) a * a⁻¹ ∈ powSub A 2 := by
    intro a ha
    have h2 : ((h.xi ^ k) a) ^ 2 = a ^ 2 := by
      have h3 : ((h.xi ^ k) a) ^ 2 = (h.xi ^ k) (a ^ 2) := by
        rw [pow_two, pow_two, map_mul]
      rw [h3]
      exact hηΩ (a ^ 2) (by rw [← htop]; exact pow_mem_powSub (n := 2) ha)
    have hc : Commute ((h.xi ^ k) a) a⁻¹ :=
      hAab ((h.xi ^ k) a) (HS.mem_of_pow_map_eq hA.map_eq k ha) a⁻¹ (A.inv_mem ha)
    have hsq1 : ((h.xi ^ k) a * a⁻¹) ^ 2 = 1 := by
      rw [hc.mul_pow 2, h2]
      group
    have hΩ : (h.xi ^ k) a * a⁻¹ ∈ omega1 P := h.mem_omega1.mpr hsq1
    rwa [← htop] at hΩ
  -- (4) `χ (η x) = χ x`
  have hχ : ∀ x : P, ∀ a ∈ A, ⁅(h.xi ^ k) x, a⁆ = ⁅x, a⁆ := by
    intro x a ha
    -- `η⁻¹ a = a * z` with `z ∈ A²`
    obtain ⟨z, hz2, hz⟩ : ∃ z ∈ powSub A 2, ((h.xi ^ k).symm) a = a * z := by
      have hmemA : ((h.xi ^ k).symm) a ∈ A :=
        symm_mem_of_map_eq (h.xi ^ k : MulAut P) (map_pow_xi_eq h hA.map_eq k) ha
      have h1 := hηA (((h.xi ^ k).symm) a) hmemA
      rw [show (h.xi ^ k) (((h.xi ^ k).symm) a) = a from MulEquiv.apply_symm_apply _ _] at h1
      refine ⟨a⁻¹ * ((h.xi ^ k).symm) a, ?_, ?_⟩
      · have h2 : a⁻¹ * ((h.xi ^ k).symm) a = (a * (((h.xi ^ k).symm) a)⁻¹)⁻¹ := by
          rw [mul_inv_rev, inv_inv]
          exact hAab a⁻¹ (A.inv_mem ha) (((h.xi ^ k).symm) a) hmemA
        rw [h2]
        exact Subgroup.inv_mem _ h1
      · rw [← mul_assoc, mul_inv_cancel, one_mul]
    have hzcen : z ∈ Subgroup.center P := hA2cent hz2
    have h4 : ⁅x, ((h.xi ^ k).symm) a⁆ = ⁅x, a⁆ := by
      rw [hz, commutator_mul_central_right hzcen x a]
    have h5 : ⁅(h.xi ^ k) x, a⁆ = (h.xi ^ k) (⁅x, ((h.xi ^ k).symm) a⁆) := by
      simp only [commutatorElement_def, map_mul, map_inv, MulEquiv.apply_symm_apply]
    rw [h5, h4]
    have hmem : ⁅x, a⁆ ∈ omega1 P := by rw [← htop]; exact hmem2 x a ha
    exact hηΩ _ hmem

  -- conclude
  intro x
  refine hker _ (fun a ha => ?_)
  have hx2 : ⁅x, a⁆ ^ 2 = 1 := h.mem_omega1.mp (by rw [← htop]; exact hmem2 x a ha)
  have h3 : ⁅x⁻¹, a⁆ = ⁅x, a⁆⁻¹ := by
    have hc : ⁅x, a⁆ ∈ Subgroup.center P := hA2cent (hmem2 x a ha)
    have h1 : ⁅x⁻¹ * x, a⁆ = ⁅x, a⁆ * ⁅x⁻¹, a⁆ :=
      commutator_mul_of_central (hA2cent (hmem2 x a ha))
    rw [inv_mul_cancel] at h1
    have h2 : ⁅x, a⁆ * ⁅x⁻¹, a⁆ = 1 := by
      rw [← h1]
      simp [commutatorElement_def]
    have h2' : ⁅x⁻¹, a⁆ * ⁅x, a⁆ = 1 := by
      rw [Subgroup.mem_center_iff.mp hc ⁅x⁻¹, a⁆, h2]
    exact eq_inv_of_mul_eq_one_left h2'
  have h2 : ⁅(h.xi ^ k) x * x⁻¹, a⁆ = ⁅x⁻¹, a⁆ * ⁅(h.xi ^ k) x, a⁆ :=
    commutator_mul_of_central (hA2cent (hmem2 x⁻¹ a ha))
  rw [h2, hχ x a ha, h3, inv_mul_cancel]

end Work.Higman.RedAux
end

-- ===== from Submission.Work.Higman.HS.two_cover_of_residual =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

open scoped commutatorElement

namespace Work.Higman.HS

/-- **The two-cover configuration exists in the residual `C₄` case.**

Let `A ⊴ P` be a maximal `ξ`-invariant abelian normal subgroup of a Suzuki 2-group `P` with
`Ω₁(P) ≤ A`, `[P,P] = A`, all squares of `P` in `A`, `A⁴ = ⊥`, `A² = Ω₁(P)`,
`|A| = |Ω₁(P)|²`, and `[A,⊤] = A²`; let `C ⊴ P` be `ξ`-invariant with `A < C`,
`[C,A] = A²`, `[C,C] = A²`, `[C,⊤] = A`, `C` minimal over `A` and maximal below `⊤`
(`hcover`, `hMcover`, `C ≠ ⊤`), and `C_P(A) = A`.

Then there is a `ξ`-invariant normal complement `E` of `C` over `A` with all the two-cover
properties: `A < E`, `E` minimal over `A`, `C ⊓ E = A`, `C ⊔ E = ⊤`, `[C,E] = A` and
`[E,E] = [E,A] = A²`.

Construction: `ξ ^ (|Ω₁(P)| - 1)` acts trivially on `P/A` (`RedAux.xi_pow_triv_quot_full`), so
Maschke over `𝔽₂` (`RedAux.invariant_compl_subgroup`) supplies a `ξ`-invariant complement `N`
of `C` modulo `A`; `[P,P] = A ≤ N` makes `N` normal.  A minimal `ξ`-invariant normal `E` with
`A < E ≤ N` is the required cover: `E/A` is `ξ`-irreducible, `[E,E] ∈ {⊥, A², A}` by the
dichotomy, `⊥` is excluded by maximality of `A` and `= A` is excluded by Higman's Lemma 8
(`MSA.lemma8_clean`, which would force `A ≤ Ω₁(P) = A²` and contradict `|A| = |Ω₁(P)|²`). -/
private theorem two_cover_of_residual {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) (⊤ : Subgroup P) = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hAP : Bracket.bracket A (⊤ : Subgroup P) = Work.Higman.powSub A 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C) (hCne : C ≠ ⊤)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCAd : Bracket.bracket C A = Work.Higman.powSub A 2)
    (hCd : Bracket.bracket C C = Work.Higman.powSub A 2)
    (hMcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      C ≤ D → D = C ∨ D = ⊤)
    (hCT : Bracket.bracket C (⊤ : Subgroup P) = A) :
    ∃ E : Subgroup P, E.Normal ∧ E.map (h.xi : MulAut P).toMonoidHom = E ∧ A ≤ E ∧ A ≠ E ∧
      (∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
        A ≤ D → D ≤ E → D = A ∨ D = E) ∧
      Bracket.bracket C E = A ∧ C ⊓ E = A ∧ C ⊔ E = ⊤ ∧
      Bracket.bracket E E = Work.Higman.powSub A 2 ∧
      Bracket.bracket E A = Work.Higman.powSub A 2 := by
  classical
  -- ## 0. `A = A²` is contradictory
  have hcontra : A = Work.Higman.powSub A 2 → False := by
    intro hAeq
    obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
    have heq : Nat.card ↥(Work.Higman.omega1 P) = Nat.card ↥A := by
      rw [← htop, ← hAeq]
    have h2sq : Nat.card ↥A = (Nat.card ↥A) ^ 2 := by
      calc Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := hcard
        _ = (Nat.card ↥A) ^ 2 := by rw [heq]
    have hne : Nat.card ↥A ≠ 0 := by rw [← heq, hn]; exact pow_ne_zero n (by norm_num)
    have hmul : Nat.card ↥A * 1 = Nat.card ↥A * Nat.card ↥A := by
      simpa [pow_two] using h2sq
    have hk : Nat.card ↥A = 1 := (Nat.mul_left_cancel (Nat.pos_of_ne_zero hne) hmul).symm
    have hq1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [heq, hk]
    have hfour := h.omega1_card_ge_four
    omega
  -- ## 1. every commutator lies in `A`
  have hAb : ∀ x y : P, x * y * x⁻¹ * y⁻¹ ∈ A := by
    intro x y
    have h1 : ⁅x, y⁆ ∈ ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
    rw [hGs] at h1
    simpa [commutatorElement_def] using h1
  -- ## 2. the Maschke complement
  obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
  have hn2 : 2 ≤ n := by
    have hfour := h.omega1_card_ge_four
    rw [hn] at hfour
    by_contra hcon
    have hcon' : n ≤ 1 := by omega
    have h2 : 2 ^ n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) hcon'
    omega
  have hodd : Odd (Nat.card ↥(Work.Higman.omega1 P) - 1) := by
    rw [hn]
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    exact ⟨2 ^ m - 1, by
      have h1 : 1 ≤ 2 ^ m := Nat.one_le_two_pow
      rw [pow_succ]; omega⟩
  have he1 : ∀ x : P, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A :=
    Work.Higman.RedAux.xi_pow_triv_quot_full h hA hmax hNA hGs hsq hA4 htop hcard
  obtain ⟨N, hAN, hNinv, hNinf, hNsup⟩ :=
    Work.Higman.RedAux.invariant_compl_subgroup h.xi hA.normal hA.map_eq hAC hCinv hAb hsq
      hodd he1
  -- ## 3. `N` is normal
  have hNnormal : N.Normal := by
    refine ⟨fun x hx g => ?_⟩
    have h1 : ⁅g, x⁆ ∈ A := by
      have h2 : ⁅g, x⁆ ∈ ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ :=
        Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top x)
      rwa [hGs] at h2
    have h3 : g * x * g⁻¹ = ⁅g, x⁆ * x := by rw [commutatorElement_def]; group
    rw [h3]
    exact N.mul_mem (hAN h1) hx
  -- ## 4. `A < N`
  have hANlt : A < N := by
    refine lt_of_le_of_ne hAN (fun hEq => hCne ?_)
    have h1 : A ⊔ C = ⊤ := by rw [← hNsup, hEq]
    rwa [sup_eq_right.mpr hAC] at h1
  -- ## 5. a minimal `ξ`-invariant normal `E` with `A < E ≤ N`
  have hfin : ({E : Subgroup P | A < E ∧ E ≤ N ∧ E.Normal ∧
      E.map (h.xi : MulAut P).toMonoidHom = E} : Set (Subgroup P)).Finite :=
    Set.finite_univ.subset (fun _ _ => trivial)
  obtain ⟨E, hEmin⟩ :=
    hfin.exists_minimal ⟨N, hANlt, le_rfl, hNnormal, hNinv⟩
  obtain ⟨hElt, hEN, hENormal, hEinv⟩ := hEmin.1
  have hEmin' : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ E → D = A ∨ D = E := by
    intro D hDn hDinv hAD hDE
    by_cases hDA : D = A
    · exact Or.inl hDA
    · refine Or.inr ?_
      have hDlt : A < D := lt_of_le_of_ne hAD (Ne.symm hDA)
      have hDmem : D ∈ ({E : Subgroup P | A < E ∧ E ≤ N ∧ E.Normal ∧
          E.map (h.xi : MulAut P).toMonoidHom = E} : Set (Subgroup P)) :=
        ⟨hDlt, hDE.trans hEN, hDn, hDinv⟩
      exact le_antisymm hDE (hEmin.2 hDmem hDE)
  have hAEl : A ≤ E := le_of_lt hElt
  have hEAne : A ≠ E := ne_of_lt hElt
  have hEAneE : E ≠ A := Ne.symm hEAne
  -- ## 6. the two-cover identities
  have hEinfC : E ⊓ C = A := by
    refine le_antisymm ?_ ?_
    · intro x hx
      rw [Subgroup.mem_inf] at hx
      have h1 : x ∈ N ⊓ C := ⟨hEN hx.1, hx.2⟩
      rwa [hNinf] at h1
    · intro x hx
      exact ⟨hAEl hx, hAC hx⟩
  haveI hEi : E.Normal := hENormal
  haveI hCi : C.Normal := hCn
  have hEsupC : E ⊔ C = ⊤ := by
    have hsupinv : (E ⊔ C).map (h.xi : MulAut P).toMonoidHom = E ⊔ C := by
      rw [Subgroup.map_sup, hEinv, hCinv]
    rcases hMcover (E ⊔ C) inferInstance hsupinv le_sup_right with h1 | h1
    · exfalso
      have hEC : E ≤ C := le_sup_left.trans (le_of_eq h1)
      have hEA : E ≤ A := by
        rw [← hEinfC]
        exact le_inf le_rfl hEC
      exact hEAneE (le_antisymm hEA hAEl)
    · exact h1
  -- ## 7. `[E,E] = A²`
  have hEE_le_A : Bracket.bracket E E ≤ A := by
    have h1 : Bracket.bracket E E ≤ Bracket.bracket (⊤ : Subgroup P) (⊤ : Subgroup P) :=
      Subgroup.commutator_mono le_top le_top
    rwa [hGs] at h1
  have hEE_inv : (Bracket.bracket E E).map (h.xi : MulAut P).toMonoidHom =
      Bracket.bracket E E := by
    rw [Subgroup.map_commutator, hEinv]
  have hE2 : Work.Higman.powSub E 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  have hEd : Bracket.bracket E E = Work.Higman.powSub A 2 := by
    rcases xi_inv_sub_dichotomy h hA.abelian hA.map_eq htop hA4 hEE_le_A hEE_inv with
      hb | h2 | h3
    · exfalso
      have hEab : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x := by
        intro x hx y hy
        have h1 : ⁅x, y⁆ ∈ (⊥ : Subgroup P) := by
          rw [← hb]
          exact Subgroup.commutator_mem_commutator hx hy
        exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1)
      exact hEAneE (hmax E ⟨hENormal, hEinv, hEab⟩ hAEl)
    · exact h2
    · exfalso
      have h1 : ∀ a ∈ A, a * a = 1 :=
        MSA.lemma8_clean h hA hENormal hEinv hAEl hEAne hEmin' hE2 h3
      have hAle : A ≤ Work.Higman.omega1 P := by
        intro a ha
        rw [h.mem_omega1]
        simpa [pow_two] using h1 a ha
      have hAeq : A = Work.Higman.powSub A 2 := by
        rw [htop]
        exact le_antisymm hAle hNA
      exact hcontra hAeq
  -- ## 8. `[C,E] = A`
  have hCE : Bracket.bracket C E = A := by
    have hCE_le : Bracket.bracket C E ≤ A := by
      have h1 : Bracket.bracket C E ≤ Bracket.bracket (⊤ : Subgroup P) (⊤ : Subgroup P) :=
        Subgroup.commutator_mono le_top le_top
      rwa [hGs] at h1
    have hCE_inv : (Bracket.bracket C E).map (h.xi : MulAut P).toMonoidHom =
        Bracket.bracket C E := by
      rw [Subgroup.map_commutator, hCinv, hEinv]
    have hkey : A ≤ Bracket.bracket C E ⊔ Work.Higman.powSub A 2 := by
      have h1 : Bracket.bracket C E ⊔ Bracket.bracket C C =
          Bracket.bracket C (⊤ : Subgroup P) := by
        rw [← hEsupC, Subgroup.commutator_sup_left C E C]
      rw [← hCd, h1, hCT]
    rcases xi_inv_sub_dichotomy h hA.abelian hA.map_eq htop hA4 hCE_le hCE_inv with
      hb | h2 | h3
    · exfalso
      have h1 : A ≤ Work.Higman.powSub A 2 := by simpa [hb] using hkey
      exact hcontra (le_antisymm h1 (Work.Higman.powSub_le (by norm_num)))
    · exfalso
      have h1 : A ≤ Work.Higman.powSub A 2 := by simpa [h2] using hkey
      exact hcontra (le_antisymm h1 (Work.Higman.powSub_le (by norm_num)))
    · exact h3
  -- ## 9. `[E,A] = A²`
  have hEA : Bracket.bracket E A = Work.Higman.powSub A 2 := by
    have hEA_le : Bracket.bracket E A ≤ Work.Higman.powSub A 2 := by
      have h1 : Bracket.bracket E A ≤ Bracket.bracket (⊤ : Subgroup P) A :=
        Subgroup.commutator_mono le_top le_rfl
      have h2 : Bracket.bracket (⊤ : Subgroup P) A = Bracket.bracket A (⊤ : Subgroup P) :=
        Subgroup.commutator_comm _ _
      rw [h2, hAP] at h1
      exact h1
    have hEA_inv : (Bracket.bracket E A).map (h.xi : MulAut P).toMonoidHom =
        Bracket.bracket E A := by
      rw [Subgroup.map_commutator, hEinv, hA.map_eq]
    have hne : Bracket.bracket E A ≠ ⊥ := by
      intro hb
      have hAE : Bracket.bracket A E = ⊥ := (Subgroup.commutator_comm A E).trans hb
      have hle : E ≤ Subgroup.centralizer (A : Set P) := by
        intro e he
        rw [Subgroup.mem_centralizer_iff]
        intro a ha
        have h1 : ⁅a, e⁆ ∈ (⊥ : Subgroup P) := by
          rw [← hAE]
          exact Subgroup.commutator_mem_commutator ha he
        exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1)
      rw [hcent] at hle
      exact hEAneE (le_antisymm hle hAEl)
    have hEA_leA : Bracket.bracket E A ≤ A := hEA_le.trans (Work.Higman.powSub_le (by norm_num))
    rcases xi_inv_sub_dichotomy h hA.abelian hA.map_eq htop hA4 hEA_leA hEA_inv with
      hb | h2 | h3
    · exact absurd hb hne
    · exact h2
    · exfalso
      have h1 : A ≤ Work.Higman.powSub A 2 := h3.ge.trans hEA_le
      exact hcontra (le_antisymm h1 (Work.Higman.powSub_le (by norm_num)))
  exact ⟨E, hENormal, hEinv, hAEl, hEAne, hEmin', hCE, (inf_comm C E).trans hEinfC,
    (sup_comm C E).trans hEsupC, hEd, hEA⟩

end Work.Higman.HS
end

