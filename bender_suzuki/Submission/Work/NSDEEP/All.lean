private theorem bracket_mul_central (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : powSub A 2 = omega1 P)
    (u : P) {a z : P} (ha : a ∈ A) (hz : z ∈ powSub A 2) :
    ⁅u, a * z⁆ = ⁅u, a⁆ := by
  have h1 : ⁅u, a * z⁆ = ⁅u, a⁆ * (a * ⁅u, z⁆ * a⁻¹) := H8.Clean.commutator_mul_right_eq u a z
  have huz : ⁅u, z⁆ = 1 := by
    rw [commutatorElement_def, aux_conj_eq h htop z hz u]
    group
  rw [h1, huz]
  group

/-- `(u * a) ^ 4 = u ^ 4` for `a ∈ A`. -/
private theorem pow4_congr (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (htop : powSub A 2 = omega1 P)
    (u : P) {a : P} (ha : a ∈ A) : (u * a) ^ 4 = u ^ 4 :=
  aux_sq4 h hAxi hAab hGs hsq htop u ha

/-- `⁅u * a, v * b⁆ ^ 2 = ⁅u, v⁆ ^ 2` for `a, b ∈ A`. -/
private theorem comm_sq_congr (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : powSub A 2 = omega1 P)
    (u v : P) {a b : P} (ha : a ∈ A) (hb : b ∈ A) :
    ⁅u * a, v * b⁆ ^ 2 = ⁅u, v⁆ ^ 2 := by
  have h1 : ⁅u * a, v * b⁆ * ⁅u, v⁆⁻¹ ∈ powSub A 2 := aux_comm_sq h hAxi hAab hGs htop u v ha hb
  have hwA : ⁅u * a, v * b⁆ * ⁅u, v⁆⁻¹ ∈ A := powSub_le (by norm_num) h1
  have hvu : ⁅u, v⁆ ∈ A := aux_comm_mem h hGs u v
  have h2 : ⁅u * a, v * b⁆ = (⁅u * a, v * b⁆ * ⁅u, v⁆⁻¹) * ⁅u, v⁆ := by group
  have h3 : (⁅u * a, v * b⁆ * ⁅u, v⁆⁻¹) * (⁅u * a, v * b⁆ * ⁅u, v⁆⁻¹) = 1 := by
    have h' : (⁅u * a, v * b⁆ * ⁅u, v⁆⁻¹) ^ 2 = 1 := h.mem_omega1.mp (by rw [← htop]; exact h1)
    rwa [pow_two] at h'
  rw [h2, pow_two, sq_mul_of_abelian hAab hwA hvu, h3, one_mul, pow_two]

/-! ## Biadditivity of the two pairings -/

/-- `⁅u * v, a⁆ = ⁅u, a⁆ * ⁅v, a⁆` for `a ∈ A`. -/
private theorem bracket_mul_omega (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : powSub A 2 = omega1 P)
    (u v : P) {a : P} (ha : a ∈ A) : ⁅u * v, a⁆ = ⁅u, a⁆ * ⁅v, a⁆ := by
  have hua : ⁅u, a⁆ ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs u ha
  have hva : ⁅v, a⁆ ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs v ha
  have h1 : ⁅u * v, a⁆ = (u * ⁅v, a⁆ * u⁻¹) * ⁅u, a⁆ := H8.Clean.commutator_mul_left_eq u v a
  rw [h1, aux_conj_eq h htop ⁅v, a⁆ hva u]
  exact hAab ⁅v, a⁆ (powSub_le (by norm_num) hva) ⁅u, a⁆ (powSub_le (by norm_num) hua)

/-- `(⁅u * v, w⁆) ^ 2 = (⁅u, w⁆) ^ 2 * (⁅v, w⁆) ^ 2`. -/
private theorem comm_sq_mul_left (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : powSub A 2 = omega1 P)
    (u v w : P) : (⁅u * v, w⁆) ^ 2 = (⁅u, w⁆) ^ 2 * (⁅v, w⁆) ^ 2 := by
  have hvw : ⁅v, w⁆ ∈ A := aux_comm_mem h hGs v w
  have huw : ⁅u, w⁆ ∈ A := aux_comm_mem h hGs u w
  set X : P := ⁅u, ⁅v, w⁆⁆ with hXdef
  set Y : P := ⁅v, w⁆ * ⁅u, w⁆ with hYdef
  have hX : X ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs u hvw
  have hX1 : X * X = 1 := by
    have h' : X ^ 2 = 1 := h.mem_omega1.mp (by rw [← htop]; exact hX)
    rwa [pow_two] at h'
  have hXY : ∀ Z : P, Z * X = X * Z := by
    intro Z
    have h2 := aux_conj_eq h htop X hX Z
    calc Z * X = Z * X * Z⁻¹ * Z := by group
      _ = X * Z := by rw [h2]
  have hY : Y ∈ A := A.mul_mem hvw huw
  have h1 : ⁅u * v, w⁆ = X * Y := by
    rw [hXdef, hYdef]
    rw [commutatorElement_def]
    rw [show u * v * w * (u * v)⁻¹ * w⁻¹ = u * (v * w * v⁻¹) * u⁻¹ * w⁻¹ from by group]
    rw [show v * w * v⁻¹ = ⁅v, w⁆ * w from by rw [commutatorElement_def]; group]
    rw [show u * (⁅v, w⁆ * w) * u⁻¹ * w⁻¹
        = (u * ⁅v, w⁆ * u⁻¹) * (u * w * u⁻¹ * w⁻¹) from by group]
    rw [show u * ⁅v, w⁆ * u⁻¹ = ⁅u, ⁅v, w⁆⁆ * ⁅v, w⁆ from by
      rw [commutatorElement_def]; group]
    rw [show u * w * u⁻¹ * w⁻¹ = ⁅u, w⁆ from rfl]
    group
  have h2 : Y * Y = (⁅u, w⁆ * ⁅u, w⁆) * (⁅v, w⁆ * ⁅v, w⁆) := by
    rw [hYdef, sq_mul_of_abelian hAab hvw huw]
    exact hAab (⁅v, w⁆ * ⁅v, w⁆) (A.mul_mem hvw hvw)
      (⁅u, w⁆ * ⁅u, w⁆) (A.mul_mem huw huw)
  have h3 : (X * Y) * (X * Y) = (⁅u, w⁆ ^ 2) * (⁅v, w⁆ ^ 2) := by
    calc (X * Y) * (X * Y) = X * (Y * X) * Y := by group
      _ = X * (X * Y) * Y := by rw [hXY Y]
      _ = (X * X) * (Y * Y) := by group
      _ = Y * Y := by rw [hX1, one_mul]
      _ = (⁅u, w⁆ ^ 2) * (⁅v, w⁆ ^ 2) := by rw [h2, pow_two, pow_two]
  rw [h1]
  rw [show (X * Y) ^ 2 = (X * Y) * (X * Y) from pow_two _]
  exact h3

/-- `(⁅u, v * w⁆) ^ 2 = (⁅u, v⁆) ^ 2 * (⁅u, w⁆) ^ 2`. -/
private theorem comm_sq_mul_right (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : powSub A 2 = omega1 P)
    (u v w : P) : (⁅u, v * w⁆) ^ 2 = (⁅u, v⁆) ^ 2 * (⁅u, w⁆) ^ 2 := by
  have hw : ⁅u, w⁆ ∈ A := aux_comm_mem h hGs u w
  have hv : ⁅u, v⁆ ∈ A := aux_comm_mem h hGs u v
  have hX : v * ⁅u, w⁆ * v⁻¹ ∈ A := by
    haveI hAn : A.Normal := aux_Anormal h hGs
    exact hAn.conj_mem ⁅u, w⁆ hw v
  have h2 : (v * ⁅u, w⁆ * v⁻¹) * (v * ⁅u, w⁆ * v⁻¹) = ⁅u, w⁆ * ⁅u, w⁆ := by
    rw [show v * ⁅u, w⁆ * v⁻¹ * (v * ⁅u, w⁆ * v⁻¹) = v * (⁅u, w⁆ * ⁅u, w⁆) * v⁻¹ from by
      group]
    exact aux_conj_eq h htop (⁅u, w⁆ * ⁅u, w⁆) (by rw [← pow_two]; exact pow_mem_powSub hw) v
  have h1 : ⁅u, v * w⁆ = ⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹) := H8.Clean.commutator_mul_right_eq u v w
  have h3 : (⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹)) ^ 2 = (⁅u, v⁆) ^ 2 * (⁅u, w⁆) ^ 2 := by
    have h4 : (⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹)) * (⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹))
        = (⁅u, v⁆ * ⁅u, v⁆) * (⁅u, w⁆ * ⁅u, w⁆) := by
      rw [sq_mul_of_abelian hAab hv hX, h2]
    rw [show (⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹)) ^ 2
        = (⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹)) * (⁅u, v⁆ * (v * ⁅u, w⁆ * v⁻¹)) from pow_two _, h4,
      pow_two, pow_two]
  rw [h1, h3]

end Work.Higman
end

-- ===== from Submission.Work.Higman.HS.c4_hs_aux =====
section
/-
Copyright (c) 2024. All rights reserved.

# The `C₄` exclusion of the derived subgroup (`Work.Higman.HS.c4_exclusion_hs`)

Higman, *Suzuki 2-groups*, Illinois J. Math. 7 (1963), 79--96: a Suzuki 2-group has no
`ξ`-invariant abelian normal subgroup `A` with `[P,P] = A`, `A² = Ω₁(P)`, `A⁴ = 1` and
`|A| = |Ω₁(P)|²`.

The reduction is complete and unconditional (see `NOTES_c4_hs.md` for the exact remaining work
and for a full proof of the `m = n` step, i.e. of `|C/A| = |Ω₁(P)|` for a cover with `C' = A`):

* `[A,P]` is `ξ`-invariant `≤ A`, hence `⊥`, `A²` or `A` (`xi_inv_sub_dichotomy`);
* `[A,P] = ⊥` is impossible (`comm_bot_false`), `[A,P] = A` is impossible (`comm_self_false`);
* for `[A,P] = A²` one takes a minimal cover `C` of `A` (`exists_minimal_cover`), splits
  `[C,C] ∈ {⊥, A², A}` and invokes the three case lemmas `abelian_cover_false`,
  `cover_deriv_sq_false`, `cover_deriv_self_false`.
-/


set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped commutatorElement

namespace Work.Higman.HS

variable {P : Type} [Group P] [Finite P]

/-! ## Elementary structural facts -/

/-- `[P,P] = A` makes `A` normal. -/
private theorem normal_of_commutator_top_eq {A : Subgroup P} (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) :
    A.Normal := by
  rw [← hGs]
  exact Subgroup.commutator_normal ⊤ ⊤

/-- `⁅A,⊤⁆ ≤ A` for a normal `A`. -/
private theorem commutator_A_top_le {A : Subgroup P} (hAn : A.Normal) : ⁅A, ⊤⁆ ≤ A := by
  rw [Subgroup.commutator_le]
  intro a ha b _
  have h1 : b * a⁻¹ * b⁻¹ ∈ A := by simpa using hAn.conj_mem a⁻¹ (A.inv_mem ha) b
  have h2 : ⁅a, b⁆ = a * (b * a⁻¹ * b⁻¹) := by simp only [commutatorElement_def, mul_assoc]
  rw [h2]
  exact A.mul_mem ha h1

/-- `⁅A,⊤⁆` is `ξ`-invariant whenever `A` is. -/
private theorem map_xi_commutator_A_top (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A) :
    Subgroup.map (h.xi : MulAut P).toMonoidHom (⁅A, ⊤⁆ : Subgroup P) = ⁅A, ⊤⁆ := by
  rw [Subgroup.map_commutator, hAxi,
    Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective]

/-- **The dichotomy for `ξ`-invariant subgroups of `A`.**  In the configuration of the `C₄`
exclusion (`A` abelian, `ξ`-invariant, `A² = Ω₁(P)`, `A⁴ = ⊥`), every `ξ`-invariant subgroup of
`A` is `⊥`, `A²` or `A`. -/
private theorem xi_inv_sub_dichotomy (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    {B : Subgroup P} (hBA : B ≤ A) (hBin : B.map (h.xi : MulAut P).toMonoidHom = B) :
    B = ⊥ ∨ B = Work.Higman.powSub A 2 ∨ B = A := by
  obtain ⟨e, -, -, -, hsub⟩ := Work.Higman.homogeneous_structure h hab hinv
  obtain ⟨i, hi⟩ := hsub B hBA hBin
  rcases Nat.eq_zero_or_pos i with h0 | hpos
  · refine Or.inr (Or.inr ?_)
    rw [hi, h0, pow_zero, Work.Higman.powSub_one_eq]
  · rcases Nat.lt_or_ge i 2 with hlt | hge
    · refine Or.inr (Or.inl ?_)
      have hi1 : i = 1 := by omega
      rw [hi, hi1]
      norm_num
    · refine Or.inl ?_
      rw [hi]
      have hdvd : 4 ∣ 2 ^ i := ⟨2 ^ (i - 2), by
        rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_add]
        congr 1
        omega⟩
      exact le_bot_iff.mp (hA4 ▸ Work.Higman.powSub_le_of_dvd hab hdvd)

/-- **`Ω₁(P)` is `ξ`-irreducible.**  A non-trivial `ξ`-invariant subgroup of `Ω₁(P)` is all of
`Ω₁(P)`: `ξ` is transitive on the involutions, and every element of `Ω₁(P)` is an involution. -/
private theorem eq_omega1_of_ne_bot_of_map_eq (h : Work.Higman.IsSuzuki2Grp P) {S : Subgroup P}
    (hS : S ≤ Work.Higman.omega1 P)
    (hSinv : Subgroup.map (h.xi : MulAut P).toMonoidHom S = S) (hne : S ≠ ⊥) :
    S = Work.Higman.omega1 P := by
  refine le_antisymm hS ?_
  obtain ⟨z, hzS, hz1⟩ : ∃ z ∈ S, z ≠ 1 := by
    by_contra hc
    push_neg at hc
    exact hne (le_bot_iff.mp (fun x hx => by simpa using hc x hx))
  have hz2 : z ^ 2 = 1 := h.mem_omega1.mp (hS hzS)
  have hzord : orderOf z = 2 := by
    rcases (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_iff_pow_eq_one.mpr hz2) with h1 | h2
    · exact absurd (orderOf_eq_one_iff.mp h1) hz1
    · exact h2
  have hstep : ∀ v ∈ S, h.xi v ∈ S := by
    intro v hv
    have h1 : h.xi v ∈ Subgroup.map (h.xi : MulAut P).toMonoidHom S :=
      Subgroup.mem_map_of_mem _ hv
    rwa [hSinv] at h1
  have hpow : ∀ k : ℕ, ∀ v ∈ S, (h.xi ^ k) v ∈ S := by
    intro k
    induction k with
    | zero => intro v hv; simpa using hv
    | succ k ih => intro v hv; rw [pow_succ, MulAut.mul_apply]; exact ih (h.xi v) (hstep v hv)
  intro w hw
  have hw2 : w ^ 2 = 1 := h.mem_omega1.mp hw
  rcases (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_iff_pow_eq_one.mpr hw2) with h1 | h2
  · rw [orderOf_eq_one_iff.mp h1]
    exact S.one_mem
  · obtain ⟨k, hk⟩ := h.trans z w hzord h2
    rw [← hk]
    exact hpow k z hzS

/-- **A power of `ξ` that fixes one involution fixes `Ω₁(P)` pointwise.**  The `⟨ξ⟩`-orbit of an
involution `z` is all of `Ω₁(P) ∖ {1}` (`IsSuzuki2Grp.trans`), and the powers of `ξ` commute with
each other. -/
private theorem xi_pow_fixes_omega1 (h : Work.Higman.IsSuzuki2Grp P) {k : ℕ} {z : P}
    (hz : orderOf z = 2) (hfix : (h.xi ^ k) z = z) :
    ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w := by
  intro w hw
  have hw2 : w ^ 2 = 1 := h.mem_omega1.mp hw
  rcases (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_iff_pow_eq_one.mpr hw2) with h1 | h2
  · rw [orderOf_eq_one_iff.mp h1]
    simp
  · obtain ⟨j, hj⟩ := h.trans z w hz h2
    have hcomm : (h.xi ^ k) ((h.xi ^ j) z) = (h.xi ^ j) ((h.xi ^ k) z) := by
      rw [← MulAut.mul_apply, ← MulAut.mul_apply, ← pow_add, add_comm, pow_add]
    rw [← hj, hcomm, hfix]

/-! ## The `L₃`-triviality input: `ξ ^ (|Ω₁(P)| - 1)` fixes `Ω₁(P)` pointwise -/

/-- `ξ ^ (|Ω₁(P)| - 1)` fixes `Ω₁(P)` pointwise (`Work.Higman.xi_pow_triv_omega1_iff`, which is
axiom-clean).  This is the `L₃`-triviality input of the `m = n` step, and also shows that
`η := ξ ^ (|Ω₁(P)| - 1)` acts trivially on `A/A²` whenever `A² = Ω₁(P)`. -/
private theorem xi_pow_card_sub_one_fixes_omega1 (h : Work.Higman.IsSuzuki2Grp P) :
    ∀ w ∈ Work.Higman.omega1 P,
      (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) w = w :=
  (Work.Higman.xi_pow_triv_omega1_iff h (Nat.card ↥(Work.Higman.omega1 P) - 1)).mpr dvd_rfl

/-- Conversely, a power of `ξ` acting trivially on `Ω₁(P)` is a multiple of `|Ω₁(P)| - 1`. -/
private theorem card_omega1_sub_one_dvd_of_xi_pow_triv (h : Work.Higman.IsSuzuki2Grp P) {k : ℕ}
    (hk : ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w) :
    (Nat.card ↥(Work.Higman.omega1 P) - 1) ∣ k :=
  (Work.Higman.xi_pow_triv_omega1_iff h k).mp hk

/-! ## The commutator collapse (Higman, Lemma 6, first step) -/

/-- Powers of an automorphism preserving a subgroup preserve it. -/
private theorem mem_of_pow_map_eq {H : Subgroup P} {φ : MulAut P}
    (hφ : H.map (φ : MulAut P).toMonoidHom = H) (k : ℕ) {x : P} (hx : x ∈ H) :
    (φ ^ k) x ∈ H := by
  revert x
  induction k with
  | zero => intro x hx; simpa using hx
  | succ k ih =>
      intro x hx
      rw [pow_succ, MulAut.mul_apply]
      exact ih (by rw [← hφ]; exact Subgroup.mem_map_of_mem _ hx)

/-- If `η = ξ ^ k` fixes `Ω₁(P)` pointwise and `A² = Ω₁(P)`, then `η` moves every element of `A`
by an element of `A²`. -/
private theorem pow_mul_inv_mem_powSub_two (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) {k : ℕ}
    (hηΩ : ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w) {y : P} (hy : y ∈ A) :
    (h.xi ^ k) y * y⁻¹ ∈ Work.Higman.powSub A 2 := by
  have hyA : (h.xi ^ k) y ∈ A := mem_of_pow_map_eq (φ := h.xi) hAxi k hy
  have hcomm : Commute ((h.xi ^ k) y) y⁻¹ :=
    hAab ((h.xi ^ k) y) hyA y⁻¹ (A.inv_mem hy)
  rw [htop, h.mem_omega1]
  rw [Commute.mul_pow hcomm 2]
  rw [inv_pow, ← map_pow]
  have hy2 : (y : P) ^ 2 ∈ Work.Higman.omega1 P := by
    rw [← htop]; exact Work.Higman.pow_mem_powSub hy
  rw [hηΩ _ hy2, mul_inv_cancel]

/-- **Higman's commutator collapse (Lemma 6, first step).**  Let `A ≤ C` with `A` abelian
`ξ`-invariant, `A² = Ω₁(P)`, `[A,C] = A²`, and let `η = ξ ^ k` fix `Ω₁(P)` pointwise.  Then
`(η x)·x⁻¹` centralises `A` for every `x ∈ C`.

Proof.  `η y = y · u` with `u = y⁻¹(η y) ∈ A² ⊆ Z(P)`, so `[η x, η y] = [η x, y]`; and
`[η x, η y] = η [x, y] = [x, y]` because `[x, y] ∈ [C,A] = A² = Ω₁(P)` is fixed by `η`.  Writing
`δ := (η x)·x⁻¹`, so that `δ * x = η x`, the identity `[a*b, c] = a * [b, c] * a⁻¹ * [a, c]`
turns `[δ*x, y] = [x, y]` into `δ * [x, y] * δ⁻¹ * [δ, y] = [x, y]`, and `[x,y]` is central, so
`[δ, y] = 1`. -/
private theorem commutator_pow_mul_inv_eq_one (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hCA2 : ⁅A, C⁆ = Work.Higman.powSub A 2) {k : ℕ}
    (hηΩ : ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w) {x : P} (hx : x ∈ C) {y : P}
    (hy : y ∈ A) : ⁅(h.xi ^ k) x * x⁻¹, y⁆ = 1 := by
  have hyA : (h.xi ^ k) y ∈ A := mem_of_pow_map_eq (φ := h.xi) hAxi k hy
  have hu0 : (h.xi ^ k) y * y⁻¹ ∈ Work.Higman.powSub A 2 :=
    pow_mul_inv_mem_powSub_two h hAab hAxi htop hηΩ hy
  have hu : y⁻¹ * (h.xi ^ k) y ∈ Work.Higman.powSub A 2 := by
    rw [← hAab ((h.xi ^ k) y) hyA y⁻¹ (A.inv_mem hy)]
    exact hu0
  have huz : y⁻¹ * (h.xi ^ k) y ∈ Subgroup.center P := h.omega1_le_center (by rw [← htop]; exact hu)
  have hxy : ⁅x, y⁆ ∈ Work.Higman.powSub A 2 := by
    have h1 : ⁅x, y⁆ ∈ ⁅C, A⁆ := Subgroup.commutator_mem_commutator hx hy
    rwa [Subgroup.commutator_comm, hCA2] at h1
  have hxyz : ⁅x, y⁆ ∈ Subgroup.center P := h.omega1_le_center (by rw [← htop]; exact hxy)
  have hfix : (h.xi ^ k) ⁅x, y⁆ = ⁅x, y⁆ := hηΩ ⁅x, y⁆ (by rw [← htop]; exact hxy)
  have key : ⁅(h.xi ^ k) x, (h.xi ^ k) y⁆ = ⁅x, y⁆ := by
    have h1 : ⁅(h.xi ^ k) x, (h.xi ^ k) y⁆ = (h.xi ^ k) ⁅x, y⁆ :=
      (map_commutatorElement (f := (h.xi ^ k : MulAut P).toMonoidHom) x y).symm
    rw [h1, hfix]
  have h2 : ⁅(h.xi ^ k) x, y⁆ = ⁅x, y⁆ := by
    have h1 : ⁅(h.xi ^ k) x, (h.xi ^ k) y⁆ = ⁅(h.xi ^ k) x, y⁆ := by
      have huy : (h.xi ^ k) y = y * (y⁻¹ * (h.xi ^ k) y) := by group
      rw [huy, commutatorElement_mul_right_eq_mul_conj,
        commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp huz ((h.xi ^ k) x))]
      group
    rw [← h1, key]
  have hdx : ((h.xi ^ k) x * x⁻¹) * x = (h.xi ^ k) x := by group
  have h4 : ((h.xi ^ k) x * x⁻¹) * ⁅x, y⁆ * ((h.xi ^ k) x * x⁻¹)⁻¹
      * ⁅(h.xi ^ k) x * x⁻¹, y⁆ = ⁅x, y⁆ := by
    rw [← commutatorElement_mul_left_eq_conj_mul ((h.xi ^ k) x * x⁻¹) x y, hdx, h2]
  have hconj : ((h.xi ^ k) x * x⁻¹) * ⁅x, y⁆ * ((h.xi ^ k) x * x⁻¹)⁻¹ = ⁅x, y⁆ := by
    rw [(Subgroup.mem_center_iff.mp hxyz) ((h.xi ^ k) x * x⁻¹)]
    group
  rw [hconj] at h4
  exact mul_left_cancel (a := ⁅x, y⁆) (by simpa using h4)

/-! ## Higman's first step: `ξ ^ (|Ω₁| - 1)` acts trivially on `C/A` -/

/-- **Higman's Lemma 6, first step.**  Setting of Higman's Lemma 8 with `⁅C,C⁆ = A` and
`⁅A,C⁆ = A² = Ω₁(P)`: the power `ξ ^ (|Ω₁(P)| - 1)` acts trivially on `C/A`, i.e.
`(ξ^(|Ω₁|-1) x)·x⁻¹ ∈ A` for every `x ∈ C`.

Proof.  Let `E ≤ P` be generated by `A` and the elements `(η x)·x⁻¹` (`η := ξ^(|Ω₁|-1)`,
`x ∈ C`).  Then `E` is normal (`E/A ≤ C/A` and `C/A` is abelian because `C' = A`) and
`ξ`-invariant, and `A ≤ E ≤ C`, so `hcover` gives `E = A` or `E = C`.  If `E = C` then, since
every `(η x)·x⁻¹` centralises `A` (Higman's commutator collapse), `[C,A]` is generated by
conjugates of `1`, so `[C,A] = 1`, contradicting `[A,C] = A² ≠ 1`.  Hence `E = A`, which is the
claim. -/
private theorem xi_pow_card_sub_one_triv_quot (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hAn : A.Normal) (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hCA2 : ⁅A, C⁆ = Work.Higman.powSub A 2) (hCd : ⁅C, C⁆ = A) :
    ∀ x ∈ C, (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) x * x⁻¹ ∈ A := by
  intro x0 hx0
  haveI := hAn
  set k : ℕ := Nat.card ↥(Work.Higman.omega1 P) - 1 with hk
  have hηΩ : ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w := by
    intro w hw; rw [hk]; exact xi_pow_card_sub_one_fixes_omega1 h w hw
  set G : Set P := (A : Set P) ∪ {e | ∃ y ∈ C, e = (h.xi ^ k) y * y⁻¹} with hG
  set E : Subgroup P := Subgroup.closure G with hE
  have hAE : A ≤ E := fun a ha => Subgroup.subset_closure (Or.inl ha)
  have hEC : E ≤ C := by
    rw [hE, Subgroup.closure_le]
    rintro d (hd | ⟨y, hy, rfl⟩)
    · exact hAC hd
    · exact C.mul_mem (mem_of_pow_map_eq (φ := h.xi) hCinv k hy) (C.inv_mem hy)
  -- `ξ` sends each generator to a generator
  have hξC : ∀ y ∈ C, h.xi y ∈ C := by
    intro y hy
    have h1 : h.xi y ∈ Subgroup.map (h.xi : MulAut P).toMonoidHom C := Subgroup.mem_map_of_mem _ hy
    rwa [hCinv] at h1
  have hgen : ∀ y ∈ C, h.xi ((h.xi ^ k) y * y⁻¹) = (h.xi ^ k) (h.xi y) * (h.xi y)⁻¹ := by
    intro y _
    have h1 : h.xi ((h.xi ^ k) y) = (h.xi ^ (k + 1)) y := by
      rw [← MulAut.mul_apply, ← pow_succ']
    have h2 : (h.xi ^ k) (h.xi y) = (h.xi ^ (k + 1)) y := by
      rw [← MulAut.mul_apply, ← pow_succ]
    simp only [map_mul, map_inv]
    rw [h1, h2]
  -- `ξ ^ (-1)` also sends generators to generators
  have hgen' : ∀ y ∈ C, (h.xi : MulAut P).symm ((h.xi ^ k) y * y⁻¹)
      = (h.xi ^ k) ((h.xi : MulAut P).symm y) * ((h.xi : MulAut P).symm y)⁻¹ := by
    intro y hy
    have h1 : h.xi ((h.xi ^ k) ((h.xi : MulAut P).symm y) * ((h.xi : MulAut P).symm y)⁻¹)
        = (h.xi : MulAut P) ((h.xi : MulAut P).symm ((h.xi ^ k) y * y⁻¹)) := by
      rw [hgen ((h.xi : MulAut P).symm y) (symm_mem_of_map_eq (h.xi : MulAut P) hCinv hy),
        MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]
    have h2 : (h.xi : MulAut P) ((h.xi : MulAut P).symm ((h.xi ^ k) y * y⁻¹))
        = (h.xi ^ k) y * y⁻¹ := MulEquiv.apply_symm_apply _ _
    exact h.xi.injective (by rw [h1, h2])
  -- `E` is `ξ`-invariant
  have hEin : Subgroup.map (h.xi : MulAut P).toMonoidHom E = E := by
    apply le_antisymm
    · rw [Subgroup.map_le_iff_le_comap, hE, Subgroup.closure_le]
      rintro d (hd | ⟨y, hy, rfl⟩)
      · have h1 : h.xi d ∈ Subgroup.map (h.xi : MulAut P).toMonoidHom A := Subgroup.mem_map_of_mem _ hd
        rw [hAxi] at h1
        exact hAE h1
      · exact Subgroup.subset_closure (Or.inr ⟨h.xi y, hξC y hy, hgen y hy⟩)
    · rw [hE, Subgroup.closure_le]
      rintro d (hd | ⟨y, hy, rfl⟩)
      · refine Subgroup.mem_map.mpr ⟨(h.xi : MulAut P).symm d,
          hAE (symm_mem_of_map_eq (h.xi : MulAut P) hAxi hd), ?_⟩
        exact MulEquiv.apply_symm_apply h.xi d
      · have hy' : (h.xi : MulAut P).symm y ∈ C := symm_mem_of_map_eq (h.xi : MulAut P) hCinv hy
        refine Subgroup.mem_map.mpr ⟨(h.xi ^ k) ((h.xi : MulAut P).symm y) * ((h.xi : MulAut P).symm y)⁻¹,
          Subgroup.subset_closure (Or.inr ⟨(h.xi : MulAut P).symm y, hy', rfl⟩), ?_⟩
        show (h.xi : MulAut P) ((h.xi ^ k) ((h.xi : MulAut P).symm y) * ((h.xi : MulAut P).symm y)⁻¹)
          = (h.xi ^ k) y * y⁻¹
        rw [hgen ((h.xi : MulAut P).symm y) hy']
        simp
  -- `E` is normal: `E/A ≤ C/A`, `C/A` abelian since `C' = A`
  have hEn : E.Normal := by
    refine Subgroup.Normal.mk ?_
    intro d hd g
    have hcomm : g * d * g⁻¹ * d⁻¹ ∈ A := by
      have h1 : ⁅g, d⁆ ∈ ⁅(⊤ : Subgroup P), ⊤⁆ :=
        Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top d)
      rw [hGs] at h1
      rwa [commutatorElement_def] at h1
    have h2 : g * d * g⁻¹ = (g * d * g⁻¹ * d⁻¹) * d := by group
    rw [h2]
    exact E.mul_mem (hAE hcomm) hd
  rcases hcover E hEn hEin hAE hEC with hEA | hEC'
  · -- `E = A`: the generator `(η x0)·x0⁻¹` lies in `A`
    have hmem : (h.xi ^ k) x0 * x0⁻¹ ∈ E := Subgroup.subset_closure (Or.inr ⟨x0, hx0, rfl⟩)
    rw [hEA] at hmem
    rw [hk] at hmem
    exact hmem
  · -- `E = C`: then `[C,A] = 1`, against `[A,C] = A²`
    exfalso
    have hCA1 : ⁅C, A⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro c hc
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      have hcollapse : ∀ y ∈ C, ⁅(h.xi ^ k) y * y⁻¹, a⁆ = 1 :=
        fun y hy => commutator_pow_mul_inv_eq_one h hAab hAxi htop hCA2 hηΩ hy ha
      have hker : ∀ z ∈ E, ⁅z, a⁆ = 1 := by
        intro z hz
        rw [hE] at hz
        exact Subgroup.closure_induction
          (k := G) (p := fun (z : P) (_ : z ∈ Subgroup.closure G) => ⁅z, a⁆ = 1)
          (fun x hx => by
            rcases hx with hxA | ⟨y, hy, rfl⟩
            · rw [commutatorElement_eq_one_iff_mul_comm]
              exact (hAab a ha x hxA).symm
            · exact hcollapse y hy)
          (by simp)
          (fun x y hx hy ihx ihy => by
            rw [commutatorElement_mul_left_eq_conj_mul, ihx, ihy]
            group)
          (fun x hx ihx => by
            rw [commutatorElement_inv_left, show ⁅a, x⁆ = ⁅x, a⁆⁻¹ from (commutatorElement_inv x a).symm, ihx,
              inv_one]
            group)
          hz
      have h1 : ⁅c, a⁆ = 1 := hker c (hEC' ▸ hc)
      rw [commutatorElement_eq_one_iff_mul_comm] at h1
      exact h1.symm
    have h2 : Work.Higman.powSub A 2 = ⊥ := by
      rw [← hCA2, Subgroup.commutator_comm]; exact hCA1
    have h3 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, h2, Subgroup.card_bot]
    have h4 := h.omega1_card_ge_four
    omega
/-! ## Well-definedness of the commutator-square pairing on `C/A` -/

/-- Squaring is injective on the `2 ^ n`-th powers: if `x² = y²` then `x^(2^n) = y^(2^n)`
(for `n ≥ 1`). -/
private theorem pow_two_pow_eq_of_sq_eq {P : Type} [Group P] {x y : P} {n : ℕ} (hn : 1 ≤ n)
    (h : x ^ 2 = y ^ 2) : x ^ 2 ^ n = y ^ 2 ^ n := by
  have h1 : ∀ z : P, z ^ 2 ^ n = (z ^ 2) ^ 2 ^ (n - 1) := by
    intro z
    rw [← pow_mul, show 2 * 2 ^ (n - 1) = 2 ^ n from by rw [← pow_succ']; congr 1; omega]
  rw [h1 x, h1 y, h]

/-- **Well-definedness of `⁅u⁻¹, v⁆²` on cosets of `A`.**  If `u' ≡ u` and `v' ≡ v` modulo `A`
(in the form `u'⁻¹ * u ∈ A`, `v'⁻¹ * v ∈ A`) then `⁅u⁻¹, v⁆² = ⁅u'⁻¹, v'⁆²`.

This is the well-definedness input for `MSA.L8.BV` (`(uA, vA) ↦ ⁅u⁻¹,v⁆ ^ 2^(e-1)` on
representatives): moving the `A`-component from the left of an argument to the right uses the
normality of `A`. -/
private theorem comm_sq_eq_of_mul_mem (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P} (hAn : A.Normal)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    {u u' v v' : P} (hu : u'⁻¹ * u ∈ A) (hv : v'⁻¹ * v ∈ A) :
    ⁅u⁻¹, v⁆ ^ 2 = ⁅u'⁻¹, v'⁆ ^ 2 := by
  have hueq : u = u' * (u'⁻¹ * u) := by group
  have hveq : v = v' * (v'⁻¹ * v) := by group
  have ha' : u' * (u'⁻¹ * u)⁻¹ * u'⁻¹ ∈ A := hAn.conj_mem (u'⁻¹ * u)⁻¹ (A.inv_mem hu) u'
  have h2 : (u' * (u'⁻¹ * u))⁻¹ = u'⁻¹ * (u' * (u'⁻¹ * u)⁻¹ * u'⁻¹) := by group
  rw [hueq, hveq, h2]
  exact Work.Higman.comm_sq_congr h hAxi hAab hGs htop u'⁻¹ v' ha' hv

/-- The `2 ^ n`-th power version of `comm_sq_eq_of_mul_mem`: this is the form in which
`MSA.L8.BV` (whose exponent is `2 ^ (e - 1)`) is well defined on representatives. -/
private theorem comm_pow_two_pow_eq_of_mul_mem (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAn : A.Normal) (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    {n : ℕ} (hn : 1 ≤ n) {u u' v v' : P} (hu : u'⁻¹ * u ∈ A) (hv : v'⁻¹ * v ∈ A) :
    ⁅u⁻¹, v⁆ ^ 2 ^ n = ⁅u'⁻¹, v'⁆ ^ 2 ^ n :=
  pow_two_pow_eq_of_sq_eq hn (comm_sq_eq_of_mul_mem h hAn hAxi hAab hGs htop hu hv)

/-- **`ξ`-equivariance of the commutator pairing `BV`.**  In the situation of Higman's Lemma 8
with `e = 2` (so that the exponent `2 ^ (e - 1)` of `BV` is `2`), the pairing
`BV (x, y) = ⁅repC x⁻¹, repC y⁆ ^ 2` commutes with the `ξ`-actions on `C/A` and on `Ω₁(P)`.

Well-definedness (`comm_pow_two_pow_eq_of_mul_mem`) compares the two choices of representatives:
`repC (ξQuot x)` versus `ξ (repC x)`, which represent the same coset by
`QuotientGroup.congr_mk` and `MSA.L8.repC_spec`; the `ξ`-side is `map_pow`,
`map_commutatorElement` and `map_inv`. -/
private theorem BV_xiQuot {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (S : MSA.L8.D h A C) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (he : S.e = 2)
    (x y : ↥C ⧸ (A.subgroupOf C)) :
    MSA.L8.BV S (MSA.L8.xiQuot h S.hA.map_eq S.hCinv x)
        (MSA.L8.xiQuot h S.hA.map_eq S.hCinv y)
      = MSA.L8.xiSubAut h (Work.Higman.map_xi_omega1 h) (MSA.L8.BV S x y) := by
  have htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P := by
    rw [← S.htopA, he]
    norm_num
  apply Subtype.ext
  rw [MSA.L8.BV_apply, MSA.L8.xiSubAut_apply, MSA.L8.BV_apply, he]
  norm_num
  -- goal: `⁅(repC x')⁻¹, repC y'⁆ ^ 2 = ⁅(ξ (repC x))⁻¹, ξ (repC y)⁆ ^ 2`
  set ux : ↥C := MSA.L8.xiSubAut h S.hCinv (MSA.L8.repC x) with hux
  set uy : ↥C := MSA.L8.xiSubAut h S.hCinv (MSA.L8.repC y) with huy
  have hx' : QuotientGroup.mk ux = MSA.L8.xiQuot h S.hA.map_eq S.hCinv x := by
    have h1 : MSA.L8.xiQuot h S.hA.map_eq S.hCinv (QuotientGroup.mk (MSA.L8.repC x))
        = QuotientGroup.mk ux := by
      rw [hux]
      exact (QuotientGroup.congr_mk (A.subgroupOf C) (A.subgroupOf C) (MSA.L8.xiSubAut h S.hCinv)
        (MSA.L8.map_xi_subgroupOf h S.hA.map_eq S.hCinv) (MSA.L8.repC x)).symm
    rw [MSA.L8.repC_spec x] at h1
    exact h1.symm
  have hy' : QuotientGroup.mk uy = MSA.L8.xiQuot h S.hA.map_eq S.hCinv y := by
    have h1 : MSA.L8.xiQuot h S.hA.map_eq S.hCinv (QuotientGroup.mk (MSA.L8.repC y))
        = QuotientGroup.mk uy := by
      rw [huy]
      exact (QuotientGroup.congr_mk (A.subgroupOf C) (A.subgroupOf C) (MSA.L8.xiSubAut h S.hCinv)
        (MSA.L8.map_xi_subgroupOf h S.hA.map_eq S.hCinv) (MSA.L8.repC y)).symm
    rw [MSA.L8.repC_spec y] at h1
    exact h1.symm
  have hu := MSA.L8.repC_mul_inv_mem (A := A) (C := C) hx'
  have hv := MSA.L8.repC_mul_inv_mem (A := A) (C := C) hy'
  have hmap : (h.xi (((MSA.L8.repC x : ↥C) : P)) : P) = ((ux : ↥C) : P) :=
    MSA.L8.xiSubAut_apply h S.hCinv (MSA.L8.repC x)
  have hmap' : (h.xi (((MSA.L8.repC y : ↥C) : P)) : P) = ((uy : ↥C) : P) :=
    MSA.L8.xiSubAut_apply h S.hCinv (MSA.L8.repC y)
  rw [hmap, hmap', hux, huy] at *
  exact (comm_pow_two_pow_eq_of_mul_mem h hAn S.hA.map_eq S.hA.abelian hGs htop
    (n := 1) le_rfl hu hv).symm

/-- The iterated form of `BV_xiQuot`: `BV` intertwines the `k`-th powers of the two `ξ`-actions. -/
private theorem BV_xiQuot_pow {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (S : MSA.L8.D h A C) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (he : S.e = 2) (k : ℕ)
    (x y : ↥C ⧸ (A.subgroupOf C)) :
    MSA.L8.BV S (((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ k) x)
        (((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ k) y)
      = ((MSA.L8.xiSubAut h (Work.Higman.map_xi_omega1 h)) ^ k) (MSA.L8.BV S x y) := by
  revert x y
  induction k with
  | zero => intro x y; simp
  | succ k ih =>
      intro x y
      have hxl : ((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ (k + 1)) x
          = ((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ k)
              (MSA.L8.xiQuot h S.hA.map_eq S.hCinv x) := by
        rw [pow_succ]; rfl
      have hyl : ((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ (k + 1)) y
          = ((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ k)
              (MSA.L8.xiQuot h S.hA.map_eq S.hCinv y) := by
        rw [pow_succ]; rfl
      have hzl : ((MSA.L8.xiSubAut h (Work.Higman.map_xi_omega1 h)) ^ (k + 1))
            (MSA.L8.BV S x y)
          = ((MSA.L8.xiSubAut h (Work.Higman.map_xi_omega1 h)) ^ k)
              (MSA.L8.xiSubAut h (Work.Higman.map_xi_omega1 h) (MSA.L8.BV S x y)) := by
        rw [pow_succ]; rfl
      rw [hxl, hyl, hzl, ih, BV_xiQuot S hGs he]

/-! ## `A²` is central in `C`: the inputs for `im(BV) ≠ 1` -/

/-- In the situation of Higman's Lemma 8 with `e = 2` (so `A` has exponent `4`), `A ^ 4 = ⊥`. -/
private theorem powSub_four_eq_bot {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (S : MSA.L8.D h A C) (he : S.e = 2) : Work.Higman.powSub A 4 = ⊥ := by
  rw [eq_bot_iff, Work.Higman.powSub, Subgroup.closure_le]
  rintro y ⟨x, hx, rfl⟩
  show x ^ 4 = 1
  rw [show (4 : ℕ) = 2 ^ S.e from by rw [he]; norm_num]
  exact S.he1 x hx

/-- **`A²` is central in `C`**: with `e = 2`, `⁅A,C⁆ = A²` and `⁅A²,C⁆ = A⁴ = ⊥`
(`Work.Higman.commutator_powSub_A_C`). -/
private theorem powSub_two_central {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (S : MSA.L8.D h A C) (he : S.e = 2) : ⁅Work.Higman.powSub A 2, C⁆ = ⊥ := by
  have h := Work.Higman.commutator_powSub_A_C h S.hA S.hCn S.hC2 S.hCd 1
  have h4 : ⁅Work.Higman.powSub A 2, C⁆ = Work.Higman.powSub A 4 := by
    simpa using h
  rw [h4, powSub_four_eq_bot S he]

/-- Consequently conjugation by `C` fixes `A²` pointwise. -/
private theorem conj_powSub_two {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (S : MSA.L8.D h A C) (he : S.e = 2) {a : P} (ha : a ∈ Work.Higman.powSub A 2) {c : P}
    (hc : c ∈ C) : c * a * c⁻¹ = a := by
  have h1 : ⁅a, c⁆ = 1 := by
    have h2 : ⁅a, c⁆ ∈ ⁅Work.Higman.powSub A 2, C⁆ :=
      Subgroup.commutator_mem_commutator ha hc
    rw [powSub_two_central S he] at h2
    simpa using h2
  rw [commutatorElement_eq_one_iff_mul_comm] at h1
  calc c * a * c⁻¹ = (a * c) * c⁻¹ := by rw [h1]
    _ = a := by group

/-- **`BV` does not vanish** (given `A ≠ A²`).  Since `⁅C,C⁆ = A ⊋ A²` there is a commutator
`⁅c,d⁆ ∉ A²`; then `BV (cA) (dA) = ⁅c⁻¹,d⁆² ≠ 1`: indeed `⁅c⁻¹,d⁆² = 1` would put `⁅c⁻¹,d⁆` in
`Ω₁ = A²`, and `⁅c⁻¹,d⁆ = c⁻¹ * ⁅c,d⁆⁻¹ * c` (`commutatorElement_inv_left`) together with the
fact that conjugation by `C` fixes `A²` pointwise (`conj_powSub_two`) would then force
`⁅c,d⁆ ∈ A²`, a contradiction. -/
private theorem BV_ne_one {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (S : MSA.L8.D h A C) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (he : S.e = 2)
    (hA2ne : A ≠ Work.Higman.powSub A 2) :
    ∃ x y : ↥C ⧸ (A.subgroupOf C), MSA.L8.BV S x y ≠ 1 := by
  have htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P := by
    rw [← S.htopA, he]; norm_num
  obtain ⟨c, hc, d, hd, hcd⟩ : ∃ c ∈ C, ∃ d ∈ C, ⁅c, d⁆ ∉ Work.Higman.powSub A 2 := by
    by_contra hcon
    push_neg at hcon
    refine hA2ne (le_antisymm ?_ (Work.Higman.powSub_le (by norm_num)))
    conv_lhs => rw [← S.hCd]
    rw [Subgroup.commutator_le]
    intro x hx y hy
    exact hcon x hx y hy
  let xc : ↥C := ⟨c, hc⟩
  let xd : ↥C := ⟨d, hd⟩
  have hrepx : (((MSA.L8.repC (QuotientGroup.mk xc))⁻¹ * xc : ↥C) : P) ∈ A :=
    MSA.L8.repC_mul_inv_mem (A := A) (C := C) (x := QuotientGroup.mk xc) (u := xc) rfl
  have hrepy : (((MSA.L8.repC (QuotientGroup.mk xd))⁻¹ * xd : ↥C) : P) ∈ A :=
    MSA.L8.repC_mul_inv_mem (A := A) (C := C) (x := QuotientGroup.mk xd) (u := xd) rfl
  refine ⟨QuotientGroup.mk xc, QuotientGroup.mk xd, ?_⟩
  intro hzero
  have hval : ((MSA.L8.BV S (QuotientGroup.mk xc) (QuotientGroup.mk xd) : ↥(Work.Higman.omega1 P)) : P)
      = ⁅c⁻¹, d⁆ ^ 2 := by
    rw [MSA.L8.BV_apply, show (2 : ℕ) ^ (S.e - 1) = 2 from by rw [he]; norm_num]
    exact (comm_sq_eq_of_mul_mem h hAn S.hA.map_eq S.hA.abelian hGs htop hrepx hrepy).symm
  have hsq : ⁅c⁻¹, d⁆ ^ 2 = 1 := by
    have h1 : ((MSA.L8.BV S (QuotientGroup.mk xc) (QuotientGroup.mk xd) : ↥(Work.Higman.omega1 P)) : P) = 1 := by
      rw [hzero]; rfl
    rw [hval] at h1
    exact h1
  have hmem : ⁅c⁻¹, d⁆ ∈ Work.Higman.powSub A 2 := by
    rw [htop]
    exact h.mem_omega1.mpr hsq
  have hconj : ⁅c⁻¹, d⁆ = c⁻¹ * ⁅c, d⁆⁻¹ * c := by
    rw [commutatorElement_inv_left, commutatorElement_inv]
  have h1 : c * ⁅c⁻¹, d⁆ * c⁻¹ = ⁅c⁻¹, d⁆ := conj_powSub_two S he hmem hc
  have h2 : ⁅c, d⁆⁻¹ ∈ Work.Higman.powSub A 2 := by
    have h3 : c * ⁅c⁻¹, d⁆ * c⁻¹ = ⁅c, d⁆⁻¹ := by
      rw [hconj]; group
    rw [← h3, h1]
    exact hmem
  exact hcd (by simpa using (Work.Higman.powSub A 2).inv_mem h2)

/-- **`ξ^k = 1` on `C/A` forces `ξ^k = 1` on `Ω₁(P)`.**  The subgroup `F` of fixed points of
`ξZ^k` inside `↥(Ω₁ P)` contains every `BV`-value (`BV_xiQuot_pow` plus the hypothesis), hence the
subgroup generated by those values; `F` is a `ξ`-invariant subgroup of `Ω₁` (`ξZ` commutes with
`ξZ^k`) and it is non-trivial by `BV_ne_one`; `Ω₁` being `ξ`-irreducible
(`eq_omega1_of_ne_bot_of_map_eq`) then gives `F = ⊤`. -/
private theorem xiZ_pow_fixes_of_xiQuot_pow_fixes {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P}
    [hAn : A.Normal] (S : MSA.L8.D h A C) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (he : S.e = 2)
    (hA2ne : A ≠ Work.Higman.powSub A 2) {k : ℕ}
    (hk : ∀ x : ↥C ⧸ (A.subgroupOf C),
      ((MSA.L8.xiQuot h S.hA.map_eq S.hCinv) ^ k) x = x) :
    ∀ w ∈ Work.Higman.omega1 P, (h.xi ^ k) w = w := by
  -- work inside `↥(Ω₁ P)`
  set ξZ : MulAut ↥(Work.Higman.omega1 P) := MSA.L8.xiSubAut h (Work.Higman.map_xi_omega1 h)
    with hξZ
  let F : Subgroup ↥(Work.Higman.omega1 P) :=
    { carrier := {v | (ξZ ^ k) v = v}
      mul_mem' := by
        intro a b ha hb
        show (ξZ ^ k) (a * b) = a * b
        rw [map_mul, ha, hb]
      one_mem' := by show (ξZ ^ k) 1 = 1; exact map_one _
      inv_mem' := by
        intro a ha
        show (ξZ ^ k) a⁻¹ = a⁻¹
        rw [map_inv, ha] }
  -- every `BV`-value is fixed by `ξZ ^ k`
  have hmem : ∀ x y : ↥C ⧸ (A.subgroupOf C), MSA.L8.BV S x y ∈ F := by
    intro x y
    show (ξZ ^ k) (MSA.L8.BV S x y) = MSA.L8.BV S x y
    rw [hξZ, ← BV_xiQuot_pow S hGs he k x y, hk x, hk y]
  -- `F` is `ξ`-invariant
  have hFinv : Subgroup.map ξZ F = F := by
    apply le_antisymm
    · rw [Subgroup.map_le_iff_le_comap]
      intro v hv
      show (ξZ ^ k) (ξZ v) = ξZ v
      have h1 : (ξZ ^ k) (ξZ v) = ξZ ((ξZ ^ k) v) := by
        rw [← MulAut.mul_apply, ← MulAut.mul_apply, ← pow_succ, ← pow_succ']
      rw [h1, hv]
    · intro v hv
      refine Subgroup.mem_map.mpr ⟨ξZ.symm v, ?_, by simp⟩
      have h4 : ξZ ((ξZ ^ k) (ξZ.symm v)) = (ξZ ^ k) v := by
        rw [← MulAut.mul_apply, ← pow_succ', pow_succ, MulAut.mul_apply,
          MulEquiv.apply_symm_apply]
      have h3 : (ξZ ^ k) (ξZ.symm v) = ξZ.symm ((ξZ ^ k) v) := by
        apply ξZ.injective
        rw [MulEquiv.apply_symm_apply]
        exact h4
      show (ξZ ^ k) (ξZ.symm v) = ξZ.symm v
      rw [h3, hv]
  -- the image of `F` in `P` is a non-trivial `ξ`-invariant subgroup of `Ω₁`
  have hle : F.map (Subgroup.subtype (Work.Higman.omega1 P)) ≤ Work.Higman.omega1 P := by
    rintro v ⟨w, -, rfl⟩
    exact w.2
  have hne : F.map (Subgroup.subtype (Work.Higman.omega1 P)) ≠ ⊥ := by
    obtain ⟨x, y, hxy⟩ := BV_ne_one S hGs he hA2ne
    intro hbot
    have h1 : ((MSA.L8.BV S x y : ↥(Work.Higman.omega1 P)) : P)
        ∈ F.map (Subgroup.subtype (Work.Higman.omega1 P)) :=
      Subgroup.mem_map_of_mem _ (hmem x y)
    rw [hbot] at h1
    exact hxy (by simpa using h1)
  have hinv : Subgroup.map (h.xi : MulAut P).toMonoidHom
        (F.map (Subgroup.subtype (Work.Higman.omega1 P)))
      = F.map (Subgroup.subtype (Work.Higman.omega1 P)) := by
    rw [Subgroup.map_map]
    have hcomp : (h.xi : MulAut P).toMonoidHom.comp (Subgroup.subtype (Work.Higman.omega1 P))
        = (Subgroup.subtype (Work.Higman.omega1 P)).comp (ξZ : MulAut ↥(Work.Higman.omega1 P)).toMonoidHom := by
      ext v
      show h.xi ((v : ↥(Work.Higman.omega1 P)) : P) = ((ξZ v : ↥(Work.Higman.omega1 P)) : P)
      rw [hξZ]
      exact MSA.L8.xiSubAut_apply h (Work.Higman.map_xi_omega1 h) v
    rw [hcomp, ← Subgroup.map_map,
      show Subgroup.map (MulEquiv.toMonoidHom ξZ) F = F from hFinv]
  intro w hw
  have hEq := eq_omega1_of_ne_bot_of_map_eq h
    (S := F.map (Subgroup.subtype (Work.Higman.omega1 P))) hle hinv hne
  have hw' : w ∈ F.map (Subgroup.subtype (Work.Higman.omega1 P)) := by
    rw [hEq]; exact hw
  obtain ⟨v, hv, hvw⟩ := hw'
  have hvfix : (ξZ ^ k) v = v := hv
  have h1 := congrArg (fun t : ↥(Work.Higman.omega1 P) => (t : P)) hvfix
  rw [MSA.L8.xiSubAut_pow_apply h (Work.Higman.map_xi_omega1 h) k v] at h1
  rw [← hvw]
  exact h1

/-! ## The induced automorphism of `C/A` -/

/-- The `k`-th power of `MSA.L8.xiQuot` sends `QuotientGroup.mk x` to `QuotientGroup.mk (ξ^k x)`. -/
private theorem xiQuot_pow_mk {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) (k : ℕ) (x : ↥C) :
    ((Work.Higman.MSA.L8.xiQuot h hAxi hCinv) ^ k) (QuotientGroup.mk x)
      = QuotientGroup.mk ((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x) := by
  revert x
  induction k with
  | zero => intro x; simp
  | succ k ih =>
      intro x
      rw [pow_succ, pow_succ]
      show (Work.Higman.MSA.L8.xiQuot h hAxi hCinv ^ k)
          (Work.Higman.MSA.L8.xiQuot h hAxi hCinv (QuotientGroup.mk x)) = _
      rw [show Work.Higman.MSA.L8.xiQuot h hAxi hCinv (QuotientGroup.mk x)
          = QuotientGroup.mk (Work.Higman.MSA.L8.xiSubAut h hCinv x) from
        QuotientGroup.congr_mk _ _ _ _ _]
      rw [ih]
      rfl

/-- **The order of the induced automorphism of `C/A` divides `k`, provided `ξ^k` acts trivially on
`C/A`.**  In particular (`k = |Ω₁(P)| - 1`, `xi_pow_card_sub_one_triv_quot`) the order of the
induced automorphism divides `|Ω₁(P)| - 1`: the easy half of the `m = n` count. -/
private theorem orderOf_xiQuot_dvd {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) {k : ℕ}
    (hk : ∀ x ∈ C, (h.xi ^ k) x * x⁻¹ ∈ A) :
    orderOf (Work.Higman.MSA.L8.xiQuot h hAxi hCinv) ∣ k := by
  rw [orderOf_dvd_iff_pow_eq_one]
  ext y
  induction y using QuotientGroup.induction_on with
  | _ x =>
      rw [xiQuot_pow_mk hAxi hCinv k x]
      have hmem : (h.xi ^ k) (x : P) * (x : P)⁻¹ ∈ A := hk (x : P) x.2
      have hmem' : (((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P) * (x : P)⁻¹ ∈ A := by
        rw [Work.Higman.MSA.L8.xiSubAut_pow_apply]
        exact hmem
      have hx1 : (x : P)⁻¹ * (((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P) ∈ A := by
        have h2 := hAn.conj_mem ((((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P) * (x : P)⁻¹)
          hmem' (x : P)⁻¹
        have h3 : (x : P)⁻¹ * ((((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P) * (x : P)⁻¹)
            * (x : P)⁻¹⁻¹ = (x : P)⁻¹ * (((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P) := by
          group
        rwa [h3] at h2
      have h1 : (((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P)⁻¹ * (x : P) ∈ A := by
        rw [show (((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P)⁻¹ * (x : P)
            = ((x : P)⁻¹ * (((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x : ↥C) : P))⁻¹ from by group]
        exact A.inv_mem hx1
      have h1' : ((Work.Higman.MSA.L8.xiSubAut h hCinv ^ k) x)⁻¹ * x ∈ A.subgroupOf C := by
        rw [Subgroup.mem_subgroupOf]
        simpa using h1
      exact QuotientGroup.eq.mpr h1'

/-- **The order of the induced automorphism of `C/A` divides `|Ω₁(P)| - 1`.**  In the setting of
Higman's Lemma 8 with `⁅C,C⁆ = A`, `⁅A,C⁆ = A² = Ω₁(P)`: the first step
(`xi_pow_card_sub_one_triv_quot`) says that `ξ^(|Ω₁|-1)` acts trivially on `C/A`.  Together with
the reverse divisibility this gives `|C/A| = |Ω₁(P)|` (`H8.card_pow_of_irreducible`). -/
private theorem orderOf_xiQuot_dvd_card_sub_one (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    [hAn : A.Normal] (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hCA2 : ⁅A, C⁆ = Work.Higman.powSub A 2) (hCd : ⁅C, C⁆ = A) :
    orderOf (Work.Higman.MSA.L8.xiQuot h hAxi hCinv) ∣ Nat.card ↥(Work.Higman.omega1 P) - 1 :=
  orderOf_xiQuot_dvd hAxi hCinv
    (xi_pow_card_sub_one_triv_quot h hAn hAab hAxi hCn hCinv hGs hAC hCA hcover htop hCA2 hCd)

/-! ## The first two cases of `[A,P] ∈ {⊥, A², A}` -/

/-- **Case `⁅A,P⁆ = ⊥`.**  Then `A` is central, `P` has class two, every commutator is an
involution, and `A = [P,P] ≤ Ω₁ = A²`, contradicting `|A| = |Ω₁|²` with `|Ω₁| ≥ 4`. -/
private theorem comm_bot_false (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (h3 : (⁅A, (⊤ : Subgroup P)⁆ : Subgroup P) = ⊥) : False := by
  -- `A` is central
  have hAZ : A ≤ Subgroup.center P := by
    intro a ha
    rw [Subgroup.mem_center_iff]
    intro b
    have h1 : ⁅a, b⁆ ∈ (⊥ : Subgroup P) := by
      rw [← h3]
      exact Subgroup.commutator_mem_commutator ha (Subgroup.mem_top b)
    have h2 : ⁅a, b⁆ = 1 := Subgroup.mem_bot.mp h1
    rw [commutatorElement_eq_one_iff_mul_comm] at h2
    exact h2.symm
  -- `P` has class two: `[[P,P],[P,P]]`-free enough for `[x,y]² = [x²,y]`
  have hZ : (⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ : Subgroup P) ≤ Subgroup.center P := by
    rw [hGs]; exact hAZ
  have hsq1 : ∀ x y : P, ⁅x, y⁆ ^ 2 = 1 := by
    intro x y
    rw [Work.Higman.commutator_sq_eq hZ x y]
    have hx : x ^ 2 ∈ Subgroup.center P := hAZ (hsq x)
    have hc : y * x ^ 2 = x ^ 2 * y := (Subgroup.mem_center_iff.mp hx y)
    rw [commutatorElement_def, ← hc]
    group
  -- hence every commutator is an involution and `A ≤ Ω₁ = A²`
  have hAle : A ≤ Work.Higman.omega1 P := by
    rw [← hGs, Subgroup.commutator_le]
    intro x _ y _
    exact h.mem_omega1.mpr (hsq1 x y)
  have hAeq : A = Work.Higman.powSub A 2 := by
    rw [htop]
    exact le_antisymm hAle hNA
  have hc : Nat.card ↥A = Nat.card ↥(Work.Higman.omega1 P) := by rw [hAeq, htop]
  have h1 : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
    rw [← hc] at hcard
    rw [← hc]
    exact hcard
  have h2 := h.omega1_card_ge_four
  have h3' : 1 < Nat.card ↥(Work.Higman.omega1 P) := by omega
  nlinarith [h1, h2, h3']

/-- **Case `⁅A,P⁆ = A`.**  Then `A ≤ γ_n(P)` for every `n`, while `P` is nilpotent, so `A = ⊥`,
contradicting `Ω₁ ≤ A` with `|Ω₁| ≥ 4`. -/
private theorem comm_self_false (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hNA : Work.Higman.omega1 P ≤ A) (h3 : (⁅A, (⊤ : Subgroup P)⁆ : Subgroup P) = A) : False := by
  have hNil : Group.IsNilpotent P := h.isPGroup.isNilpotent
  have hle : ∀ n : ℕ, A ≤ Subgroup.lowerCentralSeries (⊤ : Subgroup P) n := by
    intro n
    induction n with
    | zero => rw [Subgroup.lowerCentralSeries_zero]; exact le_top
    | succ n ih =>
        rw [Subgroup.lowerCentralSeries_succ]
        calc A = (⁅A, (⊤ : Subgroup P)⁆ : Subgroup P) := h3.symm
          _ ≤ (⁅Subgroup.lowerCentralSeries (⊤ : Subgroup P) n, (⊤ : Subgroup P)⁆ : Subgroup P) :=
              Subgroup.commutator_mono ih le_rfl
  obtain ⟨n, hn⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp hNil
  have hbot : A ≤ (⊥ : Subgroup P) := by
    have := hle n
    rwa [hn] at this
  have hcard1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by
    have h1 : Work.Higman.omega1 P ≤ (⊥ : Subgroup P) := hNA.trans hbot
    rw [le_bot_iff.mp h1, Subgroup.card_bot]
  have h4 := h.omega1_card_ge_four
  omega

/-! ## A minimal `ξ`-invariant normal cover of `A` -/

/-- There is a `ξ`-invariant normal subgroup `C` minimal among those strictly containing `A`. -/
private theorem exists_minimal_cover (h : IsSuzuki2Grp P) {A : Subgroup P} (hAne : A ≠ ⊤) :
    ∃ C : Subgroup P, C.Normal ∧ C.map (h.xi : MulAut P).toMonoidHom = C ∧ A ≤ C ∧ C ≠ A ∧
      (∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
        A ≤ D → D ≤ C → D = A ∨ D = C) := by
  classical
  set S : Set (Subgroup P) :=
    {D | D.Normal ∧ D.map (h.xi : MulAut P).toMonoidHom = D ∧ A < D} with hS
  have hSne : S.Nonempty :=
    ⟨⊤, Subgroup.normal_top, by
      rw [Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective], lt_of_le_of_ne le_top hAne⟩
  have hSfin : S.Finite := Set.finite_univ.subset (fun _ _ => trivial)
  obtain ⟨C, hCs, hCmin⟩ := hSfin.exists_minimal hSne
  obtain ⟨hCn, hCinv, hAClt⟩ := hCs
  refine ⟨C, hCn, hCinv, le_of_lt hAClt, ne_of_gt hAClt, ?_⟩
  intro D hDn hDinv hAD hDC
  rcases eq_or_ne D A with hDA | hDA
  · exact Or.inl hDA
  · exact Or.inr (le_antisymm hDC (hCmin ⟨hDn, hDinv, lt_of_le_of_ne hAD (Ne.symm hDA)⟩ hDC))


/-- **Reverse divisibility**: `|Ω₁(P)| - 1` divides the order of the induced automorphism of
`C/A`.  Immediate from `xiZ_pow_fixes_of_xiQuot_pow_fixes` at `k = orderOf ξQuot` together with
`card_omega1_sub_one_dvd_of_xi_pow_triv`. -/
private theorem card_sub_one_dvd_orderOf_xiQuot {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P}
    [hAn : A.Normal] (S : MSA.L8.D h A C) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (he : S.e = 2)
    (hA2ne : A ≠ Work.Higman.powSub A 2) :
    (Nat.card ↥(Work.Higman.omega1 P) - 1)
      ∣ orderOf (MSA.L8.xiQuot h S.hA.map_eq S.hCinv) :=
  card_omega1_sub_one_dvd_of_xi_pow_triv h
    (xiZ_pow_fixes_of_xiQuot_pow_fixes S hGs he hA2ne (k := _) (by
      intro x; rw [pow_orderOf_eq_one]; rfl))

/-- **The order of the induced automorphism of `C/A` is `|Ω₁(P)| - 1`** — the `m = n` order
equality, combining the two divisibilities. -/
private theorem orderOf_xiQuot_eq {h : Work.Higman.IsSuzuki2Grp P} {A C : Subgroup P}
    [hAn : A.Normal] (S : MSA.L8.D h A C) (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) (he : S.e = 2) (hA2ne : A ≠ Work.Higman.powSub A 2)
    (hCn : C.Normal := S.hCn) (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCA2 : ⁅A, C⁆ = Work.Higman.powSub A 2) (hCd : ⁅C, C⁆ = A) :
    orderOf (MSA.L8.xiQuot h S.hA.map_eq S.hCinv)
      = Nat.card ↥(Work.Higman.omega1 P) - 1 :=
  Nat.dvd_antisymm
    (orderOf_xiQuot_dvd_card_sub_one h hAab S.hA.map_eq S.hCn S.hCinv hGs hAC hCA hcover
      (by rw [← S.htopA, he]; norm_num) hCA2 hCd)
    (card_sub_one_dvd_orderOf_xiQuot S hGs he hA2ne)

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.HS.centralizer_eq_A_of_comm_C_A =====
section

namespace Work.Higman.HS

open scoped commutatorElement

/-- A subgroup invariant under an automorphism has invariant centralizer. -/
private theorem centralizer_map_xi_eq_aux {P : Type} [Group P] {A : Subgroup P} (ξ : MulAut P)
    (hAinv : A.map (ξ : MulAut P).toMonoidHom = A) :
    (Subgroup.centralizer (A : Set P)).map (ξ : MulAut P).toMonoidHom
      = Subgroup.centralizer (A : Set P) := by
  have mem_iff : ∀ g : P, (∀ a ∈ A, a * g = g * a) ↔
      g ∈ Subgroup.centralizer (A : Set P) := fun g => Subgroup.mem_centralizer_iff
  refine le_antisymm ?_ ?_
  · rintro y ⟨x, hx, rfl⟩
    refine (mem_iff (ξ x)).mpr ?_
    intro a ha
    have hx' := (mem_iff x).mp hx
    have h1 := hx' ((ξ : MulAut P).symm a) (Work.Higman.symm_mem_of_map_eq ξ hAinv ha)
    calc a * ξ x = ξ ((ξ : MulAut P).symm a) * ξ x := by simp
      _ = ξ ((ξ : MulAut P).symm a * x) := by simp
      _ = ξ (x * (ξ : MulAut P).symm a) := by rw [h1]
      _ = ξ x * a := by simp
  · intro y hy
    refine ⟨(ξ : MulAut P).symm y, ?_, by simp⟩
    refine (mem_iff ((ξ : MulAut P).symm y)).mpr ?_
    intro a ha
    have hy' := (mem_iff y).mp hy
    have h2 : ξ a ∈ A := by
      have h3 := Subgroup.mem_map_of_mem (ξ : MulAut P).toMonoidHom ha
      rwa [hAinv] at h3
    have h1 := hy' (ξ a) h2
    have h4 : a * (ξ : MulAut P).symm y = (ξ : MulAut P).symm y * a := by
      have := congrArg (ξ : MulAut P).symm h1
      simpa using this
    exact h4

/-- **`C_P(A) = A` in the `C₄`-covering configuration.**

Let `P` be a Suzuki 2-group and `A ⊴ P` abelian, `ξ`-invariant, with `Ω₁(P) ≤ A`,
`⁅P,P⁆ = A`, every square of `P` in `A`, `A⁴ = ⊥`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`.
Then the centraliser of `A` is `A`.

The proof uses only the structure of `A` and a minimal `ξ`-invariant normal subgroup
`A < F ≤ C_P(A)`: the key observation is that an element `x` of `C_P(A)` with `x² ∈ A²`
lies in `A` (if `x² = a²` with `a ∈ A`, then `(x a)² = x⁴ = 1` because `x` commutes with `a`
and `A⁴ = ⊥`, so `x a ∈ Ω₁(P) ≤ A`), which rules out `F² = A²` at once.  The remaining
possibilities `F² = A` are dispatched by the three clean lemmas `RedAux.abelian_case`,
`RedAux.deriv_eq_sq_false` and `MSA.lemma8_clean`. -/
private theorem centralizer_eq_A_of_comm_C_A {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) :
    Subgroup.centralizer (A : Set P) = A := by
  classical
  set K : Subgroup P := Subgroup.centralizer (A : Set P) with hK
  have hAK : A ≤ K := by
    intro a ha
    rw [hK, Subgroup.mem_centralizer_iff]
    intro y hy
    exact hAab y hy a ha
  -- **Key lemma**: an element of `C_P(A)` whose square lies in `A²` already lies in `A`.
  have hkey : ∀ x ∈ K, x ^ 2 ∈ Work.Higman.powSub A 2 → x ∈ A := by
    intro x hxK hx2
    have hxK' : x ∈ Subgroup.centralizer (A : Set P) := by rwa [hK] at hxK
    obtain ⟨a, ha, haeq⟩ := (Work.Higman.mem_powSub_iff hAab).mp hx2
    have hcomm : x * a = a * x := (Subgroup.mem_centralizer_iff.mp hxK' a ha).symm
    have ha4 : a ^ 4 = 1 := by
      have hmem : a ^ 4 ∈ Work.Higman.powSub A 4 := Work.Higman.pow_mem_powSub ha
      rw [hA4] at hmem
      simpa using hmem
    have hx4 : (x ^ 2) ^ 2 = 1 := by rw [← haeq, ← pow_mul]; exact ha4
    have hsq : (x * a) ^ 2 = 1 := by
      rw [Commute.mul_pow hcomm, haeq, ← pow_two]; exact hx4
    have hmem : x * a ∈ A := hNA (h.mem_omega1.mpr hsq)
    have : x = (x * a) * a⁻¹ := by group
    rw [this]
    exact A.mul_mem hmem (A.inv_mem ha)
  -- `A ≠ A²`, from `|A| = |Ω₁(P)|²` and `4 ≤ |Ω₁(P)|`.
  have hAne2 : A ≠ Work.Higman.powSub A 2 := by
    intro heq
    have hc : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
      congrArg (fun X : Subgroup P => Nat.card ↥X) heq
    rw [htop] at hc
    have hq : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
      rw [← hcard, hc]
    have h4 := h.omega1_card_ge_four
    have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
    nlinarith [hq, h4, hpos]
  refine le_antisymm ?_ hAK
  by_contra hKA
  -- `K > A`: choose `F` minimal with `A < F ≤ K`.
  have hKAne : K ≠ A := fun hEq => hKA (le_of_eq hEq)
  have hKn : K.Normal := by rw [hK]; infer_instance
  have hKinv : K.map (h.xi : MulAut P).toMonoidHom = K := by
    rw [hK]; exact centralizer_map_xi_eq_aux h.xi hAxi
  obtain ⟨F, hFn, hFinv, hAF, hFK, hFA, hcoverF⟩ :=
    Work.Higman.MSA.exists_minimal_covering h (A := A) (M := K) hKn hKinv hAK hKAne
  -- any subgroup containing `A` is normal, because `⁅P,P⁆ = A`
  have hnorm_of_le : ∀ D : Subgroup P, A ≤ D → D.Normal := by
    intro D hAD
    refine Subgroup.Normal.mk fun n hn g => ?_
    have h1 : ⁅g, n⁆ ∈ A := by
      rw [← hGs]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top n)
    rw [show g * n * g⁻¹ = ⁅g, n⁆ * n from by rw [commutatorElement_def]; group]
    exact D.mul_mem (hAD h1) hn
  -- the version of `hcoverF` used by the clean case lemmas (no `Normal` hypothesis)
  have hcoverF' : ∀ D : Subgroup P, A ≤ D → D ≤ F →
      D.map (h.xi : MulAut P).toMonoidHom = D → D = A ∨ D = F :=
    fun D hAD hDF hDinv => hcoverF D (hnorm_of_le D hAD) hDinv hAD hDF
  -- squares of `F` lie in `A`
  have hF2leA : Work.Higman.powSub F 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  have hF2inv : (Work.Higman.powSub F 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub F 2 := Work.Higman.map_powSub (h.xi : MulAut P) hFinv 2
  have hFFleA : (⁅F, F⁆ : Subgroup P) ≤ A := by
    calc ⁅F, F⁆ ≤ ⁅(⊤ : Subgroup P), ⊤⁆ := Subgroup.commutator_mono le_top le_top
      _ = A := hGs
  have hFFinv : (⁅F, F⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅F, F⁆ := by
    rw [Subgroup.map_commutator, hFinv]
  rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hF2leA hF2inv with hF2bot | hF2A2 | hF2A
  · -- `F² = ⊥`: then `F ≤ Ω₁(P) ≤ A`
    have hFleOm : F ≤ Work.Higman.omega1 P := by
      intro x hx
      rw [h.mem_omega1]
      have : x ^ 2 ∈ Work.Higman.powSub F 2 := Work.Higman.pow_mem_powSub hx
      rw [hF2bot] at this
      simpa using this
    exact hFA (le_antisymm (hFleOm.trans hNA) hAF)
  · -- `F² = A²`: the key lemma forces `F ≤ A`
    have hFleA : F ≤ A := by
      intro x hx
      refine hkey x (hFK hx) ?_
      have : x ^ 2 ∈ Work.Higman.powSub F 2 := Work.Higman.pow_mem_powSub hx
      rwa [hF2A2] at this
    exact hFA (le_antisymm hFleA hAF)
  · -- `F² = A`: split on `[F,F]`
    rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hFFleA hFFinv with hFFbot | hFFA2 | hFFA
    · -- `[F,F] = ⊥`: `F` is abelian, excluded by Higman's Lemma 8 machinery
      have hFab : ∀ x ∈ F, ∀ y ∈ F, x * y = y * x := by
        intro x hx y hy
        have h1 : ⁅x, y⁆ ∈ (⊥ : Subgroup P) := by
          rw [← hFFbot]
          exact Subgroup.commutator_mem_commutator hx hy
        exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1)
      exact Work.Higman.RedAux.abelian_case h hAxi hAab hNA hGs hsq hA4 htop hcard
        hAF hFA hFinv hFab hF2A hcoverF'
    · -- `[F,F] = A²`: impossible by Higman's Lemma 8 (the `E' = A²`, `E² = A` case)
      exact Work.Higman.RedAux.deriv_eq_sq_false h hAxi hAab hNA hGs hsq hA4 htop hcard
        hAF hFA hFinv hcoverF' hFFA2 hF2A
    · -- `[F,F] = A`: Higman's Lemma 8 gives `A ≤ Ω₁(P) = A²`, contradicting `A ≠ A²`
      have hAA : ∀ a ∈ A, a * a = 1 :=
        Work.Higman.MSA.lemma8_clean h ⟨hAn, hAxi, hAab⟩ hFn hFinv hAF hFA.symm hcoverF
          hF2leA hFFA
      have hAle : A ≤ Work.Higman.powSub A 2 := by
        intro a ha
        rw [htop]
        exact h.mem_omega1.mpr (by rw [pow_two]; exact hAA a ha)
      exact hAne2 (le_antisymm hAle (Work.Higman.powSub_le (by norm_num)))

end Work.Higman.HS
end

-- ===== from Submission.Work.Higman.nsd_L1 =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped commutatorElement

namespace Work.Higman

variable {P : Type} [Group P] [Finite P]

/-! ## The quotient `P ⧸ A` when `[P,P] ≤ A` -/

/-- If `A` contains the commutator subgroup then `P ⧸ A` is abelian. -/
private theorem nsdL1_quotA_mul_comm {A : Subgroup P} [A.Normal] (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A)
    (a b : P ⧸ A) : a * b = b * a := by
  refine Quotient.inductionOn a (fun x => ?_)
  refine Quotient.inductionOn b (fun y => ?_)
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
  have key : (x * y)⁻¹ * (y * x) = ⁅y⁻¹, x⁻¹⁆ := by
    simp only [commutatorElement_def, mul_inv_rev, inv_inv, mul_assoc]
  rw [key]
  exact hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top y⁻¹) (Subgroup.mem_top x⁻¹))

/-- The `CommGroup` structure on `P ⧸ A` (its group structure is abelian). -/
@[instance_reducible]
private noncomputable def nsdL1_quotACommGroup {A : Subgroup P} [A.Normal]
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A) : CommGroup (P ⧸ A) :=
  { (inferInstance : Group (P ⧸ A)) with mul_comm := nsdL1_quotA_mul_comm hcomm }

/-- `[x * y, z] = x * [y, z] * x⁻¹ * [x, z]`. -/
private theorem nsdL1_commutator_mul_left_eq'_ (x y z : P) :
    ⁅x * y, z⁆ = x * ⁅y, z⁆ * x⁻¹ * ⁅x, z⁆ := by
  simp only [commutatorElement_def]
  group

/-- `[x, y * z] = [x, y] * (y * [x, z] * y⁻¹)`. -/
private theorem nsdL1_commutator_mul_right_eq'_ (x y z : P) :
    ⁅x, y * z⁆ = ⁅x, y⁆ * (y * ⁅x, z⁆ * y⁻¹) := by
  simp only [commutatorElement_def]
  group

/-- **The first layer `P/A` is a finite field with a Singer cycle.**

In the `C₄` setting (a Suzuki 2-group `P`, a `ξ`-invariant abelian normal `A` with `Ω₁(P) ≤ A`,
`[P,P] = A`, all squares of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`, with no
normal `ξ`-invariant subgroup strictly between `A` and `P`) the quotient `P/A` has the same order
as `Ω₁(P)`, say `2 ^ n` with `n ≥ 2`, and `ξ` acts on it as multiplication by a generator of the
multiplicative group of a finite field.

**Do not use `Work.Higman.no_square_derived` or `Work.Higman.nsd_false_of_irreducible`** (they
have the same hypotheses and are unfinished; using them would be circular and would leave
`sorryAx` in the proof).

Route.  `|Ω₁(P)| = 2 ^ n` for a unique `n ≥ 2` (`Work.Higman.exists_card_omega1_eq_two_pow`,
`omega1_card_ge_four`).  `P/A` is an elementary abelian `2`-group (`hGs` makes it abelian, `hsq`
gives exponent `2`), hence a `ZMod 2`-module on which `ξ` acts linearly.
(a) The squaring map `P → P/A` descends to a well defined *injection*: by `hirr` its kernel is a
`ξ`-invariant normal subgroup between `A` and `P`, hence `A` or `P`, and it is not `P`; use
`Work.Higman.aux_sq4` (`(u*a)^4 = u^4` for `a ∈ A`, in `Submission/Work/Higman/nsd_transfer.lean`)
to see that the fourth powers of two elements of the same coset of `A` agree.  Hence
`|P/A| ≤ |Ω₁(P)| = 2 ^ n`.
(b) `orderOf ξ = 2 ^ n - 1` on `P/A`.  If `η = ξ^k` is the identity on `Ω₁(P)` then it is the
identity on `P/A`: for `a ∈ A` the map `u ↦ ⁅u, a⁆ ∈ A² = Ω₁(P)` is `ξ`-equivariant and
non-degenerate (`⁅u, a⁆ = 1` for all `a ∈ A` implies `u ∈ C_P(A) = A` by `hirr`), so `η u = u`.
Conversely `[P,P] = A` (with `A/A² ≅ Ω₁(P)`) is generated by commutators, so if `η` is trivial on
`P/A` it is trivial on `Ω₁(P)`;  hence the actions of `⟨ξ⟩` on `P/A` and on `Ω₁(P)` have the same
kernel and `orderOf ξ = 2 ^ n - 1`.
(c) `ξ` is fixed-point free on `(P/A) \ {A}` (a fixed point generates the irreducible module), so
all `ξ`-orbits there have size `2 ^ n - 1`;  hence `2 ^ n - 1 ∣ |P/A| - 1`.  Combined with
`|P/A| ≤ 2 ^ n` this gives `|P/A| = 2 ^ n`.
(d) Apply `Work.Higman.exists_singer_iso` (`Submission/Work/Higman/exists_singer_iso.lean`) to the
`ZMod 2`-module `P/A` and the linear automorphism induced by `ξ`, and transport along the
`ZMod 2`-linear isomorphism to get `ζ` (and take `λ` the generator of `GaloisField 2 nˣ`);
the equivariance statement follows from the definition of the induced action, and
`Work.Higman.aux_sq_wd`/`L1_sq_eq_one`-style facts give additivity of `ζ`. -/
private theorem nsdL1_orbit_invol (h : IsSuzuki2Grp P) {u : P} (hu : orderOf u = 2) :
    (MulAction.orbit (Subgroup.zpowers h.xi) u : Set P) = Invol P := by
  ext z
  rw [MulAction.mem_orbit_iff, mem_Invol]
  constructor
  · rintro ⟨g, rfl⟩
    show orderOf (g • u) = 2
    rw [show g • u = (g : MulAut P) u from rfl, MulEquiv.orderOf_eq, hu]
  · intro hz
    obtain ⟨k, hk⟩ := h.trans u z hu hz
    refine ⟨⟨h.xi ^ k, ?_⟩, hk⟩
    exact Subgroup.pow_mem (Subgroup.zpowers h.xi) (Subgroup.mem_zpowers h.xi) k

/-- Every orbit of `⟨ξ⟩` on `P \ {1}` has cardinality divisible by `|Ω₁(P)| - 1`. -/
private theorem nsdL1_invol_ncard_dvd_orbit (h : IsSuzuki2Grp P) {x : P} (hx : x ≠ 1) :
    (Invol P).ncard ∣ Nat.card ↥(MulAction.orbit (Subgroup.zpowers h.xi) x) := by
  classical
  set K : Subgroup (MulAut P) := Subgroup.zpowers h.xi with hK
  obtain ⟨u, -, hu2, -, -⟩ := h.manyInvol
  -- orbit–stabiliser for the involution `u`
  have horb_u : Nat.card ↥(MulAction.orbit K u) = (Invol P).ncard := by
    rw [Nat.card_coe_set_eq, nsdL1_orbit_invol h hu2]
  have hos_u : (Invol P).ncard * Nat.card ↥(MulAction.stabilizer K u) = orderOf h.xi := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup K u)
    rw [Nat.card_prod, hK, Nat.card_zpowers] at hh
    rwa [horb_u] at hh
  -- `x` has `2`-power order
  obtain ⟨s, hs⟩ := h.isPGroup.exists_orderOf_eq_pow x
  have hs1 : 1 ≤ s := by
    rcases Nat.eq_zero_or_pos s with h0 | hpos
    · subst h0
      simp only [pow_zero] at hs
      exact absurd (orderOf_eq_one_iff.mp hs) hx
    · exact hpos
  set w : P := x ^ 2 ^ (s - 1) with hw
  have hw1 : w ≠ 1 := by
    intro hcon
    have hdvd : 2 ^ s ∣ 2 ^ (s - 1) := by
      rw [← hs]
      exact orderOf_dvd_iff_pow_eq_one.mpr (by rw [← hw]; exact hcon)
    have hlt : 2 ^ (s - 1) < 2 ^ s := Nat.pow_lt_pow_right (by norm_num) (by omega)
    exact absurd (Nat.le_of_dvd (pow_pos (by norm_num) _) hdvd) (by omega)
  have hw2 : orderOf w = 2 := by
    have hpow : w ^ 2 = 1 := by
      have hexp : 2 ^ (s - 1) * 2 = 2 ^ s := by
        rw [← pow_succ]
        congr 1
        omega
      rw [hw, ← pow_mul, hexp, ← hs, pow_orderOf_eq_one]
    have hd : orderOf w ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hpow
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
    · exact absurd (orderOf_eq_one_iff.mp h1) hw1
    · exact h2
  -- the stabiliser of `x` is contained in that of `w`
  have hstab_le : MulAction.stabilizer K x ≤ MulAction.stabilizer K w := by
    intro γ hγ
    rw [MulAction.mem_stabilizer_iff] at hγ ⊢
    have h1 : (γ : MulAut P) x = x := hγ
    show (γ : MulAut P) w = w
    rw [hw, map_pow, h1]
  -- stabilisers of involutions have the same cardinality
  have hcard_stab_w : Nat.card ↥(MulAction.stabilizer K w) =
      Nat.card ↥(MulAction.stabilizer K u) := by
    have h1 := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup K w)
    rw [Nat.card_prod, hK, Nat.card_zpowers] at h1
    have h2 : Nat.card ↥(MulAction.orbit K w) = (Invol P).ncard := by
      rw [Nat.card_coe_set_eq, nsdL1_orbit_invol h hw2]
    rw [h2] at h1
    have hpos : 0 < (Invol P).ncard :=
      (Set.ncard_pos (Set.toFinite (Invol P))).mpr ⟨u, mem_Invol.mpr hu2⟩
    exact Nat.eq_of_mul_eq_mul_left hpos (by rw [h1, hos_u])
  -- orbit–stabiliser for `x`
  have hos_x : Nat.card ↥(MulAction.orbit K x) * Nat.card ↥(MulAction.stabilizer K x) =
      orderOf h.xi := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup K x)
    rw [Nat.card_prod, hK, Nat.card_zpowers] at hh
    exact hh
  -- `|Stab x|` divides `|Stab u|`
  have hdiv : Nat.card ↥(MulAction.stabilizer K x) ∣
      Nat.card ↥(MulAction.stabilizer K u) := by
    rw [← hcard_stab_w]
    exact Subgroup.card_dvd_of_le hstab_le
  obtain ⟨c, hc⟩ := hdiv
  have key : Nat.card ↥(MulAction.orbit K x) * Nat.card ↥(MulAction.stabilizer K x) =
      (Invol P).ncard * Nat.card ↥(MulAction.stabilizer K u) := by rw [hos_x, hos_u]
  refine ⟨c, ?_⟩
  have hpos : 0 < Nat.card ↥(MulAction.stabilizer K x) := Nat.card_pos
  have h2 : Nat.card ↥(MulAction.orbit K x) * Nat.card ↥(MulAction.stabilizer K x) =
      ((Invol P).ncard * c) * Nat.card ↥(MulAction.stabilizer K x) := by
    rw [key, hc]
    ring
  exact Nat.eq_of_mul_eq_mul_right hpos h2

/-- **Orbit counting.**  `|Ω₁(P)| - 1` divides `|P| - 1` for a Suzuki 2-group `P`. -/
private theorem nsdL1_card_omega1_sub_one_dvd_card_sub_one (h : IsSuzuki2Grp P) :
    Nat.card (omega1 P) - 1 ∣ Nat.card P - 1 := by
  classical
  haveI : Fintype P := Fintype.ofFinite P
  set K : Subgroup (MulAut P) := Subgroup.zpowers h.xi with hK
  have hq : Nat.card (omega1 P) - 1 = (Invol P).ncard := by
    rw [h.card_omega1, Nat.add_sub_cancel]
  rw [hq]
  -- `P \ {1}` is the disjoint union of its orbits
  set s : Finset P := Finset.univ.filter (fun x : P => x ≠ 1) with hs
  have hcard_s : s.card = Nat.card P - 1 := by
    rw [hs]
    have h1 : (Finset.univ.filter (fun x : P => x ≠ 1)).card +
        (Finset.univ.filter (fun x : P => ¬ x ≠ 1)).card = (Finset.univ : Finset P).card :=
      Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset P))
        (p := fun x : P => x ≠ 1)
    have h2 : (Finset.univ.filter (fun x : P => ¬ x ≠ 1)).card = 1 := by
      have hset : (Finset.univ.filter (fun x : P => ¬ x ≠ 1)) = {1} := by
        ext x
        simp
      rw [hset]
      simp
    have h3 : (Finset.univ : Finset P).card = Nat.card P := by
      rw [Finset.card_univ, Nat.card_eq_fintype_card]
    omega
  have hpartition := Finset.card_eq_sum_card_image
    (f := fun x : P => MulAction.orbit K x) s
  have hdvd : (Invol P).ncard ∣ s.card := by
    rw [hpartition]
    apply Finset.dvd_sum
    intro b hb
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hb
    have hx1 : x ≠ 1 := by simpa [hs] using hx
    have h1not : (1 : P) ∉ MulAction.orbit K x := by
      intro hmem
      rw [MulAction.mem_orbit_iff] at hmem
      obtain ⟨γ, hγ⟩ := hmem
      have : x = 1 := by
        calc x = γ⁻¹ • (γ • x) := by rw [inv_smul_smul]
          _ = γ⁻¹ • (1 : P) := by rw [hγ]
          _ = 1 := by simp
      exact hx1 this
    have hfiber : (s.filter (fun a : P => MulAction.orbit K a = MulAction.orbit K x)).card =
        Nat.card ↥(MulAction.orbit K x) := by
      have hset : (s.filter (fun a : P => MulAction.orbit K a = MulAction.orbit K x)) =
          ((MulAction.orbit K x : Set P)).toFinset := by
        ext a
        simp only [Finset.mem_filter, Set.mem_toFinset, MulAction.orbit_eq_iff, hs,
          Finset.mem_filter, Finset.mem_univ, true_and]
        constructor
        · rintro ⟨-, ha⟩
          exact ha
        · intro ha
          exact ⟨fun hcon => h1not (hcon ▸ ha), ha⟩
      rw [hset, Set.toFinset_card]
      exact (Nat.card_eq_fintype_card).symm
    rw [hfiber]
    exact nsdL1_invol_ncard_dvd_orbit h hx1
  rw [← hcard_s]
  exact hdvd

private theorem L1_iso_field_exp {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hirr : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D = A ∨ D = ⊤)
    (n : ℕ) (hn : Nat.card ↥(Work.Higman.omega1 P) = 2 ^ n) :
    ∃ (F : Type) (_ : Field F) (_ : Fintype F) (_ : DecidableEq F) (_ : CharP F 2)
      (lam : F),
      Fintype.card F = 2 ^ n ∧ 2 ≤ n ∧ orderOf lam = 2 ^ n - 1 ∧ lam ≠ 0 ∧
      ∃ ζ : F ≃ (P ⧸ A), (∀ x y : F, ζ (x + y) = ζ x * ζ y) ∧
        (∀ x : F, ∀ u : P, (u : P ⧸ A) = ζ x → ζ (lam * x) = (h.xi u : P ⧸ A)) := by
  classical
  -- ## 0.  Elementary data
  have hcommA : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A := le_of_eq hGs
  letI qc : CommGroup (P ⧸ A) := nsdL1_quotACommGroup hcommA
  haveI : Finite (P ⧸ A) :=
    Finite.of_surjective (QuotientGroup.mk' A) (QuotientGroup.mk'_surjective A)
  have hq4 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
  have hn2 : 2 ≤ n := by
    have h4 : 4 ≤ 2 ^ n := by rw [← hn]; exact hq4
    by_contra hcon
    have h1 : n ≤ 1 := by omega
    have h2 : 2 ^ n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) h1
    norm_num at h2
    omega
  have hn0 : 0 < n := by omega
  have hqcard : Nat.card ↥(omega1 P) = 2 ^ n := hn
  have hAcard : Nat.card ↥A = 2 ^ (2 * n) := by
    rw [hcard, hn]
    ring_nf
  have hA_ne_top : A ≠ ⊤ := by
    intro hAtop
    obtain ⟨x, y, hxy⟩ := h.noncomm
    have hx : x ∈ A := by rw [hAtop]; trivial
    have hy : y ∈ A := by rw [hAtop]; trivial
    exact hxy (hAab x hx y hy)
  haveI : Nontrivial (P ⧸ A) := by
    by_contra hsub
    rw [not_nontrivial_iff_subsingleton] at hsub
    refine hA_ne_top (le_antisymm le_top (fun x _ => ?_))
    have h1 : (QuotientGroup.mk' A) x = 1 := Subsingleton.elim _ _
    rwa [← MonoidHom.mem_ker, QuotientGroup.ker_mk'] at h1
  -- ## 1.  The `𝔽₂`-vector space `V = P/A`
  let V := Additive (P ⧸ A)
  have h2zero : ∀ x : V, 2 • x = 0 := by
    intro x
    obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = x := ⟨Additive.toMul x, rfl⟩
    have hw : w * w = 1 := by
      refine Quotient.inductionOn w (fun u => ?_)
      show (QuotientGroup.mk' A) u * (QuotientGroup.mk' A) u = 1
      rw [← map_mul, ← MonoidHom.mem_ker, QuotientGroup.ker_mk']
      simpa [pow_two] using hsq u
    calc 2 • (Additive.ofMul w) = Additive.ofMul w + Additive.ofMul w := two_nsmul _
      _ = Additive.ofMul (w * w) := ofMul_mul w w
      _ = 0 := by rw [hw]; rfl
  letI : Module (ZMod 2) V := AddCommGroup.zmodModule h2zero
  -- the automorphism of `P/A` induced by `ξ`
  have hAxi_inv : A.map ((h.xi : MulAut P)⁻¹).toMonoidHom = A := by
    refine le_antisymm ?_ ?_
    · rintro x ⟨y, hy, rfl⟩
      exact symm_mem_of_map_eq h.xi hAxi hy
    · intro x hx
      refine ⟨h.xi x, ?_, by simp⟩
      have h1 := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) hx
      rwa [hAxi] at h1
  let ξQ : (P ⧸ A) ≃* (P ⧸ A) :=
    { toFun := QuotientGroup.map A A (h.xi : MulAut P).toMonoidHom
        (by rw [← Subgroup.map_le_iff_le_comap, hAxi])
      invFun := QuotientGroup.map A A ((h.xi : MulAut P)⁻¹).toMonoidHom
        (by rw [← Subgroup.map_le_iff_le_comap, hAxi_inv])
      left_inv := by
        intro a
        refine Quotient.inductionOn a (fun x => ?_)
        simp only [QuotientGroup.map_mk]
        simp
      right_inv := by
        intro a
        refine Quotient.inductionOn a (fun x => ?_)
        simp only [QuotientGroup.map_mk]
        simp
      map_mul' := fun a b => map_mul _ a b }
  have ξQ_mk : ∀ x : P, ξQ (QuotientGroup.mk x) = QuotientGroup.mk (h.xi x) := fun x =>
    QuotientGroup.map_mk A A (h.xi : MulAut P).toMonoidHom
      (by rw [← Subgroup.map_le_iff_le_comap, hAxi]) x
  have ξQ_mk' : ∀ x : P, ξQ ((QuotientGroup.mk' A) x) = (QuotientGroup.mk' A) (h.xi x) := by
    intro x
    rw [QuotientGroup.mk'_apply A x, QuotientGroup.mk'_apply A (h.xi x), ξQ_mk]
  have ξQ_pow_mk : ∀ (k : ℕ) (x : P),
      (ξQ ^ k) (QuotientGroup.mk x) = QuotientGroup.mk ((h.xi ^ k) x) := by
    intro k
    induction k with
    | zero => intro x; simp
    | succ k ih =>
        intro x
        calc (ξQ ^ (k + 1)) (QuotientGroup.mk x)
            = (ξQ ^ k) (ξQ (QuotientGroup.mk x)) := by
                rw [pow_succ]
                rfl
          _ = (ξQ ^ k) (QuotientGroup.mk (h.xi x)) := by rw [ξQ_mk]
          _ = QuotientGroup.mk ((h.xi ^ k) (h.xi x)) := ih (h.xi x)
          _ = QuotientGroup.mk ((h.xi ^ (k + 1)) x) := by
                rw [pow_succ, MulAut.mul_apply]
  let σlin : V →ₗ[ZMod 2] V := AddMonoidHom.toZModLinearMap 2 (ξQ.toAdditive : V →+ V)
  have hσlin_apply : ∀ x : V, σlin x = ξQ.toAdditive x := fun x => rfl
  have hσlin : Function.Bijective σlin := by
    refine ⟨fun a b hab => ?_, fun b => ?_⟩
    · have hab' : ξQ.toAdditive a = ξQ.toAdditive b := by rw [← hσlin_apply, ← hσlin_apply]; exact hab
      exact ξQ.toAdditive.injective hab'
    · obtain ⟨a, ha⟩ := ξQ.toAdditive.surjective b
      exact ⟨a, by rw [hσlin_apply]; exact ha⟩
  let σ : V ≃ₗ[ZMod 2] V := LinearEquiv.ofBijective σlin hσlin
  have σ_ofMul : ∀ w : P ⧸ A, σ (Additive.ofMul w) = Additive.ofMul (ξQ w) := by
    intro w
    show (AddMonoidHom.toZModLinearMap 2 (ξQ.toAdditive : V →+ V)) (Additive.ofMul w)
      = Additive.ofMul (ξQ w)
    simp only [AddMonoidHom.coe_toZModLinearMap]
    rfl
  have σ_pow_ofMul : ∀ (k : ℕ) (w : P ⧸ A),
      (σ ^ k) (Additive.ofMul w) = Additive.ofMul ((ξQ ^ k) w) := by
    intro k
    induction k with
    | zero => intro w; simp
    | succ k ih =>
        intro w
        rw [pow_succ', LinearEquiv.mul_apply, ih, σ_ofMul, pow_succ']
        rfl
  -- ## 2.  `ξ ^ k` acting trivially on `V` is the same as on the cosets of `A`
  have htrivV : ∀ k : ℕ, ξQ ^ k = 1 ↔ ∀ u : P, ((h.xi ^ k) u) * u⁻¹ ∈ A := by
    intro k
    constructor
    · intro hk u
      have h1 : (ξQ ^ k) (QuotientGroup.mk u) = QuotientGroup.mk u := by rw [hk]; rfl
      rw [ξQ_pow_mk] at h1
      have h2 : ((h.xi ^ k) u)⁻¹ * u ∈ A := QuotientGroup.eq.mp h1
      have h3 : u * (((h.xi ^ k) u)⁻¹ * u) * u⁻¹ ∈ A := hAn.conj_mem _ h2 u
      have h4 : u * ((h.xi ^ k) u)⁻¹ ∈ A := by simpa [mul_assoc] using h3
      have h5 : (u * ((h.xi ^ k) u)⁻¹)⁻¹ ∈ A := A.inv_mem h4
      simpa [mul_inv_rev] using h5
    · intro hk
      refine MulEquiv.ext (fun w => ?_)
      refine Quotient.inductionOn w (fun u => ?_)
      rw [ξQ_pow_mk]
      refine QuotientGroup.eq.mpr ?_
      have h1 : u⁻¹ * (((h.xi ^ k) u) * u⁻¹) * u ∈ A := by
        simpa using hAn.conj_mem (((h.xi ^ k) u) * u⁻¹) (hk u) u⁻¹
      have h2 : u⁻¹ * ((h.xi ^ k) u) ∈ A := by simpa [mul_assoc] using h1
      simpa [mul_inv_rev] using A.inv_mem h2
  -- ## 3.  `ξ` preserves `A`;  `C_P(A) = A`
  have hxiA : ∀ (k : ℕ) (a : P), a ∈ A → (h.xi ^ k) a ∈ A := by
    intro k a ha
    induction k with
    | zero => simpa using ha
    | succ k ih =>
        rw [pow_succ', MulAut.mul_apply]
        have h1 := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) ih
        rwa [hAxi] at h1
  have hCP : Subgroup.centralizer (A : Set P) = A := by
    have hAC : A ≤ Subgroup.centralizer (A : Set P) := by
      intro a ha
      refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
      exact hAab b hb a ha
    have hCn : (Subgroup.centralizer (A : Set P)).Normal := by
      refine ⟨fun x hx g => ?_⟩
      refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
      have hx' : ∀ c ∈ A, c * x = x * c := Subgroup.mem_centralizer_iff.mp hx
      have hgb : g⁻¹ * b * g ∈ A := by
        have h1 := hAn.conj_mem b hb g⁻¹
        simpa [mul_assoc] using h1
      have h1 := hx' (g⁻¹ * b * g) hgb
      calc b * (g * x * g⁻¹) = g * (g⁻¹ * b * g) * x * g⁻¹ := by group
        _ = g * (x * (g⁻¹ * b * g)) * g⁻¹ := by rw [← h1]; group
        _ = (g * x * g⁻¹) * b := by group
    have hCinv : (Subgroup.centralizer (A : Set P)).map (h.xi : MulAut P).toMonoidHom
        = Subgroup.centralizer (A : Set P) := by
      refine le_antisymm ?_ ?_
      · rintro x ⟨y, hy, rfl⟩
        refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
        have hy' : ∀ c ∈ A, c * y = y * c := Subgroup.mem_centralizer_iff.mp hy
        have hb' : (h.xi : MulAut P).symm b ∈ A := symm_mem_of_map_eq h.xi hAxi hb
        have h1 := hy' ((h.xi : MulAut P).symm b) hb'
        have h2 := congrArg (fun t : P => h.xi t) h1
        simpa using h2
      · intro x hx
        refine ⟨(h.xi : MulAut P).symm x, ?_, by simp⟩
        refine Subgroup.mem_centralizer_iff.mpr (fun b hb => ?_)
        have hx' : ∀ c ∈ A, c * x = x * c := Subgroup.mem_centralizer_iff.mp hx
        have hb' : h.xi b ∈ A := by
          have h1 := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) hb
          rwa [hAxi] at h1
        have h1 := hx' (h.xi b) hb'
        have h2 := congrArg (fun t : P => (h.xi : MulAut P).symm t) h1
        simpa using h2
    have hCne : Subgroup.centralizer (A : Set P) ≠ ⊤ := by
      intro hCtop
      apply aux_comm_ne_bot h hAab hNA hGs hsq htop
      refine le_bot_iff.mp ?_
      refine Subgroup.commutator_le.mpr (fun a ha g _ => ?_)
      have hg : g ∈ Subgroup.centralizer (A : Set P) := by rw [hCtop]; trivial
      have hg' : ∀ c ∈ A, c * g = g * c := Subgroup.mem_centralizer_iff.mp hg
      rw [commutatorElement_eq_one_iff_mul_comm.mpr (hg' a ha)]
      exact Subgroup.one_mem _
    rcases hirr _ hCn hCinv hAC with h1 | h1
    · exact h1
    · exact absurd h1 hCne
  -- ## 4.  The two kernel inclusions
  have hcen2 : ∀ z ∈ powSub A 2, ∀ y : P, y * z * y⁻¹ = z := aux_conj_eq h htop
  have hcen2' : ∀ z ∈ powSub A 2, ∀ y : P, y * z = z * y := by
    intro z hz y
    have h1 := hcen2 z hz y
    have h2 : y * z * y⁻¹ * y = y * z := by group
    calc y * z = y * z * y⁻¹ * y := h2.symm
      _ = z * y := by rw [h1]
  have hsq_one : ∀ z ∈ powSub A 2, z ^ 2 = 1 := by
    intro z hz
    exact h.mem_omega1.mp (by rw [← htop]; exact hz)
  -- (b₁)  trivial on `P/A` ⟹ trivial on `Ω₁(P)`
  have dir1 : ∀ k : ℕ, (∀ u : P, ((h.xi ^ k) u) * u⁻¹ ∈ A) →
      ∀ z : P, z ∈ omega1 P → (h.xi ^ k) z = z := by
    intro k hk z hz
    have hstep : ∀ a ∈ A, ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := by
      let S : Subgroup P :=
        { carrier := {a : P | a ∈ A ∧ ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2}
          one_mem' := by
            refine ⟨A.one_mem, ?_⟩
            simpa using (powSub A 2).one_mem
          mul_mem' := by
            intro a b ha hb
            refine ⟨A.mul_mem ha.1 hb.1, ?_⟩
            have hηa : (h.xi ^ k) a ∈ A := hxiA k a ha.1
            have hηb : (h.xi ^ k) b ∈ A := hxiA k b hb.1
            have hYV : Commute ((h.xi ^ k) b) b⁻¹ := hAab _ hηb _ (A.inv_mem hb.1)
            have hYU : Commute ((h.xi ^ k) b) a⁻¹ := hAab _ hηb _ (A.inv_mem ha.1)
            have hVU : Commute b⁻¹ a⁻¹ := hAab _ (A.inv_mem hb.1) _ (A.inv_mem ha.1)
            have h1 : (h.xi ^ k) (a * b) * (a * b)⁻¹
                = ((h.xi ^ k) a * a⁻¹) * ((h.xi ^ k) b * b⁻¹) := by
              rw [map_mul, mul_inv_rev]
              calc ((h.xi ^ k) a * (h.xi ^ k) b) * (b⁻¹ * a⁻¹)
                  = ((h.xi ^ k) a * b⁻¹) * ((h.xi ^ k) b * a⁻¹) :=
                    Commute.mul_mul_mul_comm hYV _ _
                _ = ((h.xi ^ k) a * b⁻¹) * (a⁻¹ * (h.xi ^ k) b) := by rw [hYU.eq]
                _ = ((h.xi ^ k) a * a⁻¹) * (b⁻¹ * (h.xi ^ k) b) :=
                      Commute.mul_mul_mul_comm hVU _ _
                _ = ((h.xi ^ k) a * a⁻¹) * ((h.xi ^ k) b * b⁻¹) := by rw [← hYV.eq]
            rw [h1]
            exact (powSub A 2).mul_mem ha.2 hb.2
          inv_mem' := by
            intro a ha
            refine ⟨A.inv_mem ha.1, ?_⟩
            have hηa : (h.xi ^ k) a ∈ A := hxiA k a ha.1
            have h1 : (h.xi ^ k) a⁻¹ * (a⁻¹)⁻¹ = (((h.xi ^ k) a) * a⁻¹)⁻¹ := by
              simp only [map_inv, inv_inv, mul_inv_rev]
              exact hAab _ (A.inv_mem hηa) _ ha.1
            rw [h1]
            exact (powSub A 2).inv_mem ha.2 }
      have hAleS : A ≤ S := by
        rw [← hGs]
        refine Subgroup.commutator_le.mpr (fun u _ v _ => ?_)
        refine ⟨?_, ?_⟩
        · rw [← hGs]
          exact Subgroup.commutator_mem_commutator (Subgroup.mem_top u) (Subgroup.mem_top v)
        · have h1 : (h.xi ^ k) ⁅u, v⁆ = ⁅(h.xi ^ k) u, (h.xi ^ k) v⁆ := by
            simpa using map_commutatorElement (f := ((h.xi ^ k : MulAut P) : P →* P)) u v
          have ha : u⁻¹ * ((h.xi ^ k) u) ∈ A := by
            have h2 := hAn.conj_mem ((h.xi ^ k) u * u⁻¹) (hk u) u⁻¹
            simpa [mul_assoc] using h2
          have hb : v⁻¹ * ((h.xi ^ k) v) ∈ A := by
            have h2 := hAn.conj_mem ((h.xi ^ k) v * v⁻¹) (hk v) v⁻¹
            simpa [mul_assoc] using h2
          have h3 := aux_comm_sq h hAxi hAab hGs htop u v ha hb
          rw [h1]
          simpa [mul_assoc] using h3
      intro a ha
      exact (hAleS ha).2
    -- `z ∈ Ω₁(P) = A²` is a square, and `ξ^k` fixes it
    obtain ⟨a, haA, rfl⟩ :=
      (mem_powSub_iff hAab (n := 2)).mp (by rw [htop]; exact hz)
    have hc : ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := hstep a haA
    have hηa : (h.xi ^ k) a ∈ A := hxiA k a haA
    have hc2 : (((h.xi ^ k) a) * a⁻¹) ^ 2 = 1 := hsq_one _ hc
    have key : ((h.xi ^ k) a) ^ 2 = a ^ 2 := by
      have hcomm : Commute (((h.xi ^ k) a) * a⁻¹) a :=
        hAab _ (A.mul_mem hηa (A.inv_mem haA)) _ haA
      have h1 : (((h.xi ^ k) a) * a⁻¹) * a = (h.xi ^ k) a := by group
      calc ((h.xi ^ k) a) ^ 2
          = ((((h.xi ^ k) a) * a⁻¹) * a) ^ 2 := congrArg (fun t => t ^ 2) h1.symm
        _ = (((h.xi ^ k) a) * a⁻¹) ^ 2 * a ^ 2 := hcomm.mul_pow 2
        _ = a ^ 2 := by rw [hc2, one_mul]
    rw [map_pow]
    exact key
  -- (b₂)  trivial on `Ω₁(P)` ⟹ trivial on `P/A`
  have dir2 : ∀ k : ℕ, (∀ z : P, z ∈ omega1 P → (h.xi ^ k) z = z) →
      ∀ u : P, ((h.xi ^ k) u) * u⁻¹ ∈ A := by
    intro k hk u
    -- (i) for `a ∈ A`: `ξ^k a * a⁻¹ ∈ A²`
    have hstep : ∀ a ∈ A, ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := by
      intro a ha
      have hηa : (h.xi ^ k) a ∈ A := hxiA k a ha
      have h1 : ((h.xi ^ k) a) ^ 2 = a ^ 2 := by
        have h2 := hk (a ^ 2) (by rw [← htop]; exact pow_mem_powSub ha)
        rwa [map_pow] at h2
      have h3 : (((h.xi ^ k) a) * a⁻¹) * (((h.xi ^ k) a) * a⁻¹) = 1 := by
        have hc : Commute ((h.xi ^ k) a) a⁻¹ := hAab _ hηa _ (A.inv_mem ha)
        rw [← pow_two, hc.mul_pow, inv_pow, h1, mul_inv_cancel]
      have h4 : ((h.xi ^ k) a * a⁻¹) ∈ omega1 P := by
        rw [h.mem_omega1, pow_two]
        exact h3
      rwa [← htop] at h4
    -- (ii) `⁅u, a⁆ = ⁅ξ^k u, a⁆` for `a ∈ A`
    have hstep2 : ∀ a ∈ A, ⁅u, a⁆ = ⁅(h.xi ^ k) u, a⁆ := by
      intro a ha
      have h1 : (h.xi ^ k) ⁅u, a⁆ = ⁅(h.xi ^ k) u, (h.xi ^ k) a⁆ := by
        simpa using map_commutatorElement (f := ((h.xi ^ k : MulAut P) : P →* P)) u a
      have h2 : (h.xi ^ k) ⁅u, a⁆ = ⁅u, a⁆ := by
        have hmem : ⁅u, a⁆ ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs u ha
        exact hk _ (by rw [← htop]; exact hmem)
      have hc : ((h.xi ^ k) a) * a⁻¹ ∈ powSub A 2 := hstep a ha
      have hca : (h.xi ^ k) a = (((h.xi ^ k) a) * a⁻¹) * a := by group
      have h3 : ⁅(h.xi ^ k) u, ((h.xi ^ k) a * a⁻¹) * a⁆ = ⁅(h.xi ^ k) u, a⁆ := by
        rw [nsdL1_commutator_mul_right_eq'_]
        have hz : ((h.xi ^ k) a * a⁻¹) * ⁅(h.xi ^ k) u, a⁆ * ((h.xi ^ k) a * a⁻¹)⁻¹
            = ⁅(h.xi ^ k) u, a⁆ := by
          rw [← hcen2' _ hc ⁅(h.xi ^ k) u, a⁆]
          group
        have hz2 : ⁅(h.xi ^ k) u, (h.xi ^ k) a * a⁻¹⁆ = 1 := by
          rw [commutatorElement_eq_one_iff_mul_comm]
          exact hcen2' _ hc _
        rw [hz2, hz, one_mul]
      calc ⁅u, a⁆ = (h.xi ^ k) ⁅u, a⁆ := h2.symm
        _ = ⁅(h.xi ^ k) u, (h.xi ^ k) a⁆ := h1
        _ = ⁅(h.xi ^ k) u, ((h.xi ^ k) a * a⁻¹) * a⁆ := by rw [← hca]
        _ = ⁅(h.xi ^ k) u, a⁆ := h3
    -- (iii) `[ξ^k u * u⁻¹, a] = 1`
    have hstep3 : ∀ a ∈ A, ⁅((h.xi ^ k) u) * u⁻¹, a⁆ = 1 := by
      intro a ha
      have hYa : ⁅u, a⁆ ∈ powSub A 2 := aux_bracket_mem h hAxi hAab hGs u ha
      have hX : ⁅u⁻¹, a⁆ = (⁅u, a⁆)⁻¹ := by
        have h1 : ⁅u⁻¹, a⁆ = u⁻¹ * (⁅u, a⁆)⁻¹ * u := by
          rw [commutatorElement_inv_left, ← commutatorElement_inv u a]
        rw [h1, hcen2' _ (Subgroup.inv_mem _ hYa) u⁻¹]
        group
      have hY : ⁅u⁻¹, a⁆ ∈ powSub A 2 := hX ▸ Subgroup.inv_mem _ hYa
      calc ⁅((h.xi ^ k) u) * u⁻¹, a⁆
          = (((h.xi ^ k) u) * ⁅u⁻¹, a⁆ * ((h.xi ^ k) u)⁻¹) * ⁅(h.xi ^ k) u, a⁆ :=
            nsdL1_commutator_mul_left_eq'_ _ _ _
        _ = ⁅u⁻¹, a⁆ * ⁅(h.xi ^ k) u, a⁆ := by
              rw [hcen2' _ hY ((h.xi ^ k) u)]
              group
        _ = ⁅u, a⁆⁻¹ * ⁅u, a⁆ := by rw [hX, ← hstep2 a ha]
        _ = 1 := inv_mul_cancel _
    rw [← hCP]
    refine Subgroup.mem_centralizer_iff.mpr (fun a ha => ?_)
    have h1 : ⁅a, ((h.xi ^ k) u) * u⁻¹⁆ = 1 := by
      rw [(commutatorElement_inv (((h.xi ^ k) u) * u⁻¹) a).symm, hstep3 a ha, inv_one]
    exact commutatorElement_eq_one_iff_mul_comm.mp h1
  -- ## 5.  `V` is irreducible for `σ`
  have hirrV : ∀ U : Submodule (ZMod 2) V, (∀ v ∈ U, σ v ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    have hUeq : σ '' (U : Set V) = U := by
      refine Set.eq_of_subset_of_ncard_le (fun v hv => ?_) ?_
      · rcases hv with ⟨w, hw, rfl⟩
        exact hU w hw
      · rw [Set.ncard_image_of_injective _ σ.injective]
    let D : Subgroup P :=
      { carrier := {y : P | Additive.ofMul ((QuotientGroup.mk' A) y) ∈ U}
        one_mem' := by
          show Additive.ofMul ((QuotientGroup.mk' A) 1) ∈ U
          rw [map_one]
          exact U.zero_mem
        mul_mem' := by
          intro x y hx hy
          show Additive.ofMul ((QuotientGroup.mk' A) (x * y)) ∈ U
          rw [map_mul, ofMul_mul]
          exact U.add_mem hx hy
        inv_mem' := by
          intro x hx
          show Additive.ofMul ((QuotientGroup.mk' A) x⁻¹) ∈ U
          rw [map_inv, ofMul_inv]
          exact U.neg_mem hx }
    have hDn : D.Normal := by
      refine ⟨fun y hy g => ?_⟩
      show Additive.ofMul ((QuotientGroup.mk' A) (g * y * g⁻¹)) ∈ U
      have h1 : (QuotientGroup.mk' A) (g * y * g⁻¹) = (QuotientGroup.mk' A) y := by
        rw [map_mul, map_mul, map_inv]
        calc (QuotientGroup.mk' A) g * (QuotientGroup.mk' A) y * ((QuotientGroup.mk' A) g)⁻¹
            = (QuotientGroup.mk' A) y * ((QuotientGroup.mk' A) g * ((QuotientGroup.mk' A) g)⁻¹) := by
              rw [mul_comm ((QuotientGroup.mk' A) g) ((QuotientGroup.mk' A) y)]
              group
          _ = (QuotientGroup.mk' A) y := by rw [mul_inv_cancel, mul_one]
      rw [h1]
      exact hy
    have hDinv : D.map (h.xi : MulAut P).toMonoidHom = D := by
      refine le_antisymm ?_ ?_
      · rintro y ⟨x, hx, rfl⟩
        show Additive.ofMul ((QuotientGroup.mk' A) (h.xi x)) ∈ U
        have h2 : Additive.ofMul ((QuotientGroup.mk' A) (h.xi x))
            = σ (Additive.ofMul ((QuotientGroup.mk' A) x)) := by
          rw [σ_ofMul, ξQ_mk']
        rw [h2]
        exact hU _ hx
      · intro y hy
        refine ⟨(h.xi : MulAut P).symm y, ?_, by simp⟩
        show Additive.ofMul ((QuotientGroup.mk' A) ((h.xi : MulAut P).symm y)) ∈ U
        have h1 : σ (Additive.ofMul ((QuotientGroup.mk' A) ((h.xi : MulAut P).symm y)))
            = Additive.ofMul ((QuotientGroup.mk' A) y) := by
          rw [σ_ofMul, ξQ_mk', MulEquiv.apply_symm_apply]
        have hmem : Additive.ofMul ((QuotientGroup.mk' A) y) ∈ σ '' (U : Set V) := by
          rw [hUeq]; exact hy
        obtain ⟨w, hw, hwv⟩ := hmem
        have h2 : Additive.ofMul ((QuotientGroup.mk' A) ((h.xi : MulAut P).symm y)) = w := by
          apply σ.injective
          rw [h1, hwv]
        rw [h2]
        exact hw
    have hAD : A ≤ D := by
      intro a ha
      show Additive.ofMul ((QuotientGroup.mk' A) a) ∈ U
      rw [show (QuotientGroup.mk' A) a = 1 from by
        rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']; exact ha]
      exact U.zero_mem
    rcases hirr D hDn hDinv hAD with h1 | h1
    · left
      rw [Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = x := ⟨Additive.toMul x, rfl⟩
      obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective A w
      have hwmem : Additive.ofMul w ∈ U := hx
      have hyU : Additive.ofMul ((QuotientGroup.mk' A) y) ∈ U := by rw [hy]; exact hwmem
      have hyD : y ∈ D := hyU
      rw [h1] at hyD
      have hyA : y ∈ A := hyD
      have hzero : (QuotientGroup.mk' A) y = 1 := by
        rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']; exact hyA
      rw [← hy, hzero]
      rfl
    · right
      rw [Submodule.eq_top_iff']
      intro x
      obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = x := ⟨Additive.toMul x, rfl⟩
      obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective A w
      have hyD : y ∈ D := h1 ▸ Subgroup.mem_top y
      show Additive.ofMul w ∈ U
      rw [← hy]
      exact hyD
  -- ## 6.  `ξ ^ k` acts trivially on `V` exactly for the multiples of `2 ^ n - 1`
  have homega : ∀ k : ℕ, (∀ z : P, z ∈ omega1 P → (h.xi ^ k) z = z) ↔ (2 ^ n - 1) ∣ k := by
    intro k
    rw [← hqcard]
    exact xi_pow_triv_omega1_iff h k
  have hker : ∀ k : ℕ, ξQ ^ k = 1 ↔ (2 ^ n - 1) ∣ k := by
    intro k
    rw [htrivV k]
    constructor
    · intro hk
      exact (homega k).mp (dir1 k hk)
    · intro hk
      exact dir2 k ((homega k).mpr hk)
  have hσQ : ∀ k : ℕ, σ ^ k = 1 ↔ ξQ ^ k = 1 := by
    intro k
    constructor
    · intro hk
      refine MulEquiv.ext (fun w => ?_)
      have h1 : (σ ^ k) (Additive.ofMul w) = (Additive.ofMul w) := by
        simpa using congrArg (fun f : V ≃ₗ[ZMod 2] V => f (Additive.ofMul w)) hk
      rw [σ_pow_ofMul] at h1
      exact Additive.ofMul.injective h1
    · intro hk
      refine LinearEquiv.ext (fun v => ?_)
      obtain ⟨w, rfl⟩ : ∃ w : P ⧸ A, Additive.ofMul w = v := ⟨Additive.toMul v, rfl⟩
      rw [σ_pow_ofMul, hk]
      rfl
  -- ## 7.  `dim V = n`, hence `|V| = 2 ^ n`
  have hquotcard : Nat.card (P ⧸ A) = 2 ^ Module.finrank (ZMod 2) V := by
    have h1 := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)
    rw [Nat.card_zmod] at h1
    rw [← h1]
    exact Nat.card_congr (Additive.ofMul : P ⧸ A ≃ V)
  have hnm : n ∣ Module.finrank (ZMod 2) V := by
    have h1 := nsdL1_card_omega1_sub_one_dvd_card_sub_one h
    rw [hqcard] at h1
    have hP : Nat.card P = 2 ^ (2 * n + Module.finrank (ZMod 2) V) := by
      have h2 : Nat.card P = Nat.card (P ⧸ A) * Nat.card ↥A :=
        Subgroup.card_eq_card_quotient_mul_card_subgroup A
      rw [h2, hAcard, hquotcard, ← pow_add]
      ring_nf
    rw [hP] at h1
    have h3 : n ∣ 2 * n + Module.finrank (ZMod 2) V :=
      (Q3.pow_sub_one_dvd_pow_sub_one_iff (x := 2) (m := n)
        (k := 2 * n + Module.finrank (ZMod 2) V) (by norm_num) (by omega)).mp h1
    have h4 : n ∣ 2 * n := ⟨2, by ring⟩
    have h5 : n ∣ (2 * n + Module.finrank (ZMod 2) V) - 2 * n := Nat.dvd_sub h3 h4
    have h6 : (2 * n + Module.finrank (ZMod 2) V) - 2 * n = Module.finrank (ZMod 2) V := by
      omega
    rwa [h6] at h5
  have hmn : Module.finrank (ZMod 2) V ∣ n :=
    Q3.finrank_dvd_of_irreducible_pow_sub_one σ (by omega)
      ((hσQ (2 ^ n - 1)).mpr ((hker (2 ^ n - 1)).mpr (dvd_refl _))) hirrV
  have hmn_eq : Module.finrank (ZMod 2) V = n := Nat.dvd_antisymm hmn hnm
  have hVcard : Nat.card V = 2 ^ n := by
    have h1 := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)
    rw [Nat.card_zmod, hmn_eq] at h1
    exact h1
  -- ## 8.  `σ` is fixed point free
  have hfree : ∀ v : V, σ v = v → v = 0 := by
    intro v hv
    by_contra hv0
    have hspan : Submodule.span (ZMod 2) ({v} : Set V) = ⊤ := by
      have hmem : ∀ w ∈ Submodule.span (ZMod 2) ({v} : Set V),
          σ w ∈ Submodule.span (ZMod 2) ({v} : Set V) := by
        intro w hw
        rw [Submodule.mem_span_singleton] at hw ⊢
        obtain ⟨c, rfl⟩ := hw
        exact ⟨c, by rw [map_smul, hv]⟩
      rcases hirrV _ hmem with h | h
      · exfalso
        have h1 : v ∈ (⊥ : Submodule (ZMod 2) V) := by
          rw [← h]
          exact Submodule.mem_span_singleton.mpr ⟨1, one_smul _ _⟩
        exact hv0 (by simpa using h1)
      · exact h
    have hcard2 : Nat.card V ≤ 2 := by
      have hsurj : Function.Surjective (fun c : ZMod 2 => c • v) := by
        intro x
        have hx : x ∈ Submodule.span (ZMod 2) ({v} : Set V) := by rw [hspan]; trivial
        rw [Submodule.mem_span_singleton] at hx
        obtain ⟨c, hc⟩ := hx
        exact ⟨c, hc⟩
      haveI : Fintype V := Fintype.ofFinite V
      have h1 : Fintype.card V ≤ Fintype.card (ZMod 2) := Fintype.card_le_of_surjective _ hsurj
      have h2 : Nat.card V = Fintype.card V := Nat.card_eq_fintype_card
      rw [h2]
      calc Fintype.card V ≤ Fintype.card (ZMod 2) := h1
        _ = 2 := ZMod.card 2
    rw [hVcard] at hcard2
    have h4 : 4 ≤ 2 ^ n := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn2
    omega
  -- ## 9.  the order of `σ`
  have hordσ : orderOf σ = 2 ^ n - 1 := by
    refine (orderOf_eq_iff (x := σ) (show 0 < 2 ^ n - 1 by omega)).mpr ⟨?_, ?_⟩
    · rw [hσQ, hker]
    · intro m hm hmlt hcon
      have h1 : (2 ^ n - 1) ∣ m := (hker m).mp ((hσQ m).mp hcon)
      have h2 : 0 < 2 ^ n - 1 := by omega
      obtain ⟨t, ht⟩ := h1
      have h3 : 1 ≤ t := by
        rcases Nat.eq_zero_or_pos t with h0 | hpos
        · rw [h0, mul_zero] at ht
          omega
        · exact hpos
      have h4 : 2 ^ n - 1 ≤ m := by
        rw [ht]
        calc 2 ^ n - 1 = (2 ^ n - 1) * 1 := (mul_one _).symm
          _ ≤ (2 ^ n - 1) * t := Nat.mul_le_mul_left _ h3
      omega
  -- ## 10.  the Singer isomorphism and the assembly
  obtain ⟨φ, lam0, hlam0ord, hφ⟩ := exists_singer_iso hn0 hVcard σ hordσ hfree
  haveI : Fintype (GaloisField 2 n) := Fintype.ofFinite _
  let ζ : GaloisField 2 n ≃ (P ⧸ A) :=
    (φ.symm : GaloisField 2 n ≃ V).trans (Additive.toMul : V ≃ (P ⧸ A))
  refine ⟨GaloisField 2 n, inferInstance, inferInstance, inferInstance, inferInstance,
    (lam0 : GaloisField 2 n), ?_, hn2, ?_, ?_, ?_⟩
  · rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 2 n hn0.ne'
  · rw [orderOf_units]
    exact hlam0ord
  · exact Units.ne_zero lam0
  · refine ⟨ζ, ?_, ?_⟩
    · intro x y
      show Additive.toMul (φ.symm (x + y)) = Additive.toMul (φ.symm x) * Additive.toMul (φ.symm y)
      rw [map_add, toMul_add]
    · intro x u hu
      have h1 : φ.symm ((lam0 : GaloisField 2 n) * x) = σ (φ.symm x) := by
        apply φ.injective
        rw [LinearEquiv.apply_symm_apply, hφ (φ.symm x), LinearEquiv.apply_symm_apply]
      have hw : Additive.ofMul ((u : P ⧸ A)) = φ.symm x := by
        rw [hu, show ζ x = Additive.toMul (φ.symm x) from rfl]
        exact ofMul_toMul _
      have h2 : Additive.toMul (σ (φ.symm x)) = ξQ ((u : P ⧸ A)) := by
        rw [← hw, σ_ofMul]
        simp
      show Additive.toMul (φ.symm ((lam0 : GaloisField 2 n) * x)) = (h.xi u : P ⧸ A)
      rw [h1, h2]
      exact ξQ_mk u

end Work.Higman
end

-- ===== from Submission.Work.Higman.nsd_false_of_irreducible =====
section

open scoped commutatorElement

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

namespace Work.Higman

variable {P : Type} [Group P] [Finite P]

/-! ## Auxiliary facts about the quotient `P ⧸ A` -/

/-- Multiplicativity of the quotient map. -/
private theorem quot_mk_mul {A : Subgroup P} [A.Normal] (u v : P) :
    ((u * v : P) : P ⧸ A) = (u : P ⧸ A) * (v : P ⧸ A) := by
  simpa [QuotientGroup.mk'_apply] using map_mul (QuotientGroup.mk' A) u v

/-- Two elements with the same image in `P ⧸ A` differ by an element of `A`. -/
private theorem exists_mul_mem_of_quot_eq {A : Subgroup P} [A.Normal] {u v : P}
    (h : (u : P ⧸ A) = (v : P ⧸ A)) : ∃ t ∈ A, u = v * t :=
  ⟨v⁻¹ * u, QuotientGroup.eq.mp h.symm, by group⟩

/-- Two elements of the abelian subgroup `A` with the same square differ by an element of
`A ^ (2)`. -/
private theorem mul_inv_mem_powSub_two_of_sq_eq (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (htop : powSub A 2 = omega1 P) {a b : P} (ha : a ∈ A) (hb : b ∈ A)
    (hsqeq : a * a = b * b) : a * b⁻¹ ∈ powSub A 2 := by
  have hcomm : b⁻¹ * a = a * b⁻¹ := (hAab a ha b⁻¹ (A.inv_mem hb)).symm
  have h2 : (a * b⁻¹) * (a * b⁻¹) = (a * a) * ((b * b)⁻¹) := by
    rw [show (a * b⁻¹) * (a * b⁻¹) = a * (b⁻¹ * a) * b⁻¹ from by group, hcomm]
    group
  have h1 : (a * b⁻¹) * (a * b⁻¹) = 1 := by
    rw [h2, hsqeq, mul_inv_cancel]
  have h3 : a * b⁻¹ ∈ omega1 P := h.mem_omega1.mpr (by rwa [pow_two])
  rwa [← htop] at h3

/-- If every square of `P` lies in `A ^ (2)`, then every commutator lies in `A ^ (2)`
(the squaring identity `(uv)² = [u,[v,u]]·([v,u]·u²·v²)`, cf. `powSub_C_eq_of_cover`). -/
private theorem comm_mem_powSub_two_of_sq_mem (h : IsSuzuki2Grp P) {A : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq2 : ∀ x : P, x ^ 2 ∈ powSub A 2) (u v : P) :
    ⁅u, v⁆ ∈ powSub A 2 := by
  have hA : IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  have hvu : ⁅v, u⁆ ∈ A := by
    rw [← hGs, Subgroup.commutator_comm]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top v) (Subgroup.mem_top u)
  have hχ : ⁅u, ⁅v, u⁆⁆ ∈ powSub A 2 := commutator_mem_powSub_two h hA u ⁅v, u⁆ hvu
  have hone : (u * v) * (u * v) = ⁅u, ⁅v, u⁆⁆ * (⁅v, u⁆ * (u * u) * (v * v)) := by
    simp only [commutatorElement_def]; group
  have h1 : (u * v) * (u * v) ∈ powSub A 2 := by
    have h2 := hsq2 (u * v); rwa [pow_two] at h2
  have hu2 : u * u ∈ powSub A 2 := by have h2 := hsq2 u; rwa [pow_two] at h2
  have hv2 : v * v ∈ powSub A 2 := by have h2 := hsq2 v; rwa [pow_two] at h2
  have h3 : ⁅v, u⁆ = (⁅u, ⁅v, u⁆⁆)⁻¹ * ((u * v) * (u * v)) * ((v * v)⁻¹ * (u * u)⁻¹) := by
    rw [hone]; group
  have hmem : ⁅v, u⁆ ∈ powSub A 2 := by
    rw [h3]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ ((powSub A 2).inv_mem hχ) h1)
      (Subgroup.mul_mem _ ((powSub A 2).inv_mem hv2) ((powSub A 2).inv_mem hu2))
  have hsym : ⁅u, v⁆ = (⁅v, u⁆)⁻¹ := by
    rw [commutatorElement_def, commutatorElement_def]; group
  rw [hsym]
  exact (powSub A 2).inv_mem hmem

/-- In a finite field of order `2 ^ n`, an element of multiplicative order `2 ^ n - 1` generates
the multiplicative group: every non-zero element is one of its powers. -/
private theorem pow_exhaust_of_orderOf_card {F : Type} [Field F] [Fintype F] [DecidableEq F]
    {lam : F} (hlam : orderOf lam = Fintype.card F - 1) {x : F} (hx : x ≠ 0) :
    ∃ s : ℕ, lam ^ s = x := by
  have hne : lam ≠ 0 := by
    intro h0
    rw [h0, orderOf_zero F] at hlam
    have h1 : Fintype.card F ≤ 1 := by omega
    have h2 : 2 ≤ Fintype.card F :=
      Fintype.one_lt_card_iff_nontrivial.mpr ⟨0, 1, zero_ne_one⟩
    omega
  set N := Fintype.card F - 1 with hN
  have hNcard : Fintype.card F = N + 1 := by rw [hN]; exact (Nat.succ_pred_eq_of_pos Fintype.card_pos).symm
  have hinj : Set.InjOn (fun s : ℕ => lam ^ s) (Set.Iio N) := by
    rw [← hlam]; exact pow_injOn_Iio_orderOf
  have hS : ((Finset.range N).image (fun s => lam ^ s)).card = N := by
    rw [Finset.card_image_of_injOn (fun a ha b hb h =>
        hinj (Finset.mem_range.mp ha) (Finset.mem_range.mp hb) h), Finset.card_range]
  have hsub : (Finset.range N).image (fun s => lam ^ s) ⊆
      (Finset.univ : Finset F).erase 0 := by
    intro z hz
    rw [Finset.mem_image] at hz
    obtain ⟨s, -, rfl⟩ := hz
    exact Finset.mem_erase.mpr ⟨pow_ne_zero _ hne, Finset.mem_univ _⟩
  have heq : (Finset.range N).image (fun s => lam ^ s) = (Finset.univ : Finset F).erase 0 := by
    refine Finset.eq_of_subset_of_card_le hsub ?_
    have hc : ((Finset.univ : Finset F).erase 0).card = N := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ (0 : F)), Finset.card_univ, hN]
    rw [hc, hS]
  have hxmem : x ∈ (Finset.univ : Finset F).erase 0 :=
    Finset.mem_erase.mpr ⟨hx, Finset.mem_univ x⟩
  rw [← heq, Finset.mem_image] at hxmem
  obtain ⟨s, -, hs⟩ := hxmem
  exact ⟨s, hs⟩

/-! ## The abstract core -/

/-- **The core of the `C₄` exclusion.**  Suppose `A` is the derived subgroup of the Suzuki
2-group `P`, `A` is abelian of exponent `4` with `Ω₁(P) = A²` and `|A| = |Ω₁(P)|²`, and the two
layers `P/A` and `Ω₁(P)` are identified (through a common finite field `F` of order `2 ^ n`) with
`F` in such a way that `ξ` acts by multiplication by `lam` on the first and by multiplication by
`mu` on the second.  Then we reach a contradiction (this is the eigenvalue bookkeeping of
Higman's Lemma 6, formalised as `Work.Higman.c4_field_core`). -/
private theorem nsd_core {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P) {A : Subgroup P}
    [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : powSub A 4 = ⊥) (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hcent : ∀ u : P, u ∉ A → ∃ a ∈ A, ⁅u, a⁆ ≠ 1)
    {n : ℕ} (hn : 2 ≤ n) {F : Type} [Field F] [Fintype F] [DecidableEq F] [CharP F 2]
    (hFcard : Fintype.card F = 2 ^ n) (hZcard : Nat.card ↥(omega1 P) = 2 ^ n)
    (lam mu : F) (hlamord : orderOf lam = 2 ^ n - 1) (hmuord : orderOf mu = 2 ^ n - 1)
    (ζV : F ≃ (P ⧸ A))
    (hζVadd : ∀ x y : F, ζV (x + y) = ζV x * ζV y)
    (hζVeq : ∀ x : F, ∀ u : P, (u : P ⧸ A) = ζV x → ζV (lam * x) = (h.xi u : P ⧸ A))
    (ζZ : F ≃ ↥(omega1 P))
    (hζZadd : ∀ x y : F, ζZ (x + y) = ζZ x * ζZ y)
    (hζZeq : ∀ x : F, ((ζZ (mu * x) : ↥(omega1 P)) : P) = h.xi ((ζZ x : ↥(omega1 P)) : P)) :
    False := by
  classical
  -- ## basic facts about the two identifications
  have hAne : A ≠ ⊥ := by
    intro hbot
    have h1 : Nat.card ↥A = 1 := by rw [hbot]; simp
    have h2 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
    rw [h1] at hcard
    have h3 : 16 ≤ (Nat.card ↥(omega1 P)) ^ 2 := by nlinarith
    omega
  have hζZ0 : ζZ 0 = 1 := by
    have h1 : ζZ 0 = ζZ 0 * ζZ 0 := by
      have h2 := hζZadd 0 0
      rwa [add_zero] at h2
    exact (mul_left_cancel (show ζZ 0 * 1 = ζZ 0 * ζZ 0 by rw [mul_one]; exact h1)).symm
  have hζV0 : ζV 0 = 1 := by
    have h1 : ζV 0 = ζV 0 * ζV 0 := by
      have h2 := hζVadd 0 0
      rwa [add_zero] at h2
    exact (mul_left_cancel (show ζV 0 * 1 = ζV 0 * ζV 0 by rw [mul_one]; exact h1)).symm
  have hζV_one : ∀ x : F, ζV x = 1 ↔ x = 0 := fun x =>
    ⟨fun hx => ζV.injective (by rw [hx, hζV0]), fun hx => by rw [hx, hζV0]⟩
  -- ## the section `σ : F → P` of `ζV`
  let σ : F → P := fun x => Quotient.out (ζV x)
  have hσ : ∀ x : F, (σ x : P ⧸ A) = ζV x := fun x => QuotientGroup.out_eq' (ζV x)
  have hσadd : ∀ x y : F, ∃ t ∈ A, σ x * σ y = σ (x + y) * t := by
    intro x y
    have hq : (σ (x + y) : P ⧸ A) = (σ x * σ y : P ⧸ A) := by
      calc (σ (x + y) : P ⧸ A) = ζV (x + y) := hσ (x + y)
        _ = ζV x * ζV y := hζVadd x y
        _ = (σ x : P ⧸ A) * (σ y : P ⧸ A) := by rw [hσ x, hσ y]
        _ = (σ x * σ y : P ⧸ A) := (quot_mk_mul (σ x) (σ y)).symm
    obtain ⟨t, htA, ht⟩ := exists_mul_mem_of_quot_eq hq
    exact ⟨t⁻¹, A.inv_mem htA, by rw [ht]; group⟩
  have hσlam : ∀ x : F, ∃ t ∈ A, σ (lam * x) = h.xi (σ x) * t := by
    intro x
    refine exists_mul_mem_of_quot_eq ?_
    rw [hσ (lam * x)]
    exact hζVeq x (σ x) (hσ x)
  -- ## the section `ρ : F → A` of the squaring map
  have hρ_exists : ∀ y : F, ∃ a ∈ A, a * a = ((ζZ y : ↥(omega1 P)) : P) := by
    intro y
    have hmem : ((ζZ y : ↥(omega1 P)) : P) ∈ powSub A 2 := by
      rw [htop]; exact (ζZ y).2
    obtain ⟨a, ha, ha2⟩ := (mem_powSub_iff hAab).mp hmem
    exact ⟨a, ha, by rwa [pow_two] at ha2⟩
  let ρ : F → P := fun y => Classical.choose (hρ_exists y)
  have hρ_mem : ∀ y : F, ρ y ∈ A := fun y => (Classical.choose_spec (hρ_exists y)).1
  have hρ_sq : ∀ y : F, ρ y * ρ y = ((ζZ y : ↥(omega1 P)) : P) :=
    fun y => (Classical.choose_spec (hρ_exists y)).2
  -- `ρ` is `ξ`-equivariant modulo `A²`
  have hξρ_mem : ∀ y : F, h.xi (ρ y) ∈ A := by
    intro y
    rw [← hAxi]
    exact Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom (hρ_mem y)
  have hρω : ∀ y : F, ρ (mu * y) * (h.xi (ρ y))⁻¹ ∈ powSub A 2 := by
    intro y
    refine mul_inv_mem_powSub_two_of_sq_eq h hAab htop (hρ_mem (mu * y)) (hξρ_mem y) ?_
    rw [hρ_sq (mu * y), hζZeq y, ← map_mul, hρ_sq y]
  -- ## the four maps of the field core
  let f : F → F := fun x => ζZ.symm ⟨(σ x) ^ 4, pow4_mem h htop hsq (σ x)⟩
  have hfZ : ∀ x : F, ζZ (f x) = ⟨(σ x) ^ 4, pow4_mem h htop hsq (σ x)⟩ :=
    fun x => ζZ.apply_symm_apply _
  let β : F → F → F := fun x y => ζZ.symm ⟨⁅σ x, σ y⁆ ^ 2, comm_sq_mem h hGs htop (σ x) (σ y)⟩
  have hβZ : ∀ x y : F,
      ζZ (β x y) = ⟨⁅σ x, σ y⁆ ^ 2, comm_sq_mem h hGs htop (σ x) (σ y)⟩ :=
    fun x y => ζZ.apply_symm_apply _
  let B : F → F → F := fun x y =>
    ζZ.symm ⟨⁅σ x, ρ y⁆, bracket_mem_omega1 h hAxi hAab hGs htop (σ x) (hρ_mem y)⟩
  have hBZ : ∀ x y : F,
      ζZ (B x y) = ⟨⁅σ x, ρ y⁆, bracket_mem_omega1 h hAxi hAab hGs htop (σ x) (hρ_mem y)⟩ :=
    fun x y => ζZ.apply_symm_apply _
  -- ## biadditivity of `β`
  have hbeta1 : ∀ a b d : F, β (a + b) d = β a d + β b d := by
    intro a b d
    apply ζZ.injective
    rw [hζZadd (β a d) (β b d)]
    apply Subtype.ext
    rw [hβZ (a + b) d, hβZ a d, hβZ b d]
    change ⁅σ (a + b), σ d⁆ ^ 2 = ⁅σ a, σ d⁆ ^ 2 * ⁅σ b, σ d⁆ ^ 2
    obtain ⟨t, htA, ht⟩ := hσadd a b
    have h1 : ⁅σ (a + b), σ d⁆ ^ 2 = ⁅σ a * σ b, σ d⁆ ^ 2 := by
      have hc := comm_sq_congr h hAxi hAab hGs htop (σ (a + b)) (σ d) (b := 1) htA
        (A.one_mem)
      rw [← ht, mul_one] at hc
      exact hc.symm
    rw [h1, comm_sq_mul_left h hAxi hAab hGs htop (σ a) (σ b) (σ d)]
  have hbeta2 : ∀ a b d : F, β a (b + d) = β a b + β a d := by
    intro a b d
    apply ζZ.injective
    rw [hζZadd (β a b) (β a d)]
    apply Subtype.ext
    rw [hβZ a (b + d), hβZ a b, hβZ a d]
    change ⁅σ a, σ (b + d)⁆ ^ 2 = ⁅σ a, σ b⁆ ^ 2 * ⁅σ a, σ d⁆ ^ 2
    obtain ⟨t, htA, ht⟩ := hσadd b d
    have h1 : ⁅σ a, σ (b + d)⁆ ^ 2 = ⁅σ a, σ b * σ d⁆ ^ 2 := by
      have hc := comm_sq_congr h hAxi hAab hGs htop (σ a) (σ (b + d)) (a := 1) (b := t)
        (A.one_mem) htA
      rw [mul_one, ← ht] at hc
      exact hc.symm
    rw [h1, comm_sq_mul_right h hAab hGs htop (σ a) (σ b) (σ d)]
  -- ## `ξ`-equivariance of `β`
  have hbetaeq : ∀ a b : F, β (lam * a) (lam * b) = mu * β a b := by
    intro a b
    obtain ⟨c, hcA, hc⟩ := hσlam a
    obtain ⟨e, heA, he⟩ := hσlam b
    apply ζZ.injective
    apply Subtype.ext
    rw [hζZeq (β a b), hβZ a b, hβZ (lam * a) (lam * b)]
    change ⁅σ (lam * a), σ (lam * b)⁆ ^ 2 = h.xi (⁅σ a, σ b⁆ ^ 2)
    rw [hc, he, comm_sq_congr h hAxi hAab hGs htop (h.xi (σ a)) (h.xi (σ b)) hcA heA,
      ← map_commutatorElement, ← map_pow]
  -- ## `β` is alternating
  have hbetaalt : ∀ a : F, β a a = 0 := by
    intro a
    have h1 : ζZ (β a a) = ζZ 0 := by
      rw [hζZ0, hβZ a a]
      apply Subtype.ext
      change ⁅σ a, σ a⁆ ^ 2 = (1 : P)
      rw [show ⁅σ a, σ a⁆ = 1 from by rw [commutatorElement_def]; group, one_pow]
    exact ζZ.injective h1
  -- ## `β` does not vanish
  have hbetane : ∃ a b : F, β a b ≠ 0 := by
    obtain ⟨u, v, huv⟩ := aux_beta_ne h hGs htop hcard
    refine ⟨ζV.symm (u : P ⧸ A), ζV.symm (v : P ⧸ A), ?_⟩
    intro h0
    have hσu : (σ (ζV.symm (u : P ⧸ A)) : P ⧸ A) = (u : P ⧸ A) := by
      rw [hσ]; simp
    have hσv : (σ (ζV.symm (v : P ⧸ A)) : P ⧸ A) = (v : P ⧸ A) := by
      rw [hσ]; simp
    obtain ⟨s, hsA, hs⟩ := exists_mul_mem_of_quot_eq hσu
    obtain ⟨t, htA, ht⟩ := exists_mul_mem_of_quot_eq hσv
    have h1 : ζZ (β (ζV.symm (u : P ⧸ A)) (ζV.symm (v : P ⧸ A))) = 1 := by rw [h0, hζZ0]
    rw [hβZ] at h1
    have h2 : ⁅σ (ζV.symm (u : P ⧸ A)), σ (ζV.symm (v : P ⧸ A))⁆ ^ 2 = 1 :=
      congrArg (fun z : ↥(omega1 P) => (z : P)) h1
    rw [hs, ht, comm_sq_congr h hAxi hAab hGs htop u v hsA htA] at h2
    exact huv (by rw [htop]; exact h.mem_omega1.mpr h2)
  -- ## biadditivity of `B`
  have hB1 : ∀ a b d : F, B (a + b) d = B a d + B b d := by
    intro a b d
    apply ζZ.injective
    rw [hζZadd (B a d) (B b d)]
    apply Subtype.ext
    rw [hBZ (a + b) d, hBZ a d, hBZ b d]
    change ⁅σ (a + b), ρ d⁆ = ⁅σ a, ρ d⁆ * ⁅σ b, ρ d⁆
    obtain ⟨t, htA, ht⟩ := hσadd a b
    have h1 : ⁅σ (a + b), ρ d⁆ = ⁅σ a * σ b, ρ d⁆ := by
      have hc := bracket_mul_left_exact h hAab (σ (a + b)) (hρ_mem d) htA
      rw [← ht] at hc
      exact hc.symm
    rw [h1, bracket_mul_omega h hAxi hAab hGs htop (σ a) (σ b) (hρ_mem d)]
  have hB2 : ∀ a b d : F, B a (b + d) = B a b + B a d := by
    intro a b d
    have hsqeq : ρ (b + d) * ρ (b + d) = (ρ b * ρ d) * (ρ b * ρ d) := by
      rw [hρ_sq (b + d), hζZadd,
        show (ρ b * ρ d) * (ρ b * ρ d) = (ρ b * ρ b) * (ρ d * ρ d) from by
          rw [show (ρ b * ρ d) * (ρ b * ρ d) = ρ b * (ρ d * ρ b) * ρ d from by group,
            hAab (ρ d) (hρ_mem d) (ρ b) (hρ_mem b)]
          group]
      rw [hρ_sq b, hρ_sq d]
      rfl
    obtain ⟨z, hzA, hz2⟩ := (mem_powSub_iff hAab).mp
      (mul_inv_mem_powSub_two_of_sq_eq h hAab htop (hρ_mem (b + d))
        (A.mul_mem (hρ_mem b) (hρ_mem d)) hsqeq)
    have hzeq : ρ (b + d) = (ρ b * ρ d) * z ^ 2 := by
      have key : (ρ b * ρ d) * z ^ 2 = ρ (b + d) := by
        rw [hz2]
        have hcomm := hAab (ρ b * ρ d) (A.mul_mem (hρ_mem b) (hρ_mem d)) (ρ (b + d))
          (hρ_mem (b + d))
        calc (ρ b * ρ d) * (ρ (b + d) * (ρ b * ρ d)⁻¹)
            = ((ρ b * ρ d) * ρ (b + d)) * (ρ b * ρ d)⁻¹ := by group
          _ = (ρ (b + d) * (ρ b * ρ d)) * (ρ b * ρ d)⁻¹ := by rw [hcomm]
          _ = ρ (b + d) := by group
      exact key.symm
    apply ζZ.injective
    rw [hζZadd (B a b) (B a d)]
    apply Subtype.ext
    rw [hBZ a (b + d), hBZ a b, hBZ a d]
    change ⁅σ a, ρ (b + d)⁆ = ⁅σ a, ρ b⁆ * ⁅σ a, ρ d⁆
    rw [hzeq, bracket_mul_central h hAab hGs htop (σ a) (A.mul_mem (hρ_mem b) (hρ_mem d))
        (pow_mem_powSub (n := 2) hzA),
      bracket_mul_exact h hAab hGs (σ a) (hρ_mem b) (hρ_mem d)]
  -- ## `ξ`-equivariance of `B`
  have hBeq : ∀ a b : F, B (lam * a) (mu * b) = mu * B a b := by
    intro a b
    obtain ⟨c, hcA, hc⟩ := hσlam a
    obtain ⟨z, hzA, hz2⟩ := (mem_powSub_iff hAab).mp (hρω b)
    have hzeq : ρ (mu * b) = h.xi (ρ b) * z ^ 2 := by
      have key : h.xi (ρ b) * z ^ 2 = ρ (mu * b) := by
        rw [hz2]
        have hcomm := hAab (ρ (mu * b)) (hρ_mem (mu * b)) (h.xi (ρ b)) (hξρ_mem b)
        calc h.xi (ρ b) * (ρ (mu * b) * (h.xi (ρ b))⁻¹)
            = (h.xi (ρ b) * ρ (mu * b)) * (h.xi (ρ b))⁻¹ := by group
          _ = (ρ (mu * b) * h.xi (ρ b)) * (h.xi (ρ b))⁻¹ := by rw [hcomm]
          _ = ρ (mu * b) := by group
      exact key.symm
    apply ζZ.injective
    apply Subtype.ext
    rw [hζZeq (B a b), hBZ a b, hBZ (lam * a) (mu * b)]
    change ⁅σ (lam * a), ρ (mu * b)⁆ = h.xi (⁅σ a, ρ b⁆)
    rw [hc, bracket_mul_left_exact h hAab (h.xi (σ a)) (hρ_mem (mu * b)) hcA, hzeq,
      bracket_mul_central h hAab hGs htop (h.xi (σ a)) (hξρ_mem b) (pow_mem_powSub (n := 2) hzA),
      ← map_commutatorElement]
  -- ## non-vanishing of `B`
  have hBne : ∃ a b : F, B a b ≠ 0 := by
    have hAne_top : A ≠ ⊤ := by
      intro hAtop
      obtain ⟨x, y, hxy⟩ := h.noncomm
      exact hxy (hAab x (by rw [hAtop]; trivial) y (by rw [hAtop]; trivial))
    obtain ⟨u, huA⟩ : ∃ u : P, u ∉ A := by
      by_contra hcon
      push Not at hcon
      exact hAne_top (le_antisymm le_top (fun x _ => hcon x))
    obtain ⟨a, haA, ha1⟩ := hcent u huA
    have ha2 : a ^ 2 ∈ omega1 P := by
      rw [← htop]; exact pow_mem_powSub (n := 2) haA
    set b : F := ζZ.symm ⟨a ^ 2, ha2⟩ with hbdef
    have hbZ : ζZ b = ⟨a ^ 2, ha2⟩ := ζZ.apply_symm_apply _
    refine ⟨ζV.symm (u : P ⧸ A), b, ?_⟩
    intro h0
    have hρa : ρ b * a⁻¹ ∈ powSub A 2 := by
      refine mul_inv_mem_powSub_two_of_sq_eq h hAab htop (hρ_mem b) haA ?_
      rw [hρ_sq, hbZ]
      change a ^ 2 = a * a
      rw [pow_two]
    obtain ⟨w, hwA, hw2⟩ := (mem_powSub_iff hAab).mp hρa
    have hweq : ρ b = a * w ^ 2 := by
      have key : a * w ^ 2 = ρ b := by
        rw [hw2]
        calc a * (ρ b * a⁻¹) = (a * ρ b) * a⁻¹ := by group
          _ = (ρ b * a) * a⁻¹ := by rw [hAab a haA (ρ b) (hρ_mem b)]
          _ = ρ b := by group
      exact key.symm
    have hσu : (σ (ζV.symm (u : P ⧸ A)) : P ⧸ A) = (u : P ⧸ A) := by rw [hσ]; simp
    obtain ⟨s, hsA, hs⟩ := exists_mul_mem_of_quot_eq hσu
    have h2 : ⁅σ (ζV.symm (u : P ⧸ A)), ρ b⁆ = 1 := by
      have h1 : ζZ (B (ζV.symm (u : P ⧸ A)) b) = 1 := by rw [h0, hζZ0]
      rw [hBZ] at h1
      exact congrArg (fun z : ↥(omega1 P) => (z : P)) h1
    rw [hweq, bracket_mul_central h hAab hGs htop (σ (ζV.symm (u : P ⧸ A))) haA
        (pow_mem_powSub (n := 2) hwA),
      hs, bracket_mul_left_exact h hAab u haA hsA] at h2
    exact ha1 h2
  -- ## the quadratic relation
  have hBquad : ∀ a : F, B a (f a) = 0 := by
    intro a
    have hρfa : ρ (f a) * ((σ a) ^ 2)⁻¹ ∈ powSub A 2 := by
      refine mul_inv_mem_powSub_two_of_sq_eq h hAab htop (hρ_mem (f a))
        (hsq (σ a)) ?_
      rw [hρ_sq, hfZ]
      change (σ a) ^ 4 = (σ a) ^ 2 * (σ a) ^ 2
      rw [← pow_add]
    obtain ⟨z, hzA, hz2⟩ := (mem_powSub_iff hAab).mp hρfa
    have hzeq : ρ (f a) = (σ a) ^ 2 * z ^ 2 := by
      have key : (σ a) ^ 2 * z ^ 2 = ρ (f a) := by
        rw [hz2]
        have hcomm := hAab ((σ a) ^ 2) (hsq (σ a)) (ρ (f a))
          (hρ_mem (f a))
        calc (σ a) ^ 2 * (ρ (f a) * ((σ a) ^ 2)⁻¹)
            = ((σ a) ^ 2 * ρ (f a)) * ((σ a) ^ 2)⁻¹ := by group
          _ = (ρ (f a) * (σ a) ^ 2) * ((σ a) ^ 2)⁻¹ := by rw [hcomm]
          _ = ρ (f a) := by group
      exact key.symm
    apply ζZ.injective
    rw [hζZ0]
    apply Subtype.ext
    rw [hBZ a (f a)]
    change ⁅σ a, ρ (f a)⁆ = (1 : P)
    rw [hzeq, bracket_mul_central h hAab hGs htop (σ a)
        (hsq (σ a)) (pow_mem_powSub (n := 2) hzA)]
    exact show ⁅σ a, (σ a) ^ 2⁆ = (1 : P) from by
      rw [show ⁅σ a, (σ a) ^ 2⁆ = 1 from by rw [pow_two, commutatorElement_def]; group]
    -- ## injectivity of `f`
  -- transitivity of the `ξ`-action on the non-trivial elements of `P / A`
  have hζpow : ∀ {u : P} {x : F}, (u : P ⧸ A) = ζV x → ∀ s : ℕ,
      ζV (lam ^ s * x) = ((h.xi ^ s) u : P ⧸ A) := by
    intro u x hu s
    induction s with
    | zero => simpa using hu.symm
    | succ s ih =>
      have h2 := hζVeq (lam ^ s * x) ((h.xi ^ s) u) ih.symm
      rw [show lam * (lam ^ s * x) = lam ^ (s + 1) * x from by
        rw [← mul_assoc, ← pow_succ']] at h2
      rw [show h.xi ((h.xi ^ s) u) = (h.xi ^ (s + 1)) u from by
        rw [pow_succ', MulAut.mul_apply]] at h2
      exact h2
  have htrans : ∀ u v : P, u ∉ A → v ∉ A → ∃ s : ℕ, v⁻¹ * ((h.xi ^ s) u) ∈ A := by
    intro u v hu hv
    have hx : ζV.symm (u : P ⧸ A) ≠ 0 := by
      intro h0
      have h1 : (u : P ⧸ A) = 1 := by
        rw [← ζV.apply_symm_apply (u : P ⧸ A), h0, hζV0]
      exact hu ((QuotientGroup.eq_one_iff u).mp h1)
    have hy : ζV.symm (v : P ⧸ A) ≠ 0 := by
      intro h0
      have h1 : (v : P ⧸ A) = 1 := by
        rw [← ζV.apply_symm_apply (v : P ⧸ A), h0, hζV0]
      exact hv ((QuotientGroup.eq_one_iff v).mp h1)
    have hlamord' : orderOf lam = Fintype.card F - 1 := by rw [hFcard]; exact hlamord
    obtain ⟨s, hs⟩ := pow_exhaust_of_orderOf_card hlamord'
      (x := ζV.symm (v : P ⧸ A) * (ζV.symm (u : P ⧸ A))⁻¹)
      (mul_ne_zero hy (inv_ne_zero hx))
    refine ⟨s, ?_⟩
    have hX : lam ^ s * ζV.symm (u : P ⧸ A) = ζV.symm (v : P ⧸ A) := by
      rw [hs]
      first
        | rw [mul_assoc, inv_mul_cancel, mul_one]
        | rw [mul_assoc, zpow_neg_one, inv_mul_cancel, mul_one]
        | field_simp
        | group
    have hkey : ζV (lam ^ s * ζV.symm (u : P ⧸ A)) = (v : P ⧸ A) := by
      rw [hX, ζV.apply_symm_apply]
    have h2 := hζpow (u := u) (x := ζV.symm (u : P ⧸ A))
      (by rw [ζV.apply_symm_apply]) s
    rw [hkey] at h2
    exact QuotientGroup.eq.mp h2
  -- every element outside `A` squares into `A ^ 2` as soon as one does, by transitivity
  have hA2inv_pow : ∀ s : ℕ,
      (powSub A 2).map ((h.xi ^ s : MulAut P)).toMonoidHom = powSub A 2 := by
    intro s
    induction s with
    | zero => rw [pow_zero]; exact Subgroup.map_id _
    | succ s ih =>
      rw [pow_succ]
      rw [show (((h.xi ^ s) * h.xi : MulAut P)).toMonoidHom
          = ((h.xi ^ s : MulAut P)).toMonoidHom.comp (h.xi : MulAut P).toMonoidHom from by
        ext x; simp [MulAut.mul_apply]]
      rw [← Subgroup.map_map, map_powSub (h.xi : MulAut P) hAxi 2, ih]
  have hfinj : ∀ a : F, f a = 0 → a = 0 := by
    intro a ha
    have h1 : ζZ (f a) = 1 := by rw [ha, hζZ0]
    rw [hfZ] at h1
    have h2 : (σ a) ^ 4 = 1 := congrArg (fun z : ↥(omega1 P) => (z : P)) h1
    have h3 : (σ a) ^ 2 ∈ powSub A 2 := by
      have h4 : ((σ a) ^ 2) ^ 2 = 1 := by rw [← pow_mul, show 2 * 2 = 4 from rfl]; exact h2
      rw [htop]
      exact h.mem_omega1.mpr h4
    by_contra ha0
    have hσaA : σ a ∉ A := by
      intro hmem
      have hcos : (σ a : P ⧸ A) = 1 := (QuotientGroup.eq_one_iff (σ a)).mpr hmem
      rw [hσ a] at hcos
      exact ha0 ((hζV_one a).mp hcos)
    -- then all squares of `P` lie in `A ^ 2`
    have hsq2 : ∀ x : P, x ^ 2 ∈ powSub A 2 := by
      intro x
      by_cases hx : x ∈ A
      · exact pow_mem_powSub (n := 2) hx
      · obtain ⟨s, hs⟩ := htrans (σ a) x hσaA hx
        obtain ⟨c, hcA, hc⟩ := exists_mul_mem_of_quot_eq (QuotientGroup.eq.mpr hs)
        set w : P := (h.xi ^ s) (σ a) with hwdef
        have h4 : w ^ 2 ∈ powSub A 2 := by
          have h5 : w ^ 2 = (h.xi ^ s) ((σ a) ^ 2) := by rw [hwdef, map_pow]
          rw [h5, ← hA2inv_pow s]
          exact Subgroup.mem_map_of_mem ((h.xi ^ s : MulAut P).toMonoidHom) h3
        have h6 : (w * c) * (w * c) * (w * w)⁻¹ ∈ powSub A 2 :=
          H8.Clean.nsd_coset_sq_wd h hAxi hAab hGs hsq w hcA
        have h7 : x * x ∈ powSub A 2 := by
          have h8 : x * x = (w * c) * (w * c) := by rw [hc]
          rw [h8]
          have h9 : (w * c) * (w * c) = ((w * c) * (w * c) * (w * w)⁻¹) * (w * w) := by group
          rw [h9]
          exact Subgroup.mul_mem _ h6 (by rw [← pow_two]; exact h4)
        rw [pow_two]
        exact h7
    -- hence `A = P' ⊆ A ^ 2`
    have hcomm : ∀ u v : P, ⁅u, v⁆ ∈ powSub A 2 :=
      fun u v => comm_mem_powSub_two_of_sq_mem h hAxi hAab hGs hsq2 u v
    have hAle : A ≤ powSub A 2 := by
      have h : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ powSub A 2 := by
        rw [Subgroup.commutator_le]
        intro u _ v _
        exact hcomm u v
      rwa [hGs] at h
    have hAeq : A = powSub A 2 := le_antisymm hAle (powSub_le (n := 2) (by norm_num))
    have hcard' : (2 : ℕ) ^ n = 2 ^ n * 2 ^ n := by
      have h11 : Nat.card ↥A = Nat.card ↥(powSub A 2) :=
        congrArg (fun H : Subgroup P => Nat.card ↥H) hAeq
      have h12 : Nat.card ↥(powSub A 2) = 2 ^ n := by rw [htop, hZcard]
      have h13 : Nat.card ↥A = 2 ^ n * 2 ^ n := by rw [hcard, hZcard, sq]
      rw [h11, h12] at h13
      exact h13
    have h4 : 4 ≤ 2 ^ n := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    nlinarith [hcard', h4]
  -- ## the hypothesis `lam ≠ mu` of the field core
  have hlam0 : lam ≠ 0 := by
    intro h0
    rw [h0, orderOf_zero] at hlamord
    have h4 : 4 ≤ 2 ^ n := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    omega
  have hmu0 : mu ≠ 0 := by
    intro h0
    rw [h0, orderOf_zero] at hmuord
    have h4 : 4 ≤ 2 ^ n := by
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    omega
  have hlamu : lam ≠ mu :=
    c4_lam_ne_mu hn hFcard lam mu hlamord hmuord β hbeta1 hbeta2 hbetaalt hbetaeq hbetane
  exact c4_field_core n hn hFcard lam mu hlam0 hmu0 hlamu hlamord hmuord β f B
    hbeta1 hbeta2 hbetaeq hbetaalt hbetane hfinj hB1 hB2 hBeq hBne hBquad

/-- **Sub-case 1 of the `C₄` exclusion** (Higman's Lemma 8 applied with `C = ⊤`, whose proof
goes through Lemma 6).  In the `C₄` case, if `P / A` is irreducible as an `𝔽₂[ξ]`-module —
i.e. there is no normal `ξ`-invariant subgroup strictly between `A` and `P` — then we reach a
contradiction.

Reason: with `C = ⊤` the hypothesis `C' = A` holds by `hGs`, so Higman's Lemma 8
(`Work.Higman.higman_lemma8_new`, in `Submission/Work/Higman/higman_lemma8_new.lean`) gives
`exp A ≤ 2`, i.e. every element of `A` is an involution; with `hNA` this gives `A = Ω₁(P)`,
so `A ^ (2) = ⊥` while `A ^ (2) = Ω₁(P)` has order `≥ 4` by `htop` and
`IsSuzuki2Grp.omega1_card_ge_four`.

*(Renamed from `nsd_false_of_irreducible` on 2026-10-06: `Work.Higman.no_square_derived`, which
is imported by `Work.Higman.nsd_transfer` and hence by this module, now declares a
root-namespace `Work.Higman.nsd_false_of_irreducible` as well, and the two declarations collided.
The canonical modern statements are `Work.Higman.no_square_derived.nsd_false_of_irreducible`
(proved from Higman's Lemma 8) and the namespaced `Work.Higman.H8.Clean.nsd_false_of_irreducible`
(in `Submission/Work/Higman/H8/Clean/NsdCore.lean`).  Nothing referred to this copy.)* -/
private theorem nsd_false_of_irreducible_legacy {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hirr : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D = A ∨ D = ⊤) :
    False := by
  classical
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  haveI : A.Normal := hAn
  -- ## the centraliser of `A`
  have hAleD : A ≤ Subgroup.centralizer (A : Set P) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact hAab b hb a ha
  have hDinv : (Subgroup.centralizer (A : Set P)).map (h.xi : MulAut P).toMonoidHom
      = Subgroup.centralizer (A : Set P) := by
    ext x
    rw [Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, rfl⟩ a ha
      rw [Subgroup.mem_centralizer_iff] at hy
      have ha' : ((h.xi : MulAut P)⁻¹) a ∈ A := symm_mem_of_map_eq (h.xi : MulAut P) hAxi ha
      have h1 : ((h.xi : MulAut P)⁻¹) a * y = y * ((h.xi : MulAut P)⁻¹) a := hy _ ha'
      calc a * h.xi y = h.xi (((h.xi : MulAut P)⁻¹) a) * h.xi y := by simp
        _ = h.xi (((h.xi : MulAut P)⁻¹) a * y) := by rw [map_mul]
        _ = h.xi (y * ((h.xi : MulAut P)⁻¹) a) := by rw [h1]
        _ = h.xi y * a := by rw [map_mul]; simp
    · intro hx
      refine ⟨((h.xi : MulAut P)⁻¹) x, ?_, by simp⟩
      rw [Subgroup.mem_centralizer_iff] at hx ⊢
      intro a ha
      have ha' : (h.xi : MulAut P) a ∈ A := by
        rw [← hAxi]
        exact Subgroup.mem_map_of_mem _ ha
      have h1 : h.xi a * x = x * h.xi a := hx _ ha'
      have h2 := congrArg (fun t : P => ((h.xi : MulAut P)⁻¹) t) h1
      simpa using h2
  -- ## every element outside `A` fails to centralise `A`
  have hcent : ∀ u : P, u ∉ A → ∃ a ∈ A, ⁅u, a⁆ ≠ 1 := by
    rcases hirr (Subgroup.centralizer (A : Set P)) inferInstance hDinv hAleD with hDA | hDtop
    · intro u hu
      by_contra hcon
      push Not at hcon
      have huD : u ∈ Subgroup.centralizer (A : Set P) := by
        rw [Subgroup.mem_centralizer_iff]
        intro a ha
        exact (commutatorElement_eq_one_iff_mul_comm.mp (hcon a ha)).symm
      rw [hDA] at huD
      exact hu huD
    · intro u hu
      exfalso
      have hAZ : A ≤ Subgroup.center P := (Subgroup.centralizer_eq_top_iff_subset).mp hDtop
      have hZc : Subgroup.center P = omega1 P := center_eq_omega1_new h
      have hAle2 : A ≤ powSub A 2 := by
        rw [htop]
        intro a ha
        rw [← hZc]
        exact hAZ ha
      have hAeq : A = powSub A 2 := le_antisymm hAle2 (powSub_le (n := 2) (by norm_num))
      have hcard2 : Nat.card ↥(omega1 P) = (Nat.card ↥(omega1 P)) ^ 2 := by
        have h1 : Nat.card ↥A = Nat.card ↥(omega1 P) := by rw [hAeq, htop]
        rw [← h1, h1] at hcard
        exact hcard
      nlinarith [hcard2, h.omega1_card_ge_four]
  -- ## the two fields
  have hAne : A ≠ ⊥ := by
    intro hbot
    have h1 : Nat.card ↥A = 1 := by rw [hbot]; simp
    rw [h1] at hcard
    have h4 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
    nlinarith [hcard, h4]
  obtain ⟨nZ, FZ, hFZf, hFZft, hFZd, hFZc, mu, hFZcard, hnZ, hmuord, hmu0, ζZ,
    hζZadd, hζZeq⟩ := omega1_iso_field h
  have hZcard : Nat.card ↥(omega1 P) = 2 ^ nZ := by
    rw [← Nat.card_congr ζZ, Nat.card_eq_fintype_card, hFZcard]
  obtain ⟨FV, hFVf, hFVft, hFVd, hFVc, lamV, hFVcard, hnV, hlamVord, hlamV0, ζV,
    hζVadd, hζVeq⟩ :=
    L1_iso_field_exp h hAxi hAab hNA hGs hsq hA4 htop hcard hirr nZ hZcard
  have hcFVZ : Fintype.card FV = Fintype.card FZ := by rw [hFVcard, hFZcard]
  let σ : FV ≃+* FZ := FiniteField.ringEquivOfCardEq hcFVZ
  set lam : FZ := σ lamV with hlamdef
  have hlamord : orderOf lam = 2 ^ nZ - 1 := by
    rw [hlamdef]
    have key : orderOf ((σ : FV →* FZ) lamV) = orderOf lamV :=
      orderOf_injective (σ : FV →* FZ) σ.injective lamV
    have h1 : orderOf (σ lamV) = orderOf ((σ : FV →* FZ) lamV) := rfl
    rw [h1, key, hlamVord]
  let ζV' : FZ ≃ (P ⧸ A) := σ.symm.toEquiv.trans ζV
  have hζV'add : ∀ x y : FZ, ζV' (x + y) = ζV' x * ζV' y := by
    intro x y
    show ζV (σ.symm (x + y)) = ζV (σ.symm x) * ζV (σ.symm y)
    rw [map_add, hζVadd]
  have hζV'eq : ∀ x : FZ, ∀ u : P, (u : P ⧸ A) = ζV' x →
      ζV' (lam * x) = (h.xi u : P ⧸ A) := by
    intro x u hu
    show ζV (σ.symm (lam * x)) = (h.xi u : P ⧸ A)
    have h1 : σ.symm (lam * x) = lamV * σ.symm x := by
      rw [hlamdef, map_mul, σ.symm_apply_apply]
    rw [h1]
    exact hζVeq (σ.symm x) u hu
  exact nsd_core h hAxi hAab hNA hGs hsq hA4 htop hcard hcent hnZ hFZcard hZcard
    lam mu hlamord hmuord ζV' hζV'add hζV'eq ζZ hζZadd hζZeq

end Work.Higman
end

-- ===== from Submission.Work.Higman.NSM.irreducible =====
section

/-!
# The irreducible case of the `C₄` exclusion

Higman, *Suzuki 2-groups* (1963), Lemma 8 applied with `C = ⊤` (whose proof goes through
Lemma 6): a Suzuki 2-group has no `ξ`-invariant abelian normal subgroup `A` of exponent `4`
with `Ω₁(P) ≤ A`, `[P,P] = A`, all squares in `A`, `A² = Ω₁(P)`, `|A| = |Ω₁(P)|²` and such that
`P ⧸ A` is irreducible as an `𝔽₂[ξ]`-module.

The irreducible hypothesis `hirr` (the only normal `ξ`-invariant subgroup `≥ A` is `A` or `⊤`)
turns into: every element outside `A` fails to centralise `A`.  Then `P ⧸ A` and `Ω₁(P)` are
identified with a common finite field `F` of order `2 ^ n` on which `ξ` acts by multiplication by
`lam`, respectively `mu`; the squaring and commutator maps of `P ⧸ A` give the alternating
`ξ`-equivariant pairing of `Work.Higman.c4_field_core`, and the eigenvalue bookkeeping of
Higman's Lemma 6 (`Work.Higman.c4_field_core`, packaged as `Work.Higman.nsd_core`) yields a
contradiction.
-/

open scoped commutatorElement

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

namespace Work.Higman.NSM

open Work.Higman

private theorem irreducible {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hirr : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D = A ∨ D = ⊤) :
    False := by
  classical
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  haveI : A.Normal := hAn
  -- ## the centraliser of `A`
  have hAleD : A ≤ Subgroup.centralizer (A : Set P) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact hAab b hb a ha
  have hDinv : (Subgroup.centralizer (A : Set P)).map (h.xi : MulAut P).toMonoidHom
      = Subgroup.centralizer (A : Set P) := by
    ext x
    rw [Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, rfl⟩ a ha
      rw [Subgroup.mem_centralizer_iff] at hy
      have ha' : ((h.xi : MulAut P)⁻¹) a ∈ A := symm_mem_of_map_eq (h.xi : MulAut P) hAxi ha
      have h1 : ((h.xi : MulAut P)⁻¹) a * y = y * ((h.xi : MulAut P)⁻¹) a := hy _ ha'
      calc a * h.xi y = h.xi (((h.xi : MulAut P)⁻¹) a) * h.xi y := by simp
        _ = h.xi (((h.xi : MulAut P)⁻¹) a * y) := by rw [map_mul]
        _ = h.xi (y * ((h.xi : MulAut P)⁻¹) a) := by rw [h1]
        _ = h.xi y * a := by rw [map_mul]; simp
    · intro hx
      refine ⟨((h.xi : MulAut P)⁻¹) x, ?_, by simp⟩
      rw [Subgroup.mem_centralizer_iff] at hx ⊢
      intro a ha
      have ha' : (h.xi : MulAut P) a ∈ A := by
        rw [← hAxi]
        exact Subgroup.mem_map_of_mem _ ha
      have h1 : h.xi a * x = x * h.xi a := hx _ ha'
      have h2 := congrArg (fun t : P => ((h.xi : MulAut P)⁻¹) t) h1
      simpa using h2
  -- ## every element outside `A` fails to centralise `A`
  have hcent : ∀ u : P, u ∉ A → ∃ a ∈ A, ⁅u, a⁆ ≠ 1 := by
    rcases hirr (Subgroup.centralizer (A : Set P)) inferInstance hDinv hAleD with hDA | hDtop
    · intro u hu
      by_contra hcon
      push Not at hcon
      have huD : u ∈ Subgroup.centralizer (A : Set P) := by
        rw [Subgroup.mem_centralizer_iff]
        intro a ha
        exact (commutatorElement_eq_one_iff_mul_comm.mp (hcon a ha)).symm
      rw [hDA] at huD
      exact hu huD
    · intro u hu
      exfalso
      have hAZ : A ≤ Subgroup.center P := (Subgroup.centralizer_eq_top_iff_subset).mp hDtop
      have hZc : Subgroup.center P = omega1 P := center_eq_omega1_new h
      have hAle2 : A ≤ powSub A 2 := by
        rw [htop]
        intro a ha
        rw [← hZc]
        exact hAZ ha
      have hAeq : A = powSub A 2 := le_antisymm hAle2 (powSub_le (n := 2) (by norm_num))
      have hcard2 : Nat.card ↥(omega1 P) = (Nat.card ↥(omega1 P)) ^ 2 := by
        have h1 : Nat.card ↥A = Nat.card ↥(omega1 P) := by rw [hAeq, htop]
        rw [← h1, h1] at hcard
        exact hcard
      nlinarith [hcard2, h.omega1_card_ge_four]
  -- ## the two fields
  have hAne : A ≠ ⊥ := by
    intro hbot
    have h1 : Nat.card ↥A = 1 := by rw [hbot]; simp
    rw [h1] at hcard
    have h4 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
    nlinarith [hcard, h4]
  obtain ⟨nZ, FZ, hFZf, hFZft, hFZd, hFZc, mu, hFZcard, hnZ, hmuord, hmu0, ζZ,
    hζZadd, hζZeq⟩ := omega1_iso_field h
  have hZcard : Nat.card ↥(omega1 P) = 2 ^ nZ := by
    rw [← Nat.card_congr ζZ, Nat.card_eq_fintype_card, hFZcard]
  obtain ⟨FV, hFVf, hFVft, hFVd, hFVc, lamV, hFVcard, hnV, hlamVord, hlamV0, ζV,
    hζVadd, hζVeq⟩ :=
    L1_iso_field_exp h hAxi hAab hNA hGs hsq hA4 htop hcard hirr nZ hZcard
  have hcFVZ : Fintype.card FV = Fintype.card FZ := by rw [hFVcard, hFZcard]
  let σ : FV ≃+* FZ := FiniteField.ringEquivOfCardEq hcFVZ
  set lam : FZ := σ lamV with hlamdef
  have hlamord : orderOf lam = 2 ^ nZ - 1 := by
    rw [hlamdef]
    have key : orderOf ((σ : FV →* FZ) lamV) = orderOf lamV :=
      orderOf_injective (σ : FV →* FZ) σ.injective lamV
    have h1 : orderOf (σ lamV) = orderOf ((σ : FV →* FZ) lamV) := rfl
    rw [h1, key, hlamVord]
  let ζV' : FZ ≃ (P ⧸ A) := σ.symm.toEquiv.trans ζV
  have hζV'add : ∀ x y : FZ, ζV' (x + y) = ζV' x * ζV' y := by
    intro x y
    show ζV (σ.symm (x + y)) = ζV (σ.symm x) * ζV (σ.symm y)
    rw [map_add, hζVadd]
  have hζV'eq : ∀ x : FZ, ∀ u : P, (u : P ⧸ A) = ζV' x →
      ζV' (lam * x) = (h.xi u : P ⧸ A) := by
    intro x u hu
    show ζV (σ.symm (lam * x)) = (h.xi u : P ⧸ A)
    have h1 : σ.symm (lam * x) = lamV * σ.symm x := by
      rw [hlamdef, map_mul, σ.symm_apply_apply]
    rw [h1]
    exact hζVeq (σ.symm x) u hu
  exact nsd_core h hAxi hAab hNA hGs hsq hA4 htop hcard hcent hnZ hFZcard hZcard
    lam mu hlamord hmuord ζV' hζV'add hζV'eq ζZ hζZadd hζZeq

end Work.Higman.NSM
end

-- ===== from Submission.Work.Higman.nsd_powSub_top_eq =====
section

set_option linter.style.haveILetI false

namespace Work.Higman

/-- Under the hypotheses of `no_square_derived`, the squares of `P` generate `A`:
`P ^ (2) = A`.  (The squares generate a `ξ`-invariant subgroup between `A²` and `A`; by
Higman's Lemma 1 (`xi_invariant_eq_powSub_two_or_self`) it is `A²` or `A`, and the first case
is impossible since then `P/A²` would have exponent `2`, hence be abelian, forcing
`A = P' ≤ A²`, which contradicts `|A| = |Ω₁(P)| ^ 2` with `|Ω₁(P)| ≥ 4`.) -/
private theorem nsd_powSub_top_eq {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    Work.Higman.powSub (⊤ : Subgroup P) 2 = A := by
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  have hAXi : IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  -- `D = P ^ (2)`, the subgroup generated by the squares of `P`.
  -- It lies in `A` because every square does (hypothesis `hsq`).
  have hDle : powSub (⊤ : Subgroup P) 2 ≤ A := by
    rw [powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  -- and it contains `A ^ (2)`.
  have hD2 : powSub A 2 ≤ powSub (⊤ : Subgroup P) 2 := powSub_mono le_top
  -- `D` is `ξ`-invariant since `ξ` preserves `⊤`.
  have hDin : (powSub (⊤ : Subgroup P) 2).map (h.xi : MulAut P).toMonoidHom
      = powSub (⊤ : Subgroup P) 2 :=
    map_powSub (h.xi : MulAut P)
      (Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective) 2
  -- Higman's Lemma 1: `D` is `A²` or `A`.
  rcases xi_invariant_eq_powSub_two_or_self h hAXi hDle hD2 hDin with hD | hD
  · -- `D = A² = Ω₁(P)`.  Then `P / Ω₁(P)` has exponent `2`, hence is abelian, so
    -- `A = P' ≤ Ω₁(P) = D ≤ A`, forcing `A = Ω₁(P)`, which contradicts the order formula.
    exfalso
    -- every square of `P` lies in `Ω₁(P)`
    have hsqN : ∀ x : P, x ^ 2 ∈ omega1 P := by
      intro x
      have hx : x ^ 2 ∈ powSub (⊤ : Subgroup P) 2 := pow_mem_powSub (Subgroup.mem_top x)
      rwa [hD, htop] at hx
    haveI : (omega1 P).Normal := Subgroup.normal_of_le_center h.omega1_le_center
    -- a group all of whose elements are involutions is abelian
    have hcomm : IsMulCommutative (P ⧸ omega1 P) := by
      rw [isMulCommutative_iff]
      intro a b
      have hsqquot : ∀ z : P ⧸ omega1 P, z * z = 1 := by
        intro z
        obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (omega1 P) z
        rw [← map_mul, ← pow_two]
        exact (QuotientGroup.eq_one_iff (x ^ 2)).mpr (hsqN x)
      have ha : a⁻¹ = a := inv_eq_of_mul_eq_one_left (hsqquot a)
      have hb : b⁻¹ = b := inv_eq_of_mul_eq_one_left (hsqquot b)
      have hab : (a * b)⁻¹ = a * b := inv_eq_of_mul_eq_one_right (hsqquot (a * b))
      calc a * b = (a * b)⁻¹ := hab.symm
        _ = b⁻¹ * a⁻¹ := mul_inv_rev a b
        _ = b * a := by rw [ha, hb]
    -- hence `P' ≤ Ω₁(P)`
    have hAle : commutator P ≤ omega1 P :=
      (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := omega1 P)).mp hcomm
    have hAleD : A ≤ omega1 P := by
      rw [← hGs, ← commutator_def]
      exact hAle
    have hAD : A = powSub (⊤ : Subgroup P) 2 := le_antisymm (by rwa [hD, htop]) hDle
    have hAom : A = omega1 P := by rw [hAD, hD, htop]
    have hAomc : Nat.card ↥(omega1 P) = Nat.card ↥A := by rw [hAom]
    have hcard' : Nat.card ↥A = (Nat.card ↥A) ^ 2 := hcard.trans (by rw [hAomc])
    have hge : 4 ≤ Nat.card ↥A := by
      have := h.omega1_card_ge_four
      rwa [hAomc] at this
    have hlt : Nat.card ↥A < (Nat.card ↥A) ^ 2 := by
      rw [pow_two]
      exact lt_mul_self (by omega)
    omega
  · exact hD

end Work.Higman
end

-- ===== from Submission.Work.Higman.NSM.redcase =====
section

open scoped commutatorElement

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

namespace Work.Higman.NSM

open Work.Higman

variable {P : Type} [Group P] [Finite P]

/-! ## The `C₄` setting: auxiliary facts -/

/-- If `A` contains the commutator subgroup then `P ⧸ A` is abelian. -/
private theorem quot_mul_comm {A : Subgroup P} [A.Normal]
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A) (a b : P ⧸ A) : a * b = b * a := by
  refine Quotient.inductionOn a (fun x => ?_)
  refine Quotient.inductionOn b (fun y => ?_)
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
  have key : (x * y)⁻¹ * (y * x) = ⁅y⁻¹, x⁻¹⁆ := by
    simp only [commutatorElement_def, mul_inv_rev, inv_inv, mul_assoc]
  rw [key]
  exact hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top y⁻¹) (Subgroup.mem_top x⁻¹))

/-- In the `C₄` setting `⁅A, ⊤⁆ = A ^ (2) = Ω₁(P)`. -/
private theorem commA_eq (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (htop : powSub A 2 = omega1 P) :
    ⁅A, (⊤ : Subgroup P)⁆ = powSub A 2 := by
  rcases H8.Clean.nsd_comm_eq_bot_or_omega1 h hAxi hAab hGs htop with hb | hT
  · exact absurd hb (H8.Clean.nsd_comm_eq_bot_false h hAab hNA hGs hsq htop)
  · rw [hT, ← htop]

/-- A `ξ`-invariant normal subgroup of `A` in the `C₄` setting is `⊥`, `A ^ (2)` or `A`. -/
private theorem trich (h : IsSuzuki2Grp P) {A S : Subgroup P}
    (hA : IsXiAbelNormal h A) (hA4 : powSub A 4 = ⊥)
    (hSA : S ≤ A) (hSinv : S.map (h.xi : MulAut P).toMonoidHom = S) :
    S = ⊥ ∨ S = powSub A 2 ∨ S = A := by
  obtain ⟨e, -, -, -, hsub⟩ := homogeneous_structure h hA.abelian hA.map_eq
  obtain ⟨i, hi⟩ := hsub S hSA hSinv
  rcases Nat.eq_zero_or_pos i with h0 | hpos
  · exact Or.inr (Or.inr (by rw [hi, h0, pow_zero, powSub_one_eq]))
  rcases Nat.lt_or_ge i 2 with hlt | hge
  · exact Or.inr (Or.inl (by rw [hi, show i = 1 by omega]; norm_num))
  · exact Or.inl (by
      rw [hi]
      have hdvd : 4 ∣ 2 ^ i := ⟨2 ^ (i - 2), by
        rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_add]; congr 1; omega⟩
      exact le_bot_iff.mp (hA4 ▸ powSub_le_of_dvd hA.abelian hdvd))

/-- For any `z` with `z ^ 2` central and any `d`: `⁅z, ⁅d, z⁆⁆ = ⁅d, z⁆ ^ (-2)`, i.e. `z` inverts
the commutator `⁅d, z⁆`.  Obtained from `⁅d, z * z⁆ = ⁅d, z⁆ * (z * ⁅d, z⁆ * z⁻¹)` (which is `1`
because `z * z` is central) and `z * u * z⁻¹ = ⁅z, u⁆ * u`. -/
private theorem commutator_self_inv_sq {G : Type} [Group G] {z d : G}
    (hz : z ^ 2 ∈ Subgroup.center G) : ⁅z, ⁅d, z⁆⁆ = (⁅d, z⁆ * ⁅d, z⁆)⁻¹ := by
  have hc : z * z ∈ Subgroup.center G := by simpa [pow_two] using hz
  have h1 : ⁅d, z * z⁆ = 1 := by
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact (Subgroup.mem_center_iff.mp hc d)
  have h2 : ⁅d, z * z⁆ = ⁅d, z⁆ * (z * ⁅d, z⁆ * z⁻¹) := by
    simp only [commutatorElement_def]; group
  have h3 : z * ⁅d, z⁆ * z⁻¹ = ⁅z, ⁅d, z⁆⁆ * ⁅d, z⁆ := by
    simp only [commutatorElement_def]; group
  have h4 : ⁅d, z⁆ * (⁅z, ⁅d, z⁆⁆ * ⁅d, z⁆) = 1 := by
    have hp : ⁅d, z⁆ * (z * ⁅d, z⁆ * z⁻¹) = 1 := h2.symm.trans h1
    rwa [h3] at hp
  have h5 : (⁅d, z⁆ * ⁅z, ⁅d, z⁆⁆) * ⁅d, z⁆ = 1 := by
    rw [mul_assoc]; exact h4
  have key : ⁅d, z⁆ * ⁅z, ⁅d, z⁆⁆ = (⁅d, z⁆)⁻¹ := mul_eq_one_iff_eq_inv.mp h5
  have h6 : ⁅z, ⁅d, z⁆⁆ = (⁅d, z⁆)⁻¹ * (⁅d, z⁆)⁻¹ := by
    calc ⁅z, ⁅d, z⁆⁆ = (⁅d, z⁆)⁻¹ * (⁅d, z⁆ * ⁅z, ⁅d, z⁆⁆) := by group
      _ = (⁅d, z⁆)⁻¹ * (⁅d, z⁆)⁻¹ := by rw [key]
  calc ⁅z, ⁅d, z⁆⁆ = (⁅d, z⁆)⁻¹ * (⁅d, z⁆)⁻¹ := h6
    _ = (⁅d, z⁆ * ⁅d, z⁆)⁻¹ := (mul_inv_rev _ _).symm

/-- **The `P/A`-normality of intermediate subgroups.**  In the `C₄` setting (`P/A` abelian),
every subgroup between `A` and a normal `C ≥ A` is normal in `P`.  Consequently the minimality
hypothesis about *normal* subgroups between `A` and `C` controls *all* `ξ`-invariant subgroups
there; this is what makes the reducible case accessible. -/
private theorem normal_of_le_of_le {A C D : Subgroup P} (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hCn : C.Normal) (hAD : A ≤ D) (hDC : D ≤ C) : D.Normal := by
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  haveI : A.Normal := hAn
  have hcommA : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ A := le_of_eq hGs
  refine ⟨fun y hy g => ?_⟩
  have hyC : y ∈ C := hDC hy
  have hgyC : g * y * g⁻¹ ∈ C := hCn.conj_mem y hyC g
  -- the two elements have the same image in the abelian quotient `P ⧸ A`
  have hcos : ((g * y * g⁻¹ : P) : P ⧸ A) = ((y : P) : P ⧸ A) := by
    have h1 : ((g * y * g⁻¹ : P) : P ⧸ A)
        = (g : P ⧸ A) * (y : P ⧸ A) * (g : P ⧸ A)⁻¹ := by
      rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv]
    rw [h1, quot_mul_comm hcommA g y, mul_assoc, mul_inv_cancel, mul_one]
  have hmem : y⁻¹ * (g * y * g⁻¹) ∈ A := by
    rw [← QuotientGroup.eq, hcos]
  have h1 : y⁻¹ * (g * y * g⁻¹) ∈ D := hAD hmem
  have h2 : g * y * g⁻¹ = y * (y⁻¹ * (g * y * g⁻¹)) := by group
  rw [h2]
  exact D.mul_mem hy h1

/-! ## The Suzuki structure on a `ξ`-invariant subgroup -/

/-- The automorphism of `↥C` induced by `ξ`, when `C` is `ξ`-invariant. -/
private noncomputable def xiSub (h : IsSuzuki2Grp P) {C : Subgroup P}
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) : MulAut ↥C where
  toFun x := ⟨h.xi x, by
    have hx := Subgroup.mem_map_of_mem ((h.xi : MulAut P).toMonoidHom) x.2
    rwa [hCinv] at hx⟩
  invFun x := ⟨(h.xi : MulAut P).symm x,
    symm_mem_of_map_eq (h.xi : MulAut P) hCinv x.2⟩
  left_inv x := Subtype.ext (by simp)
  right_inv x := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)

private theorem xiSub_apply (h : IsSuzuki2Grp P) {C : Subgroup P}
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) (x : ↥C) :
    ((xiSub h hCinv x : ↥C) : P) = h.xi (x : P) := rfl

private theorem xiSub_pow_apply (h : IsSuzuki2Grp P) {C : Subgroup P}
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) (k : ℕ) (x : ↥C) :
    (((xiSub h hCinv : MulAut ↥C) ^ k) x : P) = (h.xi ^ k) (x : P) := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [pow_succ', MulAut.mul_apply]
      show h.xi ((((xiSub h hCinv : MulAut ↥C) ^ k) x : ↥C) : P) = _
      rw [ih, pow_succ', MulAut.mul_apply]

/-- **A `ξ`-invariant subgroup containing `Ω₁(P)` and containing two non-commuting elements is
again a Suzuki 2-group** (with the restricted automorphism). -/
private noncomputable def isSuzuki2Grp_subgroup (h : IsSuzuki2Grp P) {C : Subgroup P}
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hOm : omega1 P ≤ C)
    (hni : ∃ x y : ↥C, x * y ≠ y * x) :
    IsSuzuki2Grp ↥C where
  isPGroup := h.isPGroup.to_subgroup C
  noncomm := hni
  manyInvol := by
    obtain ⟨x, y, hx2, hy2, hxy⟩ := h.manyInvol
    have hxC : x ∈ C := hOm (h.mem_omega1.mpr (by
      rw [← orderOf_dvd_iff_pow_eq_one, hx2]))
    have hyC : y ∈ C := hOm (h.mem_omega1.mpr (by
      rw [← orderOf_dvd_iff_pow_eq_one, hy2]))
    refine ⟨⟨x, hxC⟩, ⟨y, hyC⟩, ?_, ?_, ?_⟩
    · rw [← Subgroup.orderOf_coe, hx2]
    · rw [← Subgroup.orderOf_coe, hy2]
    · intro hcon
      exact hxy (congrArg Subtype.val hcon)
  xi := xiSub h hCinv
  trans := by
    intro x y hx2 hy2
    have hxP : orderOf (x : P) = 2 := by rw [Subgroup.orderOf_coe]; exact hx2
    have hyP : orderOf (y : P) = 2 := by rw [Subgroup.orderOf_coe]; exact hy2
    obtain ⟨k, hk⟩ := h.trans (x : P) (y : P) hxP hyP
    exact ⟨k, Subtype.ext (by rw [xiSub_pow_apply, hk])⟩

/-! ## Compatibility lemmas for passing to a subgroup

These are used to transport the `C₄` hypotheses from `P` to a `ξ`-invariant Suzuki subgroup
`↥C` (see the notes in `NOTES_redcase.md`). -/

/-- `powSub` commutes with passing to a subgroup. -/
private theorem powSub_subgroupOf {H C : Subgroup P} (hHC : H ≤ C)
    (hab : ∀ x ∈ H, ∀ y ∈ H, x * y = y * x) (n : ℕ) :
    powSub (H.subgroupOf C) n = (powSub H n).subgroupOf C := by
  have hab' : ∀ x ∈ H.subgroupOf C, ∀ y ∈ H.subgroupOf C, x * y = y * x := by
    intro x hx y hy
    exact Subtype.ext (hab x (Subgroup.mem_subgroupOf.mp hx) y (Subgroup.mem_subgroupOf.mp hy))
  apply le_antisymm
  · intro x hx
    obtain ⟨a, ha, hax⟩ := (Work.Higman.mem_powSub_iff hab').mp hx
    rw [Subgroup.mem_subgroupOf] at ha ⊢
    exact (Work.Higman.mem_powSub_iff hab).mpr ⟨a, ha, by
      have := congrArg (fun t : ↥C => (t : P)) hax
      simpa [Subgroup.coe_pow] using this⟩
  · intro x hx
    rw [Subgroup.mem_subgroupOf] at hx
    obtain ⟨a, ha, hax⟩ := (Work.Higman.mem_powSub_iff hab).mp hx
    refine (Work.Higman.mem_powSub_iff hab').mpr ⟨⟨a, hHC ha⟩, ?_, ?_⟩
    · exact Subgroup.mem_subgroupOf.mpr ha
    · exact Subtype.ext (by simpa [Subgroup.coe_pow] using hax)

/-- `Ω₁` commutes with passing to a Suzuki subgroup. -/
private theorem omega1_subgroupOf (h : IsSuzuki2Grp P) {C : Subgroup P}
    (hCSz : IsSuzuki2Grp ↥C) : omega1 ↥C = (omega1 P).subgroupOf C := by
  ext x
  rw [Subgroup.mem_subgroupOf, hCSz.mem_omega1]
  constructor
  · intro hx
    exact h.mem_omega1.mpr (by
      have := congrArg (fun t : ↥C => (t : P)) hx
      simpa [Subgroup.coe_pow] using this)
  · intro hx
    exact Subtype.ext (by
      have := h.mem_omega1.mp hx
      simpa [Subgroup.coe_pow] using this)

/-- The commutator subgroup commutes with passing to a subgroup. -/
private theorem commutator_subgroupOf (C : Subgroup P) :
    ⁅(⊤ : Subgroup ↥C), ⊤⁆ = (⁅C, C⁆).subgroupOf C := by
  have htopmap : Subgroup.map C.subtype (⊤ : Subgroup ↥C) = C := by
    ext x
    constructor
    · rintro ⟨y, -, rfl⟩
      exact y.2
    · intro hx
      exact ⟨⟨x, hx⟩, trivial, rfl⟩
  have h1 : Subgroup.map C.subtype ⁅(⊤ : Subgroup ↥C), ⊤⁆ = ⁅C, C⁆ := by
    rw [Subgroup.map_commutator, htopmap]
  apply le_antisymm
  · intro x hx
    rw [Subgroup.mem_subgroupOf]
    have hx' : (x : P) ∈ Subgroup.map C.subtype ⁅(⊤ : Subgroup ↥C), ⊤⁆ := ⟨x, hx, rfl⟩
    rwa [h1] at hx'
  · intro x hx
    rw [Subgroup.mem_subgroupOf] at hx
    have hx' : (x : P) ∈ Subgroup.map C.subtype ⁅(⊤ : Subgroup ↥C), ⊤⁆ := by
      rwa [h1]
    obtain ⟨y, hy, hyx⟩ := hx'
    have hyx' : y = x := Subtype.ext hyx
    rwa [← hyx']

/-- `map subtype` followed by `subgroupOf` is the identity. -/
private theorem subgroupOf_map_subtype {C : Subgroup P} (D : Subgroup ↥C) :
    (D.map C.subtype).subgroupOf C = D := by
  ext x
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_map]
  constructor
  · rintro ⟨y, hy, hyx⟩
    have hyx' : y = x := Subtype.ext hyx
    rwa [← hyx']
  · intro hx
    exact ⟨x, hx, rfl⟩

/-! ## The two remaining open sub-lemmas of the reducible case

* `sharp8` is Higman's auxiliary result 8 (Higman 1963, p. 87): for a minimal cover `C > A` with
  `C ^ (2) ≤ A` and `⁅C,C⁆ = A`, the subgroup `A` has exponent `2`.  Its proof uses Higman §4
  Lemma 6 in the (now proved) module form `Work.Higman.higman_lemma6_core`.
* `c4ReducibleHyp` is the case `D ^ (2) ≤ A ^ (2)` and `⁅D,D⁆ ≤ A ^ (2)` of the reducible
  exclusion. -/

/-- **Higman 1963, auxiliary result 8 (`C₄`-specialised form).**

For a minimal `ξ`-invariant normal cover `C > A` of `A` in the `C₄` setting with `C ^ (2) ≤ A`
and `⁅C,C⁆ = A`, we reach a contradiction.

Route: by `normal_of_le_of_le` the hypothesis `hcover` also excludes every `ξ`-invariant subgroup
strictly between `A` and `C`; `↥C` is a Suzuki 2-group (`isSuzuki2Grp_subgroup`); hence the
already proved `Work.Higman.NSM.irreducible` applies to `↥C` with the subgroup
`A.subgroupOf C`.  The transport of the `C₄` hypotheses to `↥C` uses `powSub_subgroupOf`,
`omega1_subgroupOf`, `commutator_subgroupOf` and `MSA.map_xi_subgroupOf`. -/
private theorem sharp8 (h : IsSuzuki2Grp P) {A C : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : powSub A 4 = ⊥) (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : powSub C 2 ≤ A) (hCd : ⁅C, C⁆ = A) :
    False := by
  classical
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  haveI : A.Normal := hAn
  have hAne : A ≠ ⊥ := by
    intro hb
    have h2 : powSub A 2 = ⊥ := by
      rw [hb, powSub]
      exact Subgroup.closure_eq_bot_iff.mpr (by
        rintro x ⟨y, hy, rfl⟩
        simp at hy
        rw [hy]
        simp)
    have h4 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
    rw [htop] at h2
    rw [h2] at h4
    simp at h4
  -- `C` is not abelian (`⁅C,C⁆ = A ≠ ⊥`)
  have hni : ∃ x y : ↥C, x * y ≠ y * x := by
    by_contra hcon
    push_neg at hcon
    have hbot : ⁅C, C⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro x hx
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      exact congrArg Subtype.val (hcon ⟨y, hy⟩ ⟨x, hx⟩)
    rw [hCd] at hbot
    exact hAne hbot
  set hCSz : IsSuzuki2Grp ↥C := isSuzuki2Grp_subgroup h hCinv (hNA.trans hAC) hni with hCSzdef
  have hxi : hCSz.xi = (xiSub h hCinv : MulAut ↥C) := by rw [hCSzdef]; rfl
  -- ## transport of the `C₄` hypotheses to `↥C`
  have hNA' : omega1 ↥C ≤ A.subgroupOf C := by
    rw [omega1_subgroupOf h hCSz]
    exact Subgroup.subgroupOf_mono C hNA
  have hGs' : ⁅(⊤ : Subgroup ↥C), ⊤⁆ = A.subgroupOf C := by
    rw [commutator_subgroupOf C, hCd]
  have hAxi' : Subgroup.map (hCSz.xi : MulAut ↥C).toMonoidHom (A.subgroupOf C)
      = A.subgroupOf C := by
    rw [hxi]
    exact MSA.map_xi_subgroupOf h hAxi hCinv
  have hAab' : ∀ x ∈ A.subgroupOf C, ∀ y ∈ A.subgroupOf C, x * y = y * x := by
    intro x hx y hy
    exact Subtype.ext (hAab x (Subgroup.mem_subgroupOf.mp hx) y (Subgroup.mem_subgroupOf.mp hy))
  have hsq' : ∀ x : ↥C, x ^ 2 ∈ A.subgroupOf C := by
    intro x
    rw [Subgroup.mem_subgroupOf]
    simpa using hsq (x : P)
  have hA4' : powSub (A.subgroupOf C) 4 = ⊥ := by
    rw [powSub_subgroupOf hAC hAab 4, hA4]
    simp
  have htop' : powSub (A.subgroupOf C) 2 = omega1 ↥C := by
    rw [powSub_subgroupOf hAC hAab 2, omega1_subgroupOf h hCSz, htop]
  have hcard' : Nat.card ↥(A.subgroupOf C) = (Nat.card ↥(omega1 ↥C)) ^ 2 := by
    rw [omega1_subgroupOf h hCSz]
    have h1 : Nat.card ↥(A.subgroupOf C) = Nat.card ↥A :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAC)
    have h2 : Nat.card ↥((omega1 P).subgroupOf C) = Nat.card ↥(omega1 P) :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe (hNA.trans hAC))
    rw [h1, h2]
    exact hcard
  -- ## the pair `(A.subgroupOf C, ↥C)` is irreducible
  have hirr : ∀ D : Subgroup ↥C, D.Normal → D.map (hCSz.xi : MulAut ↥C).toMonoidHom = D →
      A.subgroupOf C ≤ D → D = A.subgroupOf C ∨ D = ⊤ := by
    intro D hDn hDinv hA₀D
    have hADmap : A ≤ D.map C.subtype := by
      intro a ha
      exact ⟨⟨a, hAC ha⟩, hA₀D (Subgroup.mem_subgroupOf.mpr ha), rfl⟩
    have hDPn : (D.map C.subtype).Normal :=
      normal_of_le_of_le hGs hCn hADmap (Subgroup.map_subtype_le D)
    have hDPinv : (D.map C.subtype).map (h.xi : MulAut P).toMonoidHom = D.map C.subtype := by
      have hcomp : C.subtype.comp (xiSub h hCinv : MulAut ↥C).toMonoidHom
          = (h.xi : MulAut P).toMonoidHom.comp C.subtype := by
        ext x
        rfl
      have hDinv' : D.map (xiSub h hCinv : MulAut ↥C).toMonoidHom = D := by
        rw [← hxi]
        exact hDinv
      calc (D.map C.subtype).map (h.xi : MulAut P).toMonoidHom
          = D.map ((h.xi : MulAut P).toMonoidHom.comp C.subtype) :=
            Subgroup.map_map D (h.xi : MulAut P).toMonoidHom C.subtype
        _ = D.map (C.subtype.comp (xiSub h hCinv : MulAut ↥C).toMonoidHom) := by rw [hcomp]
        _ = (D.map (xiSub h hCinv : MulAut ↥C).toMonoidHom).map C.subtype :=
            (Subgroup.map_map D C.subtype (xiSub h hCinv : MulAut ↥C).toMonoidHom).symm
        _ = D.map C.subtype := by rw [hDinv']
    rcases hcover (D.map C.subtype) hDPn hDPinv hADmap (Subgroup.map_subtype_le D) with h1 | h1
    · left
      rw [← subgroupOf_map_subtype D, h1]
    · right
      rw [← subgroupOf_map_subtype D, h1, Subgroup.subgroupOf_self]
  exact irreducible hCSz hAxi' hAab' hNA' hGs' hsq' hA4' htop' hcard' hirr

/-- **The abelian sub-case `⁅D,D⁆ = ⊥`.**  With `D ^ (2) = A ^ (2)`, the squaring map
`D/A → A/A²` is zero, and it is injective because `D` is abelian with `Ω₁(D) = A²`; hence
`D = A`, contradicting `A < D`. -/
private theorem c4DerivBotCase (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (htop : powSub A 2 = omega1 P)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADlt : A < D)
    (hD2 : powSub D 2 = powSub A 2) (hDd : ⁅D, D⁆ = ⊥) : False := by
  classical
  have hD'ab : ∀ x ∈ D, ∀ y ∈ D, x * y = y * x := by
    intro x hx y hy
    have h1 : ⁅x, y⁆ ∈ (⊥ : Subgroup P) := by
      rw [← hDd]
      exact Subgroup.commutator_mem_commutator hx hy
    exact commutatorElement_eq_one_iff_mul_comm.mp (by simpa using h1)
  have hADle : A ≤ D := le_of_lt hADlt
  haveI : CommGroup ↥D := { mul_comm := fun a b => Subtype.ext (hD'ab a a.2 b b.2) }
  have hinj : ∀ x ∈ D, x ^ 2 ∈ powSub A 2 → x ∈ A := by
    intro x hx hx2
    obtain ⟨a, ha, ha2⟩ := (Work.Higman.mem_powSub_iff hAab).mp hx2
    have hsub : (x * a⁻¹) * (x * a⁻¹) = 1 := by
      have hcomm : x * a⁻¹ = a⁻¹ * x := hD'ab x hx a⁻¹ (D.inv_mem (hADle ha))
      calc (x * a⁻¹) * (x * a⁻¹) = a⁻¹ * x * (x * a⁻¹) := by rw [hcomm]
        _ = a⁻¹ * (x * x) * a⁻¹ := by group
        _ = a⁻¹ * (a * a) * a⁻¹ := by
              rw [show x * x = a * a by rw [← pow_two, ← pow_two]; exact ha2.symm]
        _ = 1 := by group
    have h2 : x * a⁻¹ ∈ powSub A 2 := by
      have hmem : x * a⁻¹ ∈ omega1 P := h.mem_omega1.mpr (by rw [pow_two]; exact hsub)
      exact htop.symm ▸ hmem
    have h3 : x = (x * a⁻¹) * a := by group
    rw [h3]
    exact A.mul_mem (powSub_le (by norm_num) h2) ha
  have hDA : D ≤ A := by
    intro x hx
    refine hinj x hx ?_
    have h : x ^ 2 ∈ powSub D 2 := Work.Higman.pow_mem_powSub hx
    rwa [hD2] at h
  exact absurd (le_antisymm hDA hADle) (Ne.symm (ne_of_lt hADlt))

/-- **The sub-case `⁅D,D⁆ = A`.**  Then the pair `(A, D)` has the full `C₄` shape inside the
Suzuki 2-group `↥D` (which is non-abelian), and minimality of `D` upgrades to irreducibility for
that pair; the irreducible case `Work.Higman.NSM.irreducible` applied to `↥D` gives the
contradiction. -/
private theorem c4DerivACase (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : powSub A 4 = ⊥) (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : D ≠ A)
    (hD2 : powSub D 2 = powSub A 2) (hDd : ⁅D, D⁆ = A)
    (hmin : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      powSub E 2 ≤ powSub A 2 → ⁅E,E⁆ ≤ A → A ≤ E → E ≤ D →
      E = A ∨ E = D) : False := by
  classical
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  haveI : A.Normal := hAn
  have hni : ∃ x y : ↥D, x * y ≠ y * x := by
    by_contra hcon
    push_neg at hcon
    have hbot : ⁅D, D⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro x hx
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      exact congrArg Subtype.val (hcon ⟨y, hy⟩ ⟨x, hx⟩)
    rw [hDd] at hbot
    have h2 : A ≠ ⊥ := by
      intro hb
      have h4 : 4 ≤ Nat.card ↥(omega1 P) := h.omega1_card_ge_four
      rw [hb] at hcard
      simp at hcard
      nlinarith [hcard, h4]
    exact h2 hbot
  set hDSz : IsSuzuki2Grp ↥D := isSuzuki2Grp_subgroup h hDinv (hNA.trans hAD) hni with hDSzdef
  have hxiD : hDSz.xi = (xiSub h hDinv : MulAut ↥D) := by rw [hDSzdef]; rfl
  have hNA'' : omega1 ↥D ≤ A.subgroupOf D := by
    rw [omega1_subgroupOf h hDSz]
    exact Subgroup.subgroupOf_mono D hNA
  have hGs'' : ⁅(⊤ : Subgroup ↥D), ⊤⁆ = A.subgroupOf D := by
    rw [commutator_subgroupOf D, hDd]
  have hAxi'' : Subgroup.map (hDSz.xi : MulAut ↥D).toMonoidHom (A.subgroupOf D)
      = A.subgroupOf D := by
    rw [hxiD]
    exact MSA.map_xi_subgroupOf h hAxi hDinv
  have hAab'' : ∀ x ∈ A.subgroupOf D, ∀ y ∈ A.subgroupOf D, x * y = y * x := by
    intro x hx y hy
    exact Subtype.ext (hAab x (Subgroup.mem_subgroupOf.mp hx) y (Subgroup.mem_subgroupOf.mp hy))
  have hsq'' : ∀ x : ↥D, x ^ 2 ∈ A.subgroupOf D := by
    intro x
    rw [Subgroup.mem_subgroupOf]
    simpa using hsq (x : P)
  have hA4'' : powSub (A.subgroupOf D) 4 = ⊥ := by
    rw [powSub_subgroupOf hAD hAab 4, hA4]
    simp
  have htop'' : powSub (A.subgroupOf D) 2 = omega1 ↥D := by
    rw [powSub_subgroupOf hAD hAab 2, omega1_subgroupOf h hDSz, htop]
  have hcard'' : Nat.card ↥(A.subgroupOf D) = (Nat.card ↥(omega1 ↥D)) ^ 2 := by
    rw [omega1_subgroupOf h hDSz]
    have h1 : Nat.card ↥(A.subgroupOf D) = Nat.card ↥A :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAD)
    have h2 : Nat.card ↥((omega1 P).subgroupOf D) = Nat.card ↥(omega1 P) :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe (hNA.trans hAD))
    rw [h1, h2]
    exact hcard
  have hirr : ∀ E : Subgroup ↥D, E.Normal → E.map (hDSz.xi : MulAut ↥D).toMonoidHom = E →
      A.subgroupOf D ≤ E → E = A.subgroupOf D ∨ E = ⊤ := by
    intro E hEn hEinv hA₀E
    have hAEmap : A ≤ E.map D.subtype := by
      intro a ha
      exact ⟨⟨a, hAD ha⟩, hA₀E (Subgroup.mem_subgroupOf.mpr ha), rfl⟩
    have hEmn : (E.map D.subtype).Normal :=
      normal_of_le_of_le hGs hDn hAEmap (Subgroup.map_subtype_le E)
    have hEminv : (E.map D.subtype).map (h.xi : MulAut P).toMonoidHom = E.map D.subtype := by
      have hcomp : D.subtype.comp (xiSub h hDinv : MulAut ↥D).toMonoidHom
          = (h.xi : MulAut P).toMonoidHom.comp D.subtype := by
        ext x
        rfl
      have hEinv' : E.map (xiSub h hDinv : MulAut ↥D).toMonoidHom = E := by
        rw [← hxiD]
        exact hEinv
      calc (E.map D.subtype).map (h.xi : MulAut P).toMonoidHom
          = E.map ((h.xi : MulAut P).toMonoidHom.comp D.subtype) :=
            Subgroup.map_map E (h.xi : MulAut P).toMonoidHom D.subtype
        _ = E.map (D.subtype.comp (xiSub h hDinv : MulAut ↥D).toMonoidHom) := by rw [hcomp]
        _ = (E.map (xiSub h hDinv : MulAut ↥D).toMonoidHom).map D.subtype :=
            (Subgroup.map_map E D.subtype (xiSub h hDinv : MulAut ↥D).toMonoidHom).symm
        _ = E.map D.subtype := by rw [hEinv']
    -- `E.map D.subtype` is again an admissible subgroup; minimality forces `E = A` or `E = D`
    have hE2 : powSub (E.map D.subtype) 2 ≤ powSub A 2 := by
      rw [← hD2]
      exact powSub_mono (Subgroup.map_subtype_le E)
    have hEd : ⁅(E.map D.subtype), (E.map D.subtype)⁆ ≤ A :=
      (Subgroup.commutator_mono (Subgroup.map_subtype_le E)
        (Subgroup.map_subtype_le E)).trans (le_of_eq hDd)
    rcases hmin (E.map D.subtype) hEmn hEminv hE2 hEd hAEmap (Subgroup.map_subtype_le E) with h1 | h1
    · left
      rw [← subgroupOf_map_subtype E, h1]
    · right
      rw [← subgroupOf_map_subtype E, h1, Subgroup.subgroupOf_self]
  exact irreducible hDSz hAxi'' hAab'' hNA'' hGs'' hsq'' hA4'' htop'' hcard'' hirr

/-- **A cycle-free copy of `MSA.centralizer_eq_self`** (Higman's Lemma 9, endgame): the
centralizer of a maximal `ξ`-invariant abelian normal subgroup is itself.  (The module
`MSA.centralizer_eq_self` is downstream of this file, so the statement is re-proved here, using
the Gorenstein–Thompson piece `NSM.c4gapCentralises` for the `⁅D,D⁆ = A²` case.) -/
private theorem c4_centralizer_eq_self (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : powSub A 4 = ⊥) (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hA : IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A) :
    Subgroup.centralizer (A : Set P) = A := by
  classical
  haveI : A.Normal := hA.normal
  set M : Subgroup P := Subgroup.centralizer (A : Set P) with hM
  have hAM : A ≤ M := by
    intro a ha
    rw [hM, Subgroup.mem_centralizer_iff]
    intro x hx
    exact hAab x hx a ha
  by_cases hMA : M ≤ A
  · exact le_antisymm hMA hAM
  · exfalso
    have hMne : M ≠ A := fun hEq => hMA (le_of_eq hEq)
    have hMn : M.Normal := by rw [hM]; infer_instance
    have hMinv : M.map (h.xi : MulAut P).toMonoidHom = M := by
      rw [hM]
      have hmem : ∀ g : P, (∀ a ∈ A, a * g = g * a) ↔ g ∈ Subgroup.centralizer (A : Set P) :=
        fun g => Subgroup.mem_centralizer_iff
      refine le_antisymm ?_ ?_
      · rintro y ⟨x, hx, rfl⟩
        refine (hmem (h.xi x)).mpr ?_
        intro a ha
        have hx' := (hmem x).mp hx
        have h1 := hx' ((h.xi : MulAut P).symm a) (symm_mem_of_map_eq (h.xi : MulAut P) hAxi ha)
        calc a * h.xi x = h.xi ((h.xi : MulAut P).symm a) * h.xi x := by simp
          _ = h.xi ((h.xi : MulAut P).symm a * x) := by rw [map_mul]
          _ = h.xi (x * (h.xi : MulAut P).symm a) := by rw [h1]
          _ = h.xi x * a := by rw [map_mul]; simp
      · intro y hy
        refine ⟨(h.xi : MulAut P).symm y, ?_, by simp⟩
        refine (hmem ((h.xi : MulAut P).symm y)).mpr ?_
        intro a ha
        have hy' := (hmem y).mp hy
        have h2 : h.xi a ∈ A := by
          have h3 := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom ha
          rwa [hAxi] at h3
        have h1 := hy' (h.xi a) h2
        have h4 : a * (h.xi : MulAut P).symm y = (h.xi : MulAut P).symm y * a := by
          have := congrArg (h.xi : MulAut P).symm h1
          simpa using this
        exact h4
    obtain ⟨D, hDn, hDinv, hAD, hDM, hDA, hcover⟩ :=
      MSA.exists_minimal_covering h (A := A) (M := M) hMn hMinv hAM hMne
    have hZ : ∀ d ∈ D, ∀ a ∈ A, d * a = a * d := by
      intro d hd a ha
      have hdM : d ∈ M := hDM hd
      rw [hM, Subgroup.mem_centralizer_iff] at hdM
      exact (hdM a ha).symm
    have hDdle : ⁅D, D⁆ ≤ A := by
      calc ⁅D, D⁆ ≤ ⁅(⊤ : Subgroup P), ⊤⁆ := Subgroup.commutator_mono le_top le_top
        _ = A := hGs
    have hDdxi : (⁅D, D⁆).map (h.xi : MulAut P).toMonoidHom = ⁅D, D⁆ := by
      rw [Subgroup.map_commutator, hDinv]
    rcases trich h hA hA4 hDdle hDdxi with hDbot | hDsq | hDself
    · -- `D` abelian, contradicting maximality of `A`
      exact hDA (hmax D ⟨hDn, hDinv, fun x hx y hy =>
        commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp
          (by rw [← hDbot]; exact Subgroup.commutator_mem_commutator hx hy))⟩ hAD)
    · -- `⁅D,D⁆ = A²`: `D` centralises `A`, Gorenstein–Thompson
      exact c4gapCentralises h hAxi hAab hNA hGs hsq hA4 htop hcard hA hmax hDn hDinv
        hAD (Ne.symm hDA) hcover hDsq hZ
    · -- `⁅D,D⁆ = A`: then `⁅x,y⁆² = ⁅x²,y⁆ = 1`, so `D' ≤ A² < A`
      have hA2lt : powSub A 2 < A := by
        refine lt_of_le_of_ne (powSub_le (n := 2) (by norm_num)) (Ne.symm ?_)
        intro heq
        have h1 : Nat.card ↥A = Nat.card ↥(omega1 P) := by rw [heq, htop]
        rw [h1] at hcard
        have h4 := h.omega1_card_ge_four
        nlinarith [hcard, h4]
      have hsq_le : ⁅D, D⁆ ≤ powSub A 2 := by
        refine Subgroup.commutator_le.mpr ?_
        intro x hx y hy
        rw [htop]
        refine h.mem_omega1.mpr ?_
        -- `⁅x,y⁆² = ⁅x²,y⁆ = 1`
        have h1 : ⁅x * x, y⁆ = x * ⁅x, y⁆ * x⁻¹ * ⁅x, y⁆ := by
          simp only [commutatorElement_def]; group
        have h2 : ⁅x * x, y⁆ = 1 := by
          have hx2 : x * x ∈ A := by simpa [pow_two] using hsq x
          exact commutatorElement_eq_one_iff_mul_comm.mpr (hZ y hy (x * x) hx2).symm
        have h3 : x * ⁅x, y⁆ * x⁻¹ = ⁅x, y⁆ := by
          have hmem : ⁅x, y⁆ ∈ A := hDself ▸ Subgroup.commutator_mem_commutator hx hy
          rw [hZ x hx ⁅x, y⁆ hmem]
          group
        rw [h1, h3, ← pow_two] at h2
        exact h2
      exact not_le_of_gt hA2lt (hDself ▸ hsq_le)

/-- **The isolated hard core of the residual** (delegated as
`Submission.Work.Higman.NSM.c4gapHard`): the `L₁ × L₂ → L₃` configuration of Higman's §4 Lemma 6:
`C` does *not* centralise `A` and `⁅⊤,C⁆ = A`. -/
private theorem c4gapHard (h : IsSuzuki2Grp P) {A C : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : powSub A 4 = ⊥) (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hA : IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ C → E = A ∨ E = C)
    (hCd : ⁅C, C⁆ = powSub A 2)
    (hC2 : powSub C 2 = powSub A 2)
    (hCcard : Nat.card ↥C = (Nat.card ↥(omega1 P)) ^ 3)
    (hACd : ⁅A, C⁆ = powSub A 2)
    (hCP : ⁅(⊤ : Subgroup P), C⁆ = A) :
    False := by
  sorry

/-- **The residual of the `C₄` exclusion**, reduced to `c4gapHard`:
`⁅A,C⁆ = ⊥` is `c4gapCentralises` (Gorenstein–Thompson), and for `⁅A,C⁆ = A²` the sub-cases
`C² = ⊥`, `C² = A`, `⁅⊤,C⁆ = A²` are discarded (the last one forces `⁅A,C⁆ = ⊥`). -/
private theorem c4gap (h : IsSuzuki2Grp P) {A C : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : powSub A 4 = ⊥)
    (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hA : IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ C → E = A ∨ E = C)
    (hCd : ⁅C, C⁆ = powSub A 2) :
    False := by
  classical
  have hA2ne : powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(omega1 P) = 1 := by rw [← htop, hb]; simp
    have h2 := h.omega1_card_ge_four
    omega
  have hACxi : (⁅A, C⁆).map (h.xi : MulAut P).toMonoidHom = ⁅A, C⁆ := by
    rw [Subgroup.map_commutator, hAxi, hCinv]
  have hACle : ⁅A, C⁆ ≤ A := by
    calc ⁅A, C⁆ ≤ ⁅C, C⁆ := Subgroup.commutator_mono hAC le_rfl
      _ = powSub A 2 := hCd
      _ ≤ A := powSub_le (n := 2) (by norm_num)
  have hC2le : powSub C 2 ≤ A := by
    rw [powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  have hC2xi : (powSub C 2).map (h.xi : MulAut P).toMonoidHom = powSub C 2 :=
    map_powSub (h.xi : MulAut P) hCinv 2
  have hCPle : ⁅(⊤ : Subgroup P), C⁆ ≤ A := by
    rw [← hGs]
    exact Subgroup.commutator_mono le_rfl le_top
  have hCPxi : (⁅(⊤ : Subgroup P), C⁆).map (h.xi : MulAut P).toMonoidHom
      = ⁅(⊤ : Subgroup P), C⁆ := by
    rw [Subgroup.map_commutator,
      Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective, hCinv]
  have hA2leCP : powSub A 2 ≤ ⁅(⊤ : Subgroup P), C⁆ := by
    rw [← hCd]
    exact Subgroup.commutator_mono le_top le_rfl
  rcases trich h hA hA4 hACle hACxi with hACbot | hACsq | hACself
  · -- `⁅A,C⁆ = ⊥`: Gorenstein–Thompson
    refine c4gapCentralises h hAxi hAab hNA hGs hsq hA4 htop hcard hA hmax hCn hCinv
      hAC hCA hcover hCd ?_
    intro c hc a ha
    have hmem : ⁅a, c⁆ ∈ ⁅A, C⁆ := Subgroup.commutator_mem_commutator ha hc
    rw [hACbot] at hmem
    have h1 : ⁅a, c⁆ = 1 := by simpa using hmem
    exact (commutatorElement_eq_one_iff_mul_comm.mp h1).symm
  · -- `⁅A,C⁆ = A²`
    rcases trich h hA hA4 hC2le hC2xi with hC2bot | hC2sq | hC2self
    · -- `C² = ⊥`: then `C ≤ Ω₁(P) ≤ A`
      have hCle : C ≤ omega1 P := by
        intro x hx
        rw [h.mem_omega1]
        have hxm : x ^ 2 ∈ powSub C 2 := pow_mem_powSub hx
        rw [hC2bot] at hxm
        simpa using hxm
      exact hCA (le_antisymm hAC (hCle.trans hNA))
    · -- `C² = A²`
      have hCcard : Nat.card ↥C = (Nat.card ↥(omega1 P)) ^ 3 :=
        C4Cover.c4_cover_card_eq_cube h hAab hNA hGs hsq htop hcard hCn hCinv hAC hCA
          hcover hCd
      rcases trich h hA hA4 hCPle hCPxi with hCPbot | hCPsq | hCPeq
      · exact hA2ne (le_bot_iff.mp (hCPbot ▸ hA2leCP))
      · -- `⁅⊤,C⁆ = A²` forces `⁅A,C⁆ = ⊥`
        have hsq_cent : ∀ u : P, ∀ d ∈ C, u ^ 2 * d = d * u ^ 2 := by
          intro u d hd
          have hud : ⁅u, d⁆ ∈ powSub A 2 := by
            rw [← hCPsq]
            exact Subgroup.commutator_mem_commutator (Subgroup.mem_top u) hd
          have hcent : ⁅u, d⁆ ∈ Subgroup.center P := h.omega1_le_center (htop ▸ hud)
          have hinv : ⁅u, d⁆ ^ 2 = 1 := h.mem_omega1.mp (htop ▸ hud)
          have h2 : ⁅u, ⁅u, d⁆⁆ = 1 :=
            commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp hcent u)
          have h4 : ⁅u ^ 2, d⁆ = 1 := by
            rw [Work.Higman.commutatorElement_sq_self u d, h2, hinv, one_mul]
          exact commutatorElement_eq_one_iff_mul_comm.mp h4
        have h1 : A ≤ Subgroup.centralizer (C : Set P) := by
          rw [← nsd_powSub_top_eq h hAxi hAab hGs hsq htop hcard, powSub,
            Subgroup.closure_le]
          rintro y ⟨u, -, rfl⟩
          exact Subgroup.mem_centralizer_iff.mpr (fun d hd => (hsq_cent u d hd).symm)
        have h2 : ⁅A, C⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr h1
        rw [hACsq] at h2
        exact hA2ne h2
      · exact c4gapHard h hAxi hAab hNA hGs hsq hA4 htop hcard hA hmax hCn hCinv
          hAC hCA hcover hCd hC2sq hCcard hACsq hCPeq
    · -- `C² = A`: Higman's Lemma 7
      have hPhi : powSub C 2 ⊔ ⁅C, C⁆ = A := by
        rw [hC2self, hCd]
        exact sup_eq_left.mpr (powSub_le (n := 2) (by norm_num))
      have hab : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x :=
        MSA.higman_lemma7_msa h hA hCn hCinv hAC hCA hcover hPhi (le_of_eq hCd)
      have hCbot : ⁅C, C⁆ = ⊥ := by
        rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
        intro x hx
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        exact (hab x hx y hy).symm
      rw [hCbot] at hCd
      exact hA2ne hCd.symm
  · -- `⁅A,C⁆ = A`: then `A ≤ A²`
    have hAle : A ≤ powSub A 2 := by
      calc A = ⁅A, C⁆ := hACself.symm
        _ ≤ ⁅C, C⁆ := Subgroup.commutator_mono hAC le_rfl
        _ = powSub A 2 := hCd
    have hAeq : A = powSub A 2 := le_antisymm hAle (powSub_le (n := 2) (by norm_num))
    have h1 : Nat.card ↥A = Nat.card ↥(omega1 P) := by rw [hAeq, htop]
    rw [h1] at hcard
    have h4 := h.omega1_card_ge_four
    nlinarith [hcard, h4]

/-- **The genuinely hard configuration.**  A `ξ`-invariant normal `D > A` in the `C₄` setting with
`D ^ (2) = A ^ (2)` and `⁅D,D⁆ = A ^ (2)`: `D` is a Suzuki 2-group with
`D' = Ω₁(D) = Z(D) = A²` and `A ⊴ D` abelian with `A² = Ω₁(D)`, `|A| = |Ω₁(D)|²`; this is the
`L₁ × L₂ → L₃` pattern of Higman's §4 Lemma 6 (whose module form,
`Work.Higman.higman_lemma6_core`, is already proved and axiom-clean in this workspace). -/
private theorem c4DerivSqCase (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : omega1 P ≤ A) (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A) (hA4 : powSub A 4 = ⊥) (htop : powSub A 2 = omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(omega1 P)) ^ 2)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : D ≠ A)
    (hD2 : powSub D 2 = powSub A 2) (hDd : ⁅D, D⁆ = powSub A 2) : False := by
  classical
  have hAn : A.Normal := H8.Clean.nsd_normal hGs
  haveI : A.Normal := hAn
  have hA : IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  have hmax := c4sqAMaximal h hAxi hAab hNA hGs hsq hA4 htop hcard
  -- a minimal `ξ`-invariant normal cover `C ≤ D` of `A`
  obtain ⟨C, hCn, hCinv, hAC, hCD, hCA, hcover⟩ :=
    MSA.exists_minimal_covering h (A := A) (M := D) hDn hDinv hAD hADne
  have hCA' : A ≠ C := Ne.symm hCA
  have hClt : A < C := lt_of_le_of_ne hAC hCA'
  -- the dichotomy for `⁅C,C⁆`
  have hDxi : (⁅C, C⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅C, C⁆ := by
    rw [Subgroup.map_commutator, hCinv]
  have hDle : ⁅C, C⁆ ≤ A := by
    rw [← hGs]
    exact Subgroup.commutator_mono le_top le_top
  rcases trich h hA hA4 hDle hDxi with hCbot | hCsq | hCder
  · -- `⁅C,C⁆ = ⊥`: `C` abelian, contradicting maximality of `A`
    exact hCA' (hmax C ⟨hCn, hCinv, fun x hx y hy =>
      commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp
        (by rw [← hCbot]; exact Subgroup.commutator_mem_commutator hx hy))⟩ hAC).symm
  · -- `⁅C,C⁆ = A²`: the residual
    exact c4gap h hAxi hAab hNA hGs hsq hA4 htop hcard hA hmax hCn hCinv hAC hCA' hcover hCsq
  · -- `⁅C,C⁆ = A`: Higman's Lemma 8 forces `exp A ∣ 2`
    have hC2le : powSub C 2 ≤ A := by
      rw [powSub, Subgroup.closure_le]
      rintro y ⟨x, -, rfl⟩
      exact hsq x
    have hexp : ∀ a ∈ A, a * a = 1 :=
      MSA.lemma8_clean h hA hCn hCinv hAC hCA' hcover hC2le hCder
    have hAle : A ≤ omega1 P := by
      intro a ha
      rw [h.mem_omega1]
      simpa [pow_two] using hexp a ha
    have hAeq : A = powSub A 2 :=
      le_antisymm (by rw [htop]; exact hAle) (powSub_le (n := 2) (by norm_num))
    have h1 : Nat.card ↥A = Nat.card ↥(omega1 P) := by rw [hAeq, htop]
    rw [h1] at hcard
    have h4 := h.omega1_card_ge_four
    nlinarith [hcard, h4]

end Work.Higman.NSM
end

-- ===== from Submission.Work.Higman.Q3.Dsq_sq_mem_powSub_two =====
section
/-
Copyright (c) 2024. All rights reserved.

# Squares of a class-two Suzuki subgroup lie in `Ω₁`

`Work.Higman.Q3.Dsq_sq_mem_powSub_two`: in the `C₄` setting, if `D ⊴ P` is `ξ`-invariant with
`A ≤ D` and `⁅D,D⁆ = powSub A 2 = Ω₁(P)`, then `D` is a Suzuki 2-group of class two with
`Ω₁(D) = Z(D) = A²`, so every square of an element of `D` lies in `A²`.

This is what kills the branch `E' = A²` of the `C₄` exclusion: there `E ⊴ P` is `ξ`-invariant
with `E' = A²`, and an element `x ∈ E∖A` with `x² ∉ A²` would contradict this lemma.
-/


open scoped commutatorElement

namespace Work.Higman.Q3

private theorem Dsq_sq_mem_powSub_two {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2) :
    ∀ x ∈ D, x ^ 2 ∈ Work.Higman.powSub A 2 := by
  -- `A ^ 2 = Ω₁(P) ≠ ⊥`
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hbot
    have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hbot]; simp
    have h4 := h.omega1_card_ge_four
    omega
  -- `Ω₁(P) ≤ D`
  have hOmD : Work.Higman.omega1 P ≤ D := by
    rw [← htop]
    exact (Work.Higman.powSub_le (A := A) (n := 2) (by norm_num)).trans hAD
  -- `D` is not abelian, because `[D,D] = A² ≠ ⊥`
  have hni : ∃ x y : ↥D, x * y ≠ y * x := by
    by_contra hcon
    push Not at hcon
    have hDab : ∀ x ∈ D, ∀ y ∈ D, x * y = y * x := fun x hx y hy =>
      congrArg Subtype.val (hcon ⟨x, hx⟩ ⟨y, hy⟩)
    have hbot : ⁅D, D⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro x hx
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      exact (hDab x hx y hy).symm
    exact hA2ne (by rw [← hDd]; exact hbot)
  haveI hDSz : Work.Higman.IsSuzuki2Grp ↥D :=
    Work.Higman.NSM.isSuzuki2Grp_subgroup h hDinv hOmD hni
  -- `Z(D) = Ω₁(D) = Ω₁(P)` inside `D`
  have hZm : Subgroup.center ↥D = (Work.Higman.powSub A 2).subgroupOf D := by
    rw [Work.Higman.center_eq_omega1_new hDSz, Work.Higman.NSM.omega1_subgroupOf h hDSz, htop]
  -- the two hypotheses of the class-two lemma, inside `↥D`
  have hZc : ⁅(⊤ : Subgroup ↥D), ⊤⁆ ≤ Subgroup.center ↥D := by
    intro u hu
    rw [Work.Higman.NSM.commutator_subgroupOf D, hDd] at hu
    rw [hZm]
    exact hu
  have h2c : ∀ u v : ↥D, (u * v * u⁻¹ * v⁻¹) ^ 2 = 1 := by
    intro u v
    have hmem : u * v * u⁻¹ * v⁻¹ ∈ ⁅(⊤ : Subgroup ↥D), ⊤⁆ :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top u) (Subgroup.mem_top v)
    rw [Work.Higman.NSM.commutator_subgroupOf D, hDd] at hmem
    have hP : ((u * v * u⁻¹ * v⁻¹ : ↥D) : P) ∈ Work.Higman.omega1 P := by
      rw [← htop]
      exact (Subgroup.mem_subgroupOf ..).mp hmem
    have h2 : ((u * v * u⁻¹ * v⁻¹ : ↥D) : P) ^ 2 = 1 := h.mem_omega1.mp hP
    exact Subtype.ext (by simpa using h2)
  intro x hx
  have hx2 : (⟨x, hx⟩ : ↥D) ^ 2 ∈ Subgroup.center ↥D :=
    sq_mem_center_of_class_two hZc h2c ⟨x, hx⟩
  rw [hZm] at hx2
  simpa using (Subgroup.mem_subgroupOf ..).mp hx2

end Work.Higman.Q3
end

-- ===== from Submission.Work.Higman.H8.c4_comm_A_top =====
section
/-
Copyright (c) 2024. All rights reserved.

# The `C₄` setting: `⁅A,⊤⁆ = A²` (session 9)

In the `C₄` setting (`P` a Suzuki 2-group, `A ⊴ P` abelian `ξ`-invariant with `Ω₁(P) ≤ A`,
`⁅⊤,⊤⁆ = A`, every square of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)`, `|A| = |Ω₁(P)|²`) the subgroup
`⁅A,⊤⁆` is `ξ`-invariant normal and `≤ A`, hence one of `⊥`, `A²`, `A`.

This file proves that the value is **never `A`**:

* `Work.Higman.not_isNilpotent_of_commutator_self` — if `A ⊴ G`, `⁅A,⊤⁆ = A` and `A ≠ ⊥`, then
  `G` is not nilpotent.  (The lower central series of `G` then satisfies `A ≤ γ_{n+1}(G)` for all
  `n`; nilpotency would force `γ_m(G) = ⊥` for some `m`.)
* Consequently, since a finite `2`-group is nilpotent and in the `C₄` setting
  `A ⊇ Ω₁(P) ≠ ⊥`, we get `⁅A,⊤⁆ ≠ A`, and the dichotomy leaves `⁅A,⊤⁆ = A²`.

The value `⁅A,⊤⁆ = A²` is what makes the squaring and commutator maps of `P/A` well defined:
`(xa)² = x²·a²·⁅a,x⁆` with `a² ∈ A²` and `⁅a,x⁆ ∈ ⁅A,⊤⁆ = A²`, and `⁅xa,y⁆ = ⁅x,y⁆·⁅a,y⁆` with
`⁅a,y⁆ ∈ A²`; and it makes `Erad := {x : ⁅x,⊤⁆ ≤ A²}` contain `A`.
-/


set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped commutatorElement

namespace Work.Higman

/-- **Nilpotency obstruction.**  If `A ⊴ G` satisfies `⁅A,⊤⁆ = A` and `A ≠ ⊥`, then `G` is not
nilpotent: otherwise `⊥ = γ_m(G) ≥ A` for some `m`.

This is the elementary fact that rules out the `C₄` value `⁅A,⊤⁆ = A`. -/
private theorem not_isNilpotent_of_commutator_self {G : Type*} [Group G] {A : Subgroup G} [A.Normal]
    (h : ⁅A, (⊤ : Subgroup G)⁆ = A) (hne : A ≠ ⊥) : ¬ Group.IsNilpotent G := by
  intro hnil
  have hγ1 : A ≤ (⊤ : Subgroup G).lowerCentralSeries 1 := by
    rw [Subgroup.top_lowerCentralSeries_one, ← h]
    exact Subgroup.commutator_mono le_top le_top
  have hγ : ∀ n : ℕ, A ≤ (⊤ : Subgroup G).lowerCentralSeries (n + 1) := by
    intro n
    induction n with
    | zero => exact hγ1
    | succ n ih =>
        have h1 : A ≤ ⁅(⊤ : Subgroup G).lowerCentralSeries (n + 1), (⊤ : Subgroup G)⁆ := by
          rw [← h]
          exact Subgroup.commutator_mono ih le_rfl
        simpa [Subgroup.lowerCentralSeries_succ] using h1
  obtain ⟨n, hn⟩ := (Subgroup.nilpotent_iff_lowerCentralSeries).mp hnil
  have h0 : A ≤ (⊥ : Subgroup G) := by
    have h1 := hγ n
    rw [Subgroup.lowerCentralSeries_succ, hn, Subgroup.commutator_bot_left] at h1
    exact h1
  exact hne (le_bot_iff.mp h0)

/-- **The `C₄` setting: `⁅A,⊤⁆ = A²`.**

`P` a Suzuki 2-group, `A ⊴ P` abelian `ξ`-invariant with `Ω₁(P) ≤ A`, `⁅⊤,⊤⁆ = A`,
`A⁴ = 1`, `A² = Ω₁(P)`, and `A² ≤ ⁅A,⊤⁆` (e.g. because `⁅D,A⁆ = A²` for some `D`).  Then
`⁅A,⊤⁆ = A²`: it is `ξ`-invariant `≤ A`, hence `⊥`, `A²` or `A`; `⊥` is excluded by the
containment `A² ≤ ⁅A,⊤⁆` and `A` by the nilpotency obstruction
`Work.Higman.not_isNilpotent_of_commutator_self` (a finite `2`-group is nilpotent). -/
private theorem comm_A_top_eq_powSub_two {P : Type} [Group P] [Finite P] (h : IsSuzuki2Grp P)
    {A : Subgroup P} (hAn : A.Normal)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hNA : omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hA4 : powSub A 4 = ⊥)
    (htop : powSub A 2 = omega1 P)
    (hA2le : powSub A 2 ≤ ⁅A, (⊤ : Subgroup P)⁆) :
    ⁅A, (⊤ : Subgroup P)⁆ = powSub A 2 := by
  haveI : A.Normal := hAn
  have hle : ⁅A, (⊤ : Subgroup P)⁆ ≤ A :=
    (Subgroup.commutator_mono le_top le_top).trans (le_of_eq hGs)
  have hinv : (⁅A, (⊤ : Subgroup P)⁆).map (h.xi : MulAut P).toMonoidHom
      = ⁅A, (⊤ : Subgroup P)⁆ := by
    rw [Subgroup.map_commutator, hAxi,
      Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective]
  have hA2ne : powSub A 2 ≠ ⊥ := by
    intro hb
    have h1 : Nat.card ↥(omega1 P) = 1 := by rw [← htop, hb]; simp
    have h4 := h.omega1_card_ge_four
    omega
  rcases HS.xi_inv_sub_dichotomy h hAab hAxi htop hA4 hle hinv with hb | h2 | h3
  · exact absurd (le_bot_iff.mp (hb ▸ hA2le)) hA2ne
  · exact h2
  · exfalso
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    refine not_isNilpotent_of_commutator_self h3 ?_ (h.isPGroup.isNilpotent)
    intro hb
    exact hA2ne (le_bot_iff.mp ((hA2le.trans (le_of_eq h3)).trans (le_of_eq hb)))

end Work.Higman
end

-- ===== from Submission.Work.Higman.H8.c4_card_le =====
section
/-
Copyright (c) 2024. All rights reserved.

# The `C₄`-cardinality bound `|P| ≤ |Ω₁(P)|³` for a Suzuki 2-group

Higman, *Suzuki 2-groups*, Illinois J. Math. **7** (1963), 79--96, Theorem 1 / Lemma 13.

The proof splits according to whether `[P,P] ≤ Ω₁(P)`.

* **Class-two case** (`c4_card_le_of_comm_le_omega1`).  If `[P,P] ≤ Ω₁(P)` then `Z(P) = Ω₁(P)`
  (Higman's Theorem 1, proved unconditionally as `Work.Higman.center_eq_omega1_new`), every square
  is central, and the squaring map `P ⧸ Z(P) → Z(P)`, `xZ ↦ x²` is an anisotropic quadratic map
  over `𝔽₂` with polar form the commutator pairing.  Chevalley–Warning
  (`Work.Higman.card_le_sq_of_quadratic_anisotropic`, `chevalley_warning.lean`) gives
  `|P ⧸ Z(P)| ≤ |Z(P)|²`, hence `|P| ≤ |Ω₁(P)|³`.

* **`C₄`-case** (`c4_exclusion_alt`).  If `[P,P] ≰ Ω₁(P)` then the maximal `ξ`-invariant abelian
  normal subgroup `A` (Higman's Lemma 9, `Work.Higman.lemma9_maximal_abelian`) satisfies
  `|A| = |Ω₁(P)|²`, `A² = Ω₁(P)`, `[P,P] = A`, `A⁴ = ⊥`: the `C₄` shape of Higman's Lemma 8,
  which is impossible.  The case analysis on a minimal `ξ`-invariant normal cover `C > A` is:

  * `C' = ⊥`: then `C` is abelian, contradicting maximality of `A`;
  * `C' = A`: Higman's Lemma 8 (`Work.Higman.higman_lemma8`, clean) gives `exp A ≤ 2`, i.e.
    `A ≤ Ω₁(P) = A²`, contradiction;
  * `C' = A²`: if `C² = A` then Higman's Lemma 7 (`Work.Higman.higman9_case_deriv_le_sq`) makes
    `C` abelian, contradiction; if `C² = ⊥` then `C ≤ Ω₁(P)`; the remaining case `C' = C² = Ω₁(P)`
    is isolated as `c4_cover_deriv_sq_false`.
-/


set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

namespace Work.Higman.H8

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-! ## Class-two commutator algebra

Self-contained copies of the standard class-two identities, so that this file does not need any
module whose proofs are incomplete. -/

/-- `x * y * x⁻¹ = ⁅x, y⁆ * y`. -/
private theorem c4_mul_mul_inv_eq_commutator_mul {G : Type*} [Group G] (x y : G) :
    x * y * x⁻¹ = ⁅x, y⁆ * y := by
  rw [commutatorElement_def]; group

/-- In a group of class two every commutator is central, and every element commutes with it. -/
private theorem c4_commutator_central_comm {G : Type*} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    z * ⁅x, y⁆ = ⁅x, y⁆ * z :=
  Subgroup.mem_center_iff.mp
    (hZ (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))) z

/-- Class two: `[x * y, z] = [x, z] * [y, z]`. -/
private theorem c4_commutator_mul_left {G : Type*} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    ⁅x * y, z⁆ = ⁅x, z⁆ * ⁅y, z⁆ := by
  have hcy : ∀ w : G, w * ⁅y, z⁆ = ⁅y, z⁆ * w := c4_commutator_central_comm hZ y z
  have hcx : ∀ w : G, w * ⁅x, z⁆ = ⁅x, z⁆ * w := c4_commutator_central_comm hZ x z
  have h1 : x * z * x⁻¹ = ⁅x, z⁆ * z := c4_mul_mul_inv_eq_commutator_mul x z
  have h2 : y * z * y⁻¹ = ⁅y, z⁆ * z := c4_mul_mul_inv_eq_commutator_mul y z
  rw [commutatorElement_def]
  rw [show x * y * z * (x * y)⁻¹ * z⁻¹ = x * (y * z * y⁻¹) * x⁻¹ * z⁻¹ by group]
  rw [h2]
  rw [show x * (⁅y, z⁆ * z) * x⁻¹ * z⁻¹ = (x * ⁅y, z⁆) * (z * x⁻¹) * z⁻¹ by group]
  rw [hcy x]
  rw [show (⁅y, z⁆ * x) * (z * x⁻¹) * z⁻¹ = ⁅y, z⁆ * (x * z * x⁻¹) * z⁻¹ by group]
  rw [h1]
  rw [show ⁅y, z⁆ * (⁅x, z⁆ * z) * z⁻¹ = ⁅y, z⁆ * ⁅x, z⁆ by group]
  rw [hcx ⁅y, z⁆]

/-- Class two: `[z, x * y] = [z, x] * [z, y]`. -/
private theorem c4_commutator_mul_right {G : Type*} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    ⁅z, x * y⁆ = ⁅z, x⁆ * ⁅z, y⁆ := by
  have h1 : ⁅z, x * y⁆ = ⁅x * y, z⁆⁻¹ := by rw [← commutatorElement_inv]
  rw [h1, c4_commutator_mul_left hZ x y z, mul_inv_rev, commutatorElement_inv,
    commutatorElement_inv]
  exact (c4_commutator_central_comm hZ z y ⁅z, x⁆).symm

/-- A central element commutes out of a commutator on the left. -/
private theorem c4_commutator_eq_one_of_mem_center_left {G : Type*} [Group G] {z : G}
    (hz : z ∈ Subgroup.center G) (x : G) : ⁅z, x⁆ = 1 := by
  rw [commutatorElement_def, ← Subgroup.mem_center_iff.mp hz x]
  group

/-- A central element commutes out of a commutator on the right. -/
private theorem c4_commutator_eq_one_of_mem_center_right {G : Type*} [Group G] {z : G}
    (hz : z ∈ Subgroup.center G) (x : G) : ⁅x, z⁆ = 1 := by
  rw [commutatorElement_def, Subgroup.mem_center_iff.mp hz x]
  group

/-- In a Suzuki 2-group with `[P,P] ≤ Ω₁(P)` every square is central (the class-two computation
`x ^ 2 * y = ⁅x, y⁆ ^ 2 * y * x ^ 2 = y * x ^ 2`). -/
private theorem c4_sq_mem_center_of_comm_le_omega1 (h : Work.Higman.IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.omega1 P) (x : P) :
    x ^ 2 ∈ Subgroup.center P := by
  rw [Subgroup.mem_center_iff]
  intro y
  have hxy : ⁅x, y⁆ ∈ Work.Higman.omega1 P :=
    hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))
  have hc : ⁅x, y⁆ ∈ Subgroup.center P := h.omega1_le_center hxy
  have hcc : ⁅x, y⁆ * ⁅x, y⁆ = 1 := by
    have h1 := h.mem_omega1.mp hxy
    rwa [pow_two] at h1
  have hcx : x * ⁅x, y⁆ = ⁅x, y⁆ * x := (Subgroup.mem_center_iff.mp hc) x
  have h1 : x * y = ⁅x, y⁆ * y * x := by
    have h2 := c4_mul_mul_inv_eq_commutator_mul x y
    rw [← h2]; group
  have hmain : x ^ 2 * y = y * x ^ 2 := by
    calc x ^ 2 * y = x * (x * y) := by rw [pow_two]; group
      _ = x * (⁅x, y⁆ * y * x) := by rw [h1]
      _ = (x * ⁅x, y⁆) * y * x := by group
      _ = (⁅x, y⁆ * x) * y * x := by rw [hcx]
      _ = ⁅x, y⁆ * (x * y) * x := by group
      _ = ⁅x, y⁆ * (⁅x, y⁆ * y * x) * x := by rw [h1]
      _ = (⁅x, y⁆ * ⁅x, y⁆) * y * (x * x) := by group
      _ = y * (x * x) := by rw [hcc]; group
      _ = y * x ^ 2 := by rw [pow_two]
  exact hmain.symm

/-! ## The Chevalley–Warning bound in the class-two case -/

/-- **Chevalley–Warning for the squaring map of a class-two Suzuki 2-group.**
If `Z(P) = Ω₁(P)`, `[P,P] ≤ Z(P)` and every square is central, then
`|P ⧸ Z(P)| ≤ |Z(P)|²`.  Indeed the squaring map `xZ ↦ x²` is an anisotropic quadratic map over
`𝔽₂` (anisotropic because `x² = 1` means `x ∈ Ω₁(P) = Z(P)`), with polar form the commutator
pairing, so Chevalley–Warning (`Work.Higman.card_le_sq_of_quadratic_anisotropic`) applies. -/
private theorem c4_card_quotient_le_sq (h : Work.Higman.IsSuzuki2Grp P)
    (hZ : Subgroup.center P = Work.Higman.omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ Subgroup.center P)
    (hcommZ : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P) :
    Nat.card (P ⧸ Subgroup.center P) ≤ Nat.card ↥(Subgroup.center P) ^ 2 := by
  classical
  have hZ2 : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P := hcommZ
  have hsq2 : ∀ g : P, g * g ∈ Subgroup.center P := fun g => by
    have h1 := hsq g
    rwa [pow_two] at h1
  have hqcomm : ∀ a b : P ⧸ Subgroup.center P, a * b = b * a := by
    intro a b
    refine Quotient.inductionOn a (fun x => ?_)
    refine Quotient.inductionOn b (fun y => ?_)
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have hmem : (x * y)⁻¹ * (y * x) = ⁅y⁻¹, x⁻¹⁆ := by
      rw [commutatorElement_def]; group
    rw [hmem]
    exact hZ2 (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _))
  letI : CommGroup (P ⧸ Subgroup.center P) :=
    { (inferInstance : Group (P ⧸ Subgroup.center P)) with mul_comm := hqcomm }
  letI : CommGroup ↥(Subgroup.center P) :=
    { (inferInstance : Group ↥(Subgroup.center P)) with
      mul_comm := fun a b => Subtype.ext ((Subgroup.mem_center_iff.mp b.2) (a : P)) }
  let mkc : P → Additive (P ⧸ Subgroup.center P) :=
    fun z => Additive.ofMul (QuotientGroup.mk z)
  have h2V : ∀ v : Additive (P ⧸ Subgroup.center P), (2 : ℕ) • v = 0 := by
    intro v
    refine Quotient.inductionOn v (fun x => ?_)
    change (2 : ℕ) • Additive.ofMul (QuotientGroup.mk x) = 0
    rw [← ofMul_pow, ofMul_eq_zero]
    have hxx : ((x * x : P) : P ⧸ Subgroup.center P) = 1 :=
      (QuotientGroup.eq_one_iff (N := Subgroup.center P) (x * x)).mpr (hsq2 x)
    simpa [pow_two] using hxx
  haveI hmodV : Module (ZMod 2) (Additive (P ⧸ Subgroup.center P)) :=
    AddCommGroup.zmodModule h2V
  have h2W : ∀ v : Additive ↥(Subgroup.center P), (2 : ℕ) • v = 0 := by
    intro v
    rw [← ofMul_toMul v, ← ofMul_pow]
    simp only [ofMul_eq_zero]
    apply Subtype.ext
    change ((v.toMul : ↥(Subgroup.center P)) : P) ^ 2 = 1
    have h1 : ((v.toMul : ↥(Subgroup.center P)) : P) ∈ Work.Higman.omega1 P := by
      rw [← hZ]; exact (v.toMul).2
    exact h.mem_omega1.mp h1
  haveI hmodW : Module (ZMod 2) (Additive ↥(Subgroup.center P)) :=
    AddCommGroup.zmodModule h2W
  let qf : P → ↥(Subgroup.center P) := fun g => ⟨g * g, by simpa [pow_two] using hsq g⟩
  have hqw : ∀ a b : P, a⁻¹ * b ∈ Subgroup.center P → qf a = qf b := by
    intro a b hab
    obtain ⟨z, hz, rfl⟩ : ∃ z ∈ Subgroup.center P, b = a * z := ⟨a⁻¹ * b, hab, by group⟩
    apply Subtype.ext
    show a * a = (a * z) * (a * z)
    have hzc : z * z = 1 := by
      have h1 : z ∈ Work.Higman.omega1 P := by rw [← hZ]; exact hz
      have h2 := h.mem_omega1.mp h1
      rwa [pow_two] at h2
    have hc : z * a = a * z := (Subgroup.mem_center_iff.mp hz a).symm
    calc a * a = a * a * (z * z) := by rw [hzc, mul_one]
      _ = a * (a * (z * z)) := by group
      _ = a * ((a * z) * z) := by group
      _ = a * ((z * a) * z) := by rw [hc]
      _ = (a * z) * (a * z) := by group
  have hqw' : ∀ a b : P, (QuotientGroup.leftRel (Subgroup.center P)) a b →
      Additive.ofMul (qf a) = Additive.ofMul (qf b) :=
    fun a b hab => congrArg Additive.ofMul (hqw a b (QuotientGroup.leftRel_apply.mp hab))
  let Q : Additive (P ⧸ Subgroup.center P) → Additive ↥(Subgroup.center P) :=
    fun v => Quotient.liftOn v.toMul (fun g => Additive.ofMul (qf g)) hqw'
  have Q_mk : ∀ g : P, Q (mkc g) = Additive.ofMul (qf g) :=
    fun g => congrArg Additive.ofMul
      (Quotient.liftOn_mk (s := QuotientGroup.leftRel (Subgroup.center P))
        (fun g => Additive.ofMul (qf g)) hqw' g)
  have Q_zero : Q 0 = 0 := by
    change Q (mkc 1) = 0
    rw [Q_mk, ofMul_eq_zero]
    apply Subtype.ext
    show (1 : P) * 1 = 1
    group
  have Q_aniso : ∀ v, Q v = 0 → v = 0 := by
    intro v
    refine Quotient.inductionOn v (fun g => ?_)
    intro hv
    have hv' : Q (mkc g) = 0 := hv
    rw [Q_mk, ofMul_eq_zero] at hv'
    have hg : g * g = 1 := congrArg Subtype.val hv'
    have hg2 : g ^ 2 = 1 := by rw [pow_two]; exact hg
    change mkc g = 0
    rw [ofMul_eq_zero, QuotientGroup.eq_one_iff, hZ]
    exact h.mem_omega1.mpr hg2
  let bZ : P → P → ↥(Subgroup.center P) :=
    fun x y => ⟨⁅y, x⁆, hcommZ (Subgroup.commutator_mem_commutator
      (Subgroup.mem_top y) (Subgroup.mem_top x))⟩
  have bZ_mul₁ : ∀ a b y : P, bZ (a * b) y = bZ a y * bZ b y := by
    intro a b y
    apply Subtype.ext
    show ⁅y, a * b⁆ = ⁅y, a⁆ * ⁅y, b⁆
    exact c4_commutator_mul_right hZ2 a b y
  have bZ_mul₂ : ∀ y a b : P, bZ y (a * b) = bZ y a * bZ y b := by
    intro y a b
    apply Subtype.ext
    show ⁅a * b, y⁆ = ⁅a, y⁆ * ⁅b, y⁆
    exact c4_commutator_mul_left hZ2 a b y
  have bZ_wd : ∀ a₁ b₁ a₂ b₂ : P,
      (QuotientGroup.leftRel (Subgroup.center P)) a₁ a₂ →
      (QuotientGroup.leftRel (Subgroup.center P)) b₁ b₂ → bZ a₁ b₁ = bZ a₂ b₂ := by
    intro a₁ b₁ a₂ b₂ ha hb
    obtain ⟨z, hz, rfl⟩ : ∃ z ∈ Subgroup.center P, a₂ = a₁ * z :=
      ⟨a₁⁻¹ * a₂, QuotientGroup.leftRel_apply.mp ha, by group⟩
    obtain ⟨w, hw, rfl⟩ : ∃ w ∈ Subgroup.center P, b₂ = b₁ * w :=
      ⟨b₁⁻¹ * b₂, QuotientGroup.leftRel_apply.mp hb, by group⟩
    apply Subtype.ext
    show ⁅b₁, a₁⁆ = ⁅b₁ * w, a₁ * z⁆
    rw [c4_commutator_mul_left hZ2 b₁ w (a₁ * z),
        c4_commutator_eq_one_of_mem_center_left hw (a₁ * z), mul_one,
        c4_commutator_mul_right hZ2 a₁ z b₁,
        c4_commutator_eq_one_of_mem_center_right hz b₁, mul_one]
  let bZq : Additive (P ⧸ Subgroup.center P) → Additive (P ⧸ Subgroup.center P) →
      Additive ↥(Subgroup.center P) :=
    fun v w => Additive.ofMul (Quotient.liftOn₂ v.toMul w.toMul bZ bZ_wd)
  have bZq_mk : ∀ x y : P, bZq (mkc x) (mkc y) = Additive.ofMul (bZ x y) :=
    fun x y => congrArg Additive.ofMul (Quotient.liftOn₂_mk bZ bZ_wd x y)
  have hsum : ∀ x y : P, mkc x + mkc y = mkc (x * y) := by
    intro x y
    show Additive.ofMul (QuotientGroup.mk x) + Additive.ofMul (QuotientGroup.mk y) =
      Additive.ofMul (QuotientGroup.mk (x * y))
    rw [← ofMul_mul, ← QuotientGroup.mk_mul]
  have bZq_zero₁ : ∀ w : Additive (P ⧸ Subgroup.center P), bZq 0 w = 0 := by
    intro w
    refine Quotient.inductionOn w (fun z => ?_)
    change bZq (mkc 1) (mkc z) = 0
    rw [bZq_mk 1 z, ofMul_eq_zero]
    apply Subtype.ext
    show ⁅z, 1⁆ = 1
    rw [commutatorElement_def]; group
  have bZq_zero₂ : ∀ w : Additive (P ⧸ Subgroup.center P), bZq w 0 = 0 := by
    intro w
    refine Quotient.inductionOn w (fun z => ?_)
    change bZq (mkc z) (mkc 1) = 0
    rw [bZq_mk z 1, ofMul_eq_zero]
    apply Subtype.ext
    show ⁅1, z⁆ = 1
    rw [commutatorElement_def]; group
  have bZq_add₁ : ∀ v₁ v₂ w : Additive (P ⧸ Subgroup.center P),
      bZq (v₁ + v₂) w = bZq v₁ w + bZq v₂ w := by
    intro v₁ v₂ w
    refine Quotient.inductionOn v₁ (fun x => ?_)
    refine Quotient.inductionOn v₂ (fun y => ?_)
    refine Quotient.inductionOn w (fun z => ?_)
    change bZq (mkc x + mkc y) (mkc z) = bZq (mkc x) (mkc z) + bZq (mkc y) (mkc z)
    rw [hsum x y, bZq_mk (x * y) z, bZq_mk x z, bZq_mk y z, ← ofMul_mul, ← bZ_mul₁ x y z]
  have bZq_add₂ : ∀ v w₁ w₂ : Additive (P ⧸ Subgroup.center P),
      bZq v (w₁ + w₂) = bZq v w₁ + bZq v w₂ := by
    intro v w₁ w₂
    refine Quotient.inductionOn v (fun z => ?_)
    refine Quotient.inductionOn w₁ (fun x => ?_)
    refine Quotient.inductionOn w₂ (fun y => ?_)
    change bZq (mkc z) (mkc x + mkc y) = bZq (mkc z) (mkc x) + bZq (mkc z) (mkc y)
    rw [hsum x y, bZq_mk z (x * y), bZq_mk z x, bZq_mk z y, ← ofMul_mul, ← bZ_mul₂ z x y]
  have bZq_smul₁ : ∀ (c : ZMod 2) (v w : Additive (P ⧸ Subgroup.center P)),
      bZq (c • v) w = c • bZq v w := by
    intro c v w
    let φ : Additive (P ⧸ Subgroup.center P) →+ Additive ↥(Subgroup.center P) :=
      { toFun := fun x => bZq x w
        map_zero' := bZq_zero₁ w
        map_add' := fun x y => bZq_add₁ x y w }
    exact ZMod.map_smul φ c v
  have bZq_smul₂ : ∀ (c : ZMod 2) (v w : Additive (P ⧸ Subgroup.center P)),
      bZq v (c • w) = c • bZq v w := by
    intro c v w
    let φ : Additive (P ⧸ Subgroup.center P) →+ Additive ↥(Subgroup.center P) :=
      { toFun := fun x => bZq v x
        map_zero' := bZq_zero₂ v
        map_add' := fun x y => bZq_add₂ v x y }
    exact ZMod.map_smul φ c w
  let b : Additive (P ⧸ Subgroup.center P) →ₗ[ZMod 2]
      Additive (P ⧸ Subgroup.center P) →ₗ[ZMod 2] Additive ↥(Subgroup.center P) :=
    LinearMap.mk₂ (ZMod 2) bZq bZq_add₁ bZq_smul₁ bZq_add₂ bZq_smul₂
  have hb : ∀ v w, Q (v + w) = Q v + Q w + b v w := by
    intro v w
    refine Quotient.inductionOn v (fun x => ?_)
    refine Quotient.inductionOn w (fun y => ?_)
    change Q (mkc x + mkc y) = Q (mkc x) + Q (mkc y) + bZq (mkc x) (mkc y)
    rw [hsum x y, Q_mk, Q_mk x, Q_mk y, bZq_mk x y, ← ofMul_mul, ← ofMul_mul]
    congr 1
    apply Subtype.ext
    show (x * y) * (x * y) = (x * x) * (y * y) * ⁅y, x⁆
    have hc : ⁅y, x⁆ ∈ Subgroup.center P := hcommZ (Subgroup.commutator_mem_commutator
      (Subgroup.mem_top y) (Subgroup.mem_top x))
    have h1 : ⁅y, x⁆ * x = x * ⁅y, x⁆ := (Subgroup.mem_center_iff.mp hc x).symm
    have h2 : ⁅y, x⁆ * y = y * ⁅y, x⁆ := (Subgroup.mem_center_iff.mp hc y).symm
    have hcyx : y * x = ⁅y, x⁆ * x * y := by rw [commutatorElement_def]; group
    calc (x * y) * (x * y) = x * (y * x) * y := by group
      _ = x * (⁅y, x⁆ * x * y) * y := by rw [hcyx]
      _ = (x * x) * (y * y) * ⁅y, x⁆ := by
            calc x * (⁅y, x⁆ * x * y) * y = x * (x * (⁅y, x⁆ * y)) * y := by
                  rw [h1]; group
              _ = x * (x * (y * ⁅y, x⁆)) * y := by rw [h2]
              _ = x * (x * y) * (⁅y, x⁆ * y) := by group
              _ = x * (x * y) * (y * ⁅y, x⁆) := by rw [h2]
              _ = (x * x) * (y * y) * ⁅y, x⁆ := by group
  exact card_le_sq_of_quadratic_anisotropic (V := Additive (P ⧸ Subgroup.center P))
    (W := Additive ↥(Subgroup.center P)) Q Q_zero b hb Q_aniso

/-- **The class-two case of Higman's Theorem 1.**  If `[P,P] ≤ Ω₁(P)` then
`|P| ≤ |Ω₁(P)|³`. -/
private theorem c4_card_le_of_comm_le_omega1 (h : Work.Higman.IsSuzuki2Grp P)
    (hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.omega1 P) :
    Nat.card P ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
  have hZ : Subgroup.center P = Work.Higman.omega1 P := Work.Higman.center_eq_omega1_new h
  have hcommZ : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P := hZ ▸ hcomm
  have hsq : ∀ x : P, x ^ 2 ∈ Subgroup.center P :=
    c4_sq_mem_center_of_comm_le_omega1 h hcomm
  have hb := c4_card_quotient_le_sq h hZ hsq hcommZ
  have hcard : Nat.card P =
      Nat.card (P ⧸ Subgroup.center P) * Nat.card ↥(Subgroup.center P) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  have hZcard : Nat.card ↥(Subgroup.center P) = Nat.card ↥(Work.Higman.omega1 P) := by rw [hZ]
  have hb' : Nat.card (P ⧸ Subgroup.center P) ≤ Nat.card ↥(Work.Higman.omega1 P) ^ 2 := by
    rw [← hZcard]; exact hb
  calc Nat.card P = Nat.card (P ⧸ Subgroup.center P) * Nat.card ↥(Work.Higman.omega1 P) := by
        rw [hcard, hZcard]
    _ ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 * Nat.card ↥(Work.Higman.omega1 P) :=
        Nat.mul_le_mul_right _ hb'
    _ = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by ring

/-! ## The `C₄` case -/

/-- The `ξ`-invariant subgroups of the maximal `ξ`-invariant abelian normal subgroup `A` in the
`C₄` setting (`A² = Ω₁(P)`, `A⁴ = ⊥`) are `⊥`, `A²` and `A` (Higman's Lemma 1 dichotomy). -/
private theorem c4_xi_inv_sub_trichotomy (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    {B : Subgroup P} (hBA : B ≤ A) (hBin : B.map (h.xi : MulAut P).toMonoidHom = B) :
    B = ⊥ ∨ B = Work.Higman.powSub A 2 ∨ B = A := by
  obtain ⟨e, -, -, -, hsub⟩ := Work.Higman.homogeneous_structure h hA.abelian hA.map_eq
  obtain ⟨i, hi⟩ := hsub B hBA hBin
  rcases Nat.eq_zero_or_pos i with h0 | hpos
  · exact Or.inr (Or.inr (by rw [hi, h0, pow_zero, Work.Higman.powSub_one_eq]))
  · rcases Nat.lt_or_ge i 2 with hlt | hge
    · have hi1 : i = 1 := by omega
      exact Or.inr (Or.inl (by rw [hi, hi1]; norm_num))
    · refine Or.inl ?_
      have hdvd : 4 ∣ 2 ^ i := ⟨2 ^ (i - 2), by
        rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_add]
        congr 1
        omega⟩
      have hle : Work.Higman.powSub A (2 ^ i) ≤ Work.Higman.powSub A 4 :=
        Work.Higman.powSub_le_of_dvd hA.abelian hdvd
      rw [hi]
      exact le_bot_iff.mp (hA4 ▸ hle)

/-- **The `C₄` data.**  If `[P,P] ≰ Ω₁(P)` then the maximal `ξ`-invariant abelian normal subgroup
`A` of Higman's Lemma 9 satisfies all the hypotheses of the `C₄` exclusion: it is maximal
`ξ`-invariant abelian normal, `Ω₁(P) ≤ A`, `[P,P] = A`, every square lies in `A`, `A⁴ = ⊥`,
`A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`. -/
private theorem c4_data (h : Work.Higman.IsSuzuki2Grp P)
    (hcomm : ¬(⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.omega1 P)) :
    ∃ A : Subgroup P, Work.Higman.IsXiAbelNormal h A ∧
      (∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A) ∧
      Work.Higman.omega1 P ≤ A ∧ ⁅(⊤ : Subgroup P), ⊤⁆ = A ∧
      (∀ x : P, x ^ 2 ∈ A) ∧ Work.Higman.powSub A 4 = ⊥ ∧
      Work.Higman.powSub A 2 = Work.Higman.omega1 P ∧
      Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
  classical
  obtain ⟨A, hAn, hAxi, hAab, hAmax, hNA, hDA, hsq, hA4⟩ := Work.Higman.lemma9_maximal_abelian h
  have hA : Work.Higman.IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  have hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A :=
    fun B hB hAB => hAmax B hB.1 hB.2.1 hB.2.2 hAB
  obtain ⟨e, hexp, hcard, htop, hsub⟩ := Work.Higman.homogeneous_structure h hAab hAxi
  have hAinf : A ⊓ Work.Higman.omega1 P = Work.Higman.omega1 P := inf_eq_right.mpr hNA
  have hq4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
  have hq1 : 1 < Nat.card ↥(Work.Higman.omega1 P) := by omega
  have hpow : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ e := by
    have h0 := hcard 0 (Nat.zero_le e)
    rw [pow_zero, Work.Higman.powSub_one_eq, hAinf] at h0
    exact h0
  have hexp4 : ∀ a ∈ A, a ^ 4 = 1 := by
    intro a ha
    have hmem : a ^ 4 ∈ Work.Higman.powSub A 4 := Work.Higman.pow_mem_powSub (n := 4) ha
    rw [hA4] at hmem
    simpa using hmem
  have hAle : Nat.card ↥A ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 :=
    Work.Higman.card_le_card_omega1_sq_of_exp h hA hNA hexp4
  have he2 : e = 2 := by
    have hepos : e ≠ 0 := by
      intro h0
      rw [hpow, h0, pow_zero] at hAle
      have : Nat.card ↥A = 1 := by rw [hpow, h0, pow_zero]
      have h1 : Nat.card ↥(Work.Higman.omega1 P) ≤ Nat.card ↥A := Subgroup.card_le_of_le hNA
      omega
    have he_le : e ≤ 2 := by
      rw [hpow] at hAle
      exact (Nat.pow_le_pow_iff_right hq1).mp hAle
    have he_ne_one : e ≠ 1 := by
      intro h1
      have hAcard : Nat.card ↥A = Nat.card ↥(Work.Higman.omega1 P) := by
        rw [hpow, h1, pow_one]
      have hAeq : A = Work.Higman.omega1 P :=
        (Subgroup.eq_of_le_of_card_ge hNA hAcard.le).symm
      exact hcomm (hAeq ▸ hDA)
    omega
  have htop2 : Work.Higman.powSub A 2 = Work.Higman.omega1 P := by
    have h := htop
    rw [he2, show (2 : ℕ) ^ (2 - 1) = 2 by norm_num, hAinf] at h
    exact h
  have hAcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
    rw [hpow, he2]
  -- `[P,P]` is `ξ`-invariant and normal, hence a power subgroup of `A`
  have hDAxi : ((⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P)).map (h.xi : MulAut P).toMonoidHom
      = (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) := by
    have h1 : (⊤ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⊤ :=
      Subgroup.map_top_of_surjective (h.xi : MulAut P).toMonoidHom
        (MulEquiv.surjective h.xi)
    rw [Subgroup.map_commutator, h1]
  obtain ⟨i, hi⟩ := hsub (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) hDA hDAxi
  have hDAeq : ⁅(⊤ : Subgroup P), ⊤⁆ = A := by
    have hbot : (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P) ≠ ⊥ := by
      intro hb
      obtain ⟨x, y, hxy⟩ := h.noncomm
      have h1 : ⁅x, y⁆ ∈ ⁅(⊤ : Subgroup P), ⊤⁆ :=
        Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
      rw [hb] at h1
      exact hxy (commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1))
    rcases Nat.eq_zero_or_pos i with h0 | hpos
    · rw [hi, h0, pow_zero, Work.Higman.powSub_one_eq]
    · rcases Nat.lt_or_ge i 2 with hlt | hge
      · have hi1 : i = 1 := by omega
        exfalso
        refine hcomm ?_
        rw [hi, hi1, show (2 : ℕ) ^ 1 = 2 by norm_num]
        exact le_of_eq htop2
      · have hdvd : 4 ∣ 2 ^ i := ⟨2 ^ (i - 2), by
          rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_add]
          congr 1
          omega⟩
        have hle : Work.Higman.powSub A (2 ^ i) ≤ Work.Higman.powSub A 4 :=
          Work.Higman.powSub_le_of_dvd hAab hdvd
        have hbot_le : Work.Higman.powSub A (2 ^ i) ≤ ⊥ := hA4 ▸ hle
        exfalso
        rw [← hi] at hbot_le
        exact hbot (le_bot_iff.mp hbot_le)
  exact ⟨A, hA, hmax, hNA, hDAeq, hsq, hA4, htop2, hAcard⟩

/-! ## The residual case `C' = C² = A²` of the `C₄` exclusion

Let `A ≤ C ≤ P` be as in `c4_exclusion_alt`, with `C` a minimal `ξ`-invariant normal cover of `A`
and `⁅C,C⁆ = C² = A²`.  The two dichotomies below cut this configuration down to two cases:

* `⁅C,A⁆ = ⊥`: `A` centralises `C` (the Gorenstein–Thompson case, `c4_gap_central_false`);
* `⁅C,A⁆ = A²`: then `C_P(A) = A`, and `⁅C,⊤⁆ ∈ {A², A}`; the case `⁅C,⊤⁆ = A²` is settled
  (clean, importable: `C4Cover.c4_branch_CP_A2`), so only

  `⁅C,A⁆ = A²` and `⁅C,⊤⁆ = A`

  remains (Higman's `ξ`-length-3 subgroup `C` of a `ξ`-length-4 group; `c4_gap_hard_false`).
-/

/-- `A ≠ A ^ (2)` in the `C₄` setting (from `|A| = |Ω₁(P)|²`, `A² = Ω₁(P)`, `|Ω₁(P)| ≥ 4`). -/
private theorem c4_A_ne_powSub_two (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    A ≠ Work.Higman.powSub A 2 := by
  intro heq
  have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
    congrArg (fun X : Subgroup P => Nat.card ↥X) heq
  rw [htop] at h1
  have h2 : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
    rw [← hcard, h1]
  have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
  have h4 := h.omega1_card_ge_four
  nlinarith [h2, h4]

/-- `A ^ (2) ≠ ⊥` in the `C₄` setting. -/
private theorem c4_powSub_two_ne_bot (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    Work.Higman.powSub A 2 ≠ ⊥ := by
  intro hb
  have hc : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
  have h4 := h.omega1_card_ge_four
  omega

/-- **First dichotomy of the gap case.**  If `C` is a minimal `ξ`-invariant normal cover of `A`
with `⁅C,C⁆ = A²`, then `⁅C,A⁆ ≤ ⁅C,C⁆ = A²` is `ξ`-invariant and normal, so `⁅C,A⁆` is `⊥` or
`A²`. -/
private theorem c4_gap_comm_C_A_dichotomy (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hAC : A ≤ C)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) :
    ⁅C, A⁆ = ⊥ ∨ ⁅C, A⁆ = Work.Higman.powSub A 2 := by
  have hCA_le : (⁅C, A⁆ : Subgroup P) ≤ Work.Higman.powSub A 2 := by
    calc ⁅C, A⁆ ≤ ⁅C, C⁆ := Subgroup.commutator_mono le_rfl hAC
      _ = Work.Higman.powSub A 2 := hCd
  have hCA_inv : (⁅C, A⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅C, A⁆ := by
    rw [Subgroup.map_commutator, hCinv, hA.map_eq]
  have hBA : (⁅C, A⁆ : Subgroup P) ≤ A := hCA_le.trans (Work.Higman.powSub_le (by norm_num))
  rcases c4_xi_inv_sub_trichotomy h hA htop hA4 hBA hCA_inv with hb | h2 | h3
  · exact Or.inl hb
  · exact Or.inr h2
  · exfalso
    have hAle : A ≤ Work.Higman.powSub A 2 := by
      have hh := hCA_le
      rwa [h3] at hh
    exact c4_A_ne_powSub_two (A := A) h htop hcard
      (le_antisymm hAle (Work.Higman.powSub_le (A := A) (n := 2) (by norm_num)))

/-- **Second dichotomy of the gap case.**  `⁅C,⊤⁆ ≤ ⁅⊤,⊤⁆ = A` is `ξ`-invariant and normal and
contains `⁅C,C⁆ = A²`, so it is `A²` or `A`. -/
private theorem c4_gap_comm_C_top_dichotomy (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) :
    ⁅C, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2 ∨
      ⁅C, (⊤ : Subgroup P)⁆ = A := by
  have hle : (⁅C, (⊤ : Subgroup P)⁆ : Subgroup P) ≤ A := by
    calc ⁅C, (⊤ : Subgroup P)⁆ ≤ ⁅(⊤ : Subgroup P), ⊤⁆ :=
          Subgroup.commutator_mono le_top le_rfl
      _ = A := hGs
  have hinv : (⁅C, (⊤ : Subgroup P)⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom
      = ⁅C, (⊤ : Subgroup P)⁆ := by
    rw [Subgroup.map_commutator, hCinv,
      Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective]
  rcases c4_xi_inv_sub_trichotomy h hA htop hA4 hle hinv with hb | h2 | h3
  · exfalso
    have hb2 : (⁅C, C⁆ : Subgroup P) ≤ (⊥ : Subgroup P) :=
      (Subgroup.commutator_mono le_rfl le_top).trans (le_of_eq hb)
    rw [hCd] at hb2
    exact c4_powSub_two_ne_bot h htop (le_bot_iff.mp hb2)
  · exact Or.inl h2
  · exact Or.inr h3

/-- **The Gorenstein–Thompson case of the gap.**  If `A` centralises the minimal cover `C`
(`⁅C,A⁆ = ⊥`), `C² ≤ A` and `⁅C,C⁆ = A²`, then we have a contradiction: the fourth-power map
`C/A → A²` is a homomorphism onto a `ξ`-irreducible module, and the `ξ`-equivariant alternating
commutator pairing `C/A × C/A → A²` has to be trivial (Gorenstein–Thompson), against
`⁅C,C⁆ = A² ≠ ⊥`.

(This is the content of `Work.Higman.H8.alt_pairing_false`, re-derived here so that the
dependency chain avoids the currently unbuildable module `Work.Higman.no_square_maximal`.) -/
private theorem c4_gap_central_false (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hZ : ∀ c ∈ C, ∀ a ∈ A, c * a = a * c) : False :=
  Work.Higman.H8.c4_gap_central h hA hNA hGs hsq hA4 htop hCn hCinv hAC hCA hcover hC2 hCd hZ

/-! ### The first branch of the gap: the shift identity `(a·y)² = y²` cannot hold everywhere

In the gap `⁅C,C⁆ = C² = A²` the subgroup `C` has class two (`⁅C,C⁆ = A² ⊆ Z(P)`), so for
`a ∈ A` and `y ∈ C` the squaring map satisfies the exact identity
`(a·y)² = a²·⁅y,a⁆·y²`.  The lemma below shows that the "shift trivial" alternative
`(a·y)² = y²` for **all** `y ∈ C∖A`, `a ∈ A` is contradictory.  Hence in the residual one may
assume that for some `y ∈ C∖A` and `a ∈ A` the *deviation* `a²·⁅y,a⁆` is non-trivial — the precise
residual recorded in `H8/NOTES_c4_gap_session10.md`. -/

/-- **The shift identity cannot hold everywhere in the gap.**
`A` as in `c4_data`, `C` a minimal `ξ`-invariant normal cover with `⁅C,C⁆ = C² = A²` and
`|C| = q³`; then it is impossible that `(a·y)² = y²` for all `y ∈ C∖A` and all `a ∈ A`. -/
private theorem c4_gap_shift_false (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hb : ∀ y ∈ C, y ∉ A → ∀ a ∈ A, (a * y) ^ 2 = y ^ 2) : False := by
  classical
  have hq4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
  have hCcard : Nat.card ↥C = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 :=
    Work.Higman.C4Cover.c4_cover_card_eq_cube h hA.abelian hNA hGs hsq htop hcard hCn hCinv hAC
      hCA hcover hCd
  -- `A ≠ A²` because `|A| = q²`, `|A²| = q` and `q ≥ 4`.
  have hA_ne_A2 : A ≠ Work.Higman.powSub A 2 := by
    intro heq
    have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
      congrArg (fun S : Subgroup P => Nat.card ↥S) heq
    rw [hcard, htop] at h1
    nlinarith [h1, hq4]
  -- the exact class-two identity `(a*y)^2 = a^2 * [y,a] * y^2`
  have hident : ∀ a ∈ A, ∀ y ∈ C, (a * y) ^ 2 = a ^ 2 * ⁅y, a⁆ * y ^ 2 := by
    intro a ha y hy
    have hcomm : ⁅y, a⁆ ∈ Subgroup.center P := by
      have hmem : ⁅y, a⁆ ∈ Work.Higman.powSub A 2 := by
        rw [← hCAd]
        exact Subgroup.commutator_mem_commutator hy ha
      exact h.omega1_le_center (by rw [← htop]; exact hmem)
    have hca : ⁅y, a⁆ * a = a * ⁅y, a⁆ := ((Subgroup.mem_center_iff.mp hcomm) a).symm
    have h1 : y * a = ⁅y, a⁆ * (a * y) := by
      rw [commutatorElement_def]; group
    have key : a * ⁅y, a⁆ * a = a * a * ⁅y, a⁆ := by
      rw [mul_assoc, hca, ← mul_assoc]
    calc (a * y) ^ 2 = a * (y * a) * y := by rw [pow_two]; group
      _ = a * (⁅y, a⁆ * (a * y)) * y := by rw [h1]
      _ = (a * ⁅y, a⁆ * a) * y * y := by group
      _ = (a * a * ⁅y, a⁆) * y * y := by rw [key]
      _ = a ^ 2 * ⁅y, a⁆ * y ^ 2 := by rw [pow_two, pow_two]; group
  -- consequence of the shift identity: `[y,a] = a²`
  have hkey : ∀ y ∈ C, y ∉ A → ∀ a ∈ A, ⁅y, a⁆ = a ^ 2 := by
    intro y hy hyA a ha
    have h1 : (a * y) ^ 2 = y ^ 2 := hb y hy hyA a ha
    rw [hident a ha y hy] at h1
    have h2 : a ^ 2 * ⁅y, a⁆ = 1 := by
      have := congrArg (fun z : P => z * (y ^ 2)⁻¹) h1
      simpa [mul_assoc] using this
    have h3 : (a ^ 2)⁻¹ = a ^ 2 := by
      refine inv_eq_of_mul_eq_one_right ?_
      have ha2 : a ^ 2 ∈ Work.Higman.omega1 P := by
        rw [← htop]; exact Work.Higman.pow_mem_powSub ha
      have h5 := h.mem_omega1.mp ha2
      rwa [pow_two] at h5
    calc ⁅y, a⁆ = 1 * ⁅y, a⁆ := (one_mul _).symm
      _ = (a ^ 2)⁻¹ * a ^ 2 * ⁅y, a⁆ := by rw [inv_mul_cancel, one_mul]
      _ = (a ^ 2)⁻¹ * (a ^ 2 * ⁅y, a⁆) := by group
      _ = (a ^ 2)⁻¹ * 1 := by rw [h2]
      _ = a ^ 2 := by rw [mul_one, h3]
  -- `C ∖ A` is non-empty
  obtain ⟨y, hyC, hyA⟩ : ∃ y ∈ C, y ∉ A := by
    by_contra hcon
    push_neg at hcon
    exact hCA (le_antisymm (fun x hx => hcon x hx) hAC).symm
  -- there are `y₁, y₂ ∈ C∖A` with `y₁*y₂ ∉ A`: otherwise `z ↦ y*z` injects `C∖A` into `A`,
  -- so `|C| - |A| ≤ |A|`, i.e. `q³ - q² ≤ q²`, contradicting `q ≥ 4`.
  have hex : ∃ y₁ ∈ C, y₁ ∉ A ∧ ∃ y₂ ∈ C, y₂ ∉ A ∧ y₁ * y₂ ∉ A := by
    by_contra hcon
    push_neg at hcon
    have hinj : Set.InjOn (fun z : P => y * z) {z : P | z ∈ C ∧ z ∉ A} := by
      intro z₁ _ z₂ _ hz
      exact mul_left_cancel hz
    have hle : Set.ncard {z : P | z ∈ C ∧ z ∉ A} ≤ Nat.card ↥A := by
      have h1 : Set.ncard {z : P | z ∈ C ∧ z ∉ A} ≤ Set.ncard (A : Set P) :=
        Set.ncard_le_ncard_of_injOn (fun z : P => y * z)
          (fun z hz => hcon y hyC hyA z hz.1 hz.2) hinj
      have h2 : Nat.card ↥A = Set.ncard (A : Set P) := Nat.card_coe_set_eq (A : Set P)
      omega
    have hdisj : Disjoint (A : Set P) {z : P | z ∈ C ∧ z ∉ A} := by
      rw [Set.disjoint_left]
      rintro z hz ⟨-, hzA⟩
      exact hzA hz
    have hunion : (A : Set P) ∪ {z : P | z ∈ C ∧ z ∉ A} = (C : Set P) := by
      ext z
      constructor
      · rintro (hz | ⟨hz, -⟩)
        · exact hAC hz
        · exact hz
      · intro hz
        by_cases hzA : z ∈ A
        · exact Or.inl hzA
        · exact Or.inr ⟨hz, hzA⟩
    have hsum : Nat.card ↥A + Set.ncard {z : P | z ∈ C ∧ z ∉ A} = Nat.card ↥C := by
      have h1 : Set.ncard (A : Set P) + Set.ncard {z : P | z ∈ C ∧ z ∉ A}
          = Set.ncard (C : Set P) := by
        rw [← hunion]
        exact (Set.ncard_union_eq hdisj).symm
      have h2 : Nat.card ↥A = Set.ncard (A : Set P) := Nat.card_coe_set_eq (A : Set P)
      have h3 : Nat.card ↥C = Set.ncard (C : Set P) := Nat.card_coe_set_eq (C : Set P)
      omega
    rw [hCcard, hcard] at hsum
    nlinarith [hsum, hle, hq4]
  obtain ⟨y₁, hy₁C, hy₁A, y₂, hy₂C, hy₂A, hy₁y₂A⟩ := hex
  -- final contradiction: `a² = [y₁y₂,a] = [y₁,a][y₂,a] = a²·a² = 1` for every `a ∈ A`
  have hfin : ∀ a ∈ A, a ^ 2 = 1 := by
    intro a ha
    have hc₁ : ⁅y₁, a⁆ ∈ Subgroup.center P := by
      have hmem : ⁅y₁, a⁆ ∈ Work.Higman.powSub A 2 := by
        rw [← hCAd]
        exact Subgroup.commutator_mem_commutator hy₁C ha
      exact h.omega1_le_center (by rw [← htop]; exact hmem)
    have hc₂ : ⁅y₂, a⁆ ∈ Subgroup.center P := by
      have hmem : ⁅y₂, a⁆ ∈ Work.Higman.powSub A 2 := by
        rw [← hCAd]
        exact Subgroup.commutator_mem_commutator hy₂C ha
      exact h.omega1_le_center (by rw [← htop]; exact hmem)
    have e1 : ⁅y₁, a⁆ = a ^ 2 := hkey y₁ hy₁C hy₁A a ha
    have e2 : ⁅y₂, a⁆ = a ^ 2 := hkey y₂ hy₂C hy₂A a ha
    have e3 : ⁅y₁ * y₂, a⁆ = a ^ 2 :=
      hkey (y₁ * y₂) (C.mul_mem hy₁C hy₂C) hy₁y₂A a ha
    have hmul : ⁅y₁ * y₂, a⁆ = ⁅y₁, a⁆ * ⁅y₂, a⁆ := by
      rw [commutatorElement_mul_left_eq_conj_mul]
      have hconj : y₁ * ⁅y₂, a⁆ * y₁⁻¹ = ⁅y₂, a⁆ := by
        rw [show y₁ * ⁅y₂, a⁆ * y₁⁻¹ = ⁅y₂, a⁆ * (y₁ * y₁⁻¹) by
          rw [(Subgroup.mem_center_iff.mp hc₂) y₁]; group]
        group
      rw [hconj]
      exact (Subgroup.mem_center_iff.mp hc₁) ⁅y₂, a⁆
    have h4 : a ^ 2 * a ^ 2 = 1 := by
      have ha2 : a ^ 2 ∈ Work.Higman.omega1 P := by
        rw [← htop]; exact Work.Higman.pow_mem_powSub ha
      have h5 := h.mem_omega1.mp ha2
      rwa [pow_two] at h5
    rw [hmul, e1, e2] at e3
    rw [e3] at h4
    exact h4
  -- hence `A ≤ Ω₁(P) = A²`, so `A = A²`, contradiction
  have hAle : A ≤ Work.Higman.powSub A 2 := by
    rw [htop]
    intro a ha
    exact h.mem_omega1.mpr (hfin a ha)
  exact hA_ne_A2 (le_antisymm hAle (Work.Higman.powSub_le (by norm_num : 0 < 2)))

/-- **The residual case of the gap.**  `⁅C,C⁆ = C² = A²`, `⁅C,A⁆ = A²` and `⁅C,⊤⁆ = A`: `C` is a
`ξ`-length-`3` subgroup (of type `B(n,1,ε)` or `C(n,φ)`) of a `ξ`-length-`4` group, i.e. exactly
the configuration excluded by Higman's Lemma 13 *("there is no Suzuki 2-group of `ξ`-length
greater than `3`")*: `P = C·D` where `D` is a second minimal cover with `C ∩ D = A`, `C/A` and
`D/A` are two `ξ`-irreducible constituents of `P/A`, and the commutator pairing pairs them
perfectly with `A/A²`.  The exclusion needs the eigenvalue bookkeeping (`Q3.axis_resonance`). -/
private theorem c4_gap_hard_false (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hCP : ⁅C, (⊤ : Subgroup P)⁆ = A) : False := by
  by_cases hb : ∀ y ∈ C, y ∉ A → ∀ a ∈ A, (a * y) ^ 2 = y ^ 2
  · exact c4_gap_shift_false h hA hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA hcover hC2 hCd
      hCAd hb
  · -- **Residual (case (a)).**  There are `y ∈ C∖A` and `a ∈ A` with `(a·y)² ≠ y²`, i.e. the
    -- homomorphism `ψ_y : A/A² → A²`, `ā ↦ a²·⁅y,a⁆` is non-trivial.  This is exactly the
    -- configuration of `H8/NOTES_c4_gap_session10.md` §4 (R): the remaining obstruction is the
    -- Hall–Witt/Jacobi identity for the perfect pairing `Φ̄ : A/A² × P/A → A²`,
    -- `Φ̄(ā,x̄) = ⁅a,x⁆`, which rules out the final case exactly as in Higman's Lemma 13.
    push_neg at hb
    sorry

/-- **The gap case `C' = C² = A²` of the `C₄` exclusion.**  With `C` a minimal `ξ`-invariant
normal cover of `A` and `⁅C,C⁆ = C² = A²`, the two dichotomies reduce to the central case
(`c4_gap_central_false`) or, after computing `C_P(A) = A`, to `⁅C,⊤⁆ ∈ {A², A}`: the first is
impossible by `C4Cover.c4_branch_CP_A2` and the second is the residual case `c4_gap_hard_false`. -/
private theorem c4_gap_false (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2_le : Work.Higman.powSub C 2 ≤ A)
    (hC2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) : False := by
  haveI : A.Normal := hA.normal
  have hCA_le : ⁅C, A⁆ ≤ Work.Higman.powSub A 2 := by
    calc ⁅C, A⁆ ≤ ⁅C, C⁆ := Subgroup.commutator_mono le_rfl hAC
      _ = Work.Higman.powSub A 2 := hCd
  rcases c4_gap_comm_C_A_dichotomy h hA htop hA4 hcard hAC hCinv hCd with hb | hmid
  · exact c4_gap_central_false h hA hNA hGs hsq hA4 htop hCn hCinv hAC hCA hcover hC2_le hCd
      (fun c hc a ha => by
        have h1 : (⁅c, a⁆ : P) ∈ (⊥ : Subgroup P) := by
          rw [← hb]
          exact Subgroup.commutator_mem_commutator hc ha
        exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1))
  · have hcent : Subgroup.centralizer (A : Set P) = A :=
      Work.Higman.HS.centralizer_eq_A_of_comm_C_A h hA.map_eq hA.abelian hNA hGs hsq hA4 htop
        hcard hCn hCinv hAC hcover hmid
    rcases c4_gap_comm_C_top_dichotomy h hA htop hA4 hGs hCinv hCd with hcp | hcp
    · exact Work.Higman.C4Cover.c4_branch_CP_A2 h hA.normal hA.abelian hGs hsq hA4 htop hcard
        hcent hCn hCinv hAC hCA hcp
    · exact c4_gap_hard_false h hA hmax hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA hcover
        hC2 hCd hmid hcent hcp

/-- **The `C₄` exclusion (Higman's Theorem 1).**  The `C₄` shape of Higman's Lemma 8 is
impossible: there is no maximal `ξ`-invariant abelian normal subgroup `A` with `Ω₁(P) ≤ A`,
`[P,P] = A`, all squares in `A`, `A⁴ = ⊥`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`.

Case analysis on a minimal `ξ`-invariant normal cover `C > A`: `C' = ⊥` contradicts maximality;
`C' = A` contradicts Higman's Lemma 8 (`exp A ≤ 2`); for `C' = A²`: `C² = ⊥` gives `C ≤ Ω₁(P)`,
`C² = A` contradicts Higman's Lemma 7, and the remaining case `C² = A²` is
`c4_cover_deriv_sq_false`. -/
-- Renamed `c4_exclusion` -> `c4_exclusion_alt` (area owner, 2026-10-06): this file
-- declared a second `Work.Higman.c4_exclusion`, clashing with the dedicated
-- `Submission/Work/Higman/H8/c4_exclusion.lean` whenever both were imported (e.g. by the
-- deliverable's `Main.lean`).  Nothing outside this file used the copy.
private theorem c4_exclusion_alt {A : Subgroup P} (h : Work.Higman.IsSuzuki2Grp P)
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) : False := by
  classical
  -- a minimal `ξ`-invariant normal cover of `A`
  have hA_ne_top : (⊤ : Subgroup P) ≠ A := by
    intro htopA
    obtain ⟨x, y, hxy⟩ := h.noncomm
    have hx : x ∈ A := htopA ▸ Subgroup.mem_top x
    have hy : y ∈ A := htopA ▸ Subgroup.mem_top y
    exact hxy (hA.abelian x hx y hy)
  obtain ⟨C, hCn, hCinv, hAC, -, hCA, hcover⟩ :=
    Work.Higman.MSA.exists_minimal_covering h (A := A) (M := ⊤) Subgroup.normal_top
      (by rw [Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective]) le_top hA_ne_top
  have hCd_le : ⁅C, C⁆ ≤ A := (Subgroup.commutator_mono le_top le_top).trans (le_of_eq hGs)
  have hCd_inv : (⁅C, C⁆).map (h.xi : MulAut P).toMonoidHom = ⁅C, C⁆ := by
    rw [Subgroup.map_commutator, hCinv]
  have hC2_le : Work.Higman.powSub C 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  have hC2_inv : (Work.Higman.powSub C 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub C 2 := by
    rw [Work.Higman.map_powSub (h.xi : MulAut P) hCinv 2]
  rcases c4_xi_inv_sub_trichotomy h hA htop hA4 hCd_le hCd_inv with hbot | hA2 | hAeq
  · -- `C' = ⊥`: `C` is abelian, contradicting maximality of `A`
    have hCcomm : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x := by
      intro x hx y hy
      have hmem : ⁅x, y⁆ ∈ (⁅C, C⁆ : Subgroup P) :=
        Subgroup.commutator_mem_commutator hx hy
      have h1 : ⁅x, y⁆ = 1 := by
        have h2 : ⁅x, y⁆ ∈ (⊥ : Subgroup P) := by rw [← hbot]; exact hmem
        exact Subgroup.mem_bot.mp h2
      exact (commutatorElement_eq_one_iff_commute.mp h1).eq
    exact hCA (hmax C ⟨hCn, hCinv, hCcomm⟩ hAC)
  · -- `C' = A²`: further case analysis on `C²`
    rcases c4_xi_inv_sub_trichotomy h hA htop hA4 hC2_le hC2_inv with hC2bot | hC2A2 | hC2A
    · -- `C² = ⊥`: `C ≤ Ω₁(P) ≤ A`, contradicting `A < C`
      have hCle : C ≤ Work.Higman.omega1 P := by
        intro x hx
        refine h.mem_omega1.mpr ?_
        have hmem : x ^ 2 ∈ Work.Higman.powSub C 2 := Work.Higman.pow_mem_powSub hx
        rw [hC2bot] at hmem
        have h1 : x ^ 2 = 1 := Subgroup.mem_bot.mp hmem
        rw [← h1, pow_two]
      exact hCA (le_antisymm (hCle.trans hNA) hAC)
    · -- `C² = A²`: the residual case of the `C₄` exclusion
      exact c4_gap_false h hA hmax hNA hGs hsq hA4 htop hcard hCn hCinv hAC (Ne.symm hCA)
        hcover hC2_le hC2A2 hA2
    · -- `C² = A`: Higman's Lemma 7 makes `C` abelian, contradicting maximality of `A`
      have hPhi : Work.Higman.powSub C 2 ⊔ ⁅C, C⁆ = A := by
        rw [hC2A, hA2]
        exact sup_of_le_left (Work.Higman.powSub_le (by norm_num))
      have hCcomm : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x :=
        Work.Higman.higman9_case_deriv_le_sq h hA hCn hCinv hAC (Ne.symm hCA) hcover hPhi
          (by rw [hA2, htop])
      exact hCA (hmax C ⟨hCn, hCinv, hCcomm⟩ hAC)
  · -- `C' = A`: Higman's Lemma 8 gives `exp A ≤ 2`, so `A ≤ Ω₁(P) = A²`
    have hsq' : ∀ a ∈ A, a * a = 1 :=
      Work.Higman.higman_lemma8 h hA hCn hCinv hAC (Ne.symm hCA) hcover hC2_le hAeq
    have hAle : A ≤ Work.Higman.powSub A 2 := by
      rw [htop]
      intro a ha
      exact h.mem_omega1.mpr (by rw [pow_two]; exact hsq' a ha)
    have hAeq2 : A = Work.Higman.powSub A 2 :=
      le_antisymm hAle (Work.Higman.powSub_le (by norm_num))
    have hc : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
      congrArg (fun X : Subgroup P => Nat.card ↥X) hAeq2
    rw [hcard, htop] at hc
    have hq4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
    have hmul : Nat.card ↥(Work.Higman.omega1 P) * (Nat.card ↥(Work.Higman.omega1 P) - 1) = 0 := by
      rw [Nat.mul_sub_left_distrib, mul_one, ← pow_two, hc, Nat.sub_self]
    rcases Nat.mul_eq_zero.mp hmul with h1 | h1
    · omega
    · omega

/-! ## The odd-order-power reduction (Higman §2)

The `C₄` gap case is attacked with an automorphism of *odd* order which is still transitive on
the involutions: the kernel of its action on `Ω₁(P)` is then an odd-order group, which makes the
`higman_lemma2` obstruction applicable.  This section supplies the reduction. -/

/-- **Arithmetic.**  If `n` is odd then for every `a` and `j` there is `t` with
`2 ^ a ∣ j + t * n`: the odd number `n` runs through all residue classes modulo `2 ^ a`. -/
private theorem exists_pow_two_dvd_add_mul {n : ℕ} (hn : Odd n) (a j : ℕ) :
    ∃ t : ℕ, 2 ^ a ∣ j + t * n := by
  induction a generalizing j with
  | zero => exact ⟨0, one_dvd _⟩
  | succ a ih =>
      obtain ⟨t, c, hc⟩ := ih j
      rcases Nat.even_or_odd c with hcE | hcO
      · obtain ⟨c', rfl⟩ := hcE
        exact ⟨t, ⟨c', by rw [hc, pow_succ]; ring⟩⟩
      · have hcn : Even (c + n) := hcO.add_odd hn
        obtain ⟨c', hc'⟩ := hcn
        have h3 : j + (t + 2 ^ a) * n = 2 ^ a * (c + n) := by
          calc j + (t + 2 ^ a) * n = (j + t * n) + 2 ^ a * n := by ring
            _ = 2 ^ a * c + 2 ^ a * n := by rw [hc]
            _ = 2 ^ a * (c + n) := by ring
        exact ⟨t + 2 ^ a, ⟨c', by rw [h3, hc', pow_succ]; ring⟩⟩

/-- **Higman's first step of the odd-order extraction.**  `ξ ^ (|Ω₁(P)| - 1)` fixes `Ω₁(P)`
pointwise (the `⟨ξ⟩`-orbit of an involution is the whole set of involutions, of size
`|Ω₁(P)| - 1`). -/
private theorem pow_card_sub_one_fixes_omega1 (h : Work.Higman.IsSuzuki2Grp P) :
    ∀ z : P, z ∈ Work.Higman.omega1 P →
      (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) z = z :=
  (Work.Higman.xi_pow_triv_omega1_iff h (Nat.card ↥(Work.Higman.omega1 P) - 1)).mpr
    (dvd_refl _)

/-- **Odd-order extraction.**  Some power of `ξ` has odd order and is still transitive on the
involutions of `P` (so that `(P, ξ ^ k)` is again a Suzuki structure with an odd-order
automorphism). -/
private theorem exists_odd_order_power_trans (h : Work.Higman.IsSuzuki2Grp P) :
    ∃ ϑ : MulAut P, Odd (orderOf ϑ) ∧
      ∀ u v : P, orderOf u = 2 → orderOf v = 2 → ∃ j : ℕ, (ϑ ^ j) u = v := by
  classical
  haveI : Fintype P := Fintype.ofFinite P
  have hm0 : orderOf h.xi ≠ 0 := by
    have h1 : orderOf h.xi ∣ Fintype.card (MulAut P) :=
      orderOf_dvd_iff_pow_eq_one.mpr pow_card_eq_one
    intro hcon
    exact (Fintype.card_pos_iff.mpr ⟨1⟩).ne' (zero_dvd_iff.mp (hcon ▸ h1))
  obtain ⟨a, r, hr, hm⟩ := Nat.exists_eq_two_pow_mul_odd hm0
  refine ⟨h.xi ^ 2 ^ a, ?_, ?_⟩
  · rw [orderOf_pow, hm, Nat.gcd_eq_right (dvd_mul_right _ _),
      Nat.mul_div_right _ (pow_pos (by norm_num) a)]
    exact hr
  · intro u v hu hv
    obtain ⟨j, hj⟩ := h.trans u v hu hv
    have hvΩ : v ∈ Work.Higman.omega1 P :=
      h.mem_omega1.mpr (by rw [← orderOf_dvd_iff_pow_eq_one, hv])
    have hfix : (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) v = v :=
      pow_card_sub_one_fixes_omega1 h v hvΩ
    obtain ⟨n, hn⟩ := h.exists_card_omega1_eq_two_pow
    have hn1 : 1 ≤ n := by
      by_contra hcon
      push Not at hcon
      interval_cases n
      · rw [pow_zero] at hn
        have h4 := h.omega1_card_ge_four
        omega
    have hqodd : Odd (Nat.card ↥(Work.Higman.omega1 P) - 1) := by
      rw [hn]
      obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
      refine ⟨2 ^ n' - 1, by
        have h1 : 1 ≤ 2 ^ n' := Nat.one_le_pow n' 2 (by norm_num)
        have h2 : 2 ^ n' * 2 = 2 * (2 ^ n' - 1) + 2 := by omega
        rw [pow_succ, h2]
        omega⟩
    obtain ⟨t, s, hs⟩ := exists_pow_two_dvd_add_mul hqodd a j
    refine ⟨s, ?_⟩
    have h2 : h.xi ^ (j + t * (Nat.card ↥(Work.Higman.omega1 P) - 1)) = h.xi ^ (2 ^ a * s) := by
      rw [hs]
    have h3 : (h.xi ^ 2 ^ a) ^ s = h.xi ^ (2 ^ a * s) := by rw [pow_mul]
    rw [h3, ← h2]
    exact Work.Higman.pow_add_mul_pow_eq_of_fixes h hj hfix t

/-- **Step (a) of the kernel analysis: an odd-order element fixing `Ω₁(P)` fixes `A`.**
If `k` has odd order, normalises the abelian subgroup `A` with `A² = Ω₁(P)` and fixes `Ω₁(P)`
pointwise, then `k` fixes `A` pointwise: `k ^ 2` is the identity on `A`
(`apply_apply_eq_self_of_fixes_omega1`), and an odd-order automorphism of order dividing `2`
is trivial. -/
private theorem odd_order_fixes_of_fixes_omega1 {A : Subgroup P} {k : MulAut P}
    (hAinv : A.map (k : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hkΩ : ∀ z ∈ Work.Higman.omega1 P, k z = z)
    (hodd : Odd (orderOf k)) :
    ∀ a ∈ A, k a = a := by
  have hk2 : ∀ a ∈ A, k (k a) = a :=
    Work.Higman.apply_apply_eq_self_of_fixes_omega1 hAinv hAab htop hkΩ
  have hkk : ∀ b ∈ A, (k ^ 2) b = b := by
    intro b hb
    rw [pow_two, MulAut.mul_apply]
    exact hk2 b hb
  have hpow : ∀ t : ℕ, ∀ b ∈ A, ((k ^ 2) ^ t) b = b := by
    intro t
    induction t with
    | zero => intro b _; simp
    | succ t ih => intro b hb; rw [pow_succ, MulAut.mul_apply, hkk b hb, ih b hb]
  obtain ⟨s, hs⟩ := hodd
  intro a ha
  have hka : k a ∈ A := by
    have := Subgroup.mem_map_of_mem (k : MulAut P).toMonoidHom ha
    rwa [hAinv] at this
  have h1 : (k ^ (2 * s + 1)) a = a := by
    rw [← hs, pow_orderOf_eq_one]
    simp
  have h2 : (k ^ (2 * s + 1)) a = k a := by
    have h4 : k ^ (2 * s + 1) = (k ^ 2) ^ s * k := by rw [pow_succ, ← pow_mul]
    rw [h4, MulAut.mul_apply]
    exact hpow s (k a) hka
  rw [← h2]
  exact h1

/-- **Step (a2) of the kernel analysis.**  For an odd-order power `ϑ = ξ ^ k` (as produced by
`exists_odd_order_power_trans`), every power `ϑ ^ j` that fixes `Ω₁(P)` pointwise fixes the
abelian `A` pointwise. -/
private theorem odd_power_kernel_fixes_A {A : Subgroup P} (h : Work.Higman.IsSuzuki2Grp P)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    {k j : ℕ} (hodd : Odd (orderOf (h.xi ^ k)))
    (hjΩ : ∀ z ∈ Work.Higman.omega1 P, ((h.xi ^ k) ^ j) z = z) :
    ∀ a ∈ A, ((h.xi ^ k) ^ j) a = a := by
  have hAinv' : A.map ((((h.xi ^ k) ^ j) : MulAut P)).toMonoidHom = A := by
    have h1 : (((h.xi ^ k) ^ j) : MulAut P) = h.xi ^ (k * j) := by rw [pow_mul]
    rw [h1]
    exact Work.Higman.map_pow_xi_eq h hAinv (k * j)
  refine odd_order_fixes_of_fixes_omega1 hAinv' hAab htop hjΩ ?_
  exact hodd.of_dvd_nat (orderOf_pow_dvd (x := ((h.xi ^ k) : MulAut P)) j)

/-- **Step (b) of the kernel analysis, in the form `K` acts trivially on `P ⧸ A`.**  If `A` is
a normal subgroup with `C_P(A) = A` and `k` fixes `A` pointwise, then `k` moves every element
only inside its coset modulo `A`: `k x * x⁻¹ ∈ A`. -/
private theorem kernel_mul_inv_mem_of_centralizer {A : Subgroup P}
    (hcent : Subgroup.centralizer (A : Set P) = A) (hAn : A.Normal) {k : MulAut P}
    (hk : ∀ a ∈ A, k a = a) (x : P) :
    k x * x⁻¹ ∈ A := by
  rw [← hcent]
  exact Subgroup.mem_centralizer_iff.mpr
    (fun a ha => Work.Higman.commute_mul_inv_of_fixes_pointwise hAn hk x ha)

/-- **The conjugation relation for `d = k x * x⁻¹`.**  If `k` fixes `x ^ 2` (e.g. `k` fixes `A`
pointwise and `x ^ 2 ∈ A`), then `x` inverts `d`: `x * d * x⁻¹ = d⁻¹`.

(Indeed `(k x) ^ 2 = k (x ^ 2) = x ^ 2`, i.e. `d * x * d = x`, whence `x * d = d⁻¹ * x`.) -/
private theorem conj_d_eq_inv {A : Subgroup P} {k : MulAut P}
    (hkq : ∀ y ∈ A, k y = y) {x : P} (hx2 : x ^ 2 ∈ A) :
    x * (k x * x⁻¹) * x⁻¹ = (k x * x⁻¹)⁻¹ := by
  set d := k x * x⁻¹ with hd
  have hkx : k x = d * x := by rw [hd]; group
  have hx2' : x * x ∈ A := by rwa [pow_two] at hx2
  have h1 : d * x * (d * x) = x * x := by
    rw [show d * x = k x from hkx.symm, ← map_mul]
    exact hkq (x * x) hx2'
  have h2 : d * x * d = x := by
    have h1' : d * x * d * x = x * x := by
      rw [show d * x * d * x = d * x * (d * x) from by group]
      exact h1
    calc d * x * d = d * x * d * x * x⁻¹ := by group
      _ = x * x * x⁻¹ := by rw [h1']
      _ = x := by group
  have h3 : x * d = d⁻¹ * x := by
    calc x * d = d⁻¹ * (d * x * d) := by group
      _ = d⁻¹ * x := by rw [h2]
  rw [h3]
  group

/-- **The first half of the `d²` step.**  With `d = k x * x⁻¹` (where `k` fixes `A` pointwise and
`x ^ 2 ∈ A`), the commutator `⁅x, d⁆` equals `d⁻²`, so `d ^ 2 ∈ A`. -/
private theorem sq_d_mem_of_conj {A : Subgroup P} (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A) {k : MulAut P}
    (hkq : ∀ y ∈ A, k y = y) {x : P} (hx2 : x ^ 2 ∈ A) :
    (k x * x⁻¹) ^ 2 ∈ A := by
  have hconj := conj_d_eq_inv hkq hx2
  have hmem : ⁅x, k x * x⁻¹⁆ ∈ A := by
    rw [← hGs]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top _)
  rw [commutatorElement_def, hconj] at hmem
  have hsq : (k x * x⁻¹) ^ 2 = ((k x * x⁻¹)⁻¹ * (k x * x⁻¹)⁻¹)⁻¹ := by
    rw [pow_two]; group
  rw [hsq]
  exact A.inv_mem hmem

/-- **`ξ` is transitive on the non-zero cosets of `A/A²`.**  For `x, y` whose squares lie outside
`A²` there is `k` with `ξ^k (x²) · (y²)⁻¹ ∈ A²`.

This is the existing `Work.Higman.exists_xi_pow_mul_inv_mem_powSub_two` (`Fq_structure.lean`)
applied to `a := x²`, `b := y²`.  The hypothesis is **not** vacuous: `x² ∉ A²` forces `x ∉ A`
(for `x ∈ A` the element `x²` is a square of an element of `A`, so `x² ∈ A²` by definition of
`A² = powSub A 2`), hence `x² A²` is a genuine non-zero coset of `A/A²`.  The coterminous
statement with hypothesis `a ∈ A` *and* `a² ∉ A²` was vacuous for exactly that reason and has
been removed. -/
private theorem xi_orbit_sq_quot (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    {x y : P} (hx2 : x ^ 2 ∉ Work.Higman.powSub A 2) (hy2 : y ^ 2 ∉ Work.Higman.powSub A 2) :
    ∃ k : ℕ, (h.xi ^ k) (x ^ 2) * (y ^ 2)⁻¹ ∈ Work.Higman.powSub A 2 :=
  Work.Higman.exists_xi_pow_mul_inv_mem_powSub_two h hA (hsq x) (hsq y) hx2 hy2

/-- **The branch `E' = A²` of the `C₄` exclusion is impossible.**  For `z` with `z² ∉ A²` the
`ξ`-invariant normal subgroup `E := ⟨A ∪ ξ-orbit(z)⟩` (normal and `ξ`-invariant by
`Q3.ex_subgroup_c4`, applied with `[⊤,⊤] = A`) cannot satisfy `⁅E,E⁆ = A²`: by
`Q3.Dsq_sq_mem_powSub_two` every square of an element of `E` would then lie in `A²`, and `z ∈ E`
(as `ξ ^ 0 z`) gives `z² ∈ A²`, contradicting `z² ∉ A²`. -/
private theorem ex_subgroup_deriv_ne_powSub_two (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    {z : P} (hz2 : z ^ 2 ∉ Work.Higman.powSub A 2) :
    ⁅Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) z)),
      Subgroup.closure ((A : Set P) ∪ Set.range (fun k : ℕ => (h.xi ^ k) z))⁆ ≠
      Work.Higman.powSub A 2 := by
  intro hEd
  obtain ⟨hEn, hEinv, hAE, hzE⟩ :=
    Work.Higman.Q3.ex_subgroup_c4 h hA.map_eq hA.normal (le_of_eq hGs) z
  exact hz2 (Work.Higman.Q3.Dsq_sq_mem_powSub_two h hA.map_eq hA.abelian hNA htop
    hEn hEinv hAE hEd z hzE)

/-- **In the `C₄` setting some square of `P` misses `A²`.**  Otherwise `P² ≤ A²`, and since
`A = [P,P] ≤ P²` (for a `2`-group the derived subgroup lies in the subgroup of squares:
`[x,y] = x² · (x⁻¹y)² · (y²)⁻¹`), transitivity gives `A ≤ A²`; together with `A² ≤ A` this is
`A = A²`, and `A² = Ω₁(P)` makes `|A| = q` while `hcard` says `|A| = q²`, so `q² = q` — against
`q ≥ 4`. -/
private theorem exists_sq_not_mem_powSub_two (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hGs : ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    ∃ z : P, z ^ 2 ∉ Work.Higman.powSub A 2 := by
  by_contra hcon
  push_neg at hcon
  have hP2 : Work.Higman.powSub (⊤ : Subgroup P) 2 ≤ Work.Higman.powSub A 2 := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hcon x
  have hderiv : ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ ≤ Work.Higman.powSub (⊤ : Subgroup P) 2 := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    have key : ⁅x, y⁆ = x ^ 2 * (x⁻¹ * y) ^ 2 * (y ^ 2)⁻¹ := by
      rw [commutatorElement_def, pow_two (a := x), pow_two (a := x⁻¹ * y), pow_two (a := y)]
      group
    rw [key]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _
      (Work.Higman.pow_mem_powSub (n := 2) (Subgroup.mem_top x))
      (Work.Higman.pow_mem_powSub (n := 2) (Subgroup.mem_top (x⁻¹ * y))))
      (Subgroup.inv_mem _ (Work.Higman.pow_mem_powSub (n := 2) (Subgroup.mem_top y)))
  have hAle : A ≤ Work.Higman.powSub A 2 := by
    have h1 := hderiv.trans hP2
    rwa [hGs] at h1
  have hAeq : A = Work.Higman.powSub A 2 :=
    le_antisymm hAle (Work.Higman.powSub_le (by norm_num : 0 < 2))
  have hq2 : Nat.card ↥(Work.Higman.omega1 P) * Nat.card ↥(Work.Higman.omega1 P)
      = Nat.card ↥(Work.Higman.omega1 P) := by
    rw [← pow_two, ← hcard, hAeq, htop]
  have hqle : Nat.card ↥(Work.Higman.omega1 P) ≤ 1 := by
    have h1 : Nat.card ↥(Work.Higman.omega1 P) * Nat.card ↥(Work.Higman.omega1 P)
        ≤ Nat.card ↥(Work.Higman.omega1 P) * 1 := by rw [mul_one, hq2]
    exact Nat.le_of_mul_le_mul_left h1
      (Nat.lt_of_lt_of_le (by norm_num : 0 < 4) h.omega1_card_ge_four)
  exact absurd (le_trans h.omega1_card_ge_four hqle) (by norm_num)

/-! ## The Jacobi relation of the `C₄` gap

In the gap `⁅C,C⁆ = A² = Ω₁(P)` the class-three Jacobi identity
(`Work.Higman.Q3.crux_class_three_jacobi`) together with the centrality of `⁅C,C⁆ = A² ⊆ Z(P)`
gives, for `x, z ∈ C` and arbitrary `y`,

  `⁅⁅x,y⁆,z⁆ = ⁅⁅y,z⁆,x⁆`,

the "resonance" relation which is the computational heart of Higman's Lemma 13 (the pairing
`(x̄,ȳ) ↦ ⁅x,y⁆` has to satisfy the graded Jacobi identity).  In the two-cover configuration
`P = C·Y`, `C ∩ Y = A` this reads `φ(B(x,y),z) = φ(B(y,z),x)` for `x,z ∈ C/A` and `y`, which
combined with the Frobenius/eigenvalue bookkeeping (`resonance_of_equivariant_biadditive`,
`Q3.two_pow_add_eq_pow`) yields `False`; see `H8/NOTES_c4_gap_session11.md`. -/

/-- **The Jacobi relation of the `C₄` gap.**  For `x, z ∈ C` and arbitrary `y`,
`⁅⁅x, y⁆, z⁆ = ⁅⁅y, z⁆, x⁆`.

Both sides lie in `⁅A,⊤⁆ = A² ⊆ Z(P)`; the class-three Jacobi identity gives
`⁅⁅x,y⁆,z⁆ · ⁅⁅y,z⁆,x⁆ · ⁅⁅z,x⁆,y⁆ = 1` with `⁅⁅z,x⁆,y⁆ = 1` (as `⁅z,x⁆ ∈ ⁅C,C⁆ = A²` is
central), and `⁅⁅y,z⁆,x⁆` is an involution (it lies in `⁅A,⊤⁆ = A² = Ω₁(P)`), so the inverse is
the element itself. -/
private theorem c4_jacobi_pairing (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hAtop : ⁅A, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    {x z : P} (hx : x ∈ C) (hz : z ∈ C) (y : P) :
    ⁅⁅x, y⁆, z⁆ = ⁅⁅y, z⁆, x⁆ := by
  have hzx : ⁅z, x⁆ ∈ Work.Higman.powSub A 2 := by
    rw [← hCd]; exact Subgroup.commutator_mem_commutator hz hx
  have hzx_c : ⁅z, x⁆ ∈ Subgroup.center P := h.omega1_le_center (htop ▸ hzx)
  have hzx1 : ⁅⁅z, x⁆, y⁆ = 1 := by
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact ((Subgroup.mem_center_iff.mp hzx_c) y).symm
  have hj : ⁅⁅x, y⁆, z⁆ * ⁅⁅y, z⁆, x⁆ * ⁅⁅z, x⁆, y⁆ = 1 :=
    Work.Higman.Q3.crux_class_three_jacobi h hA hGs hsq htop x y z
  rw [hzx1, mul_one] at hj
  have hyz : ⁅y, z⁆ ∈ A := by
    have h1 := Subgroup.commutator_mem_commutator (Subgroup.mem_top y) (Subgroup.mem_top z)
    rwa [hGs] at h1
  have hB : ⁅⁅y, z⁆, x⁆ ∈ Work.Higman.powSub A 2 := by
    have h1 : ⁅⁅y, z⁆, x⁆ ∈ (⁅A, (⊤ : Subgroup P)⁆ : Subgroup P) :=
      Subgroup.commutator_mem_commutator hyz (Subgroup.mem_top x)
    rwa [hAtop] at h1
  have hBsq : ⁅⁅y, z⁆, x⁆ * ⁅⁅y, z⁆, x⁆ = 1 := by
    have h2 : ⁅⁅y, z⁆, x⁆ ^ 2 = 1 := h.mem_omega1.mp (htop ▸ hB)
    rwa [pow_two] at h2
  have h1 : ⁅⁅x, y⁆, z⁆ = (⁅⁅y, z⁆, x⁆)⁻¹ := eq_inv_of_mul_eq_one_left hj
  rw [h1, inv_eq_of_mul_eq_one_right hBsq]

private theorem c4_card_le {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P) :
    Nat.card P ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
  by_cases hcomm : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.omega1 P
  · exact c4_card_le_of_comm_le_omega1 h hcomm
  · obtain ⟨A, hA, hmax, hNA, hGs, hsq, hA4, htop, hcard⟩ := c4_data h hcomm
    exact (c4_exclusion_alt h hA hmax hNA hGs hsq hA4 htop hcard).elim

end Work.Higman.H8
end

-- ===== from Submission.Work.Higman.HS.hard_two_cover =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

open scoped commutatorElement

namespace Work.Higman.HS

variable {P : Type} [Group P] [Finite P]

/-! ## Elementary structural facts in the `C₄` setting

In the configuration of `Work.Higman.HS.hard_two_cover` (`A ⊴ P` abelian `ξ`-invariant,
`Ω₁(P) ≤ A`, `[P,P] = A`, every square of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)`,
`|A| = |Ω₁(P)|²`) together with `⁅C,A⁆ = A²` we record:

* `⁅A,⊤⁆ = A²` (so `A/A²` is the target of the commutator pairing on `P/A`);
* `Z(P) = A²`;
* `C² = A²`.
-/

/-- `A² ≠ ⊥` in the `C₄` setting. -/
private theorem powSub_two_ne_bot_aux (h : IsSuzuki2Grp P) {A : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    Work.Higman.powSub A 2 ≠ ⊥ := by
  intro hb
  have hc : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
  have h4 := h.omega1_card_ge_four
  omega

/-- **`⁅A,⊤⁆ = A²`** in the `C₄` setting. -/
private theorem comm_A_top_eq_aux (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) :
    ⁅A, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2 := by
  have hle := commutator_A_top_le (A := A) hAn
  have hinv := map_xi_commutator_A_top h hAxi
  rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hle hinv with hb | h2 | h3
  · exfalso
    have h1 : (⁅C, A⁆ : Subgroup P) ≤ ⊥ := by
      rw [Subgroup.commutator_comm]
      exact (Subgroup.commutator_mono le_rfl le_top).trans (le_of_eq hb)
    rw [hCAd] at h1
    exact powSub_two_ne_bot_aux h htop (le_bot_iff.mp h1)
  · exact h2
  · exact absurd h3 (comm_self_false h hNA)

/-- **`Z(P) = A²`** in the `C₄` setting. -/
private theorem center_eq_powSub_two_aux (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) :
    Subgroup.center P = Work.Higman.powSub A 2 := by
  have hA : Work.Higman.IsXiAbelNormal h A := ⟨hAn, hAxi, hAab⟩
  have hZleA : Subgroup.center P ≤ A := Work.Higman.center_le_of_maximal h hA hmax
  have hA2leZ : Work.Higman.powSub A 2 ≤ Subgroup.center P := by
    rw [htop]; exact h.omega1_le_center
  have hZinv : (Subgroup.center P).map (h.xi : MulAut P).toMonoidHom = Subgroup.center P := by
    refine le_antisymm ?_ ?_
    · rintro x ⟨z, hz, rfl⟩
      exact Work.Higman.aut_mem_center (h.xi : MulAut P) hz
    · intro x hx
      exact ⟨(h.xi : MulAut P).symm x,
        Work.Higman.aut_mem_center (h.xi : MulAut P).symm hx, by simp⟩
  rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hZleA hZinv with h1 | h2 | h3
  · exfalso
    exact powSub_two_ne_bot_aux h htop (le_bot_iff.mp (hA2leZ.trans (le_of_eq h1)))
  · exact h2
  · exfalso
    have hAZ : A ≤ Subgroup.center P := le_of_eq h3.symm
    have h1 : (⁅C, A⁆ : Subgroup P) = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro c _
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      exact (Subgroup.mem_center_iff.mp (hAZ ha) c).symm
    rw [hCAd] at h1
    exact powSub_two_ne_bot_aux h htop h1

/-- `⁅C,C⁆ ≤ C²` for any subgroup `C` (from `⁅x,y⁆ = x² (x⁻¹y)² (y²)⁻¹`). -/
private theorem commutator_le_powSub_two (C : Subgroup P) : ⁅C, C⁆ ≤ Work.Higman.powSub C 2 := by
  rw [Subgroup.commutator_le]
  intro x hx y hy
  have key : ⁅x, y⁆ = x ^ 2 * (x⁻¹ * y) ^ 2 * (y ^ 2)⁻¹ := by
    rw [commutatorElement_def, pow_two (a := x), pow_two (a := x⁻¹ * y), pow_two (a := y)]
    group
  rw [key]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Work.Higman.pow_mem_powSub hx)
    (Work.Higman.pow_mem_powSub (C.mul_mem (C.inv_mem hx) hy)))
    (Subgroup.inv_mem _ (Work.Higman.pow_mem_powSub hy))

/-- The commutator-square identity `⁅x²,y⁆ = ⁅x,⁅x,y⁆⁆ ⁅x,y⁆²`. -/
private theorem commutatorElement_sq_self (x y : P) :
    ⁅x ^ 2, y⁆ = ⁅x, ⁅x, y⁆⁆ * ⁅x, y⁆ ^ 2 := by
  simp only [commutatorElement_def, pow_two]
  group

/-- **`C² = A²`** in the `C₄` setting: `C² ≤ A`, `C² ∈ {⊥, A², A}`, and neither `⊥` nor `A`
can occur. -/
private theorem powSub_C_eq_powSub_A_two (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hC2 : Work.Higman.powSub C 2 ≤ A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) :
    Work.Higman.powSub C 2 = Work.Higman.powSub A 2 := by
  have hC2inv : (Work.Higman.powSub C 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub C 2 := Work.Higman.map_powSub (h.xi : MulAut P) hCinv 2
  rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hC2 hC2inv with hb | h2 | h3
  · -- `C² = ⊥` contradicts `[C,C] = A²`
    exfalso
    have h1 : ⁅C, C⁆ ≤ (⊥ : Subgroup P) := (commutator_le_powSub_two C).trans (le_of_eq hb)
    rw [hCd] at h1
    exact powSub_two_ne_bot_aux h htop (le_bot_iff.mp h1)
  · exact h2
  · -- `C² = A`: then `⁅x²,y⁆ = 1` for `x y ∈ C` since `⁅x,y⁆ ∈ A² = Ω₁(P)` is central of
    -- order two, whence `A = C²` centralises `C`, contradicting `⁅C,A⁆ = A²`
    exfalso
    have hA2Z : Work.Higman.powSub A 2 ≤ Subgroup.center P := by
      rw [htop]; exact h.omega1_le_center
    have hA2inv : ∀ z ∈ Work.Higman.powSub A 2, z ^ 2 = 1 := by
      intro z hz
      exact h.mem_omega1.mp (htop ▸ hz)
    have key : ∀ x y : P, x ∈ C → y ∈ C → ⁅x ^ 2, y⁆ = 1 := by
      intro x y hx hy
      have hxy : ⁅x, y⁆ ∈ Work.Higman.powSub A 2 := by
        rw [← hCd]
        exact Subgroup.commutator_mem_commutator hx hy
      have hcen : ⁅x, y⁆ ∈ Subgroup.center P := hA2Z hxy
      have h2 : ⁅x, ⁅x, y⁆⁆ = 1 :=
        commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp hcen x)
      rw [commutatorElement_sq_self, h2, hA2inv _ hxy, one_mul]
    have hcent : A ≤ Subgroup.centralizer (C : Set P) := by
      rw [← h3, Work.Higman.powSub, Subgroup.closure_le]
      rintro z ⟨x, hx, rfl⟩
      refine Subgroup.mem_centralizer_iff.mpr ?_
      intro y hy
      exact (commutatorElement_eq_one_iff_mul_comm.mp (key x y hx hy)).symm
    have hbot : (⁅A, C⁆ : Subgroup P) = ⊥ :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hcent
    have hz : Work.Higman.powSub A 2 = ⊥ := by
      rw [← hCAd, Subgroup.commutator_comm]
      exact hbot
    exact powSub_two_ne_bot_aux h htop hz

/-! ## The subgroup `E = {x : ⁅x,y⁆ ∈ A² for all y}`

This is the preimage of the centre of `P ⧸ A²`; it is the radical of the commutator pairing
`P/A × P/A → A/A²` and is the key auxiliary object for the surviving case `⁅C,⊤⁆ = A`
(see `Submission/Work/Higman/HS/NOTES_hard_two_cover.md`).
-/

/-- `{x : ⁅x,y⁆ ∈ A² for all y}`, the preimage of the centre of `P ⧸ A²`. -/
private noncomputable def Erad (h : IsSuzuki2Grp P) (A : Subgroup P) [hAn : A.Normal] : Subgroup P :=
  letI : (Work.Higman.powSub A 2).Normal := Work.Higman.powSub_normal hAn 2
  Subgroup.comap (QuotientGroup.mk' (Work.Higman.powSub A 2))
    (Subgroup.center (P ⧸ (Work.Higman.powSub A 2)))

/-- `x` lies in `Erad h A` iff all its commutators with `P` lie in `A²`. -/
private theorem mem_Erad_iff {h : IsSuzuki2Grp P} {A : Subgroup P} [hAn : A.Normal] {x : P} :
    x ∈ Erad h A ↔ ∀ y : P, x * y * x⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2 := by
  haveI := Work.Higman.powSub_normal hAn 2
  unfold Erad
  exact erad_mem_iff

/-- `Erad h A` is a normal subgroup. -/
private theorem Erad_normal {h : IsSuzuki2Grp P} {A : Subgroup P} [hAn : A.Normal] :
    (Erad h A).Normal := by
  haveI := Work.Higman.powSub_normal hAn 2
  unfold Erad
  exact Subgroup.Normal.comap inferInstance (QuotientGroup.mk' (Work.Higman.powSub A 2))

/-- `A ≤ Erad h A` whenever `⁅A,⊤⁆ = A²`. -/
private theorem A_le_Erad {h : IsSuzuki2Grp P} {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) : A ≤ Erad h A := by
  have h1 : ⁅A, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2 :=
    comm_A_top_eq_aux h hAab hAxi hNA htop hA4 hCAd
  intro a ha
  rw [mem_Erad_iff]
  intro y
  have h2 : ⁅a, y⁆ ∈ ⁅A, (⊤ : Subgroup P)⁆ :=
    Subgroup.commutator_mem_commutator ha (Subgroup.mem_top y)
  rw [h1] at h2
  simpa [commutatorElement_def] using h2

/-- `Erad h A` is `ξ`-invariant. -/
private theorem map_xi_Erad {h : IsSuzuki2Grp P} {A : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A) :
    (Erad h A).map (h.xi : MulAut P).toMonoidHom = Erad h A := by
  have hA2inv : (Work.Higman.powSub A 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub A 2 := Work.Higman.map_powSub (h.xi : MulAut P) hAxi 2
  have key : ∀ x : P, h.xi x ∈ Erad h A ↔ x ∈ Erad h A := by
    intro x
    rw [mem_Erad_iff, mem_Erad_iff]
    constructor
    · intro hx y
      have h1 : h.xi (x * y * x⁻¹ * y⁻¹) ∈ Work.Higman.powSub A 2 := by
        have h2 := hx (h.xi y)
        rw [show h.xi (x * y * x⁻¹ * y⁻¹)
            = h.xi x * h.xi y * (h.xi x)⁻¹ * (h.xi y)⁻¹ by
              rw [map_mul, map_mul, map_mul, map_inv, map_inv]]
        exact h2
      have h3 := Work.Higman.symm_mem_of_map_eq (h.xi : MulAut P) hA2inv h1
      simpa using h3
    · intro hx y
      have h1 : x * (h.xi : MulAut P).symm y * x⁻¹ * ((h.xi : MulAut P).symm y)⁻¹
          ∈ Work.Higman.powSub A 2 := hx _
      have h2 : h.xi (x * (h.xi : MulAut P).symm y * x⁻¹ * ((h.xi : MulAut P).symm y)⁻¹)
          ∈ (Work.Higman.powSub A 2).map (h.xi : MulAut P).toMonoidHom :=
        Subgroup.mem_map_of_mem _ h1
      rw [hA2inv] at h2
      rw [show h.xi (x * (h.xi : MulAut P).symm y * x⁻¹ * ((h.xi : MulAut P).symm y)⁻¹)
          = h.xi x * y * (h.xi x)⁻¹ * y⁻¹ by
            rw [map_mul, map_mul, map_mul, map_inv, map_inv]
            simp] at h2
      exact h2
  refine le_antisymm ?_ ?_
  · rintro x ⟨y, hy, rfl⟩
    exact (key y).mpr hy
  · intro x hx
    refine ⟨(h.xi : MulAut P).symm x, (key _).mp ?_, by simp⟩
    simpa using hx

/-! ## The dichotomy for `⁅C,⊤⁆` -/

/-- In the `C₄` setting, `⁅C,⊤⁆` lies between `[C,C] = A²` and `[⊤,⊤] = A`, so it is `A²` or
`A`. -/
private theorem comm_C_top_dichotomy (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) :
    ⁅C, (⊤ : Subgroup P)⁆ = Work.Higman.powSub A 2 ∨
      ⁅C, (⊤ : Subgroup P)⁆ = A := by
  have hle : (⁅C, (⊤ : Subgroup P)⁆ : Subgroup P) ≤ A := by
    calc ⁅C, (⊤ : Subgroup P)⁆ ≤ ⁅(⊤ : Subgroup P), ⊤⁆ :=
          Subgroup.commutator_mono le_top le_rfl
      _ = A := hGs
  have hinv : (⁅C, (⊤ : Subgroup P)⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom
      = ⁅C, (⊤ : Subgroup P)⁆ := by
    rw [Subgroup.map_commutator, hCinv,
      Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective]
  rcases xi_inv_sub_dichotomy h hAab hAxi htop hA4 hle hinv with hb | h2 | h3
  · exfalso
    have hb2 : (⁅C, C⁆ : Subgroup P) ≤ (⊥ : Subgroup P) :=
      (Subgroup.commutator_mono le_rfl le_top).trans (le_of_eq hb)
    rw [hCd] at hb2
    exact powSub_two_ne_bot_aux h htop (le_bot_iff.mp hb2)
  · exact Or.inl h2
  · exact Or.inr h3

/-- In the `C₄` setting with `⁅C,⊤⁆ = A`, a `ξ`-invariant normal subgroup `A < E` that
centralises `P` modulo `A²` cannot be contained in `C`. -/
private theorem Erad_not_le_C_of_gt (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCTop : ⁅C, (⊤ : Subgroup P)⁆ = A)
    (hEgt : A < Erad h A) :
    ¬ (Erad h A ≤ C) := by
  intro hEC
  have hAne2 : A ≠ Work.Higman.powSub A 2 := by
    intro heq
    rw [heq, htop] at hcard
    have h4 := h.omega1_card_ge_four
    have hp : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
    nlinarith [hcard, h4, hp]
  have hAEr : A ≤ Erad h A := A_le_Erad (h := h) hAab hAxi hNA htop hA4 hCAd
  have hErn : (Erad h A).Normal := Erad_normal
  have hErinv : (Erad h A).map (h.xi : MulAut P).toMonoidHom = Erad h A := map_xi_Erad hAxi
  rcases hcover (Erad h A) hErn hErinv hAEr hEC with h1 | h1
  · exact absurd h1.symm (ne_of_lt hEgt)
  · have hle : (⁅C, (⊤ : Subgroup P)⁆ : Subgroup P) ≤ Work.Higman.powSub A 2 := by
      rw [Subgroup.commutator_le]
      intro c hc y _
      have hc' : c ∈ Erad h A := by rw [h1]; exact hc
      rw [mem_Erad_iff] at hc'
      simpa [commutatorElement_def] using hc' y
    rw [hCTop] at hle
    exact hAne2 (le_antisymm hle (Work.Higman.powSub_le (by norm_num)))

/-! ## The elementary quotient lemma closing the case `A < Erad h A`

The bundled hypothesis package `HardTwoCoverData`, the descent step
`Work.Higman.HS.htc_hard_two_cover_descent`, and the subgroup-transport lemmas it needs live in
`Submission/Work/Higman/HS/htc_transport.lean` (this module imports it).

If `P = C ⊔ E` with `⁅C,C⁆ ≤ A²` and `E ≤ Erad h A` (i.e. `E` centralises `P` modulo `A²`),
then the whole commutator subgroup of `P` lies in `A²`.  The computation is carried out
elementwise, using the two elementary identities
`⁅x * y, z⁆ = x * ⁅y,z⁆ * x⁻¹ * ⁅x,z⁆` and `⁅x, y*z⁆ = ⁅x,y⁆ * y * ⁅x,z⁆ * y⁻¹`
together with the normality of `A²`. -/

/-- **`P = C ⊔ E`, `⁅C,C⁆ ≤ A²`, `E ≤ Erad h A` ⟹ `⁅⊤,⊤⁆ ≤ A²`.** -/
private theorem commutator_le_powSub_two_of_sup (h : IsSuzuki2Grp P) {A C E : Subgroup P} [hAn : A.Normal]
    [hCn : C.Normal] (hCE : C ⊔ E = ⊤)
    (hCC : ⁅C, C⁆ ≤ Work.Higman.powSub A 2) (hE : E ≤ Erad h A) :
    ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ ≤ Work.Higman.powSub A 2 := by
  haveI hNn : (Work.Higman.powSub A 2).Normal := Work.Higman.powSub_normal hAn 2
  rw [← hCE, Subgroup.commutator_le]
  intro x hx y hy
  obtain ⟨c, hc, e, he, rfl⟩ := (Subgroup.mem_sup_of_normal_left (s := C) (t := E)).mp hx
  obtain ⟨c', hc', e', he', rfl⟩ := (Subgroup.mem_sup_of_normal_left (s := C) (t := E)).mp hy
  have hEcomm : ∀ u ∈ E, ∀ y : P, ⁅u, y⁆ ∈ Work.Higman.powSub A 2 := by
    intro u hu y
    have h1 := (mem_Erad_iff.mp (hE hu)) y
    simpa [commutatorElement_def] using h1
  have hkey : ∀ x y z : P, ⁅x * y, z⁆ = x * ⁅y, z⁆ * x⁻¹ * ⁅x, z⁆ := by
    intro x y z; rw [commutatorElement_def, commutatorElement_def, commutatorElement_def]; group
  have hkey2 : ∀ x y z : P, ⁅x, y * z⁆ = ⁅x, y⁆ * y * ⁅x, z⁆ * y⁻¹ := by
    intro x y z; rw [commutatorElement_def, commutatorElement_def, commutatorElement_def]; group
  have h5 : ⁅e, c' * e'⁆ ∈ Work.Higman.powSub A 2 := by
    rw [hkey2 e c' e']
    rw [show ⁅e, c'⁆ * c' * ⁅e, e'⁆ * c'⁻¹ = ⁅e, c'⁆ * (c' * ⁅e, e'⁆ * c'⁻¹) by group]
    exact (Work.Higman.powSub A 2).mul_mem (hEcomm e he c')
      (hNn.conj_mem _ (hEcomm e he e') c')
  have h6 : ⁅c, c' * e'⁆ ∈ Work.Higman.powSub A 2 := by
    have hce' : ⁅c, e'⁆ ∈ Work.Higman.powSub A 2 := by
      have hh := hEcomm e' he' c
      rw [← commutatorElement_inv] at hh
      simpa using (Work.Higman.powSub A 2).inv_mem hh
    rw [hkey2 c c' e']
    rw [show ⁅c, c'⁆ * c' * ⁅c, e'⁆ * c'⁻¹ = ⁅c, c'⁆ * (c' * ⁅c, e'⁆ * c'⁻¹) by group]
    exact (Work.Higman.powSub A 2).mul_mem
      (hCC (Subgroup.commutator_mem_commutator hc hc')) (hNn.conj_mem _ hce' c')
  rw [hkey c e (c' * e')]
  exact (Work.Higman.powSub A 2).mul_mem (hNn.conj_mem _ h5 c) h6

/-- `A ≠ A²` in the `C₄` setting (`|A| = |Ω₁(P)|²`, `A² = Ω₁(P)`, `|Ω₁(P)| ≥ 4`). -/
private theorem ne_powSub_two_of_card (h : IsSuzuki2Grp P) {A : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    A ≠ Work.Higman.powSub A 2 := by
  intro heq
  have h3 : Nat.card ↥(Work.Higman.omega1 P) = Nat.card ↥A := by rw [← htop, ← heq]
  have hq : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 :=
    h3.trans hcard
  have h4 := h.omega1_card_ge_four
  have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
  nlinarith [hq, h4, hpos]

/-! ## `Erad h A = A` is *forced* in the case `⁅C,⊤⁆ = A`

This is the observation that pins the residual branch below: in the situation `M = ⊤`,
`⁅C,⊤⁆ = A` the radical `Erad h A` cannot properly contain `A`, so `Erad h A = A` is a
*consequence* of the data, not an extra hypothesis.  (`A ≤ Erad h A` is `A_le_Erad`.)  The
standalone statement of the residual in `Submission/Work/Higman/HS/…` therefore says the same
thing as the version without the `Erad = A` hypothesis.

Concretely: `A < Erad h A` gives `Erad h A ≰ C` (`Erad_not_le_C_of_gt`), so `C ⊔ Erad h A`
is a strictly larger `ξ`-invariant normal subgroup than `C`, hence `= ⊤` by `hMcover`; then
`commutator_le_powSub_two_of_sup` gives `⁅⊤,⊤⁆ ≤ A²`, i.e. `A = A²`, contradicting
`|A| = |Ω₁(P)|²` (`ne_powSub_two_of_card`). -/

/-- In the residual setting (`M = ⊤`, `⁅C,⊤⁆ = A`), `Erad h A` does not properly contain `A`. -/
private theorem not_lt_Erad (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hMcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      C ≤ D → D = C ∨ D = ⊤)
    (hCTop : ⁅C, (⊤ : Subgroup P)⁆ = A) :
    ¬ (A < Erad h A) := by
  intro hgt
  have hnotle : ¬ Erad h A ≤ C :=
    Erad_not_le_C_of_gt h hAab hAxi hNA htop hA4 hcard hCAd hcover hCTop hgt
  haveI : C.Normal := hCn
  have hEn : (Erad h A).Normal := Erad_normal
  have hEinv : (Erad h A).map (h.xi : MulAut P).toMonoidHom = Erad h A := map_xi_Erad hAxi
  have hsupinv : (C ⊔ Erad h A).map (h.xi : MulAut P).toMonoidHom = C ⊔ Erad h A := by
    rw [Subgroup.map_sup, hCinv, hEinv]
  rcases hMcover (C ⊔ Erad h A) inferInstance hsupinv le_sup_left with hsup | hsup
  · exact hnotle ((le_sup_right : Erad h A ≤ C ⊔ Erad h A).trans (le_of_eq hsup))
  · have hcc : ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ ≤ Work.Higman.powSub A 2 :=
      commutator_le_powSub_two_of_sup h hsup (le_of_eq hCd) le_rfl
    rw [hGs] at hcc
    exact ne_powSub_two_of_card h htop hcard
      (le_antisymm hcc (Work.Higman.powSub_le (by norm_num)))

/-- **The residual's `Erad h A = A` is not an extra hypothesis.**  Composing
`not_lt_Erad` with `A ≤ Erad h A` (`A_le_Erad`) shows that it is *derived* from the rest of
the residual data.  Consequently the frozen standalone target
`Higman/HS/c4_residual` (which does *not* carry `Erad h A = A` as a hypothesis) is exactly
this branch, and is the sharpest form of it. -/
private theorem Erad_eq_A (h : IsSuzuki2Grp P) {A C : Subgroup P} [hAn : A.Normal]
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hMcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      C ≤ D → D = C ∨ D = ⊤)
    (hCTop : ⁅C, (⊤ : Subgroup P)⁆ = A) :
    Erad h A = A := by
  have hAEr : A ≤ Erad h A := A_le_Erad (h := h) hAab hAxi hNA htop hA4 hCAd
  refine le_antisymm ?_ hAEr
  by_contra hcon
  exact not_lt_Erad h hAab hAxi hNA hGs htop hA4 hcard hCn hCinv hcover hCAd hCd hMcover
    hCTop (lt_of_le_of_ne hAEr (fun heq => hcon (le_of_eq heq.symm)))

/-! ## The main theorem

The proof is by strong induction on `Nat.card P` over all instances of the bundled data.

* If `M < ⊤` the descent `htc_hard_two_cover_descent` transports the data to the Suzuki
  2-group `↥M` (of smaller order) and the induction hypothesis applies.
* If `M = ⊤`, the dichotomy `comm_C_top_dichotomy` gives `⁅C,⊤⁆ ∈ {A², A}`.  The case
  `⁅C,⊤⁆ = A²` is `C4Cover.c4_branch_CP_A2`; in the case `⁅C,⊤⁆ = A` the subgroup
  `E := Erad h A` satisfies `A ≤ E ⊴ P` and is `ξ`-invariant, and if `E > A` then
  `E ≰ C`, whence `C ⊔ E = ⊤` by `hMcover` and `commutator_le_powSub_two_of_sup` forces
  `A ≤ A²`, contradicting `|A| = |Ω₁(P)|²`.
* The residual case `E = A` is the `C₄` gap (Higman's Theorem 1 / Lemma 13 in the reducible
  case); it is isolated as the last `sorry` below. -/

private theorem hard_two_cover {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C M : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hC2 : Work.Higman.powSub C 2 ≤ A) (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hMn : M.Normal) (hMinv : M.map (h.xi : MulAut P).toMonoidHom = M)
    (hCM : C ≤ M) (hCMne : C ≠ M)
    (hMcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      C ≤ D → D ≤ M → D = C ∨ D = M)
    (hMd : ⁅M, M⁆ = A) : False := by
  classical
  -- Strong induction on `Nat.card` over all instances of the bundled data.
  have key : ∀ n : ℕ, ∀ (Q : Type) [Group Q] [Finite Q] (hQ : Work.Higman.IsSuzuki2Grp Q)
      (A' C' M' : Subgroup Q) [A'.Normal],
      Nat.card Q = n → HardTwoCoverData hQ A' C' M' → False := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro Q hGQ hFQ hQ A' C' M' hAnQ hcardQ hd
      by_cases hMtop : M' = ⊤
      · -- ## `M = ⊤`: the dichotomy for `⁅C,⊤⁆`
        subst hMtop
        obtain ⟨hAxi, hAab, hmax, hNA, hGs, hsq, hA4, htop, hcard, hCn, hCinv, hAC, hCA,
          hcover, hC2, hCAd, hCd, hMn, hMinv, hCM, hCMne, hMcover, hMd⟩ := hd
        haveI : Subgroup.Normal C' := hCn
        have hcent : Subgroup.centralizer (A' : Set Q) = A' :=
          centralizer_eq_A_of_comm_C_A hQ hAxi hAab hNA hGs hsq hA4 htop hcard hCn hCinv
            hAC hcover hCAd
        rcases comm_C_top_dichotomy hQ hAab hAxi htop hA4 hGs hCinv hCd with hCT | hCT
        · exact C4Cover.c4_branch_CP_A2 hQ hAnQ hAab hGs hsq hA4 htop hcard hcent hCn hCinv
            hAC hCA hCT
        · -- ## `⁅C,⊤⁆ = A`: the radical `E := Erad h A`
          set E : Subgroup Q := Erad hQ A' with hEdef
          have hAEr : A' ≤ E := A_le_Erad (h := hQ) hAab hAxi hNA htop hA4 hCAd
          have hEn : Subgroup.Normal E := Erad_normal
          have hEinv : E.map (hQ.xi : MulAut Q).toMonoidHom = E := map_xi_Erad hAxi
          by_cases hEeq : E = A'
          · -- the residual `C₄` gap (`E = A`): this is exactly the configuration of
            -- `Work.Higman.H8.c4_gap_hard_false`
            have hC2eq : Work.Higman.powSub C' 2 = Work.Higman.powSub A' 2 :=
              powSub_C_eq_powSub_A_two hQ hAab hAxi htop hA4 hC2 hCinv hCAd hCd
            exact Work.Higman.H8.c4_gap_hard_false hQ ⟨hAnQ, hAxi, hAab⟩ hmax hNA hGs hsq hA4
              htop hcard hCn hCinv hAC hCA hcover hC2eq hCd hCAd hcent hCT
          · -- ## `A < E`: then `C ⊔ E = ⊤`, so `⁅⊤,⊤⁆ ≤ A²`
            have hEgt : A' < E := lt_of_le_of_ne hAEr (Ne.symm hEeq)
            have hnotle : ¬ E ≤ C' :=
              Erad_not_le_C_of_gt hQ hAab hAxi hNA htop hA4 hcard hCAd hcover hCT hEgt
            haveI : Subgroup.Normal (C' ⊔ E) := inferInstance
            have hsupinv : (C' ⊔ E).map (hQ.xi : MulAut Q).toMonoidHom = C' ⊔ E := by
              rw [Subgroup.map_sup, hCinv, hEinv]
            rcases hMcover (C' ⊔ E) inferInstance hsupinv le_sup_left le_top with hsup | hsup
            · exact hnotle ((le_sup_right : E ≤ C' ⊔ E).trans (le_of_eq hsup))
            · have hcc : ⁅(⊤ : Subgroup Q), (⊤ : Subgroup Q)⁆ ≤ Work.Higman.powSub A' 2 :=
                commutator_le_powSub_two_of_sup hQ hsup (le_of_eq hCd) (le_of_eq hEdef)
              rw [hGs] at hcc
              exact ne_powSub_two_of_card hQ htop hcard
                (le_antisymm hcc (Work.Higman.powSub_le (by norm_num)))
      · -- ## `M < ⊤`: descend to the Suzuki 2-group `↥M`
        exact htc_hard_two_cover_descent hQ hd (lt_of_le_of_ne le_top hMtop)
          (fun Q' hGQ' hFQ' hQ' A'' C'' M'' hAnQ' hlt hd' =>
            ih (Nat.card Q') (by rw [← hcardQ]; exact hlt) Q' hQ' A'' C'' M'' rfl hd')
  exact key (Nat.card P) P h A C M rfl
    ⟨hAxi, hAab, hmax, hNA, hGs, hsq, hA4, htop, hcard, hCn, hCinv, hAC, hCA, hcover,
      hC2, hCAd, hCd, hMn, hMinv, hCM, hCMne, hMcover, hMd⟩

/-- `hard_two_cover` from the bundled data. -/
private theorem hard_two_cover_of_data {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C M : Subgroup P} [hAn : A.Normal] (hd : HardTwoCoverData h A C M) : False := by
  obtain ⟨hAxi, hAab, hmax, hNA, hGs, hsq, hA4, htop, hcard, hCn, hCinv, hAC, hCA, hcover,
    hC2, hCAd, hCd, hMn, hMinv, hCM, hCMne, hMcover, hMd⟩ := hd
  exact hard_two_cover h hAxi hAab hmax hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA hcover
    hC2 hCAd hCd hMn hMinv hCM hCMne hMcover hMd

end Work.Higman.HS
end

-- ===== from Submission.Work.Commutator.two_cover_ce_pairing =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

open scoped commutatorElement

namespace Work.Commutator

/-- If `⁅a,x⁆` and `⁅a,y⁆` are central then `⁅a, x*y⁆ = ⁅a,y⁆ * ⁅a,x⁆`. -/
private lemma comm_mul_right_of_central {G : Type} [Group G] {a x y : G}
    (hx : ⁅a, x⁆ ∈ Subgroup.center G) (hy : ⁅a, y⁆ ∈ Subgroup.center G) :
    ⁅a, x * y⁆ = ⁅a, y⁆ * ⁅a, x⁆ := by
  have hxc : ∀ g : G, g * ⁅a, x⁆ = ⁅a, x⁆ * g := fun g => Subgroup.mem_center_iff.mp hx g
  have hyc : ∀ g : G, g * ⁅a, y⁆ = ⁅a, y⁆ * g := fun g => Subgroup.mem_center_iff.mp hy g
  calc ⁅a, x * y⁆ = ⁅a, x⁆ * x * ⁅a, y⁆ * x⁻¹ := commutatorElement_mul_right_eq_mul_conj a x y
    _ = ⁅a, x⁆ * (x * ⁅a, y⁆ * x⁻¹) := by group
    _ = ⁅a, x⁆ * ⁅a, y⁆ := by rw [show x * ⁅a, y⁆ * x⁻¹ = ⁅a, y⁆ by rw [hyc x]; group]
    _ = ⁅a, y⁆ * ⁅a, x⁆ := hyc ⁅a, x⁆

/-- **The radical of the two-cover commutator pairing is trivial on `X`.**

Let `P` be a Suzuki 2-group and `A ⊴ P` `ξ`-invariant with `A ^ (2) = Ω₁(P)`, `|A| = |Ω₁(P)|²`
and `[⊤,⊤] = A`.  Let `X, Y` be subgroups with `A ≤ X`, `[X,X] = [Y,Y] = [X,A] = [Y,A] = A ^ (2)`,
`X ⊔ Y = ⊤`, `X` normal `ξ`-invariant and minimal over `A` among normal `ξ`-invariant subgroups.
Then any `x ∈ X` whose commutators with all of `Y` lie in `A ^ (2)` already lies in `A`. -/
private theorem radical_of_cover {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A X Y : Subgroup P} [hAn : A.Normal]
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hXn : X.Normal) (hXinv : X.map (h.xi : MulAut P).toMonoidHom = X)
    (hAX : A ≤ X)
    (hXcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ X → D = A ∨ D = X)
    (hXd : Bracket.bracket X X = Work.Higman.powSub A 2)
    (hYd : Bracket.bracket Y Y = Work.Higman.powSub A 2)
    (hXAd : Bracket.bracket X A = Work.Higman.powSub A 2)
    (hYAd : Bracket.bracket Y A = Work.Higman.powSub A 2)
    (hXYsup : X ⊔ Y = ⊤) :
    ∀ x ∈ X, (∀ y ∈ Y, x * y * x⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2) → x ∈ A := by
  classical
  haveI : X.Normal := hXn
  -- `A ^ (2) = Ω₁(P)` is central
  have hZc : ∀ z : P, z ∈ Work.Higman.powSub A 2 → z ∈ Subgroup.center P := by
    intro z hz
    rw [htop] at hz
    exact h.omega1_le_center hz
  have hZcc : ∀ z ∈ Work.Higman.powSub A 2, ∀ g : P, g * z * g⁻¹ = z := by
    intro z hz g
    rw [Subgroup.mem_center_iff.mp (hZc z hz) g]
    group
  -- `P = X · Y`
  have hmem_sup : ∀ w : P, ∃ x ∈ X, ∃ y ∈ Y, x * y = w := fun w =>
    (Subgroup.mem_sup_of_normal_left (s := X) (t := Y)).mp (by
      rw [hXYsup]; exact Subgroup.mem_top w)
  -- commutators with `A` and with `X` land in `A ^ (2)`
  have hAX2 : ∀ a ∈ A, ∀ x ∈ X, ⁅a, x⁆ ∈ Work.Higman.powSub A 2 := by
    intro a ha x hx
    have hmem : ⁅a, x⁆ ∈ Bracket.bracket A X := Subgroup.commutator_mem_commutator ha hx
    rw [Subgroup.commutator_comm, hXAd] at hmem
    exact hmem
  have hAY2 : ∀ a ∈ A, ∀ y ∈ Y, ⁅a, y⁆ ∈ Work.Higman.powSub A 2 := by
    intro a ha y hy
    have hmem : ⁅a, y⁆ ∈ Bracket.bracket A Y := Subgroup.commutator_mem_commutator ha hy
    rw [Subgroup.commutator_comm, hYAd] at hmem
    exact hmem
  -- ## `A ≤ Erad h A`
  have hAEr : A ≤ Work.Higman.HS.Erad h A := by
    intro a ha
    rw [Work.Higman.HS.mem_Erad_iff]
    intro w
    obtain ⟨x, hx, y, hy, rfl⟩ := hmem_sup w
    have h1 : ⁅a, x⁆ ∈ Work.Higman.powSub A 2 := hAX2 a ha x hx
    have h2 : ⁅a, y⁆ ∈ Work.Higman.powSub A 2 := hAY2 a ha y hy
    have hgoal : ⁅a, x * y⁆ = ⁅a, y⁆ * ⁅a, x⁆ :=
      comm_mul_right_of_central (hZc _ h1) (hZc _ h2)
    rw [show a * (x * y) * a⁻¹ * (x * y)⁻¹ = ⁅a, x * y⁆ by rw [commutatorElement_def],
      hgoal]
    exact Subgroup.mul_mem _ h2 h1
  -- ## `X ≤ Erad h A` forces `Y ≤ Erad h A`
  have hYEr : X ≤ Work.Higman.HS.Erad h A → Y ≤ Work.Higman.HS.Erad h A := by
    intro hX
    intro y hy
    rw [Work.Higman.HS.mem_Erad_iff]
    intro w
    obtain ⟨x, hx, y', hy', rfl⟩ := hmem_sup w
    have h1 : ⁅y, y'⁆ ∈ Work.Higman.powSub A 2 := by
      have hmem : ⁅y, y'⁆ ∈ Bracket.bracket Y Y := Subgroup.commutator_mem_commutator hy hy'
      rwa [hYd] at hmem
    have h2 : ⁅y, x⁆ ∈ Work.Higman.powSub A 2 := by
      have hmem : ⁅x, y⁆ ∈ Work.Higman.powSub A 2 := by
        rw [commutatorElement_def]
        exact (Work.Higman.HS.mem_Erad_iff.mp (hX hx)) y
      rw [← commutatorElement_inv]
      exact Subgroup.inv_mem _ hmem
    have hgoal : ⁅y, x * y'⁆ = ⁅y, y'⁆ * ⁅y, x⁆ :=
      comm_mul_right_of_central (hZc _ h2) (hZc _ h1)
    rw [show y * (x * y') * y⁻¹ * (x * y')⁻¹ = ⁅y, x * y'⁆ by rw [commutatorElement_def],
      hgoal]
    exact Subgroup.mul_mem _ h1 h2
  -- ## `X ≰ Erad h A`
  have hnotle : ¬ (X ≤ Work.Higman.HS.Erad h A) := by
    intro hX
    have hY : Y ≤ Work.Higman.HS.Erad h A := hYEr hX
    have htop' : (⊤ : Subgroup P) ≤ Work.Higman.HS.Erad h A := by
      rw [← hXYsup]
      exact sup_le hX hY
    have hcc : Bracket.bracket (⊤ : Subgroup P) ⊤ ≤ Work.Higman.powSub A 2 := by
      rw [Subgroup.commutator_le]
      intro u _ v _
      have hh := (Work.Higman.HS.mem_Erad_iff.mp (htop' (Subgroup.mem_top v))) u
      rw [commutatorElement_def]
      rw [show u * v * u⁻¹ * v⁻¹ = (v * u * v⁻¹ * u⁻¹)⁻¹ by group]
      exact Subgroup.inv_mem _ hh
    rw [hGs] at hcc
    exact Work.Higman.HS.ne_powSub_two_of_card h htop hcard
      (le_antisymm hcc (Work.Higman.powSub_le (by norm_num)))
  -- ## `Erad h A ⊓ X = A`
  have hRinfX : Work.Higman.HS.Erad h A ⊓ X = A := by
    have hErinv : (Work.Higman.HS.Erad h A).map (h.xi : MulAut P).toMonoidHom
        = Work.Higman.HS.Erad h A := Work.Higman.HS.map_xi_Erad hAxi
    have hIinv : (Work.Higman.HS.Erad h A ⊓ X).map (h.xi : MulAut P).toMonoidHom
        = Work.Higman.HS.Erad h A ⊓ X := by
      rw [Subgroup.map_inf _ _ _ (h.xi : MulAut P).injective, hErinv, hXinv]
    haveI : (Work.Higman.HS.Erad h A ⊓ X).Normal :=
      ⟨fun n hn g => ⟨Work.Higman.HS.Erad_normal.conj_mem n hn.1 g, hXn.conj_mem n hn.2 g⟩⟩
    rcases hXcover (Work.Higman.HS.Erad h A ⊓ X) inferInstance hIinv (le_inf hAEr hAX)
      inf_le_right with hh | hh
    · exact hh
    · apply absurd _ hnotle
      rw [← hh]
      exact inf_le_left
  -- ## The radical statement
  intro x hx hcomm
  have hxR : x ∈ Work.Higman.HS.Erad h A := by
    rw [Work.Higman.HS.mem_Erad_iff]
    intro w
    obtain ⟨x', hx', y', hy', rfl⟩ := hmem_sup w
    have h1 : ⁅x, x'⁆ ∈ Work.Higman.powSub A 2 := by
      have hmem : ⁅x, x'⁆ ∈ Bracket.bracket X X := Subgroup.commutator_mem_commutator hx hx'
      rwa [hXd] at hmem
    have h2 : ⁅x, y'⁆ ∈ Work.Higman.powSub A 2 := by
      rw [commutatorElement_def]
      exact hcomm y' hy'
    have hgoal : ⁅x, x' * y'⁆ = ⁅x, y'⁆ * ⁅x, x'⁆ :=
      comm_mul_right_of_central (hZc _ h1) (hZc _ h2)
    rw [show x * (x' * y') * x⁻¹ * (x' * y')⁻¹ = ⁅x, x' * y'⁆ by
      rw [commutatorElement_def], hgoal]
    exact Subgroup.mul_mem _ h2 h1
  rw [← hRinfX]
  exact ⟨hxR, hx⟩

/-- The commutator pairing `C/A × E/A → A/A²` of the two-cover configuration. -/
private theorem two_cover_ce_pairing {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C E : Subgroup P} [hAn : A.Normal]
    [hN1 : ((Work.Higman.powSub A 2).subgroupOf A).Normal]
    [hN2 : (A.subgroupOf C).Normal] [hN3 : (A.subgroupOf E).Normal]
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hCn : C.Normal) (hEn : E.Normal)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hEinv : E.map (h.xi : MulAut P).toMonoidHom = E)
    (hAC : A ≤ C) (hAE : A ≤ E)
    (hCcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hEcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ E → D = A ∨ D = E)
    (hCd : Bracket.bracket C C = Work.Higman.powSub A 2)
    (hEd : Bracket.bracket E E = Work.Higman.powSub A 2)
    (hCAd : Bracket.bracket C A = Work.Higman.powSub A 2)
    (hEAd : Bracket.bracket E A = Work.Higman.powSub A 2)
    (hCE : C ⊓ E = A) (hCEsup : C ⊔ E = ⊤) :
    ∃ B : (↥C ⧸ (A.subgroupOf C)) → (↥E ⧸ (A.subgroupOf E)) →
        (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A),
      (∀ (c : ↥C) (e : ↥E) (a : ↥A),
        (a : P) = (c : P) * (e : P) * (c : P)⁻¹ * (e : P)⁻¹ →
        B (QuotientGroup.mk c) (QuotientGroup.mk e) = QuotientGroup.mk a) ∧
      (∀ x y z, B (x * y) z = B x z * B y z) ∧
      (∀ x y z, B x (y * z) = B x y * B x z) ∧
      (∀ x, x ≠ 1 → ∃ y, B x y ≠ 1) ∧
      (∀ y, y ≠ 1 → ∃ x, B x y ≠ 1) := by
  classical
  have hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := hA.abelian
  have hAxi : A.map (h.xi : MulAut P).toMonoidHom = A := hA.map_eq
  -- `A ^ (2) = Ω₁(P)` is central in `P`
  have hZc : ∀ z : P, z ∈ Work.Higman.powSub A 2 → z ∈ Subgroup.center P := by
    intro z hz
    rw [htop] at hz
    exact h.omega1_le_center hz
  -- `⁅C,E⁆ ≤ A`
  have hCEA : Bracket.bracket C E ≤ A :=
    (Subgroup.commutator_mono le_top le_top).trans (le_of_eq hGs)
  have hmemA : ∀ (c : P), c ∈ C → ∀ (e : P), e ∈ E → ⁅c, e⁆ ∈ A := by
    intro c hc e he
    exact hCEA (Subgroup.commutator_mem_commutator hc he)
  -- ## The value of the pairing on representatives
  let Φ : ↥C → ↥E → (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) :=
    fun c e => QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A)
  -- ## Two elements of `A` differing by an element of `A ^ (2)` have the same image
  have mk_eq_of_mul_inv : ∀ {x y : ↥A},
      ((x : P) * (y : P)⁻¹ ∈ Work.Higman.powSub A 2) →
      QuotientGroup.mk (s := (Work.Higman.powSub A 2).subgroupOf A) x
        = QuotientGroup.mk (s := (Work.Higman.powSub A 2).subgroupOf A) y := by
    intro x y hxy
    rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    have key : (x : P)⁻¹ * (y : P) = ((x : P) * (y : P)⁻¹)⁻¹ := by
      rw [mul_inv_rev, inv_inv]
      exact hAab _ (A.inv_mem x.2) _ y.2
    rw [key]
    exact Subgroup.inv_mem _ hxy
  -- ## `Φ` is invariant under multiplication by `A` in the first variable
  have hΦL : ∀ (c : ↥C) (a : ↥A) (e : ↥E),
      Φ (c * ⟨(a : P), hAC a.2⟩) e = Φ c e := by
    intro c a e
    have hfact : ⁅(c : P) * (a : P), (e : P)⁆ * (⁅(a : P), (e : P)⁆ * ⁅(c : P), (e : P)⁆)⁻¹
        ∈ Work.Higman.powSub A 2 :=
      Work.Higman.clo_comm_mul_left h hA hGs (Subgroup.mem_top _) (Subgroup.mem_top _)
        (Subgroup.mem_top _)
    have hae : ⁅(a : P), (e : P)⁆ ∈ Work.Higman.powSub A 2 := by
      rw [← commutatorElement_inv]
      exact Subgroup.inv_mem _ (Work.Higman.commutator_mem_powSub_two h hA (e : P) (a : P) a.2)
    have hae1 : (QuotientGroup.mk (⟨⁅(a : P), (e : P)⁆,
          hmemA (a : P) (hAC a.2) (e : P) e.2⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) = 1 := by
      rw [QuotientGroup.eq_one_iff]
      exact Subgroup.mem_subgroupOf.mpr hae
    have h1 : (QuotientGroup.mk (⟨⁅(c : P) * (a : P), (e : P)⁆,
          hmemA ((c : P) * (a : P)) (C.mul_mem c.2 (hAC a.2)) (e : P) e.2⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)
        = QuotientGroup.mk ((⟨⁅(a : P), (e : P)⁆, hmemA (a : P) (hAC a.2) (e : P) e.2⟩ : ↥A)
            * ⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩) := by
      apply mk_eq_of_mul_inv
      simpa [Subgroup.coe_mul, Subgroup.coe_inv] using hfact
    calc Φ (c * ⟨(a : P), hAC a.2⟩) e
        = QuotientGroup.mk (⟨⁅(c : P) * (a : P), (e : P)⁆,
            hmemA ((c : P) * (a : P)) (C.mul_mem c.2 (hAC a.2)) (e : P) e.2⟩ : ↥A) := rfl
      _ = QuotientGroup.mk ((⟨⁅(a : P), (e : P)⁆, hmemA (a : P) (hAC a.2) (e : P) e.2⟩ : ↥A)
            * ⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩) := h1
      _ = QuotientGroup.mk (⟨⁅(a : P), (e : P)⁆, hmemA (a : P) (hAC a.2) (e : P) e.2⟩ : ↥A)
            * QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) :=
          QuotientGroup.mk_mul _ _ _
      _ = 1 * QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) := by
          rw [hae1]
      _ = QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) :=
          one_mul _
      _ = Φ c e := rfl
  -- ## `Φ` is invariant under multiplication by `A` in the second variable
  have hΦR : ∀ (c : ↥C) (e : ↥E) (a : ↥A),
      Φ c (e * ⟨(a : P), hAE a.2⟩) = Φ c e := by
    intro c e a
    have hfact : ⁅(c : P), (e : P) * (a : P)⁆ * (⁅(c : P), (e : P)⁆ * ⁅(c : P), (a : P)⁆)⁻¹
        ∈ Work.Higman.powSub A 2 :=
      Work.Higman.clo_comm_mul_right h hA hGs (Subgroup.mem_top _) (Subgroup.mem_top _)
        (Subgroup.mem_top _)
    have hca : ⁅(c : P), (a : P)⁆ ∈ Work.Higman.powSub A 2 :=
      Work.Higman.commutator_mem_powSub_two h hA (c : P) (a : P) a.2
    have hca1 : (QuotientGroup.mk (⟨⁅(c : P), (a : P)⁆,
          hmemA (c : P) c.2 (a : P) (hAE a.2)⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) = 1 := by
      rw [QuotientGroup.eq_one_iff]
      exact Subgroup.mem_subgroupOf.mpr hca
    have h1 : (QuotientGroup.mk (⟨⁅(c : P), (e : P) * (a : P)⁆,
          hmemA (c : P) c.2 ((e : P) * (a : P)) (E.mul_mem e.2 (hAE a.2))⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)
        = QuotientGroup.mk ((⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A)
            * ⟨⁅(c : P), (a : P)⁆, hmemA (c : P) c.2 (a : P) (hAE a.2)⟩) := by
      apply mk_eq_of_mul_inv
      simpa [Subgroup.coe_mul, Subgroup.coe_inv] using hfact
    calc Φ c (e * ⟨(a : P), hAE a.2⟩)
        = QuotientGroup.mk (⟨⁅(c : P), (e : P) * (a : P)⁆,
            hmemA (c : P) c.2 ((e : P) * (a : P)) (E.mul_mem e.2 (hAE a.2))⟩ : ↥A) := rfl
      _ = QuotientGroup.mk ((⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A)
            * ⟨⁅(c : P), (a : P)⁆, hmemA (c : P) c.2 (a : P) (hAE a.2)⟩) := h1
      _ = QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A)
            * QuotientGroup.mk (⟨⁅(c : P), (a : P)⁆, hmemA (c : P) c.2 (a : P) (hAE a.2)⟩ : ↥A) :=
          QuotientGroup.mk_mul _ _ _
      _ = QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) * 1 := by
          rw [hca1]
      _ = QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) :=
          mul_one _
      _ = Φ c e := rfl
  -- ## Additivity of `Φ` in the first variable
  have hΦAL : ∀ (c₁ c₂ : ↥C) (e : ↥E), Φ (c₁ * c₂) e = Φ c₁ e * Φ c₂ e := by
    intro c₁ c₂ e
    have hfact : ⁅(c₁ : P) * (c₂ : P), (e : P)⁆ *
          (⁅(c₂ : P), (e : P)⁆ * ⁅(c₁ : P), (e : P)⁆)⁻¹ ∈ Work.Higman.powSub A 2 :=
      Work.Higman.clo_comm_mul_left h hA hGs (Subgroup.mem_top _) (Subgroup.mem_top _)
        (Subgroup.mem_top _)
    have h1 : (QuotientGroup.mk (⟨⁅(c₁ : P) * (c₂ : P), (e : P)⁆,
          hmemA ((c₁ : P) * (c₂ : P)) (C.mul_mem c₁.2 c₂.2) (e : P) e.2⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)
        = QuotientGroup.mk ((⟨⁅(c₂ : P), (e : P)⁆, hmemA (c₂ : P) c₂.2 (e : P) e.2⟩ : ↥A)
            * ⟨⁅(c₁ : P), (e : P)⁆, hmemA (c₁ : P) c₁.2 (e : P) e.2⟩) := by
      apply mk_eq_of_mul_inv
      simpa [Subgroup.coe_mul, Subgroup.coe_inv] using hfact
    have hswap : (QuotientGroup.mk (⟨⁅(c₂ : P), (e : P)⁆, hmemA (c₂ : P) c₂.2 (e : P) e.2⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)
          * QuotientGroup.mk (⟨⁅(c₁ : P), (e : P)⁆, hmemA (c₁ : P) c₁.2 (e : P) e.2⟩ : ↥A)
        = QuotientGroup.mk (⟨⁅(c₁ : P), (e : P)⁆, hmemA (c₁ : P) c₁.2 (e : P) e.2⟩ : ↥A)
          * QuotientGroup.mk (⟨⁅(c₂ : P), (e : P)⁆, hmemA (c₂ : P) c₂.2 (e : P) e.2⟩ : ↥A) := by
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
      congr 1
      exact Subtype.ext (hAab _ (hmemA (c₂ : P) c₂.2 (e : P) e.2) _
        (hmemA (c₁ : P) c₁.2 (e : P) e.2))
    calc Φ (c₁ * c₂) e
        = QuotientGroup.mk (⟨⁅(c₁ : P) * (c₂ : P), (e : P)⁆,
            hmemA ((c₁ : P) * (c₂ : P)) (C.mul_mem c₁.2 c₂.2) (e : P) e.2⟩ : ↥A) := rfl
      _ = QuotientGroup.mk ((⟨⁅(c₂ : P), (e : P)⁆, hmemA (c₂ : P) c₂.2 (e : P) e.2⟩ : ↥A)
            * ⟨⁅(c₁ : P), (e : P)⁆, hmemA (c₁ : P) c₁.2 (e : P) e.2⟩) := h1
      _ = QuotientGroup.mk (⟨⁅(c₂ : P), (e : P)⁆, hmemA (c₂ : P) c₂.2 (e : P) e.2⟩ : ↥A)
            * QuotientGroup.mk (⟨⁅(c₁ : P), (e : P)⁆, hmemA (c₁ : P) c₁.2 (e : P) e.2⟩ : ↥A) :=
          QuotientGroup.mk_mul _ _ _
      _ = QuotientGroup.mk (⟨⁅(c₁ : P), (e : P)⁆, hmemA (c₁ : P) c₁.2 (e : P) e.2⟩ : ↥A)
            * QuotientGroup.mk (⟨⁅(c₂ : P), (e : P)⁆, hmemA (c₂ : P) c₂.2 (e : P) e.2⟩ : ↥A) :=
          hswap
      _ = Φ c₁ e * Φ c₂ e := rfl
  -- ## Additivity of `Φ` in the second variable
  have hΦAR : ∀ (c : ↥C) (e₁ e₂ : ↥E), Φ c (e₁ * e₂) = Φ c e₁ * Φ c e₂ := by
    intro c e₁ e₂
    have hfact : ⁅(c : P), (e₁ : P) * (e₂ : P)⁆ *
          (⁅(c : P), (e₁ : P)⁆ * ⁅(c : P), (e₂ : P)⁆)⁻¹ ∈ Work.Higman.powSub A 2 :=
      Work.Higman.clo_comm_mul_right h hA hGs (Subgroup.mem_top _) (Subgroup.mem_top _)
        (Subgroup.mem_top _)
    have h1 : (QuotientGroup.mk (⟨⁅(c : P), (e₁ : P) * (e₂ : P)⁆,
          hmemA (c : P) c.2 ((e₁ : P) * (e₂ : P)) (E.mul_mem e₁.2 e₂.2)⟩ : ↥A)
        : ↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A)
        = QuotientGroup.mk ((⟨⁅(c : P), (e₁ : P)⁆, hmemA (c : P) c.2 (e₁ : P) e₁.2⟩ : ↥A)
            * ⟨⁅(c : P), (e₂ : P)⁆, hmemA (c : P) c.2 (e₂ : P) e₂.2⟩) := by
      apply mk_eq_of_mul_inv
      simpa [Subgroup.coe_mul, Subgroup.coe_inv] using hfact
    calc Φ c (e₁ * e₂)
        = QuotientGroup.mk (⟨⁅(c : P), (e₁ : P) * (e₂ : P)⁆,
            hmemA (c : P) c.2 ((e₁ : P) * (e₂ : P)) (E.mul_mem e₁.2 e₂.2)⟩ : ↥A) := rfl
      _ = QuotientGroup.mk ((⟨⁅(c : P), (e₁ : P)⁆, hmemA (c : P) c.2 (e₁ : P) e₁.2⟩ : ↥A)
            * ⟨⁅(c : P), (e₂ : P)⁆, hmemA (c : P) c.2 (e₂ : P) e₂.2⟩) := h1
      _ = QuotientGroup.mk (⟨⁅(c : P), (e₁ : P)⁆, hmemA (c : P) c.2 (e₁ : P) e₁.2⟩ : ↥A)
            * QuotientGroup.mk (⟨⁅(c : P), (e₂ : P)⁆, hmemA (c : P) c.2 (e₂ : P) e₂.2⟩ : ↥A) :=
          QuotientGroup.mk_mul _ _ _
      _ = Φ c e₁ * Φ c e₂ := rfl
  -- ## Descent to the quotient in the second variable
  have wdR : ∀ (c : ↥C) (e₁ e₂ : ↥E),
      QuotientGroup.leftRel (A.subgroupOf E) e₁ e₂ → Φ c e₁ = Φ c e₂ := by
    intro c e₁ e₂ hrel
    have hz : (e₁ : P)⁻¹ * (e₂ : P) ∈ A :=
      Subgroup.mem_subgroupOf.mp (QuotientGroup.leftRel_apply.mp hrel)
    have heq : (e₂ : P) = (e₁ : P) * ((e₁ : P)⁻¹ * (e₂ : P)) := by group
    have he2 : e₂ = e₁ * ⟨(e₁ : P)⁻¹ * (e₂ : P), hAE hz⟩ := Subtype.ext heq
    rw [he2]
    exact (hΦR c e₁ ⟨(e₁ : P)⁻¹ * (e₂ : P), hz⟩).symm
  -- ## Descent to the quotient in the first variable
  have wdL : ∀ (c₁ c₂ : ↥C), QuotientGroup.leftRel (A.subgroupOf C) c₁ c₂ →
      (fun y : ↥E ⧸ (A.subgroupOf E) => Quotient.liftOn y (Φ c₁) (wdR c₁))
        = (fun y : ↥E ⧸ (A.subgroupOf E) => Quotient.liftOn y (Φ c₂) (wdR c₂)) := by
    intro c₁ c₂ hrel
    have hz : (c₁ : P)⁻¹ * (c₂ : P) ∈ A :=
      Subgroup.mem_subgroupOf.mp (QuotientGroup.leftRel_apply.mp hrel)
    have heq : (c₂ : P) = (c₁ : P) * ((c₁ : P)⁻¹ * (c₂ : P)) := by group
    have hc2 : c₂ = c₁ * ⟨(c₁ : P)⁻¹ * (c₂ : P), hAC hz⟩ := Subtype.ext heq
    funext y
    induction y using QuotientGroup.induction_on with
    | _ e =>
      show Φ c₁ e = Φ c₂ e
      rw [hc2]
      exact (hΦL c₁ ⟨(c₁ : P)⁻¹ * (c₂ : P), hz⟩ e).symm
  -- ## The pairing
  let B : (↥C ⧸ (A.subgroupOf C)) → (↥E ⧸ (A.subgroupOf E)) →
      (↥A ⧸ (Work.Higman.powSub A 2).subgroupOf A) :=
    fun x => Quotient.liftOn x (fun c : ↥C => fun y => Quotient.liftOn y (Φ c) (wdR c)) wdL
  have hBdef : ∀ (c : ↥C) (e : ↥E), B (QuotientGroup.mk c) (QuotientGroup.mk e) = Φ c e :=
    fun c e => rfl
  -- ## The two radicals
  have radC : ∀ x ∈ C, (∀ y ∈ E, x * y * x⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2) → x ∈ A :=
    radical_of_cover h hAxi hGs htop hcard hCn hCinv hAC hCcover hCd hEd hCAd hEAd hCEsup
  have radE : ∀ x ∈ E, (∀ y ∈ C, x * y * x⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2) → x ∈ A :=
    radical_of_cover h hAxi hGs htop hcard hEn hEinv hAE hEcover hEd hCd hEAd hCAd
      (by rw [sup_comm]; exact hCEsup)
  refine ⟨B, ?_, ?_, ?_, ?_, ?_⟩
  · -- the values of `B` are the commutators
    intro c e a ha
    rw [hBdef]
    rw [show Φ c e = QuotientGroup.mk (⟨⁅(c : P), (e : P)⁆,
      hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) from rfl]
    rw [show (⟨⁅(c : P), (e : P)⁆, hmemA (c : P) c.2 (e : P) e.2⟩ : ↥A) = a from
      Subtype.ext (by
        show (c : P) * (e : P) * (c : P)⁻¹ * (e : P)⁻¹ = (a : P)
        exact ha.symm)]
  · -- additivity in the first variable
    intro x
    induction x using QuotientGroup.induction_on with
    | _ c₁ =>
      intro y
      induction y using QuotientGroup.induction_on with
      | _ c₂ =>
        intro z
        induction z using QuotientGroup.induction_on with
        | _ e =>
          rw [← QuotientGroup.mk_mul, hBdef, hBdef, hBdef]
          exact hΦAL c₁ c₂ e
  · -- additivity in the second variable
    intro x
    induction x using QuotientGroup.induction_on with
    | _ c =>
      intro y
      induction y using QuotientGroup.induction_on with
      | _ e₁ =>
        intro z
        induction z using QuotientGroup.induction_on with
        | _ e₂ =>
          rw [← QuotientGroup.mk_mul, hBdef, hBdef, hBdef]
          exact hΦAR c e₁ e₂
  · -- non-degeneracy in the first variable
    intro x hx
    obtain ⟨c, rfl⟩ := QuotientGroup.mk_surjective x
    have hcA : (c : P) ∉ A := by
      intro hc
      refine hx ?_
      rw [QuotientGroup.eq_one_iff]
      exact Subgroup.mem_subgroupOf.mpr hc
    have hnc : ¬ (∀ y ∈ E, (c : P) * y * (c : P)⁻¹ * y⁻¹ ∈ Work.Higman.powSub A 2) := by
      intro hall
      exact hcA (radC (c : P) c.2 hall)
    push_neg at hnc
    obtain ⟨y, hy, hyne⟩ := hnc
    refine ⟨QuotientGroup.mk (⟨y, hy⟩ : ↥E), ?_⟩
    rw [hBdef]
    intro hcon
    have hmem : (⟨⁅(c : P), y⁆, hmemA (c : P) c.2 y hy⟩ : ↥A)
        ∈ (Work.Higman.powSub A 2).subgroupOf A := by
      rw [← QuotientGroup.eq_one_iff]
      exact hcon
    have hA2 : ⁅(c : P), y⁆ ∈ Work.Higman.powSub A 2 := Subgroup.mem_subgroupOf.mp hmem
    exact hyne (by rwa [commutatorElement_def] at hA2)
  · -- non-degeneracy in the second variable
    intro y hy
    obtain ⟨e, rfl⟩ := QuotientGroup.mk_surjective y
    have heA : (e : P) ∉ A := by
      intro he
      refine hy ?_
      rw [QuotientGroup.eq_one_iff]
      exact Subgroup.mem_subgroupOf.mpr he
    have hnc : ¬ (∀ x ∈ C, (e : P) * x * (e : P)⁻¹ * x⁻¹ ∈ Work.Higman.powSub A 2) := by
      intro hall
      exact heA (radE (e : P) e.2 hall)
    push_neg at hnc
    obtain ⟨x, hx, hxne⟩ := hnc
    refine ⟨QuotientGroup.mk (⟨x, hx⟩ : ↥C), ?_⟩
    rw [hBdef]
    intro hcon
    have hmem : (⟨⁅(x : P), (e : P)⁆, hmemA (x : P) hx (e : P) e.2⟩ : ↥A)
        ∈ (Work.Higman.powSub A 2).subgroupOf A := by
      rw [← QuotientGroup.eq_one_iff]
      exact hcon
    have hA2 : ⁅(x : P), (e : P)⁆ ∈ Work.Higman.powSub A 2 := Subgroup.mem_subgroupOf.mp hmem
    have hne : ⁅(e : P), (x : P)⁆ ∉ Work.Higman.powSub A 2 := by
      intro hh
      exact hxne (by
        rw [show (e : P) * x * (e : P)⁻¹ * x⁻¹ = ⁅(e : P), (x : P)⁆ by
          rw [commutatorElement_def]]
        exact hh)
    exact hne (by
      rw [← commutatorElement_inv]
      exact Subgroup.inv_mem _ hA2)

end Work.Commutator
end

