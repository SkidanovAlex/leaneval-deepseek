    have hOmF : Work.Higman.omega1 P ≤ C ⊔ E := hNA.trans (hAC.trans le_sup_left)
    have hFcard_gt : (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 < Nat.card ↥(C ⊔ E) := by
      have h1 : C < C ⊔ E := lt_of_le_of_ne le_sup_left (fun hEq => hEAne (le_antisymm
