  have hEcard3 : Nat.card ↥E = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 :=
    Work.Higman.C4Cover.c4_cover_card_eq_cube h hAab hNA hGs hsq htop hcard hEn hEinv
