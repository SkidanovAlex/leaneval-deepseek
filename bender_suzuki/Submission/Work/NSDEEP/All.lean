    · exact absurd hb hCE_ge'
    · exact Or.inl h2
    · exact Or.inr h3
  -- ## Step 9: `C ⊔ E = ⊤`
  have hCsupE : C ⊔ E = ⊤ := by
    by_contra hne
    have hFlt : C ⊔ E < ⊤ := lt_top_iff_ne_top.mpr hne
    have hFinv : (C ⊔ E).map (h.xi : MulAut P).toMonoidHom = C ⊔ E := by
