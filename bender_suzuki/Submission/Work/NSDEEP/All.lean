        have hsqce : ∀ c ∈ C, ∀ e ∈ E, (c * e) ^ 2 = ⁅e, c⁆ * c ^ 2 * e ^ 2 := by
          intro c hc e he
          have hmem : ⁅e, c⁆ ∈ Work.Higman.powSub A 2 := by
            have h1 : ⁅e, c⁆ ∈ ⁅E, C⁆ := Subgroup.commutator_mem_commutator he hc
            rw [Subgroup.commutator_comm E C] at h1
            rwa [hCE2] at h1
