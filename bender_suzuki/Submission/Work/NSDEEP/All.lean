        have hDbar_xi : (D.map (C ⊔ E).subtype).map (h.xi : MulAut P).toMonoidHom
            = D.map (C ⊔ E).subtype := by
          rw [Work.Higman.HS.htc_map_xi_map_subtype h hFinv D, hDinv']
        have hDbar_n : (D.map (C ⊔ E).subtype).Normal := by
          refine Work.Higman.HS.htc_normal_of_commutator_le ?_
          calc ⁅(⊤ : Subgroup P), ⊤⁆ = A := hGs
            _ = (A.subgroupOf (C ⊔ E)).map (C ⊔ E).subtype :=
                (Work.Higman.HS.htc_map_subtype_subgroupOf_eq hAF).symm
            _ ≤ D.map (C ⊔ E).subtype := Subgroup.map_mono hAD'
        have hDbar_le_C : D.map (C ⊔ E).subtype ≤ C := by
          calc D.map (C ⊔ E).subtype ≤ (C.subgroupOf (C ⊔ E)).map (C ⊔ E).subtype :=
                Subgroup.map_mono hDC'
            _ = C := Work.Higman.HS.htc_map_subtype_subgroupOf_eq le_sup_left
        have hADbar : A ≤ D.map (C ⊔ E).subtype := by
          calc A = (A.subgroupOf (C ⊔ E)).map (C ⊔ E).subtype :=
                (Work.Higman.HS.htc_map_subtype_subgroupOf_eq hAF).symm
            _ ≤ D.map (C ⊔ E).subtype := Subgroup.map_mono hAD'
        rcases hcover (D.map (C ⊔ E).subtype) hDbar_n hDbar_xi hADbar hDbar_le_C with h | h
        · left
          have h2 := congrArg (fun X : Subgroup P => X.subgroupOf (C ⊔ E)) h
          rwa [Work.Higman.HS.htc_subgroupOf_map_subtype_eq D] at h2
        · right
          have h2 := congrArg (fun X : Subgroup P => X.subgroupOf (C ⊔ E)) h
          rwa [Work.Higman.HS.htc_subgroupOf_map_subtype_eq D] at h2
      have hCpow2' : Work.Higman.powSub (C.subgroupOf (C ⊔ E)) 2
          = Work.Higman.powSub (A.subgroupOf (C ⊔ E)) 2 := by
        apply Subgroup.map_injective (Subgroup.subtype_injective (C ⊔ E))
        rw [hkey C le_sup_left 2, hkey A hAF 2, hCpow2]
      have hCd' : ⁅C.subgroupOf (C ⊔ E), C.subgroupOf (C ⊔ E)⁆
          = Work.Higman.powSub (A.subgroupOf (C ⊔ E)) 2 := by
        apply Subgroup.map_injective (Subgroup.subtype_injective (C ⊔ E))
        rw [Subgroup.map_commutator,
          Work.Higman.HS.htc_map_subtype_subgroupOf_eq le_sup_left, hCd,
          Work.Higman.HS.htc_powSub_subgroupOf_eq hAF hAab 2,
          Work.Higman.HS.htc_map_subtype_subgroupOf_eq (hA2le.trans hAF)]
      have hCT' : ⁅C.subgroupOf (C ⊔ E), (⊤ : Subgroup ↥(C ⊔ E))⁆
          = A.subgroupOf (C ⊔ E) := by
        apply Subgroup.map_injective (Subgroup.subtype_injective (C ⊔ E))
        rw [Subgroup.map_commutator,
          Work.Higman.HS.htc_map_subtype_subgroupOf_eq le_sup_left,
          Work.Higman.HS.htc_map_subtype_top,
          Work.Higman.HS.htc_map_subtype_subgroupOf_eq hAF]
        rw [show ⁅C, C ⊔ E⁆ = A from by
          rw [Subgroup.commutator_sup_left C C E, hCd, hCE1, sup_eq_right.mpr hA2le]]
      exact hsmall hF hFlt_card (A.subgroupOf (C ⊔ E)) (C.subgroupOf (C ⊔ E)) hA' hNA' hGs''
        hsq' hA4' htop' hcard' hCn' hCinv' hAC' hCA' hcover' hCpow2' hCd' hCT'
  -- ## Step 10: `[C,E] = A`
  have hCEeq : ⁅C, E⁆ = A := by
    rcases hCEdich with h | h
    · exfalso
      have h1 : A ≤ Work.Higman.powSub A 2 ⊔ ⁅C, E⁆ := by
        have h2 : ⁅C ⊔ E, C ⊔ E⁆ ≤ Work.Higman.powSub A 2 ⊔ ⁅C, E⁆ := by
          rw [Subgroup.commutator_sup_right C E (C ⊔ E),
            Subgroup.commutator_sup_left C C E, Subgroup.commutator_sup_left E C E,
            hCd, Subgroup.commutator_comm E C, hEE]
          exact sup_le (sup_le le_sup_left le_sup_right) (sup_le le_sup_right le_sup_left)
        calc A = ⁅(⊤ : Subgroup P), ⊤⁆ := hGs.symm
          _ = ⁅C ⊔ E, C ⊔ E⁆ := by rw [hCsupE]
          _ ≤ Work.Higman.powSub A 2 ⊔ ⁅C, E⁆ := h2
      rw [h, sup_idem] at h1
      exact hAne2 (le_antisymm h1 hA2le)
    · exact h
  -- ## Step 11: `[E,A] = A²`
  have hEAeq : ⁅E, A⁆ = Work.Higman.powSub A 2 := by
    have hEA_le : ⁅E, A⁆ ≤ Work.Higman.powSub A 2 := by
      calc ⁅E, A⁆ ≤ ⁅E, E⁆ := Subgroup.commutator_mono le_rfl hAE
        _ = Work.Higman.powSub A 2 := hEE
    have hEA_inv : (⁅E, A⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅E, A⁆ := by
      rw [Subgroup.map_commutator, hEinv, hAxi]
    have hEA_ne : ⁅E, A⁆ ≠ ⊥ := by
      intro hb
      have hle : E ≤ A := by
        rw [← hcent]
        intro e he
        rw [Subgroup.mem_centralizer_iff]
        intro a ha
        have h1 : ⁅e, a⁆ ∈ (⊥ : Subgroup P) := by
          rw [← hb]
          exact Subgroup.commutator_mem_commutator he ha
        exact (commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h1)).symm
      exact hEAne (le_antisymm hle hAE)
    have h1 : ⁅E, A⁆ = Work.Higman.omega1 P :=
      Work.Higman.HS.eq_omega1_of_ne_bot_of_map_eq h (hEA_le.trans (le_of_eq htop))
        hEA_inv hEA_ne
    rw [h1, ← htop]
  exact ⟨E, hEn, hEinv, hAE, hEAne.symm, hEcover, hCEinf, hCsupE, hE2, hEE, hEAeq, hCEeq⟩

end Work.Higman.NSM
end

-- ===== from Submission.Work.Higman.NSM.two_cover_endgame =====
section
/-
# The two-cover endgame of the `C₄` exclusion

This module proves `Work.Higman.NSM.two_cover_endgame`: in the *two-cover configuration* of
Higman's Theorem 1 (a Suzuki 2-group `P` with `A` satisfying the `C₄`-data — `A` `ξ`-invariant
abelian normal, `Ω₁(P) ≤ A`, `[P,P] = A`, all squares in `A`, `A⁴ = 1`, `A² = Ω₁(P)`,
`|A| = |Ω₁(P)|²`, `C_P(A) = A` — and two `ξ`-invariant normal subgroups `C, E > A` with
`C ⊓ E = A`, `C ⊔ E = ⊤`, `[C,C] = [E,E] = A²`, `C² = E² = A²`, `[C,A] = [E,A] = A²`) there is a
contradiction.

The mathematical content is the classical *two-cover endgame* of the `C₄` case.  The commutator
pairings `B : C/A × E/A → A/A²` and `Φ : A/A² × C/A → A²` are `ξ`-equivariant and perfect, and
the group identities `⟦⟦c,e⟧,c⟧ = ⟦c,e⟧²`, `⟦⟦c,e⟧,e⟧ = ⟦c,e⟧²`, `⟦⟦c,e⟧,c'⟧ = ⟦⟦c',e⟧,c⟧`
(valid because `c²`, `e²` lie in the central subgroup `A² = Ω₁(P)`) turn into the *diagonal* and
*Jacobi* relations for `Φ` and `B`.  Together with the Frobenius (eigenvalue) bookkeeping of the
Singer identifications of the irreducible `𝔽₂⟨ξ⟩`-modules `C/A`, `E/A`, `A/A²`, `A²` this is
impossible (the algebraic endgame is `Work.Higman.RedAux.two_cover_algebraic_core`).
-/


namespace Work.Higman.NSM

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-- If `x ^ 2` commutes with `y` then `x` conjugates the commutator `⟦x,y⟧` to its inverse;
equivalently `⟦x, ⟦x,y⟧⟧ = (⟦x,y⟧ ^ 2)⁻¹`. -/
private theorem commutatorElement_diag_aux {G : Type} [Group G] (x y : G)
    (h : x ^ 2 * y = y * x ^ 2) :
    ⁅x, ⁅x, y⁆⁆ = (⁅x, y⁆ ^ 2)⁻¹ := by
  have h1 : ⁅x ^ 2, y⁆ = 1 := commutatorElement_eq_one_iff_mul_comm.mpr h
  have h2 := Work.Higman.commutatorElement_sq x y
  rw [h1] at h2
  exact eq_inv_of_mul_eq_one_left h2.symm

/-- If `x ^ 2` commutes with `y` then `⟦⟦x,y⟧, x⟧ = ⟦x,y⟧ ^ 2`. -/
private theorem commutatorElement_diag {G : Type} [Group G] (x y : G)
    (h : x ^ 2 * y = y * x ^ 2) :
    ⁅⁅x, y⁆, x⁆ = ⁅x, y⁆ ^ 2 := by
  have h1 := commutatorElement_diag_aux x y h
  calc ⁅⁅x, y⁆, x⁆ = ⁅x, ⁅x, y⁆⁆⁻¹ := (commutatorElement_inv x ⁅x, y⁆).symm
    _ = ((⁅x, y⁆ ^ 2)⁻¹)⁻¹ := by rw [h1]
    _ = ⁅x, y⁆ ^ 2 := inv_inv _

/-- For `t` in a normal abelian subgroup, `⟦t⁻¹, y⟧ = ⟦t, y⟧⁻¹`. -/
private theorem commutatorElement_inv_left_mem {G : Type} [Group G] {A : Subgroup G}
    (hAn : A.Normal) (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    {t y : G} (ht : t ∈ A) : ⁅t⁻¹, y⁆ = ⁅t, y⁆⁻¹ := by
  have h := Work.Higman.commutatorElement_mul_of_abel_normal hAn hAab (A.inv_mem ht) ht
    (C := ⊤) (Subgroup.mem_top y)
  rw [inv_mul_cancel] at h
  have h1 : ⁅(1 : G), y⁆ = 1 := by rw [commutatorElement_def]; group
  rw [h1] at h
  exact eq_inv_of_mul_eq_one_left h.symm

/-- **The group-theoretic facts of the two-cover configuration.** -/
private theorem two_cover_group_facts (h : Work.Higman.IsSuzuki2Grp P)
    {A C E : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hEn : E.Normal)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hEinv : E.map (h.xi : MulAut P).toMonoidHom = E)
    (hAC : A ≤ C) (hAE : A ≤ E) (hCA : A ≠ C) (hEA : A ≠ E)
    (hCcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hEcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ E → D = A ∨ D = E)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) (hEd : ⁅E, E⁆ = Work.Higman.powSub A 2)
    (hCpow2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hEpow2 : Work.Higman.powSub E 2 = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) (hEAd : ⁅E, A⁆ = Work.Higman.powSub A 2)
    (hCE : C ⊓ E = A) (hCEsup : C ⊔ E = ⊤) :
    (∀ c ∈ C, c ^ 2 ∈ Work.Higman.powSub A 2) ∧
    (∀ e ∈ E, e ^ 2 ∈ Work.Higman.powSub A 2) ∧
    (∀ c ∈ C, ∀ e ∈ E, c * e * c⁻¹ * e⁻¹ ∈ A) ∧
    (∀ c ∈ C, ∀ e ∈ E,
      (c * e * c⁻¹ * e⁻¹) * c * (c * e * c⁻¹ * e⁻¹)⁻¹ * c⁻¹ = (c * e * c⁻¹ * e⁻¹) ^ 2) ∧
    (∀ c ∈ C, ∀ e ∈ E,
      (c * e * c⁻¹ * e⁻¹) * e * (c * e * c⁻¹ * e⁻¹)⁻¹ * e⁻¹ = (c * e * c⁻¹ * e⁻¹) ^ 2) ∧
    (∀ c ∈ C, ∀ c' ∈ C, ∀ e ∈ E,
      (c * e * c⁻¹ * e⁻¹) * c' * (c * e * c⁻¹ * e⁻¹)⁻¹ * c'⁻¹ =
        (c' * e * c'⁻¹ * e⁻¹) * c * (c' * e * c'⁻¹ * e⁻¹)⁻¹ * c⁻¹) ∧
    (∃ c ∈ C, ∃ e ∈ E, c * e * c⁻¹ * e⁻¹ ∉ Work.Higman.powSub A 2) := by
  haveI hAn : A.Normal := hA.normal
  have hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := hA.abelian
  -- `A ^ (2) = Ω₁(P)` is central
  have hA2central : ∀ a ∈ Work.Higman.powSub A 2, a ∈ Subgroup.center P := by
    intro a ha
    rw [htop] at ha
    exact h.omega1_le_center ha
  -- `A ≠ A ^ (2)`
  have hAne2 : A ≠ Work.Higman.powSub A 2 := by
    intro heq
    have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.omega1 P) := by rw [heq, htop]
    have h3 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
    have h4 : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
      rw [← hcard, h1]
    nlinarith [h3, h4]
  -- every commutator `⟦c,e⟧` lies in `A = C ⊓ E`
  have hcomm_mem : ∀ c ∈ C, ∀ e ∈ E, c * e * c⁻¹ * e⁻¹ ∈ A := by
    intro c hc e he
    rw [← hCE, Subgroup.mem_inf]
    exact ⟨by simpa only [mul_assoc] using C.mul_mem hc (hCn.conj_mem c⁻¹ (C.inv_mem hc) e),
      E.mul_mem (hEn.conj_mem e he c) (E.inv_mem he)⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro c hc
    rw [← hCpow2]
    exact Work.Higman.pow_mem_powSub hc
  · intro e he
    rw [← hEpow2]
    exact Work.Higman.pow_mem_powSub he
  · intro c hc e he
    exact hcomm_mem c hc e he
  · intro c hc e he
    have hc2 : c ^ 2 ∈ Work.Higman.powSub A 2 := by
      rw [← hCpow2]; exact Work.Higman.pow_mem_powSub hc
    have hce2 : c ^ 2 * e = e * c ^ 2 :=
      (Subgroup.mem_center_iff.mp (hA2central _ hc2) e).symm
    have hd := commutatorElement_diag c e hce2
    simpa only [commutatorElement_def] using hd
  · intro c hc e he
    have he2 : e ^ 2 ∈ Work.Higman.powSub A 2 := by
      rw [← hEpow2]; exact Work.Higman.pow_mem_powSub he
    have hec2 : e ^ 2 * c = c * e ^ 2 :=
      (Subgroup.mem_center_iff.mp (hA2central _ he2) c).symm
    have htA : ⁅c, e⁆ ∈ A := by
      have := hcomm_mem c hc e he
      simpa only [commutatorElement_def] using this
    have hte : ⁅⁅c, e⁆, e⁆ = ⁅c, e⁆ ^ 2 := by
      have h1 : ⁅⁅c, e⁆⁻¹, e⁆ = (⁅c, e⁆ ^ 2)⁻¹ := by
        have h2 := commutatorElement_diag e c hec2
        rw [← commutatorElement_inv c e] at h2
        rwa [show (⁅c, e⁆⁻¹) ^ 2 = (⁅c, e⁆ ^ 2)⁻¹ by
          rw [pow_two, pow_two, mul_inv_rev]] at h2
      have h3 : (⁅⁅c, e⁆, e⁆)⁻¹ = (⁅c, e⁆ ^ 2)⁻¹ := by
        rw [← commutatorElement_inv_left_mem hAn hAab htA]
        exact h1
      exact inv_injective h3
    simpa only [commutatorElement_def] using hte
  · intro c hc c' hc' e he
    have ht1 : ⁅c, e⁆ ∈ A := by
      have := hcomm_mem c hc e he; simpa only [commutatorElement_def] using this
    have ht2 : ⁅c', e⁆ ∈ A := by
      have := hcomm_mem c' hc' e he; simpa only [commutatorElement_def] using this
    have hzc : ⁅c', c⁆ ∈ Subgroup.center P :=
      hA2central _ (by rw [← hCd]; exact Subgroup.commutator_mem_commutator hc' hc)
    have h3 : ⁅⁅c', c⁆, e⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp hzc e).symm
    have hJ : ⁅⁅c, e⁆, c'⁆ * ⁅⁅e, c'⁆, c⁆ * ⁅⁅c', c⁆, e⁆ = 1 := by
      simpa only [commutatorElement_def] using
        Work.Higman.Q3.crux_class_three_jacobi h hA hGs hsq htop c e c'
    rw [h3, mul_one] at hJ
    have h4 : ⁅⁅e, c'⁆, c⁆ = (⁅⁅c', e⁆, c⁆)⁻¹ := by
      rw [← commutatorElement_inv c' e]
      exact commutatorElement_inv_left_mem hAn hAab ht2
    rw [h4] at hJ
    have h5 : ⁅⁅c, e⁆, c'⁆ = ⁅⁅c', e⁆, c⁆ := mul_inv_eq_one.mp hJ
    simpa only [commutatorElement_def] using h5
  · by_contra hcon
    push_neg at hcon
    have hCEd : ⁅C, E⁆ ≤ Work.Higman.powSub A 2 := by
      rw [Subgroup.commutator_le]
      intro c hc e he
      have := hcon c hc e he
      simpa only [commutatorElement_def] using this
    haveI hCN : C.Normal := hCn
    haveI hEN : E.Normal := hEn
    have hkey : ⁅C ⊔ E, C ⊔ E⁆ ≤ Work.Higman.powSub A 2 := by
      rw [Subgroup.commutator_sup_right C E (C ⊔ E)]
      refine sup_le ?_ ?_
      · rw [Subgroup.commutator_sup_left C C E]
        exact sup_le (le_of_eq hCd) hCEd
      · rw [Subgroup.commutator_sup_left E C E]
        refine sup_le ?_ (le_of_eq hEd)
        rw [Subgroup.commutator_le]
        intro e he c hc
        rw [← commutatorElement_inv c e]
        exact Subgroup.inv_mem _ (by
          have := hcon c hc e he
          simpa only [commutatorElement_def] using this)
    have hA_le : A ≤ Work.Higman.powSub A 2 := by
      have h1 : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.powSub A 2 := by
        rw [← hCEsup]
        exact hkey
      rwa [hGs] at h1
    exact hAne2 (le_antisymm hA_le (Work.Higman.powSub_le (by norm_num)))

private theorem two_cover_endgame {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C E : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hCn : C.Normal) (hEn : E.Normal)
    (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hEinv : E.map (h.xi : MulAut P).toMonoidHom = E)
    (hAC : A ≤ C) (hAE : A ≤ E) (hCA : A ≠ C) (hEA : A ≠ E)
    (hCcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hEcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ E → D = A ∨ D = E)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2) (hEd : ⁅E, E⁆ = Work.Higman.powSub A 2)
    (hCpow2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hEpow2 : Work.Higman.powSub E 2 = Work.Higman.powSub A 2)
    (hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2) (hEAd : ⁅E, A⁆ = Work.Higman.powSub A 2)
    (hCE : C ⊓ E = A) (hCEsup : C ⊔ E = ⊤) :
    False :=
  Work.Commutator.two_cover_false h hA
    (Work.Higman.maximal_of_c4_data h hA hsq hA4 htop hcard)
    hNA hGs hsq hA4 htop hcard hcent hCn hEn hCinv hEinv hAC hAE hCA hEA
    hCcover hEcover hCd hEd hCpow2 hEpow2 hCAd hEAd hCE hCEsup

end Work.Higman.NSM
end

-- ===== from Submission.Work.Higman.NSM.dsq_caseB =====
section

set_option autoImplicit false
set_option maxHeartbeats 1000000

open scoped commutatorElement

namespace Work.Higman.NSM

/-- **The `C₄` exclusion in cover form**, proved by strong induction on `Nat.card P`.

`P` is a Suzuki 2-group, `A` a `ξ`-invariant abelian normal subgroup with `Ω₁(P) ≤ A`,
`[P,P] = A`, every square of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)`, `|A| = |Ω₁(P)|²`, and `C` a
minimal `ξ`-invariant normal cover of `A` with `C² = [C,C] = A²` and `[C,⊤] = A`.  Then `False`.

This is the `⁅C,⊤⁆ = A` branch of the `C₄` exclusion.  The minimal-counterexample induction
produces a twin cover `E` (`Work.Higman.NSM.two_cover_exists`: `D ⊓ E = A`, `D ⊔ E = ⊤`,
`⁅D,E⁆ = A`, `D² = E² = A²`, `⁅D,D⁆ = ⁅E,E⁆ = A²`), and the resulting two-cover configuration is
impossible by `Work.Higman.NSM.two_cover_endgame`, which realises the pairings
`β : D/A × E/A → A/A²` and `Φ : A/A² × D/A → A²` over the field `F = Ω₁(P)` with the eigenvalues
`μ, μ, μ²` of `ξ` on `D/A`, `E/A`, `A/A²` and feeds the `c4_resonance_false` endgame (Higman §4
Lemma 6). -/
private theorem c4_cover_false : ∀ m : ℕ, ∀ {Q : Type} [Group Q] [Finite Q], Nat.card Q = m →
    (hQ : Work.Higman.IsSuzuki2Grp Q) →
    ∀ (A C : Subgroup Q),
      Work.Higman.IsXiAbelNormal hQ A → Work.Higman.omega1 Q ≤ A → ⁅(⊤ : Subgroup Q), ⊤⁆ = A →
      (∀ x : Q, x ^ 2 ∈ A) → Work.Higman.powSub A 4 = ⊥ →
      Work.Higman.powSub A 2 = Work.Higman.omega1 Q →
      Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 Q)) ^ 2 →
      C.Normal → C.map (hQ.xi : MulAut Q).toMonoidHom = C → A ≤ C → A ≠ C →
      (∀ D : Subgroup Q, D.Normal → D.map (hQ.xi : MulAut Q).toMonoidHom = D →
        A ≤ D → D ≤ C → D = A ∨ D = C) →
      Work.Higman.powSub C 2 = Work.Higman.powSub A 2 → ⁅C, C⁆ = Work.Higman.powSub A 2 →
      ⁅C, (⊤ : Subgroup Q)⁆ = A → False := by
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    intro Q _ _ hcardQ hQ A C hA hNA hGs hsq hA4 htop hcard hCn hCinv hAC hCA hcover hCpow2 hCd hCT
    -- `A` is maximal among the `ξ`-invariant abelian normal subgroups, and `C_P(A) = A`
    have hAxi : A.map (hQ.xi : MulAut Q).toMonoidHom = A := hA.map_eq
    have hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := hA.abelian
    have hmax : ∀ B : Subgroup Q, Work.Higman.IsXiAbelNormal hQ B → A ≤ B → B = A :=
      Work.Higman.NSM.c4sqAMaximal hQ hAxi hAab hNA hGs hsq hA4 htop hcard
    have hAZ : ¬ A ≤ Subgroup.center Q :=
      Work.Higman.RedAux.c4_A_not_le_center hQ hGs hsq htop hcard
    have hcent : Subgroup.centralizer (A : Set Q) = A :=
      Work.Higman.MSA.centralizer_eq_self hQ hA hmax hNA hGs hsq hA4 htop hcard hAZ
    -- the twin cover, using the induction hypothesis for strictly smaller groups
    obtain ⟨E, hEn, hEinv, hAE, hEA, hEcover, hCE, hCEsup, hEpow2, hEd, hEAd, hCEd⟩ :=
      Work.Higman.NSM.two_cover_exists hQ hA hmax hNA hGs hsq hA4 htop hcard hcent hCn hCinv
        hAC hCA hcover hCpow2 hCd hCT
        (fun {S : Type} [Group S] [Finite S] hS hlt A' C' hA' hNA' hGs' hsq' hA4' htop' hcard'
          hCn' hCinv' hAC' hCA' hcover' hCpow2' hCd' hCT' =>
          ih (Nat.card S) (hcardQ ▸ hlt) rfl hS A' C' hA' hNA' hGs' hsq' hA4' htop' hcard'
            hCn' hCinv' hAC' hCA' hcover' hCpow2' hCd' hCT')
    -- the two-cover configuration is impossible
    have hACd : ⁅A, C⁆ = Work.Higman.powSub A 2 :=
      Work.Higman.RedAux.c4_comm_A_D hQ hA hCinv hA4 hAC hCA hCd htop hcard hcent
    have hCAd : ⁅C, A⁆ = Work.Higman.powSub A 2 := by
      rw [Subgroup.commutator_comm]; exact hACd
    exact Work.Higman.NSM.two_cover_endgame hQ hA hNA hGs hsq hA4 htop hcard hcent hCn hEn
      hCinv hEinv hAC hAE hCA hEA hcover hEcover hCd hEd hCpow2 hEpow2 hCAd hEAd hCE hCEsup

/-- **`deepSquareCase`, the branch `⁅P,D⁆ = A`.**

`P` a Suzuki 2-group, `A, D` satisfying the `C₄` deep configuration
(`Work.Higman.NSM.C4 h A D`), and `⁅P,D⁆ ⊄ A²` (equivalently, since `⁅P,D⁆` is a `ξ`-invariant
subgroup of `A` containing `A² = ⁅D,D⁆`, this says `⁅P,D⁆ = A`; the other branch
`⁅P,D⁆ ≤ A²` is closed by the Gorenstein–Thompson pairing argument and is not part of this
statement).  Then `False`.

Available in this branch: `C_P(A) = A`, `D² = A²`, `|D| = q³`, `P² = A`, the radical of the
commutator pairing `β : P/A × P/A → A/A²` is `0` (`H8.Erad_le_D`), `β` is alternating,
`ξ`-equivariant and onto, and the diagonal identity `⟦x,⟦x,y⟧⟧ = ⟦x,y⟧²` for `x` with `x²`
central (`H8.false_of_sq_mem_and_comm_le`, `RedAux.commutator_diag_eq`).  The proof runs through
the two-cover configuration: `⁅P,D⁆ = A` forces a twin cover `E > A` with `D ⊓ E = A`,
`D ⊔ E = ⊤`, `⟦D,E⟧ = A` and `⟦D,D⟧ = ⟦E,E⟧ = A²` (`Higman/NSM/two_cover_exists`), and the
pairings `β : D/A × E/A → A/A²`, `Φ : A/A² × D/A → A²` together with the eigenvalues
`μ, μ, μ²` of `ξ` on `D/A`, `E/A`, `A/A²` (Frobenius conjugates of the Singer cycle `λ` on
`Ω₁(P)`, with `μ² = λ`) realise Higman §4 Lemma 6 and contradict
`Work.Higman.H8.c4_resonance_false`. -/
private theorem dsq_caseB {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} (H : Work.Higman.NSM.C4 h A D)
    (hPD : ¬ (⁅(⊤ : Subgroup P), D⁆ ≤ Work.Higman.powSub A 2)) : False := by
  -- `⁅⊤,D⁆` is a `ξ`-invariant normal subgroup of `A` containing `A² = ⁅D,D⁆`
  have hle : (⁅(⊤ : Subgroup P), D⁆ : Subgroup P) ≤ A := by
    calc ⁅(⊤ : Subgroup P), D⁆ ≤ ⁅(⊤ : Subgroup P), ⊤⁆ := Subgroup.commutator_mono le_rfl le_top
      _ = A := H.Gs
  have hinv : (⁅(⊤ : Subgroup P), D⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom
      = ⁅(⊤ : Subgroup P), D⁆ := by
    rw [Subgroup.map_commutator,
      Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective, H.Dinv]
  have hTopD : ⁅(⊤ : Subgroup P), D⁆ = A := by
    rcases Work.Higman.RedAux.red_trichotomy h A ⁅(⊤ : Subgroup P), D⁆ H.isXiAbelNormal H.A4
      hle hinv with hb | hb | hb
    · exfalso
      have h2 : Work.Higman.powSub A 2 = ⊥ := by
        have h1 : (⁅D, D⁆ : Subgroup P) ≤ ⁅(⊤ : Subgroup P), D⁆ :=
          Subgroup.commutator_mono le_top le_rfl
        rw [hb] at h1
        rw [← H.Dd]
        exact le_bot_iff.mp h1
      have h3 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← H.top, h2]; simp
      have h4 := h.omega1_card_ge_four
      omega
    · exact absurd (le_of_eq hb) hPD
    · exact hb
  have hDtop : ⁅D, (⊤ : Subgroup P)⁆ = A := by
    rw [Subgroup.commutator_comm]; exact hTopD
  exact c4_cover_false (Nat.card P) rfl h A D H.isXiAbelNormal H.NA H.Gs H.sq H.A4 H.top
    H.card H.Dn H.Dinv H.AD (Ne.symm H.ADne) H.cover H.powSub_D_two_eq H.Dd hDtop

end Work.Higman.NSM
end

-- ===== from Submission.Work.Higman.NSM.higmanLemma13 =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.Higman.NSM

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-! ## Chevalley–Warning bound for a group of class two

Self-contained copy of the commutator algebra of `Submission/Work/Higman/card_eq_sq_or_cube.lean`
(that module lies on an import cycle, so it cannot be imported here). -/

/-- `x * y * x⁻¹ = [x,y] * y`. -/
private theorem czh_mul_mul_inv_eq_commutator_mul {G : Type*} [Group G] (x y : G) :
    x * y * x⁻¹ = ⁅x, y⁆ * y := by
  rw [commutatorElement_def]; group

/-- In a group of class two every commutator is central. -/
private theorem czh_commutator_central_comm {G : Type*} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    z * ⁅x, y⁆ = ⁅x, y⁆ * z :=
  Subgroup.mem_center_iff.mp
    (hZ (Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))) z

/-- Class two: `[x * y, z] = [x,z] * [y,z]`. -/
private theorem czh_commutator_mul_left {G : Type*} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    ⁅x * y, z⁆ = ⁅x, z⁆ * ⁅y, z⁆ := by
  have hcy : ∀ w : G, w * ⁅y, z⁆ = ⁅y, z⁆ * w := czh_commutator_central_comm hZ y z
  have hcx : ∀ w : G, w * ⁅x, z⁆ = ⁅x, z⁆ * w := czh_commutator_central_comm hZ x z
  have h1 : x * z * x⁻¹ = ⁅x, z⁆ * z := czh_mul_mul_inv_eq_commutator_mul x z
  have h2 : y * z * y⁻¹ = ⁅y, z⁆ * z := czh_mul_mul_inv_eq_commutator_mul y z
  rw [commutatorElement_def]
  rw [show x * y * z * (x * y)⁻¹ * z⁻¹ = x * (y * z * y⁻¹) * x⁻¹ * z⁻¹ by group]
  rw [h2]
  rw [show x * (⁅y, z⁆ * z) * x⁻¹ * z⁻¹ = (x * ⁅y, z⁆) * (z * x⁻¹) * z⁻¹ by group]
  rw [hcy x]
  rw [show (⁅y, z⁆ * x) * (z * x⁻¹) * z⁻¹ = ⁅y, z⁆ * (x * z * x⁻¹) * z⁻¹ by group]
  rw [h1]
  rw [show ⁅y, z⁆ * (⁅x, z⁆ * z) * z⁻¹ = ⁅y, z⁆ * ⁅x, z⁆ by group]
  rw [hcx ⁅y, z⁆]

/-- Class two: `[z, x * y] = [z, x] * [z, y]`. -/
private theorem czh_commutator_mul_right {G : Type*} [Group G]
    (hZ : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ Subgroup.center G) (x y z : G) :
    ⁅z, x * y⁆ = ⁅z, x⁆ * ⁅z, y⁆ := by
  have h1 : ⁅z, x * y⁆ = ⁅x * y, z⁆⁻¹ := by rw [← commutatorElement_inv]
  rw [h1, czh_commutator_mul_left hZ x y z, mul_inv_rev, commutatorElement_inv,
    commutatorElement_inv]
  exact (czh_commutator_central_comm hZ z y ⁅z, x⁆).symm

/-- A central element commutes out of a commutator on the left. -/
private theorem czh_commutator_eq_one_of_mem_center_left {G : Type*} [Group G] {z : G}
    (hz : z ∈ Subgroup.center G) (x : G) : ⁅z, x⁆ = 1 := by
  rw [commutatorElement_def, ← Subgroup.mem_center_iff.mp hz x]
  group

/-- A central element commutes out of a commutator on the right. -/
private theorem czh_commutator_eq_one_of_mem_center_right {G : Type*} [Group G] {z : G}
    (hz : z ∈ Subgroup.center G) (x : G) : ⁅x, z⁆ = 1 := by
  rw [commutatorElement_def, Subgroup.mem_center_iff.mp hz x]
  group

/-- **Chevalley–Warning bound.**  If `Z(P) = Ω₁(P)`, every square is central and `P` has class
two, then `|P / Z(P)| ≤ |Z(P)|²`. -/
private theorem card_quotient_center_le_sq_nsm (h : IsSuzuki2Grp P)
    (hZ : Subgroup.center P = omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ Subgroup.center P)
    (hcommZ : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P) :
    Nat.card (P ⧸ Subgroup.center P) ≤ Nat.card ↥(Subgroup.center P) ^ 2 := by
  classical
  have hZ2 : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P := hcommZ
  have hsq2 : ∀ g : P, g * g ∈ Subgroup.center P := fun g => by
    have h1 := hsq g
    rwa [pow_two] at h1
  have hqcomm : ∀ a b : P ⧸ Subgroup.center P, a * b = b * a := by
    intro a b
    refine Quotient.inductionOn a (fun x => ?_)
    refine Quotient.inductionOn b (fun y => ?_)
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have hmem : (x * y)⁻¹ * (y * x) = ⁅y⁻¹, x⁻¹⁆ := by
      rw [commutatorElement_def]; group
    rw [hmem]
    exact hZ2 (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _))
  letI : CommGroup (P ⧸ Subgroup.center P) :=
    { (inferInstance : Group (P ⧸ Subgroup.center P)) with mul_comm := hqcomm }
  letI : CommGroup ↥(Subgroup.center P) :=
    { (inferInstance : Group ↥(Subgroup.center P)) with
      mul_comm := fun a b => Subtype.ext ((Subgroup.mem_center_iff.mp b.2) (a : P)) }
  let mkc : P → Additive (P ⧸ Subgroup.center P) :=
    fun z => Additive.ofMul (QuotientGroup.mk z)
  have h2V : ∀ v : Additive (P ⧸ Subgroup.center P), (2 : ℕ) • v = 0 := by
    intro v
    refine Quotient.inductionOn v (fun x => ?_)
    change (2 : ℕ) • Additive.ofMul (QuotientGroup.mk x) = 0
    rw [← ofMul_pow, ofMul_eq_zero]
    have hxx : ((x * x : P) : P ⧸ Subgroup.center P) = 1 :=
      (QuotientGroup.eq_one_iff (N := Subgroup.center P) (x * x)).mpr (hsq2 x)
    simpa [pow_two] using hxx
  haveI hmodV : Module (ZMod 2) (Additive (P ⧸ Subgroup.center P)) :=
    AddCommGroup.zmodModule h2V
  have h2W : ∀ v : Additive ↥(Subgroup.center P), (2 : ℕ) • v = 0 := by
    intro v
    rw [← ofMul_toMul v, ← ofMul_pow]
    simp only [ofMul_eq_zero]
    apply Subtype.ext
    change ((v.toMul : ↥(Subgroup.center P)) : P) ^ 2 = 1
    have h1 : ((v.toMul : ↥(Subgroup.center P)) : P) ∈ omega1 P := by
      rw [← hZ]; exact (v.toMul).2
    exact h.mem_omega1.mp h1
  haveI hmodW : Module (ZMod 2) (Additive ↥(Subgroup.center P)) :=
    AddCommGroup.zmodModule h2W
  let qf : P → ↥(Subgroup.center P) := fun g => ⟨g * g, by simpa [pow_two] using hsq g⟩
  have hqw : ∀ a b : P, a⁻¹ * b ∈ Subgroup.center P → qf a = qf b := by
    intro a b hab
    obtain ⟨z, hz, rfl⟩ : ∃ z ∈ Subgroup.center P, b = a * z := ⟨a⁻¹ * b, hab, by group⟩
    apply Subtype.ext
    show a * a = (a * z) * (a * z)
    have hzc : z * z = 1 := by
      have h1 : z ∈ omega1 P := by rw [← hZ]; exact hz
      have h2 := h.mem_omega1.mp h1
      rwa [pow_two] at h2
    have hc : z * a = a * z := (Subgroup.mem_center_iff.mp hz a).symm
    calc a * a = a * a * (z * z) := by rw [hzc, mul_one]
      _ = a * (a * (z * z)) := by group
      _ = a * ((a * z) * z) := by group
      _ = a * ((z * a) * z) := by rw [hc]
      _ = (a * z) * (a * z) := by group
  have hqw' : ∀ a b : P, (QuotientGroup.leftRel (Subgroup.center P)) a b →
      Additive.ofMul (qf a) = Additive.ofMul (qf b) :=
    fun a b hab => congrArg Additive.ofMul (hqw a b (QuotientGroup.leftRel_apply.mp hab))
  let Q : Additive (P ⧸ Subgroup.center P) → Additive ↥(Subgroup.center P) :=
    fun v => Quotient.liftOn v.toMul (fun g => Additive.ofMul (qf g)) hqw'
  have Q_mk : ∀ g : P, Q (mkc g) = Additive.ofMul (qf g) :=
    fun g => congrArg Additive.ofMul
      (Quotient.liftOn_mk (s := QuotientGroup.leftRel (Subgroup.center P))
        (fun g => Additive.ofMul (qf g)) hqw' g)
  have Q_zero : Q 0 = 0 := by
    change Q (mkc 1) = 0
    rw [Q_mk, ofMul_eq_zero]
    apply Subtype.ext
    show (1 : P) * 1 = 1
    group
  have Q_aniso : ∀ v, Q v = 0 → v = 0 := by
    intro v
    refine Quotient.inductionOn v (fun g => ?_)
    intro hv
    have hv' : Q (mkc g) = 0 := hv
    rw [Q_mk, ofMul_eq_zero] at hv'
    have hg : g * g = 1 := congrArg Subtype.val hv'
    have hg2 : g ^ 2 = 1 := by rw [pow_two]; exact hg
    change mkc g = 0
    rw [ofMul_eq_zero, QuotientGroup.eq_one_iff, hZ]
    exact h.mem_omega1.mpr hg2
  let bZ : P → P → ↥(Subgroup.center P) :=
    fun x y => ⟨⁅y, x⁆, hcommZ (Subgroup.commutator_mem_commutator
      (Subgroup.mem_top y) (Subgroup.mem_top x))⟩
  have bZ_mul₁ : ∀ a b y : P, bZ (a * b) y = bZ a y * bZ b y := by
    intro a b y
    apply Subtype.ext
    show ⁅y, a * b⁆ = ⁅y, a⁆ * ⁅y, b⁆
    exact czh_commutator_mul_right hZ2 a b y
  have bZ_mul₂ : ∀ y a b : P, bZ y (a * b) = bZ y a * bZ y b := by
    intro y a b
    apply Subtype.ext
    show ⁅a * b, y⁆ = ⁅a, y⁆ * ⁅b, y⁆
    exact czh_commutator_mul_left hZ2 a b y
  have bZ_wd : ∀ a₁ b₁ a₂ b₂ : P,
      (QuotientGroup.leftRel (Subgroup.center P)) a₁ a₂ →
      (QuotientGroup.leftRel (Subgroup.center P)) b₁ b₂ → bZ a₁ b₁ = bZ a₂ b₂ := by
    intro a₁ b₁ a₂ b₂ ha hb
    obtain ⟨z, hz, rfl⟩ : ∃ z ∈ Subgroup.center P, a₂ = a₁ * z :=
      ⟨a₁⁻¹ * a₂, QuotientGroup.leftRel_apply.mp ha, by group⟩
    obtain ⟨w, hw, rfl⟩ : ∃ w ∈ Subgroup.center P, b₂ = b₁ * w :=
      ⟨b₁⁻¹ * b₂, QuotientGroup.leftRel_apply.mp hb, by group⟩
    apply Subtype.ext
    show ⁅b₁, a₁⁆ = ⁅b₁ * w, a₁ * z⁆
    rw [czh_commutator_mul_left hZ2 b₁ w (a₁ * z),
        czh_commutator_eq_one_of_mem_center_left hw (a₁ * z), mul_one,
        czh_commutator_mul_right hZ2 a₁ z b₁,
        czh_commutator_eq_one_of_mem_center_right hz b₁, mul_one]
  let bZq : Additive (P ⧸ Subgroup.center P) → Additive (P ⧸ Subgroup.center P) →
      Additive ↥(Subgroup.center P) :=
    fun v w => Additive.ofMul (Quotient.liftOn₂ v.toMul w.toMul bZ bZ_wd)
  have bZq_mk : ∀ x y : P, bZq (mkc x) (mkc y) = Additive.ofMul (bZ x y) :=
    fun x y => congrArg Additive.ofMul (Quotient.liftOn₂_mk bZ bZ_wd x y)
  have hsum : ∀ x y : P, mkc x + mkc y = mkc (x * y) := by
    intro x y
    show Additive.ofMul (QuotientGroup.mk x) + Additive.ofMul (QuotientGroup.mk y) =
      Additive.ofMul (QuotientGroup.mk (x * y))
    rw [← ofMul_mul, ← QuotientGroup.mk_mul]
  have bZq_zero₁ : ∀ w : Additive (P ⧸ Subgroup.center P), bZq 0 w = 0 := by
    intro w
    refine Quotient.inductionOn w (fun z => ?_)
    change bZq (mkc 1) (mkc z) = 0
    rw [bZq_mk 1 z, ofMul_eq_zero]
    apply Subtype.ext
    show ⁅z, 1⁆ = 1
    rw [commutatorElement_def]; group
  have bZq_zero₂ : ∀ w : Additive (P ⧸ Subgroup.center P), bZq w 0 = 0 := by
    intro w
    refine Quotient.inductionOn w (fun z => ?_)
    change bZq (mkc z) (mkc 1) = 0
    rw [bZq_mk z 1, ofMul_eq_zero]
    apply Subtype.ext
    show ⁅1, z⁆ = 1
    rw [commutatorElement_def]; group
  have bZq_add₁ : ∀ v₁ v₂ w : Additive (P ⧸ Subgroup.center P),
      bZq (v₁ + v₂) w = bZq v₁ w + bZq v₂ w := by
    intro v₁ v₂ w
    refine Quotient.inductionOn v₁ (fun x => ?_)
    refine Quotient.inductionOn v₂ (fun y => ?_)
    refine Quotient.inductionOn w (fun z => ?_)
    change bZq (mkc x + mkc y) (mkc z) = bZq (mkc x) (mkc z) + bZq (mkc y) (mkc z)
    rw [hsum x y, bZq_mk (x * y) z, bZq_mk x z, bZq_mk y z, ← ofMul_mul, ← bZ_mul₁ x y z]
  have bZq_add₂ : ∀ v w₁ w₂ : Additive (P ⧸ Subgroup.center P),
      bZq v (w₁ + w₂) = bZq v w₁ + bZq v w₂ := by
    intro v w₁ w₂
    refine Quotient.inductionOn v (fun z => ?_)
    refine Quotient.inductionOn w₁ (fun x => ?_)
    refine Quotient.inductionOn w₂ (fun y => ?_)
    change bZq (mkc z) (mkc x + mkc y) = bZq (mkc z) (mkc x) + bZq (mkc z) (mkc y)
    rw [hsum x y, bZq_mk z (x * y), bZq_mk z x, bZq_mk z y, ← ofMul_mul, ← bZ_mul₂ z x y]
  have bZq_smul₁ : ∀ (c : ZMod 2) (v w : Additive (P ⧸ Subgroup.center P)),
      bZq (c • v) w = c • bZq v w := by
    intro c v w
    let φ : Additive (P ⧸ Subgroup.center P) →+ Additive ↥(Subgroup.center P) :=
      { toFun := fun x => bZq x w
        map_zero' := bZq_zero₁ w
        map_add' := fun x y => bZq_add₁ x y w }
    exact ZMod.map_smul φ c v
  have bZq_smul₂ : ∀ (c : ZMod 2) (v w : Additive (P ⧸ Subgroup.center P)),
      bZq v (c • w) = c • bZq v w := by
    intro c v w
    let φ : Additive (P ⧸ Subgroup.center P) →+ Additive ↥(Subgroup.center P) :=
      { toFun := fun x => bZq v x
        map_zero' := bZq_zero₂ v
        map_add' := fun x y => bZq_add₂ v x y }
    exact ZMod.map_smul φ c w
  let b : Additive (P ⧸ Subgroup.center P) →ₗ[ZMod 2]
      Additive (P ⧸ Subgroup.center P) →ₗ[ZMod 2] Additive ↥(Subgroup.center P) :=
    LinearMap.mk₂ (ZMod 2) bZq bZq_add₁ bZq_smul₁ bZq_add₂ bZq_smul₂
  have hb : ∀ v w, Q (v + w) = Q v + Q w + b v w := by
    intro v w
    refine Quotient.inductionOn v (fun x => ?_)
    refine Quotient.inductionOn w (fun y => ?_)
    change Q (mkc x + mkc y) = Q (mkc x) + Q (mkc y) + bZq (mkc x) (mkc y)
    rw [hsum x y, Q_mk, Q_mk x, Q_mk y, bZq_mk x y, ← ofMul_mul, ← ofMul_mul]
    congr 1
    apply Subtype.ext
    show (x * y) * (x * y) = (x * x) * (y * y) * ⁅y, x⁆
    have hc : ⁅y, x⁆ ∈ Subgroup.center P := hcommZ (Subgroup.commutator_mem_commutator
      (Subgroup.mem_top y) (Subgroup.mem_top x))
    have h1 : ⁅y, x⁆ * x = x * ⁅y, x⁆ := (Subgroup.mem_center_iff.mp hc x).symm
    have h2 : ⁅y, x⁆ * y = y * ⁅y, x⁆ := (Subgroup.mem_center_iff.mp hc y).symm
    have hcyx : y * x = ⁅y, x⁆ * x * y := by rw [commutatorElement_def]; group
    calc (x * y) * (x * y) = x * (y * x) * y := by group
      _ = x * (⁅y, x⁆ * x * y) * y := by rw [hcyx]
      _ = (x * x) * (y * y) * ⁅y, x⁆ := by
            calc x * (⁅y, x⁆ * x * y) * y = x * (x * (⁅y, x⁆ * y)) * y := by
                  rw [h1]; group
              _ = x * (x * (y * ⁅y, x⁆)) * y := by rw [h2]
              _ = x * (x * y) * (⁅y, x⁆ * y) := by group
              _ = x * (x * y) * (y * ⁅y, x⁆) := by rw [h2]
              _ = (x * x) * (y * y) * ⁅y, x⁆ := by group
  exact card_le_sq_of_quadratic_anisotropic (V := Additive (P ⧸ Subgroup.center P))
    (W := Additive ↥(Subgroup.center P)) Q Q_zero b hb Q_aniso

/-- If `P` has class two, `Z(P) = Ω₁(P)` and every square is central, then
`|P| ≤ |Z(P)|³`. -/
private theorem card_le_cube_of_class_two (h : IsSuzuki2Grp P)
    (hZ : Subgroup.center P = omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ Subgroup.center P)
    (hcommZ : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P) :
    Nat.card P ≤ Nat.card ↥(Subgroup.center P) ^ 3 := by
  have h1 : Nat.card P = Nat.card (P ⧸ Subgroup.center P) * Nat.card ↥(Subgroup.center P) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  have h2 := card_quotient_center_le_sq_nsm h hZ hsq hcommZ
  calc Nat.card P = Nat.card (P ⧸ Subgroup.center P) * Nat.card ↥(Subgroup.center P) := h1
    _ ≤ Nat.card ↥(Subgroup.center P) ^ 2 * Nat.card ↥(Subgroup.center P) :=
        Nat.mul_le_mul_right _ h2
    _ = Nat.card ↥(Subgroup.center P) ^ 3 := by ring

/-! ## The `ξ`-invariant subgroups of `A`

`A` is homocyclic of exponent `2 ^ e` with `e ≤ 2`, so its `ξ`-invariant subgroups are
`⊥`, `A²` and `A`. -/

private theorem xi_inv_sub_dichotomy_nsm (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    {B : Subgroup P} (hBA : B ≤ A) (hBinv : B.map (h.xi : MulAut P).toMonoidHom = B) :
    B = ⊥ ∨ B = Work.Higman.powSub A 2 ∨ B = A := by
  obtain ⟨e, hexp, hcard, htop, hsub⟩ := homogeneous_structure h hAab hAinv
  obtain ⟨i, hi⟩ := hsub B hBA hBinv
  rcases Nat.eq_zero_or_pos i with h0 | hpos
  · exact Or.inr (Or.inr (by rw [hi, h0, pow_zero, Work.Higman.powSub_one_eq]))
  · rcases Nat.lt_or_ge i 2 with hlt | hge
    · exact Or.inr (Or.inl (by
        have hi1 : i = 1 := by omega
        rw [hi, hi1]; norm_num))
    · exact Or.inl (by
        rw [hi]
        have hdvd : 4 ∣ 2 ^ i := ⟨2 ^ (i - 2), by
          have hi : i = 2 + (i - 2) := by omega
          rw [hi, pow_add]; norm_num⟩
        exact le_bot_iff.mp (hA4 ▸ Work.Higman.powSub_le_of_dvd hAab hdvd))

/-- The derived subgroup of a `ξ`-invariant normal subgroup lies in `A`, hence is `⊥`, `A²`
or `A`. -/
private theorem dComm_dichotomy_nsm (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) :
    ⁅D, D⁆ = ⊥ ∨ ⁅D, D⁆ = Work.Higman.powSub A 2 ∨ ⁅D, D⁆ = A := by
  have hle : ⁅D, D⁆ ≤ A := by
    rw [← hGs]
    exact Subgroup.commutator_mono le_top le_top
  have hinv : (⁅D, D⁆).map (h.xi : MulAut P).toMonoidHom = ⁅D, D⁆ := by
    rw [Subgroup.map_commutator, hDinv]
  exact xi_inv_sub_dichotomy_nsm h hAab hAinv hA4 hle hinv

/-! ## Powers of `ξ` fixing one non-identity element

The Suzuki automorphism `ξ` is coarse in the following sense: if `ξ ^ k` fixes a single
non-identity element `x`, then `ξ ^ k` fixes *every* element of `Ω₁(P)`.  Indeed `x` has order
`2 ^ r`, so `x ^ (2 ^ (r - 1))` is an involution fixed by `ξ ^ k`; by the transitivity of `ξ` on
the involutions every involution is a `ξ`-conjugate of it, hence also fixed. -/

/-- **A power of `ξ` fixing one non-identity element fixes every involution.**  Indeed `x` has
order `2 ^ r`, so `x ^ (2 ^ (r - 1))` is an involution fixed by `ξ ^ k`; every involution is
`ξ ^ j`-conjugate to it by transitivity, hence also fixed. -/
private theorem xi_pow_fixes_involutions_of_fixes_ne_one (h : IsSuzuki2Grp P) {k : ℕ} {x : P}
    (hx : x ≠ 1) (hfix : (h.xi ^ k) x = x) :
    ∀ z : P, orderOf z = 2 → (h.xi ^ k) z = z := by
  obtain ⟨r, hr⟩ := (IsPGroup.iff_orderOf).mp h.isPGroup x
  have hr1 : 1 ≤ r := by
    rcases Nat.eq_zero_or_pos r with h0 | hpos
    · exfalso
      rw [h0, pow_zero] at hr
      exact hx (orderOf_eq_one_iff.mp hr)
    · exact hpos
  set m : ℕ := 2 ^ (r - 1) with hm
  have hpowfix : ∀ n : ℕ, (h.xi ^ k) (x ^ n) = x ^ n := by
    intro n
    have h1 : (h.xi ^ k) (x ^ n) = ((h.xi ^ k) x) ^ n := by
      induction n with
      | zero => simp
      | succ n ih => rw [pow_succ, map_mul, ih, pow_succ, hfix]
    rw [h1, hfix]
  have hmord : orderOf (x ^ m) = 2 := by
    rw [orderOf_pow, hr, hm, Nat.gcd_eq_right (Nat.pow_dvd_pow 2 (by omega))]
    rw [Nat.pow_div (by omega : r - 1 ≤ r) (by norm_num : 0 < 2)]
    rw [show r - (r - 1) = 1 by omega]
  intro z hz
  obtain ⟨j, hj⟩ := h.trans (x ^ m) z hmord hz
  rw [← hj]
  have hcomm : (h.xi ^ k) ((h.xi ^ j) (x ^ m)) = (h.xi ^ j) ((h.xi ^ k) (x ^ m)) := by
    rw [← MulAut.mul_apply, ← MulAut.mul_apply]
    congr 1
    rw [← pow_add, ← pow_add, Nat.add_comm]
  rw [hcomm, hpowfix m]

/-- **If a power of `ξ` fixes one non-identity element it fixes `Ω₁(P)` pointwise.**  Every
element of `Ω₁(P)` is `1` or an involution, so this is
`xi_pow_fixes_involutions_of_fixes_ne_one`.  (It does *not* force `ξ ^ k = 1`; the kernel of the
action of `⟨ξ⟩` on `P` may be non-trivial.) -/
private theorem xi_pow_fixes_omega1_of_fixes_ne_one (h : IsSuzuki2Grp P) {k : ℕ} {x : P}
    (hx : x ≠ 1) (hfix : (h.xi ^ k) x = x) :
    ∀ z ∈ Work.Higman.omega1 P, (h.xi ^ k) z = z := by
  intro z hz
  rcases eq_or_ne z 1 with rfl | hz1
  · simp
  · have hz2 : orderOf z = 2 := by
      have hd : orderOf z ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp hz)
      rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
      · exact absurd (orderOf_eq_one_iff.mp h1) hz1
      · exact h2
    exact xi_pow_fixes_involutions_of_fixes_ne_one h hx hfix z hz2

/-- **The deep configuration of the `C₄` exclusion.**  `A` is a maximal `ξ`-invariant abelian
normal subgroup of the Suzuki 2-group `P` with `[P,P] = A`, `A² = Ω₁(P) = Z(P)`, `A⁴ = 1` and
`|A| = q²`; `D` is a minimal `ξ`-invariant normal subgroup with `A < D ≤ P` and `[D,D] = A²`.

This is the case in which `D/A` is `ξ`-irreducible and `D` is a class-two subgroup of `P` with
`Z(D) = D' = D² = A²`; the sub-case `[A,D] = ⊥` is Gorenstein–Thompson (`H8.alt_pairing_false`)
and the sub-case `[A,D] = A²` is the genuinely hard one.  `H8.c4_sq_a2_card_quot` (axiom-clean)
gives `|D/A| = q`, hence `|D| = q³` and `D < P`, whence orbit counting gives `|P| ≥ q⁴`, so this
configuration *implies* `|P| ≥ q⁴` and is therefore exactly as hard as Higman's Theorem 1. -/
private theorem deepSquareCase {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAmax : ∀ B : Subgroup P, B.Normal → B.map (h.xi : MulAut P).toMonoidHom = B →
      (∀ x ∈ B, ∀ y ∈ B, x * y = y * x) → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hAn : A.Normal) (hDn : D.Normal)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : D ≠ A)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D) :
    False := by
  have H : Work.Higman.NSM.C4 h A D :=
    ⟨hAab, hAinv, hAmax, hNA, hGs, hsq, hA4, htop, hcard, hAn, hDn, hDinv, hAD, hADne, hDd,
      hcover⟩
  by_cases hPD : ⁅(⊤ : Subgroup P), D⁆ ≤ Work.Higman.powSub A 2
  · exact Work.Higman.NSM.C4.caseA H hPD
  · exact Work.Higman.NSM.dsq_caseB h H hPD

/-- **The `C₄` exclusion** (Higman 1963, Theorem 1, the hard part): a maximal `ξ`-invariant
abelian normal subgroup `A` with `[P,P] = A` cannot have `A` of exponent four.

* if `P/A` is `ξ`-irreducible then Higman's Lemma 8 (`MSA.lemma8_clean`, axiom-clean) with the
  cover `C = ⊤` gives `exp A ∣ 2`, i.e. `A = A²`, contradicting `|A| = q² > q = |A²|`;
* otherwise a minimal `ξ`-invariant normal `D` with `A < D ≤ P` exists.  `[D,D] ∈ {⊥, A², A}`;
  `⊥` contradicts the maximality of `A` and `[D,D] = A` again gives `exp A ∣ 2` by Higman's
  Lemma 8 with the cover `C = D`; so `[D,D] = A²`, which is `deepSquareCase` above. -/
private theorem noSquareMaximal {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAmax : ∀ B : Subgroup P, B.Normal → B.map (h.xi : MulAut P).toMonoidHom = B →
      (∀ x ∈ B, ∀ y ∈ B, x * y = y * x) → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    False := by
  have hAn : A.Normal := by
    rw [← hGs]
    exact Subgroup.commutator_normal _ _
  -- the contradiction `A = A²` from `exp A ∣ 2`
  have key : (∀ a ∈ A, a * a = 1) → False := by
    intro hexp
    have hAle : A ≤ Work.Higman.powSub A 2 := by
      intro a ha
      rw [htop, h.mem_omega1, pow_two]
      exact hexp a ha
    have hAeq : A = Work.Higman.powSub A 2 :=
      le_antisymm hAle (Work.Higman.powSub_le (by norm_num))
    have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
      congrArg (fun X : Subgroup P => Nat.card ↥X) hAeq
    rw [htop, hcard] at h1
    have h4 := h.omega1_card_ge_four
    nlinarith [h1, h4]
  by_cases hirr : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E = A ∨ E = ⊤
  · -- Case 1: `P / A` is `ξ`-irreducible
    have hC2 : Work.Higman.powSub (⊤ : Subgroup P) 2 ≤ A := by
      rw [Work.Higman.powSub, Subgroup.closure_le]
      rintro y ⟨x, -, rfl⟩
      exact hsq x
    have hAne : A ≠ ⊤ := by
      intro htop'
      obtain ⟨x, y, hxy⟩ := h.noncomm
      exact hxy (hAab x (htop' ▸ Subgroup.mem_top x) y (htop' ▸ Subgroup.mem_top y))
    exact key (Work.Higman.MSA.lemma8_clean h ⟨hAn, hAinv, hAab⟩ Subgroup.normal_top
      (Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective) le_top hAne
      (fun E hEn hEinv hAE _ => hirr E hEn hEinv hAE) hC2 hGs)
  · -- Case 2: a proper `ξ`-invariant normal subgroup above `A` exists
    push_neg at hirr
    obtain ⟨D₀, hD₀n, hD₀inv, hAD₀, hD₀A, -⟩ := hirr
    obtain ⟨D, hDn, hDinv, hADlt, hcover⟩ : ∃ D : Subgroup P, D.Normal ∧
        D.map (h.xi : MulAut P).toMonoidHom = D ∧ A < D ∧
        (∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
          A ≤ E → E ≤ D → E = A ∨ E = D) := by
      have hfin : ({E : Subgroup P | E.Normal ∧
          E.map (h.xi : MulAut P).toMonoidHom = E ∧ A < E} : Set (Subgroup P)).Finite :=
        Set.finite_univ.subset (fun _ _ => trivial)
      obtain ⟨D, hD⟩ := hfin.exists_minimal
        ⟨D₀, hD₀n, hD₀inv, lt_of_le_of_ne hAD₀ (Ne.symm hD₀A)⟩
      obtain ⟨hD1, hD2, hD3⟩ := hD.1
      refine ⟨D, hD1, hD2, hD3, ?_⟩
      intro E hEn hEinv hAE hED
      rcases eq_or_ne E A with rfl | hEA
      · exact Or.inl rfl
      · exact Or.inr (le_antisymm hED
          (hD.2 ⟨hEn, hEinv, lt_of_le_of_ne hAE (Ne.symm hEA)⟩ hED))
    have hAD : A ≤ D := le_of_lt hADlt
    have hADne : D ≠ A := (ne_of_lt hADlt).symm
    rcases dComm_dichotomy_nsm h hAab hAinv hA4 hGs hDinv with hbot | hDd | hDd
    · -- `[D,D] = ⊥`: `D` is abelian, `ξ`-invariant and normal above `A`
      exact absurd (hAmax D hDn hDinv (fun x hx y hy =>
        commutatorElement_eq_one_iff_mul_comm.mp (by
          have h1 : ⁅x, y⁆ ∈ (⊥ : Subgroup P) := by
            rw [← hbot]
            exact Subgroup.commutator_mem_commutator hx hy
          simpa using h1)) hAD) hADne
    · -- `[D,D] = A²`: the deep configuration
      exact deepSquareCase h hAab hAinv hAmax hNA hGs hsq hA4 htop hcard hAn hDn hDinv hAD hADne
        hDd hcover
    · -- `[D,D] = A`: Higman's Lemma 8 with the cover `D`
      have hC2 : Work.Higman.powSub D 2 ≤ A := by
        rw [Work.Higman.powSub, Subgroup.closure_le]
        rintro y ⟨x, -, rfl⟩
        exact hsq x
      exact key (Work.Higman.MSA.lemma8_clean h ⟨hAn, hAinv, hAab⟩ hDn hDinv hAD (Ne.symm hADne)
        hcover hC2 hDd)

private theorem higmanLemma13 {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P) : Nat.card P ≤ Nat.card ↥(Subgroup.center P) ^ 3 := by
  classical
  have hZ : Subgroup.center P = Work.Higman.omega1 P := Work.Higman.center_eq_omega1_new h
  obtain ⟨A, hAn, hAinv, hAab, hAmax, hNA, hDA, hsq, hA4⟩ := Work.Higman.lemma9_maximal_abelian h
  obtain ⟨e, hexp, hcardlayer, htoplayer, hsub⟩ := Work.Higman.homogeneous_structure h hAab hAinv
  have hAinf : A ⊓ Work.Higman.omega1 P = Work.Higman.omega1 P := inf_eq_right.mpr hNA
  have hAcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ e := by
    have hh := hcardlayer 0 (Nat.zero_le e)
    rw [pow_zero, Work.Higman.powSub_one_eq, hAinf, Nat.sub_zero] at hh
    exact hh
  -- `e ≤ 2`
  have he2 : e ≤ 2 := by
    rcases Nat.lt_or_ge e 2 with hlt | hge
    · omega
    · have hc := hcardlayer 2 hge
      rw [show (2 : ℕ) ^ 2 = 4 by norm_num, hAinf, hA4, Subgroup.card_bot] at hc
      have hq : Nat.card ↥(Work.Higman.omega1 P) ≠ 1 := by
        have := h.omega1_card_ge_four
        omega
      have hz : e - 2 = 0 := (Nat.pow_eq_one.mp hc.symm).resolve_left hq
      omega
  -- `q ≥ 4` so `e ≠ 0`
  have hepos : 1 ≤ e := by
    by_contra hcon
    have h0 : e = 0 := by omega
    have h1 : A = ⊥ := by
      have hc : Nat.card ↥A = 1 := by rw [hAcard, h0, pow_zero]
      haveI : Subsingleton ↥A := (Nat.card_eq_one_iff_unique.mp hc).1
      rw [Subgroup.eq_bot_iff_forall]
      intro x hx
      have h2 : (⟨x, hx⟩ : ↥A) = 1 := Subsingleton.elim _ _
      simpa using congrArg Subtype.val h2
    have h3 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by
      have hb : Work.Higman.omega1 P = ⊥ := le_bot_iff.mp (h1 ▸ hNA)
      rw [hb, Subgroup.card_bot]
    have h4 := h.omega1_card_ge_four
    omega
  rcases (show e = 1 ∨ e = 2 by omega) with he | he
  · -- `e = 1`: `A = Ω₁(P) = Z(P)`
    have hAeq : A = Work.Higman.omega1 P := by
      have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.omega1 P) := by rw [hAcard, he, pow_one]
      exact (Subgroup.eq_of_le_of_card_ge hNA (le_of_eq h1)).symm
    refine card_le_cube_of_class_two h hZ ?_ ?_
    · intro x
      rw [hZ, ← hAeq]
      exact hsq x
    · rw [hZ, ← hAeq]
      exact hDA
  · -- `e = 2`
    have hA2 : Work.Higman.powSub A 2 = Work.Higman.omega1 P := by
      have hh := htoplayer
      rw [he, show (2 : ℕ) ^ (2 - 1) = 2 by norm_num] at hh
      rwa [hAinf] at hh
    have hA2card : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
      rw [hAcard, he]
    have hDd_inv : Subgroup.map (h.xi : MulAut P).toMonoidHom ⁅(⊤ : Subgroup P), ⊤⁆
        = ⁅(⊤ : Subgroup P), ⊤⁆ := by
      rw [Subgroup.map_commutator,
        Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective]
    rcases xi_inv_sub_dichotomy_nsm h hAab hAinv hA4 hDA hDd_inv with hbot | hA' | hA'
    · -- `[P,P] = ⊥`: `P` is abelian, contradiction
      exfalso
      obtain ⟨x, y, hxy⟩ := h.noncomm
      exact hxy (commutatorElement_eq_one_iff_mul_comm.mp (by
        have h1 : ⁅x, y⁆ ∈ (⊥ : Subgroup P) := by
          rw [← hbot]
          exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
        simpa using h1))
    · -- `[P,P] = A² = Ω₁(P) = Z(P)`: class two
      have hcl : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Subgroup.center P := by rw [hA', hA2, hZ]
      refine card_le_cube_of_class_two h hZ ?_ hcl
      · intro x
        rw [Subgroup.mem_center_iff]
        intro y
        have h2 : ⁅x, y⁆ ∈ Work.Higman.omega1 P := by
          rw [← hA2, ← hA']
          exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
        have h1 : ⁅x ^ 2, y⁆ = 1 := by
          rw [pow_two, czh_commutator_mul_left hcl x x y, ← pow_two, h.mem_omega1.mp h2]
        exact (commutatorElement_eq_one_iff_mul_comm.mp h1).symm
    · -- `[P,P] = A`: the `C₄` configuration, excluded by `noSquareMaximal`
      exact (noSquareMaximal h hAab hAinv hAmax hNA hA' hsq hA4 hA2 hA2card).elim

end Work.Higman.NSM
end

namespace Work.Higman.NSDEEP
open scoped commutatorElement

/-- **Higman's `C4` exclusion in the maximal setting** (imported from the private assembled
copy).  `A` is a maximal `ξ`-invariant abelian normal subgroup with `Ω₁(P) ≤ A`, `[P,P] = A`,
all squares of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`. -/
theorem noSquareMaximal {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A : Subgroup P}
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAmax : ∀ B : Subgroup P, B.Normal → B.map (h.xi : MulAut P).toMonoidHom = B →
      (∀ x ∈ B, ∀ y ∈ B, x * y = y * x) → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) : False :=
  Work.Higman.NSM.noSquareMaximal h hAab hAinv hAmax hNA hGs hsq hA4 htop hcard

end Work.Higman.NSDEEP
