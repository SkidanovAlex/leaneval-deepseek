# The `C₄` exclusion: reduction of the reducible case to one endgame residual

`Work.Higman.reducible_aux` (Higman 1963, Lemma 8 in the reducible case) is proved here from the
single residual `Work.Higman.RedAux.c4Endgame`, which is the `L₁ × L₂ → L₃` configuration of
Higman's §4 Lemma 6 in the reducible shape.

The reduction is a strong induction on `Nat.card P` for the **full** `C₄` exclusion (`C4Fail`).
Given the `C₄` data:

* if `P ⧸ A` is irreducible the clean `Work.Higman.NSM.irreducible` finishes;
* otherwise take a *minimal* `ξ`-invariant normal cover `C > A` of `A`
  (`Work.Higman.MSA.exists_minimal_covering`); then `C < ⊤`, `C ⧸ A` is `ξ`-irreducible and the
  map `D ↦ D` between `A` and `C` is controlled by `hcover`;
* `⁅C,C⁆` is a `ξ`-invariant subgroup of `A`, hence `⊥`, `A²` or `A` (`RedAux.red_trichotomy`):
  * `⊥`: `C` is abelian, contradicting maximality of `A`;
  * `A`: the pair `(↥C, A.subgroupOf C)` is again a `C₄` instance of smaller order, so the
    induction hypothesis applies;
  * `A²`: then `C²` is a `ξ`-invariant subgroup of `A`, hence `⊥`, `A²` or `A`:
    * `⊥`: `C ≤ Ω₁(P) = A² ≤ A`, contradiction;
    * `A`: Higman's Lemma 7 (`MSA.higman_lemma7_msa`) makes `C` abelian, contradiction;
    * `A²`: `⁅⊤,C⁆` is a `ξ`-invariant subgroup of `A` containing `A²`, hence `A²` or `A`:
      * `A²` with `⁅A,C⁆ = A²`: `A = P² ≤ C_P(C)`, so `⁅A,C⁆ = ⊥`, contradiction;
      * `A²` with `⁅A,C⁆ = ⊥` (and `= A` impossible since `⁅A,C⁆ ≤ A² ≠ A`):
        Gorenstein–Thompson (`NSM.c4gapCentralises`);
      * `A` with `⁅A,C⁆ = ⊥`: Gorenstein–Thompson;
      * `A` with `⁅A,C⁆ = A²`: **the endgame** `RedAux.c4Endgame`.

The auxiliary facts about `ξ`-invariant subgroups of `A` and of `A²` are
`RedAux.red_trichotomy` and `NSM.powSubA2Irreducible`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.style.longLine false
set_option maxHeartbeats 10000000

open scoped commutatorElement

namespace Work.Higman.RedAux

/-- **The `C₄` endgame residual.**  `P` a Suzuki 2-group, `A ⊴ P` a `ξ`-invariant abelian normal
subgroup with `Ω₁(P) ≤ A`, `⁅P,P⁆ = A`, every square of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and
`|A| = |Ω₁(P)|²`; `C` a minimal `ξ`-invariant normal cover of `A` with `⁅C,C⁆ = C² = A²`,
`⁅⊤,C⁆ = A` and `⁅A,C⁆ = A²`.  This is the reducible `L₁ × L₂ → L₃` configuration of Higman §4
Lemma 6; it is the single missing input of `Work.Higman.reducible_aux`. -/
private def c4Endgame : Prop :=
  ∀ (P : Type) [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P},
    Work.Higman.IsXiAbelNormal h A →
    Work.Higman.omega1 P ≤ A →
    ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ = A →
    (∀ x : P, x ^ 2 ∈ A) →
    Work.Higman.powSub A 4 = ⊥ →
    Work.Higman.powSub A 2 = Work.Higman.omega1 P →
    Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 →
    C.Normal →
    C.map (h.xi : MulAut P).toMonoidHom = C →
    A ≤ C → A ≠ C →
    (∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ C → E = A ∨ E = C) →
    ⁅C, C⁆ = Work.Higman.powSub A 2 →
    Work.Higman.powSub C 2 = Work.Higman.powSub A 2 →
    ⁅(⊤ : Subgroup P), C⁆ = A →
    ⁅A, C⁆ = Work.Higman.powSub A 2 →
    False

/-- **The full `C₄` exclusion at order `m`** (Higman 1963, Theorem 1 / Lemma 8): no Suzuki
2-group `P` of order `m` has a `ξ`-invariant abelian normal subgroup `A` with `Ω₁(P) ≤ A`,
`⁅P,P⁆ = A`, all squares of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`. -/
private def C4Fail (m : ℕ) : Prop :=
  ∀ (P : Type) [Group P] [Finite P], Nat.card P = m →
    ∀ (h : Work.Higman.IsSuzuki2Grp P) (A : Subgroup P),
      Work.Higman.IsXiAbelNormal h A →
      Work.Higman.omega1 P ≤ A →
      ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ = A →
      (∀ x : P, x ^ 2 ∈ A) →
      Work.Higman.powSub A 4 = ⊥ →
      Work.Higman.powSub A 2 = Work.Higman.omega1 P →
      Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 →
      False

/-- `⁅x²,y⁆ = ⁅x,⁅x,y⁆⁆ · ⁅x,y⁆²`. -/
private theorem commutatorElement_sq_self' {G : Type} [Group G] (x y : G) :
    ⁅x ^ 2, y⁆ = ⁅x, ⁅x, y⁆⁆ * ⁅x, y⁆ ^ 2 := by
  simp only [commutatorElement_def, pow_two]
  group

/-- **The `C₄` exclusion, reducible case, given the endgame residual.** -/
private theorem c4Fail_all_of_endgame (hEnd : c4Endgame) : ∀ m : ℕ, C4Fail m := by
  classical
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    intro P _ _ hcardP h A hA hNA hGs hsq hA4 htop hcard
    have hAxi : A.map (h.xi : MulAut P).toMonoidHom = A := hA.map_eq
    have hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := hA.abelian
    have hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A :=
      Work.Higman.NSM.c4sqAMaximal h hAxi hAab hNA hGs hsq hA4 htop hcard
    have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
      intro hb
      have h1 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb, Subgroup.card_bot]
      have h4 := h.omega1_card_ge_four
      omega
    have hAne : A ≠ ⊥ := by
      intro hb
      have h1 : Nat.card ↥A = 1 := by rw [hb, Subgroup.card_bot]
      rw [h1] at hcard
      have h4 := h.omega1_card_ge_four
      nlinarith [hcard, h4]
    by_cases hirr : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
        A ≤ D → D = A ∨ D = ⊤
    · exact Work.Higman.NSM.irreducible h hAxi hAab hNA hGs hsq hA4 htop hcard hirr
    · push_neg at hirr
      obtain ⟨D₀, hD₀n, hD₀inv, hAD₀, hD₀A, hD₀top⟩ := hirr
      obtain ⟨C, hCn, hCinv, hAC, hCD₀, hCA, hcover⟩ :=
        Work.Higman.MSA.exists_minimal_covering h hD₀n hD₀inv hAD₀ hD₀A
      have hCtop : C ≠ ⊤ := fun hc => hD₀top (le_antisymm le_top (hc ▸ hCD₀))
      -- `⁅C,C⁆` is `ξ`-invariant and lies in `A`
      have hCdle : ⁅C, C⁆ ≤ A := by
        rw [← hGs]
        exact Subgroup.commutator_mono le_top le_top
      have hCdinv : (⁅C, C⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅C, C⁆ := by
        rw [Subgroup.map_commutator, hCinv]
      rcases red_trichotomy h A (⁅C, C⁆) hA hA4 hCdle hCdinv with hCd | hCd | hCd
      · -- `⁅C,C⁆ = ⊥`: `C` abelian, contradicting maximality of `A`
        have hCab : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x := by
          intro x hx y hy
          refine commutatorElement_eq_one_iff_mul_comm.mp ?_
          have hmem : ⁅x, y⁆ ∈ (⁅C, C⁆ : Subgroup P) :=
            Subgroup.commutator_mem_commutator hx hy
          rw [hCd] at hmem
          simpa using hmem
        exact hCA (hmax C ⟨hCn, hCinv, hCab⟩ hAC)
      · -- `⁅C,C⁆ = A²`: analyse `C²`
        have hC2le : Work.Higman.powSub C 2 ≤ A := by
          rw [Work.Higman.powSub, Subgroup.closure_le]
          rintro y ⟨x, -, rfl⟩
          exact hsq x
        have hC2inv : (Work.Higman.powSub C 2).map (h.xi : MulAut P).toMonoidHom
            = Work.Higman.powSub C 2 := Work.Higman.map_powSub (h.xi : MulAut P) hCinv 2
        rcases red_trichotomy h A (Work.Higman.powSub C 2) hA hA4 hC2le hC2inv
          with hC2 | hC2 | hC2
        · -- `C² = ⊥`: `C ≤ Ω₁(P) = A² ≤ A`
          have hCle : C ≤ Work.Higman.omega1 P := by
            intro x hx
            rw [h.mem_omega1]
            have hx2 : x ^ 2 ∈ Work.Higman.powSub C 2 := Work.Higman.pow_mem_powSub hx
            rw [hC2, Subgroup.mem_bot] at hx2
            exact hx2
          exact hCA (le_antisymm (hCle.trans hNA) hAC)
        · -- `C² = A²`: analyse `⁅⊤,C⁆`
          have hCPle : ⁅(⊤ : Subgroup P), C⁆ ≤ A := by
            rw [← hGs]; exact Subgroup.commutator_mono le_rfl le_top
          have hCPinv : (⁅(⊤ : Subgroup P), C⁆ : Subgroup P).map
              (h.xi : MulAut P).toMonoidHom = ⁅(⊤ : Subgroup P), C⁆ := by
            rw [Subgroup.map_commutator,
              Subgroup.map_top_of_surjective _ (h.xi : MulAut P).surjective, hCinv]
          have hACle : ⁅A, C⁆ ≤ Work.Higman.powSub A 2 :=
            (Subgroup.commutator_mono hAC le_rfl).trans (le_of_eq hCd)
          have hACinv : (⁅A, C⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅A, C⁆ := by
            rw [Subgroup.map_commutator, hAxi, hCinv]
          have hACsplit : ⁅A, C⁆ = ⊥ ∨ ⁅A, C⁆ = Work.Higman.powSub A 2 :=
            Work.Higman.NSM.powSubA2Irreducible h hA htop.symm ⁅A, C⁆ hACle hACinv
          rcases red_trichotomy h A (⁅(⊤ : Subgroup P), C⁆) hA hA4 hCPle hCPinv
            with hCP | hCP | hCP
          · -- `⁅⊤,C⁆ = ⊥` contradicts `⁅C,C⁆ = A²`
            have hle : ⁅C, C⁆ ≤ ⁅(⊤ : Subgroup P), C⁆ :=
              Subgroup.commutator_mono le_top le_rfl
            rw [hCP] at hle
            exact hA2ne (hCd ▸ le_bot_iff.mp hle)
          · -- `⁅⊤,C⁆ = A²`: then `⁅A,C⁆ = ⊥` and `A = P² ≤ C_P(C)`
            rcases hACsplit with hACbot | hACsq
            · exact Work.Higman.NSM.c4gapCentralises h hAxi hAab hNA hGs hsq hA4 htop hcard
                hA hmax hCn hCinv hAC (Ne.symm hCA) hcover hCd (fun c hc a ha =>
                  (commutatorElement_eq_one_iff_mul_comm.mp
                    (Subgroup.mem_bot.mp (by
                      have hmem : ⁅a, c⁆ ∈ (⁅A, C⁆ : Subgroup P) :=
                        Subgroup.commutator_mem_commutator ha hc
                      rw [hACbot] at hmem
                      simpa using hmem))).symm)
            · exfalso
              have hsqcent : ∀ u : P, ∀ c : P, c ∈ C → u ^ 2 * c = c * u ^ 2 := by
                intro u c hc
                have hud : ⁅u, c⁆ ∈ Work.Higman.powSub A 2 := by
                  rw [← hCP]
                  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top u) hc
                have hcent : ⁅u, c⁆ ∈ Subgroup.center P :=
                  h.omega1_le_center (htop ▸ hud)
                have hinv : ⁅u, c⁆ ^ 2 = 1 := h.mem_omega1.mp (htop ▸ hud)
                have h2 : ⁅u, ⁅u, c⁆⁆ = 1 :=
                  commutatorElement_eq_one_iff_mul_comm.mpr
                    (Subgroup.mem_center_iff.mp hcent u)
                have h4 : ⁅u ^ 2, c⁆ = 1 := by
                  rw [commutatorElement_sq_self' u c, h2, hinv, one_mul]
                exact commutatorElement_eq_one_iff_mul_comm.mp h4
              have h1 : A ≤ Subgroup.centralizer (C : Set P) := by
                rw [← Work.Higman.nsd_powSub_top_eq h hAxi hAab hGs hsq htop hcard,
                  Work.Higman.powSub, Subgroup.closure_le]
                rintro y ⟨u, -, rfl⟩
                exact Subgroup.mem_centralizer_iff.mpr (fun c hc => (hsqcent u c hc).symm)
              have h2 : ⁅A, C⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr h1
              rw [hACsq] at h2
              exact hA2ne h2
          · -- `⁅⊤,C⁆ = A`: the endgame (or Gorenstein–Thompson)
            rcases hACsplit with hACbot | hACsq
            · exact Work.Higman.NSM.c4gapCentralises h hAxi hAab hNA hGs hsq hA4 htop hcard
                hA hmax hCn hCinv hAC (Ne.symm hCA) hcover hCd (fun c hc a ha =>
                  (commutatorElement_eq_one_iff_mul_comm.mp
                    (Subgroup.mem_bot.mp (by
                      have hmem : ⁅a, c⁆ ∈ (⁅A, C⁆ : Subgroup P) :=
                        Subgroup.commutator_mem_commutator ha hc
                      rw [hACbot] at hmem
                      simpa using hmem))).symm)
            · exact hEnd P h hA hNA hGs hsq hA4 htop hcard hCn hCinv hAC (Ne.symm hCA) hcover hCd hC2
                hCP hACsq
        · -- `C² = A`: Higman's Lemma 7 makes `C` abelian
          have hPhi : Work.Higman.powSub C 2 ⊔ ⁅C, C⁆ = A := by
            rw [hC2, hCd]
            exact sup_eq_left.mpr (Work.Higman.powSub_le (n := 2) (by norm_num))
          have hab : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x :=
            Work.Higman.MSA.higman_lemma7_msa h hA hCn hCinv hAC (Ne.symm hCA) hcover hPhi
              (le_of_eq hCd) 
          exact hA2ne (by
            rw [← hCd, Subgroup.commutator_eq_bot_iff_le_centralizer]
            intro x hx
            rw [Subgroup.mem_centralizer_iff]
            intro y hy
            exact (hab x hx y hy).symm)
      · -- `⁅C,C⁆ = A`: descend to `↥C` and apply the induction hypothesis
        have hni : ∃ x y : ↥C, x * y ≠ y * x := by
          by_contra hcon
          push_neg at hcon
          have hcomm : ∀ x ∈ C, ∀ y ∈ C, x * y = y * x :=
            fun x hx y hy => congrArg Subtype.val (hcon ⟨x, hx⟩ ⟨y, hy⟩)
          have h2 : ⁅C, C⁆ ≤ (⊥ : Subgroup P) := by
            rw [Subgroup.commutator_le]
            intro x hx y hy
            rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
            exact hcomm x hx y hy
          rw [hCd, le_bot_iff] at h2
          exact hAne h2
        obtain ⟨hCSz, hCSzdef⟩ : ∃ sz : Work.Higman.IsSuzuki2Grp ↥C,
            (sz.xi : MulAut ↥C) = xiSubRG h hCinv :=
          ⟨isSuzuki2Grp_subgroupRG h hCinv (hNA.trans hAC) hni, rfl⟩
        have hCcard_lt : Nat.card ↥C < m := by
          rw [← hcardP]
          exact lt_of_le_of_ne
            (Nat.card_le_card_of_injective (Subgroup.subtype C) (Subgroup.subtype_injective C))
            (fun hcon => hCtop (Subgroup.eq_top_of_card_eq C hcon))
        have hom : Work.Higman.omega1 ↥C = (Work.Higman.omega1 P).subgroupOf C :=
          omega1_subgroupOf h hCSz
        have hA4' : Work.Higman.powSub (A.subgroupOf C) 4 = ⊥ := by
          rw [powSub_subgroupOf hAC (by norm_num : 0 < 4), hA4]
          exact Subgroup.bot_subgroupOf C
        have htop' : Work.Higman.powSub (A.subgroupOf C) 2 = Work.Higman.omega1 ↥C := by
          rw [powSub_subgroupOf hAC (by norm_num : 0 < 2), htop, hom]
        have hom2 : Nat.card ↥(Work.Higman.omega1 ↥C) = Nat.card ↥(Work.Higman.omega1 P) := by
          rw [hom, card_subgroupOf (hNA.trans hAC)]
        have hcard' : Nat.card ↥(A.subgroupOf C)
            = (Nat.card ↥(Work.Higman.omega1 ↥C)) ^ 2 := by
          rw [card_subgroupOf hAC, hom2]
          exact hcard
        have hAisC : Work.Higman.IsXiAbelNormal hCSz (A.subgroupOf C) :=
          ⟨hA.normal.subgroupOf C,
            (by rw [hCSzdef]
                exact map_xiSubRG_subgroupOf h hCinv hAxi (hAD := hAC)),
            (fun x hx y hy => Subtype.ext
              (hAab x (Subgroup.mem_subgroupOf.mp hx) y (Subgroup.mem_subgroupOf.mp hy)))⟩
        have hNAC : Work.Higman.omega1 ↥C ≤ A.subgroupOf C := by
          rw [hom]; exact Subgroup.subgroupOf_mono C hNA
        have hGsC : ⁅(⊤ : Subgroup ↥C), (⊤ : Subgroup ↥C)⁆ = A.subgroupOf C :=
          commutator_top_subgroupOf hAC hCd
        have hsqC : ∀ x : ↥C, x ^ 2 ∈ A.subgroupOf C :=
          fun x => Subgroup.mem_subgroupOf.mpr (hsq (x : P))
        exact ih (Nat.card ↥C) hCcard_lt ↥C rfl hCSz (A.subgroupOf C) hAisC hNAC hGsC hsqC
          hA4' htop' hcard'

/-- **The `C₄`-shape is excluded when `P / A` is reducible** (Higman 1963, Lemma 8 / §4
Lemma 6), given the endgame residual `RedAux.c4Endgame`. -/
private theorem reducible_aux_of_endgame (hEnd : c4Endgame) {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : commutator P = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hnirr : ¬ (∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D = A ∨ D = ⊤)) :
    False := by
  have hAn : A.Normal := by rw [← hGs]; exact Subgroup.commutator_normal ⊤ ⊤
  have hGs' : ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ = A := by
    simpa [commutator] using hGs
  have hfail := c4Fail_all_of_endgame hEnd (Nat.card P)
  exact hfail P rfl h A ⟨hAn, hAxi, hAab⟩ hNA hGs' hsq hA4 htop hcard

end Work.Higman.RedAux
end

-- ===== from Submission.Work.Higman.RedAux.c4_endgame =====
section

namespace Work.Higman.RedAux

private theorem c4_endgame {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ C → E = A ∨ E = C)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hC2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hCP : ⁅(⊤ : Subgroup P), C⁆ = A)
    (hACd : ⁅A, C⁆ = Work.Higman.powSub A 2) :
    False := by sorry

end Work.Higman.RedAux
end

-- ===== from Submission.Work.Higman.reducible_aux =====
section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped commutatorElement

namespace Work.Higman

variable {P : Type} [Group P] [Finite P]

/-!
# `Work.Higman.reducible_aux` — the reducible case of the `C₄` exclusion

`P` is a Suzuki 2-group and `A ⊴ P` is a `ξ`-invariant abelian normal subgroup with
`Ω₁(P) ≤ A`, `[P,P] = A`, every square of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and
`|A| = |Ω₁(P)|²`.  If in addition `P/A` is *reducible* — there is a `ξ`-invariant normal subgroup
strictly between `A` and `P` — then this is contradictory (`C₄` is excluded).

The extra hypothesis is not needed for the *mathematics* to be contradictory: the general `C₄`
exclusion `H8.c4_exclusion` (Higman 1963, Theorem 1 / §4 Lemma 6, §5 Lemma 8) applies to a
**maximal** `ξ`-invariant abelian normal subgroup.  The work here is to show that the given `A`
is maximal (`maximal_of_c4_data`): if `B ⊇ A` is `ξ`-invariant abelian normal, then `B² ⊆ A`
(every square of `P` lies in `A`) and `B² ⊇ A²`, so by the trichotomy for `ξ`-invariant subgroups
of `A` (`H8.c4_xi_inv_sub_trichotomy`) `B² ∈ {A², A}`; the case `B² = A` is excluded by Higman's
Lemma 9 (`Work.Higman.powSub_four_bot_of_maximal'`: a maximal `ξ`-invariant abelian normal
subgroup has exponent dividing `4`, hence `B⁴ = 1`, but `B⁴ = (B²)² = A² = Ω₁(P) ≠ 1`), and the
case `B² = A²` forces `|B| = |B ⊓ Ω₁(P)| · |B²| = |Ω₁(P)| · |A²| = q² = |A|`, i.e. `B = A`
(`card_le_of_abelian_of_sq_eq`).
-/

/-- A subgroup of exponent two is abelian. -/
private theorem commutator_eq_bot_of_sq_eq_bot {C : Subgroup P}
    (hC2 : Work.Higman.powSub C 2 = ⊥) : ⁅C, C⁆ = ⊥ := by
  have hsq : ∀ x ∈ C, x * x = 1 := by
    intro x hx
    have hmem : x ^ 2 ∈ (⊥ : Subgroup P) := by
      rw [← hC2]; exact pow_mem_powSub (n := 2) hx
    simpa [pow_two] using Subgroup.mem_bot.mp hmem
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  intro x hx
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hx' : x⁻¹ = x := by
    calc x⁻¹ = x⁻¹ * 1 := (mul_one _).symm
      _ = x⁻¹ * (x * x) := by rw [hsq x hx]
      _ = x := by rw [← mul_assoc, inv_mul_cancel, one_mul]
  have hy' : y⁻¹ = y := by
    calc y⁻¹ = y⁻¹ * 1 := (mul_one _).symm
      _ = y⁻¹ * (y * y) := by rw [hsq y hy]
      _ = y := by rw [← mul_assoc, inv_mul_cancel, one_mul]
  have hxy : (x * y)⁻¹ = x * y := by
    calc (x * y)⁻¹ = (x * y)⁻¹ * 1 := (mul_one _).symm
      _ = (x * y)⁻¹ * ((x * y) * (x * y)) := by rw [hsq (x * y) (C.mul_mem hx hy)]
      _ = x * y := by rw [← mul_assoc, inv_mul_cancel, one_mul]
  calc y * x = y⁻¹ * x⁻¹ := by rw [hy', hx']
    _ = (x * y)⁻¹ := (mul_inv_rev x y).symm
    _ = x * y := hxy

/-- **Counting lemma.**  Let `E` be abelian with `E² = A²`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`.
Squaring is a homomorphism `E → A` whose kernel is `E ⊓ Ω₁(P) = A²` and whose image lies in
`E² = A²`; hence `|E| = |E²| · |image| ≤ |A²|² = |A|`.  (Applied to an abelian `B ⊇ A` with
`B² = A²` it gives `B = A`.) -/
private theorem card_le_of_abelian_of_sq_eq (h : IsSuzuki2Grp P) {A E : Subgroup P}
    (hEab : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x)
    (hE2 : Work.Higman.powSub E 2 = Work.Higman.powSub A 2)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    Nat.card ↥E ≤ Nat.card ↥A := by
  classical
  have hA2le : Work.Higman.powSub A 2 ≤ A := powSub_le (by norm_num)
  have hA2E : Work.Higman.powSub A 2 ≤ E := hE2 ▸ powSub_le (by norm_num)
  -- the squaring map `↥E →* ↥A`
  let φ : ↥E →* ↥A :=
    { toFun := fun x => ⟨(x : P) * (x : P), by
        have hmem : (x : P) ^ 2 ∈ Work.Higman.powSub E 2 := pow_mem_powSub (n := 2) x.2
        rw [hE2] at hmem
        exact hA2le (by simpa [pow_two] using hmem)⟩
      map_one' := by
        ext
        show (1 : P) * 1 = 1
        simp
      map_mul' := fun x y => by
        ext
        show (((x * y : ↥E)) : P) * (((x * y : ↥E)) : P)
            = (x : P) * (x : P) * ((y : P) * (y : P))
        rw [Subgroup.coe_mul]
        have hc : (x : P) * (y : P) = (y : P) * (x : P) := hEab (x : P) x.2 (y : P) y.2
        calc (x : P) * (y : P) * ((x : P) * (y : P))
            = (x : P) * ((y : P) * (x : P)) * (y : P) := by group
          _ = (x : P) * ((x : P) * (y : P)) * (y : P) := by rw [hc]
          _ = (x : P) * (x : P) * ((y : P) * (y : P)) := by group }
  have hcardE : Nat.card ↥E = Nat.card ↥φ.ker * Nat.card ↥φ.range := by
    have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (φ.ker : Subgroup ↥E)
    have h2 : Nat.card (↥E ⧸ φ.ker) = Nat.card ↥φ.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
    rw [h2, mul_comm] at h1
    exact h1
  -- the kernel is `A ^ (2)` (viewed inside `E`)
  have hker : φ.ker = (Work.Higman.powSub A 2).subgroupOf E := by
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    constructor
    · intro hx
      have hx2 : (x : P) ^ 2 = 1 := by
        have hc := congrArg (fun y : ↥A => (y : P)) hx
        simpa [φ, pow_two] using hc
      have hom : (x : P) ∈ Work.Higman.omega1 P := h.mem_omega1.mpr hx2
      rw [← htop] at hom
      exact hom
    · intro hx
      have hom : (x : P) ∈ Work.Higman.omega1 P := by rw [← htop]; exact hx
      have hx2 : (x : P) ^ 2 = 1 := h.mem_omega1.mp hom
      show φ x = 1
      apply Subtype.ext
      simpa [φ, pow_two] using hx2
  have hkerCard : Nat.card ↥φ.ker = Nat.card ↥(Work.Higman.powSub A 2) := by
    rw [hker]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA2E).toEquiv
  -- the image lies in `E ^ (2) = A ^ (2)`
  have hrangeLe : Nat.card ↥φ.range ≤ Nat.card ↥(Work.Higman.powSub A 2) := by
    have hsub : (φ.range : Set ↥A) ⊆ ((Work.Higman.powSub A 2).subgroupOf A : Set ↥A) := by
      rintro y ⟨x, rfl⟩
      refine Subgroup.mem_subgroupOf.mpr ?_
      have hmem : (x : P) ^ 2 ∈ Work.Higman.powSub E 2 := pow_mem_powSub (n := 2) x.2
      rw [hE2] at hmem
      simpa [φ, pow_two] using hmem
    calc Nat.card ↥φ.range
        ≤ Nat.card ↥((Work.Higman.powSub A 2).subgroupOf A) :=
          Nat.card_le_card_of_injective (Subgroup.inclusion hsub)
            (Subgroup.inclusion_injective hsub)
      _ = Nat.card ↥(Work.Higman.powSub A 2) :=
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA2le).toEquiv
  have hA2card : Nat.card ↥(Work.Higman.powSub A 2) = Nat.card ↥(Work.Higman.omega1 P) := by
    rw [htop]
  calc Nat.card ↥E = Nat.card ↥φ.ker * Nat.card ↥φ.range := hcardE
    _ ≤ Nat.card ↥(Work.Higman.powSub A 2) * Nat.card ↥(Work.Higman.powSub A 2) := by
        rw [hkerCard]
        exact Nat.mul_le_mul_left _ hrangeLe
    _ = Nat.card ↥A := by rw [hA2card, hcard, pow_two]

/-- **The `C₄` data forces `A` to be maximal.**  If `A ⊴ P` is `ξ`-invariant abelian with
`Ω₁(P) ≤ A`, every square of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)` and `|A| = |Ω₁(P)|²`, then `A` is
maximal among the `ξ`-invariant abelian normal subgroups of `P`.

Take a maximal `ξ`-invariant abelian normal `B ⊇ A`.  Its square `B²` lies in `A` (every square of
`P` does) and contains `A²`, so by the trichotomy for `ξ`-invariant subgroups of `A` it is `A²`
or `A`.  If `B² = A` then `B⁴ = A² = Ω₁(P) ≠ 1`, contradicting Higman's Lemma 9 (`B⁴ = 1` for a
maximal `B`, `Work.Higman.powSub_four_bot_of_maximal'`).  Hence `B² = A²`, and then
`|B| = |B ⊓ Ω₁(P)| · |B²| = |Ω₁(P)| · |A²| = q² = |A|`, so `B = A`. -/
private theorem maximal_of_c4_data (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hA : IsXiAbelNormal h A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A := by
  intro B hB hAB
  -- a maximal `ξ`-invariant abelian normal subgroup `B₀ ⊇ B`, hence `⊇ A`
  have hfin : ({B' : Subgroup P | IsXiAbelNormal h B' ∧ B ≤ B'}).Finite :=
    Set.finite_univ.subset (fun _ _ => trivial)
  obtain ⟨B₀, hB₀⟩ := hfin.exists_maximal ⟨B, ⟨hB, le_rfl⟩⟩
  obtain ⟨hB₀i, hBB₀⟩ := hB₀.1
  have hAB₀ : A ≤ B₀ := hAB.trans hBB₀
  have hB₀max : ∀ B' : Subgroup P, IsXiAbelNormal h B' → B₀ ≤ B' → B' = B₀ :=
    fun B' hB' hle => le_antisymm (hB₀.2 ⟨hB', hBB₀.trans hle⟩ hle) hle
  -- Higman's Lemma 9: `B₀` has exponent dividing `4`
  have hB₀4 : Work.Higman.powSub B₀ 4 = ⊥ :=
    Work.Higman.powSub_four_bot_of_maximal' h hB₀i hB₀max
  have hB₀ab : ∀ x ∈ B₀, ∀ y ∈ B₀, x * y = y * x := hB₀i.abelian
  -- `A² ≤ B₀²` and `B₀² ≤ A`
  have hA2le : Work.Higman.powSub A 2 ≤ Work.Higman.powSub B₀ 2 := powSub_mono hAB₀
  have hB₀2le : Work.Higman.powSub B₀ 2 ≤ A := by
    rw [powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  have hB₀2inv : (Work.Higman.powSub B₀ 2).map (h.xi : MulAut P).toMonoidHom =
      Work.Higman.powSub B₀ 2 := map_powSub (h.xi : MulAut P) hB₀i.map_eq 2
  have hA2ne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hb
    have h3 : Nat.card ↥(Work.Higman.omega1 P) = 1 := by rw [← htop, hb]; simp
    have h5 := h.omega1_card_ge_four
    omega
  -- the trichotomy for `B₀²`
  have hB₀2 : Work.Higman.powSub B₀ 2 = Work.Higman.powSub A 2 := by
    rcases RedAux.red_trichotomy h A (Work.Higman.powSub B₀ 2) hA hA4 hB₀2le hB₀2inv
      with h2 | h2 | h2
    · -- `B₀² = ⊥`, contradicting `A² ≤ B₀²` and `A² ≠ ⊥`
      exact absurd (le_bot_iff.mp (h2 ▸ hA2le)) hA2ne
    · exact h2
    · -- `B₀² = A`: then `B₀⁴ = A² = Ω₁(P) ≠ ⊥`, contradicting Higman's Lemma 9
      exfalso
      have h4 : Work.Higman.powSub B₀ 4 = Work.Higman.powSub A 2 := by
        rw [← Work.Higman.powSub_powSub hB₀ab 2 2, h2]
      rw [hB₀4] at h4
      exact hA2ne h4.symm
  -- counting: `|B₀| ≤ |A|`, and `A ≤ B₀`, so `B₀ = A`
  have hle : Nat.card ↥B₀ ≤ Nat.card ↥A :=
    card_le_of_abelian_of_sq_eq h hB₀ab hB₀2 htop hcard
  have hB₀A : A = B₀ := Subgroup.eq_of_le_of_card_ge hAB₀ hle
  exact le_antisymm (hBB₀.trans (le_of_eq hB₀A.symm)) hAB

/-- **The `C₄`-shape is excluded when `P / A` is reducible** (Higman 1963, Lemma 8 / §4
Lemma 6).  Same hypotheses as `Work.Higman.no_square_maximal`, together with the existence of a
`ξ`-invariant normal subgroup strictly between `A` and `P`. -/
private theorem reducible_aux {P : Type} [Group P] [Finite P]
    (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAxi : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hAab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : commutator P = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hnirr : ¬ (∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D = A ∨ D = ⊤)) :
    False := by
  have hEnd : RedAux.c4Endgame := by
    intro P' _ _ h' A' C' hA' hNA' hGs' hsq' hA4' htop' hcard' hCn' hCinv' hAC' hCA'
      hcover' hCd' hC2' hCP' hACd'
    exact RedAux.c4_endgame h' hA' hNA' hGs' hsq' hA4' htop' hcard' hCn' hCinv' hAC' hCA'
      hcover' hCd' hC2' hCP' hACd'
  exact RedAux.reducible_aux_of_endgame hEnd h hAxi hAab hNA hGs hsq hA4 htop hcard hnirr

end Work.Higman
end

-- ===== from Submission.Work.Higman.Q3.crux_case_large_hard =====
section

open scoped commutatorElement

set_option maxHeartbeats 1000000

namespace Work.Higman.Q3

variable {P : Type} [Group P] [Finite P]

/-- In the crux configuration the squares generate exactly `A`: `P ^ (2) = A`.

Indeed `P ^ (2) ≤ A` by hypothesis, while `⁅P,P⁆ ≤ P ^ (2)` always (via
`⁅x,y⁆ = x² · (x⁻¹ * y)² · (y²)⁻¹`) and `⁅P,P⁆ = A`. -/
private theorem crux_powSub_top_two_eq {A : Subgroup P}
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A) (hsq : ∀ x : P, x ^ 2 ∈ A) :
    Work.Higman.powSub (⊤ : Subgroup P) 2 = A := by
  refine le_antisymm ?_ ?_
  · rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  · rw [← hGs, Subgroup.commutator_le]
    intro x _ y _
    have key : ⁅x, y⁆ = x ^ 2 * (x⁻¹ * y) ^ 2 * (y ^ 2)⁻¹ := by
      rw [commutatorElement_def, pow_two (a := x), pow_two (a := x⁻¹ * y), pow_two (a := y)]
      group
    rw [key]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _
      (Work.Higman.pow_mem_powSub (Subgroup.mem_top x))
      (Work.Higman.pow_mem_powSub (Subgroup.mem_top (x⁻¹ * y))))
      (Subgroup.inv_mem _ (Work.Higman.pow_mem_powSub (Subgroup.mem_top y)))

/-- In the crux configuration, `⁅P,P⁆ ≤ Ω₁(P)` is already contradictory.

`A = ⁅P,P⁆ ≤ Ω₁(P) = A ^ (2) ≤ A` forces `A = A ^ (2)`, i.e. `|A| = |Ω₁(P)|`, whereas
`hcard` gives `|A| = |Ω₁(P)| ^ 2` with `|Ω₁(P)| ≥ 4`.

This shows that the crux statement is *equivalent* to the `C₄`-exclusion
(`⁅P,P⁆ ≤ Ω₁(P)` for every Suzuki 2-group), i.e. to Higman's Lemma 8 endgame. -/
private theorem crux_false_of_comm_le_omega1 (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcomm : Bracket.bracket (⊤ : Subgroup P) ⊤ ≤ Work.Higman.omega1 P) : False := by
  have hAle : A ≤ Work.Higman.powSub A 2 := by
    calc A = Bracket.bracket (⊤ : Subgroup P) ⊤ := hGs.symm
      _ ≤ Work.Higman.omega1 P := hcomm
      _ = Work.Higman.powSub A 2 := htop.symm
  have hEq : A = Work.Higman.powSub A 2 :=
    le_antisymm hAle (Work.Higman.powSub_le (A := A) (n := 2) (by norm_num))
  have h1 : Nat.card ↥(Work.Higman.omega1 P) = Nat.card ↥A := by rw [← htop, ← hEq]
  have h2 : Nat.card ↥(Work.Higman.omega1 P)
      = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
    have hh := hcard
    rw [← h1] at hh
    exact hh
  have h4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
  nlinarith [h2, h4]

/-- Consequently, in the crux configuration, `A` does *not* generate `Ω₁(P)`: the
`middle layer` `A / A ^ (2)` is genuinely non-trivial (this is the "class three" shape). -/
private theorem crux_A_ne_powSub_two (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    A ≠ Work.Higman.powSub A 2 := by
  intro hEq
  have h1 : Nat.card ↥(Work.Higman.omega1 P) = Nat.card ↥A := by rw [← htop, ← hEq]
  have h2 : Nat.card ↥(Work.Higman.omega1 P)
      = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
    have hh := hcard
    rw [← h1] at hh
    exact hh
  have h4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
  nlinarith [h2, h4]

/-- A non-trivial `ξ`-invariant subgroup of `Ω₁(P)` is all of `Ω₁(P)`: `ξ` is transitive on the
involutions. -/
private theorem crux_eq_omega1_of_ne_bot {S : Subgroup P} (h : Work.Higman.IsSuzuki2Grp P)
    (hS : S ≤ Work.Higman.omega1 P) (hSinv : S.map (h.xi : MulAut P).toMonoidHom = S)
    (hne : S ≠ ⊥) : S = Work.Higman.omega1 P := by
  refine le_antisymm hS ?_
  obtain ⟨x, hx1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hne
  have hxS : (x : P) ∈ S := x.2
  have hx1' : (x : P) ≠ 1 := fun hc => hx1 (Subtype.ext hc)
  have hx2 : (x : P) ^ 2 = 1 := h.mem_omega1.mp (hS hxS)
  have hxord : orderOf (x : P) = 2 := by
    have hdvd : orderOf (x : P) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hx2
    have hle : orderOf (x : P) ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
    have hpos : 0 < orderOf (x : P) := orderOf_pos _
    have hne1 : orderOf (x : P) ≠ 1 := fun hc => hx1' (orderOf_eq_one_iff.mp hc)
    omega
  have hstep : ∀ k : ℕ, ∀ y ∈ S, (h.xi ^ k) y ∈ S := by
    intro k
    induction k with
    | zero => intro y hy; simpa using hy
    | succ k ih =>
        intro y hy
        have hz : (h.xi ^ k) y ∈ S := ih y hy
        have hgoal : (h.xi ^ (k + 1)) y = h.xi ((h.xi ^ k) y) := by
          rw [pow_succ', MulAut.mul_apply]
        rw [hgoal]
        have hmem : h.xi ((h.xi ^ k) y) ∈ S.map (h.xi : MulAut P).toMonoidHom :=
          Subgroup.mem_map_of_mem _ hz
        rwa [hSinv] at hmem
  intro y hy
  rcases eq_or_ne y 1 with rfl | hy1
  · exact S.one_mem
  · have hyord : orderOf y = 2 := by
      rcases (Nat.dvd_prime Nat.prime_two).mp
        (orderOf_dvd_iff_pow_eq_one.mpr (h.mem_omega1.mp hy)) with h1 | h2
      · exact absurd (orderOf_eq_one_iff.mp h1) hy1
      · exact h2
    obtain ⟨k, hk⟩ := h.trans (x : P) y hxord hyord
    rw [← hk]
    exact hstep k (x : P) hxS

/-- **The bracket pairing takes values in `A ^ (2)`**: `⁅A,D⁆ = A ^ (2)` whenever `A ⊴ P` is
`ξ`-invariant abelian, `A ^ (2) = Ω₁(P)`, `A ^ (4) = 1`, `D` is `ξ`-invariant with `A ≤ D` and
`D` does not centralise `A`.

Unipotence gives `⁅A,D⁆ ≤ A ^ (2)`; `⁅A,D⁆ ≠ ⊥` is the hypothesis that `D` does not centralise
`A`; and `Ω₁(P)` is `ξ`-irreducible, so a non-trivial `ξ`-invariant subgroup of it is all of it.

This is the well-definedness input for the bracket `θ : P/A × A/A² → A²` appearing in Higman's
§4 Lemma 6 configuration. -/
private theorem crux_comm_A_D_eq (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hAD : A ≤ D) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e)) :
    Bracket.bracket A D = Work.Higman.powSub A 2 := by
  have hle : Bracket.bracket A D ≤ Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_le]
    intro a ha d _
    have h2 : ⁅a, d⁆ = ⁅d, a⁆⁻¹ := by
      rw [commutatorElement_def, commutatorElement_def]; group
    rw [h2]
    exact (Work.Higman.powSub A 2).inv_mem
      (Work.Higman.commutator_mem_powSub_two h hA d a ha)
  have hne : Bracket.bracket A D ≠ ⊥ := by
    intro hbot
    apply hnZ
    intro e he a ha
    have hmem : ⁅a, e⁆ ∈ (⊥ : Subgroup P) := by
      rw [← hbot]
      exact Subgroup.commutator_mem_commutator ha he
    have h1 : ⁅a, e⁆ = 1 := Subgroup.mem_bot.mp hmem
    have h2 : ⁅e, a⁆ = 1 := by
      rw [show ⁅e, a⁆ = ⁅a, e⁆⁻¹ by
        rw [commutatorElement_def, commutatorElement_def]; group, h1, inv_one]
    exact commutatorElement_eq_one_iff_mul_comm.mp h2
  have hinv : (Bracket.bracket A D).map (h.xi : MulAut P).toMonoidHom
      = Bracket.bracket A D := by
    rw [Subgroup.map_commutator, hA.map_eq, hDinv]
  have := crux_eq_omega1_of_ne_bot h (htop ▸ hle) hinv hne
  rw [this, ← htop]

/-! ## The `ξ`-fixed-point lemmas

The crux configuration forces `ξ` to act **fixed-point-freely**: no non-trivial element of `A`
and none of `P` is fixed by `ξ`.  This is the input for the `|xξx⁻¹| = |Ω₁(P)|` orbit argument
used in Higman's §4 bookkeeping. -/

/-- `ξ` fixes no non-trivial element of `Ω₁(P)`. -/
private theorem crux_xi_fixed_omega1_eq_one (h : Work.Higman.IsSuzuki2Grp P) {z : P}
    (hz : z ∈ Work.Higman.omega1 P) (hfix : h.xi z = z) : z = 1 := by
  by_contra hne
  have hz2 : z ^ 2 = 1 := h.mem_omega1.mp hz
  have hzord : orderOf z = 2 := by
    have hd : orderOf z ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hz2
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h1
    · exact absurd (orderOf_eq_one_iff.mp h1) hne
    · exact h1
  obtain ⟨u, v, hu2, hv2, huv⟩ := h.manyInvol
  have hfixk : ∀ k : ℕ, (h.xi ^ k) z = z := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', MulAut.mul_apply, ih, hfix]
  have hzu : u = z := by
    obtain ⟨k, hk⟩ := h.trans z u hzord hu2
    rw [← hk]; exact hfixk k
  have hzv : v = z := by
    obtain ⟨k, hk⟩ := h.trans z v hzord hv2
    rw [← hk]; exact hfixk k
  exact huv (hzu.trans hzv.symm)

/-- `C_A(ξ) = 1`. -/
private theorem crux_C_A_xi_eq_one (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) {a : P} (ha : a ∈ A)
    (hfix : h.xi a = a) : a = 1 := by
  have ha2A : a ^ 2 ∈ Work.Higman.powSub A 2 := Work.Higman.pow_mem_powSub ha
  rw [htop] at ha2A
  have hfix2 : h.xi (a ^ 2) = a ^ 2 := by rw [map_pow, hfix]
  have h2 : a ^ 2 = 1 := crux_xi_fixed_omega1_eq_one h ha2A hfix2
  exact crux_xi_fixed_omega1_eq_one h (h.mem_omega1.mpr h2) hfix

/-- `C_P(ξ) = 1`. -/
private theorem crux_C_P_xi_eq_one (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ A) {x : P} (hfix : h.xi x = x) : x = 1 := by
  have h2 : x ^ 2 = 1 := crux_C_A_xi_eq_one h hA htop (hsq x) (by rw [map_pow, hfix])
  exact crux_xi_fixed_omega1_eq_one h (h.mem_omega1.mpr h2) hfix

/-- If some `x ∉ Ω₁(P)` is fixed by `ξ` **modulo** `Ω₁(P)`, we are done: `x²` is then fixed by
`ξ`, hence trivial, so `x` itself is an involution fixed by `ξ`. -/
private theorem crux_false_of_xi_fixed_mod_omega1 (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hx : ∃ x : P, x ∉ Work.Higman.omega1 P ∧ (h.xi x) * x⁻¹ ∈ Work.Higman.omega1 P) :
    False := by
  obtain ⟨x, hxZ, hzmem⟩ := hx
  have hz1 : ((h.xi x) * x⁻¹) * ((h.xi x) * x⁻¹) = 1 := by
    have hh : ((h.xi x) * x⁻¹) ^ 2 = 1 := h.mem_omega1.mp hzmem
    rwa [pow_two] at hh
  have hzc : ∀ y : P, ((h.xi x) * x⁻¹) * y = y * ((h.xi x) * x⁻¹) :=
    fun y => (Subgroup.mem_center_iff.mp (h.omega1_le_center hzmem) y).symm
  have hxx : (h.xi x) * (h.xi x) = x * x := by
    have h1 : ((h.xi x) * x⁻¹) * x = h.xi x := by group
    rw [← h1]
    calc ((h.xi x) * x⁻¹) * x * (((h.xi x) * x⁻¹) * x)
        = ((h.xi x) * x⁻¹) * (x * ((h.xi x) * x⁻¹)) * x := by group
      _ = ((h.xi x) * x⁻¹) * (((h.xi x) * x⁻¹) * x) * x := by
            rw [(hzc x).symm]
      _ = (((h.xi x) * x⁻¹) * ((h.xi x) * x⁻¹)) * (x * x) := by group
      _ = x * x := by rw [hz1, one_mul]
  have hfix2 : h.xi (x ^ 2) = x ^ 2 := by rw [map_pow, pow_two, pow_two]; exact hxx
  have h2 : x ^ 2 = 1 := crux_C_A_xi_eq_one h hA htop (hsq x) hfix2
  exact hxZ (h.mem_omega1.mpr h2)

/-- **Case A of the crux is impossible.**  If some `d ∈ D` outside `A` is fixed by `ξ` modulo
`A`, then `ξ` fixes all of `Ω₁(P)` pointwise
(`Work.Higman.fixed_coset_imp_fix_all`), contradicting the transitivity of `ξ` on the
involutions. -/
private theorem crux_false_of_xi_fixed_coset_mod_A (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hx : ∃ d : P, d ∈ D ∧ d ∉ A ∧ (h.xi d) * d⁻¹ ∈ A) : False := by
  obtain ⟨d, -, hdA, hfixd⟩ := hx
  have hNA : Work.Higman.omega1 P ≤ A := htop ▸ Work.Higman.powSub_le (A := A) (by norm_num)
  have hall : ∀ w ∈ Work.Higman.omega1 P, h.xi w = w :=
    Work.Higman.fixed_coset_imp_fix_all h hA.normal hA.map_eq hA.abelian hNA htop hsq
      (k := 1) hdA (by simpa using hfixd)
  obtain ⟨u, v, hu2, hv2, huv⟩ := h.manyInvol
  have hu1 : u ∈ Work.Higman.omega1 P :=
    h.mem_omega1.mpr (hu2 ▸ pow_orderOf_eq_one u)
  have hfixu : h.xi u = u := hall u hu1
  have hfixall : ∀ m : ℕ, (h.xi ^ m) u = u := by
    intro m
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ', MulAut.mul_apply, ih, hfixu]
  obtain ⟨j, hj⟩ := h.trans u v hu2 hv2
  exact huv ((hfixall j).symm.trans hj)

/-- **`(P/A)^ξ = 0`.**  No non-trivial coset of `A` is fixed by `ξ`; equivalently `ξ - 1` is a
bijection of `P/A`.  This is the hypothesis that makes the `P/A`-orbit counting sharp and that
excludes the counterexample to the naive `𝔽₂`-module bookkeeping. -/
private theorem crux_not_xi_fixed (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hsq : ∀ x : P, x ^ 2 ∈ A) :
    ∀ x : P, x ∉ A → (h.xi x) * x⁻¹ ∉ A := by
  intro x hx hfix
  exact crux_false_of_xi_fixed_coset_mod_A h hA htop hsq ⟨x, Subgroup.mem_top x, hx, hfix⟩

/-! ## The `ξ`-action on the two layers of `A`

`A` is a two-step abelian group: `A² = Ω₁(P)` is the elementary abelian *bottom* layer and
`A/A²` the *top* layer.  `ξ` acts on the bottom layer as a Singer cycle (`ξ` is transitive on
the involutions and fixes no non-trivial one).  The top layer is more delicate: `ξ` fixes no
non-trivial element of `A` (`crux_C_A_xi_eq_one`), but the coset `a·A²` *is* moved.

Here we record: (i) `ξ` is not the identity on `A/A²` — otherwise `ξ` would fix `A²` pointwise,
contradicting `crux_xi_fixed_omega1_eq_one`; (ii) `ξ ^ (|Ω₁(P)| - 1)` has square `1` on `A`. -/

/-- Squaring an element of an abelian subgroup. -/
private theorem crux_sq_mul_sq {G : Type*} [Group G] {a c : G} (h : a * c = c * a) :
    (a * c) * (a * c) = (a * a) * (c * c) := by
  calc (a * c) * (a * c) = a * (c * (a * c)) := by rw [mul_assoc]
    _ = a * ((c * a) * c) := by rw [mul_assoc]
    _ = a * ((a * c) * c) := by rw [h]
    _ = a * (a * (c * c)) := by rw [mul_assoc]
    _ = (a * a) * (c * c) := by rw [mul_assoc]

/-- **`ξ` is not the identity on `A / A ^ (2)`.**  There is `a ∈ A` with `ξ a * a⁻¹ ∉ A ^ (2)`.

Indeed, if `ξ a * a⁻¹ ∈ A ^ (2)` for all `a ∈ A`, then `ξ` fixes every square:
`ξ (a * a) = (ξ a) * (ξ a) = (a * c) * (a * c) = (a * a) * (c * c) = a * a` with
`c = ξ a * a⁻¹ ∈ A ^ (2)` (an element of order `2`, `A ^ (2) = Ω₁(P)`).  So `ξ` acts trivially on
`A ^ (2) = Ω₁(P)`, against `crux_xi_fixed_omega1_eq_one`. -/
private theorem crux_exists_xi_moved_mod_powSub (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    ∃ a ∈ A, h.xi a * a⁻¹ ∉ Work.Higman.powSub A 2 := by
  by_contra hcon
  push_neg at hcon
  have hfix : ∀ b ∈ Work.Higman.powSub A 2, h.xi b = b := by
    intro b hb
    obtain ⟨a, ha, haeq⟩ := (Work.Higman.mem_powSub_iff hA.abelian (n := 2)).mp hb
    have hxa : h.xi a ∈ A := by
      have hm := Subgroup.mem_map_of_mem (h.xi : MulAut P).toMonoidHom ha
      rwa [hA.map_eq] at hm
    have hcA : h.xi a * a⁻¹ ∈ A := A.mul_mem hxa (A.inv_mem ha)
    have hc2 : (h.xi a * a⁻¹) * (h.xi a * a⁻¹) = 1 := by
      have hmem : h.xi a * a⁻¹ ∈ Work.Higman.omega1 P := htop ▸ hcon a ha
      have hm := h.mem_omega1.mp hmem
      rwa [pow_two] at hm
    have hcomm : (h.xi a * a⁻¹) * a = a * (h.xi a * a⁻¹) := hA.abelian _ hcA a ha
    have hsq := crux_sq_mul_sq (a := h.xi a * a⁻¹) (c := a) hcomm
    have hxi : h.xi a = (h.xi a * a⁻¹) * a := by
      rw [mul_assoc, inv_mul_cancel, mul_one]
    rw [← haeq, map_pow, pow_two, pow_two, hxi, hsq, hc2, one_mul]
  have hne : Work.Higman.powSub A 2 ≠ ⊥ := by
    intro hbot
    have h4 := h.omega1_card_ge_four
    rw [← htop, hbot] at h4
    simp at h4
  obtain ⟨b, hb1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hne
  exact hb1 (Subtype.ext (crux_xi_fixed_omega1_eq_one h (htop ▸ b.2) (hfix b b.2)))

/-- **`ξ ^ (|Ω₁(P)| - 1)` has square `1` on `A`.**  `ξ ^ (|Ω₁(P)| - 1)` fixes `Ω₁(P)` pointwise,
and an automorphism fixing `Ω₁(P)` pointwise has square `1` on `A` whenever `A ^ (2) = Ω₁(P)`
(`Work.Higman.apply_apply_eq_self_of_fixes_omega1`). -/
private theorem crux_pow_card_sub_one_sq_fixes_A (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    ∀ a ∈ A, ((h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) ^ 2) a = a := by
  intro a ha
  have hkΩ : ∀ z ∈ Work.Higman.omega1 P,
      (h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1)) z = z :=
    Work.Higman.H8.pow_card_sub_one_fixes_omega1 h
  have hk2 := Work.Higman.apply_apply_eq_self_of_fixes_omega1
    (k := h.xi ^ (Nat.card ↥(Work.Higman.omega1 P) - 1))
    (Work.Higman.map_pow_xi_eq h hA.map_eq (Nat.card ↥(Work.Higman.omega1 P) - 1))
    hA.abelian htop hkΩ
  rw [pow_two, MulAut.mul_apply]
  exact hk2 a ha

/-! ## The size of `D`

In the crux configuration the minimal cover `D` has `|D| = |Ω₁(P)|³`.  This is
`Work.Higman.H8.c4_sq_a2_card_quot` (Higman's `m = n` count, axiom-clean), which gives
`|D/A| = |Ω₁(P)|`, combined with `|A| = |Ω₁(P)|²`. -/
private theorem crux_D_card (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hZc : Subgroup.center P = Work.Higman.omega1 P)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A < D)
    (hDmin : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (hD2 : ∀ d ∈ D, d ^ 2 ∈ Work.Higman.powSub A 2)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e)) :
    Nat.card ↥D = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
  haveI hAn : A.Normal := hA.normal
  have hNA : Work.Higman.omega1 P ≤ A := htop ▸ Work.Higman.powSub_le (A := A) (by norm_num)
  have hA2le : Work.Higman.powSub A 2 ≤ A := Work.Higman.powSub_le (by norm_num)
  have hnotcenter : ¬ A ≤ Subgroup.center P := by
    intro hc
    have hAle : A ≤ Work.Higman.powSub A 2 :=
      calc A ≤ Subgroup.center P := hc
        _ = Work.Higman.omega1 P := hZc
        _ = Work.Higman.powSub A 2 := htop.symm
    have hEq : A = Work.Higman.powSub A 2 := le_antisymm hAle hA2le
    have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
      congrArg (fun X : Subgroup P => Nat.card ↥X) hEq
    rw [htop, hcard] at h1
    have h4 := h.omega1_card_ge_four
    nlinarith [h1, h4]
  have hcent := Work.Higman.MSA.centralizer_eq_self h hA hmax hNA hGs hsq hA4 htop hcard hnotcenter
  have hDd' : ⁅D, D⁆ = Work.Higman.powSub A 2 := hDd.trans htop.symm
  have hD2le : Work.Higman.powSub D 2 ≤ Work.Higman.powSub A 2 := by
    show Subgroup.closure {y : P | ∃ x ∈ D, x ^ 2 = y} ≤ Work.Higman.powSub A 2
    rw [Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    exact hD2 x hx
  have hPhi : Work.Higman.powSub D 2 ⊔ ⁅D, D⁆ = Work.Higman.powSub A 2 :=
    le_antisymm (sup_le hD2le (le_of_eq hDd')) ((le_of_eq hDd'.symm).trans le_sup_right)
  have hquot : Nat.card (↥D ⧸ (A.subgroupOf D)) = Nat.card ↥(Work.Higman.omega1 P) :=
    Work.Higman.H8.c4_sq_a2_card_quot h hA hGs hNA htop hcent hDn hDinv (le_of_lt hAD)
      (ne_of_gt hAD) hDd' hPhi hDmin
      (crux_comm_A_D_eq h hA hA4 htop (le_of_lt hAD) hDinv hnZ)
  have hlag := Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf D)
  have hsub : Nat.card ↥(A.subgroupOf D) = Nat.card ↥A :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (le_of_lt hAD))
  rw [hquot, hsub, hcard] at hlag
  rw [hlag]
  ring

/-- In the crux configuration `D` is a proper subgroup of `P`: `[D,D] = Ω₁(P) ≠ A = [P,P]`. -/
private theorem crux_D_ne_top (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    D ≠ ⊤ := by
  intro htop'
  have heq : A = Work.Higman.omega1 P := by
    rw [← hGs, ← htop']
    exact hDd
  have h1 : Nat.card ↥A = Nat.card ↥(Work.Higman.omega1 P) := by rw [heq]
  have h2 : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 :=
    h1.symm.trans hcard
  have h4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
  have hq : 0 < Nat.card ↥(Work.Higman.omega1 P) := by omega
  nlinarith [h2, h4]

/-- **The crux configuration violates Higman's Lemma 13.**  Together with `crux_D_card`
(`|D| = |Ω₁(P)|³`) and `crux_D_ne_top` this shows `|P| > |Ω₁(P)|³ = |Z(P)|³`. -/
private theorem crux_card_gt (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hZc : Subgroup.center P = Work.Higman.omega1 P)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A < D)
    (hDmin : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (hD2 : ∀ d ∈ D, d ^ 2 ∈ Work.Higman.powSub A 2)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e)) :
    (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 < Nat.card P := by
  have h1 : Nat.card ↥D = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 :=
    crux_D_card h hA hmax hGs hsq hA4 htop hcard hZc hDn hDinv hAD hDmin hDd hD2 hnZ
  have h2 : Nat.card ↥D < Nat.card P := by
    haveI : Fintype ↥D := Fintype.ofFinite _
    haveI : Fintype P := Fintype.ofFinite P
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    refine Fintype.card_lt_of_injective_not_surjective (fun x : ↥D => (x : P))
      Subtype.coe_injective ?_
    intro hsurj
    apply crux_D_ne_top h hGs hDd hcard
    rw [Subgroup.eq_top_iff']
    intro x
    obtain ⟨y, hy⟩ := hsurj x
    exact hy ▸ y.2
  rw [← h1]
  exact h2

/-- **The crux configuration is impossible as soon as Higman's bound `|P| ≤ |Z(P)|³`
holds** (this is Higman's Lemma 13; `crux_card_gt` is the statement that the crux configuration
violates it). -/
private theorem crux_false_of_card_le_cube (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hZc : Subgroup.center P = Work.Higman.omega1 P)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A < D)
    (hDmin : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (hD2 : ∀ d ∈ D, d ^ 2 ∈ Work.Higman.powSub A 2)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e))
    (hbound : Nat.card P ≤ (Nat.card ↥(Work.Higman.omega1 P)) ^ 3) :
    False :=
  absurd (crux_card_gt h hA hmax hGs hsq hA4 htop hcard hZc hDn hDinv hAD hDmin hDd hD2 hnZ)
    (not_lt.mpr hbound)

/-! ## New structural lemmas (session 5)

The crux configuration has `P / Ω₁(P)` of class two: `⁅A, ⊤⁆ = A ^ (2) = Ω₁(P)`.  This is
Higman's unipotence dichotomy (`H8.Clean.nsd_comm_eq_bot_or_omega1`, which says `⁅A,⊤⁆ ∈ {⊥, Ω₁(P)}`)
together with `H8.Clean.nsd_comm_eq_bot_false`, which excludes the central case.

Consequently the *commutator pairing* `β x̄ ȳ = ⁅x,y⁆ mod A²` and the *squaring map*
`σ x̄ = x² mod A²` are well defined `𝔽₂`-bilinear/quadratic maps `P/A → A/A²` which are
`ξ`-equivariant — these are Higman's §4 structures in the crux. -/

/-- **The crux has class three**: `⁅A, ⊤⁆ = A ^ (2) = Ω₁(P)`. -/
private theorem crux_comm_A_top_eq (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    Bracket.bracket A (⊤ : Subgroup P) = Work.Higman.powSub A 2 := by
  have hNA : Work.Higman.omega1 P ≤ A :=
    htop ▸ Work.Higman.powSub_le (A := A) (by norm_num)
  rcases Work.Higman.H8.Clean.nsd_comm_eq_bot_or_omega1 h hA.map_eq hA.abelian hGs htop with
    hb | hT
  · exact absurd hb (Work.Higman.H8.Clean.nsd_comm_eq_bot_false h hA.abelian hNA hGs hsq htop)
  · rw [hT, htop]

/-- `Ω₁(P) ≤ A` in the crux (the reverse containment to `A ^ (2) = Ω₁(P)`). -/
private theorem crux_omega1_le {A : Subgroup P} (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    Work.Higman.omega1 P ≤ A :=
  htop ▸ Work.Higman.powSub_le (A := A) (by norm_num)

/-! ## Higman's Lemma 8 (auxiliary result 8) as a contradiction criterion

`Work.Higman.NSM.sharp8` (axiom-clean) says: in the `C₄` configuration, a *minimal*
`ξ`-invariant normal cover `C > A` with `⁅C,C⁆ = A` is impossible.  We record this in the
crux's vocabulary, together with its `C = ⊤` special case (Higman's Lemma 8 with the cover
`P`, which is `Work.Higman.H8.Clean.nsd_false_of_irreducible`). -/

/-- **Higman's Lemma 8 in the crux.**  A `ξ`-invariant normal `C` with `A < C ≤ P`, no
`ξ`-invariant normal subgroup strictly between `A` and `C`, and `⁅C,C⁆ = A` is impossible. -/
private theorem crux_false_of_cover (h : Work.Higman.IsSuzuki2Grp P) {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C) (hAC : A < C)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ C → E = A ∨ E = C)
    (hCd : Bracket.bracket C C = A) : False := by
  have hNA : Work.Higman.omega1 P ≤ A := crux_omega1_le htop
  have hC2 : Work.Higman.powSub C 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  exact Work.Higman.NSM.sharp8 h hA.map_eq hA.abelian hNA hGs hsq hA4 htop hcard hCn hCinv
    (le_of_lt hAC) (ne_of_lt hAC) hcover hC2 hCd

/-- **The irreducible case of the crux.**  If `P/A` has no proper non-trivial `ξ`-invariant
normal subgroup then the crux hypotheses are contradictory (Higman's Lemma 8 with `C = ⊤`). -/
private theorem crux_false_of_irreducible_P (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hirr : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E = A ∨ E = ⊤) : False :=
  Work.Higman.H8.Clean.nsd_false_of_irreducible h hA.map_eq hA.abelian (crux_omega1_le htop)
    hGs hsq hA4 htop hcard hirr

/-- **Reduction of the crux to the existence of a Lemma-8 cover.**

The crux is contradictory as soon as there is *any* `ξ`-invariant normal subgroup `C` with
`A < C ≤ P`, no `ξ`-invariant normal subgroup strictly between `A` and `C`, and `⁅C,C⁆ = A`. -/
private theorem crux_false_of_exists_cover (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hex : ∃ C : Subgroup P, C.Normal ∧ C.map (h.xi : MulAut P).toMonoidHom = C ∧ A < C ∧
      (∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
        A ≤ E → E ≤ C → E = A ∨ E = C) ∧ Bracket.bracket C C = A) : False := by
  obtain ⟨C, hCn, hCinv, hAC, hcover, hCd⟩ := hex
  exact crux_false_of_cover h hA hGs hsq hA4 htop hcard hCn hCinv hAC hcover hCd

/-- `D ^ (2) = A ^ (2)` in the crux: every square of `D` lies in `A ^ (2)` and `A ≤ D`. -/
private theorem crux_powSub_D_two_eq {A D : Subgroup P}
    (hD2 : ∀ d ∈ D, d ^ 2 ∈ Work.Higman.powSub A 2) (hAD : A ≤ D) :
    Work.Higman.powSub D 2 = Work.Higman.powSub A 2 := by
  refine le_antisymm ?_ ?_
  · rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    exact hD2 x hx
  · exact Work.Higman.powSub_mono hAD

/-- `⁅D,D⁆ = A ^ (2)` in the crux (from `⁅D,D⁆ = Ω₁(P)` and `A ^ (2) = Ω₁(P)`). -/
private theorem crux_DD_eq_powSub {A D : Subgroup P}
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P) :
    Bracket.bracket D D = Work.Higman.powSub A 2 := hDd.trans htop.symm

/-- **`A ^ (2) ≠ A` in the crux** (they have `q` resp. `q ^ 2` elements, `q ≥ 4`). -/
private theorem crux_powSub_two_ne_self (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    Work.Higman.powSub A 2 ≠ A := by
  intro hEq
  have h1 : Nat.card ↥(Work.Higman.powSub A 2) = Nat.card ↥A :=
    congrArg (fun X : Subgroup P => Nat.card ↥X) hEq
  rw [htop, hcard] at h1
  have h4 : 4 ≤ Nat.card ↥(Work.Higman.omega1 P) := h.omega1_card_ge_four
  have hq : 0 < Nat.card ↥(Work.Higman.omega1 P) := by omega
  nlinarith [h1, h4]

/-- **The `hPD` hypothesis bites.**  From `⁅⊤,D⁆ = A` we get an element `x` and an element
`d ∈ D` whose commutator is *not* in `A ^ (2)`: otherwise `A = ⁅⊤,D⁆ ≤ A ^ (2) = A`, i.e.
`A = A ^ (2)`, contradicting `|A| = |Ω₁(P)|²` with `|Ω₁(P)| ≥ 4`. -/
private theorem crux_exists_comm_not_mem_sq (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hPD : Bracket.bracket (⊤ : Subgroup P) D = A) :
    ∃ x ∈ (⊤ : Subgroup P), ∃ d ∈ D, ⁅x, d⁆ ∉ Work.Higman.powSub A 2 := by
  by_contra hcon
  push_neg at hcon
  have hle : Bracket.bracket (⊤ : Subgroup P) D ≤ Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_le]
    intro x _ d hd
    exact hcon x (Subgroup.mem_top x) d hd
  have hA2le : Work.Higman.powSub A 2 ≤ A :=
    Work.Higman.powSub_le (A := A) (n := 2) (by norm_num)
  have hAeq : A = Work.Higman.powSub A 2 := le_antisymm (hPD ▸ hle) hA2le
  exact crux_powSub_two_ne_self h htop hcard hAeq.symm

/-- **Reduction of the crux to the fleet's `NSM.c4DerivSqCase`.**

The crux hypotheses (without `hmax`, `hZc`, `hDmin`, `hPD`, `hbig`, `hnZ`) already give the full
`C₄`-configuration for the pair `(A,D)`: `A ⊢` abelian `ξ`-invariant, `Ω₁(P) ≤ A`,
`⁅⊤,⊤⁆ = A`, all squares of `P` in `A`, `A⁴ = 1`, `A² = Ω₁(P)`, `|A| = |Ω₁(P)|²`, `D ⊴ P`
`ξ`-invariant, `A < D`, `D² = A²` and `⁅D,D⁆ = A²`.  Hence *any* theorem of the shape of
`Work.Higman.NSM.c4DerivSqCase` (its `sorry` is the fleet's single remaining obligation for
Higman's Theorem 1) yields the crux.  The `hPD`-flavoured extra data
(`∃x, d ∈ D` with `⁅x,d⁆ ∉ A²`, `crux_exists_comm_not_mem_sq` above) is *not* needed for this
reduction — it is precisely the extra input available for proving the `c4DerivSqCase`-shaped
statement in this configuration. -/
private theorem crux_case_large_hard_of_c4DerivSqCase
    (hc4 : ∀ {Q : Type} [Group Q] [Finite Q] (hQ : Work.Higman.IsSuzuki2Grp Q)
      {A' D' : Subgroup Q},
      A'.map (hQ.xi : MulAut Q).toMonoidHom = A' →
      (∀ x ∈ A', ∀ y ∈ A', x * y = y * x) →
      Work.Higman.omega1 Q ≤ A' →
      Bracket.bracket (⊤ : Subgroup Q) ⊤ = A' →
      (∀ x : Q, x ^ 2 ∈ A') →
      Work.Higman.powSub A' 4 = ⊥ →
      Work.Higman.powSub A' 2 = Work.Higman.omega1 Q →
      Nat.card ↥A' = (Nat.card ↥(Work.Higman.omega1 Q)) ^ 2 →
      D'.Normal → D'.map (hQ.xi : MulAut Q).toMonoidHom = D' →
      A' ≤ D' → D' ≠ A' →
      Work.Higman.powSub D' 2 = Work.Higman.powSub A' 2 →
      Bracket.bracket D' D' = Work.Higman.powSub A' 2 → False)
    (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (hAD : A < D)
    (hD2 : ∀ d ∈ D, d ^ 2 ∈ Work.Higman.powSub A 2)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P) : False :=
  hc4 h hA.map_eq hA.abelian (crux_omega1_le htop) hGs hsq hA4 htop hcard hDn hDinv
    (le_of_lt hAD) (ne_of_lt hAD).symm (crux_powSub_D_two_eq hD2 (le_of_lt hAD))
    (crux_DD_eq_powSub hDd htop)

/-! ## The pairing-level Jacobi relation (Step 4 input)

Since `⁅A,⊤⁆ = A ^ (2) ≤ Z(P)` (`crux_comm_A_top_eq`), `P` has class at most three and the Jacobi
identity (`Work.Higman.Q3.crux_class_three_jacobi`) holds.  For `y, z ∈ D` the commutator
`⁅y,z⁆ ∈ ⁅D,D⁆ = Ω₁(P)` is central, and `⁅z,x⁆ = ⁅x,z⁆⁻¹` with `⁅x,z⁆ ∈ A` whose double
commutators are involutions; hence

    ⁅⁅x,y⁆,z⁆ = ⁅⁅x,z⁆,y⁆        (`x ∈ P`, `y, z ∈ D`),

i.e. `φ(B(x,y),z) = φ(B(y,z),x)` in the notation of the fleet's Step-4 plan
(`NSM/NOTES_redcase_hardcase.md`).  This is the structural input for the resonance computation
that has to close the `c4DerivSqCase`-shaped gap (Higman 1963, Lemma 13, p. 92). -/

/-- An element of a group with `a * a = 1` equals its own inverse. -/
private theorem crux_inv_eq_self_of_sq_eq_one {G : Type} [Group G] {a : G} (h : a * a = 1) : a⁻¹ = a := by
  calc a⁻¹ = a⁻¹ * (a * a) := by rw [h, mul_one]
    _ = a := by group

private theorem crux_comm_sq_eq_one (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hZc : Subgroup.center P = Work.Higman.omega1 P)
    {b : P} (hb : b ∈ A) (y : P) : ⁅b, y⁆ * ⁅b, y⁆ = 1 := by
  have hc : ⁅b, y⁆ ∈ Subgroup.center P :=
    Work.Higman.Q3.commutatorElement_mem_center_of_mem h hA hGs htop hb y
  have hom : ⁅b, y⁆ ∈ Work.Higman.omega1 P := hZc ▸ hc
  have h2 := h.mem_omega1.mp hom
  rwa [pow_two] at h2

private theorem crux_jacobi_rel (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hZc : Subgroup.center P = Work.Higman.omega1 P)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (x : P) {y z : P} (hy : y ∈ D) (hz : z ∈ D) :
    ⁅⁅x, y⁆, z⁆ = ⁅⁅x, z⁆, y⁆ := by
  have hJ : (⁅⁅x, y⁆, z⁆ * ⁅⁅y, z⁆, x⁆ * ⁅⁅z, x⁆, y⁆ : P) = 1 := by
    simpa only [commutatorElement_def] using
      Work.Higman.Q3.crux_class_three_jacobi h hA hGs hsq htop x y z
  have hyz : ⁅y, z⁆ ∈ Work.Higman.omega1 P := by
    have h1 : ⁅y, z⁆ ∈ Bracket.bracket D D := Subgroup.commutator_mem_commutator hy hz
    rwa [hDd] at h1
  have hyzc : ⁅y, z⁆ ∈ Subgroup.center P := h.omega1_le_center hyz
  have hmid : ⁅⁅y, z⁆, x⁆ = 1 := by
    have h1 : x * ⁅y, z⁆ = ⁅y, z⁆ * x := Subgroup.mem_center_iff.mp hyzc x
    exact commutatorElement_eq_one_iff_mul_comm.mpr h1.symm
  have h2 : ⁅⁅x, y⁆, z⁆ * ⁅⁅z, x⁆, y⁆ = 1 := by
    rw [hmid, mul_one] at hJ
    exact hJ
  have hxzA : ⁅x, z⁆ ∈ A := by
    have h1 := Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top z)
    rwa [hGs] at h1
  have hxyA : ⁅x, y⁆ ∈ A := by
    have h1 := Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
    rwa [hGs] at h1
  have hzx : ⁅z, x⁆ = ⁅x, z⁆⁻¹ := by
    rw [commutatorElement_def, commutatorElement_def]; group
  have hinv : ⁅⁅z, x⁆, y⁆ = ⁅⁅x, z⁆, y⁆ := by
    rw [hzx]
    have hc : ⁅⁅x, z⁆, y⁆ ∈ Subgroup.center P :=
      Work.Higman.Q3.commutatorElement_mem_center_of_mem h hA hGs htop hxzA y
    have hbb : ⁅x, z⁆⁻¹ * ⁅⁅x, z⁆, y⁆⁻¹ = ⁅⁅x, z⁆, y⁆⁻¹ * ⁅x, z⁆⁻¹ := by
      have h1 : (⁅x, z⁆ * ⁅⁅x, z⁆, y⁆)⁻¹ = (⁅⁅x, z⁆, y⁆ * ⁅x, z⁆)⁻¹ := by
        rw [Subgroup.mem_center_iff.mp hc ⁅x, z⁆]
      rw [mul_inv_rev, mul_inv_rev] at h1
      exact h1.symm
    have h6 : ⁅⁅x, z⁆, y⁆⁻¹ = ⁅⁅x, z⁆, y⁆ :=
      crux_inv_eq_self_of_sq_eq_one (crux_comm_sq_eq_one h hA hGs htop hZc hxzA y)
    have hkey : ⁅⁅x, z⁆⁻¹, y⁆ = ⁅x, z⁆⁻¹ * ⁅⁅x, z⁆, y⁆⁻¹ * ⁅x, z⁆ := by
      rw [commutatorElement_def]; group
    rw [hkey, hbb, mul_assoc, inv_mul_cancel, mul_one, h6]
  have h5 : ⁅⁅x, y⁆, z⁆⁻¹ = ⁅⁅x, y⁆, z⁆ :=
    crux_inv_eq_self_of_sq_eq_one (crux_comm_sq_eq_one h hA hGs htop hZc hxyA z)
  have h6 : ⁅⁅x, z⁆, y⁆⁻¹ = ⁅⁅x, z⁆, y⁆ :=
    crux_inv_eq_self_of_sq_eq_one (crux_comm_sq_eq_one h hA hGs htop hZc hxzA y)
  have h4 : ⁅⁅x, y⁆, z⁆ * ⁅⁅x, z⁆, y⁆ = 1 := by rw [← hinv]; exact h2
  have ha : ⁅⁅x, y⁆, z⁆ = (⁅⁅x, z⁆, y⁆)⁻¹ := by
    calc ⁅⁅x, y⁆, z⁆ = ⁅⁅x, y⁆, z⁆ * (⁅⁅x, z⁆, y⁆ * (⁅⁅x, z⁆, y⁆)⁻¹) := by group
      _ = (⁅⁅x, y⁆, z⁆ * ⁅⁅x, z⁆, y⁆) * (⁅⁅x, z⁆, y⁆)⁻¹ := by group
      _ = (⁅⁅x, z⁆, y⁆)⁻¹ := by rw [h4, one_mul]
  rw [ha, h6]

private theorem crux_jacobi_D (h : Work.Higman.IsSuzuki2Grp P) {D : Subgroup P}
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    {x y z : P} (hx : x ∈ D) (hy : y ∈ D) (hz : z ∈ D) : ⁅⁅x, y⁆, z⁆ = 1 := by
  have h1 : ⁅x, y⁆ ∈ Work.Higman.omega1 P := by
    have h2 : ⁅x, y⁆ ∈ Bracket.bracket D D := Subgroup.commutator_mem_commutator hx hy
    rwa [hDd] at h2
  have h3 : ⁅x, y⁆ ∈ Subgroup.center P := h.omega1_le_center h1
  have h4 : z * ⁅x, y⁆ = ⁅x, y⁆ * z := Subgroup.mem_center_iff.mp h3 z
  exact commutatorElement_eq_one_iff_mul_comm.mpr h4.symm

private theorem crux_case_large_hard {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hGs : Bracket.bracket (⊤ : Subgroup P) ⊤ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hZc : Subgroup.center P = Work.Higman.omega1 P)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A < D)
    (hDmin : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D)
    (hDd : Bracket.bracket D D = Work.Higman.omega1 P)
    (hD2 : ∀ d ∈ D, d ^ 2 ∈ Work.Higman.powSub A 2)
    (hPD : Bracket.bracket (⊤ : Subgroup P) D = A)
    (hbig : ∃ x y : P, x ∈ D ∧ y ∈ D ∧ x ∉ A ∧ y ∉ A ∧ x * y ∉ A)
    (hnZ : ¬(∀ e ∈ D, ∀ a ∈ A, e * a = a * e)) :
    False := by
  by_cases hcase : ∃ d : P, d ∈ D ∧ d ∉ A ∧ (h.xi d) * d⁻¹ ∈ A
  · exact crux_false_of_xi_fixed_coset_mod_A h hA htop hsq hcase
  · -- Remaining case: `ξ` acts on `D/A` without non-zero fixed vectors.
    push_neg at hcase
    sorry

end Work.Higman.Q3
end

-- ===== from Submission.Work.Higman.RedAux.two_cover_stage =====
section

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped commutatorElement IsMulCommutative

namespace Work.Higman.RedAux

/-!
# The two-cover endgame: the `ξ`-action on `D / A`

This is the shared "stage" of the two-cover endgame: the automorphism `ξ` of a Suzuki 2-group
`P`, restricted to a `ξ`-invariant subgroup `D` and descended to the quotient `D / A`.

Everything here is proved and axiom-clean; the companion module
`Submission.Work.Higman.RedAux.two_cover_endgame` uses these definitions for the actual
endgame.
-/

variable {P : Type} [Group P] [Finite P]

/-- `ξ` as an automorphism of a `ξ`-invariant subgroup. -/
private noncomputable def xiSub (h : Work.Higman.IsSuzuki2Grp P) {D : Subgroup P}
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) : ↥D ≃* ↥D where
  toFun d := ⟨(h.xi : MulAut P) (d : P), by
    have := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom) d.2
    rwa [hDinv] at this⟩
  invFun d := ⟨(h.xi : MulAut P).symm (d : P),
    Work.Higman.symm_mem_of_map_eq (h.xi : MulAut P) hDinv d.2⟩
  left_inv d := Subtype.ext (by simp)
  right_inv d := Subtype.ext (by simp)
  map_mul' d e := Subtype.ext (by simp [map_mul])

private theorem xiSub_coe (h : Work.Higman.IsSuzuki2Grp P) {D : Subgroup P}
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    ((xiSub h hDinv d : ↥D) : P) = (h.xi : MulAut P) (d : P) := rfl

private theorem xiSub_symm_coe (h : Work.Higman.IsSuzuki2Grp P) {D : Subgroup P}
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    (((xiSub h hDinv)⁻¹ d : ↥D) : P) = (h.xi : MulAut P).symm (d : P) := rfl

@[simp] private theorem xiSub_apply_symm (h : Work.Higman.IsSuzuki2Grp P) {D : Subgroup P}
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    xiSub h hDinv ((xiSub h hDinv)⁻¹ d) = d := by simp

@[simp] private theorem xiSub_symm_apply (h : Work.Higman.IsSuzuki2Grp P) {D : Subgroup P}
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    (xiSub h hDinv)⁻¹ (xiSub h hDinv d) = d := by simp

/-- The underlying group homomorphism of `ξ` acting on `D / A`. -/
private noncomputable def xiQuotHom (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) :
    (↥D ⧸ (A.subgroupOf D)) →* (↥D ⧸ (A.subgroupOf D)) :=
  letI : (A.subgroupOf D).Normal := hAn.subgroupOf D
  QuotientGroup.lift (A.subgroupOf D)
    ((QuotientGroup.mk' (A.subgroupOf D)).comp (xiSub h hDinv))
    (by
      intro d hd
      show QuotientGroup.mk (xiSub h hDinv d) = 1
      rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
      show (h.xi : MulAut P) ((d : ↥D) : P) ∈ A
      have hm := Subgroup.mem_map_of_mem (f := (h.xi : MulAut P).toMonoidHom)
        (Subgroup.mem_subgroupOf.mp hd)
      rwa [hAinv] at hm)

private theorem xiQuotHom_mk (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    xiQuotHom h hAinv hDinv (QuotientGroup.mk d) = QuotientGroup.mk (xiSub h hDinv d) := by
  rw [xiQuotHom, QuotientGroup.lift_mk]
  rfl

/-- `ξ` as an automorphism of the quotient `D / A`. -/
private noncomputable def xiQuot (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) :
    (↥D ⧸ (A.subgroupOf D)) ≃* (↥D ⧸ (A.subgroupOf D)) := by
  haveI : (A.subgroupOf D).Normal := hAn.subgroupOf D
  refine MulEquiv.ofBijective (xiQuotHom h hAinv hDinv) ⟨?_, ?_⟩
  · intro x y hxy
    induction x using QuotientGroup.induction_on with
    | _ x =>
      induction y using QuotientGroup.induction_on with
      | _ y =>
        rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
        have h2 : xiQuotHom h hAinv hDinv (QuotientGroup.mk x)
            = xiQuotHom h hAinv hDinv (QuotientGroup.mk y) := hxy
        rw [xiQuotHom_mk, xiQuotHom_mk] at h2
        have h2' : (xiSub h hDinv x)⁻¹ * (xiSub h hDinv y) ∈ A.subgroupOf D :=
          QuotientGroup.eq.mp h2
        rw [Subgroup.mem_subgroupOf] at h2'
        have h4 : (xiSub h hDinv x)⁻¹ * (xiSub h hDinv y) = xiSub h hDinv (x⁻¹ * y) := by
          rw [map_mul, map_inv]
        rw [h4] at h2'
        have h3 : (h.xi : MulAut P) (((x⁻¹ * y : ↥D) : P)) ∈ A := h2'
        have h5 : ((x⁻¹ * y : ↥D) : P) ∈ A := by
          simpa using Work.Higman.symm_mem_of_map_eq (h.xi : MulAut P) hAinv h3
        exact h5
  · intro z
    induction z using QuotientGroup.induction_on with
    | _ z =>
      refine ⟨QuotientGroup.mk ⟨(h.xi : MulAut P).symm (z : P),
        Work.Higman.symm_mem_of_map_eq (h.xi : MulAut P) hDinv z.2⟩, ?_⟩
      rw [xiQuotHom_mk]
      show QuotientGroup.mk (xiSub h hDinv _) = QuotientGroup.mk z
      congr 1
      apply Subtype.ext
      show (h.xi : MulAut P) ((h.xi : MulAut P).symm (z : P)) = (z : P)
      simp

private theorem xiQuot_mk (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    xiQuot h hAinv hDinv (QuotientGroup.mk d) = QuotientGroup.mk (xiSub h hDinv d) := by
  haveI : (A.subgroupOf D).Normal := hAn.subgroupOf D
  change xiQuotHom h hAinv hDinv (QuotientGroup.mk d) = _
  rw [xiQuotHom_mk]

/-- The inverse of `xiQuot` on representatives. -/
private theorem xiQuot_symm_mk (h : Work.Higman.IsSuzuki2Grp P) {A D : Subgroup P}
    [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D) (d : ↥D) :
    (xiQuot h hAinv hDinv)⁻¹ (QuotientGroup.mk d) = QuotientGroup.mk ((xiSub h hDinv)⁻¹ d) := by
  have h1 : xiQuot h hAinv hDinv
      (QuotientGroup.mk ((xiSub h hDinv)⁻¹ d)) = QuotientGroup.mk d := by
    rw [xiQuot_mk]
    congr 1
    exact MulEquiv.apply_symm_apply _ _
  exact (Equiv.symm_apply_eq _).mpr h1.symm

/-- `ξ` as an automorphism of `A ^ (2)`. -/
private noncomputable def xiPow (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A) : ↥(Work.Higman.powSub A 2) ≃* ↥(Work.Higman.powSub A 2) :=
  xiSub h (Work.Higman.map_powSub (h.xi : MulAut P) hAinv 2)

private theorem xiPow_coe (h : Work.Higman.IsSuzuki2Grp P) {A : Subgroup P}
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A) (z : ↥(Work.Higman.powSub A 2)) :
    ((xiPow h hAinv z : ↥(Work.Higman.powSub A 2)) : P) = (h.xi : MulAut P) (z : P) := rfl

variable {P : Type} [Group P] [Finite P]

section EZ

variable {A : Subgroup P} (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
variable {F : Type} [Field F] (ζ : F ≃ ↥(Work.Higman.omega1 P))

/-- The element of `Ω₁(P)` underlying an element of `A ^ (2)`. -/
private noncomputable def tceZel (z : ↥(Work.Higman.powSub A 2)) : ↥(Work.Higman.omega1 P) :=
  ⟨(z : P), htop ▸ z.2⟩

private theorem tceZel_coe (z : ↥(Work.Higman.powSub A 2)) :
    ((tceZel htop z : ↥(Work.Higman.omega1 P)) : P) = (z : P) := rfl

/-- `eZ : A ^ (2) → F`, the inverse of `ζ` transported along `A ^ (2) = Ω₁(P)`. -/
private noncomputable def tceEZ : ↥(Work.Higman.powSub A 2) ≃ F where
  toFun z := ζ.symm (tceZel htop z)
  invFun x := ⟨(ζ x : P), htop.symm ▸ (ζ x).2⟩
  left_inv z := by
    apply Subtype.ext
    show ((ζ (ζ.symm (tceZel htop z)) : ↥(Work.Higman.omega1 P)) : P) = (z : P)
    rw [ζ.apply_symm_apply]
    rfl
  right_inv x := by
    show ζ.symm (tceZel htop ⟨(ζ x : P), htop.symm ▸ (ζ x).2⟩) = x
    rw [show tceZel htop (⟨(ζ x : P), htop.symm ▸ (ζ x).2⟩ : ↥(Work.Higman.powSub A 2)) = ζ x
      from Subtype.ext rfl]
    exact ζ.symm_apply_apply x

private theorem tceEZ_apply (z : ↥(Work.Higman.powSub A 2)) :
    tceEZ htop ζ z = ζ.symm (tceZel htop z) := rfl

private theorem tceEZ_symm_apply (x : F) :
    (tceEZ htop ζ).symm x = ⟨(ζ x : P), htop.symm ▸ (ζ x).2⟩ := rfl

private theorem tceEZ_add (hζadd : ∀ x y : F, ζ (x + y) = ζ x * ζ y)
    (z w : ↥(Work.Higman.powSub A 2)) : tceEZ htop ζ (z * w) = tceEZ htop ζ z + tceEZ htop ζ w := by
  rw [tceEZ_apply, tceEZ_apply, tceEZ_apply]
  have h : tceZel htop (z * w) = tceZel htop z * tceZel htop w := Subtype.ext rfl
  rw [h]
  have key : tceZel htop z * tceZel htop w
      = ζ (ζ.symm (tceZel htop z) + ζ.symm (tceZel htop w)) := by
    rw [hζadd, ζ.apply_symm_apply, ζ.apply_symm_apply]
  rw [key, ζ.symm_apply_apply]

private theorem tceEZ_twist (h : Work.Higman.IsSuzuki2Grp P) {hAinv : A.map (h.xi : MulAut P).toMonoidHom = A}
    {mu : F} (hζξ : ∀ x : F, ((ζ (mu * x) : ↥(Work.Higman.omega1 P)) : P)
      = (h.xi : MulAut P) ((ζ x : ↥(Work.Higman.omega1 P)) : P))
    (z : ↥(Work.Higman.powSub A 2)) :
    tceEZ htop ζ (xiPow h hAinv z) = mu * tceEZ htop ζ z := by
  rw [tceEZ_apply, tceEZ_apply]
  have h : tceZel htop (xiPow h hAinv z)
      = xiSub h (Work.Higman.map_xi_omega1 h) (tceZel htop z) := Subtype.ext rfl
  rw [h]
  apply ζ.injective
  rw [ζ.apply_symm_apply]
  apply Subtype.ext
  rw [hζξ, ζ.apply_symm_apply]
  rfl

end EZ

/-! ## Irreducibility -/

private theorem xiQuot_irreducible {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hGs : Bracket.bracket (⊤ : Subgroup P) (⊤ : Subgroup P) = A)
    (hAD : A ≤ D)
    (hcover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D) :
    ∀ W : Subgroup (↥D ⧸ (A.subgroupOf D)),
      (∀ v ∈ W, xiQuot h hAinv hDinv v ∈ W) → W = ⊥ ∨ W = ⊤ := by
  intro W hW
  haveI : (A.subgroupOf D).Normal := hAn.subgroupOf D
  let E : Subgroup P := (W.comap (QuotientGroup.mk' (A.subgroupOf D))).map (Subgroup.subtype D)
  have hmkW : ∀ x : ↥D, (x : P) ∈ E ↔ QuotientGroup.mk x ∈ W := by
    intro x
    constructor
    · rintro ⟨y, hy, hyx⟩
      have hyx' : y = x := Subtype.ext hyx
      subst hyx'
      exact hy
    · intro hx
      exact ⟨x, hx, rfl⟩
  have hAE : A ≤ E := by
    intro a ha
    rw [show a = ((⟨a, hAD ha⟩ : ↥D) : P) from rfl, hmkW]
    rw [show QuotientGroup.mk (⟨a, hAD ha⟩ : ↥D) = 1 from
      (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_subgroupOf.mpr ha)]
    exact W.one_mem
  have hED : E ≤ D := by
    rintro y ⟨x, -, rfl⟩
    exact x.2
  have hEn : E.Normal := by
    refine Subgroup.Normal.mk fun n hn g => ?_
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hn
    show g * (y : P) * g⁻¹ ∈ E
    have h1 : ⁅g, (y : P)⁆ ∈ A := by
      have hh := Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top (y : P))
      rwa [hGs] at hh
    have h2 : ⁅g, (y : P)⁆ ∈ E := hAE h1
    have h3 : g * (y : P) * g⁻¹ = ⁅g, (y : P)⁆ * (y : P) := by
      rw [commutatorElement_def]; group
    rw [h3]
    exact E.mul_mem h2 (Subgroup.mem_map_of_mem (Subgroup.subtype D) hy)
  have hEinv : E.map (h.xi : MulAut P).toMonoidHom = E := by
    have hstep : ∀ x : ↥D, (x : P) ∈ E → ((xiSub h hDinv x : ↥D) : P) ∈ E := by
      intro x hx
      rw [hmkW] at hx ⊢
      rw [← xiQuot_mk h hAinv hDinv x]
      exact hW _ hx
    have hle : E.map (h.xi : MulAut P).toMonoidHom ≤ E := by
      rintro y ⟨e, he, rfl⟩
      obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.mp he
      exact hstep x ((hmkW x).mpr hx)
    refine Subgroup.eq_of_le_of_card_ge hle ?_
    rw [Subgroup.card_map_of_injective (f := (h.xi : MulAut P).toMonoidHom)
      (h.xi : MulAut P).injective]
  rcases hcover E hEn hEinv hAE hED with hEA | hED'
  · left
    ext v
    constructor
    · intro hv
      rw [Subgroup.mem_bot]
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective v
      have hxE : (x : P) ∈ E := (hmkW x).mpr hv
      rw [hEA] at hxE
      exact (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_subgroupOf.mpr hxE)
    · intro hv
      rw [Subgroup.mem_bot] at hv
      rw [hv]
      exact W.one_mem
  · right
    ext v
    constructor
    · intro _; trivial
    · intro _
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective v
      exact (hmkW x).mp (le_of_eq hED'.symm x.2)

/-! ## The scalar identification of `D / A` -/

private theorem xiQuot_scalar_iso {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A D : Subgroup P} [hAn : A.Normal] [hDn : D.Normal]
    (hAinv : A.map (h.xi : MulAut P).toMonoidHom = A)
    (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hcomm : Bracket.bracket D D ≤ A)
    {n : ℕ} {F : Type} [Field F] [Fintype F] [DecidableEq F] [CharP F 2]
    (hn : 2 ≤ n) (hcard : Fintype.card F = 2 ^ n)
    (hDcard : Nat.card (↥D ⧸ (A.subgroupOf D)) = 2 ^ n)
    (hexp2 : ∀ v : ↥D ⧸ (A.subgroupOf D), v * v = 1)
    (hirr : ∀ W : Subgroup (↥D ⧸ (A.subgroupOf D)),
      (∀ v ∈ W, xiQuot h hAinv hDinv v ∈ W) → W = ⊥ ∨ W = ⊤) :
    ∃ (sig : F) (e : (↥D ⧸ (A.subgroupOf D)) ≃ F),
      sig ≠ 1 ∧ (∀ k : ℕ, 1 ≤ k → k < n → sig ^ (2 ^ k) ≠ sig) ∧
      (∀ v w : ↥D ⧸ (A.subgroupOf D), e (v * w) = e v + e w) ∧
      (∀ v : ↥D ⧸ (A.subgroupOf D), e (xiQuot h hAinv hDinv v) = sig * e v) := by
  classical
  haveI hQ : IsMulCommutative (↥D ⧸ (A.subgroupOf D)) := by
    refine Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr ?_
    show ⁅(⊤ : Subgroup ↥D), (⊤ : Subgroup ↥D)⁆ ≤ A.subgroupOf D
    rw [Subgroup.commutator_le]
    intro x _ y _
    exact Subgroup.mem_subgroupOf.mpr (hcomm (Subgroup.commutator_mem_commutator x.2 y.2))
  let S := Additive (↥D ⧸ (A.subgroupOf D))
  haveI hSmod : Module (ZMod 2) S := AddCommGroup.zmodModule (n := 2) (fun (y : S) => by
    show (2 : ℕ) • y = 0
    induction y using Additive.rec with
    | _ a => rw [two_nsmul, ← ofMul_mul]; exact ofMul_eq_zero.mpr (hexp2 a))
  have hcardS : Nat.card S = 2 ^ n := by
    rw [← Nat.card_congr Additive.ofMul]; exact hDcard
  let ξS : S ≃+ S := (xiQuot h hAinv hDinv).toAdditive
  have hξS : ∀ v : ↥D ⧸ (A.subgroupOf D),
      ξS (Additive.ofMul v) = Additive.ofMul (xiQuot h hAinv hDinv v) := fun v => rfl
  let xS : S ≃ₗ[ZMod 2] S := AddEquiv.toLinearEquiv ξS (fun c y => by
    have hc : c = 0 ∨ c = 1 := by revert c; decide
    rcases hc with hc | hc <;> subst hc <;> simp)
  have hxS : ∀ y : S, xS y = ξS y := fun y => rfl
  have hirr' : ∀ U : Submodule (ZMod 2) S, (∀ y ∈ U, xS y ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    let W : Subgroup (↥D ⧸ (A.subgroupOf D)) :=
      { carrier := {v | Additive.ofMul v ∈ U}
        one_mem' := by
          show Additive.ofMul (1 : ↥D ⧸ (A.subgroupOf D)) ∈ U
          rw [ofMul_one]
          exact U.zero_mem
        mul_mem' := fun {a b} ha hb => by
          show Additive.ofMul (a * b) ∈ U
          rw [ofMul_mul]
          exact U.add_mem ha hb
        inv_mem' := fun {a} ha => by
          show Additive.ofMul a⁻¹ ∈ U
          have h1 : a⁻¹ = a := inv_eq_of_mul_eq_one_left (hexp2 a)
          rw [h1]
          exact ha }
    have hstable : ∀ v ∈ W, xiQuot h hAinv hDinv v ∈ W := by
      intro v hv
      show Additive.ofMul (xiQuot h hAinv hDinv v) ∈ U
      rw [← hξS v, ← hxS (Additive.ofMul v)]
      exact hU _ hv
    rcases hirr W hstable with hW | hW
    · left
      rw [Submodule.eq_bot_iff]
      intro y hy
      have hyW : y.toMul ∈ W := by
        show Additive.ofMul y.toMul ∈ U
        rwa [ofMul_toMul]
      rw [hW] at hyW
      have hy1 : y.toMul = 1 := Subgroup.mem_bot.mp hyW
      rw [← ofMul_toMul y, hy1, ofMul_one]
    · right
      rw [Submodule.eq_top_iff']
      intro y
      have hyW : y.toMul ∈ W := by rw [hW]; exact Subgroup.mem_top _
      have hyU : Additive.ofMul y.toMul ∈ U := hyW
      rwa [ofMul_toMul] at hyU
  obtain ⟨sig, e0, hsig1, hpow, he0⟩ :=
    Work.Higman.H8.c4_irred_module_iso hn hcard hcardS xS hirr'
  refine ⟨sig, (Additive.ofMul).trans e0.toEquiv, hsig1, hpow, ?_, ?_⟩
  · intro v w
    show e0 (Additive.ofMul (v * w)) = e0 (Additive.ofMul v) + e0 (Additive.ofMul w)
    rw [ofMul_mul]
    exact e0.map_add _ _
  · intro v
    show e0 (Additive.ofMul (xiQuot h hAinv hDinv v)) = sig * e0 (Additive.ofMul v)
    have hh := he0 (Additive.ofMul v)
    rw [hxS, hξS] at hh
    exact hh

/-! ## Reduction lemmas (moved here from `two_cover_endgame`) -/

/-- In the `C₄` setting, `A ≤ Z(P)` is impossible: it would force `[P,P] ≤ Ω₁(P) = A²`. -/
private theorem c4_A_not_le_center (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    ¬ A ≤ Subgroup.center P := by
  intro hAZ
  have hsq_center : ∀ x : P, x ^ 2 ∈ Subgroup.center P := fun x => hAZ (hsq x)
  have hle : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.omega1 P := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    rw [h.mem_omega1]
    have h2 : ⁅x, y⁆ ∈ Subgroup.center P :=
      hAZ (by rw [← hGs]
              exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y))
    have h3 : ⁅x, ⁅x, y⁆⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp h2 x)
    have h1 : ⁅x ^ 2, y⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp (hsq_center x) y).symm
    have h4 : ⁅x, ⁅x, y⁆⁆ * ⁅x, y⁆ ^ 2 = 1 := by
      rw [← Work.Higman.commutatorElement_sq_self x y]; exact h1
    rw [h3, one_mul] at h4
    exact h4
  have hAle : A ≤ Work.Higman.powSub A 2 := by
    calc A = ⁅(⊤ : Subgroup P), ⊤⁆ := hGs.symm
      _ ≤ Work.Higman.omega1 P := hle
      _ = Work.Higman.powSub A 2 := htop.symm
  have hAe : A = Work.Higman.powSub A 2 := le_antisymm hAle (Work.Higman.powSub_le (by norm_num))
  have hc : Nat.card ↥A = Nat.card ↥(Work.Higman.powSub A 2) :=
    congrArg (fun X : Subgroup P => Nat.card ↥X) hAe
  rw [htop] at hc
  have hq : Nat.card ↥(Work.Higman.omega1 P) = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2 := by
    rw [← hcard, hc]
  have h4 := h.omega1_card_ge_four
  have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
  nlinarith [hq, h4, hpos]

/-- In the `C₄` setting, `A` is maximal among the `ξ`-invariant abelian normal subgroups. -/
private theorem c4_maximal (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hA : IsXiAbelNormal h A) (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    ∀ B : Subgroup P, IsXiAbelNormal h B → A ≤ B → B = A :=
  Work.Higman.maximal_of_c4_data h hA hsq hA4 htop hcard

/-- In the `C₄` setting, `C_P(A) = A`. -/
private theorem c4_centralizer (h : IsSuzuki2Grp P) {A : Subgroup P}
    (hA : IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    Subgroup.centralizer (A : Set P) = A :=
  Work.Higman.MSA.centralizer_eq_self h hA
    (c4_maximal h hA hsq hA4 htop hcard) hNA hGs hsq hA4 htop hcard
    (c4_A_not_le_center h hGs hsq htop hcard)

/-- **`⁅A,D⁆ = A²`** for a `ξ`-invariant normal `D ≥ A` with `⁅D,D⁆ = A²`, `A ≠ D` and
`C_P(A) = A`. -/
private theorem c4_comm_A_D (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : IsXiAbelNormal h A) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hA4 : Work.Higman.powSub A 4 = ⊥) (hAD : A ≤ D) (hADne : A ≠ D)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A) :
    ⁅A, D⁆ = Work.Higman.powSub A 2 := by
  have hle : ⁅A, D⁆ ≤ Work.Higman.powSub A 2 := by
    calc ⁅A, D⁆ ≤ ⁅D, D⁆ := Subgroup.commutator_mono hAD le_rfl
      _ = Work.Higman.powSub A 2 := hDd
  have hinv : (⁅A, D⁆ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⁅A, D⁆ := by
    rw [Subgroup.map_commutator, hA.map_eq, hDinv]
  rcases red_trichotomy h A ⁅A, D⁆ hA hA4
      (hle.trans (Work.Higman.powSub_le (by norm_num))) hinv with hb | hm | htop'
  · exfalso
    have h1 : (⁅D, A⁆ : Subgroup P) = ⊥ := by rw [Subgroup.commutator_comm]; exact hb
    have h2 : D ≤ Subgroup.centralizer (A : Set P) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp h1
    rw [hcent] at h2
    exact hADne (le_antisymm hAD h2)
  · exact hm
  · exfalso
    rw [htop'] at hle
    exact ne_powSub_two_of_card h htop hcard
      (le_antisymm hle (Work.Higman.powSub_le (by norm_num)))

/-- **`D ^ (2) = A ^ (2)`** for a `ξ`-invariant normal `D ≥ A` with `⁅D,D⁆ = A²`, `D ≠ A`. -/
private theorem c4_D_sq (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : IsXiAbelNormal h A) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hA4 : Work.Higman.powSub A 4 = ⊥) (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hAD : A ≤ D) (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hcent : Subgroup.centralizer (A : Set P) = A) (hADne : A ≠ D)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2) :
    Work.Higman.powSub D 2 = Work.Higman.powSub A 2 := by
  have hD2leA : Work.Higman.powSub D 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact hsq x
  have hCAd : ⁅A, D⁆ = Work.Higman.powSub A 2 :=
    c4_comm_A_D h hA hDinv hA4 hAD hADne hDd htop hcard hcent
  have hCAd' : ⁅D, A⁆ = Work.Higman.powSub A 2 := by
    rw [Subgroup.commutator_comm]; exact hCAd
  exact Work.Higman.HS.c4_C_sq_eq hA.abelian hA.map_eq htop hA4 hD2leA hDinv hDd hCAd'

/-- **`|D / A| = |Ω₁(P)|`** for a minimal `ξ`-invariant normal cover `D > A` with `⁅D,D⁆ = A²`. -/
private theorem c4_card_quot (h : IsSuzuki2Grp P) {A D : Subgroup P}
    (hA : IsXiAbelNormal h A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hDn : D.Normal) (hDinv : D.map (h.xi : MulAut P).toMonoidHom = D)
    (hAD : A ≤ D) (hADne : A ≠ D)
    (hDd : ⁅D, D⁆ = Work.Higman.powSub A 2)
    (hcover : ∀ F : Subgroup P, F.Normal → F.map (h.xi : MulAut P).toMonoidHom = F →
      A ≤ F → F ≤ D → F = A ∨ F = D) :
    Nat.card (↥D ⧸ (A.subgroupOf D)) = Nat.card ↥(Work.Higman.omega1 P) := by
  have hD2 : Work.Higman.powSub D 2 = Work.Higman.powSub A 2 :=
    c4_D_sq h hA hDinv htop hA4 hsq hAD hDd hcent hADne hcard
  have hAD2 : ⁅A, D⁆ = Work.Higman.powSub A 2 :=
    c4_comm_A_D h hA hDinv hA4 hAD hADne hDd htop hcard hcent
  refine Work.Higman.H8.c4_sq_a2_card_quot h hA hGs hNA htop hcent hDn hDinv hAD
    (fun hcon => hADne hcon.symm) hDd ?_ hcover hAD2
  rw [hD2, hDd, sup_idem]

/-- **The diagonal commutator relation.**  In any group, if `x ^ 2` is central and `⁅x,y⁆ ^ 4 = 1`
then `⁅x, ⁅x,y⁆⁆ = ⁅x,y⁆ ^ 2`.  (For `x` with `x ^ 2 ∈ Ω₁(P)` this is the relation
`Φ (β s t) s = β s t` of the two-cover endgame.) -/
private theorem commutator_diag_eq {G : Type} [Group G] {x y : G}
    (hx2 : x ^ 2 ∈ Subgroup.center G) (h4 : ⁅x, y⁆ ^ 4 = 1) :
    ⁅x, ⁅x, y⁆⁆ = ⁅x, y⁆ ^ 2 := by
  have h1 : ⁅x ^ 2, y⁆ = 1 :=
    commutatorElement_eq_one_iff_mul_comm.mpr (Subgroup.mem_center_iff.mp hx2 y).symm
  have h2 : ⁅x ^ 2, y⁆ = ⁅x, ⁅x, y⁆⁆ * ⁅x, y⁆ ^ 2 :=
    Work.Higman.commutatorElement_sq_self x y
  rw [h2] at h1
  have hv : (⁅x, y⁆ ^ 2)⁻¹ = ⁅x, y⁆ ^ 2 := by
    have h5 : (⁅x, y⁆ ^ 2) ^ 2 = 1 := by
      rw [← pow_mul, show 2 * 2 = 4 from rfl, h4]
    exact inv_eq_iff_mul_eq_one.mpr (by simpa [pow_two] using h5)
  have h3 : ⁅x, ⁅x, y⁆⁆ * ⁅x, y⁆ ^ 2 = 1 := h1
  -- from `u * v = 1` and `v = v⁻¹` conclude `u = v`
  have h6 : ⁅x, ⁅x, y⁆⁆ = (⁅x, y⁆ ^ 2)⁻¹ := (inv_eq_of_mul_eq_one_left h3).symm
  rw [h6, hv]

end Work.Higman.RedAux
end

-- ===== from Submission.Work.Higman.NSM.dsq_setup =====
section
/-
Copyright (c) 2024. All rights reserved.

# The `C₄` deep configuration (`deepSquareCase`): setup and elementary facts

This module bundles the hypotheses of `Work.Higman.NSM.deepSquareCase_v2` (Higman's `C₄`
exclusion in the maximal setting, the last open obligation of the `Higman` area) into the
structure `Work.Higman.NSM.C4`, records the elementary consequences that are *already proved*
elsewhere in the workspace, and proves the new elementary fact

* `Work.Higman.NSM.C4.powSub_top_two_eq` — `P² = A` (the square subgroup of `P` is all of `A`),

together with the cardinality facts `|D| = |Ω₁(P)|³`, `D ≠ ⊤`, etc.

It is deliberately placed in its own module so that the two branch lemmas
(`Work.Higman.NSM.dsq_caseA`, `Work.Higman.NSM.dsq_caseB`) — which are the two halves of the
case split `[P,D] ≤ A²` / `¬[P,D] ≤ A²` of the main theorem — can import it without creating a
cycle.
-/


set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace Work.Higman.NSM

open scoped commutatorElement

variable {P : Type} [Group P] [Finite P]

/-- **The `C₄` deep configuration.**  This is exactly the hypothesis list of
`Work.Higman.NSM.deepSquareCase_v2`: `P` a Suzuki 2-group, `A` a maximal `ξ`-invariant abelian
normal subgroup with `[P,P] = A`, `A² = Ω₁(P)`, `A⁴ = 1`, `|A| = |Ω₁(P)|²`, and `D` a minimal
`ξ`-invariant normal subgroup with `A < D ≤ P`, `[D,D] = A²`. -/
private structure C4 (h : Work.Higman.IsSuzuki2Grp P) (A D : Subgroup P) : Prop where
  ab : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x
  inv : A.map (h.xi : MulAut P).toMonoidHom = A
  max : ∀ B : Subgroup P, B.Normal → B.map (h.xi : MulAut P).toMonoidHom = B →
      (∀ x ∈ B, ∀ y ∈ B, x * y = y * x) → A ≤ B → B = A
  NA : Work.Higman.omega1 P ≤ A
  Gs : ⁅(⊤ : Subgroup P), ⊤⁆ = A
  sq : ∀ x : P, x ^ 2 ∈ A
  A4 : Work.Higman.powSub A 4 = ⊥
  top : Work.Higman.powSub A 2 = Work.Higman.omega1 P
  card : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2
  An : A.Normal
  Dn : D.Normal
  Dinv : D.map (h.xi : MulAut P).toMonoidHom = D
  AD : A ≤ D
  ADne : D ≠ A
  Dd : ⁅D, D⁆ = Work.Higman.powSub A 2
  cover : ∀ E : Subgroup P, E.Normal → E.map (h.xi : MulAut P).toMonoidHom = E →
      A ≤ E → E ≤ D → E = A ∨ E = D

namespace C4

variable {h : Work.Higman.IsSuzuki2Grp P} {A D : Subgroup P}

private theorem isXiAbelNormal (H : C4 h A D) : Work.Higman.IsXiAbelNormal h A :=
  ⟨H.An, H.inv, H.ab⟩

/-- In the `C₄` configuration the centralizer of `A` is `A`. -/
private theorem centralizer_eq (H : C4 h A D) : Subgroup.centralizer (A : Set P) = A :=
  Work.Higman.RedAux.c4_centralizer h H.isXiAbelNormal H.NA H.Gs H.sq H.A4 H.top H.card

/-- In the `C₄` configuration, `⁅A,D⁆ = A²`. -/
private theorem comm_A_D (H : C4 h A D) : ⁅A, D⁆ = Work.Higman.powSub A 2 :=
  Work.Higman.RedAux.c4_comm_A_D h H.isXiAbelNormal H.Dinv H.A4 H.AD (Ne.symm H.ADne) H.Dd
    H.top H.card H.centralizer_eq

/-- In the `C₄` configuration, `D² = A²`. -/
private theorem powSub_D_two_eq (H : C4 h A D) : Work.Higman.powSub D 2 = Work.Higman.powSub A 2 :=
  Work.Higman.RedAux.c4_D_sq h H.isXiAbelNormal H.Dinv H.top H.A4 H.sq H.AD H.Dd
    H.centralizer_eq (Ne.symm H.ADne) H.card

/-- In the `C₄` configuration, `|D/A| = |Ω₁(P)|`. -/
private theorem card_quot_eq (H : C4 h A D) :
    Nat.card (↥D ⧸ A.subgroupOf D) = Nat.card ↥(Work.Higman.omega1 P) :=
  Work.Higman.RedAux.c4_card_quot h H.isXiAbelNormal H.NA H.Gs H.sq H.A4 H.top H.card
    H.centralizer_eq H.Dn H.Dinv H.AD (Ne.symm H.ADne) H.Dd H.cover

/-- In the `C₄` configuration, `|D| = |Ω₁(P)|³`. -/
private theorem card_D (H : C4 h A D) :
    Nat.card ↥D = (Nat.card ↥(Work.Higman.omega1 P)) ^ 3 := by
  have hsub : Nat.card ↥(A.subgroupOf D) = Nat.card ↥A :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe H.AD)
  have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf D)
  rw [H.card_quot_eq, hsub, H.card] at h1
  rw [h1]; ring

/-- `A ≠ A²` in the `C₄` configuration. -/
private theorem A_ne_powSub_two (H : C4 h A D) : A ≠ Work.Higman.powSub A 2 := by
  intro hEq
  have hcardeq : Nat.card ↥(Work.Higman.omega1 P) ^ 2
      = Nat.card ↥(Work.Higman.omega1 P) := by
    rw [← H.card, hEq, H.top]
  have h4 := h.omega1_card_ge_four
  have hpos : 0 < Nat.card ↥(Work.Higman.omega1 P) := Nat.card_pos
  nlinarith [hcardeq, h4, hpos]

/-- `D < ⊤` in the `C₄` configuration: `[D,D] = A² ≠ A = [P,P]`. -/
private theorem D_ne_top (H : C4 h A D) : D ≠ ⊤ := by
  intro htop
  have h1 : ⁅(⊤ : Subgroup P), ⊤⁆ = Work.Higman.powSub A 2 := by
    rw [← htop]; exact H.Dd
  rw [H.Gs] at h1
  exact H.A_ne_powSub_two h1

/-- There is an element of `P` outside `D`. -/
private theorem exists_notMem_D (H : C4 h A D) : ∃ x : P, x ∉ D := by
  by_contra hcon
  push_neg at hcon
  exact H.D_ne_top (le_antisymm le_top (fun x _ => hcon x))

/-- **`P² = A`** in the `C₄` configuration: the square subgroup of `P` is exactly `A`.

`P² ∈ {⊥, A², A}` (a `ξ`-invariant subgroup of `A`, using `homogeneous_structure` and `A⁴ = ⊥`).
`P² = ⊥` forces `P` to have exponent `2`, hence to be abelian; `P² = A²` forces `[P,P] ⊆ A²`
(the identity `(xy)² = ⁅y,x⁆ˣ · x² · y²` and normality of `A²`), and then `A = [P,P] = A²`. -/
private theorem powSub_top_two_eq (H : C4 h A D) : Work.Higman.powSub (⊤ : Subgroup P) 2 = A := by
  have hSA : Work.Higman.powSub (⊤ : Subgroup P) 2 ≤ A := by
    rw [Work.Higman.powSub, Subgroup.closure_le]
    rintro y ⟨x, -, rfl⟩
    exact H.sq x
  have hSinv : (Work.Higman.powSub (⊤ : Subgroup P) 2).map (h.xi : MulAut P).toMonoidHom
      = Work.Higman.powSub (⊤ : Subgroup P) 2 := by
    have htop : (⊤ : Subgroup P).map (h.xi : MulAut P).toMonoidHom = ⊤ := by
      rw [Subgroup.map_top]
      exact MonoidHom.range_eq_top.mpr (h.xi : MulAut P).surjective
    exact Work.Higman.map_powSub (h.xi : MulAut P) htop 2
  obtain ⟨e, -, -, -, hsub⟩ := Work.Higman.homogeneous_structure h H.ab H.inv
  obtain ⟨i, hi⟩ := hsub _ hSA hSinv
  rcases Nat.eq_zero_or_pos i with h0 | hpos
  · rw [hi, h0, pow_zero, Work.Higman.powSub_one_eq]
  rcases lt_or_ge i 2 with hlt | hge
  · -- `S = A²`: then `[P,P] ⊆ A²` and `A = A²`
    exfalso
    have hi1 : i = 1 := by omega
    have hS : Work.Higman.powSub (⊤ : Subgroup P) 2 = Work.Higman.powSub A 2 := by
      rw [hi, hi1]; norm_num
    have hcomm_le : ⁅(⊤ : Subgroup P), ⊤⁆ ≤ Work.Higman.powSub A 2 := by
      rw [Subgroup.commutator_le]
      intro x _ y _
      have hA2z : Work.Higman.powSub A 2 ≤ Subgroup.center P := by
        rw [H.top]; exact h.omega1_le_center
      have hnorm : (Work.Higman.powSub A 2).Normal := Subgroup.normal_of_le_center hA2z
      have hmem : ∀ z : P, z ^ 2 ∈ Work.Higman.powSub A 2 := fun z => by
        rw [← hS]; exact Work.Higman.pow_mem_powSub (Subgroup.mem_top z)
      have hc : x⁻¹ * x⁻¹ ∈ Work.Higman.powSub A 2 := by
        have h2 : x⁻¹ * x⁻¹ = (x ^ 2)⁻¹ := by group
        rw [h2]; exact Subgroup.inv_mem _ (hmem x)
      have hyx : ⁅y, x⁆ ∈ Work.Higman.powSub A 2 := by
        have h1 : ⁅y, x⁆ = x⁻¹ * (x * y) ^ 2 * (y ^ 2)⁻¹ * x⁻¹ := by
          rw [commutatorElement_def]; simp only [pow_two]; group
        have hkey : x⁻¹ * (x * y) ^ 2 * (y ^ 2)⁻¹ * x⁻¹
            = (x⁻¹ * (x*y)^2 * x) * (x⁻¹ * (y^2)⁻¹ * x) * (x⁻¹ * x⁻¹) := by group
        rw [h1, hkey]
        refine Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) hc
        · simpa [inv_inv] using hnorm.conj_mem _ (hmem (x*y)) x⁻¹
        · simpa [inv_inv] using hnorm.conj_mem _ (Subgroup.inv_mem _ (hmem y)) x⁻¹
      rw [← commutatorElement_inv y x]
      exact Subgroup.inv_mem _ hyx
    have hAle : A ≤ Work.Higman.powSub A 2 := by
      calc A = ⁅(⊤ : Subgroup P), ⊤⁆ := H.Gs.symm
        _ ≤ Work.Higman.powSub A 2 := hcomm_le
    exact H.A_ne_powSub_two
      (le_antisymm hAle (Work.Higman.powSub_le (n := 2) (by norm_num)))
  · -- `S ≤ A⁴ = ⊥`: `P` has exponent `2`, hence is abelian
    exfalso
    have hbot : Work.Higman.powSub (⊤ : Subgroup P) 2 = ⊥ := by
      rw [hi]
      refine le_bot_iff.mp ?_
      have hdvd : 4 ∣ 2 ^ i := ⟨2 ^ (i - 2), by
        rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_add]; congr 1; omega⟩
      exact le_trans (Work.Higman.powSub_le_of_dvd H.ab hdvd) (le_of_eq H.A4)
    obtain ⟨x, y, hxy⟩ := h.noncomm
    have hxA : x ∈ A := H.NA (h.mem_omega1.mpr (by
      have hh := Work.Higman.pow_mem_powSub (n := 2) (Subgroup.mem_top x)
      rw [hbot] at hh; simpa using Subgroup.mem_bot.mp hh))
    have hyA : y ∈ A := H.NA (h.mem_omega1.mpr (by
      have hh := Work.Higman.pow_mem_powSub (n := 2) (Subgroup.mem_top y)
      rw [hbot] at hh; simpa using Subgroup.mem_bot.mp hh))
    exact hxy (H.ab x hxA y hyA)

end C4

/-- **The `⁅P,D⁆ ≤ A²` branch of `deepSquareCase`.**  In this branch the configuration is
impossible: if `D` does not centralise `A`, `H8.false_of_comm_le_powSub_two` applies; if it does,
Gorenstein–Thompson (`H8.alt_pairing_false`) applied to the cover `D` of `A` applies. -/
private theorem C4.caseA {h : Work.Higman.IsSuzuki2Grp P} {A D : Subgroup P}
    (H : C4 h A D) (hPD : ⁅(⊤ : Subgroup P), D⁆ ≤ Work.Higman.powSub A 2) : False := by
  have hC2 : Work.Higman.powSub D 2 ≤ A := by
    rw [H.powSub_D_two_eq]; exact Work.Higman.powSub_le (n := 2) (by norm_num)
  by_cases hnZ : ∀ e ∈ D, ∀ a ∈ A, e * a = a * e
  · refine Work.Higman.H8.alt_pairing_false h H.isXiAbelNormal H.Dn H.Dinv H.AD H.ADne
      H.cover hnZ hC2 H.Dd H.top.symm ?_ ?_
    · intro hbot
      rw [H.top] at hbot
      have h4 := h.omega1_card_ge_four
      rw [hbot] at h4
      simp at h4
    · intro a ha
      have hmem : a ^ 4 ∈ Work.Higman.powSub A 4 :=
        Work.Higman.pow_mem_powSub (n := 4) ha
      rw [H.A4] at hmem
      exact Subgroup.mem_bot.mp hmem
  · exact Work.Higman.H8.false_of_comm_le_powSub_two h H.isXiAbelNormal H.Gs H.sq H.A4 H.top
      H.Dd H.AD H.Dinv hnZ hPD

end Work.Higman.NSM
end

-- ===== from Submission.Work.Higman.NSM.two_cover_exists =====
section

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped commutatorElement

namespace Work.Higman.NSM

private theorem two_cover_exists {P : Type} [Group P] [Finite P] (h : Work.Higman.IsSuzuki2Grp P)
    {A C : Subgroup P}
    (hA : Work.Higman.IsXiAbelNormal h A)
    (hmax : ∀ B : Subgroup P, Work.Higman.IsXiAbelNormal h B → A ≤ B → B = A)
    (hNA : Work.Higman.omega1 P ≤ A)
    (hGs : ⁅(⊤ : Subgroup P), ⊤⁆ = A)
    (hsq : ∀ x : P, x ^ 2 ∈ A)
    (hA4 : Work.Higman.powSub A 4 = ⊥)
    (htop : Work.Higman.powSub A 2 = Work.Higman.omega1 P)
    (hcard : Nat.card ↥A = (Nat.card ↥(Work.Higman.omega1 P)) ^ 2)
    (hcent : Subgroup.centralizer (A : Set P) = A)
    (hCn : C.Normal) (hCinv : C.map (h.xi : MulAut P).toMonoidHom = C)
    (hAC : A ≤ C) (hCA : A ≠ C)
    (hcover : ∀ D : Subgroup P, D.Normal → D.map (h.xi : MulAut P).toMonoidHom = D →
      A ≤ D → D ≤ C → D = A ∨ D = C)
    (hCpow2 : Work.Higman.powSub C 2 = Work.Higman.powSub A 2)
    (hCd : ⁅C, C⁆ = Work.Higman.powSub A 2)
    (hCT : ⁅C, (⊤ : Subgroup P)⁆ = A)
    (hsmall : ∀ {Q : Type} [Group Q] [Finite Q] (hQ : Work.Higman.IsSuzuki2Grp Q),
      Nat.card Q < Nat.card P →
      ∀ (A' C' : Subgroup Q), Work.Higman.IsXiAbelNormal hQ A' →
        Work.Higman.omega1 Q ≤ A' → ⁅(⊤ : Subgroup Q), ⊤⁆ = A' → (∀ x : Q, x ^ 2 ∈ A') →
        Work.Higman.powSub A' 4 = ⊥ → Work.Higman.powSub A' 2 = Work.Higman.omega1 Q →
        Nat.card ↥A' = (Nat.card ↥(Work.Higman.omega1 Q)) ^ 2 →
        C'.Normal → C'.map (hQ.xi : MulAut Q).toMonoidHom = C' → A' ≤ C' → A' ≠ C' →
        (∀ D : Subgroup Q, D.Normal → D.map (hQ.xi : MulAut Q).toMonoidHom = D →
          A' ≤ D → D ≤ C' → D = A' ∨ D = C') →
        Work.Higman.powSub C' 2 = Work.Higman.powSub A' 2 → ⁅C', C'⁆ = Work.Higman.powSub A' 2 →
        ⁅C', (⊤ : Subgroup Q)⁆ = A' → False) :
    ∃ E : Subgroup P, E.Normal ∧ E.map (h.xi : MulAut P).toMonoidHom = E ∧ A ≤ E ∧ A ≠ E ∧
