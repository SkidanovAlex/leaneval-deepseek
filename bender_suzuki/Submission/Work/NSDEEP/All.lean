        rw [hxi, Work.Higman.HS.htc_map_subgroupOf_restrictAut, hCinv]
      have hAC' : A.subgroupOf (C ⊔ E) ≤ C.subgroupOf (C ⊔ E) := Subgroup.comap_mono hAC
      have hCA' : A.subgroupOf (C ⊔ E) ≠ C.subgroupOf (C ⊔ E) := by
