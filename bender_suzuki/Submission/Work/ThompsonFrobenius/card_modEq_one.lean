/-!
# `|G| ≡ 1 [MOD q]` for a fixed-point-free automorphism with `α ^ q = 1`

Let `G` be a finite group and `α` a fixed-point-free automorphism of `G`
(`Work.NPC.Fpf.IsFpf α`, i.e. `α x = x → x = 1`) with `α ^ q = 1` for a prime `q`.
Then the order of `G` is `≡ 1` modulo `q`.

The proof is the elementary orbit count, in the general form packaged by Mathlib as the
congruence `IsPGroup.card_modEq_card_fixedPoints` for actions of `p`-groups: the cyclic
subgroup `H = ⟨α⟩ ≤ MulAut G` is a `q`-group (`α ^ q = 1`, so every element of `H` has
`q`-th power `1`), it acts on `G` through the tautological action of `MulAut G`, and its
fixed points are exactly `{1}` because `α` is fixed-point-free.  Hence

  `|G| ≡ |Fix(H)| = 1 (mod q)`.

No nilpotency (Thompson's theorem) is needed for this congruence: fixed-point-freeness
alone makes the action free on `G \ {1}` and the orbit count is immediate.
-/

set_option linter.style.haveILetI false

namespace Work.ThompsonFrobenius

open Work.NPC.Fpf

/-- If `α ^ q = 1` then every element of the cyclic subgroup `⟨α⟩ ≤ MulAut G` has `q`-th
power `1`, so `⟨α⟩` is a `q`-group.  (No primality of `q` is needed for this step.) -/
theorem isPGroup_zpowers_of_pow_eq_one {G : Type*} [Group G] {α : MulAut G} {q : ℕ}
    (hαq : α ^ q = 1) : IsPGroup q ↥(Subgroup.zpowers α) := by
  intro h
  refine ⟨1, ?_⟩
  have hp : h ^ q = 1 := by
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp h.2
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [← hk, ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hαq, one_zpow]
  simpa using hp

theorem card_modEq_one {G : Type*} [Group G] [Finite G] {q : ℕ} (hq : q.Prime) {α : MulAut G} (hαq : α ^ q = 1) (hfpf : Work.NPC.Fpf.IsFpf α) : Nat.card G ≡ 1 [MOD q] := by
  haveI : Fact q.Prime := ⟨hq⟩
  -- The cyclic subgroup generated by `α`, acting on `G` via the tautological `MulAut` action.
  let H : Subgroup (MulAut G) := Subgroup.zpowers α
  have hH : IsPGroup q ↥H := fun h => isPGroup_zpowers_of_pow_eq_one hαq h
  -- The `p`-group orbit congruence `|G| ≡ |Fix(H)| (mod q)`.
  have hmod := hH.card_modEq_card_fixedPoints G
  -- The fixed points of `H` are exactly `{1}`, since `α` is fixed-point-free.
  have hfix : MulAction.fixedPoints ↥H G = ({1} : Set G) := by
    ext x
    constructor
    · intro hx
      have h1 : (⟨α, Subgroup.mem_zpowers α⟩ : ↥H) • x = x := hx ⟨α, Subgroup.mem_zpowers α⟩
      exact hfpf x h1
    · intro hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      intro h
      simp
  have hcard : Nat.card (MulAction.fixedPoints ↥H G) = 1 := by
    rw [hfix, Nat.card_eq_fintype_card, Set.card_singleton]
  rw [hcard] at hmod
  exact hmod

end Work.ThompsonFrobenius
