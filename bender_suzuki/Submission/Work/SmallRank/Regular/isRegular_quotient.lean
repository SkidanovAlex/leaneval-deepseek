set_option linter.unusedVariables false

open scoped Classical Pointwise commutatorElement
open Subgroup

noncomputable section

namespace Work.SmallRank.Regular

/-- The `agemo` subgroup commutes with pushing forward along a group homomorphism: the image of
`℧ⁱ(P)` is `℧ⁱ` of the image of `P`.  (`Subgroup.map` and `agemo` are both "generated by"
constructions, and a homomorphism carries `p ^ i`-th powers to `p ^ i`-th powers.) -/
theorem agemo_map {G H : Type*} [Group G] [Group H] (f : G →* H) (p i : ℕ) (P : Subgroup G) :
    (Work.PGroup.agemo p i P).map f = Work.PGroup.agemo p i (P.map f) := by
  unfold Work.PGroup.agemo
  rw [MonoidHom.map_closure]
  congr 1
  ext z
  simp only [Set.mem_image, Set.mem_ofPred_eq, Subgroup.mem_map]
  constructor
  · rintro ⟨y, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨f x, ⟨x, hx, rfl⟩, (map_pow f x (p ^ i)).symm⟩
  · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨x ^ p ^ i, ⟨x, hx, rfl⟩, by rw [map_pow]⟩

/-- The image under a homomorphism of the subgroup generated by two elements `x`, `y` is the
subgroup generated by their images. -/
theorem map_closure_pair {G H : Type*} [Group G] [Group H] (f : G →* H) (x y : G) :
    (Subgroup.closure ({x, y} : Set G)).map f = Subgroup.closure ({(f x), (f y)} : Set H) := by
  rw [MonoidHom.map_closure]
  congr 1
  ext z
  simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨w, rfl | rfl, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨x, Or.inl rfl, rfl⟩
    · exact ⟨y, Or.inr rfl, rfl⟩

/-- Regularity is preserved by taking quotients (Huppert III.10.1: if `X` is regular then so is
`X / N`, since a witness `d ∈ ℧¹(⟨x,y⟩')` defining `x^p y^p` maps to a witness
`f d ∈ ℧¹(⟨f x, f y⟩')` for the images). -/
theorem isRegular_quotient {p : ℕ} {X : Type*} [Group X] (hR : IsRegular p X) (N : Subgroup X)
    [N.Normal] : IsRegular p (X ⧸ N) := by
  intro xb yb
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N xb
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N yb
  obtain ⟨d, hd, heq⟩ := hR x y
  refine ⟨QuotientGroup.mk' N d, ?_, ?_⟩
  · have h1 : QuotientGroup.mk' N d ∈
        (Work.PGroup.agemo p 1
          (⁅Subgroup.closure ({x, y} : Set X), Subgroup.closure ({x, y} : Set X)⁆ :
            Subgroup X)).map (QuotientGroup.mk' N) :=
      Subgroup.mem_map.mpr ⟨d, hd, rfl⟩
    rw [agemo_map, Subgroup.map_commutator, map_closure_pair] at h1
    exact h1
  · rw [← map_pow, ← map_pow, ← map_mul, heq, map_mul, map_pow, map_mul]

end Work.SmallRank.Regular
