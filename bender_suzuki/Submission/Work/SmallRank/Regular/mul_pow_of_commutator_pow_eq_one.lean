/-
# `Work.SmallRank.Regular.mul_pow_of_commutator_pow_eq_one`

Huppert, *Endliche Gruppen I*, III.10.6 (a) (P. Hall): in a regular `p`-group whose derived
subgroup has exponent `p`, the `p`-th power map is additive, `(x y)^p = x^p y^p`.

Regularity (Huppert III.10.1, `Work.SmallRank.IsRegular`) gives for every `x y` an element
`d ∈ ℧¹(⟨x,y⟩')` with `x^p y^p = (x y)^p · d`, so `(xy)^p = x^p y^p · d⁻¹` and it remains to see
that `d = 1`.  Now `⟨x,y⟩'` is generated by commutators `[u,v]` of elements `u, v` of `⟨x,y⟩`,
each of which has `p`-th power one by hypothesis.  In a regular `p`-group the elements of order
dividing `p` are closed under multiplication (Huppert III.10.5, the companion result
`pow_mul_eq_one_of_isRegular`), so by the closure lemma `closure_pow_eq_one_of_pow_eq_one` the
whole derived subgroup `⟨x,y⟩'` has exponent `p`.  Hence every generator `z^p` of `℧¹(⟨x,y⟩')` is
trivial, `℧¹(⟨x,y⟩') = ⊥` (`agemo_eq_bot_of_pow`), and `d = 1`.
-/
import Mathlib
import Submission.Work.SmallRank.Regular.Defs
import Submission.Work.SmallRank.Regular.pow_mul_eq_one_of_isRegular
import Submission.Work.SmallRank.Regular.agemo_eq_bot_of_pow

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false

open scoped Classical Pointwise commutatorElement
open Subgroup

namespace Work.SmallRank.Regular

theorem mul_pow_of_commutator_pow_eq_one {p : ℕ} (hp : p.Prime) {X : Type*} [Group X] [Finite X]
    (hX : IsPGroup p X) (hR : Work.SmallRank.IsRegular p X)
    (h : ∀ u v : X, (u * v * u⁻¹ * v⁻¹) ^ p = 1) (x y : X) :
    (x * y) ^ p = x ^ p * y ^ p := by
  -- In a regular `p`-group, products of elements of order dividing `p` again have order dividing
  -- `p`; hence every element of the derived subgroup of `X` (generated by commutators, each of
  -- order dividing `p` by hypothesis) has `p`-th power one.
  have hX'exp : ∀ z ∈ ⁅(⊤ : Subgroup X), (⊤ : Subgroup X)⁆, z ^ p = 1 := by
    rw [Subgroup.commutator_def (⊤ : Subgroup X) (⊤ : Subgroup X)]
    refine closure_pow_eq_one_of_pow_eq_one ?_ ?_
    · rintro z ⟨u, -, v, -, rfl⟩
      simpa [commutatorElement_def] using h u v
    · intro u _ v _ hu hv
      exact pow_mul_eq_one_of_isRegular hp hX hR hu hv
  -- so the derived subgroup of `⟨x, y⟩ ≤ X` has exponent `p` as well
  have hK'exp : ∀ z ∈ ⁅Subgroup.closure ({x, y} : Set X), Subgroup.closure ({x, y} : Set X)⁆,
      z ^ p = 1 :=
    fun z hz => hX'exp z (Subgroup.commutator_mono le_top le_top hz)
  -- regularity produces the defect `d ∈ ℧¹(⟨x,y⟩')`, which therefore vanishes
  obtain ⟨d, hd, hdeq⟩ := hR x y
  rw [agemo_eq_bot_of_pow hK'exp] at hd
  have hd1 : d = 1 := Subgroup.mem_bot.mp hd
  rw [hd1, mul_one] at hdeq
  exact hdeq.symm

end Work.SmallRank.Regular
