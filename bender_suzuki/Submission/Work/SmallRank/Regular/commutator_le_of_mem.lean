/-!
# `Work.SmallRank.Regular.commutator_le_of_mem`

If `x, y` generate `G` and the commutator `[x,y] = x y x⁻¹ y⁻¹` lies in a normal subgroup `N`,
then the whole derived subgroup `[G,G]` lies in `N`.

Equivalently, the quotient `G ⧸ N` is generated by the commuting images of `x` and `y`, hence is
commutative; then `[G,G] ≤ N` by `Subgroup.Normal.quotient_commutative_iff_commutator_le`.
-/

open scoped commutatorElement Pointwise

namespace Work.SmallRank.Regular

theorem commutator_le_of_mem {G : Type*} [Group G] {x y : G}
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) (N : Subgroup G) [N.Normal]
    (hxy : x * y * x⁻¹ * y⁻¹ ∈ N) : Work.SmallRank.commutator G ≤ N := by
  -- It suffices to show that `G ⧸ N` is commutative.
  have key : IsMulCommutative (G ⧸ N) := by
    let q : G →* G ⧸ N := QuotientGroup.mk' N
    -- The images of `x` and `y` still generate the quotient.
    have hqgen : Subgroup.closure ({(q x), (q y)} : Set (G ⧸ N)) = ⊤ := by
      have himg : ({(q x), (q y)} : Set (G ⧸ N)) = q '' ({x, y} : Set G) := by
        rw [Set.image_pair]
      rw [himg, ← MonoidHom.map_closure q ({x, y} : Set G), hgen,
        Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective N)]
    -- and they commute in the quotient, since `[x,y] ∈ N = ker q`.
    have hcomm : Commute (q x) (q y) := by
      apply commutatorElement_eq_one_iff_commute.mp
      have hker : q (x * y * x⁻¹ * y⁻¹) = 1 := by
        rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']; exact hxy
      rw [← map_commutatorElement q x y, commutatorElement_def]
      exact hker
    have hpair : ({(q x), (q y)} : Set (G ⧸ N)).Pairwise Commute := by
      intro a ha b hb _
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
      rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
      · exact Commute.refl _
      · exact hcomm
      · exact hcomm.symm
      · exact Commute.refl _
    have htop : IsMulCommutative (⊤ : Subgroup (G ⧸ N)) :=
      hqgen ▸ Subgroup.isMulCommutative_closure hpair
    exact Function.Surjective.isMulCommutative Subgroup.topEquiv.surjective htop
  exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp key

end Work.SmallRank.Regular
