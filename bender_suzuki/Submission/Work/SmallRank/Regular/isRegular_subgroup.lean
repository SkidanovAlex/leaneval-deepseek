/-!
# Regularity passes to subgroups

P. Hall's regularity (Huppert, *Endliche Gruppen I*, III.10.1) is *local*: the defining condition
for `x, y` only mentions the subgroup generated by `x` and `y`.  Consequently it is inherited by
every subgroup `H ≤ X` — the point being that the groups `⟨x,y⟩`, their derived subgroup and its
agemo are all computed inside `⟨x,y⟩ ≤ H`, so nothing is lost by passing to `H`.

The only real work is bookkeeping: forming `℧¹` (`Work.PGroup.agemo`) commutes with homomorphic
images (`map_agemo` below), and so does the derived subgroup (`Subgroup.map_commutator`).  The
witnessing element `d` produced by regularity in `X` therefore already lies in `H`.
-/

namespace Work.SmallRank.Regular

open Subgroup

/-- The agemo subgroups commute with homomorphic images:
`℧ⁱ(K).map f = ℧ⁱ(K.map f)`, i.e. the image of the subgroup generated by the `p^i`-th powers of
the elements of `K` is the subgroup generated by the `p^i`-th powers of the elements of `K.map f`.
No injectivity or surjectivity of `f` is needed. -/
lemma map_agemo {G N : Type*} [Group G] [Group N] (f : G →* N) (p i : ℕ) (K : Subgroup G) :
    (Work.PGroup.agemo p i K).map f = Work.PGroup.agemo p i (K.map f) := by
  unfold Work.PGroup.agemo
  rw [MonoidHom.map_closure]
  congr 1
  ext z
  simp only [Set.mem_image, Set.mem_ofPred_eq, Subgroup.mem_map]
  constructor
  · rintro ⟨y, ⟨w, hwK, hwpow⟩, hyz⟩
    exact ⟨f w, ⟨w, hwK, rfl⟩, by rw [← map_pow, hwpow, hyz]⟩
  · rintro ⟨w, ⟨w₀, hw₀K, rfl⟩, hwz⟩
    exact ⟨w₀ ^ (p ^ i), ⟨w₀, hw₀K, rfl⟩, by rw [map_pow, hwz]⟩

/-- Regularity is inherited by subgroups. -/
theorem isRegular_subgroup {p : ℕ} {X : Type*} [Group X] (hR : IsRegular p X) (H : Subgroup X) :
    IsRegular p ↥H := by
  intro x y
  obtain ⟨d, hdmem, hdeq⟩ := hR (x : X) (y : X)
  -- the subgroup of `X` generated by `x` and `y` is the image of the one generated in `H`
  have hmapC : (Subgroup.closure ({x, y} : Set ↥H)).map H.subtype
      = Subgroup.closure ({(x : X), (y : X)} : Set X) := by
    rw [MonoidHom.map_closure]
    congr 1
    ext z
    simp
  -- hence the agemo of the derived subgroup of `⟨x,y⟩` is the image of the corresponding
  -- agemo computed in `H`, so the witness `d` comes from an element `d'` of `H`
  have hd : d ∈ (Work.PGroup.agemo p 1 ⁅Subgroup.closure ({x, y} : Set ↥H),
      Subgroup.closure ({x, y} : Set ↥H)⁆).map H.subtype := by
    rw [map_agemo H.subtype p 1, Subgroup.map_commutator, hmapC]
    exact hdmem
  obtain ⟨d', hd'mem, hd'eq⟩ := Subgroup.mem_map.mp hd
  refine ⟨d', hd'mem, ?_⟩
  refine H.subtype_injective ?_
  rw [map_mul, map_pow, map_pow, map_mul, hd'eq]
  exact hdeq

end Work.SmallRank.Regular
