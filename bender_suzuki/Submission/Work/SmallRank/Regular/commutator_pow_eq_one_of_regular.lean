/-
# `Work.SmallRank.Regular.commutator_pow_eq_one_of_regular`

In a finite regular `p`-group, an element `x` of order dividing `p` has all its commutators
`[y,x] = y * x * y⁻¹ * x⁻¹` of order dividing `p`.

The proof rests on the companion result `pow_mul_eq_one_of_isRegular` (Huppert, *Endliche
Gruppen I*, Hauptsatz III.10.5 a): in a regular `p`-group the elements of order dividing `p` are
closed under multiplication.  Consequently the normal closure `L = ⟨x^g : g ∈ X⟩` of `x` — which is
generated by the conjugates of `x`, all of order dividing `p` — has exponent dividing `p`, by the
closure lemma `closure_pow_eq_one_of_pow_eq_one`.  And `[y,x] = x^y · x⁻¹` is a product of two
elements of `L`, so it too lies in `Ω₁`.

-/
import Mathlib
import Submission.Work.SmallRank.Regular.Defs
import Submission.Work.SmallRank.Regular.pow_mul_eq_one_of_isRegular

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped Classical Pointwise commutatorElement
open Subgroup

namespace Work.SmallRank.Regular

theorem commutator_pow_eq_one_of_regular {p : ℕ} (hp : p.Prime) {X : Type*} [Group X] [Finite X]
    (hX : IsPGroup p X) (hR : Work.SmallRank.IsRegular p X) {x y : X} (hx : x ^ p = 1) :
    (y * x * y⁻¹ * x⁻¹) ^ p = 1 := by
  -- `L`, the normal closure of `x`, has exponent dividing `p`
  let L : Subgroup X := Subgroup.normalClosure ({x} : Set X)
  haveI hLn : L.Normal := Subgroup.normalClosure_normal
  have hxL : x ∈ L := Subgroup.subset_normalClosure (by simp)
  have hLexp : ∀ z ∈ L, z ^ p = 1 := by
    -- `L` is generated by the conjugates of `x`, each of order dividing `p`,
    -- and products of such elements again have order dividing `p` in a regular `p`-group
    change ∀ z ∈ Subgroup.closure (Group.conjugatesOfSet ({x} : Set X)), z ^ p = 1
    refine closure_pow_eq_one_of_pow_eq_one ?_ ?_
    · intro s hs
      rw [Group.mem_conjugatesOfSet_iff] at hs
      obtain ⟨a, ha, hc⟩ := hs
      obtain rfl : a = x := by simpa using ha
      obtain ⟨c, hc'⟩ := isConj_iff.mp hc
      rw [← hc', ← MulAut.conj_apply, ← map_pow, hx, map_one]
    · intro u hu v hv hu1 hv1
      have hu1' : (⟨u, hu⟩ : ↥L) ^ p = 1 := by apply Subtype.ext; simpa using hu1
      have hv1' : (⟨v, hv⟩ : ↥L) ^ p = 1 := by apply Subtype.ext; simpa using hv1
      have h := pow_mul_eq_one_of_isRegular hp (hX.to_subgroup L) (isRegular_subgroup hR L)
        hu1' hv1'
      simpa using congrArg (fun z : ↥L => (z : X)) h
  -- `[y,x] = x^y * x⁻¹` is a product of two elements of `L`
  have hmem : MulAut.conj y x * x⁻¹ ∈ L :=
    L.mul_mem (hLn.conj_mem x hxL y) (L.inv_mem hxL)
  have hkey : y * x * y⁻¹ * x⁻¹ = MulAut.conj y x * x⁻¹ := by rw [MulAut.conj_apply]
  rw [hkey]
  exact hLexp _ hmem

end Work.SmallRank.Regular
