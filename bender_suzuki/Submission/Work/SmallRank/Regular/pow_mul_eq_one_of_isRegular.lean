/-
# `Work.SmallRank.Regular.pow_mul_eq_one_of_isRegular`

P. Hall's theorem that in a regular `p`-group the elements of order dividing `p` form a subgroup
(Huppert, *Endliche Gruppen I*, Hauptsatz III.10.5 a), in the special form consumed by the
classification of `p`-groups of `p`-rank `≤ 2`: if `x ^ p = y ^ p = 1` then `(x * y) ^ p = 1`.

The proof is Huppert's (pp. 324–325), an induction on `|X|`:

* If `⟨x, y⟩ < X` we may pass to the subgroup `⟨x, y⟩`; otherwise `X = ⟨x, y⟩`.
* An abelian `X` is trivial: `(x y)^p = x^p y^p = 1`.
* So assume `X = ⟨x,y⟩` nonabelian.  Let `L = ⟨x^g : g ∈ X⟩` be the normal closure of `x`, a
  proper subgroup (`⟨x⟩ · X' = X` would make the abelianization cyclic, impossible for a
  nonabelian `p`-group: `zpowers_sup_commutator_ne_top`).  `L` is generated by conjugates of `x`,
  all of `p`-th power one, so by the induction hypothesis `L` has exponent `p`; in particular
  `[x,y] = x · (x⁻¹)^y ∈ L` has `p`-th power one.
* Since `X = ⟨x,y⟩`, the subgroup `X' = ⁅⊤,⊤⁆` is contained in the normal closure `N` of `[x,y]`
  (`commutator_le_of_mem`: modulo `N` the images of `x` and `y` commute).  All conjugates of
  `[x,y]` lie in `L`, hence have `p`-th power one, and `N < X`, so the induction hypothesis gives
  that `N`, and hence `X'`, has exponent `p`, i.e. `℧¹(X') = 1` (`agemo_eq_bot_of_pow`).
* Regularity gives `x^p y^p = (xy)^p d` with `d ∈ ℧¹(⟨x,y⟩') = ℧¹(X') = 1`, and `x^p y^p = 1`.
-/
import Mathlib
import Submission.Work.SmallRank.Regular.Defs
import Submission.Work.SmallRank.Regular.commutator_ne_top
import Submission.Work.SmallRank.Regular.zpowers_sup_commutator_ne_top
import Submission.Work.SmallRank.Regular.commutator_le_of_mem
import Submission.Work.SmallRank.Regular.agemo_eq_bot_of_pow
import Submission.Work.SmallRank.Regular.isRegular_subgroup

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped Classical Pointwise commutatorElement
open Subgroup

namespace Work.SmallRank.Regular

/-- **Closure lemma.**  If every element of a set `S` has `p`-th power one and the elements of
`p`-th power one inside `⟨S⟩` are closed under multiplication, then every element of `⟨S⟩` has
`p`-th power one. -/
lemma closure_pow_eq_one_of_pow_eq_one {p : ℕ} {X : Type*} [Group X] {S : Set X}
    (hS : ∀ s ∈ S, s ^ p = 1)
    (hmul : ∀ u ∈ Subgroup.closure S, ∀ v ∈ Subgroup.closure S, u ^ p = 1 → v ^ p = 1 →
      (u * v) ^ p = 1) :
    ∀ z ∈ Subgroup.closure S, z ^ p = 1 := by
  intro z hz
  refine Subgroup.closure_induction (p := fun z _ => z ^ p = 1) ?_ ?_ ?_ ?_ hz
  · intro s hs; exact hS s hs
  · simp
  · intro u v hu hv ihu ihv; exact hmul u hu v hv ihu ihv
  · intro u hu ihu; rw [inv_pow, ihu, inv_one]

/-- **The normal closure of a single element of a nonabelian finite `p`-group is proper.**
If `L = ⟨x^g : g ∈ X⟩ = X`, then the abelianization `X/X'` would be generated by the image of `x`,
hence cyclic; but no element together with the commutator subgroup generates a nonabelian finite
`p`-group (`zpowers_sup_commutator_ne_top`). -/
lemma normalClosure_singleton_lt_top_of_not_isMulCommutative {p : ℕ} (hp : p.Prime) {X : Type*}
    [Group X] [Finite X] (hG : IsPGroup p X) (hab : ¬ IsMulCommutative X) (x : X) :
    Subgroup.normalClosure ({x} : Set X) < ⊤ := by
  -- every generator of the normal closure of `x` lies in `⟨x⟩ ⊔ X'`
  have hconj : ∀ c : X, c * x * c⁻¹ ∈ Subgroup.zpowers x ⊔ Work.SmallRank.commutator X := by
    intro c
    have h1 : c * x * c⁻¹ = x * ⁅x⁻¹, c⁆ := by rw [commutatorElement_def]; group
    rw [h1]
    exact Subgroup.mul_mem _
      (Subgroup.mem_sup_left (Subgroup.mem_zpowers x))
      (Subgroup.mem_sup_right
        (Subgroup.commutator_mem_commutator (Subgroup.mem_top x⁻¹) (Subgroup.mem_top c)))
  have hmem : Subgroup.normalClosure ({x} : Set X) ≤
      Subgroup.zpowers x ⊔ Work.SmallRank.commutator X := by
    rw [Subgroup.normalClosure, Subgroup.closure_le]
    rintro z hz
    rw [Group.mem_conjugatesOfSet_iff] at hz
    obtain ⟨a, ha, hc⟩ := hz
    obtain rfl : a = x := by simpa using ha
    obtain ⟨c, hc'⟩ := isConj_iff.mp hc
    rw [← hc']
    exact hconj c
  refine lt_of_le_of_ne le_top ?_
  intro htop
  exact zpowers_sup_commutator_ne_top hp hG hab x (top_le_iff.mp (htop ▸ hmem))

/-- **Induction statement.**  In a finite regular `p`-group `X`, the product of two elements of
order dividing `p` again has order dividing `p`.  Proved by strong induction on `Nat.card X`, which
is why the statement is phrased with an explicit `Nat.card X = n`. -/
private theorem pow_mul_eq_one_of_isRegular_induction (n : ℕ) :
    ∀ (X : Type*) [Group X] [Finite X], Nat.card X = n → ∀ (p : ℕ), p.Prime →
      IsPGroup p X → Work.SmallRank.IsRegular p X →
      ∀ x y : X, x ^ p = 1 → y ^ p = 1 → (x * y) ^ p = 1 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro X _ _ hcard p hp hG hR x y hx hy
    set K : Subgroup X := Subgroup.closure ({x, y} : Set X) with hK
    by_cases hKtop : K = ⊤
    · -- `x` and `y` generate `X`
      have hgen : Subgroup.closure ({x, y} : Set X) = ⊤ := hKtop
      by_cases hab : IsMulCommutative X
      · -- abelian case
        have hcm : Commute x y := isMulCommutative_iff.mp hab x y
        rw [hcm.mul_pow, hx, hy, mul_one]
      · -- `X` is nonabelian: Huppert's argument
        -- `L`, the normal closure of `x`, is proper
        let L : Subgroup X := Subgroup.normalClosure ({x} : Set X)
        haveI hLn : L.Normal := Subgroup.normalClosure_normal
        have hxL : x ∈ L := Subgroup.subset_normalClosure (by simp)
        have hLlt : L < ⊤ := normalClosure_singleton_lt_top_of_not_isMulCommutative hp hG hab x
        -- `L` has exponent `p`
        have hLexp : ∀ z ∈ L, z ^ p = 1 := by
          change ∀ z ∈ Subgroup.closure (Group.conjugatesOfSet ({x} : Set X)), z ^ p = 1
          refine closure_pow_eq_one_of_pow_eq_one ?_ ?_
          · intro s hs
            rw [Group.mem_conjugatesOfSet_iff] at hs
            obtain ⟨a, ha, hc⟩ := hs
            obtain rfl : a = x := by simpa using ha
            obtain ⟨c, hc'⟩ := isConj_iff.mp hc
            rw [← hc', ← MulAut.conj_apply, ← map_pow, hx, map_one]
          · intro u hu v hv hu1 hv1
            have hlt : Nat.card ↥L < n := by
              have h1 := Subgroup.card_lt_of_lt hLlt
              rw [Subgroup.card_top, hcard] at h1
              exact h1
            have hu1' : (⟨u, hu⟩ : ↥L) ^ p = 1 := by
              apply Subtype.ext; simpa using hu1
            have hv1' : (⟨v, hv⟩ : ↥L) ^ p = 1 := by
              apply Subtype.ext; simpa using hv1
            have h := ih (Nat.card ↥L) hlt ↥L rfl p hp (hG.to_subgroup L)
              (isRegular_subgroup hR L) ⟨u, hu⟩ ⟨v, hv⟩ hu1' hv1'
            simpa using congrArg (fun z : ↥L => (z : X)) h
        -- `[x,y] ∈ L`
        have hcomm_mem : ⁅x, y⁆ ∈ L := by
          have h2 : MulAut.conj y (x⁻¹) ∈ L := hLn.conj_mem (x⁻¹) (L.inv_mem hxL) y
          have h3 : ⁅x, y⁆ = x * MulAut.conj y (x⁻¹) := by
            rw [commutatorElement_def, MulAut.conj_apply]; group
          rw [h3]
          exact L.mul_mem hxL h2
        -- `N`, the normal closure of `[x,y]`
        let N : Subgroup X := Subgroup.normalClosure ({⁅x, y⁆} : Set X)
        haveI hNn : N.Normal := Subgroup.normalClosure_normal
        haveI hX'n : (Work.SmallRank.commutator X).Normal := Subgroup.commutator_normal ⊤ ⊤
        have hNle : N ≤ Work.SmallRank.commutator X := by
          refine Subgroup.normalClosure_le_normal ?_
          intro z hz
          obtain rfl : z = ⁅x, y⁆ := by simpa using hz
          exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
        -- `X' ≤ N`, because in `X ⧸ N` the images of `x` and `y` commute
        have hX'le : Work.SmallRank.commutator X ≤ N := by
          refine commutator_le_of_mem hgen N ?_
          exact Subgroup.subset_normalClosure (by simp [commutatorElement_def])
        -- `X'` is a proper subgroup
        have hX'ne : Work.SmallRank.commutator X ≠ ⊤ := by
          intro htop
          exact zpowers_sup_commutator_ne_top hp hG hab x (by simp [htop])
        have hX'lt : Work.SmallRank.commutator X < ⊤ := lt_of_le_of_ne le_top hX'ne
        have hNlt : N < ⊤ := lt_of_le_of_lt hNle hX'lt
        -- `N` has exponent `p`
        have hNexp : ∀ z ∈ N, z ^ p = 1 := by
          change ∀ z ∈ Subgroup.closure (Group.conjugatesOfSet ({⁅x, y⁆} : Set X)), z ^ p = 1
          refine closure_pow_eq_one_of_pow_eq_one ?_ ?_
          · intro s hs
            rw [Group.mem_conjugatesOfSet_iff] at hs
            obtain ⟨a, ha, hc⟩ := hs
            obtain rfl : a = ⁅x, y⁆ := by simpa using ha
            obtain ⟨c, hc'⟩ := isConj_iff.mp hc
            rw [← hc']
            exact hLexp _ (hLn.conj_mem _ hcomm_mem c)
          · intro u hu v hv hu1 hv1
            have hlt : Nat.card ↥N < n := by
              have h1 := Subgroup.card_lt_of_lt hNlt
              rw [Subgroup.card_top, hcard] at h1
              exact h1
            have hu1' : (⟨u, hu⟩ : ↥N) ^ p = 1 := by
              apply Subtype.ext; simpa using hu1
            have hv1' : (⟨v, hv⟩ : ↥N) ^ p = 1 := by
              apply Subtype.ext; simpa using hv1
            have h := ih (Nat.card ↥N) hlt ↥N rfl p hp (hG.to_subgroup N)
              (isRegular_subgroup hR N) ⟨u, hu⟩ ⟨v, hv⟩ hu1' hv1'
            simpa using congrArg (fun z : ↥N => (z : X)) h
        have hX'exp : ∀ z ∈ Work.SmallRank.commutator X, z ^ p = 1 :=
          fun z hz => hNexp z (hX'le hz)
        -- regularity kills the defect `d ∈ ℧¹(⟨x,y⟩') = ℧¹(X') = 1`
        obtain ⟨d, hd, hdeq⟩ := hR x y
        rw [hgen] at hd
        have hagemo : Work.PGroup.agemo p 1 (⁅(⊤ : Subgroup X), ⊤⁆) = ⊥ :=
          agemo_eq_bot_of_pow hX'exp
        rw [hagemo] at hd
        have hd1 : d = 1 := Subgroup.mem_bot.mp hd
        rw [hx, hy, one_mul, hd1, mul_one] at hdeq
        exact hdeq.symm
    · -- pass to the proper subgroup generated by `x` and `y`
      have hxK : x ∈ K := Subgroup.subset_closure (by simp)
      have hyK : y ∈ K := Subgroup.subset_closure (by simp)
      have hlt : Nat.card ↥K < n := by
        have h1 := Subgroup.card_lt_of_lt (lt_of_le_of_ne le_top hKtop)
        rw [Subgroup.card_top, hcard] at h1
        exact h1
      have hx' : (⟨x, hxK⟩ : ↥K) ^ p = 1 := by apply Subtype.ext; simpa using hx
      have hy' : (⟨y, hyK⟩ : ↥K) ^ p = 1 := by apply Subtype.ext; simpa using hy
      have h := ih (Nat.card ↥K) hlt ↥K rfl p hp (hG.to_subgroup K) (isRegular_subgroup hR K)
        ⟨x, hxK⟩ ⟨y, hyK⟩ hx' hy'
      simpa using congrArg (fun z : ↥K => (z : X)) h

theorem pow_mul_eq_one_of_isRegular {p : ℕ} (hp : p.Prime) {G : Type*} [Group G] [Finite G]
    (hG : IsPGroup p G) (hR : Work.SmallRank.IsRegular p G) {x y : G} (hx : x ^ p = 1) (hy : y ^ p = 1) :
    (x * y) ^ p = 1 :=
  pow_mul_eq_one_of_isRegular_induction (Nat.card G) G rfl p hp hG hR x y hx hy

end Work.SmallRank.Regular
