import Mathlib
import Submission.Work.RankOneUniqueness.Basic

-- ftport:v435-opts-begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- ftport:v435-opts-end

/-!
# `Work.RankOneUniqueness.mulEquiv_of_permEquiv` — the permutation-group assembly

Let `Φ : G ⧸ H ≃ G' ⧸ H'` be a bijection which transports the action of the subgroup
`H ≤ G` to that of `H' ≤ G'` along `ψ : H ≃* H'`, and the action of `t` to that of `t'`.
If both actions on cosets are faithful and `G = ⟨H, t⟩`, `G' = ⟨H', t'⟩`, then `G ≃* G'`.

Proof: conjugating the permutation representation by `Φ` gives an isomorphism
`τ : Sym (G ⧸ H) ≃* Sym (G' ⧸ H')` under which the image of `G` (generated by `H` and `t`)
equals the image of `G'` (generated by `H'` and `t'`); both representations are faithful, so
`G ≅ im(G) = im(G') ≅ G'`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

open Submission.Blueprint

namespace Work.RankOneUniqueness

theorem mulEquiv_of_permEquiv {G G' : Type} [Group G] [Group G']
    {H : Subgroup G} {H' : Subgroup G'} {t : G} {t' : G'}
    (Φ : (G ⧸ H) ≃ (G' ⧸ H')) (ψ : H ≃* H')
    (hfaith : Work.RankOneUniqueness.FaithfulCosets H)
    (hfaith' : Work.RankOneUniqueness.FaithfulCosets H')
    (hgen : Subgroup.closure ((H : Set G) ∪ {t}) = ⊤)
    (hgen' : Subgroup.closure ((H' : Set G') ∪ {t'}) = ⊤)
    (hH : ∀ (a : H) (ω : G ⧸ H), Φ ((a : G) • ω) = (ψ a : G') • Φ ω)
    (ht : ∀ ω : G ⧸ H, Φ (t • ω) = t' • Φ ω) :
    Nonempty (G ≃* G') := by
  classical
  have hpc_one : Φ.permCongr 1 = 1 := Equiv.permCongr_refl Φ
  have hpc_mul : ∀ p q : Equiv.Perm (G ⧸ H),
      Φ.permCongr (p * q) = Φ.permCongr p * Φ.permCongr q :=
    fun p q => Equiv.permCongr_mul Φ p q
  have hpc_inv : ∀ p : Equiv.Perm (G ⧸ H), Φ.permCongr p⁻¹ = (Φ.permCongr p)⁻¹ := by
    intro p
    have h1 : Φ.permCongr p * Φ.permCongr p⁻¹ = 1 := by
      rw [← hpc_mul, mul_inv_cancel, hpc_one]
    exact eq_inv_of_mul_eq_one_right h1
  have hφinj : Function.Injective (MulAction.toPermHom G (G ⧸ H)) := by
    intro a b hab
    have h1 : ∀ ω : G ⧸ H, a • ω = b • ω := by
      intro ω
      have h2 := congrArg (fun (p : Equiv.Perm (G ⧸ H)) => p ω) hab
      simpa only [MulAction.toPermHom_apply, MulAction.toPerm_apply] using h2
    have h3 : b⁻¹ * a = 1 := by
      apply hfaith (b⁻¹ * a)
      intro ω
      rw [mul_smul, h1 ω, inv_smul_smul]
    exact (inv_mul_eq_one.mp h3).symm
  have hφ'inj : Function.Injective (MulAction.toPermHom G' (G' ⧸ H')) := by
    intro a b hab
    have h1 : ∀ ω : G' ⧸ H', a • ω = b • ω := by
      intro ω
      have h2 := congrArg (fun (p : Equiv.Perm (G' ⧸ H')) => p ω) hab
      simpa only [MulAction.toPermHom_apply, MulAction.toPerm_apply] using h2
    have h3 : b⁻¹ * a = 1 := by
      apply hfaith' (b⁻¹ * a)
      intro ω
      rw [mul_smul, h1 ω, inv_smul_smul]
    exact (inv_mul_eq_one.mp h3).symm
  have hgenH : ∀ a : H, Φ.permCongr (MulAction.toPermHom G (G ⧸ H) (a : G))
      = MulAction.toPermHom G' (G' ⧸ H') (ψ a) := by
    intro a
    ext ω
    simp only [Equiv.permCongr_apply, MulAction.toPermHom_apply, MulAction.toPerm_apply,
      hH a (Φ.symm ω), Equiv.apply_symm_apply]
  have hgent : Φ.permCongr (MulAction.toPermHom G (G ⧸ H) t)
      = MulAction.toPermHom G' (G' ⧸ H') t' := by
    ext ω
    simp only [Equiv.permCongr_apply, MulAction.toPermHom_apply, MulAction.toPerm_apply,
      ht (Φ.symm ω), Equiv.apply_symm_apply]
  have key : ∀ g : G, ∃ g' : G', MulAction.toPermHom G' (G' ⧸ H') g'
      = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g) := by
    have aux : ∀ g ∈ Subgroup.closure ((H : Set G) ∪ {t}),
        ∃ g' : G', MulAction.toPermHom G' (G' ⧸ H') g'
          = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g) := by
      intro g hg
      refine Subgroup.closure_induction
        (p := fun g _ => ∃ g' : G', MulAction.toPermHom G' (G' ⧸ H') g'
          = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g))
        (fun x hx => ?_) ?_ (fun x y _ _ ihx ihy => ?_) (fun x _ ihx => ?_) hg
      · rcases hx with hx | hxt
        · exact ⟨ψ ⟨x, hx⟩, by rw [← hgenH ⟨x, hx⟩]⟩
        · rw [Set.mem_singleton_iff] at hxt
          subst hxt
          exact ⟨t', by rw [← hgent]⟩
      · exact ⟨1, by rw [map_one (MulAction.toPermHom G' (G' ⧸ H')),
          map_one (MulAction.toPermHom G (G ⧸ H)), hpc_one]⟩
      · obtain ⟨x', hx'⟩ := ihx
        obtain ⟨y', hy'⟩ := ihy
        exact ⟨x' * y', by rw [map_mul (MulAction.toPermHom G' (G' ⧸ H')) x' y', hx', hy',
          map_mul (MulAction.toPermHom G (G ⧸ H)) x y, ← hpc_mul]⟩
      · obtain ⟨x', hx'⟩ := ihx
        exact ⟨x'⁻¹, by rw [map_inv (MulAction.toPermHom G' (G' ⧸ H')) x', hx',
          map_inv (MulAction.toPermHom G (G ⧸ H)) x, hpc_inv]⟩
    intro g
    exact aux g (by rw [hgen]; exact Subgroup.mem_top g)
  have key2 : ∀ g' : G', ∃ g : G, MulAction.toPermHom G' (G' ⧸ H') g'
      = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g) := by
    have aux : ∀ g' ∈ Subgroup.closure ((H' : Set G') ∪ {t'}),
        ∃ g : G, MulAction.toPermHom G' (G' ⧸ H') g'
          = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g) := by
      intro g' hg
      refine Subgroup.closure_induction
        (p := fun g _ => ∃ g₀ : G, MulAction.toPermHom G' (G' ⧸ H') g
          = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g₀))
        (fun x hx => ?_) ?_ (fun x y _ _ ihx ihy => ?_) (fun x _ ihx => ?_) hg
      · rcases hx with hx | hxt
        · refine ⟨ψ.symm ⟨x, hx⟩, ?_⟩
          have h2 := hgenH (ψ.symm ⟨x, hx⟩)
          rw [MulEquiv.apply_symm_apply] at h2
          exact h2.symm
        · rw [Set.mem_singleton_iff] at hxt
          subst hxt
          exact ⟨t, by rw [hgent]⟩
      · exact ⟨1, by rw [map_one (MulAction.toPermHom G' (G' ⧸ H')),
          map_one (MulAction.toPermHom G (G ⧸ H)), hpc_one]⟩
      · obtain ⟨x₀, hx₀⟩ := ihx
        obtain ⟨y₀, hy₀⟩ := ihy
        exact ⟨x₀ * y₀, by rw [map_mul (MulAction.toPermHom G' (G' ⧸ H')) x y, hx₀, hy₀,
          map_mul (MulAction.toPermHom G (G ⧸ H)) x₀ y₀, ← hpc_mul]⟩
      · obtain ⟨x₀, hx₀⟩ := ihx
        exact ⟨x₀⁻¹, by rw [map_inv (MulAction.toPermHom G' (G' ⧸ H')) x, hx₀,
          map_inv (MulAction.toPermHom G (G ⧸ H)) x₀, hpc_inv]⟩
    intro g'
    exact aux g' (by rw [hgen']; exact Subgroup.mem_top g')
  let σfun : G → G' := fun g => Classical.choose (key g)
  have hσspec : ∀ g : G, MulAction.toPermHom G' (G' ⧸ H') (σfun g)
      = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g) := fun g => Classical.choose_spec (key g)
  have hσone : σfun 1 = 1 := by
    apply hφ'inj
    rw [hσspec 1, map_one (MulAction.toPermHom G (G ⧸ H)), hpc_one,
      map_one (MulAction.toPermHom G' (G' ⧸ H'))]
  have hσmul : ∀ a b : G, σfun (a * b) = σfun a * σfun b := by
    intro a b
    apply hφ'inj
    rw [hσspec (a * b), map_mul (MulAction.toPermHom G (G ⧸ H)) a b, hpc_mul, ← hσspec a,
      ← hσspec b, ← map_mul (MulAction.toPermHom G' (G' ⧸ H')) (σfun a) (σfun b)]
  let σ : G →* G' := { toFun := σfun, map_one' := hσone, map_mul' := hσmul }
  have hσspec' : ∀ g : G, MulAction.toPermHom G' (G' ⧸ H') (σ g)
      = Φ.permCongr (MulAction.toPermHom G (G ⧸ H) g) := hσspec
  have hinj : Function.Injective σ := by
    intro a b hab
    apply hφinj
    apply Φ.permCongr.injective
    rw [← hσspec' a, ← hσspec' b, hab]
  have hsurj : Function.Surjective σ := by
    intro g'
    obtain ⟨g, hg⟩ := key2 g'
    exact ⟨g, hφ'inj (by rw [hσspec' g, hg])⟩
  exact ⟨MulEquiv.ofBijective σ ⟨hinj, hsurj⟩⟩

end Work.RankOneUniqueness
