/-!
# Bender–Suzuki blueprint: objects and one `Prop` per area

Route: Peterfalvi, *Le théorème de Bender–Suzuki I, II*, Astérisque 142–143 (1986)
(transcribed in `REFS/peterfalvi_*.md`), with the black boxes it quotes
(Brauer–Suzuki, Glauberman ZJ, Thompson, Higman, Hering, Feit–Sibley, Zassenhaus groups)
made into areas of their own.

Conventions.
* Everything is stated for groups in `Type` (universe 0). The challenge is universe
  polymorphic; area `Endgame` transfers it down to `Type` (every finite group is
  isomorphic to one on `Fin n`).
* Conjugation is the challenge's: `conj g H = g H g⁻¹ = H.map (MulAut.conj g).toMonoidHom`.
* `FeitThompsonProp` is a hypothesis everywhere; every area may assume it and any other
  area's `Prop`, as long as the dependency graph in `AREAS.md` stays acyclic.
* Peterfalvi's notation: `Ω` = conjugates of a strongly embedded `H` (= `G ⧸ H`);
  for an involution `t ∉ H`: `D = H ∩ H^t` (two-point stabiliser), `V = C_D(t)`,
  `K = J(D,t) = {x ∈ D | x^t = x⁻¹}`, `W = C_V(K)`.
-/

set_option autoImplicit false

open LeanEval.GroupTheory.Defs

namespace Submission.Blueprint

/-! ## 0. The Feit–Thompson hypothesis (wired later from our own FT proof) -/

/-- The odd order theorem, in the eval's form, for groups in `Type`. -/
def FeitThompsonProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Odd (Nat.card G) → Group.IsSolvable G

/-! ## 1. Vocabulary -/

section Vocabulary

variable {G : Type*} [Group G]

/-- `g H g⁻¹`, the conjugate used by `IsStronglyEmbedded`. -/
abbrev conj (g : G) (H : Subgroup G) : Subgroup G := H.map (MulAut.conj g).toMonoidHom

/-- The involutions lying in a subset. -/
def involutions (S : Set G) : Set G := {x | x ∈ S ∧ orderOf x = 2}

/-- `G` has 2-rank at least 2: it contains a four-group (two distinct commuting
involutions). -/
def HasFourGroup (G : Type*) [Group G] : Prop :=
  ∃ a b : G, orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a

/-- `O(G) = O_{2'}(G)`: the largest normal subgroup of odd order. -/
def oddCore (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ Odd (Nat.card N)}

/-- `O_{p'}(G)`: the largest normal subgroup of order prime to `p`. -/
def pPrimeCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ Nat.Coprime (Nat.card N) p}

/-- `O^{2'}(G)`: the smallest normal subgroup of odd index. -/
def oddResidual (G : Type*) [Group G] : Subgroup G :=
  sInf {N : Subgroup G | N.Normal ∧ Odd N.index}

/-- A subgroup is abelian (elementwise form, avoids instance plumbing). -/
def IsAbelianSubgroup (A : Subgroup G) : Prop := ∀ x ∈ A, ∀ y ∈ A, x * y = y * x

/-- Thompson's subgroup `J(P)`: generated by the abelian subgroups of `P` of maximal order. -/
def thompsonJ (P : Subgroup G) : Subgroup G :=
  ⨆ (A : Subgroup G) (_ : A ≤ P ∧ IsAbelianSubgroup A ∧
      ∀ B : Subgroup G, B ≤ P → IsAbelianSubgroup B → Nat.card B ≤ Nat.card A), A

/-- `Z(J(P))`, as a subgroup of the ambient group. -/
def ZJ (P : Subgroup G) : Subgroup G :=
  thompsonJ P ⊓ Subgroup.centralizer (thompsonJ P : Set G)

/-- `J(X,t) = {x ∈ X | t x t⁻¹ = x⁻¹}` (Peterfalvi's notation). -/
def invertedBy (X : Subgroup G) (t : G) : Set G := {x | x ∈ X ∧ t * x * t⁻¹ = x⁻¹}

/-- The two-point stabiliser `D = H ∩ H^t`. -/
abbrev twoPoint (H : Subgroup G) (t : G) : Subgroup G := H ⊓ conj t H

/-- `G` acts doubly transitively on the cosets of `H` (= on the conjugates of `H`, since a
strongly embedded subgroup is self-normalising). -/
def IsTwoTransitiveOn (H : Subgroup G) : Prop :=
  MulAction.IsMultiplyPretransitive G (G ⧸ H) 2

end Vocabulary

/-! ## 1b. Character vocabulary (from the delivered FT areas) -/

section Characters

open Classical

variable {G : Type} [Group G] [Fintype G]

/-- `Ind_H^G` as a `ℤ`-linear map on class functions (`Work.Induction.indFun`). -/
noncomputable def indLinear (H : Subgroup G) : (H → ℂ) →ₗ[ℤ] (G → ℂ) where
  toFun := Work.Induction.indFun H
  map_add' := Work.Induction.indFun_add H
  map_smul' := fun n φ => by
    simp only [RingHom.id_apply]
    rw [← Int.cast_smul_eq_zsmul ℂ n φ, Work.Induction.indFun_smul, Int.cast_smul_eq_zsmul]

/-- `{χ ∈ Irr H | Q₁ ⊄ ker χ}` (Peterfalvi II App. XII's `𝒮`). -/
noncomputable def excludingKernel (H Q₁ : Subgroup G) : Finset (H → ℂ) :=
  (Work.CharCore.Irr H).filter (fun χ => ∃ x : H, (x : G) ∈ Q₁ ∧ χ x ≠ χ 1)

end Characters

/-! ## 2. Theorem B (Peterfalvi I, p.163) and the induction -/

/-- Hypothesis (B0) of Theorem B: 2-rank `≥ 2` and a proper strongly embedded subgroup. -/
def BenderHyp (G : Type) [Group G] : Prop :=
  HasFourGroup G ∧ ∃ H : Subgroup G, IsStronglyEmbedded H

/-- Conclusion of Theorem B: some `L` with `O(G) ≤ L ⊴ G`, `|G : L|` odd and `L / O(G)`
one of `PSL(2,2ⁿ)`, `Sz(2^{2n+1})`, `PSU(3,2ⁿ)` (the challenge's literal models).
(Peterfalvi's "unique class of Bender subgroups" is Corollary 2 of Theorem A and is not
repeated here.) -/
def BenderConclusion (G : Type) [Group G] : Prop :=
  ∃ L : Subgroup G, L.Normal ∧ oddCore G ≤ L ∧ Odd L.index ∧
    ∃ (Y : Type) (_ : Group Y) (φ : L →* Y), Function.Surjective φ ∧
      φ.ker = (oddCore G).subgroupOf L ∧ IsSimpleBenderGroup Y

/-- Theorem B for all groups. -/
def TheoremB : Prop :=
  ∀ (G : Type) [Group G] [Finite G], BenderHyp G → BenderConclusion G

/-- Induction hypothesis (B1) for a group of order `n`. -/
def ThmBBelow (n : ℕ) : Prop :=
  ∀ (F : Type) [Group F] [Finite F], Nat.card F < n → BenderHyp F → BenderConclusion F

/-- The situation (B0) + (B1) + (B2) of Peterfalvi I Ch. II §4 – Ch. VII. -/
def Situation (G : Type) [Group G] [Finite G] : Prop :=
  BenderHyp G ∧ ThmBBelow (Nat.card G) ∧ oddCore G = ⊥

/-! ## 3. The area `Prop`s -/

/-! ### Black boxes quoted by Peterfalvi -/

/-- **Area `BrauerSuzuki`.** A finite group of 2-rank `≤ 1`: for every involution `t`,
`G = O(G) C_G(t)` (Peterfalvi I p.145).  Route: Sylow 2-subgroup cyclic (Burnside) or
generalised quaternion (Dade 1971 §6 for `|S| ≥ 16`, Glauberman 1974 for `Q₈`). -/
def BrauerSuzukiProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], ¬ HasFourGroup G →
    ∀ t : G, orderOf t = 2 → oddCore G ⊔ Subgroup.centralizer {t} = ⊤

/-- **Area `GlaubermanZJ`.** Glauberman's ZJ theorem (Canad. J. Math. 20 (1968), Thm A) in the
form Peterfalvi uses it (I p.145): for an odd prime `p`, a solvable group `G` with no section
`≅ SL(2,p)` and a Sylow `p`-subgroup `P`, `O_{p'}(G) Z(J(P))` is characteristic in `G`.
"No `SL(2,p)` section" is replaced by the sufficient condition used in both applications
(I Ch. I §6 Prop. 1: `D` of odd order; Ch. II §2 Lemma 3: `ED`): the Sylow 2-subgroups of `G`
are abelian (those of `SL(2,p)` are generalised quaternion). -/
def GlaubermanZJProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ), p.Prime → p ≠ 2 → Group.IsSolvable G →
    (∀ S : Sylow 2 G, IsAbelianSubgroup (S : Subgroup G)) →
    ∀ P : Sylow p G, (pPrimeCore p G ⊔ ZJ (P : Subgroup G)).Characteristic

/-- **Area `ThompsonFrobenius`.** Thompson's theorem: a finite group with a fixed-point-free
automorphism of prime order is nilpotent. -/
def ThompsonFrobeniusProp : Prop :=
  ∀ (Q : Type) [Group Q] [Finite Q] (α : MulAut Q), (orderOf α).Prime →
    (∀ x : Q, α x = x → x = 1) → Group.IsNilpotent Q

/-- **Area `Hering`.** (Peterfalvi I Ch. IV, Théorème E, p.188.) A finite group of even order
acting by conjugation doubly transitively on its involutions has 2-rank 1. -/
def HeringProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Even (Nat.card G) →
    (∀ a b c d : G, orderOf a = 2 → orderOf b = 2 → orderOf c = 2 → orderOf d = 2 →
      a ≠ b → c ≠ d → ∃ g : G, g * a * g⁻¹ = c ∧ g * b * g⁻¹ = d) →
    ¬ HasFourGroup G

/-- A Suzuki 2-group in Higman's sense: a non-abelian 2-group with more than one involution
admitting a cyclic group of automorphisms transitive on its involutions. -/
def IsSuzukiTwoGroup (P : Type) [Group P] [Finite P] : Prop :=
  IsPGroup 2 P ∧ (∃ x y : P, x * y ≠ y * x) ∧
    (∃ x y : P, orderOf x = 2 ∧ orderOf y = 2 ∧ x ≠ y) ∧
    ∃ ξ : MulAut P, ∀ x y : P, orderOf x = 2 → orderOf y = 2 → ∃ k : ℕ, (ξ ^ k) x = y

/-- **Area `Higman`.** (Higman 1963, the consequences read off his list; REFS/higman_*.)
For a Suzuki 2-group `P` with `q = |Z(P)|`: `Z(P) = Ω₁(P) = P'` consists of `1` and the
involutions, `P/Z(P)` is elementary abelian (`x² ∈ Z(P)`), and `|P| ∈ {q², q³}`;
if `|P| = q²` then `q = 2ⁿ` and `P ≅ A(n,θ)`: there is a bijection `e : P ≃ F × F`,
`F = GF(2ⁿ)`, and a field automorphism `θ ≠ 1` of odd order with
`e (x*y) = (a + c, b + d + a * θ c)` for `e x = (a,b)`, `e y = (c,d)`. -/
def HigmanProp : Prop :=
  ∀ (P : Type) [Group P] [Finite P], IsSuzukiTwoGroup P →
    (∀ z : P, z ∈ Subgroup.center P ↔ z ^ 2 = 1) ∧
    (∀ x : P, x ^ 2 ∈ Subgroup.center P) ∧
    commutator P = Subgroup.center P ∧
    (Nat.card P = Nat.card (Subgroup.center P) ^ 2 ∨
      Nat.card P = Nat.card (Subgroup.center P) ^ 3) ∧
    (Nat.card P = Nat.card (Subgroup.center P) ^ 2 →
      ∃ (n : ℕ) (e : P ≃ GaloisField 2 n × GaloisField 2 n)
        (θ : GaloisField 2 n ≃+* GaloisField 2 n),
        Nat.card (Subgroup.center P) = 2 ^ n ∧ θ ≠ RingEquiv.refl _ ∧ Odd (orderOf θ) ∧
        ∀ x y : P, e (x * y) = ((e x).1 + (e y).1, (e x).2 + (e y).2 + (e x).1 * θ (e y).1))


open Classical in
/-- **Area `FeitSibley`.** (Peterfalvi II App. XII, Théorème p.289.) `H = Q ⋊ D < G` with
`(|D|,|Q|) = 1` and `Q ∩ Q^x = 1` for `x ∉ H`; `Q = S × Q₁` with `(|S|,|Q₁|) = 1`, `S` nilpotent,
`D` fixed-point-free on `Q₁`, `Q₁` not a 2-group, `|D|` odd. Then
`𝒮 = {χ ∈ Irr H | Q₁ ⊄ ker χ}` has at least two members and is coherent for `Ind_H^G`.
Vocabulary: the delivered FT areas `Work.CharCore` (`Irr` as a `Finset`), `Work.Induction`
(`indFun`) and `Work.Coherence` (`Coherent`, Peterfalvi's/FT's Definition 10.1). -/
def FeitSibleyProp : Prop :=
  ∀ (G : Type) [Group G] [Fintype G] (H Q D S Q₁ : Subgroup G),
    H ≠ ⊤ → Q ≤ H → H ≤ Subgroup.normalizer (Q : Set G) → D ≤ H →
    Q ⊓ D = ⊥ → Q ⊔ D = H → Nat.Coprime (Nat.card D) (Nat.card Q) →
    (∀ x : G, x ∉ H → Q ⊓ conj x Q = ⊥) →
    S ⊔ Q₁ = Q → S ⊓ Q₁ = ⊥ → (∀ a ∈ S, ∀ b ∈ Q₁, a * b = b * a) →
    Nat.Coprime (Nat.card S) (Nat.card Q₁) → Group.IsNilpotent S →
    (∀ d ∈ D, d ≠ 1 → ∀ x ∈ Q₁, d * x * d⁻¹ = x → x = 1) →
    ¬ IsPGroup 2 Q₁ → Odd (Nat.card D) →
    2 ≤ (excludingKernel H Q₁).card ∧ Work.Coherence.Coherent (excludingKernel H Q₁) (indLinear H)

/-! ### Rank-one machinery shared by the recognition areas -/

section RankOne

variable {G : Type*} [Group G]

/-- Peterfalvi's set-up after Theorems A and D (II, Ch. VII §1: "a split BN-pair of rank 1"):
`H` strongly embedded, `G` 2-transitive on `G ⧸ H`, `t` an involution outside `H`,
`H = Q ⋊ D` with `Q ⊴ H` (regular on the other points) and `D = H ∩ H^t`. -/
structure IsSplitRankOne (H Q : Subgroup G) (t : G) : Prop where
  stronglyEmbedded : IsStronglyEmbedded H
  twoTransitive : IsTwoTransitiveOn H
  invol : orderOf t = 2
  not_mem : t ∉ H
  le : Q ≤ H
  normal : H ≤ Subgroup.normalizer (Q : Set G)
  inf_eq : Q ⊓ twoPoint H t = ⊥
  sup_eq : Q ⊔ twoPoint H t = H

/-- `V = C_D(t)`. -/
abbrev centD (H : Subgroup G) (t : G) : Subgroup G := twoPoint H t ⊓ Subgroup.centralizer {t}

/-- Points of `Ω = G ⧸ H` fixed by `X`. -/
def fixedPts (H X : Subgroup G) : Set (G ⧸ H) := {ω | ∀ x ∈ X, x • ω = ω}

/-- `G` is a Zassenhaus group on `G ⧸ H`: the pointwise stabiliser of 3 points is trivial
(Peterfalvi II p.236: equivalent to `V = 1`). -/
def IsZassenhaus (H : Subgroup G) : Prop :=
  ∀ (a b c : G ⧸ H), a ≠ b → a ≠ c → b ≠ c →
    ∀ g : G, g • a = a → g • b = b → g • c = c → g = 1

end RankOne

/-- **Area `RankOneUniqueness`.** (Peterfalvi II Ch. VII §1, Lemma p.268.) A faithful split
rank-one group is determined by `H = Q ⋊ D` and the map `f : Q# → Q#` defined by
`t x t ∈ H t f(x)`: an isomorphism `ψ : H ≅ H'` carrying `Q` to `Q'`, `D` to `D'` and `f` to
`f'` extends to `G ≅ G'`. -/
def RankOneUniquenessProp : Prop :=
  ∀ (G G' : Type) [Group G] [Finite G] [Group G'] [Finite G']
    (H Q : Subgroup G) (t : G) (H' Q' : Subgroup G') (t' : G'),
    IsSplitRankOne H Q t → IsSplitRankOne H' Q' t' →
    (∀ g : G, (∀ ω : G ⧸ H, g • ω = ω) → g = 1) →
    (∀ g : G', (∀ ω : G' ⧸ H', g • ω = ω) → g = 1) →
    ∀ ψ : H ≃* H',
      (∀ x : H, (x : G) ∈ Q ↔ (ψ x : G') ∈ Q') →
      (∀ x : H, (x : G) ∈ twoPoint H t ↔ (ψ x : G') ∈ twoPoint H' t') →
      (∀ x y : H, (x : G) ∈ Q → (y : G) ∈ Q → (x : G) ≠ 1 →
        (∃ m ∈ H, t * x * t = m * t * y) → ∃ m' ∈ H', t' * ψ x * t' = m' * t' * ψ y) →
      Nonempty (G ≃* G')

/-- **Area `Models`.** Facts about the three families (port of the fm1 model library, v4.33 →
v4.34, `fundmath1-runs/bender_suzuki/Submission/{PSL2*,Sz,PSU3,Bender*,...}`): each is simple of
2-rank `≥ 2` with a strongly embedded subgroup; in every strongly embedded `H` the involutions
commute; for every involution `t ∉ H`, `H = S ⋊ D` with `S` a normal 2-subgroup, `D = H ∩ H^t`,
and `K = J(D,t)` is a cyclic subgroup with `|K| = |Inv(H)|` (`= q - 1`).
(Used for (B1-a) and Ch. II §4 Prop. 3 (b)-(d), and by `Endgame`.) -/
def ModelFactsProp : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y], IsSimpleBenderGroup Y →
    IsSimpleGroup Y ∧ HasFourGroup Y ∧ (∃ H : Subgroup Y, IsStronglyEmbedded H) ∧
    ∀ H : Subgroup Y, IsStronglyEmbedded H →
      (∀ a ∈ involutions (H : Set Y), ∀ b ∈ involutions (H : Set Y), a * b = b * a) ∧
      ∀ t : Y, orderOf t = 2 → t ∉ H →
        ∃ S K : Subgroup Y, IsPGroup 2 S ∧ S ≤ H ∧ H ≤ Subgroup.normalizer (S : Set Y) ∧
          S ⊓ twoPoint H t = ⊥ ∧ S ⊔ twoPoint H t = H ∧
          (K : Set Y) = invertedBy (twoPoint H t) t ∧ IsCyclic K ∧
          Nat.card K = (involutions (H : Set Y)).ncard

/-! ### Bender's part (Peterfalvi I, Ch. I–III) -/

/-- **Area `DoubleTransitivity`.** Théorème A (Peterfalvi I Ch. I, p.157): if `G` has 2-rank
`≥ 2`, `G` is doubly transitive on the conjugates of a strongly embedded subgroup. -/
def ThmAProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], HasFourGroup G →
    ∀ H : Subgroup G, IsStronglyEmbedded H → IsTwoTransitiveOn H

/-- **Area `Reductions`.** The elementary reductions of Theorem B (I Ch. II §4 p.168,
II Ch. VI §3 p.264, I Ch. I §6 Cor. 3 p.162):
(1) if `O(G) ≠ 1` or `O^{2'}(G) ≠ G`, Theorem B for `G` follows from (B1);
(2) if `O(G) = 1` and `O^{2'}(G) = G` then `G` is simple, and
(3) then a model structure on `G` itself gives the conclusion. -/
def ReductionsProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], BenderHyp G → ThmBBelow (Nat.card G) →
    ((oddCore G ≠ ⊥ ∨ oddResidual G ≠ ⊤) → BenderConclusion G) ∧
    (oddCore G = ⊥ → oddResidual G = ⊤ →
      IsSimpleGroup G ∧ (IsSimpleBenderGroup G → BenderConclusion G))

/-- **Area `ThreePoints`, part 1.** Théorème C (Peterfalvi I Ch. II, p.163): under (B0)–(B2),
a subgroup of a two-point stabiliser normalised by an involution `u ∈ H` is centralised by `u`. -/
def ThmCProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G →
    ∀ H : Subgroup G, IsStronglyEmbedded H → ∀ g : G, g ∉ H →
      ∀ u ∈ involutions (H : Set G), ∀ X : Subgroup G, X ≤ H ⊓ conj g H →
        u ∈ Subgroup.normalizer (X : Set G) → ∀ x ∈ X, u * x = x * u

/-- **Area `ThreePoints`, part 2.** Peterfalvi I Ch. II §4, Props 1(b), 2, 3, 4 under
(B0)–(B2), for `H` strongly embedded and an involution `t ∉ H`, `D = H ∩ H^t`, `V = C_D(t)`,
`K = J(D,t)`:
* P1(b): if `X` fixes `≥ 3` points and `Inv C_G(X) ⊆ F ⊆ N_G(X)`, then `F ∩ M` is strongly
  embedded in `F` for every fixed point `M = H^g ⊇ X`;
* P2: (a) `V = C_D(u)` for some `u ∈ Inv(H)`; (c) `x ∈ K#` fixes exactly 2 points;
* P3 (with `Y = X`): if `X ≤ V` and `N_K(X) ≠ 1`, `F = O^{2'}(C_G(X))`: `N_G(X) = F N_V(X)`,
  `N_H(X) = S ⋊ N_D(X)` with `S` a Sylow 2-subgroup of `F ∩ H`, `O(F) = Z(F)` and `F / Z(F)`
  is a simple Bender group, and `N_K(X) = C_K(X)` is a cyclic subgroup;
* P4: `C_V(K) = C_D(Inv H)`, and if `C_V(K) ≠ 1` then `H = C_H(Inv H) D`. -/
def ChIIFourProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G →
    ∀ H : Subgroup G, IsStronglyEmbedded H → ∀ t : G, orderOf t = 2 → t ∉ H →
    -- Prop. 1 (b)
    (∀ X F : Subgroup G, 3 ≤ (fixedPts H X).ncard →
        involutions (Subgroup.centralizer (X : Set G) : Set G) ⊆ F →
        F ≤ Subgroup.normalizer (X : Set G) →
        ∀ g : G, X ≤ conj g H → IsStronglyEmbedded ((F ⊓ conj g H).subgroupOf F)) ∧
    -- Prop. 2 (a), (c)
    (∃ u ∈ involutions (H : Set G),
        centD H t = twoPoint H t ⊓ Subgroup.centralizer {u}) ∧
    (∀ x ∈ invertedBy (twoPoint H t) t, x ≠ 1 →
        (fixedPts H (Subgroup.zpowers x)).ncard = 2) ∧
    -- Prop. 3 (case `Y = X`; `X ≠ ⊥` — at `X = ⊥` the clause is the main theorem itself, circular;
    -- Peterfalvi only uses `X ≠ 1`, see Work/ThreePoints/NOTES_LEAD_bs_p3_induction.md)
    (∀ X : Subgroup G, X ≠ ⊥ → X ≤ centD H t →
      (∃ k ∈ invertedBy (twoPoint H t) t, k ≠ 1 ∧ k ∈ Subgroup.normalizer (X : Set G)) →
      let C := Subgroup.centralizer (X : Set G)
      let F := (oddResidual C).map C.subtype
      Subgroup.normalizer (X : Set G) = F ⊔ (centD H t ⊓ Subgroup.normalizer (X : Set G)) ∧
      (∃ S : Subgroup G, IsPGroup 2 S ∧ S ≤ F ⊓ H ∧ ¬ 2 ∣ (S.subgroupOf (F ⊓ H)).index ∧
        H ⊓ Subgroup.normalizer (X : Set G) ≤ Subgroup.normalizer (S : Set G) ∧
        S ⊓ twoPoint H t = ⊥ ∧
        S ⊔ (twoPoint H t ⊓ Subgroup.normalizer (X : Set G)) = H ⊓ Subgroup.normalizer (X : Set G)) ∧
      (oddCore F = Subgroup.center F ∧
        ∃ (Y : Type) (_ : Group Y) (φ : F →* Y), Function.Surjective φ ∧
          φ.ker = Subgroup.center F ∧ IsSimpleBenderGroup Y) ∧
      (∃ N : Subgroup G, (N : Set G) =
          invertedBy (twoPoint H t) t ∩ (Subgroup.normalizer (X : Set G) : Set G) ∧
        N ≤ Subgroup.centralizer (X : Set G) ∧ IsCyclic N)) ∧
    -- Prop. 4
    (centD H t ⊓ Subgroup.centralizer (invertedBy (twoPoint H t) t) =
        twoPoint H t ⊓ Subgroup.centralizer (involutions (H : Set G))) ∧
    (centD H t ⊓ Subgroup.centralizer (invertedBy (twoPoint H t) t) ≠ ⊥ →
        (H ⊓ Subgroup.centralizer (involutions (H : Set G))) ⊔ twoPoint H t = H)

/-- `Y` is subnormal in `X`: a finite chain `Y = X₀ ≤ X₁ ≤ … ≤ Xₙ = X`, each normal in the next. -/
def IsSubnormalIn {G : Type*} [Group G] (Y X : Subgroup G) : Prop :=
  Relation.ReflTransGen (fun A B : Subgroup G => A ≤ B ∧ (A.subgroupOf B).Normal) Y X

/-- **Area `ThreePoints`, Ch. II §4 Prop. 3 (a),(b) with a SUBNORMAL `Y`** (Peterfalvi I p.169–171;
added by the lead 2026-10-03: area `NormalComplement` uses it in §2 case 2, §4 Prop. 1, §5 Lemma 1
and §5 Prop. 2(a); see `Work/NormalComplement/NOTES_LEAD_bs_normalcomplement.md`).  `X ≤ V`,
`Y ≠ 1` subnormal in `X` with `N_K(Y) ≠ 1`; `F = O^{2'}(C_G(X))`; then `N_G(X) = F·N_V(X)` and
`N_H(X) = S ⋊ N_D(X)` with `S` a Sylow 2-subgroup of `F ∩ H`.  (The `Y = X` case with (c),(d) is
the P3 clause of `ChIIFourProp`.) -/
def ChIIFourP3SubnormalProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G →
    ∀ H : Subgroup G, IsStronglyEmbedded H → ∀ t : G, orderOf t = 2 → t ∉ H →
    ∀ X Y : Subgroup G, X ≤ centD H t → Y ≠ ⊥ → IsSubnormalIn Y X →
      (∃ k ∈ invertedBy (twoPoint H t) t, k ≠ 1 ∧ k ∈ Subgroup.normalizer (Y : Set G)) →
      let C := Subgroup.centralizer (X : Set G)
      let F := (oddResidual C).map C.subtype
      Subgroup.normalizer (X : Set G) = F ⊔ (centD H t ⊓ Subgroup.normalizer (X : Set G)) ∧
      (∃ S : Subgroup G, IsPGroup 2 S ∧ S ≤ F ⊓ H ∧ ¬ 2 ∣ (S.subgroupOf (F ⊓ H)).index ∧
        H ⊓ Subgroup.normalizer (X : Set G) ≤ Subgroup.normalizer (S : Set G) ∧
        S ⊓ twoPoint H t = ⊥ ∧
        S ⊔ (twoPoint H t ⊓ Subgroup.normalizer (X : Set G)) = H ⊓ Subgroup.normalizer (X : Set G))

/-- **Area `Models`, new clause** (Peterfalvi I p.184, facts 1°, 2°; added by the lead 2026-10-03
for `NormalComplement` §5 Prop. 2): for a simple Bender group `Y` and a strongly embedded `H`,
(1°) every 2-element of `H` has order dividing 4; (2°) if `Y` is a Zassenhaus group on `Y ⧸ H`,
`u ∈ Inv H`, `t ∈ Inv Y ∖ H`, then `C_Y(ut)` is cyclic, inverted by `u`, and has order `≥ 6` once
`|Inv H| ≥ 127`. -/
def BenderModelFacts2Prop : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y], IsSimpleBenderGroup Y →
    ∀ H : Subgroup Y, IsStronglyEmbedded H →
      (∀ x ∈ H, (∃ k : ℕ, orderOf x = 2 ^ k) → x ^ 4 = 1) ∧
      (IsZassenhaus H → ∀ u ∈ involutions (H : Set Y), ∀ t : Y, orderOf t = 2 → t ∉ H →
        IsCyclic ↥(Subgroup.centralizer ({u * t} : Set Y)) ∧
        (∀ y ∈ Subgroup.centralizer ({u * t} : Set Y), u * y * u⁻¹ = y⁻¹) ∧
        (127 ≤ (involutions (H : Set Y)).ncard →
          6 ≤ Nat.card ↥(Subgroup.centralizer ({u * t} : Set Y))))

/-- **Area `NormalComplement`.** Théorème D (Peterfalvi I Ch. III, p.172): under (B0)–(B2),
`D = H ∩ H^t` has a normal complement `Q` in `H`. Stated with the involution `t` existentially
(any `t ∉ H` works; all are `H`-conjugate) so that the assembly gets `t` for free. -/
def ThmDProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G →
    ∀ H : Subgroup G, IsStronglyEmbedded H →
      ∃ t : G, orderOf t = 2 ∧ t ∉ H ∧
        ∃ Q : Subgroup G, Q ≤ H ∧ H ≤ Subgroup.normalizer (Q : Set G) ∧
          Q ⊓ twoPoint H t = ⊥ ∧ Q ⊔ twoPoint H t = H

/-! ### Suzuki's part (Peterfalvi II) and the Zassenhaus groups -/

/-- **Area `ZassenhausTwoGroup`.** (Feit 1960, Thm 1, via `FeitSibleyProp`; HB XI §6.) In a
simple Zassenhaus group with split rank-one data, the regular normal subgroup `Q` is a 2-group. -/
def ZassenhausTwoGroupProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G →
    ∀ (H Q : Subgroup G) (t : G), IsSplitRankOne H Q t → IsZassenhaus H → IsPGroup 2 Q

/-- **Area `ZassenhausPSL2`.** (Zassenhaus 1936 / HB XI §10 / Baumeister–Grüninger Thm 1.)
Abelian `Q`: `G ≅ PSL(2,2ⁿ)`. -/
def ZassenhausPSL2Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G →
    ∀ (H Q : Subgroup G) (t : G), IsSplitRankOne H Q t → IsZassenhaus H →
      IsPGroup 2 Q → IsAbelianSubgroup Q →
      ∃ n : ℕ, 2 ≤ n ∧ Nonempty (G ≃* PSL2Model n)

/-- **Area `ZassenhausSuzuki`.** (Suzuki 1962 / HB XI §11 / Baumeister–Grüninger §5.)
Non-abelian `Q`: `G ≅ Sz(2^{2n+1})`. -/
def ZassenhausSzProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G →
    ∀ (H Q : Subgroup G) (t : G), IsSplitRankOne H Q t → IsZassenhaus H →
      IsPGroup 2 Q → ¬ IsAbelianSubgroup Q →
      ∃ n : ℕ, 1 ≤ n ∧ Nonempty (G ≃* SzModel n)

/-- **Area `ThmF`.** (Peterfalvi II Ch. V, Théorème F, p.247, with App. X, XI.) In a simple
group in situation (B0)–(B2), no subgroup `P ≤ V` of prime order has `C_G(P)` of 2-rank 1
(otherwise `G` has a quotient of order `p`). -/
def ThmFProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G → IsSimpleGroup G →
    ∀ (H Q : Subgroup G) (t : G), IsSplitRankOne H Q t →
      ∀ P : Subgroup G, P ≤ centD H t → (Nat.card P).Prime →
        HasFourGroup (Subgroup.centralizer (P : Set G))

/-- **Area `ThmG`.** (Peterfalvi II Ch. VI §1, Théorème G, p.257.) Under (B0)–(B3) (`V ≠ 1`,
centralisers of prime-order subgroups of `V` of 2-rank `≥ 2`), `Q` is a 2-group. -/
def ThmGProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G → IsSimpleGroup G →
    ∀ (H Q : Subgroup G) (t : G), IsSplitRankOne H Q t → ¬ IsZassenhaus H →
      (∀ P : Subgroup G, P ≤ centD H t → (Nat.card P).Prime →
        HasFourGroup (Subgroup.centralizer (P : Set G))) →
      IsPGroup 2 Q

/-- **Area `PSU3`.** (Peterfalvi II Ch. VI §1 Prop.–§3, Ch. VII, App. V, VIII; Kantor–Seitz.)
Under (B0)–(B3) with `Q` a 2-group and `G` simple, `G ≅ PSU(3,2ⁿ)`. -/
def PSU3Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Situation G → IsSimpleGroup G →
    ∀ (H Q : Subgroup G) (t : G), IsSplitRankOne H Q t → ¬ IsZassenhaus H →
      (∀ P : Subgroup G, P ≤ centD H t → (Nat.card P).Prime →
        HasFourGroup (Subgroup.centralizer (P : Set G))) →
      IsPGroup 2 Q →
      ∃ n : ℕ, 2 ≤ n ∧ Nonempty (G ≃* PSU3Model n)

/-! ### The endgame -/

/-- **Area `Endgame`.** Theorem B (for `Type`) and Brauer–Suzuki give the challenge in every
universe: transfer `X` to an isomorphic group on `Fin |X|`, rule out 2-rank 1 by Brauer–Suzuki,
and read `L = X`, `O(X) = 1` off Theorem B. -/
def EndgameProp.{u} : Prop :=
  TheoremB → BrauerSuzukiProp → ModelFactsProp →
    ∀ (X : Type u) [Group X] [Finite X] [IsSimpleGroup X] (M : Subgroup X),
      IsStronglyEmbedded M → IsSimpleBenderGroup X

end Submission.Blueprint
