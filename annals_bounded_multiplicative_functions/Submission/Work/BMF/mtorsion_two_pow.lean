import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The `m`-torsion of `(ZMod (2 ^ e))ˣ`

The number of `m`-th roots of unity in `ZMod (2 ^ e)` is at most `2 * m`.

For `e ≤ 2` the group of units is cyclic and the claim follows from
`IsCyclic.card_pow_eq_one_le`.  For `e ≥ 3` the group of units is not cyclic, but the
reduction map `(ZMod (2 ^ e))ˣ →* (ZMod 4)ˣ` has cyclic kernel
(`ZMod.orderOf_five` shows that the kernel is generated by `5`), and the target has `2`
elements.  Hence the `m`-torsion of `(ZMod (2 ^ e))ˣ` has at most `2` times as many elements
as the `m`-torsion of the cyclic kernel, which is at most `m`.

The hypothesis `1 ≤ m` is needed: for `m = 0` the group `(ZMod (2 ^ e))ˣ` itself is the
`0`-torsion.
-/

set_option linter.style.haveILetI false

namespace Work.BMF

/-- The order of `5` in `ZMod (2 ^ e)` is `2 ^ (e - 2)` for `e ≥ 2`. -/
lemma orderOf_five_two_pow (e : ℕ) (he : 2 ≤ e) :
    orderOf (5 : ZMod (2 ^ e)) = 2 ^ (e - 2) := by
  obtain ⟨k, rfl⟩ : ∃ k, e = k + 2 := ⟨e - 2, (Nat.sub_add_cancel he).symm⟩
  simpa using ZMod.orderOf_five k

/-- The number of units of `ZMod (2 ^ e)` is `2 ^ (e - 1)`. -/
lemma card_units_two_pow (e : ℕ) [NeZero (2 ^ e)] :
    Nat.card (ZMod (2 ^ e))ˣ = 2 ^ (e - 1) := by
  rcases Nat.eq_zero_or_pos e with he | he
  · subst he
    simp
  · rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
    obtain ⟨k, rfl⟩ : ∃ k, e = k + 1 := ⟨e - 1, (Nat.sub_add_cancel he).symm⟩
    rw [Nat.totient_prime_pow_succ Nat.prime_two]
    simp

/-- The group `(ZMod 4)ˣ` has two elements. -/
lemma card_units_zmod_four : Nat.card (ZMod 4)ˣ = 2 := by
  rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
  decide

/-- The number of `m`-th roots of unity in `ZMod (2 ^ e)` is at most `2 * m`. -/
theorem mtorsion_two_pow (e m : ℕ) (hm : 1 ≤ m) :
    Nat.card (rootsOfUnity m (ZMod (2 ^ e))) ≤ 2 * m := by
  classical
  rcases le_or_gt e 2 with he2 | he2
  · -- `(ZMod (2 ^ e))ˣ` is cyclic, since `e ≤ 2`.
    haveI : NeZero (2 ^ e) := ⟨pow_ne_zero e (by norm_num)⟩
    have hcyc : IsCyclic (ZMod (2 ^ e))ˣ := (ZMod.isCyclic_units_two_pow_iff e).mpr he2
    have h := IsCyclic.card_pow_eq_one_le (α := (ZMod (2 ^ e))ˣ) (n := m) hm
    have hcard : Nat.card (rootsOfUnity m (ZMod (2 ^ e))) ≤ m := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
      simpa only [mem_rootsOfUnity] using h
    omega
  · have hge2 : 2 ≤ e := by omega
    haveI : NeZero (2 ^ e) := ⟨pow_ne_zero e (by norm_num)⟩
    have h4 : 4 ∣ 2 ^ e := by
      obtain ⟨k, rfl⟩ : ∃ k, e = k + 2 := ⟨e - 2, (Nat.sub_add_cancel hge2).symm⟩
      exact ⟨2 ^ k, by ring⟩
    have hc : Nat.Coprime 5 (2 ^ e) := (by norm_num : Nat.Coprime 5 2).pow_right e
    -- `5` viewed as a unit of `ZMod (2 ^ e)`, and the reduction map to `ZMod 4`.
    set g5 : (ZMod (2 ^ e))ˣ := ZMod.unitOfCoprime 5 hc with hg5def
    have hg5 : ((g5 : (ZMod (2 ^ e))ˣ) : ZMod (2 ^ e)) = 5 := by
      rw [hg5def]; exact ZMod.coe_unitOfCoprime 5 hc
    set f : (ZMod (2 ^ e))ˣ →* (ZMod 4)ˣ := ZMod.unitsMap h4 with hfdef
    -- `5` lies in the kernel of the reduction map.
    have hmem : g5 ∈ f.ker := by
      rw [MonoidHom.mem_ker, hfdef, ZMod.unitsMap_def]
      apply Units.ext
      rw [Units.coe_map, hg5def, ZMod.coe_unitOfCoprime]
      change (ZMod.castHom h4 (ZMod 4)) (5 : ZMod (2 ^ e)) = 1
      rw [map_ofNat]
      decide
    have hcardG : Nat.card (ZMod (2 ^ e))ˣ = 2 ^ (e - 1) := card_units_two_pow e
    have hrange2 : Nat.card ↥f.range = 2 := by
      rw [MonoidHom.range_eq_top.mpr (by rw [hfdef]; exact ZMod.unitsMap_surjective h4),
        Subgroup.card_top]
      exact card_units_zmod_four
    -- The kernel of the reduction map has `2 ^ (e - 2)` elements.
    have hcardker : Nat.card ↥f.ker = 2 ^ (e - 2) := by
      have h1 := Subgroup.card_mul_index f.ker
      rw [Subgroup.index_ker, hrange2, hcardG] at h1
      have h2 : 2 ^ (e - 1) = 2 ^ (e - 2) * 2 := by
        rw [show e - 1 = e - 2 + 1 from by omega, pow_succ]
      rw [h2] at h1
      omega
    -- The kernel is generated by `5`, hence cyclic.
    have hker : Subgroup.zpowers g5 = f.ker := by
      refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hmem) ?_
      rw [hcardker, Nat.card_zpowers]
      have hord : orderOf g5 = 2 ^ (e - 2) := by
        rw [← orderOf_injective (Units.coeHom (ZMod (2 ^ e))) Units.coeHom_injective g5]
        change orderOf ((g5 : ZMod (2 ^ e))) = 2 ^ (e - 2)
        rw [hg5]
        exact orderOf_five_two_pow e hge2
      rw [hord]
    haveI : IsCyclic ↥f.ker := hker ▸ Subgroup.isCyclic_zpowers g5
    -- Counting: `H` is the `m`-torsion of the unit group, and `φ` the reduction composed
    -- with the inclusion of `H`.
    set H : Subgroup (ZMod (2 ^ e))ˣ := rootsOfUnity m (ZMod (2 ^ e)) with hHdef
    suffices Nat.card ↥H ≤ 2 * m by simpa [hHdef] using this
    let φ : ↥H →* (ZMod 4)ˣ := f.comp H.subtype
    have hcard_eq : Nat.card ↥H = Nat.card ↥φ.ker * Nat.card ↥φ.range := by
      rw [← Subgroup.card_mul_index φ.ker, Subgroup.index_ker φ]
    have hrange_le : Nat.card ↥φ.range ≤ 2 := by
      have h1 : Nat.card ↥φ.range ≤ Nat.card ((ZMod 4)ˣ) :=
        Nat.card_le_card_of_injective (fun x : ↥φ.range => (x : (ZMod 4)ˣ))
          (fun a b h => Subtype.ext h)
      rwa [card_units_zmod_four] at h1
    -- The kernel of `φ` has at most `m` elements, being killed by `m` inside a cyclic group.
    have hker_le : Nat.card ↥φ.ker ≤ m := by
      have hinj : Nat.card ↥φ.ker ≤ Nat.card {k : ↥f.ker // k ^ m = 1} := by
        refine Nat.card_le_card_of_injective (fun x : ↥φ.ker => ?_) ?_
        · refine ⟨⟨(x.1 : (ZMod (2 ^ e))ˣ), ?_⟩, ?_⟩
          · rw [MonoidHom.mem_ker]
            have h1 : φ x.1 = 1 := x.2
            simpa only [φ, MonoidHom.comp_apply, Subgroup.subtype_apply] using h1
          · apply Subtype.ext
            have h3 : ((x.1 : ↥H) : (ZMod (2 ^ e))ˣ) ∈ H := x.1.2
            have h2 := (mem_rootsOfUnity m ((x.1 : ↥H) : (ZMod (2 ^ e))ˣ)).mp (hHdef ▸ h3)
            simpa using h2
        · intro a b hab
          have h : ((a.1 : ↥H) : (ZMod (2 ^ e))ˣ) = ((b.1 : ↥H) : (ZMod (2 ^ e))ˣ) := by
            have hh := congrArg (fun z : {k : ↥f.ker // k ^ m = 1} =>
              ((z.1 : ↥f.ker) : (ZMod (2 ^ e))ˣ)) hab
            simpa using hh
          exact Subtype.ext (Subtype.ext h)
      have hT : Nat.card {k : ↥f.ker // k ^ m = 1} ≤ m := by
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
        exact IsCyclic.card_pow_eq_one_le (α := ↥f.ker) (n := m) hm
      exact le_trans hinj hT
    rw [hcard_eq]
    calc Nat.card ↥φ.ker * Nat.card ↥φ.range ≤ m * 2 := Nat.mul_le_mul hker_le hrange_le
      _ = 2 * m := by ring

end Work.BMF
