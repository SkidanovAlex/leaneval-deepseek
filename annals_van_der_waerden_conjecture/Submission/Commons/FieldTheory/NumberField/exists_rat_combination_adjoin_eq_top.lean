import Mathlib.Algebra.Order.Ring.Star
import Mathlib.Data.Rat.Star
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.SimpleRing.Principal
import Submission.Commons.LinearAlgebra.Submodule.exists_forall_notMem_of_finset

namespace Commons.FieldTheory.NumberField

open Module

theorem exists_rat_combination_adjoin_eq_top {L : Type*} [Field L] [NumberField L] {ι : Type*}
    [Fintype ι] [DecidableEq ι] (x : ι → L) (hgen : Algebra.adjoin ℚ (Set.range x) = ⊤) :
    ∃ μ : ι → ℚ, Algebra.adjoin ℚ {∑ i, μ i • x i} = ⊤ := by
  classical
  -- A number field has only finitely many intermediate fields.
  haveI : Finite (IntermediateField ℚ L) := by
    obtain ⟨α, hα⟩ := Field.exists_primitive_element ℚ L
    exact Field.finite_intermediateField_of_exists_primitive_element ℚ L ⟨α, hα⟩
  haveI : Fintype (IntermediateField ℚ L) := Fintype.ofFinite _
  -- The ℚ-linear map `μ ↦ ∑ i, μ i • x i`.
  let φ : (ι → ℚ) →ₗ[ℚ] L :=
    { toFun := fun μ => ∑ i, μ i • x i
      map_add' := by intro μ ν; simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := by
        intro c μ
        simp only [Pi.smul_apply, RingHom.id_apply]
        rw [show (∑ i, (c • μ i) • x i) = ∑ i, c • (μ i • x i) from
          Finset.sum_congr rfl (fun i _ => by rw [smul_eq_mul, mul_smul])]
        rw [Algebra.smul_def, Finset.mul_sum]
        simp only [Algebra.smul_def] }
  have hφsingle : ∀ i : ι, φ (Pi.single i (1 : ℚ)) = x i := by
    intro i
    simp only [φ, LinearMap.coe_mk, AddHom.coe_mk]
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hj; rw [Pi.single_eq_of_ne hj, zero_smul]
    · intro hi; exact absurd (Finset.mem_univ i) hi
  -- The ℚ-field generated by the `x i` is everything.
  have hgen' : IntermediateField.adjoin ℚ (Set.range x) = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra ℚ (Set.range x) hgen
  -- The "bad" set of coefficients whose combination lies in a given intermediate field.
  let S : IntermediateField ℚ L → Submodule ℚ (ι → ℚ) :=
    fun K => Submodule.comap φ (K.toSubalgebra).toSubmodule
  -- For a proper intermediate field, the bad set is a proper subspace.
  have hS : ∀ K : IntermediateField ℚ L, K ≠ ⊤ → S K ≠ ⊤ := by
    intro K hK htop
    refine hK (top_le_iff.mp ?_)
    rw [← hgen']
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro y ⟨i, rfl⟩
    have h1 : φ (Pi.single i (1 : ℚ)) ∈ K := by
      have hmem : Pi.single i (1 : ℚ) ∈ S K := by rw [htop]; exact Submodule.mem_top
      simpa [S, Submodule.mem_comap] using hmem
    rwa [hφsingle i] at h1
  -- A finite union of proper subspaces is proper: choose coefficients outside all of them.
  obtain ⟨μ, hμ⟩ := Commons.LinearAlgebra.Submodule.exists_forall_notMem_of_finset
    (Finset.univ.filter (fun K : IntermediateField ℚ L => K ≠ ⊤)) S
    (fun K hK => hS K (Finset.mem_filter.mp hK).2)
  refine ⟨μ, ?_⟩
  have hbad : ∀ K : IntermediateField ℚ L, K ≠ ⊤ → φ μ ∉ K := by
    intro K hK hmem
    apply hμ K (Finset.mem_filter.mpr ⟨Finset.mem_univ K, hK⟩)
    simpa [S, Submodule.mem_comap] using hmem
  -- So `φ μ` lies in no proper intermediate field: it is a primitive element.
  have htop : IntermediateField.adjoin ℚ {φ μ} = ⊤ := by
    by_contra hne
    exact hbad _ hne (IntermediateField.mem_adjoin_simple_self ℚ (φ μ))
  have key := (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic (F := ℚ)
    (Algebra.IsAlgebraic.isAlgebraic (φ μ))).mp htop
  simpa [φ] using key

end Commons.FieldTheory.NumberField