import Mathlib.RingTheory.MvPolynomial.Ideal
import Submission.Commons.Algebra.MvPolynomial.homogeneousComponent_mul_of_isHomogeneous_right
import Submission.Commons.FieldTheory.Polynomial.psum_homogeneous_eq_zero
import Submission.Commons.Algebra.MvPolynomial.finite_zeroLocus_of_moduleFinite

namespace Commons.FieldTheory.Polynomial

open MvPolynomial

noncomputable section

/-- Evaluation of the `j`-th weighted power sum polynomial. -/
theorem eval_psum_aux {F : Type*} [Field F] {r : ℕ} (m : Fin r → F) (y : Fin r → F) (j : Fin r) :
    MvPolynomial.eval y (∑ i : Fin r, MvPolynomial.C (m i) * MvPolynomial.X i ^ ((j : ℕ) + 1))
      = ∑ i : Fin r, m i * (y i) ^ ((j : ℕ) + 1) := by
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X]

/-- If the common zero locus of the `g j` is the origin (over an algebraically closed field),
then the ideal of the variables is contained in the radical of the ideal generated by `g`. -/
theorem idealOfVars_le_radical_span_of_eval_eq_zero_iff {F : Type*} [Field F] [IsAlgClosed F]
    {r : ℕ} (g : Fin r → MvPolynomial (Fin r) F)
    (hV : ∀ y : Fin r → F, (∀ j, MvPolynomial.eval y (g j) = 0) ↔ y = 0) :
    MvPolynomial.idealOfVars (Fin r) F ≤ (Ideal.span (Set.range g)).radical := by
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := F)]
  rw [MvPolynomial.idealOfVars]
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  show MvPolynomial.X i ∈ MvPolynomial.vanishingIdeal F
    (MvPolynomial.zeroLocus F (Ideal.span (Set.range g)))
  rw [MvPolynomial.mem_vanishingIdeal_iff]
  intro x hx
  have hx0 : x = 0 := by
    apply (hV x).mp
    intro j
    have hmem : g j ∈ Ideal.span (Set.range g) := Ideal.subset_span ⟨j, rfl⟩
    have h1 := (MvPolynomial.mem_zeroLocus_iff.mp hx) (g j) hmem
    simpa only [MvPolynomial.aeval_eq_eval] using h1
  subst hx0
  simp

/-- Homogeneous certificate for membership in an ideal generated by homogeneous elements:
if `p` is homogeneous of degree `d` and lies in the ideal spanned by `g j`, each `g j`
homogeneous of degree `e j ≤ d`, then `p = ∑ j, q j * g j` with `q j` homogeneous of
degree `d - e j`. -/
theorem exists_homogeneous_certificate {F : Type*} [Field F] {r : ℕ}
    (g : Fin r → MvPolynomial (Fin r) F) (e : Fin r → ℕ)
    (hg : ∀ j, (g j).IsHomogeneous (e j))
    {p : MvPolynomial (Fin r) F} {d : ℕ} (hp : p.IsHomogeneous d)
    (hmem : p ∈ Ideal.span (Set.range g)) (hd : ∀ j, e j ≤ d) :
    ∃ q : Fin r → MvPolynomial (Fin r) F,
      (∀ j, (q j).IsHomogeneous (d - e j)) ∧ p = ∑ j, q j * g j := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  refine ⟨fun j => MvPolynomial.homogeneousComponent (d - e j) (c j),
    fun j => MvPolynomial.homogeneousComponent_isHomogeneous _ _, ?_⟩
  rw [← MvPolynomial.homogeneousComponent_eq_self hp, ← hc, map_sum]
  apply Finset.sum_congr rfl
  intro j _
  have h := Commons.Algebra.MvPolynomial.homogeneousComponent_mul_of_isHomogeneous_right
    (hg j) (c j) (d - e j)
  rwa [Nat.sub_add_cancel (hd j)] at h

/-- Total degree of a homogeneous polynomial is at most its degree. -/
theorem isHomogeneous_totalDegree_le {σ : Type*} {R : Type*} [CommSemiring R]
    {p : MvPolynomial σ R} {n : ℕ} (hp : p.IsHomogeneous n) : p.totalDegree ≤ n := by
  by_cases h : p = 0
  · rw [h, MvPolynomial.totalDegree_zero]; exact Nat.zero_le n
  · rw [hp.totalDegree h]

variable {F : Type*} [Field F]

/-- Elementary arithmetic used in the finite-dimensionality argument. -/
theorem powSum_arith (A N e : ℕ) (he : 1 ≤ e) (heN : e ≤ N) (hNA : N ≤ A) :
    (A - N) + (N - e) + (e - 1) = A - 1 := by omega

/-- A finite-dimensionality criterion: if the leading forms `g j` (homogeneous of degree `e j ≥ 1`)
of the polynomials `f j` have only the origin as common zero over an algebraically closed field,
then `F[X₁,…,X_r] ⧸ (f₁,…,f_r)` is finite dimensional over `F`. -/
theorem moduleFinite_quotient_of_eval_eq_zero_iff [IsAlgClosed F] {r : ℕ} (hr : 1 ≤ r)
    (f g : Fin r → MvPolynomial (Fin r) F) (e : Fin r → ℕ)
    (hg : ∀ j, (g j).IsHomogeneous (e j)) (he : ∀ j, 1 ≤ e j)
    (hV : ∀ y : Fin r → F, (∀ j, MvPolynomial.eval y (g j) = 0) ↔ y = 0)
    (hlead : ∀ j, (f j - g j).totalDegree < e j) :
    Module.Finite F (MvPolynomial (Fin r) F ⧸ Ideal.span (Set.range f)) := by
  classical
  let A := MvPolynomial (Fin r) F
  let I : Ideal A := Ideal.span (Set.range f)
  let J : Ideal A := Ideal.span (Set.range g)
  let E : ℕ := Finset.univ.sup e
  have hE : ∀ j, e j ≤ E := fun j => Finset.le_sup (Finset.mem_univ j)
  have hIV : MvPolynomial.idealOfVars (Fin r) F ≤ (Ideal.span (Set.range g)).radical :=
    idealOfVars_le_radical_span_of_eval_eq_zero_iff g hV
  have hXi : ∀ i : Fin r, ∃ n, (MvPolynomial.X i : A) ^ n ∈ J := by
    intro i
    exact Ideal.mem_radical_iff.mp (hIV (Ideal.subset_span ⟨i, rfl⟩))
  choose n hn using hXi
  let N : Fin r → ℕ := fun i => max (n i) E
  have hNE : ∀ i, E ≤ N i := fun i => le_max_right _ _
  have hNe : ∀ i j, e j ≤ N i := fun i j => le_trans (hE j) (hNE i)
  have hNX : ∀ i, (MvPolynomial.X i : A) ^ (N i) ∈ J := by
    intro i
    have h1 : (MvPolynomial.X i : A) ^ (n i) ∈ J := hn i
    have h2 : (N i) = n i + (N i - n i) := (Nat.add_sub_cancel' (le_max_left _ _)).symm
    rw [h2, pow_add]
    exact Ideal.mul_mem_right _ _ h1
  have hcert : ∀ i, ∃ q : Fin r → MvPolynomial (Fin r) F,
      (∀ j, (q j).IsHomogeneous (N i - e j)) ∧ (MvPolynomial.X i : A) ^ (N i) = ∑ j, q j * g j := by
    intro i
    refine exists_homogeneous_certificate g e hg ?_ (hNX i) (fun j => hNe i j)
    simpa using (MvPolynomial.isHomogeneous_X F i).pow (N i)
  choose q hqhom hqcert using hcert
  let W : Submodule F A := MvPolynomial.restrictTotalDegree (Fin r) F (∑ i, (N i - 1))
  -- main induction on the degree of a monomial
  have key : ∀ d, ∀ α : Fin r →₀ ℕ, (∑ i, α i) ≤ d →
      (MvPolynomial.monomial α (1 : F) : A) ∈ I.restrictScalars F ⊔ W := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro α hα
      by_cases hsmall : (∑ i, α i) ≤ ∑ i, (N i - 1)
      · refine Submodule.mem_sup_right ?_
        rw [MvPolynomial.mem_restrictTotalDegree]
        calc (MvPolynomial.monomial α (1 : F)).totalDegree
            ≤ α.sum (fun _ e => e) := MvPolynomial.totalDegree_monomial_le α 1
          _ = ∑ i, α i := Finsupp.sum_fintype α (fun _ e => e) (fun i => rfl)
          _ ≤ ∑ i, (N i - 1) := hsmall
      · push Not at hsmall
        have hex : ∃ i, N i ≤ α i := by
          by_contra h
          push Not at h
          have hle : ∑ i, α i ≤ ∑ i, (N i - 1) :=
            Finset.sum_le_sum (fun i _ => by have := h i; omega)
          omega
        obtain ⟨i, hi⟩ := hex
        set s : Fin r →₀ ℕ := Finsupp.single i (N i) with hs
        have hsle : s ≤ α := Finsupp.single_le_iff.mpr hi
        have hds : Finsupp.degree s = N i := by
          rw [hs]; exact Finsupp.degree_single i (N i)
        have hdegα : Finsupp.degree α = ∑ l, α l := Finsupp.degree_eq_sum α
        have hai : N i ≤ ∑ l, α l :=
          le_trans hi (Finset.single_le_sum (fun l _ => Nat.zero_le _) (Finset.mem_univ i))
        have hdsub : Finsupp.degree (α - s) = (∑ l, α l) - N i := by
          have h := map_add Finsupp.degree (α - s) s
          rw [tsub_add_cancel_of_le hsle, hds, hdegα] at h
          omega
        have hmul : (MvPolynomial.monomial (α - s) (1 : F) : A) * (MvPolynomial.monomial s (1 : F))
            = MvPolynomial.monomial α (1 : F) := by
          rw [MvPolynomial.monomial_mul, tsub_add_cancel_of_le hsle, mul_one]
        have hsplit : (MvPolynomial.monomial α (1 : F) : A)
            = MvPolynomial.monomial (α - s) (1 : F) * (MvPolynomial.X i) ^ (N i) := by
          rw [MvPolynomial.X_pow_eq_monomial, ← hs, ← hmul]
        rw [hsplit, hqcert i, Finset.mul_sum]
        have hstep : (∑ j, MvPolynomial.monomial (α - s) (1 : F) * (q i j * g j))
            = ∑ j, (MvPolynomial.monomial (α - s) (1 : F) * q i j) * g j := by
          apply Finset.sum_congr rfl
          intro j _
          ring
        rw [hstep]
        have hsplit2 : (∑ j, (MvPolynomial.monomial (α - s) (1 : F) * q i j) * g j)
            = (∑ j, (MvPolynomial.monomial (α - s) (1 : F) * q i j) * f j)
              + (∑ j, (MvPolynomial.monomial (α - s) (1 : F) * q i j) * (g j - f j)) := by
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro j _
          ring
        rw [hsplit2]
        refine Submodule.add_mem _ ?_ ?_
        · refine Submodule.mem_sup_left ?_
          rw [Submodule.restrictScalars_mem]
          exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left I _ (Ideal.subset_span ⟨j, rfl⟩))
        · have hIH : ∀ p : A, p.totalDegree ≤ d - 1 → p ∈ I.restrictScalars F ⊔ W := by
            intro p hp
            rw [MvPolynomial.as_sum p]
            refine Submodule.sum_mem _ (fun v hv => ?_)
            have hvdeg : (∑ l, v l) ≤ d - 1 := by
              have h1 := MvPolynomial.le_totalDegree hv
              rw [Finsupp.sum_fintype v (fun _ e => e) (fun i => rfl)] at h1
              omega
            have hlt : (∑ l, v l) < d := by omega
            have h1 : (MvPolynomial.monomial v (1 : F) : A) ∈ I.restrictScalars F ⊔ W :=
              ih (∑ l, v l) hlt v le_rfl
            have h2 : (MvPolynomial.monomial v (MvPolynomial.coeff v p) : A)
                = (MvPolynomial.coeff v p) • (MvPolynomial.monomial v (1 : F) : A) := by
              rw [show (MvPolynomial.coeff v p) • (MvPolynomial.monomial v (1 : F) : A)
                    = (MvPolynomial.monomial v) ((MvPolynomial.coeff v p) • (1 : F)) from
                    (map_smul (MvPolynomial.monomial v) _ _).symm, smul_eq_mul, mul_one]
            rw [h2]
            exact Submodule.smul_mem _ _ h1
          apply hIH
          refine (MvPolynomial.totalDegree_finsetSum _ _).trans ?_
          rw [Finset.sup_le_iff]
          intro j _
          have h1 : (MvPolynomial.monomial (α - s) (1 : F) * q i j).totalDegree
              ≤ (MvPolynomial.monomial (α - s) (1 : F)).totalDegree + (q i j).totalDegree :=
            MvPolynomial.totalDegree_mul _ _
          have h2 : (MvPolynomial.monomial (α - s) (1 : F)).totalDegree ≤ Finsupp.degree (α - s) := by
            have h := MvPolynomial.totalDegree_monomial_le (α - s) (1 : F)
            rw [show (α - s).sum (fun x => id) = (α - s).sum (fun _ e => e) from rfl,
              Finsupp.sum_fintype (α - s) (fun _ e => e) (fun i => rfl),
              ← Finsupp.degree_eq_sum] at h
            exact h
          have h3 : (q i j).totalDegree ≤ N i - e j := isHomogeneous_totalDegree_le (hqhom i j)
          have h4 : (g j - f j).totalDegree ≤ e j - 1 := by
            rw [show g j - f j = -(f j - g j) from by ring, MvPolynomial.totalDegree_neg]
            have := hlead j; omega
          have hei : e j ≤ Finsupp.degree α := by rw [hdegα]; exact le_trans (hNe i j) hai
          have hNi : N i ≤ Finsupp.degree α := by rw [hdegα]; exact hai
          calc ((MvPolynomial.monomial (α - s) (1 : F) * q i j) * (g j - f j)).totalDegree
              ≤ (MvPolynomial.monomial (α - s) (1 : F) * q i j).totalDegree
                  + (g j - f j).totalDegree := MvPolynomial.totalDegree_mul _ _
            _ ≤ ((MvPolynomial.monomial (α - s) (1 : F)).totalDegree + (q i j).totalDegree)
                  + (g j - f j).totalDegree := by exact add_le_add h1 le_rfl
            _ ≤ (Finsupp.degree (α - s) + (N i - e j)) + (e j - 1) := by
                exact add_le_add (add_le_add h2 h3) h4
            _ = ((∑ l, α l) - N i + (N i - e j)) + (e j - 1) := by rw [hdsub]
            _ = (∑ l, α l) - 1 :=
                powSum_arith (∑ l, α l) (N i) (e j) (he j) (hNe i j) hai
            _ ≤ d - 1 := Nat.sub_le_sub_right hα 1
  have htop : (⊤ : Submodule F A) ≤ I.restrictScalars F ⊔ W := by
    rw [← (MvPolynomial.basisMonomials (Fin r) F).span_eq]
    refine Submodule.span_le.mpr ?_
    rintro x ⟨α, rfl⟩
    exact key (∑ i, α i) α le_rfl
  have hIW : I.restrictScalars F ⊔ W = ⊤ := le_antisymm le_top htop
  haveI : Module.Finite F (↥W) := by dsimp only [W]; infer_instance
  let φ : (↥W) →ₗ[F] (A ⧸ I) := (Ideal.Quotient.mkₐ F I).toLinearMap.comp W.subtype
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    have ha : a ∈ I.restrictScalars F ⊔ W := by rw [hIW]; trivial
    rw [Submodule.mem_sup] at ha
    obtain ⟨b, hbI, w, hwW, hbw⟩ := ha
    refine ⟨⟨w, hwW⟩, ?_⟩
    have hb0 : (Ideal.Quotient.mk I) b = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact (Submodule.restrictScalars_mem F I b).mp hbI
    have key : (Ideal.Quotient.mk I) w = (Ideal.Quotient.mk I) a := by
      rw [← hbw, map_add, hb0, zero_add]
    simp only [φ, LinearMap.comp_apply, Submodule.subtype_apply, AlgHom.toLinearMap_apply]
    rw [show (Ideal.Quotient.mkₐ F I) w = Ideal.Quotient.mk I w from
      congrFun (Ideal.Quotient.mkₐ_eq_mk F I) w]
    exact key
  exact Module.Finite.of_surjective φ hsurj

/-- **The weighted power-sum system has finitely many solutions.**

Let `m c : Fin r → F` with `F` algebraically closed, and suppose no nonempty subset of the
weights `m` sums to `0`.  Then the system `∑ i, m i * (x i) ^ (j + 1) = c j` (`j = 0, …, r-1`)
has only finitely many solutions `x : Fin r → F`. -/
theorem finite_powerSum_system (F : Type*) [Field F] [IsAlgClosed F] (r : ℕ) (m c : Fin r → F)
    (hm : ∀ s : Finset (Fin r), s.Nonempty → ∑ i ∈ s, m i ≠ 0) :
    Finite {x : Fin r → F // ∀ j : Fin r, ∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1) = c j} := by
  classical
  rcases Nat.eq_zero_or_pos r with hr | hr
  · subst hr
    exact Finite.of_subsingleton
  · have hg : ∀ j : Fin r,
        (∑ i : Fin r, MvPolynomial.C (m i) * MvPolynomial.X i ^ ((j : ℕ) + 1)).IsHomogeneous
          ((j : ℕ) + 1) := by
      intro j
      rw [← MvPolynomial.mem_homogeneousSubmodule]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have h := (MvPolynomial.isHomogeneous_C (Fin r) (m i)).mul
        ((MvPolynomial.isHomogeneous_X F i).pow ((j : ℕ) + 1))
      simpa using h
    let g : Fin r → MvPolynomial (Fin r) F :=
      fun j => ∑ i : Fin r, MvPolynomial.C (m i) * MvPolynomial.X i ^ ((j : ℕ) + 1)
    let f : Fin r → MvPolynomial (Fin r) F := fun j => g j - MvPolynomial.C (c j)
    have hg' : ∀ j, (g j).IsHomogeneous ((j : ℕ) + 1) := fun j => hg j
    have hlead : ∀ j, (f j - g j).totalDegree < ((j : ℕ) + 1) := by
      intro j
      have h1 : f j - g j = -(MvPolynomial.C (c j)) := by
        show (g j - MvPolynomial.C (c j)) - g j = -MvPolynomial.C (c j)
        ring
      rw [h1, MvPolynomial.totalDegree_neg, MvPolynomial.totalDegree_C]
      omega
    have hV : ∀ y : Fin r → F, (∀ j, MvPolynomial.eval y (g j) = 0) ↔ y = 0 := by
      intro y
      constructor
      · intro h
        have h' : ∀ j : Fin r, ∑ i : Fin r, m i * (y i) ^ ((j : ℕ) + 1) = 0 := by
          intro j
          have h1 := h j
          rw [show MvPolynomial.eval y (g j)
              = MvPolynomial.eval y (∑ i : Fin r,
                  MvPolynomial.C (m i) * MvPolynomial.X i ^ ((j : ℕ) + 1)) from rfl,
            eval_psum_aux m y j] at h1
          exact h1
        funext i
        exact Commons.FieldTheory.Polynomial.psum_homogeneous_eq_zero y m hm h' i
      · intro hy j
        rw [hy]
        rw [show MvPolynomial.eval 0 (g j)
            = MvPolynomial.eval 0 (∑ i : Fin r,
                MvPolynomial.C (m i) * MvPolynomial.X i ^ ((j : ℕ) + 1)) from rfl,
          eval_psum_aux m 0 j]
        simp [zero_pow (Nat.succ_ne_zero (j : ℕ))]
    have hmod := moduleFinite_quotient_of_eval_eq_zero_iff hr f g (fun j => (j : ℕ) + 1)
      hg' (fun j => Nat.le_add_left 1 (j : ℕ)) hV hlead
    have hZfin : (MvPolynomial.zeroLocus F (Ideal.span (Set.range f))).Finite :=
      Commons.Algebra.MvPolynomial.finite_zeroLocus_of_moduleFinite _ hmod
    have hZeq : MvPolynomial.zeroLocus F (Ideal.span (Set.range f))
        = {x : Fin r → F | ∀ j : Fin r, ∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1) = c j} := by
      ext x
      rw [MvPolynomial.mem_zeroLocus_iff]
      constructor
      · intro h j
        have hA : MvPolynomial.aeval x (g j) = ∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1) := by
          rw [MvPolynomial.aeval_eq_eval]
          exact eval_psum_aux m x j
        have h2 : MvPolynomial.aeval x (f j)
            = (∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1)) - c j := by
          show MvPolynomial.aeval x (g j - MvPolynomial.C (c j)) = _
          rw [map_sub, hA]
          simp
        have hmem : f j ∈ Ideal.span (Set.range f) := Ideal.subset_span ⟨j, rfl⟩
        have h1 := h (f j) hmem
        rw [h2] at h1
        exact sub_eq_zero.mp h1
      · intro h p hp
        have hgen : ∀ j, MvPolynomial.aeval x (f j) = 0 := by
          intro j
          have hA : MvPolynomial.aeval x (g j) = ∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1) := by
            rw [MvPolynomial.aeval_eq_eval]
            exact eval_psum_aux m x j
          have h2 : MvPolynomial.aeval x (f j)
              = (∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1)) - c j := by
            show MvPolynomial.aeval x (g j - MvPolynomial.C (c j)) = _
            rw [map_sub, hA]
            simp
          rw [h2, h j, sub_self]
        have hle : Ideal.span (Set.range f) ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom :=
          Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact RingHom.mem_ker.mpr (hgen j))
        exact RingHom.mem_ker.mp (hle hp)
    have hfin : ({x : Fin r → F | ∀ j : Fin r, ∑ i : Fin r, m i * (x i) ^ ((j : ℕ) + 1) = c j}).Finite :=
      hZeq ▸ hZfin
    exact hfin.to_subtype

end

end Commons.FieldTheory.Polynomial