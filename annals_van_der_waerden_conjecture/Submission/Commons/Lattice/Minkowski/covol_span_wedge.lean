import Mathlib
import Submission.Commons.LinearAlgebra.ExteriorPower.iMulti_det_smul
import Submission.Commons.Analysis.InnerProductSpace.norm_iMulti_orthonormal

/-!
# Covolume of the `ℤ`-span of an independent family (shared commons)

For `E := EuclideanSpace ℝ (Fin n)` with the standard orthonormal basis, an `ℝ`-linearly
independent family `v : Fin n → E` (hence an `ℝ`-basis of `E`) spans a full `ℤ`-lattice
`L₀ := span ℤ (range v)`, and its covolume equals the norm of the top exterior power:

`ZLattice.covolume L₀ = ‖ιMulti ℝ n v‖`   (`covol_span_wedge`).

This is the "covolume of the sublattice generated by independent vectors" comparison used in
geometry of numbers (the Hadamard side `covol ≤ ‖v₁∧…∧vₙ‖ ≤ ∏‖vᵢ‖` of Minkowski's second
theorem).  Proof route (as recorded in the ROADMAP):
- `real_expansion`: any vector expands in an `ℝ`-basis (`b.repr.symm` + `Finsupp.sum_fintype`);
- `span_top_of_linearIndependent`: an independent family of `n` vectors in the `n`-dimensional
  space spans it (quotient/finrank argument via
  `Module.finrank_quotient_add_finrank_le` + `Module.finrank_zero_iff`);
- `covolume_eq_measure_fundamentalDomain` + `ZSpan.isAddFundamentalDomain` +
  `ZSpan.measureReal_fundamentalDomain` (with `b₁ := Basis.mk hv hsp`, `b₀` the standard ON
  basis, whose fundamental domain has volume `1` by `measureReal_fundamentalDomain_stdOrth`):
  `covol L₀ = |b₀.det ⇑b₁|`;
- `Commons.LinearAlgebra.ExteriorPower.iMulti_det_smul` with the change matrix
  `A := b₀.toMatrix v` gives `ιMulti v = A.det • ιMulti (⇑b₀)`, and
  `Commons...norm_iMulti_orthonormal` (the standard ON basis has unit top wedge) gives
  `‖ιMulti v‖ = |A.det| = |b₀.det ⇑b₁|`.

All declarations are Mathlib-only apart from the two listed Commons exterior-power/ON-basis
lemmas.
-/

noncomputable section

open MeasureTheory MeasureTheory.Measure Module BigOperators
open scoped ENNReal
set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

namespace Commons.Lattice.Minkowski

abbrev Euclid (n : ℕ) := EuclideanSpace ℝ (Fin n)
abbrev stdOrth (n : ℕ) : OrthonormalBasis (Fin n) ℝ (Euclid n) := EuclideanSpace.basisFun (Fin n) ℝ

/-- Expansion of a vector in an `ℝ`-basis. -/
lemma real_expansion {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] {ι : Type*} [Fintype ι]
    (b : Module.Basis ι ℝ F) (x : F) :
    x = ∑ i : ι, (b.repr x) i • b i := by
  classical
  calc
    x = b.repr.symm (b.repr x) := (b.repr.symm_apply_apply x).symm
    _ = Finsupp.linearCombination ℝ b (b.repr x) := by
          rw [Module.Basis.repr_symm_apply (b := b)]
    _ = ∑ i : ι, (b.repr x) i • b i := by
          rw [Finsupp.linearCombination_apply]
          rw [Finsupp.sum_fintype (f := b.repr x) (g := fun i a => a • b i)
            (by intro i; simp)]

/-- An independent family of `n` vectors in the `n`-dimensional standard space spans the
whole space. -/
lemma span_top_of_linearIndependent {n : ℕ} (v : Fin n → Euclid n) (hv : LinearIndependent ℝ v) :
    ⊤ ≤ Submodule.span ℝ (Set.range v) := by
  classical
  let S : Submodule ℝ (Euclid n) := Submodule.span ℝ (Set.range v)
  have hfinS : Module.finrank ℝ S = n := by
    rw [finrank_span_eq_card (R := ℝ) (b := v) hv]
    simp
  have hfinE : Module.finrank ℝ (Euclid n) = n := by
    have hb : Module.Basis (Fin n) ℝ (Euclid n) := (stdOrth n).toBasis
    rw [Module.finrank_eq_card_basis hb]
    simp
  have hq : Module.finrank ℝ ((Euclid n) ⧸ S) ≤ 0 := by
    have h := Module.finrank_quotient_add_finrank_le (R := ℝ) (M := Euclid n) (N := S)
    rw [hfinS, hfinE] at h
    omega
  have hq0 : Module.finrank ℝ ((Euclid n) ⧸ S) = 0 := le_antisymm hq (Nat.zero_le _)
  have hsub : Subsingleton ((Euclid n) ⧸ S) :=
    (Module.finrank_zero_iff (R := ℝ) (M := (Euclid n) ⧸ S)).mp hq0
  intro x hx
  have hz : (S.mkQ x : (Euclid n) ⧸ S) = 0 := Subsingleton.elim _ _
  have hmem : x ∈ S := by
    have hz0 : (Submodule.Quotient.mk x : (Euclid n) ⧸ S) = 0 := by
      simpa [Submodule.mkQ_apply] using hz
    exact (Submodule.Quotient.mk_eq_zero (p := S)).1 hz0
  simpa [S] using hmem

/-- The fundamental domain of the standard orthonormal basis has real volume `1`. -/
lemma measureReal_fundamentalDomain_std (n : ℕ) :
    volume.real (ZSpan.fundamentalDomain (stdOrth n).toBasis) = 1 := by
  have hcongr := ZSpan.fundamentalDomain_ae_parallelepiped ((stdOrth n).toBasis)
    (volume : Measure (Euclid n))
  have hreal : volume.real (ZSpan.fundamentalDomain (stdOrth n).toBasis) =
      volume.real (parallelepiped ((stdOrth n).toBasis)) := by
    exact measureReal_congr hcongr
  rw [hreal]
  have hp : volume (parallelepiped ((stdOrth n).toBasis)) = 1 := by
    simpa using (stdOrth n).volume_parallelepiped
  rw [show volume.real (parallelepiped ((stdOrth n).toBasis)) =
      (volume (parallelepiped ((stdOrth n).toBasis))).toReal by rfl]
  rw [hp]
  simp

/-- **Covolume of the `ℤ`-span of an independent family equals the norm of its top wedge**:
for `v : Fin n → EuclideanSpace ℝ (Fin n)` `ℝ`-linearly independent (hence an `ℝ`-basis),
`ZLattice.covolume (span ℤ (range v)) = ‖ιMulti ℝ n v‖`. -/
lemma covol_span_wedge (n : ℕ) (hn : 0 < n) (v : Fin n → Euclid n) (hv : LinearIndependent ℝ v) :
    ZLattice.covolume (Submodule.span ℤ (Set.range v)) =
      ‖exteriorPower.ιMulti ℝ n v‖ := by
  classical
  let b₀ : Module.Basis (Fin n) ℝ (Euclid n) := (stdOrth n).toBasis
  have hsp : ⊤ ≤ Submodule.span ℝ (Set.range v) := span_top_of_linearIndependent v hv
  let b₁ : Module.Basis (Fin n) ℝ (Euclid n) := Module.Basis.mk hv hsp
  have hb₁ : ⇑b₁ = v := Module.Basis.coe_mk hv hsp
  have hL : Submodule.span ℤ (Set.range v) = Submodule.span ℤ (Set.range ⇑b₁) := by
    rw [hb₁]
  have hF : MeasureTheory.IsAddFundamentalDomain (Submodule.span ℤ (Set.range ⇑b₁))
      (ZSpan.fundamentalDomain b₁) (volume : Measure (Euclid n)) :=
    ZSpan.isAddFundamentalDomain b₁ volume
  have hcov : ZLattice.covolume (Submodule.span ℤ (Set.range v)) =
      volume.real (ZSpan.fundamentalDomain b₁) := by
    rw [hL]
    exact ZLattice.covolume_eq_measure_fundamentalDomain
      (Submodule.span ℤ (Set.range ⇑b₁)) (volume : Measure (Euclid n)) hF
  have hvol : volume.real (ZSpan.fundamentalDomain b₁) =
      |b₀.det ⇑b₁| * volume.real (ZSpan.fundamentalDomain b₀) := by
    simpa using (ZSpan.measureReal_fundamentalDomain (b := b₁) (μ := volume) (b₀ := b₀))
  have hvol0 : volume.real (ZSpan.fundamentalDomain b₀) = 1 := by
    simpa [b₀] using measureReal_fundamentalDomain_std n
  -- determinant ↔ wedge norm
  let u : Fin n → Euclid n := fun i => b₀ i
  let A : Matrix (Fin n) (Fin n) ℝ := b₀.toMatrix v
  have hw : ∀ j : Fin n, v j = ∑ i : Fin n, A i j • u i := by
    intro j
    have he := real_expansion b₀ (v j)
    calc
      v j = ∑ i : Fin n, (b₀.repr (v j)) i • b₀ i := he
      _ = ∑ i : Fin n, A i j • u i := by
            apply Finset.sum_congr rfl
            intro i hi
            simp [A, u, Module.Basis.toMatrix_apply]
  have hdet := Commons.LinearAlgebra.ExteriorPower.iMulti_det_smul (K := ℝ) (u := u)
    (A := A) (w := v) hw
  have hnrm : ‖exteriorPower.ιMulti ℝ n v‖ = |A.det| := by
    calc
      ‖exteriorPower.ιMulti ℝ n v‖ = ‖A.det • exteriorPower.ιMulti ℝ n u‖ := by rw [hdet]
      _ = |A.det| * ‖exteriorPower.ιMulti ℝ n u‖ := by
            rw [norm_smul]
            rw [Real.norm_eq_abs]
      _ = |A.det| := by
            have hu : ‖exteriorPower.ιMulti ℝ n u‖ = 1 := by
              have hou : Orthonormal ℝ u := by
                simpa [u, b₀, EuclideanSpace.basisFun_apply] using (stdOrth n).orthonormal
              exact Commons.Analysis.InnerProductSpace.norm_iMulti_orthonormal (u := u) hou hn
            rw [hu, mul_one]
  calc
    ZLattice.covolume (Submodule.span ℤ (Set.range v)) = volume.real (ZSpan.fundamentalDomain b₁) := hcov
    _ = |b₀.det ⇑b₁| * volume.real (ZSpan.fundamentalDomain b₀) := hvol
    _ = |b₀.det ⇑b₁| := by rw [hvol0, mul_one]
    _ = |(b₀.toMatrix v).det| := by
          congr 1
          -- b₀.det ⇑b₁ = (b₀.toMatrix ⇑b₁).det = (b₀.toMatrix v).det
          have hd := Module.Basis.det_apply b₀ ⇑b₁
          rw [hd]
          rw [hb₁]
    _ = ‖exteriorPower.ιMulti ℝ n v‖ := hnrm.symm
end Commons.Lattice.Minkowski
