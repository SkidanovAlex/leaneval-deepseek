import Mathlib.Analysis.CStarAlgebra.Classes
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Submission.Commons.NumberTheory.NumberField.ncard_mahler_one_le

namespace Commons.NumberTheory.NumberField

/-- If `z : ℂ` is integral over `ℤ`, then the simple extension `ℚ(z)` is a finite-dimensional
`ℚ`-vector space. Indeed `z` is then integral (in particular algebraic) over `ℚ`, and the
`ℚ`-algebra generated by a single algebraic element is finite-dimensional over `ℚ`. -/
theorem finiteDimensional_adjoin_of_isIntegral (z : ℂ) (hz : IsIntegral ℤ z) :
    FiniteDimensional ℚ ↥(IntermediateField.adjoin ℚ ({z} : Set ℂ)) :=
  IntermediateField.adjoin.finiteDimensional (hz.tower_top (A := ℚ))

end Commons.NumberTheory.NumberField