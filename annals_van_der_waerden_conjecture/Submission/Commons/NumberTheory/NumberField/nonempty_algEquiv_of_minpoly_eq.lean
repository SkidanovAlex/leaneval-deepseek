import Mathlib.FieldTheory.Minpoly.Field

/-!
# Isomorphism of simple field extensions with equal minimal polynomials

If `K` and `L` are `ℚ`-algebras which are fields, generated as `ℚ`-algebras by the
elements `x` and `y` respectively, and `minpoly ℚ x = minpoly ℚ y`, then `K` and `L`
are isomorphic as `ℚ`-algebras.

The proof sends both `K` and `L` to the quotient of `ℚ[X]` by the principal ideal
generated by the respective minimal polynomial (using the first isomorphism theorem
for the evaluation map `ℚ[X] → K`, `X ↦ x`), and then identifies the two quotients
via the equality of the minimal polynomials.
-/

open Polynomial

namespace Commons.NumberTheory.NumberField

theorem nonempty_algEquiv_of_minpoly_eq {K L : Type*} [Field K] [Field L]
    [Algebra ℚ K] [Algebra ℚ L] {x : K} {y : L}
    (hx : Algebra.adjoin ℚ ({x} : Set K) = ⊤) (hy : Algebra.adjoin ℚ ({y} : Set L) = ⊤)
    (h : minpoly ℚ x = minpoly ℚ y) : Nonempty (K ≃ₐ[ℚ] L) := by
  -- The evaluation maps `ℚ[X] → K`, `X ↦ x` and `ℚ[X] → L`, `X ↦ y` are surjective,
  -- since `x` and `y` generate `K` and `L` as `ℚ`-algebras.
  have hf : Function.Surjective (Polynomial.aeval x : ℚ[X] →ₐ[ℚ] K) :=
    (AlgHom.range_eq_top _).mp ((Algebra.adjoin_singleton_eq_range_aeval ℚ x).symm.trans hx)
  have hg : Function.Surjective (Polynomial.aeval y : ℚ[X] →ₐ[ℚ] L) :=
    (AlgHom.range_eq_top _).mp ((Algebra.adjoin_singleton_eq_range_aeval ℚ y).symm.trans hy)
  -- Their kernels are the principal ideals generated by the minimal polynomials,
  -- which agree by hypothesis.
  have hker : RingHom.ker (Polynomial.aeval x : ℚ[X] →ₐ[ℚ] K) =
      RingHom.ker (Polynomial.aeval y : ℚ[X] →ₐ[ℚ] L) := by
    rw [minpoly.ker_aeval_eq_span_minpoly ℚ x, minpoly.ker_aeval_eq_span_minpoly ℚ y, h]
  -- Assemble: `K ≃ₐ ℚ[X]/ker x ≃ₐ ℚ[X]/ker y ≃ₐ L`.
  exact ⟨(Ideal.quotientKerAlgEquivOfSurjective hf).symm.trans
    ((Ideal.quotientEquivAlgOfEq ℚ hker).trans
      (Ideal.quotientKerAlgEquivOfSurjective hg))⟩

end Commons.NumberTheory.NumberField