open scoped NumberField IntermediateField
open Module NumberField Matrix

namespace Commons.NumberTheory.NumberField

/-- For a primitive integral element `α` of a number field, the discriminant of the
power basis generated by `α` differs from the field discriminant by a square. -/
theorem polynomial_discr_eq_mul_field_discr_sq {K : Type*} [Field K] [NumberField K]
    {α : NumberField.RingOfIntegers K}
    (hgen : IntermediateField.adjoin ℚ ({(α : K)} : Set K) = ⊤) :
    ∃ m : ℤ, Polynomial.discr (minpoly ℚ (α : K)) = m ^ 2 * NumberField.discr K := by
  classical
  have hx : IsIntegral ℚ (α : K) := by
    exact Algebra.IsSeparable.isIntegral (F := ℚ) (K := K) (α : K)
  have hgen_alg : Algebra.adjoin ℚ ({(α : K)} : Set K) = ⊤ := by
    exact Algebra.adjoin_eq_top_of_primitive_element
      ((Algebra.IsSeparable.isAlgebraic ℚ K).isAlgebraic (α : K)) hgen
  let pb : PowerBasis ℚ K := PowerBasis.ofAdjoinEqTop hx hgen_alg
  have hpb_discr : Polynomial.discr (minpoly ℚ pb.gen) = Algebra.discr ℚ pb.basis := by
    exact Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr (F := ℚ) (S := K) (pb := pb)
  let ι := Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)
  let bO : Basis ι ℤ (NumberField.RingOfIntegers K) := RingOfIntegers.basis K
  let b : ι → K := fun i => algebraMap (NumberField.RingOfIntegers K) K (bO i)
  have hb_int : b = NumberField.integralBasis K := by
    ext i
    simp [b, NumberField.integralBasis_apply, bO]
  have hb_discr : Algebra.discr ℚ b = (NumberField.discr K : ℚ) := by
    rw [hb_int]
    exact (NumberField.coe_discr K).symm
  have hcardι : Fintype.card ι = Fintype.card (Fin pb.dim) := by
    rw [← Module.finrank_eq_card_basis bO]
    rw [NumberField.RingOfIntegers.rank]
    rw [pb.finrank]
    simp
  let e : ι ≃ Fin pb.dim := Fintype.equivOfCardEq hcardι
  let bpow : ι → K := fun i => pb.basis (e i)
  have hbpow_discr : Algebra.discr ℚ bpow = Algebra.discr ℚ pb.basis := by
    dsimp [bpow]
    change Algebra.discr ℚ (pb.basis ∘ e) = Algebra.discr ℚ pb.basis
    simpa using (Algebra.discr_reindex (A := ℚ) pb.basis e.symm)
  have hpow_int : ∀ j : ι, IsIntegral ℤ (pb.gen ^ (e j).val) := by
    intro j
    have hα : pb.gen = (α : K) := by
      simp [pb, PowerBasis.ofAdjoinEqTop_gen]
    rw [hα]
    exact IsIntegral.pow (α.isIntegral_coe) _
  let P : Matrix ι ι ℤ := fun i j => (bO.repr ⟨pb.gen ^ (e j).val, hpow_int j⟩) i
  let Pℚ : Matrix ι ι ℚ := P.map (Int.castRingHom ℚ)
  have hbpow_eq : bpow = b ᵥ* Pℚ.map (algebraMap ℚ K) := by
    ext j
    dsimp [bpow, P, b]
    have hsum := bO.sum_repr ⟨pb.gen ^ (e j).val, hpow_int j⟩
    have hsum' : (∑ i : ι, b i * (bO.repr ⟨pb.gen ^ (e j).val, hpow_int j⟩ i : ℚ)) =
        pb.gen ^ (e j).val := by
      have h := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hsum
      have hrhs : (algebraMap (NumberField.RingOfIntegers K) K) ⟨pb.gen ^ (e j).val, hpow_int j⟩ =
          pb.gen ^ (e j).val := rfl
      simpa [map_sum, b, smul_eq_mul, mul_comm] using h.trans hrhs
    simp only [P, Pℚ, Matrix.vecMul, dotProduct, Matrix.map_apply, Matrix.map, b]
    simpa [mul_comm] using hsum'.symm
  have hdiscr_rel : Algebra.discr ℚ bpow = Pℚ.det ^ 2 * Algebra.discr ℚ b := by
    rw [hbpow_eq]
    exact Algebra.discr_of_matrix_vecMul b Pℚ
  refine ⟨P.det, ?_⟩
  have hpbgen : pb.gen = (α : K) := by
    simp [pb, PowerBasis.ofAdjoinEqTop_gen]
  rw [← hpbgen]
  rw [hpb_discr]
  rw [← hbpow_discr]
  rw [hdiscr_rel]
  rw [hb_discr]
  have hdet : Pℚ.det = (P.det : ℚ) := by
    dsimp [Pℚ]
    exact (RingHom.map_det (Int.castRingHom ℚ) P).symm
  rw [hdet]

theorem abs_discr_ge_23_of_finrank_three_of_discr_neg {K : Type*} [Field K] [NumberField K]
    (hfin : Module.finrank ℚ K = 3) (hneg : NumberField.discr K < 0) :
    23 ≤ |NumberField.discr K| := by
  classical
  by_contra hle
  have hDle : |NumberField.discr K| ≤ 22 := by omega
  have hDreal : |(NumberField.discr K : ℝ)| ≤ 22 := by exact_mod_cast hDle
  have hsqrt : Real.sqrt |(NumberField.discr K : ℝ)| ≤ Real.sqrt 22 :=
    Real.sqrt_le_sqrt hDreal
  have hsqrt22 : Real.sqrt 22 < 4.7 := by
    rw [Real.sqrt_lt' (by norm_num : (0 : ℝ) < 4.7)]
    norm_num
  have hpi : (3.14 : ℝ) < Real.pi := Real.pi_gt_d2
  have hvol : 4 * Real.sqrt |(NumberField.discr K : ℝ)| <
      2 * Real.pi * 1 * (Real.sqrt 3) ^ 2 := by
    norm_num [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
    nlinarith [hsqrt, hsqrt22, hpi]
  obtain ⟨α, hα0, hreal, hcomplex⟩ :=
    exists_nonzero_integer_lt_of_finrank_three_of_discr_neg_no_lt_one hfin hneg
      (A := 1) (B := Real.sqrt 3) (by norm_num) (by norm_num)
      (by norm_num [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]) hvol
  obtain ⟨a, b, c, hmin, ha_bound, hb_bound, hc, hroot⟩ :=
    minpoly_cubic_int_coeffs_of_integer_lt hfin hneg hα0 hreal hcomplex
  have hgood30 := Commons.Polynomial.cubic_root_lt_one_sqrt_three_of_coeff_bounds
    ha_bound hb_bound hc hroot
  have hx_int : IsIntegral ℚ (α : K) := by
    exact Algebra.IsSeparable.isIntegral (F := ℚ) (K := K) (α : K)
  have hmin_natDegree : (minpoly ℚ (α : K)).natDegree = 3 := by
    rw [hmin]
    compute_degree!
  have h_adjoin_finrank : Module.finrank ℚ (ℚ⟮(α : K)⟯) = 3 := by
    rw [IntermediateField.adjoin.finrank hx_int]
    exact hmin_natDegree
  have hgen : ℚ⟮(α : K)⟯ = ⊤ := by
    have hsimple := IntermediateField.isSimpleOrder_of_finrank_prime ℚ K
      (by simpa [hfin] using Nat.prime_three)
    refine (hsimple.eq_bot_or_eq_top (ℚ⟮(α : K)⟯)).resolve_left ?_
    intro hbot
    rw [hbot] at h_adjoin_finrank
    norm_num at h_adjoin_finrank
  let f : Polynomial ℚ := Polynomial.X ^ 3 + Polynomial.C (a : ℚ) * Polynomial.X ^ 2 +
    Polynomial.C (b : ℚ) * Polynomial.X + Polynomial.C (c : ℚ)
  have hmin_f : minpoly ℚ (α : K) = f := by simpa [f] using hmin
  have hf_irr : Irreducible f := by
    rw [← hmin_f]
    exact minpoly.irreducible hx_int
  letI : Fact (Irreducible f) := ⟨hf_irr⟩
  by_cases hbad : (a, b, c) ∈ [(-2,0,2), (-1,1,1), (-1,3,-1), (1,1,-1), (1,3,1), (2,0,-2)]
  · have hbad6 : 23 ≤ |NumberField.discr (AdjoinRoot f)| := by
      exact Commons.Polynomial.abs_discr_ge_23_of_adjoinRoot_cubic_bad6 a b c hbad
    have hx_alg : Algebra.adjoin ℚ ({(α : K)} : Set K) = ⊤ := by
      exact Algebra.adjoin_eq_top_of_primitive_element
        ((Algebra.IsSeparable.isAlgebraic ℚ K).isAlgebraic (α : K)) hgen
    let e1 : AdjoinRoot (minpoly ℚ (α : K)) ≃ₐ[ℚ] ℚ⟮(α : K)⟯ :=
      IntermediateField.adjoinRootEquivAdjoin ℚ hx_int
    let e2 : ℚ⟮(α : K)⟯ ≃ₐ[ℚ] (⊤ : IntermediateField ℚ K) :=
      IntermediateField.equivOfEq hgen
    let e3 : (⊤ : IntermediateField ℚ K) ≃ₐ[ℚ] K := IntermediateField.topEquiv
    have heq : AdjoinRoot (minpoly ℚ (α : K)) = AdjoinRoot f := by rw [hmin_f]
    let e0 : AdjoinRoot (minpoly ℚ (α : K)) ≃ₐ[ℚ] AdjoinRoot f :=
      AdjoinRoot.algEquivOfEq ℚ (minpoly ℚ (α : K)) f hmin_f
    let e : AdjoinRoot f ≃ₐ[ℚ] K :=
      e0.symm.trans (e1.trans (e2.trans e3))
    have hdiscrK : NumberField.discr K = NumberField.discr (AdjoinRoot f) := by
      exact (NumberField.discr_eq_discr_of_algEquiv (K := AdjoinRoot f) (L := K) e).symm
    rw [← hdiscrK] at hbad6
    omega
  · -- non-bad case
    obtain ⟨m, hm⟩ := polynomial_discr_eq_mul_field_discr_sq hgen
    have hm_f : Polynomial.discr f = (m ^ 2 * NumberField.discr K : ℚ) := by
      rw [hmin_f] at hm
      exact_mod_cast hm
    -- finite check
    have ha1 : -4 ≤ a := (abs_le.mp ha_bound).1
    have ha2 : a ≤ 4 := (abs_le.mp ha_bound).2
    have hb1 : -6 ≤ b := (abs_le.mp hb_bound).1
    have hb2 : b ≤ 6 := (abs_le.mp hb_bound).2
    have hgood24 : (a, b, c) ∈
        [(-2,1,1), (-2,1,2), (-2,2,1), (-2,3,-1), (-1,0,1), (-1,1,2), (-1,2,-1), (-1,2,1), (-1,3,-2), (0,1,-1), (0,1,1), (0,2,-2), (0,2,-1), (0,2,1), (0,2,2), (1,0,-1), (1,1,-2), (1,2,-1), (1,2,1), (1,3,2), (2,1,-2), (2,1,-1), (2,2,-1), (2,3,1)] :=
      Commons.Polynomial.good24_of_good30_not_bad6 a b c hgood30 hbad
    have hm_f' : Polynomial.discr (Polynomial.X ^ 3 + Polynomial.C (a : ℚ) * Polynomial.X ^ 2 +
        Polynomial.C (b : ℚ) * Polynomial.X + Polynomial.C (c : ℚ)) =
        ((m ^ 2 * NumberField.discr K : ℤ) : ℚ) := by
      simpa [f, Int.cast_mul, Int.cast_pow] using hm_f
    exact Commons.Polynomial.no_small_discr_square_divisor_of_cubic_good24 a b c hgood24 hneg hDle hm_f'

end Commons.NumberTheory.NumberField
