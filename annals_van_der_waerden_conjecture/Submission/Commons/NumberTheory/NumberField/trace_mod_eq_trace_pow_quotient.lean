open scoped NumberField BigOperators
set_option autoImplicit false
set_option maxHeartbeats 0
set_option linter.style.haveILetI false

noncomputable section

namespace Commons.NumberTheory.NumberField

variable {K : Type*} [Field K] [NumberField K]

/-- The prime of ℤ generated by a rational prime `p`. -/
abbrev p₀ (p : ℕ) : Ideal ℤ := Ideal.span ({(p : ℤ)} : Set ℤ)

lemma p₀_ne_bot (p : ℕ) [Fact (Nat.Prime p)] : p₀ p ≠ ⊥ := by
  rw [p₀, ne_eq, Ideal.span_singleton_eq_bot]
  exact_mod_cast (Nat.Prime.ne_zero (Fact.out : Nat.Prime p))

lemma p₀_isMaximal (p : ℕ) [Fact (Nat.Prime p)] : (p₀ p).IsMaximal := by
  rw [p₀]
  exact (Nat.prime_iff_prime_int.mp (Fact.out : Nat.Prime p)).isMaximal_span_singleton

lemma map_le_pow_ramificationIdx (p : Ideal ℤ) (P : Ideal (𝓞 K))
    (hp0 : p ≠ ⊥) [P.IsPrime] [P.LiesOver p] :
    Ideal.map (algebraMap ℤ (𝓞 K)) p ≤ P ^ P.ramificationIdx ℤ := by
  have heq : Ideal.ramificationIdx' p P = P.ramificationIdx ℤ := by
    exact Ideal.ramificationIdx'_eq_ramificationIdx (p := p) (q := P) hp0
  rw [← heq]
  simpa using (Ideal.le_pow_ramificationIdx' (R := ℤ) (S := 𝓞 K) (p := p) (P := P))

/-- canonical algebra structure on `(𝓞 K) ⧸ P^e` over `ℤ ⧸ p` -/
instance instAlgebraQuotRam (p : Ideal ℤ) (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver p] :
    Algebra (ℤ ⧸ p) ((𝓞 K) ⧸ P ^ P.ramificationIdx ℤ) :=
  Ideal.Quotient.algebraQuotientOfLEComap (by
    intro x hx
    rw [Ideal.mem_comap]
    by_cases hp0 : p = ⊥
    · rw [hp0] at hx
      have hx0 : x = 0 := by simpa using hx
      simp [hx0]
    · exact (map_le_pow_ramificationIdx p P hp0) (Ideal.mem_map_of_mem (algebraMap ℤ (𝓞 K)) hx))

theorem trace_mod_eq_trace_pow_quotient {K : Type*} [Field K] [NumberField K]
    (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (NumberField.RingOfIntegers K)) [P.IsMaximal]
    [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    {Q : Ideal (NumberField.RingOfIntegers K)} (hsup : P ⊔ Q = ⊤)
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (NumberField.RingOfIntegers K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (z y : NumberField.RingOfIntegers K) (hyP : y - z ∈ P ^ P.ramificationIdx ℤ)
    (hyQ : y ∈ Q) :
    Algebra.trace (ℤ ⧸ (Ideal.span ({(p : ℤ)} : Set ℤ)))
        ((NumberField.RingOfIntegers K) ⧸
          (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (NumberField.RingOfIntegers K)))
        (Ideal.Quotient.mk _ y) =
      Algebra.trace (ℤ ⧸ (Ideal.span ({(p : ℤ)} : Set ℤ)))
        ((NumberField.RingOfIntegers K) ⧸ P ^ P.ramificationIdx ℤ)
        (Ideal.Quotient.mk _ z) := by
  classical
  let I : Ideal (𝓞 K) := (p₀ p).map (algebraMap ℤ (𝓞 K))
  let J : Ideal (𝓞 K) := P ^ P.ramificationIdx ℤ
  haveI : (p₀ p).IsMaximal := p₀_isMaximal p
  letI : Field (ℤ ⧸ p₀ p) := Ideal.Quotient.field (p₀ p)
  -- algebra instance for the `Q`-quotient
  have hI_le_Q : I ≤ Q := by
    have hIeq : I = P ^ P.ramificationIdx ℤ * Q := by simpa [I, p₀] using hspl
    rw [hIeq]
    exact Ideal.mul_le_right
  letI : Algebra (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ Q) := Ideal.Quotient.algebraQuotientOfLEComap
    (Ideal.map_le_iff_le_comap.mp (by simpa [I] using hI_le_Q))
  haveI : IsScalarTower ℤ (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ Q) := IsScalarTower.of_algebraMap_eq' rfl
  haveI : Module.Finite (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ Q) :=
    Module.Finite.of_restrictScalars_finite ℤ (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ Q)
  haveI : IsScalarTower ℤ (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ J) := IsScalarTower.of_algebraMap_eq' rfl
  haveI : Module.Finite (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ J) :=
    Module.Finite.of_restrictScalars_finite ℤ (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ J)
  -- comaximality of J and Q
  have hJQ : J ⊔ Q = ⊤ := by
    simpa [J] using (Ideal.pow_sup_eq_top (n := P.ramificationIdx ℤ) hsup)
  have hJQ_cop : IsCoprime J Q := (Ideal.isCoprime_iff_sup_eq).2 hJQ
  -- CRT algebra equivalence
  let eRing : ((𝓞 K) ⧸ I) ≃+* (((𝓞 K) ⧸ J) × ((𝓞 K) ⧸ Q)) :=
    (Ideal.quotEquivOfEq hspl).trans (Ideal.quotientMulEquivQuotientProd J Q hJQ_cop)
  have eRing_mk (x : 𝓞 K) :
      eRing (Ideal.Quotient.mk I x) = (Ideal.Quotient.mk J x, Ideal.Quotient.mk Q x) := by
    change ((Ideal.quotEquivOfEq hspl).trans (J.quotientMulEquivQuotientProd Q hJQ_cop))
      (Ideal.Quotient.mk I x) = (Ideal.Quotient.mk J x, Ideal.Quotient.mk Q x)
    rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
    apply Prod.ext
    · rw [Ideal.quotientMulEquivQuotientProd_fst]
      exact Ideal.Quotient.factor_mk Ideal.mul_le_left x
    · rw [Ideal.quotientMulEquivQuotientProd_snd]
      exact Ideal.Quotient.factor_mk Ideal.mul_le_right x
  let e : ((𝓞 K) ⧸ I) ≃ₐ[ℤ ⧸ p₀ p] (((𝓞 K) ⧸ J) × ((𝓞 K) ⧸ Q)) :=
    { __ := eRing,
      commutes' := by
        intro r
        rcases Ideal.Quotient.mk_surjective r with ⟨t, rfl⟩
        change eRing (Ideal.Quotient.mk I ((algebraMap ℤ (𝓞 K)) t)) =
          ((Ideal.Quotient.mk J ((algebraMap ℤ (𝓞 K)) t)),
            (Ideal.Quotient.mk Q ((algebraMap ℤ (𝓞 K)) t)))
        rw [eRing_mk] }
  have hE : e (Ideal.Quotient.mk I y) = (Ideal.Quotient.mk J z, (0 : (𝓞 K) ⧸ Q)) := by
    have he0 : e (Ideal.Quotient.mk I y) = (Ideal.Quotient.mk J y, Ideal.Quotient.mk Q y) := by
      change eRing (Ideal.Quotient.mk I y) = (Ideal.Quotient.mk J y, Ideal.Quotient.mk Q y)
      exact eRing_mk y
    rw [he0]
    apply Prod.ext
    · exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem y z).2 hyP
    · exact (Ideal.Quotient.eq_zero_iff_mem).2 hyQ
  calc
    Algebra.trace (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ I) (Ideal.Quotient.mk I y)
        = Algebra.trace (ℤ ⧸ p₀ p) (((𝓞 K) ⧸ J) × ((𝓞 K) ⧸ Q)) (e (Ideal.Quotient.mk I y)) := by
          rw [← Algebra.trace_eq_of_algEquiv e]
    _ = Algebra.trace (ℤ ⧸ p₀ p) (((𝓞 K) ⧸ J) × ((𝓞 K) ⧸ Q))
          ((Ideal.Quotient.mk J z), (0 : (𝓞 K) ⧸ Q)) := by
          rw [hE]
    _ = Algebra.trace (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ J) (Ideal.Quotient.mk J z) +
        Algebra.trace (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ Q) 0 := by
          rw [Algebra.trace_prod_apply]
    _ = Algebra.trace (ℤ ⧸ p₀ p) ((𝓞 K) ⧸ J) (Ideal.Quotient.mk J z) := by
          simp
    _ = Algebra.trace (ℤ ⧸ (Ideal.span ({(p : ℤ)} : Set ℤ)))
        ((NumberField.RingOfIntegers K) ⧸ P ^ P.ramificationIdx ℤ)
        (Ideal.Quotient.mk _ z) := by
          rfl

end Commons.NumberTheory.NumberField