attribute [local instance] Ideal.Quotient.field

variable {K : Type*} [Field K] [NumberField K]

/-- The prime of ℤ generated by a rational prime `p`. -/
def p₀ (p : ℕ) : Ideal ℤ := Ideal.span ({(p : ℤ)} : Set ℤ)

lemma p₀_ne_bot (p : ℕ) [Fact (Nat.Prime p)] : p₀ p ≠ ⊥ := by
  rw [p₀, ne_eq, Ideal.span_singleton_eq_bot]
  exact_mod_cast (Nat.Prime.ne_zero (Fact.out : Nat.Prime p))

lemma p₀_isMaximal (p : ℕ) [Fact (Nat.Prime p)] : (p₀ p).IsMaximal := by
  rw [p₀]
  exact (Nat.prime_iff_prime_int.mp (Fact.out : Nat.Prime p)).isMaximal_span_singleton

/-- Splitting of `(p)` in the ring of integers, isolating the prime `P`. -/
lemma p₀_map_eq_pow_mul (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (p₀ p)] :
    ∃ Q : Ideal (𝓞 K), P ⊔ Q = ⊤ ∧
      (p₀ p).map (algebraMap ℤ (𝓞 K)) = P ^ P.ramificationIdx ℤ * Q := by
  classical
  let I : Ideal (𝓞 K) := (p₀ p).map (algebraMap ℤ (𝓞 K))
  have hIne : I ≠ ⊥ := by
    dsimp [I]
    exact (Ideal.map_eq_bot_iff_of_injective
      (FaithfulSMul.algebraMap_injective ℤ (𝓞 K))).not.mpr (p₀_ne_bot p)
  have hE : (normalizedFactors I).count P = P.ramificationIdx ℤ := by
    dsimp [I]
    exact (Ideal.IsDedekindDomain.ramificationIdx_eq_normalizedFactors_count (p := p₀ p) (q := P)
      (by simpa [I] using hIne)).symm
  rcases Ideal.eq_prime_pow_mul_coprime hIne P with ⟨Q, hsup, hI⟩
  refine ⟨Q, hsup, ?_⟩
  dsimp [I] at hI ⊢
  rw [hI]
  exact congrArg (fun c : ℕ => P ^ c * Q) hE

end TameDifferent

open TameDifferent in
/-- If `P^e` divides the different ideal, then the trace of every element of the fractional
ideal `(P^e)⁻¹` is an integer. -/
lemma intTrace_mem_of_dvd_pow_different {K : Type*} [Field K] [NumberField K]
    (P : Ideal (𝓞 K)) [P.IsPrime] (hPbot : P ≠ ⊥)
    (e : ℕ) (he : e ≠ 0) (hdiv : P ^ e ∣ differentIdeal ℤ (𝓞 K)) (x : K)
    (hx : x ∈ ((P ^ e : Ideal (𝓞 K))⁻¹ : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) :
    ∃ z : ℤ, (algebraMap ℤ ℚ z) = Algebra.trace ℚ K x := by
  classical
  have hle : differentIdeal ℤ (𝓞 K) ≤ P ^ e := (Ideal.dvd_iff_le).mp hdiv
  have hI : (P ^ e : Ideal (𝓞 K)) ≠ ⊥ := pow_ne_zero e hPbot
  have htr := (differentialIdeal_le_iff (A := ℤ) (K := ℚ) (L := K) (B := 𝓞 K)
    (I := P ^ e) hI).mp hle
  -- htr : map trace ≤ 1
  let M : Submodule ℤ K := ((((P ^ e : Ideal (𝓞 K))⁻¹ : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)
      : Submodule (𝓞 K) K).restrictScalars ℤ)
  have hxmem : x ∈ M := by
    simpa [M, FractionalIdeal.mem_coe] using hx
  have htrace : Algebra.trace ℚ K x ∈ (1 : Submodule ℤ ℚ) := by
    exact htr ⟨x, hxmem, rfl⟩
  rw [Submodule.one_eq_range] at htrace
  exact htrace

open TameDifferent in
/-- If `(p)` splits as `P^e · Q` and `y ∈ Q` has `p ∤ intTrace y`, then `P^e` does not
divide the different ideal. -/
lemma not_dvd_pow_of_witness {K : Type*} [Field K] [NumberField K]
    (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsMaximal] [P.LiesOver (p₀ p)]
    {Q : Ideal (𝓞 K)} (hsup : P ⊔ Q = ⊤)
    (hspl : (p₀ p).map (algebraMap ℤ (𝓞 K)) = P ^ P.ramificationIdx ℤ * Q)
    (y : 𝓞 K) (hyQ : (y : 𝓞 K) ∈ Q)
    (hy : ¬ (p : ℤ) ∣ Algebra.intTrace ℤ (𝓞 K) y) :
    ¬ P ^ P.ramificationIdx ℤ ∣ differentIdeal ℤ (𝓞 K) := by
  classical
  intro hdiv
  haveI : P.IsPrime := (inferInstance : P.IsMaximal).isPrime
  let e : ℕ := P.ramificationIdx ℤ
  let x : K := (y : K) * ((p : K)⁻¹)
  have hpK0 : (p : K) ≠ 0 := by exact_mod_cast (Nat.Prime.ne_zero (Fact.out : Nat.Prime p))
  have hpℚ0 : (p : ℚ) ≠ 0 := by exact_mod_cast (Nat.Prime.ne_zero (Fact.out : Nat.Prime p))
  have he0 : e ≠ 0 := (Ideal.ramificationIdx_pos (q := P) (R := ℤ)).ne'
  have hPbot : P ≠ ⊥ := by
    intro hz
    apply p₀_ne_bot p
    calc p₀ p = P.under ℤ := (Ideal.LiesOver.over (A := ℤ) (P := P))
      _ = ⊥ := by
        rw [hz]
        ext x
        constructor
        · intro hx
          exact (FaithfulSMul.algebraMap_injective ℤ (𝓞 K)) (by simpa using hx)
        · intro hx
          simp [hx]
  have hyP : ∀ m ∈ P ^ e, (y : 𝓞 K) * m ∈ (p₀ p).map (algebraMap ℤ (𝓞 K)) := by
    intro m hm
    have hmem : (y : 𝓞 K) * m ∈ Q * (P ^ e) := Ideal.mul_mem_mul hyQ hm
    rwa [mul_comm, ← hspl] at hmem
  have hPef : ((P ^ e : Ideal (𝓞 K)) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) ≠ 0 := by
    simpa using (pow_ne_zero e hPbot)
  have hx : x ∈ ((P ^ e : Ideal (𝓞 K))⁻¹ : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
    apply (FractionalIdeal.mem_inv_iff
      (I := ((P ^ e : Ideal (𝓞 K)) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) hPef).mpr
    intro a ha
    rcases (FractionalIdeal.mem_coeIdeal (S := nonZeroDivisors (𝓞 K)) (x := a)
      (I := P ^ e)).mp ha with ⟨m, hm, rfl⟩
    have hyPm : (y : 𝓞 K) * m ∈ (p₀ p).map (algebraMap ℤ (𝓞 K)) := hyP m hm
    rcases (Ideal.mem_span_singleton.mp (by simpa [p₀, Ideal.map_span] using hyPm)) with ⟨c, hc⟩
    have hpK : (p : K) ≠ 0 := hpK0
    have hcK : ((y * m : 𝓞 K) : K) = (p : K) * (c : K) := by
      calc
        ((y * m : 𝓞 K) : K) = ((↑p * c : 𝓞 K) : K) := congrArg (algebraMap (𝓞 K) K) hc
        _ = ((↑p : 𝓞 K) : K) * (c : K) := by simp
        _ = (p : K) * (c : K) := by
          congr 1
    have hx' : x * (m : K) = (c : K) := by
      dsimp [x]
      calc
        ((y : K) * (p : K)⁻¹) * (m : K) = ((y : K) * (m : K)) * (p : K)⁻¹ := by ring
        _ = ((y * m : 𝓞 K) : K) * (p : K)⁻¹ := by
          congr 1
        _ = ((p : K) * (c : K)) * (p : K)⁻¹ := by rw [hcK]
        _ = (c : K) := by
          field_simp [hpK]
    refine (FractionalIdeal.mem_one_iff (P := K) (R := 𝓞 K) (S := nonZeroDivisors (𝓞 K))).mpr ⟨c, hx'.symm⟩
  have htr := intTrace_mem_of_dvd_pow_different (K := K) P hPbot e he0 hdiv x hx
  rcases htr with ⟨z, hz⟩
  -- hz : (z : ℚ) = trace x
  have htrY : Algebra.trace ℚ K (y : K) = (Algebra.intTrace ℤ (𝓞 K) y : ℚ) :=
    (Algebra.algebraMap_intTrace (A := ℤ) (K := ℚ) (L := K) (B := 𝓞 K) y).symm
  have hpinv : ((p : K)⁻¹) = algebraMap ℚ K ((p : ℚ)⁻¹) := by
    apply mul_left_cancel₀ hpK0
    calc
      (p : K) * (p : K)⁻¹ = 1 := mul_inv_cancel₀ hpK0
      _ = (p : K) * algebraMap ℚ K ((p : ℚ)⁻¹) := by
        have hpcast : (p : K) = algebraMap ℚ K (p : ℚ) := by norm_num
        rw [hpcast, ← map_mul]
        rw [mul_inv_cancel₀ hpℚ0]
        simp
  have hsmul : x = ((p : ℚ)⁻¹ : ℚ) • (y : K) := by
    dsimp [x]
    rw [hpinv, mul_comm, ← Algebra.smul_def]
  have htrX : Algebra.trace ℚ K x = ((p : ℚ)⁻¹) * Algebra.trace ℚ K (y : K) := by
    rw [hsmul, LinearMap.map_smul, smul_eq_mul]
  have hmain : (p : ℚ) * (z : ℚ) = (Algebra.intTrace ℤ (𝓞 K) y : ℚ) := by
    calc
      (p : ℚ) * (z : ℚ) = (p : ℚ) * Algebra.trace ℚ K x := by
        exact congrArg (fun t : ℚ => (p : ℚ) * t) hz
      _ = Algebra.trace ℚ K (y : K) := by
        rw [htrX, htrY]
        field_simp [hpℚ0]
      _ = (Algebra.intTrace ℤ (𝓞 K) y : ℚ) := htrY
  refine hy ?_
  -- show (p : ℤ) ∣ intTrace y : ∃ c, intTrace y = p * c
  refine ⟨z, ?_⟩
  have hz' : ((p * z : ℤ) : ℚ) = (Algebra.intTrace ℤ (𝓞 K) y : ℚ) := by
    calc
      ((p * z : ℤ) : ℚ) = ((p : ℤ) : ℚ) * (z : ℚ) := by rw [Int.cast_mul]
      _ = (p : ℚ) * (z : ℚ) := by norm_num
      _ = (Algebra.intTrace ℤ (𝓞 K) y : ℚ) := hmain
  exact_mod_cast hz'.symm


attribute [local instance] Ideal.Quotient.field

noncomputable instance p₀IsMaximalInst (p : ℕ) [Fact (Nat.Prime p)] : (p₀ p).IsMaximal :=
  p₀_isMaximal p

namespace TracePow

attribute [local instance] Ideal.Quotient.field

/-- The endomorphism induced on the quotient `V ⧸ W` by an endomorphism `f` that preserves `W`. -/
def mapQEnd {K : Type*} [Field K] {V : Type*} [AddCommGroup V] [Module K V]
    (W : Submodule K V) (f : V →ₗ[K] V) (hf : ∀ x ∈ W, f x ∈ W) :
    V ⧸ W →ₗ[K] V ⧸ W :=
  W.mapQ W f (by
    intro x hx
    exact hf x hx)

lemma trace_add {K : Type*} [Field K] {V : Type*} [AddCommGroup V] [Module K V]
    [Module.Free K V] [Module.Finite K V]
    (W : Submodule K V) [Module.Finite K W] (f : V →ₗ[K] V)
    (hf : ∀ x ∈ W, f x ∈ W) :
    LinearMap.trace K V f =
      LinearMap.trace K W (f.restrict hf) +
        LinearMap.trace K (V ⧸ W) (mapQEnd W f hf) := by
  classical
  let Q : Type _ := V ⧸ W
  let mkQ : V →ₗ[K] Q := W.mkQ
  let ιQ := Module.Free.ChooseBasisIndex K Q
  let bQ : Module.Basis ιQ K Q := Module.Free.chooseBasis K Q
  haveI : Fintype ιQ := Module.Free.ChooseBasisIndex.fintype K Q
  let c : ιQ → V := fun j => Classical.choose (Submodule.mkQ_surjective W (bQ j))
  have hc (j : ιQ) : mkQ (c j) = bQ j := by
    exact Classical.choose_spec (Submodule.mkQ_surjective W (bQ j))
  let s : Q →ₗ[K] V := bQ.constr K c
  have hms : mkQ.comp s = LinearMap.id := by
    apply bQ.ext
    intro j
    simp [s, hc]
  have hmsq (q : Q) : mkQ (s q) = q := by
    simpa [LinearMap.comp_apply] using (LinearMap.congr_fun hms q)
  have hker : ∀ {v : V}, mkQ v = 0 → v ∈ W := by
    intro v hv
    rw [← LinearMap.mem_ker] at hv
    rwa [Submodule.ker_mkQ] at hv
  have hms' : ∀ (v : V), v - s (mkQ v) ∈ W := by
    intro v
    apply hker
    rw [map_sub, hmsq]
    simp
  let e : (W × Q) ≃ₗ[K] V :=
    { toLinearMap := (W.subtype.coprod s)
      invFun := fun v => (⟨v - s (mkQ v), hms' v⟩, mkQ v)
      left_inv := by
        intro wq
        rcases wq with ⟨w, q⟩
        have hmw : mkQ (w : V) = 0 := by
          rw [← LinearMap.mem_ker]
          rw [Submodule.ker_mkQ]
          exact w.2
        have hm : mkQ ((w : V) + s q) = q := by
          rw [map_add, hmsq, hmw, zero_add]
        apply Prod.ext
        · change (⟨(w : V) + s q - s (mkQ ((w : V) + s q)), hms' ((w : V) + s q)⟩ : W) = w
          ext
          change ((w : V) + s q) - s (mkQ ((w : V) + s q)) = (w : V)
          rw [hm]
          abel
        · change mkQ ((w : V) + s q) = q
          exact hm
      right_inv := by
        intro v
        simp [LinearMap.coprod_apply] }
  let C : Q →ₗ[K] Q := mapQEnd W f hf
  have hmkQf (x : V) : mkQ (f x) = C (mkQ x) := by
    change Submodule.Quotient.mk (f x) =
      (W.mapQ W f (by intro x hx; exact hf x hx)) (Submodule.Quotient.mk x)
    rw [Submodule.mapQ_apply]
  have hψ : ∀ q : Q, (f.comp s - s.comp C) q ∈ W := by
    intro q
    apply hker
    simp only [LinearMap.sub_apply, LinearMap.comp_apply]
    rw [map_sub]
    have h1 : mkQ (f (s q)) = C q := by rw [hmkQf, hmsq]
    have h2 : mkQ (s (C q)) = C q := hmsq (C q)
    rw [h1, h2]
    simp
  let ψ0 : Q →ₗ[K] W := (LinearMap.codRestrict W (f.comp s - s.comp C) hψ)
  let N0 : (W × Q) →ₗ[K] W × Q :=
    { toFun := fun wq => (ψ0 wq.2, 0)
      map_add' := by
        intro x y
        ext <;> simp
      map_smul' := by
        intro a x
        ext <;> simp }
  let g : (W × Q) →ₗ[K] W × Q :=
    ((e.symm : V →ₗ[K] W × Q).comp f).comp (e : W × Q →ₗ[K] V)
  have htr : LinearMap.trace K V f = LinearMap.trace K (W × Q) g := by
    have hc' : e.conj g = f := by
      ext x
      simp [g]
    rw [← LinearMap.trace_conj' (f := g) (e := e), hc']
  have hN : N0 * N0 = 0 := by
    apply LinearMap.ext
    intro x
    ext <;> simp [N0]
  have htrN : LinearMap.trace K (W × Q) N0 = 0 := by
    have hnil : IsNilpotent (N0 : (W × Q) →ₗ[K] W × Q) := ⟨2, by simpa [pow_two, N0] using hN⟩
    simpa using (LinearMap.isNilpotent_trace_of_isNilpotent (R := K) (M := W × Q) (f := N0) hnil)
  have hg : g = (f.restrict hf).prodMap C + N0 := by
    apply LinearMap.ext
    intro wq
    rcases wq with ⟨w, q⟩
    apply Prod.ext
    · apply Subtype.ext
      have hmk : mkQ (f ((w : V)) + f (s q)) = C q := by
        rw [map_add]
        have hmw : mkQ (w : V) = 0 := by
          rw [← LinearMap.mem_ker]
          rw [Submodule.ker_mkQ]
          exact w.2
        rw [hmkQf, hmkQf, hmw, map_zero, hmsq]
        simp
      simp [g, e, N0, ψ0, hmk, hmsq]
      abel
    · -- snd
      simp [g, e, N0, ψ0, C]
      have hmw : mkQ (w : V) = 0 := by
        rw [← LinearMap.mem_ker]
        rw [Submodule.ker_mkQ]
        exact w.2
      rw [hmkQf, hmkQf, hmw, map_zero, hmsq]
      simpa [C]
  calc
    LinearMap.trace K V f = LinearMap.trace K (W × Q) g := htr
    _ = LinearMap.trace K (W × Q) ((f.restrict hf).prodMap C + N0) := by rw [hg]
    _ = LinearMap.trace K (W × Q) ((f.restrict hf).prodMap C) + LinearMap.trace K (W × Q) N0 := by
      exact (LinearMap.trace K (W × Q)).map_add ((f.restrict hf).prodMap C) N0
    _ = LinearMap.trace K W (f.restrict hf) + LinearMap.trace K Q C := by
      rw [htrN, add_zero, LinearMap.trace_prodMap']
    _ = LinearMap.trace K W (f.restrict hf) +
        LinearMap.trace K (V ⧸ W) (mapQEnd W f hf) := by rfl


/-- Trace step along an injective inclusion: if `f` restricted to the image of `ι` corresponds to
`g`, then the trace on `N` is the trace on `M` plus the trace on the quotient. -/
lemma trace_step_of_incl {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module K M]
    [Module.Finite K M]
    {N : Type*} [AddCommGroup N] [Module K N] [Module.Finite K N]
    (ι : M →ₗ[K] N) (hι : Function.Injective ι)
    (g : M →ₗ[K] M) (f : N →ₗ[K] N)
    (hcomp : f.comp ι = ι.comp g)
    (hf : ∀ x ∈ ι.range, f x ∈ ι.range) :
    LinearMap.trace K N f =
      LinearMap.trace K M g +
        LinearMap.trace K (N ⧸ ι.range) (mapQEnd (ι.range) f hf) := by
  classical
  let e : M ≃ₗ[K] ↥ι.range := LinearEquiv.ofInjective ι hι
  have hconj : e.conj g = f.restrict hf := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ((e.conj g) x : N) = ((f.restrict hf) x : N)
    rw [LinearEquiv.conj_apply]
    change ((e ((g ((e.symm x)))) : N)) = (f x.1)
    obtain ⟨m, hm⟩ := (LinearMap.mem_range.mp x.2)
    have hx_eq : x = e m := by
      ext; exact hm.symm
    have hesm : e.symm x = m := by rw [hx_eq, LinearEquiv.symm_apply_apply]
    rw [hesm]
    change (e (g m) : N) = f x.1
    rw [← hm]
    have ev (y : M) : (e y : N) = ι y := by rfl
    rw [ev]
    have hc : f (ι m) = ι (g m) := by
      simpa [LinearMap.comp_apply] using congrArg (fun φ : M →ₗ[K] N => φ m) hcomp
    exact hc.symm
  calc
    LinearMap.trace K N f
        = LinearMap.trace K ↥ι.range (f.restrict hf) +
            LinearMap.trace K (N ⧸ ι.range) (mapQEnd (ι.range) f hf) := by
            exact trace_add (K := K) (V := N) (W := ι.range) (f := f) (hf := hf)
    _ = LinearMap.trace K M g +
            LinearMap.trace K (N ⧸ ι.range) (mapQEnd (ι.range) f hf) := by
            congr 1
            rw [← hconj]
            exact LinearMap.trace_conj' (f := g) (e := e)


/-- Trace is invariant under conjugation by a bijective linear map. -/
lemma trace_eq_of_conj_by_bijective {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module K M]
    {N : Type*} [AddCommGroup N] [Module K N]
    (φ : M →ₗ[K] N) (hφ : Function.Bijective φ) (g : M →ₗ[K] M) (f : N →ₗ[K] N)
    (h : f.comp φ = φ.comp g) : LinearMap.trace K N f = LinearMap.trace K M g := by
  classical
  let e : M ≃ₗ[K] N := LinearEquiv.ofBijective φ hφ
  have hconj : e.conj g = f := by
    apply LinearMap.ext
    intro y
    have hy : φ (e.symm y) = y := by
      simpa [e] using (e.apply_symm_apply y)
    calc
      (e.conj g) y = e (g (e.symm y)) := by
        rw [LinearEquiv.conj_apply]
        rfl
      _ = φ (g (e.symm y)) := by rfl
      _ = f (φ (e.symm y)) := by
        have hx : f (φ (e.symm y)) = φ (g (e.symm y)) := by
          simpa [LinearMap.comp_apply] using congrArg
            (fun ψ : M →ₗ[K] N => ψ (e.symm y)) h
        exact hx.symm
      _ = f y := by rw [hy]
  rw [← hconj]
  exact LinearMap.trace_conj' (f := g) (e := e)

section RamIdx

variable {R : Type*} [CommRing R] {S : Type*} [CommRing S] [Algebra R S]
variable [IsDomain R] [IsDedekindDomain S] [Module.IsTorsionFree R S] [Module.Finite R S]

abbrev AOf (p : Ideal R) (P : Ideal S) := S ⧸ P ^ p.ramificationIdx' P
abbrev BOf (p : Ideal R) (P : Ideal S) := S ⧸ P
def MIdx (p : Ideal R) (P : Ideal S) (i : ℕ) : Ideal (AOf p P) :=
  Ideal.map (Ideal.Quotient.mk (P ^ p.ramificationIdx' P)) (P ^ i)
abbrev grd (p : Ideal R) (P : Ideal S) (i : ℕ) := ↥(MIdx p P i)

variable (p : Ideal R) [p.IsMaximal] (P : Ideal S) [P.IsMaximal] [P.LiesOver p]

abbrev zA (z : S) : AOf p P := Ideal.Quotient.mk (P ^ p.ramificationIdx' P) z
abbrev zB (z : S) : BOf p P := Ideal.Quotient.mk P z

/-- The old ramification index is positive. -/
lemma eRam_ne_zero (hp : p ≠ ⊥) : p.ramificationIdx' P ≠ 0 := by
  letI : P.IsPrime := Ideal.IsMaximal.isPrime' P
  have hpos : 0 < P.ramificationIdx R := Ideal.ramificationIdx_pos P R
  have heq : p.ramificationIdx' P = P.ramificationIdx R :=
    Ideal.ramificationIdx'_eq_ramificationIdx p P hp
  rw [heq]
  exact ne_of_gt hpos

/-- The quotient `A` is finite over the residue field. -/
lemma moduleFiniteA : Module.Finite (R ⧸ p) (AOf p P) := by
  let A := AOf p P
  haveI : IsScalarTower R (R ⧸ p) A :=
    IsScalarTower.of_algebraMap_eq' (by
      ext n
      simp [A])
  exact Module.Finite.of_restrictScalars_finite R (R ⧸ p) A

/-- The quotient `B` is finite over the residue field. -/
lemma moduleFiniteB : Module.Finite (R ⧸ p) (BOf p P) := by
  let B := BOf p P
  haveI : IsScalarTower R (R ⧸ p) B :=
    IsScalarTower.of_algebraMap_eq' (by
      ext n
      simp [B])
  exact Module.Finite.of_restrictScalars_finite R (R ⧸ p) B

/-- the ideal `MIdx` is an ideal, so it is closed under multiplication by elements. -/
lemma lmulA_stable (z : S) (i : ℕ) (x : AOf p P) (hx : x ∈ MIdx p P i) :
    zA p P z * x ∈ MIdx p P i := by
  exact Ideal.mul_mem_left (MIdx p P i) (zA p P z) hx

/-- multiplication-by-`z` endomorphism on the graded module `grd i`. -/
noncomputable def grdEndo (z : S) (i : ℕ) : grd p P i →ₗ[R ⧸ p] grd p P i where
  toFun x := ⟨zA p P z * x.1, lmulA_stable p P z i x.1 x.2⟩
  map_add' := by intro x y; ext; simp [mul_add]
  map_smul' := by intro c x; ext; simp [Algebra.smul_def]; ring

/-- the inclusion grd(i+1) → grd i (identity on the underlying element). -/
abbrev grdIncl (i : ℕ) : grd p P (i + 1) →ₗ[R ⧸ p] grd p P i :=
  Ideal.powQuotSuccInclusion p P i

lemma grdIncl_inj (i : ℕ) : Function.Injective (grdIncl p P i) :=
  Ideal.powQuotSuccInclusion_injective p P i

/-- endomorphisms are compatible with the inclusion. -/
lemma grdEndo_comp_incl (z : S) (i : ℕ) :
    (grdIncl p P i).comp (grdEndo p P z (i + 1)) =
      (grdEndo p P z i).comp (grdIncl p P i) := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  rfl

/-- multiplication by `z` maps the image of the lower graded module into itself. -/
lemma grdEndo_range (z : S) (i : ℕ) :
    ∀ x : grd p P i, x ∈ (grdIncl p P i).range →
      grdEndo p P z i x ∈ (grdIncl p P i).range := by
  intro x hx
  rcases (LinearMap.mem_range.mp hx) with ⟨y, hy⟩
  refine ⟨grdEndo p P z (i + 1) y, ?_⟩
  have hcompz : grdIncl p P i (grdEndo p P z (i + 1) y) =
      grdEndo p P z i (grdIncl p P i y) := by
    simpa using congrArg (fun φ : grd p P (i + 1) →ₗ[R ⧸ p] grd p P i => φ y)
      (grdEndo_comp_incl p P z i)
  simpa [hy] using hcompz

/-- The induced endomorphism on the graded quotient is conjugated to multiplication on `B`. -/
lemma trace_grd_quotient (z : S) (hp : p ≠ ⊥) (i : ℕ) (hi : i < p.ramificationIdx' P)
    (hP0 : P ≠ ⊥) :
    LinearMap.trace (R ⧸ p) (grd p P i ⧸ (grdIncl p P i).range)
        (mapQEnd (grdIncl p P i).range (grdEndo p P z i) (grdEndo_range p P z i)) =
      LinearMap.trace (R ⧸ p) (BOf p P)
        (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z)) := by
  classical
  letI : P.IsPrime := Ideal.IsMaximal.isPrime' P
  haveI : NeZero (p.ramificationIdx' P) := ⟨eRam_ne_zero p P hp⟩
  have htop : P ≠ ⊤ := (Ideal.IsMaximal.isPrime' P).ne_top
  obtain ⟨a, ha_mem, ha_notMem⟩ := SetLike.exists_of_lt (by
    simpa using (Ideal.pow_right_strictAnti P hP0 htop) (Nat.lt_succ_self i))
  let φ : BOf p P →ₗ[R ⧸ p] (grd p P i ⧸ (grdIncl p P i).range) :=
    Ideal.quotientToQuotientRangePowQuotSucc p P ha_mem
  have hφinj : Function.Injective φ :=
    Ideal.quotientToQuotientRangePowQuotSucc_injective p P hi ha_mem ha_notMem
  have hφsurj : Function.Surjective φ :=
    Ideal.quotientToQuotientRangePowQuotSucc_surjective p P hP0 hi ha_mem ha_notMem
  have hrel : (mapQEnd (grdIncl p P i).range (grdEndo p P z i) (grdEndo_range p P z i)).comp φ =
      φ.comp (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z)) := by
    apply LinearMap.ext
    intro xb
    rcases Ideal.Quotient.mk_surjective xb with ⟨x, rfl⟩
    simp only [LinearMap.comp_apply]
    rw [← Ideal.Quotient.mk_eq_mk (I := P) x]
    change (mapQEnd (grdIncl p P i).range (grdEndo p P z i) (grdEndo_range p P z i))
        (Ideal.quotientToQuotientRangePowQuotSucc p P ha_mem (Submodule.Quotient.mk x)) =
      (Ideal.quotientToQuotientRangePowQuotSucc p P ha_mem)
        ((Algebra.lmul (R ⧸ p) (BOf p P)) (zB p P z) (Submodule.Quotient.mk x))
    rw [Ideal.quotientToQuotientRangePowQuotSucc_mk p P ha_mem x]
    rw [mapQEnd]
    erw [Submodule.mapQ_apply]
    rw [show (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z)) (Submodule.Quotient.mk x) =
        Submodule.Quotient.mk (z * x) by
          rw [Ideal.Quotient.mk_eq_mk (I := P) (z * x)]
          rw [Ideal.Quotient.mk_eq_mk (I := P) x]
          change zB p P z * (Ideal.Quotient.mk P x) = Ideal.Quotient.mk P (z * x)
          rw [← map_mul]]
    rw [Ideal.quotientToQuotientRangePowQuotSucc_mk p P ha_mem (z * x)]
    simp [grdEndo]
    apply congrArg Submodule.Quotient.mk
    apply Subtype.ext
    ring
  exact trace_eq_of_conj_by_bijective φ ⟨hφinj, hφsurj⟩
    (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z))
    (mapQEnd (grdIncl p P i).range (grdEndo p P z i) (grdEndo_range p P z i)) hrel

/-- the trace on the whole graded module is the sum of the traces on the submodule and on the
quotient. -/
lemma trace_grd_step (z : S) (hp : p ≠ ⊥) (i : ℕ) (hi : i < p.ramificationIdx' P)
    (hP0 : P ≠ ⊥) :
    LinearMap.trace (R ⧸ p) (grd p P i) (grdEndo p P z i) =
      LinearMap.trace (R ⧸ p) (grd p P (i + 1)) (grdEndo p P z (i + 1)) +
        LinearMap.trace (R ⧸ p) (BOf p P)
          (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z)) := by
  classical
  haveI : Module.Finite (R ⧸ p) (AOf p P) := moduleFiniteA p P
  have h := trace_step_of_incl (K := R ⧸ p) (M := grd p P (i + 1)) (N := grd p P i)
      (ι := grdIncl p P i) (hι := grdIncl_inj p P i)
      (g := grdEndo p P z (i + 1)) (f := grdEndo p P z i)
      (hcomp := grdEndo_comp_incl p P z i) (hf := grdEndo_range p P z i)
  have hq := trace_grd_quotient p P z hp i hi hP0
  rw [hq] at h
  exact h

/-- telescoped version over the flag. -/
lemma trace_grd_eq_smul (z : S) (hp : p ≠ ⊥) (hP0 : P ≠ ⊥) (i : ℕ)
    (hi : i ≤ p.ramificationIdx' P) :
    LinearMap.trace (R ⧸ p) (grd p P i) (grdEndo p P z i) =
      (p.ramificationIdx' P - i) •
        LinearMap.trace (R ⧸ p) (BOf p P)
          (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z)) := by
  classical
  let e := p.ramificationIdx' P
  let t := LinearMap.trace (R ⧸ p) (BOf p P) (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z))
  have hbase : LinearMap.trace (R ⧸ p) (grd p P e) (grdEndo p P z e) = (e - e) • t := by
    have hMe : MIdx p P e = ⊥ := by
      dsimp [MIdx]
      exact Ideal.map_quotient_self (P ^ e)
    have hendo : grdEndo p P z e = 0 := by
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      have hx0 : (x : AOf p P) = 0 := by
        have hx2 : (x : AOf p P) ∈ (⊥ : Ideal (AOf p P)) := by simpa [hMe] using x.2
        exact (Ideal.mem_bot.mp hx2)
      simp [grdEndo, hx0]
    rw [hendo]
    simp
  refine Nat.decreasingInduction' (n := e) (P := fun k =>
      LinearMap.trace (R ⧸ p) (grd p P k) (grdEndo p P z k) = (e - k) • t)
      (fun k hk hik ih => ?_) hi hbase
  rw [trace_grd_step p P z hp k hk hP0, ih]
  have hids : (e - (k + 1) + 1) • t = (e - (k + 1)) • t + t := by
    rw [add_nsmul, one_nsmul]
  rw [← hids]
  congr 1
  omega

/-- trace over the full quotient `A` equals `e •` trace over `B`. -/
lemma trace_full_eq_smul (z : S) (hp : p ≠ ⊥) (hP0 : P ≠ ⊥) :
    LinearMap.trace (R ⧸ p) (AOf p P) (Algebra.lmul (R ⧸ p) (AOf p P) (zA p P z)) =
      p.ramificationIdx' P •
        LinearMap.trace (R ⧸ p) (BOf p P)
          (Algebra.lmul (R ⧸ p) (BOf p P) (zB p P z)) := by
  classical
  have hsmul := trace_grd_eq_smul p P z hp hP0 0 (Nat.zero_le (p.ramificationIdx' P))
  have he0 : (p.ramificationIdx' P - 0) = p.ramificationIdx' P := Nat.sub_zero _
  have hA : LinearMap.trace (R ⧸ p) (AOf p P) (Algebra.lmul (R ⧸ p) (AOf p P) (zA p P z)) =
      LinearMap.trace (R ⧸ p) (grd p P 0) (grdEndo p P z 0) := by
    let φ : grd p P 0 →ₗ[R ⧸ p] AOf p P :=
      { toFun := fun x => x.1
        map_add' := by intro x y; rfl
        map_smul' := by intro c x; rfl }
    have hM0 : MIdx p P 0 = ⊤ := by
      dsimp [MIdx]
      rw [pow_zero, Ideal.one_eq_top]
      exact Ideal.map_top (Ideal.Quotient.mk (P ^ p.ramificationIdx' P))
    have hbij : Function.Bijective φ := by
      constructor
      · intro x y h
        apply Subtype.ext
        exact h
      · intro a
        refine ⟨⟨a, by rw [hM0]; trivial⟩, rfl⟩
    have hrel2 : (Algebra.lmul (R ⧸ p) (AOf p P) (zA p P z)).comp φ =
        φ.comp (grdEndo p P z 0) := by
      apply LinearMap.ext
      intro x
      rfl
    exact trace_eq_of_conj_by_bijective φ hbij (grdEndo p P z 0)
        (Algebra.lmul (R ⧸ p) (AOf p P) (zA p P z)) hrel2
  rw [hA, hsmul, he0]

/-- **The main (e'-world) statement**: trace over `S ⧸ P^(ramificationIdx')` is
`ramificationIdx'` times the trace over `S ⧸ P`. -/
theorem trace_pow_quotient_eq_nsmul_idx' (z : S) (hp : p ≠ ⊥) (hP0 : P ≠ ⊥) :
    Algebra.trace (R ⧸ p) (AOf p P) (zA p P z) =
      p.ramificationIdx' P • Algebra.trace (R ⧸ p) (BOf p P) (zB p P z) := by
  rw [Algebra.trace_apply, Algebra.trace_apply]
  exact trace_full_eq_smul p P z hp hP0

end RamIdx

end TracePow

theorem trace_pow_quotient_eq_nsmul {K : Type*} [Field K] [NumberField K]
    (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (NumberField.RingOfIntegers K)) [P.IsMaximal]
    [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (z : NumberField.RingOfIntegers K) :
    Algebra.trace (ℤ ⧸ (Ideal.span ({(p : ℤ)} : Set ℤ)))
        ((NumberField.RingOfIntegers K) ⧸ P ^ P.ramificationIdx ℤ)
        (Ideal.Quotient.mk (P ^ P.ramificationIdx ℤ) z) =
      (P.ramificationIdx ℤ) •
        Algebra.trace (ℤ ⧸ (Ideal.span ({(p : ℤ)} : Set ℤ)))
          ((NumberField.RingOfIntegers K) ⧸ P) (Ideal.Quotient.mk P z) := by
  classical
  letI : P.LiesOver (p₀ p) := by
    simpa [p₀] using ‹P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))›
  let S := NumberField.RingOfIntegers K
  let F := ℤ ⧸ p₀ p
  letI : P.IsPrime := Ideal.IsMaximal.isPrime' P
  have hp₀ : p₀ p ≠ ⊥ := p₀_ne_bot p
  have hP0 : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot hp₀ P
  have he : (p₀ p).ramificationIdx' P = P.ramificationIdx ℤ :=
    Ideal.ramificationIdx'_eq_ramificationIdx (p₀ p) P hp₀
  have hmain := TracePow.trace_pow_quotient_eq_nsmul_idx' (R := ℤ) (S := S) (p := p₀ p)
    (P := P) (z := z) hp₀ hP0
  let ealg : (S ⧸ P ^ (p₀ p).ramificationIdx' P) ≃ₐ[F] (S ⧸ P ^ P.ramificationIdx ℤ) :=
    AlgEquiv.ofRingEquiv (R := F) (A₁ := S ⧸ P ^ (p₀ p).ramificationIdx' P)
      (A₂ := S ⧸ P ^ P.ramificationIdx ℤ)
      (f := Ideal.quotEquivOfEq (congrArg (fun n : ℕ => P ^ n) he))
      (by
        intro x
        rcases Ideal.Quotient.mk_surjective x with ⟨n, rfl⟩
        simp [Ideal.quotEquivOfEq_mk])
  have healg_mk : ealg (Ideal.Quotient.mk (P ^ (p₀ p).ramificationIdx' P) z) =
      Ideal.Quotient.mk (P ^ P.ramificationIdx ℤ) z := by
    exact Ideal.quotEquivOfEq_mk (congrArg (fun n : ℕ => P ^ n) he) z
  have htr : Algebra.trace F (S ⧸ P ^ P.ramificationIdx ℤ)
        (Ideal.Quotient.mk (P ^ P.ramificationIdx ℤ) z) =
      Algebra.trace F (S ⧸ P ^ (p₀ p).ramificationIdx' P)
        (Ideal.Quotient.mk (P ^ (p₀ p).ramificationIdx' P) z) := by
    simpa [healg_mk] using
      (Algebra.trace_eq_of_algEquiv ealg (Ideal.Quotient.mk (P ^ (p₀ p).ramificationIdx' P) z))
  rw [htr, ← he]
  exact hmain

/-- Chinese-remainder-style lift: if `P` and `Q` are coprime, an element congruent to `z`
mod `P^e` and vanishing mod `Q` exists. -/
lemma exists_lift_of_sup_eq_top {K : Type*} [Field K] [NumberField K]
    (P Q : Ideal (𝓞 K)) (e : ℕ) (hsup : P ⊔ Q = ⊤) (z : 𝓞 K) :
    ∃ y : 𝓞 K, y - z ∈ P ^ e ∧ y ∈ Q := by
  classical
  have hcop : IsCoprime P Q := (Ideal.isCoprime_iff_sup_eq).mpr hsup
  have hcop' : IsCoprime (P ^ e) Q := IsCoprime.pow_left hcop
  have hsup' : P ^ e ⊔ Q = ⊤ := (Ideal.isCoprime_iff_sup_eq).mp hcop'
  have hone : (1 : 𝓞 K) ∈ P ^ e ⊔ Q := by rw [hsup']; trivial
  rcases (Submodule.mem_sup.mp hone) with ⟨a, ha, b, hb, hab⟩
  refine ⟨z * b, ?_, ?_⟩
  · have hb1 : b - 1 = -a := by
      rw [eq_neg_iff_add_eq_zero]
      rw [add_comm]
      rw [← add_sub_assoc]
      rw [hab]
      simp
    have hza : z * a ∈ P ^ e := Ideal.mul_mem_left (P ^ e) z ha
    have hneg : -(z * a) ∈ P ^ e := (P ^ e).neg_mem hza
    rw [show z * b - z = -(z * a) by
      calc
        z * b - z = z * (b - 1) := by rw [mul_sub]; simp
        _ = z * (-a) := by rw [hb1]
        _ = -(z * a) := by rw [mul_neg]]
    exact hneg
  · exact Q.mul_mem_left z hb

open TameDifferent in
/-- Builds the trace witness: an element `y ∈ Q` whose integer trace is not divisible by `p`,
assuming `P` is tame over `(p)` and `(p)` splits as `P^e · Q`. -/
lemma exists_witness_of_tame {K : Type*} [Field K] [NumberField K]
    (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsMaximal]
    [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    {Q : Ideal (𝓞 K)} (hsup : P ⊔ Q = ⊤)
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (htame : ¬ p ∣ P.ramificationIdx ℤ) :
    ∃ y : 𝓞 K, y ∈ Q ∧ ¬ (p : ℤ) ∣ Algebra.intTrace ℤ (𝓞 K) y := by
  classical
  haveI : (p₀ p).IsMaximal := p₀_isMaximal p
  haveI : P.IsPrime := Ideal.IsMaximal.isPrime' P
  haveI : P.LiesOver (p₀ p) := by simpa [p₀] using ‹P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))›
  let e : ℕ := P.ramificationIdx ℤ
  let F : Type _ := ℤ ⧸ p₀ p
  letI : Field F := Ideal.Quotient.field (p₀ p)
  let κ : Type _ := (𝓞 K) ⧸ P
  letI : Field κ := Ideal.Quotient.field P
  have hleq : p₀ p ≤ Ideal.comap (algebraMap ℤ (𝓞 K)) P := by
    have heq : p₀ p = Ideal.comap (algebraMap ℤ (𝓞 K)) P := by
      change p₀ p = P.under ℤ
      exact Ideal.LiesOver.over
    exact heq.le
  letI : Algebra F κ := Ideal.Quotient.algebraQuotientOfLEComap hleq
  have hsurj : Function.Surjective (Algebra.trace F κ) := by
    exact Algebra.trace_surjective F κ
  rcases hsurj 1 with ⟨u, hu⟩
  rcases Ideal.Quotient.mk_surjective (I := P) u with ⟨z, hz⟩
  have htr1 : Algebra.trace F κ (Ideal.Quotient.mk P z) = 1 := by
    rw [hz]
    exact hu
  rcases exists_lift_of_sup_eq_top (K := K) P Q e hsup z with ⟨y, hyP, hyQ⟩
  refine ⟨y, hyQ, ?_⟩
  -- (p : ℤ) ∤ intTrace y
  have htrpow : Algebra.trace F ((𝓞 K) ⧸ P ^ e) (Ideal.Quotient.mk (P ^ e) z) =
      (e : ℕ) • (Algebra.trace F κ (Ideal.Quotient.mk P z)) := by
    simpa [p₀, F, e] using (trace_pow_quotient_eq_nsmul (K := K) p P z)
  have htrmod : Algebra.trace F ((𝓞 K) ⧸ ((p₀ p).map (algebraMap ℤ (𝓞 K))))
        (Ideal.Quotient.mk ((p₀ p).map (algebraMap ℤ (𝓞 K))) y) =
      Algebra.trace F ((𝓞 K) ⧸ P ^ e) (Ideal.Quotient.mk (P ^ e) z) := by
    simpa [p₀, F, e] using (trace_mod_eq_trace_pow_quotient (K := K) p P hsup hspl z y hyP hyQ)
  have hval : Algebra.trace F ((𝓞 K) ⧸ ((p₀ p).map (algebraMap ℤ (𝓞 K))))
        (Ideal.Quotient.mk ((p₀ p).map (algebraMap ℤ (𝓞 K))) y) ≠ 0 := by
    intro hzero
    have hz0 : (e : ℕ) • (1 : F) = 0 := by
      have hz0' : (e : ℕ) • (Algebra.trace F κ (Ideal.Quotient.mk P z)) = 0 := by
        rw [← htrpow]
        rw [← htrmod]
        exact hzero
      rw [← hz0']
      congr 1
      exact htr1.symm
    have heF0 : (e : F) = 0 := by
      simpa [nsmul_eq_mul] using hz0
    have hmk : Ideal.Quotient.mk (p₀ p) (e : ℤ) = 0 := by
      simpa [F, p₀] using heF0
    have hmem : (e : ℤ) ∈ p₀ p := (Ideal.Quotient.eq_zero_iff_mem.mp hmk)
    have hdvdz : (p : ℤ) ∣ (e : ℤ) := (Ideal.mem_span_singleton.mp (by simpa [p₀] using hmem))
    have hdvd : p ∣ e := by
      exact_mod_cast hdvdz
    exact htame hdvd
  -- relate intTrace y to the nonzero trace value via trace_quotient_eq_of_isDedekindDomain
  have hrel : Algebra.trace F ((𝓞 K) ⧸ ((p₀ p).map (algebraMap ℤ (𝓞 K))))
        (Ideal.Quotient.mk ((p₀ p).map (algebraMap ℤ (𝓞 K))) y) =
      Ideal.Quotient.mk (p₀ p) (Algebra.intTrace ℤ (𝓞 K) y) := by
    simpa [p₀, F] using
      (Algebra.trace_quotient_eq_of_isDedekindDomain (p := p₀ p) (x := (y : 𝓞 K)))
  intro hdivp
  have hmem : Algebra.intTrace ℤ (𝓞 K) y ∈ p₀ p := by
    exact (Ideal.mem_span_singleton.mpr hdivp)
  have hmk : Ideal.Quotient.mk (p₀ p) (Algebra.intTrace ℤ (𝓞 K) y) = 0 :=
    (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)
  exact hval (by rw [hrel, hmk])

/-- **Tame different**: if a prime `P` over `(p)` has ramification index `e` with `p ∤ e`,
then `P^e` does not divide the different ideal of `K`. -/
theorem tame_different {K : Type*} [Field K] [NumberField K]
    (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (NumberField.RingOfIntegers K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (htame : ¬ p ∣ P.ramificationIdx ℤ) :
    ¬ P ^ P.ramificationIdx ℤ ∣ differentIdeal ℤ (NumberField.RingOfIntegers K) := by
  classical
  haveI : P.LiesOver (p₀ p) := by
    simpa [p₀] using ‹P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))›
  haveI : P.LiesOver (TameDifferent.p₀ p) := by
    simpa [TameDifferent.p₀] using ‹P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))›
  rcases TameDifferent.p₀_map_eq_pow_mul (K := K) p P with ⟨Q, hsup, hspl⟩
  rcases exists_witness_of_tame (K := K) p P hsup (by simpa [TameDifferent.p₀] using hspl) htame with ⟨y, hyQ, hy⟩
  exact not_dvd_pow_of_witness (K := K) p P hsup (by simpa [TameDifferent.p₀] using hspl) y hyQ hy

end Commons.NumberTheory.NumberField