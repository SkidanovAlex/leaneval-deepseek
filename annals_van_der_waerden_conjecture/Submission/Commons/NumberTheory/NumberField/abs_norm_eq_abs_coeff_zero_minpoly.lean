import Mathlib.Algebra.Order.Archimedean.Real.Basic
import Mathlib.NumberTheory.NumberField.Basic
import Submission.Commons.FieldTheory.Polynomial.norm_eq_neg_one_pow_mul_coeff_zero

namespace Commons.NumberTheory.NumberField

/-- For a number field `K = ℚ(α)` generated by an algebraic integer `α`, the absolute value of the
field norm of `α` equals the absolute value of the constant coefficient of its minimal polynomial
over `ℤ`.

We compute the norm via the generating-element formula
`Algebra.norm ℚ α = (-1)^[K:ℚ] * (minpoly ℚ α).coeff 0`
(`Commons.FieldTheory.Polynomial.norm_eq_neg_one_pow_mul_coeff_zero`), and use that, since `α` is
integral over `ℤ`, the minimal polynomial over `ℚ` is the image of the minimal polynomial over `ℤ`
(`minpoly.isIntegrallyClosed_eq_field_fractions'`). Passing to absolute values in `ℝ` kills the
sign `(-1)^[K:ℚ]`. -/
theorem abs_norm_eq_abs_coeff_zero_minpoly {K : Type*} [Field K] [NumberField K] {α : K}
    (hgen : Algebra.adjoin ℚ ({α} : Set K) = ⊤) (hint : IsIntegral ℤ α) :
    |Algebra.norm ℚ α| = |((((minpoly ℤ α).coeff 0 : ℤ)) : ℝ)| := by
  -- Norm of a primitive element as `(-1)^[K:ℚ]` times the constant coefficient of the minpoly.
  have h1 : Algebra.norm ℚ α
      = (-1 : ℚ) ^ Module.finrank ℚ K * (((minpoly ℤ α).coeff 0 : ℤ) : ℚ) := by
    rw [Commons.FieldTheory.Polynomial.norm_eq_neg_one_pow_mul_coeff_zero α hgen]
    congr 1
    -- The minimal polynomial over `ℚ` is the image of the one over `ℤ`, since `α` is integral.
    rw [minpoly.isIntegrallyClosed_eq_field_fractions' (R := ℤ) (K := ℚ) (S := K) hint]
    simp
  rw [h1]
  push_cast
  rw [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]

end Commons.NumberTheory.NumberField