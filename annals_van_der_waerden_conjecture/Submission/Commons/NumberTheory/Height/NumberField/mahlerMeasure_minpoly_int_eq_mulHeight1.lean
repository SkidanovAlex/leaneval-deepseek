import Mathlib.Analysis.Polynomial.MahlerMeasure
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal
import Submission.Commons.NumberTheory.Height.NumberField.logHeight1_eq_sum_embeddings_log_max_of_isIntegral

open Polynomial

namespace Commons.NumberTheory.Height.NumberField

/-- If a number field `K` is generated by `α` over `ℚ`, then two ring homomorphisms
`K →+* ℂ` that agree on `α` are equal. Equivalently, the map `σ ↦ σ α` is injective on the
set of complex embeddings of `K`. -/
lemma embeddings_injective_apply_of_adjoin_eq_top {K : Type*} [Field K] [NumberField K] {α : K}
    (hgen : Algebra.adjoin ℚ ({α} : Set K) = ⊤) :
    Function.Injective (fun σ : K →+* ℂ => σ α) := by
  intro σ τ h
  have h' : σ.toRatAlgHom α = τ.toRatAlgHom α := h
  have hfg : σ.toRatAlgHom = τ.toRatAlgHom := by
    refine AlgHom.ext_of_adjoin_eq_top hgen (s := ({α} : Set K)) ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact h'
  exact (RingHom.equivRatAlgHom K ℂ).injective (by
    rw [RingHom.equivRatAlgHom_apply, RingHom.equivRatAlgHom_apply]
    exact hfg)

/-- The Mahler measure of the image of the minimal polynomial of a generator `α` of a number
field `K` in `ℂ[X]` is the product over all complex embeddings `σ` of `K` of
`max 1 ‖σ α‖`. -/
lemma mapMahlerMeasure_minpoly_rat_eq_prod_max_one_norm {K : Type*} [Field K] [NumberField K]
    {α : K} (hgen : Algebra.adjoin ℚ ({α} : Set K) = ⊤) :
    Polynomial.mapMahlerMeasure (minpoly ℚ α) (algebraMap ℚ ℂ)
      = ∏ σ : K →+* ℂ, max 1 ‖σ α‖ := by
  classical
  have hInt : IsIntegral ℚ α := Algebra.IsIntegral.isIntegral α
  have hinj : Function.Injective (fun σ : K →+* ℂ => σ α) :=
    embeddings_injective_apply_of_adjoin_eq_top hgen
  have hroots : ((minpoly ℚ α).map (algebraMap ℚ ℂ)).roots
      = (Finset.univ.image (fun σ : K →+* ℂ => σ α)).val := by
    refine Polynomial.roots_eq_of_natDegree_le_card_of_ne_zero ?_ ?_ ?_
    · intro x hx
      rw [Finset.mem_image] at hx
      obtain ⟨σ, -, rfl⟩ := hx
      rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      change (Polynomial.aeval (σ.toRatAlgHom α)) (minpoly ℚ α) = 0
      rw [Polynomial.aeval_algHom_apply σ.toRatAlgHom α (minpoly ℚ α), minpoly.aeval,
        map_zero]
    · rw [Polynomial.natDegree_map_eq_of_injective (algebraMap ℚ ℂ).injective,
        Finset.card_image_of_injOn (fun _ _ _ _ h => hinj h), Finset.card_univ,
        NumberField.Embeddings.card K ℂ]
      exact minpoly.natDegree_le α
    · exact (minpoly.monic hInt).map (algebraMap ℚ ℂ) |>.ne_zero
  rw [Polynomial.mapMahlerMeasure_eq, Polynomial.mahlerMeasure_eq_leadingCoeff_mul_prod_roots,
    hroots]
  have hmonic : ((minpoly ℚ α).map (algebraMap ℚ ℂ)).Monic := (minpoly.monic hInt).map _
  rw [hmonic.leadingCoeff, norm_one, one_mul, ← Finset.prod_eq_multiset_prod,
    Finset.prod_image (f := fun x : ℂ => max 1 ‖x‖) (g := fun σ : K →+* ℂ => σ α)
      (s := Finset.univ) (fun _ _ _ _ h => hinj h)]

/-- For an algebraic integer `α` in a number field `K`, the multiplicative height of `α` is the
product over all complex embeddings `σ` of `K` of `max 1 ‖σ α‖` (the contribution of the finite
places vanishes because `α` is integral). -/
lemma mulHeight₁_eq_prod_embeddings_max {K : Type*} [Field K] [NumberField K] {α : K}
    (hint : IsIntegral ℤ α) :
    Height.mulHeight₁ α = ∏ σ : K →+* ℂ, max 1 ‖σ α‖ := by
  have key := Commons.NumberTheory.Height.NumberField.logHeight1_eq_sum_embeddings_log_max_of_isIntegral
    (K := K) hint
  have hpos1 : (0 : ℝ) < Height.mulHeight₁ α := Height.mulHeight₁_pos α
  have hpos2 : (0 : ℝ) < ∏ σ : K →+* ℂ, max 1 ‖σ α‖ :=
    Finset.prod_pos (fun σ _ => lt_of_lt_of_le zero_lt_one (le_max_left _ _))
  refine Real.log_injOn_pos hpos1 hpos2 ?_
  rw [← Height.logHeight₁_eq_log_mulHeight₁, key, Real.log_prod]
  intro σ _
  exact ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_left _ _))

/-- For an algebraic integer `α`, the Mahler measure of `minpoly ℤ α` (with coefficients mapped
into `ℂ`) equals the Mahler measure of `minpoly ℚ α` (with coefficients mapped into `ℂ`): the two
polynomials coincide after extension of scalars. -/
lemma mapMahlerMeasure_minpoly_int_eq_map_minpoly_rat {K : Type*} [Field K] [NumberField K]
    {α : K} (hint : IsIntegral ℤ α) :
    Polynomial.mapMahlerMeasure (minpoly ℤ α) (Int.castRingHom ℂ)
      = Polynomial.mapMahlerMeasure (minpoly ℚ α) (algebraMap ℚ ℂ) := by
  have hZ : (minpoly ℤ α).map (algebraMap ℤ ℚ) = minpoly ℚ α :=
    (minpoly.isIntegrallyClosed_eq_field_fractions' (R := ℤ) (K := ℚ) (S := K) hint).symm
  have hcast : Int.castRingHom ℂ = algebraMap ℤ ℂ := RingHom.ext_int _ _
  rw [Polynomial.mapMahlerMeasure_eq, Polynomial.mapMahlerMeasure_eq, hcast]
  congr 1
  rw [IsScalarTower.algebraMap_eq ℤ ℚ ℂ, ← Polynomial.map_map (algebraMap ℤ ℚ) (algebraMap ℚ ℂ),
    hZ]

theorem mahlerMeasure_minpoly_int_eq_mulHeight1 {K : Type*} [Field K] [NumberField K] {α : K}
    (hint : IsIntegral ℤ α) (hgen : Algebra.adjoin ℚ ({α} : Set K) = ⊤) :
    Polynomial.mapMahlerMeasure (minpoly ℤ α) (Int.castRingHom ℂ) = Height.mulHeight₁ α := by
  rw [mapMahlerMeasure_minpoly_int_eq_map_minpoly_rat hint,
    mapMahlerMeasure_minpoly_rat_eq_prod_max_one_norm hgen,
    mulHeight₁_eq_prod_embeddings_max hint]

end Commons.NumberTheory.Height.NumberField