import Mathlib

namespace Commons.Polynomial

theorem good24_of_good30_not_bad6 (a b c : ℤ)
    (h1 : (a, b, c) ∈ [(-2,0,2), (-2,1,1), (-2,1,2), (-2,2,1), (-2,3,-1), (-1,0,1), (-1,1,1), (-1,1,2), (-1,2,-1), (-1,2,1), (-1,3,-2), (-1,3,-1), (0,1,-1), (0,1,1), (0,2,-2), (0,2,-1), (0,2,1), (0,2,2), (1,0,-1), (1,1,-2), (1,1,-1), (1,2,-1), (1,2,1), (1,3,1), (1,3,2), (2,0,-2), (2,1,-2), (2,1,-1), (2,2,-1), (2,3,1)])
    (h2 : ¬ (a, b, c) ∈ [(-2,0,2), (-1,1,1), (-1,3,-1), (1,1,-1), (1,3,1), (2,0,-2)]) :
    (a, b, c) ∈ [(-2,1,1), (-2,1,2), (-2,2,1), (-2,3,-1), (-1,0,1), (-1,1,2), (-1,2,-1), (-1,2,1), (-1,3,-2), (0,1,-1), (0,1,1), (0,2,-2), (0,2,-1), (0,2,1), (0,2,2), (1,0,-1), (1,1,-2), (1,2,-1), (1,2,1), (1,3,2), (2,1,-2), (2,1,-1), (2,2,-1), (2,3,1)] := by
  let all : List (ℤ × ℤ × ℤ) := [(-2,0,2), (-2,1,1), (-2,1,2), (-2,2,1), (-2,3,-1), (-1,0,1), (-1,1,1), (-1,1,2), (-1,2,-1), (-1,2,1), (-1,3,-2), (-1,3,-1), (0,1,-1), (0,1,1), (0,2,-2), (0,2,-1), (0,2,1), (0,2,2), (1,0,-1), (1,1,-2), (1,1,-1), (1,2,-1), (1,2,1), (1,3,1), (1,3,2), (2,0,-2), (2,1,-2), (2,1,-1), (2,2,-1), (2,3,1)]
  let good : List (ℤ × ℤ × ℤ) := [(-2,1,1), (-2,1,2), (-2,2,1), (-2,3,-1), (-1,0,1), (-1,1,2), (-1,2,-1), (-1,2,1), (-1,3,-2), (0,1,-1), (0,1,1), (0,2,-2), (0,2,-1), (0,2,1), (0,2,2), (1,0,-1), (1,1,-2), (1,2,-1), (1,2,1), (1,3,2), (2,1,-2), (2,1,-1), (2,2,-1), (2,3,1)]
  let bad : List (ℤ × ℤ × ℤ) := [(-2,0,2), (-1,1,1), (-1,3,-1), (1,1,-1), (1,3,1), (2,0,-2)]
  have hall : (a, b, c) ∈ all := by simpa [all] using h1
  have hnotbad : ¬ (a, b, c) ∈ bad := by simpa [bad] using h2
  have hperm : List.Perm all (good ++ bad) := by
    decide
  have hmem : (a, b, c) ∈ good ++ bad := by
    exact (List.Perm.mem_iff hperm).mp hall
  rw [List.mem_append] at hmem
  rcases hmem with hgood | hbad
  · simpa [good] using hgood
  · exact (hnotbad hbad).elim

end Commons.Polynomial
