import Mathlib.Algebra.Order.Ring.Star
import Mathlib.Data.ZMod.QuotientRing
import Mathlib.RingTheory.LocalRing.RingHom.Basic

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Commons.RingTheory.LocalRing

/-- In `ZMod (p ^ n)` with `p` prime and `0 < n`, a class is a unit iff `p` does not
divide its least natural representative. -/
lemma zmod_prime_pow_isUnit_iff_not_dvd_val {p n : ℕ} (hp : Nat.Prime p) (hn : 0 < n)
    [NeZero (p ^ n)] (a : ZMod (p ^ n)) : IsUnit a ↔ ¬ p ∣ a.val := by
  conv_lhs => rw [← ZMod.natCast_zmod_val a]
  exact ZMod.isUnit_natCast_iff_not_dvd_pow hp hn

/-- `ZMod (p ^ n)` is a local ring for `p` prime and `n ≥ 1`; its unique maximal ideal is
generated by `p`. -/
lemma zmod_prime_pow_isLocalRing (p : ℕ) (hp : Nat.Prime p) (n : ℕ) (hn : 0 < n) :
    IsLocalRing (ZMod (p ^ n)) := by
  classical
  have hpn_gt : 1 < p ^ n := by
    calc
      1 < p := hp.one_lt
      _ = p ^ 1 := by simp
      _ ≤ p ^ n := pow_le_pow_right₀ hp.one_lt.le (by omega : 1 ≤ n)
  haveI : Fact (1 < p ^ n) := ⟨hpn_gt⟩
  haveI : NeZero (p ^ n) := ⟨by omega⟩
  refine { toNontrivial := (inferInstance : Nontrivial (ZMod (p ^ n))),
           isUnit_or_isUnit_of_add_one := ?_ }
  intro a b hab
  by_cases ha : IsUnit a
  · exact Or.inl ha
  · right
    by_cases hb : IsUnit b
    · exact hb
    · exfalso
      have hpa : p ∣ a.val := by
        by_contra hnot
        exact ha (zmod_prime_pow_isUnit_iff_not_dvd_val hp hn a |>.mpr hnot)
      have hpb : p ∣ b.val := by
        by_contra hnot
        exact hb (zmod_prime_pow_isUnit_iff_not_dvd_val hp hn b |>.mpr hnot)
      have h1 : ((a.val + b.val : ℕ) : ZMod (p ^ n)) = 1 := by
        rw [Nat.cast_add, ZMod.natCast_zmod_val a, ZMod.natCast_zmod_val b, hab]
      have hmod : a.val + b.val ≡ 1 [MOD p ^ n] := by
        apply (ZMod.natCast_eq_natCast_iff (a.val + b.val) 1 (p ^ n)).mp
        simpa using h1
      have hpdiv : p ∣ p ^ n := by
        rcases Nat.exists_eq_succ_of_ne_zero (ne_of_gt hn) with ⟨k, rfl⟩
        exact ⟨p ^ k, by rw [pow_succ, mul_comm]⟩
      have hmodp : a.val + b.val ≡ 1 [MOD p] := Nat.ModEq.of_dvd hpdiv hmod
      have ha0 : a.val ≡ 0 [MOD p] := hpa.modEq_zero_nat
      have hb0 : b.val ≡ 0 [MOD p] := hpb.modEq_zero_nat
      have hsum0 : a.val + b.val ≡ 0 [MOD p] := Nat.ModEq.add ha0 hb0
      have h10 : (1 : ℕ) ≡ 0 [MOD p] := hmodp.symm.trans hsum0
      change 1 % p = 0 % p at h10
      rw [Nat.mod_eq_of_lt hp.one_lt, Nat.zero_mod] at h10
      norm_num at h10

/-- The quotient ring `ℤ ⧸ (p^n)` is a local ring for a prime `p` and `n ≥ 1`:
its only nonunit elements are the classes divisible by `p`, and these are closed
under addition.  (Standard: `ℤ/(p^n)` has the unique maximal ideal `(p)/(p^n)`.) -/
theorem isLocalRing_quotient_int_pow (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) (hn : 0 < n) :
    IsLocalRing (ℤ ⧸ (Ideal.span ({((p ^ n : ℕ) : ℤ)} : Set ℤ))) := by
  have hp : Nat.Prime p := Fact.out
  haveI : IsLocalRing (ZMod (p ^ n)) := zmod_prime_pow_isLocalRing p hp n hn
  exact (Int.quotientSpanNatEquivZMod (p ^ n)).symm.isLocalRing

end Commons.RingTheory.LocalRing