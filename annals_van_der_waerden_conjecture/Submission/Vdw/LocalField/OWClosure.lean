import Submission.Vdw.LocalField.WDecomp
import Submission.Vdw.LocalField.CoeffIntegral
import Submission.Vdw.LocalField.OWBasic
open scoped NumberField WithZero Valued
set_option autoImplicit false
namespace Submission.Vdw.LocalField
noncomputable section
universe u
variable {K : Type u} [Field K] [NumberField K]
/-!
# Local-field chapter (G3, (b2) COMPLETE): `𝔪_W = (p)·𝒪_W` — the unramifiedness `e(W) = 1`

For the Teichmüller subfield `W = ℚ_p(ζ) ⊆ K_P` (`α ≠ 0`, `hgen`), the
valuation subring `𝒪_W = OW_subring p P α` has maximal ideal
`𝔪_W = OW_ker p P α` (kernel of the reduction `resOW_hom : 𝒪_W → κ`).  The
main theorem

    OW_ker_le_span_pOW : OW_ker p P α ≤ Ideal.span ({pOW p P α} : Set 𝒪_W)

shows `𝔪_W ⊆ (p)·𝒪_W`.  Together with the easy half
(`pOW_span_le_ker`, OWBasic) and `OW_ker_isMaximal` this is
`𝔪_W = (p)` — the unramifiedness `e(W) = 1` of `W/ℚ_p` (b2 of the
Session-85/86 roadmap).

Proof (assembly of WDecomp/CoeffIntegral/OWBasic): for `w ∈ 𝔪_W`,
`resOW w = 0` gives `‖(w : kpAdic)‖ < 1` (`OW_resOW_zero_norm_lt_one`);
the power-basis value identity `w_value_eq_wSum` writes `w = wSum c`
(`c := wBasis.repr w`); L-A (`coeffs_integral_of_norm_le_one`) gives
integral coefficients, L-B/L-B′ (`coeffs_p_divisible_of_norm_lt_one`,
`coeffs_p_dvd_exact`) give `c j = p·(e j)` with `e j ∈ ℤ_[p]`;
`w' := Σ_j (e j)·ζ^j` is integral (`basisComb_value_eq_wSum` +
`norm_sum_type_le_of_le` + the scalar norm iff), so `w' ∈ 𝒪_W`
(`mem_OW_of_norm_le_one`), and `w = p·w'` as values (`Wk_coe_injective`),
giving the membership in `Ideal.span {pOW}`.

Axioms of every statement: propext / Classical.choice / Quot.sound only.
-/

-- norm of an element of 𝔪_W:
lemma OW_resOW_zero_norm_lt_one (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) (w : OW_subring p P α) (hw : resOW_hom p P α w = 0) :
    ‖(((w : OW_subring p P α) : Wk p P α) : kpAdic p P)‖ < 1 := by
  classical
  have hz : resOW p P α ⟨((w : OW_subring p P α) : Wk p P α), (w : OW_subring p P α).2⟩ = 0 := by
    exact hw
  have hmk0 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal (kpInt p P))
      (Classical.choose ((w : OW_subring p P α).2)) = 0 := by
    simpa [resOW] using hz
  have hmem : Classical.choose ((w : OW_subring p P α).2) ∈
      IsLocalRing.maximalIdeal (kpInt p P) :=
    (Ideal.Quotient.eq_zero_iff_mem (I := IsLocalRing.maximalIdeal (kpInt p P))).mp hmk0
  have hlt : ‖((Classical.choose ((w : OW_subring p P α).2) : kpInt p P) : kpAdic p P)‖ < 1 :=
    (mem_maximalIdeal_iff_norm_lt_one p P (Classical.choose ((w : OW_subring p P α).2))).mp hmem
  have hval : ((Classical.choose ((w : OW_subring p P α).2) : kpInt p P) : kpAdic p P)
      = (((w : OW_subring p P α) : Wk p P α) : kpAdic p P) :=
    Classical.choose_spec ((w : OW_subring p P α).2)
  simpa [hval] using hlt

-- the value map Wk → kpAdic is injective
lemma Wk_coe_injective (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) : Function.Injective (fun x : Wk p P α => (x : kpAdic p P)) := by
  intro a b h
  exact Subtype.ext h

-- membership in OW from a norm bound:
lemma mem_OW_of_norm_le_one (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) (w : Wk p P α) (hw : ‖(w : kpAdic p P)‖ ≤ 1) : w ∈ OW p P α := by
  classical
  have hvle : Valued.v (w : kpAdic p P) ≤ 1 :=
    (norm_le_one_iff_val (p := p) (P := P) (x := (w : kpAdic p P))).mp hw
  refine ⟨⟨(w : kpAdic p P), ?_⟩, rfl⟩
  exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers (R := 𝓞 K) K (kprime p P)).mpr hvle
/-- **e(W)=1: the maximal ideal of 𝒪_W is generated by p.**  Every element
`w ∈ 𝔪_W = OW_ker` (reduction `resOW w = 0`) is `p` times an integral
element of `W`: decompose `w` in the `{1,…,ζ^{f−1}}`-basis
(`w_value_eq_wSum`), L-A/L-B give integral coefficients divisible by `p`
(`coeffs_p_dvd_exact`), and `w' := Σ (e j)·ζ^j` is integral
(`norm_sum_type_le_of_le`). -/
theorem OW_ker_le_span_pOW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    {α : kap p P} (hα : α ≠ 0)
    (hgen : orderOf (Units.mk0 α hα) = p ^ P.inertiaDeg ℤ - 1) :
    OW_ker p P α ≤ Ideal.span ({pOW p P α} : Set (OW_subring p P α)) := by
  classical
  intro w hw
  rw [RingHom.mem_ker] at hw
  let w0 : Wk p P α := (w : Wk p P α)
  let c : Fin (P.inertiaDeg ℤ) → QpAdic p :=
    fun j : Fin (P.inertiaDeg ℤ) => (wBasis p P α hα hgen).repr w0 j
  have hw0lt : ‖(w0 : kpAdic p P)‖ < 1 := OW_resOW_zero_norm_lt_one p P α w hw
  have hval : (w0 : kpAdic p P) = wSum p P α c := w_value_eq_wSum p P α hα hgen w0
  have hle1 : ‖wSum p P α c‖ ≤ 1 := by
    rw [← hval]
    exact le_of_lt hw0lt
  have hcA : ∀ j : Fin (P.inertiaDeg ℤ), ‖c j‖ ≤ 1 :=
    coeffs_integral_of_norm_le_one p P hα hgen c hle1
  have hcB : ∀ j : Fin (P.inertiaDeg ℤ), ‖c j‖ ≤ ‖(p : QpAdic p)‖ :=
    coeffs_p_divisible_of_norm_lt_one p P hα hgen c hcA (by rw [← hval]; exact hw0lt)
  have hdvd : ∀ j : Fin (P.inertiaDeg ℤ),
      ∃ e : QpInt p, (c j : QpAdic p) = (p : QpAdic p) * ((e : QpInt p) : QpAdic p) :=
    coeffs_p_dvd_exact p P hα hgen c hcA (by rw [← hval]; exact hw0lt)
  let e : Fin (P.inertiaDeg ℤ) → QpInt p := fun j => Classical.choose (hdvd j)
  have hspec : ∀ j : Fin (P.inertiaDeg ℤ),
      (c j : QpAdic p) = (p : QpAdic p) * ((e j : QpInt p) : QpAdic p) :=
    fun j => Classical.choose_spec (hdvd j)
  -- w' := Σ ((e j) : QpAdic) • basis j
  let w' : Wk p P α := ∑ j : Fin (P.inertiaDeg ℤ),
    (((e j : QpInt p) : QpAdic p)) • wBasis p P α hα hgen j
  -- w' ∈ OW (norm ≤ 1):
  have hw'val : ((w' : Wk p P α) : kpAdic p P) =
      wSum p P α (fun j : Fin (P.inertiaDeg ℤ) => ((e j : QpInt p) : QpAdic p)) := by
    dsimp [w']
    exact basisComb_value_eq_wSum p P α hα hgen
      (fun j : Fin (P.inertiaDeg ℤ) => ((e j : QpInt p) : QpAdic p))
  have hterm1 : ∀ j : Fin (P.inertiaDeg ℤ),
      ‖algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
          (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))‖ ≤ 1 := by
    intro j
    calc
      ‖algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
          (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))‖
          = ‖algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p))‖ *
              ‖(((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))‖ := by
            rw [norm_mul]
      _ ≤ 1 := by
            have h1 : ‖algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p))‖ ≤ 1 :=
              (scalar_norm_le_one_iff p P (((e j : QpInt p) : QpAdic p))).mpr (qpInt_norm_le_one p (e j))
            have h2 : ‖(((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))‖ ≤ 1 := by
              rw [norm_pow]
              calc
                ‖((teich p P α : kpInt p P) : kpAdic p P)‖ ^ (j : ℕ)
                    ≤ 1 ^ (j : ℕ) := pow_le_pow_left₀ (norm_nonneg _) (norm_le_one p P (teich p P α)) (j : ℕ)
                _ = 1 := by simp
            have hmul : ‖algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p))‖ *
                  ‖(((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))‖ ≤ 1 * 1 := by
              exact mul_le_mul h1 h2 (norm_nonneg _) (by norm_num)
            simpa using hmul
  have hwsum1 : ‖wSum p P α (fun j : Fin (P.inertiaDeg ℤ) => ((e j : QpInt p) : QpAdic p))‖ ≤ 1 := by
    simpa [wSum] using (norm_sum_type_le_of_le (S := kpAdic p P) (ι := Fin (P.inertiaDeg ℤ))
      (x := fun j : Fin (P.inertiaDeg ℤ) => algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
        (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))) hterm1)
  have hw'le1 : ‖((w' : Wk p P α) : kpAdic p P)‖ ≤ 1 := by
    rw [hw'val]
    exact hwsum1
  have hw'OW : w' ∈ OW p P α := mem_OW_of_norm_le_one p P α w' hw'le1
  let u : OW_subring p P α := ⟨w', hw'OW⟩
  -- value equality: w0 = p-scalar-value · w'-value
  have hpe : algebraMap (QpAdic p) (kpAdic p P) (p : QpAdic p) = (p : kpAdic p P) := by
    exact map_natCast (algebraMap (QpAdic p) (kpAdic p P)) p
  have hmain_val : (w0 : kpAdic p P) = (p : kpAdic p P) * ((w' : Wk p P α) : kpAdic p P) := by
    calc
      (w0 : kpAdic p P) = wSum p P α c := hval
      _ = (p : kpAdic p P) * wSum p P α (fun j : Fin (P.inertiaDeg ℤ) => ((e j : QpInt p) : QpAdic p)) := by
        -- per-term c j = p·(e j): c j in the scalar ring
        calc
          wSum p P α c
              = (∑ j : Fin (P.inertiaDeg ℤ), algebraMap (QpAdic p) (kpAdic p P) (c j) *
                  (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))) := by rfl
          _ = (∑ j : Fin (P.inertiaDeg ℤ), algebraMap (QpAdic p) (kpAdic p P)
                  ((p : QpAdic p) * ((e j : QpInt p) : QpAdic p)) *
                  (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))) := by
                apply Finset.sum_congr rfl
                intro j hj
                rw [hspec j]
          _ = (∑ j : Fin (P.inertiaDeg ℤ), (p : kpAdic p P) *
                  (algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
                    (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ)))) := by
                apply Finset.sum_congr rfl
                intro j hj
                rw [map_mul]
                rw [hpe]
                ring
          _ = (p : kpAdic p P) * (∑ j : Fin (P.inertiaDeg ℤ),
                  algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
                    (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))) := by
                have hmf : (p : kpAdic p P) * (∑ j : Fin (P.inertiaDeg ℤ),
                      algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
                        (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ)))
                    = ∑ j : Fin (P.inertiaDeg ℤ), (p : kpAdic p P) *
                        (algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
                          (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ))) :=
                  Finset.mul_sum (s := Finset.univ)
                    (f := fun j : Fin (P.inertiaDeg ℤ) => algebraMap (QpAdic p) (kpAdic p P) (((e j : QpInt p) : QpAdic p)) *
                      (((teich p P α : kpInt p P) : kpAdic p P) ^ (j : ℕ)))
                    (a := (p : kpAdic p P))
                exact hmf.symm
          _ = (p : kpAdic p P) * wSum p P α (fun j : Fin (P.inertiaDeg ℤ) => ((e j : QpInt p) : QpAdic p)) := by rfl
      _ = (p : kpAdic p P) * ((w' : Wk p P α) : kpAdic p P) := by rw [hw'val]
  -- Wk-level: w0 = (p : QpAdic) • w'
  have hmain_Wk : w0 = (p : QpAdic p) • w' := by
    apply Wk_coe_injective p P α
    calc
      (w0 : kpAdic p P) = (p : kpAdic p P) * ((w' : Wk p P α) : kpAdic p P) := hmain_val
      _ = (((p : QpAdic p) • w' : Wk p P α) : kpAdic p P) := by
        rw [show (((p : QpAdic p) • w' : Wk p P α) : kpAdic p P) =
            algebraMap (QpAdic p) (kpAdic p P) (p : QpAdic p) * ((w' : Wk p P α) : kpAdic p P) by rfl]
        rw [hpe]
  -- OW_subring-level: w = pOW · u
  have hmemspan : w ∈ Ideal.span ({pOW p P α} : Set (OW_subring p P α)) := by
    rw [Ideal.mem_span_singleton]
    refine ⟨u, ?_⟩
    apply Subtype.ext
    -- (w : Wk) = ((pOW · u : OW_subring) : Wk):
    change (((w : OW_subring p P α) : Wk p P α)) = (((pOW p P α * u : OW_subring p P α) : Wk p P α))
    have huval : (((pOW p P α * u : OW_subring p P α) : Wk p P α)) = (p : QpAdic p) • w' := by
      -- pOW = (p : OW_subring): value p in Wk; multiply by w':
      dsimp [u, w', pOW]
      rw [← map_natCast (algebraMap (QpAdic p) (Wk p P α)) p]
      rw [Algebra.smul_def]
    rw [huval]
    exact hmain_Wk
  exact hmemspan


/-- **e(W)=1 (b2 COMPLETE)**: the maximal ideal of the valuation subring
`𝒪_W` of the Teichmüller subfield `W = ℚ_p(ζ)` is generated by the image of
the base uniformizer `p`: `𝔪_W = (p)·𝒪_W`.  (The reverse inclusion is
`pOW_span_le_ker` from OWBasic.) -/
theorem OW_ker_eq_span_pOW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    {α : kap p P} (hα : α ≠ 0)
    (hgen : orderOf (Units.mk0 α hα) = p ^ P.inertiaDeg ℤ - 1) :
    OW_ker p P α = Ideal.span ({pOW p P α} : Set (OW_subring p P α)) := by
  exact le_antisymm (OW_ker_le_span_pOW p P hα hgen) (pOW_span_le_ker p P α)


end
end Submission.Vdw.LocalField
