/-!
# WildTrace — the level-k (wild) trace computation of the S1 gate

The S1 gate is the per-prime wild different bound
`m_P := (normalizedFactors (differentIdeal ℤ (𝓞 K))).count P ≤ e−1+e·v_p(e)`,
`e := P.ramificationIdx ℤ`, reduced (Session-118, `WildDifferent.lean`) to the
divisibility form `¬ P^(e·(v+1)) ∣ 𝔡` (`v := padicValNat p e`) and then to a
**wild trace witness at level `v`** (`wild_count_le_of_wild_witness`): an
element `y ∈ Q^(v+1)` of the coprime factor `Q` of the splitting
`(p) = P^e·Q` whose integer trace is not divisible by `p^(v+1)`.  The tame
analogue (level `0`) is the commons witness
(`Commons.NumberTheory.NumberField.TameDifferent.exists_witness_of_tame`,
built from `trace_pow_quotient_eq_nsmul` +
`trace_mod_eq_trace_pow_quotient`); the WILD case `p | e` needs the level-`k`
analogue (`k := v`): trace computations **modulo `p^(k+1)`** over the finite
quotient `𝓞K/P^(e·(k+1))` (Conrad "The Different Ideal", Thm 4.12; Roadmap
Session-119/120 analysis).

This module opens that chapter.  What is already in place:

* the finite-quotient transport layer (Session-124, `GlobalLocal.lean`):
  `𝓞K/P^(e·n) ≃+* kpInt/(p^n)` and the completed freeness
  `kpInt/(p^(k+1)) ≅ (QpInt/(p^(k+1)))^(e·f)` (`KpFree`),
  `kpInt/(p^(k+1)) = kpInt/𝔪^(e·(k+1))` (`KpVal`);
* the local trace atoms of the unramified part (Sessions 96–117):
  `TraceResidue.tr_zeta_int`, `KapTrace` RT1/RT2, `TowerDegree.localTraceIdentity`
  `Tr_{K_P/ℚ_p}(w) = e·Tr_{W/ℚ_p}(w)`.

FIRST LEMMAS (this file) — the ℤ/(p^n)-algebra structure on the global
finite quotient `𝓞K/P^(e·n)`:

* `p_pow_mem_P_pow_mul_ramificationIdx` — the integer `p^n` lies in
  `P^(e·n)` (kernel condition making `𝓞K/P^(e·n)` a module over
  `ℤ/(p^n)`); built from the generic commons
  `map_le_pow_ramificationIdx` + `Ideal.map_pow`;
* `quotientMap_int_pow` / `instAlgebraQuotientRamIdxPow` — the canonical
  quotient map `ℤ/(p^n) → 𝓞K/P^(e·n)` (Ideal.Quotient.lift) and the
  resulting `Algebra (ℤ ⧸ (p^n)) (𝓞K ⧸ P^(e·n))` instance;
* `module_finite_quotientRamIdxPow` — `Module.Finite` over `ℤ/(p^n)`
  (the quotient is a quotient of the finite-type ℤ-module `𝓞K`).

NEXT (dependency order, each bounded but substantial — Roadmap Session-120):
1. **freeness**: `Module.Free (ℤ/(p^(k+1))) (𝓞K/P^(e(k+1)))` of rank `e·f`
   (Session-120 "basis theorem") — routes: (i) global `𝓞K/(p^(k+1))` free of
   rank `[K:ℚ]` over `ℤ/(p^(k+1))` (reduce a ℤ-basis) + CRT product
   decomposition over the primes of `(p)` + direct-summand freeness over the
   local ring `ℤ/(p^(k+1))` (`Module.free_of_flat_of_isLocalRing`); or (ii)
   transport of the completed freeness through `globalLocal_quotientIso`;
2. the trace-reduction identity at modulus `p^(k+1)`:
   `Tr_{ℤ/(p^(k+1))}(𝓞K ⧸ (p^(k+1))𝓞K)(mk y) = mk(Algebra.intTrace y)`
   (analogue of `Algebra.trace_quotient_mk`, which Mathlib has only for the
   maximal-ideal case; needs the free-basis + matrix-trace argument);
3. the CRT level-`(k+1)` splitting (pattern of the commons
   `trace_mod_eq_trace_pow_quotient` with ideals raised to `(k+1)`, using
   `Ideal.quotientMulEquivQuotientProd` + `Algebra.trace_prod_apply`) and the
   level-`k` trace identity `Tr_{ℤ/p^(k+1)}(𝓞K/P^(e(k+1)))(mk z) ≡
   u·(residue trace)·p^k`-form for `e = p^k·u`, `p ∤ u`;
4. the witness assembly (choose `z`, CRT-lift `y`, feed
   `wild_count_le_of_wild_witness`), closing `hwild` and hence S1.

Axioms of every statement: propext / Classical.choice / Quot.sound only.
-/

namespace Submission.Vdw.LocalField

noncomputable section

universe u

variable {K : Type u} [Field K] [NumberField K]

/-- The prime ideal of `ℤ` generated by `p^n`. -/
abbrev pPowIdeal (p n : ℕ) : Ideal ℤ := Ideal.span ({((p ^ n : ℕ) : ℤ)} : Set ℤ)

/-- Ideal powers are monotone in the ideal. -/
lemma pow_le_pow_of_le {R : Type*} [CommSemiring R] {I J : Ideal R} (h : I ≤ J) (n : ℕ) :
    I ^ n ≤ J ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, pow_succ]
      apply Ideal.mul_le.mpr
      intro a ha b hb
      exact Ideal.mul_mem_mul (ih ha) (h hb)

/-- **`p^n ∈ P^(e·n)`**: the integer `p^n` lies in the `e·n`-th power of the
prime `P` (`e := P.ramificationIdx ℤ`).  This is the kernel condition making
the quotient `𝓞K ⧸ P^(e·n)` a module over `ℤ/(p^n)`. -/
lemma p_pow_mem_P_pow_mul_ramificationIdx (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))] (n : ℕ) :
    ((p ^ n : ℕ) : 𝓞 K) ∈ P ^ (P.ramificationIdx ℤ * n) := by
  classical
  have hpne : Ideal.span ({(p : ℤ)} : Set ℤ) ≠ ⊥ := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact_mod_cast (Nat.Prime.ne_zero (Fact.out : Nat.Prime p))
  have hbase : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span ({(p : ℤ)} : Set ℤ))
      ≤ P ^ P.ramificationIdx ℤ :=
    Commons.NumberTheory.NumberField.map_le_pow_ramificationIdx
      (Ideal.span ({(p : ℤ)} : Set ℤ)) P hpne
  have hpZ : ((p ^ n : ℕ) : ℤ) ∈ (Ideal.span ({(p : ℤ)} : Set ℤ)) ^ n := by
    rw [Ideal.span_singleton_pow]
    exact Submodule.mem_span_singleton_self _
  have hφ : (algebraMap ℤ (𝓞 K) ((p ^ n : ℕ) : ℤ)) ∈
      (Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span ({(p : ℤ)} : Set ℤ))) ^ n := by
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem (algebraMap ℤ (𝓞 K)) hpZ
  have hle : (Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span ({(p : ℤ)} : Set ℤ))) ^ n ≤
      P ^ (P.ramificationIdx ℤ * n) := by
    calc
      (Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span ({(p : ℤ)} : Set ℤ))) ^ n
          ≤ (P ^ P.ramificationIdx ℤ) ^ n := pow_le_pow_of_le hbase n
      _ = P ^ (P.ramificationIdx ℤ * n) := by rw [pow_mul]
  have hφ' : (algebraMap ℤ (𝓞 K) ((p ^ n : ℕ) : ℤ)) ∈ P ^ (P.ramificationIdx ℤ * n) := hle hφ
  simpa using hφ'

/-- **The canonical quotient map `ℤ/(p^n) → 𝓞K ⧸ P^(e·n)`** (the ℤ-algebra
structure of the global finite quotient at the ramified prime over `ℤ/(p^n)`,
`e := P.ramificationIdx ℤ`). -/
noncomputable def quotientMap_int_pow (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))] (n : ℕ) :
    (ℤ ⧸ (pPowIdeal p n)) →+* (𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n) :=
  Ideal.Quotient.lift (pPowIdeal p n)
    ((Ideal.Quotient.mk (P ^ (P.ramificationIdx ℤ * n))).comp (algebraMap ℤ (𝓞 K))) (by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨c, hc⟩
      have hmain : (algebraMap ℤ (𝓞 K) x) ∈ P ^ (P.ramificationIdx ℤ * n) := by
        have hx' : (algebraMap ℤ (𝓞 K)) x = (algebraMap ℤ (𝓞 K)) (((p ^ n : ℕ) : ℤ) * c) := by
          rw [hc]
        rw [hx', map_mul]
        have hcast : (algebraMap ℤ (𝓞 K)) (((p ^ n : ℕ) : ℤ)) = ((p ^ n : ℕ) : 𝓞 K) := by simp
        rw [hcast]
        exact (P ^ (P.ramificationIdx ℤ * n)).mul_mem_right (algebraMap ℤ (𝓞 K) c)
          (p_pow_mem_P_pow_mul_ramificationIdx p P n)
      exact (Ideal.Quotient.eq_zero_iff_mem.mpr hmain))

/-- **Instance**: `𝓞K ⧸ P^(e·n)` is an algebra over `ℤ/(p^n)` (`e :=
P.ramificationIdx ℤ`) — the scalar ring of the level-`n` trace computations. -/
noncomputable instance instAlgebraQuotientRamIdxPow (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))] (n : ℕ) :
    Algebra (ℤ ⧸ (pPowIdeal p n)) ((𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)) :=
  RingHom.toAlgebra (quotientMap_int_pow p P n)

/-- The quotient `𝓞K ⧸ P^(e·n)` is finite-type over `ℤ/(p^n)` (quotient of
the finite-type ℤ-module `𝓞K`; the `ℤ`-generators still generate over
`ℤ/(p^n)` because `(p^n)·𝓞K ⊆ P^(e·n)`). -/
lemma finite_quotientRamIdxPow (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))] (n : ℕ) :
    Finite ((𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)) := by
  classical
  have hpne : Ideal.span ({(p : ℤ)} : Set ℤ) ≠ ⊥ := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact_mod_cast (Nat.Prime.ne_zero (Fact.out : Nat.Prime p))
  have hPne : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot hpne P
  have hPpow : P ^ (P.ramificationIdx ℤ * n) ≠ ⊥ := pow_ne_zero _ hPne
  exact Ring.HasFiniteQuotients.finiteQuotient (R := 𝓞 K) hPpow

/-- The quotient `𝓞K ⧸ P^(e·n)` is finite-type over `ℤ/(p^n)` (its carrier is
finite; `Module.Finite.of_finite`). -/
lemma module_finite_quotientRamIdxPow (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))] (n : ℕ) :
    Module.Finite (ℤ ⧸ (pPowIdeal p n)) ((𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)) := by
  classical
  haveI : Finite ((𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)) := finite_quotientRamIdxPow p P n
  infer_instance



/-! ## Freeness of the full `(p^n)`-quotient over `ℤ/(p^n)` (Session-125)

The full quotient `𝓞K ⧸ ((p^n)·𝓞K)` is free over `R := ℤ ⧸ (p^n)` of rank
`r := Module.finrank ℤ (𝓞K)`: the reduction of a ℤ-basis of `𝓞K` is a basis
over `R`.  Concretely:

* `fullQuotIdeal p n` — the ideal `(p^n)·𝓞K` of the full quotient;
* `instAlgebraQuotientIntPow` — the `R`-algebra structure on the full
  quotient (`ℤ/(p^n) → 𝓞K/((p^n)·𝓞K)` is well defined because the ideal
  `(p^n : ℤ)` maps into `(p^n)·𝓞K`);
* `full_quotient_basis` — the basis (reduction of the ℤ-basis);
* `module_free_quotient_int_pow` — `Module.Free R (𝓞K ⧸ (p^n)𝓞K)`.

This is the (a)-piece of the Session-125 freeness roadmap (route (i)); the
CRT decomposition to the single-prime quotients `𝓞K/P^(e·n)` follows next.
-/

/-- The ideal `(p^n)·𝓞K` of the full `(p^n)`-quotient. -/
abbrev fullQuotIdeal (p n : ℕ) : Ideal (𝓞 K) :=
  (pPowIdeal p n).map (algebraMap ℤ (𝓞 K))

/-- The ideal `(p^n)·𝓞K` is generated by `(p^n : 𝓞K)`. -/
lemma fullQuotIdeal_eq_span (p n : ℕ) :
    fullQuotIdeal p n = Ideal.span ({((p ^ n : ℕ) : 𝓞 K)} : Set (𝓞 K)) := by
  dsimp [fullQuotIdeal, pPowIdeal]
  rw [Ideal.map_span]
  rw [Set.image_singleton]
  simp

/-- Algebra structure: `𝓞K ⧸ (p^n)·𝓞K` over `ℤ/(p^n)`. -/
noncomputable def quotientMap_int_pow_full (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) :
    (ℤ ⧸ (pPowIdeal p n)) →+* (𝓞 K) ⧸ (fullQuotIdeal p n) :=
  Ideal.Quotient.lift (pPowIdeal p n)
    ((Ideal.Quotient.mk (fullQuotIdeal p n)).comp (algebraMap ℤ (𝓞 K))) (by
      intro x hx
      apply (Ideal.Quotient.eq_zero_iff_mem).mpr
      exact Ideal.mem_map_of_mem (algebraMap ℤ (𝓞 K)) hx)

/-- Instance: the full quotient is an algebra over `ℤ/(p^n)`. -/
noncomputable instance instAlgebraQuotientIntPow (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) :
    Algebra (ℤ ⧸ (pPowIdeal p n)) ((𝓞 K) ⧸ (fullQuotIdeal p n)) :=
  RingHom.toAlgebra (quotientMap_int_pow_full p n)

/-- The algebra map on `ℤ/(p^n)` sends the class of `z` to the class of the
image of `z` in `𝓞K`. -/
lemma algebraMap_quotientIntPow_apply (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) (z : ℤ) :
    algebraMap (ℤ ⧸ (pPowIdeal p n)) ((𝓞 K) ⧸ (fullQuotIdeal p n))
      (Ideal.Quotient.mk (pPowIdeal p n) z) =
    Ideal.Quotient.mk (fullQuotIdeal p n) (algebraMap ℤ (𝓞 K) z) := by
  rfl

/-- In the ℤ-module `𝓞K`, multiplication by the image of an integer is the
module action of the integer. -/
lemma int_algebra_mul_smul (a : ℤ) (x : 𝓞 K) :
    (algebraMap ℤ (𝓞 K) a) * x = a • x :=
  (Algebra.smul_def a x).symm

/-- Same for a natural number viewed in `𝓞K`. -/
lemma nat_algebra_mul_smul (a : ℕ) (x : 𝓞 K) :
    ((a : ℕ) : 𝓞 K) * x = ((a : ℕ) : ℤ) • x := by
  calc
    ((a : ℕ) : 𝓞 K) * x = (algebraMap ℤ (𝓞 K) ((a : ℕ) : ℤ)) * x := by simp
    _ = ((a : ℕ) : ℤ) • x := int_algebra_mul_smul ((a : ℕ) : ℤ) x

/-- Scalar-multiplication on the full quotient: the class of `z` acts as the
class of the action of `z`. -/
lemma smul_quotientIntPow_mk (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) (z : ℤ) (x : 𝓞 K) :
    (Ideal.Quotient.mk (pPowIdeal p n) z) •
      Ideal.Quotient.mk (fullQuotIdeal p n) x =
    Ideal.Quotient.mk (fullQuotIdeal p n) (z • x) := by
  rw [Algebra.smul_def]
  rw [algebraMap_quotientIntPow_apply p n z]
  rw [← map_mul]
  congr 1
  exact int_algebra_mul_smul z x

/-- The class of a ℤ-combination equals the R-combination of the classes
(the bridge between ℤ-basis representations and R-linear combinations). -/
lemma mk_sum_smul_mk_basis (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ)
    (v : Fin (Module.finrank ℤ (𝓞 K)) → ℤ) :
    (∑ i : Fin (Module.finrank ℤ (𝓞 K)),
        (Ideal.Quotient.mk (pPowIdeal p n) (v i)) •
          Ideal.Quotient.mk (fullQuotIdeal p n) (Module.finBasis ℤ (𝓞 K) i)) =
    Ideal.Quotient.mk (fullQuotIdeal p n)
      (∑ i : Fin (Module.finrank ℤ (𝓞 K)), v i • Module.finBasis ℤ (𝓞 K) i) := by
  classical
  let r := Module.finrank ℤ (𝓞 K)
  let b : Module.Basis (Fin r) ℤ (𝓞 K) := Module.finBasis ℤ (𝓞 K)
  calc
    (∑ i : Fin r, (Ideal.Quotient.mk (pPowIdeal p n) (v i)) • Ideal.Quotient.mk (fullQuotIdeal p n) (b i))
        = ∑ i : Fin r, Ideal.Quotient.mk (fullQuotIdeal p n) (v i • b i) := by
          exact Finset.sum_congr rfl (fun i hi => smul_quotientIntPow_mk (p := p) n (v i) (b i))
    _ = Ideal.Quotient.mk (fullQuotIdeal p n) (∑ i : Fin r, v i • b i) := by
          rw [map_sum]

/-- A ℤ-basis of `𝓞K` is linearly independent after reduction modulo
`(p^n)` (the ℤ-basis representation of an element of `(p^n)·𝓞K` has all
coefficients divisible by `p^n`). -/
lemma full_quotient_basis_linearIndependent (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) :
    LinearIndependent (ℤ ⧸ (pPowIdeal p n))
      (fun i : Fin (Module.finrank ℤ (𝓞 K)) =>
        Ideal.Quotient.mk (fullQuotIdeal p n) (Module.finBasis ℤ (𝓞 K) i)) := by
  classical
  let r := Module.finrank ℤ (𝓞 K)
  let b : Module.Basis (Fin r) ℤ (𝓞 K) := Module.finBasis ℤ (𝓞 K)
  rw [linearIndependent_iff]
  intro f hsum
  have hchoice : ∀ i, ∃ z : ℤ, Ideal.Quotient.mk (pPowIdeal p n) z = f i := by
    intro i
    exact Ideal.Quotient.mk_surjective (f i)
  let c : Fin r → ℤ := fun i => Classical.choose (hchoice i)
  have hc (i : Fin r) : Ideal.Quotient.mk (pPowIdeal p n) (c i) = f i :=
    Classical.choose_spec (hchoice i)
  have hlin : (f.sum fun i a => a • Ideal.Quotient.mk (fullQuotIdeal p n) (b i)) = 0 := by
    simpa [Finsupp.linearCombination_apply] using hsum
  have hsumU : (∑ i : Fin r, f i • Ideal.Quotient.mk (fullQuotIdeal p n) (b i)) = 0 := by
    rwa [Finsupp.sum_fintype f (fun i a => a • Ideal.Quotient.mk (fullQuotIdeal p n) (b i))
      (fun i => zero_smul _ _)] at hlin
  have hmem : (∑ i : Fin r, c i • b i) ∈ fullQuotIdeal p n := by
    have hzero : Ideal.Quotient.mk (fullQuotIdeal p n) (∑ i : Fin r, c i • b i) = 0 := by
      rw [← mk_sum_smul_mk_basis (p := p) n c]
      have hconv : (∑ i : Fin r, (Ideal.Quotient.mk (pPowIdeal p n) (c i)) •
            Ideal.Quotient.mk (fullQuotIdeal p n) (b i)) =
            (∑ i : Fin r, f i • Ideal.Quotient.mk (fullQuotIdeal p n) (b i)) := by
        exact Finset.sum_congr rfl (fun i hi => by rw [hc i])
      rw [hconv]
      exact hsumU
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hzero
  rw [fullQuotIdeal_eq_span, Submodule.mem_span_singleton] at hmem
  rcases hmem with ⟨t, ht⟩
  -- ht : t • ((p^n : ℕ) : 𝓞 K) = Σ (c i) • b i  (module-action form of a*b = x)
  ext i
  have hR : b.repr (t • ((p ^ n : ℕ) : 𝓞 K)) = ((p ^ n : ℕ) : ℤ) • b.repr t := by
    calc
      b.repr (t • ((p ^ n : ℕ) : 𝓞 K))
          = b.repr (((p ^ n : ℕ) : ℤ) • t) := by
            congr 1
            calc
              t • ((p ^ n : ℕ) : 𝓞 K) = t * ((p ^ n : ℕ) : 𝓞 K) := by rfl
              _ = ((p ^ n : ℕ) : 𝓞 K) * t := by rw [mul_comm]
              _ = ((p ^ n : ℕ) : ℤ) • t := nat_algebra_mul_smul (p ^ n) t
      _ = ((p ^ n : ℕ) : ℤ) • b.repr t := by
            exact map_smul (b.repr) ((p ^ n : ℕ) : ℤ) t
  have hl' : b.repr (∑ j : Fin r, c j • b j) = ((p ^ n : ℕ) : ℤ) • b.repr t := by
    calc
      b.repr (∑ j : Fin r, c j • b j) = b.repr (t • ((p ^ n : ℕ) : 𝓞 K)) := by
            rw [← ht]
      _ = ((p ^ n : ℕ) : ℤ) • b.repr t := hR
  have hL : (b.repr (∑ j : Fin r, c j • b j)) i = c i := by
    have hsum : b.repr (∑ j : Fin r, c j • b j) = Finsupp.equivFunOnFinite.symm c := by
      calc
        b.repr (∑ j : Fin r, c j • b j) = ∑ j : Fin r, b.repr (c j • b j) := by rw [map_sum]
        _ = ∑ j : Fin r, (c j : ℤ) • b.repr (b j) := by
              refine Finset.sum_congr rfl (fun j hj => ?_)
              rw [map_smul]
        _ = ∑ j : Fin r, (c j : ℤ) • Finsupp.single j (1 : ℤ) := by
              refine Finset.sum_congr rfl (fun j hj => ?_)
              congr 1
              exact b.repr_self j
        _ = Finsupp.equivFunOnFinite.symm c := by
              rw [Finsupp.equivFunOnFinite_symm_eq_sum]
              refine Finset.sum_congr rfl (fun j hj => ?_)
              ext a
              by_cases ha : a = j <;> simp [ha]
    calc
      (b.repr (∑ j : Fin r, c j • b j)) i = (Finsupp.equivFunOnFinite.symm c) i := by rw [hsum]
      _ = c i := by simp
  have hcoef : c i = ((p ^ n : ℕ) : ℤ) * b.repr t i := by
    calc
      c i = (b.repr (∑ j : Fin r, c j • b j)) i := by rw [← hL]
      _ = (((p ^ n : ℕ) : ℤ) • b.repr t) i := by rw [hl']
      _ = ((p ^ n : ℕ) : ℤ) * b.repr t i := by simp
  have hdiv : ((p ^ n : ℕ) : ℤ) ∣ c i := by
    exact ⟨b.repr t i, hcoef⟩
  have hfi0 : f i = 0 := by
    rw [← hc i]
    apply (Ideal.Quotient.eq_zero_iff_mem).mpr
    rw [Ideal.mem_span_singleton]
    exact hdiv
  exact hfi0

/-- The reduced ℤ-basis spans the full quotient. -/
lemma full_quotient_basis_span (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) :
    Submodule.span (ℤ ⧸ (pPowIdeal p n))
      (Set.range (fun i : Fin (Module.finrank ℤ (𝓞 K)) =>
        Ideal.Quotient.mk (fullQuotIdeal p n) (Module.finBasis ℤ (𝓞 K) i))) = ⊤ := by
  classical
  let r := Module.finrank ℤ (𝓞 K)
  let b : Module.Basis (Fin r) ℤ (𝓞 K) := Module.finBasis ℤ (𝓞 K)
  apply Submodule.eq_top_iff'.mpr
  intro x
  rcases Ideal.Quotient.mk_surjective x with ⟨a, rfl⟩
  have ha : a = ∑ i : Fin r, (b.repr a) i • b i := (b.sum_repr a).symm
  rw [ha, map_sum]
  refine Submodule.sum_mem _ (fun i hi => ?_)
  rw [← smul_quotientIntPow_mk (p := p) n ((b.repr a) i) (b i)]
  exact Submodule.smul_mem _ (Ideal.Quotient.mk (pPowIdeal p n) ((b.repr a) i))
    (Submodule.subset_span ⟨i, rfl⟩)

/-- **The full `(p^n)`-quotient has the reduced ℤ-basis as a basis over
`ℤ/(p^n)`** — `𝓞K ⧸ (p^n)𝓞K ≅ (ℤ/(p^n))^r`, `r := finrank ℤ 𝓞K`. -/
noncomputable def full_quotient_basis (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) :
    Module.Basis (Fin (Module.finrank ℤ (𝓞 K))) (ℤ ⧸ (pPowIdeal p n))
      ((𝓞 K) ⧸ (fullQuotIdeal p n)) :=
  Module.Basis.mk (full_quotient_basis_linearIndependent p n)
    (full_quotient_basis_span p n).ge

/-- **The full quotient is free over `ℤ/(p^n)`** (rank `[K : ℚ]`). -/
lemma module_free_quotient_int_pow (p : ℕ) [Fact (Nat.Prime p)] (n : ℕ) :
    Module.Free (ℤ ⧸ (pPowIdeal p n)) ((𝓞 K) ⧸ (fullQuotIdeal p n)) :=
  Module.Free.of_basis (full_quotient_basis p n)


/-! ## CRT splitting block (Session-126): the level-`n` decomposition

With the level-1 splitting `(p)·𝓞K = P^e·Q`, `P ⊔ Q = ⊤` (the tame commons
`TameDifferent.p₀_map_eq_pow_mul`), the `(p^n)`-quotient decomposes:

* `split_ideal_pow` — raising to level `n`: `(p^n)·𝓞K = P^(e·n)·Q^n`;
* `sup_eq_top_of_pow_pow` — `P^(e·n) ⊔ Q^n = ⊤` (comaximal raised powers);
* **`crt_ramified_quotient_iso`** — the CRT ring isomorphism
  `𝓞K ⧸ (p^n)𝓞K ≃+* (𝓞K ⧸ P^(e·n)) × (𝓞K ⧸ Q^n)`
  (`Ideal.quotEquivOfEq` of the raised splitting + `Ideal.quotientMulEquivQuotientProd`).

This is the splitting block of the Session-125 freeness roadmap (route (i)
(b)-piece): it makes the single-prime quotient `𝓞K ⧸ P^(e·n)` a direct
summand of the free `ℤ/(p^n)`-module `𝓞K ⧸ (p^n)𝓞K`, from which
`Module.Free (ℤ/(p^n)) (𝓞K ⧸ P^(e·n))` follows (next, with the
`IsLocalRing (ℤ/(p^n))` construction).  Axioms of every statement:
propext / Classical.choice / Quot.sound only.
-/

/-- Raising the level-1 splitting `(p)·𝓞K = P^e·Q` to level `n`:
`(p^n)·𝓞K = P^(e·n)·Q^n`. -/
lemma split_ideal_pow (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (Q : Ideal (𝓞 K))
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (n : ℕ) :
    (pPowIdeal p n).map (algebraMap ℤ (𝓞 K)) =
      P ^ (P.ramificationIdx ℤ * n) * Q ^ n := by
  classical
  have hmap : (pPowIdeal p n).map (algebraMap ℤ (𝓞 K)) =
      ((Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K))) ^ n := by
    calc
      (pPowIdeal p n).map (algebraMap ℤ (𝓞 K))
          = (Ideal.span ({(p : ℤ)} : Set ℤ) ^ n).map (algebraMap ℤ (𝓞 K)) := by
            dsimp [pPowIdeal]
            congr 1
            rw [← Ideal.span_singleton_pow]
      _ = ((Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K))) ^ n := by
            rw [Ideal.map_pow]
  rw [hmap, hspl]
  rw [mul_pow]
  congr 1
  exact (pow_mul (P) (P.ramificationIdx ℤ) n).symm

/-- Comaximality of raised powers: `P^a ⊔ Q^b = ⊤` from `P ⊔ Q = ⊤`. -/
lemma sup_eq_top_of_pow_pow {R : Type*} [CommRing R] (P Q : Ideal R)
    (hsup : P ⊔ Q = ⊤) (a b : ℕ) : P ^ a ⊔ Q ^ b = ⊤ := by
  classical
  have h1 : P ^ a ⊔ Q = ⊤ := by
    exact Ideal.pow_sup_eq_top (I := P) (J := Q) (n := a) hsup
  have h1c : Q ⊔ P ^ a = ⊤ := by rw [sup_comm]; exact h1
  have h2 : Q ^ b ⊔ P ^ a = ⊤ := by
    exact Ideal.pow_sup_eq_top (I := Q) (J := P ^ a) (n := b) h1c
  rw [sup_comm]
  exact h2

/-- **THE CRT SPLITTING**: `𝓞K ⧸ (p^n)𝓞K ≃+* (𝓞K ⧸ P^(e·n)) × (𝓞K ⧸ Q^n)`,
`e := P.ramificationIdx ℤ`, given the level-1 splitting `hspl` (`P ⊔ Q = ⊤`
from the tame commons splitting `TameDifferent.p₀_map_eq_pow_mul`). -/
noncomputable def crt_ramified_quotient_iso (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (Q : Ideal (𝓞 K)) (hsup : P ⊔ Q = ⊤)
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (n : ℕ) :
    ((𝓞 K) ⧸ (fullQuotIdeal p n)) ≃+*
      (((𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)) × ((𝓞 K) ⧸ Q ^ n)) := by
  classical
  have hprod := split_ideal_pow (p := p) (P := P) Q hspl n
  have hcop : IsCoprime (P ^ (P.ramificationIdx ℤ * n)) (Q ^ n) :=
    (Ideal.isCoprime_iff_sup_eq).mpr (sup_eq_top_of_pow_pow P Q hsup (P.ramificationIdx ℤ * n) n)
  exact (Ideal.quotEquivOfEq hprod).trans (Ideal.quotientMulEquivQuotientProd
    (P ^ (P.ramificationIdx ℤ * n)) (Q ^ n) hcop)


/-! ## Single-prime freeness (Session-126): `𝓞K ⧸ P^(e·n)` free over `ℤ/(p^n)`

With the splitting block (`crt_ramified_quotient_iso`) and the freeness of the
full quotient (`module_free_quotient_int_pow`), the single-prime quotient
`A := 𝓞K ⧸ P^(e·n)` is a direct summand of the free `R := ℤ/(p^n)`-module
`F := 𝓞K ⧸ (p^n)𝓞K`:

* `quotientMap_int_pow_Q` — the `Q^n`-factor algebra map
  `ℤ/(p^n) → 𝓞K ⧸ Q^n` (kernel `(p^n) ⊆ Q^n` from the raised splitting);
* `crt_ramified_quotient_iso_mk` — the CRT iso sends the class of `x` to the
  pair of its classes;
* the CRT iso is an `R`-algebra equivalence (commutes with the scalar
  structures), so `A` is an R-retract of the free module `F`
  (`Module.Projective.of_split`), hence projective, hence flat
  (`Module.Flat.of_projective`); with `Module.Finite` and the local ring
  instance (`Commons.RingTheory.LocalRing.isLocalRing_quotient_int_pow`) the
  theorem `Module.free_of_flat_of_isLocalRing` gives:

* **`module_free_quotientRamIdxPow`** — `Module.Free (ℤ ⧸ (p^n)) (𝓞K ⧸ P^(e·n))`,
  the Session-120 basis theorem (route (i), (b)-piece; rank `e·f` follows
  separately from the cardinality or the completed transport).

Axioms of every statement: propext / Classical.choice / Quot.sound only.
-/

/-- The canonical quotient map `ℤ/(p^n) → 𝓞K/Q^n` (kernel: `(p^n) ⊆ Q^n` from
the raised splitting `(p^n)·𝓞K = P^(e·n)·Q^n ⊆ Q^n`). -/
noncomputable def quotientMap_int_pow_Q (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (Q : Ideal (𝓞 K))
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (n : ℕ) : (ℤ ⧸ (pPowIdeal p n)) →+* (𝓞 K) ⧸ (Q ^ n) :=
  Ideal.Quotient.lift (pPowIdeal p n)
    ((Ideal.Quotient.mk (Q ^ n)).comp (algebraMap ℤ (𝓞 K))) (by
      intro x hx
      apply (Ideal.Quotient.eq_zero_iff_mem).mpr
      have hsplit := split_ideal_pow (p := p) (P := P) Q hspl n
      have hinc : P ^ (P.ramificationIdx ℤ * n) * Q ^ n ≤ Q ^ n := Ideal.mul_le_right
      have hmem1 : (algebraMap ℤ (𝓞 K) x) ∈ (pPowIdeal p n).map (algebraMap ℤ (𝓞 K)) :=
        Ideal.mem_map_of_mem (algebraMap ℤ (𝓞 K)) hx
      have hmem2 : (algebraMap ℤ (𝓞 K) x) ∈ P ^ (P.ramificationIdx ℤ * n) * Q ^ n := by
        rwa [hsplit] at hmem1
      exact hinc hmem2)

/-- The CRT isomorphism sends the class of `x` to the pair of its classes. -/
lemma crt_ramified_quotient_iso_mk (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (Q : Ideal (𝓞 K)) (hsup : P ⊔ Q = ⊤)
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (n : ℕ) (x : 𝓞 K) :
    (crt_ramified_quotient_iso p P Q hsup hspl n)
        (Ideal.Quotient.mk (fullQuotIdeal p n) x) =
      (Ideal.Quotient.mk (P ^ (P.ramificationIdx ℤ * n)) x,
        Ideal.Quotient.mk (Q ^ n) x) := by
  classical
  let J : Ideal (𝓞 K) := P ^ (P.ramificationIdx ℤ * n)
  let Q' : Ideal (𝓞 K) := Q ^ n
  have hprod : fullQuotIdeal p n = J * Q' := by
    dsimp [J, Q']
    exact split_ideal_pow (p := p) (P := P) Q hspl n
  have hcop : IsCoprime J Q' := by
    dsimp [J, Q']
    exact (Ideal.isCoprime_iff_sup_eq).mpr (sup_eq_top_of_pow_pow P Q hsup (P.ramificationIdx ℤ * n) n)
  change ((Ideal.quotEquivOfEq hprod).trans (Ideal.quotientMulEquivQuotientProd J Q' hcop))
    (Ideal.Quotient.mk (fullQuotIdeal p n) x) = (Ideal.Quotient.mk J x, Ideal.Quotient.mk Q' x)
  rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
  apply Prod.ext
  · rw [Ideal.quotientMulEquivQuotientProd_fst]
    exact Ideal.Quotient.factor_mk Ideal.mul_le_left x
  · rw [Ideal.quotientMulEquivQuotientProd_snd]
    exact Ideal.Quotient.factor_mk Ideal.mul_le_right x


/-! ## The CRT `R`-algebra equivalence and both factor freenesses (Session-129)

The CRT ring iso (`crt_ramified_quotient_iso`) commutes with the scalar
structures: each factor's `R := ℤ/(p^n)`-algebra map is `mk ∘ algebraMap ℤ`
(`algebraMap_quotientIntPow_apply`, rfl), so with the local `R`-algebra
instances of the three quotients in scope it upgrades to an `R`-algebra
equivalence `F ≃ₐ[R] A × B`, `F := 𝓞K ⧸ (p^n)𝓞K`, `A := 𝓞K ⧸ P^(e·n)`,
`B := 𝓞K ⧸ Q^n`.  The P-factor `A` is then an `R`-retract of the free module
`F` (`module_free_quotient_int_pow`; inclusion `inl` via `e.symm`, projection
`fst` via `e`), hence projective (`Module.Projective.of_split`), hence flat
(`Module.Flat.of_projective`); with `Module.Finite` and the local-ring
instance of `R = ℤ/(p^n)` (`Commons.RingTheory.LocalRing.isLocalRing_quotient_int_pow`),
`Module.free_of_flat_of_isLocalRing` gives:

* **`module_free_quotientRamIdxPow`** — `Module.Free R A` (P-factor);
* `finite_quotient_Qpow` — finiteness of the Q-factor quotient (the mirror
  `Module.Free R B` argument is identical and is done with local instances
  wherever the level-`(k+1)` trace decomposition needs it; its *statement*
  would need a non-canonical scalar-structure binder, so it is not exported
  here).

Together with `Algebra.trace_prod_apply` this gives the CRT trace
decomposition used by the level-`(k+1)` wild trace.  Axioms of every
statement: propext / Classical.choice / Quot.sound only.
-/

/-- **The P-factor is free over `ℤ ⧸ (p^n)`**: given the level-1 splitting
`(p)·𝓞K = P^e·Q` (`P ⊔ Q = ⊤`), `𝓞K ⧸ P^(e·n)` is free over
`R := ℤ ⧸ (p^n)` (`e := P.ramificationIdx ℤ`, `0 < n`). -/
theorem module_free_quotientRamIdxPow (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (Q : Ideal (𝓞 K)) (hsup : P ⊔ Q = ⊤)
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (n : ℕ) (hn : 0 < n) :
    Module.Free (ℤ ⧸ (pPowIdeal p n)) ((𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)) := by
  classical
  let R := ℤ ⧸ (pPowIdeal p n)
  let A := (𝓞 K) ⧸ P ^ (P.ramificationIdx ℤ * n)
  let B := (𝓞 K) ⧸ Q ^ n
  let F := (𝓞 K) ⧸ (fullQuotIdeal p n)
  letI : P.IsPrime := (inferInstance : P.IsMaximal).isPrime
  letI : Algebra R F := instAlgebraQuotientIntPow p n
  letI : Algebra R A := instAlgebraQuotientRamIdxPow p P n
  letI : Algebra R B := RingHom.toAlgebra (quotientMap_int_pow_Q p P Q hspl n)
  letI : Module.Free R F := module_free_quotient_int_pow p n
  letI : Module.Projective R F := inferInstance
  let eRing := crt_ramified_quotient_iso p P Q hsup hspl n
  have hcomm : ∀ x : R, eRing (algebraMap R F x) = algebraMap R (A × B) x := by
    intro x
    rcases Ideal.Quotient.mk_surjective (I := pPowIdeal p n) x with ⟨z, hz⟩
    rw [← hz]
    calc
      eRing (algebraMap R F (Ideal.Quotient.mk (pPowIdeal p n) z))
          = eRing (Ideal.Quotient.mk (fullQuotIdeal p n) (algebraMap ℤ (𝓞 K) z)) := by
            rw [algebraMap_quotientIntPow_apply p n z]
      _ = (Ideal.Quotient.mk (P ^ (P.ramificationIdx ℤ * n)) (algebraMap ℤ (𝓞 K) z),
           Ideal.Quotient.mk (Q ^ n) (algebraMap ℤ (𝓞 K) z)) := by
            exact crt_ramified_quotient_iso_mk p P Q hsup hspl n (algebraMap ℤ (𝓞 K) z)
      _ = algebraMap R (A × B) (Ideal.Quotient.mk (pPowIdeal p n) z) := by
            apply Prod.ext
            · simp [quotientMap_int_pow, quotientMap_int_pow_Q]
            · simp [quotientMap_int_pow, quotientMap_int_pow_Q]
  let e : F ≃ₐ[R] (A × B) :=
    AlgEquiv.ofRingEquiv (R := R) (A₁ := F) (A₂ := A × B) (f := eRing) hcomm
  let i : A →ₗ[R] F :=
    ((e.symm : (A × B) ≃ₐ[R] F).toLinearMap).comp (LinearMap.inl R A B)
  let s : F →ₗ[R] A :=
    (LinearMap.fst R A B).comp ((e : F →ₐ[R] (A × B)).toLinearMap)
  have hsplitH : s ∘ₗ i = LinearMap.id := by
    ext a
    change LinearMap.fst R A B (e ((e.symm : (A × B) ≃ₐ[R] F) (LinearMap.inl R A B a))) = a
    rw [show e ((e.symm : (A × B) ≃ₐ[R] F) (LinearMap.inl R A B a)) = LinearMap.inl R A B a by
      exact AlgEquiv.apply_symm_apply e (LinearMap.inl R A B a)]
    simp
  haveI : Module.Projective R A := Module.Projective.of_split i s hsplitH
  haveI : Module.Flat R A := inferInstance
  haveI : Module.Finite R A := module_finite_quotientRamIdxPow p P n
  haveI : IsLocalRing R := Commons.RingTheory.LocalRing.isLocalRing_quotient_int_pow p n hn
  exact Module.free_of_flat_of_isLocalRing (R := R) (P := A)

/-- The `Q^n`-quotient is finite (needs `Q ≠ ⊥`, which holds for the coprime
factor of a genuine split). -/
lemma finite_quotient_Qpow (p : ℕ) [Fact (Nat.Prime p)]
    (P : Ideal (𝓞 K)) [P.IsPrime] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (Q : Ideal (𝓞 K))
    (hspl : (Ideal.span ({(p : ℤ)} : Set ℤ)).map (algebraMap ℤ (𝓞 K)) =
      P ^ P.ramificationIdx ℤ * Q)
    (n : ℕ) (hQ : Q ≠ ⊥) : Finite ((𝓞 K) ⧸ (Q ^ n)) := by
  classical
  have hQn : Q ^ n ≠ ⊥ := pow_ne_zero n hQ
  exact Ring.HasFiniteQuotients.finiteQuotient (R := 𝓞 K) hQn


end
