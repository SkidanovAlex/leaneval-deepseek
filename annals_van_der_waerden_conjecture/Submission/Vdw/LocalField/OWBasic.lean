import Mathlib
import Submission.Vdw.LocalField.CyclotomicDegree

open Classical
open scoped NumberField Polynomial WithZero

set_option autoImplicit false
set_option linter.style.haveILetI false

/-!
# Local-field chapter (G3, (b2) opened): first 𝒪_W-lemmas toward `e(W) = 1`

Context: `W = Wk p P α = ℚ_p(ζ)` is the Teichmüller subfield of
`K_P = kpAdic p P` (`ζ := teich p P α`, a lift of `α ∈ κ^×` to a root of
unity of order `q := p^f − 1`, `p ∤ q`), and `𝒪_W = OW_subring p P α`
(`OW`-carrier: elements of `W` with a `kpInt` representative) with maximal
ideal `𝔪_W = OW_ker p P α` (kernel of the reduction `resOW_hom : 𝒪_W → κ`,
`OW_residueEquiv`: `𝒪_W/𝔪_W ≅ κ`, `|𝒪_W/𝔪_W| = p^f`).

This module provides the FIRST lemmas toward the unramifiedness
`e(W) = 1` of `W/ℚ_p` (Roadmap Session-88, stone (b2)) — the "integral
uniformizer data" of `𝒪_W`:

* `zetaW` / `zetaOW` — ζ as an element of `W` and of `𝒪_W`; its residue is
  the generator: `resOW_hom_zeta : resOW ζ = α`; for `α ≠ 0`, ζ ∉ 𝔪_W
  (`zetaOW_not_mem_ker`) and ζ is a UNIT of 𝒪_W with inverse ζ^(q−1)
  (`zetaOW_isUnit`, from `zetaOW_pow_card_sub_one`); in particular the
  residue `ζ̄ = α` generates `κ^×`.
* `pOW` — the base scalar `p` as an element of 𝒪_W; its residue is zero:
  `resOW_hom_pOW : resOW p = 0` (κ has characteristic p), so `p ∈ 𝔪_W`
  (`pOW_mem_ker`) and `p` is NOT a unit of 𝒪_W (`pOW_not_isUnit`).

THE REMAINING CORE of (b2) — `e(W) = 1`, i.e. the maximal ideal of 𝒪_W is
generated by the image of the base uniformizer —

    OW_ker p P α = Ideal.span ({pOW p P α} : Set (OW_subring p P α))

The reverse inclusion is `pOW_mem_ker` + "the ideal spanned by p is contained
in the kernel".  The forward inclusion (every `w ∈ 𝒪_W` with `resOW w = 0`
is divisible by `p` in 𝒪_W) is the honest unramifiedness content; classical
strategy (recorded for the next session): write `w = Σ_{i<f} c_i ζ^i` in the
`ℚ_p`-basis `{1,…,ζ^{f−1}}` of `W` (deg `minpoly ζ = f`, Session-87); the
residues `α^i` are independent over 𝔽_p, so the reduction of `Σ c_i ζ^i`
(mod `p`) vanishes iff every `c_i` is divisible by `p` — i.e. no
"cancellation" into a proper fraction of the value group; hence
`‖w‖_{K_P} < 1 ⟹ w/p` integral.  (The metric formulation: the value group of
`W` inside `K_P` is contained in `e_P·ℤ`, `e_P := P.ramificationIdx ℤ`.)

Axioms of every statement: propext / Classical.choice / Quot.sound only.
-/

namespace Submission.Vdw.LocalField

noncomputable section

universe u

variable {K : Type u} [Field K] [NumberField K]

/-- ζ as an element of the Teichmüller subfield W = ℚ_p(ζ). -/
def zetaW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) : Wk p P α :=
  ⟨(teich p P α : kpAdic p P),
    IntermediateField.mem_adjoin_simple_self (QpAdic p)
      ((teich p P α : kpInt p P) : kpAdic p P)⟩

/-- ζ ∈ 𝒪_W (witness: ζ itself, integral). -/
lemma zetaW_mem_OW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) : zetaW p P α ∈ OW p P α := by
  refine ⟨teich p P α, ?_⟩
  rfl

/-- ζ as an element of the valuation subring 𝒪_W. -/
def zetaOW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) : OW_subring p P α :=
  ⟨zetaW p P α, zetaW_mem_OW p P α⟩

/-- The residue of ζ ∈ 𝒪_W is α: resOW ζ = α. -/
theorem resOW_hom_zeta (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) :
    resOW_hom p P α (zetaOW p P α) = α := by
  change resOW p P α ⟨(zetaOW p P α).1, (zetaOW p P α).2⟩ = α
  have hz : (teich p P α : kpAdic p P) = ((zetaOW p P α).1 : kpAdic p P) := by
    dsimp [zetaOW, zetaW]
  rw [resOW_eq_mk p P α ⟨(zetaOW p P α).1, (zetaOW p P α).2⟩ (teich p P α) hz]
  exact teich_mod_eq p P α

/-- For α ≠ 0, ζ ∉ 𝔪_W (its residue α is nonzero). -/
theorem zetaOW_not_mem_ker (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) (hα : α ≠ 0) :
    zetaOW p P α ∉ OW_ker p P α := by
  intro hmem
  apply hα
  rw [RingHom.mem_ker] at hmem
  rw [resOW_hom_zeta p P α] at hmem
  exact hmem

-- the easy companion: ζ^q = 1 inside the subring 𝒪_W (q = p^f − 1)
theorem zetaOW_pow_card_sub_one (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) (hα : α ≠ 0) :
    zetaOW p P α ^ (p ^ P.inertiaDeg ℤ - 1) = 1 := by
  classical
  let q := p ^ P.inertiaDeg ℤ - 1
  have hζkp : teich p P α ^ q = 1 := by
    dsimp [q]
    exact teich_pow_card_sub_one (p := p) (P := P) (α := α) hα
  have hWpow : zetaW p P α ^ q = 1 := by
    apply Subtype.ext
    -- (zetaW ^ q : kpAdic) = (1 : kpAdic)
    change (((teich p P α : kpInt p P) : kpAdic p P) ^ q : kpAdic p P) = 1
    change (algebraMap (kpInt p P) (kpAdic p P) (teich p P α ^ q) : kpAdic p P) = 1
    rw [hζkp]
    simp
  -- transport into OW_subring
  apply Subtype.ext
  change (zetaW p P α ^ q : Wk p P α) = (1 : Wk p P α)
  exact hWpow

/-- ζ is a unit of 𝒪_W with inverse ζ^(q−1), q := p^f − 1. -/
theorem zetaOW_isUnit (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) (hα : α ≠ 0) :
    IsUnit (zetaOW p P α) := by
  classical
  let q := p ^ P.inertiaDeg ℤ - 1
  have hqpos : 0 < q := by
    dsimp [q]
    have h2 : 2 ≤ p ^ P.inertiaDeg ℤ := kap_pow_pf_ge_two p P
    omega
  have hpow : zetaOW p P α ^ q = 1 := by
    dsimp [q]
    exact zetaOW_pow_card_sub_one p P α hα
  let u : (OW_subring p P α)ˣ :=
    { val := zetaOW p P α
      inv := zetaOW p P α ^ (q - 1)
      val_inv := by
        have hq : q = (q - 1) + 1 := (Nat.succ_pred_eq_of_pos hqpos).symm
        calc
          zetaOW p P α * zetaOW p P α ^ (q - 1)
              = zetaOW p P α ^ ((q - 1) + 1) := by rw [pow_succ']
          _ = zetaOW p P α ^ q := by rw [← hq]
          _ = 1 := hpow
      inv_val := by
        have hq : q = (q - 1) + 1 := (Nat.succ_pred_eq_of_pos hqpos).symm
        calc
          zetaOW p P α ^ (q - 1) * zetaOW p P α
              = zetaOW p P α ^ ((q - 1) + 1) := by rw [pow_succ]
          _ = zetaOW p P α ^ q := by rw [← hq]
          _ = 1 := hpow }
  exact ⟨u, rfl⟩


/-- The scalar p of the base ℚ_p, viewed as an element of the valuation
subring 𝒪_W (integral: natCast into the subring; it is the ℚ_p-scalar
`(p:ℚ)` embedded in W). -/
def pOW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) : OW_subring p P α :=
  (p : OW_subring p P α)

/-- The residue of the scalar p is zero: resOW p = 0 in κ (κ has
characteristic p). -/
theorem resOW_hom_pOW (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) :
    resOW_hom p P α (pOW p P α) = 0 := by
  dsimp [pOW]
  rw [map_natCast]
  haveI : CharP (kap p P) p := by
    simpa [kap] using (kpIntResidue_charP (K := K) p P)
  exact CharP.cast_eq_zero (R := kap p P) p

/-- The scalar p lies in the maximal ideal 𝔪_W of 𝒪_W: p ∈ 𝔪_W.  (Together
with `ζ ∉ 𝔪_W` this shows the base uniformizer of ℚ_p is non-invertible in
𝒪_W while the Teichmüller unit ζ is invertible — the first data toward
`e(W) = 1` (`𝔪_W = (p)`: the maximal ideal of the valuation ring of
`W = ℚ_p(ζ)` is generated by the image of p).) -/
theorem pOW_mem_ker (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) :
    pOW p P α ∈ OW_ker p P α := by
  rw [RingHom.mem_ker]
  exact resOW_hom_pOW p P α

/-- The scalar p is not a unit of 𝒪_W (its residue in κ is zero). -/
theorem pOW_not_isUnit (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) : ¬ IsUnit (pOW p P α) := by
  intro hu
  have hz : IsUnit (0 : kap p P) := by
    convert IsUnit.map (resOW_hom p P α) hu using 1
    exact (resOW_hom_pOW p P α).symm
  haveI : Nontrivial (kap p P) := inferInstance
  exact (not_isUnit_zero (M₀ := kap p P)) hz


/-- **The easy half of `e(W) = 1`**: the ideal of 𝒪_W generated by the base
uniformizer `p` is contained in the maximal ideal 𝔪_W (this is
`pOW_mem_ker` plus the ideal closure of 𝔪_W).  The converse inclusion
(every element of 𝔪_W is a multiple of `p` in 𝒪_W — no "partial
valuations" on `W`) is the unramifiedness content of `e(W) = 1`, recorded
as the next target in the module docstring. -/
theorem pOW_span_le_ker (p : ℕ) [Fact (Nat.Prime p)] (P : Ideal (𝓞 K))
    [P.IsMaximal] [P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))]
    (α : kap p P) :
    Ideal.span ({pOW p P α} : Set (OW_subring p P α)) ≤ OW_ker p P α := by
  rw [Ideal.span_le]
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst x
  exact pOW_mem_ker (p := p) (P := P) (α := α)

end
end Submission.Vdw.LocalField