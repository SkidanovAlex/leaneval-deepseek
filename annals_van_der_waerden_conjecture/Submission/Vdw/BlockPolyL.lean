import Mathlib
import Submission.Vdw.BlockPolyAction
import Submission.Commons.Data.Finset.prod_eq_prod_of_isPartition

open Polynomial
open scoped Pointwise

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

/-!
# The block polynomial over its field of definition, and the block-system product

For `p : ℚ[X]` separable, a block `B` of the naive action of `p.Gal` on the
`n` roots, and `L = blockField p hsep B` (the field generated by the
coefficients of the block polynomial), this module provides

* `blockPoly_coeff_mem` — the coefficients of `blockPoly p hsep B` lie in `L`;
* `blockPolyL` — the block polynomial viewed over `L`, with
  `blockPolyL_coeff` and `blockPolyL_map_val`;
* `blockPoly_factors` — the factorisation of `p` over its splitting field as
  the product of the block polynomials of the translate orbit of `B`.

Axioms: propext / Classical.choice / Quot.sound only.
-/

namespace Submission.Vdw

noncomputable section

/-! ## The coefficients lie in the field of definition -/

lemma blockPoly_coeff_mem (p : ℚ[X]) (hsep : p.Separable) (B : Finset (Fin p.natDegree))
    (i : ℕ) : (blockPoly p hsep B).coeff i ∈ blockField p hsep B := by
  by_cases hi : i < p.natDegree
  · exact IntermediateField.subset_adjoin ℚ _ (Set.mem_range_self (⟨i, hi⟩ : Fin p.natDegree))
  · push Not at hi
    have hcard : B.card ≤ p.natDegree := by simpa using Finset.card_le_univ B
    have hnd : (blockPoly p hsep B).natDegree ≤ i :=
      le_trans (by rw [blockPoly_natDegree]; exact hcard) hi
    rcases lt_or_eq_of_le hnd with hlt | heq
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt]
      exact zero_mem _
    · rw [← heq, Polynomial.coeff_natDegree, (blockPoly_monic p hsep B).leadingCoeff]
      exact one_mem _

/-- The block polynomial, viewed over the field of definition of the block. -/
noncomputable def blockPolyL (p : ℚ[X]) (hsep : p.Separable) (B : Finset (Fin p.natDegree)) :
    (↥(blockField p hsep B))[X] :=
  ∑ i ∈ (blockPoly p hsep B).support,
    C ⟨(blockPoly p hsep B).coeff i, blockPoly_coeff_mem p hsep B i⟩ * X ^ i

lemma blockPolyL_coeff (p : ℚ[X]) (hsep : p.Separable) (B : Finset (Fin p.natDegree))
    (i : ℕ) :
    (blockPolyL p hsep B).coeff i
      = ⟨(blockPoly p hsep B).coeff i, blockPoly_coeff_mem p hsep B i⟩ := by
  apply Subtype.ext
  rw [blockPolyL, finsetSum_coeff]
  by_cases hi : i ∈ (blockPoly p hsep B).support
  · rw [Finset.sum_eq_single i]
    · simp
    · intro j hj hji
      have hij : ¬ (i = j) := fun h => hji h.symm
      simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hij]
    · intro hmem
      exact absurd hi hmem
  · have h0 : (blockPoly p hsep B).coeff i = 0 := by
      simpa [Polynomial.mem_support_iff] using hi
    rw [Finset.sum_eq_zero]
    · show (0 : p.SplittingField) = (blockPoly p hsep B).coeff i
      rw [h0]
    · intro j hj
      have hji : j ≠ i := fun h => hi (h ▸ hj)
      have hij : ¬ (i = j) := fun h => hji h.symm
      simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hij]

lemma blockPolyL_map_val (p : ℚ[X]) (hsep : p.Separable) (B : Finset (Fin p.natDegree)) :
    (blockPolyL p hsep B).map (algebraMap ↥(blockField p hsep B) p.SplittingField)
      = blockPoly p hsep B := by
  ext i
  rw [Polynomial.coeff_map]
  exact congrArg Subtype.val (blockPolyL_coeff p hsep B i)

/-- **The block system product**: `p` is the product of the block polynomials of
the translate orbit of the block `B`. -/
theorem blockPoly_factors (p : ℚ[X]) (hmonic : p.Monic) (hsep : p.Separable)
    [MulAction.IsPretransitive ((galFinHomN p hsep).range) (Fin p.natDegree)]
    {B : Set (Fin p.natDegree)} (hB : MulAction.IsBlock ((galFinHomN p hsep).range) B)
    (hne : B.Nonempty) :
    p.map (algebraMap ℚ p.SplittingField)
      = ∏ C ∈ (Set.toFinite (Set.range fun g : ↥((galFinHomN p hsep).range) => g • B)).toFinset,
          blockPoly p hsep (Set.Finite.toFinset (Set.toFinite (C : Set (Fin p.natDegree)))) := by
  classical
  have hpart : Setoid.IsPartition (Set.range fun g : ↥((galFinHomN p hsep).range) => g • B) :=
    (MulAction.IsBlock.isBlockSystem (G := ↥((galFinHomN p hsep).range)) hB hne).1
  rw [map_eq_prod_rootOf p hmonic hsep]
  rw [Commons.Data.Finset.prod_eq_prod_of_isPartition hpart (Set.toFinite _)
      (fun i : Fin p.natDegree => (X - C (rootOf p hsep i)))]
  exact Finset.prod_congr rfl fun C _ => rfl

end

end Submission.Vdw

namespace Submission.Vdw

noncomputable section

/-- The naive representation is transitive for irreducible `p`. -/
theorem galFinHomN_pretransitive (p : ℚ[X]) (hp : Irreducible p) (hsep : p.Separable)
    [Fact ((p.map (algebraMap ℚ p.SplittingField)).Splits)] :
    MulAction.IsPretransitive ((galFinHomN p hsep).range) (Fin p.natDegree) := by
  have htrans : MulAction.IsPretransitive ((galFinHom p hsep).range) (Fin p.natDegree) :=
    galFinHom_pretransitive p hp hsep
  haveI := htrans
  refine ⟨fun i j => ?_⟩
  obtain ⟨g, hgsmul⟩ := htrans.exists_smul_eq (conjPerm p hsep i) (conjPerm p hsep j)
  obtain ⟨σ, hσ⟩ := g.2
  refine ⟨⟨galFinHomN p hsep σ, ⟨σ, rfl⟩⟩, ?_⟩
  have hgs : (galFinHom p hsep σ) (conjPerm p hsep i) = conjPerm p hsep j := by
    rw [hσ]
    exact hgsmul
  have h4 : (conjPerm p hsep * galFinHomN p hsep σ * (conjPerm p hsep)⁻¹) (conjPerm p hsep i)
      = conjPerm p hsep (galFinHomN p hsep σ i) := by
    have hsym : (conjPerm p hsep)⁻¹ (conjPerm p hsep i) = i := Equiv.symm_apply_apply _ _
    rw [show (conjPerm p hsep * galFinHomN p hsep σ * (conjPerm p hsep)⁻¹) (conjPerm p hsep i)
        = conjPerm p hsep (galFinHomN p hsep σ ((conjPerm p hsep)⁻¹ (conjPerm p hsep i))) from rfl,
      hsym]
  have h5 : conjPerm p hsep (galFinHomN p hsep σ i) = conjPerm p hsep j := by
    rw [← h4, ← galFinHom_conj p hsep σ]
    exact hgs
  exact (conjPerm p hsep).injective h5

end

end Submission.Vdw
