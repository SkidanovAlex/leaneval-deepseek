import Mathlib
import Submission.Work.BW.kcb_lat_defs
import Submission.Work.BW.sieg2KernelDefs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# `Phi` maps the integral lattice into the product of the row ideals

The rows `a i` of `a : Fin M → Fin N → F` cut out, in each output coordinate, the fractional
ideal `kcbRowIdeal a hne i` generated by their entries.  This file proves that the integral
lattice `(𝓞 F)^N` is mapped by the multiplication map
`Phi a : (KE F)^N → (KE F)^M`, `y ↦ (∑_j meK (a i j) * y j)_i`
into the product of these ideals.

The proof is a direct computation with the two structural facts

* `mulK a (meK b) = meK (a * b)` — multiplication by an element of `F` sends the image of `𝓞 F`
  into the image of the principal ideal it generates, and
* `x ∈ euclidean.integerLattice F ↔ ∃ c : 𝓞 F, meK c = x`,
* `meK z ∈ kcbIdealE I` for every `z ∈ I`,
* the sum `∑_j a i j * c_j` (with `c_j ∈ 𝓞 F`) lies in the ideal spanned by the row `a i`.
-/

open NumberField
open scoped Classical nonZeroDivisors

namespace Work.BW

noncomputable section

variable {F : Type*} [Field F] [NumberField F]

/-- `meK` is additive, and in particular commutes with finite sums. -/
theorem meK_sum {ι : Type*} (s : Finset ι) (f : ι → F) :
    meK (∑ i ∈ s, f i) = ∑ i ∈ s, meK (f i) := by
  simp only [meK, map_sum]

/-- Multiplication by `a : F` sends the image of `b ∈ F` under `meK` to the image of `a * b`. -/
theorem mulK_meK (a b : F) : mulK a (meK b) = meK (a * b) := by
  simp only [mulK_apply, meK]; simp

/-- The Euclidean integral lattice of `F` is exactly the image of `𝓞 F` under `meK`. -/
theorem mem_euclidean_integerLattice_iff (x : KE F) :
    x ∈ NumberField.mixedEmbedding.euclidean.integerLattice F ↔
      ∃ c : 𝓞 F, meK (c : F) = x := by
  rw [NumberField.mixedEmbedding.euclidean.integerLattice]
  constructor
  · intro hx
    rw [ZLattice.comap] at hx
    simp only [Submodule.mem_comap, NumberField.mixedEmbedding.integerLattice,
      LinearMap.mem_range] at hx
    obtain ⟨c, hc⟩ := hx
    refine ⟨c, ?_⟩
    rw [meK]
    rw [show NumberField.mixedEmbedding F (algebraMap (𝓞 F) F c) =
      NumberField.mixedEmbedding.euclidean.toMixed F x from hc]
    simp
  · rintro ⟨c, hc⟩
    rw [ZLattice.comap]
    simp only [Submodule.mem_comap, NumberField.mixedEmbedding.integerLattice,
      LinearMap.mem_range]
    refine ⟨c, ?_⟩
    rw [← hc]
    simp [meK]

/-- `meK` of an element of a fractional ideal lies in its image lattice in `KE F`. -/
theorem meK_mem_kcbIdealE (I : (FractionalIdeal (𝓞 F)⁰ F)ˣ) {z : F}
    (hz : z ∈ (I : FractionalIdeal (𝓞 F)⁰ F)) : meK z ∈ kcbIdealE I := by
  rw [kcbIdealE, ZLattice.comap, Submodule.mem_comap]
  exact (NumberField.mixedEmbedding.mem_idealLattice F I).mpr ⟨z, hz, by simp [meK]⟩

/-- The row sum `∑_j a i j * c_j` with `c_j ∈ 𝓞 F` lies in the ideal generated by the row. -/
theorem sum_mul_mem_kcbRowIdeal {M N : ℕ} (a : Fin M → Fin N → F) (hne : ∀ i, a i ≠ 0)
    (i : Fin M) (c : Fin N → 𝓞 F) :
    (∑ j, a i j * ((c j : 𝓞 F) : F)) ∈ (kcbRowIdeal a hne i : FractionalIdeal (𝓞 F)⁰ F) := by
  rw [kcbRowIdeal_coe]
  change (∑ j, a i j * ((c j : 𝓞 F) : F)) ∈
    ((FractionalIdeal.spanFinset (𝓞 F) Finset.univ (a i) : FractionalIdeal (𝓞 F)⁰ F) :
      Submodule (𝓞 F) F)
  rw [FractionalIdeal.spanFinset_coe]
  refine Submodule.sum_mem _ (fun j _ => ?_)
  have hmem : a i j ∈ ((a i) '' (↑(Finset.univ : Finset (Fin N)) : Set (Fin N))) :=
    Set.mem_image_of_mem (a i) (Finset.mem_univ j)
  have h3 : ((c j : 𝓞 F) : F) * a i j ∈
      Submodule.span (𝓞 F) ((a i) '' (↑(Finset.univ : Finset (Fin N)) : Set (Fin N))) :=
    Submodule.smul_mem _ (c j) (Submodule.subset_span hmem)
  simpa [mul_comm] using h3

end

end Work.BW

namespace Work.BW

noncomputable section

theorem sic_Phi_intLat_le {F : Type*} [Field F] [NumberField F] {M N : ℕ}
    (a : Fin M → Fin N → F) (hne : ∀ i, a i ≠ 0) :
    Submodule.map ((Work.BW.Phi (F := F) a).restrictScalars ℤ) (Work.BW.intLat (F := F) N) ≤
      Work.BW.kcbIdealProd (F := F) (Work.BW.kcbRowIdeal (F := F) a hne) := by
  intro z hz
  rw [Submodule.mem_map] at hz
  obtain ⟨y, hy, rfl⟩ := hz
  change Phi a y ∈ kcbIdealProd (kcbRowIdeal a hne)
  rw [kcbIdealProd, Submodule.mem_pi]
  intro i _
  choose c hc using fun j =>
    (mem_euclidean_integerLattice_iff (F := F) (y j)).mp (((mem_intLat y).mp hy) j)
  have hkey : Phi a y i = meK (∑ j, a i j * ((c j : 𝓞 F) : F)) := by
    rw [Phi_apply]
    have h1 : ∀ j, mulK (a i j) (y j) = meK (a i j * ((c j : 𝓞 F) : F)) := by
      intro j; rw [← hc j, mulK_meK]
    rw [Finset.sum_congr rfl (fun j _ => h1 j), ← meK_sum]
  rw [hkey]
  exact meK_mem_kcbIdealE (kcbRowIdeal a hne i) (sum_mul_mem_kcbRowIdeal a hne i c)

end

end Work.BW
