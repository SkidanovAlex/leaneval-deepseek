section CmpAux

variable {N : ℕ}

theorem cmp_InSub_gone {ρ : ℕ} (ε : Bool) (M : Fin ρ → Fin N → ℤ) :
    InSub N ρ ε M (gone N) := by
  refine ⟨?_, ?_, ?_⟩
  · intro _; simp [gone]
  · intro i; simp [gone]
  · intro j; simp [gone]

theorem cmp_InSub_InG {ρ : ℕ} {ε : Bool} {M : Fin ρ → Fin N → ℤ} {y : Fin (N + 1) → ℂ}
    (h : InSub N ρ ε M y) : InG y := h.2.1

theorem cmp_inv_zpow_mul_zpow (a : ℂ) (ha : a ≠ 0) (n : ℤ) : (a⁻¹ : ℂ) ^ n * a ^ n = 1 := by
  have key := congrArg (fun z : ℂˣ => (z : ℂ)) (inv_zpow (Units.mk0 a ha) n)
  simp only [Units.val_zpow_eq_zpow_val, Units.val_mk0, Units.val_inv_eq_inv_val] at key
  rw [key]
  exact inv_mul_cancel₀ (zpow_ne_zero n ha)

theorem cmp_InSub_gmul {ρ : ℕ} {ε : Bool} {M : Fin ρ → Fin N → ℤ}
    {a b : Fin (N + 1) → ℂ} (ha : InSub N ρ ε M a) (hb : InSub N ρ ε M b) :
    InSub N ρ ε M (gmul a b) := by
  refine ⟨?_, ?_, ?_⟩
  · intro hε
    rw [gmul, Fin.cons_zero, ha.1 hε, hb.1 hε, add_zero]
  · intro i
    rw [gmul, Fin.cons_succ]
    exact mul_ne_zero (ha.2.1 i) (hb.2.1 i)
  · intro j
    rw [show (∏ i : Fin N, (gmul a b i.succ) ^ (M j i))
        = ∏ i : Fin N, (a i.succ) ^ (M j i) * (b i.succ) ^ (M j i) from
      Finset.prod_congr rfl fun i _ => by rw [gmul, Fin.cons_succ, mul_zpow]]
    rw [Finset.prod_mul_distrib, ha.2.2 j, hb.2.2 j, one_mul]

theorem cmp_InSub_ginv {ρ : ℕ} {ε : Bool} {M : Fin ρ → Fin N → ℤ} {a : Fin (N + 1) → ℂ}
    (ha : InSub N ρ ε M a) : InSub N ρ ε M (ginv a) := by
  refine ⟨?_, ?_, ?_⟩
  · intro hε
    rw [ginv, Fin.cons_zero, ha.1 hε, neg_zero]
  · intro i
    rw [ginv, Fin.cons_succ]
    exact inv_ne_zero (ha.2.1 i)
  · intro j
    have hne : ∀ i : Fin N, a i.succ ≠ 0 := fun i => ha.2.1 i
    rw [show (∏ i : Fin N, (ginv a i.succ) ^ (M j i))
        = ∏ i : Fin N, ((a i.succ)⁻¹) ^ (M j i) from
      Finset.prod_congr rfl fun i _ => by rw [ginv, Fin.cons_succ]]
    have h1 : (∏ i : Fin N, ((a i.succ)⁻¹) ^ (M j i)) *
        (∏ i : Fin N, (a i.succ) ^ (M j i)) = 1 := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_eq_one fun i _ => cmp_inv_zpow_mul_zpow _ (hne i) _
    rwa [ha.2.2 j, mul_one] at h1

/-- A point of the coset `f ⋆ G'` that lies in `G` forces `f ∈ G`. -/
theorem cmp_InG_of_mem_coset {ρ : ℕ} (ε : Bool) (M : Fin ρ → Fin N → ℤ)
    {f y : Fin (N + 1) → ℂ} (hy : InG y) (h : y ∈ gmul f '' subSet N ρ ε M) : InG f := by
  obtain ⟨u, hu, rfl⟩ := h
  intro i
  have hu' : u i.succ ≠ 0 := hu.2.1 i
  have hy' : f i.succ * u i.succ ≠ 0 := by simpa [gmul, Fin.cons_succ] using hy i
  intro hf
  exact hy' (by rw [hf, zero_mul])

/-- Elements of `subIdeal` vanish at the cone points over `G'`. -/
theorem cmp_subIdeal_vanish {ρ : ℕ} (ε : Bool) (M : Fin ρ → Fin N → ℤ) (F : MR N)
    (hF : F ∈ subIdeal N ρ ε M) (y : Fin (N + 1) → ℂ) (hy : InSub N ρ ε M y) :
    MvPolynomial.eval (conePt N y) F = 0 := by
  change F ∈ RingHom.ker (MvPolynomial.eval (conePt N y))
  rw [subIdeal] at hF
  exact Ideal.span_le.mpr (fun G hG => hG.2 y hy) hF

/-- An ideal generated by multihomogeneous elements is multihomogeneous. -/
theorem cmp_multiHom_span (S : Set (MR N)) (hS : ∀ x ∈ S, ∃ d, x ∈ homPiece N d) :
    MultiHom N (Ideal.span S) := by
  letI : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) :=
    MvPolynomial.weightedGradedAlgebra ℂ (mdeg N)
  have hgen : ∀ x ∈ S,
      SetLike.IsHomogeneousElem (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) x :=
    fun x hx => hS x hx
  have hI : (Ideal.span S).IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) :=
    Ideal.homogeneous_span _ _ hgen
  intro p hp d
  exact (MvPolynomial.mem_iff_weightedHomogeneousComponent_mem ℂ (mdeg N) hI p).mp hp d

/-- `J' = (τ_v Q : v ∈ Z(𝔓) ∩ G, Q ∈ chainGen)` is multihomogeneous. -/
theorem cmp_multiHomJ {q : ℕ} (w : Fin q → Fin (N + 1) → ℂ) (θ : Fin N → ℂ)
    (D : Fin (N + 1) → ℕ) (P : MvPolynomial (Fin (N + 1)) ℂ) (hdeg : ∀ i, P.degreeOf i ≤ D i)
    (A B : ℕ) (𝔓 : Ideal (MR N)) :
    MultiHom N (Ideal.span (bigGen w θ D P A B 𝔓)) :=
  cmp_multiHom_span _
    (fun x hx => by
      obtain ⟨v, hv, Q, hQ, rfl⟩ := hx
      exact ⟨fsD D, hsc_transl_homPiece v (fsD D)
        (ZGbigAux.chainGen_homPiece w θ D P hdeg A B hQ)⟩)

/-- `Z` is antitone on ideals. -/
theorem cmp_ZG_mono {𝔓 𝔔 : Ideal (MR N)} (h : 𝔓 ≤ 𝔔) : ZG 𝔔 ⊆ ZG 𝔓 :=
  fun _ hy => ⟨hy.1, fun F hF => hy.2 F (h hF)⟩

/-- Passing from the coset `f ⋆ G'` to another point of the same coset does not change it. -/
theorem cmp_subSet_mul_image {ρ : ℕ} (ε : Bool) (M : Fin ρ → Fin N → ℤ)
    (f u₀ : Fin (N + 1) → ℂ) (hu₀ : InSub N ρ ε M u₀) :
    gmul f '' subSet N ρ ε M = gmul (gmul f u₀) '' subSet N ρ ε M := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨gmul (ginv u₀) y, cmp_InSub_gmul (cmp_InSub_ginv hu₀) hy,
      (hsc_gmul_assoc f u₀ (gmul (ginv u₀) y)).trans
        (congrArg (gmul f) (hsc_gmul_inv_cancel (a := u₀) (b := y) hu₀.2.1))⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨gmul u₀ y, cmp_InSub_gmul hu₀ hy, (hsc_gmul_assoc f u₀ y).symm⟩

/-- **Product argument.** If `p` is a minimal prime of `J'` meeting `G`, and the `G`-points
`Z(p) ∩ G` of `p` are covered by finitely many cosets `f ⋆ G'` (`f ∈ F`), then `p` already
contains one of the corresponding coset ideals `τ_{f⁻¹} I(G')`.

Proof: assume the contrary; choose for each `f` a multihomogeneous generator `g f ∈ τ_{f⁻¹}I(G')`
outside `p`; the product `G` of the `g f` is multihomogeneous and vanishes at every point of
`Z(p) ∩ G` (such a point lies in some coset `f ⋆ G'`, where the factor `g f` vanishes), so
`G ∈ p` by `mem_of_vanish_ZG`, contradicting primality. -/
theorem cmp_exists_le {q ρ : ℕ} (w : Fin q → Fin (N + 1) → ℂ) (θ : Fin N → ℂ)
    (D : Fin (N + 1) → ℕ) (P : MvPolynomial (Fin (N + 1)) ℂ) (hdeg : ∀ i, P.degreeOf i ≤ D i)
    (A B : ℕ) (𝔓 : Ideal (MR N)) (h𝔓 : 𝔓.IsPrime) (hH : MultiHom N 𝔓) (hG : MeetsG N 𝔓)
    (ε : Bool) (M : Fin ρ → Fin N → ℤ) (hM : PrimSys M)
    (F : Finset (Fin (N + 1) → ℂ))
    (hcov : Hset w 𝔓 (chainIdeal w θ D P A B) 0 ⊆ ⋃ f ∈ F, gmul f '' subSet N ρ ε M)
    (p : Ideal (MR N)) (hp : p ∈ (Ideal.span (bigGen w θ D P A B 𝔓)).minimalPrimes)
    (hpG : MeetsG N p) :
    ∃ f ∈ F, cosetIdeal f ε M ≤ p := by
  classical
  have hp_prime : p.IsPrime := hp.isPrime
  haveI : p.IsPrime := hp_prime
  have hJ'le : Ideal.span (bigGen w θ D P A B 𝔓) ≤ p := hp.le
  have hMH_p : MultiHom N p :=
    hsc_multiHom_minimalPrimes (cmp_multiHomJ w θ D P hdeg A B 𝔓) hp
  by_contra hcon
  have hcon' : ∀ f ∈ F, ¬ cosetIdeal f ε M ≤ p := by
    intro f hf hle
    exact hcon ⟨f, hf, hle⟩
  set S : Set (MR N) :=
    {Q : MR N | (∃ d, Q ∈ homPiece N d) ∧
      ∀ y, InSub N ρ ε M y → MvPolynomial.eval (conePt N y) Q = 0} with hSdef
  have hsub_eq : subIdeal N ρ ε M = Ideal.span S := by rw [subIdeal, hSdef]
  -- one homogeneous generator of each `cosetIdeal f` avoids `p`
  have hmain : ∀ f : Fin (N + 1) → ℂ, f ∈ F → ∃ Q ∈ S, transl (ginv f) Q ∉ p := by
    intro f hf
    by_contra h
    have h' : ∀ Q ∈ S, transl (ginv f) Q ∈ p := by
      intro Q hQ
      by_contra hQp
      exact h ⟨Q, hQ, hQp⟩
    exact hcon' f hf (by
      rw [cosetIdeal, hsub_eq, Ideal.map_span]
      exact Ideal.span_le.mpr (fun x hx => by
        obtain ⟨Q, hQ, rfl⟩ := hx
        exact h' Q hQ))
  have hchoice : ∀ f : Fin (N + 1) → ℂ, ∃ (Q : MR N) (d : Fin (N + 1) →₀ ℕ),
      (f ∈ F → Q ∈ S) ∧ (f ∈ F → Q ∈ homPiece N d) ∧ (f ∈ F → transl (ginv f) Q ∉ p) := by
    intro f
    by_cases hf : f ∈ F
    · obtain ⟨Q, hQS, hQp⟩ := hmain f hf
      obtain ⟨d, hd⟩ := hQS.1
      exact ⟨Q, d, (fun _ => hQS), (fun _ => hd), (fun _ => hQp)⟩
    · exact ⟨0, 0, (fun h => absurd h hf), (fun h => absurd h hf), (fun h => absurd h hf)⟩
  choose Qf dg hQfS hQfhom hQfp using hchoice
  set g : (Fin (N + 1) → ℂ) → MR N := fun f => transl (ginv f) (Qf f) with hgdef
  have hg_mem : ∀ f, f ∈ F → g f ∈ cosetIdeal f ε M := by
    intro f hf
    rw [hgdef, cosetIdeal]
    refine Ideal.mem_map_of_mem _ ?_
    rw [hsub_eq]
    exact Ideal.subset_span (hQfS f hf)
  have hg_notp : ∀ f, f ∈ F → g f ∉ p := by
    intro f hf
    rw [hgdef]
    exact hQfp f hf
  have hg_hom : ∀ f, f ∈ F → g f ∈ homPiece N (dg f) := by
    intro f hf
    rw [hgdef]
    exact hsc_transl_homPiece (ginv f) (dg f) (hQfhom f hf)
  set G : MR N := ∏ f ∈ F, g f with hGdef
  have hG_notp : G ∉ p := by
    intro hmem
    rw [hGdef] at hmem
    obtain ⟨f, hf, hfp⟩ := (Ideal.IsPrime.prod_mem_iff).mp hmem
    exact hg_notp f hf hfp
  have hG_hom : ∃ d, G ∈ homPiece N d := by
    refine ⟨∑ f ∈ F, dg f, ?_⟩
    rw [hGdef, homPiece, MvPolynomial.mem_weightedHomogeneousSubmodule]
    exact MvPolynomial.IsWeightedHomogeneous.prod F g dg (fun f hf => hg_hom f hf)
  have hG_vanish : ∀ v ∈ ZG p, MvPolynomial.eval (conePt N v) G = 0 := by
    intro v hv
    obtain ⟨hvG, hv0⟩ := hv
    have hvHset : v ∈ Hset w 𝔓 (chainIdeal w θ D P A B) 0 :=
      ZG_bigGen_sub_Hset w θ D P hdeg A B 𝔓 h𝔓 hH hG v hvG
        (fun Q hQ => hv0 Q (hJ'le (Ideal.subset_span hQ)))
    have hmem := hcov hvHset
    simp only [Set.mem_iUnion, Set.mem_image] at hmem
    obtain ⟨f, hfF, y, hyS, hgy⟩ := hmem
    have hyG : InSub N ρ ε M y := hyS
    have hfG : InG f := by
      intro i
      have hyne : y i.succ ≠ 0 := hyG.2.1 i
      have hvne : v i.succ ≠ 0 := hvG i
      have hcoord : f i.succ * y i.succ = v i.succ := by
        have h := congrFun hgy i.succ
        simpa [gmul] using h
      intro hzero
      rw [hzero, zero_mul] at hcoord
      exact hvne hcoord.symm
    have hvZG : v ∈ ZG (cosetIdeal f ε M) := by
      rw [coset_ZG_cosetIdeal ε M f hfG]
      exact ⟨y, hyS, hgy⟩
    have hgf : MvPolynomial.eval (conePt N v) (g f) = 0 := hvZG.2 (g f) (hg_mem f hfF)
    rw [hGdef, map_prod]
    exact Finset.prod_eq_zero hfF hgf
  exact hG_notp (mem_of_vanish_ZG p hp_prime hMH_p hpG G hG_hom hG_vanish)

end CmpAux

/-- §5.1(c), components of `J'`. With `G' ⊆ stabG 𝔓` and `H_V(0)` covered by the finitely many
`G'`-cosets indexed by `F`, the closure of the coset `σ ⋆ G'` (`σ ∈ H_V(0)`) is an isolated
component of `J' = (τ_v F : F ∈ chainGen, v ∈ Z(𝔓) ∩ G)`: its ideal `cosetIdeal σ ε M = τ_{σ⁻¹}I(G')`
is a minimal prime of `J'`.

Proof. `cosetIdeal σ ε M` is prime (`subIdeal_isPrime` transported along `τ_σ`) and contains `J'`
(each generator `τ_v Q` is `τ_{σ⁻¹}(τ_σ τ_v Q)` with `τ_σ τ_v Q ∈ I(G')`, because `v ⋆ u ∈ Z(𝔓)` for
`u ∈ G' ⊆ stabG 𝔓` while `τ_σ Q ∈ 𝔓` as `σ ∈ H_V(0)`). For the minimality, let `p ⊇ J'` be a prime
contained in `cosetIdeal σ ε M`, choose a minimal prime `p' ⊆ p` of `J'` and argue with `p'`: it is
multihomogeneous (`multiHom_assPrime`) and meets `G` (through `σ ⋆ G'`), so `Z(p') ⊆ H_V(0)`
(`ZG_bigGen_sub_HSet`); the product argument `cmp_exists_le` produces `f ∈ F` with
`cosetIdeal f ≤ p'`, whence `Z(p') = σ ⋆ G'` (`coset_ZG_cosetIdeal` for the closure of a coset, plus
the fact that the coset of `σ` is the coset of `f`), and `mem_of_vanish_ZG` applied to
multihomogeneous elements of `cosetIdeal σ ε M` yields `cosetIdeal σ ≤ p'`. Hence
`cosetIdeal σ = p' = p`. -/

theorem coset_minimalPrime {N q ρ : ℕ} (w : Fin q → Fin (N + 1) → ℂ) (θ : Fin N → ℂ)
    (D : Fin (N + 1) → ℕ) (P : MvPolynomial (Fin (N + 1)) ℂ) (hdeg : ∀ i, P.degreeOf i ≤ D i) (A B : ℕ) (𝔓 : Ideal (MR N))
    (h𝔓 : 𝔓.IsPrime) (hH : MultiHom N 𝔓) (hG : MeetsG N 𝔓) (ε : Bool)
    (M : Fin ρ → Fin N → ℤ) (hM : PrimSys M) (hsub : subSet N ρ ε M ⊆ stabG 𝔓)
    (F : Finset (Fin (N + 1) → ℂ))
    (hcov : Hset w 𝔓 (chainIdeal w θ D P A B) 0 ⊆ ⋃ f ∈ F, gmul f '' subSet N ρ ε M)
    (σ : Fin (N + 1) → ℂ) (hσ : σ ∈ Hset w 𝔓 (chainIdeal w θ D P A B) 0) :
    cosetIdeal σ ε M ∈ (Ideal.span (bigGen w θ D P A B 𝔓)).minimalPrimes := by
  classical
  have hσG : InG σ := hσ.1
  have hsurj : Function.Surjective (transl (ginv σ)) := hsc_transl_ginv_surj hσG
  have hgone : InSub N ρ ε M (gone N) := cmp_InSub_gone ε M
  have hMultiJ : MultiHom N (Ideal.span (bigGen w θ D P A B 𝔓)) :=
    cmp_multiHomJ w θ D P hdeg A B 𝔓
  -- `q = cosetIdeal σ ε M` is prime, by transport of `subIdeal_isPrime`
  have hqprime : (cosetIdeal σ ε M).IsPrime := by
    rw [cosetIdeal]
    exact hsc_map_ginv_isPrime hσG (subIdeal_isPrime ε M hM)
  -- `J' ≤ q`: each generator `τ_v Q` is `τ_{σ⁻¹}(τ_σ τ_v Q)` with `τ_σ τ_v Q ∈ I(G')`
  have hJq : Ideal.span (bigGen w θ D P A B 𝔓) ≤ cosetIdeal σ ε M := by
    rw [Ideal.span_le, cosetIdeal]
    rintro F ⟨v, hv, Q, hQ, rfl⟩
    change (transl v) Q ∈ Ideal.map (transl (ginv σ)) (subIdeal N ρ ε M)
    rw [Ideal.mem_map_iff_of_surjective (transl (ginv σ)) hsurj]
    refine ⟨transl σ (transl v Q), ?_, hsc_transl_inv hσG _⟩
    refine Ideal.subset_span ⟨⟨fsD D, ?_⟩, ?_⟩
    · exact hsc_transl_homPiece σ (fsD D)
        (hsc_transl_homPiece v (fsD D) (ZGbigAux.chainGen_homPiece w θ D P hdeg A B hQ))
    · intro y hy
      have hkey : MvPolynomial.eval (conePt N y) (transl σ (transl v Q))
          = MvPolynomial.eval (conePt N (gmul v y)) (transl σ Q) := by
        rw [hsc_eval_transl σ (conePt N y) (transl v Q), hsc_coneAct_conePt σ y,
          hsc_eval_transl v (conePt N (gmul σ y)) Q, hsc_coneAct_conePt v (gmul σ y),
          hsc_eval_transl σ (conePt N (gmul v y)) Q, hsc_coneAct_conePt σ (gmul v y)]
        rw [show gmul v (gmul σ y) = gmul σ (gmul v y) from by
          rw [← hsc_gmul_assoc v σ y, hsc_gmul_comm v σ, hsc_gmul_assoc σ v y]]
      rw [hkey]
      exact (gmul_mem_ZG_of_stab 𝔓 v y hv (hsub hy)).2 (transl σ Q)
        (hsc_Hset_transl_mem hσ (Ideal.subset_span hQ))
  -- `q` meets `G`, at the cone point over `σ`
  have hqG : MeetsG N (cosetIdeal σ ε M) := by
    refine ⟨conePt N σ, ⟨by simp [conePt],
      fun i => ⟨by simp [conePt], by simpa [conePt] using hσG i⟩⟩, ?_⟩
    intro H hH
    change H ∈ Ideal.map (transl (ginv σ)) (subIdeal N ρ ε M) at hH
    rw [Ideal.mem_map_iff_of_surjective (transl (ginv σ)) hsurj] at hH
    obtain ⟨H', hH'mem, rfl⟩ := hH
    rw [ptIdeal, RingHom.mem_ker, hsc_eval_transl, hsc_coneAct_conePt,
      hsc_gmul_ginv_left σ hσG]
    exact cmp_subIdeal_vanish ε M H' hH'mem (gone N) hgone
  -- `σ · G' ⊆ Z(q)`
  have hmemZGq : ∀ u, InSub N ρ ε M u → gmul σ u ∈ ZG (cosetIdeal σ ε M) := by
    intro u hu
    refine ⟨hsc_inG_gmul hσG hu.2.1, ?_⟩
    intro H hH
    change H ∈ Ideal.map (transl (ginv σ)) (subIdeal N ρ ε M) at hH
    rw [Ideal.mem_map_iff_of_surjective (transl (ginv σ)) hsurj] at hH
    obtain ⟨H', hH'mem, rfl⟩ := hH
    rw [hsc_eval_transl, hsc_coneAct_conePt]
    have hassoc : gmul (ginv σ) (gmul σ u) = u := by
      rw [← hsc_gmul_assoc, hsc_gmul_ginv_left σ hσG, hsc_gmul_gone_left]
    rw [hassoc]
    exact cmp_subIdeal_vanish ε M H' hH'mem u hu
  have hσZGq : σ ∈ ZG (cosetIdeal σ ε M) := by
    have h := hmemZGq (gone N) hgone
    rwa [hsc_gmul_gone_right] at h
  -- minimality
  refine ⟨⟨hqprime, hJq⟩, ?_⟩
  intro y hy hyq
  obtain ⟨hyprime, hJy⟩ := hy
  haveI : y.IsPrime := hyprime
  obtain ⟨p, hpmin, hpy⟩ :=
    Ideal.exists_minimalPrimes_le (I := Ideal.span (bigGen w θ D P A B 𝔓)) hJy
  have hpprime : p.IsPrime := hpmin.isPrime
  have hpMultiHom : MultiHom N p := hsc_multiHom_minimalPrimes hMultiJ hpmin
  have hpG : MeetsG N p := hsc_meetsG_mono (le_trans hpy hyq) hqG
  -- restrict the given cover of `H_V(0)` to its points of `G`
  set F' : Finset (Fin (N + 1) → ℂ) := F.filter (fun f => InG f) with hF'def
  have hcov' : Hset w 𝔓 (chainIdeal w θ D P A B) 0 ⊆ ⋃ f ∈ F', gmul f '' subSet N ρ ε M := by
    intro g hg
    obtain ⟨f, hfF, hgf⟩ := Set.mem_iUnion₂.mp (hcov hg)
    exact Set.mem_iUnion₂.mpr
      ⟨f, Finset.mem_filter.mpr ⟨hfF, cmp_InG_of_mem_coset ε M hg.1 hgf⟩, hgf⟩
  obtain ⟨f, hfF', hfcoset⟩ :=
    cmp_exists_le w θ D P hdeg A B 𝔓 h𝔓 hH hG ε M hM F' hcov' p hpmin hpG
  have hfInG : InG f := (Finset.mem_filter.mp hfF').2
  -- `Z(p) ∩ G = σ ⋆ G'`
  have hZGf : ZG (cosetIdeal f ε M) = gmul f '' subSet N ρ ε M :=
    coset_ZG_cosetIdeal ε M f hfInG
  have hZGp_sub : ZG p ⊆ gmul f '' subSet N ρ ε M := by
    rw [← hZGf]
    exact cmp_ZG_mono hfcoset
  have hσZGp : σ ∈ ZG p := (cmp_ZG_mono hpy) ((cmp_ZG_mono hyq) hσZGq)
  obtain ⟨u₀, hu₀, hσeq⟩ := hZGp_sub hσZGp
  have hcoseteq : gmul f '' subSet N ρ ε M = gmul σ '' subSet N ρ ε M := by
    rw [← hσeq]
    exact cmp_subSet_mul_image ε M f u₀ hu₀
  have hZGp : ZG p = gmul σ '' subSet N ρ ε M := by
    refine le_antisymm ?_ ?_
    · rw [← hcoseteq]; exact hZGp_sub
    · rintro z ⟨u, hu, rfl⟩
      exact (cmp_ZG_mono hpy) ((cmp_ZG_mono hyq) (hmemZGq u hu))
  -- `q ≤ p`, again by `mem_of_vanish_ZG`
  have hqp : cosetIdeal σ ε M ≤ p := by
    intro X hX
    change X ∈ Ideal.map (transl (ginv σ)) (subIdeal N ρ ε M) at hX
    rw [Ideal.mem_map_iff_of_surjective (transl (ginv σ)) hsurj] at hX
    obtain ⟨H, hHmem, rfl⟩ := hX
    have hfin := MvPolynomial.weightedHomogeneousComponent_finsupp (w := mdeg N) (φ := H)
    have hsum := MvPolynomial.sum_weightedHomogeneousComponent (mdeg N) H
    rw [finsum_eq_sum _ hfin] at hsum
    have hMultiSub : MultiHom N (subIdeal N ρ ε M) := cmp_multiHom_span _ (fun x hx => hx.1)
    have hterm : ∀ d ∈ hfin.toFinset,
        transl (ginv σ) (MvPolynomial.weightedHomogeneousComponent (mdeg N) d H) ∈ p := by
      intro d hd
      refine mem_of_vanish_ZG p hpprime hpMultiHom hpG
        (transl (ginv σ) (MvPolynomial.weightedHomogeneousComponent (mdeg N) d H))
        ⟨d, hsc_transl_homPiece (ginv σ) d
          (MvPolynomial.weightedHomogeneousComponent_mem (mdeg N) H d)⟩ ?_
      intro z hz
      rw [hZGp] at hz
      obtain ⟨u, hu, rfl⟩ := hz
      rw [hsc_eval_transl, hsc_coneAct_conePt]
      have hassoc : gmul (ginv σ) (gmul σ u) = u := by
        rw [← hsc_gmul_assoc, hsc_gmul_ginv_left σ hσG, hsc_gmul_gone_left]
      rw [hassoc]
      exact cmp_subIdeal_vanish ε M _ (hMultiSub H hHmem d) u hu
    rw [← hsum, map_sum]
    exact Submodule.sum_mem _ hterm
  exact le_trans hqp hpy

end Work.BW
