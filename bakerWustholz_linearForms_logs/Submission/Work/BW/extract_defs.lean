import Mathlib
import Submission.Work.BW.wuestholzDefs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Coefficient extraction (`Work.BW.extract_coeff`): supporting definitions

We set up the filtration `J_m = U^m + 𝔎·U^{m-1}` (`U = Ideal.span (range u)`),
the list-based operator composition `applyWord`, the word `wordOf α` associated to a
multi-index, and the expected main term `mainTerm` obtained by "symbolically"
differentiating the monomial `∏ i, u i ^ β i`.
-/

namespace Work.BW

open scoped BigOperators

variable {R : Type*} [CommRing R] {ℓ : ℕ}

/-- The ideal generated by the elements `u i`. -/
def Uspan (u : Fin ℓ → R) : Ideal R := Ideal.span (Set.range u)

/-- The filtration `J_m = U^m + 𝔎·U^{m-1}`. -/
def Jfilt (𝔎 : Ideal R) (u : Fin ℓ → R) (m : ℕ) : Ideal R :=
  Uspan u ^ m ⊔ 𝔎 * Uspan u ^ (m - 1)

/-- The filtration index attached to a monomial of degree `∑ β` after `n` differentiations. -/
def Jidx (β : Fin ℓ → ℕ) (n : ℕ) : ℕ := (∑ i, β i) + 1 - n

/-- The number of occurrences of `i` in the word `w`. -/
def cnt {ℓ : ℕ} (w : List (Fin ℓ)) (i : Fin ℓ) : ℕ := w.countP (fun j => decide (j = i))

/-- Lower the `j`-th exponent by one. -/
def decr {ℓ : ℕ} (β : Fin ℓ → ℕ) (j : Fin ℓ) : Fin ℓ → ℕ := Function.update β j (β j - 1)

/-- The degree of the `u`-part of `mainTerm w β`. -/
def mainDeg {ℓ : ℕ} (w : List (Fin ℓ)) (β : Fin ℓ → ℕ) : ℕ := ∑ i, (β i - cnt w i)

/-- Application of a list of operators; `foldl`, so the head of the list is applied first. -/
def applyWord (Λ : Fin ℓ → R → R) (w : List (Fin ℓ)) (x : R) : R :=
  w.foldl (fun q i => Λ i q) x

/-- The list of operators (innermost first) attached to a multi-index `α`. -/
def wordOf {ℓ : ℕ} (α : Fin ℓ → ℕ) : List (Fin ℓ) :=
  (List.finRange ℓ).foldr (fun i acc => acc ++ List.replicate (α i) i) []

/-- The expected main term obtained by "symbolically" applying `w` to `∏ i, u i ^ β i`. -/
noncomputable def mainTerm (u D : Fin ℓ → R) (w : List (Fin ℓ)) (β : Fin ℓ → ℕ) : R :=
  ((∏ i, (β i).descFactorial (cnt w i)) : R) * (∏ i, D i ^ (cnt w i)) *
    (∏ i, u i ^ (β i - cnt w i))

/-! ## Basic facts -/

section Jfilt

variable {𝔎 : Ideal R} {u : Fin ℓ → R}

lemma pow_le_Jfilt (m : ℕ) : Uspan u ^ m ≤ Jfilt 𝔎 u m := le_sup_left

lemma mul_pow_le_Jfilt_succ (m : ℕ) : 𝔎 * Uspan u ^ m ≤ Jfilt 𝔎 u (m + 1) := by
  rw [Jfilt, Nat.add_sub_cancel]
  exact le_sup_right

lemma Jfilt_zero : Jfilt 𝔎 u 0 = ⊤ := by
  rw [Jfilt, Nat.zero_sub, pow_zero, Ideal.one_eq_top, Ideal.mul_top]
  exact sup_eq_left.mpr le_top

lemma Jfilt_antitone {k m : ℕ} (h : k ≤ m) : Jfilt 𝔎 u m ≤ Jfilt 𝔎 u k := by
  rw [Jfilt, Jfilt]
  exact sup_le_sup (Ideal.pow_le_pow_right h)
    (Ideal.mul_mono_right (Ideal.pow_le_pow_right (Nat.sub_le_sub_right h 1)))

lemma Uspan_le_𝔎 (hu : ∀ j, u j ∈ 𝔎) : Uspan u ≤ 𝔎 := by
  rw [Uspan, Ideal.span_le]
  rintro x ⟨j, rfl⟩
  exact hu j

lemma Jfilt_le_𝔎 (hu : ∀ j, u j ∈ 𝔎) {m : ℕ} (hm : 1 ≤ m) : Jfilt 𝔎 u m ≤ 𝔎 := by
  rw [Jfilt]
  exact sup_le ((Ideal.pow_le_self (I := Uspan u) (by omega)).trans (Uspan_le_𝔎 hu))
    (Ideal.mul_le_left)

end Jfilt

section Monomial

variable {u : Fin ℓ → R}

lemma mem_Uspan (j : Fin ℓ) : u j ∈ Uspan u := Ideal.subset_span (Set.mem_range_self j)

lemma prod_pow_mem_pow_aux (I : Ideal R) (f : Fin ℓ → R) (hf : ∀ i, f i ∈ I)
    (s : Finset (Fin ℓ)) (δ : Fin ℓ → ℕ) :
    ∏ i ∈ s, f i ^ δ i ∈ I ^ (∑ i ∈ s, δ i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, pow_add]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hf a) (δ a)) ih

lemma prod_pow_mem (δ : Fin ℓ → ℕ) :
    ∏ i, u i ^ δ i ∈ Uspan u ^ (∑ i, δ i) := by
  have h := prod_pow_mem_pow_aux (Uspan u) u (fun i => mem_Uspan i) Finset.univ δ
  simpa using h

end Monomial

section Cnt

lemma cnt_nil (i : Fin ℓ) : cnt ([] : List (Fin ℓ)) i = 0 := rfl

lemma cnt_cons_self (i : Fin ℓ) (w : List (Fin ℓ)) : cnt (i :: w) i = cnt w i + 1 := by
  unfold cnt
  exact List.countP_cons_of_pos (p := fun j : Fin ℓ => decide (j = i)) (a := i) (l := w)
    (by simp)

lemma cnt_cons_of_ne {i l : Fin ℓ} (w : List (Fin ℓ)) (h : l ≠ i) : cnt (i :: w) l = cnt w l := by
  unfold cnt
  exact List.countP_cons_of_neg (p := fun j : Fin ℓ => decide (j = l)) (a := i) (l := w)
    (by simp only [decide_eq_true_eq]; exact fun h' => h h'.symm)

lemma cnt_cons_eq (a : Fin ℓ) (w : List (Fin ℓ)) (l : Fin ℓ) :
    cnt (a :: w) l = cnt w l + (if l = a then 1 else 0) := by
  by_cases h : l = a
  · subst h; rw [cnt_cons_self]; simp
  · rw [cnt_cons_of_ne w h]; simp [h]

lemma length_eq_sum_cnt (w : List (Fin ℓ)) : w.length = ∑ i, cnt w i := by
  induction w with
  | nil => simp [cnt_nil]
  | cons a w ih =>
      rw [List.length_cons, Finset.sum_congr rfl (fun l _ => cnt_cons_eq a w l),
        Finset.sum_add_distrib, Finset.sum_ite_eq', if_pos (Finset.mem_univ a), ih]

end Cnt

section Decr

lemma decr_update_self (β : Fin ℓ → ℕ) (i : Fin ℓ) : decr β i i = β i - 1 := by
  show Function.update β i (β i - 1) i = β i - 1
  exact Function.update_self i (β i - 1) β

lemma decr_of_ne {β : Fin ℓ → ℕ} {i l : Fin ℓ} (h : l ≠ i) : decr β i l = β l := by
  show Function.update β i (β i - 1) l = β l
  exact Function.update_of_ne h (β i - 1) β

end Decr

section MainDeg

lemma sum_le_mainDeg_add (w : List (Fin ℓ)) (β : Fin ℓ → ℕ) :
    (∑ i, β i) ≤ mainDeg w β + w.length := by
  have h1 : ∀ i, β i ≤ (β i - cnt w i) + cnt w i := fun i => by omega
  calc ∑ i, β i ≤ ∑ i, ((β i - cnt w i) + cnt w i) := Finset.sum_le_sum (fun i _ => h1 i)
    _ = (∑ i, (β i - cnt w i)) + (∑ i, cnt w i) := Finset.sum_add_distrib
    _ = mainDeg w β + w.length := by rw [mainDeg, ← length_eq_sum_cnt]

lemma sum_le_sum_decr_add_one (β : Fin ℓ → ℕ) (j : Fin ℓ) :
    (∑ i, β i) ≤ (∑ i, decr β j i) + 1 := by
  have h1 : ∀ i, β i ≤ decr β j i + (if i = j then 1 else 0) := by
    intro i
    by_cases h : i = j
    · subst h; rw [decr_update_self, if_pos rfl]; omega
    · rw [decr_of_ne (i := j) (l := i) h, if_neg h]; omega
  calc ∑ i, β i ≤ ∑ i, (decr β j i + (if i = j then 1 else 0)) :=
        Finset.sum_le_sum (fun i _ => h1 i)
    _ = (∑ i, decr β j i) + (∑ i, (if i = j then 1 else 0)) := Finset.sum_add_distrib
    _ = (∑ i, decr β j i) + 1 := by rw [Finset.sum_ite_eq', if_pos (Finset.mem_univ j)]

lemma sum_decr_le_mainDeg_add (w : List (Fin ℓ)) (β : Fin ℓ → ℕ) (j : Fin ℓ) :
    (∑ i, decr β j i) ≤ mainDeg w (decr β j) + w.length :=
  sum_le_mainDeg_add w (decr β j)

end MainDeg

section MainTerm

variable {u D : Fin ℓ → R}

lemma mainTerm_mem (w : List (Fin ℓ)) (β : Fin ℓ → ℕ) :
    mainTerm u D w β ∈ Uspan u ^ mainDeg w β := by
  rw [mainTerm]
  have h : ∏ i, u i ^ (β i - cnt w i) ∈ Uspan u ^ mainDeg w β :=
    prod_pow_mem (fun i => β i - cnt w i)
  exact Ideal.mul_mem_left _ _ h

lemma mainTerm_nil (β : Fin ℓ → ℕ) :
    mainTerm u D ([] : List (Fin ℓ)) β = ∏ i, u i ^ β i := by
  simp [mainTerm, cnt_nil]

end MainTerm

section ApplyWord

lemma applyWord_nil (Λ : Fin ℓ → R → R) (x : R) : applyWord Λ [] x = x := rfl

lemma applyWord_cons (Λ : Fin ℓ → R → R) (i : Fin ℓ) (w : List (Fin ℓ)) (x : R) :
    applyWord Λ (i :: w) x = applyWord Λ w (Λ i x) := rfl

lemma applyWord_add (Λ : Fin ℓ → R → R) (hadd : ∀ i x y, Λ i (x + y) = Λ i x + Λ i y)
    (w : List (Fin ℓ)) (x y : R) :
    applyWord Λ w (x + y) = applyWord Λ w x + applyWord Λ w y := by
  induction w generalizing x y with
  | nil => rfl
  | cons i w ih =>
      change applyWord Λ w (Λ i (x + y)) = applyWord Λ w (Λ i x) + applyWord Λ w (Λ i y)
      rw [hadd, ih]

lemma applyWord_zero (Λ : Fin ℓ → R → R) (hadd : ∀ i x y, Λ i (x + y) = Λ i x + Λ i y)
    (w : List (Fin ℓ)) : applyWord Λ w 0 = 0 := by
  have h : (0 : R) + 0 = 0 := add_zero 0
  have hz := applyWord_add Λ hadd w 0 0
  rw [h] at hz
  -- hz : applyWord Λ w 0 = applyWord Λ w 0 + applyWord Λ w 0
  have h2 : applyWord Λ w 0 + applyWord Λ w 0 = applyWord Λ w 0 + 0 := by
    rw [add_zero]; exact hz.symm
  exact add_left_cancel h2

end ApplyWord

end Work.BW
