import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.BW

/-- The fractional ideal generated by the images in `F` of the integral elements `b j`
equals the integral ideal spanned by the `b j`, regarded as a fractional ideal. -/
theorem sieg2_spanFinset_integral_eq_coeIdeal {F : Type*} [Field F] [NumberField F] {n : ℕ}
    (b : Fin n → NumberField.RingOfIntegers F) :
    FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ
        (fun j => ((b j : NumberField.RingOfIntegers F) : F))
      = ((Ideal.span (Set.range b) : Ideal (NumberField.RingOfIntegers F)) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) := by
  rw [← FractionalIdeal.coeToSubmodule_inj]
  rw [FractionalIdeal.spanFinset_coe, FractionalIdeal.coe_coeIdeal,
    IsLocalization.coeSubmodule_span]
  congr 1
  ext x
  simp

end Work.BW
