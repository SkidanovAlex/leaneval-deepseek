import Mathlib
import Submission.Work.BW.aligned_defs
import Submission.Work.BW.prim_pure_span_singleton
import Submission.Work.BW.aligned_from_basis_partner

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Producing an aligned basis of `L` from a short element

Given a `ℤ`-submodule `L ⊆ ℤ^m` generated by two elements, a primitive element `r ∈ L` lying in
`ker θ` and an element `u ∈ L` with `θ u ≠ 0` whose weighted `ℓ¹`-length together with that of `r`
is at most `T/2`, this file produces generators `e' 0, e' 1` of `L` which are *aligned*
(`θ (e' 0) + θ (e' 1) = 0`) and short (`F (e' 0) + F (e' 1) ≤ T`).

The lattice-theoretic content is assembled here from two independent pieces:
* `Work.BW.prim_pure_span_singleton` : `hprim` makes `ℤr` *pure* in `L`;
* `Work.BW.aligned_from_basis_partner` : the final construction given a basis partner.

The splitting `L = ℤA ⊕ ℤr` used to obtain the basis partner is proved locally
(`exists_split_step_pure`, the pure-in-`O` variant of `Work.BW.Minkowski2.exists_split_step`),
as is the rank computation `finrank ℤ L = 2`.
-/

namespace Work.BW

open Module

/-! ## A pure-submodule splitting lemma

`Work.BW.Minkowski2.exists_split_step` asks for purity of `N` inside the whole ambient `ℤ^m`,
which is too strong for an application where `N = ℤr` is only primitive inside `O = L`.  The
proof is identical: purity in `O` is all that is used. -/
theorem exists_split_step_pure {m : ℕ} (N O : Submodule ℤ (Fin m → ℤ)) (hNO : N ≤ O)
    (hpure : ∀ (c : ℤ) (x : Fin m → ℤ), x ∈ O → c ≠ 0 → c • x ∈ N → x ∈ N)
    (hrank : Module.finrank ℤ O = Module.finrank ℤ N + 1) :
    ∃ y : Fin m → ℤ, y ∈ O ∧
      (∀ (c : ℤ) (x : Fin m → ℤ), x ∈ N → c • y + x = 0 → c = 0) ∧
      (∀ z ∈ O, ∃ c : ℤ, z + c • y ∈ N) := by
  let Ñ : Submodule ℤ O := N.comap O.subtype
  have hfinrank_Ñ : Module.finrank ℤ Ñ = Module.finrank ℤ N :=
    LinearEquiv.finrank_eq (Submodule.comapSubtypeEquivOfLe (p := N) (q := O) hNO)
  have hq : Module.finrank ℤ (O ⧸ Ñ) = 1 := by
    have h := Submodule.finrank_quotient_add_finrank (R := ℤ) Ñ
    omega
  haveI htf : Module.IsTorsionFree ℤ (O ⧸ Ñ) :=
    Module.IsTorsionFree.of_smul_eq_zero fun c q hcq => by
      revert hcq
      refine Submodule.Quotient.induction_on Ñ q fun z => ?_
      intro hz
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hz
      by_cases hc : c = 0
      · exact Or.inl hc
      · refine Or.inr ?_
        rw [Submodule.Quotient.mk_eq_zero]
        have h2 : O.subtype (c • z) ∈ N := (Submodule.mem_comap (f := O.subtype) (p := N)).mp hz
        exact hpure c (z : Fin m → ℤ) z.2 hc (by simpa using h2)
  haveI hfree : Module.Free ℤ (O ⧸ Ñ) := Module.free_of_finite_type_torsion_free'
  let b : Module.Basis (Fin 1) ℤ (O ⧸ Ñ) := Module.finBasisOfFinrankEq ℤ (O ⧸ Ñ) hq
  obtain ⟨y₀, hy₀⟩ := Submodule.Quotient.mk_surjective Ñ (b 0)
  refine ⟨(y₀ : Fin m → ℤ), y₀.2, ?_, ?_⟩
  · intro c x hxN hsum
    have hw0 : (c • y₀ + ⟨x, hNO hxN⟩ : O) = 0 := by
      apply Subtype.ext
      simpa using hsum
    have hcb : c • b 0 = 0 := by
      have h1 : (Submodule.Quotient.mk (p := Ñ) (c • y₀ + ⟨x, hNO hxN⟩) : O ⧸ Ñ) = 0 := by
        rw [hw0]; simp
      have hx0 : (Submodule.Quotient.mk (p := Ñ) (⟨x, hNO hxN⟩ : O) : O ⧸ Ñ) = 0 := by
        rw [Submodule.Quotient.mk_eq_zero]; exact hxN
      rw [Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul, hy₀, hx0, add_zero] at h1
      exact h1
    have hb0 : b 0 ≠ 0 := b.ne_zero 0
    rcases smul_eq_zero.mp hcb with hc | hb
    · exact hc
    · exact absurd hb hb0
  · intro z hzO
    let z₀ : O := ⟨z, hzO⟩
    let c : ℤ := (b.repr (Submodule.Quotient.mk (p := Ñ) z₀)) 0
    refine ⟨-c, ?_⟩
    have hmk : (Submodule.Quotient.mk (p := Ñ) z₀ : O ⧸ Ñ) = c • b 0 := by
      have := b.sum_repr (Submodule.Quotient.mk (p := Ñ) z₀)
      rw [Fin.sum_univ_one] at this
      exact this.symm
    have hzero : (Submodule.Quotient.mk (p := Ñ) (z₀ - c • y₀) : O ⧸ Ñ) = 0 := by
      rw [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hy₀, hmk, sub_self]
    rw [Submodule.Quotient.mk_eq_zero] at hzero
    have h2 : O.subtype (z₀ - c • y₀) ∈ N :=
      (Submodule.mem_comap (f := O.subtype) (p := N)).mp hzero
    simpa [z₀, sub_eq_add_neg, neg_smul] using h2

/-! ## The rank of `L` and of `ℤr` -/

/-- Under the standing hypotheses, `L` is a free `ℤ`-module of rank `2` (it is generated by the
two vectors `e 0, e 1`, and `r, u ∈ L` with `θ r = 0 ≠ θ u` are `ℤ`-linearly independent). -/
lemma finrank_L_eq_two {m : ℕ} (L : Submodule ℤ (Fin m → ℤ)) (e : Fin 2 → Fin m → ℤ)
    (hgen : ∀ y : Fin m → ℤ, y ∈ L ↔ ∃ a b : ℤ, y = a • e 0 + b • e 1)
    (θ : (Fin m → ℤ) → ℂ)
    (hθ : ∀ (a b : ℤ) (y z : Fin m → ℤ), θ (a • y + b • z) = (a : ℂ) * θ y + (b : ℂ) * θ z)
    (r u : Fin m → ℤ) (hr : r ∈ L) (hrker : θ r = 0)
    (hprim : ∀ (k : ℤ) (y : Fin m → ℤ), y ∈ L → 2 ≤ |k| → k • y ≠ r)
    (hu : u ∈ L) (huθ : θ u ≠ 0) :
    Module.finrank ℤ L = 2 := by
  have hrne : r ≠ 0 := by
    intro h
    exact hprim 2 0 (L.zero_mem) (by norm_num) (by simp [h])
  have hind : LinearIndependent ℤ ![r, u] := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have hsum : g 0 • r + g 1 • u = 0 := by
      have := hg; rwa [Fin.sum_univ_two] at this
    have hkey : (g 1 : ℂ) * θ u = 0 := by
      have h1 := hθ (g 0) (g 1) r u
      rw [hsum] at h1
      have hzero : θ (0 : Fin m → ℤ) = 0 := by have := hθ 0 0 0 0; simpa using this
      rw [hzero, hrker, mul_zero, zero_add] at h1
      exact h1.symm
    have hg1 : g 1 = 0 := by
      have h : (g 1 : ℂ) = 0 := (mul_eq_zero.mp hkey).resolve_right huθ
      exact_mod_cast h
    intro i
    fin_cases i
    · have h : g 0 • r = 0 := by rw [hg1, zero_smul, add_zero] at hsum; exact hsum
      rcases smul_eq_zero.mp h with h | h
      · exact h
      · exact absurd h hrne
    · exact hg1
  have he_mem : ∀ i, e i ∈ L := by
    intro i
    rw [hgen]
    fin_cases i
    · exact ⟨1, 0, by simp⟩
    · exact ⟨0, 1, by simp⟩
  have hspan_top : Submodule.span ℤ
      (Set.range (fun i : Fin 2 => (⟨e i, he_mem i⟩ : ↥L))) = ⊤ := by
    rw [Submodule.eq_top_iff']
    rintro ⟨y, hy⟩
    rw [Submodule.mem_span_range_iff_exists_fun]
    rw [hgen] at hy
    obtain ⟨a, b, hab⟩ := hy
    refine ⟨![a, b], ?_⟩
    have hsum2 : (∑ i : Fin 2, (![a, b] : Fin 2 → ℤ) i • (⟨e i, he_mem i⟩ : ↥L))
        = a • (⟨e 0, he_mem 0⟩ : ↥L) + b • (⟨e 1, he_mem 1⟩ : ↥L) := by
      rw [Fin.sum_univ_two]; simp
    rw [hsum2]
    apply Subtype.ext
    simpa using hab.symm
  have hfin_le : Module.finrank ℤ ↥L ≤ 2 := by
    have h := finrank_le_of_span_eq_top (R := ℤ) (M := ↥L)
      (v := fun i : Fin 2 => (⟨e i, he_mem i⟩ : ↥L)) hspan_top
    simpa using h
  have hsp_le : Submodule.span ℤ (Set.range ![r, u]) ≤ L := by
    rw [Submodule.span_le]
    rintro x ⟨i, rfl⟩
    fin_cases i
    · exact hr
    · exact hu
  have h2 : Module.finrank ℤ (Submodule.span ℤ (Set.range ![r, u])) = 2 := by
    rw [finrank_span_eq_card hind, Fintype.card_fin]
  haveI : Module.Finite ℤ ↥L := by
    haveI : IsNoetherian ℤ (Fin m → ℤ) := inferInstance
    exact IsNoetherian.finite ℤ ↥L
  have hmono := Submodule.finrank_mono hsp_le
  omega

/-- `ℤr` has `ℤ`-rank one when `r ≠ 0`. -/
lemma finrank_span_singleton_eq_one {m : ℕ} {r : Fin m → ℤ} (hrne : r ≠ 0) :
    Module.finrank ℤ (Submodule.span ℤ ({r} : Set (Fin m → ℤ))) = 1 := by
  have hli : LinearIndependent ℤ (fun _ : Fin 1 => r) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    fin_cases i
    rw [Fin.sum_univ_one] at hg
    rcases smul_eq_zero.mp hg with h | h
    · exact h
    · exact absurd h hrne
  have hrange : Set.range (fun _ : Fin 1 => r) = ({r} : Set (Fin m → ℤ)) := by
    ext x; simp
  rw [← hrange, finrank_span_eq_card hli, Fintype.card_fin]

/-! ## The target theorem -/

theorem aligned_basis_of_short_element {m : ℕ} (L : Submodule ℤ (Fin m → ℤ))
    (e : Fin 2 → Fin m → ℤ)
    (hgen : ∀ y : Fin m → ℤ, y ∈ L ↔ ∃ a b : ℤ, y = a • e 0 + b • e 1)
    (hind : e 0 ≠ 0 → (e 1 = 0 ∨ ∀ a b : ℤ, a • e 0 + b • e 1 = 0 → a = 0 ∧ b = 0))
    (θ : (Fin m → ℤ) → ℂ)
    (hθ : ∀ (a b : ℤ) (y z : Fin m → ℤ), θ (a • y + b • z) = (a : ℂ) * θ y + (b : ℂ) * θ z)
    (c : Fin m → ℝ) (hc : ∀ i, 0 ≤ c i) (T : ℝ) (hT : 0 ≤ T)
    (r u : Fin m → ℤ) (hr : r ∈ L) (hrker : θ r = 0)
    (hprim : ∀ (k : ℤ) (y : Fin m → ℤ), y ∈ L → 2 ≤ |k| → k • y ≠ r)
    (hu : u ∈ L) (huθ : θ u ≠ 0)
    (hub : wn c u + wn c r ≤ T / 2) (hrb : wn c r ≤ T / 2) :
    ∃ e' : Fin 2 → Fin m → ℤ,
      (∀ y : Fin m → ℤ, y ∈ L ↔ ∃ a b : ℤ, y = a • e' 0 + b • e' 1) ∧
      (e' 0 ≠ 0 → (e' 1 = 0 ∨ ∀ a b : ℤ, a • e' 0 + b • e' 1 = 0 → a = 0 ∧ b = 0)) ∧
      (e' 1 = 0 → wn c (e' 0) ≤ T) ∧
      (e' 1 ≠ 0 → θ (e' 0) + θ (e' 1) = 0 ∧ wn c (e' 0) + wn c (e' 1) ≤ T) := by
  have hrne : r ≠ 0 := by
    intro h
    exact hprim 2 0 (L.zero_mem) (by norm_num) (by simp [h])
  -- `u` is not a multiple of `r`, since `θ r = 0 ≠ θ u`
  have hu_notMem : u ∉ Submodule.span ℤ ({r} : Set (Fin m → ℤ)) := by
    intro hmem
    rw [Submodule.mem_span_singleton] at hmem
    obtain ⟨a, ha⟩ := hmem
    have h1 : θ (a • r) = (a : ℂ) * θ r := by
      have := hθ a 0 r r
      simpa using this
    have h2 : θ (a • r) = 0 := by rw [h1, hrker, mul_zero]
    rw [ha] at h2
    exact huθ h2
  -- the lattice data
  have hfin : Module.finrank ℤ L = 2 := finrank_L_eq_two L e hgen θ hθ r u hr hrker hprim hu huθ
  have hfinr : Module.finrank ℤ (Submodule.span ℤ ({r} : Set (Fin m → ℤ))) = 1 :=
    finrank_span_singleton_eq_one hrne
  have hrank : Module.finrank ℤ L
      = Module.finrank ℤ (Submodule.span ℤ ({r} : Set (Fin m → ℤ))) + 1 := by
    rw [hfin, hfinr]
  have hspan_le : Submodule.span ℤ ({r} : Set (Fin m → ℤ)) ≤ L :=
    Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hr)
  have hpure : ∀ (c' : ℤ) (x : Fin m → ℤ), x ∈ L → c' ≠ 0 →
      c' • x ∈ Submodule.span ℤ ({r} : Set (Fin m → ℤ)) →
        x ∈ Submodule.span ℤ ({r} : Set (Fin m → ℤ)) :=
    prim_pure_span_singleton hr hprim
  obtain ⟨A, hA, hind', hgen'⟩ := exists_split_step_pure _ _ hspan_le hpure hrank
  -- `{A, r}` generates `L`
  have hgenA : ∀ y : Fin m → ℤ, y ∈ L ↔ ∃ a b : ℤ, y = a • A + b • r := by
    intro y
    constructor
    · intro hy
      obtain ⟨c', hc'⟩ := hgen' y hy
      rw [Submodule.mem_span_singleton] at hc'
      obtain ⟨mm, hmm⟩ := hc'
      refine ⟨-c', mm, ?_⟩
      have h1 : y = mm • r - c' • A := by rw [eq_sub_iff_add_eq]; exact hmm.symm
      rw [h1]
      simp only [neg_smul]
      abel
    · rintro ⟨a, b, rfl⟩
      exact L.add_mem (L.smul_mem a hA) (L.smul_mem b hr)
  -- `{A, r}` is independent
  have hmemr : r ∈ Submodule.span ℤ ({r} : Set (Fin m → ℤ)) :=
    Submodule.subset_span (Set.mem_singleton r)
  have hindA : ∀ a b : ℤ, a • A + b • r = 0 → a = 0 ∧ b = 0 := by
    intro a b hab
    have ha : a = 0 := hind' a (b • r) (Submodule.smul_mem _ b hmemr) hab
    refine ⟨ha, ?_⟩
    have hbr : b • r = 0 := by rw [ha, zero_smul, zero_add] at hab; exact hab
    rcases smul_eq_zero.mp hbr with h | h
    · exact h
    · exact absurd h hrne
  -- the decomposition of `u` in the basis `(A, r)`
  have hdec : ∃ d mm : ℤ, d ≠ 0 ∧ u = d • A + mm • r := by
    obtain ⟨c', hc'⟩ := hgen' u hu
    rw [Submodule.mem_span_singleton] at hc'
    obtain ⟨mm, hmm⟩ := hc'
    refine ⟨-c', mm, ?_, ?_⟩
    · intro hneg
      apply hu_notMem
      have hc0 : c' = 0 := by omega
      rw [hc0, zero_smul, add_zero] at hmm
      rw [← hmm]
      exact Submodule.smul_mem _ mm hmemr
    · have h1 : u = mm • r - c' • A := by rw [eq_sub_iff_add_eq]; exact hmm.symm
      rw [h1]
      simp only [neg_smul]
      abel
  exact aligned_from_basis_partner L A r u hA hr hgenA hindA θ hθ hrker c hc T hT huθ hdec hub

end Work.BW
