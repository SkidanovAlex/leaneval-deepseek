    Subsingleton (CategoryTheory.Abelian.Ext X ↧(QuotSMulTop x (↥M)) i) := by
  have hS : (M.smulShortComplex x).ShortExact := hx.smulShortComplex_shortExact
  have hzero1 : IsZero (↧(CategoryTheory.Abelian.Ext X M i) : AddCommGrpCat) :=
    AddCommGrpCat.isZero_of_iff_subsingleton.mpr h1
  have hzero2 : IsZero (↧(CategoryTheory.Abelian.Ext X M (i + 1)) : AddCommGrpCat) :=
    AddCommGrpCat.isZero_of_iff_subsingleton.mpr h2
  have key : IsZero
      (↧(CategoryTheory.Abelian.Ext X (M.smulShortComplex x).X₃ i) : AddCommGrpCat) :=
    ShortComplex.Exact.isZero_of_both_zeros
      (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' X hS i (i + 1) rfl)
      (hzero1.eq_zero_of_src _) (hzero2.eq_zero_of_tgt _)
  change Subsingleton (CategoryTheory.Abelian.Ext X (M.smulShortComplex x).X₃ i)
  exact AddCommGrpCat.subsingleton_of_isZero key

/-- Vanishing of `Ext N · n` is invariant under isomorphism in the second variable. -/
private lemma subsingleton_ext_iso {X Y Y' : ModuleCat.{u} R} (e : Y ≅ Y') (n : ℕ) :
    Subsingleton (CategoryTheory.Abelian.Ext X Y n) ↔
      Subsingleton (CategoryTheory.Abelian.Ext X Y' n) := by
  have key : Subsingleton ↥((CategoryTheory.Abelian.extFunctorObj X n).obj Y) ↔
      Subsingleton ↥((CategoryTheory.Abelian.extFunctorObj X n).obj Y') := by
    have iso := (CategoryTheory.Abelian.extFunctorObj X n).mapIso e
    have hinj : Function.Injective (iso.hom.hom :
        ↥((CategoryTheory.Abelian.extFunctorObj X n).obj Y) →
        ↥((CategoryTheory.Abelian.extFunctorObj X n).obj Y')) :=
      AddCommGrpCat.mono_iff_injective _ |>.mp inferInstance
    have hsurj : Function.Surjective (iso.hom.hom :
        ↥((CategoryTheory.Abelian.extFunctorObj X n).obj Y) →
        ↥((CategoryTheory.Abelian.extFunctorObj X n).obj Y')) :=
      AddCommGrpCat.epi_iff_surjective _ |>.mp inferInstance
    constructor
    · intro h
      exact ⟨fun a b => by
        obtain ⟨a', rfl⟩ := hsurj a
        obtain ⟨b', rfl⟩ := hsurj b
        rw [h.allEq a' b']⟩
    · intro h
      exact ⟨fun a b => hinj (h.allEq _ _)⟩
  exact key

/-- Iterating the one-step lemma over a weakly regular sequence `f`: if `Ext N M k` vanishes
for all `k < n`, then `Ext N (M ⧸ (f)M) i` vanishes whenever `i + |f| < n`. -/
private lemma ext_subsingleton_quotList (N : ModuleCat.{u} R) (f : List R) (M : ModuleCat.{u} R)
    (hwf : RingTheory.Sequence.IsWeaklyRegular ↥M f) (n : ℕ)
    (hn : ∀ k < n, Subsingleton (CategoryTheory.Abelian.Ext N M k)) :
    ∀ i, i + f.length < n →
      Subsingleton (CategoryTheory.Abelian.Ext N
        (↧(↥M ⧸ (Ideal.ofList f • (⊤ : Submodule R ↥M)))) i) := by
  induction f generalizing M n with
  | nil =>
    intro i hi
    refine (subsingleton_ext_iso (Submodule.quotEquivOfEqBot _ ?_).toModuleIso i).mpr ?_
    · simp
    · simpa using hn i (by simpa using hi)
  | cons a f' ih =>
    intro i hi
    rw [List.length_cons] at hi
    have hc := (RingTheory.Sequence.isWeaklyRegular_cons_iff (↥M) a f').mp hwf
    have hx : IsSMulRegular (↥M) a := hc.1
    have hwf' : RingTheory.Sequence.IsWeaklyRegular (QuotSMulTop a ↥M) f' := hc.2
    refine (subsingleton_ext_iso
      (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner (↥M) a f').toModuleIso i).mpr ?_
    exact ih (↧(QuotSMulTop a ↥M)) hwf' (n - 1)
      (fun k hk => ext_subsingleton_quotSMulTop hx (hn k (by omega)) (hn (k + 1) (by omega)))
      i (by omega)

end Aux

/-- Block A5b. If `A` has a regular sequence of length `n` in `𝔪` and `f` is a regular
sequence in `𝔪`, then `A/(f)` has one of length `n − |f|`. Route: Mathlib's Rees
characterisation `ModuleCat.exists_isRegular_tfae` plus the long exact `Ext(A/𝔪, ·)` sequence
of `0 → A → A → A/xA → 0`, one element at a time. -/
theorem regSeq_quotient {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (rs f : List A) (hrs : ∀ x ∈ rs, x ∈ IsLocalRing.maximalIdeal A)
    (hreg : RingTheory.Sequence.IsRegular A rs) (hf : ∀ x ∈ f, x ∈ IsLocalRing.maximalIdeal A)
    (hfreg : RingTheory.Sequence.IsRegular A f) (hlen : f.length ≤ rs.length) :
    ∃ ss : List A, ss.length = rs.length - f.length ∧
      (∀ x ∈ ss, x ∈ IsLocalRing.maximalIdeal A) ∧
      RingTheory.Sequence.IsRegular (A ⧸ Ideal.span {x | x ∈ f}) ss := by
  set I : Ideal A := IsLocalRing.maximalIdeal A with hI
  let X : ModuleCat A := ModuleCat.of A (A ⧸ I)
  let M0 : ModuleCat A := ModuleCat.of A A
  have hsupp : Module.support A (↥X) = PrimeSpectrum.zeroLocus I := by
    rw [Module.support_eq_zeroLocus, Ideal.annihilator_quotient]
  -- Step 1: `Ext^i(A/𝔪, A) = 0` for `i < |rs|`, from Rees applied to the regular sequence `rs`.
  have hExtA : ∀ i < rs.length, Subsingleton (CategoryTheory.Abelian.Ext X M0 i) := by
    refine ModuleCat.subsingleton_ext_of_exists_isRegular I X hsupp.le M0 ?_ rs hrs ?_
    · rw [lt_top_iff_ne_top, ne_eq]
      intro h
      rw [hI] at h
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top (by simpa using h)
    · exact hreg
  -- Step 2: iterate modulo `f`.
  have hwf : RingTheory.Sequence.IsWeaklyRegular ↥M0 f := hfreg.toIsWeaklyRegular
  have hExtM := ext_subsingleton_quotList X f M0 hwf rs.length hExtA
  -- Step 3: identify `↥M0 ⧸ (f)·↥M0` with `A ⧸ (f)`.
  have hExtM' : ∀ i < rs.length - f.length,
      Subsingleton (CategoryTheory.Abelian.Ext X (↧(A ⧸ Ideal.ofList f)) i) := by
    intro i hi
    have hi' : i + f.length < rs.length := by omega
    refine (subsingleton_ext_iso (Submodule.quotEquivOfEq
      (Ideal.ofList f • (⊤ : Submodule A A)) (Ideal.ofList f) (by simp)).toModuleIso i).mp ?_
    exact hExtM i hi'
  -- Step 4: Rees, applied to `A ⧸ (f)`.
  have hJne : Ideal.ofList f ≠ ⊤ := by simpa using hfreg.top_ne_smul.symm
  have hnt : Nontrivial (A ⧸ Ideal.ofList f) :=
    Submodule.Quotient.nontrivial_iff.mpr (by simpa using hJne)
  haveI := hnt
  have hsmul : I • (⊤ : Submodule A (A ⧸ Ideal.ofList f)) < ⊤ := by
    rw [lt_top_iff_ne_top]
    refine (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator ?_).symm
    rw [Ideal.annihilator_quotient, hI]
    exact le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (Ideal.ofList f) hJne).symm
  obtain ⟨ss, hlen', hmem', hreg''⟩ :=
    ModuleCat.exists_isRegular_of_exists_subsingleton_ext I (rs.length - f.length)
      (↧(A ⧸ Ideal.ofList f)) hsmul X hsupp hExtM'
  exact ⟨ss, hlen', fun x hx => hmem' x hx, hreg''⟩

end Work.BW
