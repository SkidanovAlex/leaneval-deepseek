import Mathlib
import Submission.Work.BW.DefsMult

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Auxiliary definitions for `Work.BW.subgroup_rayDeg` (block B4)

The closure of `G' = G_a^ε × ker 𝒵` in `(P¹)^{N+1}`, where `𝒵 ⊂ ℤ^N` is spanned by the rows
of an integer matrix `M` (`ρ` rows, `N` columns), has `Hilbert function along the ray `tD`
equal to `(t D₀ + 1)^ε` times the number of classes of the box `∏ᵢ [0, t D_{i+1}]` in
`ℤ^N / 𝒵`.  This file sets up the lattice, the box, the class count and the characters
`y ↦ ∏ᵢ yᵢ^{vᵢ}`, together with the basic monomials of the coordinate ring.
-/

namespace Work.BW

open MvPolynomial

/-- `𝒵`, the `ℤ`-lattice spanned by the rows of `M` inside `ℤ^N`
(vectors are the rows of `M`, seen as elements of `Fin N → ℤ`). -/
def rowLat (N ρ : ℕ) (M : Fin ρ → Fin N → ℤ) : Submodule ℤ (Fin N → ℤ) :=
  Submodule.span ℤ (Set.range M)

/-- The box `∏ᵢ [0, mᵢ]` as a finite set of lattice points of `ℤ^N`. -/
noncomputable def boxPts (N : ℕ) (m : Fin N → ℕ) : Finset (Fin N → ℤ) :=
  (Finset.univ.pi (fun i : Fin N => Finset.range (m i + 1))).image
    (fun b => fun i => ((b i (Finset.mem_univ i) : ℕ) : ℤ))

/-- Number of classes of the box `∏ᵢ [0, mᵢ]` modulo the lattice `𝒵 = rowLat M`. -/
noncomputable def boxClassCount (N ρ : ℕ) (M : Fin ρ → Fin N → ℤ) (m : Fin N → ℕ) : ℕ := by
  classical
  exact ((boxPts N m).image (fun b => (Submodule.Quotient.mk b : (Fin N → ℤ) ⧸ rowLat N ρ M))).card

/-- The class of a lattice point in `ℤ^N ⧸ 𝒵`. -/
noncomputable def clsOf (N ρ : ℕ) (M : Fin ρ → Fin N → ℤ) (z : Fin N → ℤ) :
    (Fin N → ℤ) ⧸ rowLat N ρ M :=
  Submodule.Quotient.mk z

/-- The torus part of an exponent vector `b : Fin (N+1) → ℕ` (the exponents of the
`X_{i,1}`, `i ≥ 1`). -/
def torPart {N : ℕ} (b : Fin (N + 1) → ℕ) : Fin N → ℤ := fun i => (b i.succ : ℤ)

/-- The monomial character `χ^v(y) = ∏ᵢ yᵢ^{vᵢ}`. -/
noncomputable def charFun {N : ℕ} (v : Fin N → ℤ) (y : Fin N → ℂ) : ℂ :=
  ∏ i, y i ^ (v i)

/-- The monomial `∏ᵢ X_{i,1}^{bᵢ} X_{i,0}^{dᵢ - bᵢ}` of `(P¹)^{N+1}`, with `X_{i,1}`-exponents
`b`; it is multihomogeneous of multidegree `d` whenever `bᵢ ≤ dᵢ` for all `i`. -/
noncomputable def mono (N : ℕ) (d : Fin (N + 1) →₀ ℕ) (b : Fin (N + 1) → ℕ) : MR N :=
  ∏ i : Fin (N + 1), MvPolynomial.X (i, 1) ^ (b i) * MvPolynomial.X (i, 0) ^ (d i - b i)

/-- The `X_{i,1}`-exponents `b` of the monomials of multidegree `d`: the box `∏ᵢ [0, dᵢ]`
(elements of `Fin (N+1) → ℕ`). -/
noncomputable def degBox (N : ℕ) (d : Fin (N + 1) →₀ ℕ) : Finset (Fin (N + 1) → ℕ) :=
  (Finset.univ.pi (fun i : Fin (N + 1) => Finset.range (d i + 1))).image
    (fun b => fun i => b i (Finset.mem_univ i))

/-- Number of fibers `(b 0, class of the torus part)` realized by the exponent box `degBox N d`. -/
noncomputable def fibImg (N ρ : ℕ) (d : Fin (N + 1) →₀ ℕ) (M : Fin ρ → Fin N → ℤ) : ℕ := by
  classical
  exact ((degBox N d).image (fun b => (b 0, clsOf N ρ M (torPart b)))).card

/-- Number of classes of the torus box realized by exponent vectors with `b 0 = 0`. -/
noncomputable def clsImg (N ρ : ℕ) (d : Fin (N + 1) →₀ ℕ) (M : Fin ρ → Fin N → ℤ) : ℕ := by
  classical
  exact (((degBox N d).filter (fun b => b 0 = 0)).image (fun b => clsOf N ρ M (torPart b))).card

/-- The ideal of the closure of `G' = G_a^ε × ker 𝒵` is multihomogeneous (it is generated by
multihomogeneous elements, so the weighted homogeneous components of any of its elements
again lie in it). -/
theorem multiHom_subIdeal (N ρ : ℕ) (ε : Bool) (M : Fin ρ → Fin N → ℤ) :
    MultiHom N (subIdeal N ρ ε M) := by
  letI : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) :=
    MvPolynomial.weightedGradedAlgebra ℂ (mdeg N)
  have hgen : ∀ x ∈ {F : MR N | (∃ d, F ∈ homPiece N d) ∧
      ∀ y, InSub N ρ ε M y → MvPolynomial.eval (conePt N y) F = 0},
      SetLike.IsHomogeneousElem (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) x := by
    rintro x ⟨⟨d, hd⟩, -⟩
    exact ⟨d, hd⟩
  have hI : (subIdeal N ρ ε M).IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) :=
    Ideal.homogeneous_span (MvPolynomial.weightedHomogeneousSubmodule ℂ (mdeg N)) _ hgen
  intro p hp d
  exact (MvPolynomial.mem_iff_weightedHomogeneousComponent_mem ℂ (mdeg N) hI p).mp hp d



/-- The class count of a box is at least one (the box contains the origin). -/
lemma one_le_boxClassCount {N ρ : ℕ} (M : Fin ρ → Fin N → ℤ) (m : Fin N → ℕ) :
    1 ≤ boxClassCount N ρ M m := by
  classical
  have hne : (boxPts N m).Nonempty := by
    refine ⟨fun i => ((0 : ℕ) : ℤ), ?_⟩
    rw [boxPts]
    refine Finset.mem_image.mpr ⟨fun i _ => (0 : ℕ), ?_, rfl⟩
    simp [Finset.mem_pi]
  have hpos : 0 < ((boxPts N m).image
      (fun b => (Submodule.Quotient.mk b : (Fin N → ℤ) ⧸ rowLat N ρ M))).card :=
    Finset.card_pos.mpr (hne.image _)
  rw [boxClassCount]
  exact hpos

end Work.BW
