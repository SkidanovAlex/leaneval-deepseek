import Submission.Work.BW.sic_kcbIdealProd_discrete


/-!
# Covolume of the image of the second Siegel map

`Work.BW.sieg2_image_covolume` is the lower bound

  `(2^{-r₂}·√|disc F|)^M · ∏_i (∏ᶠ_v (⨆_j v (a i j)))⁻¹ ≤ covolume (im (PhiE a))`

for the image `im (PhiE a) = PhiE a '' (𝓞 F)^N ⊆ (KE F)^M` of the integral lattice under the
second Siegel map given by the `F`-independent rows `a i`.  The right hand side is (up to the
infinite-place bookkeeping) the product of the absolute norms of the ideals generated by the rows
of `a`, and the inequality is `step 4` of the sharp Bombieri–Vaaler kernel-lattice bound: the
image lattice `PhiE a '' (𝓞 F)^N` is contained in the product `∏_i meK (𝔞_i)` of the row ideals,
whose covolume is exactly the right hand side.

The strategy is therefore:

* `Work.BW.sic_Phi_intLat_le` : in the product model, `Phi a '' (𝓞 F)^N ⊆ ∏_i meK (𝔞_i)`;
* `Work.BW.sic_kcbEquiv_PhiE` / `Work.BW.sic_kcbEquiv_intLatE` : the coordinate equivalence
  `kcbEquiv` intertwines `PhiE a` with `Phi a` and carries `intLatE F N` onto `intLat F N`, so the
  containment transfers to `PhiE a '' (intLatE F N) ⊆ kcbIdealCoord (kcbRowIdeal a)`;
* `Work.BW.sic_covolume_kcbIdealCoord` : the covolume of the ideal-product lattice is the right
  hand side;
* `Work.BW.sic_covolume_mono` : covolume is antitone for full lattices, so the containment gives
  the inequality;
* `Work.BW.sic_finprod_inv_eq_absNorm` : the finite-place product is the inverse absolute norm.
-/

set_option linter.style.haveILetI false

open scoped Classical
open NumberField MeasureTheory

namespace Work.BW

/-- The finite places contribute the inverse of the absolute norm of the ideal generated by the
row: the product over the rows of `(∏ᶠ_v (⨆_j v (a i j)))⁻¹` equals the product of the absolute
norms of the row ideals. -/
theorem sic_finprod_inv_eq_absNorm {F : Type*} [Field F] [NumberField F] {M N : ℕ}
    (a : Fin M → Fin N → F) (hne : ∀ i, a i ≠ 0) :
    ∏ i : Fin M, (∏ᶠ v : NumberField.FinitePlace F, (⨆ j : Fin N, v (a i j)))⁻¹
      = ∏ i : Fin M, ((FractionalIdeal.absNorm
            (FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ (a i)) :
          ℚ) : ℝ) := by
  refine Finset.prod_congr rfl fun i _ => ?_
  obtain ⟨j, hj⟩ := Function.ne_iff.mp (hne i)
  rw [sieg2_finprod_sup_absNorm (a i) ⟨j, hj⟩, inv_inv]

/-- Covolume is antitone for full `ℤ`-lattices: a larger lattice has smaller covolume. -/
theorem sic_covolume_mono {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    (L₁ L₂ : Submodule ℤ E) [DiscreteTopology ↥L₁] [IsZLattice ℝ L₁]
    [DiscreteTopology ↥L₂] [IsZLattice ℝ L₂] (h : L₁ ≤ L₂) :
    ZLattice.covolume L₂ volume ≤ ZLattice.covolume L₁ volume := by
  have hpos1 : 0 < ZLattice.covolume L₁ volume := ZLattice.covolume_pos L₁ volume
  have hpos2 : 0 < ZLattice.covolume L₂ volume := ZLattice.covolume_pos L₂ volume
  have hrel : ZLattice.covolume L₁ volume / ZLattice.covolume L₂ volume
      = (L₁.toAddSubgroup.relIndex L₂.toAddSubgroup : ℝ) :=
    ZLattice.covolume_div_covolume_eq_relIndex' L₁ L₂ h
  have hgt : (0 : ℝ) < (L₁.toAddSubgroup.relIndex L₂.toAddSubgroup : ℝ) := by
    rw [← hrel]
    exact div_pos hpos1 hpos2
  have hge1 : (1 : ℝ) ≤ ZLattice.covolume L₁ volume / ZLattice.covolume L₂ volume := by
    rw [hrel]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (by exact_mod_cast hgt.ne')
  rwa [le_div_iff₀ hpos2, one_mul] at hge1

theorem sieg2_image_covolume {F : Type*} [Field F] [NumberField F] {M N : ℕ}
    (a : Fin M → Fin N → F) (hli : LinearIndependent F a)
    [DiscreteTopology ↥(intLatE F N)]
    [DiscreteTopology ↥(Submodule.map ((PhiE a).restrictScalars ℤ) (intLatE F N))]
    [IsZLattice ℝ (Submodule.map ((PhiE a).restrictScalars ℤ) (intLatE F N))] :
    ((1 / 2 : ℝ) ^ (NumberField.InfinitePlace.nrComplexPlaces F) *
        Real.sqrt |((NumberField.discr F : ℤ) : ℝ)|) ^ M *
      ∏ i : Fin M, (∏ᶠ v : NumberField.FinitePlace F, (⨆ j : Fin N, v (a i j)))⁻¹
      ≤ ZLattice.covolume (Submodule.map ((PhiE a).restrictScalars ℤ) (intLatE F N))
        (MeasureTheory.volume) := by
  have hne : ∀ i, a i ≠ 0 := fun i => hli.ne_zero i
  -- the image lattice is contained in the lattice of the row ideals
  have hsub : Submodule.map ((PhiE a).restrictScalars ℤ) (intLatE F N) ≤
      kcbIdealCoord (F := F) (kcbRowIdeal (F := F) a hne) := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.mp hx
    change kcbEquiv F M (PhiE a z) ∈ kcbIdealProd (F := F) (kcbRowIdeal (F := F) a hne)
    rw [sic_kcbEquiv_PhiE a z]
    have hz' : kcbEquiv F N z ∈ (intLat (F := F) N : Set (Fin N → KE F)) :=
      (sic_kcbEquiv_intLatE (F := F) N) ▸ (⟨z, hz, rfl⟩ : kcbEquiv F N z ∈
        (kcbEquiv F N '' (intLatE F N : Set (kcbE F N))))
    exact sic_Phi_intLat_le a hne (Submodule.mem_map.mpr ⟨kcbEquiv F N z, hz', rfl⟩)
  -- the lattices involved are full `ℤ`-lattices
  haveI hdis : DiscreteTopology ↥(kcbIdealProd (F := F) (kcbRowIdeal (F := F) a hne)) :=
    sic_kcbIdealProd_discrete (F := F) (kcbRowIdeal (F := F) a hne)
  haveI hED : ∀ i, DiscreteTopology ↥(kcbIdealE (F := F) (kcbRowIdeal (F := F) a hne i)) :=
    fun i => ZLattice.comap_discreteTopology ℝ
      (NumberField.mixedEmbedding.idealLattice F (kcbRowIdeal (F := F) a hne i))
      (NumberField.mixedEmbedding.euclidean.toMixed F).continuous
      (NumberField.mixedEmbedding.euclidean.toMixed F).injective
  haveI hEL : ∀ i, IsZLattice ℝ (kcbIdealE (F := F) (kcbRowIdeal (F := F) a hne i)) :=
    fun i => ⟨ZLattice.comap_span_top ℝ
      (NumberField.mixedEmbedding.idealLattice F (kcbRowIdeal (F := F) a hne i))
      (inferInstance : IsZLattice ℝ
        (NumberField.mixedEmbedding.idealLattice F (kcbRowIdeal (F := F) a hne i))).span_top
      (by rw [LinearMap.range_eq_top.mpr (NumberField.mixedEmbedding.euclidean.toMixed F).surjective]
          exact Set.subset_univ _)⟩
  haveI hzlat : IsZLattice ℝ (kcbIdealProd (F := F) (kcbRowIdeal (F := F) a hne)) :=
    ⟨pi_span_top _ (fun i => (inferInstance : IsZLattice ℝ
      (kcbIdealE (F := F) (kcbRowIdeal (F := F) a hne i))).span_top)⟩
  haveI : DiscreteTopology ↥(kcbIdealCoord (F := F) (kcbRowIdeal (F := F) a hne)) :=
    ZLattice.comap_discreteTopology ℝ (kcbIdealProd (F := F) (kcbRowIdeal (F := F) a hne))
      ((kcbEquiv F M).toContinuousLinearEquiv.continuous) (kcbEquiv F M).injective
  haveI : IsZLattice ℝ (kcbIdealCoord (F := F) (kcbRowIdeal (F := F) a hne)) :=
    ⟨ZLattice.comap_span_top ℝ (kcbIdealProd (F := F) (kcbRowIdeal (F := F) a hne)) hzlat.span_top
      (by intro x _; exact ⟨(kcbEquiv F M).symm x, by simp⟩)⟩
  -- monotonicity and the covolume of the ideal-product lattice
  have hmono := sic_covolume_mono (Submodule.map ((PhiE a).restrictScalars ℤ) (intLatE F N))
    (kcbIdealCoord (F := F) (kcbRowIdeal (F := F) a hne)) hsub
  have hcov := sic_covolume_kcbIdealCoord (F := F) (kcbRowIdeal (F := F) a hne)
  have hfin : ∏ i : Fin M, (∏ᶠ v : NumberField.FinitePlace F, (⨆ j : Fin N, v (a i j)))⁻¹
      = ∏ i : Fin M, ((FractionalIdeal.absNorm (kcbRowIdeal (F := F) a hne i :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) : ℚ) : ℝ) := by
    rw [sic_finprod_inv_eq_absNorm a hne]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [kcbRowIdeal_coe]
  calc ((1 / 2 : ℝ) ^ (NumberField.InfinitePlace.nrComplexPlaces F) *
          Real.sqrt |((NumberField.discr F : ℤ) : ℝ)|) ^ M *
        ∏ i : Fin M, (∏ᶠ v : NumberField.FinitePlace F, (⨆ j : Fin N, v (a i j)))⁻¹
      = (∏ i : Fin M, ((FractionalIdeal.absNorm (kcbRowIdeal (F := F) a hne i :
            FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) : ℚ) : ℝ)) *
          ((1 / 2 : ℝ) ^ (NumberField.InfinitePlace.nrComplexPlaces F) *
            Real.sqrt |((NumberField.discr F : ℤ) : ℝ)|) ^ M := by
        rw [hfin]; ring
    _ = ZLattice.covolume (kcbIdealCoord (F := F) (kcbRowIdeal (F := F) a hne)) volume :=
        hcov.symm
    _ ≤ ZLattice.covolume (Submodule.map ((PhiE a).restrictScalars ℤ) (intLatE F N)) volume :=
        hmono

end Work.BW
