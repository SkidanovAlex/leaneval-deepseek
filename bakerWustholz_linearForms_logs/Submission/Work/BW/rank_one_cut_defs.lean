import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Auxiliary objects for the rank-one cut lemma

For a commutative ring `A`, an `A`-module `M`, an element `P : A` and a submodule `N ≤ M` we
collect the pieces used to state `Work.BW.rank_one_cut_length`:

* `cutPM P = P·M = (P) • ⊤`, the submodule of multiples of `P` in `M`;
* `cutQ P N = N ∩ P·M`, viewed as a submodule of `N`;
* `cutPN P N = P·N`, as a submodule of `N`;
* `cutPNQ P N = P·N`, as a submodule of `cutQ P N`;
* `cutMap P N`, multiplication by `P` on `M ⧸ N`.
-/

open scoped Pointwise

namespace Work.BW

variable {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]

/-- `P·M = (P) • ⊤`, the submodule of `M` generated by the multiples of `P`. -/
noncomputable def cutPM (P : A) : Submodule A M := Ideal.span {P} • (⊤ : Submodule A M)

/-- `N ⊔ P·M`, the submodule of `M` generated by `N` and the multiples of `P`. -/
noncomputable def cutSup (P : A) (N : Submodule A M) : Submodule A M := N ⊔ cutPM (M := M) P

/-- `N ∩ P·M`, viewed as a submodule of `N`. -/
noncomputable def cutQ (P : A) (N : Submodule A M) : Submodule A N :=
  (cutPM (M := M) P).comap N.subtype

/-- `P·N`, as a submodule of `N`. -/
noncomputable def cutPN (P : A) (N : Submodule A M) : Submodule A N :=
  Ideal.span {P} • (⊤ : Submodule A N)

/-- `P·N`, as a submodule of `N ∩ P·M`. -/
noncomputable def cutPNQ (P : A) (N : Submodule A M) : Submodule A (cutQ P N) :=
  (cutPN P N).comap (cutQ P N).subtype

theorem le_comap_lsmul (P : A) (N : Submodule A M) :
    N ≤ Submodule.comap (LinearMap.lsmul A M P) N :=
  fun _ hx => N.smul_mem P hx

/-- Multiplication by `P` on the quotient `M ⧸ N`. -/
noncomputable def cutMap (P : A) (N : Submodule A M) : (M ⧸ N) →ₗ[A] (M ⧸ N) :=
  N.mapQ N (LinearMap.lsmul A M P) (le_comap_lsmul P N)

theorem cutPM_eq_range (P : A) : cutPM (M := M) P = (LinearMap.lsmul A M P).range := by
  rw [cutPM, Submodule.ideal_span_singleton_smul, Submodule.pointwise_smul_def,
    Submodule.map_top]
  rfl

theorem cutMap_range (P : A) (N : Submodule A M) :
    (cutMap P N).range = (cutPM (M := M) P).map N.mkQ := by
  rw [cutMap, Submodule.range_mapQ, cutPM_eq_range]

theorem cutMap_ker (P : A) (N : Submodule A M) :
    (cutMap P N).ker = (Submodule.comap (LinearMap.lsmul A M P) N).map N.mkQ := by
  rw [cutMap, Submodule.ker_mapQ]

theorem cutPN_le_cutQ (P : A) (N : Submodule A M) : cutPN P N ≤ cutQ P N := by
  intro x hx
  rw [cutQ, Submodule.mem_comap]
  exact Submodule.smul_mono le_rfl le_top ((Submodule.mem_smul_top_iff (Ideal.span {P}) N x).mp hx)

end Work.BW
