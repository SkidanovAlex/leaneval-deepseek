import Mathlib
import Submission.Work.BW.absNorm_map_ringEquiv

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.BW

open NumberField in
/-- The non-archimedean (finite place) part `∏ᶠ_v supᵢ v(q_i)` of the height of a tuple of
algebraic integers is invariant under ring isomorphisms of the rings of integers.
The intended proof: `absNorm_mul_finprod_finitePlace_eq_one` identifies each side with
`(Ideal.absNorm (Ideal.span (Set.range ·)))⁻¹`, and `Ideal.span (Set.range (E ∘ q)) =
(Ideal.span (Set.range q)).map E`, so the two absNorms agree by `absNorm_map_ringEquiv`. -/
theorem finprod_finitePlace_ringEquiv {K K' : Type*} [Field K] [NumberField K] [Field K'] [NumberField K']
    (E : 𝓞 K ≃+* 𝓞 K') {ι : Type*} [Fintype ι] (q : ι → 𝓞 K) (hq : q ≠ 0) :
    (∏ᶠ v : FinitePlace K', ⨆ i, v ((E (q i) : 𝓞 K') : K')) =
      ∏ᶠ v : FinitePlace K, ⨆ i, v ((q i : 𝓞 K) : K) := by
  have : Finite ι := inferInstance
  -- the transported tuple is again nonzero, `E` being injective
  have hq' : (fun i => E (q i)) ≠ 0 := by
    intro h
    refine hq (funext fun i => ?_)
    exact E.injective (by simpa using congrFun h i)
  -- the ideal generated by the transported tuple is the transport of the ideal generated by `q`
  have hmap : Ideal.span (Set.range (fun i => E (q i)))
      = (Ideal.span (Set.range q)).map (E : 𝓞 K →+* 𝓞 K') := by
    rw [Ideal.map_span]
    congr 1
    ext x
    simp
  have habs : Ideal.absNorm (Ideal.span (Set.range (fun i => E (q i))))
      = Ideal.absNorm (Ideal.span (Set.range q)) := by
    rw [hmap]
    exact absNorm_map_ringEquiv E _
  -- both products are the inverse of the same absolute norm
  have h1 := NumberField.absNorm_mul_finprod_finitePlace_eq_one hq
  have h2 := NumberField.absNorm_mul_finprod_finitePlace_eq_one hq'
  rw [habs] at h2
  have ha : (Ideal.absNorm (Ideal.span (Set.range q)) : ℝ) ≠ 0 := by
    intro h
    rw [h, zero_mul] at h1
    exact one_ne_zero h1.symm
  refine mul_left_cancel₀ ha ?_
  rw [h2, h1]

end Work.BW
