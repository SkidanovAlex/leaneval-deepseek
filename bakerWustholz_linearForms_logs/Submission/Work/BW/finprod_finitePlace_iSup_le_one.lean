import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.BW

/-- The "finite part" of the multiplicative height of a nonzero tuple of algebraic integers
is at most `1`: by the product formula it equals the inverse of the absolute norm of the
ideal generated by the tuple, and that norm is a positive natural number.

This is the key input to the Archimedean/finite-part splitting of the modified height in
the Baker–Wüstholz argument. -/
lemma finprod_finitePlace_iSup_le_one {F : Type*} [Field F] [NumberField F] {ι : Type*} [Finite ι]
    (x : ι → NumberField.RingOfIntegers F) (hx : x ≠ 0) :
    (∏ᶠ v : NumberField.FinitePlace F, ⨆ i, v ((x i : F))) ≤ 1 := by
  -- Product formula for the finite places: `absNorm I * ∏ᶠ v ⨆ i, v (x i) = 1`.
  have hmain := NumberField.absNorm_mul_finprod_finitePlace_eq_one (K := F) hx
  -- The ideal generated by a nonzero tuple is nonzero.
  have hne : Ideal.span (Set.range x) ≠ ⊥ := by
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hx
    intro h
    have h1 : Ideal.span ({x i} : Set (NumberField.RingOfIntegers F)) ≤
        Ideal.span (Set.range x) :=
      Ideal.span_mono (Set.singleton_subset_iff.mpr ⟨i, rfl⟩)
    have h2 : Ideal.span ({x i} : Set (NumberField.RingOfIntegers F)) = ⊥ :=
      le_bot_iff.mp (h ▸ h1)
    exact hi (Ideal.span_singleton_eq_bot.mp h2)
  have hpos : (0 : ℝ) < ((Ideal.span (Set.range x)).absNorm : ℝ) := by
    have h' : (Ideal.span (Set.range x)).absNorm ≠ 0 :=
      Ideal.absNorm_eq_zero_iff.not.mpr hne
    exact_mod_cast Nat.pos_of_ne_zero h'
  have hge1 : (1 : ℝ) ≤ ((Ideal.span (Set.range x)).absNorm : ℝ) := by
    have h' : 1 ≤ (Ideal.span (Set.range x)).absNorm :=
      Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hne)
    exact_mod_cast h'
  have hP : (∏ᶠ v : NumberField.FinitePlace F, ⨆ i, v ((x i : F)))
      = 1 / ((Ideal.span (Set.range x)).absNorm : ℝ) := by
    rw [eq_div_iff (ne_of_gt hpos), mul_comm]
    exact hmain
  rw [hP, div_le_one hpos]
  exact hge1

end Work.BW
