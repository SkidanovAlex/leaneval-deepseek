import Mathlib
import Submission.Work.BW.DefsMult

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.BW

open MvPolynomial

/-- Any polynomial in `MR N = MvPolynomial (Fin (N+1) × Fin 2) ℂ` differs from its constant
coefficient by an element of the ideal generated by the variables. -/
private lemma sub_C_constantCoeff_mem_idealOfVars {N : ℕ} (p : MR N) :
    p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      MvPolynomial.idealOfVars (Fin (N + 1) × Fin 2) ℂ := by
  rw [MvPolynomial.idealOfVars, ← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  have hc : (p - MvPolynomial.C (MvPolynomial.constantCoeff p)).coeff 0 = 0 := by
    simp [MvPolynomial.constantCoeff_eq]
  have hne : m ≠ 0 := by
    intro h0
    rw [h0] at hm
    exact (MvPolynomial.mem_support_iff.mp hm) hc
  obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
  exact ⟨i, trivial, by simpa using hi⟩

theorem finiteDim_vars_zero {N : ℕ} {M : Type*} [AddCommGroup M] [Module ℂ M]
    [Module (MR N) M] [IsScalarTower ℂ (MR N) M] (hfin : Module.Finite (MR N) M)
    (h : ∀ v : Fin (N + 1) × Fin 2, ∀ m : M, (MvPolynomial.X v : MR N) • m = 0) :
    FiniteDimensional ℂ M := by
  -- Step 1: since the variables kill `M`, every polynomial acts through its constant term.
  have key : ∀ (p : MR N) (m : M), p • m = MvPolynomial.constantCoeff p • m := by
    intro p m
    -- The ideal generated by the variables annihilates `M`.
    have hkill : ∀ q ∈ MvPolynomial.idealOfVars (Fin (N + 1) × Fin 2) ℂ, q • m = 0 := by
      intro q hq
      let f : MR N →ₗ[MR N] M :=
        { toFun := fun q => q • m
          map_add' := fun a b => add_smul a b m
          map_smul' := fun r a => mul_smul r a m }
      have : q ∈ LinearMap.ker f := by
        rw [MvPolynomial.idealOfVars] at hq
        refine Submodule.mem_span.mp hq (LinearMap.ker f) ?_
        rintro x ⟨v, rfl⟩
        exact LinearMap.mem_ker.mpr (h v m)
      exact LinearMap.mem_ker.mp this
    have hz : (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) • m = 0 :=
      hkill _ (sub_C_constantCoeff_mem_idealOfVars p)
    rw [sub_smul] at hz
    have hpm : p • m = MvPolynomial.C (MvPolynomial.constantCoeff p) • m := sub_eq_zero.mp hz
    rw [hpm]
    have : (MvPolynomial.C (MvPolynomial.constantCoeff p) : MR N) • m
        = MvPolynomial.constantCoeff p • m := by
      rw [← MvPolynomial.algebraMap_eq]
      exact IsScalarTower.algebraMap_smul (MR N) (MvPolynomial.constantCoeff p) m
    rw [this]
  -- Step 2: the `MR N`-module structure coincides with the `ℂ`-module structure, so a finite
  -- `MR N`-spanning set is in fact a finite `ℂ`-spanning set.
  obtain ⟨S, hSfin, hSspan⟩ := Submodule.fg_def.mp (Module.Finite.fg_top (R := MR N) (M := M))
  let T : Submodule (MR N) M :=
    { carrier := (Submodule.span ℂ S : Set M)
      zero_mem' := Submodule.zero_mem _
      add_mem' := fun hx hy => Submodule.add_mem _ hx hy
      smul_mem' := fun a x hx => by
        rw [key a x]
        exact Submodule.smul_mem _ _ hx }
  have hTle : Submodule.span (MR N) S ≤ T :=
    Submodule.span_le.mpr (fun x hx => Submodule.subset_span hx)
  have htop : (⊤ : Submodule ℂ M) ≤ Submodule.span ℂ S := by
    intro m _
    have : m ∈ (⊤ : Submodule (MR N) M) := trivial
    rw [← hSspan] at this
    exact hTle this
  exact Module.finite_def.mpr (Submodule.fg_def.mpr ⟨S, hSfin, le_antisymm le_top htop⟩)

end Work.BW
