import Mathlib
import Submission.Work.BW.DefsMult

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Block A5c: a full-length regular sequence in `ℂ[σ]_𝔪`

For a maximal ideal `𝔪` of `ℂ[σ]`, the local ring `ℂ[σ]_𝔪` is a regular local ring of
dimension `|σ|`: the residue class field is `ℂ`, the maximal ideal is generated by the
`|σ|` elements `X_v - x_v` (where `x : σ → ℂ` is the point cut out by `𝔪`, so that
`𝔪 = MvPolynomial.vanishingIdeal ℂ {x}`), and these form a regular sequence.

The proof is elementary and avoids any structural theory of the quotient ring:

* `X_n - C r` is a nonzerodivisor of `MvPolynomial σ R` for any commutative ring `R`
  (monic in `X_n`, proved here directly through coefficients).
* Let `subst_A` be the `ℂ`-algebra endomorphism substituting `X_v ↦ a v` for `v ∈ A` and
  fixing the other variables.  Then `I_A := span (X_v - C (a v) : v ∈ A)` is exactly the
  kernel of `subst_A`: one inclusion is clear, and `q - subst_A q ∈ I_A` for all `q`
  (check by induction on `q`), so `subst_A q = 0 ⟹ q ∈ I_A`.
* Hence for `u ∉ A` the element `X_u - C (a u)` is a nonzerodivisor modulo `I_A`: from
  `q * (X_u - C (a u)) ∈ I_A` and `subst_A (X_u - C (a u)) = X_u - C (a u)` we get
  `subst_A q = 0`, i.e. `q ∈ I_A`.

This gives weak regularity of the translated variables in any order (for a `Nodup` list),
which localizes to a regular sequence in `ℂ[σ]_𝔪` by
`RingTheory.Sequence.IsWeaklyRegular.isRegular_of_isLocalization_of_mem`.

The Krull dimension bound is Krull's height theorem plus `ringKrullDim` of a polynomial ring.
-/

namespace Work.BW

open MvPolynomial

/-- The linear polynomial `X v - C (a v)`. -/
noncomputable def XsubC {σ : Type*} (a : σ → ℂ) (v : σ) : MvPolynomial σ ℂ :=
  MvPolynomial.X v - MvPolynomial.C (a v)

@[simp] lemma XsubC_apply {σ : Type*} (a : σ → ℂ) (v : σ) :
    XsubC a v = MvPolynomial.X v - MvPolynomial.C (a v) := rfl

variable {σ : Type*}

/-- `X n - C r` is a nonzerodivisor of `MvPolynomial σ R`. -/
lemma isSMulRegular_X_sub_C {R : Type*} [CommRing R] (n : σ) (r : R) :
    IsSMulRegular (MvPolynomial σ R) (MvPolynomial.X n - MvPolynomial.C r) := by
  rw [isSMulRegular_iff_right_eq_zero_of_smul]
  intro P hP
  have hP' : (MvPolynomial.X n - MvPolynomial.C r) * P = 0 := by
    simpa [smul_eq_mul] using hP
  by_contra hP0
  have hne : P.support.Nonempty := Finset.nonempty_iff_ne_empty.mpr
    (fun h => hP0 (MvPolynomial.support_eq_empty.mp h))
  obtain ⟨m, hm, hmsup⟩ := Finset.exists_mem_eq_sup P.support hne (fun k => k n)
  have hcoeff : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
  have hnotmem : (Finsupp.single n 1 + m) ∉ P.support := by
    intro hmem
    have hle := Finset.le_sup (f := fun k : σ →₀ ℕ => k n) hmem
    rw [hmsup] at hle
    simp only [Finsupp.add_apply, Finsupp.single_eq_same] at hle
    omega
  have hzero : P.coeff (Finsupp.single n 1 + m) = 0 := by
    rwa [MvPolynomial.notMem_support_iff] at hnotmem
  have hkey : ((MvPolynomial.X n - MvPolynomial.C r) * P).coeff (Finsupp.single n 1 + m)
      = P.coeff m := by
    rw [sub_mul, MvPolynomial.coeff_sub, MvPolynomial.coeff_X_mul, MvPolynomial.coeff_C_mul,
      hzero, mul_zero, sub_zero]
  rw [hP'] at hkey
  simp only [AddMonoidAlgebra.coeff_zero] at hkey
  exact hcoeff hkey.symm

/-- The `ℂ`-algebra endomorphism substituting `X_v ↦ C (a v)` for `v ∈ A` and fixing all
other variables. -/
noncomputable def substSet {σ : Type*} (A : Set σ) (a : σ → ℂ) :
    MvPolynomial σ ℂ →ₐ[ℂ] MvPolynomial σ ℂ := by
  classical
  exact MvPolynomial.aeval fun v => if v ∈ A then MvPolynomial.C (a v) else MvPolynomial.X v

lemma substSet_X_of_mem (A : Set σ) (a : σ → ℂ) {v : σ} (hv : v ∈ A) :
    substSet A a (MvPolynomial.X v) = MvPolynomial.C (a v) := by
  classical
  simp [substSet, hv]

lemma substSet_X_of_notMem (A : Set σ) (a : σ → ℂ) {v : σ} (hv : v ∉ A) :
    substSet A a (MvPolynomial.X v) = MvPolynomial.X v := by
  classical
  simp [substSet, hv]

lemma substSet_C (A : Set σ) (a : σ → ℂ) (r : ℂ) :
    substSet A a (MvPolynomial.C r) = MvPolynomial.C r := by
  classical
  simp [substSet]

/-- `X u - C (a u)` is fixed by `subst_A` when `u ∉ A`. -/
lemma substSet_XsubC_of_notMem (A : Set σ) (a : σ → ℂ) {u : σ} (hu : u ∉ A) :
    substSet A a (XsubC a u) = XsubC a u := by
  rw [XsubC_apply, map_sub, substSet_X_of_notMem A a hu, substSet_C, ← XsubC_apply]

/-- `X u - C (a u)` is killed by `subst_A` when `u ∈ A`. -/
lemma substSet_XsubC_of_mem (A : Set σ) (a : σ → ℂ) {u : σ} (hu : u ∈ A) :
    substSet A a (XsubC a u) = 0 := by
  rw [XsubC_apply, map_sub, substSet_X_of_mem A a hu, substSet_C, sub_self]

/-- The ideal spanned by the translated variables over `A`. -/
noncomputable def transIdeal (A : Set σ) (a : σ → ℂ) : Ideal (MvPolynomial σ ℂ) :=
  Ideal.span (XsubC a '' A)

lemma XsubC_mem_transIdeal (A : Set σ) (a : σ → ℂ) {v : σ} (hv : v ∈ A) :
    XsubC a v ∈ transIdeal A a :=
  Ideal.subset_span ⟨v, hv, rfl⟩

/-- `q` and `subst_A q` differ by an element of the ideal `(X_v - C (a v) : v ∈ A)`. -/
lemma self_sub_substSet_mem (A : Set σ) (a : σ → ℂ) (q : MvPolynomial σ ℂ) :
    q - substSet A a q ∈ transIdeal A a := by
  classical
  refine MvPolynomial.induction_on
    (motive := fun q => q - substSet A a q ∈ transIdeal A a) q ?_ ?_ ?_
  · intro r
    rw [substSet_C, sub_self]
    exact Ideal.zero_mem _
  · intro p q hp hq
    have hsplit : p + q - substSet A a (p + q) =
        (p - substSet A a p) + (q - substSet A a q) := by
      rw [map_add]; abel
    rw [hsplit]
    exact Ideal.add_mem _ hp hq
  · intro p n hp
    have hsplit : p * MvPolynomial.X n - substSet A a (p * MvPolynomial.X n) =
        (p - substSet A a p) * MvPolynomial.X n +
          substSet A a p * (MvPolynomial.X n - substSet A a (MvPolynomial.X n)) := by
      rw [map_mul]; ring
    rw [hsplit]
    refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
    by_cases hn : n ∈ A
    · rw [substSet_X_of_mem A a hn]
      simpa [XsubC] using XsubC_mem_transIdeal A a hn
    · rw [substSet_X_of_notMem A a hn, sub_self]
      exact Ideal.zero_mem _

/-- The ideal `(X_v - C (a v) : v ∈ A)` is contained in the kernel of `subst_A`. -/
lemma transIdeal_le_ker_substSet (A : Set σ) (a : σ → ℂ) :
    transIdeal A a ≤ RingHom.ker (substSet A a).toRingHom := by
  rw [transIdeal, Ideal.span_le]
  rintro _ ⟨v, hv, rfl⟩
  simpa [RingHom.mem_ker] using substSet_XsubC_of_mem A a hv

lemma substSet_eq_zero_iff_mem (A : Set σ) (a : σ → ℂ) (q : MvPolynomial σ ℂ) :
    substSet A a q = 0 ↔ q ∈ transIdeal A a := by
  constructor
  · intro h
    have := self_sub_substSet_mem A a q
    rwa [h, sub_zero] at this
  · intro hq
    have := transIdeal_le_ker_substSet A a hq
    simpa [RingHom.mem_ker] using this

/-- **Key step.** For `u ∉ A`, the element `X_u - C (a u)` is a nonzerodivisor modulo
`(X_v - C (a v) : v ∈ A)`. -/
lemma isSMulRegular_quot_transIdeal (A : Set σ) (a : σ → ℂ) {u : σ} (hu : u ∉ A) :
    IsSMulRegular (MvPolynomial σ ℂ ⧸ transIdeal A a) (XsubC a u) := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro q hq
  have hq' : XsubC a u * q ∈ transIdeal A a := by
    simpa [smul_eq_mul] using hq
  have h0 : substSet A a (XsubC a u * q) = 0 := (substSet_eq_zero_iff_mem A a _).mpr hq'
  rw [map_mul, substSet_XsubC_of_notMem A a hu] at h0
  have hq0 : substSet A a q = 0 :=
    IsSMulRegular.right_eq_zero_of_smul
      (isSMulRegular_X_sub_C (R := ℂ) u (a u)) (by simpa [XsubC, smul_eq_mul] using h0)
  exact (substSet_eq_zero_iff_mem A a q).mp hq0

/-- **Weak regularity.** For a `Nodup` list `l`, the translated variables `X_v - C (a v)`
form a weakly regular sequence in `ℂ[σ]`, in the order of `l`. -/
lemma isWeaklyRegular_list (a : σ → ℂ) (l : List σ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial σ ℂ) (l.map (XsubC a)) := by
  classical
  rw [RingTheory.Sequence.isWeaklyRegular_iff_Fin]
  intro i
  have hi' : (i : ℕ) < l.length := by simpa using i.isLt
  set A : Set σ := {v | v ∈ l.take (i : ℕ)} with hA
  have hmem : l[i] ∉ A := by
    rw [hA]
    intro hmem
    obtain ⟨j, hj, hji⟩ := List.mem_iff_getElem.mp hmem
    have hjlt : j < i := by
      have h1 : j < (l.take (i : ℕ)).length := hj
      rw [List.length_take] at h1
      omega
    have hjlen : j < l.length := lt_of_lt_of_le hjlt (le_of_lt hi')
    have hji' : l[j] = l[i] := by
      rw [← List.getElem_take (xs := l) (j := (i : ℕ)) (i := j) (h := hj)]
      exact hji
    have hji'' : j = i :=
      (List.Nodup.getElem_inj (i := j) (j := i) hl (hi := hjlen) (hj := hi')).mp hji'
    omega
  have htake : List.take (i : ℕ) (l.map (XsubC a)) = (l.take (i : ℕ)).map (XsubC a) :=
    (List.map_take).symm
  have hofList : Ideal.ofList (List.take (i : ℕ) (l.map (XsubC a))) = transIdeal A a := by
    show Ideal.span {r | r ∈ List.take (i : ℕ) (l.map (XsubC a))} = transIdeal A a
    rw [htake, transIdeal, hA]
    congr 1
    ext r
    simp only [Set.mem_ofPred_eq, List.mem_map, Set.mem_image]
  have hquot : Ideal.ofList (List.take (i : ℕ) (l.map (XsubC a))) •
      (⊤ : Submodule (MvPolynomial σ ℂ) (MvPolynomial σ ℂ)) = transIdeal A a := by
    rw [hofList, transIdeal, Ideal.smul_eq_mul, Ideal.mul_top]
  have hget : (l.map (XsubC a))[i] = XsubC a l[i] := List.getElem_map ..
  rw [hquot, hget]
  exact isSMulRegular_quot_transIdeal A a hmem

/-- Block A5c. At a maximal ideal `𝔪` of `ℂ[σ]`, the local ring has a regular sequence of
length `|σ|` (the `X_v − x_v`, after a translation) and Krull dimension `≤ |σ|` (Krull's height
bound, `Ideal.height_le_spanRank_toENat`). -/
theorem mvpoly_local_regSeq {σ : Type*} [Fintype σ] (𝔪 : Ideal (MvPolynomial σ ℂ))
    [𝔪.IsMaximal] :
    (∃ rs : List (Localization.AtPrime 𝔪), rs.length = Fintype.card σ ∧
      (∀ x ∈ rs, x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) ∧
      RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) rs) ∧
    ringKrullDim (Localization.AtPrime 𝔪) ≤ Fintype.card σ := by
  classical
  obtain ⟨x, hx⟩ :=
    MvPolynomial.eq_vanishingIdeal_singleton_of_isMaximal (K := ℂ) (I := 𝔪) ‹𝔪.IsMaximal›
  have hreg : RingTheory.Sequence.IsWeaklyRegular (MvPolynomial σ ℂ)
      ((Finset.univ.toList : List σ).map (XsubC x)) :=
    isWeaklyRegular_list x Finset.univ.toList (Finset.nodup_toList _)
  have hmem : ∀ r ∈ (Finset.univ.toList : List σ).map (XsubC x), r ∈ 𝔪 := by
    intro r hr
    obtain ⟨v, -, rfl⟩ := List.mem_map.mp hr
    rw [hx, MvPolynomial.mem_vanishingIdeal_singleton_iff]
    simp [XsubC]
  refine ⟨⟨List.map (algebraMap (MvPolynomial σ ℂ) (Localization.AtPrime 𝔪))
      ((Finset.univ.toList : List σ).map (XsubC x)), ?_, ?_, ?_⟩, ?_⟩
  · simp [List.length_map, Finset.length_toList, Finset.card_univ]
  · intro y hy
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hy
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔪) 𝔪 r).mpr
      (hmem r hr)
  · exact RingTheory.Sequence.IsWeaklyRegular.isRegular_of_isLocalization_of_mem
      (Localization.AtPrime 𝔪) 𝔪 hreg hmem
  · have h1 : ringKrullDim (Localization.AtPrime 𝔪) = ((𝔪.height : ℕ∞) : WithBot ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height 𝔪 (Localization.AtPrime 𝔪)
    have h2 : ((𝔪.height : ℕ∞) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial σ ℂ) :=
      𝔪.height_le_ringKrullDim_of_isPrime
    have h3 : ringKrullDim (MvPolynomial σ ℂ) = ((Fintype.card σ : ℕ) : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field]
      simp [Nat.card_eq_fintype_card]
    calc ringKrullDim (Localization.AtPrime 𝔪) = ((𝔪.height : ℕ∞) : WithBot ℕ∞) := h1
      _ ≤ ringKrullDim (MvPolynomial σ ℂ) := h2
      _ = ((Fintype.card σ : ℕ) : WithBot ℕ∞) := h3

end Work.BW
