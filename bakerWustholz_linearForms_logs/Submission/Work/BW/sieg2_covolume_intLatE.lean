import Mathlib
import Submission.Work.BW.sieg2KernelDefs
import Submission.Work.BW.sieg2_intLatE_basis
import Submission.Work.BW.covolume_sqrt_gram_det_arb
import Submission.Work.BW.sieg2_gram_det_intLatEBasis
import Submission.Work.BW.covolume_span_eq_sqrt_gram_det
import Submission.Work.BW.covolume_isometry_map_volume

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Covolume of the integral lattice `(𝓞 F)^N` in the Euclidean coordinate model

`Work.BW.intLatE F N` is the lattice `(𝓞 F)^N` inside the Euclidean coordinate model
`EuclideanSpace ℝ (Fin N × index F)` of `(KE F)^N` (see `Submission.Work.BW.sieg2KernelDefs`).
The main result of this file,

`Work.BW.sieg2_covolume_intLatE`,

computes its covolume:

  `covolume (intLatE F N) = ((1/2)^{r₂} · √|disc F|)^N`,

where `r₂` is the number of complex places of `F`.  Equivalently, the covolume of `(𝓞 F)^N` is
the `N`-th power of the covolume `(1/2)^{r₂} √|disc F|` of the lattice `𝓞 F` itself, computed by
Minkowski's theorem.

The proof goes through Gram determinants, so that the product structure of the lattice is visible
as the *block-diagonal* structure of the Gram matrix:

* `intLatE F N` is the `ℤ`-span of the `ℝ`-basis `intLatEBasis F N` (proved in
  `Submission.Work.BW.sieg2_intLatE_basis`), so its covolume is `√|det (gram (intLatEBasis F N))|`
  — this is `Work.BW.covolume_sqrt_gram_det_arb`.
* `det (gram (intLatEBasis F N)) = (det (gram (intLatBasis F))) ^ N`: the Gram matrix of the
  product basis is block diagonal with `N` identical blocks, the Gram matrix of the one-factor
  basis — `Work.BW.sieg2_gram_det_intLatEBasis`.
* `√|det (gram (intLatBasis F))|` is the covolume of the Euclidean integer lattice of `F`: the
  vectors of `intLatBasis F` are the orthonormal coordinates of the images of the integral basis
  (`Work.BW.sieg2_repr_meK_intLatBasis`), so their `ℤ`-span is the image of the Euclidean integer
  lattice under an isometry, and covolumes are preserved by isometries
  (`Work.BW.comap_coordEquiv_integerLattice`).  Mathlib's `covolume_integerLattice` then gives
  the value `(1/2)^{r₂} √|disc F|`.
* Finally `√|det (gram (intLatEBasis F N))| = (√|det (gram (intLatBasis F))|)^N`
  (`Work.BW.sqrt_abs_pow`), which raises the answer to the `N`-th power.
-/

open NumberField MeasureTheory
open scoped Classical

namespace Work.BW

/-- The orthonormal coordinates of `meK` of the integral basis are the vectors `intLatBasis`. -/
theorem sieg2_repr_meK_intLatBasis {F : Type*} [Field F] [NumberField F]
    (i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers F)) :
    (NumberField.mixedEmbedding.euclidean.stdOrthonormalBasis F).repr
        (meK ((NumberField.integralBasis F) i)) = intLatBasis F i := by
  rw [intLatBasis_apply, WithLp.ext_iff]
  funext p
  rw [← OrthonormalBasis.coe_toBasis_repr_apply,
    ← NumberField.mixedEmbedding.euclidean.stdOrthonormalBasis_map_eq F]
  simp [meK, Module.Basis.map]

/-- The orthonormal-coordinate model of the Euclidean mixed space. -/
noncomputable def coordEquiv (F : Type*) [Field F] [NumberField F] :
    EuclideanSpace ℝ (NumberField.mixedEmbedding.index F) ≃L[ℝ]
      NumberField.mixedEmbedding.euclidean.mixedSpace F :=
  ((NumberField.mixedEmbedding.euclidean.stdOrthonormalBasis F).repr.symm).toContinuousLinearEquiv

/-- The Euclidean integer lattice is the image of the lattice generated by `mixedEmbedding` of the
integral basis under the wrapping map `toMixed.symm`. -/
theorem euclidean_integerLattice_eq_map (F : Type*) [Field F] [NumberField F] :
    NumberField.mixedEmbedding.euclidean.integerLattice F
      = Submodule.map
          (((NumberField.mixedEmbedding.euclidean.toMixed F).symm.toLinearMap).restrictScalars ℤ)
          (Submodule.span ℤ (Set.range (⇑(NumberField.mixedEmbedding.latticeBasis F)))) := by
  rw [NumberField.mixedEmbedding.euclidean.integerLattice]
  change (NumberField.mixedEmbedding.integerLattice F).comap
      (((NumberField.mixedEmbedding.euclidean.toMixed F).toLinearMap).restrictScalars ℤ)
    = Submodule.map
        (((NumberField.mixedEmbedding.euclidean.toMixed F).symm.toLinearMap).restrictScalars ℤ)
        (Submodule.span ℤ (Set.range (⇑(NumberField.mixedEmbedding.latticeBasis F))))
  rw [← NumberField.mixedEmbedding.span_latticeBasis]
  ext x
  rw [Submodule.mem_comap, Submodule.mem_map]
  constructor
  · intro hx
    exact ⟨(NumberField.mixedEmbedding.euclidean.toMixed F) x, hx, by simp⟩
  · rintro ⟨y, hy, hyx⟩
    rw [← hyx]
    simpa using hy

/-- The `ℤ`-span of the vectors `intLatBasis` is the image of the Euclidean integer lattice under
the orthonormal-coordinate map. -/
theorem span_intLatBasis_eq_map_coordEquiv_symm (F : Type*) [Field F] [NumberField F] :
    Submodule.map (((coordEquiv F).symm.toLinearMap).restrictScalars ℤ)
        (NumberField.mixedEmbedding.euclidean.integerLattice F)
      = Submodule.span ℤ (Set.range (⇑(intLatBasis F))) := by
  have hleft : Submodule.span ℤ (Set.range (⇑(intLatBasis F)))
      = Submodule.span ℤ (Set.range (fun i : Module.Free.ChooseBasisIndex ℤ (𝓞 F) =>
          (coordEquiv F).symm ((NumberField.mixedEmbedding.euclidean.toMixed F).symm
            ((NumberField.mixedEmbedding.latticeBasis F) i)))) := by
    refine congrArg (Submodule.span ℤ) (congrArg Set.range (funext fun i => ?_))
    rw [← sieg2_repr_meK_intLatBasis (F := F) i, meK,
      NumberField.mixedEmbedding.latticeBasis_apply]
    rfl
  have hR : Submodule.map (((coordEquiv F).symm.toLinearMap).restrictScalars ℤ)
        (NumberField.mixedEmbedding.euclidean.integerLattice F)
      = Submodule.span ℤ (Set.range (fun i : Module.Free.ChooseBasisIndex ℤ (𝓞 F) =>
          (coordEquiv F).symm ((NumberField.mixedEmbedding.euclidean.toMixed F).symm
            ((NumberField.mixedEmbedding.latticeBasis F) i)))) := by
    rw [euclidean_integerLattice_eq_map, ← Submodule.map_comp, Submodule.map_span,
      ← Set.range_comp]
    rfl
  exact hR.trans hleft.symm

/-- The lattice `intLatBasis`-span pulled back along the coordinate equivalence. -/
theorem comap_coordEquiv_integerLattice (F : Type*) [Field F] [NumberField F] :
    ZLattice.comap ℝ (NumberField.mixedEmbedding.euclidean.integerLattice F)
        (coordEquiv F).toLinearMap
      = Submodule.span ℤ (Set.range (⇑(intLatBasis F))) := by
  rw [← span_intLatBasis_eq_map_coordEquiv_symm F]
  change (NumberField.mixedEmbedding.euclidean.integerLattice F).comap
      (((coordEquiv F).toLinearMap).restrictScalars ℤ)
    = Submodule.map (((coordEquiv F).symm.toLinearMap).restrictScalars ℤ)
        (NumberField.mixedEmbedding.euclidean.integerLattice F)
  ext x
  rw [Submodule.mem_comap, Submodule.mem_map]
  constructor
  · intro hx
    exact ⟨(coordEquiv F) x, hx, by simp⟩
  · rintro ⟨y, hy, hyx⟩
    rw [← hyx]
    simpa using hy

/-- `√|x ^ n| = (√|x|) ^ n`. -/
theorem sqrt_abs_pow (x : ℝ) (n : ℕ) :
    Real.sqrt |x ^ n| = (Real.sqrt |x|) ^ n := by
  have hx : 0 ≤ |x| := abs_nonneg x
  rw [abs_pow]
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, Real.sqrt_mul (pow_nonneg hx n) |x|, ih, pow_succ]

/-- **Covolume of the integral lattice `(𝓞 F)^N` in the Euclidean coordinate model.** -/
theorem sieg2_covolume_intLatE {F : Type*} [Field F] [NumberField F] (N : ℕ)
    [DiscreteTopology ↥(intLatE F N)] :
    ZLattice.covolume (intLatE F N) (MeasureTheory.volume) =
      ((1 / 2 : ℝ) ^ (NumberField.InfinitePlace.nrComplexPlaces F) *
        Real.sqrt |((NumberField.discr F : ℤ) : ℝ)|) ^ N := by
  classical
  -- `intLatE F N` is the `ℤ`-span of the basis `intLatEBasis F N`
  have hspanE : Submodule.span ℤ (Set.range (⇑(intLatEBasis F N))) = intLatE F N := by
    have hb : ⇑(intLatEBasis F N) = (fun q : Fin N × Module.Free.ChooseBasisIndex ℤ (𝓞 F) =>
        WithLp.toLp 2 (fun p : Fin N × NumberField.mixedEmbedding.index F =>
          if p.1 = q.1 then ((NumberField.mixedEmbedding.stdBasis F).repr
            (NumberField.mixedEmbedding F ((NumberField.integralBasis F) q.2))) p.2 else 0)) :=
      funext (intLatEBasis_apply F N)
    rw [hb]
    rfl
  -- covolume = `√|det Gram|`
  have h1 : ZLattice.covolume (intLatE F N) MeasureTheory.volume
      = Real.sqrt |(Matrix.gram ℝ (⇑(intLatEBasis F N))).det| := by
    rw [← hspanE]
    exact covolume_sqrt_gram_det_arb (intLatEBasis F N)
  -- the Gram matrix is block diagonal, with `N` blocks `gram (intLatBasis F)`
  have h2 : Real.sqrt |(Matrix.gram ℝ (⇑(intLatEBasis F N))).det|
      = (Real.sqrt |(Matrix.gram ℝ (⇑(intLatBasis F))).det|) ^ N := by
    rw [sieg2_gram_det_intLatEBasis, sqrt_abs_pow]
  -- the one-factor Gram determinant is the covolume of `𝓞 F`
  have h3 : Real.sqrt |(Matrix.gram ℝ (⇑(intLatBasis F))).det|
      = ZLattice.covolume (NumberField.mixedEmbedding.euclidean.integerLattice F)
          MeasureTheory.volume := by
    rw [← covolume_sqrt_gram_det_arb (intLatBasis F)]
    rw [← comap_coordEquiv_integerLattice F]
    exact ZLattice.covolume_comap
      (L := NumberField.mixedEmbedding.euclidean.integerLattice F)
      (μ := MeasureTheory.volume) (ν := MeasureTheory.volume) (e := coordEquiv F)
      (OrthonormalBasis.measurePreserving_repr_symm _)
  rw [h1, h2, h3, covolume_integerLattice]

end Work.BW
