import Mathlib
import Submission.Work.BW.absNorm_map_ringEquiv
import Submission.Work.BW.prod_infinitePlace_algEquiv
import Submission.Work.BW.finprod_finitePlace_ringEquiv

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Invariance of the place-weighted logarithmic height under `ℚ`-algebra isomorphisms

The (unnormalized, place-weighted) height of a tuple over a number field factors, by
`NumberField.mulHeight_eq`, into an archimedean part

  `∏_{v : InfinitePlace K} (supᵢ v (xᵢ)) ^ (v.mult)`

and a non-archimedean part

  `∏ᶠ_{v : FinitePlace K} supᵢ v (xᵢ)`.

Both factors are invariant under a `ℚ`-algebra isomorphism `e : K ≃ₐ[ℚ] K'`:

* for the archimedean part, `v ↦ v.comap e` is a multiplicity preserving bijection of the infinite
  places (`Work.BW.prod_infinitePlace_algEquiv`);
* for the non-archimedean part, one first scales the tuple so that its entries are algebraic
  integers and then uses that the finite part equals the inverse of the absolute norm of the ideal
  generated by the entries, together with the invariance of `Ideal.absNorm` under a ring
  isomorphism of the rings of integers (`Work.BW.finprod_finitePlace_ringEquiv`).

The main theorem `Work.BW.logHeight_algEquiv` combines these two statements.
-/

open NumberField

namespace Work.BW

/-- The ring isomorphism `𝓞 K ≃+* 𝓞 K'` of rings of integers induced by a `ℚ`-algebra
isomorphism `e : K ≃ₐ[ℚ] K'`. -/
noncomputable def ringOfIntegersEquiv {K K' : Type*} [Field K] [NumberField K] [Field K']
    [NumberField K'] (e : K ≃ₐ[ℚ] K') : 𝓞 K ≃+* 𝓞 K' where
  toFun x := ⟨e (x : K), IsIntegral.map e (RingOfIntegers.isIntegral_coe x)⟩
  invFun y := ⟨e.symm (y : K'), IsIntegral.map e.symm (RingOfIntegers.isIntegral_coe y)⟩
  left_inv x := Subtype.ext (by show e.symm (e (x : K)) = (x : K); simp)
  right_inv y := Subtype.ext (by show e (e.symm (y : K')) = (y : K'); simp)
  map_mul' x y := Subtype.ext (by
    show e ((x : K) * (y : K)) = e (x : K) * e (y : K)
    rw [map_mul])
  map_add' x y := Subtype.ext (by
    show e ((x : K) + (y : K)) = e (x : K) + e (y : K)
    rw [map_add])

@[simp] lemma ringOfIntegersEquiv_coe {K K' : Type*} [Field K] [NumberField K] [Field K']
    [NumberField K'] (e : K ≃ₐ[ℚ] K') (x : 𝓞 K) :
    (ringOfIntegersEquiv e x : K') = e (x : K) := rfl

/-- Any tuple over a number field can be scaled by a positive rational integer so that all its
entries become algebraic integers. -/
lemma exists_nat_mul_isIntegral {K : Type*} [Field K] [NumberField K] {ι : Type*} [Fintype ι]
    (p : ι → K) : ∃ n : ℕ, n ≠ 0 ∧ ∀ i, IsIntegral ℤ ((n : K) * p i) := by
  classical
  have hpos : ∀ i, Algebra.natDenominator (p i) ≠ 0 := by
    intro i
    obtain ⟨n, hn, -, hni⟩ := NumberField.exists_nat_le_mulHeight₁ (p i)
    have hni' : IsIntegral ℤ (n • p i) := by simpa only [nsmul_eq_mul] using hni
    have hdvd : Algebra.natDenominator (p i) ∣ n := Algebra.natDenominator_dvd_iff.mpr hni'
    intro h
    exact hn (Nat.eq_zero_of_zero_dvd (h ▸ hdvd))
  refine ⟨∏ i, Algebra.natDenominator (p i), ?_, fun i => ?_⟩
  · exact Finset.prod_ne_zero_iff.mpr fun i _ => hpos i
  · have h : IsIntegral ℤ ((∏ i, Algebra.natDenominator (p i)) • p i) :=
      Algebra.natDenominator_dvd_iff.mp (Finset.dvd_prod_of_mem _ (Finset.mem_univ i))
    simpa only [nsmul_eq_mul] using h

/-- Projective (unnormalized, place-weighted) logarithmic heights of tuples over number fields
are invariant under `ℚ`-algebra isomorphisms of number fields. -/
theorem logHeight_algEquiv {K K' : Type*} [Field K] [NumberField K] [Field K'] [NumberField K']
    (e : K ≃ₐ[ℚ] K') {ι : Type*} [Fintype ι] (p : ι → K) :
    Height.logHeight (fun i => e (p i)) = Height.logHeight p := by
  rw [Height.logHeight_eq_log_mulHeight, Height.logHeight_eq_log_mulHeight]
  congr 1
  by_cases hp : p = 0
  · subst hp
    simp
  · have hp' : (fun i => e (p i)) ≠ 0 := by
      intro h
      apply hp
      funext i
      have h1 : e (p i) = 0 := congrFun h i
      exact e.injective (h1.trans (map_zero e).symm)
    obtain ⟨n, hn, hni⟩ := exists_nat_mul_isIntegral p
    have hnK : (n : K) ≠ 0 := by exact_mod_cast hn
    have hnK' : (n : K') ≠ 0 := by exact_mod_cast hn
    let q : ι → 𝓞 K := fun i => ⟨(n : K) * p i, hni i⟩
    let q' : ι → 𝓞 K' := fun i => ringOfIntegersEquiv e (q i)
    have hq : q ≠ 0 := by
      intro h
      apply hp
      funext i
      have h1 : (q i : 𝓞 K) = 0 := congrFun h i
      have h2 : (n : K) * p i = 0 := congrArg (fun y : 𝓞 K => (y : K)) h1
      exact (mul_eq_zero.mp h2).resolve_left hnK
    have hq' : q' ≠ 0 := by
      intro h
      apply hq
      funext i
      have h1 : q' i = 0 := congrFun h i
      have h2 : e ((q i : K)) = 0 := congrArg (fun y : 𝓞 K' => (y : K')) h1
      exact Subtype.ext (e.injective (h2.trans (map_zero e).symm))
    have hqK_ne : (fun i => (q i : K)) ≠ 0 := by
      intro h
      apply hq
      funext i
      have h1 : (q i : K) = 0 := congrFun h i
      exact Subtype.ext h1
    have hq'K'_ne : (fun i => (q' i : K')) ≠ 0 := by
      intro h
      apply hq'
      funext i
      have h1 : (q' i : K') = 0 := congrFun h i
      exact Subtype.ext h1
    have harch : (∏ v : InfinitePlace K', (⨆ i, v ((q' i : K'))) ^ v.mult)
        = ∏ v : InfinitePlace K, (⨆ i, v ((q i : K))) ^ v.mult :=
      prod_infinitePlace_algEquiv e (fun i => (q i : K))
    have hfin : (∏ᶠ v : FinitePlace K', ⨆ i, v ((q' i : 𝓞 K') : K'))
        = ∏ᶠ v : FinitePlace K, ⨆ i, v ((q i : 𝓞 K) : K) :=
      finprod_finitePlace_ringEquiv (ringOfIntegersEquiv e) q hq
    have hmid : Height.mulHeight (fun i => (q i : K)) = Height.mulHeight (fun i => (q' i : K')) := by
      rw [NumberField.mulHeight_eq (x := fun i => (q i : K)) hqK_ne,
        NumberField.mulHeight_eq (x := fun i => (q' i : K')) hq'K'_ne]
      rw [harch, hfin]
    have hscale1 : (fun i => (q' i : K')) = (n : K') • (fun i => e (p i)) := by
      funext i
      show (ringOfIntegersEquiv e (q i) : K') = (n : K') * e (p i)
      rw [ringOfIntegersEquiv_coe]
      show e ((n : K) * p i) = (n : K') * e (p i)
      rw [map_mul, map_natCast]
    have hscale2 : (fun i => (q i : K)) = (n : K) • p := by
      funext i
      show ((q i : 𝓞 K) : K) = (n : K) * p i
      rfl
    calc Height.mulHeight (fun i => e (p i))
        = Height.mulHeight (fun i => (q' i : K')) := by
            rw [hscale1]
            exact (Height.mulHeight_smul_eq_mulHeight (fun i => e (p i)) hnK').symm
      _ = Height.mulHeight (fun i => (q i : K)) := hmid.symm
      _ = Height.mulHeight p := by
            rw [hscale2]
            exact Height.mulHeight_smul_eq_mulHeight p hnK

end Work.BW
