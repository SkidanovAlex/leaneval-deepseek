import Mathlib
import Submission.Work.BW.sieg2KernelDefs
import Submission.Work.BW.sieg2Defs
import Submission.Work.BW.siegel_defs
import Submission.Work.BW.kcb_defs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Vocabulary for the sharp Bombieri–Vaaler kernel-lattice bound

This file fixes the objects used by the proof of `Work.BW.kcb_kernel_family`.

We work in the *Euclidean coordinate model* `kcbE F N = EuclideanSpace ℝ (Fin N × index F)` of
`(KE F)^N`, where `KE F = NumberField.mixedEmbedding.euclidean.mixedSpace F` is the Euclidean mixed
space.  The existing definitions `Work.BW.intLatE F N` (the integral lattice `(𝓞 F)^N`),
`Work.BW.PhiE a` (the matrix of the linear map given by the rows `a i`, in the orthonormal basis)
and `Work.BW.PhiMat a` live in this model.

The objects introduced here:

* `kcbEquiv F N` : the `ℝ`-linear coordinate equivalence between `kcbE F N` and the product model
  `Fin N → KE F`.  All covolume computations for *product* lattices are done on the product model
  (where `Submodule.pi` and `Work.BW.sieg2_covolume_pi` apply) and transported back.
* `kcbIdealE I` : the image of a fractional ideal `I` of `𝓞 F` in the Euclidean mixed space `KE F`.
* `kcbIdealProd I` : the product of the images of a family `I : Fin M → (FractionalIdeal (𝓞 F)⁰ F)ˣ`
  in `Fin M → KE F`.
* `kcbIdealCoord I` : the same lattice transported to the coordinate model `kcbE F M`.
* `kcbRowIdeal a i` : the fractional ideal generated by the entries of the `i`-th row of `a`.
-/

set_option synthInstance.maxSize 1000

open NumberField MeasureTheory
open scoped Classical nonZeroDivisors

namespace Work.BW

noncomputable section

variable {F : Type*} [Field F] [NumberField F]

/-- The Euclidean coordinate model `ℝ^{[F:ℚ]·N}` of `(KE F)^N`. -/
abbrev kcbE (F : Type*) [Field F] [NumberField F] (N : ℕ) :=
  EuclideanSpace ℝ (Fin N × NumberField.mixedEmbedding.index F)

/-- The `ℝ`-linear coordinate equivalence between the Euclidean coordinate model `kcbE F N` and
the product model `Fin N → KE F`. -/
def kcbEquiv (F : Type*) [Field F] [NumberField F] (N : ℕ) :
    kcbE F N ≃ₗ[ℝ] (Fin N → KE F) :=
  ((WithLp.linearEquiv 2 ℝ (Fin N × NumberField.mixedEmbedding.index F → ℝ)).trans
      (LinearEquiv.curry ℝ ℝ (Fin N) (NumberField.mixedEmbedding.index F))).trans
    (LinearEquiv.piCongrRight fun _ : Fin N =>
      (WithLp.linearEquiv 2 ℝ (NumberField.mixedEmbedding.index F → ℝ)).symm.trans
        ((NumberField.mixedEmbedding.euclidean.stdOrthonormalBasis F).repr.symm.toLinearEquiv))


/-- The coordinate equivalence between the Euclidean model `kcbE F N` and the plain coordinate
space `CoordSpace F N = Fin N → (index F → ℝ)`. -/
def kcbIso (F : Type*) [Field F] [NumberField F] (N : ℕ) :
    kcbE F N ≃ₗ[ℝ] CoordSpace F N :=
  (WithLp.linearEquiv 2 ℝ (Fin N × NumberField.mixedEmbedding.index F → ℝ)).trans
    (LinearEquiv.curry ℝ ℝ (Fin N) (NumberField.mixedEmbedding.index F))

/-- The product measure instance for `Fin N → KE F`, made explicit so that the (expensive)
generic instance search is not triggered at every use site. -/
instance kcbMeasureSpacePi (F : Type*) [Field F] [NumberField F] (N : ℕ) :
    MeasureSpace (Fin N → KE F) :=
  MeasureTheory.MeasureSpace.pi

/-- The image of a fractional ideal of `𝓞 F` in the Euclidean mixed space. -/
def kcbIdealE (I : (FractionalIdeal (NumberField.RingOfIntegers F)⁰ F)ˣ) : Submodule ℤ (KE F) :=
  ZLattice.comap ℝ (NumberField.mixedEmbedding.idealLattice F I)
    (NumberField.mixedEmbedding.euclidean.toMixed F).toLinearMap

/-- The product of the images in `KE F` of a family of fractional ideals, as a submodule of
`Fin M → KE F`. -/
def kcbIdealProd {M : ℕ} (I : Fin M → (FractionalIdeal (NumberField.RingOfIntegers F)⁰ F)ˣ) :
    Submodule ℤ (Fin M → KE F) :=
  Submodule.pi Set.univ fun i => kcbIdealE (F := F) (I i)

/-- The product of the images of a family of fractional ideals, transported to the Euclidean
coordinate model. -/
def kcbIdealCoord {M : ℕ}
    (I : Fin M → (FractionalIdeal (NumberField.RingOfIntegers F)⁰ F)ˣ) :
    Submodule ℤ (kcbE F M) :=
  ZLattice.comap ℝ (kcbIdealProd (F := F) I) (kcbEquiv F M).toLinearMap

/-- The fractional ideal generated by the entries of the `i`-th row of `a`. -/
def kcbRowIdeal {M N : ℕ} (a : Fin M → Fin N → F) (hne : ∀ i, a i ≠ 0) (i : Fin M) :
    (FractionalIdeal (NumberField.RingOfIntegers F)⁰ F)ˣ :=
  Units.mk0 (FractionalIdeal.spanFinset (R₁ := NumberField.RingOfIntegers F) (K := F) Finset.univ (a i))
    (by
      rw [FractionalIdeal.spanFinset_ne_zero]
      obtain ⟨j, hj⟩ := Function.ne_iff.mp (hne i)
      exact ⟨j, Finset.mem_univ j, hj⟩)

@[simp]
theorem kcbRowIdeal_coe {M N : ℕ} (a : Fin M → Fin N → F) (hne : ∀ i, a i ≠ 0) (i : Fin M) :
    ((kcbRowIdeal a hne i : (FractionalIdeal (NumberField.RingOfIntegers F)⁰ F)ˣ) :
      FractionalIdeal (NumberField.RingOfIntegers F)⁰ F)
      = FractionalIdeal.spanFinset (R₁ := NumberField.RingOfIntegers F) (K := F) Finset.univ (a i) := rfl

end

end Work.BW
