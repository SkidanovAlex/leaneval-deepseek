import Mathlib
import Submission.Work.BW.DefsB
import Submission.Work.BW.eval_scale_homPiece

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The zero locus of a multihomogeneous ideal is invariant under rescaling in the `X_{i0}`

Let `𝔓 ⊆ MR N = ℂ[X_{i,0}, X_{i,1}]` be a *multihomogeneous* ideal and let `x` be a point of
the big torus chart `∏_i X_{i,0} ≠ 0`.  If every `p ∈ 𝔓` vanishes at `x`, then every `p ∈ 𝔓`
vanishes at the "normalised" (cone) point `X_{i,0} = 1`, `X_{i,1} = x_{i1}/x_{i0}`.

The point is that a multihomogeneous ideal is generated by its homogeneous elements: every
`p ∈ 𝔓` has multihomogeneous components `p_d ∈ 𝔓` (this is exactly `MultiHom N 𝔓`) with
`p = ∑ᶠ d, p_d`.  On a homogeneous `f` of multidegree `d` the rescaling `X_{i,j} ↦ λ_i X_{i,j}`
acts by `λ^{d}` (`eval_scale_homPiece`), so with `λ_i = x_{i0}^{-1}` we get
`eval (conePt y) f = (∏_i λ_i^{d_i}) * eval x f = 0`; summing over the (finitely many) components
gives the claim.
-/

namespace Work.BW

open MvPolynomial

theorem ptIdeal_conePt_of_mem_zeroLocus {N : ℕ} (𝔓 : Ideal (MR N)) (hH : MultiHom N 𝔓)
    (x : Fin (N + 1) × Fin 2 → ℂ) (hx0 : ∀ i : Fin (N + 1), x (i, 0) ≠ 0)
    (hx : ∀ p ∈ 𝔓, MvPolynomial.eval x p = 0) :
    𝔓 ≤ ptIdeal N (conePt N (fun i => x (i, 1) * (x (i, 0))⁻¹)) := by
  intro p hp
  rw [ptIdeal, RingHom.mem_ker]
  -- The cone point is the point `x` rescaled by `λ_i = x_{i0}^{-1}`.
  have hpt : conePt N (fun i => x (i, 1) * (x (i, 0))⁻¹)
      = fun v : Fin (N + 1) × Fin 2 => (x (v.1, 0))⁻¹ * x v := by
    funext v
    obtain ⟨i, j⟩ := v
    fin_cases j
    · simp [conePt, inv_mul_cancel₀ (hx0 i)]
    · simp [conePt, mul_comm]
  rw [hpt]
  -- Decompose `p` into multihomogeneous components, all of which lie in `𝔓`.
  have hfs : Function.HasFiniteSupport
      (fun d : Fin (N + 1) →₀ ℕ => weightedHomogeneousComponent (mdeg N) d p) :=
    weightedHomogeneousComponent_finsupp (w := mdeg N) p
  have hsum : (∑ᶠ d : Fin (N + 1) →₀ ℕ, weightedHomogeneousComponent (mdeg N) d p) = p :=
    sum_weightedHomogeneousComponent (mdeg N) p
  conv_lhs => rw [← hsum]
  rw [map_finsum (MvPolynomial.eval (fun v : Fin (N + 1) × Fin 2 => (x (v.1, 0))⁻¹ * x v)) hfs]
  refine finsum_eq_zero_of_forall_eq_zero fun d => ?_
  have hmem : weightedHomogeneousComponent (mdeg N) d p ∈ 𝔓 := hH p hp d
  have hhom : weightedHomogeneousComponent (mdeg N) d p ∈ homPiece N d :=
    weightedHomogeneousComponent_mem (mdeg N) p d
  rw [eval_scale_homPiece d _ hhom (fun i => (x (i, 0))⁻¹) x, hx _ hmem, mul_zero]

end Work.BW
