import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.BW

/-- Multiplying a principal fractional ideal `spanSingleton S x` by the fractional ideal
`spanFinset R s f` generated by the image of `f` gives the fractional ideal generated by
the image of `fun i => x * f i`. -/
theorem spanSingleton_mul_spanFinset {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    [IsFractionRing R K] {ι : Type*} (s : Finset ι) (f : ι → K) (x : K) :
    FractionalIdeal.spanSingleton (nonZeroDivisors R) x * FractionalIdeal.spanFinset R s f
      = FractionalIdeal.spanFinset R s (fun i => x * f i) := by
  rw [← FractionalIdeal.coeToSubmodule_inj, FractionalIdeal.coe_mul,
    FractionalIdeal.coe_spanSingleton, FractionalIdeal.spanFinset_coe,
    FractionalIdeal.spanFinset_coe, Submodule.span_mul_span]
  congr 1
  rw [Set.singleton_mul, Set.image_image]

theorem sieg2_spanFinset_mul_spanSingleton {F : Type*} [Field F] [NumberField F] {n : ℕ}
    (a : Fin n → F) (b : Fin n → NumberField.RingOfIntegers F)
    (d : NumberField.RingOfIntegers F)
    (hb : ∀ j, ((b j : NumberField.RingOfIntegers F) : F) = (d : F) * a j) :
    FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ a *
        FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers F)) (d : F)
      = FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ
          (fun j => ((b j : NumberField.RingOfIntegers F) : F)) := by
  rw [mul_comm]
  rw [spanSingleton_mul_spanFinset]
  rw [show (fun i => (d : F) * a i) =
      (fun j => ((b j : NumberField.RingOfIntegers F) : F)) from
    funext (fun j => (hb j).symm)]

end Work.BW
