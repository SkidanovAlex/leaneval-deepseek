import Mathlib
import Submission.Work.BW.DefsMult
import Submission.Work.BW.RB.A4
import Submission.Work.BW.RB.exists_generic_chain
import Submission.Work.BW.RB.srel_le_of_generic_chain

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# `Work.BW.Srel_spanned_le`, the main estimate of block A4

Philippon 1986, Proposition 3.3, *second* inequality, with `I₀ = 0` and `𝒰` the cone points over
`G = G_a × G_m^N`: for an ideal `I` generated by polynomials of multidegree exactly `D`,

  `Srel N D I ≤ rayDeg N D ⊥`.

This module contains the assembly only: the definitions and the bookkeeping around `Srel` are in
`Submission.Work.BW.RB.A4`, and the geometric/algebraic content is in the generic-chain development
(`Submission.Work.BW.RB.exists_generic_chain`) and the five chain lemmas
(`RB.span_assPrime_le_mem_minimalPrimes`, `RB.primLen_sup_span_le_sum_loc`,
`RB.chain_height_of_avoid`, `RB.srel_chain_step`, `RB.srel_le_of_generic_chain`).

The route, with `W = span_ℂ s ≤ homPiece N D` and `I = Ideal.span s = Ideal.span ↑W`:

* if `I = ⊥`, `Srel_bot` gives `Srel N D ⊥ = rayDeg N D ⊥` exactly;
* otherwise `exists_generic_chain` produces `g 0, …, g (k-1)` in `W` with `k = finrank ℂ W`, which
  is generic (each `g j` avoids the minimal primes of `J_j = (g i : i < j)` that do not contain `I`)
  and spans `I`; `srel_le_of_generic_chain` then telescopes Philippon's chain and yields the bound.

The statement is deliberately kept in the form used by `Submission.Work.BW.refined_bezout`
(`Srel N D (Ideal.span s) ≤ rayDeg N D ⊥` for a set `s` of polynomials of multidegree exactly `D`).
-/

namespace Work.BW

open MvPolynomial

noncomputable section

variable {N : ℕ}

/-- The set underlying `(Finset.univ.filter (·.1 < j.1)).image g` is `g '' {i | i.1 < j.1}`.  This
is the bridge between the "prefix" ideals of the generic chain in
`Submission.Work.BW.RB.exists_generic_chain` (written with `Finset.image`) and the ones in
`Submission.Work.BW.RB.srel_le_of_generic_chain` (written with `Set.image`). -/
lemma coe_image_filter_lt {k : ℕ} (g : Fin k → MR N) (j : Fin k) :
    g '' {i : Fin k | i.1 < j.1}
      = (↑((Finset.univ.filter (fun i : Fin k => i.1 < j.1)).image g) : Set (MR N)) := by
  rw [Finset.coe_image, Finset.coe_filter]
  simp

/-- **Main estimate of block A4** (Philippon 1986, Proposition 3.3, second inequality, `I₀ = 0`).
For an ideal generated by polynomials of multidegree exactly `D`, the total `length × H(·; D)` of
the minimal primes meeting the cone over `G` is at most `H(0; D)`.

Proof: the generic chain `exists_generic_chain` plus the telescoping estimate
`srel_le_of_generic_chain`; the degenerate case `I = ⊥` is `Srel_bot`.  The two inputs are matched
by `coe_image_filter_lt`. -/
theorem Srel_spanned_le (D : Fin (N + 1) →₀ ℕ) (hD : ∀ i, 1 ≤ D i) (s : Set (MR N))
    (hs : ∀ P ∈ s, P ∈ homPiece N D) :
    Srel N D (Ideal.span s) ≤ rayDeg N D ⊥ := by
  classical
  by_cases hbot : Ideal.span s = ⊥
  · rw [hbot]
    exact (Srel_bot D).le
  · -- `W = span_ℂ s` is a subspace of the multihomogeneous piece `homPiece N D`, and it spans `s`
    set W : Submodule ℂ (MR N) := Submodule.span ℂ s with hWdef
    have hWle : W ≤ (homPiece N D : Submodule ℂ (MR N)) :=
      Submodule.span_le.2 (fun x hx => hs x hx)
    have hIspan : Ideal.span s = Ideal.span (↑W : Set (MR N)) := by
      refine le_antisymm ?_ ?_
      · rw [Ideal.span_le]
        intro P hP
        exact Ideal.subset_span (Submodule.subset_span hP)
      · rw [Ideal.span_le]
        intro P hP
        have hle : W ≤ (Ideal.span s).restrictScalars ℂ :=
          Submodule.span_le.2 (fun z hz => Ideal.subset_span hz)
        exact hle hP
    obtain ⟨g, hgW, hgav, hgspan⟩ := Work.BW.RB.exists_generic_chain D W hWle (Ideal.span s) hIspan
    refine Work.BW.RB.srel_le_of_generic_chain D hD (Ideal.span s) hbot g (fun j => hWle (hgW j)) hgspan ?_
    intro j p hp hnI
    rw [coe_image_filter_lt g j] at hp
    exact hgav j p hp hnI

end

end Work.BW
