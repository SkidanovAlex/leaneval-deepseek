import Mathlib
import Submission.Work.BW.DefsMult
import Submission.Work.BW.RB.Basic

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Generic chains of elements of a piece `W ≤ homPiece N D`

Given a `ℂ`-subspace `W` of the multihomogeneous piece `homPiece N D`, with `I = Ideal.span W`, we
produce a chain `g 0, …, g (d-1)` of elements of `W` (`d = finrank ℂ W`, so the chain is exactly as
long as a basis) which

* generates `I` as an ideal, and
* is *generic*: at every step `k`, `g k` lies in no minimal prime of the ideal generated by the
  predecessors `g 0, …, g (k-1)` unless that prime already contains `I`.

This is the "generic chain" used in Philippon's construction of the descending chain of ideals (see
`Submission/Work/BW/RB/A4.lean`): the elements of the chain are chosen successively, each avoiding
the (finitely many) primes not containing `I` and also avoiding the span of the previous ones, so
that the chain is a basis of `W` at the end.

## The construction

The avoidance step is a "prime avoidance" over the infinite field `ℂ`: `ℂ`-subspace of `R` is never
the union of finitely many proper subspaces, so if `x` has to avoid a finite set of primes not
containing `I` (each of which cannot contain all of `W`, since otherwise `I = span W` would be
contained in it) and also the span of the previously chosen elements, such an `x` exists.  Adding
`x` to the chain preserves linear independence (`LinearIndependent.finSnoc`), so after `finrank ℂ W`
steps the chain is a basis, hence spans `W`, hence generates `I`.
-/

namespace Work.BW.RB

open Work.BW

noncomputable section

variable {N : ℕ}

/-! ## Auxiliary lemmas -/

/-- The predecessors of the last index in `Fin.snoc g x` are exactly all of `g`. -/
lemma egc_range_snoc_preds {N n : ℕ} (g : Fin n → MR N) (x : MR N) :
    (Fin.snoc g x) '' {j : Fin (n + 1) | j.1 < n} = Set.range g := by
  have hset : {j : Fin (n + 1) | j.1 < n} = Fin.castSucc '' (Set.univ : Set (Fin n)) := by
    ext j; constructor
    · intro hj; exact ⟨⟨j.1, hj⟩, trivial, rfl⟩
    · rintro ⟨k, -, rfl⟩; exact k.2
  rw [hset, ← Set.image_comp, Set.image_univ, Fin.snoc_comp_castSucc]

/-- The predecessors of `Fin.castSucc i` in `Fin.snoc g x` are exactly the predecessors of `i` in
`g`. -/
lemma egc_range_snoc_preds_lt {N n : ℕ} (g : Fin n → MR N) (x : MR N) (i : Fin n) :
    (Fin.snoc g x) '' {j : Fin (n + 1) | j.1 < i.1} = g '' {j : Fin n | j.1 < i.1} := by
  have hset : {j : Fin (n + 1) | j.1 < i.1} = Fin.castSucc '' {j : Fin n | j.1 < i.1} := by
    ext j; constructor
    · intro hj; exact ⟨⟨j.1, lt_trans hj i.2⟩, hj, rfl⟩
    · rintro ⟨k, hk, rfl⟩; exact hk
  rw [hset, ← Set.image_comp, Fin.snoc_comp_castSucc]

/-- The ideal generated by the predecessors of `Fin.castSucc i` in `Fin.snoc g x` is the ideal
generated by the predecessors of `i` in `g`. -/
lemma egc_span_preds_snoc_castSucc {N n : ℕ} (g : Fin n → MR N) (x : MR N) (i : Fin n) :
    (Ideal.span (↑((Finset.univ.filter (fun j : Fin (n + 1) => j.1 < (Fin.castSucc i).1)).image
        (Fin.snoc g x)) : Set (MR N)))
      = (Ideal.span (↑((Finset.univ.filter (fun j : Fin n => j.1 < i.1)).image g) :
          Set (MR N))) := by
  congr 1
  rw [Finset.coe_image, Finset.coe_image, Finset.coe_filter, Finset.coe_filter]
  simp only [Finset.mem_univ, true_and]
  exact egc_range_snoc_preds_lt g x i

/-- The ideal generated by the predecessors of the last index in `Fin.snoc g x` is the ideal
generated by `g`. -/
lemma egc_span_preds_snoc_last {N n : ℕ} (g : Fin n → MR N) (x : MR N) :
    (Ideal.span (↑((Finset.univ.filter (fun j : Fin (n + 1) => j.1 < (Fin.last n).1)).image
        (Fin.snoc g x)) : Set (MR N))) = Ideal.span (Set.range g) := by
  congr 1
  rw [Finset.coe_image, Finset.coe_filter]
  simp only [Finset.mem_univ, true_and]
  exact egc_range_snoc_preds g x

/-- A `ℂ`-subspace of a multihomogeneous piece is finite dimensional. -/
lemma egc_moduleFinite_of_le_homPiece {D : Fin (N + 1) →₀ ℕ} {W : Submodule ℂ (MR N)}
    (hW : W ≤ (homPiece N D : Submodule ℂ (MR N))) : Module.Finite ℂ ↥W := by
  have h1 : Module.Finite ℂ ↥(homPiece N D : Submodule ℂ (MR N)) := inferInstance
  have h2 : Module.Finite ℂ ↥(Submodule.comap (homPiece N D : Submodule ℂ (MR N)).subtype
      (W.restrictScalars ℂ)) := inferInstance
  exact Module.Finite.equiv (Submodule.comapSubtypeEquivOfLe hW)

/-- **Avoidance.** Given a proper subspace `S < W` of a `ℂ`-space `W` and finitely many ideals `p`
with `W ⊄ p`, there is `x ∈ W` outside `S` and outside every `p`.

Indeed the `W ∩ p` and `S` are proper subspaces of `W`, and over the infinite field `ℂ` a finite
union of proper subspaces never exhausts `W` (`Submodule.exists_forall_notMem_of_forall_ne_top`). -/
lemma egc_exists_avoid_sub_ideals (W S : Submodule ℂ (MR N)) (hSW : S ≤ W) (hne : S ≠ W)
    (T : Finset (Ideal (MR N))) (hT : ∀ p ∈ T, ¬ W ≤ p.restrictScalars ℂ) :
    ∃ x ∈ W, x ∉ S ∧ ∀ p ∈ T, x ∉ p := by
  classical
  let q : ({p : Ideal (MR N) // p ∈ T} ⊕ Unit) → Submodule ℂ ↥W := fun i =>
    match i with
    | Sum.inl p => Submodule.comap W.subtype (p.1.restrictScalars ℂ)
    | Sum.inr _ => Submodule.comap W.subtype S
  have hq : ∀ i, q i ≠ ⊤ := by
    rintro (⟨p, hp⟩ | ⟨⟩)
    · intro htop
      refine hT p hp (fun x hx => ?_)
      have hmem : (⟨x, hx⟩ : ↥W) ∈ q (Sum.inl ⟨p, hp⟩) := by rw [htop]; trivial
      simpa [q] using hmem
    · intro htop
      refine hne (le_antisymm hSW (fun x hx => ?_))
      have hmem : (⟨x, hx⟩ : ↥W) ∈ q (Sum.inr ()) := by rw [htop]; trivial
      simpa [q] using hmem
  obtain ⟨z, hz⟩ := Submodule.exists_forall_notMem_of_forall_ne_top q hq
  refine ⟨z.1, z.2, ?_, ?_⟩
  · intro hzS
    have hmem : z ∈ q (Sum.inr ()) := by
      show z ∈ Submodule.comap W.subtype S
      rw [Submodule.mem_comap]
      exact hzS
    exact hz (Sum.inr ()) (by simpa [q] using hmem)
  · intro p hp hzp
    have hmem : z ∈ q (Sum.inl ⟨p, hp⟩) := by
      show z ∈ Submodule.comap W.subtype (p.restrictScalars ℂ)
      rw [Submodule.mem_comap]
      exact hzp
    exact hz (Sum.inl ⟨p, hp⟩) (by simpa [q] using hmem)

/-! ## The generic chain -/

theorem exists_generic_chain {N : ℕ} (D : Fin (N + 1) →₀ ℕ)
    (W : Submodule ℂ (MR N)) (hW : W ≤ (homPiece N D : Submodule ℂ (MR N)))
    (I : Ideal (MR N)) (hI : I = Ideal.span (↑W : Set (MR N))) :
    ∃ g : Fin (Module.finrank ℂ W) → MR N,
      (∀ k, g k ∈ W) ∧
      (∀ k : Fin (Module.finrank ℂ W),
        ∀ p ∈ (Ideal.span (↑((Finset.univ.filter
            (fun j : Fin (Module.finrank ℂ W) => j.1 < k.1)).image g) : Set (MR N))).minimalPrimes,
          ¬ I ≤ p → g k ∉ p) ∧
      Ideal.span (Set.range g) = I := by
  classical
  have hfinW : Module.Finite ℂ ↥W := egc_moduleFinite_of_le_homPiece hW
  -- The inductive construction of a "good" chain of every length `k ≤ finrank ℂ W`.
  have key : ∀ k : ℕ, k ≤ Module.finrank ℂ ↥W → ∃ g : Fin k → MR N,
      (∀ j, g j ∈ W) ∧ LinearIndependent ℂ g ∧
      (∀ j : Fin k, ∀ p : Ideal (MR N),
        p ∈ (Ideal.span (↑((Finset.univ.filter (fun i : Fin k => i.1 < j.1)).image g) :
          Set (MR N))).minimalPrimes → ¬ I ≤ p → g j ∉ p) := by
    intro k
    induction k with
    | zero =>
      intro _
      exact ⟨Fin.elim0, fun j => j.elim0, linearIndependent_empty_type, fun j => j.elim0⟩
    | succ n ih =>
      intro hk
      have hn : n ≤ Module.finrank ℂ ↥W := Nat.le_of_succ_le hk
      have hnd : n < Module.finrank ℂ ↥W := Nat.lt_of_succ_le hk
      obtain ⟨g, hgW, hgind, hgav⟩ := ih hn
      -- the span of the chain so far is proper
      have hne : Submodule.span ℂ (Set.range g) ≠ W := by
        intro heq
        have hfr : Module.finrank ℂ ↥(Submodule.span ℂ (Set.range g)) = n := by
          rw [finrank_span_eq_card hgind, Fintype.card_fin]
        rw [heq] at hfr
        omega
      have hSW : Submodule.span ℂ (Set.range g) ≤ W :=
        Submodule.span_le.mpr (fun x hx => by obtain ⟨j, rfl⟩ := hx; exact hgW j)
      -- the primes of the ideal generated by the chain so far that do not contain `I`
      have hfinJ : (Ideal.span (Set.range g)).minimalPrimes.Finite :=
        Ideal.finite_minimalPrimes_of_isNoetherianRing (MR N) _
      set T : Finset (Ideal (MR N)) := hfinJ.toFinset.filter (fun p => ¬ I ≤ p) with hTdef
      have hTmem : ∀ p : Ideal (MR N),
          p ∈ T ↔ p ∈ (Ideal.span (Set.range g)).minimalPrimes ∧ ¬ I ≤ p := by
        intro p
        rw [hTdef, Finset.mem_filter, Set.Finite.mem_toFinset]
      have hT : ∀ p ∈ T, ¬ W ≤ p.restrictScalars ℂ := by
        intro p hp hWp
        exact ((hTmem p).mp hp).2 (by
          rw [hI]
          exact Ideal.span_le.mpr (fun x hx => hWp hx))
      obtain ⟨x, hxW, hxS, hxT⟩ :=
        egc_exists_avoid_sub_ideals W (Submodule.span ℂ (Set.range g)) hSW hne T hT
      refine ⟨Fin.snoc g x, ?_, ?_, ?_⟩
      · intro j
        rcases Fin.eq_castSucc_or_eq_last j with ⟨i, rfl⟩ | rfl
        · rw [Fin.snoc_castSucc]; exact hgW i
        · rw [Fin.snoc_last]; exact hxW
      · exact LinearIndependent.finSnoc hgind hxS
      · intro j
        rcases Fin.eq_castSucc_or_eq_last j with ⟨i, rfl⟩ | rfl
        · intro p hp hnI
          rw [egc_span_preds_snoc_castSucc g x i] at hp
          rw [Fin.snoc_castSucc]
          exact hgav i p hp hnI
        · intro p hp hnI
          rw [egc_span_preds_snoc_last g x] at hp
          rw [Fin.snoc_last]
          exact hxT p ((hTmem p).mpr ⟨hp, hnI⟩)
  obtain ⟨g, hgW, hgind, hgav⟩ := key (Module.finrank ℂ ↥W) le_rfl
  refine ⟨g, hgW, hgav, ?_⟩
  -- a linearly independent family of `finrank ℂ W` elements of `W` spans `W`
  have hspan_eq : Submodule.span ℂ (Set.range g) = W := by
    refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
    · refine Submodule.span_le.mpr ?_
      rintro x ⟨j, rfl⟩
      exact hgW j
    · rw [finrank_span_eq_card hgind, Fintype.card_fin]
  have hle1 : Ideal.span (Set.range g) ≤ Ideal.span (↑W : Set (MR N)) :=
    Ideal.span_le.mpr (fun x hx => by
      obtain ⟨j, rfl⟩ := hx
      exact Ideal.subset_span (hgW j))
  have hle2 : Ideal.span (↑W : Set (MR N)) ≤ Ideal.span (Set.range g) := by
    refine Ideal.span_le.mpr (fun x hx => ?_)
    have hx' : x ∈ Submodule.span ℂ (Set.range g) := by rw [hspan_eq]; exact hx
    have hsub : Submodule.span ℂ (Set.range g) ≤
        (Ideal.span (Set.range g)).restrictScalars ℂ :=
      Submodule.span_le.mpr (fun y hy => Ideal.subset_span hy)
    exact hsub hx'
  rw [hI]
  exact le_antisymm hle1 hle2

end

end Work.BW.RB
