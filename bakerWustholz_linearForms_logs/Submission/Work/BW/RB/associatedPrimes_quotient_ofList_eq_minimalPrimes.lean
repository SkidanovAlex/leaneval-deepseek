import Mathlib
import Submission.Work.BW.unmixed_regSeq


namespace Work.BW.RB

/-- `Ideal.ofList l` is the ideal generated by the entries of `l`. -/
private lemma ofList_eq_span_set {R : Type*} [Semiring R] (l : List R) :
    Ideal.ofList l = Ideal.span {x | x ∈ l} := by
  induction l with
  | nil => simp [Ideal.ofList_nil]
  | cons r rs ih =>
    rw [Ideal.ofList_cons, ih, ← Ideal.span_union]
    congr 1
    ext x
    simp

/-- **Associated primes of the quotient by a regular sequence in `ℂ[σ]_𝔪`.**

In the local ring `A = ℂ[σ]_𝔪` at a maximal ideal `𝔪` of a polynomial ring over `ℂ`, the associated
primes of `A ⧸ (f)` for a regular sequence `f` consisting of elements of the maximal ideal are
exactly the minimal primes over `(f)`.

The inclusion `⊆` (unmixedness / no embedded primes) is `Submission.Work.BW.unmixed_regSeq`, the
Macaulay unmixedness theorem in this local setting.  The reverse inclusion `⊇` is the general fact
that every minimal prime over the annihilator of a finitely generated module is an associated
prime (`Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes`), together with
`Module.annihilator R (R ⧸ I) = I`. -/
theorem associatedPrimes_quotient_ofList_eq_minimalPrimes {σ : Type*} [Fintype σ]
    (𝔪 : Ideal (MvPolynomial σ ℂ)) [𝔪.IsMaximal]
    (f : List (Localization.AtPrime 𝔪))
    (hmem : ∀ x ∈ f, x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
    (hreg : RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) f) :
    associatedPrimes (Localization.AtPrime 𝔪)
        (Localization.AtPrime 𝔪 ⧸ Ideal.ofList f)
      = (Ideal.ofList f).minimalPrimes := by
  have hof : Ideal.ofList f = Ideal.span {x | x ∈ f} := ofList_eq_span_set f
  rw [hof]
  refine Set.Subset.antisymm ?_ ?_
  · intro p hp
    exact Work.BW.unmixed_regSeq 𝔪 f hmem hreg p hp
  · intro p hp
    have hann : Module.annihilator (Localization.AtPrime 𝔪)
        (Localization.AtPrime 𝔪 ⧸ Ideal.span {x | x ∈ f}) = Ideal.span {x | x ∈ f} :=
      Ideal.annihilator_quotient
    exact Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes
      (Localization.AtPrime 𝔪) _ (by rwa [hann])

end Work.BW.RB
