import Mathlib
import Submission.Work.BW.DefsMult
import Submission.Work.BW.unmixed_regSeq
import Submission.Work.BW.regSeq_le_dim_of_ass
import Submission.Work.BW.regSeq_quotient
import Submission.Work.BW.mvpoly_local_regSeq
import Submission.Work.BW.RB.height_sup_span_le_add_one


namespace Work.BW.RB

/-!
# Fact E input: local unmixedness (Macaulay) for ideals of height equal to the number of generators

The main theorem `unmixed_of_height_eq_card` reduces Macaulay unmixedness for an ideal of `ℂ[σ]_𝔪`
generated by as many elements as its height to the (already available) unmixedness
`Work.BW.unmixed_regSeq` for ideals generated by a *regular sequence*.

The reduction is by strong induction on the number of generators, and only needs one input of
"catenarity" type, isolated in the lemma `height_sup_span_le_add_one` below.
-/

/-- `Ideal.ofList l` is the ideal generated by the entries of `l`. -/
private lemma ofList_eq_span_set {R : Type*} [Semiring R] (l : List R) :
    Ideal.ofList l = Ideal.span {x | x ∈ l} := by
  induction l with
  | nil => simp
  | cons r rs ih =>
    rw [Ideal.ofList_cons, ih, ← Ideal.span_union]
    congr 1
    ext x
    simp

/-- If `l''` is a regular sequence and `a` is a nonzerodivisor on `A ⧸ (l'')`, then `l'' ++ [a]`
is a regular sequence. -/
private lemma isRegular_append_singleton {A : Type*} [CommRing A] [IsLocalRing A]
    [Module.Finite A A]
    (l'' : List A) (a : A) (hl'' : RingTheory.Sequence.IsRegular A l'')
    (hmem : ∀ x ∈ l'' ++ [a], x ∈ IsLocalRing.maximalIdeal A)
    (ha : IsSMulRegular (A ⧸ (Ideal.span {x | x ∈ l''} : Submodule A A)) a) :
    RingTheory.Sequence.IsRegular A (l'' ++ [a]) := by
  rw [IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal hmem,
    RingTheory.Sequence.isWeaklyRegular_append_iff]
  refine ⟨hl''.1, ?_⟩
  rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff]
  have hkey : Ideal.ofList l'' • ⊤ = (Ideal.span {x | x ∈ l''} : Submodule A A) := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top, ofList_eq_span_set]
  rw [hkey]
  exact ha

/-- An element lying in no associated prime of `A ⧸ I` is a nonzerodivisor on `A ⧸ I`
(the union of the associated primes is the set of zero-divisors). -/
private lemma isSMulRegular_of_forall_notMem_associatedPrimes
    {A : Type*} [CommRing A] [IsNoetherianRing A] {I : Ideal A} {a : A}
    (h : ∀ p ∈ associatedPrimes A (A ⧸ I), a ∉ p) :
    IsSMulRegular (A ⧸ I) a := by
  have hb := biUnion_associatedPrimes_eq_compl_regular A (A ⧸ I)
  by_contra hcon
  have hmem : a ∈ (⋃ p ∈ associatedPrimes A (A ⧸ I), (p : Set A)) := by
    rw [hb]; simpa using hcon
  obtain ⟨p, hp, hap⟩ := Set.mem_iUnion₂.mp hmem
  exact (h p hp) hap

/-- `Ideal.span {x | x ∈ l}` is the span of the finite set of entries of `l`. -/
private lemma span_toFinset_eq {A : Type*} [Semiring A] [DecidableEq A] (l : List A) :
    Ideal.span ((l.toFinset : Finset A) : Set A) = Ideal.span {x | x ∈ l} := by
  congr 1
  ext x
  simp

/-- **`l` is a regular sequence** when `ht (l) = |l|` in `ℂ[σ]_𝔪`.  Strong induction on `|l|`,
peeling the first element: `ht (l') ≥ |l'|` by the add-one lemma, `l'` is regular by induction,
and then `l₀ ∉ Ass (A ⧸ (l'))` because that would force `ht (l) ≤ ht (l') < |l|`. -/
private theorem regular_of_height_eq_card {σ : Type*} [Fintype σ]
    (𝔪 : Ideal (MvPolynomial σ ℂ)) [𝔪.IsMaximal]
    (l : List (Localization.AtPrime 𝔪))
    (hmem : ∀ x ∈ l, x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
    (hht : (Ideal.span {x | x ∈ l}).height = (l.length : ℕ∞)) :
    RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) l := by
  classical
  suffices key : ∀ (n : ℕ) (l : List (Localization.AtPrime 𝔪)), l.length = n →
      (∀ x ∈ l, x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) →
      ((n : ℕ∞) ≤ (Ideal.span {x | x ∈ l}).height) →
      RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) l by
    exact key l.length l rfl hmem (le_of_eq hht.symm)
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro l hlen hmeml hge'
    match l with
    | [] => exact RingTheory.Sequence.IsRegular.nil _ _
    | a :: l' =>
      have hl'n : l'.length + 1 = n := by rw [← hlen, List.length_cons]
      have hl'len : l'.length = n - 1 := by omega
      have hspan : Ideal.span {x | x ∈ (a :: l')} =
          Ideal.span {x | x ∈ l'} ⊔ Ideal.span {a} := by
        rw [show {x : Localization.AtPrime 𝔪 | x ∈ a :: l'} =
          {x : Localization.AtPrime 𝔪 | x ∈ l'} ∪ {a} by
            ext x; simp [List.mem_cons], Ideal.span_union]
      have hmem' : ∀ x ∈ l', x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) :=
        fun x hx => hmeml x (by simp [hx])
      have hproper : Ideal.span {x | x ∈ l'} ⊔ Ideal.span {a} ≠ ⊤ := by
        refine ne_top_of_le_ne_top
          (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime 𝔪)).ne_top ?_
        rw [sup_le_iff]
        refine ⟨Ideal.span_le.mpr (fun x hx => hmem' x hx), ?_⟩
        rw [Ideal.span_le]
        rintro y hy
        rw [Set.mem_singleton_iff] at hy
        exact hmeml y (by rw [List.mem_cons]; exact Or.inl hy)
      have hadd : (n : ℕ∞) ≤ (Ideal.span {x | x ∈ l'}).height + 1 :=
        le_trans hge' (by
          rw [hspan]
          exact height_sup_span_le_add_one 𝔪 _ a hproper)
      have hge : (((l'.length : ℕ)) : ℕ∞) ≤ (Ideal.span {x | x ∈ l'}).height := by
        rcases eq_or_ne (Ideal.span {x | x ∈ l'}).height ⊤ with htop | hfin
        · rw [htop]; exact le_top
        · obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hfin
          have hstep : (n : ℕ∞) ≤ ((m : ℕ) : ℕ∞) + 1 := by rw [hm]; exact hadd
          have hstep' : n ≤ m + 1 := by
            have hh := hstep
            rw [← Nat.cast_one, ← Nat.cast_add] at hh
            exact ENat.natCast_le_natCast.mp hh
          rw [← hm]
          exact ENat.natCast_le_natCast.mpr (by omega)
      have hnpos : 0 < n := by omega
      have hlt : n - 1 < n := Nat.sub_lt hnpos Nat.zero_lt_one
      have hreg' : RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) l' :=
        ih (n - 1) hlt l' hl'len hmem' (by rw [hl'len] at hge; exact hge)
      have hass : ∀ p ∈ associatedPrimes (Localization.AtPrime 𝔪)
            (Localization.AtPrime 𝔪 ⧸ Ideal.span {x | x ∈ l'}),
          p ∈ (Ideal.span {x | x ∈ l'}).minimalPrimes :=
        fun p hp => unmixed_regSeq 𝔪 l' hmem' hreg' p hp
      have ha_notin : ∀ p ∈ associatedPrimes (Localization.AtPrime 𝔪)
            (Localization.AtPrime 𝔪 ⧸ Ideal.span {x | x ∈ l'}), a ∉ p := by
        intro p hp hap
        have hmin := hass p hp
        have hple : Ideal.span {x | x ∈ (a :: l')} ≤ p := by
          rw [hspan]
          refine sup_le hmin.le ?_
          rw [Ideal.span_le]
          rintro y hy
          rw [Set.mem_singleton_iff] at hy
          rw [hy]
          exact hap
        have h1 : (Ideal.span {x | x ∈ (a :: l')}).height ≤ p.height := Ideal.height_mono hple
        have h2 : p.height ≤ ((l'.length : ℕ) : ℕ∞) := by
          have hk := Ideal.height_le_card_of_mem_minimalPrimes_span_finset (s := l'.toFinset)
            (by rw [span_toFinset_eq]; exact hmin)
          exact le_trans hk (by exact_mod_cast List.toFinset_card_le l')
        have hbad : ((l'.length + 1 : ℕ) : ℕ∞) ≤ (l'.length : ℕ∞) := by
          calc ((l'.length + 1 : ℕ) : ℕ∞) = (n : ℕ∞) := by rw [hl'n]
            _ ≤ p.height := le_trans hge' h1
            _ ≤ (l'.length : ℕ∞) := h2
        exact absurd hbad (not_le.mpr (by exact_mod_cast Nat.lt_succ_self l'.length))
      have ha : IsSMulRegular (Localization.AtPrime 𝔪 ⧸ Ideal.span {x | x ∈ l'}) a :=
        isSMulRegular_of_forall_notMem_associatedPrimes ha_notin
      have hmem'' : ∀ z ∈ l' ++ [a], z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) := by
        intro z hz
        rw [List.mem_append] at hz
        rcases hz with hz | hz
        · exact hmem' z hz
        · rw [List.mem_singleton] at hz
          exact hmeml z (by rw [List.mem_cons]; exact Or.inl hz)
      have hreg'' : RingTheory.Sequence.IsRegular (Localization.AtPrime 𝔪) (l' ++ [a]) :=
        isRegular_append_singleton l' a hreg' hmem'' ha
      refine IsLocalRing.isRegular_of_perm hreg'' ((List.perm_append_comm).trans ?_)
      exact List.Perm.of_eq List.singleton_append

/-- **Fact E input: local unmixedness (Macaulay) for ideals of height equal to the number of
generators.**

In the local ring `A = ℂ[σ]_𝔪` at a maximal ideal `𝔪`, an ideal generated by `l.length` elements
lying in the maximal ideal and of height exactly `l.length` is unmixed: every associated prime of
`A ⧸ (l)` is minimal over `(l)`.

This is the only Cohen–Macaulay input used by Philippon's proof of Proposition 3.3 (the `J_b` of
the generic chain are locally generated by a regular sequence, so their quotients have no embedded
component through a point of the open set `𝒰`).  Route: `A` is a regular local ring, hence
Cohen–Macaulay; an ideal of height `r` generated by `r` elements in a `CM` local ring is generated
by a regular sequence (induction: some generator is a nonzerodivisor modulo the previous ones,
using that height drops by exactly one modulo a nonzerodivisor), and then `unmixed_regSeq`
(`Submission.Work.BW.unmixed_regSeq`: in `ℂ[σ]_𝔪`, every associated prime of the quotient by a
regular sequence is minimal over it) applies.  The auxiliary files
`regSeq_le_dim_of_ass`, `regSeq_quotient` and `mvpoly_local_regSeq` supply the elementary inputs
(`|rs| ≤ ringKrullDim (A ⧸ p)` for `p ∈ Ass`, depth drops by one modulo a regular element, and the
existence of a full-length regular sequence in `ℂ[σ]_𝔪`). -/
theorem unmixed_of_height_eq_card {σ : Type*} [Fintype σ]
    (𝔪 : Ideal (MvPolynomial σ ℂ)) [𝔪.IsMaximal]
    (l : List (Localization.AtPrime 𝔪))
    (hmem : ∀ x ∈ l, x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
    (hht : (Ideal.span {x | x ∈ l}).height = (l.length : ℕ∞)) :
    ∀ p ∈ associatedPrimes (Localization.AtPrime 𝔪)
        (Localization.AtPrime 𝔪 ⧸ Ideal.span {x | x ∈ l}),
      p ∈ (Ideal.span {x | x ∈ l}).minimalPrimes := by
  have hreg := regular_of_height_eq_card 𝔪 l hmem hht
  exact fun p hp => unmixed_regSeq 𝔪 l hmem hreg p hp

end Work.BW.RB
