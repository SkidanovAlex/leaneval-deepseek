/-!
# Block A4 (Philippon 1986, 3.3): the `S H` bookkeeping

`Srel N D J` is the total `length × H(·; D)` over the minimal primes of `J` meeting the cone over
`G = G_a × G_m^N`: Philippon's `S^𝒰 H(J; D)` for `𝒰` the cone points.  The main theorem of this
block (`refined_bezout`) is the inequality `S^𝒰 H(I; D) ≤ H(0; D)` for an ideal `I` generated by
polynomials of multidegree exactly `D`.

## State (2026, session notes)

`Srel` is *not* bounded by `Sfun`-type sums without the cone restriction: the unrestricted sum
`Sfun N D J` over **all** minimal primes can exceed `rayDeg N D ⊥`.  Counterexample (`N = 1`,
`D = (1,1)`, so `rayDeg N D ⊥ = 2`): `J = (x_{0,0} y_{0,0}, x_{1,0} y_{1,0})` has the four minimal
primes `(X_{0,0},X_{0,1})`, `(X_{0,0},X_{1,1})`, `(X_{1,0},X_{0,1})`, `(X_{1,0},X_{1,1})`, each of
`primLen` `1` and `rayDeg` `1`, so `Sfun N D J = 4 > 2 = rayDeg N D ⊥`.  Those four primes are all
**non**-admissible (each contains a cone coordinate), which is exactly why the statement below is
stated with the cone restriction.  In particular the earlier versions of `Sfun_cut`/`Sfun_spanned_le`
in this file were FALSE and have been removed.

What remains is: (i) the bookkeeping around `Srel`, (ii) the base case `Srel_bot`, and (iii) the
main estimate `Srel_spanned_le` (see its docstring for the route).

## The one-step cut is FALSE

The naive crux "adding a generator of multidegree exactly `D` does not increase `Srel`" fails.
Counterexample (project lead).  `N = 3`, `D = (1,1,1,1)`, `l_i = X_{i,1} - X_{i,0}`, `J` spanned by
the degree-`D` multiples of `l_0l_2, l_0l_3, l_1l_2, l_1l_3`; its admissible minimal primes are
`(l_0,l_1)`, `(l_2,l_3)`.  In the chart `X_{i,0} = 1` at the all-ones point (coordinates `x,y,z,w`)
one has `J = (x,y) ∩ (z,w) = (xz,xw,yz,yw)` and the two degree-`D` elements
`g_1 = l_0X_{10}X_{20}X_{30} + l_2X_{00}X_{10}X_{30}`, `g_2 = l_1X_{00}X_{20}X_{30} +
l_3X_{00}X_{10}X_{20}` satisfy `g_1 ~ x+z`, `g_2 ~ y+w`.  Then `Srel (J+(g_1)) = 2`, while
`Srel (J+(g_1)+(g_2)) = 3` (the only admissible minimal prime of the latter is the point with local
ring `ℂ[x,y]/(x²,xy,y²)`, of length `3`), so the cut inequality `Srel (J+(g_1)+(g_2)) ≤
Srel (J+(g_1))` is false.  This is the classical non-Cohen–Macaulay excess.  It does not contradict
`refined_bezout` (`3 ≤ rayDeg N D ⊥ = 24`).
-/

namespace Work.BW

open MvPolynomial

noncomputable section

variable {N : ℕ}

/-- A point of the cone over `G` lying on the minimal prime `p`. -/
def OnGPrime (N : ℕ) (p : Ideal (MR N)) : Prop :=
  ∃ x, OnG N x ∧ p ≤ ptIdeal N x

/-- Philippon's `S H(J; D)`: the sum of `length × H(·; D)` over all minimal primes of `J`. -/
noncomputable def Sfun (N : ℕ) (D : Fin (N + 1) →₀ ℕ) (J : Ideal (MR N)) : ℚ :=
  ∑ᶠ (p : Ideal (MR N)) (_ : p ∈ J.minimalPrimes), ((primLen J p).toNat : ℚ) * rayDeg N D p

/-- The left-hand side of Philippon's inequality: only the minimal primes meeting the cone over
`G` are counted. -/
noncomputable def Srel (N : ℕ) (D : Fin (N + 1) →₀ ℕ) (J : Ideal (MR N)) : ℚ :=
  ∑ᶠ (p : Ideal (MR N)) (_ : p ∈ J.minimalPrimes ∧ OnGPrime N p),
    ((primLen J p).toNat : ℚ) * rayDeg N D p

/-! ## Non-negativity of `rayDeg` -/

/-- `rayDeg` is non-negative. -/
lemma rayDeg_nonneg (D : Fin (N + 1) →₀ ℕ) (J : Ideal (MR N)) : 0 ≤ rayDeg N D J := by
  rw [rayDeg]
  by_cases h : rayPoly N D J = 0
  · rw [h]; simp
  · obtain ⟨q, hq, hq0⟩ := (rb_rayPoly_ne_zero_iff).1 h
    rw [(rb_rayPoly_eq_iff ⟨q, hq⟩).2 hq]
    refine mul_nonneg (by positivity) (rb_leadingCoeff_nonneg_of_eventually ?_)
    filter_upwards [hq] with t ht
    rw [← ht]
    positivity

/-! ## Comparing the restricted sum with the total -/

/-- For `f ≥ 0`, the `finsum` indexed by the stronger proposition `P ∧ Q` is at most the one
indexed by `P`. -/
lemma finsum_prop_le (P Q : Prop) [Decidable P] [Decidable Q] {f : ℚ} (hf : 0 ≤ f) :
    (∑ᶠ (_ : P ∧ Q), f) ≤ ∑ᶠ (_ : P), f := by
  by_cases h : P <;> by_cases h' : Q <;> simp_all

lemma hasFiniteSupport_Srel (D : Fin (N + 1) →₀ ℕ) (J : Ideal (MR N)) :
    Function.HasFiniteSupport (fun p : Ideal (MR N) =>
      ∑ᶠ (_ : p ∈ J.minimalPrimes ∧ OnGPrime N p),
        ((primLen J p).toNat : ℚ) * rayDeg N D p) := by
  rw [Function.HasFiniteSupport]
  refine (Ideal.finite_minimalPrimes_of_isNoetherianRing _ J).subset (fun p hp => ?_)
  by_contra h
  have h' : ¬ J.IsMinimalPrime p := h
  simp [h'] at hp

lemma hasFiniteSupport_Sfun (D : Fin (N + 1) →₀ ℕ) (J : Ideal (MR N)) :
    Function.HasFiniteSupport (fun p : Ideal (MR N) =>
      ∑ᶠ (_ : p ∈ J.minimalPrimes), ((primLen J p).toNat : ℚ) * rayDeg N D p) := by
  rw [Function.HasFiniteSupport]
  refine (Ideal.finite_minimalPrimes_of_isNoetherianRing _ J).subset (fun p hp => ?_)
  by_contra h
  have h' : ¬ J.IsMinimalPrime p := h
  simp [h'] at hp

/-- Counting only the minimal primes that meet the cone over `G` can only decrease the sum. -/
lemma Srel_le_Sfun (D : Fin (N + 1) →₀ ℕ) (J : Ideal (MR N)) :
    Srel N D J ≤ Sfun N D J := by
  classical
  rw [Srel, Sfun]
  refine finsum_le_finsum (hasFiniteSupport_Srel D J) (hasFiniteSupport_Sfun D J)
    (fun p => ?_)
  exact finsum_prop_le _ _ (mul_nonneg (by positivity) (rayDeg_nonneg D p))

/-! ## The zero ideal -/

lemma minimalPrimes_bot : (⊥ : Ideal (MR N)).minimalPrimes = {⊥} :=
  Ideal.minimalPrimes_eq_subsingleton_self

/-- The cone over `G` is non-empty (e.g. at the point with all coordinates `1`). -/
lemma OnGPrime_bot : OnGPrime N (⊥ : Ideal (MR N)) := by
  refine ⟨conePt N (fun _ => 1), ⟨?_, fun i => ⟨?_, ?_⟩⟩, bot_le⟩
  · simp [conePt]
  · simp [conePt]
  · simp [conePt]

/-- `Sfun` at the zero ideal: only the prime `⊥` contributes. -/
lemma Sfun_bot (D : Fin (N + 1) →₀ ℕ) :
    Sfun N D ⊥ = ((primLen (⊥ : Ideal (MR N)) ⊥).toNat : ℚ) * rayDeg N D ⊥ := by
  rw [Sfun, minimalPrimes_bot]
  simp

/-- **Base case.** `Srel` at the zero ideal is `H(0; D)`: the only minimal prime of `⊥` is `⊥`
itself (`minimalPrimes_bot`), it is admissible (`OnGPrime_bot`), and its multiplicity is `1`
(`primLen_bot`). -/
lemma Srel_bot (D : Fin (N + 1) →₀ ℕ) :
    Srel N D (⊥ : Ideal (MR N)) = rayDeg N D ⊥ := by
  have hpb := primLen_bot (N := N)
  rw [Srel, minimalPrimes_bot]
  simp only [Set.mem_singleton_iff]
  rw [finsum_eq_single _ (⊥ : Ideal (MR N))]
  · simp [OnGPrime_bot, hpb]
  · intro p hp
    simp [hp]

/-! ## Bookkeeping for the cutting lemma -/

/-- Meeting the cone is monotone downwards: an ideal contained in an admissible ideal is
admissible.  This is what makes the cutting lemma a statement about each admissible parent
separately: a minimal prime of `J ⊔ (g)` is contained in a minimal prime of `J` (below), so if it
is admissible then so is its parent. -/
lemma OnGPrime_anti {p q : Ideal (MR N)} (hpq : p ≤ q) (hq : OnGPrime N q) : OnGPrime N p := by
  obtain ⟨x, hx, hqx⟩ := hq
  exact ⟨x, hx, le_trans hpq hqx⟩

/-- Every minimal prime of `J ⊔ (g)` contains a minimal prime of `J`. -/
lemma minimalPrimes_sup_le (J : Ideal (MR N)) (g : MR N) {q : Ideal (MR N)}
    (hq : q ∈ (J ⊔ Ideal.span {g}).minimalPrimes) : ∃ p ∈ J.minimalPrimes, p ≤ q := by
  obtain ⟨hqle, hqprime⟩ := hq.le, hq.isPrime
  exact Ideal.exists_minimalPrimes_le (le_trans le_sup_left hqle)

/-- The span of a set of multihomogeneous elements is multihomogeneous. -/
lemma multiHom_span (D : Fin (N + 1) →₀ ℕ) (g : Finset (MR N))
    (hg : ∀ P ∈ g, P ∈ homPiece N D) : MultiHom N (Ideal.span (↑g : Set (MR N))) := by
  have h : ∀ g : Finset (MR N), (∀ P ∈ g, P ∈ homPiece N D) →
      MultiHom N (Ideal.span (↑g : Set (MR N))) := by
    intro g
    induction g using Finset.induction with
    | empty =>
        intro _
        rw [Finset.coe_empty, Ideal.span_empty]
        intro p hp d
        have hp0 : p = 0 := by simpa using hp
        rw [hp0]
        simp
    | insert a g ha ih =>
        intro hg
        have ha_mem : a ∈ homPiece N D := hg a (Finset.mem_insert_self a g)
        have hg' : ∀ P ∈ g, P ∈ homPiece N D := fun P hP => hg P (Finset.mem_insert_of_mem hP)
        rw [Finset.coe_insert, Ideal.span_insert, multiHom_iff_multiHomZ]
        refine MultiHomZ.sup ?_ ?_
        · refine MultiHomZ.span_singleton (u := castF D) ?_
          rw [← homPiece_eq_pieceZ]
          exact ha_mem
        · exact (multiHom_iff_multiHomZ _).mp (ih hg')
  exact h g hg

/-- A set of polynomials of multidegree exactly `D` spans an ideal generated by finitely many
such polynomials. -/
lemma exists_finset_span (D : Fin (N + 1) →₀ ℕ) (s : Set (MR N))
    (hs : ∀ P ∈ s, P ∈ homPiece N D) :
    ∃ g : Finset (MR N), (∀ P ∈ g, P ∈ homPiece N D) ∧
      Ideal.span s = Ideal.span (↑g : Set (MR N)) := by
  classical
  set I : Ideal (MR N) := Ideal.span s with hIdef
  set K : Submodule ℂ (MR N) := I.restrictScalars ℂ ⊓ (homPiece N D : Submodule ℂ (MR N))
    with hKdef
  have hI : I = Ideal.span (↑K : Set (MR N)) := by
    refine le_antisymm ?_ ?_
    · rw [hIdef, Ideal.span_le]
      intro P hP
      exact Ideal.subset_span ⟨Ideal.subset_span hP, hs P hP⟩
    · rw [Ideal.span_le]
      intro P hP
      exact hP.1
  haveI : Module.Finite ℂ ↥K := by
    rw [hKdef]
    infer_instance
  obtain ⟨S, hSfin, hSspan⟩ := Submodule.fg_def.mp ((Module.Finite.iff_fg).mp ‹Module.Finite ℂ ↥K›)
  obtain ⟨g, hg⟩ := hSfin.exists_finset
  have hgeq : (↑g : Set (MR N)) = S := Set.ext (fun a => hg a)
  refine ⟨g, ?_, ?_⟩
  · intro P hP
    have hP_S : P ∈ S := (hg P).1 hP
    have hmem : P ∈ K := by
      rw [← hSspan]
      exact Submodule.subset_span hP_S
    rw [hKdef] at hmem
    exact hmem.2
  · rw [hI, hgeq]
    have h1 : (↑K : Set (MR N)) =
        ↑(Submodule.span ℂ (S : Set (MR N)) : Submodule ℂ (MR N)) := by
      rw [hSspan]
    have hspan_sub : (Submodule.span ℂ (S : Set (MR N)) : Set (MR N)) ⊆
        ↑(Ideal.span (S : Set (MR N))) := by
      intro y hy
      have hle : Submodule.span ℂ (S : Set (MR N)) ≤
          (Ideal.span (S : Set (MR N))).restrictScalars ℂ :=
        Submodule.span_le.mpr (fun z hz => Ideal.subset_span hz)
      exact hle hy
    have hS_sub : (S : Set (MR N)) ⊆
        ↑(Ideal.span (↑(Submodule.span ℂ (S : Set (MR N)) : Submodule ℂ (MR N)) : Set (MR N))) :=
      fun z hz => Ideal.subset_span (Submodule.subset_span hz)
    have h2 : Ideal.span
          (↑(Submodule.span ℂ (S : Set (MR N)) : Submodule ℂ (MR N)) : Set (MR N)) =
        Ideal.span (S : Set (MR N)) :=
      le_antisymm (Ideal.span_le.mpr hspan_sub) (Ideal.span_le.mpr hS_sub)
    rw [h1, h2]

end

end Work.BW
