import Mathlib

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.BW

open IsDedekindDomain FractionalIdeal

/-- The `v`-adic valuation of a nonzero `x : K` is the exponential of minus the exponent of the
prime `v` in the principal fractional ideal generated by `x`. -/
theorem valuation_eq_exp_neg_count {K : Type*} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {x : K} (hx : x ≠ 0) :
    v.valuation K x = WithZero.exp
      (-(FractionalIdeal.count K v (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) x))) := by
  classical
  obtain ⟨r, s, hrs⟩ :=
    IsLocalization.exists_mk'_eq (nonZeroDivisors (NumberField.RingOfIntegers K)) x
  have hs_ne : (s : NumberField.RingOfIntegers K) ≠ 0 := nonZeroDivisors.ne_zero s.2
  have hr_ne : r ≠ 0 := by
    intro hr
    apply hx
    rw [← hrs, hr, IsLocalization.mk'_eq_zero_iff]
    exact ⟨s, Subtype.ext (mul_zero _)⟩
  rw [← hrs]
  have hspanr : (Ideal.span {r} : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Ideal.zero_eq_bot, Ne, Ideal.span_singleton_eq_bot]; exact hr_ne
  have hspans :
      (Ideal.span {(s : NumberField.RingOfIntegers K)} : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Ideal.zero_eq_bot, Ne, Ideal.span_singleton_eq_bot]; exact hs_ne
  have h_aJ : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
        (IsLocalization.mk' K r s) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
          ((algebraMap (NumberField.RingOfIntegers K) K) (s : NumberField.RingOfIntegers K))⁻¹ *
        ↑(Ideal.span {r} : Ideal (NumberField.RingOfIntegers K)) := by
    rw [IsFractionRing.mk'_eq_div, div_eq_mul_inv, ← FractionalIdeal.spanSingleton_mul_spanSingleton,
      ← FractionalIdeal.coeIdeal_span_singleton r, mul_comm]
  have hI : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
      (IsLocalization.mk' K r s) ≠ 0 := by
    rw [hrs]; exact FractionalIdeal.spanSingleton_ne_zero_iff.mpr hx
  have hcount : FractionalIdeal.count K v (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) (IsLocalization.mk' K r s))
      = FractionalIdeal.count K v (↑(Ideal.span {r}) :
            FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
        - FractionalIdeal.count K v (↑(Ideal.span {(s : NumberField.RingOfIntegers K)}) :
            FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) := by
    rw [FractionalIdeal.count_well_defined K v hI h_aJ, ← FractionalIdeal.count_coe K v hspanr,
      ← FractionalIdeal.count_coe K v hspans]
  have hint_r : v.intValuation r = WithZero.exp (-(FractionalIdeal.count K v
      (↑(Ideal.span {r}) : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K))) := by
    rw [v.intValuation_if_neg hr_ne, ← FractionalIdeal.count_coe K v hspanr]
  have hint_s : v.intValuation (s : NumberField.RingOfIntegers K) = WithZero.exp
      (-(FractionalIdeal.count K v
      (↑(Ideal.span {(s : NumberField.RingOfIntegers K)}) :
        FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K))) := by
    rw [v.intValuation_if_neg hs_ne, ← FractionalIdeal.count_coe K v hspans]
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_mk', hint_r, hint_s, hcount,
    ← WithZero.exp_sub]
  congr 1
  ring

end Work.BW
