/-!
# Helpers for Waldschmidt's Lemma 4.1 (import-cycle-free layer)

`Submission.Work.BW.relation_lattice_aligned_basis` imports the target theorem
`Work.BW.waldschmidt_relation_bound`, and `Submission.Work.BW.small_relation` imports
`relation_lattice_aligned_basis`.  Hence the target may **not** import `small_relation` (that would
be an import cycle).  The few facts of that file which the target needs are therefore restated
here, in a module whose import closure is `Defs`/`relation_lattice_defs`/`thetaC_exists_relation`
only:

* the `hmod` elementary bounds (`wsb_hmod_pos`, `wsb_div_d_le_hmod`, `wsb_norm_le_d_mul_hmod`);
* `wsb_coords_ne_zero`: a nonzero integer relation `∑ yᵢ ℓᵢ = 0` has all coordinates nonzero when
  every `m - 1` of the `ℓᵢ` are `ℚ`-independent;
* `wsb_exists_generator_ker`: the kernel of the log-form is generated by one element;
* `smul_theta_eq_zero_of_exp_eq_one`: a small multiple of `2πi` forces zero.
-/

namespace Work.BW

open NumberField

open Complex

/-! ## Local bounds for the logarithmic height -/

/-- A single infinite-place contribution `log⁺(v x)` is at most the full logarithmic height. -/
theorem logHeight_one_le_of_infinite {K : Type*} [Field K] [NumberField K] (x : K)
    (v : InfinitePlace K) :
    (v x).posLog ≤ Height.logHeight₁ x := by
  have h := NumberField.logHeight₁_eq x
  have hsingle := Finset.single_le_sum
    (f := fun w : InfinitePlace K => (w.mult : ℝ) * (w x).posLog)
    (fun i _ => mul_nonneg (Nat.cast_nonneg _) Real.posLog_nonneg) (Finset.mem_univ v)
  have hm : (1:ℝ) ≤ (v.mult : ℝ) := InfinitePlace.one_le_mult
  have hsub : (v x).posLog ≤ ∑ w : InfinitePlace K, (w.mult : ℝ) * (w x).posLog :=
    le_trans (by nlinarith [Real.posLog_nonneg (x := v x), hm]) hsingle
  have h2 : (0:ℝ) ≤ ∑ᶠ w : FinitePlace K, (w x).posLog :=
    finsum_nonneg fun _ => Real.posLog_nonneg
  calc (v x).posLog ≤ ∑ w : InfinitePlace K, (w.mult : ℝ) * (w x).posLog := hsub
    _ ≤ Height.logHeight₁ x := by rw [h]; exact le_add_of_nonneg_right h2

/-- For a nonzero element and an archimedean place, the logarithm of its absolute value is
bounded in absolute value by the logarithmic height. -/
theorem abs_log_le_of_infinite {K : Type*} [Field K] [NumberField K] (x : K)
    (v : InfinitePlace K) : |Real.log (v x)| ≤ Height.logHeight₁ x := by
  have hh : (v x).posLog ≤ Height.logHeight₁ x := logHeight_one_le_of_infinite x v
  have hpinv : (v x⁻¹).posLog ≤ Height.logHeight₁ x⁻¹ := logHeight_one_le_of_infinite x⁻¹ v
  rw [Height.logHeight₁_inv, map_inv₀] at hpinv
  have hlog₁ : Real.log (v x) ≤ Height.logHeight₁ x := by
    have hh' := hh
    conv at hh' => lhs; rw [Real.posLog_apply]
    exact (max_le_iff.mp hh').2
  have hlog₂ : -Real.log (v x) ≤ Height.logHeight₁ x := by
    have hh' := hpinv
    conv at hh' => lhs; rw [Real.posLog_apply, Real.log_inv]
    exact (max_le_iff.mp hh').2
  rw [abs_le]
  exact ⟨by linarith, hlog₁⟩

/-- Same bound at a finite place. -/
theorem abs_log_le_of_finite {K : Type*} [Field K] [NumberField K] (x : K)
    (v : FinitePlace K) : |Real.log (v x)| ≤ Height.logHeight₁ x := by
  have hh : (v x).posLog ≤ Height.logHeight₁ x := logHeight_one_le_of_finite x v
  have hpinv : (v x⁻¹).posLog ≤ Height.logHeight₁ x⁻¹ := logHeight_one_le_of_finite x⁻¹ v
  rw [Height.logHeight₁_inv, map_inv₀] at hpinv
  have hlog₁ : Real.log (v x) ≤ Height.logHeight₁ x := by
    have hh' := hh
    conv at hh' => lhs; rw [Real.posLog_apply]
    exact (max_le_iff.mp hh').2
  have hlog₂ : -Real.log (v x) ≤ Height.logHeight₁ x := by
    have hh' := hpinv
    conv at hh' => lhs; rw [Real.posLog_apply, Real.log_inv]
    exact (max_le_iff.mp hh').2
  rw [abs_le]
  exact ⟨by linarith, hlog₁⟩

/-! ## Elementary bounds for the modified height (`hmod`) -/

lemma wsb_hmod_pos {K : Type*} [Field K] [NumberField K] (β : K) (ℓ : ℂ) : 0 < hmod β ℓ := by
  have hd : (0:ℝ) < (Module.finrank ℚ K : ℝ) := Nat.cast_pos.mpr Module.finrank_pos
  refine lt_of_lt_of_le ?_ (le_max_right _ _)
  exact lt_of_lt_of_le (div_pos one_pos hd) (le_max_right _ _)

lemma wsb_div_d_le_hmod {K : Type*} [Field K] [NumberField K] (β : K) (ℓ : ℂ) :
    Height.logHeight₁ β / (Module.finrank ℚ K : ℝ) ≤ hmod β ℓ := le_max_left _ _

lemma wsb_norm_le_d_mul_hmod {K : Type*} [Field K] [NumberField K] (β : K) (ℓ : ℂ) :
    ‖ℓ‖ ≤ (Module.finrank ℚ K : ℝ) * hmod β ℓ := by
  have hd : (0:ℝ) < (Module.finrank ℚ K : ℝ) := Nat.cast_pos.mpr Module.finrank_pos
  have h : ‖ℓ‖ / (Module.finrank ℚ K : ℝ) ≤ hmod β ℓ :=
    le_trans (le_max_left _ _) (le_max_right _ _)
  rw [div_le_iff₀ hd] at h
  linarith

/-! ## The kernel of the log-form -/

/-- A nonzero integer relation among the `ℓᵢ` has all coordinates nonzero, when every `m - 1`
of the `ℓᵢ` are `ℚ`-independent.  (Restatement of `Work.BW.coords_ne_zero_of_relation`, which
lives in `Submission.Work.BW.small_relation` and hence cannot be imported here.) -/
lemma wsb_coords_ne_zero {m : ℕ} {ℓ : Fin m → ℂ}
    (hmin : ∀ i, LinearIndependent ℚ (fun j : {j : Fin m // j ≠ i} => ℓ j))
    {y : Fin m → ℤ} (hne : y ≠ 0) (hy : thetaC ℓ y = 0) (i : Fin m) : y i ≠ 0 := by
  intro hi
  have hfull : ∑ j : Fin m, (y j : ℂ) * ℓ j = 0 := hy
  have hsplit : ∑ j ∈ (Finset.univ : Finset (Fin m)).erase i, (y j : ℂ) * ℓ j = 0 := by
    have h1 := Finset.sum_erase_add (Finset.univ : Finset (Fin m))
      (fun j => (y j : ℂ) * ℓ j) (Finset.mem_univ i)
    have h2 : ∑ j : Fin m, (y j : ℂ) * ℓ j = 0 := hfull
    have hi' : (y i : ℂ) * ℓ i = 0 := by rw [hi]; simp
    rw [h2, hi'] at h1
    simpa using h1
  have hsub : ∑ j : {j : Fin m // j ≠ i}, ((y j.1 : ℚ) • ℓ j.1) = 0 := by
    have h := hsplit
    rw [Finset.sum_subtype (s := (Finset.univ : Finset (Fin m)).erase i)
      (p := fun j => j ≠ i) (h := fun j => by simp [Finset.mem_erase])
      (f := fun j => (y j : ℂ) * ℓ j)] at h
    simpa only [Rat.smul_def, Rat.cast_intCast] using h
  have hall := (linearIndependent_iff'.mp (hmin i)) Finset.univ
    (fun j => (y j.1 : ℚ)) hsub
  apply hne
  funext j
  by_cases hj : j = i
  · rw [hj]; exact hi
  · have := hall ⟨j, hj⟩ (Finset.mem_univ _)
    exact_mod_cast this

/-- `IsRelAbs ℓ k n` says: there is a nonzero integer relation `∑ yᵢ ℓᵢ = 0` whose `k`-th
coordinate has absolute value `n`. -/
def IsRelAbs {m : ℕ} (ℓ : Fin m → ℂ) (k : Fin m) (n : ℕ) : Prop :=
  ∃ y : Fin m → ℤ, thetaC ℓ y = 0 ∧ y ≠ 0 ∧ (y k).natAbs = n

/-- **The kernel of the log-form is generated by one element.**  If the `ℓᵢ` are `ℚ`-dependent
but every `m - 1` of them are `ℚ`-independent, then there is `t ≠ 0` with `θ t = 0` and
`ker θ = ℤ · t`.  (Restatement of the intended content of
`Work.BW.exists_generator_ker_theta`, which lives in a module that cannot be imported here.) -/
theorem wsb_exists_generator_ker {m : ℕ} (ℓ : Fin m → ℂ)
    (hmin : ∀ i, LinearIndependent ℚ (fun j : {j : Fin m // j ≠ i} => ℓ j))
    (hdep : ¬ LinearIndependent ℚ ℓ) :
    ∃ t : Fin m → ℤ, t ≠ 0 ∧ thetaC ℓ t = 0 ∧
      ∀ y : Fin m → ℤ, thetaC ℓ y = 0 → ∃ a : ℤ, y = a • t := by
  classical
  obtain ⟨z, hz0, hzθ⟩ := thetaC_exists_relation ℓ hdep
  have hzk : ∃ k : Fin m, z k ≠ 0 := by
    by_contra h
    push Not at h
    exact hz0 (funext h)
  obtain ⟨k, hzk⟩ := hzk
  have hne : ∃ n, IsRelAbs ℓ k n := ⟨(z k).natAbs, z, hzθ, hz0, rfl⟩
  have hspec := Nat.find_spec hne
  simp only [IsRelAbs] at hspec
  obtain ⟨t, htθ, ht0, htn⟩ := hspec
  have htk : t k ≠ 0 := wsb_coords_ne_zero hmin ht0 htθ k
  -- normalise so that `t k > 0`
  set t' : Fin m → ℤ := if 0 < t k then t else -t with ht'def
  have ht'θ : thetaC ℓ t' = 0 := by
    rw [ht'def]; split_ifs with h
    · exact htθ
    · rw [thetaC_neg, htθ, neg_zero]
  have ht'0 : t' ≠ 0 := by
    rw [ht'def]; split_ifs with h
    · exact ht0
    · intro hcon
      exact ht0 (by rw [← neg_neg t, hcon, neg_zero])
  have ht'pos : 0 < t' k := by
    rw [ht'def]; split_ifs with h
    · exact h
    · simp only [Pi.neg_apply]
      omega
  have ht'abs : (t' k).natAbs = Nat.find hne := by
    have : (t' k).natAbs = (t k).natAbs := by
      rw [ht'def]; split_ifs with h
      · rfl
      · rw [Pi.neg_apply, Int.natAbs_neg]
    rw [this, htn]
  have ht'min : ∀ y : Fin m → ℤ, thetaC ℓ y = 0 → y ≠ 0 →
      (t' k).natAbs ≤ (y k).natAbs := by
    intro y hy0 hyne
    have h := Nat.find_min' hne (show IsRelAbs ℓ k ((y k).natAbs) from ⟨y, hy0, hyne, rfl⟩)
    rw [ht'abs]
    exact h
  refine ⟨t', ht'0, ht'θ, fun y hy0 => ?_⟩
  have hT : 0 < t' k := ht'pos
  set q : ℤ := y k / t' k with hq
  set r : ℤ := y k % t' k with hr
  have hr_eq : y k = q * t' k + r := by
    have h := Int.emod_add_mul_ediv (y k) (t' k)
    rw [← hq, ← hr] at h
    linarith [h]
  have hrmod : 0 ≤ r ∧ r < t' k :=
    ⟨Int.emod_nonneg _ (ne_of_gt hT), Int.emod_lt_of_pos _ hT⟩
  have hy' : thetaC ℓ (y - q • t') = 0 := by
    rw [sub_eq_add_neg, thetaC_add, thetaC_neg, thetaC_smul, ht'θ, mul_zero, neg_zero, hy0,
      add_zero]
  have hy'k : (y - q • t') k = r := by
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    linarith [hr_eq]
  have hr_zero : r = 0 := by
    by_contra hrne
    have hy'ne : y - q • t' ≠ 0 := fun h => hrne (by rw [← hy'k, h]; rfl)
    have h := ht'min (y - q • t') hy' hy'ne
    rw [hy'k] at h
    have hlt : r.natAbs < (t' k).natAbs := by
      have h3 : ((r.natAbs : ℕ) : ℤ) < (((t' k).natAbs : ℕ) : ℤ) := by
        rw [Int.natAbs_of_nonneg hrmod.1, Int.natAbs_of_nonneg (le_of_lt hT)]
        exact hrmod.2
      exact_mod_cast h3
    omega
  have hyz : y - q • t' = 0 := by
    by_contra h
    have hk' := wsb_coords_ne_zero hmin h hy' k
    rw [hy'k, hr_zero] at hk'
    exact hk' rfl
  refine ⟨q, ?_⟩
  funext j
  have hthis := congr_fun hyz j
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, sub_eq_zero] at hthis
  simpa only [Pi.smul_apply, smul_eq_mul] using hthis

/-! ## A small multiple of `2πi` vanishes -/

/-- If `exp (q θ) = 1`, `0 < q` and `q ‖θ‖ < 2π`, then `θ = 0`. -/
lemma smul_theta_eq_zero_of_exp_eq_one (q : ℕ) (θ : ℂ) (hq : 0 < q)
    (hexp : Complex.exp ((q : ℂ) * θ) = 1) (hb : (q : ℝ) * ‖θ‖ < 2 * Real.pi) : θ = 0 := by
  obtain ⟨m, hm⟩ := Complex.exp_eq_one_iff.mp hexp
  have hR : ‖(m : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)‖ = |(m:ℝ)| * (2 * Real.pi) := by
    rw [norm_mul, Complex.norm_intCast]
    congr 1
    rw [show (2 : ℂ) * (Real.pi : ℂ) * Complex.I = (((2 * Real.pi : ℝ)) : ℂ) * Complex.I by
      push_cast; ring]
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (by positivity : (0:ℝ) ≤ 2 * Real.pi)]
  have hL : ‖(q : ℂ) * θ‖ = (q : ℝ) * ‖θ‖ := by rw [norm_mul, Complex.norm_natCast]
  have h2 : (q : ℝ) * ‖θ‖ = |(m:ℝ)| * (2 * Real.pi) := by
    have h3 : ‖(q : ℂ) * θ‖ = ‖(m : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)‖ := by rw [hm]
    rwa [hL, hR] at h3
  have hm0 : m = 0 := by
    by_contra hne
    have h1 : (1:ℝ) ≤ |(m:ℝ)| := by
      have h1' : (1:ℤ) ≤ |m| := by
        have hpos : (0:ℤ) < |m| := abs_pos.mpr hne
        omega
      calc (1:ℝ) = ((1:ℤ):ℝ) := by norm_num
        _ ≤ ((|m| : ℤ) : ℝ) := by exact_mod_cast h1'
        _ = |((m:ℤ):ℝ)| := by simp
    have hpos : (0:ℝ) < 2 * Real.pi := by positivity
    have hle : 2 * Real.pi ≤ (q:ℝ) * ‖θ‖ := by
      rw [h2]
      calc 2 * Real.pi = 1 * (2 * Real.pi) := by ring
        _ ≤ |(m:ℝ)| * (2 * Real.pi) := mul_le_mul_of_nonneg_right h1 (le_of_lt hpos)
    linarith [hb]
  rw [hm0] at hm
  simp only [Int.cast_zero, zero_mul] at hm
  rcases mul_eq_zero.mp hm with h | h
  · exact absurd h (by exact_mod_cast (ne_of_gt hq))
  · exact h

end Work.BW
