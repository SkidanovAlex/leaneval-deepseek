import Mathlib
import Submission.Work.BW.Defs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Definitions for the Minkowski basis lemma (`Work.BW.minkowski_basis`)

This file sets up the lattice-theoretic vocabulary used by `Submission.Work.BW.minkowski_basis`:

* `Work.BW.wl1 c` : the weighted `ℓ¹` functional `x ↦ ∑ᵢ cᵢ|xᵢ|` on `ℝⁿ` (`Fin n → ℝ`).
* `Work.BW.latOf A` : the lattice `A ℤⁿ` generated by the columns of an integer matrix `A`,
  as a `ℤ`-submodule of `ℝⁿ`.
* `Work.BW.succMin L F j` : the `j`-th successive minimum of the body `{F ≤ 1}` with respect to
  a lattice `L`, in Minkowski's convention (the infimum of the dilation factors `λ` for which
  `L ∩ {F ≤ λ}` spans a `j`-dimensional real subspace).
-/

namespace Work.BW

open MeasureTheory Matrix

variable {n : ℕ}

/-- The weighted `ℓ¹` functional `F(x) = ∑ᵢ cᵢ|xᵢ|` on `ℝⁿ`. -/
noncomputable def wl1 (c : Fin n → ℝ) (x : Fin n → ℝ) : ℝ := ∑ i, c i * |x i|

/-- The `ℤ`-span of the columns of an integer matrix `A`, as a `ℤ`-submodule of `ℝⁿ`. -/
def latOf (A : Matrix (Fin n) (Fin n) ℤ) : Submodule ℤ (Fin n → ℝ) :=
  Submodule.span ℤ (Set.range (fun j => fun i => ((A i j : ℤ) : ℝ)))

/-- The `j`-th successive minimum of the body `{F ≤ 1}` with respect to the lattice
`L ⊆ ℝⁿ`: the infimum of the dilation factors `λ > 0` such that `L ∩ {F ≤ λ}` spans a
`j`-dimensional real subspace. -/
noncomputable def succMin (L : Submodule ℤ (Fin n → ℝ)) (F : (Fin n → ℝ) → ℝ) (j : ℕ) : ℝ :=
  sInf {lam : ℝ | 0 < lam ∧ j ≤ Module.finrank ℝ
    (Submodule.span ℝ ({x : Fin n → ℝ | F x ≤ lam} ∩ (L : Set (Fin n → ℝ))))}

end Work.BW
