import Mathlib
import Submission.Work.BW.basisRed_defs
import Submission.Work.BW.minkowski_defs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The lattice generated by the identity matrix is `ℤᵈ`

`Work.BW.latOf A` is the `ℤ`-span of the columns of the integer matrix `A`, viewed as vectors
of `ℝᵈ`.  For `A = 1` the columns are the standard basis vectors, so
`latOf 1` is exactly the set of vectors of `ℝᵈ` with integer coordinates:

`x ∈ latOf 1 ↔ ∃ v : Fin d → ℤ, x = fun i => (v i : ℝ)`.

This is used to identify `Work.BW.succMinBody (latOf 1) K j` with the corresponding successive
minimum over `ℤᵈ`.
-/

namespace Work.BW.Minkowski2

/-- The columns of the identity matrix are the standard basis vectors. -/
private lemma col_one_eq_single {d : ℕ} (j : Fin d) :
    (fun i => (((1 : Matrix (Fin d) (Fin d) ℤ) i j : ℤ) : ℝ)) = Pi.single j (1:ℝ) := by
  ext i
  rw [Matrix.one_apply]
  by_cases h : i = j
  · subst h; simp
  · simp [h]

/-- An integer linear combination of the standard basis vectors of `ℝᵈ` is the vector of
its coefficients. -/
private lemma sum_zsmul_single {d : ℕ} (c : Fin d → ℤ) :
    (∑ j, c j • (Pi.single j (1:ℝ) : Fin d → ℝ)) = fun i => (c i : ℝ) := by
  ext i
  simp [Finset.sum_apply, Pi.single_apply]

theorem mem_latOf_one {d : ℕ} (x : Fin d → ℝ) :
    x ∈ Work.BW.latOf (1 : Matrix (Fin d) (Fin d) ℤ) ↔ ∃ v : Fin d → ℤ, x = fun i => (v i : ℝ) := by
  classical
  rw [Work.BW.latOf]
  constructor
  · intro hx
    rw [Submodule.mem_span_range_iff_exists_fun ℤ] at hx
    obtain ⟨c, hc⟩ := hx
    have h2 : (∑ j, c j • (fun i => (((1 : Matrix (Fin d) (Fin d) ℤ) i j : ℤ) : ℝ)))
        = fun i => (c i : ℝ) := by
      rw [Finset.sum_congr rfl (fun j _ => by rw [col_one_eq_single j]), sum_zsmul_single c]
    exact ⟨c, by rw [← hc, h2]⟩
  · rintro ⟨v, rfl⟩
    have h1 : (∑ j, v j • (fun i => (((1 : Matrix (Fin d) (Fin d) ℤ) i j : ℤ) : ℝ)))
        = fun i => (v i : ℝ) := by
      rw [Finset.sum_congr rfl (fun j _ => by rw [col_one_eq_single j]), sum_zsmul_single v]
    rw [← h1]
    exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

end Work.BW.Minkowski2
