import Mathlib
import Submission.Work.BW.sieg2_denom_tuple
import Submission.Work.BW.sieg2_spanFinset_mul_spanSingleton
import Submission.Work.BW.sieg2_spanFinset_integral_eq_coeIdeal
import Submission.Work.BW.sieg2_finprod_iSup_scaling

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The finite-place product of the sup-absolute-value of a tuple

For a number field `F` and a tuple `a : Fin n → F` with at least one nonzero entry, the product
over the finite places `v` of `F` of `⨆ j, v (a j)` equals the inverse of the absolute norm of the
fractional ideal generated by the tuple.  This is the finite half of the product formula for the
multiplicative height of a tuple, expressed through the absolute norm of a fractional ideal.

The proof clears denominators: pick `d ∈ 𝓞 F` nonzero with `b j := d * a j ∈ 𝓞 F` for all `j`
(`Work.BW.sieg2_denom_tuple`).  Then `⨆ j, v (a j) = v d⁻¹ * ⨆ j, v (b j)` and the product splits;
the two factors are evaluated by Mathlib's
`NumberField.absNorm_mul_finprod_finitePlace_eq_one` for the tuple `b` and for the singleton `d`.
On the ideal side, `spanFinset univ a * spanSingleton d = spanFinset univ b`
(`Work.BW.sieg2_spanFinset_mul_spanSingleton`) and `spanFinset univ b` is the fractional ideal
associated with the integral ideal `span (range b)`
(`Work.BW.sieg2_spanFinset_integral_eq_coeIdeal`), so multiplicativity of `absNorm` gives the
matching identity.
-/

namespace Work.BW

open NumberField

theorem sieg2_finprod_sup_absNorm {F : Type*} [Field F] [NumberField F] {n : ℕ}
    (a : Fin n → F) (h : ∃ j, a j ≠ 0) :
    ∏ᶠ v : NumberField.FinitePlace F, (⨆ j : Fin n, v (a j)) =
      ((FractionalIdeal.absNorm
        (FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ a) : ℚ) : ℝ)⁻¹ := by
  classical
  -- Clear denominators: `b j = d * a j` is integral for a single nonzero `d`.
  obtain ⟨d, hd, b, hb⟩ := sieg2_denom_tuple a
  have hdF : (d : F) ≠ 0 := by
    intro hc
    exact hd (IsFractionRing.injective (NumberField.RingOfIntegers F) F
      (hc.trans (map_zero (algebraMap (NumberField.RingOfIntegers F) F)).symm))
  -- The tuple `b` is nonzero, hence so is the ideal it generates.
  have hkeep := h
  obtain ⟨j0, hj0⟩ := h
  have hbj0 : b j0 ≠ 0 := by
    intro hc
    apply hj0
    have h1 : (d : F) * a j0 = 0 := by
      have hh := hb j0
      rw [hc] at hh
      simpa using hh.symm
    exact (mul_eq_zero.mp h1).resolve_left hdF
  have hbne : b ≠ 0 := Function.ne_iff.mpr ⟨j0, hbj0⟩
  -- The four quantities `A d`, `A b`, and the two finite-place products.
  have hs_raw := NumberField.absNorm_mul_finprod_finitePlace_eq_one (K := F)
      (x := fun _ : Unit => d) (by intro hh; exact hd (congrFun hh Unit.unit))
  have hprod : (∏ᶠ v : NumberField.FinitePlace F, ⨆ _ : Unit, v (d : F)) =
      ∏ᶠ v : NumberField.FinitePlace F, v (d : F) := by
    apply finprod_congr
    intro v
    exact ciSup_const
  have hs_mul : (Ideal.absNorm (Ideal.span ({d} : Set (NumberField.RingOfIntegers F))) : ℝ) *
      (∏ᶠ v : NumberField.FinitePlace F, v (d : F)) = 1 := by
    have hh := hs_raw
    rw [Set.range_const, hprod] at hh
    exact hh
  have hsingle : (∏ᶠ v : NumberField.FinitePlace F, v (d : F)) =
      (Ideal.absNorm (Ideal.span ({d} : Set (NumberField.RingOfIntegers F))) : ℝ)⁻¹ :=
    (inv_eq_of_mul_eq_one_right hs_mul).symm
  have ht_raw := NumberField.absNorm_mul_finprod_finitePlace_eq_one (K := F) (x := b) hbne
  have htuple : (∏ᶠ v : NumberField.FinitePlace F,
        ⨆ j : Fin n, v ((b j : NumberField.RingOfIntegers F) : F)) =
      (Ideal.absNorm (Ideal.span (Set.range b)) : ℝ)⁻¹ :=
    (inv_eq_of_mul_eq_one_right ht_raw).symm
  -- The ideal-theoretic side: `I * (d) = (b)`, and `absNorm` of the latter.
  have h2 := sieg2_spanFinset_mul_spanSingleton a b d hb
  have hJeq := sieg2_spanFinset_integral_eq_coeIdeal (F := F) b
  have hspanSingle : FractionalIdeal.absNorm
        (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers F)) (d : F))
      = (Ideal.absNorm (Ideal.span ({d} : Set (NumberField.RingOfIntegers F))) : ℚ) := by
    rw [← FractionalIdeal.coeIdeal_span_singleton
        (S := nonZeroDivisors (NumberField.RingOfIntegers F)) d,
      FractionalIdeal.coeIdeal_absNorm]
  have hABQ : FractionalIdeal.absNorm
          (FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ a) *
        (Ideal.absNorm (Ideal.span ({d} : Set (NumberField.RingOfIntegers F))) : ℚ)
      = (Ideal.absNorm (Ideal.span (Set.range b)) : ℚ) := by
    have hh := congrArg FractionalIdeal.absNorm h2
    rw [map_mul] at hh
    rw [hJeq, FractionalIdeal.coeIdeal_absNorm, hspanSingle] at hh
    exact hh
  have hABR : ((FractionalIdeal.absNorm
          (FractionalIdeal.spanFinset (NumberField.RingOfIntegers F) Finset.univ a) : ℚ) : ℝ) *
        (Ideal.absNorm (Ideal.span ({d} : Set (NumberField.RingOfIntegers F))) : ℝ)
      = (Ideal.absNorm (Ideal.span (Set.range b)) : ℝ) := by
    have hh := congrArg (fun q : ℚ => (q : ℝ)) hABQ
    simp only [Rat.cast_mul, Rat.cast_natCast] at hh
    exact hh
  have hA0 : (Ideal.absNorm (Ideal.span ({d} : Set (NumberField.RingOfIntegers F))) : ℝ) ≠ 0 := by
    intro hc
    rw [hc, zero_mul] at hs_mul
    exact zero_ne_one hs_mul
  -- Final algebra.
  rw [sieg2_finprod_iSup_scaling a b d hd hkeep hb, hsingle, htuple, inv_inv]
  rw [← hABR, mul_inv_rev, ← mul_assoc, mul_inv_cancel₀ hA0, one_mul]

end Work.BW
