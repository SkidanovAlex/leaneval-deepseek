/-- Start of the descent (BW p. 58: "the hypothesis for J = 0 corresponds to j = 1 in the proposition of §19 with Q^{(0)} = Q"): (9) for all integers `|s| ≤ S` (`Qval_eq_fAt`, `Qdesc_zero`, `ACHyp.hp9`), then `extrap_int_step` with `J = 0`, `j = 0`; and `P = Q^{(0)}(·;0) ≠ 0` (`Qpoly_ne_zero`). Reuses H3's `Qpoly_vanishing_of_hp9` pattern. -/
theorem descent_base {K : Type*} [Field K] [NumberField K] {n r : ℕ} {φ : K →+* ℂ} {α : Fin n → K}
    {b : Fin n → ℤ} {k : Fin n} {c : ℝ} {v : ℕ} {L : Fin r → Fin n → ℤ} {α' : Fin r → K}
    {σ : Fin r → ℝ} {ι : Fin (r - 1) → Fin n}
    {p : AuxIdx r (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) → K}
    (H : ACHyp φ α b k c v L α' σ ι p) :
    QJ φ b k L ι v σ p 0 0 0 0 ≠ 0 ∧
      VanSet (fun i => lamP φ α v L i) (QJ φ b k L ι v σ p 0 0) (ballZ (2 * SJ K r b v 0)) 1 (pxi r * TJ K σ 0) := by
  have hr : 2 ≤ r := H.hr
  -- `BH` supplies the determinations `exp (lamP …) = φ (α' ·)`
  have hexp : ∀ j, Complex.exp (lamP φ α v L j) = φ (α' j) := fun j => (H.hBH.2.2.1 j).2
  constructor
  · -- `Q^{(0)}(·;0) = Qpoly(·;0) ≠ 0` for `p ≠ 0` (BW §12; `Qpoly_ne_zero`)
    have h1 : QJ φ b k L ι v σ p 0 0 0 0
        = Qpoly φ b k L ι α' (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) p 0 0 :=
      Qdesc_zero φ b k L ι α' (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) p 0 0
    rw [h1]
    exact Qpoly_ne_zero φ b k L ι α' (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) p H.hp0
  · -- (9) at level `J = 0`: range `S^{(0)} = S`, orders `T^{(0)} = T`
    have hbase : VanSet (fun i => lamP φ α v L i) (QJ φ b k L ι v σ p 0 0)
        (ballZ (2 ^ (0:ℕ) * SJ K r b v 0)) 1 (pxi r ^ (0:ℕ) * TJ K σ 0) := by
      intro s hs t0 t ht
      simp only [ballZ, Set.mem_setOf_eq] at hs
      rw [show (((s : ℤ) : ℂ) / (((1 : ℕ)) : ℂ)) = ((s : ℤ) : ℂ) by simp]
      have hQJ : QJ φ b k L ι v σ p 0 0 t0 t
          = Qpoly φ b k L ι α' (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) p t0 t :=
        Qdesc_zero φ b k L ι α' (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) p t0 t
      rw [hQJ, ← Qval_eq_fAt φ α b k v L α' ι (acH K b v) (pD0 r (dK K) σ) (pDj r (dK K) σ) p hexp t0 t s]
      refine H.hp9 s ?_ t0 t ?_
      · have hSJ : 2 ^ (0:ℕ) * SJ K r b v 0 = (pS r (dK K) (acH K b v) : ℝ) := by
          simp [SJ, acS]
        have hs' : ((|s| : ℤ) : ℝ) ≤ (pS r (dK K) (acH K b v) : ℝ) := by
          rwa [hSJ] at hs
        exact_mod_cast hs'
      · have hTJ : pxi r ^ (0:ℕ) * TJ K σ 0 = (pT r (dK K) σ : ℝ) := by
          simp [TJ, acT]
        have h2 : ((t0 + ∑ m, t m : ℕ) : ℝ) ≤ (pT r (dK K) σ : ℝ) := by
          rwa [hTJ] at ht
        exact_mod_cast h2
    -- `hnd` at level `0`: `D_j ≥ 1` for every `j` (so in particular for one `j`)
    have hj0 : (0 : ℕ) < r := by omega
    have hnd : ∃ j : Fin r, (2 : ℝ) ^ (0:ℕ) ≤ (pDj r (dK K) σ j : ℝ) := by
      refine ⟨⟨0, hj0⟩, ?_⟩
      have h1 : 1 ≤ pDj r (dK K) σ ⟨0, hj0⟩ := one_le_pDj H ⟨0, hj0⟩
      rw [show (2 : ℝ) ^ (0:ℕ) = 1 by norm_num]
      exact_mod_cast h1
    -- BW §19, `j = 0`: the range doubles and the orders shrink by `ξ`
    have hstep := extrap_int_step H 0 (Nat.zero_le _) hnd 0 0 (by omega) hbase
    simpa using hstep

end Work.BW
