namespace Work.BW

open Complex

set_option maxHeartbeats 800000

/-- Two distinct elements of a basis are `R`-linearly independent as a pair. -/
private lemma basis_pair_independent {ι R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
    (b : Module.Basis ι R M) {i j : ι} (hij : i ≠ j) {a c : R}
    (hac : a • b i + c • b j = 0) : a = 0 ∧ c = 0 := by
  have h := congrArg b.repr hac
  simp only [map_add, map_smul, map_zero, Module.Basis.repr_self] at h
  constructor
  · have h' := congrArg (fun f : ι →₀ R => f i) h
    simpa [Finsupp.single_eq_same, Finsupp.single_eq_of_ne hij, smul_eq_mul] using h'
  · have h' := congrArg (fun f : ι →₀ R => f j) h
    simpa [Finsupp.single_eq_same, Finsupp.single_eq_of_ne (Ne.symm hij), smul_eq_mul] using h'

/-- A `ℤ`-submodule of `ℤ^m` of rank at most two is generated by at most two elements, and the
generators may be chosen so that the second is either `0` or independent from the first. -/
private theorem exists_pair_generators_of_finrank_le_two {m : ℕ}
    (N : Submodule ℤ (Fin m → ℤ)) (hN : Module.finrank ℤ N ≤ 2) :
    ∃ e : Fin 2 → (Fin m → ℤ),
      (∀ y : Fin m → ℤ, y ∈ N ↔ ∃ a b : ℤ, y = a • e 0 + b • e 1) ∧
      (e 0 ≠ 0 → (e 1 = 0 ∨ ∀ a b : ℤ, a • e 0 + b • e 1 = 0 → a = 0 ∧ b = 0)) := by
  classical
  obtain ⟨n, b⟩ := Submodule.basisOfPid (Pi.basisFun ℤ (Fin m)) N
  have hn : n ≤ 2 := by
    have h1 : Module.finrank ℤ N = n := by
      rw [Module.finrank_eq_card_basis b, Fintype.card_fin]
    omega
  have hspan : Submodule.span ℤ (Set.range (fun j : Fin n => (b j : Fin m → ℤ))) = N := by
    have h1 : Set.range (fun j : Fin n => (b j : Fin m → ℤ)) = N.subtype '' (Set.range b) := by
      ext x
      constructor
      · rintro ⟨j, rfl⟩; exact ⟨b j, ⟨j, rfl⟩, rfl⟩
      · rintro ⟨y, ⟨j, rfl⟩, hyx⟩; exact ⟨j, hyx⟩
    rw [h1, ← Submodule.map_span, Module.Basis.span_eq, Submodule.map_subtype_top]
  set e : Fin 2 → (Fin m → ℤ) :=
    fun j => if h : (j : ℕ) < n then (b ⟨(j : ℕ), h⟩ : Fin m → ℤ) else 0 with he
  have he_eq : ∀ (j : Fin 2) (h : (j : ℕ) < n), e j = (b ⟨(j : ℕ), h⟩ : Fin m → ℤ) := by
    intro j h
    change (if h' : (j : ℕ) < n then (b ⟨(j : ℕ), h'⟩ : Fin m → ℤ) else 0)
      = (b ⟨(j : ℕ), h⟩ : Fin m → ℤ)
    rw [dif_pos h]
  have he_eq2 : ∀ (j : Fin 2) (h : 2 ≤ n), e j = (b (Fin.castLE h j) : Fin m → ℤ) := by
    intro j h
    have hj : (j : ℕ) < n := by omega
    rw [he_eq j hj]
    exact congrArg (fun k : Fin n => (b k : Fin m → ℤ)) (Fin.ext (by simp [Fin.val_castLE]))
  have he_mem : ∀ j : Fin 2, e j ∈ N := by
    intro j
    by_cases h : (j : ℕ) < n
    · rw [he_eq j h]; exact (b ⟨(j : ℕ), h⟩).2
    · have h0 : e j = 0 := by rw [he]; dsimp only; rw [dif_neg h]
      rw [h0]; exact N.zero_mem
  have he_span : ∀ j : Fin 2, e j ∈ Submodule.span ℤ ({e 0, e 1} : Set (Fin m → ℤ)) := by
    intro j
    fin_cases j
    · exact Submodule.subset_span (by simp)
    · exact Submodule.subset_span (by simp)
  have hsub : Set.range (fun j : Fin n => (b j : Fin m → ℤ)) ⊆
      Submodule.span ℤ ({e 0, e 1} : Set (Fin m → ℤ)) := by
    rintro x ⟨j, rfl⟩
    dsimp only
    have hbj : (b j : Fin m → ℤ) = e (Fin.castLE hn j) := by
      rw [he]; dsimp only
      rw [Fin.val_castLE, dif_pos j.isLt]
    rw [hbj]
    exact he_span _
  have hspan2 : Submodule.span ℤ ({e 0, e 1} : Set (Fin m → ℤ)) = N := by
    apply le_antisymm
    · rw [Submodule.span_le]
      intro x hx
      rcases hx with hx | hx
      · rw [hx]; exact he_mem 0
      · rw [hx]; exact he_mem 1
    · rw [← hspan]
      exact Submodule.span_le.mpr hsub
  refine ⟨e, ?_, ?_⟩
  · intro y
    rw [← hspan2, Submodule.mem_span_pair]
    constructor <;> rintro ⟨a, c, h⟩ <;> exact ⟨a, c, h.symm⟩
  · intro _
    by_cases h2n : 1 < n
    · right
      have hn2 : 2 ≤ n := by omega
      have hLI : LinearIndependent ℤ (fun i : Fin 2 => b (Fin.castLE hn2 i)) :=
        b.linearIndependent.comp (Fin.castLE hn2) (Fin.castLE_injective hn2)
      intro a c hac
      have hN0 : a • b (Fin.castLE hn2 0) + c • b (Fin.castLE hn2 1) = 0 := by
        apply Subtype.val_injective
        change a • (b (Fin.castLE hn2 0) : Fin m → ℤ) + c • (b (Fin.castLE hn2 1) : Fin m → ℤ) = 0
        rw [← he_eq2 0 hn2, ← he_eq2 1 hn2, hac]
      have h01 : (Fin.castLE hn2 0 : Fin n) ≠ (Fin.castLE hn2 1) := by
        intro hc; have hv := congrArg Fin.val hc; simp at hv
      exact basis_pair_independent b h01 hN0
    · left
      have h0 : e 1 = 0 := by
        rw [he]; dsimp only
        exact dif_neg (show ¬ ((1 : Fin 2) : ℕ) < n by simpa using h2n)
      exact h0

theorem relation_lattice_generating_pair {K : Type*} [Field K] [NumberField K] {m : ℕ}
    (φ : K →+* ℂ) (α : Fin m → K) (hα : ∀ i, α i ≠ 0) (ℓ : Fin m → ℂ)
    (hℓ : ∀ i, Complex.exp (ℓ i) = φ (α i))
    (hdep : ¬ LinearIndependent ℚ ℓ)
    (hmin : ∀ i, LinearIndependent ℚ (fun j : {j : Fin m // j ≠ i} => ℓ j)) :
    ∃ e : Fin 2 → Fin m → ℤ,
      (∀ y : Fin m → ℤ, y ∈ GammaSub α hα ↔ ∃ a b : ℤ, y = a • e 0 + b • e 1) ∧
      (e 0 ≠ 0 → (e 1 = 0 ∨ ∀ a b : ℤ, a • e 0 + b • e 1 = 0 → a = 0 ∧ b = 0)) := by
  classical
  have hW : Module.finrank ℚ (Vrel ℓ) ≤ 2 := relation_lattice_Vrel_finrank_le_two ℓ hdep hmin
  have hfin : Module.finrank ℤ (GammaSub α hα) ≤ 2 := by
    by_contra hcon
    rw [not_le] at hcon
    obtain ⟨n, b⟩ := Submodule.basisOfPid (Pi.basisFun ℤ (Fin m)) (GammaSub α hα)
    have hn : Module.finrank ℤ (GammaSub α hα) = n := by
      rw [Module.finrank_eq_card_basis b, Fintype.card_fin]
    rw [hn] at hcon
    have hLI1 : LinearIndependent ℤ (fun i : Fin 3 => b (Fin.castLE hcon i)) :=
      b.linearIndependent.comp (Fin.castLE hcon) (Fin.castLE_injective hcon)
    have hLI2 : LinearIndependent ℤ
        (fun i : Fin 3 => (b (Fin.castLE hcon i) : Fin m → ℤ)) := by
      have hcomp : ((Submodule.subtype (GammaSub α hα)) ∘ (fun i : Fin 3 => b (Fin.castLE hcon i)))
          = (fun i : Fin 3 => (b (Fin.castLE hcon i) : Fin m → ℤ)) := by
        funext i; rfl
      rw [← hcomp]
      exact hLI1.map (f := Submodule.subtype (GammaSub α hα))
        (by rw [Submodule.ker_subtype]; exact disjoint_bot_right)
    have hLI3 : LinearIndependent ℚ
        (fun i : Fin 3 => fun r => ((b (Fin.castLE hcon i) : Fin m → ℤ) r : ℚ)) :=
      (linearIndependent_algebraMap_comp_iff (R := ℤ) (S := ℚ)).mpr hLI2
    have hmem : ∀ i : Fin 3,
        (fun r => ((b (Fin.castLE hcon i) : Fin m → ℤ) r : ℚ)) ∈ Vrel ℓ := by
      intro i
      exact GammaSub_mem_Vrel φ α hα ℓ hℓ (b (Fin.castLE hcon i)).2
    let u : Fin 3 → (Vrel ℓ) :=
      fun i => ⟨fun r => ((b (Fin.castLE hcon i) : Fin m → ℤ) r : ℚ), hmem i⟩
    have hu : LinearIndependent ℚ u := by
      have hcomp : ((Submodule.subtype (Vrel ℓ)) ∘ u)
          = (fun i : Fin 3 => fun r => ((b (Fin.castLE hcon i) : Fin m → ℤ) r : ℚ)) := by
        funext i r; rfl
      refine LinearIndependent.of_comp (Submodule.subtype (Vrel ℓ)) ?_
      rw [hcomp]
      exact hLI3
    have := LinearIndependent.fintype_card_le_finrank hu
    simp only [Fintype.card_fin] at this
    omega
  obtain ⟨e, he, hind⟩ := exists_pair_generators_of_finrank_le_two (GammaSub α hα) hfin
  exact ⟨e, he, hind⟩

end Work.BW
