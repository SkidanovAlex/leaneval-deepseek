/-
Area A7 of the Gorenstein--Walter project: the `A₇` exceptional case.

This file sets up the vocabulary of the area: the model involution `t = (0 1)(2 3)` of `A₇`,
the subgroups `V₁`, `V₂` and `K = O(C(t))` attached to it, and a few counting lemmas.
-/
import Mathlib

open scoped MatrixGroups

namespace Work.A7

open Equiv Equiv.Perm

/-! ### The model involution -/

/-- The involution `(0 1)(2 3)`, as an element of `Equiv.Perm (Fin 7)`. -/
def a7InvolPerm : Perm (Fin 7) := Equiv.swap 0 1 * Equiv.swap 2 3

/-- The involution `(0 1)(2 3)` of the alternating group `A₇`.  This is the model involution of
the exceptional case of the Gorenstein--Walter theorem: its centralizer in `A₇` has order `24`. -/
def a7Invol : alternatingGroup (Fin 7) :=
  ⟨a7InvolPerm, by
    rw [Equiv.Perm.mem_alternatingGroup, a7InvolPerm, Equiv.Perm.sign_mul,
      Equiv.Perm.sign_swap (by decide), Equiv.Perm.sign_swap (by decide)]
    decide⟩

@[simp]
theorem coe_a7Invol : ((a7Invol : alternatingGroup (Fin 7)) : Perm (Fin 7)) = a7InvolPerm :=
  rfl

/-- The 3-cycle `(4 5 6)`, as an element of `Equiv.Perm (Fin 7)`. -/
def a7ThreeCyclePerm : Perm (Fin 7) := Equiv.swap 4 5 * Equiv.swap 5 6

/-- The 3-cycle `(4 5 6)` of `A₇`.  It generates `K = O(C_{A₇}(t))`. -/
def a7ThreeCycle : alternatingGroup (Fin 7) :=
  ⟨a7ThreeCyclePerm, by
    rw [Equiv.Perm.mem_alternatingGroup, a7ThreeCyclePerm, Equiv.Perm.sign_mul,
      Equiv.Perm.sign_swap (by decide), Equiv.Perm.sign_swap (by decide)]
    decide⟩

@[simp]
theorem coe_a7ThreeCycle :
    ((a7ThreeCycle : alternatingGroup (Fin 7)) : Perm (Fin 7)) = a7ThreeCyclePerm :=
  rfl

/-- The double transposition `(a b)(c d)` of `Equiv.Perm (Fin 7)`. -/
def dswapPerm (a b c d : Fin 7) : Perm (Fin 7) := Equiv.swap a b * Equiv.swap c d

/-- The even permutation `(a b)(c d)` of `A₇`, for `a ≠ b`, `c ≠ d`. -/
def a7Dswap (a b c d : Fin 7) (hab : a ≠ b) (hcd : c ≠ d) : alternatingGroup (Fin 7) :=
  ⟨dswapPerm a b c d, by
    rw [Equiv.Perm.mem_alternatingGroup, dswapPerm, Equiv.Perm.sign_mul,
      Equiv.Perm.sign_swap hab, Equiv.Perm.sign_swap hcd]
    decide⟩

@[simp]
theorem coe_a7Dswap (a b c d : Fin 7) (hab : a ≠ b) (hcd : c ≠ d) :
    ((a7Dswap a b c d hab hcd : alternatingGroup (Fin 7)) : Perm (Fin 7)) = dswapPerm a b c d :=
  rfl

/-! ### The model subgroups `V₁`, `V₂`, `K` -/

/-- `K = O(C_{A₇}(t)) = ⟨(4 5 6)⟩`, the largest normal subgroup of `C_{A₇}(t)` of odd order. -/
def a7K : Subgroup (alternatingGroup (Fin 7)) := Subgroup.zpowers a7ThreeCycle

/-- `V₁ = {1, (0 1)(2 3), (0 2)(1 3), (0 3)(1 2)}`, the Klein four-group of double transpositions
of `{0,1,2,3}` inside `A₇`; it contains `t`. -/
def a7V1 : Subgroup (alternatingGroup (Fin 7)) :=
  Subgroup.closure ({a7Invol, a7Dswap 0 2 1 3 (by decide) (by decide)} : Set _)

/-- `V₂ = {1, (0 1)(2 3), (0 1)(4 5), (2 3)(4 5)}`, the Klein four-group generated by `t` and
`(0 1)(4 5)`; in `A₇` its normalizer is isomorphic to `S₄`. -/
def a7V2 : Subgroup (alternatingGroup (Fin 7)) :=
  Subgroup.closure ({a7Invol, a7Dswap 0 1 4 5 (by decide) (by decide)} : Set _)

/-! ### Counting lemmas -/

/-- To count a subgroup of a finite group it suffices to count the elements of the ambient group
satisfying an equivalent, decidable membership predicate. -/
theorem nat_card_subgroup_eq_filter_card {G : Type*} [Group G] [Fintype G] (K : Subgroup G)
    (P : G → Prop) [DecidablePred P] (h : ∀ x : G, x ∈ K ↔ P x) :
    Nat.card K = (Finset.univ.filter P).card := by
  have hcard : Nat.card ↥K = Nat.card {x : G // P x} :=
    Nat.card_congr (Equiv.subtypeEquivRight h)
  rw [hcard, Nat.card_eq_fintype_card, Fintype.card_subtype]

/-! ### Basic facts -/

/-- `A₇` has `2520` elements. -/
theorem card_alternatingGroup_seven : Nat.card (alternatingGroup (Fin 7)) = 2520 := by
  rw [nat_card_alternatingGroup, Nat.card_fin]
  decide

/-- `A₇` is simple. -/
theorem isSimpleGroup_alternatingGroup_seven : IsSimpleGroup (alternatingGroup (Fin 7)) := by
  apply alternatingGroup.isSimpleGroup
  rw [Nat.card_fin]
  decide

/-- The order of the model involution is `2`. -/
theorem orderOf_a7Invol : orderOf a7Invol = 2 :=
  orderOf_eq_prime (by decide) (by decide)

/-- The model involution is not the identity. -/
theorem a7Invol_ne_one : a7Invol ≠ 1 := by decide

/-- The model involution is an involution. -/
theorem a7Invol_mul_self : a7Invol * a7Invol = 1 := by
  rw [← pow_two, ← orderOf_a7Invol, pow_orderOf_eq_one]

/-- The order of `(4 5 6)` is `3`. -/
theorem orderOf_a7ThreeCycle : orderOf a7ThreeCycle = 3 :=
  orderOf_eq_prime (by decide) (by decide)

/-- `K` has order `3`. -/
theorem card_a7K : Nat.card a7K = 3 := by
  rw [a7K, Nat.card_zpowers, orderOf_a7ThreeCycle]

end Work.A7
