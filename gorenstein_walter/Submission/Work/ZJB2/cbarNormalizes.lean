import Mathlib
import Submission.Work.ZJB2.Defs

/-!
# gorenstein_walter — `ZJB2.cbarNormalizes` (T52.nrm)

Glauberman 1968, in the proof of Theorem 5.2 (p. 1122): `C_G(V̄)` normalizes the subgroup
`C_G(VP) ∩ C_G(V̄)`, where `P = O_p(G)` and `V̄` is the image of `V` in `G/P`.

Everything is elementary group theory; no finiteness of `G` is used.

Write `u = y z y⁻¹` with `y ∈ C_G(V̄)` and `z ∈ C_G(VP) ∩ C_G(V̄)`.

* `u` commutes with every `p ∈ P`: `y⁻¹ p y ∈ P` (as `P ⊴ G`) and `z` centralizes `P`.
* `u` commutes with every `v ∈ V`: from `y ∈ C_G(V̄)` we get `y⁻¹ v y = v p` with `p ∈ P`
  (`exists_mul_of_mem_cbar`), and `z` centralizes both `v` and `p`.

Since the subgroup `V ⊔ P` is generated by `V ∪ P`, `u` centralizes `V ⊔ P`; finally
`C_G(V̄)` is a subgroup containing both `y` and `z`, so `u ∈ C_G(V̄)` as well.
-/

namespace Work.ZJB2

open Subgroup

variable {G : Type*} [Group G]

/-- If `y ∈ C_G(V̄)` (`V̄` the image of `V` in `G/P`), then for every `v ∈ V` there is
`p ∈ P` with `y⁻¹ v y = v p`, i.e. `y⁻¹ v y ∈ vP`. -/
lemma exists_mul_of_mem_cbar (P : Subgroup G) [P.Normal] (V : Subgroup G) {y : G}
    (hy : y ∈ Work.ZJB.Cbar P V) :
    ∀ v ∈ V, ∃ p ∈ P, y⁻¹ * v * y = v * p := by
  intro v hv
  -- `y` commutes with `v` modulo `P`
  have hmem : y⁻¹ * v⁻¹ * y * v ∈ P := by
    rw [Work.ZJB.Cbar, Subgroup.mem_comap] at hy
    have h1 := (Subgroup.mem_centralizer_iff.mp hy) (QuotientGroup.mk' P v)
      (Subgroup.mem_map.mpr ⟨v, hv, rfl⟩)
    have h2 : QuotientGroup.mk' P (v * y) = QuotientGroup.mk' P (y * v) := by
      rw [map_mul, map_mul]; exact h1
    have h3 : (v * y)⁻¹ * (y * v) ∈ P :=
      QuotientGroup.eq.mp (by simpa only [QuotientGroup.mk'_apply] using h2)
    simpa only [mul_inv_rev, inv_inv, mul_assoc] using h3
  refine ⟨(y⁻¹ * v⁻¹ * y * v)⁻¹, P.inv_mem hmem, ?_⟩
  group

/-- `C_G(V̄)` normalizes `C_G(VP) ∩ C_G(V̄)` for `P ⊴ G`, `V ≤ G`. -/
theorem cbar_le_normalizer_centralizer (P : Subgroup G) [P.Normal] (V : Subgroup G) :
    Work.ZJB.Cbar P V ≤ Subgroup.normalizer
      ((Subgroup.centralizer ((V ⊔ P : Subgroup G) : Set G) ⊓
        Work.ZJB.Cbar P V : Subgroup G) : Set G) := by
  rw [Subgroup.le_normalizer_iff]
  intro y hy z hz
  have hzC : z ∈ Subgroup.centralizer ((V ⊔ P : Subgroup G) : Set G) := hz.1
  have hzB : z ∈ Work.ZJB.Cbar P V := hz.2
  -- `z` centralizes `P` and `V`
  have hzP : ∀ p ∈ P, p * z = z * p := fun p hp =>
    (Subgroup.mem_centralizer_iff.mp hzC) p (Subgroup.mem_sup_right hp)
  have hzV : ∀ v ∈ V, v * z = z * v := fun v hv =>
    (Subgroup.mem_centralizer_iff.mp hzC) v (Subgroup.mem_sup_left hv)
  -- `u = y z y⁻¹` commutes with `P`
  have hF1 : ∀ p ∈ P, (y * z * y⁻¹) * p = p * (y * z * y⁻¹) := by
    intro p hp
    have hq : y⁻¹ * p * y ∈ P := Subgroup.Normal.conj_mem' inferInstance p hp y
    have hzq : z * (y⁻¹ * p * y) = (y⁻¹ * p * y) * z :=
      ((Subgroup.mem_centralizer_iff.mp hzC) (y⁻¹ * p * y) (Subgroup.mem_sup_right hq)).symm
    calc (y * z * y⁻¹) * p = y * z * (y⁻¹ * p * y) * y⁻¹ := by group
      _ = y * (z * (y⁻¹ * p * y)) * y⁻¹ := by group
      _ = y * ((y⁻¹ * p * y) * z) * y⁻¹ := by rw [hzq]
      _ = p * (y * z * y⁻¹) := by group
  -- `u = y z y⁻¹` commutes with `V`
  have hF2 : ∀ v ∈ V, (y * z * y⁻¹) * v = v * (y * z * y⁻¹) := by
    intro v hv
    obtain ⟨p, hp, hpe⟩ := exists_mul_of_mem_cbar P V hy v hv
    have hzq : z * (y⁻¹ * v * y) = (y⁻¹ * v * y) * z := by
      calc z * (y⁻¹ * v * y) = z * (v * p) := by rw [hpe]
        _ = (z * v) * p := (mul_assoc z v p).symm
        _ = (v * z) * p := by rw [← hzV v hv]
        _ = v * (z * p) := mul_assoc v z p
        _ = v * (p * z) := by rw [← hzP p hp]
        _ = (v * p) * z := (mul_assoc v p z).symm
        _ = (y⁻¹ * v * y) * z := by rw [hpe]
    calc (y * z * y⁻¹) * v = y * z * (y⁻¹ * v * y) * y⁻¹ := by group
      _ = y * (z * (y⁻¹ * v * y)) * y⁻¹ := by group
      _ = y * ((y⁻¹ * v * y) * z) * y⁻¹ := by rw [hzq]
      _ = v * (y * z * y⁻¹) := by group
  refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
  · -- `y z y⁻¹` centralizes `V ⊔ P`
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    have hh' : h ∈ P ⊔ V := by
      have := hh
      rw [sup_comm] at this
      simpa only [SetLike.mem_coe] using this
    obtain ⟨p, hp, v, hv, hpv⟩ := Subgroup.mem_sup_of_normal_left.mp hh'
    rw [← hpv]
    calc (p * v) * (y * z * y⁻¹) = p * (v * (y * z * y⁻¹)) := mul_assoc p v _
      _ = p * ((y * z * y⁻¹) * v) := by rw [← hF2 v hv]
      _ = (p * (y * z * y⁻¹)) * v := (mul_assoc p _ v).symm
      _ = ((y * z * y⁻¹) * p) * v := by rw [← hF1 p hp]
      _ = (y * z * y⁻¹) * (p * v) := mul_assoc _ p v
  · -- `y z y⁻¹ ∈ C_G(V̄)` since `C_G(V̄)` is a subgroup
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hy hzB) (Subgroup.inv_mem _ hy)

theorem cbarNormalizes (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Finite G] : Work.ZJB.CbarNormalizesProp p G := by
  intro V
  exact cbar_le_normalizer_centralizer (Work.GW2.pCore p G) V

end Work.ZJB2
