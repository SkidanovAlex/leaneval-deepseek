import Mathlib
import Submission.Work.ZJB.Step1.Defs
import Submission.Work.ZJB.ThompsonWeakClosed
import Submission.Work.ZJB2.Step1.thompsonJEqOfLeProp
import Submission.Work.ZJB2.Step1.exists_mem_inv_mul_mem_of_isSylowIn
import Submission.Work.ZJB2.Step1.sylowInInfNormal
import Submission.Work.ZJB2.Step1.exists_isSylowIn_of_le
import Submission.Work.ZJB2.Step1.normalizer_le_normalizer_centralizer

set_option maxHeartbeats 4000000

/-!
# ZJB2, step (I), claim A (Glauberman 1968, Theorem 5.1, p. 1117–1118)

`Work.ZJB.ClaimAProp p G` is the "Burnside's argument" step of the proof of step (I) of
Glauberman's Theorem 5.1 (`REFS/vision/glauberman1968_zj/p0017.md`, p. 1117 foot):

> Let `A` be a subgroup of `N(D) ∩ S₁` that contains `D = N(J(S)) ∩ S₁`.  Suppose that
> `Z(S)^a ⊆ Z(J)` for every `a ∈ A`.  ... If `D ⊂ A` then ... `Z(S) ⊆ Z(J(S₁))`, which is
> false.  Hence `A = D`.

Here `D = Dsub S S₁ = N_G(J(S)) ⊓ S₁` and `S₁` is a *bad* Sylow subgroup with `Z(S) ≤ S₁`,
`Z(S) ≰ Z(J(S₁))`, chosen so that `|D|` is maximal (`MaxBad`).

## The argument

Write `J = J(S)`, `Z = Z(S)`.  Assume `D ⊊ A`; we derive a contradiction.

* `V := ⟨Z^a : a ∈ A⟩ ≤ Z(J(S))` is normalized by `A` (conjugation by `a ∈ A` sends the
  generator `Z^b` to `Z^(b a⁻¹)`), and `J ≤ C_G(V)` since `V ≤ Z(J(S)) ≤ C_G(J(S))`.
* `S*` is a Sylow `p`-subgroup of `N_G(V)` containing `A`; `S* ⊓ C_G(V)` is a Sylow
  `p`-subgroup of `C_G(V)` (a Sylow meets a normal subgroup in a Sylow).  As `J ≤ C_G(V)` is
  a `p`-subgroup, some `c ∈ C_G(V)` has `J ≤ (S* ⊓ C_G(V))^c ⊆ (S*)^c`.
* `J((S*)^c) = J` (F1, `thompsonJEqOfLeProp`), so `(S*)^c ≤ N_G(J)`; therefore
  `A^c ≤ (S*)^c ≤ N_G(J)`, and since `c` centralizes `Z ≤ V` also `Z^c = Z ≤ (S₁)^c`.
  Hence `Z ≤ (S₁)^c` and `|Dsub S (S₁)^c| ≥ |A^c| = |A| > |D|`.
* The maximality clause of `MaxBad` applied to the Sylow `(S₁)^c` gives
  `Z ≤ Z(J((S₁)^c))`; conjugating back by `c⁻¹` (using `ZJ_map_conj` and `Z^c = Z`) gives
  `Z ≤ Z(J(S₁))`, contradicting the badness of `S₁`.

Hence `¬ (|D| < |A|)`; with `D ≤ A` this is `|A| = |D|`, so `A = D`.

## Auxiliary lemmas

The general Sylow facts used here are proved in (and imported from)
`ZJB2/Step1/sylowInInfNormal`, `ZJB2/Step1/exists_isSylowIn_of_le` and
`ZJB2/Step1/normalizer_le_normalizer_centralizer`; `le_normalizer_thompsonJ`,
`pconj_map_conj'`, `pconj_one` and `card_le_card_of_le` are the small local tools.
-/

namespace Work.ZJB2.Step1

open Work.ZJB
open Subgroup

variable {G : Type*} [Group G]

/-- `P ≤ N_G(J(P))`: the Thompson subgroup `J(P)` is characteristic in `P`. -/
theorem le_normalizer_thompsonJ (P : Subgroup G) :
    P ≤ Subgroup.normalizer (Work.GW2.thompsonJ P : Set G) := by
  intro x hx
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  exact Work.GW2.thompsonJ_map_conj_eq_of_mem_normalizer (Subgroup.le_normalizer hx)

/-- A conjugate of a conjugate: `(X^a)^b = X^(a·b⁻¹)` in the paper's convention
(`X^a = a⁻¹Xa`).  Since `pconj X a = X.map (conj a⁻¹)`, this is `pconj_map_conj`. -/
theorem pconj_map_conj' (X : Subgroup G) (a b : G) :
    (pconj X a).map (MulAut.conj b).toMonoidHom = pconj X (a * b⁻¹) := by
  have h := pconj_map_conj X b⁻¹ a⁻¹
  simpa only [pconj, inv_inv] using h

/-- `X^1 = X`. -/
theorem pconj_one (X : Subgroup G) : pconj X (1 : G) = X := by
  apply le_antisymm
  · intro x hx
    rw [mem_pconj] at hx
    simpa using hx
  · intro x hx
    rw [mem_pconj]
    simpa using hx

/-- Monotonicity of `Nat.card` on subgroups (a convenience for the cardinality comparisons
below). -/
theorem card_le_card_of_le {H K : Subgroup G} [Finite ↥K] (h : H ≤ K) :
    Nat.card ↥H ≤ Nat.card ↥K :=
  Nat.card_le_card_of_injective (fun x : ↥H => (⟨(x : G), h x.2⟩ : ↥K))
    (fun _ _ hxy => Subtype.ext (congrArg (fun z : ↥K => (z : G)) hxy))

/-- **Claim A of step (I)** (Glauberman 1968, p. 1117–1118, "Burnside's argument"). -/
theorem claimAProp {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime] :
    Work.ZJB.ClaimAProp p G := by
  intro S S₁ hMB A hDA hAN hZA
  obtain ⟨hZ_S₁, hbad, hmax⟩ := hMB
  -- `A` is a `p`-subgroup of `S₁` normalizing `D`
  have hAS₁ : A ≤ (S₁ : Subgroup G) := fun a ha => (Subgroup.mem_inf.mp (hAN ha)).2
  have hAN' : A ≤ Subgroup.normalizer (Work.ZJB.Dsub S S₁ : Set G) :=
    fun a ha => (Subgroup.mem_inf.mp (hAN ha)).1
  have hAp : IsPGroup p A := S₁.isPGroup'.to_le hAS₁
  -- It suffices to know `|A| ≤ |D|`: the aim is to contradict `|D| < |A|`.
  have hcardA : Nat.card ↥A ≤ Nat.card ↥(Work.ZJB.Dsub S S₁) := by
    by_contra hcon
    have hlt : Nat.card ↥(Work.ZJB.Dsub S S₁) < Nat.card ↥A := Nat.lt_of_not_le hcon
    -- The subgroup `V` generated by the conjugates `Z(S)^a`, `a ∈ A`.
    set V : Subgroup G := ⨆ a : A, pconj (Work.ZJB.ZS (S : Subgroup G)) (a : G) with hV
    have hZ_le_V : Work.ZJB.ZS (S : Subgroup G) ≤ V := by
      rw [hV]
      refine (le_of_eq (pconj_one (Work.ZJB.ZS (S : Subgroup G))).symm).trans ?_
      exact le_iSup (fun a : A => pconj (Work.ZJB.ZS (S : Subgroup G)) (a : G)) (1 : A)
    have hV_le_ZJ : V ≤ Work.GW2.ZJ (S : Subgroup G) := by
      rw [hV]
      exact iSup_le fun a => hZA (a : G) a.2
    -- `J(S) ≤ C(V)`
    have hJ_le_CV : Work.GW2.thompsonJ (S : Subgroup G) ≤
        Subgroup.centralizer (V : Set G) := by
      intro j hj
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      exact ((Subgroup.mem_centralizer_iff.mp
        ((Work.GW2.ZJ_le_centralizer (S : Subgroup G)) (hV_le_ZJ hv))) j hj).symm
    -- `A ≤ N(V)`: `A` permutes the family `(Z(S)^a)_{a ∈ A}`
    have hA_NV : A ≤ Subgroup.normalizer (V : Set G) := by
      have hmap_le : ∀ g ∈ A, V.map (MulAut.conj g).toMonoidHom ≤ V := by
        intro g hg
        rw [hV, Subgroup.map_iSup]
        refine iSup_le fun a => ?_
        rw [pconj_map_conj' (Work.ZJB.ZS (S : Subgroup G)) (a : G) g]
        exact le_iSup (fun b : A => pconj (Work.ZJB.ZS (S : Subgroup G)) (b : G))
          (a * ⟨g⁻¹, A.inv_mem hg⟩)
      intro g hg
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      exact Subgroup.eq_of_le_of_card_ge (hmap_le g hg)
        (le_of_eq (Subgroup.card_map_of_injective (f := (MulAut.conj g).toMonoidHom)
          (MulAut.conj g).injective).symm)
    -- a Sylow `p`-subgroup `S*` of `N(V)` containing `A`
    obtain ⟨Sstar, hSstarSyl, hA_Sstar⟩ := exists_isSylowIn_of_le hA_NV hAp
    have hCV_le_NV : Subgroup.centralizer (V : Set G) ≤
        Subgroup.normalizer (V : Set G) :=
      Subgroup.centralizer_le_normalizer (V : Set G)
    have hT'syl : Work.ZJB.IsSylowIn p (Sstar ⊓ Subgroup.centralizer (V : Set G))
        (Subgroup.centralizer (V : Set G)) :=
      sylowInInfNormal hSstarSyl hCV_le_NV (normalizer_le_normalizer_centralizer V)
    have hJp : IsPGroup p ↥(Work.GW2.thompsonJ (S : Subgroup G)) :=
      S.isPGroup'.to_le (Work.GW2.thompsonJ_le (S : Subgroup G))
    -- some `c ∈ C(V)` conjugates `J(S)` into `(S* ∩ C(V))^c ⊆ (S*)^c`
    obtain ⟨m, hmC, hm⟩ := exists_mem_inv_mul_mem_of_isSylowIn hT'syl hJ_le_CV hJp
    have hJ_le_T'c : Work.GW2.thompsonJ (S : Subgroup G) ≤
        (Sstar ⊓ Subgroup.centralizer (V : Set G)).map (MulAut.conj m).toMonoidHom := by
      intro j hj
      refine Subgroup.mem_map.mpr ⟨m⁻¹ * j * m, hm j hj, ?_⟩
      show (MulAut.conj m) (m⁻¹ * j * m) = j
      rw [MulAut.conj_apply]; group
    have hQp : IsPGroup p ↥(Sstar.map (MulAut.conj m).toMonoidHom) :=
      hSstarSyl.2.1.map _
    have hJ_le_Q : Work.GW2.thompsonJ (S : Subgroup G) ≤
        Sstar.map (MulAut.conj m).toMonoidHom :=
      hJ_le_T'c.trans (Subgroup.map_mono inf_le_left)
    have hJmap : Work.GW2.thompsonJ (Sstar.map (MulAut.conj m).toMonoidHom) =
        Work.GW2.thompsonJ (S : Subgroup G) :=
      (thompsonJEqOfLeProp (p := p) (G := G)) S _ hQp hJ_le_Q
    have hSstarN : Sstar.map (MulAut.conj m).toMonoidHom ≤
        Subgroup.normalizer (Work.GW2.thompsonJ (S : Subgroup G) : Set G) := by
      rw [← hJmap]
      exact le_normalizer_thompsonJ _
    -- `S₂ = (S₁)^m` is a Sylow with `Z(S) ≤ S₂` and `|N(J) ∩ S₂| ≥ |A|`
    let S₂ : Sylow p G := m • S₁
    have hS₂coe : (S₂ : Subgroup G) = (S₁ : Subgroup G).map (MulAut.conj m).toMonoidHom := by
      show ((m • S₁ : Sylow p G) : Subgroup G) = _
      rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
      rfl
    have hA_D2 : A.map (MulAut.conj m).toMonoidHom ≤ Work.ZJB.Dsub S S₂ := by
      refine le_inf ?_ ?_
      · exact (Subgroup.map_mono (f := (MulAut.conj m).toMonoidHom) hA_Sstar).trans hSstarN
      · rw [hS₂coe]
        exact Subgroup.map_mono hAS₁
    have hcard_le : Nat.card ↥A ≤ Nat.card ↥(Work.ZJB.Dsub S S₂) :=
      calc Nat.card ↥A = Nat.card ↥(A.map (MulAut.conj m).toMonoidHom) :=
            (Subgroup.card_map_of_injective (f := (MulAut.conj m).toMonoidHom)
              (MulAut.conj m).injective).symm
        _ ≤ Nat.card ↥(Work.ZJB.Dsub S S₂) := card_le_card_of_le hA_D2
    have hlt₂ : Nat.card ↥(Work.ZJB.Dsub S S₁) < Nat.card ↥(Work.ZJB.Dsub S S₂) :=
      lt_of_lt_of_le hlt hcard_le
    -- `m` centralizes `Z(S)`
    have hmz (z : G) (hz : z ∈ Work.ZJB.ZS (S : Subgroup G)) : z * m = m * z :=
      Subgroup.mem_centralizer_iff.mp hmC z (hZ_le_V hz)
    have hm_central (z : G) (hz : z ∈ Work.ZJB.ZS (S : Subgroup G)) : m * z * m⁻¹ = z := by
      rw [← hmz z hz]; group
    have hm_central' (z : G) (hz : z ∈ Work.ZJB.ZS (S : Subgroup G)) : m⁻¹ * z * m = z := by
      calc m⁻¹ * z * m = m⁻¹ * (z * m) := by group
        _ = m⁻¹ * (m * z) := by rw [hmz z hz]
        _ = z := by group
    have hZ_fix : (Work.ZJB.ZS (S : Subgroup G)).map (MulAut.conj m).toMonoidHom =
        Work.ZJB.ZS (S : Subgroup G) := by
      apply le_antisymm
      · rintro x ⟨z, hz, hx⟩
        rw [← hx]
        show (MulAut.conj m) z ∈ Work.ZJB.ZS (S : Subgroup G)
        rw [MulAut.conj_apply, hm_central z hz]
        exact hz
      · intro z hz
        refine Subgroup.mem_map.mpr ⟨z, hz, ?_⟩
        show (MulAut.conj m) z = z
        rw [MulAut.conj_apply, hm_central z hz]
    have hZ_fix' : (Work.ZJB.ZS (S : Subgroup G)).map (MulAut.conj m⁻¹).toMonoidHom =
        Work.ZJB.ZS (S : Subgroup G) := by
      apply le_antisymm
      · rintro x ⟨z, hz, hx⟩
        rw [← hx]
        show (MulAut.conj m⁻¹) z ∈ Work.ZJB.ZS (S : Subgroup G)
        rw [MulAut.conj_apply, inv_inv, hm_central' z hz]
        exact hz
      · intro z hz
        refine Subgroup.mem_map.mpr ⟨z, hz, ?_⟩
        show (MulAut.conj m⁻¹) z = z
        rw [MulAut.conj_apply, inv_inv, hm_central' z hz]
    have hZ_S₂ : Work.ZJB.ZS (S : Subgroup G) ≤ (S₂ : Subgroup G) := by
      rw [hS₂coe, ← hZ_fix]
      exact Subgroup.map_mono hZ_S₁
    have hgood : Work.ZJB.ZS (S : Subgroup G) ≤ Work.GW2.ZJ (S₂ : Subgroup G) :=
      hmax S₂ hZ_S₂ hlt₂
    have hZJmap : Work.GW2.ZJ ((S₂ : Subgroup G).map (MulAut.conj m⁻¹).toMonoidHom) =
        (Work.GW2.ZJ (S₂ : Subgroup G)).map (MulAut.conj m⁻¹).toMonoidHom :=
      Work.ZJB.ZJ_map_conj (S₂ : Subgroup G) m⁻¹
    have hS₂back : (S₂ : Subgroup G).map (MulAut.conj m⁻¹).toMonoidHom =
        (S₁ : Subgroup G) := by
      rw [hS₂coe, Subgroup.map_map]
      have hcomp : (MulAut.conj m⁻¹).toMonoidHom.comp (MulAut.conj m).toMonoidHom =
          MonoidHom.id G := by
        ext x
        simp only [MonoidHom.comp_apply, MonoidHom.id_apply, MulEquiv.coe_toMonoidHom,
          MulAut.conj_apply, inv_inv]
        group
      rw [hcomp, Subgroup.map_id]
    have hZJback : (Work.GW2.ZJ (S₂ : Subgroup G)).map (MulAut.conj m⁻¹).toMonoidHom =
        Work.GW2.ZJ (S₁ : Subgroup G) := by
      rw [← hZJmap, hS₂back]
    exact absurd (by
      have h := Subgroup.map_mono (f := (MulAut.conj m⁻¹).toMonoidHom) hgood
      rw [hZJback, hZ_fix'] at h
      exact h) hbad
  exact (Subgroup.eq_of_le_of_card_ge hDA hcardA).symm

end Work.ZJB2.Step1
