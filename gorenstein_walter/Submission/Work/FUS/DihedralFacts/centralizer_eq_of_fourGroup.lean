import Mathlib
import Submission.Work.FUS.Defs
import Submission.Work.Dihedral.Defs
import Submission.Work.FUS.DihedralFacts.fourGroup_center_mem

namespace Work.FUS.DihedralFacts

/-- A subgroup of order `4` all of whose elements are involutions is abelian: for `a, b ∈ V` we have
`(a * b) ^ 2 = 1`, whence `a * b = (a * b)⁻¹ = b⁻¹ * a⁻¹ = b * a`. -/
private lemma comm_of_mem_fourGroup {n : ℕ} {V : Subgroup (DihedralGroup n)}
    (hV : Work.GW2.IsFourGroup V) {a b : DihedralGroup n} (ha : a ∈ V) (hb : b ∈ V) :
    a * b = b * a := by
  have ha2 : a * a = 1 := by simpa [sq] using hV.2 a ha
  have hb2 : b * b = 1 := by simpa [sq] using hV.2 b hb
  have hab2 : (a * b) * (a * b) = 1 := by simpa [sq] using hV.2 (a * b) (V.mul_mem ha hb)
  calc a * b = (a * b)⁻¹ := (inv_eq_of_mul_eq_one_right hab2).symm
    _ = b⁻¹ * a⁻¹ := mul_inv_rev a b
    _ = b * a := by rw [inv_eq_of_mul_eq_one_right hb2, inv_eq_of_mul_eq_one_right ha2]

/-- In `DihedralGroup n` (`n` even, `n ≥ 4`) the centralizer of a reflection `sr i` is exactly the
four-group `{1, r (n/2), sr i, sr (i + n/2)}`. Consequently, if `V` is any four-group containing
`sr i` (whence also `r (n/2)`, by `fourGroup_center_mem`), then `C(sr i) = V`.

This is the shape of the "involution centralizer" computation used in the Gorenstein–Walter proof:
the reflections of `DihedralGroup n` split into two classes under conjugation by the rotation
subgroup, and the centralizer of a reflection is the four-group generated by it and the central
involution. -/
theorem centralizer_eq_of_fourGroup (n : ℕ) [NeZero n] (hn : 4 ≤ n) (V : Subgroup (DihedralGroup n))
    (hV : Work.GW2.IsFourGroup V) (u : DihedralGroup n) (hu : u ∈ V) (hu1 : u ≠ 1)
    (hu2 : u ≠ DihedralGroup.r ((n / 2 : ℕ) : ZMod n)) :
    Subgroup.centralizer ({u} : Set (DihedralGroup n)) = V := by
  classical
  -- `|V| = 4` divides `|DihedralGroup n| = 2 * n`, so `n` is even.
  have heven : Even n := by
    have hdvd : 4 ∣ 2 * n := by
      have h := Subgroup.card_subgroup_dvd_card V
      rwa [hV.1, DihedralGroup.nat_card] at h
    obtain ⟨k, hk⟩ := hdvd
    exact ⟨k, by omega⟩
  -- The central rotation `c = r (n/2)` lies in `V`.
  have hcV : DihedralGroup.r ((n / 2 : ℕ) : ZMod n) ∈ V := fourGroup_center_mem n hn V hV
  -- `u` is a reflection: `u ∈ V`, `u ^ 2 = 1`, `u ≠ 1`, `u ≠ c`.
  obtain ⟨i, rfl⟩ : ∃ i : ZMod n, u = DihedralGroup.sr i := by
    rcases Work.Dihedral.eq_r_or_sr u with ⟨j, hj⟩ | h
    · exfalso
      have hmem : u ∈ Work.Dihedral.rot n := by rw [hj]; exact Work.Dihedral.r_mem_rot j
      rcases rot_involution_eq n heven hmem (hV.2 u hu) with h | h
      · exact hu1 h
      · exact hu2 h
    · exact h
  refine le_antisymm ?_ ?_
  · -- The centralizer of the reflection `sr i` is contained in `V`.
    intro x hx
    rw [Subgroup.mem_centralizer_iff] at hx
    have hxu : DihedralGroup.sr i * x = x * DihedralGroup.sr i :=
      hx (DihedralGroup.sr i) (Set.mem_singleton _)
    rcases Work.Dihedral.eq_r_or_sr x with ⟨j, rfl⟩ | ⟨k, rfl⟩
    · -- `x = r j`: commutation forces `r j * sr i = sr i * r j`, i.e. `j = -j`
      have h1 : (i : ZMod n) + j = i - j := by
        have : DihedralGroup.sr (i + j) = DihedralGroup.sr (i - j) := by
          simpa [DihedralGroup.sr_mul_r, DihedralGroup.r_mul_sr] using hxu
        exact DihedralGroup.sr.inj this
      have h2 : j = -j := by
        rw [sub_eq_add_neg] at h1
        exact add_left_cancel h1
      rcases (ZMod.neg_eq_self_iff j).mp h2.symm with hj0 | hj2
      · rw [hj0, DihedralGroup.r_zero]; exact V.one_mem
      · have hjval : j.val = n / 2 := by obtain ⟨m, hm⟩ := heven; omega
        rw [← ZMod.natCast_zmod_val j, hjval]
        exact hcV
    · -- `x = sr k`: commutation forces `sr k * sr i = sr i * sr k`, i.e. `k - i = i - k`
      have h0 : k - i = i - k := by
        have : DihedralGroup.r (k - i) = DihedralGroup.r (i - k) := by
          simpa [DihedralGroup.sr_mul_sr] using hxu
        exact DihedralGroup.r.inj this
      have h1 : k - i = -(k - i) := by
        have hneg : -(k - i) = -(i - k) := congrArg (fun t : ZMod n => -t) h0
        rw [neg_sub i k] at hneg
        exact hneg.symm
      rcases (ZMod.neg_eq_self_iff (k - i)).mp h1.symm with hki0 | hki2
      · -- `k = i`, so `x = sr i = u ∈ V`
        have hki : k = i := sub_eq_zero.mp hki0
        rw [hki]
        exact hu
      · -- `k - i = n/2`, so `x = sr k = sr i * r (n/2) ∈ V`
        have hval : (k - i).val = n / 2 := by obtain ⟨m, hm⟩ := heven; omega
        have hki : k = i + ((n / 2 : ℕ) : ZMod n) := by
          have hsub : k - i = ((n / 2 : ℕ) : ZMod n) := by
            rw [← ZMod.natCast_zmod_val (k - i), hval]
          rw [← hsub]
          ring
        have hsr : DihedralGroup.sr k =
            DihedralGroup.sr i * DihedralGroup.r ((n / 2 : ℕ) : ZMod n) := by
          rw [hki, ← DihedralGroup.sr_mul_r]
        rw [hsr]
        exact V.mul_mem hu hcV
  · -- `V` is abelian, hence it centralizes `u = sr i`.
    intro v hv
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    rw [hh]
    exact (comm_of_mem_fourGroup hV hv hu).symm

end Work.FUS.DihedralFacts
