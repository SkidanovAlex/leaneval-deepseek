import Mathlib
import Submission.Work.FUS.Defs
import Submission.Work.Dihedral.Defs

set_option linter.unusedVariables false

namespace Work.FUS.DihedralFacts

/-- In `DihedralGroup n` with `n` even, the only involutions of the rotation subgroup `⟨r⟩` are the
identity and the central rotation `r (n/2)`. Equivalently, `r (n/2)` is the unique element of order
two of `⟨r⟩ ≅ ZMod n`. -/
lemma rot_involution_eq (n : ℕ) [NeZero n] (heven : Even n) {x : DihedralGroup n}
    (hx : x ∈ Work.Dihedral.rot n) (hx2 : x ^ 2 = 1) :
    x = 1 ∨ x = DihedralGroup.r ((n / 2 : ℕ) : ZMod n) := by
  obtain ⟨i, rfl⟩ := Work.Dihedral.mem_rot.mp hx
  -- `(r i)² = 1` forces `2 i = 0` in `ZMod n`.
  have hi2 : i * 2 = 0 := by
    have h : DihedralGroup.r (i * 2) = DihedralGroup.r (0 : ZMod n) := by
      simpa using hx2
    exact DihedralGroup.r.inj h
  have hsum : i + i = 0 := by
    have := hi2
    rwa [mul_two] at this
  have hnegi : -i = i := (neg_eq_iff_add_eq_zero (a := i) (b := i)).mpr hsum
  rcases (ZMod.neg_eq_self_iff i).mp hnegi with h | h
  · left; rw [h]; exact DihedralGroup.r_zero
  · right
    have hval : i.val = n / 2 := by
      obtain ⟨k, hk⟩ := heven
      omega
    rw [← ZMod.natCast_zmod_val i, hval]

/-- The center of a four-group `V ≤ DihedralGroup n` (for `4 ≤ n`) is generated by the central
rotation `r (n/2)`; in particular that rotation lies in `V`.

Proof: every element of `V` is an involution. If `n` is odd then `|V| = 4` would divide
`|DihedralGroup n| = 2n`, which is impossible. So `n` is even and `⟨r⟩` has a unique involution
`c = r (n/2)`. Take two distinct non-identity elements `u, v ∈ V`. If `u ∈ ⟨r⟩` then `u = c` by
`rot_involution_eq`; otherwise `u = sr i`. If `v ∈ ⟨r⟩` then `v = c`; otherwise `v = sr j` and
`u * v = r (j - i) ∈ V` is a non-identity involution of `⟨r⟩`, hence equal to `c`. -/
theorem fourGroup_center_mem (n : ℕ) [NeZero n] (hn : 4 ≤ n) (V : Subgroup (DihedralGroup n))
    (hV : Work.GW2.IsFourGroup V) : DihedralGroup.r ((n / 2 : ℕ) : ZMod n) ∈ V := by
  classical
  by_cases heven : Even n
  · have hV2 : ∀ v ∈ V, v ^ 2 = 1 := hV.2
    have hcardV : Fintype.card V = 4 := by
      rw [← Nat.card_eq_fintype_card]; exact hV.1
    -- `V` has at least two distinct non-identity elements.
    have hs : ((Finset.univ : Finset V).erase 1).card = 3 := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ (1 : V)), Finset.card_univ, hcardV]
    obtain ⟨u, hu, v, hv, huv⟩ :=
      Finset.one_lt_card.mp (by rw [hs]; norm_num : 1 < ((Finset.univ : Finset V).erase 1).card)
    have hu1 : u ≠ 1 := (Finset.mem_erase.mp hu).1
    have hv1 : v ≠ 1 := (Finset.mem_erase.mp hv).1
    have hu' : (u : DihedralGroup n) ≠ 1 := by intro h; exact hu1 (Subtype.ext h)
    have hv' : (v : DihedralGroup n) ≠ 1 := by intro h; exact hv1 (Subtype.ext h)
    have huv' : (u : DihedralGroup n) ≠ (v : DihedralGroup n) := by
      intro h; exact huv (Subtype.ext h)
    by_cases hru : (u : DihedralGroup n) ∈ Work.Dihedral.rot n
    · rcases rot_involution_eq n heven hru (hV2 _ u.2) with h | h
      · exact absurd h hu'
      · rw [← h]; exact u.2
    · obtain ⟨i, hi⟩ := Work.Dihedral.notMem_rot.mp hru
      by_cases hrv : (v : DihedralGroup n) ∈ Work.Dihedral.rot n
      · rcases rot_involution_eq n heven hrv (hV2 _ v.2) with h | h
        · exact absurd h hv'
        · rw [← h]; exact v.2
      · obtain ⟨j, hj⟩ := Work.Dihedral.notMem_rot.mp hrv
        have hmem : (u : DihedralGroup n) * (v : DihedralGroup n) ∈ V := V.mul_mem u.2 v.2
        -- the product of two distinct reflections is a non-trivial rotation
        have hrot : (u : DihedralGroup n) * (v : DihedralGroup n) ∈ Work.Dihedral.rot n := by
          rw [hi, hj]
          simp
        have hsq : ((u : DihedralGroup n) * (v : DihedralGroup n)) ^ 2 = 1 := hV2 _ hmem
        have hne1 : (u : DihedralGroup n) * (v : DihedralGroup n) ≠ 1 := by
          intro hcon
          have huu : (u : DihedralGroup n) * (u : DihedralGroup n) = 1 := by
            simpa [sq] using hV2 (u : DihedralGroup n) u.2
          have : (v : DihedralGroup n) = (u : DihedralGroup n) := by
            calc (v : DihedralGroup n) = 1 * (v : DihedralGroup n) := (one_mul _).symm
              _ = ((u : DihedralGroup n) * (u : DihedralGroup n)) * (v : DihedralGroup n) := by
                    rw [huu]
              _ = (u : DihedralGroup n) * ((u : DihedralGroup n) * (v : DihedralGroup n)) := by
                    rw [mul_assoc]
              _ = (u : DihedralGroup n) * 1 := by rw [hcon]
              _ = (u : DihedralGroup n) := mul_one _
          exact huv' this.symm
        rcases rot_involution_eq n heven hrot hsq with h | h
        · exact absurd h hne1
        · rw [← h]; exact hmem
  · -- `n` odd: no subgroup of order `4` exists in `DihedralGroup n`.
    exfalso
    have hodd : Odd n := Nat.not_even_iff_odd.mp heven
    have hdvd : 4 ∣ 2 * n := by
      have := Subgroup.card_subgroup_dvd_card V
      rwa [hV.1, DihedralGroup.nat_card] at this
    obtain ⟨j, hj⟩ := hdvd
    obtain ⟨k, hk⟩ := hodd
    omega

end Work.FUS.DihedralFacts
