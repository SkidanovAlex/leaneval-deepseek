import Mathlib

namespace Work.CORE3

/-- In a group, if `w` has order `3`, then every element of the cyclic subgroup `⟨w⟩` is one of
`1`, `w`, `w ^ 2`. -/
lemma mem_zpowers_of_orderOf_three {G : Type*} [Group G] {w z : G} (hw : orderOf w = 3)
    (hz : z ∈ Subgroup.zpowers w) : z = 1 ∨ z = w ∨ z = w ^ 2 := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hz
  have hmod : w ^ (k % (3 : ℤ)) = z := by
    have h := zpow_mod_orderOf w k
    rw [hw] at h
    rw [← hk]
    exact h
  have h0 : 0 ≤ k % (3 : ℤ) := Int.emod_nonneg k (by norm_num)
  have h3 : k % (3 : ℤ) < 3 := Int.emod_lt_of_pos k (by norm_num)
  rcases (by omega : k % (3 : ℤ) = 0 ∨ k % (3 : ℤ) = 1 ∨ k % (3 : ℤ) = 2) with h | h | h
  · left; rw [← hmod, h]; simp
  · right; left; rw [← hmod, h]; simp
  · right; right; rw [← hmod, h]; simp

/-- If a subgroup `U` of order `3` is normalized by an element `x` of order `3`, then `x`
centralizes `U`: conjugation by `x` is an automorphism of the `3`-group `U` whose cube is the
identity, while `Aut(ℤ/3) ≅ ℤ/2` has exponent `2`, so it must be the identity.

Everything is done elementwise: for `w ∈ U` with `w ≠ 1` we have `⟨w⟩ = U`, hence
`x * w * x⁻¹ ∈ {1, w, w²}`.  It is not `1` (else `w = 1`), and if it were `w²` then
conjugating twice more and using `x ^ 3 = 1` gives `w = w²`, i.e. `w = 1`, a contradiction. -/
theorem OrderThreeLeCentralizer {G : Type} [Group G] {U : Subgroup G} {x : G}
    (hxN : x ∈ Subgroup.normalizer (U : Set G)) (hx3 : orderOf x = 3) (hU3 : Nat.card U = 3) :
    U ≤ Subgroup.centralizer ({x} : Set G) := by
  have hUfin : Finite U := Nat.finite_of_card_ne_zero (by rw [hU3]; norm_num)
  have hx3' : x ^ 3 = 1 := by
    have h := pow_orderOf_eq_one x
    rwa [hx3] at h
  have hxn : ∀ u ∈ U, x * u * x⁻¹ ∈ U := fun u hu =>
    (Subgroup.mem_normalizer_iff.mp hxN u).mp hu
  have key : ∀ w ∈ U, x * w * x⁻¹ = w := by
    intro w hw
    by_cases hw1 : w = 1
    · subst hw1; simp
    have hw3 : orderOf w = 3 := by
      have hdvd : orderOf w ∣ 3 := by
        have h := Subgroup.orderOf_dvd_natCard U hw
        rwa [hU3] at h
      rcases Nat.Prime.eq_one_or_self_of_dvd (by norm_num : Nat.Prime 3) (orderOf w) hdvd with
        h | h
      · exact absurd (orderOf_eq_one_iff.mp h) hw1
      · exact h
    -- `U` is generated by `w`
    have hzp : Subgroup.zpowers w = U := by
      refine Subgroup.eq_of_le_of_card_ge ?_ ?_
      · rw [Subgroup.zpowers_le]; exact hw
      · rw [Nat.card_zpowers, hw3, hU3]
    have hyU : x * w * x⁻¹ ∈ U := hxn w hw
    have hy : x * w * x⁻¹ ∈ Subgroup.zpowers w := by rw [hzp]; exact hyU
    rcases mem_zpowers_of_orderOf_three hw3 hy with h1 | h1 | h1
    · -- `x * w * x⁻¹ = 1` forces `w = 1`
      exfalso
      apply hw1
      calc w = x⁻¹ * (x * w * x⁻¹) * x := by group
        _ = x⁻¹ * 1 * x := by rw [h1]
        _ = 1 := by group
    · exact h1
    · -- `x * w * x⁻¹ = w ^ 2` is impossible
      exfalso
      have f2 : x ^ 2 * w * (x ^ 2)⁻¹ = w := by
        have e : x ^ 2 * w * (x ^ 2)⁻¹ = x * (x * w * x⁻¹) * x⁻¹ := by
          rw [pow_two, mul_inv_rev]; group
        rw [e, h1]
        have e2 : x * w ^ 2 * x⁻¹ = (x * w * x⁻¹) ^ 2 := by rw [pow_two, pow_two]; group
        rw [e2, h1, ← pow_mul, ← pow_mod_orderOf w (2 * 2), hw3]
        norm_num
      have f3 : x ^ 3 * w * (x ^ 3)⁻¹ = w ^ 2 := by
        have e : x ^ 3 * w * (x ^ 3)⁻¹ = x * (x ^ 2 * w * (x ^ 2)⁻¹) * x⁻¹ := by group
        rw [e, f2, h1]
      have f3' : x ^ 3 * w * (x ^ 3)⁻¹ = w := by
        rw [hx3', inv_one, one_mul, mul_one]
      have hw_eq : w ^ 2 = w := by rw [← f3, f3']
      have hw1' : w = 1 := by
        have : w * w = w * 1 := by rw [← pow_two, hw_eq, mul_one]
        exact mul_left_cancel this
      exact hw1 hw1'
  intro v hv
  rw [Subgroup.mem_centralizer_singleton_iff]
  have h := key v hv
  have h' : x * v = v * x := by
    have := congrArg (· * x) h
    simpa [mul_assoc] using this
  exact h'.symm

end Work.CORE3
