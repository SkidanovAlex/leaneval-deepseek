import Mathlib

namespace Work.CORE3

/-- In a group `Q` of order `6`, two commuting involutions are equal (or one of them is trivial).

Let `H = ⟨a, b⟩` be the subgroup generated by `a` and `b`.  Since `a` and `b` commute, `H` is
abelian, and `a ^ 2 = b ^ 2 = 1` shows that the square of every element of `H` is `1`; hence `H`
is a `2`-group.  A finite `2`-group has order a power of `2`, and this order divides `6`, so it
is `1` or `2`.  It cannot be `1` because it contains the nontrivial involution `a`, so `|H| = 2`.
Then `H = ⟨a⟩ = {1, a}`, and `b ∈ H` yields `b = 1` or `b = a`. -/
theorem CommutingInvolsCardSix {Q : Type} [Group Q] [Finite Q] (hcard : Nat.card Q = 6)
    (a b : Q) (ha2 : a ^ 2 = 1) (ha1 : a ≠ 1) (hb2 : b ^ 2 = 1) (hcomm : a * b = b * a) :
    b = 1 ∨ b = a := by
  classical
  haveI : Fintype Q := Fintype.ofFinite Q
  -- The subgroup generated by `a` and `b`.
  let H : Subgroup Q := Subgroup.closure ({a, b} : Set Q)
  have ha_mem : a ∈ H := Subgroup.subset_closure (by simp)
  have hb_mem : b ∈ H := Subgroup.subset_closure (by simp)
  -- `H` is abelian: every element of `H` commutes with `a` and with `b`.
  have hle_a : H ≤ Subgroup.centralizer ({a} : Set Q) := by
    rw [Subgroup.closure_le]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · change x ∈ Subgroup.centralizer ({x} : Set Q)
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
    · change x ∈ Subgroup.centralizer ({a} : Set Q)
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact hcomm
  have hle_b : H ≤ Subgroup.centralizer ({b} : Set Q) := by
    rw [Subgroup.closure_le]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · change x ∈ Subgroup.centralizer ({b} : Set Q)
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact hcomm.symm
    · change x ∈ Subgroup.centralizer ({x} : Set Q)
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
  have hcommH : ∀ x ∈ H, ∀ y ∈ H, x * y = y * x := by
    intro x hx y hy
    have hya := hle_a hy
    have hyb := hle_b hy
    -- `a` and `b` commute with `y`, so all of `H` does.
    have hay : a ∈ Subgroup.centralizer ({y} : Set Q) := by
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      rw [Subgroup.mem_centralizer_iff] at hya
      exact (hya a (by simp)).symm
    have hby : b ∈ Subgroup.centralizer ({y} : Set Q) := by
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      rw [Subgroup.mem_centralizer_iff] at hyb
      exact (hyb b (by simp)).symm
    have hle_y : H ≤ Subgroup.centralizer ({y} : Set Q) := by
      rw [Subgroup.closure_le]
      intro z hz
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hay
      · exact hby
    have hxcy := hle_y hx
    rw [Subgroup.mem_centralizer_iff] at hxcy
    exact (hxcy y (by simp)).symm
  -- Every element of `H` squares to `1`.
  have hsq : ∀ x ∈ H, x ^ 2 = 1 := by
    intro x hx
    refine Subgroup.closure_induction (p := fun x _ => x ^ 2 = 1) ?_ ?_ ?_ ?_ hx
    · intro y hy
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl
      · exact ha2
      · exact hb2
    · exact one_pow 2
    · intro x y hx' hy' hx2 hy2
      have hc : Commute x y := hcommH x hx' y hy'
      rw [Commute.mul_pow hc 2, hx2, hy2, mul_one]
    · intro x hx' hx2
      rw [inv_pow, hx2, inv_one]
  -- Hence `H` is a `2`-group.
  have hP : IsPGroup 2 H := by
    refine fun g => ⟨1, ?_⟩
    have hg : g ^ 2 = 1 := by
      apply Subtype.ext
      rw [Subgroup.coe_pow, Subgroup.coe_one]
      exact hsq (g : Q) g.2
    simpa using hg
  -- A finite `2`-group has order a power of `2`, and this order divides `6`.
  obtain ⟨n, hn⟩ := hP.exists_card_eq
  have hdiv : Nat.card H ∣ 6 := by
    rw [← hcard]; exact Subgroup.card_subgroup_dvd_card H
  have hn_ne0 : n ≠ 0 := by
    rintro rfl
    have h1 : Nat.card H = 1 := by rw [hn, pow_zero]
    have hbot : H = ⊥ := Subgroup.eq_bot_of_card_eq H h1
    have : a ∈ (⊥ : Subgroup Q) := hbot ▸ ha_mem
    rw [Subgroup.mem_bot] at this
    exact ha1 this
  have hn_le : n ≤ 1 := by
    by_contra h
    push_neg at h
    have h4 : 4 ∣ 2 ^ n := by
      have : 2 ^ 2 ∣ 2 ^ n := pow_dvd_pow 2 (by omega)
      simpa using this
    rw [← hn] at h4
    have h46 : (4 : ℕ) ∣ 6 := h4.trans hdiv
    norm_num at h46
  have hn1 : n = 1 := by omega
  have hcardH : Nat.card H = 2 := by rw [hn, hn1, pow_one]
  -- Therefore `H = ⟨a⟩ = {1, a}`.
  have hord_a : orderOf a = 2 := orderOf_eq_prime ha2 ha1
  have hzpe : Subgroup.zpowers a = H := by
    refine Subgroup.eq_of_le_of_card_ge ?_ ?_
    · rw [Subgroup.zpowers_le]; exact ha_mem
    · rw [Nat.card_zpowers, hord_a, hcardH]
  have hb_zp : b ∈ Subgroup.zpowers a := by rw [hzpe]; exact hb_mem
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hb_zp
  have hkmod : a ^ (k % 2) = b := by
    have h := zpow_mod_orderOf a k
    rw [hord_a] at h
    rw [← hk]
    simpa using h
  rcases Int.emod_two_eq_zero_or_one k with hk0 | hk1
  · left; rw [← hkmod, hk0]; simp
  · right; rw [← hkmod, hk1]; simp

end Work.CORE3
