import Mathlib

namespace Work.CORE3

/-- Two elements lying in the cyclic subgroup generated by `x` commute. -/
private theorem mul_comm_of_mem_zpowers {H : Type} [Group H] (x a b : H)
    (ha : a ∈ Subgroup.zpowers x) (hb : b ∈ Subgroup.zpowers x) : a * b = b * a := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp ha
  obtain ⟨l, hl⟩ := Subgroup.mem_zpowers_iff.mp hb
  rw [← hk, ← hl]
  exact ((Commute.refl x).zpow_left k).zpow_right l

/-- A finite group of order `6` with an element of order `6` is cyclic, hence commutative.
Equivalently, a non-commutative group of order `6` has no element of order `6`. -/
theorem orderOf_ne_six_of_not_isMulCommutative {H : Type} [Group H] [Finite H]
    (hcard : Nat.card H = 6) (hnab : ¬ IsMulCommutative H) (x : H) : orderOf x ≠ 6 := by
  intro hx
  apply hnab
  -- If `x` has order `6 = |H|`, then `⟨x⟩` is the whole group.
  have htop : Subgroup.zpowers x = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers, hx, hcard]
  refine IsMulCommutative.mk ⟨fun a b => ?_⟩
  exact mul_comm_of_mem_zpowers x a b
    (by rw [htop]; exact Subgroup.mem_top a)
    (by rw [htop]; exact Subgroup.mem_top b)

end Work.CORE3
