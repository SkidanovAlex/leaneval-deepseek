import Mathlib
import Submission.Work.CORE3.Defs
import Submission.Work.Dihedral.Defs

set_option linter.style.haveILetI false
set_option linter.dupNamespace false

namespace Work.CORE3

open Work.GW2

/-- In `DihedralGroup n` with `n ≥ 3`, a cyclic subgroup with `n` elements is the rotation
subgroup `⟨r⟩`: a cyclic subgroup of index two cannot meet the coset of reflections.

Indeed, if `g` generates such a subgroup and `g = sr i`, then `g` has order `2 ≠ n`; hence
`g = r i` is a rotation, the subgroup lies in `⟨r⟩`, and the cardinalities `n = n` force
equality. -/
lemma dihedral_zpowers_eq_rot_of_card {n : ℕ} (hn : 3 ≤ n) (g : DihedralGroup n)
    (hcard : Nat.card (Subgroup.zpowers g) = n) :
    Subgroup.zpowers g = Work.Dihedral.rot n := by
  haveI : NeZero n := ⟨by omega⟩
  have hord : orderOf g = n := by rw [← Nat.card_zpowers, hcard]
  have hg : g ∈ Work.Dihedral.rot n := by
    rcases Work.Dihedral.eq_r_or_sr g with ⟨i, hi⟩ | ⟨i, hi⟩
    · rw [hi]; exact Work.Dihedral.r_mem_rot i
    · rw [hi, DihedralGroup.orderOf_sr] at hord
      omega
  refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hg) ?_
  rw [Work.Dihedral.nat_card_rot, hcard]

/-- In `DihedralGroup n` with `n ≥ 2`, every element outside a cyclic subgroup of index two
(here: the subgroup generated by an element `g` with `Nat.card (zpowers g) = n`) is an
involution. -/
lemma dihedral_sq_eq_one_of_not_mem_zpowers {n : ℕ} (hn : 2 ≤ n) (g : DihedralGroup n)
    (hcard : Nat.card (Subgroup.zpowers g) = n) :
    ∀ x ∉ Subgroup.zpowers g, x * x = 1 := by
  rcases Nat.eq_or_lt_of_le hn with h2 | h3
  · -- `n = 2`: `DihedralGroup 2` is the Klein four-group
    subst h2
    intro x _
    exact IsKleinFour.mul_self x
  · intro x hx
    rw [dihedral_zpowers_eq_rot_of_card (by omega) g hcard] at hx
    obtain ⟨i, hi⟩ := Work.Dihedral.notMem_rot.mp hx
    rw [hi, DihedralGroup.sr_mul_self]

namespace Work.CORE3

open Work.GW2

/-- In a dihedral 2-group `S ≅ D_n` (`n ≥ 2`), a cyclic subgroup `S₀ ≤ S` of index 2 is the
rotation subgroup unless `n = 2` (where `S` is Klein four); in both cases every element of
`S − S₀` is an involution.  Useful for the CORE3 leaves, which need involutions `t₁,t₂ ∈ S − S₀`
(Bender 1981 §3, p. 222). -/
theorem OutsideS0OrderTwo (G : Type) [Group G] [Finite G] (h : BenderCtx G) (B : BenderSetup G)
    (n : ℕ) (hn : 2 ≤ n) (hdih : Nonempty ((B.S : Subgroup G) ≃* DihedralGroup n)) :
    ∀ s ∈ (B.S : Subgroup G), s ∉ B.S0 → orderOf s = 2 := by
  intro s hsS hs0
  obtain ⟨φ⟩ := hdih
  -- `|S| = 2n` and `|S₀| = n` (index two in `S`)
  have hcardS : Nat.card ↥(B.S : Subgroup G) = 2 * n := by
    rw [Nat.card_congr φ.toEquiv, DihedralGroup.nat_card]
  have hcardS0 : Nat.card ↥B.S0 = n := by
    have h1 := Subgroup.relIndex_mul_card B.S0 (B.S : Subgroup G)
    rw [inf_eq_left.mpr B.S0_le, B.S0_index, hcardS] at h1
    exact Nat.mul_left_cancel (by norm_num) h1
  -- a generator `g₀` of `S₀`, viewed inside `S`
  haveI hcyc0 : IsCyclic ↥B.S0 := B.S0_cyclic
  obtain ⟨g0, hg0⟩ := IsCyclic.exists_generator (α := ↥B.S0)
  set gS : ↥(B.S : Subgroup G) := ⟨(g0 : G), B.S0_le g0.2⟩ with hgS_def
  have hgS_coe : (gS : G) = (g0 : G) := rfl
  have hgS_mem : gS ∈ B.S0.subgroupOf (B.S : Subgroup G) := by
    rw [Subgroup.mem_subgroupOf, hgS_coe]
    exact g0.2
  have hzple : Subgroup.zpowers gS ≤ B.S0.subgroupOf (B.S : Subgroup G) :=
    Subgroup.zpowers_le.mpr hgS_mem
  have hordS0 : orderOf g0 = Nat.card ↥B.S0 :=
    orderOf_eq_card_of_forall_mem_zpowers hg0
  have hordgS : orderOf gS = n := by
    have h1 : orderOf gS = orderOf g0 := by
      rw [← Subgroup.orderOf_coe gS, hgS_coe, Subgroup.orderOf_coe g0]
    rw [h1, hordS0, hcardS0]
  have hcardzp : Nat.card (Subgroup.zpowers (φ gS)) = n := by
    rw [Nat.card_zpowers, MulEquiv.orderOf_eq φ gS, hordgS]
  -- `φ s` is an involution because it lies outside `⟨φ g₀⟩`
  have hsq : φ ⟨s, hsS⟩ * φ ⟨s, hsS⟩ = 1 := by
    refine dihedral_sq_eq_one_of_not_mem_zpowers hn (φ gS) hcardzp _ ?_
    intro hmem
    rw [Subgroup.mem_zpowers_iff] at hmem
    obtain ⟨k, hk⟩ := hmem
    -- then `⟨s, _⟩` itself is a power of `gS`, hence lies in `S₀`
    have h2 : gS ^ k = ⟨s, hsS⟩ := by
      apply φ.injective
      rw [map_zpow]
      exact hk
    have hmemS : (⟨s, hsS⟩ : ↥(B.S)) ∈ Subgroup.zpowers gS := by
      rw [Subgroup.mem_zpowers_iff]
      exact ⟨k, h2⟩
    have hmemS0 := hzple hmemS
    rw [Subgroup.mem_subgroupOf] at hmemS0
    exact hs0 hmemS0
  have hs2 : s ^ 2 = 1 := by
    have h4 : (⟨s, hsS⟩ : ↥(B.S)) * ⟨s, hsS⟩ = 1 := by
      apply φ.injective
      rw [map_mul, map_one, hsq]
    have h5 := congrArg (fun z : ↥(B.S) => (z : G)) h4
    simpa [pow_two] using h5
  have hsne : s ≠ 1 := by
    intro h1
    exact hs0 (by rw [h1]; exact B.S0.one_mem)
  exact orderOf_eq_prime hs2 hsne

end Work.CORE3

/-- The same statement, exposed under the name `Work.CORE3.OutsideS0OrderTwo` used by the CORE3
leaves (the module's main declaration sits in the doubly nested namespace
`Work.CORE3.Work.CORE3`): in a dihedral 2-group `S ≅ D_n` (`n ≥ 2`) a cyclic subgroup `S₀ ≤ S`
of index two meets every element of `S − S₀` in an involution. -/
theorem OutsideS0OrderTwo (G : Type) [Group G] [Finite G] (h : BenderCtx G) (B : BenderSetup G)
    (n : ℕ) (hn : 2 ≤ n) (hdih : Nonempty ((B.S : Subgroup G) ≃* DihedralGroup n)) :
    ∀ s ∈ (B.S : Subgroup G), s ∉ B.S0 → orderOf s = 2 :=
  _root_.Work.CORE3.Work.CORE3.OutsideS0OrderTwo G h B n hn hdih

end Work.CORE3
