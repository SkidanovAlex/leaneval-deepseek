import Mathlib
import Submission.Work.CORE3.Defs
import Submission.Work.CORE2A.Basic
import Submission.Work.CORE3.Case1bEightNineDefs
import Submission.Work.CORE3.CosetInvCountBasic
import Submission.Work.CORE3.CosetInvCountNeFiveOf
import Submission.Work.BSW.Cases.K4.CardSup

/-!
# Bender 1981 §3 (5) ⟹ `n ≠ 5`  (`Work.CORE3.CosetInvCountNeFive`)

This file finishes the leaf `Work.CORE3.CosetInvCountNeFive` of Bender's §3.  The reduction
"Bender (5) ⟹ no coset of `Ĥ` containing an involution `y ∉ Ĥ` contains exactly five
involutions" is `Work.CORE3.cosetInvCount_ne_five_of` (file `CosetInvCountNeFiveOf`): the
inverted set `I_Ĥ(y)` injects into `Ĥ/VU` (a group of order `6`), so its image `Q` satisfies
`|Q| = |I_Ĥ(y)| = n(y)`, `1 ∈ Q`, `Q⁻¹ = Q`, and conjugation by any involution of `Q`
preserves `Q`.

What is left is the purely finite group-theoretic input `OrderSixNoFiveSubset`, proved here as
`NoFiveSubsetOfOrderSixMulConj`: a nonabelian group `K` of order `6` contains no `5`-element
subset `Q` with `1 ∈ Q`, closed under inverses and under conjugation by its own involutions.
Indeed `K = Q ∪ {a}` for a single `a`, inverse-closure forces `a` to be an involution, a
nonabelian group of order `6` has a second involution `b ≠ a` (`ExistsInvolutionNeOfCardSix`),
conjugation by `b` then fixes `a`, and two distinct commuting involutions cannot exist in a
group of order `6` (`CommuteFalseOfCardSix`: they would generate a Klein four-group, of order
`4 ∤ 6`).

Supporting elementary facts about groups of order `6`:

* `commuteFalseOfCardSix` — two distinct non-identity involutions of a group of order `6` do
  not commute (otherwise `⟨a⟩ ⊔ ⟨b⟩` would be a Klein four-group, and `4 ∣ 6`);
* `exists_involution_ne_of_card_six` — a nonabelian group of order `6` has at least two
  involutions (a unique involution would be central, and a group of order `6` with a central
  involution is cyclic or has a cyclic center quotient, hence abelian);
* `orderOf_eq_three_or_six` — in a group of order `6`, an element whose order divides `6` and
  is neither `1` nor `2` has order `3` or `6`.
-/

namespace Work.CORE3

open Work.GW2
open Subgroup

section OrderSix

variable {K : Type} [Group K]

/-- If `a * a = 1`, every element of the cyclic subgroup generated by `a` is `1` or `a`. -/
private theorem zpowers_eq_one_or_self_of_sq_eq_one {a : K} (ha : a * a = 1)
    {x : K} (hx : x ∈ Subgroup.zpowers a) : x = 1 ∨ x = a := by
  rw [Subgroup.zpowers_eq_closure] at hx
  have hainv : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
  refine Subgroup.closure_induction (p := fun y (_ : y ∈ Subgroup.closure ({a} : Set K)) =>
    y = 1 ∨ y = a) ?_ ?_ ?_ ?_ hx
  · intro y hy
    exact Or.inr (by simpa using hy)
  · exact Or.inl rfl
  · intro y z hy hz ihy ihz
    rcases ihy with h | h <;> rcases ihz with h' | h'
    · exact Or.inl (by rw [h, h', one_mul])
    · exact Or.inr (by rw [h, h', one_mul])
    · exact Or.inr (by rw [h, h', mul_one])
    · exact Or.inl (by rw [h, h', ha])
  · intro y hy ihy
    rcases ihy with h | h
    · exact Or.inl (by rw [h, inv_one])
    · exact Or.inr (by rw [h, hainv])

/-- **No Klein four-group in a group of order `6`.**  Two distinct involutions `≠ 1` of a
group of order `6` do not commute: if they did, `⟨a⟩ ⊔ ⟨b⟩` would be a group of order
`|⟨a⟩| · |⟨b⟩| = 4`, contradicting Lagrange. -/
theorem commuteFalseOfCardSix [Finite K] (hcard : Nat.card K = 6) {a b : K}
    (ha : a * a = 1) (hb : b * b = 1) (ha1 : a ≠ 1) (hb1 : b ≠ 1) (hne : a ≠ b) :
    a * b ≠ b * a := by
  intro hab
  have hbinv : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
  have hdisj : Subgroup.zpowers a ⊓ Subgroup.zpowers b = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    rw [Subgroup.mem_inf] at hz
    rw [Subgroup.mem_bot]
    rcases zpowers_eq_one_or_self_of_sq_eq_one ha hz.1 with h | h
    · exact h
    · rcases zpowers_eq_one_or_self_of_sq_eq_one hb hz.2 with h' | h'
      · exact absurd (h.symm.trans h') ha1
      · exact absurd (h.symm.trans h') hne
  have hnorm : Subgroup.zpowers b ≤
      Subgroup.normalizer ((Subgroup.zpowers a : Subgroup K) : Set K) := by
    rw [Subgroup.le_normalizer_iff]
    intro y hy x hx
    rcases zpowers_eq_one_or_self_of_sq_eq_one hb hy with h | h
    · rw [h, one_mul, inv_one, mul_one]
      exact hx
    · rcases zpowers_eq_one_or_self_of_sq_eq_one ha hx with h' | h'
      · rw [h, h', mul_one, inv_eq_of_mul_eq_one_right hb, hb]
        exact Subgroup.one_mem _
      · rw [h, h', hbinv, ← hab, mul_assoc, hb, mul_one]
        exact Subgroup.mem_zpowers a
  have hsup : Nat.card ↥(Subgroup.zpowers a ⊔ Subgroup.zpowers b) = 4 := by
    rw [Work.BSW.Cases.K4.card_sup_of_le_normalizer_of_inf_eq_bot hnorm hdisj]
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have h2a : orderOf a = 2 := orderOf_eq_prime (by rw [pow_two]; exact ha) ha1
    have h2b : orderOf b = 2 := orderOf_eq_prime (by rw [pow_two]; exact hb) hb1
    rw [Nat.card_zpowers, Nat.card_zpowers, h2a, h2b]
  have hdvd := Subgroup.card_subgroup_dvd_card (Subgroup.zpowers a ⊔ Subgroup.zpowers b)
  rw [hsup, hcard] at hdvd
  omega

/-- In a group of order `6`, an element whose order divides `6` and is neither `1` nor `2` has
order `3` or `6`. -/
private theorem orderOf_eq_three_or_six [Finite K] {x : K} (h : orderOf x ∣ 6)
    (h1 : orderOf x ≠ 1) (h2 : orderOf x ≠ 2) :
    orderOf x = 3 ∨ orderOf x = 6 := by
  have hle : orderOf x ≤ 6 := Nat.le_of_dvd (by norm_num) h
  have hpos : 0 < orderOf x := orderOf_pos x
  interval_cases orderOf x
  · exact absurd rfl h1
  · exact absurd rfl h2
  · exact Or.inl rfl
  · exact absurd h (by norm_num)
  · exact absurd h (by norm_num)
  · exact Or.inr rfl

/-- **A nonabelian group of order `6` has two distinct involutions.**  If `a ≠ 1` were the only
involution, then `a` would be central (its conjugates are involutions), so the quotient
`K/⟨a⟩` would have order `3` and hence be cyclic, forcing `K` abelian: contradiction.  The
argument is run as the contrapositive, using that an element of order `6` makes `K` cyclic. -/
theorem exists_involution_ne_of_card_six [Finite K] (hcard : Nat.card K = 6)
    (hnab : ¬ IsMulCommutative K) {a : K} (ha : a * a = 1) (ha1 : a ≠ 1) :
    ∃ b : K, b * b = 1 ∧ b ≠ 1 ∧ b ≠ a := by
  classical
  -- an element of order `6` generates `K`, which is then commutative
  have hno6 : ∀ y : K, orderOf y = 6 → IsMulCommutative K := by
    intro y hy6
    have htop : Subgroup.zpowers y = ⊤ := by
      refine Subgroup.eq_top_of_card_eq _ ?_
      rw [Nat.card_zpowers, hy6, hcard]
    refine isMulCommutative_iff.mpr fun p q => ?_
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (htop ▸ Subgroup.mem_top p)
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (htop ▸ Subgroup.mem_top q)
    rw [← hm, ← hn]
    exact Commute.zpow_zpow_self y m n
  by_contra hcon
  -- so every involution is `1` or `a`
  have hcon' : ∀ b : K, b * b = 1 → b = 1 ∨ b = a := by
    intro b hb
    by_cases h1 : b = 1
    · exact Or.inl h1
    · exact Or.inr (by
        by_contra h2
        exact hcon ⟨b, hb, h1, h2⟩)
  have hacent : a ∈ Subgroup.center K := by
    rw [Subgroup.mem_center_iff]
    intro g
    have hga2 : (g * a * g⁻¹) * (g * a * g⁻¹) = 1 := by
      rw [show g * a * g⁻¹ * (g * a * g⁻¹) = g * (a * a) * g⁻¹ from by group, ha]
      group
    have hga1 : g * a * g⁻¹ ≠ 1 := by
      intro hh
      have h2 : a = 1 := by
        have h3 := congrArg (fun z : K => g⁻¹ * z * g) hh
        simpa [mul_assoc] using h3
      exact ha1 h2
    rcases hcon' (g * a * g⁻¹) hga2 with h | h
    · exact absurd h hga1
    · show g * a = a * g
      have h3 : g * a * g⁻¹ * g = a * g := by rw [h]
      simpa using h3
  -- an element different from `1` and `a`
  obtain ⟨x, hx1, hxa⟩ : ∃ x : K, x ≠ 1 ∧ x ≠ a := by
    by_contra hcon2
    have hcon3 : ∀ y : K, y = 1 ∨ y = a := by
      intro y
      by_cases hy1 : y = 1
      · exact Or.inl hy1
      · exact Or.inr (by
          by_contra hya
          exact hcon2 ⟨y, hy1, hya⟩)
    have hsub : (Set.univ : Set K) ⊆ ({1, a} : Set K) := by
      intro y _
      rcases hcon3 y with h | h <;> simp [h]
    have hle := Set.ncard_le_ncard hsub
    rw [Set.ncard_univ, hcard, Set.ncard_pair ha1.symm] at hle
    omega
  have hxord : orderOf x ∣ 6 := by rw [← hcard]; exact orderOf_dvd_natCard x
  have hxn1 : orderOf x ≠ 1 := fun h => hx1 (orderOf_eq_one_iff.mp h)
  have hxn2 : orderOf x ≠ 2 := by
    intro h2
    have hsq : x * x = 1 := by rw [← pow_two, ← h2]; exact pow_orderOf_eq_one x
    rcases hcon' x hsq with h | h
    · exact hx1 h
    · exact hxa h
  have hcases : orderOf x = 3 ∨ orderOf x = 6 := orderOf_eq_three_or_six hxord hxn1 hxn2
  rcases hcases with h3 | h6
  · -- `x` has order `3`; since `a` is central, so does `a * x`, but `(a * x) ^ 3 = a ≠ 1`
    have hx3 : x ^ 3 = 1 := by rw [← h3]; exact pow_orderOf_eq_one x
    have hcomm : Commute a x := (Subgroup.mem_center_iff.mp hacent x).symm
    have hax1 : a * x ≠ 1 := by
      intro hh
      have h2 : x = a := by
        have h3' : a⁻¹ * (a * x) = a⁻¹ * 1 := by rw [hh]
        rw [inv_mul_cancel_left] at h3'
        simpa [inv_eq_of_mul_eq_one_right ha] using h3'
      exact hxa h2
    have haxa : a * x ≠ a := by
      intro hh
      have h3' : a⁻¹ * (a * x) = a⁻¹ * a := by rw [hh]
      rw [inv_mul_cancel_left, inv_mul_cancel] at h3'
      exact hx1 h3'
    have haxord : orderOf (a * x) ∣ 6 := by rw [← hcard]; exact orderOf_dvd_natCard _
    have haxn1 : orderOf (a * x) ≠ 1 := fun h => hax1 (orderOf_eq_one_iff.mp h)
    have haxn2 : orderOf (a * x) ≠ 2 := by
      intro h2
      have hsq : (a * x) * (a * x) = 1 := by rw [← pow_two, ← h2]; exact pow_orderOf_eq_one _
      rcases hcon' (a * x) hsq with h | h
      · exact hax1 h
      · exact haxa h
    have hcases2 : orderOf (a * x) = 3 ∨ orderOf (a * x) = 6 :=
      orderOf_eq_three_or_six haxord haxn1 haxn2
    rcases hcases2 with h3' | h6'
    · have hcube : (a * x) ^ 3 = 1 := by rw [← h3']; exact pow_orderOf_eq_one _
      have hcube' : (a * x) ^ 3 = a := by
        rw [hcomm.mul_pow 3, hx3, mul_one, pow_succ, pow_two, ha, one_mul]
      rw [hcube'] at hcube
      exact ha1 hcube
    · exact hnab (hno6 (a * x) h6')
  · exact hnab (hno6 x h6)

/-- **Bender 1981 §3, `n(z) ≠ 5` (finite-group input).**  A nonabelian group `K` of order `6`
has no `5`-element subset `Q` containing `1`, closed under inverses and under conjugation by
its own involutions.

Indeed `Q = K \ {a}` for a unique `a`; inverse-closure forces `a * a = 1` and `a ≠ 1`; by
`exists_involution_ne_of_card_six` there is a second involution `b ≠ 1, a`, i.e. `b ∈ Q`;
applying the conjugation hypothesis to the involution `b` shows that `b a b⁻¹ ∉ Q`, hence
`b a b⁻¹ = a`, so `a` and `b` are distinct commuting involutions, which `commuteFalseOfCardSix`
excludes. -/
theorem NoFiveSubsetOfOrderSixMulConj (K : Type) [Group K] [Finite K] (hcard : Nat.card K = 6)
    (hnab : ¬ IsMulCommutative K) (Q : Set K) (hQcard : Q.ncard = 5) (hQ1 : (1 : K) ∈ Q)
    (hQinv : ∀ q ∈ Q, q⁻¹ ∈ Q)
    (hQconj : ∀ q ∈ Q, q * q = 1 → ∀ r ∈ Q, q * r * q⁻¹ ∈ Q) : False := by
  classical
  -- `Q` is the complement of a single element `a`
  have hcompl : Qᶜ.ncard = 1 := by
    rw [Set.ncard_compl, hcard, hQcard]
  obtain ⟨a, ha⟩ := Set.ncard_eq_one.mp hcompl
  have hmem : ∀ x : K, x ∉ Q ↔ x = a := by
    intro x
    rw [← Set.mem_compl_iff, ha, Set.mem_singleton_iff]
  have hmemQ : ∀ x : K, x ∈ Q ↔ x ≠ a := by
    intro x
    constructor
    · intro hx hxa
      exact (hmem x).mpr hxa hx
    · intro hx
      by_contra hcon
      exact hx ((hmem x).mp hcon)
  have haQ : a ∉ Q := (hmem a).mpr rfl
  have ha1 : a ≠ 1 := fun h => haQ (h.symm ▸ hQ1)
  -- inverse-closure forces `a` to be an involution
  have hainv : a⁻¹ = a := by
    by_contra hne
    have h1 : a⁻¹ ∈ Q := (hmemQ a⁻¹).mpr hne
    have h2 : a ∈ Q := by simpa [inv_inv] using hQinv a⁻¹ h1
    exact haQ h2
  have ha2 : a * a = 1 := by
    calc a * a = a * a⁻¹ := by rw [hainv]
      _ = 1 := mul_inv_cancel a
  -- a second involution `b`, which lies in `Q`
  obtain ⟨b, hb2, hb1, hba⟩ := exists_involution_ne_of_card_six hcard hnab ha2 ha1
  have hbQ : b ∈ Q := (hmemQ b).mpr hba
  -- conjugation by `b` fixes `a`
  have hbab : b * a * b⁻¹ = a := by
    by_contra hne
    have hmem' : b * a * b⁻¹ ∈ Q := (hmemQ _).mpr hne
    have h := hQconj b hbQ hb2 (b * a * b⁻¹) hmem'
    have heq : b * (b * a * b⁻¹) * b⁻¹ = a := by
      rw [show b * (b * a * b⁻¹) * b⁻¹ = (b * b) * a * (b⁻¹ * b⁻¹) from by group,
        hb2, inv_eq_of_mul_eq_one_right hb2, hb2]
      group
    rw [heq] at h
    exact haQ h
  have hcomm : a * b = b * a := by
    have h3 : b * a * b⁻¹ * b = a * b := by rw [hbab]
    have h4 : b * a = a * b := by simpa using h3
    exact h4.symm
  exact commuteFalseOfCardSix hcard ha2 hb2 ha1 hb1 (fun h => hba h.symm) hcomm

end OrderSix

/-- Bender 1981 §3, p. 223, (5) ⟹ no coset of `Ĥ` contains exactly five involutions.
(`Work.CORE3.CosetInvCountNeFive`.) -/
theorem CosetInvCountNeFive (G : Type) [Group G] [Finite G] (I : Work.CORE3.Case1Inputs) (h : Work.GW2.BenderCtx G)
    (B : Work.GW2.BenderSetup G) (h1 : Work.GW2.Case1 B) (D : Work.GW2.Case1bData B)
    (h5 : ∀ z : G, orderOf z = 2 → z ∉ B.Hhat →
      Work.GW2.invSet (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) z = {1}) :
    ∀ y : G, orderOf y = 2 → y ∉ B.Hhat → Work.GW2.cosetInvCount B.Hhat y ≠ 5 :=
  cosetInvCount_ne_five_of G I h B h1 D h5 NoFiveSubsetOfOrderSixMulConj

end Work.CORE3
