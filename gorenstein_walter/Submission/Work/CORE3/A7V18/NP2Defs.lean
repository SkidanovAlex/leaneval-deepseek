import Mathlib
import Submission.Work.CORE3.Defs
import Submission.Work.CORE3.Case1aFrattiniApi

/-!
# CORE3 / A7V18: vocabulary for `Work.CORE3.A7V18.NP2NotH`

The target `Work.CORE3.A7V18.NP2NotH` (Bender 1981, §3, p. 222: "with `Vᵢ := ⟨t,tᵢ⟩` and
`P₂ ∈ Syl_p(B)` … the Frattini argument forces the involutions in `Vᵢ` to be conjugate in
`N_G(Pᵢ)`") is proved by the same Frattini argument as the leaf `Work.CORE3.Case1aFrattini`,
with the pair `(t₁, P₁)` replaced by the pair `(t₂, P₂)`:

* `V₂ = ⟨t, t₂⟩` is a four-group contained in `S`, and `P₂` is centralized by `S`, hence
  `V₂ ≤ N_G(P₂)`;
* `P₂ ∈ Syl_p(C_U(S))` and the `t₂`-analogue of Bender's computation
  `|C_U(t₁)|_p = |O_p(U)| · |C_U(S)|_p` gives `P₂ ∈ Syl_p(C_G(V₂))`
  (here `t₂` *inverts* `O_p(U)`, so the first factor drops out: `|C_U(t₂)|_p = |C_U(S)|_p`);
* all involutions of `G` are conjugate and `N_G(V)` is transitive on `V#` for every
  four-group `V` (`LocalToolkit.fus`), so some `g ∈ N_G(V₂)` conjugates `t` to `t₂`;
* conjugating `P₂` by `g` gives another Sylow `p`-subgroup of `C_G(V₂)`, so the Frattini
  argument yields `c ∈ C_G(V₂)` with `g c ∈ N_G(P₂)`; then `(g c) t (g c)⁻¹ = t₂`, and
  `t ≠ t₂` with `t₂ ∈ H` shows `g c ∉ H = C_G(t)`.

This module only fixes the notation shared by the pieces of that argument.
-/

open scoped MatrixGroups

namespace Work.CORE3.A7V18

open Subgroup

/-- `V₂ = ⟨t, t₂⟩`: the four-group generated by `t` and the involution `t₂ ∈ S − S₀` which
inverts `O_p(U)` (`Work.CORE3.A7V18.V1` with `t₂` in place of `t₁`). -/
def V2 {G : Type} [Group G] [Finite G] (B : Work.GW2.BenderSetup G)
    (D : Work.GW2.Case1aData B) : Subgroup G :=
  Subgroup.zpowers B.t ⊔ Subgroup.zpowers D.t2

/-- `C_U(S) = B.U ⊓ C_G(B.S)`, Bender's `B := C_U(S)` in §3 of Bender 1981. -/
def CUS {G : Type} [Group G] [Finite G] (B : Work.GW2.BenderSetup G) : Subgroup G :=
  B.U ⊓ Subgroup.centralizer ((B.S : Subgroup G) : Set G)

end Work.CORE3.A7V18
