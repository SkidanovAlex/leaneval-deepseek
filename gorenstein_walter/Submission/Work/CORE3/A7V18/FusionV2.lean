import Submission.Work.CORE3.A7V18.V2InLayer
import Submission.Work.CORE3.Case1aFrattiniApi
import Submission.Work.CORE3.Case1aFrattini
import Submission.Work.CORE2A.bswHyps2_of_config2

/-!
# CORE3 / A7V18: fusion in `N_G(V₂)` (Bender 1981, §3, p. 222)

Deliverable `Work.CORE3.A7V18.FusionV2`: in the subcase `Ĥ = H` of Case (1), with
`V₂ = ⟨t, t₂⟩` the Klein four-group generated by the involution `t ∈ S₀` and the involution
`t₂ ∈ S − S₀`, the normalizer `N_G(V₂)` is transitive on the nontrivial elements of `V₂`;
in particular some `g ∈ N_G(V₂)` conjugates `t` to `t₂`.

This is the second clause of the toolkit's `InvolutionFusionProp` (`LocalToolkit.fus`),
applied to the four-group `V₂`.  The four-group structure (`Work.CORE3.A7V18.isFourGroup_V2`,
in `V2InLayer.lean`) is Bender's observation that `t` and `t₂` are distinct commuting
involutions; the remaining inputs of `InvolutionFusionProp` are the dihedral shape of `S`
(`Work.CORE3.SylowDihedral`) and the absence of a normal subgroup of index two, which holds in
the minimal-counterexample context (`Work.CORE2A.no_normal_index_two_of_simple_nonab`, from
`BenderCtx.simple` and `BenderCtx.nonab`).

This is the exact analogue for `(V₂, t₂)` of `Work.CORE3.cj_FusionNormalizerV1` for
`(V₁, t₁)`; both are specialisations of the general lemma below.
-/

namespace Work.CORE3.A7V18

open Subgroup

/-- **Fusion in the normalizer of a Klein four-group.**  In Bender's minimal-counterexample
context, `N_G(V)` is transitive on the nontrivial elements of any four-group `V`: this is the
second clause of the toolkit's `InvolutionFusionProp` (`LocalToolkit.fus`), whose hypothesis
"no normal subgroup of index two" is supplied by simplicity plus non-abelianness
(`Work.CORE2A.no_normal_index_two_of_simple_nonab`) and whose dihedral-shape hypothesis by
`Work.CORE3.SylowDihedral`.

Stated for an arbitrary four-group (not just `V₁` or `V₂`) so that the two specialisations
`Work.CORE3.cj_FusionNormalizerV1` and `FusionV2` become one-liners. -/
theorem exists_conj_mem_normalizer_of_isFourGroup {G : Type} [Group G] [Finite G]
    (T : Work.GW2.LocalToolkit) (hBc : Work.GW2.BenderCtx G) (B : Work.GW2.BenderSetup G)
    {V : Subgroup G} (hV : Work.GW2.IsFourGroup V) {x y : G} (hx : x ∈ V) (hy : y ∈ V)
    (hx1 : x ≠ 1) (hy1 : y ≠ 1) :
    ∃ g ∈ Subgroup.normalizer (V : Set G), g * x * g⁻¹ = y := by
  obtain ⟨n, hn2, hdih⟩ := Work.CORE3.SylowDihedral G hBc B
  haveI : IsSimpleGroup G := hBc.simple
  exact (T.fus G (B.S) n hn2 hdih
    (Work.CORE2A.no_normal_index_two_of_simple_nonab hBc.nonab)).2 V hV x hx y hy hx1 hy1

/-- `g ≠ 1` for an element of order two. -/
private lemma ne_one_of_orderOf_eq_two {G : Type} [Group G] {x : G} (hx : orderOf x = 2) :
    x ≠ 1 := by
  intro h
  have h1 : orderOf x = 1 := by rw [h]; exact orderOf_one
  rw [hx] at h1
  exact absurd h1 (by norm_num)

theorem FusionV2 (G : Type) [Group G] [Finite G] (T : Work.GW2.LocalToolkit)
    (hBc : Work.GW2.BenderCtx G) (B : Work.GW2.BenderSetup G) (D : Work.GW2.Case1aData B) :
    ∃ g ∈ Subgroup.normalizer ((Work.CORE3.A7V18.V2 B D : Subgroup G) : Set G),
      g * B.t * g⁻¹ = D.t2 := by
  -- `V₂ = ⟨t, t₂⟩` is a Klein four-group (`t ∈ S₀` is central, `t₂ ∈ S − S₀`).
  have hV4 : Work.GW2.IsFourGroup (V2 B D) := isFourGroup_V2 B D
  -- Both generators are nontrivial elements of `V₂`, so involution fusion applies.
  refine exists_conj_mem_normalizer_of_isFourGroup T hBc B hV4 ?_ ?_ ?_ ?_
  · exact Subgroup.mem_sup_left (Subgroup.mem_zpowers B.t)
  · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers D.t2)
  · exact ne_one_of_orderOf_eq_two B.t_order
  · exact ne_one_of_orderOf_eq_two D.t2_order

end Work.CORE3.A7V18
