/-!
# CORE3 / A7V18: `V₂ = ⟨t, t₂⟩ ≤ E(M)` (Bender 1981, §3, p. 222)

Deliverable `Work.CORE3.A7V18.V2LayerMne`: for a maximal subgroup `M ⊇ N_G(P₂)` with
`M ≠ H = C_G(t)` and `O_p(U) ∩ M ≠ 1` (Bender's `P₀ ≠ 1`), the four-group `V₂ = ⟨t, t₂⟩`
lies in the layer `E(M) = layerIn M`.

Route (Bender's one-line argument "As `t₂` inverts `P₀`, `V₂` is not contained in `O₂(M)`
and hence lies in `E := E(M)` by Lemma 2.9", made precise):

* `V₂ ≤ S ≤ M` (`S ≤ M` because `S` centralizes `P₂ ≤ N_G(P₂) ≤ M`);
* **fusion**: `P₂ ∈ Syl_p(C_G(V₂))` (`P2_sylow_centralizer_V2`), involution fusion makes
  `N_G(V₂)` transitive on `V₂#`, and the Frattini argument in `C_G(V₂)` upgrades this to: every
  nontrivial `v ∈ V₂` is `n v n⁻¹ = t` for some `n ∈ N_G(P₂) ≤ M`
  (`exists_normalizer_conj_of_mem_V2`; for `v = t₂` this is `exists_normalizer_conj`);
* **`V₂ ⊓ O₂(M) = ⊥`**: `t₂` inverts the nontrivial `p`-group `P₀ = O_p(U) ∩ M`, so
  `⁅⟨t₂⟩, P₀⁆` is generated by squares of `P₀`; as `P₀` is a `p`-group with `p` odd, every
  element of `P₀` is a square, so `t₂ ∈ O₂(M)` would force `P₀ ≤ O₂(M) ∩ P₀ = 1`
  (`t2_notMem_pCoreIn_two`).  Fusion moves this to all of `V₂`;
* **the upgrade**: `E(M) ⊴ M`, so if some nontrivial `x ∈ V₂` lies in `E(M)`, then
  `t = n⁻¹ x n ∈ E(M)` for a suitable `n ∈ N_G(P₂) ≤ M`, hence `t₂ = m t m⁻¹ ∈ E(M)`
  (`V2_le_layerIn_of_inf`);
* **Lemma 2.9** (`I.h29`, with the side condition `mdata_h29_side`) applied to `V = V₂`,
  `N = M` gives `V₂ ⊓ O₂(M) ≠ ⊥ ∨ V₂ ⊓ E(M) ≠ ⊥`; the first disjunct is excluded, the second
  gives the conclusion.
-/

namespace Work.CORE3.A7V18

open Subgroup
open Work.GW2
open scoped commutatorElement

variable {G : Type} [Group G] [Finite G]

/-! ## Two elementary facts -/

/-- An element of order two is nontrivial. -/
theorem ne_one_of_orderOf_eq_two {G : Type} [Group G] {x : G} (hx : orderOf x = 2) :
    x ≠ 1 := by
  intro h
  have h1 : orderOf x = 1 := by rw [h]; exact orderOf_one
  rw [hx] at h1
  exact absurd h1 (by norm_num)

/-- `V₂ = ⟨t, t₂⟩ ≤ S`. -/
theorem V2_le_S (B : BenderSetup G) (D : Case1aData B) :
    (V2 B D : Subgroup G) ≤ (B.S : Subgroup G) := by
  rw [V2]
  exact sup_le (Subgroup.zpowers_le.mpr (B.S0_le B.t_mem))
    (Subgroup.zpowers_le.mpr D.t2_mem)

/-! ## Fusion of the involutions of `V₂` inside `N_G(P₂)` -/

/-- **Fusion of the involutions of `V₂` in `N_G(P₂)`** (Bender 1981, §3, p. 222).

`P₂ ∈ Syl_p(C_U(S))` is a Sylow `p`-subgroup of `C_G(V₂)` (`P2_sylow_centralizer_V2`), and
involution fusion (`LocalToolkit.fus`) makes `N_G(V₂)` transitive on `V₂#`.  The Frattini
argument in `C_G(V₂)` (Sylow conjugacy plus `N_G(V₂) ≤ N_G(C_G(V₂))`) then produces, for each
nontrivial `v ∈ V₂`, an element of `N_G(P₂)` conjugating `t` to `v`.

This is the `v`-uniform version of `exists_normalizer_conj` (the case `v = t₂`). -/
theorem exists_normalizer_conj_of_mem_V2 (T : LocalToolkit) (hBc : BenderCtx G)
    (B : BenderSetup G) (D : Case1aData B) {P2 : Subgroup G}
    (hP2le : P2 ≤ CUS B) (hP2grp : IsPGroup D.p P2)
    (hP2sylV2 : ¬ D.p ∣ P2.relIndex (Subgroup.centralizer ((V2 B D : Subgroup G) : Set G))) :
    ∀ v ∈ (V2 B D : Subgroup G), v ≠ 1 →
      ∃ n ∈ Subgroup.normalizer (P2 : Set G), n * B.t * n⁻¹ = v := by
  classical
  haveI : Fact D.p.Prime := ⟨D.hp⟩
  intro v hv hv1
  obtain ⟨g, hgN, hgt⟩ := exists_conj_mem_normalizer_of_isFourGroup T hBc B
    (isFourGroup_V2 B D) (Subgroup.mem_sup_left (Subgroup.mem_zpowers B.t)) hv
    (ne_one_of_orderOf_eq_two B.t_order) hv1
  set V : Subgroup G := (V2 B D : Subgroup G) with hV
  set H : Subgroup G := Subgroup.centralizer (V : Set G) with hH
  have hP2leH : P2 ≤ H := P2_le_centralizer_V2 B D hP2le
  set Q : Subgroup G := P2.map (MulAut.conj g).toMonoidHom with hQ
  have hQH : Q ≤ H := Work.CORE3.Work.CORE3.cj_map_conj_le_centralizer V P2 g hgN hP2leH
  have hQgrp : IsPGroup D.p Q := hP2grp.map (MulAut.conj g).toMonoidHom
  have hcard : Nat.card ↥P2 = Nat.card ↥Q := by
    have h := Subgroup.card_map_of_injective (K := P2) (f := (MulAut.conj g).toMonoidHom)
      (MulAut.conj g).injective
    exact h.symm
  obtain ⟨c, hcH, hcQ⟩ := Work.CORE3.Work.CORE3.cj_ConjSylowOfSubgroup D.p D.hp H P2 Q hP2leH hQH hP2grp hQgrp
    hcard hP2sylV2
  have hfix : ∀ x : G, (c * g) * x * (c * g)⁻¹ = c * (g * x * g⁻¹) * c⁻¹ := by
    intro x; group
  have hcv : c * v * c⁻¹ = v := Work.CORE3.Work.CORE3.cj_conj_eq_self_of_mem_centralizer V hcH hv
  refine ⟨c * g, ?_, ?_⟩
  · rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      rw [hfix x]
      refine (hcQ _).mp ?_
      rw [hQ]
      exact Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hx
    · intro hx
      have h2 : c * (g * x * g⁻¹) * c⁻¹ ∈ P2 := by rw [← hfix x]; exact hx
      have h1 : g * x * g⁻¹ ∈ Q := (hcQ _).mpr h2
      rw [hQ, Work.CORE3.Work.CORE3.cj_mem_map_conj_iff] at h1
      have hconj : g⁻¹ * (g * x * g⁻¹) * g = x := by group
      rwa [hconj] at h1
  · calc (c * g) * B.t * (c * g)⁻¹ = c * (g * B.t * g⁻¹) * c⁻¹ := hfix B.t
      _ = c * v * c⁻¹ := by rw [hgt]
      _ = v := hcv

/-! ## `V₂` misses `O₂(M)` -/

/-- `(O_p(U) ∩ M)` is an odd group: it is a subgroup of the odd-order group `U = O(H)`. -/
theorem odd_card_pCoreIn_inf (B : BenderSetup G) (D : Case1aData B) {M : Subgroup G} :
    Odd (Nat.card ↥(pCoreIn D.p B.U ⊓ M : Subgroup G)) :=
  Odd.of_dvd_nat (Work.CORE2A.bSetup_U_odd B)
    (Subgroup.card_dvd_of_le
      (le_trans inf_le_left (Work.CORE3.c1aPcoreIn_le_self D.p B.U)))

/-- `M` normalizes `O₂(M)`. -/
theorem le_normalizer_pCoreIn_two (M : Subgroup G) :
    M ≤ Subgroup.normalizer ((pCoreIn 2 M : Subgroup G) : Set G) :=
  Work.CORE3.le_normalizer_map_subtype_of_normal' (K := M)
    (Work.GW2.pCore_normal 2 ↥M)

/-- `M` normalizes `E(M) = layerIn M`. -/
theorem le_normalizer_layerIn (M : Subgroup G) :
    M ≤ Subgroup.normalizer ((layerIn M : Subgroup G) : Set G) := by
  have h := Work.CORE3.le_normalizer_map_subtype_of_normal' (K := M)
    (N := Work.GW2.layer ↥M) (Work.CORE3.mdata_layer_normal M)
  simpa [Work.GW2.layerIn] using h

/-- A `p`-group (`p` odd) meets the `2`-core of a subgroup trivially. -/
theorem inf_pCoreIn_two_eq_bot_of_odd {P M : Subgroup G} (hPodd : Odd (Nat.card ↥P)) :
    (P ⊓ pCoreIn 2 M : Subgroup G) = ⊥ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2grp : IsPGroup 2 (pCoreIn 2 M) := Work.CORE3.MData.isPGroup_pCoreIn 2 M
  rw [Subgroup.eq_bot_iff_forall]
  intro y hy
  obtain ⟨hyP, hyO⟩ := Subgroup.mem_inf.mp hy
  have h1 : orderOf y ∣ Nat.card ↥P := Subgroup.orderOf_dvd_natCard _ hyP
  have hodd : Odd (orderOf y) := Odd.of_dvd_nat hPodd h1
  have h2 : orderOf y ∣ Nat.card ↥(pCoreIn 2 M) := Subgroup.orderOf_dvd_natCard _ hyO
  obtain ⟨k, hk⟩ := h2grp.exists_card_eq
  have h3 : orderOf y ∣ 2 ^ k := by rw [← hk]; exact h2
  obtain ⟨j, _, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp h3
  rcases Nat.eq_zero_or_pos j with h' | h'
  · have hone : orderOf y = 1 := by rw [hj, h', pow_zero]
    exact orderOf_eq_one_iff.mp hone
  · exfalso
    rw [hj] at hodd
    exact (Nat.not_even_iff_odd.mpr hodd)
      (even_iff_two_dvd.mpr (dvd_pow_self 2 (Nat.pos_iff_ne_zero.mp h')))

/-- **`t₂ ∉ O₂(M)`.**  `t₂` inverts the nontrivial `p`-group `P₀ = O_p(U) ∩ M`; if `t₂` lay in
`O₂(M)`, then `⁅⟨t₂⟩, P₀⁆` would lie in `O₂(M)`; but `⁅t₂, x⁆ = x⁻²` for `x ∈ P₀` and every
element of the `p`-group `P₀` (`p` odd) is a square, so this forces `P₀ ≤ O₂(M)`, whence
`P₀ = P₀ ⊓ O₂(M) = 1`, contradiction. -/
theorem t2_notMem_pCoreIn_two (B : BenderSetup G) (D : Case1aData B) {M : Subgroup G}
    (hP0 : (pCoreIn D.p B.U ⊓ M : Subgroup G) ≠ ⊥) :
    D.t2 ∉ pCoreIn 2 M := by
  classical
  intro ht2
  set P₀ : Subgroup G := (pCoreIn D.p B.U ⊓ M : Subgroup G) with hP0def
  have hP0mem : ∀ x : G, x ∈ P₀ ↔ x ∈ pCoreIn D.p B.U ∧ x ∈ M := fun x => Subgroup.mem_inf
  have hOnorm : M ≤ Subgroup.normalizer ((pCoreIn 2 M : Subgroup G) : Set G) :=
    le_normalizer_pCoreIn_two M
  -- the commutator group `⁅⟨t₂⟩, P₀⁆` lies in `O₂(M)`
  have hcomm_le : ⁅Subgroup.zpowers D.t2, P₀⁆ ≤ pCoreIn 2 M := by
    rw [Subgroup.commutator_le]
    intro g₁ hg₁ g₂ hg₂
    have hg₁O : g₁ ∈ pCoreIn 2 M := Subgroup.zpowers_le.mpr ht2 hg₁
    have hg₂M : g₂ ∈ M := ((hP0mem g₂).mp hg₂).2
    have hconj : g₂ * g₁ * g₂⁻¹ ∈ pCoreIn 2 M :=
      (Subgroup.mem_normalizer_iff.mp (hOnorm hg₂M) g₁).mp hg₁O
    have heq : ⁅g₁, g₂⁆ = g₁ * (g₂ * g₁ * g₂⁻¹)⁻¹ := by
      rw [commutatorElement_def]; group
    rw [heq]
    exact (pCoreIn 2 M).mul_mem hg₁O ((pCoreIn 2 M).inv_mem hconj)
  -- squares of elements of `P₀` lie in that commutator group
  have hsq : ∀ z ∈ P₀, z ^ 2 ∈ ⁅Subgroup.zpowers D.t2, P₀⁆ := by
    intro z hz
    have hzU : z ∈ pCoreIn D.p B.U := ((hP0mem z).mp hz).1
    have hinv : D.t2 * z * D.t2⁻¹ = z⁻¹ := D.inv z hzU
    have hcommel : ⁅D.t2, z⁆ = z⁻¹ * z⁻¹ := by
      rw [commutatorElement_def, hinv]
    have h1 : z⁻¹ * z⁻¹ ∈ ⁅Subgroup.zpowers D.t2, P₀⁆ := by
      rw [← hcommel]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_zpowers D.t2) hz
    have h2 : z ^ 2 = (z⁻¹ * z⁻¹)⁻¹ := by group
    rw [h2]
    exact (⁅Subgroup.zpowers D.t2, P₀⁆).inv_mem h1
  -- hence every element of `P₀` is a square, so `P₀ ≤ O₂(M)`
  have hP0le : P₀ ≤ pCoreIn 2 M := by
    intro x hx
    have hodd : Odd (Nat.card ↥P₀) := by
      rw [hP0def]; exact odd_card_pCoreIn_inf B D
    have hxN : x ^ (Nat.card ↥P₀) = 1 := by
      have h : orderOf x ∣ Nat.card ↥P₀ := Subgroup.orderOf_dvd_natCard _ hx
      rwa [orderOf_dvd_iff_pow_eq_one] at h
    have hdvd : 2 ∣ Nat.card ↥P₀ + 1 := by
      rcases hodd with ⟨k, hk⟩
      exact ⟨k + 1, by omega⟩
    have hm : 2 * ((Nat.card ↥P₀ + 1) / 2) = Nat.card ↥P₀ + 1 := Nat.mul_div_cancel' hdvd
    have hpow : x ^ (Nat.card ↥P₀ + 1) = (x ^ ((Nat.card ↥P₀ + 1) / 2)) ^ 2 := by
      rw [← pow_mul, Nat.mul_comm, hm]
    have hx1 : x = (x ^ ((Nat.card ↥P₀ + 1) / 2)) ^ 2 := by
      rw [← hpow, pow_succ, hxN, one_mul]
    rw [hx1]
    exact hcomm_le (hsq _ (Subgroup.pow_mem _ hx _))
  -- but `P₀` is odd, so `P₀ = ⊥`, contradiction
  refine hP0 ?_
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  have hxO : x ∈ pCoreIn 2 M := hP0le hx
  have hxinf : x ∈ (P₀ ⊓ pCoreIn 2 M : Subgroup G) := ⟨hx, hxO⟩
  have hbot : (P₀ ⊓ pCoreIn 2 M : Subgroup G) = ⊥ := by
    refine inf_pCoreIn_two_eq_bot_of_odd ?_
    rw [hP0def]; exact odd_card_pCoreIn_inf B D
  rw [hbot] at hxinf
  exact Subgroup.mem_bot.mp hxinf

/-- **`V₂ ⊓ O₂(M) = ⊥`.**  Fusion (`exists_normalizer_conj_of_mem_V2`) makes every nontrivial
element of `V₂` conjugate to `t` by an element of `N_G(P₂) ≤ M`; since `O₂(M) ◁ M` and
`t₂ ∉ O₂(M)` (`t2_notMem_pCoreIn_two`), no nontrivial element of `V₂` lies in `O₂(M)`. -/
theorem inf_pCoreIn_two_eq_bot (T : LocalToolkit) (hBc : BenderCtx G) (B : BenderSetup G)
    (D : Case1aData B) {P2 M : Subgroup G}
    (hP2le : P2 ≤ CUS B) (hP2grp : IsPGroup D.p P2)
    (hP2sylV2 : ¬ D.p ∣ P2.relIndex (Subgroup.centralizer ((V2 B D : Subgroup G) : Set G)))
    (hNM : Subgroup.normalizer (P2 : Set G) ≤ M)
    (hP0 : (pCoreIn D.p B.U ⊓ M : Subgroup G) ≠ ⊥) :
    ¬ ((V2 B D : Subgroup G) ⊓ pCoreIn 2 M ≠ ⊥) := by
  classical
  haveI : Fact D.p.Prime := ⟨D.hp⟩
  intro hne
  obtain ⟨x, hx, hxb⟩ := IsConcreteLE.exists_of_lt (bot_lt_iff_ne_bot.mpr hne)
  have hx1 : x ≠ 1 := fun h => hxb (Subgroup.mem_bot.mpr h)
  have hxV : x ∈ (V2 B D : Subgroup G) := hx.1
  have hxO : x ∈ pCoreIn 2 M := hx.2
  -- fusion: `t` is conjugate to `x` by an element of `N_G(P₂) ≤ M`
  obtain ⟨n, hnN, hnx⟩ := exists_normalizer_conj_of_mem_V2 T hBc B D hP2le hP2grp hP2sylV2
    x hxV hx1
  have hnM : n ∈ M := hNM hnN
  have hOnorm : M ≤ Subgroup.normalizer ((pCoreIn 2 M : Subgroup G) : Set G) :=
    le_normalizer_pCoreIn_two M
  have htO : B.t ∈ pCoreIn 2 M := by
    have h1 : x ∈ pCoreIn 2 M ↔ (n⁻¹) * x * (n⁻¹)⁻¹ ∈ pCoreIn 2 M :=
      Subgroup.mem_normalizer_iff.mp (hOnorm (M.inv_mem hnM)) x
    have h2 : (n⁻¹) * x * (n⁻¹)⁻¹ = B.t := by rw [← hnx]; group
    rw [h2] at h1
    exact h1.mp hxO
  -- then also `t₂ ∈ O₂(M)`
  obtain ⟨m, hmN, hmx⟩ := exists_normalizer_conj T hBc B D hP2le hP2grp hP2sylV2
  have hmM : m ∈ M := hNM hmN
  have ht2O : D.t2 ∈ pCoreIn 2 M := by
    have h1 : B.t ∈ pCoreIn 2 M ↔ m * B.t * m⁻¹ ∈ pCoreIn 2 M :=
      Subgroup.mem_normalizer_iff.mp (hOnorm hmM) B.t
    rw [hmx] at h1
    exact h1.mp htO
  exact t2_notMem_pCoreIn_two B D hP0 ht2O

/-! ## The upgrade: `V₂ ⊓ E(M) ≠ ⊥ → V₂ ≤ E(M)` -/

/-- **`V₂ ⊓ E(M) ≠ ⊥` implies `V₂ ≤ E(M)`.**  `E = layerIn M` is normal in `M`, and fusion in
`N_G(P₂) ≤ M` makes every nontrivial element of `V₂` conjugate to `t` by an element of `M`.
Hence a nontrivial element of `V₂ ⊓ E` forces `t ∈ E`, and then `t₂ ∈ E` as well. -/
theorem V2_le_layerIn_of_inf (T : LocalToolkit) (hBc : BenderCtx G) (B : BenderSetup G)
    (D : Case1aData B) {P2 M : Subgroup G}
    (hP2le : P2 ≤ CUS B) (hP2grp : IsPGroup D.p P2)
    (hP2sylV2 : ¬ D.p ∣ P2.relIndex (Subgroup.centralizer ((V2 B D : Subgroup G) : Set G)))
    (hNM : Subgroup.normalizer (P2 : Set G) ≤ M)
    (hinf : (V2 B D : Subgroup G) ⊓ layerIn M ≠ ⊥) :
    (V2 B D : Subgroup G) ≤ layerIn M := by
  classical
  haveI : Fact D.p.Prime := ⟨D.hp⟩
  obtain ⟨x, hx, hxb⟩ := IsConcreteLE.exists_of_lt (bot_lt_iff_ne_bot.mpr hinf)
  have hx1 : x ≠ 1 := fun h => hxb (Subgroup.mem_bot.mpr h)
  have hxV : x ∈ (V2 B D : Subgroup G) := hx.1
  have hxE : x ∈ layerIn M := hx.2
  have hEnorm : M ≤ Subgroup.normalizer ((layerIn M : Subgroup G) : Set G) :=
    le_normalizer_layerIn M
  have hconj_mem : ∀ y : G, y ∈ layerIn M → ∀ g ∈ M, g * y * g⁻¹ ∈ layerIn M := by
    intro y hy g hg
    exact (Subgroup.mem_normalizer_iff.mp (hEnorm hg) y).mp hy
  -- fusion: `x` is the conjugate of `t` by an element of `N_G(P₂) ≤ M`
  obtain ⟨n, hnN, hnx⟩ := exists_normalizer_conj_of_mem_V2 T hBc B D hP2le hP2grp hP2sylV2
    x hxV hx1
  have hnM : n ∈ M := hNM hnN
  have htE : B.t ∈ layerIn M := by
    have h1 : (n⁻¹) * x * (n⁻¹)⁻¹ ∈ layerIn M := hconj_mem x hxE n⁻¹ (M.inv_mem hnM)
    have h2 : (n⁻¹) * x * (n⁻¹)⁻¹ = B.t := by rw [← hnx]; group
    rwa [h2] at h1
  -- and then `t₂ ∈ E` too
  obtain ⟨m, hmN, hmx⟩ := exists_normalizer_conj T hBc B D hP2le hP2grp hP2sylV2
  have hmM : m ∈ M := hNM hmN
  have ht2E : D.t2 ∈ layerIn M := by
    have h1 : m * B.t * m⁻¹ ∈ layerIn M := hconj_mem B.t htE m hmM
    rwa [hmx] at h1
  rw [V2]
  exact sup_le (Subgroup.zpowers_le.mpr htE) (Subgroup.zpowers_le.mpr ht2E)

/-! ## The deliverable -/

theorem V2LayerMne (I : Work.CORE3.Case1Inputs) (hFr : Work.GW2.Case1aFrattiniProp)
    (hAb : Work.GW2.Case1aAbelianProp) :
    ∀ (G : Type) [Group G] [Finite G], Work.GW2.FeitThompsonProp → Work.GW2.BenderCtx G →
      ∀ B : Work.GW2.BenderSetup G,
      Work.GW2.Case1 B → B.Hhat = B.H → ∀ D : Work.GW2.Case1aData B, ∀ P2 M : Subgroup G,
        P2 ≤ B.U ⊓ Subgroup.centralizer ((B.S : Subgroup G) : Set G) → IsPGroup D.p P2 →
        ¬ D.p ∣ P2.relIndex (B.U ⊓ Subgroup.centralizer ((B.S : Subgroup G) : Set G)) →
        IsCoatom M → Subgroup.normalizer (P2 : Set G) ≤ M → M ≠ B.H →
        (Work.GW2.pCoreIn D.p B.U ⊓ M : Subgroup G) ≠ ⊥ →
        (Subgroup.zpowers B.t ⊔ Subgroup.zpowers D.t2 : Subgroup G) ≤ Work.GW2.layerIn M := by
  intro G _instG _finG hFT hBc B hCase hHhat D P2 M hP2le hP2grp hP2ndvd hMcoat hNM _hMneH hP0
  haveI : Fact D.p.Prime := ⟨D.hp⟩
  -- `V₂ ≤ S ≤ M`
  have hSlM : (B.S : Subgroup G) ≤ M := S_le_M B hP2le hNM
  have hV2S : (V2 B D : Subgroup G) ≤ (B.S : Subgroup G) := V2_le_S B D
  have hV2M : (V2 B D : Subgroup G) ≤ M := hV2S.trans hSlM
  have hV4 : IsFourGroup (V2 B D) := isFourGroup_V2 B D
  -- `P₂ ∈ Syl_p(C_G(V₂))`
