import Mathlib
import Submission.Work.CORE3.Defs

/-!
# `C_G(S) = C_G(t₁) ∩ C_G(t₂)` in subcase `Ĥ = H`

Bender 1981 §3 fixes, in the subcase `Ĥ = H`, involutions `t₁, t₂ ∈ S − S₀` and observes that
`S₀ = ⟨t₁ t₂⟩` (`S₀` cyclic of index two in `S`).  The subgroup generated by `S₀` and `t₁` is
therefore all of `S`, and `C_G(S)` — the centralizer of the Sylow subgroup `S` — is the
intersection of the centralizers of the two generators `t₁ t₂` and `t₁`.  Since `t₁ t₂`
commutes with an element exactly when `t₁` and `t₂` both do, this is the same as
`C_G(t₁) ∩ C_G(t₂)`, the form in which the centralizer of `S` is used below (e.g. in
`Work.GW2.Case1aData`'s `B = C_U(S)` and in the Theorem C inputs).

Everything here is elementary group theory; no hypothesis on the Sylow subgroup beyond
`S₀ ≤ S`, `[S : S₀] = 2`, `t₁ ∈ S − S₀` is used.
-/

namespace Work.CORE3

/-- Centralizer of a supremum of subgroups: `C_G(H ⊔ K) = C_G(H) ⊓ C_G(K)`. -/
private lemma centralizer_sup_subgroup {G : Type} [Group G] (H K : Subgroup G) :
    Subgroup.centralizer ((H ⊔ K : Subgroup G) : Set G) =
      Subgroup.centralizer (H : Set G) ⊓ Subgroup.centralizer (K : Set G) := by
  have h : ((H ⊔ K : Subgroup G) : Set G) =
      (Subgroup.closure ((H : Set G) ∪ (K : Set G)) : Set G) := by
    congr 1
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
  rw [h, Subgroup.centralizer_closure]
  ext x
  simp only [Subgroup.mem_centralizer_iff, Set.mem_union, Subgroup.mem_inf]
  constructor
  · intro hx
    exact ⟨fun y hy => hx y (Or.inl hy), fun y hy => hx y (Or.inr hy)⟩
  · rintro ⟨h1, h2⟩ y (hy | hy)
    · exact h1 y hy
    · exact h2 y hy

/-- `C_G(a b) ⊓ C_G(a) = C_G(a) ⊓ C_G(b)`: an element commutes with `a` and `b` iff it
commutes with `a` and `a b` (indeed `b = a⁻¹ (a b)`). -/
private lemma centralizer_singleton_mul {G : Type} [Group G] (a b : G) :
    Subgroup.centralizer ({a * b} : Set G) ⊓ Subgroup.centralizer ({a} : Set G) =
      Subgroup.centralizer ({a} : Set G) ⊓ Subgroup.centralizer ({b} : Set G) := by
  refine le_antisymm ?_ ?_
  · intro g hg
    rw [Subgroup.mem_inf] at hg
    obtain ⟨h2, h1⟩ := hg
    rw [Subgroup.mem_centralizer_singleton_iff] at h1 h2
    have h1' : Commute g a := h1
    have h2' : Commute g (a * b) := h2
    have hb : Commute g b := by
      simpa [inv_mul_cancel_left] using ((h1'.inv_right).mul_right h2')
    exact ⟨Subgroup.mem_centralizer_singleton_iff.mpr h1,
      Subgroup.mem_centralizer_singleton_iff.mpr hb.eq⟩
  · intro g hg
    rw [Subgroup.mem_inf] at hg
    obtain ⟨h1, h2⟩ := hg
    rw [Subgroup.mem_centralizer_singleton_iff] at h1 h2
    have h1' : Commute g a := h1
    have h2' : Commute g b := h2
    exact ⟨Subgroup.mem_centralizer_singleton_iff.mpr (h1'.mul_right h2').eq,
      Subgroup.mem_centralizer_singleton_iff.mpr h1⟩

theorem c1aDirCentS {G : Type} [Group G] [Finite G] (B : Work.GW2.BenderSetup G)
    (D : Work.GW2.Case1aData B) (hgen : B.S0 = Subgroup.zpowers (D.t1 * D.t2)) :
    Subgroup.centralizer ((B.S : Subgroup G) : Set G) =
      Subgroup.centralizer ({D.t1} : Set G) ⊓ Subgroup.centralizer ({D.t2} : Set G) := by
  -- `t₁ ∈ S − S₀` and `[S : S₀] = 2` force `S = ⟨S₀, t₁⟩`.
  have hsup : (B.S : Subgroup G) = B.S0 ⊔ Subgroup.zpowers D.t1 := by
    have hTS : B.S0 ⊔ Subgroup.zpowers D.t1 ≤ (B.S : Subgroup G) :=
      sup_le B.S0_le (Subgroup.zpowers_le.mpr D.t1_mem)
    refine le_antisymm ?_ hTS
    have hmul := Subgroup.relIndex_mul_relIndex B.S0 (B.S0 ⊔ Subgroup.zpowers D.t1)
      (B.S : Subgroup G) (le_sup_left : B.S0 ≤ B.S0 ⊔ Subgroup.zpowers D.t1) hTS
    rw [B.S0_index] at hmul
    have hne : (B.S0.relIndex (B.S0 ⊔ Subgroup.zpowers D.t1)) ≠ 1 := by
      intro h1
      exact D.t1_nmem (Subgroup.relIndex_eq_one.mp h1
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers D.t1)))
    have hdvd : (B.S0.relIndex (B.S0 ⊔ Subgroup.zpowers D.t1)) ∣ 2 :=
      ⟨(B.S0 ⊔ Subgroup.zpowers D.t1).relIndex (B.S : Subgroup G), hmul.symm⟩
    rw [Nat.dvd_prime Nat.prime_two] at hdvd
    have h2 : B.S0.relIndex (B.S0 ⊔ Subgroup.zpowers D.t1) = 2 := hdvd.resolve_left hne
    have hb : (B.S0 ⊔ Subgroup.zpowers D.t1).relIndex (B.S : Subgroup G) = 1 := by
      rw [h2] at hmul
      omega
    exact Subgroup.relIndex_eq_one.mp hb
  -- `S₀ = ⟨t₁ t₂⟩`, so `C_G(S₀) = C_G(t₁ t₂)`; and `C_G(⟨t₁⟩) = C_G(t₁)`.
  have hC1 : Subgroup.centralizer (Subgroup.zpowers D.t1 : Set G) =
      Subgroup.centralizer ({D.t1} : Set G) := by
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  have hC0 : Subgroup.centralizer (B.S0 : Set G) =
      Subgroup.centralizer ({D.t1 * D.t2} : Set G) := by
    rw [hgen, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  rw [hsup, centralizer_sup_subgroup, hC1, hC0]
  exact centralizer_singleton_mul D.t1 D.t2

end Work.CORE3
