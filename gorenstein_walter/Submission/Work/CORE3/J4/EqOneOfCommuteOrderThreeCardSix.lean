import Mathlib

/-!
# `Work.CORE3.J4.EqOneOfCommuteOrderThreeCardSix`

In a non-commutative group `Q` of order `6`, an involution `r` (`r * r = 1`) commuting with an
element `q` of order `3` must be trivial.

There are only two groups of order `6`: the cyclic group `C₆` and the symmetric group `S₃`.  In
`C₆` the element of order `3` is `g²`, and its centralizer is all of `C₆`; but the squaring map of
`C₆` is an automorphism, so no non-trivial `r` satisfies `r * r = 1` there.  In `S₃` the unique
subgroup of order `3` consists of 3-cycles, and every involution (transposition) inverts a
3-cycle, so no involution commutes with an element of order `3`.  Hence in either case a
commuting involution is forced to be `1`.

Formally: were `r ≠ 1`, then `r` would have order `2`; since `q` and `r` commute and their orders
`3` and `2` are coprime, `q * r` would have order `3 * 2 = 6 = |Q|`.  Consequently the cyclic
subgroup `⟨q * r⟩` is all of `Q`, making `Q` cyclic and hence commutative, contradicting
`hnonab`.
-/

namespace Work.CORE3.J4

/-- Two elements lying in the cyclic subgroup generated by `x` commute. -/
private theorem mul_comm_of_mem_zpowers {H : Type*} [Group H] (x a b : H)
    (ha : a ∈ Subgroup.zpowers x) (hb : b ∈ Subgroup.zpowers x) : a * b = b * a := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp ha
  obtain ⟨l, hl⟩ := Subgroup.mem_zpowers_iff.mp hb
  rw [← hk, ← hl]
  exact ((Commute.refl x).zpow_left k).zpow_right l

theorem EqOneOfCommuteOrderThreeCardSix {Q : Type*} [Group Q] [Finite Q]
    (hcard : Nat.card Q = 6) (hnonab : ∃ a b : Q, a * b ≠ b * a)
    {q r : Q} (hq : orderOf q = 3) (hr : r * r = 1) (hc : q * r = r * q) : r = 1 := by
  by_contra hr1
  -- `Q` is not commutative, expressed through the class `IsMulCommutative`.
  have hnab : ¬ IsMulCommutative Q := by
    rintro ⟨hcomm⟩
    obtain ⟨a, b, hab⟩ := hnonab
    exact hab (hcomm.comm a b)
  -- A nontrivial element squaring to `1` has order `2`.
  have hr2 : orderOf r = 2 := by
    apply orderOf_eq_prime
    · rw [pow_two]; exact hr
    · exact hr1
  -- `q` and `r` commute, with coprime orders, so `q * r` has order `3 * 2 = 6`.
  have hcomm : Commute q r := hc
  have hcop : (orderOf q).Coprime (orderOf r) := by rw [hq, hr2]; norm_num
  have hsix : orderOf (q * r) = 6 := by
    simp [hcomm.orderOf_mul_eq_mul_orderOf_of_coprime hcop, hq, hr2]
  -- Since `orderOf (q * r) = 6 = |Q|`, the cyclic subgroup `⟨q * r⟩` is the whole group.
  have htop : Subgroup.zpowers (q * r) = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers, hsix, hcard]
  -- Therefore every pair of elements of `Q` lies in a common cyclic subgroup and commutes.
  apply hnab
  refine IsMulCommutative.mk ⟨fun a b => ?_⟩
  exact mul_comm_of_mem_zpowers (q * r) a b
    (by rw [htop]; exact Subgroup.mem_top a)
    (by rw [htop]; exact Subgroup.mem_top b)

end Work.CORE3.J4
