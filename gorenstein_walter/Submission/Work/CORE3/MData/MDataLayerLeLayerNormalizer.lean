import Mathlib
import Submission.Work.CORE3.Defs
import Submission.Work.CORE3.MDataAux
import Submission.Work.CORE3.MData.Case1SUCommLeFitting
import Submission.Work.BMAX.Components.subnormal_le_centralizer_or_eq_of_isQuasisimple
import Submission.Work.CORE2A.isFourGroup_closure_pair
import Submission.Work.CORE2A.thm26_aux

/-!
# CORE3 `M`-analysis: `E(M) ≤ E(N_G(X))`

Bender 1981, §3, p. 223: "Again by Lemma 2.9, `E(N_G(X))` contains and hence equals `E`
whenever `1 ≠ X ⊆ B ∩ M`."

In this formalisation the local-control clause is stated for `1 ≠ X ≤ O(M) = B ⊓ M`
(`Work.CORE3.MDataLocalControlOddCore`), and the missing building block is the inclusion
`E(M) ≤ E(N_G(X))` (`E = layerIn`), which is what this file proves
(`Work.CORE3.MData.MDataLayerLeLayerNormalizer`).

## The argument

Write `E = E(M) = layerIn M`, `N = N_G(X)`, `V = ⟨t, t₂⟩`.  From `hA7`, `E` is quasisimple
with odd centre and `V ≤ E`; and `X ≤ O(M) ≤ C_G(E)`
(`Work.CORE3.mdata_oddCore_le_centralizer_layer`), so `E ≤ N`.  Lemma 2.9 (`I.h29`) applied
to `V` and `N` gives `V ⊓ O₂(N) ≠ ⊥ ∨ V ⊓ E(N) ≠ ⊥`; its side condition is discharged by
`mdata_h29_side` below (`X = ⁅s,X⁆ ≤ ⁅S,U⁆ ≤ F(U)`, so Case (1) gives `N_G(X) ≤ H = C(t)` and
`⟨t⟩ ◁ N_G(X)` is a normal `2`-subgroup).

* The first disjunct is impossible: a nontrivial element `z ∈ V ⊓ O₂(N)` is an involution of
  `E`, and `O₂(N) ⊓ E ◁ E`; either it lies in `Z(E)` (contradiction with `Z(E)` odd) or
  `E ≤ O₂(N)` (then `E` is a `2`-group, hence solvable, contradicting its perfectness).
* In the second case `V ⊓ E(N) ≠ ⊥`: pick `1 ≠ z ∈ V ⊓ E(N)`.  The subgroup
  `D = E(M) ⊓ E(N)` is normal in `E(M)`, so either `D ≤ C(E(M))` — then `z ∈ Z(E(M))` has
  order `2`, against `Z(E(M))` odd — or `E(M) ≤ D ≤ E(N)`.
-/

set_option linter.style.haveILetI false

namespace Work.CORE3.MData

open Subgroup
open Work.GW2

/-! ## Elementary auxiliary facts -/

/-- `O_p(K)` is a `p`-group (the contract's `pCore` is Isaacs' `opCore`). -/
theorem isPGroup_pCoreIn {G : Type} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (K : Subgroup G) : IsPGroup p ↥(Work.GW2.pCoreIn p K) := by
  rw [Work.GW2.pCoreIn, Work.CORE2A.pCore_eq_opCore (G := ↥K) (p := p)]
  exact IsPGroup.map (OddOrder.Isaacs.Ch01.opCore_isPGroup p ↥K) K.subtype

/-- Quasisimplicity is preserved by injective homomorphisms. -/
theorem isQuasisimple_map {G N : Type*} [Group G] [Group N] (f : G →* N)
    (hf : Function.Injective f) {E : Subgroup G} (hE : Work.GW2.IsQuasisimple E) :
    Work.GW2.IsQuasisimple (E.map f) := by
  obtain ⟨h1, h2⟩ := hE
  haveI := h2
  refine ⟨?_, ?_⟩
  · rw [← Subgroup.map_commutator, h1]
  · have e : ↥(E.map f) ≃* ↥E := (Subgroup.equivMapOfInjective E f hf).symm
    have hcen : Subgroup.map (e : ↥(E.map f) →* ↥E) (Subgroup.center ↥(E.map f)) =
        Subgroup.center ↥E :=
      Subgroup.map_center_eq e
    exact MulEquiv.isSimpleGroup
      (QuotientGroup.congr (Subgroup.center ↥(E.map f)) (Subgroup.center ↥E) e hcen)

/-- The subgroup generated by two distinct commuting involutions, in the `zpowers`-sup form
used in the `M`-analysis. -/
theorem isFourGroup_zpowers_sup {G : Type} [Group G] {a b : G}
    (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1) (hc : a * b = b * a)
    (ha1 : a ≠ 1) (hb1 : b ≠ 1) (hab : a ≠ b) :
    Work.GW2.IsFourGroup (Subgroup.zpowers a ⊔ Subgroup.zpowers b) := by
  have hset : ({a} : Set G) ∪ {b} = {a, b} := by
    ext x
    simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]
  have hsup : Subgroup.zpowers a ⊔ Subgroup.zpowers b =
      Subgroup.closure ({a, b} : Set G) := by
    rw [Subgroup.zpowers_eq_closure a, Subgroup.zpowers_eq_closure b,
      ← Subgroup.closure_union, hset]
  rw [hsup]
  exact Work.CORE2A.isFourGroup_closure_pair ha2 hb2 hc ha1 hb1 hab

/-- An involution of `E(M) = layerIn M` that centralizes `E(M)` is impossible: it would be an
involution of the centre `Z(E(M))`, which has odd order. -/
theorem not_involution_of_mem_centralizer_layerIn {G : Type} [Group G] (M : Subgroup G)
    (hZodd : Odd (Nat.card (Subgroup.center ↥(Work.GW2.layer ↥M))))
    {z : G} (hzE : z ∈ Work.GW2.layerIn M)
    (hzcen : z ∈ Subgroup.centralizer ((Work.GW2.layerIn M : Subgroup G) : Set G))
    (hzord : orderOf z = 2) : False := by
  obtain ⟨y, hy, hyval⟩ := Subgroup.mem_map.mp hzE
  have hyval' : (y : G) = z := hyval
  have hycenter : (⟨y, hy⟩ : ↥(Work.GW2.layer ↥M)) ∈
      Subgroup.center ↥(Work.GW2.layer ↥M) := by
    rw [Subgroup.mem_center_iff]
    intro w
    apply Subtype.ext
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    have hcomm : (w : G) * z = z * (w : G) :=
      Subgroup.mem_centralizer_iff.mp hzcen (w : G) (Subgroup.mem_map_of_mem M.subtype w.2)
    rw [← hyval'] at hcomm
    exact hcomm
  have hord : orderOf (⟨(⟨y, hy⟩ : ↥(Work.GW2.layer ↥M)), hycenter⟩ :
      ↥(Subgroup.center ↥(Work.GW2.layer ↥M))) = 2 := by
    rw [Subgroup.orderOf_mk, Subgroup.orderOf_mk, ← Subgroup.orderOf_coe y, hyval', hzord]
  have hdvd : 2 ∣ Nat.card (Subgroup.center ↥(Work.GW2.layer ↥M)) := by
    have h := orderOf_dvd_natCard (⟨(⟨y, hy⟩ : ↥(Work.GW2.layer ↥M)), hycenter⟩ :
      ↥(Subgroup.center ↥(Work.GW2.layer ↥M)))
    rwa [hord] at h
  exact (Nat.not_even_iff_odd.mpr hZodd) (even_iff_two_dvd.mpr hdvd)

/-! ## The side condition of Lemma 2.9 -/

/-- Bender 1981, Lemma 2.9, side condition.  For `s ∈ S` and `1 ≠ X ≤ U = O(H)` with
`X = ⁅⟨s⟩,X⁆` we have `X ≤ ⁅⟨s⟩,U⁆ ≤ ⁅S,U⁆ ≤ F(U)`
(`Work.CORE3.MData.Case1SUCommLeFitting`), so Case (1) of Theorem 2.10 gives
`N_G(X) ≤ Ĥ = H = C_G(t)`; in particular `t` is central in `N_G(X)`, and `⟨t⟩ ◁ N_G(X)` is a
normal `2`-subgroup, i.e. `t ∈ O₂(N_G(X))`. -/
theorem mdata_h29_side {G : Type} [Group G] [Finite G] (hFT : Work.GW2.FeitThompsonProp)
    (hCtx : Work.GW2.BenderCtx G) (B : Work.GW2.BenderSetup G) (hCase : Work.GW2.Case1 B)
    (hHhat : B.Hhat = B.H) :
    ∀ (s : G) (X : Subgroup G), s ∈ (B.S : Subgroup G) → X ≤ B.U → X ≠ ⊥ →
      ⁅Subgroup.zpowers s, X⁆ = X →
        B.t ∈ Work.GW2.pCoreIn 2 (Subgroup.normalizer (X : Set G)) := by
  intro s X hsS hXU hXne hcomm
  set N : Subgroup G := Subgroup.normalizer (X : Set G) with hNdef
  -- `X ≤ F(U)`, so Case (1) controls `N_G(X)`
  have hXfit : X ≤ Work.GW2.fittingIn B.U := by
    have h1 : X ≤ ⁅(B.S : Subgroup G), B.U⁆ := by
      rw [← hcomm]
      exact Subgroup.commutator_mono (Subgroup.zpowers_le.mpr hsS) hXU
    exact h1.trans (Work.CORE3.MData.Case1SUCommLeFitting hFT hCtx B hCase)
  have hNle : N ≤ B.H := by
    have h := hCase.2 X hXne hXfit
    rwa [hHhat] at h
  -- every element of `U ≤ H = C(t)` commutes with `t`
  have hcomm_Ut : ∀ h ∈ B.U, B.t * h * B.t⁻¹ = h := by
    intro h hh
    have hhH : h ∈ B.H := Work.CORE3.oddCoreIn_le_self B.H hh
    have hch : B.t * h = h * B.t :=
      Subgroup.mem_centralizer_iff.mp hhH B.t (Set.mem_singleton B.t)
    rw [hch, mul_assoc, mul_inv_cancel, mul_one]
  have hcomm_Ut' : ∀ h ∈ B.U, B.t⁻¹ * h * B.t = h := by
    intro h hh
    have hhH : h ∈ B.H := Work.CORE3.oddCoreIn_le_self B.H hh
    have hch : B.t * h = h * B.t :=
      Subgroup.mem_centralizer_iff.mp hhH B.t (Set.mem_singleton B.t)
    rw [mul_assoc, ← hch, ← mul_assoc, inv_mul_cancel, one_mul]
  -- `t ∈ N_G(X)`
  have htN : B.t ∈ N := by
    rw [hNdef, Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · intro hh
      rw [hcomm_Ut h (hXU hh)]
      exact hh
    · intro hh
      have hu : B.t * h * B.t⁻¹ ∈ B.U := hXU hh
      have heq : h = B.t⁻¹ * (B.t * h * B.t⁻¹) * B.t := by group
      rw [heq, hcomm_Ut' _ hu]
      exact hh
  -- `t` is central in `N`
  have htcenter : (⟨B.t, htN⟩ : ↥N) ∈ Subgroup.center ↥N := by
    rw [Subgroup.mem_center_iff]
    intro n
    apply Subtype.ext
    exact (Subgroup.mem_centralizer_iff.mp (hNle n.2) B.t (Set.mem_singleton B.t)).symm
  -- `⟨t⟩ ◁ N` is a normal `2`-subgroup
  have hzpnorm : (Subgroup.zpowers (⟨B.t, htN⟩ : ↥N)).Normal := by
    refine Subgroup.Normal.mk (fun n hn g => ?_)
    have hgn : g * n = n * g := by
      have hn_center : n ∈ Subgroup.center ↥N := Subgroup.zpowers_le.mpr htcenter hn
      exact Subgroup.mem_center_iff.mp hn_center g
    rw [hgn, mul_assoc, mul_inv_cancel, mul_one]
    exact hn
  have hzpP : IsPGroup 2 ↥(Subgroup.zpowers (⟨B.t, htN⟩ : ↥N)) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_zpowers, Subgroup.orderOf_mk, B.t_order]
    norm_num
  have hzp_le : Subgroup.zpowers (⟨B.t, htN⟩ : ↥N) ≤ Work.GW2.pCore 2 ↥N := by
    change Subgroup.zpowers (⟨B.t, htN⟩ : ↥N) ≤
      (sSup {K : Subgroup ↥N | K.Normal ∧ IsPGroup 2 K}).normalCore
    intro k hk b
    exact le_sSup (s := {K : Subgroup ↥N | K.Normal ∧ IsPGroup 2 K})
      ⟨hzpnorm, hzpP⟩ (hzpnorm.conj_mem k hk b)
  rw [Work.GW2.pCoreIn]
  exact Subgroup.mem_map_of_mem N.subtype (hzp_le (Subgroup.mem_zpowers _))

/-! ## The main theorem -/

theorem MDataLayerLeLayerNormalizer (I : Work.CORE3.Case1Inputs) (hA7 : Work.GW2.Case1aA7Prop) :
    ∀ (G : Type) [Group G] [Finite G], Work.GW2.FeitThompsonProp → Work.GW2.BenderCtx G →
      ∀ B : Work.GW2.BenderSetup G, Work.GW2.Case1 B → B.Hhat = B.H →
      ∀ D : Work.GW2.Case1aData B, ∀ P2 M : Subgroup G,
      P2 ≤ B.U ⊓ Subgroup.centralizer ((B.S : Subgroup G) : Set G) → IsPGroup D.p P2 →
      ¬ D.p ∣ P2.relIndex (B.U ⊓ Subgroup.centralizer ((B.S : Subgroup G) : Set G)) →
      IsCoatom M → Subgroup.normalizer (P2 : Set G) ≤ M →
      ∀ X : Subgroup G, X ≠ ⊥ → X ≤ Work.GW2.oddCoreIn M →
        Work.GW2.layerIn M ≤ Work.GW2.layerIn (Subgroup.normalizer (X : Set G)) := by
  intro G _instG _finG hFT hCtx B hCase hHhat D P2 M hPle hPgrp hPndvd hMcoat hNM X hXne hXle
  classical
  haveI hGsimple : IsSimpleGroup G := hCtx.simple
  obtain ⟨hSM, hV2, hEiso, hScard, hP0card⟩ :=
    hA7 G hFT hCtx B hCase hHhat D P2 M hPle hPgrp hPndvd hMcoat hNM
  -- `E(M) = layerIn M` is nontrivial, quasisimple, with odd centre
  have ht_mem : B.t ∈ Work.GW2.layerIn M :=
    hV2 (Subgroup.mem_sup_left (Subgroup.mem_zpowers B.t))
  have hlayer_ne : Work.GW2.layer ↥M ≠ ⊥ := by
    intro hbot
    have hmem : B.t ∈ (⊥ : Subgroup G) := by
      rw [Work.GW2.layerIn, hbot, Subgroup.map_bot] at ht_mem
      exact ht_mem
    exact Work.CORE2A.bSetup_t_ne_one B (Subgroup.mem_bot.mp hmem)
  obtain ⟨hEqM, hZoddM⟩ := Work.CORE3.mdata_layer_quasisimple I hCtx B hMcoat hlayer_ne
  have hEqM' : Work.GW2.IsQuasisimple (Work.GW2.layerIn M) :=
    isQuasisimple_map M.subtype M.subtype_injective hEqM
  -- `X ≤ O(M) ≤ C_G(E(M))`
  have hXcen : X ≤ Subgroup.centralizer ((Work.GW2.layerIn M : Subgroup G) : Set G) :=
    hXle.trans (Work.CORE3.mdata_oddCore_le_centralizer_layer M hFT hEqM)
  set N : Subgroup G := Subgroup.normalizer (X : Set G) with hNdef
  -- `E(M) ≤ N`
  have hEleN : Work.GW2.layerIn M ≤ N := by
    rw [Subgroup.le_normalizer_iff]
    intro e he x hx
    have hcomm : e * x = x * e := Subgroup.mem_centralizer_iff.mp (hXcen hx) e he
    rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
    exact hx
  -- `N ≠ ⊤`
  have hNne : N ≠ ⊤ := by
    intro htop
    have hXn : X.Normal := Subgroup.normalizer_eq_top_iff.mp (by rw [← hNdef]; exact htop)
    haveI := hXn
    have hXM : X ≤ M := hXle.trans (Work.CORE3.oddCoreIn_le_self M)
    rcases Subgroup.Normal.eq_bot_or_eq_top X with h | h
    · exact hXne h
    · exact hMcoat.ne_top (top_le_iff.mp (h ▸ hXM))
  -- the Klein four-group `V = ⟨t, t₂⟩`
  set V : Subgroup G := Subgroup.zpowers B.t ⊔ Subgroup.zpowers D.t2 with hVdef
  have hV4 : Work.GW2.IsFourGroup V := by
    refine isFourGroup_zpowers_sup (a := B.t) (b := D.t2) ?_ ?_ ?_ ?_ ?_ ?_
    · rw [← B.t_order]; exact pow_orderOf_eq_one B.t
    · rw [← D.t2_order]; exact pow_orderOf_eq_one D.t2
    · exact Subgroup.mem_centralizer_iff.mp (Work.CORE2A.bSetup_S_le_H B D.t2_mem)
        B.t (Set.mem_singleton B.t)
    · exact Work.CORE2A.bSetup_t_ne_one B
    · intro h
      have h2 : orderOf D.t2 = 2 := D.t2_order
      rw [h, orderOf_one] at h2
      exact absurd h2 (by norm_num)
    · intro h; exact D.t2_nmem (h ▸ B.t_mem)
  have htV : B.t ∈ V := Subgroup.mem_sup_left (Subgroup.mem_zpowers B.t)
  have hVS : V ≤ (B.S : Subgroup G) :=
    sup_le (Subgroup.zpowers_le.mpr (B.S0_le B.t_mem)) (Subgroup.zpowers_le.mpr D.t2_mem)
  have hVleN : V ≤ N := hV2.trans hEleN
  -- Lemma 2.9
  have h29 := I.h29 G hFT hCtx B V N hVleN hNne hVS htV hV4
    (mdata_h29_side hFT hCtx B hCase hHhat)
  rcases h29 with hO2 | hEN
  · -- `V ⊓ O₂(N) ≠ ⊥` is impossible
    exfalso
    have hlt : (⊥ : Subgroup G) < V ⊓ Work.GW2.pCoreIn 2 N := bot_lt_iff_ne_bot.mpr hO2
    obtain ⟨z, hz, hzb⟩ := IsConcreteLE.exists_of_lt hlt
    have hzV : z ∈ V := hz.1
    have hzO : z ∈ Work.GW2.pCoreIn 2 N := hz.2
    have hz1 : z ≠ 1 := fun h => hzb (Subgroup.mem_bot.mpr h)
    have hzE : z ∈ Work.GW2.layerIn M := (hV2 : V ≤ Work.GW2.layerIn M) hzV
    have hz2 : z ^ 2 = 1 := hV4.2 z hzV
    have hzord : orderOf z = 2 := orderOf_eq_prime hz2 hz1
    have hNnormO : N ≤ Subgroup.normalizer ((Work.GW2.pCoreIn 2 N : Subgroup G) : Set G) :=
      Work.CORE3.le_normalizer_map_subtype_of_normal' (K := N) (Work.GW2.pCore_normal 2 ↥N)
    have hDsub : ((Work.GW2.pCoreIn 2 N ⊓ Work.GW2.layerIn M).subgroupOf
        (Work.GW2.layerIn M)).Normal := by
      rw [Subgroup.normal_subgroupOf_iff inf_le_right]
      intro h k hh kk
      refine ⟨?_, ?_⟩
      · exact (Subgroup.mem_normalizer_iff.mp (hNnormO (hEleN kk)) h).1 hh.1
      · exact (Work.GW2.layerIn M).mul_mem
          ((Work.GW2.layerIn M).mul_mem kk hh.2) ((Work.GW2.layerIn M).inv_mem kk)
    rcases Work.BMAX.Components.subnormal_le_centralizer_or_eq_of_isQuasisimple inf_le_right
        hDsub.isSubnormal hEqM' with hcen | hle
    · exact not_involution_of_mem_centralizer_layerIn M hZoddM hzE (hcen ⟨hzO, hzE⟩) hzord
    · -- `E(M) ≤ O₂(N)`: `E(M)` is then a `2`-group, hence solvable, contradicting perfectness
      have hE2 : IsPGroup 2 ↥(Work.GW2.layerIn M) :=
        (isPGroup_pCoreIn 2 N).to_le (hle.trans inf_le_left)
      haveI hsol : Group.IsSolvable ↥(Work.GW2.layerIn M) := by
        haveI := hE2.isNilpotent
        exact IsNilpotent.to_isSolvable
      have hcomm : commutator ↥(Work.GW2.layerIn M) = ⊤ := by
        have hmaptop : Subgroup.map (Work.GW2.layerIn M).subtype
            (⊤ : Subgroup ↥(Work.GW2.layerIn M)) = Work.GW2.layerIn M := by
          rw [Subgroup.map_top, Subgroup.range_subtype]
        have h1 : Subgroup.map (Work.GW2.layerIn M).subtype
              ⁅(⊤ : Subgroup ↥(Work.GW2.layerIn M)), ⊤⁆ =
            Subgroup.map (Work.GW2.layerIn M).subtype
              (⊤ : Subgroup ↥(Work.GW2.layerIn M)) := by
          rw [Subgroup.map_commutator, hmaptop, hEqM'.1]
        exact Subgroup.map_injective (Work.GW2.layerIn M).subtype_injective h1
      haveI hnt : Nontrivial ↥(Work.GW2.layerIn M) := by
        haveI := hEqM'.2
        exact Function.Surjective.nontrivial
          (QuotientGroup.mk'_surjective (Subgroup.center ↥(Work.GW2.layerIn M)))
      exact absurd hcomm
        (ne_of_lt (Group.IsSolvable.commutator_lt_top_of_nontrivial ↥(Work.GW2.layerIn M)))
  · -- `V ⊓ E(N) ≠ ⊥`: then `E(M) ⊓ E(N)` is not central in `E(M)`, hence is all of `E(M)`
    have hlt : (⊥ : Subgroup G) < V ⊓ Work.GW2.layerIn N := bot_lt_iff_ne_bot.mpr hEN
    obtain ⟨z, hz, hzb⟩ := IsConcreteLE.exists_of_lt hlt
    have hzV : z ∈ V := hz.1
    have hzEN : z ∈ Work.GW2.layerIn N := hz.2
    have hz1 : z ≠ 1 := fun h => hzb (Subgroup.mem_bot.mpr h)
    have hzE : z ∈ Work.GW2.layerIn M := (hV2 : V ≤ Work.GW2.layerIn M) hzV
    have hz2 : z ^ 2 = 1 := hV4.2 z hzV
    have hzord : orderOf z = 2 := orderOf_eq_prime hz2 hz1
    have hNnormL : N ≤ Subgroup.normalizer ((Work.GW2.layerIn N : Subgroup G) : Set G) :=
      Work.CORE3.le_normalizer_map_subtype_of_normal' (K := N) (Work.CORE3.mdata_layer_normal N)
    have hDsub : ((Work.GW2.layerIn M ⊓ Work.GW2.layerIn N).subgroupOf
        (Work.GW2.layerIn M)).Normal := by
      rw [Subgroup.normal_subgroupOf_iff inf_le_left]
      intro h k hh kk
      refine ⟨?_, ?_⟩
      · exact (Work.GW2.layerIn M).mul_mem
          ((Work.GW2.layerIn M).mul_mem kk hh.1) ((Work.GW2.layerIn M).inv_mem kk)
      · exact (Subgroup.mem_normalizer_iff.mp (hNnormL (hEleN kk)) h).1 hh.2
    rcases Work.BMAX.Components.subnormal_le_centralizer_or_eq_of_isQuasisimple inf_le_left
        hDsub.isSubnormal hEqM' with hcen | hle
    · exfalso
      exact not_involution_of_mem_centralizer_layerIn M hZoddM hzE (hcen ⟨hzE, hzEN⟩) hzord
    · exact hle.trans inf_le_right

end Work.CORE3.MData
