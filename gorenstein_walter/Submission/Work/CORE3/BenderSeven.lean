/-!
# Bender 1981 §3, step (7)

Setting: `G` a minimal counterexample (`Work.GW2.BenderCtx G`), `B` a Bender setup with
`Case1 B`, and `V = O₂(Ĥ)` of type `(2,2)` (`Work.GW2.Case1bData B`); write `U = O(Ĥ) = O(H)`,
`VU = V ⊔ U` and `D = Ĥ ⊓ Ĥ^y`.

Bender, *Finite groups with dihedral Sylow 2-subgroups*, J. Algebra **70** (1981), p. 224:

> Suppose `y ∈ J_n` inverts some `2'`-subgroup `X ≠ 1` of `Ĥ` such that `C_G(X)` and `N_G(X)`
> have even order.  Then `|U| = k = 3`, `n = 4`, and `Ĥ ⊓ Ĥ^y ≅ D₆`.  (7)

Since `J_n` is *defined* as the set of involutions outside `Ĥ` whose coset carries `n`
involutions, the phrase `y ∈ J_n` is automatic; the hypotheses are therefore exactly those of
the statement below (`X ≤ Ĥ`, `X ≠ ⊥`, odd order, inverted by the involution `y ∉ Ĥ`, with
`C_G(X)` and `N_G(X)` of even order).  The `G`-centralizer/normalizer reading is the one under
which Bender's proof is used: with the `Ĥ`-forms the hypothesis would be vacuous, since no
involution of `Ĥ` centralizes such an `X` (`Work.CORE3.SevenNoInvolCentralizer`).

## Contents

* `Work.CORE3.BenderSeven_local`: the local reduction — `X` is generated by an element `x` of
  order `3` with `x ∉ VU`, and `X ⊓ VU = ⊥` (Bender's (5) plus `|Ĥ : VU| = 6`).
* `Work.CORE3.BenderSeven_inv`: the even-order hypothesis yields an involution `s` centralizing
  `X` which does *not* lie in `Ĥ` (via `Work.CORE3.SevenNoInvolCentralizer`).
* The target `Work.CORE3.BenderSeven`, assembled from the two halves
  `Submission.Work.CORE3.BenderSevenU3` (`|U| = 3`) and
  `Submission.Work.CORE3.BenderSevenD6` (`|Ĥ ⊓ Ĥ^y| = 6`).
-/

namespace Work.CORE3

open Work.GW2

set_option linter.unusedVariables false

/-! ## The local reduction of the hypothesis -/

/-- **Local reduction.**  Under the hypotheses of Bender's (7) the odd subgroup `X` is generated
by an element `x` of order `3` lying outside `VU = O₂(Ĥ) ⊔ O(Ĥ)`, and `X ⊓ VU = ⊥`.

Indeed (5) (`Work.CORE3.VUInvSetTrivial`) gives `X ⊓ VU = ⊥`, so `X` embeds into `Ĥ/VU` of
order `6`; `|X|` is odd and `> 1`, whence `|X| = 3` (`Work.CORE3.J4.card_X_eq_three`) and `X` is
cyclic. -/
theorem BenderSeven_local (G : Type) [Group G] [Finite G] (I : Work.CORE3.Case1Inputs)
    (h : Work.GW2.BenderCtx G) (B : Work.GW2.BenderSetup G) (h1 : Work.GW2.Case1 B)
    (D : Work.GW2.Case1bData B) {y : G} (hy2 : orderOf y = 2) (hyH : y ∉ B.Hhat)
    (X : Subgroup G) (hXle : X ≤ B.Hhat) (hXne : X ≠ ⊥) (hXodd : Odd (Nat.card ↥X))
    (hinv : Work.GW2.Inverts y X) :
    ∃ x : G, x ∈ X ∧ orderOf x = 3 ∧ X = Subgroup.zpowers x ∧
      x ∉ (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) ∧
      X ⊓ (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) = ⊥ := by
  have hcard : Nat.card ↥X = 3 :=
    J4.card_X_eq_three I h B h1 D hy2 hyH hXle hXne hXodd hinv
  -- Bender (5): `X` meets `VU = O₂(Ĥ) ⊔ O(Ĥ)` trivially
  have hVU : X ⊓ (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) = ⊥ := by
    have h5 : Work.GW2.invSet (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) y = {1} :=
      VUInvSetTrivial G I h B h1 D y hy2 hyH
    refine le_bot_iff.mp ?_
    intro z hz
    rw [Subgroup.mem_inf] at hz
    obtain ⟨hzX, hzVU⟩ := hz
    have hmem : z ∈ Work.GW2.invSet (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) y :=
      ⟨hzVU, hinv z hzX⟩
    rw [h5] at hmem
    exact Subgroup.mem_bot.mpr (Set.mem_singleton_iff.mp hmem)
  -- `X ≠ ⊥` gives an element `x ≠ 1` of `X`, of order `3`
  have hex : ∃ x ∈ X, x ≠ 1 := by
    by_contra hcon
    apply hXne
    rw [Subgroup.eq_bot_iff_forall]
    intro z hz
    by_contra hz1
    exact hcon ⟨z, hz, hz1⟩
  obtain ⟨x, hxX, hx1⟩ := hex
  have hx3 : orderOf x = 3 := by
    have hdvd : orderOf x ∣ 3 := by
      have h0 : orderOf x ∣ Nat.card ↥X := Subgroup.orderOf_dvd_natCard X hxX
      rwa [hcard] at h0
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1' | h1'
    · exact absurd (orderOf_eq_one_iff.mp h1') hx1
    · exact h1'
  have hzp : X = Subgroup.zpowers x := by
    refine (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hxX) ?_).symm
    rw [Nat.card_zpowers, hx3, hcard]
  refine ⟨x, hxX, hx3, hzp, ?_, hVU⟩
  intro hxVU
  have : x ∈ X ⊓ (Work.GW2.pCoreIn 2 B.Hhat ⊔ B.U) := ⟨hxX, hxVU⟩
  rw [hVU] at this
  exact hx1 (Subgroup.mem_bot.mp this)

/-! ## The involution witness lies outside `Ĥ` -/

/-- **The even-order hypothesis produces an involution outside `Ĥ`.**  Since `Even |C_G(X)|`
there is an involution `s` centralizing `X`; by `Work.CORE3.SevenNoInvolCentralizer` no
involution *of* `Ĥ` centralizes a nontrivial odd-order `X ≤ Ĥ` that is inverted by an involution
outside `Ĥ`, so `s ∉ Ĥ`. -/
theorem BenderSeven_inv (G : Type) [Group G] [Finite G] (I : Work.CORE3.Case1Inputs)
    (h : Work.GW2.BenderCtx G) (B : Work.GW2.BenderSetup G) (h1 : Work.GW2.Case1 B)
    (D : Work.GW2.Case1bData B) {y : G} (hy2 : orderOf y = 2) (hyH : y ∉ B.Hhat)
    (X : Subgroup G) (hXle : X ≤ B.Hhat) (hXne : X ≠ ⊥) (hXodd : Odd (Nat.card ↥X))
    (hinv : Work.GW2.Inverts y X)
    (hCeven : Even (Nat.card (Subgroup.centralizer (X : Set G)))) :
    ∃ s : G, s ∈ Subgroup.centralizer (X : Set G) ∧ orderOf s = 2 ∧ s ∉ B.Hhat := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hdvd : 2 ∣ Nat.card ↥(Subgroup.centralizer (X : Set G)) := by
    rw [even_iff_two_dvd] at hCeven
    exact hCeven
  obtain ⟨s, hs2⟩ := exists_prime_orderOf_dvd_card' 2 hdvd
  have hsC : (s : G) ∈ Subgroup.centralizer (X : Set G) := s.2
  have hsord : orderOf (s : G) = 2 := by
    rw [Subgroup.orderOf_coe, hs2]
  have hsK : (s : G) ∉ B.Hhat := by
    intro hsKmem
    exact SevenNoInvolCentralizer G I h B h1 D hy2 hyH hXle hXne hXodd hinv
      ⟨(s : G), hsKmem, hsord,
        fun x hx => (Subgroup.mem_centralizer_iff.mp hsC x hx).symm⟩
  exact ⟨(s : G), hsC, hsord, hsK⟩

/-! ## The target -/

theorem BenderSeven (G : Type) [Group G] [Finite G] (I : Work.CORE3.Case1Inputs) (h : Work.GW2.BenderCtx G)
    (B : Work.GW2.BenderSetup G) (h1 : Work.GW2.Case1 B) (D : Work.GW2.Case1bData B)
    {y : G} (hy2 : orderOf y = 2) (hyH : y ∉ B.Hhat)
    (X : Subgroup G) (hXle : X ≤ B.Hhat) (hXne : X ≠ ⊥) (hXodd : Odd (Nat.card ↥X))
    (hinv : Work.GW2.Inverts y X)
    (hCeven : Even (Nat.card (Subgroup.centralizer (X : Set G))))
    (hNeven : Even (Nat.card (Subgroup.normalizer (X : Set G))))
    {s : G} (hsH : s ∈ B.Hhat) (hs2 : orderOf s = 2) (hsX : Work.GW2.Inverts s X) :
    Nat.card B.U = 3 ∧ Nat.card ↥(B.Hhat ⊓ Work.GW2.conjSub y B.Hhat) = 6 :=
  -- Both halves of Bender's (7): `|U| = 3` and `|Ĥ ⊓ Ĥ^y| = 6`.  They are the content of the
  -- sibling leaves `Submission.Work.CORE3.BenderSevenU3` / `...D6` (and, in the `n = 4` form,
  -- of `Submission.Work.CORE3.Case1bSeven` plus `card_inf_conjSubOfThree`).
  --
  -- `s` is Bender's `N_Ĥ(X)` hypothesis (design pass 23 §A); it is what `BenderSevenU3` needs.
  -- The `D6` half does not use it.
  ⟨BenderSevenU3 G I h B h1 D hy2 hyH X hXle hXne hXodd hinv hCeven hsH hs2 hsX,
    BenderSevenD6 G I h B h1 D hy2 hyH X hXle hXne hXodd hinv hCeven hNeven⟩

end Work.CORE3
