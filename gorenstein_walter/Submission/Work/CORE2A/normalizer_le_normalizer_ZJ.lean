import Mathlib
import Submission.Work.CORE2A.Defs

/-!
# CORE2A: `N_G(P) ≤ N_G(Z(J(P)))`

For a subgroup `P` of a group `G`, Thompson's subgroup `J(P)` is generated by the abelian
subgroups of `P` of maximal order.  An automorphism of `P` permutes that set of subgroups,
hence fixes `J(P)`; consequently every element of `N_G(P)` normalizes both `J(P)` and
`C_G(J(P))`, and therefore normalizes `Z(J(P)) = J(P) ∩ C_G(J(P)) = ZJ P`.

This is the statement of the present file:

* `Work.CORE2A.normalizer_le_normalizer_ZJ`:
  `Subgroup.normalizer (P : Set G) ≤ Subgroup.normalizer (Work.GW2.ZJ P : Set G)`.

The proof is self-contained: it only uses the definitions of `Work.GW2.thompsonJ = J(P)` and
`Work.GW2.ZJ = Z(J(P))` together with the elementary behaviour of `Subgroup.map` under a group
automorphism.  The key ingredient is that the *index set* of `J(P)`, namely the set
`maxAbSubs P` of abelian subgroups of `P` of maximal order, is permuted by any automorphism of
`G` stabilising `P`; a `sSup` indexed by a set that is permuted by `Subgroup.map` is therefore
fixed (`map_sSup_eq_of`).
-/

namespace Work.CORE2A

open Subgroup

/-! ## 1. The index set of `J(P)` -/

/-- `A(P)`: the set of abelian subgroups of `P` of maximal order, whose `sSup` is Thompson's
`J(P) = Work.GW2.thompsonJ P` (`thompsonJ_eq_sSup_maxAbSubs`). -/
def maxAbSubs {G : Type*} [Group G] (P : Subgroup G) : Set (Subgroup G) :=
  {A : Subgroup G | A ≤ P ∧ IsMulCommutative A ∧
    ∀ B : Subgroup G, B ≤ P → IsMulCommutative B → Nat.card B ≤ Nat.card A}

/-- `Work.GW2.thompsonJ P` is the `sSup` of `maxAbSubs P`: the two set-builders are the same
by definition. -/
theorem thompsonJ_eq_sSup_maxAbSubs {G : Type*} [Group G] (P : Subgroup G) :
    Work.GW2.thompsonJ P = sSup (maxAbSubs P) := rfl

/-! ## 2. Elementary transfer lemmas -/

/-- `IsMulCommutative` for a subgroup, unwound into elements of the ambient group. -/
theorem isMulCommutative_iff_forall {G : Type*} [Group G] {A : Subgroup G} :
    IsMulCommutative ↥A ↔ ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := by
  rw [isMulCommutative_iff]
  exact ⟨fun h a ha b hb => congrArg Subtype.val (h ⟨a, ha⟩ ⟨b, hb⟩),
    fun h a b => Subtype.ext (h a a.2 b b.2)⟩

/-- Commutativity of a subgroup is carried forward by any homomorphism. -/
theorem isMulCommutative_map_of_comm {G G' : Type*} [Group G] [Group G'] (f : G →* G')
    {A : Subgroup G} (hA : IsMulCommutative ↥A) : IsMulCommutative ↥(A.map f) := by
  rw [isMulCommutative_iff_forall] at hA ⊢
  intro a ha b hb
  obtain ⟨a', ha', rfl⟩ := Subgroup.mem_map.mp ha
  obtain ⟨b', hb', rfl⟩ := Subgroup.mem_map.mp hb
  rw [← map_mul, ← map_mul, hA a' ha' b' hb']

/-- An automorphism of `G` that fixes `P` also fixes `P` under the inverse automorphism. -/
theorem map_symm_map_eq {G : Type*} [Group G] (e : G ≃* G) (P : Subgroup G)
    (h : P.map e.toMonoidHom = P) : P.map e.symm.toMonoidHom = P := by
  have hcomp : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id G :=
    MonoidHom.ext fun x => by simp
  have h1 : (P.map e.toMonoidHom).map e.symm.toMonoidHom = P := by
    rw [Subgroup.map_map, hcomp, Subgroup.map_id]
  rw [h] at h1
  exact h1

/-- `A(P)` is permuted by any automorphism of `G` stabilising `P`. -/
theorem map_mem_maxAbSubs {G : Type*} [Group G] {e : G ≃* G} {P : Subgroup G}
    (hP : P.map e.toMonoidHom = P) {A : Subgroup G} (hA : A ∈ maxAbSubs P) :
    A.map e.toMonoidHom ∈ maxAbSubs P := by
  obtain ⟨hAP, hAcomm, hAmax⟩ := hA
  have hPinv : P.map e.symm.toMonoidHom = P := map_symm_map_eq e P hP
  refine ⟨?_, ?_, ?_⟩
  · rw [← hP]; exact Subgroup.map_mono hAP
  · exact isMulCommutative_map_of_comm e.toMonoidHom hAcomm
  · intro B hBP hBcomm
    have hBP' : B.map e.symm.toMonoidHom ≤ P := by
      rw [← hPinv]; exact Subgroup.map_mono hBP
    have hBcomm' : IsMulCommutative ↥(B.map e.symm.toMonoidHom) :=
      isMulCommutative_map_of_comm e.symm.toMonoidHom hBcomm
    have hcard : Nat.card ↥(B.map e.symm.toMonoidHom) ≤ Nat.card ↥A := hAmax _ hBP' hBcomm'
    rw [Subgroup.card_map_of_injective e.injective]
    rw [Subgroup.card_map_of_injective e.symm.injective] at hcard
    exact hcard

/-! ## 3. `sSup` of a permuted index set, and centralizers -/

/-- If a homomorphism `f` permutes a set `S` of subgroups, then `f` fixes `sSup S`. -/
theorem map_sSup_eq_of {G : Type*} [Group G] {f : G →* G} {S : Set (Subgroup G)}
    (h : ∀ A ∈ S, A.map f ∈ S) (h' : ∀ B ∈ S, ∃ A ∈ S, A.map f = B) :
    (sSup S).map f = sSup S := by
  have key : (sSup S).map f = ⨆ A : S, (A : Subgroup G).map f := by
    conv_lhs => rw [sSup_eq_iSup']
    rw [Subgroup.map_iSup]
  rw [key]
  refine le_antisymm ?_ ?_
  · exact iSup_le fun A => le_sSup (h A.1 A.2)
  · refine sSup_le fun B hB => ?_
    obtain ⟨A, hA, hAB⟩ := h' B hB
    rw [← hAB]
    exact le_iSup (fun A : S => (A : Subgroup G).map f) ⟨A, hA⟩

/-- The image of the centralizer of a set under a bijective homomorphism is the centralizer of
the image of the set. -/
theorem map_centralizer_of_bijective {G G' : Type*} [Group G] [Group G']
    (f : G →* G') (hf : Function.Bijective f) (s : Set G) :
    (Subgroup.centralizer s).map f = Subgroup.centralizer (f '' s) := by
  refine le_antisymm (Subgroup.map_centralizer_le_centralizer_image s f) ?_
  intro z hz
  obtain ⟨y, rfl⟩ := hf.2 z
  rw [Subgroup.mem_map]
  refine ⟨y, ?_, rfl⟩
  rw [Subgroup.mem_centralizer_iff] at hz ⊢
  intro a ha
  exact hf.1 (by simpa using hz (f a) ⟨a, ha, rfl⟩)

/-! ## 4. `J(P)` and `Z(J(P))` under normalizer elements -/

/-- `J(P)` is fixed by every element of `N_G(P)`. -/
theorem map_thompsonJ_of_mem_normalizer {G : Type} [Group G] {P : Subgroup G} {g : G}
    (hg : g ∈ Subgroup.normalizer (P : Set G)) :
    (Work.GW2.thompsonJ P).map (MulAut.conj g).toMonoidHom = Work.GW2.thompsonJ P := by
  have hP : P.map (MulAut.conj g).toMonoidHom = P := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hg
    exact hg
  have hcomp2 : (MulAut.conj g).toMonoidHom.comp (MulAut.conj g).symm.toMonoidHom
      = MonoidHom.id G := MonoidHom.ext fun x => by simp
  have hPinv : P.map (MulAut.conj g).symm.toMonoidHom = P := map_symm_map_eq _ P hP
  rw [show Work.GW2.thompsonJ P = sSup (maxAbSubs P) from rfl]
  refine map_sSup_eq_of (f := (MulAut.conj g).toMonoidHom)
    (fun A hA => map_mem_maxAbSubs hP hA) (fun B hB => ?_)
  exact ⟨B.map (MulAut.conj g).symm.toMonoidHom, map_mem_maxAbSubs hPinv hB, by
    rw [Subgroup.map_map, hcomp2, Subgroup.map_id]⟩

/-- The normalizer of `P` is contained in the normalizer of `Z(J(P)) = ZJ P`. -/
theorem normalizer_le_normalizer_ZJ {G : Type} [Group G] (P : Subgroup G) :
    Subgroup.normalizer (P : Set G) ≤ Subgroup.normalizer (Work.GW2.ZJ P : Set G) := by
  intro g hg
  have hJ : (Work.GW2.thompsonJ P).map (MulAut.conj g).toMonoidHom = Work.GW2.thompsonJ P :=
    map_thompsonJ_of_mem_normalizer hg
  have hC : (Subgroup.centralizer (Work.GW2.thompsonJ P : Set G)).map (MulAut.conj g).toMonoidHom
      = Subgroup.centralizer (Work.GW2.thompsonJ P : Set G) := by
    rw [map_centralizer_of_bijective (MulAut.conj g).toMonoidHom (MulAut.conj g).bijective]
    rw [← Subgroup.coe_map, hJ]
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  change (Work.GW2.ZJ P).map (MulAut.conj g).toMonoidHom = Work.GW2.ZJ P
  rw [Work.GW2.ZJ, Subgroup.map_inf _ _ _ (MulAut.conj g).injective, hJ, hC]

end Work.CORE2A
