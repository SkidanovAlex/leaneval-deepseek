import Mathlib
import Submission.Work.CORE2A.TorusDefs
import Submission.Work.CORE2A.isFourGroup_closure_pair
import Submission.Work.CORE2A.fourGroup_normalizer_not_le

namespace Work.CORE2A

open Subgroup

/-- The subgroup generated by two elements is the closure of the corresponding pair:
`⟨t, s⟩ = ⟨{t, s}⟩`. -/
private theorem zpowers_sup_zpowers_eq_closure {G : Type*} [Group G] (a b : G) :
    (Subgroup.zpowers a ⊔ Subgroup.zpowers b : Subgroup G) =
      Subgroup.closure ({a, b} : Set G) := by
  rw [Subgroup.zpowers_eq_closure, Subgroup.zpowers_eq_closure, ← Subgroup.closure_union]
  congr 1

theorem c14_W2 (T : Work.GW2.LocalToolkit) {G : Type} [Group G] [Finite G] (B : Work.GW2.BenderSetup G) (hbc : Work.GW2.BenderCtx G) {s : G} (hsS : s ∈ (B.S : Subgroup G)) (hs2 : orderOf s = 2) (hst : s ≠ B.t) : ∃ g ∈ Subgroup.normalizer ((Subgroup.zpowers B.t ⊔ Subgroup.zpowers s : Subgroup G) : Set G), g * (B.t * s) * g⁻¹ = B.t := by
  classical
  -- `S` is dihedral of order `≥ 4` and `G` has no normal subgroup of index `2`.
  obtain ⟨n, hn2, hiso⟩ := fnbt_exists_dihedral hbc B
  have hno12 := fnbt_no_index_two hbc
  -- Bender's fusion: the normalizer of a four-group is transitive on its nonidentity elements.
  obtain ⟨_hallconj, htrans⟩ := T.fus G B.S n hn2 hiso hno12
  -- `t` and `s` are distinct commuting involutions.
  have ht2 : B.t ^ 2 = 1 := by simpa [B.t_order] using pow_orderOf_eq_one B.t
  have hs2' : s ^ 2 = 1 := by simpa [hs2] using pow_orderOf_eq_one s
  have hs22 : s * s = 1 := by simpa [pow_two] using hs2'
  have hcomm : B.t * s = s * B.t :=
    (Subgroup.mem_centralizer_iff.mp (bSetup_S_le_H B hsS)) B.t (by simp)
  have ht1 : B.t ≠ 1 := bSetup_t_ne_one B
  have hs1 : s ≠ 1 := by
    rintro rfl
    simp [orderOf_one] at hs2
  -- Hence `V = ⟨t, s⟩` is a four-group.
  have hV4 : Work.GW2.IsFourGroup (Subgroup.zpowers B.t ⊔ Subgroup.zpowers s) := by
    rw [zpowers_sup_zpowers_eq_closure]
    exact isFourGroup_closure_pair ht2 hs2' hcomm ht1 hs1 (fun h => hst h.symm)
  -- `ts` is a nonidentity element of `V`, and so is `t`.
  have hts1 : B.t * s ≠ 1 := by
    intro h
    have hts : B.t = s := by
      calc B.t = B.t * 1 := (mul_one B.t).symm
        _ = B.t * (s * s) := by rw [hs22]
        _ = (B.t * s) * s := by rw [mul_assoc]
        _ = 1 * s := by rw [h]
        _ = s := one_mul s
    exact hst hts.symm
  have hx : B.t * s ∈ (Subgroup.zpowers B.t ⊔ Subgroup.zpowers s : Subgroup G) :=
    mul_mem (mem_sup_left (Subgroup.mem_zpowers B.t)) (mem_sup_right (Subgroup.mem_zpowers s))
  have hy : B.t ∈ (Subgroup.zpowers B.t ⊔ Subgroup.zpowers s : Subgroup G) :=
    mem_sup_left (Subgroup.mem_zpowers B.t)
  obtain ⟨g, hg, hgconj⟩ := htrans _ hV4 (B.t * s) hx B.t hy hts1 ht1
  exact ⟨g, hg, hgconj⟩

end Work.CORE2A
