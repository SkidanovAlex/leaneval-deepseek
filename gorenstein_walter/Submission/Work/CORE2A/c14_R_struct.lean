/-!
# CORE2A, design pass 14, `P4`: the structure of Bender's torus `R_u`

`Work.CORE2A.c14_R_struct` is the statement `c14_R_struct` of
`Submission/Work/_design_gw/Core14.lean` §2 (Bender 1981, p. 220, Theorem 2.6 step 2):

with `E := E(Ĥ) = layerIn B.Hhat`, `SE = ⟨S, E⟩`, `φ : SE → PGL₂(q)` the quotient of
`Thm26bAutProp` (a) (`D : PGLData B p k`, kernel `Z(E)`) and `u ∈ S` an involution outside `E`,

* `B.t` inverts Bender's torus `R_u = [t, C_E(u)] = Work.GW2.torusR B u`,
* `R_u ∩ Z(E) = 1`,
* `|R_u| = mTor (p ^ k)`.

The proof follows the design note:

* `φ(R_u) = [φ t, L₂(q) ∩ C(φ u)]` — leaf **P3**, proved in `Submission.Work.CORE2A.c14_R_map`;
* `φ t` and `φ u` are commuting involutions with `φ t ∈ L₂(q)`, `φ u ∉ L₂(q)`, so
  `PGL2CommutatorTorusProp` (`hCom`) applies and gives that `φ(R_u)` is *cyclic* of order
  `mTor (p ^ k)` (`c14_R_card_map` below);
* `R_u ≤ E`, `R_u ∩ Z(E) ≤ Z(R_u)` and `R_u/(R_u ∩ Z(E)) ≅ φ(R_u)` is cyclic, so `R_u` is
  abelian (`Submission.Work.CORE2A.c14_R_abelian`);
* in an abelian group, the set of elements inverted by an involution is a subgroup; it contains
  the generators `[t, c]` (`c ∈ C_E(u)`) of `R_u` — note `⟨t⟩ = {1, t}` because `t² = 1` — so
  `t` inverts `R_u` (`c14_R_inverts_aux` below);
* an element of `R_u ∩ Z(E)` is centralized by `t` (it lies in `E ∋ t`) and inverted by `t`,
  so it is `1` because `|Z(E)|` is odd (`zE_odd`);
* finally `|R_u| = |φ(R_u)| · |R_u ∩ Z(E)| = mTor (p ^ k)` via the first isomorphism theorem
  (`Subgroup.relIndex_ker`, `Subgroup.relIndex_mul_card`).
-/

open scoped commutatorElement MatrixGroups
open Subgroup

set_option linter.style.haveILetI false

namespace Work.CORE2A

open Work.GW2

/-- `t` inverts the subgroup generated by the commutators `[t, c]`, `c ∈ C_E(u) ∈`, which is
Bender's torus `R_u`, provided `R_u` is abelian (`u`'s centralizer contributes through the
commutators; `⟨t⟩ = {1,t}` since `t² = 1`).

In an abelian group the elements inverted by the involution `t` form a subgroup, so it suffices
to check the generators, for which the computation `t ⁅t,c⁆ t⁻¹ = ⁅t,c⁆⁻¹` is formal. -/
private theorem c14_R_inverts_aux {G : Type} [Group G] [Finite G] (B : Work.GW2.BenderSetup G)
    {u : G} (hab : IsMulCommutative ↥(Work.GW2.torusR B u)) :
    Work.GW2.Inverts B.t (Work.GW2.torusR B u) := by
  have ht2 : B.t * B.t = 1 := by
    have h := pow_orderOf_eq_one B.t
    rw [B.t_order, pow_two] at h
    exact h
  have htinv : B.t⁻¹ = B.t := inv_eq_of_mul_eq_one_right ht2
  set S : Set G := {g : G | ∃ k ∈ (Work.GW2.layerIn B.Hhat ⊓ Subgroup.centralizer ({u} : Set G)),
      g = ⁅B.t, k⁆} with hS
  have hgen : ∀ y ∈ S, B.t * y * B.t⁻¹ = y⁻¹ := by
    rintro y ⟨k, _, rfl⟩
    rw [commutatorElement_inv, commutatorElement_def, commutatorElement_def, htinv]
    rw [show B.t * (B.t * k * B.t * k⁻¹) * B.t = (B.t * B.t) * (k * B.t * k⁻¹ * B.t)
        from by group, ht2, one_mul]
  have hsub : Subgroup.closure S ≤ Work.GW2.torusR B u := by
    rw [Work.GW2.torusR]
    refine (Subgroup.closure_le _).mpr ?_
    rintro y ⟨k, hk, rfl⟩
    exact Subgroup.subset_closure ⟨B.t, Subgroup.mem_zpowers B.t, k, hk, rfl⟩
  have hRle : Work.GW2.torusR B u ≤ Subgroup.closure S := by
    rw [Work.GW2.torusR]
    refine Subgroup.commutator_le.mpr (fun g1 hg1 g2 hg2 => ?_)
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg1
    have ht2z : B.t ^ (2 : ℤ) = 1 := by
      rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, pow_two]
      exact ht2
    rcases Int.even_or_odd n with ⟨m, hm⟩ | ⟨m, hm⟩
    · have h1 : B.t ^ n = 1 := by
        rw [hm, show m + m = 2 * m from by ring, zpow_mul, ht2z, one_zpow]
      rw [h1]
      simp
    · have h1 : B.t ^ n = B.t := by
        rw [hm, zpow_add, zpow_mul, ht2z, one_zpow, one_mul, zpow_one]
      rw [h1]
      exact Subgroup.subset_closure ⟨g2, hg2, rfl⟩
  have hEq : Work.GW2.torusR B u = Subgroup.closure S := le_antisymm hRle hsub
  intro x hx
  have hx' : x ∈ Subgroup.closure S := hEq ▸ hx
  refine Subgroup.closure_induction (p := fun y _ => B.t * y * B.t⁻¹ = y⁻¹)
    (fun y hy => hgen y hy) ?_ ?_ ?_ hx'
  · group
  · intro x y hx hy ihx ihy
    have hxR : x ∈ Work.GW2.torusR B u := hEq.symm ▸ hx
    have hyR : y ∈ Work.GW2.torusR B u := hEq.symm ▸ hy
    have hcomm : x * y = y * x := by
      have h := hab.is_comm.comm ⟨x, hxR⟩ ⟨y, hyR⟩
      exact congrArg Subtype.val h
    calc B.t * (x * y) * B.t⁻¹ = (B.t * x * B.t⁻¹) * (B.t * y * B.t⁻¹) := by group
      _ = x⁻¹ * y⁻¹ := by rw [ihx, ihy]
      _ = (x * y)⁻¹ := by rw [hcomm, mul_inv_rev]
  · intro x hx ihx
    calc B.t * x⁻¹ * B.t⁻¹ = (B.t * x * B.t⁻¹)⁻¹ := by group
      _ = (x⁻¹)⁻¹ := by rw [ihx]

/-- The order of the image of Bender's torus in `PGL₂(q)`: `|φ(R_u)| = mTor (p ^ k)`.

This is the `PGL₂(q)` computation of `PGL2CommutatorTorusProp` (`hCom`) applied to the two
commuting involutions `φ t ∈ L₂(q)` and `φ u ∉ L₂(q)`, together with leaf **P3**
(`c14_R_map`), which identifies `φ(R_u)` with `⁅⟨φ t⟩, L₂(q) ∩ C(φ u)⁆`. -/
private theorem c14_R_card_map (T : Work.GW2.LocalToolkit) (hFT : Work.GW2.FeitThompsonProp)
    {G : Type} [Group G] [Finite G] (hbc : Work.GW2.BenderCtx G) {B : Work.GW2.BenderSetup G}
    {p k : ℕ} [Fact p.Prime] (hCom : Work.L2F.PGL2CommutatorTorusProp) (D : Work.GW2.PGLData B p k)
    (hp : Odd p) (hk : 5 ≤ p ^ k) (ht : B.t ∈ Work.GW2.layerIn B.Hhat) {u : G}
    (huS : u ∈ (B.S : Subgroup G)) (hu2 : orderOf u = 2) (huE : u ∉ Work.GW2.layerIn B.Hhat)
    (htSE : B.t ∈ Work.GW2.SE B) (huSE : u ∈ Work.GW2.SE B)
    (hmap : ((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)).map D.φ =
      ⁅Subgroup.zpowers (D.φ ⟨B.t, htSE⟩), Work.GW2.Lsub p k ⊓ Subgroup.centralizer ({D.φ ⟨u, huSE⟩} : Set _)⁆) :
    Nat.card ↥(((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)).map D.φ) =
      Work.GW2.mTor (p ^ k) := by
  have hE : Work.GW2.layerIn B.Hhat ≠ ⊥ := by
    intro h
    exact bSetup_t_ne_one B (by simpa [h] using ht)
  have hZodd : Odd (Nat.card ↥(Work.GW2.zE B)) := zE_odd T hFT hbc B hE
  have ht_not_zE : B.t ∉ Work.GW2.zE B := by
    intro htmem
    have h2dvd : 2 ∣ Nat.card ↥(Work.GW2.zE B) := by
      have h := Subgroup.orderOf_dvd_natCard (Work.GW2.zE B) htmem
      rwa [B.t_order] at h
    exact Nat.not_even_iff_odd.mpr hZodd (even_iff_two_dvd.mpr h2dvd)
  have ht'2 : orderOf (D.φ ⟨B.t, htSE⟩) = 2 := by
    have hdvd : orderOf (D.φ ⟨B.t, htSE⟩) ∣ orderOf (⟨B.t, htSE⟩ : ↥(Work.GW2.SE B)) :=
      orderOf_map_dvd D.φ _
    rw [Subgroup.orderOf_mk, B.t_order] at hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exfalso
      have h1 : D.φ ⟨B.t, htSE⟩ = 1 := orderOf_eq_one_iff.mp h
      have hmem : (⟨B.t, htSE⟩ : ↥(Work.GW2.SE B)) ∈ D.φ.ker := MonoidHom.mem_ker.mpr h1
      rw [D.ker] at hmem
      exact ht_not_zE (Subgroup.mem_subgroupOf.mp hmem)
    · exact h
  have hu'2 : orderOf (D.φ ⟨u, huSE⟩) = 2 := by
    have hdvd : orderOf (D.φ ⟨u, huSE⟩) ∣ orderOf (⟨u, huSE⟩ : ↥(Work.GW2.SE B)) :=
      orderOf_map_dvd D.φ _
    rw [Subgroup.orderOf_mk, hu2] at hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exfalso
      have h1 : D.φ ⟨u, huSE⟩ = 1 := orderOf_eq_one_iff.mp h
      have hmem : (⟨u, huSE⟩ : ↥(Work.GW2.SE B)) ∈ D.φ.ker := MonoidHom.mem_ker.mpr h1
      rw [D.ker] at hmem
      exact huE (zE_le (Subgroup.mem_subgroupOf.mp hmem))
    · exact h
  have htu : B.t * u = u * B.t :=
    (Subgroup.mem_centralizer_singleton_iff.mp (bSetup_S_le_H B huS)).symm
  have hcomm : D.φ ⟨B.t, htSE⟩ * D.φ ⟨u, huSE⟩ = D.φ ⟨u, huSE⟩ * D.φ ⟨B.t, htSE⟩ := by
    rw [← map_mul, ← map_mul]
    congr 1
    exact Subtype.ext (by simpa using htu)
  have htL : D.φ ⟨B.t, htSE⟩ ∈ Work.GW2.Lsub p k := (D.mem_layer_iff ⟨B.t, htSE⟩).mp ht
  have huL : D.φ ⟨u, huSE⟩ ∉ Work.GW2.Lsub p k :=
    fun h => huE ((D.mem_layer_iff ⟨u, huSE⟩).mpr h)
  have hcom := hCom p k hp hk (D.φ ⟨B.t, htSE⟩) (D.φ ⟨u, huSE⟩) ht'2 hu'2 hcomm htL huL
  rw [hmap]
  simpa only [Work.GW2.mTor] using hcom.2.2.1

theorem c14_R_struct (T : Work.GW2.LocalToolkit) (hFT : Work.GW2.FeitThompsonProp) {G : Type} [Group G] [Finite G] (hbc : Work.GW2.BenderCtx G) {B : Work.GW2.BenderSetup G} {p k : ℕ} [Fact p.Prime] (hCom : Work.L2F.PGL2CommutatorTorusProp) (D : Work.GW2.PGLData B p k) (hp : Odd p) (hk : 5 ≤ p ^ k) (ht : B.t ∈ Work.GW2.layerIn B.Hhat) {u : G} (huS : u ∈ (B.S : Subgroup G)) (hu2 : orderOf u = 2) (huE : u ∉ Work.GW2.layerIn B.Hhat) : Work.GW2.Inverts B.t (Work.GW2.torusR B u) ∧ Work.GW2.torusR B u ⊓ Work.GW2.zE B = ⊥ ∧ Nat.card (Work.GW2.torusR B u) = Work.GW2.mTor (p ^ k) := by
  have hE : Work.GW2.layerIn B.Hhat ≠ ⊥ := by
    intro h
    exact bSetup_t_ne_one B (by simpa [h] using ht)
  have hZodd : Odd (Nat.card ↥(Work.GW2.zE B)) := zE_odd T hFT hbc B hE
  have htSE : B.t ∈ Work.GW2.SE B := mem_SE_of_mem_layerIn ht
  have huSE : u ∈ Work.GW2.SE B := mem_SE_of_mem_S huS
  -- `R_u ≤ E(Ĥ) ≤ SE`
  have hRE : Work.GW2.torusR B u ≤ Work.GW2.layerIn B.Hhat := by
    rw [Work.GW2.torusR]
    refine Subgroup.commutator_le.mpr (fun g1 hg1 g2 hg2 => ?_)
    have hg1E : g1 ∈ Work.GW2.layerIn B.Hhat := Subgroup.zpowers_le.mpr ht hg1
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hg1E hg2.1)
      (Subgroup.inv_mem _ hg1E)) (Subgroup.inv_mem _ hg2.1)
  have hRSE : Work.GW2.torusR B u ≤ Work.GW2.SE B := hRE.trans layerIn_le_SE
  -- leaf P3
  have hmap := c14_R_map T hFT hbc D ht huS hu2 htSE huSE
  -- `R_u` is abelian, and `|φ(R_u)| = mTor (p ^ k)`
  have hab : IsMulCommutative ↥(Work.GW2.torusR B u) :=
    c14_R_abelian T hFT hbc hCom D hp hk ht huS hu2 huE htSE huSE hmap
  have hcardbar : Nat.card ↥(((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)).map D.φ) =
      Work.GW2.mTor (p ^ k) :=
    c14_R_card_map T hFT hbc hCom D hp hk ht huS hu2 huE htSE huSE hmap
  -- `t` inverts `R_u`
  have hinv : Work.GW2.Inverts B.t (Work.GW2.torusR B u) := c14_R_inverts_aux B hab
  -- `R_u ∩ Z(E) = 1`
  have hbot : Work.GW2.torusR B u ⊓ Work.GW2.zE B = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    rintro x ⟨hxR, hxZ⟩
    obtain ⟨e, he, rfl⟩ := Subgroup.mem_map.mp hxZ
    have hcent : B.t * (e : G) = (e : G) * B.t :=
      congrArg Subtype.val (Subgroup.mem_center_iff.mp he ⟨B.t, ht⟩)
    have h1 : B.t * (e : G) * B.t⁻¹ = (e : G) := by rw [hcent]; group
    have h2 : B.t * (e : G) * B.t⁻¹ = (e : G)⁻¹ := hinv (e : G) hxR
    have h3 : (e : G) = (e : G)⁻¹ := h1.symm.trans h2
    have h4 : (e : G) * (e : G) = 1 := eq_inv_iff_mul_eq_one.mp h3
    have hdvd2 : orderOf (e : G) ∣ 2 := by
      rw [orderOf_dvd_iff_pow_eq_one, pow_two]; exact h4
    have hdvdN : orderOf (e : G) ∣ Nat.card ↥(Work.GW2.zE B) :=
      Subgroup.orderOf_dvd_natCard (Work.GW2.zE B) hxZ
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h | h
    · exact orderOf_eq_one_iff.mp h
    · exact absurd (even_iff_two_dvd.mpr (h ▸ hdvdN)) (Nat.not_even_iff_odd.mpr hZodd)
  refine ⟨hinv, hbot, ?_⟩
  -- `|R_u| = |φ(R_u)| · |R_u ∩ Z(E)| = |φ(R_u)|`
  have hkerbot : D.φ.ker ⊓ ((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)) = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    rintro x ⟨hxker, hxX⟩
    have hxZ : (x : G) ∈ Work.GW2.zE B := by
      have h := hxker
      rw [D.ker] at h
      exact Subgroup.mem_subgroupOf.mp h
    have hxR : (x : G) ∈ Work.GW2.torusR B u := Subgroup.mem_subgroupOf.mp hxX
    have hx1 : (x : G) = 1 := by
      have hmem : (x : G) ∈ (⊥ : Subgroup G) := by rw [← hbot]; exact ⟨hxR, hxZ⟩
      simpa using hmem
    exact Subtype.ext hx1
  have hrel : D.φ.ker.relIndex ((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)) =
      Nat.card ↥((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)) := by
    have h := Subgroup.relIndex_mul_card D.φ.ker ((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B))
    rw [hkerbot] at h
    simpa using h
  calc Nat.card (Work.GW2.torusR B u)
      = Nat.card ↥((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)) :=
        (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hRSE).toEquiv).symm
    _ = Nat.card ↥(((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)).map D.φ) := by
        rw [← Subgroup.relIndex_ker ((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)) D.φ]
        exact hrel.symm
    _ = Work.GW2.mTor (p ^ k) := hcardbar

end Work.CORE2A
