/-! ## §1 Pure group-theoretic bookkeeping about `⟨a, b⟩` for commuting involutions -/

section Pair

variable {G : Type*} [Group G]

/-- Elements of `⟨{a, b}⟩` when `a`, `b` are commuting involutions: `1, a, b, ab`. -/
theorem mem_closure_inv_pair {a b x : G} (ha : a * a = 1) (hb : b * b = 1) (hc : a * b = b * a)
    (hx : x ∈ Subgroup.closure ({a, b} : Set G)) :
    x = 1 ∨ x = a ∨ x = b ∨ x = a * b := by
  have hba : b * a = a * b := hc.symm
  have ha' : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
  have hb' : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
  have haab : a * (a * b) = b := by rw [← mul_assoc, ha, one_mul]
  have habb : (a * b) * b = a := by rw [mul_assoc, hb, mul_one]
  have hbab : b * (a * b) = a := by rw [← mul_assoc, ← hc, habb]
  have haba : (a * b) * a = b := by rw [mul_assoc, ← hc, ← mul_assoc, ha, one_mul]
  have habab : (a * b) * (a * b) = 1 := by rw [← mul_assoc, haba, hb]
  have hab' : (a * b)⁻¹ = a * b := inv_eq_of_mul_eq_one_right habab
  refine Subgroup.closure_induction (p := fun y _ => y = 1 ∨ y = a ∨ y = b ∨ y = a * b)
    ?_ ?_ ?_ ?_ hx
  · rintro y (rfl | rfl)
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inl rfl
  · rintro x y _ _ hx' hy'
    rcases hx' with rfl | rfl | rfl | rfl <;> rcases hy' with rfl | rfl | rfl | rfl <;>
      simp [ha, hb, hba, haab, hbab, haba, habb, habab]
  · rintro x _ hx'
    rcases hx' with rfl | rfl | rfl | rfl <;> simp [ha', hb', hab']

/-- The same for the subgroup generated by two cyclic subgroups: `⟨a, b⟩ = {1, a, b, ab}`. -/
theorem mem_sup_zpowers_inv_pair {a b x : G} (ha : a * a = 1) (hb : b * b = 1)
    (hc : a * b = b * a)
    (hx : x ∈ (Subgroup.zpowers a ⊔ Subgroup.zpowers b : Subgroup G)) :
    x = 1 ∨ x = a ∨ x = b ∨ x = a * b := by
  have h2 : (Subgroup.zpowers a ⊔ Subgroup.zpowers b : Subgroup G) =
      Subgroup.closure ({a, b} : Set G) := by
    rw [Subgroup.zpowers_eq_closure, Subgroup.zpowers_eq_closure, ← Subgroup.closure_union]
    congr 1
  rw [h2] at hx
  exact mem_closure_inv_pair ha hb hc hx

/-- Conjugation by an element fixing `a` and sending `b` to `ab` preserves `⟨a, b⟩`
(`a`, `b` commuting involutions). -/
theorem conj_mem_sup_zpowers_inv_pair {a b u x : G} (ha : a * a = 1) (hb : b * b = 1)
    (hc : a * b = b * a) (hua : u * a * u⁻¹ = a) (hub : u * b * u⁻¹ = a * b)
    (hx : x ∈ (Subgroup.zpowers a ⊔ Subgroup.zpowers b : Subgroup G)) :
    u * x * u⁻¹ ∈ (Subgroup.zpowers a ⊔ Subgroup.zpowers b : Subgroup G) := by
  rcases mem_sup_zpowers_inv_pair ha hb hc hx with h1 | h1 | h1 | h1
  · rw [h1]; simp
  · rw [h1, hua]; exact Subgroup.mem_sup_left (Subgroup.mem_zpowers a)
  · rw [h1, hub]
    exact Subgroup.mul_mem_sup (Subgroup.mem_zpowers a) (Subgroup.mem_zpowers b)
  · rw [h1]
    have h : u * (a * b) * u⁻¹ = (u * a * u⁻¹) * (u * b * u⁻¹) := by group
    rw [h, hua, hub, ← mul_assoc, ha, one_mul]
    exact Subgroup.mem_sup_right (Subgroup.mem_zpowers b)

end Pair

section Conj

variable {G : Type*} [Group G]


/-- For `H ≤ K`, `|H|` divides `|K|`. -/
theorem card_dvd_card_of_le {H K : Subgroup G} (h : H ≤ K) :
    Nat.card ↥H ∣ Nat.card ↥K := by
  have h1 := Subgroup.relIndex_mul_card H K
  rw [inf_eq_left.mpr h] at h1
  exact ⟨H.relIndex K, by rw [mul_comm]; exact h1.symm⟩

end Conj

/-! ## §2 Bender's tori `R_u = [t, C_E(u)]` -/

section Torus

variable {G : Type} [Group G] [Finite G]

theorem layerIn_le_Hhat (B : BenderSetup G) : layerIn B.Hhat ≤ B.Hhat :=
  Subgroup.map_subtype_le _

/-- `R_u = [t, C_E(u)] ≤ E` when `t ∈ E`. -/
theorem torusR_le_layer (B : BenderSetup G) {u : G} (ht : B.t ∈ layerIn B.Hhat) :
    torusR B u ≤ layerIn B.Hhat := by
  show ⁅Subgroup.zpowers B.t, layerIn B.Hhat ⊓ Subgroup.centralizer ({u} : Set G)⁆ ≤
    layerIn B.Hhat
  refine Subgroup.commutator_le.mpr (fun g1 hg1 g2 hg2 => ?_)
  have h1 : g1 ∈ layerIn B.Hhat := Subgroup.zpowers_le.mpr ht hg1
  have h2 : g2 ∈ layerIn B.Hhat := (Subgroup.mem_inf.mp hg2).1
  rw [commutatorElement_def]
  exact (layerIn B.Hhat).mul_mem
    ((layerIn B.Hhat).mul_mem ((layerIn B.Hhat).mul_mem h1 h2) ((layerIn B.Hhat).inv_mem h1))
    ((layerIn B.Hhat).inv_mem h2)

/-- `R_u = [t, C_E(u)] ≤ C_G(u)`. -/
theorem torusR_le_centralizer (B : BenderSetup G) {u : G} (htu : B.t * u = u * B.t) :
    torusR B u ≤ Subgroup.centralizer ({u} : Set G) := by
  show ⁅Subgroup.zpowers B.t, layerIn B.Hhat ⊓ Subgroup.centralizer ({u} : Set G)⁆ ≤
    Subgroup.centralizer ({u} : Set G)
  refine Subgroup.commutator_le.mpr (fun g1 hg1 g2 hg2 => ?_)
  have h1 : g1 ∈ Subgroup.centralizer ({u} : Set G) :=
    Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr htu) hg1
  have h2 : g2 ∈ Subgroup.centralizer ({u} : Set G) := (Subgroup.mem_inf.mp hg2).2
  rw [commutatorElement_def]
  exact (Subgroup.centralizer ({u} : Set G)).mul_mem
    ((Subgroup.centralizer ({u} : Set G)).mul_mem
      ((Subgroup.centralizer ({u} : Set G)).mul_mem h1 h2)
      ((Subgroup.centralizer ({u} : Set G)).inv_mem h1))
    ((Subgroup.centralizer ({u} : Set G)).inv_mem h2)

end Torus

/-! ## §3 The assembly -/

theorem c14_torus (T : Work.GW2.LocalToolkit) (hAut : Work.GW2.Thm26bAutProp)
    (hCom : Work.L2F.PGL2CommutatorTorusProp) : Work.GW2.Thm26bTorusProp := by
  intro G hG hFin hFT hbc B ht hS8 s hsS hs2 hsE
  -- ---- 0. `E(Ĥ) ≠ ⊥` and the recognition data of `Thm26bAutProp` ----
  have hE : layerIn B.Hhat ≠ ⊥ := by
    intro h
    exact bSetup_t_ne_one B (by simpa [h] using ht)
  obtain ⟨⟨p, k, hpfact, hpodd, hge, φ, hsurj, hker, hmem⟩, Mt, hMtH, hNMt, hMtn, hMtodd,
    hMt2⟩ := hAut G hFT hbc B hE
  haveI : Fact p.Prime := hpfact
  let D : PGLData B p k := ⟨φ, hsurj, hker, hmem⟩
  -- ---- 1. elementary facts about `t`, `s`, `ts = t * s` ----
  have htS : B.t ∈ (B.S : Subgroup G) := bSetup_t_mem_S B
  have ht2mul : B.t * B.t = 1 := by rw [← pow_two, ← B.t_order]; exact pow_orderOf_eq_one B.t
  have hs2mul : s * s = 1 := by rw [← pow_two, ← hs2]; exact pow_orderOf_eq_one s
  have hs_ne_one : s ≠ 1 := by
    intro h
    have h2 := hs2
    rw [h, orderOf_one] at h2
    exact absurd h2 (by norm_num)
  have hcomm_ts : B.t * s = s * B.t :=
    (Subgroup.mem_centralizer_iff.mp (bSetup_S_le_H B hsS)) B.t (by simp)
  have hts2mul : (B.t * s) * (B.t * s) = 1 := by
    calc (B.t * s) * (B.t * s) = B.t * (s * B.t) * s := by group
      _ = B.t * (B.t * s) * s := by rw [← hcomm_ts]
      _ = (B.t * B.t) * (s * s) := by group
      _ = 1 := by rw [ht2mul, hs2mul, one_mul]
  have hts_ne_one : B.t * s ≠ 1 := by
    intro h
    have hbt : B.t = s := by
      have h2 := congrArg (fun z => z * s) h
      simpa [mul_assoc, hs2mul] using h2
    exact hsE (by rw [← hbt]; exact ht)
  have hts_order : orderOf (B.t * s) = 2 := by
    rw [orderOf_eq_prime_iff]
    exact ⟨by rw [pow_two]; exact hts2mul, hts_ne_one⟩
  have htsE : B.t * s ∉ layerIn B.Hhat := by
    intro h
    apply hsE
    have hs_eq : s = B.t * (B.t * s) := by rw [← mul_assoc, ht2mul, one_mul]
    rw [hs_eq]
    exact (layerIn B.Hhat).mul_mem ht h
  have htsS : B.t * s ∈ (B.S : Subgroup G) := (B.S : Subgroup G).mul_mem htS hsS
  -- helper computations for `ts`
  have ht2s : B.t * (B.t * s) = s := by rw [← mul_assoc, ht2mul, one_mul]
  have hts2 : (B.t * s) * B.t = s := by
    calc (B.t * s) * B.t = B.t * (s * B.t) := by rw [mul_assoc]
      _ = B.t * (B.t * s) := by rw [hcomm_ts]
      _ = s := ht2s
  have hcomm_t_ts : B.t * (B.t * s) = (B.t * s) * B.t := by rw [ht2s, hts2]
  -- ---- 2. `V = ⟨t, s⟩ ≤ S ≤ Ĥ` ----
  set V : Subgroup G := (Subgroup.zpowers B.t ⊔ Subgroup.zpowers s : Subgroup G) with hVdef
  have hV_le_S : V ≤ (B.S : Subgroup G) :=
    sup_le (Subgroup.zpowers_le.mpr htS) (Subgroup.zpowers_le.mpr hsS)
  have hV_le_Hhat : V ≤ B.Hhat := hV_le_S.trans (bSetup_S_le_Hhat B)
  have htV : B.t ∈ V := Subgroup.mem_sup_left (Subgroup.mem_zpowers B.t)
  -- ---- 3. `W1`, `W2`: the fusion elements `g` and `w` ----
  have hst : s ≠ B.t := fun h => hsE (by rw [h]; exact ht)
  obtain ⟨g, hgN, hgts⟩ := c14_W2 T B hbc hsS hs2 hst
  obtain ⟨w, hwS, hwsw⟩ := c14_W1 B hbc hS8 hsS hs2 hst
  have hwt : w * B.t * w⁻¹ = B.t := by
    have hc : w * B.t = B.t * w := Subgroup.mem_centralizer_singleton_iff.mp (bSetup_S_le_H B hwS)
    rw [hc]; group
  -- ---- 4. `w ∈ N_G(V)` ----
  have hwN : w ∈ Subgroup.normalizer (V : Set G) := by
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      exact conj_mem_sup_zpowers_inv_pair ht2mul hs2mul hcomm_ts hwt hwsw (hVdef ▸ hx)
    · intro hx
      have hwt'' : w⁻¹ * B.t * w = B.t := by
        have h := congrArg (fun z => w⁻¹ * z * w) hwt
        have hL : w⁻¹ * (w * B.t * w⁻¹) * w = B.t := by group
        rw [hL] at h
        exact h.symm
      have hws'' : w⁻¹ * s * w = B.t * s := by
        have h := congrArg (fun z => w⁻¹ * z * w) hwsw
        have hL : w⁻¹ * (w * s * w⁻¹) * w = s := by group
        rw [hL] at h
        have hR : w⁻¹ * (B.t * s) * w = B.t * (w⁻¹ * s * w) := by
          calc w⁻¹ * (B.t * s) * w = (w⁻¹ * B.t * w) * (w⁻¹ * s * w) := by group
            _ = B.t * (w⁻¹ * s * w) := by rw [hwt'']
        rw [hR] at h
        exact mul_left_cancel (a := B.t) (by rw [ht2s]; exact h.symm)
      have hwt' : w⁻¹ * B.t * (w⁻¹)⁻¹ = B.t := by simpa using hwt''
      have hws' : w⁻¹ * s * (w⁻¹)⁻¹ = B.t * s := by simpa using hws''
      have hthis : w⁻¹ * (w * x * w⁻¹) * w ∈
          (Subgroup.zpowers B.t ⊔ Subgroup.zpowers s : Subgroup G) := by
        simpa using
          conj_mem_sup_zpowers_inv_pair ht2mul hs2mul hcomm_ts hwt' hws' (hVdef ▸ hx)
      have hx' : x ∈ (Subgroup.zpowers B.t ⊔ Subgroup.zpowers s : Subgroup G) := by
        rw [show w⁻¹ * (w * x * w⁻¹) * w = x from by group] at hthis
        exact hthis
      rwa [hVdef]
  -- ---- 5. the torus `R*` and the coprimality `gcd(|R*|, kE) = 1` ----
  obtain ⟨htsInverts, -, htsCard⟩ :=
    c14_R_struct T hFT hbc hCom D hpodd hge ht htsS hts_order htsE
  have hkE : kE B = kTor (p ^ k) := c14_k T hFT hbc D hpodd hge ht hS8
  have hcop_mk : Nat.Coprime (mTor (p ^ k)) (kE B) := by
    rw [hkE]; exact c14_arith (p ^ k) (hpodd.pow (n := k))
  -- ---- 6. `v = g t g⁻¹`, `y = g⁻¹ w g` ----
  set v : G := g * B.t * g⁻¹ with hvdef
  have hvV : v ∈ V := by
    rw [hvdef]
    exact (Subgroup.mem_normalizer_iff.mp hgN B.t).mp htV
  have hv_ne_one : v ≠ 1 := by
    intro h1
    have h2 : B.t = 1 := by
      have h := congrArg (fun z => g⁻¹ * z * g) h1
      simpa [hvdef, mul_assoc] using h
    exact bSetup_t_ne_one B h2
  have hv_ne_t : v ≠ B.t := by
    intro h1
    have h1' : g * B.t * g⁻¹ = B.t := by rw [← hvdef]; exact h1
    have h3 : g * (B.t * s) * g⁻¹ = (g * B.t * g⁻¹) * (g * s * g⁻¹) := by group
    rw [hgts, h1'] at h3
    have hgs : g * s * g⁻¹ = 1 :=
      mul_left_cancel (a := B.t) (by rw [mul_one]; exact h3.symm)
    have hs1 : s = 1 := by
      have h := congrArg (fun z => g⁻¹ * z * g) hgs
      simpa [mul_assoc] using h
    exact hs_ne_one hs1
  have hwv : w * v * w⁻¹ = v * B.t := by
    rcases mem_sup_zpowers_inv_pair ht2mul hs2mul hcomm_ts (hVdef ▸ hvV) with h1 | h1 | h1 | h1
    · exact absurd h1 hv_ne_one
    · exact absurd h1 hv_ne_t
    · rw [h1, hwsw, hcomm_ts]
    · rw [h1]
      have h2 : w * (B.t * s) * w⁻¹ = (w * B.t * w⁻¹) * (w * s * w⁻¹) := by group
      rw [h2, hwt, hwsw, ht2s, hts2]
  set y : G := g⁻¹ * w * g with hydef
  have hyN : y ∈ Subgroup.normalizer (V : Set G) := by
    rw [hydef]
    exact (Subgroup.normalizer (V : Set G)).mul_mem
      ((Subgroup.normalizer (V : Set G)).mul_mem
        ((Subgroup.normalizer (V : Set G)).inv_mem hgN) hwN) hgN
  have hy_t : y * B.t * y⁻¹ = s := by
    have h1 : y * B.t * y⁻¹ = g⁻¹ * (w * v * w⁻¹) * g := by
      rw [hvdef]; simp only [hydef]; group
    rw [h1, hwv]
    have h2 : g⁻¹ * (v * B.t) * g = (g⁻¹ * v * g) * (g⁻¹ * B.t * g) := by group
    rw [h2]
    have h3 : g⁻¹ * v * g = B.t := by rw [hvdef]; group
    have h4 : g⁻¹ * B.t * g = B.t * s := by
      have h := congrArg (fun z => g⁻¹ * z * g) hgts
      have hL : g⁻¹ * (g * (B.t * s) * g⁻¹) * g = B.t * s := by group
      rw [hL] at h
      exact h.symm
    rw [h3, h4, ht2s]
  have hy_s : y⁻¹ * s * y = B.t := by
    have h := congrArg (fun z => y⁻¹ * z * y) hy_t
    have hL : y⁻¹ * (y * B.t * y⁻¹) * y = B.t := by group
    rw [hL] at h
    exact h.symm
  -- ---- 7. `X* := R*^g ≤ C_G(E)` via `T1`, and `S` normalizes `X*` via `T1'` ----
  have hRts_le_cent : torusR B (B.t * s) ≤ Subgroup.centralizer ({B.t * s} : Set G) :=
    torusR_le_centralizer B hcomm_t_ts
  have hvS : v ∈ (B.S : Subgroup G) := hV_le_S hvV
  have hvE : v ∉ layerIn B.Hhat := by
    rcases mem_sup_zpowers_inv_pair ht2mul hs2mul hcomm_ts (hVdef ▸ hvV) with h1 | h1 | h1 | h1
    · exact absurd h1 hv_ne_one
    · exact absurd h1 hv_ne_t
    · rw [h1]; exact hsE
    · rw [h1]; exact htsE
  have hXR : ∀ r ∈ torusR B (B.t * s),
      g * r * g⁻¹ ∈ Subgroup.centralizer (layerIn B.Hhat : Set G) := by
    intro r hr
    have hrC : r * (B.t * s) = (B.t * s) * r :=
      ((Subgroup.mem_centralizer_iff.mp (hRts_le_cent hr)) (B.t * s) (by simp)).symm
    have hgt : (g * r * g⁻¹) * B.t = B.t * (g * r * g⁻¹) := by
      calc (g * r * g⁻¹) * B.t = (g * r * g⁻¹) * (g * (B.t * s) * g⁻¹) := by rw [hgts]
        _ = g * (r * (B.t * s)) * g⁻¹ := by group
        _ = g * ((B.t * s) * r) * g⁻¹ := by rw [hrC]
        _ = (g * (B.t * s) * g⁻¹) * (g * r * g⁻¹) := by group
        _ = B.t * (g * r * g⁻¹) := by rw [hgts]
    have hxHhat : g * r * g⁻¹ ∈ B.Hhat :=
      B.H_le_Hhat (Subgroup.mem_centralizer_singleton_iff.mpr hgt)
    have hvinv : v * (g * r * g⁻¹) * v⁻¹ = (g * r * g⁻¹)⁻¹ := by
      have hrt : B.t * r * B.t⁻¹ = r⁻¹ := htsInverts r hr
      rw [hvdef]
      calc (g * B.t * g⁻¹) * (g * r * g⁻¹) * (g * B.t * g⁻¹)⁻¹
          = g * (B.t * r * B.t⁻¹) * g⁻¹ := by group
        _ = g * r⁻¹ * g⁻¹ := by rw [hrt]
        _ = (g * r * g⁻¹)⁻¹ := by group
    have hcopx : Nat.Coprime (orderOf (g * r * g⁻¹)) (kE B) := by
      have hord : orderOf (g * r * g⁻¹) = orderOf r := by
        rw [← MulAut.conj_apply]
        exact orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective r
      rw [hord]
      have hdvd : orderOf r ∣ mTor (p ^ k) := by
        rw [← htsCard]; exact Subgroup.orderOf_dvd_natCard _ hr
      exact Nat.Coprime.coprime_dvd_left hdvd hcop_mk
    exact c14_T1 T hFT hbc ht Mt hMtH hNMt hMtn hMtodd hMt2 hxHhat hgt hvS hvinv hcopx
  have hXC : conjSub g (torusR B (B.t * s)) ≤
      Subgroup.centralizer (layerIn B.Hhat : Set G) := by
    intro x hx
    rw [conjSub_eq_map] at hx
    obtain ⟨r, hr, hxr⟩ := Subgroup.mem_map.mp hx
    rw [← hxr]
    have h := hXR r hr
    rwa [← MulAut.conj_apply] at h
  have hmul : ∀ a ∈ (B.S : Subgroup G), ∀ b ∈ (B.S : Subgroup G),
      a ∉ layerIn B.Hhat → b ∉ layerIn B.Hhat → a * b ∈ layerIn B.Hhat := by
    intro a ha b hb haE hbE
    exact c14_mul_mem_layer D hpodd hge (S_le_SE (B := B) ha) (S_le_SE (B := B) hb) haE hbE
  have hinvX : ∀ x ∈ conjSub g (torusR B (B.t * s)), v * x * v⁻¹ = x⁻¹ := by
    intro x hx
    rw [conjSub_eq_map] at hx
    obtain ⟨r, hr, rfl⟩ := Subgroup.mem_map.mp hx
    have hrt : B.t * r * B.t⁻¹ = r⁻¹ := htsInverts r hr
    rw [hvdef]
    show (g * B.t * g⁻¹) * ((MulAut.conj g) r) * (g * B.t * g⁻¹)⁻¹ =
      ((MulAut.conj g) r)⁻¹
    rw [MulAut.conj_apply]
    calc (g * B.t * g⁻¹) * (g * r * g⁻¹) * (g * B.t * g⁻¹)⁻¹
        = g * (B.t * r * B.t⁻¹) * g⁻¹ := by group
      _ = g * r⁻¹ * g⁻¹ := by rw [hrt]
      _ = (g * r * g⁻¹)⁻¹ := by group
  have hSnorm : ∀ w' ∈ (B.S : Subgroup G), ∀ x ∈ conjSub g (torusR B (B.t * s)),
      w' * x * w'⁻¹ ∈ conjSub g (torusR B (B.t * s)) :=
    c14_S_normalizes B hmul hXC hvS hvE hinvX
  -- ---- 8. `y R* y⁻¹ = R*` ----
  have hconjX : conjSub w (conjSub g (torusR B (B.t * s))) =
      conjSub g (torusR B (B.t * s)) := by
    refine le_antisymm ?_ ?_
    · intro x hx
      rw [conjSub_eq_map, Subgroup.mem_map] at hx
      obtain ⟨z, hz, rfl⟩ := hx
      exact hSnorm w hwS z hz
    · intro x hx
      rw [conjSub_eq_map, Subgroup.mem_map]
      refine ⟨w⁻¹ * x * (w⁻¹)⁻¹,
        hSnorm w⁻¹ ((B.S : Subgroup G).inv_mem hwS) x hx, ?_⟩
      show (MulAut.conj w) (w⁻¹ * x * (w⁻¹)⁻¹) = x
      rw [MulAut.conj_apply]
      group
  have hconjy : conjSub y (torusR B (B.t * s)) = torusR B (B.t * s) := by
    have h1 : conjSub y (torusR B (B.t * s)) =
        conjSub g⁻¹ (conjSub w (conjSub g (torusR B (B.t * s)))) := by
      rw [hydef, conjSub_mul, conjSub_mul]
    rw [h1, hconjX, conjSub_inv_conjSub]
  -- ---- 9. the inclusion `⟨t, R_s, R_ts⟩ ≤ E ⊓ Ĥ^y` ----
  have hRts_mem : torusR B (B.t * s) ≤ conjSub y B.Hhat := by
    intro x hx
    rw [mem_conjSub_iff]
    have hx' : x ∈ conjSub y (torusR B (B.t * s)) := by rw [hconjy]; exact hx
    exact layerIn_le_Hhat B (torusR_le_layer B ht ((mem_conjSub_iff).mp hx'))
  have hRs_mem : torusR B s ≤ conjSub y B.Hhat := by
    intro x hx
    rw [mem_conjSub_iff]
    apply B.H_le_Hhat
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hxs : x * s = s * x :=
      ((Subgroup.mem_centralizer_iff.mp (torusR_le_centralizer B hcomm_ts hx)) s
        (by simp)).symm
    calc (y⁻¹ * x * y) * B.t = (y⁻¹ * x * y) * (y⁻¹ * s * y) := by rw [hy_s]
      _ = y⁻¹ * (x * s) * y := by group
      _ = y⁻¹ * (s * x) * y := by rw [hxs]
      _ = B.t * (y⁻¹ * x * y) := by rw [← hy_s]; group
  have ht_mem : B.t ∈ conjSub y B.Hhat := by
    rw [mem_conjSub_iff]
    have hyinvN : y⁻¹ ∈ Subgroup.normalizer (V : Set G) :=
      (Subgroup.normalizer (V : Set G)).inv_mem hyN
    have hmemV : y⁻¹ * B.t * y ∈ V := by
      have h := (Subgroup.mem_normalizer_iff.mp hyinvN B.t).mp htV
      simpa using h
    exact hV_le_Hhat hmemV
  have hle : (Subgroup.zpowers B.t ⊔ torusR B s ⊔ torusR B (B.t * s) : Subgroup G) ≤
      layerIn B.Hhat ⊓ conjSub y B.Hhat :=
    sup_le (sup_le (le_inf (Subgroup.zpowers_le.mpr ht) (Subgroup.zpowers_le.mpr ht_mem))
      (le_inf (torusR_le_layer B ht) hRs_mem))
      (le_inf (torusR_le_layer B ht) hRts_mem)
  -- ---- 10. conclusion ----
  have h4 : 4 ∣ Nat.card ↥(layerIn B.Hhat ⊓ conjSub y B.Hhat) :=
    dvd_trans (c14_four_dvd T hFT hbc hCom D hpodd hge ht hsS hs2 hsE)
      (card_dvd_card_of_le hle)
  refine ⟨y, ?_, hy_t, h4⟩
  exact hyN

end Work.CORE2A
