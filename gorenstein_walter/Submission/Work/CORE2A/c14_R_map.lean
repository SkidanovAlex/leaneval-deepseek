import Mathlib
import Submission.Work.CORE2A.TorusDefs
import Submission.Work.CORE2A.Thm26bVocab
import Submission.Work.CORE2A.c14_lift

/-!
# CORE2A, design pass 14, `P3`: the image of Bender's torus in `PGL₂(q)`

`Work.CORE2A.c14_R_map` is the computation of the `φ`-image of Bender's torus
`R_u = [t, C_{E(Ĥ)}(u)]` (`Submission/Work/_design_gw/Core14.lean`, `c14_R_map`, and
`NOTES_LEAD_gw_design14.md` §P3):

if `E := E(Ĥ)`, `SE = ⟨S, E⟩`, `φ : SE → PGL₂(q)` is the quotient of `Thm26bAutProp` (a)
(kernel `Z(E)`, `φ(E) = L₂(q)`) and `u ∈ S` is an involution, then

  `φ(R_u) = [φ t, L₂(q) ∩ C_{PGL₂(q)}(φ u)]`.

The inclusion `⊆` is formal: `φ` is a homomorphism and `φ` maps `C_E(u)` into the centralizer of
`φ u` (`Subgroup.map_commutator`, `MonoidHom.map_zpowers`).  The inclusion `⊇` is where the
content is: an element of `L₂(q) ∩ C(φ u)` need not be the image of an element of `E` fixed by
`u`, and one uses `Work.CORE2A.c14_lift` (lifting centralizers through the odd kernel `Z(E)`,
Bender 1981 p. 220) to replace a `φ`-preimage by one that commutes with `u`.

Everything reduces to two general group-theoretic bookkeeping lemmas about a subgroup `L ≤ G`:
`zpowers` and the commutator of subgroups computed inside `L`.
-/

open scoped MatrixGroups

namespace Work.CORE2A

open Subgroup
open Work.GW2

/-- `⟨a⟩ ≤ L` considered as the subgroup of `↥L` generated by `a`. -/
theorem subgroupOf_zpowers {G : Type*} [Group G] {L : Subgroup G} {a : G} (ha : a ∈ L) :
    (Subgroup.zpowers a).subgroupOf L = Subgroup.zpowers (⟨a, ha⟩ : ↥L) := by
  ext x
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨n, hn⟩
    exact ⟨n, Subtype.ext (by simpa using hn)⟩
  · rintro ⟨n, hn⟩
    exact ⟨n, by rw [← hn]; simp⟩

/-- The commutator of two subgroups of `L`, computed inside `L`. -/
theorem subgroupOf_commutator {G : Type*} [Group G] {L H K : Subgroup G} (hH : H ≤ L)
    (hK : K ≤ L) : (⁅H, K⁆).subgroupOf L = ⁅H.subgroupOf L, K.subgroupOf L⁆ := by
  have hmap : (⁅H.subgroupOf L, K.subgroupOf L⁆).map L.subtype = ⁅H, K⁆ := by
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hH,
      Subgroup.map_subgroupOf_eq_of_le hK]
  ext x
  rw [← hmap, Subgroup.mem_subgroupOf, Subgroup.mem_map]
  constructor
  · rintro ⟨m, hm, hmx⟩
    rwa [Subtype.ext hmx] at hm
  · exact fun hx => ⟨x, hx, rfl⟩

theorem c14_R_map (T : Work.GW2.LocalToolkit) (hFT : Work.GW2.FeitThompsonProp) {G : Type} [Group G] [Finite G] (hbc : Work.GW2.BenderCtx G) {B : Work.GW2.BenderSetup G} {p k : ℕ} [Fact p.Prime] (D : Work.GW2.PGLData B p k) (ht : B.t ∈ Work.GW2.layerIn B.Hhat) {u : G} (huS : u ∈ (B.S : Subgroup G)) (hu2 : orderOf u = 2) (htSE : B.t ∈ Work.GW2.SE B) (huSE : u ∈ Work.GW2.SE B) : ((Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B)).map D.φ = ⁅Subgroup.zpowers (D.φ ⟨B.t, htSE⟩), Work.GW2.Lsub p k ⊓ Subgroup.centralizer ({D.φ ⟨u, huSE⟩} : Set _)⁆ := by
  have hE_le_SE : Work.GW2.layerIn B.Hhat ≤ Work.GW2.SE B := Work.CORE2A.layerIn_le_SE
  have hH1 : Subgroup.zpowers B.t ≤ Work.GW2.SE B :=
    Subgroup.zpowers_le.mpr (hE_le_SE ht)
  have hH2 : Work.GW2.layerIn B.Hhat ⊓ Subgroup.centralizer ({u} : Set G) ≤ Work.GW2.SE B :=
    le_trans inf_le_left hE_le_SE
  have hcomm : (Work.GW2.torusR B u).subgroupOf (Work.GW2.SE B) =
      ⁅(Subgroup.zpowers B.t).subgroupOf (Work.GW2.SE B),
        (Work.GW2.layerIn B.Hhat ⊓
          Subgroup.centralizer ({u} : Set G)).subgroupOf (Work.GW2.SE B)⁆ :=
    subgroupOf_commutator hH1 hH2
  have key1 : ((Subgroup.zpowers B.t).subgroupOf (Work.GW2.SE B)).map D.φ =
      Subgroup.zpowers (D.φ ⟨B.t, htSE⟩) := by
    rw [subgroupOf_zpowers htSE, MonoidHom.map_zpowers]
  have key2 : ((Work.GW2.layerIn B.Hhat ⊓
        Subgroup.centralizer ({u} : Set G)).subgroupOf (Work.GW2.SE B)).map D.φ =
      Work.GW2.Lsub p k ⊓ Subgroup.centralizer ({D.φ ⟨u, huSE⟩} : Set _) := by
    apply le_antisymm
    · apply le_inf
      · rintro z ⟨x, hx, rfl⟩
        exact (D.mem_layer_iff x).mp hx.1
      · rintro z ⟨x, hx, rfl⟩
        rw [Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul]
        congr 1
        exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp hx.2)
    · rintro z ⟨hzL, hzC⟩
      obtain ⟨x, hxφ⟩ := D.surj z
      have hxL : D.φ x ∈ Work.GW2.Lsub p k := hxφ ▸ hzL
      have hxE : (x : G) ∈ Work.GW2.layerIn B.Hhat := (D.mem_layer_iff x).mpr hxL
      have hxc : D.φ x * D.φ ⟨u, huSE⟩ = D.φ ⟨u, huSE⟩ * D.φ x := by
        rw [hxφ]
        exact Subgroup.mem_centralizer_singleton_iff.mp hzC
      have hu2' : u * u = 1 := by
        rw [← pow_two, ← hu2]
        exact pow_orderOf_eq_one u
      obtain ⟨x', hx'E, hx'u, hx'φ⟩ :=
        Work.CORE2A.c14_lift T hFT hbc D huSE hu2' x hxE hxc
      refine ⟨x', ⟨hx'E, Subgroup.mem_centralizer_singleton_iff.mpr hx'u⟩, ?_⟩
      rw [hx'φ, hxφ]
  rw [hcomm, Subgroup.map_commutator, key1, key2]

end Work.CORE2A
