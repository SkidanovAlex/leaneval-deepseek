/-- In a cyclic group of order two generated by `u`, every element other than `1` is `u`. -/
theorem eq_of_mem_zpowers_of_orderOf_eq_two {G : Type} [Group G] [Finite G] (u : G) (hu : orderOf u = 2) {y : G}
    (hy : y ∈ Subgroup.zpowers u) (hy1 : y ≠ 1) : y = u := by
  haveI : IsCyclic ↥(Subgroup.zpowers u) := Subgroup.isCyclic_zpowers u
  have hy2 : orderOf y = 2 := by
    have hdvd : orderOf y ∣ 2 := by
      rw [← hu]
      exact orderOf_dvd_of_mem_zpowers hy
    rcases (Nat.dvd_prime (by norm_num : Nat.Prime 2)).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hy1
    · exact h
  have heq : (⟨y, hy⟩ : ↥(Subgroup.zpowers u)) = ⟨u, Subgroup.mem_zpowers u⟩ :=
    eq_of_orderOf_eq_two_of_isCyclic
      (a := (⟨y, hy⟩ : ↥(Subgroup.zpowers u)))
      (b := (⟨u, Subgroup.mem_zpowers u⟩ : ↥(Subgroup.zpowers u)))
      (by rw [Subgroup.orderOf_mk]; exact hy2)
      (by rw [Subgroup.orderOf_mk]; exact hu)
  exact congrArg Subtype.val heq

theorem lemma21 (T : Work.GW2.LocalToolkit) (hB : Work.GW2.BGThmBProp)
    (hBSW : Work.GW2.BSW2Prop) : Work.GW2.Lemma21Prop := by
  intro G _ _ hFT hctx B h1
  have hcardS : Nat.card (B.S : Subgroup G) = 2 * Nat.card B.S0 := bSetup_card_S_eq B
  have hS0dvd : 2 ∣ Nat.card B.S0 := by
    rw [← B.t_order]
    exact Subgroup.orderOf_dvd_natCard B.S0 B.t_mem
  have hS0two : 2 ≤ Nat.card B.S0 := Nat.le_of_dvd Nat.card_pos hS0dvd
  have hSge : 2 ≤ Nat.card (B.S : Subgroup G) := by rw [hcardS]; omega
  have hSnotcyc : ¬ IsCyclic (B.S : Subgroup G) :=
    sylow_two_not_isCyclic hctx.simple hctx.nonab B.S hSge
  rcases hctx.sylow B.S with hcyc | ⟨n, hndih⟩
  · exact absurd hcyc hSnotcyc
  have hn2 : 2 ≤ n := by
    obtain ⟨e⟩ := hndih
    have h : Nat.card (B.S : Subgroup G) = 2 * n := by
      rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
    rw [hcardS] at h
    omega
  have hnoIdx : ∀ N : Subgroup G, N.Normal → N.index ≠ 2 := by
    intro N hN hN2
    haveI : N.Normal := hN
    rcases hctx.simple.eq_bot_or_eq_top_of_normal N with hbot | htop
    · have hG2 : Nat.card G = 2 := by
        rw [← Subgroup.index_bot, ← hbot]
        exact hN2
      have hdvd : Nat.card (B.S : Subgroup G) ∣ Nat.card G := Subgroup.card_subgroup_dvd_card _
      have hle := Nat.le_of_dvd (by omega) hdvd
      omega
    · rw [htop, Subgroup.index_top] at hN2
      exact absurd hN2 (by norm_num)
  have honeClass : ∀ x y : G, orderOf x = 2 → orderOf y = 2 → IsConj x y :=
    (T.fus G (B.S) n hn2 hndih hnoIdx).1
  obtain ⟨D, hDS, hDS0, hDt⟩ :=
    bgData_of_setup (B.S) B.S0 B.t B.S0_le B.S0_cyclic B.S0_index B.t_mem B.t_order
      ⟨n, hn2, hndih⟩ honeClass
  have hDH : D.H = B.H := by
    show Subgroup.centralizer ({D.t} : Set G) = Subgroup.centralizer ({B.t} : Set G)
    rw [hDt]
  have hHle : D.H ≤ B.Hhat := by rw [hDH]; exact B.H_le_Hhat
  have hclassHhat : ∀ x y : G, x ∈ B.Hhat → y ∈ B.Hhat → orderOf x = 2 → orderOf y = 2 →
      ∃ g ∈ B.Hhat, g * x * g⁻¹ = y :=
    fun x y hx hy hx2 hy2 => h1 x ⟨hx, hx2⟩ y ⟨hy, hy2⟩
  have hidx5 : B.Hhat.index = 5 :=
    hB G D B.Hhat B.Hhat_coatom.ne_top hHle hclassHhat
  have hcardG : Nat.card G = 5 * Nat.card B.Hhat := by
    have h := Subgroup.index_mul_card B.Hhat
    rw [hidx5] at h
    omega
  have hGdvd : Nat.card G ∣ 120 := by
    have h := card_dvd_factorial_index hctx.simple B.Hhat (bSetup_Hhat_ne_top B)
    rw [hidx5] at h
    norm_num at h
    exact h
  have hHhat_dvd : Nat.card B.Hhat ∣ 24 := by
    refine Nat.dvd_of_mul_dvd_mul_left (k := 5) (by norm_num) ?_
    rw [← hcardG]
    exact hGdvd
  have hHhat_le : Nat.card B.Hhat ≤ 24 := Nat.le_of_dvd (by norm_num) hHhat_dvd
  have hLower := involutions_dihedral_lower (S := B.S) (n := n) hn2 hndih B.S0 B.S0_le
    B.S0_cyclic B.S0_index B.t B.t_mem B.t_order
  have hUpper := involution_class_card (K := B.Hhat) (t := B.t) (bSetup_t_mem_Hhat B)
    B.t_order hclassHhat
  have hsubset : {x : G | x ∈ (B.S : Subgroup G) ∧ orderOf x = 2} ⊆
      {x : G | x ∈ B.Hhat ∧ orderOf x = 2} :=
    fun x hx => ⟨bSetup_S_le_Hhat B hx.1, hx.2⟩
  have hrelLow : Nat.card B.S0 + 1 ≤
      (Subgroup.centralizer ({B.t} : Set G)).relIndex B.Hhat := by
    rw [← hUpper]
    exact le_trans hLower (Set.ncard_le_ncard hsubset)
  have hrelMul : (Subgroup.centralizer ({B.t} : Set G)).relIndex B.Hhat * Nat.card B.H =
      Nat.card B.Hhat := by
    have h := Subgroup.relIndex_mul_card (Subgroup.centralizer ({B.t} : Set G)) B.Hhat
    rw [inf_eq_left.mpr B.H_le_Hhat] at h
    exact h
  have hSleH : Nat.card (B.S : Subgroup G) ≤ Nat.card B.H := by
    refine Nat.card_le_card_of_injective
      (fun x : ↥(B.S : Subgroup G) => (⟨(x : G), bSetup_S_le_H B x.2⟩ : B.H)) ?_
    intro a b hab
    have hval : (a : G) = (b : G) := congrArg (fun z : B.H => (z : G)) hab
    exact Subtype.ext hval
  have hcombined : (Nat.card B.S0 + 1) * Nat.card (B.S : Subgroup G) ≤ Nat.card B.Hhat :=
    calc (Nat.card B.S0 + 1) * Nat.card (B.S : Subgroup G)
        ≤ (Subgroup.centralizer ({B.t} : Set G)).relIndex B.Hhat *
            Nat.card (B.S : Subgroup G) := Nat.mul_le_mul_right _ hrelLow
      _ ≤ (Subgroup.centralizer ({B.t} : Set G)).relIndex B.Hhat * Nat.card B.H :=
            Nat.mul_le_mul_left _ hSleH
      _ = Nat.card B.Hhat := hrelMul
  have h24 : (Nat.card B.S0 + 1) * (2 * Nat.card B.S0) ≤ 24 := by
    rw [hcardS] at hcombined
    exact le_trans hcombined hHhat_le
  have hS0le3 : Nat.card B.S0 ≤ 3 := by nlinarith [Nat.zero_le (Nat.card B.S0)]
  have hS0card : Nat.card B.S0 = 2 := by omega
  have hScard : Nat.card (B.S : Subgroup G) = 4 := by rw [hcardS, hS0card]
  have hHhat_ne24 : Nat.card B.Hhat ≠ 24 := by
    intro h24'
    have hG120 : Nat.card G = 120 := by rw [hcardG, h24']
    have h1' := Subgroup.index_mul_card (B.S : Subgroup G)
    rw [hScard, hG120] at h1'
    have h2' : (B.S : Subgroup G).index = 30 := by omega
    exact (Sylow.not_dvd_index B.S) (by rw [h2']; norm_num)
  have hrl3 : 3 ≤ (Subgroup.centralizer ({B.t} : Set G)).relIndex B.Hhat := by
    have := hrelLow
    rw [hS0card] at this
    exact this
  have h4dvdH : 4 ∣ Nat.card B.H := by
    have h := Subgroup.card_subgroup_dvd_card ((B.S : Subgroup G).subgroupOf B.H)
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe (bSetup_S_le_H B)).toEquiv] at h
    rw [← hScard]
    exact h
  have hHle8 : Nat.card B.H ≤ 8 := by
    have := hrelMul
    nlinarith [hrl3, hHhat_le]
  have hHne8 : Nat.card B.H ≠ 8 := by
    intro h8
    have h24' : Nat.card B.Hhat = 24 := by
      have hh := hrelMul
      rw [h8] at hh
      have : 24 ≤ Nat.card B.Hhat := by nlinarith
      omega
    exact hHhat_ne24 h24'
  have hHcard : Nat.card B.H = 4 := by
    rcases h4dvdH with ⟨k, hk⟩
    have hSleH4 : 4 ≤ Nat.card B.H := by rw [← hScard]; exact hSleH
    omega
  have hSeqH : (B.S : Subgroup G) = B.H :=
    Subgroup.eq_of_le_of_card_ge (bSetup_S_le_H B) (by rw [hScard, hHcard])
  have hS0eq : B.S0 = Subgroup.zpowers B.t := by
    have hzp : Subgroup.zpowers B.t ≤ B.S0 := Subgroup.zpowers_le.mpr B.t_mem
    have hcardzp : Nat.card ↥(Subgroup.zpowers B.t) = 2 := by
      rw [Nat.card_zpowers, B.t_order]
    exact (Subgroup.eq_of_le_of_card_ge hzp (by rw [hS0card, hcardzp])).symm
  obtain ⟨s, hsS, hs0⟩ := bSetup_exists_mem_S_not_mem_S0 B
  have hsord : orderOf s = 2 :=
    dihedral_index_two n hn2 (B.S : Subgroup G) B.S0 hndih B.S0_le B.S0_cyclic B.S0_index
      s hsS hs0
  have hc : B.t * s = s * B.t :=
    Subgroup.mem_centralizer_iff.mp (bSetup_S_le_H B hsS) B.t (by simp)
  have hst : s * B.t * s⁻¹ = B.t := by
    rw [show s * B.t = B.t * s from hc.symm]
    group
  have hInverts : Inverts s B.S0 := by
    intro x hx
    rw [hS0eq] at hx
    by_cases hx1 : x = 1
    · subst hx1; simp
    · have hx2 : x = B.t := eq_of_mem_zpowers_of_orderOf_eq_two B.t B.t_order hx hx1
      subst hx2
      rw [hst]
      exact (inv_eq_of_mul_eq_one_left (by
        rw [← pow_two, ← B.t_order]; exact pow_orderOf_eq_one B.t)).symm
  have hKcomm : IsMulCommutative B.S0 := by
    haveI := B.S0_cyclic
    exact IsCyclic.isMulCommutative
  have hsup : B.S0 ⊔ Subgroup.zpowers s = (B.S : Subgroup G) := by
    have hle : B.S0 ⊔ Subgroup.zpowers s ≤ (B.S : Subgroup G) :=
      sup_le B.S0_le (Subgroup.zpowers_le.mpr hsS)
    have hdvd : Nat.card ↥(B.S0 ⊔ Subgroup.zpowers s) ∣ 4 := by
      have h := Subgroup.relIndex_mul_card (B.S0 ⊔ Subgroup.zpowers s) (B.S : Subgroup G)
      rw [inf_eq_left.mpr hle, hScard] at h
      exact ⟨_, by rw [mul_comm]; exact h.symm⟩
    have hge : 3 ≤ Nat.card ↥(B.S0 ⊔ Subgroup.zpowers s) := by
      have hcard : Nat.card (↥B.S0 ⊕ Fin 1) = 3 := by
        rw [Nat.card_sum, Nat.card_unique (α := Fin 1), hS0card]
      rw [← hcard]
      have hinj : Function.Injective (fun z : ↥B.S0 ⊕ Fin 1 =>
          Sum.elim (fun x : ↥B.S0 => (⟨(x : G), Subgroup.mem_sup_left x.2⟩ :
              ↥(B.S0 ⊔ Subgroup.zpowers s)))
            (fun _ : Fin 1 => (⟨s, Subgroup.mem_sup_right (Subgroup.mem_zpowers s)⟩ :
              ↥(B.S0 ⊔ Subgroup.zpowers s))) z) := by
        intro a b hab
        cases a with
        | inl x =>
          cases b with
          | inl y =>
            have hxy : (x : G) = (y : G) := by
              have h' := congrArg (fun z : ↥(B.S0 ⊔ Subgroup.zpowers s) => (z : G)) hab
              simpa only [Sum.elim_inl, Subtype.coe_mk] using h'
            rw [Sum.inl.injEq]
            exact Subtype.ext hxy
          | inr y =>
            have hxy : (x : G) = s := by
              have h' := congrArg (fun z : ↥(B.S0 ⊔ Subgroup.zpowers s) => (z : G)) hab
              simpa only [Sum.elim_inl, Sum.elim_inr, Subtype.coe_mk] using h'
            exact absurd hxy (fun h => hs0 (h ▸ x.2))
        | inr x =>
          cases b with
          | inl y =>
            have hxy : s = (y : G) := by
              have h' := congrArg (fun z : ↥(B.S0 ⊔ Subgroup.zpowers s) => (z : G)) hab
              simpa only [Sum.elim_inl, Sum.elim_inr, Subtype.coe_mk] using h'
            exact absurd hxy (fun h => hs0 (h ▸ y.2))
          | inr y => exact congrArg Sum.inr (Subsingleton.elim x y)
      exact Nat.card_le_card_of_injective _ hinj
    have hcard4 : Nat.card ↥(B.S0 ⊔ Subgroup.zpowers s) = 4 := by
      have hle4 : Nat.card ↥(B.S0 ⊔ Subgroup.zpowers s) ≤ 4 :=
        Nat.le_of_dvd (by norm_num) hdvd
      rcases Nat.lt_or_ge (Nat.card ↥(B.S0 ⊔ Subgroup.zpowers s)) 4 with hlt | hge4
      · have h3 : Nat.card ↥(B.S0 ⊔ Subgroup.zpowers s) = 3 := by omega
        rw [h3] at hdvd
        norm_num at hdvd
      · omega
    exact Subgroup.eq_of_le_of_card_ge hle (by rw [hcard4, hScard])
  have hcent : Subgroup.centralizer ({B.t} : Set G) = B.S0 ⊔ Subgroup.zpowers s := by
    show B.H = B.S0 ⊔ Subgroup.zpowers s
    rw [← hSeqH]
    exact hsup.symm
  have hKleCs : B.S0 ≤ Subgroup.centralizer ({s} : Set G) := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    rw [hS0eq] at hx
    by_cases hx1 : x = 1
    · rw [hx1]; simp
    · have hx2 : x = B.t := eq_of_mem_zpowers_of_orderOf_eq_two B.t B.t_order hx hx1
      rw [hx2]
      exact hc.symm
  have hKinfCs : B.S0 ⊓ Subgroup.centralizer ({s} : Set G) = Subgroup.zpowers B.t := by
    rw [← hS0eq]
    exact inf_eq_left.mpr hKleCs
  have hcentral : ∀ g : G, g ∉ Subgroup.centralizer ({B.t} : Set G) →
      B.S0 ⊓ conjSub g B.S0 = ⊥ := by
    intro g hg
    have hgt : B.t ≠ g * B.t * g⁻¹ := by
      intro hcon
      apply hg
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      have h3 : (g * B.t * g⁻¹) * g = g * B.t := by group
      rw [← hcon] at h3
      exact h3
    have huord : orderOf (g * B.t * g⁻¹) = 2 := by
      have hsem : SemiconjBy g B.t (g * B.t * g⁻¹) := by simp [SemiconjBy, mul_assoc]
      exact (SemiconjBy.orderOf_eq g hsem).symm.trans B.t_order
    rw [hS0eq, conjSub_eq_map, MonoidHom.map_zpowers]
    change Subgroup.zpowers B.t ⊓ Subgroup.zpowers (g * B.t * g⁻¹) = ⊥
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    rw [Subgroup.mem_inf] at hx
    obtain ⟨hx1, hx2⟩ := hx
    by_contra hxne
    have e1 : x = B.t := eq_of_mem_zpowers_of_orderOf_eq_two B.t B.t_order hx1 hxne
    have e2 : x = g * B.t * g⁻¹ := eq_of_mem_zpowers_of_orderOf_eq_two (g * B.t * g⁻¹) huord hx2 hxne
    exact hgt (e1.symm.trans e2)
  have hBSW2 : BSWHyps2 G B.t s B.S0 :=
    ⟨B.t_order, hsord, B.t_mem, hs0, hKcomm, hcent, hInverts, hKinfCs, hcentral,
      fun x hx => honeClass x B.t hx B.t_order⟩
  obtain ⟨p, k, hp, hodd, h5, he⟩ := hBSW G hctx.simple hctx.nonab B.t s B.S0 hBSW2
  obtain ⟨e⟩ := he
  exact (hctx.notPSL p k hp hodd h5).false e

end Work.CORE2A
