import Mathlib
import Submission.Work.BG.KappaCharDefs
import Submission.Work.BG.fixed_eq_one_of_mem_closure
import Submission.Work.BG.conjActionUab

/-!
# Area BG: `κ`-existence — a non-trivial `S`-fixed linear character of `U`

Gorenstein–Walter / Bender–Glauberman, "C3-0": let `U ≤ G` be a subgroup of odd order, `S ≤ G` a
2-subgroup normalising `U`, and `B ≤ U` a subgroup contained in the centraliser of `S` with
`B ⊄ ⁅U,U⁆`.  Then there is a non-trivial homomorphism `χ : ↥U →* ℂˣ` which is invariant under
conjugation with every element of `S`.

The proof goes through the abelianisation `U/U'` (`Work.BG.Uab`):

* `b ∈ B ∖ ⁅U,U⁆` has a non-trivial image `x` in `U/U'` (`Work.BG.UabMk_eq_one_iff`) that is fixed
  by the conjugation action `φ` of `S` on `U/U'` (`Work.BG.conjActionUab`);
* a coprime-action argument (`Work.BG.fixed_eq_one_of_mem_closure`) shows that `x` does not lie in
  the subgroup `H` generated by the commutators `φ s u * u⁻¹` of the action — i.e. the image of
  `⁅U,S⁆`;
* characters of the finite commutative group `U/U'` separate points from subgroups
  (`CommGroup.forall_monoidHom_apply_eq_one_iff`), so there is `θ : U/U' →* ℂˣ` which is trivial on
  `H` and satisfies `θ x ≠ 1`;
* `χ := θ ∘ (↥U →* U/U')` is then the required character: it is non-trivial at `b`, and for
  `s ∈ S`, `u ∈ U` we have `s u s⁻¹ u⁻¹ = [s,u] ∈ ⁅U,S⁆`, so `χ (s u s⁻¹) = χ u`.
-/

namespace Work.BG

open Subgroup
open scoped commutatorElement

open Subgroup in
theorem kappaCharExists {G : Type} [Group G] [Finite G] (U S : Subgroup G)
    (hnorm : S ≤ Subgroup.normalizer (U : Set G)) (hodd : Odd (Nat.card ↥U))
    (hS : IsPGroup 2 S) {B : Subgroup G} (hBU : B ≤ U)
    (hfix : B ≤ Subgroup.centralizer ((S : Subgroup G) : Set G))
    (hB : ¬ B ≤ ⁅U, U⁆) :
    ∃ χ : ↥U →* ℂˣ, χ ≠ 1 ∧
      ∀ (s : S) (u : ↥U),
        χ ⟨(s : G) * (u : G) * (s : G)⁻¹,
            (Subgroup.mem_normalizer_iff.mp (hnorm s.2) (u : G)).mp u.2⟩ = χ u := by
  classical
  -- some `b ∈ B` outside the derived subgroup `⁅U,U⁆`
  obtain ⟨b, hbB, hbU'⟩ : ∃ b ∈ B, b ∉ ⁅U, U⁆ := by
    simpa only [IsConcreteLE.not_le_iff_exists] using hB
  have hbU : b ∈ U := hBU hbB
  -- `b` is fixed by conjugation with `S`
  have hbfix : ∀ s : ↥S, (s : G) * b * (s : G)⁻¹ = b := by
    intro s
    have h1 : b ∈ Subgroup.centralizer ((S : Subgroup G) : Set G) := hfix hbB
    have h2 : (s : G) * b = b * (s : G) :=
      (Subgroup.mem_centralizer_iff.mp h1) (s : G) s.2
    rw [h2, mul_assoc, mul_inv_cancel, mul_one]
  -- the conjugation action of `S` on the abelianisation `U/U'`
  obtain ⟨φ, hφ⟩ := conjActionUab U S hnorm
  set x : Uab U := UabMk U ⟨b, hbU⟩ with hxdef
  have hx1 : x ≠ 1 := by
    intro hx
    rw [hxdef, UabMk_eq_one_iff] at hx
    exact hbU' hx
  have hxfix : ∀ s : ↥S, φ s x = x := by
    intro s
    have hb' : (⟨(s : G) * b * (s : G)⁻¹,
        (Subgroup.mem_normalizer_iff.mp (hnorm s.2) (b : G)).mp hbU⟩ : ↥U) = ⟨b, hbU⟩ :=
      Subtype.ext (hbfix s)
    rw [hxdef, hφ s ⟨b, hbU⟩, hb']
  -- the subgroup generated by the `S`-commutators
  let H : Subgroup (Uab U) :=
    Subgroup.closure {w : Uab U | ∃ (u : Uab U) (s : ↥S), φ s u * u⁻¹ = w}
  have hxH : x ∉ H := by
    intro hxHmem
    have hcop : Nat.Coprime (Nat.card ↥S) (Nat.card (Uab U)) := by
      obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hS
      have hoddV : Odd (Nat.card (Uab U)) :=
        Odd.of_dvd_nat hodd (Subgroup.card_quotient_dvd_card (derivedU U))
      rw [hk]
      exact Nat.Coprime.pow_left k (Nat.coprime_two_left.mpr hoddV)
    exact hx1 (fixed_eq_one_of_mem_closure φ hcop hxfix hxHmem)
  -- a character of `U/U'` killing `H` and non-trivial at `x`
  have hchar : ∃ θ : Uab U →* ℂˣ, (∀ y ∈ H, θ y = 1) ∧ θ x ≠ 1 := by
    have hiff := CommGroup.forall_monoidHom_apply_eq_one_iff (M := ℂ) H x
    have hnot : ¬ (∀ θ : Uab U →* ℂˣ, (∀ y ∈ H, θ y = 1) → θ x = 1) := by
      rw [hiff]
      exact hxH
    obtain ⟨θ, hθ⟩ := not_forall.mp hnot
    exact ⟨θ, not_imp.mp hθ⟩
  obtain ⟨θ, hθH, hθx⟩ := hchar
  refine ⟨θ.comp (UabMk U), ?_, ?_⟩
  · intro hcon
    have h1 : θ x = 1 := by
      have h2 := congrArg (fun f : ↥U →* ℂˣ => f ⟨b, hbU⟩) hcon
      simpa [hxdef, MonoidHom.comp_apply] using h2
    exact hθx h1
  · intro s u
    have hgen : φ s (UabMk U u) * (UabMk U u)⁻¹ ∈ H :=
      Subgroup.subset_closure
        (k := {w : Uab U | ∃ (u : Uab U) (s : ↥S), φ s u * u⁻¹ = w})
        ⟨UabMk U u, s, rfl⟩
    have hθ := hθH _ hgen
    simp only [MonoidHom.comp_apply]
    rw [← hφ s u]
    rw [map_mul, map_inv] at hθ
    rw [mul_inv_eq_one] at hθ
    exact hθ

end Work.BG
