import Mathlib
import Submission.Work.BG.ThmABCCharDefs
import Submission.Work.BG.nCases
import Submission.Work.BG.rem31UinfS0
import Submission.Work.BG.notMemSupZpowersSq
import Submission.Work.BG.rem31GenEven

set_option linter.style.haveILetI false

/-!
# Area BG: the structural shape of `H₀` (`Work.BG.rem31Structure`)

Bender–Glauberman, J. Algebra 70 (1981), §3 (`S'` centralizes `U`), uses throughout the shape
of the group `H₀ = U S₀`: `H₀/U ≅ S₀` is cyclic, generated by the image of the element `t₁t₂`
of `S₀`; `(t₁t₂)²` is central in `H₀` (the §3 hypothesis); and `⟨(t₁t₂)²⟩ ∩ U = 1`.
In particular `U ⟨(t₁t₂)²⟩` has index two in `H₀`, while `t₁t₂` itself lies outside it.

This module provides the element `c := t₁ t₂ ∈ H₀` with those six properties, in the group
`↥C.P.H0` of a §2 context `C` compatible with `D`.  The supplied facts are exactly those
needed to run Clifford theory of `H₀` over `U` with `⟨c⟩` lifting a generator of `H₀/U`:
`H₀` is generated over `U` by `c`, the subgroup `U ⊔ ⟨c²⟩` is normal of index two with
`c` outside it, and `c²` is central.
-/

namespace Work.BG

open OddOrder.RepresentationTheory Work.GW2 Work.BG Work.GW2.C16 Subgroup

section Helpers

variable {X : Type} [Group X]

/-- `zpowers` of an element of a subgroup `H` is `subgroupOf` the ambient `zpowers`
(the orientation opposite to `Work.BG.zpowers_subgroupOf` of `subBGData.lean`). -/
lemma zpowers_subgroupOf_coe {H : Subgroup X} (x : ↥H) :
    Subgroup.zpowers x = (Subgroup.zpowers (x : X)).subgroupOf H := by
  ext y
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, by rw [← hk, Subgroup.coe_zpow]⟩
  · rintro ⟨k, hk⟩
    exact ⟨k, Subtype.ext (by rw [Subgroup.coe_zpow, hk])⟩

/-- If `M ⊴ X` is generated together with `x` and contains `x ^ 2` but not `x`, then `M` has
index two in `X`: the quotient `X ⧸ M` is generated by the image of `x`, whose square is `1`
and which is nontrivial, so `X ⧸ M` has order two.

Normality of `M` is needed: for `X = S₃`, `M = ⟨(12)⟩`, `x = (13)` all the other hypotheses
hold but `M.index = 3`. -/
theorem indexEqTwoOfSupZpowersEqTopNormal {X : Type} [Group X] [Finite X]
    {M : Subgroup X} [M.Normal] {x : X} (hsup : M ⊔ Subgroup.zpowers x = ⊤)
    (hsq : x ^ 2 ∈ M) (hx : x ∉ M) : M.index = 2 := by
  rw [Subgroup.index_eq_card]
  have hgen : Subgroup.zpowers ((QuotientGroup.mk' M) x) = (⊤ : Subgroup (X ⧸ M)) := by
    have h1 : Subgroup.map (QuotientGroup.mk' M) (⊤ : Subgroup X) = ⊤ :=
      Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective M)
    rw [← hsup, Subgroup.map_sup, MonoidHom.map_zpowers] at h1
    have hbot : Subgroup.map (QuotientGroup.mk' M) M = ⊥ := by
      rw [Subgroup.eq_bot_iff_forall]
      intro y hy
      obtain ⟨m, hm, rfl⟩ := hy
      show ((QuotientGroup.mk' M) m : X ⧸ M) = 1
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact hm
    rw [hbot, bot_sup_eq] at h1
    exact h1
  have hcard : Nat.card (X ⧸ M) = orderOf ((QuotientGroup.mk' M) x) := by
    rw [← Nat.card_congr (Subgroup.topEquiv (G := X ⧸ M)).toEquiv]
    rw [← hgen, Nat.card_zpowers]
  have hdvd : orderOf ((QuotientGroup.mk' M) x) ∣ 2 := by
    rw [orderOf_dvd_iff_pow_eq_one]
    show ((QuotientGroup.mk' M) x) ^ 2 = 1
    rw [← map_pow]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hsq
  have hne : orderOf ((QuotientGroup.mk' M) x) ≠ 1 := by
    intro h
    rw [orderOf_eq_one_iff] at h
    rw [QuotientGroup.mk'_apply] at h
    exact hx ((QuotientGroup.eq_one_iff x).mp h)
  have h2 : orderOf ((QuotientGroup.mk' M) x) = 2 := by
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exact absurd h hne
    · exact h
  rw [hcard, h2]

end Helpers

open OddOrder.RepresentationTheory Work.GW2 Work.BG Work.GW2.C16 in
theorem rem31Structure {G : Type} [Group G] [Finite G] [Fintype G]
    (D : Work.GW2.BGData G) (C : Work.BG.Sec2Ctx G) (hDC : Work.GW2.C16.Compat D C)
    (hS3 : Work.GW2.C16.Sec3Hyp D) :
    ∃ c : ↥C.P.H0,
      (C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers c = ⊤ ∧
      (∀ w : ↥C.P.H0, c ^ 2 * w = w * c ^ 2) ∧
      (C.P.U.subgroupOf C.P.H0) ⊓ Subgroup.zpowers c = ⊥ ∧
      (C.P.U.subgroupOf C.P.H0) ⊓ Subgroup.zpowers (c ^ 2) = ⊥ ∧
      ((C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers (c ^ 2)).index = 2 ∧
      c ∉ ((C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers (c ^ 2) : Subgroup ↥C.P.H0) := by
  have hH0 : C.P.H0 = D.U ⊔ D.S0 := hDC.H0_eq
  have hU : C.P.U = D.U := hDC.U_eq
  have hUleH0 : D.U ≤ C.P.H0 := hU ▸ C.P.U_le_H0
  have hS0leH0 : D.S0 ≤ C.P.H0 := hH0 ▸ le_sup_right
  have hUinfS0 : D.U ⊓ D.S0 = ⊥ := rem31UinfS0 D
  have hgS0 : D.t1 * D.t2 ∈ D.S0 := by rw [D.gen]; exact Subgroup.mem_zpowers _
  have hgH0 : D.t1 * D.t2 ∈ C.P.H0 := by
    rw [hH0]; exact Subgroup.mem_sup_right hgS0
  -- `c = t₁t₂`, viewed in `H₀ = U S₀`
  let c : ↥C.P.H0 := ⟨D.t1 * D.t2, hgH0⟩
  have hc : (c : G) = D.t1 * D.t2 := rfl
  have hzp : Subgroup.zpowers c = D.S0.subgroupOf C.P.H0 := by
    rw [zpowers_subgroupOf_coe, hc, ← D.gen]
  -- (1) `U ⊔ ⟨c⟩ = ⊤`: both sides generate `H₀ = U S₀`
  have hsup1 : (C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers c = ⊤ := by
    rw [hzp, hU, ← Subgroup.subgroupOf_sup hUleH0 hS0leH0, ← hH0,
      Subgroup.subgroupOf_self]
  -- (3) `U ⊓ ⟨c⟩ = ⊥`, from `⟨c⟩ ∩ U = S₀ ∩ U = ⊥`
  have hinf1 : (C.P.U.subgroupOf C.P.H0) ⊓ Subgroup.zpowers c = ⊥ := by
    rw [hzp, hU]
    refine le_bot_iff.mp ?_
    intro y hy
    have hyU : (y : G) ∈ D.U := Subgroup.mem_subgroupOf.mp hy.1
    have hyS0 : (y : G) ∈ D.S0 := Subgroup.mem_subgroupOf.mp hy.2
    have hybot : (y : G) ∈ D.U ⊓ D.S0 := ⟨hyU, hyS0⟩
    rw [hUinfS0, Subgroup.mem_bot] at hybot
    exact Subtype.ext (by simpa using hybot)
  -- (4) `U ⊓ ⟨c²⟩ = ⊥`, since `⟨c²⟩ ≤ ⟨c⟩`
  have hc2le : Subgroup.zpowers (c ^ 2) ≤ Subgroup.zpowers c :=
    Subgroup.zpowers_le.mpr (Subgroup.pow_mem _ (Subgroup.mem_zpowers c) 2)
  have hinf2 : (C.P.U.subgroupOf C.P.H0) ⊓ Subgroup.zpowers (c ^ 2) = ⊥ :=
    le_bot_iff.mp
      ((inf_le_inf_left ((C.P.U.subgroupOf C.P.H0)) hc2le).trans (le_of_eq hinf1))
  -- (6) `c ∉ U ⊔ ⟨c²⟩`, from `c ∉ ⟨c²⟩` (`orderOf c` is even) and `⟨c⟩ ∩ U = ⊥`
  have hceven : Even (orderOf c) := by
    rw [← Subgroup.orderOf_coe c]
    exact rem31GenEven D
  have hnotmem : c ∉ (C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers (c ^ 2) :=
    notMemSupZpowersSq hinf1 hceven
  -- (2) `c²` is central in `H₀`: it centralizes `U` by §3, and `⟨c⟩` is abelian
  have hcent : (⊤ : Subgroup ↥C.P.H0) ≤ Subgroup.centralizer ({c ^ 2} : Set ↥C.P.H0) := by
    rw [← hsup1]
    refine sup_le ?_ ?_
    · intro u hu
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      have huU : (u : G) ∈ D.U := by
        rw [← hU]; exact Subgroup.mem_subgroupOf.mp hu
      have hcomm := hS3 (D.t1 * D.t2) hgS0 (u : G) huU
      have hcoe : ((c ^ 2 : ↥C.P.H0) : G) = (D.t1 * D.t2) ^ 2 := by
        rw [Subgroup.coe_pow, hc]
      refine Subtype.ext ?_
      show ((c ^ 2 : ↥C.P.H0) : G) * (u : G) = (u : G) * ((c ^ 2 : ↥C.P.H0) : G)
      rw [hcoe]
      exact hcomm
    · intro z hz
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hz
      rw [← hk]
      rw [← zpow_natCast c 2]
      rw [← zpow_add, ← zpow_add, add_comm]
  -- (5) `[H₀ : U ⟨c²⟩] = 2`.  `U ⟨c²⟩` is normal (`U ◁ H₀` and `c²` central) and is
  -- generated together with `c`, which lies outside it.
  have hc2center : c ^ 2 ∈ Subgroup.center ↥C.P.H0 :=
    Subgroup.mem_center_iff.mpr fun w =>
      ((Subgroup.mem_centralizer_iff.mp (hcent trivial)) (c ^ 2)
        (Set.mem_singleton (c ^ 2))).symm
  haveI hZnorm : (Subgroup.zpowers (c ^ 2)).Normal :=
    Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr hc2center)
  haveI hMnorm : ((C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers (c ^ 2)).Normal :=
    inferInstance
  have hsupM : ((C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers (c ^ 2)) ⊔ Subgroup.zpowers c
      = ⊤ := by
    rw [sup_assoc, sup_eq_right.mpr hc2le, hsup1]
  have hidx : ((C.P.U.subgroupOf C.P.H0) ⊔ Subgroup.zpowers (c ^ 2)).index = 2 :=
    indexEqTwoOfSupZpowersEqTopNormal hsupM (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
      hnotmem
  refine ⟨c, hsup1, ?_, hinf1, hinf2, hidx, hnotmem⟩
  intro w
  exact (Subgroup.mem_centralizer_iff.mp (hcent trivial)) (c ^ 2) (Set.mem_singleton (c ^ 2))

end Work.BG
