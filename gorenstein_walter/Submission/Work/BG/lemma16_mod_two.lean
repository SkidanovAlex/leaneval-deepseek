import Mathlib
import Submission.Work.BG.Defs
import Submission.Work.BG.CharBridge

/-!
# Bender–Glauberman 1981, Lemma 1.6 (the `mod 2` congruence)

For an involution `t` and an element `u` of odd order commuting with `t`, every virtual
character `φ ∈ ℤ[Irr G]` satisfies

  `φ (t·u) ≡ φ u  (mod 2)`,

i.e. `φ (t·u) - φ u = 2·c` with `c` an algebraic integer (`Work.BG.AlgIntModTwo`).

The statement carries **no** finiteness hypothesis on `G`; the reduction below therefore
isolates the *finite* cyclic subgroup `⟨t·u⟩` and applies the (already established) abelian
form of Peterfalvi (1.10.a) there.  Concretely, with `g = t·u` and `m = orderOf u` (odd):

* `g ^ 2 = u ^ 2` and hence `g ^ (2m) = 1`, so `⟨g⟩ = Subgroup.zpowers g` is finite and
  (being generated by one element) commutative;
* because `m` is odd, `g ^ (m+1) = u` and `g ^ m = t`;
* the restriction `φ|_⟨g⟩` is a virtual character of `⟨g⟩` (a finite subgroup), and
  `exists_integral_zirr_apply_sub` with `p = 2`, `ε = -1` (so `1 - ε = 2`), `x = t`,
  `y = u` gives the result.
-/

set_option linter.style.haveILetI false

namespace Work.BG

open OddOrder.RepresentationTheory

/-- **Restriction to a finite subgroup preserves virtual characters.**  Variant of
`ClassFunction.restrict_mem_ZIrr` that assumes only `Finite ↥H` instead of `Finite G`
(the latter is all the original proof uses, via `Subtype.finite`). -/
theorem restrict_mem_ZIrr_finite {G : Type*} [Group G] (H : Subgroup G) [Finite ↥H]
    {φ : ClassFunction G ℂ} (hφ : φ ∈ ZIrr G) :
    ClassFunction.restrict H φ ∈ ZIrr ↥H := by
  induction hφ using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨V, _, _, _, ρ, hirr, hρeq⟩ := hx
      have hx_eq : x = repCharacterClassFunction ρ := by
        apply ClassFunction.ext
        intro g
        rw [repCharacterClassFunction_apply, congrFun hρeq g]
      rw [hx_eq, ClassFunction.restrict_repCharacterClassFunction H ρ]
      exact character_mem_ZIrr (ρ.comp H.subtype)
  | zero => rw [ClassFunction.restrict_zero]; exact Submodule.zero_mem _
  | add x y _ _ ihx ihy => rw [ClassFunction.restrict_add]; exact Submodule.add_mem _ ihx ihy
  | smul a x _ ih =>
      rw [← Int.cast_smul_eq_zsmul ℂ a x, ClassFunction.restrict_smul, Int.cast_smul_eq_zsmul]
      exact Submodule.smul_mem _ a ih

theorem lemma16_mod_two {G : Type*} [Group G] (t u : G) (ht : t * t = 1)
    (hu : Odd (orderOf u)) (hcomm : t * u = u * t)
    (φ : OddOrder.RepresentationTheory.ClassFunction G ℂ)
    (hφ : φ ∈ OddOrder.RepresentationTheory.ZIrr G) :
    Work.BG.AlgIntModTwo (φ (t * u)) (φ u) := by
  classical
  have hcomm' : Commute t u := hcomm
  set g : G := t * u with hg
  set m : ℕ := orderOf u with hm
  have hmpos : 0 < m := Nat.pos_of_ne_zero fun h => Nat.not_odd_zero (h ▸ hu)
  have ht2 : t^2 = 1 := by rw [pow_two]; exact ht
  -- `g ^ 2 = u ^ 2`
  have hg2 : g^2 = u^2 := by rw [hg, hcomm'.mul_pow 2, ht2, one_mul]
  -- `g ^ (2m) = 1`
  have hpow2m : g^(2*m) = 1 := by
    rw [hg, hcomm'.mul_pow (2*m)]
    rw [show t^(2*m) = (t^2)^m from pow_mul t 2 m, ht2, one_pow, one_mul]
    rw [show u^(2*m) = (u^m)^2 from by rw [mul_comm 2 m, ← pow_mul]]
    rw [hm, pow_orderOf_eq_one, one_pow]
  -- `g ^ (m+1) = u`  (`m` odd, so `m+1 = 2k`)
  have hgu : g^(m+1) = u := by
    obtain ⟨k, hk⟩ := even_iff_exists_two_mul.mp hu.add_one
    rw [hk, show g^(2*k) = (g^2)^k from pow_mul g 2 k, hg2,
        show (u^2)^k = u^(2*k) from (pow_mul u 2 k).symm]
    rw [← hk, pow_succ, hm, pow_orderOf_eq_one, one_mul]
  -- `g ^ m = t`
  have hgt : g^m = t := by
    have h1 : g^m = g^(m+1) * g⁻¹ := by rw [pow_succ]; group
    rw [h1, hgu, hg, mul_inv_rev]
    rw [show u * (u⁻¹ * t⁻¹) = t⁻¹ from by group]
    exact inv_eq_of_mul_eq_one_right ht
  -- `⟨g⟩` is a finite commutative subgroup
  haveI : Finite ↥(Subgroup.zpowers g) :=
    IsOfFinOrder.finite_zpowers (isOfFinOrder_iff_pow_eq_one.mpr ⟨2*m, by positivity, hpow2m⟩)
  haveI : IsMulCommutative ↥(Subgroup.zpowers g) := by
    rw [Subgroup.zpowers_eq_closure g]
    refine Subgroup.isMulCommutative_closure (fun a ha b hb _ => ?_)
    rw [Set.mem_singleton_iff] at ha hb
    rw [ha, hb]
  -- `x = t` and `y = u` as elements of `⟨g⟩`
  let x : ↥(Subgroup.zpowers g) :=
    ⟨t, hgt ▸ Subgroup.pow_mem (Subgroup.zpowers g) (Subgroup.mem_zpowers g) m⟩
  let y : ↥(Subgroup.zpowers g) :=
    ⟨u, hgu ▸ Subgroup.pow_mem (Subgroup.zpowers g) (Subgroup.mem_zpowers g) (m+1)⟩
  have hx2' : x ^ 2 = 1 := by
    apply Subtype.ext
    rw [Subgroup.coe_pow, Subgroup.coe_one]
    change t ^ 2 = (1 : G)
    exact ht2
  have hres : ClassFunction.restrict (Subgroup.zpowers g) φ ∈ ZIrr ↥(Subgroup.zpowers g) :=
    restrict_mem_ZIrr_finite _ hφ
  -- Peterfalvi (1.10.a) with `p = 2`, `ε = -1`: `φ(t·u) - φ(u) = 2·z`, `z` an algebraic integer.
  obtain ⟨z, hz, hzeq⟩ := exists_integral_zirr_apply_sub (p := 2) (by norm_num) (ε := -1)
    (IsPrimitiveRoot.neg_one 0 (by norm_num)) hres hx2'
  refine ⟨z, hz, ?_⟩
  rw [ClassFunction.restrict_apply, ClassFunction.restrict_apply] at hzeq
  have h1 : ((x * y : ↥(Subgroup.zpowers g)) : G) = t * u := by
    rw [Subgroup.coe_mul]
  have h2 : ((y : ↥(Subgroup.zpowers g)) : G) = u := rfl
  rw [h1, h2, show (1 : ℂ) - (-1) = 2 from by norm_num] at hzeq
  exact hzeq

end Work.BG
