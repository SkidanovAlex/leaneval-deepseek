import Mathlib
import Submission.Work.BG.Thm43Defs
import Submission.Work.BG.invJCard
import Submission.Work.BG.kappaExists
import Submission.Work.BG.S_le_H
import Submission.Work.BG.l42NgridFusion
import Submission.Work.BG.l42NgridParity
import Submission.Work.BG.l42NgridAux

/-!
# Area BG: Bender--Glauberman 1981, Lemma 4.2, the case `n = 2`

When the dihedral Sylow `2`-subgroup `S` of a `BGData` has order `4` (so is a Klein four-group),
the normalizer `N_G(S)` modulo the centralizer `C_G(S)` is cyclic of order `3`, generated by an
element `n` with `n t n⁻¹ = t₁` and `n² t n⁻² = t₂`; every element of `N_G(S)` lies in
`C_G(S)`, `C_G(S) n` or `C_G(S) n²`.

The ingredients (files of the same area) are:
* `Work.BG.l42NgridAuxStruct` -- the structure of `S = {1, t, t₁, t₂}`, `t₂ = t t₁`;
* `Work.BG.l42NgridFusion`    -- Burnside fusion: conjugacy in `G` of elements of `S` is realised
  in `N_G(S)`;
* `Work.BG.l42NgridParity`    -- `N_G(S)/C_G(S)` has odd order for an abelian Sylow `2`-subgroup;
* `Work.BG.l42NgridAuxFixSq`  -- an element of `N_G(S)` fixing a non-identity element of `S`
  squares into `C_G(S)`.
-/

open OddOrder.RepresentationTheory Work.GW2 Work.BG Work.GW2.C16 Subgroup

namespace Work.BG

set_option maxHeartbeats 1600000 in
theorem l42Ngrid {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G) (hn : D.n = 2) :
    ∃ n ∈ Subgroup.normalizer ((D.S : Subgroup G) : Set G),
      n ∉ Subgroup.centralizer ((D.S : Subgroup G) : Set G) ∧
      n * D.t * n⁻¹ = D.t1 ∧ n ^ 2 * D.t * (n ^ 2)⁻¹ = D.t2 ∧
      (∀ y ∈ Subgroup.normalizer ((D.S : Subgroup G) : Set G),
        y ∈ Subgroup.centralizer ((D.S : Subgroup G) : Set G) ∨
        (∃ c ∈ Subgroup.centralizer ((D.S : Subgroup G) : Set G), y = c * n) ∨
        (∃ c ∈ Subgroup.centralizer ((D.S : Subgroup G) : Set G), y = c * n ^ 2)) := by
  classical
  obtain ⟨_hcard, hmem, hsq, hcomm, ht_t1, ht_t2, ht1_t2, ht1ne_t2⟩ := l42NgridAuxStruct D hn
  set S : Subgroup G := (D.S : Subgroup G) with hSdef
  set N : Subgroup G := Subgroup.normalizer ((D.S : Subgroup G) : Set G) with hNdef
  set C : Subgroup G := Subgroup.centralizer ((D.S : Subgroup G) : Set G) with hCdef
  -- membership of the named elements
  have htS : D.t ∈ S := by rw [hSdef]; exact D.S0_le D.t_mem
  have ht1S : D.t1 ∈ S := by rw [hSdef]; exact D.t1_mem
  have ht2S : D.t2 ∈ S := by rw [hSdef]; exact D.t2_mem
  -- the disjunction describing `S`
  have hSmem : ∀ x : G, x ∈ S ↔ x = 1 ∨ x = D.t ∨ x = D.t1 ∨ x = D.t2 := by
    intro x
    constructor
    · intro hx
      have hx' : x ∈ (D.S : Subgroup G) := hSdef ▸ hx
      rcases hmem ⟨x, hx'⟩ with h | h | h | h
      · exact Or.inl (by simpa using Subtype.ext_iff.mp h)
      · exact Or.inr (Or.inl (by simpa using h))
      · exact Or.inr (Or.inr (Or.inl (by simpa using h)))
      · exact Or.inr (Or.inr (Or.inr (by simpa using h)))
    · rintro (h | h | h | h)
      · rw [h]; exact S.one_mem
      · rw [h]; exact htS
      · rw [h]; exact ht1S
      · rw [h]; exact ht2S
  -- squares in `S` and the order-2 criterion
  have hsqmem : ∀ x ∈ S, x * x = 1 := by
    intro x hx
    have hx' : x ∈ (D.S : Subgroup G) := hSdef ▸ hx
    have h := congrArg Subtype.val (hsq ⟨x, hx'⟩)
    simpa [pow_two] using h
  have hord2 : ∀ {x : G}, x ≠ 1 → x * x = 1 → orderOf x = 2 := by
    intro x hx1 hx
    have hdvd : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (by rw [pow_two]; exact hx)
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hx1
    · exact h
  -- the named elements are non-trivial and distinct
  have htne1 : D.t ≠ 1 := by
    intro h
    have h2 := D.t_order
    rw [h, orderOf_one] at h2
    exact absurd h2 (by norm_num)
  have ht1ne1 : D.t1 ≠ 1 := by
    intro h
    have h2 := D.t1_order
    rw [h, orderOf_one] at h2
    exact absurd h2 (by norm_num)
  have ht2ne1 : D.t2 ≠ 1 := by
    intro h
    have h2 := D.t2_order
    rw [h, orderOf_one] at h2
    exact absurd h2 (by norm_num)
  have htne_t1 : D.t ≠ D.t1 := by
    intro h
    exact D.t1_nmem (h ▸ D.t_mem)
  -- conjugation by a normalizer element preserves `S`
  have hconj_mem : ∀ z ∈ N, ∀ s ∈ S, z * s * z⁻¹ ∈ S := by
    intro z hz s hs
    have hz' : z ∈ Subgroup.normalizer ((D.S : Subgroup G) : Set G) := hNdef ▸ hz
    rw [Subgroup.mem_normalizer_iff] at hz'
    have hs' : s ∈ (D.S : Subgroup G) := hSdef ▸ hs
    have hres : z * s * z⁻¹ ∈ (D.S : Subgroup G) := (hz' s).mp hs'
    exact hSdef.symm ▸ hres
  -- membership in `C` is "fixes every non-identity element of `S`"
  have hCiff : ∀ z ∈ N, (z ∈ C ↔ ∀ x ∈ S, x ≠ 1 → z * x * z⁻¹ = x) := by
    intro z _hz
    constructor
    · intro hzC x hx _hx1
      have h1 : x * z = z * x :=
        (Subgroup.mem_centralizer_iff.mp (hCdef ▸ hzC)) x (hSdef ▸ hx)
      rw [← h1, mul_assoc, mul_inv_cancel, mul_one]
    · intro hfix
      rw [hCdef, Subgroup.mem_centralizer_iff]
      intro s hs
      by_cases hs1 : s = 1
      · rw [hs1, one_mul, mul_one]
      · have h1 : z * s * z⁻¹ = s := hfix s (hSdef.symm ▸ hs) hs1
        have h2 : z * s = s * z := by
          calc z * s = (z * s * z⁻¹) * z := by group
            _ = s * z := by rw [h1]
        exact h2.symm
  -- the parity lemma and the "fixing a non-identity element" lemma
  have hcommS : ∀ x ∈ (D.S : Subgroup G), ∀ y ∈ (D.S : Subgroup G), x * y = y * x :=
    fun x hx y hy => hcomm x (hSdef.symm ▸ hx) y (hSdef.symm ▸ hy)
  have hpar : ∀ z ∈ N, z ^ 2 ∈ C → z ∈ C := by
    intro z hz hz2
    have hz' : z ∈ Subgroup.normalizer ((D.S : Subgroup G) : Set G) := hNdef ▸ hz
    have hz2' : z ^ 2 ∈ Subgroup.centralizer ((D.S : Subgroup G) : Set G) := hCdef ▸ hz2
    rw [hCdef]
    exact l42NgridParity D.S hcommS hz' hz2'
  have hfixSq : ∀ z ∈ N, ∀ x ∈ S, x ≠ 1 → z * x * z⁻¹ = x → z ^ 2 ∈ C := by
    intro z hz x hx hx1 hzx
    have hz' : z ∈ Subgroup.normalizer ((D.S : Subgroup G) : Set G) := hNdef ▸ hz
    have hx' : x ∈ (D.S : Subgroup G) := hSdef ▸ hx
    have h := l42NgridAuxFixSq D hn hz' hx' hx1 hzx
    rw [hCdef]
    exact h
  have hnofix : ∀ z ∈ N, z ∉ C → ∀ x ∈ S, x ≠ 1 → z * x * z⁻¹ ≠ x := by
    intro z hz hzC x hx hx1 hfix
    exact hzC (hpar z hz (hfixSq z hz x hx hx1 hfix))
  -- transitivity of `N` on the non-identity elements of `S`
  have htrans : ∀ u ∈ S, ∀ v ∈ S, u ≠ 1 → v ≠ 1 → ∃ h ∈ N, h * u * h⁻¹ = v := by
    intro u hu v hv hu1 hv1
    have hu2 : orderOf u = 2 := hord2 hu1 (hsqmem u hu)
    have hv2 : orderOf v = 2 := hord2 hv1 (hsqmem v hv)
    have hconj : IsConj u v := D.oneClass u v hu2 hv2
    obtain ⟨h, hhN, hh⟩ :=
      l42NgridFusion D.S hcommS (hSdef.symm ▸ hu) (hSdef.symm ▸ hv) hconj
    exact ⟨h, hNdef.symm ▸ hhN, hh⟩
  obtain ⟨n, hnN, hnt⟩ := htrans D.t htS D.t1 ht1S htne1 ht1ne1
  have hnC : n ∉ C := by
    intro hnCin
    have h1 : n * D.t * n⁻¹ = D.t := by
      have h3 : D.t * n = n * D.t :=
        (Subgroup.mem_centralizer_iff.mp (hCdef ▸ hnCin)) D.t (hSdef ▸ htS)
      calc n * D.t * n⁻¹ = D.t * n * n⁻¹ := by rw [← h3]
        _ = D.t := by group
    rw [hnt] at h1
    exact htne_t1 h1.symm
  -- the shape of a normalizer element outside the centralizer
  have hdicho : ∀ z ∈ N, z ∉ C →
      ((z * D.t * z⁻¹ = D.t1 ∧ z * D.t1 * z⁻¹ = D.t2 ∧ z * D.t2 * z⁻¹ = D.t) ∨
        (z * D.t * z⁻¹ = D.t2 ∧ z * D.t1 * z⁻¹ = D.t ∧ z * D.t2 * z⁻¹ = D.t1)) := by
    intro z hz hzC
    have hfix := hnofix z hz hzC
    have hmem0 : z * D.t * z⁻¹ ∈ S := hconj_mem z hz D.t htS
    have hne01 : z * D.t * z⁻¹ ≠ 1 := by
      intro h
      have h2 : D.t = 1 := by
        have h3 : z⁻¹ * (z * D.t * z⁻¹) * z = D.t := by group
        rw [h] at h3
        simpa using h3.symm
      exact htne1 h2
    have hne0 : z * D.t * z⁻¹ ≠ D.t := hfix D.t htS htne1
    rcases (hSmem (z * D.t * z⁻¹)).mp hmem0 with h | h | h | h
    · exact absurd h hne01
    · exact absurd h hne0
    · -- `z t z⁻¹ = t1`
      have hmem1 : z * D.t1 * z⁻¹ ∈ S := hconj_mem z hz D.t1 ht1S
      have hne11 : z * D.t1 * z⁻¹ ≠ 1 := by
        intro hh
        have h2 : D.t1 = 1 := by
          have h3 : z⁻¹ * (z * D.t1 * z⁻¹) * z = D.t1 := by group
          rw [hh] at h3
          simpa using h3.symm
        exact ht1ne1 h2
      have hne1t1 : z * D.t1 * z⁻¹ ≠ D.t1 := hfix D.t1 ht1S ht1ne1
      have hne1t : z * D.t1 * z⁻¹ ≠ D.t := by
        intro hh
        have h2 : z * D.t2 * z⁻¹ = D.t2 := by
          have h4 : z * D.t2 * z⁻¹ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by
            calc z * D.t2 * z⁻¹ = z * (D.t * D.t1) * z⁻¹ := by rw [ht_t1]
              _ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by group
          rw [h4, h, hh]
          rw [← hcomm D.t htS D.t1 ht1S]
          exact ht_t1
        exact hfix D.t2 ht2S ht2ne1 h2
      have h1 : z * D.t1 * z⁻¹ = D.t2 := by
        rcases (hSmem (z * D.t1 * z⁻¹)).mp hmem1 with k | k | k | k
        · exact absurd k hne11
        · exact absurd k hne1t
        · exact absurd k hne1t1
        · exact k
      have h2 : z * D.t2 * z⁻¹ = D.t := by
        calc z * D.t2 * z⁻¹ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by
              calc z * D.t2 * z⁻¹ = z * (D.t * D.t1) * z⁻¹ := by rw [ht_t1]
                _ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by group
          _ = D.t1 * D.t2 := by rw [h, h1]
          _ = D.t := ht1_t2
      exact Or.inl ⟨h, h1, h2⟩
    · -- `z t z⁻¹ = t2`
      have hmem1 : z * D.t1 * z⁻¹ ∈ S := hconj_mem z hz D.t1 ht1S
      have hne11 : z * D.t1 * z⁻¹ ≠ 1 := by
        intro hh
        have h2 : D.t1 = 1 := by
          have h3 : z⁻¹ * (z * D.t1 * z⁻¹) * z = D.t1 := by group
          rw [hh] at h3
          simpa using h3.symm
        exact ht1ne1 h2
      have hne1t1 : z * D.t1 * z⁻¹ ≠ D.t1 := hfix D.t1 ht1S ht1ne1
      have hne1t2 : z * D.t1 * z⁻¹ ≠ D.t2 := by
        intro hh
        have h2 : z * D.t2 * z⁻¹ = 1 := by
          have h4 : z * D.t2 * z⁻¹ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by
            calc z * D.t2 * z⁻¹ = z * (D.t * D.t1) * z⁻¹ := by rw [ht_t1]
              _ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by group
          rw [h4, h, hh]
          exact hsqmem D.t2 ht2S
        have h3 : D.t2 = 1 := by
          have h5 : z⁻¹ * (z * D.t2 * z⁻¹) * z = D.t2 := by group
          rw [h2] at h5
          simpa using h5.symm
        exact ht2ne1 h3
      have h1 : z * D.t1 * z⁻¹ = D.t := by
        rcases (hSmem (z * D.t1 * z⁻¹)).mp hmem1 with k | k | k | k
        · exact absurd k hne11
        · exact k
        · exact absurd k hne1t1
        · exact absurd k hne1t2
      have h2 : z * D.t2 * z⁻¹ = D.t1 := by
        calc z * D.t2 * z⁻¹ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by
              calc z * D.t2 * z⁻¹ = z * (D.t * D.t1) * z⁻¹ := by rw [ht_t1]
                _ = (z * D.t * z⁻¹) * (z * D.t1 * z⁻¹) := by group
          _ = D.t2 * D.t := by rw [h, h1]
          _ = D.t * D.t2 := (hcomm D.t htS D.t2 ht2S).symm
          _ = D.t1 := ht_t2
      exact Or.inr ⟨h, h1, h2⟩
  -- inverse conjugation facts for `n`
  have hnt1 : n * D.t1 * n⁻¹ = D.t2 := by
    rcases hdicho n hnN hnC with hk | hk
    · exact hk.2.1
    · exact absurd (hk.1.symm.trans hnt) (Ne.symm ht1ne_t2)
  have hnt2 : n * D.t2 * n⁻¹ = D.t := by
    rcases hdicho n hnN hnC with hk | hk
    · exact hk.2.2
    · exact absurd (hk.1.symm.trans hnt) (Ne.symm ht1ne_t2)
  have hninv_t : n⁻¹ * D.t * n = D.t2 := by
    calc n⁻¹ * D.t * n = n⁻¹ * (n * D.t2 * n⁻¹) * n := by rw [hnt2]
      _ = D.t2 := by group
  have hninv_t1 : n⁻¹ * D.t1 * n = D.t := by
    calc n⁻¹ * D.t1 * n = n⁻¹ * (n * D.t * n⁻¹) * n := by rw [hnt]
      _ = D.t := by group
  have hninv_t2 : n⁻¹ * D.t2 * n = D.t1 := by
    calc n⁻¹ * D.t2 * n = n⁻¹ * (n * D.t1 * n⁻¹) * n := by rw [hnt1]
      _ = D.t1 := by group
  have hn2inv : (n ^ 2)⁻¹ = n⁻¹ * n⁻¹ := by rw [pow_two, mul_inv_rev]
  have hn2N : n ^ 2 ∈ N := by rw [pow_two]; exact N.mul_mem hnN hnN
  have hn2inv_t : (n ^ 2)⁻¹ * D.t * n ^ 2 = D.t1 := by
    rw [show (n ^ 2)⁻¹ = n⁻¹ * n⁻¹ from by rw [pow_two, mul_inv_rev], pow_two]
    calc (n⁻¹ * n⁻¹) * D.t * (n * n) = n⁻¹ * (n⁻¹ * D.t * n) * n := by group
      _ = n⁻¹ * D.t2 * n := by rw [hninv_t]
      _ = D.t1 := hninv_t2
  have hn2inv_t1 : (n ^ 2)⁻¹ * D.t1 * n ^ 2 = D.t2 := by
    rw [show (n ^ 2)⁻¹ = n⁻¹ * n⁻¹ from by rw [pow_two, mul_inv_rev], pow_two]
    calc (n⁻¹ * n⁻¹) * D.t1 * (n * n) = n⁻¹ * (n⁻¹ * D.t1 * n) * n := by group
      _ = n⁻¹ * D.t * n := by rw [hninv_t1]
      _ = D.t2 := hninv_t
  have hn2inv_t2 : (n ^ 2)⁻¹ * D.t2 * n ^ 2 = D.t := by
    rw [show (n ^ 2)⁻¹ = n⁻¹ * n⁻¹ from by rw [pow_two, mul_inv_rev], pow_two]
    calc (n⁻¹ * n⁻¹) * D.t2 * (n * n) = n⁻¹ * (n⁻¹ * D.t2 * n) * n := by group
      _ = n⁻¹ * D.t1 * n := by rw [hninv_t2]
      _ = D.t := hninv_t1
  refine ⟨n, hnN, hnC, hnt, ?_, ?_⟩
  · rw [show (n ^ 2)⁻¹ = n⁻¹ * n⁻¹ from by rw [pow_two, mul_inv_rev], pow_two]
    calc n * n * D.t * (n⁻¹ * n⁻¹) = n * (n * D.t * n⁻¹) * n⁻¹ := by group
      _ = n * D.t1 * n⁻¹ := by rw [hnt]
      _ = D.t2 := hnt1
  · intro y hyN
    by_cases hyC : y ∈ C
    · exact Or.inl hyC
    · rcases hdicho y hyN hyC with ⟨ha, hb, hc⟩ | ⟨ha, hb, hc⟩
      · refine Or.inr (Or.inl ⟨y * n⁻¹, ?_, by group⟩)
        rw [hCiff (y * n⁻¹) (N.mul_mem hyN (N.inv_mem hnN))]
        intro x hx hx1
        rcases (hSmem x).mp hx with h | h | h | h
        · exact absurd h hx1
        · rw [h]
          calc (y * n⁻¹) * D.t * (y * n⁻¹)⁻¹ = y * (n⁻¹ * D.t * n) * y⁻¹ := by group
            _ = y * D.t2 * y⁻¹ := by rw [hninv_t]
            _ = D.t := hc
        · rw [h]
          calc (y * n⁻¹) * D.t1 * (y * n⁻¹)⁻¹ = y * (n⁻¹ * D.t1 * n) * y⁻¹ := by group
            _ = y * D.t * y⁻¹ := by rw [hninv_t1]
            _ = D.t1 := ha
        · rw [h]
          calc (y * n⁻¹) * D.t2 * (y * n⁻¹)⁻¹ = y * (n⁻¹ * D.t2 * n) * y⁻¹ := by group
            _ = y * D.t1 * y⁻¹ := by rw [hninv_t2]
            _ = D.t2 := hb
      · refine Or.inr (Or.inr ⟨y * (n ^ 2)⁻¹, ?_, by group⟩)
        rw [hCiff (y * (n ^ 2)⁻¹) (N.mul_mem hyN (N.inv_mem hn2N))]
        intro x hx hx1
        rcases (hSmem x).mp hx with h | h | h | h
        · exact absurd h hx1
        · rw [h]
          calc (y * (n ^ 2)⁻¹) * D.t * (y * (n ^ 2)⁻¹)⁻¹
              = y * ((n ^ 2)⁻¹ * D.t * n ^ 2) * y⁻¹ := by group
            _ = y * D.t1 * y⁻¹ := by rw [hn2inv_t]
            _ = D.t := hb
        · rw [h]
          calc (y * (n ^ 2)⁻¹) * D.t1 * (y * (n ^ 2)⁻¹)⁻¹
              = y * ((n ^ 2)⁻¹ * D.t1 * n ^ 2) * y⁻¹ := by group
            _ = y * D.t2 * y⁻¹ := by rw [hn2inv_t1]
            _ = D.t1 := hc
        · rw [h]
          calc (y * (n ^ 2)⁻¹) * D.t2 * (y * (n ^ 2)⁻¹)⁻¹
              = y * ((n ^ 2)⁻¹ * D.t2 * n ^ 2) * y⁻¹ := by group
            _ = y * D.t * y⁻¹ := by rw [hn2inv_t2]
            _ = D.t2 := ha

end Work.BG
