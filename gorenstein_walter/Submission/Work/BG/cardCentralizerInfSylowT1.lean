import Mathlib
import Submission.Work.BG.ThmABCDefs
import Submission.Work.BG.fourGroup_centralizer_in_sylow
import Submission.Work.BG.isFourGroup_closure_pair
import Submission.Work.BG.S_le_H

/-!
# `|C_G(t₁) ∩ S| = 4` for the Bender–Glauberman data

`Work.BG.cardCentralizerInfSylowT1`: for `D : BGData G` the centralizer in `G` of the involution
`t₁` meets the dihedral Sylow `2`-subgroup `S` in a Klein four-group, hence in a subgroup of
order `4`.

Mathematically, the involution `t` is central in `S` (`Work.BG.S_le_H`, i.e. `S ≤ H = C_G(t)`),
so `t` and `t₁` are distinct commuting involutions which generate a Klein four-group
`W = ⟨t, t₁⟩ ≤ S` (`Work.BG.isFourGroup_closure_pair`).  A four-subgroup of a dihedral Sylow is
self-centralizing (`Work.BG.fourGroup_centralizer_in_sylow`), so `C_G(W) ∩ S = W`.  Since every
element of `S` centralizes `t`, an element of `S` centralizing `t₁` centralizes both generators of
`W`, whence `C_G(t₁) ∩ S = C_G(W) ∩ S = W`, of order `4`.
-/

namespace Work.BG

open Subgroup

theorem cardCentralizerInfSylowT1 {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G) :
    Nat.card ↥(Subgroup.centralizer ({D.t1} : Set G) ⊓ (D.S : Subgroup G)) = 4 := by
  -- `t` and `t₁` are involutions.
  have ht2 : D.t ^ 2 = 1 := by rw [← D.t_order]; exact pow_orderOf_eq_one D.t
  have ht12 : D.t1 ^ 2 = 1 := by rw [← D.t1_order]; exact pow_orderOf_eq_one D.t1
  -- `t₁ ∈ S ≤ H = C_G(t)`, so `t` and `t₁` commute.
  have ht1H : D.t1 ∈ Subgroup.centralizer ({D.t} : Set G) := S_le_H D D.t1_mem
  have hcomm : D.t1 * D.t = D.t * D.t1 := Subgroup.mem_centralizer_singleton_iff.mp ht1H
  -- `t ≠ 1`, `t₁ ≠ 1`, and `t ≠ t₁` (the latter since `t ∈ S₀` while `t₁ ∉ S₀`).
  have ht_ne_one : D.t ≠ 1 := by
    intro h
    have ho := D.t_order
    rw [h, orderOf_one] at ho
    exact absurd ho (by norm_num)
  have ht1_ne_one : D.t1 ≠ 1 := by
    intro h
    have ho := D.t1_order
    rw [h, orderOf_one] at ho
    exact absurd ho (by norm_num)
  have ht_ne_t1 : D.t ≠ D.t1 := fun h => D.t1_nmem (h ▸ D.t_mem)
  -- The Klein four-group `W = ⟨t, t₁⟩ ≤ S` generated by the two commuting involutions.
  have hW4 : Work.GW2.IsFourGroup (Subgroup.closure ({D.t, D.t1} : Set G)) :=
    isFourGroup_closure_pair ht2 ht12 hcomm.symm ht_ne_one ht1_ne_one ht_ne_t1
  have hWS : Subgroup.closure ({D.t, D.t1} : Set G) ≤ (D.S : Subgroup G) := by
    rw [Subgroup.closure_le]
    rintro y (rfl | rfl)
    · exact D.S0_le D.t_mem
    · exact D.t1_mem
  -- In a dihedral Sylow subgroup a four-subgroup is self-centralizing.
  obtain ⟨φ⟩ := D.dih
  have hcent : Subgroup.centralizer (Subgroup.closure ({D.t, D.t1} : Set G) : Set G)
        ⊓ (D.S : Subgroup G) = Subgroup.closure ({D.t, D.t1} : Set G) :=
    fourGroup_centralizer_in_sylow D.S φ hWS hW4
  -- `C_G(t₁) ∩ S = C_G(W) ∩ S`.
  have hkey : Subgroup.centralizer ({D.t1} : Set G) ⊓ (D.S : Subgroup G)
      = Subgroup.closure ({D.t, D.t1} : Set G) := by
    refine le_antisymm ?_ ?_
    · -- an element of `S` centralizing `t₁` centralizes `t` as well (as `S ≤ C_G(t)`), hence
      -- centralizes `W`, and `C_G(W) ∩ S = W`.
      intro x hx
      obtain ⟨hx1, hxS⟩ := Subgroup.mem_inf.mp hx
      have hxH : x ∈ Subgroup.centralizer ({D.t} : Set G) := S_le_H D hxS
      have hxW : x ∈ Subgroup.centralizer (Subgroup.closure ({D.t, D.t1} : Set G) : Set G) := by
        rw [Subgroup.centralizer_closure]
        refine Subgroup.mem_centralizer_iff.mpr fun h hh => ?_
        rcases hh with rfl | rfl
        · exact Subgroup.mem_centralizer_iff.mp hxH D.t (Set.mem_singleton D.t)
        · exact Subgroup.mem_centralizer_iff.mp hx1 D.t1 (Set.mem_singleton D.t1)
      have : x ∈ Subgroup.centralizer (Subgroup.closure ({D.t, D.t1} : Set G) : Set G)
            ⊓ (D.S : Subgroup G) := Subgroup.mem_inf.mpr ⟨hxW, hxS⟩
      rwa [hcent] at this
    · -- conversely `W ≤ C_G(t₁) ∩ S`, since both `t` and `t₁` centralize `t₁`.
      have hle : Subgroup.closure ({D.t, D.t1} : Set G) ≤
          Subgroup.centralizer ({D.t1} : Set G) := by
        rw [Subgroup.closure_le]
        rintro y (rfl | rfl)
        · exact Subgroup.mem_centralizer_singleton_iff.mpr hcomm.symm
        · exact Subgroup.mem_centralizer_singleton_iff.mpr rfl
      intro x hx
      exact Subgroup.mem_inf.mpr ⟨hle hx, hWS hx⟩
  rw [hkey]
  exact hW4.1

end Work.BG
