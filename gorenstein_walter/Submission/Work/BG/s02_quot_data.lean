import Mathlib
import Submission.Work.BG.S02

/-!
# Area BG: the quotient `H₀/U` is a commutative `2`-group

The standing data `C : Work.BG.Sec2Ctx G` records (among other things) that `H₀/U` is
generated by one element (`C.quot_cyclic`) and that every element of `H₀` has a `2`-power
lying in `U` (`C.quot_two`).  This module records the two immediate consequences used
throughout BG §2: `H₀/U` is commutative, and `|H₀/U|` is a power of `2`.

The proof of commutativity runs through cyclicity (`C.quot_cyclic`): the class of `c`
generates `H₀/U`, so every element is a `ℤ`-power of one fixed element, and `ℤ`-powers of a
common element commute.  The `2`-power statement is the `IsPGroup`-to-`Nat.card` conversion
`IsPGroup.iff_card` applied to the fact (`C.quot_two`) that every element of `H₀/U` is a
`2`-element.
-/

namespace Work.BG

open Subgroup

section Helpers

variable {G : Type} [Group G] [Finite G]

/-- `H₀/U` is cyclic: `C.quot_cyclic` exhibits a generator. -/
theorem quotGroup_data_isCyclic (C : Sec2Ctx G) : IsCyclic (quotGroup C.P) := by
  obtain ⟨c, hc, hgen⟩ := C.quot_cyclic
  refine isCyclic_iff_exists_zpowers_eq_top.mpr ⟨quotMk C.P ⟨c, hc⟩, ?_⟩
  rw [eq_top_iff]
  intro x _
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective _ x
  obtain ⟨k, hk⟩ := hgen (y : G) y.2
  refine Subgroup.mem_zpowers_iff.mpr ⟨k, ?_⟩
  rw [← map_zpow]
  refine (QuotientGroup.eq).mpr ?_
  rw [Subgroup.mem_subgroupOf]
  have hnorm : (C.P.U.subgroupOf C.P.H0).Normal := C.U_normal
  have hyinv : (y : G)⁻¹ ∈ C.P.H0 := C.P.H0.inv_mem y.2
  have hconj := hnorm.conj_mem
    (⟨(y : G) * (c ^ k)⁻¹, C.P.U_le_H0 hk⟩ : ↥C.P.H0)
    (by rw [Subgroup.mem_subgroupOf]; exact hk)
    (⟨(y : G)⁻¹, hyinv⟩ : ↥C.P.H0)
  rw [Subgroup.mem_subgroupOf] at hconj
  simpa [Subgroup.coe_mul, Subgroup.coe_inv, mul_assoc] using hconj

/-- `H₀/U` is commutative, since it is cyclic. -/
theorem quotGroup_data_comm (C : Sec2Ctx G) (a b : quotGroup C.P) : a * b = b * a := by
  haveI : IsCyclic (quotGroup C.P) := quotGroup_data_isCyclic C
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := quotGroup C.P)
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
  rw [← hi, ← hj, ← zpow_add, ← zpow_add, add_comm]

/-- `H₀/U` is a `2`-group: every element of `H₀` has a `2`-power in `U`. -/
theorem quotGroup_isPGroup_two (C : Sec2Ctx G) : IsPGroup 2 (quotGroup C.P) := by
  rw [isPGroup_iff_pow_pow_eq_one]
  intro q
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective _ q
  obtain ⟨n, hn⟩ := C.quot_two (y : G) y.2
  refine ⟨n, ?_⟩
  rw [← map_pow, QuotientGroup.mk'_apply]
  refine (QuotientGroup.eq_one_iff (N := C.P.U.subgroupOf C.P.H0) (y ^ 2 ^ n)).mpr ?_
  rw [Subgroup.mem_subgroupOf]
  simpa using hn

/-- The order of `H₀/U` is a power of `2`. -/
theorem quotGroup_card_two_pow (C : Sec2Ctx G) :
    ∃ n : ℕ, Nat.card (quotGroup C.P) = 2 ^ n := by
  haveI : Finite (quotGroup C.P) :=
    Finite.of_surjective (quotMk C.P) (QuotientGroup.mk'_surjective _)
  exact IsPGroup.iff_card.mp (quotGroup_isPGroup_two C)

end Helpers

theorem s02_quot_data {G : Type} [Group G] [Finite G] (C : Work.BG.Sec2Ctx G) :
    (∀ a b : Work.BG.quotGroup C.P, a * b = b * a) ∧
      ∃ n : ℕ, Nat.card (Work.BG.quotGroup C.P) = 2 ^ n :=
  ⟨fun a b => quotGroup_data_comm C a b, quotGroup_card_two_pow C⟩

end Work.BG
