import Mathlib
import Submission.Work.BG.rem31Orth
import Submission.OddOrder.GroupTheory.RepresentationTheory.CyclicCharacterExtension
import Submission.OddOrder.GroupTheory.RepresentationTheory.InducedInvariantConstituent

namespace Work.BG

open scoped commutatorElement

/-!
# Restriction of an invariant-constituent irreducible character along a cyclic quotient

Let `H ⊴ G` with `G/H` **cyclic** (here: generated by the image of a single `x`, i.e.
`closure (H ∪ {x}) = ⊤`), let `θ ∈ Irr H` be `G`-invariant, and let `χ ∈ Irr G` lie over
`θ`.  Then `Res_H χ = θ`.

This is the classical "multiplicity one" phenomenon for a cyclic quotient: since `G/H` is
cyclic, `θ` extends to `G` (Isaacs, *Character Theory*, Theorem 11.22,
`IsIrreducibleCharacter.exists_extension_of_conjBy_eq`), and then every irreducible of `G`
lying over `θ` is a twist `χ₀·Inf(β)` of such an extension by a **linear** character of the
abelian quotient `G/H` (Gallagher).  Such a twist is trivial on `H`, so it restricts to
`θ`; in particular `Res_H χ = θ`.

The formal route taken here avoids Gallagher's theorem in full and only needs the two
available inputs:

* `Ind_H^G θ` has all its irreducible constituents of the common degree of any constituent
  lying over `θ` (`induce_invariant_constituent_apply_one_eq`, the abelian-inertia-quotient
  case of Peterfalvi (1.7.b), for which `G/H` abelian suffices and no coprimality is
  assumed) — applied to the extension `χ₀` of `θ` this gives `χ(1) = χ₀(1) = θ(1)`;
* Clifford's theorem in the invariant case (`restrict_eq_restrictionMultiplicity_smul_of_invariant`),
  `Res_H χ = e·θ` with `e = ⟨Res_H χ, θ⟩_H`.

Comparing degrees at `1` then forces `e = 1`, whence `Res_H χ = θ`.
-/

/-! **Restriction of an invariant constituent.**  For `H ⊴ G` with `G/H` cyclic, an
irreducible `χ` of `G` lying over a `G`-invariant irreducible `θ` of `H` restricts exactly
to `θ`. -/
open OddOrder.RepresentationTheory in
theorem restrictEqOfInvariantConstituent {G : Type} [Group G] [Finite G] [Fintype G]
    {H : Subgroup G} [H.Normal] [Fintype ↥H] [Invertible (Nat.card G : ℂ)]
    [Invertible (Nat.card ↥H : ℂ)]
    (x : G) (hgen : Subgroup.closure ((H : Set G) ∪ {x}) = ⊤)
    (χ : IrreducibleCharacter G) (θ : IrreducibleCharacter ↥H)
    (hover : IrreducibleCharacter.LiesOver H χ θ)
    (hinv : ∀ g : G, IrreducibleCharacter.conjBy g θ = θ) :
    ClassFunction.restrict H (χ : ClassFunction G ℂ) = (θ : ClassFunction ↥H ℂ) := by
  classical
  -- ## Step 1: `G/H` is cyclic, hence abelian, and every element of `G` is `H`-times a power
  -- of `x` up to `H`.
  have htop : H ⊔ Subgroup.zpowers x = ⊤ := by
    rw [eq_top_iff, ← hgen]
    refine (Subgroup.closure_le _).mpr ?_
    rintro y (hy | hy)
    · exact Subgroup.mem_sup_left hy
    · rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact Subgroup.mem_sup_right (Subgroup.mem_zpowers x)
  have hgen' : ∀ k : G, ∃ i : ℤ, (x ^ i)⁻¹ * k ∈ H := by
    intro k
    have hk : k ∈ (↑(H ⊔ Subgroup.zpowers x) : Set G) := by
      rw [htop]; exact Subgroup.mem_top k
    rw [Subgroup.normal_mul H (Subgroup.zpowers x)] at hk
    obtain ⟨h, hh, u, hu, hhu⟩ := Set.mem_mul.mp hk
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
    refine ⟨i, ?_⟩
    have hconj : (x ^ i)⁻¹ * h * x ^ i ∈ H := by
      simpa using (inferInstance : H.Normal).conj_mem h hh (x ^ i)⁻¹
    have : (x ^ i)⁻¹ * k = (x ^ i)⁻¹ * h * x ^ i := by rw [← hhu]; group
    rw [this]
    exact hconj
  -- The image of every element of `G` in `G/H` is a power of the image of `x`.
  have himg : ∀ k : G, ∃ i : ℤ, QuotientGroup.mk' H k = (QuotientGroup.mk' H x) ^ i := by
    intro k
    obtain ⟨i, hi⟩ := hgen' k
    refine ⟨i, ?_⟩
    have h1 : QuotientGroup.mk' H ((x ^ i)⁻¹ * k) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr hi
    rw [map_mul, map_inv, map_zpow] at h1
    have h2 : (QuotientGroup.mk' H (x ^ i)) = QuotientGroup.mk' H k :=
      (inv_mul_eq_one (a := QuotientGroup.mk' H (x ^ i)) (b := QuotientGroup.mk' H k)).mp h1
    rw [← h2, map_zpow]
  have hab : ∀ a b : G, ⁅a, b⁆ ∈ H := by
    intro a b
    obtain ⟨i, hi⟩ := himg a
    obtain ⟨j, hj⟩ := himg b
    rw [← QuotientGroup.ker_mk' H, MonoidHom.mem_ker, map_commutatorElement]
    rw [hi, hj, commutatorElement_eq_one_iff_commute]
    exact Commute.zpow_zpow (Commute.refl _) i j
  -- ## Step 2: `θ` extends to `G` (Isaacs 11.22, cyclic quotient)
  have hinvx : ClassFunction.conjBy (G := G) (H := H) x (θ : ClassFunction ↥H ℂ) =
      (θ : ClassFunction ↥H ℂ) := by
    simpa using congrArg (fun η : IrreducibleCharacter ↥H => (η : ClassFunction ↥H ℂ)) (hinv x)
  obtain ⟨χ₀, hχ₀irr, hχ₀res⟩ :=
    IsIrreducibleCharacter.exists_extension_of_conjBy_eq θ.isIrreducible hgen' hinvx
  let χ₀i : IrreducibleCharacter G := ⟨χ₀, hχ₀irr⟩
  have hχ₀res' : ClassFunction.restrict H (χ₀i : ClassFunction G ℂ) =
      (θ : ClassFunction ↥H ℂ) := hχ₀res
  have hover₀ : IrreducibleCharacter.LiesOver H χ₀i θ := by
    rw [IrreducibleCharacter.liesOver_iff, ClassFunction.restrictionMultiplicity_def, hχ₀res,
      IsIrreducibleCharacter.inner_self_eq_one θ.isIrreducible]
    exact one_ne_zero
  -- ## Step 3: `χ` is a constituent of `Ind_H^G θ`, so it has the common degree `χ₀(1) = θ(1)`
  have hφ : ClassFunction.inner (ClassFunction.induce H (θ : ClassFunction ↥H ℂ))
      (χ : ClassFunction G ℂ) ≠ 0 :=
    (IrreducibleCharacter.inner_induce_ne_zero_iff_liesOver (H := H) χ θ).mpr hover
  have hdeg : (χ : ClassFunction G ℂ) 1 = (χ₀i : ClassFunction G ℂ) 1 :=
    induce_invariant_constituent_apply_one_eq hab θ χ₀i hover₀ hinv χ hφ
  -- ## Step 4: Clifford in the invariant case gives `Res_H χ = e · θ`; comparing degrees at `1`
  have hresχ := restrict_eq_restrictionMultiplicity_smul_of_invariant χ θ hover hinv
  have hχ1 : (χ : ClassFunction G ℂ) 1 =
      ClassFunction.restrictionMultiplicity H (χ : ClassFunction G ℂ)
        (θ : ClassFunction ↥H ℂ) * (θ : ClassFunction ↥H ℂ) 1 := by
    have hpt := congrArg (fun f : ClassFunction ↥H ℂ => f (1 : ↥H)) hresχ
    simpa [ClassFunction.restrict_apply, ClassFunction.smul_apply] using hpt
  have hχ₀1 : (χ₀i : ClassFunction G ℂ) 1 = (θ : ClassFunction ↥H ℂ) 1 := by
    have hpt := congrArg (fun f : ClassFunction ↥H ℂ => f (1 : ↥H)) hχ₀res'
    simpa [ClassFunction.restrict_apply] using hpt
  have hθ1 : (θ : ClassFunction ↥H ℂ) 1 ≠ 0 := by
    obtain ⟨n, hpos, hval, _⟩ := θ.isIrreducible.exists_natDegree_charValue_one_dvd_card
    rw [hval]
    exact Nat.cast_ne_zero.mpr hpos.ne'
  have he : ClassFunction.restrictionMultiplicity H (χ : ClassFunction G ℂ)
      (θ : ClassFunction ↥H ℂ) = 1 := by
    have hmain : ClassFunction.restrictionMultiplicity H (χ : ClassFunction G ℂ)
          (θ : ClassFunction ↥H ℂ) * (θ : ClassFunction ↥H ℂ) 1 =
        (θ : ClassFunction ↥H ℂ) 1 := by
      rw [← hχ1, hdeg, hχ₀1]
    have hfac : ClassFunction.restrictionMultiplicity H (χ : ClassFunction G ℂ)
          (θ : ClassFunction ↥H ℂ) * (θ : ClassFunction ↥H ℂ) 1 =
        1 * (θ : ClassFunction ↥H ℂ) 1 := by
      rw [one_mul]; exact hmain
    exact mul_right_cancel₀ hθ1 hfac
  rw [hresχ, he, one_smul]

end Work.BG
