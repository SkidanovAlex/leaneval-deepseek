import Mathlib
import Submission.Work.BG.Defs
import Submission.Work.GLUE.InBridge
import Submission.Work.BG.two_dvd_orderOf_of_isPGroup_quotient
import Submission.Work.BG.sq_eq_one_eq_of_isCyclic
import Submission.Work.BG.exists_quotSupEquivOfInfEqBot

/-!
# Area BG: `t ∈ ⟨x⟩` for every `x ∈ T = H₁ ∖ U`

Bender–Glauberman 1981, Hypothesis 1.2 in the situation of `Work.GW2.BGData` (Gorenstein–Walter
Hypothesis 1.1 for a dihedral Sylow 2-subgroup): `U = O(H)` with `H = C_G(t)`, `S₀` the cyclic
maximal subgroup of the Sylow 2-subgroup containing the central involution `t`, and
`H₁ = U S₀`.  This file proves

* `t_mem_zpowers_of_mem_T` : for `x ∈ T = H₁ ∖ U` one has `t ∈ ⟨x⟩`.

The mathematics: `U ◁ H₁`, `U ∩ S₀ = 1`, so `H₁/U ≅ S₀` is cyclic of 2-power order and `t` is the
unique involution of `H₁`; an `x ∈ H₁ ∖ U` therefore has even order, and the involution of `⟨x⟩`
must be `t`.  The three group-theoretic ingredients are shared library lemmas proved in this
directory:

* `Work.BG.two_dvd_orderOf_of_isPGroup_quotient` — elements outside a normal subgroup with
  2-group quotient have even order;
* `Work.BG.exists_quotSupEquivOfInfEqBot` — the second isomorphism theorem on `H/(H ⊓ N)`;
* `Work.BG.sq_eq_one_eq_of_isCyclic` — a finite cyclic group has a unique involution.
-/

open Subgroup

namespace Work.BG

theorem t_mem_zpowers_of_mem_T {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G) {x : G}
    (hx : x ∈ Work.BG.Tset (Work.BG.H1 D) (Work.GW2.BGData.U D)) :
    D.t ∈ Subgroup.zpowers x := by
  classical
  let U : Subgroup G := Work.GW2.BGData.U D
  let S0 : Subgroup G := D.S0
  have hxH1 : x ∈ U ⊔ S0 := hx.1
  have hxU : x ∉ U := hx.2
  have hxK : x ∈ S0 ⊔ U := by
    rw [sup_comm]
    exact hxH1
  -- ### `t` commutes with every element of `S₀` (`S₀` is cyclic, generated by `t₁ * t₂`)
  have hS0_cent : S0 ≤ Subgroup.centralizer ({D.t} : Set G) := by
    intro y hy
    rw [Subgroup.mem_centralizer_singleton_iff]
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (D.gen ▸ D.t_mem)
    have hy' : y ∈ D.S0 := hy
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (D.gen ▸ hy')
    rw [← hj, ← hk, ← zpow_add, ← zpow_add, add_comm j k]
  -- ### `U = O_{2'}(H)` is a `2'`-subgroup, hence has no element of order two
  have hUpi' : Subgroup.IsPiSubgroup ({q : ℕ | q ≠ 2}) U := by
    have h : Subgroup.IsPiSubgroup ({q : ℕ | q ≠ 2})
        (OddOrder.GroupTheory.opiCoreInG {q : ℕ | q ≠ 2} (Work.GW2.BGData.H D)) :=
      OddOrder.GroupTheory.isPiSubgroup_opiCoreInG _ _
    rw [← Work.GW2.oddCoreIn_eq_opiCoreInG (Work.GW2.BGData.H D)] at h
    exact h
  have hUpi : Subgroup.IsPiSubgroup ({2} : Set ℕ)ᶜ U :=
    Subgroup.IsPiSubgroup.mono (fun q hq => by simpa using hq) hUpi'
  have hU_no_two : ∀ u : G, u ∈ U → u ^ 2 = 1 → u = 1 := by
    intro u hu hu2
    rcases (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_iff_pow_eq_one.mpr hu2) with h | h
    · exact orderOf_eq_one_iff.mp h
    · exfalso
      have hdvdU : orderOf u ∣ Nat.card ↥U := Subgroup.orderOf_dvd_natCard U hu
      have h2mem : 2 ∈ (Nat.card ↥U).primeFactors :=
        Nat.mem_primeFactors.mpr ⟨Nat.prime_two, h ▸ hdvdU,
          (Nat.card_pos (α := ↥U)).ne'⟩
      have hcontra := hUpi 2 h2mem
      simp at hcontra
  have ht2 : D.t ^ 2 = 1 := by
    have hm : orderOf D.t ∣ 2 := by rw [D.t_order]
    exact orderOf_dvd_iff_pow_eq_one.mp hm
  have ht_ne_one : D.t ≠ 1 := by
    intro h
    have h1 : orderOf D.t = 2 := D.t_order
    rw [h, orderOf_one] at h1
    omega
  have ht_notU : D.t ∉ U := fun h => ht_ne_one (hU_no_two D.t h ht2)
  -- ### `S₀` is a 2-group, `S₀` normalises `U`, and `S₀ ∩ U = 1`
  have hS0p2 : IsPGroup 2 ↥S0 := D.S.isPGroup'.to_le D.S0_le
  have hS0pi : Subgroup.IsPiSubgroup ({2} : Set ℕ) S0 :=
    Subgroup.isPiSubgroup_of_isPGroup_of_mem hS0p2 (by simp)
  have hinf : S0 ⊓ U = ⊥ :=
    OddOrder.GroupTheory.inf_eq_bot_of_isPiSubgroup_of_isPiSubgroup_compl hS0pi hUpi
  have hHnorm : Work.GW2.BGData.H D ≤ Subgroup.normalizer (U : Set G) := by
    have h := OddOrder.GroupTheory.le_normalizer_opiCoreInG ({q : ℕ | q ≠ 2})
      (Work.GW2.BGData.H D)
    rw [← Work.GW2.oddCoreIn_eq_opiCoreInG (Work.GW2.BGData.H D)] at h
    exact h
  have hS0HN : S0 ≤ Subgroup.normalizer (U : Set G) := hS0_cent.trans hHnorm
  haveI hNnormal : (U.subgroupOf (S0 ⊔ U)).Normal :=
    Subgroup.normal_subgroupOf_sup_of_le_normalizer hS0HN
  -- ### the isomorphism `(S₀ ⊔ U)/U ≃* S₀`
  obtain ⟨ψ⟩ : Nonempty (↥(S0 ⊔ U) ⧸ U.subgroupOf (S0 ⊔ U) ≃* ↥S0) :=
    exists_quotSupEquivOfInfEqBot S0 U hS0HN hinf
  have hQ2 : IsPGroup 2 (↥(S0 ⊔ U) ⧸ U.subgroupOf (S0 ⊔ U)) :=
    IsPGroup.of_equiv hS0p2 ψ.symm
  haveI : IsCyclic ↥S0 := D.S0_cyclic
  -- ### `t` is the unique involution of `S₀ ⊔ U`
  have hunique : ∀ y : G, y ∈ S0 ⊔ U → orderOf y = 2 → y = D.t := by
    intro y hyK hy2
    have hyy : y ^ 2 = 1 := orderOf_dvd_iff_pow_eq_one.mp (by rw [hy2])
    have hy_notU : y ∉ U := by
      intro hyU
      have hy1 : y = 1 := hU_no_two y hyU hyy
      have hc := hy2
      rw [hy1, orderOf_one] at hc
      omega
    have hyK2 : (⟨y, hyK⟩ : ↥(S0 ⊔ U)) ^ 2 = 1 := by
      apply Subtype.ext
      simpa using hyy
    have htK : D.t ∈ S0 ⊔ U := (le_sup_left : S0 ≤ S0 ⊔ U) D.t_mem
    have htK2 : (⟨D.t, htK⟩ : ↥(S0 ⊔ U)) ^ 2 = 1 := by
      apply Subtype.ext
      simpa using ht2
    have hzy2 : (ψ (QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U))
        (⟨y, hyK⟩ : ↥(S0 ⊔ U)))) ^ 2 = 1 := by
      rw [← map_pow, ← map_pow, hyK2, map_one, map_one]
    have hzt2 : (ψ (QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U))
        (⟨D.t, htK⟩ : ↥(S0 ⊔ U)))) ^ 2 = 1 := by
      rw [← map_pow, ← map_pow, htK2, map_one, map_one]
    have hzy_ne : ψ (QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U))
        (⟨y, hyK⟩ : ↥(S0 ⊔ U))) ≠ 1 := by
      intro h
      have h1 : QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U))
          (⟨y, hyK⟩ : ↥(S0 ⊔ U)) = 1 := ψ.injective (by rw [h, map_one])
      have h2 : (⟨y, hyK⟩ : ↥(S0 ⊔ U)) ∈ U.subgroupOf (S0 ⊔ U) :=
        (QuotientGroup.eq_one_iff (⟨y, hyK⟩ : ↥(S0 ⊔ U))).mp h1
      exact hy_notU (Subgroup.mem_subgroupOf.mp h2)
    have hzt_ne : ψ (QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U))
        (⟨D.t, htK⟩ : ↥(S0 ⊔ U))) ≠ 1 := by
      intro h
      have h1 : QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U))
          (⟨D.t, htK⟩ : ↥(S0 ⊔ U)) = 1 := ψ.injective (by rw [h, map_one])
      have h2 : (⟨D.t, htK⟩ : ↥(S0 ⊔ U)) ∈ U.subgroupOf (S0 ⊔ U) :=
        (QuotientGroup.eq_one_iff (⟨D.t, htK⟩ : ↥(S0 ⊔ U))).mp h1
      exact ht_notU (Subgroup.mem_subgroupOf.mp h2)
    have hkey : ψ (QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U)) (⟨y, hyK⟩ : ↥(S0 ⊔ U)))
        = ψ (QuotientGroup.mk' (U.subgroupOf (S0 ⊔ U)) (⟨D.t, htK⟩ : ↥(S0 ⊔ U))) :=
      sq_eq_one_eq_of_isCyclic hzy_ne hzt_ne hzy2 hzt2
    have hcoset : (⟨D.t, htK⟩ : ↥(S0 ⊔ U))⁻¹ * ⟨y, hyK⟩ ∈ U.subgroupOf (S0 ⊔ U) :=
      QuotientGroup.eq.mp (ψ.injective hkey).symm
    -- `y = t * u` with `u = t⁻¹ * y ∈ U`, and `u` commutes with `t`
    let u : G := D.t⁻¹ * y
    have hu_mem : u ∈ U := by
      have h := Subgroup.mem_subgroupOf.mp hcoset
      simpa [u] using h
    have hty : D.t * u = y := by
      show D.t * (D.t⁻¹ * y) = y
      group
    have hcomm : u * D.t = D.t * u :=
      Subgroup.mem_centralizer_singleton_iff.mp
        (Work.GW2.oddCoreIn_le (Work.GW2.BGData.H D) hu_mem)
    have hu2 : u * u = 1 := by
      have hc : Commute D.t u := hcomm.symm
      have hkey2 : (D.t * u) ^ 2 = D.t ^ 2 * u ^ 2 := hc.mul_pow 2
      rw [← hty, hkey2, ht2, one_mul, pow_two] at hyy
      exact hyy
    have hu1 : u = 1 := hU_no_two u hu_mem (by rw [pow_two]; exact hu2)
    rw [← hty, hu1, mul_one]
  -- ### `x ∉ U` has even order, and the involution of `⟨x⟩` is `t`
  have h2dvd : 2 ∣ orderOf x :=
    two_dvd_orderOf_of_isPGroup_quotient (S0 ⊔ U) U le_sup_right hQ2 hxK hxU
  have hx0 : orderOf x ≠ 0 := by
    rw [← Nat.card_zpowers x]
    exact (Nat.card_pos (α := ↥(Subgroup.zpowers x))).ne'
  have hmemZ : x ^ (orderOf x / 2) ∈ Subgroup.zpowers x :=
    Subgroup.mem_zpowers_iff.mpr ⟨((orderOf x / 2 : ℕ) : ℤ), by rw [zpow_natCast]⟩
  have hord : orderOf (x ^ (orderOf x / 2)) = 2 := orderOf_pow_orderOf_div hx0 h2dvd
  have hmemK : x ^ (orderOf x / 2) ∈ S0 ⊔ U := (Subgroup.zpowers_le.mpr hxK) hmemZ
  have hfinal : x ^ (orderOf x / 2) = D.t := hunique _ hmemK hord
  rw [← hfinal]
  exact hmemZ

end Work.BG
