import Mathlib
import Submission.Work.GLUE.Defs
import Submission.Work.BG.indexOdd

/-!
# BG: the elements of `S ∖ S₀` are conjugate to `t₁` or `t₂`

`Work.BG.invS_conj_t1_or_t2`: for Bender–Glauberman data `D : Work.GW2.BGData G` and an
element `s ∈ S ∖ S₀` of the Sylow 2-subgroup `S` outside the cyclic subgroup `S₀` of index
two, `s` is conjugate **inside `S`** to `D.t1` or to `D.t2`.

The mathematics (all of it elementary, no character theory, no transfer):

* `S₀` has index two in `S`, so the product of two elements of `S` outside `S₀` lies in `S₀`
  (`aux_mul_mem_of_notMem_of_notMem`); hence `s = t₁ * c` with `c = t₁ s ∈ S₀`.
* `S₀ = ⟨t₁ t₂⟩` (`D.gen`) and `t₁² = t₂² = 1`, so `t₁` inverts the generator `t₁ t₂` and
  therefore every element of `S₀`; consequently, for `d ∈ S₀` and `c ∈ S₀` (which commute,
  being powers of one element),
  `d (t₁ c) d⁻¹ = t₁ d⁻² c`  (`aux_conj_t1_mul_mem_zpowers`).
* Every `c ∈ ⟨u⟩` is a square in `⟨u⟩` or `c u⁻¹` is
  (`aux_exists_sq_or_mul_inv_sq`, integer parity: `c = u^k`; split on the parity of `k`).
  In the first case `d = √c` conjugates `s` to `t₁`; in the second `d² = c (t₁t₂)⁻¹`
  conjugates `s` to `t₁ (t₁ t₂) = t₂`.

Nothing beyond the index-two/coset facts and the dihedral relation `S₀ = ⟨t₁ t₂⟩` is used:
in particular `S₀`'s cyclicity, the identification `S ≃* DihedralGroup n` and the oddness of
`|G : H|` play no role.
-/

namespace Work.BG

/-! ## Auxiliary group theory -/

/-- In a subgroup `K`, the product of two elements outside a subgroup `H` of index two in `K`
lies in `H`. -/
private theorem aux_mul_mem_of_notMem_of_notMem {G : Type*} [Group G]
    {H K : Subgroup G} {x y : G} (hidx : H.relIndex K = 2)
    (hx : x ∈ K) (hx0 : x ∉ H) (hy : y ∈ K) (hy0 : y ∉ H) : x * y ∈ H := by
  obtain ⟨a, _, _, ha⟩ :=
    (Subgroup.relIndex_eq_two_iff_exists_notMem_and (H := H) (K := K)).mp hidx
  have h1 : x * a ∈ H := (ha x hx).resolve_right hx0
  have h2 : y⁻¹ * a ∈ H :=
    (ha y⁻¹ (K.inv_mem hy)).resolve_right fun h => hy0 (H.inv_mem_iff.mp h)
  have h3 : (x * a) * (y⁻¹ * a)⁻¹ = x * y := by group
  rw [← h3]
  exact H.mul_mem h1 (H.inv_mem h2)

/-- Two elements of the cyclic subgroup generated by `u` commute. -/
private theorem aux_mul_comm_of_mem_zpowers {G : Type*} [Group G] {u x y : G}
    (hx : x ∈ Subgroup.zpowers u) (hy : y ∈ Subgroup.zpowers u) : x * y = y * x := by
  obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
  calc u ^ i * u ^ j = u ^ (i + j) := (zpow_add u i j).symm
    _ = u ^ (j + i) := by rw [add_comm]
    _ = u ^ j * u ^ i := zpow_add u j i

/-- Conjugating the involution `t₁` by an element `d` of `⟨t₁ t₂⟩` gives `t₁ d⁻²`, and
conjugation by `d` fixes every element of `⟨t₁ t₂⟩`: hence conjugating `t₁ c` by `d` gives
`t₁ (d⁻² c)` whenever `c ∈ ⟨t₁ t₂⟩`. -/
private theorem aux_conj_t1_mul_mem_zpowers {G : Type*} [Group G] {t1 t2 d c : G}
    (h1 : t1 ^ 2 = 1) (h2 : t2 ^ 2 = 1)
    (hd : d ∈ Subgroup.zpowers (t1 * t2)) (hc : c ∈ Subgroup.zpowers (t1 * t2)) :
    d * (t1 * c) * d⁻¹ = t1 * (d⁻¹ ^ 2 * c) := by
  have h11 : t1 * t1 = 1 := by rw [← pow_two]; exact h1
  have h22 : t2 * t2 = 1 := by rw [← pow_two]; exact h2
  -- `t₁` inverts the generator `t₁ t₂`
  have hgen : MulAut.conj t1 (t1 * t2) = (t1 * t2)⁻¹ := by
    rw [MulAut.conj_apply, mul_inv_rev, inv_eq_of_mul_eq_one_left h11,
      inv_eq_of_mul_eq_one_left h22]
    rw [show t1 * (t1 * t2) * t1 = (t1 * t1) * (t2 * t1) from by group, h11, one_mul]
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hd
  have h1a : t1 * (t1 * t2) ^ k * t1 = ((t1 * t2) ^ k)⁻¹ := by
    have h1' : t1 * (t1 * t2) ^ k * t1⁻¹ = ((t1 * t2) ^ k)⁻¹ := by
      rw [← MulAut.conj_apply t1 ((t1 * t2) ^ k), map_zpow, hgen, inv_zpow]
    rwa [inv_eq_of_mul_eq_one_left h11] at h1'
  have hkey : (t1 * t2) ^ k * t1 = t1 * ((t1 * t2) ^ k)⁻¹ := by
    calc (t1 * t2) ^ k * t1 = (t1 * t1) * (t1 * t2) ^ k * t1 := by rw [h11, one_mul]
      _ = t1 * (t1 * (t1 * t2) ^ k * t1) := by group
      _ = t1 * ((t1 * t2) ^ k)⁻¹ := by rw [h1a]
  have hconj : (t1 * t2) ^ k * t1 * ((t1 * t2) ^ k)⁻¹ = t1 * (((t1 * t2) ^ k)⁻¹) ^ 2 := by
    rw [hkey, pow_two]
    group
  have hcomm : (t1 * t2) ^ k * c = c * (t1 * t2) ^ k :=
    aux_mul_comm_of_mem_zpowers (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) k) hc
  have hcomm2 : (t1 * t2) ^ k * c * ((t1 * t2) ^ k)⁻¹ = c := by
    rw [hcomm]; group
  calc (t1 * t2) ^ k * (t1 * c) * ((t1 * t2) ^ k)⁻¹
      = ((t1 * t2) ^ k * t1 * ((t1 * t2) ^ k)⁻¹) *
          ((t1 * t2) ^ k * c * ((t1 * t2) ^ k)⁻¹) := by group
    _ = (t1 * (((t1 * t2) ^ k)⁻¹) ^ 2) * c := by rw [hconj, hcomm2]
    _ = t1 * ((((t1 * t2) ^ k)⁻¹) ^ 2 * c) := by rw [mul_assoc]

/-- Every element `x` of the cyclic subgroup `⟨u⟩` is a square in `⟨u⟩`, or `x u⁻¹` is. -/
private theorem aux_exists_sq_or_mul_inv_sq {G : Type*} [Group G] {u x : G}
    (hx : x ∈ Subgroup.zpowers u) :
    (∃ d ∈ Subgroup.zpowers u, d ^ 2 = x) ∨
      (∃ d ∈ Subgroup.zpowers u, d ^ 2 = x * u⁻¹) := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  rcases Int.even_or_odd k with ⟨m, hm⟩ | ⟨m, hm⟩
  · left
    refine ⟨u ^ m, Subgroup.zpow_mem _ (Subgroup.mem_zpowers u) m, ?_⟩
    calc (u ^ m) ^ 2 = u ^ m * u ^ m := pow_two _
      _ = u ^ (m + m) := (zpow_add u m m).symm
      _ = u ^ k := by rw [show m + m = k by linarith]
  · right
    refine ⟨u ^ m, Subgroup.zpow_mem _ (Subgroup.mem_zpowers u) m, ?_⟩
    calc (u ^ m) ^ 2 = u ^ m * u ^ m := pow_two _
      _ = u ^ (m + m) := (zpow_add u m m).symm
      _ = u ^ (k + -1) := by rw [show m + m = k + -1 by linarith]
      _ = u ^ k * u⁻¹ := by rw [zpow_add, zpow_neg_one]

/-! ## The target theorem -/

theorem invS_conj_t1_or_t2 {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G) {s : G}
    (hs : s ∈ (D.S : Subgroup G)) (hs0 : s ∉ D.S0) :
    (∃ g ∈ (D.S : Subgroup G), g * s * g⁻¹ = D.t1) ∨
      (∃ g ∈ (D.S : Subgroup G), g * s * g⁻¹ = D.t2) := by
  have h1 : D.t1 ^ 2 = 1 := ((orderOf_eq_prime_iff (p := 2)).mp D.t1_order).1
  have h2 : D.t2 ^ 2 = 1 := ((orderOf_eq_prime_iff (p := 2)).mp D.t2_order).1
  have h11 : D.t1 * D.t1 = 1 := by rw [← pow_two]; exact h1
  -- `s = t₁ * c` for `c = t₁ s ∈ S₀`, because `S₀` has index two in `S`
  have hts : D.t1 * s ∈ D.S0 :=
    aux_mul_mem_of_notMem_of_notMem (H := D.S0) (K := (D.S : Subgroup G))
      D.S0_index D.t1_mem D.t1_nmem hs hs0
  have hs_eq : s = D.t1 * (D.t1 * s) := by rw [← mul_assoc, h11, one_mul]
  have hc_zp : D.t1 * s ∈ Subgroup.zpowers (D.t1 * D.t2) := by rw [← D.gen]; exact hts
  have hdS : ∀ g ∈ Subgroup.zpowers (D.t1 * D.t2), g ∈ (D.S : Subgroup G) := by
    intro g hg
    exact D.S0_le (by rw [D.gen]; exact hg)
  rcases aux_exists_sq_or_mul_inv_sq (u := D.t1 * D.t2) (x := D.t1 * s) hc_zp with
    ⟨d, hd_zp, hd_sq⟩ | ⟨d, hd_zp, hd_sq⟩
  · -- `d² = t₁ s`: `d` conjugates `s` to `t₁`
    left
    refine ⟨d, hdS d hd_zp, ?_⟩
    have hconj := aux_conj_t1_mul_mem_zpowers (t1 := D.t1) (t2 := D.t2) (d := d)
      (c := D.t1 * s) h1 h2 hd_zp hc_zp
    rw [hs_eq, hconj]
    have hsq : d⁻¹ ^ 2 = (D.t1 * s)⁻¹ := by rw [inv_pow, hd_sq]
    rw [hsq, inv_mul_cancel, mul_one]
  · -- `d² = t₁ s (t₁t₂)⁻¹`: `d` conjugates `s` to `t₂ = t₁ (t₁ t₂)`
    right
    refine ⟨d, hdS d hd_zp, ?_⟩
    have hconj := aux_conj_t1_mul_mem_zpowers (t1 := D.t1) (t2 := D.t2) (d := d)
      (c := D.t1 * s) h1 h2 hd_zp hc_zp
    rw [hs_eq, hconj]
    have hsq : d⁻¹ ^ 2 = (D.t1 * D.t2) * (D.t1 * s)⁻¹ := by
      rw [inv_pow, hd_sq, mul_inv_rev, inv_inv]
    rw [hsq, mul_assoc, inv_mul_cancel, mul_one]
    rw [show D.t1 * (D.t1 * D.t2) = D.t2 from by rw [← mul_assoc, h11, one_mul]]

end Work.BG
