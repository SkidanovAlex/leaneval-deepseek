import Mathlib
import Submission.Work.BG.ThmABCCharDefs
import Submission.Work.BG.nCases
import Submission.Work.BG.hyp12OfBGData
import Submission.Work.BSW.Api.card_sup_of_le_normalizer_of_inf_eq_bot

/-!
# Area BG: `[H₀ : U] = n` — the index of `U` in `H₀` (Remark 3.1, bookkeeping)

Bender–Glauberman (J. Algebra 70 (1981)) use everywhere that `H₀/U ≅ S₀` is cyclic of
order `n = |S|/2`: the set `Λ` of linear characters of `H₀/U` has `n` elements, and the
orbit `Λν` of `ν ∈ Irr(H₀)` has size dividing `n` (Remark 3.1: `|Λ_ν| · |Λν| = n`).

This file supplies the arithmetic behind that count, in the form in which area BG's §2/§3
lemmas consume it: for a `Sec2Ctx` `C` compatible with the Bender–Glauberman data `D`
(`C.P.H0 = H₀ = U ⊔ S₀`, `C.P.U = U = O(H)`, `H = C_G(t)`),

  `(Uin C).index = (C.P.U.subgroupOf C.P.H0).index = [H₀ : U] = n = |S₀|`.

The mathematics is the trivial part of Hypothesis 1.1/1.2:

* `S₀ = ⟨t₁t₂⟩` is generated by one element and `t ∈ S₀`, so *every* element of `S₀`
  commutes with `t`; hence `S₀ ≤ H = C_G(t)` and `S₀` normalizes `U = O(H)`;
* `S₀` is a `2`-group (it lies in the Sylow `2`-subgroup `S`) while `U = O(H)` is a
  `2'`-group, so `U ⊓ S₀ = ⊥`; hence `H₀ = U ⊔ S₀` has order `|U| · |S₀|`;
* therefore `[H₀ : U] = |S₀| = n`, the last equality being `Work.BG.nCases`
  (`|S₀| = n` from `[S : S₀] = 2` and `S ≅ DihedralGroup n`, `|DihedralGroup n| = 2n`).
-/

namespace Work.BG

/-- Two elements of a cyclic group commute.  (Used for `t₁t₂` and `t`, both powers of the
generator of `S₀ = zpowers (t₁t₂)`.) -/
private lemma mul_comm_of_mem_zpowers {G : Type*} [Group G] {g x y : G}
    (hx : x ∈ Subgroup.zpowers g) (hy : y ∈ Subgroup.zpowers g) : x * y = y * x := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hx
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hy
  subst hm; subst hn
  rw [← zpow_add, ← zpow_add, add_comm]

/-- **Remark 3.1, index bookkeeping.**  For a §2 context `C` compatible with the
Bender–Glauberman data `D`, the subgroup `U` has index `n` in `H₀`:
`[H₀ : U] = |S₀| = n`.  This is the cardinality of `Λ = Irr(H₀/U)` and of the `Λ`-orbits
used in Remark 3.1 (`|Λ_ν| · |Λν| = n`). -/
theorem rem31IndexUin {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (C : Work.BG.Sec2Ctx G) (h : Work.GW2.C16.Compat D C) :
    (Work.GW2.C16.Uin C).index = D.n := by
  -- `S₀ = zpowers (t₁t₂)` is abelian and contains `t`, so `S₀ ≤ H = C_G(t)`.
  have ht_comm : ∀ x ∈ D.S0, D.t * x = x * D.t := by
    intro x hx
    have hx' : x ∈ Subgroup.zpowers (D.t1 * D.t2) := by rw [← D.gen]; exact hx
    have ht' : D.t ∈ Subgroup.zpowers (D.t1 * D.t2) := by rw [← D.gen]; exact D.t_mem
    exact mul_comm_of_mem_zpowers ht' hx'
  have hS0_le_H : D.S0 ≤ D.H := by
    intro x hx
    show x ∈ Subgroup.centralizer ({D.t} : Set G)
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact ht_comm x hx
  -- `U = O(H)` is normalized by `H`, hence by `S₀`.
  have hU_eq : D.U = Work.GW2.oddCoreIn D.H := rfl
  have hH_le_normU : D.H ≤ Subgroup.normalizer (D.U : Set G) := by
    rw [hU_eq, Work.GW2.oddCoreIn_eq_opiCoreInG]
    exact OddOrder.GroupTheory.le_normalizer_opiCoreInG _ _
  have hS0_le_normU : D.S0 ≤ Subgroup.normalizer (D.U : Set G) := hS0_le_H.trans hH_le_normU
  -- `U` is a `2'`-group and `S₀` is a `2`-group, so `U ⊓ S₀ = ⊥`.
  have hUpi : Subgroup.IsPiSubgroup ({q : ℕ | q ≠ 2}) D.U := by
    rw [hU_eq, Work.GW2.oddCoreIn_eq_opiCoreInG]
    exact OddOrder.GroupTheory.isPiSubgroup_opiCoreInG _ _
  have hS0pg : IsPGroup 2 ↥D.S0 := IsPGroup.to_le D.S.isPGroup' D.S0_le
  have hS0pi : Subgroup.IsPiSubgroup ({q : ℕ | q ≠ 2})ᶜ D.S0 := by
    have hπ : ({q : ℕ | q ≠ 2}ᶜ : Set ℕ) = {q : ℕ | q = 2} := by ext q; simp
    rw [hπ]
    exact Subgroup.isPiSubgroup_of_isPGroup_of_mem hS0pg (by simp)
  have hUinfS0 : D.U ⊓ D.S0 = ⊥ :=
    OddOrder.GroupTheory.inf_eq_bot_of_isPiSubgroup_of_isPiSubgroup_compl hUpi hS0pi
  -- hence `|U ⊔ S₀| = |U| · |S₀|` and `[U ⊔ S₀ : U] = |S₀|`.
  have hcard : Nat.card ↥(D.U ⊔ D.S0) = Nat.card ↥D.U * Nat.card ↥D.S0 :=
    Work.BSW.Api.card_sup_of_le_normalizer_of_inf_eq_bot hS0_le_normU hUinfS0
  have hrel : D.U.relIndex (D.U ⊔ D.S0) * Nat.card ↥D.U = Nat.card ↥(D.U ⊔ D.S0) := by
    have h1 := Subgroup.relIndex_mul_card (H := D.U) (K := D.U ⊔ D.S0)
    rwa [inf_eq_left.mpr le_sup_left] at h1
  have hS0card : Nat.card ↥D.S0 = D.n := (Work.BG.nCases G D).2
  have hkey : D.U.relIndex (D.U ⊔ D.S0) = D.n := by
    have h2 : D.U.relIndex (D.U ⊔ D.S0) * Nat.card ↥D.U = D.n * Nat.card ↥D.U := by
      rw [hrel, hcard, hS0card, mul_comm (Nat.card ↥D.U) D.n]
    exact Nat.mul_right_cancel Nat.card_pos h2
  -- `H₀ = U ⊔ S₀` and `Uin C = U` are the compatible data `D`.
  show (C.P.U.subgroupOf C.P.H0).index = D.n
  rw [h.U_eq, h.H0_eq]
  show (D.U.subgroupOf (D.U ⊔ D.S0)).index = D.n
  exact hkey

end Work.BG
