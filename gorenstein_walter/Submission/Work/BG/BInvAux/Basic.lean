import Mathlib
import Submission.Work.BG.Thm43Defs
import Submission.Work.BG.invJCard
import Submission.Work.BG.kappaExists
import Submission.Work.BG.S_le_H
import Submission.Work.BG.splitglue.Split

/-!
# Area BG: auxiliary group theory for `B = C_U(S)` when `|S| = 4`

This module collects the elementary group-theoretic facts about the Bender–Glauberman data
`D` with `D.n = 2` (so that the Sylow `2`-subgroup `S` is a Klein four group) that are used in
the analysis of `B = B₁ ⊓ B₂`, `Bᵢ = U ⊓ C_G(tᵢ)`

* `t_mem_S`, `centralizer_S_le_H`: `t ∈ S`, hence `C_G(S) ≤ C_G(t) = H`;
* `H_eq_U_sup_S`: `H = U ⊔ S` (`Work.GW2.CentralizerSplitProp`, proved in `splitglue`),
  with the set-product form `Work.BG.coe_U_sup_S`;
* `S_commutative`, `card_S`: `S` is abelian of order `4`;
* `mem_B_iff`: `B = U ⊓ C_G(S)` (using `S = ⟨t₁,t₂⟩`, `Work.BG.S_eq_closure`);
* `mem_B_of_mem_U_of_mem_centralizer`: an element of `U` centralising `S` lies in `B`;
* `B_le_centralizer_S'`: every element of `B` centralises `S`.

The main consumers are `Work.BG.l42BNinv` and its two auxiliary leaves
`Work.BG.BInvAux.odd_order_mem_B`, `Work.BG.BInvAux.decomp_centralizer`.

## Routes for the two leaves

`decomp_centralizer`: `C_G(S) ≤ C_G(t) = H = U ⊔ S`, so `c = u * s` with `u ∈ U`, `s ∈ S`;
`u = c * s⁻¹` centralises `S` because `c` does and `S` is abelian (`S_commutative`), so
`u ∈ U ⊓ C_G(S) = B` (`mem_B_of_mem_U_of_mem_centralizer`).

`odd_order_mem_B`: take the decomposition `c = u * s`.  Then `u ∈ C_G(S)` commutes with
`s ∈ S`; with `k = orderOf c` odd and `c ^ k = 1` this gives `u ^ k = (s ^ k)⁻¹`, and
`u ^ k ∈ U`, `s ^ k ∈ S`, `U ⊓ S = ⊥`, so `s ^ k = 1`.  But `orderOf s ∣ Nat.card S = 4`
(`card_S`) and `orderOf s ∣ k`, with `k` odd, so `orderOf s = 1`, `s = 1`, and
`c = u ∈ U ⊓ C_G(S) = B`.
-/

namespace Work.BG.BInvAux

open OddOrder.RepresentationTheory Work.GW2 Work.BG Subgroup

variable {G : Type} [Group G] [Finite G]

/-- `t ∈ S`. -/
theorem t_mem_S (D : BGData G) : D.t ∈ (D.S : Subgroup G) := D.S0_le D.t_mem

/-- `C_G(S) ≤ C_G(t) = H`, because `t ∈ S`. -/
theorem centralizer_S_le_H (D : BGData G) :
    Subgroup.centralizer ((D.S : Subgroup G) : Set G) ≤ D.H :=
  Subgroup.centralizer_le (Set.singleton_subset_iff.mpr (t_mem_S D))

/-- **`H = U ⊔ S`** (Bender–Glauberman 1981): the centralizer of the central involution `t` is
generated by its odd core `U` and the Sylow `2`-subgroup `S`. -/
theorem H_eq_U_sup_S (D : BGData G) : D.U ⊔ (D.S : Subgroup G) = D.H := by
  have hcent : ∀ x ∈ (D.S : Subgroup G), x * D.t = D.t * x := fun x hx =>
    (Subgroup.mem_centralizer_iff.mp (S_le_H D hx) D.t (Set.mem_singleton D.t)).symm
  exact SplitGlue.centralizerSplitProp (G := G) D.S D.n D.two_le D.dih D.t (t_mem_S D) D.t_order hcent

/-- `|S| = 2n = 4` when `n = 2`. -/
theorem card_S (D : BGData G) (hn : D.n = 2) : Nat.card ↥(D.S : Subgroup G) = 4 := by
  obtain ⟨e⟩ := D.dih
  rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card, hn]

/-- **`S` is abelian when `n = 2`**: `S ≃* DihedralGroup 2`, and `DihedralGroup 2` is abelian. -/
theorem S_commutative (D : BGData G) (hn : D.n = 2) :
    ∀ a ∈ (D.S : Subgroup G), ∀ b ∈ (D.S : Subgroup G), a * b = b * a := by
  obtain ⟨e⟩ := D.dih
  haveI : IsMulCommutative (DihedralGroup D.n) :=
    DihedralGroup.commutative_iff.mpr (Or.inr hn)
  intro a ha b hb
  have h : e (⟨a, ha⟩ * ⟨b, hb⟩) = e (⟨b, hb⟩ * ⟨a, ha⟩) := by
    rw [map_mul, map_mul, mul_comm']
  simpa using e.injective h

/-- **`B = U ⊓ C_G(S)`**: `B = B₁ ⊓ B₂` with `Bᵢ = U ⊓ C_G(tᵢ)` and `S = ⟨t₁,t₂⟩`. -/
theorem mem_B_iff (D : BGData G) {g : G} :
    g ∈ D.B ↔ g ∈ D.U ∧ g ∈ Subgroup.centralizer ((D.S : Subgroup G) : Set G) := by
  constructor
  · intro hg
    exact ⟨hg.1.1, B_le_centralizer_S D hg⟩
  · rintro ⟨hU, hC⟩
    refine ⟨⟨hU, ?_⟩, ⟨hU, ?_⟩⟩
    · exact Subgroup.mem_centralizer_singleton_iff.mpr
        (Subgroup.mem_centralizer_iff.mp hC D.t1 D.t1_mem).symm
    · exact Subgroup.mem_centralizer_singleton_iff.mpr
        (Subgroup.mem_centralizer_iff.mp hC D.t2 D.t2_mem).symm

/-- An element of `U` centralising `S` lies in `B`. -/
theorem mem_B_of_mem_U_of_mem_centralizer (D : BGData G) {u : G} (hu : u ∈ D.U)
    (hc : u ∈ Subgroup.centralizer ((D.S : Subgroup G) : Set G)) : u ∈ D.B :=
  (mem_B_iff D).mpr ⟨hu, hc⟩

/-- Every element of `B` centralises `S`. -/
theorem B_le_centralizer_S' (D : BGData G) :
    D.B ≤ Subgroup.centralizer ((D.S : Subgroup G) : Set G) := B_le_centralizer_S D

end Work.BG.BInvAux
