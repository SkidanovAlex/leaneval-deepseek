/-
Gorenstein–Walter / Bender–Glauberman, area BG: the §3 standing hypothesis in the case
`|S| = 2n = 8` (i.e. `n = 4`).

`D : BGData G` is Bender–Glauberman Hypothesis 1.1: `S` is a Sylow 2-subgroup, dihedral of
order `2n`, `S₀ ≤ S` is cyclic of index two with `t ∈ S₀` the (central) involution and
`t₁, t₂ ∈ S ∖ S₀` the two reflections.  `H = C_G(t)` and `U = O(H) = oddCoreIn D.H`.

The §3 hypothesis `Sec3Hyp D` is `⟨x² | x ∈ S₀⟩ ≤ C_G(U)`.

For `n = 4` this is elementary: `|S₀| = n = 4`, so `S₀` is cyclic of order `4` and `x²`
has order dividing `2` for every `x ∈ S₀`; the group of order `2` elements of the cyclic
group `S₀` is generated by its unique involution `t`.  Hence `x² ∈ ⟨t⟩ ⊆ C_G(u)` for every
`u ∈ U`, because `U ≤ H = C_G(t)`.
-/
import Mathlib
import Submission.Work.BG.S02
import Submission.Work.BG.nCases
import Submission.Work.BG.invJCard
import Submission.Work.GLUE.Defs

namespace Work.BG

set_option linter.style.haveILetI false

/-- In a **cyclic** group, if `t` has order `2` and `orderOf x ∣ 4` then `x ^ 2` lies in the
subgroup generated by `t`.  (There is a unique subgroup of order `2`, namely `⟨t⟩`; the
containment `⟨x²⟩ ≤ ⟨t⟩` of subgroups of a cyclic group is tested by divisibility of their
cardinalities: `orderOf (x²) ∣ 2` because `(x²)² = x⁴ = 1`.) -/
private lemma sq_mem_zpowers_of_orderOf_eq_two {K : Type*} [Group K] [Finite K] [IsCyclic K]
    {t x : K} (ht : orderOf t = 2) (hx : orderOf x ∣ 4) :
    x ^ 2 ∈ Subgroup.zpowers t := by
  have h4 : x ^ 4 = 1 := orderOf_dvd_iff_pow_eq_one.mp hx
  have hle : Subgroup.zpowers (x ^ 2) ≤ Subgroup.zpowers t := by
    rw [IsCyclic.subgroup_le_iff_card_dvd]
    show Nat.card ↥(Subgroup.zpowers (x ^ 2)) ∣ Nat.card ↥(Subgroup.zpowers t)
    rw [Nat.card_zpowers, Nat.card_zpowers, ht, orderOf_dvd_iff_pow_eq_one,
      show (x ^ 2) ^ 2 = x ^ 4 by rw [← pow_mul]]
    exact h4
  exact hle (Subgroup.mem_zpowers _)

open OddOrder.RepresentationTheory Work.GW2 Work.BG Work.GW2.C16 in
theorem sec3Hyp_of_n_eq_four {G : Type} [Group G] [Finite G]
    (D : Work.GW2.BGData G) (hn : D.n = 4) :
    Work.GW2.C16.Sec3Hyp D := by
  intro x hx u hu
  -- `|S₀| = n = 4`, so the cyclic group `S₀` has order `4`
  have hS0card : Nat.card ↥D.S0 = 4 := by rw [(Work.BG.nCases G D).2, hn]
  -- `U ≤ H = C_G(t)`, so every `u ∈ U` commutes with `t`
  have huH : u ∈ D.H := Subgroup.map_subtype_le (Work.GW2.oddCore D.H) hu
  have htu : D.t * u = u * D.t := (Subgroup.mem_centralizer_iff.mp huH) D.t (by simp)
  -- in the cyclic group `S₀`, the square of `x` lies in `⟨t⟩`
  haveI : IsCyclic ↥D.S0 := D.S0_cyclic
  have hx4 : orderOf (⟨x, hx⟩ : ↥D.S0) ∣ 4 := by
    have h := orderOf_dvd_natCard (⟨x, hx⟩ : ↥D.S0)
    rwa [hS0card] at h
  have ht2 : orderOf (⟨D.t, D.t_mem⟩ : ↥D.S0) = 2 := by
    rw [Subgroup.orderOf_mk, D.t_order]
  have hmem : (⟨x, hx⟩ : ↥D.S0) ^ 2 ∈ Subgroup.zpowers (⟨D.t, D.t_mem⟩ : ↥D.S0) :=
    sq_mem_zpowers_of_orderOf_eq_two ht2 hx4
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hmem
  have hx2 : x ^ 2 = D.t ^ i := by
    have h := congrArg (fun y : ↥D.S0 => (y : G)) hi
    simpa using h.symm
  -- powers of `t` commute with `u`
  rw [hx2]
  exact (Commute.zpow_left htu i).eq

end Work.BG
