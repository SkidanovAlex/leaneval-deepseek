import Mathlib
import Submission.Work.BG.s02_lemma21_aux
import Submission.Work.BG.units_sq_eq_one_eq_one_or_eq_neg_one

/-!
# Area BG: the squares of `Λ` are the characters trivial at `t` (BG Lemma 2.1, ingredient)

The standing data is a `Sec2Ctx G`.  With `Q := quotGroup C.P = H₀/U` the nontrivial cyclic
`2`-group, `Λ := Q →* ℂˣ` is its (Pontryagin) character group, `tU = quotMk C.P C.t` is the
unique involution of `Q`, and `evHom C : Λ →* ℂˣ`, `β ↦ β(tU)` is the evaluation at `tU`.

Since `Λ ≃* Q` (duality of finite abelian groups), `Λ` is cyclic of order `|Q|`, even.  If `β₀`
generates `Λ` then `β₀(tU) = -1` (it satisfies `β₀(tU)² = 1`, and `β₀(tU) = 1` would force
`evHom ≡ 1`, contradicting `exists_negChar`), so for `β = β₀^k` one has `β(tU) = (-1)^k`, which
is `1` exactly for even `k`.  Even powers of a generator are precisely the squares.  Hence

`ker(evHom C) = {β | β is a square in Λ}`,

which is the statement `sqSet C = kerSet C` (both sides translated through
`mem_evHom_ker_iff` / `mem_kerSet`).
-/

set_option linter.style.haveILetI false

namespace Work.BG

open OddOrder.RepresentationTheory
open Subgroup

variable {G : Type} [Group G] [Finite G]

/-! ## 1. The general group-theoretic fact

In a cyclic group generated by `g`, a homomorphism `f` with `f g = -1` (so `f` is "the sign
character") vanishes exactly on the squares. -/

/-- **The sign character of a cyclic group vanishes exactly on the squares.**

If `g` generates the group `A` and `f : A →* ℂˣ` satisfies `f g = -1`, then
`f x = 1 ↔ ∃ w, w * w = x`: writing `x = g ^ k`, `f x = (-1) ^ k`, which is `1` iff `k` is
even, i.e. iff `x = (g ^ (k/2))²`; conversely a square `w * w = (g^j)² = g^(2j)` has
`f (w * w) = (-1)^(2j) = 1`. -/
theorem mem_ker_iff_exists_sq {A : Type} [Group A] {g : A} (hg : Subgroup.zpowers g = ⊤)
    (f : A →* ℂˣ) (hfg : f g = -1) (x : A) : f x = 1 ↔ ∃ w, w * w = x := by
  constructor
  · intro hx
    have hx' : x ∈ Subgroup.zpowers g := by rw [hg]; trivial
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx'
    rw [map_zpow, hfg] at hx
    have hk : Even k := by
      by_contra h
      have h1 : ((-1 : ℂˣ) ^ k) = -1 := by
        rw [neg_one_zpow_eq_ite]
        simp [h]
      rw [h1] at hx
      exact absurd hx (by norm_num)
    obtain ⟨j, hj⟩ := hk
    exact ⟨g ^ j, by rw [← zpow_add, hj]⟩
  · rintro ⟨w, rfl⟩
    have hw' : w ∈ Subgroup.zpowers g := by rw [hg]; trivial
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hw'
    rw [map_mul, map_zpow, hfg, ← zpow_add]
    exact Even.neg_one_zpow ⟨j, rfl⟩

/-! ## 2. A generator of `Λ` with value `-1` at `tU` -/

/-- **`Λ = Hom(H₀/U, ℂˣ)` has a generator on which `evHom C` takes the value `-1`.**

`Λ ≃* Q` is cyclic of even order; let `β₀` be any generator.  Then `β₀(tU)² = β₀(tU²) = 1`,
so `β₀(tU) = ±1`; if it were `1`, every `β = β₀^k` would satisfy `β(tU) = 1`, contradicting
`exists_negChar`. -/
theorem s02_kerSq_generator (C : Sec2Ctx G) :
    ∃ β₀ : quotGroup C.P →* ℂˣ, Subgroup.zpowers β₀ = ⊤ ∧ evHom C β₀ = -1 := by
  haveI : IsCyclic (quotGroup C.P →* ℂˣ) :=
    (MulEquiv.isCyclic
      (Classical.choice
        (CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity (quotGroup C.P) ℂ))).mpr
      (quotIsCyclic C)
  obtain ⟨β₀, hβ₀⟩ := IsCyclic.exists_generator (α := quotGroup C.P →* ℂˣ)
  refine ⟨β₀, ?_, ?_⟩
  · rw [eq_top_iff]; intro x _; exact hβ₀ x
  · set a : quotGroup C.P := quotMk C.P C.t with ha
    have ha2 : a * a = 1 := by rw [← pow_two]; exact quotMk_t_sq C
    have hsplit : β₀ a = 1 ∨ β₀ a = -1 := by
      refine units_sq_eq_one_eq_one_or_eq_neg_one (β₀ a) ?_
      rw [pow_two, ← map_mul, ha2, map_one]
    rcases hsplit with h | h
    · exfalso
      obtain ⟨β, hβ⟩ := exists_negChar C
      have hβ' : β a = -1 := by
        apply Units.ext
        have hh := hβ
        rw [lamCF, ClassFunction.compHom_apply, linearClassFunction_apply] at hh
        exact hh
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hβ₀ β)
      have h1 : β a = 1 := by
        rw [← hk, MonoidHom.zpow_apply, h, one_zpow]
      rw [h1] at hβ'
      exact absurd hβ' (by norm_num)
    · simpa [evHom, ha] using h

/-! ## 3. The statement -/

theorem s02_lemma21_kerSq {G : Type} [Group G] [Finite G] (C : Work.BG.Sec2Ctx G) :
    Work.BG.sqSet C = Work.BG.kerSet C := by
  obtain ⟨β₀, hgen, hval⟩ := s02_kerSq_generator C
  refine Set.Subset.antisymm (sqSet_subset_kerSet C) ?_
  intro x hx
  rw [mem_kerSet] at hx
  have h1 : evHom C x = 1 := by
    rw [← MonoidHom.mem_ker, mem_evHom_ker_iff]
    exact hx
  obtain ⟨w, hw⟩ := (mem_ker_iff_exists_sq hgen (evHom C) hval x).mp h1
  rw [mem_sqSet]
  exact ⟨w, hw⟩

end Work.BG
