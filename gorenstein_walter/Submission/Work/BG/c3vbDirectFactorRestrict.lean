import Mathlib
import Submission.Work.BG.CharBridge
import Submission.Work.BG.centralApplyScalar

/-!
# Area BG: restriction of an irreducible character to a direct factor with abelian complement

`Work.BG.c3vbDirectFactorRestrict` (Bender–Glauberman 1981, §3, "C3" input):  if `X` is a finite
group, `A, C ≤ X` are subgroups with `X = A ⊔ C`, `A ⊓ C = ⊥`, `A` abelian and commuting
elementwise with `C`, and `χ` is an irreducible character of `X`, then

* `χ|_C` is an irreducible character of `C`, and
* `χ|_C(1) = χ(1)`.

Equivalently, `A` is central in `X = A · C`, so on the irreducible module affording `χ` the
elements of `A` act by scalars (`Work.BG.centralApplyScalar`, Schur's lemma); a `C`-invariant
subspace is then automatically `A`-invariant, hence `X`-invariant, and irreducibility of the
`X`-module forces the restriction to `C` to be irreducible.

## Main results

* `Work.BG.mem_sup_eq_mul` — `A ⊔ C = A · C` as a set when `A` and `C` commute elementwise.
* `Work.BG.central_of_complement` — `A` is central in `A ⊔ C`.
* `Work.BG.restrictIrrOfScalars` — irreducibility of the restriction `ρ|_C` when `A` acts by
  scalars and `A ⊔ C = ⊤`.
* `Work.BG.c3vbDirectFactorRestrict` — the target statement.
-/

set_option linter.style.haveILetI false

namespace Work.BG

open OddOrder.RepresentationTheory

/-- **`A ⊔ C = A · C` for elementwise commuting subgroups.**  If every element of `A` commutes
with every element of `C`, then every element of `A ⊔ C` is a product `a * c` with `a ∈ A`,
`c ∈ C`.

(For a general group `A ⊔ C` is the subgroup generated by `A ∪ C`, whose elements are alternating
products; commutation collapses the alternation.) -/
theorem mem_sup_eq_mul {X : Type} [Group X] (A C : Subgroup X)
    (hcomm : ∀ a ∈ A, ∀ c ∈ C, a * c = c * a) :
    ∀ x ∈ (A ⊔ C : Subgroup X), ∃ a ∈ A, ∃ c ∈ C, x = a * c := by
  intro x hx
  rw [Subgroup.sup_eq_closure] at hx
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
      rcases hy with hy | hy
      · exact ⟨y, hy, 1, C.one_mem, by simp⟩
      · exact ⟨1, A.one_mem, y, hy, by simp⟩
  | one => exact ⟨1, A.one_mem, 1, C.one_mem, by simp⟩
  | mul y z hy hz ihy ihz =>
      obtain ⟨a₁, ha₁, c₁, hc₁, rfl⟩ := ihy
      obtain ⟨a₂, ha₂, c₂, hc₂, rfl⟩ := ihz
      refine ⟨a₁ * a₂, A.mul_mem ha₁ ha₂, c₁ * c₂, C.mul_mem hc₁ hc₂, ?_⟩
      rw [mul_assoc a₁ c₁ (a₂ * c₂), mul_assoc a₁ a₂ (c₁ * c₂)]
      rw [← mul_assoc c₁ a₂ c₂, ← hcomm a₂ ha₂ c₁ hc₁, mul_assoc a₂ c₁ c₂]
  | inv y hy ihy =>
      obtain ⟨a, ha, c, hc, rfl⟩ := ihy
      refine ⟨a⁻¹, A.inv_mem ha, c⁻¹, C.inv_mem hc, ?_⟩
      rw [mul_inv_rev, hcomm a⁻¹ (A.inv_mem ha) c⁻¹ (C.inv_mem hc)]

/-- **`A` is central in `A ⊔ C`.**  If `A` is abelian and commutes elementwise with `C`, then
every `a ∈ A` commutes with every element of `A ⊔ C`. -/
theorem central_of_complement {X : Type} [Group X] (A C : Subgroup X)
    (hsup : A ⊔ C = ⊤) (hcomm : ∀ a ∈ A, ∀ c ∈ C, a * c = c * a)
    (hab : ∀ a b : ↥A, a * b = b * a) :
    ∀ a ∈ A, ∀ x : X, a * x = x * a := by
  intro a ha x
  have hx : x ∈ (A ⊔ C : Subgroup X) := by rw [hsup]; trivial
  obtain ⟨a', ha', c, hc, rfl⟩ := mem_sup_eq_mul A C hcomm x hx
  have h1 : a * a' = a' * a := by
    have h := congrArg Subtype.val (hab ⟨a, ha⟩ ⟨a', ha'⟩)
    simpa using h
  calc a * (a' * c) = a * a' * c := by rw [mul_assoc]
    _ = a' * a * c := by rw [h1]
    _ = a' * (a * c) := by rw [mul_assoc]
    _ = a' * (c * a) := by rw [hcomm a ha c hc]
    _ = (a' * c) * a := by rw [mul_assoc]

/-- **Restriction to `C` is irreducible when `A` acts by scalars and `X = A * C`.**

Let `ρ` be an irreducible representation of a group `X` on a complex vector space, let
`A, C ≤ X` with `A ⊔ C = ⊤`, and suppose each `a ∈ A` acts on the representation space as a
scalar `μ a`.  Then `ρ|_C` (the representation of `C` obtained by composing with
`C.subtype`) is irreducible: a `C`-invariant subspace is automatically `A`-invariant (scalars
preserve every subspace), hence invariant under the subgroup generated by `A ∪ C = X`, so it is
an `X`-subrepresentation and hence `⊥` or `⊤`. -/
theorem restrictIrrOfScalars {X V : Type} [Group X] [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ X V) (hρ : Representation.IsIrreducible ρ) (A C : Subgroup X)
    (hsup : A ⊔ C = ⊤)
    (hscal : ∀ a ∈ A, ∃ μ : ℂ, ρ a = μ • (LinearMap.id : V →ₗ[ℂ] V)) :
    Representation.IsIrreducible (ρ.comp C.subtype) := by
  classical
  choose μ hμ using hscal
  -- the representation space is nontrivial, since its lattice of subrepresentations is
  have hVnt : Nontrivial V := by
    by_contra h
    haveI : Subsingleton V := not_nontrivial_iff_subsingleton.mp h
    haveI hsub : Subsingleton (Subrepresentation ρ) :=
      ⟨fun σ τ => Subrepresentation.toSubmodule_injective (Subsingleton.elim _ _)⟩
    rcases hρ.toNontrivial.exists_pair_ne with ⟨σ, τ, hστ⟩
    exact hστ (Subsingleton.elim σ τ)
  haveI : Nontrivial V := hVnt
  have hbot_ne_top : (⊥ : Subrepresentation (ρ.comp C.subtype)) ≠ ⊤ := by
    intro h
    obtain ⟨v, hv⟩ := exists_ne (0 : V)
    have hsub : (⊥ : Submodule ℂ V) = (⊤ : Submodule ℂ V) := by
      have h' := congrArg Subrepresentation.toSubmodule h
      exact h'
    have hv0 : v ∈ (⊥ : Submodule ℂ V) := by rw [hsub]; trivial
    exact hv ((Submodule.mem_bot ℂ).mp hv0)
  refine { toNontrivial := Nontrivial.mk ⟨⊥, ⊤, hbot_ne_top⟩, eq_bot_or_eq_top := ?_ }
  intro σ
  let W : Submodule ℂ V := σ.toSubmodule
  have hW : ∀ c : ↥C, ∀ v ∈ W, (ρ.comp C.subtype) c v ∈ W :=
    fun c v hv => σ.apply_mem_toSubmodule c hv
  -- the subgroup of `X` preserving `W` together with its inverse contains `A` and `C`
  have hXinv : ∀ x : X, ∀ v ∈ W, ρ x v ∈ W := by
    let K : Subgroup X :=
      { carrier := {x : X | (∀ v ∈ W, ρ x v ∈ W) ∧ (∀ v ∈ W, ρ x⁻¹ v ∈ W)}
        one_mem' := by
          refine ⟨?_, ?_⟩ <;> intro v hv <;> simpa using hv
        mul_mem' := by
          intro x y hx hy
          refine ⟨?_, ?_⟩
          · intro v hv
            have h2 : ρ x (ρ y v) ∈ W := hx.1 (ρ y v) (hy.1 v hv)
            simpa [map_mul] using h2
          · intro v hv
            have h2 : ρ y⁻¹ (ρ x⁻¹ v) ∈ W := hy.2 (ρ x⁻¹ v) (hx.2 v hv)
            simpa [mul_inv_rev, map_mul] using h2
        inv_mem' := by
          intro x hx
          exact ⟨hx.2, by simpa [inv_inv] using hx.1⟩ }
    have hAle : A ≤ K := by
      intro a ha
      refine ⟨?_, ?_⟩
      · intro v hv
        rw [hμ a ha]
        simpa using Submodule.smul_mem W (μ a ha) hv
      · intro v hv
        rw [hμ a⁻¹ (A.inv_mem ha)]
        simpa using Submodule.smul_mem W (μ a⁻¹ (A.inv_mem ha)) hv
    have hCle : C ≤ K := by
      intro c hc
      refine ⟨?_, ?_⟩
      · intro v hv
        simpa using hW (⟨c, hc⟩ : ↥C) v hv
      · intro v hv
        simpa using hW (⟨c⁻¹, C.inv_mem hc⟩ : ↥C) v hv
    have htop : (⊤ : Subgroup X) ≤ K := by
      rw [← hsup]
      exact sup_le hAle hCle
    intro x
    exact (htop (Subgroup.mem_top x)).1
  -- hence `W` is an `X`-invariant subspace, i.e. a subrepresentation of `ρ`
  have hσinv : ∀ x : X, ∀ v ∈ σ.toSubmodule, ρ x v ∈ σ.toSubmodule :=
    fun x v hv => hXinv x v hv
  rcases hρ.eq_bot_or_eq_top (⟨σ.toSubmodule, hσinv⟩ : Subrepresentation ρ) with h | h
  · left
    refine Subrepresentation.toSubmodule_injective ?_
    have h' : (⟨σ.toSubmodule, hσinv⟩ : Subrepresentation ρ).toSubmodule
        = (⊥ : Subrepresentation ρ).toSubmodule := congrArg Subrepresentation.toSubmodule h
    exact h'
  · right
    refine Subrepresentation.toSubmodule_injective ?_
    have h' : (⟨σ.toSubmodule, hσinv⟩ : Subrepresentation ρ).toSubmodule
        = (⊤ : Subrepresentation ρ).toSubmodule := congrArg Subrepresentation.toSubmodule h
    exact h'

/-- **Restriction of an irreducible character to a direct factor with abelian complement.**
(Bender–Glauberman 1981, §3.)  Let `X` be a finite group and `A, C ≤ X` subgroups with
`X = A ⊔ C`, `A ⊓ C = ⊥`, `A` abelian and commuting elementwise with `C`.  Then for every
irreducible character `χ` of `X` the restriction `χ|_C` is an irreducible character of `C`, of
the same degree as `χ`. -/
theorem c3vbDirectFactorRestrict {X : Type} [Group X] [Finite X] [Fintype X]
    [Invertible (Nat.card X : ℂ)] (A C : Subgroup X)
    (hsup : A ⊔ C = ⊤) (hinf : A ⊓ C = ⊥)
    (hcomm : ∀ a ∈ A, ∀ c ∈ C, a * c = c * a) (hab : ∀ a b : ↥A, a * b = b * a)
    (χ : OddOrder.RepresentationTheory.ClassFunction X ℂ)
    (hχ : OddOrder.RepresentationTheory.IsIrreducibleCharacter χ) :
    OddOrder.RepresentationTheory.IsIrreducibleCharacter
        (OddOrder.RepresentationTheory.ClassFunction.restrict C χ) ∧
      (OddOrder.RepresentationTheory.ClassFunction.restrict C χ) 1 = χ 1 := by
  obtain ⟨V, hAG, hMod, hFD, ρ, hρ, hχeq⟩ := hχ
  -- NB: the instance arguments `hAG`, `hMod`, `hFD` of the existential witness are found by
  -- typeclass search as local hypotheses; do NOT shadow them with `haveI` (that would change
  -- the instance terms appearing in `ρ`'s type and break the defeq matching below).
  have hcent : ∀ a ∈ A, ∀ x : X, a * x = x * a :=
    central_of_complement A C hsup hcomm hab
  -- `A` acts on the representing module by scalars
  have hscal : ∀ a ∈ A, ∃ μ : ℂ, ρ a = μ • (LinearMap.id : V →ₗ[ℂ] V) := by
    intro a ha
    exact centralApplyScalar (X := X) (V := V) (ρ := ρ) (hρ := hρ) (a := a)
      (hcent := hcent a ha)
  have hirr : Representation.IsIrreducible (ρ.comp C.subtype) :=
    restrictIrrOfScalars (X := X) (V := V) (ρ := ρ) (hρ := hρ) (A := A) (C := C)
      (hsup := hsup) (hscal := hscal)
  have hchar : ((ClassFunction.restrict C χ : ClassFunction ↥C ℂ) : ↥C → ℂ)
      = Representation.character (ρ.comp C.subtype) := by
    funext c
    rw [ClassFunction.restrict_apply]
    exact congrFun hχeq (c : X)
  refine ⟨⟨V, hAG, hMod, hFD, ρ.comp C.subtype, hirr, hchar⟩, ?_⟩
  simp

end Work.BG
