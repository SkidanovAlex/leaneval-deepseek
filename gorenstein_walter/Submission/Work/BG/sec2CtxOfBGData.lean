import Mathlib
import Submission.Work.BG.S02
import Submission.Work.BG.Defs
import Submission.Work.BG.hyp12OfBGData

/-!
# Area BG: from Bender–Glauberman Hypothesis 1.1 to a §2 context

`Work.BG.sec2CtxOfBGData`: given the centralizer-splitting hypothesis
`Work.GW2.CentralizerSplitProp` and the data `D : Work.GW2.BGData G` of Bender–Glauberman
Hypothesis 1.1, there is a §2 context `C : Work.BG.Sec2Ctx G` with `C.P.H = D.H`,
`C.P.U = D.U`, `C.P.H0 = H₁ = U S₀`, `t = D.t` and `s = D.t₁`.

The Hypothesis 1.2 part (`P : Work.BG.Hyp12 G` with `P.H = D.H`, `P.U = D.U`,
`P.H0 = H₁`) is `Work.BG.hyp12OfBGData`.  What this file adds is the rest of the standing
data of BG §2:

* `H₀/U` is cyclic, generated by the class of `t₁ t₂` (`quot_cyclic`), and a 2-group
  (`quot_two`);
* `t` is the only involution of `H₀ = U S₀` (`inv_H0`), so `t₁ ∉ H₀` (`s_not_mem_H0`);
* `t₁` inverts `H₀/U` (`s_inverts`).

Every one of these rests on the same elementary fact: since `S₀ ≤ N_G(U)` (because
`U = O(H)` and `S₀ ≤ H`), every element of `H₀ = U ⊔ S₀` is a *product* `u * s` with
`u ∈ U`, `s ∈ S₀` — `U` is not normal in `G`, so this is
`Subgroup.coe_mul_of_right_le_normalizer_left`, and `U ∩ S₀ = ⊥` makes the decomposition
usable for the counting arguments.
-/

namespace Work.BG

open Subgroup
open scoped Pointwise

/-! ## 1. Elementary group theory used below -/

/-- If `s` normalises `U` then `(u s)^n = w s^n` with `w ∈ U`: the "error term" is the
product of the conjugates `s^i u s^{-i}`, each of which lies in `U`. -/
private theorem exists_mem_pow_mul_eq_of_mem_normalizer {G : Type} [Group G] {U : Subgroup G}
    {s u : G} (hs : s ∈ Subgroup.normalizer (U : Set G)) (hu : u ∈ U) (n : ℕ) :
    ∃ w ∈ U, (u * s) ^ n = w * s ^ n := by
  induction n with
  | zero => exact ⟨1, U.one_mem, by simp⟩
  | succ n ih =>
    obtain ⟨w, hw, hw'⟩ := ih
    have hconj : s ^ n * u * (s ^ n)⁻¹ ∈ U := by
      have hmem : s ^ n ∈ Subgroup.normalizer (U : Set G) :=
        (Subgroup.normalizer (U : Set G)).pow_mem hs n
      exact (Subgroup.mem_normalizer_iff.mp hmem u).mp hu
    refine ⟨w * (s ^ n * u * (s ^ n)⁻¹), U.mul_mem hw hconj, ?_⟩
    have hcomm : s * s ^ n = s ^ n * s := by rw [← pow_succ', ← pow_succ]
    calc (u * s) ^ (n + 1) = (w * s ^ n) * (u * s) := by rw [pow_succ (u * s) n, hw']
      _ = w * (s ^ n * u * (s ^ n)⁻¹) * (s * s ^ n) := by rw [hcomm]; group
      _ = w * (s ^ n * u * (s ^ n)⁻¹) * s ^ (n + 1) := by rw [pow_succ' s n]

/-- Conjugation by an involution `t₁` inverts `t₁ t₂` when `t₂` is an involution: this is
the "dihedral" computation behind `s` inverting `H₀/U`. -/
private theorem conj_zpow_inv_of_sq_eq_one {G : Type} [Group G] {t1 t2 : G}
    (h1 : t1 ^ 2 = 1) (h2 : t2 ^ 2 = 1) (k : ℤ) :
    t1 * (t1 * t2) ^ k * t1⁻¹ = ((t1 * t2) ^ k)⁻¹ := by
  have h11 : t1 * t1 = 1 := by rw [← pow_two]; exact h1
  have h22 : t2 * t2 = 1 := by rw [← pow_two]; exact h2
  have hgen : MulAut.conj t1 (t1 * t2) = (t1 * t2)⁻¹ := by
    rw [MulAut.conj_apply, mul_inv_rev, inv_eq_of_mul_eq_one_left h11,
      inv_eq_of_mul_eq_one_left h22]
    rw [show t1 * (t1 * t2) * t1 = (t1 * t1) * (t2 * t1) from by group, h11, one_mul]
  rw [← MulAut.conj_apply t1 ((t1 * t2) ^ k), map_zpow, hgen, inv_zpow]

/-- In a finite cyclic group, an element of order `2` is the only non-identity element
squaring to `1`. -/
private theorem eq_one_or_eq_of_sq_eq_one_of_isCyclic {G : Type} [Group G] [Finite G]
    {S0 : Subgroup G} (hcyc : IsCyclic ↥S0) {t s : G} (ht : t ∈ S0) (ht2 : t ^ 2 = 1)
    (ht1 : t ≠ 1) (hs : s ∈ S0) (hs2 : s ^ 2 = 1) : s = 1 ∨ s = t := by
  by_cases hs1 : s = 1
  · exact Or.inl hs1
  · refine Or.inr ?_
    have hsz : (⟨s, hs⟩ : ↥S0) ≠ 1 := fun h => hs1 (Subtype.ext_iff.mp h)
    have htz : (⟨t, ht⟩ : ↥S0) ≠ 1 := fun h => ht1 (Subtype.ext_iff.mp h)
    have hs2' : (⟨s, hs⟩ : ↥S0) ^ 2 = 1 := Subtype.ext (by simpa using hs2)
    have ht2' : (⟨t, ht⟩ : ↥S0) ^ 2 = 1 := Subtype.ext (by simpa using ht2)
    exact Subtype.ext_iff.mp (sq_eq_one_eq_of_isCyclic hsz htz hs2' ht2')

/-- A group of odd order has no element of order `2`. -/
private theorem eq_one_of_sq_eq_one_of_odd_card {G : Type} [Group G] {U : Subgroup G}
    (hodd : Odd (Nat.card ↥U)) {u : G} (hu : u ∈ U) (hu2 : u ^ 2 = 1) : u = 1 := by
  have hdvd1 : orderOf u ∣ Nat.card ↥U := by
    have h := orderOf_dvd_natCard (⟨u, hu⟩ : ↥U)
    rwa [← Subgroup.orderOf_coe] at h
  have hdvd2 : orderOf u ∣ 2 := by
    rw [orderOf_dvd_iff_pow_eq_one]; exact hu2
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd2 with h | h
  · exact orderOf_eq_one_iff.mp h
  · exfalso
    have h2 : 2 ∣ Nat.card ↥U := h ▸ hdvd1
    have h0 : Nat.card ↥U % 2 = 0 := Nat.dvd_iff_mod_eq_zero.mp h2
    have h1 : Nat.card ↥U % 2 = 1 := Nat.odd_iff.mp hodd
    omega

/-! ## 2. The elementary facts about `D` -/

/-- The facts about `D : Work.GW2.BGData G` (under the centralizer-splitting hypothesis)
on which the construction of the §2 context rests: `H = U S`, the oddness and normality of
`U`, `U ∩ S = U ∩ S₀ = 1`, `t ∉ U`, and the orders of `t, t₁, t₂`. -/
private structure Sec2CtxInput {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G) : Prop
    where
  hUS : D.U ⊔ (D.S : Subgroup G) = D.H
  hU_le_H : D.U ≤ D.H
  hS_le_H : (D.S : Subgroup G) ≤ D.H
  hS0_le_H : D.S0 ≤ D.H
  hH0_le_H : H1 D ≤ D.H
  hH_le_normU : D.H ≤ Subgroup.normalizer (D.U : Set G)
  hS_le_normU : (D.S : Subgroup G) ≤ Subgroup.normalizer (D.U : Set G)
  hS0_le_normU : D.S0 ≤ Subgroup.normalizer (D.U : Set G)
  hU_odd : Odd (Nat.card ↥D.U)
  hU_inf_S : D.U ⊓ (D.S : Subgroup G) = ⊥
  hU_inf_S0 : D.U ⊓ D.S0 = ⊥
  ht_notU : D.t ∉ D.U
  hS0_2group : IsPGroup 2 ↥D.S0
  ht2 : D.t ^ 2 = 1
  ht1 : D.t ≠ 1
  ht1sq : D.t1 ^ 2 = 1
  ht2sq : D.t2 ^ 2 = 1

private theorem sec2CtxInput_of_split {G : Type} [Group G] [Finite G]
    (hSplit : Work.GW2.CentralizerSplitProp) (D : Work.GW2.BGData G) : Sec2CtxInput D := by
  have hcentr : ∀ x ∈ (D.S : Subgroup G), x * D.t = D.t * x := by
    intro x hx
    exact (Subgroup.mem_centralizer_iff.mp (BGData_S_le_centralizer_t D hx) D.t
      (Set.mem_singleton D.t)).symm
  have hUS : D.U ⊔ (D.S : Subgroup G) = D.H :=
    hSplit G D.S D.n D.two_le D.dih D.t (D.S0_le D.t_mem) D.t_order hcentr
  have hU_le_H : D.U ≤ D.H := hUS ▸ le_sup_left
  have hS_le_H : (D.S : Subgroup G) ≤ D.H := hUS ▸ le_sup_right
  have hS0_le_H : D.S0 ≤ D.H := D.S0_le.trans hS_le_H
  have hH0_le_H : H1 D ≤ D.H := sup_le hU_le_H hS0_le_H
  have hH_le_normU : D.H ≤ Subgroup.normalizer (D.U : Set G) := by
    have hUnorm : D.U = Work.GW2.oddCoreIn D.H := rfl
    rw [hUnorm, Work.GW2.oddCoreIn_eq_opiCoreInG]
    exact OddOrder.GroupTheory.le_normalizer_opiCoreInG _ _
  have hUpi : Subgroup.IsPiSubgroup ({q : ℕ | q ≠ 2}) D.U := by
    have hUnorm : D.U = Work.GW2.oddCoreIn D.H := rfl
    rw [hUnorm, Work.GW2.oddCoreIn_eq_opiCoreInG]
    exact OddOrder.GroupTheory.isPiSubgroup_opiCoreInG _ _
  have hU_odd : Odd (Nat.card ↥D.U) :=
    (Work.GW2.odd_card_iff_isPiSubgroup_ne_two D.U).mpr hUpi
  have hU_inf_S : D.U ⊓ (D.S : Subgroup G) = ⊥ :=
    OddOrder.GroupTheory.inf_eq_bot_of_isPiSubgroup_of_isPiSubgroup_compl hUpi
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem D.S.isPGroup' (by simp))
  have hU_inf_S0 : D.U ⊓ D.S0 = ⊥ := by
    have hle : D.U ⊓ D.S0 ≤ D.U ⊓ (D.S : Subgroup G) := inf_le_inf_left _ D.S0_le
    rw [hU_inf_S] at hle
    exact le_bot_iff.mp hle
  have ht_notU : D.t ∉ D.U := by
    intro hmem
    have hle : Subgroup.zpowers D.t ≤ D.U := Subgroup.zpowers_le.mpr hmem
    have hdvd : Nat.card ↥(Subgroup.zpowers D.t) ∣ Nat.card ↥D.U := Subgroup.card_dvd_of_le hle
    rw [Nat.card_zpowers, D.t_order] at hdvd
    have h1 : Nat.card ↥D.U % 2 = 1 := Nat.odd_iff.mp hU_odd
    have h2 : Nat.card ↥D.U % 2 = 0 := Nat.dvd_iff_mod_eq_zero.mp hdvd
    omega
  exact
    { hUS := hUS
      hU_le_H := hU_le_H
      hS_le_H := hS_le_H
      hS0_le_H := hS0_le_H
      hH0_le_H := hH0_le_H
      hH_le_normU := hH_le_normU
      hS_le_normU := hS_le_H.trans hH_le_normU
      hS0_le_normU := hS0_le_H.trans hH_le_normU
      hU_odd := hU_odd
      hU_inf_S := hU_inf_S
      hU_inf_S0 := hU_inf_S0
      ht_notU := ht_notU
      hS0_2group := IsPGroup.to_le D.S.isPGroup' D.S0_le
      ht2 := ((orderOf_eq_prime_iff (p := 2)).mp D.t_order).1
      ht1 := ((orderOf_eq_prime_iff (p := 2)).mp D.t_order).2
      ht1sq := ((orderOf_eq_prime_iff (p := 2)).mp D.t1_order).1
      ht2sq := ((orderOf_eq_prime_iff (p := 2)).mp D.t2_order).1 }

/-! ## 3. The §2 facts -/

/-- Every element of `H₁ = U ⊔ S₀` is a product `u * s`, `u ∈ U`, `s ∈ S₀`
(`S₀ ≤ N_G(U)`, so `U S₀` is a subgroup). -/
private theorem sec2_decomp {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (h : Sec2CtxInput D) {x : G} (hx : x ∈ H1 D) : ∃ u ∈ D.U, ∃ s ∈ D.S0, u * s = x := by
  have hx' : x ∈ (D.U ⊔ D.S0 : Subgroup G) := hx
  have hmul : x ∈ (D.U : Set G) * (D.S0 : Set G) := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left D.U D.S0 h.hS0_le_normU]
    exact hx'
  rw [Set.mem_mul] at hmul
  exact hmul

/-- `t₁ ∉ H₁`: `H₁ ∩ S = S₀` because `U ∩ S = 1` and `S₀ ≤ S`. -/
private theorem sec2_t1_not_mem {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (h : Sec2CtxInput D) : D.t1 ∉ H1 D := by
  intro hmem
  obtain ⟨u, hu, s, hs, hprod⟩ := sec2_decomp D h hmem
  have huS : u ∈ (D.S : Subgroup G) := by
    have hu_eq : u = D.t1 * s⁻¹ := by rw [← hprod]; group
    rw [hu_eq]
    exact Subgroup.mul_mem _ D.t1_mem (Subgroup.inv_mem _ (D.S0_le hs))
  have hubot : u ∈ D.U ⊓ (D.S : Subgroup G) := ⟨hu, huS⟩
  rw [h.hU_inf_S, Subgroup.mem_bot] at hubot
  have ht1eq : D.t1 = s := by rw [← hprod, hubot, one_mul]
  exact D.t1_nmem (ht1eq ▸ hs)

/-- `t` is the only involution of `H₁ = U S₀`: if `x = u s` has `x² = 1`, then `s² ∈ U`,
whence `s² = 1` and `s ∈ {1, t}` (cyclicity of `S₀`), and `x² = u²` forces `u = 1`
(oddness of `U`). -/
private theorem sec2_inv {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (h : Sec2CtxInput D) : ∀ x ∈ H1 D, x ^ 2 = 1 → x = 1 ∨ x = D.t := by
  intro x hx hx2
  obtain ⟨u, hu, s, hs, hprod⟩ := sec2_decomp D h hx
  have htu : D.t * u = u * D.t :=
    (Subgroup.mem_centralizer_singleton_iff.mp (h.hU_le_H hu)).symm
  have hconj : u * (s * u * s⁻¹) ∈ D.U :=
    D.U.mul_mem hu ((Subgroup.mem_normalizer_iff.mp (h.hS0_le_normU hs) u).mp hu)
  have hs2U : s ^ 2 ∈ D.U := by
    have h1 : x ^ 2 = (u * (s * u * s⁻¹)) * s ^ 2 := by rw [← hprod, pow_two]; group
    have h1' : (u * (s * u * s⁻¹)) * s ^ 2 = 1 := by rw [← h1, hx2]
    have h2 : s ^ 2 = (u * (s * u * s⁻¹))⁻¹ := eq_inv_of_mul_eq_one_right h1'
    rw [h2]
    exact D.U.inv_mem hconj
  have hs2 : s ^ 2 = 1 := by
    have hmem : s ^ 2 ∈ D.U ⊓ D.S0 := ⟨hs2U, Subgroup.pow_mem _ hs 2⟩
    rw [h.hU_inf_S0, Subgroup.mem_bot] at hmem
    exact hmem
  rcases eq_one_or_eq_of_sq_eq_one_of_isCyclic (t := D.t) (s := s) D.S0_cyclic D.t_mem h.ht2
      h.ht1 hs hs2 with hs1 | hst
  · left
    have hx_eq : x = u := by rw [← hprod, hs1, mul_one]
    rw [hx_eq] at hx2 ⊢
    exact eq_one_of_sq_eq_one_of_odd_card h.hU_odd hu hx2
  · right
    have hx_eq : x = u * D.t := by rw [← hprod, hst]
    have hu2 : u ^ 2 = 1 := by
      have h1 : (u * D.t) ^ 2 = u ^ 2 := by
        calc (u * D.t) ^ 2 = u * (D.t * u) * D.t := by rw [pow_two]; group
          _ = u * (u * D.t) * D.t := by rw [htu]
          _ = (u * u) * (D.t * D.t) := by group
          _ = u ^ 2 := by
                rw [pow_two, show D.t * D.t = 1 from by rw [← pow_two]; exact h.ht2, mul_one]
      rw [← hx_eq] at h1
      rw [hx2] at h1
      exact h1.symm
    have hu1 : u = 1 := eq_one_of_sq_eq_one_of_odd_card h.hU_odd hu hu2
    rw [hx_eq, hu1, one_mul]

/-- `H₁/U` is cyclic, generated by the class of `t₁ t₂`: for `x = u s` with `s = (t₁t₂)^k`
we have `x (t₁t₂)^{-k} = u ∈ U`. -/
private theorem sec2_quot_cyclic {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (h : Sec2CtxInput D) :
    ∃ c ∈ H1 D, ∀ x ∈ H1 D, ∃ k : ℤ, x * (c ^ k)⁻¹ ∈ D.U := by
  refine ⟨D.t1 * D.t2, ?_, ?_⟩
  · exact Subgroup.mem_sup_right
      (show D.t1 * D.t2 ∈ D.S0 by rw [D.gen]; exact Subgroup.mem_zpowers _)
  · intro x hx
    obtain ⟨u, hu, s, hs, hprod⟩ := sec2_decomp D h hx
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (show s ∈ Subgroup.zpowers (D.t1 * D.t2) by
      rw [← D.gen]; exact hs)
    refine ⟨k, ?_⟩
    rw [← hprod, hk]
    simpa [mul_assoc] using hu

/-- `H₁/U` is a 2-group: for `x = u s` and `2^n ≥` the order of `s`, `x ^ 2^n ∈ U`. -/
private theorem sec2_quot_two {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (h : Sec2CtxInput D) : ∀ x ∈ H1 D, ∃ n : ℕ, x ^ (2 ^ n) ∈ D.U := by
  intro x hx
  obtain ⟨u, hu, s, hs, hprod⟩ := sec2_decomp D h hx
  obtain ⟨n, hn⟩ := isPGroup_iff_pow_pow_eq_one.mp h.hS0_2group (⟨s, hs⟩ : ↥D.S0)
  obtain ⟨w, hw, hw'⟩ := exists_mem_pow_mul_eq_of_mem_normalizer (h.hS0_le_normU hs) hu (2 ^ n)
  refine ⟨n, ?_⟩
  have hs2 : s ^ (2 ^ n) = 1 := by
    have hval := congrArg (Subtype.val) hn
    simpa using hval
  rw [← hprod, hw', hs2, mul_one]
  exact hw

/-- `t₁` inverts `H₁/U`: `t₁ (u s) t₁⁻¹ (u s) = (t₁ u t₁⁻¹) (s⁻¹ u s) ∈ U`. -/
private theorem sec2_s_inverts {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G)
    (h : Sec2CtxInput D) : ∀ x ∈ H1 D, D.t1 * x * D.t1⁻¹ * x ∈ D.U := by
  intro x hx
  obtain ⟨u, hu, s, hs, hprod⟩ := sec2_decomp D h hx
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (show s ∈ Subgroup.zpowers (D.t1 * D.t2) by
    rw [← D.gen]; exact hs)
  have hconjs : D.t1 * s * D.t1⁻¹ = s⁻¹ := by
    rw [← hk]
    exact conj_zpow_inv_of_sq_eq_one h.ht1sq h.ht2sq k
  have hconj1 : D.t1 * u * D.t1⁻¹ ∈ D.U :=
    (Subgroup.mem_normalizer_iff.mp (h.hS_le_normU D.t1_mem) u).mp hu
  have hconj2 : s⁻¹ * u * s ∈ D.U := by
    have hmem := (Subgroup.mem_normalizer_iff.mp
      ((Subgroup.normalizer (D.U : Set G)).inv_mem (h.hS0_le_normU hs)) u).mp hu
    simpa using hmem
  have hstep : D.t1 * (u * s) * D.t1⁻¹ * (u * s) =
      (D.t1 * u * D.t1⁻¹) * (s⁻¹ * u * s) := by
    rw [show D.t1 * (u * s) * D.t1⁻¹ =
        (D.t1 * u * D.t1⁻¹) * (D.t1 * s * D.t1⁻¹) from by group, hconjs]
    group
  rw [← hprod, hstep]
  exact D.U.mul_mem hconj1 hconj2

/-- All involutions of `G` are conjugate to `t`. -/
private theorem sec2_one_class {G : Type} [Group G] [Finite G] (D : Work.GW2.BGData G) :
    ∀ x : G, x ^ 2 = 1 → x ≠ 1 → IsConj x D.t :=
  fun x hx2 hx1 => D.oneClass x D.t (orderOf_eq_prime hx2 hx1) D.t_order

/-! ## 4. The §2 context -/

theorem sec2CtxOfBGData {G : Type} [Group G] [Finite G]
    (hSplit : Work.GW2.CentralizerSplitProp) (D : Work.GW2.BGData G) :
    ∃ C : Work.BG.Sec2Ctx G,
      C.P.H = D.H ∧ C.P.U = D.U ∧ C.P.H0 = Work.BG.H1 D ∧ (C.t : G) = D.t ∧
        (C.s : G) = D.t1 := by
  obtain ⟨P, hPH, hPU, hPH0⟩ := hyp12OfBGData hSplit D
  have h : Sec2CtxInput D := sec2CtxInput_of_split hSplit D
  have htmem : D.t ∈ P.H0 := by rw [hPH0]; exact Subgroup.mem_sup_right D.t_mem
  have hsmem : D.t1 ∈ P.H := by rw [hPH, ← h.hUS]; exact Subgroup.mem_sup_right D.t1_mem
  have hU_normal : (P.U.subgroupOf P.H0).Normal := by
    rw [hPU, hPH0]
    exact Subgroup.normal_subgroupOf_of_le_normalizer (h.hH0_le_H.trans h.hH_le_normU)
  have ht_sq : (⟨D.t, htmem⟩ : ↥P.H0) ^ 2 = 1 := Subtype.ext (by simpa using h.ht2)
  have ht_notU : ((⟨D.t, htmem⟩ : ↥P.H0) : G) ∉ P.U := by
    rw [hPU]
    exact h.ht_notU
  have ht_comm : ∀ x ∈ P.H,
      x * ((⟨D.t, htmem⟩ : ↥P.H0) : G) = ((⟨D.t, htmem⟩ : ↥P.H0) : G) * x := by
    intro x hx
    rw [hPH] at hx
    simpa using (Subgroup.mem_centralizer_singleton_iff.mp hx)
  have hs_sq : (⟨D.t1, hsmem⟩ : ↥P.H) ^ 2 = 1 := Subtype.ext (by simpa using h.ht1sq)
  have hs_notH0 : ((⟨D.t1, hsmem⟩ : ↥P.H) : G) ∉ P.H0 := by
    rw [hPH0]
    exact sec2_t1_not_mem D h
  have h_inv : ∀ x ∈ P.H0, x ^ 2 = 1 → x = 1 ∨ x = ((⟨D.t, htmem⟩ : ↥P.H0) : G) := by
    intro x hx hx2
    rw [hPH0] at hx
    rcases sec2_inv D h x hx hx2 with h' | h'
    · exact Or.inl h'
    · exact Or.inr h'
  have h_one : ∀ x : G, x ^ 2 = 1 → x ≠ 1 → IsConj x ((⟨D.t, htmem⟩ : ↥P.H0) : G) :=
    fun x hx2 hx1 => sec2_one_class D x hx2 hx1
  have h_qc : ∃ c ∈ P.H0, ∀ x ∈ P.H0, ∃ k : ℤ, x * (c ^ k)⁻¹ ∈ P.U := by
    rw [hPH0, hPU]
    exact sec2_quot_cyclic D h
  have h_qt : ∀ x ∈ P.H0, ∃ n : ℕ, x ^ (2 ^ n) ∈ P.U := by
    rw [hPH0, hPU]
    exact sec2_quot_two D h
  have h_si : ∀ x ∈ P.H0,
      ((⟨D.t1, hsmem⟩ : ↥P.H) : G) * x * ((⟨D.t1, hsmem⟩ : ↥P.H) : G)⁻¹ * x ∈ P.U := by
    rw [hPH0, hPU]
    exact sec2_s_inverts D h
  exact ⟨{ P := P, U_normal := hU_normal, t := ⟨D.t, htmem⟩, s := ⟨D.t1, hsmem⟩, t_sq := ht_sq, t_not_mem_U := ht_notU, t_comm_H := ht_comm, s_sq := hs_sq, s_not_mem_H0 := hs_notH0, inv_H0 := h_inv, one_class := h_one, quot_cyclic := h_qc, quot_two := h_qt, s_inverts := h_si }, hPH, hPU, hPH0, rfl, rfl⟩

end Work.BG
