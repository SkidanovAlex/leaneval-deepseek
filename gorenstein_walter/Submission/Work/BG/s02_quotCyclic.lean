import Mathlib
import Submission.Work.BG.S02
import Submission.Work.BG.Lambda

/-!
# Area BG: `H₀/U` is cyclic and abelian

`Sec2Ctx` records that `H₀/U` is generated by the class of one element (`quot_cyclic`) and is a
2-group (`quot_two`); here we record the immediate consequences used by the proof of
`Work.BG.Lemma21ExtProp`: `H₀/U` is cyclic, hence commutative.

(Keeping `H₀/U` commutative as a *lemma* rather than an instance avoids building a second,
definitionally equal `Group` structure on the quotient.)
-/

namespace Work.BG

open Subgroup

variable {G : Type} [Group G] [Finite G]

/-- **`H₀/U` is cyclic** (`quot_cyclic` of `Sec2Ctx`). -/
theorem quotGroup_isCyclic (C : Sec2Ctx G) : IsCyclic (quotGroup C.P) := by
  obtain ⟨c, hc, hgen⟩ := C.quot_cyclic
  refine isCyclic_iff_exists_zpowers_eq_top.mpr ⟨quotMk C.P ⟨c, hc⟩, ?_⟩
  rw [Subgroup.eq_top_iff']
  intro x
  obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective (s := C.P.U.subgroupOf C.P.H0) x
  obtain ⟨k, hk⟩ := hgen (y : G) y.2
  have hk' : y * (⟨c, hc⟩ ^ k)⁻¹ ∈ C.P.U.subgroupOf C.P.H0 := by
    rw [Subgroup.mem_subgroupOf]
    have hcoe : (((⟨c, hc⟩ ^ k : ↥C.P.H0)) : G) = c ^ k := by simp
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, hcoe]
    exact hk
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨k, ?_⟩
  rw [← map_zpow]
  exact QuotientGroup.eq.mpr (C.U_normal.mem_comm_iff.mp hk')

/-- **`H₀/U` is commutative** (it is cyclic). -/
theorem mul_comm_quotGroup (C : Sec2Ctx G) (x y : quotGroup C.P) : x * y = y * x := by
  haveI := quotGroup_isCyclic C
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := quotGroup C.P)
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg x)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg y)
  rw [← hm, ← hn, ← zpow_add, ← zpow_add, add_comm]

end Work.BG
