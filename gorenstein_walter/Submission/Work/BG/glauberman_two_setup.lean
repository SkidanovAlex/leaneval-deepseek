import Mathlib
import Submission.Work.BG.Defs
import Submission.Work.BG.CharBridge

/-!
# Setup for `Work.BG.glauberman_two` (Glauberman's theorem, `|A| = 2`)

This file provides the ambient semidirect product `Γ = U ⋊ ⟨σ⟩` attached to an involutive
automorphism `σ` of a group `U`, together with the elementary API used by the proof of
`Work.BG.glauberman_two` (Glauberman, *Correspondences of characters for relatively prime
operator groups*, Canad. J. Math. **20** (1968), Theorem 3, in the case `|A| = 2`).

* `Work.BG.Gam σ` — the semidirect product `U ⋊ ⟨σ⟩`, where `⟨σ⟩ ≤ MulAut U` is the cyclic
  subgroup generated by `σ`;
* `Work.BG.Gam.iot σ` — the canonical inclusion `U →* Gam σ`;
* `Work.BG.Gam.gInv σ` — the involution of `Gam σ` corresponding to `σ`;
* `Work.BG.fixedSubgroup σ` (from `Defs.lean`) — the fixed-point subgroup `C_U(σ)`.

The key structural facts are `gInv_mul_iot` (conjugation by the involution realizes `σ` on
`U`) and `gInv_mul_self` (the involution is an involution).
-/

open scoped BigOperators

namespace Work.BG

variable {U : Type} [Group U]

/-- The semidirect product `U ⋊ ⟨σ⟩` attached to an automorphism `σ` of `U`.  The acting
group is the cyclic subgroup `⟨σ⟩ ≤ MulAut U`, acting tautologically on `U`. -/
abbrev Gam (σ : MulAut U) : Type :=
  SemidirectProduct U (Subgroup.zpowers σ) (Subgroup.subtype (Subgroup.zpowers σ))

namespace Gam

variable {σ : MulAut U}

instance : Group (Gam σ) := inferInstance

/-- The canonical inclusion `U →* U ⋊ ⟨σ⟩`. -/
def iot (σ : MulAut U) : U →* Gam σ :=
  SemidirectProduct.inl

@[simp] theorem iot_apply (σ : MulAut U) (u : U) :
    iot σ u = SemidirectProduct.inl u := rfl

theorem iot_injective (σ : MulAut U) : Function.Injective (iot σ) :=
  SemidirectProduct.inl_injective

@[simp] theorem iot_mul (σ : MulAut U) (u v : U) :
    iot σ (u * v) = iot σ u * iot σ v := map_mul (iot σ) u v

@[simp] theorem iot_one (σ : MulAut U) : iot σ 1 = 1 := map_one (iot σ)

@[simp] theorem iot_inv (σ : MulAut U) (u : U) : iot σ u⁻¹ = (iot σ u)⁻¹ :=
  map_inv (iot σ) u

/-- `σ` viewed as an element of the acting group `⟨σ⟩`. -/
def gen (σ : MulAut U) : Subgroup.zpowers σ :=
  ⟨σ, Subgroup.mem_zpowers σ⟩

@[simp] theorem gen_coe (σ : MulAut U) : (gen σ : MulAut U) = σ := rfl

/-- The involution `a` of `Gam σ` corresponding to `σ`. -/
def gInv (σ : MulAut U) : Gam σ :=
  SemidirectProduct.inr (gen σ)

@[simp] theorem gInv_right (σ : MulAut U) : (gInv σ).right = gen σ := rfl

@[simp] theorem gInv_left (σ : MulAut U) : (gInv σ).left = 1 := rfl

/-- Conjugation by the involution `a` realizes the automorphism `σ` on the embedded copy of
`U`. -/
theorem gInv_mul_iot (σ : MulAut U) (u : U) :
    gInv σ * iot σ u * (gInv σ)⁻¹ = iot σ (σ u) := by
  have h := SemidirectProduct.inl_aut (φ := Subgroup.subtype (Subgroup.zpowers σ))
    (g := gen σ) (n := u)
  simpa [iot, gInv, gen] using h.symm

/-- The element `a` is an involution. -/
theorem gInv_mul_self (σ : MulAut U) (hσ : σ * σ = 1) : gInv σ * gInv σ = 1 := by
  have hgen : gen σ * gen σ = 1 := by
    apply Subtype.ext
    exact hσ
  have := congrArg (SemidirectProduct.inr (φ := Subgroup.subtype (Subgroup.zpowers σ))) hgen
  simpa [gInv] using this

theorem gInv_inv (σ : MulAut U) (hσ : σ * σ = 1) : (gInv σ)⁻¹ = gInv σ :=
  inv_eq_of_mul_eq_one_right (gInv_mul_self σ hσ)

/-- Conjugation by the inverse of the involution realizes `σ` on the embedded copy of `U`. -/
theorem gInv_inv_mul_iot (σ : MulAut U) (hσ : σ * σ = 1) (u : U) :
    (gInv σ)⁻¹ * iot σ u * gInv σ = iot σ (σ u) := by
  simpa [gInv_inv σ hσ] using gInv_mul_iot (σ := σ) u

theorem gInv_pow_two (σ : MulAut U) (hσ : σ * σ = 1) : (gInv σ) ^ 2 = 1 := by
  rw [sq, gInv_mul_self σ hσ]

theorem gInv_mul_gInv (σ : MulAut U) (hσ : σ * σ = 1) : gInv σ * gInv σ = 1 :=
  gInv_mul_self σ hσ

end Gam

end Work.BG
