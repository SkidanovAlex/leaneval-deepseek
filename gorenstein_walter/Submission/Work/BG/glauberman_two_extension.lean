import Mathlib
import Submission.Work.BG.glauberman_two_setup
import Submission.Work.BG.CharBridge

/-!
# Glauberman's two-extension lemma (the `|A| = 2` case)

Let `σ` be an involutive automorphism of a finite group `U` and `α ∈ Irr(U)` a `σ`-invariant
irreducible character.  Writing `Γ = U ⋊ ⟨σ⟩` for the semidirect product, this file proves
that `α` extends to an irreducible character `η` of `Γ`, and that the "twisted" coset sum
`∑_{u : U} ‖η (a · ι(u))‖²` (`a` the involution of `Γ`, `ι : U →* Γ` the inclusion) equals
`|U|`.

The extension itself is the cyclic-quotient case of Isaacs' extension theorem
(`OddOrder.RepresentationTheory.IsIrreducibleCharacter.exists_extension_of_conjBy_eq`, Isaacs
Thm 11.22) applied with `H = ι(U) ⊴ Γ` (normal of index at most `2`) and `g = a`: the
`a`-invariance of `α` is exactly the `H`-invariance of the transported character
`θ = α ∘ e⁻¹`.

The norm identity is a consequence of irreducibility alone: for an irreducible character the
sum of `‖·‖²` over the group is the group order, and `Γ` splits as the disjoint union of the
two cosets `ι(U)` and `a·ι(U)` (when `a ∉ ι(U)`, i.e. `σ ≠ 1`).

## Main results

* `Work.BG.Gam.Phi` — the explicit bijection `U × Bool ≃ Γ` with `(u, false) ↦ ι(u)` and
  `(u, true) ↦ a · ι(u)` (for `σ ≠ 1`);
* `Work.BG.Gam.sum_split` — the resulting splitting of a sum over `Γ`;
* `Work.BG.Gam.card_gam` — `|Γ| = 2 |U|` (for `σ ≠ 1`);
* `Work.BG.irreducible_sum_normSq_eq_card` — `∑_g ‖χ g‖² = |G|` for `χ ∈ Irr(G)`;
* `Work.BG.Gam.mem_range_or_inv_mul_mem` — the quotient `Γ/ι(U)` is generated by the image of
  the involution `a` (the hypothesis `hgen` of Isaacs' extension theorem);
* `Work.BG.glauberman_two_extension` — the target statement.
-/

open scoped BigOperators

namespace Work.BG

noncomputable section

/-! ## The general norm identity for irreducible characters -/

/-- For an irreducible character `χ` of a finite group `G` the sum of the squared norms of its
values is the group order: `∑_g ‖χ g‖² = |G|`.  This is the `Prop`-level form of orthonormality
`⟨χ, χ⟩ = 1` (`IsIrreducibleCharacter.inner_self_eq_one`), with `χ g · conj (χ g) = ‖χ g‖²`. -/
theorem irreducible_sum_normSq_eq_card {G : Type*} [Group G] [Finite G] [Fintype G]
    [Invertible (Nat.card G : ℂ)] {χ : OddOrder.RepresentationTheory.ClassFunction G ℂ}
    (hχ : OddOrder.RepresentationTheory.IsIrreducibleCharacter χ) :
    ∑ g : G, ‖χ g‖ ^ 2 = (Nat.card G : ℝ) := by
  have h1 : OddOrder.RepresentationTheory.ClassFunction.inner χ χ = 1 := hχ.inner_self_eq_one
  have h2 : OddOrder.RepresentationTheory.ClassFunction.innerSum χ χ = (Nat.card G : ℂ) := by
    rw [← OddOrder.RepresentationTheory.ClassFunction.card_mul_inner χ χ, h1, mul_one]
  have hpt : ∀ g : G, χ g * star (χ g) = ((‖χ g‖ ^ 2 : ℝ) : ℂ) := by
    intro g
    rw [Complex.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have h3 : ((∑ g : G, ‖χ g‖ ^ 2 : ℝ) : ℂ) = (Nat.card G : ℂ) := by
    rw [← h2, OddOrder.RepresentationTheory.ClassFunction.innerSum]
    rw [show (∑ g : G, χ g * star (χ g)) = ∑ g : G, ((‖χ g‖ ^ 2 : ℝ) : ℂ) from
      Finset.sum_congr rfl fun g _ => hpt g, ← Complex.ofReal_sum Finset.univ
        (fun g : G => ‖χ g‖ ^ 2)]
  exact Complex.ofReal_injective h3

namespace Gam

variable {U : Type} [Group U]

/-! ## The two-element quotient `⟨σ⟩` -/

/-- If `σ` is an involution then the cyclic subgroup it generates has just the two elements
`1` and `σ`; in particular `Subgroup.zpowers σ = {1, gen σ}`. -/
lemma zpowers_eq_one_or_gen {σ : MulAut U} (hσ : σ * σ = 1) (s : Subgroup.zpowers σ) :
    s = 1 ∨ s = gen σ := by
  let K : Subgroup (MulAut U) :=
    { carrier := {x | x = 1 ∨ x = σ}
      one_mem' := Or.inl rfl
      mul_mem' := by
        intro a b ha hb
        rcases ha with ha | ha <;> rcases hb with hb | hb
        · exact Or.inl (by rw [ha, hb, mul_one])
        · exact Or.inr (by rw [ha, hb, one_mul])
        · exact Or.inr (by rw [ha, hb, mul_one])
        · exact Or.inl (by rw [ha, hb, hσ])
      inv_mem' := by
        intro x hx
        rcases hx with hx | hx
        · exact Or.inl (by rw [hx, inv_one])
        · exact Or.inr (by rw [hx, inv_eq_of_mul_eq_one_right hσ]) }
  have hle : Subgroup.zpowers σ ≤ K := Subgroup.zpowers_le.mpr (Or.inr rfl)
  rcases hle s.2 with h | h
  · exact Or.inl (Subtype.ext h)
  · exact Or.inr (Subtype.ext h)

/-- The involution `a = gInv σ` lies in the image of `U` only if `σ` is trivial. -/
lemma gInv_notMem_range {σ : MulAut U} (_hσ : σ * σ = 1) (hne : σ ≠ 1) :
    gInv σ ∉ (iot σ).range := by
  intro h
  have hker : gInv σ ∈ SemidirectProduct.rightHom.ker := by
    rw [← SemidirectProduct.range_inl_eq_ker_rightHom]
    exact h
  have hr : SemidirectProduct.rightHom (gInv σ) = 1 := hker
  rw [gInv, SemidirectProduct.rightHom_inr] at hr
  apply hne
  have := congrArg (fun x : Subgroup.zpowers σ => (x : MulAut U)) hr
  simpa [gen] using this

/-! ## The bijection `U × Bool ≃ Γ` -/

/-- The explicit map `U × Bool → Γ = U ⋊ ⟨σ⟩`: `(u, false) ↦ ι(u)`, `(u, true) ↦ a · ι(u)`. -/
def Phi (σ : MulAut U) : U × Bool → Gam σ
  | (u, false) => iot σ u
  | (u, true) => gInv σ * iot σ u

lemma Phi_injective {σ : MulAut U} (hσ : σ * σ = 1) (hne : σ ≠ 1) :
    Function.Injective (Phi σ) := by
  rintro ⟨u, b⟩ ⟨u', b'⟩ h
  cases b <;> cases b'
  · simp only [Phi] at h
    exact Prod.ext (iot_injective σ h) rfl
  · simp only [Phi] at h
    exact absurd (show gInv σ ∈ (iot σ).range from
      ⟨u * u'⁻¹, by
        have hg : gInv σ = iot σ u * (iot σ u')⁻¹ := by rw [h]; group
        rw [hg, map_mul, map_inv]⟩) (gInv_notMem_range hσ hne)
  · simp only [Phi] at h
    exact absurd (show gInv σ ∈ (iot σ).range from
      ⟨u' * u⁻¹, by
        have hg : gInv σ = iot σ u' * (iot σ u)⁻¹ := by rw [← h]; group
        rw [hg, map_mul, map_inv]⟩) (gInv_notMem_range hσ hne)
  · simp only [Phi] at h
    exact Prod.ext (iot_injective σ (mul_left_cancel h)) rfl

lemma Phi_surjective {σ : MulAut U} (hσ : σ * σ = 1) (_hne : σ ≠ 1) :
    Function.Surjective (Phi σ) := by
  intro k
  have hk : iot σ k.left * SemidirectProduct.inr k.right = k :=
    SemidirectProduct.inl_left_mul_inr_right k
  rcases zpowers_eq_one_or_gen hσ k.right with h | h
  · refine ⟨(k.left, false), ?_⟩
    simp only [Phi]
    have := hk
    rw [h, map_one, mul_one] at this
    exact this
  · refine ⟨(σ k.left, true), ?_⟩
    simp only [Phi]
    have hk'' : iot σ k.left * gInv σ = k := by
      have := hk
      rw [h] at this
      exact this
    have h1 : gInv σ * iot σ (σ k.left) = iot σ k.left * gInv σ := by
      have hgi := gInv_inv_mul_iot σ hσ k.left
      rw [← hgi]
      group
    rw [h1, hk'']

lemma Phi_bijective {σ : MulAut U} (hσ : σ * σ = 1) (hne : σ ≠ 1) :
    Function.Bijective (Phi σ) :=
  ⟨Phi_injective hσ hne, Phi_surjective hσ hne⟩

/-! ## Splitting a sum over `Γ` along the two cosets -/

/-- For `σ ≠ 1` the map `Phi σ` is a bijection, so a sum over `Γ` splits as the sum over the
coset `ι(U)` plus the sum over the coset `a·ι(U)`. -/
lemma sum_split [Fintype U] {σ : MulAut U} (hσ : σ * σ = 1) (hne : σ ≠ 1)
    [Fintype (Gam σ)] (f : Gam σ → ℝ) :
    ∑ g : Gam σ, f g = ∑ u : U, f (iot σ u) + ∑ u : U, f (gInv σ * iot σ u) := by
  let e : U × Bool ≃ Gam σ := Equiv.ofBijective (Phi σ) (Phi_bijective hσ hne)
  calc ∑ g : Gam σ, f g
      = ∑ p : U × Bool, f (e p) := (Equiv.sum_comp e f).symm
    _ = ∑ u : U, ∑ b : Bool, f (e (u, b)) := Fintype.sum_prod_type _
    _ = ∑ u : U, (f (e (u, false)) + f (e (u, true))) := by
          refine Finset.sum_congr rfl (fun u _ => ?_)
          rw [Fintype.sum_bool, add_comm]
    _ = ∑ u : U, f (e (u, false)) + ∑ u : U, f (e (u, true)) := Finset.sum_add_distrib
    _ = ∑ u : U, f (iot σ u) + ∑ u : U, f (gInv σ * iot σ u) := by
          rw [show (∑ u : U, f (e (u, false))) = ∑ u : U, f (iot σ u) from
                Finset.sum_congr rfl (fun u _ => rfl),
              show (∑ u : U, f (e (u, true))) = ∑ u : U, f (gInv σ * iot σ u) from
                Finset.sum_congr rfl (fun u _ => rfl)]

/-- For `σ ≠ 1`, `|Γ| = 2 |U|`. -/
lemma card_gam {σ : MulAut U} (hσ : σ * σ = 1) (hne : σ ≠ 1) :
    Nat.card (Gam σ) = 2 * Nat.card U := by
  have h := Nat.card_congr (Equiv.ofBijective (Phi σ) (Phi_bijective hσ hne))
  rw [show Nat.card (Gam σ) = Nat.card (U × Bool) from h.symm, Nat.card_prod]
  rw [show Nat.card Bool = 2 from by rw [Nat.card_eq_fintype_card, Fintype.card_bool]]
  ring

/-! ## The quotient `Γ/ι(U)` is generated by the image of `a` -/

/-- For every `k : Γ` there is `i : ℤ` with `(a^i)⁻¹ k ∈ ι(U)`.  Equivalently the image of the
involution `a` generates the cyclic quotient `Γ/ι(U)`, which is the hypothesis `hgen` of the
cyclic-extension theorem.  (This holds also when `σ = 1`.) -/
lemma mem_range_or_inv_mul_mem {σ : MulAut U} (hσ : σ * σ = 1) (k : Gam σ) :
    ∃ i : ℤ, ((gInv σ) ^ i)⁻¹ * k ∈ (iot σ).range := by
  have hk : iot σ k.left * SemidirectProduct.inr k.right = k :=
    SemidirectProduct.inl_left_mul_inr_right k
  rcases zpowers_eq_one_or_gen hσ k.right with h | h
  · refine ⟨0, ?_⟩
    rw [zpow_zero, inv_one, one_mul]
    refine ⟨k.left, ?_⟩
    have hink : iot σ k.left = k := by
      have := hk
      rw [h, map_one, mul_one] at this
      exact this
    exact hink
  · refine ⟨1, ?_⟩
    rw [zpow_one]
    have hk'' : iot σ k.left * gInv σ = k := by
      have := hk
      rw [h] at this
      exact this
    rw [← hk'', ← mul_assoc]
    exact ⟨σ k.left, (gInv_inv_mul_iot σ hσ k.left).symm⟩

end Gam

/-! ## The extension theorem -/

theorem glauberman_two_extension {U : Type} [Group U] [Finite U] [Fintype U]
    [Invertible (Nat.card U : ℂ)] (σ : MulAut U) (hσ : σ * σ = 1)
    (α : OddOrder.RepresentationTheory.IrreducibleCharacter U)
    (hα : ∀ u : U, (α : OddOrder.RepresentationTheory.ClassFunction U ℂ) (σ u) =
      (α : OddOrder.RepresentationTheory.ClassFunction U ℂ) u) :
    ∃ η : OddOrder.RepresentationTheory.ClassFunction (Work.BG.Gam σ) ℂ,
      OddOrder.RepresentationTheory.IsIrreducibleCharacter η ∧
      (∀ u : U, η (Work.BG.Gam.iot σ u) = (α : OddOrder.RepresentationTheory.ClassFunction U ℂ) u) ∧
      (∑ u : U, ‖η (Work.BG.Gam.gInv σ * Work.BG.Gam.iot σ u)‖ ^ 2 = (Nat.card U : ℝ)) := by
  classical
  haveI : Fintype (Gam σ) := Fintype.ofFinite _
  haveI : Invertible (Nat.card (Gam σ) : ℂ) :=
    invertibleOfNonzero (Nat.cast_ne_zero.mpr Nat.card_pos.ne')
  -- `ι(U) = ker rightHom` is normal in `Γ`.
  haveI hHnorm : ((Gam.iot σ).range).Normal := by
    rw [Gam.iot, SemidirectProduct.range_inl_eq_ker_rightHom]
    infer_instance
  -- The isomorphism `U ≃ ι(U)` and the transported character `θ`.
  let e : U ≃* ↥((Gam.iot σ).range) := MonoidHom.ofInjective (Gam.iot_injective σ)
  let θ : OddOrder.RepresentationTheory.ClassFunction ↥((Gam.iot σ).range) ℂ :=
    OddOrder.RepresentationTheory.ClassFunction.compHom (e.symm : ↥((Gam.iot σ).range) →* U)
      (α : OddOrder.RepresentationTheory.ClassFunction U ℂ)
  have hθirr : OddOrder.RepresentationTheory.IsIrreducibleCharacter θ :=
    OddOrder.RepresentationTheory.IsIrreducibleCharacter.compHom_of_surjective
      e.symm.surjective α.isIrreducible
  -- `θ` takes the value `α u` at `ι u`.
  have hθAt : ∀ u : U, θ ⟨Gam.iot σ u, ⟨u, rfl⟩⟩ =
      (α : OddOrder.RepresentationTheory.ClassFunction U ℂ) u := by
    intro u
    have hraw := MonoidHom.apply_ofInjective_symm (Gam.iot_injective σ)
      (⟨Gam.iot σ u, ⟨u, rfl⟩⟩ : ↥((Gam.iot σ).range))
    have he : e.symm ⟨Gam.iot σ u, ⟨u, rfl⟩⟩ = u := by
      dsimp only [e]
      exact Gam.iot_injective σ hraw
    have he' : ((e.symm : ↥((Gam.iot σ).range) →* U)) ⟨Gam.iot σ u, ⟨u, rfl⟩⟩ = u := he
    simp only [θ, OddOrder.RepresentationTheory.ClassFunction.compHom_apply, he']
  -- The image of `a` generates the quotient `Γ/ι(U)`.
  have hgen : ∀ k : Gam σ, ∃ i : ℤ, ((Gam.gInv σ) ^ i)⁻¹ * k ∈ (Gam.iot σ).range :=
    fun k => Gam.mem_range_or_inv_mul_mem hσ k
  -- Conjugation by `a` fixes `θ`, because `α` is `σ`-invariant.
  have hinv : OddOrder.RepresentationTheory.ClassFunction.conjBy (Gam.gInv σ) θ = θ := by
    ext h
    obtain ⟨u, hu⟩ := h.2
    rw [OddOrder.RepresentationTheory.ClassFunction.conjBy_apply]
    have hh : h = ⟨Gam.iot σ u, ⟨u, rfl⟩⟩ := Subtype.ext hu.symm
    rw [hh, hθAt u, ← hα u, ← hθAt (σ u)]
    exact congrArg (fun x : ↥((Gam.iot σ).range) => (θ : ↥((Gam.iot σ).range) → ℂ) x)
      (Subtype.ext (by simpa using Gam.gInv_mul_iot σ u))
  -- Isaacs 11.22 (cyclic quotient): `θ` extends to an irreducible character `χ` of `Γ`.
  obtain ⟨χ, hχirr, hχres⟩ :=
    OddOrder.RepresentationTheory.IsIrreducibleCharacter.exists_extension_of_conjBy_eq
      (H := (Gam.iot σ).range) hθirr hgen hinv
  have hχAt : ∀ u : U, χ (Gam.iot σ u) =
      (α : OddOrder.RepresentationTheory.ClassFunction U ℂ) u := by
    intro u
    have h1 := congrArg
      (fun (φ : OddOrder.RepresentationTheory.ClassFunction ↥((Gam.iot σ).range) ℂ) =>
        φ ⟨Gam.iot σ u, ⟨u, rfl⟩⟩) hχres
    simp only [OddOrder.RepresentationTheory.ClassFunction.restrict_apply] at h1
    rw [h1, hθAt u]
  refine ⟨χ, hχirr, hχAt, ?_⟩
  by_cases hσ1 : σ = 1
  · -- Degenerate case `σ = 1`: then `a = 1` and the sum is just the full `U`-sum.
    have hgm : ∀ u : U, Gam.gInv σ * Gam.iot σ u = Gam.iot σ u := by
      intro u
      have hg : Gam.gInv σ = 1 := by
        rw [hσ1, Gam.gInv, show Gam.gen (1 : MulAut U) = 1 from Subtype.ext rfl]
        exact map_one SemidirectProduct.inr
      rw [hg, one_mul]
    calc ∑ u : U, ‖χ (Gam.gInv σ * Gam.iot σ u)‖ ^ 2
        = ∑ u : U, ‖χ (Gam.iot σ u)‖ ^ 2 :=
          Finset.sum_congr rfl (fun u _ => by rw [hgm u])
      _ = ∑ u : U, ‖(α : OddOrder.RepresentationTheory.ClassFunction U ℂ) u‖ ^ 2 :=
          Finset.sum_congr rfl (fun u _ => by rw [hχAt u])
      _ = (Nat.card U : ℝ) := irreducible_sum_normSq_eq_card α.isIrreducible
  · -- Non-degenerate case: split the `Γ`-sum along the two cosets.
    have hsplit := Gam.sum_split (σ := σ) hσ hσ1 (fun g : Gam σ => ‖χ g‖ ^ 2)
    have htot : ∑ g : Gam σ, ‖χ g‖ ^ 2 = (Nat.card (Gam σ) : ℝ) :=
      irreducible_sum_normSq_eq_card hχirr
    have hsub : ∑ u : U, ‖χ (Gam.iot σ u)‖ ^ 2 = (Nat.card U : ℝ) := by
      calc ∑ u : U, ‖χ (Gam.iot σ u)‖ ^ 2
          = ∑ u : U, ‖(α : OddOrder.RepresentationTheory.ClassFunction U ℂ) u‖ ^ 2 :=
            Finset.sum_congr rfl (fun u _ => by rw [hχAt u])
        _ = (Nat.card U : ℝ) := irreducible_sum_normSq_eq_card α.isIrreducible
    have hcard : Nat.card (Gam σ) = 2 * Nat.card U := Gam.card_gam hσ hσ1
    rw [htot, hsub, hcard] at hsplit
    have hcast : ((2 * Nat.card U : ℕ) : ℝ) = 2 * (Nat.card U : ℝ) := by push_cast; ring
    rw [hcast] at hsplit
    linarith

end

end Work.BG
