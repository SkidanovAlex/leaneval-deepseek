import Mathlib

set_option linter.style.haveILetI false

namespace Work.BG

/-- Let `S` be a finite group acting on a finite abelian group `V` (multiplicatively),
`φ : S →* MulAut V`.  Suppose `#S` and `#V` are coprime.  If `v : V` is fixed by the
action and lies in the subgroup generated by the elements `φ s u * u⁻¹` (the images of
the maps "identity minus `s`"), then `v = 1`.

The proof uses the norm (trace) homomorphism `N u = ∏_{s : S} φ s u`.  One checks that
`N (φ s u * u⁻¹) = 1` by reindexing the product along the bijection `t ↦ t*s`; hence `N`
vanishes on the whole subgroup generated by these elements.  On the other hand, for a
fixed point `v` we have `N v = v ^ #S`, so `v ^ #S = 1`, while also `v ^ #V = 1` by
finiteness.  Coprimality of `#S` and `#V` then forces `orderOf v = 1`, i.e. `v = 1`. -/
theorem fixed_eq_one_of_mem_closure {S V : Type*} [Group S] [Finite S] [CommGroup V] [Finite V] (φ : S →* MulAut V) (hcop : Nat.Coprime (Nat.card S) (Nat.card V)) {v : V} (hfix : ∀ s : S, φ s v = v) (hmem : v ∈ Subgroup.closure {w : V | ∃ (u : V) (s : S), φ s u * u⁻¹ = w}) : v = 1 := by
  classical
  letI : Fintype S := Fintype.ofFinite S
  letI : Fintype V := Fintype.ofFinite V
  -- The norm homomorphism `N u = ∏ s, φ s u`.
  let N : V →* V :=
    { toFun := fun u => ∏ s : S, φ s u
      map_one' := by simp
      map_mul' := fun a b => by
        simp only [map_mul]
        exact Finset.prod_mul_distrib }
  -- `N` kills every generator `φ s u * u⁻¹`.
  have key : ∀ (u : V) (s : S), N (φ s u * u⁻¹) = 1 := by
    intro u s
    have h1 : N (φ s u) = N u := by
      show (∏ t : S, φ t (φ s u)) = ∏ t : S, φ t u
      rw [show (∏ t : S, φ t (φ s u)) = ∏ t : S, φ (t * s) u from
            Finset.prod_congr rfl (fun t _ => by
              simp only [← MulAut.mul_apply, ← map_mul])]
      exact Equiv.prod_comp (Equiv.mulRight s) (fun t => φ t u)
    calc N (φ s u * u⁻¹) = N (φ s u) * N (u⁻¹) := map_mul N _ _
      _ = N u * (N u)⁻¹ := by rw [h1, map_inv]
      _ = 1 := mul_inv_cancel _
  -- Hence `N` kills the whole subgroup generated by them.
  have hsub : Subgroup.closure {w : V | ∃ (u : V) (s : S), φ s u * u⁻¹ = w} ≤ N.ker := by
    rw [Subgroup.closure_le]
    intro w hw
    exact MonoidHom.mem_ker.mpr (by obtain ⟨u, s, rfl⟩ := hw; exact key u s)
  have hvker : v ∈ N.ker := hsub hmem
  rw [MonoidHom.mem_ker] at hvker
  -- Evaluate `N` at the fixed point `v`.
  have hNv : N v = v ^ Nat.card S := by
    show (∏ s : S, φ s v) = v ^ Nat.card S
    rw [Finset.prod_congr rfl (fun s _ => hfix s), Finset.prod_const, Finset.card_univ,
      Nat.card_eq_fintype_card]
  rw [hNv] at hvker
  -- Finiteness gives `v ^ #V = 1`.
  have hV : v ^ Nat.card V = 1 := by
    rw [Nat.card_eq_fintype_card]
    exact pow_card_eq_one
  -- Coprimality of `#S` and `#V` forces `orderOf v = 1`.
  have h1 : orderOf v ∣ Nat.card S := orderOf_dvd_iff_pow_eq_one.mpr hvker
  have h2 : orderOf v ∣ Nat.card V := orderOf_dvd_iff_pow_eq_one.mpr hV
  have h3 : orderOf v ∣ 1 := by
    have hh := Nat.dvd_gcd h1 h2
    rwa [Nat.coprime_iff_gcd_eq_one.mp hcop] at hh
  exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp h3)

end Work.BG
