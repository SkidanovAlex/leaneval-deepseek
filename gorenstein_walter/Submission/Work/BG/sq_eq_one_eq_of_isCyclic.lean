import Mathlib
import Submission.Work.BG.Defs

/-!
# Area BG: the `2`-torsion of a finite cyclic group

A finite cyclic group has at most one element of order `2`: if `z, a ≠ 1` both satisfy
`z ^ 2 = 1` and `a ^ 2 = 1`, then `z = a`.  This is the group-theoretic fact behind
Bender–Glauberman's identification of the central involution `t` of the cyclic maximal
subgroup `S₀` of the dihedral Sylow `2`-subgroup `S`.

The proof is self-contained and uses only the elementary theory of `orderOf`, of the cyclic
subgroups `Subgroup.zpowers`, and of the gcd-characterisation
`Subgroup.zpowers_eq_zpowers_iff'` of equal cyclic subgroups of a cyclic group:

* in a finite cyclic group every element is a power of a fixed generator `g`;
* an element `g ^ i` has order `orderOf g / gcd (orderOf g, i.abs)`;
* both `⟨z⟩` and `⟨a⟩` therefore have exactly two elements, and the corresponding power
  subgroups of `⟨g⟩` coincide;
* a group with two elements has exactly one non-identity element.
-/

namespace Work.BG

/-- **A group of at most two elements has at most one non-identity element.**  If `x, y ∈ H`
are distinct from `1`, then `1, x, y` are three distinct elements of `H`, whence `3 ≤ Nat.card H`.

This is the purely elementary pigeonhole step; it uses no cyclicity. -/
private lemma eq_of_ne_one_of_card_le_two {G : Type*} [Group G] [Finite G] {H : Subgroup G}
    (hcard : Nat.card H ≤ 2) {x y : G} (hx : x ∈ H) (hy : y ∈ H)
    (hx1 : x ≠ 1) (hy1 : y ≠ 1) : x = y := by
  by_contra hxy
  have hinj : Function.Injective
      (fun i : Fin 3 => (![(1 : H), ⟨x, hx⟩, ⟨y, hy⟩] : Fin 3 → H) i) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [Subtype.ext_iff]
  have h3 : 3 ≤ Nat.card H := by
    have h := Nat.card_le_card_of_injective _ hinj
    simpa using h
  omega

/-- **The `2`-torsion of a finite cyclic group is trivial or of order two**: two non-identity
elements squaring to `1` in a cyclic group are equal. -/
theorem sq_eq_one_eq_of_isCyclic {C : Type} [Group C] [Finite C] [IsCyclic C] {z a : C}
    (hz : z ≠ 1) (ha : a ≠ 1) (hz2 : z ^ 2 = 1) (ha2 : a ^ 2 = 1) : z = a := by
  -- A generator `g` of `C`, and `z = g ^ i`, `a = g ^ j`.
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := C)
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp (hg z)
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
  -- Elements of order dividing `2` (other than `1`) have order exactly `2`.
  have hzo : orderOf z = 2 := orderOf_eq_prime hz2 hz
  have hao : orderOf a = 2 := orderOf_eq_prime ha2 ha
  have hio : orderOf (g ^ i) = 2 := by rw [hi]; exact hzo
  have hjo : orderOf (g ^ j) = 2 := by rw [hj]; exact hao
  -- `orderOf (g ^ i) = orderOf g / gcd (orderOf g) |i|`.
  have hh1 : orderOf g / (orderOf g).gcd i.natAbs = 2 := by
    rw [← orderOf_zpow g i]; exact hio
  have hh2 : orderOf g / (orderOf g).gcd j.natAbs = 2 := by
    rw [← orderOf_zpow g j]; exact hjo
  -- hence `orderOf g = 2 * gcd (orderOf g) |i|`, and similarly for `j`
  have e1 : orderOf g = 2 * (orderOf g).gcd i.natAbs := by
    have h := Nat.div_mul_cancel (Nat.gcd_dvd_left (orderOf g) i.natAbs)
    rw [hh1] at h
    exact h.symm
  have e2 : orderOf g = 2 * (orderOf g).gcd j.natAbs := by
    have h := Nat.div_mul_cancel (Nat.gcd_dvd_left (orderOf g) j.natAbs)
    rw [hh2] at h
    exact h.symm
  have hgcd : (orderOf g).gcd i.natAbs = (orderOf g).gcd j.natAbs :=
    Nat.mul_left_cancel (n := 2) (by norm_num) (by rw [← e1, ← e2])
  -- so the cyclic subgroups generated by `g ^ i` and `g ^ j` coincide
  have hgi : i.gcd (↑(orderOf g) : ℤ) = (orderOf g).gcd i.natAbs := by
    rw [Int.gcd_eq_natAbs, Int.natAbs_natCast]
    exact Nat.gcd_comm _ _
  have hgj : j.gcd (↑(orderOf g) : ℤ) = (orderOf g).gcd j.natAbs := by
    rw [Int.gcd_eq_natAbs, Int.natAbs_natCast]
    exact Nat.gcd_comm _ _
  have hzpa : Subgroup.zpowers (g ^ i) = Subgroup.zpowers (g ^ j) :=
    (Subgroup.zpowers_eq_zpowers_iff' g i j).mpr (by rw [hgi, hgj]; exact hgcd)
  have hzp : Subgroup.zpowers z = Subgroup.zpowers a := by
    rw [← hi, ← hj]
    exact hzpa
  -- `⟨z⟩ = ⟨a⟩` has two elements, so it has a unique non-identity element
  exact eq_of_ne_one_of_card_le_two (H := Subgroup.zpowers z)
    (by rw [Nat.card_zpowers, hzo])
    (Subgroup.mem_zpowers z)
    (by rw [hzp]; exact Subgroup.mem_zpowers a) hz ha

end Work.BG
