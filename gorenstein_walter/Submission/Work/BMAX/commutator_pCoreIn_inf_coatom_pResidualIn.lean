/-
# BMAX — `[O_p(B) ∩ A, O^p(S)] = ⊥` for an intermediate `E(A) ≤ S ≤ F*(A)`

This file proves

  `Work.BMAX.commutator_pCoreIn_inf_coatom_pResidualIn`,

the statement Bender 1970, §1.7 proves with the word *"obviously"*: for a prime `p`, a subgroup
`B` and a subgroup `S` with

  `E(A) = layerIn A ≤ S ≤ F*(A) = fstarIn A`,   `S ≤ B`,

the `p`-core of `B` intersected with `A` commutes with `O^p(S)`.

## Mathematics

Write `D := O_p(B) ⊓ A`, `E := E(A) = layerIn A` and `F := F(A) = fittingIn A`.  Since
`E ≤ S ≤ F ⊔ E`, every `x ∈ S` is a product `x = f · e` with `f ∈ S ⊓ F`, `e ∈ E` (the join is
the *set product*, as `E ≤ A ≤ N_G(F)` normalises `F`); hence

  `pResidualIn p (S ⊓ F) ⊔ E = pResidualIn p ((S ⊓ F) ⊔ E) ≤ pResidualIn p (S ⊓ F) ⊔ E`,

i.e. `O^p(S) ≤ O^p(S ⊓ F(A)) ⊔ E(A)` — the lemma `pResidualIn_sup_le_of_le_centralizer` with
`H := S ⊓ F(A)`, using `[F(A), E(A)] = 1` (`LayerCentralizesFitting`).

It therefore suffices to show that `D` centralises both summands:

* `D ≤ C_G(O^p(S ⊓ F(A))) ≤ C_G(O^p(B ⊓ F(A)))`: this is the companion lemma
  `commutator_pCoreIn_inf_pResidualIn_fittingIn_eq_bot`, which is pure finite-group theory
  (`O^p` of `B ⊓ F(A)` is generated by `p'`-elements `y` of `B ⊓ F(A)`; for such a `y` the
  commutator `[d,y]` lies in `O_p(F(A))` and in `O^p(F(A))`, and these meet trivially because
  `F(A)` is nilpotent).
* `D ≤ C_G(E(A))`: `D ≤ F(B) ⊓ A`, which is nilpotent (hence solvable) and `E(A)`-invariant
  (`E(A) ≤ B` because `E(A) ≤ S ≤ B`), so Bender's "an `E(A)`-invariant solvable subgroup of
  `A` is centralised by `E(A)`" applies — the companion lemma
  `pCoreIn_inf_le_centralizer_layerIn`.

## Remark

The simplicity of `G`, the coatomicity of `A`, the `D`-group and Sylow hypotheses on `A`, `B`,
the hypothesis `Z(F(A)) ≤ S` and the hypothesis `p ∈ π(F(A))` are **not** used by the argument
(they are part of the requested statement, which is a step of Bender's Lemma 2.3; the statement
is true in the stated generality).  A GAP scan over all groups of order `≤ 200` with all pairs
of subgroups `A`, `B` and all primes confirms the two ingredients.
-/
import Mathlib
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.centralizer_pResidualIn_witness_le
import Submission.Work.BMAX.pResidualIn_inf_pCoreIn_eq_bot_of_isNilpotent
import Submission.Work.BMAX.inf_fittingIn_le_pCoreIn_of_le_pCoreIn
import Submission.Work.BMAX.layerIn_le_centralizer_of_solvable
import Submission.Work.BMAX.LayerCentralizesFitting
import Submission.Work.BMAX.commutator_pCoreIn_pResidualIn_fstarIn
import Submission.Work.BMAX.pResidualIn_sup_le_of_le_centralizer
import Submission.Work.BMAX.commutator_pCoreIn_inf_pResidualIn_fittingIn_eq_bot
import Submission.Work.BMAX.pCoreIn_inf_le_centralizer_layerIn

open scoped Pointwise

namespace Work.BMAX

open Subgroup

set_option linter.unusedVariables false

theorem commutator_pCoreIn_inf_coatom_pResidualIn {G : Type} [Group G] [Finite G]
    (hG : IsSimpleGroup G) (A B S : Subgroup G) (hA : IsCoatom A) (hB : B ≠ ⊤)
    (hA_dih : Work.GW2.DihOrCycSylow A) (hA_D : Work.GW2.IsDGroup A)
    (hB_dih : Work.GW2.DihOrCycSylow B) (hB_D : Work.GW2.IsDGroup B)
    (hSB : S ≤ B) (hSf : S ≤ Work.GW2.fstarIn A)
    (hSl : Work.GW2.layerIn A ≤ S) (hZs : Work.GW2.zcenterIn (Work.GW2.fittingIn A) ≤ S)
    (p : ℕ) (hp : p.Prime) (hpi : p ∈ Work.GW2.primesOf (Work.GW2.fittingIn A)) :
    ⁅Work.GW2.pCoreIn p B ⊓ A, Work.BMAX.pResidualIn p S⁆ = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  -- `E(A) ≤ B`
  have hEB : Work.GW2.layerIn A ≤ B := hSl.trans hSB
  -- `F(A) ⊔ E(A)` is the set product `F(A) * E(A)`, since `E(A)` normalises `F(A)`
  have hFE : ((↑(Work.GW2.fittingIn A ⊔ Work.GW2.layerIn A) : Set G)) =
      (Work.GW2.fittingIn A : Set G) * (Work.GW2.layerIn A : Set G) :=
    Subgroup.coe_mul_of_right_le_normalizer_left _ _
      (le_trans (Work.GW2.layerIn_le_self A) (le_normalizer_fittingIn A))
  -- `S ≤ (S ∩ F(A)) ⊔ E(A)`
  have hS_le : S ≤ (S ⊓ Work.GW2.fittingIn A) ⊔ Work.GW2.layerIn A := by
    intro x hx
    have hx' : x ∈ Work.GW2.fittingIn A ⊔ Work.GW2.layerIn A := by
      rw [← Work.GW2.fstarIn_eq_sup]
      exact hSf hx
    have hx'' : x ∈ (↑(Work.GW2.fittingIn A ⊔ Work.GW2.layerIn A) : Set G) := hx'
    rw [hFE] at hx''
    obtain ⟨f, hf, e, he, hfe⟩ := hx''
    change f * e = x at hfe
    have heS : e ∈ S := hSl he
    have hfS : f ∈ S := by
      have h1 : x * e⁻¹ ∈ S := S.mul_mem hx (S.inv_mem heS)
      rw [← hfe] at h1
      simpa using h1
    exact hfe ▸ Subgroup.mul_mem_sup (S.mem_inf.mpr ⟨hfS, hf⟩) he
  -- `S ∩ F(A) ≤ C_G(E(A))` (from `[E(A), F(A)] = 1`)
  have hcomm : S ⊓ Work.GW2.fittingIn A ≤
      Subgroup.centralizer ((Work.GW2.layerIn A : Subgroup G) : Set G) := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact ((Subgroup.mem_centralizer_iff.mp (LayerCentralizesFitting G A hy) x
      (Subgroup.mem_inf.mp hx).2)).symm
  -- the `p`-residual of `S` lies in `O^p(S ∩ F(A)) ⊔ E(A)`
  have hW_le : Work.BMAX.pResidualIn p S ≤
      Work.BMAX.pResidualIn p (S ⊓ Work.GW2.fittingIn A) ⊔ Work.GW2.layerIn A :=
    le_trans (Work.BMAX.pResidualIn.mono hS_le)
      (pResidualIn_sup_le_of_le_centralizer p hp (S ⊓ Work.GW2.fittingIn A)
        (Work.GW2.layerIn A) hcomm)
  -- `O_p(B) ∩ A` centralises `O^p(S ∩ F(A))`
  have hD_W0 : Work.GW2.pCoreIn p B ⊓ A ≤
      Subgroup.centralizer ((Work.BMAX.pResidualIn p (S ⊓ Work.GW2.fittingIn A) :
        Subgroup G) : Set G) := by
    have hkey := commutator_pCoreIn_inf_pResidualIn_fittingIn_eq_bot A B p hp
    have hDB : Work.GW2.pCoreIn p B ⊓ A ≤
        Subgroup.centralizer ((Work.BMAX.pResidualIn p (B ⊓ Work.GW2.fittingIn A) :
          Subgroup G) : Set G) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp hkey
    have hmono : Work.BMAX.pResidualIn p (S ⊓ Work.GW2.fittingIn A) ≤
        Work.BMAX.pResidualIn p (B ⊓ Work.GW2.fittingIn A) :=
      Work.BMAX.pResidualIn.mono (inf_le_inf_right _ hSB)
    exact le_trans hDB (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr hmono))
  -- `O_p(B) ∩ A` centralises `E(A)`
  have hD_E : Work.GW2.pCoreIn p B ⊓ A ≤
      Subgroup.centralizer ((Work.GW2.layerIn A : Subgroup G) : Set G) :=
    pCoreIn_inf_le_centralizer_layerIn A B p hp hEB
  -- combine
  refine Subgroup.commutator_eq_bot_iff_le_centralizer.mpr ?_
  refine le_trans (le_centralizer_sup_of_le_centralizer hD_W0 hD_E) ?_
  exact Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr hW_le)

end Work.BMAX
