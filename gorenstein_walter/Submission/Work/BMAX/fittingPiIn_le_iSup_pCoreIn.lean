/-
# BMAX — `F_π(B) ≤ ⨆_{q ∈ π} O_q(B)`

The `π`-part `F_π(B) = O_π(F(B))` of the Fitting subgroup is generated by the `q`-cores
`O_q(B)` for `q ∈ π`:

    `F_π(B) ≤ ⨆ (q ∈ π), O_q(B)`.

Mathematically, this is the statement that `F_π(B) = ∏_{q ∈ π} O_q(B)`: inside the finite
*nilpotent* group `F(B)` the largest normal `π`-subgroup is the product of the (unique) Sylow
`q`-subgroups for `q ∈ π`, and each of these is `O_q(F(B)) = O_q(B)` (the latter as `F(B)` is
normal in `B`).

Formally the statement is about the `…In` vocabulary of the area — `F_π(B)` and `O_q(B)` are
the images under `B.subtype` of subgroups of `↥B`.  It therefore suffices to prove the
analogous inclusion inside the group `M := ↥B` and then push it forward along `B.subtype`
(`Subgroup.map_mono` + `Subgroup.map_iSup`).

The argument inside `M` has three ingredients:

* `le_iSup_pCore_of_isPiSubgroup` — in a finite nilpotent group `H`, every normal
  `π`-subgroup `N` lies in `⨆_{q ∈ π} O_q(H)` (a `p`-subgroup of a nilpotent group lies in a
  Sylow `p`-subgroup, which is normal and hence inside `O_p(H)`);
* hence `O_π(F(M)) ≤ ⨆_{q ∈ π} O_q(F(M))` for the nilpotent group `F(M)`;
* pushing forward along `F(M) ↪ M`, each `O_q(F(M))` lands in `O_q(M)` — its image is a normal
  `q`-subgroup of `M`, because `O_q` is *characteristic* (`pCore_characteristic`) inside the
  normal subgroup `F(M)`.

## Relationship to the rest of the tree

There are several copies of the `Work.GW2` vocabulary in this workspace (`ASM/Defs.lean`,
`GLUE/Defs.lean`, `CORE2B/Defs.lean`, …); two of them cannot be imported into one file, so the
few library bridges used here (`O_p` = `opCore`, `F` = `fitting`) are reproved in the local
namespace `Work.BMAX.PiPart` against the canonical copy imported by `Work.BMAX.Defs`
(`Submission.Work.ASM.Defs`).  This module is imported by `Bender17DGroupMain`.
-/
import Mathlib
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Defs

set_option linter.style.haveILetI false

open scoped MatrixGroups

namespace Work.BMAX

open Subgroup

namespace PiPart

/-! ## 1. Bridges to the library's `O_p` and Fitting subgroup -/

/-- The join of the normal `p`-subgroups of `G` is the library's `p`-core `O_p(G)`
(Isaacs, Problem 1B.2). -/
theorem sSup_normal_isPGroup_eq_opCore {M : Type*} [Group M] [Finite M] {p : ℕ} [Fact p.Prime] :
    sSup {N : Subgroup M | N.Normal ∧ IsPGroup p N}
      = OddOrder.Isaacs.Ch01.opCore p M := by
  refine le_antisymm (sSup_le ?_) (le_sSup ?_)
  · rintro N ⟨hN, hpN⟩
    exact OddOrder.Isaacs.Ch01.normal_pgroup_le_opCore (N := N) hpN
  · exact ⟨OddOrder.Isaacs.Ch01.opCore.normal p M,
      OddOrder.Isaacs.Ch01.opCore_isPGroup p M⟩

/-- `Work.GW2.pCore p G` agrees with the library's `O_p(G)`. -/
theorem pCore_eq_opCore {M : Type*} [Group M] [Finite M] {p : ℕ} [Fact p.Prime] :
    Work.GW2.pCore p M = OddOrder.Isaacs.Ch01.opCore p M := by
  rw [Work.GW2.pCore, sSup_normal_isPGroup_eq_opCore]
  exact Subgroup.normalCore_eq_self _

/-- `O_p(G)` is a `p`-group. -/
theorem pCore_isPGroup {M : Type*} [Group M] [Finite M] {p : ℕ} [Fact p.Prime] :
    IsPGroup p ↥(Work.GW2.pCore p M) := by
  rw [pCore_eq_opCore]
  exact OddOrder.Isaacs.Ch01.opCore_isPGroup p M

/-- `O_p(G)` is characteristic in `G`. -/
theorem pCore_characteristic {M : Type*} [Group M] [Finite M] {p : ℕ} [Fact p.Prime] :
    (Work.GW2.pCore p M).Characteristic := by
  rw [pCore_eq_opCore]
  exact OddOrder.Isaacs.Ch01.opCore.characteristic p M

/-- **Universal property of `O_p`.**  Every normal `p`-subgroup lies in `O_p(G)`.
(No finiteness and no primality of `p` are needed; this is just `le_sSup` together with the
maximality of the normal core.) -/
theorem le_pCore_of_normal_isPGroup {M : Type*} [Group M] {p : ℕ} {N : Subgroup M} [N.Normal]
    (hN : IsPGroup p N) : N ≤ Work.GW2.pCore p M :=
  Subgroup.normal_le_normalCore.mpr (le_sSup ⟨‹N.Normal›, hN⟩)

/-- `Work.GW2.fitting G` is the library's Fitting subgroup `⨆ p, O_p(G)`. -/
theorem fitting_eq_isaacsFitting {M : Type*} [Group M] [Finite M] :
    Work.GW2.fitting M = OddOrder.Isaacs.Ch01.fitting M := by
  have hS : sSup {N : Subgroup M | N.Normal ∧ Group.IsNilpotent N}
      = OddOrder.Isaacs.Ch01.fitting M := by
    refine le_antisymm (sSup_le ?_) (le_sSup ?_)
    · rintro N ⟨hN, hnil⟩
      haveI : N.Normal := hN
      haveI : Group.IsNilpotent ↥N := hnil
      exact OddOrder.Isaacs.Ch01.nilpotent_normal_le_fitting
    · exact ⟨OddOrder.Isaacs.Ch01.fitting.normal M,
        OddOrder.Isaacs.Ch01.fitting.isNilpotent⟩
  rw [Work.GW2.fitting, hS]
  exact Subgroup.normalCore_eq_self _

/-! ## 2. The nilpotent `π`-decomposition of `O_π` -/

/-- **Every `p`-subgroup of a finite nilpotent group lies in `O_p`.**  It is contained in some
Sylow `p`-subgroup `Q` (`IsPGroup.exists_le_sylow`); `Q` is normal because `H` is nilpotent, so
the universal property of the `p`-core gives `Q ≤ O_p(H)`. -/
theorem le_pCore_of_isPGroup_of_isNilpotent {H : Type} [Group H] [Finite H]
    [Group.IsNilpotent H] {p : ℕ} [Fact p.Prime] {X : Subgroup H} (hX : IsPGroup p X) :
    X ≤ Work.GW2.pCore p H := by
  obtain ⟨Q, hXQ⟩ := hX.exists_le_sylow
  haveI : (Q : Subgroup H).Normal := OddOrder.Isaacs.Ch01.Sylow.normal_of_isNilpotent Q
  exact hXQ.trans (le_pCore_of_normal_isPGroup (p := p) Q.isPGroup')

/-- **A normal `π`-subgroup of a finite nilpotent group lies in `⨆_{q ∈ π} O_q`.**

`N` is nilpotent (a subgroup of `H`), hence the join of its own Sylow subgroups
(`iSup_default_sylow_eq_top_of_nilpotent`); each of these maps into `H` as a `p`-subgroup and so
lies in `O_p(H)` by `le_pCore_of_isPGroup_of_isNilpotent`, and `p ∈ π` since `N` is a
`π`-subgroup. -/
theorem le_iSup_pCore_of_isPiSubgroup {H : Type} [Group H] [Finite H] [Group.IsNilpotent H]
    (π : Set ℕ) (N : Subgroup H)
    (hNpi : ∀ q ∈ (Nat.card N).primeFactors, q ∈ π) :
    N ≤ ⨆ (q : ℕ) (_ : q ∈ π), Work.GW2.pCore q H := by
  have htop : (⊤ : Subgroup ↥N).map N.subtype = N := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [← htop, ← OddOrder.Isaacs.Ch01.iSup_default_sylow_eq_top_of_nilpotent ↥N,
    Subgroup.map_iSup]
  refine iSup_le ?_
  rintro ⟨p, hp⟩
  haveI : Fact p.Prime := ⟨Nat.prime_of_mem_primeFactors hp⟩
  have hpPi : p ∈ π := hNpi p hp
  have himg : IsPGroup p (((default : Sylow (p : ℕ) ↥N) : Subgroup ↥N).map N.subtype) :=
    IsPGroup.map (default : Sylow (p : ℕ) ↥N).isPGroup' N.subtype
  refine (le_pCore_of_isPGroup_of_isNilpotent himg).trans ?_
  exact (le_iSup (fun (_ : p ∈ π) => Work.GW2.pCore p H) hpPi).trans
    (le_iSup (fun q => ⨆ (_ : q ∈ π), Work.GW2.pCore q H) p)

/-- **`O_π(H) ≤ ⨆_{q ∈ π} O_q(H)` for a finite nilpotent group `H`.**

`O_π(H)` is the normal core of the join of the normal `π`-subgroups of `H`, so it suffices to
place each normal `π`-subgroup of `H` inside the right-hand side
(`le_iSup_pCore_of_isPiSubgroup`). -/
theorem piCore_le_iSup_pCore_of_nilpotent {H : Type} [Group H] [Finite H]
    [Group.IsNilpotent H] (π : Set ℕ) :
    Work.GW2.piCore π H ≤ ⨆ (q : ℕ) (_ : q ∈ π), Work.GW2.pCore q H := by
  rw [Work.GW2.piCore]
  refine (Subgroup.normalCore_le _).trans (sSup_le ?_)
  rintro N ⟨hN, hNpi⟩
  exact le_iSup_pCore_of_isPiSubgroup π N hNpi

/-! ## 3. `F_π(M) ≤ ⨆_{q ∈ π} O_q(M)` in an arbitrary finite group -/

/-- The `π`-part of the Fitting subgroup is the join of the `q`-cores. -/
theorem fittingPi_le_iSup_pCore {M : Type} [Group M] [Finite M] (π : Set ℕ)
    (hπ : ∀ q ∈ π, q.Prime) :
    Work.GW2.fittingPi π M ≤ ⨆ (q : ℕ) (_ : q ∈ π), Work.GW2.pCore q M := by
  haveI hFnil : Group.IsNilpotent ↥(Work.GW2.fitting M) := by
    rw [fitting_eq_isaacsFitting]
    infer_instance
  haveI hFnorm : (Work.GW2.fitting M).Normal := by
    rw [fitting_eq_isaacsFitting]
    infer_instance
  -- `O_π(F(M)) ≤ ⨆_{q ∈ π} O_q(F(M))`, because `F(M)` is nilpotent
  have h1 : Work.GW2.piCore π (Work.GW2.fitting M) ≤
      ⨆ (q : ℕ) (_ : q ∈ π), Work.GW2.pCore q (Work.GW2.fitting M) :=
    piCore_le_iSup_pCore_of_nilpotent π
  -- push forward along `F(M) ↪ M`
  have h2 := Subgroup.map_mono (f := (Work.GW2.fitting M).subtype) h1
  simp only [Subgroup.map_iSup] at h2
  rw [Work.GW2.fittingPi]
  refine h2.trans ?_
  refine iSup_le fun q => iSup_le fun hq => ?_
  haveI : Fact q.Prime := ⟨hπ q hq⟩
  -- `O_q(F(M))` is characteristic in `F(M) ◁ M`, so its image is a normal `q`-subgroup of `M`
  haveI hchar : (Work.GW2.pCore q (Work.GW2.fitting M)).Characteristic := pCore_characteristic
  have hXY : (Work.GW2.pCore q (Work.GW2.fitting M)).map (Work.GW2.fitting M).subtype ≤
      Work.GW2.pCore q M :=
    le_pCore_of_normal_isPGroup (p := q)
      (IsPGroup.map (pCore_isPGroup (M := ↥(Work.GW2.fitting M)) (p := q)) _)
  exact hXY.trans <| (le_iSup (fun (_ : q ∈ π) => Work.GW2.pCore q M) hq).trans
    (le_iSup (fun q' => ⨆ (_ : q' ∈ π), Work.GW2.pCore q' M) q)

end PiPart

/-- **`F_π(B) ≤ ⨆_{q ∈ π} O_q(B)`.**  The `π`-part of the Fitting subgroup is the join of the
`q`-cores, `q ∈ π`.  See the module docstring for the reduction to the group `↥B`. -/
theorem fittingPiIn_le_iSup_pCoreIn {G : Type} [Group G] [Finite G] (B : Subgroup G)
    (π : Set ℕ) (hπ : ∀ q ∈ π, q.Prime) :
    Work.GW2.fittingPiIn π B ≤ ⨆ (q : ℕ) (_ : q ∈ π), Work.GW2.pCoreIn q B := by
  haveI : Finite ↥B := inferInstance
  have hmain := PiPart.fittingPi_le_iSup_pCore (M := ↥B) π hπ
  have hmap := Subgroup.map_mono (f := B.subtype) hmain
  simp only [Subgroup.map_iSup] at hmap
  simpa only [Work.GW2.fittingPiIn, Work.GW2.pCoreIn] using hmap

end Work.BMAX
