import Mathlib
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.fittingPiIn_le_iSup_pCoreIn
import Submission.Work.DSTR.fittingPiIn_eq_iSup_pCoreIn_prime

/-!
# `O^p(S) ∩ O_p(S) = 1` for a finite nilpotent `S`

For a finite nilpotent group `H` and a prime `p`, the `p`-residual `O^p(H)` (the subgroup
generated by the elements of order prime to `p`) meets the `p`-core `O_p(H)` only in `1`.

Mathematically: a finite nilpotent group is the direct product of its Sylow subgroups, so
`O_p(H)` is the Sylow `p`-subgroup while `O^p(H)` is the product of the remaining Sylow
subgroups.

Formally the argument is split as

* `pResidual_le_piCore_of_isNilpotent` : `O^p(H) ≤ O_π(H)` for `π = {q prime | q ≠ p}`.
  A generator `x` of `O^p(H)` (an element of order prime to `p`) spans a cyclic subgroup
  `⟨x⟩` which is a `π`-subgroup; in a finite nilpotent group every `π`-subgroup lies in the
  join of the prime cores `O_q(H)`, `q ∈ π`
  (`Work.BMAX.PiPart.le_iSup_pCore_of_isPiSubgroup`), and each of these is a normal
  `π`-subgroup, hence lies in `O_π(H)`.
* `piCore_inf_pCore_eq_bot_of_prime` : `O_π(H) ∩ O_p(H) = 1`.  Here no nilpotency is needed:
  `O_π(H)` is a `π`-subgroup, `O_p(H)` is a `p`-group, and `p ∉ π`, so the two have coprime
  orders (`OddOrder.Isaacs.Ch03.Subgroup.IsPiGroup.inf_eq_bot_of_isPGroup_not_mem`).

The main theorem is then the `…In` version, obtained by transporting along the injective map
`↥S → G`.
-/

set_option linter.style.haveILetI false
set_option maxHeartbeats 1600000

namespace Work.BMAX

open Subgroup

noncomputable section

/-- The set of primes different from `p`. -/
def primesNe (p : ℕ) : Set ℕ := {q : ℕ | q.Prime ∧ q ≠ p}

/-- **`O^p(H) ≤ O_π(H)`** for a finite nilpotent `H`, where `π` is the set of primes `≠ p`.

Every generator of `O^p(H)` is an element `x` of order prime to `p`; the cyclic group `⟨x⟩` it
spans is a `π`-subgroup, hence (nilpotency) lies in `⨆_{q ∈ π} O_q(H)`, and each `O_q(H)`
(`q ∈ π` prime) is a normal `π`-subgroup, hence lies in `O_π(H)`. -/
theorem pResidual_le_piCore_of_isNilpotent (H : Type) [Group H] [Finite H]
    [Group.IsNilpotent H] {p : ℕ} [Fact p.Prime] :
    Work.BMAX.pResidual p H ≤ Work.GW2.piCore (primesNe p) H := by
  rw [Work.BMAX.pResidual]
  refine (Subgroup.closure_le _).mpr ?_
  rintro x hx
  have hNpi : ∀ q ∈ (Nat.card (Subgroup.zpowers x)).primeFactors, q ∈ primesNe p := by
    intro q hq
    rw [Nat.card_zpowers] at hq
    exact ⟨Nat.prime_of_mem_primeFactors hq,
      fun hqp => hx (hqp ▸ (Nat.mem_primeFactors.mp hq).2.1)⟩
  have h1 : Subgroup.zpowers x ≤
      ⨆ (q : ℕ) (_ : q ∈ primesNe p), Work.GW2.pCore q H :=
    Work.BMAX.PiPart.le_iSup_pCore_of_isPiSubgroup (H := H) (π := primesNe p)
      (N := Subgroup.zpowers x) hNpi
  have h2 : (⨆ (q : ℕ) (_ : q ∈ primesNe p), Work.GW2.pCore q H) ≤
      Work.GW2.piCore (primesNe p) H := by
    refine iSup_le fun q => iSup_le fun hq => ?_
    haveI : Fact q.Prime := ⟨hq.1⟩
    exact Work.DSTR.FittingPiImg.le_piCore_of_normal_isPiSubgroup
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem (G := H) (π := primesNe p)
        (p := q) (X := Work.GW2.pCore q H)
        (Work.BMAX.PiPart.pCore_isPGroup (M := H) (p := q)) hq)
  exact h2 (h1 (Subgroup.mem_zpowers x))

/-- **`O_π(H) ∩ O_p(H) = 1`** where `π` is the set of primes `≠ p`.

`O_π(H)` is a `π`-subgroup and `O_p(H)` is a `p`-group; since `p ∉ π` the two subgroups have
coprime orders, so their intersection is trivial. -/
theorem piCore_inf_pCore_eq_bot_of_prime (H : Type) [Group H] [Finite H] {p : ℕ}
    [Fact p.Prime] :
    Work.GW2.piCore (primesNe p) H ⊓ Work.GW2.pCore p H = ⊥ := by
  refine OddOrder.Isaacs.Ch03.Subgroup.IsPiGroup.inf_eq_bot_of_isPGroup_not_mem
    (G := H) (π := primesNe p) (K := Work.GW2.piCore (primesNe p) H)
    (M := Work.GW2.pCore p H) (p := p)
    (Work.DSTR.FittingPiImg.isPiSubgroup_piCore (primesNe p)) ?_ ?_
  · exact Work.BMAX.PiPart.pCore_isPGroup (M := H)
  · intro h
    exact h.2 rfl

/-- **`O^p(H) ∩ O_p(H) = 1`** for a finite nilpotent group `H` and a prime `p`. -/
theorem pResidual_inf_pCore_eq_bot_of_isNilpotent (H : Type) [Group H] [Finite H]
    [Group.IsNilpotent H] {p : ℕ} [Fact p.Prime] :
    Work.BMAX.pResidual p H ⊓ Work.GW2.pCore p H = ⊥ := by
  refine le_bot_iff.mp ?_
  calc Work.BMAX.pResidual p H ⊓ Work.GW2.pCore p H
      ≤ Work.GW2.piCore (primesNe p) H ⊓ Work.GW2.pCore p H :=
        inf_le_inf (pResidual_le_piCore_of_isNilpotent H) le_rfl
    _ = ⊥ := piCore_inf_pCore_eq_bot_of_prime H

theorem pResidualIn_inf_pCoreIn_eq_bot_of_isNilpotent {G : Type} [Group G] [Finite G]
    (S : Subgroup G) [Group.IsNilpotent ↥S] {p : ℕ} [Fact p.Prime] :
    Work.BMAX.pResidualIn p S ⊓ Work.GW2.pCoreIn p S = ⊥ := by
  rw [Work.BMAX.pResidualIn.eq_map, Work.GW2.pCoreIn,
    ← Subgroup.map_inf (Work.BMAX.pResidual p ↥S) (Work.GW2.pCore p ↥S) S.subtype
      S.subtype_injective]
  rw [pResidual_inf_pCore_eq_bot_of_isNilpotent ↥S, Subgroup.map_bot]

end

end Work.BMAX
