import Mathlib
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Bender17i_dedekind_basic
import Submission.Work.BMAX.centralizer_pResidualIn_witness_le
import Submission.Work.BMAX.pResidualIn_inf_pCoreIn_eq_bot_of_isNilpotent
import Submission.Work.BMAX.fittingPiIn_le_iSup_pCoreIn

/-!
# `O_p(A) ∩ O^p(F(A)) = 1`

The target of this file is

`Work.BMAX.pCoreIn_inf_pResidualIn_fittingIn_eq_bot`:
for a finite group `G`, a subgroup `A`, and a prime `p`,
`O_p(A) ⊓ O^p(F(A)) = 1`.

## Mathematics

`F(A)` is the Fitting subgroup of `A` (nilpotent by Fitting's theorem) and `O^p(F(A))` is the
subgroup of `F(A)` generated by the elements of order prime to `p`.  Since `O^p(F(A)) ≤ F(A)`,

`O_p(A) ∩ O^p(F(A)) ≤ O_p(A) ∩ F(A) = O_p(F(A))`,

and `O^p(H) ∩ O_p(H) = 1` for a finite *nilpotent* group `H`
(`Work.BMAX.pResidualIn_inf_pCoreIn_eq_bot_of_isNilpotent`), applied to `H = F(A)`, gives the
claim.

The only group theory needed is the identification `O_p(A) ∩ F(A) = O_p(F(A))`: `O_p(A)` is
the largest normal `p`-subgroup of `A`, `O_p(F(A))` is characteristic in the normal subgroup
`F(A) ⊴ A` and hence normal in `A`, so each is contained in the other.  In the form used below
(`pCoreIn_inf_fittingIn_le_pCoreIn_fittingIn`) this is just the statement that a `p`-subgroup
of the finite nilpotent group `F(A)` lies in its `p`-core
(`le_pCoreIn_of_isPGroup_of_isNilpotent`, where no normality is required because `F(A)` is
nilpotent: every `p`-subgroup of a finite nilpotent group lies in the (unique) Sylow
`p`-subgroup, which is normal).
-/

set_option linter.style.haveILetI false

namespace Work.BMAX

open Subgroup

/-- `O_p(K)` is a `p`-group. -/
theorem isPGroup_pCoreIn_of_finite {G : Type} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (K : Subgroup G) : IsPGroup p ↥(Work.GW2.pCoreIn p K) := by
  rw [Work.GW2.pCoreIn]
  exact IsPGroup.map (Work.BMAX.PiPart.pCore_isPGroup (M := ↥K) (p := p)) K.subtype

/-- **A `p`-subgroup of a finite nilpotent subgroup `H ≤ G` lies in `O_p(H)`.**

No normality of the `p`-subgroup is needed: in a finite nilpotent group every `p`-subgroup lies
in some Sylow `p`-subgroup, and Sylow subgroups of a nilpotent group are normal, hence inside
the `p`-core (`Work.BMAX.PiPart.le_pCore_of_isPGroup_of_isNilpotent`).  The statement is
transported from the group `↥H` to `G` along the injective map `H.subtype`. -/
theorem le_pCoreIn_of_isPGroup_of_isNilpotent {G : Type} [Group G] [Finite G]
    (H : Subgroup G) [Group.IsNilpotent ↥H] {p : ℕ} [Fact p.Prime] {Y : Subgroup G}
    (hYH : Y ≤ H) (hY : IsPGroup p ↥Y) : Y ≤ Work.GW2.pCoreIn p H := by
  -- transport `Y` to a subgroup of `↥H`, keeping the `p`-group property
  have hcm : IsPGroup p ↥(Subgroup.comap H.subtype Y) :=
    IsPGroup.of_equiv hY (Subgroup.subgroupOfEquivOfLe hYH).symm
  have hle : Subgroup.comap H.subtype Y ≤ Work.GW2.pCore p ↥H :=
    Work.BMAX.PiPart.le_pCore_of_isPGroup_of_isNilpotent hcm
  have hmap : Subgroup.map H.subtype (Subgroup.comap H.subtype Y) = Y :=
    Subgroup.map_comap_eq_self (by rw [Subgroup.subtype_range]; exact hYH)
  calc Y = Subgroup.map H.subtype (Subgroup.comap H.subtype Y) := hmap.symm
    _ ≤ Subgroup.map H.subtype (Work.GW2.pCore p ↥H) := Subgroup.map_mono hle
    _ = Work.GW2.pCoreIn p H := rfl

/-- `O_p(A) ⊓ F(A) ≤ O_p(F(A))`: a `p`-subgroup of `A` lying in the Fitting subgroup (in
particular `O_p(A)` itself) lies in the `p`-core of the nilpotent group `F(A)`. -/
theorem pCoreIn_inf_fittingIn_le_pCoreIn_fittingIn {G : Type} [Group G] [Finite G]
    (A : Subgroup G) (p : ℕ) [Fact p.Prime] :
    Work.GW2.pCoreIn p A ⊓ Work.GW2.fittingIn A ≤
      Work.GW2.pCoreIn p (Work.GW2.fittingIn A) := by
  haveI := isNilpotent_fittingIn A
  exact le_pCoreIn_of_isPGroup_of_isNilpotent (Work.GW2.fittingIn A) inf_le_right
    ((isPGroup_pCoreIn_of_finite p A).to_le inf_le_left)

/-- **`O_p(A) ∩ O^p(F(A)) = 1`.**

`O^p(F(A))` lies in the Fitting subgroup `F(A)`, so the intersection lies in
`O_p(A) ⊓ F(A) ≤ O_p(F(A))`, and the `p`-residual and the `p`-core of the finite *nilpotent*
group `F(A)` are disjoint. -/
theorem pCoreIn_inf_pResidualIn_fittingIn_eq_bot {G : Type} [Group G] [Finite G]
    (A : Subgroup G) (p : ℕ) (hp : p.Prime) :
    Work.GW2.pCoreIn p A ⊓ Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI := isNilpotent_fittingIn A
  -- `O_p(F(A)) ⊓ O^p(F(A)) = 1`
  have hmain : Work.GW2.pCoreIn p (Work.GW2.fittingIn A) ⊓
      Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) = ⊥ := by
    rw [inf_comm]
    exact Work.BMAX.pResidualIn_inf_pCoreIn_eq_bot_of_isNilpotent (Work.GW2.fittingIn A) (p := p)
  -- `O^p(F(A)) ≤ F(A)`
  have hRF : Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) ≤ Work.GW2.fittingIn A :=
    Work.BMAX.pResidualIn.le (Work.GW2.fittingIn A)
  refine le_bot_iff.mp ?_
  calc Work.GW2.pCoreIn p A ⊓ Work.BMAX.pResidualIn p (Work.GW2.fittingIn A)
      ≤ (Work.GW2.pCoreIn p A ⊓ Work.GW2.fittingIn A) ⊓
          Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) :=
        le_inf (le_inf inf_le_left (inf_le_right.trans hRF)) inf_le_right
    _ ≤ Work.GW2.pCoreIn p (Work.GW2.fittingIn A) ⊓
          Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) :=
        inf_le_inf_right _ (pCoreIn_inf_fittingIn_le_pCoreIn_fittingIn A p)
    _ = ⊥ := hmain

end Work.BMAX
