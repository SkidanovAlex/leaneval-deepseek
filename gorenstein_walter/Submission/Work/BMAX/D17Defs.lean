/-
# BMAX — `O^p(·)`, the `p`-residual, and the elementary API of Bender 1970, 1.7

Bender 1970, 1.7 is stated with the two subgroups `O^p(S)` and `O^p(F*(A))` (the subgroups
generated by the elements of order prime to `p`).  This file introduces that notion in the
vocabulary of the area (`Work.GW2`):

* `pResidual p X = ⟨{x : X | ¬ p ∣ orderOf x}⟩` on an abstract group `X`,
* `pResidualIn p K = ⟨{x : G | x ∈ K ∧ ¬ p ∣ orderOf x}⟩` for a subgroup `K` of an ambient `G`
  (the two agree as subgroups of `G`, `pResidualIn_eq_map`),

and records its elementary properties: normality in `K`, monotonicity, `O^p = ⊤` for a `p'`-group,
and the membership form.

The file also contains the general (group-theoretic, `D`-group-free) tool used throughout the
proof of 1.7:

* `le_coatom_of_le_normalizer_of_ne_bot` — the "maximality + simplicity" step: if `⊥ ≠ N ≤ A` is
  normalized by a coatomic subgroup `A` of a simple group `G`, then any subgroup `M ≤ G`
  normalizing `N` lies in `A` (otherwise `⟨A, M⟩ = ⊤` would make `N` normal in `G`).
-/
import Mathlib
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic

set_option linter.style.haveILetI false

namespace Work.BMAX

open Subgroup

/-! ## 0. Two elementary lemmas about conjugation -/

/-- The order of a conjugate. -/
theorem orderOf_conj_eq {G : Type*} [Group G] (g y : G) : orderOf (g * y * g⁻¹) = orderOf y := by
  rw [show g * y * g⁻¹ = (MulAut.conj g) y from (MulAut.conj_apply g y).symm]
  exact MulEquiv.orderOf_eq (MulAut.conj g) y

/-- The subgroup generated by a set closed under conjugation is normal. -/
theorem closure_normal_of_conj_closed {G : Type*} [Group G] {s : Set G}
    (hs : ∀ g x : G, x ∈ s → g * x * g⁻¹ ∈ s) : (Subgroup.closure s).Normal :=
  Subgroup.Normal.mk fun x hx g =>
    Subgroup.closure_induction (p := fun y _ => g * y * g⁻¹ ∈ Subgroup.closure s)
      (fun y hy => Subgroup.subset_closure (hs g y hy))
      (by simp)
      (fun a b _ _ ha hb => by
        rw [show g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) from by group]
        exact Subgroup.mul_mem _ ha hb)
      (fun a _ ha => by
        rw [show g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ from by group]
        exact Subgroup.inv_mem _ ha)
      hx

/-! ## 1. `O^p(X)` -/

/-- `O^p(X)`: the subgroup of `X` generated by the elements whose order is not divisible
by `p`. -/
noncomputable def pResidual (p : ℕ) (X : Type*) [Group X] : Subgroup X :=
  Subgroup.closure {x : X | ¬ p ∣ orderOf x}

/-- `O^p(K)` for a subgroup `K` of an ambient group, as a subgroup of the ambient group. -/
noncomputable def pResidualIn {G : Type*} [Group G] (p : ℕ) (K : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ K ∧ ¬ p ∣ orderOf x}

namespace pResidual

variable {X : Type*} [Group X] {p : ℕ}

theorem mem_def {x : X} : x ∈ pResidual p X ↔ x ∈ Subgroup.closure {x : X | ¬ p ∣ orderOf x} :=
  Iff.rfl

/-- Every element of `p'`-order lies in `O^p(X)`. -/
theorem subset_closure {x : X} (hx : ¬ p ∣ orderOf x) : x ∈ pResidual p X :=
  Subgroup.subset_closure hx

/-- `O^p(X)` is normal in `X` (conjugation preserves orders). -/
theorem normal (p : ℕ) (X : Type*) [Group X] : (pResidual p X).Normal :=
  closure_normal_of_conj_closed fun g x hx => by
    show ¬ p ∣ orderOf (g * x * g⁻¹)
    rw [orderOf_conj_eq g x]
    exact hx

/-- The `p`-residual of a `p'`-group is the whole group. -/
theorem eq_top_of_card_not_dvd [Finite X] (h : ¬ p ∣ Nat.card X) : pResidual p X = ⊤ := by
  rw [eq_top_iff]
  intro x _
  exact Subgroup.subset_closure fun hx => h (hx.trans (orderOf_dvd_natCard x))

end pResidual

namespace pResidualIn

variable {G : Type*} [Group G] {p : ℕ}

theorem mem_def {K : Subgroup G} {x : G} :
    x ∈ pResidualIn p K ↔ x ∈ Subgroup.closure {y : G | y ∈ K ∧ ¬ p ∣ orderOf y} := Iff.rfl

/-- An element of `K` of order prime to `p` lies in `O^p(K)`. -/
theorem subset_closure {K : Subgroup G} {x : G} (hxK : x ∈ K) (hx : ¬ p ∣ orderOf x) :
    x ∈ pResidualIn p K :=
  Subgroup.subset_closure ⟨hxK, hx⟩

theorem le (K : Subgroup G) : pResidualIn p K ≤ K :=
  (Subgroup.closure_le K).mpr fun _ hx => hx.1

theorem mono {K L : Subgroup G} (h : K ≤ L) : pResidualIn p K ≤ pResidualIn p L :=
  Subgroup.closure_mono fun _ hx => ⟨h hx.1, hx.2⟩

/-- A subgroup of `K` whose elements all have order prime to `p` lies in `O^p(K)`. -/
theorem le_of_le {K M : Subgroup G} (hMK : M ≤ K) (hgen : ∀ x ∈ M, ¬ p ∣ orderOf x) :
    M ≤ pResidualIn p K := fun x hx => subset_closure (hMK hx) (hgen x hx)

/-- `O^p(K)` viewed in the ambient group is the image of `O^p(K)` computed in `K`. -/
theorem eq_map (K : Subgroup G) : pResidualIn p K = (pResidual p ↥K).map K.subtype := by
  refine le_antisymm ?_ ?_
  · -- each generator of `O^p(K)` in the ambient group is the image of a `p'`-element of `K`
    refine (Subgroup.closure_le _).mpr ?_
    rintro x ⟨hxK, hx⟩
    refine Subgroup.mem_map.mpr ⟨⟨x, hxK⟩, Subgroup.subset_closure ?_, rfl⟩
    simpa [Subgroup.orderOf_coe] using hx
  · -- conversely the image of `O^p(K)` is generated by `p'`-elements of `K`
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
    have hle : ({z : ↥K | ¬ p ∣ orderOf z} : Set ↥K) ⊆
        (pResidualIn p K).comap K.subtype := by
      intro z hz
      exact Subgroup.mem_comap.mpr
        (Subgroup.subset_closure ⟨z.2, by simpa [Subgroup.orderOf_coe] using hz⟩)
    have hmem := (Subgroup.closure_le ((pResidualIn p K).comap K.subtype)).mpr hle hy
    exact Subgroup.mem_comap.mp hmem

end pResidualIn

/-! ## 2. The maximality/simplicity step -/

/-- **The coatom argument.**  Let `G` be a finite simple group, `A` a coatomic subgroup, and
`⊥ ≠ N ≤ A` normalized by `A`.  Then every subgroup `M` of `G` normalizing `N` lies in `A`.

Indeed, if `M ≰ A` then `A < A ⊔ M`, so `A ⊔ M = ⊤` because `A` is maximal, and both `A` and `M`
normalize `N`, so `N` is normal in `G` — contradicting simplicity. -/
theorem le_coatom_of_le_normalizer_of_ne_bot {G : Type} [Group G] [Finite G]
    (hG : IsSimpleGroup G) {A N M : Subgroup G} (hA : IsCoatom A) (hNbot : N ≠ ⊥)
    (hNle : N ≤ A) (hA_N : A ≤ Subgroup.normalizer (N : Set G))
    (hM_N : M ≤ Subgroup.normalizer (N : Set G)) : M ≤ A := by
  by_contra hMA
  have hlt : A < A ⊔ M := lt_of_le_of_ne le_sup_left (by
    intro h
    exact hMA (h ▸ le_sup_right))
  have htop : A ⊔ M = ⊤ := (hA.lt_iff).mp hlt
  have hnorm : (⊤ : Subgroup G) ≤ Subgroup.normalizer (N : Set G) := by
    rw [← htop]
    exact sup_le hA_N hM_N
  have hnormal : N.Normal :=
    ⟨fun n hn g => (Subgroup.mem_normalizer_iff.mp (hnorm (Subgroup.mem_top g)) n).mp hn⟩
  rcases hG.eq_bot_or_eq_top_of_normal N with h | h
  · exact hNbot h
  · exact hA.ne_top (top_le_iff.mp (h ▸ hNle))

end Work.BMAX
