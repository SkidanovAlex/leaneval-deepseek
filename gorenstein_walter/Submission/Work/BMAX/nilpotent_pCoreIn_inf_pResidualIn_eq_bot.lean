import Mathlib
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.fittingPiIn_le_iSup_pCoreIn
import Submission.OddOrder.Isaacs.Ch05_Transfer.NilpotentPComplement

set_option linter.style.haveILetI false

/-!
# `O_p(F) ∩ O^p(F) = 1` for a finite nilpotent subgroup `F`

A finite nilpotent group is the direct product of its Sylow subgroups, so for a prime `p`
the `p`-core `O_p(F)` is the (unique) Sylow `p`-subgroup of `F` while the `p`-residual
`O^p(F)` — the subgroup generated by the elements of order prime to `p` — is the product of
the remaining Sylow subgroups.  In particular the two have coprime orders and hence meet
trivially:

  `Work.GW2.pCoreIn p F ⊓ Work.BMAX.pResidualIn p F = ⊥`.

The proof below does not use the Sylow structure explicitly.  Its one structural input is
Isaacs' theorem that a finite nilpotent group has a *normal `p`-complement*: a normal
subgroup `K ⊴ H` of `p'`-order which is complementary to (a therefore unique) Sylow
`p`-subgroup (`OddOrder.Isaacs.Ch05.hasNormalPComplement_of_isNilpotent`).  Then

* `H ⧸ K` is a `p`-group (it is isomorphic to the Sylow `p`-subgroup of `H`), and the
  `p`-residual is the smallest normal subgroup with `p`-group quotient, so `O^p(H) ≤ K`;
  this is `Cores.pResidual_le_of_isPGroup_quotient`, the general (nilpotency-free) step;
* consequently `p ∤ |O^p(H)|`, and since `O_p(H)` is a `p`-group, the intersection
  `O_p(H) ⊓ O^p(H)` has order dividing both a `p`-power and a `p'`-number, hence is `1`
  (`Cores.pResidual_inf_pCore_eq_bot`).

The final statement is the `…In` version, obtained by transporting along the injective map
`↥F → G`.

Everything is self-contained except for the two library lemmas quoted above
(Mathlib's `IsPGroup` API and the odd-order library's normal `p`-complement theorem).
-/

namespace Work.BMAX

open Subgroup

noncomputable section

namespace Cores

/-- **`O^p(H) ≤ K` whenever `H ⧸ K` is a `p`-group** (no finiteness or nilpotency needed).

`O^p(H)` is generated by the elements of order prime to `p`; the image of such an element
in the `p`-group `H ⧸ K` has order dividing both a `p`-power and a `p'`-number, hence is
`1`, so the element lies in `K = ker (H → H ⧸ K)`. -/
theorem pResidual_le_of_isPGroup_quotient {H : Type} [Group H] {p : ℕ} [Fact p.Prime]
    (K : Subgroup H) [K.Normal] (hK : IsPGroup p (H ⧸ K)) :
    Work.BMAX.pResidual p H ≤ K := by
  rw [Work.BMAX.pResidual, Subgroup.closure_le]
  rintro y hy
  by_contra hyK
  have hne : QuotientGroup.mk' K y ≠ 1 := by
    rw [ne_eq, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hyK
  exact hy ((hK.dvd_orderOf hne).trans (orderOf_map_dvd (QuotientGroup.mk' K) y))

/-- **A finite nilpotent group has a normal `p`-complement `K` which contains `O^p`.**

The complement `K` is supplied by (the odd-order library's form of) Isaacs' theorem; it has
`p'`-order, and `H ⧸ K ≃* P` for the (unique) Sylow `p`-subgroup `P`, so `H ⧸ K` is a
`p`-group and `O^p(H) ≤ K` by `pResidual_le_of_isPGroup_quotient`. -/
theorem exists_normal_pComplement (H : Type) [Group H] [Finite H] [Group.IsNilpotent H]
    {p : ℕ} [Fact p.Prime] :
    ∃ K : Subgroup H, K.Normal ∧ ¬ p ∣ Nat.card K ∧ Work.BMAX.pResidual p H ≤ K := by
  obtain ⟨K, hKnorm, hKcomp⟩ :=
    OddOrder.Isaacs.Ch05.hasNormalPComplement_of_isNilpotent (H := H) (p := p)
  haveI : K.Normal := hKnorm
  refine ⟨K, hKnorm, ?_, ?_⟩
  · exact OddOrder.Isaacs.Ch05.not_dvd_card_of_isComplement'_sylow
      (default : Sylow p H) (hKcomp (default : Sylow p H))
  · -- `H ⧸ K` is isomorphic to the Sylow `p`-subgroup, hence a `p`-group
    have hiso : H ⧸ K ≃* ↥((default : Sylow p H) : Subgroup H) :=
      (hKcomp (default : Sylow p H)).symm.QuotientMulEquiv
    exact pResidual_le_of_isPGroup_quotient K
      ((default : Sylow p H).isPGroup'.of_equiv hiso.symm)

/-- **The `p`-residual of a finite nilpotent group has `p'`-order.** -/
theorem not_dvd_card_pResidual (H : Type) [Group H] [Finite H] [Group.IsNilpotent H]
    {p : ℕ} [Fact p.Prime] : ¬ p ∣ Nat.card ↥(Work.BMAX.pResidual p H) := by
  obtain ⟨K, _, hKnd, hle⟩ := exists_normal_pComplement H (p := p)
  exact fun h ↦ hKnd (h.trans (Subgroup.card_dvd_of_le hle))

/-- **`O^p(H) ⊓ O_p(H) = 1` for a finite nilpotent group `H`.**

`O^p(H)` has `p'`-order while `O_p(H)` is a `p`-group, so the intersection is a `p`-group
of order dividing a `p'`-number: its order is `1`. -/
theorem pResidual_inf_pCore_eq_bot (H : Type) [Group H] [Finite H] [Group.IsNilpotent H]
    {p : ℕ} [Fact p.Prime] :
    Work.BMAX.pResidual p H ⊓ Work.GW2.pCore p H = ⊥ := by
  have hnd := not_dvd_card_pResidual H (p := p)
  have hpgr : IsPGroup p ↥(Work.BMAX.pResidual p H ⊓ Work.GW2.pCore p H) :=
    (Work.BMAX.PiPart.pCore_isPGroup (M := H) (p := p)).to_le inf_le_right
  have hnot : ¬ p ∣ Nat.card ↥(Work.BMAX.pResidual p H ⊓ Work.GW2.pCore p H) :=
    fun h ↦ hnd (h.trans (Subgroup.card_dvd_of_le inf_le_left))
  rcases hpgr.card_eq_or_dvd with h | h
  · exact Subgroup.card_eq_one.mp h
  · exact absurd h hnot

end Cores

/-- **`O_p(F) ∩ O^p(F) = 1`** for a finite nilpotent subgroup `F` of a finite group `G`,
in the vocabulary of the area: the `p`-core inside `F` meets the `p`-residual inside `F`
trivially.  The abstract statement is proved in `Cores.pResidual_inf_pCore_eq_bot` and
transported along the injective map `↥F → G`. -/
theorem nilpotent_pCoreIn_inf_pResidualIn_eq_bot {G : Type} [Group G] [Finite G]
    {F : Subgroup G} (hF : Group.IsNilpotent ↥F) {p : ℕ} (hp : p.Prime) :
    Work.GW2.pCoreIn p F ⊓ Work.BMAX.pResidualIn p F = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Group.IsNilpotent ↥F := hF
  haveI : Finite ↥F := inferInstance
  rw [inf_comm, Work.BMAX.pResidualIn.eq_map (p := p) F, Work.GW2.pCoreIn,
    ← Subgroup.map_inf (Work.BMAX.pResidual p ↥F) (Work.GW2.pCore p ↥F) F.subtype
      F.subtype_injective,
    Cores.pResidual_inf_pCore_eq_bot ↥F, Subgroup.map_bot]

end

end Work.BMAX
