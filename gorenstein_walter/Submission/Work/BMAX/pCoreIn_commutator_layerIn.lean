/-
# `[O_q(B), E(A)] = 1` for `q ∈ π(F(A))`  (Bender 1970, §1.7 (ii), layer form)

Target:

  `Work.BMAX.pCoreIn_commutator_layerIn`:
  `G` finite simple, `A` coatomic (maximal), `B ≠ ⊤` with `F*(A) ≤ B`, `q` a prime with
  `q ∈ π(F(A))`  ⟹  `⁅O_q(B), E(A)⁆ = ⊥`.

This is Bender 1970, §1.7 (ii) `[O_p(B), O^p(F*(A))] = 1` combined with the fact that the
layer `E(A)` is perfect, hence `E(A) ≤ O^q(F*(A))` for every prime `q`.

## Mathematics (Bender's proof of §1.7 (ii))

Write `P := O_q(A)`, `V := O_q(B)`, `L := E(A) = layerIn A`.

* `q ∈ π(F(A))` gives `P ≠ 1` (`pCoreIn_eq_bot_iff_not_mem_primesOf`).  Since `P ◁ A ≠ 1` and
  `A` is maximal in a simple group, `N_G(P) = A`; in particular `C_G(P) ≤ A`
  (`le_coatom_of_le_normalizer_of_ne_bot`).
* `L ≤ F*(A) ≤ B`, and `L ≤ C(F(A))` (`LayerCentralizesFitting`), so `[P, L] = 1`.
* `M := V ⊓ A` is solvable (it is a `q`-group) and `L` and `M` normalise each other, so
  `L ≤ C(M)` (`layerIn_le_centralizer_of_solvable`).  As `C_V(P) ≤ C_G(P) ≤ A`, this shows
  that `C_V(P)` is centralised by `L`.
* For every `q'`-subgroup `K ≤ L` the Thompson `P × K` lemma applied to the action of
  `P × K` on the `q`-group `V` gives `[V, K] = 1` (the hypotheses are exactly `[P,K]=1` and
  `C_V(P) ≤ C_V(K)`).
* Since `L` is perfect, `L = O^q(L)` is generated by its `q'`-elements, so `V ≤ C(L)`, i.e.
  `[V, L] = 1`.

## Formalisation

The `P × K` lemma for subgroups acting by conjugation (`thompson_PK_commutator`) is reproduced
here (with a `pcl_` prefix) because the module that originally held it does not currently
compile.  All other ingredients are imported.
-/
import Mathlib
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Bender17i_dedekind_basic
import Submission.Work.BMAX.LayerCentralizesFitting
import Submission.Work.BMAX.layerIn_le_centralizer_of_solvable
import Submission.Work.BMAX.fstarIn_le_pResidualIn_of_notMem_primesOf

set_option maxHeartbeats 800000

namespace Work.BMAX

open Subgroup

/-! ## 0. Elementary API for `pCoreIn` -/

/-- `O_p(K) ≤ K`. -/
theorem pcl_pCoreIn_le_self {G : Type} [Group G] (p : ℕ) (K : Subgroup G) :
    Work.GW2.pCoreIn p K ≤ K :=
  Subgroup.map_subtype_le (H := K) (Work.GW2.pCore p ↥K)

/-- `O_p(K)` is a `p`-group. -/
theorem pcl_isPGroup_pCoreIn {G : Type} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (K : Subgroup G) : IsPGroup p ↥(Work.GW2.pCoreIn p K) := by
  have h : IsPGroup p ↥(Work.GW2.pCore p ↥K) := by
    rw [Work.CORE2A.pCore_eq_opCore (G := ↥K) (p := p)]
    exact OddOrder.Isaacs.Ch01.opCore_isPGroup p ↥K
  rw [Work.GW2.pCoreIn]
  exact h.of_equiv (Subgroup.equivMapOfInjective (Work.GW2.pCore p ↥K) K.subtype
    K.subtype_injective)

/-- The normalizer of an intersection contains the intersection of the normalizers. -/
theorem pcl_normalizer_inf_le {G : Type} [Group G] (X Y : Subgroup G) :
    Subgroup.normalizer (X : Set G) ⊓ Subgroup.normalizer (Y : Set G) ≤
      Subgroup.normalizer ((X ⊓ Y : Subgroup G) : Set G) := by
  intro g hg
  obtain ⟨hgX, hgY⟩ := Subgroup.mem_inf.mp hg
  rw [Subgroup.mem_normalizer_iff] at hgX hgY ⊢
  intro x
  rw [Subgroup.mem_inf, Subgroup.mem_inf]
  exact ⟨fun hx => ⟨(hgX x).mp hx.1, (hgY x).mp hx.2⟩,
         fun hx => ⟨(hgX x).mpr hx.1, (hgY x).mpr hx.2⟩⟩

/-- The layer `E(A) = layerIn A` is generated by its `q'`-elements: `E(A) ≤ O^q(E(A))`.
Each normal quasisimple `E ◁ ↥A` is perfect, hence `E ≤ O^q(E) ≤ O^q(E(A))`. -/
theorem pcl_layerIn_le_pResidualIn_self {G : Type} [Group G] [Finite G] (A : Subgroup G)
    (q : ℕ) (hq : q.Prime) :
    Work.GW2.layerIn A ≤ Work.BMAX.pResidualIn q (Work.GW2.layerIn A) := by
  have hstep : ∀ E : Subgroup ↥A, E.Normal → Work.GW2.IsQuasisimple E →
      E.map A.subtype ≤ Work.BMAX.pResidualIn q (Work.GW2.layerIn A) := by
    intro E hEn hEq
    have hperf : ⁅E.map A.subtype, E.map A.subtype⁆ = E.map A.subtype := by
      rw [← Subgroup.map_commutator, hEq.1]
    have hle : E.map A.subtype ≤ Work.GW2.layerIn A :=
      Subgroup.map_mono (le_sSup (show E ∈ {E : Subgroup ↥A | E.Normal ∧
        Work.GW2.IsQuasisimple E} from ⟨hEn, hEq⟩))
    exact le_trans (Work.BMAX.le_pResidualIn_self_of_perfect q hq hperf)
      (Work.BMAX.pResidualIn.mono hle)
  have hmap : Work.GW2.layerIn A = (Work.GW2.layer ↥A).map A.subtype := rfl
  rw [hmap, Subgroup.map_le_iff_le_comap]
  refine sSup_le fun E hE => ?_
  exact (Subgroup.map_le_iff_le_comap).mp (hstep E hE.1 hE.2)

/-! ## 1. Thompson's `P × K` lemma for subgroups acting by conjugation -/

/-- **Thompson's `P × K` lemma (Bender 1970, 1.1; Isaacs 4.31).**  Let `Q` be a `p`-group
normalised by `B`, and `P, K ≤ B` with `P` a `p`-group, `K` a `p'`-group, `P` and `K`
commuting elementwise, and `K` centralising the `P`-fixed points of `Q`.  Then `K` centralises
`Q`. -/
theorem pcl_thompson_PK_commutator {G : Type} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] {B Q P K : Subgroup G}
    (hQB : Q ≤ B) (hPB : P ≤ B) (hKB : K ≤ B)
    (hQn : B ≤ Subgroup.normalizer (Q : Set G))
    (hQp : IsPGroup p ↥Q) (hPp : IsPGroup p ↥P) (hKc : ¬ p ∣ Nat.card ↥K)
    (hcomm : ∀ x ∈ P, ∀ y ∈ K, x * y = y * x)
    (hfix : ∀ q ∈ Q, (∀ x ∈ P, q * x = x * q) → ∀ y ∈ K, q * y = y * q) :
    ⁅Q, K⁆ = ⊥ := by
  classical
  haveI hQnB : (Q.subgroupOf B).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer hQn
  -- the identification `↥(Q.subgroupOf B) ≃* ↥Q`
  let e : ↥(Q.subgroupOf B) ≃* ↥Q :=
    { toFun := fun x => ⟨(((x : ↥B) : G)), x.2⟩
      invFun := fun x => ⟨⟨(x : G), hQB x.2⟩, x.2⟩
      left_inv := fun x => by ext <;> rfl
      right_inv := fun x => by ext <;> rfl
      map_mul' := fun x y => by ext <;> rfl }
  -- the multiplication map `↥P × ↥K →* ↥B`
  let mult : ↥P × ↥K →* ↥B :=
    { toFun := fun x => ⟨(x.1 : G) * (x.2 : G), B.mul_mem (hPB x.1.2) (hKB x.2.2)⟩
      map_one' := by ext; simp
      map_mul' := by
        intro x y
        apply Subtype.ext
        show ((x.1 : G) * (y.1 : G)) * ((x.2 : G) * (y.2 : G)) =
          (x.1 : G) * (x.2 : G) * ((y.1 : G) * (y.2 : G))
        have hxy : (y.1 : G) * (x.2 : G) = (x.2 : G) * (y.1 : G) :=
          hcomm (y.1 : G) y.1.2 (x.2 : G) x.2.2
        calc ((x.1 : G) * (y.1 : G)) * ((x.2 : G) * (y.2 : G))
            = (x.1 : G) * ((y.1 : G) * (x.2 : G)) * (y.2 : G) := by group
          _ = (x.1 : G) * ((x.2 : G) * (y.1 : G)) * (y.2 : G) := by rw [hxy]
          _ = (x.1 : G) * (x.2 : G) * ((y.1 : G) * (y.2 : G)) := by group }
  -- the conjugation action of `P × K` on `Q` (computed inside `B`)
  let φ : ↥P × ↥K →* MulAut ↥(Q.subgroupOf B) := MulAut.conjNormal.comp mult
  have he_symm_apply : ∀ x : ↥Q, e.symm x = (⟨⟨(x : G), hQB x.2⟩, x.2⟩ : ↥(Q.subgroupOf B)) :=
    fun x => rfl
  have hmult_left : ∀ x : ↥P, mult (x, 1) = (⟨(x : G), hPB x.2⟩ : ↥B) := by
    intro x
    apply Subtype.ext
    show (x : G) * 1 = (x : G)
    simp
  have hmult_right : ∀ y : ↥K, mult (1, y) = (⟨(y : G), hKB y.2⟩ : ↥B) := by
    intro y
    apply Subtype.ext
    show (1 : G) * (y : G) = (y : G)
    simp
  -- the two hypotheses of Isaacs 4.31
  have hfixφ : ∀ g : ↥(Q.subgroupOf B),
      (∀ x : ↥P, (φ (x, 1)) g = g) → ∀ y : ↥K, (φ (1, y)) g = g := by
    intro g hg y
    have hgc : ∀ x ∈ P, ((g : ↥B) : G) * x = x * ((g : ↥B) : G) := by
      intro x hx
      have hpt : MulAut.conjNormal (mult (⟨x, hx⟩, 1)) g = g := hg ⟨x, hx⟩
      rw [hmult_left ⟨x, hx⟩] at hpt
      have hpt' := congrArg (fun z : ↥(Q.subgroupOf B) => (z : ↥B)) hpt
      rw [MulAut.conjNormal_apply] at hpt'
      have hval : x * ((g : ↥B) : G) * x⁻¹ = ((g : ↥B) : G) := by
        have h := congrArg (fun z : ↥B => (z : G)) hpt'
        simpa using h
      calc ((g : ↥B) : G) * x = (x * ((g : ↥B) : G) * x⁻¹) * x := by rw [hval]
        _ = x * ((g : ↥B) : G) := by group
    have hfixg := hfix ((g : ↥B) : G) g.2 hgc (y : G) y.2
    show MulAut.conjNormal (mult (1, y)) g = g
    rw [hmult_right y]
    apply Subtype.ext
    show (((MulAut.conjNormal (⟨(y : G), hKB y.2⟩ : ↥B)) g : ↥(Q.subgroupOf B)) : ↥B) = (g : ↥B)
    rw [MulAut.conjNormal_apply]
    apply Subtype.ext
    show (y : G) * ((g : ↥B) : G) * (y : G)⁻¹ = ((g : ↥B) : G)
    rw [← hfixg]
    group
  have hthom := OddOrder.Isaacs.Ch04.isaacs_thm_4_31_external φ
    (hQp.of_equiv e.symm) hPp hKc hfixφ
  have hthom' : ∀ (y : ↥K) (b : ↥(Q.subgroupOf B)), (φ (1, y)) b = b :=
    (OddOrder.Isaacs.Ch04.actionCommutator_eq_bot_iff_acts_trivially _).mp hthom
  -- conclude
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  intro k hk
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hpt : MulAut.conjNormal (mult (1, ⟨y, hy⟩)) (e.symm ⟨k, hk⟩) = e.symm ⟨k, hk⟩ :=
    hthom' ⟨y, hy⟩ (e.symm ⟨k, hk⟩)
  rw [hmult_right ⟨y, hy⟩] at hpt
  have hpt' := congrArg (fun z : ↥(Q.subgroupOf B) => (z : ↥B)) hpt
  rw [MulAut.conjNormal_apply] at hpt'
  have hval : y * k * y⁻¹ = k := by
    have h := congrArg (fun z : ↥B => (z : G)) hpt'
    rw [he_symm_apply ⟨k, hk⟩] at h
    simpa using h
  calc y * k = (y * k * y⁻¹) * y := by group
    _ = k * y := by rw [hval]

/-! ## 2. The theorem -/

theorem pCoreIn_commutator_layerIn (G : Type) [Group G] [Finite G] (hG : IsSimpleGroup G)
    (A B : Subgroup G) (hA : IsCoatom A) (hB : B ≠ ⊤) (hR : Work.GW2.fstarIn A ≤ B)
    (q : ℕ) (hq : q.Prime) (hqpi : q ∈ Work.GW2.primesOf (Work.GW2.fittingIn A)) :
    ⁅Work.GW2.pCoreIn q B, Work.GW2.layerIn A⁆ = ⊥ := by
  classical
  haveI : Fact q.Prime := ⟨hq⟩
  have hFA : Work.GW2.fittingIn A ≤ B := le_trans (Work.GW2.fittingIn_le_fstarIn A) hR
  have hLA : Work.GW2.layerIn A ≤ B := le_trans (Work.GW2.layerIn_le_fstarIn A) hR
  -- `O_q(A) ≠ ⊥`
  have hPne : Work.GW2.pCoreIn q A ≠ ⊥ := fun hbot =>
    ((Work.BMAX.pCoreIn_eq_bot_iff_not_mem_primesOf A q hq).mp hbot) hqpi
  have hPf : Work.GW2.pCoreIn q A ≤ Work.GW2.fittingIn A := Work.BMAX.pCoreIn_le_fittingIn A hq
  -- `C_G(O_q(A)) ≤ A`
  have hCA : Subgroup.centralizer ((Work.GW2.pCoreIn q A : Subgroup G) : Set G) ≤ A :=
    le_coatom_of_le_normalizer_of_ne_bot hG hA hPne (pcl_pCoreIn_le_self q A)
      (Work.BMAX.le_normalizer_pCoreIn A q)
      (Subgroup.centralizer_le_normalizer _)
  -- `M := O_q(B) ⊓ A` is a `q`-group, hence solvable
  have hMpg : IsPGroup q ↥(Work.GW2.pCoreIn q B ⊓ A : Subgroup G) :=
    IsPGroup.of_equiv
      ((pcl_isPGroup_pCoreIn q B).to_subgroup
        ((Work.GW2.pCoreIn q B ⊓ A : Subgroup G).subgroupOf (Work.GW2.pCoreIn q B)))
      (Subgroup.subgroupOfEquivOfLe (inf_le_left : (Work.GW2.pCoreIn q B ⊓ A : Subgroup G) ≤
        Work.GW2.pCoreIn q B))
  have hMsol : Group.IsSolvable ↥(Work.GW2.pCoreIn q B ⊓ A : Subgroup G) := by
    haveI : Group.IsNilpotent ↥(Work.GW2.pCoreIn q B ⊓ A : Subgroup G) := hMpg.isNilpotent
    exact IsNilpotent.to_isSolvable
  -- `E(A) ≤ C(M)`
  have hEcenM : Work.GW2.layerIn A ≤
      Subgroup.centralizer (((Work.GW2.pCoreIn q B ⊓ A) : Subgroup G) : Set G) :=
    Work.BMAX.layerIn_le_centralizer_of_solvable hMsol
      (le_trans inf_le_right (Work.BMAX.le_normalizer_layerIn A))
      (by
        intro y hy
        refine pcl_normalizer_inf_le _ _ ?_
        rw [Subgroup.mem_inf]
        exact ⟨Work.BMAX.le_normalizer_pCoreIn B q (hLA hy),
          Subgroup.le_normalizer (H := A) (Work.GW2.layerIn_le_self A hy)⟩)
  -- every `q'`-element of `E(A)` centralises `O_q(B)`
  have hgen : ∀ x ∈ Work.GW2.layerIn A, ¬ q ∣ orderOf x →
      x ∈ Subgroup.centralizer ((Work.GW2.pCoreIn q B : Subgroup G) : Set G) := by
    intro x hxL hxq
    have hKle : Subgroup.zpowers x ≤ Work.GW2.layerIn A := Subgroup.zpowers_le.mpr hxL
    have hKB : Subgroup.zpowers x ≤ B := le_trans hKle hLA
    have hKc : ¬ q ∣ Nat.card ↥(Subgroup.zpowers x) := by
      rw [Nat.card_zpowers]; exact hxq
    have hth := pcl_thompson_PK_commutator (p := q) (B := B)
      (Q := Work.GW2.pCoreIn q B) (P := Work.GW2.pCoreIn q A) (K := Subgroup.zpowers x)
      (pcl_pCoreIn_le_self q B) (le_trans hPf hFA) hKB
      (Work.BMAX.le_normalizer_pCoreIn B q)
      (pcl_isPGroup_pCoreIn q B) (pcl_isPGroup_pCoreIn q A) hKc
      (by
        intro a ha b hb
        have hbC := Work.BMAX.LayerCentralizesFitting G A (hKle hb)
        exact (Subgroup.mem_centralizer_iff.mp hbC) a (hPf ha))
      (by
        intro v hvQ hva y hyK
        have hvA : v ∈ A := hCA (Subgroup.mem_centralizer_iff.mpr (fun a ha => (hva a ha).symm))
        have hvM : v ∈ (Work.GW2.pCoreIn q B ⊓ A : Subgroup G) :=
          Subgroup.mem_inf.mpr ⟨hvQ, hvA⟩
        exact (Subgroup.mem_centralizer_iff.mp (hEcenM (hKle hyK))) v hvM)
    have hVC : Work.GW2.pCoreIn q B ≤
        Subgroup.centralizer ((Subgroup.zpowers x : Subgroup G) : Set G) :=
      (Subgroup.commutator_eq_bot_iff_le_centralizer).mp hth
    rw [Subgroup.mem_centralizer_iff]
    intro v hv
    exact ((Subgroup.mem_centralizer_iff.mp (hVC hv)) x (Subgroup.mem_zpowers x)).symm
  -- `E(A) ≤ C(O_q(B))`, since `E(A)` is generated by its `q'`-elements
  have hres : Work.BMAX.pResidualIn q (Work.GW2.layerIn A) ≤
      Subgroup.centralizer ((Work.GW2.pCoreIn q B : Subgroup G) : Set G) := by
    rw [Work.BMAX.pResidualIn, Subgroup.closure_le]
    rintro x ⟨hxL, hxq⟩
    exact hgen x hxL hxq
  have hLC : Work.GW2.layerIn A ≤
      Subgroup.centralizer ((Work.GW2.pCoreIn q B : Subgroup G) : Set G) :=
    le_trans (pcl_layerIn_le_pResidualIn_self A q hq) hres
  rw [Subgroup.commutator_comm]
  exact (Subgroup.commutator_eq_bot_iff_le_centralizer).mpr hLC

end Work.BMAX
