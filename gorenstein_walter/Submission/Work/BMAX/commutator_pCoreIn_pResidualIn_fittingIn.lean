/-
# BMAX — Bender 1970, §1.7 (ii), Fitting half: `[O_p(B), O^p(F(A))] = 1`

Target of this file:

  `Work.BMAX.commutator_pCoreIn_pResidualIn_fittingIn`:
  `G` finite simple, `A` coatomic, `B ≠ ⊤` with `F(A) ≤ B`, `p` a prime with
  `p ∈ π(F(A))`  ⟹  `⁅O_p(B), O^p(F(A))⁆ = ⊥`.

This is the "Fitting half" of Bender 1970, 1.7 (ii) (`⁅O_p(B), O^p(F*(A))⁆ = 1`), taken
with the witnessing subgroup `S = F(A) ⊆ F*(A)`; the layer half
`⁅O_p(B), E(A)⁆ = ⊥` is `Work.BMAX.pCoreIn_commutator_layerIn`.

## Mathematics (Bender's proof, adapted to the Fitting part)

Write `V := O_p(B)`, `P := O_p(A)`, `F := F(A)`, `R := O^p(F)`.

* `p ∈ π(F(A))` gives `P ≠ 1`; `P ◁ A ≠ 1` and `A` maximal in a simple group force
  `N_G(P) = A`, hence `C_G(P) ≤ A`.
* Since `F` is nilpotent, `[P, R] = 1` and `P ∩ R = 1` (`O_p(F) ∩ O^p(F) = 1`); the latter is
  `Work.BMAX.pCoreIn_inf_pResidualIn_fittingIn_eq_bot` (proved in its own module).
* Thompson's `P × K` lemma applied to the action of `P × K` on the `p`-group `V`, for every
  cyclic `p'`-subgroup `K = ⟨x⟩ ≤ R`, yields `[V, K] = 1`: the two hypotheses are
  * `P` commutes with `K` (nilpotency of `F`, and `p ∤ orderOf x`), and
  * `K` centralises `C_V(P)`: indeed `C_V(P) ≤ C_G(P) ≤ A`, and for `v ∈ C_V(P)`,
    `x ∈ R` the commutator `⁅v, x⁆` lies in `V` (as `V ◁ B`) and in `A ∩ F` (as
    `v, x ∈ A`), so `⁅v, x⁆ ∈ V ∩ F ≤ O_p(A)`, while also `⁅v, x⁆ ∈ R` (as `R ◁ A`).
    Hence `⁅v, x⁆ ∈ O_p(A) ∩ O^p(F) = 1`.
* `R` is generated by its `p'`-elements, so `V ≤ C_G(R)`, i.e. `[V, R] = 1`.
-/
import Mathlib
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic
import Submission.Work.BMAX.Bender17i_dedekind_basic
import Submission.Work.BMAX.centralizer_pResidualIn_witness_le
import Submission.Work.BMAX.pCoreIn_commutator_layerIn
import Submission.Work.BMAX.pResidualIn_inf_pCoreIn_eq_bot_of_isNilpotent
import Submission.Work.BMAX.inf_fittingIn_le_pCoreIn_of_le_pCoreIn
import Submission.Work.BMAX.pCoreIn_eq_bot_iff_not_mem_primesOf
import Submission.Work.BMAX.pCoreIn_inf_pResidualIn_fittingIn_eq_bot
import Submission.OddOrder.Isaacs.Ch04_Commutators.Main

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.BMAX

open Subgroup

theorem commutator_pCoreIn_pResidualIn_fittingIn {G : Type} [Group G] [Finite G]
    (hG : IsSimpleGroup G) (A B : Subgroup G) (hA : IsCoatom A) (hB : B ≠ ⊤)
    (hR : Work.GW2.fittingIn A ≤ B)
    (p : ℕ) (hp : p.Prime) (hpi : p ∈ Work.GW2.primesOf (Work.GW2.fittingIn A)) :
    ⁅Work.GW2.pCoreIn p B, Work.BMAX.pResidualIn p (Work.GW2.fittingIn A)⁆ = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI hFnil : Group.IsNilpotent ↥(Work.GW2.fittingIn A) := Work.BMAX.isNilpotent_fittingIn A
  set V : Subgroup G := Work.GW2.pCoreIn p B with hV
  set R : Subgroup G := Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) with hRdef
  set P : Subgroup G := Work.GW2.pCoreIn p A with hP
  -- `P ≠ ⊥`, because `p ∈ π(F(A))`
  have hPne : P ≠ ⊥ := by
    rw [hP]
    intro hbot
    exact ((Work.BMAX.pCoreIn_eq_bot_iff_not_mem_primesOf A p hp).mp hbot) hpi
  -- `C_G(P) ≤ A`
  have hCA : Subgroup.centralizer (P : Set G) ≤ A :=
    Work.BMAX.le_coatom_of_le_normalizer_of_ne_bot hG hA hPne
      (by rw [hP]; exact Work.BMAX.pcl_pCoreIn_le_self p A)
      (by rw [hP]; exact Work.BMAX.le_normalizer_pCoreIn A p)
      (Subgroup.centralizer_le_normalizer _)
  -- basic containments
  have hPf : P ≤ Work.GW2.fittingIn A := by
    rw [hP]; exact Work.BMAX.pCoreIn_le_fittingIn A hp
  have hPB : P ≤ B := le_trans hPf hR
  have hRF : R ≤ Work.GW2.fittingIn A := by
    rw [hRdef]; exact Work.BMAX.pResidualIn.le _
  have hRB : R ≤ B := le_trans hRF hR
  have hVB : V ≤ B := by rw [hV]; exact Work.BMAX.pcl_pCoreIn_le_self p B
  have hBV : B ≤ Subgroup.normalizer (V : Set G) := by
    rw [hV]; exact Work.BMAX.le_normalizer_pCoreIn B p
  have hAR : A ≤ Subgroup.normalizer (R : Set G) := by
    rw [hRdef]
    exact Work.BMAX.le_normalizer_pResidualIn_of_le_normalizer (Work.BMAX.le_normalizer_fittingIn A)
  -- `P ∩ R = ⊥` (`O_p(A) ∩ O^p(F(A)) = 1`)
  have hPR : P ⊓ R = ⊥ := by
    rw [hP, hRdef]
    exact Work.BMAX.pCoreIn_inf_pResidualIn_fittingIn_eq_bot A p hp
  -- the Thompson argument for a `p'`-generator of `R`
  have key : ∀ x : G, x ∈ Work.GW2.fittingIn A → ¬ p ∣ orderOf x →
      x ∈ Subgroup.centralizer (V : Set G) := by
    intro x hxF hxp
    have hxR : x ∈ R := by
      rw [hRdef]; exact Work.BMAX.pResidualIn.subset_closure hxF hxp
    have hKR : Subgroup.zpowers x ≤ R := Subgroup.zpowers_le.mpr hxR
    have hKB : Subgroup.zpowers x ≤ B := le_trans hKR hRB
    have hxA : x ∈ A := Work.GW2.fittingIn_le_self A hxF
    have hxB : x ∈ B := hKB (Subgroup.mem_zpowers x)
    have hth := Work.BMAX.pcl_thompson_PK_commutator (p := p) (B := B) (Q := V) (P := P)
      (K := Subgroup.zpowers x) hVB hPB hKB hBV
      (by rw [hV]; exact Work.BMAX.pcl_isPGroup_pCoreIn p B)
      (by rw [hP]; exact Work.BMAX.pcl_isPGroup_pCoreIn p A)
      (by rw [Nat.card_zpowers]; exact hxp)
      (fun a ha y hy => by
        -- `P` commutes with the `p'`-group `⟨x⟩` (nilpotency of `F(A)`)
        have haF : a ∈ Work.GW2.fittingIn A := hPf ha
        have hyF : y ∈ Work.GW2.fittingIn A := hRF (hKR hy)
        obtain ⟨k, hk⟩ :=
          (IsPGroup.iff_orderOf.mp (by rw [hP]; exact Work.BMAX.pcl_isPGroup_pCoreIn p A))
            (⟨a, ha⟩ : ↥P)
        have haord : orderOf a = p ^ k :=
          (Subgroup.orderOf_coe (⟨a, ha⟩ : ↥P)).trans hk
        have hydiv : orderOf y ∣ orderOf x := by
          have h1 : Subgroup.zpowers y ≤ Subgroup.zpowers x := Subgroup.zpowers_le.mpr hy
          have h2 : Nat.card ↥(Subgroup.zpowers y) ∣ Nat.card ↥(Subgroup.zpowers x) :=
            Subgroup.card_dvd_of_le h1
          rwa [Nat.card_zpowers, Nat.card_zpowers] at h2
        have hycop : Nat.Coprime p (orderOf y) :=
          (Nat.Prime.coprime_iff_not_dvd hp).mpr (fun hd => hxp (hd.trans hydiv))
        have hcop : Nat.Coprime (orderOf a) (orderOf y) := by
          rw [haord]; exact hycop.pow_left k
        have hcommFA := OddOrder.GroupTheory.commute_of_coprime_orderOf_of_isNilpotent
          (L := ↥(Work.GW2.fittingIn A)) (x := (⟨a, haF⟩ : ↥(Work.GW2.fittingIn A)))
          (y := (⟨y, hyF⟩ : ↥(Work.GW2.fittingIn A)))
          (by
            have h1 : orderOf (⟨a, haF⟩ : ↥(Work.GW2.fittingIn A)) = orderOf a :=
              (Subgroup.orderOf_coe (⟨a, haF⟩ : ↥(Work.GW2.fittingIn A))).symm
            have h2 : orderOf (⟨y, hyF⟩ : ↥(Work.GW2.fittingIn A)) = orderOf y :=
              (Subgroup.orderOf_coe (⟨y, hyF⟩ : ↥(Work.GW2.fittingIn A))).symm
            rw [h1, h2]; exact hcop)
        simpa using congrArg (fun z : ↥(Work.GW2.fittingIn A) => (z : G)) hcommFA.eq)
      (fun v hv hvP y hy => by
        -- `C_V(P) ≤ A`, so it centralises `⟨x⟩` (via `P ∩ R = ⊥`)
        have hvC : v ∈ Subgroup.centralizer (P : Set G) :=
          Subgroup.mem_centralizer_iff.mpr (fun a ha => (hvP a ha).symm)
        have hvA : v ∈ A := hCA hvC
        have hconj : x * v * x⁻¹ ∈ V :=
          (Subgroup.mem_normalizer_iff.mp (hBV hxB) v).mp hv
        have hcv : v * x * v⁻¹ * x⁻¹ ∈ V := by
          have h1 : x * v * x⁻¹ * v⁻¹ ∈ V := V.mul_mem hconj (V.inv_mem hv)
          have hinv : (x * v * x⁻¹ * v⁻¹)⁻¹ ∈ V := V.inv_mem h1
          rwa [show (x * v * x⁻¹ * v⁻¹)⁻¹ = v * x * v⁻¹ * x⁻¹ from by group] at hinv
        have hca : v * x * v⁻¹ * x⁻¹ ∈ A :=
          A.mul_mem (A.mul_mem (A.mul_mem hvA hxA) (A.inv_mem hvA)) (A.inv_mem hxA)
        have hcf : v * x * v⁻¹ * x⁻¹ ∈ Work.GW2.fittingIn A :=
          (Work.GW2.fittingIn A).mul_mem
            ((Subgroup.mem_normalizer_iff.mp
              (Work.BMAX.le_normalizer_fittingIn A hvA) x).mp hxF)
            ((Work.GW2.fittingIn A).inv_mem hxF)
        have hcR : v * x * v⁻¹ * x⁻¹ ∈ R :=
          R.mul_mem ((Subgroup.mem_normalizer_iff.mp (hAR hvA) x).mp hxR) (R.inv_mem hxR)
        -- `⁅v,x⁆ ∈ (V ∩ A) ∩ F(A) ≤ O_p(A)`
        have hsub : (V ⊓ A) ⊓ Work.GW2.fittingIn A ≤ P := by
          rw [hP]
          exact Work.BMAX.inf_fittingIn_le_pCoreIn_of_le_pCoreIn A B (V ⊓ A) p hp
            inf_le_left inf_le_right
        have hcP : v * x * v⁻¹ * x⁻¹ ∈ P :=
          hsub (Subgroup.mem_inf.mpr ⟨Subgroup.mem_inf.mpr ⟨hcv, hca⟩, hcf⟩)
        have hcbot : v * x * v⁻¹ * x⁻¹ ∈ P ⊓ R := Subgroup.mem_inf.mpr ⟨hcP, hcR⟩
        rw [hPR] at hcbot
        have hc1 : v * x * v⁻¹ * x⁻¹ = 1 := Subgroup.mem_bot.mp hcbot
        have hqx : v * x = x * v := by
          calc v * x = (v * x * v⁻¹ * x⁻¹) * (x * v) := by group
            _ = x * v := by rw [hc1, one_mul]
        have hz : Subgroup.zpowers x ≤ Subgroup.centralizer ({v} : Set G) :=
          Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr hqx.symm)
        exact (Subgroup.mem_centralizer_singleton_iff.mp (hz hy)).symm)
    have hVc : V ≤ Subgroup.centralizer ((Subgroup.zpowers x : Subgroup G) : Set G) :=
      (Subgroup.commutator_eq_bot_iff_le_centralizer).mp hth
    rw [Subgroup.mem_centralizer_iff]
    intro v hv
    exact ((Subgroup.mem_centralizer_iff.mp (hVc hv)) x (Subgroup.mem_zpowers x)).symm
  -- `R` is generated by its `p'`-elements
  rw [Subgroup.commutator_comm, Subgroup.commutator_eq_bot_iff_le_centralizer]
  rw [hRdef, Work.BMAX.pResidualIn, Subgroup.closure_le]
  rintro x ⟨hxF, hxp⟩
  exact key x hxF hxp

end Work.BMAX
