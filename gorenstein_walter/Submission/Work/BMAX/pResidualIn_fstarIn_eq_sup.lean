/-
# BMAX — `O^p(F*(A)) = O^p(F(A))·E(A)`

The main theorem of this file is

  `Work.BMAX.pResidualIn_fstarIn_eq_sup` :
    `O^p(F*(A)) = O^p(F(A)) ⊔ E(A)`

for every subgroup `A` of a finite group and every prime `p`.

## Mathematics

Write `F = F(A)` (the Fitting subgroup, nilpotent) and `E = E(A)` (the layer, a join of
quasisimple subgroups) and `F* = F ⊔ E`.

* `⊇`: `O^p(F(A)) ≤ O^p(F*(A))` by monotonicity of `O^p`, and `E(A) ≤ O^p(F*(A))` because
  `E(A)` is perfect and a finite perfect group is generated by its `q'`-elements for every
  prime `q` (this is `Work.BMAX.layerIn_le_pResidualIn`, proved in
  `fstarIn_le_pResidualIn_of_notMem_primesOf.lean`).
* `⊆`: this is the content here.  `O^p` is *blind to the ambient group* in the following
  sense: if `X = F·E` with `F, E ◁ X`, then every element of `X` is a product `f·e`, so
  `X/(O^p(F)·E)` is a quotient of `F/O^p(F)`, hence a `p`-group; as `O^p(X)` is generated by
  the elements of `p'`-order, and such an element has trivial image in a `p`-group quotient,
  `O^p(X) ≤ O^p(F)·E`.  This is the general engine `pResidual_le_sup_pResidualIn` proved
  below (for an abstract finite group `X`); it is applied with `X = F*(A)`, `F = F(A)` and
  `E = E(A)` — the transfer of `F(A)`, `E(A)` into `F*(A)` (normality, and `F ⊔ E = ⊤`)
  being supplied by `Work.BMAX.subgroupOf_fstarIn_transfer`.

## Contents

* `pResidualIn_normal` — `O^p(K) ◁ G` when `K ◁ G`;
* `pResidual_le_ker_of_isPGroup` — `O^p(X) ≤ ker φ` for `φ : X →* Y` with `Y` a `p`-group;
* `pResidual_le_sup_pResidualIn` — the engine described above;
* `pResidualIn_fstarIn_eq_sup` — the deliverable.
-/
import Mathlib
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic
import Submission.Work.BMAX.LayerCentralizesFitting
import Submission.Work.BMAX.fstarIn_le_pResidualIn_of_notMem_primesOf
import Submission.Work.BMAX.map_pResidual_subgroupOf_eq
import Submission.Work.BMAX.subgroupOf_fstarIn_transfer

set_option linter.style.haveILetI false

namespace Work.BMAX

open Subgroup

/-! ## 1. `O^p` of a normal subgroup is normal -/

/-- `O^p(K) ◁ G` whenever `K ◁ G`: conjugation by an element of `G` permutes `K` and
preserves the order of an element, hence permutes the `p'`-elements generating `O^p(K)`. -/
theorem pResidualIn_normal {G : Type} [Group G] {K : Subgroup G} (hK : K.Normal) (p : ℕ) :
    (Work.BMAX.pResidualIn p K).Normal := by
  rw [Work.BMAX.pResidualIn]
  refine Work.BMAX.closure_normal_of_conj_closed fun g x hx => ⟨?_, ?_⟩
  · exact hK.conj_mem x hx.1 g
  · rw [Work.BMAX.orderOf_conj_eq g x]
    exact hx.2

/-! ## 2. `O^p` and homomorphisms into `p`-groups -/

/-- If `Y` is a `p`-group then every homomorphism `φ : X →* Y` kills `O^p(X)`: an element of
`p'`-order is mapped to an element whose order divides both that `p'`-order and a power of `p`,
hence to `1`. -/
theorem pResidual_le_ker_of_isPGroup {X : Type} [Group X] {Y : Type} [Group Y] {p : ℕ}
    (hp : p.Prime) (φ : X →* Y) (hY : IsPGroup p Y) : Work.BMAX.pResidual p X ≤ φ.ker := by
  haveI : Fact p.Prime := ⟨hp⟩
  rw [Work.BMAX.pResidual, Subgroup.closure_le]
  intro x hx
  have hx1 : φ x = 1 := by
    rw [← orderOf_eq_one_iff]
    obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf).mp hY (φ x)
    have hdvd : p ^ k ∣ orderOf x := hk ▸ orderOf_map_dvd φ x
    rcases eq_or_ne k 0 with hk0 | hk0
    · rw [hk, hk0, pow_zero]
    · exact absurd (dvd_trans (dvd_pow_self p hk0) hdvd) hx
  exact MonoidHom.mem_ker.mpr hx1

/-! ## 3. The engine: `O^p(X) ≤ O^p(F)·E` when `X = F ⊔ E` -/

/-- **The engine.**  Let `X` be a finite group with normal subgroups `F, E ≤ X` such that
`X = F ⊔ E`.  Then `O^p(X) ≤ O^p(F)·E`.

Indeed, `M := O^p(F) ⊔ E` is normal in `X` (it contains `E`, and `O^p(F) ◁ F ◁ X`), and every
element of `X/M` is the image of an element of `F` (as `X = F·E` and `E ≤ M`); the image of
`f ∈ F` has `p`-power order because `f^{p^k} ∈ O^p(F) ≤ M` for some `k`.  So `X/M` is a
`p`-group, and `pResidual_le_ker_of_isPGroup` applied to `X →* X ⧸ M` gives the claim. -/
theorem pResidual_le_sup_pResidualIn {X : Type} [Group X] [Finite X] {F E : Subgroup X}
    (hF : F.Normal) (hE : E.Normal) (hFE : F ⊔ E = ⊤) (p : ℕ) (hp : p.Prime) :
    Work.BMAX.pResidual p X ≤ Work.BMAX.pResidualIn p F ⊔ E := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : F.Normal := hF
  haveI : E.Normal := hE
  haveI : (Work.BMAX.pResidualIn p F).Normal := pResidualIn_normal hF p
  haveI hM : (Work.BMAX.pResidualIn p F ⊔ E).Normal := Subgroup.sup_normal _ _
  have hpg : IsPGroup p (X ⧸ (Work.BMAX.pResidualIn p F ⊔ E)) := by
    rw [isPGroup_iff_pow_pow_eq_one]
    intro g
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Work.BMAX.pResidualIn p F ⊔ E) g
    have hxFE : x ∈ F ⊔ E := by
      rw [hFE]
      exact Subgroup.mem_top x
    obtain ⟨f, hf, e, he, hfe⟩ := Subgroup.mem_sup_of_normal_right.mp hxFE
    obtain ⟨k, hk⟩ := exists_pow_not_dvd_orderOf p hp (⟨f, hf⟩ : ↥F)
    refine ⟨k, ?_⟩
    have hf' : ((⟨f, hf⟩ : ↥F) ^ p ^ k : ↥F) ∈ Work.BMAX.pResidual p ↥F :=
      Work.BMAX.pResidual.subset_closure hk
    have hmem : (f ^ p ^ k : X) ∈ Work.BMAX.pResidualIn p F := by
      rw [Work.BMAX.pResidualIn.eq_map]
      exact Subgroup.mem_map.mpr ⟨(⟨f, hf⟩ : ↥F) ^ p ^ k, hf', by simp⟩
    have he1 : QuotientGroup.mk' (Work.BMAX.pResidualIn p F ⊔ E) e = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact Subgroup.mem_sup_right he
    have hmk : QuotientGroup.mk' (Work.BMAX.pResidualIn p F ⊔ E) x
        = QuotientGroup.mk' (Work.BMAX.pResidualIn p F ⊔ E) f := by
      rw [← hfe, map_mul, he1, mul_one]
    rw [hmk, ← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact Subgroup.mem_sup_left hmem
  have hcontra := pResidual_le_ker_of_isPGroup hp
    (QuotientGroup.mk' (Work.BMAX.pResidualIn p F ⊔ E)) hpg
  rwa [QuotientGroup.ker_mk'] at hcontra

/-! ## 4. The deliverable -/

theorem pResidualIn_fstarIn_eq_sup {G : Type} [Group G] [Finite G] (A : Subgroup G) {p : ℕ}
    (hp : p.Prime) :
    Work.BMAX.pResidualIn p (Work.GW2.fstarIn A)
      = Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) ⊔ Work.GW2.layerIn A := by
  obtain ⟨hFn, hEn, hsup⟩ := Work.BMAX.subgroupOf_fstarIn_transfer A
  refine le_antisymm ?_ ?_
  · -- `O^p(F*(A)) ≤ O^p(F(A)) ⊔ E(A)`: run the engine inside `↥F*(A)` and push down.
    have hmem : (Work.BMAX.pResidual p ↥(Work.GW2.fstarIn A)).map (Work.GW2.fstarIn A).subtype ≤
        (Work.BMAX.pResidualIn p ((Work.GW2.fittingIn A).subgroupOf (Work.GW2.fstarIn A)) ⊔
          (Work.GW2.layerIn A).subgroupOf (Work.GW2.fstarIn A)).map
            (Work.GW2.fstarIn A).subtype :=
      Subgroup.map_mono (f := (Work.GW2.fstarIn A).subtype)
        (pResidual_le_sup_pResidualIn
          (X := ↥(Work.GW2.fstarIn A))
          (F := (Work.GW2.fittingIn A).subgroupOf (Work.GW2.fstarIn A))
          (E := (Work.GW2.layerIn A).subgroupOf (Work.GW2.fstarIn A))
          hFn hEn hsup p hp)
    rw [Work.BMAX.pResidualIn.eq_map (Work.GW2.fstarIn A)]
    refine le_trans hmem ?_
    rw [Subgroup.map_sup]
    have hF' : (Work.BMAX.pResidualIn p
          ((Work.GW2.fittingIn A).subgroupOf (Work.GW2.fstarIn A))).map
            (Work.GW2.fstarIn A).subtype = Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) := by
      have hinner : Work.BMAX.pResidualIn p
            ((Work.GW2.fittingIn A).subgroupOf (Work.GW2.fstarIn A)) =
          (Work.BMAX.pResidual p ↥((Work.GW2.fittingIn A).subgroupOf
            (Work.GW2.fstarIn A))).map
              ((Work.GW2.fittingIn A).subgroupOf (Work.GW2.fstarIn A)).subtype :=
        Work.BMAX.pResidualIn.eq_map _
      rw [hinner, Subgroup.map_map, Work.BMAX.map_pResidual_subgroupOf_eq,
        inf_eq_left.mpr (Work.GW2.fittingIn_le_fstarIn A)]
    have hE' : ((Work.GW2.layerIn A).subgroupOf (Work.GW2.fstarIn A)).map
          (Work.GW2.fstarIn A).subtype = Work.GW2.layerIn A := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr (Work.GW2.layerIn_le_fstarIn A)]
    rw [hF', hE']
  · -- `O^p(F(A)) ⊔ E(A) ≤ O^p(F*(A))`.
    exact sup_le (Work.BMAX.pResidualIn.mono (Work.GW2.fittingIn_le_fstarIn A))
      (Work.BMAX.layerIn_le_pResidualIn A p hp)

end Work.BMAX
