/-
# BMAX — Bender 1970, 1.7(ii): `[O_p(B), O^p(F*(A))] = 1` for `p ∈ π(F(A))`

Target of this file:

  `Work.BMAX.commutator_pCoreIn_pResidualIn_fstarIn`:
  `G` finite simple, `A` coatomic, `B ≠ ⊤` with `F*(A) ≤ B`, `p` a prime with
  `p ∈ π(F(A))`  ⟹  `⁅O_p(B), O^p(F*(A))⁆ = ⊥`.

This is Bender 1970, 1.7 (ii) taken at the witnessing subgroup `S = F*(A)`
(`C_{F*(A)}(S) = Z(F*(A)) ≤ S` is then automatic), so no `D`-group hypothesis and no
hypothesis on the layer of `A` is needed.

## The argument

`F*(A) = F(A)·E(A)` is a central product (`LayerCentralizesFitting`), hence

  `O^p(F*(A)) = O^p(F(A)) ⊔ E(A)`   (`Work.BMAX.pResidualIn_fstarIn_eq_sup`),

and it suffices to prove the two halves separately:

* the **layer half** `⁅O_p(B), E(A)⁆ = ⊥` is `Work.BMAX.pCoreIn_commutator_layerIn`
  (Bender's Thompson-lemma argument, with `P = O_p(A)`, non-trivial precisely because
  `p ∈ π(F(A))` makes `O_p(A) ≠ 1`, so that `C_G(O_p(A)) ≤ A`);
* the **Fitting half** `⁅O_p(B), O^p(F(A))⁆ = ⊥` is
  `Work.BMAX.commutator_pCoreIn_pResidualIn_fittingIn` (the same Thompson argument,
  applied to the `p'`-part of the nilpotent `F(A)`, using that
  `O_p(F(A)) ⊓ O^p(F(A)) = ⊥`, `Work.BMAX.nilpotent_pCoreIn_pResidualIn_eq_bot`).

The two halves combine because a central product of `X` and `Y` is centralised by a
group centralising `X` and `Y` separately: `V ≤ C_G(X) ⊓ C_G(Y) = C_G(X ⊔ Y)`.
-/
import Mathlib
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Bender17i_dedekind_basic
import Submission.Work.BMAX.LayerCentralizesFitting
import Submission.Work.BMAX.pCoreIn_commutator_layerIn
import Submission.Work.BMAX.pResidualIn_fstarIn_eq_sup
import Submission.Work.BMAX.commutator_pCoreIn_pResidualIn_fittingIn
import Submission.Work.BMAX.centralizer_pResidualIn_witness_le

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.BMAX

open Subgroup

/-- `O^p(O^p(K)) = O^p(K)`: the `p`-residual of a subgroup already generated by
`p'`-elements. -/
theorem pResidualIn_pResidualIn {G : Type*} [Group G] (p : ℕ) (K : Subgroup G) :
    pResidualIn p (pResidualIn p K) = pResidualIn p K := by
  refine le_antisymm (pResidualIn.le _) ?_
  refine (Subgroup.closure_le (K := pResidualIn p (pResidualIn p K))).mpr ?_
  rintro x ⟨hxK, hx⟩
  exact pResidualIn.subset_closure (pResidualIn.subset_closure hxK hx) hx

/-- A subgroup is contained in the centralizer of the join of two subgroups as soon as it is
contained in both centralizers. -/
theorem le_centralizer_sup_of_le_centralizer {G : Type*} [Group G] {V X Y : Subgroup G}
    (hX : V ≤ Subgroup.centralizer (X : Set G)) (hY : V ≤ Subgroup.centralizer (Y : Set G)) :
    V ≤ Subgroup.centralizer ((X ⊔ Y : Subgroup G) : Set G) := by
  rw [Subgroup.le_centralizer_iff] at hX hY ⊢
  exact sup_le hX hY

/-- **Bender 1970, 1.7 (ii)**, in the form requested for the `BMAX` area:

`G` finite simple, `A` coatomic (maximal), `B ≠ ⊤` with `F*(A) ≤ B`, and `p` a prime with
`p ∈ π(F(A))`; then `O_p(B)` centralises `O^p(F*(A))`.

The two halves of the central product `F*(A) = F(A)·E(A)` are Bender's Thompson-lemma
computations: `Work.BMAX.pCoreIn_commutator_layerIn` for the layer and
`Work.BMAX.commutator_pCoreIn_pResidualIn_fittingIn` for the Fitting subgroup.  The
hypothesis `hnot` (that `F*(A)` is not a `p`-group) is not needed at this point of the
argument. -/
theorem commutator_pCoreIn_pResidualIn_fstarIn (G : Type) [Group G] [Finite G]
    (hG : IsSimpleGroup G) (A B : Subgroup G) (hA : IsCoatom A) (hB : B ≠ ⊤)
    (hR : Work.GW2.fstarIn A ≤ B)
    (hnot : ¬ ∃ p : ℕ, p.Prime ∧ IsPGroup p (Work.GW2.fstarIn A))
    (p : ℕ) (hp : p.Prime) (hpi : p ∈ Work.GW2.primesOf (Work.GW2.fittingIn A)) :
    ⁅Work.GW2.pCoreIn p B, Work.BMAX.pResidualIn p (Work.GW2.fstarIn A)⁆ = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  -- the layer half
  have hL : ⁅Work.GW2.pCoreIn p B, Work.GW2.layerIn A⁆ = ⊥ :=
    Work.BMAX.pCoreIn_commutator_layerIn G hG A B hA hB hR p hp hpi
  -- the Fitting half (`F*(A) ≤ B` is only used through `F(A) ≤ B`)
  have hFle : Work.GW2.fittingIn A ≤ B := le_trans (Work.GW2.fittingIn_le_fstarIn A) hR
  have hF : ⁅Work.GW2.pCoreIn p B, Work.BMAX.pResidualIn p (Work.GW2.fittingIn A)⁆ = ⊥ :=
    commutator_pCoreIn_pResidualIn_fittingIn hG A B hA hB hFle p hp hpi
  -- pass to centralizers and use the central-product decomposition of `O^p(F*(A))`
  have h1 : Work.GW2.pCoreIn p B ≤
      Subgroup.centralizer (Work.BMAX.pResidualIn p (Work.GW2.fittingIn A) : Set G) :=
    (Subgroup.commutator_eq_bot_iff_le_centralizer).mp hF
  have h2 : Work.GW2.pCoreIn p B ≤ Subgroup.centralizer (Work.GW2.layerIn A : Set G) :=
    (Subgroup.commutator_eq_bot_iff_le_centralizer).mp hL
  rw [pResidualIn_fstarIn_eq_sup A hp]
  exact (Subgroup.commutator_eq_bot_iff_le_centralizer).mpr
    (le_centralizer_sup_of_le_centralizer h1 h2)

end Work.BMAX
