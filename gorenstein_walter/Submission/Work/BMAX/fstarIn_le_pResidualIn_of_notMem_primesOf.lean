/-
# BMAX — `F*(A) ≤ O^q(F*(A))` when `q ∉ π(F(A))`

Bender 1970 §1.7 (first paragraph) needs, for a prime `q` not dividing `|F(A)|`, that every
element of `F*(A)` is a product of `q'`-elements, i.e.

  `F*(A) = F(A)·E(A) ≤ O^q(F*(A))`.

The two halves of `F*` are handled separately.

* `F(A)` is nilpotent of order not divisible by `q` (hypothesis), so *every* element of
  `F(A)` has order dividing `|F(A)|`, hence `q'`-order: `F(A) ≤ O^q(F*(A))` by
  `pResidualIn.le_of_le`.  (In fact `pResidualIn q (F(A)) = F(A)`: everything is a generator.)

* `E(A) = layer A = sSup {E ≤ A | E normal, quasisimple}`.  Each such `E` is perfect
  (`⁅E,E⁆ = E` is part of `IsQuasisimple`), and **a finite perfect group is generated by its
  `q'`-elements** for any prime `q`: if `O := O^q(X)` then `X/O` is a `q`-group (the order of
  `x ^ q ^ k` is the `q'`-part of `orderOf x` for `k = (orderOf x).factorization q`, so some
  `q`-power of `x` lies in `O`), while `X/O` is perfect as a quotient of a perfect group;
  a nontrivial finite `q`-group is nilpotent, hence solvable, and a nontrivial perfect group is
  not solvable.  So `O^q(X) = ⊤`, i.e. `E ≤ O^q(E) ≤ O^q(F*(A))` (monotonicity, `E ≤ F*(A)`).

Since `F*(A) = F(A) ⊔ E(A)` (`Work.GW2.fstarIn_eq_sup`), the two halves give the claim.
-/
import Mathlib
import Submission.Work.BMAX.D17Defs
import Submission.Work.BMAX.Defs
import Submission.Work.BMAX.Basic

set_option linter.style.haveILetI false

namespace Work.BMAX

open Subgroup

/-! ## 1. Some `q`-power of `x` has `q'`-order -/

/-- For a finite group `X`, a prime `q` and `x : X` there is `k` with `¬ q ∣ orderOf (x ^ q ^ k)`:
with `k = (orderOf x).factorization q` the order of `x ^ q ^ k` is the `q'`-part
`ordCompl[q] (orderOf x) = orderOf x / q ^ k` of `orderOf x`, which is not divisible by `q`. -/
theorem exists_pow_not_dvd_orderOf {X : Type*} [Group X] [Finite X] (q : ℕ) (hq : q.Prime)
    (x : X) : ∃ k : ℕ, ¬ q ∣ orderOf (x ^ q ^ k) := by
  refine ⟨(orderOf x).factorization q, ?_⟩
  have hpos : orderOf x ≠ 0 := (isOfFinOrder_of_finite x).orderOf_pos.ne'
  have h1 : orderOf (x ^ (q ^ (orderOf x).factorization q))
      = (orderOf x) / (q ^ (orderOf x).factorization q) :=
    orderOf_pow_of_dvd (pow_ne_zero _ hq.ne_zero) (Nat.ordProj_dvd (orderOf x) q)
  rw [h1]
  exact Nat.not_dvd_ordCompl hq hpos

/-! ## 2. A finite perfect group is generated by its `q'`-elements -/

/-- If `X` is a finite perfect group then `O^q(X) = X`: the quotient `X ⧸ O^q(X)` is a
`q`-group and perfect, hence trivial (a nontrivial finite `q`-group is nilpotent, hence
solvable, whereas a nontrivial perfect group is never solvable). -/
theorem pResidual_eq_top_of_isPerfect {X : Type} [Group X] [Finite X] (q : ℕ) (hq : q.Prime)
    [Group.IsPerfect X] : Work.BMAX.pResidual q X = ⊤ := by
  haveI hnorm : (Work.BMAX.pResidual q X).Normal := Work.BMAX.pResidual.normal q X
  haveI hfact : Fact q.Prime := ⟨hq⟩
  -- `X ⧸ O^q(X)` is a `q`-group: some `q`-power of every `x` lies in `O^q(X)`.
  have hpg : IsPGroup q (X ⧸ Work.BMAX.pResidual q X) := by
    rw [isPGroup_iff_pow_pow_eq_one]
    intro g
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Work.BMAX.pResidual q X) g
    obtain ⟨k, hk⟩ := exists_pow_not_dvd_orderOf q hq x
    exact ⟨k, by
      rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact Work.BMAX.pResidual.subset_closure hk⟩
  -- so `X ⧸ O^q(X)` is nilpotent, hence solvable, hence trivial by perfectness.
  by_contra htop
  haveI hnt : Nontrivial (X ⧸ Work.BMAX.pResidual q X) :=
    QuotientGroup.nontrivial_iff.mpr htop
  haveI hnil : Group.IsNilpotent (X ⧸ Work.BMAX.pResidual q X) := hpg.isNilpotent
  exact Group.IsPerfect.not_isNilpotent (X ⧸ Work.BMAX.pResidual q X) hnil

/-- A perfect subgroup `M` of a finite group is contained in its own `q`-residual
(equivalently `O^q(M) = M`). -/
theorem le_pResidualIn_self_of_perfect {G : Type} [Group G] [Finite G] {M : Subgroup G}
    (q : ℕ) (hq : q.Prime) (hperf : ⁅M, M⁆ = M) :
    M ≤ Work.BMAX.pResidualIn q M := by
  haveI : Group.IsPerfect ↥M := Subgroup.isPerfect_iff.mpr hperf
  have htop : Work.BMAX.pResidual q ↥M = ⊤ := pResidual_eq_top_of_isPerfect q hq
  rw [Work.BMAX.pResidualIn.eq_map, htop, Subgroup.map_top, Subgroup.range_subtype]

/-! ## 3. The two halves of `F*(A)` -/

/-- The layer half: for every prime `q`, `E(A) ≤ O^q(F*(A))`.  (`E(A)` is a join of normal
quasisimple subgroups, and each of them is perfect, hence `q`-perfect and `≤ F*(A)`.) -/
theorem layerIn_le_pResidualIn {G : Type} [Group G] [Finite G] (A : Subgroup G) (q : ℕ)
    (hq : q.Prime) : Work.GW2.layerIn A ≤ Work.BMAX.pResidualIn q (Work.GW2.fstarIn A) := by
  -- each normal quasisimple `E ≤ A` lies in `O^q(F*(A))`
  have hstep : ∀ E : Subgroup ↥A, E.Normal → Work.GW2.IsQuasisimple E →
      E.map A.subtype ≤ Work.BMAX.pResidualIn q (Work.GW2.fstarIn A) := by
    intro E hEn hEq
    have hperf : ⁅E.map A.subtype, E.map A.subtype⁆ = E.map A.subtype := by
      rw [← Subgroup.map_commutator, hEq.1]
    refine le_trans (le_pResidualIn_self_of_perfect q hq hperf) (Work.BMAX.pResidualIn.mono ?_)
    calc E.map A.subtype ≤ (Work.GW2.layer ↥A).map A.subtype :=
          Subgroup.map_mono (le_sSup (show E ∈ {E : Subgroup ↥A | E.Normal ∧
            Work.GW2.IsQuasisimple E} from ⟨hEn, hEq⟩))
      _ = Work.GW2.layerIn A := rfl
      _ ≤ Work.GW2.fstarIn A := Work.GW2.layerIn_le_fstarIn A
  -- `layerIn A = (sSup S).map A.subtype` is the sup of the `E.map A.subtype`, `E ∈ S`
  have hmap : Work.GW2.layerIn A = (Work.GW2.layer ↥A).map A.subtype := rfl
  rw [hmap, Subgroup.map_le_iff_le_comap]
  show sSup {E : Subgroup ↥A | E.Normal ∧ Work.GW2.IsQuasisimple E} ≤
    (Work.BMAX.pResidualIn q (Work.GW2.fstarIn A)).comap A.subtype
  exact sSup_le fun E hE => (Subgroup.map_le_iff_le_comap).mp (hstep E hE.1 hE.2)

/-- The Fitting half: if `q ∤ |F(A)|` then every element of `F(A)` has `q'`-order, so
`F(A) ≤ O^q(F*(A))`. -/
theorem fittingIn_le_pResidualIn_of_notMem_primesOf {G : Type} [Group G] [Finite G]
    (A : Subgroup G) (q : ℕ) (hq : q.Prime)
    (hqpi : q ∉ Work.GW2.primesOf (Work.GW2.fittingIn A)) :
    Work.GW2.fittingIn A ≤ Work.BMAX.pResidualIn q (Work.GW2.fstarIn A) := by
  have hcard : ¬ q ∣ Nat.card (Work.GW2.fittingIn A) := fun hd =>
    hqpi (Nat.mem_primeFactors.mpr
      ⟨hq, hd, Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩⟩)
  have hself : Work.BMAX.pResidualIn q (Work.GW2.fittingIn A) = Work.GW2.fittingIn A := by
    rw [Work.BMAX.pResidualIn.eq_map,
      Work.BMAX.pResidual.eq_top_of_card_not_dvd (p := q) hcard,
      Subgroup.map_top, Subgroup.range_subtype]
  rw [← hself]
  exact Work.BMAX.pResidualIn.mono (Work.GW2.fittingIn_le_fstarIn A)

/-! ## 4. The target -/

theorem fstarIn_le_pResidualIn_of_notMem_primesOf {G : Type} [Group G] [Finite G]
    (A : Subgroup G) (q : ℕ) (hq : q.Prime) (hqpi : q ∉ Work.GW2.primesOf (Work.GW2.fittingIn A)) :
    Work.GW2.fstarIn A ≤ Work.BMAX.pResidualIn q (Work.GW2.fstarIn A) := by
  refine le_trans (le_of_eq (Work.GW2.fstarIn_eq_sup A)) ?_
  exact sup_le (fittingIn_le_pResidualIn_of_notMem_primesOf A q hq hqpi)
    (layerIn_le_pResidualIn A q hq)

end Work.BMAX
