open Subgroup

/-! ## A cyclic subgroup of index two in a dihedral group

This is the (clash-free) restatement of `Work.CORE2A.dihedral_index_two` promised in the
docstring of `Case2BGData`: CORE2A cannot be imported here because it carries a second copy of
the `Work.GW2` vocabulary.  Only `Submission.Work.Dihedral.Defs` and Mathlib are used.

The mathematics: in `DihedralGroup n` every element outside the rotation subgroup `⟨r⟩` has
order `2`.  A *cyclic* subgroup of index two has `n` elements, hence is generated by an element
of order `n`, hence (for `n ≥ 3`) lies in `⟨r⟩`, and by order reasons equals it.  The exceptional
value `n = 2` (the Klein four group, where index-two subgroups need not be `⟨r⟩`) is handled
directly via the exponent. -/

/-- In `DihedralGroup n` with `n ≥ 2`, a cyclic subgroup `T` of index two consists of
rotations, so every element outside `T` is a reflection and has order `2`. -/
private lemma dihedral_cyclic_index_two_aux (n : ℕ) (hn : 2 ≤ n) (T : Subgroup (DihedralGroup n))
    (hcyc : IsCyclic T) (hidx : T.relIndex ⊤ = 2) :
    ∀ y : DihedralGroup n, y ∉ T → orderOf y = 2 := by
  classical
  haveI : NeZero n := ⟨by omega⟩
  -- `|T| = n`, from Lagrange and `|DihedralGroup n| = 2n`.
  have hcardT : Nat.card T = n := by
    have h := Subgroup.relIndex_mul_card T ⊤
    rw [hidx, inf_top_eq, Subgroup.card_top, DihedralGroup.nat_card] at h
    exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 2) h
  intro y hy
  rcases eq_or_ne n 2 with hn2 | hn2
  · -- `n = 2`: the Klein four group has exponent `2`.
    subst hn2
    have hy1 : y ≠ 1 := fun h => hy (h ▸ Subgroup.one_mem T)
    exact (orderOf_eq_two_iff (IsKleinFour.exponent_two (G := DihedralGroup 2))).mpr hy1
  · -- `n ≥ 3`: `T` is the rotation subgroup.
    have hn3 : 3 ≤ n := by omega
    have hTrot : T = Work.Dihedral.rot n := by
      obtain ⟨g, hg⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top T).mp hcyc
      have hordg : orderOf g = n := by rw [← Nat.card_zpowers g, hg, hcardT]
      have hgR : g ∈ Work.Dihedral.rot n := by
        rcases Work.Dihedral.eq_r_or_sr g with ⟨i, rfl⟩ | ⟨i, rfl⟩
        · exact Work.Dihedral.r_mem_rot i
        · rw [DihedralGroup.orderOf_sr] at hordg; omega
      have hTR : T ≤ Work.Dihedral.rot n := by
        rw [← hg]; exact Subgroup.zpowers_le.mpr hgR
      exact Subgroup.eq_of_le_of_card_ge hTR (by rw [Work.Dihedral.nat_card_rot, hcardT])
    have hyR : y ∉ Work.Dihedral.rot n := by rw [← hTrot]; exact hy
    obtain ⟨i, rfl⟩ := Work.Dihedral.notMem_rot.mp hyR
    exact DihedralGroup.orderOf_sr i

/-- **A cyclic subgroup of index two in a dihedral group.**  If `S ≤ G` is isomorphic to the
dihedral group `DihedralGroup n` (`n ≥ 2`) and `S₀ ≤ S` is a *cyclic* subgroup of index `2` in
`S`, then every element of `S` lying outside `S₀` has order `2`. -/
theorem dihedral_index_two {G : Type} [Group G] (n : ℕ) (hn : 2 ≤ n) (S S0 : Subgroup G)
    (hD : Nonempty (S ≃* DihedralGroup n)) (hS0 : S0 ≤ S) (hcyc : IsCyclic S0)
    (hidx : S0.relIndex S = 2) : ∀ s ∈ S, s ∉ S0 → orderOf s = 2 := by
  classical
  obtain ⟨e⟩ := hD
  intro s hs hs0
  -- `|S| = 2n` and `|S₀| = n`.
  have hcardS : Nat.card S = 2 * n := by
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hcardS0 : Nat.card S0 = n := by
    have h := Subgroup.relIndex_mul_card S0 S
    rw [hidx, inf_eq_left.mpr hS0] at h
    rw [hcardS] at h
    exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 2) h
  -- The image `T` of `S₀` in `DihedralGroup n`.
  set T : Subgroup (DihedralGroup n) := (S0.subgroupOf S).map e.toMonoidHom with hT
  have hcycT : IsCyclic T := by
    rw [hT]
    exact (Subgroup.equivMapOfInjective (S0.subgroupOf S) e.toMonoidHom e.injective).isCyclic.mp
      ((Subgroup.subgroupOfEquivOfLe hS0).isCyclic.mpr hcyc)
  have hidxT : T.relIndex ⊤ = 2 := by
    rw [hT]
    have hcardMap : Nat.card ((S0.subgroupOf S).map e.toMonoidHom) = n := by
      rw [← Nat.card_congr
            (Subgroup.equivMapOfInjective (S0.subgroupOf S) e.toMonoidHom e.injective).toEquiv,
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS0).toEquiv]
      exact hcardS0
    have h := Subgroup.relIndex_mul_card ((S0.subgroupOf S).map e.toMonoidHom) ⊤
    rw [inf_top_eq, Subgroup.card_top, DihedralGroup.nat_card, hcardMap] at h
    exact Nat.mul_right_cancel (by omega : 0 < n) h
  have hy : e ⟨s, hs⟩ ∉ T := by
    rw [hT, Subgroup.mem_map]
    rintro ⟨x, hx, hxe⟩
    rw [Subgroup.mem_subgroupOf] at hx
    rw [e.injective hxe] at hx
    exact hs0 hx
  have h2 : orderOf (e ⟨s, hs⟩) = 2 :=
    dihedral_cyclic_index_two_aux n hn T hcycT hidxT (e ⟨s, hs⟩) hy
  have h2' : orderOf ((⟨s, hs⟩ : ↥S) : G) = 2 := by
    rw [Subgroup.orderOf_coe]
    rw [← orderOf_injective e.toMonoidHom e.injective (⟨s, hs⟩ : ↥S)]
    exact h2
  exact h2'

/-! ## The `BGData` of Bender–Glauberman Theorem A -/

/-- The `BGData` structure of Bender–Glauberman 1981 Theorem A, built from the §4 data:
with `S ≃* DihedralGroup n` (`n ≥ 2`, from §4 (9) and `I.toolkit.l2syl`), `S₀` cyclic of index 2
with `t ∈ S₀` the central involution, all involutions of `G` conjugate (`I.toolkit.fus`, whose
hypothesis `∀ N ⊴ G, N.index ≠ 2` comes from `BenderCtx.simple`/`nonab`), and
`t₁, t₂ ∈ S \ S₀` involutions with `t₁ t₂` generating `S₀`, Bender's `BGData G` is inhabited with
`S, S₀, t` as in `B`.

(Note: the fact "every element of `S \ S₀` has order 2" is available in
`Submission/Work/CORE2A/dihedral_index_two.lean`, but CORE2A imports a second copy of
`namespace Work.GW2` (`ASM.Defs`) which clashes with `Submission.Work.CORE4.Defs`, so it has to
be restated/reproved here; `Submission/Work/Dihedral/Defs.lean` is clash-free and can be
imported.) -/
theorem Case2BGData :
    ∀ (G : Type) [Group G] [Finite G] (I : Work.GW2.C4Inputs), Work.GW2.BenderCtx G →
      ∀ (B : Work.GW2.BenderSetup G) (h : Work.GW2.Case2Ctx B),
        ∃ D : Work.GW2.BGData G, (D.S : Subgroup G) = (B.S : Subgroup G) ∧
          D.S0 = B.S0 ∧ D.t = B.t := by
  intro G _ _ I hctx B h
  classical
  -- `S` is dihedral: §4 (9) plus `I.toolkit.l2syl` (`Work.GW2.Case2Ctx.sylow_dihedral`).
  obtain ⟨n, hn, hdih⟩ := h.sylow_dihedral I
  -- `|G| ≠ 2`, because `|S| = 2n ≥ 4` and `S ≤ G`.
  have hcardS : Nat.card (B.S : Subgroup G) = 2 * n := by
    obtain ⟨e⟩ := hdih
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hGne : Nat.card G ≠ 2 := by
    have hle : Nat.card (B.S : Subgroup G) ≤ Nat.card G := Subgroup.card_le_card_group _
    rw [hcardS] at hle
    omega
  -- A simple group of order `≠ 2` has no normal subgroup of index two.
  have hNoIndex2 : ∀ N : Subgroup G, N.Normal → N.index ≠ 2 := by
    intro N hN hIdx
    have hbot : N ≠ ⊥ := by
      intro hh
      rw [hh, Subgroup.index_bot] at hIdx
      exact hGne hIdx
    have htop : N ≠ ⊤ := by
      intro hh
      rw [hh, Subgroup.index_top] at hIdx
      omega
    rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal G _ hctx.simple N hN with h1 | h1
    · exact hbot h1
    · exact htop h1
  -- Bender's fusion result: all involutions of `G` are conjugate.
  have hclass : ∀ x y : G, orderOf x = 2 → orderOf y = 2 → IsConj x y :=
    (I.toolkit.fus G B.S n hn hdih hNoIndex2).1
  -- A generator `g` of the cyclic group `S₀`.
  obtain ⟨g, hg⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top B.S0).mp B.S0_cyclic
  have hS0_gen : B.S0 = Subgroup.zpowers g := hg.symm
  have hg_mem : g ∈ B.S0 := hS0_gen ▸ Subgroup.mem_zpowers g
  have hidx0 : B.S0.relIndex (B.S : Subgroup G) = 2 := B.S0_index
  -- `S₀` is a proper subgroup of `S`.
  have hne : B.S0 ≠ (B.S : Subgroup G) := by
    intro hh
    have h1 : B.S0.relIndex (B.S : Subgroup G) = 1 := by
      rw [hh]; exact Subgroup.relIndex_self (B.S : Subgroup G)
    rw [h1] at hidx0
    exact absurd hidx0 (by norm_num)
  have hsle : ¬ (B.S : Subgroup G) ≤ B.S0 := fun hle => hne (le_antisymm B.S0_le hle)
  -- An element `s ∈ S \ S₀`.
  obtain ⟨s, hsS, hs0⟩ : ∃ s, s ∈ (B.S : Subgroup G) ∧ s ∉ B.S0 := by
    by_contra hcon
    simp only [not_exists, not_and, not_not] at hcon
    exact hsle fun x hx => hcon x hx
  -- Every element of `S \ S₀` is an involution.
  have hord_s : orderOf s = 2 :=
    dihedral_index_two n hn (B.S : Subgroup G) B.S0 hdih B.S0_le B.S0_cyclic hidx0 s hsS hs0
  -- `t₂ = s * g` lies in `S` and outside `S₀`, hence is an involution too.
  have ht2_mem : s * g ∈ (B.S : Subgroup G) :=
    (B.S : Subgroup G).mul_mem hsS (B.S0_le hg_mem)
  have ht2_nmem : s * g ∉ B.S0 := by
    intro hmem
    refine hs0 ?_
    have h1 : (s * g) * g⁻¹ ∈ B.S0 := B.S0.mul_mem hmem (B.S0.inv_mem hg_mem)
    have h2 : (s * g) * g⁻¹ = s := by group
    rwa [h2] at h1
  have hord_t2 : orderOf (s * g) = 2 :=
    dihedral_index_two n hn (B.S : Subgroup G) B.S0 hdih B.S0_le B.S0_cyclic hidx0 (s * g)
      ht2_mem ht2_nmem
  -- `s * s = 1`, so that `t₁ t₂ = s (s g) = g` generates `S₀`.
  have hs2 : s * s = 1 := by
    have hh := pow_orderOf_eq_one s
    rw [hord_s] at hh
    simpa [pow_two] using hh
  have hgen : B.S0 = Subgroup.zpowers (s * (s * g)) := by
    rw [hS0_gen]
    congr 1
    rw [← mul_assoc, hs2, one_mul]
  exact ⟨{ S := B.S, n := n, two_le := hn, dih := hdih, oneClass := hclass,
            S0 := B.S0, S0_le := B.S0_le, S0_cyclic := B.S0_cyclic, S0_index := B.S0_index,
            t := B.t, t_mem := B.t_mem, t_order := B.t_order,
            t1 := s, t2 := s * g,
            t1_mem := hsS, t2_mem := ht2_mem, t1_nmem := hs0, t2_nmem := ht2_nmem,
            t1_order := hord_s, t2_order := hord_t2, gen := hgen }, rfl, rfl, rfl⟩

end Work.CORE4
