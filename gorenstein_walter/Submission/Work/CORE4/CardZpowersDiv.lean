import Mathlib

namespace Work.CORE4

/-- If `r` divides the order of `z`, then the cyclic subgroup generated by
`z ^ (orderOf z / r)` has cardinality `r`.

Proof: `Nat.card_zpowers` identifies the cardinality of `Subgroup.zpowers w` with
`orderOf w`, and `orderOf_pow` computes
`orderOf (z ^ (orderOf z / r)) = orderOf z / (orderOf z).gcd (orderOf z / r)`.
Since `orderOf z / r` divides `orderOf z`, the `gcd` equals `orderOf z / r`, and
`Nat.div_div_self` (with `orderOf z ≠ 0`) finishes. Primality of `r` is not
needed for this divisibility computation. -/
theorem CardZpowersDiv {G : Type*} [Group G] [Finite G] (z : G) {r : ℕ}
    (hr : r.Prime) (hrdvd : r ∣ orderOf z) :
    Nat.card ↥(Subgroup.zpowers (z ^ (orderOf z / r))) = r := by
  rw [Nat.card_zpowers, orderOf_pow, Nat.gcd_eq_right (Nat.div_dvd_of_dvd hrdvd)]
  exact Nat.div_div_self hrdvd (ne_of_gt (orderOf_pos z))

end Work.CORE4
