import Mathlib

namespace Work.CORE4.COAGT

open DihedralGroup

/-- In `DihedralGroup n`, every element is a product of two reflections
(the elements `sr i`, each satisfying `x ^ 2 = 1`): indeed `sr i * sr j = r (j - i)`.
Consequently the elements of order dividing `2` generate the whole group.
This holds for every `n`, including the infinite case `n = 0`. -/
theorem dihedral_closure_involutions (n : ℕ) :
    Subgroup.closure {x : DihedralGroup n | x ^ 2 = 1} = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  rcases x with i | i
  · have h0 : (sr 0 : DihedralGroup n) ∈ Subgroup.closure {x : DihedralGroup n | x ^ 2 = 1} :=
      Subgroup.subset_closure
        (by show (sr 0 : DihedralGroup n) ^ 2 = 1; rw [sq, sr_mul_sr, sub_self, r_zero])
    have hi : (sr i : DihedralGroup n) ∈ Subgroup.closure {x : DihedralGroup n | x ^ 2 = 1} :=
      Subgroup.subset_closure
        (by show (sr i : DihedralGroup n) ^ 2 = 1; rw [sq, sr_mul_sr, sub_self, r_zero])
    have h := Subgroup.mul_mem _ h0 hi
    rwa [sr_mul_sr, sub_zero] at h
  · exact Subgroup.subset_closure
      (by show (sr i : DihedralGroup n) ^ 2 = 1; rw [sq, sr_mul_sr, sub_self, r_zero])

-- `hn` is part of the requested interface; the argument below does not need `n ≥ 2`.
set_option linter.unusedVariables false in
/-- In a finite dihedral group `DihedralGroup n` (`n ≥ 2`), the elements of order dividing `2`
generate the whole group.  Transported through an isomorphism `Q ≃* DihedralGroup n`: a group
isomorphic to a dihedral group of order `≥ 4` is generated by its involutions. -/
theorem DihedralInvolutionGen {Q : Type*} [Group Q] {n : ℕ} (hn : 2 ≤ n)
    (e : Q ≃* DihedralGroup n) : Subgroup.closure {x : Q | x ^ 2 = 1} = ⊤ := by
  -- The isomorphism `e` identifies the set of involutions of `Q` with those of `DihedralGroup n`.
  have hset : (e : Q →* DihedralGroup n) '' {x : Q | x ^ 2 = 1}
      = {y : DihedralGroup n | y ^ 2 = 1} := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      show (e x : DihedralGroup n) ^ 2 = 1
      rw [← map_pow]
      rw [show x ^ 2 = 1 from hx, map_one]
    · intro hy
      refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
      apply e.injective
      simp only [map_pow, map_one, MulEquiv.apply_symm_apply]
      exact hy
  have hmap : (Subgroup.closure {x : Q | x ^ 2 = 1}).map (e : Q →* DihedralGroup n) = ⊤ := by
    rw [MonoidHom.map_closure, hset, dihedral_closure_involutions]
  rw [Subgroup.eq_top_iff']
  intro x
  exact (Subgroup.mem_map_iff_mem e.injective).mp (by rw [hmap]; exact Subgroup.mem_top _)

end Work.CORE4.COAGT
