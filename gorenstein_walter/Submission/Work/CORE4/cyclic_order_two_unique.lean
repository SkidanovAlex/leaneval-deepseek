import Mathlib
import Submission.Work.Dihedral.Defs

namespace Work.CORE4

/-- In any group, if `y ^ 2 = 1` then every integer power of `y` is either `1` or `y`:
the powers of an involution only depend on the exponent modulo `2`. -/
lemma zpow_eq_one_or_self_of_sq_eq_one {G : Type*} [Group G] {y : G} (hy2 : y ^ (2 : ℤ) = 1)
    (k : ℤ) : y ^ k = 1 ∨ y ^ k = y := by
  have hk : y ^ k = y ^ (k % 2) := by
    conv_lhs => rw [← Int.emod_add_mul_ediv k 2]
    rw [zpow_add, zpow_mul, hy2, one_zpow, mul_one]
  rw [hk]
  rcases Int.emod_two_eq_zero_or_one k with h | h
  · left; rw [h, zpow_zero]
  · right; rw [h, zpow_one]

/-- A cyclic group has at most one element of order two: a cyclic (sub)group contains a unique
subgroup of each finite order, so the two subgroups generated by two distinct involutions would
have to coincide, forcing the involutions to be equal. -/
theorem cyclic_order_two_unique {G : Type*} [Group G] {B : Subgroup G} (hB : IsCyclic B)
    {t b : G} (ht : t ∈ B) (hb : b ∈ B) (ht2 : t ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (ht1 : t ≠ 1) (hb1 : b ≠ 1) : t = b := by
  have hBcyc : IsCyclic B := hB
  set t' : B := ⟨t, ht⟩ with ht'_def
  set b' : B := ⟨b, hb⟩ with hb'_def
  have ht2' : t' ^ 2 = 1 := by rw [ht'_def]; exact Subtype.ext (by simpa using ht2)
  have hb2' : b' ^ 2 = 1 := by rw [hb'_def]; exact Subtype.ext (by simpa using hb2)
  have ht1' : t' ≠ 1 := by rw [ht'_def]; intro h; exact ht1 (Subtype.ext_iff.mp h)
  have hb1' : b' ≠ 1 := by rw [hb'_def]; intro h; exact hb1 (Subtype.ext_iff.mp h)
  have hordt : orderOf t' = 2 := orderOf_eq_prime ht2' ht1'
  have hordb : orderOf b' = 2 := orderOf_eq_prime hb2' hb1'
  have hcardt : Nat.card (Subgroup.zpowers t') = 2 := by rw [Nat.card_zpowers, hordt]
  have hcardb : Nat.card (Subgroup.zpowers b') = 2 := by rw [Nat.card_zpowers, hordb]
  have hfin : Finite (Subgroup.zpowers t') :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, ht2'⟩).finite_zpowers
  -- In a cyclic group, subgroups of equal finite cardinality are equal (here: both have order 2),
  -- hence `t'` lies in the subgroup generated by `b'`.
  have hle : Subgroup.zpowers t' ≤ Subgroup.zpowers b' := by
    rw [IsCyclic.subgroup_le_iff_card_dvd, hcardt, hcardb]
  have hmem : t' ∈ Subgroup.zpowers b' := hle (Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩)
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
  -- Since `b'` is an involution, `b' ^ k` is `1` or `b'`; it equals `t' ≠ 1`, so it is `b'`.
  have hkey : b' ^ k = 1 ∨ b' ^ k = b' := by
    apply zpow_eq_one_or_self_of_sq_eq_one
    simpa using hb2'
  have htb : t' = b' := by
    rcases hkey with h | h
    · exact absurd (hk.symm.trans h) ht1'
    · exact (h ▸ hk).symm
  exact congrArg Subtype.val htb

end Work.CORE4
