import Mathlib
import Submission.Work.CORE4.Defs27
import Submission.Work.CORE4.EightIdxDefs

namespace Work.CORE4

open scoped commutatorElement
open Subgroup

variable {G : Type} [Group G]

/-! ## Structure of `z2` and of `Ω₁(Z₂ R)`

The whole trichotomy rests on one structural fact: `Ω₁(Z₂ R)` has nilpotency class `≤ 2`
(in the strong sense that `[x, y]` centralizes `Ω₁(Z₂ R)` for `x, y` in it).  Since
`z2 R = Z₂(R)` is, by definition, generated by the elements `x` with `⁅⁅x, y⁆, z⁆ = 1` for all
`y, z ∈ R`, and that set generates the second centre
`{x ∈ R | [x, R] ≤ Z(R)}` of `R` — which is a *subgroup*, being the preimage of the centre of
`R/Z(R)` under `R → R/Z(R)`. -/

/-- `z2 P` is contained in the second centre of `P`, i.e. in the preimage of the centre of the
quotient `P / Z(P)` inside `P`. -/
theorem z2_le_upperCentralSeriesStep (P : Subgroup G) :
    z2 P ≤ (Subgroup.upperCentralSeriesStep (Subgroup.center ↥P)).map P.subtype := by
  rw [z2]
  refine (Subgroup.closure_le _).mpr ?_
  intro x hx
  simp only [z2Set, Set.mem_ofPred_eq] at hx
  obtain ⟨hxR, hxtriple⟩ := hx
  change x ∈ Subgroup.map P.subtype (Subgroup.upperCentralSeriesStep (Subgroup.center ↥P))
  rw [Subgroup.mem_map]
  refine ⟨⟨x, hxR⟩, ?_, rfl⟩
  rw [Subgroup.mem_upperCentralSeriesStep]
  intro y
  rw [Subgroup.mem_center_iff]
  intro w
  apply Subtype.ext
  have h := hxtriple y.val y.property w.val w.property
  exact (commutatorElement_eq_one_iff_mul_comm.mp h).symm

/-- `z2 P ≤ P`. -/
theorem z2_le_self (P : Subgroup G) : z2 P ≤ P := by
  rw [z2]
  refine (Subgroup.closure_le _).mpr ?_
  intro x hx
  simp only [z2Set, Set.mem_ofPred_eq] at hx
  exact hx.1

/-- `Ω₁(z2 P) ≤ P`. -/
theorem omega1_z2_le_self (p : ℕ) (P : Subgroup G) : omega1 p (z2 P) ≤ P := by
  rw [omega1]
  refine (Subgroup.closure_le _).mpr ?_
  intro x hx
  simp only [omega1Set, Set.mem_ofPred_eq] at hx
  exact z2_le_self P hx.1

/-- For `x ∈ Ω₁(Z₂ P)` and `y ∈ P`, the commutator `⁅x, y⁆` lies in the centre of `P`
(viewed inside the ambient group). -/
theorem omega1_z2_commutator_mem_centerIn (p : ℕ) (P : Subgroup G) {x y : G}
    (hx : x ∈ omega1 p (z2 P)) (hy : y ∈ P) : ⁅x, y⁆ ∈ centerIn P := by
  have h1 : omega1 p (z2 P) ≤
      (Subgroup.upperCentralSeriesStep (Subgroup.center ↥P)).map P.subtype := by
    rw [omega1]
    refine (Subgroup.closure_le _).mpr ?_
    intro z hz
    simp only [omega1Set, Set.mem_ofPred_eq] at hz
    exact z2_le_upperCentralSeriesStep P hz.1
  obtain ⟨x', hx'mem, hx'eq⟩ := Subgroup.mem_map.mp (h1 hx)
  have h2 : ⁅x', ⟨y, hy⟩⁆ ∈ Subgroup.center ↥P :=
    (Subgroup.mem_upperCentralSeriesStep (Subgroup.center ↥P) x').mp hx'mem ⟨y, hy⟩
  have hxy : ⁅x, y⁆ = P.subtype ⁅x', ⟨y, hy⟩⁆ := by
    simp [map_commutatorElement, hx'eq]
  rw [hxy]
  change P.subtype ⁅x', ⟨y, hy⟩⁆ ∈ Subgroup.map P.subtype (Subgroup.center ↥P)
  exact Subgroup.mem_map.mpr ⟨⁅x', ⟨y, hy⟩⁆, h2, rfl⟩

/-- `centerIn` is monotone in the sense `Z(K) ∩ H ≤ Z(H)` for `H ≤ K`. -/
theorem centerIn_inf_le {H K : Subgroup G} (hHK : H ≤ K) :
    centerIn K ⊓ H ≤ centerIn H := by
  intro g hg
  obtain ⟨hgK, hgH⟩ := Subgroup.mem_inf.mp hg
  obtain ⟨c, hc, hceq⟩ := Subgroup.mem_map.mp hgK
  change g ∈ Subgroup.map H.subtype (Subgroup.center ↥H)
  refine Subgroup.mem_map.mpr ⟨⟨g, hgH⟩, ?_, rfl⟩
  rw [Subgroup.mem_center_iff]
  intro w
  have hcw : (⟨(w : G), hHK w.property⟩ : ↥K) * c = c * ⟨(w : G), hHK w.property⟩ :=
    (Subgroup.mem_center_iff.mp hc) _
  have h3 : (w : G) * (c : G) = (c : G) * (w : G) := by
    have h := congrArg (fun t : ↥K => (t : G)) hcw
    simpa only [Subgroup.coe_mul] using h
  apply Subtype.ext
  simp only [Subgroup.coe_mul]
  rw [hceq.symm, Subgroup.subtype_apply]
  exact h3

/-- `Ω₁(Z₂ P)` has class `≤ 2`: the commutator of two of its elements lies in its centre. -/
theorem omega1_z2_commutator_mem_centerIn_self (p : ℕ) (P : Subgroup G) {x y : G}
    (hx : x ∈ omega1 p (z2 P)) (hy : y ∈ omega1 p (z2 P)) :
    ⁅x, y⁆ ∈ centerIn (omega1 p (z2 P)) := by
  have hle : omega1 p (z2 P) ≤ P := omega1_z2_le_self p P
  have h₁ : ⁅x, y⁆ ∈ centerIn P := omega1_z2_commutator_mem_centerIn p P hx (hle hy)
  have h₂ : ⁅x, y⁆ ∈ omega1 p (z2 P) := by
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem hx hy) (inv_mem hx)) (inv_mem hy)
  exact centerIn_inf_le hle (Subgroup.mem_inf.mpr ⟨h₁, h₂⟩)

/-! ## The main lemma -/

/-- Design-27 leaf `Work.GW2.C27.TrichCoreProp` (pure `p`-group statement; see
`CORE4/Defs27.lean`, `Submission/Work/NOTES_LEAD_gw_design27.md` §3).

Read the unfolded statement in `Submission/Work/_design_gw/Core27.lean:365`.  In words: let `R` be a
`p`-group (`p` odd), `P ≤ A` subgroups with `|P| = p`, `|A| = p²`, `A` of exponent `p`,
`P ≤ Ω₁(Z₂ R)`, `A ≤ R`, and `Ω₁(Z₂ R) ⊓ C_R(P) ≤ A`.  Then either `Ω₁(Z₂ R) ≤ A`, or
`A ≤ Ω₁(Z₂ R)` with `Z(Ω₁(Z₂ R)) < A < Ω₁(Z₂ R)` and `A.relIndex (Ω₁(Z₂ R)) = p`.

Proof (Bender p. 226, asserted without proof; GAP `_design_gw/Core27_trich.g`: all groups of order
`3³, 3⁴, 3⁵, 5³, 5⁴, 7³`, every pair `(P, A)` — 336 configurations, 0 failures):
put `Q := Ω₁(Z₂ R)`.  `[Q,Q] ≤ [Z₂R, Z₂R] ≤ [Z₂R, R] ≤ Z(R)`, so `[Q,Q] ≤ Z(R) ⊓ Q ≤ Z(Q)`: `Q`
has class ≤ 2.  If `P ≤ Z(Q)` then `C_Q(P) = Q ≤ A` (hypothesis) gives the first disjunct.
Otherwise `Z(Q) ≠ 1`, `Z(Q)·P ≤ C_Q(P) ≤ A`, `Z(Q) ⊓ P = 1`, so
`|Z(Q)·P| = |Z(Q)|·p ≥ p² = |A|` forces `Z(Q)·P = A = C_Q(P)` and `|Z(Q)| = p`; the map
`y ↦ ⁅x,y⁆` (with `P = ⟨x⟩`) is a homomorphism `Q → Z(Q)` with kernel `C_Q(P) = A` and nontrivial
image, so `|Q : A| = p`, giving `Z(Q) < A < Q` and `A.relIndex Q = p`.

Must be sorry-free: `#print axioms Work.CORE4.TrichCore` = `[propext, Classical.choice, Quot.sound]`. -/
theorem TrichCore : Work.GW2.C27.TrichCoreProp := by
  intro G _ _ p R P A hp hp2 hR hPQ hPA hAR hPcard hAcard hexp hhyp
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  set Q : Subgroup G := omega1 p (z2 R) with hQ
  have hQleR : Q ≤ R := omega1_z2_le_self p R
  have hQpg : IsPGroup p Q := hR.to_le hQleR
  by_cases hPZ : P ≤ centerIn Q
  · -- Case 1: `P ≤ Z(Q)`, so `C_Q(P) = Q ≤ A`.
    left
    intro q hq
    have hqC : q ∈ centralizer (P : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      obtain ⟨c, hc, hceq⟩ := Subgroup.mem_map.mp (hPZ hy)
      have hcy : (⟨q, hq⟩ : ↥Q) * c = c * ⟨q, hq⟩ := (Subgroup.mem_center_iff.mp hc) _
      have h3 := congrArg (fun t : ↥Q => (t : G)) hcy
      simp only [Subgroup.coe_mul] at h3
      rw [← hceq, Subgroup.subtype_apply]
      exact h3.symm
    exact hhyp (Subgroup.mem_inf.mpr ⟨hq, hqC⟩)
  · -- Case 2: `P ⊄ Z(Q)`.
    right
    have hPne : P ≠ ⊥ := by
      intro h
      rw [h, Subgroup.card_bot] at hPcard
      have h2p : 2 ≤ p := hp.two_le
      omega
    have hQne : Q ≠ ⊥ := by
      intro h
      exact hPne (le_bot_iff.mp (hPQ.trans (le_of_eq h)))
    haveI hQnt : Nontrivial ↥Q := (Subgroup.nontrivial_iff_ne_bot Q).mpr hQne
    have hZQle : centerIn Q ≤ Q := Subgroup.map_subtype_le _
    have hcardZ : Nat.card ↥(centerIn Q) = Nat.card ↥(Subgroup.center ↥Q) :=
      Subgroup.card_map_of_injective (Subgroup.subtype_injective Q)
    have h1lt : 1 < Nat.card ↥(Subgroup.center ↥Q) := by
      have h := Subgroup.card_lt_of_lt (IsPGroup.bot_lt_center hQpg)
      rwa [Subgroup.card_bot] at h
    have hp_le_cardZ : p ≤ Nat.card ↥(centerIn Q) := by
      obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp (hQpg.to_le hZQle)
      rcases Nat.eq_zero_or_pos n with h | h
      · rw [h, pow_zero] at hn
        rw [hcardZ] at hn
        omega
      · rw [hn]
        exact Nat.le_self_pow h.ne' p
    -- `Z(Q) ∩ P = ⊥`
    have hZPbot : centerIn Q ⊓ P = ⊥ := by
      have hlt : centerIn Q ⊓ P < P := by
        refine lt_of_le_of_ne inf_le_right ?_
        intro heq
        exact hPZ (heq ▸ inf_le_left)
      have hcard : Nat.card ↥(centerIn Q ⊓ P) = 1 := by
        have hdvd : Nat.card ↥(centerIn Q ⊓ P) ∣ p := by
          rw [← hPcard]; exact Subgroup.card_dvd_of_le inf_le_right
        rcases (Nat.dvd_prime hp).mp hdvd with h | h
        · exact h
        · exfalso
          have hlt' : Nat.card ↥(centerIn Q ⊓ P) < Nat.card ↥P := Subgroup.card_lt_of_lt hlt
          rw [hPcard, h] at hlt'
          exact lt_irrefl p hlt'
      exact (Subgroup.card_eq_one).mp hcard
    -- `Z(Q) ≤ A`
    have hZ_le_cP : centerIn Q ≤ centralizer (P : Set G) := by
      intro z hz
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      obtain ⟨c, hc, hceq⟩ := Subgroup.mem_map.mp hz
      have hcy : (⟨y, hPQ hy⟩ : ↥Q) * c = c * ⟨y, hPQ hy⟩ :=
        (Subgroup.mem_center_iff.mp hc) _
      have h3 := congrArg (fun t : ↥Q => (t : G)) hcy
      simp only [Subgroup.coe_mul] at h3
      rw [← hceq, Subgroup.subtype_apply]
      exact h3
    have hZ_le_A : centerIn Q ≤ A := le_trans (le_inf hZQle hZ_le_cP) hhyp
    have hZP_le_A : centerIn Q ⊔ P ≤ A := sup_le hZ_le_A hPA
    -- a generator `x` of `P` outside `Z(Q)`
    have hxZex : ∃ x, x ∈ P ∧ x ∉ centerIn Q := by
      by_contra hcon
      apply hPZ
      intro y hy
      by_contra hyc
      exact hcon ⟨y, hy, hyc⟩
    obtain ⟨x, hxP, hxZ⟩ := hxZex
    have hxne : x ≠ 1 := fun h => hxZ (h ▸ (centerIn Q).one_mem)
    have hxQ : x ∈ Q := hPQ hxP
    have hPgen : P = Subgroup.zpowers x := by
      have hle : Subgroup.zpowers x ≤ P := by
        rw [Subgroup.zpowers_eq_closure]
        refine (Subgroup.closure_le _).mpr ?_
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        rw [hy]; exact hxP
      have hcard' : Nat.card ↥(Subgroup.zpowers x) = p := by
        have hdvd : Nat.card ↥(Subgroup.zpowers x) ∣ p := by
          rw [← hPcard]; exact Subgroup.card_dvd_of_le hle
        rcases (Nat.dvd_prime hp).mp hdvd with h | h
        · exfalso
          rw [Nat.card_zpowers] at h
          exact hxne (orderOf_eq_one_iff.mp h)
        · exact h
      exact (Subgroup.eq_of_le_of_card_ge hle (by rw [hPcard, hcard'])).symm
    have hCx : centralizer (P : Set G) = centralizer ({x} : Set G) := by
      rw [hPgen, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
    have hQx_le_A : Q ⊓ centralizer ({x} : Set G) ≤ A := by
      rw [← hCx]; exact hhyp
    have hP_le_cx : P ≤ centralizer ({x} : Set G) := by
      rw [hPgen, Subgroup.zpowers_le]
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst w
      rfl
    have hZ_le_cx : centerIn Q ≤ centralizer ({x} : Set G) := by
      intro z hz
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst w
      obtain ⟨c, hc, hceq⟩ := Subgroup.mem_map.mp hz
      have hcw : (⟨x, hxQ⟩ : ↥Q) * c = c * ⟨x, hxQ⟩ := (Subgroup.mem_center_iff.mp hc) _
      have h3 := congrArg (fun t : ↥Q => (t : G)) hcw
      simp only [Subgroup.coe_mul] at h3
      rw [← hceq, Subgroup.subtype_apply]
      exact h3
    -- counting: `|Z(Q) · P| = |Z(Q)| · p ≤ p ^ 2`
    have hinjZP : Nat.card (↥(centerIn Q) × ↥P) ≤ Nat.card ↥(centerIn Q ⊔ P) := by
      refine Nat.card_le_card_of_injective
        (fun t : ↥(centerIn Q) × ↥P =>
          (⟨(t.1 : G) * (t.2 : G),
            mul_mem (le_sup_left (a := centerIn Q) (b := P) t.1.property)
              (le_sup_right (a := centerIn Q) (b := P) t.2.property)⟩
            : ↥(centerIn Q ⊔ P))) ?_
      rintro ⟨z1, a1⟩ ⟨z2, a2⟩ heq
      have hval : (z1 : G) * (a1 : G) = (z2 : G) * (a2 : G) := congrArg Subtype.val heq
      have e1 : (z1 : G) * ((a1 : G) * (a2 : G)⁻¹) = (z2 : G) := by
        rw [← mul_assoc, hval, mul_assoc, mul_inv_cancel, mul_one]
      have e2 : (z1 : G) * ((z1 : G)⁻¹ * (z2 : G)) = (z2 : G) := by
        rw [← mul_assoc, mul_inv_cancel, one_mul]
      have hkey : (a1 : G) * (a2 : G)⁻¹ = (z1 : G)⁻¹ * (z2 : G) :=
        mul_left_cancel (e1.trans e2.symm)
      have hmem1 : (z1 : G)⁻¹ * (z2 : G) ∈ centerIn Q :=
        mul_mem (inv_mem z1.property) z2.property
      have hmem2 : (z1 : G)⁻¹ * (z2 : G) ∈ P := by
        rw [← hkey]; exact mul_mem a1.property (inv_mem a2.property)
      have hbot : (z1 : G)⁻¹ * (z2 : G) = 1 := by
        have hmem : (z1 : G)⁻¹ * (z2 : G) ∈ centerIn Q ⊓ P :=
          Subgroup.mem_inf.mpr ⟨hmem1, hmem2⟩
        rwa [hZPbot, Subgroup.mem_bot] at hmem
      have hz : z1 = z2 := by
        refine Subtype.ext ?_
        have h4 : (z2 : G) = (z1 : G) := by
          have := congrArg (fun t : G => (z1 : G) * t) hbot
          simpa [mul_inv_cancel_left] using this
        exact h4.symm
      have ha : a1 = a2 := by
        refine Subtype.ext ?_
        have h5 : (a1 : G) * (a2 : G)⁻¹ = 1 := by rw [hkey, hbot]
        have h6 : (a1 : G) * (a2 : G)⁻¹ * (a2 : G) = (a2 : G) := by rw [h5, one_mul]
        rwa [mul_assoc, inv_mul_cancel, mul_one] at h6
      exact Prod.ext hz ha
    have hcardZP_le_A : Nat.card ↥(centerIn Q ⊔ P) ≤ Nat.card ↥A :=
      Nat.card_le_card_of_injective
        (fun t : ↥(centerIn Q ⊔ P) => (⟨(t : G), hZP_le_A t.property⟩ : ↥A))
        (by rintro ⟨a, ha⟩ ⟨b, hb⟩ h; exact Subtype.ext (by simpa using congrArg Subtype.val h))
    have hZ_card_mul : Nat.card ↥(centerIn Q) * p ≤ p ^ 2 := by
      have h1 : Nat.card (↥(centerIn Q) × ↥P) = Nat.card ↥(centerIn Q) * p := by
        rw [Nat.card_prod, hPcard]
      rw [← h1]
      exact le_trans hinjZP (le_trans hcardZP_le_A (le_of_eq hAcard))
    have hZcard_le : Nat.card ↥(centerIn Q) ≤ p := by
      have h := hZ_card_mul
      rw [pow_two] at h
      exact Nat.le_of_mul_le_mul_right h hp.pos
    have hZcard : Nat.card ↥(centerIn Q) = p := le_antisymm hZcard_le hp_le_cardZ
    have hZP_card : Nat.card ↥(centerIn Q ⊔ P) = p ^ 2 := by
      apply le_antisymm
      · rw [← hAcard]; exact hcardZP_le_A
      · have h1 : Nat.card ↥(centerIn Q) * p ≤ Nat.card ↥(centerIn Q ⊔ P) := by
          rw [← hPcard, ← Nat.card_prod]; exact hinjZP
        rw [hZcard] at h1
        rw [pow_two]
        exact h1
    have hAeq : A = centerIn Q ⊔ P :=
      (Subgroup.eq_of_le_of_card_ge hZP_le_A (by rw [hZP_card, hAcard])).symm
    have hAleQ : A ≤ Q := by
      rw [hAeq]; exact sup_le hZQle hPQ
    have hA_le_Qx : A ≤ Q ⊓ centralizer ({x} : Set G) := by
      rw [hAeq]
      exact sup_le (le_inf hZQle hZ_le_cx) (le_inf hPQ hP_le_cx)
    have hAeq2 : A = Q ⊓ centralizer ({x} : Set G) := le_antisymm hA_le_Qx hQx_le_A
    -- the commutator homomorphism `Q → Z(Q)`
    let x' : ↥Q := ⟨x, hxQ⟩
    have hx'Z : x' ∉ Subgroup.center ↥Q := by
      intro h
      exact hxZ (Subgroup.mem_map.mpr ⟨x', h, rfl⟩)
    have key : ∀ y : ↥Q, ⁅x', y⁆ ∈ Subgroup.center ↥Q := by
      intro y
      have hmem : Q.subtype ⁅x', y⁆ ∈ centerIn Q := by
        rw [map_commutatorElement]
        exact omega1_z2_commutator_mem_centerIn_self p R hxQ y.property
      obtain ⟨c, hc, hceq⟩ := Subgroup.mem_map.mp hmem
      have hceq' : ⁅x', y⁆ = c := (Subgroup.subtype_injective Q hceq).symm
      rw [hceq']; exact hc
    have hφmul : ∀ y z : ↥Q, ⁅x', y * z⁆ = ⁅x', y⁆ * ⁅x', z⁆ := by
      intro y z
      have hcomm : y * ⁅x', z⁆ = ⁅x', z⁆ * y := (Subgroup.mem_center_iff.mp (key z)) y
      rw [commutatorElement_mul_right_eq_mul_conj,
        show ⁅x', y⁆ * y * ⁅x', z⁆ * y⁻¹ = ⁅x', y⁆ * (y * ⁅x', z⁆) * y⁻¹ from by
          simp only [mul_assoc],
        hcomm]
      group
    let φ : ↥Q →* ↥Q :=
      { toFun := fun y => ⁅x', y⁆
        map_one' := by simp
        map_mul' := hφmul }
    have hrange_le : φ.range ≤ Subgroup.center ↥Q := by
      intro y hy
      obtain ⟨z, rfl⟩ := MonoidHom.mem_range.mp hy
      exact key z
    have hrange_ne : φ.range ≠ ⊥ := by
      intro hbot
      have hx'c : x' ∈ Subgroup.center ↥Q := by
        rw [Subgroup.mem_center_iff]
        intro w
        have hw : φ w = 1 := by
          have hmem : φ w ∈ φ.range := MonoidHom.mem_range.mpr ⟨w, rfl⟩
          rw [hbot] at hmem
          exact Subgroup.mem_bot.mp hmem
        change ⁅x', w⁆ = 1 at hw
        rw [commutatorElement_eq_one_iff_mul_comm] at hw
        exact hw.symm
      exact hx'Z hx'c
    have hcard_center : Nat.card ↥(Subgroup.center ↥Q) = p := by
      rw [← hcardZ]; exact hZcard
    have hrange_card : Nat.card ↥φ.range = p := by
      have hdvd : Nat.card ↥φ.range ∣ p := by
        have h := Subgroup.card_dvd_of_le hrange_le
        rwa [hcard_center] at h
      have h2lt : 1 < Nat.card ↥φ.range := (Subgroup.one_lt_card_iff_ne_bot _).mpr hrange_ne
      rcases (Nat.dvd_prime hp).mp hdvd with h | h
      · omega
      · exact h
    have hker : φ.ker = (Q ⊓ centralizer ({x} : Set G)).subgroupOf Q := by
      ext z
      rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
      constructor
      · intro hz
        refine Subgroup.mem_inf.mpr ⟨z.property, ?_⟩
        rw [Subgroup.mem_centralizer_iff]
        intro w hw
        rw [Set.mem_singleton_iff] at hw
        subst w
        change ⁅x', z⁆ = 1 at hz
        have h2 := commutatorElement_eq_one_iff_mul_comm.mp hz
        have h3 := congrArg (fun t : ↥Q => (t : G)) h2
        simp only [Subgroup.coe_mul] at h3
        exact h3
      · intro hz
        obtain ⟨-, hzc⟩ := Subgroup.mem_inf.mp hz
        change ⁅x', z⁆ = 1
        rw [commutatorElement_eq_one_iff_mul_comm]
        have h4 := (Subgroup.mem_centralizer_iff.mp hzc) x (Set.mem_singleton x)
        apply Subtype.ext
        simpa only [Subgroup.coe_mul] using h4
    have hker_eq : φ.ker = A.subgroupOf Q := by rw [hker, hAeq2]
    have hrelIndex : A.relIndex Q = p := by
      rw [Subgroup.relIndex, ← hker_eq, Subgroup.index_eq_card]
      rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv]
      exact hrange_card
    have hQcard : Nat.card ↥Q = p ^ 3 := by
      have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (φ.ker)
      have h2 : Nat.card (↥Q ⧸ φ.ker) = p := by
        rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv]
        exact hrange_card
      have h3 : Nat.card ↥φ.ker = p ^ 2 := by
        rw [hker_eq]
        exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAleQ).toEquiv).trans hAcard
      rw [h1, h2, h3]; ring
    have hZltA : centerIn Q < A := by
      refine lt_of_le_of_ne hZ_le_A ?_
      intro h
      have hp2 : p = p ^ 2 := by
        rw [← hAcard, ← hZcard]; rw [h]
      nlinarith [hp.two_le]
    have hAltQ : A < Q := by
      refine lt_of_le_of_ne hAleQ ?_
      intro h
      have hpq : p ^ 2 = p ^ 3 := by
        rw [← hAcard, ← hQcard]; rw [h]
      exact absurd hpq (ne_of_lt (Nat.pow_lt_pow_right hp.one_lt (by norm_num)))
    exact ⟨hAleQ, hZltA, hAltQ, hrelIndex⟩

end Work.CORE4
