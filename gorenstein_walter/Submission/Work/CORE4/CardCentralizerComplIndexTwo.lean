import Mathlib
import Submission.Work.L2F.Dihedral.centralizer_sr_subset
import Submission.Work.Dihedral.Defs
import Submission.Work.CORE4.CardCentralizerSr

namespace Work.CORE4

set_option linter.style.haveILetI false

/-! ## Auxiliary lemmas

The proof of `CardCentralizerComplIndexTwo` transports the centralizer of `s` inside `S` to the
centralizer of `e s` inside `DihedralGroup n` (`e : S ≃* DihedralGroup n`), where it is computed
directly: the image `T` of `S₀` is a cyclic subgroup of index two (`T = ⟨r⟩` for `n > 2`), so
`e s ∉ T` is a reflection, and the centralizer of a reflection in `DihedralGroup n` (`n` even) is
`{1, r (n/2), sr i, sr (i + n/2)}` (`Work.CORE4.CardCentralizerSr`).  The case `n = 2` is the Klein
four group, where every centralizer is the whole group. -/

/-- `DihedralGroup 2` is the Klein four group, hence commutative. -/
theorem dihedral_two_comm : ∀ a b : DihedralGroup 2, a * b = b * a := by decide

/-- In `DihedralGroup 2` (the Klein four group) every centralizer is the whole group, of order
`4`. -/
lemma card_centralizer_dihedral_two (x : DihedralGroup 2) :
    Nat.card ↥(Subgroup.centralizer ({x} : Set (DihedralGroup 2))) = 4 := by
  have htop : Subgroup.centralizer ({x} : Set (DihedralGroup 2)) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact dihedral_two_comm y x
  rw [htop, Subgroup.card_top, DihedralGroup.nat_card]

/-- The centralizer of `z` inside a subgroup `H ≤ G` has the cardinality of `H` intersected with
the centralizer of `z` in `G` (cardinality form of "the centralizer of `z` in `H` is the preimage
of `C_G(z)` under the inclusion `H → G`"). -/
lemma nat_card_centralizer_subtype {G : Type*} [Group G] (H : Subgroup G) (z : ↥H) :
    Nat.card ↥(Subgroup.centralizer ({z} : Set ↥H)) =
      Nat.card ↥(H ⊓ Subgroup.centralizer ({(z : G)} : Set G)) := by
  have hcomap : Subgroup.comap H.subtype (Subgroup.centralizer ({(z : G)} : Set G)) =
      Subgroup.centralizer ({z} : Set ↥H) := by
    ext x
    simp only [Subgroup.mem_comap, Subgroup.mem_centralizer_singleton_iff]
    constructor
    · intro h; exact Subtype.ext h
    · intro h; exact congrArg Subtype.val h
  have hmap := Subgroup.map_comap_eq H.subtype (Subgroup.centralizer ({(z : G)} : Set G))
  rw [hcomap, Subgroup.range_subtype] at hmap
  rw [← hmap, Subgroup.card_subtype]

/-- The cardinality of the centralizer of an element transports along an isomorphism. -/
lemma nat_card_centralizer_mulEquiv {S H : Type*} [Group S] [Group H] (e : S ≃* H) (z : S) :
    Nat.card ↥(Subgroup.centralizer ({z} : Set S)) =
      Nat.card ↥(Subgroup.centralizer ({e z} : Set H)) := by
  have hmap : (Subgroup.centralizer ({z} : Set S)).map e.toMonoidHom =
      Subgroup.centralizer ({e z} : Set H) := by
    ext x
    rw [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff]
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [Subgroup.mem_centralizer_singleton_iff] at hy
      simpa using congrArg (fun t => e.toMonoidHom t) hy
    · intro hx
      refine ⟨e.symm x, ?_, by simp⟩
      rw [Subgroup.mem_centralizer_singleton_iff]
      apply e.injective
      simpa using hx
  rw [← hmap, Subgroup.card_map_of_injective e.injective]

/-- **A cyclic subgroup of index two in `DihedralGroup n` (`n > 2`) is the rotation subgroup.**
(`n = 2` is the genuine exception: `DihedralGroup 2` is the Klein four group, all of whose index
two subgroups are cyclic of order `2`.)

`T` is generated by an element `g` of order `n > 2`; `g` cannot be a reflection, so `g ∈ ⟨r⟩` and
`T ≤ ⟨r⟩`, and both have `n` elements. -/
lemma cyclic_relIndex_two_eq_rot {n : ℕ} (hn : 2 < n) (T : Subgroup (DihedralGroup n))
    (hcyc : IsCyclic ↥T) (hidx : T.relIndex ⊤ = 2) : T = Work.Dihedral.rot n := by
  haveI : NeZero n := ⟨by omega⟩
  have hcardT : Nat.card ↥T = n := by
    have h := Subgroup.relIndex_mul_card T ⊤
    rw [hidx, inf_top_eq, Subgroup.card_top, DihedralGroup.nat_card] at h
    exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 2) h
  obtain ⟨g, hg⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top T).mp hcyc
  have hordg : orderOf g = n := by rw [← Nat.card_zpowers g, hg, hcardT]
  have hgR : g ∈ Work.Dihedral.rot n := by
    rcases Work.Dihedral.eq_r_or_sr g with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact Work.Dihedral.r_mem_rot i
    · rw [DihedralGroup.orderOf_sr] at hordg
      omega
  have hTR : T ≤ Work.Dihedral.rot n := by
    rw [← hg]
    exact Subgroup.zpowers_le.mpr hgR
  exact Subgroup.eq_of_le_of_card_ge hTR (by rw [Work.Dihedral.nat_card_rot, hcardT])

/-- Let `S ≅ DihedralGroup n` with `n ≥ 2` even, and let `S₀ ≤ S` be a *cyclic* subgroup of index
two in `S`.  Then for every `s ∈ S \ S₀` the centralizer of `s` inside `S` has order `4`
(it is the Klein four-group `⟨s, t⟩` where `t` is the central involution of `S`).

Mathematically: `e(S₀)` is a cyclic subgroup of `DihedralGroup n` of index two, hence (for
`n ≥ 3`) it is the rotation subgroup `⟨r⟩`; for `n = 2` every non-identity element does the job.
So `e(s) = sr i` is a reflection, and the centralizer of `sr i` in `DihedralGroup n` (`n` even)
is `{1, r (n/2), sr i, sr (i + n/2)}`.

Likely useful existing input: `Work.L2F.Dihedral.centralizer_sr_subset`, which already proves
`C(sr i) ⊆ {1, r (m/2), sr i, sr (i + m/2)}` for every `m`; the work here is to identify the
cyclic index-two subgroup with the rotations and to show the four elements are distinct and lie in
the centralizer (using `Even n` for `r (n/2)`). -/
theorem CardCentralizerComplIndexTwo {G : Type} [Group G] [Finite G] (n : ℕ) (hn : 2 ≤ n)
    (hnEven : Even n) (S S0 : Subgroup G) (hS0 : S0 ≤ S) (hidx : S0.relIndex S = 2)
    (hcyc : IsCyclic S0) (hdih : Nonempty (S ≃* DihedralGroup n)) (s : G) (hs : s ∈ S)
    (hs0 : s ∉ S0) :
    Nat.card ↥(S ⊓ Subgroup.centralizer ({s} : Set G)) = 4 := by
  obtain ⟨e⟩ := hdih
  -- Pass to the centralizer of `s` inside `S`, then transport it along `e` to `DihedralGroup n`.
  rw [← nat_card_centralizer_subtype S ⟨s, hs⟩, nat_card_centralizer_mulEquiv e ⟨s, hs⟩]
  set x : DihedralGroup n := e ⟨s, hs⟩ with hxdef
  -- The image `T` of `S₀` in `DihedralGroup n`.
  set T : Subgroup (DihedralGroup n) := (S0.subgroupOf S).map e.toMonoidHom with hT
  have hcardS : Nat.card ↥S = 2 * n := by
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hcardS0 : Nat.card ↥S0 = n := by
    have h := Subgroup.relIndex_mul_card S0 S
    rw [hidx, inf_eq_left.mpr hS0] at h
    rw [hcardS] at h
    exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 2) h
  have hcardT : Nat.card ↥T = n := by
    rw [hT, ← Nat.card_congr
        (Subgroup.equivMapOfInjective (S0.subgroupOf S) e.toMonoidHom e.injective).toEquiv,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS0).toEquiv]
    exact hcardS0
  have hcycT : IsCyclic ↥T := by
    rw [hT]
    exact (Subgroup.equivMapOfInjective (S0.subgroupOf S) e.toMonoidHom e.injective).isCyclic.mp
      ((Subgroup.subgroupOfEquivOfLe hS0).isCyclic.mpr hcyc)
  have hidxT : T.relIndex ⊤ = 2 := by
    have h := Subgroup.relIndex_mul_card T ⊤
    rw [inf_top_eq, Subgroup.card_top, DihedralGroup.nat_card, hcardT] at h
    exact Nat.mul_right_cancel (by omega : 0 < n) h
  have hxT : x ∉ T := by
    rw [hxdef, hT, Subgroup.mem_map]
    rintro ⟨y, hy, hye⟩
    rw [Subgroup.mem_subgroupOf] at hy
    rw [e.injective hye] at hy
    exact hs0 hy
  rcases eq_or_ne n 2 with hn2 | hn2
  · -- `n = 2`: `DihedralGroup 2` is the Klein four group, so every centralizer is the whole
    -- group, of order `4`.
    subst hn2
    exact card_centralizer_dihedral_two x
  · -- `n ≥ 3`: `T` is the rotation subgroup, so `x` is a reflection.
    have hn3 : 3 ≤ n := by omega
    have hTrot : T = Work.Dihedral.rot n :=
      cyclic_relIndex_two_eq_rot (by omega) T hcycT hidxT
    have hxrot : x ∉ Work.Dihedral.rot n := by rw [← hTrot]; exact hxT
    obtain ⟨i, hi⟩ := Work.Dihedral.notMem_rot.mp hxrot
    rw [hi]
    exact CardCentralizerSr (by omega) hnEven i

end Work.CORE4
