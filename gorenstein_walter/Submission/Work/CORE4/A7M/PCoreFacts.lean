/-
Copied from `Submission/Work/A7F/pCore_facts.lean` with the import list adapted to the
CORE4 world (see the note below); the `Work.A7F` content is unchanged.

**Why a copy:**  the areas of this workspace each carry their own verbatim copy of the `Work.GW2`
vocabulary (`Contracts2.lean`), and two of them cannot be imported into one environment
(`environment already contains 'Work.GW2.A7ModelProp'`).  This file therefore takes the
`Work.GW2` vocabulary from `Submission.Work.CORE4.Defs` and imports `Submission.Work.A7.Defs`
(clash-free) instead of `Submission.Work.A7F.Defs`.
-/
import Mathlib
import Submission.Work.CORE4.Defs
import Submission.Work.A7.Defs
import Submission.Work.CORE4.A7M.Defs
import Submission.Work.CORE4.A7M.Four
import Submission.Work.CORE4.A7M.PCoreDefs
import Submission.Work.CORE4.A7M.CardCent

open scoped MatrixGroups

namespace Work.A7F

open Subgroup

/-! ## Inclusions -/

/-- `V₁ ⊆ a7S`. -/
theorem a7V1_le_a7S : a7V1 ≤ a7S := by
  rw [show a7V1 = Subgroup.closure ({a7Invol, a7D1} : Set (alternatingGroup (Fin 7))) from rfl,
    Subgroup.closure_le]
  intro x hx
  change inS x
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))

/-- `V₁ ⊆ a7S2`. -/
theorem a7V1_le_a7S2 : a7V1 ≤ a7S2 := by
  rw [show a7V1 = Subgroup.closure ({a7Invol, a7D1} : Set (alternatingGroup (Fin 7))) from rfl,
    Subgroup.closure_le]
  intro x hx
  change inS2 x
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))

/-- `a7S ⊆ C_{A₇}(t)`. -/
theorem a7S_le_centralizer :
    a7S ≤ Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))) := by
  intro z hz
  rw [Subgroup.mem_centralizer_singleton_iff]
  rw [mem_a7S] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide

/-- `a7S2 ⊆ C_{A₇}(t)`. -/
theorem a7S2_le_centralizer :
    a7S2 ≤ Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))) := by
  intro z hz
  rw [Subgroup.mem_centralizer_singleton_iff]
  rw [mem_a7S2] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide

/-- `(2 3)(5 6) ∈ a7S`. -/
theorem a7y_mem_a7S : a7y ∈ a7S := by
  rw [mem_a7S]; exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))

/-- `(2 3)(5 6) ∉ a7S2`, so `a7S ≠ a7S2`. -/
theorem a7y_notMem_a7S2 : a7y ∉ a7S2 := by
  rw [mem_a7S2]; simp only [inS2]; decide

/-- `a7S ≠ a7S2`. -/
theorem a7S_ne_a7S2 : a7S ≠ a7S2 := fun h => a7y_notMem_a7S2 (h ▸ a7y_mem_a7S)

/-! ## Normality of `V₁` in `C_{A₇}(t)` -/

/-- Every element of `a7S` normalizes `V₁`. -/
theorem a7S_le_normalizer :
    a7S ≤ Subgroup.normalizer (a7V1 : Set (alternatingGroup (Fin 7))) := by
  rw [Subgroup.le_normalizer_iff]
  intro h hh k hk
  rw [mem_a7S] at hh
  rw [mem_a7V1_iff] at hk ⊢
  simp only [inS, inV1] at hh hk ⊢
  rcases hh with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    rcases hk with rfl | rfl | rfl | rfl <;> decide

/-- The order `3` subgroup `⟨(4 5 6)⟩` normalizes `V₁` (disjoint supports). -/
theorem a7zpowers_le_normalizer :
    Subgroup.zpowers Work.A7.a7ThreeCycle ≤
      Subgroup.normalizer (a7V1 : Set (alternatingGroup (Fin 7))) := by
  have hc : Work.A7.a7ThreeCycle ∈
      Subgroup.centralizer (a7V1 : Set (alternatingGroup (Fin 7))) := by
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    have hh' : h ∈ a7V1 := hh
    rw [mem_a7V1_iff] at hh'
    rcases hh' with rfl | rfl | rfl | rfl <;> decide
  calc Subgroup.zpowers Work.A7.a7ThreeCycle
      ≤ Subgroup.centralizer (a7V1 : Set (alternatingGroup (Fin 7))) :=
        Subgroup.zpowers_le.mpr hc
    _ ≤ Subgroup.normalizer (a7V1 : Set (alternatingGroup (Fin 7))) :=
        Subgroup.centralizer_le_normalizer _

/-- **`C_{A₇}(t)` is generated by `a7S` and `(4 5 6)`.** -/
theorem a7S_sup_threeCycle :
    a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle =
      Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))) := by
  have hKle : Subgroup.zpowers Work.A7.a7ThreeCycle ≤
      Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))) := by
    rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
    decide
  have hcardK : Nat.card ↥(Subgroup.zpowers Work.A7.a7ThreeCycle) = 3 := by
    rw [Nat.card_zpowers, Work.A7.orderOf_a7ThreeCycle]
  -- `|a7S ⊔ ⟨c⟩|` is divisible by `8 = |a7S|` and by `3 = |⟨c⟩|`, hence by `24`.
  have h8 : 8 ∣ Nat.card ↥(a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle) := by
    have := Subgroup.card_dvd_of_le (le_sup_left : a7S ≤ a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle)
    rwa [card_a7S] at this
  have h3 : 3 ∣ Nat.card ↥(a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle) := by
    have := Subgroup.card_dvd_of_le
      (le_sup_right : Subgroup.zpowers Work.A7.a7ThreeCycle ≤
        a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle)
    rwa [hcardK] at this
  have h24 : 24 ≤ Nat.card ↥(a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle) := by
    have hdvd : 24 ∣ Nat.card ↥(a7S ⊔ Subgroup.zpowers Work.A7.a7ThreeCycle) := by
      have := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num : Nat.Coprime 8 3) h8 h3
      simpa using this
    exact Nat.le_of_dvd Nat.card_pos hdvd
  refine Subgroup.eq_of_le_of_card_ge (sup_le a7S_le_centralizer hKle) ?_
  rw [card_centralizer_a7Invol]
  exact h24

end Work.A7F
