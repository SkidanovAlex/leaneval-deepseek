import Mathlib
import Submission.Work.CORE4.Defs
import Submission.Work.CORE4.API
import Submission.Work.CORE4.CountSetup

open scoped commutatorElement

namespace Work.CORE4.A7KBound

open Subgroup

/-- **A commutator with a subgroup of a normal subgroup.**  Let `N ⊴ M` as subgroups of `G`
(i.e. `M` normalizes `N`), `A ≤ N` and `B ≤ M`.  Then `⁅A, B⁆ ≤ N`.

Indeed, for `a ∈ A` and `b ∈ B` we have `b * a * b⁻¹ ∈ N` (as `M ≤ N_G(N)`), and
`⁅a, b⁆ = a * (b * a * b⁻¹)⁻¹ ∈ N`. -/
theorem commutator_le_of_le_normalizer {G : Type*} [Group G] {N M A B : Subgroup G}
    (hA : A ≤ N) (hM : M ≤ Subgroup.normalizer (N : Set G)) (hB : B ≤ M) : ⁅A, B⁆ ≤ N := by
  refine Subgroup.commutator_le.mpr ?_
  intro a ha b hb
  rw [show ⁅a, b⁆ = a * (b * a * b⁻¹)⁻¹ from by rw [commutatorElement_def]; group]
  exact N.mul_mem (hA ha)
    (N.inv_mem ((Subgroup.le_normalizer_iff.mp hM) b (hB hb) a (hA ha)))

/-- For the §4 objects of Bender 1981 (`Case2Data B`), with Bender's (1) `K = [S ∩ E, U ∩ M]`
supplied as `Case2PrePlus B D` and `U = O(H)` of odd order:

* `K ≤ E(M) = layerIn D.M`: `K = ⁅S ∩ E, U ∩ M⁆` is generated by commutators of elements of
  `E(M)` with elements of `M ⊇ U ∩ M`, and `E(M) ⊴ M`;
* `K ⊓ Z(E(M)) = 1`: `s ∈ S ∩ E(M)` centralizes `Z(E(M))` and inverts `K = I_{U∩M}(s)`
  (`Case2Data.K_inv`), so `x ∈ K ⊓ Z(E(M))` satisfies `x = x⁻¹`, i.e. `x ^ 2 = 1`; but
  `x ∈ K ≤ U` has odd order, so `x = 1`. -/
theorem K_le_layerIn_and_inf_center {G : Type} [Group G] [Finite G]
    {B : Work.GW2.BenderSetup G} {D : Work.GW2.Case2Data B}
    (hplus : Work.GW2.Case2PrePlus B D) (hUodd : Odd (Nat.card ↑B.U)) :
    D.K ≤ Work.GW2.layerIn D.M ∧
      D.K ⊓ (Subgroup.center ↥(Work.GW2.layerIn D.M)).map
        (Work.GW2.layerIn D.M).subtype = ⊥ := by
  -- `E = E(M) = layerIn D.M` and `E ⊴ M`
  have hME : D.M ≤ Subgroup.normalizer ((Work.GW2.layerIn D.M : Subgroup G) : Set G) :=
    Work.CORE4.layerIn_le_normalizer D.M
  constructor
  · -- `K = ⁅S ∩ E, U ∩ M⁆ ≤ E`, as `S ∩ E ≤ E` and `U ∩ M ≤ M` normalizes `E`
    rw [hplus.2.1]
    exact commutator_le_of_le_normalizer inf_le_right hME inf_le_right
  · -- `K ⊓ Z(E) = 1`
    rw [eq_bot_iff]
    intro x hx
    rw [Subgroup.mem_inf] at hx
    obtain ⟨hxK, hxZ⟩ := hx
    -- `x ∈ Z(E)` means that `x ∈ E` commutes with every element of `E`, in particular with `s`
    rw [Subgroup.mem_map] at hxZ
    obtain ⟨y, hycen, hyx⟩ := hxZ
    have hxE : x ∈ Work.GW2.layerIn D.M := by rw [← hyx]; exact y.2
    have hcomm : D.s * x = x * D.s := by
      have h := Subgroup.mem_center_iff.mp hycen ⟨D.s, Work.GW2.Case2Data.s_mem_layer B D⟩
      have h' := congrArg (Subgroup.subtype (Work.GW2.layerIn D.M)) h
      simp only [map_mul, hyx] at h'
      simpa using h'
    -- and `s` inverts `x ∈ K = I_{U∩M}(s)`, so `x = x⁻¹`
    have hsx : D.s * x * D.s⁻¹ = x := by
      rw [hcomm]; group
    have hxinv : x⁻¹ = x := by
      rw [← (Work.GW2.Case2Data.K_inv B D) x hxK, hsx]
    -- hence `x ^ 2 = 1`, i.e. `orderOf x ∣ 2`, while `x ∈ K ≤ U` has odd order
    have hx2 : x ^ 2 = 1 := by
      have h2 : x * x⁻¹ = 1 := mul_inv_cancel x
      rw [hxinv] at h2
      rwa [pow_two]
    have hdvd2 : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hx2
    have hdvdU : orderOf x ∣ Nat.card ↥B.U := by
      have h := Subgroup.card_dvd_of_le (H := Subgroup.zpowers x) (K := B.U)
        (Subgroup.zpowers_le.mpr (Work.GW2.Case2Data.K_le_U B D hxK))
      rwa [Nat.card_zpowers] at h
    have hodd : Odd (orderOf x) := by
      rw [← Nat.not_even_iff_odd]
      intro hev
      exact (Nat.not_even_iff_odd.mpr hUodd) (hev.trans_dvd hdvdU)
    -- so `orderOf x = 1` and `x = 1`
    have ho1 : orderOf x = 1 :=
      Nat.Coprime.eq_one_of_dvd (Nat.coprime_two_right.mpr hodd) hdvd2
    exact Subgroup.mem_bot.mpr (orderOf_eq_one_iff.mp ho1)

end Work.CORE4.A7KBound
