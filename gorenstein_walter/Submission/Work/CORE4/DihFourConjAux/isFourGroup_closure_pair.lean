import Mathlib

/-!
# The subgroup generated by two distinct commuting involutions is a Klein four-group

If `a, b` are distinct, nontrivial, commuting involutions of a group `G`, then
`⟨{a, b}⟩ = {1, a, b, a * b}` has exactly four elements, every one of which is an involution;
consequently `⟨{a, b}⟩` is a `2`-group.  This is the Klein four-group generated by `a` and `b`.

The main ingredients are the description `mem_closure_pair` of the elements of the subgroup
generated by two commuting involutions (proved by induction on the closure), the resulting
set equality `closure_pair_eq`, and the counting of the explicit four-element set
`{1, a, b, a * b}`.
-/

namespace Work.CORE4.DihFourConjAux

/-- **Membership in the subgroup generated by two commuting involutions.**
If `u` and `v` are commuting involutions of a group, then `⟨{u, v}⟩` consists exactly of the
four elements `1, u, v, u * v`. -/
theorem mem_closure_pair {G : Type*} [Group G] {u v x : G}
    (hu : u ^ 2 = 1) (hv : v ^ 2 = 1) (hc : u * v = v * u) :
    x ∈ Subgroup.closure ({u, v} : Set G) ↔ x = 1 ∨ x = u ∨ x = v ∨ x = u * v := by
  have hu2 : u * u = 1 := by simpa [pow_two] using hu
  have hv2 : v * v = 1 := by simpa [pow_two] using hv
  have hvu : v * u = u * v := hc.symm
  have huuv : u * (u * v) = v := by rw [← mul_assoc, hu2, one_mul]
  have huvv : (u * v) * v = u := by rw [mul_assoc, hv2, mul_one]
  have hvuv : v * (u * v) = u := by rw [← mul_assoc, ← hc, huvv]
  have huvu : (u * v) * u = v := by rw [mul_assoc, ← hc, ← mul_assoc, hu2, one_mul]
  have huvuv : (u * v) * (u * v) = 1 := by rw [← mul_assoc, huvu, hv2]
  have hui : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu2
  have hvi : v⁻¹ = v := inv_eq_of_mul_eq_one_right hv2
  have huvi : (u * v)⁻¹ = u * v := inv_eq_of_mul_eq_one_right huvuv
  constructor
  · intro hx
    refine Subgroup.closure_induction (k := ({u, v} : Set G))
      (p := fun y _ => y ∈ ({1, u, v, u * v} : Set G)) ?_ ?_ ?_ ?_ hx
    · rintro y hy
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl <;> simp
    · simp
    · rintro x y _ _ hx' hy'
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx' hy'
      rcases hx' with rfl | rfl | rfl | rfl <;> rcases hy' with rfl | rfl | rfl | rfl <;>
        simp [hu2, hv2, hvu, huuv, hvuv, huvu, huvv, huvuv]
    · rintro x _ hx'
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx'
      rcases hx' with rfl | rfl | rfl | rfl <;> simp [hui, hvi, huvi]
  · rintro (rfl | rfl | rfl | rfl)
    · exact one_mem _
    · exact Subgroup.subset_closure (by simp)
    · exact Subgroup.subset_closure (by simp)
    · exact mul_mem (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp))

/-- For commuting involutions `u`, `v` of a group, the subgroup they generate is exactly the
set `{1, u, v, u * v}`. -/
theorem closure_pair_eq {G : Type*} [Group G] {u v : G}
    (hu : u ^ 2 = 1) (hv : v ^ 2 = 1) (hc : u * v = v * u) :
    (Subgroup.closure ({u, v} : Set G) : Set G) = {1, u, v, u * v} := by
  ext x
  exact (mem_closure_pair hu hv hc).trans
    (by simp only [Set.mem_insert_iff, Set.mem_singleton_iff])

/-- The subgroup generated by two distinct commuting involutions is a Klein four-group. -/
theorem isFourGroup_closure_pair {G : Type} [Group G] {a b : G}
    (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1) (hcomm : a * b = b * a)
    (ha1 : a ≠ 1) (hb1 : b ≠ 1) (hab : a ≠ b) :
    Nat.card (Subgroup.closure ({a, b} : Set G)) = 4 ∧
      (∀ v ∈ Subgroup.closure ({a, b} : Set G), v ^ 2 = 1) ∧
      IsPGroup 2 (Subgroup.closure ({a, b} : Set G)) := by
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using ha2)
  -- `a * b = 1` would force `a = b` (as `b⁻¹ = a` while `a⁻¹ = a`), contradicting `a ≠ b`.
  have hab1 : a * b ≠ 1 :=
    fun h => hab (hai.symm.trans (inv_eq_of_mul_eq_one_right h))
  -- the four elements `1, a, b, a * b` are pairwise distinct
  have h1a : (1 : G) ≠ a := ha1.symm
  have h1b : (1 : G) ≠ b := hb1.symm
  have h1ab : (1 : G) ≠ a * b := hab1.symm
  have haab : a ≠ a * b := by
    intro h
    have h1 : a⁻¹ * a = a⁻¹ * (a * b) := congrArg (fun t => a⁻¹ * t) h
    rw [inv_mul_cancel, ← mul_assoc, inv_mul_cancel, one_mul] at h1
    exact hb1 h1.symm
  have hbab : b ≠ a * b := by
    intro h
    have h1 : b * b⁻¹ = a * b * b⁻¹ := congrArg (fun t => t * b⁻¹) h
    rw [mul_inv_cancel, mul_assoc, mul_inv_cancel, mul_one] at h1
    exact ha1 h1.symm
  have hset : (Subgroup.closure ({a, b} : Set G) : Set G) = {1, a, b, a * b} :=
    closure_pair_eq ha2 hb2 hcomm
  -- counting the four distinct elements
  have h3 : ({b, a * b} : Set G).ncard = 2 := Set.ncard_pair hbab
  have h2 : ({a, b, a * b} : Set G).ncard = 3 := by
    rw [Set.ncard_insert_of_notMem (by simp [hab, haab]), h3]
  have h4 : ({1, a, b, a * b} : Set G).ncard = 4 := by
    rw [Set.ncard_insert_of_notMem (by simp [h1a, h1b, h1ab]), h2]
  have hcard : Nat.card (Subgroup.closure ({a, b} : Set G)) = 4 := by
    change Nat.card ↥((Subgroup.closure ({a, b} : Set G)) : Set G) = 4
    rw [Nat.card_coe_set_eq, hset, h4]
  refine ⟨hcard, ?_, ?_⟩
  · intro v hv
    rw [mem_closure_pair (u := a) (v := b) ha2 hb2 hcomm] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact one_pow 2
    · exact ha2
    · exact hb2
    · have hc : Commute a b := hcomm
      rw [hc.mul_pow, ha2, hb2, one_mul]
  · exact IsPGroup.of_card (p := 2) (n := 2) (by rw [hcard]; norm_num)

end Work.CORE4.DihFourConjAux
