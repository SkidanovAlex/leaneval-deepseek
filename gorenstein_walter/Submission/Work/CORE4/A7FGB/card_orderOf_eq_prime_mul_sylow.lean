import Mathlib

namespace Work.CORE4.A7FGB

set_option linter.style.haveILetI false

/-- Counting bridge: the number of elements of a finite type satisfying a decidable predicate
equals the cardinality of the corresponding subtype. -/
private lemma card_filter_univ_eq_card_subtype {α : Type*} [Fintype α] (q : α → Prop)
    [DecidablePred q] :
    (Finset.univ.filter q).card = Nat.card {x : α // q x} := by
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype]

/-- When `p` occurs to the first power in `Nat.card G`, the subgroups of order `p` are exactly the
Sylow `p`-subgroups: `X ↦ Sylow.ofCard X` is a bijection. -/
private noncomputable def sylowEquivOfFactorization {G : Type*} [Group G] [Finite G] {p : ℕ}
    [Fact p.Prime] (hf : (Nat.card G).factorization p = 1) :
    {X : Subgroup G // Nat.card X = p} ≃ Sylow p G where
  toFun X := Sylow.ofCard X.1 (by rw [X.2, hf, pow_one])
  invFun P := ⟨(P : Subgroup G), by rw [Sylow.card_eq_multiplicity, hf, pow_one]⟩
  left_inv X := Subtype.ext rfl
  right_inv P := Sylow.ext rfl

/-- **Counting elements of order `p` in terms of Sylow `p`-subgroups.**
If `Nat.card G = p * m` with `p` prime and `p ∤ m`, then `p` divides `Nat.card G` exactly once, so
the Sylow `p`-subgroups are precisely the subgroups of order `p`.  Each such subgroup contributes
exactly `p - 1` elements of order `p` (its non-identity elements), and distinct such subgroups
meet trivially; double counting yields the formula. -/
theorem card_orderOf_eq_prime_mul_sylow {G : Type*} [Group G] [Finite G]
    {p m : ℕ} [Fact p.Prime] (hG : Nat.card G = p * m) (hm : ¬ p ∣ m) :
    Nat.card {g : G // orderOf g = p} = (p - 1) * Nat.card (Sylow p G) := by
  classical
  have hp : p.Prime := Fact.out
  haveI : Fintype G := Fintype.ofFinite G
  haveI : Fintype (Subgroup G) := Fintype.ofFinite (Subgroup G)
  haveI : Fintype (Sylow p G) := Fintype.ofFinite (Sylow p G)
  -- `p` divides the group order exactly once.
  have hm0 : m ≠ 0 := by
    intro h
    rw [h, mul_zero] at hG
    exact (Nat.card_pos (α := G)).ne' hG
  have hfac : (Nat.card G).factorization p = 1 := by
    rw [hG, Nat.factorization_mul hp.ne_zero hm0]
    simp [hp.factorization_self, Nat.factorization_eq_zero_of_not_dvd hm]
  -- Every non-identity element of a subgroup of order `p` has order `p`.
  have horder : ∀ (X : Subgroup G), Nat.card X = p → ∀ x ∈ X, x ≠ 1 → orderOf x = p := by
    intro X hX x hx hx1
    have hdvd : orderOf (⟨x, hx⟩ : X) ∣ Nat.card X := orderOf_dvd_natCard _
    have hdvd2 : orderOf x ∣ p := by
      rw [← (Subgroup.orderOf_coe (⟨x, hx⟩ : X)), hX] at hdvd
      exact hdvd
    rcases (Nat.dvd_prime hp).mp hdvd2 with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hx1
    · exact h
  -- A subgroup of order `p` is generated by each of its non-identity elements.
  have hgen : ∀ (X : Subgroup G) (a : G), Nat.card X = p → a ∈ X → a ≠ 1 →
      Subgroup.zpowers a = X := by
    intro X a hX ha ha1
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le_of_mem ha) ?_
    rw [Nat.card_zpowers, horder X hX a ha ha1, hX]
  -- The finite sets of elements of order `p` and of subgroups of order `p`.
  set S : Finset G := Finset.univ.filter (fun x => orderOf x = p) with hS
  set T : Finset (Subgroup G) := Finset.univ.filter (fun X => Nat.card X = p) with hT
  set fib : Subgroup G → Finset G := fun X => Finset.univ.filter (fun x => x ∈ X ∧ x ≠ 1)
    with hfib
  -- The elements of order `p` are the disjoint union of the non-identity parts of the subgroups
  -- of order `p`.
  have hcover : S = T.biUnion fib := by
    ext x
    simp only [hS, hT, hfib, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_biUnion]
    constructor
    · intro hx
      refine ⟨Subgroup.zpowers x, ?_, Subgroup.mem_zpowers x, ?_⟩
      · rw [Nat.card_zpowers, hx]
      · rintro rfl
        rw [orderOf_one] at hx
        exact hp.ne_one hx.symm
    · rintro ⟨X, hXc, hxX, hxne⟩
      exact horder X hXc x hxX hxne
  have hdisj : (↑T : Set (Subgroup G)).PairwiseDisjoint fib := by
    intro X hX Y hY hXY
    rw [Finset.mem_coe] at hX hY
    change Disjoint (fib X) (fib Y)
    rw [Finset.disjoint_left]
    intro a haX haY
    have hXc : Nat.card X = p := (Finset.mem_filter.mp hX).2
    have hYc : Nat.card Y = p := (Finset.mem_filter.mp hY).2
    have haX' : a ∈ X := (Finset.mem_filter.mp haX).2.1
    have haY' : a ∈ Y := (Finset.mem_filter.mp haY).2.1
    have hane : a ≠ 1 := (Finset.mem_filter.mp haX).2.2
    exact hXY ((hgen X a hXc haX' hane).symm.trans (hgen Y a hYc haY' hane))
  -- Each subgroup of order `p` contributes exactly `p - 1` elements of order `p`.
  have hfiber : ∀ X ∈ T, (fib X).card = p - 1 := by
    intro X hX
    have hXc : Nat.card X = p := (Finset.mem_filter.mp hX).2
    haveI : Fintype X := Fintype.ofFinite X
    have hcardX : Fintype.card X = p := by rw [← Nat.card_eq_fintype_card]; exact hXc
    change (Finset.univ.filter (fun x : G => x ∈ X ∧ x ≠ 1)).card = p - 1
    have himg : (Finset.univ.filter (fun x : G => x ∈ X ∧ x ≠ 1))
        = (Finset.univ.filter (fun y : X => y ≠ 1)).image Subtype.val := by
      ext a
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
      constructor
      · rintro ⟨haX, hane⟩
        exact ⟨⟨a, haX⟩, by simpa using hane, rfl⟩
      · rintro ⟨y, hy, rfl⟩
        exact ⟨y.2, by simpa using hy⟩
    rw [himg, Finset.card_image_of_injective _ Subtype.val_injective,
      Finset.filter_ne' Finset.univ (1 : X),
      Finset.card_erase_of_mem (Finset.mem_univ (1 : X)), Finset.card_univ, hcardX]
  -- Double counting.
  have hcount : S.card = T.card * (p - 1) := by
    rw [hcover, Finset.card_biUnion hdisj,
      Finset.sum_congr rfl (fun X hX => hfiber X hX), Finset.sum_const, nsmul_eq_mul,
      Nat.cast_id]
  have hS_card : S.card = Nat.card {g : G // orderOf g = p} :=
    card_filter_univ_eq_card_subtype _
  have hT_card : T.card = Nat.card {X : Subgroup G // Nat.card X = p} :=
    card_filter_univ_eq_card_subtype _
  have hSylow : Nat.card {X : Subgroup G // Nat.card X = p} = Nat.card (Sylow p G) :=
    Nat.card_congr (sylowEquivOfFactorization hfac)
  rw [← hS_card, hcount, hT_card, hSylow]
  exact Nat.mul_comm _ _

end Work.CORE4.A7FGB
