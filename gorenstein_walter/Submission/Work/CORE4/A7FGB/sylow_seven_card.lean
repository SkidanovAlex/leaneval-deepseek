/-
The `A₇` exceptional case of the Gorenstein--Walter theorem: counting the Sylow `7`-subgroups
of a subgroup `R ≤ A₇` of order `252`, and the elements of order `7` that `R` contains.

Mathematical content.  Since `7 ^ 2 ∤ 252`, the Sylow `7`-subgroups of such an `R` are exactly
its subgroups of order `7`, and every element of order `7` generates one of them.  Cauchy's
theorem gives an element `c ∈ R` of order `7`, which as a permutation of `Fin 7` is a `7`-cycle
(an element of order `7` in `Sym 7` fixes no point), in particular it is transitive.  Any element
of `Sym 7` commuting with a transitive permutation is a power of it, so the centralizer of `c`
in `R` is `⟨c⟩` and the conjugacy class of `c` in `R` has `252 / 7 = 36` elements, all of order
`7`.  Hence `R` has at least `36` elements of order `7`, i.e. at least `6` Sylow `7`-subgroups.
Sylow's third theorem gives `n₇ ∣ 36` and `n₇ ≡ 1 (mod 7)`, forcing `n₇ = 36`; the elements of
order `7` are then the non-identity elements of the `36` Sylow subgroups, giving `6 * 36 = 216`.
-/
import Mathlib
import Submission.Work.CORE4.A7FGB.card_orderOf_eq_prime_mul_sylow

set_option linter.style.haveILetI false

namespace Work.CORE4.A7FGB

open Equiv Equiv.Perm

/-- If `σ` is a transitive permutation (its orbit of `a` is everything) then every permutation
commuting with `σ` is a power of `σ`. -/
theorem mem_zpowers_of_commute_of_trans {α : Type*} (σ g : Equiv.Perm α) (a : α)
    (htrans : ∀ b : α, ∃ n : ℕ, (σ ^ n) a = b) (hcomm : g * σ = σ * g) :
    g ∈ Subgroup.zpowers σ := by
  obtain ⟨n, hn⟩ := htrans (g a)
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨n, ?_⟩
  have hc : Commute g σ := hcomm
  ext b
  obtain ⟨m, hm⟩ := htrans b
  calc (σ ^ n) b = (σ ^ n) ((σ ^ m) a) := by rw [hm]
    _ = (σ ^ (n + m)) a := by rw [pow_add, Equiv.Perm.mul_apply]
    _ = (σ ^ (m + n)) a := by rw [Nat.add_comm]
    _ = (σ ^ m) ((σ ^ n) a) := by rw [pow_add, Equiv.Perm.mul_apply]
    _ = (σ ^ m) (g a) := by rw [hn]
    _ = g ((σ ^ m) a) := by
        rw [← Equiv.Perm.mul_apply, ← (hc.pow_right m).eq, Equiv.Perm.mul_apply]
    _ = g b := by rw [hm]

/-- An element of order `7` of `Sym (Fin 7)` is a `7`-cycle, hence transitive. -/
theorem trans_of_order_seven {σ : Perm (Fin 7)} (hσ : orderOf σ = 7) :
    ∀ a b : Fin 7, ∃ n : ℕ, (σ ^ n) a = b := by
  have hcyc : σ.IsCycle := isCycle_of_prime_order'' (by norm_num) (by simpa using hσ)
  have hsupp : σ.support = Finset.univ := by
    apply Finset.eq_univ_of_card
    rw [← hcyc.orderOf, hσ]
    simp
  intro a b
  have ha : σ a ≠ a := by
    have : a ∈ σ.support := by rw [hsupp]; exact Finset.mem_univ a
    rwa [Equiv.Perm.mem_support] at this
  have hb : σ b ≠ b := by
    have : b ∈ σ.support := by rw [hsupp]; exact Finset.mem_univ b
    rwa [Equiv.Perm.mem_support] at this
  exact hcyc.exists_pow_eq ha hb

/-- The centralizer in `R ≤ A₇` of an element `c` of order `7` is generated by `c`. -/
theorem centralizer_eq_zpowers (R : Subgroup (alternatingGroup (Fin 7))) (c : ↥R)
    (hc : orderOf c = 7) :
    Subgroup.centralizer ({c} : Set ↥R) = Subgroup.zpowers c := by
  apply le_antisymm
  · intro g hg
    rw [Subgroup.mem_centralizer_singleton_iff] at hg
    rw [Subgroup.mem_zpowers_iff]
    have hcA : orderOf (c : alternatingGroup (Fin 7)) = 7 := by rw [Subgroup.orderOf_coe, hc]
    have hcP : orderOf ((c : alternatingGroup (Fin 7)) : Perm (Fin 7)) = 7 := by
      rw [Subgroup.orderOf_coe, hcA]
    have hcomm : (g : Perm (Fin 7)) * ((c : alternatingGroup (Fin 7)) : Perm (Fin 7))
        = ((c : alternatingGroup (Fin 7)) : Perm (Fin 7)) * (g : Perm (Fin 7)) := by
      have := congrArg (fun x : ↥R => (x : Perm (Fin 7))) hg
      simpa using this
    obtain ⟨k, hk⟩ := mem_zpowers_of_commute_of_trans _ _ 0
      (fun b => trans_of_order_seven hcP 0 b) hcomm
    refine ⟨k, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    simpa using hk
  · rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]

/-- `ConjAct` is a type synonym for `G` with the same group structure, so centralizers of `g` and
of `ConjAct.toConjAct g` have the same cardinality (they are the same subgroup). -/
theorem natCard_centralizer_conjAct {G : Type*} [Group G] (g : G) :
    Nat.card (Subgroup.centralizer ({ConjAct.toConjAct g} : Set (ConjAct G))) =
      Nat.card (Subgroup.centralizer ({g} : Set G)) := rfl

theorem sylow_seven_card (R : Subgroup (alternatingGroup (Fin 7))) (hR : Nat.card R = 252) :
    Nat.card (Sylow 7 ↥R) = 36 ∧ Nat.card {g : ↥R // orderOf g = 7} = 216 := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  obtain ⟨c, hc⟩ := exists_prime_orderOf_dvd_card' 7 (show 7 ∣ Nat.card ↥R by rw [hR]; norm_num)
  -- the centralizer of `c` in `R` has order `7`
  have hcent : Nat.card (Subgroup.centralizer ({c} : Set ↥R)) = 7 := by
    rw [centralizer_eq_zpowers R c hc, Nat.card_zpowers, hc]
  -- hence the stabilizer of `c` under conjugation has order `7`
  have hstab : Nat.card (MulAction.stabilizer (ConjAct ↥R) c) = 7 := by
    rw [ConjAct.stabilizer_eq_centralizer, natCard_centralizer_conjAct c]
    exact hcent
  haveI : Fintype ↥R := Fintype.ofFinite ↥R
  haveI : Fintype (ConjAct ↥R) := Fintype.ofFinite _
  haveI : Fintype ↥(MulAction.orbit (ConjAct ↥R) c) := Fintype.ofFinite _
  haveI : Fintype ↥(MulAction.stabilizer (ConjAct ↥R) c) := Fintype.ofFinite _
  -- orbit-stabilizer: the conjugacy class of `c` has `252 / 7 = 36` elements
  have horb : Nat.card ↥(MulAction.orbit (ConjAct ↥R) c) = 36 := by
    have h := MulAction.card_orbit_mul_card_stabilizer_eq_card_group (ConjAct ↥R) c
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card] at h
    have hc252 : Nat.card (ConjAct ↥R) = 252 := by
      rw [← Nat.card_congr (ConjAct.toConjAct (G := ↥R)).toEquiv, hR]
    rw [hstab, hc252] at h
    omega
  -- every conjugate of `c` has order `7`
  have hf : ∀ y : ↥(MulAction.orbit (ConjAct ↥R) c), orderOf (y : ↥R) = 7 := by
    intro y
    obtain ⟨a, ha⟩ := MulAction.mem_orbit_iff.mp y.2
    rw [← ha, ConjAct.smul_def]
    rw [← SemiconjBy.orderOf_eq (ConjAct.ofConjAct a)
      (show SemiconjBy (ConjAct.ofConjAct a) c
          (ConjAct.ofConjAct a * c * (ConjAct.ofConjAct a)⁻¹) from by
        simp only [SemiconjBy]; group)]
    exact hc
  -- hence `R` contains at least `36` elements of order `7`
  have hk : 36 ≤ Nat.card {g : ↥R // orderOf g = 7} := by
    rw [← horb]
    let f : ↥(MulAction.orbit (ConjAct ↥R) c) → {g : ↥R // orderOf g = 7} :=
      fun y => ⟨(y : ↥R), hf y⟩
    refine Nat.card_le_card_of_injective f ?_
    intro y z hyz
    have h2 : (f y : ↥R) = (f z : ↥R) :=
      congrArg (fun w : {g : ↥R // orderOf g = 7} => (w : ↥R)) hyz
    have h3 : (y : ↥R) = (z : ↥R) := by simpa only [f] using h2
    exact Subtype.ext h3
  -- `⟨c⟩` is a Sylow `7`-subgroup of index `36`, so `n₇ ∣ 36`
  have hdvd : Nat.card (Sylow 7 ↥R) ∣ 36 := by
    have hZcard : Nat.card ↥(Subgroup.zpowers c : Subgroup ↥R) = 7 := by
      rw [Nat.card_zpowers, hc]
    have hidx : (Subgroup.zpowers c : Subgroup ↥R).index = 36 := by
      have := Subgroup.card_mul_index (Subgroup.zpowers c : Subgroup ↥R)
      rw [hZcard, hR] at this
      omega
    have hisP : IsPGroup 7 ↥(Subgroup.zpowers c : Subgroup ↥R) :=
      IsPGroup.of_card (n := 1) (by rw [hZcard]; norm_num)
    have hnd : ¬ 7 ∣ (Subgroup.zpowers c : Subgroup ↥R).index := by rw [hidx]; norm_num
    let P₀ : Sylow 7 ↥R := hisP.toSylow hnd
    have hP0idx : P₀.index = 36 := hidx
    haveI : Finite (Sylow 7 ↥R) := Sylow.finite_of_finiteIndex P₀
    have hcd := Sylow.card_dvd_index P₀
    rwa [hP0idx] at hcd
  -- Sylow's third theorem: `n₇ ≡ 1 (mod 7)`
  have hmod : Nat.card (Sylow 7 ↥R) ≡ 1 [MOD 7] := card_sylow_modEq_one 7 ↥R
  -- the elements of order `7` are the non-identity elements of the Sylow `7`-subgroups
  have hcount : Nat.card {g : ↥R // orderOf g = 7} = 6 * Nat.card (Sylow 7 ↥R) := by
    have hcc := card_orderOf_eq_prime_mul_sylow (G := ↥R) (p := 7) (m := 36) hR (by norm_num)
    simpa using hcc
  -- `n₇ ≥ 6` since there are at least `36` elements of order `7`
  have hn6 : 6 ≤ Nat.card (Sylow 7 ↥R) := by
    have h := hk
    rw [hcount] at h
    omega
  -- `n₇ ∣ 36`, `n₇ ≡ 1 (mod 7)` and `6 ≤ n₇` force `n₇ = 36`
  have hn36 : Nat.card (Sylow 7 ↥R) = 36 := by
    have hnmod : Nat.card (Sylow 7 ↥R) % 7 = 1 := by
      have h := hmod
      rw [Nat.ModEq] at h
      simpa using h
    have hmem : Nat.card (Sylow 7 ↥R) ∈ Nat.divisors 36 :=
      Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
    rw [show Nat.divisors 36 = {1,2,3,4,6,9,12,18,36} from by decide] at hmem
    simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with h|h|h|h|h|h|h|h|h <;> (rw [h] at hnmod hn6 ⊢) <;> omega
  exact ⟨hn36, by rw [hcount, hn36]⟩

end Work.CORE4.A7FGB
