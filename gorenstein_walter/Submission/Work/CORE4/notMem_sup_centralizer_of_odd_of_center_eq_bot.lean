import Mathlib

namespace Work.CORE4

open Subgroup

open scoped Pointwise

/-- If `L` has trivial center and the centralizer of `L` in `K` has odd order, then an
involution `r` lying outside `L` cannot lie in the subgroup generated by `L` and its
centralizer.

Indeed, write `r = l * c` with `l ∈ L` and `c ∈ C_K(L)`. Using `r ^ 2 = 1` and the fact that
`c` commutes with `l` we get `l ^ 2 * c ^ 2 = 1`, so `l ^ 2 = (c ^ 2)⁻¹ ∈ C_K(L)`; on the other
hand `l ^ 2 ∈ L`, so `l ^ 2` is central in `L`, whence `l ^ 2 = 1` because the center of `L` is
trivial. Then `c ^ 2 = 1` as well, and since `c` has odd order we get `c = 1`, so `r = l ∈ L`,
a contradiction. -/
theorem notMem_sup_centralizer_of_odd_of_center_eq_bot {K : Type} [Group K] [Finite K]
    (L : Subgroup K) (hCodd : Odd (Nat.card (Subgroup.centralizer (L : Set K))))
    (hZ : Subgroup.center ↥L = ⊥) {r : K} (hr2 : orderOf r = 2) (hrL : r ∉ L) :
    r ∉ L ⊔ Subgroup.centralizer (L : Set K) := by
  set C : Subgroup K := Subgroup.centralizer (L : Set K) with hC
  intro hr
  -- `L` centralizes `C`, hence lies in the normalizer of `C`, so `L ⊔ C` is the pointwise
  -- product `L * C`.
  have hLleC : L ≤ Subgroup.centralizer (C : Set K) := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    have hh' : h ∈ Subgroup.centralizer (L : Set K) := hC ▸ hh
    exact ((Subgroup.mem_centralizer_iff.mp hh') x hx).symm
  have hle : L ≤ Subgroup.normalizer (C : Set K) :=
    hLleC.trans (Subgroup.centralizer_le_normalizer (C : Set K))
  have hcast : (↑(L ⊔ C) : Set K) = (L : Set K) * (C : Set K) :=
    Subgroup.coe_mul_of_left_le_normalizer_right L C hle
  have hrmem : r ∈ (L : Set K) * (C : Set K) := by rw [← hcast]; exact hr
  rw [Set.mem_mul] at hrmem
  obtain ⟨l, hl, c, hc, hlc⟩ := hrmem
  have hc' : c ∈ Subgroup.centralizer (L : Set K) := hC ▸ hc
  have hcl : c * l = l * c := ((Subgroup.mem_centralizer_iff.mp hc') l hl).symm
  -- `r ^ 2 = 1`, and `(l * c) ^ 2 = l ^ 2 * c ^ 2` since `c` commutes with `l`.
  have hr2sq : r ^ 2 = 1 := by rw [← hr2]; exact pow_orderOf_eq_one r
  have hsq : (l * c) ^ 2 = l ^ 2 * c ^ 2 := by
    rw [pow_two, pow_two, pow_two]
    rw [show l * c * (l * c) = l * (c * l) * c from by simp only [mul_assoc], hcl,
        show l * (l * c) * c = l * l * (c * c) from by simp only [mul_assoc]]
  have hl2c2 : l ^ 2 * c ^ 2 = 1 := by rw [← hsq, hlc]; exact hr2sq
  have hl2 : l ^ 2 = (c ^ 2)⁻¹ := eq_inv_of_mul_eq_one_left hl2c2
  have hl2C : l ^ 2 ∈ C := by rw [hl2]; exact C.inv_mem (C.pow_mem hc 2)
  have hl2L : l ^ 2 ∈ L := L.pow_mem hl 2
  -- `l ^ 2` is central in `L`.
  have hcent : (⟨l ^ 2, hl2L⟩ : ↥L) ∈ Subgroup.center ↥L := by
    rw [Subgroup.mem_center_iff]
    intro g
    apply Subtype.ext
    show (g : K) * l ^ 2 = l ^ 2 * (g : K)
    exact Subgroup.mem_centralizer_iff.mp (hC ▸ hl2C) (g : K) g.2
  -- the center of `L` is trivial, so `l ^ 2 = 1`.
  have hl2one : l ^ 2 = 1 := by
    have hzbot : (⟨l ^ 2, hl2L⟩ : ↥L) ∈ (⊥ : Subgroup ↥L) := by rw [← hZ]; exact hcent
    have h1 : (⟨l ^ 2, hl2L⟩ : ↥L) = 1 := Subgroup.mem_bot.mp hzbot
    simpa using congrArg Subtype.val h1
  have hc2 : c ^ 2 = 1 := by
    have : (c ^ 2)⁻¹ = 1 := by rw [← hl2, hl2one]
    rwa [inv_eq_one] at this
  -- `c` has odd order and `c ^ 2 = 1`, so `c = 1`.
  have hc1 : c = 1 := by
    have hdvd : orderOf c ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hc2
    have hodd : Odd (orderOf c) := hCodd.of_dvd_nat (Subgroup.orderOf_dvd_natCard C hc)
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exact orderOf_eq_one_iff.mp h
    · obtain ⟨k, hk⟩ := hodd; omega
  have hrl : r = l := by rw [← hlc, hc1, mul_one]
  exact hrL (by rw [hrl]; exact hl)

end Work.CORE4
