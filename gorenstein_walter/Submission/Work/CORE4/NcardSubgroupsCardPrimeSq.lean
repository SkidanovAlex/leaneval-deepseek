import Mathlib

namespace Work.CORE4

/-- The number of subgroups of order `p` of a finite abelian group of order `p ^ 2` and exponent
`p` (i.e. of type `(p,p)`) is `p + 1`. -/
theorem NcardSubgroupsCardPrimeSq (p : ℕ) [Fact p.Prime] (A : Type) [Group A] [Finite A]
    (hcard : Nat.card A = p ^ 2) (hexp : ∀ x : A, x ^ p = 1)
    (hcomm : ∀ a b : A, a * b = b * a) :
    {X : Subgroup A | Nat.card X = p}.ncard = p + 1 := by
  classical
  have hp : p.Prime := Fact.out
  have hpm1pos : 0 < p - 1 := by have := hp.two_le; omega
  haveI : Fintype A := Fintype.ofFinite A
  haveI : Fintype (Subgroup A) := Fintype.ofFinite (Subgroup A)
  -- Every nonidentity element has order `p`.
  have horder : ∀ x : A, x ≠ 1 → orderOf x = p := by
    intro x hx
    have hdvd : orderOf x ∣ p := orderOf_dvd_iff_pow_eq_one.mpr (hexp x)
    rcases (Nat.dvd_prime hp).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hx
    · exact h
  have hzpow : ∀ x : A, x ≠ 1 → Nat.card (Subgroup.zpowers x) = p := by
    intro x hx
    rw [Nat.card_zpowers, horder x hx]
  -- A subgroup of order `p` is generated by each of its nonidentity elements.
  have hgen : ∀ (X : Subgroup A) (a : A), Nat.card X = p → a ∈ X → a ≠ 1 →
      Subgroup.zpowers a = X := by
    intro X a hXc ha hane
    have h1 := hzpow a hane
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr ha) ?_
    omega
  -- The finite sets of subgroups of order `p`, and of nonidentity elements of each such subgroup.
  set T : Finset (Subgroup A) := Finset.univ.filter (fun X => Nat.card X = p) with hT
  set fib : Subgroup A → Finset A :=
    fun X => Finset.univ.filter (fun x : A => x ∈ X ∧ x ≠ 1) with hfib
  -- The nonidentity elements are the disjoint union of the nonidentity parts of these subgroups.
  have hcover : Finset.univ.filter (fun x : A => x ≠ 1) = T.biUnion fib := by
    ext x
    simp only [hT, hfib, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_biUnion]
    constructor
    · intro hx
      exact ⟨Subgroup.zpowers x, hzpow x hx, Subgroup.mem_zpowers x, hx⟩
    · rintro ⟨X, _hXc, _hxX, hxne⟩
      exact hxne
  have hdisj : (↑T : Set (Subgroup A)).PairwiseDisjoint fib := by
    intro X hX Y hY hXY
    rw [Finset.mem_coe] at hX hY
    change Disjoint (fib X) (fib Y)
    rw [Finset.disjoint_left]
    intro a haX haY
    have hXc : Nat.card X = p := (Finset.mem_filter.mp hX).2
    have hYc : Nat.card Y = p := (Finset.mem_filter.mp hY).2
    have haX' : a ∈ X := (Finset.mem_filter.mp haX).2.1
    have haY' : a ∈ Y := (Finset.mem_filter.mp haY).2.1
    have hane : a ≠ 1 := (Finset.mem_filter.mp haX).2.2
    exact hXY ((hgen X a hXc haX' hane).symm.trans (hgen Y a hYc haY' hane))
  -- Each such subgroup contributes exactly `p - 1` nonidentity elements.
  have hfiber : ∀ X ∈ T, (fib X).card = p - 1 := by
    intro X hX
    have hXc : Nat.card X = p := (Finset.mem_filter.mp hX).2
    haveI : Fintype X := Fintype.ofFinite X
    have hcardX : Fintype.card X = p := by rw [← Nat.card_eq_fintype_card]; exact hXc
    change (Finset.univ.filter (fun x : A => x ∈ X ∧ x ≠ 1)).card = p - 1
    have himg : (Finset.univ.filter (fun x : A => x ∈ X ∧ x ≠ 1))
        = (Finset.univ.filter (fun y : X => y ≠ 1)).image Subtype.val := by
      ext a
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
      constructor
      · rintro ⟨haX, hane⟩
        exact ⟨⟨a, haX⟩, by simpa using hane, rfl⟩
      · rintro ⟨y, hy, rfl⟩
        exact ⟨y.2, by simpa using hy⟩
    rw [himg, Finset.card_image_of_injective _ Subtype.val_injective,
      Finset.filter_ne' Finset.univ (1 : X),
      Finset.card_erase_of_mem (Finset.mem_univ (1 : X)), Finset.card_univ, hcardX]
  have hScard : (Finset.univ.filter (fun x : A => x ≠ 1)).card = p ^ 2 - 1 := by
    have hcardA : Fintype.card A = p ^ 2 := by rw [← Nat.card_eq_fintype_card]; exact hcard
    rw [Finset.filter_ne' Finset.univ (1 : A),
      Finset.card_erase_of_mem (Finset.mem_univ (1 : A)), Finset.card_univ, hcardA]
  -- Double counting: `(p - 1) * #T = p ^ 2 - 1`.
  have hcount : (Finset.univ.filter (fun x : A => x ≠ 1)).card = T.card * (p - 1) := by
    rw [hcover, Finset.card_biUnion hdisj,
      Finset.sum_congr rfl (fun X hX => hfiber X hX), Finset.sum_const, nsmul_eq_mul,
      Nat.cast_id]
  have hTcard : T.card = p + 1 := by
    have h1 : T.card * (p - 1) = p ^ 2 - 1 := by rw [← hcount, hScard]
    have h2 : (p + 1) * (p - 1) = p ^ 2 - 1 := by
      simpa using (sq_tsub_sq p 1).symm
    rw [← h2] at h1
    exact Nat.mul_right_cancel hpm1pos h1
  have hset : {X : Subgroup A | Nat.card X = p}.ncard = T.card := by
    have hcoe : (↑T : Set (Subgroup A)) = {X : Subgroup A | Nat.card X = p} := by
      ext X
      simp [hT, Finset.mem_filter]
    rw [← hcoe, Set.ncard_coe_finset]
  rw [hset, hTcard]

end Work.CORE4
