/-! ## Auxiliary group theory -/

omit [Finite G] in
/-- `E(M) = layerIn M` is normalised by `M`: the layer of `M` is normal (characteristic) in `↥M`. -/
theorem layerIn_conj_mem (M : Subgroup G) {x m : G} (hx : x ∈ Work.GW2.layerIn M) (hm : m ∈ M) :
    m * x * m⁻¹ ∈ Work.GW2.layerIn M := by
  have hnorm : ((Work.GW2.layerIn M).subgroupOf M).Normal := by
    have h1 : (Work.GW2.layerIn M).subgroupOf M = Work.GW2.layer ↥M :=
      Subgroup.comap_map_eq_self_of_injective (Subgroup.subtype_injective M)
        (Work.GW2.layer ↥M)
    rw [h1]
    exact Work.CORE4.layer_normal M
  exact (Subgroup.normal_subgroupOf_iff (Work.CORE4.layerIn_le M)).mp hnorm x m hx hm

/-- Bender's (1) `K = [S ∩ E, U ∩ M]` puts `K` inside the layer `E = E(M)`: `K` is generated by
commutators of elements of `E(M) ≤ M` with elements of `M`, and `E(M) ⊴ M`. -/
-- NOTE (area owner, 2026-10-07): renamed from `K_le_layerIn` to avoid a duplicate declaration
-- with `Work.CORE4.Case2EHcard.K_le_layerIn` (signature `(B) (h : Case2Ctx B)`), which blocked
-- every module importing both this file and the counting chain.
theorem K_le_layerIn_of_prePlus {B : Work.GW2.BenderSetup G} {D : Work.GW2.Case2Data B}
    (hplus : Work.GW2.Case2PrePlus B D) : D.K ≤ Work.GW2.layerIn D.M := by
  rw [hplus.2.1]
  refine Subgroup.commutator_le.mpr fun a ha b hb => ?_
  have haE : a ∈ Work.GW2.layerIn D.M := (Subgroup.mem_inf.mp ha).2
  have hbM : b ∈ D.M := (Subgroup.mem_inf.mp hb).2
  have h1 : b * a⁻¹ * b⁻¹ ∈ Work.GW2.layerIn D.M :=
    layerIn_conj_mem D.M ((Work.GW2.layerIn D.M).inv_mem haE) hbM
  have h2 : a * (b * a⁻¹ * b⁻¹) ∈ Work.GW2.layerIn D.M :=
    (Work.GW2.layerIn D.M).mul_mem haE h1
  simpa [commutatorElement_def, mul_assoc] using h2

/-- `K = I_{U∩M}(s)` meets the centre of `E = E(M)` trivially: `s ∈ E` centralizes `Z(E)` and
inverts `K`, so an `x ∈ K ⊓ Z(E)` satisfies `x = x⁻¹`; but `x ∈ K ≤ U` has odd order, so
`x = 1`. -/
theorem K_inf_center_eq_bot {B : Work.GW2.BenderSetup G} {D : Work.GW2.Case2Data B}
    (hUodd : Odd (Nat.card ↑B.U)) :
    D.K ⊓ (Subgroup.center ↥(Work.GW2.layerIn D.M)).map (Work.GW2.layerIn D.M).subtype = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  obtain ⟨hxK, hxZ⟩ := Subgroup.mem_inf.mp hx
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hxZ
  have hxE : x ∈ Work.GW2.layerIn D.M := by rw [← hyx]; exact y.2
  let z : ↥(Work.GW2.layerIn D.M) := ⟨x, hxE⟩
  have hzy : z = y := Subtype.ext (by simpa [z] using hyx.symm)
  have hzcenter : z ∈ Subgroup.center ↥(Work.GW2.layerIn D.M) := hzy ▸ hy
  have hxs : D.s * x * D.s⁻¹ = x⁻¹ := Work.GW2.Case2Data.K_inv B D x hxK
  have hcomm : D.s * x = x * D.s := by
    have h := Subgroup.mem_center_iff.mp hzcenter
      (⟨D.s, Work.GW2.Case2Data.s_mem_layer B D⟩ : ↥(Work.GW2.layerIn D.M))
    have h2 := congrArg (fun w : ↥(Work.GW2.layerIn D.M) => (w : G)) h
    simpa [z] using h2
  have hx1 : x * x = 1 := by
    have h1 : D.s * x * D.s⁻¹ = x := by
      rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
    rw [h1] at hxs
    have h2 : x * x⁻¹ = 1 := mul_inv_cancel x
    rw [← hxs] at h2
    exact h2
  have hxU : x ∈ B.U := Work.GW2.Case2Data.K_le_U B D hxK
  have hodd : Odd (orderOf x) :=
    Odd.of_dvd_nat hUodd (Subgroup.orderOf_dvd_natCard B.U hxU)
  have hdv : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr (by rw [pow_two]; exact hx1)
  rcases (Nat.dvd_prime Nat.prime_two).mp hdv with h1 | h1
  · exact orderOf_eq_one_iff.mp h1
  · exfalso
    obtain ⟨j, hj⟩ := hodd
    omega

omit [Finite G] in
/-- **The `A₇` bound on `|K|`** (Bender p. 226, first sentence of the `A₇` case): if `K ≤ E` is an
odd-order subgroup with `K ⊓ Z(E) = ⊥`, and `K` commutes with an involution `t ∈ E`, where
`E/Z(E) ≅ A₇` and `Z(E)` has odd order, then `|K| ∣ 3`.

`K` injects into `E/Z(E) ≅ A₇`, its image lies in the centralizer of the involution `tZ(E)`
(`t ∉ Z(E)` because `Z(E)` is odd and `orderOf t = 2`), and the centralizer of an involution of
`A₇` has order `24` (`A7ModelProp`); the odd divisors of `24` are `1, 3`. -/
theorem A7KCardDvdThree {E K : Subgroup G} {t : G}
    (ha7 : Work.GW2.A7ModelProp)
    (hA7 : Nonempty ((↥E ⧸ Subgroup.center ↥E) ≃* alternatingGroup (Fin 7)))
    (hZodd : Odd (Nat.card (Subgroup.center ↥E)))
    (hKE : K ≤ E)
    (hKZ : K ⊓ (Subgroup.center ↥E).map E.subtype = ⊥)
    (hKodd : Odd (Nat.card K))
    (htE : t ∈ E) (ht2 : orderOf t = 2)
    (hKt : ∀ x ∈ K, t * x = x * t) :
    Nat.card K ∣ 3 := by
  classical
  obtain ⟨eiso⟩ := hA7
  let tE : ↥E := ⟨t, htE⟩
  let φ : ↥E →* alternatingGroup (Fin 7) :=
    eiso.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥E))
  have hφone : ∀ z : ↥E, φ z = 1 ↔ z ∈ Subgroup.center ↥E := by
    intro z
    constructor
    · intro hz
      have h1 : QuotientGroup.mk' (Subgroup.center ↥E) z = 1 :=
        eiso.injective (by simpa [φ] using hz)
      rwa [← QuotientGroup.ker_mk' (Subgroup.center ↥E), MonoidHom.mem_ker]
    · intro hz
      simpa [φ] using hz
  have ht_ne : t ≠ 1 := by
    intro h
    rw [h, orderOf_one] at ht2
    exact absurd ht2 (by norm_num)
  have htE_ne : tE ≠ 1 := fun h => ht_ne (by simpa [tE] using congrArg (fun w : ↥E => (w : G)) h)
  have hordtE : orderOf tE = 2 := by
    refine orderOf_eq_prime ?_ htE_ne
    have ht2' : t ^ 2 = 1 := orderOf_dvd_iff_pow_eq_one.mp (by rw [ht2])
    apply Subtype.ext
    simpa [tE] using ht2'
  have hpowt : (φ tE) ^ 2 = 1 := by
    have h : tE ^ 2 = 1 := by
      rw [← hordtE]
      exact pow_orderOf_eq_one tE
    rw [← map_pow, h, map_one]
  have hnet : φ tE ≠ 1 := by
    intro h1
    have hz : tE ∈ Subgroup.center ↥E := (hφone tE).mp h1
    have hdvd : orderOf tE ∣ Nat.card (Subgroup.center ↥E) :=
      Subgroup.orderOf_dvd_natCard _ hz
    rw [hordtE] at hdvd
    exact (Nat.not_even_iff_odd.mpr hZodd) (even_iff_two_dvd.mpr hdvd)
  have hordφ : orderOf (φ tE) = 2 := orderOf_eq_prime hpowt hnet
  let ψ : ↥(K.subgroupOf E) →* alternatingGroup (Fin 7) := φ.comp (K.subgroupOf E).subtype
  have hψinj : Function.Injective ψ := by
    intro x y hxy
    have hxy' : φ (x : ↥E) = φ (y : ↥E) := hxy
    have h1 : φ ((x : ↥E) * (y : ↥E)⁻¹) = 1 := by
      rw [map_mul, map_inv, hxy', mul_inv_cancel]
    have hz : (x : ↥E) * (y : ↥E)⁻¹ ∈ Subgroup.center ↥E := (hφone _).mp h1
    have hzK : (((x : ↥E) * (y : ↥E)⁻¹ : ↥E) : G) ∈ K := by
      have hxK : (x.1.1 : G) ∈ K := Subgroup.mem_subgroupOf.mp x.2
      have hyK : (y.1.1 : G) ∈ K := Subgroup.mem_subgroupOf.mp y.2
      simpa using K.mul_mem hxK (K.inv_mem hyK)
    have hzZ : (((x : ↥E) * (y : ↥E)⁻¹ : ↥E) : G) ∈ (Subgroup.center ↥E).map E.subtype :=
      Subgroup.mem_map.mpr ⟨(x : ↥E) * (y : ↥E)⁻¹, hz, rfl⟩
    have hbot : (((x : ↥E) * (y : ↥E)⁻¹ : ↥E) : G) ∈ (⊥ : Subgroup G) := by
      rw [← hKZ]
      exact Subgroup.mem_inf.mpr ⟨hzK, hzZ⟩
    have hz1 : (x : ↥E) * (y : ↥E)⁻¹ = 1 :=
      Subtype.ext (by simpa using Subgroup.mem_bot.mp hbot)
    exact Subtype.ext (mul_inv_eq_one.mp hz1)
  have hψle : ψ.range ≤ Subgroup.centralizer ({φ tE} : Set (alternatingGroup (Fin 7))) := by
    intro y hy
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hy
    rw [← hx, Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    subst hh
    show φ tE * φ (x : ↥E) = φ (x : ↥E) * φ tE
    rw [← map_mul, ← map_mul]
    congr 1
    apply Subtype.ext
    have hxK : (x.1.1 : G) ∈ K := Subgroup.mem_subgroupOf.mp x.2
    simpa [tE] using hKt (x.1.1) hxK
  have hcardψ : Nat.card ↥ψ.range = Nat.card ↥(K.subgroupOf E) := by
    rw [MonoidHom.range_eq_map, Subgroup.card_map_of_injective hψinj, Subgroup.card_top]
  have hcardK : Nat.card ↥(K.subgroupOf E) = Nat.card ↥K := by
    have h := Subgroup.card_map_of_injective (f := E.subtype) (Subtype.val_injective)
      (K := K.subgroupOf E)
    rw [Subgroup.map_subgroupOf_eq_of_le hKE] at h
    exact h.symm
  have h24 : Nat.card ↥K ∣ 24 := by
    have h1 := Subgroup.card_dvd_of_le hψle
    rw [hcardψ, hcardK] at h1
    have h2 : Nat.card
        (Subgroup.centralizer ({φ tE} : Set (alternatingGroup (Fin 7)))) = 24 :=
      ha7.2.2.1 (φ tE) hordφ
    rwa [h2] at h1
  have hcop : Nat.Coprime (Nat.card ↥K) 8 := by
    have h2 : Nat.Coprime (Nat.card ↥K) 2 := Nat.coprime_two_right.mpr hKodd
    have h3 := Nat.Coprime.pow_right 3 h2
    simpa using h3
  have hdvd24 : Nat.card ↥K ∣ 2 ^ 3 * 3 := by
    rw [show 2 ^ 3 * 3 = 24 by norm_num]
    exact h24
  exact hcop.dvd_of_dvd_mul_left hdvd24

/-! ## The leaf -/

/-- **LEAF C10.A1 `A7K`** (Bender p. 226, first sentence of the `A₇` case): "In this case, `|K| = 3`,
hence `|F| = 3` by (6)".

`A7KProp I` gives, from `Hyp9 G B C`, `IsA7Case C.D` (`E/Z(E) ≅ A₇`) and
`Nat.card C.D.F ∣ Nat.card C.D.K0` (= `SixEmbedProp`, the leaf `CORE4/Case2SixEmbed`):

    A7Facts1 C.D   =   |K| = 3  ∧  |F| = 3  ∧  K₀ = K  ∧  π(F(U)) = {3}

Route (design pass 10 §3.2, A1):
* `K ≤ E` (`Case2PrePlus`'s (1) clause), `K ∩ Z(E) = 1`;
* the odd part of `C_{A₇}(t)` has order 3 (`I.toolkit.a7 : A7ModelProp`, centralizer of an
  involution in `A₇` has order 24, so its odd part is 3);
* `K₀ ≠ ⊥` (`Case2SixEmbed` and `F ≠ ⊥`), and `K₀ ≤ K`, so `K₀ = K` and `|K| = 3`;
* `|F| ∣ |K₀| = 3` and `F ≠ ⊥` give `|F| = 3`;
* `π(F(U)) = π(K₀) = {3}` is `Case2SevenFacts`'s second conjunct with `|K₀| = 3`. -/
theorem A7K (I : Work.GW2.C4Inputs) : Work.GW2.A7KProp I := by
  intro G _ _ B C hHyp hA7 hdvd
  obtain ⟨hbc, _hcase2, hplus, hseven, _height⟩ := hHyp
  obtain ⟨eiso⟩ := hA7
  have hZodd : Odd (Nat.card (Subgroup.center ↥(Work.GW2.layerIn C.D.M))) :=
    (LayerCtx6 I hbc C (DihOrCycSub hbc.sylow C.D.M)).2.1
  have hUodd : Odd (Nat.card B.U) := Work.GW2.BenderSetup.U_odd B
  have hKodd : Odd (Nat.card C.D.K) :=
    Odd.of_dvd_nat hUodd (Subgroup.card_dvd_of_le (Work.GW2.Case2Data.K_le_U B C.D))
  have hKE : C.D.K ≤ Work.GW2.layerIn C.D.M := K_le_layerIn_of_prePlus hplus
  have hKZ := K_inf_center_eq_bot (B := B) (D := C.D) hUodd
  have hKt : ∀ x ∈ C.D.K, B.t * x = x * B.t := by
    intro x hx
    have hxH : x ∈ B.H :=
      Work.GW2.BenderSetup.U_le_H B (Work.GW2.Case2Data.K_le_U B C.D hx)
    exact Subgroup.mem_centralizer_iff.mp hxH B.t rfl
  have hKdvd3 : Nat.card C.D.K ∣ 3 :=
    A7KCardDvdThree (E := Work.GW2.layerIn C.D.M) (K := C.D.K) (t := B.t)
      I.toolkit.a7 ⟨eiso⟩ hZodd hKE hKZ hKodd C.D.t_mem B.t_order hKt
  -- the arithmetic finish: `|F| ∣ |K₀| ≤ |K| ∣ 3` and `F ≠ 1` force `|K₀| = 3 = |K|`
  have hFne : C.D.F ≠ ⊥ := Work.GW2.Case2Pre.F_ne B C.D C.pre
  have hK0dvdK : Nat.card C.D.K0 ∣ Nat.card C.D.K :=
    Subgroup.card_dvd_of_le (inf_le_right : C.D.K0 ≤ C.D.K)
  have hK0odd : Odd (Nat.card C.D.K0) :=
    Odd.of_dvd_nat hUodd
      (Subgroup.card_dvd_of_le (le_trans inf_le_right (Work.GW2.Case2Data.K_le_U B C.D)))
  have hF2 : 2 ≤ Nat.card C.D.F := by
    have h := (Subgroup.one_lt_card_iff_ne_bot C.D.F).mpr hFne
    omega
  have hK02 : 2 ≤ Nat.card C.D.K0 := by
    have h := Nat.le_of_dvd Nat.card_pos hdvd
    omega
  have hK0dvd3 : Nat.card C.D.K0 ∣ 3 := dvd_trans hK0dvdK hKdvd3
  have hK0le3 : Nat.card C.D.K0 ≤ 3 := Nat.le_of_dvd (by norm_num) hK0dvd3
  have hK0eq : Nat.card C.D.K0 = 3 := by
    obtain ⟨j, hj⟩ := hK0odd
    omega
  have hKeq : Nat.card C.D.K = 3 := by
    have h3dvd : 3 ∣ Nat.card C.D.K := hK0eq ▸ hK0dvdK
    exact (Nat.dvd_antisymm h3dvd hKdvd3).symm
  have hK0K : C.D.K0 = C.D.K :=
    Subgroup.eq_of_le_of_card_ge inf_le_right (by omega)
  have hFeq : Nat.card C.D.F = 3 := by
    have hFdvd3 : Nat.card C.D.F ∣ 3 := hK0eq ▸ hdvd
    have hFodd : Odd (Nat.card C.D.F) :=
      Odd.of_dvd_nat hUodd (Subgroup.card_dvd_of_le (Work.GW2.Case2Data.F_le_U B C.D))
    have hFle3 : Nat.card C.D.F ≤ 3 := Nat.le_of_dvd (by norm_num) hFdvd3
    obtain ⟨j, hj⟩ := hFodd
    omega
  have hpi : B.piFU = {3} := by
    rw [← hseven.2.1]
    show ({p : ℕ | p ∈ (Nat.card C.D.K0).primeFactors} : Set ℕ) = {3}
    rw [hK0eq]
    ext p
    simp [Nat.Prime.primeFactors (by norm_num : Nat.Prime 3)]
  exact ⟨hKeq, hFeq, hK0K, hpi⟩

end Work.CORE4
