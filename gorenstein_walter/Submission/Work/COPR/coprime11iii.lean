import Mathlib
import Submission.Work.COPR.Glue

set_option linter.style.haveILetI false

namespace Work.COPR

open Subgroup

/-- If `a ∈ E` is nontrivial then `K ⊓ C_K(a)` is contained in the join of all `K ⊓ C_K(b)`
for `b ∈ E`, `b ≠ 1`.  This is the elementary `iSup`-bookkeeping step of `coprime11iii`. -/
private lemma le_iSup_inf_centralizer {G : Type*} [Group G] (K E : Subgroup G)
    (a : G) (ha : a ∈ E) (hne : a ≠ 1) :
    K ⊓ Subgroup.centralizer ({a} : Set G) ≤
      ⨆ (b : G) (_ : b ∈ E) (_ : b ≠ 1), K ⊓ Subgroup.centralizer ({b} : Set G) := by
  refine le_trans ?_ (le_iSup (fun b : G => ⨆ (_ : b ∈ E), ⨆ (_ : b ≠ 1),
    K ⊓ Subgroup.centralizer ({b} : Set G)) a)
  refine le_trans ?_ (le_iSup (fun _ : a ∈ E => ⨆ (_ : a ≠ 1),
    K ⊓ Subgroup.centralizer ({a} : Set G)) ha)
  exact le_iSup (fun _ : a ≠ 1 => K ⊓ Subgroup.centralizer ({a} : Set G)) hne

/-- Bender 1981, 1.1(iii): if the `p`-group `P` acts coprimely on the `p'`-group `K`
(`P ≤ N_G(K)`) and `E ≤ P` is elementary abelian of order `p²`, then `K` is generated by the
centralizers of the non-identity elements of `E`: `K = ⨆ a ∈ E, a ≠ 1, C_K(a)`.
Deliverable `Work.GW2.Coprime11iiiProp` of area COPR.

Empty joins: the index type is `G`, so for `E = ⊥` the index is empty and the join is `⊥` — the
hypothesis `Nat.card E = p ^ 2` with `p` prime rules that out.

Proof route: `E` is abelian (`hcomm`) and non-cyclic (of order `p²`, all elements of order
dividing `p`), so
`OddOrder.Isaacs.Ch06.nontrivialActionFixedByClosure_eq_top_of_not_isCyclic'`
(BG Prop 1.16(1) = Gorenstein 6.2.4 = Isaacs 6.21, in
`Submission/OddOrder/BG/Ch1_Preliminary/S01b_Prop116.lean`) applies to the conjugation action of
`↥E` on `↥K` (`Work.COPR.conjAct` restricted along `E ≤ P`), with coprimality from
`Work.COPR.coprime_card_of_isPGroup` (`E` is a subgroup of the `p`-group `P`).  It gives
`K = ⟨C_K(a) | a ∈ E, a ≠ 1⟩`; the right-hand side of the goal is the same subgroup written as an
`iSup`. -/
theorem coprime11iii (G : Type) [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (P K E : Subgroup G) (hP : IsPGroup p P) (hcop : Nat.Coprime p (Nat.card K))
    (hN : P ≤ Subgroup.normalizer (K : Set G)) (hEP : E ≤ P) (hcard : Nat.card E = p ^ 2)
    (hpow : ∀ x ∈ E, x ^ p = 1) (hcomm : IsMulCommutative E) :
    K = ⨆ (a : G) (_ : a ∈ E) (_ : a ≠ 1), K ⊓ Subgroup.centralizer ({a} : Set G) := by
  classical
  haveI : IsMulCommutative ↥E := hcomm
  have hNE : E ≤ Subgroup.normalizer (K : Set G) := hEP.trans hN
  -- `E` is a `p`-group, being a subgroup of the `p`-group `P`.
  have hEp : IsPGroup p ↥E := hP.to_le hEP
  have hcardEK : Nat.Coprime (Nat.card ↥E) (Nat.card ↥K) :=
    coprime_card_of_isPGroup p hEp hcop
  -- `E` is not cyclic: it has order `p ^ 2` but exponent dividing `p`.
  have hNC : ¬ IsCyclic ↥E := by
    intro hcyc
    obtain ⟨g, hg⟩ := isCyclic_iff_exists_zpowers_eq_top.mp hcyc
    have hord : orderOf g = Nat.card ↥E := orderOf_eq_card_of_zpowers_eq_top hg
    have hgp : g ^ p = 1 := by
      apply Subtype.ext
      simpa using hpow (g : G) g.2
    have hdvd : orderOf g ∣ p := orderOf_dvd_iff_pow_eq_one.mpr hgp
    rw [hord, hcard] at hdvd
    have hle : p ^ 2 ≤ p := Nat.le_of_dvd (Fact.out : p.Prime).pos hdvd
    have hp2 : 2 ≤ p := (Fact.out : p.Prime).two_le
    have hle' : p * p ≤ p * 1 := by simpa [pow_two] using hle
    have hp1 : p ≤ 1 := Nat.le_of_mul_le_mul_left hle' (Fact.out : p.Prime).pos
    omega
  -- The conjugation action of `↥E` on `↥K`.
  letI : MulDistribMulAction ↥E ↥K := MulDistribMulAction.compHom ↥K (conjAct E K hNE)
  have htop : OddOrder.Isaacs.Ch06.nontrivialActionFixedByClosure (conjAct E K hNE) = ⊤ := by
    have hφ : MulDistribMulAction.toMulAut ↥E ↥K = conjAct E K hNE := by
      ext a g; rfl
    rw [← hφ]
    exact OddOrder.Isaacs.Ch06.nontrivialActionFixedByClosure_eq_top_of_not_isCyclic hcardEK hNC
  refine le_antisymm ?_ ?_
  · -- `K ≤ ⨆ a ∈ E, a ≠ 1, C_K(a)`: every element of `K` is fixed by some nontrivial `a ∈ E`.
    intro x hx
    have hxmem : (⟨x, hx⟩ : ↥K) ∈
        OddOrder.Isaacs.Ch06.nontrivialActionFixedByClosure (conjAct E K hNE) := by
      rw [htop]
      exact Subgroup.mem_top _
    have hsub : OddOrder.Isaacs.Ch06.nontrivialActionFixedByClosure (conjAct E K hNE) ≤
        Subgroup.comap K.subtype
          (⨆ (a : G) (_ : a ∈ E) (_ : a ≠ 1), K ⊓ Subgroup.centralizer ({a} : Set G)) := by
      rw [OddOrder.Isaacs.Ch06.nontrivialActionFixedByClosure_le_iff]
      intro a ha u hu
      rw [Subgroup.mem_comap]
      have haG : (a : G) ≠ 1 := fun h => ha (Subtype.ext h)
      have h1 : ((conjAct E K hNE a u : ↥K) : G) = (u : G) := congrArg Subtype.val hu
      have h2 : (a : G) * (u : G) * (a : G)⁻¹ = (u : G) := by
        simpa [conjAct_apply_coe] using h1
      have h3 : (u : G) * (a : G) = (a : G) * (u : G) := by
        have h4 : (a : G) * (u : G) = (u : G) * (a : G) := by
          calc (a : G) * (u : G) = ((a : G) * (u : G) * (a : G)⁻¹) * (a : G) := by group
            _ = (u : G) * (a : G) := by rw [h2]
        exact h4.symm
      exact le_iSup_inf_centralizer K E (a : G) a.2 haG
        ⟨u.2, Subgroup.mem_centralizer_singleton_iff.mpr h3⟩
    have hxL := hsub hxmem
    rw [Subgroup.mem_comap] at hxL
    exact hxL
  · -- Each `K ⊓ C_K(a)` is contained in `K`.
    refine iSup_le (fun a => iSup_le (fun _ => iSup_le (fun _ => inf_le_left)))

end Work.COPR
