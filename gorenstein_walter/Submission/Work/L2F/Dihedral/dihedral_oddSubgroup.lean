import Mathlib
import Submission.Work.L2F.Defs
import Submission.Work.L2F.Dihedral.oddSubgroup_le_rotations
import Submission.Work.L2F.Dihedral.conj_inv_mem_zpowers

namespace Work.L2F.Dihedral

/-- An odd-order subgroup of a dihedral group is cyclic and is inverted by an involution.
Proof: `DihedralGroup n` is generated by the rotations `r i` and the reflection `s = sr 0` with
`s * r i * s = r (-i)`; an element `sr i` has order `2`, so an odd-order subgroup `Y` must be
contained in the (cyclic) rotation subgroup `⟨r⟩`, hence is cyclic, and `s` inverts it. -/
theorem dihedral_oddSubgroup {n : ℕ} (Y : Subgroup (DihedralGroup n)) (hY : Odd (Nat.card Y)) :
    IsCyclic Y ∧ ∃ s : DihedralGroup n, orderOf s = 2 ∧ ∀ y ∈ Y, s * y * s⁻¹ = y⁻¹ := by
  -- Step 1: an odd-order subgroup has no reflections, hence lies in the cyclic rotation subgroup.
  have hYR : Y ≤ Subgroup.zpowers (DihedralGroup.r 1 : DihedralGroup n) :=
    oddSubgroup_le_rotations Y hY
  -- Step 2: a subgroup of a cyclic group is cyclic.
  refine ⟨Subgroup.isCyclic_of_le hYR, DihedralGroup.sr 0, DihedralGroup.orderOf_sr 0, ?_⟩
  -- Step 3: the reflection `sr 0` inverts the rotation generator `r 1`,
  -- hence it inverts every element of `Y ≤ ⟨r 1⟩`.
  intro y hy
  exact conj_inv_mem_zpowers (DihedralGroup.r 1) (DihedralGroup.sr 0) (by simp) y (hYR hy)

end Work.L2F.Dihedral
