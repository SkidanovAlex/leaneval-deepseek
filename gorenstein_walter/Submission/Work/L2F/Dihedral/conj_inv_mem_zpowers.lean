import Mathlib

namespace Work.L2F.Dihedral

/-- If `s` inverts `g` by conjugation, then `s` inverts every element of the
cyclic subgroup generated by `g`. -/
theorem conj_inv_mem_zpowers {G : Type*} [Group G] (g s : G) (h : s * g * s⁻¹ = g⁻¹) :
    ∀ y ∈ Subgroup.zpowers g, s * y * s⁻¹ = y⁻¹ := by
  intro y hy
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
  rw [← conj_zpow, h, inv_zpow]

end Work.L2F.Dihedral
