import Mathlib
import Submission.Work.L2F.Dihedral.mulEquiv_dihedral_of_cyclic_index_two

namespace Work.L2F.Dihedral

/-- If `s` inverts a generator `g` of a subgroup `K` (in the sense `s * g * s⁻¹ = g⁻¹`), then `s`
inverts every element of `K`: indeed `c = g ^ m` for some `m : ℤ` and conjugation by `s` is an
automorphism, so `s * c * s⁻¹ = (s * g * s⁻¹) ^ m = (g⁻¹) ^ m = (g ^ m)⁻¹ = c⁻¹`. -/
private lemma conj_inv_of_zpowers_top {G : Type*} [Group G] (K : Subgroup G) (g : K)
    (hg : Subgroup.zpowers g = ⊤) (s : G) (hs : s * (g : G) * s⁻¹ = (g : G)⁻¹) :
    ∀ c ∈ K, s * c * s⁻¹ = c⁻¹ := by
  intro c hc
  have hc' : (⟨c, hc⟩ : K) ∈ Subgroup.zpowers g := by rw [hg]; exact Subgroup.mem_top _
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hc'
  have hm' : (g : G) ^ m = c := by
    have := congrArg Subtype.val hm
    simpa using this
  have hconj : (MulAut.conj s) (g : G) = (g : G)⁻¹ := by
    rw [MulAut.conj_apply]
    exact hs
  rw [← hm']
  calc s * (g : G) ^ m * s⁻¹ = (MulAut.conj s) ((g : G) ^ m) := by rw [MulAut.conj_apply]
    _ = ((MulAut.conj s) (g : G)) ^ m := map_zpow _ _ m
    _ = ((g : G)⁻¹) ^ m := by rw [hconj]
    _ = ((g : G) ^ m)⁻¹ := inv_zpow _ _

/-- A finite group `G` with a cyclic subgroup `K` of index two, generated by `g`, and an involution
`s ∉ K` inverting `g`, is dihedral of order `2 * |K|`; this is the "index two" criterion
`mulEquiv_dihedral_of_cyclic_index_two` fed with the cover hypothesis `G = K ∪ K s`. -/
theorem dihedral_recognition {G : Type*} [Group G] [Finite G]
    (K : Subgroup G) (g : K) (hg : Subgroup.zpowers g = ⊤) (s : G) (hs2 : s ^ 2 = 1)
    (hsK : s ∉ K) (hconj : s * (g : G) * s⁻¹ = (g : G)⁻¹)
    (hcover : ∀ x : G, x ∈ K ∨ x * s ∈ K) :
    Nonempty (G ≃* DihedralGroup (Nat.card K)) := by
  -- `((g : G))` generates `K` inside `G`, so `K` is cyclic.
  have hgen : Subgroup.zpowers (g : G) = K := by
    apply le_antisymm
    · rw [Subgroup.zpowers_le]; exact g.2
    · intro x hx
      have hx' : (⟨x, hx⟩ : K) ∈ Subgroup.zpowers g := by rw [hg]; exact Subgroup.mem_top _
      obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hx'
      rw [Subgroup.mem_zpowers_iff]
      exact ⟨m, by have h := congrArg Subtype.val hm; simpa using h⟩
  have hcyc : IsCyclic K := (Subgroup.isCyclic_iff_exists_zpowers_eq_top K).mpr ⟨(g : G), hgen⟩
  -- The cover hypothesis says exactly that `K` has index two (the nontrivial coset is `K * s`).
  have hidx : K.index = 2 := (Subgroup.index_eq_two_iff_exists_notMem_and (H := K)).mpr
    ⟨s, hsK, fun b => (hcover b).symm⟩
  have hs : s * s = 1 := by simpa [pow_two] using hs2
  exact mulEquiv_dihedral_of_cyclic_index_two K hcyc hidx
    ⟨s, hsK, hs, conj_inv_of_zpowers_top K g hg s hconj⟩

end Work.L2F.Dihedral
