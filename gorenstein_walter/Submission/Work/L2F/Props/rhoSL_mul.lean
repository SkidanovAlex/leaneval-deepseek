import Mathlib
import Submission.Work.L2F.Props.CentralizerTorusDefs

namespace Work.L2F.Props

/-- `rhoSL : GL(2,F) → SL(2,F)`, `h ↦ det(h)⁻¹ • (h * h)`, is multiplicative on *commuting*
elements.  (It is the composite of `h ↦ h / conj h` with `F[h] ≅ F[X]/(X² - glD)`, a ring
homomorphism on the commutative subalgebra generated by `h`; the hypothesis `hcomm` is exactly
what is needed to make the computation go through.) -/
theorem rhoSL_mul (F : Type*) [Field F] (h k : GL (Fin 2) F)
    (hcomm : (h : Matrix (Fin 2) (Fin 2) F) * (k : Matrix (Fin 2) (Fin 2) F)
      = (k : Matrix (Fin 2) (Fin 2) F) * (h : Matrix (Fin 2) (Fin 2) F)) :
    rhoSL F (h * k) = rhoSL F h * rhoSL F k := by
  apply Subtype.ext
  -- Reduce to an identity of `2 × 2` matrices:
  -- `det (h * k)⁻¹ • ((h * k) * (h * k)) = (det h⁻¹ • (h * h)) * (det k⁻¹ • (k * k))`.
  simp only [rhoSL_coe, rhoMat, Matrix.GeneralLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.coe_mul]
  -- Move the scalars together and expand `det (h * k) = det h * det k`.
  rw [smul_mul_smul, Matrix.det_mul, mul_inv]
  congr 1
  -- It remains to compare `(h * k) * (h * k)` with `(h * h) * (k * k)`, which is
  -- `(h * k) ^ 2 = h ^ 2 * k ^ 2` for commuting `h` and `k`.
  have hc : Commute (h : Matrix (Fin 2) (Fin 2) F) (k : Matrix (Fin 2) (Fin 2) F) := hcomm
  simpa only [pow_two] using hc.mul_pow 2

end Work.L2F.Props
