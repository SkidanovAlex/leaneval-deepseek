import Mathlib
import Submission.Work.L2F.Props.odd_part_of_two_odd

/-!
# The odd part of a group with a central involution and odd quotient

Let `G` be a finite group, `z ∈ G` an element of order `2` (the statement also assumes `z` is
central, but the argument below does not need it), such that `G ⧸ ⟨z⟩` has odd order.  Then
`|G| = |⟨z⟩| · |G ⧸ ⟨z⟩| = 2 · odd`, so `G` has a normal subgroup `N` of index two, namely the
set of elements of odd order; this is exactly `Work.L2F.Props.odd_part_of_two_odd`.

We record the properties of that `N`: it is normal, its order is odd, its elements are exactly
the elements of odd order, and it has index two -- whence, since `z ∉ N`, every `g` is either in
`N` or satisfies `g * z ∈ N`.
-/

namespace Work.L2F.Props.oddsub

theorem oddPart_of_central_involution (G : Type*) [Group G] [Finite G]
    (z : G) (hz : orderOf z = 2) (hzc : ∀ g : G, g * z = z * g)
    (hodd : Odd (Nat.card (G ⧸ Subgroup.zpowers z))) :
    ∃ N : Subgroup G, N.Normal ∧ Odd (Nat.card ↥N) ∧
      (∀ n ∈ N, Odd (orderOf n)) ∧
      (∀ g : G, Odd (orderOf g) → g ∈ N) ∧
      (∀ g : G, g ∈ N ∨ g * z ∈ N) := by
  classical
  -- The subgroup generated by `z` has order `2`.
  have hcardH : Nat.card ↥(Subgroup.zpowers z) = 2 := by
    rw [Nat.card_zpowers, hz]
  -- Lagrange: `|G| = |⟨z⟩| · [G : ⟨z⟩] = 2 · |G ⧸ ⟨z⟩|`, an odd multiple of `2` but not of `4`.
  have hcardG : Nat.card G = 2 * Nat.card (G ⧸ Subgroup.zpowers z) := by
    rw [← Subgroup.card_mul_index (Subgroup.zpowers z), hcardH, Subgroup.index_eq_card]
  have h2 : 2 ∣ Nat.card G := ⟨_, hcardG⟩
  have h4 : ¬ 4 ∣ Nat.card G := by
    rw [hcardG]
    intro h
    obtain ⟨k, hk⟩ := h
    have hq : Nat.card (G ⧸ Subgroup.zpowers z) = 2 * k := by omega
    exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr ⟨k, hq⟩)
  -- The odd part of a group of order `2 · odd`.
  obtain ⟨K, hKnorm, hKcard, hKmem⟩ := Work.L2F.Props.odd_part_of_two_odd G h2 h4
  -- `K` has index `2` in `G`.
  have hKindex : K.index = 2 := by
    have h1 : Nat.card ↥K * K.index = Nat.card ↥K * 2 := by
      rw [K.card_mul_index, ← hKcard]
    exact Nat.mul_left_cancel (Nat.card_pos_iff.mpr ⟨⟨1, K.one_mem⟩, inferInstance⟩) h1
  -- `|K|` is odd.
  have hKodd : Odd (Nat.card ↥K) := by
    have h1 : Nat.card ↥K * 2 = 2 * Nat.card (G ⧸ Subgroup.zpowers z) := by
      rw [hKcard, hcardG]
    have hq : Nat.card ↥K = Nat.card (G ⧸ Subgroup.zpowers z) := by omega
    rw [hq]; exact hodd
  -- `z ∉ K`, because `z` has even order `2`.
  have hzK : z ∉ K := by
    intro h
    have ho : Odd (orderOf z) := (hKmem z).mp h
    rw [hz] at ho
    obtain ⟨k, hk⟩ := ho
    omega
  refine ⟨K, hKnorm, hKodd, ?_, ?_, ?_⟩
  · intro n hn; exact (hKmem n).mp hn
  · intro g hg; exact (hKmem g).mpr hg
  · intro g
    by_cases hg : g ∈ K
    · exact Or.inl hg
    · right
      have hiff : g * z ∈ K ↔ (g ∈ K ↔ z ∈ K) := K.mul_mem_iff_of_index_two hKindex
      rw [hiff]
      exact ⟨fun h => absurd h hg, fun h => absurd h hzK⟩

end Work.L2F.Props.oddsub
