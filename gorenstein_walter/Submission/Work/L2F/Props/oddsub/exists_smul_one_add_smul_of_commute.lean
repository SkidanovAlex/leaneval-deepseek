import Mathlib

/-!
# The commutant of a non-scalar `2 × 2` matrix is `F·1 + F·t`

Let `F` be a field and let `t : Matrix (Fin 2) (Fin 2) F` be **non-scalar**, i.e. not of the form
`c • 1`.  Then every matrix `m` commuting with `t` is a linear combination `a • 1 + b • t` of `1`
and `t`:

  `exists_smul_one_add_smul_of_commute`.

This is the classical statement that a `2 × 2` matrix which is not scalar has minimal polynomial of
degree `2`, hence is *cyclic*, so that its centralizer (the set of endomorphisms commuting with it)
is the algebra `F[t]` generated by it, of dimension `2` over `F`.

The proof is a direct computation.  Write `t = !![p, q; r, s]` (so `p = t 0 0`, `q = t 0 1`, …) and
`m = !![α, β; γ, δ]`.  Comparing the four entries of `m * t = t * m` gives in particular

* `β * r = q * γ`                                  (the `(0,0)` entry),
* `q * (α - δ) = β * (p - s)`                       (the `(0,1)` entry),
* `r * (δ - α) = γ * (s - p)`                       (the `(1,0)` entry).

Non-scalarity of `t` is the statement `¬ (q = 0 ∧ r = 0 ∧ p = s)`, so one of `q ≠ 0`, `r ≠ 0`,
`p ≠ s` holds.  Accordingly we take `b = β / q`, `b = γ / r` or `b = (δ - α)/(s - p)`
(the three cases also cover `q = 0, r ≠ 0` etc.), set `a = α - b * p` and check the four entries.
No division by `2` is ever needed, so the argument works in every characteristic.
-/

namespace Work.L2F.Props.oddsub

/-- Assembling an identity of `2 × 2` matrices from its four entries against the pair `1, t`:
if the entries of `m` and of `a • 1 + b • t` agree in all four positions, then `m = a • 1 + b • t`.
The four scalar identities are phrased using that `1` has entries `1` on the diagonal and `0`
elsewhere. -/
lemma matrix_eq_smul_one_add_smul_of_entries {F : Type*} [Field F]
    (t m : Matrix (Fin 2) (Fin 2) F) (a b : F)
    (h00 : m 0 0 = a + b * t 0 0) (h01 : m 0 1 = b * t 0 1)
    (h10 : m 1 0 = b * t 1 0) (h11 : m 1 1 = a + b * t 1 1) :
    m = a • (1 : Matrix (Fin 2) (Fin 2) F) + b • t := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.add_apply, Matrix.smul_apply, h00, h01, h10, h11]

theorem exists_smul_one_add_smul_of_commute (F : Type*) [Field F]
    (t m : Matrix (Fin 2) (Fin 2) F)
    (ht : ∀ c : F, t ≠ c • (1 : Matrix (Fin 2) (Fin 2) F)) (hcomm : m * t = t * m) :
    ∃ a b : F, m = a • (1 : Matrix (Fin 2) (Fin 2) F) + b • t := by
  -- Non-scalarity, read on the entries: not (`q = 0`, `r = 0` and `p = s`).
  have hns : ¬ (t 0 1 = 0 ∧ t 1 0 = 0 ∧ t 0 0 = t 1 1) := by
    rintro ⟨ha, hb', hc⟩
    exact ht (t 0 0) (by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [Matrix.smul_apply, ha, hb', hc])
  -- The three entry identities extracted from `m * t = t * m`.
  have e1 : m 0 1 * t 1 0 = t 0 1 * m 1 0 := by
    have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) F => M 0 0) hcomm
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h
    linear_combination h
  have e2 : t 0 1 * (m 0 0 - m 1 1) = m 0 1 * (t 0 0 - t 1 1) := by
    have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) F => M 0 1) hcomm
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h
    linear_combination h
  have e3 : t 1 0 * (m 1 1 - m 0 0) = m 1 0 * (t 1 1 - t 0 0) := by
    have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) F => M 1 0) hcomm
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h
    linear_combination h
  by_cases hq : t 0 1 = 0
  · by_cases hr : t 1 0 = 0
    · -- Case `q = 0`, `r = 0`: then `p ≠ s` by non-scalarity, and `m` is diagonal.
      have hps : t 0 0 ≠ t 1 1 := fun h => hns ⟨hq, hr, h⟩
      have hsp : t 1 1 - t 0 0 ≠ 0 := sub_ne_zero.mpr (Ne.symm hps)
      have hm01 : m 0 1 = 0 := by
        have h := e2
        rw [hq, zero_mul] at h
        rcases mul_eq_zero.mp h.symm with h' | h'
        · exact h'
        · exact absurd h' (sub_ne_zero.mpr hps)
      have hm10 : m 1 0 = 0 := by
        have h := e3
        rw [hr, zero_mul] at h
        rcases mul_eq_zero.mp h.symm with h' | h'
        · exact h'
        · exact absurd h' (sub_ne_zero.mpr (Ne.symm hps))
      set b : F := (m 1 1 - m 0 0) / (t 1 1 - t 0 0) with hbdef
      set a : F := m 0 0 - b * t 0 0 with hadef
      have hb : b * (t 1 1 - t 0 0) = m 1 1 - m 0 0 := by
        rw [hbdef]; exact div_mul_cancel₀ _ hsp
      refine ⟨a, b, matrix_eq_smul_one_add_smul_of_entries t m a b ?_ ?_ ?_ ?_⟩
      · rw [hadef]; ring
      · simp [hm01, hq]
      · simp [hm10, hr]
      · rw [hadef]
        have hh : m 0 0 - b * t 0 0 + b * t 1 1 = m 0 0 + b * (t 1 1 - t 0 0) := by ring
        rw [hh, hb]
        ring
    · -- Case `q = 0`, `r ≠ 0`: take `b = γ / r`.
      have hm01 : m 0 1 = 0 := by
        have h := e1
        rw [hq, zero_mul] at h
        exact (mul_eq_zero.mp h).resolve_right hr
      set b : F := m 1 0 / t 1 0 with hbdef
      set a : F := m 0 0 - b * t 0 0 with hadef
      have hb : b * t 1 0 = m 1 0 := by rw [hbdef]; exact div_mul_cancel₀ _ hr
      have hb2 : b * (t 1 1 - t 0 0) = m 1 1 - m 0 0 := by
        rw [hbdef]
        apply mul_left_cancel₀ hr
        calc t 1 0 * (m 1 0 / t 1 0 * (t 1 1 - t 0 0))
            = (m 1 0 / t 1 0 * t 1 0) * (t 1 1 - t 0 0) := by ring
          _ = m 1 0 * (t 1 1 - t 0 0) := by rw [div_mul_cancel₀ _ hr]
          _ = t 1 0 * (m 1 1 - m 0 0) := e3.symm
      refine ⟨a, b, matrix_eq_smul_one_add_smul_of_entries t m a b ?_ ?_ ?_ ?_⟩
      · rw [hadef]; ring
      · simp [hm01, hq]
      · exact hb.symm
      · rw [hadef]
        have hh : m 0 0 - b * t 0 0 + b * t 1 1 = m 0 0 + b * (t 1 1 - t 0 0) := by ring
        rw [hh, hb2]
        ring
  · -- Case `q ≠ 0`: take `b = β / q`.
    set b : F := m 0 1 / t 0 1 with hbdef
    set a : F := m 0 0 - b * t 0 0 with hadef
    have hb : b * t 0 1 = m 0 1 := by rw [hbdef]; exact div_mul_cancel₀ _ hq
    have hb10 : b * t 1 0 = m 1 0 := by
      rw [hbdef]
      apply mul_left_cancel₀ hq
      calc t 0 1 * (m 0 1 / t 0 1 * t 1 0)
          = (m 0 1 / t 0 1 * t 0 1) * t 1 0 := by ring
        _ = m 0 1 * t 1 0 := by rw [div_mul_cancel₀ _ hq]
        _ = t 0 1 * m 1 0 := e1
    have hb2 : b * (t 1 1 - t 0 0) = m 1 1 - m 0 0 := by
      rw [hbdef]
      apply mul_left_cancel₀ hq
      calc t 0 1 * (m 0 1 / t 0 1 * (t 1 1 - t 0 0))
          = (m 0 1 / t 0 1 * t 0 1) * (t 1 1 - t 0 0) := by ring
        _ = m 0 1 * (t 1 1 - t 0 0) := by rw [div_mul_cancel₀ _ hq]
        _ = -(m 0 1 * (t 0 0 - t 1 1)) := by ring
        _ = -(t 0 1 * (m 0 0 - m 1 1)) := by rw [e2]
        _ = t 0 1 * (m 1 1 - m 0 0) := by ring
    refine ⟨a, b, matrix_eq_smul_one_add_smul_of_entries t m a b ?_ ?_ ?_ ?_⟩
    · rw [hadef]; ring
    · exact hb.symm
    · exact hb10.symm
    · rw [hadef]
      have hh : m 0 0 - b * t 0 0 + b * t 1 1 = m 0 0 + b * (t 1 1 - t 0 0) := by ring
      rw [hh, hb2]
      ring

end Work.L2F.Props.oddsub
