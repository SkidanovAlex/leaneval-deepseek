/-! ## Auxiliary group-theoretic lemmas for the torus-normalizer computation -/

section Helpers

variable {G : Type*} [Group G]

/-- A subgroup of prime order has a non-identity element. -/
lemma exists_ne_one_of_card_prime (Y : Subgroup G) {r : ℕ} (hr : r.Prime) (hcard : Nat.card Y = r) :
    ∃ y ∈ Y, y ≠ 1 := by
  by_contra hcon
  push Not at hcon
  have hbot : Y = ⊥ := by
    refine le_antisymm (fun y hy => ?_) (bot_le)
    rw [Subgroup.mem_bot]
    exact hcon y hy
  rw [hbot] at hcard
  have hone : Nat.card (⊥ : Subgroup G) = 1 := by simp
  rw [hone] at hcard
  exact hr.ne_one hcard.symm

/-- A subgroup of prime order is generated by each of its non-identity elements. -/
lemma eq_zpowers_of_mem_of_card_prime (Y : Subgroup G) [Finite ↥Y] {y : G} {r : ℕ} (hy : y ∈ Y)
    (hcard : Nat.card Y = r) (hr : r.Prime) (hy1 : y ≠ 1) : Y = zpowers y := by
  haveI : Fact r.Prime := ⟨hr⟩
  have hle : zpowers y ≤ Y := Subgroup.zpowers_le.mpr hy
  have hyr : y ^ r = 1 := by
    have h := pow_card_eq_one' (G := ↥Y) (x := ⟨y, hy⟩)
    rw [hcard] at h
    simpa using congrArg (fun z : ↥Y => (z : G)) h
  have hord : orderOf y = r := orderOf_eq_prime hyr hy1
  have hcard2 : Nat.card (zpowers y) = r := by rw [Nat.card_zpowers, hord]
  exact (Subgroup.eq_of_le_of_card_ge hle (by rw [hcard, hcard2])).symm

/-- The centralizer of `⟨y⟩` is the centralizer of `{y}`. -/
lemma centralizer_zpowers_eq (y : G) :
    centralizer (zpowers y : Set G) = centralizer ({y} : Set G) := by
  apply le_antisymm
  · intro g hg
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (Subgroup.mem_centralizer_iff.mp hg y (Subgroup.mem_zpowers y)).symm
  · intro g hg
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    have hcomm : Commute y g := (Subgroup.mem_centralizer_singleton_iff.mp hg).symm
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (show a ∈ Subgroup.zpowers y from ha)
    rw [← hk]
    exact Commute.zpow_left hcomm k

/-- `-1 ≠ 1` in `SL(2,F)` when `2 ≠ 0`. -/
lemma negOne_ne_one (F : Type*) [Field F] (h2 : (2 : F) ≠ 0) :
    Work.L2F.negOne F ≠ (1 : Matrix.SpecialLinearGroup (Fin 2) F) := by
  intro h
  have h'' : (-1 : Matrix (Fin 2) (Fin 2) F) = 1 := by
    have := congrArg (fun z : Matrix.SpecialLinearGroup (Fin 2) F =>
      ((z : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F)) h
    simpa [Work.L2F.negOne] using this
  have hentry : (-1 : F) = 1 := by
    have := congrArg (fun z : Matrix (Fin 2) (Fin 2) F => z 0 0) h''
    simpa using this
  have h2' : (1 : F) + 1 = 0 := by linear_combination -hentry
  rw [one_add_one_eq_two] at h2'
  exact h2 h2'

end Helpers

section PSLHelpers

/-- The image in `PSL(2,F)` of `⟨x, -1⟩ ≤ SL(2,F)` is the cyclic subgroup generated by `π x`. -/
lemma map_genZ_eq_zpowers (F : Type*) [Field F] (h2 : (2 : F) ≠ 0)
    (x : Matrix.SpecialLinearGroup (Fin 2) F) :
    (Work.L2F.Torus.genZ F x).map (Work.PSL2.pslMap F) =
      Subgroup.zpowers (Work.PSL2.pslMap F x) := by
  have hπ : Work.PSL2.pslMap F (Work.L2F.negOne F) = 1 :=
    (Work.L2F.Mat2.pslMap_eq_one_iff F h2 (Work.L2F.negOne F)).mpr (Or.inr rfl)
  rw [Work.L2F.Torus.genZ_apply, MonoidHom.map_closure]
  have himg : (Work.PSL2.pslMap F) ''
        ({(x : Matrix.SpecialLinearGroup (Fin 2) F), Work.L2F.negOne F} :
          Set (Matrix.SpecialLinearGroup (Fin 2) F)) =
      ({(Work.PSL2.pslMap F x), 1} : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) := by
    ext z
    constructor
    · rintro ⟨a, ha, haz⟩
      rcases ha with rfl | rfl
      · exact Or.inl haz.symm
      · exact Or.inr ((hπ.symm.trans haz).symm)
    · intro hz
      rcases hz with hz | hz
      · exact ⟨x, Or.inl rfl, hz.symm⟩
      · exact ⟨Work.L2F.negOne F, Or.inr rfl, hπ.trans hz.symm⟩
  rw [himg]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro z hz
    rcases hz with hz | hz
    · rw [hz]; exact Subgroup.mem_zpowers _
    · rw [hz]; exact Subgroup.one_mem _
  · rw [Subgroup.zpowers_le]
    exact Subgroup.subset_closure (by simp)

/-- For a subgroup `C ≤ SL(2,F)` containing `-1`, the image in `PSL(2,F)` has half the size:
`2 * |π(C)| = |C|`. -/
lemma two_mul_card_map_pslMap (F : Type*) [Field F] (h2 : (2 : F) ≠ 0)
    (C : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)) (hC : Work.L2F.negOne F ∈ C) :
    2 * Nat.card (C.map (Work.PSL2.pslMap F)) = Nat.card C := by
  classical
  let g : ↥C := ⟨Work.L2F.negOne F, hC⟩
  let φ : ↥C →* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F :=
    (Work.PSL2.pslMap F).comp C.subtype
  have hφ : ∀ y : ↥C, φ y = Work.PSL2.pslMap F (y : Matrix.SpecialLinearGroup (Fin 2) F) :=
    fun y => rfl
  have hg1 : g ≠ 1 := by
    intro h
    have h' : Work.L2F.negOne F = (1 : Matrix.SpecialLinearGroup (Fin 2) F) :=
      congrArg (fun z : ↥C => (z : Matrix.SpecialLinearGroup (Fin 2) F)) h
    exact negOne_ne_one F h2 h'
  have hg2 : g ^ 2 = 1 := by
    rw [pow_two]
    apply Subtype.ext
    change Work.L2F.negOne F * Work.L2F.negOne F = 1
    exact Work.L2F.Involution.negOne_mul_self F
  have hker : φ.ker = Subgroup.zpowers g := by
    apply le_antisymm
    · intro y hy
      rw [MonoidHom.mem_ker] at hy
      rcases (Work.L2F.Mat2.pslMap_eq_one_iff F h2
        (y : Matrix.SpecialLinearGroup (Fin 2) F)).mp (hφ y ▸ hy) with h | h
      · have hy1 : y = 1 := Subtype.ext h
        rw [hy1]; exact Subgroup.one_mem _
      · have hyg : y = g := Subtype.ext h
        rw [hyg]; exact Subgroup.mem_zpowers g
    · rw [Subgroup.zpowers_le, MonoidHom.mem_ker]
      exact (Work.L2F.Mat2.pslMap_eq_one_iff F h2 (Work.L2F.negOne F)).mpr (Or.inr rfl)
  have hcard : Nat.card φ.ker = 2 := by
    rw [hker, Nat.card_zpowers]
    exact orderOf_eq_prime hg2 hg1
  have hrange : φ.range = C.map (Work.PSL2.pslMap F) := by
    change ((Work.PSL2.pslMap F).comp C.subtype).range =
      Subgroup.map (Work.PSL2.pslMap F) C
    rw [← MonoidHom.map_range (Work.PSL2.pslMap F) C.subtype, Subgroup.range_subtype]
  have hq := Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
  have heq : Nat.card (↥C ⧸ φ.ker) = Nat.card φ.range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
  rw [heq, hcard, hrange] at hq
  rw [mul_comm]
  exact hq.symm

/-- The Galois field `GF(p,k)` for `p` an odd prime is not of characteristic `2`. -/
lemma two_ne_zero_galois {p k : ℕ} [Fact p.Prime] (hp : Odd p) : (2 : GaloisField p k) ≠ 0 := by
  intro h
  have hdvd : p ∣ 2 := (CharP.cast_eq_zero_iff (GaloisField p k) p 2).mp h
  have hle : p ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
  have hge : 2 ≤ p := (Fact.out : p.Prime).two_le
  have hp2 : p = 2 := le_antisymm hle hge
  obtain ⟨m, hm⟩ := hp
  omega

/-- The cardinality of `GF(p,k)`. -/
lemma card_galois {p k : ℕ} [Fact p.Prime] (hk : 5 ≤ p ^ k) :
    Nat.card (GaloisField p k) = p ^ k :=
  GaloisField.card p k (by rintro rfl; simp at hk)

/-! ### Matrix bookkeeping for conjugating the traceless part -/

lemma adjugate_eq_inv_of_det_eq_one {F : Type*} [Field F] (M : Matrix (Fin 2) (Fin 2) F)
    (hM : M.det = 1) : M.adjugate = M⁻¹ := by
  rw [Matrix.inv_def, hM]
  simp

lemma conj_smul {F : Type*} [Field F] (M A : Matrix (Fin 2) (Fin 2) F) (c : F) :
    M * (c • A) * M⁻¹ = c • (M * A * M⁻¹) := by
  rw [Matrix.mul_smul, Matrix.smul_mul]

lemma conj_one {F : Type*} [Field F] (M : Matrix (Fin 2) (Fin 2) F) (hMd : IsUnit M.det) :
    M * 1 * M⁻¹ = 1 := by
  rw [Matrix.mul_one, Matrix.mul_nonsing_inv M hMd]

/-- The main computation in `PSL(2,F)`: for `x ∈ SL(2,F)` with `disc F x ≠ 0`, `π x` of prime
order `r ≠ 2` and `x` not conjugate to `-x`, the centralizer of `π x` is cyclic of order `(q±1)/2`
and its normalizer is dihedral of order `q±1`. -/
theorem torus_normalizer_psl (F : Type*) [Field F] [Fintype F] (h2 : (2 : F) ≠ 0) (r : ℕ)
    (hr : r.Prime) (hr2 : r ≠ 2) (x : Matrix.SpecialLinearGroup (Fin 2) F)
    (hD : Work.L2F.Torus.disc F x ≠ 0)
    (hx : orderOf (Work.PSL2.pslMap F x) = r)
    (hne : ∀ g : Matrix.SpecialLinearGroup (Fin 2) F, g * x * g⁻¹ ≠ Work.L2F.negOne F * x) :
    IsCyclic (Subgroup.centralizer ({Work.PSL2.pslMap F x} :
      Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F))) ∧
    (2 * Nat.card (Subgroup.centralizer ({Work.PSL2.pslMap F x} :
        Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F))) = Nat.card F + 1 ∨
      2 * Nat.card (Subgroup.centralizer ({Work.PSL2.pslMap F x} :
        Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F))) = Nat.card F - 1) ∧
    Nonempty (Subgroup.normalizer (Subgroup.zpowers (Work.PSL2.pslMap F x) :
        Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) ≃*
      DihedralGroup (Nat.card (Subgroup.centralizer ({Work.PSL2.pslMap F x} :
        Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F))))) := by
  classical
  obtain ⟨w, hw2, hwconj⟩ := Work.L2F.Torus.exists_inverting_conjMat F h2 x hD
  have hwinv : ∀ c ∈ Work.L2F.Torus.cent F x, w * c * w⁻¹ = c⁻¹ :=
    fun c hc => Work.L2F.Torus.conj_eq_inv_of_mem_cent F h2 x w c hD hwconj hc
  -- `w` inverts `x` as well
  have hwinv_x : w * x * w⁻¹ = x⁻¹ := by
    set M : Matrix (Fin 2) (Fin 2) F :=
      ((w : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) with hM
    set X : Matrix (Fin 2) (Fin 2) F :=
      ((x : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) with hX
    set t : F := X.trace with ht
    have hMd : IsUnit M.det := by rw [hM, Matrix.SpecialLinearGroup.det_coe]; exact isUnit_one
    have hW : Work.L2F.Torus.conjMat F x = (2 : F) • X - t • 1 := by
      rw [Work.L2F.Torus.conjMat, ← ht, ← hX]
    have hXdet : X.det = 1 := by rw [hX]; exact Matrix.SpecialLinearGroup.det_coe x
    have hCH : X * X = t • X - 1 := by
      have h := Work.L2F.Mat2.sq_eq_trace_smul_sub_det F X
      rw [← ht, hXdet, one_smul] at h
      exact h
    have hconjW : M * Work.L2F.Torus.conjMat F x * M⁻¹ = -Work.L2F.Torus.conjMat F x := hwconj
    have hconjX : M * X * M⁻¹ = t • 1 - X := by
      have hW' : (2 : F) • X = Work.L2F.Torus.conjMat F x + t • 1 := by
        rw [hW]; abel
      have hkey : -Work.L2F.Torus.conjMat F x + t • 1 = (2 : F) • (t • 1 - X) := by
        have h1 : -(Work.L2F.Torus.conjMat F x) + t • 1 =
            -((2 : F) • X) + (t • 1 + t • 1) := by
          rw [hW]; abel
        rw [h1, smul_sub, smul_smul, two_mul, add_smul]
        abel
      have htwo : (2 : F) • (M * X * M⁻¹) = (2 : F) • (t • 1 - X) := by
        calc (2 : F) • (M * X * M⁻¹)
            = M * ((2 : F) • X) * M⁻¹ := by rw [Matrix.mul_smul, Matrix.smul_mul]
          _ = M * (Work.L2F.Torus.conjMat F x + t • 1) * M⁻¹ := by rw [hW']
          _ = M * Work.L2F.Torus.conjMat F x * M⁻¹ + M * (t • 1) * M⁻¹ := by
                rw [Matrix.mul_add, Matrix.add_mul]
          _ = -Work.L2F.Torus.conjMat F x + t • 1 := by
                rw [hconjW, conj_smul, conj_one M hMd]
          _ = (2 : F) • (t • 1 - X) := hkey
      have hcancel := congrArg (fun Y : Matrix (Fin 2) (Fin 2) F => (2 : F)⁻¹ • Y) htwo
      simp only [smul_smul, inv_mul_cancel₀ h2, one_smul] at hcancel
      exact hcancel
    have hcoe : (((w * x * w⁻¹ : Matrix.SpecialLinearGroup (Fin 2) F)) :
        Matrix (Fin 2) (Fin 2) F) = M * X * M⁻¹ := by
      rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
        Matrix.SpecialLinearGroup.coe_inv, ← hM, ← hX,
        adjugate_eq_inv_of_det_eq_one M (by rw [hM, Matrix.SpecialLinearGroup.det_coe])]
    have hxinv : (((x⁻¹ : Matrix.SpecialLinearGroup (Fin 2) F)) :
        Matrix (Fin 2) (Fin 2) F) = t • 1 - X := by
      have hmul : X * (t • (1 : Matrix (Fin 2) (Fin 2) F) - X) = 1 := by
        rw [Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one, hCH]
        module
      have hdet : (t • (1 : Matrix (Fin 2) (Fin 2) F) - X).det = 1 := by
        have h := congrArg Matrix.det hmul
        rw [Matrix.det_mul, Matrix.SpecialLinearGroup.det_coe, Matrix.det_one, one_mul] at h
        exact h
      set y : Matrix.SpecialLinearGroup (Fin 2) F :=
        ⟨t • (1 : Matrix (Fin 2) (Fin 2) F) - X, hdet⟩ with hydef
      have hy : x * y = 1 := by
        apply Subtype.ext
        rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one,
          show ((y : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) =
            t • (1 : Matrix (Fin 2) (Fin 2) F) - X from rfl]
        exact hmul
      have hyinv : y = x⁻¹ := eq_inv_of_mul_eq_one_right hy
      rw [← hyinv]
    apply Subtype.ext
    rw [hcoe, hconjX, hxinv]
  have hw_not_mem_cent : w ∉ Work.L2F.Torus.cent F x := by
    intro hwmem
    have hcomm : w * x = x * w := Subgroup.mem_centralizer_singleton_iff.mp hwmem
    have hxw : w * x * w⁻¹ = x := by rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
    have hx1 : x = x⁻¹ := by rw [← hwinv_x, hxw]
    have hxx : x * x = 1 := by
      nth_rewrite 2 [hx1]
      exact mul_inv_cancel x
    have hxx' : ((x : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) *
        ((x : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) = 1 := by
      have := congrArg (fun z : Matrix.SpecialLinearGroup (Fin 2) F =>
        ((z : Matrix.SpecialLinearGroup (Fin 2) F) : Matrix (Fin 2) (Fin 2) F)) hxx
      simpa using this
    rcases Work.L2F.Mat2.sq_eq_one_of_mem_sl F h2 x hxx' with h1 | h1
    · rw [h1] at hD
      exact hD (Work.L2F.Torus.disc_one F)
    · rw [h1] at hD
      exact hD (Work.L2F.Torus.disc_negOne F)
  have hNsl := Work.L2F.Torus.normalizer_closure_eq_sup F h2 x w hD hwconj
  have hNpsl := Work.L2F.Torus.normalizer_pslMap_eq F h2 x
  have hCpsl := Work.L2F.Torus.centralizer_pslMap_eq F h2 x r hr hr2 hx
  have hzpow : (Work.L2F.Torus.genZ F x).map (Work.PSL2.pslMap F) =
      Subgroup.zpowers (Work.PSL2.pslMap F x) := map_genZ_eq_zpowers F h2 x
  -- cardinality and cyclicity of the `SL`-centralizer
  obtain ⟨e⟩ := Work.L2F.Torus.centralizer_equiv_hypTorus F h2 x hD
  have hcardC : Nat.card (Work.L2F.Torus.cent F x) = Nat.card F + 1 ∨
      Nat.card (Work.L2F.Torus.cent F x) = Nat.card F - 1 := by
    have hcard : Nat.card (Work.L2F.Torus.cent F x) =
        Nat.card (Work.L2F.hypTorus F (Work.L2F.Torus.disc F x)) :=
      Nat.card_congr e.toEquiv
    rw [hcard]
    by_cases hsq : ∃ s : F, s * s = Work.L2F.Torus.disc F x
    · right
      obtain ⟨s, hs⟩ := hsq
      have hs0 : s ≠ 0 := by rintro rfl; rw [mul_zero] at hs; exact hD hs.symm
      rw [← hs, Work.L2F.Torus.hypTorus_card_sq F h2 s hs0]
    · left
      exact Work.L2F.Conic.hypTorus_card F h2 (Work.L2F.Torus.disc F x) hD
        (fun a ha => hsq ⟨a, ha⟩)
  have hcycC : IsCyclic (Work.L2F.Torus.cent F x) :=
    (MulEquiv.isCyclic e).mpr
      (Work.L2F.Conic.hypTorus_cyclic F h2 (Work.L2F.Torus.disc F x) hD)
  -- `-1` is central, so `π` halves the size of `cent F x`
  have hnegC : Work.L2F.negOne F ∈ Work.L2F.Torus.cent F x := by
    rw [Work.L2F.Torus.cent_apply]
    exact Subgroup.center_le_centralizer _
      (Subgroup.mem_center_iff.mpr (fun g => (Work.L2F.Involution.negOne_mul_comm F g).symm))
  have h2card := two_mul_card_map_pslMap F h2 (Work.L2F.Torus.cent F x) hnegC
  -- rewrite the goal in terms of `T = π(C)` and `w̄ = π w`
  rw [hCpsl, ← hzpow, hNpsl, hNsl, Subgroup.map_sup, MonoidHom.map_zpowers]
  have hcycT : IsCyclic ((Work.L2F.Torus.cent F x).map (Work.PSL2.pslMap F)) := by
    have hrange : ((Work.PSL2.pslMap F).comp (Work.L2F.Torus.cent F x).subtype).range =
        (Work.L2F.Torus.cent F x).map (Work.PSL2.pslMap F) := by
      rw [← MonoidHom.map_range, Subgroup.range_subtype]
    rw [← hrange]
    exact isCyclic_of_surjective _
      (MonoidHom.rangeRestrict_surjective
        ((Work.PSL2.pslMap F).comp (Work.L2F.Torus.cent F x).subtype))
  have hwbar2 : Work.PSL2.pslMap F w * Work.PSL2.pslMap F w = 1 := by
    rw [← map_mul, hw2]
    exact (Work.L2F.Mat2.pslMap_eq_one_iff F h2 (Work.L2F.negOne F)).mpr (Or.inr rfl)
  have hbar_inv : ∀ c ∈ (Work.L2F.Torus.cent F x).map (Work.PSL2.pslMap F),
      Work.PSL2.pslMap F w * c * (Work.PSL2.pslMap F w)⁻¹ = c⁻¹ := by
    intro c hc
    obtain ⟨c₀, hc₀, hc₀w⟩ := Subgroup.mem_map.mp hc
    rw [← hc₀w,
      show Work.PSL2.pslMap F w * Work.PSL2.pslMap F c₀ * (Work.PSL2.pslMap F w)⁻¹ =
        Work.PSL2.pslMap F (w * c₀ * w⁻¹) from by rw [map_mul, map_mul, map_inv],
      hwinv c₀ hc₀, map_inv]
  have hbar_notMem : Work.PSL2.pslMap F w ∉
      (Work.L2F.Torus.cent F x).map (Work.PSL2.pslMap F) := by
    intro hmem
    obtain ⟨c, hc, hcw⟩ := Subgroup.mem_map.mp hmem
    have hker : w * c⁻¹ ∈ (Work.PSL2.pslMap F).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hcw, mul_inv_cancel]
    rcases (Work.L2F.Mat2.pslMap_eq_one_iff F h2 (w * c⁻¹)).mp hker with h | h
    · have hwc : w = c := mul_inv_eq_one.mp h
      exact hw_not_mem_cent (hwc ▸ hc)
    · have hwc : w = Work.L2F.negOne F * c := by
        have h' := congrArg (fun z : Matrix.SpecialLinearGroup (Fin 2) F => z * c) h
        rwa [mul_assoc, inv_mul_cancel, mul_one] at h'
      exact hw_not_mem_cent (hwc ▸ (Work.L2F.Torus.cent F x).mul_mem hnegC hc)
  refine ⟨hcycT, ?_, ?_⟩
  · rw [h2card]
    exact hcardC
  · exact Work.L2F.Torus.mulEquiv_dihedral_of_cyclic_sup_zpowers
      ((Work.L2F.Torus.cent F x).map (Work.PSL2.pslMap F)) (Work.PSL2.pslMap F w)
      hcycT hwbar2 hbar_notMem hbar_inv

end PSLHelpers

/-- `L2TorusNormalizerProp`: for an odd prime `r ≠ p` and a subgroup `Y` of order `r`, the
centralizer of `Y` is cyclic of order `(q±1)/2` and its normalizer is dihedral of the same doubled
order.
Proof: any `1 ≠ x ∈ Y` has order `r`, `Y = ⟨x⟩` (prime order), so `C(Y) = C(x)`; `x` is semisimple
(`r ≠ p`), so `C(x)` is the maximal torus generated by `x`: a cyclic group of order `(q±1)/2`
(its preimage in `SL` is `F[x]^•` for the quadratic algebra of `x`, of order `q∓1`).  Since
normalizing `Y` normalizes `C(Y)`, `N(Y) = N(C(Y))`, and `C(Y)` is characteristic in `N(Y)`; the
normalizer of a torus is the dihedral group of order `2|C(Y)| = q±1`. -/
theorem L2TorusNormalizer : Work.L2F.L2TorusNormalizerProp := by
  intro p k _ hp hk r hr hr2 hrp Y hYcard
  haveI : Fintype (GaloisField p k) := Fintype.ofFinite _
  have h2 : (2 : GaloisField p k) ≠ 0 := two_ne_zero_galois hp
  have hcardF : Nat.card (GaloisField p k) = p ^ k := card_galois hk
  -- a non-identity element of `Y` and its order
  obtain ⟨y, hyY, hy1⟩ := exists_ne_one_of_card_prime Y hr hYcard
  have hyord : orderOf y = r := by
    haveI : Fact r.Prime := ⟨hr⟩
    refine orderOf_eq_prime ?_ hy1
    have h := pow_card_eq_one' (G := ↥Y) (x := ⟨y, hyY⟩)
    rw [hYcard] at h
    simpa using congrArg (fun z : ↥Y =>
      (z : Matrix.ProjectiveSpecialLinearGroup (Fin 2) (GaloisField p k))) h
  -- lift `y` to `SL(2,F)`
  obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective
    (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (GaloisField p k))) y
  have hxord : orderOf (Work.PSL2.pslMap (GaloisField p k) x) = r := by
    rw [show Work.PSL2.pslMap (GaloisField p k) x = y from hx, hyord]
  -- the `SL`-level hypotheses
  have hD : Work.L2F.Torus.disc (GaloisField p k) x ≠ 0 :=
    Work.L2F.Torus.disc_ne_zero (GaloisField p k) p r hp x hr hrp hxord
  have hne : ∀ g : Matrix.SpecialLinearGroup (Fin 2) (GaloisField p k),
      g * x * g⁻¹ ≠ Work.L2F.negOne (GaloisField p k) * x :=
    fun g => Work.L2F.Torus.ne_conj_negOne_mul (GaloisField p k) h2 x g r hr hr2 hxord
  obtain ⟨hcyc, hcard, hdih⟩ := torus_normalizer_psl (GaloisField p k) h2 r hr hr2 x hD hxord hne
  -- identify `⟨π x⟩` with `Y = ⟨y⟩`
  have hYdef : Y = Subgroup.zpowers (Work.PSL2.pslMap (GaloisField p k) x) := by
    rw [eq_zpowers_of_mem_of_card_prime Y hyY hYcard hr hy1,
      show y = Work.PSL2.pslMap (GaloisField p k) x from hx.symm]
  have hCZ : Subgroup.centralizer ({Work.PSL2.pslMap (GaloisField p k) x} :
        Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) (GaloisField p k))) =
      (Work.L2F.Torus.cent (GaloisField p k) x).map (Work.PSL2.pslMap (GaloisField p k)) :=
    Work.L2F.Torus.centralizer_pslMap_eq (GaloisField p k) h2 x r hr hr2 hxord
  have hcentZ : Subgroup.centralizer (Subgroup.zpowers (Work.PSL2.pslMap (GaloisField p k) x) :
        Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) (GaloisField p k))) =
      (Work.L2F.Torus.cent (GaloisField p k) x).map (Work.PSL2.pslMap (GaloisField p k)) := by
    rw [centralizer_zpowers_eq]
    exact hCZ
  have hcentY : Subgroup.centralizer (Y : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2)
        (GaloisField p k))) =
      (Work.L2F.Torus.cent (GaloisField p k) x).map (Work.PSL2.pslMap (GaloisField p k)) := by
    rw [hYdef]
    exact hcentZ
  have hnegCY : Work.L2F.negOne (GaloisField p k) ∈ Work.L2F.Torus.cent (GaloisField p k) x := by
    rw [Work.L2F.Torus.cent_apply]
    exact Subgroup.center_le_centralizer _
      (Subgroup.mem_center_iff.mpr
        (fun g => (Work.L2F.Involution.negOne_mul_comm (GaloisField p k) g).symm))
  have h2cardY : 2 * Nat.card ((Work.L2F.Torus.cent (GaloisField p k) x).map
      (Work.PSL2.pslMap (GaloisField p k))) = Nat.card (Work.L2F.Torus.cent (GaloisField p k) x) :=
    two_mul_card_map_pslMap (GaloisField p k) h2 _ hnegCY
  rw [hCZ] at hcyc hcard hdih
  rw [h2cardY, hcardF] at hcard
  refine ⟨?_, ?_, ?_⟩
  · rw [hcentY]
    exact hcyc
  · rw [hcentY, h2cardY]
    exact hcard
  · rw [hYdef, hcentZ]
    exact hdih

end Work.L2F.Props
