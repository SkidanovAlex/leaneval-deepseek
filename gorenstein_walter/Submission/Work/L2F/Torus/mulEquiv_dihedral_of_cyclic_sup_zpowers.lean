import Mathlib
import Submission.Work.L2F.Dihedral.mulEquiv_dihedral_of_cyclic_index_two

namespace Work.L2F.Torus

/-- If `w * w = 1` and `w` inverts a subgroup `T` by conjugation, then every element of the
subgroup generated by `T` and `w` lies in `T` or in the coset `T * w`.

The set `{x | x ∈ T ∨ x * w ∈ T}` is closed under `1`, multiplication and inversion: the only
non-formal steps are `w * c * w = c⁻¹` and `w * c = c⁻¹ * w` for `c ∈ T`, which follow from
`hinv` and `w⁻¹ = w`.  Since this set is a subgroup containing `T` and `w`, it contains
`T ⊔ Subgroup.zpowers w`. -/
lemma mem_or_mul_mem_of_mem_sup_zpowers {G : Type*} [Group G] (T : Subgroup G) (w : G)
    (hw : w * w = 1) (hinv : ∀ c ∈ T, w * c * w⁻¹ = c⁻¹) :
    ∀ x ∈ T ⊔ Subgroup.zpowers w, x ∈ T ∨ x * w ∈ T := by
  have hw_inv : w⁻¹ = w := by
    rw [inv_eq_iff_mul_eq_one]
    exact hw
  -- `w * c = c⁻¹ * w` for `c ∈ T`
  have hwc : ∀ c ∈ T, w * c = c⁻¹ * w := by
    intro c hc
    calc w * c = w * c * 1 := (mul_one _).symm
      _ = w * c * (w⁻¹ * w) := by rw [inv_mul_cancel, mul_one]
      _ = (w * c * w⁻¹) * w := by group
      _ = c⁻¹ * w := by rw [hinv c hc]
  -- `c * w = w * c⁻¹` for `c ∈ T`
  have hcw : ∀ c ∈ T, c * w = w * c⁻¹ := by
    intro c hc
    calc c * w = ((w * w) * c) * w := by rw [hw, one_mul]
      _ = (w * (w * c)) * w := by group
      _ = (w * (c⁻¹ * w)) * w := by rw [hwc c hc]
      _ = w * c⁻¹ * (w * w) := by group
      _ = w * c⁻¹ := by rw [hw, mul_one]
  -- `w * c * w = c⁻¹` for `c ∈ T`
  have hwcw : ∀ c ∈ T, w * c * w = c⁻¹ := by
    intro c hc
    have h := hinv c hc
    rwa [hw_inv] at h
  let S : Subgroup G :=
    { carrier := {x : G | x ∈ T ∨ x * w ∈ T}
      one_mem' := Or.inl T.one_mem
      mul_mem' := by
        intro a b ha hb
        rcases ha with ha | ha <;> rcases hb with hb | hb
        · exact Or.inl (T.mul_mem ha hb)
        · exact Or.inr (by rw [mul_assoc]; exact T.mul_mem ha hb)
        · refine Or.inr ?_
          have h1 : (a * b) * w = (a * w) * b⁻¹ := by rw [mul_assoc, hcw b hb, mul_assoc]
          rw [h1]
          exact T.mul_mem ha (T.inv_mem hb)
        · refine Or.inl ?_
          have hb_eq : b = (b * w) * w := by rw [mul_assoc, hw, mul_one]
          have h3 : w * (b * w) * w = (b * w)⁻¹ := hwcw (b * w) hb
          have hwb : w * b = (b * w)⁻¹ := by
            conv_lhs => rw [hb_eq]
            calc w * ((b * w) * w) = w * (b * w) * w := by group
              _ = (b * w)⁻¹ := h3
          have key : (a * w) * (w * b) = a * b := by
            calc (a * w) * (w * b) = a * (w * (w * b)) := by rw [mul_assoc]
              _ = a * ((w * w) * b) := by rw [mul_assoc w w b]
              _ = a * (1 * b) := by rw [hw]
              _ = a * b := by rw [one_mul]
          rw [← key, hwb]
          exact T.mul_mem ha (T.inv_mem hb)
      inv_mem' := by
        intro a ha
        rcases ha with ha | ha
        · exact Or.inl (T.inv_mem ha)
        · refine Or.inr ?_
          have h3 : w * (a * w)⁻¹ * w = a * w := by
            have h := hwcw (a * w)⁻¹ (T.inv_mem ha)
            rwa [inv_inv] at h
          have key : a⁻¹ = w * (a * w)⁻¹ := by
            rw [mul_inv_rev, hw_inv, ← mul_assoc, hw, one_mul]
          have key2 : a⁻¹ * w = a * w := by
            rw [key]
            exact h3
          rw [key2]
          exact ha }
  have hle : T ⊔ Subgroup.zpowers w ≤ S :=
    sup_le (fun x hx => Or.inl hx)
      (Subgroup.zpowers_le.mpr (Or.inr (by rw [hw]; exact T.one_mem)))
  intro x hx
  exact hle hx

/-- A cyclic subgroup `T` of a finite group, together with an involutive `w ∉ T` inverting `T`,
generates a dihedral group: `T ⊔ ⟨w⟩ ≃* DihedralGroup (Nat.card T)`. -/
theorem mulEquiv_dihedral_of_cyclic_sup_zpowers {G : Type*} [Group G] [Finite G] (T : Subgroup G)
    (w : G) (hcyc : IsCyclic T) (hw : w * w = 1) (hwT : w ∉ T)
    (hinv : ∀ c ∈ T, w * c * w⁻¹ = c⁻¹) :
    Nonempty (↥(T ⊔ Subgroup.zpowers w) ≃* DihedralGroup (Nat.card T)) := by
  classical
  have hmem : ∀ x ∈ T ⊔ Subgroup.zpowers w, x ∈ T ∨ x * w ∈ T :=
    mem_or_mul_mem_of_mem_sup_zpowers T w hw hinv
  have hle : T ≤ T ⊔ Subgroup.zpowers w := le_sup_left
  let C : Subgroup ↥(T ⊔ Subgroup.zpowers w) := T.subgroupOf (T ⊔ Subgroup.zpowers w)
  have hcycC : IsCyclic C := (MulEquiv.isCyclic (Subgroup.subgroupOfEquivOfLe hle)).mpr hcyc
  let wH : ↥(T ⊔ Subgroup.zpowers w) := ⟨w, Subgroup.mem_sup_right (Subgroup.mem_zpowers w)⟩
  have hwH : (wH : G) = w := rfl
  have hwH_sq : wH * wH = 1 := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul, Subgroup.coe_one, hwH, hw]
  have hwH_notMem : wH ∉ C := by
    intro hmem'
    rw [Subgroup.mem_subgroupOf] at hmem'
    rw [hwH] at hmem'
    exact hwT hmem'
  have hwH_inv : ∀ c ∈ C, wH * c * wH⁻¹ = c⁻¹ := by
    intro c hc
    have hcT : (c : G) ∈ T := Subgroup.mem_subgroupOf.mp hc
    apply Subtype.ext
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, hwH]
    exact hinv (c : G) hcT
  have hidx : C.index = 2 := by
    rw [Subgroup.index_eq_two_iff_exists_notMem_and]
    refine ⟨wH, hwH_notMem, ?_⟩
    intro b
    rcases hmem (b : G) b.2 with hb | hb
    · right
      exact Subgroup.mem_subgroupOf.mpr hb
    · left
      refine Subgroup.mem_subgroupOf.mpr ?_
      show ((b * wH : ↥(T ⊔ Subgroup.zpowers w)) : G) ∈ T
      rw [Subgroup.coe_mul, hwH]
      exact hb
  obtain ⟨e⟩ := Work.L2F.Dihedral.mulEquiv_dihedral_of_cyclic_index_two C hcycC hidx
    ⟨wH, hwH_notMem, hwH_sq, hwH_inv⟩
  have hcard : Nat.card C = Nat.card T :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv
  rw [← hcard]
  exact ⟨e⟩

end Work.L2F.Torus
