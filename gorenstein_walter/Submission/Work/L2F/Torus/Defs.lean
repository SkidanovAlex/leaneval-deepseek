# AREA `L2F/Torus`: semisimple elements of `SL(2,F)` and their (maximal) tori

This file is the *interface* of the area `Submission/Work/L2F/Torus/`.

For `x ∈ SL(2,F)` with characteristic polynomial `X² - tr(x)·X + 1` we write

* `disc F x = tr(x)² - 4`, the discriminant of the characteristic polynomial;
* `conjMat F x = 2 • x - tr(x) • 1`, the traceless part of `2 • x`.

The point of these two quantities is the identity

  `conjMat F x * conjMat F x = disc F x • 1`   (`conjMat_mul_self`),

i.e. `W = conjMat F x` is a traceless matrix with `W² = disc F x • 1`, and `x = (W + tr(x)·1)/2`
(`conjMat_add_trace`, `x_eq_smul_conjMat`).  Hence, for `disc F x ≠ 0` (i.e. `x` not unipotent,
equivalently `x ∉ {±1}`),

* the commutant of `x` in `M₂(F)` is the `F`-algebra `algSpan F (conjMat F x)` of `1` and `W`
  (`Torus/CommuteSpan`),
* the centralizer `C_{SL}(x) = C_{SL}(W)` is the set of `a • 1 + b • W` with `a² - disc·b² = 1`,
  a cyclic group isomorphic to `hypTorus F (disc F x)` (`Torus/MemCentralizer`),
* `N_{SL}(⟨x, -1⟩) = C_{SL}(x) ⊔ ⟨w⟩` where `w` inverts `W` with `w² = -1`
  (`Torus/NormalizerStructure`).

These are the input for `Work.L2F.Props.L2TorusNormalizer`.
-/
import Mathlib
import Submission.Work.L2F.Defs
import Submission.Work.L2F.Mat2.quadAlgebra
import Submission.Work.L2F.Mat2.sq_eq_trace_smul_sub_det

open scoped MatrixGroups
open Matrix

namespace Work.L2F.Torus

variable (F : Type*) [Field F]

/-- The discriminant `tr(x)² - 4` of the characteristic polynomial of `x ∈ SL(2,F)`. -/
def disc (x : SL(2, F)) : F := ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace ^ 2 - 4

/-- The traceless part `2 • x - tr(x) • 1` of `2 • x`; its square is `disc F x • 1`. -/
def conjMat (x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F :=
  (2 : F) • ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) -
    (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace) • (1 : Matrix (Fin 2) (Fin 2) F)

/-- The `F`-span of `1` and a matrix `V` (with `V ∉ F·1` this is the commutative `F`-algebra
`F[X]/(X² - ρ)` where `V² = ρ • 1`). -/
def algSpan (V : Matrix (Fin 2) (Fin 2) F) : Set (Matrix (Fin 2) (Fin 2) F) :=
  {M | ∃ a b : F, M = a • 1 + b • V}

/-- `w ∈ SL(2,F)` conjugates the matrix `M` to `-M` (this is what happens to `conjMat F x` for
the "reflection" `w` in the normalizer of the torus of `x`). -/
def conjNeg (w : SL(2, F)) (M : Matrix (Fin 2) (Fin 2) F) : Prop :=
  ((w : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) * M *
    (((w : SL(2, F)) : Matrix (Fin 2) (Fin 2) F))⁻¹ = -M

/-- The centralizer in `SL(2,F)` of a single element, as a subgroup. -/
def cent (x : SL(2, F)) : Subgroup (SL(2, F)) :=
  Subgroup.centralizer ({(x : SL(2, F))} : Set (SL(2, F)))

/-- The subgroup `⟨x, -1⟩ ≤ SL(2,F)` generated by `x` and the central involution `-1`; its image
in `PSL(2,F)` is the cyclic subgroup generated by the image of `x`. -/
def genZ (x : SL(2, F)) : Subgroup (SL(2, F)) :=
  Subgroup.closure ({(x : SL(2, F)), Work.L2F.negOne F} : Set (SL(2, F)))

@[simp]
theorem cent_apply (x : SL(2, F)) :
    cent F x = Subgroup.centralizer ({(x : SL(2, F))} : Set (SL(2, F))) := rfl

@[simp]
theorem genZ_apply (x : SL(2, F)) :
    genZ F x = Subgroup.closure ({(x : SL(2, F)), Work.L2F.negOne F} : Set (SL(2, F))) := rfl

/-! ## Elementary API -/

@[simp]
theorem disc_apply (x : SL(2, F)) :
    disc F x = ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace ^ 2 - 4 := rfl

@[simp]
theorem conjMat_apply (x : SL(2, F)) :
    conjMat F x = (2 : F) • ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) -
      (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace) • 1 := rfl

theorem conjMat_trace (x : SL(2, F)) : (conjMat F x).trace = 0 := by
  rw [conjMat_apply, Matrix.trace_sub, Matrix.trace_smul, Matrix.trace_smul, Matrix.trace_one,
    Fintype.card_fin, Matrix.trace_fin_two]
  ring

theorem conjMat_add_trace (x : SL(2, F)) :
    conjMat F x + (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace) • 1 =
      (2 : F) • ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) := by
  rw [conjMat_apply]
  abel

theorem x_eq_smul_conjMat (h2 : (2 : F) ≠ 0) (x : SL(2, F)) :
    ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) =
      (2 : F)⁻¹ • conjMat F x +
        ((2 : F)⁻¹ * (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace)) • 1 := by
  have hw := conjMat_add_trace F x
  calc ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F)
      = (2 : F)⁻¹ • ((2 : F) • ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F)) := by
        rw [smul_smul, inv_mul_cancel₀ h2, one_smul]
    _ = (2 : F)⁻¹ • (conjMat F x +
          (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace) • 1) := by rw [← hw]
    _ = (2 : F)⁻¹ • conjMat F x +
          ((2 : F)⁻¹ * (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace)) • 1 := by
        rw [smul_add, smul_smul]

theorem conjMat_mul_self (x : SL(2, F)) :
    conjMat F x * conjMat F x = disc F x • (1 : Matrix (Fin 2) (Fin 2) F) := by
  set X : Matrix (Fin 2) (Fin 2) F := ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) with hX
  set t : F := X.trace with ht
  have hdet : X.det = 1 := by rw [hX]; exact Matrix.SpecialLinearGroup.det_coe x
  have hX2 : X * X = t • X - 1 := by
    rw [Work.L2F.Mat2.sq_eq_trace_smul_sub_det, hdet, ht, one_smul]
  have hW : conjMat F x = (2 : F) • X - t • 1 := by rw [conjMat, ← ht, ← hX]
  rw [hW, disc, ← ht]
  simp only [Matrix.sub_mul, Matrix.mul_sub, Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul,
    Matrix.mul_one, hX2, smul_sub, smul_smul]
  module

theorem conjMat_ne_zero (x : SL(2, F)) (hD : disc F x ≠ 0) : conjMat F x ≠ 0 := by
  intro h
  apply hD
  have h2 := conjMat_mul_self F x
  rw [h, Matrix.mul_zero] at h2
  have h3 := congrArg (fun M : Matrix (Fin 2) (Fin 2) F => M 0 0) h2.symm
  simpa using h3

theorem disc_one : disc F (1 : SL(2, F)) = 0 := by
  rw [disc, Matrix.SpecialLinearGroup.coe_one, Matrix.trace_one, Fintype.card_fin]
  ring

theorem disc_negOne : disc F (Work.L2F.negOne F) = 0 := by
  rw [disc]
  have h : ((Work.L2F.negOne F : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) = -1 := rfl
  rw [h, Matrix.trace_neg, Matrix.trace_one, Fintype.card_fin]
  ring

/-! ## The algebra `algSpan F V` -/

theorem algSpan_one (V : Matrix (Fin 2) (Fin 2) F) :
    (1 : Matrix (Fin 2) (Fin 2) F) ∈ algSpan F V :=
  ⟨1, 0, by simp⟩

theorem algSpan_self (V : Matrix (Fin 2) (Fin 2) F) : V ∈ algSpan F V :=
  ⟨0, 1, by simp⟩

theorem algSpan_add {V : Matrix (Fin 2) (Fin 2) F} {M N : Matrix (Fin 2) (Fin 2) F}
    (hM : M ∈ algSpan F V) (hN : N ∈ algSpan F V) : M + N ∈ algSpan F V := by
  obtain ⟨a, b, rfl⟩ := hM
  obtain ⟨c, e, rfl⟩ := hN
  exact ⟨a + c, b + e, by rw [add_smul, add_smul]; abel⟩

theorem algSpan_smul {V : Matrix (Fin 2) (Fin 2) F} {M : Matrix (Fin 2) (Fin 2) F}
    (hM : M ∈ algSpan F V) (r : F) : r • M ∈ algSpan F V := by
  obtain ⟨a, b, rfl⟩ := hM
  exact ⟨r * a, r * b, by rw [smul_add, smul_smul, smul_smul]⟩

theorem x_mem_algSpan (h2 : (2 : F) ≠ 0) (x : SL(2, F)) :
    ((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) ∈ algSpan F (conjMat F x) := by
  refine ⟨(2 : F)⁻¹ * (((x : SL(2, F)) : Matrix (Fin 2) (Fin 2) F).trace), (2 : F)⁻¹, ?_⟩
  conv_rhs => rw [add_comm]
  exact x_eq_smul_conjMat F h2 x

theorem algSpan_mul {V : Matrix (Fin 2) (Fin 2) F} {ρ : F} (hV : V * V = ρ • 1)
    {M N : Matrix (Fin 2) (Fin 2) F} (hM : M ∈ algSpan F V) (hN : N ∈ algSpan F V) :
    M * N ∈ algSpan F V := by
  obtain ⟨a, b, rfl⟩ := hM
  obtain ⟨c, e, rfl⟩ := hN
  refine ⟨a * c + ρ * (b * e), a * e + b * c, ?_⟩
  simp only [Matrix.add_mul, Matrix.mul_add, Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul,
    Matrix.mul_one, hV, smul_smul, add_smul, smul_add]
  module

/-- The only way `a • 1 + b • V` can be `0` for a non-scalar `V` is `a = b = 0`. -/
theorem algSpan_eq_zero {V : Matrix (Fin 2) (Fin 2) F}
    (hV : ∀ c : F, V ≠ c • 1) (a b : F)
    (h : a • (1 : Matrix (Fin 2) (Fin 2) F) + b • V = 0) : a = 0 ∧ b = 0 := by
  have hb : b = 0 := by
    by_contra hb
    have h2 := congrArg (fun M : Matrix (Fin 2) (Fin 2) F => b⁻¹ • M) h
    simp only [smul_add, smul_smul, smul_zero] at h2
    rw [inv_mul_cancel₀ hb, one_smul, add_eq_zero_iff_eq_neg] at h2
    refine hV (-(b⁻¹ * a)) ?_
    rw [neg_smul, h2, neg_neg]
  subst hb
  have h1 : a • (1 : Matrix (Fin 2) (Fin 2) F) = 0 := by rw [← h]; simp
  have h2 := congrArg (fun M : Matrix (Fin 2) (Fin 2) F => M 0 0) h1
  exact ⟨by simpa using h2, rfl⟩

end Work.L2F.Torus
