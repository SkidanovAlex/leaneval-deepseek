import Mathlib
import Submission.Work.CORE2B.Basic
import Submission.Work.CORE2B.t_central_in_S
import Submission.Work.CORE2B.BenderCtx_sylow_not_cyclic
import Submission.Work.CORE2B.API
import Submission.Work.CORE2B.oddCore_odd

/-!
# `Work.CORE2B.L27_centralizer_solvable` — `H = C_G(t)` is solvable

This is the input `C_M(t) ≤ H` solvable that Bender's proof of Lemma 2.7 (c) (`M` solvable,
`Work.CORE2B.L27_solvable`) consumes: for the minimal counterexample `G` with `BenderSetup B`,
the centralizer `H = C_G(t)` of the central involution `t` of the dihedral Sylow 2-subgroup is
solvable.

**Mathematical content.**  Bender, p. 219: `H = U·S` with `U = O(H)`; this is the toolkit's
`Work.GW2.CentralizerSplitProp` (`T.split`), applied to `B.S`, which is dihedral by
`BenderCtx_sylow_not_cyclic` (a non-abelian finite simple group has non-cyclic Sylow
2-subgroups).  So `H` is the product of a `2`-group `S` and the normal odd-order subgroup
`U = O(H)`, and is therefore solvable:

* `U` is solvable because it has odd order, by Feit–Thompson;
* `H/U` is a quotient of `S` (as `H = U ⊔ S` with `U ◁ H`), hence a `2`-group, hence nilpotent,
  hence solvable;
* an extension of solvable groups is solvable.

The abstract group-theoretic step is `isSolvable_of_normal_sup`; the Bender-specific part is
`centralizer_solvable_of_split`, which turns `H = U ⊔ S` into `IsSolvable ↥B.H` inside the group
`↥B.H` (where `O(↥B.H)` is normal by the instance `Work.GW2.oddCore_normal`, so no relative
normality has to be proved).
-/

namespace Work.CORE2B

open Subgroup

/-! ## 1. The abstract step: a group generated by a normal solvable subgroup and a solvable
subgroup is solvable -/

/-- If `N ◁ X`, `K ≤ X` and `N ⊔ K = ⊤`, then `X` is solvable as soon as `N` and `K` are.

`X ⧸ N` is a quotient of `K`: since `N ⊔ K = ⊤`, every `x : X` is `n * k` with `n ∈ N`, `k ∈ K`
(normality of `N`, `Subgroup.mem_sup_of_normal_left`), so `x` and `k` have the same image in
`X ⧸ N` and `QuotientGroup.mk' N ∘ K.subtype` is surjective.  Then use solvability of an
extension (`Group.isSolvable_of_subgroup_quotient`). -/
theorem isSolvable_of_normal_sup {X : Type} [Group X] (N K : Subgroup X) [N.Normal]
    [Group.IsSolvable ↥N] [Group.IsSolvable ↥K] (h : N ⊔ K = ⊤) : Group.IsSolvable X := by
  have hsurj : Function.Surjective ((QuotientGroup.mk' N).comp K.subtype) := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N y
    have hx : x ∈ N ⊔ K := by rw [h]; exact Subgroup.mem_top x
    obtain ⟨n, hn, k, hk, hnk⟩ := (Subgroup.mem_sup_of_normal_left (s := N) (t := K)).mp hx
    refine ⟨⟨k, hk⟩, ?_⟩
    have hn1 : (QuotientGroup.mk' N) n = 1 := by
      rw [QuotientGroup.mk'_apply]
      exact (QuotientGroup.eq_one_iff n).mpr hn
    show QuotientGroup.mk' N k = QuotientGroup.mk' N x
    rw [← hnk, map_mul, hn1, one_mul]
  haveI : Group.IsSolvable (X ⧸ N) := Group.isSolvable_of_surjective hsurj
  exact Group.isSolvable_of_subgroup_quotient N

/-! ## 2. The Bender-specific step: `H = U ⊔ S` makes `H` solvable -/

/-- **Bender p. 219**: if `H = U ⊔ S` with `U = O(H)` and `S` the (dihedral) Sylow
2-subgroup of `G` containing `t`, then `H = C_G(t)` is solvable.

Inside the group `↥B.H` we have `K := S` (as a subgroup of `H`) and `N := O(↥B.H)`, whose image
in `G` is `B.U` by definition of `Work.GW2.oddCoreIn`.  Then `N ⊔ K = ⊤` (push through the
injective `B.H.subtype`), `N` is solvable by Feit–Thompson (`oddCore_odd`), `K` is solvable
because it embeds in the `2`-group `↥B.S` (`Sylow.isPGroup'`, `IsPGroup.of_injective`,
p-groups are nilpotent), and `isSolvable_of_normal_sup` finishes. -/
theorem centralizer_solvable_of_split {G : Type} [Group G] [Finite G]
    (hFT : Work.GW2.FeitThompsonProp) (B : Work.GW2.BenderSetup G)
    (hSU : B.U ⊔ (B.S : Subgroup G) = B.H) : Group.IsSolvable ↥B.H := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  -- `S ≤ H`, from `H = U ⊔ S`.
  have hSle : (B.S : Subgroup G) ≤ B.H := le_sup_right.trans (le_of_eq hSU)
  -- `S` as a subgroup of `H` is solvable: it embeds into the `2`-group `S`.
  haveI hK : Group.IsSolvable ↥((B.S : Subgroup G).subgroupOf B.H) := by
    let φ : ↥((B.S : Subgroup G).subgroupOf B.H) →* ↥(B.S : Subgroup G) :=
      { toFun := fun x => ⟨x.1.1, Subgroup.mem_subgroupOf.mp x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    have hφinj : Function.Injective φ := by
      intro a b hab
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun z : ↥(B.S : Subgroup G) => (z : G)) hab
    haveI : Group.IsNilpotent ↥((B.S : Subgroup G).subgroupOf B.H) :=
      (IsPGroup.of_injective (Sylow.isPGroup' B.S) φ hφinj).isNilpotent
    exact IsNilpotent.to_isSolvable
  -- `U = O(H)`, viewed inside `↥B.H`, is solvable by Feit–Thompson.
  haveI : Group.IsSolvable ↥(Work.GW2.oddCore ↥B.H) :=
    hFT ↥(Work.GW2.oddCore ↥B.H) (oddCore_odd (G := ↥B.H))
  -- `O(H) ⊔ S = ⊤` inside `↥B.H`: push `U ⊔ S = H` through the injective `B.H.subtype`.
  have hsup : Work.GW2.oddCore ↥B.H ⊔ ((B.S : Subgroup G).subgroupOf B.H) = ⊤ := by
    refine Subgroup.map_injective (B.H).subtype_injective ?_
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hSle, Subgroup.map_top,
      Subgroup.range_subtype]
    exact hSU
  exact isSolvable_of_normal_sup _ _ hsup

/-! ## 3. The lemma

`H = U ⊔ S` is `Work.GW2.CentralizerSplitProp` (`T.split`) applied to the Sylow 2-subgroup
`B.S`, which is dihedral of order `2n` with `n ≥ 2`: `BenderCtx.sylow` says it is cyclic or
dihedral and `BenderCtx_sylow_not_cyclic` excludes the cyclic case (`n ≥ 2` then follows from
`|S| = 2n = 2^k`).  The three remaining hypotheses of `T.split` are `t ∈ S` (`B.S0_le B.t_mem`),
`orderOf t = 2` (`B.t_order`) and `t` central in `S` (`t_central_in_S`, Bender p. 219). -/

theorem L27_centralizer_solvable :
    ∀ (T : Work.GW2.LocalToolkit) (G : Type) [Group G] [Finite G],
      Work.GW2.FeitThompsonProp → Work.GW2.BenderCtx G →
      ∀ (B : Work.GW2.BenderSetup G), Group.IsSolvable ↥B.H := by
  intro T G _ _ hFT hctx B
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  -- `S` is not cyclic (`G` is a non-abelian finite simple group).
  have hnc : ¬ IsCyclic ↥(B.S : Subgroup G) := BenderCtx_sylow_not_cyclic hctx B.S
  -- Hence `S ≅ DihedralGroup n` for some `n ≥ 2`.
  obtain ⟨n, hn2, hdih⟩ :
      ∃ n : ℕ, 2 ≤ n ∧ Nonempty (↥(B.S : Subgroup G) ≃* DihedralGroup n) := by
    rcases hctx.sylow B.S with hcyc | ⟨n, hn⟩
    · exact absurd hcyc hnc
    · obtain ⟨e⟩ := hn
      refine ⟨n, ?_, ⟨e⟩⟩
      -- `|S| = 2n = 2^k` and `S` is not cyclic, so `n ≠ 1`.
      have hcard : Nat.card ↥(B.S : Subgroup G) = 2 * n := by
        rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
      have hncD : ¬ IsCyclic (DihedralGroup n) := fun hc => hnc (e.isCyclic.mpr hc)
      have hn1 : n ≠ 1 := fun h1 => hncD ((DihedralGroup.isCyclic_iff (n := n)).mpr h1)
      obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp B.S.isPGroup'
      have h2n : 2 * n = 2 ^ k := by rw [← hcard, hk]
      have hpos : 1 ≤ 2 ^ k := Nat.one_le_two_pow
      omega
  -- The toolkit's centralizer splitting theorem: `H = U ⊔ S`.
  have hSU : B.U ⊔ (B.S : Subgroup G) = B.H :=
    T.split G B.S n hn2 hdih B.t (B.S0_le B.t_mem) B.t_order (t_central_in_S B)
  exact centralizer_solvable_of_split hFT B hSU

end Work.CORE2B
