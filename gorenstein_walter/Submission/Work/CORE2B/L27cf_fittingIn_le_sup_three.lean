import Mathlib
import Submission.Work.CORE2B.Basic
import Submission.Work.CORE2B.L27cf_helpers
import Submission.Work.CORE2B.L27_fittingPi_sup_compl

/-!
# CORE2B — `F(K) ≤ F_{π₁}(K) · F_{π₂}(K) · F_{π₃}(K)`

The Fitting subgroup `F(K)` is nilpotent, and a finite nilpotent group is the direct product of
its Sylow subgroups; each Sylow `p`-subgroup is normal, so it lies in `O_{π_i}(F(K))` for every `i`
with `p ∈ π_i`.  Hence, as soon as `π₁ ∪ π₂ ∪ π₃` contains every prime,

    F_{π₁}(K) ⊔ F_{π₂}(K) ⊔ F_{π₃}(K) = F(K)

(`F_σ(K) = O_σ(F(K))` realized inside `K`).  This is the three-set generalisation of the two-set
splitting `F_π(K) · F_{π'}(K) = F(K)` proved in `L27_fittingPi_sup_compl`.

The main lemma `L27cf_fittingIn_le_sup_three` records the inclusion, which is the form the
consumers use (no primality hypothesis on the `π_i` is needed).
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.CORE2B

open Subgroup

/-- **A finite nilpotent group is generated by three `π`-cores.**  A finite nilpotent group `H`
is the join of its (unique, hence normal) Sylow subgroups; the Sylow `q`-subgroup has only the
prime `q` among the prime divisors of its order, so it is a normal `π_i`-subgroup of `H` — and
therefore lies in `O_{π_i}(H)` — as soon as `q ∈ π_i`.  The cover hypothesis sends every prime,
hence every Sylow index, into one of the three sets. -/
theorem L27cf_piCore_sup_three_eq_top {H : Type} [Group H] [Finite H] [Group.IsNilpotent H]
    (π₁ π₂ π₃ : Set ℕ)
    (hcover : ∀ q : ℕ, q.Prime → q ∈ π₁ ∨ q ∈ π₂ ∨ q ∈ π₃) :
    Work.GW2.piCore π₁ H ⊔ Work.GW2.piCore π₂ H ⊔ Work.GW2.piCore π₃ H = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← OddOrder.Isaacs.Ch01.iSup_default_sylow_eq_top_of_nilpotent H]
  refine iSup_le ?_
  rintro ⟨p, hp⟩
  have hpP : p.Prime := Nat.prime_of_mem_primeFactors hp
  haveI : Fact p.Prime := ⟨hpP⟩
  -- the Sylow `p`-subgroup is normal (nilpotency) and a `p`-group
  haveI hQn : ((default : Sylow p H) : Subgroup H).Normal :=
    OddOrder.Isaacs.Ch01.Sylow.normal_of_isNilpotent (default : Sylow p H)
  have hQg : IsPGroup p ↥((default : Sylow p H) : Subgroup H) :=
    (default : Sylow p H).isPGroup'
  rcases hcover p hpP with hp1 | hp2 | hp3
  · exact ((le_piCore_of_normal_isPiSubgroup_gw (G := H) (π := π₁)
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem hQg hp1)).trans le_sup_left).trans le_sup_left
  · exact ((le_piCore_of_normal_isPiSubgroup_gw (G := H) (π := π₂)
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem hQg hp2)).trans le_sup_right).trans le_sup_left
  · exact (le_piCore_of_normal_isPiSubgroup_gw (G := H) (π := π₃)
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem hQg hp3)).trans le_sup_right

/-- **`F(K)` is generated by its three `π`-parts** whenever the `π_i` cover all primes:
`F_{π₁}(K) ⊔ F_{π₂}(K) ⊔ F_{π₃}(K) = F(K)`.

`F(K)` is nilpotent, so the nilpotent splitting above gives `O_{π₁}(F(K)) ⊔ O_{π₂}(F(K)) ⊔
O_{π₃}(F(K)) = ⊤` inside the group `↥F(K)`; mapping along the inclusion `↥F(K) ↪ ↥K`
(`Subgroup.map_sup`, `Subgroup.map_top`) yields the identity inside `↥K`, and mapping once more
along `K.subtype` gives the stated subgroups of `G`. -/
theorem L27cf_fittingPiIn_sup_three_eq_fittingIn {G : Type} [Group G] [Finite G] (K : Subgroup G)
    {π₁ π₂ π₃ : Set ℕ}
    (hcover : ∀ q : ℕ, q.Prime → q ∈ π₁ ∨ q ∈ π₂ ∨ q ∈ π₃) :
    Work.GW2.fittingPiIn π₁ K ⊔ Work.GW2.fittingPiIn π₂ K ⊔ Work.GW2.fittingPiIn π₃ K
      = Work.GW2.fittingIn K := by
  haveI : Group.IsNilpotent ↥(Work.GW2.fitting ↥K) := fitting_isNilpotent_gw
  have key : Work.GW2.fittingPi π₁ ↥K ⊔ Work.GW2.fittingPi π₂ ↥K ⊔ Work.GW2.fittingPi π₃ ↥K
      = Work.GW2.fitting ↥K := by
    unfold Work.GW2.fittingPi
    rw [← Subgroup.map_sup, ← Subgroup.map_sup,
      L27cf_piCore_sup_three_eq_top (H := ↥(Work.GW2.fitting ↥K)) π₁ π₂ π₃ hcover,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  unfold Work.GW2.fittingPiIn Work.GW2.fittingIn
  rw [← Subgroup.map_sup, ← Subgroup.map_sup, key]

theorem L27cf_fittingIn_le_sup_three {G : Type} [Group G] [Finite G] (K : Subgroup G)
    {π₁ π₂ π₃ : Set ℕ} (hcover : ∀ q : ℕ, q.Prime → q ∈ π₁ ∨ q ∈ π₂ ∨ q ∈ π₃) :
    Work.GW2.fittingIn K ≤
      Work.GW2.fittingPiIn π₁ K ⊔ Work.GW2.fittingPiIn π₂ K ⊔ Work.GW2.fittingPiIn π₃ K :=
  le_of_eq (L27cf_fittingPiIn_sup_three_eq_fittingIn K hcover).symm

end Work.CORE2B
