import Mathlib
import Submission.Work.Dihedral.Defs

/-!
# `Work.CORE2B.dihedral_index_two`

In a dihedral group `DihedralGroup n` (`n ≥ 2`) the elements outside the unique cyclic subgroup
of index two (the rotation subgroup) are exactly the reflections, hence have order `2`.  This is
the structural fact behind `Work.CORE2B.dihedral_index_two`, which transports it to an arbitrary
group `G` containing a subgroup `S ≃* DihedralGroup n`.

The proof is self-contained and uses the explicit normal form `r i` / `sr i` of `DihedralGroup n`
together with the library `Work.Dihedral` (`rot`, `notMem_rot`, `r_mem_rot`, `nat_card_rot`).
-/

namespace Work.CORE2B

open Work.Dihedral

set_option linter.style.haveILetI false

/-- In `DihedralGroup n` with `n ≥ 2`, any element outside the cyclic subgroup generated by an
element `t` of order `n` has order `2`.

Since `orderOf t = n`, `Subgroup.zpowers t` is a subgroup of order `n`, i.e. of index two in the
dihedral group of order `2n`.  Such a `t` is necessarily a rotation (`t ∉ rot n` would force
`orderOf t = 2`, hence `n = 2`), so `Subgroup.zpowers t = rot n`, and everything outside `rot n`
is a reflection `sr i`, of order `2`.  The exceptional case `n = 2` is the Klein four group, in
which every nonidentity element has order `2`; there `Subgroup.zpowers t` is an arbitrary
subgroup of order two, and the argument for `r i` is finished by `(r i)² = 1`, `r i ≠ 1`. -/
theorem dihedral_outside_zpowers {n : ℕ} (hn : 2 ≤ n) (t : DihedralGroup n)
    (ht : orderOf t = n) : ∀ x : DihedralGroup n, x ∉ Subgroup.zpowers t → orderOf x = 2 := by
  have hn0 : n ≠ 0 := by omega
  haveI : NeZero n := ⟨hn0⟩
  intro x hx
  cases x with
  | r i =>
    by_cases htrot : t ∈ rot n
    · -- `t` is a rotation, so `⟨t⟩` is a cyclic subgroup of order `n`; as `rot n` is the
      -- unique such subgroup they coincide.
      have hzle : Subgroup.zpowers t ≤ rot n := Subgroup.zpowers_le.mpr htrot
      have hcard : Nat.card ↥(Subgroup.zpowers t) = Nat.card ↥(rot n) := by
        rw [Nat.card_zpowers, ht, nat_card_rot]
      have hz : Subgroup.zpowers t = rot n :=
        Subgroup.eq_of_le_of_card_ge hzle hcard.symm.le
      exact absurd (by rw [hz]; exact r_mem_rot i) hx
    · -- `t` is a reflection: `orderOf t = 2`, so `n = 2`.
      obtain ⟨j, hj⟩ := notMem_rot.mp htrot
      have hn2 : n = 2 := by rw [← ht, hj, DihedralGroup.orderOf_sr]
      subst hn2
      -- In `DihedralGroup 2` every nonidentity element has order `2`.
      have hsq : (DihedralGroup.r i : DihedralGroup 2) ^ 2 = 1 := by
        rw [pow_two, DihedralGroup.r_mul_r]
        congr 1
        exact CharTwo.add_self_eq_zero i
      have hdvd : orderOf (DihedralGroup.r i : DihedralGroup 2) ∣ 2 :=
        orderOf_dvd_iff_pow_eq_one.mpr hsq
      have hne1 : (DihedralGroup.r i : DihedralGroup 2) ≠ 1 := by
        intro h1
        exact hx (h1.symm ▸ Subgroup.one_mem (Subgroup.zpowers t))
      have hle : orderOf (DihedralGroup.r i : DihedralGroup 2) ≤ 2 :=
        Nat.le_of_dvd (by norm_num) hdvd
      have hpos : 0 < orderOf (DihedralGroup.r i : DihedralGroup 2) := orderOf_pos _
      have hne1' : orderOf (DihedralGroup.r i : DihedralGroup 2) ≠ 1 :=
        fun h => hne1 (orderOf_eq_one_iff.mp h)
      omega
  | sr i => rw [DihedralGroup.orderOf_sr]

/-- **`Work.CORE2B.dihedral_index_two`.**  Let `S` be a subgroup of a group `G` isomorphic to
the dihedral group of order `2n` (`n ≥ 2`), and let `S₀ ≤ S` be a cyclic subgroup of index two.
Then every element of `S` outside `S₀` has order `2`.

(`S₀` has order `n`, hence is generated by an element `g` of order `n`; under the isomorphism
`S ≃* DihedralGroup n` the subgroup `S₀` becomes `Subgroup.zpowers t` for an element `t` of order
`n`, and `dihedral_outside_zpowers` says precisely that everything outside it has order `2`.) -/
theorem dihedral_index_two {G : Type} [Group G] (n : ℕ) (hn : 2 ≤ n) (S S0 : Subgroup G)
    (hD : Nonempty (S ≃* DihedralGroup n)) (hS0 : S0 ≤ S) (hcyc : IsCyclic S0)
    (hidx : S0.relIndex S = 2) : ∀ s ∈ S, s ∉ S0 → orderOf s = 2 := by
  obtain ⟨e⟩ := hD
  have hn0 : n ≠ 0 := by omega
  haveI : NeZero n := ⟨hn0⟩
  -- `|S| = 2n` and `|S₀| = n`.
  have hcardS : Nat.card ↥S = 2 * n := by
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hrel : 2 * Nat.card ↥S0 = 2 * n := by
    have h := Subgroup.relIndex_mul_card S0 S
    rw [inf_eq_left.mpr hS0, hidx, hcardS] at h
    exact h
  have hcardS0 : Nat.card ↥S0 = n := Nat.mul_left_cancel (by norm_num) hrel
  -- `S₀` is cyclic, say with generator `g` of order `n`.
  haveI : IsCyclic ↥S0 := hcyc
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥S0)
  have hordg : orderOf g = n := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, hcardS0]
  -- `t`, the image of `g` in `DihedralGroup n`, also has order `n`.
  let t : DihedralGroup n := e ⟨(g : G), hS0 g.2⟩
  have ht : orderOf t = n := by
    rw [show t = e ⟨(g : G), hS0 g.2⟩ from rfl, MulEquiv.orderOf_eq]
    rw [← Subgroup.orderOf_coe (⟨(g : G), hS0 g.2⟩ : ↥S), Subgroup.orderOf_coe g, hordg]
  have hDz := dihedral_outside_zpowers hn t ht
  -- The image of `S₀` in `DihedralGroup n` is `⟨t⟩`.
  have hgen : Subgroup.zpowers (⟨(g : G), hS0 g.2⟩ : ↥S) = S0.subgroupOf S := by
    apply le_antisymm
    · exact Subgroup.zpowers_le.mpr (Subgroup.mem_subgroupOf.mpr g.2)
    · intro y hy
      rw [Subgroup.mem_zpowers_iff]
      have hyG : (y : G) ∈ S0 := Subgroup.mem_subgroupOf.mp hy
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨(y : G), hyG⟩)
      refine ⟨k, ?_⟩
      apply Subtype.ext
      rw [Subgroup.coe_zpow]
      have hk' : ((g : G)) ^ k = (y : G) := by
        have h := congrArg Subtype.val hk
        simpa using h
      rw [show ((⟨(g : G), hS0 g.2⟩ : ↥S) : G) = (g : G) from rfl, hk']
  -- An element `s ∈ S \ S₀` maps to an element outside `⟨t⟩`.
  intro s hs hsS0
  have heS : e (⟨s, hs⟩ : ↥S) ∉ Subgroup.zpowers t := by
    intro hmem
    apply hsS0
    have : (⟨s, hs⟩ : ↥S) ∈ Subgroup.zpowers (⟨(g : G), hS0 g.2⟩ : ↥S) := by
      rw [Subgroup.mem_zpowers_iff] at hmem ⊢
      obtain ⟨k, hk⟩ := hmem
      refine ⟨k, ?_⟩
      have hk2 : e ((⟨(g : G), hS0 g.2⟩ : ↥S) ^ k) = e (⟨s, hs⟩ : ↥S) := by
        rw [map_zpow]
        exact hk
      exact e.injective hk2
    rw [hgen] at this
    exact Subgroup.mem_subgroupOf.mp this
  have hfin := hDz (e (⟨s, hs⟩ : ↥S)) heS
  rw [MulEquiv.orderOf_eq e (⟨s, hs⟩ : ↥S), ← Subgroup.orderOf_coe (⟨s, hs⟩ : ↥S)] at hfin
  exact hfin

end Work.CORE2B
