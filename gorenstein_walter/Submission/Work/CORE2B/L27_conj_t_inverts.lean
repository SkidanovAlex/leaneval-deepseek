import Mathlib

namespace Work.CORE2B

open Subgroup
open scoped commutatorElement

/-- The commutator of any element `h` with an element `u` of the subgroup generated by an
involution `t` is inverted by `t`.

This is the elementary core of Lemma 2.7: since `t * t = 1`, the subgroup `⟨t⟩` is `{1, t}`
(so `u = 1` or `u = t`), and a direct computation gives `t * ⁅h, t⁆ * t⁻¹ = ⁅h, t⁆⁻¹`. -/
private theorem conj_commutator_zpowers {G : Type} [Group G] {t : G} (ht2 : t * t = 1)
    (h u : G) (hu : u ∈ Subgroup.zpowers t) :
    t * ⁅h, u⁆ * t⁻¹ = ⁅h, u⁆⁻¹ := by
  have hti : t⁻¹ = t := by rw [inv_eq_iff_mul_eq_one]; exact ht2
  have ht2pow : t ^ (2 : ℕ) = 1 := by rw [pow_two]; exact ht2
  rw [Subgroup.mem_zpowers_iff] at hu
  obtain ⟨k, rfl⟩ := hu
  rw [zpow_eq_zpow_emod' k ht2pow]
  have hk2 : k % ((2 : ℕ) : ℤ) = 0 ∨ k % ((2 : ℕ) : ℤ) = 1 := Int.emod_two_eq_zero_or_one k
  rcases hk2 with hk | hk <;> rw [hk]
  · simp
  · simp only [zpow_one, commutatorElement_def, hti, mul_assoc, mul_inv_rev, inv_inv, ht2,
      mul_one]

theorem L27_conj_t_inverts {G : Type} [Group G] (M : Subgroup G) {t : G}
    (ht2 : t * t = 1)
    (hab : ∀ x ∈ ⁅M, Subgroup.zpowers t⁆, ∀ y ∈ ⁅M, Subgroup.zpowers t⁆, x * y = y * x) :
    ∀ x ∈ ⁅M, Subgroup.zpowers t⁆, t * x * t⁻¹ = x⁻¹ := by
  -- Every commutator `⁅h, u⁆` with `u ∈ ⟨t⟩` is inverted by `t`.
  have hgen : ∀ (h u : G), u ∈ Subgroup.zpowers t → t * ⁅h, u⁆ * t⁻¹ = ⁅h, u⁆⁻¹ :=
    fun h u hu => conj_commutator_zpowers ht2 h u hu
  intro x hx
  -- The set of elements of `A = ⁅M, ⟨t⟩⁆` inverted by `t` contains the generators of `A` and is
  -- a subgroup of `A` (here the commutativity `hab` of `A` is used, to turn inversion into a
  -- homomorphism).
  let A : Subgroup G := ⁅M, Subgroup.zpowers t⁆
  have hxA : x ∈ A := hx
  refine (Subgroup.closure_induction
    (p := fun y _ => y ∈ A ∧ t * y * t⁻¹ = y⁻¹)
    (k := {g : G | ∃ g₁ ∈ M, ∃ g₂ ∈ Subgroup.zpowers t, ⁅g₁, g₂⁆ = g})
    ?_ ?_ ?_ ?_ hxA).2
  · rintro g ⟨g₁, hg₁, g₂, hg₂, rfl⟩
    exact ⟨Subgroup.commutator_mem_commutator hg₁ hg₂, hgen g₁ g₂ hg₂⟩
  · exact ⟨A.one_mem, by simp⟩
  · rintro y z _ _ ⟨hyA, hy'⟩ ⟨hzA, hz'⟩
    refine ⟨A.mul_mem hyA hzA, ?_⟩
    have h1 : t * (y * z) * t⁻¹ = (t * y * t⁻¹) * (t * z * t⁻¹) := by group
    rw [h1, hy', hz']
    rw [hab y hyA z hzA, mul_inv_rev]
  · rintro y _ ⟨hyA, hy'⟩
    refine ⟨A.inv_mem hyA, ?_⟩
    have h1 : t * y⁻¹ * t⁻¹ = (t * y * t⁻¹)⁻¹ := by group
    rw [h1, hy']

end Work.CORE2B
