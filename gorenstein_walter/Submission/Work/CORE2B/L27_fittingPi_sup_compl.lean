import Mathlib
import Submission.Work.CORE2B.Basic
import Submission.Work.CORE2B.L27_solvable_base

/-!
# CORE2B — Bender 2.7: `F(M) = F_π(M) · F_{π'}(M)`

The Fitting subgroup of any (finite) group is nilpotent, and a finite nilpotent group is the
direct product of its Sylow subgroups; hence its `π`-part and its `π'`-part generate it:

    F_π(M) ⊔ F_{π'}(M) = F(M),   where `F_σ(M) = O_σ(F(M))`.

The whole content is the group-theoretic statement, for a finite nilpotent group `H`,

    `O_π(H) ⊔ O_{π'}(H) = ⊤`

(no primality hypothesis on `π` is needed: a Sylow `q`-subgroup of `H` is normal, so it lies in
`O_{⟨q⟩}(H)`, and `q` lies in `π` or in `πᶜ`).  Composing with the inclusion `F(M) ↪ M` and
using `Subgroup.map_sup` gives the theorem.

The only imported input is the odd-order library's Sylow theory of nilpotent groups
(`Sylow.normal_of_isNilpotent`, `iSup_default_sylow_eq_top_of_nilpotent`) together with Isaacs'
`F(G)` (`fitting.isNilpotent`, `nilpotent_normal_le_fitting`).
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.CORE2B

open Subgroup

/-! ## 1. The `Work.GW2` vocabulary in terms of the library's `F`, and nilpotency of `F` -/

/-- **Universal property of `O_π(G)`.**  Every normal `π`-subgroup lies in `O_π(G)`: `O_π(G)` is
the normal core of the join of the normal `π`-subgroups, and a normal subgroup contained in a
join lies in its normal core. -/
theorem le_piCore_of_normal_isPiSubgroup_gw {G : Type} [Group G] {π : Set ℕ}
    {N : Subgroup G} [N.Normal] (hN : Subgroup.IsPiSubgroup π N) :
    N ≤ Work.GW2.piCore π G :=
  Subgroup.normal_le_normalCore.mpr (le_sSup ⟨‹N.Normal›, hN⟩)

/-- `F(G) = (sSup {N | N ◁ G, N nilpotent}).normalCore` is Isaacs' `F(G) = ⨆_p O_p(G)`: every
normal nilpotent subgroup lies in Isaacs' `fitting` (maximality, Isaacs Corollary 1.28(b)) and
conversely Isaacs' `fitting` is normal and nilpotent, so it is the greatest member of the
indexing family (and the `normalCore` wrapper is the identity there). -/
theorem fitting_eq_isaacsFitting_gw {G : Type} [Group G] [Finite G] :
    Work.GW2.fitting G = OddOrder.Isaacs.Ch01.fitting G := by
  have hS : sSup {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}
      = OddOrder.Isaacs.Ch01.fitting G := by
    refine le_antisymm (sSup_le ?_) (le_sSup ?_)
    · rintro N ⟨hN, hnil⟩
      haveI : N.Normal := hN
      haveI : Group.IsNilpotent ↥N := hnil
      exact OddOrder.Isaacs.Ch01.nilpotent_normal_le_fitting
    · exact ⟨OddOrder.Isaacs.Ch01.fitting.normal G,
        OddOrder.Isaacs.Ch01.fitting.isNilpotent⟩
  rw [Work.GW2.fitting, hS]
  exact Subgroup.normalCore_eq_self _

/-- **Isaacs Corollary 1.28(a)**: the Fitting subgroup of a finite group is nilpotent. -/
theorem fitting_isNilpotent_gw {G : Type} [Group G] [Finite G] :
    Group.IsNilpotent ↥(Work.GW2.fitting G) := by
  rw [fitting_eq_isaacsFitting_gw]
  infer_instance

/-! ## 2. The nilpotent splitting `O_π(H) ⊔ O_{π'}(H) = ⊤` -/

/-- **A finite nilpotent group is generated by `O_π` and `O_{π'}`.**

A finite nilpotent group `H` is the join of its (unique, hence normal) Sylow subgroups
(`iSup_default_sylow_eq_top_of_nilpotent`); the Sylow `q`-subgroup of `H` has only the prime `q`
among the prime divisors of its order, so it is a normal `π`-subgroup of `H` — and therefore
lies in `O_π(H)` — if `q ∈ π`, and a normal `πᶜ`-subgroup, lying in `O_{πᶜ}(H)`, otherwise. -/
theorem piCore_sup_compl_eq_top_of_isNilpotent {H : Type} [Group H] [Finite H]
    [Group.IsNilpotent H] (π : Set ℕ) :
    Work.GW2.piCore π H ⊔ Work.GW2.piCore πᶜ H = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← OddOrder.Isaacs.Ch01.iSup_default_sylow_eq_top_of_nilpotent H]
  refine iSup_le ?_
  rintro ⟨p, hp⟩
  have hpP : p.Prime := Nat.prime_of_mem_primeFactors hp
  haveI : Fact p.Prime := ⟨hpP⟩
  -- the Sylow `p`-subgroup is normal (nilpotency) and a `p`-group
  haveI hQn : ((default : Sylow p H) : Subgroup H).Normal :=
    OddOrder.Isaacs.Ch01.Sylow.normal_of_isNilpotent (default : Sylow p H)
  have hQg : IsPGroup p ↥((default : Sylow p H) : Subgroup H) :=
    (default : Sylow p H).isPGroup'
  by_cases hpπ : p ∈ π
  · exact (le_piCore_of_normal_isPiSubgroup_gw (G := H) (π := π)
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem hQg hpπ)).trans le_sup_left
  · exact (le_piCore_of_normal_isPiSubgroup_gw (G := H) (π := πᶜ)
      (Subgroup.isPiSubgroup_of_isPGroup_of_mem hQg (by simpa using hpπ))).trans le_sup_right

/-! ## 3. `F(M) = F_π(M) ⊔ F_{π'}(M)` -/

/-- **Bender 1981, Lemma 2.7**: the Fitting subgroup of `M` is generated by its `π`-part and its
`π'`-part, `F(M) = F_π(M) · F_{π'}(M)`.

`F(M)` is nilpotent, so section 2 gives `O_π(F(M)) ⊔ O_{π'}(F(M)) = ⊤` inside the group `↥F(M)`;
mapping along the inclusion `↥F(M) ↪ ↥M` (`Subgroup.map_sup`, `Subgroup.map_top`) yields the
identity inside `↥M`, and mapping once more along `M.subtype` gives the stated subgroups of `G`.
No primality hypothesis on `π` is used. -/
theorem L27_fittingPi_sup_compl :
    ∀ (G : Type) [Group G] [Finite G] (π : Set ℕ), (∀ q ∈ π, q.Prime) →
      ∀ M : Subgroup G,
        Work.GW2.fittingPiIn π M ⊔ Work.GW2.fittingPiIn (πᶜ) M = Work.GW2.fittingIn M := by
  intro G _ _ π _ M
  haveI : Group.IsNilpotent ↥(Work.GW2.fitting ↥M) := fitting_isNilpotent_gw
  -- the identity inside the group `↥M`
  have key : Work.GW2.fittingPi π ↥M ⊔ Work.GW2.fittingPi πᶜ ↥M = Work.GW2.fitting ↥M := by
    unfold Work.GW2.fittingPi
    rw [← Subgroup.map_sup,
      piCore_sup_compl_eq_top_of_isNilpotent (H := ↥(Work.GW2.fitting ↥M)) π,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  unfold Work.GW2.fittingPiIn Work.GW2.fittingIn
  rw [← Subgroup.map_sup, key]

end Work.CORE2B
