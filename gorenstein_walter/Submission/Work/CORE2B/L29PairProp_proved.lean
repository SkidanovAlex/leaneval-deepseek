import Mathlib
import Submission.Work.CORE2B.L29Parts
import Submission.Work.CORE2B.L29CallSite
import Submission.Work.CORE2B.API

namespace Work.CORE2B

-- Leaf P1 of the lead's design pass 15 (Lemma 2.9): Bender 1.1(iii) contrapositive — a four-group
-- `V` acting faithfully on an odd-order `A` has `u, v ∈ V` nontrivial with `[⟨v⟩, A ⊓ C_A(u)] ≠ 1`.
-- Route: otherwise every `C_A(u)` (`u ∈ V`, `u ≠ 1`) is centralized by all of `V` (`u` itself
-- trivially), and `A = ⨆_{u ∈ V#, u ≠ 1} C_A(u)` (`T.c11iii` with `p = 2`, `P = V`), so
-- `V ≤ C_G(A)`, contradicting faithfulness.
theorem L29PairProp_proved : Work.CORE2B.C15.L29PairProp := by
  -- Unfold the contract: `h11iii` is the coprime-action input, `A` the odd-order group,
  -- `V` the four-group acting on it, `hfaith` the faithfulness hypothesis.
  intro h11iii G _ _ A V hodd hnorm hfour hfaith
  -- Assume no witness pair exists.
  by_contra hcon
  push Not at hcon
  -- `hcon : ∀ u ∈ V, ∀ v ∈ V, u ≠ 1 → v ≠ 1 → ⁅zpowers v, A ⊓ C_A(u)⁆ = ⊥`.
  -- `V` is a 2-group (every element squares to `1`).
  have hP : IsPGroup 2 V := by
    intro g
    refine ⟨1, ?_⟩
    have h1 : (g : ↥V) ^ 2 = 1 := by
      apply Subtype.ext
      simpa [Subgroup.coe_pow] using hfour.2 g.val g.2
    simpa using h1
  -- `V` is commutative: a group of exponent `2` is abelian.
  have hsqV : ∀ x : ↥V, x * x = 1 := by
    intro x
    apply Subtype.ext
    simpa [pow_two] using hfour.2 x.val x.2
  have hcomm : IsMulCommutative V := by
    refine IsMulCommutative.of_comm fun a b => ?_
    have hab : (a * b) * (a * b) = 1 := hsqV (a * b)
    calc a * b = ((a * b) * (a * b)) * (a * b) := by rw [hab, one_mul]
      _ = (a * b)⁻¹ := by rw [hab, one_mul, inv_eq_of_mul_eq_one_right hab]
      _ = b⁻¹ * a⁻¹ := mul_inv_rev a b
      _ = b * a := by
          rw [inv_eq_of_mul_eq_one_right (hsqV a), inv_eq_of_mul_eq_one_right (hsqV b)]
  -- Bender 1.1(iii) with `p = 2`, `P = E = V`, `K = A`: `A` is generated by the `C_A(u)`, `u ∈ V#`.
  have hcard : Nat.card ↥V = 2 ^ 2 := by rw [hfour.1]; norm_num
  have hA := h11iii G 2 V A V hP (Nat.coprime_two_left.mpr hodd) hnorm (le_refl V) hcard
    hfour.2 hcomm
  -- Each `C_A(u)` is centralized by every `v ∈ V#`; hence so is `A`.
  have hcent : ∀ v ∈ V, v ≠ 1 → A ≤ Subgroup.centralizer ({v} : Set G) := by
    intro v hv hv1
    rw [hA]
    refine iSup_le fun a => iSup_le fun ha => iSup_le fun ha1 => ?_
    -- `[⟨v⟩, C_A(a)] = 1` from the negation hypothesis.
    have h1 : (A ⊓ Subgroup.centralizer ({a} : Set G)) ≤
        Subgroup.centralizer (Subgroup.zpowers v) := by
      rw [← Subgroup.commutator_eq_bot_iff_le_centralizer, Subgroup.commutator_comm]
      exact hcon a ha v hv ha1 hv1
    rwa [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure] at h1
  -- Some `v ∈ V` is nontrivial, and `hfaith` forbids it from centralizing `A`.
  have hVne : V ≠ ⊥ := by
    intro h
    have hc : Nat.card ↥V = 1 := by rw [h]; exact Subgroup.card_bot
    omega
  obtain ⟨v, hv, hv1⟩ : ∃ v ∈ V, v ≠ 1 := by
    by_contra h
    push Not at h
    exact hVne ((Subgroup.eq_bot_iff_forall V).mpr h)
  exact hfaith v hv hv1 (hcent v hv hv1)

end Work.CORE2B
