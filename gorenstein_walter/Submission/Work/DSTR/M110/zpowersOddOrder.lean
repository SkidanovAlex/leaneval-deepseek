import Mathlib

namespace Work.DSTR.M110

/-- In a finite group, an element of odd order lying in `Subgroup.zpowers g` lies in the
subgroup generated by the coprime-to-`2` part `g ^ 2 ^ (v_2 (orderOf g))` of `g`. -/
theorem zpowersOddOrder {G : Type*} [Group G] [Finite G] (g x : G)
    (hx : x ∈ Subgroup.zpowers g) (hodd : Odd (orderOf x)) :
    x ∈ Subgroup.zpowers (g ^ 2 ^ ((orderOf g).factorization 2)) := by
  -- write `x = g ^ j`
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp hx
  -- `orderOf g` is nonzero
  have hn_ne : orderOf g ≠ 0 := (orderOf_pos g).ne'
  -- `orderOf (g ^ j) = orderOf g / gcd (orderOf g) |j|`, and `g ^ j = x`
  have horder : orderOf x = orderOf g / (orderOf g).gcd j.natAbs := by
    rw [← hj]; exact orderOf_zpow g j
  -- so the quotient `orderOf g / gcd (orderOf g) |j|` is odd
  have hodd_d : Odd (orderOf g / (orderOf g).gcd j.natAbs) := by
    rw [← horder]; exact hodd
  -- hence it is coprime to `2`, and so coprime to `2 ^ v_2 (orderOf g)`
  have hcop : Nat.Coprime (2 ^ (orderOf g).factorization 2)
      (orderOf g / (orderOf g).gcd j.natAbs) :=
    (Nat.coprime_two_left.mpr hodd_d).pow_left _
  -- `2 ^ v_2 (orderOf g)` divides `orderOf g = gcd * (orderOf g / gcd)`
  have h2k_dvd_n : 2 ^ (orderOf g).factorization 2 ∣ orderOf g :=
    (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_two hn_ne).mpr le_rfl
  have hsplit : (orderOf g).gcd j.natAbs * (orderOf g / (orderOf g).gcd j.natAbs)
      = orderOf g := Nat.mul_div_cancel' (Nat.gcd_dvd_left _ _)
  -- Euclid: since the other factor is coprime, `2 ^ v_2 (orderOf g)` divides the gcd
  have h2k_dvd_d : 2 ^ (orderOf g).factorization 2 ∣ (orderOf g).gcd j.natAbs :=
    hcop.dvd_of_dvd_mul_right (by rw [hsplit]; exact h2k_dvd_n)
  -- the gcd divides `|j|`, hence `2 ^ v_2 (orderOf g)` divides `|j|` and `j`
  have h2k_dvd_j : (((2 ^ (orderOf g).factorization 2 : ℕ)) : ℤ) ∣ j :=
    dvd_trans (Nat.cast_dvd_cast (dvd_trans h2k_dvd_d (Nat.gcd_dvd_right _ _)))
      Int.natAbs_dvd_self
  -- conclude: `x = g ^ j = (g ^ 2 ^ v_2 (orderOf g)) ^ t`
  obtain ⟨t, ht⟩ := h2k_dvd_j
  refine Subgroup.mem_zpowers_iff.mpr ⟨t, ?_⟩
  rw [← hj, ht, ← zpow_natCast g (2 ^ (orderOf g).factorization 2), ← zpow_mul]

end Work.DSTR.M110
