/-
The matrix representative `B` of an involution of `PGL(2,F)` with `B * B = c • 1` commutes with
every element of the non-split torus `torusGL B c hB`.

Math: `torusAlgHom B c hB` sends the root `X` of `F[X]/(X²-c)` to `B` and scalars to scalar
matrices. The preimage of the centralizer of `B` under this map is a subalgebra of `F[X]/(X²-c)`
containing the root, hence (as `F[X]/(X²-c)` is generated by its root, `AdjoinRoot.adjoinRoot_eq_top`)
it is everything. So the image of `torusAlgHom` commutes with `B`.
-/
import Mathlib
import Submission.Work.DSTR.M110.nonsplitAux

open Polynomial

namespace Work.DSTR.M110

section Torus

variable {F : Type*} [Field F] [DecidableEq F]

/-- `torusAlgHom B c hB`, regarded as an `F`-algebra homomorphism. -/
noncomputable def torusAlgHomA (B : GL (Fin 2) F) (c : F)
    (hB : (B : Matrix (Fin 2) (Fin 2) F) * B = c • 1) :
    AdjoinRoot (X ^ 2 - C c : F[X]) →ₐ[F] Matrix (Fin 2) (Fin 2) F where
  toRingHom := torusAlgHom B c hB
  commutes' := fun a => by
    simpa [Algebra.algebraMap_eq_smul_one] using
      torusAlgHom_of (B := B) (c := c) (hB := hB) a

@[simp] lemma torusAlgHomA_apply (B : GL (Fin 2) F) (c : F)
    (hB : (B : Matrix (Fin 2) (Fin 2) F) * B = c • 1)
    (x : AdjoinRoot (X ^ 2 - C c : F[X])) :
    torusAlgHomA B c hB x = torusAlgHom B c hB x := rfl

/-- The image of `torusAlgHom B c hB` lies in the centralizer of `B`. -/
lemma torusAlgHom_commute (B : GL (Fin 2) F) (c : F)
    (hB : (B : Matrix (Fin 2) (Fin 2) F) * B = c • 1)
    (x : AdjoinRoot (X ^ 2 - C c : F[X])) :
    torusAlgHom B c hB x * (B : Matrix (Fin 2) (Fin 2) F)
      = (B : Matrix (Fin 2) (Fin 2) F) * torusAlgHom B c hB x := by
  have htop : (⊤ : Subalgebra F (AdjoinRoot (X ^ 2 - C c : F[X])))
      ≤ Subalgebra.comap (torusAlgHomA B c hB) (Subalgebra.centralizer F
          ({(B : Matrix (Fin 2) (Fin 2) F)} : Set (Matrix (Fin 2) (Fin 2) F))) := by
    rw [← AdjoinRoot.adjoinRoot_eq_top (R := F) (f := (X ^ 2 - C c : F[X]))]
    refine Algebra.adjoin_le_iff.mpr ?_
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    show torusAlgHom B c hB (AdjoinRoot.root _) ∈ Subalgebra.centralizer F _
    rw [Subalgebra.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    rw [show torusAlgHom B c hB (AdjoinRoot.root _) = (B : Matrix (Fin 2) (Fin 2) F) from
      torusAlgHom_root B c hB]
  have hx : x ∈ Subalgebra.comap (torusAlgHomA B c hB) (Subalgebra.centralizer F
      ({(B : Matrix (Fin 2) (Fin 2) F)} : Set (Matrix (Fin 2) (Fin 2) F))) :=
    htop (Subsemiring.mem_top x)
  simp only [Subalgebra.mem_comap, Subalgebra.mem_centralizer_iff, Set.mem_singleton_iff,
    forall_eq, torusAlgHomA_apply] at hx
  exact hx.symm

end Torus

theorem torusGLCommute (F : Type*) [Field F] [DecidableEq F] (B : Matrix.GeneralLinearGroup (Fin 2) F)
    (c : F) (hB : (B : Matrix (Fin 2) (Fin 2) F) * B = c • 1)
    (u : (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C c : Polynomial F))ˣ) :
    Work.DSTR.M110.torusGL B c hB u * B = B * Work.DSTR.M110.torusGL B c hB u := by
  refine Units.ext ?_
  rw [Matrix.GeneralLinearGroup.coe_mul, Matrix.GeneralLinearGroup.coe_mul]
  have hcoe : ((torusGL B c hB u : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F)
      = torusAlgHom B c hB (u : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C c : Polynomial F)) := by
    rw [torusGL, Units.coe_map]
    rfl
  rw [hcoe]
  exact torusAlgHom_commute B c hB (u : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C c : Polynomial F))

end Work.DSTR.M110
