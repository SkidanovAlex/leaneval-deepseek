import Mathlib
import Submission.Work.DSTR.M110.frobeniusRingAut

/-!
# An odd-order automorphism fixing the fixed field of an involution is trivial

Let `F = GF(p^k)`.  If `σ` is a ring automorphism of `F` of order `2` and `τ` is a ring
automorphism of `F` of odd order which fixes every element fixed by `σ`, then `τ = 1`.

The proof is Artin's theorem on fixed fields, with no use of the structure of `Aut(F)`:
the subgroups `G = ⟨σ⟩` and `H = ⟨σ, τ⟩` of `Aut(F)` have the *same* fixed field, because
on the one hand `G ≤ H`, and on the other hand any `x` fixed by `σ` is fixed by `τ`
(hypothesis) hence by all of `H = ⟨σ, τ⟩`.  By `FixedPoints.finrank_eq_card`,
`[F : F^G] = |G| = orderOf σ = 2` and `[F : F^H] = |H|`; the fixed fields being equal,
`|H| = 2`.  Hence `τ ∈ H` satisfies `τ ^ 2 = 1`, i.e. `orderOf τ ∣ 2`, which together with
`Odd (orderOf τ)` forces `τ = 1`.
-/

open MulAction

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.DSTR.M110.twistAux

theorem twistAuxEqOneOfFixesFixedField (p k : ℕ) [Fact p.Prime] (hk : k ≠ 0)
    (σ τ : GaloisField p k ≃+* GaloisField p k) (hσ : orderOf σ = 2) (hτ : Odd (orderOf τ))
    (hfix : ∀ a : GaloisField p k, σ a = a → τ a = a) : τ = 1 := by
  classical
  -- `Aut(GF(p^k))` is finite because `GF(p^k)` is finite.
  haveI : Finite (GaloisField p k ≃+* GaloisField p k) :=
    Finite.of_injective (fun f : GaloisField p k ≃+* GaloisField p k =>
        (f : GaloisField p k → GaloisField p k))
      (fun f g h => RingEquiv.ext (fun x => congrFun h x))
  -- The subgroup generated by `σ` and the subgroup generated by `σ` and `τ`.
  let G : Subgroup (GaloisField p k ≃+* GaloisField p k) := Subgroup.zpowers σ
  let H : Subgroup (GaloisField p k ≃+* GaloisField p k) := Subgroup.closure ({σ, τ} : Set _)
  haveI : Fintype G := Fintype.ofFinite G
  haveI : Fintype H := Fintype.ofFinite H
  -- The tautological action of a group of ring automorphisms on the field is faithful.
  haveI : FaithfulSMul G (GaloisField p k) :=
    ⟨fun {g₁ g₂} h => Subtype.ext (RingEquiv.ext (fun x => h x))⟩
  haveI : FaithfulSMul H (GaloisField p k) :=
    ⟨fun {g₁ g₂} h => Subtype.ext (RingEquiv.ext (fun x => h x))⟩
  have hGH : G ≤ H := Subgroup.zpowers_le.mpr (Subgroup.subset_closure (by simp))
  -- `G` and `H` have the same fixed field.
  have hsub : FixedPoints.subfield H (GaloisField p k) =
      FixedPoints.subfield G (GaloisField p k) := by
    apply Subfield.ext
    intro x
    have memH : (x ∈ FixedPoints.subfield H (GaloisField p k)) ↔ (∀ h : H, h • x = x) :=
      MulAction.mem_fixedPoints
    have memG : (x ∈ FixedPoints.subfield G (GaloisField p k)) ↔ (∀ g : G, g • x = x) :=
      MulAction.mem_fixedPoints
    rw [memH, memG]
    constructor
    · intro hx g
      exact hx ⟨g.1, hGH g.2⟩
    · intro hx h
      -- `x` is fixed by `σ` (as `G = ⟨σ⟩`) and hence, by hypothesis, by `τ`.
      have hσx : σ x = x := hx ⟨σ, Subgroup.mem_zpowers σ⟩
      have hτx : τ x = x := hfix x hσx
      -- so `x` is fixed by the subgroup generated by `σ` and `τ`.
      have hle : Subgroup.closure ({σ, τ} : Set (GaloisField p k ≃+* GaloisField p k)) ≤
          MulAction.stabilizer (GaloisField p k ≃+* GaloisField p k) x :=
        (Subgroup.closure_le _).mpr (by
          rintro a (rfl | rfl)
          · exact hσx
          · exact hτx)
      exact hle h.2
  -- Artin: `[F : F^G] = |G|` and `[F : F^H] = |H|`.
  have hfrG : Module.finrank ↥(FixedPoints.subfield G (GaloisField p k)) (GaloisField p k) =
      Fintype.card G := FixedPoints.finrank_eq_card G (GaloisField p k)
  have hfrH : Module.finrank ↥(FixedPoints.subfield H (GaloisField p k)) (GaloisField p k) =
      Fintype.card H := FixedPoints.finrank_eq_card H (GaloisField p k)
  have hcardG : Fintype.card G = 2 := by
    rw [← Nat.card_eq_fintype_card, Nat.card_zpowers, hσ]
  have hcardH : Fintype.card H = 2 := by
    rw [← hfrH, congrArg (fun S : Subfield (GaloisField p k) =>
      Module.finrank ↥S (GaloisField p k)) hsub, hfrG, hcardG]
  -- `τ ∈ H` of order dividing `|H| = 2`; odd order forces `τ = 1`.
  have hτH : τ ∈ H := Subgroup.subset_closure (by simp)
  have hpow : (⟨τ, hτH⟩ : H) ^ 2 = 1 := by
    rw [← hcardH]
    exact pow_card_eq_one
  have hτ2 : τ ^ 2 = 1 := by
    have := congrArg (Subtype.val) hpow
    simpa using this
  have hdvd : orderOf τ ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hτ2
  have hone : orderOf τ = 1 := by
    rcases (Nat.dvd_prime (by norm_num : Nat.Prime 2)).mp hdvd with h | h
    · exact h
    · rcases hτ with ⟨m, hm⟩; omega
  rwa [orderOf_eq_one_iff] at hone

end Work.DSTR.M110.twistAux
