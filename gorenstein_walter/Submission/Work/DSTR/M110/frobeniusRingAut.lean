import Mathlib

namespace Work.DSTR.M110

/-- A ring automorphism of a field fixes the prime subfield, so the group of ring
automorphisms is the same group as the `𝔽_p`-algebra automorphism group (`Galois group`)
of the field over `ZMod p`, with the same underlying functions. -/
noncomputable def ringAutMulEquivAlgAut (p : ℕ) [Fact p.Prime] (F : Type*) [Field F]
    [Algebra (ZMod p) F] : RingAut F ≃* (F ≃ₐ[ZMod p] F) where
  toFun f := AlgEquiv.ofRingEquiv (f := f) fun x => by
    obtain ⟨n, rfl⟩ := ZMod.intCast_surjective x
    simp
  invFun g := g.toRingEquiv
  left_inv f := by ext x; rfl
  right_inv g := by ext x; rfl
  map_mul' f g := by ext x; rfl

@[simp] theorem ringAutMulEquivAlgAut_apply (p : ℕ) [Fact p.Prime] (F : Type*) [Field F]
    [Algebra (ZMod p) F] (f : RingAut F) (x : F) :
    ringAutMulEquivAlgAut p F f x = f x := rfl

/-- The Frobenius `𝔽_p`-algebra automorphism of `GaloisField p k` is `x ↦ x ^ p`, and its
`n`-th power is `x ↦ x ^ (p ^ n)`. -/
theorem frobeniusAlgEquiv_pow_apply (p k n : ℕ) [Fact p.Prime] (x : GaloisField p k) :
    ((FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod p) (GaloisField p k)) ^ n) x =
      x ^ (p ^ n) := by
  rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
  simp [ZMod.card]

/-- The Frobenius automorphism of `GaloisField p k` has order `k` (for `k ≠ 0`). -/
theorem orderOf_frobeniusAlgEquiv (p k : ℕ) [Fact p.Prime] (hk : k ≠ 0) :
    orderOf (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod p) (GaloisField p k)) = k := by
  rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, GaloisField.finrank p hk]

/-- **The automorphism group of `GF(p^k)` is cyclic, generated by Frobenius.**

Every ring automorphism `φ` of `GaloisField p k` is a power of the Frobenius `x ↦ x ^ p`:
there is `i < k` with `φ x = x ^ (p ^ i)` for all `x`, and the order of `φ` is
`k / gcd i k`. -/
theorem frobeniusRingAut (p k : ℕ) [Fact p.Prime] (hk : 1 ≤ k)
    (φ : GaloisField p k ≃+* GaloisField p k) :
    ∃ i : ℕ, i < k ∧ (∀ x : GaloisField p k, φ x = x ^ (p ^ i)) ∧
      orderOf φ = k / Nat.gcd i k := by
  classical
  have hk' : k ≠ 0 := by omega
  have hfr : Module.finrank (ZMod p) (GaloisField p k) = k := GaloisField.finrank p hk'
  let σ := FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod p) (GaloisField p k)
  have hσorder : orderOf σ = k := by
    rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, hfr]
  have hbij : Function.Bijective
      (fun m : Fin (Module.finrank (ZMod p) (GaloisField p k)) => σ ^ (m : ℕ)) :=
    FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod p) (GaloisField p k)
  let e := ringAutMulEquivAlgAut p (GaloisField p k)
  obtain ⟨n, hn⟩ := hbij.2 (e φ)
  have hn' : σ ^ (n : ℕ) = e φ := hn
  have hφ : φ = (e.symm σ) ^ (n : ℕ) := by
    apply e.injective
    rw [map_pow, MulEquiv.apply_symm_apply]
    exact hn'.symm
  refine ⟨n.1, ?_, ?_, ?_⟩
  · have h2 : (n : ℕ) < Module.finrank (ZMod p) (GaloisField p k) := n.2
    omega
  · intro x
    rw [hφ]
    have h1 : ((e.symm σ) ^ (n : ℕ)) x = (σ ^ (n : ℕ)) x := by
      have heq : e ((e.symm σ) ^ (n : ℕ)) = σ ^ (n : ℕ) := by
        rw [map_pow, MulEquiv.apply_symm_apply]
      calc ((e.symm σ) ^ (n : ℕ)) x = e ((e.symm σ) ^ (n : ℕ)) x := rfl
        _ = (σ ^ (n : ℕ)) x := by rw [heq]
    rw [h1, AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
    simp [ZMod.card]
  · rw [hφ]
    have hkpow : σ ^ k = 1 := by
      have h := pow_orderOf_eq_one σ
      rwa [hσorder] at h
    have hfin : IsOfFinOrder (e.symm σ) := by
      rw [isOfFinOrder_iff_pow_eq_one]
      refine ⟨k, hk, ?_⟩
      apply e.injective
      rw [map_pow, MulEquiv.apply_symm_apply, map_one, hkpow]
    rw [hfin.orderOf_pow]
    have horder : orderOf (e.symm σ) = k := by
      have h := orderOf_injective (e.symm.toMonoidHom) e.symm.injective σ
      rw [hσorder] at h
      exact h
    rw [horder, Nat.gcd_comm]

end Work.DSTR.M110
