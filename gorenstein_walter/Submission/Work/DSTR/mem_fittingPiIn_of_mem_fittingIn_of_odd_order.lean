import Mathlib
import Submission.Work.DSTR.Defs
import Submission.Work.DSTR.M110.PiCoreFacts
import Submission.Work.DSTR.map_fittingPiIn_le
import Submission.OddOrder.GroupTheory.SubgroupInAmbient

/-!
# Elements of odd order in `F(K)` lie in `F_{2'}(K)`

The converse of `Work.DSTR.M110.oddOrderOf_mem_fittingPiIn`: an element of the Fitting subgroup
`F(K)` of a subgroup `K ≤ G` whose order is odd belongs to the `2'`-part
`F_{2'}(K) = O_{2'}(F(K))`.

The mathematical content is the structure theory of finite nilpotent groups:

* in a finite nilpotent group `H` every subgroup is **subnormal** (Isaacs Lemma 2.1,
  `OddOrder.Isaacs.Ch02.isSubnormal_of_isNilpotent_finite`), and a subnormal `π`-subgroup of a
  finite group lies in `O_π` (`OddOrder.GroupTheory.le_oPiCore_of_isSubnormal`); hence *every*
  `π`-subgroup of a finite nilpotent group lies in `O_π`
  (`le_piCore_of_isPiSubgroup_of_isNilpotent`);
* the cyclic subgroup generated by an element of odd order is a `{q | q ≠ 2}`-subgroup, so an
  odd-order element of a finite nilpotent group lies in `O_{2'}`
  (`mem_piCore_of_odd_order_of_isNilpotent`);
* applying this inside the nilpotent group `F(↥K)` (nilpotent by
  `FittingPiImg.fitting_eq_isaacsFitting` + `OddOrder.Isaacs.Ch01.fitting.isNilpotent`) and
  transporting back along the inclusions `↥(F(↥K)) ↪ ↥K ↪ G` gives the stated result for
  `F(K) ≤ G`.
-/

set_option linter.style.haveILetI false

namespace Work.DSTR

open Subgroup

/-- **Every `π`-subgroup of a finite nilpotent group lies in `O_π`.**

In a finite nilpotent group every subgroup is subnormal
(`OddOrder.Isaacs.Ch02.isSubnormal_of_isNilpotent_finite`, Isaacs Lemma 2.1), and a subnormal
`π`-subgroup lies in `O_π` (`OddOrder.GroupTheory.le_oPiCore_of_isSubnormal`). -/
theorem le_piCore_of_isPiSubgroup_of_isNilpotent {H : Type*} [Group H] [Finite H]
    [Group.IsNilpotent H] (π : Set ℕ) {N : Subgroup H} (hN : Subgroup.IsPiSubgroup π N) :
    N ≤ Work.GW2.piCore π H := by
  rw [Work.GW2.piCore_eq_oPiCore]
  exact OddOrder.GroupTheory.le_oPiCore_of_isSubnormal
    (OddOrder.Isaacs.Ch02.isSubnormal_of_isNilpotent_finite N) hN

/-- **Elements of odd order in a finite nilpotent group lie in `O_{2'}`.**

The cyclic subgroup `⟨y⟩` has order `orderOf y` (`Nat.card_zpowers`), which is odd, so `⟨y⟩` is a
`{q | q ≠ 2}`-subgroup and hence lies in `O_{2'}` by
`le_piCore_of_isPiSubgroup_of_isNilpotent`. -/
theorem mem_piCore_of_odd_order_of_isNilpotent {H : Type*} [Group H] [Finite H]
    [Group.IsNilpotent H] {y : H} (hodd : Odd (orderOf y)) :
    y ∈ Work.GW2.piCore ({k : ℕ | k ≠ 2} : Set ℕ) H := by
  refine le_piCore_of_isPiSubgroup_of_isNilpotent ({k : ℕ | k ≠ 2} : Set ℕ)
    (N := Subgroup.zpowers y) ?_ (Subgroup.mem_zpowers y)
  intro p hp
  simp only [Set.mem_ofPred_eq]
  intro hp2
  rw [Nat.card_zpowers, hp2] at hp
  exact (Nat.not_even_iff_odd.mpr hodd)
    (even_iff_two_dvd.mpr (Nat.mem_primeFactors.mp hp).2.1)

/-- In the nilpotent group `F(K)`, an element of odd order lies in `O_{2'}`: if `x ∈ F(K)` has odd
order then `x ∈ F_{2'}(K) = O_{2'}(F(K))`.  (Converse of `Work.DSTR.M110.oddOrderOf_mem_fittingPiIn`.) -/
theorem mem_fittingPiIn_of_mem_fittingIn_of_odd_order {G : Type*} [Group G] [Finite G]
    (K : Subgroup G) {x : G}
    (hx : x ∈ Work.GW2.fittingIn K) (hodd : Odd (orderOf x)) :
    x ∈ Work.GW2.fittingPiIn {k : ℕ | k ≠ 2} K := by
  -- `x ∈ F(K)` is the image of `y ∈ F(↥K)`
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  have hyx' : ((y : ↥K) : G) = x := hyx
  -- `F(↥K)` is a finite nilpotent group
  haveI : Finite ↥(Work.GW2.fitting ↥K) := inferInstance
  haveI hnil : Group.IsNilpotent ↥(Work.GW2.fitting ↥K) := by
    rw [FittingPiImg.fitting_eq_isaacsFitting (G := ↥K)]
    exact OddOrder.Isaacs.Ch01.fitting.isNilpotent
  -- the order of `y` is the order of `x`
  have hoddY : Odd (orderOf y) := by
    have h : orderOf y = orderOf x := by
      rw [← Subgroup.orderOf_coe (H := K) y, hyx']
    rw [h]
    exact hodd
  -- so `y ∈ O_{2'}(F(↥K))`, inside the nilpotent group `F(↥K)`
  have hoddZ : Odd (orderOf (⟨y, hy⟩ : ↥(Work.GW2.fitting ↥K))) := by
    rw [← Subgroup.orderOf_coe (H := Work.GW2.fitting ↥K)
      (⟨y, hy⟩ : ↥(Work.GW2.fitting ↥K))]
    exact hoddY
  have hz : (⟨y, hy⟩ : ↥(Work.GW2.fitting ↥K)) ∈
      Work.GW2.piCore ({k : ℕ | k ≠ 2} : Set ℕ) ↥(Work.GW2.fitting ↥K) :=
    mem_piCore_of_odd_order_of_isNilpotent hoddZ
  -- transport along the two inclusions `↥(F(↥K)) ↪ ↥K ↪ G`
  rw [Work.GW2.fittingPiIn, Work.GW2.fittingPi]
  exact Subgroup.mem_map.mpr
    ⟨y, Subgroup.mem_map.mpr ⟨⟨y, hy⟩, hz, rfl⟩, hyx'⟩

end Work.DSTR
