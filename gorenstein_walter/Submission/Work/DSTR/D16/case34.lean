/-! ## Local vocabulary

`Q = X/O(X)` and `C = C_X(F_{2'}(X))`. -/

/-- `Q = X/O(X)`. -/
abbrev QX (X : Type) [Group X] : Type := X ⧸ Work.GW2.oddCore X

/-- The quotient map `X → X/O(X)`. -/
abbrev piX (X : Type) [Group X] : X →* QX X := QuotientGroup.mk' (Work.GW2.oddCore X)

/-- `C_X(F_{2'}(X))`. -/
abbrev CF2 (X : Type) [Group X] : Subgroup X :=
  Subgroup.centralizer ((Work.DSTR.F2p X : Subgroup X) : Set X)

theorem piX_surjective (X : Type) [Group X] : Function.Surjective (piX X) :=
  QuotientGroup.mk'_surjective _

theorem case34_card_QX_le (X : Type) [Group X] [Finite X] : Nat.card (QX X) ≤ Nat.card X :=
  Nat.card_le_card_of_surjective (piX X) (piX_surjective X)

instance F2p_normal (X : Type) [Group X] : (Work.DSTR.F2p X).Normal := by
  haveI hFK : (Work.GW2.fitting X).Normal := Subgroup.normalCore_normal _
  haveI hchar : (Work.GW2.piCore ({2}ᶜ : Set ℕ) ↥(Work.GW2.fitting X)).Characteristic :=
    FittingPiImg.piCore_characteristic _
  exact ConjAct.normal_of_characteristic_of_normal

instance CF2_normal (X : Type) [Group X] : (CF2 X).Normal := by
  haveI : (Work.DSTR.F2p X).Normal := F2p_normal X
  exact inferInstance

/-! ## Elementary group-theoretic helpers -/

/-- A normal subgroup of order `2` is central: it is generated by its non-identity element `x`,
and `g * x * g⁻¹` is again of order `2`, hence equal to `x`. -/
theorem case34_le_center_of_card_eq_two (G : Type) [Group G] {N : Subgroup G} [N.Normal]
    (h : Nat.card N = 2) : N ≤ Subgroup.center G := by
  classical
  haveI : Finite ↥N := (Nat.card_pos_iff.mp (by rw [h]; norm_num)).2
  intro x hx
  rw [Subgroup.mem_center_iff]
  intro y
  by_cases hx1 : x = 1
  · rw [hx1, one_mul, mul_one]
  · have hxord : orderOf x = 2 := by
      have hdvd : orderOf x ∣ 2 := by
        rw [← h]; exact Subgroup.orderOf_dvd_natCard N hx
      rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h1
      · exact absurd (orderOf_eq_one_iff.mp h1) hx1
      · exact h1
    have hx2 : x ^ 2 = 1 := by rw [← hxord]; exact pow_orderOf_eq_one x
    have hfin : IsOfFinOrder x := isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, hx2⟩
    have hN : N = Subgroup.zpowers x := by
      refine (Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers x) (K := N)
        (Subgroup.zpowers_le.mpr hx) ?_).symm
      rw [Nat.card_zpowers, hxord, h]
    have hconj : y * x * y⁻¹ ∈ N := ‹N.Normal›.conj_mem x hx y
    have hz : y * x * y⁻¹ ∈ Subgroup.zpowers x := hN ▸ hconj
    have hz' : y * x * y⁻¹ ∈ (Finset.range (orderOf x)).image (x ^ ·) := by
      rw [← IsOfFinOrder.mem_zpowers_iff_mem_range_orderOf hfin]
      exact hz
    obtain ⟨i, hi, hix⟩ := Finset.mem_image.mp hz'
    rw [Finset.mem_range, hxord] at hi
    have hyx : y * x * y⁻¹ = x := by
      interval_cases i
      · simp only [pow_zero] at hix
        exact absurd (by
          calc x = y⁻¹ * (y * x * y⁻¹) * y := by group
            _ = y⁻¹ * 1 * y := by rw [← hix]
            _ = 1 := by group) hx1
      · simpa using hix.symm
    calc y * x = (y * x * y⁻¹) * y := by group
      _ = x * y := by rw [hyx]

/-- Lifting an involution of `Z(X/O(X))` lying in the image of `O_2(X)` to a central involution of
`X`. -/
theorem case34_central_involution_of_map (X : Type) [Group X] [Finite X] {w : QX X}
    (hw : w ∈ (Work.GW2.pCore 2 X).map (piX X))
    (hwZ : w ∈ Subgroup.center (QX X)) (hworder : orderOf w = 2) :
    ∃ z : X, z ∈ Subgroup.center X ∧ orderOf z = 2 := by
  obtain ⟨a, ha, haw⟩ := Subgroup.mem_map.mp hw
  have hwne : w ≠ 1 := by rintro rfl; simp at hworder
  have hane : a ≠ 1 := fun hh => hwne (by rw [← haw, hh]; rfl)
  have hw2 : w ^ 2 = 1 := by rw [← hworder]; exact pow_orderOf_eq_one w
  have ha2O : a ^ 2 ∈ Work.GW2.oddCore X :=
    (QuotientGroup.eq_one_iff (a ^ 2)).mp (by
      calc piX X (a ^ 2) = (piX X a) ^ 2 := map_pow _ a 2
        _ = w ^ 2 := by rw [haw]
        _ = 1 := hw2)
  have ha2 : a ^ 2 = 1 := by
    have hinf : a ^ 2 ∈ Work.GW2.pCore 2 X ⊓ Work.GW2.oddCore X :=
      ⟨Subgroup.pow_mem (Work.GW2.pCore 2 X) ha 2, ha2O⟩
    rw [Work.DSTR.pCore_two_inf_oddCore_eq_bot X] at hinf
    simpa using hinf
  have horder : orderOf a = 2 := by
    have hdvd : orderOf a ∣ 2 := by
      rw [orderOf_dvd_iff_pow_eq_one]; exact ha2
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hane
    · exact h
  refine ⟨a, ?_, horder⟩
  rw [Subgroup.mem_center_iff]
  intro x
  have hxa : x * a * x⁻¹ = a := by
    refine mul_inv_eq_one.mp ?_
    have hcw := Subgroup.mem_center_iff.mp hwZ (piX X x)
    have hO : x * a * x⁻¹ * a⁻¹ ∈ Work.GW2.oddCore X :=
      (QuotientGroup.eq_one_iff _).mp (by
        calc piX X (x * a * x⁻¹ * a⁻¹)
            = ((piX X x) * w * (piX X x)⁻¹) * w⁻¹ := by
              simp only [map_mul, map_inv, haw]
          _ = 1 := by rw [hcw]; group)
    have hAcore : x * a * x⁻¹ * a⁻¹ ∈ Work.GW2.pCore 2 X := by
      haveI : (Work.GW2.pCore 2 X).Normal := inferInstance
      exact mul_mem (‹(Work.GW2.pCore 2 X).Normal›.conj_mem a ha x) (inv_mem ha)
    have hinf : x * a * x⁻¹ * a⁻¹ ∈ Work.GW2.pCore 2 X ⊓ Work.GW2.oddCore X :=
      ⟨hAcore, hO⟩
    rw [Work.DSTR.pCore_two_inf_oddCore_eq_bot X] at hinf
    simpa using hinf
  have hcomm : x * a = a * x := by
    have hh := congrArg (· * x) hxa
    simpa [mul_assoc] using hh
  exact hcomm

/-- For a finite group, the derived series stabilizes by index `Nat.card G`; hence the `m`-th term
is perfect and the quotient by it is solvable. -/
theorem case34_derivedSeries_basic (G : Type) [Group G] [Finite G] (m : ℕ)
    (hm : Nat.card G ≤ m) :
    ⁅derivedSeries G m, derivedSeries G m⁆ = derivedSeries G m ∧
      Group.IsSolvable (G ⧸ derivedSeries G m) := by
  haveI hnormal : (derivedSeries G m).Normal := derivedSeries_normal G m
  constructor
  · have key : derivedSeries G m = derivedSeries G (m + 1) := by
      by_contra hne
      have hstrict : ∀ n, n ≤ m → derivedSeries G (n + 1) < derivedSeries G n := by
        intro n hn
        refine lt_of_le_of_ne (derivedSeries_antitone G (Nat.le_succ n)) ?_
        intro heq
        have hconst : ∀ j, n + 1 ≤ j → derivedSeries G j = derivedSeries G (n + 1) := by
          intro j hj
          induction j, hj using Nat.le_induction with
          | base => rfl
          | succ j hj ih =>
            calc derivedSeries G (j + 1) = ⁅derivedSeries G j, derivedSeries G j⁆ :=
                  derivedSeries_succ G j
              _ = ⁅derivedSeries G (n + 1), derivedSeries G (n + 1)⁆ := by rw [ih]
              _ = ⁅derivedSeries G n, derivedSeries G n⁆ := by rw [← heq]
              _ = derivedSeries G (n + 1) := (derivedSeries_succ G n).symm
        rcases lt_or_eq_of_le hn with hlt | heqnm
        · exact hne ((hconst m (by omega)).trans (hconst (m + 1) (by omega)).symm)
        · exact hne (Eq.symm (heqnm ▸ heq))
      have hcard : ∀ n, n ≤ m → Nat.card (derivedSeries G (n + 1)) < Nat.card (derivedSeries G n) :=
        fun n hn => Subgroup.card_lt_of_lt (hstrict n hn)
      have hiter : ∀ k, k ≤ m + 1 →
          Nat.card (derivedSeries G k) + k ≤ Nat.card (derivedSeries G 0) := by
        intro k
        induction k with
        | zero => intro _; simp
        | succ k ih =>
          intro hk
          have h1 := ih (by omega)
          have h2 := hcard k (by omega)
          omega
      have hpos : 1 ≤ Nat.card (derivedSeries G (m + 1)) :=
        Nat.card_pos_iff.mpr ⟨⟨1, (derivedSeries G (m + 1)).one_mem⟩, inferInstance⟩
      have hfin := hiter (m + 1) le_rfl
      have h0 : Nat.card (derivedSeries G 0) = Nat.card G := by
        rw [derivedSeries_zero G, Subgroup.card_top]
      omega
    calc ⁅derivedSeries G m, derivedSeries G m⁆ = derivedSeries G (m + 1) :=
          (derivedSeries_succ G m).symm
      _ = derivedSeries G m := key.symm
  · refine ⟨⟨m, ?_⟩⟩
    rw [← map_derivedSeries_eq (QuotientGroup.mk'_surjective (derivedSeries G m)) m]
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']

/-- `A₇` is simple, perfect and not a `2`-group. -/
theorem case34_a7_basic :
    IsSimpleGroup (alternatingGroup (Fin 7)) ∧
      Group.IsPerfect (alternatingGroup (Fin 7)) ∧
        ¬ IsPGroup 2 (alternatingGroup (Fin 7)) := by
  haveI hsimple : IsSimpleGroup (alternatingGroup (Fin 7)) :=
    alternatingGroup.isSimpleGroup (by simp)
  haveI hperf : Group.IsPerfect (alternatingGroup (Fin 7)) :=
    ⟨commutator_alternatingGroup_eq_top (α := Fin 7) (by simp)⟩
  refine ⟨hsimple, hperf, fun hP => ?_⟩
  haveI : Group.IsNilpotent (alternatingGroup (Fin 7)) := hP.isNilpotent
  exact Group.IsPerfect.not_isSolvable (alternatingGroup (Fin 7)) (IsNilpotent.to_isSolvable)


/-- Solvability passes to the target of a surjective homomorphism. -/
theorem case34_isSolvable_of_surjective {G H : Type} [Group G] [Group H] (f : G →* H)
    (hf : Function.Surjective f) [Group.IsSolvable G] : Group.IsSolvable H :=
  Group.isSolvable_of_ker_le_range f (1 : H →* G)
    (by rw [MonoidHom.ker_one]
        exact le_of_eq (MonoidHom.range_eq_top.mpr hf).symm)


/-! ## Local vocabulary for the case analysis -/

/-- `Ḡ = C·O(X)/O(X) = π(C) ◁ Q`. -/
abbrev GG (X : Type) [Group X] : Subgroup (QX X) := (CF2 X).map (piX X)

/-- The last term of the derived series of `↥Ḡ`, placed in `Q`. -/
noncomputable abbrev ELast (X : Type) [Group X] : Subgroup (QX X) :=
  (derivedSeries ↥(GG X) (Nat.card X)).map (GG X).subtype

instance GG_normal (X : Type) [Group X] : (GG X).Normal :=
  (CF2_normal X).map (piX X) (piX_surjective X)

/-! ## Step 1: `C_X(F_{2'}(X)) ⊓ O(X) ≤ F_{2'}(X)` -/

theorem case34_centralizerF2p_inf_oddCore_le (X : Type) [Group X] [Finite X]
    (hFT : Work.GW2.FeitThompsonProp) : CF2 X ⊓ Work.GW2.oddCore X ≤ Work.DSTR.F2p X := by
  haveI hOn : (Work.GW2.oddCore X).Normal := Work.GW2.oddCore_normal X
  -- `K = F(O(X))`, viewed inside `X`
  set K : Subgroup X := (Work.GW2.fitting ↥(Work.GW2.oddCore X)).map
    (Work.GW2.oddCore X).subtype with hK
  have hKnil : Group.IsNilpotent ↥K := by
    rw [hK]
    exact (Group.isNilpotent_congr (Subgroup.equivMapOfInjective _ _
      (Subgroup.subtype_injective _))).mp (Work.DSTR.M110.fitting_isNilpotent ↥(Work.GW2.oddCore X))
  have hKnormal : K.Normal := by
    rw [hK]
    haveI hchar : (Work.GW2.fitting ↥(Work.GW2.oddCore X)).Characteristic := by
      rw [FittingPiImg.fitting_eq_isaacsFitting]
      exact OddOrder.Isaacs.Ch01.fitting.characteristic _
    exact ConjAct.normal_of_characteristic_of_normal
  have hKF : K ≤ Work.GW2.fitting X := by
    haveI := hKnormal
    rw [FittingPiImg.fitting_eq_isaacsFitting (G := X)]
    exact OddOrder.Isaacs.Ch01.nilpotent_normal_le_fitting (N := K)
  have hKodd : Odd (Nat.card K) := by
    rw [hK, Subgroup.card_map_of_injective (Work.GW2.oddCore X).subtype_injective]
    exact Odd.of_dvd_nat (Work.ASM.oddCore_odd X)
      (Subgroup.card_subgroup_dvd_card (Work.GW2.fitting ↥(Work.GW2.oddCore X)))
  have hKF2 : K ≤ Work.DSTR.F2p X := by
    haveI := hKnormal
    exact FittingPiImg.le_map_piCore_of_le_of_normal ({2}ᶜ : Set ℕ) hKF
      ((Work.GW2.odd_iff_isPiSubgroup_ne_two (G := X) K).mp hKodd)
  intro x hx
  obtain ⟨hxC, hxO⟩ := Subgroup.mem_inf.mp hx
  haveI hOsol : Group.IsSolvable ↥(Work.GW2.oddCore X) :=
    hFT ↥(Work.GW2.oddCore X) (Work.ASM.oddCore_odd X)
  have hcent : (⟨x, hxO⟩ : ↥(Work.GW2.oddCore X)) ∈
      Subgroup.centralizer ((Work.GW2.fitting ↥(Work.GW2.oddCore X) : Subgroup
        ↥(Work.GW2.oddCore X)) : Set ↥(Work.GW2.oddCore X)) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    apply Subtype.ext
    show (y : X) * x = x * (y : X)
    exact Subgroup.mem_centralizer_iff.mp hxC (y : X)
      (hKF2 (Subgroup.mem_map.mpr ⟨y, hy, rfl⟩))
  have hmem : (⟨x, hxO⟩ : ↥(Work.GW2.oddCore X)) ∈ Work.GW2.fitting ↥(Work.GW2.oddCore X) :=
    Work.DSTR.fittingSelfCentralizing ↥(Work.GW2.oddCore X) hOsol hcent
  exact hKF2 (Subgroup.mem_map.mpr ⟨⟨x, hxO⟩, hmem, rfl⟩)

/-- A `2`-subgroup of a group all of whose subgroups of odd index ... : if `L ◁ G` has odd index
and `N ≤ G` is a `2`-subgroup, then `N ≤ L`. -/
theorem case34_sub_le_of_isPGroup_two_of_odd_index {G : Type} [Group G] [Finite G]
    {N L : Subgroup G} [L.Normal] (hN : IsPGroup 2 N) (hL : Odd L.index) : N ≤ L := by
  rw [← QuotientGroup.ker_mk' L, ← Subgroup.map_eq_bot_iff]
  set K : Subgroup (G ⧸ L) := N.map (QuotientGroup.mk' L) with hK
  have hKdvd : Nat.card K ∣ Nat.card N := by
    have hrange : K = ((QuotientGroup.mk' L).comp N.subtype).range := by
      rw [hK, MonoidHom.range_comp, Subgroup.range_subtype]
    rw [hrange]
    exact ⟨Nat.card ↥(((QuotientGroup.mk' L).comp N.subtype).ker), by
      rw [mul_comm]; exact (Subgroup.card_ker_mul_card_range _).symm⟩
  have hKdvd₂ : Nat.card K ∣ L.index := by
    rw [Subgroup.index_eq_card]
    exact Subgroup.card_subgroup_dvd_card K
  have hKodd : Odd (Nat.card K) := Odd.of_dvd_nat hL hKdvd₂
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hN
  have hKdvd₂ₙ : Nat.card K ∣ 2 ^ n := by rw [← hn]; exact hKdvd
  obtain ⟨j, _, hjeq⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hKdvd₂ₙ
  have hj0 : j = 0 := by
    by_contra hjne
    have hge : 1 ≤ j := Nat.one_le_iff_ne_zero.mpr hjne
    have hdvd2 : 2 ∣ 2 ^ j := ⟨2 ^ (j - 1), by rw [← pow_succ', Nat.sub_add_cancel hge]⟩
    exact absurd (even_iff_two_dvd.mpr hdvd2)
      (Nat.not_even_iff_odd.mpr (hjeq ▸ hKodd))
  rw [hj0, pow_zero] at hjeq
  exact Subgroup.eq_bot_of_card_eq (H := K) hjeq

/-! ## The `A₇` branch of Step 3 -/

/-- If `Q ≅ A₇` and `O_2(X) ≠ ⊥` then the image of `O_2(X)` in `Q` is a nontrivial normal
subgroup of the simple non-`2`-group `A₇`: contradiction. -/
theorem case34_false_of_A7 (X : Type) [Group X] [Finite X]
    (e : QX X ≃* alternatingGroup (Fin 7)) (hA : Work.GW2.pCore 2 X ≠ ⊥) : False := by
  haveI h7simple : IsSimpleGroup (alternatingGroup (Fin 7)) := case34_a7_basic.1
  haveI hsimple : IsSimpleGroup (QX X) := MulEquiv.isSimpleGroup e
  set Ā : Subgroup (QX X) := (Work.GW2.pCore 2 X).map (piX X) with hĀ
  have hĀne : Ā ≠ ⊥ := map_pCore_two_ne_bot X hA
  have hĀn : Ā.Normal :=
    (Work.GW2.pCore_normal 2 X).map (piX X) (piX_surjective X)
  have hĀp : IsPGroup 2 ↥Ā := (Work.CORE2A.pCore_isPGroup' (X := X) (p := 2)).map (piX X)
  have htop : Ā = ⊤ := by
    rcases Subgroup.Normal.eq_bot_or_eq_top Ā with h | h
    · exact absurd h hĀne
    · exact h
  have hQp : IsPGroup 2 (QX X) := by
    have htop' : IsPGroup 2 ↥(⊤ : Subgroup (QX X)) := htop ▸ hĀp
    exact htop'.of_equiv Subgroup.topEquiv
  exact case34_a7_basic.2.2 (hQp.of_equiv e)

/-- In the `L`-branch of Step 3, `O_2(X) ≠ ⊥` forces a central involution: the image `Ā` of
`O_2(X)` in `Q` lies in `L` (odd index) and either `Ā ⊇ P = L'` — impossible as `Ā` is a
`2`-group and `L' ≅ L₂(q)` is not — or `Ā ⊓ P = ⊥`, so `|Ā| ≤ |L : L'| ≤ 2` and the normal
subgroup `Ā ≅ C₂` of `Q` is central. -/
theorem case34_d16b_of_L (X : Type) [Group X] [Finite X] {L P : Subgroup (QX X)}
    (hLN : L.Normal) (hLodd : Odd L.index) (hPL : P ≤ L) (hPeq : P = ⁅L, L⁆)
    (hidx : (P.subgroupOf L).index ≤ 2) (hPsimple : IsSimpleGroup ↥P)
    (hP2 : ¬ IsPGroup 2 ↥P) (hA : Work.GW2.pCore 2 X ≠ ⊥) : d16b X := by
  haveI : L.Normal := hLN
  set Ā : Subgroup (QX X) := (Work.GW2.pCore 2 X).map (piX X) with hĀ
  have hĀne : Ā ≠ ⊥ := map_pCore_two_ne_bot X hA
  have hĀn : Ā.Normal :=
    (Work.GW2.pCore_normal 2 X).map (piX X) (piX_surjective X)
  have hĀp : IsPGroup 2 ↥Ā := (Work.CORE2A.pCore_isPGroup' (X := X) (p := 2)).map (piX X)
  have hĀL : Ā ≤ L := case34_sub_le_of_isPGroup_two_of_odd_index hĀp hLodd
  -- `P` is normal in `Q` (it is the commutator of the normal subgroup `L`)
  haveI hPn : P.Normal := hPeq ▸ Subgroup.commutator_normal L L
  -- `Ā ⊓ P` inside `P`
  haveI hNPC : (Ā.subgroupOf P).Normal := hĀn.subgroupOf P
  rcases Subgroup.Normal.eq_bot_or_eq_top (Ā.subgroupOf P) with hbot | htop
  · -- `Ā ⊓ P = ⊥`: `Ā` embeds in `L/P`, hence `|Ā| ≤ 2`
    have hdisj : Ā ⊓ P = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      have : (⟨x, hx.2⟩ : ↥P) ∈ Ā.subgroupOf P := Subgroup.mem_subgroupOf.mpr hx.1
      rw [hbot] at this
      simpa using this
    have hinj : Function.Injective (((QuotientGroup.mk' (P.subgroupOf L)).comp
        (Subgroup.inclusion hĀL)) : ↥Ā →* (↥L ⧸ P.subgroupOf L)) := by
      rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro x hx
      rw [MonoidHom.mem_ker] at hx
      have hxP : (((x : ↥Ā) : QX X)) ∈ P :=
        Subgroup.mem_subgroupOf.mp ((QuotientGroup.eq_one_iff (Subgroup.inclusion hĀL x)).mp hx)
      have : (((x : ↥Ā) : QX X)) ∈ Ā ⊓ P := ⟨x.2, hxP⟩
      rw [hdisj] at this
      simpa using this
    have hcard_le : Nat.card Ā ≤ (P.subgroupOf L).index := by
      rw [Subgroup.index_eq_card]
      exact Nat.card_le_card_of_injective _ hinj
    have hcard2 : Nat.card Ā = 2 := by
      have hpos : 0 < Nat.card Ā := Nat.card_pos_iff.mpr ⟨⟨1, Ā.one_mem⟩, inferInstance⟩
      have hne1 : Nat.card Ā ≠ 1 := fun h1 =>
        hĀne (Subgroup.eq_bot_of_card_eq (H := Ā) h1)
      omega
    have hcenter : Ā ≤ Subgroup.center (QX X) :=
      case34_le_center_of_card_eq_two (G := QX X) (N := Ā) hcard2
    obtain ⟨g, hg⟩ : ∃ g : Ā, g ≠ 1 := by
      by_contra h
      apply hĀne
      rw [eq_bot_iff]
      intro x hx
      by_contra hx1
      exact h ⟨⟨x, hx⟩, fun h1 => hx1 (by
        rw [Subgroup.mem_bot]
        simpa using congrArg Subtype.val h1)⟩
    obtain ⟨w, -, hworder⟩ :=
      Work.DSTR.D16.exists_zpowers_orderOf_eq_two hĀp hg
    exact case34_central_involution_of_map X (w := (w : QX X)) w.2 (hcenter w.2)
      (by rw [Subgroup.orderOf_coe]; exact hworder)
  · -- `P ≤ Ā`: impossible, `Ā` is a `2`-group
    have hPĀ : P ≤ Ā := by
      intro x hx
      have : (⟨x, hx⟩ : ↥P) ∈ Ā.subgroupOf P := by rw [htop]; trivial
      exact Subgroup.mem_subgroupOf.mp this
    exact absurd (hĀp.to_le hPĀ) hP2

/-! ## Step 4 (clause (d)) -/

/-- Solvability transports along a group isomorphism. -/
theorem case34_isSolvable_of_mulEquiv {G H : Type} [Group G] [Group H] (e : G ≃* H)
    [Group.IsSolvable H] : Group.IsSolvable G :=
  Group.isSolvable_of_ker_le_range e.symm.toMonoidHom (1 : G →* H)
    (by rw [MonoidHom.ker_one]
        exact le_of_eq (MonoidHom.range_eq_top.mpr e.symm.surjective).symm)

/-- Extension of a solvable group by a solvable quotient, in the shape needed below. -/
theorem case34_isSolvable_quotient_of_le {G : Type} [Group G] (E C : Subgroup G) [E.Normal]
    [C.Normal] (hEC : E ≤ C) (hC : Group.IsSolvable (↥C ⧸ E.subgroupOf C))
    (hQ : Group.IsSolvable (G ⧸ C)) : Group.IsSolvable (G ⧸ E) := by
  haveI hECn : (E.subgroupOf C).Normal := Subgroup.Normal.subgroupOf ‹E.Normal› C
  haveI hEn : E.Normal := inferInstance
  haveI hCn : C.Normal := inferInstance
  haveI hmapn : (C.map (QuotientGroup.mk' E)).Normal :=
    hCn.map (QuotientGroup.mk' E) (QuotientGroup.mk'_surjective E)
  haveI hQC : Group.IsSolvable (G ⧸ C) := hQ
  haveI hCsol : Group.IsSolvable (↥C ⧸ E.subgroupOf C) := hC
  -- the natural map `↥C →* G ⧸ E`, with kernel `E.subgroupOf C` and range `C.map (mk' E)`
  let φ : ↥C →* G ⧸ E := (QuotientGroup.mk' E).comp C.subtype
  have hφker : φ.ker = E.subgroupOf C := by
    ext x
    rw [MonoidHom.mem_ker]
    exact Iff.trans (QuotientGroup.eq_one_iff ((x : ↥C) : G)) (Subgroup.mem_subgroupOf ..).symm
  have hφrange : φ.range = C.map (QuotientGroup.mk' E) := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  haveI : Group.IsSolvable (↥C ⧸ φ.ker) :=
    case34_isSolvable_of_mulEquiv (QuotientGroup.quotientMulEquivOfEq hφker)
  haveI hrangeSol : Group.IsSolvable ↥φ.range :=
    case34_isSolvable_of_mulEquiv (QuotientGroup.quotientKerEquivRange φ).symm
  haveI : Group.IsSolvable ↥(C.map (QuotientGroup.mk' E)) := hφrange ▸ hrangeSol
  haveI : Group.IsSolvable ((G ⧸ E) ⧸ (C.map (QuotientGroup.mk' E))) :=
    case34_isSolvable_of_mulEquiv (QuotientGroup.quotientQuotientEquivQuotient E C hEC)
  exact Group.isSolvable_of_subgroup_quotient (C.map (QuotientGroup.mk' E))

/-- `A₇`-branch of the `d16d` construction: the last term of the derived series of `Ḡ = ⊤` is `⊤`,
which is simple. -/
theorem case34_lastDerivedTerm_isSimple_a7 (Q : Type) [Group Q] [Finite Q] {Ġ : Subgroup Q}
    [Ġ.Normal] (hne : Ġ ≠ ⊥) (e : Q ≃* alternatingGroup (Fin 7)) (m : ℕ)
    (hm : Nat.card Q ≤ m) : IsSimpleGroup ↥((derivedSeries ↥Ġ m).map Ġ.subtype) := by
  haveI h7simple : IsSimpleGroup (alternatingGroup (Fin 7)) := case34_a7_basic.1
  haveI h7perf : Group.IsPerfect (alternatingGroup (Fin 7)) := case34_a7_basic.2.1
  haveI hsimpleQ : IsSimpleGroup Q := MulEquiv.isSimpleGroup e
  have htop : Ġ = ⊤ := by
    rcases Subgroup.Normal.eq_bot_or_eq_top Ġ with h | h
    · exact absurd h hne
    · exact h
  haveI hperfQ : Group.IsPerfect Q :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  haveI hperfĠ : Group.IsPerfect ↥Ġ := by
    rw [htop]
    exact Group.IsPerfect.top_iff.mpr hperfQ
  have hderiv : derivedSeries ↥Ġ m = ⊤ := Group.IsPerfect.derivedSeries_eq_top ↥Ġ m
  rw [hderiv, ← MonoidHom.range_eq_map, Subgroup.range_subtype, htop]
  exact (Subgroup.topEquiv (G := Q)).isSimpleGroup

/-- In the `L`-branch, `Q/P` is solvable: `L/P` has order at most `2` and `Q/L` is odd. -/
theorem case34_isSolvable_quotient_of_odd {Q : Type} [Group Q] [Finite Q]
    (hFT : Work.GW2.FeitThompsonProp) {P L : Subgroup Q} [P.Normal] [L.Normal]
    (hPL : P ≤ L) (hodd : Odd L.index) (hidx : (P.subgroupOf L).index ≤ 2) :
    Group.IsSolvable (Q ⧸ P) := by
  haveI hQL : Group.IsSolvable (Q ⧸ L) :=
    hFT (Q ⧸ L) (by rw [← Subgroup.index_eq_card]; exact hodd)
  haveI hLP : (P.subgroupOf L).Normal := Subgroup.Normal.subgroupOf ‹P.Normal› L
  haveI : Group.IsSolvable (↥L ⧸ P.subgroupOf L) :=
    Work.DSTR.isSolvable_of_card_le_six (by rw [← Subgroup.index_eq_card]; omega)
  exact case34_isSolvable_quotient_of_le P L hPL inferInstance inferInstance

/-- In the `L`-branch, `P = L'` lies in any non-solvable normal subgroup `Ġ`: otherwise `Ġ ⊓ P = ⊥`
would embed `Ġ` into the solvable group `Q/P`. -/
theorem case34_P_le_of_l2 {Q : Type} [Group Q] [Finite Q] {Ġ L P : Subgroup Q} [Ġ.Normal]
    [L.Normal] (hns : ¬ Group.IsSolvable ↥Ġ) (hFT : Work.GW2.FeitThompsonProp)
    (hodd : Odd L.index) (hPL : P ≤ L) (hPeq : P = ⁅L, L⁆) (hPsimple : IsSimpleGroup ↥P)
    (hidx : (P.subgroupOf L).index ≤ 2) : P ≤ Ġ := by
  haveI hPn : P.Normal := hPeq ▸ Subgroup.commutator_normal L L
  haveI hĠPn : (Ġ.subgroupOf P).Normal := ‹Ġ.Normal›.subgroupOf P
  rcases Subgroup.Normal.eq_bot_or_eq_top (Ġ.subgroupOf P) with hbot | htop
  · have hdisj : Ġ ⊓ P = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      have : (⟨x, hx.2⟩ : ↥P) ∈ Ġ.subgroupOf P := Subgroup.mem_subgroupOf.mpr hx.1
      rw [hbot] at this
      simpa using this
    haveI hQsol : Group.IsSolvable (Q ⧸ P) :=
      case34_isSolvable_quotient_of_odd hFT hPL hodd hidx
    have hinj : Function.Injective ((QuotientGroup.mk' P).comp Ġ.subtype) := by
      rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro x hx
      rw [MonoidHom.mem_ker] at hx
      have hxP : (((x : ↥Ġ) : Q)) ∈ P := (QuotientGroup.eq_one_iff ((x : ↥Ġ) : Q)).mp hx
      have : (((x : ↥Ġ) : Q)) ∈ Ġ ⊓ P := ⟨x.2, hxP⟩
      rw [hdisj] at this
      simpa using this
    exact absurd (Group.isSolvable_of_isSolvable_injective
      (f := (QuotientGroup.mk' P).comp Ġ.subtype) hinj) hns
  · intro x hx
    have : (⟨x, hx⟩ : ↥P) ∈ Ġ.subgroupOf P := by rw [htop]; trivial
    exact Subgroup.mem_subgroupOf.mp this

/-- If `Ḡ = C·O(X)/O(X)` is solvable then `C` is solvable: `C/(C ⊓ O(X)) ≅ Ḡ` and `C ⊓ O(X)` has
odd order, hence is solvable by Feit–Thompson. -/
theorem case34_isSolvable_CF2_of_isSolvable_GG (X : Type) [Group X] [Finite X]
    (hFT : Work.GW2.FeitThompsonProp) (hsol : Group.IsSolvable ↥(GG X)) :
    Group.IsSolvable ↥(CF2 X) := by
  haveI hCn : (CF2 X).Normal := CF2_normal X
  haveI hOn : (Work.GW2.oddCore X).Normal := Work.GW2.oddCore_normal X
  haveI hOsol : Group.IsSolvable ↥(Work.GW2.oddCore X) :=
    hFT ↥(Work.GW2.oddCore X) (Work.ASM.oddCore_odd X)
  -- `Z = C ⊓ O(X)` inside `↥C` is solvable (it has odd order)
  have hZmap : ((Work.GW2.oddCore X).subgroupOf (CF2 X)).map (CF2 X).subtype
      ≤ Work.GW2.oddCore X := by
    rintro x ⟨y, hy, rfl⟩
    exact Subgroup.mem_subgroupOf.mp hy
  haveI hZs : Group.IsSolvable ↥(((Work.GW2.oddCore X).subgroupOf (CF2 X)).map
      (CF2 X).subtype) :=
    Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hZmap)
      (Subgroup.inclusion_injective hZmap)
  haveI hZsol : Group.IsSolvable ↥((Work.GW2.oddCore X).subgroupOf (CF2 X)) :=
    case34_isSolvable_of_mulEquiv
      (Subgroup.equivMapOfInjective _ _ (CF2 X).subtype_injective)
  -- `↥C ⧸ Z ≅ Ḡ`
  have hψ : ((piX X).comp (CF2 X).subtype).range = GG X := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hψker : ((piX X).comp (CF2 X).subtype).ker = (Work.GW2.oddCore X).subgroupOf (CF2 X) := by
    ext x
    rw [MonoidHom.mem_ker]
    exact Iff.trans (QuotientGroup.eq_one_iff ((x : ↥(CF2 X)) : X))
      (Subgroup.mem_subgroupOf ..).symm
  haveI hrangeSol : Group.IsSolvable ↥(((piX X).comp (CF2 X).subtype).range) := hψ ▸ hsol
  haveI hquot : Group.IsSolvable (↥(CF2 X) ⧸ ((piX X).comp (CF2 X).subtype).ker) :=
    case34_isSolvable_of_mulEquiv
      (QuotientGroup.quotientKerEquivRange ((piX X).comp (CF2 X).subtype))
  haveI hquot' : Group.IsSolvable (↥(CF2 X) ⧸ (Work.GW2.oddCore X).subgroupOf (CF2 X)) :=
    case34_isSolvable_of_mulEquiv (QuotientGroup.quotientMulEquivOfEq hψker).symm
  exact Group.isSolvable_of_subgroup_quotient ((Work.GW2.oddCore X).subgroupOf (CF2 X))

/-- `X ⧸ C_X(F_{2'}(X))` is solvable: `(C ⊔ O(X))/C` is a quotient of the odd group `O(X)` and
`X/(C ⊔ O(X)) ≅ Q/Ḡ`. -/
theorem case34_isSolvable_quotient_CF2 (X : Type) [Group X] [Finite X]
    (hFT : Work.GW2.FeitThompsonProp) (hQ : Group.IsSolvable ((QX X) ⧸ (GG X))) :
    Group.IsSolvable (X ⧸ CF2 X) := by
  haveI hCn : (CF2 X).Normal := CF2_normal X
  haveI hOn : (Work.GW2.oddCore X).Normal := Work.GW2.oddCore_normal X
  refine case34_isSolvable_quotient_of_le (CF2 X) (Work.GW2.oddCore X ⊔ CF2 X) le_sup_right ?_ ?_
  · -- `(O ⊔ C)/C ≅ O/(O ⊓ C)` is a quotient of the odd group `O`
    haveI hOsol : Group.IsSolvable ↥(Work.GW2.oddCore X) :=
      hFT ↥(Work.GW2.oddCore X) (Work.ASM.oddCore_odd X)
    haveI : ((CF2 X).subgroupOf (Work.GW2.oddCore X)).Normal :=
      hCn.subgroupOf (Work.GW2.oddCore X)
    haveI : Group.IsSolvable (↥(Work.GW2.oddCore X) ⧸
        (CF2 X).subgroupOf (Work.GW2.oddCore X)) := inferInstance
    exact case34_isSolvable_of_mulEquiv
      (QuotientGroup.quotientInfEquivProdNormalQuotient (Work.GW2.oddCore X) (CF2 X)).symm
  · -- `X/(O ⊔ C) ≅ Q/Ḡ`
    have hle : Work.GW2.oddCore X ≤ Work.GW2.oddCore X ⊔ CF2 X := le_sup_left
    have hmapO : (Work.GW2.oddCore X).map (QuotientGroup.mk' (Work.GW2.oddCore X)) = ⊥ := by
      rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    have hmap : (Work.GW2.oddCore X ⊔ CF2 X).map (QuotientGroup.mk' (Work.GW2.oddCore X))
        = GG X := by
      rw [Subgroup.map_sup, hmapO, bot_sup_eq]
    haveI : Group.IsSolvable ((QX X) ⧸
        (Work.GW2.oddCore X ⊔ CF2 X).map (QuotientGroup.mk' (Work.GW2.oddCore X))) :=
      case34_isSolvable_of_mulEquiv (QuotientGroup.quotientMulEquivOfEq hmap)
    exact case34_isSolvable_of_mulEquiv
      (QuotientGroup.quotientQuotientEquivQuotient (Work.GW2.oddCore X)
        (Work.GW2.oddCore X ⊔ CF2 X) hle).symm

/-- **Clause (d) of Bender 1.6, cases 3 and 4.**  With `C = C_X(F_{2'}(X))` non-solvable,
`C ⊓ O(X) ≤ F_{2'}(X)` and the last term of the derived series of `Ḡ = C·O(X)/O(X)` simple, the
last term `E` of the derived series of `C` is a normal quasisimple subgroup of `X` and `X/E` is
solvable. -/
theorem case34_d16d_core (X : Type) [Group X] [Finite X] (hFT : Work.GW2.FeitThompsonProp)
    (hCO : CF2 X ⊓ Work.GW2.oddCore X ≤ Work.DSTR.F2p X)
    (hS : IsSimpleGroup ↥(ELast X)) (hQ : Group.IsSolvable ((QX X) ⧸ (GG X))) : d16d X := by
  haveI hCn : (CF2 X).Normal := CF2_normal X
  haveI hOn : (Work.GW2.oddCore X).Normal := Work.GW2.oddCore_normal X
  have hcard : Nat.card ↥(CF2 X) ≤ Nat.card X :=
    Nat.card_le_card_of_injective _ Subtype.coe_injective
  obtain ⟨hDperf, hDquot⟩ := case34_derivedSeries_basic ↥(CF2 X) (Nat.card X) hcard
  set D : Subgroup ↥(CF2 X) := derivedSeries ↥(CF2 X) (Nat.card X) with hDdef
  set E : Subgroup X := D.map (CF2 X).subtype with hEdef
  haveI hDchar : D.Characteristic := inferInstance
  have hEn : E.Normal := by
    rw [hEdef]
    exact ConjAct.normal_of_characteristic_of_normal
  have hEperf : ⁅E, E⁆ = E := by
    rw [hEdef, ← Subgroup.map_commutator, hDperf]
  have hEsub : E ≤ CF2 X := by rw [hEdef]; exact Subgroup.map_subtype_le D
  have hEinfO : E ⊓ Work.GW2.oddCore X ≤ Work.DSTR.F2p X := by
    refine le_trans ?_ hCO
    intro x hx
    exact ⟨hEsub hx.1, hx.2⟩
  -- the map `↥E →* Q`, whose kernel is `E ⊓ O(X) ≤ Z(E)`
  have hker_le_center : ((piX X).comp E.subtype).ker ≤ Subgroup.center ↥E := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hxO : (((x : ↥E) : X)) ∈ Work.GW2.oddCore X :=
      (QuotientGroup.eq_one_iff ((x : ↥E) : X)).mp hx
    have hxF2 : (((x : ↥E) : X)) ∈ Work.DSTR.F2p X := hEinfO ⟨x.2, hxO⟩
    rw [Subgroup.mem_center_iff]
    intro y
    apply Subtype.ext
    show (((y : ↥E) : X)) * (((x : ↥E) : X)) = (((x : ↥E) : X)) * (((y : ↥E) : X))
    exact (Subgroup.mem_centralizer_iff.mp (hEsub y.2) (((x : ↥E) : X)) hxF2).symm
  obtain ⟨f, hfsurj, -, -⟩ :=
    Work.DSTR.layerShapeAux.exists_surj_range_center ((piX X).comp E.subtype) hker_le_center
  -- `(π ∘ E.subtype).range = ELast X`
  set ψ : ↥(CF2 X) →* QX X := (piX X).comp (CF2 X).subtype with hψdef
  have hψrange : ψ.range = GG X := by
    rw [hψdef, MonoidHom.range_comp, Subgroup.range_subtype]
  have hrange : ((piX X).comp E.subtype).range = ELast X := by
    have hstep1 : ((piX X).comp E.subtype).range = D.map ψ := by
      rw [MonoidHom.range_comp, Subgroup.range_subtype, hEdef]
      calc (D.map (CF2 X).subtype).map (piX X)
          = D.map ((piX X).comp (CF2 X).subtype) := Subgroup.map_map D _ _
        _ = D.map ψ := rfl
    have hstep2 : D.map ψ
        = (derivedSeries ↥(ψ.range) (Nat.card X)).map ψ.range.subtype := by
      rw [hDdef]
      calc (derivedSeries ↥(CF2 X) (Nat.card X)).map ψ
          = (derivedSeries ↥(CF2 X) (Nat.card X)).map
              (ψ.range.subtype.comp ψ.rangeRestrict) := by
            rw [MonoidHom.subtype_comp_rangeRestrict]
        _ = ((derivedSeries ↥(CF2 X) (Nat.card X)).map ψ.rangeRestrict).map
              ψ.range.subtype := by rw [Subgroup.map_map]
        _ = _ := by
            rw [map_derivedSeries_eq ψ.rangeRestrict_surjective (Nat.card X)]
    have hstep3 : (derivedSeries ↥(ψ.range) (Nat.card X)).map ψ.range.subtype = ELast X := by
      rw [hψrange]
    rw [hstep1, hstep2, hstep3]
  haveI hSrange : IsSimpleGroup ↥(((piX X).comp E.subtype).range) := hrange.symm ▸ hS
  have hEnontriv : Nontrivial ↥E := by
    obtain ⟨a, b, hab⟩ := exists_pair_ne ↥(((piX X).comp E.subtype).range)
    obtain ⟨x, hx⟩ := (((piX X).comp E.subtype)).rangeRestrict_surjective a
    obtain ⟨y, hy⟩ := (((piX X).comp E.subtype)).rangeRestrict_surjective b
    exact ⟨x, y, fun h => hab (by rw [← hx, ← hy, h])⟩
  -- `E ⧸ Z(E)` is a quotient of the simple group `ELast X`
  have hEsimple : IsSimpleGroup (↥E ⧸ Subgroup.center ↥E) := by
    haveI : Nontrivial (↥E ⧸ Subgroup.center ↥E) := by
      by_contra h
      rw [not_nontrivial_iff_subsingleton] at h
      have hcenter : Subgroup.center ↥E = ⊤ := by
        rw [Subgroup.eq_top_iff']
        intro x
        have h1 : QuotientGroup.mk' (Subgroup.center ↥E) x = 1 := Subsingleton.elim _ _
        rw [QuotientGroup.mk'_apply] at h1
        exact (QuotientGroup.eq_one_iff _).mp h1
      haveI : Group.IsSolvable ↥E := Group.isSolvable_of_comm fun a b =>
        (Subgroup.mem_center_iff.mp (by rw [hcenter]; exact Subgroup.mem_top a) b).symm
      haveI : Group.IsPerfect ↥E := Subgroup.isPerfect_iff.mpr hEperf
      exact Group.IsPerfect.not_isSolvable ↥E inferInstance
    exact IsSimpleGroup.isSimpleGroup_of_surjective f hfsurj
  -- `X ⧸ E` is solvable
  have hCE : E.subgroupOf (CF2 X) = D := by
    rw [hEdef]
    ext x
    constructor
    · intro hx
      obtain ⟨d, hd, hdx⟩ := Subgroup.mem_map.mp (Subgroup.mem_subgroupOf.mp hx)
      rwa [← Subtype.ext hdx]
    · intro hx
      exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
  haveI hCEsol : Group.IsSolvable (↥(CF2 X) ⧸ E.subgroupOf (CF2 X)) :=
    case34_isSolvable_of_mulEquiv (QuotientGroup.quotientMulEquivOfEq hCE)
  haveI hXCsol : Group.IsSolvable (X ⧸ CF2 X) := case34_isSolvable_quotient_CF2 X hFT hQ
  have hXsol : Group.IsSolvable (X ⧸ E) :=
    case34_isSolvable_quotient_of_le E (CF2 X) hEsub inferInstance inferInstance
  exact ⟨E, hEn, ⟨hEperf, hEsimple⟩, hXsol⟩

/-- **Bender 1.6, cases `X/O(X) ≅ A₇` and `X/O(X)` has a normal `L₂(q)`/`PGL₂(q)` of odd index.**  Proof sketch.  Put `Q = X/O(X)`, `A = O_2(X)`, `F = F(X)`, `F₂ = F_{2'}(X)`, `C = C_X(F₂)`.

Step 1: `C ⊓ O(X) ≤ F₂`.  `F(O(X))` is a normal nilpotent subgroup of `X` of odd order (`F` is characteristic in `O(X) ⊴ X`), hence `F(O(X)) ≤ F` and it is odd, so `F(O(X)) ≤ O_{2'}(F(X)) = F₂`; Bender 1.2 applied to the solvable (odd, by `hFT`) group `O(X)` gives `C_{O(X)}(F(O(X))) ≤ F(O(X)) ≤ F₂`, and `C ⊓ O(X) = C_{O(X)}(F₂) ≤ C_{O(X)}(F(O(X)))`.

Step 2: if `C` is solvable then `C ≤ F₂`, giving (a): `F(C)` is characteristic in `C` hence normal in `X` and nilpotent, so `F(C) ≤ F`, and `a ≤ C = C_X(F₂)` gives `F(C) ≤ Z(C)`; hence `C = C_C(F(C)) ≤ F(C) ≤ F`.

Step 3: `A = ⊥`.  Otherwise `π(A) = A·O(X)/O(X) ≅ A` (as `A ⊓ O(X) = ⊥`) is a nontrivial normal `2`-subgroup of `Q`.  `A₇` case: impossible (simple, not a `2`-group).  `L` case: `L` has odd index, so every Sylow `2`-subgroup of `Q` lies in `L`, hence `π(A) ≤ L`; and `π(A) ⊓ L' ⊴ L'` with `L' ≅ L₂(q)` simple and not a `2`-group, so `π(A) ⊓ L' = ⊥` and `π(A) ↪ L/L'` with `|L/L'| ≤ 2`; if `|π(A)| = 2` the normal `π(A) ≅ C₂` of `Q` is central (commutators land in `A ⊓ O(X) = ⊥`), giving (b).  Otherwise `A = ⊥` and hence `F = F₂`.

Step 4: with `A = ⊥` and `C` non-solvable, put `Z = C ⊓ O(X) ≤ F₂` (Step 1), so `Z ≤ Z(C)`.  Also `Ḡ = C·O(X)/O(X) ◁ Q` is nonzero and `C/Z ≅ Ḡ`.  `A₇` case: `Ḡ ◁ Q ≅ A₇` nonzero ⟹ `Ḡ = ⊤`, so `C/Z ≅ A₇` is nonabelian simple.  `L` case: either `Ḡ ⊓ L = ⊥` (then `Ḡ ↪ Q/L` is odd hence solvable, forcing the last term of the derived series of `C` into `Z`, i.e. `C` solvable — contradiction), or `L' ≤ Ḡ`, so the last term of the derived series of `Ḡ` is `L' ≅ L₂(q)`.  In both sub-cases, with `S` the last term of the derived series of `Ḡ` (nonabelian simple), the last term `E` of the derived series of `C` is perfect with `E·Z = C`, `E/(E ⊓ Z) ≅ S`, and `E ⊓ Z ≤ Z(E)` (as `Z ≤ Z(C)`), so `E/Z(E)`, a quotient of the simple group `S`, is simple: `E` is quasisimple.  Finally `X/C` is solvable (`C·O(X))/C` is a quotient of the odd group `O(X)`, and `X/(C·O(X)) ≅ Q/Ḡ` is solvable), so `X/E` is solvable: clause (d).

