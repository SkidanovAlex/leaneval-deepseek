import Mathlib
import Submission.Work.DSTR.Defs

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

/-!
# Quotients of dihedral groups

`DihedralGroup n` is generated by the rotation `r 1` and the reflection `sr 0`, subject to
`(sr 0)^2 = 1` and `(sr 0) * (r 1) * (sr 0) = (r 1)⁻¹`.  Consequently every quotient of
`DihedralGroup n` is an image of `DihedralGroup 0` or of a finite dihedral group, and is therefore
cyclic or dihedral.

We prove the general group-theoretic statement: a group generated by two elements `a`, `b` with
`b ^ 2 = 1` and `b * a * b = a⁻¹` is cyclic or dihedral.  The two cases (finite and infinite order
of `a`) are handled by explicit isomorphisms `DihedralGroup (orderOf a) ≃* G`, the map sending
`r i ↦ a ^ i` and `sr i ↦ b * a ^ i`.
-/

namespace Work.DSTR

open DihedralGroup

/-! ## Elementary conjugation identities -/

/-- Conjugation by the involution `b` inverts powers of `a`. -/
lemma conj_pow_eq {G : Type*} [Group G] {a b : G} (hbb : b * b = 1) (hab : b * a * b = a⁻¹)
    (k : ℤ) : b * a ^ k * b = a ^ (-k) := by
  have hb1 : b⁻¹ = b := inv_eq_of_mul_eq_one_right hbb
  have hconj : (MulAut.conj b) a = a⁻¹ := by rw [MulAut.conj_apply, hb1, hab]
  calc b * a ^ k * b = (MulAut.conj b) (a ^ k) := by rw [MulAut.conj_apply, hb1]
    _ = ((MulAut.conj b) a) ^ k := map_zpow (MulAut.conj b) a k
    _ = (a⁻¹) ^ k := by rw [hconj]
    _ = a ^ (-k) := by rw [inv_zpow, ← zpow_neg]

/-- `b * a ^ k = a ^ (-k) * b`. -/
lemma b_mul_pow {G : Type*} [Group G] {a b : G} (hbb : b * b = 1) (hab : b * a * b = a⁻¹)
    (k : ℤ) : b * a ^ k = a ^ (-k) * b := by
  have h : b * a ^ k * b = a ^ (-k) := conj_pow_eq hbb hab k
  rw [← h, mul_assoc (b * a ^ k) b b, hbb, mul_one]

/-- `a ^ k * b = b * a ^ (-k)`. -/
lemma pow_mul_b {G : Type*} [Group G] {a b : G} (hbb : b * b = 1) (hab : b * a * b = a⁻¹)
    (k : ℤ) : a ^ k * b = b * a ^ (-k) := by
  simpa using (b_mul_pow hbb hab (-k)).symm

/-- Powers of `a` are determined by the exponent modulo `orderOf a`. -/
lemma zpow_eq_zpow_of_modEq {G : Type*} [Group G] {a : G} {x y : ℤ}
    (h : x ≡ y [ZMOD (orderOf a : ℤ)]) : a ^ x = a ^ y :=
  (zpow_eq_zpow_iff_modEq).mpr h

/-! ## ZMod congruence lemmas -/

lemma zmod_val_intCast_add {m : ℕ} [NeZero m] (i j : ZMod m) :
    ((i + j).val : ℤ) ≡ (i.val : ℤ) + (j.val : ℤ) [ZMOD (m : ℤ)] := by
  rw [← ZMod.intCast_eq_intCast_iff]
  simp only [Int.cast_add, Int.cast_natCast]
  rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]

lemma zmod_val_intCast_sub {m : ℕ} [NeZero m] (i j : ZMod m) :
    ((j - i).val : ℤ) ≡ (j.val : ℤ) - (i.val : ℤ) [ZMOD (m : ℤ)] := by
  rw [← ZMod.intCast_eq_intCast_iff]
  simp only [Int.cast_sub, Int.cast_natCast]
  rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]

lemma zmod_val_eq_of_cast_eq {m : ℕ} [NeZero m] {i j : ZMod m}
    (h : (i.val : ℤ) ≡ (j.val : ℤ) [ZMOD (m:ℤ)]) : i = j := by
  rw [← ZMod.natCast_zmod_val (n := m) i, ← ZMod.natCast_zmod_val (n := m) j,
    ZMod.natCast_eq_natCast_iff]
  exact Int.natCast_modEq_iff.mp h

/-! ## The finite case: `DihedralGroup m ≃* G` for `m = orderOf a` -/

/-- The underlying map `DihedralGroup m → G`, `r i ↦ a ^ i.val`, `sr i ↦ b * a ^ i.val`. -/
def dihFin {G : Type*} [Group G] (a b : G) (m : ℕ) : DihedralGroup m → G
  | DihedralGroup.r i => a ^ (i.val : ℤ)
  | DihedralGroup.sr i => b * a ^ (i.val : ℤ)

lemma dihFin_mul {G : Type*} [Group G] {a b : G} {m : ℕ} [NeZero m] (hm : orderOf a = m)
    (hbb : b * b = 1) (hab : b * a * b = a⁻¹) :
    ∀ x y : DihedralGroup m, dihFin a b m (x * y) = dihFin a b m x * dihFin a b m y := by
  intro x y
  cases x with
  | r i =>
    cases y with
    | r j =>
      rw [DihedralGroup.r_mul_r]
      show a ^ ((i + j).val : ℤ) = a ^ (i.val:ℤ) * a ^ (j.val:ℤ)
      rw [← zpow_add]
      exact zpow_eq_zpow_of_modEq (by simpa [hm] using zmod_val_intCast_add i j)
    | sr j =>
      rw [DihedralGroup.r_mul_sr]
      show b * a ^ ((j - i).val : ℤ) = a ^ (i.val:ℤ) * (b * a ^ (j.val:ℤ))
      rw [← mul_assoc, pow_mul_b hbb hab (i.val:ℤ), mul_assoc, ← zpow_add]
      congr 1
      exact zpow_eq_zpow_of_modEq (by
        have h := zmod_val_intCast_sub (m := m) i j
        simpa [hm, sub_eq_add_neg, add_comm] using h)
  | sr i =>
    cases y with
    | r j =>
      rw [DihedralGroup.sr_mul_r]
      show b * a ^ ((i + j).val : ℤ) = (b * a ^ (i.val:ℤ)) * a ^ (j.val:ℤ)
      rw [mul_assoc, ← zpow_add]
      congr 1
      exact zpow_eq_zpow_of_modEq (by
        have h := zmod_val_intCast_add (m := m) i j
        simpa [hm] using h)
    | sr j =>
      rw [DihedralGroup.sr_mul_sr]
      show a ^ ((j - i).val : ℤ) = (b * a ^ (i.val:ℤ)) * (b * a ^ (j.val:ℤ))
      rw [← mul_assoc (b * a ^ (i.val:ℤ)) b (a ^ (j.val:ℤ)), conj_pow_eq hbb hab (i.val:ℤ),
        ← zpow_add]
      exact zpow_eq_zpow_of_modEq (by
        have h := zmod_val_intCast_sub (m := m) i j
        simpa [hm, sub_eq_add_neg, add_comm] using h)

lemma dihFin_injective {G : Type*} [Group G] {a b : G} {m : ℕ} [NeZero m] (hm : orderOf a = m)
    (hbb : b * b = 1) (hab : b * a * b = a⁻¹) (hbA : b ∉ Subgroup.zpowers a) :
    Function.Injective (dihFin a b m) := by
  intro x y hxy
  cases x with
  | r i =>
    cases y with
    | r j =>
      change a ^ (i.val:ℤ) = a ^ (j.val:ℤ) at hxy
      have hmod : (i.val : ℤ) ≡ (j.val : ℤ) [ZMOD (m:ℤ)] := by
        have h := (zpow_eq_zpow_iff_modEq (x := a)).mp hxy
        simpa [hm] using h
      rw [zmod_val_eq_of_cast_eq hmod]
    | sr j =>
      change a ^ (i.val:ℤ) = b * a ^ (j.val:ℤ) at hxy
      exfalso
      apply hbA
      have hb_eq : b = a ^ ((i.val:ℤ) - (j.val:ℤ)) := by
        have h : a ^ ((i.val:ℤ) - (j.val:ℤ)) = b := by
          rw [sub_eq_add_neg, zpow_add, zpow_neg, hxy, mul_assoc, mul_inv_cancel, mul_one]
        exact h.symm
      exact Subgroup.mem_zpowers_iff.mpr ⟨(i.val:ℤ) - (j.val:ℤ), hb_eq.symm⟩
  | sr i =>
    cases y with
    | r j =>
      change b * a ^ (i.val:ℤ) = a ^ (j.val:ℤ) at hxy
      exfalso
      apply hbA
      have hb_eq : b = a ^ ((j.val:ℤ) - (i.val:ℤ)) := by
        have h : a ^ ((j.val:ℤ) - (i.val:ℤ)) = b := by
          rw [sub_eq_add_neg, zpow_add, zpow_neg, ← hxy, mul_assoc, mul_inv_cancel, mul_one]
        exact h.symm
      exact Subgroup.mem_zpowers_iff.mpr ⟨(j.val:ℤ) - (i.val:ℤ), hb_eq.symm⟩
    | sr j =>
      change b * a ^ (i.val:ℤ) = b * a ^ (j.val:ℤ) at hxy
      have hmod : (i.val : ℤ) ≡ (j.val : ℤ) [ZMOD (m:ℤ)] := by
        have h : a ^ (i.val:ℤ) = a ^ (j.val:ℤ) := mul_left_cancel hxy
        have hh := (zpow_eq_zpow_iff_modEq (x := a)).mp h
        simpa [hm] using hh
      rw [zmod_val_eq_of_cast_eq hmod]

noncomputable def dihFinHom {G : Type*} [Group G] (a b : G) (m : ℕ) [NeZero m]
    (hm : orderOf a = m) (hbb : b * b = 1) (hab : b * a * b = a⁻¹) : DihedralGroup m →* G :=
  MonoidHom.mk' (dihFin a b m) (dihFin_mul hm hbb hab)

lemma dihFinHom_apply {G : Type*} [Group G] (a b : G) (m : ℕ) [NeZero m]
    (hm : orderOf a = m) (hbb : b * b = 1) (hab : b * a * b = a⁻¹) (x : DihedralGroup m) :
    dihFinHom a b m hm hbb hab x = dihFin a b m x := rfl

lemma dihFinHom_surjective {G : Type*} [Group G] {a b : G} {m : ℕ} [NeZero m]
    (hm : orderOf a = m) (hbb : b * b = 1) (hab : b * a * b = a⁻¹)
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) :
    Function.Surjective (dihFinHom a b m hm hbb hab) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← hgen, Subgroup.closure_le]
  intro x hx
  rw [SetLike.mem_coe, MonoidHom.mem_range]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with hxa | hxb
  · rw [hxa]
    refine ⟨DihedralGroup.r 1, ?_⟩
    rw [dihFinHom_apply]
    show a ^ ((1 : ZMod m).val : ℤ) = a
    by_cases hm1 : m = 1
    · have ha1 : a = 1 := orderOf_eq_one_iff.mp (hm.trans hm1)
      rw [ha1]; simp
    · rw [ZMod.val_one'' hm1]; simp
  · rw [hxb]
    refine ⟨DihedralGroup.sr 0, ?_⟩
    rw [dihFinHom_apply]
    show b * a ^ ((0 : ZMod m).val : ℤ) = b
    rw [ZMod.val_zero]; simp

/-! ## The infinite case: `DihedralGroup 0 ≃* G` -/

/-- The identity `ZMod 0 → ℤ`, used to index the infinite dihedral group by integers. -/
def zmod0ToInt : ZMod 0 → ℤ := fun i => i

lemma zmod0ToInt_add (i j : ZMod 0) :
    zmod0ToInt (i + j) = zmod0ToInt i + zmod0ToInt j := rfl

lemma zmod0ToInt_sub (i j : ZMod 0) :
    zmod0ToInt (j - i) = zmod0ToInt j - zmod0ToInt i := rfl

lemma zmod0ToInt_zero : zmod0ToInt 0 = 0 := rfl

lemma zmod0ToInt_one : zmod0ToInt 1 = 1 := rfl

lemma zmod0ToInt_injective : Function.Injective zmod0ToInt := fun _ _ h => h

/-- The underlying map `DihedralGroup 0 → G`, `r i ↦ a ^ i`, `sr i ↦ b * a ^ i`. -/
def dihInf {G : Type*} [Group G] (a b : G) : DihedralGroup 0 → G
  | DihedralGroup.r i => a ^ (zmod0ToInt i)
  | DihedralGroup.sr i => b * a ^ (zmod0ToInt i)

lemma dihInf_mul {G : Type*} [Group G] {a b : G} (hbb : b * b = 1) (hab : b * a * b = a⁻¹) :
    ∀ x y : DihedralGroup 0, dihInf a b (x * y) = dihInf a b x * dihInf a b y := by
  intro x y
  cases x with
  | r i =>
    cases y with
    | r j =>
      rw [DihedralGroup.r_mul_r]
      simp only [dihInf]
      rw [zmod0ToInt_add, zpow_add]
    | sr j =>
      rw [DihedralGroup.r_mul_sr]
      simp only [dihInf]
      rw [zmod0ToInt_sub, ← mul_assoc, pow_mul_b hbb hab (zmod0ToInt i), mul_assoc, ← zpow_add]
      rw [show zmod0ToInt j - zmod0ToInt i = -(zmod0ToInt i) + zmod0ToInt j by ring]
  | sr i =>
    cases y with
    | r j =>
      rw [DihedralGroup.sr_mul_r]
      simp only [dihInf]
      rw [zmod0ToInt_add, mul_assoc, ← zpow_add]
    | sr j =>
      rw [DihedralGroup.sr_mul_sr]
      simp only [dihInf]
      rw [zmod0ToInt_sub, ← mul_assoc (b * a ^ (zmod0ToInt i)) b (a ^ (zmod0ToInt j)),
        conj_pow_eq hbb hab (zmod0ToInt i), ← zpow_add]
      rw [show zmod0ToInt j - zmod0ToInt i = -(zmod0ToInt i) + zmod0ToInt j by ring]

lemma dihInf_injective {G : Type*} [Group G] {a b : G} (h0 : orderOf a = 0)
    (hbb : b * b = 1) (hab : b * a * b = a⁻¹) (hbA : b ∉ Subgroup.zpowers a) :
    Function.Injective (dihInf a b) := by
  intro x y hxy
  cases x with
  | r i =>
    cases y with
    | r j =>
      simp only [dihInf] at hxy
      have hmod := (zpow_eq_zpow_iff_modEq (x := a)).mp hxy
      have : zmod0ToInt i = zmod0ToInt j :=
        Int.modEq_zero_iff.mp (by simpa [h0] using hmod)
      rw [zmod0ToInt_injective this]
    | sr j =>
      simp only [dihInf] at hxy
      exfalso
      apply hbA
      have h : a ^ (zmod0ToInt i - zmod0ToInt j) = b := by
        rw [sub_eq_add_neg, zpow_add, zpow_neg, hxy, mul_assoc, mul_inv_cancel, mul_one]
      exact Subgroup.mem_zpowers_iff.mpr ⟨zmod0ToInt i - zmod0ToInt j, h⟩
  | sr i =>
    cases y with
    | r j =>
      simp only [dihInf] at hxy
      exfalso
      apply hbA
      have h : a ^ (zmod0ToInt j - zmod0ToInt i) = b := by
        rw [sub_eq_add_neg, zpow_add, zpow_neg, ← hxy, mul_assoc, mul_inv_cancel, mul_one]
      exact Subgroup.mem_zpowers_iff.mpr ⟨zmod0ToInt j - zmod0ToInt i, h⟩
    | sr j =>
      simp only [dihInf] at hxy
      have h : a ^ (zmod0ToInt i) = a ^ (zmod0ToInt j) := mul_left_cancel hxy
      have hmod := (zpow_eq_zpow_iff_modEq (x := a)).mp h
      have : zmod0ToInt i = zmod0ToInt j :=
        Int.modEq_zero_iff.mp (by simpa [h0] using hmod)
      rw [zmod0ToInt_injective this]

noncomputable def dihInfHom {G : Type*} [Group G] (a b : G) (hbb : b * b = 1)
    (hab : b * a * b = a⁻¹) : DihedralGroup 0 →* G :=
  MonoidHom.mk' (dihInf a b) (dihInf_mul hbb hab)

lemma dihInfHom_apply {G : Type*} [Group G] (a b : G) (hbb : b * b = 1)
    (hab : b * a * b = a⁻¹) (x : DihedralGroup 0) :
    dihInfHom a b hbb hab x = dihInf a b x := rfl

lemma dihInfHom_surjective {G : Type*} [Group G] {a b : G} (hbb : b * b = 1)
    (hab : b * a * b = a⁻¹) (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) :
    Function.Surjective (dihInfHom a b hbb hab) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← hgen, Subgroup.closure_le]
  intro x hx
  rw [SetLike.mem_coe, MonoidHom.mem_range]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with hxa | hxb
  · rw [hxa]
    refine ⟨DihedralGroup.r 1, ?_⟩
    rw [dihInfHom_apply]
    simp only [dihInf]
    rw [zmod0ToInt_one, zpow_one]
  · rw [hxb]
    refine ⟨DihedralGroup.sr 0, ?_⟩
    rw [dihInfHom_apply]
    simp only [dihInf]
    rw [zmod0ToInt_zero, zpow_zero, mul_one]

/-! ## The standard generators of `DihedralGroup n` -/

lemma r_mem_closure_r_one_sr_zero (n : ℕ) (i : ZMod n) :
    DihedralGroup.r i ∈
      Subgroup.closure ({(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} :
        Set (DihedralGroup n)) := by
  have hgen : (DihedralGroup.r 1 : DihedralGroup n) ∈
      Subgroup.closure ({(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} :
        Set (DihedralGroup n)) :=
    Subgroup.subset_closure (by rw [Set.mem_insert_iff]; exact Or.inl rfl)
  have hmem : DihedralGroup.r i ∈ Subgroup.zpowers (DihedralGroup.r 1 : DihedralGroup n) := by
    rcases eq_zero_or_neZero n with rfl | hn
    · exact Subgroup.mem_zpowers_iff.mpr ⟨i, DihedralGroup.r_one_zpow i⟩
    · haveI := hn
      exact Subgroup.mem_zpowers_iff.mpr
        ⟨(i.val : ℤ), by rw [zpow_natCast, DihedralGroup.r_one_pow, ZMod.natCast_zmod_val]⟩
  exact Subgroup.zpowers_le.mpr hgen hmem

lemma dihedral_closure_r_one_sr_zero (n : ℕ) :
    Subgroup.closure ({(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} :
      Set (DihedralGroup n)) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  cases x with
  | r i => exact r_mem_closure_r_one_sr_zero n i
  | sr i =>
      have h : DihedralGroup.sr i = DihedralGroup.sr (0 : ZMod n) * DihedralGroup.r i := by
        rw [DihedralGroup.sr_mul_r, zero_add]
      rw [h]
      exact Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
        (r_mem_closure_r_one_sr_zero n i)

/-! ## The general classification -/

/-- A group generated by two elements `a`, `b` with `b ^ 2 = 1` and `b * a * b = a⁻¹` is cyclic
or isomorphic to a dihedral group. -/
theorem isCyclic_or_dihedral_of_two_gens {G : Type*} [Group G] (a b : G)
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤)
    (hb : b ^ 2 = 1) (hab : b * a * b = a⁻¹) :
    IsCyclic G ∨ ∃ m : ℕ, Nonempty (G ≃* DihedralGroup m) := by
  have hbb : b * b = 1 := by simpa [pow_two] using hb
  by_cases hbA : b ∈ Subgroup.zpowers a
  · left
    rw [isCyclic_iff_exists_zpowers_eq_top]
    refine ⟨a, le_antisymm le_top ?_⟩
    rw [← hgen, Subgroup.closure_le]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with hxa | hxb
    · rw [hxa]; exact Subgroup.mem_zpowers a
    · rw [hxb]; exact hbA
  · by_cases ha1 : a = 1
    · left
      rw [isCyclic_iff_exists_zpowers_eq_top]
      refine ⟨b, ?_⟩
      rw [Subgroup.zpowers_eq_closure, ← hgen, ha1, Subgroup.closure_insert_one]
    · right
      rcases eq_zero_or_neZero (orderOf a) with h0 | hne
      · refine ⟨0, ?_⟩
        have hf : Function.Bijective (dihInfHom a b hbb hab) :=
          ⟨fun x y h => dihInf_injective h0 hbb hab hbA h,
           dihInfHom_surjective hbb hab hgen⟩
        exact ⟨(MulEquiv.ofBijective _ hf).symm⟩
      · haveI : NeZero (orderOf a) := hne
        refine ⟨orderOf a, ?_⟩
        have hf : Function.Bijective (dihFinHom a b (orderOf a) rfl hbb hab) :=
          ⟨fun x y h => dihFin_injective rfl hbb hab hbA h,
           dihFinHom_surjective rfl hbb hab hgen⟩
        exact ⟨(MulEquiv.ofBijective _ hf).symm⟩

/-! ## The target statement -/

/-- Every quotient of `DihedralGroup n` by a normal subgroup is cyclic or dihedral.  Raw group-theoretic input of the DSTR leaf `DS1`. -/
theorem dihedralQuotient : Work.GW2.DihedralQuotientProp := by
  intro n N hN
  haveI := hN
  set a : DihedralGroup n ⧸ N := (QuotientGroup.mk' N) (DihedralGroup.r 1) with ha
  set b : DihedralGroup n ⧸ N := (QuotientGroup.mk' N) (DihedralGroup.sr 0) with hbdef
  have hgen : Subgroup.closure ({a, b} : Set (DihedralGroup n ⧸ N)) = ⊤ := by
    have h1 := MonoidHom.map_closure (QuotientGroup.mk' N)
        ({(DihedralGroup.r 1 : DihedralGroup n), DihedralGroup.sr 0} : Set (DihedralGroup n))
    rw [dihedral_closure_r_one_sr_zero n,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N),
        Set.image_pair] at h1
    rw [ha, hbdef]
    exact h1.symm
  have hb : b ^ 2 = 1 := by
    rw [hbdef]
    rw [← MonoidHom.map_pow,
      show (DihedralGroup.sr (0 : ZMod n)) ^ 2 = 1 by rw [pow_two, DihedralGroup.sr_mul_self],
      MonoidHom.map_one]
  have hab : b * a * b = a⁻¹ := by
    rw [hbdef, ha]
    rw [← MonoidHom.map_mul, ← MonoidHom.map_mul, ← MonoidHom.map_inv]
    congr 1
    rw [DihedralGroup.sr_mul_r, zero_add, DihedralGroup.sr_mul_sr, DihedralGroup.inv_r, zero_sub]
  exact isCyclic_or_dihedral_of_two_gens a b hgen hb hab

end Work.DSTR
