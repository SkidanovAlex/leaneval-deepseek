/-! ## Elementary `O`-facts (local copies: the `GLUE`/`BMAX` versions cannot be imported next to
`Submission.Work.DSTR.Defs`) -/

/-- `O_p(G)` is a `p`-group. -/
private theorem pCore_isPGroup' {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime] :
    IsPGroup p ↥(Work.GW2.pCore p G) := by
  rw [Work.CORE2A.pCore_eq_opCore]
  exact OddOrder.Isaacs.Ch01.opCore_isPGroup p G

/-- **Universal property of `O_p(G)`**: every normal `p`-subgroup lies in `O_p(G)`.  `private`:
the public copy lives in `Submission/Work/DSTR/fittingPiIn_eq_iSup_pCoreIn_prime.lean` (imported
by BMAX/CORE3), and the two modules must be importable together. -/
private theorem le_pCore_of_normal_isPGroup' {G : Type} [Group G] {p : ℕ} {N : Subgroup G} [N.Normal]
    (hN : IsPGroup p N) : N ≤ Work.GW2.pCore p G :=
  Subgroup.normal_le_normalCore.mpr (le_sSup ⟨‹N.Normal›, hN⟩)

/-- A normal subgroup of odd order lies in `O(G)`. -/
private theorem le_oddCore_of_odd_normal' {G : Type} [Group G] {N : Subgroup G} [N.Normal]
    (hN : Odd (Nat.card N)) : N ≤ Work.GW2.oddCore G :=
  Subgroup.normal_le_normalCore.mpr (le_sSup ⟨‹N.Normal›, hN⟩)

/-- A `p`-group for an odd prime `p` has odd cardinality. -/
private theorem odd_card_of_isPGroup {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hp : p ≠ 2) {H : Subgroup G} (hH : IsPGroup p H) : Odd (Nat.card H) := by
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hH
  rw [hn]
  exact Odd.pow ((Fact.out : p.Prime).odd_of_ne_two hp)

/-- `O_p(G) ≤ O(G)` for a prime `p ≠ 2`. -/
private theorem pCore_le_oddCore' {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime] (hp : p ≠ 2) :
    Work.GW2.pCore p G ≤ Work.GW2.oddCore G :=
  le_oddCore_of_odd_normal' (odd_card_of_isPGroup hp (pCore_isPGroup' (G := G) (p := p)))

/-- **Transfer of the `p`-core along an inclusion.**  For `K ◁ X`, the image of `O_p(K)` in `X`
is a normal `p`-subgroup of `X`, hence lies in `O_p(X)`. -/
private theorem pCore_map_subtype_le {X : Type} [Group X] [Finite X] {K : Subgroup X} [K.Normal]
    {p : ℕ} [Fact p.Prime] :
    (Work.GW2.pCore p ↥K).map K.subtype ≤ Work.GW2.pCore p X := by
  haveI hchar : (Work.GW2.pCore p ↥K).Characteristic := by
    rw [Work.CORE2A.pCore_eq_opCore]
    exact OddOrder.Isaacs.Ch01.opCore.characteristic p ↥K
  haveI hnorm : ((Work.GW2.pCore p ↥K).map K.subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  exact le_pCore_of_normal_isPGroup' ((pCore_isPGroup' (G := ↥K) (p := p)).map K.subtype)

/-! ## Auxiliary lemmas on images of cyclic subgroups, centralizers and normalizers -/

/-- The image of a cyclic subgroup is the cyclic subgroup generated by the image. -/
theorem d110i_map_zpowers {G H : Type*} [Group G] [Group H] (f : G →* H) (g : G) :
    (Subgroup.zpowers g).map f = Subgroup.zpowers (f g) := by
  rw [Subgroup.zpowers_eq_closure, Subgroup.zpowers_eq_closure]
  refine le_antisymm ?_ ?_
  · rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact Subgroup.subset_closure (by simp)
  · rw [Subgroup.closure_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact Subgroup.mem_map_of_mem f (Subgroup.subset_closure (by simp))

/-- **The centralizer of an element is the centralizer of its cyclic subgroup.** -/
private theorem centralizer_zpowers_eq {G : Type*} [Group G] (g : G) :
    Subgroup.centralizer ({g} : Set G) = Subgroup.centralizer (↑(Subgroup.zpowers g) : Set G) := by
  rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]

/-- An element centralizing `f g` centralizes the image of the cyclic subgroup of `g`. -/
private theorem centralizer_le_centralizer_map_zpowers {G H : Type*} [Group G] [Group H] (f : G →* H)
    (g : G) : Subgroup.centralizer ({f g} : Set H) ≤
      Subgroup.centralizer (↑((Subgroup.zpowers g).map f) : Set H) := by
  rw [d110i_map_zpowers]
  exact le_of_eq (centralizer_zpowers_eq (f g))

/-- The image of a normalizer lies in the normalizer of the image. -/
private theorem map_normalizer_le {G H : Type*} [Group G] [Group H] (f : G →* H) (P : Subgroup G) :
    (Subgroup.normalizer (P : Set G)).map f ≤ Subgroup.normalizer (↑(P.map f) : Set H) := by
  rintro _ ⟨x, hx, rfl⟩
  have hx' : ∀ h : G, h ∈ P ↔ x * h * x⁻¹ ∈ P := Subgroup.mem_normalizer_iff.mp hx
  refine Subgroup.mem_normalizer_iff.mpr ?_
  intro h
  constructor
  · intro hh
    obtain ⟨y, hy, hyeq⟩ := Subgroup.mem_map.mp hh
    refine Subgroup.mem_map.mpr ⟨x * y * x⁻¹, (hx' y).mp hy, ?_⟩
    rw [map_mul, map_mul, map_inv, hyeq]
  · intro hh
    obtain ⟨y, hy, hyeq⟩ := Subgroup.mem_map.mp hh
    refine Subgroup.mem_map.mpr ⟨x⁻¹ * y * x, ?_, ?_⟩
    · exact (hx' (x⁻¹ * y * x)).mpr (by
        have hconj : x * (x⁻¹ * y * x) * x⁻¹ = y := by group
        rw [hconj]; exact hy)
    · rw [map_mul, map_mul, map_inv, hyeq]
      group

/-- **Centralizers of an involution pass to quotients by normal odd subgroups**: an element of
`X ⧸ Y` centralizing `tY` lies in the image of `C_X(t)`. -/
private theorem centralizer_quotient_le {X : Type} [Group X] [Finite X] {Y : Subgroup X} [Y.Normal]
    (hYodd : Odd (Nat.card Y)) {t : X} (ht : orderOf t = 2) :
    Subgroup.centralizer ({(QuotientGroup.mk' Y) t} : Set (X ⧸ Y)) ≤
      (Subgroup.centralizer ({t} : Set X)).map (QuotientGroup.mk' Y) := by
  have h2 : Nat.Coprime 2 (Nat.card Y) := Odd.coprime_two_left hYodd
  have hP2 : IsPGroup 2 ↥(Subgroup.zpowers t) :=
    IsPGroup.of_card (p := 2) (n := 1) (by rw [Nat.card_zpowers, ht, pow_one])
  have hstep : Subgroup.centralizer ({(QuotientGroup.mk' Y) t} : Set (X ⧸ Y)) ≤
      Subgroup.centralizer (↑((Subgroup.zpowers t).map (QuotientGroup.mk' Y)) : Set (X ⧸ Y)) := by
    rw [d110i_map_zpowers]
    exact le_of_eq (centralizer_zpowers_eq ((QuotientGroup.mk' Y) t))
  refine le_trans hstep ?_
  refine le_trans (Work.COPR.centralizer_map_le 2 (Subgroup.zpowers t) Y hP2 h2) ?_
  refine Subgroup.map_mono ?_
  exact Subgroup.centralizer_le (by
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact Subgroup.mem_zpowers t)

/-! ## The cross-characteristic step (Bender 1970, 2.4 / 1981 1.10(i)) -/

/-- **The reduced coprime core statement** (Bender 1970, 2.4): `K ◁ X` of odd order, `t` an
involution, `P ≤ X` a `p`-subgroup (`p` odd) normalized by `C_X(t)`, `[P,t] ⊆ K`, and
`O_p(K) = 1`; then `[P,t] = 1`. -/
abbrev CoreOddReducedProp : Prop :=
  ∀ {X : Type} [Group X] [Finite X] {K : Subgroup X} [K.Normal], Odd (Nat.card K) →
    Group.IsSolvable ↥K → ∀ {t : X}, orderOf t = 2 → ∀ {p : ℕ} [Fact p.Prime], p ≠ 2 →
    ∀ {P : Subgroup X}, IsPGroup p P →
    Subgroup.centralizer ({t} : Set X) ≤ Subgroup.normalizer (P : Set X) →
    ⁅P, Subgroup.zpowers t⁆ ≤ K → Work.GW2.pCore p ↥K = ⊥ → ⁅P, Subgroup.zpowers t⁆ = ⊥

/-- **DS9b from the reduced coprime core statement.**  If `O_p(X) = 1` apply the reduced
statement with `K = O(X)`; otherwise pass to `X/O_p(X)`, where `O_p` is trivial (and hence so is
`O_p` of the odd core), and apply the reduced statement there. -/
theorem d110iOdd_of_coreOddReduced (hred : CoreOddReducedProp) : Work.GW2.D110iOddProp := by
  intro X _ _ hFT _ _ t ht p _ hp P hP hN hO
  have hpodd : Odd p := (Fact.out : p.Prime).odd_of_ne_two hp
  have ht2 : t ^ 2 = 1 := by
    have h := pow_orderOf_eq_one t
    rwa [ht] at h
  have hKodd : Odd (Nat.card (Work.GW2.oddCore X)) := Work.ASM.oddCore_odd X
  have hKsol : Group.IsSolvable ↥(Work.GW2.oddCore X) := hFT _ hKodd
  by_cases hcore : Work.GW2.pCore p X = ⊥
  · -- `O_p(X) = 1`: apply the reduced statement with `K = O(X)`
    have hcoreK : Work.GW2.pCore p ↥(Work.GW2.oddCore X) = ⊥ := by
      rw [Subgroup.eq_bot_iff_forall]
      intro x hx
      have hmem : (Work.GW2.oddCore X).subtype x ∈ Work.GW2.pCore p X :=
        pCore_map_subtype_le (K := Work.GW2.oddCore X) (p := p)
          (Subgroup.mem_map_of_mem (Work.GW2.oddCore X).subtype hx)
      rw [hcore, Subgroup.mem_bot] at hmem
      exact Subtype.coe_injective (by simpa using hmem)
    have hQ := hred (K := Work.GW2.oddCore X) hKodd hKsol ht hp hP hN hO hcoreK
    rw [hQ]
    exact bot_le
  · -- pass to `X ⧸ O_p(X)` (using the isolated odd-order library's `opCore`)
    have hYpg : IsPGroup p ↥(OddOrder.Isaacs.Ch01.opCore p X) :=
      OddOrder.Isaacs.Ch01.opCore_isPGroup p X
    have hYodd : Odd (Nat.card ↥(OddOrder.Isaacs.Ch01.opCore p X)) :=
      odd_card_of_isPGroup hp hYpg
    set π : X →* X ⧸ OddOrder.Isaacs.Ch01.opCore p X :=
      QuotientGroup.mk' (OddOrder.Isaacs.Ch01.opCore p X) with hπ
    have hπsurj : Function.Surjective π := QuotientGroup.mk'_surjective _
    -- `π t` is an involution
    have htne : π t ≠ 1 := by
      intro hcon
      have htY : t ∈ OddOrder.Isaacs.Ch01.opCore p X := by
        rw [hπ] at hcon
        exact (QuotientGroup.eq_one_iff t).mp hcon
      have hdvd : 2 ∣ Nat.card ↥(OddOrder.Isaacs.Ch01.opCore p X) := by
        have hsub : Subgroup.zpowers t ≤ OddOrder.Isaacs.Ch01.opCore p X :=
          Subgroup.zpowers_le.mpr htY
        have hcard : Nat.card ↥(Subgroup.zpowers t) = 2 := by rw [Nat.card_zpowers, ht]
        rw [← hcard]
        exact Subgroup.card_dvd_of_le hsub
      exact (Nat.not_even_iff_odd.mpr hYodd) (even_iff_two_dvd.mpr hdvd)
    have htb : orderOf (π t) = 2 :=
      orderOf_eq_prime (by rw [← map_pow, ht2, map_one]) htne
    -- the hypotheses carry over to the quotient
    have hPb : IsPGroup p ↥(P.map π) := hP.map π
    have hNb : Subgroup.centralizer ({π t} : Set (X ⧸ OddOrder.Isaacs.Ch01.opCore p X)) ≤
        Subgroup.normalizer ((P.map π : Subgroup (X ⧸ OddOrder.Isaacs.Ch01.opCore p X)) :
          Set (X ⧸ OddOrder.Isaacs.Ch01.opCore p X)) := by
      haveI : (OddOrder.Isaacs.Ch01.opCore p X).Normal :=
        OddOrder.Isaacs.Ch01.opCore.normal p X
      refine le_trans (centralizer_quotient_le (Y := OddOrder.Isaacs.Ch01.opCore p X) hYodd ht) ?_
      refine le_trans (Subgroup.map_mono hN) ?_
      exact map_normalizer_le π P
    have hcomm : ⁅P.map π, Subgroup.zpowers (π t)⁆ = (⁅P, Subgroup.zpowers t⁆).map π := by
      rw [← d110i_map_zpowers π t, ← Subgroup.map_commutator]
    have hOb : ⁅P.map π, Subgroup.zpowers (π t)⁆ ≤
        Work.GW2.oddCore (X ⧸ OddOrder.Isaacs.Ch01.opCore p X) := by
      rw [hcomm]
      haveI hImnorm : ((Work.GW2.oddCore X).map π).Normal :=
        (Work.GW2.oddCore_normal X).map π hπsurj
      have hImodd : Odd (Nat.card ↥((Work.GW2.oddCore X).map π)) :=
        hKodd.of_dvd_nat (Subgroup.card_map_dvd (Work.GW2.oddCore X) π)
      exact le_trans (Subgroup.map_mono hO) (le_oddCore_of_odd_normal' hImodd)
    -- `O_p` of the quotient, and of the odd core of the quotient, are trivial
    have hcoreX' : Work.GW2.pCore p (X ⧸ OddOrder.Isaacs.Ch01.opCore p X) = ⊥ := by
      rw [Work.CORE2A.pCore_eq_opCore]
      exact OddOrder.Isaacs.Ch04.opCore_quotient_opCore_eq_bot p
    have hcoreK' : Work.GW2.pCore p
        ↥(Work.GW2.oddCore (X ⧸ OddOrder.Isaacs.Ch01.opCore p X)) = ⊥ := by
      rw [Subgroup.eq_bot_iff_forall]
      intro x hx
      have hmem : (Work.GW2.oddCore (X ⧸ OddOrder.Isaacs.Ch01.opCore p X)).subtype x ∈
          Work.GW2.pCore p (X ⧸ OddOrder.Isaacs.Ch01.opCore p X) :=
        pCore_map_subtype_le
          (K := Work.GW2.oddCore (X ⧸ OddOrder.Isaacs.Ch01.opCore p X)) (p := p)
          (Subgroup.mem_map_of_mem _ hx)
      rw [hcoreX', Subgroup.mem_bot] at hmem
      exact Subtype.coe_injective (by simpa using hmem)
    have hK'odd : Odd (Nat.card ↥(Work.GW2.oddCore (X ⧸ OddOrder.Isaacs.Ch01.opCore p X))) :=
      Work.ASM.oddCore_odd _
    have hQ' : ⁅P.map π, Subgroup.zpowers (π t)⁆ = ⊥ :=
      hred (K := Work.GW2.oddCore (X ⧸ OddOrder.Isaacs.Ch01.opCore p X))
        hK'odd (hFT _ hK'odd) htb hp hPb hNb hOb hcoreK'
    -- hence `[P,t]` lies in `O_p(X)`
    have hmap : (⁅P, Subgroup.zpowers t⁆).map π = ⊥ := by rw [← hcomm, hQ']
    have hker : π.ker = OddOrder.Isaacs.Ch01.opCore p X := by
      rw [hπ]; exact QuotientGroup.ker_mk' _
    have hQle : ⁅P, Subgroup.zpowers t⁆ ≤ OddOrder.Isaacs.Ch01.opCore p X :=
      (Subgroup.map_eq_bot_iff _).mp hmap |>.trans (le_of_eq hker)
    rwa [Work.CORE2A.pCore_eq_opCore]

/-- **DS9b** (`Work.GW2.D110iOddProp`, Bender 1981 1.10(i), the case `[P,t] subset O(X)`, which is Bender 1970, 2.4): `X` a D-group, `t` an involution, `P` an odd `p`-subgroup normalized by `C_X(t)`, and `[P,t] <= O(X)`; then `[P,t] <= O_p(X)`.  The three `Coprime*` inputs are the parts of Bender 1.1/1.3/1.5 used in the reduction. -/
theorem d110iOdd (h11i : Work.GW2.Coprime11iProp) (h11iv : Work.GW2.Coprime11ivProp)
    (h13 : Work.GW2.Coprime13Prop) (h15 : Work.GW2.Coprime15Prop) : Work.GW2.D110iOddProp :=
  d110iOdd_of_coreOddReduced Work.DSTR.coreOddReduced

end Work.DSTR
