   content unchanged except this header and import paths. Namespace `GW2` (root). -/
import Mathlib

/-!
# gorenstein_walter, blueprint 2: area contracts

Route: Bender 1981 (J. Algebra 70, 216–228) plus Bender–Glauberman 1981 (J. Algebra 70, 200–215).
Feit–Thompson is consumed as `FeitThompsonProp` and discharged by `OddOrder.feitThompson`
(see `FTBridge.lean`).

Design file `Submission/Work/NOTES_LEAD_gw_blueprint2.md` gives the area list, dependencies and sizes.

* This file imports Mathlib only, so it elaborates without the FT build.
* The bridges to the FT-closure vocabulary are the GLUE area's job: `Isaacs.Ch01.fitting`, `opCore`,
  `Subgroup.IsPStableOp`, `thompsonJAbelian`.

Conventions:
* Subgroups of an ambient `G` are used throughout. `…In K` is the corresponding subgroup of
  `↥K`, mapped into `G`.
* Every area theorem is stated as `inputs (other areas' Props) → own Prop`.
  An area never assumes its own deliverable.
-/

open scoped MatrixGroups

namespace GW2

open Subgroup

/-! ## 0. Vocabulary -/

section Vocabulary

variable {G : Type*} [Group G]

/-- `O(G) = O_{2'}(G)`: the largest normal subgroup of odd order. The `normalCore` wrapper is
the identity (the sSup is normal); it only makes normality an instance. -/
def oddCore (G : Type*) [Group G] : Subgroup G :=
  (sSup {N : Subgroup G | N.Normal ∧ Odd (Nat.card N)}).normalCore

instance oddCore_normal (G : Type*) [Group G] : (oddCore G).Normal :=
  Subgroup.normalCore_normal _

/-- `O_p(G)`. -/
def pCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  (sSup {N : Subgroup G | N.Normal ∧ IsPGroup p N}).normalCore

instance pCore_normal (p : ℕ) (G : Type*) [Group G] : (pCore p G).Normal :=
  Subgroup.normalCore_normal _

/-- `O_π(G)` for a set of primes `π`. -/
def piCore (π : Set ℕ) (G : Type*) [Group G] : Subgroup G :=
  (sSup {N : Subgroup G | N.Normal ∧ ∀ q ∈ (Nat.card N).primeFactors, q ∈ π}).normalCore

/-- The Fitting subgroup `F(G)`. -/
def fitting (G : Type*) [Group G] : Subgroup G :=
  (sSup {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}).normalCore

/-- `F_π(G) = O_π(F(G))`. -/
def fittingPi (π : Set ℕ) (G : Type*) [Group G] : Subgroup G :=
  (piCore π (fitting G)).map (fitting G).subtype

/-- `O^2(G)`: the subgroup generated by the elements of odd order. -/
def twoResidual (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {g : G | Odd (orderOf g)}

/-- Quasisimple: perfect, with simple central quotient (so nontrivial). -/
def IsQuasisimple (E : Subgroup G) : Prop :=
  ⁅E, E⁆ = E ∧ IsSimpleGroup (↥E ⧸ center ↥E)

/-- `E(G)` in Bender's sense (1.6): the join of the normal quasisimple subgroups. For a D-group
there is at most one (`LayerProp`). -/
def layer (G : Type*) [Group G] : Subgroup G :=
  sSup {E : Subgroup G | E.Normal ∧ IsQuasisimple E}

/-- `F*(G) = F(G) E(G)`. -/
def fstar (G : Type*) [Group G] : Subgroup G := fitting G ⊔ layer G

/-- Relative versions, for a subgroup `K` of `G`. -/
def oddCoreIn (K : Subgroup G) : Subgroup G := (oddCore K).map K.subtype
def pCoreIn (p : ℕ) (K : Subgroup G) : Subgroup G := (pCore p K).map K.subtype
def fittingIn (K : Subgroup G) : Subgroup G := (fitting K).map K.subtype
def fittingPiIn (π : Set ℕ) (K : Subgroup G) : Subgroup G := (fittingPi π K).map K.subtype
def layerIn (K : Subgroup G) : Subgroup G := (layer K).map K.subtype
def fstarIn (K : Subgroup G) : Subgroup G := (fstar K).map K.subtype
def twoResidualIn (K : Subgroup G) : Subgroup G := (twoResidual K).map K.subtype

/-- `I_K(s) = {x ∈ K | x^s = x⁻¹}`. -/
def invSet (K : Subgroup G) (s : G) : Set G := {x | x ∈ K ∧ s * x * s⁻¹ = x⁻¹}

/-- `I ≤ K` is a Hall subgroup of `K`. -/
def IsHallIn (I K : Subgroup G) : Prop := I ≤ K ∧ Nat.Coprime (Nat.card I) (I.relIndex K)

/-- The set of primes dividing `|K|`. -/
def primesOf (K : Subgroup G) : Set ℕ := {p | p ∈ (Nat.card K).primeFactors}

/-- Bender's relation `A ⇝ B`, read off the page image of p. 219: `N_{F*(A)}(X) ⊆ B` for some
`X ⊆ F(A)`. -/
def BRel (A B : Subgroup G) : Prop :=
  ∃ X : Subgroup G, X ≤ fittingIn A ∧ normalizer (X : Set G) ⊓ fstarIn A ≤ B

/-- Klein four-group (type (2,2)). -/
def IsFourGroup (V : Subgroup G) : Prop := Nat.card V = 4 ∧ ∀ v ∈ V, v ^ 2 = 1

/-- Thompson subgroup `J(P)`: the join of the abelian subgroups of `P` of maximal order. -/
noncomputable def thompsonJ (P : Subgroup G) : Subgroup G :=
  sSup {A : Subgroup G | A ≤ P ∧ IsMulCommutative A ∧
    ∀ B : Subgroup G, B ≤ P → IsMulCommutative B → Nat.card B ≤ Nat.card A}

/-- `Z(J(P))`. -/
noncomputable def ZJ (P : Subgroup G) : Subgroup G :=
  thompsonJ P ⊓ centralizer (thompsonJ P : Set G)

/-- Group-theoretic `p`-stability, in the shape of `Subgroup.IsPStableOp` of the FT closure
(`GroupTheory/GlaubermanZJ.lean`); GLUE proves the two agree. -/
def IsPStable' (p : ℕ) (X : Type*) [Group X] : Prop :=
  ∀ (K A : Subgroup X) (_ : K.Normal), IsPGroup p K → IsPGroup p A → ⁅⁅K, A⁆, A⁆ = ⊥ →
    A.map (QuotientGroup.mk' (centralizer (K : Set X))) ≤
      pCore p (X ⧸ centralizer (K : Set X))

/-- `B F` with `F` normal, `B ∩ F = 1`, and `B` acting fixed-point-freely on `F`
(a Frobenius group with kernel `F` and complement `B`). -/
def IsFrobeniusWith (BF F B : Subgroup G) : Prop :=
  F ≤ BF ∧ (F.subgroupOf BF).Normal ∧ B ⊔ F = BF ∧ B ⊓ F = ⊥ ∧ F ≠ ⊥ ∧ B ≠ ⊥ ∧
    ∀ b ∈ B, b ≠ 1 → F ⊓ centralizer ({b} : Set G) = ⊥

/-- `U = A × C` (internal direct product). -/
def IsInternalDirect (U A C : Subgroup G) : Prop :=
  A ⊔ C = U ∧ A ⊓ C = ⊥ ∧ ∀ a ∈ A, ∀ c ∈ C, a * c = c * a

/-- `K` is the largest odd-order subgroup of `H` inverted by `s` (BG notation `K_i`). -/
def IsMaxInverted (H : Subgroup G) (s : G) (K : Subgroup G) : Prop :=
  K ≤ H ∧ Odd (Nat.card K) ∧ (∀ x ∈ K, s * x * s⁻¹ = x⁻¹) ∧
    ∀ X : Subgroup G, X ≤ H → Odd (Nat.card X) → (∀ x ∈ X, s * x * s⁻¹ = x⁻¹) → X ≤ K

end Vocabulary

/-! ## 1. D-groups and the global statements -/

/-- Sylow 2-subgroups are cyclic or dihedral. `DihedralGroup 2` is the Klein four-group. -/
def DihOrCycSylow (G : Type*) [Group G] [Finite G] : Prop :=
  ∀ P : Sylow 2 G, IsCyclic P ∨ ∃ n : ℕ, Nonempty ((P : Subgroup G) ≃* DihedralGroup n)

/-- The four shapes of `G/O(G)` for a D-group.
* The Klein clause is Bender 1.6(c) and covers `q = 3`: `A₄ ≅ L₂(3)`, `S₄ ≅ PGL₂(3)`.
* The last clause requires `q ≥ 5`. -/
def DShape (Q : Type*) [Group Q] [Finite Q] : Prop :=
  IsPGroup 2 Q ∨
  (∃ V : Subgroup Q, V.Normal ∧ IsFourGroup V ∧ centralizer (V : Set Q) = V) ∨
  Nonempty (Q ≃* alternatingGroup (Fin 7)) ∨
  ∃ L : Subgroup Q, L.Normal ∧ Odd L.index ∧ ∃ p k : ℕ, ∃ _ : Fact p.Prime, Odd p ∧ 5 ≤ p ^ k ∧
    (Nonempty (L ≃* PSL(2, GaloisField p k)) ∨ Nonempty (L ≃* PGL(2, GaloisField p k)))

/-- Bender's D-group. -/
def IsDGroup (G : Type*) [Group G] [Finite G] : Prop := DShape (G ⧸ oddCore G)

/-- The challenge conclusion, verbatim. -/
def GWConclusion (G : Type*) [Group G] : Prop :=
  Nonempty (G ≃* alternatingGroup (Fin 7)) ∨
    ∃ p k : ℕ, ∃ _hp : Fact p.Prime, Odd p ∧ 5 ≤ p ^ k ∧
      Nonempty (G ≃* PSL(2, GaloisField p k))

/-- The odd order theorem (eval form). It is discharged by `OddOrder.feitThompson`. -/
def FeitThompsonProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Odd (Nat.card G) → Group.IsSolvable G

/-- The full Gorenstein–Walter theorem (Bender's form). -/
def DGroupTheoremProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], DihOrCycSylow G → IsDGroup G

/-- The induction premise: every strictly smaller group of the class is a D-group. -/
def SmallerDGroups (G : Type) [Group G] [Finite G] : Prop :=
  ∀ (X : Type) [Group X] [Finite X], Nat.card X < Nat.card G → DihOrCycSylow X → IsDGroup X

/-- Inductive step for non-simple (or abelian simple) `G`. Replaces GW Prop. 9. -/
def NonSimpleStepProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], DihOrCycSylow G → SmallerDGroups G →
    ¬ (IsSimpleGroup G ∧ ∃ a b : G, a * b ≠ b * a) → IsDGroup G

/-- Inductive step for non-abelian simple `G`: Bender 1981 §§2–4. -/
def SimpleStepProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G → (∃ a b : G, a * b ≠ b * a) →
    DihOrCycSylow G → SmallerDGroups G → GWConclusion G

/-! ## 2. Bender's minimal-counterexample context -/

/-- A non-abelian simple counterexample whose smaller relatives are D-groups. -/
structure BenderCtx (G : Type) [Group G] [Finite G] : Prop where
  simple : IsSimpleGroup G
  nonab : ∃ a b : G, a * b ≠ b * a
  sylow : DihOrCycSylow G
  ih : SmallerDGroups G
  notA7 : IsEmpty (G ≃* alternatingGroup (Fin 7))
  notPSL : ∀ (p k : ℕ) (_ : Fact p.Prime), Odd p → 5 ≤ p ^ k →
    IsEmpty (G ≃* PSL(2, GaloisField p k))

/-- Bender's fixed notation (p. 219): `S`, `S₀`, `t`, `Ĥ`. Then `H = C(t)` and `U = O(H)`. -/
structure BenderSetup (G : Type) [Group G] [Finite G] where
  S : Sylow 2 G
  S0 : Subgroup G
  t : G
  Hhat : Subgroup G
  S0_le : S0 ≤ (S : Subgroup G)
  S0_cyclic : IsCyclic S0
  S0_index : S0.relIndex (S : Subgroup G) = 2
  t_mem : t ∈ S0
  t_order : orderOf t = 2
  Hhat_coatom : IsCoatom Hhat
  H_le_Hhat : centralizer ({t} : Set G) ≤ Hhat

namespace BenderSetup
variable {G : Type} [Group G] [Finite G] (B : BenderSetup G)
/-- `H = C_G(t)`. -/
abbrev H : Subgroup G := centralizer ({B.t} : Set G)
/-- `U = O(H)`. -/
abbrev U : Subgroup G := oddCoreIn B.H
/-- `π = π(F(Ĥ))` (named `pi`). -/
abbrev pi : Set ℕ := primesOf (fittingIn B.Hhat)
end BenderSetup

/-- Case (1) of Theorem 2.10. -/
def Case1 {G : Type} [Group G] [Finite G] (B : BenderSetup G) : Prop :=
  (∀ s ∈ (B.S : Subgroup G), s ∉ B.S0 →
      ∃ I : Subgroup G, (I : Set G) = invSet B.U s ∧ IsHallIn I (fittingIn B.U)) ∧
    ∀ X : Subgroup G, X ≠ ⊥ → X ≤ fittingIn B.U → normalizer (X : Set G) ≤ B.Hhat

/-- Case (2) of Theorem 2.10. -/
def Case2 {G : Type} [Group G] [Finite G] (B : BenderSetup G) : Prop :=
  ∃ M : Subgroup G, IsCoatom M ∧ B.t ∈ layerIn M ∧
    ∃ X : Subgroup G, X ≠ ⊥ ∧ X ≤ fittingIn B.U ∧ normalizer (X : Set G) ≤ M

/-! ## 3. Area deliverables (Props) -/

/-! ### FUS: dihedral fusion (Gorenstein 7.7) -/

/-- Gorenstein 7.7.3 and Bender 1.6 (last sentence). If `S` is dihedral of order `≥ 4` and `G` has
no normal subgroup of index 2, then all involutions are conjugate and `N(V)` is transitive on
`V#` for every four-group `V`. -/
def InvolutionFusionProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (S : Sylow 2 G) (n : ℕ), 2 ≤ n →
    Nonempty ((S : Subgroup G) ≃* DihedralGroup n) →
    (∀ N : Subgroup G, N.Normal → N.index ≠ 2) →
    (∀ x y : G, orderOf x = 2 → orderOf y = 2 → IsConj x y) ∧
    ∀ V : Subgroup G, IsFourGroup V → ∀ x ∈ V, ∀ y ∈ V, x ≠ 1 → y ≠ 1 →
      ∃ g ∈ normalizer (V : Set G), g * x * g⁻¹ = y

/-- `C(t) = O(C(t)) S` for `t ∈ Z(S)` an involution and `S` dihedral of order `≥ 4`.
This is "H is SU", via the Frobenius normal p-complement theorem. -/
def CentralizerSplitProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (S : Sylow 2 G) (n : ℕ), 2 ≤ n →
    Nonempty ((S : Subgroup G) ≃* DihedralGroup n) →
    ∀ t ∈ (S : Subgroup G), orderOf t = 2 → (∀ x ∈ (S : Subgroup G), x * t = t * x) →
      oddCoreIn (centralizer ({t} : Set G)) ⊔ (S : Subgroup G) = centralizer ({t} : Set G)

/-! ### COPR: Bender 1.1, 1.3, 1.5 (coprime action; FT-free since `P` is a `p`-group) -/

def Coprime11iProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) [Fact p.Prime] (P K : Subgroup G),
    IsPGroup p P → Nat.Coprime p (Nat.card K) → P ≤ normalizer (K : Set G) →
    ⁅P, ⁅P, K⁆⁆ = ⁅P, K⁆ ∧ ⁅P, K⁆ ⊔ (K ⊓ centralizer (P : Set G)) = K

/-- 1.1(ii) in Glauberman-lemma form. -/
def Coprime11iiProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) [Fact p.Prime] (P K : Subgroup G),
    IsPGroup p P → Nat.Coprime p (Nat.card K) → P ≤ normalizer (K : Set G) →
    ∀ (q : ℕ) [Fact q.Prime] (Q : Subgroup G), Q ≤ K → IsPGroup q Q →
      P ≤ normalizer (Q : Set G) →
      (∃ R : Subgroup G, Q ≤ R ∧ R ≤ K ∧ P ≤ normalizer (R : Set G) ∧ IsPGroup q R ∧
          ¬ q ∣ R.relIndex K) ∧
      ∀ R₁ R₂ : Subgroup G, R₁ ≤ K → R₂ ≤ K → IsPGroup q R₁ → IsPGroup q R₂ →
        ¬ q ∣ R₁.relIndex K → ¬ q ∣ R₂.relIndex K →
        P ≤ normalizer (R₁ : Set G) → P ≤ normalizer (R₂ : Set G) →
        ∃ c ∈ K ⊓ centralizer (P : Set G), R₂ = R₁.map (MulAut.conj c).toMonoidHom

/-- 1.1(iii). "P not cyclic, not quaternion" is replaced by the sufficient condition that
`P` contains an elementary abelian `p²`. -/
def Coprime11iiiProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) [Fact p.Prime] (P K E : Subgroup G),
    IsPGroup p P → Nat.Coprime p (Nat.card K) → P ≤ normalizer (K : Set G) →
    E ≤ P → Nat.card E = p ^ 2 → (∀ x ∈ E, x ^ p = 1) → IsMulCommutative E →
    K = ⨆ (a : G) (_ : a ∈ E) (_ : a ≠ 1), K ⊓ centralizer ({a} : Set G)

def Coprime11ivProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) [Fact p.Prime] (P K K0 : Subgroup G),
    IsPGroup p P → Nat.Coprime p (Nat.card K) → P ≤ normalizer (K : Set G) →
    K0 ≤ K → (K0.subgroupOf K).Normal → P ≤ centralizer (K0 : Set G) →
    K ⊓ centralizer (K0 : Set G) ≤ K0 → P ≤ centralizer (K : Set G)

/-- 1.3. Centralizers and normalizers of a `p`-subgroup pass to `X/Y` for normal `p'`-subgroups
`Y`. -/
def Coprime13Prop : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (p : ℕ) [Fact p.Prime] (P Y : Subgroup X) [Y.Normal],
    IsPGroup p P → Nat.Coprime p (Nat.card Y) →
    centralizer ((P.map (QuotientGroup.mk' Y) : Subgroup (X ⧸ Y)) : Set (X ⧸ Y)) =
        (centralizer (P : Set X)).map (QuotientGroup.mk' Y) ∧
    normalizer ((P.map (QuotientGroup.mk' Y) : Subgroup (X ⧸ Y)) : Set (X ⧸ Y)) =
        (normalizer (P : Set X)).map (QuotientGroup.mk' Y)

/-- 1.5 (i)–(iii). The "lies in `F(X)`" part of (iii) is stated as a subgroup of the ambient group.
Odd order of `X` makes `X` solvable only via FT, hence `hFT`. -/
def Coprime15Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → ∀ (X : Subgroup G) (s : G),
    orderOf s = 2 → Odd (Nat.card X) → s ∈ normalizer (X : Set G) →
    invSet X s = {y | ∃ x ∈ X, y = x⁻¹ * (s * x * s⁻¹)} ∧
    (invSet X s).ncard * Nat.card (X ⊓ centralizer ({s} : Set G) : Subgroup G) = Nat.card X ∧
    ∀ I : Subgroup G, (I : Set G) = invSet X s →
      IsMulCommutative I ∧ (I.subgroupOf X).Normal ∧ I ≤ fittingIn X

/-! ### DSTR: D-group structure (Bender 1.6, 1.9, 1.10) -/

/-- Bender 1.6, the four cases. -/
def D16Prop : Prop :=
  ∀ (X : Type) [Group X] [Finite X], FeitThompsonProp → DihOrCycSylow X → IsDGroup X →
    (centralizer (fittingPi {2}ᶜ X : Set X) ≤ fittingPi {2}ᶜ X) ∨
    (∃ z ∈ center X, orderOf z = 2) ∨
    (IsFourGroup (pCore 2 X) ∧
      ((IsCyclic (X ⧸ (pCore 2 X ⊔ oddCore X)) ∧ Nat.card (X ⧸ (pCore 2 X ⊔ oddCore X)) = 3) ∨
        Nonempty ((X ⧸ (pCore 2 X ⊔ oddCore X)) ≃* DihedralGroup 3))) ∨
    (∃ (E : Subgroup X) (_ : E.Normal), IsQuasisimple E ∧ Group.IsSolvable (X ⧸ E))

/-- `E(X)` is the unique normal quasisimple subgroup. `Z(E)` is odd, and `E/Z(E)` is `A₇` or
`L₂(q)` with `q ≥ 5`. -/
def LayerProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X], FeitThompsonProp → DihOrCycSylow X → IsDGroup X →
    ∀ E : Subgroup X, E.Normal → IsQuasisimple E →
      layer X = E ∧ Odd (Nat.card (center E)) ∧
      (Nonempty ((↥E ⧸ center ↥E) ≃* alternatingGroup (Fin 7)) ∨
        ∃ p k : ℕ, ∃ _ : Fact p.Prime, Odd p ∧ 5 ≤ p ^ k ∧
          Nonempty ((↥E ⧸ center ↥E) ≃* PSL(2, GaloisField p k)))

/-- Bender 1.9: `Z(E) = 1` when `E/Z(E) ≅ L₂(q)` and `Z(E)` is odd and prime to `q`. -/
def L19Prop : Prop :=
  ∀ (E : Type) [Group E] [Finite E] (p k : ℕ) [Fact p.Prime], Odd p → 5 ≤ p ^ k →
    ⁅(⊤ : Subgroup E), (⊤ : Subgroup E)⁆ = ⊤ → Nonempty ((E ⧸ center E) ≃* PSL(2, GaloisField p k)) →
    Odd (Nat.card (center E)) → Nat.Coprime (Nat.card (center E)) p → center E = ⊥

/-- Bender 1.10(i). -/
def D110iProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X], FeitThompsonProp → DihOrCycSylow X → IsDGroup X →
    ∀ t : X, orderOf t = 2 → ∀ (p : ℕ) [Fact p.Prime], p ≠ 2 → ∀ P : Subgroup X, IsPGroup p P →
      centralizer ({t} : Set X) ≤ normalizer (P : Set X) → ⁅P, zpowers t⁆ ≤ pCore p X

/-- Bender 1.10(ii): `F_{2'}(C(t))` induces inner automorphisms on `E(X)`. -/
def D110iiProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X], FeitThompsonProp → DihOrCycSylow X → IsDGroup X →
    ∀ t : X, orderOf t = 2 → ∀ x ∈ fittingPiIn {2}ᶜ (centralizer ({t} : Set X)),
      ∃ e ∈ layer X, ∀ y ∈ layer X, x * y * x⁻¹ = e * y * e⁻¹

/-- `C(F*(X)) ≤ F*(X)` for D-groups. -/
def FStarProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X], FeitThompsonProp → DihOrCycSylow X → IsDGroup X →
    centralizer (fstar X : Set X) ≤ fstar X

/-! ### AUTL2 / AUTA7: almost-simple overgroups with dihedral Sylow 2-subgroups -/

def AutL2Prop : Prop :=
  ∀ (Q : Type) [Group Q] [Finite Q] (L : Subgroup Q) (p k : ℕ) [Fact p.Prime], Odd p → 5 ≤ p ^ k →
    L.Normal → Nonempty (L ≃* PSL(2, GaloisField p k)) → centralizer (L : Set Q) = ⊥ →
    DihOrCycSylow Q →
    ∃ M : Subgroup Q, M.Normal ∧ L ≤ M ∧ Odd M.index ∧
      (Nonempty (M ≃* PSL(2, GaloisField p k)) ∨ Nonempty (M ≃* PGL(2, GaloisField p k)))

def AutA7Prop : Prop :=
  ∀ (Q : Type) [Group Q] [Finite Q] (L : Subgroup Q), L.Normal →
    Nonempty (L ≃* alternatingGroup (Fin 7)) → centralizer (L : Set Q) = ⊥ →
    DihOrCycSylow Q → L = ⊤

/-! ### L2F / A7F: model facts. These are the initial lists. CORE owners request more facts
through the lead, stated on the concrete models. -/

def L2SylowDihedralProp : Prop :=
  ∀ (p k : ℕ) [Fact p.Prime], Odd p → 5 ≤ p ^ k →
    ∀ S : Sylow 2 (PSL(2, GaloisField p k)), ∃ n : ℕ, 2 ≤ n ∧
      Nonempty ((S : Subgroup (PSL(2, GaloisField p k))) ≃* DihedralGroup n)

def L2InvolutionCentralizerProp : Prop :=
  ∀ (p k : ℕ) [Fact p.Prime], Odd p → 5 ≤ p ^ k →
    ∀ t : PSL(2, GaloisField p k), orderOf t = 2 →
      ∃ n : ℕ, (2 * n = p ^ k - 1 ∨ 2 * n = p ^ k + 1) ∧
        Nonempty (centralizer ({t} : Set (PSL(2, GaloisField p k))) ≃* DihedralGroup n)

/-- "In `L₂(q)` and `PGL₂(q)` fours groups are self-centralizing" (Bender §3). -/
def L2FourGroupProp : Prop :=
  ∀ (p k : ℕ) [Fact p.Prime], Odd p → 5 ≤ p ^ k →
    (∀ V : Subgroup (PSL(2, GaloisField p k)), IsFourGroup V →
        centralizer (V : Set (PSL(2, GaloisField p k))) = V) ∧
    (∀ V : Subgroup (PGL(2, GaloisField p k)), IsFourGroup V →
        centralizer (V : Set (PGL(2, GaloisField p k))) = V)

/-- 1.7(ii) for `L₀ = L₂(q)`: the TI tori. `Q` has order `q` with `N(Q)` Frobenius of order
`q(q-1)/2`, and the two cyclic tori of orders `(q ± 1)/2` have dihedral normalizers. -/
def L2TIProp : Prop :=
  ∀ (p k : ℕ) [Fact p.Prime], Odd p → 5 ≤ p ^ k →
    ∃ Q Tp Tm : Subgroup (PSL(2, GaloisField p k)),
      Nat.card Q = p ^ k ∧ 2 * Nat.card Tp = p ^ k + 1 ∧ 2 * Nat.card Tm = p ^ k - 1 ∧
      IsCyclic Tp ∧ IsCyclic Tm ∧ (∀ x ∈ Q, x ^ p = 1) ∧
      (∀ g : PSL(2, GaloisField p k), g ∉ normalizer (Q : Set _) →
          Q ⊓ Q.map (MulAut.conj g).toMonoidHom = ⊥) ∧
      (∀ g : PSL(2, GaloisField p k), g ∉ normalizer (Tp : Set _) →
          Tp ⊓ Tp.map (MulAut.conj g).toMonoidHom = ⊥) ∧
      (∀ g : PSL(2, GaloisField p k), g ∉ normalizer (Tm : Set _) →
          Tm ⊓ Tm.map (MulAut.conj g).toMonoidHom = ⊥) ∧
      2 * Nat.card (normalizer (Q : Set (PSL(2, GaloisField p k)))) = p ^ k * (p ^ k - 1) ∧
      Nonempty (normalizer (Tp : Set (PSL(2, GaloisField p k))) ≃* DihedralGroup (Nat.card Tp)) ∧
      Nonempty (normalizer (Tm : Set (PSL(2, GaloisField p k))) ≃* DihedralGroup (Nat.card Tm))

/-- Bender 1.8, on the model `A₇` (by `decide` / explicit elements). Here `S` is the Sylow
2-subgroup containing `a7Invol = (01)(23)`. -/
def A7ModelProp : Prop :=
  Nat.card (alternatingGroup (Fin 7)) = 2520 ∧
  (∀ S : Sylow 2 (alternatingGroup (Fin 7)),
      Nonempty ((S : Subgroup (alternatingGroup (Fin 7))) ≃* DihedralGroup 4)) ∧
  (∀ t : alternatingGroup (Fin 7), orderOf t = 2 →
      Nat.card (centralizer ({t} : Set (alternatingGroup (Fin 7)))) = 24) ∧
  ∀ X : Subgroup (alternatingGroup (Fin 7)), Odd (Nat.card X) → Nat.card X ≤ 21

/-! ### BMAX: Bender 1970 1.6/1.7 = Bender 1981 Lemma 2.3 -/

def Lemma23Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    ∀ M : Subgroup G, M ≠ ⊤ → BRel B.Hhat M →
      ((¬ ∃ p : ℕ, p.Prime ∧ IsPGroup p (fstarIn B.Hhat)) → fittingPiIn B.pi M ≤ B.Hhat) ∧
      (fittingPiIn B.piᶜ M ⊓ B.Hhat = ⊥) ∧
      (IsCoatom M → BRel M B.Hhat →
        B.Hhat = M ∨ ∃ p : ℕ, p.Prime ∧ IsPGroup p (fstarIn B.Hhat) ∧ IsPGroup p (fstarIn M))

/-! ### ZJ: Glauberman 1968, Theorems A and B, for groups with dihedral/cyclic Sylow 2 -/

/-- `Qd(p)` is not involved, so every such group is `p`-stable (Glauberman Lemma 6.3, (a)⇒(b)). -/
def PStableProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (p : ℕ), p.Prime → p ≠ 2 → DihOrCycSylow X →
    IsPStable' p X

/-- Theorem A in our vocabulary (GLUE, from `Subgroup.zCenter_thompsonJAbelian_normal` and
`PStableProp`). -/
def ZJAProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (p : ℕ) [Fact p.Prime], p ≠ 2 → DihOrCycSylow X →
    centralizer (pCore p X : Set X) ≤ pCore p X → ∀ P : Sylow p X, (ZJ (P : Subgroup X)).Normal

/-- Theorem B: `N(Z(J(P)))` controls strong fusion in `P`. -/
def ZJBProp : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (p : ℕ) [Fact p.Prime], p ≠ 2 → DihOrCycSylow X →
    ∀ (P : Sylow p X) (W : Set X) (g : X), W.Nonempty → W ⊆ (P : Subgroup X) →
      (∀ w ∈ W, g * w * g⁻¹ ∈ (P : Subgroup X)) →
      ∃ c n : X, c ∈ centralizer W ∧ n ∈ normalizer (ZJ (P : Subgroup X) : Set X) ∧ g = c * n

/-! ### BG: Bender–Glauberman 1981, Theorems A, B, C -/

/-- Hypothesis 1.1 together with the BG notation. -/
structure BGData (G : Type) [Group G] [Finite G] where
  S : Sylow 2 G
  n : ℕ
  two_le : 2 ≤ n
  dih : Nonempty ((S : Subgroup G) ≃* DihedralGroup n)
  oneClass : ∀ x y : G, orderOf x = 2 → orderOf y = 2 → IsConj x y
  S0 : Subgroup G
  S0_le : S0 ≤ (S : Subgroup G)
  S0_cyclic : IsCyclic S0
  S0_index : S0.relIndex (S : Subgroup G) = 2
  t : G
  t_mem : t ∈ S0
  t_order : orderOf t = 2
  t1 : G
  t2 : G
  t1_mem : t1 ∈ (S : Subgroup G)
  t2_mem : t2 ∈ (S : Subgroup G)
  t1_nmem : t1 ∉ S0
  t2_nmem : t2 ∉ S0
  t1_order : orderOf t1 = 2
  t2_order : orderOf t2 = 2
  gen : S0 = zpowers (t1 * t2)

namespace BGData
variable {G : Type} [Group G] [Finite G] (D : BGData G)
abbrev H : Subgroup G := centralizer ({D.t} : Set G)
abbrev U : Subgroup G := oddCoreIn D.H
/-- `k = k₁ + k₂`, `kᵢ = |H : C_H(tᵢ)|`. -/
noncomputable abbrev k : ℕ := (centralizer ({D.t1} : Set G)).relIndex D.H +
  (centralizer ({D.t2} : Set G)).relIndex D.H
abbrev B1 : Subgroup G := D.U ⊓ centralizer ({D.t1} : Set G)
abbrev B2 : Subgroup G := D.U ⊓ centralizer ({D.t2} : Set G)
abbrev B : Subgroup G := D.B1 ⊓ D.B2
end BGData

/-- BG Theorem A: `1/3 < 2k²/|G:H| < 3`. -/
def BGThmAProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (D : BGData G),
    D.H.index < 3 * (2 * D.k ^ 2) ∧ 2 * D.k ^ 2 < 3 * D.H.index

/-- BG Theorem B, in the form its proof gives: a proper `G₁ ⊇ H` with one class of involutions
has index 5. For simple `G` this is the `A₅` case. -/
def BGThmBProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (D : BGData G) (G1 : Subgroup G), G1 ≠ ⊤ → D.H ≤ G1 →
    (∀ x y : G, x ∈ G1 → y ∈ G1 → orderOf x = 2 → orderOf y = 2 →
      ∃ g ∈ G1, g * x * g⁻¹ = y) →
    G1.index = 5

/-- BG Theorem C. -/
def BGThmCProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (D : BGData G) (K1 K2 : Subgroup G),
    IsMaxInverted D.H D.t1 K1 → IsMaxInverted D.H D.t2 K2 →
    IsInternalDirect D.U (D.B1 ⊓ K2) (D.B ⊔ (K1 ⊓ K2)) →
    Nat.Coprime (Nat.card (K1 ⊓ K2 : Subgroup G)) D.H.index →
    ⁅D.B, D.B⁆ ≠ D.B →
    (D.U ≠ D.B ⊔ (K1 ⊓ K2) → IsFrobeniusWith (D.B ⊔ (K1 ⊓ K2)) (K1 ⊓ K2) D.B) →
    ¬ IsSimpleGroup G

/-! ### BSW / ZASS / A7REC: recognition -/

/-- Zassenhaus hypotheses on a `G`-set `X` of size `q + 1`. -/
def ZassHyps (G X : Type) [Group G] [Finite G] [MulAction G X] (q : ℕ) : Prop :=
  FaithfulSMul G X ∧ Nat.card X = q + 1 ∧ MulAction.IsMultiplyPretransitive G X 2 ∧
    (∀ g : G, g ≠ 1 → {x : X | g • x = x}.ncard ≤ 2) ∧
    (∀ x y : X, x ≠ y →
      2 * Nat.card (MulAction.stabilizer G x ⊓ MulAction.stabilizer G y : Subgroup G) = q - 1) ∧
    (∀ x y : X, x ≠ y → IsCyclic (MulAction.stabilizer G x ⊓ MulAction.stabilizer G y : Subgroup G))

/-- Zassenhaus groups of degree `q + 1` (q odd) with cyclic two-point stabilizer of order
`(q-1)/2` are `L₂(q)` (HB III XI.10 / Gorenstein 13.3). This is the old A6 contract. -/
def ZassOddProp : Prop :=
  ∀ (G X : Type) [Group G] [Finite G] [MulAction G X] [Finite X] (p k : ℕ) [Fact p.Prime],
    Odd p → 5 ≤ p ^ k → IsSimpleGroup G → ZassHyps G X (p ^ k) →
    Nonempty (G ≃* PSL(2, GaloisField p k))

/-- The Brauer–Suzuki–Wall hypotheses in the shape Bender's Lemma 2.2 produces them:
`C(t) = A⟨s⟩`, `A` abelian and inverted by `s`, and odd subgroups of `A` with normalizers in
`C(t)`. -/
def BSWHyps (G : Type) [Group G] [Finite G] (t s : G) (A : Subgroup G) : Prop :=
  orderOf t = 2 ∧ orderOf s = 2 ∧ s ∉ A ∧ centralizer ({t} : Set G) = A ⊔ zpowers s ∧
    IsMulCommutative A ∧ (∀ a ∈ A, s * a * s⁻¹ = a⁻¹) ∧
    ∀ X : Subgroup G, X ≠ ⊥ → X ≤ A → Odd (Nat.card X) →
      normalizer (X : Set G) ≤ centralizer ({t} : Set G)

/-- BSW, character half: the hypotheses give a Zassenhaus action on the cosets of some `M`. -/
def BSWZassProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G → (∃ a b : G, a * b ≠ b * a) →
    ∀ (S : Sylow 2 G) (n : ℕ), 2 ≤ n → Nonempty ((S : Subgroup G) ≃* DihedralGroup n) →
    ∀ (t s : G) (A : Subgroup G), BSWHyps G t s A →
      ∃ p k : ℕ, ∃ _ : Fact p.Prime, Odd p ∧ 5 ≤ p ^ k ∧
        ∃ M : Subgroup G, ZassHyps G (G ⧸ M) (p ^ k)

def BSWProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G → (∃ a b : G, a * b ≠ b * a) →
    ∀ (S : Sylow 2 G) (n : ℕ), 2 ≤ n → Nonempty ((S : Subgroup G) ≃* DihedralGroup n) →
    ∀ (t s : G) (A : Subgroup G), BSWHyps G t s A →
      ∃ p k : ℕ, ∃ _ : Fact p.Prime, Odd p ∧ 5 ≤ p ^ k ∧
        Nonempty (G ≃* PSL(2, GaloisField p k))

/-- `A₇` recognition from Bender 1.8 (replaces Suzuki 1959). -/
def A7RecProp : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G → Nat.card G = 2520 →
    ∀ (S : Sylow 2 G), Nonempty ((S : Subgroup G) ≃* DihedralGroup 4) →
    ∀ (z : G) (U V : Subgroup G), z ∈ (S : Subgroup G) → orderOf z = 2 →
      (∀ x ∈ (S : Subgroup G), x * z = z * x) →
      centralizer ({z} : Set G) = U ⊔ (S : Subgroup G) → Nat.card U = 3 →
      (U.subgroupOf (centralizer ({z} : Set G))).Normal →
      V = pCoreIn 2 (U ⊔ (S : Subgroup G)) → IsFourGroup V →
      (∃ g : G, U.map (MulAut.conj g).toMonoidHom ≠ U ∧
        U.map (MulAut.conj g).toMonoidHom ≤ normalizer (V : Set G)) →
      normalizer (U : Set G) = normalizer (V : Set G) →
      Nat.card (normalizer (U : Set G)) = 72 →
      Nonempty (G ≃* alternatingGroup (Fin 7))

/-! ### CORE2A: Bender Lemmas 2.1, 2.2, 2.4, 2.5 and Theorem 2.6 -/

def Lemma22Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    ¬ (B.S0 ≤ centralizer (B.U : Set G) ∧
       ∃ s ∈ (B.S : Subgroup G), s ∉ B.S0 ∧
         ∃ I : Subgroup G, (I : Set G) = invSet B.U s ∧ (I.subgroupOf B.U).Normal ∧
           ∀ X : Subgroup G, X ≠ ⊥ → X ≤ I → normalizer (X : Set G) ≤ B.H)

def Thm26Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    oddCoreIn B.Hhat = B.U ∧
    (B.S : Subgroup G) ⊓ centralizer (B.U : Set G) = pCoreIn 2 B.Hhat ∧
    ((pCoreIn 2 B.Hhat ≤ B.S0 ∧ B.Hhat = B.H) ∨
     (IsFourGroup (pCoreIn 2 B.Hhat) ∧ (pCoreIn 2 B.Hhat ⊔ B.U).relIndex B.Hhat = 6 ∧
       ∃ a ∈ B.Hhat, ∃ b ∈ B.Hhat, a * b * a⁻¹ * b⁻¹ ∉ pCoreIn 2 B.Hhat ⊔ B.U))

/-! ### CORE2B: Bender Lemmas 2.7–2.9 and Theorem 2.10 -/

def Lemma27Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    ∀ M : Subgroup G, M ≠ ⊤ → BRel B.Hhat M → ¬ M ≤ B.Hhat → B.t ∈ M → B.t ∉ layerIn M →
      (∀ P : Sylow 2 M, ¬ IsCyclic P) →
      (8 ≤ Nat.card ((B.S : Subgroup G) ⊓ M : Subgroup G) ∨ Nat.card (B.S : Subgroup G) = 4 ∨
        B.t ∈ twoResidualIn M) →
      ⁅M, zpowers B.t⁆ ≤ fittingPiIn B.piᶜ M ∧
      ¬ ⁅(B.S : Subgroup G), B.U⁆ ≤ fittingIn B.U ∧ Group.IsSolvable M

def Lemma28Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    (∀ s ∈ (B.S : Subgroup G), s ∉ B.S0 →
      ∃ I : Subgroup G, (I : Set G) = invSet B.U s ∧ (I.subgroupOf B.U).Normal) →
    ⁅B.S0, B.U⁆ ≠ ⊥ ∧
    ∀ M : Subgroup G, M ≠ ⊤ → BRel B.Hhat M → ¬ M ≤ B.Hhat → (B.S : Subgroup G) ≤ M →
      B.t ∈ layerIn M

/-- Lemma 2.9, specialised to `t ∈ V ≤ S`. This is the only shape used (§3, `V₂ = ⟨t, t₂⟩`). -/
def Lemma29Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    ∀ V N : Subgroup G, V ≤ N → N ≠ ⊤ → V ≤ (B.S : Subgroup G) → B.t ∈ V → IsFourGroup V →
      (∀ (s : G) (X : Subgroup G), s ∈ (B.S : Subgroup G) → X ≤ B.U → X ≠ ⊥ →
        ⁅zpowers s, X⁆ = X → B.t ∈ pCoreIn 2 (normalizer (X : Set G))) →
      V ⊓ pCoreIn 2 N ≠ ⊥ ∨ V ⊓ layerIn N ≠ ⊥

def Thm210Prop : Prop :=
  ∀ (G : Type) [Group G] [Finite G], FeitThompsonProp → BenderCtx G → ∀ B : BenderSetup G,
    Case1 B ∨ Case2 B

/-! ### CORE3 / CORE4: elimination of the two cases -/

