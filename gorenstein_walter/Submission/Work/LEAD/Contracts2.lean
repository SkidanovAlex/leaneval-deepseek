/-! ## 6. Top-level assembly: the full DAG composes to the challenge statement -/

theorem gorenstein_walter_of_areas (T : LocalToolkit)
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (P : Sylow 2 G)
    (hdih : ∃ n : ℕ, Nonempty ((P : Subgroup G) ≃* DihedralGroup n)) :
    Nonempty (G ≃* alternatingGroup (Fin 7)) ∨
    ∃ p k : ℕ, ∃ _hp : Fact p.Prime, Odd p ∧ 5 ≤ p ^ k ∧
      Nonempty (G ≃* PSL(2, GaloisField p k)) := by
  have hA := bgA
  have hB := bgB hA
  have hC := bgC
  have hBSW := bsw (bswZass hA) zassOdd
  have hPS := pStable
  have hZA := zjA hPS
  have hZB := zjB hPS hZA
  have h23 := lemma23 T
  have h22 := lemma22 T hC hBSW
  have h26 := thm26 T hB hBSW h22 h23 hZA hZB
  have h27 := lemma27 T h23 h26
  have h28 := lemma28 T h22 h27
  have h29 := lemma29 T
  have h210 := thm210 T h26 h27 h28
  have hc1 := case1False T h22 h26 h29 hC a7rec
  have hc2 := case2False T h26 h27 h28 hA
  have hS := simpleStep_of_bender T.ft h210 hc1 hc2
  have hN := nonSimpleStep T
  exact gw_of_DGroupTheorem (dGroupTheorem_of_steps hN hS) G hnonab P hdih

end GW2
