# A Klein four-group centralizing a field involution inside `PSL(2,q) ⊆ Sym(ℙ¹(q))`

`Work.AUTL2.Norm.fourgroup`: for `F = GF(p^k)`, `p` odd, and an involutive nontrivial field
automorphism `σ` of `F`, there is a Klein four-group `V ≤ pslImage F ≤ Sym(ℙ¹(F))` all of
whose elements are involutions and which centralizes the permutation `galHom F σ`.

Strategy (step A5.3 of `NOTES_AUTL2.md`): the fixed field `K = Fix σ` is a subfield of `F`;
since `2 ≠ 0` in `K`, the counting lemma `Work.L2F.Conic.exists_sq_add_sq` produces `a, b ∈ K`
with `a² + b² = -1`.  The matrices `A = !![a,b;b,-a]` and `W = !![0,1;-1,0]` then have square
`-1` in `SL(2,K)`, they anticommute, and their images in `PSL(2,F)` therefore generate a Klein
four-group.  Because their entries are fixed by `σ`, the induced Möbius maps commute with
`galHom F σ`.
-/
import Mathlib
import Submission.Work.AUTL2.Defs
import Submission.Work.AUTL2.Mobius
import Submission.Work.AUTL2.Galois.decomposition
import Submission.Work.L2F.Conic.exists_sq_add_sq

namespace Work.AUTL2.Norm

open scoped MatrixGroups LinearAlgebra.Projectivization
open OnePoint

open Work.AUTL2

/-! ## The subgroup generated by two commuting involutions

Pure group theory: if `u` and `v` are commuting involutions, then `⟨u, v⟩ = {1, u, v, uv}`, and
if moreover the four elements are distinct, this subgroup has exactly `4` elements. -/

section Group

variable {G : Type*} [Group G]

theorem mem_closure_pair_of_sq_eq_one {u v x : G} (hu : u ^ 2 = 1)
    (hv : v ^ 2 = 1) (hc : u * v = v * u) :
    x ∈ Subgroup.closure ({u, v} : Set G) ↔ x = 1 ∨ x = u ∨ x = v ∨ x = u * v := by
  have hu2 : u * u = 1 := by simpa [pow_two] using hu
  have hv2 : v * v = 1 := by simpa [pow_two] using hv
  have hcs : v * u = u * v := hc.symm
  have hu' : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu2
  have hv' : v⁻¹ = v := inv_eq_of_mul_eq_one_right hv2
  have huuv : u * (u * v) = v := by rw [← mul_assoc, hu2, one_mul]
  have huvv : (u * v) * v = u := by rw [mul_assoc, hv2, mul_one]
  have hvuv : v * (u * v) = u := by rw [← mul_assoc, ← hc, huvv]
  have huvu : (u * v) * u = v := by rw [mul_assoc, ← hc, ← mul_assoc, hu2, one_mul]
  have huvuv : (u * v) * (u * v) = 1 := by rw [← mul_assoc, huvu, hv2]
  have huv' : (u * v)⁻¹ = u * v := inv_eq_of_mul_eq_one_right huvuv
  constructor
  · intro hx
    refine Subgroup.closure_induction (k := ({u, v} : Set G))
      (p := fun y (_ : y ∈ Subgroup.closure ({u, v} : Set G)) =>
        y = 1 ∨ y = u ∨ y = v ∨ y = u * v) ?_ ?_ ?_ ?_ hx
    · rintro y hy
      rcases hy with rfl | rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr (Or.inl rfl))
    · exact Or.inl rfl
    · rintro x y _ _ hx' hy'
      rcases hx' with rfl | rfl | rfl | rfl <;> rcases hy' with rfl | rfl | rfl | rfl <;>
        simp [hu2, hv2, hcs, huuv, hvuv, huvu, huvv, huvuv]
    · rintro x _ hx'
      rcases hx' with rfl | rfl | rfl | rfl <;> simp [hu', hv', huv']
  · rintro (rfl | rfl | rfl | rfl)
    · exact one_mem _
    · exact Subgroup.subset_closure (by simp)
    · exact Subgroup.subset_closure (by simp)
    · exact mul_mem (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp))

theorem card_closure_pair_of_sq_eq_one (u v : G) (hu : u ^ 2 = 1)
    (hv : v ^ 2 = 1) (hc : u * v = v * u) (hu1 : u ≠ 1) (hv1 : v ≠ 1) (hne : u * v ≠ 1) :
    Nat.card (Subgroup.closure ({u, v} : Set G)) = 4 := by
  have hu2 : u * u = 1 := by simpa [pow_two] using hu
  have hv2 : v * v = 1 := by simpa [pow_two] using hv
  have hut : u ≠ v := fun h => hne (by rw [← h]; exact hu2)
  have h1t : (1 : G) ≠ u := fun h => hu1 h.symm
  have h1s : (1 : G) ≠ v := fun h => hv1 h.symm
  have h1uv : (1 : G) ≠ u * v := fun h => hne h.symm
  have huuv' : u ≠ u * v := fun h => hv1 ((mul_left_cancel (by rw [mul_one]; exact h)).symm)
  have hvuv' : v ≠ u * v := fun h => hu1 ((mul_right_cancel (by rw [one_mul]; exact h)).symm)
  have h3 : ({v, u * v} : Set G).ncard = 2 := by
    rw [Set.ncard_insert_of_notMem, Set.ncard_singleton]
    simpa only [Set.mem_singleton_iff] using hvuv'
  have h2 : ({u, v, u * v} : Set G).ncard = 3 := by
    rw [Set.ncard_insert_of_notMem, h3]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨hut, huuv'⟩
  have h4 : ({1, u, v, u * v} : Set G).ncard = 4 := by
    rw [Set.ncard_insert_of_notMem, h2]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨h1t, h1s, h1uv⟩
  have hset : ((Subgroup.closure ({u, v} : Set G)) : Set G) = {1, u, v, u * v} := by
    ext x
    show x ∈ Subgroup.closure ({u, v} : Set G) ↔ x ∈ ({1, u, v, u * v} : Set G)
    rw [mem_closure_pair_of_sq_eq_one hu hv hc]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  change Nat.card ↥((Subgroup.closure ({u, v} : Set G)) : Set G) = 4
  rw [Nat.card_coe_set_eq, hset, h4]

end Group

/-! ## The Möbius action is faithful

`pslHom F : PSL(2,F) →* Perm ℙ¹(F)` is injective: an element of `SL(2,F)` acting trivially on
`ℙ¹(F)` is a scalar matrix, i.e. an element of the centre of `SL(2,F)`. -/

theorem pslHom_injective (F : Type*) [Field F] [DecidableEq F] :
    Function.Injective (pslHom F) := by
  have core : ∀ x : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F,
      pslHom F x = 1 → x = 1 := by
    intro x hx
    obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
    rw [QuotientGroup.eq_one_iff, Matrix.SpecialLinearGroup.mem_center_iff]
    have hfix : ∀ c : OnePoint F,
        (Matrix.SpecialLinearGroup.toGL u : GL (Fin 2) F) • c = c := by
      intro c
      have h := congrFun (congrArg DFunLike.coe hx) c
      rw [pslHom_toGL] at h
      simpa using h
    have h10 : (u : Matrix (Fin 2) (Fin 2) F) 1 0 = 0 := by
      have := OnePoint.smul_infty_eq_self_iff.mp (hfix ∞)
      simpa using this
    have hdet1 : (u : Matrix (Fin 2) (Fin 2) F).det = 1 := Matrix.SpecialLinearGroup.det_coe u
    have h11 : (u : Matrix (Fin 2) (Fin 2) F) 1 1 ≠ 0 := by
      intro h
      have hd := hdet1
      rw [Matrix.det_fin_two, h10, h] at hd
      simpa using hd
    have h01 : (u : Matrix (Fin 2) (Fin 2) F) 0 1 = 0 := by
      have h := hfix ((0 : F) : OnePoint F)
      rw [OnePoint.smul_some_eq_ite] at h
      rw [coe_toGL_coe] at h
      simp only [h10, mul_zero, zero_mul, zero_add] at h
      rw [if_neg h11] at h
      have h' : (u : Matrix (Fin 2) (Fin 2) F) 0 1 / (u : Matrix (Fin 2) (Fin 2) F) 1 1 = 0 :=
        OnePoint.coe_eq_coe.mp h
      exact (div_eq_zero_iff.mp h').elim id (fun hh => absurd hh h11)
    have h00 : (u : Matrix (Fin 2) (Fin 2) F) 0 0 = (u : Matrix (Fin 2) (Fin 2) F) 1 1 := by
      have h := hfix ((1 : F) : OnePoint F)
      rw [OnePoint.smul_some_eq_ite] at h
      rw [coe_toGL_coe] at h
      simp only [h10, mul_one, mul_zero, zero_mul, zero_add] at h
      rw [if_neg h11] at h
      have h' : ((u : Matrix (Fin 2) (Fin 2) F) 0 0 + (u : Matrix (Fin 2) (Fin 2) F) 0 1) /
          (u : Matrix (Fin 2) (Fin 2) F) 1 1 = 1 := OnePoint.coe_eq_coe.mp h
      simp only [h01, add_zero] at h'
      simpa using (div_eq_iff h11).mp h'
    refine ⟨(u : Matrix (Fin 2) (Fin 2) F) 0 0, ?_, ?_⟩
    · have hdet := Matrix.SpecialLinearGroup.det_coe u
      rw [Matrix.det_fin_two, h10, h01, ← h00] at hdet
      simpa [pow_two] using hdet
    · ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.scalar_apply, h10, h01, h00]
  intro g h hgh
  have h1 : g * h⁻¹ = 1 :=
    core (g * h⁻¹) (by rw [map_mul, map_inv, hgh, mul_inv_cancel])
  exact mul_inv_eq_one.mp h1

/-! ## The fixed field and the two squares -/

/-- The fixed field of an automorphism `σ` of `𝔽_{p^k}` contains `a, b` with `a² + b² = -1`.

The fixed points of `σ` form a subfield `K` of `F`; since `2 ≠ 0` in `K` the counting lemma
`Work.L2F.Conic.exists_sq_add_sq` (every element of a finite field of odd characteristic is a
sum of two squares) applies to `K` with `c = -1`. -/
theorem fixed_sq_add_sq (p k : ℕ) [Fact p.Prime] [Fintype (GaloisField p k)] (hp : Odd p)
    (σ : GaloisField p k ≃+* GaloisField p k) :
    ∃ a b : GaloisField p k, σ a = a ∧ σ b = b ∧ a ^ 2 + b ^ 2 = -1 := by
  classical
  let K : Subfield (GaloisField p k) :=
    { carrier := {x | σ x = x}
      mul_mem' := by
        rintro x y hx hy
        simp only [Set.mem_ofPred_eq] at hx hy ⊢
        rw [map_mul, hx, hy]
      one_mem' := by
        simp only [Set.mem_ofPred_eq]
        rw [map_one]
      add_mem' := by
        rintro x y hx hy
        simp only [Set.mem_ofPred_eq] at hx hy ⊢
        rw [map_add, hx, hy]
      zero_mem' := by
        simp only [Set.mem_ofPred_eq]
        rw [map_zero]
      neg_mem' := by
        rintro x hx
        simp only [Set.mem_ofPred_eq] at hx ⊢
        rw [map_neg, hx]
      inv_mem' := by
        rintro x hx
        simp only [Set.mem_ofPred_eq] at hx ⊢
        rw [map_inv₀, hx] }
  have h2K : (2 : ↥K) ≠ 0 := by
    intro h
    have hp2 : p ∣ 2 := (CharP.cast_eq_zero_iff ↥K p 2).mp h
    have hp_eq : p = 2 := (Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).mp hp2
    exact (by decide : ¬ Odd (2 : ℕ)) (hp_eq ▸ hp)
  haveI : Fintype ↥K := Subtype.fintype fun x => x ∈ K
  obtain ⟨a, b, hab⟩ := Work.L2F.Conic.exists_sq_add_sq ↥K h2K (-1)
  exact ⟨(a : GaloisField p k), (b : GaloisField p k), a.2, b.2,
    by simpa using congrArg (Subfield.subtype K) hab⟩

/-! ## Matrix-level facts -/

section Matrix

variable {F : Type*} [Field F] [DecidableEq F]

/-- The matrix `!![a,b;b,-a]` of `SL(2,F)`, when `a² + b² = -1`.  Its square is `-1`, so its
image in `PSL(2,F)` is an involution. -/
def matA (a b : F) (hab : a ^ 2 + b ^ 2 = -1) : SL(2, F) :=
  ⟨!![a, b; b, -a], by
    rw [Matrix.det_fin_two]
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one]
    linear_combination -hab⟩

@[simp] lemma matA_apply (a b : F) (hab : a ^ 2 + b ^ 2 = -1) :
    ((matA a b hab : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) = !![a, b; b, -a] := rfl

@[simp] lemma negOne_entry :
    ((Work.L2F.negOne F : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) = -1 := rfl

@[simp] lemma weyl_entry :
    ((Work.AUTL2.weylMat F : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) = !![0, 1; -1, 0] := rfl

/-- `A² = -1` in `SL(2,F)`. -/
theorem matA_sq (a b : F) (hab : a ^ 2 + b ^ 2 = -1) :
    matA a b hab * matA a b hab = Work.L2F.negOne F := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_fin_two] <;>
    (first | linear_combination hab | ring)

/-- The Weyl element squares to `-1` in `SL(2,F)`. -/
theorem weylMat_sq : Work.AUTL2.weylMat F * Work.AUTL2.weylMat F = Work.L2F.negOne F := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_fin_two]

/-- `A` and the Weyl element anticommute. -/
theorem matA_mul_weylMat (a b : F) (hab : a ^ 2 + b ^ 2 = -1) :
    matA a b hab * Work.AUTL2.weylMat F =
      Work.L2F.negOne F * (Work.AUTL2.weylMat F * matA a b hab) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_fin_two]

/-- The central element `-1` of `SL(2,F)` is trivial in `PSL(2,F)`. -/
theorem mk_negOne : (QuotientGroup.mk (Work.L2F.negOne F) : PSL(2, F)) = 1 := by
  rw [QuotientGroup.eq_one_iff, Matrix.SpecialLinearGroup.mem_center_iff]
  refine ⟨-1, by norm_num, ?_⟩
  rw [negOne_entry]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.scalar_apply, Matrix.diagonal]

/-- If an `SL(2,F)`-matrix has upper row `(c,d)` with `c² + d² ≠ 1`, then it is not central,
hence nontrivial in `PSL(2,F)`. -/
theorem mk_ne_one_of_entries {X : SL(2, F)} {c d : F}
    (h00 : (X : Matrix (Fin 2) (Fin 2) F) 0 0 = c)
    (h01 : (X : Matrix (Fin 2) (Fin 2) F) 0 1 = d) (hbad : c ^ 2 + d ^ 2 ≠ 1) :
    (QuotientGroup.mk X : PSL(2, F)) ≠ 1 := by
  intro h
  rw [QuotientGroup.eq_one_iff] at h
  obtain ⟨r, hr2, hr⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp h
  have hr1 : r = 1 ∨ r = -1 := mul_self_eq_one_iff.mp (by simpa [pow_two] using hr2)
  have hX00 : (X : Matrix (Fin 2) (Fin 2) F) 0 0 = r := by
    rw [← hr]
    simp [Matrix.scalar_apply, Matrix.diagonal]
  have hX01 : (X : Matrix (Fin 2) (Fin 2) F) 0 1 = 0 := by
    rw [← hr]
    simp [Matrix.scalar_apply, Matrix.diagonal]
  have hc : c = r := by rw [← h00, hX00]
  have hd : d = 0 := by rw [← h01, hX01]
  refine hbad ?_
  rcases hr1 with hr1 | hr1 <;> rw [hc, hd, hr1] <;> ring

/-- If the `(0,0)`-entry of an `SL(2,F)`-matrix is neither `1` nor `-1`, then it is not central,
hence nontrivial in `PSL(2,F)`. -/
theorem mk_ne_one_of_entry00 {X : SL(2, F)} (h1 : (X : Matrix (Fin 2) (Fin 2) F) 0 0 ≠ 1)
    (h2 : (X : Matrix (Fin 2) (Fin 2) F) 0 0 ≠ -1) : (QuotientGroup.mk X : PSL(2, F)) ≠ 1 := by
  intro h
  rw [QuotientGroup.eq_one_iff] at h
  obtain ⟨r, hr2, hr⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp h
  have hr1 : r = 1 ∨ r = -1 := mul_self_eq_one_iff.mp (by simpa [pow_two] using hr2)
  have hX00 : (X : Matrix (Fin 2) (Fin 2) F) 0 0 = r := by
    rw [← hr]
    simp [Matrix.scalar_apply, Matrix.diagonal]
  rcases hr1 with rfl | rfl
  · exact h1 hX00
  · exact h2 hX00

/-- The permutation `galHom F σ` commutes with every Möbius map whose matrix entries are fixed
by `σ`: conjugating the Möbius map of `M` by `σ` gives the Möbius map of the matrix `σ(M)`,
which is `M` itself when all entries are fixed. -/
theorem galHom_commute_of_fixed (σ : F ≃+* F) (hσ : σ * σ = 1) (M : SL(2, F))
    (hM : ∀ i j, σ ((M : Matrix (Fin 2) (Fin 2) F) i j) = (M : Matrix (Fin 2) (Fin 2) F) i j) :
    galHom F σ * pslHom F (QuotientGroup.mk M) = pslHom F (QuotientGroup.mk M) * galHom F σ := by
  have hmap : Matrix.SpecialLinearGroup.map (σ : F →+* F) M = M := by
    ext i j
    show (Matrix.map (M : Matrix (Fin 2) (Fin 2) F) (σ : F →+* F)) i j =
      (M : Matrix (Fin 2) (Fin 2) F) i j
    rw [Matrix.map_apply]
    exact hM i j
  have hconj := Work.AUTL2.Galois.fieldAut_conj_psl F σ M
  rw [hmap] at hconj
  calc galHom F σ * pslHom F (QuotientGroup.mk M)
      = galHom F σ * pslHom F (QuotientGroup.mk M) * (galHom F σ)⁻¹ * galHom F σ := by group
    _ = pslHom F (QuotientGroup.mk M) * galHom F σ := by rw [hconj]

end Matrix

theorem fourgroup (p k : ℕ) [Fact p.Prime] [Fintype (GaloisField p k)]
    (hp : Odd p) (hq : 5 ≤ p ^ k) [DecidableEq (GaloisField p k)]
    (σ : GaloisField p k ≃+* GaloisField p k) (hσ : σ * σ = 1) (hne : σ ≠ 1) :
    ∃ V : Subgroup (Equiv.Perm (Work.AUTL2.P1 (GaloisField p k))),
      Nat.card V = 4 ∧ V ≤ Work.AUTL2.pslImage (GaloisField p k) ∧ (∀ v ∈ V, v ^ 2 = 1) ∧
        ∀ v ∈ V, (Work.AUTL2.galHom (GaloisField p k) σ) * v =
          v * (Work.AUTL2.galHom (GaloisField p k) σ) := by
  classical
  obtain ⟨a, b, ha, hb, hab⟩ := fixed_sq_add_sq p k hp σ
  have h2 : (2 : GaloisField p k) ≠ 0 := by
    intro h
    have hp2 : p ∣ 2 := (CharP.cast_eq_zero_iff (GaloisField p k) p 2).mp h
    have hp_eq : p = 2 := (Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).mp hp2
    exact (by decide : ¬ Odd (2 : ℕ)) (hp_eq ▸ hp)
  have hneg : (-1 : GaloisField p k) ≠ 1 := by
    intro h
    apply h2
    linear_combination -h
  have hbad : a ^ 2 + b ^ 2 ≠ 1 := fun h => hneg (by rw [← hab, h])
  let A : SL(2, GaloisField p k) := matA a b hab
  let W : SL(2, GaloisField p k) := Work.AUTL2.weylMat (GaloisField p k)
  have hAmat : (A : Matrix (Fin 2) (Fin 2) (GaloisField p k)) = !![a, b; b, -a] := rfl
  have hWmat : (W : Matrix (Fin 2) (Fin 2) (GaloisField p k)) = !![0, 1; -1, 0] := rfl
  have hAA : A * A = Work.L2F.negOne (GaloisField p k) := matA_sq a b hab
  have hWW : W * W = Work.L2F.negOne (GaloisField p k) := weylMat_sq
  have hAW : A * W = Work.L2F.negOne (GaloisField p k) * (W * A) := matA_mul_weylMat a b hab
  have hN : (QuotientGroup.mk (Work.L2F.negOne (GaloisField p k)) : PSL(2, GaloisField p k)) = 1 :=
    mk_negOne
  have hAAm : (QuotientGroup.mk A : PSL(2, GaloisField p k)) * QuotientGroup.mk A = 1 := by
    rw [← QuotientGroup.mk_mul, hAA, hN]
  have hWWm : (QuotientGroup.mk W : PSL(2, GaloisField p k)) * QuotientGroup.mk W = 1 := by
    rw [← QuotientGroup.mk_mul, hWW, hN]
  have hAWm : (QuotientGroup.mk A : PSL(2, GaloisField p k)) * QuotientGroup.mk W =
      (QuotientGroup.mk W : PSL(2, GaloisField p k)) * QuotientGroup.mk A := by
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, hAW, QuotientGroup.mk_mul, hN, one_mul]
  set u : Equiv.Perm (Work.AUTL2.P1 (GaloisField p k)) :=
    pslHom (GaloisField p k) (QuotientGroup.mk A) with hu
  set v : Equiv.Perm (Work.AUTL2.P1 (GaloisField p k)) :=
    pslHom (GaloisField p k) (QuotientGroup.mk W) with hv
  have hu2 : u ^ 2 = 1 := by
    rw [hu]
    calc (pslHom (GaloisField p k) (QuotientGroup.mk A)) ^ 2
        = pslHom (GaloisField p k)
            ((QuotientGroup.mk A : PSL(2, GaloisField p k)) * QuotientGroup.mk A) := by
          rw [pow_two, ← map_mul]
      _ = 1 := by rw [hAAm, map_one]
  have hv2 : v ^ 2 = 1 := by
    rw [hv]
    calc (pslHom (GaloisField p k) (QuotientGroup.mk W)) ^ 2
        = pslHom (GaloisField p k)
            ((QuotientGroup.mk W : PSL(2, GaloisField p k)) * QuotientGroup.mk W) := by
          rw [pow_two, ← map_mul]
      _ = 1 := by rw [hWWm, map_one]
  have huv : u * v = v * u := by
    rw [hu, hv]
    calc pslHom (GaloisField p k) (QuotientGroup.mk A) *
          pslHom (GaloisField p k) (QuotientGroup.mk W)
        = pslHom (GaloisField p k)
            ((QuotientGroup.mk A : PSL(2, GaloisField p k)) * QuotientGroup.mk W) := by
          rw [← map_mul]
      _ = pslHom (GaloisField p k)
            ((QuotientGroup.mk W : PSL(2, GaloisField p k)) * QuotientGroup.mk A) := by
          rw [hAWm]
      _ = pslHom (GaloisField p k) (QuotientGroup.mk W) *
          pslHom (GaloisField p k) (QuotientGroup.mk A) := by
          rw [map_mul]
  have hAW00 : ((A * W : SL(2, GaloisField p k)) : Matrix (Fin 2) (Fin 2) (GaloisField p k)) 0 0 =
      -b := by
    rw [Matrix.SpecialLinearGroup.coe_mul, hAmat, hWmat, Matrix.mul_fin_two]
    simp
  have hAW01 : ((A * W : SL(2, GaloisField p k)) : Matrix (Fin 2) (Fin 2) (GaloisField p k)) 0 1 =
      a := by
    rw [Matrix.SpecialLinearGroup.coe_mul, hAmat, hWmat, Matrix.mul_fin_two]
    simp
  have hA_ne : (QuotientGroup.mk A : PSL(2, GaloisField p k)) ≠ 1 :=
    mk_ne_one_of_entries (X := A) (c := a) (d := b)
      (by rw [hAmat]; simp) (by rw [hAmat]; simp) hbad
  have hW_ne : (QuotientGroup.mk W : PSL(2, GaloisField p k)) ≠ 1 :=
    mk_ne_one_of_entry00 (X := W) (by rw [hWmat]; simp) (by rw [hWmat]; simp)
  have hAW_ne : (QuotientGroup.mk (A * W) : PSL(2, GaloisField p k)) ≠ 1 :=
    mk_ne_one_of_entries (X := A * W) (c := -b) (d := a) hAW00 hAW01
      (by intro h; exact hbad (by rw [neg_sq, add_comm] at h; exact h))
  have hu1 : u ≠ 1 := by
    rw [hu]
    intro h
    exact hA_ne (pslHom_injective (F := GaloisField p k) (by rw [h, map_one]))
  have hv1 : v ≠ 1 := by
    rw [hv]
    intro h
    exact hW_ne (pslHom_injective (F := GaloisField p k) (by rw [h, map_one]))
  have huvne : u * v ≠ 1 := by
    rw [hu, hv]
    intro h
    rw [← map_mul] at h
    have h1 : (QuotientGroup.mk A : PSL(2, GaloisField p k)) * QuotientGroup.mk W = 1 :=
      pslHom_injective (F := GaloisField p k) (by rw [h, map_one])
    rw [← QuotientGroup.mk_mul] at h1
    exact hAW_ne h1
  have hu_cent : Work.AUTL2.galHom (GaloisField p k) σ * u =
      u * Work.AUTL2.galHom (GaloisField p k) σ := by
    rw [hu]
    exact galHom_commute_of_fixed σ hσ A (by
      intro i j
      fin_cases i <;> fin_cases j <;> simp [hAmat, ha, hb])
  have hv_cent : Work.AUTL2.galHom (GaloisField p k) σ * v =
      v * Work.AUTL2.galHom (GaloisField p k) σ := by
    rw [hv]
    exact galHom_commute_of_fixed σ hσ W (by
      intro i j
      fin_cases i <;> fin_cases j <;> simp [hWmat])
  refine ⟨Subgroup.closure ({u, v} : Set (Equiv.Perm (Work.AUTL2.P1 (GaloisField p k)))),
    card_closure_pair_of_sq_eq_one u v hu2 hv2 huv hu1 hv1 huvne, ?_, ?_, ?_⟩
  · refine (Subgroup.closure_le (Work.AUTL2.pslImage (GaloisField p k))).mpr ?_
    rintro x (rfl | rfl)
    · rw [hu]
      exact ⟨QuotientGroup.mk A, rfl⟩
    · rw [hv]
      exact ⟨QuotientGroup.mk W, rfl⟩
  · intro x hx
    rw [mem_closure_pair_of_sq_eq_one hu2 hv2 huv] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · rw [one_pow]
    · exact hu2
    · exact hv2
    · rw [pow_two]
      calc (u * v) * (u * v) = u * (v * u) * v := by group
        _ = u * (u * v) * v := by rw [huv]
        _ = (u * u) * (v * v) := by group
        _ = 1 := by rw [← pow_two u, ← pow_two v, hu2, hv2, one_mul]
  · intro x hx
    rw [mem_closure_pair_of_sq_eq_one hu2 hv2 huv] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · rw [one_mul, mul_one]
    · exact hu_cent
    · exact hv_cent
    · rw [← mul_assoc, hu_cent, mul_assoc, hv_cent, ← mul_assoc]

end Work.AUTL2.Norm
