# AREA AUTL2 / A5 : extending a Klein four group by a commuting involution

If `V ≤ G` is a subgroup of order `4` all of whose elements are involutions (a Klein
four group) and `τ ∉ V` is an involution commuting with every element of `V`, then
`V ∪ τV` is a subgroup of order `8` all of whose elements are involutions: the elementary
abelian group of order `8` generated by `V` and `τ`.

This is the "extend a Klein four group by a commuting involution" step used in the `A5`
analysis.
-/
import Mathlib
import Submission.Work.AUTL2.Defs

set_option linter.style.haveILetI false

namespace Work.AUTL2.A5

/-- If `V` is a Klein four group and `τ` is an involution outside `V` commuting with `V`,
then `V` extends to an elementary abelian subgroup of order `8`. -/
theorem kleinExtend {G : Type*} [Group G] (V : Subgroup G) (τ : G)
    (hV : Nat.card V = 4) (hVsq : ∀ v ∈ V, v * v = 1)
    (hτ : τ * τ = 1) (hτV : τ ∉ V) (hcomm : ∀ v ∈ V, v * τ = τ * v) :
    ∃ E : Subgroup G, Nat.card E = 8 ∧ V ≤ E ∧ τ ∈ E ∧ ∀ x ∈ E, x * x = 1 := by
  classical
  -- `V` is finite, since it has four elements.
  haveI : Finite V := Nat.finite_of_card_ne_zero (by rw [hV]; norm_num)
  -- the coset `τV`, as an explicit image.
  set W : Set G := (fun v : G => τ * v) '' (V : Set G) with hW
  have hmemW : ∀ x : G, x ∈ W ↔ ∃ v ∈ V, x = τ * v := by
    intro x
    rw [hW, Set.mem_image]
    constructor
    · rintro ⟨v, hv, h⟩; exact ⟨v, hv, h.symm⟩
    · rintro ⟨v, hv, h⟩; exact ⟨v, hv, h.symm⟩
  -- `V ∪ τV` is closed under multiplication.
  have hmul : ∀ x ∈ (V : Set G) ∪ W, ∀ y ∈ (V : Set G) ∪ W,
      x * y ∈ (V : Set G) ∪ W := by
    intro x hx y hy
    rcases hx with hxV | hxW
    · rcases hy with hyV | hyW
      · exact Or.inl (V.mul_mem hxV hyV)
      · rw [hmemW] at hyW
        obtain ⟨v, hv, rfl⟩ := hyW
        refine Or.inr ?_
        rw [hmemW]
        exact ⟨x * v, V.mul_mem hxV hv, by rw [← mul_assoc x τ v, hcomm x hxV, mul_assoc]⟩
    · rw [hmemW] at hxW
      obtain ⟨v, hv, rfl⟩ := hxW
      rcases hy with hyV | hyW
      · refine Or.inr ?_
        rw [hmemW]
        exact ⟨v * y, V.mul_mem hv hyV, by rw [mul_assoc]⟩
      · rw [hmemW] at hyW
        obtain ⟨w, hw, rfl⟩ := hyW
        refine Or.inl ?_
        have h4 : (τ * v) * (τ * w) = v * w := by
          rw [mul_assoc, ← mul_assoc v τ w, hcomm v hv, mul_assoc τ v w,
            ← mul_assoc τ τ (v * w), hτ, one_mul]
        rw [h4]
        exact V.mul_mem hv hw
  -- `V ∪ τV` is closed under inversion.
  have hinv : ∀ x ∈ (V : Set G) ∪ W, x⁻¹ ∈ (V : Set G) ∪ W := by
    intro x hx
    rcases hx with hxV | hxW
    · exact Or.inl (V.inv_mem hxV)
    · rw [hmemW] at hxW
      obtain ⟨v, hv, rfl⟩ := hxW
      refine Or.inr ?_
      rw [hmemW]
      refine ⟨v, hv, ?_⟩
      rw [mul_inv_rev, inv_eq_iff_mul_eq_one.mpr (hVsq v hv),
        inv_eq_iff_mul_eq_one.mpr hτ, hcomm v hv]
  let E : Subgroup G :=
    { carrier := (V : Set G) ∪ W
      mul_mem' := fun hx hy => hmul _ hx _ hy
      one_mem' := Or.inl V.one_mem
      inv_mem' := fun hx => hinv _ hx }
  -- `|V ∪ τV| = |V| + |τV| = 4 + 4 = 8`, the two parts being disjoint.
  have hset : ((V : Set G) ∪ W).ncard = 8 := by
    have hdisj : Disjoint (V : Set G) W := by
      rw [Set.disjoint_left]
      intro x hxV hxW
      rw [hmemW] at hxW
      obtain ⟨v, hv, hxv⟩ := hxW
      exact hτV (by
        have h2 : (τ * v) * v⁻¹ ∈ V := V.mul_mem (hxv ▸ hxV) (V.inv_mem hv)
        rwa [mul_assoc, mul_inv_cancel, mul_one] at h2)
    have hfinV : (V : Set G).Finite := Set.finite_coe_iff.mp (inferInstance : Finite (V : Set G))
    have hfinW : W.Finite := by rw [hW]; exact hfinV.image (fun v : G => τ * v)
    have h1 : (V : Set G).ncard = 4 := by rw [← Nat.card_coe_set_eq]; exact hV
    have h2 : W.ncard = 4 := by
      rw [hW, Set.ncard_image_of_injective (V : Set G) (fun a b h => mul_left_cancel h), h1]
    rw [Set.ncard_union_eq hdisj hfinV hfinW, h1, h2]
  have hcard : Nat.card E = 8 :=
    ((Nat.card_coe_set_eq (E : Set G)).trans
      (congrArg Set.ncard (rfl : (E : Set G) = (V : Set G) ∪ W))).trans hset
  have hVE : V ≤ E := fun v hv => show v ∈ (V : Set G) ∪ W from Or.inl hv
  have hτE : τ ∈ E := Or.inr (by rw [hmemW]; exact ⟨1, V.one_mem, by rw [mul_one]⟩)
  -- every element of `V ∪ τV` is an involution.
  have hsq : ∀ x ∈ E, x * x = 1 := by
    intro x hx
    rcases (show x ∈ (V : Set G) ∪ W from hx) with hxV | hxW
    · exact hVsq x hxV
    · rw [hmemW] at hxW
      obtain ⟨v, hv, rfl⟩ := hxW
      have h5 : (τ * v) * (τ * v) = v * v := by
        rw [mul_assoc, ← mul_assoc v τ v, hcomm v hv, mul_assoc τ v v,
          ← mul_assoc τ τ (v * v), hτ, one_mul]
      rw [h5, hVsq v hv]
  exact ⟨E, hcard, hVE, hτE, hsq⟩

end Work.AUTL2.A5
