/-
Area A7F of the Gorenstein--Walter project: the model facts on `A₇` (Bender 1.8).

The subgroups

* `V₁ = ⟨(0 1)(2 3), (0 2)(1 3)⟩`, the Klein four-group of double transpositions of `{0,1,2,3}`,
* `V₂ = ⟨(0 1)(2 3), (0 1)(4 5)⟩`,

of `A₇` are generated by two commuting involutions; hence each has exactly four elements,
all of them involutions.  In this file we

* build `V₁` and `V₂` explicitly as subgroups with the four element carriers
  `{1, t, s, t*s}` (the subgroup axioms are checked by computation in `A₇`),
* identify them with the closures from `Submission/Work/A7/Defs.lean`,
* deduce `Work.GW2.IsFourGroup a7V1 ∧ Work.GW2.IsFourGroup a7V2`.

Everything is a finite computation in `A₇`, discharged by `decide`.
-/
import Mathlib
import Submission.Work.A7F.Defs

open scoped MatrixGroups

namespace Work.A7F

open Subgroup

/-! ## The explicit four-element subgroups -/

/-- The double transposition `(0 2)(1 3)`: the second generator of `V₁`. -/
def a7D1 : alternatingGroup (Fin 7) := Work.A7.a7Dswap 0 2 1 3 (by decide) (by decide)

/-- The double transposition `(0 1)(4 5)`: the second generator of `V₂`. -/
def a7D2 : alternatingGroup (Fin 7) := Work.A7.a7Dswap 0 1 4 5 (by decide) (by decide)

/-- `V₁` as an explicit subgroup, with carrier `{1, (0 1)(2 3), (0 2)(1 3), (0 1)(2 3)·(0 2)(1 3)}`.
The two generators are commuting involutions, so the carrier is closed under multiplication and
inversion; both facts are finite computations in `A₇`. -/
def v1sub : Subgroup (alternatingGroup (Fin 7)) where
  carrier := {x | x = 1 ∨ x = a7Invol ∨ x = a7D1 ∨ x = a7Invol * a7D1}
  mul_mem' := by
    intro x y hx hy
    rcases hx with rfl | rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl | rfl <;> decide
  one_mem' := Or.inl rfl
  inv_mem' := by
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl <;> decide

/-- `V₂` as an explicit subgroup, with carrier `{1, (0 1)(2 3), (0 1)(4 5), (0 1)(2 3)·(0 1)(4 5)}`. -/
def v2sub : Subgroup (alternatingGroup (Fin 7)) where
  carrier := {x | x = 1 ∨ x = a7Invol ∨ x = a7D2 ∨ x = a7Invol * a7D2}
  mul_mem' := by
    intro x y hx hy
    rcases hx with rfl | rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl | rfl <;> decide
  one_mem' := Or.inl rfl
  inv_mem' := by
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl <;> decide

/-! ## The explicit subgroups are the closures of the two generators -/

theorem closure_pair_v1 :
    Subgroup.closure ({a7Invol, a7D1} : Set (alternatingGroup (Fin 7))) = v1sub := by
  have hmem1 : a7Invol ∈ Subgroup.closure ({a7Invol, a7D1} : Set (alternatingGroup (Fin 7))) :=
    Subgroup.subset_closure (by decide)
  have hmem2 : a7D1 ∈ Subgroup.closure ({a7Invol, a7D1} : Set (alternatingGroup (Fin 7))) :=
    Subgroup.subset_closure (by decide)
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
  · intro x hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact Subgroup.one_mem _
    · exact hmem1
    · exact hmem2
    · exact mul_mem hmem1 hmem2

theorem closure_pair_v2 :
    Subgroup.closure ({a7Invol, a7D2} : Set (alternatingGroup (Fin 7))) = v2sub := by
  have hmem1 : a7Invol ∈ Subgroup.closure ({a7Invol, a7D2} : Set (alternatingGroup (Fin 7))) :=
    Subgroup.subset_closure (by decide)
  have hmem2 : a7D2 ∈ Subgroup.closure ({a7Invol, a7D2} : Set (alternatingGroup (Fin 7))) :=
    Subgroup.subset_closure (by decide)
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
  · intro x hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact Subgroup.one_mem _
    · exact hmem1
    · exact hmem2
    · exact mul_mem hmem1 hmem2

/-- `V₁` is the closure of `t = (0 1)(2 3)` and `(0 2)(1 3)`. -/
theorem a7V1_eq_v1sub : a7V1 = v1sub := by
  rw [show a7V1 = Subgroup.closure ({a7Invol, a7D1} : Set (alternatingGroup (Fin 7))) from rfl,
    closure_pair_v1]

/-- `V₂` is the closure of `t = (0 1)(2 3)` and `(0 1)(4 5)`. -/
theorem a7V2_eq_v2sub : a7V2 = v2sub := by
  rw [show a7V2 = Subgroup.closure ({a7Invol, a7D2} : Set (alternatingGroup (Fin 7))) from rfl,
    closure_pair_v2]

/-! ## `V₁` and `V₂` are Klein four-groups -/

theorem isFourGroup_v1sub : Work.GW2.IsFourGroup v1sub := by
  constructor
  · have h1 : Nat.card v1sub =
        ({x : alternatingGroup (Fin 7) | x = 1 ∨ x = a7Invol ∨ x = a7D1 ∨ x = a7Invol * a7D1}
          : Set (alternatingGroup (Fin 7))).ncard := Nat.card_coe_set_eq _
    rw [h1]
    have hset :
        ({x : alternatingGroup (Fin 7) | x = 1 ∨ x = a7Invol ∨ x = a7D1 ∨ x = a7Invol * a7D1}
            : Set (alternatingGroup (Fin 7))) =
          ↑({1, a7Invol, a7D1, a7Invol * a7D1} : Finset (alternatingGroup (Fin 7))) := by
      ext x; simp
    rw [hset, Set.ncard_coe_finset]
    decide
  · intro v hv
    rcases hv with rfl | rfl | rfl | rfl <;> decide

theorem isFourGroup_v2sub : Work.GW2.IsFourGroup v2sub := by
  constructor
  · have h1 : Nat.card v2sub =
        ({x : alternatingGroup (Fin 7) | x = 1 ∨ x = a7Invol ∨ x = a7D2 ∨ x = a7Invol * a7D2}
          : Set (alternatingGroup (Fin 7))).ncard := Nat.card_coe_set_eq _
    rw [h1]
    have hset :
        ({x : alternatingGroup (Fin 7) | x = 1 ∨ x = a7Invol ∨ x = a7D2 ∨ x = a7Invol * a7D2}
            : Set (alternatingGroup (Fin 7))) =
          ↑({1, a7Invol, a7D2, a7Invol * a7D2} : Finset (alternatingGroup (Fin 7))) := by
      ext x; simp
    rw [hset, Set.ncard_coe_finset]
    decide
  · intro v hv
    rcases hv with rfl | rfl | rfl | rfl <;> decide

/-! ## The elements of `V₁` and `V₂` -/

theorem mem_a7V1 {x : alternatingGroup (Fin 7)} :
    x ∈ a7V1 ↔ x = 1 ∨ x = a7Invol ∨ x = a7D1 ∨ x = a7Invol * a7D1 := by
  rw [a7V1_eq_v1sub]; rfl

theorem mem_a7V2 {x : alternatingGroup (Fin 7)} :
    x ∈ a7V2 ↔ x = 1 ∨ x = a7Invol ∨ x = a7D2 ∨ x = a7Invol * a7D2 := by
  rw [a7V2_eq_v2sub]; rfl

theorem card_a7V1 : Nat.card a7V1 = 4 := by
  rw [a7V1_eq_v1sub]; exact isFourGroup_v1sub.1

theorem card_a7V2 : Nat.card a7V2 = 4 := by
  rw [a7V2_eq_v2sub]; exact isFourGroup_v2sub.1

/-! ## The requested statement -/

theorem isFourGroup_V1_V2 : Work.GW2.IsFourGroup a7V1 ∧ Work.GW2.IsFourGroup a7V2 := by
  rw [a7V1_eq_v1sub, a7V2_eq_v2sub]
  exact ⟨isFourGroup_v1sub, isFourGroup_v2sub⟩

end Work.A7F
