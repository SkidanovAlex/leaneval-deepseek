/-
Area A7F: the structure of the model Sylow `2`-subgroup `a7S0 = ⟨(0 1 2 3)(5 6), (0 1)(2 3)⟩`
of `A₇`.

The three facts recorded here are exactly what is needed to recognise `a7S0` as a dihedral group
of order `8`:

* `Nat.card a7S0 = 8`,
* `orderOf a7FourCycle = 4`,
* `a7Invol` inverts `a7FourCycle`, i.e. `a7Invol * a7FourCycle * a7Invol⁻¹ = a7FourCycle⁻¹`.

The second and third are computations in the concrete permutation group `A₇` (`decide`).

For the order, `a7S0` is by definition `⟨a7FourCycle, a7Invol⟩`, and the two abstract
group-theoretic bounds on such a subgroup are proved in the sibling files of this area:

* `Work.A7F.nat_card_closure_pair_le_eight` (upper bound): in any group, if `x` has order `4` and
  `t` is an involution with `t * x * t⁻¹ = x⁻¹`, then `⟨x, t⟩` is a quotient of the dihedral
  group of order `8`, so `Nat.card ⟨x, t⟩ ≤ 8`.
* `Work.A7F.le_nat_card_closure_pair` (lower bound): if moreover `t ∉ ⟨x⟩`, then `⟨x⟩` is a
  proper subgroup of `⟨x, t⟩` of order `4`, so by Lagrange `Nat.card ⟨x, t⟩ ≥ 8`.

The concrete hypotheses of both are checked here (`orderOf_a7FourCycle`, `a7Invol_mul_self`,
`a7Invol_conj_a7FourCycle`, and `a7Invol_notMem_zpowers`), and the two bounds pin the order of
`a7S0` down to `8`.
-/
import Mathlib
import Submission.Work.A7F.Defs
import Submission.Work.A7F.nat_card_closure_pair_le_eight
import Submission.Work.A7F.le_nat_card_closure_pair

open scoped MatrixGroups

namespace Work.A7F

open Subgroup

/-! ### The concrete computations in `A₇` -/

/-- The model `4`-cycle `(0 1 2 3)(5 6)` has order `4`. -/
theorem orderOf_a7FourCycle : orderOf a7FourCycle = 4 := by
  rw [orderOf_eq_iff (by norm_num)]
  exact ⟨by decide, fun m hm _ => by interval_cases m <;> decide⟩

/-- The model involution `(0 1)(2 3)` is an involution. -/
theorem a7Invol_mul_self : a7Invol * a7Invol = 1 := by decide

/-- The model involution inverts the model `4`-cycle: this is the relation which makes `a7S0`
dihedral. -/
theorem a7Invol_conj_a7FourCycle :
    a7Invol * a7FourCycle * a7Invol⁻¹ = a7FourCycle⁻¹ := by decide

/-- `a7Invol` is not a power of `a7FourCycle`: equivalently, `a7S0` is not the cyclic group of
order `4`.  (`a7Invol * a7FourCycle` and `a7FourCycle * a7Invol` are both in `a7S0` and they are
different.) -/
theorem a7Invol_notMem_zpowers : a7Invol ∉ Subgroup.zpowers a7FourCycle := by
  intro h
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp h
  have hcomm : a7Invol * a7FourCycle = a7FourCycle * a7Invol := by
    rw [← hk]
    group
  exact absurd hcomm (by decide)

/-- The eight elements `a7FourCycle ^ i * a7Invol ^ j` (`i : Fin 4`, `j : Fin 2`) are pairwise
different: this is the explicit list of the eight elements of the subgroup `a7S0`, namely
`1, x, x², x³, t, x * t, x² * t, x³ * t` for `x = a7FourCycle`, `t = a7Invol`. -/
theorem a7S0_param_injective :
    Function.Injective (fun p : Fin 4 × Fin 2 =>
      (a7FourCycle : alternatingGroup (Fin 7)) ^ ((p.1 : ℕ) : ℤ) *
        a7Invol ^ ((p.2 : ℕ) : ℤ)) := by
  decide

/-! ### The two bounds in `A₇` -/

/-- `a7S0` has at least `8` elements: it contains `⟨a7FourCycle⟩` of order `4` as a proper
subgroup, since `a7Invol ∈ a7S0` is not a power of `a7FourCycle`. -/
theorem card_a7S0_ge_eight : 8 ≤ Nat.card a7S0 := by
  change 8 ≤ Nat.card (Subgroup.closure ({a7FourCycle, a7Invol} :
    Set (alternatingGroup (Fin 7))))
  exact le_nat_card_closure_pair a7FourCycle a7Invol orderOf_a7FourCycle a7Invol_mul_self
    a7Invol_notMem_zpowers

/-- `a7S0` has at most `8` elements: it is generated by the element `a7FourCycle` of order `4`
and the involution `a7Invol` inverting it. -/
theorem card_a7S0_le_eight : Nat.card a7S0 ≤ 8 := by
  change Nat.card (Subgroup.closure ({a7FourCycle, a7Invol} :
    Set (alternatingGroup (Fin 7)))) ≤ 8
  exact nat_card_closure_pair_le_eight a7FourCycle a7Invol orderOf_a7FourCycle
    a7Invol_mul_self a7Invol_conj_a7FourCycle

/-! ### The structure of `a7S0` -/

/-- **The model Sylow `2`-subgroup `a7S0 = ⟨(0 1 2 3)(5 6), (0 1)(2 3)⟩` of `A₇` has order `8`,
its generator `(0 1 2 3)(5 6)` has order `4`, and the involution `(0 1)(2 3)` inverts it.** -/
theorem a7S0_structure : Nat.card a7S0 = 8 ∧ orderOf a7FourCycle = 4 ∧
    a7Invol * a7FourCycle * a7Invol⁻¹ = a7FourCycle⁻¹ := by
  refine ⟨le_antisymm card_a7S0_le_eight card_a7S0_ge_eight, orderOf_a7FourCycle,
    a7Invol_conj_a7FourCycle⟩

end Work.A7F
