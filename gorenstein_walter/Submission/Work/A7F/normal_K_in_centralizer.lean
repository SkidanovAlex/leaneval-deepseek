/-
Area A7F of the Gorenstein--Walter project: `K = O(C_{A₇}(t))` is normal in `C_{A₇}(t)`.

Here `t = (0 1)(2 3)` is the model involution of `A₇` and `K = ⟨(4 5 6)⟩` the largest normal
subgroup of odd order of its centralizer.  The statement

`Work.A7F.normal_K_in_centralizer : (a7K.subgroupOf C_{A₇}(t)).Normal`

is proved by exhibiting a small generating set of the centralizer `C = C_{A₇}(t)`, namely

* `t = (0 1)(2 3)`            (`a7Invol`),
* `(0 2)(1 3)`                (`a7D1`), the second generator of the Klein four-group `V₁`,
* `(4 5 6)`                   (`a7Kgen`), the generator of `K`,
* `(0 1)(4 5)`                (`a7D2`), an element interchanging the two `2`-cycles of `t`,

and checking on these four generators that they normalize `K = ⟨(4 5 6)⟩`:

* `t` and `(0 2)(1 3)` have support inside `{0,1,2,3}` and hence centralize `(4 5 6)`,
* `(4 5 6)` certainly normalizes `⟨(4 5 6)⟩`,
* `(0 1)(4 5)` conjugates `(4 5 6)` to `(4 5 6)²`.

That the four generators really generate the whole centralizer is a finite computation in `A₇`:
the twenty-four products `t^a d^b c^k w^l` (`a, b ∈ {0,1}`, `k ∈ {0,1,2}`, `l ∈ {0,1}`) are
pairwise different (`a7Cent_param_injective`, discharged by `decide`), so the closure has at least
`24 = |C|` elements (`card_centralizer_a7Invol`); it is contained in `C` because each generator
centralizes `t`.
-/
import Mathlib
import Submission.Work.A7F.Defs
import Submission.Work.A7F.isFourGroup_V1_V2
import Submission.Work.A7F.card_centralizer_a7Invol

open scoped MatrixGroups

namespace Work.A7F

open Subgroup

/-- The generator `(4 5 6)` of `K = O(C_{A₇}(t))`; the abbreviation is local to this file. -/
private abbrev a7Kgen : alternatingGroup (Fin 7) := Work.A7.a7ThreeCycle

/-! ## A general normalizer criterion -/

/-- **If the conjugate of `c` by `x` lies in `⟨c⟩`, then `x` normalizes `⟨c⟩`.**  In a finite
group the conjugation map `y ↦ x y x⁻¹` is a bijection sending `⟨c⟩` into `⟨c⟩`, hence onto
`⟨c⟩`. -/
private theorem mem_normalizer_zpowers_of {G : Type*} [Group G] [Finite G] {x c : G}
    (h : x * c * x⁻¹ ∈ Subgroup.zpowers c) :
    x ∈ Subgroup.normalizer (Subgroup.zpowers c : Set G) := by
  have hconj : (MulAut.conj x) c ∈ Subgroup.zpowers c := by
    rwa [MulAut.conj_apply]
  -- conjugation by `x` maps `⟨c⟩` onto itself
  have hmap : (Subgroup.zpowers c).map (MulAut.conj x).toMonoidHom = Subgroup.zpowers c := by
    refine Subgroup.eq_of_le_of_card_ge ?_ ?_
    · rw [Subgroup.map_le_iff_le_comap, Subgroup.zpowers_le, Subgroup.mem_comap]
      exact hconj
    · rw [Subgroup.card_map_of_injective (MulAut.conj x).injective]
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    have hmem : (MulAut.conj x) y ∈ (Subgroup.zpowers c).map (MulAut.conj x).toMonoidHom :=
      Subgroup.mem_map_of_mem _ hy
    rwa [hmap] at hmem
  · intro hy
    have hmem : (MulAut.conj x) y ∈ (Subgroup.zpowers c).map (MulAut.conj x).toMonoidHom := by
      rw [hmap, MulAut.conj_apply]
      exact hy
    rw [Subgroup.mem_map] at hmem
    obtain ⟨z, hz, hzy⟩ := hmem
    have hzy' : z = y := (MulAut.conj x).injective hzy
    rwa [hzy'] at hz

/-! ## The four generators of `C_{A₇}(t)` -/

/-- The four proposed generators of `C_{A₇}(t)` all centralize `t = (0 1)(2 3)`. -/
private theorem gens_subset_centralizer :
    ({a7Invol, a7D1, a7Kgen, a7D2} : Set (alternatingGroup (Fin 7))) ⊆
      Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))) := by
  rintro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl <;>
    exact Subgroup.mem_centralizer_singleton_iff.mpr (by decide)

/-- The twenty-four products `t^a d^b c^k w^l` (`a, b ∈ {0,1}`, `k ∈ {0,1,2}`, `l ∈ {0,1}`) are
pairwise different; a finite computation in `A₇`. -/
private theorem a7Cent_param_injective :
    Function.Injective (fun p : Fin 2 × Fin 2 × Fin 3 × Fin 2 =>
      a7Invol ^ (p.1 : ℕ) * a7D1 ^ (p.2.1 : ℕ) * a7Kgen ^ (p.2.2.1 : ℕ) *
        a7D2 ^ (p.2.2.2 : ℕ)) := by
  decide

/-- **The centralizer of `t = (0 1)(2 3)` in `A₇` is generated by `t`, `(0 2)(1 3)`, `(4 5 6)`
and `(0 1)(4 5)`.** -/
private theorem closure_eq_centralizer :
    Subgroup.closure ({a7Invol, a7D1, a7Kgen, a7D2} : Set (alternatingGroup (Fin 7))) =
      Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))) := by
  refine Subgroup.eq_of_le_of_card_ge ?_ ?_
  · rw [Subgroup.closure_le]
    exact gens_subset_centralizer
  · -- `|C| = 24 ≤ #(closure)`, since the closure contains the twenty-four distinct products
    rw [card_centralizer_a7Invol]
    have hmem : ∀ p : Fin 2 × Fin 2 × Fin 3 × Fin 2,
        a7Invol ^ (p.1 : ℕ) * a7D1 ^ (p.2.1 : ℕ) * a7Kgen ^ (p.2.2.1 : ℕ) *
          a7D2 ^ (p.2.2.2 : ℕ) ∈
        Subgroup.closure ({a7Invol, a7D1, a7Kgen, a7D2} : Set (alternatingGroup (Fin 7))) := by
      intro p
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
        (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _)
        (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _))
        (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _))
        (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _)
    have hinj : Function.Injective (fun p : Fin 2 × Fin 2 × Fin 3 × Fin 2 =>
        (⟨a7Invol ^ (p.1 : ℕ) * a7D1 ^ (p.2.1 : ℕ) * a7Kgen ^ (p.2.2.1 : ℕ) *
            a7D2 ^ (p.2.2.2 : ℕ), hmem p⟩ :
          Subgroup.closure ({a7Invol, a7D1, a7Kgen, a7D2} : Set (alternatingGroup (Fin 7))))) :=
      fun p q hpq => a7Cent_param_injective (Subtype.ext_iff.mp hpq)
    have h24 : Nat.card (Fin 2 × Fin 2 × Fin 3 × Fin 2) ≤
        Nat.card (Subgroup.closure
          ({a7Invol, a7D1, a7Kgen, a7D2} : Set (alternatingGroup (Fin 7)))) :=
      Nat.card_le_card_of_injective _ hinj
    have hcard : Nat.card (Fin 2 × Fin 2 × Fin 3 × Fin 2) = 24 := by
      simp
    rw [hcard] at h24
    exact h24

/-! ## The generators normalize `K = ⟨(4 5 6)⟩` -/

/-- Each of the four generators of `C_{A₇}(t)` normalizes `K = ⟨(4 5 6)⟩`. -/
private theorem gens_normalize :
    Subgroup.closure ({a7Invol, a7D1, a7Kgen, a7D2} : Set (alternatingGroup (Fin 7))) ≤
      Subgroup.normalizer (Subgroup.zpowers a7Kgen : Set (alternatingGroup (Fin 7))) := by
  rw [Subgroup.closure_le]
  rintro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl
  · refine mem_normalizer_zpowers_of (c := a7Kgen) ?_
    rw [show a7Invol * a7Kgen * a7Invol⁻¹ = a7Kgen from by decide]
    exact Subgroup.mem_zpowers _
  · refine mem_normalizer_zpowers_of (c := a7Kgen) ?_
    rw [show a7D1 * a7Kgen * a7D1⁻¹ = a7Kgen from by decide]
    exact Subgroup.mem_zpowers _
  · refine mem_normalizer_zpowers_of (c := a7Kgen) ?_
    rw [show a7Kgen * a7Kgen * a7Kgen⁻¹ = a7Kgen from by decide]
    exact Subgroup.mem_zpowers _
  · refine mem_normalizer_zpowers_of (c := a7Kgen) ?_
    rw [show a7D2 * a7Kgen * a7D2⁻¹ = a7Kgen * a7Kgen from by decide]
    exact Subgroup.mul_mem _ (Subgroup.mem_zpowers _) (Subgroup.mem_zpowers _)

/-! ## The requested statement -/

/-- **`K = O(C_{A₇}(t)) = ⟨(4 5 6)⟩` is normal in the centralizer of the model involution
`t = (0 1)(2 3)` of `A₇`.** -/
theorem normal_K_in_centralizer :
    (a7K.subgroupOf (Subgroup.centralizer ({a7Invol} : Set (alternatingGroup (Fin 7))))).Normal := by
  refine Subgroup.normal_subgroupOf_of_le_normalizer ?_
  rw [← closure_eq_centralizer]
  exact gens_normalize

end Work.A7F
