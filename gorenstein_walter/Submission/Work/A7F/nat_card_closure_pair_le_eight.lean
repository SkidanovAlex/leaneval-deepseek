import Mathlib

/-!
# The subgroup generated by a `4`-element and an inverting involution has order at most `8`

If `x` has order `4`, `t` is an involution (`t * t = 1`) and `t` inverts `x`
(`t * x * t⁻¹ = x⁻¹`), then `⟨x, t⟩` is a quotient of the dihedral group of order `8`.

The proof builds the monoid homomorphism `φ : DihedralGroup 4 →* G` given by
`r i ↦ x ^ i` and `sr i ↦ x ^ (-i) * t` by hand (Mathlib has no universal property for
`DihedralGroup`).  Its range contains `x` and `t`, hence contains `⟨x, t⟩`; every element of
`⟨x, t⟩` therefore has a preimage in the finite group `DihedralGroup 4` of cardinality `8`,
which bounds `Nat.card ⟨x, t⟩` by `8`.
-/

namespace Work.A7F

open DihedralGroup

/-- `a ^ m = a ^ n` (integer exponents) whenever `m ≡ n (mod 4)`, for `a` of order `4`. -/
private lemma zpow_eq_of_cast_eq {G : Type*} [Group G] {a : G} (ha : orderOf a = 4) {m n : ℤ}
    (h : (m : ZMod 4) = (n : ZMod 4)) : a ^ m = a ^ n := by
  rw [zpow_eq_zpow_iff_modEq, ha]
  exact (ZMod.intCast_eq_intCast_iff m n 4).mp h

/-- `i.val`, read back in `ZMod 4`, is `i`. -/
private lemma intCast_val (i : ZMod 4) : (((i.val : ℕ) : ℤ) : ZMod 4) = i := by
  rw [Int.cast_natCast, ZMod.natCast_zmod_val]

/-- Conjugation by `b` inverts every power of `a`. -/
private lemma b_conj_pow {G : Type*} [Group G] {a b : G} (hbab : b * a * b⁻¹ = a⁻¹) (k : ℤ) :
    b * a ^ k * b⁻¹ = a ^ (-k) := by
  have hconj : MulAut.conj b a = a⁻¹ := by
    rw [MulAut.conj_apply]; exact hbab
  calc b * a ^ k * b⁻¹ = MulAut.conj b (a ^ k) := by rw [MulAut.conj_apply]
    _ = (MulAut.conj b a) ^ k := map_zpow _ _ _
    _ = (a⁻¹) ^ k := by rw [hconj]
    _ = a ^ (-k) := by rw [zpow_neg, inv_zpow]

/-- The relation `b a ^ k = a ^ (-k) b`, i.e. `b` conjugates powers of `a` to their inverses. -/
private lemma b_mul_zpow {G : Type*} [Group G] {a b : G} (hbab : b * a * b⁻¹ = a⁻¹) (k : ℤ) :
    b * a ^ k = a ^ (-k) * b := by
  have h : b * a ^ k * b⁻¹ = a ^ (-k) := b_conj_pow hbab k
  rw [← h, mul_assoc, inv_mul_cancel, mul_one]

/-- The underlying function of the map `DihedralGroup 4 → G` with `r i ↦ a ^ i`,
`sr i ↦ a ^ (-i) * b`. -/
private noncomputable def toG {G : Type*} [Group G] (a b : G) : DihedralGroup 4 → G
  | DihedralGroup.r i => a ^ (i.val : ℤ)
  | DihedralGroup.sr i => a ^ (-(i.val : ℤ)) * b

@[simp] private lemma toG_r {G : Type*} [Group G] (a b : G) (i : ZMod 4) :
    toG a b (DihedralGroup.r i) = a ^ (i.val : ℤ) := rfl

@[simp] private lemma toG_sr {G : Type*} [Group G] (a b : G) (i : ZMod 4) :
    toG a b (DihedralGroup.sr i) = a ^ (-(i.val : ℤ)) * b := rfl

/-- The monoid homomorphism `DihedralGroup 4 →* G`, `r i ↦ a ^ i`, `sr i ↦ a ^ (-i) * b`. -/
private noncomputable def toGHom {G : Type*} [Group G] (a b : G) (ha : orderOf a = 4)
    (hb2 : b * b = 1) (hbab : b * a * b⁻¹ = a⁻¹) : DihedralGroup 4 →* G where
  toFun := toG a b
  map_one' := by
    rw [DihedralGroup.one_def, toG_r, ZMod.val_zero]
    simp
  map_mul' := by
    intro x y
    rcases x with i | i <;> rcases y with j | j
    · -- `r i * r j = r (i + j)`
      rw [DihedralGroup.r_mul_r, toG_r, toG_r, toG_r, ← zpow_add]
      apply zpow_eq_of_cast_eq ha
      rw [intCast_val (i + j), Int.cast_add, intCast_val i, intCast_val j]
    · -- `r i * sr j = sr (j - i)`
      rw [DihedralGroup.r_mul_sr, toG_sr, toG_r, toG_sr, ← mul_assoc, ← zpow_add,
        mul_right_cancel_iff]
      apply zpow_eq_of_cast_eq ha
      rw [Int.cast_neg, intCast_val (j - i), Int.cast_add, Int.cast_neg, intCast_val i,
        intCast_val j]
      ring
    · -- `sr i * r j = sr (i + j)`
      rw [DihedralGroup.sr_mul_r, toG_sr, toG_sr, toG_r, mul_assoc, b_mul_zpow hbab,
        ← mul_assoc, ← zpow_add, mul_right_cancel_iff]
      apply zpow_eq_of_cast_eq ha
      rw [Int.cast_neg, intCast_val (i + j), Int.cast_add, Int.cast_neg, Int.cast_neg,
        intCast_val i, intCast_val j]
      ring
    · -- `sr i * sr j = r (j - i)`
      rw [DihedralGroup.sr_mul_sr, toG_r, toG_sr, toG_sr,
        mul_assoc (a ^ (-(i.val : ℤ))) b (a ^ (-(j.val : ℤ)) * b),
        (mul_assoc b (a ^ (-(j.val : ℤ))) b).symm, b_mul_zpow hbab, neg_neg,
        mul_assoc (a ^ (j.val : ℤ)) b b, hb2, mul_one, ← zpow_add]
      apply zpow_eq_of_cast_eq ha
      rw [intCast_val (j - i), Int.cast_add, Int.cast_neg, intCast_val i, intCast_val j]
      ring

theorem nat_card_closure_pair_le_eight {G : Type*} [Group G] (x t : G)
    (hx : orderOf x = 4) (ht : t * t = 1) (hc : t * x * t⁻¹ = x⁻¹) :
    Nat.card (Subgroup.closure ({x, t} : Set G)) ≤ 8 := by
  let φ := toGHom x t hx ht hc
  -- `φ` maps `DihedralGroup 4` onto a subgroup containing `x` and `t`.
  have hsub : ({x, t} : Set G) ⊆ ↑φ.range := by
    intro y hy
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with h | h
    · rw [h]
      exact ⟨DihedralGroup.r 1, by
        show toG x t (DihedralGroup.r 1) = x
        rw [toG_r, show (1 : ZMod 4).val = 1 from by decide]
        simp⟩
    · rw [h]
      exact ⟨DihedralGroup.sr 0, by
        show toG x t (DihedralGroup.sr 0) = t
        rw [toG_sr, ZMod.val_zero]
        simp⟩
  have hle : Subgroup.closure ({x, t} : Set G) ≤ φ.range := (Subgroup.closure_le φ.range).mpr hsub
  -- Every element of `⟨x, t⟩` therefore has a preimage under `φ`.
  have hmem : ∀ g : Subgroup.closure ({x, t} : Set G), ∃ d : DihedralGroup 4, φ d = (g : G) := by
    intro g
    have hg : (g : G) ∈ φ.range := hle g.2
    rwa [MonoidHom.mem_range] at hg
  -- Choose such preimages: an injection `⟨x, t⟩ → DihedralGroup 4`.
  let f : Subgroup.closure ({x, t} : Set G) → DihedralGroup 4 := fun g =>
    Classical.choose (hmem g)
  have hf : ∀ g, φ (f g) = (g : G) := fun g => Classical.choose_spec (hmem g)
  have hinj : Function.Injective f := by
    intro g₁ g₂ h
    apply Subtype.ext
    rw [← hf g₁, ← hf g₂, h]
  have hcard := Nat.card_le_card_of_injective f hinj
  rw [DihedralGroup.nat_card] at hcard
  omega

end Work.A7F
