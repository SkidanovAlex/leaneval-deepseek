import Mathlib

set_option linter.unusedVariables false

namespace Work.A7F

/-- If `x` has order `4` and `t` is an element outside the cyclic subgroup generated by `x`,
then the subgroup generated by `x` and `t` has order at least `8`.

Indeed `⟨x⟩ ≤ ⟨x,t⟩` with `Nat.card ⟨x⟩ = 4`.  Since `t ∈ ⟨x,t⟩ \ ⟨x⟩`, the inclusion
`⟨x⟩ ≤ ⟨x,t⟩` is strict, so `Nat.card ⟨x,t⟩ > 4`; by Lagrange `4 ∣ Nat.card ⟨x,t⟩`, whence
`Nat.card ⟨x,t⟩ ≥ 8`. -/
theorem le_nat_card_closure_pair {G : Type*} [Group G] [Finite G] (x t : G)
    (hx : orderOf x = 4) (ht : t * t = 1) (htx : t ∉ Subgroup.zpowers x) :
    8 ≤ Nat.card (Subgroup.closure ({x, t} : Set G)) := by
  set K := Subgroup.zpowers x
  set H := Subgroup.closure ({x, t} : Set G)
  have hxH : x ∈ H := Subgroup.subset_closure (by simp)
  have htH : t ∈ H := Subgroup.subset_closure (by simp)
  have hKH : K ≤ H := Subgroup.zpowers_le.mpr hxH
  have hne : K ≠ H := by
    intro hEq
    rw [← hEq] at htH
    exact htx htH
  have hlt : K < H := lt_of_le_of_ne hKH hne
  have hcardK : Nat.card K = 4 := by rw [← hx]; exact Nat.card_zpowers x
  -- Lagrange: `Nat.card K = 4` divides `Nat.card H`.
  have hdvd : 4 ∣ Nat.card H := by
    rw [← hcardK]
    have := Subgroup.card_subgroup_dvd_card (K.subgroupOf H)
    rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKH).toEquiv] at this
  -- Strictness of `K < H` upgrades to a strict cardinality inequality.
  have hgt : 4 < Nat.card H := by
    rw [← hcardK]
    have hs : (K : Set G) ⊂ (H : Set G) := by
      rw [Set.ssubset_iff_subset_ne]
      exact ⟨hlt.le, fun hh => hlt.ne (SetLike.coe_injective hh)⟩
    have hfin : (H : Set G).Finite := Set.toFinite _
    simpa using Set.Finite.card_lt_card hfin hs
  obtain ⟨m, hm⟩ := hdvd
  rw [hm] at hgt ⊢
  omega

end Work.A7F
