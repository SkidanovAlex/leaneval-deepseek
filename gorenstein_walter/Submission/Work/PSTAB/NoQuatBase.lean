import Mathlib
import Submission.Work.PSTAB.Defs
import Submission.Work.PSTAB.DihCycShapeDihedral
import Submission.Work.PSTAB.DihCycShapeSubgroup
import Submission.Work.PSTAB.DihCycShapeSurjective

set_option autoImplicit false

open scoped MatrixGroups
open Subgroup

/-!
# `NoQuaternionSectionProp`, part 1: the weak shape and the `2`-group computation

* `dihCycShape_of_isCyclicOrDihedral`: the disjunction of `Work.GW2.DihOrCycSylow` implies
  `DihCycShape` (cyclic groups with witness `⊤`, `DihedralGroup n` via `DihCycShapeDihedral`).
* `noUniqueInv_of_dihCycShape`: in a finite group of `DihCycShape`, a noncyclic `2`-subgroup
  never has a *unique* involution.
-/

namespace Work.PSTAB

/-- `DihCycShape` is invariant under group isomorphisms. -/
theorem dihCycShape_of_mulEquiv {T U : Type*} [Group T] [Group U] (e : T ≃* U)
    (h : DihCycShape T) : DihCycShape U :=
  DihCycShapeSurjective h e.toMonoidHom e.surjective

/-- The disjunction appearing in `Work.GW2.DihOrCycSylow` implies `DihCycShape`. -/
theorem dihCycShape_of_isCyclicOrDihedral {T : Type*} [Group T] (h : IsCyclicOrDihedral T) :
    DihCycShape T := by
  rcases h with hcyc | ⟨n, ⟨e⟩⟩
  · haveI := hcyc
    exact ⟨⊤, Subgroup.normal_top, inferInstance,
      (fun g hg => absurd (Subgroup.mem_top g) hg),
      (fun g _ hg _ => absurd (Subgroup.mem_top g) hg)⟩
  · exact dihCycShape_of_mulEquiv e.symm (DihCycShapeDihedral n)

/-- **The `2`-group computation.** In a finite group of `DihCycShape`, a noncyclic
`2`-subgroup has at least two involutions. -/
theorem noUniqueInv_of_dihCycShape {T : Type*} [Group T] [Finite T] (hT : DihCycShape T)
    (Q : Subgroup T) (hQ : IsPGroup 2 ↥Q) (hnc : ¬ IsCyclic ↥Q) :
    ¬ ∃! z : Q, orderOf z = 2 := by
  obtain ⟨R, hRn, hRc, hsq, hmul⟩ := hT
  haveI : R.Normal := hRn
  intro huniq
  by_cases hQR : Q ≤ R
  · haveI := hRc
    exact hnc (isCyclic_of_le hQR)
  · obtain ⟨g, hgQ, hgR⟩ := SetLike.not_le_iff_exists.mp hQR
    have hg2 : g * g = 1 := by rw [← pow_two]; exact hsq g hgR
    have hg1 : g ≠ 1 := fun h => hgR (h ▸ R.one_mem)
    -- every element of `Q` is either in `R` or `· * g` is in `R`
    have hcoset : ∀ h ∈ Q, h ∈ R ∨ h * g ∈ R := by
      intro h hh
      by_cases hhR : h ∈ R
      · exact Or.inl hhR
      · exact Or.inr (hmul h g hhR hgR)
    by_cases hb : Q ⊓ R = ⊥
    · -- `Q` is cyclic: generated by `g`
      apply hnc
      have hQle : Q ≤ Subgroup.zpowers g := by
        intro h hh
        rcases hcoset h hh with h1 | h1
        · have hmem : h ∈ Q ⊓ R := ⟨hh, h1⟩
          rw [hb] at hmem
          rw [Subgroup.mem_zpowers_iff]
          exact ⟨0, by rw [zpow_zero]; exact (Subgroup.mem_bot.mp hmem).symm⟩
        · have hmem : h * g ∈ Q ⊓ R := ⟨Q.mul_mem hh hgQ, h1⟩
          rw [hb] at hmem
          have h2 : h * g = 1 := Subgroup.mem_bot.mp hmem
          have h3 : h = g := calc h = h * 1 := (mul_one h).symm
            _ = h * (g * g) := by rw [hg2]
            _ = (h * g) * g := by rw [mul_assoc]
            _ = 1 * g := by rw [h2]
            _ = g := one_mul g
          rw [h3, Subgroup.mem_zpowers_iff]
          exact ⟨1, by rw [zpow_one]⟩
      haveI := isCyclic_zpowers g
      exact isCyclic_of_le hQle
    · -- `Q ∩ R` is a nontrivial `2`-group: it contributes a second involution
      haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      have hRQp : IsPGroup 2 ↥(Q ⊓ R) := hQ.to_le inf_le_left
      obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hRQp
      have hk0 : k ≠ 0 := by
        intro h0
        rw [h0, pow_zero] at hk
        exact hb (Subgroup.eq_bot_of_card_eq _ hk)
      have h2dvd : 2 ∣ Nat.card ↥(Q ⊓ R) := by
        rw [hk]
        exact dvd_pow_self 2 hk0
      obtain ⟨z, hzord⟩ := exists_prime_orderOf_dvd_card' (G := ↥(Q ⊓ R)) 2 h2dvd
      have hzQ : (z : T) ∈ Q := z.2.1
      have hzT_ord : orderOf (z : T) = 2 := (Subgroup.orderOf_mk (z : T) z.2).symm.trans hzord
      have hzg : (z : T) ≠ g := fun h => hgR (h ▸ z.2.2)
      obtain ⟨w, _, hwu⟩ := huniq
      have hz_eq : (⟨(z : T), hzQ⟩ : ↥Q) = w :=
        hwu ⟨(z : T), hzQ⟩ ((Subgroup.orderOf_mk (z : T) hzQ).trans hzT_ord)
      have hgord : orderOf (⟨g, hgQ⟩ : ↥Q) = 2 :=
        orderOf_eq_prime (p := 2) (by rw [sq, Subtype.ext_iff]; exact hg2)
          (fun h => hg1 (congrArg Subtype.val h))
      have hg_eq : (⟨g, hgQ⟩ : ↥Q) = w := hwu ⟨g, hgQ⟩ hgord
      exact hzg (Subtype.ext_iff.mp (hz_eq.trans hg_eq.symm))

end Work.PSTAB
