import Mathlib
import Submission.Work.PSTAB.Defs
import Submission.Work.PSTAB.SL2UniqueInvolution
import Submission.Work.PSTAB.CyclicSylowTwoComplement
import Submission.OddOrder.BG.AppA_PStabilityBasic

set_option autoImplicit false
set_option linter.style.haveILetI false

/-!
# `Work.PSTAB.UnipotentSL2`

A finite group `H` acting faithfully and irreducibly on a two-dimensional vector space `V` over
an algebraically closed field `E` of odd characteristic `p`, generated by two nontrivial
_unipotents_ `u`, `v` (`(ρ u - 1) ^ 2 = 0`, `ρ u ≠ 1`, same for `v`), has a non-cyclic
`2`-subgroup with a *unique* involution.

The mathematical content is:

* `(ρ u - 1) ^ 2 = 0` with `ρ u ≠ 1` says that `ρ u - 1` is a square-zero endomorphism, so
  `ρ u = 1 + N` with `N² = 0`; then `(1 + N) ^ k = 1 + k • N` for every `k`, hence `(ρ u) ^ p = 1`
  and — since `ρ` is faithful — `orderOf u = p`.  In particular `p ∣ |H|`.
* The determinant of a nontrivial unipotent is `1`: `(det (ρ u)) ^ p = det ((ρ u) ^ p) = 1` and
  `x ^ p = 1` implies `x = 1` in a field of characteristic `p` (Frobenius).  Since `H` is
  generated by `u` and `v`, _every_ element of `H` has determinant one.
* `|H|` is even: this is BG Appendix A, Theorem A.1
  (`OddOrder.BG.AppA.thmA1`), the two-dimensional faithful irreducible odd-order case,
  combined with `p ∣ |H|`.
* Every involution of `H` is `-1`: an involution of `SL₂` over a field of characteristic `≠ 2`
  equals `-1` (`Work.PSTAB.SL2UniqueInvolution`).  So `H` has a *unique* involution.
* If a Sylow `2`-subgroup were cyclic, Burnside's normal `2`-complement theorem
  (`Work.PSTAB.CyclicSylowTwoComplement`) would put the odd-order elements `u`, `v` in a normal
  subgroup `N` of odd order, hence `H = ⟨u, v⟩ ≤ N` and `|H| = |N|` would be odd — contradiction.
  So a Sylow `2`-subgroup is non-cyclic, and it contains an element of order `2` (Cauchy).

This is the `SL₂`-step of the quadratic-pair argument (`Work.PSTAB.QuadPairIrrProp`).
-/

namespace Work.PSTAB

open Subgroup

/-- If `A` is an endomorphism of an `E`-vector space with `(A - 1) ^ 2 = 0`, where `E` has
characteristic the prime `p`, then `A ^ p = 1`.  Indeed `A = 1 + N` with `N² = 0`, so
`A ^ k = 1 + k • N`, and `p • N = 0`. -/
theorem pow_eq_one_of_sub_one_sq_eq_zero {E : Type*} [Field E] {p : ℕ} [Fact p.Prime]
    [CharP E p] {V : Type*} [AddCommGroup V] [Module E V] (A : Module.End E V)
    (hA : (A - 1) ^ 2 = 0) : A ^ p = 1 := by
  have hN : (A - 1) * (A - 1) = 0 := by rw [← pow_two]; exact hA
  have hbase : (1 : Module.End E V) + (A - 1) = A := by rw [add_comm, sub_add_cancel]
  have hkey : ∀ k : ℕ, ((1 : Module.End E V) + (A - 1)) ^ k = 1 + k • (A - 1) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, ih, add_mul, one_mul, mul_add, mul_one, smul_mul_assoc, hN, smul_zero,
        add_zero, succ_nsmul]
      abel
  have hpN : p • (A - 1) = 0 := by
    rw [nsmul_eq_mul]
    have hpc : (p : Module.End E V) = 0 := by
      rw [← map_natCast (algebraMap E (Module.End E V)) p, CharP.cast_eq_zero, map_zero]
    rw [hpc, zero_mul]
  rw [← hbase, hkey p, hpN, add_zero]

/-- If a faithful representation over a field of characteristic the prime `p` sends `u` to a
nontrivial unipotent element (`(ρ u - 1) ^ 2 = 0` and `ρ u ≠ 1`), then `u` has order `p`. -/
theorem orderOf_eq_prime_of_unipotent {E : Type*} [Field E] {p : ℕ} [Fact p.Prime] [CharP E p]
    {H : Type*} [Group H] {V : Type*} [AddCommGroup V] [Module E V]
    (ρ : Representation E H V) (hρ : Function.Injective ρ) (u : H)
    (hu : ((ρ u : Module.End E V) - 1) ^ 2 = 0) (hune : ρ u ≠ 1) :
    orderOf u = p := by
  have hAp : (ρ u : Module.End E V) ^ p = 1 := pow_eq_one_of_sub_one_sq_eq_zero _ hu
  have hup : u ^ p = 1 := by
    apply hρ
    rw [map_pow, map_one]
    exact hAp
  have hdvd : orderOf u ∣ p := orderOf_dvd_of_pow_eq_one hup
  have hne : orderOf u ≠ 1 := by
    intro h
    have hu1 : u = 1 := orderOf_eq_one_iff.mp h
    exact hune (by rw [hu1, map_one])
  rcases (Fact.out : Nat.Prime p).eq_one_or_self_of_dvd (orderOf u) hdvd with h | h
  · exact absurd h hne
  · exact h

/-- The determinant of a nontrivial unipotent endomorphism, over a field of characteristic the
prime `p`, is `1`. -/
theorem det_eq_one_of_unipotent {E : Type*} [Field E] {p : ℕ} [Fact p.Prime] [CharP E p]
    {H : Type*} [Group H] {V : Type*} [AddCommGroup V] [Module E V]
    (ρ : Representation E H V) (u : H) (hu : ((ρ u : Module.End E V) - 1) ^ 2 = 0) :
    LinearMap.det (ρ u : Module.End E V) = 1 := by
  have hAp : (ρ u : Module.End E V) ^ p = 1 := pow_eq_one_of_sub_one_sq_eq_zero _ hu
  have hpow : (LinearMap.det (ρ u : Module.End E V)) ^ p = 1 := by
    rw [← map_pow (LinearMap.det) (ρ u : Module.End E V) p, hAp, map_one]
  have hzero : (LinearMap.det (ρ u : Module.End E V) - 1) ^ p = 0 := by
    rw [sub_pow_char, hpow, one_pow, sub_self]
  exact sub_eq_zero.mp ((pow_eq_zero_iff (show p ≠ 0 by
    have h1 := (Fact.out : Nat.Prime p).one_lt
    omega)).mp hzero)

/-- **Determinants on the subgroup generated by two unipotents.**  If `u` and `v` act as
nontrivial unipotents, then every element of the subgroup they generate has determinant `1`. -/
theorem det_eq_one_of_mem_closure {E : Type*} [Field E] {p : ℕ} [Fact p.Prime] [CharP E p]
    {H : Type*} [Group H] {V : Type*} [AddCommGroup V] [Module E V]
    (ρ : Representation E H V) (u v : H)
    (hu : ((ρ u : Module.End E V) - 1) ^ 2 = 0)
    (hv : ((ρ v : Module.End E V) - 1) ^ 2 = 0) :
    ∀ h ∈ Subgroup.closure ({u, v} : Set H), LinearMap.det (ρ h : Module.End E V) = 1 := by
  intro h hh
  refine Subgroup.closure_induction ?_ ?_ ?_ ?_ hh
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with hx | hx
    · rw [hx]; exact det_eq_one_of_unipotent ρ u hu
    · rw [hx]; exact det_eq_one_of_unipotent ρ v hv
  · simp
  · intro x y _ _ ihx ihy
    simp only [map_mul, ihx, ihy, mul_one]
  · intro x _ ihx
    have hmul : (ρ x⁻¹ : Module.End E V) * (ρ x : Module.End E V) = 1 := by
      rw [← map_mul, inv_mul_cancel, map_one]
    have h2 : LinearMap.det (ρ x⁻¹ : Module.End E V)
        * LinearMap.det (ρ x : Module.End E V) = 1 := by
      rw [← map_mul, hmul, map_one]
    rw [ihx, mul_one] at h2
    exact h2

theorem UnipotentSL2 {E : Type*} [Field E] [IsAlgClosed E] {p : ℕ} [Fact p.Prime] [CharP E p]
    (hp : p ≠ 2) {H : Type*} [Group H] [Finite H] {V : Type*} [AddCommGroup V] [Module E V]
    [Module.Finite E V] [Module.Free E V] (hdim : Module.finrank E V = 2)
    (ρ : Representation E H V) (hρ : Function.Injective ρ)
    (hirr : ∀ W : Submodule E V, (∀ h : H, ∀ v ∈ W, ρ h v ∈ W) → W = ⊥ ∨ W = ⊤)
    (u v : H) (hu : ((ρ u : Module.End E V) - 1) ^ 2 = 0) (hune : ρ u ≠ 1)
    (hv : ((ρ v : Module.End E V) - 1) ^ 2 = 0) (hvne : ρ v ≠ 1)
    (hgen : Subgroup.closure ({u, v} : Set H) = ⊤) :
    ∃ Q : Subgroup H, IsPGroup 2 Q ∧ ¬ IsCyclic Q ∧ ∃! z : Q, orderOf z = 2 := by
  classical
  -- (0) the characteristic is not `2`
  have h2 : (2 : E) ≠ 0 := by
    intro h
    have hdvd : p ∣ 2 := (CharP.cast_eq_zero_iff E p 2).mp h
    exact hp ((Nat.prime_dvd_prime_iff_eq (Fact.out : Nat.Prime p) Nat.prime_two).mp hdvd)
  -- (1) `u` and `v` have order `p`
  have hou : orderOf u = p := orderOf_eq_prime_of_unipotent ρ hρ u hu hune
  have hov : orderOf v = p := orderOf_eq_prime_of_unipotent ρ hρ v hv hvne
  -- (2) `p` divides `|H|`
  have hpdvd : p ∣ Nat.card H := by rw [← hou]; exact orderOf_dvd_natCard u
  -- (3) `|H|` is even (BG Appendix A, Theorem A.1)
  have hnotodd : ¬ Odd (Nat.card H) := fun hodd =>
    OddOrder.BG.AppA.thmA1 hodd hdim ρ hρ hirr hpdvd
  -- (4) every element of `H` has determinant `1`
  have hdet : ∀ h : H, LinearMap.det (ρ h : Module.End E V) = 1 := fun h =>
    det_eq_one_of_mem_closure ρ u v hu hv h (by rw [hgen]; exact Subgroup.mem_top h)
  -- (5) `H` has at most one involution, and it is `-1`
  have huniq : ∀ z z' : H, z ^ 2 = 1 → z ≠ 1 → z' ^ 2 = 1 → z' ≠ 1 → z = z' := by
    intro z z' hz hz1 hz' hz'1
    have hz_neg : (ρ z : Module.End E V) = -1 := by
      refine SL2UniqueInvolution h2 hdim ?_ ?_ (hdet z)
      · rw [← map_mul, ← pow_two, hz, map_one]
      · intro h
        exact hz1 (hρ (by rw [h, map_one]))
    have hz'_neg : (ρ z' : Module.End E V) = -1 := by
      refine SL2UniqueInvolution h2 hdim ?_ ?_ (hdet z')
      · rw [← map_mul, ← pow_two, hz', map_one]
      · intro h
        exact hz'1 (hρ (by rw [h, map_one]))
    exact hρ (hz_neg.trans hz'_neg.symm)
  -- (6) a Sylow `2`-subgroup of `H`
  obtain ⟨P⟩ : Nonempty (Sylow 2 H) := Sylow.nonempty
  haveI hfin : Fintype ↥(P : Subgroup H) := Fintype.ofFinite _
  have hcardP : Nat.card ↥(P : Subgroup H) = 2 ^ Nat.factorization (Nat.card H) 2 :=
    Sylow.card_eq_multiplicity P
  have h2dvd : 2 ∣ Nat.card H := even_iff_two_dvd.mp (Nat.not_odd_iff_even.mp hnotodd)
  haveI : Nonempty H := ⟨1⟩
  have hfac : 1 ≤ Nat.factorization (Nat.card H) 2 :=
    (Nat.Prime.dvd_iff_one_le_factorization Nat.prime_two (Nat.card_pos (α := H)).ne').mp h2dvd
  have h2P : 2 ∣ Nat.card ↥(P : Subgroup H) := by
    rw [hcardP]
    exact dvd_pow_self 2 (by omega)
  have h2PF : 2 ∣ Fintype.card ↥(P : Subgroup H) := by
    rw [← Nat.card_eq_fintype_card]
    exact h2P
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card (G := ↥(P : Subgroup H)) 2 h2PF
  -- (7) `P` is not cyclic
  have hnotcyc : ¬ IsCyclic ↥(P : Subgroup H) := by
    intro hcyc
    obtain ⟨N, _hNnorm, hNodd, hNmem⟩ := CyclicSylowTwoComplement P hcyc
    have hnot2p : ¬ 2 ∣ p := by
      intro h
      rcases (Fact.out : Nat.Prime p).eq_one_or_self_of_dvd 2 h with h1 | h1
      · omega
      · exact hp h1.symm
    have huN : u ∈ N := hNmem u (by rw [hou]; exact hnot2p)
    have hvN : v ∈ N := hNmem v (by rw [hov]; exact hnot2p)
    have hle : Subgroup.closure ({u, v} : Set H) ≤ N := by
      rw [Subgroup.closure_le]
      intro x hx
      rcases (show x = u ∨ x = v by
        simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hx) with hx | hx
      · rw [hx]; exact huN
      · rw [hx]; exact hvN
    have htop : (⊤ : Subgroup H) ≤ N := by rw [← hgen]; exact hle
    have hNtop : N = ⊤ := le_antisymm le_top htop
    have hoddH : Odd (Nat.card H) := by
      rw [← Subgroup.card_top, ← hNtop]
      exact hNodd
    exact hnotodd hoddH
  -- (8) assembly: the Sylow `2`-subgroup is non-cyclic with the unique involution `z`
  refine ⟨(P : Subgroup H), P.isPGroup', hnotcyc, z, hz, ?_⟩
  intro y hy
  have hy2 : y ^ 2 = 1 := ((orderOf_eq_iff (show 0 < 2 by omega)).mp hy).1
  have hz2 : z ^ 2 = 1 := ((orderOf_eq_iff (show 0 < 2 by omega)).mp hz).1
  have hyne : y ≠ 1 := by
    intro hone
    have h1 : orderOf y = 1 := by rw [orderOf_eq_one_iff]; exact hone
    omega
  have hzne : z ≠ 1 := by
    intro hone
    have h1 : orderOf z = 1 := by rw [orderOf_eq_one_iff]; exact hone
    omega
  have hyH : (y : H) ^ 2 = 1 := by rw [← Subgroup.coe_pow, hy2]; rfl
  have hzH : (z : H) ^ 2 = 1 := by rw [← Subgroup.coe_pow, hz2]; rfl
  have hyHne : (y : H) ≠ 1 := fun hone => hyne (Subtype.ext hone)
  have hzHne : (z : H) ≠ 1 := fun hone => hzne (Subtype.ext hone)
  exact Subtype.ext (huniq (y : H) (z : H) hyH hyHne hzH hzHne)

end Work.PSTAB
