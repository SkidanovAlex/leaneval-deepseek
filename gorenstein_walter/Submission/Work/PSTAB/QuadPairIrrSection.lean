/-!
# `Work.PSTAB.QuadPairIrrSection`

The section-strength irreducible quadratic-pair lemma (`Submission/Work/PSTAB/Defs.lean`).

Given a finite group `L`, an odd prime `p`, a finite faithful irreducible `𝔽_p`-module `V` for `L`
and a `p`-element `x ∈ L` acting quadratically and nontrivially on `V`, the group `L` has a
*section* which is a noncyclic `2`-group with a unique involution.

## Route

* **Baer–Suzuki** (`Work.PSTAB.exists_pair_not_isPGroup`, `QuadPairIrr.lean`): some conjugate
  `y := g * x * g⁻¹` fails to generate a `p`-group together with `x`; put `D := ⟨x, y⟩ ≤ L`, so
  `D` is not a `p`-group.
* **The chief series of `V` as an `𝔽_p[D]`-module** (`Work.PSTAB.invSer` with
  `ρD := ρ.comp D.subtype`): every factor carries the representation `ρᵢ` of `Work.PSTAB.FactorRepTwo`
  induced by `ρD`, which is irreducible, inherits the quadratic condition *for both generators* and
  detects `ρᵢ x = 1`, `ρᵢ y = 1`.
* **A factor on which both `x` and `y` act nontrivially exists.** If `x` acted trivially on every
  factor then, since `D = ⟨x,y⟩` and `y` is a `p`-element, `Work.PSTAB.QuadPairFactorTrivial`
  shows that `y` acts trivially on every factor as well; hence `D ≤ NSub ρD`, which is a `p`-group
  (`Work.PSTAB.NSub_isPGroup`), contradicting `D` not a `p`-group. The same lemma, with the roles
  of `x` and `y` interchanged, upgrades `ρᵢ x ≠ 1` to `ρᵢ y ≠ 1` on the same factor.
* **One composition factor suffices.** `D₁ := D ⧸ ker ρᵢ` is generated by the images of `x` and
  `y`, acts faithfully and irreducibly on the factor, and both generators act as nontrivial
  quadratics. `Work.PSTAB.QuadPairBadSubgroup` (endomorphism field, base change to the algebraic
  closure, BG Theorem A.2, `SL₂`) then produces a noncyclic `2`-subgroup of `D₁` with a unique
  involution — a bad section of `L`.
-/

namespace Work.PSTAB

/-! ## Elementary helpers -/

/-- Conjugation preserves the quadratic condition `(A - 1) ^ 2 = 0` in an arbitrary ring. -/
theorem conj_sub_one_sq_zero {R : Type*} [Ring R] {A A' B : R} (hA : A * A' = 1)
    (hA' : A' * A = 1) (hB : (B - 1) ^ 2 = 0) : (A * B * A' - 1) ^ 2 = 0 := by
  have key : A * (B - 1) * A' = A * B * A' - 1 := by
    rw [mul_sub, sub_mul, mul_one, hA]
  have key2 : (A * (B - 1) * A') ^ 2 = A * ((B - 1) * (B - 1)) * A' := by
    rw [pow_two]
    calc A * (B - 1) * A' * (A * (B - 1) * A')
        = A * (B - 1) * (A' * A) * (B - 1) * A' := by noncomm_ring
      _ = A * ((B - 1) * (B - 1)) * A' := by rw [hA']; noncomm_ring
  rw [← key, key2, ← pow_two, hB]
  simp

/-- The conjugate of a `p`-element generates a `p`-group. -/
theorem isPGroup_zpowers_conj {G : Type*} [Group G] {p : ℕ} {x g : G}
    (h : IsPGroup p (Subgroup.zpowers x)) :
    IsPGroup p (Subgroup.zpowers (g * x * g⁻¹)) := by
  have h2 : IsPGroup p (Subgroup.zpowers (MulAut.conj g x)) := by
    have h3 := h.map (MulAut.conj g : G →* G)
    rwa [MonoidHom.map_zpowers] at h3
  rwa [MulAut.conj_apply] at h2

/-- `g` a `p`-element of `G` implies the corresponding element of a subgroup `H ∋ g` is one. -/
theorem isPGroup_zpowers_coe {G : Type*} [Group G] {p : ℕ} {H : Subgroup G} {g : G}
    (hg : g ∈ H) (h : IsPGroup p (Subgroup.zpowers g)) :
    IsPGroup p (Subgroup.zpowers (⟨g, hg⟩ : H)) := by
  have h2 : IsPGroup p ((Subgroup.zpowers g).comap H.subtype) := h.comap_subtype
  have heq : (Subgroup.zpowers g).comap H.subtype = Subgroup.zpowers (⟨g, hg⟩ : H) := by
    ext a
    rw [Subgroup.mem_comap, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
    constructor
    · rintro ⟨k, hk⟩
      exact ⟨k, Subtype.ext (by rw [Subgroup.coe_zpow]; exact hk)⟩
    · rintro ⟨k, hk⟩
      exact ⟨k, by simpa using congrArg (fun z : ↥H => (z : G)) hk⟩
  rwa [heq] at h2

/-- The factor `U ⧸ W` of a chief series of a finite module is finite. -/
theorem finite_factor {p : ℕ} [Fact p.Prime] {V : Type*} [AddCommGroup V] [Module (ZMod p) V]
    [Finite V] {U W : Submodule (ZMod p) V} : Finite (↥U ⧸ (W.comap U.subtype)) := by
  haveI : Finite ↥U := Subtype.finite
  exact Finite.of_surjective (Submodule.mkQ _) (Submodule.mkQ_surjective _)

/-- Irreducibility in the `∀ Submodule` form is the `Representation.IsIrreducible` type class. -/
theorem isIrreducible_of_forall_submodule {F : Type*} [Field F] {G : Type*} [Monoid G]
    {V : Type*} [AddCommGroup V] [Module F V] [Nontrivial V] (ρ : Representation F G V)
    (hirr : ∀ S : Submodule F V, (∀ g : G, ∀ v ∈ S, ρ g v ∈ S) → S = ⊥ ∨ S = ⊤) :
    ρ.IsIrreducible := by
  have hne : Nontrivial (Subrepresentation ρ) := by
    refine ⟨⊥, ⊤, fun h => ?_⟩
    obtain ⟨v, hv⟩ := exists_ne (0 : V)
    have hmem : v ∈ (⊤ : Subrepresentation ρ) := Submodule.mem_top
    rw [← h] at hmem
    exact hv ((Submodule.mem_bot F).mp hmem)
  refine { exists_pair_ne := hne.exists_pair_ne, eq_bot_or_eq_top := fun W => ?_ }
  rcases hirr W.toSubmodule W.apply_mem_toSubmodule with h | h
  · exact Or.inl (Subrepresentation.toSubmodule_injective (by rw [h]; rfl))
  · exact Or.inr (Subrepresentation.toSubmodule_injective (by rw [h]; rfl))

/-! ## The main theorem -/

theorem QuadPairIrrSection : Work.PSTAB.QuadPairIrrSectionProp := by
  intro L _ _ p _ hp2 V _ _ _ ρ hρ hirr x hx hxq hxne
  classical
  intro hM
  -- ## Step 1: Baer–Suzuki gives a conjugate `y` of `x` with `⟨x, y⟩` not a `p`-group.
  obtain ⟨g, hgnotp⟩ := exists_pair_not_isPGroup ρ hρ hirr hxne
  set y : L := g * x * g⁻¹ with hy_def
  set D : Subgroup L := Subgroup.closure ({x, y} : Set L) with hD_def
  have hDnotp : ¬ IsPGroup p ↥D := hgnotp
  have hxD : x ∈ D := Subgroup.subset_closure (by simp)
  have hyD : y ∈ D := Subgroup.subset_closure (by simp)
  let X : ↥D := ⟨x, hxD⟩
  let Y : ↥D := ⟨y, hyD⟩
  -- ## Step 2: `D = ⟨X, Y⟩` inside `↥D`.
  have hgenXY : Subgroup.closure ({X, Y} : Set ↥D) = ⊤ := by
    have hpre : (D.subtype ⁻¹' ({x, y} : Set L)) = ({X, Y} : Set ↥D) := by
      ext a
      simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff]
      constructor
      · rintro (h | h)
        · exact Or.inl (Subtype.ext h)
        · exact Or.inr (Subtype.ext h)
      · rintro (h | h)
        · exact Or.inl (congrArg Subtype.val h)
        · exact Or.inr (congrArg Subtype.val h)
    rw [← hpre]
    exact Subgroup.closure_preimage_eq_top ({x, y} : Set L)
  -- ## Step 3: both generators are `p`-elements.
  have hyP : IsPGroup p (Subgroup.zpowers y) := by
    rw [hy_def]
    exact isPGroup_zpowers_conj hx
  have hXp : IsPGroup p (Subgroup.zpowers X) := isPGroup_zpowers_coe hxD hx
  have hYp : IsPGroup p (Subgroup.zpowers Y) := isPGroup_zpowers_coe hyD hyP
  -- ## Step 4: `V` as an `𝔽_p[D]`-module, and the quadratic conditions.
  let ρD : Representation (ZMod p) ↥D V := ρ.comp D.subtype
  have hρD : Function.Injective ρD := by
    intro a b hab
    exact Subtype.ext (hρ (by simpa [ρD] using hab))
  have hXq : ((ρD X : Module.End (ZMod p) V) - 1) ^ 2 = 0 := by
    show ((ρ x : Module.End (ZMod p) V) - 1) ^ 2 = 0
    exact hxq
  have hYq : ((ρD Y : Module.End (ZMod p) V) - 1) ^ 2 = 0 := by
    have hYv : (D.subtype Y : L) = g * x * g⁻¹ := by
      show y = g * x * g⁻¹
      exact hy_def
    have hYact : (ρD Y : Module.End (ZMod p) V) = ρ g * ρ x * ρ (g⁻¹) := by
      rw [show (ρD Y : Module.End (ZMod p) V) = ρ (D.subtype Y) from rfl, hYv, map_mul, map_mul]
    have h1 : ρ g * ρ (g⁻¹) = (1 : Module.End (ZMod p) V) := by
      rw [← map_mul, mul_inv_cancel, map_one]
    have h2 : ρ (g⁻¹) * ρ g = (1 : Module.End (ZMod p) V) := by
      rw [← map_mul, inv_mul_cancel, map_one]
    rw [hYact]
    exact conj_sub_one_sq_zero h1 h2 hxq
  -- ## Step 5: the factors of the chief series of `V` as an `𝔽_p[D]`-module.
  have hmax : ∀ (i : ℕ) (S : Submodule (ZMod p) V), RepInv ρD S → invSer ρD (i + 1) ≤ S →
      S ≤ invSer ρD i → S = invSer ρD (i + 1) ∨ S = invSer ρD i := by
    intro i S hS hWS hSU
    by_cases hne : invSer ρD i = ⊥
    · right
      rw [hne] at hSU ⊢
      exact le_bot_iff.mp hSU
    · -- `invSer ρD i ≠ ⊥`
      have hm : mpob ρD (invSer ρD i) ≤ S := by
        rw [← invSer_succ ρD i]
        exact hWS
      have hres := mpob_maximal ρD hne hS hm hSU
      rw [← invSer_succ ρD i] at hres
      exact hres
  -- ## Step 6: `X ∉ NSub ρD`.
  have hX_notmem : X ∉ NSub ρD := by
    intro hXmem
    have hXnf : NFun ρD X := mem_NSub.mp hXmem
    have hsub : (⊤ : Subgroup ↥D) ≤ NSub ρD := by
      rw [← hgenXY, Subgroup.closure_le]
      intro a ha
      rcases (show a = X ∨ a = Y by simpa using ha) with ha | ha
      · rw [ha]
        exact mem_NSub.mpr hXnf
      · rw [ha]
        refine mem_NSub.mpr ?_
        intro i v hv
        obtain ⟨ρi, hirri, _hqiX, hkeriX, _hqiY, hkeriY⟩ :=
          FactorRepTwo ρD (repInv_invSer ρD i) (repInv_invSer ρD (i + 1))
            (invSer_le_self ρD i) (hmax i) X Y hXq hYq
        have hXi : ρi X = 1 := hkeriX.mpr (fun v' hv' => hXnf i v' hv')
        haveI := finite_factor (p := p) (V := V) (U := invSer ρD i) (W := invSer ρD (i + 1))
        exact hkeriY.mp (QuadPairFactorTrivial ρi hirri hgenXY hYp hXi) v hv
    have hpg : IsPGroup p ↥D :=
      IsPGroup.of_equiv ((NSub_isPGroup ρD hρD).to_le hsub) (Subgroup.topEquiv)
    exact hDnotp hpg
  have hXnf : ¬ NFun ρD X := fun h => hX_notmem (mem_NSub.mpr h)
  simp only [NFun] at hXnf
  push Not at hXnf
  obtain ⟨i0, v0, hv0, hiv0⟩ := hXnf
  -- ## Step 7: the factor at `i0`, on which both generators act nontrivially.
  obtain ⟨ρi, hirri, hqiX, hkeriX, hqiY, hkeriY⟩ :=
    FactorRepTwo ρD (repInv_invSer ρD i0) (repInv_invSer ρD (i0 + 1))
      (invSer_le_self ρD i0) (hmax i0) X Y hXq hYq
  have hρiX : ρi X ≠ 1 := fun h1 => hiv0 ((hkeriX.mp h1) v0 hv0)
  have hρiY : ρi Y ≠ 1 := by
    intro hY1
    haveI := finite_factor (p := p) (V := V) (U := invSer ρD i0) (W := invSer ρD (i0 + 1))
    refine hρiX (QuadPairFactorTrivial ρi hirri ?_ hXp hY1)
    rw [Set.pair_comm]
    exact hgenXY
  -- ## Step 8: the quotient `D ⧸ ker ρi` and the induced faithful irreducible representation.
  let K : Subgroup ↥D := ρi.ker
  haveI hKn : K.Normal := MonoidHom.normal_ker ρi
  let W := ↥(invSer ρD i0) ⧸ ((invSer ρD (i0 + 1)).comap (invSer ρD i0).subtype)
  haveI hWfin : Finite W := by
    haveI : Finite ↥(invSer ρD i0) := Subtype.finite
    exact Finite.of_surjective (Submodule.mkQ _) (Submodule.mkQ_surjective _)
  haveI hWfd : FiniteDimensional (ZMod p) W := Module.Finite.of_finite
  haveI hDfin : Finite ↥D := Finite.of_injective (Subtype.val : ↥D → L) (fun _ _ h => Subtype.ext h)
  haveI hQfin : Finite (↥D ⧸ K) :=
    Finite.of_surjective (QuotientGroup.mk' K) (QuotientGroup.mk'_surjective K)
  let ρbar : Representation (ZMod p) (↥D ⧸ K) W := QuotientGroup.lift K ρi (le_refl K)
  have hρbar_mk : ∀ d : ↥D, ρbar (QuotientGroup.mk' K d) = ρi d := fun _ => rfl
  have hρbar_faithful : Function.Injective ρbar := by
    rw [injective_iff_map_eq_one]
    intro z hz
    obtain ⟨d, rfl⟩ := QuotientGroup.mk'_surjective K z
    rw [hρbar_mk] at hz
    exact (QuotientGroup.eq_one_iff d).mpr hz
  have hirrbar : ∀ S : Submodule (ZMod p) W,
      (∀ z : ↥D ⧸ K, ∀ v ∈ S, ρbar z v ∈ S) → S = ⊥ ∨ S = ⊤ := by
    intro S hS
    refine hirri S fun d v hv => ?_
    have hmem := hS (QuotientGroup.mk' K d) v hv
    rwa [hρbar_mk] at hmem
  have hWnt : Nontrivial W := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    refine hρiX ?_
    rw [← hρbar_mk X]
    exact Subsingleton.elim _ _
  haveI : Nontrivial W := hWnt
  haveI : ρbar.IsIrreducible := isIrreducible_of_forall_submodule ρbar hirrbar
  have hqbarX : ((ρbar (QuotientGroup.mk' K X) : Module.End (ZMod p) W) - 1) ^ 2 = 0 := by
    rw [hρbar_mk]
    exact hqiX
  have hqbarY : ((ρbar (QuotientGroup.mk' K Y) : Module.End (ZMod p) W) - 1) ^ 2 = 0 := by
    rw [hρbar_mk]
    exact hqiY
  have hXbar_ne : ρbar (QuotientGroup.mk' K X) ≠ 1 := by
    rw [hρbar_mk]
    exact hρiX
  have hYbar_ne : ρbar (QuotientGroup.mk' K Y) ≠ 1 := by
    rw [hρbar_mk]
    exact hρiY
  have hgenbar :
      Subgroup.closure ({QuotientGroup.mk' K X, QuotientGroup.mk' K Y} : Set (↥D ⧸ K)) = ⊤ := by
    have h1 := congrArg (Subgroup.map (QuotientGroup.mk' K)) hgenXY
    rw [Subgroup.map_top_of_surjective (QuotientGroup.mk' K) (QuotientGroup.mk'_surjective K),
      MonoidHom.map_closure, Set.image_pair] at h1
    exact h1
  -- ## Step 9: the quadratic-pair lemma on the single factor.
  obtain ⟨Q, hQ2, hQnc, hQu⟩ :=
    QuadPairBadSubgroup (p := p) hp2 (ρ := ρbar) hρbar_faithful
      (x := QuotientGroup.mk' K X) (y := QuotientGroup.mk' K Y) hgenbar
      hqbarX hXbar_ne hqbarY hYbar_ne
  -- ## Step 10: a bad section of `L`.
  exact hM D K Q hQ2 hQnc hQu

end Work.PSTAB
