import Mathlib
import Submission.Work.PSTAB.QuadPairIrr

namespace Work.PSTAB

/-- Route: `ρ x = 1` gives `ρ(D) = ⟨ρ y⟩`, and `hy_p` makes `y`, hence `ρ y`, have `p`-power order,
so `D ⧸ ρ.ker` is a `p`-group; `hirr` descends to the faithful irreducible representation of
`D ⧸ ρ.ker` on `W` (`QuotientGroup.lift ρ.ker ρ le_rfl`), so
`Work.PSTAB.subsingleton_of_isPGroup_faithful_irreducible` (in `Submission/Work/PSTAB/QuadPairIrr.lean`)
forces `ρ y = 1`. -/
theorem QuadPairFactorTrivial {p : ℕ} [Fact p.Prime]
    {D : Type*} [Group D] [Finite D] {W : Type*} [AddCommGroup W] [Module (ZMod p) W] [Finite W]
    (ρ : Representation (ZMod p) D W)
    (hirr : ∀ S : Submodule (ZMod p) W, (∀ d : D, ∀ v ∈ S, ρ d v ∈ S) → S = ⊥ ∨ S = ⊤)
    {x y : D} (hgen : Subgroup.closure ({x, y} : Set D) = ⊤)
    (hy_p : IsPGroup p (Subgroup.zpowers y)) (hx1 : ρ x = 1) : ρ y = 1 := by
  classical
  by_cases hW : Nontrivial W
  swap
  · -- `W` is a subsingleton: all linear maps coincide.
    have : Subsingleton W := not_nontrivial_iff_subsingleton.mp hW
    exact Subsingleton.elim _ _
  have : Nontrivial W := hW
  -- `q` is the projection onto `D ⧸ ρ.ker`.
  let q : D →* D ⧸ ρ.ker := QuotientGroup.mk' ρ.ker
  have hx_ker : x ∈ ρ.ker := MonoidHom.mem_ker.mpr hx1
  have hqx : q x = 1 := by
    show (QuotientGroup.mk' ρ.ker) x = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hx_ker
  -- `D ⧸ ρ.ker` is generated by the image of `y`.
  have hsup : (⊤ : Subgroup D) ≤ Subgroup.zpowers y ⊔ q.ker := by
    rw [← hgen, Subgroup.closure_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with hzx | hzy
    · rw [hzx]
      exact Subgroup.mem_sup_right (MonoidHom.mem_ker.mpr hqx)
    · rw [hzy]
      exact Subgroup.mem_sup_left (Subgroup.mem_zpowers y)
  have hmap : Subgroup.map q (Subgroup.zpowers y) = ⊤ := by
    rw [eq_top_iff]
    have hle : Subgroup.map q (⊤ : Subgroup D) ≤ Subgroup.map q (Subgroup.zpowers y) :=
      Subgroup.map_le_map_iff.mpr hsup
    rwa [Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective ρ.ker)] at hle
  have hsurj : Function.Surjective (q.comp (Subgroup.zpowers y).subtype) := by
    intro z
    have hz : z ∈ Subgroup.map q (Subgroup.zpowers y) := by
      rw [hmap]; exact Subgroup.mem_top z
    obtain ⟨m, hm, hqm⟩ := Subgroup.mem_map.mp hz
    exact ⟨⟨m, hm⟩, hqm⟩
  -- Hence `D ⧸ ρ.ker` is a `p`-group.
  have hpQ : IsPGroup p (D ⧸ ρ.ker) :=
    hy_p.of_surjective (q.comp (Subgroup.zpowers y).subtype) hsurj
  -- The descended representation is faithful and irreducible.
  have hinj : Function.Injective (QuotientGroup.lift ρ.ker ρ le_rfl) := by
    rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
    intro z hz
    obtain ⟨d, rfl⟩ := QuotientGroup.mk'_surjective ρ.ker z
    rw [QuotientGroup.mk'_apply] at hz
    rw [MonoidHom.mem_ker] at hz
    rw [QuotientGroup.lift_mk'] at hz
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact MonoidHom.mem_ker.mpr hz
  have hirr' : ∀ U : Submodule (ZMod p) W,
      (∀ g : D ⧸ ρ.ker, ∀ v ∈ U, QuotientGroup.lift ρ.ker ρ le_rfl g v ∈ U) →
        U = ⊥ ∨ U = ⊤ := by
    intro U hU
    refine hirr U fun d v hv => ?_
    have h := hU (q d) v hv
    rw [QuotientGroup.mk'_apply, QuotientGroup.lift_mk'] at h
    exact h
  have hsub : Subsingleton (D ⧸ ρ.ker) :=
    subsingleton_of_isPGroup_faithful_irreducible (QuotientGroup.lift ρ.ker ρ le_rfl) hinj hirr' hpQ
  have : Subsingleton (D ⧸ ρ.ker) := hsub
  have hqy : (y : D ⧸ ρ.ker) = 1 := Subsingleton.elim _ _
  exact MonoidHom.mem_ker.mp ((QuotientGroup.eq_one_iff y).mp hqy)

end Work.PSTAB
