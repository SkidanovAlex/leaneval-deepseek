# Normalizers of cyclic subgroups of order `3` and `4` (Bender's conclusion (4))

Bender's conclusion (4) asks that every nontrivial subgroup `X ≤ D` have the same normalizer as `D`
and that `N_G(D) = D⟨u⟩` for an involution `u ∉ D` inverting `D`.  For the two cases of
`bswK4StructureProp` the subgroup `D` is cyclic of order `3` (the `|G| = 168`, `q = 7` case) or of
order `4` (the `|G| = 360`, `q = 9` case), generated by an element `d`.  This file collects the
group-theoretic facts used:

* `N_G(⟨d⟩) = ⟨d⟩ ⊔ ⟨u⟩` for an involution `u ∉ ⟨d⟩` inverting `d`;
* a subgroup of order `2` of a cyclic group of order `4` is the subgroup generated by its square;
* the two self-centralizing statements `C_G(⟨d⟩) = ⟨d⟩` in the `|K| = 4` BSW situation.
-/
import Mathlib
import Submission.Work.BSW.Concl
import Submission.Work.BSW.Cases.K4.Setup
import Submission.Work.BSW.Cases.K4.CardSup
import Submission.Work.BSW.Cases.K4.card_normalizer_sylow_seven
import Submission.Work.BSW.Cases.K4.exists_not_mem_centralizer_of_isPGroup
import Submission.Work.BSW.Api.mem_centralizer_iff

namespace Work.BSW.Cases.K4

open Subgroup Work.GW2

section Cyclic

variable {G : Type} [Group G] [Finite G]

/-- The centralizer of the subgroup `⟨d⟩` is the centralizer of `d`. -/
theorem centralizer_zpowers_eq_centralizer_singleton (d : G) :
    Subgroup.centralizer (Subgroup.zpowers d : Set G) =
      Subgroup.centralizer ({d} : Set G) := by
  rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]

/-- An element of `⟨d⟩` for `d` of order `3` is `1`, `d` or `d⁻¹`. -/
theorem mem_zpowers_eq_one_or_eq_or_inv {d y : G} (hd : orderOf d = 3)
    (hy : y ∈ Subgroup.zpowers d) : y = 1 ∨ y = d ∨ y = d⁻¹ := by
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hy
  have hd3 : d ^ (3 : ℕ) = 1 := by
    have h := pow_orderOf_eq_one d
    rwa [hd] at h
  have h1 : d ^ i = d ^ (i % (3 : ℤ)) := zpow_eq_zpow_emod' i hd3
  have hlt : i % (3 : ℤ) = 0 ∨ i % (3 : ℤ) = 1 ∨ i % (3 : ℤ) = 2 := by
    have h0 := Int.emod_nonneg i (by norm_num : (3 : ℤ) ≠ 0)
    have hlt' := Int.emod_lt_of_pos i (by norm_num : (0 : ℤ) < 3)
    omega
  have h3zpow : d ^ (3 : ℤ) = 1 := by
    rw [show (3 : ℤ) = ((3 : ℕ) : ℤ) from rfl, zpow_natCast]
    exact hd3
  have hsq : d * d = d⁻¹ := by
    rw [← zpow_two (d : G)]
    have h : d ^ (2 : ℤ) = d ^ (3 : ℤ) * d ^ (-1 : ℤ) := by
      rw [← zpow_add]
      norm_num
    rw [h, h3zpow, one_mul, zpow_neg_one]
  have h2z : d ^ (2 : ℤ) = d * d := zpow_two d
  rcases hlt with h | h | h
  · left; rw [← hi, h1, h, zpow_zero]
  · right; left; rw [← hi, h1, h, zpow_one]
  · right; right
    rw [← hi, h1, h, h2z]
    exact hsq

/-- `d ^ (3 : ℤ) = d * d * d`. -/
theorem zpow_three_eq {G : Type} [Group G] (d : G) : d ^ (3 : ℤ) = d * d * d := by
  rw [show (3 : ℤ) = 2 + 1 from rfl, zpow_add, zpow_two, zpow_one]

/-- An element of `⟨d⟩` for `d` of order `4` is `1`, `d`, `d * d` or `d⁻¹`. -/
theorem mem_zpowers_eq_one_or_eq_or_sq_or_inv {d y : G} (hd : orderOf d = 4)
    (hy : y ∈ Subgroup.zpowers d) : y = 1 ∨ y = d ∨ y = d * d ∨ y = d⁻¹ := by
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hy
  have hd4 : d ^ (4 : ℕ) = 1 := by
    have h := pow_orderOf_eq_one d
    rwa [hd] at h
  have h1 : d ^ i = d ^ (i % (4 : ℤ)) := zpow_eq_zpow_emod' i hd4
  have hlt : i % (4 : ℤ) = 0 ∨ i % (4 : ℤ) = 1 ∨ i % (4 : ℤ) = 2 ∨ i % (4 : ℤ) = 3 := by
    have h0 := Int.emod_nonneg i (by norm_num : (4 : ℤ) ≠ 0)
    have hlt' := Int.emod_lt_of_pos i (by norm_num : (0 : ℤ) < 4)
    omega
  have h4zpow : d ^ (4 : ℤ) = 1 := by
    rw [show (4 : ℤ) = ((4 : ℕ) : ℤ) from rfl, zpow_natCast]
    exact hd4
  -- `d * d * d = d⁻¹`
  have hcub : d * d * d = d⁻¹ := by
    rw [← zpow_three_eq]
    have h : d ^ (3 : ℤ) = d ^ (4 : ℤ) * d ^ (-1 : ℤ) := by
      rw [← zpow_add]
      norm_num
    rw [h, h4zpow, one_mul, zpow_neg_one]
  have h2z : d ^ (2 : ℤ) = d * d := zpow_two d
  have h3z : d ^ (3 : ℤ) = d * d * d := zpow_three_eq d
  rcases hlt with h | h | h | h
  · left; rw [← hi, h1, h, zpow_zero]
  · right; left; rw [← hi, h1, h, zpow_one]
  · right; right; left; rw [← hi, h1, h, h2z]
  · right; right; right; rw [← hi, h1, h, h3z]; exact hcub

/-- If `g` normalizes `⟨d⟩` and `g * d * g⁻¹ = d` then `g` centralizes `d`. -/
theorem mem_centralizer_zpowers_of_conj_eq {d g : G} (h : g * d * g⁻¹ = d) :
    g ∈ Subgroup.centralizer (Subgroup.zpowers d : Set G) := by
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hy
  have hconj : g * (d ^ i) * g⁻¹ = d ^ i := by
    have h' : (MulAut.conj g) (d ^ i) = d ^ i := by
      rw [map_zpow, show (MulAut.conj g) d = d from by rw [MulAut.conj_apply]; exact h]
    rwa [MulAut.conj_apply] at h'
  rw [← hi]
  calc (d ^ i) * g = (g * (d ^ i) * g⁻¹) * g := by rw [hconj]
    _ = g * (d ^ i) := by group

/-- If `u` and `g` both invert `d` then `u⁻¹ * g` centralizes `d`. -/
theorem mem_centralizer_zpowers_of_inv_mul {d u g : G} (hu : u * d * u⁻¹ = d⁻¹)
    (hg : g * d * g⁻¹ = d⁻¹) :
    u⁻¹ * g ∈ Subgroup.centralizer (Subgroup.zpowers d : Set G) := by
  have hu' : u⁻¹ * d * u = d⁻¹ := by
    have h2 : u * d⁻¹ * u⁻¹ = d := by
      have h := congrArg (fun z => z⁻¹) hu
      simpa [mul_assoc] using h
    have h3 : u⁻¹ * (u * d⁻¹ * u⁻¹) * u = u⁻¹ * d * u :=
      congrArg (fun z => u⁻¹ * z * u) h2
    have h4 : u⁻¹ * (u * d⁻¹ * u⁻¹) * u = d⁻¹ := by group
    rw [h4] at h3
    exact h3.symm
  have hcomm : (u⁻¹ * g) * d * (u⁻¹ * g)⁻¹ = d := by
    calc (u⁻¹ * g) * d * (u⁻¹ * g)⁻¹ = u⁻¹ * (g * d * g⁻¹) * u := by group
      _ = u⁻¹ * d⁻¹ * u := by rw [hg]
      _ = (u⁻¹ * d * u)⁻¹ := by group
      _ = d := by rw [hu', inv_inv]
  exact mem_centralizer_zpowers_of_conj_eq hcomm

/-- `N_G(⟨d⟩) = ⟨d⟩ ⊔ ⟨u⟩` when `d` has order `3`, `u` is an involution outside `⟨d⟩` inverting
it, and `⟨d⟩` is self-centralizing. -/
theorem normalizer_zpowers_eq_sup_of_order_three {d u : G}
    (hd : orderOf d = 3) (hu : orderOf u = 2) (huD : u ∉ Subgroup.zpowers d)
    (hinv : Work.GW2.Inverts u (Subgroup.zpowers d))
    (hC : Subgroup.centralizer (Subgroup.zpowers d : Set G) = Subgroup.zpowers d) :
    Subgroup.normalizer (Subgroup.zpowers d : Set G) =
      Subgroup.zpowers d ⊔ Subgroup.zpowers u := by
  set D : Subgroup G := Subgroup.zpowers d with hD
  set U : Subgroup G := Subgroup.zpowers u with hU
  have hDcard : Nat.card ↥D = 3 := by rw [hD, Nat.card_zpowers, hd]
  have hUcard : Nat.card ↥U = 2 := by rw [hU, Nat.card_zpowers, hu]
  have hDnorm : D ≤ Subgroup.normalizer (D : Set G) := Subgroup.le_normalizer
  have hUle : U ≤ Subgroup.normalizer (D : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro x hx y hy
    rcases Work.BSW.Cases.K4.mem_zpowers_eq_one_or hu (by rwa [hU] at hx) with rfl | rfl
    · simpa using hy
    · rw [hinv y (by rwa [hD] at hy)]
      exact D.inv_mem hy
  have hDUle : D ⊔ U ≤ Subgroup.normalizer (D : Set G) := sup_le hDnorm hUle
  have hinf : D ⊓ U = ⊥ := by
    refine inf_eq_bot_of_coprime ?_
    rw [hDcard, hUcard]
    norm_num
  have hsupcard : Nat.card ↥(D ⊔ U) = 6 := by
    rw [card_sup_of_le_normalizer_of_inf_eq_bot hUle hinf, hDcard, hUcard]
  have huinv : u * d * u⁻¹ = d⁻¹ := hinv d (by rw [hD]; exact Subgroup.mem_zpowers d)
  have hcover : Subgroup.normalizer (D : Set G) ≤ D ⊔ U := by
    intro g hg
    have hgd : g * d * g⁻¹ ∈ D :=
      (Subgroup.mem_normalizer_iff.mp hg d).mp (by rw [hD]; exact Subgroup.mem_zpowers d)
    have hgd' : g * d * g⁻¹ ∈ Subgroup.zpowers d := by rwa [hD] at hgd
    rcases mem_zpowers_eq_one_or_eq_or_inv hd hgd' with h1 | hcase | hcase
    · exfalso
      have : d = 1 := by
        have h := congrArg (fun z => g⁻¹ * z * g) h1
        simpa [mul_assoc] using h
      rw [this, orderOf_one] at hd
      exact absurd hd (by norm_num)
    · have hgC : g ∈ Subgroup.centralizer (Subgroup.zpowers d : Set G) :=
        mem_centralizer_zpowers_of_conj_eq hcase
      rw [hC] at hgC
      exact Subgroup.mem_sup_left (by rwa [hD] at hgC)
    · have hgC : u⁻¹ * g ∈ Subgroup.centralizer (Subgroup.zpowers d : Set G) :=
        mem_centralizer_zpowers_of_inv_mul huinv hcase
      rw [hC] at hgC
      have : g = u * (u⁻¹ * g) := by group
      rw [this, sup_comm D U]
      refine Subgroup.mul_mem_sup (S := U) (T := D) ?_ ?_
      · exact hU ▸ Subgroup.mem_zpowers u
      · exact hD ▸ hgC
  have hcardN : Nat.card ↥(Subgroup.normalizer (D : Set G)) ≤ 6 := by
    have h' := Subgroup.card_dvd_of_le (H := Subgroup.normalizer (D : Set G)) (K := D ⊔ U) hcover
    rw [hsupcard] at h'
    exact Nat.le_of_dvd (by norm_num) h'
  have heq : D ⊔ U = Subgroup.normalizer (D : Set G) :=
    Subgroup.eq_of_le_of_card_ge hDUle (by rw [hsupcard]; exact hcardN)
  exact heq.symm

/-- `N_G(⟨d⟩) = ⟨d⟩ ⊔ ⟨u⟩` when `d` has order `4`, `u` is an involution outside `⟨d⟩` inverting
it, and `⟨d⟩` is self-centralizing. -/
theorem normalizer_zpowers_eq_sup_of_order_four {d u : G}
    (hd : orderOf d = 4) (hu : orderOf u = 2) (huD : u ∉ Subgroup.zpowers d)
    (hinv : Work.GW2.Inverts u (Subgroup.zpowers d))
    (hC : Subgroup.centralizer (Subgroup.zpowers d : Set G) = Subgroup.zpowers d) :
    Subgroup.normalizer (Subgroup.zpowers d : Set G) =
      Subgroup.zpowers d ⊔ Subgroup.zpowers u := by
  set D : Subgroup G := Subgroup.zpowers d with hD
  set U : Subgroup G := Subgroup.zpowers u with hU
  have hDcard : Nat.card ↥D = 4 := by rw [hD, Nat.card_zpowers, hd]
  have hUcard : Nat.card ↥U = 2 := by rw [hU, Nat.card_zpowers, hu]
  have hDnorm : D ≤ Subgroup.normalizer (D : Set G) := Subgroup.le_normalizer
  have hUle : U ≤ Subgroup.normalizer (D : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro x hx y hy
    rcases Work.BSW.Cases.K4.mem_zpowers_eq_one_or hu (by rwa [hU] at hx) with rfl | rfl
    · simpa using hy
    · rw [hinv y (by rwa [hD] at hy)]
      exact D.inv_mem hy
  have hDUle : D ⊔ U ≤ Subgroup.normalizer (D : Set G) := sup_le hDnorm hUle
  have hinf : D ⊓ U = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxU : x ∈ Subgroup.zpowers u := by rw [hU] at hx; exact hx.2
    have hxD : x ∈ D := hx.1
    rcases Work.BSW.Cases.K4.mem_zpowers_eq_one_or hu hxU with rfl | rfl
    · exact Subgroup.mem_bot.mpr rfl
    · exact absurd (by rwa [hD] at hxD) huD
  have hsupcard : Nat.card ↥(D ⊔ U) = 8 := by
    rw [card_sup_of_le_normalizer_of_inf_eq_bot hUle hinf, hDcard, hUcard]
  have huinv : u * d * u⁻¹ = d⁻¹ := hinv d (by rw [hD]; exact Subgroup.mem_zpowers d)
  have hcover : Subgroup.normalizer (D : Set G) ≤ D ⊔ U := by
    intro g hg
    have hgd : g * d * g⁻¹ ∈ D :=
      (Subgroup.mem_normalizer_iff.mp hg d).mp (by rw [hD]; exact Subgroup.mem_zpowers d)
    have hgd' : g * d * g⁻¹ ∈ Subgroup.zpowers d := by rwa [hD] at hgd
    have hgdord : orderOf (g * d * g⁻¹) = 4 := by
      rw [← MulAut.conj_apply, MulEquiv.orderOf_eq, hd]
    rcases mem_zpowers_eq_one_or_eq_or_sq_or_inv hd hgd' with h1 | hcase | hcase | hcase
    · exfalso
      rw [h1, orderOf_one] at hgdord
      exact absurd hgdord (by norm_num)
    · have hgC : g ∈ Subgroup.centralizer (Subgroup.zpowers d : Set G) :=
        mem_centralizer_zpowers_of_conj_eq hcase
      rw [hC] at hgC
      exact Subgroup.mem_sup_left (by rwa [hD] at hgC)
    · exfalso
      have h2 : orderOf (d * d) = 2 := by
        rw [show d * d = d ^ 2 from (pow_two d).symm, orderOf_pow, hd]
        norm_num
      rw [hcase, h2] at hgdord
      exact absurd hgdord (by norm_num)
    · have hgC : u⁻¹ * g ∈ Subgroup.centralizer (Subgroup.zpowers d : Set G) :=
        mem_centralizer_zpowers_of_inv_mul huinv hcase
      rw [hC] at hgC
      have : g = u * (u⁻¹ * g) := by group
      rw [this, sup_comm D U]
      refine Subgroup.mul_mem_sup (S := U) (T := D) ?_ ?_
      · exact hU ▸ Subgroup.mem_zpowers u
      · exact hD ▸ hgC
  have hcardN : Nat.card ↥(Subgroup.normalizer (D : Set G)) ≤ 8 := by
    have h' := Subgroup.card_dvd_of_le (H := Subgroup.normalizer (D : Set G)) (K := D ⊔ U) hcover
    rw [hsupcard] at h'
    exact Nat.le_of_dvd (by norm_num) h'
  have heq : D ⊔ U = Subgroup.normalizer (D : Set G) :=
    Subgroup.eq_of_le_of_card_ge hDUle (by rw [hsupcard]; exact hcardN)
  exact heq.symm

/-- A subgroup of order `2` of `⟨d⟩` for `d` of order `4` is `⟨d * d⟩`. -/
theorem eq_zpowers_sq_of_le_zpowers_of_card_two {d : G} (hd : orderOf d = 4) (X : Subgroup G)
    (hX : X ≤ Subgroup.zpowers d) (hXc : Nat.card ↥X = 2) : X = Subgroup.zpowers (d * d) := by
  have hle : X ≤ Subgroup.zpowers (d * d) := by
    intro x hx
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp (hX hx)
    have hx2 : orderOf x ∣ 2 := by
      have h' := Work.BSW.Cases.K4.orderOf_dvd_natCard_of_mem (H := X) hx
      rwa [hXc] at h'
    have hx1 : x * x = 1 := by
      have h := orderOf_dvd_iff_pow_eq_one.mp hx2
      rwa [pow_two] at h
    have hdi : d ^ (2 * i) = 1 := by
      have h2 : (2 : ℤ) * i = i + i := by ring
      rw [h2, zpow_add, hi]
      exact hx1
    have hdvd : (4 : ℤ) ∣ 2 * i := by
      have h := orderOf_dvd_iff_zpow_eq_one.mpr hdi
      rwa [hd] at h
    obtain ⟨j, hj⟩ := hdvd
    have hij : i = 2 * j := by
      have h' : (2 : ℤ) * i = 2 * (2 * j) := by rw [hj]; ring
      exact mul_left_cancel₀ (by norm_num : (2 : ℤ) ≠ 0) h'
    refine Subgroup.mem_zpowers_iff.mpr ⟨j, ?_⟩
    rw [show d * d = d ^ (2 : ℤ) from (zpow_two d).symm]
    rw [← zpow_mul, ← hij]
    exact hi
  have hcard : Nat.card ↥(Subgroup.zpowers (d * d)) = 2 := by
    rw [Nat.card_zpowers]
    rw [show d * d = d ^ 2 from (pow_two d).symm, orderOf_pow, hd]
    norm_num
  exact Subgroup.eq_of_le_of_card_ge hle (by rw [hcard, hXc])

end Cyclic


/-- Conjugation carries centralizers of elements to centralizers of conjugates. -/
theorem map_conj_centralizer_singleton {G : Type} [Group G] (a u : G) :
    (Subgroup.centralizer ({u} : Set G)).map (MulAut.conj a).toMonoidHom =
      Subgroup.centralizer ({a * u * a⁻¹} : Set G) := by
  ext x
  constructor
  · rintro ⟨w, hw, rfl⟩
    have hw' : w * u = u * w := Subgroup.mem_centralizer_singleton_iff.mp hw
    change a * w * a⁻¹ ∈ Subgroup.centralizer ({a * u * a⁻¹} : Set G)
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc a * w * a⁻¹ * (a * u * a⁻¹) = a * (w * u) * a⁻¹ := by group
      _ = a * (u * w) * a⁻¹ := by rw [hw']
      _ = (a * u * a⁻¹) * (a * w * a⁻¹) := by group
  · intro hx
    have hx' : x * (a * u * a⁻¹) = (a * u * a⁻¹) * x :=
      Subgroup.mem_centralizer_singleton_iff.mp hx
    refine ⟨a⁻¹ * x * a, ?_, ?_⟩
    · change a⁻¹ * x * a ∈ Subgroup.centralizer ({u} : Set G)
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc (a⁻¹ * x * a) * u = a⁻¹ * (x * (a * u * a⁻¹)) * a := by group
        _ = a⁻¹ * ((a * u * a⁻¹) * x) * a := by rw [hx']
        _ = u * (a⁻¹ * x * a) := by group
    · show a * (a⁻¹ * x * a) * a⁻¹ = x
      group

section SelfCent

variable {G : Type} [Group G] [Finite G] {t s : G} {K : Subgroup G}

/-- Every element of `C_G(t)` is either in `K` or has the form `z * s` with `z ∈ K`; the latter are
involutions, so an element of `C_G(t)` of order `4` lies in `K`. -/
theorem mem_K_of_mem_centralizer_t_of_orderOf_eq_four (h : Work.GW2.BSWHyps2 G t s K)
    (hK4 : Nat.card ↥K = 4) {x : G} (hx : x ∈ Subgroup.centralizer ({t} : Set G))
    (hx4 : orderOf x = 4) : x ∈ K := by
  rcases (Work.BSW.Api.mem_centralizer_iff h x).mp hx with hxK | ⟨z, hzK, hxz⟩
  · exact hxK
  · exfalso
    have hsq : (z * s) * (z * s) = 1 := mul_s_self h hzK
    have hdvd : orderOf (z * s) ∣ 2 :=
      orderOf_dvd_iff_pow_eq_one.mpr (by rw [pow_two]; exact hsq)
    rw [← hxz, hx4] at hdvd
    rcases hdvd with ⟨e, he⟩
    omega

/-- `C_G(k) = K` for `k` a generator of the cyclic group `K` of order `4`. -/
theorem centralizer_zpowers_eq_K (h : Work.GW2.BSWHyps2 G t s K) (hK4 : Nat.card ↥K = 4)
    {k : G} (hk4 : orderOf k = 4) (hkK : K = Subgroup.zpowers k) :
    Subgroup.centralizer (Subgroup.zpowers k : Set G) = K := by
  have hkK' : k ∈ K := by rw [hkK]; exact Subgroup.mem_zpowers k
  have hkt : k * k = t := by
    have h2 : orderOf (k * k) = 2 := by
      rw [show k * k = k ^ 2 from (pow_two k).symm, orderOf_pow, hk4]
      norm_num
    exact Work.BSW.orderOf_eq_two_of_mem_K h (K.mul_mem hkK' hkK') h2
  have hcomm : ∀ z ∈ K, z * k = k * z := by
    intro z hz
    haveI : IsMulCommutative ↥K := isMulCommutative_K h
    exact congrArg Subtype.val
      (IsMulCommutative.is_comm.comm (⟨z, hz⟩ : ↥K) (⟨k, hkK'⟩ : ↥K))
  apply le_antisymm
  · intro x hx
    have hxk : x * k = k * x := by
      have hx' : x ∈ Subgroup.centralizer (Subgroup.zpowers k : Set G) := hx
      rw [Subgroup.mem_centralizer_iff] at hx'
      exact (hx' k (Subgroup.mem_zpowers k)).symm
    have hxt : x ∈ Subgroup.centralizer ({t} : Set G) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc x * t = x * (k * k) := by rw [hkt]
        _ = (x * k) * k := by group
        _ = (k * x) * k := by rw [hxk]
        _ = k * (x * k) := by group
        _ = k * (k * x) := by rw [hxk]
        _ = t * x := by rw [← hkt]; group
    rcases (Work.BSW.Api.mem_centralizer_iff h x).mp hxt with hxK | ⟨z, hzK, hxz⟩
    · exact hxK
    · exfalso
      have h1 : (z * s) * k * (z * s)⁻¹ = k⁻¹ := by
        calc (z * s) * k * (z * s)⁻¹ = z * (s * k * s⁻¹) * z⁻¹ := by group
          _ = z * k⁻¹ * z⁻¹ := by rw [Work.BSW.inverts_s_K h k hkK']
          _ = k⁻¹ * z * z⁻¹ := by
              rw [show z * k⁻¹ = k⁻¹ * z from (show Commute z k from hcomm z hzK).inv_right]
          _ = k⁻¹ := by group
      have h2 : (z * s) * k * (z * s)⁻¹ = k := by
        rw [← hxz]
        rw [show x * k * x⁻¹ = k from by rw [hxk]; group]
      have hkinv : k = k⁻¹ := h2.symm.trans h1
      have h3 : k * k = 1 := by
        have h4 : k * k = k * k⁻¹ := congrArg (fun z => k * z) hkinv
        rw [h4, mul_inv_cancel k]
      have ht1 : t = 1 := by rw [← hkt]; exact h3
      exact Work.BSW.t_ne_one h ht1
  · intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have hyK : y ∈ K := by rwa [← hkK] at hy
    haveI : IsMulCommutative ↥K := isMulCommutative_K h
    exact congrArg Subtype.val
      (IsMulCommutative.is_comm.comm (⟨y, hyK⟩ : ↥K) (⟨x, hx⟩ : ↥K))

/-- `C_G(K) = K`. -/
theorem centralizer_eq_K (h : Work.GW2.BSWHyps2 G t s K) (hK4 : Nat.card ↥K = 4) :
    Subgroup.centralizer (K : Set G) = K := by
  obtain ⟨k, hk4, hkK, _⟩ := exists_gen_K h hK4
  haveI : IsMulCommutative ↥K := isMulCommutative_K h
  refine le_antisymm ?_ (Subgroup.le_centralizer K)
  intro x hx
  have hx' : x ∈ Subgroup.centralizer (Subgroup.zpowers k : Set G) := by
    rw [← hkK]
    exact hx
  rwa [centralizer_zpowers_eq_K h hK4 hk4 hkK] at hx'

/-- In the `|K| = 4`, `|G| = 360` case, an element of order `4` is self-centralizing. -/
theorem centralizer_zpowers_eq_of_order_four_360 (h : Work.GW2.BSWHyps2 G t s K)
    (hK4 : Nat.card ↥K = 4) (hG : Nat.card G = 360) (d : G) (hd : orderOf d = 4) :
    Subgroup.centralizer (Subgroup.zpowers d : Set G) = Subgroup.zpowers d := by
  have hd2 : orderOf (d * d) = 2 := by
    have h2 : orderOf (d ^ 2) = 2 := by rw [orderOf_pow, hd]; norm_num
    rwa [pow_two] at h2
  obtain ⟨c, hc⟩ := isConj_iff.mp (Work.BSW.involutions_conj h (d * d) hd2)
  have hy4 : orderOf (c * d * c⁻¹) = 4 := by
    rw [← MulAut.conj_apply, MulEquiv.orderOf_eq]
    exact hd
  have hymem : c * d * c⁻¹ ∈ Subgroup.centralizer ({t} : Set G) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc (c * d * c⁻¹) * t = (c * d * c⁻¹) * (c * (d * d) * c⁻¹) := by rw [hc]
      _ = c * (d * (d * d)) * c⁻¹ := by group
      _ = c * ((d * d) * d) * c⁻¹ := by group
      _ = (c * (d * d) * c⁻¹) * (c * d * c⁻¹) := by group
      _ = t * (c * d * c⁻¹) := by rw [hc]
  have hyK : c * d * c⁻¹ ∈ K :=
    mem_K_of_mem_centralizer_t_of_orderOf_eq_four h hK4 hymem hy4
  have hKy : Subgroup.zpowers (c * d * c⁻¹) = K := by
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hyK) ?_
    rw [Nat.card_zpowers, hy4, hK4]
  have hCy : Subgroup.centralizer ({c * d * c⁻¹} : Set G) = K := by
    rw [← centralizer_zpowers_eq_centralizer_singleton (c * d * c⁻¹), hKy]
    exact centralizer_eq_K h hK4
  have hcard : Nat.card ↥(Subgroup.centralizer ({d} : Set G)) = 4 := by
    have hmap : (Subgroup.centralizer ({c * d * c⁻¹} : Set G)).map
        (MulAut.conj c⁻¹).toMonoidHom = Subgroup.centralizer ({d} : Set G) := by
      have hd_eq : d = c⁻¹ * (c * d * c⁻¹) * c := by group
      rw [hd_eq]
      convert map_conj_centralizer_singleton c⁻¹ (c * d * c⁻¹) using 2
      group
    calc Nat.card ↥(Subgroup.centralizer ({d} : Set G))
        = Nat.card ↥((Subgroup.centralizer ({c * d * c⁻¹} : Set G)).map
            (MulAut.conj c⁻¹).toMonoidHom) := by rw [hmap]
      _ = Nat.card ↥(Subgroup.centralizer ({c * d * c⁻¹} : Set G)) :=
          Subgroup.card_map_of_injective (f := (MulAut.conj c⁻¹).toMonoidHom)
            (MulAut.conj c⁻¹).injective
      _ = Nat.card ↥K := by rw [hCy]
      _ = 4 := hK4
  have hle : Subgroup.zpowers d ≤ Subgroup.centralizer ({d} : Set G) := by
    rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
  rw [centralizer_zpowers_eq_centralizer_singleton]
  exact (Subgroup.eq_of_le_of_card_ge hle (by rw [hcard, Nat.card_zpowers, hd])).symm

/-- In the `|K| = 4`, `|G| = 168` case, an element of order `3` is self-centralizing. -/
theorem centralizer_zpowers_eq_of_order_three_168 [IsSimpleGroup G]
    (hnab : ∃ a b : G, a * b ≠ b * a)
    (h : Work.GW2.BSWHyps2 G t s K) (hK4 : Nat.card ↥K = 4) (hG : Nat.card G = 168)
    (d : G) (hd : orderOf d = 3) :
    Subgroup.centralizer (Subgroup.zpowers d : Set G) = Subgroup.zpowers d := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  rw [centralizer_zpowers_eq_centralizer_singleton]
  set C : Subgroup G := Subgroup.centralizer ({d} : Set G) with hCdef
  have hDle : Subgroup.zpowers d ≤ C := by
    rw [hCdef, Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
  have h3dvd : 3 ∣ Nat.card ↥C := by
    have h' : Nat.card ↥(Subgroup.zpowers d) ∣ Nat.card ↥C := Subgroup.card_dvd_of_le hDle
    rwa [Nat.card_zpowers, hd] at h'
  have hCdvd : Nat.card ↥C ∣ 168 := by
    have h' : Nat.card ↥C ∣ Nat.card ↥(⊤ : Subgroup G) := Subgroup.card_dvd_of_le le_top
    rwa [Subgroup.card_top, hG] at h'
  obtain ⟨m, hm⟩ := h3dvd
  have hmdvd : m ∣ 56 := by
    have h' : 3 * m ∣ 168 := hm ▸ hCdvd
    obtain ⟨e, he⟩ := h'
    refine ⟨e, ?_⟩
    have h2 : 3 * 56 = 3 * (m * e) :=
      (by norm_num : (3 : ℕ) * 56 = 168).trans (he.trans (by ring))
    exact Nat.eq_of_mul_eq_mul_left (by norm_num) h2
  have hmodd : ¬ 2 ∣ m := by
    intro h2
    obtain ⟨e, he⟩ := h2
    have h2C : 2 ∣ Nat.card ↥C := by
      have h' : Nat.card ↥C = 3 * (2 * e) := by rw [hm, he]
      rw [h']
      exact ⟨3 * e, by ring⟩
    haveI : Fintype ↥C := Fintype.ofFinite _
    obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card (G := ↥C) (p := 2)
      (by rw [← Nat.card_eq_fintype_card]; exact h2C)
    have hw2 : orderOf (w : G) = 2 := by rw [Subgroup.orderOf_coe, hw]
    have hdw : d ∈ Subgroup.centralizer ({(w : G)} : Set G) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      have hw' : (w : G) * d = d * (w : G) := by
        have hmem := w.2
        change (w : G) ∈ Subgroup.centralizer ({d} : Set G) at hmem
        rwa [Subgroup.mem_centralizer_singleton_iff] at hmem
      exact hw'.symm
    have h8 := Work.BSW.Cases.K4.card_centralizer_of_orderOf_eq_two h hK4 hw2
    have h3dvd' : 3 ∣ Nat.card ↥(Subgroup.centralizer ({(w : G)} : Set G)) := by
      have h' := Work.BSW.Cases.K4.orderOf_dvd_natCard_of_mem
        (H := Subgroup.centralizer ({(w : G)} : Set G)) hdw
      rwa [hd] at h'
    rw [h8] at h3dvd'
    exact absurd h3dvd' (by norm_num)
  have hmcases : m = 1 ∨ m = 7 := by
    have hmem : m ∈ (56).divisors := Nat.mem_divisors.mpr ⟨hmdvd, by norm_num⟩
    have hdiv : (56).divisors = {1, 2, 4, 7, 8, 14, 28, 56} := by decide
    rw [hdiv] at hmem
    simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with h | h | h | h | h | h | h | h
    · exact Or.inl h
    · exact absurd ⟨1, by rw [h]⟩ hmodd
    · exact absurd ⟨2, by rw [h]⟩ hmodd
    · exact Or.inr h
    · exact absurd ⟨4, by rw [h]⟩ hmodd
    · exact absurd ⟨7, by rw [h]⟩ hmodd
    · exact absurd ⟨14, by rw [h]⟩ hmodd
    · exact absurd ⟨28, by rw [h]⟩ hmodd
  rcases hmcases with hm1 | hm7
  · have hcard : Nat.card ↥C = 3 := by rw [hm, hm1, mul_one]
    exact (Subgroup.eq_of_le_of_card_ge hDle (by rw [hcard, Nat.card_zpowers, hd])).symm
  · exfalso
    have hcard : Nat.card ↥C = 21 := by rw [hm, hm7]
    haveI : Fintype ↥C := Fintype.ofFinite _
    obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card (G := ↥C) (p := 7)
      (by rw [← Nat.card_eq_fintype_card, hcard]; norm_num)
    have hy7 : orderOf (y : G) = 7 := by rw [Subgroup.orderOf_coe, hy]
    have hdy : (y : G) * d = d * (y : G) := by
      have hmem := y.2
      change (y : G) ∈ Subgroup.centralizer ({d} : Set G) at hmem
      rwa [Subgroup.mem_centralizer_singleton_iff] at hmem
    have hyd : d * (y : G) = (y : G) * d := hdy.symm
    have hdcent : d ∈ Subgroup.centralizer (Subgroup.zpowers (y : G) : Set G) := by
      rw [centralizer_zpowers_eq_centralizer_singleton,
        Subgroup.mem_centralizer_singleton_iff]
      exact hyd
    have hP : IsPGroup 7 ↥(Subgroup.zpowers (y : G)) :=
      IsPGroup.of_card (by rw [Nat.card_zpowers, hy7]; exact (pow_one 7).symm)
    have hidx : ¬ 7 ∣ (Subgroup.zpowers (y : G)).index := by
      intro h7
      have hmul := Subgroup.card_mul_index (Subgroup.zpowers (y : G))
      rw [Nat.card_zpowers, hy7, hG] at hmul
      obtain ⟨c', hc'⟩ := h7
      omega
    let P : Sylow 7 G := hP.toSylow hidx
    have hPcoe : (P : Subgroup G) = Subgroup.zpowers (y : G) := IsPGroup.toSylow_coe hP hidx
    have hNcard : Nat.card ↥(Subgroup.normalizer (Subgroup.zpowers (y : G) : Set G)) = 21 := by
      have h' := card_normalizer_sylow_seven hG P
      rwa [hPcoe] at h'
    have hyleN : (y : G) ∈ Subgroup.normalizer (Subgroup.zpowers d : Set G) :=
      Subgroup.centralizer_le_normalizer _ (by
        rw [centralizer_zpowers_eq_centralizer_singleton, Subgroup.mem_centralizer_singleton_iff]
        exact hdy)
    have hdleQ : d ∈ Subgroup.normalizer (Subgroup.zpowers (y : G) : Set G) :=
      Subgroup.centralizer_le_normalizer _ hdcent
    have hinf : Subgroup.zpowers d ⊓ Subgroup.zpowers (y : G) = ⊥ := by
      refine inf_eq_bot_of_coprime ?_
      rw [Nat.card_zpowers, Nat.card_zpowers, hd, hy7]
      norm_num
    have hyN : Subgroup.zpowers (y : G) ≤
        Subgroup.normalizer (Subgroup.zpowers (y : G) : Set G) := Subgroup.le_normalizer
    have hNrm : Subgroup.zpowers (y : G) ≤
        Subgroup.normalizer (Subgroup.zpowers d : Set G) :=
      Subgroup.zpowers_le.mpr hyleN
    have hsup : Subgroup.zpowers d ⊔ Subgroup.zpowers (y : G) =
        Subgroup.normalizer (Subgroup.zpowers (y : G) : Set G) :=
      sup_eq_of_card_mul_eq (Q := Subgroup.zpowers d) (D := Subgroup.zpowers (y : G))
        (N := Subgroup.normalizer (Subgroup.zpowers (y : G) : Set G))
        (Subgroup.zpowers_le.mpr hdleQ) hyN hNrm hinf
        (by rw [Nat.card_zpowers, Nat.card_zpowers, hd, hy7, hNcard])
    have hNle : Subgroup.normalizer (Subgroup.zpowers (y : G) : Set G) ≤
        Subgroup.centralizer (Subgroup.zpowers (y : G) : Set G) := by
      rw [← hsup]
      exact sup_le (Subgroup.zpowers_le.mpr hdcent) (Subgroup.le_centralizer _)
    obtain ⟨g, hgN, hgC⟩ := exists_not_mem_centralizer_of_isPGroup hnab (p := 7)
      (P := Subgroup.zpowers (y : G)) hP hidx (by rw [hG]; norm_num)
    exact hgC (hNle hgN)

end SelfCent

end Work.BSW.Cases.K4