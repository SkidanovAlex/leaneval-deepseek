import Mathlib

set_option linter.style.haveILetI false

namespace Work.BSW.Cases.K4

/-- A finite group `C` of order at most `30` containing an element of order `15` has exactly `8`
elements of order `15`.

`15 ∣ |C| ≤ 30` forces `|C| = 15` or `|C| = 30`.  If `x` has order `15` then `⟨x⟩ ≤ C` has order
`15`; for `|C| = 15` it is all of `C`, and for `|C| = 30` it has index `2`, hence is normal, so the
image of any `y ∈ C` of order `15` in `C ⧸ ⟨x⟩` (a group of order `2`) has order dividing both `15`
and `2`, hence is trivial, i.e. `y ∈ ⟨x⟩`.  So the elements of order `15` of `C` are exactly the
elements of order `15` of the cyclic group `⟨x⟩ ≅ C₁₅`, of which there are
`Nat.totient 15 = 8` (`IsCyclic.card_orderOf_eq_totient`). -/
theorem ncard_orderOf_eq_fifteen_eq_eight {C : Type} [Group C] [Finite C]
    (hx : ∃ x : C, orderOf x = 15) (hcard : Nat.card C ≤ 30) :
    {x : C | orderOf x = 15}.ncard = 8 := by
  classical
  obtain ⟨x, hx⟩ := hx
  -- `⟨x⟩`, the cyclic subgroup generated by the element of order `15`.
  let H : Subgroup C := Subgroup.zpowers x
  have hHcard : Nat.card ↥H = 15 := by
    show Nat.card ↥(Subgroup.zpowers x) = 15
    rw [Nat.card_zpowers, hx]
  haveI hcycl : IsCyclic ↥H := Subgroup.isCyclic_zpowers x
  have hpos : 0 < Nat.card C := Nat.card_pos
  have hdvd : 15 ∣ Nat.card C := by
    rw [← hx]; exact orderOf_dvd_natCard x
  -- `15 ∣ |C| ≤ 30` leaves `|C| = 15` or `|C| = 30`.
  have hC : Nat.card C = 15 ∨ Nat.card C = 30 := by
    obtain ⟨k, hk⟩ := hdvd
    have hk_le : k ≤ 2 := by
      have : 15 * k ≤ 30 := by rw [← hk]; exact hcard
      omega
    have hk_ge : 1 ≤ k := by
      rcases Nat.eq_zero_or_pos k with h | h
      · rw [h, mul_zero] at hk; omega
      · exact h
    have hk12 : k = 1 ∨ k = 2 := by omega
    rcases hk12 with rfl | rfl
    · left; omega
    · right; omega
  -- Every element of `C` of order `15` already lies in `⟨x⟩`.
  have hmem : ∀ z : C, orderOf z = 15 → z ∈ H := by
    intro z hz
    rcases hC with hC15 | hC30
    · -- `|C| = 15`: `⟨x⟩` is everything.
      have htop : H = ⊤ := Subgroup.eq_top_of_card_eq H (by rw [hHcard, hC15])
      rw [htop]; exact Subgroup.mem_top z
    · -- `|C| = 30`: `⟨x⟩` has index `2`, hence is normal; the image of `z` in `C ⧸ ⟨x⟩`
      -- (a group of order `2`) has order dividing both `15` and `2`.
      have hindex : H.index = 2 := by
        have h := Subgroup.index_mul_card H
        rw [hHcard, hC30] at h
        omega
      haveI : H.Normal := Subgroup.normal_of_index_eq_two hindex
      have h1 : orderOf (QuotientGroup.mk' H z) ∣ 15 := by
        rw [orderOf_dvd_iff_pow_eq_one]
        have hz15 : z ^ 15 = 1 := by rw [← hz]; exact pow_orderOf_eq_one z
        rw [← map_pow, hz15, map_one]
      have h2 : orderOf (QuotientGroup.mk' H z) ∣ 2 := by
        have h := orderOf_dvd_natCard (QuotientGroup.mk' H z)
        rw [← Subgroup.index_eq_card H, hindex] at h
        exact h
      have h3 : orderOf (QuotientGroup.mk' H z) = 1 := by
        have hd : orderOf (QuotientGroup.mk' H z) ∣ Nat.gcd 15 2 := Nat.dvd_gcd h1 h2
        rw [show Nat.gcd 15 2 = 1 from by norm_num] at hd
        exact Nat.dvd_one.mp hd
      exact (QuotientGroup.eq_one_iff z).mp (orderOf_eq_one_iff.mp h3)
  -- The elements of order `15` of `C` are exactly those of `⟨x⟩ ≅ C₁₅`.
  let e : {z : C // orderOf z = 15} ≃ {w : ↥H // orderOf w = 15} :=
    { toFun := fun z => ⟨⟨z.1, hmem z.1 z.2⟩, by rw [Subgroup.orderOf_mk]; exact z.2⟩
      invFun := fun w => ⟨(w.1 : C), by rw [Subgroup.orderOf_coe w.1, w.2]⟩
      left_inv := fun z => by ext; rfl
      right_inv := fun w => by ext; rfl }
  have hcount : Nat.card {w : ↥H // orderOf w = 15} = 8 := by
    haveI : Fintype ↥H := Fintype.ofFinite ↥H
    haveI : Fintype {w : ↥H // orderOf w = 15} := Fintype.ofFinite _
    have hcardH : Fintype.card ↥H = 15 := by rw [← Nat.card_eq_fintype_card, hHcard]
    have htot := IsCyclic.card_orderOf_eq_totient (α := ↥H) (d := 15) (by rw [hcardH])
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype, htot]
    decide
  rw [← Nat.card_coe_set_eq]
  change Nat.card {z : C // orderOf z = 15} = 8
  rw [Nat.card_congr e]
  exact hcount

end Work.BSW.Cases.K4
