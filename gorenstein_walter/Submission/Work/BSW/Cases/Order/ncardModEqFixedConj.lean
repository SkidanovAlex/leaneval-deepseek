import Mathlib

set_option linter.style.haveILetI false

namespace Work.BSW.Cases.Order

open MulAction

/-- If `S` is a union of conjugacy classes of a finite group `G` (i.e. `S` is stable under
conjugation by every element of `G`) and `x ∈ G` has prime order `p`, then the number of
elements of `S` is congruent modulo `p` to the number of elements of `S` commuting with `x`.

This is the standard fixed-point congruence for the conjugation action of the cyclic
`p`-group `⟨x⟩` on `S`. -/
theorem ncardModEqFixedConj {G : Type} [Group G] [Finite G] (S : Set G)
    (hS : ∀ g : G, ∀ y ∈ S, g * y * g⁻¹ ∈ S) {x : G} {p : ℕ} (hp : p.Prime)
    (hx : orderOf x = p) :
    S.ncard ≡ {y ∈ S | x * y = y * x}.ncard [MOD p] := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  -- The cyclic subgroup generated by `x`; it is a `p`-group of order `p`.
  let H : Subgroup G := Subgroup.zpowers x
  have hHcard : Nat.card H = p := by
    show Nat.card ↥(Subgroup.zpowers x) = p
    rw [Nat.card_zpowers, hx]
  have hHp : IsPGroup p H := IsPGroup.of_card (n := 1) (by rw [hHcard, pow_one])
  haveI : Finite ↥S := Finite.of_injective (Subtype.val) Subtype.val_injective
  -- `H` acts on `S` by conjugation, using that `S` is a union of conjugacy classes.
  letI : MulAction H ↥S :=
    { smul := fun h y => ⟨(h : G) * (y : G) * (h : G)⁻¹, hS (h : G) (y : G) y.2⟩
      one_smul := by
        intro y; apply Subtype.ext
        change (1 : G) * (y : G) * (1 : G)⁻¹ = (y : G)
        simp
      mul_smul := by
        intro a b y; apply Subtype.ext
        change (↑(a * b) : G) * ↑y * (↑(a * b) : G)⁻¹
          = (↑a : G) * ((↑b : G) * ↑y * (↑b : G)⁻¹) * (↑a : G)⁻¹
        rw [Subgroup.coe_mul]; group }
  -- Fixed-point congruence for the `p`-group action.
  have key := hHp.card_modEq_card_fixedPoints ↥S
  -- The fixed points are exactly the elements of `S` commuting with `x`.
  have hmem : ∀ y : ↥S, y ∈ fixedPoints H ↥S ↔ x * (y : G) = (y : G) * x := by
    intro y
    rw [mem_fixedPoints]
    constructor
    · intro h
      have hx1 := h ⟨x, Subgroup.mem_zpowers x⟩
      have hv : x * (y : G) * x⁻¹ = (y : G) := congrArg Subtype.val hx1
      exact mul_inv_eq_iff_eq_mul.mp hv
    · intro hcomm h
      apply Subtype.ext
      change (↑h : G) * ↑y * (↑h)⁻¹ = ↑y
      have hc : Commute (↑h : G) (↑y : G) := by
        obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp h.2
        rw [← hk]
        exact (show Commute x (↑y : G) from hcomm).zpow_left k
      rw [hc.eq, mul_inv_cancel_right]
  have e1 : {y : ↥S // y ∈ fixedPoints H ↥S} ≃ {y : ↥S // x * (y : G) = (y : G) * x} :=
    Equiv.subtypeEquivRight hmem
  have e2 : {y : ↥S // x * (y : G) = (y : G) * x} ≃ {y : G // y ∈ S ∧ x * y = y * x} :=
    Equiv.subtypeSubtypeEquivSubtypeInter (fun y : G => y ∈ S) (fun y : G => x * y = y * x)
  have hfix : Nat.card ↥(fixedPoints H ↥S)
      = Nat.card ↥({y ∈ S | x * y = y * x} : Set G) :=
    Nat.card_congr (e1.trans e2)
  rw [hfix] at key
  exact key

end Work.BSW.Cases.Order
