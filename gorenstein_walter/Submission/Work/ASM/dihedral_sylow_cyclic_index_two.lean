import Mathlib

namespace Work.ASM

/-- A finite `2`-group isomorphic to a dihedral group `DihedralGroup n` admits a cyclic subgroup
of index two, containing an involution.  Concretely, the preimage of the rotation subgroup
`⟨r⟩ ≤ DihedralGroup n` under `e` is cyclic (generated by `e.symm r`), has index two because
`|DihedralGroup n| = 2 n`, and contains an element of order two because `n` is even
(`n = 2 ^ k` is a power of two and `n ≠ 1`). -/
theorem dihedral_sylow_cyclic_index_two {G : Type*} [Group G] [Finite G] (S : Sylow 2 G) {n : ℕ}
    (hcyc : ¬ IsCyclic ↥(S : Subgroup G)) (e : ↥(S : Subgroup G) ≃* DihedralGroup n) :
    ∃ (S0 : Subgroup G) (t : G), S0 ≤ (S : Subgroup G) ∧ IsCyclic S0 ∧
      S0.relIndex (S : Subgroup G) = 2 ∧ t ∈ S0 ∧ orderOf t = 2 := by
  -- `S` is not cyclic, so `n ≠ 1` (since `DihedralGroup 1` is cyclic).
  have hn1 : n ≠ 1 := by
    intro h
    exact hcyc (e.isCyclic.mpr ((DihedralGroup.isCyclic_iff (n := n)).mpr h))
  -- A generator of the rotation subgroup `⟨r⟩`, transported into `S`.
  let gS : ↥(S : Subgroup G) := e.symm (DihedralGroup.r 1)
  have horder : orderOf gS = n := by
    show orderOf (e.symm (DihedralGroup.r 1)) = n
    rw [MulEquiv.orderOf_eq e.symm (DihedralGroup.r 1), DihedralGroup.orderOf_r_one]
  have horderg : orderOf (gS : G) = n := by
    rw [Subgroup.orderOf_coe, horder]
  have hgS_mem : (gS : G) ∈ (S : Subgroup G) := gS.2
  -- `n` is a power of two, because `S` is a `2`-group and `orderOf gS = n`.
  obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp S.isPGroup') gS
  have hpow : n = 2 ^ k := horder.symm.trans hk
  have hn0 : n ≠ 0 := by rw [hpow]; positivity
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
  have hkpos : 1 ≤ k := by
    rcases Nat.eq_zero_or_pos k with hk0 | hkpos
    · exact absurd (by rw [hpow, hk0]; rfl : n = 1) hn1
    · exact hkpos
  have h2dvd : 2 ∣ n := by
    rw [hpow]
    simpa using Nat.pow_dvd_pow 2 hkpos
  -- Cardinality bookkeeping.
  have hcard_SS : Nat.card ↥(S : Subgroup G) = 2 * n := by
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hcard_S0 : Nat.card ↥(Subgroup.zpowers (gS : G)) = n := by
    rw [Nat.card_zpowers, horderg]
  have hS0_le : Subgroup.zpowers (gS : G) ≤ (S : Subgroup G) :=
    Subgroup.zpowers_le.mpr hgS_mem
  -- The relative index is two.
  have hrel : (Subgroup.zpowers (gS : G)).relIndex (S : Subgroup G) = 2 := by
    have h := Subgroup.relIndex_mul_card (Subgroup.zpowers (gS : G)) (S : Subgroup G)
    rw [inf_eq_left.mpr hS0_le, hcard_S0, hcard_SS] at h
    exact Nat.mul_right_cancel hnpos h
  -- The cyclic group `S₀` has even order, hence contains an involution (Cauchy).
  have : Fintype ↥(Subgroup.zpowers (gS : G)) := Fintype.ofFinite _
  have hdvd : 2 ∣ Fintype.card ↥(Subgroup.zpowers (gS : G)) := by
    rw [← Nat.card_eq_fintype_card, hcard_S0]
    exact h2dvd
  obtain ⟨x, hx⟩ :=
    exists_prime_orderOf_dvd_card (G := ↥(Subgroup.zpowers (gS : G))) 2 hdvd
  exact ⟨Subgroup.zpowers (gS : G), (x : G), hS0_le, Subgroup.isCyclic_zpowers _,
    hrel, x.2, by rw [Subgroup.orderOf_coe, hx]⟩

end Work.ASM
