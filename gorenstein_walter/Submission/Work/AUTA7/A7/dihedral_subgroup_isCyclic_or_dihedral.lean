import Mathlib
import Submission.Work.AUTA7.A7.CardInfMulTwoOfIndexTwo

set_option linter.style.haveILetI false

namespace Work.AUTA7.A7

/-!
# Subgroups of a dihedral group are cyclic or dihedral

The rotation subgroup `⟨r 1⟩` of `DihedralGroup n` has index two and is cyclic, so a subgroup `H`
which is contained in it is cyclic.  Otherwise `K = H ⊓ ⟨r 1⟩` has index two in `H`, we pick
`x` with `⟨x⟩ = K` and a reflection `t ∈ H`; conjugation by `t` inverts every element of `⟨r 1⟩`,
so `H ≅ DihedralGroup |K|`.

The auxiliary material below builds the isomorphism for an abstract group generated by an element
`x` of order dividing `d` and an involution `t` acting by inversion.
-/

/-- The underlying function of the standard identification of `DihedralGroup d` with the group
generated by an element `x` (playing the role of the rotations) and an element `t` (playing the
role of a reflection): `r i ↦ x ^ i.val`, `sr i ↦ t * x ^ i.val`. -/
def dihMap {G : Type*} [Monoid G] (d : ℕ) (x t : G) : DihedralGroup d → G
  | .r i => x ^ i.val
  | .sr i => t * x ^ i.val

/-- `x ^ (d - k)` is the inverse of `x ^ k` when `x ^ d = 1` and `k ≤ d`. -/
lemma pow_d_sub {G : Type*} [Group G] {x : G} {d k : ℕ} (hx : x ^ d = 1) (hk : k ≤ d) :
    x ^ (d - k) = (x ^ k)⁻¹ := by
  have h : x ^ k * x ^ (d - k) = 1 := by
    rw [← pow_add, Nat.add_sub_cancel' hk, hx]
  exact eq_inv_of_mul_eq_one_right h

/-- Exponent bookkeeping for `r * r` in `DihedralGroup d`, transported by `dihMap`. -/
lemma pow_val_add {G : Type*} [Group G] {d : ℕ} [NeZero d] {x : G} (hx : x ^ d = 1)
    (a b : ZMod d) : x ^ (a + b).val = x ^ a.val * x ^ b.val := by
  rw [← pow_add]
  refine pow_eq_pow_of_modEq ?_ hx
  rw [Nat.ModEq, ZMod.val_add, Nat.mod_mod]

/-- Exponent bookkeeping for the `sr * sr` and `r * sr` cases in `DihedralGroup d`. -/
lemma pow_val_sub {G : Type*} [Group G] {d : ℕ} [NeZero d] {x : G} (hx : x ^ d = 1)
    (a b : ZMod d) : x ^ (b - a).val = (x ^ a.val)⁻¹ * x ^ b.val := by
  have hmod : (b - a).val ≡ b.val + (d - a.val) [MOD d] := by
    have hda : (↑(a.val) : ZMod d) + ↑(d - a.val) = 0 := by
      rw [← Nat.cast_add, Nat.add_sub_cancel' (le_of_lt (ZMod.val_lt a)), ZMod.natCast_self]
    have hneg : (↑(d - a.val) : ZMod d) = -(↑a.val) := eq_neg_of_add_eq_zero_right hda
    have hb : b - a = ((b.val + (d - a.val) : ℕ) : ZMod d) := by
      have hb1 : b - a = ((b.val : ZMod d)) - ((a.val : ZMod d)) := by
        rw [ZMod.natCast_zmod_val b, ZMod.natCast_zmod_val a]
      have hb2 : ((b.val : ZMod d)) - ((a.val : ZMod d)) =
          ((b.val + (d - a.val) : ℕ) : ZMod d) := by
        rw [sub_eq_add_neg, ← hneg, ← Nat.cast_add]
      exact hb1.trans hb2
    rw [Nat.ModEq, hb, ZMod.val_natCast, Nat.mod_mod]
  rw [pow_eq_pow_of_modEq hmod hx, ← pow_d_sub hx (le_of_lt (ZMod.val_lt a)), ← pow_add]
  congr 1
  exact Nat.add_comm _ _

/-- Moving `t` past a power of `x`: `x ^ k * t = t * (x ^ k)⁻¹`. -/
lemma pow_mul_t {G : Type*} [Group G] {d : ℕ} {x t : G} (hx : x ^ d = 1) (ht : t * t = 1)
    (hid : ∀ k : ℕ, k ≤ d → t * x ^ k * t = x ^ (d - k)) {k : ℕ} (hk : k ≤ d) :
    x ^ k * t = t * (x ^ k)⁻¹ := by
  have key : x ^ k * t = t * x ^ (d - k) := by
    have h1 : x ^ k * t = t⁻¹ * x ^ (d - k) := by
      rw [← hid k hk]
      group
    rwa [inv_eq_of_mul_eq_one_left ht] at h1
  rw [key, pow_d_sub hx hk]

/-- Moving `t` past a power of `x` inside a product. -/
lemma pow_mul_t_mul {G : Type*} [Group G] {d : ℕ} {x t : G} (hx : x ^ d = 1) (ht : t * t = 1)
    (hid : ∀ k : ℕ, k ≤ d → t * x ^ k * t = x ^ (d - k)) {k : ℕ} (hk : k ≤ d) (y : G) :
    x ^ k * (t * y) = t * ((x ^ k)⁻¹ * y) :=
  calc x ^ k * (t * y) = (x ^ k * t) * y := (mul_assoc _ _ _).symm
    _ = (t * (x ^ k)⁻¹) * y := by rw [pow_mul_t hx ht hid hk]
    _ = t * ((x ^ k)⁻¹ * y) := mul_assoc _ _ _

/-- The product of two reflections written as `t * x ^ k` and `t * y`. -/
lemma mul_t_pow_mul {G : Type*} [Group G] {d : ℕ} {x t : G}
    (hid : ∀ k : ℕ, k ≤ d → t * x ^ k * t = x ^ (d - k)) {k : ℕ} (hk : k ≤ d) (y : G) :
    (t * x ^ k) * (t * y) = x ^ (d - k) * y :=
  calc (t * x ^ k) * (t * y) = ((t * x ^ k) * t) * y := (mul_assoc _ _ _).symm
    _ = x ^ (d - k) * y := by rw [hid k hk]

/-- `dihMap` is multiplicative as soon as `x ^ d = 1`, `t ^ 2 = 1` and `t` conjugates `x ^ k` to
its inverse. -/
lemma dihMap_mul {G : Type*} [Group G] {d : ℕ} [NeZero d] {x t : G}
    (hx : x ^ d = 1) (ht : t * t = 1)
    (hid : ∀ k : ℕ, k ≤ d → t * x ^ k * t = x ^ (d - k)) :
    ∀ a b : DihedralGroup d, dihMap d x t (a * b) = dihMap d x t a * dihMap d x t b := by
  rintro (i | i) (j | j)
  · show x ^ (i + j).val = x ^ i.val * x ^ j.val
    exact pow_val_add hx i j
  · show t * x ^ (j - i).val = x ^ i.val * (t * x ^ j.val)
    rw [pow_val_sub hx i j, pow_mul_t_mul hx ht hid (le_of_lt (ZMod.val_lt i))]
  · show t * x ^ (i + j).val = (t * x ^ i.val) * x ^ j.val
    rw [pow_val_add hx i j, mul_assoc]
  · show x ^ (j - i).val = (t * x ^ i.val) * (t * x ^ j.val)
    rw [pow_val_sub hx i j, mul_t_pow_mul hid (le_of_lt (ZMod.val_lt i)),
      pow_d_sub hx (le_of_lt (ZMod.val_lt i))]

/-- Every element of the rotation subgroup `⟨r 1⟩` of `DihedralGroup n`. -/
lemma r_mem_zpowers_r_one (n : ℕ) [NeZero n] (i : ZMod n) :
    (DihedralGroup.r i) ∈ Subgroup.zpowers (DihedralGroup.r 1 : DihedralGroup n) := by
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨(i.val : ℤ), ?_⟩
  rw [DihedralGroup.r_one_zpow]
  congr 1
  push_cast
  exact ZMod.natCast_zmod_val i

theorem dihedral_subgroup_isCyclic_or_dihedral {n : ℕ} [NeZero n]
    (H : Subgroup (DihedralGroup n)) :
    IsCyclic H ∨ ∃ m : ℕ, Nonempty (H ≃* DihedralGroup m) := by
  classical
  set R : Subgroup (DihedralGroup n) := Subgroup.zpowers (DihedralGroup.r 1) with hR
  haveI hRcyc : IsCyclic ↥R := by rw [hR]; infer_instance
  -- the rotation subgroup has index two
  have hRidx : R.index = 2 := by
    have hRcard : Nat.card ↥R = n := by
      rw [hR, Nat.card_zpowers, DihedralGroup.orderOf_r_one]
    have h := Subgroup.card_mul_index R
    rw [hRcard, DihedralGroup.nat_card] at h
    have h2 : n * R.index = n * 2 := by rw [h, mul_comm]
    exact Nat.mul_left_cancel (Nat.pos_of_ne_zero (NeZero.ne n)) h2
  by_cases hle : H ≤ R
  · exact Or.inl (Subgroup.isCyclic_of_le hle)
  · refine Or.inr ?_
    -- an element of `H` outside `R` is a reflection
    obtain ⟨t, htH, htR⟩ := Set.not_subset.mp hle
    have ht_sr : ∃ j : ZMod n, t = DihedralGroup.sr j := by
      rcases t with i | i
      · exact absurd (r_mem_zpowers_r_one n i) htR
      · exact ⟨i, rfl⟩
    obtain ⟨j, hj⟩ := ht_sr
    have ht2 : t * t = 1 := by rw [hj]; exact DihedralGroup.sr_mul_self j
    -- a generator `x` of `K = H ⊓ ⟨r 1⟩`
    have hKcyc : IsCyclic ↥(H ⊓ R) := Subgroup.isCyclic_of_le inf_le_right
    obtain ⟨x, hxK⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top (H ⊓ R)).mp hKcyc
    have hxle : Subgroup.zpowers x ≤ R := by rw [hxK]; exact inf_le_right
    have hxleH : Subgroup.zpowers x ≤ H := by rw [hxK]; exact inf_le_left
    have hxH : x ∈ H := hxleH (Subgroup.mem_zpowers x)
    set d : ℕ := Nat.card ↥(H ⊓ R) with hd
    have hxd : orderOf x = d := by rw [hd, ← Nat.card_zpowers, hxK]
    have hxpow : x ^ d = 1 := by rw [← hxd]; exact pow_orderOf_eq_one x
    haveI hdz : NeZero d := ⟨by
      rw [hd]
      exact (Nat.card_pos_iff.mpr ⟨⟨1, (H ⊓ R).one_mem⟩, inferInstance⟩).ne'⟩
    -- conjugation by `t` inverts the rotations
    have hconj : ∀ y ∈ R, t * y * t = y⁻¹ := by
      intro y hy
      rw [hR, Subgroup.mem_zpowers_iff] at hy
      obtain ⟨m, rfl⟩ := hy
      have hconjr : t * (DihedralGroup.r 1 : DihedralGroup n) * t =
          (DihedralGroup.r 1 : DihedralGroup n)⁻¹ := by
        rw [hj, DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr, DihedralGroup.inv_r]
        congr 1
        ring
      calc t * (DihedralGroup.r 1 : DihedralGroup n) ^ m * t
          = (MulAut.conj t) ((DihedralGroup.r 1 : DihedralGroup n) ^ m) := by
            rw [MulAut.conj_apply, inv_eq_of_mul_eq_one_left ht2]
        _ = ((MulAut.conj t) (DihedralGroup.r 1 : DihedralGroup n)) ^ m := map_zpow _ _ m
        _ = ((DihedralGroup.r 1 : DihedralGroup n)⁻¹) ^ m := by
            rw [MulAut.conj_apply, inv_eq_of_mul_eq_one_left ht2, hconjr]
        _ = (((DihedralGroup.r 1 : DihedralGroup n) ^ m))⁻¹ := inv_zpow _ m
    have hid : ∀ k : ℕ, k ≤ d → t * x ^ k * t = x ^ (d - k) := by
      intro k hk
      have hmem : x ^ k ∈ R := hxle (Subgroup.pow_mem (Subgroup.zpowers x) (Subgroup.mem_zpowers x) k)
      rw [hconj (x ^ k) hmem]
      exact (pow_d_sub hxpow hk).symm
    have hmm : ∀ a b : DihedralGroup d,
        dihMap d x t (a * b) = dihMap d x t a * dihMap d x t b :=
      dihMap_mul hxpow ht2 hid
    have hHmem : ∀ a : DihedralGroup d, dihMap d x t a ∈ H := by
      intro a
      rcases a with i | i
      · exact Subgroup.pow_mem H hxH i.val
      · exact Subgroup.mul_mem H htH (Subgroup.pow_mem H hxH i.val)
    have hnotR : ∀ k : ℕ, t * x ^ k ∉ R := by
      intro k hk
      apply htR
      have hxkR : x ^ k ∈ R := hxle (Subgroup.pow_mem (Subgroup.zpowers x) (Subgroup.mem_zpowers x) k)
      have hkey : t = (t * x ^ k) * (x ^ k)⁻¹ := by group
      rw [hkey]
      exact Subgroup.mul_mem R hk (Subgroup.inv_mem R hxkR)
    have hinj : Function.Injective (dihMap d x t) := by
      rintro (i | i) (j | j) h
      · simp only [dihMap] at h
        have h2 : i.val = j.val := by
          rw [pow_eq_pow_iff_modEq, hxd] at h
          exact Nat.ModEq.eq_of_lt_of_lt h (ZMod.val_lt i) (ZMod.val_lt j)
        exact congrArg DihedralGroup.r (ZMod.val_injective d h2)
      · simp only [dihMap] at h
        exact absurd (h ▸ hxle (Subgroup.pow_mem (Subgroup.zpowers x) (Subgroup.mem_zpowers x) i.val))
          (hnotR j.val)
      · simp only [dihMap] at h
        exact absurd (h ▸ hxle (Subgroup.pow_mem (Subgroup.zpowers x) (Subgroup.mem_zpowers x) j.val))
          (hnotR i.val)
      · simp only [dihMap] at h
        have h2 : x ^ i.val = x ^ j.val := mul_left_cancel h
        have h3 : i.val = j.val := by
          rw [pow_eq_pow_iff_modEq, hxd] at h2
          exact Nat.ModEq.eq_of_lt_of_lt h2 (ZMod.val_lt i) (ZMod.val_lt j)
        exact congrArg DihedralGroup.sr (ZMod.val_injective d h3)
    let ψ : DihedralGroup d →* ↥H :=
      MonoidHom.mk' (fun a => (⟨dihMap d x t a, hHmem a⟩ : ↥H)) (by
        intro a b
        apply Subtype.ext
        exact hmm a b)
    have hcard : Fintype.card (DihedralGroup d) = Fintype.card ↥H := by
      have h1 : d * 2 = Nat.card ↥H := by
        rw [hd]; exact CardInfMulTwoOfIndexTwo R H hRidx hle
      rw [DihedralGroup.card, mul_comm, ← Nat.card_eq_fintype_card]
      exact h1
    have hbijψ : Function.Bijective ψ := by
      rw [Fintype.bijective_iff_injective_and_card]
      refine ⟨?_, hcard⟩
      intro a b hab
      exact hinj (congrArg Subtype.val hab)
    exact ⟨d, ⟨(MulEquiv.ofBijective ψ hbijψ).symm⟩⟩

end Work.AUTA7.A7
