import Mathlib
import Submission.Work.A7.Defs
import Submission.Work.AUTA7.A7.CentralizerOrderThree
import Submission.Work.AUTA7.A7.CardInfMulTwoOfIndexTwo

namespace Work.AUTA7.A7

open scoped MatrixGroups
open Equiv Equiv.Perm

/-- `C_{A₇}(a7K) = C_{A₇}((4 5 6))` has order `36`.  In `S₇` the centralizer of the `3`-cycle `(4 5 6)` is `⟨(456)⟩ × S₄`, of order `72`, and it is not contained in `A₇` — e.g. `(0 1)` centralizes `(456)` and is odd — so its intersection with the index-`2` subgroup `A₇` has order `36` (`CardInfMulTwoOfIndexTwo`), and that intersection carries the centralizer inside `A₇` (`Work.AUTA7.A7.nat_card_centralizer_coe`).  Useful ingredients: `Equiv.Perm.nat_card_centralizer` with `cycleType = {3}` (which is `by decide` for `a7ThreeCycle`), `alternatingGroup.index_eq_two`, `Work.AUTA7.A7.cycleType_eq_three_or_three_three`, `Work.AUTA7.A7.CentralizerOrderThree` (gives `36 ∨ 9`), `Work.A7.card_a7K`, `Subgroup.centralizer_closure`, and the fact that `Subgroup.centralizer (zpowers x : Set G) = Subgroup.centralizer ({x} : Set G)`. -/
theorem A7KCentralizerCard : Nat.card (Subgroup.centralizer (Work.A7.a7K : Set (alternatingGroup (Fin 7)))) = 36 := by
  -- `a7K` is the cyclic subgroup generated by the `3`-cycle `(4 5 6)`, so its centralizer is the
  -- centralizer of that single element (`Subgroup.centralizer_closure`).
  have hcent : Subgroup.centralizer (Work.A7.a7K : Set (alternatingGroup (Fin 7))) =
      Subgroup.centralizer ({Work.A7.a7ThreeCycle} : Set (alternatingGroup (Fin 7))) := by
    rw [Work.A7.a7K, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  rw [hcent]
  classical
  -- `CS` is the centralizer of `(4 5 6)` inside the full symmetric group `S₇`.
  set CS : Subgroup (Perm (Fin 7)) :=
    Subgroup.centralizer ({(Work.A7.a7ThreeCycle : Perm (Fin 7))} : Set (Perm (Fin 7))) with hCS
  -- `(4 5 6)` is a genuine `3`-cycle, so its `S₇`-centralizer `⟨(456)⟩ × S₄` has order `24 * 3 = 72`.
  have hct : (Work.A7.a7ThreeCycle : Perm (Fin 7)).cycleType = ({3} : Multiset ℕ) := by decide
  have hcardS : Nat.card ↥CS = 72 := by
    rw [hCS, Equiv.Perm.nat_card_centralizer, hct]
    norm_num
  have hindex : (alternatingGroup (Fin 7) : Subgroup (Perm (Fin 7))).index = 2 :=
    alternatingGroup.index_eq_two
  -- The odd permutation `(0 1)` centralizes `(4 5 6)`, so `CS` is not contained in `A₇`.
  have hnotle : ¬ CS ≤ (alternatingGroup (Fin 7) : Subgroup (Perm (Fin 7))) := by
    intro hle
    have h1 : (Equiv.swap 0 1 : Perm (Fin 7)) ∈ CS := by
      rw [hCS, Subgroup.mem_centralizer_singleton_iff]
      decide
    have hx := hle h1
    rw [Equiv.Perm.mem_alternatingGroup, Equiv.Perm.sign_swap (by decide : (0 : Fin 7) ≠ 1)] at hx
    exact absurd hx (by decide)
  -- hence `A₇ ⊓ CS` has half the order of `CS`, namely `36`
  have hcard36 :
      Nat.card ↥((alternatingGroup (Fin 7) : Subgroup (Perm (Fin 7))) ⊓ CS) = 36 := by
    have h1 := CardInfMulTwoOfIndexTwo (alternatingGroup (Fin 7)) CS hindex hnotle
    rw [hcardS] at h1
    have h2 : Nat.card ↥(CS ⊓ (alternatingGroup (Fin 7) : Subgroup (Perm (Fin 7)))) = 36 := by
      omega
    simpa only [inf_comm] using h2
  -- and this intersection is exactly the `A₇`-centralizer of `(4 5 6)`
  have hcoe := nat_card_centralizer_coe Work.A7.a7ThreeCycle
  rw [hcoe]
  exact hcard36

end Work.AUTA7.A7
