/-
Area `A7REC` (recognition of `A₇`), file `Basic/exists_tau_order_four.lean`.

# The self-centralising cyclic subgroup of order `4` of the Sylow `2`-subgroup

Let `G` be a finite group satisfying the `A₇` hypotheses (`A7RecCtx G`): a Sylow `2`-subgroup
`S ≅ D₈ = DihedralGroup 4` with central involution `z`, `C_G(z) = U ⊔ S` with `|U| = 3` and
`U ⊴ C_G(z)`, `V = O₂(C_G(z))` a four-group and `N_G(U) = N_G(V)` of order `72`.

This file proves that `S` contains an element `τ` of order `4` which is *self-centralising* and
whose normalizer is exactly `S`:

`∃ τ ∈ S, orderOf τ = 4 ∧ C_G(τ) = ⟨τ⟩ ∧ N_G(⟨τ⟩) = S`.

Such an element is the starting point of Suzuki's §8 argument: `{τ, τ⁻¹}` is a TI subset of `S`
with normalizer bound `S` (`Work.A7REC.A7TIOrderFourProp`).

## The proof

* `τ` is `e.symm (r 1)` for the rotation `r 1` of `D₈`; it has order `4` and `τ ∈ S`.
* `τ² = z` (`Basic/sq_eq_z_of_order_four`), so `C_G(τ) ≤ C_G(τ²) = C_G(z) = U ⊔ S`.
* `C_S(τ) = ⟨τ⟩`: the centralizer of a rotation in `D₈` is the rotation subgroup
  (`dihedral_four_centralizer_r_one`, transported along `e`).
* `S ⊓ C_G(U) = V`: `V ≤ C_G(U)` (`commute_U_V`) and `|S ⊓ C_G(U)|` divides both `8` and `36`
  (`card_S`, `card_centralizer_U`), hence divides `4 = |V|`.  As `V` is a four-group, of
  exponent two, no element of `S` of order `4` centralises `U`; and then `C_U(τ) = 1`
  (`U = ⟨u⟩` for `1 ≠ u ∈ U`).
* If `y ∈ C_G(τ)`, then `y ∈ C_G(z) = U ⊔ S`, so `y = a * b` with `a ∈ U`, `b ∈ S`
  (`exists_mul_eq_of_mem_sup_of_normal_subgroupOf`).  Commuting `y` with `τ` gives
  `b * τ * b⁻¹ = a⁻¹ * τ * a`, hence `b * τ * b⁻¹ * τ⁻¹ = a⁻¹ * (τ * a * τ⁻¹) ∈ U` (as `U` is
  normal in `U ⊔ S`), while also `b * τ * b⁻¹ * τ⁻¹ ∈ S`; so this element lies in
  `U ⊓ S = ⊥`, i.e. `b ∈ C_S(τ) = ⟨τ⟩`.  Then `a = y * b⁻¹ ∈ U ∩ C_G(τ) = 1`, so `y = b ∈ ⟨τ⟩`
  and `C_G(τ) = ⟨τ⟩`.
* `N_G(⟨τ⟩)/C_G(τ) ↪ Aut(⟨τ⟩) ≅ C₂` gives `|N_G(⟨τ⟩)| ≤ 4 · 2 = 8`
  (`card_normalizer_le_mul_card_mulAut`), while `S ≤ N_G(⟨τ⟩)` because `|S : ⟨τ⟩| = 2`
  (`Subgroup.normal_of_index_eq_two`).  As `|S| = 8`, this forces `N_G(⟨τ⟩) = S`.
-/
import Mathlib
import Submission.Work.A7REC.Api
import Submission.Work.A7REC.Assembly
import Submission.Work.A7REC.Basic.sq_eq_z_of_order_four

namespace Work.A7REC.Basic

open Subgroup

/-! ## The centralizer of the rotation `r 1` of `D₈` -/

/-- In `D₈ = DihedralGroup 4`, the elements commuting with the rotation `r 1` are exactly the
rotations, i.e. the powers of `r 1`.  (A reflection `sr i` conjugates `r j` to `r (-j)`, so it
would force `r (-1) = r 1`, i.e. `-1 = 1` in `ZMod 4`.) -/
lemma dihedral_four_centralizer_r_one :
    Subgroup.centralizer ({(DihedralGroup.r (1 : ZMod 4))} : Set (DihedralGroup 4)) =
      Subgroup.zpowers (DihedralGroup.r (1 : ZMod 4)) := by
  refine le_antisymm ?_ ?_
  · intro y hy
    rw [Subgroup.mem_centralizer_iff] at hy
    cases y with
    | r i =>
      exact Subgroup.mem_zpowers_iff.mpr ⟨(i.val : ℤ), by rw [DihedralGroup.r_zpow]; simp⟩
    | sr i =>
      exfalso
      have hcomm : (DihedralGroup.sr i) * DihedralGroup.r (1 : ZMod 4)
          = DihedralGroup.r (1 : ZMod 4) * (DihedralGroup.sr i) :=
        (hy (DihedralGroup.r (1 : ZMod 4)) (by simp)).symm
      have h1 : (DihedralGroup.sr i) * DihedralGroup.r (1 : ZMod 4) * (DihedralGroup.sr i)⁻¹
          = DihedralGroup.r (-1 : ZMod 4) := by
        rw [DihedralGroup.sr_mul_r, DihedralGroup.inv_sr, DihedralGroup.sr_mul_sr]
        congr 1
        ring
      have h2 : (DihedralGroup.sr i) * DihedralGroup.r (1 : ZMod 4) * (DihedralGroup.sr i)⁻¹
          = DihedralGroup.r (1 : ZMod 4) := by
        rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
      have h3 : (-1 : ZMod 4) = 1 := DihedralGroup.r.inj (by rw [← h1, h2])
      have h4 : ¬ ((-1 : ZMod 4) = 1) := by decide
      exact h4 h3
  · intro y hy
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    subst hw
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    simpa using (Commute.zpow_zpow_self (DihedralGroup.r (1 : ZMod 4)) 1 k).eq

/-! ## Group-theoretic tools -/

/-- The centralizer of the cyclic subgroup generated by `g` is the centralizer of `g`. -/
lemma centralizer_zpowers_eq_centralizer_singleton {G : Type*} [Group G] (g : G) :
    Subgroup.centralizer (Subgroup.zpowers g : Set G) = Subgroup.centralizer ({g} : Set G) := by
  refine le_antisymm (Subgroup.centralizer_le fun x hx => ?_) fun x hx => ?_
  · rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact Subgroup.mem_zpowers g
  · rw [Subgroup.mem_centralizer_iff] at hx ⊢
    intro y hy
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    exact (Commute.zpow_left ((commute_iff_eq g x).mpr (hx g (by simp))) k).eq

/-- **Decomposition in a join.**  If `A` is normal in `A ⊔ B` and `x ∈ A ⊔ B`, then `x = a * b`
with `a ∈ A`, `b ∈ B`. -/
lemma exists_mul_eq_of_mem_sup_of_normal_subgroupOf {G : Type*} [Group G] {A B : Subgroup G}
    (h : (A.subgroupOf (A ⊔ B)).Normal) {x : G} (hx : x ∈ A ⊔ B) :
    ∃ a ∈ A, ∃ b ∈ B, a * b = x := by
  have htop : (A.subgroupOf (A ⊔ B)) ⊔ (B.subgroupOf (A ⊔ B)) = ⊤ := by
    rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right, Subgroup.subgroupOf_self]
  have hmem : (⟨x, hx⟩ : ↥(A ⊔ B)) ∈ A.subgroupOf (A ⊔ B) ⊔ B.subgroupOf (A ⊔ B) := by
    rw [htop]
    exact trivial
  obtain ⟨a, ha, b, hb, hab⟩ :=
    (Subgroup.mem_sup_of_normal_left (s := A.subgroupOf (A ⊔ B))
      (t := B.subgroupOf (A ⊔ B)) (hs := h)).mp hmem
  exact ⟨(a : G), ha, (b : G), hb, congrArg Subtype.val hab⟩

/-- **The `N/C` bound.**  Conjugation is a homomorphism `N_G(H) →* Aut(H)` with kernel `C_G(H)`,
so `|N_G(H)| ≤ |C_G(H)| · |Aut H|`. -/
lemma card_normalizer_le_mul_card_mulAut {G : Type*} [Group G] [Finite G] (H : Subgroup G) :
    Nat.card (Subgroup.normalizer (H : Set G)) ≤
      Nat.card (Subgroup.centralizer (H : Set G)) * Nat.card (MulAut H) := by
  have hC_le : Subgroup.centralizer (H : Set G) ≤ Subgroup.normalizer (H : Set G) :=
    Subgroup.centralizer_le_normalizer (H : Set G)
  have hker : Nat.card (Subgroup.normalizerMonoidHom (H := H)).ker =
      Nat.card (Subgroup.centralizer (H : Set G)) := by
    rw [Subgroup.normalizerMonoidHom_ker]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hC_le).toEquiv
  have hprod : Nat.card (Subgroup.normalizer (H : Set G)) =
      Nat.card (Subgroup.centralizer (H : Set G)) *
        Nat.card (Subgroup.normalizerMonoidHom (H := H)).range := by
    have h := Subgroup.card_ker_mul_card_range (Subgroup.normalizerMonoidHom (H := H))
    rw [hker] at h
    exact h.symm
  rw [hprod]
  refine Nat.mul_le_mul_left _ ?_
  calc Nat.card ↥(Subgroup.normalizerMonoidHom (H := H)).range
      ≤ Nat.card ↥(⊤ : Subgroup (MulAut ↥H)) := Subgroup.card_le_of_le le_top
    _ = Nat.card (MulAut ↥H) := Subgroup.card_top

/-! ## The main theorem -/

theorem exists_tau_order_four (G : Type*) [Group G] [Finite G] (ctx : Work.A7REC.A7RecCtx G) :
    ∃ τ : G, τ ∈ (ctx.S : Subgroup G) ∧ orderOf τ = 4 ∧
      Subgroup.centralizer ({τ} : Set G) = Subgroup.zpowers τ ∧
      Subgroup.normalizer (Subgroup.zpowers τ : Set G) = (ctx.S : Subgroup G) := by
  classical
  obtain ⟨e⟩ := ctx.hSdih
  -- `τ` is the rotation of order `4` of `S ≅ D₈`.
  set x : ↥(ctx.S : Subgroup G) := e.symm (DihedralGroup.r (1 : ZMod 4)) with hxdef
  set τ : G := (x : G) with hτdef
  have he_x : e x = DihedralGroup.r (1 : ZMod 4) := by
    rw [hxdef, MulEquiv.apply_symm_apply]
  have hτS : τ ∈ (ctx.S : Subgroup G) := x.2
  have hτ4 : orderOf τ = 4 := by
    have h1 : orderOf (e x) = orderOf x :=
      orderOf_injective (e : ↥(ctx.S : Subgroup G) →* DihedralGroup 4) e.injective x
    rw [he_x, DihedralGroup.orderOf_r_one] at h1
    rw [hτdef, Subgroup.orderOf_coe]
    exact h1.symm
  -- `τ² = z`
  have hτsq : τ ^ 2 = ctx.z := sq_eq_z_of_order_four G ctx hτS hτ4
  have hzp_le_S : Subgroup.zpowers τ ≤ (ctx.S : Subgroup G) := Subgroup.zpowers_le.mpr hτS
  -- `C_S(τ) = ⟨τ⟩`
  have hCS : (ctx.S : Subgroup G) ⊓ Subgroup.centralizer ({τ} : Set G) = Subgroup.zpowers τ := by
    refine le_antisymm ?_ (le_inf hzp_le_S ?_)
    · intro s hs
      rw [Subgroup.mem_inf] at hs
      have hcomm : s * τ = τ * s := ((Subgroup.mem_centralizer_iff.mp hs.2) τ (by simp)).symm
      have hmem' : e ⟨s, hs.1⟩ ∈
          Subgroup.centralizer ({(DihedralGroup.r (1 : ZMod 4))} : Set (DihedralGroup 4)) := by
        rw [Subgroup.mem_centralizer_iff]
        intro w hw
        rw [Set.mem_singleton_iff] at hw
        subst hw
        rw [← he_x, ← map_mul, ← map_mul]
        congr 1
        refine Subtype.ext ?_
        change (x : G) * (s : G) = (s : G) * (x : G)
        rw [← hτdef]
        exact hcomm.symm
      have hmem : e ⟨s, hs.1⟩ ∈ Subgroup.zpowers (DihedralGroup.r (1 : ZMod 4)) := by
        rwa [dihedral_four_centralizer_r_one] at hmem'
      rw [Subgroup.mem_zpowers_iff] at hmem ⊢
      obtain ⟨k, hk⟩ := hmem
      refine ⟨k, ?_⟩
      have h1 : x ^ k = (⟨s, hs.1⟩ : ↥(ctx.S : Subgroup G)) := by
        apply e.injective
        rw [map_zpow, he_x, hk]
      have h2 := congrArg (fun t : ↥(ctx.S : Subgroup G) => (t : G)) h1
      simpa [hτdef] using h2
    · intro y hy
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst hw
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
      simpa using (Commute.zpow_zpow_self τ 1 k).eq
  -- `S ⊓ C_G(U) = V`
  have hKS : (ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G) = ctx.V := by
    have hV_le : ctx.V ≤ (ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G) := by
      refine le_inf (V_le_S G ctx) ?_
      have h : ctx.U ≤ Subgroup.centralizer (ctx.V : Set G) :=
        (Subgroup.commutator_eq_bot_iff_le_centralizer (H₁ := ctx.U) (H₂ := ctx.V)).mp
          (commute_U_V G ctx)
      exact Subgroup.le_centralizer_iff.mp h
    refine (Subgroup.eq_of_le_of_card_ge (H := ctx.V) hV_le ?_).symm
    rw [ctx.hV4.1]
    have h1 : Nat.card ↥((ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G)) ∣ 8 := by
      have h := Subgroup.card_dvd_of_le (α := G)
        (inf_le_left : (ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G)
          ≤ (ctx.S : Subgroup G))
      rwa [card_S G ctx] at h
    have h2 : Nat.card ↥((ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G)) ∣ 36 := by
      have h := Subgroup.card_dvd_of_le (α := G)
        (inf_le_right : (ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G)
          ≤ Subgroup.centralizer (ctx.U : Set G))
      rwa [card_centralizer_U G ctx] at h
    have h3 := Nat.dvd_gcd h1 h2
    rw [show Nat.gcd 8 36 = 4 from by norm_num] at h3
    exact Nat.le_of_dvd (by norm_num) h3
  -- no element of `S` of order `4` centralises `U`
  have hτ_not_mem_cenU : τ ∉ Subgroup.centralizer (ctx.U : Set G) := by
    intro hmem
    have hτV : τ ∈ ctx.V := by
      have h : τ ∈ (ctx.S : Subgroup G) ⊓ Subgroup.centralizer (ctx.U : Set G) := ⟨hτS, hmem⟩
      rwa [hKS] at h
    have h2 : τ ^ 2 = 1 := ctx.hV4.2 τ hτV
    have h3 : orderOf τ ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr h2
    rw [hτ4] at h3
    obtain ⟨k, hk⟩ := h3
    omega
  -- `C_U(τ) = 1`
  have hCU : ∀ u ∈ ctx.U, u * τ = τ * u → u = 1 := by
    intro u hu hcomm
    by_contra hne
    have hord : orderOf u = 3 := by
      have hdvd : orderOf u ∣ 3 := by
        have h := Subgroup.card_dvd_of_le (α := G)
          (Subgroup.zpowers_le.mpr hu : Subgroup.zpowers u ≤ ctx.U)
        rwa [Nat.card_zpowers, ctx.hUcard] at h
      rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
      · exact absurd (orderOf_eq_one_iff.mp h1) hne
      · exact h3
    have hgen : Subgroup.zpowers u = ctx.U := by
      refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hu) ?_
      rw [Nat.card_zpowers, hord, ctx.hUcard]
    have hτ_cenU : τ ∈ Subgroup.centralizer (ctx.U : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      have hv' : v ∈ Subgroup.zpowers u := by rw [hgen]; exact hv
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv'
      exact (Commute.zpow_left ((commute_iff_eq u τ).mpr hcomm) k).eq
    exact hτ_not_mem_cenU hτ_cenU
  -- `C_G(τ) = ⟨τ⟩`
  have hcent : Subgroup.centralizer ({τ} : Set G) = Subgroup.zpowers τ := by
    have hUnorm' : (ctx.U.subgroupOf (ctx.U ⊔ (ctx.S : Subgroup G))).Normal := by
      rw [← ctx.hCz]
      exact ctx.hUnorm
    refine le_antisymm ?_ ?_
    · intro y hy
      have hyτ : τ * y = y * τ := (Subgroup.mem_centralizer_iff.mp hy) τ (by simp)
      have hyC : y ∈ ctx.U ⊔ (ctx.S : Subgroup G) := by
        rw [← ctx.hCz, Subgroup.mem_centralizer_iff]
        intro w hw
        rw [Set.mem_singleton_iff] at hw
        subst hw
        rw [← hτsq, pow_two]
        exact (Commute.mul_left hyτ hyτ).eq
      obtain ⟨a, ha, b, hb, hab⟩ :=
        exists_mul_eq_of_mem_sup_of_normal_subgroupOf
          (A := ctx.U) (B := (ctx.S : Subgroup G)) hUnorm' hyC
      have hτC : τ ∈ ctx.U ⊔ (ctx.S : Subgroup G) := Subgroup.mem_sup_right hτS
      -- `b * τ * b⁻¹ = a⁻¹ * τ * a`
      have hb_eq : b * τ * b⁻¹ = a⁻¹ * τ * a := by
        have h : τ * (a * b) = (a * b) * τ := by rw [hab]; exact hyτ
        have h1 : τ * a * b = a * b * τ := by rw [mul_assoc]; exact h
        have h2 := congrArg (fun x : G => a⁻¹ * x * b⁻¹) h1
        rw [show a⁻¹ * (τ * a * b) * b⁻¹ = a⁻¹ * τ * a by group,
          show a⁻¹ * (a * b * τ) * b⁻¹ = b * τ * b⁻¹ by group] at h2
        exact h2.symm
      have hwU : b * τ * b⁻¹ * τ⁻¹ ∈ ctx.U := by
        have hconj : τ * a * τ⁻¹ ∈ ctx.U :=
          conj_mem_of_subgroupOf_normal le_sup_left hUnorm' hτC ha
        have h3 : b * τ * b⁻¹ * τ⁻¹ = a⁻¹ * (τ * a * τ⁻¹) := by
          rw [hb_eq]
          group
        rw [h3]
        exact ctx.U.mul_mem (ctx.U.inv_mem ha) hconj
      have hwS : b * τ * b⁻¹ * τ⁻¹ ∈ (ctx.S : Subgroup G) :=
        (ctx.S : Subgroup G).mul_mem
          ((ctx.S : Subgroup G).mul_mem
            ((ctx.S : Subgroup G).mul_mem hb hτS) ((ctx.S : Subgroup G).inv_mem hb))
          ((ctx.S : Subgroup G).inv_mem hτS)
      have hw1 : b * τ * b⁻¹ * τ⁻¹ = 1 := by
        have h : b * τ * b⁻¹ * τ⁻¹ ∈ (⊥ : Subgroup G) := by
          rw [← U_inf_S G ctx]
          exact ⟨hwU, hwS⟩
        simpa using h
      have hb_conj : b * τ * b⁻¹ = τ := mul_inv_eq_one.mp hw1
      have hb_comm : b * τ = τ * b := by
        calc b * τ = (b * τ * b⁻¹) * b := by group
          _ = τ * b := by rw [hb_conj]
      have hb_mem : b ∈ Subgroup.zpowers τ := by
        have h : b ∈ (ctx.S : Subgroup G) ⊓ Subgroup.centralizer ({τ} : Set G) :=
          ⟨hb, Subgroup.mem_centralizer_iff.mpr (fun w hw => by
            rw [Set.mem_singleton_iff] at hw
            subst hw
            exact hb_comm.symm)⟩
        rwa [hCS] at h
      have ha1 : a = 1 := by
        have ha_eq : a = y * b⁻¹ := by rw [← hab]; group
        have hcomm_a : a * τ = τ * a := by
          rw [ha_eq]
          exact (Commute.mul_left ((commute_iff_eq y τ).mpr hyτ.symm)
            (((commute_iff_eq b τ).mpr hb_comm).inv_left)).eq
        exact hCU a ha hcomm_a
      rw [← hab, ha1, one_mul]
      exact hb_mem
    · intro y hy
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst hw
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
      simpa using (Commute.zpow_zpow_self τ 1 k).eq
  refine ⟨τ, hτS, hτ4, hcent, ?_⟩
  -- `N_G(⟨τ⟩) = S`
  have hcard_zp : Nat.card ↥((Subgroup.zpowers τ).subgroupOf (ctx.S : Subgroup G)) = 4 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hzp_le_S).toEquiv, Nat.card_zpowers, hτ4]
  have hnorm : ((Subgroup.zpowers τ).subgroupOf (ctx.S : Subgroup G)).Normal := by
    apply Subgroup.normal_of_index_eq_two
    rw [Subgroup.index_eq_card_div, hcard_zp, card_S G ctx]
  have hS_le_N : (ctx.S : Subgroup G) ≤ Subgroup.normalizer (Subgroup.zpowers τ : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hzp_le_S).mp hnorm
  have hCzp : Nat.card ↥(Subgroup.centralizer ((Subgroup.zpowers τ : Subgroup G) : Set G)) = 4 := by
    rw [centralizer_zpowers_eq_centralizer_singleton, hcent, Nat.card_zpowers, hτ4]
  have hAut : Nat.card (MulAut ↥(Subgroup.zpowers τ)) ≤ 2 := by
    rw [IsCyclic.card_mulAut, Nat.card_zpowers, hτ4]
    decide
  have hcardN : Nat.card ↥(Subgroup.normalizer (Subgroup.zpowers τ : Set G)) ≤ 8 := by
    have h := card_normalizer_le_mul_card_mulAut (Subgroup.zpowers τ)
    calc Nat.card ↥(Subgroup.normalizer (Subgroup.zpowers τ : Set G))
        ≤ Nat.card ↥(Subgroup.centralizer ((Subgroup.zpowers τ : Subgroup G) : Set G)) *
          Nat.card (MulAut ↥(Subgroup.zpowers τ)) := h
      _ ≤ 4 * 2 := by rw [hCzp]; exact Nat.mul_le_mul_left 4 hAut
      _ = 8 := by norm_num
  have hEq : (ctx.S : Subgroup G) = Subgroup.normalizer (Subgroup.zpowers τ : Set G) :=
    Subgroup.eq_of_le_of_card_ge hS_le_N (by rw [card_S G ctx]; exact hcardN)
  exact hEq.symm

end Work.A7REC.Basic
