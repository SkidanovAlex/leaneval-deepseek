/-
Area `A7REC` (recognition of `A₇`), file `Basic/sq_eq_z_of_order_four.lean`.

# The square of an element of order `4` of the Sylow `2`-subgroup is the central involution

Let `G` be a finite group satisfying the `A₇` hypotheses (`A7RecCtx G`), so that the Sylow
`2`-subgroup `S` is isomorphic to the dihedral group of order `8` (`DihedralGroup 4`), and let
`z ∈ S` be its central involution (`orderOf z = 2` and `z` commutes with every element of `S`).
We show that `τ ^ 2 = z` for every `τ ∈ S` of order `4`.

In `D₈ = ⟨r, s | r⁴ = s² = 1, s r s = r⁻¹⟩` the elements of order `4` are the rotations `r`, `r³`
and their common square is the central involution `r²`, which is the unique non-identity element
of the centre.  The proof below avoids the classification of the elements of `D₈` and uses only:

* `z` is central in `S`;
* if `z ∉ ⟨τ⟩`, then `⟨z⟩` and `⟨τ⟩` meet trivially and — as `z` is central — the join
  `⟨z⟩ ⊔ ⟨τ⟩` is an internal direct product of order `2 · 4 = 8 = |S|`, hence equal to `S`; but
  `⟨z⟩ ⊔ ⟨τ⟩` is generated by the commuting pair `z, τ`, so `S` would be commutative, a
  contradiction with `S ≃ D₈`;
* in the cyclic group `⟨τ⟩` of order `4`, the element of order `2` is unique, namely `τ²`.
-/
import Mathlib
import Submission.Work.A7REC.Defs
import Submission.Work.A7REC.Basic.four_subgroups_of_S
import Submission.Work.A7REC.Basic.card_S
import Submission.Work.A7REC.Join.card_sup_of_le_normalizer_of_disjoint

namespace Work.A7REC.Basic

open Subgroup

/-! ## Two general group-theoretic tools -/

/-- **A group generated by a central subgroup and an abelian subgroup with full join is
commutative.**

Let `Z ≤ center H` (so `Z` is normal) and suppose `W` is abelian and `Z ⊔ W = ⊤`.  Every element
of `H` is then a product `a * b` with `a ∈ Z`, `b ∈ W` (`Subgroup.mem_sup_of_normal_left`), and
such products commute: `a, c ∈ Z` are central, `b, d ∈ W` commute with each other, and each of
`a, c` commutes with each of `b, d`. -/
theorem mul_comm_of_le_center_sup {H : Type*} [Group H] {Z W : Subgroup H}
    (hZnorm : Z.Normal) (hZc : Z ≤ Subgroup.center H)
    (hWab : ∀ a ∈ W, ∀ b ∈ W, a * b = b * a)
    (hsup : Z ⊔ W = ⊤) : ∀ x y : H, x * y = y * x := by
  intro x y
  have hx : x ∈ Z ⊔ W := by rw [hsup]; exact trivial
  have hy : y ∈ Z ⊔ W := by rw [hsup]; exact trivial
  obtain ⟨a, ha, b, hb, rfl⟩ := (@Subgroup.mem_sup_of_normal_left H _ Z W hZnorm x).mp hx
  obtain ⟨c, hc, d, hd, rfl⟩ := (@Subgroup.mem_sup_of_normal_left H _ Z W hZnorm y).mp hy
  have hac : Commute a c := (commute_iff_eq a c).mpr (Subgroup.mem_center_iff.mp (hZc ha) c).symm
  have had : Commute a d := (commute_iff_eq a d).mpr (Subgroup.mem_center_iff.mp (hZc ha) d).symm
  have hbc : Commute b c := (commute_iff_eq b c).mpr (Subgroup.mem_center_iff.mp (hZc hc) b)
  have hbd : Commute b d := (commute_iff_eq b d).mpr (hWab b hb d hd)
  exact ((Commute.mul_left hac hbc).mul_right (Commute.mul_left had hbd)).eq

/-- **In a cyclic group of order `4` the unique element of order `2` is the square of a
generator.**

If `y ∈ ⟨x⟩` has order `2` while `orderOf x = 4`, then `y = x ^ 2`.  Write `y = x ^ k` with
`k : ℤ`.  From `y ^ 2 = 1` we get `x ^ (2 k) = 1`, i.e. `4 ∣ 2 k`, and `y ≠ 1` rules out `4 ∣ k`;
so `k = 2 m` with `m` odd, say `m = 2 t + 1`.  Then `k = 4 t + 2` and, as `x ^ 4 = 1`,
`x ^ k = x ^ (4 t + 2) = x ^ 2`. -/
theorem eq_sq_of_mem_zpowers_of_orderOf_eq_four {H : Type*} [Group H] [Finite H] {x y : H}
    (hy : y ∈ Subgroup.zpowers x) (hy2 : orderOf y = 2) (hx4 : orderOf x = 4) :
    y = x ^ 2 := by
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hy
  rw [← hk]
  rw [← zpow_ofNat x 2]
  rw [← hk] at hy2
  -- now `x ^ k = x ^ 2` is the goal and `hy2 : orderOf (x ^ k) = 2`.
  have hx4z : x ^ (4 : ℤ) = 1 := by
    rw [zpow_ofNat x 4, ← hx4]
    exact pow_orderOf_eq_one x
  have hsq : x ^ k * x ^ k = 1 := by
    have h := pow_orderOf_eq_one (x ^ k)
    rw [hy2] at h
    simpa [pow_two] using h
  have h2k1 : x ^ (2 * k) = 1 := by rw [two_mul, zpow_add, hsq]
  have h4dvd : (4 : ℤ) ∣ 2 * k := by
    have h := orderOf_dvd_iff_zpow_eq_one.mpr h2k1
    rwa [hx4] at h
  have h2k : (2 : ℤ) ∣ k := by
    obtain ⟨j, hj⟩ := h4dvd
    exact ⟨j, by omega⟩
  have hkne : x ^ k ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hy2
    omega
  have h4ndvd : ¬ ((4 : ℤ) ∣ k) := by
    intro h
    obtain ⟨j, hj⟩ := h
    exact hkne (by rw [hj, zpow_mul, hx4z, one_zpow])
  obtain ⟨m, hm⟩ := h2k
  have hm_odd : m % 2 = 1 := by
    rw [← Int.two_dvd_ne_zero]
    intro h2m
    obtain ⟨s, hs⟩ := h2m
    exact h4ndvd ⟨s, by omega⟩
  have hk_eq : k = 4 * (m / 2) + 2 := by omega
  rw [hk_eq, zpow_add, zpow_mul, hx4z, one_zpow, one_mul]

/-! ## The main theorem -/

theorem sq_eq_z_of_order_four (G : Type*) [Group G] [Finite G] (ctx : Work.A7REC.A7RecCtx G)
    {τ : G} (hτS : τ ∈ (ctx.S : Subgroup G)) (hτ4 : orderOf τ = 4) : τ ^ 2 = ctx.z := by
  -- We work inside the Sylow `2`-subgroup `S`.
  let H := ↥(ctx.S : Subgroup G)
  let ζ : H := ⟨ctx.z, ctx.hzS⟩
  let t : H := ⟨τ, hτS⟩
  have hζcen : ∀ x : H, x * ζ = ζ * x := by
    intro x; exact Subtype.ext (ctx.hzcen (x : G) x.2)
  have hζ2 : orderOf ζ = 2 := by
    change orderOf (⟨ctx.z, ctx.hzS⟩ : H) = 2
    rw [Subgroup.orderOf_mk, ctx.hz2]
  have ht4 : orderOf t = 4 := by
    change orderOf (⟨τ, hτS⟩ : H) = 4
    rw [Subgroup.orderOf_mk, hτ4]
  have hHcard : Nat.card H = 8 := card_S G ctx
  suffices h : ζ = t ^ 2 by
    have hc := congrArg (fun x : H => (x : G)) h
    have h1 : ((t : H) : G) = τ := rfl
    have h2 : ((ζ : H) : G) = ctx.z := rfl
    have h3 : ((t ^ 2 : H) : G) = τ ^ 2 := by rw [Subgroup.coe_pow, h1]
    rw [h2, h3] at hc
    exact hc.symm
  -- `z ∈ ⟨τ⟩`: otherwise the join `⟨z⟩ ⊔ ⟨τ⟩` would be all of `S` and commutative.
  have hzm : ζ ∈ Subgroup.zpowers t := by
    by_contra hznt
    have hZc : Subgroup.zpowers ζ ≤ Subgroup.center H :=
      Subgroup.zpowers_le.mpr (Subgroup.mem_center_iff.mpr hζcen)
    have hZnorm : (Subgroup.zpowers ζ).Normal := Subgroup.normal_of_le_center hZc
    -- `⟨ζ⟩ ⊓ ⟨t⟩ = ⊥`
    have hbot : Subgroup.zpowers ζ ⊓ Subgroup.zpowers t = ⊥ := by
      rw [Subgroup.eq_bot_iff_card]
      have hdvd : Nat.card ↥(Subgroup.zpowers ζ ⊓ Subgroup.zpowers t) ∣ 2 := by
        have h := Subgroup.card_dvd_of_le (α := H)
          (inf_le_left : Subgroup.zpowers ζ ⊓ Subgroup.zpowers t ≤ Subgroup.zpowers ζ)
        rwa [Nat.card_zpowers, hζ2] at h
      rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
      · exact h1
      · exfalso
        have heq : Subgroup.zpowers ζ ⊓ Subgroup.zpowers t = Subgroup.zpowers ζ :=
          Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [Nat.card_zpowers, hζ2, h2])
        exact hznt ((heq ▸ inf_le_right : Subgroup.zpowers ζ ≤ Subgroup.zpowers t)
          (Subgroup.mem_zpowers ζ))
    -- `⟨t⟩ ≤ N(⟨ζ⟩)`, since `⟨ζ⟩` is central and hence normal.
    have hn : Subgroup.zpowers t ≤ Subgroup.normalizer (Subgroup.zpowers ζ : Set H) := by
      rw [Subgroup.le_normalizer_iff]
      intro h hh k hk
      have hkc : h * k = k * h := Subgroup.mem_center_iff.mp (hZc hk) h
      rw [hkc, mul_assoc, mul_inv_cancel, mul_one]
      exact hk
    -- `|⟨ζ⟩ ⊔ ⟨t⟩| = 2 * 4 = 8 = |S|`
    have hcard_join : Nat.card ↥(Subgroup.zpowers ζ ⊔ Subgroup.zpowers t) = 8 := by
      have hd : Disjoint (Subgroup.zpowers ζ) (Subgroup.zpowers t) := disjoint_iff.mpr hbot
      have h := card_sup_mul_card_of_le_normalizer_of_disjoint
        (A := Subgroup.zpowers ζ) (B := Subgroup.zpowers t) hn hd
      rw [h, Nat.card_zpowers ζ, hζ2, Nat.card_zpowers t, ht4]
    have hsup : Subgroup.zpowers ζ ⊔ Subgroup.zpowers t = ⊤ := by
      refine Subgroup.eq_of_le_of_card_ge le_top ?_
      rw [Subgroup.card_top, hcard_join, hHcard]
    -- `⟨t⟩` is cyclic, hence abelian
    have hWab : ∀ a ∈ Subgroup.zpowers t, ∀ b ∈ Subgroup.zpowers t, a * b = b * a := by
      intro a ha b hb
      obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp ha
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hb
      rw [← hm, ← hn]
      exact (Commute.zpow_zpow_self t m n).eq
    have hab := mul_comm_of_le_center_sup hZnorm hZc hWab hsup
    -- but `S ≃ D₈` is not commutative
    obtain ⟨e⟩ := ctx.hSdih
    obtain ⟨x, y, hxy⟩ := exists_not_commute_dihedral_four e
    exact hxy (hab x y)
  exact eq_sq_of_mem_zpowers_of_orderOf_eq_four hzm hζ2 ht4

end Work.A7REC.Basic
