/-
Area A7REC (recognition of `A₇`), file `Basic/four_subgroups_of_S.lean`.

# The four-subgroups of the Sylow `2`-subgroup

Let `G` be a finite group satisfying the `A₇` hypotheses (`A7RecCtx G`).  Its Sylow `2`-subgroup
`S` is dihedral of order `8`, and `V = O₂(C_G(z))` is a four-group contained in `S`
(`V_le_S`).  This file proves that `V` is, up to the index-`2` intersection, the *only*
four-subgroup of `S`:

* either `W = V`, or `W ⊓ V = ⟨z⟩` (with `z` the central involution of `S`),

for every four-subgroup `W ≤ S`.

The mathematical content is the structure of `D₈`: a four-subgroup (`= ` Klein four group) of the
dihedral group of order `8` consists of the central involution together with two reflections, so
the two four-subgroups of `D₈` meet exactly in the centre.  The proof below avoids classifying the
subgroups of `D₈` by hand.  Its key step (`mem_of_isFourGroup_le_dihedral`) is:

* if `W ≤ S` is a four-subgroup not containing `z`, then `⟨z⟩ ⊓ W = 1` and (as `z` is central)
  `⟨z⟩ ⊔ W` is an internal direct product of order `2 · 4 = 8 = |S|`, hence equal to `S`;
  every element of `S = ⟨z⟩ ⊔ W` is then a product of an element of the central subgroup `⟨z⟩`
  and an element of the elementary abelian group `W`, so `S` is commutative — contradicting
  `S ≃ D₈`.

So every four-subgroup of `S` contains `z`, and for two such subgroups `W`, `V` we either have
`W = V` or `W ⊓ V` is a proper subgroup of `W` containing `z`, hence of cardinality `2`, hence
equal to `⟨z⟩`.
-/
import Mathlib
import Submission.Work.A7REC.Defs
import Submission.Work.A7REC.Basic.V_le_S
import Submission.Work.A7REC.Basic.card_centralizer_z

namespace Work.A7REC.Basic

open Subgroup

/-! ## Products of two involutions -/

/-- Two involutions whose product is an involution commute: from `x * x = 1`, `y * y = 1` and
`(x * y) * (x * y) = 1` we get `x * y = y * x` by inverting `x * y`. -/
theorem commute_of_sq_eq_one {H : Type*} [Group H] {x y : H}
    (hx : x * x = 1) (hy : y * y = 1) (hxy : (x * y) * (x * y) = 1) : x * y = y * x := by
  have h1 : (x * y)⁻¹ = x * y := inv_eq_of_mul_eq_one_right hxy
  rw [mul_inv_rev, inv_eq_of_mul_eq_one_right hx, inv_eq_of_mul_eq_one_right hy] at h1
  exact h1.symm

/-! ## The abstract commutativity statement -/

/-- **A group generated by a central involution and an elementary abelian subgroup is
commutative.**

Let `Z = ⟨z⟩` be the cyclic subgroup generated by a central element `z` and let `W` be a
subgroup all of whose elements are involutions (`w * w = 1`).  If `Z ⊔ W = ⊤`, then `H` is
commutative: `Z` is normal (it lies in the centre), so by `Subgroup.mem_sup_of_normal_left`
every element of `H` is a product `a * b` with `a ∈ Z` and `b ∈ W`, and such products commute
because `a` is central and `W` is abelian (being of exponent `2`, by `commute_of_sq_eq_one`). -/
theorem mul_comm_of_center_zpowers_sup {H : Type*} [Group H] {z : H} {W : Subgroup H}
    (hz : z ∈ Subgroup.center H) (hW2 : ∀ w ∈ W, w * w = 1)
    (hsup : Subgroup.zpowers z ⊔ W = ⊤) : ∀ x y : H, x * y = y * x := by
  have hZnorm : (Subgroup.zpowers z).Normal := ⟨fun n hn g => by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
    have hgz : g * z * g⁻¹ = z := by
      rw [Subgroup.mem_center_iff.mp hz g, mul_assoc, mul_inv_cancel, mul_one]
    have hconj : g * z ^ k * g⁻¹ = (g * z * g⁻¹) ^ k := by
      rw [← MulAut.conj_apply, map_zpow, MulAut.conj_apply]
    rw [hconj, hgz]
    exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers z) k⟩
  intro x y
  have hx : x ∈ Subgroup.zpowers z ⊔ W := by rw [hsup]; exact trivial
  have hy : y ∈ Subgroup.zpowers z ⊔ W := by rw [hsup]; exact trivial
  obtain ⟨a, ha, b, hb, rfl⟩ :=
    (@Subgroup.mem_sup_of_normal_left H _ (Subgroup.zpowers z) W hZnorm x).mp hx
  obtain ⟨c, hc, d, hd, rfl⟩ :=
    (@Subgroup.mem_sup_of_normal_left H _ (Subgroup.zpowers z) W hZnorm y).mp hy
  have ha_c : ∀ t : H, t * a = a * t :=
    Subgroup.mem_center_iff.mp (Subgroup.zpowers_le.mpr hz ha)
  have hc_c : ∀ t : H, t * c = c * t :=
    Subgroup.mem_center_iff.mp (Subgroup.zpowers_le.mpr hz hc)
  have hac : Commute a c := (commute_iff_eq a c).mpr (ha_c c).symm
  have had : Commute a d := (commute_iff_eq a d).mpr (ha_c d).symm
  have hbc : Commute b c := (commute_iff_eq b c).mpr (hc_c b)
  have hbd : Commute b d := (commute_iff_eq b d).mpr
    (commute_of_sq_eq_one (hW2 b hb) (hW2 d hd) (hW2 (b * d) (W.mul_mem hb hd)))
  have h1 : Commute (a * b) c := Commute.mul_left hac hbc
  have h2 : Commute (a * b) d := Commute.mul_left had hbd
  exact (h1.mul_right h2).eq

/-! ## The dihedral group of order `8` is not commutative -/

/-- The dihedral group of order `8` is not commutative: the rotation `r 1` and the reflection
`sr 0` do not commute (`r 1 * sr 0 = sr 3 ≠ sr 1 = sr 0 * r 1`, as `3 ≠ 1` in `ZMod 4`). -/
theorem exists_not_commute_dihedral_four {H : Type*} [Group H] (e : H ≃* DihedralGroup 4) :
    ∃ x y : H, x * y ≠ y * x := by
  refine ⟨e.symm (DihedralGroup.r 1), e.symm (DihedralGroup.sr 0), fun h => ?_⟩
  have h' : DihedralGroup.r (1 : ZMod 4) * DihedralGroup.sr 0
      = DihedralGroup.sr 0 * DihedralGroup.r (1 : ZMod 4) := by
    have := congrArg (fun t : H => e t) h
    simpa using this
  exact absurd h' (by decide)

/-! ## `z` lies in every four-subgroup of `S` -/

/-- The subgroup generated by `z`, intersected with `H ≤ G`, is the subgroup generated by `z`
inside `H`. -/
theorem zpowers_subgroupOf {G : Type*} [Group G] {H : Subgroup G} {z : G} (hz : z ∈ H) :
    (Subgroup.zpowers z).subgroupOf H = Subgroup.zpowers (⟨z, hz⟩ : H) := by
  ext x
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, Subtype.ext hk⟩
  · rintro ⟨k, hk⟩
    exact ⟨k, by simpa using congrArg Subtype.val hk⟩

/-- **The central involution lies in every four-subgroup of a dihedral Sylow `2`-subgroup.**

Let `S` be a subgroup of `G` isomorphic to the dihedral group of order `8`, let `z ∈ S` be a
central element of order `2` of `S`, and let `W ≤ S` be a four-group.  Then `z ∈ W`.

Assume otherwise.  Then `⟨z⟩` and `W` meet trivially (as `|⟨z⟩| = 2` and `z ∉ W`), and `⟨z⟩`
centralizes `W ≤ S`; the join-cardinality lemma for a normalizing, disjoint pair therefore gives
`|⟨z⟩ ⊔ W| = 2 · 4 = 8 = |S|`, so `⟨z⟩ ⊔ W = S`.  Passing to the group `↥S` and applying
`mul_comm_of_center_zpowers_sup` shows that `S` is commutative, contradicting `S ≃ D₈`. -/
theorem mem_of_isFourGroup_le_dihedral {G : Type*} [Group G] [Finite G]
    {S : Subgroup G} (hSdih : Nonempty (↥S ≃* DihedralGroup 4))
    {z : G} (hzS : z ∈ S) (hz2 : orderOf z = 2) (hzcen : ∀ x ∈ S, x * z = z * x)
    {W : Subgroup G} (hW : W ≤ S) (hW4 : Nat.card W = 4) (hWsq : ∀ w ∈ W, w ^ 2 = 1) :
    z ∈ W := by
  by_contra hzW
  have hS8 : Nat.card ↥S = 8 := by
    obtain ⟨e⟩ := hSdih
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hZcard : Nat.card ↥(Subgroup.zpowers z) = 2 := by rw [Nat.card_zpowers, hz2]
  have hZ_le_S : Subgroup.zpowers z ≤ S := Subgroup.zpowers_le.mpr hzS
  -- `⟨z⟩ ⊓ W = ⊥`
  have hZW_bot : Subgroup.zpowers z ⊓ W = ⊥ := by
    have hdvd : Nat.card ↥(Subgroup.zpowers z ⊓ W) ∣ 2 := by
      have := Subgroup.card_dvd_of_le (α := G)
        (inf_le_left : Subgroup.zpowers z ⊓ W ≤ Subgroup.zpowers z)
      rwa [hZcard] at this
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
    · exact Subgroup.card_eq_one.mp h1
    · exfalso
      have hZW_eq : Subgroup.zpowers z ⊓ W = Subgroup.zpowers z :=
        Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [h2, hZcard])
      exact hzW ((hZW_eq ▸ inf_le_right : Subgroup.zpowers z ≤ W) (Subgroup.mem_zpowers z))
  -- `⟨z⟩` centralizes `W`, hence normalizes it
  have hZN : Subgroup.zpowers z ≤ Subgroup.normalizer (W : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro h hh k hk
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
    have hck : Commute z k := (commute_iff_eq z k).mpr (hzcen k (hW hk)).symm
    rw [(hck.zpow_left m).eq, mul_assoc, mul_inv_cancel, mul_one]
    exact hk
  -- hence `|⟨z⟩ ⊔ W| = 2 * 4 = 8 = |S|`, so `⟨z⟩ ⊔ W = S`
  have hcard_sup : Nat.card ↥(Subgroup.zpowers z ⊔ W) = 8 := by
    have hdisj : Disjoint W (Subgroup.zpowers z) :=
      disjoint_iff.mpr (by rw [inf_comm, hZW_bot])
    have h := card_sup_mul_card_of_le_normalizer_of_disjoint (A := W)
      (B := Subgroup.zpowers z) hZN hdisj
    rw [sup_comm] at h
    rw [h, hW4, hZcard]
  have hZW_eq_S : Subgroup.zpowers z ⊔ W = S := by
    refine Subgroup.eq_of_le_of_card_ge (sup_le hZ_le_S hW) ?_
    rw [hcard_sup, hS8]
  -- transfer to `↥S` and conclude that `S` is commutative
  have hsup' : Subgroup.zpowers (⟨z, hzS⟩ : ↥S) ⊔ W.subgroupOf S = ⊤ := by
    rw [← zpowers_subgroupOf hzS, ← Subgroup.subgroupOf_sup hZ_le_S hW, hZW_eq_S,
      Subgroup.subgroupOf_self]
  have hzcenter : (⟨z, hzS⟩ : ↥S) ∈ Subgroup.center ↥S := by
    rw [Subgroup.mem_center_iff]
    intro x
    exact Subtype.ext (hzcen x x.2)
  have hW2' : ∀ w ∈ W.subgroupOf S, w * w = 1 := by
    intro w hw
    apply Subtype.ext
    simpa [pow_two] using hWsq (w : G) hw
  obtain ⟨e⟩ := hSdih
  obtain ⟨x, y, hxy⟩ := exists_not_commute_dihedral_four e
  exact hxy (mul_comm_of_center_zpowers_sup hzcenter hW2' hsup' x y)

/-! ## The main theorem -/

/-- **The four-subgroups of the Sylow `2`-subgroup.**  Every four-subgroup `W` of the Sylow
`2`-subgroup `S` is either `V = O₂(C_G(z))` itself, or meets it exactly in the centre `⟨z⟩`. -/
theorem four_subgroups_of_S (G : Type*) [Group G] [Finite G] (ctx : Work.A7REC.A7RecCtx G)
    (W : Subgroup G) (hW : W ≤ (ctx.S : Subgroup G)) (h4 : Work.A7REC.IsFourGroup W) :
    W = ctx.V ∨ W ⊓ ctx.V = Subgroup.zpowers ctx.z := by
  -- both `V` and `W` are four-subgroups of `S`, so both contain `z`
  have hzV : ctx.z ∈ ctx.V :=
    mem_of_isFourGroup_le_dihedral (S := (ctx.S : Subgroup G)) ctx.hSdih ctx.hzS ctx.hz2
      ctx.hzcen (V_le_S G ctx) ctx.hV4.1 ctx.hV4.2
  have hzW : ctx.z ∈ W :=
    mem_of_isFourGroup_le_dihedral (S := (ctx.S : Subgroup G)) ctx.hSdih ctx.hzS ctx.hz2
      ctx.hzcen hW h4.1 h4.2
  rcases eq_or_ne W ctx.V with h | h
  · exact Or.inl h
  · refine Or.inr ?_
    have hle : Subgroup.zpowers ctx.z ≤ W ⊓ ctx.V := Subgroup.zpowers_le.mpr ⟨hzW, hzV⟩
    have hcardZ : Nat.card ↥(Subgroup.zpowers ctx.z) = 2 := by rw [Nat.card_zpowers, ctx.hz2]
    -- `|W ⊓ V|` divides `|V| = 4`
    have hdvd : Nat.card ↥(W ⊓ ctx.V) ∣ 4 := by
      have := Subgroup.card_dvd_of_le (α := G) (inf_le_right : W ⊓ ctx.V ≤ ctx.V)
      rwa [ctx.hV4.1] at this
    -- ... and is at least `|⟨z⟩| = 2`
    have hge : 2 ≤ Nat.card ↥(W ⊓ ctx.V) := by
      have h := Subgroup.card_le_of_le hle
      rwa [hcardZ] at h
    have hle4 : Nat.card ↥(W ⊓ ctx.V) ≤ 4 := Nat.le_of_dvd (by norm_num) hdvd
    -- ... and is not `4`, since that would force `W = V`
    have hne4 : Nat.card ↥(W ⊓ ctx.V) ≠ 4 := by
      intro hc
      have h_eq : W ⊓ ctx.V = W :=
        Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [hc, h4.1])
      refine h (Subgroup.eq_of_le_of_card_ge (h_eq ▸ inf_le_right : W ≤ ctx.V) ?_)
      rw [h4.1, ctx.hV4.1]
    have hcard2 : Nat.card ↥(W ⊓ ctx.V) = 2 := by
      set n := Nat.card ↥(W ⊓ ctx.V) with hn
      interval_cases n
      · rfl
      · norm_num at hdvd
      · exact absurd rfl hne4
    exact (Subgroup.eq_of_le_of_card_ge hle (by rw [hcard2, hcardZ])).symm

end Work.A7REC.Basic
