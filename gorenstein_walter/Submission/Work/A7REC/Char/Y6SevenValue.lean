import Mathlib
import Submission.Work.A7REC.Char.Y6Defs
import Submission.Work.A7REC.Char.Y6ZetaSeven

namespace Work.A7REC.Char

open Finset

/-! ## Auxiliary lemmas

We prove the value of the degree-`6` character at an element of order `7` from the linear algebra
of the operator `A = ρ x` alone.  Since `A ^ 7 = 1`, `A` is diagonalisable with eigenvalues the
`7`-th roots of unity; the eigenvalues' multiplicities `n k` are the traces (ranks) of the spectral
projections `E k`, and are therefore natural numbers.  The hypothesis `trace A = trace (A ^ 3)`
becomes `∑ k, n k * ζ ^ (3 * k) = ∑ k, n k * ζ ^ k`, which by the standard relation between the
`7`-th roots of unity forces `n` to be constant on the nonzero residues, hence `trace A = 6` or
`-1`. -/

/-- Shifting the index of a sum over `range 7` by one, when the summand is periodic with period
`7` (`g 7 = g 0`). -/
lemma sum_range_shift {M : Type*} [AddCommMonoid M] (g : ℕ → M) (h : g 7 = g 0) :
    ∑ j ∈ Finset.range 7, g (j+1) = ∑ j ∈ Finset.range 7, g j := by
  rw [Finset.sum_range_succ (fun j => g (j+1)) 6, Finset.sum_range_succ' g 6, h]

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- Averaging over the cyclic group generated by an order-`7` endomorphism is fixed on the
left by that endomorphism. -/
lemma avg_mul (B : Module.End ℂ V) (hB : B^7 = 1) :
    B * (∑ j ∈ Finset.range 7, B^j) = ∑ j ∈ Finset.range 7, B^j := by
  rw [Finset.mul_sum]
  have h1 : ∑ j ∈ Finset.range 7, B * B ^ j = ∑ j ∈ Finset.range 7, B ^ (j+1) := by
    apply Finset.sum_congr rfl; intro j _; exact (pow_succ' B j).symm
  rw [h1, sum_range_shift (fun j => B^j) (by rw [hB, pow_zero])]

/-- Averaging over the cyclic group generated by an order-`7` endomorphism is fixed on the
right by that endomorphism. -/
lemma avg_mul' (B : Module.End ℂ V) (hB : B^7 = 1) :
    (∑ j ∈ Finset.range 7, B^j) * B = ∑ j ∈ Finset.range 7, B^j := by
  rw [Finset.sum_mul]
  have h1 : ∑ j ∈ Finset.range 7, B ^ j * B = ∑ j ∈ Finset.range 7, B ^ (j+1) := by
    apply Finset.sum_congr rfl; intro j _; exact (pow_succ B j).symm
  rw [h1, sum_range_shift (fun j => B^j) (by rw [hB, pow_zero])]

/-- The average `7⁻¹ ∑_{j<7} B^j` of an order-`7` endomorphism is idempotent. -/
lemma avg_sq (B : Module.End ℂ V) (hB : B^7 = 1) :
    (∑ j ∈ Finset.range 7, B^j) * (∑ j ∈ Finset.range 7, B^j)
      = (7 : ℂ) • (∑ j ∈ Finset.range 7, B^j) := by
  have hSB := avg_mul' B hB
  have hpow : ∀ j, (∑ j ∈ Finset.range 7, B^j) * B^j = ∑ j ∈ Finset.range 7, B^j := by
    intro j; induction j with
    | zero => rw [pow_zero, mul_one]
    | succ k ih => rw [pow_succ, ← mul_assoc, ih, hSB]
  rw [Finset.mul_sum]
  rw [Finset.sum_congr rfl (fun j _ => hpow j), Finset.sum_const, Finset.card_range]
  exact (Nat.cast_smul_eq_nsmul (R := ℂ) 7 (∑ j ∈ Finset.range 7, B^j)).symm

/-- Multiplication by `5` on the residues modulo `7`. -/
def φ5 : Fin 7 → Fin 7 := fun j => ⟨(5 * j.val) % 7, Nat.mod_lt _ (by norm_num)⟩

/-- Multiplication by `3` on the residues modulo `7`, the inverse of `φ5`. -/
def φ3 : Fin 7 → Fin 7 := fun j => ⟨(3 * j.val) % 7, Nat.mod_lt _ (by norm_num)⟩

/-- The permutation of `Fin 7` given by multiplication by `5`. -/
def equiv5 : Fin 7 ≃ Fin 7 where
  toFun := φ5
  invFun := φ3
  left_inv j := by decide +revert
  right_inv j := by decide +revert

/-- Sum of the `j`-th powers of a primitive `7`-th root of unity over all exponents `k ∈ Fin 7`:
`7` if `j = 0` and `0` otherwise (`j` taken in `range 7`). -/
lemma char_sum (Z : ℂ) (hZ : IsPrimitiveRoot Z 7) (j : ℕ) (hj : j < 7) :
    ∑ k : Fin 7, Z ^ (k.val * j) = if j = 0 then 7 else 0 := by
  rw [Fin.sum_univ_eq_sum_range (fun k => Z ^ (k * j)) 7]
  by_cases h0 : j = 0
  · subst h0; simp
  · rw [if_neg h0]
    have hcop : j.Coprime 7 := by
      rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd Nat.prime_seven]
      intro hd
      exact absurd (Nat.le_of_dvd (Nat.pos_of_ne_zero h0) hd) (by omega)
    have hp : IsPrimitiveRoot (Z ^ j) 7 := (hZ.pow_iff_coprime (by norm_num) j).2 hcop
    have : ∑ k ∈ Finset.range 7, Z ^ (k * j) = ∑ k ∈ Finset.range 7, (Z ^ j) ^ k := by
      apply Finset.sum_congr rfl; intro k _; rw [mul_comm, pow_mul]
    rw [this, hp.geom_sum_eq_zero (by norm_num)]

/-- Reindexing the sum `∑ k, f k * ζ ^ (3 * k)` using that multiplication by `3` permutes the
residues modulo `7`. -/
lemma reindex_three (ζ : ℂ) (hζ : ζ ^ 7 = 1) (f : Fin 7 → ℂ) :
    ∑ k : Fin 7, f k * ζ ^ (3 * k.val) = ∑ j : Fin 7, f (φ5 j) * ζ ^ j.val := by
  rw [← equiv5.sum_comp (fun k => f k * ζ ^ (3 * k.val))]
  apply Finset.sum_congr rfl
  intro j _
  congr 1
  rw [pow_eq_pow_mod _ hζ, show (3 * (equiv5 j).val) % 7 = j.val from by decide +revert]

/-- The "twisted" endomorphism `ζ⁻¹ ^ k • A` whose averaging operator is the spectral projection
onto the `ζ ^ k`-eigenspace of `A`. -/
noncomputable def y6B (ζ : ℂ) (A : Module.End ℂ V) (k : Fin 7) : Module.End ℂ V :=
  (ζ⁻¹ ^ k.val) • A

/-- The averaging operator `∑_{j<7} (ζ⁻¹ ^ k • A)^j`. -/
noncomputable def y6S (ζ : ℂ) (A : Module.End ℂ V) (k : Fin 7) : Module.End ℂ V :=
  ∑ j ∈ Finset.range 7, (y6B ζ A k)^j

/-- The spectral projection of `A` onto the `ζ ^ k`-eigenspace. -/
noncomputable def y6E (ζ : ℂ) (A : Module.End ℂ V) (k : Fin 7) : Module.End ℂ V :=
  (7 : ℂ)⁻¹ • y6S ζ A k

lemma y6B_pow (ζ : ℂ) (A : Module.End ℂ V) (hA : A^7 = 1) (hζ : ζ^7 = 1) (k : Fin 7) :
    (y6B ζ A k)^7 = 1 := by
  rw [y6B, smul_pow, hA]
  rw [show (ζ⁻¹ ^ k.val)^7 = 1 from by
    rw [← pow_mul, mul_comm, pow_mul, inv_pow, hζ, inv_one, one_pow], one_smul]

lemma y6E_idem (ζ : ℂ) (A : Module.End ℂ V) (hA : A^7 = 1) (hζ : ζ^7 = 1) (k : Fin 7) :
    y6E ζ A k * y6E ζ A k = y6E ζ A k := by
  have hB := y6B_pow ζ A hA hζ k
  have hSS : y6S ζ A k * y6S ζ A k = (7 : ℂ) • y6S ζ A k := avg_sq (y6B ζ A k) hB
  calc y6E ζ A k * y6E ζ A k
      = ((7 : ℂ)⁻¹ * (7 : ℂ)⁻¹) • (y6S ζ A k * y6S ζ A k) := by
        rw [y6E, smul_mul_smul_comm]
    _ = ((7 : ℂ)⁻¹ * (7 : ℂ)⁻¹) • ((7 : ℂ) • y6S ζ A k) := by rw [hSS]
    _ = ((7 : ℂ)⁻¹ * (7 : ℂ)⁻¹ * 7) • y6S ζ A k := by rw [smul_smul]
    _ = (7 : ℂ)⁻¹ • y6S ζ A k := by
        rw [show (7 : ℂ)⁻¹ * (7 : ℂ)⁻¹ * 7 = (7 : ℂ)⁻¹ from by norm_num]
    _ = y6E ζ A k := by rw [y6E]

lemma y6B_mul_E (ζ : ℂ) (A : Module.End ℂ V) (hA : A^7 = 1) (hζ : ζ^7 = 1) (k : Fin 7) :
    y6B ζ A k * y6E ζ A k = y6E ζ A k := by
  have hB := y6B_pow ζ A hA hζ k
  simp only [y6E]
  rw [mul_smul_comm, y6S, avg_mul (y6B ζ A k) hB]

lemma y6A_eq (ζ : ℂ) (A : Module.End ℂ V) (hζ : IsPrimitiveRoot ζ 7) (k : Fin 7) :
    A = (ζ ^ k.val) • y6B ζ A k := by
  rw [y6B, smul_smul, show ζ ^ k.val * ζ⁻¹ ^ k.val = 1 from by
    rw [← mul_pow, mul_inv_cancel₀ (hζ.ne_zero (by norm_num)), one_pow], one_smul]

lemma y6A_E (ζ : ℂ) (A : Module.End ℂ V) (hA : A^7 = 1) (hζ : IsPrimitiveRoot ζ 7) (k : Fin 7) :
    A * y6E ζ A k = (ζ ^ k.val) • y6E ζ A k := by
  nth_rewrite 1 [y6A_eq ζ A hζ k]
  rw [smul_mul_assoc, y6B_mul_E ζ A hA hζ.pow_eq_one k]

lemma y6A3_E (ζ : ℂ) (A : Module.End ℂ V) (hA : A^7 = 1) (hζ : IsPrimitiveRoot ζ 7) (k : Fin 7) :
    A^3 * y6E ζ A k = (ζ ^ (3 * k.val)) • y6E ζ A k := by
  have hBE := y6B_mul_E ζ A hA hζ.pow_eq_one k
  have hBn : ∀ n : ℕ, (y6B ζ A k)^(n+1) * y6E ζ A k = y6E ζ A k := by
    intro n; induction n with
    | zero => rw [pow_one]; exact hBE
    | succ m ih => rw [pow_succ, mul_assoc, hBE]; exact ih
  nth_rewrite 1 [y6A_eq ζ A hζ k]
  rw [smul_pow, smul_mul_assoc, hBn 2,
    show (ζ ^ k.val)^3 = ζ ^ (3 * k.val) from by rw [← pow_mul, mul_comm]]

lemma y6E_sum (ζ : ℂ) (A : Module.End ℂ V) (hA : A^7 = 1) (hζ : IsPrimitiveRoot ζ 7) :
    ∑ k : Fin 7, y6E ζ A k = 1 := by
  have key : ∑ k : Fin 7, y6E ζ A k
      = (7 : ℂ)⁻¹ • (∑ j ∈ Finset.range 7, ((if j = 0 then (7 : ℂ) else 0)) • A^j) := by
    simp only [y6E, y6S, y6B]
    rw [← Finset.smul_sum]
    congr 1
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j hj
    have h1 : ∑ k : Fin 7, ((ζ⁻¹ ^ k.val) • A)^j = ∑ k : Fin 7, ((ζ⁻¹) ^ (k.val * j)) • A^j := by
      apply Finset.sum_congr rfl; intro k _
      rw [smul_pow, ← pow_mul]
    rw [h1, ← Finset.sum_smul, char_sum ζ⁻¹ hζ.inv j (Finset.mem_range.mp hj)]
  have h7 : ∑ j ∈ Finset.range 7, ((if j = 0 then (7 : ℂ) else 0)) • A^j = (7 : ℂ) • 1 := by
    have h := Finset.sum_eq_single (0 : ℕ) (s := Finset.range 7)
      (f := fun j => ((if j = 0 then (7 : ℂ) else 0)) • A^j) ?_ ?_
    · rw [h]; simp
    · intro j _ hne; rw [if_neg hne, zero_smul]
    · intro h0; exact absurd (Finset.mem_range.mpr (by norm_num)) h0
  rw [key, h7, smul_smul,
    show (7 : ℂ)⁻¹ * 7 = 1 from by norm_num, one_smul]

theorem Y6SevenValue : Work.A7REC.A7Y6SevenValueProp := by
  intro G _ V _ _ _ hfr ρ x hx ht
  set A : Module.End ℂ V := ρ x with hAdef
  have hx7 : x ^ 7 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
  have hA7 : A ^ 7 = 1 := by rw [hAdef, ← map_pow, hx7, map_one]
  have htr : LinearMap.trace ℂ V (A ^ 3) = LinearMap.trace ℂ V A := by
    rw [hAdef, ← map_pow]; exact ht
  let ζ : ℂ := Complex.exp (2 * ↑Real.pi * Complex.I / 7)
  have hζ : IsPrimitiveRoot ζ 7 := Complex.isPrimitiveRoot_exp 7 (by norm_num)
  have hζ7 : ζ ^ 7 = 1 := hζ.pow_eq_one
  have hidem : ∀ k : Fin 7, IsIdempotentElem (y6E ζ A k) := fun k => y6E_idem ζ A hA7 hζ7 k
  set n : Fin 7 → ℕ := fun k => Module.finrank ℂ ↥(LinearMap.range (y6E ζ A k)) with hn
  have htrE : ∀ k : Fin 7, (LinearMap.trace ℂ V) (y6E ζ A k) = (n k : ℂ) := by
    intro k
    have hproj : LinearMap.IsProj (LinearMap.range (y6E ζ A k)) (y6E ζ A k) :=
      (LinearMap.isProj_range_iff_isIdempotentElem (y6E ζ A k)).mpr (hidem k)
    simpa only [hn] using hproj.trace
  have hsumE : ∑ k : Fin 7, y6E ζ A k = 1 := y6E_sum ζ A hA7 hζ
  have htrace1 : (LinearMap.trace ℂ V) (1 : Module.End ℂ V) = 6 := by
    rw [LinearMap.trace_one, hfr]; norm_num
  have h1 : ∑ k : Fin 7, (n k : ℂ) = 6 := by
    have h2 : (LinearMap.trace ℂ V) (∑ k : Fin 7, y6E ζ A k) = ∑ k : Fin 7, (n k : ℂ) := by
      rw [map_sum]
      exact Finset.sum_congr rfl (fun k _ => htrE k)
    rw [hsumE, htrace1] at h2
    exact h2.symm
  have hsumn : ∑ k : Fin 7, n k = 6 := by
    have h1' : ((∑ k : Fin 7, n k : ℕ) : ℂ) = 6 := by push_cast; exact h1
    exact_mod_cast h1'
  have hAdecomp : A = ∑ k : Fin 7, (ζ ^ k.val) • y6E ζ A k := by
    have h : A * (∑ k : Fin 7, y6E ζ A k) = ∑ k : Fin 7, (ζ ^ k.val) • y6E ζ A k := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun k _ => y6A_E ζ A hA7 hζ k)
    rw [hsumE, mul_one] at h
    exact h
  have htA : (LinearMap.trace ℂ V) A = ∑ k : Fin 7, (n k : ℂ) * ζ ^ k.val := by
    rw [hAdecomp, map_sum]
    apply Finset.sum_congr rfl
    intro k _
    rw [map_smul, htrE k, smul_eq_mul]
    ring
  have hA3decomp : A ^ 3 = ∑ k : Fin 7, (ζ ^ (3 * k.val)) • y6E ζ A k := by
    have h : A ^ 3 * (∑ k : Fin 7, y6E ζ A k) = ∑ k : Fin 7, (ζ ^ (3 * k.val)) • y6E ζ A k := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun k _ => y6A3_E ζ A hA7 hζ k)
    rw [hsumE, mul_one] at h
    exact h
  have htA3 : (LinearMap.trace ℂ V) (A ^ 3) = ∑ k : Fin 7, (n k : ℂ) * ζ ^ (3 * k.val) := by
    rw [hA3decomp, map_sum]
    apply Finset.sum_congr rfl
    intro k _
    rw [map_smul, htrE k, smul_eq_mul]
    ring
  have heq : ∑ k : Fin 7, (n k : ℂ) * ζ ^ (3 * k.val) = ∑ k : Fin 7, (n k : ℂ) * ζ ^ k.val := by
    rw [← htA3, ← htA]; exact htr
  have heq2 : ∑ j : Fin 7, (n (φ5 j) : ℂ) * ζ ^ j.val = ∑ j : Fin 7, (n j : ℂ) * ζ ^ j.val := by
    rw [← reindex_three ζ hζ7 (fun k => (n k : ℂ))]; exact heq
  have hrel : ∑ j : Fin 7, ((((n (φ5 j) : ℤ) - (n j : ℤ) : ℚ)) : ℂ) * ζ ^ j.val = 0 := by
    have h := sub_eq_zero.mpr heq2
    rw [← Finset.sum_sub_distrib] at h
    have hterm : ∀ j : Fin 7, ((((n (φ5 j) : ℤ) - (n j : ℤ) : ℚ)) : ℂ) * ζ ^ j.val
        = (n (φ5 j) : ℂ) * ζ ^ j.val - (n j : ℂ) * ζ ^ j.val := by
      intro j; push_cast; ring
    rw [Finset.sum_congr rfl (fun j _ => hterm j)]
    exact h
  have hα : ∀ i j : Fin 7, ((((n (φ5 i) : ℤ) - (n i : ℤ) : ℚ)))
      = ((((n (φ5 j) : ℤ) - (n j : ℤ) : ℚ))) :=
    (IsPrimitiveRoot.sum_eq_zero_iff_forall_eq Nat.prime_seven hζ
      (fun i : Fin 7 => (((n (φ5 i) : ℤ) - (n i : ℤ) : ℚ)))).1 hrel
  have hdiff : ∀ i : Fin 7, n (φ5 i) = n i := by
    intro i
    have h0 : ((((n (φ5 0) : ℤ) - (n 0 : ℤ) : ℚ))) = 0 := by
      have hφ : φ5 0 = 0 := by decide
      rw [hφ]; simp
    have h2 : ((((n (φ5 i) : ℤ) - (n i : ℤ) : ℚ))) = 0 := by rw [hα i 0, h0]
    have h3 : (n (φ5 i) : ℤ) - (n i : ℤ) = 0 := by exact_mod_cast h2
    omega
  have hconst : ∀ j : Fin 7, j ≠ 0 → n j = n 1 := by
    have key : ∀ m : ℕ, n ((φ5^[m]) 1) = n 1 := by
      intro m; induction m with
      | zero => rfl
      | succ k ih => rw [Function.iterate_succ_apply']; exact (hdiff ((φ5^[k]) 1)).trans ih
    intro j _
    have hex : ∃ m : Fin 7, (φ5^[m.val]) 1 = j := by decide +revert
    obtain ⟨m, hm⟩ := hex
    rw [← hm]; exact key m.val
  have hpt : ∀ k : Fin 7, n k = if k = 0 then n 0 else n 1 := by
    intro k; by_cases hk : k = 0
    · subst hk; simp
    · rw [if_neg hk]; exact hconst k hk
  have hgeom : ∑ k : Fin 7, ζ ^ k.val = 0 := by
    rw [Fin.sum_univ_eq_sum_range (fun k => ζ ^ k)]
    exact hζ.geom_sum_eq_zero (by norm_num)
  have hgeom' : ∑ k ∈ Finset.univ.erase (0 : Fin 7), ζ ^ k.val = -1 := by
    have h := Finset.sum_erase_add Finset.univ (fun k : Fin 7 => ζ ^ k.val)
      (Finset.mem_univ (0 : Fin 7))
    simp only [Fin.val_zero, pow_zero] at h
    rw [hgeom] at h
    linear_combination h
  have hsplit : ∑ k : Fin 7, n k = n 0 + 6 * n 1 := by
    rw [Finset.sum_congr rfl (fun k _ => hpt k)]
    rw [← Finset.sum_erase_add _ _ (Finset.mem_univ (0 : Fin 7)),
      show (if (0 : Fin 7) = 0 then n 0 else n 1) = n 0 from by simp]
    have hrest : ∀ k ∈ Finset.univ.erase (0 : Fin 7), (if k = 0 then n 0 else n 1) = n 1 := by
      intro k hk; rw [if_neg (Finset.mem_erase.mp hk).1]
    rw [Finset.sum_const_nat hrest]
    rw [Finset.card_erase_of_mem (Finset.mem_univ (0 : Fin 7)), Finset.card_univ, Fintype.card_fin]
    omega
  have htrval : (LinearMap.trace ℂ V) A = (n 0 : ℂ) - (n 1 : ℂ) := by
    rw [htA]
    rw [Finset.sum_congr rfl (fun k _ =>
      show (n k : ℂ) * ζ ^ k.val = (if k = 0 then (n 0 : ℂ) else (n 1 : ℂ)) * ζ ^ k.val from by
        by_cases hk : k = 0
        · rw [hk]; simp
        · rw [hpt k, if_neg hk, if_neg hk])]
    rw [← Finset.sum_erase_add _ _ (Finset.mem_univ (0 : Fin 7)),
      show (if (0 : Fin 7) = 0 then (n 0 : ℂ) else (n 1 : ℂ)) * ζ ^ (0 : Fin 7).val = (n 0 : ℂ)
        from by simp]
    have hrest : ∀ k ∈ Finset.univ.erase (0 : Fin 7),
        (if k = 0 then (n 0 : ℂ) else (n 1 : ℂ)) * ζ ^ k.val = (n 1 : ℂ) * ζ ^ k.val := by
      intro k hk; rw [if_neg (Finset.mem_erase.mp hk).1]
    rw [Finset.sum_congr rfl hrest, ← Finset.mul_sum, hgeom']
    ring
  have hs : n 0 + 6 * n 1 = 6 := by rw [← hsplit]; exact hsumn
  have hn1 : n 1 = 0 ∨ n 1 = 1 := by omega
  rcases hn1 with h1 | h1
  · right
    have hn0 : n 0 = 6 := by omega
    rw [htrval, h1, hn0]; norm_num
  · left
    have hn0 : n 0 = 0 := by omega
    rw [htrval, h1, hn0]; norm_num

end Work.A7REC.Char
