/-! ## 1. Elementary subgroup facts -/

/-- A non-identity element of a subgroup of order `3` has order `3`. -/
lemma orderOf_eq_three_of_mem_card_three {G : Type} [Group G] [Finite G] {U : Subgroup G}
    (hU : Nat.card U = 3) {σ : G} (hσ : σ ∈ U) (h1 : σ ≠ 1) : orderOf σ = 3 := by
  haveI : Fintype U := Fintype.ofFinite U
  have hdvd : orderOf σ ∣ 3 := by
    have h := orderOf_dvd_card (x := (⟨σ, hσ⟩ : U))
    rw [Subgroup.orderOf_mk, ← Nat.card_eq_fintype_card, hU] at h
    exact h
  have hne1 : orderOf σ ≠ 1 := fun h => h1 (orderOf_eq_one_iff.mp h)
  obtain h | h := (Nat.dvd_prime Nat.prime_three).mp hdvd
  · exact absurd h hne1
  · exact h

/-- A subgroup of order `3` is generated by each of its non-identity elements. -/
lemma zpowers_eq_of_mem_card_three {G : Type} [Group G] [Finite G] {U : Subgroup G}
    (hU : Nat.card U = 3) {σ : G} (hσ : σ ∈ U) (h1 : σ ≠ 1) : U = Subgroup.zpowers σ := by
  have hcard : Nat.card U = Nat.card (Subgroup.zpowers σ) := by
    rw [Nat.card_zpowers, orderOf_eq_three_of_mem_card_three hU hσ h1, hU]
  exact (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hσ) (le_of_eq hcard)).symm

/-- The elements of a subgroup `U` of order `3` generated by `σ` are `1`, `σ`, `σ ^ 2`. -/
lemma mem_eq_three_of_card_three {G : Type} [Group G] [Finite G] {U : Subgroup G} {σ : G}
    (hU : Nat.card U = 3) (hσ : σ ∈ U) (h1 : σ ≠ 1) (hσ3 : orderOf σ = 3) :
    ∀ x ∈ U, x = 1 ∨ x = σ ∨ x = σ ^ 2 := by
  have hUeq : U = Subgroup.zpowers σ := zpowers_eq_of_mem_card_three hU hσ h1
  have hσ3' : σ ^ (3 : ℕ) = 1 := by
    have h := pow_orderOf_eq_one σ
    rwa [hσ3] at h
  have h3z : σ ^ (3 : ℤ) = 1 := by simpa using hσ3'
  intro x hx
  rw [hUeq] at hx
  rw [Subgroup.mem_zpowers_iff] at hx
  obtain ⟨k, hk⟩ := hx
  rw [← hk]
  have hmod : σ ^ k = σ ^ (k % 3) := by
    conv_lhs => rw [← Int.mul_ediv_add_emod k 3]
    rw [zpow_add, zpow_mul, h3z, one_zpow, one_mul]
  rw [hmod]
  have h0 : 0 ≤ k % 3 := Int.emod_nonneg k (by norm_num)
  have hlt : k % 3 < 3 := Int.emod_lt_of_pos k (by norm_num)
  obtain h | h | h : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
  · left; rw [h]; norm_num
  · right; left; rw [h]; norm_num
  · right; right; rw [h]; norm_num

/-! ## 2. The centralizer of `z * σ` -/

/-- The subgroup `C_G(z) ⊓ C_G(U)`. -/
abbrev centralizerInf (G : Type) [Group G] (z : G) (U : Subgroup G) : Subgroup G :=
  Subgroup.centralizer ({z} : Set G) ⊓ Subgroup.centralizer (U : Set G)

/-- `C_G(z * σ) = C_G(z) ⊓ C_G(U)`: commuting with `z * σ` is the same as commuting with both
`(z*σ)^3 = z` and `(z*σ)^4 = σ`, and `U = ⟨σ⟩`. -/
lemma centralizer_zsigma_eq {G : Type} [Group G] [Finite G] (ctx : A7RecCtx G) {σ : G}
    (hσU : σ ∈ ctx.U) (hσ1 : σ ≠ 1) :
    Subgroup.centralizer ({ctx.z * σ} : Set G) =
      Subgroup.centralizer ({ctx.z} : Set G) ⊓ Subgroup.centralizer (ctx.U : Set G) := by
  have hσ3 : orderOf σ = 3 := orderOf_eq_three_of_mem_card_three ctx.hUcard hσU hσ1
  have hUeq : ctx.U = Subgroup.zpowers σ := zpowers_eq_of_mem_card_three ctx.hUcard hσU hσ1
  have hcomm : Commute ctx.z σ := by
    have h := Work.A7REC.Basic.U_le_centralizer G ctx hσU
    rw [Subgroup.mem_centralizer_singleton_iff] at h
    exact h.symm
  have hz2 : ctx.z ^ 2 = 1 := by
    have h := pow_orderOf_eq_one ctx.z
    rwa [ctx.hz2] at h
  have hs3 : σ ^ 3 = 1 := by
    have h := pow_orderOf_eq_one σ
    rwa [hσ3] at h
  have hz3 : ctx.z ^ 3 = ctx.z := by
    rw [show (3 : ℕ) = 2 + 1 from rfl, pow_add, hz2, one_mul, pow_one]
  have hz4 : ctx.z ^ 4 = 1 := by
    rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hz2, one_pow]
  have hs4 : σ ^ 4 = σ := by
    rw [show (4 : ℕ) = 3 + 1 from rfl, pow_add, hs3, one_mul, pow_one]
  have h3 : (ctx.z * σ) ^ 3 = ctx.z := by rw [hcomm.mul_pow, hz3, hs3, mul_one]
  have h4 : (ctx.z * σ) ^ 4 = σ := by rw [hcomm.mul_pow, hz4, hs4, one_mul]
  ext u
  constructor
  · intro hu
    rw [Subgroup.mem_inf]
    rw [Subgroup.mem_centralizer_iff] at hu
    have huzs : Commute u (ctx.z * σ) := (hu _ (Set.mem_singleton _)).symm
    have huz : Commute u ctx.z := by
      have h := huzs.pow_right 3
      rwa [h3] at h
    have hus : Commute u σ := by
      have h := huzs.pow_right 4
      rwa [h4] at h
    refine ⟨?_, ?_⟩
    · exact (Subgroup.mem_centralizer_singleton_iff).mpr huz.eq
    · rw [hUeq, Subgroup.mem_centralizer_iff]
      intro h hh
      change h ∈ Subgroup.zpowers σ at hh
      rw [Subgroup.mem_zpowers_iff] at hh
      obtain ⟨k, rfl⟩ := hh
      exact (hus.symm.zpow_left k).eq
  · intro hu
    rw [Subgroup.mem_inf] at hu
    obtain ⟨huz, huU⟩ := hu
    have huzc : Commute u ctx.z := (Subgroup.mem_centralizer_singleton_iff.mp huz)
    have hus : Commute u σ := ((Subgroup.mem_centralizer_iff.mp huU) σ hσU).symm
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    subst hh
    exact (huzc.mul_right hus).eq.symm

/-- `|C_G(z) ⊓ C_G(U)| = 12`: the intersection is contained in `C_G(U)` (order `36`) and in
`C_G(z)` (order `24`), so its order divides `12`; it contains the internal direct product
`U ⊔ V` (order `3 · 4 = 12`) because `U ≤ C_G(z)`, `V ≤ C_G(z)` and `⁅U,V⁆ = ⊥`. -/
lemma card_inf_centralizer {G : Type} [Group G] [Finite G] (ctx : A7RecCtx G) :
    Nat.card ↥(centralizerInf G ctx.z ctx.U) = 12 := by
  set K : Subgroup G := centralizerInf G ctx.z ctx.U with hK
  have hdiv1 : Nat.card ↥K ∣ 24 := by
    have h := Subgroup.card_dvd_of_le
      (show K ≤ Subgroup.centralizer ({ctx.z} : Set G) from inf_le_left)
    rwa [Work.A7REC.Basic.card_centralizer_z G ctx] at h
  have hdiv2 : Nat.card ↥K ∣ 36 := by
    have h := Subgroup.card_dvd_of_le
      (show K ≤ Subgroup.centralizer (ctx.U : Set G) from inf_le_right)
    rwa [Work.A7REC.Basic.card_centralizer_U G ctx] at h
  have hdiv : Nat.card ↥K ∣ 12 := by
    have h := Nat.dvd_gcd hdiv1 hdiv2
    have : Nat.gcd 24 36 = 12 := by norm_num
    rwa [this] at h
  -- `U ≤ K`
  have hexU : ∃ σ₀ ∈ ctx.U, σ₀ ≠ 1 := by
    by_contra h
    push_neg at h
    have hbot : ctx.U = ⊥ := (Subgroup.eq_bot_iff_forall _).mpr h
    have hUcard' : Nat.card ↥(⊥ : Subgroup G) = 3 := by rw [← hbot]; exact ctx.hUcard
    simp at hUcard'
  obtain ⟨σ₀, hσ₀U, hσ₀1⟩ := hexU
  have hUle : ctx.U ≤ K := by
    refine le_inf (Work.A7REC.Basic.U_le_centralizer G ctx) ?_
    rw [zpowers_eq_of_mem_card_three ctx.hUcard hσ₀U hσ₀1]
    rw [Subgroup.zpowers_le]
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    change h ∈ Subgroup.zpowers σ₀ at hh
    rw [Subgroup.mem_zpowers_iff] at hh
    obtain ⟨m, rfl⟩ := hh
    exact ((Commute.refl σ₀).zpow_left m).eq
  -- `V ≤ K`
  have hVleCU : ctx.V ≤ Subgroup.centralizer (ctx.U : Set G) := by
    have h := Subgroup.commutator_eq_bot_iff_le_centralizer.mp
      (Work.A7REC.Basic.commute_U_V G ctx)
    exact (Subgroup.le_centralizer_iff.mp h)
  have hVle : ctx.V ≤ K :=
    le_inf (Work.A7REC.Basic.V_le_C G ctx) hVleCU
  have hUVle : ctx.U ⊔ ctx.V ≤ K := sup_le hUle hVle
  -- `|U ⊔ V| = 12`
  have hVnorm : ctx.V ≤ Subgroup.normalizer (ctx.U : Set G) :=
    le_trans hVleCU (Subgroup.centralizer_le_normalizer (ctx.U : Set G))
  have hdisj : Disjoint ctx.U ctx.V := by
    rw [disjoint_iff]
    have h1 : Nat.card ↥(ctx.U ⊓ ctx.V) ∣ 3 := by
      have h := Subgroup.card_dvd_of_le (inf_le_left : ctx.U ⊓ ctx.V ≤ ctx.U)
      rwa [ctx.hUcard] at h
    have h2 : Nat.card ↥(ctx.U ⊓ ctx.V) ∣ 4 := by
      have h := Subgroup.card_dvd_of_le (inf_le_right : ctx.U ⊓ ctx.V ≤ ctx.V)
      rwa [ctx.hV4.1] at h
    exact Subgroup.card_eq_one.mp (Nat.eq_one_of_dvd_coprimes (by norm_num) h1 h2)
  have hUVcard : Nat.card ↥(ctx.U ⊔ ctx.V) = 12 := by
    rw [Work.A7REC.Join.card_sup_of_le_normalizer_of_disjoint hVnorm hdisj,
      ctx.hUcard, ctx.hV4.1]
  have hle : Nat.card ↥(ctx.U ⊔ ctx.V) ≤ Nat.card ↥K :=
    Nat.le_of_dvd Nat.card_pos (Subgroup.card_dvd_of_le hUVle)
  rw [hUVcard] at hle
  exact Nat.le_antisymm (Nat.le_of_dvd (by norm_num) hdiv) hle

/-- **`orderOf (z*σ) = 6`, `|C_G(z*σ)| = 12`, and `z*σ` is conjugate to its inverse.** -/
lemma zsigma_structure {G : Type} [Group G] [Finite G] (ctx : A7RecCtx G) {σ : G}
    (hσU : σ ∈ ctx.U) (hσ1 : σ ≠ 1) :
    orderOf (ctx.z * σ) = 6 ∧
      Nat.card (Subgroup.centralizer ({ctx.z * σ} : Set G)) = 12 ∧
      IsConj (ctx.z * σ) (ctx.z * σ)⁻¹ := by
  have hσ3 : orderOf σ = 3 := orderOf_eq_three_of_mem_card_three ctx.hUcard hσU hσ1
  have hcomm : Commute ctx.z σ := by
    have h := Work.A7REC.Basic.U_le_centralizer G ctx hσU
    rw [Subgroup.mem_centralizer_singleton_iff] at h
    exact h.symm
  have horder : orderOf (ctx.z * σ) = 6 := by
    rw [hcomm.orderOf_mul_eq_mul_orderOf_of_coprime (by rw [ctx.hz2, hσ3]; norm_num),
      ctx.hz2, hσ3]
  have hcard : Nat.card (Subgroup.centralizer ({ctx.z * σ} : Set G)) = 12 := by
    rw [centralizer_zsigma_eq ctx hσU hσ1, card_inf_centralizer ctx]
  refine ⟨horder, hcard, ?_⟩
  -- an element of `C_G(z)` outside `C_G(z) ⊓ C_G(U)` inverts `σ`
  have hK12 := card_inf_centralizer ctx
  have hex : ∃ c : G, c ∈ Subgroup.centralizer ({ctx.z} : Set G) ∧
      c ∉ centralizerInf G ctx.z ctx.U := by
    by_contra h
    push_neg at h
    have hle : Subgroup.centralizer ({ctx.z} : Set G) ≤ centralizerInf G ctx.z ctx.U := h
    have hdvd := Subgroup.card_dvd_of_le hle
    rw [Work.A7REC.Basic.card_centralizer_z G ctx, hK12] at hdvd
    omega
  obtain ⟨c, hcCz, hcK⟩ := hex
  have hUeq : ctx.U = Subgroup.zpowers σ := zpowers_eq_of_mem_card_three ctx.hUcard hσU hσ1
  have hcσ : c * σ * c⁻¹ ≠ σ := by
    intro hconj
    apply hcK
    rw [Subgroup.mem_inf]
    refine ⟨hcCz, ?_⟩
    have hcom : Commute c σ := by
      have h := congrArg (fun t => t * c) hconj
      exact (commute_iff_eq c σ).mpr (by simpa [mul_assoc] using h)
    rw [hUeq, Subgroup.mem_centralizer_iff]
    intro h hh
    change h ∈ Subgroup.zpowers σ at hh
    rw [Subgroup.mem_zpowers_iff] at hh
    obtain ⟨m, rfl⟩ := hh
    exact (hcom.symm.zpow_left m).eq
  have hmem : c * σ * c⁻¹ ∈ ctx.U :=
    Work.A7REC.Basic.conj_mem_of_subgroupOf_normal (Work.A7REC.Basic.U_le_centralizer G ctx)
      ctx.hUnorm hcCz hσU
  have hw : c * σ * c⁻¹ = σ ^ 2 := by
    rcases mem_eq_three_of_card_three ctx.hUcard hσU hσ1 hσ3 _ hmem with h | h | h
    · exfalso
      have hne : c * σ * c⁻¹ ≠ 1 := by
        intro hh
        have h2 : σ = 1 := by
          have hh' := congrArg (fun t => c⁻¹ * t * c) hh
          simpa [mul_assoc] using hh'
        exact hσ1 h2
      exact hne h
    · exact absurd h hcσ
    · exact h
  rw [isConj_iff]
  refine ⟨c, ?_⟩
  have hcz : c * ctx.z * c⁻¹ = ctx.z := by
    have h := (Subgroup.mem_centralizer_singleton_iff.mp hcCz)
    rw [h, mul_assoc, mul_inv_cancel, mul_one]
  have hsz : σ ^ 2 = σ⁻¹ := by
    rw [eq_inv_iff_mul_eq_one]
    have hs3 : σ ^ 3 = 1 := by
      have h := pow_orderOf_eq_one σ
      rwa [hσ3] at h
    rw [← pow_succ, hs3]
  have hzinv : ctx.z⁻¹ = ctx.z := by
    have h := pow_orderOf_eq_one ctx.z
    rw [ctx.hz2, pow_two] at h
    exact inv_eq_of_mul_eq_one_right h
  calc c * (ctx.z * σ) * c⁻¹ = (c * ctx.z * c⁻¹) * (c * σ * c⁻¹) := by group
    _ = ctx.z * σ ^ 2 := by rw [hcz, hw]
    _ = (ctx.z * σ)⁻¹ := by rw [mul_inv_rev, hzinv, ← hsz, (hcomm.pow_right 2).eq]

/-! ## 3. Powers of elements of order `2`, `4`, `6`, and integrality of character values -/

/-- Reduction of powers modulo the order. -/
lemma pow_mod_orderOf {G : Type} [Group G] {g : G} {k n : ℕ} (hg : orderOf g = n) :
    g ^ k = g ^ (k % n) := by
  conv_lhs => rw [← Nat.div_add_mod k n]
  rw [pow_add, pow_mul,
    show g ^ n = 1 from by rw [← hg]; exact pow_orderOf_eq_one g, one_pow, one_mul]

/-- An exponent coprime to the order of a group of even order is odd. -/
lemma not_even_of_coprime {G : Type} [Group G] [Finite G] {k : ℕ} (h2 : 2 ∣ Nat.card G)
    (hk : k.Coprime (Nat.card G)) : ¬ 2 ∣ k := by
  intro h
  have hd := Nat.dvd_gcd h h2
  rw [hk] at hd
  omega

/-- A coprime power of an involution is the involution itself. -/
lemma pow_eq_self_of_orderOf_eq_two {G : Type} [Group G] {g : G} (hg : orderOf g = 2)
    {k : ℕ} (hk : ¬ 2 ∣ k) : g ^ k = g := by
  have hmod : k % 2 = 1 := by omega
  have h := pow_mod_orderOf (g := g) (k := k) (n := 2) hg
  rw [h, hmod, pow_one]

/-- A coprime power of an element of order `4` is the element or its inverse. -/
lemma pow_eq_self_or_inv_of_orderOf_eq_four {G : Type} [Group G] {g : G} (hg : orderOf g = 4)
    {k : ℕ} (hk : ¬ 2 ∣ k) : g ^ k = g ∨ g ^ k = g⁻¹ := by
  have hmod : k % 4 = 1 ∨ k % 4 = 3 := by omega
  have hpow := pow_mod_orderOf (g := g) (k := k) (n := 4) hg
  have h4 : g ^ 4 = 1 := by
    have h := pow_orderOf_eq_one g
    rwa [hg] at h
  have hinv : g ^ 3 = g⁻¹ := by
    rw [eq_inv_iff_mul_eq_one, ← pow_succ, h4]
  rcases hmod with h | h
  · left; rw [hpow, h, pow_one]
  · right; rw [hpow, h, hinv]

/-- A power of an element of order `6` with exponent coprime to `6` is the element or its
inverse. -/
lemma pow_eq_self_or_inv_of_orderOf_eq_six {G : Type} [Group G] {g : G} (hg : orderOf g = 6)
    {k : ℕ} (hodd : ¬ 2 ∣ k) (h3 : ¬ 3 ∣ k) : g ^ k = g ∨ g ^ k = g⁻¹ := by
  have hmod : k % 6 = 1 ∨ k % 6 = 5 := by omega
  have hpow := pow_mod_orderOf (g := g) (k := k) (n := 6) hg
  have h6 : g ^ 6 = 1 := by
    have h := pow_orderOf_eq_one g
    rwa [hg] at h
  have hinv : g ^ 5 = g⁻¹ := by
    rw [eq_inv_iff_mul_eq_one, ← pow_succ, h6]
  rcases hmod with h | h
  · left; rw [hpow, h, pow_one]
  · right; rw [hpow, h, hinv]

/-- Character values at an involution are real. -/
lemma real_apply_of_mul_self_eq_one {G : Type} [Group G] [Finite G]
    (χ : IrreducibleCharacter G) {z : G} (hz : z * z = 1) :
    (χ : ClassFunction G ℂ) z = star ((χ : ClassFunction G ℂ) z) := by
  have h := irreducibleCharacter_apply_inv χ z
  rwa [inv_eq_of_mul_eq_one_right hz] at h

/-- Character values at an element conjugate to its inverse are real. -/
lemma real_apply_of_isConj_inv {G : Type} [Group G] [Finite G]
    (χ : IrreducibleCharacter G) {g : G} (h : IsConj g g⁻¹) :
    (χ : ClassFunction G ℂ) g = star ((χ : ClassFunction G ℂ) g) := by
  rw [← irreducibleCharacter_apply_inv χ g]
  exact ClassFunction.of_isConj _ h

/-- **Real Galois-fixed character values are integral.**

If `g ^ k` is `g` or `g⁻¹` for every `k` coprime to `|G|`, and `χ g` is real, then `χ g ∈ ℤ`:
`χ g` is an algebraic integer, and every ring automorphism `σ` of `ℂ` acts on `|G|`-th roots of
unity as `(· ^ k)`, so `σ (χ g) = χ (g ^ k) = χ g`. -/
lemma exists_int_apply_of_pow_eq_self_or_inv {G : Type} [Group G] [Finite G]
    (χ : IrreducibleCharacter G) {g : G}
    (hpow : ∀ k : ℕ, k.Coprime (Nat.card G) → g ^ k = g ∨ g ^ k = g⁻¹)
    (hreal : (χ : ClassFunction G ℂ) g = star ((χ : ClassFunction G ℂ) g)) :
    ∃ n : ℤ, (χ : ClassFunction G ℂ) g = (n : ℂ) := by
  have hint : IsIntegral ℤ ((χ : ClassFunction G ℂ) g) :=
    OddOrder.Algebra.isIntegral_apply_of_mem_ZIrr (IrreducibleCharacter.mem_ZIrr χ) g
  have hfix : ∀ σ : ℂ ≃+* ℂ, σ ((χ : ClassFunction G ℂ) g) = (χ : ClassFunction G ℂ) g := by
    intro σ
    obtain ⟨k, hkcop, hkσ⟩ :=
      OddOrder.Algebra.exists_pow_of_complexRingEquiv σ (show Nat.card G ≠ 0 from Nat.card_pos.ne')
    have h := OddOrder.Algebra.complexRingEquiv_apply_eq_apply_pow_of_mem_ZIrr
      (IrreducibleCharacter.mem_ZIrr χ) σ hkσ g
    rw [h]
    rcases hpow k hkcop with h1 | h1
    · rw [h1]
    · rw [h1, irreducibleCharacter_apply_inv, ← hreal]
  obtain ⟨n, hn⟩ :=
    OddOrder.Algebra.exists_int_of_isIntegral_of_forall_complexRingEquiv_fixed hint hfix
  exact ⟨n, hn.symm⟩

/-- **The sum of a character over a set closed under coprime powers is an integer.** -/
lemma exists_int_sum_of_pow_closed {G : Type} [Group G] [Finite G]
    (χ : IrreducibleCharacter G) (A : Finset G)
    (hA : ∀ x ∈ A, ∀ k : ℕ, k.Coprime (Nat.card G) → x ^ k ∈ A) :
    ∃ m : ℤ, ∑ x ∈ A, (χ : ClassFunction G ℂ) x = (m : ℂ) := by
  have hint : IsIntegral ℤ (∑ x ∈ A, (χ : ClassFunction G ℂ) x) :=
    IsIntegral.sum _ fun x _ =>
      OddOrder.Algebra.isIntegral_apply_of_mem_ZIrr (IrreducibleCharacter.mem_ZIrr χ) x
  have hfix : ∀ σ : ℂ ≃+* ℂ,
      σ (∑ x ∈ A, (χ : ClassFunction G ℂ) x) = ∑ x ∈ A, (χ : ClassFunction G ℂ) x := by
    intro σ
    obtain ⟨k, hkcop, hkσ⟩ :=
      OddOrder.Algebra.exists_pow_of_complexRingEquiv σ (show Nat.card G ≠ 0 from Nat.card_pos.ne')
    have hσval : ∀ w : G, σ ((χ : ClassFunction G ℂ) w) = (χ : ClassFunction G ℂ) (w ^ k) :=
      fun w => OddOrder.Algebra.complexRingEquiv_apply_eq_apply_pow_of_mem_ZIrr
        (IrreducibleCharacter.mem_ZIrr χ) σ hkσ w
    obtain ⟨hinj, himg⟩ := OddOrder.Algebra.powClosed_image_pow_eq_of_cyclicClosed hA hkcop
    rw [map_sum]
    rw [Finset.sum_congr rfl fun x _ => hσval x]
    have hb : (∑ x ∈ A, (χ : ClassFunction G ℂ) (x ^ k)) =
        ∑ y ∈ A.image (fun x : G => x ^ k), (χ : ClassFunction G ℂ) y :=
      (Finset.sum_image (s := A) (g := fun x : G => x ^ k)
        (f := fun y : G => (χ : ClassFunction G ℂ) y) (fun x hx y hy h => hinj x hx y hy h)).symm
    rw [hb, himg]
  obtain ⟨m, hm⟩ :=
    OddOrder.Algebra.exists_int_of_isIntegral_of_forall_complexRingEquiv_fixed hint hfix
  exact ⟨m, hm.symm⟩

/-! ## 4. Column-orthogonality sums -/

/-- **Column orthogonality for products of character values.**  If the values at `b` are real,
then `∑_χ χ(a) χ(b)` is `|C_G(a)|` when `a ~ b` and `0` otherwise. -/
lemma sum_apply_mul_apply {G : Type} [Group G] [Finite G] (a b : G)
    (hb : ∀ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) b = star ((χ : ClassFunction G ℂ) b)) :
    ∑ χ : IrreducibleCharacter G,
        (χ : ClassFunction G ℂ) a * (χ : ClassFunction G ℂ) b =
      if IsConj a b then (Nat.card (Subgroup.centralizer ({a} : Set G)) : ℂ) else 0 := by
  by_cases h : IsConj a b
  · rw [if_pos h, ← column_orthogonality_conjugate h]
    exact Finset.sum_congr rfl fun χ _ => by rw [← hb χ]
  · rw [if_neg h, ← column_orthogonality_not_conjugate h]
    exact Finset.sum_congr rfl fun χ _ => by rw [← hb χ]

/-- **The diagonal column sum `∑_χ χ(a)² = |C_G(a)|`** for real-valued `a`. -/
lemma sum_apply_sq {G : Type} [Group G] [Finite G] (a : G)
    (ha : ∀ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) a = star ((χ : ClassFunction G ℂ) a))
    {m : ℕ} (hm : Nat.card (Subgroup.centralizer ({a} : Set G)) = m) :
    ∑ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) a ^ 2 = (m : ℂ) := by
  have h := sum_apply_mul_apply (G := G) a a ha
  rw [if_pos (IsConj.refl a), hm] at h
  have h2 : (∑ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) a ^ 2) =
      ∑ χ : IrreducibleCharacter G,
        (χ : ClassFunction G ℂ) a * (χ : ClassFunction G ℂ) a :=
    Finset.sum_congr rfl fun χ _ => by ring
  rw [h2, h]

/-! ## 5. Sums indexed by a range -/

/-- Reindexing a sum along an injective enumeration of a finset. -/
lemma sum_image_eq_sum_finset {G : Type} [Group G] {M : Type} [AddCommMonoid M] {n : ℕ}
    {ι : Fin n → IrreducibleCharacter G} {R : Finset (IrreducibleCharacter G)}
    (hinj : Function.Injective ι) (himg : Finset.univ.image ι = R)
    (g : IrreducibleCharacter G → M) :
    ∑ i : Fin n, g (ι i) = ∑ χ ∈ R, g χ := by
  rw [← himg]
  exact (Finset.sum_image (s := (Finset.univ : Finset (Fin n))) (g := ι) (f := g)
    (fun x _ y _ h => hinj h)).symm

/-- A sum over a finset contained in `univ.erase t` and whose complement is a zero set. -/
lemma sum_finset_eq_sum_sub {G : Type} [Group G] [Finite G] {M : Type} [AddCommGroup M]
    {R : Finset (IrreducibleCharacter G)} {t : IrreducibleCharacter G}
    (hRsub : R ⊆ Finset.univ.erase t) (g : IrreducibleCharacter G → M)
    (hg : ∀ χ ∈ Finset.univ.erase t, χ ∉ R → g χ = 0) :
    ∑ χ ∈ R, g χ = (∑ χ : IrreducibleCharacter G, g χ) - g t := by
  rw [Finset.sum_subset hRsub hg]
  have h := Finset.add_sum_erase (Finset.univ : Finset (IrreducibleCharacter G)) g
    (Finset.mem_univ t)
  rw [← h]
  abel

/-- The composite reindexing: a sum over `Fin n` along an enumeration of `R` equals the sum over
all irreducible characters minus the term at `t`. -/
lemma sum_indexed_eq_sub {G : Type} [Group G] [Finite G] {M : Type} [AddCommGroup M] {n : ℕ}
    {ι : Fin n → IrreducibleCharacter G} {R : Finset (IrreducibleCharacter G)}
    {t : IrreducibleCharacter G} (hinj : Function.Injective ι)
    (himg : Finset.univ.image ι = R) (hRsub : R ⊆ Finset.univ.erase t)
    (g : IrreducibleCharacter G → M)
    (hg : ∀ χ ∈ Finset.univ.erase t, χ ∉ R → g χ = 0) :
    ∑ i : Fin n, g (ι i) = (∑ χ : IrreducibleCharacter G, g χ) - g t := by
  rw [sum_image_eq_sum_finset hinj himg g, sum_finset_eq_sum_sub hRsub g hg]


/-! ## 6. The subgroup `⟨z, σ⟩` and the three-divisibility -/

section
variable {G : Type} [Group G] [Finite G] (ctx : A7RecCtx G) {σ : G}

/-- `σ = (z σ)^4` and `z = (z σ)^3`. -/
lemma zsigma_pow_eq (hσU : σ ∈ ctx.U) (hσ1 : σ ≠ 1) :
    (ctx.z * σ) ^ 3 = ctx.z ∧ (ctx.z * σ) ^ 4 = σ := by
  have hσ3 : orderOf σ = 3 := orderOf_eq_three_of_mem_card_three ctx.hUcard hσU hσ1
  have hcomm : Commute ctx.z σ := by
    have h := Work.A7REC.Basic.U_le_centralizer G ctx hσU
    rw [Subgroup.mem_centralizer_singleton_iff] at h
    exact h.symm
  have hz2 : ctx.z ^ 2 = 1 := by
    have h := pow_orderOf_eq_one ctx.z
    rwa [ctx.hz2] at h
  have hs3 : σ ^ 3 = 1 := by
    have h := pow_orderOf_eq_one σ
    rwa [hσ3] at h
  have hz3 : ctx.z ^ 3 = ctx.z := by
    rw [show (3 : ℕ) = 2 + 1 from rfl, pow_add, hz2, one_mul, pow_one]
  have hz4 : ctx.z ^ 4 = 1 := by
    rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hz2, one_pow]
  have hs4 : σ ^ 4 = σ := by
    rw [show (4 : ℕ) = 3 + 1 from rfl, pow_add, hs3, one_mul, pow_one]
  exact ⟨by rw [hcomm.mul_pow, hz3, hs3, mul_one],
    by rw [hcomm.mul_pow, hz4, hs4, one_mul]⟩

/-- **Splitting the cyclic group `⟨z, σ⟩ = ⟨z σ⟩` of order `6` into the cosets `U` and `z U`.** -/
lemma sum_zpowers_eq_sum_add [Fintype ↥ctx.U] [Fintype ↥(Subgroup.zpowers (ctx.z * σ))]
    (hσU : σ ∈ ctx.U) (hσ1 : σ ≠ 1) (χ : IrreducibleCharacter G) :
    ∑ h : ↥(Subgroup.zpowers (ctx.z * σ)), (χ : ClassFunction G ℂ) h
      = ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) u
        + ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) (ctx.z * u) := by
  obtain ⟨horder, -, -⟩ := zsigma_structure ctx hσU hσ1
  obtain ⟨hw3, hw4⟩ := zsigma_pow_eq ctx hσU hσ1
  have hσH : σ ∈ Subgroup.zpowers (ctx.z * σ) := by
    simpa [hw4] using Subgroup.npow_mem_zpowers (ctx.z * σ) 4
  have hzH : ctx.z ∈ Subgroup.zpowers (ctx.z * σ) := by
    simpa [hw3] using Subgroup.npow_mem_zpowers (ctx.z * σ) 3
  have hUH : ctx.U ≤ Subgroup.zpowers (ctx.z * σ) := by
    rw [zpowers_eq_of_mem_card_three ctx.hUcard hσU hσ1]
    exact Subgroup.zpowers_le.mpr hσH
  -- the three finite subsets of `G`
  have hUUmem : ∀ x : G, x ∈ (Finset.univ : Finset ↥ctx.U).image Subtype.val ↔ x ∈ ctx.U := by
    intro x
    rw [Finset.mem_image]
    constructor
    · rintro ⟨u, -, rfl⟩; exact u.2
    · intro hx; exact ⟨⟨x, hx⟩, Finset.mem_univ _, rfl⟩
  have hHUm : ∀ x : G,
      x ∈ (Finset.univ : Finset ↥(Subgroup.zpowers (ctx.z * σ))).image Subtype.val ↔
        x ∈ Subgroup.zpowers (ctx.z * σ) := by
    intro x
    rw [Finset.mem_image]
    constructor
    · rintro ⟨h, -, rfl⟩; exact h.2
    · intro hx; exact ⟨⟨x, hx⟩, Finset.mem_univ _, rfl⟩
  have hUUcard : ((Finset.univ : Finset ↥ctx.U).image Subtype.val).card = 3 := by
    rw [Finset.card_image_of_injective _ (f := Subtype.val) (fun x y h => Subtype.ext h),
      Finset.card_univ, ← Nat.card_eq_fintype_card, ctx.hUcard]
  have hZUcard : (((Finset.univ : Finset ↥ctx.U).image Subtype.val).image
      (fun u => ctx.z * u)).card = 3 := by
    rw [Finset.card_image_of_injective _ (f := fun u : G => ctx.z * u)
      (fun x y h => mul_left_cancel h), hUUcard]
  have hHUcard : ((Finset.univ : Finset ↥(Subgroup.zpowers (ctx.z * σ))).image
      Subtype.val).card = 6 := by
    rw [Finset.card_image_of_injective _ (f := Subtype.val) (fun x y h => Subtype.ext h),
      Finset.card_univ, ← Nat.card_eq_fintype_card, Nat.card_zpowers, horder]
  have hdisj : Disjoint ((Finset.univ : Finset ↥ctx.U).image Subtype.val)
      (((Finset.univ : Finset ↥ctx.U).image Subtype.val).image (fun u => ctx.z * u)) := by
    rw [Finset.disjoint_left]
    intro x hx1 hx2
    have hxU : x ∈ ctx.U := hUUmem x |>.mp hx1
    rw [Finset.mem_image] at hx2
    obtain ⟨y, hy, hyx⟩ := hx2
    have hyU : y ∈ ctx.U := hUUmem y |>.mp hy
    have hzU : ctx.z ∈ ctx.U := by
      have hzy : ctx.z = x * y⁻¹ := by rw [← hyx]; group
      rw [hzy]
      exact ctx.U.mul_mem hxU (ctx.U.inv_mem hyU)
    have hdvd : orderOf ctx.z ∣ Nat.card ctx.U := by
      have h := orderOf_dvd_card (x := (⟨ctx.z, hzU⟩ : ↥ctx.U))
      rw [Subgroup.orderOf_mk, ← Nat.card_eq_fintype_card] at h
      exact h
    rw [ctx.hz2, ctx.hUcard] at hdvd
    omega
  have hsub : ((Finset.univ : Finset ↥ctx.U).image Subtype.val) ∪
      (((Finset.univ : Finset ↥ctx.U).image Subtype.val).image (fun u => ctx.z * u)) ⊆
      (Finset.univ : Finset ↥(Subgroup.zpowers (ctx.z * σ))).image Subtype.val := by
    intro x hx
    rw [hHUm]
    rcases Finset.mem_union.mp hx with hx | hx
    · exact hUH (hUUmem x |>.mp hx)
    · rw [Finset.mem_image] at hx
      obtain ⟨y, hy, hyx⟩ := hx
      have hyH : y ∈ Subgroup.zpowers (ctx.z * σ) := hUH (hUUmem y |>.mp hy)
      rw [← hyx]
      exact Subgroup.mul_mem _ hzH hyH
  have hHeq : (Finset.univ : Finset ↥(Subgroup.zpowers (ctx.z * σ))).image Subtype.val =
      ((Finset.univ : Finset ↥ctx.U).image Subtype.val) ∪
        (((Finset.univ : Finset ↥ctx.U).image Subtype.val).image (fun u => ctx.z * u)) := by
    refine (Finset.eq_of_subset_of_card_le (s := ((Finset.univ : Finset ↥ctx.U).image
      Subtype.val) ∪ (((Finset.univ : Finset ↥ctx.U).image Subtype.val).image
        (fun u => ctx.z * u))) (t := (Finset.univ : Finset
          ↥(Subgroup.zpowers (ctx.z * σ))).image Subtype.val) hsub ?_).symm
    rw [Finset.card_union_of_disjoint hdisj, hUUcard, hZUcard, hHUcard]
  have hHUs : ∑ x ∈ (Finset.univ : Finset ↥(Subgroup.zpowers (ctx.z * σ))).image Subtype.val,
        (χ : ClassFunction G ℂ) x
      = ∑ h : ↥(Subgroup.zpowers (ctx.z * σ)), (χ : ClassFunction G ℂ) h :=
    Finset.sum_image (fun x _ y _ h => Subtype.ext h)
  have hUUs : ∑ x ∈ (Finset.univ : Finset ↥ctx.U).image Subtype.val, (χ : ClassFunction G ℂ) x
      = ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) u :=
    Finset.sum_image (fun x _ y _ h => Subtype.ext h)
  have hZUs : ∑ x ∈ ((Finset.univ : Finset ↥ctx.U).image Subtype.val).image
        (fun u => ctx.z * u), (χ : ClassFunction G ℂ) x
      = ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) (ctx.z * u) := by
    rw [Finset.sum_image (g := fun u : G => ctx.z * u) (fun x _ y _ h => mul_left_cancel h)]
    exact Finset.sum_image (s := (Finset.univ : Finset ↥ctx.U)) (g := Subtype.val)
      (f := fun x : G => (χ : ClassFunction G ℂ) (ctx.z * x)) (fun x _ y _ h => Subtype.ext h)
  calc ∑ h : ↥(Subgroup.zpowers (ctx.z * σ)), (χ : ClassFunction G ℂ) h
      = ∑ x ∈ (Finset.univ : Finset ↥(Subgroup.zpowers (ctx.z * σ))).image Subtype.val,
          (χ : ClassFunction G ℂ) x := hHUs.symm
    _ = ∑ x ∈ ((Finset.univ : Finset ↥ctx.U).image Subtype.val) ∪
          (((Finset.univ : Finset ↥ctx.U).image Subtype.val).image (fun u => ctx.z * u)),
          (χ : ClassFunction G ℂ) x := by rw [hHeq]
    _ = ∑ x ∈ (Finset.univ : Finset ↥ctx.U).image Subtype.val, (χ : ClassFunction G ℂ) x
        + ∑ x ∈ ((Finset.univ : Finset ↥ctx.U).image Subtype.val).image (fun u => ctx.z * u),
          (χ : ClassFunction G ℂ) x := Finset.sum_union hdisj
    _ = ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) u
        + ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) (ctx.z * u) := by rw [hUUs, hZUs]

lemma sum_subtype_eq_three {G : Type} [Group G] [Finite G] (U : Subgroup G) [Fintype ↥U]
    {σ : G} (hUcard : Nat.card U = 3) (hσU : σ ∈ U) (hσ1 : σ ≠ 1)
    {M : Type} [AddCommMonoid M] (f : G → M) :
    ∑ u : ↥U, f u = f 1 + f σ + f (σ ^ 2) := by
  have hσ3 : orderOf σ = 3 := orderOf_eq_three_of_mem_card_three hUcard hσU hσ1
  have hσ2U : σ ^ 2 ∈ U := U.pow_mem hσU 2
  have hσ2ne1 : σ ^ 2 ≠ 1 := by
    intro h
    have h2 : orderOf σ ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr h
    rw [hσ3] at h2
    omega
  have hσ2neσ : σ ^ 2 ≠ σ := by
    intro h
    have h' : σ * σ = σ * 1 := by simpa [pow_two] using h
    exact hσ1 (mul_left_cancel h')
  have hU3 : ({1, (⟨σ, hσU⟩ : ↥U), (⟨σ ^ 2, hσ2U⟩ : ↥U)} : Finset ↥U) = Finset.univ := by
    rw [Finset.eq_univ_iff_forall]
    intro u
    rw [Finset.mem_insert, Finset.mem_insert, Finset.mem_singleton]
    rcases mem_eq_three_of_card_three hUcard hσU hσ1 hσ3 (u : G) u.2 with h | h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Or.inl (Subtype.ext h))
    · exact Or.inr (Or.inr (Subtype.ext h))
  calc ∑ u : ↥U, f u
      = ∑ u ∈ ({1, (⟨σ, hσU⟩ : ↥U), (⟨σ ^ 2, hσ2U⟩ : ↥U)} : Finset ↥U), f u := by rw [hU3]
    _ = f 1 + (f σ + f (σ ^ 2)) := by
        rw [Finset.sum_insert, Finset.sum_insert, Finset.sum_singleton]
        · simp
        · simp only [Finset.mem_singleton]
          exact fun h => hσ2neσ (Subtype.ext_iff.mp h).symm
        · simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
          exact ⟨fun h => hσ1 (Subtype.ext_iff.mp h).symm,
            fun h => hσ2ne1 (Subtype.ext_iff.mp h).symm⟩
    _ = f 1 + f σ + f (σ ^ 2) := by abel

/-- **The sum of a character over a subgroup is a multiple of the subgroup order.** -/
lemma sum_subgroup_eq_card_mul {G : Type} [Group G] [Finite G] (H : Subgroup G) [Fintype ↥H]
    (χ : IrreducibleCharacter G) :
    ∃ m : ℕ, ∑ h : ↥H, (χ : ClassFunction G ℂ) h = (Nat.card ↥H : ℂ) * (m : ℂ) := by
  obtain ⟨V, _, _, _, ρ, hirr, hchar⟩ := χ.isIrreducible
  haveI : Invertible (Nat.card ↥H : ℂ) :=
    invertibleOfNonzero (by rw [Nat.cast_ne_zero]; exact Nat.card_pos.ne')
  have h := Representation.card_inv_mul_sum_char_eq_finrank (ρ := ρ.comp H.subtype) (k := ℂ)
  refine ⟨Module.finrank ℂ (Representation.invariants (ρ.comp H.subtype)), ?_⟩
  have hchars : ∀ h : ↥H,
      Representation.character (ρ.comp H.subtype) h = (χ : ClassFunction G ℂ) h := by
    intro h
    show ρ.character (h : G) = _
    exact (congrFun hchar (h : G)).symm
  rw [Finset.sum_congr rfl (fun h _ => hchars h)] at h
  rw [← h, ← mul_assoc, mul_inv_cancel₀ (by
    rw [Nat.cast_ne_zero]; exact Nat.card_pos.ne'), one_mul]


/-- **`3 ∣ χ(z) + 2 χ(z σ)`**: the sum `∑_{u ∈ U} χ (z u)` over the coset `z U` is
`∑_{h ∈ ⟨z σ⟩} χ h - ∑_{u ∈ U} χ u`, a difference of a multiple of `6` and a multiple of `3`. -/
lemma three_dvd_char_sum [Fintype ↥ctx.U] (hσU : σ ∈ ctx.U) (hσ1 : σ ≠ 1)
    (χ : IrreducibleCharacter G) :
    ∃ m : ℤ, (χ : ClassFunction G ℂ) ctx.z + 2 * (χ : ClassFunction G ℂ) (ctx.z * σ)
      = (3 * m : ℂ) := by
  haveI : Fintype ↥(Subgroup.zpowers (ctx.z * σ)) := Fintype.ofFinite _
  obtain ⟨horder, -, hconj_w⟩ := zsigma_structure ctx hσU hσ1
  obtain ⟨a, ha⟩ := sum_subgroup_eq_card_mul (H := Subgroup.zpowers (ctx.z * σ)) χ
  obtain ⟨b, hb⟩ := sum_subgroup_eq_card_mul (H := ctx.U) χ
  rw [Nat.card_zpowers, horder] at ha
  rw [ctx.hUcard] at hb
  have hsplit := sum_zpowers_eq_sum_add ctx hσU hσ1 χ
  -- `χ (z * σ ^ 2) = χ (z * σ)`
  have hcomm : Commute ctx.z σ := by
    have h := Work.A7REC.Basic.U_le_centralizer G ctx hσU
    rw [Subgroup.mem_centralizer_singleton_iff] at h
    exact h.symm
  have hσ3 : orderOf σ = 3 := orderOf_eq_three_of_mem_card_three ctx.hUcard hσU hσ1
  have hsz : σ ^ 2 = σ⁻¹ := by
    have h3 : σ ^ 3 = 1 := by rw [← hσ3]; exact pow_orderOf_eq_one σ
    rw [eq_inv_iff_mul_eq_one, ← pow_succ, show (2 : ℕ) + 1 = 3 from rfl, h3]
  have hz : ctx.z⁻¹ = ctx.z := by
    have h2 : ctx.z * ctx.z = 1 := by
      rw [← pow_two, ← ctx.hz2]; exact pow_orderOf_eq_one ctx.z
    exact inv_eq_of_mul_eq_one_right h2
  have hzs : ctx.z * σ ^ 2 = (ctx.z * σ)⁻¹ := by
    rw [mul_inv_rev, hz, hsz]
    exact (hcomm.inv_right).eq
  have hre : (χ : ClassFunction G ℂ) (ctx.z * σ ^ 2) = (χ : ClassFunction G ℂ) (ctx.z * σ) := by
    rw [hzs, irreducibleCharacter_apply_inv]
    exact (real_apply_of_isConj_inv χ hconj_w).symm
  have heval : ∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) (ctx.z * u)
      = (χ : ClassFunction G ℂ) ctx.z + 2 * (χ : ClassFunction G ℂ) (ctx.z * σ) := by
    rw [sum_subtype_eq_three (U := ctx.U) ctx.hUcard hσU hσ1
      (f := fun u : G => (χ : ClassFunction G ℂ) (ctx.z * u))]
    rw [mul_one, hre]
    ring
  refine ⟨2 * (a : ℤ) - (b : ℤ), ?_⟩
  have hT : (χ : ClassFunction G ℂ) ctx.z + 2 * (χ : ClassFunction G ℂ) (ctx.z * σ)
      = (6 : ℂ) * (a : ℂ) - (3 : ℂ) * (b : ℂ) := by
    have hstep : (χ : ClassFunction G ℂ) ctx.z + 2 * (χ : ClassFunction G ℂ) (ctx.z * σ)
        = (∑ h : ↥(Subgroup.zpowers (ctx.z * σ)), (χ : ClassFunction G ℂ) h)
          - (∑ u : ↥ctx.U, (χ : ClassFunction G ℂ) u) := by
      rw [hsplit, heval]
      ring
    rw [hstep, ha, hb]
    ring
  rw [hT]
  push_cast
  ring

end

/-- `∑ (f - g)² = ∑f² - 2∑(fg) + ∑g²`. -/
lemma sum_sq_sub {α : Type} (s : Finset α) (f g : α → ℂ) :
    ∑ x ∈ s, (f x - g x) ^ 2
      = (∑ x ∈ s, f x ^ 2) - 2 * (∑ x ∈ s, f x * g x) + (∑ x ∈ s, g x ^ 2) := by
  calc ∑ x ∈ s, (f x - g x) ^ 2
      = ∑ x ∈ s, (f x ^ 2 - 2 * (f x * g x) + g x ^ 2) :=
        Finset.sum_congr rfl (fun x _ => by ring)
    _ = (∑ x ∈ s, f x ^ 2) - 2 * (∑ x ∈ s, f x * g x) + (∑ x ∈ s, g x ^ 2) := by
        rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]

/-- `∑ (2f + g)² = 4∑f² + 4∑(fg) + ∑g²`. -/
lemma sum_sq_add {α : Type} (s : Finset α) (f g : α → ℂ) :
    ∑ x ∈ s, (2 * f x + g x) ^ 2
      = 4 * (∑ x ∈ s, f x ^ 2) + 4 * (∑ x ∈ s, f x * g x) + (∑ x ∈ s, g x ^ 2) := by
  calc ∑ x ∈ s, (2 * f x + g x) ^ 2
      = ∑ x ∈ s, (4 * f x ^ 2 + 4 * (f x * g x) + g x ^ 2) :=
        Finset.sum_congr rfl (fun x _ => by ring)
    _ = 4 * (∑ x ∈ s, f x ^ 2) + 4 * (∑ x ∈ s, f x * g x) + (∑ x ∈ s, g x ^ 2) := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]

/-- `∑ (f - g)(2f + g) = 2∑f² + ∑(fg) - 2∑(gf) - ∑g²`. -/
lemma sum_sub_mul_add {α : Type} (s : Finset α) (f g : α → ℂ) :
    ∑ x ∈ s, (f x - g x) * (2 * f x + g x)
      = 2 * (∑ x ∈ s, f x ^ 2) + (∑ x ∈ s, f x * g x) - 2 * (∑ x ∈ s, g x * f x)
        - (∑ x ∈ s, g x ^ 2) := by
  calc ∑ x ∈ s, (f x - g x) * (2 * f x + g x)
      = ∑ x ∈ s, (2 * f x ^ 2 + (f x * g x) - 2 * (g x * f x) - g x ^ 2) :=
        Finset.sum_congr rfl (fun x _ => by ring)
    _ = 2 * (∑ x ∈ s, f x ^ 2) + (∑ x ∈ s, f x * g x) - 2 * (∑ x ∈ s, g x * f x)
        - (∑ x ∈ s, g x ^ 2) := by
        rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, Finset.sum_add_distrib,
          ← Finset.mul_sum, ← Finset.mul_sum]

/-- Conjugate elements have the same order. -/
lemma orderOf_eq_of_isConj {G : Type} [Group G] {a b : G} (h : IsConj a b) :
    orderOf a = orderOf b := by
  obtain ⟨c, hc⟩ := h
  exact hc.orderOf_eq

theorem a7C1b : Work.A7REC.A7C1bProp := by
  intro G _ _ S z U V π σ hhyps hone hσU hσ1 hπS hπord hCπ
  haveI : Fintype G := Fintype.ofFinite G
  let ctx : A7RecCtx G := A7RecCtx.ofHyps hhyps
  obtain ⟨hsimple, hcard, hSdih, hzS, hz2', hzcen, hCz', hUcard', hUnorm', hVdef', hV4', hcross',
    hNUV', hNUcard'⟩ := hhyps
  -- ## 1. group-theoretic input
  have hz2 : orderOf z = 2 := ctx.hz2
  have hzsq : z * z = 1 := by
    have h := pow_orderOf_eq_one z
    rw [hz2, pow_two] at h
    exact h
  have hCzcard : Nat.card (Subgroup.centralizer ({z} : Set G)) = 24 :=
    Work.A7REC.Basic.card_centralizer_z G ctx
  have hCScard : Nat.card ↥(ctx.S : Subgroup G) = 8 := Work.A7REC.Basic.card_S G ctx
  obtain ⟨horder_w', hCwcard', hconj_w'⟩ := zsigma_structure ctx hσU hσ1
  have horder_w : orderOf (z * σ) = 6 := horder_w'
  have hCwcard : Nat.card (Subgroup.centralizer ({z * σ} : Set G)) = 12 := hCwcard'
  have hconj_w : IsConj (z * σ) (z * σ)⁻¹ := hconj_w'
  have hconj_π : IsConj π π⁻¹ :=
    (Work.A7REC.Char.c1bD8 S z π (trivialIrreducibleCharacter G) hSdih hzS hz2' hπS hπord
      (fun x hx => hone x z hx hz2')).2.1
  have hSsum : ∀ χ : IrreducibleCharacter G,
      ∑ s : ↥(ctx.S : Subgroup G), (χ : ClassFunction G ℂ) s
        = (χ : ClassFunction G ℂ) 1 + 5 * (χ : ClassFunction G ℂ) z
          + 2 * (χ : ClassFunction G ℂ) π := fun χ =>
    (Work.A7REC.Char.c1bD8 S z π χ hSdih hzS hz2' hπS hπord (fun x hx => hone x z hx hz2')).2.2
  -- ## 2. realness
  have hZreal : ∀ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) z = star ((χ : ClassFunction G ℂ) z) :=
    fun χ => real_apply_of_mul_self_eq_one χ hzsq
  have hWreal : ∀ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) (z * σ) = star ((χ : ClassFunction G ℂ) (z * σ)) :=
    fun χ => real_apply_of_isConj_inv χ hconj_w
  have hEreal : ∀ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) π = star ((χ : ClassFunction G ℂ) π) :=
    fun χ => real_apply_of_isConj_inv χ hconj_π
  have hone_real : ∀ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) 1 = star ((χ : ClassFunction G ℂ) 1) := by
    intro χ
    obtain ⟨d, -, hd, -⟩ :=
      IsIrreducibleCharacter.exists_natDegree_charValue_one_dvd_card χ.isIrreducible
    rw [hd, star_natCast]
  -- ## 3. column orthogonality sums
  have hnotconj : ∀ a b : G, orderOf a ≠ orderOf b → ¬ IsConj a b :=
    fun a b hab hconj => hab (orderOf_eq_of_isConj hconj)
  have hEE : ∑ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) π ^ 2 = 4 :=
    sum_apply_sq π hEreal (by rw [hCπ, Nat.card_zpowers, hπord])
  have hZZ : ∑ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) z ^ 2 = 24 :=
    sum_apply_sq z hZreal (by rw [hCzcard])
  have hWW : ∑ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) (z * σ) ^ 2 = 12 :=
    sum_apply_sq (z * σ) hWreal (by rw [hCwcard])
  have hEZ : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) z = 0 := by
    rw [sum_apply_mul_apply π z hZreal,
      if_neg (hnotconj π z (by rw [hπord, hz2]; norm_num))]
  have hEW : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) (z * σ) = 0 := by
    rw [sum_apply_mul_apply π (z * σ) hWreal,
      if_neg (hnotconj π (z * σ) (by rw [hπord, horder_w]; norm_num))]
  have hZW : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) (z * σ) = 0 := by
    rw [sum_apply_mul_apply z (z * σ) hWreal,
      if_neg (hnotconj z (z * σ) (by rw [hz2, horder_w]; norm_num))]
  have hE1 : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) 1 = 0 := by
    rw [sum_apply_mul_apply π 1 hone_real,
      if_neg (hnotconj π 1 (by rw [hπord, orderOf_one]; norm_num))]
  have hZ1 : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) 1 = 0 := by
    rw [sum_apply_mul_apply z 1 hone_real,
      if_neg (hnotconj z 1 (by rw [hz2, orderOf_one]; norm_num))]
  have hW1 : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) (z * σ) * (χ : ClassFunction G ℂ) 1 = 0 := by
    rw [sum_apply_mul_apply (z * σ) 1 hone_real,
      if_neg (hnotconj (z * σ) 1 (by rw [horder_w, orderOf_one]; norm_num))]
  -- ## 4. the indexing range and its enumeration
  let t : IrreducibleCharacter G := trivialIrreducibleCharacter G
  let R : Finset (IrreducibleCharacter G) :=
    (Finset.univ.erase t).filter (fun χ => (χ : ClassFunction G ℂ) π ≠ 0 ∨
      (χ : ClassFunction G ℂ) z ≠ 0 ∨ (χ : ClassFunction G ℂ) (z * σ) ≠ 0)
  let n : ℕ := Fintype.card ↥R
  let ι : Fin n → IrreducibleCharacter G := fun i => ((Fintype.equivFin ↥R).symm i).val
  have hι_inj : Function.Injective ι := by
    intro i j h
    exact (Fintype.equivFin ↥R).symm.injective (Subtype.ext h)
  have hι_img : Finset.univ.image ι = R := by
    ext χ
    rw [Finset.mem_image]
    constructor
    · rintro ⟨i, -, rfl⟩
      exact ((Fintype.equivFin ↥R).symm i).2
    · intro hχ
      exact ⟨(Fintype.equivFin ↥R) ⟨χ, hχ⟩, Finset.mem_univ _, by simp [ι]⟩
  have hrange : ∀ χ : IrreducibleCharacter G, χ ∈ Set.range ι ↔ χ ∈ R := by
    intro χ
    rw [Set.mem_range]
    constructor
    · rintro ⟨i, rfl⟩
      rw [← hι_img]
      exact Finset.mem_image_of_mem ι (Finset.mem_univ i)
    · intro hχ
      exact ⟨(Fintype.equivFin ↥R) ⟨χ, hχ⟩, by simp [ι]⟩
  have hRsub : R ⊆ Finset.univ.erase t := Finset.filter_subset _ _
  have hRmem : ∀ χ : IrreducibleCharacter G, χ ∈ R ↔ χ ≠ t ∧
      ((χ : ClassFunction G ℂ) π ≠ 0 ∨ (χ : ClassFunction G ℂ) z ≠ 0 ∨
        (χ : ClassFunction G ℂ) (z * σ) ≠ 0) := by
    intro χ
    simp only [R, Finset.mem_filter, Finset.mem_erase, Finset.mem_univ, and_true, true_and]
  have hvan : ∀ χ ∈ Finset.univ.erase t, χ ∉ R →
      (χ : ClassFunction G ℂ) π = 0 ∧ (χ : ClassFunction G ℂ) z = 0 ∧
        (χ : ClassFunction G ℂ) (z * σ) = 0 := by
    intro χ hχ hR
    have hχt : χ ≠ t := (Finset.mem_erase.mp hχ).1
    have hnot : ¬ ((χ : ClassFunction G ℂ) π ≠ 0 ∨ (χ : ClassFunction G ℂ) z ≠ 0 ∨
        (χ : ClassFunction G ℂ) (z * σ) ≠ 0) := fun hh => hR ((hRmem χ).mpr ⟨hχt, hh⟩)
    push_neg at hnot
    exact hnot
  -- ## 5. the integer-valued data
  have hdeg : ∀ χ : IrreducibleCharacter G,
      ∃ d : ℕ, 0 < d ∧ (χ : ClassFunction G ℂ) 1 = (d : ℂ) ∧ d ∣ Nat.card G :=
    fun χ => IsIrreducibleCharacter.exists_natDegree_charValue_one_dvd_card χ.isIrreducible
  let fF : IrreducibleCharacter G → ℕ := fun χ => Classical.choose (hdeg χ)
  have hfF : ∀ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) 1 = (fF χ : ℂ) :=
    fun χ => (Classical.choose_spec (hdeg χ)).2.1
  have hfF_dvd : ∀ χ : IrreducibleCharacter G, fF χ ∣ Nat.card G :=
    fun χ => (Classical.choose_spec (hdeg χ)).2.2
  have hfF_two : ∀ χ, χ ≠ t → 2 ≤ fF χ := by
    intro χ hχ
    obtain ⟨d, hd2, hd⟩ := Work.A7REC.Char.c1bDegree (G := G) ctx.simple ctx.hcard χ hχ
    have hdf : fF χ = d := Nat.cast_injective (by rw [← hfF χ, hd])
    omega
  have hπ_pow : ∀ k : ℕ, k.Coprime (Nat.card G) → π ^ k = π ∨ π ^ k = π⁻¹ := fun k hk =>
    pow_eq_self_or_inv_of_orderOf_eq_four hπord
      (not_even_of_coprime (by rw [ctx.hcard]; norm_num) hk)
  have hz_pow : ∀ k : ℕ, k.Coprime (Nat.card G) → z ^ k = z ∨ z ^ k = z⁻¹ := fun k hk =>
    Or.inl (pow_eq_self_of_orderOf_eq_two hz2
      (not_even_of_coprime (by rw [ctx.hcard]; norm_num) hk))
  have hw_pow : ∀ k : ℕ, k.Coprime (Nat.card G) → (z * σ) ^ k = z * σ ∨
      (z * σ) ^ k = (z * σ)⁻¹ := by
    intro k hk
    refine pow_eq_self_or_inv_of_orderOf_eq_six horder_w
      (not_even_of_coprime (by rw [ctx.hcard]; norm_num) hk) ?_
    intro h
    have hd : (3 : ℕ) ∣ k.gcd (Nat.card G) :=
      Nat.dvd_gcd h (by rw [ctx.hcard]; norm_num : 3 ∣ Nat.card G)
    rw [hk] at hd
    omega
  have heE : ∀ χ : IrreducibleCharacter G, ∃ m : ℤ, (χ : ClassFunction G ℂ) π = (m : ℂ) :=
    fun χ => exists_int_apply_of_pow_eq_self_or_inv χ hπ_pow (hEreal χ)
  let eF : IrreducibleCharacter G → ℤ := fun χ => Classical.choose (heE χ)
  have heF : ∀ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) π = (eF χ : ℂ) :=
    fun χ => Classical.choose_spec (heE χ)
  have hzE : ∀ χ : IrreducibleCharacter G, ∃ m : ℤ, (χ : ClassFunction G ℂ) z = (m : ℂ) :=
    fun χ => exists_int_apply_of_pow_eq_self_or_inv χ hz_pow (hZreal χ)
  let zF : IrreducibleCharacter G → ℤ := fun χ => Classical.choose (hzE χ)
  have hzF : ∀ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) z = (zF χ : ℂ) :=
    fun χ => Classical.choose_spec (hzE χ)
  have hwE : ∀ χ : IrreducibleCharacter G, ∃ m : ℤ, (χ : ClassFunction G ℂ) (z * σ) = (m : ℂ) :=
    fun χ => exists_int_apply_of_pow_eq_self_or_inv χ hw_pow (hWreal χ)
  let wF : IrreducibleCharacter G → ℤ := fun χ => Classical.choose (hwE χ)
  have hwF : ∀ χ : IrreducibleCharacter G, (χ : ClassFunction G ℂ) (z * σ) = (wF χ : ℂ) :=
    fun χ => Classical.choose_spec (hwE χ)
  -- the `a`/`b` integers
  have h3div : ∀ χ : IrreducibleCharacter G, (3 : ℤ) ∣ (zF χ + 2 * wF χ) := by
    intro χ
    obtain ⟨m, hm⟩ := three_dvd_char_sum ctx hσU hσ1 χ
    refine ⟨m, ?_⟩
    have : (((zF χ + 2 * wF χ : ℤ)) : ℂ) = ((3 * m : ℤ) : ℂ) := by
      push_cast
      rw [← hzF χ, ← hwF χ]
      exact hm
    exact_mod_cast this
  let cF : IrreducibleCharacter G → ℤ := fun χ => (zF χ + 2 * wF χ) / 3
  have hcF : ∀ χ : IrreducibleCharacter G, 3 * cF χ = zF χ + 2 * wF χ := by
    intro χ
    refine Int.mul_ediv_cancel' (h3div χ)  -- hmm
  let aF : IrreducibleCharacter G → ℤ := fun χ => wF χ - cF χ
  let bF : IrreducibleCharacter G → ℤ := fun χ => cF χ
  have hbF : ∀ χ : IrreducibleCharacter G, bF χ - 2 * aF χ = zF χ := by
    intro χ
    have h := hcF χ
    simp only [aF, bF]
    omega
  have haF : ∀ χ : IrreducibleCharacter G, aF χ + bF χ = wF χ := by
    intro χ
    simp [aF, bF]
  have hbF_val : ∀ χ : IrreducibleCharacter G,
      ((bF χ - 2 * aF χ : ℤ) : ℂ) = (χ : ClassFunction G ℂ) z := by
    intro χ
    rw [hbF χ, hzF χ]
  have haF_val : ∀ χ : IrreducibleCharacter G,
      ((aF χ + bF χ : ℤ) : ℂ) = (χ : ClassFunction G ℂ) (z * σ) := by
    intro χ
    rw [haF χ, hwF χ]
  -- the ℂ-level values of `aF`, `bF`
  have hcF_val : ∀ χ : IrreducibleCharacter G, (cF χ : ℂ) =
      ((χ : ClassFunction G ℂ) z + 2 * (χ : ClassFunction G ℂ) (z * σ)) / 3 := by
    intro χ
    have h : (3 : ℂ) * (cF χ : ℂ) = (χ : ClassFunction G ℂ) z + 2 * (χ : ClassFunction G ℂ) (z * σ) := by
      have h' : ((3 * cF χ : ℤ) : ℂ) = ((zF χ + 2 * wF χ : ℤ) : ℂ) := by rw [hcF χ]
      push_cast at h'
      rw [← hzF χ, ← hwF χ] at h'
      exact h'
    rw [eq_div_iff (by norm_num : (3 : ℂ) ≠ 0), mul_comm]
    exact h
  have haF_c : ∀ χ : IrreducibleCharacter G, ((aF χ : ℤ) : ℂ) =
      ((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3 := by
    intro χ
    have h1 : ((aF χ : ℤ) : ℂ) = (wF χ : ℂ) - (cF χ : ℂ) := by
      simp only [aF, Int.cast_sub]
    rw [h1, ← hwF χ, hcF_val χ]
    ring
  have hbF_c : ∀ χ : IrreducibleCharacter G, ((bF χ : ℤ) : ℂ) =
      (2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3 := by
    intro χ
    have h1 : ((bF χ : ℤ) : ℂ) = (cF χ : ℂ) := by simp [bF]
    rw [h1, hcF_val χ]
    ring
  -- ## 6. the total column sums (all irreducible characters)
  have hWZ : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) (z * σ) * (χ : ClassFunction G ℂ) z = 0 := by
    rw [← hZW]
    exact Finset.sum_congr rfl (fun χ _ => by ring)
  have hEZ' : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) π = 0 := by
    rw [← hEZ]
    exact Finset.sum_congr rfl (fun χ _ => by ring)
  have hEW' : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) (z * σ) * (χ : ClassFunction G ℂ) π = 0 := by
    rw [← hEW]
    exact Finset.sum_congr rfl (fun χ _ => by ring)
  have hZE : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) π = 0 := hEZ'
  have hWZ' : ∑ χ : IrreducibleCharacter G,
      (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) (z * σ) = 0 := hZW
  -- ## 7. the relations
  -- (A) `Σ e² = 3`
  have hA : ∑ i : Fin n, ((eF (ι i) : ℤ) : ℂ) ^ 2 = 3 := by
    have hcong : ∀ i : Fin n, ((eF (ι i) : ℤ) : ℂ) ^ 2 =
        ((ι i : ClassFunction G ℂ) π) ^ 2 := fun i => by rw [heF]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G => ((χ : ClassFunction G ℂ) π) ^ 2)
      (fun χ hχ hR => by rw [(hvan χ hχ hR).1]; ring)]
    rw [hEE]
    have ht : ((t : ClassFunction G ℂ) π) ^ 2 = 1 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply, one_pow]
    rw [ht]
    norm_num
  -- (B) `Σ a² = 4`
  have hB : ∑ i : Fin n, ((aF (ι i) : ℤ) : ℂ) ^ 2 = 4 := by
    have hcong : ∀ i : Fin n, ((aF (ι i) : ℤ) : ℂ) ^ 2 =
        (((ι i : ClassFunction G ℂ) (z * σ) - (ι i : ClassFunction G ℂ) z) / 3) ^ 2 :=
      fun i => by rw [haF_c]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) ^ 2)
      (fun χ hχ hR => by rw [(hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; norm_num)]
    have htot : ∑ χ : IrreducibleCharacter G,
        (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) ^ 2 = 4 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) ^ 2
          = (1 / 9) * ∑ χ : IrreducibleCharacter G,
              ((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) ^ 2 := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, sum_sq_sub, hWW, hWZ, hZZ]
      norm_num
    have ht : (((t : ClassFunction G ℂ) (z * σ) - (t : ClassFunction G ℂ) z) / 3) ^ 2 = 0 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht, sub_zero]
  -- (C) `Σ b² = 7`
  have hC : ∑ i : Fin n, ((bF (ι i) : ℤ) : ℂ) ^ 2 = 7 := by
    have hcong : ∀ i : Fin n, ((bF (ι i) : ℤ) : ℂ) ^ 2 =
        ((2 * (ι i : ClassFunction G ℂ) (z * σ) + (ι i : ClassFunction G ℂ) z) / 3) ^ 2 :=
      fun i => by rw [hbF_c]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) ^ 2)
      (fun χ hχ hR => by rw [(hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; norm_num)]
    have htot : ∑ χ : IrreducibleCharacter G,
        ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) ^ 2 = 8 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) ^ 2
          = (1 / 9) * ∑ χ : IrreducibleCharacter G,
              (2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) ^ 2 := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, sum_sq_add, hWW, hWZ, hZZ]
      norm_num
    have ht : ((2 * (t : ClassFunction G ℂ) (z * σ) + (t : ClassFunction G ℂ) z) / 3) ^ 2 = 1 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht]
    norm_num
  -- (D) `Σ e a = 0`
  have hD : ∑ i : Fin n, ((eF (ι i) : ℤ) : ℂ) * ((aF (ι i) : ℤ) : ℂ) = 0 := by
    have hcong : ∀ i : Fin n, ((eF (ι i) : ℤ) : ℂ) * ((aF (ι i) : ℤ) : ℂ) =
        ((ι i : ClassFunction G ℂ) π) *
          (((ι i : ClassFunction G ℂ) (z * σ) - (ι i : ClassFunction G ℂ) z) / 3) :=
      fun i => by rw [heF, haF_c]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        ((χ : ClassFunction G ℂ) π) *
          (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3))
      (fun χ hχ hR => by rw [(hvan χ hχ hR).1, (hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; ring)]
    have htot : ∑ χ : IrreducibleCharacter G,
        (χ : ClassFunction G ℂ) π *
          (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) = 0 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          (χ : ClassFunction G ℂ) π *
            (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3)
          = ∑ χ : IrreducibleCharacter G, (1 / 3) *
              ((χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) (z * σ)
                - (χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) z) :=
        Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, ← Finset.mul_sum, Finset.sum_sub_distrib, hEW, hEZ]
      norm_num
    have ht : (t : ClassFunction G ℂ) π *
        (((t : ClassFunction G ℂ) (z * σ) - (t : ClassFunction G ℂ) z) / 3) = 0 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht, sub_zero]
  -- (E) `Σ e b = -1`
  have hErel : ∑ i : Fin n, ((eF (ι i) : ℤ) : ℂ) * ((bF (ι i) : ℤ) : ℂ) = -1 := by
    have hcong : ∀ i : Fin n, ((eF (ι i) : ℤ) : ℂ) * ((bF (ι i) : ℤ) : ℂ) =
        ((ι i : ClassFunction G ℂ) π) *
          ((2 * (ι i : ClassFunction G ℂ) (z * σ) + (ι i : ClassFunction G ℂ) z) / 3) :=
      fun i => by rw [heF, hbF_c]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        ((χ : ClassFunction G ℂ) π) *
          ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3))
      (fun χ hχ hR => by rw [(hvan χ hχ hR).1, (hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; ring)]
    have htot : ∑ χ : IrreducibleCharacter G,
        (χ : ClassFunction G ℂ) π *
          ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) = 0 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          (χ : ClassFunction G ℂ) π *
            ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3)
          = ∑ χ : IrreducibleCharacter G, (1 / 3) *
              (2 * ((χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) (z * σ))
                + (χ : ClassFunction G ℂ) π * (χ : ClassFunction G ℂ) z) :=
        Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, ← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum, hEW, hEZ]
      norm_num
    have ht : (t : ClassFunction G ℂ) π *
        ((2 * (t : ClassFunction G ℂ) (z * σ) + (t : ClassFunction G ℂ) z) / 3) = 1 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht]
    norm_num
  -- (F) `Σ a b = 0`
  have hFrel : ∑ i : Fin n, ((aF (ι i) : ℤ) : ℂ) * ((bF (ι i) : ℤ) : ℂ) = 0 := by
    have hcong : ∀ i : Fin n, ((aF (ι i) : ℤ) : ℂ) * ((bF (ι i) : ℤ) : ℂ) =
        (((ι i : ClassFunction G ℂ) (z * σ) - (ι i : ClassFunction G ℂ) z) / 3) *
          ((2 * (ι i : ClassFunction G ℂ) (z * σ) + (ι i : ClassFunction G ℂ) z) / 3) :=
      fun i => by rw [haF_c, hbF_c]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) *
          ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3))
      (fun χ hχ hR => by rw [(hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; norm_num)]
    have htot : ∑ χ : IrreducibleCharacter G,
        (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) *
          ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) = 0 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) *
            ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3)
          = (1 / 9) * ∑ χ : IrreducibleCharacter G,
              ((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) *
                (2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, sum_sub_mul_add, hWW, hWZ, hZW, hZZ]
      norm_num
    have ht : (((t : ClassFunction G ℂ) (z * σ) - (t : ClassFunction G ℂ) z) / 3) *
        ((2 * (t : ClassFunction G ℂ) (z * σ) + (t : ClassFunction G ℂ) z) / 3) = 0 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht, sub_zero]
  -- (G) `1 + Σ e f = 0`
  have hG : ∑ i : Fin n, ((eF (ι i) : ℤ) : ℂ) * ((fF (ι i) : ℕ) : ℂ) = -1 := by
    have hcong : ∀ i : Fin n, ((eF (ι i) : ℤ) : ℂ) * ((fF (ι i) : ℕ) : ℂ) =
        ((ι i : ClassFunction G ℂ) π) * ((ι i : ClassFunction G ℂ) 1) :=
      fun i => by rw [heF, ← hfF]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        ((χ : ClassFunction G ℂ) π) * ((χ : ClassFunction G ℂ) 1))
      (fun χ hχ hR => by rw [(hvan χ hχ hR).1]; ring)]
    rw [hE1]
    have ht : ((t : ClassFunction G ℂ) π) * ((t : ClassFunction G ℂ) 1) = 1 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [ht]
    norm_num
  -- (H) `Σ a f = 0`
  have hH : ∑ i : Fin n, ((aF (ι i) : ℤ) : ℂ) * ((fF (ι i) : ℕ) : ℂ) = 0 := by
    have hcong : ∀ i : Fin n, ((aF (ι i) : ℤ) : ℂ) * ((fF (ι i) : ℕ) : ℂ) =
        (((ι i : ClassFunction G ℂ) (z * σ) - (ι i : ClassFunction G ℂ) z) / 3) *
          ((ι i : ClassFunction G ℂ) 1) := fun i => by rw [haF_c, ← hfF]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) *
          ((χ : ClassFunction G ℂ) 1))
      (fun χ hχ hR => by rw [(hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; ring)]
    have htot : ∑ χ : IrreducibleCharacter G,
        (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) *
          ((χ : ClassFunction G ℂ) 1) = 0 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          (((χ : ClassFunction G ℂ) (z * σ) - (χ : ClassFunction G ℂ) z) / 3) *
            ((χ : ClassFunction G ℂ) 1)
          = ∑ χ : IrreducibleCharacter G, (1 / 3) *
              ((χ : ClassFunction G ℂ) (z * σ) * (χ : ClassFunction G ℂ) 1
                - (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) 1) :=
        Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, ← Finset.mul_sum, Finset.sum_sub_distrib, hW1, hZ1]
      norm_num
    have ht : (((t : ClassFunction G ℂ) (z * σ) - (t : ClassFunction G ℂ) z) / 3) *
        ((t : ClassFunction G ℂ) 1) = 0 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht, sub_zero]
  -- (I) `1 + Σ b f = 0`
  have hI : ∑ i : Fin n, ((bF (ι i) : ℤ) : ℂ) * ((fF (ι i) : ℕ) : ℂ) = -1 := by
    have hcong : ∀ i : Fin n, ((bF (ι i) : ℤ) : ℂ) * ((fF (ι i) : ℕ) : ℂ) =
        ((2 * (ι i : ClassFunction G ℂ) (z * σ) + (ι i : ClassFunction G ℂ) z) / 3) *
          ((ι i : ClassFunction G ℂ) 1) := fun i => by rw [hbF_c, ← hfF]
    rw [Finset.sum_congr rfl (fun i _ => hcong i)]
    rw [sum_indexed_eq_sub hι_inj hι_img hRsub
      (fun χ : IrreducibleCharacter G =>
        ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) *
          ((χ : ClassFunction G ℂ) 1))
      (fun χ hχ hR => by rw [(hvan χ hχ hR).2.1, (hvan χ hχ hR).2.2]; ring)]
    have htot : ∑ χ : IrreducibleCharacter G,
        ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) *
          ((χ : ClassFunction G ℂ) 1) = 0 := by
      have h1 : ∑ χ : IrreducibleCharacter G,
          ((2 * (χ : ClassFunction G ℂ) (z * σ) + (χ : ClassFunction G ℂ) z) / 3) *
            ((χ : ClassFunction G ℂ) 1)
          = ∑ χ : IrreducibleCharacter G, (1 / 3) *
              (2 * ((χ : ClassFunction G ℂ) (z * σ) * (χ : ClassFunction G ℂ) 1)
                + (χ : ClassFunction G ℂ) z * (χ : ClassFunction G ℂ) 1) :=
        Finset.sum_congr rfl (fun χ _ => by ring)
      rw [h1, ← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum, hW1, hZ1]
      norm_num
    have ht : ((2 * (t : ClassFunction G ℂ) (z * σ) + (t : ClassFunction G ℂ) z) / 3) *
        ((t : ClassFunction G ℂ) 1) = 1 := by
      rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
        trivialClassFunction_apply]
      norm_num
    rw [htot, ht]
    norm_num
  -- ## 8. the remaining numerical inputs
  -- degree facts
  have hfF_two' : ∀ i : Fin n, 2 ≤ fF (ι i) := by
    intro i
    refine hfF_two (ι i) ?_
    have h : ι i ∈ R := by
      rw [← hι_img]
      exact Finset.mem_image_of_mem ι (Finset.mem_univ i)
    exact (Finset.mem_erase.mp (hRsub h)).1
  have hfF_dvd' : ∀ i : Fin n, (fF (ι i) : ℤ) ∣ 2520 := by
    intro i
    have h := hfF_dvd (ι i)
    rw [ctx.hcard] at h
    exact_mod_cast h
  -- `(e, a, b) ≠ 0`
  have hne0 : ∀ i : Fin n, eF (ι i) ≠ 0 ∨ aF (ι i) ≠ 0 ∨ bF (ι i) ≠ 0 := by
    intro i
    have hmem : ι i ∈ R := by
      rw [← hι_img]
      exact Finset.mem_image_of_mem ι (Finset.mem_univ i)
    obtain ⟨-, hdisj⟩ := (hRmem (ι i)).mp hmem
    by_contra hcon
    push_neg at hcon
    obtain ⟨he, ha, hb⟩ := hcon
    rcases hdisj with h | h | h
    · exact h (by rw [heF (ι i), he]; norm_num)
    · exact h (by
        have h1 : zF (ι i) = bF (ι i) - 2 * aF (ι i) := (hbF (ι i)).symm
        rw [hzF (ι i), h1, ha, hb]; norm_num)
    · exact h (by rw [hwF (ι i), ← haF (ι i), ha, hb]; norm_num)
  -- the congruence
  have hcong8 : ∀ i : Fin n,
      ((fF (ι i) : ℤ) + 5 * (bF (ι i) - 2 * aF (ι i)) + 2 * eF (ι i)) % 8 = 0 := by
    intro i
    have hmem : ι i ∈ R := by
      rw [← hι_img]
      exact Finset.mem_image_of_mem ι (Finset.mem_univ i)
    obtain ⟨hne_t, -⟩ := (hRmem (ι i)).mp hmem
    obtain ⟨m, hm⟩ := Work.A7REC.Char.c1bSumSubgroup (H := (ctx.S : Subgroup G)) (χ := ι i)
    rw [hCScard] at hm
    have hval : (ι i : ClassFunction G ℂ) 1 + 5 * (ι i : ClassFunction G ℂ) z
        + 2 * (ι i : ClassFunction G ℂ) π = ((8 : ℕ) : ℂ) * (m : ℂ) := by
      rw [← hSsum (ι i), hm]
    have hx : ((fF (ι i) : ℤ) : ℂ) = (ι i : ClassFunction G ℂ) 1 := by
      rw [Int.cast_natCast, ← hfF (ι i)]
    have hy : (((bF (ι i) - 2 * aF (ι i) : ℤ)) : ℂ) = (ι i : ClassFunction G ℂ) z :=
      hbF_val (ι i)
    have hz2 : ((eF (ι i) : ℤ) : ℂ) = (ι i : ClassFunction G ℂ) π := by rw [heF (ι i)]
    have hval3 : ((fF (ι i) : ℤ) : ℂ) + 5 * (((bF (ι i) - 2 * aF (ι i) : ℤ)) : ℂ)
        + 2 * ((eF (ι i) : ℤ) : ℂ) = ((8 : ℤ) : ℂ) * (m : ℂ) := by
      rw [hx, hy, hz2]
      rw [hval]
      push_cast
      ring
    have hZ : (fF (ι i) : ℤ) + 5 * (bF (ι i) - 2 * aF (ι i)) + 2 * eF (ι i)
        = 8 * (m : ℤ) := by
      refine Int.cast_injective (α := ℂ) ?_
      rw [show (((fF (ι i) : ℤ) + 5 * (bF (ι i) - 2 * aF (ι i)) + 2 * eF (ι i) : ℤ) : ℂ)
          = ((fF (ι i) : ℤ) : ℂ) + 5 * (((bF (ι i) - 2 * aF (ι i) : ℤ)) : ℂ)
              + 2 * ((eF (ι i) : ℤ) : ℂ) from by push_cast; ring,
        hval3]
      push_cast
      ring
    rw [hZ]
    exact Int.emod_eq_zero_of_dvd (dvd_mul_right 8 (m : ℤ))
  -- the degree-sum bound
  have hfSq : ∑ i : Fin n, (fF (ι i)) ^ 2 ≤ 2519 := by
    have htot : (∑ χ : IrreducibleCharacter G, (fF χ) ^ 2) = 2520 := by
      have h2 : (((∑ χ : IrreducibleCharacter G, (fF χ) ^ 2 : ℕ)) : ℂ) = (2520 : ℂ) := by
        push_cast
        rw [show (∑ χ : IrreducibleCharacter G, ((fF χ : ℂ)) ^ 2)
            = ∑ χ : IrreducibleCharacter G, (((χ : ClassFunction G ℂ) 1)) ^ 2 from
          Finset.sum_congr rfl (fun χ _ => by rw [← hfF χ])]
        rw [sumIrreducibleDegreeSq, ctx.hcard]
        norm_num
      exact_mod_cast h2
    have htsq : (fF t) ^ 2 = 1 := by
      have h1 : (t : ClassFunction G ℂ) 1 = 1 := by
        rw [show (t : ClassFunction G ℂ) = trivialClassFunction G from rfl,
          trivialClassFunction_apply]
      have h2 : fF t = 1 := by
        refine Nat.cast_injective (R := ℂ) ?_
        rw [← hfF t, h1]
        norm_num
      rw [h2]
      norm_num
    have hmix := Finset.sum_filter_add_sum_filter_not
      (s := (Finset.univ : Finset (IrreducibleCharacter G)))
      (p := fun χ => χ ∈ R) (f := fun χ => (fF χ) ^ 2)
    have htmem : t ∈ Finset.univ.filter (fun χ : IrreducibleCharacter G => χ ∉ R) := by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      intro hR
      exact (Finset.mem_erase.mp (hRsub hR)).1 rfl
    have hle := Finset.single_le_sum (f := fun χ : IrreducibleCharacter G => (fF χ) ^ 2)
      (fun x _ => Nat.zero_le _) htmem
    have hs : ∑ i : Fin n, (fF (ι i)) ^ 2
        = ∑ χ ∈ Finset.univ.filter (fun χ : IrreducibleCharacter G => χ ∈ R), (fF χ) ^ 2 := by
      rw [sum_image_eq_sum_finset hι_inj hι_img (fun χ : IrreducibleCharacter G => (fF χ) ^ 2)]
      congr 1
      ext χ
      simp
    have key : (∑ χ ∈ Finset.univ.filter (fun χ : IrreducibleCharacter G => χ ∈ R), (fF χ) ^ 2)
        ≤ 2519 := by
      have h1 : (∑ χ ∈ Finset.univ.filter (fun χ : IrreducibleCharacter G => χ ∉ R),
          (fF χ) ^ 2) ≥ 1 := by
        rw [← htsq]
        exact hle
      omega
    rw [hs]
    exact key
  -- ## 9. the final assembly
  refine ⟨n, ι, fun i => fF (ι i), fun i => eF (ι i), fun i => aF (ι i), fun i => bF (ι i),
    hι_inj, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `ι i ≠ 1`
    intro i
    have h : ι i ∈ R := by
      rw [← hι_img]
      exact Finset.mem_image_of_mem ι (Finset.mem_univ i)
    exact (Finset.mem_erase.mp (hRsub h)).1
  · -- off-range vanishing
    intro χ hχt hχr
    have hχR : χ ∉ R := fun hR => hχr ((hrange χ).mpr hR)
    exact (hvan χ (Finset.mem_erase.mpr ⟨hχt, Finset.mem_univ χ⟩) hχR).2.1
  · -- degrees
    intro i
    exact hfF (ι i)
  · -- `π`-values
    intro i
    exact heF (ι i)
  · -- `z`-values
    intro i
    exact (hbF_val (ι i)).symm
  · -- `z σ`-values
    intro i
    exact (haF_val (ι i)).symm
  · exact hne0
  · exact hfF_two'
  · exact hfF_dvd'
  · -- `Σ e² = 3`
    refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hA
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hB
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hC
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hD
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hErel
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hFrel
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    rw [hG]
    norm_num
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    exact hH
  · refine Int.cast_injective (α := ℂ) ?_
    push_cast
    rw [hI]
    norm_num
  · exact hcong8
  · show 1 + (∑ i : Fin n, (fF (ι i)) ^ 2) ≤ 2520
    omega



end Work.A7REC.Char
