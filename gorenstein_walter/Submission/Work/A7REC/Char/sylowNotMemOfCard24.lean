import Mathlib
import Submission.Work.A7REC.Join.card_sup_of_le_normalizer_of_disjoint

namespace Work.A7REC.Char

set_option linter.style.haveILetI false in
/-- Let `H` be a finite group of order `24` possessing a normal subgroup `V₀` of order `4`
and an involution `z₀ ∉ V₀`, and suppose every normal `2`-subgroup of `H` has order at most `4`.

Then some Sylow `2`-subgroup of `H` does not contain `z₀`.

Indeed, `V₀` is a normal `2`-subgroup, so it is contained in *every* Sylow `2`-subgroup. If all
Sylow `2`-subgroups also contained `z₀`, then every one of them would contain the subgroup
`K := V₀ ⊔ ⟨z₀⟩`, which has order `|V₀| · |⟨z₀⟩| = 4 · 2 = 8` because `V₀ ∩ ⟨z₀⟩ = ⊥` (as
`z₀ ∉ V₀` and `z₀² = 1`) and `V₀` is normal. Since a Sylow `2`-subgroup of `H` has order
`2 ^ factorisation 24 2 = 8`, it would then equal `K`; so there is a unique Sylow `2`-subgroup,
which is therefore normal, of order `8` — contradicting the bound on normal `2`-subgroups. -/
theorem sylowNotMemOfCard24 {H : Type*} [Group H] [Finite H] (V₀ : Subgroup H)
    (z₀ : H) (hcard : Nat.card H = 24) (hV₀card : Nat.card V₀ = 4) (hV₀norm : V₀.Normal)
    (hz₀sq : z₀ * z₀ = 1) (hz₀ : z₀ ∉ V₀)
    (hmax : ∀ N : Subgroup H, N.Normal → IsPGroup 2 N → Nat.card N ≤ 4) :
    ∃ P : Sylow 2 H, z₀ ∉ P := by
  classical
  -- Argue by contradiction: suppose every Sylow `2`-subgroup contains `z₀`.
  by_contra hcon
  have hcon' : ∀ P : Sylow 2 H, z₀ ∈ (P : Subgroup H) := by
    intro P
    by_contra hz
    exact hcon ⟨P, hz⟩
  haveI : Fact (Nat.Prime 2) := ⟨by norm_num⟩
  haveI := hV₀norm
  -- `V₀` is a `2`-group, hence (being normal) contained in every Sylow `2`-subgroup.
  have hV₀p : IsPGroup 2 V₀ := IsPGroup.of_card (n := 2) (by rw [hV₀card]; norm_num)
  have hV₀_le : ∀ Q : Sylow 2 H, V₀ ≤ (Q : Subgroup H) :=
    fun Q => IsPGroup.le_sylow_of_normal hV₀p Q
  -- The subgroup generated by `V₀` and `z₀`.
  set K : Subgroup H := V₀ ⊔ Subgroup.zpowers z₀ with hK
  -- It is contained in every Sylow `2`-subgroup.
  have hK_le : ∀ Q : Sylow 2 H, K ≤ (Q : Subgroup H) := by
    intro Q
    rw [hK]
    exact sup_le (hV₀_le Q) (Subgroup.zpowers_le.mpr (hcon' Q))
  -- `z₀` has order `2`.
  have hz₀_ne : z₀ ≠ 1 := fun h => hz₀ (h ▸ V₀.one_mem)
  have hord : orderOf z₀ = 2 :=
    orderOf_eq_prime (p := 2) (by rw [pow_two]; exact hz₀sq) hz₀_ne
  -- `V₀` and `⟨z₀⟩` intersect trivially.
  have hdisj : Disjoint V₀ (Subgroup.zpowers z₀) := by
    rw [disjoint_iff, eq_bot_iff]
    intro x hx
    rw [Subgroup.mem_inf] at hx
    obtain ⟨hxV, hxZ⟩ := hx
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hxZ
    rw [Subgroup.mem_bot, ← hk]
    rcases Int.even_or_odd k with ⟨m, hm⟩ | ⟨m, hm⟩
    · rw [hm, show m + m = 2 * m by ring, zpow_mul, zpow_two, hz₀sq, one_zpow]
    · exfalso
      have hz : z₀ ^ k = z₀ := by
        rw [hm, zpow_add, zpow_one, zpow_mul, zpow_two, hz₀sq, one_zpow, one_mul]
      exact hz₀ ((show x = z₀ by rw [← hk, hz]) ▸ hxV)
  -- `⟨z₀⟩` lies in the normalizer of `V₀` since `V₀` is normal.
  have hnorm : Subgroup.zpowers z₀ ≤ Subgroup.normalizer (V₀ : Set H) := by
    rw [Subgroup.normalizer_eq_top]; exact le_top
  -- Hence `|K| = |V₀| · |⟨z₀⟩| = 4 · 2 = 8`.
  have hKcard : Nat.card K = 8 := by
    rw [hK, Work.A7REC.Join.card_sup_of_le_normalizer_of_disjoint hnorm hdisj, hV₀card,
      Nat.card_zpowers, hord]
  -- Every Sylow `2`-subgroup of `H` has order `8 = 2 ^ factorisation 24 2`.
  have hPcard : ∀ Q : Sylow 2 H, Nat.card (Q : Subgroup H) = 8 := by
    intro Q
    rw [Sylow.card_eq_multiplicity Q, hcard]
    norm_num [Nat.factorization]
  -- So every Sylow `2`-subgroup equals `K`, i.e. there is only one of them.
  haveI : Subsingleton (Sylow 2 H) := ⟨fun P Q => Sylow.ext (by
    have hP : (P : Subgroup H) = K :=
      (Subgroup.eq_of_le_of_card_ge (hK_le P) (by rw [hPcard P, hKcard])).symm
    have hQ : (Q : Subgroup H) = K :=
      (Subgroup.eq_of_le_of_card_ge (hK_le Q) (by rw [hPcard Q, hKcard])).symm
    rw [hP, hQ])⟩
  -- A unique Sylow `2`-subgroup is normal, of order `8`, contradicting `hmax`.
  obtain ⟨P₀⟩ := Sylow.nonempty (p := 2) (G := H)
  have hnormP₀ : (P₀ : Subgroup H).Normal := Sylow.normal_of_subsingleton P₀
  have hle := hmax (P₀ : Subgroup H) hnormP₀ P₀.isPGroup'
  rw [hPcard P₀] at hle
  norm_num at hle

end Work.A7REC.Char
