/-
Area `A7REC`, file `Char/a7FixedVector.lean`: leaf **C3a** of the design-pass-8 contract
(`Submission/Work/_design_gw/Core8.lean` §1) — the fixed vector of `U` and `S'`.

Given the degree-`6` representation `ρ` of `C1` (trace `2` at `z`, trace `3` on `U#`) and the
Suzuki configuration `ExclHyps U S' τ`, there is a nonzero vector of `W` fixed by `U` and by `S'`.
The proof is dimension counting in `W` (`dim W = 6`):

* `dim Fix(τ) = (6 + 2)/2 = 4`: `τ` is an involution, and the one-class hypothesis gives
  `trace (ρ τ) = trace (ρ z) = 2`;
* `dim (Fix(U) ⊓ Fix(τ)) = 3`: with `u` a generator of `U ≅ C₃` (so `τ u τ = u⁻¹`), the averaging
  operator `(1/6)(1 + ρ τ)(1 + ρ u + ρ u²)` is the projection onto `Fix(U) ⊓ Fix(τ)`, and its trace
  is `(6 + 2·3 + 3·2)/6 = 3`;
* `dim Fix(S') ≥ 2`: `|S'| = 8` is the `2`-part of `|G| = 2520`, so `S'` is a Sylow `2`-subgroup and
  `S' ≅ D₈`; `D₈ = ⟨sr 0, sr 1⟩` is generated by two involutions `f`, `b`, and
  `dim Fix(f) = dim Fix(b) = (6+2)/2 = 4`, whence `dim (Fix(f) ⊓ Fix(b)) ≥ 4 + 4 - 6 = 2`.

All three spaces are subspaces of `Fix(τ)` (dimension `4`) and `3 + 2 > 4`, so the intersection is
nonzero; a vector in it is fixed by `U` and by `S'`.
-/
import Mathlib
import Submission.Work.A7REC.Excl

namespace Work.A7REC.Char

open Subgroup

variable {G : Type*} [Group G]
variable {W : Type*} [AddCommGroup W] [Module ℂ W]

/-! ## 1. Fixed spaces of an element and of a subgroup -/

/-- The `1`-eigenspace of a single group element. -/
def FixOne (ρ : Representation ℂ G W) (g : G) : Submodule ℂ W := LinearMap.ker (ρ g - 1)

theorem mem_FixOne {ρ : Representation ℂ G W} {g : G} {x : W} :
    x ∈ FixOne ρ g ↔ ρ g x = x := by
  rw [FixOne, LinearMap.mem_ker]
  simp only [LinearMap.sub_apply, Module.End.one_eq_id, LinearMap.id_apply, sub_eq_zero]

/-- The common fixed space of a subgroup. -/
def FixS (ρ : Representation ℂ G W) (H : Subgroup G) : Submodule ℂ W where
  carrier := {x | ∀ g ∈ H, ρ g x = x}
  zero_mem' := by intro g _; simp
  add_mem' := by intro x y hx hy g hg; simp [map_add, hx g hg, hy g hg]
  smul_mem' := by intro a x hx g hg; simp [hx g hg]

theorem mem_FixS {ρ : Representation ℂ G W} {H : Subgroup G} {x : W} :
    x ∈ FixS ρ H ↔ ∀ g ∈ H, ρ g x = x := Iff.rfl

/-- The subgroup of elements of `G` fixing a given vector. -/
def fixerSub (ρ : Representation ℂ G W) (x : W) : Subgroup G where
  carrier := {g | ρ g x = x}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    have h : ρ a (ρ b x) = x := by rw [hb, ha]
    simpa [map_mul] using h
  inv_mem' := by
    intro a ha
    have h : ρ a⁻¹ (ρ a x) = x := by
      show (ρ a⁻¹ * ρ a) x = x
      rw [← map_mul, inv_mul_cancel, map_one]
      simp
    rwa [ha] at h

theorem mem_fixerSub {ρ : Representation ℂ G W} {x : W} {g : G} :
    g ∈ fixerSub ρ x ↔ ρ g x = x := Iff.rfl

/-- A group element of order `2` is its own inverse. -/
theorem mul_self_eq_one_of_orderOf_eq_two {G : Type*} [Group G] {W : Type*} [AddCommGroup W]
    [Module ℂ W] (ρ : Representation ℂ G W) {g : G} (hg : orderOf g = 2) : ρ g * ρ g = 1 := by
  have h : g * g = 1 := by
    have h := pow_orderOf_eq_one g
    rwa [hg, pow_two] at h
  rw [← map_mul, h, map_one]

/-- An element whose square is `1` and which is not `1` has order `2`. -/
theorem orderOf_eq_two_of_sq_eq_one {G : Type*} [Group G] {x : G} (h1 : x ≠ 1)
    (h2 : x ^ 2 = 1) : orderOf x = 2 := by
  have hd : orderOf x ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr h2
  have hne : orderOf x ≠ 1 := fun h => h1 (orderOf_eq_one_iff.mp h)
  rcases (Nat.dvd_prime (by norm_num : Nat.Prime 2)).mp hd with h | h
  · exact absurd h hne
  · exact h

/-! ## 2. Two elementary linear-algebra facts -/

/-- For an involution `T`, `(1/2)(1 + T)` is the projection onto the `1`-eigenspace of `T`. -/
theorem isProj_half_one_add {V : Type*} [AddCommGroup V] [Module ℂ V]
    (T : V →ₗ[ℂ] V) (hT : T * T = 1) :
    LinearMap.IsProj (LinearMap.ker (T - 1)) (((1/2 : ℂ) • (LinearMap.id + T) : V →ₗ[ℂ] V)) := by
  constructor
  · intro x
    rw [LinearMap.mem_ker]
    have h1 : T (T x) = x := by
      have h := LinearMap.congr_fun hT x; simpa using h
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.add_apply, map_add,
      map_smul, h1, Module.End.one_eq_id, LinearMap.id_apply]
    module
  · intro x hx
    rw [LinearMap.mem_ker] at hx
    have hx' : T x = x := by
      have h := hx
      rw [LinearMap.sub_apply, Module.End.one_eq_id, LinearMap.id_apply, sub_eq_zero] at h
      exact h
    simp only [LinearMap.smul_apply, LinearMap.add_apply, LinearMap.id_apply, hx']
    module

/-- The `1`-eigenspace of an involution of a `6`-dimensional space with trace `2` has
dimension `4`. -/
theorem finrank_fixOne_of_involution {V : Type*} [AddCommGroup V] [Module ℂ V]
    [FiniteDimensional ℂ V] (T : V →ₗ[ℂ] V) (hT : T * T = 1)
    (h6 : Module.finrank ℂ V = 6) (htr : LinearMap.trace ℂ V T = 2) :
    Module.finrank ℂ ↥(LinearMap.ker (T - 1)) = 4 := by
  have hproj := isProj_half_one_add T hT
  have h1 : LinearMap.trace ℂ V (((1/2 : ℂ) • (LinearMap.id + T) : V →ₗ[ℂ] V))
      = (Module.finrank ℂ ↥(LinearMap.ker (T - 1)) : ℂ) := hproj.trace
  have h2 : LinearMap.trace ℂ V (((1/2 : ℂ) • (LinearMap.id + T) : V →ₗ[ℂ] V)) = 4 := by
    rw [map_smul, map_add, LinearMap.trace_id, htr, h6]
    norm_num [smul_eq_mul]
  rw [h2] at h1
  exact_mod_cast h1.symm

/-- If `X` has order `3`, `Y` is an involution with `Y X Y = X²`, and the traces on `V` are those
of `3·triv ⊕ sign ⊕ standard` (the `S₃`-module structure), then the common fixed space of `X` and
`Y` has dimension `3`. -/
theorem finrank_pair_ker {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (X Y : V →ₗ[ℂ] V) (hX : X ^ 3 = 1) (hY : Y ^ 2 = 1) (hXY : Y * X * Y = X ^ 2)
    (h6 : Module.finrank ℂ V = 6)
    (htX : LinearMap.trace ℂ V X = 3) (htX2 : LinearMap.trace ℂ V (X ^ 2) = 3)
    (htY : LinearMap.trace ℂ V Y = 2) (htYX : LinearMap.trace ℂ V (Y * X) = 2)
    (htYX2 : LinearMap.trace ℂ V (Y * X ^ 2) = 2) :
    Module.finrank ℂ ↥(LinearMap.ker (X - 1) ⊓ LinearMap.ker (Y - 1)) = 3 := by
  set A : V →ₗ[ℂ] V := 1 + X + X ^ 2 with hA
  set P : V →ₗ[ℂ] V := (1/6 : ℂ) • ((1 + Y) * A) with hP
  have hXY' : X * Y = Y * X ^ 2 := by
    have h : Y * (Y * X * Y) = Y * X ^ 2 := by rw [hXY]
    calc X * Y = (Y * Y) * (X * Y) := by rw [← pow_two, hY, one_mul]
      _ = Y * (Y * (X * Y)) := by rw [mul_assoc]
      _ = Y * (Y * X * Y) := by rw [mul_assoc]
      _ = Y * X ^ 2 := h
  have hXA : X * A = A := by
    rw [hA]
    calc X * (1 + X + X ^ 2) = X * 1 + X * X + X * X ^ 2 := by rw [mul_add, mul_add]
      _ = X + X ^ 2 + X ^ 3 := by rw [mul_one, ← pow_two, ← pow_succ']
      _ = X + X ^ 2 + 1 := by rw [hX]
      _ = 1 + X + X ^ 2 := by abel
  have hX2A : X ^ 2 * A = A := by rw [pow_two, mul_assoc, hXA, hXA]
  have hXB : X * (1 + Y) = X + Y * X ^ 2 := by rw [mul_add, mul_one, hXY']
  have hYB : Y * (1 + Y) = 1 + Y := by rw [mul_add, mul_one, ← pow_two, hY, add_comm]
  have hXP : X * ((1 + Y) * A) = (1 + Y) * A := by
    calc X * ((1 + Y) * A) = (X * (1 + Y)) * A := by rw [← mul_assoc]
      _ = (X + Y * X ^ 2) * A := by rw [hXB]
      _ = X * A + Y * X ^ 2 * A := by rw [add_mul]
      _ = A + Y * A := by rw [hXA, mul_assoc, hX2A]
      _ = (1 + Y) * A := by rw [add_mul, one_mul]
  have hYP : Y * ((1 + Y) * A) = (1 + Y) * A := by
    calc Y * ((1 + Y) * A) = (Y * (1 + Y)) * A := by rw [← mul_assoc]
      _ = (1 + Y) * A := by rw [hYB]
  have hIsProj : LinearMap.IsProj (LinearMap.ker (X - 1) ⊓ LinearMap.ker (Y - 1)) P := by
    constructor
    · intro x
      rw [Submodule.mem_inf, LinearMap.mem_ker, LinearMap.mem_ker]
      have hxX : X (((1 + Y) * A) x) = ((1 + Y) * A) x :=
        congrArg (fun f : V →ₗ[ℂ] V => f x) hXP
      have hxY : Y (((1 + Y) * A) x) = ((1 + Y) * A) x :=
        congrArg (fun f : V →ₗ[ℂ] V => f x) hYP
      have hXPx : X (P x) = P x := by
        simp only [hP, LinearMap.smul_apply, map_smul, hxX]
      have hYPx : Y (P x) = P x := by
        simp only [hP, LinearMap.smul_apply, map_smul, hxY]
      constructor
      · rw [LinearMap.sub_apply, Module.End.one_eq_id, LinearMap.id_apply, sub_eq_zero]
        exact hXPx
      · rw [LinearMap.sub_apply, Module.End.one_eq_id, LinearMap.id_apply, sub_eq_zero]
        exact hYPx
    · intro x hx
      rw [Submodule.mem_inf, LinearMap.mem_ker, LinearMap.mem_ker] at hx
      have hxX : X x = x := by
        have h := hx.1
        rw [LinearMap.sub_apply, Module.End.one_eq_id, LinearMap.id_apply, sub_eq_zero] at h
        exact h
      have hxY : Y x = x := by
        have h := hx.2
        rw [LinearMap.sub_apply, Module.End.one_eq_id, LinearMap.id_apply, sub_eq_zero] at h
        exact h
      have hX2x : (X ^ 2) x = x := by rw [pow_two]; simp [hxX]
      have hAx : A x = (3 : ℂ) • x := by
        rw [hA]
        simp only [LinearMap.add_apply, hxX, hX2x]
        module
      have hYA : (1 + Y : V →ₗ[ℂ] V) (A x) = (6 : ℂ) • x := by
        have h1 : (1 + Y : V →ₗ[ℂ] V) (A x) = A x + Y (A x) := by simp
        have h2 : Y ((3 : ℂ) • x) = (3 : ℂ) • x := by rw [map_smul, hxY]
        rw [h1, hAx, h2]
        module
      rw [hP, LinearMap.smul_apply]
      have h1 : ((1 + Y) * A) x = (1 + Y) (A x) := by simp
      rw [h1, hYA]
      module
  have htrP : LinearMap.trace ℂ V P
      = (Module.finrank ℂ ↥(LinearMap.ker (X - 1) ⊓ LinearMap.ker (Y - 1)) : ℂ) :=
    hIsProj.trace
  have hexp : (1 + Y) * A = 1 + X + X ^ 2 + Y + Y * X + Y * X ^ 2 := by
    rw [hA]
    noncomm_ring
  have hval : LinearMap.trace ℂ V P = 3 := by
    rw [hP, map_smul, hexp]
    rw [map_add, map_add, map_add, map_add, map_add]
    rw [Module.End.one_eq_id, LinearMap.trace_id, h6, htX, htX2, htY, htYX, htYX2]
    norm_num [smul_eq_mul]
  rw [hval] at htrP
  exact_mod_cast htrP.symm

/-! ## 3. The dihedral group of order `8` -/

/-- `D₈` is generated by its two "adjacent" reflections `sr 0` and `sr 1`. -/
theorem closure_sr_zero_sr_one :
    Subgroup.closure ({DihedralGroup.sr (0 : ZMod 4), DihedralGroup.sr (1 : ZMod 4)} :
      Set (DihedralGroup 4)) = ⊤ := by
  apply eq_top_iff.mpr
  intro g _
  have h0 : DihedralGroup.sr (0 : ZMod 4) ∈
      Subgroup.closure ({DihedralGroup.sr (0 : ZMod 4), DihedralGroup.sr (1 : ZMod 4)} :
        Set (DihedralGroup 4)) := Subgroup.subset_closure (by simp)
  have h1 : DihedralGroup.sr (1 : ZMod 4) ∈
      Subgroup.closure ({DihedralGroup.sr (0 : ZMod 4), DihedralGroup.sr (1 : ZMod 4)} :
        Set (DihedralGroup 4)) := Subgroup.subset_closure (by simp)
  have hr : DihedralGroup.r (1 : ZMod 4) ∈
      Subgroup.closure ({DihedralGroup.sr (0 : ZMod 4), DihedralGroup.sr (1 : ZMod 4)} :
        Set (DihedralGroup 4)) := by
    have h := Subgroup.mul_mem _ h0 h1
    simpa using h
  have hrpow : ∀ i : ZMod 4, DihedralGroup.r i ∈
      Subgroup.closure ({DihedralGroup.sr (0 : ZMod 4), DihedralGroup.sr (1 : ZMod 4)} :
        Set (DihedralGroup 4)) := by
    intro i
    have h : DihedralGroup.r i = DihedralGroup.r (1 : ZMod 4) ^ ((i.val : ℤ)) := by
      rw [DihedralGroup.r_one_zpow]
      congr 1
      exact (ZMod.natCast_zmod_val i).symm
    rw [h]
    exact Subgroup.zpow_mem _ hr _
  rcases g with i | i
  · exact hrpow i
  · have h : DihedralGroup.sr i = DihedralGroup.sr (0 : ZMod 4) * DihedralGroup.r i := by
      rw [DihedralGroup.sr_mul_r]
      simp
    rw [h]
    exact Subgroup.mul_mem _ h0 (hrpow i)

/-- A subgroup of order `8` of a group of order `2520` whose Sylow `2`-subgroups are dihedral of
order `8` is itself isomorphic to `DihedralGroup 4` (it *is* a Sylow `2`-subgroup, as
`2520 = 2³ · 315`). -/
theorem nonempty_mulEquiv_dihedral_of_card_eight {G : Type*} [Group G] [Finite G]
    (S S' : Subgroup G) (hG : Nat.card G = 2520) (hS : Nat.card S = 8)
    (hdih : Nonempty (↥S ≃* DihedralGroup 4)) (hS' : Nat.card S' = 8) :
    Nonempty (↥S' ≃* DihedralGroup 4) := by
  have hfac : (Nat.card G).factorization 2 = 3 := by rw [hG]; norm_num [Nat.factorization]
  have hS8 : Nat.card ↥S = 2 ^ (Nat.card G).factorization 2 := by rw [hfac, hS]; norm_num
  have hS'8 : Nat.card ↥S' = 2 ^ (Nat.card G).factorization 2 := by rw [hfac, hS']; norm_num
  have h1 : (Sylow.ofCard S' hS'8 : Subgroup G) = S' := Sylow.coe_ofCard S' hS'8
  have h2 : (Sylow.ofCard S hS8 : Subgroup G) = S := Sylow.coe_ofCard S hS8
  have eSyl : ↥S' ≃* ↥S := Sylow.equiv (Sylow.ofCard S' hS'8) (Sylow.ofCard S hS8)
  obtain ⟨e2⟩ := hdih
  exact ⟨eSyl.trans e2⟩

/-! ## 4. The leaf -/

theorem a7FixedVector : Work.A7REC.A7FixedVectorProp := by
  intro G _ _ S z U V W _ _ _ ρ S' τ hyps hone hρ hconf
  obtain ⟨_hsimple, hcard, hSdih, _hzS, hz2, _hzcen, _hCz, hUcard, _hUnorm, _hVdef, _hV4,
    _hcross, _hNUV, _hNUcard⟩ := hyps
  obtain ⟨hfin6, hztr, hUtr, _h7tr⟩ := hρ
  obtain ⟨_hUcard', hS'card, hτS', hτ2, _hτcenS', hUτinv, hS'infC⟩ := hconf
  -- a nontrivial element `u` of `U ≅ C₃`
  have hUnontriv : Nontrivial ↥U := by
    rw [Subgroup.nontrivial_iff_ne_bot]
    intro h
    rw [h, Subgroup.card_bot] at hUcard
    exact absurd hUcard (by norm_num)
  obtain ⟨u, hu1⟩ := exists_ne (1 : ↥U)
  have huU : (u : G) ∈ U := u.2
  have hu1' : (u : G) ≠ 1 := fun h => hu1 (Subtype.ext h)
  have hu_dvd : orderOf (u : G) ∣ 3 := by
    have h := Subgroup.card_dvd_of_le (H := Subgroup.zpowers (u : G)) (K := U)
      (Subgroup.zpowers_le.mpr huU)
    rwa [Nat.card_zpowers, hUcard] at h
  have hu_ord : orderOf (u : G) = 3 := by
    have hne : orderOf (u : G) ≠ 1 := fun h => hu1' (orderOf_eq_one_iff.mp h)
    rcases (Nat.dvd_prime (by norm_num : Nat.Prime 3)).mp hu_dvd with h | h
    · exact absurd h hne
    · exact h
  have h3u : (u : G) ^ 3 = 1 := by rw [← hu_ord]; exact pow_orderOf_eq_one _
  have hUeq : U = Subgroup.zpowers (u : G) := by
    symm
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr huU) ?_
    rw [Nat.card_zpowers, hu_ord, hUcard]
  have hu2ne1 : (u : G) ^ 2 ≠ 1 := by
    intro h
    have hd : orderOf (u : G) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr h
    rw [hu_ord] at hd
    exact absurd hd (by norm_num)
  have hUmm : ∀ w ∈ U, w = 1 ∨ w = (u : G) ∨ w = (u : G) ^ 2 := by
    intro w hw
    rw [hUeq] at hw
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hw
    rw [← hk]
    have hdiv : (↑(orderOf (u : G)) : ℤ) = 3 := by rw [hu_ord]; norm_num
    have hmod := zpow_mod_orderOf (u : G) k
    rw [hdiv] at hmod
    have hc : k % (3 : ℤ) = 0 ∨ k % (3 : ℤ) = 1 ∨ k % (3 : ℤ) = 2 := by
      have h0 : 0 ≤ k % (3 : ℤ) := Int.emod_nonneg k (by norm_num)
      have h1 : k % (3 : ℤ) < 3 := Int.emod_lt_of_pos k (by norm_num)
      omega
    rcases hc with hc | hc | hc
    · left; rw [← hmod, hc]; simp
    · right; left; rw [← hmod, hc]; simp
    · right; right; rw [← hmod, hc]; simp
  -- `Fix(U) = Fix(u)`
  have hFixU : FixS ρ U = FixOne ρ (u : G) := by
    apply le_antisymm
    · intro x hx
      exact mem_FixOne.mpr ((mem_FixS.mp hx) (u : G) huU)
    · intro x hx
      rw [mem_FixS]
      intro w hw
      rw [hUeq] at hw
      have hx' : ρ (u : G) x = x := mem_FixOne.mp hx
      have hle : Subgroup.zpowers (u : G) ≤ fixerSub ρ x :=
        Subgroup.zpowers_le.mpr (mem_fixerSub.mpr hx')
      have hw' := hle hw
      rwa [mem_fixerSub] at hw'
  -- `τ` and its action on `U`
  have hτ2' : τ ^ 2 = 1 := by rw [← hτ2]; exact pow_orderOf_eq_one τ
  have hτsq : τ * τ = 1 := by rw [← pow_two, hτ2']
  have hτ1 : τ ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hτ2
    exact absurd hτ2 (by norm_num)
  have hτinv : τ⁻¹ = τ := inv_eq_of_mul_eq_one_right hτsq
  have hτnotC : τ ∉ Subgroup.centralizer (U : Set G) := by
    intro hmem
    have hbot : τ ∈ (⊥ : Subgroup G) := by
      have h : τ ∈ S' ⊓ Subgroup.centralizer (U : Set G) := ⟨hτS', hmem⟩
      rwa [hS'infC] at h
    exact hτ1 (Subgroup.mem_bot.mp hbot)
  have hconjU : ∀ w ∈ U, τ * w * τ⁻¹ ∈ U := by
    intro w hw
    have hmem : τ * w * τ⁻¹ ∈ U.map (MulAut.conj τ).toMonoidHom :=
      Subgroup.mem_map.mpr ⟨w, hw, by simp [MulAut.conj_apply]⟩
    rwa [hUτinv] at hmem
  have hτuτ : τ * (u : G) * τ = (u : G) ^ 2 := by
    have hmem : τ * (u : G) * τ⁻¹ ∈ U := hconjU (u : G) huU
    have hmem' : τ * (u : G) * τ ∈ U := by rwa [hτinv] at hmem
    rcases hUmm (τ * (u : G) * τ) hmem' with h | h | h
    · exfalso
      have h1 : τ⁻¹ * (τ * (u : G) * τ) * τ⁻¹ = (u : G) := by group
      rw [h, mul_one] at h1
      exact hu1' (by rw [← h1, hτinv, hτsq])
    · exfalso
      have hcomm : τ * (u : G) = (u : G) * τ := by
        have h' := congrArg (fun y : G => y * τ) h
        simpa [mul_assoc, hτsq] using h'
      refine hτnotC ?_
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [hUeq] at hw
      have hsub : Subgroup.zpowers (u : G) ≤ Subgroup.centralizer ({τ} : Set G) := by
        rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
        exact hcomm.symm
      have hw' := hsub hw
      rwa [Subgroup.mem_centralizer_singleton_iff] at hw'
    · exact h
  -- `τ u` and `τ u²` are involutions
  have hτu_sq : (τ * (u : G)) ^ 2 = 1 := by
    rw [pow_two]
    calc (τ * (u : G)) * (τ * (u : G)) = (τ * (u : G) * τ) * (u : G) := by rw [← mul_assoc]
      _ = (u : G) ^ 2 * (u : G) := by rw [hτuτ]
      _ = 1 := by
        rw [← pow_succ]
        norm_num
        exact h3u
  have hτu_ord : orderOf (τ * (u : G)) = 2 := by
    refine orderOf_eq_two_of_sq_eq_one ?_ hτu_sq
    intro h
    have hτ_eq : τ = (u : G)⁻¹ := by
      have h' := congrArg (fun y : G => y * (u : G)⁻¹) h
      simpa [mul_assoc] using h'
    have h3 : orderOf τ = 3 := by rw [hτ_eq, orderOf_inv, hu_ord]
    rw [hτ2] at h3
    norm_num at h3
  have hτu2τ : τ * (u : G) ^ 2 * τ = (u : G) := by
    have key : τ * (τ * (u : G) * τ) * τ = (u : G) := by
      calc τ * (τ * (u : G) * τ) * τ = τ * τ * ((u : G) * (τ * τ)) := by group
        _ = (u : G) := by rw [hτsq, mul_one, one_mul]
    calc τ * (u : G) ^ 2 * τ = τ * (τ * (u : G) * τ) * τ := by rw [hτuτ]
      _ = (u : G) := key
  have hτu2_sq : (τ * (u : G) ^ 2) ^ 2 = 1 := by
    rw [pow_two]
    calc (τ * (u : G) ^ 2) * (τ * (u : G) ^ 2)
        = (τ * (u : G) ^ 2 * τ) * (u : G) ^ 2 := by rw [← mul_assoc]
      _ = (u : G) * (u : G) ^ 2 := by rw [hτu2τ]
      _ = 1 := by
        rw [← pow_succ']
        norm_num
        exact h3u
  have hu2inv : (u : G) ^ 2 = (u : G)⁻¹ := by
    have h : (u : G) * (u : G) ^ 2 = 1 := by
      rw [← pow_succ']
      norm_num
      exact h3u
    exact (inv_eq_of_mul_eq_one_right h).symm
  have hu2_ord : orderOf ((u : G) ^ 2) = 3 := by rw [hu2inv, orderOf_inv, hu_ord]
  have hτu2_ord : orderOf (τ * (u : G) ^ 2) = 2 := by
    refine orderOf_eq_two_of_sq_eq_one ?_ hτu2_sq
    intro h
    have hτ_eq : τ = ((u : G) ^ 2)⁻¹ := by
      have h' := congrArg (fun y : G => y * ((u : G) ^ 2)⁻¹) h
      simpa [mul_assoc] using h'
    have h3 : orderOf τ = 3 := by rw [hτ_eq, orderOf_inv, hu2_ord]
    rw [hτ2] at h3
    norm_num at h3
  -- trace of every involution is `2`
  have htr2 : ∀ g : G, orderOf g = 2 → LinearMap.trace ℂ W (ρ g) = 2 := by
    intro g hg
    obtain ⟨c, hc⟩ := isConj_iff.mp (hone g z hg hz2)
    have hrepr : ρ z = ρ c * ρ g * ρ (c⁻¹) := by
      rw [← hc, map_mul, map_mul]
    have h1 : LinearMap.trace ℂ W (ρ z) = LinearMap.trace ℂ W (ρ g) := by
      rw [hrepr, mul_assoc, LinearMap.trace_mul_comm ℂ (ρ c) (ρ g * ρ (c⁻¹)), mul_assoc,
        ← map_mul, inv_mul_cancel, map_one, mul_one]
    rw [← h1, hztr]
  -- the traces at the six elements of `⟨U, τ⟩`
  have htX : LinearMap.trace ℂ W (ρ (u : G)) = 3 := hUtr (u : G) huU hu1'
  have htX2 : LinearMap.trace ℂ W ((ρ (u : G)) ^ 2) = 3 := by
    rw [← map_pow]
    exact hUtr ((u : G) ^ 2) (Subgroup.pow_mem _ huU 2) hu2ne1
  have htY : LinearMap.trace ℂ W (ρ τ) = 2 := htr2 τ hτ2
  have htYX : LinearMap.trace ℂ W (ρ τ * ρ (u : G)) = 2 := by
    rw [← map_mul]
    exact htr2 (τ * (u : G)) hτu_ord
  have htYX2 : LinearMap.trace ℂ W (ρ τ * (ρ (u : G)) ^ 2) = 2 := by
    rw [← map_pow, ← map_mul]
    exact htr2 (τ * (u : G) ^ 2) hτu2_ord
  have hX3m : (ρ (u : G)) ^ 3 = 1 := by rw [← map_pow, h3u, map_one]
  have hY2m : (ρ τ) ^ 2 = 1 := by rw [← map_pow, hτ2', map_one]
  have hXYm : ρ τ * ρ (u : G) * ρ τ = (ρ (u : G)) ^ 2 := by
    rw [← map_mul, ← map_mul, hτuτ, map_pow]
  have hdimA : Module.finrank ℂ ↥(FixS ρ U ⊓ FixOne ρ τ) = 3 := by
    rw [hFixU]
    exact finrank_pair_ker (ρ (u : G)) (ρ τ) hX3m hY2m hXYm hfin6 htX htX2 htY htYX htYX2
  -- `S'` is dihedral of order `8`, generated by two involutions
  have hScard : Nat.card (S : Subgroup G) = 8 := by
    obtain ⟨e⟩ := hSdih
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  obtain ⟨e⟩ : Nonempty (↥S' ≃* DihedralGroup 4) :=
    nonempty_mulEquiv_dihedral_of_card_eight (S : Subgroup G) S' hcard hScard hSdih hS'card
  let f' : ↥S' := e.symm (DihedralGroup.sr (0 : ZMod 4))
  let b' : ↥S' := e.symm (DihedralGroup.sr (1 : ZMod 4))
  have hgen : Subgroup.closure ({f', b'} : Set ↥S') = ⊤ := by
    have hmap : Subgroup.map (e.symm : DihedralGroup 4 →* ↥S')
        (Subgroup.closure ({DihedralGroup.sr (0 : ZMod 4), DihedralGroup.sr (1 : ZMod 4)} :
          Set (DihedralGroup 4))) = Subgroup.closure ({f', b'} : Set ↥S') := by
      rw [MonoidHom.map_closure]
      congr 1
      ext y
      simp [f', b']
    rw [← hmap, closure_sr_zero_sr_one,
      Subgroup.map_top_of_surjective _ e.symm.surjective]
  have hS'fix : ∀ x : W, ρ (f' : G) x = x → ρ (b' : G) x = x → ∀ g ∈ S', ρ g x = x := by
    intro x hfx hbx g hg
    have hK : Subgroup.comap (S'.subtype) (fixerSub ρ x) = ⊤ := by
      rw [eq_top_iff, ← hgen]
      rw [Subgroup.closure_le]
      intro s hs
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hs
      rcases hs with rfl | rfl
      · exact Subgroup.mem_comap.mpr hfx
      · exact Subgroup.mem_comap.mpr hbx
    have hmem : (⟨g, hg⟩ : ↥S') ∈ Subgroup.comap (S'.subtype) (fixerSub ρ x) := by
      rw [hK]; exact Subgroup.mem_top _
    exact Subgroup.mem_comap.mp hmem
  have hf2 : orderOf (f' : G) = 2 := by
    show orderOf (e.symm (DihedralGroup.sr (0 : ZMod 4)) : G) = 2
    rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, DihedralGroup.orderOf_sr]
  have hb2 : orderOf (b' : G) = 2 := by
    show orderOf (e.symm (DihedralGroup.sr (1 : ZMod 4)) : G) = 2
    rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, DihedralGroup.orderOf_sr]
  have hfinf : Module.finrank ℂ ↥(FixOne ρ (f' : G)) = 4 :=
    finrank_fixOne_of_involution (ρ (f' : G)) (mul_self_eq_one_of_orderOf_eq_two ρ hf2) hfin6
      (htr2 (f' : G) hf2)
  have hfinb : Module.finrank ℂ ↥(FixOne ρ (b' : G)) = 4 :=
    finrank_fixOne_of_involution (ρ (b' : G)) (mul_self_eq_one_of_orderOf_eq_two ρ hb2) hfin6
      (htr2 (b' : G) hb2)
  have hCdim : 2 ≤ Module.finrank ℂ ↥(FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G)) := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq (FixOne ρ (f' : G)) (FixOne ρ (b' : G))
    have hsup : Module.finrank ℂ ↥(FixOne ρ (f' : G) ⊔ FixOne ρ (b' : G)) ≤ 6 := by
      have hle : FixOne ρ (f' : G) ⊔ FixOne ρ (b' : G) ≤ ⊤ := le_top
      have h' := Submodule.finrank_mono hle
      rw [finrank_top, hfin6] at h'
      exact h'
    omega
  -- the three spaces all sit inside `Fix(τ)`
  have hfinτ : Module.finrank ℂ ↥(FixOne ρ τ) = 4 :=
    finrank_fixOne_of_involution (ρ τ) (mul_self_eq_one_of_orderOf_eq_two ρ hτ2) hfin6
      (htr2 τ hτ2)
  have hCle : FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G) ≤ FixOne ρ τ := by
    intro x hx
    rw [Submodule.mem_inf, mem_FixOne, mem_FixOne] at hx
    exact mem_FixOne.mpr (hS'fix x hx.1 hx.2 τ hτS')
  have hsum := Submodule.finrank_sup_add_finrank_inf_eq (FixS ρ U ⊓ FixOne ρ τ)
    (FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G))
  have hsup2 : Module.finrank ℂ
      ↥((FixS ρ U ⊓ FixOne ρ τ) ⊔ (FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G))) ≤ 4 := by
    have hle : (FixS ρ U ⊓ FixOne ρ τ) ⊔ (FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G)) ≤
        FixOne ρ τ := sup_le inf_le_right hCle
    have h' := Submodule.finrank_mono hle
    rw [hfinτ] at h'
    exact h'
  have hpos : 1 ≤ Module.finrank ℂ
      ↥((FixS ρ U ⊓ FixOne ρ τ) ⊓ (FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G))) := by
    omega
  have hne : ((FixS ρ U ⊓ FixOne ρ τ) ⊓ (FixOne ρ (f' : G) ⊓ FixOne ρ (b' : G))) ≠ ⊥ := by
    intro h
    rw [h] at hpos
    simp at hpos
  obtain ⟨m, hm, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  refine ⟨m, hm0, ?_, ?_⟩
  · intro w hw
    exact (mem_FixS.mp hm.1.1) w hw
  · intro x hx
    exact hS'fix m (mem_FixOne.mp hm.2.1) (mem_FixOne.mp hm.2.2) x hx

end Work.A7REC.Char
