/-! ## Two auxiliary facts about the torsion arcs -/

/-- **A point of the circle killed by `Q ≠ 0` is a rational point of denominator `Q`.**  If
`Q • β = 0` in `𝕋 = ℝ/ℤ`, then `β = a/Q` for some integer `a`. -/
lemma exists_arcPt_of_zsmul_eq_zero {Q : ℕ} (hQ : Q ≠ 0) {β : Circle}
    (h : (Q : ℤ) • β = 0) : ∃ a : ℤ, β = arcPt Q a := by
  obtain ⟨r, rfl⟩ := QuotientAddGroup.mk_surjective β
  have hQr : ((((Q : ℤ) • r : ℝ)) : Circle) = 0 := by
    rw [AddCircle.coe_zsmul]
    exact h
  rw [AddCircle.coe_eq_zero_iff] at hQr
  obtain ⟨n, hn⟩ := hQr
  rw [zsmul_one] at hn
  refine ⟨n, ?_⟩
  have hkey : r = (n : ℝ) / (Q : ℝ) := by
    have hQr' : (Q : ℝ) ≠ 0 := by exact_mod_cast hQ
    rw [eq_div_iff hQr']
    rw [zsmul_eq_mul] at hn
    push_cast at hn
    rw [mul_comm] at hn
    exact hn.symm
  rw [hkey]
  rfl

/-- **`Σ_{⊆ B} = 𝕋[Q_B]` is the `Q_B`-torsion subgroup of the circle.** -/
lemma mem_sigmaSubAFinset_iff_zsmul_eq_zero {B : Finset ℕ} (h2 : ∀ q ∈ B, 2 ≤ q) (β : Circle) :
    β ∈ sigmaSubAFinset B ↔ (QA B : ℤ) • β = 0 := by
  have hQ : QA B ≠ 0 := QA_ne_zero_of_two_le h2
  constructor
  · intro h
    rw [sigmaSubAFinset, Finset.mem_image] at h
    obtain ⟨a, -, rfl⟩ := h
    exact zsmul_arcPt_eq_zero hQ dvd_rfl
  · intro h
    obtain ⟨n, hn⟩ := exists_arcPt_of_zsmul_eq_zero hQ h
    have hQpos : (0 : ℤ) < (QA B : ℤ) := by
      exact_mod_cast Nat.pos_of_ne_zero hQ
    have hnonneg : 0 ≤ n % (QA B : ℤ) := Int.emod_nonneg n (ne_of_gt hQpos)
    have hlt : n % (QA B : ℤ) < (QA B : ℤ) := Int.emod_lt_of_pos n hQpos
    rw [sigmaSubAFinset, Finset.mem_image]
    refine ⟨(n % (QA B : ℤ)).toNat, Finset.mem_range.mpr ((Int.toNat_lt hnonneg).mpr hlt), ?_⟩
    rw [arcPt_emod_toNat hQ n]
    exact hn.symm

/-- The torsion subgroup in terms of the additive order of `β`. -/
lemma mem_sigmaSubAFinset_iff_dvd_addOrderOf {B : Finset ℕ} (h2 : ∀ q ∈ B, 2 ≤ q) (β : Circle) :
    β ∈ sigmaSubAFinset B ↔ addOrderOf β ∣ QA B := by
  rw [mem_sigmaSubAFinset_iff_zsmul_eq_zero h2 β, natCast_zsmul,
    ← addOrderOf_dvd_iff_nsmul_eq_zero]

/-- **Monotonicity of the torsion subgroups** in the index set. -/
lemma mem_sigmaSubAFinset_of_subset {B C : Finset ℕ} (hBC : B ⊆ C) (h2 : ∀ q ∈ C, 2 ≤ q)
    {β : Circle} (h : β ∈ sigmaSubAFinset B) : β ∈ sigmaSubAFinset C := by
  rw [mem_sigmaSubAFinset_iff_dvd_addOrderOf (fun q hq => h2 q (hBC hq)) β] at h
  rw [mem_sigmaSubAFinset_iff_dvd_addOrderOf h2 β]
  exact dvd_trans h (Finset.prod_dvd_prod_of_subset B C (fun i => i) hBC)


/-- **The strata indicator as an alternating sum of torsion-subgroup indicators**, on the circle
(Tao, arXiv:2008.05066, §4, the inclusion–exclusion step of the `p = ∞` paragraph of
`ortho-apply`(ii): "By the inclusion–exclusion formula, and conceding a factor of `2^k`, it suffices
to show ...").

With `Σ_{⊆ A} = 𝕋[Q_A]` the torsion subgroup (`sigmaSubAFinset A`) and
`Σ_A = Σ_{⊆ A} \ ⋃_{B ⊊ A} Σ_{⊆ B}` the strata (`sigmaStrataFinset A`), the identity is

`1_{Σ_A} = ∑_{B ⊆ A} (-1)^{|A| - |B|} 1_{Σ_{⊆ B}}`

for every point `β` of the circle.  It is what lets every bound proved for the torsion subgroups
`Σ_{⊆ B}` be transferred to the strata `Σ_A`, at the cost of a factor `2^{|A|}`.

`A` must consist of pairwise coprime integers `≥ 2` (the setting of the caller, where `A ⊆ S` and `S`
is the Ionescu–Wainger set).  Without coprimality the identity is false: for `A = {2,4}` and
`β = 1/2` one has `Q_A = 8`, `Q_{{2}} = 2`, `Q_{{4}} = 4`, so `Σ_A = 𝕋[8] \ 𝕋[4]` does not contain
`1/2` while the alternating sum evaluates to `-1`.  Also `q ≥ 2` is needed, since `A = {0}` gives
`Q_A = 0`.

Consequences that follow immediately and are what the caller uses (please record them in the same
file if they are cheap):
* the character-sum form `∑_{β ∈ Σ_A} star (fourier m β)
  = ∑_{B ⊆ A} (-1)^{|A|-|B|} * (if (Q_B : ℤ) ∣ m then (Q_B : ℂ) else 0)`, obtained by summing this
  identity against `star (fourier m ·)` and using the landed `charSum_sigmaSubAFinset`;
* the symbol form `arcSymbol φ (sigmaStrataFinset A)
  = ∑_{B ⊆ A} (-1)^{|A|-|B|} • arcSymbol φ (sigmaSubAFinset B)` (pointwise; no separation hypothesis
  is needed, since each `Σ_{⊆ B}` with `B ⊆ A` is contained in `Σ_{⊆ A}`);
* the operator form, by additivity of `opArc` in the arc set.

Route.  For `β ∈ Σ_{⊆ A}` the set of `B ⊆ A` with `β ∈ Σ_{⊆ B}` is the principal up-set generated by
`T(β) := {q ∈ A : β ∉ Σ_{⊆ A \ {q}}}`: writing `ord` for the additive order of `β`, one has
`β ∈ Σ_{⊆ B} ↔ ord ∣ Q_B ↔ T(β) ⊆ B`, and `T(β) = A ↔ β ∈ Σ_A` because
`⋃_{q ∈ A} Σ_{⊆ A \ {q}} = ⋃_{B ⊊ A} Σ_{⊆ B}`.  Then apply the landed Boolean Möbius identity
`sum_powerset_ite_subset` (`indicator_sigmaStrataQ_eq_alternating_sum.lean`).  For `β ∉ Σ_{⊆ A}` both
sides vanish, since `Σ_{⊆ B} ⊆ Σ_{⊆ A}` whenever `B ⊆ A`.

The arithmetic step `β ∈ Σ_{⊆ B} ↔ ord ∣ Q_B` (with `ord` the additive order in the circle) is the
only input that is not purely Boolean; coprimality of the elements of `A` is used exactly here.
It is already available in the `ZMod` picture (`ZModArcs.mem_sigmaSubAQ_iff`, plus
`ZModArcs.arcLift_arcPt` and `ZModArcs.intCast_zmod_eq_iff_arcPt` to move between `ZMod (Q_A)` and
the circle), and the whole identity is proved there as `indicator_sigmaStrataQ_eq_alternating_sum`
(with the same two hypotheses); porting that proof is a legitimate alternative route. -/
theorem indicator_sigmaStrataFinset_incl_excl (A : Finset ℕ) (h2 : ∀ q ∈ A, 2 ≤ q)
    (hcop : ∀ p ∈ A, ∀ q ∈ A, p ≠ q → Nat.Coprime p q)
    (β : Work.BourgainPlan.IonescuWainger.Circle) :
    (if β ∈ Work.BourgainPlan.IonescuWainger.sigmaStrataFinset A then (1 : ℂ) else 0)
      = ∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
          (if β ∈ Work.BourgainPlan.IonescuWainger.sigmaSubAFinset B then (1 : ℂ) else 0) := by
  classical
  by_cases hAmem : β ∈ sigmaSubAFinset A
  · -- **Main case**: `β` does lie in the torsion subgroup of `A`.
    have hmA : addOrderOf β ∣ QA A := (mem_sigmaSubAFinset_iff_dvd_addOrderOf h2 β).mp hAmem
    set T : Finset ℕ := A.filter (fun q => ¬ (addOrderOf β ∣ QA (A.erase q))) with hT
    have hmem : ∀ B ∈ A.powerset, (β ∈ sigmaSubAFinset B ↔ T ⊆ B) := by
      intro B hB
      have hBA : B ⊆ A := Finset.mem_powerset.mp hB
      rw [mem_sigmaSubAFinset_iff_dvd_addOrderOf (fun q hq => h2 q (hBA hq)) β]
      exact dvd_QA_iff_filter_subset hcop hmA hBA
    have hsum : (∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
          (if β ∈ sigmaSubAFinset B then (1 : ℂ) else 0))
        = ∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
            (if T ⊆ B then (1 : ℂ) else 0) := by
      refine Finset.sum_congr rfl fun B hB => ?_
      by_cases hβ : β ∈ sigmaSubAFinset B
      · rw [if_pos hβ, if_pos ((hmem B hB).mp hβ)]
      · rw [if_neg hβ, if_neg (fun hT' => hβ ((hmem B hB).mpr hT'))]
    have hstrata : (β ∈ sigmaStrataFinset A) ↔ T = A := by
      rw [mem_sigmaStrataFinset, eq_iff_subset_and_proper_not_subset]
      constructor
      · rintro ⟨h1, h2'⟩
        exact ⟨(hmem A (Finset.mem_powerset.mpr (Finset.Subset.refl A))).mp h1,
          fun B hB hTB => h2' B hB ((hmem B (Finset.mem_of_mem_erase hB)).mpr hTB)⟩
      · rintro ⟨h1, h2'⟩
        exact ⟨(hmem A (Finset.mem_powerset.mpr (Finset.Subset.refl A))).mpr h1,
          fun B hB hβB => h2' B hB ((hmem B (Finset.mem_of_mem_erase hB)).mp hβB)⟩
    rw [hsum, sum_powerset_ite_subset]
    by_cases hT' : T = A
    · rw [if_pos hT', if_pos (hstrata.mpr hT')]
    · rw [if_neg hT', if_neg (fun hs => hT' (hstrata.mp hs))]
  · -- **Degenerate case**: `β` is not in the torsion subgroup of `A`; both sides vanish.
    have hzero : (if β ∈ sigmaStrataFinset A then (1 : ℂ) else 0) = 0 := by
      rw [if_neg (fun hs => hAmem (sigmaStrataFinset_subset_sigmaSubAFinset A hs))]
    rw [hzero]
    refine (Finset.sum_eq_zero fun B hB => ?_).symm
    have hBA : B ⊆ A := Finset.mem_powerset.mp hB
    have hβB : β ∉ sigmaSubAFinset B := fun hβ => hAmem (mem_sigmaSubAFinset_of_subset hBA h2 hβ)
    simp [hβB]

/-! ## Consequences of the inclusion–exclusion identity -/

/-- **The inclusion–exclusion identity, summed against a test function on the circle.**  Since
`1_{Σ_A} = ∑_{B ⊆ A} (-1)^{|A| - |B|} 1_{Σ_{⊆ B}}` pointwise (`indicator_sigmaStrataFinset_incl_excl`),
summing against any `g : Circle → ℂ` gives
`∑_{β ∈ Σ_A} g β = ∑_{B ⊆ A} (-1)^{|A| - |B|} ∑_{β ∈ Σ_{⊆ B}} g β`.  This is the form in which the
identity is used: a bound for the torsion subgroups `Σ_{⊆ B}` transfers to the strata. -/
lemma sum_sigmaStrataFinset_eq (A : Finset ℕ) (h2 : ∀ q ∈ A, 2 ≤ q)
    (hcop : ∀ p ∈ A, ∀ q ∈ A, p ≠ q → Nat.Coprime p q) (g : Circle → ℂ) :
    ∑ β ∈ sigmaStrataFinset A, g β
      = ∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
          ∑ β ∈ sigmaSubAFinset B, g β := by
  classical
  have hto : (∑ β ∈ sigmaStrataFinset A, g β)
      = ∑ β ∈ sigmaSubAFinset A,
          (if β ∈ sigmaStrataFinset A then (1 : ℂ) else 0) * g β := by
    have h₁ : (∑ β ∈ sigmaStrataFinset A,
          (if β ∈ sigmaStrataFinset A then (1 : ℂ) else 0) * g β)
        = ∑ β ∈ sigmaSubAFinset A,
            (if β ∈ sigmaStrataFinset A then (1 : ℂ) else 0) * g β :=
      Finset.sum_subset (sigmaStrataFinset_subset_sigmaSubAFinset A)
        (fun β _ hβ => by rw [if_neg hβ, zero_mul])
    have h₂ : (∑ β ∈ sigmaStrataFinset A,
          (if β ∈ sigmaStrataFinset A then (1 : ℂ) else 0) * g β)
        = ∑ β ∈ sigmaStrataFinset A, g β :=
      Finset.sum_congr rfl fun β hβ => by rw [if_pos hβ, one_mul]
    rw [← h₂, h₁]
  rw [hto]
  calc ∑ β ∈ sigmaSubAFinset A, (if β ∈ sigmaStrataFinset A then (1 : ℂ) else 0) * g β
      = ∑ β ∈ sigmaSubAFinset A, (∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
            (if β ∈ sigmaSubAFinset B then (1 : ℂ) else 0)) * g β := by
          refine Finset.sum_congr rfl fun β _ => ?_
          rw [indicator_sigmaStrataFinset_incl_excl A h2 hcop β]
    _ = ∑ β ∈ sigmaSubAFinset A, ∑ B ∈ A.powerset,
          ((-1 : ℂ) ^ (A.card - B.card) *
              (if β ∈ sigmaSubAFinset B then (1 : ℂ) else 0)) * g β := by
          refine Finset.sum_congr rfl fun β _ => ?_
          rw [Finset.sum_mul]
    _ = ∑ B ∈ A.powerset, ∑ β ∈ sigmaSubAFinset A,
          ((-1 : ℂ) ^ (A.card - B.card) *
              (if β ∈ sigmaSubAFinset B then (1 : ℂ) else 0)) * g β := Finset.sum_comm
    _ = ∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
          ∑ β ∈ sigmaSubAFinset B, g β := by
          refine Finset.sum_congr rfl fun B hB => ?_
          have hBA : B ⊆ A := Finset.mem_powerset.mp hB
          have hfilter : (sigmaSubAFinset A).filter (fun β => β ∈ sigmaSubAFinset B)
              = sigmaSubAFinset B := by
            refine Finset.Subset.antisymm (fun β hβ => (Finset.mem_filter.mp hβ).2) fun β hβ =>
              Finset.mem_filter.mpr ⟨mem_sigmaSubAFinset_of_subset hBA h2 hβ, hβ⟩
          have key : ∀ β, ((-1 : ℂ) ^ (A.card - B.card) *
                (if β ∈ sigmaSubAFinset B then (1 : ℂ) else 0)) * g β
              = (if β ∈ sigmaSubAFinset B then (-1 : ℂ) ^ (A.card - B.card) * g β else 0) := by
            intro β
            by_cases h : β ∈ sigmaSubAFinset B <;> simp [h]
          rw [Finset.mul_sum]
          trans ∑ β ∈ sigmaSubAFinset A,
            (if β ∈ sigmaSubAFinset B then (-1 : ℂ) ^ (A.card - B.card) * g β else 0)
          · exact Finset.sum_congr rfl fun β _ => key β
          · rw [← Finset.sum_filter, hfilter]

/-- **Character-sum form of the strata inclusion–exclusion.**  Summing the strata identity against
the monomial `star (fourier m ·)` and using the torsion-subgroup character sum
`charSum_sigmaSubAFinset` turns the strata character sum into the alternating sum of the
periodisation weights `Q_B [Q_B ∣ m]`. -/
theorem charSum_sigmaStrataFinset (A : Finset ℕ) (h2 : ∀ q ∈ A, 2 ≤ q)
    (hcop : ∀ p ∈ A, ∀ q ∈ A, p ≠ q → Nat.Coprime p q) (m : ℤ) :
    ∑ β ∈ sigmaStrataFinset A, star (fourier m β)
      = ∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) *
          (if (QA B : ℤ) ∣ m then (QA B : ℂ) else 0) := by
  rw [sum_sigmaStrataFinset_eq A h2 hcop (fun β => star (fourier m β))]
  exact Finset.sum_congr rfl fun B _ => by rw [charSum_sigmaSubAFinset B m]

/-- **Symbol form of the strata inclusion–exclusion.**  Pointwise in `ξ`, the alternating sum of
the torsion-subgroup symbols is the strata symbol; no separation hypothesis is needed, since each
`Σ_{⊆ B}` with `B ⊆ A` is contained in `Σ_{⊆ A}`. -/
theorem arcSymbol_strata_incl_excl (φ : Circle → ℂ) (A : Finset ℕ) (h2 : ∀ q ∈ A, 2 ≤ q)
    (hcop : ∀ p ∈ A, ∀ q ∈ A, p ≠ q → Nat.Coprime p q) :
    arcSymbol φ (sigmaStrataFinset A)
      = ∑ B ∈ A.powerset, (-1 : ℂ) ^ (A.card - B.card) •
          arcSymbol φ (sigmaSubAFinset B) := by
  funext ξ
  simp only [arcSymbol_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  exact sum_sigmaStrataFinset_eq A h2 hcop (fun β => φ (ξ - β))


end Work.BourgainPlan.IonescuWainger
