/-!
# The `L²`-contraction of the box projections `Pᵢ = aP ℓ i` and `Qᵢ = aQ ℓ i`

The centred-box sector projections of `Q0Sector` are

    (PᵢΦ)(x) = (1/ℓ³)·∫_{y ∈ acube ℓ} Φ (x[i ↦ y]) ,      Qᵢ = 1 − Pᵢ .

`Pᵢ` is the conditional expectation onto the σ-algebra generated by the coordinates
other than `i` (the fibre mean over `acube ℓ`), so it is an orthogonal projection of
`L²(abox N ℓ)`; hence both `Pᵢ` and `Qᵢ = 1 − Pᵢ` are contractions:

    ‖PᵢΦ‖² ≤ ‖Φ‖² ,      ‖QᵢΦ‖² ≤ ‖Φ‖² .

This module proves that contraction for **arbitrary** `Φ` whose square is integrable
over `abox N ℓ` (in particular no continuity/measurability of `Φ` is assumed).

## Route

`Q0Sector` proves `aP_sq_le` under the hypothesis `Continuous Φ`.  Here we work
directly on `L²`, using the measure-preserving peel of the box isolating one
coordinate (`CentreBox.measurePreserving_coordSplitFinAcube`, packaged as
`Q0Sector.abox_integral_peel`) and a purely fibre-wise computation:

* `integral_sq_sub_expand` — the elementary identity
  `∫_y (f y − M)² = ∫_y (f y)² − 2M ∫_y f y + M²ℓ³` (for `f ∈ L¹ ∩ L²` on `acube ℓ`);
* `fibre_sq_le` — for `f` with `f² ∈ L¹(acube ℓ)` and `M := (1/ℓ³)∫_y f y`,
      `ℓ³ M² ≤ ∫_y (f y)²`    and    `∫_y (f y − M)² ≤ ∫_y (f y)²` .
  These are the Cauchy–Schwarz/variance inequalities over the probability measure
  `(1/ℓ³)·volume|_{acube ℓ}`; the proof is a case split on `Integrable f`.  In the
  non-integrable case Lean's convention `∫ = 0` makes both claims immediate (and
  correct), so no measurability of `f` is needed.

The global statement follows by peeling `abox (n+1) ℓ ≅ acube ℓ × abox n ℓ`, applying
`fibre_sq_le` to almost every fibre (whose square-integrability comes from
`Integrable.prod_left_ae`), and reassembling.  The pointwise identity
`aP_kcInsN : aP ℓ i Φ (kcInsN n i (y,r)) = (1/ℓ³)∫_z Φ (kcInsN n i (z,r))` exhibits the
integrand as a function of the peel coordinate alone.  Two junk cases are handled by
`MeasureTheory.integral_undef`: if the squared integrand of one of the two sides fails
to be integrable, that side's Bochner integral is `0`, which is `≤ ∫ Φ²`.
-/

noncomputable section

open MeasureTheory
open scoped Real

namespace Work.PCFU

open Submission.BoseGases

/-- Elementary expansion: for `f ∈ L¹ ∩ L²` on the centred cube `acube ℓ` and any
constant `M`, `∫_y (f y − M)² = ∫_y (f y)² − 2M ∫_y f y + M²ℓ³`. -/
lemma integral_sq_sub_expand {ℓ : ℝ} (hℓ : 0 < ℓ) {f : ℝ³ → ℝ} {M : ℝ}
    (hf : Integrable f (volume.restrict (acube ℓ)))
    (hf2 : Integrable (fun y => (f y)^2) (volume.restrict (acube ℓ))) :
    ∫ y in acube ℓ, (f y - M)^2
      = (∫ y in acube ℓ, (f y)^2) - 2*M*(∫ y in acube ℓ, f y) + M^2*ℓ^3 := by
  have hvol : (volume.restrict (acube ℓ)).real Set.univ = ℓ^3 := by
    rw [measureReal_def, restrict_acube_univ ℓ hℓ.le, ENNReal.toReal_ofReal (by positivity)]
  have h1 : (fun y => (f y - M)^2) = (fun y => (f y)^2 - 2*M*(f y) + M^2) := by
    funext y; ring
  rw [h1]
  have hA : Integrable (fun y => (f y)^2 - 2*M*(f y)) (volume.restrict (acube ℓ)) :=
    hf2.sub (hf.const_mul (2*M))
  have hB : Integrable (fun _ : ℝ³ => M^2) (volume.restrict (acube ℓ)) := integrable_const _
  rw [show (fun y : ℝ³ => (f y)^2 - 2*M*(f y) + M^2)
        = fun y => (fun y => (f y)^2 - 2*M*(f y)) y + (fun _ : ℝ³ => M^2) y from rfl,
      integral_add hA hB, integral_sub hf2 (hf.const_mul (2*M)), integral_const_mul,
      integral_const, hvol, smul_eq_mul]
  ring

/-- **Fibre-wise mean-square inequalities.**  Let `f` be a real function on the centred
cube with `f²` integrable there, and let `M := (1/ℓ³)·∫_y f y` be its mean.  Then

  * `ℓ³ M² ≤ ∫_y (f y)²` (Cauchy–Schwarz / Jensen for `x ↦ x²`), and
  * `∫_y (f y − M)² ≤ ∫_y (f y)²` (variance identity `∫(f−M)² = ∫f² − ℓ³M²`).

No measurability of `f` is assumed: in the non-integrable case Lean's convention
`∫ = 0` makes `M = 0` and both claims hold. -/
lemma fibre_sq_le {ℓ : ℝ} (hℓ : 0 < ℓ) {f : ℝ³ → ℝ}
    (hf2 : Integrable (fun y => (f y)^2) (volume.restrict (acube ℓ))) :
    (ℓ^3 * ((1/ℓ^3) * ∫ y in acube ℓ, f y)^2 ≤ ∫ y in acube ℓ, (f y)^2) ∧
    (∫ y in acube ℓ, (f y - (1/ℓ^3) * ∫ z in acube ℓ, f z)^2
      ≤ ∫ y in acube ℓ, (f y)^2) := by
  have hℓ3 : (0:ℝ) < ℓ^3 := by positivity
  by_cases hf : Integrable f (volume.restrict (acube ℓ))
  · set M : ℝ := (1/ℓ^3) * ∫ y in acube ℓ, f y with hMdef
    have hMℓ : M * ℓ^3 = ∫ y in acube ℓ, f y := by rw [hMdef]; field_simp
    have hkey : ∫ y in acube ℓ, (f y - M)^2 = (∫ y in acube ℓ, (f y)^2) - M^2 * ℓ^3 := by
      have hexp : ∫ y in acube ℓ, (f y - M)^2
          = (∫ y in acube ℓ, (f y)^2) - 2*M*(∫ y in acube ℓ, f y) + M^2*ℓ^3 :=
        integral_sq_sub_expand hℓ hf hf2
      rw [hexp]
      have hsub : 2*M*(∫ y in acube ℓ, f y) = 2*(M^2*ℓ^3) := by rw [← hMℓ]; ring
      rw [hsub]; ring
    have hnonneg : 0 ≤ ∫ y in acube ℓ, (f y - M)^2 :=
      integral_nonneg (μ := volume.restrict (acube ℓ)) (f := fun y => (f y - M)^2)
        (fun y => sq_nonneg (f y - M))
    rw [hkey] at hnonneg
    have hpos : 0 ≤ M^2 * ℓ^3 := mul_nonneg (sq_nonneg M) hℓ3.le
    exact ⟨by linarith, by linarith⟩
  · have hzero : ∫ y in acube ℓ, f y = 0 := integral_undef hf
    constructor
    · rw [hzero]
      simp only [mul_zero, zero_pow (by norm_num : (2:ℕ) ≠ 0), mul_zero]
      exact integral_nonneg (μ := volume.restrict (acube ℓ)) (f := fun y => (f y)^2)
        (fun y => sq_nonneg (f y))
    · rw [hzero]
      simp only [mul_zero, sub_zero]
      exact le_rfl

theorem aP_aQ_sq_le {N : ℕ} {ℓ : ℝ} (hℓ : 0 < ℓ) (i : Fin N)
    (Φ : Submission.BoseGases.X N → ℝ)
    (hΦ : MeasureTheory.IntegrableOn (fun x => (Φ x) ^ 2) (Submission.BoseGases.abox N ℓ)) :
    ((∫ x in Submission.BoseGases.abox N ℓ, (Submission.BoseGases.aP ℓ i Φ x) ^ 2)
        ≤ ∫ x in Submission.BoseGases.abox N ℓ, (Φ x) ^ 2)
      ∧ ((∫ x in Submission.BoseGases.abox N ℓ, (Submission.BoseGases.aQ ℓ i Φ x) ^ 2)
        ≤ ∫ x in Submission.BoseGases.abox N ℓ, (Φ x) ^ 2) := by
  cases N with
  | zero => exact Fin.elim0 i
  | succ n =>
    let μ' : Measure ℝ³ := (volume : Measure ℝ³).restrict (acube ℓ)
    let ν : Measure (X n) := (volume : Measure (X n)).restrict (abox n ℓ)
    -- the measure-preserving peel `abox (n+1) ℓ ≅ acube ℓ × abox n ℓ`
    have hmp : MeasurePreserving (⇑(kcInsN n i)) (μ'.prod ν)
        ((volume : Measure (X (n+1))).restrict (abox (n+1) ℓ)) := by
      have h := MeasurePreserving.symm (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n+1) => ℝ³) i)
        (abox_peel_mp n ℓ i)
      simpa only [kcInsN, μ', ν] using h
    -- the pull-back of `Φ²` to the product, and its a.e. fibre integrability
    have hHpull : Integrable (fun p : ℝ³ × X n => (Φ ((kcInsN n i) p))^2) (μ'.prod ν) :=
      (hmp.integrable_comp (g := fun x : X (n+1) => (Φ x)^2) hΦ.aestronglyMeasurable).mpr hΦ
    have hfib : ∀ᵐ r ∂ν, Integrable (fun y : ℝ³ => (Φ ((kcInsN n i) (y, r)))^2) μ' :=
      hHpull.prod_left_ae
    have hvolμ : μ'.real Set.univ = ℓ^3 := by
      dsimp only [μ']
      rw [measureReal_def, restrict_acube_univ ℓ hℓ.le, ENNReal.toReal_ofReal (by positivity)]
    have hP : (∫ x in abox (n+1) ℓ, (aP ℓ i Φ x)^2) ≤ ∫ x in abox (n+1) ℓ, (Φ x)^2 := by
      by_cases hG : IntegrableOn (fun x => (aP ℓ i Φ x)^2) (abox (n+1) ℓ)
      · -- integrable case: peel, then the fibre inequality on a.e. fibre
        have hGpull : Integrable (fun p : ℝ³ × X n => (aP ℓ i Φ ((kcInsN n i) p))^2)
            (μ'.prod ν) :=
          (hmp.integrable_comp (g := fun x : X (n+1) => (aP ℓ i Φ x)^2)
            hG.aestronglyMeasurable).mpr hG
        have hpt : (fun p : ℝ³ × X n => (aP ℓ i Φ ((kcInsN n i) p))^2)
            = fun p : ℝ³ × X n => ((1/ℓ^3) * ∫ y in acube ℓ, Φ ((kcInsN n i) (y, p.2)))^2 := by
          funext p
          obtain ⟨y, r⟩ := p
          rw [aP_kcInsN]
        have hGpull2 : Integrable
            (fun p : ℝ³ × X n => ((1/ℓ^3) * ∫ y in acube ℓ, Φ ((kcInsN n i) (y, p.2)))^2)
            (μ'.prod ν) :=
          hGpull.congr (Filter.EventuallyEq.of_eq hpt)
        have hinner : ∀ r : X n,
            ∫ y : ℝ³, ((1/ℓ^3) * ∫ z in acube ℓ, Φ ((kcInsN n i) (z, r)))^2 ∂μ'
              = ℓ^3 * ((1/ℓ^3) * ∫ z in acube ℓ, Φ ((kcInsN n i) (z, r)))^2 := by
          intro r
          rw [integral_const, hvolμ, smul_eq_mul]
        calc ∫ x in abox (n+1) ℓ, (aP ℓ i Φ x)^2
            = ∫ p : ℝ³ × X n, (aP ℓ i Φ ((kcInsN n i) p))^2 ∂(μ'.prod ν) :=
                (hmp.integral_comp (kcInsN n i).measurableEmbedding _).symm
          _ = ∫ p : ℝ³ × X n,
                ((1/ℓ^3) * ∫ y in acube ℓ, Φ ((kcInsN n i) (y, p.2)))^2 ∂(μ'.prod ν) := by
                rw [hpt]
          _ = ∫ r : X n, ∫ y : ℝ³,
                ((1/ℓ^3) * ∫ z in acube ℓ, Φ ((kcInsN n i) (z, r)))^2 ∂μ' ∂ν :=
                integral_prod_symm _ hGpull2
          _ = ∫ r : X n,
                ℓ^3 * ((1/ℓ^3) * ∫ z in acube ℓ, Φ ((kcInsN n i) (z, r)))^2 ∂ν := by
                apply integral_congr_ae
                filter_upwards with r
                exact hinner r
          _ ≤ ∫ r : X n, (∫ y : ℝ³, (Φ ((kcInsN n i) (y, r)))^2 ∂μ') ∂ν := by
                apply integral_mono_ae
                · exact (hGpull2.integral_prod_right).congr
                    (Filter.Eventually.of_forall (fun r => hinner r))
                · exact hHpull.integral_prod_right
                · filter_upwards [hfib] with r hr
                  exact (fibre_sq_le hℓ hr).1
          _ = ∫ x in abox (n+1) ℓ, (Φ x)^2 :=
                (abox_integral_peel i (fun x => (Φ x)^2) hΦ).symm
      · -- junk case: a non-integrable integrand has Bochner integral `0`
        rw [show (∫ x in abox (n+1) ℓ, (aP ℓ i Φ x)^2) = 0 from integral_undef hG]
        exact integral_nonneg (μ := (volume : Measure (X (n+1))).restrict (abox (n+1) ℓ))
          (f := fun x => (Φ x)^2) (fun x => sq_nonneg (Φ x))
    have hQ : (∫ x in abox (n+1) ℓ, (aQ ℓ i Φ x)^2) ≤ ∫ x in abox (n+1) ℓ, (Φ x)^2 := by
      by_cases hG : IntegrableOn (fun x => (aQ ℓ i Φ x)^2) (abox (n+1) ℓ)
      · have hGpull : Integrable (fun p : ℝ³ × X n => (aQ ℓ i Φ ((kcInsN n i) p))^2)
            (μ'.prod ν) :=
          (hmp.integrable_comp (g := fun x : X (n+1) => (aQ ℓ i Φ x)^2)
            hG.aestronglyMeasurable).mpr hG
        have hpt : (fun p : ℝ³ × X n => (aQ ℓ i Φ ((kcInsN n i) p))^2)
            = fun p : ℝ³ × X n =>
                (Φ ((kcInsN n i) p)
                  - (1/ℓ^3) * ∫ y in acube ℓ, Φ ((kcInsN n i) (y, p.2)))^2 := by
          funext p
          obtain ⟨y, r⟩ := p
          simp only [aQ]
          rw [aP_kcInsN]
        have hGpull2 : Integrable
            (fun p : ℝ³ × X n =>
              (Φ ((kcInsN n i) p)
                - (1/ℓ^3) * ∫ y in acube ℓ, Φ ((kcInsN n i) (y, p.2)))^2) (μ'.prod ν) :=
          hGpull.congr (Filter.EventuallyEq.of_eq hpt)
        calc ∫ x in abox (n+1) ℓ, (aQ ℓ i Φ x)^2
            = ∫ p : ℝ³ × X n, (aQ ℓ i Φ ((kcInsN n i) p))^2 ∂(μ'.prod ν) :=
                (hmp.integral_comp (kcInsN n i).measurableEmbedding _).symm
          _ = ∫ p : ℝ³ × X n,
                (Φ ((kcInsN n i) p)
                  - (1/ℓ^3) * ∫ y in acube ℓ, Φ ((kcInsN n i) (y, p.2)))^2 ∂(μ'.prod ν) := by
                rw [hpt]
          _ = ∫ r : X n, ∫ y : ℝ³,
                (Φ ((kcInsN n i) (y, r))
                  - (1/ℓ^3) * ∫ z in acube ℓ, Φ ((kcInsN n i) (z, r)))^2 ∂μ' ∂ν :=
                integral_prod_symm _ hGpull2
          _ ≤ ∫ r : X n, (∫ y : ℝ³, (Φ ((kcInsN n i) (y, r)))^2 ∂μ') ∂ν := by
                apply integral_mono_ae
                · exact hGpull2.integral_prod_right
                · exact hHpull.integral_prod_right
                · filter_upwards [hfib] with r hr
                  exact (fibre_sq_le hℓ hr).2
          _ = ∫ x in abox (n+1) ℓ, (Φ x)^2 :=
                (abox_integral_peel i (fun x => (Φ x)^2) hΦ).symm
      · rw [show (∫ x in abox (n+1) ℓ, (aQ ℓ i Φ x)^2) = 0 from integral_undef hG]
        exact integral_nonneg (μ := (volume : Measure (X (n+1))).restrict (abox (n+1) ℓ))
          (f := fun x => (Φ x)^2) (fun x => sq_nonneg (Φ x))
    exact ⟨hP, hQ⟩

end Work.PCFU
