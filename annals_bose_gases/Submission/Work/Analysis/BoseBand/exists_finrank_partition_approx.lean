/-!
# `Work.Analysis.BoseBand.exists_finrank_partition_approx`

**Finite-rank uniform approximation of a continuous kernel on the centred cube.**

For a continuous `G : ℝ³ → ℝ³ → ℝ` and `ε > 0` there are `n : ℕ`, continuous weights
`θ i : ℝ³ → ℝ` and *smooth* profiles `p i : ℝ³ → ℝ` with

`|G z y - ∑ i, θ i y * p i z| ≤ ε`   on `acube ℓ × acube ℓ`.

## Proof

Let `E3 = ℝ³` and let `Single ⊆ C(E3 × E3, ℝ)` be the set of *single terms*
`(z, y) ↦ θ y * p z` with `θ` continuous and `p` smooth (`IsSingle` in `BandApproxDefs`),
and `IsNice g` the predicate "`g` is a finite sum of single terms".  The subalgebra
`A := Algebra.adjoin ℝ Single` contains all the `IsNice` elements, because constants
(`nice_const`), sums (`nice_add`) and products (`nice_mul`) of nice functions are nice;
conversely every element of `A` is nice by `Algebra.adjoin_induction`.

`A` separates points (`adjoin_separatesPoints`): if `x ≠ y` in `E3 × E3` then either the
first or the second coordinate distinguishes them, and the corresponding coordinate
function is a single term (the coordinate projections of `EuclideanSpace ℝ (Fin 3)` are
smooth).

Since `acube ℓ × acube ℓ` is compact, Stone–Weierstrass
(`ContinuousMap.exists_mem_subalgebra_near_continuous_of_isCompact_of_separatesPoints`)
produces `g ∈ A` with `‖g (z,y) - G z y‖ < ε` on the cube.  Unwrapping `IsNice g` and
re-indexing the finite sum by `Fin n` (via `Fintype.equivFin`) gives the claim.
-/

noncomputable section

open scoped Topology

namespace Work.Analysis.BoseBand

set_option autoImplicit false

/-! ## The subalgebra of finite sums of single terms -/

/-- A single term is nice (with index type `Fin 1`). -/
lemma isNice_single {g : C(E3 × E3, ℝ)} (hg : IsSingle g) : IsNice g := by
  obtain ⟨θ, p, hθ, hp, hg⟩ := hg
  refine ⟨Fin 1, inferInstance, fun _ => θ, fun _ => p, ?_, ?_, ?_⟩
  · intro _; exact hθ
  · intro _; exact hp
  · intro x; rw [Fin.sum_univ_one]; exact hg x

/-- The constant function `r` is nice. -/
lemma nice_const (r : ℝ) : IsNice (algebraMap ℝ C(E3 × E3, ℝ) r) := by
  refine ⟨Fin 1, inferInstance, fun _ _ => r, fun _ _ => (1 : ℝ), ?_, ?_, ?_⟩
  · intro _; exact continuous_const
  · intro _; exact contDiff_const
  · intro x
    rw [Fin.sum_univ_one]
    simp [algebraMap_apply]

/-- Nice functions are closed under addition. -/
lemma nice_add {f g : C(E3 × E3, ℝ)} (hf : IsNice f) (hg : IsNice g) : IsNice (f + g) := by
  obtain ⟨ι, hι, θ₁, p₁, hθ₁, hp₁, h₁⟩ := hf
  obtain ⟨κ, hκ, θ₂, p₂, hθ₂, hp₂, h₂⟩ := hg
  letI := hι
  letI := hκ
  refine ⟨ι ⊕ κ, inferInstance, Sum.elim θ₁ θ₂, Sum.elim p₁ p₂, ?_, ?_, ?_⟩
  · intro i
    cases i with
    | inl i => exact hθ₁ i
    | inr i => exact hθ₂ i
  · intro i
    cases i with
    | inl i => exact hp₁ i
    | inr i => exact hp₂ i
  · intro x
    rw [ContinuousMap.add_apply, h₁ x, h₂ x, Fintype.sum_sum_type]
    rfl

/-- Nice functions are closed under multiplication. -/
lemma nice_mul {f g : C(E3 × E3, ℝ)} (hf : IsNice f) (hg : IsNice g) : IsNice (f * g) := by
  obtain ⟨ι, hι, θ₁, p₁, hθ₁, hp₁, h₁⟩ := hf
  obtain ⟨κ, hκ, θ₂, p₂, hθ₂, hp₂, h₂⟩ := hg
  letI := hι
  letI := hκ
  refine ⟨ι × κ, inferInstance, (fun i => fun y => θ₁ i.1 y * θ₂ i.2 y),
    (fun i => fun z => p₁ i.1 z * p₂ i.2 z), ?_, ?_, ?_⟩
  · intro i; exact (hθ₁ i.1).mul (hθ₂ i.2)
  · intro i; exact (hp₁ i.1).mul (hp₂ i.2)
  · intro x
    rw [ContinuousMap.mul_apply, h₁ x, h₂ x, Finset.sum_mul_sum, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    ring

/-- Every element of the subalgebra generated by the single terms is a finite sum of
single terms. -/
lemma isNice_of_mem_adjoin {g : C(E3 × E3, ℝ)}
    (hg : g ∈ Algebra.adjoin ℝ (IsSingle : Set C(E3 × E3, ℝ))) : IsNice g :=
  Algebra.adjoin_induction (fun x hx => isNice_single hx) (fun r => nice_const r)
    (fun x y _ _ ihx ihy => nice_add ihx ihy) (fun x y _ _ ihx ihy => nice_mul ihx ihy) hg

/-! ## The subalgebra separates points -/

/-- The subalgebra generated by the single terms separates points of `E3 × E3`: the
coordinate functions are single terms and distinguish distinct points. -/
theorem adjoin_separatesPoints :
    (Algebra.adjoin ℝ (IsSingle : Set C(E3 × E3, ℝ))).SeparatesPoints := by
  intro x y hxy
  rcases eq_or_ne x.2 y.2 with h2 | h2
  · -- the first coordinates differ
    have h1 : x.1 ≠ y.1 := fun h => hxy (Prod.ext h h2)
    obtain ⟨m, hm⟩ : ∃ m : Fin 3, x.1 m ≠ y.1 m := by
      by_contra hcon
      push Not at hcon
      exact h1 ((WithLp.ext_iff (p := 2)).mpr (funext hcon))
    refine ⟨fun q : E3 × E3 => 1 * q.1 m,
      ⟨⟨fun q : E3 × E3 => 1 * q.1 m, by fun_prop⟩, ?_, rfl⟩, ?_⟩
    · exact Algebra.subset_adjoin
        ⟨fun _ => (1 : ℝ), fun z => z m, continuous_const, by fun_prop, fun _ => rfl⟩
    · simpa using hm
  · -- the second coordinates differ
    obtain ⟨m, hm⟩ : ∃ m : Fin 3, x.2 m ≠ y.2 m := by
      by_contra hcon
      push Not at hcon
      exact h2 ((WithLp.ext_iff (p := 2)).mpr (funext hcon))
    refine ⟨fun q : E3 × E3 => q.2 m * 1,
      ⟨⟨fun q : E3 × E3 => q.2 m * 1, by fun_prop⟩, ?_, rfl⟩, ?_⟩
    · exact Algebra.subset_adjoin
        ⟨fun v => v m, fun _ => (1 : ℝ), by fun_prop, contDiff_const, fun _ => rfl⟩
    · simpa using hm

/-! ## The target -/

theorem exists_finrank_partition_approx {ℓ : ℝ} (hℓ : 0 < ℓ)
    {G : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3) → ℝ}
    (hG : Continuous fun p : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3) => G p.1 p.2)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ (n : ℕ) (θ : Fin n → EuclideanSpace ℝ (Fin 3) → ℝ)
      (p : Fin n → EuclideanSpace ℝ (Fin 3) → ℝ),
      (∀ i, Continuous (θ i)) ∧ (∀ i, ContDiff ℝ (⊤ : ℕ∞) (p i)) ∧
      (∀ z ∈ Submission.BoseGases.acube ℓ, ∀ y ∈ Submission.BoseGases.acube ℓ,
        |G z y - ∑ i, θ i y * p i z| ≤ ε) := by
  have hK : IsCompact (Submission.BoseGases.acube ℓ ×ˢ Submission.BoseGases.acube ℓ) :=
    (Submission.BoseGases.acube_compact hℓ).prod (Submission.BoseGases.acube_compact hℓ)
  obtain ⟨g, hgA, hgapprox⟩ :=
    ContinuousMap.exists_mem_subalgebra_near_continuous_of_isCompact_of_separatesPoints
      adjoin_separatesPoints ⟨fun p => G p.1 p.2, hG⟩ hK hε
  obtain ⟨ι, hF, θ, p, hθ, hp, hsum⟩ := isNice_of_mem_adjoin hgA
  letI := hF
  refine ⟨Fintype.card ι, fun k => θ ((Fintype.equivFin ι).symm k),
    fun k => p ((Fintype.equivFin ι).symm k), ?_, ?_, ?_⟩
  · intro k; exact hθ _
  · intro k; exact hp _
  · intro z hz y hy
    have hxy : (z, y) ∈ Submission.BoseGases.acube ℓ ×ˢ Submission.BoseGases.acube ℓ :=
      ⟨hz, hy⟩
    have h1 : ‖(g : E3 × E3 → ℝ) (z, y) - G z y‖ < ε := hgapprox (z, y) hxy
    rw [Real.norm_eq_abs, abs_sub_comm] at h1
    rw [hsum (z, y)] at h1
    have hre : (∑ k : Fin (Fintype.card ι),
        θ ((Fintype.equivFin ι).symm k) y * p ((Fintype.equivFin ι).symm k) z)
        = ∑ i, θ i y * p i z :=
      Equiv.sum_comp (Fintype.equivFin ι).symm (fun i => θ i y * p i z)
    rw [hre]
    exact le_of_lt h1

end Work.Analysis.BoseBand
