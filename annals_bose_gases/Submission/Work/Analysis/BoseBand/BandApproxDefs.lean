/-!
# `Work.Analysis.BoseBand.BandApproxDefs` — definitions for the finite-rank
approximation of a continuous kernel on the centred cube

The target `Work.Analysis.BoseBand.exists_finrank_partition_approx` asks, for a
continuous `G : ℝ³ → ℝ³ → ℝ` and `ε > 0`, for finitely many continuous weights
`θ i` (in the second variable) and smooth functions `p i` (in the first variable)
with `|G z y - ∑ i, θ i y * p i z| ≤ ε` on `acube ℓ × acube ℓ`.

The proof goes through Stone--Weierstrass applied to the subalgebra of `C(ℝ³ × ℝ³, ℝ)`
generated by the "single terms" `(z, y) ↦ θ y * p z` with `θ` continuous and `p` smooth
(`IsSingle` below).  `IsNice` is the predicate "is a finite sum of single terms"; the
Stone--Weierstrass induction will show every element of that subalgebra is `IsNice`,
and `IsNice` is exactly the shape required by the target.

This module only holds the two definitions; the closure lemmas live in sibling modules.
-/

noncomputable section

namespace Work.Analysis.BoseBand

set_option autoImplicit false

/-- The Euclidean space `ℝ³` used throughout the box layer. -/
abbrev E3 : Type := EuclideanSpace ℝ (Fin 3)

/-- A *single term*: a continuous function on `E3 × E3` of the form
`(z, y) ↦ θ y * p z` with `θ` continuous and `p` smooth. -/
def IsSingle (g : C(E3 × E3, ℝ)) : Prop :=
  ∃ (θ : E3 → ℝ) (p : E3 → ℝ), Continuous θ ∧ ContDiff ℝ (⊤ : ℕ∞) p ∧
    ∀ x, g x = θ x.2 * p x.1

/-- A *nice* function: a finite sum of single terms, indexed by an arbitrary finite type. -/
def IsNice (g : C(E3 × E3, ℝ)) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (θ : ι → E3 → ℝ) (p : ι → E3 → ℝ),
    (∀ i, Continuous (θ i)) ∧ (∀ i, ContDiff ℝ (⊤ : ℕ∞) (p i)) ∧
      ∀ x, g x = ∑ i, θ i x.2 * p i x.1

end Work.Analysis.BoseBand
