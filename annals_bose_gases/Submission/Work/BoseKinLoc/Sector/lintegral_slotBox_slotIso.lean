/-!
# `Work.BoseKinLoc.Sector.lintegral_slotBox_slotIso` — re-indexing the slot box

** Read `Submission/Work/BoseKinLoc/Sector/fibre_defs_v3.lean` first. **

The slot framework of `Submission.Work.PerSector` splits an `N`-particle configuration along a
slot set `S : Finset (Fin N)`, and `Work.BoseKinLoc.Sector.slotIso S : SlotIn N S ≃ Fin S.card`
is the canonical order isomorphism between the slots of `S` and `Fin |S|`.  Consequently the
fibre states of the sector decomposition live on `X |S| = Fin |S| → ℝ³`, while the fibre of
`Work.PerSector.slotFibreState` lives on `SlotIn N S → ℝ³`; transporting an integral between
the two descriptions is exactly the statement proved here:

`∫⁻_{slotBox B} f (x ↦ x ∘ slotIso S) = ∫⁻_{slotBox B} f`

where `slotBox (ι := ι) B = {z | ∀ i, z i ∈ B}` is the box `B^ι`.  The re-indexing
`x ↦ (fun i : SlotIn N S ↦ x (slotIso S i))` is the measurable equivalence
`MeasurableEquiv.piCongrLeft` generated by `(slotIso S).symm`; it is measure preserving for the
product measure `volume` on the function spaces and it maps the box `B^{Fin |S|}` bijectively
onto the box `B^{SlotIn N S}`.  The conclusion then follows from
`MeasurePreserving.setLIntegral_comp_emb`.

Note that measurability of `B` is *not* needed: the `..._emb` form of the change-of-variables
formula applies to arbitrary sets `B` and to arbitrary (not necessarily measurable) integrands
`f`, which is convenient since the sector decomposition applies it to the boxes
`acube ℓ ∩ Bᶜ` coming from the corpus.  The hypothesis `hB` is kept because it is part of the
requested interface.
-/

noncomputable section

open MeasureTheory

namespace Work.BoseKinLoc.Sector

set_option linter.unusedVariables false

theorem lintegral_slotBox_slotIso {N : ℕ} (S : Finset (Fin N)) {B : Set (EuclideanSpace ℝ (Fin 3))}
    (hB : MeasurableSet B)
    (f : (Work.PerSector.SlotIn N S → EuclideanSpace ℝ (Fin 3)) → ENNReal) :
    (∫⁻ x in Work.PerSector.slotBox (ι := Fin S.card) B,
        f (fun i : Work.PerSector.SlotIn N S => x (Work.BoseKinLoc.Sector.slotIso S i)))
      = ∫⁻ z in Work.PerSector.slotBox (ι := Work.PerSector.SlotIn N S) B, f z := by
  classical
  -- The re-indexing equivalence: precomposition with `slotIso S` (i.e. with
  -- `((slotIso S).symm).symm`), as a measurable equivalence of the two function spaces.
  let Φ : (Fin S.card → EuclideanSpace ℝ (Fin 3)) ≃ᵐ
      (Work.PerSector.SlotIn N S → EuclideanSpace ℝ (Fin 3)) :=
    MeasurableEquiv.piCongrLeft (fun _ : Work.PerSector.SlotIn N S => EuclideanSpace ℝ (Fin 3))
      (Work.BoseKinLoc.Sector.slotIso S).symm
  -- Its action: `Φ x` is `x` re-indexed by `slotIso S`.
  have hΦ : ∀ (x : Fin S.card → EuclideanSpace ℝ (Fin 3)) (i : Work.PerSector.SlotIn N S),
      Φ x i = x ((Work.BoseKinLoc.Sector.slotIso S) i) := by
    intro x i
    have h1 : Φ x ((Work.BoseKinLoc.Sector.slotIso S).symm
        ((Work.BoseKinLoc.Sector.slotIso S) i)) = x ((Work.BoseKinLoc.Sector.slotIso S) i) :=
      Equiv.piCongrLeft_apply_apply
        (P := fun _ : Work.PerSector.SlotIn N S => EuclideanSpace ℝ (Fin 3))
        (e := (Work.BoseKinLoc.Sector.slotIso S).symm) x
        ((Work.BoseKinLoc.Sector.slotIso S) i)
    rwa [Equiv.symm_apply_apply] at h1
  -- `Φ` preserves the product measure `volume` on the two function spaces.
  have hmp : MeasurePreserving Φ volume volume :=
    volume_measurePreserving_piCongrLeft _ (Work.BoseKinLoc.Sector.slotIso S).symm
  -- `Φ` maps the box `B^{Fin |S|}` onto the box `B^{SlotIn N S}`.
  have himg : Φ '' (Work.PerSector.slotBox (ι := Fin S.card) B) =
      Work.PerSector.slotBox (ι := Work.PerSector.SlotIn N S) B := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩ i
      rw [hΦ x i]
      exact hx ((Work.BoseKinLoc.Sector.slotIso S) i)
    · intro hz
      refine ⟨fun j : Fin S.card => z ((Work.BoseKinLoc.Sector.slotIso S).symm j),
        fun j => hz _, ?_⟩
      funext i
      rw [hΦ _ i]
      simp
  -- Change of variables along `Φ` on the box `B^{Fin |S|}`.
  have key := hmp.setLIntegral_comp_emb Φ.measurableEmbedding f
    (Work.PerSector.slotBox (ι := Fin S.card) B)
  rw [himg] at key
  rw [← key]
  refine lintegral_congr fun x => ?_
  congr 1
  exact (funext fun i => (hΦ x i)).symm

end Work.BoseKinLoc.Sector
