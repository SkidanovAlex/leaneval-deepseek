import Mathlib.Analysis.Normed.Lp.MeasurableSpace
import Mathlib.MeasureTheory.Integral.Bochner.Set
import Mathlib.MeasureTheory.Measure.Haar.OfBasis
import Submission.Work.BoseKinLoc.Sector.fibre_defs_v3
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.BoseKinLoc.Sector

noncomputable section

open MeasureTheory

set_option linter.unusedVariables false

/-- **Re-indexing the slot box for the Bochner integral.**  The order isomorphism
`slotIso S : SlotIn N S ≃ Fin S.card` identifies `SlotIn N S → ℝ³` with `Fin S.card → ℝ³` and maps
the box `slotBox B = B^{SlotIn N S}` bijectively onto `slotBox B = B^{Fin S.card}`.  This is the
`∫`-level (Bochner) companion of `Work.BoseKinLoc.Sector.lintegral_slotBox_slotIso`: for `F` on the
`|S|`-particle side integrable on the box, the integral of `z ↦ F (m ↦ z ((slotIso S).symm m))` over
the `SlotIn`-box equals the integral of `F` over the `Fin S.card`-box.  The re-indexing map is the
measurable equivalence `MeasurableEquiv.piCongrLeft` generated by `(slotIso S).symm`, which is
measure preserving and maps one box onto the other, so the change of variables is
`MeasurePreserving.setIntegral_image_emb`; measurability of `B` is not needed.  Namespace
`Work.BoseKinLoc.Sector`; imports: Mathlib, `Submission.Work.BoseKinLoc.Sector.fibre_defs_v3`,
`Submission.Work.PerSector.Defs`. -/
theorem slotBox_setIntegral_slotIso {N : ℕ} (S : Finset (Fin N)) {B : Set ℝ³}
    (F : (Fin S.card → ℝ³) → ℝ)
    (h : MeasureTheory.IntegrableOn (fun z : Work.PerSector.SlotIn N S → ℝ³ =>
        F (fun m : Fin S.card => z ((slotIso S).symm m)))
      (Work.PerSector.slotBox B : Set (Work.PerSector.SlotIn N S → ℝ³))) :
    (∫ z in (Work.PerSector.slotBox B : Set (Work.PerSector.SlotIn N S → ℝ³)),
        F (fun m : Fin S.card => z ((slotIso S).symm m)))
      = ∫ x in (Work.PerSector.slotBox B : Set (Fin S.card → ℝ³)), F x := by
  classical
  -- The re-indexing equivalence: precomposition with `(slotIso S).symm`, transported to the
  -- Bochner side (the statement's integrand is its `toFun`).
  let Ψ : (Work.PerSector.SlotIn N S → ℝ³) ≃ᵐ (Fin S.card → ℝ³) :=
    MeasurableEquiv.piCongrLeft (fun _ : Fin S.card => ℝ³) (slotIso S)
  -- Its action: `Ψ z m = z ((slotIso S).symm m)`.
  have hΨ : ∀ (z : Work.PerSector.SlotIn N S → ℝ³) (m : Fin S.card),
      Ψ z m = z ((slotIso S).symm m) := by
    intro z m
    have h1 := MeasurableEquiv.piCongrLeft_apply_apply (slotIso S)
      (β := fun _ : Fin S.card => ℝ³) z ((slotIso S).symm m)
    simpa using h1
  -- `Ψ` preserves the product measure `volume` on the two function spaces.
  have hmp : MeasurePreserving Ψ volume volume :=
    volume_measurePreserving_piCongrLeft (fun _ : Fin S.card => ℝ³) (slotIso S)
  -- `Ψ` maps the box `B^{SlotIn N S}` onto the box `B^{Fin S.card}`.
  have himg : Ψ '' (Work.PerSector.slotBox (ι := Work.PerSector.SlotIn N S) B) =
      Work.PerSector.slotBox (ι := Fin S.card) B := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩ k
      rw [hΨ z k]
      exact hz ((slotIso S).symm k)
    · intro hy
      refine ⟨fun i : Work.PerSector.SlotIn N S => y (slotIso S i),
        fun i => hy (slotIso S i), ?_⟩
      funext k
      rw [hΨ _ k]
      simp
  -- Change of variables along `Ψ` on the `SlotIn`-box.
  have key := hmp.setIntegral_image_emb Ψ.measurableEmbedding F
    (Work.PerSector.slotBox (ι := Work.PerSector.SlotIn N S) B)
  rw [himg] at key
  -- The integrand of the goal is exactly the composition `F ∘ Ψ`.
  have hfun : (fun z : Work.PerSector.SlotIn N S → ℝ³ =>
      F (fun m : Fin S.card => z ((slotIso S).symm m))) = fun z => F (Ψ z) := by
    funext z
    congr 1
    exact funext fun m => (hΨ z m).symm
  rw [hfun]
  exact key.symm

end

end Work.BoseKinLoc.Sector
