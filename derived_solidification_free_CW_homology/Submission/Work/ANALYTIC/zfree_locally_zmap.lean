import Mathlib
import Submission.Work.ATOM.Defs
import Submission.Work.FLAT.Setup
import Submission.Work.ATOM.zmap_ext_of_closed_cover
import Submission.Work.ANALYTIC.cover_of_toSheafify_preimage
import Submission.Work.ANALYTIC.finsupp_exists_fin_expansion

/-!
# `ℤ[T]` is locally generated by `zmap`s

For light profinite sets `T` and `U` and a section `y ∈ ℤ[T](U)`, there is a finite cover of `U`
by closed subsets `C i` such that on each `C i` the restriction of `y` is a finite `ℤ`-linear
combination of the maps `ℤ[φ] : ℤ[C i] ⟶ ℤ[T]` (`zmap φ`) induced by continuous maps `φ : C i ⟶ T`.

The proof follows Scholze, *Lectures on Analytic Geometry*, Proposition 2.1: `ℤ[T]` is the
sheafification of the sectionwise free presheaf `P : S ↦ ℤ[Hom(S,T)]`
(`Work.FLAT.free_eq_sheafify_sectionwiseFree`), and the sheafification unit is locally surjective
(`CategoryTheory.Presheaf.isLocallySurjective_toSheafify`).  Locally surjective means that the
image sieve of `y` is covering, and a covering sieve of the coherent topology contains a finite
effective epimorphic (equivalently, jointly surjective) family
(`Work.ANALYTIC.cover_of_toSheafify_preimage`).  On each member of such a family the section is the
image of an explicit element `t : ℤ[Hom(C i,T)]` of the presheaf, i.e. a finite `ℤ`-linear
combination of the generators `freeMk φ = single φ 1`; the unit sends the generator `freeMk φ` to
`homFreeEquiv _ _ (zmap φ)` (`Work.ANALYTIC.zlz_toSheafify_freeMk`).
-/

namespace Work.ANALYTIC

open CategoryTheory Limits LightProfinite LightCondensed MonoidalCategory MonoidalClosed
open _root_.LightCondensed _root_.LightCondensed.Solid Opposite

noncomputable section

section Elementary

/-- The unit of the free-forget adjunction for `R = ℤ` at a type `X` is the canonical inclusion
`x ↦ freeMk x` of the basis of the free module. -/
lemma zlz_ModuleCat_adj_unit_app_apply (X : Type) (x : X) :
    ((ModuleCat.adj ℤ).unit.app X) x = ModuleCat.freeMk x := by
  show ((ModuleCat.adj ℤ).unit.app X).hom x = _
  simp only [ModuleCat.adj, ModuleCat.freeHomEquiv, ModuleCat.freeMk]
  simp only [Adjunction.mkOfHomEquiv_unit_app]
  rfl

end Elementary

/-- The "generic element" of `ℤ[S]` over `S`: the underlying element of the free-forget unit at
`S.toCondensed` evaluated at the identity of `S`. -/
def zlz_unitElem (S : LightProfinite.{0}) : ↥((Work.ATOM.zfree S).obj.obj (op S)) :=
  ((freeForgetAdjunction ℤ).unit.app S.toCondensed).1.app (op S) (𝟙 S)

/-- Evaluation formula for `homFreeEquiv`: it is the evaluation of `g` at the generic element. -/
theorem zlz_homFreeEquiv_eq_eval (S : LightProfinite.{0}) (A : LightCondAb)
    (g : Work.ATOM.zfree S ⟶ A) :
    Work.ATOM.homFreeEquiv S A g = g.1.app (op S) (zlz_unitElem S) := by
  simp only [zlz_unitElem, Work.ATOM.homFreeEquiv]
  rfl

section

set_option backward.isDefEq.respectTransparency false

/-- The generic element of `ℤ[S]` over `S` is the value of the sheafification unit at the canonical
generator `freeMk 𝟙_S` of the sectionwise free presheaf. -/
theorem zlz_unitElem_eq_toSheafify_freeMk (T : LightProfinite.{0}) :
    zlz_unitElem T = (CategoryTheory.toSheafify Work.FLAT.siteJ
      (Work.FLAT.sectionwiseFree T.toCondensed)).app (op T) (ModuleCat.freeMk (𝟙 T)) := by
  rw [zlz_unitElem]
  simp only [LightCondensed.freeForgetAdjunction, CategoryTheory.Sheaf.adjunction_unit_app_hom,
    NatTrans.comp_app, Adjunction.whiskerRight_unit_app_app, Functor.whiskerRight_app]
  rw [ConcreteCategory.comp_apply]
  erw [ConcreteCategory.hom_ofHom]
  erw [zlz_ModuleCat_adj_unit_app_apply]
  show (⇑(ConcreteCategory.hom
      ((CategoryTheory.toSheafify Work.FLAT.siteJ
        (Work.FLAT.sectionwiseFree T.toCondensed)).app (op T))))
      (ModuleCat.freeMk (𝟙 T)) = _
  rfl

/-- The presheaf map `sectionwiseFree T` sends the canonical generator over `T` to the canonical
generator of `φ`. -/
lemma zlz_sectionwiseFree_map_freeMk {C T : LightProfinite.{0}} (φ : C ⟶ T) :
    (Work.FLAT.sectionwiseFree T.toCondensed).map φ.op (ModuleCat.freeMk (𝟙 T))
      = ModuleCat.freeMk φ := by
  show (ModuleCat.free ℤ).map ((T.toCondensed).obj.map φ.op) (ModuleCat.freeMk (𝟙 T)) = _
  rw [ModuleCat.free_map_apply]
  congr 1

/-- The element of `ℤ[S](S)` corresponding to the identity morphism is the generic element. -/
lemma zlz_homFreeEquiv_id (S : LightProfinite.{0}) :
    Work.ATOM.homFreeEquiv S (Work.ATOM.zfree S) (𝟙 (Work.ATOM.zfree S)) = zlz_unitElem S := by
  rw [zlz_homFreeEquiv_eq_eval]
  simp

/-- **The generator computation.**  The sheafification unit sends the generator `freeMk φ` of the
sectionwise free presheaf to the section of `ℤ[T]` classified by `zmap φ`, i.e. to the `ℤ`-linear
combination of `zmap`s consisting of the single term `φ`. -/
theorem zlz_toSheafify_freeMk (C T : LightProfinite.{0}) (φ : C ⟶ T) :
    (CategoryTheory.toSheafify Work.FLAT.siteJ
        (Work.FLAT.sectionwiseFree T.toCondensed)).app (op C) (ModuleCat.freeMk φ)
      = Work.ATOM.homFreeEquiv C (Work.ATOM.zfree T) (Work.ATOM.zmap φ) := by
  have key : Work.ATOM.homFreeEquiv C (Work.ATOM.zfree T) (Work.ATOM.zmap φ)
      = (Work.ATOM.zfree T).obj.map φ.op (zlz_unitElem T) := by
    rw [← Category.comp_id (Work.ATOM.zmap φ), Work.ATOM.homFreeEquiv_zmap]
    rw [zlz_homFreeEquiv_id]
  rw [key, zlz_unitElem_eq_toSheafify_freeMk T]
  rw [← zlz_sectionwiseFree_map_freeMk φ]
  have hnat := NatTrans.naturality_apply (CategoryTheory.toSheafify Work.FLAT.siteJ
    (Work.FLAT.sectionwiseFree T.toCondensed)) φ.op (ModuleCat.freeMk (𝟙 T))
  show (ConcreteCategory.hom ((CategoryTheory.toSheafify Work.FLAT.siteJ
        (Work.FLAT.sectionwiseFree T.toCondensed)).app (op C)))
      (ConcreteCategory.hom ((Work.FLAT.sectionwiseFree T.toCondensed).map φ.op)
        (ModuleCat.freeMk (𝟙 T)))
    = (ConcreteCategory.hom ((CategoryTheory.sheafify Work.FLAT.siteJ
        (Work.FLAT.sectionwiseFree T.toCondensed)).map φ.op))
      (ConcreteCategory.hom ((CategoryTheory.toSheafify Work.FLAT.siteJ
        (Work.FLAT.sectionwiseFree T.toCondensed)).app (op T)) (ModuleCat.freeMk (𝟙 T)))
  exact hnat

end

/-- `homFreeEquiv` is additive in the morphism. -/
lemma zlz_homFreeEquiv_add (S : LightProfinite.{0}) (A : LightCondAb)
    (g g' : Work.ATOM.zfree S ⟶ A) :
    Work.ATOM.homFreeEquiv S A (g + g')
      = Work.ATOM.homFreeEquiv S A g + Work.ATOM.homFreeEquiv S A g' := by
  rw [zlz_homFreeEquiv_eq_eval, zlz_homFreeEquiv_eq_eval, zlz_homFreeEquiv_eq_eval]
  have h : (g + g').1.app (op S) = g.1.app (op S) + g'.1.app (op S) :=
    Sheaf.Hom.add_app g g' (op S)
  rw [h]
  exact LinearMap.add_apply _ _ _

/-- `homFreeEquiv` is `ℤ`-linear in the morphism. -/
lemma zlz_homFreeEquiv_zsmul (S : LightProfinite.{0}) (A : LightCondAb) (n : ℤ)
    (g : Work.ATOM.zfree S ⟶ A) :
    Work.ATOM.homFreeEquiv S A (n • g) = n • Work.ATOM.homFreeEquiv S A g := by
  rw [zlz_homFreeEquiv_eq_eval, zlz_homFreeEquiv_eq_eval]
  have h : (n • g).1.app (op S) = n • g.1.app (op S) := rfl
  rw [h]
  show (n • ⇑(g.1.app (op S))) (zlz_unitElem S) = n • (⇑(g.1.app (op S)) (zlz_unitElem S))
  rfl

/-- `homFreeEquiv` sends `0` to `0`. -/
lemma zlz_homFreeEquiv_zero (S : LightProfinite.{0}) (A : LightCondAb) :
    Work.ATOM.homFreeEquiv S A (0 : Work.ATOM.zfree S ⟶ A) = 0 := by
  rw [zlz_homFreeEquiv_eq_eval]
  simp

/-- `homFreeEquiv` is `ℤ`-linear on finite sums. -/
lemma zlz_homFreeEquiv_finset_sum (S : LightProfinite.{0}) (A : LightCondAb) {ι : Type*}
    (s : Finset ι) (c : ι → ℤ) (g : ι → (Work.ATOM.zfree S ⟶ A)) :
    Work.ATOM.homFreeEquiv S A (∑ i ∈ s, c i • g i)
      = ∑ i ∈ s, c i • Work.ATOM.homFreeEquiv S A (g i) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · rw [Finset.sum_empty, Finset.sum_empty, zlz_homFreeEquiv_zero]
  · intro a s ha ih
    rw [Finset.sum_insert ha, Finset.sum_insert ha, zlz_homFreeEquiv_add,
      zlz_homFreeEquiv_zsmul, ih]

/-- `homFreeEquiv` is `ℤ`-linear on sums indexed by a finite type. -/
lemma zlz_homFreeEquiv_sum_fin {ι : Type} [Fintype ι] (S : LightProfinite.{0}) (A : LightCondAb)
    (c : ι → ℤ) (g : ι → (Work.ATOM.zfree S ⟶ A)) :
    Work.ATOM.homFreeEquiv S A (∑ i, c i • g i)
      = ∑ i, c i • Work.ATOM.homFreeEquiv S A (g i) :=
  zlz_homFreeEquiv_finset_sum S A Finset.univ c g

/-- A morphism of `ℤ`-modules sends a finite `ℤ`-linear combination to the corresponding
combination. -/
lemma zlz_concrete_hom_finset_sum_smul {M N : ModuleCat ℤ} (f : M ⟶ N) {ι : Type}
    (s : Finset ι) (c : ι → ℤ) (g : ι → M) :
    ConcreteCategory.hom f (∑ i ∈ s, c i • g i)
      = ∑ i ∈ s, c i • ConcreteCategory.hom f (g i) := by
  show f.hom (∑ i ∈ s, c i • g i) = ∑ i ∈ s, c i • f.hom (g i)
  rw [map_sum]
  exact Finset.sum_congr rfl (fun i _ => map_zsmul f.hom (c i) (g i))

set_option linter.unusedVariables false in
set_option backward.isDefEq.respectTransparency false in
theorem zfree_locally_zmap (T U : LightProfinite.{0})
    (y : ↥((Work.ATOM.zfree T).obj.obj (Opposite.op U))) :
    ∃ (m : ℕ) (C : Fin m → LightProfinite.{0}) (ι : ∀ i, C i ⟶ U),
      (∀ u : ↥U, ∃ i, ∃ c : ↥(C i), ι i c = u) ∧
      ∃ (k : ∀ i, ℕ) (φ : ∀ i, Fin (k i) → (C i ⟶ T)) (c : ∀ i, Fin (k i) → ℤ),
        ∀ i, ((Work.ATOM.zfree T).obj.map (ι i).op) y
              = Work.ATOM.homFreeEquiv (C i) (Work.ATOM.zfree T)
                  (∑ j, (c i j) • (Work.ATOM.zmap (φ i j))) := by
  classical
  -- `ℤ[T]` is the sheafification of the sectionwise free presheaf on `T`.
  obtain ⟨m, C, ι, hcov, hloc⟩ := cover_of_toSheafify_preimage
      (Work.FLAT.sectionwiseFree T.toCondensed) U y
  -- On each member of the cover, `y` is the image of an explicit section of the presheaf.
  choose t ht using hloc
  -- Such a section is a finite `ℤ`-linear combination of generators `freeMk φ`.
  choose k φ c hφ using fun i => finsupp_exists_fin_expansion ((C i ⟶ T)) (t i)
  refine ⟨m, C, ι, hcov, k, φ, c, fun i => ?_⟩
  show ConcreteCategory.hom ((CategoryTheory.sheafify Work.FLAT.siteJ
      (Work.FLAT.sectionwiseFree T.toCondensed)).map (ι i).op) y
    = Work.ATOM.homFreeEquiv (C i) (Work.ATOM.zfree T)
        (∑ j, (c i j) • (Work.ATOM.zmap (φ i j)))
  rw [← ht i, hφ i]
  rw [show (∑ j : Fin (k i), (c i j) • Finsupp.single (φ i j) (1 : ℤ))
      = ∑ j : Fin (k i), (c i j) • ModuleCat.freeMk (φ i j) from rfl]
  -- The unit is `ℤ`-linear, and sends generators to `zmap`s.
  rw [show ConcreteCategory.hom ((CategoryTheory.toSheafify Work.FLAT.siteJ
        (Work.FLAT.sectionwiseFree T.toCondensed)).app (op (C i)))
        (∑ j : Fin (k i), (c i j) • ModuleCat.freeMk (φ i j))
      = ∑ j : Fin (k i), (c i j) • ConcreteCategory.hom ((CategoryTheory.toSheafify
          Work.FLAT.siteJ (Work.FLAT.sectionwiseFree T.toCondensed)).app (op (C i)))
            (ModuleCat.freeMk (φ i j)) from
        zlz_concrete_hom_finset_sum_smul _ _ _ _]
  rw [show (∑ j : Fin (k i), (c i j) • ConcreteCategory.hom ((CategoryTheory.toSheafify
          Work.FLAT.siteJ (Work.FLAT.sectionwiseFree T.toCondensed)).app (op (C i)))
            (ModuleCat.freeMk (φ i j)))
      = ∑ j : Fin (k i), (c i j) • Work.ATOM.homFreeEquiv (C i) (Work.ATOM.zfree T)
            (Work.ATOM.zmap (φ i j)) from
        Finset.sum_congr rfl (fun j _ => by rw [zlz_toSheafify_freeMk])]
  rw [zlz_homFreeEquiv_sum_fin]

end

end Work.ANALYTIC
