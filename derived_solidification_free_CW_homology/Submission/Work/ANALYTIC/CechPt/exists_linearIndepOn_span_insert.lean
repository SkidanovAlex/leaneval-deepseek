import Mathlib

/-!
# Extending a set-basis of `N ⊓ ℤ[Y]` by one coordinate

Let `N` be a `ℤ`-submodule of the free module `X →₀ ℤ` of finitely supported functions on `X`, let
`Y ⊆ X`, and let `B` be a `ℤ`-basis (as a linearly independent set spanning `N ⊓ ℤ[Y]`, where
`ℤ[Y] = Finsupp.supported ℤ ℤ Y` is the submodule of functions supported on `Y`).  For `x ∉ Y` we
show that `B` can be extended to a set-basis of `N ⊓ ℤ[Y ∪ {x}]`.

The mathematical content is that the quotient

`(N ⊓ ℤ[Y ∪ {x}]) / (N ⊓ ℤ[Y])`

embeds into `ℤ` via evaluation of the coefficient at `x` (an element supported on `insert x Y`
whose `x`-coefficient vanishes is supported on `Y`), hence is a subgroup of `ℤ`, so it is generated
by a single integer `k`: there is `f ∈ N ⊓ ℤ[Y ∪ {x}]` with `f x = k`, and `k` divides the
`x`-coefficient of every element of `N ⊓ ℤ[Y ∪ {x}]`.  Adding such an `f` to `B` (in the degenerate
case `k = 0` one just keeps `B`) gives the required basis: for `g` in the bigger submodule the
element `g - c • f` with `g x = k * c` has vanishing `x`-coefficient, hence lies in
`N ⊓ ℤ[Y] = span B`.

This is the extension step of the Zorn argument showing that submodules of free `ℤ`-modules are
free (`Work.ANALYTIC.CechPt.free_submodule_of_free`).
-/

namespace Work.ANALYTIC.CechPt

/-- If `h` is supported on `insert x Y` and its `x`-coefficient vanishes, then `h` is supported
on `Y`. -/
private lemma aux_supp {X : Type*} {Y : Set X} {x : X} {h : X →₀ ℤ}
    (hh : h ∈ Finsupp.supported ℤ ℤ (insert x Y)) (h0 : h x = 0) :
    h ∈ Finsupp.supported ℤ ℤ Y := by
  rw [Finsupp.mem_supported] at hh ⊢
  intro y hy
  have h1 : y = x ∨ y ∈ Y := by simpa using hh hy
  rcases h1 with rfl | hyY
  · exact absurd h0 (Finsupp.mem_support_iff.mp hy)
  · exact hyY

/-- The `x`-coefficients of the elements of a `ℤ`-submodule `M ≤ X →₀ ℤ` form a subgroup of `ℤ`,
hence are generated by one integer `k`: some `f ∈ M` has `f x = k`, and `k` divides the
`x`-coefficient of every element of `M`. -/
private lemma aux_dvd {X : Type*} (M : Submodule ℤ (X →₀ ℤ)) (x : X) :
    ∃ (k : ℤ) (f : X →₀ ℤ), f ∈ M ∧ f x = k ∧ ∀ g ∈ M, k ∣ g x := by
  classical
  set φ : M →ₗ[ℤ] ℤ := (Finsupp.lapply x).comp M.subtype with hφ
  have hprin : (LinearMap.range φ).IsPrincipal := IsPrincipalIdealRing.principal _
  let k : ℤ := Classical.choose hprin.principal
  have hk : LinearMap.range φ = Submodule.span ℤ {k} := Classical.choose_spec hprin.principal
  have hmem : k ∈ LinearMap.range φ := by
    rw [hk]; exact Submodule.subset_span (Set.mem_singleton k)
  have hex : ∃ f : M, φ f = k := LinearMap.mem_range.mp hmem
  refine ⟨k, (hex.choose : X →₀ ℤ), hex.choose.2, ?_, ?_⟩
  · simpa [φ] using hex.choose_spec
  · intro g hg
    have h1 : φ ⟨g, hg⟩ ∈ Submodule.span ℤ {k} := by
      rw [← hk]; exact ⟨⟨g, hg⟩, rfl⟩
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp h1
    have haz : a * k = g x := by simpa [φ, smul_eq_mul] using ha
    exact dvd_def.mpr ⟨a, by rw [← haz, mul_comm]⟩

theorem exists_linearIndepOn_span_insert {X : Type*} (N : Submodule ℤ (X →₀ ℤ)) (Y : Set X)
    (B : Set (X →₀ ℤ)) (hli : LinearIndepOn ℤ id B)
    (hsp : Submodule.span ℤ B = N ⊓ Finsupp.supported ℤ ℤ Y) {x : X} (hx : x ∉ Y) :
    ∃ B' : Set (X →₀ ℤ), B ⊆ B' ∧ LinearIndepOn ℤ id B' ∧
      Submodule.span ℤ B' = N ⊓ Finsupp.supported ℤ ℤ (insert x Y) := by
  classical
  have hsubY : Finsupp.supported ℤ ℤ Y ≤ Finsupp.supported ℤ ℤ (insert x Y) :=
    Finsupp.supported_mono (Set.subset_insert x Y)
  obtain ⟨k, f, hfM, hfx, hkdvd⟩ := aux_dvd (N ⊓ Finsupp.supported ℤ ℤ (insert x Y)) x
  by_cases hk : k = 0
  · -- The `x`-coefficient vanishes on the bigger submodule: nothing has to be added.
    refine ⟨B, Set.Subset.rfl, hli, ?_⟩
    rw [hsp]
    refine le_antisymm (le_inf inf_le_left (le_trans inf_le_right hsubY)) ?_
    rintro g ⟨hgN, hgs⟩
    refine ⟨hgN, aux_supp hgs ?_⟩
    have h := hkdvd g ⟨hgN, hgs⟩
    rw [hk] at h
    exact zero_dvd_iff.mp h
  · -- The `x`-coefficient generates a non-trivial subgroup: adjoin `f` to `B`.
    have hf0 : f ≠ 0 := by
      intro h
      rw [h] at hfx
      exact hk (by simpa using hfx.symm)
    have hBM : ∀ b ∈ B, b ∈ N ⊓ Finsupp.supported ℤ ℤ (insert x Y) := by
      intro b hb
      have hb' : b ∈ N ⊓ Finsupp.supported ℤ ℤ Y := hsp ▸ Submodule.subset_span hb
      exact ⟨hb'.1, hsubY hb'.2⟩
    refine ⟨insert f B, Set.subset_insert f B, ?_, ?_⟩
    · -- Linear independence: `f` does not lie in `span B`.
      have hdj : Disjoint (Submodule.span ℤ B) (Submodule.span ℤ ({f} : Set (X →₀ ℤ))) := by
        rw [Submodule.disjoint_def]
        intro z hzB hzf
        obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hzf
        have hzY : z ∈ N ⊓ Finsupp.supported ℤ ℤ Y := hsp ▸ hzB
        have hzx : z x = 0 := (Finsupp.mem_supported' ℤ z).1 hzY.2 x hx
        have haz : z x = a * k := by
          rw [← ha]
          simp only [Finsupp.smul_apply, smul_eq_mul, hfx]
        have h1 : a = 0 := by
          have h2 : a * k = 0 := by rw [← haz, hzx]
          rcases Int.mul_eq_zero.mp h2 with h | h
          · exact h
          · exact absurd h hk
        rw [← ha, h1, zero_smul]
      have hid := LinearIndepOn.id_union (s := B) (t := {f}) hli
        (LinearIndepOn.singleton (v := id) (i := f) (by simpa using hf0)) hdj
      rw [Set.insert_eq, Set.union_comm]
      exact hid
    · -- The span is the whole bigger submodule.
      rw [Submodule.span_insert, hsp]
      refine le_antisymm (sup_le ?_ ?_) ?_
      · exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hfM)
      · exact le_inf inf_le_left (le_trans inf_le_right hsubY)
      · rw [← hsp]
        intro g hg
        obtain ⟨c, hc⟩ := hkdvd g hg
        have hh1 : g - c • f ∈ N := N.sub_mem hg.1 (N.smul_mem c hfM.1)
        have hh2 : g - c • f ∈ Finsupp.supported ℤ ℤ (insert x Y) :=
          Submodule.sub_mem _ hg.2 (Submodule.smul_mem _ c hfM.2)
        have hh0 : (g - c • f) x = 0 := by
          simp only [Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul, hfx, hc]
          ring
        have hhY : g - c • f ∈ Finsupp.supported ℤ ℤ Y := aux_supp hh2 hh0
        have hh : g - c • f ∈ Submodule.span ℤ B :=
          hsp.symm ▸ (show g - c • f ∈ N ⊓ Finsupp.supported ℤ ℤ Y from ⟨hh1, hhY⟩)
        have hmem2 : c • f ∈ Submodule.span ℤ {f} ⊔ Submodule.span ℤ B :=
          Submodule.mem_sup_left
            (Submodule.smul_mem _ c (Submodule.subset_span (Set.mem_singleton f)))
        have hsum : (g - c • f) + c • f ∈ Submodule.span ℤ {f} ⊔ Submodule.span ℤ B :=
          add_mem (Submodule.mem_sup_right hh) hmem2
        simpa using hsum

end Work.ANALYTIC.CechPt
