import Submission.Work.ATOM.Defs

namespace Work.ANALYTIC

open CategoryTheory Limits LightProfinite LightCondensed MonoidalCategory MonoidalClosed

namespace Work.ANALYTIC

open _root_.LightCondensed
open Opposite

/-- The value at the point of the free light condensed abelian group `ℤ[∗]` on one generator is
the line generated by the canonical generator `e₁ = homFreeEquiv ∗ 𝟙`: every element of `ℤ[∗](∗)`
is an integer multiple of `e₁`.  Route: `Work.ATOM.ZS.Unred.LCZ_iso` gives an isomorphism
`ℤ[∗] ≅ LCZ` (`LCZ` the sheaf `S ↦ LocallyConstant ↥S ℤ`) carrying `e₁` to
`oneLCZ = LocallyConstant.const ∗ 1`; on the point `LCZ(∗) = LocallyConstant ↥∗ ℤ ≅ ℤ` via
evaluation at the unique point, so every element is a multiple of `oneLCZ`. -/
theorem zfree_pt_value (x : ↥((Work.ATOM.zfree Work.ATOM.pt).obj.obj (Opposite.op Work.ATOM.pt))) :
    ∃ k : ℤ, x = k • (Work.ATOM.homFreeEquiv Work.ATOM.pt (Work.ATOM.zfree Work.ATOM.pt)
      (𝟙 (Work.ATOM.zfree Work.ATOM.pt))) := by
  -- The iso `ℤ[∗] ≅ LCZ` of `LCZ_iso`, and the fact that it carries `e₁` to `oneLCZ`.
  obtain ⟨e, he⟩ := Work.ATOM.ZS.Unred.LCZ_iso
  -- On the point, the iso is a bijection: `e.inv` inverts `e.hom` on sections.
  have hcomp : ∀ y : ↥((Work.ATOM.zfree Work.ATOM.pt).obj.obj (Opposite.op Work.ATOM.pt)),
      CategoryTheory.ConcreteCategory.hom (e.inv.hom.app (Opposite.op Work.ATOM.pt))
        (CategoryTheory.ConcreteCategory.hom (e.hom.hom.app (Opposite.op Work.ATOM.pt)) y) = y := by
    intro y
    have h2 : e.hom.hom ≫ e.inv.hom = 𝟙 ((Work.ATOM.zfree Work.ATOM.pt).obj) := by
      simp
    calc CategoryTheory.ConcreteCategory.hom (e.inv.hom.app (Opposite.op Work.ATOM.pt))
            (CategoryTheory.ConcreteCategory.hom (e.hom.hom.app (Opposite.op Work.ATOM.pt)) y)
        = CategoryTheory.ConcreteCategory.hom
            (e.hom.hom.app (Opposite.op Work.ATOM.pt) ≫
              e.inv.hom.app (Opposite.op Work.ATOM.pt)) y := by
          rw [CategoryTheory.ConcreteCategory.comp_apply]
      _ = CategoryTheory.ConcreteCategory.hom
            ((e.hom.hom ≫ e.inv.hom).app (Opposite.op Work.ATOM.pt)) y := by
          rw [NatTrans.comp_app]
      _ = y := by rw [h2]; simp
  -- Consequently `e.inv` sends the generator `oneLCZ` back to `e₁`.
  have he1 : CategoryTheory.ConcreteCategory.hom (e.inv.hom.app (Opposite.op Work.ATOM.pt))
      Work.ATOM.ZS.Unred.oneLCZ = Work.ATOM.ZS.Unred.e1 := by
    rw [← he]
    exact hcomp Work.ATOM.ZS.Unred.e1
  -- `LCZ(∗) = LocallyConstant ↥∗ ℤ` is spanned by the constant function `1`: on a one point
  -- space a locally constant function is determined by its value.
  have hgen : ∃ k : ℤ,
      CategoryTheory.ConcreteCategory.hom (e.hom.hom.app (Opposite.op Work.ATOM.pt)) x
        = k • Work.ATOM.ZS.Unred.oneLCZ := by
    set z : LocallyConstant ↥Work.ATOM.pt.toTop ℤ :=
      CategoryTheory.ConcreteCategory.hom (e.hom.hom.app (Opposite.op Work.ATOM.pt)) x
    refine ⟨z (Classical.arbitrary ↥Work.ATOM.pt.toTop), ?_⟩
    apply LocallyConstant.ext
    intro s
    rw [Subsingleton.elim s (Classical.arbitrary ↥Work.ATOM.pt.toTop)]
    change z (Classical.arbitrary ↥Work.ATOM.pt.toTop) =
      ((z (Classical.arbitrary ↥Work.ATOM.pt.toTop)) •
        (LocallyConstant.const ↥Work.ATOM.pt.toTop (1 : ℤ)))
          (Classical.arbitrary ↥Work.ATOM.pt.toTop)
    simp only [LocallyConstant.coe_smul, Pi.smul_apply, LocallyConstant.coe_const,
      Function.const_apply, smul_eq_mul, mul_one]
  obtain ⟨k, hk⟩ := hgen
  refine ⟨k, ?_⟩
  rw [← hcomp x, hk, Work.ATOM.ZS.Unred.section_map_smul, he1]

end Work.ANALYTIC

/-- The statement of `Work.ANALYTIC.Work.ANALYTIC.zfree_pt_value` under the name
`Work.ANALYTIC.zfree_pt_value`, which is the name derived from the module path
