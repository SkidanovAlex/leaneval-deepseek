import Mathlib
import ChallengeDeps
import Submission.Work.HOMOL.Basic

/-!
# AREA HOMOL — the constant ("discrete") sheaf functor is exact

`LightCondensed.discrete (ModuleCat R)`, the constant sheaf of `R`-modules on the coherent site
of light profinite sets, is the composite `Functor.const _ ⋙ presheafToSheaf _ _`
(`constantSheaf`). Sheafification for the coherent topology is left exact
(`CategoryTheory.GrothendieckTopology.preservesFiniteLimits_presheafToSheaf`, available since the
topology is finitary and generated by finitely many effective epimorphisms), and `Functor.const`
preserves all limits, so `discrete` preserves finite limits. It is a left adjoint
(`LightCondensed.discreteUnderlyingAdj`, with right adjoint the "underlying" functor `X ↦ X(∗)`),
so it preserves colimits.

Consequently `discrete` is *exact*, i.e. `Functor.PreservesHomology`, which is what allows us
to move it in and out of homology (`REFS/05 §4`, second bullet: "`discrete` is exact (it is
sheafification of a constant presheaf) so it commutes with homology").

The instances are registered under `Work.HOMOL.*` so as not to claim names in the `LightCondensed`
namespace; they are global instances nevertheless (instance search finds them as soon as this
module is imported). They are stated for an arbitrary ring `R`, so they are available for every
`LightCondMod R` and not only for `ℤ`.
-/

noncomputable section

open CategoryTheory Limits

namespace Work.HOMOL

universe u

variable (R : Type u) [Ring R]

/-- The constant sheaf functor to light condensed `R`-modules preserves finite limits. -/
instance discretePreservesFiniteLimits :
    PreservesFiniteLimits (LightCondensed.discrete (ModuleCat.{u} R)) :=
  comp_preservesFiniteLimits _ _

/-- The constant sheaf functor to light condensed `R`-modules preserves colimits (it is a left
adjoint, namely to `LightCondensed.underlying`). -/
instance discretePreservesColimits :
    PreservesColimits (LightCondensed.discrete (ModuleCat.{u} R)) :=
  (LightCondensed.discreteUnderlyingAdj (ModuleCat.{u} R)).leftAdjoint_preservesColimits

/-- The constant sheaf functor to light condensed `R`-modules preserves finite colimits. -/
instance discretePreservesFiniteColimits :
    PreservesFiniteColimits (LightCondensed.discrete (ModuleCat.{u} R)) :=
  PreservesColimits.preservesFiniteColimits _

/-- **The discrete functor is exact**: it preserves kernels and cokernels. -/
instance discretePreservesHomology :
    (LightCondensed.discrete (ModuleCat.{u} R)).PreservesHomology :=
  Functor.preservesHomologyOfExact _

open LightCondensed in
/-- `LightCondensed.discrete` on `ℤ`-modules commutes with homology of complexes: the `i`-th
homology of the degreewise discretisation of a complex of abelian groups is the discretisation of
its `i`-th homology. -/
noncomputable def discreteHomologyIso {ι : Type*} (c : ComplexShape ι)
    (K : HomologicalComplex (ModuleCat.{0} ℤ) c) (i : ι) :
    (((discrete (ModuleCat ℤ)).mapHomologicalComplex c).obj K).homology i ≅
      (discrete (ModuleCat ℤ)).obj (K.homology i) :=
  mapHomologicalComplexHomologyIso_app c (discrete (ModuleCat ℤ)) i K

end Work.HOMOL
