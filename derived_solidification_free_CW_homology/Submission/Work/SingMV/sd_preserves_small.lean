import Mathlib
import Submission.Work.SINGMV.Defs
import Submission.Work.SingMV.sddeg_naturality
import Submission.Work.SingMV.gen_d
import Submission.Work.SingMV.smallSpan_inf

/-!
# The barycentric subdivision preserves (U,V)-small chains

`Work.SingMV.sddeg X n` is the degreewise barycentric subdivision on the integral singular
`n`-chains of a topological space `X`; `Work.SingMV.smallChain X n U V` is the submodule of
chains generated by the singular simplices whose image lies in `U` or in `V` (Hatcher's
"`(U,V)`-small chains").

The purpose of this file is the elementary chain-level fact underlying the proof that every
chain becomes small after enough subdivisions:

**`Work.SingMV.sd_preserves_small`**: if `z` is `(U,V)`-small then so is `sddeg X n z`.

## Proof

Since `sddeg X n` is `ℤ`-linear and `smallChain X n U V = smallSpan X n U ⊔ smallSpan X n V`,
it suffices to show that `sddeg X n` maps the *generators* of `smallSpan X n U` into
`smallSpan X n U` (and similarly for `V`), i.e. that

`sddeg X n (gen X n σ) ∈ smallSpan X n U` whenever the image of `σ : Δⁿ ⟶ X` lies in `U`.

Now `sddeg X n (gen X n σ)` is the pushforward of the subdivision `Sd n` of the fundamental
simplex `Δⁿ` along `σ` (`sddeg_gen`), and `Sd n` is a `ℤ`-linear combination of the generators
of `C_n(Δⁿ)` (`span_gen_eq_top`: the singular `n`-chains are the coproduct of one copy of `ℤ`
per singular `n`-simplex, so the generators span the whole module).  Pushing forward a generator
`gen (tSplx n) n γ` along `σ` gives `gen X n (σ ∘ γ)` (`singC_map_gen_apply`), and `σ ∘ γ` has
image in `U`, so every term of the pushed-forward combination lies in `smallSpan X n U`.
-/

open CategoryTheory Limits Convexity
open scoped BigOperators Simplicial

noncomputable section

namespace Work.SingMV

/-! ## Elementary API for morphisms out of `ℤ` and for the singular simplex bijection -/

/-- Two morphisms out of `ℤ` (in `ModuleCat ℤ`) are equal as soon as they agree on `1`. -/
lemma hom_int_ext {M : ModuleCat ℤ} {f g : ModuleCat.of ℤ ℤ ⟶ M} (h : f (1 : ℤ) = g (1 : ℤ)) :
    f = g := by
  apply ModuleCat.hom_ext
  exact LinearMap.ext_ring h

/-- Naturality of the identification of simplices of the singular simplicial set with continuous
maps out of the standard simplex, with respect to a continuous map of spaces. -/
lemma singEquiv_map (X Y : TopCat) (f : X ⟶ Y) (n : ℕ)
    (x : (TopCat.toSSet.obj X).obj (Opposite.op (SimplexCategory.mk n))) :
    Work.SingMV.singEquiv Y n ((TopCat.toSSet.map f).app (Opposite.op (SimplexCategory.mk n)) x)
      = f.hom.comp (Work.SingMV.singEquiv X n x) := rfl

/-! ## The subdivision on a generator, and pushforwards of generators -/

/-- **The value of the subdivision on a singular chain generator**: `sddeg X n (gen X n σ)` is the
pushforward of the subdivision `Sd n` of the fundamental simplex along `σ`. -/
lemma sddeg_gen (X : TopCat) (n : ℕ) (σ : Work.SingMV.singMap X n) :
    Work.SingMV.sddeg X n (Work.SingMV.gen X n σ) =
      ((Submission.Blueprint.singC.map (TopCat.ofHom σ)).f n (Work.SingMV.Sd n)) := by
  let x := (Work.SingMV.singEquiv X n).symm σ
  have hfac := Work.SingMV.sddeg_fac X n x
  have h := congrArg (fun f => f (1 : ℤ)) hfac
  rw [CategoryTheory.comp_apply] at h
  rw [ModuleCat.ofHom_apply, LinearMap.toSpanSingleton_apply_one] at h
  have hx : (ConcreteCategory.hom (Work.SingMV.genHom X n x)) (1 : ℤ)
      = Work.SingMV.gen X n σ := rfl
  rw [hx] at h
  have hx2 : (Work.SingMV.singEquiv X n) x = σ := by simp [x]
  rw [hx2] at h
  exact h

/-- **Pushforward of a singular chain generator**: the map on singular chains induced by
`f : X ⟶ Y` sends the generator of a simplex `γ` to the generator of the composite `f ∘ γ`. -/
lemma singC_map_gen_apply (X Y : TopCat) (f : X ⟶ Y) (n : ℕ) (γ : Work.SingMV.singMap X n) :
    (Submission.Blueprint.singC.map f).f n (Work.SingMV.gen X n γ)
      = Work.SingMV.gen Y n (f.hom.comp γ) := by
  have h := congrArg (fun m => (ConcreteCategory.hom m) (1 : ℤ))
    (Work.SingMV.genHom_comp X Y f n ((Work.SingMV.singEquiv X n).symm γ))
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  have hnat : (ConcreteCategory.hom ((TopCat.toSSet.map f).app (Opposite.op (SimplexCategory.mk n))))
        ((Work.SingMV.singEquiv X n).symm γ)
      = (Work.SingMV.singEquiv Y n).symm (f.hom.comp γ) := by
    rw [← Equiv.symm_apply_apply (Work.SingMV.singEquiv Y n)
      ((ConcreteCategory.hom ((TopCat.toSSet.map f).app (Opposite.op (SimplexCategory.mk n))))
        ((Work.SingMV.singEquiv X n).symm γ))]
    rw [singEquiv_map, Equiv.apply_symm_apply]
  rw [hnat] at h
  simp only [Work.SingMV.gen, Work.SingMV.genHom] at h ⊢
  exact h

/-! ## The generators span the singular chains -/

/-- The singular `n`-chains of `X` are spanned by the generators `gen X n σ` attached to the
singular `n`-simplices `σ : Δⁿ ⟶ X`.  (The singular `n`-chains are the coproduct of one copy of
`ℤ` per singular `n`-simplex, so its summand inclusions span the whole module; in particular the
subdivision `Sd n` of the fundamental simplex is a linear combination of generators.) -/
theorem span_gen_eq_top (X : TopCat) (n : ℕ) :
    Submodule.span ℤ (Set.range (Work.SingMV.gen X n)) = ⊤ := by
  -- Under `eLin`, the span of the generators becomes the span of the basis vectors `single σ 1`.
  have himg : ⇑(SmallSpanAux.eLin X n).toLinearMap '' Set.range (Work.SingMV.gen X n) =
      Set.range (fun σ : Work.SingMV.singMap X n => Finsupp.single σ (1 : ℤ)) := by
    ext y
    constructor
    · rintro ⟨_, ⟨σ, rfl⟩, rfl⟩
      exact ⟨σ, (SmallSpanAux.eLin_gen X n σ).symm⟩
    · rintro ⟨σ, rfl⟩
      exact ⟨Work.SingMV.gen X n σ, ⟨σ, rfl⟩, SmallSpanAux.eLin_gen X n σ⟩
  have hmap : Submodule.map (SmallSpanAux.eLin X n).toLinearMap
      (Submodule.span ℤ (Set.range (Work.SingMV.gen X n))) = ⊤ := by
    rw [Submodule.map_span, himg]
    rw [show Set.range (fun σ : Work.SingMV.singMap X n => Finsupp.single σ (1 : ℤ)) =
        (fun i => Finsupp.single i (1 : ℤ)) '' (Set.univ : Set (Work.SingMV.singMap X n))
        from Set.image_univ.symm]
    rw [← Finsupp.supported_eq_span_single, Finsupp.supported_univ]
  refine Submodule.eq_top_iff'.mpr fun z => ?_
  have hz : (SmallSpanAux.eLin X n) z ∈ Submodule.map (SmallSpanAux.eLin X n).toLinearMap
      (Submodule.span ℤ (Set.range (Work.SingMV.gen X n))) := by
    rw [hmap]
    exact Submodule.mem_top
  obtain ⟨w, hw, hwe⟩ := Submodule.mem_map.mp hz
  have hwz : w = z := (SmallSpanAux.eLin X n).injective hwe
  rwa [hwz] at hw

/-! ## The subdivision of a generator of a small chain is small -/

/-- A map of singular chain complexes sends a chain into the span of the *pushforwards of the
generators*: the pushforward of a generator is the generator of the composite simplex
(`singC_map_gen_apply`), and the generators span all chains (`span_gen_eq_top`). -/
lemma map_mem_span_range (X Y : TopCat) (f : X ⟶ Y) (n : ℕ)
    (z : ((Submission.Blueprint.singC).obj X).X n) :
    (Submission.Blueprint.singC.map f).f n z ∈
      Submodule.span ℤ (Set.range (fun σ : Work.SingMV.singMap X n =>
        Work.SingMV.gen Y n (f.hom.comp σ))) := by
  have hz : z ∈ Submodule.span ℤ (Set.range (Work.SingMV.gen X n)) := by
    rw [span_gen_eq_top]
    exact Submodule.mem_top
  have hmem : ((Submission.Blueprint.singC.map f).f n).hom z ∈
      Submodule.span ℤ (⇑((Submission.Blueprint.singC.map f).f n).hom ''
        Set.range (Work.SingMV.gen X n)) := by
    have h := Submodule.mem_map_of_mem
      (f := ((Submission.Blueprint.singC.map f).f n).hom) hz
    rwa [Submodule.map_span] at h
  refine (Submodule.span_le.mpr ?_) hmem
  rintro y ⟨a, ⟨σ, rfl⟩, rfl⟩
  exact Submodule.subset_span ⟨σ, (singC_map_gen_apply X Y f n σ).symm⟩

/-- If the image of a singular simplex `σ : Δⁿ ⟶ X` lies in `U`, then the subdivision of the
corresponding chain generator is a linear combination of simplices lying in `U`. -/
lemma sddeg_gen_mem_smallSpan (X : TopCat) (n : ℕ) (U : Set X) (σ : Work.SingMV.singMap X n)
    (hσ : ∀ x, σ x ∈ U) :
    Work.SingMV.sddeg X n (Work.SingMV.gen X n σ) ∈ Work.SingMV.smallSpan X n U := by
  rw [sddeg_gen]
  -- `Sd n` is a linear combination of the generators of `C_n(Δⁿ)`; hence its pushforward along
  -- `σ` is a linear combination of pushforwards of generators, each of which is a generator of a
  -- simplex whose image lies in `U`.
  refine (Submodule.span_le.mpr ?_) (map_mem_span_range (Work.SingMV.tSplx n) X (TopCat.ofHom σ)
    n (Work.SingMV.Sd n))
  rintro y ⟨σ', rfl⟩
  exact Submodule.subset_span ⟨⟨σ.comp σ', fun x => hσ (σ' x)⟩, rfl⟩

/-! ## The main statement -/

/-- **The barycentric subdivision preserves `(U,V)`-small chains**: if `z` is a linear combination
of singular simplices each lying in `U` or in `V`, then so is `sddeg X n z`. -/
theorem sd_preserves_small (X : TopCat) (n : ℕ) (U V : Set X) (z : ((Submission.Blueprint.singC).obj X).X n) :
    z ∈ Work.SingMV.smallChain X n U V → Work.SingMV.sddeg X n z ∈ Work.SingMV.smallChain X n U V := by
  intro hz
  have hU : Submodule.map (Work.SingMV.sddeg X n).hom (Work.SingMV.smallSpan X n U) ≤
      Work.SingMV.smallSpan X n U := by
    rw [Work.SingMV.smallSpan, Submodule.map_span_le]
    rintro _ ⟨⟨σ, hσ⟩, rfl⟩
    exact sddeg_gen_mem_smallSpan X n U σ hσ
  have hV : Submodule.map (Work.SingMV.sddeg X n).hom (Work.SingMV.smallSpan X n V) ≤
      Work.SingMV.smallSpan X n V := by
    rw [Work.SingMV.smallSpan, Submodule.map_span_le]
    rintro _ ⟨⟨σ, hσ⟩, rfl⟩
    exact sddeg_gen_mem_smallSpan X n V σ hσ
  have hmap : Submodule.map (Work.SingMV.sddeg X n).hom (Work.SingMV.smallChain X n U V) ≤
      Work.SingMV.smallChain X n U V := by
    rw [Work.SingMV.smallChain, Submodule.map_sup]
    exact sup_le (hU.trans le_sup_left) (hV.trans le_sup_right)
  exact hmap (Submodule.mem_map_of_mem hz)

end Work.SingMV
