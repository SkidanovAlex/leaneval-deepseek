import Mathlib
import Submission.Work.SINGMV.Defs

/-!
# Barycentric subdivision tuples and the span of the subdivision simplices

The barycentric subdivision of the fundamental `n`-simplex `Δⁿ` (`Work.SingMV.Sd n`) is a chain
which is a linear combination of the *affine* `n`-simplices of `Δⁿ` of a special kind: their
vertex tuples are chains of barycenters of nonempty vertex sets

  `A 0 ⊆ A 1 ⊆ ⋯ ⊆ A n`,   `q i = subBarycenter (A i) (hA i)`.

More generally, in the recursion `Sd (n+1) = ± cone (∂ Sd n)` the intermediate chains
(`SdBdry`, and the cone over them) involve such tuples of a length `L` different from the ambient
dimension; this file records the general notion (`Tup M L`: tuples `Fin L → Δ^M`) and the span
`tupSpan M L` of the corresponding generators of the singular `L`-chains of `Δ^M`.

The main use is the shrinking of the mesh under subdivision: a `Tup` tuple is a chain of
barycenters, so the elementary estimate `subBarycenter_dist_le` applies to it, giving that the
mesh shrinks by the factor `n/(n+1)` at every subdivision step.
-/

open CategoryTheory Limits Convexity
open scoped BigOperators Simplicial

noncomputable section

namespace Work.SingMV

/-- **A barycentric subdivision tuple.** A tuple `q : Fin L → Δ^M` of points of the standard
`M`-simplex is a subdivision tuple if it consists of the barycenters of an increasing family of
nonempty subsets of the vertices of `Δ^M`. These are the vertex tuples occurring in the iterated
barycentric subdivision of `Δ^M` (of any length `L`). -/
def Tup (M L : ℕ) (q : Fin L → StdSimplex ℝ (Fin (M+1))) : Prop :=
  ∃ (A : Fin L → Finset (Fin (M+1))) (hA : ∀ i, (A i).Nonempty),
    (∀ i j, i ≤ j → A i ⊆ A j) ∧ q = fun i => StdSimplex.subBarycenter (A i) (hA i)

/-- A tuple of barycenters, from an explicitly given increasing family of nonempty vertex sets. -/
lemma Tup.mk {M L : ℕ} (A : Fin L → Finset (Fin (M+1))) (hA : ∀ i, (A i).Nonempty)
    (hmono : ∀ i j, i ≤ j → A i ⊆ A j) :
    Tup M L (fun i => StdSimplex.subBarycenter (A i) (hA i)) :=
  ⟨A, hA, hmono, rfl⟩

/-- **The span of the subdivision simplices.** The `ℤ`-submodule of the singular `L`-chains of
`Δ^M` generated by the affine simplices `affineSimplex q` whose vertex tuples `q` are barycentric
subdivision tuples (`Tup M (L+1)`). -/
def tupSpan (M L : ℕ) : Submodule ℤ (((Submission.Blueprint.singC).obj (tSplx M)).X L) :=
  Submodule.span ℤ (Set.range (fun q : {q : Fin (L+1) → StdSimplex ℝ (Fin (M+1)) //
      Tup M (L+1) q} => gen (tSplx M) L (affineSimplex q.1)))

/-- Membership in `tupSpan` from a subdivision tuple. -/
lemma gen_affineSimplex_mem_tupSpan {M L : ℕ} {q : Fin (L+1) → StdSimplex ℝ (Fin (M+1))}
    (hq : Tup M (L+1) q) : gen (tSplx M) L (affineSimplex q) ∈ tupSpan M L :=
  Submodule.subset_span ⟨⟨q, hq⟩, rfl⟩

/-- `tupSpan` is the span of the generators attached to subdivision tuples. -/
lemma tupSpan_eq_span {M L : ℕ} :
    tupSpan M L = Submodule.span ℤ (Set.range (fun q : {q : Fin (L+1) → StdSimplex ℝ (Fin (M+1)) //
      Tup M (L+1) q} => gen (tSplx M) L (affineSimplex q.1))) := rfl

end Work.SingMV
