import Mathlib
import Submission.Work.SINGMV.Defs
import Submission.Work.SingMV.homPow_spec
import Submission.Work.SingMV.exists_small_chain
import Submission.Work.SingMV.small_subset_pushout_range
import Submission.Work.SingMV.sd_preserves_small
import Submission.Work.SingMV.mono_pushout_desc

/-!
# Acyclicity of the cokernel of the Mayer–Vietoris comparison map

For a topological space `X`, open subsets `U V ⊆ X` with `U ∪ V = X` and the canonical map

`pushoutMap X U V : pushout (C(U∩V) → C(U)) (C(U∩V) → C(V)) ⟶ C(X)`

of `Submission.Work.SINGMV.Defs` (the comparison map of the small-simplices theorem of
Hatcher, Proposition 2.21), we prove that its cokernel is acyclic.

Together with the injectivity of `pushoutMap X U V` (`mono_pushout_desc`) this says that
`pushoutMap X U V` is a quasi-isomorphism: its image is the subcomplex of `(U,V)`-small chains
and the quotient by the small chains has vanishing homology.

## Proof

Write `C := C(X)`, `p := pushoutMap X U V`, `Q := cokernel p` and `π := cokernel.π p`, so that
the sequence `P --p--> C --π--> Q` is exact and `ker (π.f n) = range (p.f n)` (using that `p`
is a monomorphism), whence `z ∈ C.X n` is killed by `π.f n` if and only if `z` is a
`(U,V)`-small chain, because `range (p.f n)` is exactly the submodule `smallChain X n U V` of
`(U,V)`-small chains:

* `⊆` holds since `P.X n` is generated by the images of `inl : C(U) → P` and
  `inr : C(V) → P` (the pushout is the cokernel of the difference map
  `C(U∩V) → C(U) ⊞ C(V)`) and the two legs have ranges `smallSpan X n U`, `smallSpan X n V`;
* `⊇` is `small_subset_pushout_range`.

Hence for a cycle `x ∈ Q.X (m+1)`: lift `x = π z`, so that `d z` is small.  Choose `k` with
`sd^k z` small (`exists_small_chain`); the telescoped homotopy relation `homPow_spec`

`d (homPow X (m+1) k z) + homPow X m k (d z) = sd^k z - z`

has, after applying `π`, its middle term `homPow X m k (d z)` small (by `acp_homPow_mem_small`)
and `sd^k z` in the kernel of `π`, so `π (d (homPow X (m+1) k z)) = -x`, i.e. `x` is the
boundary of `-π (homPow X (m+1) k z)` in `Q`.  In degree `0` the same holds trivially: every
`0`-chain of `X` is `(U,V)`-small because `U ∪ V = X`.
-/

open CategoryTheory Limits HomologicalComplex
open scoped BigOperators Simplicial
open Convexity

noncomputable section

set_option maxHeartbeats 1000000

namespace Work.SingMV

open Submission.Blueprint

/-! ## Elementary facts about biproducts of modules -/

/-- The value of a map out of a binary biproduct on an `inl`-component. -/
lemma acp_biprod_desc_inl_apply (M N P : ModuleCat ℤ) (f : M ⟶ P) (g : N ⟶ P) (y : M) :
    (biprod.desc f g) (biprod.inl (X := M) (Y := N) y) = f y := by
  rw [← ConcreteCategory.comp_apply, biprod.inl_desc]

/-- The value of a map out of a binary biproduct on an `inr`-component. -/
lemma acp_biprod_desc_inr_apply (M N P : ModuleCat ℤ) (f : M ⟶ P) (g : N ⟶ P) (y : N) :
    (biprod.desc f g) (biprod.inr (X := M) (Y := N) y) = g y := by
  rw [← ConcreteCategory.comp_apply, biprod.inr_desc]

/-- The range of a map out of a binary biproduct is the supremum of the ranges of its
components. -/
lemma acp_range_biprod_desc {M N P : ModuleCat ℤ} (f : M ⟶ P) (g : N ⟶ P) :
    LinearMap.range (biprod.desc f g).hom = LinearMap.range f.hom ⊔ LinearMap.range g.hom := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨y, rfl⟩
    have key : (biprod.desc f g).hom = f.hom.comp (biprod.fst (X := M) (Y := N)).hom +
        g.hom.comp (biprod.snd (X := M) (Y := N)).hom := by
      rw [biprod.desc_eq, ModuleCat.hom_add, ModuleCat.hom_comp, ModuleCat.hom_comp]
    rw [key, LinearMap.add_apply]
    exact Submodule.add_mem _ (Submodule.mem_sup_left ⟨_, rfl⟩)
      (Submodule.mem_sup_right ⟨_, rfl⟩)
  · rw [sup_le_iff]
    constructor
    · rintro _ ⟨y, rfl⟩
      exact ⟨biprod.inl (X := M) (Y := N) y, acp_biprod_desc_inl_apply M N P f g y⟩
    · rintro _ ⟨y, rfl⟩
      exact ⟨biprod.inr (X := M) (Y := N) y, acp_biprod_desc_inr_apply M N P f g y⟩

/-- Composition with a map out of a binary biproduct. -/
lemma acp_biprod_desc_comp {C : Type*} [Category* C] [HasZeroMorphisms C]
    [HasBinaryBiproducts C] {A B Z W : C} (f : A ⟶ Z) (g : B ⟶ Z) (h : Z ⟶ W) :
    biprod.desc f g ≫ h = biprod.desc (f ≫ h) (g ≫ h) := by
  apply biprod.hom_ext'
  · rw [← Category.assoc, biprod.inl_desc, biprod.inl_desc]
  · rw [← Category.assoc, biprod.inr_desc, biprod.inr_desc]

/-! ## The complex shape `down ℕ` -/

lemma acp_prev_succ (m : ℕ) : (ComplexShape.down ℕ).prev (m + 1) = m + 2 :=
  ComplexShape.prev_eq' (c := ComplexShape.down ℕ) (i := m + 1) (j := m + 2) (by
    show (m + 1) + 1 = m + 2
    omega)

lemma acp_next_succ (m : ℕ) : (ComplexShape.down ℕ).next (m + 1) = m :=
  ComplexShape.next_eq' (c := ComplexShape.down ℕ) (i := m + 1) (j := m) (by
    show m + 1 = m + 1
    rfl)

lemma acp_prev_zero : (ComplexShape.down ℕ).prev 0 = 1 :=
  ComplexShape.prev_eq' (c := ComplexShape.down ℕ) (i := 0) (j := 1) (by
    show (0 : ℕ) + 1 = 1
    rfl)

lemma acp_next_zero : (ComplexShape.down ℕ).next 0 = 0 :=
  ComplexShape.next_eq_self' (c := ComplexShape.down ℕ) 0 (fun k hk =>
    absurd hk (by show ¬ (k + 1 = 0); omega))

/-! ## The differential of a biproduct of complexes, degreewise -/

section BiprodDegreewise

variable {K L M : HomologicalComplex (ModuleCat ℤ) (ComplexShape.down ℕ)}

lemma acp_biprod_inl_f_comp_hom (i : ℕ) :
    (biprod.inl : K ⟶ K ⊞ L).f i ≫ (HomologicalComplex.biprodXIso K L i).hom =
      (biprod.inl : K.X i ⟶ K.X i ⊞ L.X i) := by
  rw [← HomologicalComplex.inl_biprodXIso_inv, Category.assoc, Iso.inv_hom_id,
    Category.comp_id]

lemma acp_biprod_inr_f_comp_hom (i : ℕ) :
    (biprod.inr : L ⟶ K ⊞ L).f i ≫ (HomologicalComplex.biprodXIso K L i).hom =
      (biprod.inr : L.X i ⟶ K.X i ⊞ L.X i) := by
  rw [← HomologicalComplex.inr_biprodXIso_inv, Category.assoc, Iso.inv_hom_id,
    Category.comp_id]

/-- The `i`-th component of a map out of a biproduct of complexes, in terms of the components
of its two legs. -/
lemma acp_biprod_desc_f (α : K ⟶ M) (β : L ⟶ M) (i : ℕ) :
    (biprod.desc α β).f i =
      (HomologicalComplex.biprodXIso K L i).hom ≫ biprod.desc (α.f i) (β.f i) := by
  apply HomologicalComplex.biprodX_ext_from
  · rw [HomologicalComplex.biprod_inl_desc_f]
    rw [← Category.assoc, acp_biprod_inl_f_comp_hom, biprod.inl_desc]
  · rw [HomologicalComplex.biprod_inr_desc_f]
    rw [← Category.assoc, acp_biprod_inr_f_comp_hom, biprod.inr_desc]

end BiprodDegreewise

/-! ## The image of the comparison map is the subcomplex of small chains -/

/-- **The range of the Mayer–Vietoris comparison map in degree `n` is contained in the
`(U,V)`-small chains.**  The pushout `P` of `C(U∩V) → C(U)` and `C(U∩V) → C(V)` is generated
(degreewise) by the images of its two structure maps, whose ranges are the chains carried by
`U` and by `V`. -/
theorem acp_range_pushoutMap_le (X : TopCat) (U V : Set X) (n : ℕ) :
    LinearMap.range ((pushoutMap X U V).f n).hom ≤ smallChain X n U V := by
  let PU := (singC).obj (TopCat.of U)
  let PV := (singC).obj (TopCat.of V)
  let CX := (singC).obj X
  let F := (singC).map (incl (Set.inter_subset_left : U ∩ V ⊆ U))
  let G := (singC).map (incl (Set.inter_subset_right : U ∩ V ⊆ V))
  let τU : PU ⟶ CX := (singC).map (inclTop U)
  let τV : PV ⟶ CX := (singC).map (inclTop V)
  have hInl : pushout.inl F G ≫ pushoutMap X U V = τU := by
    unfold pushoutMap
    exact pushout.inl_desc _ _ _
  have hInr : pushout.inr F G ≫ pushoutMap X U V = τV := by
    unfold pushoutMap
    exact pushout.inr_desc _ _ _
  set δ := CategoryTheory.Abelian.BiproductToPushoutIsCokernel.biproductToPushout F G with hδ
  haveI hEpi : Epi δ :=
    Cofork.IsColimit.epi
      (CategoryTheory.Abelian.BiproductToPushoutIsCokernel.isColimitBiproductToPushout F G)
  haveI hEpi' : Epi (δ.f n) := inferInstance
  have hsurj : LinearMap.range (δ.f n).hom = ⊤ := by
    rw [LinearMap.range_eq_top]
    exact (ModuleCat.epi_iff_surjective _).mp inferInstance
  have hδp : δ ≫ pushoutMap X U V = biprod.desc τU τV := by
    have h1 : δ = biprod.desc (pushout.inl F G) (pushout.inr F G) := rfl
    rw [h1, acp_biprod_desc_comp]
    exact congrArg₂ biprod.desc hInl hInr
  have hsurj2 : LinearMap.range ((HomologicalComplex.biprodXIso PU PV n).hom).hom = ⊤ := by
    rw [LinearMap.range_eq_top]
    exact (ModuleCat.epi_iff_surjective _).mp inferInstance
  have h1 : LinearMap.range ((pushoutMap X U V).f n).hom =
      LinearMap.range ((δ ≫ pushoutMap X U V).f n).hom := by
    rw [HomologicalComplex.comp_f, ModuleCat.hom_comp, LinearMap.range_comp, hsurj,
      Submodule.map_top]
  have h2 : LinearMap.range ((δ ≫ pushoutMap X U V).f n).hom =
      LinearMap.range ((biprod.desc τU τV).f n).hom := by rw [hδp]
  have h3 : LinearMap.range ((biprod.desc τU τV).f n).hom =
      LinearMap.range ((HomologicalComplex.biprodXIso PU PV n).hom ≫
        biprod.desc (τU.f n) (τV.f n)).hom := by
    rw [acp_biprod_desc_f]
  have h4 : LinearMap.range ((HomologicalComplex.biprodXIso PU PV n).hom ≫
        biprod.desc (τU.f n) (τV.f n)).hom =
      LinearMap.range (biprod.desc (τU.f n) (τV.f n)).hom := by
    rw [ModuleCat.hom_comp, LinearMap.range_comp, hsurj2, Submodule.map_top]
  have h5 : LinearMap.range (biprod.desc (τU.f n) (τV.f n)).hom =
      LinearMap.range (τU.f n).hom ⊔ LinearMap.range (τV.f n).hom := acp_range_biprod_desc _ _
  have h6 : LinearMap.range (τU.f n).hom ⊔ LinearMap.range (τV.f n).hom =
      smallChain X n U V := by
    rw [range_singC_map_inclTop, range_singC_map_inclTop, smallChain]
  exact le_of_eq (by rw [h1, h2, h3, h4, h5, h6])

/-- The `(U,V)`-small chains are killed by the cokernel projection of the comparison map. -/
theorem acp_small_le_ker_cokernelπ (X : TopCat) (U V : Set X) (n : ℕ) :
    smallChain X n U V ≤ LinearMap.ker ((cokernel.π (pushoutMap X U V)).f n).hom := by
  intro z hz
  obtain ⟨w, hw⟩ := small_subset_pushout_range X n U V z hz
  rw [LinearMap.mem_ker, ← hw]
  have hf : (pushoutMap X U V).f n ≫ (cokernel.π (pushoutMap X U V)).f n = 0 := by
    rw [← HomologicalComplex.comp_f, cokernel.condition (pushoutMap X U V),
      HomologicalComplex.zero_f]
  have h3 : (ConcreteCategory.hom ((pushoutMap X U V).f n ≫
      (cokernel.π (pushoutMap X U V)).f n)) w = 0 := by
    rw [hf]
    simp
  simpa using h3

/-- The kernel of the cokernel projection is the range of the comparison map (in each degree),
because `pushoutMap` is a monomorphism. -/
theorem acp_ker_le_range (X : TopCat) (U V : Set X) (n : ℕ) :
    LinearMap.ker ((cokernel.π (pushoutMap X U V)).f n).hom ≤
      LinearMap.range ((pushoutMap X U V).f n).hom := by
  let p := pushoutMap X U V
  let S : ShortComplex (HomologicalComplex (ModuleCat ℤ) (ComplexShape.down ℕ)) :=
    ShortComplex.mk p (cokernel.π p) (cokernel.condition p)
  have hf : Mono p := mono_pushout_desc X U V
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (S.exact_of_g_is_cokernel (cokernelIsCokernel p)) hf inferInstance
  have hex : (S.map (HomologicalComplex.eval (ModuleCat ℤ) (ComplexShape.down ℕ) n)).Exact :=
    (HomologicalComplex.exact_iff_degreewise_exact S).mp hS.exact n
  have h := (ShortComplex.moduleCat_exact_iff_ker_sub_range
    (S.map (HomologicalComplex.eval (ModuleCat ℤ) (ComplexShape.down ℕ) n))).mp hex
  simpa only [ShortComplex.map_f, ShortComplex.map_g, HomologicalComplex.eval_map, S] using h

/-- In degree `0`, every chain of `X` is `(U,V)`-small, since `U ∪ V = X`. -/
theorem acp_smallChain_zero_eq_top (X : TopCat) (U V : Set X) (hUV : U ∪ V = Set.univ) :
    smallChain X 0 U V = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← smallSpan_univ X 0, smallChain]
  rw [smallSpan, Submodule.span_le]
  rintro _ ⟨σ, rfl⟩
  have hpt : σ.1 (Classical.arbitrary (StdSimplex ℝ (Fin 1))) ∈ U ∪ V := by
    rw [hUV]
    exact Set.mem_univ _
  rcases hpt with hU | hV
  · exact Submodule.mem_sup_left (Submodule.subset_span ⟨⟨σ.1, fun x => by
      rw [show x = Classical.arbitrary (StdSimplex ℝ (Fin 1)) from Subsingleton.elim x _]
      exact hU⟩, rfl⟩)
  · exact Submodule.mem_sup_right (Submodule.subset_span ⟨⟨σ.1, fun x => by
      rw [show x = Classical.arbitrary (StdSimplex ℝ (Fin 1)) from Subsingleton.elim x _]
      exact hV⟩, rfl⟩)

/-! ## The homotopy operator `homdeg` preserves small chains -/

/-- Pushing the chains carried by `W` forward along `f : X ⟶ Y` with `f '' W ⊆ U` lands in the
chains carried by `U`. -/
lemma acp_push_smallSpan_le (X Y : TopCat) (f : X ⟶ Y) (k : ℕ) (W : Set X) (U : Set Y)
    (hU : ∀ x ∈ W, f x ∈ U) :
    Submodule.map (((singC).map f).f k).hom (smallSpan X k W) ≤ smallSpan Y k U := by
  rw [smallSpan, Submodule.map_span_le]
  rintro z ⟨σ, rfl⟩
  show (ConcreteCategory.hom (((singC).map f).f k)) (gen X k σ.1) ∈ smallSpan Y k U
  rw [gen_map]
  exact Submodule.subset_span ⟨⟨f.hom.comp σ.1, fun x => hU (σ.1 x) (σ.2 x)⟩, rfl⟩

/-- Elementwise form of `acp_push_smallSpan_le`. -/
lemma acp_push_smallSpan_mem (X Y : TopCat) (f : X ⟶ Y) (k : ℕ) (W : Set X) (U : Set Y)
    (hU : ∀ x ∈ W, f x ∈ U) (z : ((singC).obj X).X k) (hz : z ∈ smallSpan X k W) :
    ((singC).map f).f k z ∈ smallSpan Y k U :=
  acp_push_smallSpan_le X Y f k W U hU
    (Submodule.mem_map_of_mem (f := (((singC).map f).f k).hom) hz)

/-- `homdeg X n` maps the chains carried by `U` into the chains carried by `U` in degree
`n+1`: on a generator `gen X n σ` with image in `U`, `homdeg` is the pushforward of the chain
`homChain n` of the fundamental simplex, whose simplices all map into the image of `σ ⊆ U`. -/
lemma acp_homdeg_map_smallSpan_le (X : TopCat) (n : ℕ) (U : Set X) :
    Submodule.map (homdeg X n).hom (smallSpan X n U) ≤ smallSpan X (n+1) U := by
  rw [smallSpan, Submodule.map_span_le]
  rintro z ⟨σ, rfl⟩
  show (ConcreteCategory.hom (homdeg X n)) (gen X n σ.1) ∈ smallSpan X (n+1) U
  rw [homdeg_gen X n σ.1]
  exact acp_push_smallSpan_mem (tSplx n) X (TopCat.ofHom σ.1) (n+1) Set.univ U
    (fun x _ => σ.2 x) (homChain n) (by rw [smallSpan_univ]; exact Submodule.mem_top)

/-- **`homdeg` preserves `(U,V)`-small chains.** -/
theorem acp_homdeg_preserves_small (X : TopCat) (n : ℕ) (U V : Set X)
    (z : ((singC).obj X).X n) (hz : z ∈ smallChain X n U V) :
    homdeg X n z ∈ smallChain X (n+1) U V := by
  rw [smallChain] at hz ⊢
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hz
  refine Submodule.mem_sup.mpr ⟨homdeg X n a, ?_, homdeg X n b, ?_, ?_⟩
  · exact acp_homdeg_map_smallSpan_le X n U
      (Submodule.mem_map_of_mem (f := (homdeg X n).hom) ha)
  · exact acp_homdeg_map_smallSpan_le X n V
      (Submodule.mem_map_of_mem (f := (homdeg X n).hom) hb)
  · exact (map_add (homdeg X n).hom a b).symm

/-! ## The telescoped homotopy preserves small chains -/

/-- One step of the telescoped homotopy recursion, unfolded. -/
lemma acp_homPow_succ (X : TopCat) (n k : ℕ) (z : ((singC).obj X).X n) :
    homPow X n (k+1) z = homdeg X n z + sddeg X (n+1) (homPow X n k z) := rfl

/-- The telescoped homotopy operator `homPow` preserves `(U,V)`-small chains: both `homdeg`
and `sddeg` do. -/
theorem acp_homPow_mem_small (X : TopCat) (U V : Set X) (n k : ℕ)
    (z : ((singC).obj X).X n) (hz : z ∈ smallChain X n U V) :
    homPow X n k z ∈ smallChain X (n+1) U V := by
  induction k with
  | zero => rw [show homPow X n 0 z = 0 from rfl]; exact Submodule.zero_mem _
  | succ k ih =>
      rw [acp_homPow_succ]
      exact Submodule.add_mem _ (acp_homdeg_preserves_small X n U V z hz)
        (sd_preserves_small X (n+1) U V _ ih)

/-! ## Cycles in the cokernel are boundaries -/

/-- **Every cycle in the cokernel of the comparison map is a boundary**, in positive degrees.
The telescoped homotopy between the iterated barycentric subdivision and the identity turns a
cycle into a boundary modulo the small chains, and the small chains are exactly the kernel of
the cokernel projection. -/
theorem acp_cycle_boundary (X : TopCat) (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hUV : U ∪ V = Set.univ) (m : ℕ)
    (hspec : ∀ (k : ℕ) (z : ((singC).obj X).X (m+1)),
      ((singC).obj X).d (m+2) (m+1) (homPow X (m+1) k z) +
        homPow X m k (((singC).obj X).d (m+1) m z) = (sddeg X (m+1))^[k] z - z)
    (x : (cokernel (pushoutMap X U V)).X (m+1))
    (hx : (cokernel (pushoutMap X U V)).d (m+1) m x = 0) :
    ∃ y : (cokernel (pushoutMap X U V)).X (m+2),
      (cokernel (pushoutMap X U V)).d (m+2) (m+1) y = x := by
  -- lift the cycle to `C`
  obtain ⟨z, hz⟩ : ∃ z : ((singC).obj X).X (m+1),
      (cokernel.π (pushoutMap X U V)).f (m+1) z = x :=
    (ModuleCat.epi_iff_surjective ((cokernel.π (pushoutMap X U V)).f (m+1))).mp inferInstance x
  -- the differential of the lift is small
  have hdz : ((singC).obj X).d (m+1) m z ∈ smallChain X m U V := by
    have hcomm : (ConcreteCategory.hom ((cokernel.π (pushoutMap X U V)).f (m+1) ≫
        (cokernel (pushoutMap X U V)).d (m+1) m)) z =
        (ConcreteCategory.hom (((singC).obj X).d (m+1) m ≫
          (cokernel.π (pushoutMap X U V)).f m)) z :=
      congrArg
        (fun (u : ((singC).obj X).X (m+1) ⟶ (cokernel (pushoutMap X U V)).X m) => u z)
        ((cokernel.π (pushoutMap X U V)).comm (m+1) m)
    simp only [ConcreteCategory.comp_apply] at hcomm
    have hz0 : (cokernel.π (pushoutMap X U V)).f m (((singC).obj X).d (m+1) m z) = 0 := by
      rw [← hcomm, hz, hx]
    exact acp_range_pushoutMap_le X U V m (acp_ker_le_range X U V m (by
      rw [LinearMap.mem_ker]
      exact hz0))
  -- enough subdivisions make the lift small
  obtain ⟨k, hk⟩ := exists_small_chain X U V hU hV hUV (m+1) z
  have hw : homPow X m k (((singC).obj X).d (m+1) m z) ∈ smallChain X (m+1) U V :=
    acp_homPow_mem_small X U V m k _ hdz
  have hzero1 : (cokernel.π (pushoutMap X U V)).f (m+1)
      (homPow X m k (((singC).obj X).d (m+1) m z)) = 0 :=
    LinearMap.mem_ker.mp (acp_small_le_ker_cokernelπ X U V (m+1) hw)
  have hzero2 : (cokernel.π (pushoutMap X U V)).f (m+1)
      ((sddeg X (m+1))^[k] z) = 0 :=
    LinearMap.mem_ker.mp (acp_small_le_ker_cokernelπ X U V (m+1) hk)
  have hπ := congrArg (fun u => (cokernel.π (pushoutMap X U V)).f (m+1) u) (hspec k z)
  rw [map_add, map_sub, hzero1, hzero2, hz] at hπ
  have hkey : (cokernel.π (pushoutMap X U V)).f (m+1)
      (((singC).obj X).d (m+2) (m+1) (homPow X (m+1) k z)) = -x := by
    simpa using hπ
  have hcomm2 : (ConcreteCategory.hom ((cokernel.π (pushoutMap X U V)).f (m+2) ≫
      (cokernel (pushoutMap X U V)).d (m+2) (m+1))) (homPow X (m+1) k z) =
      (ConcreteCategory.hom (((singC).obj X).d (m+2) (m+1) ≫
        (cokernel.π (pushoutMap X U V)).f (m+1))) (homPow X (m+1) k z) :=
    congrArg
      (fun (u : ((singC).obj X).X (m+2) ⟶ (cokernel (pushoutMap X U V)).X (m+1)) =>
        u (homPow X (m+1) k z))
      ((cokernel.π (pushoutMap X U V)).comm (m+2) (m+1))
  simp only [ConcreteCategory.comp_apply] at hcomm2
  refine ⟨- (cokernel.π (pushoutMap X U V)).f (m+2) (homPow X (m+1) k z), ?_⟩
  rw [map_neg, hcomm2, hkey, neg_neg]

/-! ## The main theorem -/

theorem acyclic_coker_pushout (X : TopCat) (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hUV : U ∪ V = Set.univ) :
    (CategoryTheory.Limits.cokernel (Work.SingMV.pushoutMap X U V)).Acyclic := by
  intro i
  cases i with
  | zero =>
      -- in degree `0` every element is zero, since every `0`-chain is small
      refine HomologicalComplex.ExactAt.of_isZero ?_
      rw [ModuleCat.isZero_iff_subsingleton]
      have hz : ∀ a : (cokernel (pushoutMap X U V)).X 0, a = 0 := by
        intro a
        obtain ⟨z, rfl⟩ := (ModuleCat.epi_iff_surjective
          ((cokernel.π (pushoutMap X U V)).f 0)).mp inferInstance a
        exact LinearMap.mem_ker.mp (acp_small_le_ker_cokernelπ X U V 0 (by
          rw [acp_smallChain_zero_eq_top X U V hUV]
          exact Submodule.mem_top))
      exact ⟨fun a b => by rw [hz a, hz b]⟩
  | succ m =>
      refine (HomologicalComplex.exactAt_iff'
        (cokernel (pushoutMap X U V)) (m+2) (m+1) m
        (acp_prev_succ m) (acp_next_succ m)).mpr ?_
      refine (ShortComplex.moduleCat_exact_iff
        ((cokernel (pushoutMap X U V)).sc' (m+2) (m+1) m)).mpr ?_
      intro x hx
      exact acp_cycle_boundary X U V hU hV hUV m (fun k z => homPow_spec X m k z) x hx

end Work.SingMV
