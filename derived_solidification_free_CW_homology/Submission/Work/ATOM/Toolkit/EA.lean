import Mathlib
import Submission.Work.ATOM.Defs

/-!
# AREA ATOM: the epimorphisms `ℤ[(ℕ∪{∞}) × S] ⟶ P ⊗ ℤ[S]` and `ℤ[(ℕ∪{∞})²] ⟶ P ⊗ P`

`P = ℤ[ℕ∪{∞}]/ℤ[∞]` is the cokernel of `P_map = zmap ι`.  Since the tensor product is right
exact, `P ⊗ A` is the cokernel of `P_map ▷ A`, and via the monoidal isomorphism
`ℤ[X] ⊗ ℤ[Y] ≅ ℤ[X × Y]` this identifies `P ⊗ ℤ[S]` with the quotient of `ℤ[(ℕ∪{∞}) × S]` by the
image of `ℤ[{∞} × S]` (and similarly for `P ⊗ P`).

`EA` and `EApp` below are the corresponding quotient projections; a morphism `φ` out of
`ℤ[(ℕ∪{∞}) × S]` (resp. `ℤ[(ℕ∪{∞})²]`) descends to `P ⊗ ℤ[S]` (resp. `P ⊗ P`) exactly when it
kills the image of `ℤ[{∞} × S]` (resp. both `∞`-axes).  These descent statements are proved in
`Submission/Work/ATOM/Toolkit/PS_desc.lean` and `.../PP_desc.lean`.
-/

open CategoryTheory Limits LightProfinite LightCondensed MonoidalCategory MonoidalClosed
open OnePoint

noncomputable section

namespace Work.ATOM

/-- The epimorphism `ℤ[(ℕ∪{∞}) ⊗ S] ⟶ P ⊗ ℤ[S]`, whose kernel is generated by `{∞} × S`. -/
noncomputable def EA (S : LightProfinite.{0}) :
    zfree ((ℕ∪{∞}) ⊗ S) ⟶ tmul P (zfree S) :=
  (zfreeTensorIso (ℕ∪{∞}) S).inv ≫ MonoidalCategory.whiskerRight P_proj (zfree S)

/-- The epimorphism `ℤ[(ℕ∪{∞}) ⊗ (ℕ∪{∞})] ⟶ P ⊗ P`, whose kernel is generated by the two
`∞`-axes. -/
noncomputable def EApp :
    zfree ((ℕ∪{∞}) ⊗ (ℕ∪{∞})) ⟶ tmul P P :=
  (zfreeTensorIso (ℕ∪{∞}) (ℕ∪{∞})).inv ≫
    MonoidalCategory.whiskerRight P_proj (zfree (ℕ∪{∞})) ≫
    MonoidalCategory.whiskerLeft P P_proj

end Work.ATOM
