/-
# `Work.FTS.LocData.PhiZ_eq` — the iterated `D_z`-derivatives of the profile `F_*`

The profile of the fundamental model is `F_* (z) = 2z/(1+z)²` (`Work.FM.Fstar`), and the
normalised `i`-th iterate of `D_z = z ∂_z` applied to it (the `θ`-variable is a dummy) is

  `Phi i z θ = DzIter i (fun z _ => F_* z) z θ = PhiR i z / (1+z)^(i+2)`   (`i ≤ 4`),

with the explicit palindromic numerators (`Work.FTS.LocData.PhiR`)

  `PhiR 0 = 2z`, `PhiR 1 = 2z(1-z)`, `PhiR 2 = 2z(1-4z+z²)`,
  `PhiR 3 = 2z(1-11z+11z²-z³)`, `PhiR 4 = 2z(1-26z+66z²-26z³+z⁴)`.

That is the statement proved here.

## The argument

The iteration is generated by `T1 u z = z ∂_z u z` (`Dz`, see `DzIter_FM_Fstar_abs_le`):

  `DzIter (i+1) (fun z _ => F_* z) z θ = z ∂_z (fun w => DzIter i (fun z _ => F_* z) w θ) z`.

So one proves `∀ n ≤ 4, ∀ z, DzIter n (fun z _ => F_* z) z θ = PhiR n z/(1+z)^(n+2)` by
induction on `n`, the induction step being the *exact* polynomial recursion

  `PhiR (n+1) z = z·((1+z)·PhiR n ′(z) - (n+2)·PhiR n z)`,

i.e. `z·∂_z (PhiR n z/(1+z)^(n+2)) = PhiR (n+1) z/(1+z)^(n+3)` off the pole `z = -1`
(`Work.FTS.LocData.Phi_div_deriv`).  At the pole `z = -1` the identity is Lean's junk-value
identity `_/0 = 0` on both sides: the normalised function has a genuine pole there (its norm
tends to `+∞`), so it is not differentiable at `-1` and `deriv` takes the value `0`
(`Work.FTS.LocData.deriv_eq_zero_at_pole`, applied to `A = PhiR n`, `m = n+2`, whose value at
`-1` is `-2·R_n(-1) ≠ 0`).
-/
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Tactic.IntervalCases
import Submission.Work.FTS.LocData.HkFstarDefs
import Submission.Work.FTS.LocData.deriv_eq_zero_at_pole
import Submission.Work.FTS.LocData.Phi_div_deriv

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

noncomputable section

open scoped Real Topology

namespace Work.FTS.LocData

set_option autoImplicit false

theorem PhiZ_eq (i : ℕ) (hi : i ≤ 4) (z θ : ℝ) :
    Work.Spaces.DzIter i (fun z _ => Work.FM.Fstar z) z θ = Phi i z θ := by
  -- `PhiR n` is continuous at the pole `-1` (it is a polynomial) …
  have hcont : ∀ n : ℕ, n ≤ 3 → ContinuousAt (fun w : ℝ => PhiR n w) (-1) := by
    intro n hn
    interval_cases n <;> simp only [PhiR_zero, PhiR_one, PhiR_two, PhiR_three] <;> fun_prop
  -- … and does not vanish there, so `PhiR n z/(1+z)^(n+2)` has a genuine pole at `-1`.
  have hne : ∀ n : ℕ, n ≤ 3 → PhiR n (-1) ≠ 0 := by
    intro n hn
    interval_cases n <;> simp only [PhiR_zero, PhiR_one, PhiR_two, PhiR_three] <;> norm_num
  have hmain : ∀ n : ℕ, n ≤ 4 → ∀ z : ℝ,
      Work.Spaces.DzIter n (fun z _ => Work.FM.Fstar z) z θ = PhiR n z / (1 + z) ^ (n + 2) := by
    intro n
    induction n with
    | zero =>
        intro _ z
        simp only [Work.Spaces.DzIter_zero, PhiR_zero, Work.FM.Fstar]
    | succ n ih =>
        intro hn z
        have hprev : ∀ w : ℝ, Work.Spaces.DzIter n (fun z _ => Work.FM.Fstar z) w θ
            = PhiR n w / (1 + w) ^ (n + 2) := ih (by omega)
        have hn3 : n ≤ 3 := by omega
        -- one more `D_z` is `z ∂_z` of the previous iterate
        have hstep : Work.Spaces.DzIter (n + 1) (fun z _ => Work.FM.Fstar z) z θ
            = z * deriv (fun w : ℝ =>
                Work.Spaces.DzIter n (fun z _ => Work.FM.Fstar z) w θ) z := by
          simp only [Work.Spaces.DzIter_succ, Work.Spaces.Dz, Work.Spaces.pz]
        rw [hstep]
        have hfun : (fun w : ℝ => Work.Spaces.DzIter n (fun z _ => Work.FM.Fstar z) w θ)
            = fun w : ℝ => PhiR n w / (1 + w) ^ (n + 2) := funext hprev
        rw [hfun]
        rcases eq_or_ne z (-1) with hz | hz
        · -- at the pole both sides are Lean's `_/0 = 0`
          subst hz
          rw [deriv_eq_zero_at_pole (PhiR n) (n + 2) (by omega) (hcont n hn3) (hne n hn3)]
          norm_num
        · -- off the pole, the explicit polynomial recursion
          have hexp : n + 1 + 2 = n + 3 := by omega
          rw [hexp]
          exact Phi_div_deriv n hn3 hz
  show Work.Spaces.DzIter i (fun z _ => Work.FM.Fstar z) z θ = PhiR i z / (1 + z) ^ (i + 2)
  exact hmain i hi z

end Work.FTS.LocData
