/-
Copyright: work module for the Elgindi finite-time singularity project.

# `Submission/Work/FTS/StrongEps/EpsE4Thr/WordEnergy.lean` — the energy recursion at *bounded*
slot order

`StrongPersist.EnergyIter.energyDeriv_IPiter` transports the energy derivative up the paper's
recursion, but its slot hypothesis

  `∀ X, IsWord X → EnergyDeriv (H1IP α) (fun s => X (u s)) (X u̇) τ`

is quantified over **all** words in `D_θ`, `D_z`, of arbitrarily large length.  The slot data the
paper's estimates actually produce is available only up to the order of the level (`≤ 4` for
`IP4`, `≤ 6` for `IP6`), so that form cannot be fed (and `EpsE4Thr.energyDeriv_IP4_JfamP`, which
consumes it, is for the same reason not usable as stated).

This module records the *length-refined* form: words of length at most `n` suffice to run the
`n`-fold recursion `IPiter α c n`.

* `IsWordLe n X` — the slot words of length at most `n` (the free monoid in `D_θ`, `D_z`,
  truncated by length), with `IsWordLe.succ`, `IsWordLe.mono`;
* `energyDeriv_IPiter_le` — the refined recursion;
* `energyDeriv_IP4_le` — `IP4 = IPiter 3` from words of length `≤ 3`;
* `energyDeriv_IP6_le` — `IP6 = IPiter 5` from words of length `≤ 5`.

The counts match `NOTES_EpsE4Thr_session3.md` §2: a word of length `≤ n` costs an
`H1IP`-energy derivative, which `energyDeriv_H1IP` produces from the four `wip`-product rules at
that word and its two shifts, i.e. from slot data one order higher — `≤ 4` for the level-four
half and `≤ 6` for the level-six half.

Everything here is `sorry`-free.
-/
import Mathlib.Basic.Real.Basic
import Mathlib.Order.Filter.Defs
import Submission.Work.FTS.StrongPersist.EnergyIter
import Submission.Work.FTS.CoercivityFix.Assembly.Defs
import Submission.Work.FTS.StrongEps.EpsE4Thr.EnergyIP4

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

noncomputable section
open scoped Real Topology
open MeasureTheory Set Filter

namespace Work.FTS.StrongEps.EpsE4Thr

open Work.FTS.Galerkin (Fn Fam slice)

set_option autoImplicit false

/-! ## Slot words of bounded length -/

/-- The slot words of length at most `n`: the free monoid generated by `D_θ` and `D_z`, with the
length of a word recorded in the index (so that `IsWordLe n X` is `IsWord X` together with the
bound `length X ≤ n`). -/
inductive IsWordLe : ℕ → (Fn → Fn) → Prop
  | id {n : ℕ} : IsWordLe n id
  | dth {n : ℕ} {X : Fn → Fn} : IsWordLe n X → IsWordLe (n + 1) (fun f => X (Work.Spaces.Dth f))
  | dz {n : ℕ} {X : Fn → Fn} : IsWordLe n X → IsWordLe (n + 1) (fun f => X (Work.Spaces.Dz f))

/-- Appending `D_θ` on the right increases the length by one, so a word of length at most `n` is
also a word of length at most `n + 1` (with the *same* action: the left argument is `D_θ`). -/
theorem IsWordLe.succ {n : ℕ} {X : Fn → Fn} (hX : IsWordLe n X) : IsWordLe (n + 1) X := by
  induction hX with
  | id => exact IsWordLe.id
  | dth _ ih => exact IsWordLe.dth ih
  | dz _ ih => exact IsWordLe.dz ih

/-- Weakening of the length bound. -/
theorem IsWordLe.mono {n m : ℕ} (h : n ≤ m) {X : Fn → Fn} (hX : IsWordLe n X) :
    IsWordLe m X :=
  Nat.le_induction hX (fun _ _ ih => ih.succ) m h

/-! ## The refined recursion -/

/-- **The energy derivative climbs the recursion, at bounded slot order.**  If the `H1IP`-energy
of every slot family `τ ↦ X (u τ)` with `X` a word of length at most `n` has the right derivative,
then so has the `n`-fold iterate of the recursion.

`energyDeriv_IPiter` is the `IsWordLe`-forgetting consequence of this statement. -/
theorem energyDeriv_IPiter_le (α : ℝ) (c : ℕ → ℝ × ℝ) :
    ∀ n : ℕ, ∀ {u : ℝ → Fn} {udot : Fn} {τ : ℝ},
      (∀ X : Fn → Fn, IsWordLe n X →
        Work.FTS.StrongPersist.EnergyDeriv (Work.Coercivity.H1IP α) (fun s => X (u s))
          (X udot) τ) →
      Work.FTS.StrongPersist.EnergyDeriv (Work.FTS.StrongPersist.IPiter α c n) u udot τ := by
  intro n
  induction n with
  | zero =>
      intro u udot τ h
      exact h id (IsWordLe.id (n := 0))
  | succ n ih =>
      intro u udot τ h
      -- `IPiter (n+1) = HkIPStep (c n) (IPiter n)`, and the recursion needs the `IPiter n`-energy
      -- derivative of the family and of its two shifts.
      refine Work.FTS.StrongPersist.energyDeriv_HkIPStep (c₁ := (c n).1) (c₂ := (c n).2)
        (IP := Work.FTS.StrongPersist.IPiter α c n)
        (ih (u := u) (udot := udot) (τ := τ) (fun X hX => h X (hX.mono (Nat.le_succ n))))
        (ih (u := fun s => Work.Spaces.Dth (u s)) (udot := Work.Spaces.Dth udot) (τ := τ)
          (fun X hX => h (fun f => X (Work.Spaces.Dth f)) (IsWordLe.dth hX)))
        (ih (u := fun s => Work.Spaces.Dz (u s)) (udot := Work.Spaces.Dz udot) (τ := τ)
          (fun X hX => h (fun f => X (Work.Spaces.Dz f)) (IsWordLe.dz hX)))

/-! ## The two instances the `ε`-scheme needs -/

/-- **The level-four energy identity, refined.**  Words of length at most `3` suffice for the
three-fold recursion `IP4 = IPiter 3`. -/
theorem energyDeriv_IP4_le (α : ℝ) (c₁ c₂ c₁' c₂' c₁'' c₂'' : ℝ) {u : ℝ → Fn} {udot : Fn}
    {τ : ℝ}
    (h : ∀ X : Fn → Fn, IsWordLe 3 X →
      Work.FTS.StrongPersist.EnergyDeriv (Work.Coercivity.H1IP α) (fun s => X (u s))
        (X udot) τ) :
    Work.FTS.StrongPersist.EnergyDeriv
      (Work.FTS.CoercivityFix.Assembly.IP4 c₁ c₂ c₁' c₂' c₁'' c₂'' α) u udot τ := by
  have hmain := energyDeriv_IPiter_le α
    (Work.FTS.StrongPersist.coefs6 0 0 0 0 c₁ c₂ c₁' c₂' c₁'' c₂'') 3 h
  rwa [IPiter_coefs4] at hmain

/-- **The level-six energy identity, refined.**  Words of length at most `5` suffice for the
five-fold recursion `IP6 = IPiter 5`. -/
theorem energyDeriv_IP6_le (α : ℝ) (e₁ e₂ f₁ f₂ c₁ c₂ c₁' c₂' c₁'' c₂'' : ℝ) {u : ℝ → Fn}
    {udot : Fn} {τ : ℝ}
    (h : ∀ X : Fn → Fn, IsWordLe 5 X →
      Work.FTS.StrongPersist.EnergyDeriv (Work.Coercivity.H1IP α) (fun s => X (u s))
        (X udot) τ) :
    Work.FTS.StrongPersist.EnergyDeriv
      (Work.FTS.StrongPersist.IP6 e₁ e₂ f₁ f₂ c₁ c₂ c₁' c₂' c₁'' c₂'' α) u udot τ := by
  have hmain := energyDeriv_IPiter_le α
    (Work.FTS.StrongPersist.coefs6 e₁ e₂ f₁ f₂ c₁ c₂ c₁' c₂' c₁'' c₂'') 5 h
  rwa [Work.FTS.StrongPersist.IPiter_coefs6] at hmain

end Work.FTS.StrongEps.EpsE4Thr
