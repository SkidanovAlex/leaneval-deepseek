/-! ## The scheme's right-hand side as a function of a single profile

The whole local-existence problem is a functional ODE in the profile: the right-hand side of the
projected scheme depends on the family only through its fake-time slice (`epsRHSP_congr`), so it is
a map `epsRHPSlice α ρ ε Φs E τ : Fn → Fn` on profiles, and a solution on `[0,δ]` is a curve
`τ ↦ u τ` of profiles with `u τ = h₀ + ∫_0^τ epsRHPSlice … s (u s) ds`.
-/

/-- **The projected scheme's right-hand side at a single profile**: `epsRHSP` evaluated on the
constant family generated by `u`. -/
noncomputable def epsRHPSlice (α : ℝ) (ρ : ℝ × ℝ → ℝ) (ε : ℝ) (Φs : Fn) (E : Fn → Fn)
    (τ : ℝ) (u : Fn) : Fn :=
  epsRHSP α ρ ε Φs E (famOf (fun _ => u)) τ

/-- The right-hand side of the projected scheme depends on a family only through its slice. -/
theorem epsRHPSlice_slice (α : ℝ) (ρ : ℝ × ℝ → ℝ) (ε : ℝ) (Φs : Fn) (E : Fn → Fn)
    (τ : ℝ) (g : Fam) :
    epsRHPSlice α ρ ε Φs E τ (slice g τ) = epsRHSP α ρ ε Φs E g τ :=
  StrongEpsP.epsRHSP_congr (by rw [Work.FTS.Galerkin.slice_famOf])

/-- The reverse rewriting, in the orientation in which the scheme's prescribed derivative
(`HasDerivWithinAt` with value `epsRHSP … g τ`) is evaluated at the slice. -/
theorem epsRHSP_eq_slice (α : ℝ) (ρ : ℝ × ℝ → ℝ) (ε : ℝ) (Φs : Fn) (E : Fn → Fn)
    (τ : ℝ) (g : Fam) :
    epsRHSP α ρ ε Φs E g τ = epsRHPSlice α ρ ε Φs E τ (slice g τ) :=
  (epsRHPSlice_slice α ρ ε Φs E τ g).symm

/-! ## From the Volterra identity to the pointwise scheme

The last step of every local-existence argument for the projected scheme: a family which starts at
the datum, satisfies the Volterra identity at every point of the open quadrant, and whose right-hand
side is continuous in the fake time there, is a `P₀`-solution in the pointwise sense
(`IsEpsSolP`).  This is the `P₀`-analogue of `IsEpsSol_of_integral`
(`EpsLocalAux/IntegralEq.lean`). -/

/-- **From the integral equation to the pointwise scheme** (projected version). -/
theorem IsEpsSolP_of_integral {α ε T : ℝ} {ρ : ℝ × ℝ → ℝ} {Φs : Fn} {E : Fn → Fn} {g₀ : Fn}
    {g : Fam} (h0 : ∀ z θ, g z θ 0 = g₀ z θ)
    (hint : ∀ z θ, (z, θ) ∈ Work.FTS.EllipticEst.Q0 → ∀ τ ∈ Set.Icc 0 T,
      g z θ τ = g₀ z θ + ∫ s in (0 : ℝ)..τ, epsRHSP α ρ ε Φs E g s z θ)
    (hcont : ∀ z θ, (z, θ) ∈ Work.FTS.EllipticEst.Q0 →
      ContinuousOn (fun s => epsRHSP α ρ ε Φs E g s z θ) (Set.Icc 0 T)) :
    IsEpsSolP α ρ ε T Φs E g₀ g := by
  refine ⟨h0, ?_⟩
  intro z θ τ hz hθ hτ
  have hQ : (z, θ) ∈ Work.FTS.EllipticEst.Q0 :=
    Work.FTS.EllipticEst.mem_Q0.mpr ⟨hz, hθ.1, hθ.2⟩
  set F : ℝ → ℝ := fun s => epsRHSP α ρ ε Φs E g s z θ with hFdef
  have hFcont : ContinuousOn F (Set.Icc 0 T) := hcont z θ hQ
  have hInt : IntervalIntegrable F volume (0 : ℝ) τ :=
    (hFcont.mono (Set.Icc_subset_Icc le_rfl hτ.2)).intervalIntegrable_of_Icc hτ.1
  have hfact : Fact (τ ∈ Set.Icc (0 : ℝ) T) := ⟨hτ⟩
  letI : Fact (τ ∈ Set.Icc (0 : ℝ) T) := hfact
  have hmeas : StronglyMeasurableAtFilter F (𝓝[Set.Icc (0 : ℝ) T] τ) :=
    ⟨Set.Icc (0 : ℝ) T, self_mem_nhdsWithin,
      hFcont.aestronglyMeasurable measurableSet_Icc⟩
  have hcw : ContinuousWithinAt F (Set.Icc (0 : ℝ) T) τ := hFcont τ hτ
  have hprim : HasDerivWithinAt (fun u => g₀ z θ + ∫ s in (0 : ℝ)..u, F s) (F τ)
      (Set.Icc (0 : ℝ) T) τ :=
    (intervalIntegral.integral_hasDerivWithinAt_right hInt hmeas hcw).const_add (g₀ z θ)
  have hcongr : (fun u => g z θ u) =ᶠ[𝓝[Set.Icc (0 : ℝ) T] τ]
      fun u => g₀ z θ + ∫ s in (0 : ℝ)..u, F s := by
    filter_upwards [self_mem_nhdsWithin] with u hu
    rw [hint z θ hQ u hu]
  have hx : g z θ τ = g₀ z θ + ∫ s in (0 : ℝ)..τ, F s := by
    rw [hint z θ hQ τ hτ]
  have hmain := hprim.congr_of_eventuallyEq hcongr hx
  change HasDerivWithinAt (fun s => g z θ s) (epsRHSP α ρ ε Φs E g τ z θ) (Set.Icc 0 T) τ
  simpa only [hFdef] using hmain

theorem EpsLocalPSmall {α C₀ Ce : ℝ} {ρ : ℝ × ℝ → ℝ} {Φs : Work.FTS.Galerkin.Fn}
    {E : Work.FTS.Galerkin.Fn → Work.FTS.Galerkin.Fn} {ε : ℝ}
    (hα : α ∈ Set.Ioc 0 1) (hρ : Work.FTS.StrongEps.IsSmoothKernel ρ) (hε : 0 < ε) (hε1 : ε ≤ 1)
    (hEll : ∀ u : Work.FTS.Galerkin.Fn, Work.FTS.ClassC.ClassC α u →
      Work.FTS.VocabO.EllPkgGo α Ce u (E u) ∧ Work.FTS.ClassC.EllPkgK α 6 Ce u (E u))
    (hml : Work.FTS.StrongEps.MuLamOK α C₀ Φs E) :
    ∀ M' : ℝ, 0 ≤ M' → ∃ δ : ℝ, 0 < δ ∧ ∀ h₀ : Work.FTS.Galerkin.Fn,
      Work.FTS.StrongEps.EpsDatumP α ρ ε h₀ →
      Work.FTS.Nonlin.Xn α (Work.FTS.StrongEps.Pz (Work.FTS.StrongEps.Jeps ρ ε h₀))
        ≤ C₀ * α ^ 2 →
      Work.FTS.StrongGlobal.Xn6 α h₀ ≤ M' →
      ∃ h : Work.FTS.Galerkin.Fam, Work.FTS.StrongEps.IsEpsSolP α ρ ε δ Φs E h₀ h ∧
        Work.FTS.StrongEps.EpsRegP α ρ ε δ h := by
  sorry

end Work.FTS.StrongEps
