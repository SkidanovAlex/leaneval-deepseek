/-
Copyright: work module for the Elgindi finite-time singularity project.

# `Submission/Work/FTS/StrongEps/EpsSpace.lean` — the weighted space `X` of the `ε`-scheme

Two interfaces are needed by the existence/limit arguments of the scheme (`E2`, `E3`, `E5`):

* **`EpsSq α f`** — the *weighted `L²`-size* of a profile in which the `ε`-scheme is Cauchy and
  Lipschitz: the level-`0` energy of the mixed slots, written as a sum of squares (so that it is
  nonnegative everywhere, exactly as `Work.Spaces.HkSq` is).  On the open quadrant
  `EpsSq α f = ∫∫ f² · wtG α` (`Weights.wtG`), the strongest weight the scheme carries:
  `wtG α = w² sin(2θ)^{-γ}` with `γ = 1 + α/10 ≥ η`.
* **`rhsSlice α Φs E τ u`** — the right-hand side of the scheme as a function of a *single profile*
  `u` (the scheme's right-hand side depends on the family only through its slice,
  `StrongGlobal.dynLin_congr` / `dynRHS_congr`); `rhsSlice α Φs E τ (slice g τ) = rhsFun α Φs E g τ`.

These are the vocabulary of the two analytic lemmas that the scheme still owes:
`EpsSq_Jeps_le` (the mollifier is bounded on `X` up to `e^{Cε}`) and `rhsSlice_lipschitz`
(the right-hand side is Lipschitz on the small ball of `X`), from which `E2` (existence, via
Mathlib's Picard–Lindelöf `IsPicardLindelof.exists_eq_forall_mem_Icc_hasDerivWithinAt`) and `E5`
(the difference estimate) are assembled.
-/
import Mathlib.Algebra.Order.Star.Real
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.MeasureTheory.Integral.IntegrableOn
import Mathlib.MeasureTheory.Measure.Haar.OfBasis
import Submission.Work.FTS.StrongEps.Basic
import Submission.Work.FTS.StrongEps.Weights
import Submission.Work.FTS.StrongEps.EpsLimitDefs

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

noncomputable section

open scoped Real Topology
open MeasureTheory Set Filter

namespace Work.FTS.StrongEps

open Work.FTS.Galerkin (Fn Fam slice famOf dynLin dynRHS)

set_option autoImplicit false

/-! ## The weighted size `EpsSq` -/

/-- The weight `w / sin(2θ)^{γ/2}` of the mixed slots of the scheme (its square is `wtG`). -/
def epsW (α : ℝ) (z θ : ℝ) : ℝ :=
  Work.Spaces.w z / Real.sin (2 * θ) ^ (Work.Spaces.gam α / 2)

/-- **The weighted `L²`-size of the scheme**: the level-`0` energy of the mixed slots, written as a
sum of squares so that the integrand is nonnegative everywhere (as in `Work.Spaces.HkSq`). -/
def EpsSq (α : ℝ) (f : Fn) : ℝ :=
  ∫ z in Work.Spaces.Iz, ∫ θ in Work.Spaces.Iθ, (f z θ * epsW α z θ) ^ 2

/-- **Membership in the weighted space `X` of the scheme**: the integrand of `EpsSq` is
integrable (so that `EpsSq` is an honest finite energy rather than Lean's junk value `0`). -/
def EpsMem (α : ℝ) (f : Fn) : Prop :=
  MeasureTheory.IntegrableOn (fun p : ℝ × ℝ => (f p.1 p.2 * epsW α p.1 p.2) ^ 2)
    (Work.Spaces.Iz ×ˢ Work.Spaces.Iθ)

theorem EpsSq_nonneg (α : ℝ) (f : Fn) : 0 ≤ EpsSq α f :=
  MeasureTheory.integral_nonneg fun z =>
    MeasureTheory.integral_nonneg fun θ => sq_nonneg _

theorem EpsSq_zero (α : ℝ) : EpsSq α (fun _ _ => 0) = 0 := by
  simp only [EpsSq, mul_zero, sq, mul_zero]
  simp

theorem EpsSq_congr {α : ℝ} {f f' : Fn} (h : ∀ z θ, f z θ = f' z θ) :
    EpsSq α f = EpsSq α f' := by
  simp only [EpsSq, h]

/-! ## The right-hand side as a function of a profile -/

/-- The scheme's right-hand side applied to a *single profile*: `rhsFun` depends on the family only
through its slice, so we may evaluate it on the constant family generated by `u`. -/
def rhsSlice (α : ℝ) (Φs : Fn) (E : Fn → Fn) (τ : ℝ) (u : Fn) : Fn :=
  rhsFun α Φs E (famOf (fun _ => u)) τ

/-- `rhsSlice` at the slice of a family is the scheme's right-hand side. -/
theorem rhsSlice_slice (α : ℝ) (Φs : Fn) (E : Fn → Fn) (τ : ℝ) (g : Fam) :
    rhsSlice α Φs E τ (slice g τ) = rhsFun α Φs E g τ :=
  rhsFun_congr (Work.FTS.Galerkin.slice_famOf (fun _ => slice g τ) τ)

end Work.FTS.StrongEps
