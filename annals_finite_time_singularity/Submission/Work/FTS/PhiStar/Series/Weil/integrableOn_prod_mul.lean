      _ = M' * (1 / r) * (r * (b - x)) := by
            have hr0 : r ≠ 0 := hr.ne'
            field_simp
      _ ≤ M' * (1 / r) * ((π / 2) * Real.sin (r * (b - x))) :=
            mul_le_mul_of_nonneg_left hmu (mul_nonneg hM'0 (div_nonneg zero_le_one hr.le))
      _ = M' * (1 / r) * (π / 2) * Real.sin (r * (b - x)) := by ring

