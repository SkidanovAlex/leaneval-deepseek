      have hg := lintegral_reflect_Ioo (Real.pi / 4) (Real.pi / 4) (Real.pi / 2)
        (fun x : ℝ => ENNReal.ofReal (v x ^ 2 * (Real.cos (2 * x)) ^ 2
          * (Real.sin (2 * x)) ^ (-(2 + η))))
      rw [show 2 * (Real.pi / 4) - Real.pi / 2 = (0 : ℝ) by ring,
          show 2 * (Real.pi / 4) - Real.pi / 4 = (Real.pi / 4 : ℝ) by ring] at hg
