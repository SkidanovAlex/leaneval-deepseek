  have hR : (∫ t in Set.Ici (max z a), M * t ^ (-p - 1)) = M * (max z a) ^ (-p) / p := by
    rw [MeasureTheory.integral_const_mul]
    rw [integral_Ici_eq_integral_Ioi]
    rw [integral_Ioi_rpow_of_lt hpm hc0]
    rw [show (-p - 1 + 1 : ℝ) = -p by ring]
