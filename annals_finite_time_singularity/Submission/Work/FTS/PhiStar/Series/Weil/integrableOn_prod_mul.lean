    apply ENNReal.measurable_ofReal.comp
    exact measurable_const.mul (by measurability)
  -- push the domination into the lower integral on `Ioi z`
  have hB1 : (∫⁻ t in Set.Ioi z, ENNReal.ofReal ‖F t‖) ≤
