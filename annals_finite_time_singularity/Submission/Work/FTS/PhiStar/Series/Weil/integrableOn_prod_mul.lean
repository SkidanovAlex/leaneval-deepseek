      = ∫ t, ∫ z, (if z < t then f z * g t else 0)
          ∂(volume.restrict (Set.Ioc a b)) ∂(volume.restrict (Set.Ioc a b)) :=
    (intervalIntegral.integral_of_le hab).trans hR1
  exact hL.trans hR.symm

