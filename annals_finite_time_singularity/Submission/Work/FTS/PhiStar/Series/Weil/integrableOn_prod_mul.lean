theorem csIntegralSqrt {α : Type*} [MeasurableSpace α] (μ : MeasureTheory.Measure α)
    {F G : α → ℝ}
    (hF : AEMeasurable F μ) (hG : AEMeasurable G μ)
    (hF2 : MeasureTheory.Integrable (fun x => F x ^ 2) μ)
    (hG2 : MeasureTheory.Integrable (fun x => G x ^ 2) μ) :
