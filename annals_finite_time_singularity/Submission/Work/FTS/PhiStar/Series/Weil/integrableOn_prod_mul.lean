        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) (hbdd t) 2
      have h2 : 1 / t ^ 4 ≤ 1 / a ^ 4 :=
        one_div_le_one_div_of_le ha4 (pow_le_pow_left₀ ha.le hat 4)
