    MeasureTheory.integral_mono (hFmem.integrable_mul hGmem) hAB (fun x => by
      show F x * G x ≤ ‖F x‖ * ‖G x‖
      rw [Real.norm_eq_abs, Real.norm_eq_abs, ← abs_mul]
      exact le_abs_self _)
