theorem integrableOn_and_integral_Ici_oneAdd_rpow_neg_two (L : ℝ) (hL : 0 < L) :
    MeasureTheory.IntegrableOn (fun z : ℝ => (1 + z) ^ (-2 : ℝ)) (Set.Ici L) ∧
