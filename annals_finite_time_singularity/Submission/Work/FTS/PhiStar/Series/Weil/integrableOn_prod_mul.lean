    (hmp.mul hmq).mul hmκ
  have hdom : Integrable (fun θ => ((p θ) ^ 2 * κ θ + (q θ) ^ 2 * κ θ) / 2)
      (volume.restrict s) :=
    (hp.add hq).div_const 2
