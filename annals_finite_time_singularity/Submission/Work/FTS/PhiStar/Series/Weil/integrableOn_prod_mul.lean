    (hs : MeasurableSet s) (hK : 0 ≤ K)
    (haesm : AEStronglyMeasurable f (volume.restrict s))
    (hnn : ∀ x ∈ s, 0 ≤ f x)
    (hint : ∫⁻ x in s, ENNReal.ofReal (f x) ≤ ENNReal.ofReal K) :
