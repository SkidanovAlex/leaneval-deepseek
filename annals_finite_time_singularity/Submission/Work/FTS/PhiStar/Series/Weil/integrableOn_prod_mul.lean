      mul_le_mul_of_nonneg_left (hφdiv t) (by norm_num)
    calc (φ t - c t) ^ 2 / t ^ 4 ≤ (2 * (φ t) ^ 2 + 2 * (c t) ^ 2) / t ^ 4 :=
          div_le_div_of_nonneg_right h1 (by positivity)
