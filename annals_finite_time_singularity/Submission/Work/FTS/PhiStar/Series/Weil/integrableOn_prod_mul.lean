    · rintro ⟨⟨-, htb⟩, hzt⟩; exact ⟨hzt, htb⟩
    · rintro ⟨hzt, htb⟩; exact ⟨⟨lt_of_le_of_lt haz hzt, htb⟩, hzt⟩
