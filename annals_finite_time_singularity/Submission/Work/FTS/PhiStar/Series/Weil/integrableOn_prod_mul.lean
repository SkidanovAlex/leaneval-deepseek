    volume.restrict (Set.Ioo 0 (Real.pi / 2)) = volume.restrict (Set.Icc 0 (Real.pi / 2)) := by
  have hs_sub : Set.Ioo 0 (Real.pi / 2) ⊆ Set.Icc 0 (Real.pi / 2) :=
