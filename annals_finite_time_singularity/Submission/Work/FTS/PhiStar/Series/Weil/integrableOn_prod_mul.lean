      (nhdsWithin (Real.pi / 2) (Set.Iio (Real.pi / 2))) (nhds 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hb
      (Filter.Eventually.of_forall (fun θ => abs_nonneg (u θ))) hle
