    (hint : MeasureTheory.IntegrableOn ψ' (Set.Ioi (0 : ℝ)))
    (hbd : ∀ z, 0 ≤ z → |ψ z| ≤ C * (z * (G z) ^ 2))
    (hG : MeasureTheory.IntegrableOn (fun z => (G z) ^ 2) (Set.Ioi (0 : ℝ))) :
