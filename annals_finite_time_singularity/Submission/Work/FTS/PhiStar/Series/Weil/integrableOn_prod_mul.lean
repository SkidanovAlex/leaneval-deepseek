      (fun t : ℝ => 2 * M ^ 2 / a ^ 4 + 2 * ((c t) ^ 2 / t ^ 4)) (Set.Ioo 0 1) := by
    have hconst : MeasureTheory.IntegrableOn (fun _ : ℝ => 2 * M ^ 2 / a ^ 4) (Set.Ioo 0 1) := by
