        Integrable.const_mul (hfar.mono_set Set.inter_subset_left) 2
      have h2 : Integrable (fun _ : ℝ => 2 * C^2)
          (volume.restrict (Set.Ioi 1 ∩ Set.Icc a b)) :=
        integrableOn_const (C := 2 * C^2) hfin.ne (by finiteness)
      exact h2.add h1
