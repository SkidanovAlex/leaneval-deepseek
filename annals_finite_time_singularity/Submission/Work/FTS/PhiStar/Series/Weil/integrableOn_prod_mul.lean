      _ ≤ 2 * (M ^ 2 / a ^ 4) + 2 * ((c t) ^ 2 / t ^ 4) := by linarith
      _ = 2 * M ^ 2 / a ^ 4 + 2 * ((c t) ^ 2 / t ^ 4) := by ring
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  exact hpt

end Work.FTS.PhiStar.Honesty
