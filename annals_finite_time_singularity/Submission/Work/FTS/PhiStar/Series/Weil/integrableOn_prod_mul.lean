  have hφdiv : ∀ t : ℝ, (φ t) ^ 2 / t ^ 4 ≤ M ^ 2 / a ^ 4 := by
    intro t
    by_cases h0 : φ t = 0
    · rw [h0]
      have : (0 : ℝ) ≤ M ^ 2 / a ^ 4 := by positivity
      simpa using this
    · have ht : t ∈ Set.Icc a b := by
        by_contra hh
        exact h0 (hφsupp t hh)
