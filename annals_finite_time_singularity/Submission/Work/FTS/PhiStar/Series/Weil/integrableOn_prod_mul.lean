private lemma sq_le_mul_of_quadratic_nonneg {A B C : ℝ} (hB : 0 ≤ B)
    (h : ∀ t : ℝ, 0 ≤ A + 2 * t * C + t ^ 2 * B) : C ^ 2 ≤ A * B := by
