  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with z hz
    have h := hle z hz
    have hz0 : 0 ≤ ε / (2 * C) * z⁻¹ := mul_nonneg (by positivity) (inv_nonneg.2 hz.1.le)
    rw [Real.norm_eq_abs, abs_of_nonneg hz0]
    exact h

