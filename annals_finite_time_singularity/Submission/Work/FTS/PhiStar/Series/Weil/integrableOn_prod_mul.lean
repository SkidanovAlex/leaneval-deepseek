    have h1 : ε / 2 ≤ C * (z * (G z) ^ 2) := le_trans (hkey z hz0 hz.2) (hbd z hz0.le)
    have h2 : ε ≤ ((2 * C) * z) * (G z) ^ 2 := by nlinarith [h1]
    have h3 : ε / ((2 * C) * z) ≤ (G z) ^ 2 := by
