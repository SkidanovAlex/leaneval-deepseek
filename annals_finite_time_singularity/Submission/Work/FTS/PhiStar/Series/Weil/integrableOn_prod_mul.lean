/-- Pointwise AM–GM: for `l > 0`, `|a * b| ≤ l/2 * a² + (1/(2 l)) * b²`.  No measurability is
involved. -/
private lemma abs_mul_le_half_sq_add {l a b : ℝ} (hl : 0 < l) :
    |a * b| ≤ l / 2 * a ^ 2 + 1 / (2 * l) * b ^ 2 := by
