    have h := (contDiffOn_succ_iff_deriv_of_isOpen (𝕜 := ℝ) (f := m)
      (s := Set.Ioo (0 : ℝ) (Real.pi / 2)) (n := (1 : ℕ∞ω)) hs)
    rw [show (2 : ℕ∞ω) = (1 : ℕ∞ω) + 1 from rfl]
    rw [h]
    exact ⟨hdiffm, fun hc => absurd hc (by simp), hC1_derivm⟩
