      (Set.Ioi 1 ∩ Set.Icc a b) := by
    have hdom : Integrable (fun t : ℝ => 2 * C^2 + 2 * (c t)^2)
        (volume.restrict (Set.Ioi 1 ∩ Set.Icc a b)) := by
