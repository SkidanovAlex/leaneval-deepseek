    have hreflF : (∫⁻ φ in Set.Ioo 0 (Real.pi / 4),
          ENNReal.ofReal (w φ ^ 2 * (Real.cos (2 * φ)) ^ 2 * (Real.sin (2 * φ)) ^ (-(2 + η))))
