    congr 1 with a
    rw [Real.norm_eq_abs, Real.rpow_two, sq_abs]
  have h2 : (∫ a, ‖G a‖ ^ (2 : ℝ) ∂μ) = ∫ a, G a ^ 2 ∂μ := by
    congr 1 with a
    rw [Real.norm_eq_abs, Real.rpow_two, sq_abs]
  calc (∫ x, F x * G x ∂μ)
      ≤ ∫ x, ‖F x‖ * ‖G x‖ ∂μ := hmono
