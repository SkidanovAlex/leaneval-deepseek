  have hKnn : 0 ≤ K := by
    have hb0 : b 0 ∈ Set.Ioo a β := ⟨ha_lt 0, hlt_β 0⟩
    have h1 : (0 : ℝ) ≤ ∫ x in a..b 0, f x := by
      rw [intervalIntegral_eq_setIntegral_Ioo (le_of_lt (ha_lt 0))]
