    rwa [ENNReal.ofReal_ofNat]
  have hg' : MeasureTheory.MemLp g (ENNReal.ofReal (2:ℝ)) μ := by
    rwa [ENNReal.ofReal_ofNat]
  have hholder := MeasureTheory.integral_mul_le_Lp_mul_Lq_of_nonneg (μ := μ) hpq hfm hgm hf' hg'
