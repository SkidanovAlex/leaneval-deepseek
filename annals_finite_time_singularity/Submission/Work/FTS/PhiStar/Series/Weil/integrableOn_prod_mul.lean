    (hφsupp : ∀ t : ℝ, t ∉ Set.Icc a b → φ t = 0)
    (hnear : MeasureTheory.IntegrableOn (fun t : ℝ => (c t) ^ 2 / t ^ 4) (Set.Ioo 0 1)) :
