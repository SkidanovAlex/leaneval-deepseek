    integral_congr_ae (Filter.Eventually.of_forall fun x => Real.rpow_ofNat (f x) 2)
  have hg2 : (∫ x, g x ^ (2:ℝ) ∂μ) = ∫ x, g x ^ 2 ∂μ :=
    integral_congr_ae (Filter.Eventually.of_forall fun x => Real.rpow_ofNat (g x) 2)
