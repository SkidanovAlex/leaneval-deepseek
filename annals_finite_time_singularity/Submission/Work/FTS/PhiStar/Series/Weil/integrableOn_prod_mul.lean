  -- only obstruction is the hyperplane `q.2 = 0`, which is null.
  have hnull : (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) {q | q.2 = 0} = 0 := by
    have hset : {q : ℝ × ℝ | q.2 = 0} = Set.univ ×ˢ ({0} : Set ℝ) := by
