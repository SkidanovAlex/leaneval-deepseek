/-- `At N j z = ∫_0^1 t^{N+j} / (1 + z*t)^{j+2} dt`. -/
def At (N : ℝ) (j : ℕ) (z : ℝ) : ℝ :=
  ∫ t in (0 : ℝ)..1, t ^ (N + (j : ℝ)) / (1 + z * t) ^ (j + 2)

