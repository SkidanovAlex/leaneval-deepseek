  rw [MeasureTheory.ae_restrict_iff' hs]
  refine Filter.Eventually.of_forall (fun θ hθ => ?_)
  have hk := hκ0 θ hθ
  have h2 : |p θ * q θ| ≤ ((p θ) ^ 2 + (q θ) ^ 2) / 2 := by
    rw [abs_mul]
    nlinarith [sq_nonneg (|p θ| - |q θ|), abs_nonneg (p θ), abs_nonneg (q θ),
      sq_abs (p θ), sq_abs (q θ)]
