      hderiv x (Set.mem_Ioi.2 (lt_trans ha hx.1))
    have hint' : IntervalIntegrable ψ' volume a b :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le hab).2
        (hint.mono_set (fun x hx => Set.mem_Ioi.2 (lt_trans ha hx.1)))
