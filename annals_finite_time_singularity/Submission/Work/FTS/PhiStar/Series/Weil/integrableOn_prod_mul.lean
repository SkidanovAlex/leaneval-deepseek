  have hIntIci : MeasureTheory.IntegrableOn (fun z : ℝ => (1 + z) ^ (-2 : ℝ)) (Set.Ici L) :=
    (integrableOn_Ici_iff_integrableOn_Ioi).mpr hIntIoi
