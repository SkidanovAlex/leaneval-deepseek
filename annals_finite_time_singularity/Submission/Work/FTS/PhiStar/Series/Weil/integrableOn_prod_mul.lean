theorem sigD_eq_neg_two_mul_rho (η θ : ℝ) : sigD η θ = -2 * η * rho η θ := by
  simp only [sigD, rho]
  ring

theorem sig_apply (η θ : ℝ) : sig η θ = (Real.sin (2 * θ)) ^ (-η) := rfl


