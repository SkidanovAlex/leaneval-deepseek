    simp only [hcdef]
    simpa using (tendsto_const_nhds (x := a)).add
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  have hd_tendsto : Tendsto d atTop (𝓝 β) := by
    simp only [hddef]
