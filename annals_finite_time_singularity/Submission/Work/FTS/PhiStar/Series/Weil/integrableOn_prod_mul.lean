private lemma integral_indicator_Ioi {a b z : ℝ} (haz : a ≤ z) (hzb : z ≤ b) {g : ℝ → ℝ} :
    ∫ t, (Set.Ioi z).indicator g t ∂(volume.restrict (Set.Ioc a b)) = ∫ t in z..b, g t := by
