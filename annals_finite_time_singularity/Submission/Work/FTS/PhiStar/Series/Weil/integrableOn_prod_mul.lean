    (hnn : ∀ x ∈ Set.Ioo a β, 0 ≤ f x)
    (hint : ∀ b ∈ Set.Ioo a β, MeasureTheory.IntegrableOn f (Set.Ioo a b))
    (hK : ∀ b ∈ Set.Ioo a β, (∫ x in a..b, f x) ≤ K) :
