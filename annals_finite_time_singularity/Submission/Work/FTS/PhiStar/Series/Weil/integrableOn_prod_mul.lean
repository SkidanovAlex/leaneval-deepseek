  -- monotonicity; otherwise its integral is `0` by convention and the right-hand
  -- side is nonnegative.
  have key : ∫ z, 2 * (g z * g' z) / z ∂(MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ)))
