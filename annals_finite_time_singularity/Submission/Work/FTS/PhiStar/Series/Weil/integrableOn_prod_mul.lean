      ∀ᵐ q ∂(MeasureTheory.volume.restrict
        (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2))),
        q ∈ (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2)) :=
    MeasureTheory.ae_restrict_mem (measurableSet_Ioi.prod measurableSet_Ioo)
  have hne :
      ∀ᵐ q ∂(MeasureTheory.volume.restrict
        (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2))),
