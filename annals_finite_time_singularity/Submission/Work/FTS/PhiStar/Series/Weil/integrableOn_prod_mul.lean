    have h : MeasureTheory.AEStronglyMeasurable (fun x => Real.sqrt (b x ^ 2)) :=
      Real.continuous_sqrt.comp_aestronglyMeasurable hb2.aestronglyMeasurable
    have h' : (fun x => Real.sqrt (b x ^ 2)) = b := by
