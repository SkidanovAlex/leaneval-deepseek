  intro ε hε
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hmain ε hε
  have hNε : (∫ x in s N, ‖f x‖) < ε := by
    have h1 : dist (∫ x in s N, ‖f x‖) 0 < ε := hN N le_rfl
    rw [Real.dist_eq, sub_zero] at h1
    exact lt_of_le_of_lt (le_abs_self _) h1
