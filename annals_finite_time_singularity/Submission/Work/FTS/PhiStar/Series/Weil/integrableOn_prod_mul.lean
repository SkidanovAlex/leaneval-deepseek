  have hCb : ∀ t ∈ Set.Icc a b, ‖φ t‖ ≤ C := fun t ht => le_trans (hK t ht) (le_max_left _ _)
  have hfin : volume (Set.Ioi (1:ℝ) ∩ Set.Icc a b) < ⊤ :=
