  have hpt : (φ t - c t) ^ 2 / t ^ 4 ≤ 2 * M ^ 2 / a ^ 4 + 2 * ((c t) ^ 2 / t ^ 4) := by
    have h1 : (φ t - c t) ^ 2 ≤ 2 * (φ t) ^ 2 + 2 * (c t) ^ 2 := by
      nlinarith [sq_nonneg (φ t + c t)]
