lemma one_sub_mul_abs_le_cos {θ : ℝ} (hθ : |θ| ≤ Real.pi / 2) :
    1 - 2 / Real.pi * |θ| ≤ Real.cos θ := by
  rcases le_total 0 θ with h | h
