theorem seg_second_order_bound (N N' : ℝ → ℝ) (K b : ℝ) (hK : 0 ≤ K) (hb : 0 ≤ b)
    (hd : ∀ x ∈ Set.Icc 0 b, HasDerivWithinAt N (N' x) (Set.Icc 0 b) x)
    (hbd : ∀ x ∈ Set.Icc 0 b, ‖N' x‖ ≤ K * x) :
