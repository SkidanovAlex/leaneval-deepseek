  have hams_a : MeasureTheory.AEStronglyMeasurable a := by
    have h : MeasureTheory.AEStronglyMeasurable (fun x => Real.sqrt (a x ^ 2)) :=
      Real.continuous_sqrt.comp_aestronglyMeasurable ha2.aestronglyMeasurable
