/-!
# `Work.FTS.PhiStar.Honesty.psiSeries_slice_tendsto`

The mode series `psiSeries α F z θ = Σ_m acoeff α m F z · eFam m θ` is generated by the angular
Dirichlet basis `eFam m θ = cos θ · C^{(3/2)}_{2m+1}(sin θ)`, whose members all vanish at
`θ = 0` (`gC_odd_zero`) and at `θ = π/2` (`cos (π/2) = 0`), and which is bounded by
`3 (m+1)` uniformly on `Iθ` (`eFam_sup_le`).  Hence if `Σ_m (m+1) |acoeff α m F z| < ∞` the
series is absolutely and uniformly dominated by the summable majorant
`bound m = 3 (m+1) |acoeff α m F z|`, and Tannery's theorem
(`tendsto_tsum_of_dominated_convergence`) applies at both endpoints: each summand tends to `0`
(continuity of `eFam m` plus `eFam m 0 = eFam m (π/2) = 0`), so does the series.
-/

namespace Work.FTS.PhiStar.Honesty

open Filter Set
open scoped Topology BigOperators

/-- `gC (2m+1) 0 = 0`: the odd-indexed Gegenbauer polynomials vanish at the origin
(local copy of `Gegenbauer.gC_odd_zero`, to keep this file's import cone free of unproved
statements). -/
private lemma gC_odd_zero_local (m : ℕ) :
    Work.FTS.PhiStar.Gegenbauer.gC (2 * m + 1) 0 = 0 := by
  induction m with
  | zero =>
    rw [show Work.FTS.PhiStar.Gegenbauer.gC 1 = (fun x : ℝ => 3 * x) from rfl]
    norm_num
  | succ m ih =>
    have h := Work.FTS.PhiStar.Gegenbauer.gC_rec (2 * m + 1) 0
    have h1 : (2 * m + 1) + 2 = 2 * (m + 1) + 1 := by omega
    rw [h1] at h
    have h3 : (((2 * m + 1 : ℕ) : ℝ) + 3) * Work.FTS.PhiStar.Gegenbauer.gC (2 * m + 1) 0 = 0 := by
      rw [ih]; ring
    simp only [mul_zero, zero_mul] at h
    rw [h3, sub_zero] at h
    have hne : (((2 * m + 1 : ℕ) : ℝ) + 2) ≠ 0 := by positivity
    exact (mul_eq_zero.mp h).resolve_left hne

/-- `eFam m 0 = 0`. -/
private lemma eFam_apply_zero (m : ℕ) : Work.FTS.PhiStar.Gegenbauer.eFam m 0 = 0 := by
  simp only [Work.FTS.PhiStar.Gegenbauer.eFam, Real.cos_zero, Real.sin_zero, one_mul]
  exact gC_odd_zero_local m

/-- `eFam m (π/2) = 0`. -/
private lemma eFam_apply_pi_div_two (m : ℕ) :
    Work.FTS.PhiStar.Gegenbauer.eFam m (Real.pi / 2) = 0 := by
  simp only [Work.FTS.PhiStar.Gegenbauer.eFam, Real.cos_pi_div_two, zero_mul]

/-- `eFam m` is continuous (it is `cos θ · gC (2m+1) (sin θ)`). -/
private lemma continuous_eFam_prv (m : ℕ) : Continuous (Work.FTS.PhiStar.Gegenbauer.eFam m) := by
  unfold Work.FTS.PhiStar.Gegenbauer.eFam
  exact Real.continuous_cos.mul
    (((Work.FTS.PhiStar.Gegenbauer.contDiff_gC (2 * m + 1)).continuous).comp
      Real.continuous_sin)



end Work.FTS.PhiStar.Honesty
