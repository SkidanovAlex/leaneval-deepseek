/-
Copyright: work module for the Elgindi finite-time singularity project.

# The coefficient recursion for `L^i (sin(2θ)²)`, `L = sin(2θ) ∂_θ`

The angular operator `L = D_θ = sin(2θ) ∂_θ` acts on functions of `θ` alone as
`Work.Spaces.Lop u θ = sin(2θ) u'(θ)`.  Since `sin(2θ)² =: s(θ)²` satisfies
`s(θ)² ' = 4 s(θ) cos(2θ)`, the operator maps the ideal generated by `s(θ)²` into itself:

`L (s² · h) = s² · (4 cos(2θ) · h + s · h')`.

Hence every iterate of `s²` is divisible by `s²`:

`L^i (s²) = s² · g i`,

where the coefficient functions `g i` are given by the recursion of this file:

* `gfun 0 = 1`;
* `gfun (i+1) = fun θ => 4 cos(2θ) · gfun i θ + sin(2θ) · deriv (gfun i) θ`.

`gfun` is used by `Work.FTS.EllipticEst.Lop_iter_sin_sq_bound`, whose statement is that the
functions `L^i (s²)`, `i ≤ K`, are all `O(s²)` on `Iθ = [0, π/2]`; equivalently that the
finitely many coefficients `g i`, `i ≤ K`, are bounded on the compact `Iθ`.
-/
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Analysis.Complex.Trigonometric
import Submission.Work.FTS.EllipticEst.ThetaPoincareDefs

-- v435-port: begin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- v435-port: end

noncomputable section

open scoped Real Topology

namespace Work.FTS.EllipticEst

set_option autoImplicit false

/-- The coefficient recursion attached to `L = sin(2θ) ∂_θ` and the special function
`sin(2θ)²`:  `gfun 0 = 1` and
`gfun (i+1) θ = 4 cos(2θ) gfun i θ + sin(2θ) · deriv (gfun i) θ`, so that (see
`LopIter_sin_sq_factor`) one has `L^i (sin(2θ)²) = fun θ => sin(2θ)² · gfun i θ`. -/
noncomputable def gfun : ℕ → ℝ → ℝ
  | 0 => fun _ => 1
  | (n + 1) => fun θ => 4 * Real.cos (2 * θ) * gfun n θ
      + Real.sin (2 * θ) * deriv (gfun n) θ

@[simp] theorem gfun_zero : gfun 0 = fun _ : ℝ => 1 := rfl

@[simp] theorem gfun_succ (n : ℕ) :
    gfun (n + 1) = fun θ => 4 * Real.cos (2 * θ) * gfun n θ
      + Real.sin (2 * θ) * deriv (gfun n) θ := rfl

end Work.FTS.EllipticEst
