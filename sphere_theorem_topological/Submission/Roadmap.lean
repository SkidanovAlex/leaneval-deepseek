`‖m • ξ - m • η‖/(4√Λ)`; `δ₀ := min(m/2, ρ/2, δ/4, r√λ/2, m‖ξ-η‖/8)`; `τ₀ := m - δ₀`,
`q := GExp p (τ₀ • ξ)`, `s := m - δ₀/2`, `βs := GExp p (s • η)`;

