/-- **The grouped data are the basis data**: flattening the groups (signature, a, coefficient)
in order reproduces `certBasis.zip certCoefSym`. -/
theorem certGroups_flat :
    (certGroupSigs.zip certGroupCoefs).flatMap
        (fun p => p.2.zipIdx.map (fun q => (p.1, q.2, q.1)))
      = (certBasis.zip certCoefSym).map (fun p => (p.1.2, p.1.1, p.2)) := by decide

end

