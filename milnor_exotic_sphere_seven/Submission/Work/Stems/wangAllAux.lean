/-!
# Auxiliary lemmas for the unbounded odd step of the `C2` layer

The unbounded form of the Wang odd step over the sphere model
(`Work.Stems.isZero_ratCoh_sphereFibration_all`) is proved from the *power formula* of the Wang
transgression (`Work.Stems.Collar.WangPowFormula`) together with the structure of the fibre's
rational cohomology.  This file collects the bookkeeping and the two algebraic inputs:

* `Work.Stems.exists_smul_oneH_rat` — `H⁰(X;ℚ)` of a path-connected space is generated by the unit
  class (the `ℚ` analogue of `Work.Cohomology.exists_smul_oneH`, which is `ℤ`-valued);
* `Work.Stems.cupH_rat_noZeroDivisor` — a non-zero class of `H⁰(X;ℚ)`, `X` path-connected, is a
  non-zero-divisor for the cup product;
* the degree transports `transIso = transT` of `Work.StemsB.Rat`;
* `Work.Stems.powArg`, `Work.Stems.powRes` — the degree bookkeeping of the power formula.
-/

open CategoryTheory CategoryTheory.Limits
open scoped Topology
open scoped Simplicial

set_option autoImplicit false
set_option linter.unusedVariables false
set_option maxHeartbeats 3200000
set_option backward.isDefEq.respectTransparency false

namespace Work.Stems

noncomputable section

/-- **`H⁰(X;ℚ)` of a path-connected space is generated by the unit class** — the `ℚ` analogue of
`Work.Cohomology.exists_smul_oneH`.  A `0`-cocycle of a path-connected space is constant on the
`0`-simplices (`Work.Cohomology.eval_constancy`), hence a multiple of the augmentation. -/
theorem exists_smul_oneH_rat (X : TopCat) [PathConnectedSpace X]
    (x : ↑(Work.Cohomology.singularCohomology ℚ 0 X)) :
    ∃ a : ℚ, x = a • Work.Cohomology.oneH ℚ (TopCat.toSSet.obj X) := by
  let Y := TopCat.toSSet.obj X
  let z := (Work.StemsB.Rat.h0CycIsoQ Y).hom x
  let α := (Work.Cohomology.SSetCochainComplex ℚ Y).iCycles 0 z
  have hα : Work.Cohomology.cochainDiff ℚ Y α = 0 := Work.Cohomology.cochainDiff_iCycles ℚ Y 0 z
  have hxα : Work.Cohomology.cohomologyClassOf ℚ Y α hα = x :=
    Work.StemsB.Rat.h0ClassOf_iCyclesQ Y x
  have hconst : ∀ s : Y _⦋0⦌, Work.Cohomology.genEval ℚ Y α s
      = Work.Cohomology.genEval ℚ Y α (Work.Cohomology.baseSimplex X) := by
    intro s
    have hf : α.comp ((Work.Cohomology.singularChains ℚ X).d 1 0).hom = 0 := hα
    exact Work.Cohomology.eval_constancy ℚ X α hf s
  let c : ℚ := Work.Cohomology.genEval ℚ Y α (Work.Cohomology.baseSimplex X)
  have hαc : α = c • Work.Cohomology.unitCochain ℚ Y := by
    apply Work.Cohomology.genEval_ext
    intro σ
    rw [Work.Cohomology.genEval_smul, Work.Cohomology.genEval_unitCochain, smul_eq_mul, mul_one]
    exact hconst σ
  have h' : Work.Cohomology.cochainDiff ℚ Y (c • Work.Cohomology.unitCochain ℚ Y) = 0 := hαc ▸ hα
  have hclass_smul_R : ∀ (R : Type) [CommRing R] (W : SSet) (n : ℕ) (a : R)
      (β : Work.Cohomology.Cochain R W n)
      (hβ : Work.Cohomology.cochainDiff R W β = 0)
      (h : Work.Cohomology.cochainDiff R W (a • β) = 0),
      Work.Cohomology.cohomologyClassOf R W (a • β) h
        = a • Work.Cohomology.cohomologyClassOf R W β hβ := by
    intro R _ W n a β hβ h
    rw [Work.Cohomology.cohomologyClassOf, Work.Cohomology.cohomologyClassOf,
      Work.Cohomology.cocycleOf_smul, map_smul]
  have h2 : Work.Cohomology.cohomologyClassOf ℚ Y α hα
      = Work.Cohomology.cohomologyClassOf ℚ Y (c • Work.Cohomology.unitCochain ℚ Y) h' :=
    Work.Cohomology.cohomologyClassOf_congr ℚ Y hαc hα h'
  have h3 : Work.Cohomology.cohomologyClassOf ℚ Y (c • Work.Cohomology.unitCochain ℚ Y) h'
      = c • Work.Cohomology.oneH ℚ Y := by
    rw [Work.Cohomology.oneH]
    exact hclass_smul_R ℚ Y 0 c (Work.Cohomology.unitCochain ℚ Y)
      (Work.Cohomology.cochainDiff_unitCochain ℚ Y) h'
  exact ⟨c, hxα.symm.trans (h2.trans h3)⟩

/-- **A non-zero class of `H⁰(X;ℚ)` of a path-connected space is a non-zero-divisor for the cup
product.**  (`X` path-connected is needed: `H⁰(X;ℚ) ≅ ℚ` is generated by the unit class, and a
non-zero element of the field `ℚ` is invertible.) -/
theorem cupH_rat_noZeroDivisor {X : Type} [TopologicalSpace X] [PathConnectedSpace X]
    (k : ℕ) (u : ↑(Work.Cohomology.singularCohomology ℚ 0 (TopCat.of X))) (hu : u ≠ 0)
    (z : ↑(Work.Cohomology.singularCohomology ℚ k (TopCat.of X)))
    (h : (Work.Cohomology.cupH' ℚ (TopCat.toSSet.obj (TopCat.of X)) k 0) z u = 0) : z = 0 := by
  obtain ⟨a, ha⟩ := exists_smul_oneH_rat (TopCat.of X) u
  have ha0 : a ≠ 0 := by
    intro h0
    apply hu
    rw [ha, h0, zero_smul]
  rw [ha, Work.Cohomology.cupH'_smul_right, Work.Cohomology.cupH'_one_right] at h
  exact (smul_eq_zero.mp h).resolve_left ha0

/-- The degree transport of the cohomology of a space, as an isomorphism (whose underlying map is
`Work.StemsB.Rat.transT`). -/
noncomputable def transIso (Y : Type) [TopologicalSpace Y] {k l : ℕ} (h : k = l) :
    Work.Thom.Coh ℚ k Y ≅ Work.Thom.Coh ℚ l Y :=
  eqToIso (congrArg (fun t => Work.Cohomology.singularCohomology ℚ t (TopCat.of Y)) h)

@[simp] theorem transIso_hom_apply {Y : Type} [TopologicalSpace Y] {k l : ℕ} (h : k = l)
    (v : Work.Thom.Coh ℚ k Y) : (transIso Y h).hom v = Work.StemsB.Rat.transT Y h v := rfl

/-- The degree transport `transT` is injective. -/
theorem transT_injective {Y : Type} [TopologicalSpace Y] {k l : ℕ} (h : k = l) :
    Function.Injective (Work.StemsB.Rat.transT Y h) := by
  intro a b hab
  cases h
  rw [Work.StemsB.Rat.transT_self] at hab
  rw [Work.StemsB.Rat.transT_self] at hab
  exact hab

/-- **A one-dimensional `ℚ`-module is generated by any non-zero element.** -/
theorem eq_smul_of_iso_rat {M : ModuleCat ℚ} (e : M ≅ ModuleCat.of ℚ ℚ) {g : M}
    (hg : g ≠ 0) (y : M) : ∃ a : ℚ, y = a • g := by
  have hg' : e.hom g ≠ 0 := fun h => hg (Work.StemsB.iso_hom_injective_R ℚ e (by rw [h, map_zero]))
  refine ⟨(e.hom y) / (e.hom g), ?_⟩
  apply Work.StemsB.iso_hom_injective_R ℚ e
  rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hg']

/-- The degree bookkeeping of the power formula: `x^{k+2}`, of degree `(b-1)(k+2)`, lives in
degree `n + b` for `n = (b-1)(k+2) - b`. -/
theorem powArg (b k : ℕ) (hb : 2 ≤ b) :
    (b - 1) * (k + 2) = ((b - 1) * (k + 2) - b) + b := by
  refine (Nat.sub_add_cancel ?_).symm
  have h2 : (b - 1) * 2 = (b - 1) + (b - 1) := by ring
  have h1 : (b - 1) * 2 ≤ (b - 1) * (k + 2) :=
    Nat.mul_le_mul_left (b - 1) (by omega : 2 ≤ k + 2)
  omega

/-- The degree bookkeeping of the power formula: `θ(x^{k+2})` lives in degree `(b-1)(k+1)`. -/
theorem powRes (b k : ℕ) (hb : 2 ≤ b) :
    ((b - 1) * (k + 2) - b) + 1 = (b - 1) * (k + 1) := by
  have hA : 0 < (b - 1) * (k + 1) := Nat.mul_pos (by omega) (by omega)
  rw [show (b - 1) * (k + 2) = (b - 1) * (k + 1) + (b - 1) from
    Nat.mul_succ (b - 1) (k + 1)]
  omega


/-- The zero of the transported degree is the zero of the transported degree. -/
theorem transT_zero {Y : Type} [TopologicalSpace Y] {k l : ℕ} (h : k = l) :
    Work.StemsB.Rat.transT Y h (0 : Work.Thom.Coh ℚ k Y) = 0 := by
  cases h
  exact Work.StemsB.Rat.transT_self _ 0

section Tr

variable {E : Type} [TopologicalSpace E]
variable (b : ℕ) (hb : 2 ≤ b) (p : C(E, Work.StemsB.SphModel b))
variable (d_G : ↥(Work.StemsB.sphLoopBig b))
variable (hT_G : Work.StemsB.FibrewiseTrivial p (Work.StemsB.sphLoopBig b) d_G)
variable (hT_O : Work.StemsB.FibrewiseTrivial p (Work.StemsB.sphLoopOuter b) (Work.StemsB.dOuter b))

/-- **`wangTheta` is insensitive to the spelling of its degree index.** -/
theorem wangTheta_index {n n' : ℕ} (h : n = n')
    (z : Work.Thom.Coh ℚ (n + b) ↥(p ⁻¹' {OnePoint.infty})) :
    Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (congrArg (fun t => t + 1) h)
        (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n z)
      = Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n'
          (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (congrArg (fun t => t + b) h) z) := by
  cases h
  rw [Work.StemsB.Rat.transT_self, Work.StemsB.Rat.transT_self]

/-- Injectivity of `wangTheta` is insensitive to the spelling of the degree index. -/
theorem wangTheta_injective_of_index {n n' : ℕ} (h : n = n')
    (h' : Function.Injective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n')) :
    Function.Injective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n) := by
  intro z w hzw
  have h1 : Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n'
      (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (congrArg (fun t => t + b) h) z)
      = Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n'
        (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (congrArg (fun t => t + b) h) w) := by
    rw [← wangTheta_index b hb p d_G hT_G hT_O h z,
      ← wangTheta_index b hb p d_G hT_G hT_O h w, hzw]
  exact transT_injective (Y := ↥(p ⁻¹' {OnePoint.infty})) (congrArg (fun t => t + b) h) (h' h1)

/-- Surjectivity of `wangTheta` is insensitive to the spelling of the degree index. -/
theorem wangTheta_surjective_of_index {n n' : ℕ} (h : n = n')
    (h' : Function.Surjective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n')) :
    Function.Surjective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n) := by
  intro u
  obtain ⟨v', hv'⟩ := h' (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty})
    (congrArg (fun t => t + 1) h) u)
  refine ⟨Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty})
    (congrArg (fun t => t + b) h).symm v', ?_⟩
  apply transT_injective (congrArg (fun t => t + 1) h)
  rw [wangTheta_index b hb p d_G hT_G hT_O h]
  rw [Work.StemsB.Rat.transT_comp, Work.StemsB.Rat.transT_self]
  exact hv'

/-- **Injectivity of the Wang transgression of the sphere fibration**, transported from the
canonical index `(b-1)(k+2)-b`. -/
theorem thetaR_injective_of_index {n n' : ℕ} (h : n = n')
    (h' : Function.Injective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n')) :
    Function.Injective (⇑(Work.StemsB.wangCohShiftθR ℚ (TopCat.of E) (Work.StemsB.Rat.wangA b p)
      (Work.StemsB.wangCohFsp b p) b (Work.StemsB.Rat.wangGammaExplicit b p hT_O)
      (Work.StemsB.Rat.wangTauS b hb E p hT_O d_G hT_G) n)) := by
  have hθ : Function.Injective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n) :=
    wangTheta_injective_of_index b hb p d_G hT_G hT_O h h'
  intro a a' haa
  apply hθ
  rw [← Work.StemsB.Rat.wangTauS_value b hb E p hT_O d_G hT_G n a, haa,
    Work.StemsB.Rat.wangTauS_value b hb E p hT_O d_G hT_G n a']

/-- **Surjectivity of the Wang transgression of the sphere fibration**, transported from the
canonical index `(b-1)(k+2)-b`. -/
theorem thetaR_surjective_of_index {n n' : ℕ} (h : n = n')
    (h' : Function.Surjective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n')) :
    Function.Surjective (⇑(Work.StemsB.wangCohShiftθR ℚ (TopCat.of E) (Work.StemsB.Rat.wangA b p)
      (Work.StemsB.wangCohFsp b p) b (Work.StemsB.Rat.wangGammaExplicit b p hT_O)
      (Work.StemsB.Rat.wangTauS b hb E p hT_O d_G hT_G) n)) := by
  have hθ : Function.Surjective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O n) :=
    wangTheta_surjective_of_index b hb p d_G hT_G hT_O h h'
  intro u
  obtain ⟨v, hv⟩ := hθ u
  exact ⟨v, by rw [Work.StemsB.Rat.wangTauS_value b hb E p hT_O d_G hT_G n v, hv]⟩

end Tr

section Alpha

variable (X : TopCat) (A : Set X) (Fsp : TopCat) (m : ℕ)
variable (γ : (k : ℕ) → Work.Cohomology.singularCohomology ℚ k (TopCat.of ↑A) ≅
  Work.Cohomology.singularCohomology ℚ k Fsp)

/-- **Naturality of the restriction map `α` of the Wang sequence under a change of degree.** -/
theorem wangCohShiftαR_transport {k k' : ℕ} (h : k = k')
    (y : ↑(Work.Cohomology.singularCohomology ℚ k X)) :
    (transIso Fsp h).hom (((Work.StemsB.wangCohShiftαR ℚ X A Fsp m γ k)).hom y)
      = ((Work.StemsB.wangCohShiftαR ℚ X A Fsp m γ k')).hom ((transIso X h).hom y) := by
  cases h
  rw [transIso_hom_apply, transIso_hom_apply, Work.StemsB.Rat.transT_self,
    Work.StemsB.Rat.transT_self]

end Alpha

section Pow

variable {E : Type} [TopologicalSpace E]
variable (b : ℕ) (hb : 2 ≤ b) (p : C(E, Work.StemsB.SphModel b))
variable (d_G : ↥(Work.StemsB.sphLoopBig b))
variable (hT_G : Work.StemsB.FibrewiseTrivial p (Work.StemsB.sphLoopBig b) d_G)
variable (hT_O : Work.StemsB.FibrewiseTrivial p (Work.StemsB.sphLoopOuter b) (Work.StemsB.dOuter b))
variable (x : Work.Thom.Coh ℚ (b - 1) ↥(p ⁻¹' {OnePoint.infty}))

/-- **The powers of the fibre class do not vanish, and neither does the transgression of the
`(k+2)`-nd power.**  This is the induction on which the unbounded odd step rests: the power formula
`θ(x^{k+2}) = (k+2) · x^{k+1} ⌣ θ^{low}(x)` turns the non-vanishing of `x^{k+1} ⌣ θ^{low}(x)`
(which is the non-vanishing of `x^{k+1}`, by the non-zero-divisor property of a non-zero class of
`H⁰`) into the non-vanishing of `θ(x^{k+2})`, which in turn gives the non-vanishing of `x^{k+2}`. -/
theorem pow_and_theta (hbodd : Odd b) (hpc : PathConnectedSpace (↥(p ⁻¹' {OnePoint.infty})))
    (hlow : Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x ≠ 0) (hpow : Work.Stems.Collar.WangPowFormula) :
    ∀ k : ℕ, (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k) ≠ 0) ∧
      (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b) (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1))) ≠ 0) := by
  haveI := hpc
  have xne : x ≠ 0 := fun h => hlow (by rw [h, map_zero])
  have hcup_ne : ∀ (k : ℕ) (z : Work.Thom.Coh ℚ k (↥(p ⁻¹' {OnePoint.infty}))), z ≠ 0 →
      Work.StemsB.Rat.cupT ↥(p ⁻¹' {OnePoint.infty}) (k) (0) (z) (Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x) ≠ 0 := by
    intro k z hz hc
    exact hz (cupH_rat_noZeroDivisor (X := ↥(p ⁻¹' {OnePoint.infty})) k _ hlow z hc)
  intro k
  induction k with
  | zero =>
    have hP0eq : Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (0) = Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) ((by rw [Nat.mul_one])) (x) := rfl
    have hP0ne : Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (0) ≠ 0 := by
      intro h0
      rw [hP0eq] at h0
      exact xne (transT_injective (Y := ↥(p ⁻¹' {OnePoint.infty}))
        (show (b - 1) = (b - 1) * (0 + 1) by rw [Nat.mul_one])
        (by rw [h0, transT_zero (Y := ↥(p ⁻¹' {OnePoint.infty}))]))
    refine ⟨hP0ne, ?_⟩
    intro hθ
    have hf := hpow b hb hbodd E p d_G hT_G hT_O 0 x
    have hcup := hcup_ne ((b - 1) * (0 + 1)) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (0)) hP0ne
    have hrhs : (((0 : ℕ) : ℚ) + 2) • (Work.StemsB.Rat.cupT ↥(p ⁻¹' {OnePoint.infty}) ((b - 1) * (0 + 1)) (0) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (0)) (Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x)) ≠ 0 :=
      smul_ne_zero (by norm_num) hcup
    apply hrhs
    rw [← hf]
    rw [Work.StemsB.Rat.transT_congr _ (powArg b 0 hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (1))]
    rw [hθ]
    exact transT_zero (Y := ↥(p ⁻¹' {OnePoint.infty})) _
  | succ k ih =>
    obtain ⟨_, ihθ⟩ := ih
    have hP' : Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1) ≠ 0 := by
      intro h0
      exact ihθ (by rw [h0, transT_zero (Y := ↥(p ⁻¹' {OnePoint.infty})), map_zero])
    refine ⟨hP', ?_⟩
    intro hθ
    have hf := hpow b hb hbodd E p d_G hT_G hT_O (k + 1) x
    have hcup := hcup_ne ((b - 1) * ((k + 1) + 1)) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1)) hP'
    have hrhs : ((((k + 1) : ℕ) : ℚ) + 2) • (Work.StemsB.Rat.cupT ↥(p ⁻¹' {OnePoint.infty}) ((b - 1) * ((k + 1) + 1)) (0) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1)) (Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x)) ≠ 0 :=
      smul_ne_zero (by positivity) hcup
    apply hrhs
    rw [← hf]
    rw [Work.StemsB.Rat.transT_congr _ (powArg b (k + 1) hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1 + 1))]
    rw [hθ]
    exact transT_zero (Y := ↥(p ⁻¹' {OnePoint.infty})) _

/-- **The canonical transgression `θ_{(b-1)(k+2)-b}` is injective** (`b ≥ 2`, the fibre's
cohomology being one-dimensional in the degrees `(b-1)j`). -/
theorem wangTheta_canon_injective (hbodd : Odd b) (hpc : PathConnectedSpace (↥(p ⁻¹' {OnePoint.infty}))) (hlow : Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x ≠ 0)
    (hpow : Work.Stems.Collar.WangPowFormula)
    (hgen : ∀ k : ℕ, 1 ≤ k → Nonempty (Work.Cohomology.singularCohomology ℚ ((b - 1) * k)
      (Work.StemsB.wangCohFsp b p) ≅ ModuleCat.of ℚ ℚ)) (k : ℕ) :
    Function.Injective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b)) := by
  obtain ⟨_, hθ⟩ := pow_and_theta b hb p d_G hT_G hT_O x hbodd hpc hlow hpow k
  have hP' : Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1) ≠ 0 :=
    fun h0 => hθ (by rw [h0, transT_zero (Y := ↥(p ⁻¹' {OnePoint.infty})), map_zero])
  have hPg : Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb)
      (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1)) ≠ 0 :=
    fun h0 => hP' (transT_injective (Y := ↥(p ⁻¹' {OnePoint.infty})) (powArg b k hb)
      (by rw [h0, transT_zero (Y := ↥(p ⁻¹' {OnePoint.infty}))]))
  obtain ⟨e⟩ := hgen (k + 2) (by omega)
  have hsrc : (b - 1) * (k + 2) = ((b - 1) * (k + 2) - b) + b := powArg b k hb
  have key : ∀ u : Work.Thom.Coh ℚ (((b - 1) * (k + 2) - b) + b) (↥(p ⁻¹' {OnePoint.infty})),
      (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b)) u = 0 → u = 0 := by
    intro u hu
    obtain ⟨a, ha⟩ := eq_smul_of_iso_rat ((transIso (↥(p ⁻¹' {OnePoint.infty})) hsrc).symm ≪≫ e)
      (g := Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb)
        (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1))) hPg u
    have h0 : a • ((Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b)) (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1)))) = 0 := by
      rw [← map_smul, ← ha, hu]
    have haz : a = 0 := (smul_eq_zero.mp h0).resolve_right hθ
    rw [ha, haz, zero_smul]
  intro z w hzw
  have hsub : z - w = 0 := key (z - w) (by rw [map_sub, hzw, sub_self])
  exact sub_eq_zero.mp hsub

/-- **The canonical transgression `θ_{(b-1)(k+2)-b}` is surjective** (a non-zero map between
one-dimensional `ℚ`-vector spaces). -/
theorem wangTheta_canon_surjective (hbodd : Odd b) (hpc : PathConnectedSpace (↥(p ⁻¹' {OnePoint.infty}))) (hlow : Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x ≠ 0)
    (hpow : Work.Stems.Collar.WangPowFormula)
    (hgen : ∀ k : ℕ, 1 ≤ k → Nonempty (Work.Cohomology.singularCohomology ℚ ((b - 1) * k)
      (Work.StemsB.wangCohFsp b p) ≅ ModuleCat.of ℚ ℚ)) (k : ℕ) :
    Function.Surjective (Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b)) := by
  obtain ⟨_, hθ⟩ := pow_and_theta b hb p d_G hT_G hT_O x hbodd hpc hlow hpow k
  obtain ⟨e⟩ := hgen (k + 1) (by omega)
  have htgt : ((b - 1) * (k + 2) - b) + 1 = (b - 1) * (k + 1) := powRes b k hb
  have hne : ((transIso (↥(p ⁻¹' {OnePoint.infty})) htgt) ≪≫ e).hom
      ((Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b)) (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1)))) ≠ 0 :=
    fun h => hθ (Work.StemsB.iso_hom_injective_R ℚ ((transIso (↥(p ⁻¹' {OnePoint.infty})) htgt) ≪≫ e)
      (by rw [h, map_zero]))
  intro u
  refine ⟨(((transIso (↥(p ⁻¹' {OnePoint.infty})) htgt) ≪≫ e).hom u /
      ((transIso (↥(p ⁻¹' {OnePoint.infty})) htgt) ≪≫ e).hom
        ((Work.StemsB.Rat.wangTheta b hb p d_G hT_G hT_O ((b - 1) * (k + 2) - b)) (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1))))) •
      (Work.StemsB.Rat.transT ↥(p ⁻¹' {OnePoint.infty}) (powArg b k hb) (Work.Stems.Collar.wangPow b hb E p d_G hT_G hT_O x (k + 1))), ?_⟩
  apply Work.StemsB.iso_hom_injective_R ℚ ((transIso (↥(p ⁻¹' {OnePoint.infty})) htgt) ≪≫ e)
  simp only [map_smul, smul_eq_mul]
  exact div_mul_cancel₀ _ hne

end Pow

