/-!
# Attaching cells

Area **RATHUREWICZ**.  The blueprint `Submission/Work/Drive/SERRE_BLUEPRINT.md` §2 (C0) builds the
Postnikov models of a space by attaching cells that kill the higher homotopy groups; that
construction, and the maps between different models, are this area's part of the Serre project.

This module fixes the *space*: given a space `Y`, a family of "attaching maps"
`f : ι → C(S^{n+1}, Y)` and the model cell `D^{n+2}`, the space `attachCells n Y ι f` is the pushout
of `Y ← ∐_{i:ι} S^{n+1} → ∐_{i:ι} D^{n+2}`, i.e. `Y` with `(n+2)`-cells glued on along the maps
`f i`.  It is realised as the quotient of the disjoint union `Y ⊕ (ι × D^{n+2})` by the equivalence
relation generated by identifying the boundary point `(i, z)` of the `i`-th cell with `f i z ∈ Y`.

## Main names

* `cellSphere n`, `cellDisk n`, `cellSphereToDisk n` — the model sphere `S^{n+1} ⊆ ℝ^{n+2}`, the
  model cell `D^{n+2}` and the inclusion of the former as the boundary of the latter;
* `attachCells n Y ι f` — the space obtained by attaching the cells;
* `attachIncl n Y ι f : C(Y, attachCells …)` — the inclusion of the old space;
* `cellMap n Y ι f i : C(cellDisk n, attachCells …)` — the characteristic map of the `i`-th cell;
* `attachIncl_attachRel` — the gluing relation `attachIncl (f i z) = cellMap i (z : D)`.

The universal property of the attachment (a map out of `attachCells` is exactly a map `g` out of `Y`
together with maps out of the cells whose boundary restrictions agree with `g ∘ f i`) is delegated;
it is the tool with which the maps between Postnikov models are built.
-/

open CategoryTheory CategoryTheory.Limits
open scoped Topology unitInterval

namespace Work.RatHurewicz

noncomputable section

/-- The model sphere `S^{n+1} ⊆ ℝ^{n+2}`: the boundary of the cell attached in `attachCells n`. -/
abbrev cellSphere (n : ℕ) : Type := Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 2))) 1

/-- The model cell `D^{n+2} ⊆ ℝ^{n+2}` attached in `attachCells n`. -/
abbrev cellDisk (n : ℕ) : Type := ↥(Metric.closedBall (0 : EuclideanSpace ℝ (Fin (n + 2))) 1)

/-- The inclusion of the model sphere as the boundary of the model cell. -/
def cellSphereToDisk (n : ℕ) : C(cellSphere n, cellDisk n) where
  toFun z := ⟨(z : EuclideanSpace ℝ (Fin (n + 2))),
    Metric.mem_closedBall.mpr (by
      have h : dist (z : EuclideanSpace ℝ (Fin (n + 2))) 0 = 1 := Metric.mem_sphere.mp z.2
      simpa using le_of_eq h)⟩
  continuous_toFun :=
    Continuous.subtype_mk continuous_subtype_val (fun z =>
      Metric.mem_closedBall.mpr (by
        have h : dist (z : EuclideanSpace ℝ (Fin (n + 2))) 0 = 1 := Metric.mem_sphere.mp z.2
        simpa using le_of_eq h))

/-- The relation on `Y ⊕ (ι × D^{n+2})` whose equivalence closure is the gluing of the cells: the
boundary point `(i, z)` of the `i`-th cell is identified with `f i z ∈ Y`. -/
def attachRel (n : ℕ) (Y : Type) [TopologicalSpace Y] (ι : Type)
    (f : ι → C(cellSphere n, Y)) :
    (Y ⊕ (Σ _ : ι, cellDisk n)) → (Y ⊕ (Σ _ : ι, cellDisk n)) → Prop :=
  fun a b => ∃ (i : ι) (z : cellSphere n),
    a = Sum.inl (f i z) ∧ b = Sum.inr ⟨i, cellSphereToDisk n z⟩

/-- **The space obtained from `Y` by attaching `(n+2)`-cells** along the attaching maps
`f : ι → C(S^{n+1}, Y)`: the quotient of `Y ⊕ (ι × D^{n+2})` by the gluing relation. -/
abbrev attachCells (n : ℕ) (Y : Type) [TopologicalSpace Y] (ι : Type)
    (f : ι → C(cellSphere n, Y)) : Type :=
  Quotient (Relation.EqvGen.setoid (attachRel n Y ι f))

/-- The inclusion of `Y` into the space obtained by attaching cells. -/
def attachIncl (n : ℕ) (Y : Type) [TopologicalSpace Y] (ι : Type)
    (f : ι → C(cellSphere n, Y)) : C(Y, attachCells n Y ι f) where
  toFun y := Quotient.mk'' (Sum.inl y)
  continuous_toFun := continuous_quotient_mk'.comp continuous_inl

/-- The characteristic map of the `i`-th cell. -/
def cellMap (n : ℕ) (Y : Type) [TopologicalSpace Y] (ι : Type)
    (f : ι → C(cellSphere n, Y)) (i : ι) : C(cellDisk n, attachCells n Y ι f) where
  toFun x := Quotient.mk'' (Sum.inr (⟨i, x⟩ : Σ _ : ι, cellDisk n))
  continuous_toFun :=
    continuous_quotient_mk'.comp (continuous_inr.comp continuous_sigmaMk)

/-- **The gluing relation**: the boundary of the `i`-th cell is glued to `Y` along the attaching map
`f i`. -/
theorem attachIncl_attachRel (n : ℕ) (Y : Type) [TopologicalSpace Y] (ι : Type)
    (f : ι → C(cellSphere n, Y)) (i : ι) (z : cellSphere n) :
    attachIncl n Y ι f (f i z) = cellMap n Y ι f i (cellSphereToDisk n z) :=
  Quotient.sound (s := Relation.EqvGen.setoid (attachRel n Y ι f))
    (Relation.EqvGen.rel (r := attachRel n Y ι f) _ _
      ⟨i, z, rfl, rfl⟩)

end

end Work.RatHurewicz
