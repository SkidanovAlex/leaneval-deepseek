/-!
# Base change for the mapping cylinder along a preimage: the relative chains

For `q : C(X, Γ')` and a **closed** subset `S ⊆ Γ'`, the map
`Work.Serre.DiscPair.cylPreimageLift q S` identifies the mapping cylinder of the restricted map
`q|_S : q ⁻¹' S → S` with the part `(cylRetract q) ⁻¹' S` of the mapping cylinder of `q` lying over
`S`.  Here we prove that this identification is a **homeomorphism of pairs**, carrying the bottom
copy of the source onto the part of the bottom copy lying over `S`, and deduce that the two
relative singular chain complexes (with rational coefficients) are isomorphic.

The two ingredients are

* `isQuotientMap_cylPreimageLift` (the restriction of the quotient map defining the mapping cylinder
  to the preimage of a *closed* set is a quotient map,
  `isQuotientMap_restrictPreimage_of_isClosed`),
* the injectivity of `cylPreimageLift`, i.e. the statement that the gluing relation of `cyl (q|_S)`
  is exactly the gluing relation of `cyl q` restricted to the saturated subset `cylPreSet q S`;
  this is `eqvGen_cylEmb` below.
-/

set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped Topology unitInterval

namespace Work.Serre.DiscPair

noncomputable section

variable {X Γ' : Type} [TopologicalSpace X] [TopologicalSpace Γ']

/-! ## The gluing relation of the restricted mapping cylinder

The saturated subset `cylPreSet q S` of the presenting disjoint union of `cyl q` is the image of the
presenting disjoint union of `cyl (qS q S)` under the embedding `cylEmb q S`; `cylEmbSet q S` is the
corresponding bijection onto `cylPreSet q S` (it is an embedding with that range).  We let `invEmb`
be its inverse and show that the equivalence relation generated by the gluing relation of `cyl q`
inside `cylPreSet q S` is generated by the gluing relation of `cyl (qS q S)`.
-/

/-! ## A quotient map restricted to the preimage of a closed set

The closed case of Mathlib's `Topology.IsQuotientMap.restrictPreimage_isOpen`: the restriction of a
quotient map to the preimage of a closed set, corestricted to that set, is again a quotient map.
(It is **not** true for an arbitrary set: see the counterexample in
`Submission/Work/Serre/DiscPair/cylRestrictQuotient.lean`.)
-/

/-- **The restriction of a quotient map to the preimage of a closed set is a quotient map.** -/
theorem isQuotientMap_restrictPreimage_of_isClosed {X Y : Type} [TopologicalSpace X]
    [TopologicalSpace Y] {f : X → Y} (hf : Topology.IsQuotientMap f) {V : Set Y}
    (hV : IsClosed V) :
    Topology.IsQuotientMap (fun a : ↥(f ⁻¹' V) => (⟨f a.1, a.2⟩ : ↥V)) := by
  have hco : Topology.IsCoinducing (V.restrictPreimage f) := by
    refine .of_isClosed_preimage_iff_isClosed fun u => ?_
    rw [hV.isClosedEmbedding_subtypeVal.isClosed_iff_image_isClosed,
      ← hf.isCoinducing.isClosed_preimage,
      (hV.preimage hf.continuous).isClosedEmbedding_subtypeVal.isClosed_iff_image_isClosed,
      Set.image_val_preimage_restrictPreimage]
  refine ⟨?_, ?_⟩
  · exact hco
  · intro y
    obtain ⟨x, hx⟩ := hf.surjective y.1
    exact ⟨⟨x, by show f x ∈ V; rw [hx]; exact y.2⟩, Subtype.ext hx⟩

/-- The chosen preimage, under `cylEmb q S`, of a point of the saturated set `cylPreSet q S`. -/
def invEmb (q : C(X, Γ')) (S : Set Γ') :
    ↥(cylPreSet q S) → (↥(q ⁻¹' S) × unitInterval) ⊕ ↥S :=
  fun y => Classical.choose (surjective_cylEmbSet q S y)

lemma invEmb_spec (q : C(X, Γ')) (S : Set Γ') (y : ↥(cylPreSet q S)) :
    cylEmbSet q S (invEmb q S y) = y :=
  Classical.choose_spec (surjective_cylEmbSet q S y)

/-- `invEmb` is a left inverse of `cylEmbSet`. -/
lemma invEmb_cylEmbSet (q : C(X, Γ')) (S : Set Γ')
    (a : (↥(q ⁻¹' S) × unitInterval) ⊕ ↥S) :
    invEmb q S (cylEmbSet q S a) = a :=
  (isEmbedding_cylEmbSet q S).injective (invEmb_spec q S (cylEmbSet q S a))

/-- The same, in the syntactic shape in which it is used below. -/
lemma invEmb_cylEmb (q : C(X, Γ')) (S : Set Γ')
    (a : (↥(q ⁻¹' S) × unitInterval) ⊕ ↥S) :
    invEmb q S ⟨cylEmb q S a, mem_cylPreSet_emb q S a⟩ = a :=
  invEmb_cylEmbSet q S a

/-- **The gluing relation of `cyl (qS q S)` is the gluing relation of `cyl q` restricted to the
saturated set `cylPreSet q S`.**  Both are the relation obtained by identifying the top circle of
`q⁻¹S × I` with `S` along `q|_S`.

The proof produces the equivalence relation `Q` on `(X × I) ⊕ Γ'` whose classes on `cylPreSet q S`
are computed by `invEmb` and which is trivial outside it; it is an equivalence relation containing
`cylRel q`, so `Relation.EqvGen.eqvGen_le` applies. -/
lemma eqvGen_cylEmb (q : C(X, Γ')) (S : Set Γ')
    {a b : (↥(q ⁻¹' S) × unitInterval) ⊕ ↥S}
    (h : Relation.EqvGen (Work.Serre.cylRel q) (cylEmb q S a) (cylEmb q S b)) :
    Relation.EqvGen (Work.Serre.cylRel (qS q S)) a b := by
  classical
  set Q : (X × unitInterval) ⊕ Γ' → (X × unitInterval) ⊕ Γ' → Prop := fun u v =>
    (u ∈ cylPreSet q S ↔ v ∈ cylPreSet q S) ∧
    (∀ (h1 : u ∈ cylPreSet q S) (h2 : v ∈ cylPreSet q S),
      Relation.EqvGen (Work.Serre.cylRel (qS q S)) (invEmb q S ⟨u,h1⟩) (invEmb q S ⟨v,h2⟩))
    with hQdef
  have hequiv : Equivalence Q := by
    refine ⟨?_, ?_, ?_⟩
    · intro u
      refine ⟨Iff.rfl, ?_⟩
      intro h1 h2
      have he : invEmb q S ⟨u,h1⟩ = invEmb q S ⟨u,h2⟩ :=
        congrArg (invEmb q S) (Subtype.ext rfl)
      rw [he]
      exact Relation.EqvGen.refl _
    · intro u v huv
      exact ⟨huv.1.symm, fun h1 h2 => (huv.2 h2 h1).symm⟩
    · intro u v w huv hvw
      refine ⟨huv.1.trans hvw.1, fun h1 h3 => ?_⟩
      exact Relation.EqvGen.trans _ _ _
        (huv.2 h1 (huv.1.mp h1)) (hvw.2 (huv.1.mp h1) h3)
  haveI : IsEquiv ((X × unitInterval) ⊕ Γ') Q := Equivalence.isEquiv Q hequiv
  have hle : Work.Serre.cylRel q ≤ Q := by
    rintro u v ⟨p, rfl, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [mem_cylPreSet_inl, mem_cylPreSet_inr]
    · intro h1 h2
      have hp : q p ∈ S := (mem_cylPreSet_inr q S (q p)).mp h2
      have ep : invEmb q S ⟨Sum.inl (p, (1 : unitInterval)), h1⟩
          = Sum.inl (⟨p, hp⟩, (1 : unitInterval)) := by
        have hy : cylEmbSet q S (Sum.inl (⟨(⟨p, hp⟩ : ↥(q ⁻¹' S)), (1 : unitInterval)⟩))
            = ⟨Sum.inl (p, (1 : unitInterval)), h1⟩ := Subtype.ext rfl
        calc invEmb q S ⟨Sum.inl (p, (1 : unitInterval)), h1⟩
            = invEmb q S (cylEmbSet q S (Sum.inl (⟨p, hp⟩, (1 : unitInterval)))) := by rw [hy]
          _ = Sum.inl (⟨p, hp⟩, (1 : unitInterval)) := invEmb_cylEmbSet q S _
      have eq : invEmb q S ⟨Sum.inr (q p), h2⟩ = Sum.inr ((qS q S) ⟨p, hp⟩) := by
        have hy : cylEmbSet q S (Sum.inr (⟨q p, hp⟩ : ↥S)) = ⟨Sum.inr (q p), h2⟩ :=
          Subtype.ext rfl
        calc invEmb q S ⟨Sum.inr (q p), h2⟩
            = invEmb q S (cylEmbSet q S (Sum.inr (⟨q p, hp⟩ : ↥S))) := by rw [hy]
          _ = Sum.inr (⟨q p, hp⟩ : ↥S) := invEmb_cylEmbSet q S _
          _ = Sum.inr ((qS q S) ⟨p, hp⟩) := by rw [qS_apply]
      exact Relation.EqvGen.rel _ _ ⟨⟨p, hp⟩, ep, eq⟩
  have hQ := Relation.EqvGen.eqvGen_le (r := Work.Serre.cylRel q) (r' := Q) hle
  have key := (hQ _ _ h).2 (mem_cylPreSet_emb q S a) (mem_cylPreSet_emb q S b)
  rw [invEmb_cylEmb q S a, invEmb_cylEmb q S b] at key
  exact key

/-! ## The kernel of `cylPreimageFun` -/

/-- Representing a point of the part of the mapping cylinder over `S` by a point of the presenting
disjoint union: the value of `cylPreimageFun` in `cyl q` is `cylMk q` of `cylEmb`. -/
lemma coe_cylPreimageFun (q : C(X, Γ')) (S : Set Γ')
    (a : (↥(q ⁻¹' S) × unitInterval) ⊕ ↥S) :
    ((cylPreimageFun q S a : ↥((Work.Serre.cylRetract q) ⁻¹' S)) : Work.Serre.cyl q)
      = Work.Serre.cylMk q (cylEmb q S a) := by
  cases a with
  | inl z => rfl
  | inr y => rfl

/-- **`cylPreimageFun` has exactly the kernel of the quotient map `cylMk (qS q S)`.** -/
lemma cylPreimageFun_eq_iff (q : C(X, Γ')) (S : Set Γ')
    (a b : (↥(q ⁻¹' S) × unitInterval) ⊕ ↥S) :
    cylPreimageFun q S a = cylPreimageFun q S b ↔
      Relation.EqvGen (Work.Serre.cylRel (qS q S)) a b := by
  constructor
  · intro h
    have h1 : Work.Serre.cylMk q (cylEmb q S a) = Work.Serre.cylMk q (cylEmb q S b) := by
      rw [← coe_cylPreimageFun q S a, ← coe_cylPreimageFun q S b, h]
    exact eqvGen_cylEmb q S (Quotient.exact h1)
  · exact cylPreimageFun_rel q S a b

/-- **The identification `cyl (qS q S) → (cylRetract q) ⁻¹' S` is injective.** -/
lemma cylPreimageLift_injective (q : C(X, Γ')) (S : Set Γ') :
    Function.Injective (cylPreimageLift q S) := by
  intro x y h
  revert h
  revert y
  induction x using Quotient.inductionOn with
  | h a =>
      intro y h
      revert h
      induction y using Quotient.inductionOn with
      | h b =>
          intro h
          have h1 : cylPreimageFun q S a = cylPreimageFun q S b := by
            rw [← cylPreimageLift_cylMk q S a, ← cylPreimageLift_cylMk q S b]
            exact h
          exact Quotient.sound ((cylPreimageFun_eq_iff q S a b).mp h1)

/-! ## The homeomorphism of pairs -/

/-- **The mapping cylinder of `q|_S` is the part of the mapping cylinder of `q` over `S`**, for a
closed `S`.  It is the map `cylPreimageLift q S`, which is a bijective quotient map. -/
def cylPreimageHomeo (q : C(X, Γ')) (S : Set Γ') (hS : IsClosed S) :
    Work.Serre.cyl (qS q S) ≃ₜ ↥((Work.Serre.cylRetract q) ⁻¹' S) :=
  (isHomeomorph_iff_isQuotientMap_injective.mpr
    ⟨isQuotientMap_cylPreimageLift q S
        (isQuotientMap_restrictPreimage_of_isClosed isQuotientMap_quotient_mk'
          (hS.preimage (Work.Serre.cylRetract q).continuous)),
      cylPreimageLift_injective q S⟩).homeomorph (cylPreimageLift q S)

@[simp] lemma cylPreimageHomeo_apply (q : C(X, Γ')) (S : Set Γ') (hS : IsClosed S)
    (x : Work.Serre.cyl (qS q S)) :
    cylPreimageHomeo q S hS x = cylPreimageLift q S x := rfl

/-- The homeomorphism carries the bottom copy of the source onto the part of the bottom copy lying
over `S`. -/
lemma cylPreimageHomeo_range (q : C(X, Γ')) (S : Set Γ') (hS : IsClosed S) (x : Work.Serre.cyl (qS q S)) :
    ((cylPreimageHomeo q S hS x : ↥((Work.Serre.cylRetract q) ⁻¹' S)) : Work.Serre.cyl q)
        ∈ Set.range (Work.Serre.cylIncl q) ↔
      x ∈ Set.range (Work.Serre.cylIncl (qS q S)) := by
  simpa only [cylPreimageHomeo_apply] using cylPreimageLift_range q S x

/-! ## The target -/

theorem cylPreimageRelChainsIso {X Γ' : Type} [TopologicalSpace X] [TopologicalSpace Γ']
    (q : C(X, Γ')) (S : Set Γ') (hS : IsClosed S) :
    Nonempty (Work.StemsB.relChainsR ℚ (TopCat.of ↥((Work.Serre.cylRetract q) ⁻¹' S))
        {x : ↥((Work.Serre.cylRetract q) ⁻¹' S) |
          (x : Work.Serre.cyl q) ∈ Set.range (Work.Serre.cylIncl q)} ≅
      Work.StemsB.relChainsR ℚ (TopCat.of (Work.Serre.cyl (Work.Serre.DiscPair.qS q S)))
        (Set.range (Work.Serre.cylIncl (Work.Serre.DiscPair.qS q S)))) := by
  obtain ⟨i⟩ := Work.StemsB.relChainsRIsoOfHomeo ℚ (Work.Serre.cyl (qS q S))
    ↥((Work.Serre.cylRetract q) ⁻¹' S)
    (Set.range (Work.Serre.cylIncl (qS q S)))
    {x : ↥((Work.Serre.cylRetract q) ⁻¹' S) |
      (x : Work.Serre.cyl q) ∈ Set.range (Work.Serre.cylIncl q)}
    (cylPreimageHomeo q S hS)
    (fun x => (cylPreimageHomeo_range q S hS x).symm)
  exact ⟨i.symm⟩

end

end Work.Serre.DiscPair
