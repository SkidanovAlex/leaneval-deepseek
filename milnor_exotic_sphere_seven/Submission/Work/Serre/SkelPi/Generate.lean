/-!
# `π₁` of the `1`-skeleton is generated by the classes of its `1`-cells

`Skel X pt` is the wedge of one circle per based loop of `X`.  Its `1`-cells are the circles of
this wedge, and the main result here is that `π₁(Skel X pt, base)` is *generated* by the classes of
these circles (`cellSubgroup_eq_top`), equivalently that the `cellClassHom` classes generate `π₁`
in the `HomotopyGroup` formulation (`closure_cellClassHom_eq_top`).

The proof is the standard one: a loop is subdivided (`skelSubdivision`) into pieces which either
lie in one open cell or in the contractible spider; the telescoping identity
(`qconcat_telescope`) turns the loop into a product of the "brackets"
`leg(x) · γ|[a,b] · leg(y)⁻¹` of the pieces, each of which lies in `cellSubgroup` by
`cellBracket_mem_cellSubgroup` (open cell) or is trivial by `spiderBracket_eq_one` (spider).
-/

open scoped Topology Topology.Homotopy unitInterval

namespace Work.Serre.SkelPi

noncomputable section

/-! ## Cast bookkeeping for path homotopy classes -/

/-- Casting a path homotopy class along two *proofs* of the same pair of endpoint equalities gives
the same result (all the endpoints are propositionally, hence definitionally, irrelevant). -/
theorem quotient_cast_congr {Y : Type} [TopologicalSpace Y] {x y x' y' : Y}
    (P : Path.Homotopic.Quotient x y) (hx hx' : x' = x) (hy hy' : y' = y) :
    P.cast hx hy = P.cast hx' hy' := by
  induction P using Quotient.inductionOn with
  | h p => simp only [← Path.Homotopic.Quotient.mk_cast]

/-- The reverse of the constant path class is itself. -/
theorem quotient_symm_refl {Y : Type} [TopologicalSpace Y] (x : Y) :
    (Path.Homotopic.Quotient.refl x).symm = Path.Homotopic.Quotient.refl x := by
  simpa using Path.Homotopic.Quotient.symm_trans (Path.Homotopic.Quotient.refl x)

/-! ## Restricting a path to a subinterval -/

/-- A path which takes all its values on `Icc t₀ t₁` in `S` remains in `S` after restriction to
the subinterval `[t₀, t₁]`. -/
theorem subpath_mem {Y : Type} [TopologicalSpace Y] {a b : Y} (γ : Path a b) {S : Set Y}
    {t₀ t₁ : unitInterval} (hle : t₀ ≤ t₁) (h : ∀ s ∈ Set.Icc t₀ t₁, γ s ∈ S)
    (s : unitInterval) : γ.subpath t₀ t₁ s ∈ S :=
  h _ ⟨Set.Icc.le_convexComb hle s, Set.Icc.convexComb_le hle s⟩

/-- The subpath from `t 0` to `t (last M)` of `γ` is the subpath from `0` to `1`, with the
endpoints relabelled. -/
theorem subpath_eq_cast {Y : Type} [TopologicalSpace Y] {a b : Y} (γ : Path a b)
    {M : ℕ} {t : Fin (M + 1) → unitInterval} (ht0 : t 0 = 0) (htm : t (Fin.last M) = 1) :
    γ.subpath (t 0) (t (Fin.last M))
      = (γ.subpath 0 1).cast (congrArg γ ht0) (congrArg γ htm) := by
  refine Path.ext (funext fun s => ?_)
  show γ (Set.Icc.convexComb (t 0) (t (Fin.last M)) s) = γ (Set.Icc.convexComb 0 1 s)
  rw [ht0, htm]

/-! ## The chosen leg is invariant under relabelling the endpoint -/

/-- The chosen leg of a point of the skeleton is natural in the point. -/
theorem legOf_congr (X : Type) [TopologicalSpace X] (pt : X) {z z' : Skel X pt} (h : z = z') :
    (legOf X pt z).cast rfl h.symm = legOf X pt z' := by
  cases h
  rw [Path.cast_rfl_rfl]

/-- The leg of a point of the skeleton which happens to be the base point is the constant path. -/
theorem legOf_cast_eq_refl (X : Type) [TopologicalSpace X] (pt : X) {z : Skel X pt}
    (h : z = base X pt) :
    (legOf X pt z).cast rfl h.symm = Path.refl (base X pt) := by
  rw [legOf_congr X pt h, legOf_base X pt]

/-! ## A `qconcat` of loops lies in a subgroup -/

/-- A `qconcat` of loops at `b`, all lying in a subgroup `H`, lies in `H`. -/
theorem qconcat_loop_mem {Y : Type} [TopologicalSpace Y] (b : Y) {n : ℕ}
    (B : (k : Fin n) → Path.Homotopic.Quotient b b)
    {H : Subgroup (FundamentalGroup Y b)}
    (hB : ∀ k, B k ∈ H) :
    qconcat (fun _ : Fin (n + 1) => b) B ∈ H := by
  induction n with
  | zero =>
    rw [qconcat_zero]
    exact Subgroup.one_mem H
  | succ n ih =>
    rw [qconcat_succ]
    exact Subgroup.mul_mem H (hB (Fin.last n))
      (ih (fun k => B k.castSucc) (fun k => hB k.castSucc))

/-! ## The main generation theorem -/

/-- **Every loop of the `1`-skeleton lies in the subgroup generated by the cells.** -/
theorem mk_loop_mem_cellSubgroup (X : Type) [TopologicalSpace X] (pt : X)
    (γ : Path (base X pt) (base X pt)) :
    Path.Homotopic.Quotient.mk γ ∈ cellSubgroup X pt := by
  classical
  obtain ⟨M, _, t, ht0, htm, htmono, hpiece⟩ := skelSubdivision X pt γ
  let p : Fin (M + 1) → Skel X pt := fun k => γ (t k)
  let F : (k : Fin M) → Path.Homotopic.Quotient (p k.castSucc) (p k.succ) :=
    fun k => Path.Homotopic.Quotient.mk (γ.subpath (t k.castSucc) (t k.succ))
  let c : (k : Fin (M + 1)) → Path.Homotopic.Quotient (base X pt) (p k) :=
    fun k => Path.Homotopic.Quotient.mk (legOf X pt (p k))
  let B : (k : Fin M) → Path.Homotopic.Quotient (base X pt) (base X pt) :=
    fun k => (c k.castSucc).trans ((F k).trans ((c k.succ).symm))
  let D : Path.Homotopic.Quotient (base X pt) (base X pt) :=
    qconcat (fun _ : Fin (M + 1) => base X pt) B
  -- the loop is the concatenation of its pieces
  have hqconcat : qconcat p F
      = Path.Homotopic.Quotient.mk (γ.subpath (t 0) (t (Fin.last M))) := by
    show qconcat p
        (fun k : Fin M => Path.Homotopic.Quotient.mk (γ.subpath (t k.castSucc) (t k.succ)))
      = Path.Homotopic.Quotient.mk (γ.subpath (t 0) (t (Fin.last M)))
    rw [← qconcat_mk (p := p) (F := fun k : Fin M => γ.subpath (t k.castSucc) (t k.succ))]
    exact (Path.Homotopic.Quotient.eq).mpr (Path.Homotopic.concat_subpath γ t)
  -- the endpoints of the subdivision sit at the base point
  have e0 : p 0 = base X pt := (congrArg γ ht0).trans γ.source
  have em : p (Fin.last M) = base X pt := (congrArg γ htm).trans γ.target
  -- the class of `γ` as a cast of the class of the concatenation
  have hsub : Path.Homotopic.Quotient.mk (γ.subpath (t 0) (t (Fin.last M)))
      = (Path.Homotopic.Quotient.mk γ).cast e0 em := by
    have h1 : Path.Homotopic.Quotient.mk (γ.subpath (t 0) (t (Fin.last M)))
        = (Path.Homotopic.Quotient.mk (γ.subpath 0 1)).cast
            (congrArg γ ht0) (congrArg γ htm) := by
      rw [subpath_eq_cast γ ht0 htm, Path.Homotopic.Quotient.mk_cast]
    have h2 : Path.Homotopic.Quotient.mk (γ.subpath 0 1)
        = (Path.Homotopic.Quotient.mk γ).cast γ.source γ.target := by
      rw [Path.subpath_zero_one γ, Path.Homotopic.Quotient.mk_cast]
    rw [h1, h2, Path.Homotopic.Quotient.cast_cast]
  have hA : Path.Homotopic.Quotient.mk γ
      = (Path.Homotopic.Quotient.mk (γ.subpath (t 0) (t (Fin.last M)))).cast e0.symm em.symm := by
    rw [hsub, Path.Homotopic.Quotient.cast_cast,
      quotient_cast_congr _ (e0.symm.trans e0) rfl (em.symm.trans em) rfl,
      Path.Homotopic.Quotient.cast_rfl_rfl]
  -- the telescoping identity
  have hT : qconcat p F = (c 0).symm.trans (D.trans (c (Fin.last M))) :=
    qconcat_telescope (base X pt) p c F
  -- the two outer legs of the telescoping identity are trivial
  have hc0 : (c 0).cast rfl e0.symm = Path.Homotopic.Quotient.refl (base X pt) := by
    show (Path.Homotopic.Quotient.mk (legOf X pt (p 0))).cast rfl e0.symm
      = Path.Homotopic.Quotient.refl (base X pt)
    rw [← Path.Homotopic.Quotient.mk_cast, legOf_cast_eq_refl X pt e0,
      Path.Homotopic.Quotient.mk_refl]
  have hcM : (c (Fin.last M)).cast rfl em.symm = Path.Homotopic.Quotient.refl (base X pt) := by
    show (Path.Homotopic.Quotient.mk (legOf X pt (p (Fin.last M)))).cast rfl em.symm
      = Path.Homotopic.Quotient.refl (base X pt)
    rw [← Path.Homotopic.Quotient.mk_cast, legOf_cast_eq_refl X pt em,
      Path.Homotopic.Quotient.mk_refl]
  have hD : (qconcat p F).cast e0.symm em.symm = D := by
    rw [hT,
      Quotient_cast_trans ((c 0).symm) (D.trans (c (Fin.last M))) e0.symm em.symm,
      Quotient_cast_symm (c 0) rfl e0.symm, hc0, quotient_symm_refl,
      Quotient_cast_trans D (c (Fin.last M)) rfl em.symm, hcM,
      Path.Homotopic.Quotient.cast_rfl_rfl, ← Path.Homotopic.Quotient.trans_assoc,
      Path.Homotopic.Quotient.refl_trans, Path.Homotopic.Quotient.trans_refl]
  -- each bracket lies in the subgroup
  have hle : ∀ k : Fin M, t k.castSucc ≤ t k.succ := fun k => htmono _ _ (Fin.castSucc_le_succ k)
  have hB : ∀ k : Fin M, B k ∈ cellSubgroup X pt := by
    intro k
    show (Path.Homotopic.Quotient.mk (legOf X pt (p k.castSucc))).trans
        ((Path.Homotopic.Quotient.mk (γ.subpath (t k.castSucc) (t k.succ))).trans
          (Path.Homotopic.Quotient.mk (legOf X pt (p k.succ))).symm)
      ∈ cellSubgroup X pt
    rcases hpiece k with ⟨w, hw⟩ | hsp
    · have hp : p k.castSucc ∈ openCell X pt w := hw _ ⟨le_rfl, hle k⟩
      have hq : p k.succ ∈ openCell X pt w := hw _ ⟨hle k, le_rfl⟩
      have hP : ∀ s, (γ.subpath (t k.castSucc) (t k.succ)) s ∈ openCell X pt w :=
        subpath_mem γ (hle k) hw
      have hbr := cellBracket_mem_cellSubgroup X pt w hp hq
        (γ.subpath (t k.castSucc) (t k.succ)) hP
      rwa [Path.Homotopic.Quotient.trans_assoc] at hbr
    · have hp : p k.castSucc ∈ spider X pt := hsp _ ⟨le_rfl, hle k⟩
      have hq : p k.succ ∈ spider X pt := hsp _ ⟨hle k, le_rfl⟩
      have hP : ∀ s, (γ.subpath (t k.castSucc) (t k.succ)) s ∈ spider X pt :=
        subpath_mem γ (hle k) hsp
      have hbr := spiderBracket_eq_one X pt hp hq
        (γ.subpath (t k.castSucc) (t k.succ)) hP
      rw [Path.Homotopic.Quotient.trans_assoc] at hbr
      rw [hbr]
      exact Subgroup.one_mem (cellSubgroup X pt)
  -- conclusion
  have hAD : Path.Homotopic.Quotient.mk γ = D := by
    rw [hA, ← hqconcat]
    exact hD
  rw [hAD]
  exact qconcat_loop_mem (base X pt) B hB

/-- **`π₁` of the `1`-skeleton is generated by the classes of its `1`-cells.** -/
theorem cellSubgroup_eq_top (X : Type) [TopologicalSpace X] (pt : X) :
    cellSubgroup X pt = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  obtain ⟨γ, rfl⟩ := Path.Homotopic.Quotient.mk_surjective x
  exact mk_loop_mem_cellSubgroup X pt γ

/-- **The `HomotopyGroup` formulation**: the classes of the `1`-cells generate `π₁` of the
skeleton. -/
theorem closure_cellClassHom_eq_top (X : Type) [TopologicalSpace X] (pt : X) :
    Subgroup.closure (Set.range (cellClassHom X pt)) = ⊤ := by
  set e := HomotopyGroup.pi1MulEquivFundamentalGroup (X := Skel X pt) (x := base X pt)
  have hrange : e '' Set.range (cellClassHom X pt) = Set.range (cellLoopClass X pt) := by
    ext y
    constructor
    · rintro ⟨x, ⟨w, rfl⟩, hxy⟩
      exact ⟨w, (cellClassHom_pi1MulEquivFundamentalGroup X pt w).symm.trans hxy⟩
    · rintro ⟨w, rfl⟩
      exact ⟨cellClassHom X pt w, ⟨w, rfl⟩,
        cellClassHom_pi1MulEquivFundamentalGroup X pt w⟩
  have hmap : (Subgroup.closure (Set.range (cellClassHom X pt))).map e.toMonoidHom
      = cellSubgroup X pt := by
    rw [MonoidHom.map_closure]
    change Subgroup.closure (e '' Set.range (cellClassHom X pt)) = cellSubgroup X pt
    rw [hrange]
    rfl
  refine le_antisymm le_top ?_
  intro x _
  have hx : e x ∈ (Subgroup.closure (Set.range (cellClassHom X pt))).map e.toMonoidHom := by
    rw [hmap, cellSubgroup_eq_top X pt]
    exact Subgroup.mem_top _
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  rwa [e.injective hyx] at hy

end

end Work.Serre.SkelPi
