/-!
# The bracket of two legs and a path inside one open cell

`Skel X pt` is the `1`-skeleton of the model of `X`: the wedge of one circle per based loop of
`X` (see `Submission/Work/Serre/SkelPi/Basic.lean`).  Its `1`-cells are the circles, and
`cellSubgroup X pt` is the subgroup of `π₁(Skel X pt, base)` generated by the classes of these
circles.

**The target of this file.**  For two points `p q` of the *same* open cell `openCell X pt w` (a
circle with the base point removed, i.e. an open interval) and a path `P` from `p` to `q` that
stays inside that open cell, the loop

`leg p ⬝ P ⬝ (leg q)⁻¹`

lies in `cellSubgroup X pt`.  Here `leg` is the chosen leg `legOf X pt ·` from the base point into
the cell.

**The proof.**  Write `a = coordOf hp`, `b = coordOf hq` for the model coordinates of `p` and `q`
in the open interval `(-1,1)`, and let

* `e x ∈ {endL, endR}` (`endOf`) be the end of the interval on the side of `x`;
* `F` (`Plift`) be the lift of `P` to the open interval, through a section `cellChart` of the
  characteristic map of the open cell (`Work.Serre.OneCell.exists_chart`);
* `W a b F = seg e a a ⬝ F ⬝ (seg e b b)⁻¹` be the corresponding interval path, from `e a` to `e b`.

Then, pointwise, the image of `W a b F` under the characteristic map is exactly the loop
`leg p ⬝ P ⬝ (leg q)⁻¹` (`LoopPath_eq_loop`); this is `LoopPath`.  Since the interval `D¹` is
convex, `W a b F` is homotopic rel endpoints to the straight segment `seg (endOf a) (endOf b)`
(`LoopPath_homotopic_TargetPath`), whose image `TargetPath` is, according to the two signs of the
coordinates,

* the constant loop at the base point when `e a = e b` (`TargetPath_endL_endL`,
  `TargetPath_endR_endR`),
* the cell loop `cellLoopPath X pt w` when `(e a, e b) = (endL, endR)`
  (`TargetPath_endL_endR`),
* its reverse when `(e a, e b) = (endR, endL)` (`TargetPath_endR_endL`).

In each case the class is `1`, `cellLoopClass X pt w` or its inverse, hence lies in
`cellSubgroup X pt`.
-/


open scoped Topology unitInterval

namespace Work.Serre.SkelPi

noncomputable section

/-! ## The end of the model interval on the side of a point -/

/-- The end of the model interval on the side of `x`: `endL = -1` if `x ≤ 0`, `endR = 1`
otherwise. -/
def endOf (x : Work.Serre.cellDiskOne) : Work.Serre.cellDiskOne :=
  if (x : ℝ) ≤ 0 then endL else endR

theorem endOf_eq_endL {x : Work.Serre.cellDiskOne} (h : (x : ℝ) ≤ 0) : endOf x = endL := by
  rw [endOf, if_pos h]

theorem endOf_eq_endR {x : Work.Serre.cellDiskOne} (h : 0 < (x : ℝ)) : endOf x = endR := by
  rw [endOf, if_neg (not_le.mpr h)]

/-- The chosen end of the cell of `x` is mapped to the base point. -/
theorem cellMap_endOf (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : Work.Serre.cellDiskOne) : cellMap X pt w (endOf x) = base X pt := by
  by_cases h : (x : ℝ) ≤ 0
  · rw [endOf_eq_endL h, cellMap_endL]
  · rw [endOf_eq_endR (lt_of_not_ge h), cellMap_endR]

/-! ## The chosen leg in terms of the straight interval path -/

/-- The chosen leg of a point of an open cell is the characteristic map applied to the straight
segment from the chosen end of the interval. -/
theorem legOf_apply_eq (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {z : Skel X pt} (hz : z ∈ openCell X pt w) (t : unitInterval) :
    legOf X pt z t = cellMap X pt w (seg (endOf (coordOf X pt hz)) (coordOf X pt hz) t) := by
  by_cases hs : (coordOf X pt hz : ℝ) ≤ 0
  · rw [legOf_eq_legL_coordOf X pt hz hs, endOf_eq_endL hs]
    rfl
  · rw [legOf_eq_legR_coordOf X pt hz (lt_of_not_ge hs), endOf_eq_endR (lt_of_not_ge hs)]
    rfl

/-! ## The chart of an open cell -/

/-- A section of the characteristic map of an open cell, with values in the open model interval:
the inverse of the characteristic map restricted to the open cell. -/
def cellChart (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt) :
    C(↥(openCell X pt w), ↥Work.Serre.OneCell.cellInnerOne) :=
  Classical.choose (Work.Serre.OneCell.exists_chart (Y := PUnit) (ι := Idx X pt)
    (f := Work.Serre.E3aSk.skeletonAttach X pt) w)

theorem cellChart_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (y : ↥(openCell X pt w)) : cellMap X pt w (cellChart X pt w y) = (y : Skel X pt) :=
  (Classical.choose_spec (Work.Serre.OneCell.exists_chart (Y := PUnit) (ι := Idx X pt)
    (f := Work.Serre.E3aSk.skeletonAttach X pt) w)).1 y

theorem cellChart_symm (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (x : ↥Work.Serre.OneCell.cellInnerOne) :
    cellChart X pt w ⟨cellMap X pt w x, ⟨x, x.2, rfl⟩⟩ = x :=
  (Classical.choose_spec (Work.Serre.OneCell.exists_chart (Y := PUnit) (ι := Idx X pt)
    (f := Work.Serre.E3aSk.skeletonAttach X pt) w)).2 x

/-- The lift of a path inside an open cell to the open model interval, along the cell chart. -/
def Plift (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {p q : Skel X pt} (hp : p ∈ openCell X pt w) (hq : q ∈ openCell X pt w)
    (P : Path p q) (hP : ∀ t, P t ∈ openCell X pt w) :
    Path (coordOf X pt hp) (coordOf X pt hq) where
  toFun t := (cellChart X pt w ⟨P t, hP t⟩ : Work.Serre.cellDiskOne)
  continuous_toFun := continuous_subtype_val.comp
    ((cellChart X pt w).continuous.comp (Continuous.subtype_mk P.continuous hP))
  source' := by
    have h1 : (⟨P 0, hP 0⟩ : ↥(openCell X pt w)) = ⟨p, hp⟩ := Subtype.ext P.source'
    rw [h1]
    have h2 : (⟨p, hp⟩ : ↥(openCell X pt w)) =
        ⟨cellMap X pt w (⟨coordOf X pt hp, coordOf_mem X pt hp⟩ :
            ↥Work.Serre.OneCell.cellInnerOne), ⟨_, coordOf_mem X pt hp, rfl⟩⟩ :=
      Subtype.ext (cellMap_coordOf X pt hp).symm
    rw [h2, cellChart_symm]
  target' := by
    have h1 : (⟨P 1, hP 1⟩ : ↥(openCell X pt w)) = ⟨q, hq⟩ := Subtype.ext P.target'
    rw [h1]
    have h2 : (⟨q, hq⟩ : ↥(openCell X pt w)) =
        ⟨cellMap X pt w (⟨coordOf X pt hq, coordOf_mem X pt hq⟩ :
            ↥Work.Serre.OneCell.cellInnerOne), ⟨_, coordOf_mem X pt hq, rfl⟩⟩ :=
      Subtype.ext (cellMap_coordOf X pt hq).symm
    rw [h2, cellChart_symm]

theorem Plift_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {p q : Skel X pt} (hp : p ∈ openCell X pt w) (hq : q ∈ openCell X pt w)
    (P : Path p q) (hP : ∀ t, P t ∈ openCell X pt w) (t : unitInterval) :
    cellMap X pt w (Plift X pt w hp hq P hP t) = P t := by
  show cellMap X pt w (cellChart X pt w ⟨P t, hP t⟩) = P t
  rw [cellChart_apply]

/-! ## The interval path and its image in the skeleton -/

/-- The interval path from `endOf a` to `endOf b`: straight from `endOf a` to `a`, along `F` to
`b`, and straight back to `endOf b`. -/
def W (a b : Work.Serre.cellDiskOne) (F : Path a b) : Path (endOf a) (endOf b) :=
  (seg (endOf a) a).trans (F.trans (seg (endOf b) b).symm)

theorem W_homotopic (a b : Work.Serre.cellDiskOne) (F : Path a b) :
    (W a b F).Homotopic (seg (endOf a) (endOf b)) :=
  homotopic_seg _

/-- The image of `W a b F` under the characteristic map of the cell, as a loop at the base
point. -/
def LoopPath (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (a b : Work.Serre.cellDiskOne) (F : Path a b) : Path (base X pt) (base X pt) :=
  ((W a b F).map (cellMap X pt w).continuous).cast
    (cellMap_endOf X pt w a).symm (cellMap_endOf X pt w b).symm

/-- The image of the straight segment `seg (endOf a) (endOf b)` under the characteristic map of
the cell, as a loop at the base point. -/
def TargetPath (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (a b : Work.Serre.cellDiskOne) : Path (base X pt) (base X pt) :=
  ((seg (endOf a) (endOf b)).map (cellMap X pt w).continuous).cast
    (cellMap_endOf X pt w a).symm (cellMap_endOf X pt w b).symm

theorem LoopPath_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (a b : Work.Serre.cellDiskOne) (F : Path a b) (t : unitInterval) :
    LoopPath X pt w a b F t = cellMap X pt w (W a b F t) := by
  simp only [LoopPath, Path.cast, Path.map, Path.map']
  rfl

theorem TargetPath_apply (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (a b : Work.Serre.cellDiskOne) (t : unitInterval) :
    TargetPath X pt w a b t = cellMap X pt w (seg (endOf a) (endOf b) t) := by
  simp only [TargetPath, Path.cast, Path.map, Path.map']
  rfl

theorem LoopPath_homotopic_TargetPath (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    (a b : Work.Serre.cellDiskOne) (F : Path a b) :
    (LoopPath X pt w a b F).Homotopic (TargetPath X pt w a b) :=
  Path.Homotopic.pathCast (Path.Homotopic.map (W_homotopic a b F) (cellMap X pt w)) _ _


/-! ## The straight segment revisited -/

theorem seg_self (a : Work.Serre.cellDiskOne) : seg a a = Path.refl a := by
  refine Path.ext ?_
  funext t
  refine Subtype.ext ?_
  show ((seg a a) t : ℝ) = a
  rw [seg_apply_coe]
  ring

theorem seg_symm (a b : Work.Serre.cellDiskOne) : (seg a b).symm = seg b a := by
  refine Path.ext ?_
  funext t
  refine Subtype.ext ?_
  rw [Path.symm_apply, Function.comp_apply, seg_apply_coe, seg_apply_coe,
    unitInterval.coe_symm_eq]
  ring_nf

/-! ## The pointwise identification of `LoopPath` with the bracket of the legs -/

/-- **The image of the interval path `W a b F` under the characteristic map is the composite of
the two legs with the lift of the path `P`.** -/
theorem LoopPath_eq_loop (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {p q : Skel X pt} (hp : p ∈ openCell X pt w) (hq : q ∈ openCell X pt w)
    (P : Path p q) (hP : ∀ t, P t ∈ openCell X pt w) :
    LoopPath X pt w (coordOf X pt hp) (coordOf X pt hq) (Plift X pt w hp hq P hP) =
      (legOf X pt p).trans (P.trans (legOf X pt q).symm) := by
  refine Path.ext ?_
  funext t
  rw [LoopPath_apply]
  rw [W, Path.trans_apply, Path.trans_apply]
  by_cases ht : (t : ℝ) ≤ 1 / 2
  · rw [dif_pos ht, dif_pos ht, legOf_apply_eq X pt w hp]
  · rw [dif_neg ht, dif_neg ht]
    rw [Path.trans_apply, Path.trans_apply]
    by_cases hs : (2 * (t:ℝ) - 1) ≤ 1 / 2
    · rw [dif_pos hs, dif_pos hs, Plift_apply]
    · rw [dif_neg hs, dif_neg hs]
      rw [Path.symm_apply, Path.symm_apply, Function.comp_apply, Function.comp_apply,
        legOf_apply_eq X pt w hq]

/-! ## The cases of the target path -/

theorem TargetPath_endL_endL (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {a b : Work.Serre.cellDiskOne} (ha : endOf a = endL) (hb : endOf b = endL) :
    TargetPath X pt w a b = Path.refl (base X pt) := by
  refine Path.ext ?_
  funext t
  rw [TargetPath_apply, Path.refl_apply, ha, hb]
  show cellMap X pt w (seg endL endL t) = base X pt
  rw [seg_self, Path.refl_apply, cellMap_endL]

theorem TargetPath_endR_endR (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {a b : Work.Serre.cellDiskOne} (ha : endOf a = endR) (hb : endOf b = endR) :
    TargetPath X pt w a b = Path.refl (base X pt) := by
  refine Path.ext ?_
  funext t
  rw [TargetPath_apply, Path.refl_apply, ha, hb]
  show cellMap X pt w (seg endR endR t) = base X pt
  rw [seg_self, Path.refl_apply, cellMap_endR]

theorem TargetPath_endL_endR (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {a b : Work.Serre.cellDiskOne} (ha : endOf a = endL) (hb : endOf b = endR) :
    TargetPath X pt w a b = cellLoopPath X pt w := by
  refine Path.ext ?_
  funext t
  rw [TargetPath_apply, cellLoopPath_apply, ha, hb]

theorem TargetPath_endR_endL (X : Type) [TopologicalSpace X] (pt : X) (w : Idx X pt)
    {a b : Work.Serre.cellDiskOne} (ha : endOf a = endR) (hb : endOf b = endL) :
    TargetPath X pt w a b = (cellLoopPath X pt w).symm := by
  refine Path.ext ?_
  funext t
  rw [TargetPath_apply, Path.symm_apply, Function.comp_apply, cellLoopPath_apply,
    ha, hb, ← seg_symm, Path.symm_apply, Function.comp_apply]


/-! ## The target: the bracket of two legs and a path inside one open cell -/

theorem cellBracket_mem_cellSubgroup (X : Type) [TopologicalSpace X] (pt : X)
    (w : Idx X pt) {p q : Skel X pt} (hp : p ∈ openCell X pt w) (hq : q ∈ openCell X pt w)
    (P : Path p q) (hP : ∀ t, P t ∈ openCell X pt w) :
    ((Path.Homotopic.Quotient.mk (legOf X pt p)).trans (Path.Homotopic.Quotient.mk P)).trans
      (Path.Homotopic.Quotient.mk (legOf X pt q)).symm ∈ cellSubgroup X pt := by
  have hloop : ((Path.Homotopic.Quotient.mk (legOf X pt p)).trans
        (Path.Homotopic.Quotient.mk P)).trans
        (Path.Homotopic.Quotient.mk (legOf X pt q)).symm =
      Path.Homotopic.Quotient.mk ((legOf X pt p).trans (P.trans (legOf X pt q).symm)) := by
    rw [Path.Homotopic.Quotient.mk_trans, Path.Homotopic.Quotient.mk_trans,
      Path.Homotopic.Quotient.mk_symm, Path.Homotopic.Quotient.trans_assoc]
  rw [hloop, ← LoopPath_eq_loop X pt w hp hq P hP,
    (Path.Homotopic.Quotient.eq).mpr
      (LoopPath_homotopic_TargetPath X pt w (coordOf X pt hp) (coordOf X pt hq)
        (Plift X pt w hp hq P hP))]
  by_cases ha : (coordOf X pt hp : ℝ) ≤ 0
  · by_cases hb : (coordOf X pt hq : ℝ) ≤ 0
    · rw [TargetPath_endL_endL X pt w (endOf_eq_endL ha) (endOf_eq_endL hb),
        Path.Homotopic.Quotient.mk_refl]
      exact Subgroup.one_mem (cellSubgroup X pt)
    · rw [TargetPath_endL_endR X pt w (endOf_eq_endL ha)
          (endOf_eq_endR (lt_of_not_ge hb))]
      exact cellLoopClass_mem_cellSubgroup X pt w
  · by_cases hb : (coordOf X pt hq : ℝ) ≤ 0
    · rw [TargetPath_endR_endL X pt w (endOf_eq_endR (lt_of_not_ge ha))
          (endOf_eq_endL hb), Path.Homotopic.Quotient.mk_symm]
      exact Subgroup.inv_mem _ (cellLoopClass_mem_cellSubgroup X pt w)
    · rw [TargetPath_endR_endR X pt w (endOf_eq_endR (lt_of_not_ge ha))
          (endOf_eq_endR (lt_of_not_ge hb)), Path.Homotopic.Quotient.mk_refl]
      exact Subgroup.one_mem (cellSubgroup X pt)

end

end Work.Serre.SkelPi
