import Mathlib

-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The presentation of an abelian group by its free abelian cover

For an additive commutative group `A`, the free abelian group `A →₀ ℤ` on the underlying type of
`A`, modulo the subgroup generated by the relations `[a + b] - [a] - [b]`, is canonically
isomorphic to `A`: the map `[a] ↦ a` descends to the quotient (the relations are exactly the
additivity relations), and the assignment `a ↦ [a]` is a section of it, hence an inverse, because
in the quotient `[a+b] = [a] + [b]` holds by construction.

This is the standard presentation of an abelian group as a quotient of the free abelian group on
its underlying set; it is the algebraic input of the `C_0`-presentation used in the `SERRE` area.
-/

namespace Work.Serre

noncomputable section

variable (A : Type*) [AddCommGroup A]

/-- The submodule of relations `[a + b] - [a] - [b]` inside the free abelian group on `A`. -/
def serreC0Rel : Submodule ℤ (A →₀ ℤ) :=
  Submodule.span ℤ (Set.range (fun p : A × A =>
    (Finsupp.single (p.1 + p.2) (1 : ℤ) - Finsupp.single p.1 (1 : ℤ) -
      Finsupp.single p.2 (1 : ℤ))))

/-- The ℤ-linear map `(A →₀ ℤ) →ₗ[ℤ] A` sending the generator `[a]` to `a`. -/
def serreC0Eval : (A →₀ ℤ) →ₗ[ℤ] A := Finsupp.linearCombination ℤ (id : A → A)

lemma serreC0Eval_single (a : A) (n : ℤ) : serreC0Eval A (Finsupp.single a n) = n • a := by
  rw [serreC0Eval]
  exact Finsupp.linearCombination_single ℤ n a

lemma serreC0Eval_apply (l : A →₀ ℤ) : serreC0Eval A l = l.sum (fun a n => n • a) := by
  rw [serreC0Eval]
  exact Finsupp.linearCombination_apply ℤ l

/-- The relations are killed by `serreC0Eval`. -/
lemma serreC0Rel_le_ker : serreC0Rel A ≤ LinearMap.ker (serreC0Eval A) := by
  rw [serreC0Rel, Submodule.span_le]
  rintro y ⟨p, rfl⟩
  change serreC0Eval A (Finsupp.single (p.1 + p.2) (1 : ℤ) - Finsupp.single p.1 (1 : ℤ) -
    Finsupp.single p.2 (1 : ℤ)) = 0
  simp only [map_sub, serreC0Eval_single, one_smul]
  abel

/-- Conversely, anything killed by `serreC0Eval` lies in the span of the relations. -/
lemma serreC0_ker_le : LinearMap.ker (serreC0Eval A) ≤ serreC0Rel A := by
  intro x hx
  rw [LinearMap.mem_ker] at hx
  -- the quotient map and the candidate section `a ↦ [a]`
  let q : (A →₀ ℤ) →ₗ[ℤ] (A →₀ ℤ) ⧸ serreC0Rel A := (serreC0Rel A).mkQ
  have hq : ∀ y, q y = Submodule.Quotient.mk y := fun y => Submodule.mkQ_apply (serreC0Rel A) y
  -- `a ↦ [a]` is additive modulo the relations
  have key : ∀ a b : A, q (Finsupp.single (a + b) (1 : ℤ)) =
      q (Finsupp.single a (1 : ℤ)) + q (Finsupp.single b (1 : ℤ)) := by
    intro a b
    have hmem : (Finsupp.single (a + b) (1 : ℤ) - Finsupp.single a (1 : ℤ) -
        Finsupp.single b (1 : ℤ)) ∈ serreC0Rel A := by
      rw [serreC0Rel]
      exact Submodule.subset_span ⟨(a, b), rfl⟩
    have h0 : q (Finsupp.single (a + b) (1 : ℤ) - Finsupp.single a (1 : ℤ) -
        Finsupp.single b (1 : ℤ)) = 0 := by
      rw [hq, Submodule.Quotient.mk_eq_zero]
      exact hmem
    rw [map_sub, map_sub] at h0
    have h1 : q (Finsupp.single (a + b) (1 : ℤ)) - q (Finsupp.single a (1 : ℤ)) =
        q (Finsupp.single b (1 : ℤ)) := sub_eq_zero.mp h0
    have h2 : q (Finsupp.single (a + b) (1 : ℤ)) =
        q (Finsupp.single b (1 : ℤ)) + q (Finsupp.single a (1 : ℤ)) :=
      sub_eq_iff_eq_add.mp h1
    rw [h2, add_comm]
  let ψh : A →+ (A →₀ ℤ) ⧸ serreC0Rel A :=
    AddMonoidHom.mk' (fun a => q (Finsupp.single a (1 : ℤ))) key
  let ψ : A →ₗ[ℤ] (A →₀ ℤ) ⧸ serreC0Rel A := ψh.toIntLinearMap
  have hψ : ∀ a : A, ψ a = q (Finsupp.single a (1 : ℤ)) := fun a => rfl
  -- the section relation
  have hcomp : ∀ y : A →₀ ℤ, ψ (serreC0Eval A y) = q y := by
    intro y
    refine Finsupp.induction_linear y ?_ ?_ ?_
    · simp
    · intro f g hf hg
      rw [map_add (serreC0Eval A) f g, map_add ψ (serreC0Eval A f) (serreC0Eval A g), hf, hg,
        map_add q f g]
    · intro a b
      rw [serreC0Eval_single, map_zsmul, hψ, ← map_zsmul q b (Finsupp.single a (1 : ℤ)),
        Finsupp.smul_single', mul_one]
  have hqx : q x = 0 := by rw [← hcomp x, hx, map_zero]
  rw [hq x] at hqx
  exact (Submodule.Quotient.mk_eq_zero (serreC0Rel A)).mp hqx

lemma serreC0_ker_eq : LinearMap.ker (serreC0Eval A) = serreC0Rel A :=
  le_antisymm (serreC0_ker_le A) (serreC0Rel_le_ker A)

theorem serreC0Presentation (A : Type) [AddCommGroup A] :
    Nonempty (((A →₀ ℤ) ⧸ Submodule.span ℤ (Set.range (fun p : A × A =>
        (Finsupp.single (p.1 + p.2) (1:ℤ) - Finsupp.single p.1 (1:ℤ) - Finsupp.single p.2 (1:ℤ)))))
      ≃ₗ[ℤ] A) := by
  change Nonempty (((A →₀ ℤ) ⧸ serreC0Rel A) ≃ₗ[ℤ] A)
  have hker : serreC0Rel A = LinearMap.ker (serreC0Eval A) := (serreC0_ker_eq A).symm
  have hrange : LinearMap.range (serreC0Eval A) = ⊤ := by
    rw [LinearMap.range_eq_top]
    intro a
    exact ⟨Finsupp.single a 1, by rw [serreC0Eval_single, one_smul]⟩
  exact ⟨(Submodule.quotEquivOfEq (serreC0Rel A) (LinearMap.ker (serreC0Eval A)) hker).trans
    ((LinearMap.quotKerEquivRange (serreC0Eval A)).trans
      ((LinearEquiv.ofEq (LinearMap.range (serreC0Eval A)) ⊤ hrange).trans Submodule.topEquiv))⟩

end

end Work.Serre
