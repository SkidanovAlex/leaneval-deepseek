/-- The collapse of the cube to the sphere, as a generalized loop. -/
def collapseLoop (n : ℕ) (hn : 1 ≤ n) : Ω^ (Fin n) (Sph n) (Work.Stems.collapseMap n hn 0) :=
  ⟨Work.Stems.collapseMap n hn,
    fun q hq => (Work.Stems.collapseMap_boundary n hn hq :
      Work.Stems.collapseMap n hn q = Work.Stems.collapseMap n hn 0)⟩

theorem zero_mem_cube_boundary (n : ℕ) (hn : 1 ≤ n) :
    (0 : Fin n → unitInterval) ∈ Cube.boundary (Fin n) :=
  ⟨⟨0, hn⟩, Or.inl rfl⟩

/-- The base point of `I^n`. -/
theorem cubeLift_basepoint_independent {m : ℕ} {X : Type} [TopologicalSpace X] {x y : X}
    (p : Ω^ (Fin (m+1)) X x) (q : Ω^ (Fin (m+1)) X y) (h : p.1 = q.1) :
    Work.Stems.cubeLift (m+1) (Nat.succ_le_succ (Nat.zero_le m)) p
      = Work.Stems.cubeLift (m+1) (Nat.succ_le_succ (Nat.zero_le m)) q := by
  conv_lhs => rw [Work.Stems.cubeLift]
  conv_rhs => rw [Work.Stems.cubeLift]
  congr 1

/-- **Hurewicz injectivity in the first non-vanishing degree**, `hurewiczMap` form. -/
theorem hurewiczMap_injective_of_conn (k : ℕ) {X : Type} [TopologicalSpace X] (x₀ : X)
    (hconn : ∀ i < k+2, Subsingleton (HomotopyGroup (Fin i) X x₀)) :
    Function.Injective (Work.Stems.hurewiczMap (k+2) (by omega) x₀) := by
  intro a b hab
  have hkey : Work.Stems.hurewiczMap (k+2) (by omega) x₀ (a * b⁻¹) = 0 := by
    have h2 := Work.Stems.hurewiczMap_mul (k+1) (a * b⁻¹) b
    rw [show a * b⁻¹ * b = a from by group, hab] at h2
    have h3 : Work.Stems.hurewiczMap (k+2) (by omega) x₀ (a * b⁻¹)
        + Work.Stems.hurewiczMap (k+2) (by omega) x₀ b
        = 0 + Work.Stems.hurewiczMap (k+2) (by omega) x₀ b := by
      rw [← h2, zero_add]
    exact add_right_cancel h3
  have h1 : a * b⁻¹ = (1 : HomotopyGroup (Fin (k+2)) X x₀) := by
    have h := Work.Stems.Hur2c.hurewiczMapN_eq_const_of_eq_zero (k+2) (by omega) x₀ hconn
      (a * b⁻¹) hkey
    rwa [HomotopyGroup.one_def]
  calc a = a * b⁻¹ * b := by group
    _ = 1 * b := by rw [h1]
    _ = b := one_mul b

/-- **Hurewicz injectivity in the first non-vanishing degree**, in the `n`-shaped index. -/
theorem hurewiczMap_injective_of_conn' (n : ℕ) [Nonempty (Fin n)] (hn : 2 ≤ n)
    {X : Type} [TopologicalSpace X] (x₀ : X)
    (hconn : ∀ i < n, Subsingleton (HomotopyGroup (Fin i) X x₀)) :
    Function.Injective (Work.Stems.hurewiczMap n (by omega) x₀) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 2 := ⟨n - 2, (Nat.sub_add_cancel hn).symm⟩
  exact hurewiczMap_injective_of_conn k x₀ hconn

/-- **Hurewicz injectivity on the sphere.** -/
theorem hurewiczMap_sphere_injective (n : ℕ) [Nonempty (Fin n)] (hn : 2 ≤ n) (x₀ : Sph n) :
    Function.Injective (Work.Stems.hurewiczMap n (by omega) x₀) :=
  hurewiczMap_injective_of_conn' n hn x₀
    (fun i hi => Work.Stems.sphereConnectivity n i hi x₀)


theorem module_eq_zsmul_gen {M : ModuleCat ℤ} (e : M ≅ ModuleCat.of ℤ ℤ) (a : M) :
    a = (ModuleCat.Hom.hom e.hom a) • (ModuleCat.Hom.hom e.inv (1 : ℤ)) := by
  have hmul : ∀ (k : ℤ), ModuleCat.Hom.hom e.inv k = k • ModuleCat.Hom.hom e.inv (1 : ℤ) := by
    intro k
    have hk : k = k • (1 : ℤ) := by rw [smul_eq_mul, mul_one]
    conv_lhs => rw [hk]
    exact map_zsmul _ k (1 : ℤ)
  have h1 : ModuleCat.Hom.hom e.inv (ModuleCat.Hom.hom e.hom a) = a := by
    have h := congrArg ModuleCat.Hom.hom e.hom_inv_id
    rw [ModuleCat.hom_comp, ModuleCat.hom_id] at h
    exact LinearMap.congr_fun h a
  nth_rewrite 1 [← h1]
  exact hmul _

/-- The Hurewicz class of the collapse loop is the sphere generator. -/
theorem hurewiczChain_collapseLoop (m : ℕ) :
    Work.Stems.hurewiczChain (m+1) (Nat.succ_le_succ (Nat.zero_le m))
      (Work.Stems.collapseMap (m+1) (Nat.succ_le_succ (Nat.zero_le m)) 0)
      (collapseLoop (m+1) (Nat.succ_le_succ (Nat.zero_le m)))
      = Work.Stems.sphereGenerator (m+1) (Nat.succ_le_succ (Nat.zero_le m)) := by
  have hcube : Work.Stems.cubeLift (m+1) (Nat.succ_le_succ (Nat.zero_le m))
      (collapseLoop (m+1) (Nat.succ_le_succ (Nat.zero_le m)))
      = ContinuousMap.id (Sph (m+1)) := by
    apply ContinuousMap.ext
    intro y
    obtain ⟨q, rfl⟩ := (Work.Stems.collapseMap_isQuotientMap (m+1)
      (Nat.succ_le_succ (Nat.zero_le m))).surjective y
    have h := congrFun (congrArg DFunLike.coe (Work.Stems.cubeLift_comp (m+1)
      (Nat.succ_le_succ (Nat.zero_le m)) (collapseLoop (m+1)
        (Nat.succ_le_succ (Nat.zero_le m))))) q
    simpa [collapseLoop, ContinuousMap.comp_apply] using h
  rw [Work.Stems.hurewiczChain, hcube, Work.Stems.hurewiczClass]
  simp

/-- Casting a class of a cube across an equality of base points. -/
theorem homotopyGroupCast_mk_eq {m : ℕ} {X : Type} [TopologicalSpace X] {x y : X}
    (h : x = y) (γx : Ω^ (Fin (m+1)) X x) (γy : Ω^ (Fin (m+1)) X y) (hu : γx.1 = γy.1) :
    Work.StemsB.homotopyGroupCast h m (⟦γx⟧ : HomotopyGroup (Fin (m+1)) X x) = ⟦γy⟧ := by
  subst h
  rw [Work.StemsB.homotopyGroupCast_rfl]
  show (⟦γx⟧ : HomotopyGroup (Fin (m+1)) X x) = ⟦γy⟧
  rw [show γx = γy from Subtype.ext hu]


/-- **The key lemma**: a model of `K(ℤ,m+1)` admits a map from `S^{m+1}` that is a bijection on
`π_{m+1}`. -/
theorem exists_bijective_piMapN (m : ℕ) (hm : 1 ≤ m) (X : Type) [TopologicalSpace X] (pt : X)
    (hE : IsEMSpace ℤ (m+1) (by omega : 0 < m+1) X pt) :
    ∃ (s₀ : Sph (m+1)) (f : C(Sph (m+1), X)),
      f s₀ = pt ∧ Function.Bijective (piMapN f (m+1) s₀) := by
  obtain ⟨φ⟩ := hE.1
  let g₀ : HomotopyGroup (Fin (m+1)) X pt := φ.symm (Multiplicative.ofAdd (1:ℤ))
  obtain ⟨γ, hγ⟩ : ∃ γ : Ω^ (Fin (m+1)) X pt, (⟦γ⟧ : HomotopyGroup (Fin (m+1)) X pt) = g₀ :=
    ⟨Quotient.out g₀, Quotient.out_eq g₀⟩
  have h1 : (1:ℕ) ≤ m+1 := Nat.succ_le_succ (Nat.zero_le m)
  have h2 : (2:ℕ) ≤ m+1 := Nat.succ_le_succ hm
  refine ⟨Work.Stems.collapseMap (m+1) h1 0, Work.Stems.cubeLift (m+1) h1 γ, ?_⟩
  set s₀ := Work.Stems.collapseMap (m+1) h1 0 with hs₀def
  set f := Work.Stems.cubeLift (m+1) h1 γ with hfdef
  set x := f s₀ with hxdef
  have hs : x = pt := by
    have hcomp := Work.Stems.cubeLift_comp (m+1) h1 γ
    have h1' : f s₀ = γ.1 0 := by
      have := congrFun (congrArg DFunLike.coe hcomp) 0
      simpa [f, s₀, ContinuousMap.comp_apply] using this
    rw [hxdef, h1', γ.2 0 (zero_mem_cube_boundary (m+1) h1)]
  -- the cube at the base point `x` with the same underlying map
  let γ' : Ω^ (Fin (m+1)) X x := ⟨γ.1, fun q hq => (γ.2 q hq).trans hs.symm⟩
  let ψ : HomotopyGroup (Fin (m+1)) X x ≃* Multiplicative ℤ :=
    (Work.StemsB.homotopyGroupCast hs m).trans φ
  let g : HomotopyGroup (Fin (m+1)) X x := ⟦γ'⟧
  have hcastg : Work.StemsB.homotopyGroupCast hs m g = g₀ := by
    show Work.StemsB.homotopyGroupCast hs m (⟦γ'⟧ : HomotopyGroup (Fin (m+1)) X x) = g₀
    rw [show g₀ = (⟦γ⟧ : HomotopyGroup (Fin (m+1)) X pt) from hγ.symm]
    exact homotopyGroupCast_mk_eq hs γ' γ rfl
  have hψg : ψ g = Multiplicative.ofAdd (1:ℤ) := by
    show φ (Work.StemsB.homotopyGroupCast hs m g) = _
    rw [hcastg]
    exact φ.apply_symm_apply _
  have hpow : ∀ y : HomotopyGroup (Fin (m+1)) X x, y = g ^ (Multiplicative.toAdd (ψ y)) := by
    intro y
    set k := Multiplicative.toAdd (ψ y) with hk
    have h1 : ψ y = (Multiplicative.ofAdd (1:ℤ)) ^ k := by
      have hz : (Multiplicative.ofAdd (1:ℤ)) ^ k = Multiplicative.ofAdd k := by
        rw [← ofAdd_zsmul, smul_eq_mul, mul_one]
      rw [hz, hk]
      exact (ofAdd_toAdd (x := ψ y)).symm
    have h2 : y = ψ.symm ((Multiplicative.ofAdd (1:ℤ)) ^ k) := by
      rw [← h1, ψ.symm_apply_apply]
    rw [h2, map_zpow, ← hψg, ψ.symm_apply_apply]
  have horder : ∀ k : ℤ, g ^ k = 1 → k = 0 := by
    intro k hk
    have h : (Multiplicative.ofAdd (1:ℤ)) ^ k = 1 := by
      rw [← hψg, ← map_zpow, hk, map_one]
    rw [← ofAdd_zsmul k (1:ℤ)] at h
    simp only [smul_eq_mul, mul_one] at h
    exact ofAdd_eq_one.mp h
  -- the value of the descent on the collapse class
  have hFc : Work.StemsB.πmap f m s₀ (⟦collapseLoop (m+1) h1⟧ :
      HomotopyGroup (Fin (m+1)) (Sph (m+1)) s₀) = g := by
    have hcomp := Work.Stems.cubeLift_comp (m+1) h1 γ
    rw [Work.StemsB.πmap_apply_mk]
    show (⟦Work.StemsB.genLoopMap f (m+1) (collapseLoop (m+1) h1)⟧ :
      HomotopyGroup (Fin (m+1)) X x) = g
    have hgen : Work.StemsB.genLoopMap f (m+1) (collapseLoop (m+1) h1) = γ' := by
      apply Subtype.ext
      apply ContinuousMap.ext
      intro t
      change f ((collapseLoop (m+1) h1) t) = γ' t
      change f ((Work.Stems.collapseMap (m+1) h1) t) = γ.1 t
      simpa [f, ContinuousMap.comp_apply] using congrFun (congrArg DFunLike.coe hcomp) t
    rw [hgen]
  -- Hurewicz injectivity for the model
  have hXinj : Function.Injective (Work.Stems.hurewiczMap (m+1) h1 x) := by
    refine hurewiczMap_injective_of_conn' (m+1) h2 x (fun i hi => ?_)
    rcases Nat.eq_zero_or_pos i with hi0 | hipos
    · subst hi0
      have hpath : PathConnectedSpace X := by
        haveI h0 : Subsingleton (HomotopyGroup (Fin 0) X pt) := hE.2 0 (by omega)
        have hZ : Subsingleton (ZerothHomotopy X) :=
          (HomotopyGroup.pi0EquivZerothHomotopy (X := X) (x := pt)).surjective.subsingleton
        exact pathConnectedSpace_iff_zerothHomotopy.mpr ⟨⟨ZerothHomotopy.mk pt⟩, hZ⟩
      haveI : PathConnectedSpace X := hpath
      haveI hZ : Subsingleton (ZerothHomotopy X) :=
        (pathConnectedSpace_iff_zerothHomotopy (X := X)).mp hpath |>.2
      exact ⟨fun u v => (HomotopyGroup.pi0EquivZerothHomotopy (X := X) (x := x)).injective
        (Subsingleton.elim _ _)⟩
    · have hi' : i ≠ m+1 := by omega
      have hsub : Subsingleton (HomotopyGroup (Fin i) X pt) := hE.2 i hi'
      have hidx : i - 1 + 1 = i := Nat.sub_add_cancel (by omega)
      haveI hsub' : Subsingleton (HomotopyGroup (Fin (i-1+1)) X pt) := by
        rw [hidx]; exact hsub
      exact hidx ▸ (Work.StemsB.homotopyGroupCast hs (i-1)).symm.surjective.subsingleton
  -- the Hurewicz class of the generator is the image of the sphere generator
  have hHg : (CategoryTheory.ConcreteCategory.hom (HomologicalComplex.homologyMap
      (Work.Cohomology.chainMap ℤ (TopCat.of (Sph (m+1))) (TopCat.of X) (TopCat.ofHom f))
      (m+1))) (Work.Stems.sphereGenerator (m+1) h1)
      = Work.Stems.hurewiczMap (m+1) h1 x g := by
    rw [← hurewiczChain_collapseLoop m, ← Work.Stems.hurewiczMap_mk]
    rw [← hFc]
    exact (Work.Stems.hurewiczMap_natural (m+1) h1 f ⟦collapseLoop (m+1) h1⟧).symm
  -- ℤ-linearity of the Hurewicz map
  have hzsmul : ∀ k : ℤ, k • Work.Stems.hurewiczMap (m+1) h1 x g
      = Work.Stems.hurewiczMap (m+1) h1 x (g ^ k) := by
    intro k
    calc k • Work.Stems.hurewiczMap (m+1) h1 x g
        = k • Work.Stems.hurewiczHom m x (Additive.ofMul g) := by
          simp [Work.Stems.hurewiczHom_apply]
      _ = Work.Stems.hurewiczHom m x (k • Additive.ofMul g) := (map_zsmul _ k _).symm
      _ = Work.Stems.hurewiczHom m x (Additive.ofMul (g ^ k)) := by rw [ofMul_zpow]
      _ = Work.Stems.hurewiczMap (m+1) h1 x (g ^ k) := by
          simp [Work.Stems.hurewiczHom_apply]
  refine ⟨hs, ?_, ?_⟩
  · intro a b hab
    apply hurewiczMap_sphere_injective (m+1) h2 s₀
    have hnat_a := Work.Stems.hurewiczMap_natural (m+1) h1 f a
    have hnat_b := Work.Stems.hurewiczMap_natural (m+1) h1 f b
    set H := CategoryTheory.ConcreteCategory.hom (HomologicalComplex.homologyMap
      (Work.Cohomology.chainMap ℤ (TopCat.of (Sph (m+1))) (TopCat.of X) (TopCat.ofHom f)) (m+1))
      with hHdef
    set e := Classical.choice (Work.Cohomology.sphereHomologyTop (m+1) h1) with hedef
    set k := ModuleCat.Hom.hom e.hom
      (Work.Stems.hurewiczMap (m+1) h1 s₀ a - Work.Stems.hurewiczMap (m+1) h1 s₀ b) with hkdef
    have hab' : HomotopyGroup.map f a = HomotopyGroup.map f b := hab
    have hstep1 : H (Work.Stems.hurewiczMap (m+1) h1 s₀ a
        - Work.Stems.hurewiczMap (m+1) h1 s₀ b) = 0 := by
      rw [map_sub, ← hnat_a, ← hnat_b, hab', sub_self]
    have hstep2 : k • Work.Stems.hurewiczMap (m+1) h1 x g = 0 := by
      have hmod := module_eq_zsmul_gen e
        (Work.Stems.hurewiczMap (m+1) h1 s₀ a - Work.Stems.hurewiczMap (m+1) h1 s₀ b)
      have hgen : ModuleCat.Hom.hom e.inv (1:ℤ) = Work.Stems.sphereGenerator (m+1) h1 := rfl
      calc k • Work.Stems.hurewiczMap (m+1) h1 x g
          = k • H (ModuleCat.Hom.hom e.inv (1:ℤ)) := by rw [hgen, hHg]
        _ = H (k • ModuleCat.Hom.hom e.inv (1:ℤ)) := (map_zsmul _ k _).symm
        _ = H (Work.Stems.hurewiczMap (m+1) h1 s₀ a
              - Work.Stems.hurewiczMap (m+1) h1 s₀ b) := by rw [← hmod]
        _ = 0 := hstep1
    have hk0 : k = 0 := by
      have hgk : Work.Stems.hurewiczMap (m+1) h1 x (g ^ k) = 0 := by
        rw [← hzsmul k]
        exact hstep2
      have hg1 : g ^ k = 1 := by
        apply hXinj
        rw [hgk, Work.Stems.hurewiczMap_one]
      exact horder k hg1
    have hzero : Work.Stems.hurewiczMap (m+1) h1 s₀ a
        - Work.Stems.hurewiczMap (m+1) h1 s₀ b = 0 := by
      have hk0' : ModuleCat.Hom.hom e.hom
          (Work.Stems.hurewiczMap (m+1) h1 s₀ a - Work.Stems.hurewiczMap (m+1) h1 s₀ b) = 0 := hk0
      rw [module_eq_zsmul_gen e
        (Work.Stems.hurewiczMap (m+1) h1 s₀ a - Work.Stems.hurewiczMap (m+1) h1 s₀ b),
        hk0', zero_smul]
    exact sub_eq_zero.mp hzero
  · intro y
    let c : HomotopyGroup (Fin (m+1)) (Sph (m+1)) s₀ := ⟦collapseLoop (m+1) h1⟧
    have hcF : Work.StemsB.πmap f m s₀ c = g := hFc
    refine ⟨c ^ (Multiplicative.toAdd (ψ y)), ?_⟩
    show Work.StemsB.πmap f m s₀ (c ^ (Multiplicative.toAdd (ψ y))) = y
    rw [map_zpow, hcF]
    exact (hpow y).symm

/-- **The key lemma, in the index shape `n`.** -/
theorem exists_bijective_piMapN' (n : ℕ) (hn : 2 ≤ n) (X : Type) [TopologicalSpace X] (pt : X)
    (hE : IsEMSpace ℤ n (by omega : 0 < n) X pt) :
    ∃ (s₀ : Sph n) (f : C(Sph n, X)),
      f s₀ = pt ∧ Function.Bijective (piMapN f n s₀) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.sub_add_cancel (by omega)).symm⟩
  exact exists_bijective_piMapN m (by omega) X pt hE

/-! ## Reindexing helpers -/

/-- Transport of a `Subsingleton` statement between equal indices. -/
theorem subsingleton_homotopyGroup_of_index_eq {X : Type} [TopologicalSpace X] {x : X} {a b : ℕ}
    (h : a = b) (hm : Subsingleton (HomotopyGroup (Fin a) X x)) :
    Subsingleton (HomotopyGroup (Fin b) X x) := by
  subst h; exact hm

/-- Transport of a torsion statement between equal indices. -/
theorem piTorsion_of_index_eq {X : Type} [TopologicalSpace X] (x : X) {a b : ℕ} (h : a = b)
    (hm : PiTorsion X x a) : PiTorsion X x b := by
  subst h; exact hm

/-- Torsion is preserved by a surjective homomorphism of groups. -/
theorem piTorsion_of_surjective_hom {G H : Type*} [Group G] [Group H] (φ : G →* H)
    (hφ : Function.Surjective φ) (h : ∀ g : G, ∃ N : ℕ, 0 < N ∧ g ^ N = 1) :
    ∀ h' : H, ∃ N : ℕ, 0 < N ∧ h' ^ N = 1 := by
  intro h'
  obtain ⟨g, rfl⟩ := hφ h'
  obtain ⟨N, hN, hg⟩ := h g
  exact ⟨N, hN, by rw [← map_pow, hg, map_one]⟩

/-- Torsion is preserved by a multiplicative equivalence. -/
theorem piTorsion_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (h : ∀ g : G, ∃ N : ℕ, 0 < N ∧ g ^ N = 1) : ∀ h' : H, ∃ N : ℕ, 0 < N ∧ h' ^ N = 1 :=
  piTorsion_of_surjective_hom e.toMonoidHom e.surjective h

/-! ## The long exact sequence of the pair `(X, Sⁿ)` -/

/-- **The projection of the homotopy fibre is surjective on `π_{k+2}`** as soon as `π_{k+1}` of the
fibre vanishes (exactness at `π_{k+2}(Sⁿ)` of the long exact sequence of the pair). -/
theorem piMap_fst_surjective_of_fibre_trivial {X : Type} [TopologicalSpace X] {n : ℕ}
    (f : C(Sph n, X)) (s₀ : Sph n) (k : ℕ)
    (hF : Subsingleton (HomotopyGroup (Fin (k+1)) (Work.RatHurewicz.fibreOf f s₀)
      (Work.RatHurewicz.fibreOfPt f s₀))) :
    Function.Surjective (Work.StemsB.πmap (Work.RatHurewicz.homotopyFibreFst f s₀) (k+1)
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) := by
  obtain ⟨d, -, h2, -⟩ := Work.StemsB.fibrationLES_of_isSerreFibration
    (Work.RatHurewicz.homotopyFibreFst f s₀) (Work.RatHurewicz.isSerreFibration_homotopyFibreFst f s₀)
    (Work.RatHurewicz.homotopyFibreBasepoint f s₀) k
  intro y
  exact (h2 y).mp (hF.elim (d y) 1)

/-- **The fibre of `E → Sⁿ` has trivial homotopy groups wherever `X` does**: its `π_{k+1}` is the
currying of `π_{k+2}(X)` (`Work.RatHurewicz.pairShiftHom_bijective`). -/
theorem fibreOf_subsingleton {X : Type} [TopologicalSpace X] {n : ℕ} (f : C(Sph n, X)) (s₀ : Sph n)
    (k : ℕ) (hX : Subsingleton (HomotopyGroup (Fin (k+2)) X (f s₀))) :
    Subsingleton (HomotopyGroup (Fin (k+1)) (Work.RatHurewicz.fibreOf f s₀)
      (Work.RatHurewicz.fibreOfPt f s₀)) := by
  haveI := hX
  exact (Work.RatHurewicz.pairShiftHom_bijective f s₀ k).surjective.subsingleton

/-- **Triviality of the homotopy groups of the fibre below `n-1`** (in the index shape `k+1`). -/
theorem fibreOf_subsingleton_of_lt {X : Type} [TopologicalSpace X] {n : ℕ} (f : C(Sph n, X))
    (s₀ : Sph n) (hX : ∀ i, i ≠ n → Subsingleton (HomotopyGroup (Fin i) X (f s₀)))
    {k : ℕ} (hk : k + 2 < n) :
    Subsingleton (HomotopyGroup (Fin (k+1)) (Work.RatHurewicz.fibreOf f s₀)
      (Work.RatHurewicz.fibreOfPt f s₀)) :=
  fibreOf_subsingleton f s₀ k (hX (k+2) (by omega))

/-- **The homotopy fibre `E` of `f : Sⁿ → X` is trivial in degrees `2 ≤ j ≤ n-2`** (the long exact
sequence of the pair, using that `Sⁿ` has no homotopy in those degrees and that the fibre of
`E → Sⁿ` is `ΩX`). -/
theorem homotopyFibre_subsingleton_mid {X : Type} [TopologicalSpace X] {n : ℕ} (f : C(Sph n, X))
    (s₀ : Sph n) (hX : ∀ i, i ≠ n → Subsingleton (HomotopyGroup (Fin i) X (f s₀)))
    {j : ℕ} (hj : 2 ≤ j) (hjn : j + 1 < n) :
    Subsingleton (HomotopyGroup (Fin j) (Work.RatHurewicz.homotopyFibre f s₀)
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) := by
  -- the fibre of the projection is trivial in the index of the long exact sequence
  have hkeq : (j-2) + 1 + 2 = j + 1 := by omega
  have hk : (j-2) + 1 + 2 < n := hkeq ▸ hjn
  have hF : Subsingleton (HomotopyGroup (Fin ((j-2)+1+1)) (Work.RatHurewicz.fibreOf f s₀)
      (Work.RatHurewicz.fibreOfPt f s₀)) :=
    fibreOf_subsingleton f s₀ ((j-2)+1) (hX ((j-2)+1+2) (by rw [hkeq]; exact ne_of_lt hjn))
  have hidx : (j-2) + 1 + 1 = j := by omega
  have hE := Work.StemsB.les_exact_E (Work.RatHurewicz.homotopyFibreFst f s₀)
    (Work.RatHurewicz.homotopyFibreBasepoint f s₀) (Work.RatHurewicz.fibreHrel f s₀) (j-2)
  have hB : Subsingleton (HomotopyGroup (Fin ((j-2)+1+1)) (Sph n)
      ((Work.RatHurewicz.homotopyFibreFst f s₀)
        (Work.RatHurewicz.homotopyFibreBasepoint f s₀))) :=
    subsingleton_homotopyGroup_of_index_eq hidx.symm
      (Work.Stems.sphereConnectivity n j (by omega) s₀)
  have hsub : Subsingleton (HomotopyGroup (Fin ((j-2)+1+1)) (Work.RatHurewicz.homotopyFibre f s₀)
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) :=
    ⟨fun y z => by
      have hy : y ∈ Set.range (Work.StemsB.πmap
        (Work.StemsB.fibreIncl (Work.RatHurewicz.homotopyFibreFst f s₀)
          ((Work.RatHurewicz.homotopyFibreFst f s₀)
            (Work.RatHurewicz.homotopyFibreBasepoint f s₀)))
        ((j-2)+1) (Work.StemsB.fibrePoint (Work.RatHurewicz.homotopyFibreFst f s₀)
          (Work.RatHurewicz.homotopyFibreBasepoint f s₀))) :=
        (hE y).mp (hB.elim _ 1)
      have hz := (hE z).mp (hB.elim _ 1)
      obtain ⟨a, ha⟩ := hy
      obtain ⟨b, hb⟩ := hz
      rw [← ha, ← hb]
      exact congrArg _ (hF.elim a b)⟩
  rwa [hidx] at hsub


/-! ## The homotopy fibre of a map to a `K(ℤ,n)` is `(n-1)`-connected -/

/-- The unit sphere `Sⁿ`, `n ≥ 1`, is path connected. -/
theorem pathConnectedSpace_sph (n : ℕ) (hn : 1 ≤ n) : PathConnectedSpace (Sph n) :=
  Work.StemsB.pathConnectedSpace_of_subsingleton_pi0 (Work.Stems.sphBase n hn)
    (Work.Stems.sphereConnectivity n 0 hn (Work.Stems.sphBase n hn))

/-- **Transport of torsion of `π_{n+1}` along a path joining two base points.** -/
theorem piTorsion_of_joined {X : Type} [TopologicalSpace X] {x y : X} (n : ℕ) (h : Joined x y)
    (ht : PiTorsion X x n) : PiTorsion X y n := by
  obtain ⟨γ⟩ := h
  obtain ⟨e⟩ := Work.StemsB.basepoint_transport n γ
  exact piTorsion_of_mulEquiv e ht

/-- **`π₀` of the fibre `ΩX` of the homotopy-fibre projection vanishes when `π₁(X) = 1`.**  The
fibre is homeomorphic to the loop space `ΩX` through `fibrePsi`, and a loop space whose fundamental
group is trivial is path connected. -/
theorem subsingleton_pi0_fibreOf {X : Type} [TopologicalSpace X] {A : Type} [TopologicalSpace A]
    (f : C(A, X)) (a₀ : A) (h : Subsingleton (HomotopyGroup (Fin 1) X (f a₀))) :
    Subsingleton (HomotopyGroup (Fin 0) (Work.RatHurewicz.fibreOf f a₀)
      (Work.RatHurewicz.fibreOfPt f a₀)) := by
  haveI hpc : PathConnectedSpace (Path (f a₀) (f a₀)) :=
    Work.StemsB.pathConnectedSpace_of_subsingleton_pi0 (Path.refl (f a₀))
      (subsingleton_pi0_loopSpace_of_pi1 (f a₀) h)
  have hsurj : Function.Surjective (Work.RatHurewicz.fibrePsi f a₀) :=
    fun e => ⟨Work.RatHurewicz.fibrePhi f a₀ e,
      Work.RatHurewicz.fibrePsi_fibrePhi f a₀ e⟩
  haveI hpcF : PathConnectedSpace (Work.RatHurewicz.fibreOf f a₀) :=
    ⟨⟨Work.RatHurewicz.fibreOfPt f a₀⟩, fun y z => by
      obtain ⟨y', rfl⟩ := hsurj y
      obtain ⟨z', rfl⟩ := hsurj z
      exact (hpc.joined y' z').map (Work.RatHurewicz.fibrePsi f a₀).continuous⟩
  have hZ : Subsingleton (ZerothHomotopy (Work.RatHurewicz.fibreOf f a₀)) :=
    (pathConnectedSpace_iff_zerothHomotopy (X := Work.RatHurewicz.fibreOf f a₀)).mp hpcF |>.2
  exact ⟨fun a b => (HomotopyGroup.pi0EquivZerothHomotopy
    (X := Work.RatHurewicz.fibreOf f a₀) (x := Work.RatHurewicz.fibreOfPt f a₀)).injective
    (hZ.elim _ _)⟩

/-- **The homotopy fibre `E` of `f : Sⁿ → X` is trivial in degrees below `n-1`**, i.e. below the
range of the rational Hurewicz theorem for the `(n-2)`-connected cover: `π_j(E) = 0` for
`j + 1 < n`.  (`E` is `(n-1)`-connected; only `π_j` for `j ≤ n-2` are needed by `SerreS1`.)

* `j = 0`: path lifting along the fibration `E → Sⁿ` (`Work.Serre.subsingleton_pi0_homotopyFibre`),
  using that `Sⁿ` is path connected and that the fibre of `E → Sⁿ` is `ΩX`, which is path connected
  because `π₁(X) = 1` (`Work.Serre.subsingleton_pi0_fibreOf`).
* `j = 1`: `π₁(F) → π₁(E)` is onto (`Work.Serre.fibrationPiOne_surjective`, loop lifting along the
  Serre fibration) and `π₁(F) = π₂(X) = 0`.
* `j ≥ 2`: the long exact sequence of the fibration `E → Sⁿ` (`Work.Serre.homotopyFibre_subsingleton_mid`). -/
theorem homotopyFibre_subsingleton_of_lt {X : Type} [TopologicalSpace X] {n : ℕ}
    (f : C(Sph n, X)) (s₀ : Sph n) (hn : 3 ≤ n)
    (hX : ∀ i, i ≠ n → Subsingleton (HomotopyGroup (Fin i) X (f s₀)))
    {j : ℕ} (hj : j + 1 < n) :
    Subsingleton (HomotopyGroup (Fin j) (Work.RatHurewicz.homotopyFibre f s₀)
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) := by
  rcases j with _ | _ | j
  · exact subsingleton_pi0_homotopyFibre f s₀
      (fun a => (pathConnectedSpace_sph n (by omega)).joined s₀ a)
      (subsingleton_pi0_fibreOf f s₀ (hX 1 (by omega)))
  · haveI hF1 : Subsingleton (HomotopyGroup (Fin (0 + 1))
        (Work.StemsB.fibre (Work.RatHurewicz.homotopyFibreFst f s₀)
          ((Work.RatHurewicz.homotopyFibreFst f s₀)
            (Work.RatHurewicz.homotopyFibreBasepoint f s₀)))
        (Work.StemsB.fibrePoint (Work.RatHurewicz.homotopyFibreFst f s₀)
          (Work.RatHurewicz.homotopyFibreBasepoint f s₀))) := by
      haveI : Subsingleton (HomotopyGroup (Fin (0 + 2)) X (f s₀)) := hX 2 (by omega)
      exact (Work.RatHurewicz.pairShiftHom_bijective f s₀ 0).surjective.subsingleton
    haveI hB1 : Subsingleton (HomotopyGroup (Fin 1) (Sph n)
        ((Work.RatHurewicz.homotopyFibreFst f s₀)
          (Work.RatHurewicz.homotopyFibreBasepoint f s₀))) :=
      Work.Stems.sphereConnectivity n 1 (by omega) s₀
    exact (fibrationPiOne_surjective (Work.RatHurewicz.homotopyFibreFst f s₀)
      (Work.RatHurewicz.isSerreFibration_homotopyFibreFst f s₀)
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀) hB1).subsingleton
  · exact homotopyFibre_subsingleton_mid f s₀ hX (j := j + 2) (by omega) (by omega)

/-! ## The odd case of Serre's theorem: the `(n-1)`-connected cover -/

/-- **The odd case.**  For odd `n` and `i + 5 ≤ n`, the group `π_{n+i+1}(Sⁿ)` is torsion.

Take a model `X` of `K(ℤ,n)` (`SerreC0`) and a map `f : Sⁿ → X` which is a bijection on `π_n`
(`Work.Serre.exists_bijective_piMapN'`).  Its homotopy fibre `E` is the `(n-1)`-connected cover of
`Sⁿ`; it is rationally acyclic by `SerreC2odd` (odd `n`), and `(n-2)`-connected by
`Work.Serre.homotopyFibre_subsingleton_of_lt`.  `SerreS1` with `k = n-1`, `M = 2n-4` therefore gives
that `π_{n+i+1}(E)` is torsion (in the range `n-1 ≤ j ≤ 2n-4`), and the long exact sequence of the
fibration `E → Sⁿ → X` — the connecting map `π_{n+i+2}(Sⁿ) → π_{n+i+1}(ΩX) = π_{n+i+2}(X)`
vanishes because `π_j(X) = 0` for `j ≠ n` — makes `π_{n+i+1}(E) → π_{n+i+1}(Sⁿ)` surjective. -/
theorem coverRoute (hC0 : SerreC0) (hC2 : SerreC2odd) (hS1 : SerreS1)
    (n : ℕ) (hn : 3 ≤ n) (hnodd : Odd n) (i : ℕ) (hi : i + 5 ≤ n) (x₀ : Sph n) :
    PiTorsion (Sph n) x₀ (n + i) := by
  obtain ⟨X, hXtop, pt, hE⟩ := hC0 (A := ℤ) n (by omega)
  letI : TopologicalSpace X := hXtop
  have hE' : IsEMSpace ℤ n (by omega : 0 < n) X pt := hE
  obtain ⟨s₀, f, hfs₀, hbij⟩ := exists_bijective_piMapN' n (by omega) X pt hE'
  have hratio : RatAcyclic (Work.RatHurewicz.homotopyFibre f s₀) :=
    hC2 n (by omega) hnodd X pt hE' s₀ f hbij
  set E := Work.RatHurewicz.homotopyFibre f s₀
  set e₀ := Work.RatHurewicz.homotopyFibreBasepoint f s₀
  have hX' : ∀ j, j ≠ n → Subsingleton (HomotopyGroup (Fin j) X (f s₀)) :=
    fun j hj => hfs₀ ▸ hE'.2 j hj
  -- `E` is `(n-1)`-connected, so `SerreS1` applies with `k = n - 1` and `M = 2 * (n - 1) - 2`
  have hconn : ∀ j < n - 1, Subsingleton (HomotopyGroup (Fin j) E e₀) :=
    fun j hj => homotopyFibre_subsingleton_of_lt f s₀ hn hX' (j := j) (by omega)
  have hvan : ∀ m : ℕ, n - 1 ≤ m + 1 → IsZero (ratH (TopCat.of E) (m + 1)) :=
    fun m hm => hratio.isZero_ratH (by omega)
  have hEtors : PiTorsion E e₀ (n + i - 1 + 1) := by
    have h1 : n - 1 ≤ n + i - 1 + 1 + 1 := by omega
    have h2 : n + i - 1 + 1 + 1 ≤ 2 * (n - 1) - 2 := by omega
    exact hS1 (n - 1) (by omega) E e₀ hconn (2 * (n - 1) - 2) (by omega)
      (fun m h1' h2' => hvan m h1') (n + i - 1 + 1) h1 h2
  -- the projection `E → Sⁿ` is onto in `π_{n+i+1}`
  have hF : Subsingleton (HomotopyGroup (Fin (n + i - 1 + 1)) (Work.RatHurewicz.fibreOf f s₀)
      (Work.RatHurewicz.fibreOfPt f s₀)) :=
    fibreOf_subsingleton f s₀ (n + i - 1)
      (subsingleton_homotopyGroup_of_index_eq (a := n + i + 1) (b := (n + i - 1) + 2)
        (by omega) (hX' (n + i + 1) (by omega)))
  have hsurj := piMap_fst_surjective_of_fibre_trivial f s₀ (n + i - 1) hF
  have htor : PiTorsion (Sph n) (Work.RatHurewicz.homotopyFibreFst f s₀
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) (n + i - 1 + 1) :=
    piTorsion_of_surjective_hom (Work.StemsB.πmap (Work.RatHurewicz.homotopyFibreFst f s₀)
      (n + i - 1 + 1) (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) hsurj hEtors
  -- reindex and change the base point
  have htor' : PiTorsion (Sph n) (Work.RatHurewicz.homotopyFibreFst f s₀
      (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) (n + i) :=
    piTorsion_of_index_eq _ (by omega : n + i - 1 + 1 = n + i) htor
  exact piTorsion_of_joined (n + i)
    ((pathConnectedSpace_sph n (by omega)).joined s₀ x₀) htor'

/-! ## The assembly of `S2` -/

/-- An even number has odd successor. -/
theorem odd_succ_of_even {n : ℕ} (h : Even n) : Odd (n + 1) := by
  obtain ⟨k, hk⟩ := h
  exact ⟨k, by omega⟩

/-- **Serre's theorem on the stable stems, assembled from the four chapter contracts.**

The odd case is `Work.Serre.coverRoute`.  Every other case is obtained from it by Freudenthal's
suspension theorem `SerreFreudenthal`: for even `n` we suspend into `S^{n+1}` (odd), and for
`n = i+3` or `n = i+4` (the two values of `n ≥ i+3` not covered by the odd case) one or two
suspensions land in the range `i + 5 ≤ n` where the odd case applies. -/
theorem serreS2OfC0C2oddS1 : Work.Serre.SerreS2OfC0C2oddS1 := by
  intro hC0 hC2 hS1 hF i hi n hn x₀ α
  -- the range covered by the odd case, and one suspension step away from it (even `m`)
  have far : ∀ m : ℕ, i + 5 ≤ m → ∀ x₀ : Sph m, PiTorsion (Sph m) x₀ (m + i) := by
    intro m hm5 x₀
    rcases Nat.even_or_odd m with he | ho
    · refine hF m i (by omega) (by omega) (fun y₀ => ?_) x₀
      exact coverRoute hC0 hC2 hS1 (m + 1) (by omega) (odd_succ_of_even he) i (by omega) y₀
    · exact coverRoute hC0 hC2 hS1 m (by omega) ho i hm5 x₀
  have hmain : PiTorsion (Sph n) x₀ (n + i) := by
    by_cases h5 : i + 5 ≤ n
    · exact far n h5 x₀
    · by_cases h4 : i + 4 ≤ n
      · -- `n = i + 4`: one suspension lands in the range `i + 5 ≤ n + 1`
        exact hF n i (by omega) (by omega) (fun y₀ => far (n + 1) (by omega) y₀) x₀
      · -- `n = i + 3`: two suspensions land in the range `i + 5 ≤ n + 2`
        exact hF n i (by omega) (by omega) (fun y₀ =>
          hF (n + 1) i (by omega) (by omega) (fun z₀ => far (n + 2) (by omega) z₀) y₀) x₀
  exact hmain α

end
