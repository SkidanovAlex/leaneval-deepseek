/-!
# The top Chern class of the model quotient bundle is a multiple of `ζ^n`

Over `P(ε^{n+1}) = ℂP^n` the quotient bundle `Q = π^*(ε^{n+1})/ℓ` of the trivial bundle by the
tautological line is the (dual) tautological quotient bundle; its top Chern class lands in
`H^{2n}(ℂP^n;ℤ)`, which is free of rank one generated by `ζ^n`
(`Work.Kunneth.keyLH`: the powers of `ζ` generate the cohomology of `P(ε^{n+1})`).

This module records only that consequence: `c_n(Q)` is *some* integer multiple of `ζ^n`.  The
value of the integer is not needed by the consumers of the Leray–Hirsch chapter.
-/

namespace Work.LerayHirsch

/-- **The top Chern class of the model quotient bundle is an integer multiple of `ζⁿ`.**
`ζⁿ` generates `H^{2n}(P(ε^{n+1});ℤ)` (`Work.Kunneth.keyLH`), so every class in that degree — in
particular `c_n` of the quotient bundle `quotientBundle (trivCore (n+1))` — is an integer multiple
of it. -/
theorem modelQuotientTopChern (n : ℕ) :
    ∃ k : ℤ, Work.Thom.chernClass n n
        (Work.LerayHirsch.quotientBundle (Work.LerayHirsch.trivCore (n + 1)))
      = k • Work.LerayHirsch.zetaPow (Work.LerayHirsch.trivCore (n + 1)) n :=
  (Work.Gen.ChernGen.span_singleton_eq_top_iff'
      (Work.LerayHirsch.zetaPow (Work.LerayHirsch.trivCore (n + 1)) n)).mp
    (Work.Kunneth.keyLH n n le_rfl)
    (Work.Thom.chernClass n n
      (Work.LerayHirsch.quotientBundle (Work.LerayHirsch.trivCore (n + 1))))

end Work.LerayHirsch
