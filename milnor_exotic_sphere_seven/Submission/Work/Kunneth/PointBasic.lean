/-!
# The cohomology of the point and of `ℂPⁿ`: elementary transfers

This module collects the elementary facts about singular cohomology that
`Work.Kunneth.lerayHirschFull_point` needs: the cohomology of the point (vanishing in positive
degrees, `H⁰` generated by the unit), the vanishing of the cohomology of `ℂPⁿ` off the even degrees
`≤ 2n` (from `Work.Projective.cpn_cohomology`), the transfer of `Subsingleton` along the
homeomorphisms `ℂPⁿ ≃ₜ P(ε^{n+1})`, and the two bridges between the degree transport
`Work.Thom.cohTransport` and `Eq.rec` (`▸`) that make the unit laws of the graded cup product
usable.
-/

open scoped LinearAlgebra.Projectivization

open CategoryTheory

namespace Work.Kunneth

noncomputable section

/-! ## 1. `▸` versus `Work.Thom.cohTransport` -/

/-- **`Eq.rec` (`▸`) and `Work.Thom.cohTransport` agree**: both are the canonical identification of
the cohomology in two equal degrees. -/
theorem eqRec_eq_cohTransport {B : Type} [TopologicalSpace B] {p q : ℕ} (h : p = q)
    (x : Work.Thom.Coh ℤ p B) :
    (h ▸ x : ↑(Work.Thom.Coh ℤ q B)) = Work.Thom.cohTransport h x := by
  cases h
  rw [Work.Thom.cohTransport_rfl]

/-- **The left unit law of the graded cup product**, in the transport form of
`Work.Thom.cohTransport` (`Work.Cohomology.cupH'_one_left` is stated with `Eq.rec`). -/
theorem cupH'_one_left' {B : Type} [TopologicalSpace B] (n : ℕ) (x : Work.Thom.Coh ℤ n B) :
    Work.Cohomology.cupH' ℤ (Work.Whitney.ssB B) 0 n
        (Work.Cohomology.oneH ℤ (Work.Whitney.ssB B)) x
      = Work.Thom.cohTransport (Nat.zero_add n).symm x := by
  rw [Work.Cohomology.cupH'_one_left, eqRec_eq_cohTransport]

/-! ## 2. Isomorphisms of `ModuleCat ℤ` as linear equivalences -/

/-- An isomorphism of `ModuleCat ℤ` is injective on the underlying modules. -/
theorem injective_of_iso {M N : ModuleCat ℤ} (e : M ≅ N) : Function.Injective e.hom.hom := by
  intro x y hxy
  have h2 : ModuleCat.Hom.hom (e.hom ≫ e.inv) = LinearMap.id := by
    rw [e.hom_inv_id, ModuleCat.hom_id]
  have hx := LinearMap.congr_fun h2 x
  have hy := LinearMap.congr_fun h2 y
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply, LinearMap.id_apply] at hx hy
  rw [← hx, hxy, hy]

/-- An isomorphism of `ModuleCat ℤ` is surjective on the underlying modules. -/
theorem surjective_of_iso {M N : ModuleCat ℤ} (e : M ≅ N) : Function.Surjective e.hom.hom := by
  intro y
  refine ⟨e.inv.hom y, ?_⟩
  have h2 : ModuleCat.Hom.hom (e.inv ≫ e.hom) = LinearMap.id := by
    rw [e.inv_hom_id, ModuleCat.hom_id]
  have h := LinearMap.congr_fun h2 y
  simpa [ModuleCat.hom_comp, LinearMap.comp_apply] using h

/-- `Subsingleton` transfers backwards across an isomorphism of `ModuleCat ℤ`. -/
theorem subsingleton_of_iso {M N : ModuleCat ℤ} (e : M ≅ N) (h : Subsingleton ↑N) :
    Subsingleton ↑M := by
  haveI := h
  exact ⟨fun x y => injective_of_iso e (Subsingleton.elim (e.hom.hom x) (e.hom.hom y))⟩

/-! ## 3. The cohomology of the point -/

/-- **`H⁰(pt;ℤ)` is generated by the unit class**. -/
theorem exists_smul_oneH_point (x : Work.Thom.Coh ℤ 0 PUnit) :
    ∃ a : ℤ, x = a • Work.Cohomology.oneH ℤ (Work.Whitney.ssB PUnit) :=
  Work.Cohomology.exists_smul_oneH (TopCat.of PUnit) x

/-- In the awkward degree `d` with `0 = d`, every class of `H^d(pt;ℤ)` is an integer multiple of
the transported unit class. -/
theorem exists_smul_cohTransport_oneH {d : ℕ} (h : 0 = d) (x : Work.Thom.Coh ℤ d PUnit) :
    ∃ a : ℤ,
      x = a • Work.Thom.cohTransport h (Work.Cohomology.oneH ℤ (Work.Whitney.ssB PUnit)) := by
  obtain ⟨a, ha⟩ := exists_smul_oneH_point (Work.Thom.cohTransport h.symm x)
  refine ⟨a, ?_⟩
  rw [← Work.LerayHirsch.cohTransport_apply_symm h x, ha, Work.Thom.cohTransport_zsmul]

/-- **The positive-degree cohomology of the point vanishes.** -/
theorem subsingleton_coh_point_of_pos {d : ℕ} (hd : 0 < d) :
    Subsingleton (Work.Thom.Coh ℤ d PUnit) := by
  have h : d = (d - 1) + 1 := by omega
  haveI : Subsingleton (Work.Thom.Coh ℤ ((d - 1) + 1) PUnit) :=
    ModuleCat.subsingleton_of_isZero (Work.Cohomology.punit ℤ (d - 1))
  refine ⟨fun x y => Work.LerayHirsch.cohTransport_injective h ?_⟩
  exact Subsingleton.elim (Work.Thom.cohTransport h x) (Work.Thom.cohTransport h y)

/-- A function out of an empty index type is a subsingleton. -/
theorem subsingleton_pi_of_isEmpty {ι : Type} [IsEmpty ι] {β : ι → Type} :
    Subsingleton ((i : ι) → β i) :=
  ⟨fun f g => funext fun i => isEmptyElim i⟩

/-- Products of subsingletons are subsingletons. -/
theorem subsingleton_pi {ι : Type} {β : ι → Type} [∀ i, Subsingleton (β i)] :
    Subsingleton ((i : ι) → β i) :=
  ⟨fun f g => funext fun i => Subsingleton.elim (f i) (g i)⟩

/-! ## 3b. The top index of the Leray--Hirsch family for `P(ε^{n+1})` -/

/-- **The index of the top power `ζ^k`** in the Leray–Hirsch family of `P(ε^{n+1})`, for
`k ≤ n`: the index `i = k`. -/
def iTop (n k : ℕ) (hk : k ≤ n) : {i : Fin (n + 1) // (i : ℕ) ≤ k} :=
  ⟨⟨k, Nat.lt_succ_of_le hk⟩, le_rfl⟩

/-- The value of the top index is `k`. -/
@[simp] theorem iTop_val (n k : ℕ) (hk : k ≤ n) : ((iTop n k hk : _) : ℕ) = k := rfl

/-- The degree identity of the top component. -/
theorem oneHtop_deg (n k : ℕ) (hk : k ≤ n) :
    0 = 2 * (k - ((iTop n k hk : _) : ℕ)) := by
  simp only [iTop_val]; omega

/-- **The unit class in the degree of the top component**: the transported unit of `H⁰(pt;ℤ)`. -/
abbrev oneHtop (n k : ℕ) (hk : k ≤ n) :
    Work.Thom.Coh ℤ (2 * (k - ((iTop n k hk : _) : ℕ))) PUnit :=
  Work.Thom.cohTransport (oneHtop_deg n k hk)
    (Work.Cohomology.oneH ℤ (Work.Whitney.ssB PUnit))

/-- **Every class in the degree of the top component is an integer multiple of `oneHtop`.** -/
theorem exists_smul_oneHtop (n k : ℕ) (hk : k ≤ n)
    (x : Work.Thom.Coh ℤ (2 * (k - ((iTop n k hk : _) : ℕ))) PUnit) :
    ∃ a : ℤ, x = a • oneHtop n k hk :=
  exists_smul_cohTransport_oneH (by simp only [iTop_val]; omega) x

/-! ## 4. The projectivisation of the zero bundle is empty -/

/-- **`P(ε⁰)` is empty**: the model fibre `ℂ⁰` is trivial, so the punctured total space of
`ε⁰` is empty. -/
theorem isEmpty_zeroComplement_trivCore_zero :
    IsEmpty ↥(Work.Thom.zeroComplement (Work.Thom.realification (Work.LerayHirsch.trivCore 0))) := by
  refine ⟨fun p => ?_⟩
  have h : (show EuclideanSpace ℂ (Fin 0) from p.1.2) = 0 := Subsingleton.elim _ _
  exact p.2 h

/-- **`P(ε⁰)` is empty.** -/
instance isEmpty_projSpace_trivCore_zero :
    IsEmpty (Work.LerayHirsch.ProjSpace (Work.LerayHirsch.trivCore 0)) := by
  haveI := isEmpty_zeroComplement_trivCore_zero
  exact ⟨fun x => Quotient.inductionOn x (fun p => isEmptyElim p)⟩

/-- The cohomology of `P(ε⁰)` vanishes in every degree. -/
theorem subsingleton_coh_trivCore_zero (d : ℕ) :
    Subsingleton (Work.Thom.Coh ℤ d (Work.LerayHirsch.ProjSpace (Work.LerayHirsch.trivCore 0))) :=
  Work.LerayHirsch.subsingleton_cohomology_of_isEmpty d

/-! ## 5. The cohomology of `ℂPⁿ` off the even degrees `≤ 2n` -/

/-- **The vanishing of `H^d(ℂPⁿ;ℤ)` off the even degrees `≤ 2n`**, from the computation of the
cohomology of `ℂPⁿ` (`Work.Projective.cpn_cohomology`). -/
theorem subsingleton_coh_cp_of_not {n d : ℕ} (h : ¬(Even d ∧ d ≤ 2 * n)) :
    Subsingleton (Work.Thom.Coh ℤ d (Work.Projective.CP n)) := by
  obtain ⟨e⟩ := Work.Projective.cpn_cohomology n d
  have hsub : Subsingleton (↑(Work.Projective.cpnModel n d)) :=
    ModuleCat.subsingleton_of_isZero (Work.Projective.isZero_cpnModel h)
  exact subsingleton_of_iso e hsub

/-- The transfer of the vanishing of `H^d(ℂPⁿ;ℤ)` to `P(ε^{n+1})`, which is homeomorphic to
`ℂPⁿ` (`Work.LerayHirsch.projUnivHomeo` and `Work.Kunneth.wkHomeo`). -/
theorem subsingleton_coh_projSpace_trivCore_of_not {n d : ℕ}
    (h : ¬(Even d ∧ d ≤ 2 * n)) :
    Subsingleton (Work.Thom.Coh ℤ d
      (Work.LerayHirsch.ProjSpace (Work.LerayHirsch.trivCore (n + 1)))) := by
  haveI : Subsingleton (Work.Thom.Coh ℤ d (Work.Projective.CP n)) :=
    subsingleton_coh_cp_of_not h
  have h₁ := (Work.LerayHirsch.bijective_CohMap_of_homeomorph (wkHomeo n).symm d).1
  have h₂ := (Work.LerayHirsch.bijective_CohMap_of_homeomorph
    (Work.LerayHirsch.projUnivHomeo (n + 1)) d).1
  refine ⟨fun x y => ?_⟩
  exact Function.Injective.comp h₁ h₂ (Subsingleton.elim _ _)

end

end Work.Kunneth
