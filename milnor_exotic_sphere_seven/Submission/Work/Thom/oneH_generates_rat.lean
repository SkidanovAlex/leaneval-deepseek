/-!
# `H⁰(X;ℚ)` of a path-connected space is generated by the unit class

For a path-connected space `X`, every degree-zero rational cohomology class is a rational multiple
of the unit class `oneH ℚ`: the map `ℚ → H⁰(X;ℚ)`, `c ↦ c • oneH`, is surjective.

The proof is the degree-zero case of the computation of `H⁰` as the module of locally constant
functions:

* every class `x` is the class of a `0`-cocycle `α` (`Work.Cohomology.exists_cohomologyClassOf`);
* a `0`-cocycle of a path-connected space is *constant* on the `0`-simplices — it takes the same
  value on all `0`-simplices (`Work.Cohomology.eval_constancy`), because any two vertices are
  joined by an edge — so `α = c • unitCochain` for `c` the value at the base simplex, by
  `Work.Cohomology.genEval_ext`;
* the class map `cohomologyClassOf` is `ℚ`-linear in the cochain (`cocycleOf_smul`), so the class
  of `c • unitCochain` is `c • oneH`.
-/

namespace Work.Thom

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

noncomputable section

set_option backward.isDefEq.respectTransparency false

/-- **`H⁰(X;ℚ)` of a path-connected space is generated by the unit class.** -/
theorem oneH_generates_rat {X : Type} [TopologicalSpace X] [PathConnectedSpace X]
    (x : Work.Thom.Coh ℚ 0 X) :
    ∃ c : ℚ, x = c • Work.Cohomology.oneH ℚ (TopCat.toSSet.obj (TopCat.of X)) := by
  let X' : TopCat := TopCat.of X
  let Y : SSet := TopCat.toSSet.obj X'
  obtain ⟨α, hα, hxα⟩ := Work.Cohomology.exists_cohomologyClassOf ℚ Y 0 x
  -- a `0`-cocycle of a path-connected space is constant on the `0`-simplices
  have hf : α.comp ((Work.Cohomology.singularChains ℚ X').d 1 0).hom = 0 := hα
  have hconst : ∀ s : Y _⦋0⦌, Work.Cohomology.genEval ℚ Y α s
      = Work.Cohomology.genEval ℚ Y α (Work.Cohomology.baseSimplex X') :=
    fun s => Work.Cohomology.eval_constancy ℚ X' α hf s
  let c : ℚ := Work.Cohomology.genEval ℚ Y α (Work.Cohomology.baseSimplex X')
  have hαc : α = c • Work.Cohomology.unitCochain ℚ Y := by
    apply Work.Cohomology.genEval_ext
    intro σ
    rw [Work.Cohomology.genEval_smul, Work.Cohomology.genEval_unitCochain, smul_eq_mul, mul_one]
    exact hconst σ
  have h' : Work.Cohomology.cochainDiff ℚ Y (c • Work.Cohomology.unitCochain ℚ Y) = 0 :=
    hαc ▸ hα
  have h2 : Work.Cohomology.cohomologyClassOf ℚ Y α hα
      = Work.Cohomology.cohomologyClassOf ℚ Y (c • Work.Cohomology.unitCochain ℚ Y) h' :=
    Work.Cohomology.cohomologyClassOf_congr (R := ℚ) (X := Y) hαc hα h'
  have h3 : Work.Cohomology.cohomologyClassOf ℚ Y (c • Work.Cohomology.unitCochain ℚ Y) h'
      = c • Work.Cohomology.oneH ℚ Y := by
    rw [Work.Cohomology.oneH]
    rw [Work.Cohomology.cohomologyClassOf, Work.Cohomology.cohomologyClassOf,
      Work.Cohomology.cocycleOf_smul, map_smul]
  exact ⟨c, hxα.symm.trans (h2.trans h3)⟩

end

end Work.Thom
