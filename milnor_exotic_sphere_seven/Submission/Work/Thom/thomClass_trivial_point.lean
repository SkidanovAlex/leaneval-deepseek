/-!
# The trivial bundle of rank `n` over a point has a Thom class

The base case of the Thom isomorphism theorem (`Work.Thom.ThomClassExists`): for the trivial real
bundle `Z = ℝⁿ × pt` of rank `n ≥ 1` over a point,

  `Work.Thom.thomClass_trivial_point` — there is a **Thom class** `τ ∈ H^n(E,E∖0;ℤ)`.

The two inputs are

* the computation of the cohomology of the Thom pair of the trivial bundle over a point,
  `Work.Thom.openThom_trivial_point_iso`: `H^k(E,E∖0;ℤ)` is `ℤ` for `k = n` and `0` otherwise.
  The total space of the trivial bundle over a point is the fibre — the local trivialisation at the
  base point is a homeomorphism onto `pt × ℝⁿ` (`Work.Thom.trivHomeo`) — and a homeomorphism of
  pairs induces an isomorphism of relative cohomology (`Work.Thom.relCohIsoOfIso`), which transports
  the computation `Work.Thom.relCohomology_euclidean_punctured` of `H^k(ℝⁿ,ℝⁿ∖0;ℤ)`;
* the unit law `Work.Thom.mixedCupC_oneH_zero` (`1 ⌣ y = y` in the module structure of the relative
  cohomology over `H⁰`), plus `Work.Thom.CohMap_oneH` (the pullback of the unit class is the unit
  class) and the fact that `H⁰` of a point is generated by the unit class
  (`Work.Cohomology.exists_smul_oneH`), which together show that the degree-`0` Thom map sends a
  generator of `H⁰(pt;ℤ) = ℤ` to a generator of `H^n(E,E∖0;ℤ) = ℤ`
  (`Work.Thom.bijective_thomMap_zero`); in positive degrees both sides vanish, so the Thom map is
  bijective there too (`Work.Thom.bijective_thomMap_of_pos`).
-/

noncomputable section
open CategoryTheory Bundle

namespace Work.Thom
open Work.TangentClasses

/-! ## Functoriality of the map of pairs on relative cochains

These are local copies of the functoriality lemmas of `Submission/Work/Cohomology/cappedPairDefs.lean`
(kept private here so that this file imports only the light module
`Submission/Work/Cohomology/exists_relComplexMap`). -/

private theorem relComplexMap_comp_l (R : Type) [CommRing R] {X₀ X₁ X₂ : TopCat} (A₀ : Set X₀)
    (A₁ : Set X₁) (A₂ : Set X₂) (f : X₀ ⟶ X₁) (g : X₁ ⟶ X₂) (hf : ∀ x ∈ A₀, f x ∈ A₁)
    (hg : ∀ y ∈ A₁, g y ∈ A₂) :
    Work.Cohomology.relComplexMap R A₀ A₂ (f ≫ g) (fun x hx => hg (f x) (hf x hx))
      = Work.Cohomology.relComplexMap R A₁ A₂ g hg ≫
        Work.Cohomology.relComplexMap R A₀ A₁ f hf := by
  apply HomologicalComplex.hom_ext
  intro n
  rw [HomologicalComplex.comp_f, Work.Cohomology.relComplexMap_f, Work.Cohomology.relComplexMap_f,
    Work.Cohomology.relComplexMap_f]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  simp only [ModuleCat.hom_ofHom, ModuleCat.hom_comp, LinearMap.comp_apply,
    Work.Cohomology.relMapLM_coe, Work.Cohomology.dualChainMap_comp, HomologicalComplex.comp_f]
  rfl

private theorem relComplexMap_id_l (R : Type) [CommRing R] {X : TopCat} (A : Set X)
    (h : ∀ x ∈ A, (𝟙 X : X ⟶ X) x ∈ A) :
    Work.Cohomology.relComplexMap R A A (𝟙 X) h = 𝟙 (Work.Cohomology.relComplex R X A) := by
  apply HomologicalComplex.hom_ext
  intro n
  rw [Work.Cohomology.relComplexMap_f]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  simp only [ModuleCat.hom_ofHom, Work.Cohomology.relMapLM_coe, Work.Cohomology.dualChainMap_id,
    HomologicalComplex.id_f, ModuleCat.hom_id, LinearMap.id_apply]
  rfl

private theorem relComplexMap_congr_l (R : Type) [CommRing R] {X₁ X₂ : TopCat} (A₁ : Set X₁)
    (A₂ : Set X₂) {f f' : X₁ ⟶ X₂} (hf : f = f') (h : ∀ x ∈ A₁, f x ∈ A₂)
    (h' : ∀ x ∈ A₁, f' x ∈ A₂) :
    Work.Cohomology.relComplexMap R A₁ A₂ f h = Work.Cohomology.relComplexMap R A₁ A₂ f' h' := by
  subst hf
  apply HomologicalComplex.hom_ext
  intro n
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  rfl

/-! ## A homeomorphism of pairs induces an isomorphism of relative cohomology -/

/-- **A map of pairs which is an isomorphism of the underlying spaces induces an isomorphism of
relative cohomology.** -/
private theorem relCohIsoOfIso {R : Type} [CommRing R] {X₁ X₂ : TopCat} (A₁ : Set X₁)
    (A₂ : Set X₂) (E : X₁ ≅ X₂) (he : ∀ x ∈ A₁, E.hom x ∈ A₂) (hg : ∀ y ∈ A₂, E.inv y ∈ A₁)
    (k : ℕ) :
    Nonempty ((Work.Cohomology.relComplex R X₂ A₂).homology k ≅
      (Work.Cohomology.relComplex R X₁ A₁).homology k) := by
  have hcomp : Work.Cohomology.relComplexMap R A₁ A₂ (E.hom) he ≫
      Work.Cohomology.relComplexMap R A₂ A₁ (E.inv) hg =
        𝟙 (Work.Cohomology.relComplex R X₂ A₂) := by
    rw [← relComplexMap_comp_l R A₂ A₁ A₂ (E.inv) (E.hom) hg he]
    refine (relComplexMap_congr_l R A₂ A₂ E.inv_hom_id (fun x hx => he (E.inv x) (hg x hx))
      (fun x hx => by simpa using hx)).trans ?_
    exact relComplexMap_id_l R A₂ (fun x hx => by simpa using hx)
  have hcomp' : Work.Cohomology.relComplexMap R A₂ A₁ (E.inv) hg ≫
      Work.Cohomology.relComplexMap R A₁ A₂ (E.hom) he =
        𝟙 (Work.Cohomology.relComplex R X₁ A₁) := by
    rw [← relComplexMap_comp_l R A₁ A₂ A₁ (E.hom) (E.inv) he hg]
    refine (relComplexMap_congr_l R A₁ A₁ E.hom_inv_id (fun x hx => hg (E.hom x) (he x hx))
      (fun x hx => by simpa using hx)).trans ?_
    exact relComplexMap_id_l R A₁ (fun x hx => by simpa using hx)
  haveI : CategoryTheory.IsIso (Work.Cohomology.relComplexMap R A₁ A₂ (E.hom) he) :=
    ⟨Work.Cohomology.relComplexMap R A₂ A₁ (E.inv) hg, hcomp, hcomp'⟩
  exact ⟨Functor.mapIso (HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.up ℕ) k)
    (CategoryTheory.asIso (Work.Cohomology.relComplexMap R A₁ A₂ (E.hom) he))⟩

/-! ## The total space of the trivial bundle over a point -/

/-- **The total space of the trivial bundle over a point is the fibre**: the preferred local
trivialisation at the base point is a homeomorphism onto `pt × ℝⁿ`, and projecting to the fibre
gives a homeomorphism onto `ℝⁿ`.  On points it is the map `p ↦ p.2`. -/
private noncomputable def trivPtHomeo (n : ℕ) (ι : Type) [Inhabited ι] :
    (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι).TotalSpace ≃ₜ
      (EuclideanSpace ℝ (Fin n)) :=
  (((RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι).localTrivAt
      (default : PUnit)).toOpenPartialHomeomorph.toHomeomorphOfSourceEqUnivTargetEqUniv
    (by
      rw [Trivialization.source_eq,
        show ((RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι).localTrivAt
          (default : PUnit)).baseSet = Set.univ from rfl, Set.preimage_univ])
    (by
      rw [Trivialization.target_eq,
        show ((RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι).localTrivAt
          (default : PUnit)).baseSet = Set.univ from rfl, Set.univ_prod_univ])).trans
    (Homeomorph.punitProd (EuclideanSpace ℝ (Fin n)))

@[simp] private theorem trivPtHomeo_apply (n : ℕ) (ι : Type) [Inhabited ι]
    (p : (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι).TotalSpace) :
    trivPtHomeo n ι p = (show EuclideanSpace ℝ (Fin n) from p.2) := rfl

/-! ## The cohomology of the Thom pair of the trivial bundle over a point -/

/-- **The cohomology of the Thom pair of the trivial bundle over a point**: for `n ≥ 1` the
relative cohomology `H^k(E,E∖0;ℤ)` of the trivial rank-`n` bundle `E = ℝⁿ × pt` over a point with
its zero section removed is `ℤ` in degree `n` and `0` in every other degree. -/
private theorem openThom_trivial_point_iso (n : ℕ) (hn : 1 ≤ n) (ι : Type) [Inhabited ι]
    (k : ℕ) :
    Nonempty (OpenThom (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι) k ≅
      ModuleCat.of ℤ (Fin (if k = n then 1 else 0) → ℤ)) := by
  obtain ⟨e1⟩ := relCohIsoOfIso (R := ℤ)
    (X₁ := TopCat.of (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι).TotalSpace)
    (X₂ := TopCat.of (EuclideanSpace ℝ (Fin n)))
    (zeroComplement (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι))
    {v : EuclideanSpace ℝ (Fin n) | v ≠ 0}
    (TopCat.isoOfHomeo (trivPtHomeo n ι))
    (by
      intro x hx
      rw [TopCat.isoOfHomeo_hom, TopCat.ofHom_apply]
      exact hx)
    (by
      intro y hy
      rw [TopCat.isoOfHomeo_inv, TopCat.ofHom_apply]
      exact hy) k
  obtain ⟨e2⟩ := Work.Thom.relCohomology_euclidean_punctured n hn k
  exact ⟨e1.symm ≪≫ e2⟩

/-! ## Transporting cohomology along an equality of degrees -/

private theorem eqRec_smul_int {M : ℕ → ModuleCat ℤ} {a b : ℕ} (h : a = b) (m : ℤ) (x : M a) :
    h ▸ (m • x) = m • (h ▸ x) := by
  cases h; rfl

private theorem eqRec_symm_eqRec_int {M : ℕ → ModuleCat ℤ} {a b : ℕ} (h : a = b) (x : M b) :
    h ▸ (h.symm ▸ x) = x := by
  cases h; rfl

private theorem eqRec_eqRec_symm_int {M : ℕ → ModuleCat ℤ} {a b : ℕ} (h : a = b) (x : M a) :
    h.symm ▸ (h ▸ x) = x := by
  cases h; rfl

/-! ## The degree-zero Thom map sends a generator to a generator -/

/-- **The degree-zero Thom map of the trivial bundle over a point is bijective.**  For any bundle
over a point and any generator `τ` of `H^n(E,E∖0;ℤ)` (expressed by an isomorphism
`e : H^n(E,E∖0;ℤ) ≅ ℤ` with `e τ = 1`), the map `x ↦ π^*(x) ⌣ τ`
(`Work.Thom.thomMap` in degree `0`) is bijective: `H⁰(pt;ℤ) = ℤ` is generated by the unit class
(`Work.Cohomology.exists_smul_oneH`), and the unit class acts as the identity on relative
cohomology (`Work.Thom.mixedCupC_oneH_zero`, `Work.Thom.CohMap_oneH`). -/
private theorem bijective_thomMap_zero {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {ι : Type} [Inhabited ι] (Z : RealBundle PUnit F ι) (n : ℕ) (τ : OpenThom Z n)
    (e : OpenThom Z n ≅ ModuleCat.of ℤ ℤ) (he : (e.hom.hom) τ = 1) :
    Function.Bijective (thomMap Z n τ 0) := by
  let u : Work.Thom.Coh ℤ 0 PUnit :=
    Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of PUnit))
  have key : ∀ m : ℤ, (thomMap Z n τ 0) (m • u) = m • ((Nat.zero_add n).symm ▸ τ) := by
    intro m
    have hCoh : (Work.Thom.CohMap (bundleProj Z) ℤ 0).hom u =
        Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) :=
      CohMap_oneH (bundleProj Z)
    have hinner : (thomMap Z n τ 0) u = (Nat.zero_add n).symm ▸ τ := by
      rw [thomMap_apply, hCoh, mixedCupC_oneH_zero (zeroComplement Z) n τ]
    have h1 : (thomMap Z n τ 0) (m • u) = m • ((thomMap Z n τ 0) u) :=
      map_zsmul _ m u
    rw [h1, hinner]
  have hinj : Function.Injective (e.hom.hom) := by
    have hcomp : (e.inv.hom).comp (e.hom.hom) = LinearMap.id := by
      have hh := congrArg ModuleCat.Hom.hom (CategoryTheory.Iso.hom_inv_id e)
      rw [ModuleCat.hom_comp, ModuleCat.hom_id] at hh
      exact hh
    intro a b hab
    have ha := LinearMap.congr_fun hcomp a
    have hb := LinearMap.congr_fun hcomp b
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at ha hb
    rw [hab] at ha
    exact ha.symm.trans hb
  constructor
  · intro x y hxy
    obtain ⟨m, hm⟩ := Work.Cohomology.exists_smul_oneH (TopCat.of PUnit) x
    obtain ⟨m', hm'⟩ := Work.Cohomology.exists_smul_oneH (TopCat.of PUnit) y
    have hm2 : x = m • u := hm
    have hm2' : y = m' • u := hm'
    rw [hm2, hm2', key m, key m'] at hxy
    have h3 := congrArg (fun z : OpenThom Z (0 + n) => (Nat.zero_add n) ▸ z) hxy
    rw [eqRec_smul_int (M := fun m => OpenThom Z m) (Nat.zero_add n) m ((Nat.zero_add n).symm ▸ τ),
      eqRec_symm_eqRec_int (M := fun m => OpenThom Z m) (Nat.zero_add n) τ,
      eqRec_smul_int (M := fun m => OpenThom Z m) (Nat.zero_add n) m' ((Nat.zero_add n).symm ▸ τ),
      eqRec_symm_eqRec_int (M := fun m => OpenThom Z m) (Nat.zero_add n) τ] at h3
    have h5 : (e.hom.hom) (m • τ) = (e.hom.hom) (m' • τ) := congrArg (e.hom.hom) h3
    have h5a : (e.hom.hom) (m • τ) = m • (e.hom.hom) τ := map_zsmul _ m τ
    have h5b : (e.hom.hom) (m' • τ) = m' • (e.hom.hom) τ := map_zsmul _ m' τ
    rw [h5a, h5b, he] at h5
    have h4 : m = m' := by simpa using h5
    rw [hm2, hm2', h4]
  · intro y
    have hgen : ∃ m : ℤ, (Nat.zero_add n) ▸ y = m • τ := by
      refine ⟨(e.hom.hom) ((Nat.zero_add n) ▸ y), ?_⟩
      have h6 : (e.hom.hom) ((e.hom.hom) ((Nat.zero_add n) ▸ y) • τ)
          = (e.hom.hom) ((Nat.zero_add n) ▸ y) := by
        have h6a : (e.hom.hom) ((e.hom.hom) ((Nat.zero_add n) ▸ y) • τ)
            = (e.hom.hom) ((Nat.zero_add n) ▸ y) • (e.hom.hom) τ :=
          map_zsmul _ _ τ
        rw [h6a, he, smul_eq_mul, mul_one]
      exact (hinj h6).symm
    obtain ⟨m, hm⟩ := hgen
    refine ⟨m • u, ?_⟩
    rw [key m, ← eqRec_smul_int (M := fun m => OpenThom Z m) (Nat.zero_add n).symm m τ, ← hm,
      eqRec_eqRec_symm_int (M := fun m => OpenThom Z m) (Nat.zero_add n) y]

/-! ## The positive-degree Thom maps -/

/-- **The Thom map of the trivial bundle over a point is bijective in positive degrees**: both the
source `H^{k+1}(pt;ℤ)` and, by `openThom_trivial_point_iso`, the target
`H^{(k+1)+n}(E,E∖0;ℤ)` vanish. -/
private theorem bijective_thomMap_of_pos {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {ι : Type} [Inhabited ι] (Z : RealBundle PUnit F ι) (n : ℕ) (τ : OpenThom Z n) (k : ℕ)
    (h : Subsingleton (OpenThom Z ((k + 1) + n))) :
    Function.Bijective (thomMap Z n τ (k + 1)) := by
  haveI := h
  haveI : Subsingleton (Work.Thom.Coh ℤ (k + 1) PUnit) :=
    ModuleCat.isZero_iff_subsingleton.mp (Work.Cohomology.punit ℤ k)
  exact ⟨fun a b _ => Subsingleton.elim a b, fun b => ⟨0, Subsingleton.elim _ _⟩⟩

/-! ## The Thom class -/

/-- **The trivial bundle of rank `n` over a point has a Thom class**: the base case of the Thom
isomorphism theorem (`Work.Thom.ThomClassExists`).

The Thom pair is `(ℝⁿ, ℝⁿ∖0)` — up to the identification of `Z.TotalSpace` with `ℝⁿ` for
`Z = Work.TangentClasses.RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι` — whose relative
cohomology is `ℤ` in degree `n` and `0` otherwise (`Work.Thom.relCohomology_euclidean_punctured`).
Take `τ ∈ H^n(E,E∖0;ℤ)` a generator.  The Thom map `H^k(pt) → H^{k+n}(E,E∖0;ℤ)` is `x ↦ π^*x ⌣ τ`;
since `H⁰(pt) ≅ ℤ` maps `1 ↦ τ` (`1 ⌣ τ = τ`) and `H^k(pt) = 0` for `k ≥ 1`
(`Work.Cohomology.contractible`), it is bijective in every degree. -/
theorem thomClass_trivial_point (n : ℕ) (hn : 1 ≤ n) (ι : Type) [Inhabited ι] :
    Nonempty (Work.Thom.ThomClass
      (Work.TangentClasses.RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι) n) := by
  obtain ⟨φ'⟩ := openThom_trivial_point_iso n hn ι n
  rw [if_pos rfl] at φ'
  let φ : OpenThom (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι) n ≅
      ModuleCat.of ℤ ℤ := φ' ≪≫ (LinearEquiv.funUnique (Fin 1) ℤ ℤ).toModuleIso
  let τ : OpenThom (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι) n :=
    (φ.inv.hom) (1 : ℤ)
  have he : (φ.hom.hom) τ = 1 := by
    have hh := congrArg ModuleCat.Hom.hom (CategoryTheory.Iso.inv_hom_id φ)
    rw [ModuleCat.hom_comp, ModuleCat.hom_id] at hh
    exact LinearMap.congr_fun hh 1
  refine ⟨⟨τ, fun k => ?_⟩⟩
  rcases k with _ | k
  · exact bijective_thomMap_zero (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι) n τ φ he
  · refine bijective_thomMap_of_pos (RealBundle.trivial PUnit (EuclideanSpace ℝ (Fin n)) ι) n τ k ?_
    obtain ⟨e⟩ := openThom_trivial_point_iso n hn ι ((k + 1) + n)
    rw [if_neg (by omega : ¬ ((k + 1) + n = n))] at e
    haveI : Subsingleton (ModuleCat.of ℤ (Fin 0 → ℤ)) :=
      ⟨fun a b => funext fun i => i.elim0⟩
    exact ModuleCat.isZero_iff_subsingleton.mp
      (CategoryTheory.Limits.IsZero.of_iso (ModuleCat.isZero_of_subsingleton _) e)

end Work.Thom
