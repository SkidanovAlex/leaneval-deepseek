/-!
# The model Thom class restricts to a generator on every fibre

`Work.Thom.Mn n B` is the model class of the pair `(B × ℝⁿ, B × Sⁿ⁻¹)` — the model induction of
`Submission/Work/Thom/` (see `Work.Thom.naturalModelClass`).  Its restriction to the fibre over a
point `b` is the model class over the one-point base `↥{b}` (`Work.Thom.Mn_natural`), and the model
property `Work.Thom.Mn_isModel` identifies the unit class of `H⁰(↥{b}) ≅ ℤ` with it: since `H⁰` of
a path-connected space is generated by the unit class (`Work.Cohomology.exists_smul_oneH`) and the
mixed cup with the unit class is the identity (`Work.Thom.mixedCup_oneH_zero`), the restriction
generates `H^n(↥{b} × ℝⁿ, ↥{b} × Sⁿ⁻¹) ≅ ℤ`.

This is the base case of the fibre-wise characterisation of the Thom class and the input of the
local degree (`Work.Tubular.TubeLocalDegreeOnePoint`); the companion file
`Submission/Work/Tubular/modelClassPunct_fibre_span_top.lean` does the punctured model `Mpun`.

## The cast API

The statement of `Work.Thom.Mn_isModel n B 0` lands in degree `0 + n`, while the class `Mn n B`
lives in degree `n`; the two are related by the transport along `Nat.zero_add n`.  The two lemmas
`Work.Tubular.relCoh_cast_zsmul` and `Work.Tubular.relCoh_cast_symm_cast` are the transport API,
and `Work.Tubular.span_singleton_cast_top` (resp. `Work.Tubular.span_singleton_map_eq_top`) is the
general form in which the argument is consumed.

All statements of this file are `sorry`-free with axioms
`⊆ {propext, Classical.choice, Quot.sound}`.
-/

open CategoryTheory Limits
open scoped Topology

namespace Work.Tubular

noncomputable section

/-- **Transport of a relative cohomology class along an equality of degrees commutes with the
`ℤ`-action.** -/
theorem relCoh_cast_zsmul {X : Type} [TopologicalSpace X] (A : Set X) {a b : ℕ} (h : a = b)
    (m : ℤ) (x : Work.Thom.RelCoh ℤ a X A) :
    h ▸ (m • x) = m • (h ▸ x) := by
  cases h; rfl

/-- **Transport of a relative cohomology class along an equality of degrees is involutive on the
nose**: casting a class from degree `b` to degree `a` and back is the identity. -/
theorem relCoh_cast_symm_cast {X : Type} [TopologicalSpace X] (A : Set X) {a b : ℕ} (h : a = b)
    (x : Work.Thom.RelCoh ℤ b X A) : h ▸ (h.symm ▸ x) = x := by
  cases h; rfl

/-- The same transport, stated with the `Module`-structure scalar action on both sides (the form in
which `Submodule.mem_span_singleton` presents its scalar). -/
theorem relCoh_cast_smul' {X : Type} [TopologicalSpace X] (A : Set X) {a b : ℕ} (h : a = b)
    (m : ℤ) (x : Work.Thom.RelCoh ℤ a X A) :
    h ▸ ((inferInstance : Module ℤ (Work.Thom.RelCoh ℤ a X A)).smul m x)
      = (inferInstance : Module ℤ (Work.Thom.RelCoh ℤ b X A)).smul m (h ▸ x) := by
  cases h; rfl

/-- **Generation by a single class is preserved by the transport along an equality of degrees.** -/
theorem span_singleton_cast_top {X : Type} [TopologicalSpace X] (A : Set X) {a b : ℕ} (h : a = b)
    (z : Work.Thom.RelCoh ℤ b X A) (hgen : Submodule.span ℤ {(h.symm ▸ z)} = ⊤) :
    Submodule.span ℤ {z} = ⊤ := by
  have hgen' : ∀ y' : Work.Thom.RelCoh ℤ a X A, y' ∈ Submodule.span ℤ {(h.symm ▸ z)} :=
    fun y' => by rw [hgen]; exact Submodule.mem_top
  refine Submodule.eq_top_iff'.mpr fun y => ?_
  rw [Submodule.mem_span_singleton]
  obtain ⟨m, hm⟩ := Submodule.mem_span_singleton.mp (hgen' (h.symm ▸ y))
  refine ⟨m, ?_⟩
  have key : h ▸ ((inferInstance : Module ℤ (Work.Thom.RelCoh ℤ a X A)).smul m (h.symm ▸ z))
      = h ▸ (h.symm ▸ y) := congrArg (fun w => h ▸ w) hm
  rw [relCoh_cast_smul', relCoh_cast_symm_cast, relCoh_cast_symm_cast] at key
  exact key

/-- A surjective `ℤ`-linear map sends a generator (a class whose span is everything) to a
generator. -/
theorem span_singleton_map_eq_top {M N : Type*} [AddCommGroup M] [Module ℤ M]
    [AddCommGroup N] [Module ℤ N] (f : M →ₗ[ℤ] N) (hf : Function.Surjective f) (x : M)
    (hx : Submodule.span ℤ {x} = ⊤) : Submodule.span ℤ {f x} = ⊤ := by
  have h1 : Submodule.map f (Submodule.span ℤ {x}) = Submodule.span ℤ {f x} := by
    rw [Submodule.map_span]; simp
  rw [← h1, hx, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr hf

/-- **The model class restricts to a generator on every fibre.**  The restriction of
`Work.Thom.Mn n B` to the fibre over `b` — i.e. `Work.Thom.Mn n ↥{b}` — generates
`H^n(↥{b} × ℝⁿ, ↥{b} × Sⁿ⁻¹) ≅ ℤ`. -/
theorem modelClass_fibre_span_top (n : ℕ) (B : Type) [TopologicalSpace B] (b : B) :
    Submodule.span ℤ
      {((Work.Thom.relCohMap (Work.Thom.baseIncl B ({b} : Set B) n)
          (Work.Thom.Sph ({b} : Set B) n) (Work.Thom.Sph B n)
          (fun p hp => hp) ℤ n).hom (Work.Thom.Mn n B))}
      = ⊤ := by
  rw [Work.Thom.Mn_natural n B ({b} : Set B)]
  refine Submodule.eq_top_iff'.mpr fun y => ?_
  rw [Submodule.mem_span_singleton]
  obtain ⟨x, hx⟩ := (Work.Thom.Mn_isModel n ↥({b} : Set B) 0).2
    ((Nat.zero_add n).symm ▸ y : Work.Thom.RelCoh ℤ (0 + n)
      (↥({b} : Set B) × EuclideanSpace ℝ (Fin n)) (Work.Thom.Sph (↥({b} : Set B)) n))
  obtain ⟨m, hm⟩ := Work.Cohomology.exists_smul_oneH (TopCat.of ↥({b} : Set B)) x
  have hbase : (Work.Thom.mixedCupC ℤ (Work.Thom.Sph (↥({b} : Set B)) n) 0 n)
      ((Work.Thom.CohMap (Work.Thom.projFstA ↥({b} : Set B) n) ℤ 0).hom
        (Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B)))))
      (Work.Thom.Mn n ↥({b} : Set B))
      = (Nat.zero_add n).symm ▸ Work.Thom.Mn n ↥({b} : Set B) := by
    rw [Work.Thom.CohMap_oneH, Work.Thom.mixedCupC_eq_mixedCup, Work.Thom.mixedCup_oneH_zero]
  have hchain : (Work.Thom.mixedCupC ℤ (Work.Thom.Sph (↥({b} : Set B)) n) 0 n)
      ((Work.Thom.CohMap (Work.Thom.projFstA ↥({b} : Set B) n) ℤ 0).hom
        (m • Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B)))))
      (Work.Thom.Mn n ↥({b} : Set B))
      = m • ((Nat.zero_add n).symm ▸ Work.Thom.Mn n ↥({b} : Set B)) := by
    rw [map_zsmul, map_zsmul, ← hbase]
    rfl
  have hfx : (Work.Thom.mixedCupC ℤ (Work.Thom.Sph (↥({b} : Set B)) n) 0 n)
      ((Work.Thom.CohMap (Work.Thom.projFstA ↥({b} : Set B) n) ℤ 0).hom x)
      (Work.Thom.Mn n ↥({b} : Set B))
      = m • ((Nat.zero_add n).symm ▸ Work.Thom.Mn n ↥({b} : Set B)) := by
    rw [hm]
    exact hchain
  have hy := hx.symm.trans hfx
  have h5 := congrArg (fun w => (Nat.zero_add n) ▸ w) hy
  rw [relCoh_cast_symm_cast, relCoh_cast_zsmul, relCoh_cast_symm_cast] at h5
  exact ⟨m, (int_smul_eq_zsmul (inferInstance : Module ℤ (Work.Thom.RelCoh ℤ n
    (↥({b} : Set B) × EuclideanSpace ℝ (Fin n)) (Work.Thom.Sph (↥({b} : Set B)) n))) m
      (Work.Thom.Mn n ↥({b} : Set B))).trans h5.symm⟩

end

end Work.Tubular
