/-!
# The sphere bundle of a Euclidean bundle is Hausdorff

The sphere bundle `Work.Thom.SphSub Z` of a real bundle `Z` over a base `B` is, by definition,
the subspace `{p : Z.TotalSpace // p ∈ Work.Thom.sphereSet Z}` of the total space of `Z`
(`Submission/Work/Thom/Basic.lean`).  A subspace of a Hausdorff space is Hausdorff, so it suffices
to know that the total space `Z.TotalSpace` is Hausdorff, which is what `t2Space_totalSpace`
proves.

The total space of `RealBundle B F ι = VectorBundleCore ℝ B F ι` carries the topology generated by
the local trivialisations `Z.localTriv i : Z.TotalSpace ≃ₜ (Z.baseSet i) × F`
(`VectorBundleCore.toTopologicalSpace`); it is *not* in general the product topology on `B × F`.
Hausdorffness is proved directly, in the two standard cases:

* two points in different fibres are separated by pulling back disjoint open sets of the
  Hausdorff base `B` along the continuous projection `Z.proj`;
* two distinct points `p ≠ q` in the same fibre are separated inside the source of the
  trivialisation `Z.localTriv (Z.indexAt p.1)`, which is an open partial homeomorphism onto a
  subspace of the Hausdorff space `B × F`; injecting on its source, it sends `p` and `q` to
  distinct points, which the Hausdorffness of `B × F` separates.
-/

namespace Work.Tubular.PuncturedDiscPair

open Work.TangentClasses

/-- **The total space of a real bundle over a Hausdorff base is Hausdorff.**  The base is assumed
Hausdorff; the fibre is a normed space, hence Hausdorff. -/
theorem t2Space_totalSpace {B : Type} [TopologicalSpace B] [T2Space B] {F : Type}
    [NormedAddCommGroup F] [NormedSpace ℝ F] {ι : Type}
    (Z : RealBundle B F ι) : T2Space Z.TotalSpace := by
  rw [t2Space_iff]
  intro p q hpq
  by_cases hb : p.1 = q.1
  · -- Same fibre: separate inside the source of the trivialisation at the common base point.
    have hps : p ∈ (Z.localTriv (Z.indexAt p.1)).source :=
      (VectorBundleCore.mem_localTriv_source Z (Z.indexAt p.1) p).2 (Z.mem_baseSet_at p.1)
    have hqs : q ∈ (Z.localTriv (Z.indexAt p.1)).source := by
      rw [VectorBundleCore.mem_localTriv_source Z (Z.indexAt p.1) q, ← hb]
      exact Z.mem_baseSet_at p.1
    have hne : (Z.localTriv (Z.indexAt p.1)) p ≠ (Z.localTriv (Z.indexAt p.1)) q := by
      intro h
      exact hpq ((Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph.injOn hps hqs h)
    obtain ⟨U, V, hU, hV, hUp, hVq, hdisj⟩ := t2_separation hne
    refine ⟨(Z.localTriv (Z.indexAt p.1)).source ∩ (Z.localTriv (Z.indexAt p.1)) ⁻¹' U,
      (Z.localTriv (Z.indexAt p.1)).source ∩ (Z.localTriv (Z.indexAt p.1)) ⁻¹' V,
      (Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph.isOpen_inter_preimage hU,
      (Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph.isOpen_inter_preimage hV,
      ⟨hps, hUp⟩, ⟨hqs, hVq⟩, ?_⟩
    rw [Set.disjoint_left]
    intro x hx1 hx2
    exact Set.disjoint_left.mp hdisj hx1.2 hx2.2
  · -- Different fibres: pull back separating open sets of the base along the projection.
    obtain ⟨U, V, hU, hV, hUp, hVq, hdisj⟩ := t2_separation hb
    refine ⟨Z.proj ⁻¹' U, Z.proj ⁻¹' V, hU.preimage Z.continuous_proj,
      hV.preimage Z.continuous_proj, ?_, ?_, hdisj.preimage Z.proj⟩
    · exact hUp
    · exact hVq

/-- **The sphere bundle of a real bundle over a Hausdorff base is Hausdorff**: it is a subspace of
the Hausdorff total space `t2Space_totalSpace`. -/
theorem t2Space_sphSub {B : Type} [TopologicalSpace B] [T2Space B] {F : Type}
    [NormedAddCommGroup F] [NormedSpace ℝ F] {ι : Type}
    (Z : Work.TangentClasses.RealBundle B F ι) : T2Space (Work.Thom.SphSub Z) :=
  @instT2SpaceSubtype Z.TotalSpace _ (fun p => p ∈ Work.Thom.sphereSet Z)
    (t2Space_totalSpace Z)

end Work.Tubular.PuncturedDiscPair
