import Submission.Work.Surgery.Gluing
import Submission.Work.SignatureBordism.BallBoundary

-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# Handles and handle attachment

This file sets up the vocabulary of *surgery*: the `(k+1)`-**handle** `D^{k+1} × D^{l+1}`, the
attaching data (an embedding of the attaching region `S^k × D^{l+1}` into the boundary of a manifold
with boundary), the **handlebody** obtained by gluing, and the resulting change of the boundary —
the surgery operation

`S^k × D^{l+1}  ↦  D^{k+1} × S^l`.

## What is here

* `Work.Surgery.Disk k`, `Work.Surgery.Sph k` — the closed `(k+1)`-disk (a smooth manifold with
  boundary, from `Submission/Work/SignatureBordism/BallBoundary.lean`) and the `k`-sphere;
* `Work.Surgery.Handle k l` — the `(k+1)`-handle `D^{k+1} × D^{l+1}`, with its boundary computed in
  `bnd_handleModel`: `∂(D^{k+1} × D^{l+1}) = (S^k × D^{l+1}) ∪ (D^{k+1} × S^l)` — the *attaching
  region* and the *surgery region*;
* `Work.Surgery.AttachData k l M` — an attaching embedding `S^k × D^{l+1} ↪ ∂M`;
* `Work.Surgery.AttachData.Handlebody` — the glued space `M ∪_φ (D^{k+1} × D^{l+1})`, defined as the
  quotient of `M ⊕ Handle k l` by the identification of the attaching region with its image
  (`AttachData.aux`), with its elementary theory: the inclusions are injective off the attaching
  region, and the attaching map identifies as expected (`AttachData.ιM_φ_eq_ιH`);
* **`Work.Surgery.SmoothAttach`** — the *smooth structure on the handlebody*, as a named input,
  together with the identification of its boundary with the result of the surgery
  (`SmoothAttach.boundarySurgery`): the boundary of the handlebody is obtained from `∂M` by deleting
  the attaching region and gluing in `D^{k+1} × S^l` along `φ`.
## Framings

A **framing** of an attaching embedding is a trivialisation of the normal bundle of its attaching
sphere `S^k` in `∂M`; equivalently (and this is the convention of this chapter) an attaching map
already *is* the framed data: an embedding `S^k × D^{l+1} ↪ ∂M` encodes both the attaching sphere
and the trivialised normal bundle `D^{l+1}`.  Framings up to isotopy are classified by `π_k(SO(l+1))`;
in the case that matters for the dimension-`8` congruence, `k = 3`, `l + 1 = 4`, one has

`π₃(SO(4)) ≅ ℤ × ℤ`,

generated by the two families of quaternionic twists `u ↦ L_u` and `u ↦ R_u` (left and right
multiplication by a unit quaternion) — the framings `(a, b) ∈ ℤ × ℤ` of the classical surgery
computation of `Ω^SO_8 ⊗ ℚ`.  This classification is *not* formalised here (it needs the homotopy
groups of the classical groups); it is the input that turns `AttachData` into a `ℤ × ℤ`-parameter
family, and it is recorded in `README.md` as one of the classical inputs of the surgical route.
-/

open scoped Manifold Topology ContDiff
open Function
open Classical

namespace Work.Surgery

noncomputable section

universe u

variable {k l : ℕ}

/-! ## Disks, spheres and the handle -/

/-- The closed `(k+1)`-disk `D^{k+1}`, as a smooth manifold with boundary modelled on
`EuclideanHalfSpace (k+1)`. -/
abbrev Disk (k : ℕ) : Type := Work.SignatureBordism.Ball k

/-- The `k`-sphere `S^k`, as a smooth closed manifold. -/
abbrev Sph (k : ℕ) : Type := Work.SignatureBordism.endSphere k

/-- The boundary of the disk as a subset of the disk: the sphere `S^k ⊆ D^{k+1}`. -/
abbrev diskSphere (k : ℕ) : Set (Disk k) := Work.SignatureBordism.ballSphere k

theorem mem_diskSphere_iff (k : ℕ) (x : Disk k) :
    x ∈ diskSphere k ↔ ‖(x : EuclideanSpace ℝ (Fin (k + 1)))‖ = 1 :=
  Work.SignatureBordism.mem_ballSphere_iff_norm k x

/-- **The boundary of the disk is the sphere**: `∂D^{k+1} = S^k`. -/
theorem bnd_disk (k : ℕ) :
    (𝓡∂ (k + 1)).boundary (Disk k) = diskSphere k :=
  Work.SignatureBordism.ball_boundary k

/-- The inclusion of the sphere into the disk. -/
def sphToDisk (k : ℕ) : Sph k → Disk k := Work.SignatureBordism.sphereToBall k

theorem sphToDisk_mem_diskSphere (k : ℕ) (p : Sph k) : sphToDisk k p ∈ diskSphere k :=
  Work.SignatureBordism.sphereToBall_mem_ballSphere k p

/-- The sphere `S^k` is homeomorphic to the boundary of the disk `∂D^{k+1}`. -/
def sphHomeoDiskSphere (k : ℕ) : Sph k ≃ₜ ↥(diskSphere k) :=
  Work.SignatureBordism.ballBoundaryHomeo k

theorem sphToDisk_sphHomeoDiskSphere (k : ℕ) (y : Sph k) :
    sphToDisk k y = (sphHomeoDiskSphere k y).1 := rfl

theorem sphToDisk_sphHomeoDiskSphere_symm (k : ℕ) (x : ↥(diskSphere k)) :
    sphToDisk k ((sphHomeoDiskSphere k).symm x) = x.1 := by
  rw [sphToDisk_sphHomeoDiskSphere, Homeomorph.apply_symm_apply]

/-- **The `(k+1)`-handle** `D^{k+1} × D^{l+1}`: the product of the closed disks, a smooth manifold
with corners modelled on `(𝓡∂ (k+1)).prod (𝓡∂ (l+1))`. -/
abbrev Handle (k l : ℕ) : Type := Disk k × Disk l

/-- **The boundary of the handle**: `∂(D^{k+1} × D^{l+1})` is the union of the *surgery region*
`D^{k+1} × S^l` (which becomes part of the boundary after attaching) and the *attaching region*
`S^k × D^{l+1}` (where the handle is glued to the boundary of the manifold). -/
theorem bnd_handleModel (k l : ℕ) :
    ((𝓡∂ (k + 1)).prod (𝓡∂ (l + 1))).boundary (Handle k l)
      = Set.univ.prod (diskSphere l) ∪ (diskSphere k).prod Set.univ := by
  rw [ModelWithCorners.boundary_prod, Work.SignatureBordism.ball_boundary k,
    Work.SignatureBordism.ball_boundary l]

/-- The **attaching region** `S^k × D^{l+1}` of the `(k+1)`-handle, as a subset of the handle. -/
def attachingRegion (k l : ℕ) : Set (Handle k l) := (diskSphere k).prod Set.univ

/-- The **surgery region** `D^{k+1} × S^l` of the `(k+1)`-handle. -/
def surgeryRegion (k l : ℕ) : Set (Handle k l) := Set.univ.prod (diskSphere l)

/-- The boundary of the handle is the union of its surgery region and its attaching region. -/
theorem bnd_handleModel_eq (k l : ℕ) :
    ((𝓡∂ (k + 1)).prod (𝓡∂ (l + 1))).boundary (Handle k l)
      = surgeryRegion k l ∪ attachingRegion k l := by
  rw [bnd_handleModel, attachingRegion, surgeryRegion, Set.union_comm]

/-! ## Attaching data and the handlebody -/

/-- **Attaching data** for a `(k+1)`-handle on a manifold `M` with boundary: an embedding of the
attaching region `S^k × D^{l+1}` into `M` whose image lies in the boundary.

The embedding *is* the framing data: an embedding of `S^k × D^{l+1}` encodes both the attaching
sphere and a trivialisation of its normal bundle, which is exactly a framing. -/
structure AttachData (k l : ℕ) (M : Type u) [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (k + l + 2)) M] where
  /-- the attaching embedding -/
  φ : Sph k × Disk l → M
  /-- it is an embedding -/
  isEmbedding : Topology.IsEmbedding φ
  /-- its image lies in the boundary of `M` -/
  mapsTo_boundary : ∀ p, φ p ∈ (𝓡∂ (k + l + 2)).boundary M

namespace AttachData

variable {M : Type u} [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (k + l + 2)) M]

/-- The image of the attaching region in `M` (a subset of the boundary). -/
def attachSet (A : AttachData k l M) : Set M := Set.range A.φ

/-- The attaching region of the handle, as a subset of `Handle k l`: the set of points whose first
coordinate lies on the boundary of the disk. -/
def handleAttach (k l : ℕ) : Set (Handle k l) := {q | q.1 ∈ diskSphere k}

theorem mem_handleAttach {p : Handle k l} :
    p ∈ handleAttach k l ↔ p.1 ∈ diskSphere k := Iff.rfl

/-- The parametrisation of the attaching region of the handle by `S^k × D^{l+1}`. -/
def attachParam (k l : ℕ) : Sph k × Disk l → Handle k l :=
  fun p => (sphToDisk k p.1, p.2)

theorem attachParam_mem_handleAttach (p : Sph k × Disk l) :
    attachParam k l p ∈ handleAttach k l :=
  sphToDisk_mem_diskSphere k p.1

/-- The **pieces of the handlebody**: the complement of the attaching set in `M`, the complement of
the attaching region in the handle, and the common attaching region. -/
abbrev HandlePieces (k l : ℕ) (M : Type u) [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (k + l + 2)) M] (A : AttachData k l M) : Type _ :=
  Sum (Sum {x : M // x ∉ A.attachSet} {q : Handle k l // q ∉ handleAttach k l})
    (Sph k × Disk l)

/-- The identification map of the handle attachment: it sends the complement of the attaching set in
`M`, the complement of the attaching region in the handle, and the common attaching region (the
latter two via the fixed parametrisation `attachParam` of the boundary sphere) to a disjoint sum. -/
def aux (A : AttachData k l M) : M ⊕ Handle k l → HandlePieces k l M A :=
  fun a => match a with
    | Sum.inl x => if hx : x ∈ A.attachSet then Sum.inr (Classical.choose hx)
        else Sum.inl (Sum.inl ⟨x, hx⟩)
    | Sum.inr q => if hq : q ∈ handleAttach k l then
        Sum.inr ((sphHomeoDiskSphere k).symm ⟨q.1, hq⟩, q.2)
      else Sum.inl (Sum.inr ⟨q, hq⟩)

theorem aux_inl (A : AttachData k l M) (x : M) :
    A.aux (Sum.inl x) = if hx : x ∈ A.attachSet then Sum.inr (Classical.choose hx)
      else Sum.inl (Sum.inl ⟨x, hx⟩) := rfl

theorem aux_inr (A : AttachData k l M) (q : Handle k l) :
    A.aux (Sum.inr q) = if hq : q ∈ handleAttach k l then
        Sum.inr ((sphHomeoDiskSphere k).symm ⟨q.1, hq⟩, q.2)
      else Sum.inl (Sum.inr ⟨q, hq⟩) := rfl

/-- The setoid of the handle attachment: the kernel of the identification map. -/
def setoid (A : AttachData k l M) : Setoid (M ⊕ Handle k l) := Setoid.ker (aux A)

/-- **The handlebody** `M ∪_φ (D^{k+1} × D^{l+1})`: the result of attaching a `(k+1)`-handle to `M`
along `φ`. -/
abbrev Handlebody (A : AttachData k l M) : Type _ := Quotient (A.setoid)

instance instTopologicalSpace (A : AttachData k l M) : TopologicalSpace A.Handlebody :=
  inferInstanceAs (TopologicalSpace (Quotient (A.setoid)))

/-- The quotient map from the disjoint union. -/
def q (A : AttachData k l M) : M ⊕ Handle k l → A.Handlebody := Quotient.mk''

/-- The inclusion of `M` into the handlebody. -/
def ιM (A : AttachData k l M) : M → A.Handlebody := A.q ∘ Sum.inl

/-- The inclusion of the handle into the handlebody. -/
def ιH (A : AttachData k l M) : Handle k l → A.Handlebody := A.q ∘ Sum.inr

theorem continuous_q (A : AttachData k l M) : Continuous A.q := by
  change Continuous (Quotient.mk' (s := A.setoid))
  exact continuous_quotient_mk'

theorem continuous_ιM (A : AttachData k l M) : Continuous A.ιM :=
  A.continuous_q.comp continuous_inl

theorem continuous_ιH (A : AttachData k l M) : Continuous A.ιH :=
  A.continuous_q.comp continuous_inr

/-- **The attaching map identifies as expected**: for `p : S^k × D^{l+1}`, the boundary point
`φ p` of `M` is identified with the point `p` of the attaching region of the handle. -/
theorem ιM_φ_eq_ιH (A : AttachData k l M) (p : Sph k × Disk l) :
    A.ιM (A.φ p) = A.ιH (attachParam k l p) := by
  apply Quotient.sound'
  have hinj : Injective A.φ := A.isEmbedding.injective
  have hx : A.φ p ∈ A.attachSet := ⟨p, rfl⟩
  have hchoose : Classical.choose hx = p := hinj (Classical.choose_spec hx)
  show A.aux (Sum.inl (A.φ p)) = A.aux (Sum.inr (attachParam k l p))
  rw [aux_inl, dif_pos hx, aux_inr, dif_pos (attachParam_mem_handleAttach p), hchoose]
  simp only [Sum.inr.injEq]
  refine Prod.ext ?_ ?_
  · exact (Homeomorph.symm_apply_apply (sphHomeoDiskSphere k) p.1).symm
  · rfl

/-- The two sides meet exactly in the attaching set. -/
theorem ιM_eq_ιH_iff (A : AttachData k l M) {x : M} {q : Handle k l} :
    A.ιM x = A.ιH q ↔ ∃ p : Sph k × Disk l, A.φ p = x ∧ attachParam k l p = q := by
  constructor
  · intro h
    have h' : A.aux (Sum.inl x) = A.aux (Sum.inr q) := Quotient.exact' h
    rw [aux_inl, aux_inr] at h'
    by_cases hx : x ∈ A.attachSet
    · by_cases hq : q ∈ handleAttach k l
      · rw [dif_pos hx, dif_pos hq] at h'
        refine ⟨Classical.choose hx, Classical.choose_spec hx, ?_⟩
        have h2 : ((sphHomeoDiskSphere k).symm ⟨q.1, hq⟩, q.2) = Classical.choose hx :=
          (Sum.inr.inj h').symm
        rw [← h2]
        refine Prod.ext ?_ ?_
        · exact congrArg Subtype.val
            (Homeomorph.apply_symm_apply (sphHomeoDiskSphere k) ⟨q.1, hq⟩)
        · rfl
      · rw [dif_pos hx, dif_neg hq] at h'
        exact absurd h' (by simp)
    · by_cases hq : q ∈ handleAttach k l
      · rw [dif_neg hx, dif_pos hq] at h'
        exact absurd h' (by simp)
      · rw [dif_neg hx, dif_neg hq] at h'
        exact absurd h' (by simp)
  · rintro ⟨p, rfl, rfl⟩
    exact A.ιM_φ_eq_ιH p

/-- Points of `M` outside the attaching set are not identified with anything in the handle. -/
theorem ιM_ne_ιH (A : AttachData k l M) {x : M} (hx : x ∉ A.attachSet) {q : Handle k l} :
    A.ιM x ≠ A.ιH q := by
  rintro h
  obtain ⟨p, hp, -⟩ := (A.ιM_eq_ιH_iff).mp h
  exact hx ⟨p, hp⟩

/-- **The handlebody is compact** when `M` and the handle are. -/
theorem compactSpace (A : AttachData k l M) [CompactSpace M] :
    CompactSpace A.Handlebody := by
  rw [← isCompact_univ_iff]
  have h : Set.range A.q = Set.univ := by
    rw [Set.range_eq_univ]
    intro z
    obtain ⟨a, rfl⟩ := Quotient.exists_rep z
    exact ⟨a, rfl⟩
  rw [← h]
  exact isCompact_range A.continuous_q

end AttachData

/-- **The smooth structure on a handlebody, as a named input**, together with the identification of
its boundary as the result of the surgery.

Given attaching data `A` for a `(k+1)`-handle on `M`, this bundles a smooth structure with boundary
on the glued space (modelled on `EuclideanHalfSpace (k+l+2)`), the Hausdorff property, the two inclusions as
*embeddings* which are open maps off the gluing region (as for a boundary gluing, the two pieces are
glued along a *closed* subset, so their images are not open — only the complements of the gluing
region map onto open sets), and the fact that makes the structure the one describing the topological
surgery: the boundary of the handlebody is obtained from `∂M` by deleting the attaching region and
gluing in the surgery region `D^{k+1} × S^l` along `φ`.

This is the missing geometric theorem of this chapter (the smooth handle attachment theorem); it is
not in Mathlib and it is not proved here. -/
structure SmoothAttach {M : Type u} [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (k + l + 2)) M] (A : AttachData k l M) : Type _ where
  /-- the charted space structure on the handlebody: it is modelled on the *half-space*, because the
  handlebody has a nonempty boundary (the surgery region) — charting it over the boundaryless model
  would make the field `boundarySurgery` below unsatisfiable -/
  chartedSpace : ChartedSpace (EuclideanHalfSpace (k + l + 2)) A.Handlebody
  /-- the smooth manifold structure -/
  isManifold : @IsManifold ℝ _ (EuclideanSpace ℝ (Fin (k + l + 2))) _ _
    (EuclideanHalfSpace (k + l + 2)) _
    (halfModel (k + l + 2)) ((⊤ : ℕ∞) : WithTop ℕ∞) A.Handlebody _ chartedSpace
  /-- the handlebody is Hausdorff -/
  t2Space : T2Space A.Handlebody
  /-- the inclusion of `M` is an embedding -/
  isEmbedding_ιM : @Topology.IsEmbedding M A.Handlebody _ _ A.ιM
  /-- the inclusion of the handle is an embedding -/
  isEmbedding_ιH : @Topology.IsEmbedding (Handle k l) A.Handlebody _ _ A.ιH
  /-- the inclusion of `M` is an open map off the attaching set: only `M ∖ attachSet` maps onto an
  open subset of the handlebody (points of the attaching set are glued to the handle) -/
  isOpenMap_compl_ιM : IsOpenMap fun x : Set.Elem A.attachSetᶜ => A.ιM x.1
  /-- the inclusion of the handle is an open map off its attaching region -/
  isOpenMap_compl_ιH : IsOpenMap fun q : Set.Elem (AttachData.handleAttach k l)ᶜ => A.ιH q.1
  /-- **the boundary after surgery**: the boundary of the handlebody, as a set, is the union of the
  image of `∂M ∖ attachSet` and the image of the surgery region `D^{k+1} × S^l` of the handle -/
  boundarySurgery : (halfModel (k + l + 2)).boundary A.Handlebody
      = A.ιM '' ((halfModel (k + l + 2)).boundary M \ A.attachSet)
        ∪ A.ιH '' (surgeryRegion k l)

namespace SmoothAttach

variable {M : Type u} [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (k + l + 2)) M] {A : AttachData k l M}

theorem isManifold' (S : SmoothAttach A) :
    @IsManifold ℝ _ (EuclideanSpace ℝ (Fin (k + l + 2))) _ _
      (EuclideanHalfSpace (k + l + 2)) _ (halfModel (k + l + 2)) ((⊤ : ℕ∞) : WithTop ℕ∞)
      A.Handlebody _ S.chartedSpace :=
  S.isManifold

end SmoothAttach

/-! ## Capping: the `k = n` case

The case of item 3(b) of the request — capping a compact `8`-manifold with boundary `S⁷` by `D⁸`
along a diffeomorphism of the boundary — is the gluing of `Gluing.lean` with the disk as the second
piece: the attaching region of an `n`-handle is the *whole* boundary of the disk. -/

/-- **Capping data**: a manifold `M` with boundary, glued to the disk `D^{n+1}` along a
homeomorphism of the whole boundary. -/
abbrev CappingData (n : ℕ) (M : Type u) [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (n + 1)) M] : Type _ := GlueData n M (Disk n)

/-- **The capped manifold is a closed manifold** (given the smooth-structure input of
`SmoothGlue`): capping glues the whole boundary away, so the result has no boundary, and it is
compact when `M` is.  With `M` a compact `8`-manifold with boundary `S⁷` and the disk `D⁸`, this is
the closed `8`-manifold `X = W ∪_φ D⁸` whose invariants contradict the dimension-`8` congruence. -/
theorem capping_isClosed {n : ℕ} {M : Type u} [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace (n + 1)) M] (D : CappingData n M)
    (S : SmoothGlue D) [CompactSpace M] :
    CompactSpace D.Glued ∧
      @ModelWithCorners.boundary ℝ _ (EuclideanSpace ℝ (Fin (n + 1))) _ _
        (EuclideanSpace ℝ (Fin (n + 1))) _ (𝓡 (n + 1)) D.Glued _ S.chartedSpace = ∅ :=
  ⟨S.compactSpace, S.boundary_eq_empty⟩

end

end Work.Surgery
