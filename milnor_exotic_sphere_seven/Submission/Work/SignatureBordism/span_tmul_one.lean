namespace Work.SignatureBordism

/-
Base change from `ℤ` to `ℚ` sends a cyclic `ℤ`-module generated by `x` to a cyclic `ℚ`-module
generated by `1 ⊗ₜ x`.

If `Submodule.span ℤ {x} = ⊤` then every `m : M` is of the form `n • x` for some `n : ℤ`
(`Submodule.mem_span_singleton`). Writing `t = 1 ⊗ₜ[ℤ] x`, for `q : ℚ` we have
`q ⊗ₜ[ℤ] m = (q * (n : ℚ)) • t`:
the map `y ↦ 1 ⊗ₜ[ℤ] y` is `ℤ`-linear, so `1 ⊗ₜ (n • x) = n • (1 ⊗ₜ x)`, and a `ℤ`-multiple of
`t` is a `ℚ`-multiple of `t` by `Int.cast_smul_eq_zsmul`.  Since every element of the tensor
product is a finite sum of pure tensors, `t` generates `ℚ ⊗[ℤ] M` over `ℚ`.
-/
open TensorProduct in
theorem span_tmul_one {M : Type*} [AddCommGroup M] [Module ℤ M] (x : M)
    (hx : Submodule.span ℤ {x} = ⊤) :
    Submodule.span ℚ {((1 : ℚ) ⊗ₜ[ℤ] x : ℚ ⊗[ℤ] M)} = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro z
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · exact Submodule.zero_mem _
  · intro q m
    have hm : m ∈ Submodule.span ℤ {x} := by rw [hx]; exact Submodule.mem_top
    obtain ⟨n, hn⟩ := (Submodule.mem_span_singleton).mp hm
    -- `Submodule.mem_span_singleton` produces the `•` coming from the `Module ℤ M` structure;
    -- rewrite it to the canonical `zsmul` so that all subsequent scalar manipulations are
    -- stated with a single, consistent `ℤ`-action.
    have hz : n • x = m :=
      (int_smul_eq_zsmul (inferInstance : Module ℤ M) n x).symm.trans hn
    rw [← hz]
    have h1 : ((1 : ℚ) ⊗ₜ[ℤ] (n • x) : ℚ ⊗[ℤ] M) = n • ((1 : ℚ) ⊗ₜ[ℤ] x) := by
      change (TensorProduct.mk ℤ ℚ M (1 : ℚ)) (n • x)
        = n • (TensorProduct.mk ℤ ℚ M (1 : ℚ)) x
      exact map_zsmul _ n x
    have h2 : q ⊗ₜ[ℤ] (n • x) = (q * (n : ℚ)) • ((1 : ℚ) ⊗ₜ[ℤ] x : ℚ ⊗[ℤ] M) := by
      calc q ⊗ₜ[ℤ] (n • x)
          = q • ((1 : ℚ) ⊗ₜ[ℤ] (n • x)) := TensorProduct.tmul_eq_smul_one_tmul q (n • x)
        _ = q • (n • ((1 : ℚ) ⊗ₜ[ℤ] x)) := by rw [h1]
        _ = q • ((n : ℚ) • ((1 : ℚ) ⊗ₜ[ℤ] x)) := by rw [Int.cast_smul_eq_zsmul]
        _ = (q * (n : ℚ)) • ((1 : ℚ) ⊗ₜ[ℤ] x) := by rw [mul_smul]
    rw [h2]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))
  · intro y w hy hw
    exact Submodule.add_mem _ hy hw

end Work.SignatureBordism
