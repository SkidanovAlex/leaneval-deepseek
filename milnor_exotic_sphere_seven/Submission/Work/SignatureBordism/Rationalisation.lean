-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The signature of a closed oriented manifold

Let `X` be a simplicial set and `c ∈ H_{2k}(X;ℤ)` a homology class — in the applications
`X = TopCat.toSSet.obj M` for a closed oriented smooth `2k`-manifold `M` and `c = [M]` the
fundamental class.  The **middle intersection form** of `X` in degree `k` (see
`Submission/Work/SignatureBordism/Intersection.lean`) is the quadratic form

  `y ↦ ⟨y ⌣ y, c⟩`

on `H^k(X;ℤ)`, and the **signature** `σ(X)` is the signature of its rationalisation

  `H^k(X;ℤ) ⊗[ℤ] ℚ`

(see `Work.SignatureBordism.signature` for the algebraic signature).

## Why the rationalised lattice, and not `H^k(X;ℚ)`?

The whole cohomology chapter of this workspace computes integral cohomology; there is no
coefficient-change functor `H^*(X;ℤ) → H^*(X;ℚ)` available.  For finitely generated cohomology the
universal coefficient theorem identifies `H^k(X;ℤ) ⊗[ℤ] ℚ` with `H^k(X;ℚ)`
(`H^k(X;ℚ) ≅ Hom(H_k(X;ℤ), ℚ)`, and tensoring with `ℚ` kills the torsion of `H^k(X;ℤ)`), so the
form defined here *is* the usual intersection form on `H^k(X;ℚ)`.  For callers who do have
`ℚ`-coefficient cohomology at hand, `sigmaQ` is the same definition phrased directly over `ℚ`.

## Main definitions

* `Work.SignatureBordism.baseChangeBilin` — the `ℚ`-bilinear form on `M ⊗[ℤ] ℚ` extending an
  integral bilinear form `M →ₗ[ℤ] M →ₗ[ℤ] ℤ` (`baseChange_bilinear_exists`, made definite here);
* `Work.SignatureBordism.ratCohomology k X` — the rationalised middle cohomology
  `H^k(X;ℤ) ⊗[ℤ] ℚ`;
* `Work.SignatureBordism.ratInterForm k X c` — the rationalised middle intersection form;
* `Work.SignatureBordism.sigma k X c` — **the signature** `σ`, as an integer;
* `Work.SignatureBordism.sigmaQ k X c` — the signature computed directly from a
  `ℚ`-coefficient fundamental class.

## Main results

* `Work.SignatureBordism.sigma_of_span_singleton` — if `H^k(X;ℤ)` is generated by a single class
  `x` and `⟨x ⌣ x, c⟩ = m ≠ 0`, then the intersection form is the `1 × 1` form `(m)` and
  `σ(X) = sign m`;
* `Work.SignatureBordism.sigma_eq_one_of_span_singleton`,
  `Work.SignatureBordism.sigma_eq_neg_one_of_span_singleton` — the `±1` cases;
* `Work.SignatureBordism.sigma_neg_fundamental` — reversing the fundamental class (i.e. the
  orientation) negates the signature: `σ(-M) = -σ(M)`.
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

open TensorProduct

namespace Work.SignatureBordism

open Work.Cohomology

noncomputable section

variable {M : Type*} [AddCommGroup M] [Module ℤ M]

/-! ## Base change of an integral bilinear form to `ℚ` -/

/-- **The base change of an integral bilinear form to `ℚ`**: the unique `ℚ`-bilinear form on
`M ⊗[ℤ] ℚ` with `(a ⊗ m, b ⊗ n) ↦ (a * b) * B m n`.  (The existence is
`Work.SignatureBordism.baseChange_bilinear_exists`; this is the definite choice, as in the
cohomology chapter's `kronH`, `cupH'`, `capPair`.) -/
noncomputable def baseChangeBilin (B : M →ₗ[ℤ] M →ₗ[ℤ] ℤ) :
    (ℚ ⊗[ℤ] M) →ₗ[ℚ] (ℚ ⊗[ℤ] M) →ₗ[ℚ] ℚ :=
  Classical.choose (baseChange_bilinear_exists B)

/-- **The computation rule for the base change**: on pure tensors it is `(a * b) * B m n`. -/
theorem baseChangeBilin_tmul (B : M →ₗ[ℤ] M →ₗ[ℤ] ℤ) (a b : ℚ) (m n : M) :
    baseChangeBilin B (a ⊗ₜ[ℤ] m) (b ⊗ₜ[ℤ] n) = (a * b) * (B m n : ℚ) :=
  Classical.choose_spec (baseChange_bilinear_exists B) a b m n

/-- `baseChangeBilin` is additive in the form. -/
theorem baseChangeBilin_add (B B' : M →ₗ[ℤ] M →ₗ[ℤ] ℤ) :
    baseChangeBilin (B + B') = baseChangeBilin B + baseChangeBilin B' := by
  apply tensor_bilin_ext
  intro a b m n
  simp only [LinearMap.add_apply, baseChangeBilin_tmul]
  push_cast
  ring

/-- `baseChangeBilin` intertwines negation (the form of the reversed orientation is the negative
of the form). -/
@[simp] theorem baseChangeBilin_neg (B : M →ₗ[ℤ] M →ₗ[ℤ] ℤ) :
    baseChangeBilin (-B) = -baseChangeBilin B := by
  apply tensor_bilin_ext
  intro a b m n
  simp only [LinearMap.neg_apply, baseChangeBilin_tmul]
  push_cast
  ring

/-! ## The rationalised middle cohomology and the intersection form -/

/-- **The rationalised cohomology** `H^n(X;ℤ) ⊗[ℤ] ℚ`, the model of `H^n(X;ℚ)` used in this
chapter (see the module docstring for why). -/
abbrev ratCohomology (n : ℕ) (X : SSet) : Type _ :=
  ℚ ⊗[ℤ] ((cochainC ℤ X).homology n)

/-- **The rationalised middle intersection form** of a closed oriented `2k`-manifold: the
`ℚ`-bilinear form `(y, z) ↦ ⟨y ⌣ z, c⟩` on `H^k(X;ℤ) ⊗ ℚ`, where `c` is the fundamental class. -/
noncomputable def ratInterForm (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k)) :
    ratCohomology k X →ₗ[ℚ] ratCohomology k X →ₗ[ℚ] ℚ :=
  baseChangeBilin (interForm ℤ X k k c)

/-- **The computation rule** for the rationalised intersection form on pure tensors. -/
theorem ratInterForm_tmul (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k))
    (a b : ℚ) (y z : (cochainC ℤ X).homology k) :
    ratInterForm k X c (a ⊗ₜ[ℤ] y) (b ⊗ₜ[ℤ] z) =
      (a * b) * (interForm ℤ X k k c y z : ℚ) :=
  baseChangeBilin_tmul _ a b y z

/-- Reversing the fundamental class negates the rationalised intersection form. -/
theorem ratInterForm_neg_fundamental (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k)) :
    ratInterForm k X (-c) = -ratInterForm k X c := by
  have h : interForm ℤ X k k (-c) = -interForm ℤ X k k c := by
    apply LinearMap.ext; intro y
    apply LinearMap.ext; intro z
    simp only [LinearMap.neg_apply]
    exact interForm_neg_fundamental ℤ X k k c y z
  rw [ratInterForm, ratInterForm, h, baseChangeBilin_neg]

/-! ## The signature -/

/-- **The signature of a closed oriented `2k`-manifold**, from an integral fundamental class
`c ∈ H_{2k}(X;ℤ)`: the signature of the middle intersection form `y ↦ ⟨y ⌣ y, c⟩`, rationalised.

For a closed oriented smooth `4`-manifold take `k = 2`; for our closed `8`-manifold `X` take
`k = 4`. -/
noncomputable def sigma (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k)) : ℤ :=
  signature (quadOfBilin (ratInterForm k X c))

/-- **The signature from a `ℚ`-coefficient fundamental class**: the same definition, phrased for
callers who have `H^*(X;ℚ)` rather than `H^*(X;ℤ)`.  For finitely generated cohomology this
agrees with `sigma` by the universal coefficient theorem. -/
noncomputable def sigmaQ (k : ℕ) (X : SSet) (c : (chainC ℚ X).homology (k + k)) : ℤ :=
  signature (interQuad ℚ X k c)

/-- **The signature from a `ℚ`-coefficient fundamental class, on a spanning class.**  If
`H^k(X;ℚ)` is generated by a single class `x` with `⟨x ⌣ x, c⟩ = m ≠ 0`, then `σ(X) = sign m`.
This is `sigma_of_span_singleton` for the `ℚ`-coefficient definition `sigmaQ`. -/
theorem sigmaQ_of_span_singleton (k : ℕ) (X : SSet) (c : (chainC ℚ X).homology (k + k))
    (x : (cochainC ℚ X).homology k) (hx : Submodule.span ℚ {x} = ⊤) {m : ℚ}
    (hm : interForm ℚ X k k c x x = m) (hm0 : m ≠ 0) :
    sigmaQ k X c = if 0 < m then 1 else -1 := by
  rw [sigmaQ]
  exact signature_of_span_singleton (interQuad ℚ X k c) x hx (by rw [interQuad_apply, hm]) hm0

/-- **Reversing the orientation negates the signature from a `ℚ`-coefficient fundamental
class.** -/
@[simp] theorem sigmaQ_neg_fundamental (k : ℕ) (X : SSet) (c : (chainC ℚ X).homology (k + k)) :
    sigmaQ k X (-c) = -sigmaQ k X c := by
  rw [sigmaQ, sigmaQ, interQuad_neg_fundamental, signature_neg]

/-- **Reversing the orientation negates the signature**: `σ(-M) = -σ(M)`. -/
@[simp] theorem sigma_neg_fundamental (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k)) :
    sigma k X (-c) = -sigma k X c := by
  simp only [sigma]
  rw [ratInterForm_neg_fundamental, quadOfBilin_neg, signature_neg]

/-- **The signature of a `1 × 1` intersection form.**  If the middle cohomology `H^k(X;ℤ)` is
generated by a single class `x` and the middle self-intersection is `m = ⟨x ⌣ x, c⟩ ≠ 0`, then the
rationalised middle cohomology is one-dimensional and the intersection form is the `1 × 1` form
`(m)`; hence `σ(X) = sign m`.

This is the concrete form in which the signature of the closed `8`-manifold `X = D(ξ) ∪_F D⁸` is
computed (see `Submission/Work/SignatureBordism/Capped.lean`). -/
theorem sigma_of_span_singleton (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k))
    (x : (cochainC ℤ X).homology k) (hx : Submodule.span ℤ {x} = ⊤) {m : ℤ}
    (hm : interForm ℤ X k k c x x = m) (hm0 : m ≠ 0) :
    sigma k X c = if 0 < m then 1 else -1 := by
  have hspan : Submodule.span ℚ {((1 : ℚ) ⊗ₜ[ℤ] x : ratCohomology k X)} = ⊤ :=
    span_tmul_one x hx
  have hQ : quadOfBilin (ratInterForm k X c) ((1 : ℚ) ⊗ₜ[ℤ] x) = (m : ℚ) := by
    rw [quadOfBilin_apply, ratInterForm, baseChangeBilin_tmul, hm]
    ring
  have hcast : ((m : ℚ) ≠ 0) := by exact_mod_cast hm0
  rw [sigma, signature_of_span_singleton _ _ hspan hQ hcast]
  by_cases h : 0 < m
  · rw [if_pos h, if_pos (by exact_mod_cast h)]
  · rw [if_neg h, if_neg (by exact_mod_cast h)]

/-- The `+1` case of `sigma_of_span_singleton`. -/
theorem sigma_eq_one_of_span_singleton (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k))
    (x : (cochainC ℤ X).homology k) (hx : Submodule.span ℤ {x} = ⊤)
    (hm : interForm ℤ X k k c x x = 1) : sigma k X c = 1 := by
  rw [sigma_of_span_singleton k X c x hx hm one_ne_zero]
  norm_num

/-- **The signature of a unimodular `1 × 1` middle form.**  If the middle cohomology `H^k(X;ℤ)` is
generated by `x` and `⟨x ⌣ x, c⟩ = m` with `m = ±1`, then `σ(X) = m`: this is the form in which
the endgame uses the signature (`σ(X) = m`, with `m = ⟨x ⌣ x, [X]⟩ = ±1`). -/
theorem sigma_eq_of_span_singleton_of_unimodular (k : ℕ) (X : SSet)
    (c : (chainC ℤ X).homology (k + k)) (x : (cochainC ℤ X).homology k)
    (hx : Submodule.span ℤ {x} = ⊤) {m : ℤ} (hm : interForm ℤ X k k c x x = m)
    (hm1 : m = 1 ∨ m = -1) : sigma k X c = m := by
  have hm0 : m ≠ 0 := by rcases hm1 with h | h <;> rw [h] <;> norm_num
  have h2 := sigma_of_span_singleton k X c x hx hm hm0
  rcases hm1 with h1 | h1
  · rw [h1] at h2 ⊢; simpa using h2
  · rw [h1] at h2 ⊢; simpa using h2

/-- The `-1` case of `sigma_of_span_singleton`. -/
theorem sigma_eq_neg_one_of_span_singleton (k : ℕ) (X : SSet) (c : (chainC ℤ X).homology (k + k))
    (x : (cochainC ℤ X).homology k) (hx : Submodule.span ℤ {x} = ⊤)
    (hm : interForm ℤ X k k c x x = -1) : sigma k X c = -1 := by
  rw [sigma_of_span_singleton k X c x hx hm (by norm_num)]
  norm_num

end

end Work.SignatureBordism
