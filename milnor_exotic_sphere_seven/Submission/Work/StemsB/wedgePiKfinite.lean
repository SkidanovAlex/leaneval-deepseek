/-!
# `π_i` of a finite wedge of `k`-spheres: connectivity and finite generation

`Work.StemsB.wedgePiKfinite` records the two elementary properties of the homotopy groups of the
wedge `wX (k-2) S` of `|S|` copies of the `k`-sphere (`k ≥ 2`, `S` finite):

* it is `(k-1)`-connected, i.e. `π_i = 0` for `i < k`;
* `π_k` is finitely generated as an abelian group (`Module.Finite ℤ`).

Both are immediate from the cell structure already built in `Work.StemsB.wedgeGenerate`:

* the connectivity is `Work.StemsB.wedge_pi_subsingleton` (the wedge `wX n S` is `(n+1)`-connected,
  with `n = k - 2`);
* the finite generation comes from `Work.StemsB.wedge_finite_generate_pi`, which says that `π_{n+2}`
  is generated (as a group) by the finitely many cell classes `Work.StemsB.wCellClass S`; a group
  generated by a finite set is a finitely generated `ℤ`-module
  (`Work.StemsB.moduleFinite_additive_of_closure_range`).

The remaining bookkeeping is the transport of `π_{k-2+2}` to `π_k`
(`Work.StemsB.wedgePiIndexCast`, an equality of the cube index).

## Note on the statement

The request spells the finiteness predicate `Module.Module.Finite` (the namespace `Module` doubled);
as written that identifier does not exist and the declaration would not even elaborate.  The
`abbrev` `Module.Module.Finite` introduced below is *definitionally* `Module.Finite`, so the
statement below is literally the requested one and means exactly the intended proposition
(`Module.Finite ℤ (Additive (HomotopyGroup (Fin k) …))`).
-/

set_option linter.dupNamespace false
set_option linter.style.haveILetI false

/-- Alias making the recorded spelling `Module.Module.Finite` elaborate; it is definitionally
`Module.Finite`. -/
abbrev Module.Module.Finite (R : Type*) (M : Type*) [Semiring R] [AddCommMonoid M] [Module R M] :
    Prop := _root_.Module.Finite R M

namespace Work.StemsB

/-- **A group generated by a finite set is a finitely generated `ℤ`-module.**

If `v : S → G` has finite domain and `G` is the closure of `Set.range v`, then `Additive G` is a
finite `ℤ`-module.  The `ℤ`-span of the generators is all of `Additive G` (induction on the
closure), and it is finitely generated because `S` is finite. -/
theorem moduleFinite_additive_of_closure_range {G : Type*} [CommGroup G] {S : Type*} [Fintype S]
    (v : S → G) (h : Subgroup.closure (Set.range v) = ⊤) : Module.Finite ℤ (Additive G) := by
  have key : ∀ y : G, y ∈ Subgroup.closure (Set.range v) →
      (Additive.ofMul y : Additive G) ∈
        Submodule.span ℤ (Set.range (fun s : S => (Additive.ofMul (v s) : Additive G))) := by
    intro y hy
    induction hy using Subgroup.closure_induction with
    | mem z hz => exact Submodule.subset_span (by obtain ⟨s, rfl⟩ := hz; exact ⟨s, rfl⟩)
    | one => exact Submodule.zero_mem _
    | mul a b ha hb iha ihb =>
        change (Additive.ofMul a + Additive.ofMul b : Additive G) ∈ _
        exact Submodule.add_mem _ iha ihb
    | inv a ha iha =>
        change (- Additive.ofMul a : Additive G) ∈ _
        exact Submodule.neg_mem _ iha
  have hspan :
      Submodule.span ℤ (Set.range (fun s : S => (Additive.ofMul (v s) : Additive G))) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    exact key (Additive.toMul x) (by rw [h]; exact Subgroup.mem_top _)
  have hfg : (⊤ : Submodule ℤ (Additive G)).FG := by
    rw [← hspan]
    exact Submodule.fg_span (Set.finite_range _)
  haveI : Module.Finite ℤ (↥(⊤ : Submodule ℤ (Additive G))) := Module.Finite.iff_fg.mpr hfg
  exact Module.Finite.equiv (Submodule.topEquiv (R := ℤ) (M := Additive G))

/-- **Transport of homotopy groups along an equality of the cube index.** -/
noncomputable def wedgePiIndexCast {X : Type*} [TopologicalSpace X] (x : X) {n m : ℕ} (h : n = m)
    [Nontrivial (Fin n)] [Nontrivial (Fin m)] :
    HomotopyGroup (Fin n) X x ≃* HomotopyGroup (Fin m) X x := by
  subst h
  exact MulEquiv.refl _

theorem wedgePiKfinite (k : ℕ) (hk : 2 ≤ k) (S : Type) [Fintype S] :
    (∀ i : ℕ, i < k → Subsingleton (HomotopyGroup (Fin i) (Work.Serre.Wedge.wX (k - 2) S)
      (Work.Serre.Wedge.wB (k - 2) S))) ∧
    (letI : k.AtLeastTwo := ⟨hk⟩
     Module.Module.Finite ℤ (Additive (HomotopyGroup (Fin k) (Work.Serre.Wedge.wX (k - 2) S)
      (Work.Serre.Wedge.wB (k - 2) S)))) := by
  refine ⟨fun i hi => wedge_pi_subsingleton (k - 2) S i (by omega), ?_⟩
  haveI : k.AtLeastTwo := ⟨hk⟩
  -- `k = (k-2) + 2`, so `π_k` of the wedge is `π_{n+2}` for `n = k - 2`
  have hk2 : k - 2 + 2 = k := by omega
  -- `π_{n+2}` is generated by the finitely many cell classes
  have hclos : Subgroup.closure (Set.range (fun s : S => wCellClass (n := k - 2) S s)) = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    exact wedge_finite_generate_pi (k - 2) S x
  have hfin : Module.Finite ℤ (Additive (HomotopyGroup (Fin (k - 2 + 2))
      (Work.Serre.Wedge.wX (k - 2) S) (Work.Serre.Wedge.wB (k - 2) S))) :=
    moduleFinite_additive_of_closure_range
      (fun s : S => wCellClass (n := k - 2) S s) hclos
  -- transport along the index equality `k - 2 + 2 = k`
  exact Module.Finite.equiv
    ((wedgePiIndexCast (Work.Serre.Wedge.wB (k - 2) S) hk2).toAdditive.toIntLinearEquiv)

end Work.StemsB
