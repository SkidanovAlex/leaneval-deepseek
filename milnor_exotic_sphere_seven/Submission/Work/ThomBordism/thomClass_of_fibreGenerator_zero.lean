/-!
# A fibre generator in degree `0` is a Thom class

`Work.ThomBordism.thomClass_of_fibreGenerator_zero`: for a real bundle `Z → B` whose model fibre is
`0`-dimensional, a class `σ ∈ H^0(E, E∖0;ℤ)` restricting to a generator of `H^0` on every fibre pair
is a *Thom class*: the Thom map `x ↦ π^*(x) ⌣ σ` is bijective in every degree.

Since the fibre is `0`-dimensional the complement of the zero section is empty
(`Work.ThomBordism.zeroComplement_eq_empty`), so `H^*(E,E∖0;ℤ) = H^*(E;ℤ)` and `σ` corresponds to a
class `c ∈ H^0(E;ℤ)`.  The fibre-generator condition says exactly that `c` evaluates to `±1` at
every point (the fibre pair of a rank-`0` bundle is the pair `(pt,∅)`), hence `c ⌣ c = 1`: the class
`c` is a *unit* of the ring `H^*(E;ℤ)`.  Multiplication by a unit is bijective, and the Thom map is
`x ↦ π^*(x) ⌣ c`, i.e. the composite of the (bijective) pullback `π^*` with the (bijective)
multiplication by `c`.
-/

namespace Work.ThomBordism

open Work.TangentClasses

noncomputable section

variable {B : Type} [TopologicalSpace B] {F : Type}
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {ι : Type}

/-! ## Two small helpers -/

/-- The image of a generator under a surjective `ℤ`-linear map is again a generator. -/
private theorem span_singleton_top_of_surjective {M N : Type*} [AddCommGroup M] [Module ℤ M]
    [AddCommGroup N] [Module ℤ N] (f : M →ₗ[ℤ] N) (hf : Function.Surjective f) {a : M}
    (h : Submodule.span ℤ {a} = ⊤) : Submodule.span ℤ {f a} = ⊤ := by
  have h1 : Submodule.span ℤ {f a} = Submodule.map f (Submodule.span ℤ {a}) := by
    rw [Submodule.map_span, Set.image_singleton]
  rw [h1, h, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr hf

/-- **A generator of `H⁰(X;ℤ)` evaluates to `±1` at every point.**

`H⁰(X;ℤ)` is generated by the class `1` whose evaluation at a point is `1`
(`Work.Thom.ptEv_one`), so the evaluation map `ptEvLM p : H⁰(X;ℤ) → ℤ` is *surjective*.  Hence the
image of a generator is a generator of the `ℤ`-module `ℤ`, i.e. `±1`
(`Submodule.mem_span_singleton` + `Int.eq_one_or_neg_one_of_mul_eq_one`). -/
private theorem ptEv_eq_pm_one_of_span_top {X : Type} [TopologicalSpace X]
    (p : X) (z : Work.Thom.Coh ℤ 0 X) (hz : Submodule.span ℤ {z} = ⊤) :
    Work.Thom.ptEv p z = 1 ∨ Work.Thom.ptEv p z = -1 := by
  have h1mem : (1 : ℤ) ∈ LinearMap.range (Work.Thom.ptEvLM p) :=
    ⟨Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of X)), Work.Thom.ptEv_one p⟩
  have hspan1 : Submodule.span ℤ ({(1 : ℤ)} : Set ℤ) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro y
    rw [Submodule.mem_span_singleton]
    exact ⟨y, by rw [smul_eq_mul, mul_one]⟩
  have hle : Submodule.span ℤ ({(1 : ℤ)} : Set ℤ) ≤ LinearMap.range (Work.Thom.ptEvLM p) :=
    Submodule.span_le.mpr (by
      intro t ht
      rw [Set.mem_singleton_iff] at ht
      rw [ht]; exact h1mem)
  have hsurj : Function.Surjective (Work.Thom.ptEvLM p) :=
    LinearMap.range_eq_top.mp (top_le_iff.mp (hspan1 ▸ hle))
  have hspan : Submodule.span ℤ ({(Work.Thom.ptEv p z)} : Set ℤ) = ⊤ := by
    have h1 : Submodule.map (Work.Thom.ptEvLM p)
        (Submodule.span ℤ ({z} : Set (Work.Thom.Coh ℤ 0 X)))
        = Submodule.span ℤ ({(Work.Thom.ptEv p z)} : Set ℤ) := by
      rw [Submodule.map_span, Set.image_singleton]
      rfl
    rw [← h1, hz, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr hsurj
  have hmem : (1 : ℤ) ∈ Submodule.span ℤ ({(Work.Thom.ptEv p z)} : Set ℤ) := by
    rw [hspan]; trivial
  obtain ⟨m, hm⟩ := Submodule.mem_span_singleton.mp hmem
  rw [smul_eq_mul] at hm
  exact Int.eq_one_or_neg_one_of_mul_eq_one (by rw [mul_comm]; exact hm)

/-- **Cupping with an involution of `H⁰` is bijective in every degree** (the whole-space version of
`Work.ThomBordism.bijective_cup_of_involution`). -/
private theorem bijective_cup_right {X : Type} [TopologicalSpace X] (c : Work.Thom.Coh ℤ 0 X)
    (hc : Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of X)) 0 0 c c
      = Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of X))) (k : ℕ) :
    Function.Bijective (fun x : Work.Thom.Coh ℤ k X =>
      Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of X)) k 0 x c) := by
  have hinv : ∀ y : Work.Thom.Coh ℤ k X,
      Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of X)) k 0
        (Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of X)) k 0 y c) c = y := by
    intro y
    have h1 := Work.Cohomology.cupH'_assoc ℤ (TopCat.toSSet.obj (TopCat.of X)) k 0 0 y c c
    rw [hc] at h1
    rw [Work.Cohomology.cupH'_one_right] at h1
    exact h1
  refine ⟨fun x y hxy => ?_, fun y => ⟨Work.Cohomology.cupH' ℤ
    (TopCat.toSSet.obj (TopCat.of X)) k 0 y c, hinv y⟩⟩
  have h2 := congrArg (fun w => Work.Cohomology.cupH' ℤ
    (TopCat.toSSet.obj (TopCat.of X)) k 0 w c) hxy
  rwa [hinv x, hinv y] at h2

/-! ## The main theorem -/

theorem thomClass_of_fibreGenerator_zero {B : Type} [TopologicalSpace B] {F : Type}
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {ι : Type}
    (Z : Work.TangentClasses.RealBundle B F ι) (σ : Work.Thom.OpenThom Z 0)
    (hn : 0 = Module.finrank ℝ F) (h : Work.ThomBordism.IsFibreGenerator Z 0 σ) :
    ∀ k : ℕ, Function.Bijective (Work.Thom.thomMap Z 0 σ k) := by
  haveI hF : Subsingleton F := subsingleton_of_finrank_zero hn.symm
  have hA : Work.Thom.zeroComplement Z = ∅ := zeroComplement_eq_empty Z
  have hrel : ∀ n, Function.Bijective
      ((Work.Thom.relToAbs ℤ (Work.Thom.zeroComplement Z) n).hom) :=
    fun n => bijective_relToAbs_of_eq_empty hA n
  -- the absolute class underlying `σ`
  let c : Work.Thom.Coh ℤ 0 Z.TotalSpace :=
    (Work.Thom.relToAbs ℤ (Work.Thom.zeroComplement Z) 0).hom σ
  -- the fibre-generator condition: `c` evaluates to `±1` at every point of `E`
  have hptE : ∀ e : Z.TotalSpace, Work.Thom.ptEv e c = 1 ∨ Work.Thom.ptEv e c = -1 := by
    intro e
    have hz : Submodule.span ℤ {fibreRes Z e.1 0 σ} = ⊤ := h e.1
    have hzrel := span_singleton_top_of_surjective
      ((Work.Thom.relToAbs ℤ (fibrePunctSub Z e.1) 0).hom)
      (bijective_relToAbs_of_eq_empty (fibrePunctSub_eq_empty Z e.1) 0).2 hz
    have hchain : ((Work.Thom.relToAbs ℤ (fibrePunctSub Z e.1) 0).hom (fibreRes Z e.1 0 σ))
        = (Work.Thom.CohMap (fibreIncl Z e.1) ℤ 0).hom c :=
      Work.Thom.relCohMap_relToAbs_apply (fibreIncl Z e.1) (fibrePunctSub Z e.1)
        (Work.Thom.zeroComplement Z) (fibreIncl_mem Z e.1) ℤ 0 σ
    have hz' : Submodule.span ℤ
        {((Work.Thom.CohMap (fibreIncl Z e.1) ℤ 0).hom c)} = ⊤ := by
      rw [← hchain]; exact hzrel
    let x : ↥(fibre Z e.1) := ⟨e, rfl⟩
    have hptx : Work.Thom.ptEv x ((Work.Thom.CohMap (fibreIncl Z e.1) ℤ 0).hom c) = 1 ∨
        Work.Thom.ptEv x ((Work.Thom.CohMap (fibreIncl Z e.1) ℤ 0).hom c) = -1 :=
      ptEv_eq_pm_one_of_span_top x _ hz'
    have hpull : Work.Thom.ptEv e c
        = Work.Thom.ptEv x ((Work.Thom.CohMap (fibreIncl Z e.1) ℤ 0).hom c) := by
      have h2 := Work.Thom.ptEv_pullback (fibreIncl Z e.1) x c
      rw [show fibreIncl Z e.1 x = e from rfl] at h2
      exact h2.symm
    rw [hpull]; exact hptx
  -- hence `c` is an involution of the cohomology ring
  have hcc : Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) 0 0 c c
      = Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) := by
    refine Work.Thom.ptEv_ext (fun p => ?_)
    rcases hptE p with h1 | h1
    · rw [Work.Thom.ptEv_cup, h1, mul_one, Work.Thom.ptEv_one]
    · rw [Work.Thom.ptEv_cup, h1, Work.Thom.ptEv_one]; norm_num
  intro k
  -- the Thom map parallelises as `relToAbs⁻¹ ∘ (· ⌣ c) ∘ π^*`
  have key : ∀ x : Work.Thom.Coh ℤ k B,
      (Work.Thom.relToAbs ℤ (Work.Thom.zeroComplement Z) (k + 0)).hom
          (Work.Thom.thomMap Z 0 σ k x)
        = Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) k 0
            ((Work.Thom.CohMap (Work.Thom.bundleProj Z) ℤ k).hom x) c := by
    intro x
    rw [Work.Thom.thomMap_apply]
    exact Work.Thom.mixedCup_relToAbs (Work.Thom.zeroComplement Z) k 0
      ((Work.Thom.CohMap (Work.Thom.bundleProj Z) ℤ k).hom x) σ
  have keyk : ∀ x : Work.Thom.Coh ℤ k B,
      (Work.Thom.relToAbs ℤ (Work.Thom.zeroComplement Z) k).hom
          (Work.Thom.thomMap Z 0 σ k x)
        = Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) k 0
            ((Work.Thom.CohMap (Work.Thom.bundleProj Z) ℤ k).hom x) c := fun x => key x
  constructor
  · intro x y hxy
    have h3 : Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) k 0
          ((Work.Thom.CohMap (Work.Thom.bundleProj Z) ℤ k).hom x) c
        = Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) k 0
          ((Work.Thom.CohMap (Work.Thom.bundleProj Z) ℤ k).hom y) c := by
      rw [← keyk x, ← keyk y, hxy]
    exact (Work.Thom.bijective_CohMap_bundleProj Z k).1 ((bijective_cup_right c hcc k).1 h3)
  · intro z
    -- first undo the multiplication by `c`, then the pullback `π^*`
    obtain ⟨w, hw⟩ := (bijective_cup_right c hcc k).2
      ((Work.Thom.relToAbs ℤ (Work.Thom.zeroComplement Z) k).hom z)
    have hw' : Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of Z.TotalSpace)) k 0 w c
        = (Work.Thom.relToAbs ℤ (Work.Thom.zeroComplement Z) k).hom z := hw
    obtain ⟨x, hx⟩ := (Work.Thom.bijective_CohMap_bundleProj Z k).2 w
    refine ⟨x, ?_⟩
    apply (hrel k).1
    rw [keyk x, hx, hw']

end

end Work.ThomBordism
