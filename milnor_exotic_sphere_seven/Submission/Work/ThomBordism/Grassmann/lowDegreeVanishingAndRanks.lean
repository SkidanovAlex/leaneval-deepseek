/-!
# The low-degree rational cohomology of the oriented Grassmannian: vanishing and ranks

For `k, m ≥ 10`, with `G = G̃r_k(ℝ^{k+m})` the oriented Grassmannian,

* `H^j(G;ℚ) = 0` for `j ∈ lowDegrees = {1,2,3,5,6,7}`,
* `H^4(G;ℚ)` is one-dimensional (finite dimensional), generated by `p₁(γ)`,
* `H^8(G;ℚ)` is two-dimensional (finite dimensional), generated by `p₁(γ)²` and `p₂(γ)`.

The vanishing clause is `Work.ThomBordism.Grassmann.grassmannianLowDegreeVanishing`.  The `≤`
halves of the two rank statements are the Gysin-window computation of
`Submission/Work/ThomBordism/Grassmann/degreeEightFinrankLeTwo.lean` re-done as statements about
`Module.rank` (its `finrank` form does not bound `Module.rank` without finiteness).  The `≥` halves
are the non-vanishing of the Pontryagin classes: `p₁(γ) ≠ 0` (`Probe2.p1RatNeZero`) and the
independence of `p₁(γ)², p₂(γ)` (the two probes of `LowDegree/p1SqProbe.lean` and
`LowDegree/p2ProbeCP2xCP2.lean`, assembled by `linearIndependent_of_probes`).  Finite
dimensionality then follows from the rank equalities.
-/

namespace Work.ThomBordism.Grassmann

open Work.TangentClasses Work.SignatureBordism

noncomputable section

/-! ## Cardinal arithmetic -/

/-- `κ + 1 ≤ 1 + 1` forces `κ ≤ 1`. -/
theorem cardinal_le_one_of_add_one_le_two {c : Cardinal} (h : c + 1 ≤ 1 + 1) : c ≤ 1 :=
  (Cardinal.add_le_add_iff_of_lt_aleph0 (γ := (1 : Cardinal)) (by norm_num)).mp h

/-! ## Small degree computations

These are the local estimates inside the proof of `Deg8.degreeEight_finrank_nine_le_two`
(`Submission/Work/ThomBordism/Grassmann/degreeEightFinrankLeTwo.lean`), exported here as
statements about `Module.rank` so that they can be combined with the descent in `k`. -/

/-- `H²(G̃r₂(ℝ^{2+m});ℚ)` is at most one-dimensional. -/
theorem rank_two_two_le_one (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 2 2) ≤ 1 := by
  have hm1 : 1 ≤ m := by omega
  calc Module.rank ℚ (Deg8.R m 2 2)
      ≤ Module.rank ℚ (Deg8.R m 0 2) + Module.rank ℚ (Deg8.S m 2 2) :=
        Deg8.win_le 2 m 2 le_rfl
    _ = Module.rank ℚ (Deg8.R m 0 2) + Module.rank ℚ (Deg8.R m 2 1) := by
        rw [Deg8.rank_S_eq_R 2 m 2 (by norm_num) (by norm_num) (by omega)]
    _ = Module.rank ℚ (Deg8.R m 0 2) := by
        rw [Deg8.rank_one_eq_zero m 2 (by norm_num) (by omega), add_zero]
    _ = 1 := Deg8.rank_zero_eq_one 2 m hm1

/-- `H²(G̃r₃(ℝ^{3+m});ℚ) = 0`. -/
theorem rank_two_three_zero (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 2 3) = 0 := by
  have hm1 : 1 ≤ m := by omega
  have hd := Deg8.rank_S_degen 3 m (by norm_num) (by norm_num)
  rw [Deg8.rank_S_eq_R 3 m 2 (by norm_num) (by norm_num) (by omega)] at hd
  rw [Deg8.rank_zero_eq_one 3 m hm1] at hd
  have hthis : Module.rank ℚ (Deg8.R m 2 3) + 1 ≤ (0 : Cardinal) + 1 := by
    rw [zero_add]
    calc Module.rank ℚ (Deg8.R m 2 3) + 1 = Module.rank ℚ (Deg8.R m 2 2) := hd.symm
      _ ≤ 1 := rank_two_two_le_one m hm
  have hle : Module.rank ℚ (Deg8.R m 2 3) ≤ 0 :=
    (Cardinal.add_le_add_iff_of_lt_aleph0 (γ := (1 : Cardinal)) (by norm_num)).mp hthis
  exact le_antisymm hle (zero_le)

/-- `H²(G̃r₆(ℝ^{6+m});ℚ) = 0`. -/
theorem rank_two_six_zero (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 2 6) = 0 := by
  have hd42 : Module.rank ℚ (Deg8.R m 2 4) = Module.rank ℚ (Deg8.R m 2 3) := by
    rw [Deg8.rank_eq_of_descent 4 m 2 (by norm_num),
      Deg8.rank_S_eq_R 4 m 2 (by norm_num) (by norm_num) (by omega)]
  have hd52 : Module.rank ℚ (Deg8.R m 2 5) = Module.rank ℚ (Deg8.R m 2 4) := by
    rw [Deg8.rank_eq_of_descent 5 m 2 (by norm_num),
      Deg8.rank_S_eq_R 5 m 2 (by norm_num) (by norm_num) (by omega)]
  have hd62 : Module.rank ℚ (Deg8.R m 2 6) = Module.rank ℚ (Deg8.R m 2 5) := by
    rw [Deg8.rank_eq_of_descent 6 m 2 (by norm_num),
      Deg8.rank_S_eq_R 6 m 2 (by norm_num) (by norm_num) (by omega)]
  rw [hd62, hd52, hd42, rank_two_three_zero m hm]

/-- `H⁴(G̃r₂(ℝ^{2+m});ℚ)` is at most one-dimensional. -/
theorem rank_four_two_le_one (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 4 2) ≤ 1 := by
  calc Module.rank ℚ (Deg8.R m 4 2)
      ≤ Module.rank ℚ (Deg8.R m 2 2) + Module.rank ℚ (Deg8.S m 4 2) :=
        Deg8.win_le 2 m 4 (by norm_num)
    _ = Module.rank ℚ (Deg8.R m 2 2) + Module.rank ℚ (Deg8.R m 4 1) := by
        rw [Deg8.rank_S_eq_R 2 m 4 (by norm_num) (by norm_num) (by omega)]
    _ = Module.rank ℚ (Deg8.R m 2 2) := by
        rw [Deg8.rank_one_eq_zero m 4 (by norm_num) (by omega), add_zero]
    _ ≤ 1 := rank_two_two_le_one m hm

/-- `H⁴(G̃r₃(ℝ^{3+m});ℚ)` is at most one-dimensional. -/
theorem rank_four_three_le_one (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 4 3) ≤ 1 :=
  le_trans (Deg8.rank_le_of_odd m 4 3 (by norm_num) (by norm_num) (by norm_num) (by omega))
    (rank_four_two_le_one m hm)

/-- `H⁴(G̃r₄(ℝ^{4+m});ℚ)` is at most two-dimensional. -/
theorem rank_four_four_le_two (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 4 4) ≤ 2 := by
  have hm1 : 1 ≤ m := by omega
  calc Module.rank ℚ (Deg8.R m 4 4)
      ≤ Module.rank ℚ (Deg8.R m 0 4) + Module.rank ℚ (Deg8.S m 4 4) :=
        Deg8.win_le 4 m 4 le_rfl
    _ = Module.rank ℚ (Deg8.R m 0 4) + Module.rank ℚ (Deg8.R m 4 3) := by
        rw [Deg8.rank_S_eq_R 4 m 4 (by norm_num) (by norm_num) (by omega)]
    _ = 1 + Module.rank ℚ (Deg8.R m 4 3) := by rw [Deg8.rank_zero_eq_one 4 m hm1]
    _ ≤ 2 := by
        have := rank_four_three_le_one m hm
        rw [show (2 : Cardinal) = 1 + 1 from by norm_num]
        exact add_le_add le_rfl this

/-- `H⁴(G̃r₅(ℝ^{5+m});ℚ)` is at most one-dimensional. -/
theorem rank_four_five_le_one (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 4 5) ≤ 1 := by
  have hm1 : 1 ≤ m := by omega
  have h445 : Module.rank ℚ (Deg8.R m 4 4) = Module.rank ℚ (Deg8.R m 4 5) + 1 := by
    have hd := Deg8.rank_S_degen 5 m (by norm_num) (by norm_num)
    rw [Deg8.rank_S_eq_R 5 m 4 (by norm_num) (by norm_num) (by omega)] at hd
    rw [Deg8.rank_zero_eq_one 5 m hm1] at hd
    exact hd
  have hthis : Module.rank ℚ (Deg8.R m 4 5) + 1 ≤ 1 + 1 := by
    rw [← h445]
    simpa only [show (2 : Cardinal) = 1 + 1 from by norm_num] using rank_four_four_le_two m hm
  exact cardinal_le_one_of_add_one_le_two hthis

/-- `H⁸(G̃r₃(ℝ^{3+m});ℚ)` is at most one-dimensional. -/
theorem rank_eight_three_le_one (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 8 3) ≤ 1 := by
  have hm1 : 1 ≤ m := by omega
  have hR1 : ∀ j : ℕ, 1 ≤ j → j ≤ 8 → Module.rank ℚ (Deg8.R m j 1) = 0 :=
    fun j hj _ => Deg8.rank_one_eq_zero m j hj (by omega)
  have hV : ∀ k : ℕ, Module.rank ℚ (Deg8.R m 0 k) = 1 := fun k => Deg8.rank_zero_eq_one k m hm1
  have hi82 : Module.rank ℚ (Deg8.S m 8 2) = Module.rank ℚ (Deg8.R m 8 1) :=
    Deg8.rank_S_eq_R 2 m 8 (by norm_num) (by norm_num) (by omega)
  have hi62 : Module.rank ℚ (Deg8.S m 6 2) = Module.rank ℚ (Deg8.R m 6 1) :=
    Deg8.rank_S_eq_R 2 m 6 (by norm_num) (by norm_num) (by omega)
  calc Module.rank ℚ (Deg8.R m 8 3)
      ≤ Module.rank ℚ (Deg8.R m 8 2) :=
        Deg8.rank_le_of_odd m 8 3 (by norm_num) (by norm_num) (by norm_num) (by omega)
    _ ≤ Module.rank ℚ (Deg8.R m 6 2) + Module.rank ℚ (Deg8.S m 8 2) :=
        Deg8.win_le 2 m 8 (by norm_num)
    _ = Module.rank ℚ (Deg8.R m 6 2) + Module.rank ℚ (Deg8.R m 8 1) := by rw [hi82]
    _ = Module.rank ℚ (Deg8.R m 6 2) := by rw [hR1 8 (by norm_num) (by norm_num), add_zero]
    _ ≤ Module.rank ℚ (Deg8.R m 4 2) + Module.rank ℚ (Deg8.S m 6 2) :=
        Deg8.win_le 2 m 6 (by norm_num)
    _ = Module.rank ℚ (Deg8.R m 4 2) + Module.rank ℚ (Deg8.R m 6 1) := by rw [hi62]
    _ = Module.rank ℚ (Deg8.R m 4 2) := by rw [hR1 6 (by norm_num) (by norm_num), add_zero]
    _ ≤ 1 := rank_four_two_le_one m hm

/-- `rank H⁸(G̃r₉(ℝ^{9+m});ℚ) ≤ 2`. -/
theorem rank_eight_nine_le_two (m : ℕ) (hm : 10 ≤ m) : Module.rank ℚ (Deg8.R m 8 9) ≤ 2 := by
  have hm1 : 1 ≤ m := by omega
  have hT9 : (2 : ℤ) • (tautologicalThomClass 9 m).eulerClass = 0 :=
    eulerClassOddRank (tautologicalBundle 9 m) (by simp [RealBundle.rank])
      (tautologicalThomClass 9 m) (by norm_num)
  have hT5 : (2 : ℤ) • (tautologicalThomClass 5 m).eulerClass = 0 :=
    eulerClassOddRank (tautologicalBundle 5 m) (by simp [RealBundle.rank])
      (tautologicalThomClass 5 m) (by norm_num)
  have hV : ∀ k : ℕ, Module.rank ℚ (Deg8.R m 0 k) = 1 := fun k => Deg8.rank_zero_eq_one k m hm1
  have hR1 : ∀ j : ℕ, 1 ≤ j → j ≤ 8 → Module.rank ℚ (Deg8.R m j 1) = 0 :=
    fun j hj _ => Deg8.rank_one_eq_zero m j hj (by omega)
  -- the incidence steps
  have hi98 : Module.rank ℚ (Deg8.S m 8 9) = Module.rank ℚ (Deg8.R m 8 8) :=
    Deg8.rank_S_eq_R 9 m 8 (by norm_num) (by norm_num) (by omega)
  have hi86 : Module.rank ℚ (Deg8.S m 8 6) = Module.rank ℚ (Deg8.R m 8 5) :=
    Deg8.rank_S_eq_R 6 m 8 (by norm_num) (by norm_num) (by omega)
  have hi85 : Module.rank ℚ (Deg8.S m 8 5) = Module.rank ℚ (Deg8.R m 8 4) :=
    Deg8.rank_S_eq_R 5 m 8 (by norm_num) (by norm_num) (by omega)
  have hi84 : Module.rank ℚ (Deg8.S m 8 4) = Module.rank ℚ (Deg8.R m 8 3) :=
    Deg8.rank_S_eq_R 4 m 8 (by norm_num) (by norm_num) (by omega)
  -- the odd windows at `k = 9`, `7`
  have h98 : Module.rank ℚ (Deg8.R m 8 9) + 1 = Module.rank ℚ (Deg8.R m 8 8) := by
    have hd := Deg8.rank_S_degen 9 m (by norm_num) (by norm_num)
    rw [hi98, hV 9] at hd
    exact hd.symm
  have h87 : Module.rank ℚ (Deg8.R m 8 7) ≤ Module.rank ℚ (Deg8.R m 8 6) :=
    Deg8.rank_le_of_odd m 8 7 (by norm_num) (by norm_num) (by norm_num) (by omega)
  -- the even windows
  have h88 : Module.rank ℚ (Deg8.R m 8 8) ≤ 1 + Module.rank ℚ (Deg8.R m 8 7) := by
    calc Module.rank ℚ (Deg8.R m 8 8)
        ≤ Module.rank ℚ (Deg8.R m 0 8) + Module.rank ℚ (Deg8.S m 8 8) :=
          Deg8.win_le 8 m 8 le_rfl
      _ = Module.rank ℚ (Deg8.R m 0 8) + Module.rank ℚ (Deg8.R m 8 7) := by
          rw [Deg8.rank_S_eq_R 8 m 8 (by norm_num) (by norm_num) (by omega)]
      _ = 1 + Module.rank ℚ (Deg8.R m 8 7) := by rw [hV 8]
  have h86 : Module.rank ℚ (Deg8.R m 8 6) ≤ Module.rank ℚ (Deg8.R m 8 5) := by
    calc Module.rank ℚ (Deg8.R m 8 6)
        ≤ Module.rank ℚ (Deg8.R m 2 6) + Module.rank ℚ (Deg8.S m 8 6) :=
          Deg8.win_le 6 m 8 (by norm_num)
      _ = Module.rank ℚ (Deg8.R m 2 6) + Module.rank ℚ (Deg8.R m 8 5) := by rw [hi86]
      _ = Module.rank ℚ (Deg8.R m 8 5) := by rw [rank_two_six_zero m hm, zero_add]
  have h85 : Module.rank ℚ (Deg8.R m 8 5) + Module.rank ℚ (Deg8.R m 4 5)
      ≤ Module.rank ℚ (Deg8.R m 8 4) := by
    have h : Module.rank ℚ (Deg8.R m 8 5) + Module.rank ℚ (Deg8.R m 4 5)
        ≤ Module.rank ℚ (Deg8.S m 8 5) :=
      Deg8.win_odd_le (tautologicalBundle 5 m) 5 3 (tautologicalThomClass 5 m) hT5
    rw [hi85] at h
    exact h
  have h84 : Module.rank ℚ (Deg8.R m 8 4)
      ≤ Module.rank ℚ (Deg8.R m 4 4) + Module.rank ℚ (Deg8.R m 8 3) := by
    calc Module.rank ℚ (Deg8.R m 8 4)
        ≤ Module.rank ℚ (Deg8.R m 4 4) + Module.rank ℚ (Deg8.S m 8 4) :=
          Deg8.win_le 4 m 8 (by norm_num)
      _ = Module.rank ℚ (Deg8.R m 4 4) + Module.rank ℚ (Deg8.R m 8 3) := by rw [hi84]
  have h445 : Module.rank ℚ (Deg8.R m 4 4) = Module.rank ℚ (Deg8.R m 4 5) + 1 := by
    have hd := Deg8.rank_S_degen 5 m (by norm_num) (by norm_num)
    rw [Deg8.rank_S_eq_R 5 m 4 (by norm_num) (by norm_num) (by omega), hV 5] at hd
    exact hd
  -- the chain
  have h95 : Module.rank ℚ (Deg8.R m 8 9) ≤ Module.rank ℚ (Deg8.R m 8 5) := by
    have hstep : Module.rank ℚ (Deg8.R m 8 9) + 1 ≤ Module.rank ℚ (Deg8.R m 8 5) + 1 := by
      calc Module.rank ℚ (Deg8.R m 8 9) + 1 = Module.rank ℚ (Deg8.R m 8 8) := h98
        _ ≤ 1 + Module.rank ℚ (Deg8.R m 8 7) := h88
        _ ≤ 1 + Module.rank ℚ (Deg8.R m 8 6) := add_le_add le_rfl h87
        _ ≤ 1 + Module.rank ℚ (Deg8.R m 8 5) := add_le_add le_rfl h86
        _ = Module.rank ℚ (Deg8.R m 8 5) + 1 := add_comm _ _
    exact (Cardinal.add_le_add_iff_of_lt_aleph0 (γ := (1 : Cardinal)) (by norm_num)).mp hstep
  have hchain : Module.rank ℚ (Deg8.R m 8 9) + Module.rank ℚ (Deg8.R m 4 5)
      ≤ 2 + Module.rank ℚ (Deg8.R m 4 5) := by
    calc Module.rank ℚ (Deg8.R m 8 9) + Module.rank ℚ (Deg8.R m 4 5)
        ≤ Module.rank ℚ (Deg8.R m 8 5) + Module.rank ℚ (Deg8.R m 4 5) :=
          add_le_add h95 le_rfl
      _ ≤ Module.rank ℚ (Deg8.R m 8 4) := h85
      _ ≤ Module.rank ℚ (Deg8.R m 4 4) + Module.rank ℚ (Deg8.R m 8 3) := h84
      _ = (Module.rank ℚ (Deg8.R m 4 5) + 1) + Module.rank ℚ (Deg8.R m 8 3) := by rw [h445]
      _ ≤ (Module.rank ℚ (Deg8.R m 4 5) + 1) + 1 :=
          add_le_add le_rfl (rank_eight_three_le_one m hm)
      _ = 2 + Module.rank ℚ (Deg8.R m 4 5) := by
          rw [add_assoc, show (1 : Cardinal) + 1 = 2 from by norm_num, add_comm]
  exact (Cardinal.add_le_add_iff_of_lt_aleph0 (γ := Module.rank ℚ (Deg8.R m 4 5))
    (lt_of_le_of_lt (rank_four_five_le_one m hm) (by norm_num))).mp hchain

/-! ## The upper bounds in the stable range -/

/-- **`rank H⁴(G̃r_k(ℝ^{k+m});ℚ) ≤ 1` for `k, m ≥ 10`.** -/
theorem rank_four_le_one (k m : ℕ) (hk : 10 ≤ k) (hm : 10 ≤ m) :
    Module.rank ℚ (Work.SignatureBordism.ratCohomology 4 (sset (OG k m))) ≤ 1 := by
  have hdesc : ∀ t : ℕ, Module.rank ℚ (Deg8.R m 4 (5 + t)) = Module.rank ℚ (Deg8.R m 4 5) := by
    intro t
    induction t with
    | zero => norm_num
    | succ t ih =>
        have h : Module.rank ℚ (Deg8.R m 4 (5 + (t + 1))) = Module.rank ℚ (Deg8.R m 4 (5 + t)) :=
          rankDesc m 4 (5 + (t + 1)) (by omega) (by norm_num) (by omega)
        rw [h, ih]
  obtain ⟨t, rfl⟩ : ∃ t, k = 5 + t := ⟨k - 5, by omega⟩
  rw [hdesc t]
  exact rank_four_five_le_one m hm

/-- **`rank H⁸(G̃r_k(ℝ^{k+m});ℚ) ≤ 2` for `k, m ≥ 10`.** -/
theorem rank_eight_le_two (k m : ℕ) (hk : 10 ≤ k) (hm : 10 ≤ m) :
    Module.rank ℚ (Work.SignatureBordism.ratCohomology 8 (sset (OG k m))) ≤ 2 := by
  have hdesc : ∀ t : ℕ, Module.rank ℚ (Deg8.R m 8 (9 + t)) = Module.rank ℚ (Deg8.R m 8 9) := by
    intro t
    induction t with
    | zero => norm_num
    | succ t ih =>
        have h : Module.rank ℚ (Deg8.R m 8 (9 + (t + 1))) = Module.rank ℚ (Deg8.R m 8 (9 + t)) :=
          rankDesc m 8 (9 + (t + 1)) (by omega) (by norm_num) (by omega)
        rw [h, ih]
  obtain ⟨t, rfl⟩ : ∃ t, k = 9 + t := ⟨k - 9, by omega⟩
  rw [hdesc t]
  exact rank_eight_nine_le_two m hm

/-! ## The lower bounds in the stable range -/

/-- **`1 ≤ rank H⁴`**: the first Pontryagin class of the tautological bundle is non-zero
(`Probe2.p1RatNeZero`). -/
theorem one_le_rank_four (k m : ℕ) (hk : 10 ≤ k) (hm : 10 ≤ m) :
    1 ≤ Module.rank ℚ (Work.SignatureBordism.ratCohomology 4 (sset (OG k m))) := by
  have hne : p1Rat k m ≠ 0 := Probe2.p1RatNeZero k m (by omega) (by omega)
  have hrank0 : Module.rank ℚ (Work.SignatureBordism.ratCohomology 4 (sset (OG k m))) ≠ 0 := by
    intro h0
    obtain ⟨a, ha, hax⟩ := (rank_eq_zero_iff (R := ℚ)).mp h0 (p1Rat k m)
    refine hne ?_
    calc p1Rat k m = (a⁻¹ * a) • p1Rat k m := by rw [inv_mul_cancel₀ ha, one_smul]
      _ = a⁻¹ • (a • p1Rat k m) := by rw [mul_smul]
      _ = 0 := by rw [hax, smul_zero]
  exact Cardinal.one_le_iff_ne_zero.mpr hrank0

/-- **The base case of the `p₂`-probe**: a map `ℂP⁴ → G̃r₄(ℝ¹²)` — the plane
`ℝ-span{Λ(z), iΛ(z), Λ'(z), iΛ'(z)} ⊂ ℂ⁶ = ℝ¹²` of
`Submission/Work/ThomBordism/Grassmann/LowDegree/P2Frame.lean` — whose pullback of `p₂(γ)` is
rationally non-zero.  This is the single remaining input of the whole file: the stabilisation to
`k ≥ 4`, `m ≥ 8` is `LowDegree.p2ProbeCP4_of_base` (proved, `LowDegree/P2Stabilisation.lean`), so
proving this statement finishes `lowDegreeVanishingAndRanks`. -/
theorem p2ProbeBase4 :
    ∃ σ : C(Work.Projective.CP 4, OG 4 8),
      TensorProduct.tmul ℤ (1 : ℚ) ((Work.Thom.CohMap σ ℤ 8).hom (p2 4 8)) ≠ 0 :=
  LowDegree.p2ProbeCP4BaseWitness

/-- **The `p₂`-probe**: there is a map from `ℂP⁴` to `G̃r_k(ℝ^{k+m})` whose pullback of `p₂(γ)` is
rationally non-zero.  This is the second of the two probes needed for the independence of
`p₁(γ)²` and `p₂(γ)`; the first is `LowDegree.p1SqProbe`.  It is the base case of
`LowDegree/P2Frame.lean` (= the plane `ℝ-span{Λ, iΛ, Λ', iΛ'} ⊂ ℂ⁶`), stabilised by
`LowDegree.chainP2`. -/
theorem p2_probe_exists (k m : ℕ) (hk : 4 ≤ k) (hm : 8 ≤ m) :
    ∃ τ : C(Work.Projective.CP 4, OG k m),
      TensorProduct.tmul ℤ (1 : ℚ) ((Work.Thom.CohMap τ ℤ 8).hom (p2 k m)) ≠ 0 :=
  LowDegree.p2ProbeCP4_of_base p2ProbeBase4 k m hk hm

/-- **`2 ≤ rank H⁸`**: the two probes exhibit two independent classes. -/
theorem two_le_rank_eight (k m : ℕ) (hk : 10 ≤ k) (hm : 10 ≤ m) :
    2 ≤ Module.rank ℚ (Work.SignatureBordism.ratCohomology 8 (sset (OG k m))) := by
  obtain ⟨σ, hσ1, hσ2⟩ := LowDegree.p1SqProbe k m (by omega) (by omega)
  obtain ⟨τ, hτ⟩ := p2_probe_exists k m (by omega) (by omega)
  have hind := linearIndependent_of_probes k m σ τ hσ1 hσ2 hτ
  have hcard := hind.cardinal_le_rank
  simpa using hcard

/-! ## The target -/

/-- **Vanishing and ranks of the low-degree rational cohomology of the oriented Grassmannian.**

For `k, m ≥ 10`: `H^j(G̃r_k(ℝ^{k+m});ℚ) = 0` for `j ∈ {1,2,3,5,6,7}`, `H⁴` is one-dimensional
(generated by `p₁(γ)`) and `H⁸` is two-dimensional (generated by `p₁(γ)²` and `p₂(γ)`); both are
finite dimensional over `ℚ`. -/
theorem lowDegreeVanishingAndRanks (k m : ℕ) (hk : 10 ≤ k) (hm : 10 ≤ m) :
    (∀ j ∈ Work.ThomBordism.Grassmann.lowDegrees,
      Subsingleton (Work.SignatureBordism.ratCohomology j
        (Work.ThomBordism.Grassmann.sset (Work.ThomBordism.Grassmann.OG k m))))
    ∧ FiniteDimensional ℚ (Work.SignatureBordism.ratCohomology 4
        (Work.ThomBordism.Grassmann.sset (Work.ThomBordism.Grassmann.OG k m)))
    ∧ Module.rank ℚ (Work.SignatureBordism.ratCohomology 4
        (Work.ThomBordism.Grassmann.sset (Work.ThomBordism.Grassmann.OG k m))) = 1
    ∧ FiniteDimensional ℚ (Work.SignatureBordism.ratCohomology 8
        (Work.ThomBordism.Grassmann.sset (Work.ThomBordism.Grassmann.OG k m)))
    ∧ Module.rank ℚ (Work.SignatureBordism.ratCohomology 8
        (Work.ThomBordism.Grassmann.sset (Work.ThomBordism.Grassmann.OG k m))) = 2 := by
  have h4 : Module.rank ℚ (Work.SignatureBordism.ratCohomology 4 (sset (OG k m))) = 1 :=
    le_antisymm (rank_four_le_one k m hk hm) (one_le_rank_four k m hk hm)
  have h8 : Module.rank ℚ (Work.SignatureBordism.ratCohomology 8 (sset (OG k m))) = 2 :=
    le_antisymm (rank_eight_le_two k m hk hm) (two_le_rank_eight k m hk hm)
  exact ⟨grassmannianLowDegreeVanishing k m hk hm, Module.finite_of_rank_eq_one h4, h4,
    Module.finite_of_rank_eq_nat h8, h8⟩

end

end Work.ThomBordism.Grassmann
