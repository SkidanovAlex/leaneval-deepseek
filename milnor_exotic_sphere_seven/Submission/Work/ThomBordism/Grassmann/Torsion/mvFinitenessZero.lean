/-!
# The degree-zero Mayer–Vietoris finiteness lemma

The companion `Work.ThomBordism.Grassmann.Torsion.moduleFinite_homology_of_mv` proves that for an
open cover `X = U ∪ V`, finite generation of `H_n(U)`, `H_n(V)`, `H_n(U ∩ V)` implies finite
generation of `H_n(X)` for `n ≥ 1`, using the exact piece

`H_n(U) ⊞ H_n(V) ⟶ H_n(X) ⟶ H_{n-1}(U ∩ V)`

of the Mayer–Vietoris sequence.  In degree `0` there is no `H_{-1}`, so that argument does not
apply.  Instead one uses the *surjectivity* of the first map, which holds in degree zero for the
trivial reason that every point (and hence every `0`-chain) lies in `U` or in `V`.

The route taken here is:

* `epi_homologyMap_zero_of_surjective` — a chain map which is surjective in degree `0` induces a
  surjection on `H₀` (via the explicit cycle-lifting criterion `epi_homologyMap_of_cycles`);
* `mvRightX_zero_surjective` — the degree-zero Mayer–Vietoris map
  `H₀(U) ⊞ H₀(V) ⟶ H₀(X)` is surjective for an open cover: `mvRight` is already surjective on
  chains in degree `0` (every `0`-simplex is small, `Work.Cohomology.mv_degreewise`), and
  `smallIso` identifies `H₀` of the small chains with `H₀(X)`;
* `mvFinitenessZero` — `H₀(X)` is a quotient of the finitely generated `H₀(U) ⊞ H₀(V)`
  (`moduleFiniteHomologyBiprod`), hence finitely generated.
-/

open CategoryTheory Limits

namespace Work.ThomBordism.Grassmann.Torsion

noncomputable section

/-- **A chain map surjective in degree `0` is surjective on `H₀`.**  In degree `0` the differential
into degree `-1` is zero, so a lift of a `0`-cycle is already a `0`-cycle (and the `1`-chain in the
cycle-lifting criterion `Work.Cohomology.epi_homologyMap_of_cycles` may be taken to be `0`). -/
theorem epi_homologyMap_zero_of_surjective {C D : ChainComplex (ModuleCat ℤ) ℕ} (φ : C ⟶ D)
    (h : Function.Surjective (φ.f 0)) : Epi (HomologicalComplex.homologyMap φ 0) := by
  refine Work.Cohomology.epi_homologyMap_of_cycles φ 0 ?_
  intro z _
  obtain ⟨c, hc⟩ := h z
  refine ⟨c, 0, ?_, ?_⟩
  · -- the `(-1)`-th differential of a chain complex is zero
    rw [show C.d 0 (0 - 1) = 0 from
      HomologicalComplex.shape _ 0 (0 - 1) (by simp [ComplexShape.down])]
    rfl
  · show (ConcreteCategory.hom (φ.f 0)) c
      = z + (ConcreteCategory.hom (D.d (0 + 1) 0)) 0
    rw [map_zero, add_zero, hc]

/-- **The degree-zero Mayer–Vietoris map is surjective.**  For an open cover `X = U ∪ V` of a
topological space, the map

`H₀(U) ⊞ H₀(V) ⟶ H₀(X)`

induced by the two inclusions is onto.  Indeed `mvRight` is surjective already on `0`-chains (every
`0`-simplex has image a single point, which lies in `U` or in `V`; this is
`Work.Cohomology.mv_degreewise` at `n = 0`), and `Work.Cohomology.smallIso` identifies the homology
of the small chains with the singular homology of `X`. -/
theorem mvRightX_zero_surjective {X : TopCat} (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hcov : U ∪ V = Set.univ) :
    Function.Surjective (Work.Cohomology.mvRightX U V hU hV hcov 0).hom := by
  have h1 : Epi (HomologicalComplex.homologyMap (Work.Cohomology.mvRight U V) 0) :=
    epi_homologyMap_zero_of_surjective _
      ((ModuleCat.epi_iff_surjective _).mp ((Work.Cohomology.mv_degreewise U V 0).epi_g))
  haveI := h1
  haveI : Epi ((Work.Cohomology.smallIso U V hU hV hcov 0).hom) := inferInstance
  have h3 : Epi (Work.Cohomology.mvRightX U V hU hV hcov 0) := by
    rw [Work.Cohomology.mvRightX]
    infer_instance
  exact (ModuleCat.epi_iff_surjective _).mp h3

/-- **Degree-zero Mayer–Vietoris finiteness.**  If `X = U ∪ V` with `U`, `V` open and
`H₀(U;ℤ)`, `H₀(V;ℤ)` (and `H₀(U ∩ V;ℤ)`) finitely generated, then `H₀(X;ℤ)` is finitely
generated.

`H₀(X)` is a quotient of `H₀(U) ⊞ H₀(V)` — via the degree-zero Mayer–Vietoris map, which is onto
by `mvRightX_zero_surjective` — and that biproduct is finitely generated by
`moduleFiniteHomologyBiprod`.  (The hypothesis on `U ∩ V` is not needed in degree zero; it is part
of the interface of the general Mayer–Vietoris finiteness statement.) -/
theorem mvFinitenessZero {X : TopCat} (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hcov : U ∪ V = Set.univ)
    (hUi : Module.Finite ℤ ((Work.Cohomology.singularChains ℤ (TopCat.of U)).homology 0))
    (hVi : Module.Finite ℤ ((Work.Cohomology.singularChains ℤ (TopCat.of V)).homology 0))
    (hUVi : Module.Finite ℤ ((Work.Cohomology.singularChains ℤ (TopCat.of (Set.inter U V))).homology 0)) :
    Module.Finite ℤ ((Work.Cohomology.singularChains ℤ X).homology 0) := by
  haveI hA : Module.Finite ℤ (Work.Cohomology.HBiprod U V 0) :=
    Work.ThomBordism.moduleFiniteHomologyBiprod 0 hUi hVi
  exact Module.Finite.of_surjective (Work.Cohomology.mvRightX U V hU hV hcov 0).hom
    (mvRightX_zero_surjective U V hU hV hcov)

end

end Work.ThomBordism.Grassmann.Torsion
