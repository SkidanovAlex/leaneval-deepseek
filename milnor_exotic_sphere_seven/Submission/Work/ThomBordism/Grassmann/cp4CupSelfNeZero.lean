/-!
# `H⁴(ℂP⁴;ℤ)` is torsion-free along the hyperplane class: `v ⌣ v ≠ 0` for `v ≠ 0`

The cup square map `H⁴(ℂP⁴;ℤ) → H⁸(ℂP⁴;ℤ)`, `v ↦ v ⌣ v` has trivial kernel: it is (up to the
generator normalisation) multiplication by the square of the coefficient.

The proof uses the two computations of the Gen area:

* `Work.Gen.uSqGenerates` : `H⁴(ℂP⁴;ℤ) = ℤ⟨u²⟩` is generated by the square `u²` of the hyperplane
  class `u = c₁(O(1))`, so `v = n·u²` with `n ≠ 0` (`v ≠ 0`);
* `Work.Gen.cp4_kronH_uFourth_pm_one` : the Kronecker pairing `⟨u⁴, [ℂP⁴]⟩` of the generator
  `u⁴ = u² ⌣ u²` of `H⁸(ℂP⁴;ℤ)` with the fundamental class is `±1`; in particular `u² ⌣ u²` is not
  annihilated by `n²` in the (torsion-free) degree-`8` cohomology.

Since the cup product is `ℤ`-bilinear, `v ⌣ v = n²·(u² ⌣ u²)`, whose pairing with `[ℂP⁴]` is
`n²·(±1) ≠ 0`; hence `v ⌣ v ≠ 0`.
-/

namespace Work.ThomBordism.Grassmann

theorem cp4CupSelfNeZero (v : Work.Thom.Coh ℤ 4 (Work.Projective.CP 4)) (hv : v ≠ 0) :
    Work.Cohomology.cupH' ℤ (Work.ThomBordism.Grassmann.sset (Work.Projective.CP 4)) 4 4 v v ≠ 0 := by
  -- Work in the underlying cochain model, definitionally the same type as `Work.Thom.Coh`.
  let w : ↑((Work.Cohomology.cochainC ℤ (sset (Work.Projective.CP 4))).homology 4) := v
  have hw : w ≠ 0 := hv
  have hmain : Work.Cohomology.cupH' ℤ (sset (Work.Projective.CP 4)) 4 4 w w ≠ 0 := by
    -- `H⁴(ℂP⁴;ℤ)` is generated by `u²`
    have hmem : w ∈ Submodule.span ℤ ({Work.Gen.uSq 4} : Set _) := by
      rw [Work.Gen.uSqGenerates]; exact Submodule.mem_top
    obtain ⟨n, hn⟩ := Submodule.mem_span_singleton.mp hmem
    -- `v ≠ 0` forces the coefficient to be nonzero
    have hn0 : n ≠ 0 := by
      intro h
      refine hw ?_
      rw [← hn, h]
      exact map_zero (LinearMap.toSpanSingleton ℤ _ (Work.Gen.uSq 4))
    have hn2 : n * n ≠ 0 := mul_ne_zero hn0 hn0
    -- the pairing of `v ⌣ v` with the fundamental class is `n * (n * (±1))`
    have step : ((Work.Cohomology.kronH ℤ Work.Projective.cp4SSet 8)
          (Work.Cohomology.cupH' ℤ (sset (Work.Projective.CP 4)) 4 4 w w)) Work.Projective.cp4C
        = n * (n * (((Work.Cohomology.kronH ℤ Work.Projective.cp4SSet 8)
            (Work.Gen.uFourth 4)) Work.Projective.cp4C)) := by
      rw [← hn, Work.Cohomology.cupH'_smul_left, Work.Cohomology.cupH'_smul_right]
      simp only [map_smul, LinearMap.smul_apply, smul_eq_mul]
      rfl
    intro hzero
    have hk := congrArg (fun z => ((Work.Cohomology.kronH ℤ Work.Projective.cp4SSet 8) z)
      Work.Projective.cp4C) hzero
    simp only [map_zero, LinearMap.zero_apply] at hk
    rw [step] at hk
    rcases Work.Gen.cp4_kronH_uFourth_pm_one with h1 | h1
    · rw [h1] at hk
      simp only [mul_one] at hk
      exact hn2 hk
    · rw [h1] at hk
      rw [mul_neg_one, mul_neg] at hk
      exact hn2 (neg_eq_zero.mp hk)
  exact hmain

end Work.ThomBordism.Grassmann
