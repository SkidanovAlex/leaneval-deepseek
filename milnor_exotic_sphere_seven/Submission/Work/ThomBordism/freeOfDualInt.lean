import Mathlib

-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

/-!
# A finitely generated free `ℤ`-module whose dual is `ℤ` is itself `ℤ`

If `M` is a free `ℤ`-module (of any rank) and its dual `M →ₗ[ℤ] ℤ` is isomorphic to `ℤ`,
then `M` is isomorphic to `ℤ`.  The proof is elementary and avoids all dimension theory:

* let `h : Module.Dual ℤ M ≃ₗ[ℤ] ℤ` and put `e := h.symm 1 : M →ₗ[ℤ] ℤ`; then `h e = 1`, so
  `e ≠ 0`, and for every `φ : Module.Dual ℤ M` one has `φ = (h φ) • e` (all functionals are
  multiples of `e`);
* hence `e` is injective: if `e x = 0` then `φ x = (h φ) • e x = 0` for every `φ`, and a free
  module is separated by its dual (use a basis and the coordinate functionals);
* so `M ≃ₗ[ℤ] e.range`, and `e.range` is a nonzero ideal of the PID `ℤ`, hence generated by some
  nonzero `g`; `ℤ ≃ₗ[ℤ] (g)` by `LinearEquiv.toSpanNonzeroSingleton`.

The `Module.Finite` hypothesis is not needed. -/

namespace Work.ThomBordism

theorem freeOfDualInt {M : Type} [AddCommGroup M] [Module ℤ M] [Module.Finite ℤ M]
    [Module.Free ℤ M] (h : Nonempty (Module.Dual ℤ M ≃ₗ[ℤ] ℤ)) :
    Nonempty (M ≃ₗ[ℤ] ℤ) := by
  obtain ⟨h⟩ := h
  -- The functional corresponding to `1 : ℤ` under the given isomorphism.
  let e : M →ₗ[ℤ] ℤ := h.symm 1
  have he1 : h e = 1 := h.apply_symm_apply 1
  have he_ne : e ≠ 0 := by
    intro h0
    have h2 : h e = 0 := by rw [h0, map_zero]
    rw [he1] at h2
    exact one_ne_zero h2
  -- Every element of the dual is a multiple of `e`.
  have hsmul : ∀ k : ℤ, h.symm k = k • e := by
    intro k
    have hk : h.symm k = h.symm (k • (1 : ℤ)) := by rw [smul_eq_mul, mul_one]
    rw [hk, map_smul]
  have hgen : ∀ φ : M →ₗ[ℤ] ℤ, φ = (h φ) • e := by
    intro φ
    calc φ = h.symm (h φ) := (h.symm_apply_apply φ).symm
      _ = (h φ) • e := hsmul (h φ)
  -- A free module is separated by its dual.
  have he_inj : Function.Injective e := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    rw [LinearMap.mem_ker] at hx
    by_contra hx0
    let b := Module.Free.chooseBasis ℤ M
    have hb : b.repr x ≠ 0 := by
      intro hh
      exact hx0 (b.repr.injective (by rw [hh, map_zero]))
    obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hb
    rw [Finsupp.mem_support_iff] at hi
    have hzero : b.coord i x = 0 := by
      rw [hgen (b.coord i), LinearMap.smul_apply, hx, smul_zero]
    exact hi (by rw [← b.coord_apply]; exact hzero)
  -- `e.range` is a nonzero ideal of `ℤ`, hence `≅ ℤ`.
  have hspan : Submodule.span ℤ {Submodule.IsPrincipal.generator e.range} = e.range :=
    Submodule.IsPrincipal.span_singleton_generator e.range
  let g : ℤ := Submodule.IsPrincipal.generator e.range
  have hgspan : Submodule.span ℤ {g} = e.range := hspan
  have hg_ne : g ≠ 0 := by
    intro hg
    have hbot : e.range = ⊥ := by
      rw [← hgspan, hg]
      exact Submodule.span_singleton_eq_bot.mpr rfl
    exact he_ne ((LinearMap.range_eq_bot (f := e)).mp hbot)
  have iso1 : ℤ ≃ₗ[ℤ] ↥e.range :=
    (LinearEquiv.toSpanNonzeroSingleton ℤ ℤ g hg_ne).trans (LinearEquiv.ofEq _ _ hgspan)
  exact ⟨(LinearEquiv.ofInjective e he_inj).trans iso1.symm⟩

end Work.ThomBordism
