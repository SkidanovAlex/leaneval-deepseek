open CategoryTheory Limits

/-- The relative homology `H_j(Z.TotalSpace, Z.TotalSpace ∖ 0)` of the Thom pair of a real bundle
over a closed `8`-manifold is finitely generated in every degree.

Route (all ingredients are on disk and sorry-free).

* `H_n(↥(zeroComplement Z))` is finitely generated: apply
  `Work.ThomBordism.finiteHomologyZeroComplement Z U r hopen hcov hgood hsub n` to the finite good
  cover of `Work.ThomBordism.goodCoverRealBundle Z` (its four hypotheses are exactly the four
  conclusions of that cover).
* `H_n(Z.TotalSpace) ≅ H_n(V.pt)` is finitely generated: the bundle projection is a homotopy
  equivalence (the fibrewise rescaling, `Work.Thom.homotopic_zeroSection_comp_bundleProj`), so
  `Work.ThomBordism.Grassmann.Torsion.moduleFinite_homology_of_homotopyEquiv` transfers
  `Work.ThomBordism.compactHomologyFinite` to the total space.
* The long exact sequence of the pair
  `H_{n+1}(E,E∖0) → H_n(E∖0) → H_n(E) → H_n(E,E∖0) → H_{n-1}(E∖0)`
  (`Work.Cohomology.hPair_exact₁/₂/₃`, `Work.Cohomology.hPairδ`) with
  `Work.ThomBordism.Grassmann.Torsion.moduleFinite_of_exact_pair` (middle term of an exact sequence
  with finitely generated outer terms) then gives `H_n(E,E∖0)` finitely generated by induction on
  `n`.

Note: no orientability is available (and none is needed); only finiteness is claimed. -/
theorem relChains_zeroComplement_finite {V : Work.ThomBordism.Man8} {k : ℕ} {ι : Type}
    (Z : Work.TangentClasses.RealBundle V.pt (Fin k → ℝ) ι) (j : ℕ) :
    Module.Finite ℤ ((Work.Cohomology.relChains (TopCat.of Z.TotalSpace)
      (Work.Thom.zeroComplement Z)).homology j) := by
  classical
  obtain ⟨m, U, r, hopen, hcov, hgood, hsub⟩ := goodCoverRealBundle Z
  have hRel : ∀ n, Module.Finite ℤ ((Work.Cohomology.singularChains ℤ
      (TopCat.of ↥(Work.Thom.zeroComplement Z))).homology n) :=
    fun n => finiteHomologyZeroComplement Z U r hopen hcov hgood hsub n
  have hE : ∀ n, Module.Finite ℤ
      ((Work.Cohomology.singularChains ℤ (TopCat.of Z.TotalSpace)).homology n) := by
    intro n
    have hcomp : TopCat.ofHom (Work.Thom.zeroSection Z) ≫ TopCat.ofHom (Work.Thom.bundleProj Z)
        = 𝟙 (TopCat.of V.pt) := by
      rw [← TopCat.ofHom_comp, Work.Thom.bundleProj_comp_zeroSection, TopCat.ofHom_id]
    have h₁ : TopCat.Homotopy
        (TopCat.ofHom (Work.Thom.zeroSection Z) ≫ TopCat.ofHom (Work.Thom.bundleProj Z))
        (𝟙 (TopCat.of V.pt)) := by
      rw [hcomp]; exact TopCat.Homotopy.refl _
    have h₂ : TopCat.Homotopy
        (TopCat.ofHom (Work.Thom.bundleProj Z) ≫ TopCat.ofHom (Work.Thom.zeroSection Z))
        (𝟙 (TopCat.of Z.TotalSpace)) :=
      (Work.Thom.homotopic_zeroSection_comp_bundleProj Z).some
    exact Work.ThomBordism.Grassmann.Torsion.moduleFinite_homology_of_homotopyEquiv _ _ h₁ h₂ n
      (compactHomologyFinite (n := 8) (k := n) V.pt)
  rcases Nat.eq_zero_or_pos j with hj | hj
  · subst hj
    haveI := hE 0
    have hepi : Epi (HomologicalComplex.homologyMap (cokernel.π (Work.Cohomology.inclChains
        (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z))) 0) := by
      refine Work.Cohomology.epi_homologyMap_of_cycles _ 0 ?_
      intro z hz
      obtain ⟨c, hc⟩ := (ModuleCat.epi_iff_surjective ((cokernel.π (Work.Cohomology.inclChains
        (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z))).f 0)).mp inferInstance z
      exact ⟨c, 0, by simp, by simp [hc]⟩
    exact Module.Finite.of_surjective
      (HomologicalComplex.homologyMap (cokernel.π (Work.Cohomology.inclChains
        (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z))) 0).hom
      ((ModuleCat.epi_iff_surjective _).mp hepi)
  · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
    refine Work.ThomBordism.Grassmann.Torsion.moduleFinite_of_exact_pair
      (HomologicalComplex.homologyMap (cokernel.π (Work.Cohomology.inclChains
        (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z))) (j' + 1)).hom
      (Work.Cohomology.hPairδ (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z) j').hom
      ?_ (hE (j' + 1)) (hRel j')
    exact ShortComplex.Exact.moduleCat_range_eq_ker
      (Work.Cohomology.hPair_exact₃ (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z) j')

end Work.ThomBordism
