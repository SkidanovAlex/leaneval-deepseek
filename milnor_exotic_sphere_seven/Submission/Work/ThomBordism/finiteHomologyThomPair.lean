/-- **Finitely generated relative homology of the Thom pair of a real bundle over a closed
oriented smooth `8`-manifold.**

For a real bundle `Z` over a `Man8` `V`, the relative homology
`H_n(Z.TotalSpace, Z.TotalSpace ∖ 0; ℤ)` of the pair (total space, complement of the zero section)
is a finitely generated `ℤ`-module in every degree.  No orientability is needed: only finiteness
is claimed.

The proof is the long exact sequence of the pair
`H_{n+1}(E,E∖0) → H_n(E∖0) → H_n(E) → H_n(E,E∖0) → H_{n-1}(E∖0)`:

* `H_n(E∖0)` is finitely generated by `Work.ThomBordism.finiteHomologyZeroComplement` applied to
  the finite good cover of `Work.ThomBordism.goodCoverRealBundle`;
* `H_n(E)` is finitely generated because `E` is homotopy equivalent to the compact base `V.pt`
  (the bundle projection and the zero section, through the fibrewise rescaling
  `Work.Thom.homotopic_zeroSection_comp_bundleProj`), whose homology is finitely generated by
  `Work.ThomBordism.compactHomologyFinite`;
* in positive degrees the exactness of the piece `H_n(E) → H_n(E,E∖0) → H_{n-1}(E∖0)`
  (`Work.Cohomology.hPair_exact₃`) exhibits `H_n(E,E∖0)` as an extension of a quotient of `H_n(E)`
  by a submodule of `H_{n-1}(E∖0)`, whence finitely generated by
  `Work.ThomBordism.Grassmann.Torsion.moduleFinite_of_exact_pair`;
* in degree `0` there is no `H_{-1}`, but the projection `C_0(E) → C_0(E,E∖0)` is surjective, so
  `H_0(E,E∖0)` is a quotient of `H_0(E)`
  (`Work.ThomBordism.Grassmann.Torsion.epi_homologyMap_zero_of_surjective`). -/
theorem finiteHomologyThomPair {V : Work.ThomBordism.Man8} {k : ℕ} {ι : Type}
    (Z : Work.TangentClasses.RealBundle V.pt (Fin k → ℝ) ι) (n : ℕ) :
    Module.Finite ℤ ↥((Work.Cohomology.relChains (TopCat.of Z.TotalSpace)
      (Work.Thom.zeroComplement Z)).homology n) := by
  classical
  -- the finite good cover of the base provided by `goodCoverRealBundle`
  obtain ⟨m, U, r, hopen, hcov, hgood, hsub⟩ := Work.ThomBordism.goodCoverRealBundle Z
  -- finiteness of `H_*(E ∖ 0)`
  have hAfin : ∀ j : ℕ, Module.Finite ℤ
      ((Work.Cohomology.singularChains ℤ
        (TopCat.of (Work.Thom.zeroComplement Z))).homology j) :=
    fun j => Work.ThomBordism.finiteHomologyZeroComplement Z U r hopen hcov hgood hsub j
  -- finiteness of `H_*(V)`
  have hVfin : ∀ j : ℕ, Module.Finite ℤ
      ((Work.Cohomology.singularChains ℤ (TopCat.of V.pt)).homology j) :=
    fun j => Work.ThomBordism.compactHomologyFinite (n := 8) (k := j) V.pt
  -- the homotopy equivalence `V ≃ E` given by the zero section and the projection
  have h1 : TopCat.Homotopy
      (CategoryTheory.CategoryStruct.comp (TopCat.ofHom (Work.Thom.zeroSection Z))
        (TopCat.ofHom (Work.Thom.bundleProj Z)))
      (CategoryTheory.CategoryStruct.id (TopCat.of V.pt)) := by
    have hcomp : CategoryTheory.CategoryStruct.comp
          (TopCat.ofHom (Work.Thom.zeroSection Z)) (TopCat.ofHom (Work.Thom.bundleProj Z))
        = CategoryTheory.CategoryStruct.id (TopCat.of V.pt) := by
      rw [← TopCat.ofHom_comp, Work.Thom.bundleProj_comp_zeroSection, TopCat.ofHom_id]
    rw [hcomp]
    exact ContinuousMap.Homotopy.refl _
  have h2 : TopCat.Homotopy
      (CategoryTheory.CategoryStruct.comp (TopCat.ofHom (Work.Thom.bundleProj Z))
        (TopCat.ofHom (Work.Thom.zeroSection Z)))
      (CategoryTheory.CategoryStruct.id (TopCat.of Z.TotalSpace)) :=
    (Work.Thom.homotopic_zeroSection_comp_bundleProj Z).some
  -- finiteness of `H_*(E)`
  have hXfin : ∀ j : ℕ, Module.Finite ℤ
      ((Work.Cohomology.singularChains ℤ (TopCat.of Z.TotalSpace)).homology j) :=
    fun j => Work.ThomBordism.Grassmann.Torsion.moduleFinite_homology_of_homotopyEquiv
      (TopCat.ofHom (Work.Thom.zeroSection Z)) (TopCat.ofHom (Work.Thom.bundleProj Z))
      h1 h2 j (hVfin j)
  rcases n with _ | n
  · -- degree zero: `H_0(E,E∖0)` is a quotient of `H_0(E)`
    have hsurj : Function.Surjective (CategoryTheory.ConcreteCategory.hom
        ((CategoryTheory.Limits.cokernel.π (Work.Cohomology.inclChains (TopCat.of Z.TotalSpace)
          (Work.Thom.zeroComplement Z))).f 0)) :=
      (ModuleCat.epi_iff_surjective _).mp inferInstance
    haveI : CategoryTheory.Epi (HomologicalComplex.homologyMap
        (CategoryTheory.Limits.cokernel.π (Work.Cohomology.inclChains (TopCat.of Z.TotalSpace)
          (Work.Thom.zeroComplement Z))) 0) :=
      Work.ThomBordism.Grassmann.Torsion.epi_homologyMap_zero_of_surjective _ hsurj
    haveI : Module.Finite ℤ
        ((Work.Cohomology.singularChains ℤ (TopCat.of Z.TotalSpace)).homology 0) := hXfin 0
    exact Module.Finite.of_surjective
      (HomologicalComplex.homologyMap (CategoryTheory.Limits.cokernel.π
        (Work.Cohomology.inclChains (TopCat.of Z.TotalSpace)
          (Work.Thom.zeroComplement Z))) 0).hom
      ((ModuleCat.epi_iff_surjective _).mp inferInstance)
  · -- positive degrees: exactness of `H_{n+1}(E) → H_{n+1}(E,E∖0) → H_n(E∖0)`
    have hex := Work.Cohomology.hPair_exact₃ (TopCat.of Z.TotalSpace)
      (Work.Thom.zeroComplement Z) n
    have hker := CategoryTheory.ShortComplex.Exact.moduleCat_range_eq_ker hex
    exact Work.ThomBordism.Grassmann.Torsion.moduleFinite_of_exact_pair
      (HomologicalComplex.homologyMap (CategoryTheory.Limits.cokernel.π
        (Work.Cohomology.inclChains (TopCat.of Z.TotalSpace)
          (Work.Thom.zeroComplement Z))) (n + 1)).hom
      (Work.Cohomology.hPairδ (TopCat.of Z.TotalSpace) (Work.Thom.zeroComplement Z) n).hom
      hker (hXfin (n + 1)) (hAfin n)

end Work.ThomBordism
