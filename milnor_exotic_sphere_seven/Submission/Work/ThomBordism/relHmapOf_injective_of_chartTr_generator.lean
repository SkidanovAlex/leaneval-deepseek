import Mathlib
import Submission.Work.ThomBordism.modelHalfOrientation
import Submission.Work.PTGeometric.isOrientFamily_eq_smul_of_connected
import Submission.Work.PTGeometric.HOFXfer

-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxHeartbeats 400000

/-!
# A relative homology map that carries a chart generator to a chart generator is injective

Target: `Work.ThomBordism.relHmapOf_injective_of_chartTr_generator`.

The local group `H_n(X, X∖{y})` of a point has, whenever a chart `eb` around `y` into `ℝⁿ` is
available, a distinguished generator
`chartTr eb y hyeb (eucFam n hn (eb y))` (`Work.PTGeometric.HOF.chartTr`,
`Work.PTGeometric.HOF.eucFam`).  The statement proved here says that if the map of pairs induced by
`f : X → Y` sends the generator at `y` to the generator at `y'`, then `f` induces an *injective* map
on the local group at `y`.

The mathematical content is a two-line argument once the local groups are identified:

* the transfer `chartTr e w hw` is **surjective**, and its explicit left inverse `chartInvCore`
  makes it injective as well (both facts are in `Submission/Work/PTGeometric/HOFXfer.lean`);
* the Euclidean local group `H_n(ℝⁿ, ℝⁿ∖{z})` is generated by `eucFam n hn z` and is isomorphic to
  `ℤ` (`Work.PTGeometric.HOF.eucFam_gen`, `Work.PTGeometric.HOF.locIso`), so a `ℤ`-multiple of that
  generator vanishes only if its coefficient does.

Concretely: any `x` in the source group is `m •` the generator (up to transferring along `chartTr`),
and the hypothesis computes `R x = m •` (generator at `y'`); if this vanishes then `m = 0` and hence
`x = 0`.  So `R` has trivial kernel.

The formalisation keeps every occurrence of a `ℤ`-multiple in the shape
`LinearMap.toSpanSingleton ℤ M g m`; writing `m • g` by hand would pick a different (propositionally
equal, but not syntactically equal) `SMul ℤ` instance on the `ModuleCat` carriers than the library
lemmas do, which makes rewriting fail.
-/

set_option autoImplicit false
set_option maxHeartbeats 1600000
set_option linter.unusedVariables false

open CategoryTheory AlgebraicTopology CategoryTheory.Limits
open scoped Topology

namespace Work.ThomBordism

namespace ChartTrGenerator

/-- The Euclidean model space `ℝⁿ`, as a `TopCat`. -/
abbrev eucTop (n : ℕ) : TopCat := TopCat.of (Work.PTGeometric.HOF.Euc n)

/-- The Euclidean model generator `eucFam`, viewed as a class of the relative group
`H_n(ℝⁿ, ℝⁿ∖{y})` (rather than of the local group `LocH`; the two are the same by definition). -/
noncomputable def eucFamRel (n : ℕ) (hn : 1 ≤ n) (y : Work.PTGeometric.HOF.Euc n) :
    Work.Orient.RelH (eucTop n) n ({y} : Set (Work.PTGeometric.HOF.Euc n)) :=
  Work.PTGeometric.HOF.eucFam n hn y

/-- **`eucFamRel` generates the local group of `ℝⁿ`.** -/
theorem eucFamRel_gen (n : ℕ) (hn : 1 ≤ n) (y : Work.PTGeometric.HOF.Euc n) :
    Submodule.span ℤ ({eucFamRel n hn y} : Set
      (Work.Orient.RelH (eucTop n) n ({y} : Set (Work.PTGeometric.HOF.Euc n)))) = ⊤ :=
  Work.PTGeometric.HOF.eucFam_gen n hn y

end ChartTrGenerator

open ChartTrGenerator in
/-- **The chart transfer of a local group is injective.**  Its left inverse is
`Work.PTGeometric.HOF.chartInvCore`. -/
theorem chartTr_injective {W : TopCat} [T1Space W] {N : ℕ}
    (e : OpenPartialHomeomorph W (Work.PTGeometric.HOF.Euc N)) (w : W) (hw : w ∈ e.source) :
    Function.Injective (Work.PTGeometric.HOF.chartTr e w hw) :=
  Function.LeftInverse.injective (fun v => Work.PTGeometric.HOF.chartInvCore_chartTr e w hw v)

open ChartTrGenerator in
/-- **If a map of pairs carries the chart generator at `y` to the chart generator at `y'`, then it is
injective on the local group at `y`.**

Proof: `chartTr eb y hyeb` is surjective, so it suffices to test injectivity on its image; there the
hypothesis computes the map as `chartTr eb' y' hyeb'`, which is injective.  Written on elements:
if `x` lies in the kernel, write `x = chartTr eb y hyeb z` and `z = m •` the Euclidean generator;
the hypothesis computes `0 = R x = m • (chart generator at y')`, and since the local group of `ℝⁿ` is
`ℤ` generated by `eucFam`, the coefficient `m` must vanish. -/
theorem relHmapOf_injective_of_chartTr_generator {n : ℕ} (hn : 1 ≤ n)
    {X Y : TopCat} [T1Space X] [T1Space Y] (f : X ⟶ Y) {y : X} {y' : Y}
    (eb : OpenPartialHomeomorph X (Work.PTGeometric.HOF.Euc n)) (hyeb : y ∈ eb.source)
    (eb' : OpenPartialHomeomorph Y (Work.PTGeometric.HOF.Euc n)) (hyeb' : y' ∈ eb'.source)
    (hpair : ∀ x : X, x ∉ ({y} : Set X) → f x ∉ ({y'} : Set Y))
    (hgen : Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair
        (Work.PTGeometric.HOF.chartTr eb y hyeb (Work.PTGeometric.HOF.eucFam n hn (eb y)))
      = Work.PTGeometric.HOF.chartTr eb' y' hyeb' (Work.PTGeometric.HOF.eucFam n hn (eb' y'))) :
    Function.Injective (Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair) := by
  -- abbreviations for the three groups involved
  set A := Work.Orient.RelH (eucTop n) n ({eb y} : Set (Work.PTGeometric.HOF.Euc n)) with hA
  set B := Work.Orient.RelH Y n ({y'} : Set Y) with hB
  set A' := Work.Orient.RelH (eucTop n) n ({eb' y'} : Set (Work.PTGeometric.HOF.Euc n)) with hA'
  -- the target transfer is injective
  have hTinj : Function.Injective (Work.PTGeometric.HOF.chartTr eb' y' hyeb') :=
    chartTr_injective eb' y' hyeb'
  -- the source transfer is surjective, and its kernel is trivial: this is the whole content
  have keylemma : ∀ z : A, (Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
      ((Work.PTGeometric.HOF.chartTr eb y hyeb) z) = 0 → z = 0 := by
    intro z hz
    -- `z` is a multiple of the Euclidean generator
    have hspanA : Submodule.span ℤ ({eucFamRel n hn (eb y)} : Set A) = ⊤ :=
      eucFamRel_gen n hn (eb y)
    obtain ⟨m, hm⟩ : ∃ m : ℤ, LinearMap.toSpanSingleton ℤ A (eucFamRel n hn (eb y)) m = z := by
      have hz' : z ∈ (LinearMap.toSpanSingleton ℤ A (eucFamRel n hn (eb y))).range := by
        rw [LinearMap.range_toSpanSingleton, hspanA]
        exact Submodule.mem_top
      exact hz'
    -- apply the hypothesis to that multiple: `R (T z) = m • (chart generator at y')`
    have hA1 : (Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
        ((Work.PTGeometric.HOF.chartTr eb y hyeb)
          (LinearMap.toSpanSingleton ℤ A (eucFamRel n hn (eb y)) m)) = 0 :=
      (congrArg (fun w => (Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
        ((Work.PTGeometric.HOF.chartTr eb y hyeb) w)) hm).trans hz
    have hB1 : (Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
        ((Work.PTGeometric.HOF.chartTr eb y hyeb)
          (LinearMap.toSpanSingleton ℤ A (eucFamRel n hn (eb y)) m))
        = LinearMap.toSpanSingleton ℤ B
            ((Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
              ((Work.PTGeometric.HOF.chartTr eb y hyeb) (eucFamRel n hn (eb y)))) m := by
      have h := congrArg (fun φ : ℤ →ₗ[ℤ] B => φ m)
        (LinearMap.comp_toSpanSingleton
          ((Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair).comp
            (Work.PTGeometric.HOF.chartTr eb y hyeb)) (eucFamRel n hn (eb y)))
      simpa [LinearMap.comp_apply] using h
    have hD1 : LinearMap.toSpanSingleton ℤ B
            ((Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
              ((Work.PTGeometric.HOF.chartTr eb y hyeb) (eucFamRel n hn (eb y)))) m
        = LinearMap.toSpanSingleton ℤ B
            ((Work.PTGeometric.HOF.chartTr eb' y' hyeb') (eucFamRel n hn (eb' y'))) m :=
      congrArg (fun w => LinearMap.toSpanSingleton ℤ B w m) hgen
    have hE1 : LinearMap.toSpanSingleton ℤ B
            ((Work.PTGeometric.HOF.chartTr eb' y' hyeb') (eucFamRel n hn (eb' y'))) m
        = (Work.PTGeometric.HOF.chartTr eb' y' hyeb')
            (LinearMap.toSpanSingleton ℤ A' (eucFamRel n hn (eb' y')) m) := by
      have h := congrArg (fun φ : ℤ →ₗ[ℤ] B => φ m)
        (LinearMap.comp_toSpanSingleton (Work.PTGeometric.HOF.chartTr eb' y' hyeb')
          (eucFamRel n hn (eb' y')))
      simpa [LinearMap.comp_apply] using h.symm
    -- hence the multiple of the target generator is a multiple of `eucFam` at `eb' y'` which is
    -- killed by the (injective) target transfer
    have hF1 : (Work.PTGeometric.HOF.chartTr eb' y' hyeb')
        (LinearMap.toSpanSingleton ℤ A' (eucFamRel n hn (eb' y')) m) = 0 := by
      rw [← hE1, ← hD1, ← hB1]
      exact hA1
    have hkerRel : LinearMap.toSpanSingleton ℤ A' (eucFamRel n hn (eb' y')) m = 0 :=
      hTinj (hF1.trans (map_zero _).symm)
    -- the coefficient vanishes, because `H_n(ℝⁿ, ℝⁿ∖{z})` is `ℤ`, generated by `eucFam`
    have hgenL : Submodule.span ℤ ({Work.PTGeometric.HOF.eucFam n hn (eb' y')} : Set
        (Work.Orient.LocH (eucTop n) n (eb' y'))) = ⊤ :=
      Work.PTGeometric.HOF.eucFam_gen n hn (eb' y')
    have hkerL : LinearMap.toSpanSingleton ℤ (Work.Orient.LocH (eucTop n) n (eb' y'))
        (Work.PTGeometric.HOF.eucFam n hn (eb' y')) m = 0 := hkerRel
    have hmul : m * ((Work.PTGeometric.HOF.locIso n hn (eb' y'))
        (Work.PTGeometric.HOF.eucFam n hn (eb' y'))) = 0 := by
      have h1 : (Work.PTGeometric.HOF.locIso n hn (eb' y'))
          (LinearMap.toSpanSingleton ℤ (Work.Orient.LocH (eucTop n) n (eb' y'))
            (Work.PTGeometric.HOF.eucFam n hn (eb' y')) m) = 0 :=
        (congrArg (fun w => (Work.PTGeometric.HOF.locIso n hn (eb' y')) w) hkerL).trans (map_zero _)
      exact (Work.PTGeometric.HOF.iso_toSpanSingleton (Work.PTGeometric.HOF.locIso n hn (eb' y'))
        (Work.PTGeometric.HOF.eucFam n hn (eb' y')) m).symm.trans h1
    have hne : (Work.PTGeometric.HOF.locIso n hn (eb' y'))
        (Work.PTGeometric.HOF.eucFam n hn (eb' y')) ≠ 0 :=
      Work.PTGeometric.HOF.iso_gen_ne_zero hgenL (Work.PTGeometric.HOF.locIso n hn (eb' y'))
    have hm0 : m = 0 := Int.mul_eq_zero.mp hmul |>.resolve_right hne
    exact hm.symm.trans (by rw [hm0]; exact map_zero _)
  -- now the injectivity: test on the image of the (surjective) source transfer
  intro x z hxz
  obtain ⟨w, hw⟩ := Work.PTGeometric.HOF.chartTr_surjective eb y hyeb x
  obtain ⟨w', hw'⟩ := Work.PTGeometric.HOF.chartTr_surjective eb y hyeb z
  have h2 : (Work.PTGeometric.HOF.RelHmapOf n f ({y} : Set X) ({y'} : Set Y) hpair)
      ((Work.PTGeometric.HOF.chartTr eb y hyeb) (w - w')) = 0 := by
    rw [map_sub, hw, hw', map_sub, hxz, sub_self]
  have h3 : w - w' = 0 := keylemma (w - w') h2
  have h4 : w = w' := sub_eq_zero.mp h3
  rw [← hw, ← hw', h4]

end Work.ThomBordism
