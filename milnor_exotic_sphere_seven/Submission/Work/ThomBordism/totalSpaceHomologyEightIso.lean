import Mathlib
import Submission.Work.Tubular.LocalStep
import Submission.Work.Orient.Closed
import Submission.Work.Thom.discSub_homotopyEquiv

-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxHeartbeats 400000

/-!
# The `8`-th homology of the total space of a real bundle over a closed oriented `8`-manifold

For a closed oriented `8`-manifold `V` (a `Work.ThomBordism.Man8`, whose fundamental class `V.c`
generates the local homology at every point) which is path connected, and *any* real vector bundle
`Z` over `V.pt`, the total space `Z.TotalSpace` has `H₈(Z.TotalSpace; ℤ) ≅ ℤ`.

The mathematical content is that `Z.TotalSpace` deformation retracts onto the zero section
(the straight-line homotopy `(t,p) ↦ ⟨p.1, (1-t) • p.2⟩`, continuous by the fibrewise-scaling lemma
`Work.Thom.continuous_smul_section`), hence is homotopy equivalent to `V.pt`; and `H₈(V.pt; ℤ) ≅ ℤ`
for a connected closed oriented `8`-manifold, by the local-generation property of the fundamental
class (`Man8.c_fund`): the localisation `H₈(V.pt) → H₈(V.pt, V.pt∖{x}) ≅ ℤ` is injective
(`Work.Orient.eq_zero_of_locClass_eq_zero_at`) with image generated by the local class of `V.c`
(`Man8.c_fund`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000

open CategoryTheory AlgebraicTopology CategoryTheory.Limits
open scoped unitInterval

namespace Work.ThomBordism

noncomputable section

variable {V : Work.ThomBordism.Man8} {k : ℕ} {ι : Type}

/-- The projection of the total space of a real bundle, as a morphism of `TopCat`. -/
def totalProj (Z : Work.TangentClasses.RealBundle V.pt (Fin k → ℝ) ι) :
    TopCat.of Z.TotalSpace ⟶ TopCat.of V.pt :=
  TopCat.ofHom ⟨Z.proj, Z.continuous_proj⟩

/-- **The total space of a real bundle deformation retracts onto its zero section.**  The homotopy
is the fibrewise straight-line rescaling `(t,p) ↦ ⟨p.1, (1-t) • p.2⟩`, which at `t = 0` is the
identity and at `t = 1` is the composite of the projection with the zero section. -/
theorem totalProj_zeroSection_homotopy (Z : Work.TangentClasses.RealBundle V.pt (Fin k → ℝ) ι) :
    Nonempty (TopCat.Homotopy (totalProj Z ≫ Work.Tubular.zeroSectionTop Z)
      (𝟙 (TopCat.of Z.TotalSpace))) := by
  refine ⟨(ContinuousMap.Homotopy.mk
    ⟨fun w : ↑unitInterval × Z.TotalSpace =>
      (⟨(w.2).1, (1 - (w.1 : ℝ)) • (w.2).2⟩ : Z.TotalSpace),
      Work.Thom.continuous_smul_section Z ⟨Prod.snd, continuous_snd⟩
        ⟨fun w : ↑unitInterval × Z.TotalSpace => 1 - (w.1 : ℝ), by continuity⟩⟩
    ?_ ?_).symm⟩
  · intro p
    show (⟨p.1, (1 - ((0 : ↑unitInterval) : ℝ)) • p.2⟩ : Z.TotalSpace) = p
    simp
  · intro p
    show (⟨p.1, (1 - ((1 : ↑unitInterval) : ℝ)) • p.2⟩ : Z.TotalSpace) =
      (totalProj Z ≫ Work.Tubular.zeroSectionTop Z) p
    rw [show (1 - ((1 : ↑unitInterval) : ℝ)) = 0 from by norm_num, zero_smul]
    rfl

/-- **The `8`-th singular homology of a connected `Man8` is `ℤ`.**  The localisation at any point
`x` is an injective map to the local group `H₈(V, V∖{x}) ≅ ℤ` whose image contains the local class
of the fundamental class, hence is everything. -/
theorem man8HomologyEightIso (V : Work.ThomBordism.Man8) [ConnectedSpace V.pt] :
    Nonempty ((Work.Cohomology.singularChains ℤ (TopCat.of V.pt)).homology 8 ≅
      ModuleCat.of ℤ ℤ) := by
  obtain ⟨x⟩ := (inferInstance : Nonempty V.pt)
  obtain ⟨eL⟩ := Work.Cohomology.localHomology 8 (by norm_num) V.pt x
  set φ : (Work.Cohomology.singularChains ℤ (TopCat.of V.pt)).homology 8 →ₗ[ℤ]
      Work.Orient.LocH (TopCat.of V.pt) 8 x :=
    (HomologicalComplex.homologyMap
      (cokernel.π (Work.Cohomology.inclChains (TopCat.of V.pt) {y : V.pt | y ≠ x})) 8).hom
  have hφc : φ V.c = Work.Orient.locClass (TopCat.of V.pt) 8 V.c x := rfl
  have hc_fund : Submodule.span ℤ
      ({Work.Orient.locClass (TopCat.of V.pt) 8 V.c x} :
        Set (Work.Orient.LocH (TopCat.of V.pt) 8 x)) = ⊤ :=
    V.c_fund x
  have hinj : Function.Injective φ := by
    intro u v huv
    have h1 : φ (u - v) = 0 := by rw [map_sub, huv, sub_self]
    have h2 : Work.Orient.locClass (TopCat.of V.pt) 8 (u - v) x = 0 := h1
    exact sub_eq_zero.mp (Work.Orient.eq_zero_of_locClass_eq_zero_at 8 (by norm_num)
      (TopCat.of V.pt) (u - v) x h2)
  have hle : Submodule.span ℤ
      ({Work.Orient.locClass (TopCat.of V.pt) 8 V.c x} : Set _) ≤ LinearMap.range φ := by
    rw [Submodule.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact ⟨V.c, hφc⟩
  have hrange : LinearMap.range φ = ⊤ := by
    rw [eq_top_iff, ← hc_fund]
    exact hle
  exact ⟨(LinearEquiv.ofBijective φ
    ⟨hinj, LinearMap.range_eq_top.mp hrange⟩).toModuleIso ≪≫ eL⟩

/-- **The `8`-th homology of the total space of a real bundle over a closed oriented path-connected
`8`-manifold is `ℤ`.** -/
theorem totalSpaceHomologyEightIso {V : Work.ThomBordism.Man8} {k : ℕ} {ι : Type}
    (Z : Work.TangentClasses.RealBundle V.pt (Fin k → ℝ) ι) [PathConnectedSpace V.pt] :
    Nonempty ((Work.Cohomology.singularChains ℤ (TopCat.of Z.TotalSpace)).homology 8 ≅ ModuleCat.of ℤ ℤ) := by
  obtain ⟨eB⟩ := man8HomologyEightIso V
  obtain ⟨hπz⟩ := totalProj_zeroSection_homotopy Z
  have hzπ : TopCat.Homotopy (Work.Tubular.zeroSectionTop Z ≫ totalProj Z)
      (𝟙 (TopCat.of V.pt)) := by
    have h : (Work.Tubular.zeroSectionTop Z ≫ totalProj Z) = 𝟙 (TopCat.of V.pt) := by
      apply TopCat.hom_ext
      ext p
      rfl
    rw [h]
    exact TopCat.Homotopy.refl _
  haveI : IsIso (HomologicalComplex.homologyMap (Work.Cohomology.chainMap ℤ (TopCat.of V.pt)
      (TopCat.of Z.TotalSpace) (Work.Tubular.zeroSectionTop Z)) 8) :=
    Work.Cohomology.homologyEquiv ℤ (TopCat.of V.pt) (TopCat.of Z.TotalSpace)
      (Work.Tubular.zeroSectionTop Z) (totalProj Z) hzπ hπz 8
  exact ⟨(asIso (HomologicalComplex.homologyMap (Work.Cohomology.chainMap ℤ (TopCat.of V.pt)
    (TopCat.of Z.TotalSpace) (Work.Tubular.zeroSectionTop Z)) 8)).symm ≪≫ eB⟩

end

end Work.ThomBordism
