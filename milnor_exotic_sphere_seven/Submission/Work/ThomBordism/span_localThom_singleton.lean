/-!
# A local Thom class over a point-piece generates

Let `Z` be a real bundle over `B` and let `τ ∈ H^n(X|_{{b}}, X|_{{b}}∖0)` be *local Thom data* of
`Z` over the one-point piece `{b}` — i.e. the local Thom map `x ↦ π^*(x) ⌣ τ` is bijective in
every degree (`Work.Thom.localThomMap`, `Work.Thom.LocalThom`).  The lemma below records the
consequence used in the construction of the Thom class: `τ` is then a **generator** of the whole
`ℤ`-module `H^n(X|_{{b}}, X|_{{b}}∖0)`.

The argument is one-dimensional.  In degree zero the local Thom map is
`H⁰({b};ℤ) → H^n(X|_{{b}}, X|_{{b}}∖0)`, `y ↦ π^*(y) ⌣ τ`; since `{b}` is a point, `H⁰({b};ℤ)`
is generated by the unit class (`Work.Thom.ptEv_eq_smul_oneH`), and the unit class acts by the
identity on relative cohomology (`Work.Thom.localThomMap_oneH`, which is
`Work.Thom.mixedCupC_oneH_zero` plus `Work.Thom.CohMap_oneH`).  Hence the image of the degree-zero
local Thom map is exactly `ℤ·τ`; by the surjectivity part of the hypothesis — `hτ 0` — it is also
all of `H^n(X|_{{b}}, X|_{{b}}∖0)`, so `τ` generates.

The only bookkeeping is that the target of the degree-zero local Thom map sits in degree `0 + n`
rather than `n`, so the comparison uses the degree cast along `Nat.zero_add n`
(`Work.Thom.cast_symm_cast_self` and the private `eqRec_smul_int` below).
-/

namespace Work.ThomBordism

open CategoryTheory

noncomputable section

/-- Transporting a scalar multiple across an equality of degrees. -/
private theorem eqRec_smul_int {M : ℕ → ModuleCat ℤ} {a b : ℕ} (h : a = b) (m : ℤ)
    (x : M a) : h ▸ (m • x) = m • (h ▸ x) := by cases h; rfl

/-- Cancelling the two transports across an equality of degrees. -/
private theorem eqRec_symm_eqRec_int {M : ℕ → ModuleCat ℤ} {a b : ℕ} (h : a = b) (x : M b) :
    h ▸ (h.symm ▸ x) = x := by cases h; rfl

/-- Every class of `H^n(X|_{{b}}, X|_{{b}}∖0)` is an integer multiple of a local Thom class `τ`
over the point `b`.  The multiple is produced in the form `m • τ`, i.e. as the value at `m` of the
`ℤ`-linear map `ℤ → H^n(X|_{{b}}, X|_{{b}}∖0)`, `m ↦ m • τ`. -/
private theorem localThom_exists_smul {B : Type} [TopologicalSpace B] {F : Type}
    [NormedAddCommGroup F] [NormedSpace ℝ F] {ι : Type} {n : ℕ}
    (Z : Work.TangentClasses.RealBundle B F ι) (b : B)
    (τ : Work.Thom.PieceCoh Z ({b} : Set B) n)
    (hτ : ∀ k : ℕ, Function.Bijective (Work.Thom.localThomMap Z n ({b} : Set B) τ k))
    (x : Work.Thom.PieceCoh Z ({b} : Set B) n) :
    ∃ m : ℤ, x = (LinearMap.toSpanSingleton ℤ (Work.Thom.PieceCoh Z ({b} : Set B) n) τ) m := by
  obtain ⟨y, hy⟩ := (hτ 0).2 ((Nat.zero_add n).symm ▸ x)
  -- the degree-zero local Thom map sends multiples of the unit class to multiples of `τ`
  have hkey : Work.Thom.localThomMap Z n ({b} : Set B) τ 0 y
      = (Nat.zero_add n).symm ▸ ((Work.Thom.ptEv ⟨b, rfl⟩ y) • τ) := by
    set c : ℤ := Work.Thom.ptEv ⟨b, rfl⟩ y
    have hy2 : y = c •
        (Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B)))) := by
      rw [show c = Work.Thom.ptEv ⟨b, rfl⟩ y from rfl]
      exact Work.Thom.ptEv_eq_smul_oneH (X := ↥({b} : Set B)) ⟨b, rfl⟩ y
    have hone : Work.Thom.localThomMap Z n ({b} : Set B) τ 0
        (Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B))))
        = (Nat.zero_add n).symm ▸ τ :=
      Work.Thom.localThomMap_oneH Z n ({b} : Set B) τ
    have hsmul : Work.Thom.localThomMap Z n ({b} : Set B) τ 0
        (c • Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B))))
        = c • (Work.Thom.localThomMap Z n ({b} : Set B) τ 0
            (Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B))))) :=
      map_zsmul _ c _
    calc Work.Thom.localThomMap Z n ({b} : Set B) τ 0 y
        = Work.Thom.localThomMap Z n ({b} : Set B) τ 0
            (c • Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B)))) := by
          rw [hy2]
      _ = c • (Work.Thom.localThomMap Z n ({b} : Set B) τ 0
            (Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of ↥({b} : Set B))))) := hsmul
      _ = c • ((Nat.zero_add n).symm ▸ τ) := by rw [hone]
      _ = (Nat.zero_add n).symm ▸ (c • τ) :=
            (eqRec_smul_int (M := fun k => Work.Thom.PieceCoh Z ({b} : Set B) k)
              (Nat.zero_add n).symm c τ).symm
  refine ⟨Work.Thom.ptEv ⟨b, rfl⟩ y, ?_⟩
  have h1 : x = (Nat.zero_add n) ▸ (Work.Thom.localThomMap Z n ({b} : Set B) τ 0 y) := by
    rw [hy]
    exact (eqRec_symm_eqRec_int (M := fun k => Work.Thom.PieceCoh Z ({b} : Set B) k)
      (Nat.zero_add n) x).symm
  rw [h1, hkey]
  rw [eqRec_symm_eqRec_int (M := fun k => Work.Thom.PieceCoh Z ({b} : Set B) k)
    (Nat.zero_add n) ((Work.Thom.ptEv ⟨b, rfl⟩ y) • τ)]
  rw [LinearMap.toSpanSingleton_apply]
  exact (int_smul_eq_zsmul _ _ τ).symm

/-- **A local Thom class over a singleton is a generator.**  If `τ ∈ H^n(X|_{b}, X|_{b}∖0)` is a
local Thom class of `Z` over the one-point piece `{b}` — i.e. the local Thom map
`x ↦ π^*(x) ⌣ τ` is bijective in every degree — then `τ` generates the whole of
`H^n(X|_{b}, X|_{b}∖0)` as a `ℤ`-module. -/
theorem span_localThom_singleton {B : Type} [TopologicalSpace B] {F : Type}
    [NormedAddCommGroup F] [NormedSpace ℝ F] {ι : Type} {n : ℕ}
    (Z : Work.TangentClasses.RealBundle B F ι) (b : B)
    (τ : Work.Thom.PieceCoh Z ({b} : Set B) n)
    (hτ : ∀ k : ℕ, Function.Bijective (Work.Thom.localThomMap Z n ({b} : Set B) τ k)) :
    Submodule.span ℤ {τ} = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro x
  obtain ⟨m, hm⟩ := localThom_exists_smul Z b τ hτ x
  exact Submodule.mem_span_singleton.mpr ⟨m, hm.symm⟩

end

end Work.ThomBordism
