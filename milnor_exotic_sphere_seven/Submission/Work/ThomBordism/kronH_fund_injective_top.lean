/-!
# The Kronecker pairing with the fundamental class is injective in the top degree

For a compact `T2` smooth `8`-manifold `V` with a fundamental class `V.c` and **path-connected**
underlying space, the Kronecker pairing

  `u ↦ ⟨u, V.c⟩ = kronH ℤ V.X 8 u V.c`

of a degree-`8` cohomology class with the fundamental class is **injective**: a class pairing
trivially with `[V]` is zero (`kronH_fund_injective_top`).

## Proof

Poincaré duality is available for the class `V.c` (`Work.ThomBordism.goodUniv_of_localGen`
produces `Good 8 V.c Set.univ` from the local-generation property `Man8.c_fund`, and
`Work.Cohomology.pd_capPair_of_good` converts it into bijectivity of the cap product
`y ↦ y ⌢ V.c : H⁸(V) → H₀(V)`), so it suffices to see that `u ⌢ V.c = 0`.

The cap/cup identity `Work.Cohomology.kronH_capPair_cup` at `(m, n) = (8, 0)` and the unit law
`Work.Cohomology.cupH'_one_right` give

  `⟨u, V.c⟩ = ⟨1, u ⌢ V.c⟩`,

so it is enough that `⟨1, ·⟩ : H₀(V) → ℤ` is injective.  That map is the augmentation: the lemma
`kronH_oneH_eq_homology₀ε` below identifies it with `SSet.homology₀ε`, which is an isomorphism
for a path-connected space (Mathlib's `SSet` instance, which applies to `toSSet.obj V.X`).

The proof of `kronH_oneH_eq_homology₀ε` uses that the zeroth cycles of the singular chain complex
are generated by the `0`-simplices (`Work.Cohomology.liftCycles_ext`, proved in
`Submission/Work/Cohomology/epsilonNaturality.lean`): on the class of the `0`-simplex `x` both the
Kronecker pairing with `oneH` (the class of the augmentation cochain `Work.Cohomology.unitCochain`)
and the augmentation `SSet.homology₀ε` take the value `1`
(`SSet.liftCycles_ιChainComplex_homologyπ_homology₀ε`).
-/

set_option linter.style.haveILetI false

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.ThomBordism

noncomputable section

/-- **The Kronecker pairing with the unit class is the augmentation of `H₀`.**

`⟨1, z⟩ = ε z` for every `z ∈ H₀(X;ℤ)`: both sides are `ℤ`-linear functionals on the zeroth
homology which agree on the classes of the `0`-simplices — a generating family of the zeroth
cycles (`Work.Cohomology.liftCycles_ext`) — where the value is `1`
(`Work.Cohomology.genEval_unitCochain` for the left-hand side,
`SSet.liftCycles_ιChainComplex_homologyπ_homology₀ε` for the right-hand side). -/
theorem kronH_oneH_eq_homology₀ε (X : SSet) :
    Work.Cohomology.kronH ℤ X 0 (Work.Cohomology.oneH ℤ X)
      = (X.homology₀ε (ModuleCat.of ℤ ℤ)).hom := by
  -- it suffices to compare the two functionals after composing with the epimorphism
  -- `homologyπ 0 : cycles 0 ⟶ H₀`, and then to compare them on the generators of the cycles
  have key : HomologicalComplex.homologyπ (X.chainComplex (ModuleCat.of ℤ ℤ)) 0 ≫
        ModuleCat.ofHom (Work.Cohomology.kronH ℤ X 0 (Work.Cohomology.oneH ℤ X))
      = HomologicalComplex.homologyπ (X.chainComplex (ModuleCat.of ℤ ℤ)) 0 ≫
        X.homology₀ε (ModuleCat.of ℤ ℤ) := by
    refine Work.Cohomology.liftCycles_ext X (ModuleCat.of ℤ ℤ) (fun x => ?_)
    -- the augmentation side is Mathlib's computation rule
    rw [SSet.liftCycles_ιChainComplex_homologyπ_homology₀ε]
    -- the Kronecker pairing side: an endomorphism of `ℤ`, tested on `1`
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    show Work.Cohomology.kronH ℤ X 0 (Work.Cohomology.oneH ℤ X)
        ((HomologicalComplex.homologyπ (Work.Cohomology.chainC ℤ X) 0)
          ((HomologicalComplex.liftCycles (X.chainComplex (ModuleCat.of ℤ ℤ))
            (X.ιChainComplex x) 0 (by simp) (by simp)) (1 : ℤ))) = 1
    rw [show Work.Cohomology.oneH ℤ X
        = Work.Cohomology.cohomologyClassOf ℤ X (Work.Cohomology.unitCochain ℤ X)
            (Work.Cohomology.cochainDiff_unitCochain ℤ X) from rfl]
    rw [Work.Cohomology.kronH_apply ℤ X (Work.Cohomology.unitCochain ℤ X)
      (Work.Cohomology.cochainDiff_unitCochain ℤ X)
      ((HomologicalComplex.liftCycles (X.chainComplex (ModuleCat.of ℤ ℤ))
        (X.ιChainComplex x) 0 (by simp) (by simp)) (1 : ℤ))]
    -- the cycle is the generator at `x`, on which the augmentation cochain takes the value `1`
    have hli := congrArg (fun (g : ModuleCat.of ℤ ℤ ⟶ (X.chainComplex (ModuleCat.of ℤ ℤ)).X 0) =>
        g.hom (1 : ℤ))
      (HomologicalComplex.liftCycles_i (X.chainComplex (ModuleCat.of ℤ ℤ)) (X.ιChainComplex x) 0
        (by simp) (by simp))
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at hli
    rw [hli]
    simpa only [Work.Cohomology.genEval] using Work.Cohomology.genEval_unitCochain ℤ X x
  -- cancel the epimorphism `homologyπ 0`
  have h2 := (cancel_epi (HomologicalComplex.homologyπ (X.chainComplex (ModuleCat.of ℤ ℤ)) 0)).mp key
  have h3 : (ModuleCat.ofHom (Work.Cohomology.kronH ℤ X 0 (Work.Cohomology.oneH ℤ X))).hom
      = (X.homology₀ε (ModuleCat.of ℤ ℤ)).hom := congrArg ModuleCat.Hom.hom h2
  rw [ModuleCat.hom_ofHom] at h3
  exact h3

/-- **The Kronecker pairing with the fundamental class is injective in the top degree.**

If `u ∈ H⁸(V;ℤ)` pairs trivially with the fundamental class `V.c ∈ H₈(V;ℤ)`, then `u = 0`.

The cap product with `V.c` is bijective in degree `(8,0)` (Poincaré duality, from
`Man8.c_fund`), and the cap/cup identity identifies the pairing `⟨u, V.c⟩` with `⟨1, u ⌢ V.c⟩`,
which is the augmentation of `H₀(V)` — injective because `V` is path connected. -/
theorem kronH_fund_injective_top (V : Work.ThomBordism.Man8) [PathConnectedSpace V.pt]
    (u : Work.Thom.Coh ℤ 8 V.X)
    (h : Work.Cohomology.kronH ℤ (TopCat.toSSet.obj V.X) 8 u V.c = 0) : u = 0 := by
  classical
  haveI : ConnectedSpace V.pt := PathConnectedSpace.connectedSpace
  set X : SSet := TopCat.toSSet.obj V.X with hX
  -- Poincaré duality: the cap product with the fundamental class is bijective in degree `(8,0)`
  have hgood : Work.Cohomology.Good 8 V.c (Set.univ : Set V.X) isOpen_univ :=
    goodUniv_of_localGen (N := 8) (M := V.X) V.c (fun x => V.c_fund x) (by norm_num)
  have hbij : Function.Bijective (fun y : (Work.Cohomology.cochainC ℤ X).homology 8 =>
      (Work.Cohomology.capPair ℤ X 8 0) y V.c) := by
    have hb := Work.Cohomology.pd_capPair_of_good (N := 8) V.X V.c hgood 8 0 (Nat.add_zero 8)
    show Function.Bijective (fun y : (Work.Cohomology.cochainC ℤ X).homology 8 =>
      (Work.Cohomology.capPair ℤ X 8 0) y (Nat.add_zero 8 ▸ V.c))
    exact hb
  -- the cap/cup identity together with the right unit law
  have hkey : Work.Cohomology.kronH ℤ X 8 u V.c
      = Work.Cohomology.kronH ℤ X 0 (Work.Cohomology.oneH ℤ X)
          ((Work.Cohomology.capPair ℤ X 8 0) u V.c) := by
    rw [Work.Cohomology.kronH_capPair_cup ℤ X 8 0 u (Work.Cohomology.oneH ℤ X) V.c]
    exact (congrArg (fun t => (Work.Cohomology.kronH ℤ X 8) t V.c)
      (Work.Cohomology.cupH'_one_right ℤ X 8 u)).symm
  -- the pairing with the unit class is the augmentation, hence injective
  have hκinj : Function.Injective (Work.Cohomology.kronH ℤ X 0 (Work.Cohomology.oneH ℤ X)) := by
    rw [kronH_oneH_eq_homology₀ε X]
    exact (ConcreteCategory.bijective_of_isIso (X.homology₀ε (ModuleCat.of ℤ ℤ))).1
  have hz : (Work.Cohomology.capPair ℤ X 8 0) u V.c = 0 :=
    hκinj (by rw [← hkey, h, map_zero])
  have hcap : (Work.Cohomology.capPair ℤ X 8 0) u V.c
      = (Work.Cohomology.capPair ℤ X 8 0) 0 V.c := by
    rw [hz]
    simp
  exact hbij.1 hcap

end

end Work.ThomBordism
