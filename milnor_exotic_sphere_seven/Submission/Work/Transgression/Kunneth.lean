/-!
# SUBPROJECT TRANSGRESSION: the `S³ × S³` machinery

The Mayer–Vietoris computation of `H⁴` of the sphere bundle of `clutchBundle a b`
(`Work.Transgression.PuncturedCohCard`, the remaining input of the chapter) is determined by the
class of the gluing map on `H³` of the overlap, an `S³ × S³`.  Two facts about `S³ × S³` are needed:

1. **Künneth injectivity** (`KunnethInj`): a class in `H³(S³ × S³; ℤ)` whose pullbacks along *both*
   factor inclusions `S³ → S³ × S³` vanish is zero.  Equivalently, `H³(S³ × S³; ℤ)` is freely
   generated by the classes of the two projections — its rank is `2` by
   `Work.Cohomology.cohomology_prod_sphere`.
2. **The class of the multiplication** (the "Hopf class"): the multiplication `m : S³ × S³ → S³` has
   class `π₁^* gen + π₂^* gen`.  *Given* (1) this is immediate from the two trivial identities
   `m (y, 1) = y`, `m (1, y) = y`, so (1) is the only content.

Both are used in the transgression: the class of the gluing map `(x, w) ↦ qTwist a b (dir x) w` on
`H³` is `(a+b) α + β`, written with the pointwise-product additivity that follows from the Hopf
class, and the `(a+b)` is the already-proved `Work.Transgression.clutchDegree_qTwist`.
-/

namespace Work.Transgression

open Work.TangentClasses

noncomputable section

/-- `S³ × S³` as the product of two copies of `S³ ⊆ ℝ⁴`. -/
abbrev S33 : TopCat := Work.Cohomology.PSph 3 3

/-- The sphere `S³ ⊆ ℝ⁴`, as a topological space. -/
abbrev S3s : TopCat := Work.Cohomology.sphTop 4

/-- The first projection `S³ × S³ → S³`. -/
def prj₁ : C(↥(S33), ↥(S3s)) := ⟨Prod.fst, continuous_fst⟩

/-- The second projection `S³ × S³ → S³`. -/
def prj₂ : C(↥(S33), ↥(S3s)) := ⟨Prod.snd, continuous_snd⟩

/-- The first factor inclusion `S³ → S³ × S³`, `y ↦ (y, N)`. -/
def sect₁ : C(↥(S3s), ↥(S33)) :=
  ⟨fun y => (y, Work.Cohomology.sphN 3), by fun_prop⟩

/-- The second factor inclusion `S³ → S³ × S³`, `y ↦ (N, y)`. -/
def sect₂ : C(↥(S3s), ↥(S33)) :=
  ⟨fun y => (Work.Cohomology.sphN 3, y), by fun_prop⟩

@[simp] lemma sect₁_apply (y : ↥(S3s)) : sect₁ y = (y, Work.Cohomology.sphN 3) := rfl

@[simp] lemma sect₂_apply (y : ↥(S3s)) : sect₂ y = (Work.Cohomology.sphN 3, y) := rfl

@[simp] lemma prj₁_comp_sect₁ : prj₁.comp sect₁ = ContinuousMap.id _ := by ext y; rfl

@[simp] lemma prj₂_comp_sect₂ : prj₂.comp sect₂ = ContinuousMap.id _ := by ext y; rfl

/-- The pullback along `sect₁` is a left inverse of the pullback along `prj₁`. -/
theorem sect₁_comp_prj₁ :
    (HMap sect₁ 3).hom.comp (HMap prj₁ 3).hom = LinearMap.id := by
  rw [← ModuleCat.hom_comp,
    ← HMap_comp (B₁ := ↥(S3s)) (B₂ := ↥(S33)) (B₃ := ↥(S3s)) sect₁ prj₁ 3,
    prj₁_comp_sect₁, HMap_id]
  rfl

/-- The pullback along `sect₂` is a left inverse of the pullback along `prj₂`. -/
theorem sect₂_comp_prj₂ :
    (HMap sect₂ 3).hom.comp (HMap prj₂ 3).hom = LinearMap.id := by
  rw [← ModuleCat.hom_comp,
    ← HMap_comp (B₁ := ↥(S3s)) (B₂ := ↥(S33)) (B₃ := ↥(S3s)) sect₂ prj₂ 3,
    prj₂_comp_sect₂, HMap_id]
  rfl

/-- **The Künneth injectivity input** for `S³ × S³`: the two factor restrictions jointly vanish only
for the zero class.  This is the single geometric fact about `S³ × S³` that the Mayer–Vietoris
transgression computation needs; it follows from the two Mayer–Vietoris chains
`S³ × S³ = (S³ × S³ ∖ {pt}) ∪ (capA × capA)` (second piece contractible) and
`S³ × S³ ∖ {pt} = ((S³ ∖ {N}) × S³) ∪ (S³ × (S³ ∖ {N}))` (intersection contractible), whose pieces
are `≃ S³` — all available in `Submission/Work/Cohomology/prodSphereDefs.lean`
(`homotopyEquiv_A1set`, `homotopyEquiv_B1set`, `contractible_A1set_inter_B1set`). -/
def KunnethInj : Prop :=
  ∀ x : ↥(Work.Thom.Coh ℤ 3 ↥(S33)),
    (HMap sect₁ 3).hom x = 0 → (HMap sect₂ 3).hom x = 0 → x = 0

end

end Work.Transgression
