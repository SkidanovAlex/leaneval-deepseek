/-!
# SUBPROJECT TRANSGRESSION: the `ℤ²` algebra of the transgression

Two purely algebraic facts used by the Mayer–Vietoris computation of
`Work.Transgression.PuncturedCohCard`:

* `Work.Transgression.QuotPairSpan` — the quotient of `ℤ²` by the span of `(0,1)` and `(n,1)` is
  `ZMod n.natAbs`.  This is the shape in which the transgression computation produces `H⁴` of the
  punctured total space: the two generators are the restrictions of the two generators of
  `H³(S³ × S³)`, and `n` is the degree `a + b` of the clutching function.

* `Work.Transgression.bijective_of_comp_eq_id_of_iso_two` — a split injection `ℤ² → M` into a
  `ℤ`-module isomorphic to `ℤ²` is bijective.  This is how the *Künneth injectivity*
  `Work.Transgression.KunnethInj` is obtained: the factor restrictions `H³(S³ × S³) → H³(S³)` are
  split by the factor inclusions, and `H³(S³ × S³) ≅ ℤ²`.
-/

namespace Work.Transgression

noncomputable section

/-! ## 1. The quotient of `ℤ²` by `⟨(0,1), (n,1)⟩` -/

/-- The `ℤ`-linear projection `ℤ × ℤ → ℤ ⧸ S` onto the first coordinate. -/
def pairProj (S : Submodule ℤ ℤ) : (ℤ × ℤ) →ₗ[ℤ] ℤ ⧸ S :=
  (Submodule.mkQ S).comp (LinearMap.fst ℤ ℤ ℤ)

@[simp] lemma pairProj_apply (S : Submodule ℤ ℤ) (x : ℤ × ℤ) :
    pairProj S x = Submodule.mkQ S x.1 := rfl

/-- **The quotient of `ℤ × ℤ` by the span of `(0,1)` and `(n,1)` is `ZMod n.natAbs`.**  The
subgroup generated by the two vectors is `nℤ × ℤ`, since `(n,1) - (0,1) = (n,0)`. -/
theorem QuotPairSpan (n : ℤ) :
    Nonempty (((ℤ × ℤ) ⧸ Submodule.span ℤ {((0 : ℤ), (1 : ℤ)), (n, 1)}) ≃ₗ[ℤ] ZMod n.natAbs) := by
  set S : Submodule ℤ ℤ := Submodule.span ℤ {n} with hS
  have hker : LinearMap.ker (pairProj S)
      = Submodule.span ℤ {((0 : ℤ), (1 : ℤ)), (n, 1)} := by
    ext x
    rw [LinearMap.mem_ker, Submodule.mem_span_pair, pairProj_apply, Submodule.mkQ_apply]
    constructor
    · intro hx
      have hx1 : x.1 ∈ S := (Submodule.Quotient.mk_eq_zero S).mp hx
      obtain ⟨k, hk⟩ := Submodule.mem_span_singleton.mp hx1
      refine ⟨x.2 - k, k, ?_⟩
      have h1 : (x.2 - k) • ((0 : ℤ), (1 : ℤ)) + k • ((n, 1) : ℤ × ℤ) = (k * n, x.2) := by
        ext <;> simp
      rw [h1]
      exact Prod.ext (by simpa [smul_eq_mul] using hk) rfl
    · rintro ⟨a, b, rfl⟩
      refine (Submodule.Quotient.mk_eq_zero S).mpr ?_
      rw [Submodule.mem_span_singleton]
      exact ⟨b, by simp [smul_eq_mul]⟩
  have hsurj : Function.Surjective (pairProj S) := by
    intro y
    obtain ⟨a, ha⟩ := Submodule.mkQ_surjective S y
    exact ⟨(a, 0), by rw [pairProj_apply]; exact ha⟩
  have e2 : ((ℤ × ℤ) ⧸ LinearMap.ker (pairProj S)) ≃ₗ[ℤ] (ℤ ⧸ S) :=
    (LinearMap.quotKerEquivRange (pairProj S)).trans
      ((LinearEquiv.ofEq _ _ (LinearMap.range_eq_top.mpr hsurj)).trans Submodule.topEquiv)
  have hspan' : (Submodule.span ℤ {n} : Submodule ℤ ℤ) = Ideal.span {((n.natAbs : ℤ))} := by
    rcases Int.natAbs_eq n with h | h
    · rw [h, Int.natAbs_natCast]
    · rw [h]
      rw [Int.natAbs_neg, Int.natAbs_natCast]
      exact Ideal.span_singleton_neg ((n.natAbs : ℤ))
  have e3 : (ℤ ⧸ S) ≃ₗ[ℤ] ZMod n.natAbs :=
    (Submodule.quotEquivOfEq S _ hspan').trans
      (AddEquiv.toIntLinearEquiv (Int.quotientSpanNatEquivZMod n.natAbs).toAddEquiv)
  exact ⟨(Submodule.quotEquivOfEq _ _ hker.symm).trans (e2.trans e3)⟩

/-! ## 2. A split injection `ℤ² → M` into a module isomorphic to `ℤ²` -/

/-- **An endomorphism of `ℤ²` which is a unit of the endomorphism ring is bijective.** -/
theorem bijective_of_isUnit_two (A : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) (h : IsUnit A) :
    Function.Bijective A := by
  obtain ⟨u, hu⟩ := h
  have hinv : (↑u⁻¹ : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)).comp A = LinearMap.id := by
    have h2 : (↑u⁻¹ : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ))
        * (↑u : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) = 1 := Units.inv_mul u
    rw [hu, Module.End.one_eq_id, Module.End.mul_eq_comp] at h2
    exact h2
  have hmul : A.comp (↑u⁻¹ : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) = LinearMap.id := by
    have h2 : (↑u : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ))
        * (↑u⁻¹ : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) = 1 := Units.mul_inv u
    rw [hu, Module.End.one_eq_id, Module.End.mul_eq_comp] at h2
    exact h2
  refine ⟨fun x y hxy => ?_, fun y => ⟨(↑u⁻¹ : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) y, ?_⟩⟩
  · have hx := LinearMap.congr_fun hinv x
    have hy := LinearMap.congr_fun hinv y
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at hx hy
    rw [← hx, hxy, hy]
  · have hy := LinearMap.congr_fun hmul y
    simpa only [LinearMap.comp_apply, LinearMap.id_apply] using hy

/-- **A split injection out of `ℤ²` into a module isomorphic to `ℤ²` is bijective.** -/
theorem bijective_of_comp_eq_id_of_iso_two {M : Type} [AddCommGroup M] [Module ℤ M]
    (T : (Fin 2 → ℤ) →ₗ[ℤ] M) (S : M →ₗ[ℤ] (Fin 2 → ℤ)) (h : S.comp T = LinearMap.id)
    (e : M ≃ₗ[ℤ] (Fin 2 → ℤ)) : Function.Bijective T := by
  have hsq : (S.comp (e.symm : (Fin 2 → ℤ) →ₗ[ℤ] M)).comp
      ((e : M →ₗ[ℤ] (Fin 2 → ℤ)).comp T) = LinearMap.id := by
    apply LinearMap.ext
    intro x
    show S ((e.symm : (Fin 2 → ℤ) →ₗ[ℤ] M) ((e : M →ₗ[ℤ] (Fin 2 → ℤ)) (T x))) = x
    rw [show (e.symm : (Fin 2 → ℤ) →ₗ[ℤ] M) ((e : M →ₗ[ℤ] (Fin 2 → ℤ)) (T x)) = T x
      from LinearEquiv.symm_apply_apply e (T x)]
    exact LinearMap.congr_fun h x
  have hunit : IsUnit (S.comp (e.symm : (Fin 2 → ℤ) →ₗ[ℤ] M)) :=
    IsUnit.of_mul_eq_one ((e : M →ₗ[ℤ] (Fin 2 → ℤ)).comp T) (by
      rw [Module.End.mul_eq_comp, hsq, Module.End.one_eq_id])
  have hbij : Function.Bijective (S.comp (e.symm : (Fin 2 → ℤ) →ₗ[ℤ] M)) :=
    bijective_of_isUnit_two _ hunit
  have hS : Function.Bijective S := by
    have hS1 : S = (S.comp (e.symm : (Fin 2 → ℤ) →ₗ[ℤ] M)).comp
        (e : M →ₗ[ℤ] (Fin 2 → ℤ)) := by
      ext x; simp
    rw [hS1]
    exact hbij.comp e.bijective
  have hT : ∀ z : M, T (S z) = z := fun z => by
    apply hS.injective
    have hx := LinearMap.congr_fun h (S z)
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at hx
    rw [hx]
  refine ⟨fun x y hxy => ?_, fun z => ⟨S z, hT z⟩⟩
  · have hx := LinearMap.congr_fun h x
    have hy := LinearMap.congr_fun h y
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at hx hy
    rw [← hx, hxy, hy]

end

end Work.Transgression
