/-!
# `σ(ℂP⁴) = ±1`

The signature of `ℂP⁴` (with the chosen fundamental class `Work.Projective.cp4C`) is `±1`: the
middle cohomology `H⁴(ℂP⁴;ℤ) = ℤ⟨u²⟩` is generated by the square `u²` of the hyperplane class
`u = c₁(O(1))` (`Work.Gen.uSqGenerates`, from the Gysin sequence of `O(1)`), and the self-pairing
`⟨u⁴, [ℂP⁴]⟩ = ⟨u² ⌣ u², cp4C⟩` is `±1` because `u⁴` generates `H⁸(ℂP⁴;ℤ)` and `cp4C` generates
`H₈(ℂP⁴;ℤ)` while the Kronecker pairing of generators is a unit.

This is the signature coordinate of the first Hirzebruch generator
(`Submission/Work/Gen/README.md` §3(A)3), proved on the Gen side (no Poincaré-duality input).
-/

namespace Work.Gen

open Work.Projective Work.Cohomology

noncomputable section

/-! ## `u³` and `H⁶(ℂP⁴;ℤ) = ℤ⟨u³⟩`, `H⁸(ℂP⁴;ℤ) = ℤ⟨u⁴⟩` -/

/-- `u³ = u² ⌣ u ∈ H⁶(ℂP⁴;ℤ)`. -/
def cp4u3 : Work.Thom.Coh ℤ 6 (CP 4) :=
  cupH' ℤ (TopCat.toSSet.obj (TopCat.of (CP 4))) 4 2 (uSq 4) (uCoh 4)

/-- **The Gysin sequence of `O(1)`**: `H⁶(ℂP⁴;ℤ) = ℤ⟨u³⟩`. -/
theorem cp4_u3_span : Submodule.span ℤ {cp4u3} = ⊤ := by
  have he : Work.Thom.gysinEuler uSqGen_T 4 (uSq 4) = cp4u3 := by
    rw [Work.Thom.gysinEuler_eq_cupEuler]
    rfl
  have hgen := uSqGen_span_map_eq_top_of_surjective (Work.Thom.gysinEuler uSqGen_T 4)
    (uSqGen_gysin_surj 4 (by norm_num) (by norm_num)) (uSq 4) uSqGenerates
  rwa [he] at hgen

/-- **The Gysin sequence of `O(1)`**: `H⁸(ℂP⁴;ℤ) = ℤ⟨u⁴⟩`. -/
theorem cp4_uFourth_span : Submodule.span ℤ {uFourth 4} = ⊤ := by
  have he : Work.Thom.gysinEuler uSqGen_T 6 cp4u3 = uFourth 4 := by
    rw [Work.Thom.gysinEuler_eq_cupEuler]
    exact cupH'_assoc ℤ (TopCat.toSSet.obj (TopCat.of (CP 4))) 4 2 2
      (uSq 4) (uCoh 4) (uCoh 4)
  have hgen := uSqGen_span_map_eq_top_of_surjective (Work.Thom.gysinEuler uSqGen_T 6)
    (uSqGen_gysin_surj 6 (by norm_num) (by norm_num)) cp4u3 cp4_u3_span
  rwa [he] at hgen

/-! ## The self-intersection `⟨u⁴, cp4C⟩ = ±1` -/

/-- **`⟨u⁴, cp4C⟩ = ±1`**: `u⁴` generates `H⁸(ℂP⁴;ℤ)`, `cp4C` generates the free module
`H₈(ℂP⁴;ℤ) ≅ ℤ`, and the Kronecker pairing `kronH` realises the duality. -/
theorem cp4_kronH_uFourth_pm_one :
    Work.Cohomology.kronH ℤ cp4SSet 8 (uFourth 4) cp4C = 1 ∨
      Work.Cohomology.kronH ℤ cp4SSet 8 (uFourth 4) cp4C = -1 := by
  have hbi : Function.Bijective (fun α : (cochainC ℤ cp4SSet).homology 8 =>
      Work.Cohomology.kronH ℤ cp4SSet 8 α) :=
    Work.Cohomology.kronH_isIso (CPSpace 4) (cpnHomFree 4) 8
  obtain ⟨f, hf⟩ := dual_eq_one_of_span_top'
    (Work.Cohomology.redH0_linEquivOfIso cp4HomIso) cp4C cp4C_span
  exact eval_eq_pm_one_of_generator' (Work.Cohomology.kronH ℤ cp4SSet 8)
    hbi.2 (uFourth 4) cp4_uFourth_span cp4C f hf

/-! ## The signature -/

theorem cp4Sigma : Work.Gen.cp4Smooth8.sigma = 1 ∨ Work.Gen.cp4Smooth8.sigma = -1 := by
  have hdef : Work.Gen.cp4Smooth8.sigma
      = Work.SignatureBordism.sigma 4 cp4SSet cp4C := rfl
  set V : ℤ := Work.Cohomology.kronH ℤ cp4SSet 8 (uFourth 4) cp4C with hV
  have hVpm : V = 1 ∨ V = -1 := by
    rcases cp4_kronH_uFourth_pm_one with h | h
    · exact Or.inl (by rw [hV, h])
    · exact Or.inr (by rw [hV, h])
  have hInter : Work.SignatureBordism.interForm ℤ cp4SSet 4 4 cp4C (uSq 4) (uSq 4) = V := by
    rw [hV, Work.SignatureBordism.interForm_apply]
    rfl
  have hsig : Work.Gen.cp4Smooth8.sigma = V := by
    rw [hdef]
    exact Work.SignatureBordism.sigma_eq_of_span_singleton_of_unimodular 4 cp4SSet cp4C
      (uSq 4) uSqGenerates hInter hVpm
  rcases hVpm with h | h
  · left; rw [hsig, h]
  · right; rw [hsig, h]

end

end Work.Gen
