/-!
# The Pontryagin numbers of `ℂP⁴`

`Work.Gen.CP4Numbers`: the triple `(p₁², p₂, σ)` of `ℂP⁴` computed with the **defined**
tangent-bundle classes `Work.Thom.p1Tangent'`, `p2Tangent'` is `(25, 10, 1)` or its negative,
according to the orientation selected by the fundamental class `Work.Projective.cp4C`.

The proof:

* `Work.Gen.EulerChern` identifies the defining Chern classes with the multiples `5·u²` and `10·u⁴`
  of the hyperplane class `u = Work.Gen.uCoh 4` (`Work.Gen.cp4_p1_eq`, `Work.Gen.cp4_p2_eq`, which
  combine `Work.Gen.EulerChern`, `Work.Gen.TangentPresentation` and the presentation change
  `Work.Gen.nonempty_bundleIso_mapFibre`);
* `Work.Gen.uSq_span` / `Work.Gen.uFourth_span` (the Gysin sequence of `O(1)`, exactly as in
  `Work.Gen.ChernGenerator`) show that `u²` generates `H⁴` and `u⁴` generates `H⁸`;
* hence the three numbers are `25·V`, `10·V` and `σ = V` for the single integer
  `V = ⟨u⁴, [ℂP⁴]⟩ = kronH 8 u⁴ cp4C`, which is `±1` because `H₈` is free of rank `1` with generator
  `cp4C` (`Work.Cohomology.kronH_isIso`, `Work.Projective.dual_eq_one_of_span_top'`).

## Status of the single external input

This file has **no unfilled proof of its own**; every lemma above the target is complete and its proof
uses only the permitted axioms, with one exception: the two Chern-class identities
`Work.Gen.cp4_p1Tangent_eq` / `Work.Gen.cp4_p2Tangent_eq` are derived from `Work.Gen.EulerChern`,
and `Work.Gen.EulerChern` is itself assembled and axiom-clean except for a *single* line, the
Whitney sum formula `have hW : Work.Gen.WhitneyFormula := ...`, which is owned by the sibling
subproject `Submission/Work/Whitney/` (`Work.Whitney.chernClass_whitneySum`).  The exact plug-in is
recorded in `Submission/Work/Gen/EULERCHERN_STATUS.md`.  As soon as that line is filled in,
`Work.Gen.CP4Numbers` is axiom-clean and `declare_proven` succeeds with no change to this file.
-/

namespace Work.Gen

open scoped Manifold

open Work.Projective Work.Cohomology

noncomputable section

/-! ## The vanishing of the cohomology of the puncture, in all degrees -/

/-- **`H^k(ℂ^{m+2}∖{0};ℤ) = 0`** off the degrees `0` and `2m+3`: the general-degree form of
`Work.Gen.ChernGen.puncturedComplexH2Zero`, obtained from the Mayer–Vietoris computation
`Work.Projective.cpnUV_cohomology_zero` through the homeomorphism `Work.Projective.cpnUV_homeo`. -/
theorem puncturedComplexHZero (m k : ℕ) (hk0 : k ≠ 0) (hktop : k ≠ 2 * m + 3) :
    CategoryTheory.Limits.IsZero
      (Work.Cohomology.singularCohomology ℤ k (TopCat.of {z : Fin (m + 2) → ℂ // z ≠ 0})) := by
  obtain ⟨e⟩ := Work.Cohomology.cohomologyIso_of_homotopyEquiv
    (Work.Projective.cpnUV_homeo (m + 2)).toHomotopyEquiv k
  have hz : CategoryTheory.Limits.IsZero
      (Work.Cohomology.singularCohomology ℤ k
        (TopCat.of ↥(Work.Projective.cpU (m + 2) ∩ Work.Projective.cpV (m + 2)))) :=
    Work.Projective.cpnUV_cohomology_zero (m + 1) k hk0 (by omega)
  exact CategoryTheory.Limits.IsZero.of_iso hz e.symm

/-- **`H^k` of the punctured total space of `realification (tautDual 4)` vanishes** off the degrees
`0` and `9`, since that space is the punctured model space `ℂ⁵∖0`
(`Work.Gen.ChernGen.tautDualPunctHomeo`), which is homotopy equivalent to `S⁹`. -/
theorem puncturedTautDual4HZero (k : ℕ) (hk0 : k ≠ 0) (hktop : k ≠ 9) :
    CategoryTheory.Limits.IsZero
      (Work.Thom.Coh ℤ k
        ↥(Work.Thom.zeroComplement (Work.Thom.realification (tautDual 4)))) := by
  obtain ⟨e⟩ := ChernGen.tautDualPunctHomeo 4
  obtain ⟨iso⟩ := Work.Cohomology.cohomologyIso_of_homotopyEquiv e.toHomotopyEquiv k
  exact CategoryTheory.Limits.IsZero.of_iso (puncturedComplexHZero 3 k hk0 (by omega)) iso

/-! ## The even cohomology of `ℂP⁴` is generated by powers of the hyperplane class -/

/-- The Thom class of the tautological dual line bundle `O(1)` over `ℂP⁴`; its Euler class is
`u = c₁(O(1)) = Work.Gen.uCoh 4` (`Work.Thom.chernClass_one_top`). -/
noncomputable def cp4T : Work.Thom.ThomClass (Work.Thom.realification (tautDual 4)) 2 :=
  Work.Thom.thomClassRank 1 (Nat.succ_le_succ (Nat.zero_le 0)) (tautDual 4)

/-- **The Gysin map `∪u : H^k(ℂP⁴;ℤ) → H^{k+2}(ℂP⁴;ℤ)` is surjective** when `k + 2 ≤ 8`: the
punctured total space of `O(1)` is homotopy equivalent to `S⁹`, hence has no cohomology in degree
`k + 2`, and the Gysin sequence `H^k → H^{k+2} → H^{k+2}(E∖0)` is exact. -/
theorem cp4_gysin_surj (k : ℕ) (hk0 : k + 2 ≠ 0) (hk : k + 2 ≠ 9) :
    Function.Surjective (Work.Thom.gysinEuler cp4T k) := by
  intro y
  have hvan := puncturedTautDual4HZero (k + 2) hk0 hk
  haveI : Subsingleton ↑(Work.Thom.Coh ℤ (k + 2)
      ↥(Work.Thom.zeroComplement (Work.Thom.realification (tautDual 4)))) :=
    ModuleCat.subsingleton_of_isZero hvan
  have hrange := Work.Thom.gysin_exact_at_base cp4T k
  have : y ∈ Set.range ⇑(Work.Thom.gysinEuler cp4T k) := by
    rw [hrange]
    exact Subsingleton.elim _ _
  exact this

/-- `u³ = u² ⌣ u ∈ H⁶(ℂP⁴;ℤ)`, the third power of the hyperplane class. -/
def u3 : Work.Thom.Coh ℤ 6 (CP 4) :=
  Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of (CP 4))) 4 2
    (Work.Gen.uSq 4) (Work.Gen.uCoh 4)

/-- **The Gysin sequence of `O(1)`**: `H⁴(ℂP⁴;ℤ) = ℤ⟨u²⟩`. -/
theorem uSq_span : Submodule.span ℤ {Work.Gen.uSq 4} = ⊤ := by
  have he : Work.Thom.gysinEuler cp4T 2 (Work.Gen.uCoh 4) = Work.Gen.uSq 4 := by
    rw [Work.Thom.gysinEuler_eq_cupEuler]
    rfl
  have hgen := span_singleton_map_eq_top' (Work.Thom.gysinEuler cp4T 2)
    (cp4_gysin_surj 2 (by norm_num) (by norm_num)) (Work.Gen.uCoh 4) ChernGenerator
  rwa [he] at hgen

/-- **The Gysin sequence of `O(1)`, second step**: `H⁶(ℂP⁴;ℤ) = ℤ⟨u³⟩`. -/
theorem u3_span : Submodule.span ℤ {u3} = ⊤ := by
  have he : Work.Thom.gysinEuler cp4T 4 (Work.Gen.uSq 4) = u3 := by
    rw [Work.Thom.gysinEuler_eq_cupEuler]
    rfl
  have hgen := span_singleton_map_eq_top' (Work.Thom.gysinEuler cp4T 4)
    (cp4_gysin_surj 4 (by norm_num) (by norm_num)) (Work.Gen.uSq 4) uSq_span
  rwa [he] at hgen

/-- **The Gysin sequence of `O(1)`, third step**: `H⁸(ℂP⁴;ℤ) = ℤ⟨u⁴⟩`. -/
theorem uFourth_span : Submodule.span ℤ {Work.Gen.uFourth 4} = ⊤ := by
  have he : Work.Thom.gysinEuler cp4T 6 u3 = Work.Gen.uFourth 4 := by
    rw [Work.Thom.gysinEuler_eq_cupEuler]
    exact Work.Cohomology.cupH'_assoc ℤ (TopCat.toSSet.obj (TopCat.of (CP 4))) 4 2 2
      (Work.Gen.uSq 4) (Work.Gen.uCoh 4) (Work.Gen.uCoh 4)
  have hgen := span_singleton_map_eq_top' (Work.Thom.gysinEuler cp4T 6)
    (cp4_gysin_surj 6 (by norm_num) (by norm_num)) u3 u3_span
  rwa [he] at hgen

/-! ## The middle self-intersection number is `±1` -/

/-- **`V = ⟨u⁴, [ℂP⁴]⟩ = ±1`**: since `H₈(ℂP⁴;ℤ)` is free with generator `cp4C` and `u⁴` generates
`H⁸(ℂP⁴;ℤ)`, the Kronecker pairing of the two generators is a unit of `ℤ`. -/
theorem kronH_uFourth_pm_one :
    Work.Cohomology.kronH ℤ cp4SSet 8 (Work.Gen.uFourth 4) cp4C = 1 ∨
      Work.Cohomology.kronH ℤ cp4SSet 8 (Work.Gen.uFourth 4) cp4C = -1 := by
  have hbi : Function.Bijective (fun α : (cochainC ℤ cp4SSet).homology 8 =>
      Work.Cohomology.kronH ℤ cp4SSet 8 α) :=
    Work.Cohomology.kronH_isIso (CPSpace 4) (cpnHomFree 4) 8
  obtain ⟨f, hf⟩ := Work.Projective.dual_eq_one_of_span_top'
    (Work.Cohomology.redH0_linEquivOfIso cp4HomIso) cp4C cp4C_span
  exact Work.Projective.eval_eq_pm_one_of_generator' (Work.Cohomology.kronH ℤ cp4SSet 8)
    hbi.2 (Work.Gen.uFourth 4) uFourth_span cp4C f hf


/-! ## The defined Pontryagin classes of `ℂP⁴` -/

/-- **`p₁(TℂP⁴) = 5u²`** with the *defined* class `Work.Thom.p1Tangent'`. -/
theorem cp4_p1Tangent_eq :
    Work.Thom.p1Tangent' (𝓘(ℝ, EuclideanSpace ℝ (Fin 8))) (CP 4)
      = (5 : ℤ) • Work.Gen.uSq 4 := by
  rw [Work.Thom.p1Tangent'_def, cp4ChernPresentation 2, Work.Gen.EulerChern.1, neg_neg]

/-- **`p₂(TℂP⁴) = 10u⁴`** with the *defined* class `Work.Thom.p2Tangent'`. -/
theorem cp4_p2Tangent_eq :
    Work.Thom.p2Tangent' (𝓘(ℝ, EuclideanSpace ℝ (Fin 8))) (CP 4)
      = (10 : ℤ) • Work.Gen.uFourth 4 := by
  rw [Work.Thom.p2Tangent'_def, cp4ChernPresentation 4, Work.Gen.EulerChern.2]

/-! ## The numbers of `ℂP⁴` -/

theorem CP4Numbers :
    (Work.Gen.cp4Smooth8.p1Sq = 25 ∧ Work.Gen.cp4Smooth8.p2Num = 10 ∧
      Work.Gen.cp4Smooth8.sigma = 1) ∨
    (Work.Gen.cp4Smooth8.p1Sq = -25 ∧ Work.Gen.cp4Smooth8.p2Num = -10 ∧
      Work.Gen.cp4Smooth8.sigma = -1) := by
  set V : ℤ := Work.Cohomology.kronH ℤ cp4SSet 8 (Work.Gen.uFourth 4) cp4C with hV
  have hVpm : V = 1 ∨ V = -1 := by
    rcases kronH_uFourth_pm_one with h | h
    · exact Or.inl (by rw [hV, h])
    · exact Or.inr (by rw [hV, h])
  have hInter : Work.SignatureBordism.interForm ℤ cp4SSet 4 4 cp4C
      (Work.Gen.uSq 4) (Work.Gen.uSq 4) = V := by
    rw [hV, Work.SignatureBordism.interForm_apply]
    rfl
  have hp1 : Work.Gen.cp4Smooth8.p1Sq = 25 * V := by
    have h := Work.SignatureBordism.p₁SqNumber_eq_sq cp4SSet cp4C (Work.Gen.uSq 4)
      (Work.Thom.p1Tangent' (𝓘(ℝ, EuclideanSpace ℝ (Fin 8))) (CP 4)) cp4_p1Tangent_eq hInter
    show Work.SignatureBordism.p₁SqNumber cp4SSet cp4C
      (Work.Thom.p1Tangent' (𝓘(ℝ, EuclideanSpace ℝ (Fin 8))) (CP 4)) = 25 * V
    rw [h]
    norm_num
  have hp2 : Work.Gen.cp4Smooth8.p2Num = 10 * V := by
    show Work.SignatureBordism.p₂Number cp4SSet cp4C
      (Work.Thom.p2Tangent' (𝓘(ℝ, EuclideanSpace ℝ (Fin 8))) (CP 4)) = 10 * V
    rw [Work.SignatureBordism.p₂Number_apply, cp4_p2Tangent_eq, hV]
    simp only [map_zsmul, LinearMap.smul_apply, smul_eq_mul]
  have hsig : Work.Gen.cp4Smooth8.sigma = V := by
    show Work.SignatureBordism.sigma 4 cp4SSet cp4C = V
    exact Work.SignatureBordism.sigma_eq_of_span_singleton_of_unimodular 4 cp4SSet cp4C
      (Work.Gen.uSq 4) uSq_span hInter hVpm
  rcases hVpm with h | h
  · left
    rw [hp1, hp2, hsig, h]
    norm_num
  · right
    rw [hp1, hp2, hsig, h]
    norm_num

end

end Work.Gen
