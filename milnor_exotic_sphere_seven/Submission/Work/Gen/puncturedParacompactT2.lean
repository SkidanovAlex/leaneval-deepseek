variable {B : Type*} [TopologicalSpace B] {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
variable {ι : Type*}

/-! ## Hausdorffness of the total space of a real bundle

The total space of `RealBundle B F ι = VectorBundleCore ℝ B F ι` carries the topology generated by
the local trivialisations; it is not the product topology on `B × F`.  Hausdorffness is proved
directly: two points in different fibres are separated by pulling back disjoint open sets of the
Hausdorff base along the continuous projection, and two distinct points of the same fibre are
separated inside the source of the trivialisation at their common base point, which is an open
partial homeomorphism onto a subspace of the Hausdorff space `B × F`. -/

theorem t2Space_totalSpace (Z : RealBundle B F ι) [T2Space B] [T2Space F] :
    T2Space Z.TotalSpace := by
  classical
  refine ⟨fun p q hpq => ?_⟩
  by_cases h1 : p.1 = q.1
  · have hb : p.1 ∈ Z.baseSet (Z.indexAt p.1) := Z.mem_baseSet_at p.1
    have hps : p ∈ (Z.localTriv (Z.indexAt p.1)).source :=
      (Z.localTriv (Z.indexAt p.1)).mem_source.mpr hb
    have hbq : q.1 ∈ Z.baseSet (Z.indexAt p.1) := by rw [← h1]; exact hb
    have hqs : q ∈ (Z.localTriv (Z.indexAt p.1)).source :=
      (Z.localTriv (Z.indexAt p.1)).mem_source.mpr hbq
    have h2 : ((Z.localTriv (Z.indexAt p.1)) p).2 ≠ ((Z.localTriv (Z.indexAt p.1)) q).2 := by
      intro hc
      apply hpq
      have hpair : (Z.localTriv (Z.indexAt p.1)) p = (Z.localTriv (Z.indexAt p.1)) q := by
        refine Prod.ext ?_ hc
        rw [show ((Z.localTriv (Z.indexAt p.1)) p).1 = Z.proj p from
              (Z.localTriv (Z.indexAt p.1)).proj_toFun p hps,
            show ((Z.localTriv (Z.indexAt p.1)) q).1 = Z.proj q from
              (Z.localTriv (Z.indexAt p.1)).proj_toFun q hqs]
        exact h1
      have hp_inv : ((Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph).symm
          ((Z.localTriv (Z.indexAt p.1)) p) = p :=
        ((Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph).left_inv hps
      have hq_inv : ((Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph).symm
          ((Z.localTriv (Z.indexAt p.1)) q) = q :=
        ((Z.localTriv (Z.indexAt p.1)).toOpenPartialHomeomorph).left_inv hqs
      rw [← hp_inv, ← hq_inv, hpair]
    obtain ⟨V, W, hVo, hWo, hVmem, hWmem, hVW⟩ := t2_separation h2
    refine ⟨Subtype.val '' ((Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd ⁻¹'
          (Set.univ ×ˢ V)),
      Subtype.val '' ((Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd ⁻¹'
          (Set.univ ×ˢ W)), ?_, ?_, ?_, ?_, ?_⟩
    · exact ((Z.localTriv (Z.indexAt p.1)).open_source).isOpenMap_subtype_val _
        ((isOpen_univ.prod hVo).preimage
          ((Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd.continuous))
    · exact ((Z.localTriv (Z.indexAt p.1)).open_source).isOpenMap_subtype_val _
        ((isOpen_univ.prod hWo).preimage
          ((Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd.continuous))
    · refine ⟨⟨p, hps⟩, ?_, rfl⟩
      show (Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd ⟨p, hps⟩ ∈ Set.univ ×ˢ V
      rw [(Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd_apply]
      exact ⟨trivial, hVmem⟩
    · refine ⟨⟨q, hqs⟩, ?_, rfl⟩
      show (Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd ⟨q, hqs⟩ ∈ Set.univ ×ˢ W
      rw [(Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd_apply]
      exact ⟨trivial, hWmem⟩
    · refine Set.disjoint_left.mpr fun x hx hx' => ?_
      obtain ⟨a, ha, rfl⟩ := hx
      obtain ⟨b, hb', hba⟩ := hx'
      have hab : a = b := Subtype.ext hba.symm
      have hmem : ((Z.localTriv (Z.indexAt p.1)).sourceHomeomorphBaseSetProd a).2 ∈ V ∩ W :=
        ⟨ha.2, by rw [hab]; exact hb'.2⟩
      exact Set.disjoint_left.mp hVW hmem.1 hmem.2
  · obtain ⟨U, V, hUo, hVo, hpU, hqV, hUV⟩ := t2_separation h1
    refine ⟨Z.proj ⁻¹' U, Z.proj ⁻¹' V, hUo.preimage Z.continuous_proj,
      hVo.preimage Z.continuous_proj, hpU, hqV, Disjoint.preimage Z.proj hUV⟩

theorem t2Space_punct {B : Type*} [TopologicalSpace B] {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℝ F] {ι : Type*} [T2Space B] (Z : RealBundle B F ι) :
    T2Space ↥(Work.Thom.zeroComplement Z) := by
  haveI : T2Space F := inferInstance
  haveI : T2Space Z.TotalSpace := t2Space_totalSpace Z
  infer_instance

/-! ## The open enlargements of the slabs are open -/

theorem isOpen_slabO {B : Type*} [TopologicalSpace B] {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℝ F] {ι : Type*} [Fintype ι] (Z : RealBundle B F ι) (φ : ι → C(B, ℝ))
    (hcont : Continuous (slabNu Z φ)) (j : ℤ) : IsOpen (slabO Z φ j) := by
  have h1 : IsOpen {p : Z.TotalSpace | (2:ℝ) ^ j / 2 < slabNu Z φ p} :=
    isOpen_lt continuous_const hcont
  have h2 : IsOpen {p : Z.TotalSpace | slabNu Z φ p < 2 * (2:ℝ) ^ (j + 1)} :=
    isOpen_lt hcont continuous_const
  show IsOpen (Subtype.val ⁻¹' ({p : Z.TotalSpace | (2:ℝ) ^ j / 2 < slabNu Z φ p} ∩
    {p : Z.TotalSpace | slabNu Z φ p < 2 * (2:ℝ) ^ (j + 1)}))
  exact (h1.inter h2).preimage continuous_subtype_val

/-! ## The main theorem -/

/-- **The punctured total space of a real vector bundle over a paracompact Hausdorff base is again
paracompact Hausdorff.**

This is the topological input of the *peeling* reduction of the Whitney sum formula: peeling a
summand off a direct sum uses the descent over the punctured total space `E∖0`, and the induction
that reduces the ranks then has to apply the formula at that punctured base, which requires it to be
paracompact Hausdorff.

The paracompactness proof goes through the general topological lemma
`Work.Gen.paracompactSpace_of_compact_slabs`, applied to the projection `punctProj Z` of the
punctured total space and to the *dyadic slabs*

`slabK Z ρ j = {x : 2^j ≤ ν x ≤ 2^(j+1)}`,  `slabO Z ρ j = {x : 2^j/2 < ν x < 2·2^(j+1)}`

of the weighted fibrewise norm `ν = slabNu Z ρ` built from a partition of unity `ρ` subordinate to
the chart cover of `Z`.  The four inputs are `Work.Gen.exists_mem_slabK` (the slabs cover the
punctured space), `Work.Gen.escape_slabO` (the enlargements meet a given point's neighbourhood only
finitely often), `Work.Gen.isCompact_slabK_fibre` (the fibre piece of a slab is compact, using
`ProperSpace F`) and `Work.Gen.slabK_tube` (the tube property for a slab piece, from local
triviality and the compactness of the piece).  Hausdorffness is a subspace of the Hausdorff total
space `t2Space_totalSpace`. -/
theorem puncturedParacompactT2 {B F ι : Type*} [TopologicalSpace B] [ParacompactSpace B] [T2Space B]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [ProperSpace F] [Fintype ι]
    (Z : VectorBundleCore ℝ B F ι) :
    ParacompactSpace ↥(Work.Thom.zeroComplement Z) ∧
      T2Space ↥(Work.Thom.zeroComplement Z) := by
  classical
  haveI : T2Space F := inferInstance
  refine ⟨?_, t2Space_punct Z⟩
  -- a partition of unity subordinate to the chart cover
  have hcover : (Set.univ : Set B) ⊆ ⋃ i, Z.baseSet i := by
    intro b _
    exact Set.mem_iUnion.mpr ⟨Z.indexAt b, Z.mem_baseSet_at b⟩
  obtain ⟨ρ, hρ⟩ := PartitionOfUnity.exists_isSubordinate
    (show IsClosed (Set.univ : Set B) from isClosed_univ) (fun i => Z.baseSet i)
    (fun i => Z.isOpen_baseSet i) hcover
  have hφ : ∀ i, tsupport (ρ i) ⊆ Z.baseSet i := hρ
  have hnn : ∀ i b, 0 ≤ ρ i b := fun i b => ρ.nonneg i b
  have hpos : ∀ b, 0 < ∑ i, ρ i b := by
    intro b
    have h : ∑ᶠ i, ρ i b = 1 := ρ.sum_eq_one (Set.mem_univ b)
    rw [finsum_eq_sum_of_fintype] at h
    rw [h]
    norm_num
  have hcont : Continuous (slabNu Z ρ) := continuous_slabNu Z ρ hφ
  exact paracompactSpace_of_compact_slabs (punctProj Z) (slabK Z ρ) (slabO Z ρ)
    (fun j => isOpen_slabO Z ρ hcont j)
    (fun j => slabK_subset_slabO Z ρ j)
    (fun x => exists_mem_slabK Z ρ hφ hnn hpos x)
    (fun x => escape_slabO Z ρ hcont hφ hnn hpos x)
    (fun j b => isCompact_slabK_fibre Z ρ hφ hnn hpos hcont j b)
    (fun j b P hP hsub => slabK_tube Z ρ hφ hcont hnn hpos j b P hP hsub)

end

end Work.Gen
