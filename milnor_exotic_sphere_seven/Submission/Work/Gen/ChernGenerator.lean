/-!
# The hyperplane class `c₁(O(1)) ∈ H²(ℂP⁴;ℤ)` generates `H²(ℂP⁴;ℤ)`

`Work.Gen.ChernGenerator` is the *normalisation* of the Gen area: the first Chern class
`Work.Gen.uCoh 4 = c₁(O(1))` of the dual tautological line bundle on `ℂP⁴` is a generator of
`H²(ℂP⁴;ℤ) ≅ ℤ` (up to sign, as is forced by the global sign normalisation of
`Work.Thom.chernClass`).

## The argument

Let `Z = realification (tautDual 4)` be the real rank-`2` bundle underlying `O(1)`, and let
`T = Work.Thom.thomClassRank 1 _ (tautDual 4)` be its Thom class; then `T.eulerClass` *is*
`Work.Gen.uCoh 4` (`Work.Thom.chernClass_one_top`, definitionally for this choice of Thom class).
The Gysin sequence of `Z` gives, in degrees `0 → 2`, the exactness

`Set.range (gysinEuler T 0) = {x | gysinπ Z 2 x = 0}`   (`Work.Thom.gysin_exact_at_base`),

and `gysinEuler T 0` is `x ↦ x ⌣ e` (`Work.Thom.gysinEuler_eq_cupEuler`).  The punctured total
space `E∖0` of `Z` is the punctured model space `ℂ⁵∖{0}` (`tautDualPunctHomeo` below), whose `H²`
vanishes (`puncturedComplexH2Zero`), so `gysinπ Z 2 = 0` and `gysinEuler T 0` is surjective.
Since `H⁰(ℂP⁴;ℤ) = ℤ⟨1⟩` for the path connected `ℂP⁴` (`Work.Cohomology.exists_smul_oneH`), the
range of `gysinEuler T 0` — which is all of `H²(ℂP⁴;ℤ)` — is already generated by
`gysinEuler T 0 1 = 1 ⌣ e = e`.  Hence `Submodule.span ℤ {uCoh 4} = ⊤`.

## The two inputs

* `puncturedComplexH2Zero m : H²(ℂ^{m+2}∖{0};ℤ) = 0` — the sphere computation, from
  `Work.Projective.cpnUV_cohomology_zero` together with the identification
  `Work.Projective.cpnUV_homeo` of `cpU (m+2) ∩ cpV (m+2)` with `ℂ^{m+2}∖0`;
* `tautDualPunctHomeo n : E∖0 ≅ ℂ^{n+1}∖{0}` for `E = realification (tautDual n)` — the
  tautological identification, proved in `Work.Gen.ChernGen` below by the explicit chart-free map
  `p ↦ (fibre coordinate)⁻¹ • u_{indexAt}`; see the docstrings there.
-/

namespace Work.Gen

noncomputable section

open Work.Projective Filter

set_option maxHeartbeats 1600000
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace ChernGen

variable {n : ℕ}

/-- The normalised vector of `ℂ^{n+1}` spanning the projective point `x`, read in the chart `i`:
`uVec n i x j = homCoord n i j x` (so that its `i`-th coordinate is `1`). -/
noncomputable def uVec (n : ℕ) (i : Fin (n + 1)) (x : CP n) : CPV n := fun j => homCoord n i j x

@[simp] theorem uVec_apply (i : Fin (n + 1)) (x : CP n) (j : Fin (n + 1)) :
    uVec n i x j = homCoord n i j x := rfl

theorem uVec_self (i : Fin (n + 1)) (x : CP n) : uVec n i x i = 1 := by
  simp [uVec]

theorem uVec_ne_zero (i : Fin (n + 1)) (x : CP n) : uVec n i x ≠ 0 := fun h => by
  have := congrFun h i
  rw [uVec_self] at this
  exact one_ne_zero this

/-- `homCoord` in the parametrisation by `chartInv`. -/
theorem homCoord_chartInv (i k : Fin (n + 1)) (w : Fin n → ℂ) :
    homCoord n i k (chartInv i w) =
      (Fin.insertNth (α := fun _ => ℂ) i (1 : ℂ) w) k := by
  by_cases h : k = i
  · subst h
    rw [homCoord_self, Fin.insertNth_apply_same]
  · rw [homCoord_of_ne h, chartInv_apply, chartFun_cpMk, chartFunAux, succAbove_removeAbove]
    simp [Fin.insertNth_apply_same]

/-- `homCoord` as a ratio of homogeneous coordinates. -/
theorem homCoord_cpMk (i : Fin (n + 1)) (v : {v : CPV n // v ≠ 0}) (hv : v.1 i ≠ 0)
    (k : Fin (n + 1)) : homCoord n i k (cpMk n v) = v.1 k / v.1 i := by
  have hx : cpMk n v = chartInv i (chartFun i (cpMk n v)) :=
    (chartInv_chartFun i (cpMk n v) ((mem_chartSet_iff i v).mpr hv)).symm
  rw [hx, homCoord_chartInv, chartFun_cpMk, insertNth_chartFunAux i v hv, Pi.smul_apply,
    smul_eq_mul]
  rw [div_eq_inv_mul]

/-- The cocycle identity `uᵢ = (z_j/z_i)·uⱼ` of the normalised spanning vectors, valid on the
overlap of the charts (where it is a statement about the `i`-th and `j`-th homogeneous
coordinates; no hypothesis on `k` is needed). -/
theorem homCoord_mul_of_mem {i j : Fin (n + 1)} {x : CP n} (hi : x ∈ chartSet i)
    (hj : x ∈ chartSet j) (k : Fin (n + 1)) :
    homCoord n i j x * homCoord n j k x = homCoord n i k x := by
  obtain ⟨v, rfl⟩ := cpMk_surjective n x
  have hvi : v.1 i ≠ 0 := (mem_chartSet_iff i v).mp hi
  have hvj : v.1 j ≠ 0 := (mem_chartSet_iff j v).mp hj
  rw [homCoord_cpMk i v hvi j, homCoord_cpMk j v hvj k, homCoord_cpMk i v hvi k]
  field_simp

theorem homCoord_ne_zero_of_mem {i j : Fin (n + 1)} {x : CP n} (hi : x ∈ chartSet i)
    (hj : x ∈ chartSet j) : homCoord n i j x ≠ 0 := by
  have h := homCoord_mul_of_mem (i := j) (j := i) (k := j) hj hi
  rw [homCoord_self] at h
  intro h0
  rw [h0, mul_zero] at h
  exact one_ne_zero h.symm

theorem uVec_cocycle {i j : Fin (n + 1)} {x : CP n} (hi : x ∈ chartSet i)
    (hj : x ∈ chartSet j) : uVec n i x = homCoord n i j x • uVec n j x := by
  funext k
  exact (homCoord_mul_of_mem hi hj k).symm

theorem continuousOn_uVec (i : Fin (n + 1)) : ContinuousOn (uVec n i) (chartSet i) :=
  continuousOn_pi.mpr fun j => continuousOn_homCoord i j
/-! ## The fibre coordinate and the map -/

/-- The complex coordinate of a vector of the rank-one fibre `EuclideanSpace ℂ (Fin 1)`. -/
noncomputable def sc (v : EuclideanSpace ℂ (Fin 1)) : ℂ := (EuclideanSpace.equiv (Fin 1) ℂ v) 0

theorem continuous_sc : Continuous sc := by
  unfold sc
  fun_prop

theorem sc_smul (c : ℂ) (v : EuclideanSpace ℂ (Fin 1)) : sc (c • v) = c * sc v := by
  rw [sc, sc, (EuclideanSpace.equiv (Fin 1) ℂ).map_smul, Pi.smul_apply, smul_eq_mul]

theorem sc_zero : sc (0 : EuclideanSpace ℂ (Fin 1)) = 0 := by
  simp [sc]

/-- The vector of the fibre with coordinate `c`. -/
noncomputable def toc (c : ℂ) : EuclideanSpace ℂ (Fin 1) :=
  (EuclideanSpace.equiv (Fin 1) ℂ).symm (fun _ => c)

theorem sc_toc (c : ℂ) : sc (toc c) = c := by
  rw [sc, toc, (EuclideanSpace.equiv (Fin 1) ℂ).apply_symm_apply]

theorem toc_zero : toc 0 = 0 := by
  change (EuclideanSpace.equiv (Fin 1) ℂ).symm (0 : Fin 1 → ℂ) = 0
  exact map_zero _

theorem toc_sc (v : EuclideanSpace ℂ (Fin 1)) : toc (sc v) = v := by
  rw [toc, sc]
  have h : (fun _ : Fin 1 => (EuclideanSpace.equiv (Fin 1) ℂ v) 0)
      = EuclideanSpace.equiv (Fin 1) ℂ v := by
    funext i
    fin_cases i
    rfl
  rw [h, (EuclideanSpace.equiv (Fin 1) ℂ).symm_apply_apply]

theorem sc_ne_zero_iff (v : EuclideanSpace ℂ (Fin 1)) : sc v ≠ 0 ↔ v ≠ 0 := by
  constructor
  · intro h hv
    exact h (by rw [hv, sc_zero])
  · intro h hv
    exact h (by rw [← toc_sc v, hv, toc_zero])

/-- The raw fibre coordinate, re-typed as a vector of the model fibre. -/
noncomputable def raw (n : ℕ) (p : (tautDual n).TotalSpace) : EuclideanSpace ℂ (Fin 1) := p.2
/-- **The chart-independent map** from the total space of `O(1)` to `ℂ^{n+1}`: the normalised
spanning vector of the base point, divided (in the sense of `ℂ*`) by the fibre coordinate. -/
noncomputable def Phi (n : ℕ) (p : (tautDual n).TotalSpace) : CPV n :=
  (sc (raw n p))⁻¹ • uVec n ((tautDual n).indexAt p.1) p.1

theorem localTriv_snd_eq {n : ℕ} (i : Fin (n + 1)) (p : (tautDual n).TotalSpace) :
    (((tautDual n).localTriv i p).2 : EuclideanSpace ℂ (Fin 1)) =
      homCoord n i ((tautDual n).indexAt p.1) p.1 • raw n p := by
  rw [VectorBundleCore.localTriv_apply, tautDual_coordChange]
  rfl

theorem Phi_eq_localTriv {n : ℕ} (i : Fin (n + 1)) (p : (tautDual n).TotalSpace)
    (hp : p.1 ∈ chartSet i) :
    Phi n p = (sc (((tautDual n).localTriv i p).2 : EuclideanSpace ℂ (Fin 1)))⁻¹
      • uVec n i p.1 := by
  set j := (tautDual n).indexAt p.1 with hj
  have hjmem : p.1 ∈ chartSet j := (tautDual n).mem_baseSet_at p.1
  have hne : homCoord n i j p.1 ≠ 0 := homCoord_ne_zero_of_mem hp hjmem
  have hsc : sc ((((tautDual n).localTriv i p).2 : EuclideanSpace ℂ (Fin 1)))
      = homCoord n i j p.1 * sc (raw n p) := by
    rw [localTriv_snd_eq, sc_smul]
  have hvec : uVec n i p.1 = homCoord n i j p.1 • uVec n j p.1 := uVec_cocycle hp hjmem
  have hgoal : Phi n p = (sc (raw n p))⁻¹ • uVec n j p.1 := rfl
  rw [hgoal, hsc, hvec, smul_smul]
  congr 1
  rw [mul_inv_rev, mul_assoc, inv_mul_cancel₀ hne, mul_one]

theorem Phi_ne_zero {n : ℕ} (p : ↥(Work.Thom.zeroComplementCore (tautDual n))) :
    Phi n p.1 ≠ 0 := by
  intro h
  have hpne : raw n p.1 ≠ 0 := fun hc => p.2 hc
  set j := (tautDual n).indexAt p.1.1 with hj
  have hgoal : Phi n p.1 = (sc (raw n p.1))⁻¹ • uVec n j p.1.1 := rfl
  rw [hgoal] at h
  rcases smul_eq_zero.mp h with h1 | h2
  · exact (inv_ne_zero ((sc_ne_zero_iff _).mpr hpne)) h1
  · exact uVec_ne_zero j p.1.1 h2

theorem continuousOn_Phi (n : ℕ) :
    ContinuousOn (Phi n) (Work.Thom.zeroComplementCore (tautDual n)) := by
  set Z := tautDual n with hZ
  intro p hp
  let i : Fin (n + 1) := Z.indexAt p.1
  have hpmem : p.1 ∈ chartSet i := Z.mem_baseSet_at p.1
  have hsource : p ∈ (Z.localTriv i).source :=
    (VectorBundleCore.mem_localTriv_source Z i p).mpr hpmem
  have hpne : raw n p ≠ 0 := fun hc => hp hc
  have htriv : ContinuousAt (fun q : Z.TotalSpace => Z.localTriv i q) p :=
    (Z.localTriv i).continuousOn.continuousAt ((Z.localTriv i).open_source.mem_nhds hsource)
  have hsnd : ContinuousAt
      (fun q : Z.TotalSpace => (((Z.localTriv i q).2) : EuclideanSpace ℂ (Fin 1))) p :=
    (continuous_snd.continuousAt).comp htriv
  have hsc : ContinuousAt
      (fun q : Z.TotalSpace => sc (((Z.localTriv i q).2) : EuclideanSpace ℂ (Fin 1))) p :=
    continuous_sc.continuousAt.comp hsnd
  have hval : sc (((Z.localTriv i p).2) : EuclideanSpace ℂ (Fin 1)) ≠ 0 := by
    rw [localTriv_snd_eq, sc_smul]
    exact mul_ne_zero (homCoord_ne_zero_of_mem hpmem (Z.mem_baseSet_at p.1))
      ((sc_ne_zero_iff _).mpr hpne)
  have hinv : ContinuousAt
      (fun q : Z.TotalSpace => (sc (((Z.localTriv i q).2) : EuclideanSpace ℂ (Fin 1)))⁻¹) p :=
    hsc.inv₀ hval
  have hproj : ContinuousAt (fun q : Z.TotalSpace => q.1) p :=
    (FiberBundle.continuous_proj (EuclideanSpace ℂ (Fin 1)) Z.Fiber).continuousAt
  have huvec : ContinuousAt (fun q : Z.TotalSpace => uVec n i q.1) p :=
    (continuousOn_uVec i).continuousAt ((isOpen_chartSet i).mem_nhds hpmem) |>.comp hproj
  have hloc : ContinuousAt
      (fun q : Z.TotalSpace => (sc (((Z.localTriv i q).2) : EuclideanSpace ℂ (Fin 1)))⁻¹
        • uVec n i q.1) p :=
    hinv.smul huvec
  have heq : Phi n =ᶠ[nhds p]
      (fun q : Z.TotalSpace => (sc (((Z.localTriv i q).2) : EuclideanSpace ℂ (Fin 1)))⁻¹
        • uVec n i q.1) := by
    refine Filter.eventually_of_mem ((Z.localTriv i).open_source.mem_nhds hsource) ?_
    intro q hq
    rw [VectorBundleCore.mem_localTriv_source] at hq
    exact Phi_eq_localTriv i q hq
  exact ((hloc.congr heq.symm).continuousWithinAt).mono
    (Set.subset_univ (Work.Thom.zeroComplementCore Z))


/-! ## The homeomorphism -/

theorem continuous_toc : Continuous toc := by
  unfold toc
  fun_prop

theorem toc_mul (a b : ℂ) : toc (a * b) = a • toc b := by
  have h : (fun _ : Fin 1 => a * b) = a • (fun _ : Fin 1 => b) := by
    funext x
    rw [Pi.smul_apply, smul_eq_mul]
  rw [toc, toc, h, map_smul]

theorem toc_ne_zero_iff (c : ℂ) : toc c ≠ 0 ↔ c ≠ 0 := by
  constructor
  · intro h hc
    exact h (by rw [hc, toc_zero])
  · intro h hc
    exact h (by rw [← sc_toc c, hc, sc_zero])

/-- `cpMk` of the normalised spanning vector of a point of the chart `j`. -/
theorem cpMk_uVec {n : ℕ} {j : Fin (n + 1)} {x : CP n} (hx : x ∈ chartSet j) :
    cpMk n ⟨uVec n j x, uVec_ne_zero j x⟩ = x := by
  have hx' : x = chartInv j (chartFun j x) := (chartInv_chartFun j x hx).symm
  have hvec : (uVec n j x : CPV n)
      = Fin.insertNth (α := fun _ => ℂ) j (1 : ℂ) (chartFun j x) := by
    funext k
    conv_lhs => rw [uVec_apply, hx']
    rw [homCoord_chartInv]
  rw [show (⟨uVec n j x, uVec_ne_zero j x⟩ : {v : CPV n // v ≠ 0})
      = ⟨Fin.insertNth (α := fun _ => ℂ) j (1 : ℂ) (chartFun j x),
          insertNth_one_ne_zero j (chartFun j x)⟩ from Subtype.ext hvec]
  rw [← chartInv_apply j (chartFun j x), ← hx']

/-- Scaling a nonzero vector does not change its class in `ℂPⁿ`. -/
theorem cpMk_smul {n : ℕ} (v : {z : CPV n // z ≠ 0}) {c : ℂ} (hc : c ≠ 0) :
    cpMk n ⟨c • v.1, smul_ne_zero hc v.2⟩ = cpMk n v :=
  (cpMk_eq_iff n _ v).mpr ⟨c, rfl⟩

/-- **The inverse map**: above the class `ℂw` of a nonzero vector `w`, with fibre coordinate
`(w_i)⁻¹` in the chart `i = indexAt (ℂw)`. -/
noncomputable def Psi (n : ℕ) (w : {z : CPV n // z ≠ 0}) :
    ↥(Work.Thom.zeroComplementCore (tautDual n)) :=
  ⟨⟨cpMk n w, show (tautDual n).Fiber (cpMk n w) from
      toc ((w.1 ((tautDual n).indexAt (cpMk n w)))⁻¹)⟩, by
    have hmem : cpMk n w ∈ chartSet ((tautDual n).indexAt (cpMk n w)) :=
      (tautDual n).mem_baseSet_at _
    have hwi : w.1 ((tautDual n).indexAt (cpMk n w)) ≠ 0 := (mem_chartSet_iff _ w).mp hmem
    intro h
    have h1 : toc ((w.1 ((tautDual n).indexAt (cpMk n w)))⁻¹) = 0 := h
    refine inv_ne_zero hwi ?_
    rw [← sc_toc ((w.1 ((tautDual n).indexAt (cpMk n w)))⁻¹), h1, sc_zero]⟩

@[simp] theorem Psi_fst (n : ℕ) (w : {z : CPV n // z ≠ 0}) : (Psi n w).1.1 = cpMk n w := rfl

theorem localTriv_Psi {n : ℕ} (i : Fin (n + 1)) (w : {z : CPV n // z ≠ 0}) (hi : w.1 i ≠ 0) :
    (tautDual n).localTriv i (Psi n w).1 = (cpMk n w, toc ((w.1 i)⁻¹)) := by
  have hmem : cpMk n w ∈ chartSet ((tautDual n).indexAt (cpMk n w)) :=
    (tautDual n).mem_baseSet_at _
  rw [VectorBundleCore.localTriv_apply, tautDual_coordChange]
  congr 1
  show homCoord n i ((tautDual n).indexAt (cpMk n w)) (cpMk n w)
      • toc ((w.1 ((tautDual n).indexAt (cpMk n w)))⁻¹) = toc ((w.1 i)⁻¹)
  have hwi0 : w.1 ((tautDual n).indexAt (cpMk n w)) ≠ 0 := (mem_chartSet_iff _ w).mp hmem
  have hscal : (w.1 ((tautDual n).indexAt (cpMk n w)) / w.1 i) *
      (w.1 ((tautDual n).indexAt (cpMk n w)))⁻¹ = (w.1 i)⁻¹ := by
    rw [div_eq_mul_inv, mul_comm (w.1 ((tautDual n).indexAt (cpMk n w))) (w.1 i)⁻¹,
      mul_assoc, mul_inv_cancel₀ hwi0, mul_one]
  rw [homCoord_cpMk i w hi, ← toc_mul, hscal]

/-- The forward map. -/
noncomputable def toTaut (n : ℕ) :
    ↥(Work.Thom.zeroComplementCore (tautDual n)) → {z : CPV n // z ≠ 0} :=
  fun p => ⟨Phi n p.1, Phi_ne_zero p⟩

theorem toTaut_fst (n : ℕ) (p : ↥(Work.Thom.zeroComplementCore (tautDual n))) :
    (toTaut n p).1 = Phi n p.1 := rfl

/-- **The punctured total space of the dual tautological line bundle is `ℂ^{n+1}∖{0}`.** -/
noncomputable def tautDualPunctCore (n : ℕ) :
    ↥(Work.Thom.zeroComplementCore (tautDual n)) ≃ₜ {z : CPV n // z ≠ 0} where
  toFun := toTaut n
  invFun := Psi n
  left_inv p := by
    set j := (tautDual n).indexAt p.1.1 with hj
    have hjmem : p.1.1 ∈ chartSet j := (tautDual n).mem_baseSet_at p.1.1
    have hpne : raw n p.1 ≠ 0 := fun hc => p.2 hc
    have hcnz : (sc (raw n p.1))⁻¹ ≠ 0 := inv_ne_zero ((sc_ne_zero_iff _).mpr hpne)
    have hbase : cpMk n (toTaut n p) = p.1.1 := by
      show cpMk n ⟨(sc (raw n p.1))⁻¹ • uVec n j p.1.1, _⟩ = p.1.1
      rw [cpMk_smul ⟨uVec n j p.1.1, uVec_ne_zero j p.1.1⟩ hcnz, cpMk_uVec hjmem]
    have hidx : (tautDual n).indexAt (cpMk n (toTaut n p)) = j := by rw [hbase]
    have hcoord : (toTaut n p).1 j = (sc (raw n p.1))⁻¹ := by
      show ((sc (raw n p.1))⁻¹ • uVec n j p.1.1) j = (sc (raw n p.1))⁻¹
      rw [Pi.smul_apply, smul_eq_mul, uVec_self, mul_one]
    have hfib : toc (((toTaut n p).1 ((tautDual n).indexAt (cpMk n (toTaut n p))))⁻¹)
        = raw n p.1 := by
      rw [hidx, hcoord, inv_inv, toc_sc]
    refine Subtype.ext ?_
    apply Bundle.TotalSpace.ext
    · exact hbase
    · exact heq_of_eq hfib
  right_inv w := by
    have hmem : cpMk n w ∈ chartSet ((tautDual n).indexAt (cpMk n w)) :=
      (tautDual n).mem_baseSet_at _
    have hwi : w.1 ((tautDual n).indexAt (cpMk n w)) ≠ 0 := (mem_chartSet_iff _ w).mp hmem
    refine Subtype.ext ?_
    show Phi n (Psi n w).1 = w.1
    rw [Phi]
    simp only [Psi, raw, Psi_fst, sc_toc, inv_inv]
    funext k
    rw [Pi.smul_apply, smul_eq_mul, uVec_apply, homCoord_cpMk _ w hwi k]
    field_simp
  continuous_toFun :=
    Continuous.subtype_mk (continuousOn_iff_continuous_restrict.mp (continuousOn_Phi n))
      (fun p => Phi_ne_zero p)
  continuous_invFun := by
    refine Continuous.subtype_mk ?_ (fun w => (Psi n w).2)
    rw [continuous_iff_continuousAt]
    intro w
    obtain ⟨i, hi⟩ : ∃ i : Fin (n + 1), w.1 i ≠ 0 := by
      by_contra h
      push Not at h
      exact w.2 (funext fun i => h i)
    have hnhds : {w' : {z : CPV n // z ≠ 0} | w'.1 i ≠ 0} ∈ nhds w :=
      IsOpen.mem_nhds (isOpen_ne.preimage ((continuous_apply i).comp continuous_subtype_val)) hi
    have hsource : (fun w' : {z : CPV n // z ≠ 0} => (Psi n w').1) ⁻¹'
        ((tautDual n).localTriv i).source ∈ nhds w :=
      Filter.mem_of_superset hnhds (fun w' hw' => by
        rw [Set.mem_preimage, VectorBundleCore.mem_localTriv_source]
        exact (mem_chartSet_iff i w').mpr hw')
    refine ((((tautDual n).localTriv i).toOpenPartialHomeomorph).continuousAt_iff_continuousAt_comp_left
      hsource).2 ?_
    rw [show ((↑(((tautDual n).localTriv i).toOpenPartialHomeomorph) :
        (tautDual n).TotalSpace → CP n × EuclideanSpace ℂ (Fin 1)))
        = ⇑((tautDual n).localTriv i) from rfl]
    show ContinuousAt (fun w' : {z : CPV n // z ≠ 0} =>
      (tautDual n).localTriv i (Psi n w').1) w
    have hformula : ContinuousAt (fun w' : {z : CPV n // z ≠ 0} =>
        (cpMk n w', toc ((w'.1 i)⁻¹))) w := by
      refine ContinuousAt.prodMk (continuous_cpMk n).continuousAt ?_
      exact continuous_toc.continuousAt.comp
        (ContinuousAt.inv₀ (((continuous_apply i).continuousAt.comp
          continuous_subtype_val.continuousAt)) hi)
    have heq : (fun w' : {z : CPV n // z ≠ 0} => (tautDual n).localTriv i (Psi n w').1)
        =ᶠ[nhds w] (fun w' => (cpMk n w', toc ((w'.1 i)⁻¹))) :=
      Filter.eventually_of_mem hnhds (fun w' hw' => localTriv_Psi i w' hw')
    exact hformula.congr heq.symm


/-- **The punctured total space of the dual tautological line bundle on `ℂPⁿ` is the punctured
model space `ℂ^{n+1}∖{0}`.** -/
theorem tautDualPunctHomeo (n : ℕ) :
    Nonempty (↥(Work.Thom.zeroComplement (Work.Thom.realification (Work.Gen.tautDual n))) ≃ₜ
      {z : Work.Projective.CPV n // z ≠ 0}) :=
  ⟨(Work.Thom.zeroComplementHomeomorph (Work.Gen.tautDual n)).trans (ChernGen.tautDualPunctCore n)⟩

/-! ## `H²(ℂⁿ∖{0};ℤ) = 0` for `n ≥ 2` -/

/-- **`H²(ℂ^{m+2}∖{0};ℤ) = 0`.**  `ℂ^{m+2}∖0` is homotopy equivalent to the sphere `S^{2m+3}`, and
`H²(S^{2m+3}) = 0` because `2 ∉ {0, 2m+3}`.  Concretely, the two-cover `cpU (m+2) ∪ cpV (m+2)` of
`ℂP^{m+2}` has overlap `cpU (m+2) ∩ cpV (m+2) ≃ ℂ^{m+2}∖0` (`Work.Projective.cpnUV_homeo`), whose
cohomology off degrees `0` and `2m+5` vanishes (`Work.Projective.cpnUV_cohomology_zero`). -/
theorem puncturedComplexH2Zero (m : ℕ) :
    CategoryTheory.Limits.IsZero
      (Work.Cohomology.singularCohomology ℤ 2
        (TopCat.of {z : Fin (m + 2) → ℂ // z ≠ 0})) := by
  obtain ⟨e⟩ := Work.Cohomology.cohomologyIso_of_homotopyEquiv
    (Work.Projective.cpnUV_homeo (m + 2)).toHomotopyEquiv 2
  have hz : CategoryTheory.Limits.IsZero
      (Work.Cohomology.singularCohomology ℤ 2
        (TopCat.of ↥(Work.Projective.cpU (m + 2) ∩ Work.Projective.cpV (m + 2)))) :=
    Work.Projective.cpnUV_cohomology_zero (m + 1) 2 (by norm_num) (by omega)
  exact CategoryTheory.Limits.IsZero.of_iso hz e.symm

/-! ## The normalisation -/

/-- A `ℤ`-module is spanned by a single element iff every element is an integer multiple of it.
(The two available `ℤ`-scalar multiplications on an abelian group are identified by
`int_smul_eq_zsmul`.) -/
lemma span_singleton_eq_top_iff' {M : Type*} [AddCommGroup M] [Module ℤ M] (x : M) :
    Submodule.span ℤ {x} = ⊤ ↔ ∀ z : M, ∃ a : ℤ, z = a • x := by
  have bridge : ∀ (a : ℤ), (LinearMap.toSpanSingleton ℤ M x) a = (a • x : M) := by
    intro a
    rw [LinearMap.toSpanSingleton_apply]
    exact int_smul_eq_zsmul (inferInstance : Module ℤ M) a x
  constructor
  · intro h z
    have hmem : z ∈ Submodule.span ℤ {x} := by rw [h]; trivial
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hmem
    have ha' : (LinearMap.toSpanSingleton ℤ M x) a = z := by
      rw [LinearMap.toSpanSingleton_apply]; exact ha
    exact ⟨a, by rw [← ha', bridge]⟩
  · intro h
    rw [Submodule.eq_top_iff']
    intro z
    obtain ⟨a, ha⟩ := h z
    rw [ha, ← bridge a]
    exact Submodule.smul_mem _ a (Submodule.subset_span (Set.mem_singleton x))

end ChernGen

/-- **`c₁(O(1)) ∈ H²(ℂP⁴;ℤ)` generates `H²(ℂP⁴;ℤ)`** — the normalisation of the Gen area. -/
theorem ChernGenerator : Submodule.span ℤ {Work.Gen.uCoh 4} = ⊤ := by
  have h1 : 1 ≤ 1 := Nat.succ_le_succ (Nat.zero_le 0)
  let T : Work.Thom.ThomClass (Work.Thom.realification (tautDual 4)) 2 :=
    Work.Thom.thomClassRank 1 h1 (tautDual 4)
  let Z : Work.TangentClasses.RealBundle (CP 4) (EuclideanSpace ℂ (Fin 1)) (Fin 5) :=
    Work.Thom.realification (tautDual 4)
  let oneH0 : ↑(Work.Thom.Coh ℤ 0 (CP 4)) :=
    Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of (CP 4)))
  let u2 : ↑(Work.Thom.Coh ℤ 2 (CP 4)) := Work.Gen.uCoh 4
  have hTe : u2 = T.eulerClass := rfl
  -- the punctured total space of `Z` has vanishing `H²`
  have hvan : CategoryTheory.Limits.IsZero (Work.Thom.Coh ℤ 2 ↥(Work.Thom.zeroComplement Z)) := by
    obtain ⟨e⟩ := ChernGen.tautDualPunctHomeo 4
    obtain ⟨iso⟩ := Work.Cohomology.cohomologyIso_of_homotopyEquiv e.toHomotopyEquiv 2
    exact CategoryTheory.Limits.IsZero.of_iso (ChernGen.puncturedComplexH2Zero 3) iso
  haveI : Subsingleton ↑(Work.Thom.Coh ℤ 2 ↥(Work.Thom.zeroComplement Z)) :=
    ModuleCat.subsingleton_of_isZero hvan
  -- hence `gysinEuler T 0` is onto
  have hsurj : Function.Surjective (Work.Thom.gysinEuler T 0) := by
    intro y
    have hrange := Work.Thom.gysin_exact_at_base T 0
    have hy : y ∈ Set.range ⇑(Work.Thom.gysinEuler T 0) := by
      rw [hrange]
      exact Subsingleton.elim _ _
    exact hy
  haveI hpc : PathConnectedSpace (CP 4) := Work.Projective.pathConnectedSpace_CP 4
  -- `1 ⌣ e = e`
  have hone : (Work.Cohomology.cupH' ℤ (TopCat.toSSet.obj (TopCat.of (CP 4))) 0 2) oneH0
      T.eulerClass = T.eulerClass := by
    simpa [oneH0] using
      Work.Cohomology.cupH'_one_left ℤ (TopCat.toSSet.obj (TopCat.of (CP 4))) 2 T.eulerClass
  -- `gysinEuler T 0 1 = e = uCoh 4`
  have hgen : (Work.Thom.gysinEuler T 0) oneH0 = u2 :=
    (Work.Thom.gysinEuler_eq_cupEuler T 0 oneH0).trans (hone.trans hTe.symm)
  -- `H⁰` is generated by `1`
  have hspan0 : Submodule.span ℤ {oneH0} = ⊤ :=
    (ChernGen.span_singleton_eq_top_iff' oneH0).mpr (fun z => by
      obtain ⟨a, ha⟩ := Work.Cohomology.exists_smul_oneH (TopCat.of (CP 4)) z
      exact ⟨a, ha⟩)
  have hmap : Submodule.map (Work.Thom.gysinEuler T 0) (Submodule.span ℤ {oneH0})
      = Submodule.span ℤ {u2} := by
    rw [Submodule.map_span]
    simp only [Set.image_singleton, hgen]
  have htop : Submodule.span ℤ {u2} = ⊤ := by
    rw [← hmap, hspan0, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr hsurj
  exact htop

end

end Work.Gen
