/-!
# `c₁(O(1)) ∈ H²(ℂP²;ℤ)` generates `H²(ℂP²;ℤ)`

The class `Work.Gen.uCoh 2 = c₁(O(1))` of the dual tautological line bundle on `ℂP²` is a generator
of `H²(ℂP²;ℤ) ≅ ℤ` (up to sign, as is forced by the global sign normalisation of
`Work.Thom.chernClass`).

## The argument

Let `Z = realification (tautDual 2)` be the real rank-`2` bundle underlying `O(1)` and
`T = Work.Thom.thomClassRank 1 _ (tautDual 2)` its Thom class; then `T.eulerClass = uCoh 2`
(`Work.Thom.chernClass_one_top`).  The Gysin sequence of `Z` gives, in degrees `0 → 2`, the
exactness `Set.range (gysinEuler T 0) = {x | gysinπ Z 2 x = 0}`, and `gysinEuler T 0` is
`x ↦ x ⌣ e` (`Work.Thom.gysinEuler_eq_cupEuler`).  The punctured total space `E∖0` of `Z` is the
punctured model space `ℂ³∖{0}` (`Work.Gen.tautDualPunctHomeo`), whose `H²` vanishes
(`Work.Gen.PuncturedComplexThree`), so `gysinπ Z 2 = 0` and `gysinEuler T 0` is onto.  Since
`H⁰(ℂP²;ℤ) = ℤ⟨1⟩` for the path connected `ℂP²` (`Work.Cohomology.exists_smul_oneH`), the range of
`gysinEuler T 0` — which is the whole of `H²` — is generated by `gysinEuler T 0 1 = 1 ⌣ e = e`.
-/

namespace Work.Gen

open Work.Thom Work.Cohomology Work.TangentClasses Work.Projective

noncomputable section

/-- A surjective `ℤ`-linear map sends a generator to a generator. -/
theorem span_singleton_map_eq_top' {M N : Type*} [AddCommGroup M] [Module ℤ M]
    [AddCommGroup N] [Module ℤ N] (f : M →ₗ[ℤ] N) (hf : Function.Surjective f) (x : M)
    (hx : Submodule.span ℤ {x} = ⊤) : Submodule.span ℤ {f x} = ⊤ := by
  have h1 : Submodule.map f (Submodule.span ℤ {x}) = Submodule.span ℤ {f x} := by
    rw [Submodule.map_span]; simp
  rw [← h1, hx, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr hf

theorem ChernGeneratorTwo : Submodule.span ℤ {Work.Gen.uCoh 2} = ⊤ := by
  have hvan : Subsingleton (Coh ℤ 2 (zeroComplement (realification (tautDual 2)))) :=
    subsingleton_zeroComplement_tautDualTwo
  rw [show (Work.Gen.uCoh 2)
      = (thomClassRank 1 (Nat.succ_le_succ (Nat.zero_le 0)) (tautDual 2)).eulerClass
      from chernClass_one_top (tautDual 2)]
  set T := thomClassRank 1 (Nat.succ_le_succ (Nat.zero_le 0)) (tautDual 2) with hT
  have hvan' : Subsingleton (Coh ℤ (0 + 2 * 1)
      (zeroComplement (realification (tautDual 2)))) := hvan
  haveI := hvan'
  have hsurj : Function.Surjective (gysinEuler T 0) := by
    rw [← Set.range_eq_univ, gysin_exact_at_base]
    ext y
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
    exact Subsingleton.elim (gysinπ (realification (tautDual 2)) (0 + 2 * 1) y) 0
  have he : gysinEuler T 0 (oneH ℤ (TopCat.toSSet.obj (TopCat.of (CP 2)))) = T.eulerClass := by
    rw [gysinEuler_eq_cupEuler, cupH'_one_left]
  have h0 : Submodule.span ℤ {oneH ℤ (TopCat.toSSet.obj (TopCat.of (CP 2)))} = ⊤ := by
    refine Submodule.eq_top_iff'.mpr fun x => ?_
    rw [Submodule.mem_span_singleton]
    haveI : PathConnectedSpace ↥(TopCat.of (CP 2)) := pathConnectedSpace_CP 2
    obtain ⟨m, hm⟩ := exists_smul_oneH (TopCat.of (CP 2)) x
    refine ⟨m, ?_⟩
    rw [hm]
    exact int_smul_eq_zsmul (inferInstance : Module ℤ (Coh ℤ 0 (CP 2))) m
      (oneH ℤ (TopCat.toSSet.obj (TopCat.of (CP 2))))
  have hgen := span_singleton_map_eq_top' (gysinEuler T 0) hsurj
    (oneH ℤ (TopCat.toSSet.obj (TopCat.of (CP 2)))) h0
  rw [he] at hgen
  exact hgen

end

end Work.Gen
