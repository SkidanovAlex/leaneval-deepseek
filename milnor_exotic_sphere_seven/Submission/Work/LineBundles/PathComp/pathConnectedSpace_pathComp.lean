import Mathlib
import Submission.Work.LineBundles.Defs

-- Lean v4.35.0-rc3: restore v4.34 instance-unification transparency (port).
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxHeartbeats 400000

namespace Work.LineBundles.PathComp

/-- **`pathComp B c` is a path component of `B`.**

`pathComp B c` is the set of points of `B` whose `0`-simplex in the singular simplicial set lies in
the `π₀`-class `c`.  Since `TopCat.zerothHomotopyEquiv` identifies the simplicial `π₀` with the
honest `ZerothHomotopy B = Quotient (pathSetoid B)` (whose relation is `Joined`), this set is
exactly `pathComponent x₀` for any point `x₀` whose `0`-simplex represents `c`.

The forward direction applies `TopCat.zerothHomotopyEquiv.symm` to the equality of `π₀`-classes to
get an equality in `ZerothHomotopy B`, and reads off `Joined` via `Quotient.exact`; the reverse
direction applies `TopCat.zerothHomotopyEquiv` to `Quotient.sound`. -/
theorem pathComp_eq_pathComponent {B : Type} [TopologicalSpace B]
    (c : SSet.π₀ (TopCat.toSSet.obj (TopCat.of B))) {x₀ : B}
    (h₀ : c = SSet.π₀.mk (TopCat.toSSetObj₀Equiv.symm x₀)) :
    Work.LineBundles.pathComp B c = pathComponent x₀ := by
  ext x
  rw [h₀]
  simp only [Work.LineBundles.pathComp, Set.mem_ofPred_eq, mem_pathComponent_iff]
  constructor
  · intro h
    have h2 : ZerothHomotopy.mk x = ZerothHomotopy.mk x₀ := by
      have hh := congrArg (TopCat.zerothHomotopyEquiv (X := TopCat.of B)).symm h
      rw [TopCat.zerothHomotopyEquiv_symm_mk, TopCat.zerothHomotopyEquiv_symm_mk] at hh
      simpa using hh
    exact (Quotient.exact h2).symm
  · intro h
    have h2 : ZerothHomotopy.mk x₀ = ZerothHomotopy.mk x := Quotient.sound h
    have h3 := congrArg (TopCat.zerothHomotopyEquiv (X := TopCat.of B)) h2
    rw [TopCat.zerothHomotopyEquiv_mk, TopCat.zerothHomotopyEquiv_mk] at h3
    simpa using h3.symm

/-- **The path component of a space, as defined by `Work.LineBundles.pathComp` out of a `π₀`-class
of the singular simplicial set, is path connected.**

`SSet.π₀` of the singular simplicial set is the quotient of the `0`-simplices by the relation
generated by the `1`-simplices (`SSet.π₀.mk_eq_mk_iff` gives `EqvGen π₀Rel`), and a `1`-simplex of
the singular simplicial set is a continuous map `|Δ¹| → B`, i.e. a path (Mathlib's
`TopCat.toSSetObjEdgeEquiv : SSet.Edge (toSSetObj₀Equiv.symm x) (toSSetObj₀Equiv.symm y) ≃ X.Path x y`
is the bridge, and `TopCat.zerothHomotopyEquiv` identifies the simplicial `π₀` with the honest path
components `ZerothHomotopy B = Quotient (pathSetoid B)`).  A zigzag of paths concatenates to a path,
and a path between two points of the class stays in the class.

Concretely, the useful steps are: `Work.Cohomology`-free `pathConnectedSpace_iff` reduces the
conclusion to `Nonempty ↥(pathComp B c)` (from `SSet.π₀.mk_surjective`) and to
`∀ x y : ↥(pathComp B c), Joined x y`; for the latter, `SSet.π₀.mk_eq_mk_iff` turns the equality of
classes into `EqvGen SSet.π₀Rel`, `SSet.π₀Rel` is `Nonempty (SSet.Edge · ·)`, and
`TopCat.toSSetObjEdgeEquiv` turns each edge into a path. -/
theorem pathConnectedSpace_pathComp {B : Type} [TopologicalSpace B]
    (c : SSet.π₀ (TopCat.toSSet.obj (TopCat.of B))) :
    PathConnectedSpace ↥(Work.LineBundles.pathComp B c) := by
  rw [← isPathConnected_iff_pathConnectedSpace]
  obtain ⟨s, hs⟩ := SSet.π₀.mk_surjective c
  have h₀ : c = SSet.π₀.mk (TopCat.toSSetObj₀Equiv.symm (TopCat.toSSetObj₀Equiv s)) := by
    rw [Equiv.symm_apply_apply]
    exact hs.symm
  rw [pathComp_eq_pathComponent c h₀]
  exact isPathConnected_pathComponent

end Work.LineBundles.PathComp
