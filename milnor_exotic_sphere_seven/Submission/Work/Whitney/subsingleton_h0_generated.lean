/-!
# `H⁰` of a subsingleton space is generated by `oneH`

For a topological space `Y` whose underlying type is a subsingleton (in particular: a point, or the
empty space), the `0`-th singular cohomology `H⁰(Y; ℤ)` is generated over `ℤ` by the unit class
`oneH` — the class of the augmentation `0`-cocycle: every class is `n • oneH` for some `n : ℤ`.

The argument splits on whether `Y` is inhabited.

* **`Y` nonempty**: a subsingleton space is path-connected (`pathConnectedSpace_iff_zerothHomotopy`,
  the only point being joined to itself by the constant path), so the general statement
  `Work.Cohomology.exists_smul_oneH` — for a path-connected space every `H⁰`-class is a multiple of
  the unit class — applies verbatim.
* **`Y` empty**: the singular cochain complex has zero components (there are no singular simplices
  of the empty space), so it is exact in every degree and `H⁰(Y; ℤ) = 0` is a subsingleton; then
  every class equals `0 • oneH`.

This is the base case of the `H⁰`-computations used by the Whitney-sum formula on the model
fibration over a subsingleton base.
-/

namespace Work.Whitney

theorem subsingleton_h0_generated (Y : Type) [TopologicalSpace Y] [Subsingleton Y] :
    ∀ x : Work.Thom.Coh ℤ 0 Y,
      ∃ n : ℤ, x = n • (Work.Cohomology.oneH ℤ (TopCat.toSSet.obj (TopCat.of Y))) := by
  by_cases hY : Nonempty Y
  · -- a nonempty subsingleton space is path-connected
    haveI : PathConnectedSpace Y :=
      pathConnectedSpace_iff_zerothHomotopy.mpr
        ⟨hY.map (Quotient.mk (pathSetoid Y)), inferInstance⟩
    exact fun x => Work.Cohomology.exists_smul_oneH (TopCat.of Y) x
  · -- the empty space: the cochain complex vanishes in every degree
    haveI : IsEmpty Y := not_nonempty_iff.mp hY
    have hz : CategoryTheory.Limits.IsZero
        (Work.Cohomology.singularCohomology ℤ 0 (TopCat.of Y)) :=
      (HomologicalComplex.ExactAt.of_isZero
        (Work.Cohomology.isZero_singularCochainComplex_of_isEmpty (TopCat.of Y) 0)).isZero_homology
    haveI : Subsingleton ↥(Work.Thom.Coh ℤ 0 Y) :=
      ModuleCat.isZero_iff_subsingleton.mp hz
    intro x
    exact ⟨0, Subsingleton.elim x _⟩

end Work.Whitney
