/-!
# The punctured relative cohomology over a subsingleton base is generated by `Mpun`

`Work.Whitney.punctured_generated`: for a topological space `Y` whose underlying type is a
subsingleton, the relative cohomology `H^n(Y × ℝⁿ, Y × (ℝⁿ∖0); ℤ)` is generated over `ℤ` by the
model class `Work.Thom.Mpun n Y`.

This is the *degree-zero* case of the model property `Work.Thom.Mpun_isModel` (`Work.Thom.Mn_isModel`
transported across the deformation retraction of the punctured pair onto the sphere-bundle pair):
cupping with `Mpun n Y` is a bijection `H^k(Y;ℤ) → H^{k+n}(Y × ℝⁿ, Y × (ℝⁿ∖0); ℤ)`.  For `k = 0`
this identifies the relative group with `H⁰(Y;ℤ)`, which for a subsingleton `Y` is generated by the
unit class `1` (`Work.Whitney.subsingleton_h0_generated`: a nonempty subsingleton is path-connected,
so `Work.Cohomology.exists_smul_oneH` applies, and the empty space has vanishing cohomology).  Since
`1 ⌣ y = y` (`Work.Thom.mixedCupC_oneH_zero`) and pullback fixes `1` (`Work.Thom.CohMap_oneH`), the
image of `1` is `Mpun n Y` itself, so every class in the top relative group is a multiple of
`Mpun n Y`.

The only bookkeeping is the degree discrepancy `0 + n = n` (`Nat.zero_add`): `Mpun_isModel` at
`k = 0` produces classes in `H^{0+n}`, and the transport between the two degrees is packaged in the
explicitly motivated cast `Work.Whitney.relCohCast` (with its `ℤ`-linearity
`Work.Whitney.relCohCast_zsmul` and its two inverse laws), rather than in the `▸` notation whose
motive is inferred by abstracting *all* occurrences of `n` (which would wrongly touch the fibre
`EuclideanSpace ℝ (Fin n)`).
-/

namespace Work.Whitney

open Work.Thom

noncomputable section

/-- **Transport of a relative cohomology class along an equality of degrees**, with the canonical
motive `fun k => H^k(X,A;ℤ)` (this is the point of the definition: the `▸` notation would infer the
motive by abstracting *all* occurrences of the degree, which for a pair of the form
`(Y × ℝⁿ, Y × (ℝⁿ∖0))` also replaces `n` inside `Fin n`). -/
def relCohCast {X : Type} [TopologicalSpace X] (A : Set X) {c d : ℕ} (h : c = d)
    (x : Work.Thom.RelCoh ℤ c X A) : Work.Thom.RelCoh ℤ d X A :=
  Eq.ndrec (a := c) (motive := fun k => Work.Thom.RelCoh ℤ k X A) x h

/-- `relCohCast` along `rfl` is the identity. -/
theorem relCohCast_rfl {X : Type} [TopologicalSpace X] (A : Set X) (c : ℕ)
    (x : Work.Thom.RelCoh ℤ c X A) : relCohCast A rfl x = x := rfl

/-- **`relCohCast` is `ℤ`-linear**: transporting a multiple is the multiple of the transport. -/
theorem relCohCast_zsmul {X : Type} [TopologicalSpace X] (A : Set X) {c d : ℕ} (h : c = d)
    (m : ℤ) (x : Work.Thom.RelCoh ℤ c X A) :
    relCohCast A h (m • x) = m • relCohCast A h x := by
  cases h
  rfl

/-- Transporting from degree `d` to degree `c` and back is the identity. -/
theorem relCohCast_comp_symm {X : Type} [TopologicalSpace X] (A : Set X) {c d : ℕ} (h : c = d)
    (y : Work.Thom.RelCoh ℤ d X A) : relCohCast A h (relCohCast A h.symm y) = y := by
  cases h
  rfl

/-- Transporting from degree `c` to degree `d` and back is the identity. -/
theorem relCohCast_symm_comp {X : Type} [TopologicalSpace X] (A : Set X) {c d : ℕ} (h : c = d)
    (x : Work.Thom.RelCoh ℤ c X A) : relCohCast A h.symm (relCohCast A h x) = x := by
  cases h
  rfl

/-- `relCohCast` is the degree cast `▸`, for the canonical motive. -/
theorem relCohCast_eq_cast {X : Type} [TopologicalSpace X] (A : Set X) {c d : ℕ} (h : c = d)
    (x : Work.Thom.RelCoh ℤ c X A) : relCohCast A h x = h ▸ x := by
  cases h
  rfl

/-- **The punctured relative cohomology over a subsingleton base is generated by `Mpun`.** -/
theorem punctured_generated (Y : Type) [TopologicalSpace Y] [Subsingleton Y] (n : ℕ)
    (a : Work.Thom.RelCoh ℤ n (Y × EuclideanSpace ℝ (Fin n)) (Work.Thom.Punct Y n)) :
    ∃ k : ℤ, a = k • Work.Thom.Mpun n Y := by
  -- The model property in degree `0`: some `x ∈ H⁰(Y;ℤ)` has `π^*(x) ⌣ Mpun n Y` equal to `a`
  -- (transported to degree `0 + n`).
  obtain ⟨x, hx⟩ := (Mpun_isModel n Y 0).2 (relCohCast (Punct Y n) (Nat.zero_add n).symm a)
  -- `H⁰` of a subsingleton is generated by the unit class `1`.
  obtain ⟨m, hm⟩ := subsingleton_h0_generated Y x
  -- Pullback fixes the unit class, and pullback is `ℤ`-linear.
  have hpull : (CohMap (projFstA Y n) ℤ 0).hom x
      = m • Work.Cohomology.oneH ℤ
          (TopCat.toSSet.obj (TopCat.of (Y × EuclideanSpace ℝ (Fin n)))) := by
    rw [hm]
    exact (map_zsmul _ m _).trans
      (congrArg (fun z => m • z) (CohMap_oneH (projFstA Y n)))
  -- The unit class acts as the identity on relative cohomology.
  have hΦ : ((mixedCupC ℤ (Punct Y n) 0 n)
        ((CohMap (projFstA Y n) ℤ 0).hom x) (Mpun n Y))
      = m • relCohCast (Punct Y n) (Nat.zero_add n).symm (Mpun n Y) := by
    rw [hpull]
    refine (map_zsmul ((LinearMap.applyₗ (Mpun n Y)).comp
      (mixedCupC ℤ (Punct Y n) 0 n)) m _).trans ?_
    refine (congrArg (fun z => m • z) (mixedCupC_oneH_zero (Punct Y n) n (Mpun n Y))).trans ?_
    rw [relCohCast_eq_cast]
  -- Conclude by transporting back down to degree `n`.
  have hmid : relCohCast (Punct Y n) (Nat.zero_add n).symm a
      = m • relCohCast (Punct Y n) (Nat.zero_add n).symm (Mpun n Y) := hx.symm.trans hΦ
  refine ⟨m, ?_⟩
  refine (relCohCast_comp_symm (Punct Y n) (Nat.zero_add n) a).symm.trans ?_
  rw [hmid, relCohCast_zsmul, relCohCast_comp_symm]

end

end Work.Whitney
