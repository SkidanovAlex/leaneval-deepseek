/-!
# The `A ∪ C` group of the model product formula is generated by `tcmF^*(Mpun (n+1))`

General `n` form of `RankTwo/Assembly.lean`'s `pdAB_generated` (the `n = 1` case): every class of
`H^{n+1}(tcmX Y n 1, tcmA ∪ tcmC)` over a subsingleton base is an integer multiple of the pullback of
`Mpun (n+1) Y` along the coordinate identification `tcmF`.  It is `punctured_generated` transported
along `tcmF` using the (proved, sorry-free) inverse laws of the coordinate identification.
-/

namespace Work.Whitney
open Work.Thom
open Work.Whitney.Fib

noncomputable section

theorem pdAB_generated_succ (Y : Type) [TopologicalSpace Y] [Subsingleton Y] (n : ℕ)
    (z : RelCoh ℤ (n + 1) (tcmX Y n 1) (tcmA Y n 1 ∪ tcmC Y n 1)) :
    ∃ k : ℤ, z = k • ((relCohMap (tcmF Y n 1) (tcmA Y n 1 ∪ tcmC Y n 1) (Punct Y (n + 1))
          (tcmF_mem Y n 1) ℤ (n + 1)).hom (Mpun (n + 1) Y)) := by
  obtain ⟨w, hw⟩ := (bijective_relCohMap_tcmF (B := Y) n 1 (n + 1)).2 z
  obtain ⟨k, hk⟩ := punctured_generated Y (n + 1) w
  exact ⟨k, by rw [← hw, hk, map_zsmul]⟩

end
end Work.Whitney
