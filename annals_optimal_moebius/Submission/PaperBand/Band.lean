/-!
# The quotient band (sub-goal 1 of the global rigidity argument)

Model of the paper Möbius band as the quotient of the unit strip by the
period map `p(x) = (1 − x0, x1 + a)` (whose square is the translation
`(x0, x1) ↦ (x0, x1 + 2a)`).  This file builds the orbit equivalence:

    x ~ y  iff  y lies on the orbit of x under the ℤ-action generated by p

which has the closed description

    bandRel a x y := (x0 = y0 ∧ y1 − x1 = (2n)·a for some n : ℤ)     (even steps)
                 ∨ (x0 + y0 = 1 ∧ y1 − x1 = (2n+1)·a for some n : ℤ)  (odd steps)

(even powers of `p` keep `x0` and shift `x1` by multiples of `2a`; odd
powers flip `x0 ↦ 1 − x0` and shift `x1` by odd multiples of `a`).

Status (sub-goal 1 of `GlobalRigidity`): the equivalence, the quotient
`Band a` and its topological facts are in place; *compactness of the band*
(= compactness of the image of the unit strip in the quotient, via the
compact fundamental-domain chunk `{x0∈[0,1], x1∈[0,a]}`) is the next lemma
on the list.
-/

noncomputable section
namespace Submission.PaperBand

/-- The inverse of the period map `p`. -/
def periodInv (a : ℝ) (x : ℝ²) : ℝ² := !₂[1 - x 0, x 1 - a]

/-- `periodInv` undoes `period` on the right. -/
lemma period_periodInv (a : ℝ) (x : ℝ²) : period a (periodInv a x) = x := by
  ext i <;> fin_cases i <;> simp [period, periodInv]

/-- `periodInv` undoes `period` on the left. -/
lemma periodInv_period (a : ℝ) (x : ℝ²) : periodInv a (period a x) = x := by
  ext i <;> fin_cases i <;> simp [period, periodInv]

/-- The period map preserves the unit strip. -/
lemma period_mem_unitStrip {a : ℝ} {x : ℝ²} (hx : x ∈ unitStrip) :
    period a x ∈ unitStrip := by
  have hx0 : 0 ≤ x 0 := by
    rw [unitStrip] at hx
    exact (Set.mem_Icc.mp hx).1
  have hx1 : x 0 ≤ 1 := by
    rw [unitStrip] at hx
    exact (Set.mem_Icc.mp hx).2
  rw [unitStrip]
  simp [period]
  exact ⟨hx1, hx0⟩

/-- The inverse period map preserves the unit strip. -/
lemma periodInv_mem_unitStrip {a : ℝ} {x : ℝ²} (hx : x ∈ unitStrip) :
    periodInv a x ∈ unitStrip := by
  have hx0 : 0 ≤ x 0 := by
    rw [unitStrip] at hx
    exact (Set.mem_Icc.mp hx).1
  have hx1 : x 0 ≤ 1 := by
    rw [unitStrip] at hx
    exact (Set.mem_Icc.mp hx).2
  rw [unitStrip]
  simp [periodInv]
  exact ⟨hx1, hx0⟩

/-! ## The orbit equivalence -/

/-- Addition of even period shifts: `(2n)•a + (2m)•a = (2(n+m))•a`. -/
lemma zsmul_even_add (a : ℝ) (n m : ℤ) :
    (2 * n) • a + (2 * m) • a = (2 * (n + m)) • a := by
  have h : (2 * (n + m) : ℤ) = 2 * n + 2 * m := by ring
  rw [h, add_zsmul a (2 * n) (2 * m)]

/-- Negation of an odd shift: `-((2n+1)•a) = (2(-n-1)+1)•a`. -/
lemma zsmul_odd_neg (a : ℝ) (n : ℤ) :
    -((2 * n + 1) • a) = (2 * (-n - 1) + 1) • a := by
  rw [← neg_zsmul]
  congr 1
  ring

/-- Negation of an even shift: `-((2n)•a) = (2(-n))•a`. -/
lemma zsmul_even_neg (a : ℝ) (n : ℤ) : -((2 * n) • a) = (2 * (-n)) • a := by
  rw [← neg_zsmul]
  congr 1
  ring

/-- Sum of two odd shifts. -/
lemma zsmul_odd_add (a : ℝ) (n m : ℤ) :
    (2 * n + 1) • a + (2 * m + 1) • a = (2 * (n + m + 1)) • a := by
  have h : (2 * (n + m + 1) : ℤ) = (2 * n + 1) + (2 * m + 1) := by ring
  rw [h, add_zsmul a (2 * n + 1) (2 * m + 1)]

/-- Sum of an even and an odd shift. -/
lemma zsmul_even_odd_add (a : ℝ) (n m : ℤ) :
    (2 * n) • a + (2 * m + 1) • a = (2 * (n + m) + 1) • a := by
  have h : (2 * (n + m) + 1 : ℤ) = 2 * n + (2 * m + 1) := by ring
  rw [h, add_zsmul a (2 * n) (2 * m + 1)]

/-- Sum of an odd and an even shift. -/
lemma zsmul_odd_even_add (a : ℝ) (n m : ℤ) :
    (2 * n + 1) • a + (2 * m) • a = (2 * (n + m) + 1) • a := by
  rw [add_comm, zsmul_even_odd_add a m n]
  congr 1
  ring

/-- **Orbit equivalence under the period**: `x ~ y` iff `y` is on the orbit
of `x` under the map `p` (even iterates keep `x0` and shift `x1` by even
multiples of `a`; odd iterates send `x0 ↦ 1 - x0` and shift `x1` by odd
multiples of `a`). -/
def bandRel (a : ℝ) (x y : ℝ²) : Prop :=
  (∃ n : ℤ, x 0 = y 0 ∧ y 1 - x 1 = (2 * n) • a) ∨
    (∃ n : ℤ, x 0 + y 0 = 1 ∧ y 1 - x 1 = (2 * n + 1) • a)

/-- The equivalence relation on the plane identifying points on the same
period orbit. -/
def bandSetoid (a : ℝ) : Setoid ℝ² where
  r := bandRel a
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · -- reflexive: x ~ x (n = 0, even)
      intro x
      left
      refine ⟨0, ?_, ?_⟩
      · rfl
      · simp
    · -- symmetric
      intro x y h
      rcases h with ⟨n, hx0, hd⟩ | ⟨n, hsum, hd⟩
      · -- even: y = x with same x0 and shift 2n a  ⟹ x = y with shift −2n a
        left
        refine ⟨-n, ?_, ?_⟩
        · exact hx0.symm
        · calc
            x 1 - y 1 = -(y 1 - x 1) := by ring
            _ = -((2 * n) • a) := by rw [hd]
            _ = (2 * (-n)) • a := zsmul_even_neg a n
      · -- odd: x0 + y0 = 1, shift (2n+1) a
        right
        refine ⟨-n - 1, ?_, ?_⟩
        · have : x 0 + y 0 = 1 := hsum
          nlinarith
        · calc
            x 1 - y 1 = -(y 1 - x 1) := by ring
            _ = -((2 * n + 1) • a) := by rw [hd]
            _ = (2 * (-n - 1) + 1) • a := zsmul_odd_neg a n
    · -- transitive
      intro x y z hxy hyz
      rcases hxy with ⟨n, hx0, hd₁⟩ | ⟨n, hsum₁, hd₁⟩
      · rcases hyz with ⟨m, hy0, hd₂⟩ | ⟨m, hsum₂, hd₂⟩
        · -- even then even
          left
          refine ⟨n + m, ?_, ?_⟩
          · exact hx0.trans hy0
          · calc
              z 1 - x 1 = (z 1 - y 1) + (y 1 - x 1) := by ring
              _ = (2 * m) • a + (2 * n) • a := by rw [hd₂, hd₁]
              _ = (2 * (n + m)) • a := by
                rw [add_comm, zsmul_even_add a n m]
        · -- even then odd
          right
          refine ⟨n + m, ?_, ?_⟩
          · have : x 0 = y 0 := hx0
            have : y 0 + z 0 = 1 := hsum₂
            nlinarith
          · calc
              z 1 - x 1 = (z 1 - y 1) + (y 1 - x 1) := by ring
              _ = (2 * m + 1) • a + (2 * n) • a := by rw [hd₂, hd₁]
              _ = (2 * (n + m) + 1) • a := by
                rw [zsmul_odd_even_add a m n]
                congr 1
                ring
      · rcases hyz with ⟨m, hy0, hd₂⟩ | ⟨m, hsum₂, hd₂⟩
        · -- odd then even
          right
          refine ⟨n + m, ?_, ?_⟩
          · have : x 0 + y 0 = 1 := hsum₁
            have : y 0 = z 0 := hy0
            nlinarith
          · calc
              z 1 - x 1 = (z 1 - y 1) + (y 1 - x 1) := by ring
              _ = (2 * m) • a + (2 * n + 1) • a := by rw [hd₂, hd₁]
              _ = (2 * (n + m) + 1) • a := by
                rw [zsmul_even_odd_add a m n]
                congr 1
                ring
        · -- odd then odd
          left
          refine ⟨n + m + 1, ?_, ?_⟩
          · have : x 0 + y 0 = 1 := hsum₁
            have : y 0 + z 0 = 1 := hsum₂
            nlinarith
          · calc
              z 1 - x 1 = (z 1 - y 1) + (y 1 - x 1) := by ring
              _ = (2 * m + 1) • a + (2 * n + 1) • a := by rw [hd₂, hd₁]
              _ = (2 * (n + m + 1)) • a := by
                rw [add_comm, zsmul_odd_add a n m]

/-! ## The quotient band -/

/-- The **band**: the quotient of the plane by the period orbit equivalence. -/
abbrev Band (a : ℝ) : Type := Quotient (bandSetoid a)

/-- The quotient map from the plane onto the band. -/
def bandQuot (a : ℝ) (x : ℝ²) : Band a := Quotient.mk (bandSetoid a) x

/-- Points of the band are equal iff they are period-orbit equivalent. -/
lemma bandQuot_eq_iff {a : ℝ} {x y : ℝ²} : bandQuot a x = bandQuot a y ↔ bandRel a x y := by
  change Quotient.mk (bandSetoid a) x = Quotient.mk (bandSetoid a) y ↔ bandRel a x y
  exact Quotient.eq

/-- A single period step keeps the point in the same equivalence class. -/
lemma bandQuot_period {a : ℝ} (x : ℝ²) : bandQuot a (period a x) = bandQuot a x := by
  apply Quotient.sound
  right
  refine ⟨-1, ?_, ?_⟩
  · dsimp [period]
    ring
  · dsimp [period]
    simp

/-- An inverse period step keeps the point in the same equivalence class. -/
lemma bandQuot_periodInv {a : ℝ} (x : ℝ²) : bandQuot a (periodInv a x) = bandQuot a x := by
  apply Quotient.sound
  right
  refine ⟨0, ?_, ?_⟩
  · dsimp [periodInv]
    ring
  · dsimp [periodInv]
    simp


/-- The quotient map is continuous (the band carries the quotient
topology). -/
lemma continuous_bandQuot (a : ℝ) : Continuous (bandQuot a) := by
  change Continuous (fun x : ℝ² => Quot.mk (bandSetoid a).r x)
  exact continuous_quot_mk

/-- The quotient map is surjective onto the band. -/
lemma bandQuot_surjective (a : ℝ) : Function.Surjective (bandQuot a) := by
  intro q
  rcases Quot.exists_rep q with ⟨x, hx⟩
  refine ⟨x, ?_⟩
  change Quot.mk (bandSetoid a).r x = q
  exact hx


/-! ## Compactness of the band -/

/-- The norm squared in the plane is the sum of the squared coordinates. -/
lemma norm_sq_coord_sum (x : ℝ²) : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
  rw [← real_inner_self_eq_norm_sq]
  rw [PiLp.inner_apply]
  simp [Fin.sum_univ_two]

/-- The norm is bounded by the sum of the absolute values of the
coordinates. -/
lemma norm_le_abs_coord_sum (x : ℝ²) : ‖x‖ ≤ |x 0| + |x 1| := by
  have hsq : ‖x‖ ^ 2 ≤ (|x 0| + |x 1|) ^ 2 := by
    rw [norm_sq_coord_sum x]
    have h1 : x 0 ^ 2 = |x 0| ^ 2 := by rw [sq_abs]
    have h2 : x 1 ^ 2 = |x 1| ^ 2 := by rw [sq_abs]
    have hmul : 0 ≤ |x 0| * |x 1| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
    nlinarith [h1, h2, hmul]
  have habs := (sq_le_sq.mp hsq)
  rwa [abs_of_nonneg (norm_nonneg x), abs_of_nonneg (by positivity : 0 ≤ |x 0| + |x 1|)] at habs

/-- The **compact fundamental-domain chunk**: strip points whose height
parameter lies in `[0, 2a]`.  Every orbit meets this chunk (even shifts move
`x1` by multiples of `2a` and leave `x0` fixed). -/
def bandChunk (a : ℝ) : Set ℝ² := {x | x 0 ∈ Set.Icc 0 1 ∧ x 1 ∈ Set.Icc 0 (2 * a)}

/-- The chunk is contained in the unit strip. -/
lemma bandChunk_subset_unitStrip (a : ℝ) : bandChunk a ⊆ unitStrip := by
  intro x hx
  change x 0 ∈ Set.Icc 0 1 ∧ x 1 ∈ Set.Icc 0 (2 * a) at hx
  rw [unitStrip]
  exact hx.1

/-- The chunk is closed in the plane. -/
lemma isClosed_bandChunk (a : ℝ) : IsClosed (bandChunk a) := by
  have h0 : IsClosed {x : ℝ² | x 0 ∈ Set.Icc 0 1} :=
    isClosed_Icc.preimage (by fun_prop : Continuous (fun x : ℝ² => x 0))
  have h1 : IsClosed {x : ℝ² | x 1 ∈ Set.Icc 0 (2 * a)} :=
    isClosed_Icc.preimage (by fun_prop : Continuous (fun x : ℝ² => x 1))
  change IsClosed ({x | x 0 ∈ Set.Icc 0 1 ∧ x 1 ∈ Set.Icc 0 (2 * a)} : Set ℝ²)
  rw [show ({x | x 0 ∈ Set.Icc 0 1 ∧ x 1 ∈ Set.Icc 0 (2 * a)} : Set ℝ²) =
      {x | x 0 ∈ Set.Icc 0 1} ∩ {x | x 1 ∈ Set.Icc 0 (2 * a)} by
        ext y; simp]
  exact h0.inter h1

/-- The chunk is bounded (for positive `a`). -/
lemma isBounded_bandChunk (a : ℝ) (ha : 0 < a) : Bornology.IsBounded (bandChunk a) := by
  rw [Metric.isBounded_iff_subset_closedBall (0 : ℝ²)]
  refine ⟨1 + 2 * a, ?_⟩
  intro x hx
  rw [Metric.mem_closedBall, dist_eq_norm]
  rw [sub_zero]
  change x 0 ∈ Set.Icc 0 1 ∧ x 1 ∈ Set.Icc 0 (2 * a) at hx
  have hx0 : x 0 ∈ Set.Icc 0 1 := hx.1
  have hx1 : x 1 ∈ Set.Icc 0 (2 * a) := hx.2
  have ha2 : 0 ≤ 2 * a := by positivity
  have habs0 : |x 0| ≤ 1 := by
    have hle : 0 ≤ x 0 ∧ x 0 ≤ 1 := Set.mem_Icc.mp hx0
    rw [abs_of_nonneg hle.1]
    exact hle.2
  have habs1 : |x 1| ≤ 2 * a := by
    have hle : 0 ≤ x 1 ∧ x 1 ≤ 2 * a := Set.mem_Icc.mp hx1
    rw [abs_of_nonneg hle.1]
    exact hle.2
  have hm := norm_le_abs_coord_sum x
  have h01 : |x 0| + |x 1| ≤ 1 + 2 * a := by linarith
  exact le_trans hm h01

/-- **The chunk is compact** (Heine–Borel in the proper space `ℝ²`). -/
lemma isCompact_bandChunk (a : ℝ) (ha : 0 < a) : IsCompact (bandChunk a) := by
  exact Metric.isCompact_of_isClosed_isBounded (isClosed_bandChunk a) (isBounded_bandChunk a ha)


/-- Doubling the step: `n • (2a) = (2n) • a`. -/
lemma zsmul_two_mul (a : ℝ) (n : ℤ) : n • (2 * a) = (2 * n) • a := by
  rw [zsmul_eq_mul, zsmul_eq_mul]
  push_cast
  ring

/-- **Every orbit meets the chunk**: each point of the unit strip is
period-orbit equivalent to a point of `bandChunk a` (reduce the height by an
even shift, i.e. by a multiple of `2a`, which keeps `x0` fixed). -/
lemma exists_bandChunk_equiv {a : ℝ} (ha : 0 < a) {x : ℝ²} (hx : x ∈ unitStrip) :
    ∃ c : ℝ², c ∈ bandChunk a ∧ bandRel a x c := by
  change x 0 ∈ Set.Icc 0 1 at hx
  have hp : 0 < 2 * a := by positivity
  let n : ℤ := toIcoDiv (p := 2 * a) hp 0 (x 1)
  let c : ℝ² := !₂[x 0, x 1 - n • (2 * a)]
  have hmem : x 1 - n • (2 * a) ∈ Set.Ico 0 (0 + 2 * a) := by
    simpa [n] using (sub_toIcoDiv_zsmul_mem_Ico (p := 2 * a) hp 0 (x 1))
  have hc1lo : 0 ≤ x 1 - n • (2 * a) := (Set.mem_Ico.mp hmem).1
  have hc1hi : x 1 - n • (2 * a) < 2 * a := by
    have h' := (Set.mem_Ico.mp hmem).2
    simpa using h'
  refine ⟨c, ?_, ?_⟩
  · -- c ∈ bandChunk
    change c 0 ∈ Set.Icc 0 1 ∧ c 1 ∈ Set.Icc 0 (2 * a)
    constructor
    · dsimp [c]
      exact hx
    · dsimp [c]
      rw [Set.mem_Icc]
      constructor
      · exact hc1lo
      · exact le_of_lt hc1hi
  · -- bandRel a x c
    left
    refine ⟨-n, ?_, ?_⟩
    · rfl
    · dsimp [c]
      calc
        (x 1 - n • (2 * a)) - x 1 = -(n • (2 * a)) := by ring
        _ = -((2 * n) • a) := by rw [zsmul_two_mul a n]
        _ = (2 * (-n)) • a := zsmul_even_neg a n

/-- The band image of the unit strip equals the band image of the compact
chunk (every orbit meets the chunk). -/
lemma bandQuot_image_chunk_eq_unitStrip (a : ℝ) (ha : 0 < a) :
    bandQuot a '' bandChunk a = bandQuot a '' unitStrip := by
  ext q
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, bandChunk_subset_unitStrip a hx, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    rcases exists_bandChunk_equiv ha hx with ⟨c, hc, hrel⟩
    refine ⟨c, hc, ?_⟩
    exact (bandQuot_eq_iff.mpr hrel).symm

/-- **The band (the image of the unit strip in the quotient) is compact**:
it is the continuous image of the compact chunk `bandChunk a`. -/
lemma isCompact_bandQuot_unitStrip (a : ℝ) (ha : 0 < a) :
    IsCompact (bandQuot a '' unitStrip) := by
  rw [← bandQuot_image_chunk_eq_unitStrip a ha]
  exact IsCompact.image (isCompact_bandChunk a ha) (continuous_bandQuot a)


/-! ## The seam: the two strip boundary lines are glued -/

/-- The left edge of the strip (`x0 = 0`), lifted to the plane. -/
def leftEdge : Set ℝ² := {x | x 0 = 0}

/-- The right edge of the strip (`x0 = 1`), lifted to the plane. -/
def rightEdge : Set ℝ² := {x | x 0 = 1}

/-- The two boundary lines of the unit strip. -/
def stripBoundary : Set ℝ² := leftEdge ∪ rightEdge

/-- The image of the strip boundary in the band (its boundary loop). -/
def bandBoundary (a : ℝ) : Set (Band a) := bandQuot a '' stripBoundary

/-- The period map sends the left edge onto the right edge. -/
lemma period_leftEdge_mem_rightEdge {a : ℝ} {x : ℝ²} (hx : x ∈ leftEdge) :
    period a x ∈ rightEdge := by
  change (period a x) 0 = 1
  dsimp [period]
  have : x 0 = 0 := by simpa [leftEdge] using hx
  linarith

/-- The inverse period map sends the right edge onto the left edge. -/
lemma periodInv_rightEdge_mem_leftEdge {a : ℝ} {x : ℝ²} (hx : x ∈ rightEdge) :
    periodInv a x ∈ leftEdge := by
  change (periodInv a x) 0 = 0
  dsimp [periodInv]
  have : x 0 = 1 := by simpa [rightEdge] using hx
  linarith

/-- **The seam**: the images of the two boundary lines `x0 = 0` and
`x0 = 1` in the band coincide — the quotient identifies the two vertical
sides of the strip (with a shift by `a`).  This is where the band is closed
up into a loop. -/
lemma bandQuot_image_leftEdge_eq_rightEdge (a : ℝ) :
    bandQuot a '' leftEdge = bandQuot a '' rightEdge := by
  ext q
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨period a x, period_leftEdge_mem_rightEdge hx, bandQuot_period x⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨periodInv a x, periodInv_rightEdge_mem_leftEdge hx, bandQuot_periodInv x⟩

/-- The strip boundary lines lie inside the unit strip. -/
lemma stripBoundary_subset_unitStrip : stripBoundary ⊆ unitStrip := by
  intro x hx
  change x 0 ∈ Set.Icc 0 1
  rcases hx with hx | hx
  · have h0 : x 0 = 0 := by simpa [leftEdge] using hx
    rw [Set.mem_Icc]
    constructor <;> linarith
  · have h1 : x 0 = 1 := by simpa [rightEdge] using hx
    rw [Set.mem_Icc]
    constructor <;> linarith

/-- The boundary loop of the band lies in the band. -/
lemma bandBoundary_subset_band (a : ℝ) : bandBoundary a ⊆ bandQuot a '' unitStrip := by
  intro q hq
  rcases hq with ⟨x, hx, rfl⟩
  exact ⟨x, stripBoundary_subset_unitStrip hx, rfl⟩

/-- Each of the two boundary lines already gives the whole boundary loop:
`bandBoundary a = bandQuot a '' leftEdge = bandQuot a '' rightEdge`. -/
lemma bandBoundary_eq_leftEdge (a : ℝ) :
    bandBoundary a = bandQuot a '' leftEdge := by
  rw [bandBoundary, stripBoundary]
  rw [Set.image_union]
  rw [bandQuot_image_leftEdge_eq_rightEdge a]
  exact Set.union_self (bandQuot a '' rightEdge)


/-! ## Frontier of the band (part (b), second half) -/

/-- In the quotient topology on the band, a set is open iff its preimage
under the quotient map is open (the topology is coinduced by `bandQuot`). -/
lemma isOpen_bandQuot_iff (a : ℝ) {S : Set (Band a)} :
    IsOpen S ↔ IsOpen (bandQuot a ⁻¹' S) := by
  letI : Setoid ℝ² := bandSetoid a
  rw [isOpen_coinduced]
  have hsets : (Quotient.mk' ⁻¹' S) = bandQuot a ⁻¹' S := by
    ext x
    rfl
  rw [hsets]

/-- A point equivalent to a strip-interior point is in the strip interior
(orbits keep `x0` in `{x0, 1 − x0}`, which stays strictly between 0 and 1). -/
lemma bandRel_stripInterior_of_left {a : ℝ} {x y : ℝ²}
    (hxy : bandRel a x y) (hx : x ∈ stripInterior) : y ∈ stripInterior := by
  change x 0 ∈ Set.Ioo 0 1 at hx
  change y 0 ∈ Set.Ioo 0 1
  rcases hxy with ⟨n, hy0, hd⟩ | ⟨n, hsum, hd⟩
  · have : y 0 = x 0 := hy0.symm
    rw [this]
    exact hx
  · have hy0' : y 0 = 1 - x 0 := by linarith [hsum]
    rw [hy0']
    rw [Set.mem_Ioo]
    constructor <;> nlinarith [hx.1, hx.2]

/-- The strip interior is *saturated*: a point of the band has a
strip-interior lift iff all its lifts lie in the strip interior. -/
lemma preimage_bandQuot_stripInterior (a : ℝ) :
    bandQuot a ⁻¹' (bandQuot a '' stripInterior) = stripInterior := by
  ext x
  constructor
  · intro hx
    rcases hx with ⟨y, hy, hq⟩
    -- bandQuot x = bandQuot y ⟹ bandRel x y
    have hyx : bandRel a y x := (bandQuot_eq_iff.mp hq)
    exact bandRel_stripInterior_of_left hyx hy
  · intro hx
    exact ⟨x, hx, rfl⟩

/-- The image of the open strip interior in the band is open. -/
lemma isOpen_bandInterior (a : ℝ) : IsOpen (bandQuot a '' stripInterior) := by
  rw [isOpen_bandQuot_iff]
  rw [preimage_bandQuot_stripInterior a]
  exact stripInterior_isOpen

/-- Interior points of the band: any point with a lift `x0 ∈ (0,1)` is an
interior point of the band image (the open set `bandQuot '' stripInterior`
contains it and lies inside the band). -/
lemma mem_interior_band_of_stripInterior {a : ℝ} {x : ℝ²}
    (hx : x ∈ stripInterior) : bandQuot a x ∈ interior (bandQuot a '' unitStrip) := by
  have hopen : IsOpen (bandQuot a '' stripInterior) := isOpen_bandInterior a
  have hsub : bandQuot a '' stripInterior ⊆ bandQuot a '' unitStrip := by
    intro q hq
    rcases hq with ⟨y, hy, rfl⟩
    exact ⟨y, stripInterior_subset_unitStrip hy, rfl⟩
  exact mem_interior.mpr ⟨bandQuot a '' stripInterior, hsub, hopen, ⟨x, hx, rfl⟩⟩


/-- A point equivalent to a point of the unit strip lies in the unit strip
(orbits keep `x0` in `{x0, 1 − x0}`, both in `[0,1]`). -/
lemma bandRel_unitStrip_of_left {a : ℝ} {x y : ℝ²}
    (hxy : bandRel a x y) (hx : x ∈ unitStrip) : y ∈ unitStrip := by
  change x 0 ∈ Set.Icc 0 1 at hx
  change y 0 ∈ Set.Icc 0 1
  rcases hxy with ⟨n, hy0, hd⟩ | ⟨n, hsum, hd⟩
  · have : y 0 = x 0 := hy0.symm
    rw [this]
    exact hx
  · have hy0' : y 0 = 1 - x 0 := by linarith
    rw [hy0']
    rw [Set.mem_Icc]
    rcases Set.mem_Icc.mp hx with ⟨h1, h2⟩
    constructor <;> linarith

/-- The unit strip is *saturated*: a band point has a unit-strip lift iff
all its lifts lie in the unit strip. -/
lemma preimage_bandQuot_unitStrip (a : ℝ) :
    bandQuot a ⁻¹' (bandQuot a '' unitStrip) = unitStrip := by
  ext x
  constructor
  · intro hx
    rcases hx with ⟨y, hy, hq⟩
    have hyx : bandRel a y x := (bandQuot_eq_iff.mp hq)
    exact bandRel_unitStrip_of_left hyx hy
  · intro hx
    exact ⟨x, hx, rfl⟩

/-- The unit strip is closed in the plane. -/
lemma isClosed_unitStrip : IsClosed unitStrip := by
  rw [unitStrip]
  exact isClosed_Icc.preimage (by fun_prop : Continuous (fun x : ℝ² => x 0))

/-- The band image of the unit strip is closed: its preimage is the
(saturated) unit strip, which is closed. -/
lemma isClosed_bandQuot_unitStrip (a : ℝ) : IsClosed (bandQuot a '' unitStrip) := by
  refine ⟨?_⟩
  rw [isOpen_bandQuot_iff]
  rw [show bandQuot a ⁻¹' ((bandQuot a '' unitStrip)ᶜ) =
      (bandQuot a ⁻¹' (bandQuot a '' unitStrip))ᶜ by ext x; simp]
  rw [preimage_bandQuot_unitStrip a]
  exact isClosed_unitStrip.isOpen_compl


/-- A band point whose class contains a boundary strip point does not lie in
the interior of the band: an interior neighbourhood would pull back to an
open neighbourhood of the boundary lift, which would contain points leaving
the unit strip — whose classes lie outside the band. -/
lemma not_mem_interior_band_of_stripBoundary {a : ℝ} {x : ℝ²}
    (hx : x ∈ stripBoundary) : bandQuot a x ∉ interior (bandQuot a '' unitStrip) := by
  intro hint
  rcases mem_interior.mp hint with ⟨t, htsub, htopen, hxt⟩
  have hpre_open : IsOpen (bandQuot a ⁻¹' t) := (isOpen_bandQuot_iff a).1 htopen
  have hxpre : x ∈ bandQuot a ⁻¹' t := hxt
  rcases Metric.mem_nhds_iff.mp (hpre_open.mem_nhds hxpre) with ⟨r, hr, hball⟩
  let ε : ℝ := r / 2
  have hε : 0 < ε := by dsimp [ε]; positivity
  rcases hx with hx | hx
  · -- x0 = 0 : move left
    have hx0 : x 0 = 0 := by simpa [leftEdge] using hx
    let x' : ℝ² := !₂[-ε, x 1]
    have hx'nz : ¬ x' ∈ unitStrip := by
      intro hmem
      change x' 0 ∈ Set.Icc 0 1 at hmem
      dsimp [x'] at hmem
      rw [Set.mem_Icc] at hmem
      rcases hmem with ⟨h1, h2⟩
      linarith [hε]
    have hdist : ‖x' - x‖ < r := by
      have c0 : (x' - x) 0 = -ε := by dsimp [x']; simp [hx0]
      have c1 : (x' - x) 1 = 0 := by dsimp [x']; simp
      have hsq : ‖x' - x‖ ^ 2 < r ^ 2 := by
        rw [norm_sq_coord_sum]
        rw [c0, c1]
        rw [show (-ε) ^ 2 = ε ^ 2 by ring, zero_pow (by norm_num : (2 : ℕ) ≠ 0)]
        have hsmall : ε ^ 2 < r ^ 2 := by
          dsimp [ε]
          nlinarith [sq_pos_of_pos hr]
        simpa using hsmall
      have habs := abs_lt_of_sq_lt_sq hsq (le_of_lt hr)
      simpa [abs_of_nonneg (norm_nonneg _)] using habs
    have hx'ball : x' ∈ Metric.ball x r := by
      rw [Metric.mem_ball, dist_eq_norm]
      exact hdist
    have hq : bandQuot a x' ∈ t := hball hx'ball
    have hqS : bandQuot a x' ∈ bandQuot a '' unitStrip := htsub hq
    have hqnot : ¬ bandQuot a x' ∈ bandQuot a '' unitStrip := by
      intro hS
      rcases hS with ⟨w, hw, hwq⟩
      have hrel : bandRel a w x' := (bandQuot_eq_iff.mp hwq)
      have hx'' : x' ∈ unitStrip := bandRel_unitStrip_of_left hrel hw
      exact hx'nz hx''
    exact hqnot hqS
  · -- x0 = 1 : move right
    have hx0 : x 0 = 1 := by simpa [rightEdge] using hx
    let x' : ℝ² := !₂[1 + ε, x 1]
    have hx'nz : ¬ x' ∈ unitStrip := by
      intro hmem
      change x' 0 ∈ Set.Icc 0 1 at hmem
      dsimp [x'] at hmem
      rw [Set.mem_Icc] at hmem
      rcases hmem with ⟨h1, h2⟩
      linarith [hε]
    have hdist : ‖x' - x‖ < r := by
      have c0 : (x' - x) 0 = ε := by dsimp [x']; simp [hx0]
      have c1 : (x' - x) 1 = 0 := by dsimp [x']; simp
      have hsq : ‖x' - x‖ ^ 2 < r ^ 2 := by
        rw [norm_sq_coord_sum]
        rw [c0, c1]
        rw [zero_pow (by norm_num : (2 : ℕ) ≠ 0)]
        have hsmall : ε ^ 2 < r ^ 2 := by
          dsimp [ε]
          nlinarith [sq_pos_of_pos hr]
        simpa using hsmall
      have habs := abs_lt_of_sq_lt_sq hsq (le_of_lt hr)
      simpa [abs_of_nonneg (norm_nonneg _)] using habs
    have hx'ball : x' ∈ Metric.ball x r := by
      rw [Metric.mem_ball, dist_eq_norm]
      exact hdist
    have hq : bandQuot a x' ∈ t := hball hx'ball
    have hqS : bandQuot a x' ∈ bandQuot a '' unitStrip := htsub hq
    have hqnot : ¬ bandQuot a x' ∈ bandQuot a '' unitStrip := by
      intro hS
      rcases hS with ⟨w, hw, hwq⟩
      have hrel : bandRel a w x' := (bandQuot_eq_iff.mp hwq)
      have hx'' : x' ∈ unitStrip := bandRel_unitStrip_of_left hrel hw
      exact hx'nz hx''
    exact hqnot hqS

/-- **The frontier of the band is its boundary loop**:
`frontier (bandQuot a '' unitStrip) = bandBoundary a`. -/
lemma frontier_band_image (a : ℝ) :
    frontier (bandQuot a '' unitStrip) = bandBoundary a := by
  ext q
  constructor
  · -- q in frontier : closed band ⇒ q ∈ band and not interior; lift has x0 ∈ {0,1}
    intro hq
    rw [frontier, Set.mem_diff] at hq
    rcases hq with ⟨hqcl, hqint⟩
    have hclosed : closure (bandQuot a '' unitStrip) = bandQuot a '' unitStrip :=
      (isClosed_bandQuot_unitStrip a).closure_eq
    rw [hclosed] at hqcl
    rcases hqcl with ⟨x, hx, hqx⟩
    by_cases hstrip : x ∈ stripInterior
    · have hqi : bandQuot a x ∈ interior (bandQuot a '' unitStrip) :=
        mem_interior_band_of_stripInterior hstrip
      exact (hqint (by simpa [hqx] using hqi)).elim
    · have hx0cc : x 0 ∈ Set.Icc 0 1 := by
        rw [unitStrip] at hx
        simpa using hx
      have hnotopen : ¬ (0 < x 0 ∧ x 0 < 1) := by
        intro h
        apply hstrip
        change x 0 ∈ Set.Ioo 0 1
        exact h
      have hb : x 0 = 0 ∨ x 0 = 1 := by
        rcases Set.mem_Icc.mp hx0cc with ⟨h1, h2⟩
        by_cases h0 : x 0 = 0
        · exact Or.inl h0
        · right
          have hgt : 0 < x 0 := lt_of_le_of_ne h1 (by
            intro hz
            exact h0 hz.symm)
          by_contra h1'
          have hlt : x 0 < 1 := lt_of_le_of_ne h2 (by
            intro hz
            exact h1' hz)
          exact hnotopen ⟨hgt, hlt⟩
      refine ⟨x, ?_, hqx⟩
      rw [stripBoundary]
      rcases hb with h0 | h1
      · left
        change x 0 = 0
        exact h0
      · right
        change x 0 = 1
        exact h1
  · -- q on the boundary loop: q ∈ band and not in the interior
    intro hq
    rcases hq with ⟨x, hx, rfl⟩
    have hqin : bandQuot a x ∈ bandQuot a '' unitStrip :=
      ⟨x, stripBoundary_subset_unitStrip hx, rfl⟩
    rw [frontier]
    rw [Set.mem_diff]
    constructor
    · exact subset_closure hqin
    · exact not_mem_interior_band_of_stripBoundary hx

/-! ## The centreline circle (part (c) of sub-goal 1) -/

/-- The **centreline** of the band: the image of the middle line
`x0 = 1/2`.  On this line the period acts by `y ↦ y + a` (it fixes `x0`),
so the centreline is a circle whose circumference claim is: the map
`y ↦ bandQuot (1/2, y)` identifies exactly the points whose heights differ
by a multiple of `a` — i.e. the centreline is the quotient of `ℝ` by the
subgroup `aℤ`. -/
def bandCentre (a : ℝ) : Set (Band a) := bandQuot a '' {x : ℝ² | x 0 = 1 / 2}

/-- The canonical lift of a height parameter to the centreline. -/
def centreLift (a : ℝ) (y : ℝ) : Band a := bandQuot a !₂[(1 / 2 : ℝ), y]

/-- The period map preserves the middle line `x0 = 1/2`. -/
lemma period_centre (a : ℝ) (y : ℝ) : period a !₂[(1 / 2 : ℝ), y] = !₂[(1 / 2 : ℝ), y + a] := by
  ext i <;> fin_cases i <;> simp [period] <;> norm_num

/-- Lifting the height by `a` returns to the same centreline point (going
once around the band): `centreLift a (y + a) = centreLift a y`. -/
lemma centreLift_period {a : ℝ} (y : ℝ) : centreLift a (y + a) = centreLift a y := by
  dsimp [centreLift]
  have h := bandQuot_period (a := a) !₂[(1 / 2 : ℝ), y]
  -- h : bandQuot (period (!₂[1/2,y])) = bandQuot (!₂[1/2,y])
  rw [period_centre a y] at h
  exact h

/-- Equal centreline points have heights differing by a multiple of `a`
(the centreline is a circle of circumference `a`). -/
lemma centreLift_eq_iff_diff {a : ℝ} (y z : ℝ) :
    centreLift a y = centreLift a z → ∃ m : ℤ, z - y = m • a := by
  intro h
  have hrel : bandRel a !₂[(1 / 2 : ℝ), y] !₂[(1 / 2 : ℝ), z] := by
    simpa [centreLift] using (bandQuot_eq_iff.mp h)
  rcases hrel with ⟨n, hx0, hd⟩ | ⟨n, hsum, hd⟩
  · exact ⟨2 * n, hd⟩
  · exact ⟨2 * n + 1, hd⟩

/-- The centreline lies in the interior of the band (its lifts have
`x0 = 1/2 ∈ (0,1)`). -/
lemma bandCentre_subset_interior_band (a : ℝ) :
    bandCentre a ⊆ interior (bandQuot a '' unitStrip) := by
  intro q hq
  rcases hq with ⟨x, hx, hqx⟩
  have hx0 : x 0 = 1 / 2 := by simpa using hx
  have hS : x ∈ stripInterior := by
    change x 0 ∈ Set.Ioo 0 1
    rw [hx0]
    norm_num
  have hint : bandQuot a x ∈ interior (bandQuot a '' unitStrip) :=
    mem_interior_band_of_stripInterior hS
  rwa [hqx] at hint


/-- Shifting the height by any integer multiple of `a` returns to the same
centreline point (the centreline map is `a`-periodic in both directions). -/
lemma centreLift_zsmul {a : ℝ} (y : ℝ) (m : ℤ) :
    centreLift a (y + m • a) = centreLift a y := by
  have hper : Function.Periodic (fun t : ℝ => centreLift a t) a := by
    intro t
    exact centreLift_period t
  exact (hper.zsmul m) y

/-- **Equal centreline points are exactly those whose heights differ by a
multiple of `a`**: `centreLift` identifies precisely the quotient of `ℝ` by
the subgroup `aℤ`, i.e. the centreline is a circle of circumference `a`. -/
lemma centreLift_eq_iff {a : ℝ} (y z : ℝ) :
    centreLift a y = centreLift a z ↔ ∃ m : ℤ, z - y = m • a := by
  constructor
  · exact centreLift_eq_iff_diff y z
  · rintro ⟨m, hm⟩
    have hz : z = y + m • a := by
      calc
        z = y + (z - y) := by abel
        _ = y + m • a := by rw [hm]
    have h1 : centreLift a z = centreLift a y := by
      rw [hz]
      exact centreLift_zsmul y m
    exact h1.symm


/-- The **compact centreline segment**: the middle line cut down to one full
period, `x0 = 1/2`, `0 ≤ x1 ≤ a`.  Every centreline point has a lift on this
segment (reduce the height modulo `a`). -/
def bandCentreSeg (a : ℝ) : Set ℝ² := {x | x 0 = 1 / 2 ∧ x 1 ∈ Set.Icc 0 a}

/-- The continuous surjection from the centreline segment onto the
centreline: every centreline point is the image of a segment point (reduce
its height by a multiple of `a` into `[0, a]`). -/
lemma bandCentre_eq_image_seg (a : ℝ) (ha : 0 < a) :
    bandQuot a '' bandCentreSeg a = bandQuot a '' {x | x 0 = 1 / 2} := by
  ext q
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hx01 : x 0 = 1 / 2 ∧ x 1 ∈ Set.Icc 0 a := by
      simpa [bandCentreSeg] using hx
    exact ⟨x, hx01.1, rfl⟩
  · rintro ⟨x, hxmem, rfl⟩
    have hx0 : x 0 = 1 / 2 := by simpa using hxmem
    let n : ℤ := toIcoDiv (p := a) ha 0 (x 1)
    let y : ℝ := x 1 - n • a
    have hymem : y ∈ Set.Ico 0 (0 + a) :=
      sub_toIcoDiv_zsmul_mem_Ico (p := a) ha 0 (x 1)
    have hyge : 0 ≤ y := (Set.mem_Ico.mp hymem).1
    have hyle : y ≤ a := by
      have h' := (Set.mem_Ico.mp hymem).2
      exact le_of_lt (by simpa using h')
    let c : ℝ² := !₂[(1 / 2 : ℝ), y]
    have hc : c ∈ bandCentreSeg a := by
      change c 0 = 1 / 2 ∧ c 1 ∈ Set.Icc 0 a
      constructor
      · simp [c]
      · exact ⟨hyge, hyle⟩
    have hq : bandQuot a c = bandQuot a x := by
      have hdiff : x 1 - y = n • a := by
        dsimp [y]
        ring
      have hcl : centreLift a y = centreLift a (x 1) :=
        (centreLift_eq_iff y (x 1)).mpr ⟨n, hdiff⟩
      have hxveq : x = !₂[(1 / 2 : ℝ), x 1] := by
        ext i
        fin_cases i
        · simp [hx0]
        · rfl
      calc
        bandQuot a c = centreLift a y := by
          simp [c, centreLift]
        _ = centreLift a (x 1) := hcl
        _ = bandQuot a x := by
          dsimp [centreLift]
          rw [← hxveq]
    exact ⟨c, hc, hq⟩

/-- The centreline segment is closed. -/
lemma isClosed_bandCentreSeg (a : ℝ) : IsClosed (bandCentreSeg a) := by
  have h0 : IsClosed {x : ℝ² | x 0 = 1 / 2} :=
    isClosed_singleton.preimage (by fun_prop : Continuous (fun x : ℝ² => x 0))
  have h1 : IsClosed {x : ℝ² | x 1 ∈ Set.Icc 0 a} :=
    isClosed_Icc.preimage (by fun_prop : Continuous (fun x : ℝ² => x 1))
  change IsClosed ({x | x 0 = 1 / 2 ∧ x 1 ∈ Set.Icc 0 a} : Set ℝ²)
  rw [show ({x | x 0 = 1 / 2 ∧ x 1 ∈ Set.Icc 0 a} : Set ℝ²) =
      {x | x 0 = 1 / 2} ∩ {x | x 1 ∈ Set.Icc 0 a} by ext y; simp]
  exact h0.inter h1

/-- The centreline segment is compact. -/
lemma isCompact_bandCentreSeg (a : ℝ) (ha : 0 < a) : IsCompact (bandCentreSeg a) := by
  have hclosed : IsClosed (bandCentreSeg a) := isClosed_bandCentreSeg a
  have hsub : bandCentreSeg a ⊆ bandChunk a := by
    intro x hx
    change x 0 = 1 / 2 ∧ x 1 ∈ Set.Icc 0 a at hx
    change x 0 ∈ Set.Icc 0 1 ∧ x 1 ∈ Set.Icc 0 (2 * a)
    constructor
    · rw [Set.mem_Icc]
      constructor <;> norm_num [hx.1]
    · have : x 1 ≤ a := (Set.mem_Icc.mp hx.2).2
      rw [Set.mem_Icc]
      constructor
      · exact (Set.mem_Icc.mp hx.2).1
      · have : a ≤ 2 * a := by nlinarith [ha]
        linarith
  exact Metric.isCompact_of_isClosed_isBounded hclosed
    ((isBounded_bandChunk a ha).subset hsub)  -- IsBounded.subset

/-- **The centreline is compact**: the continuous image of the compact
centreline segment (one full period of the middle line). -/
lemma isCompact_bandCentre (a : ℝ) (ha : 0 < a) : IsCompact (bandCentre a) := by
  rw [bandCentre]
  rw [← bandCentre_eq_image_seg a ha]
  exact IsCompact.image (isCompact_bandCentreSeg a ha) (continuous_bandQuot a)


/-- **The centreline parametrisation**: `centreLift` maps onto the whole
centreline, is `a`-periodic (`centreLift_zsmul`), and identifies exactly the
points whose heights differ by a multiple of `a` (`centreLift_eq_iff`) —
so `y ↦ centreLift a y` is the parametrisation of the centreline circle by
`ℝ / aℤ` (circumference `a`). -/
lemma range_centreLift (a : ℝ) : Set.range (fun y : ℝ => centreLift a y) = bandCentre a := by
  ext q
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨!₂[(1 / 2 : ℝ), y], by simp, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    have hx0 : x 0 = 1 / 2 := by simpa using hx
    have hxveq : x = !₂[(1 / 2 : ℝ), x 1] := by
      ext i
      fin_cases i
      · simp [hx0]
      · rfl
    refine ⟨x 1, ?_⟩
    dsimp [centreLift]
    rw [← hxveq]

/-- `centreLift` is continuous (as a map `ℝ → Band a`). -/
lemma continuous_centreLift (a : ℝ) : Continuous (fun y : ℝ => centreLift a y) := by
  dsimp [centreLift]
  exact (continuous_bandQuot a).comp
    (by fun_prop : Continuous (fun y : ℝ => !₂[(1 / 2 : ℝ), y]))


