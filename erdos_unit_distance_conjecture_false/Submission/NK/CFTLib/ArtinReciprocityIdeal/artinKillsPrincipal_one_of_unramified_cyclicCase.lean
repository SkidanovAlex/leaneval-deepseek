import Mathlib
import Submission.NK.CFTLib.ArtinIdeal
import Submission.NK.CFTLib.ArtinReciprocityIdeal.Conductor
import Submission.NK.CFTLib.ArtinReciprocityIdeal.LangDefs
import Submission.NK.CFTLib.ArtinReciprocityIdeal.index_principalRay_one_eq_finrank
import Submission.NK.CFTLib.Existence.artinKillsPrincipal_one_of_isUnramifiedAtFinite
import Submission.NK.CFTLib.ArtinReciprocityIdeal.artinSym_kills_principalRay_one_of_unramified_cyclic

/-!
# The trivial-modulus reciprocity law for a cyclic unramified extension

The target of this file is

`NK.CFTLib.ArtinReciprocityIdeal.artinKillsPrincipal_one_of_unramified_cyclicCase`:

for a finite **cyclic** Galois extension `L / K` of number fields which is unramified at every
finite prime (`hram`: every ramification index is `1`) and an ideal-theoretic reciprocity law
`hARL : NK.CFTLib.ArtinReciprocityIdeal`, the Artin symbol of every principal ideal with a totally
positive generator is trivial: `NK.CFTLib.artinKillsPrincipal K L 1`.

## The reduction implemented here

The target is assembled from the single "conductor drop at the trivial modulus for an unramified
cyclic extension", isolated (and delegated) as

`NK.CFTLib.ArtinReciprocityIdeal.artinSym_kills_principalRay_one_of_unramified_cyclic`

in the module of the same name: `P(1) ≤ ker ψ`, i.e. `artinSym` kills the principal ray `P(1)`
(the subgroup of `Frac K` generated by the principal ideals `(a)`, `a` totally positive; at
`m = 1` the congruence condition of `CongrOne` is vacuous).

The assembly uses only proved and axiom-clean material:

* `differentIdeal_eq_top_of_ramificationIdxIn_eq_one` (`index_principalRay_one_eq_finrank.lean`):
  `hram` is the triviality of the relative different;
* `NK.CFTLib.Existence.artinKillsPrincipal_one_of_killsPrincipalRay_iiu`
  (`Existence/artinKillsPrincipal_one_of_isUnramifiedAtFinite.lean`): the dictionary from
  "`artinSym` kills `P(1)`" to `artinKillsPrincipal K L 1` (the independence of the Frobenius
  product from the choices is `NK.CFTLib.frobAtPrime_prod_irrel`);
* the compatibility of the two formulations of the Artin symbol of a fractional ideal, via
  `artinSymFracHom_apply`.

The corresponding *index* half of the conductor drop, `[Frac K : P(1)·𝔑(1)] = [L:K]`, is also
proved (axiom-clean) as `index_principalRay_sup_normRay_one_eq_finrank`; the remaining arithmetic
content is exactly the containment `P(1) ⊆ ker ψ`.

## Why the hypothesis `hARL` cannot supply the containment by itself

`hARL` yields *some* modulus `m` with `artinKillsPrincipal K L m`, i.e. it constrains
`frobAtPrime 𝔮` only for `𝔮 ∤ (m)` (`artinKillsPrincipal.mono` runs the other way,
`principalRay K m ≤ principalRay K 1`).  For an unramified extension the primes dividing `(m)` are
unramified, and the classical statement (Neukirch, *Algebraic Number Theory*, V.6.1; Lang, X §4)
that the conductor is supported on the ramified primes makes their congruence conditions redundant
— this is the content of the delegated lemma.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors IsMulCommutative
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.ArtinReciprocityIdeal

/-- **The trivial-modulus reciprocity law for a cyclic unramified extension.**

See the module documentation: the arithmetic content is the delegated containment
`P(1) ≤ ker artinSym` (`artinSym_kills_principalRay_one_of_unramified_cyclic`); everything else is
the dictionary between the ideal-theoretic and the fractional-ideal Artin symbols plus the
ramification-index form of unramifiedness. -/
theorem artinKillsPrincipal_one_of_unramified_cyclicCase
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    (hARL : NK.CFTLib.ArtinReciprocityIdeal)
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K,
      Ideal.ramificationIdxIn 𝔭.asIdeal (NumberField.RingOfIntegers L) = 1) :
    NK.CFTLib.artinKillsPrincipal K L 1 := by
  classical
  haveI hcommI : IsMulCommutative (L ≃ₐ[K] L) := by
    refine IsMulCommutative.of_comm fun a b => ?_
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := L ≃ₐ[K] L)
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
    rw [← zpow_add, ← zpow_add, add_comm m n]
  have hcomm : ∀ a b : L ≃ₐ[K] L, a * b = b * a :=
    fun a b => IsMulCommutative.is_comm.comm a b
  have hunr : differentIdeal (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L)
      = ⊤ :=
    differentIdeal_eq_top_of_ramificationIdxIn_eq_one (K := K) (L := L) hram
  refine NK.CFTLib.Existence.artinKillsPrincipal_one_of_killsPrincipalRay_iiu (K := K) (L := L)
    hcomm hunr ?_
  intro A hA
  have h := artinSym_kills_principalRay_one_of_unramified_cyclic (K := K) (L := L)
    hARL hram A hA
  rwa [artinSymFracHom_apply] at h

end NK.CFTLib.ArtinReciprocityIdeal
