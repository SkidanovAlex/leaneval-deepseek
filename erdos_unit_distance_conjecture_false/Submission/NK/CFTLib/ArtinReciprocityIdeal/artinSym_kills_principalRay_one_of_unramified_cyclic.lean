import Mathlib
import Submission.NK.CFTLib.ArtinReciprocityIdeal.LangDefs
import Submission.NK.CFTLib.ArtinReciprocityIdeal.normRayLeKer
import Submission.NK.CFTLib.ArtinIdeal
import Submission.NK.Chebotarev.Basic
import Submission.NK.CFTLib.ARL.auxField_exists_B
import Submission.NK.CFTLib.ARLTransfer.kernelLe_of_auxField
import Submission.NK.CFTLib.ArtinReciprocityIdeal.index_principalRay_one_eq_finrank
import Submission.NK.CFTLib.ArtinReciprocityIdeal.langX2KernelLe

/-!
# The Artin symbol kills the principal ray `P(1)` for a cyclic unramified extension

For a finite **cyclic** extension `L / K` of number fields which is unramified at every finite
prime (`hram`: every ramification index is `1`), the ideal-theoretic Artin symbol `ψ_{L/K}` kills
every principal ideal with a *totally positive* generator, i.e. the whole principal ray `P(1)`
(the subgroup of the group of fractional ideals generated by those ideals).

This is the "conductor drop at the unramified primes of the modulus" (Neukirch, *Algebraic Number
Theory*, V.6.1; Lang, *Algebraic Number Theory*, Ch. X §2 and §4): the conductor of an extension
unramified at all finite primes is `1`, so the reciprocity law at the trivial modulus holds.

## Structure of the proof

* `NK.CFTLib.ARLTransfer.kernelLe_of_auxField` is Lang's Theorem 2 (the transfer of Artin's lemma, the
  kernel containment `ker ψ ∩ I(m) ⊆ P(m)·𝔑(m)`), applied here at the modulus `m = 1`, where the
  coprimality condition `FracCoprime` and the ramification hypothesis are vacuous;
* the auxiliary-field hypothesis `NK.CFTLib.ARL.AuxFieldHyp K L 1` of Artin's lemma is supplied
  by `NK.CFTLib.ARL.auxField_exists_B`;
* the index argument (`NK.CFTLib.ArtinReciprocityIdeal.index_principalRay_one_eq_finrank`,
  `artinKillsPrincipal_one_of_kernelLe_principalRay`) then converts the containment
  `ker ⊆ P(1)·𝔑(1)` into the product condition `NK.CFTLib.artinKillsPrincipal K L 1`;
* finally `NK.CFTLib.ArtinReciprocityIdeal.principalRay_le_ker_of_artinKillsPrincipal`
  (`langX2KernelLe.lean`) turns the product condition into the statement that the principal ray
  lies in the kernel of the Artin symbol.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors IsMulCommutative
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.ArtinReciprocityIdeal

theorem artinSym_kills_principalRay_one_of_unramified_cyclic
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    [IsMulCommutative (L ≃ₐ[K] L)]
    (hARL : NK.CFTLib.ArtinReciprocityIdeal)
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K,
      Ideal.ramificationIdxIn 𝔭.asIdeal (NumberField.RingOfIntegers L) = 1) :
    ∀ A ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1,
      NK.CFTLib.ArtinReciprocityIdeal.artinSymFracHom (K := K) (L := L)
        (fun a b : L ≃ₐ[K] L => IsMulCommutative.is_comm.comm a b) A = 1 := by
  classical
  have hcomm : ∀ a b : L ≃ₐ[K] L, a * b = b * a :=
    fun a b => IsMulCommutative.is_comm.comm a b
  -- `hram` says that every finite prime is unramified in `L/K`
  have hunr : ∀ p : NK.Chebotarev.PrimeIdeal K, IsUnramified (K := K) (L := L) p :=
    fun p => isUnramified_of_ramificationIdxIn_eq_one (K := K) (L := L) hram p
  have hunr' : ∀ p : NK.Chebotarev.PrimeIdeal K,
      ¬ IsUnramified (K := K) (L := L) p → ((1 : ℕ) : 𝓞 K) ∈ p.asIdeal :=
    fun p hp => absurd (hunr p) hp
  -- at the modulus `1` nothing is coprime to `(1)`
  have hcop1 : ∀ A : Frac K, FracCoprime 1 A :=
    fun A 𝔭 h𝔭 => absurd h𝔭 (natCast_one_notMem_primeIdeal' K 𝔭)
  -- Artin's lemma: the auxiliary-field hypothesis at the trivial modulus
  have haux : NK.CFTLib.ARL.AuxFieldHyp K L 1 :=
    NK.CFTLib.ARL.auxField_exists_B K L 1 (by norm_num)
  -- the transfer (Lang X.2, Theorem 2) at the trivial modulus: the kernel containment
  have hker : ∀ A : Frac K,
      NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm
        (A : FractionalIdeal (𝓞 K)⁰ K) = 1 →
      A ∈ principalRay K 1 ⊔ normRay K L 1 :=
    fun A hA =>
      NK.CFTLib.ARLTransfer.kernelLe_of_auxField K L 1 (by norm_num) haux hunr' A (hcop1 A) hA
  -- the index argument turns the containment into the product condition at `m = 1`
  have hprinc : NK.CFTLib.artinKillsPrincipal K L 1 :=
    artinKillsPrincipal_one_of_kernelLe_principalRay (K := K) (L := L) hram hker
  -- hence the principal ray lies in the kernel of the Artin symbol
  have hP : principalRay K 1 ≤
      (artinSymFracHom (K := K) (L := L) hcomm).ker :=
    principalRay_le_ker_of_artinKillsPrincipal (K := K) (L := L) 1 (by norm_num) hunr' hprinc
  intro A hA
  exact MonoidHom.mem_ker.mp (hP hA)

end NK.CFTLib.ArtinReciprocityIdeal
