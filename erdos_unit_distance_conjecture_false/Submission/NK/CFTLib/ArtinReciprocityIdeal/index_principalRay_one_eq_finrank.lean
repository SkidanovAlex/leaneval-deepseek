import Mathlib
import Submission.NK.CFTLib.ArtinReciprocityIdeal.LangDefs
import Submission.NK.CFTLib.ArtinReciprocityIdeal.Conductor
import Submission.NK.CFTLib.ArtinReciprocityIdeal.indexPrincipalRaySupNormRayLe
import Submission.NK.NUV2.ARL.Gap.langCyclicRelIndex
import Submission.NK.CFTLib.ArtinReciprocityIdeal.artinSymSurjectiveOnCoprime
import Submission.NK.CFTLib.ArtinReciprocityIdeal.normRayLeKer
import Submission.NK.CFTLib.Existence.artinKillsPrincipal_one_of_isUnramifiedAtFinite

/-!
# The index of `P(1)·𝔑(1)` for a cyclic unramified extension

For a finite cyclic extension `L/K` of number fields which is unramified at every finite prime, the
subgroup of the group of fractional ideals generated by the principal ideals with a totally
positive generator and by the relative norms has index exactly `[L : K]`:

  `[I : P(1)·𝔑(1)] = [L : K]`.

## Why this is the missing index input of the conductor drop

The conductor drop at the trivial modulus for an unramified cyclic `L/K` is the containment
`ker ψ ⊆ P(1)·𝔑(1)` (the norm group is killed by `ψ` unconditionally, so this is the statement that
the *values* of the Frobenius map at the unramified primes dividing the modulus are the expected
ones).  Together with the two facts

* `[I : ker ψ] = [L : K]` (`artinSymSurjectiveOnCoprime`, the surjectivity of the Artin map) and
* `[I : P(1)·𝔑(1)] = [L : K]` (this file),

the containment gives `ker ψ = P(1)·𝔑(1)` and hence `P(1) ⊆ ker ψ`, i.e.
`NK.CFTLib.artinKillsPrincipal K L 1`.  This file therefore supplies the *index* half of the
conductor drop; the missing half is the containment itself (Artin's lemma/transfer, or the
Frobenius normalisation of the idèlic Artin map).

## The proof

* `≤`: `NK.CFTLib.ArtinReciprocityIdeal.indexPrincipalRaySupNormRayLe` at `m = 1`
  (the trivial modulus imposes no coprimality condition, `idealCoprimeGroup K 1 = ⊤`).
* `≥`: Lang's cyclic norm index inequality at `m = 1` —
  `NK.NUV2.ARL.Gap.langCyclicRelIndex` (axiom-clean) with the trivial modulus.  The
  admissibility hypothesis `IsAdmissible K L 1` is vacuous, because `(1 : 𝓞 K)` lies in no prime
  ideal, and the unramifiedness hypothesis is the `ramificationIdxIn` form of
  `¬IsUnramified p → (1 : 𝓞 K) ∈ p.asIdeal`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.ArtinReciprocityIdeal

/-- `(1 : 𝓞 K)` lies in no prime ideal. -/
theorem natCast_one_notMem_primeIdeal' (K : Type) [Field K] [NumberField K]
    (𝔭 : NK.Chebotarev.PrimeIdeal K) : ((1 : ℕ) : 𝓞 K) ∉ 𝔭.asIdeal := by
  intro h
  exact 𝔭.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr (by simpa using h))

/-- The trivial modulus imposes no coprimality condition: `I(1) = ⊤`. -/
theorem idealCoprimeGroup_one_eq_top (K : Type) [Field K] [NumberField K] :
    idealCoprimeGroup K 1 = ⊤ := by
  rw [eq_top_iff]
  intro A _
  rw [mem_idealCoprimeGroup_iff (K := K) 1 A]
  exact fun 𝔭 h𝔭 => absurd h𝔭 (natCast_one_notMem_primeIdeal' (K := K) 𝔭)

/-- **The admissibility of the trivial modulus is vacuous.** -/
theorem isAdmissible_one (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] : IsAdmissible K L 1 := by
  intro 𝔭 h𝔭
  exact absurd h𝔭 (natCast_one_notMem_primeIdeal' (K := K) 𝔭)

/-- **The index of `P(1)·𝔑(1)` is the degree, for a cyclic unramified extension.** -/
theorem index_principalRay_sup_normRay_one_eq_finrank
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1) :
    (principalRay K 1 ⊔ normRay K L 1).index = Module.finrank K L := by
  -- commutativity is available from cyclicity
  haveI : IsMulCommutative (L ≃ₐ[K] L) := by
    refine IsMulCommutative.of_comm fun a b => ?_
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := L ≃ₐ[K] L)
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
    rw [← zpow_add, ← zpow_add, add_comm m n]
  refine le_antisymm ?_ ?_
  · have h := indexPrincipalRaySupNormRayLe K L 1 (by norm_num)
    rw [idealCoprimeGroup_one_eq_top (K := K)] at h
    have h' : (principalRay K 1 ⊔ normRay K L 1).relIndex (⊤ : Subgroup (Frac K)) ≤
        Module.finrank K L := h
    rwa [Subgroup.relIndex_top_right] at h'
  · -- the `≥` direction: Lang's cyclic norm index inequality at the trivial modulus
    have hram' : ∀ p : NK.Chebotarev.PrimeIdeal K,
        ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
        ((1 : ℕ) : 𝓞 K) ∈ p.asIdeal := by
      intro p hp
      exact absurd (fun P hP => by
        haveI : P.asIdeal.IsPrime := P.isPrime
        haveI : P.asIdeal.LiesOver p.asIdeal := hP
        rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal
          P.asIdeal (Gal(L/K))]
        exact hram p) hp
    have h := (NK.NUV2.ARL.Gap.langCyclicRelIndex K L) 1 (by norm_num) hram'
      (isAdmissible_one K L)
    have h2 := h.2
    rwa [idealCoprimeGroup_one_eq_top (K := K), Subgroup.relIndex_top_right] at h2


/-! ## The `IsUnramified` form of the unramifiedness hypothesis -/

/-- Unramifiedness in the `IsUnramified` form from the `ramificationIdxIn` form. -/
theorem isUnramified_of_ramificationIdxIn_eq_one
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsMulCommutative (L ≃ₐ[K] L)]
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1)
    (p : NK.Chebotarev.PrimeIdeal K) :
    NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p := by
  intro P hP
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.LiesOver p.asIdeal := hP
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal
    P.asIdeal (Gal(L/K))]
  exact hram p

/-! ## The relative different from the ramification indices -/

/-- **The relative different is the unit ideal when every ramification index is one.** -/
theorem differentIdeal_eq_top_of_ramificationIdxIn_eq_one
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1) :
    differentIdeal (𝓞 K) (𝓞 L) = ⊤ := by
  classical
  refine Commons.NumberTheory.NumberField.differentIdeal_eq_top_of_forall_not_dvd ?_
  intro Q hQ
  by_cases hbot : Q = ⊥
  · rw [hbot]
    intro hdvd
    have hle : differentIdeal (𝓞 K) (𝓞 L) ≤ ⊥ := (Ideal.dvd_iff_le.mp hdvd).trans bot_le
    exact differentIdeal_ne_bot (le_bot_iff.mp hle)
  · let q : HeightOneSpectrum (𝓞 L) := ⟨Q, hQ, hbot⟩
    rw [Commons.NumberTheory.NumberField.ramificationIdx_one_iff_not_dvd_differentIdeal Q hQ]
    let p : NK.Chebotarev.PrimeIdeal K := q.under (𝓞 K)
    have hlies : q.asIdeal.LiesOver p.asIdeal :=
      (Ideal.liesOver_iff _ _).mpr (by simp only [p, HeightOneSpectrum.under_asIdeal])
    haveI : q.asIdeal.LiesOver p.asIdeal := hlies
    rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal
      q.asIdeal (Gal(L/K))]
    exact hram p

/-! ## The final reduction: the containment at the trivial modulus implies the target -/

/-- **The target theorem from the kernel containment at the trivial modulus.**  If the Artin
symbol is injective on the quotient by `P(1)·𝔑(1)` (i.e. `ker ψ ⊆ P(1)·𝔑(1)`: the classical
containment of the conductor theorem for an extension unramified at every finite prime), then the
Artin symbol kills every principal ideal with a totally positive generator.  The proof is the index
argument: `[I : ker] = [L:K] = [I : P(1)·𝔑(1)]` (`artinSymSurjectiveOnCoprime` and
`index_principalRay_sup_normRay_one_eq_finrank`), so the containment forces equality and hence
`P(1) ⊆ ker`. -/
theorem artinKillsPrincipal_one_of_kernelLe_principalRay
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsMulCommutative (L ≃ₐ[K] L)]
    [IsCyclic (L ≃ₐ[K] L)]
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1)
    (hker : ∀ A : Frac K, NK.CFTLib.Arl.artinSym
        (fun a b : Gal(L/K) => IsMulCommutative.is_comm.comm a b) A = 1 →
      A ∈ principalRay K 1 ⊔ normRay K L 1) :
    NK.CFTLib.artinKillsPrincipal K L 1 := by
  classical
  have hcomm : ∀ a b : Gal(L/K), a * b = b * a :=
    fun a b => IsMulCommutative.is_comm.comm a b
  let f : Frac K →* Gal(L/K) := artinSymFracHom hcomm
  let PN : Subgroup (Frac K) := principalRay K 1 ⊔ normRay K L 1
  have hf : ∀ A : Frac K, f A = NK.CFTLib.Arl.artinSym hcomm A := fun A => rfl
  have hle : f.ker ≤ PN := by
    intro A hA
    exact hker A (by rw [← hf A]; exact hA)
  have hsurj : Function.Surjective f := by
    intro σ
    obtain ⟨A, hA⟩ := artinSymSurjectiveOnCoprime K L 1 (by norm_num)
      (fun p hp => absurd (isUnramified_of_ramificationIdxIn_eq_one hram p) hp) σ
    exact ⟨(A : Frac K), by rw [hf]; exact hA⟩
  have hidxker : f.ker.index = Module.finrank K L := by
    rw [Subgroup.index_eq_card, ← IsGalois.card_aut_eq_finrank (F := K) (E := L)]
    rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv,
      MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top]
  have hidxPN : PN.index = Module.finrank K L :=
    index_principalRay_sup_normRay_one_eq_finrank (K := K) (L := L) hram
  have hker_le : PN ≤ f.ker := by
    have h := Subgroup.relIndex_mul_index hle
    rw [hidxPN, hidxker] at h
    have h2 : f.ker.relIndex PN * Module.finrank K L = 1 * Module.finrank K L := by
      rw [one_mul]; exact h
    exact Subgroup.relIndex_eq_one.mp (Nat.eq_of_mul_eq_mul_right Module.finrank_pos h2)
  have heq : f.ker = PN := le_antisymm hle hker_le
  have hP : principalRay K 1 ≤ f.ker := by
    rw [heq]; exact le_sup_left
  exact NK.CFTLib.Existence.artinKillsPrincipal_one_of_killsPrincipalRay_iiu hcomm
    (differentIdeal_eq_top_of_ramificationIdxIn_eq_one hram) (fun A hA => by
      have h1 : f A = 1 := hP hA
      rwa [hf] at h1)

end NK.CFTLib.ArtinReciprocityIdeal
