import Mathlib
import Submission.NK.CFTLib.normQuotientSetup

/-!
# The `p`-rank of the unit part of the norm class group

For a finite extension of number fields `K/F` the "unit part" `NK.CFTLib.normQuotientUnitImage`
of the norm class group `NK.CFTLib.normQuotient F K` has `p`-rank at most `rank F + \u03b4_p(F)`.
This is the `E_F` contribution in Roquette's id\u00e8le computation
(Neukirch\u2013Schmidt\u2013Wingberg, *Cohomology of Number Fields*, IX \u00a74; see
`NK.CFTLib.roquette_plan`).

The proof proceeds in two steps:

* the `p`-rank of a subgroup of `(\U0001d4de F)\u02e3` is at most `rank F + \u03b4_p(F)`
  (`pRank_subgroup_units_le`), because the torsion part contributes at most `\u03b4_p(F)` and the
  quotient by torsion embeds as a subgroup of `\u2124 ^ rank F`;
* the unit part of the norm class group is a quotient of a subgroup of `unitsInF F \u2245 (\U0001d4de F)\u02e3`.
-/

open NumberField
noncomputable section
namespace NK.CFTLib

/-- **The rank bound for a subgroup of `ℤⁿ`.**  If a finite `ℤ`-module `M` embeds `ℤ`-linearly
into `Fin n → ℤ`, then its `p`-rank is at most `n`. -/
theorem pRank_le_of_free_aux {p : ℕ} [Fact p.Prime] {M : Type} [AddCommGroup M] [Module.Finite ℤ M]
    (n : ℕ) (f : M →ₗ[ℤ] (Fin n → ℤ)) (hf : Function.Injective f) :
    NK.CFTLib.pRank p M ≤ n := by
  -- `ℤⁿ` is torsion-free, hence so is `M` (via the injection `f`).
  haveI htf : Module.IsTorsionFree ℤ M :=
    Function.Injective.moduleIsTorsionFree f hf (fun r m => f.map_smul r m)
  -- `M` is finitely generated and torsion-free over the PID `ℤ`, hence free: pick a basis
  -- `b : Basis (Fin r) ℤ M`.
  obtain ⟨r, b⟩ := Module.basisOfFiniteTypeTorsionFree' (R := ℤ) (M := M)
  -- The `p`-rank of `M` is the cardinality `r` of that basis.
  have hp : NK.CFTLib.pRank p M = r := by
    have h1 : NK.CFTLib.pRank p (Fin r → ℤ) = NK.CFTLib.pRank p M :=
      NK.CFTLib.pRank_congr (p := p) b.equivFun.symm.toAddEquiv
    rw [NK.CFTLib.pRank_free r] at h1
    exact h1.symm
  -- Transporting the injection along the basis: `Fin r → ℤ → ℤⁿ` is injective, so `r ≤ n`.
  have hfn : Function.Injective (f.comp b.equivFun.symm.toLinearMap) :=
    hf.comp b.equivFun.symm.injective
  have hle : Module.finrank ℤ (Fin r → ℤ) ≤ Module.finrank ℤ (Fin n → ℤ) :=
    LinearMap.finrank_le_finrank_of_injective hfn
  rw [Module.finrank_fin_fun ℤ, Module.finrank_fin_fun ℤ] at hle
  omega



/-! ## Two auxiliary lemmas on `pRank`

These mirror the corresponding statements in `Submission.NK.CFTLib.pRank_units_le`; they are
repeated here so that this file depends only on the definitions of the `pRank` development. -/

variable {p : ℕ}

/-- The `p`-rank of a finitely generated `ℤ`-module `G` is at most the `p`-rank of the kernel plus
the `p`-rank of the image of a `ℤ`-linear map `G → Q`. -/
theorem pRank_le_add_ker_range_aux (p : ℕ) [Fact p.Prime] {G Q : Type*} [AddCommGroup G]
    [AddCommGroup Q] [Module.Finite ℤ G] [Module.Finite ℤ Q] (f : G →ₗ[ℤ] Q) :
    pRank p G ≤ pRank p ↥(f.ker) + pRank p ↥(f.range) := by
  haveI : Module.Finite ℤ ↥(f.range) := inferInstance
  set f' : G →ₗ[ℤ] ↥(f.range) := f.codRestrict f.range fun c => LinearMap.mem_range_self f c with hf'
  have hsurj : Function.Surjective f' := by
    rintro ⟨y, hy⟩
    obtain ⟨x, rfl⟩ := LinearMap.mem_range.mp hy
    exact ⟨x, Subtype.ext rfl⟩
  have hker : f'.ker = f.ker := by
    ext x
    simp only [LinearMap.mem_ker, hf']
    constructor
    · intro h
      have h2 := congrArg Subtype.val h
      simpa using h2
    · intro h
      exact Subtype.ext (by simpa using h)
  have h := pRank_le_add_ker (p := p) f' hsurj
  rw [hker] at h
  exact h


/-- A `ℤ`-module generated by a single element has `p`-rank at most `1`. -/
theorem pRank_le_one_of_generator_aux (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M] (g : M)
    (hg : ∀ x : M, ∃ n : ℤ, n • g = x) : pRank p M ≤ 1 := by
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton ℤ M g) := by
    intro x
    obtain ⟨n, hn⟩ := hg x
    exact ⟨n, by rw [LinearMap.toSpanSingleton_apply]; exact hn⟩
  have h1 : pRank p ℤ = 1 := by
    rw [pRank, Module.finrank_tensorProduct (R := ZMod p) (S := ℤ) (M := ZMod p) (M' := ℤ),
      Module.finrank_self, one_mul, Module.finrank_self]
  calc pRank p M ≤ pRank p ℤ := pRank_le_of_surjective (p := p) _ hsurj
    _ = 1 := h1


/-- A finite additive group whose order is not divisible by `p` has `p`-rank `0`. -/
theorem pRank_eq_zero_of_not_dvd_natCard_aux (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M]
    [Finite M] (h : ¬ p ∣ Nat.card M) : pRank p M = 0 := by
  haveI : Fintype M := Fintype.ofFinite M
  have hcop : Nat.Coprime p (Nat.card M) := (Nat.Prime.coprime_iff_not_dvd Fact.out).mpr h
  obtain ⟨a, b, hab⟩ : ∃ a b : ℤ, a * (p : ℤ) + b * (Nat.card M : ℤ) = 1 := by
    refine ⟨Nat.gcdA p (Nat.card M), Nat.gcdB p (Nat.card M), ?_⟩
    have hg := Nat.gcd_eq_gcd_ab p (Nat.card M)
    rw [hcop] at hg
    push_cast at hg
    nlinarith [hg]
  have hp0 : ∀ r : ZMod p, (p : ℤ) • r = 0 := fun r => by
    rw [natCast_zsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hkey : ∀ m : M, (p : ℤ) • (a • m) = m := by
    intro m
    have h1 : (Nat.card M : ℤ) • m = 0 := by
      obtain ⟨k, hk⟩ := addOrderOf_dvd_natCard m
      rw [hk, natCast_zsmul, mul_nsmul, addOrderOf_nsmul_eq_zero, nsmul_zero]
    have h2 : (b * (Nat.card M : ℤ)) • m = 0 := by rw [mul_smul, h1, smul_zero]
    calc (p : ℤ) • (a • m) = ((p : ℤ) * a) • m := (mul_smul _ _ _).symm
      _ = (a * (p : ℤ)) • m := by rw [mul_comm]
      _ = ((a * (p : ℤ)) + b * (Nat.card M : ℤ)) • m := by rw [add_smul, h2, add_zero]
      _ = (1 : ℤ) • m := by rw [hab]
      _ = m := one_smul _ _
  have hzero : ∀ z : TensorProduct ℤ (ZMod p) M, z = 0 := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rfl
    | tmul r m =>
        calc (r : ZMod p) ⊗ₜ[ℤ] m
            = (r : ZMod p) ⊗ₜ[ℤ] ((p : ℤ) • (a • m)) := by rw [hkey m]
          _ = ((p : ℤ) • r) ⊗ₜ[ℤ] (a • m) := by rw [TensorProduct.smul_tmul]
          _ = 0 := by rw [hp0 r, TensorProduct.zero_tmul]
    | add x y hx hy => rw [hx, hy, add_zero]
  haveI : Subsingleton (TensorProduct ℤ (ZMod p) M) :=
    ⟨fun x y => by rw [hzero x, hzero y]⟩
  rw [pRank, Module.finrank_eq_zero_of_subsingleton]


/-- The `p`-rank of a finite subgroup of the roots of unity of a number field is at most
`δ_p(F)`. -/
theorem pRank_subgroup_torsion_le_aux (F : Type) [Field F] [NumberField F] (p : ℕ) [Fact p.Prime]
    (K : Subgroup (𝓞 F)ˣ) (hK : K ≤ NumberField.Units.torsion F) :
    pRank p (Additive ↥K) ≤ _root_.CFTLib.delta F p := by
  haveI hfinK : Finite ↥K := by
    refine Finite.of_injective
      (fun x : ↥K => (⟨(x : (𝓞 F)ˣ), hK x.2⟩ : ↥(NumberField.Units.torsion F))) ?_
    intro a b hab
    exact Subtype.ext (congrArg (fun y : ↥(NumberField.Units.torsion F) => (y : (𝓞 F)ˣ)) hab)
  haveI : IsCyclic ↥K := isCyclic_subgroup_units K
  by_cases hp : p ∣ Nat.card ↥K
  · have hδ : _root_.CFTLib.delta F p = 1 := by
      haveI : Fintype ↥K := Fintype.ofFinite ↥K
      obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card p (by simpa [Nat.card_eq_fintype_card] using hp)
      have hord : orderOf ((x : ↥K) : (𝓞 F)ˣ) = p := by
        rw [Subgroup.orderOf_coe, hx]
      have hprU : IsPrimitiveRoot ((x : ↥K) : (𝓞 F)ˣ) p := by
        refine IsPrimitiveRoot.mk ?_ ?_
        · rw [← hord]; exact pow_orderOf_eq_one _
        · intro l hl; rw [← hord]; exact orderOf_dvd_iff_pow_eq_one.mpr hl
      have hex : ∃ ζ : F, IsPrimitiveRoot ζ p :=
        ⟨algebraMap (𝓞 F) F ((x : ↥K) : (𝓞 F)ˣ), IsPrimitiveRoot.coe_coe_iff.mpr hprU⟩
      rw [_root_.CFTLib.delta]
      simp [hex]
    rw [hδ]
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥K)
    refine pRank_le_one_of_generator_aux p (Additive.ofMul g) ?_
    intro y
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg y.toMul)
    exact ⟨n, by rw [← ofMul_zpow, hn]; rfl⟩
  · rw [pRank_eq_zero_of_not_dvd_natCard_aux p (M := Additive ↥K) ?_]
    · exact Nat.zero_le _
    · rwa [Nat.card_congr (Additive.ofMul : ↥K ≃ Additive ↥K)] at hp


variable (F : Type) [Field F] [NumberField F]

/-- The `ℤ`-linear "coordinate" map `(𝓞 F)ˣ → ℤ ^ rank F`, with kernel the torsion subgroup. -/
noncomputable def unitsCoord :
    Additive (𝓞 F)ˣ →ₗ[ℤ] (Fin (NumberField.Units.rank F) → ℤ) :=
  ((NumberField.Units.basisUnitLattice F).equivFun).toLinearMap.comp
    ((NumberField.Units.logEmbedding F).codRestrict (NumberField.Units.unitLattice F)
      (fun x => Submodule.mem_map_of_mem (p := ⊤) trivial)).toIntLinearMap

lemma unitsCoord_eq_zero_iff (u : (𝓞 F)ˣ) :
    unitsCoord F (Additive.ofMul u) = 0 ↔ u ∈ NumberField.Units.torsion F := by
  have h1 : unitsCoord F (Additive.ofMul u)
      = (NumberField.Units.basisUnitLattice F).equivFun
        ⟨(NumberField.Units.logEmbedding F) (Additive.ofMul u),
          Submodule.mem_map_of_mem (p := ⊤) trivial⟩ := rfl
  rw [h1, LinearEquiv.map_eq_zero_iff, Subtype.ext_iff, Submodule.coe_zero,
    NumberField.Units.dirichletUnitTheorem.logEmbedding_eq_zero_iff]

/-- Any subgroup of `(𝓞 F)ˣ` is a finitely generated `ℤ`-module. -/
theorem finite_subgroup_units (A : Subgroup (𝓞 F)ˣ) : Module.Finite ℤ (Additive ↥A) := by
  classical
  set T : Subgroup (𝓞 F)ˣ := NumberField.Units.torsion F with hT
  set incl : Additive ↥A →ₗ[ℤ] Additive (𝓞 F)ˣ :=
    AddMonoidHom.toIntLinearMap (MonoidHom.toAdditive A.subtype) with hincl
  set φ : Additive ↥A →ₗ[ℤ] (Fin (NumberField.Units.rank F) → ℤ) :=
    (unitsCoord F).comp incl with hφ
  have hker : ∀ x : Additive ↥A, φ x = 0 ↔ (x.toMul : (𝓞 F)ˣ) ∈ T := by
    intro x
    have hx : incl x = Additive.ofMul (x.toMul : (𝓞 F)ˣ) := rfl
    show unitsCoord F (incl x) = 0 ↔ _
    rw [hx]
    exact unitsCoord_eq_zero_iff F _
  set inc' : Additive ↥(A ⊓ T) →ₗ[ℤ] Additive ↥A :=
    AddMonoidHom.toIntLinearMap (MonoidHom.toAdditive (Subgroup.inclusion inf_le_left)) with hinc'
  have hinc'a : ∀ y : Additive ↥(A ⊓ T),
      inc' y = Additive.ofMul (Subgroup.inclusion inf_le_left y.toMul) := fun y => rfl
  haveI hfinAT : Module.Finite ℤ (Additive ↥(A ⊓ T)) := by
    haveI : Finite ↥(A ⊓ T) :=
      Finite.of_injective (fun x : ↥(A ⊓ T) => (⟨(x : (𝓞 F)ˣ), x.2.2⟩ : ↥T))
        (fun a b h => Subtype.ext (congrArg (fun y : ↥T => (y : (𝓞 F)ˣ)) h))
    exact (Module.Finite.iff_addGroup_fg).mpr AddGroup.fg_of_finite
  haveI hfinR : Module.Finite ℤ ↥(φ.range) :=
    Module.Finite.of_fg (IsNoetherian.noetherian (φ.range))
  have hsurj : Function.Surjective (φ.codRestrict φ.range fun x => LinearMap.mem_range_self φ x) := by
    intro y
    obtain ⟨x, hx⟩ := LinearMap.mem_range.mp y.2
    exact ⟨x, Subtype.ext hx⟩
  have hexact : Function.Exact inc'
      (φ.codRestrict φ.range fun x => LinearMap.mem_range_self φ x) := by
    rw [LinearMap.exact_iff]
    refine le_antisymm ?_ ?_
    · intro y hy
      have h1 := congrArg Subtype.val (LinearMap.mem_ker.mp hy)
      rw [LinearMap.codRestrict_apply, Submodule.coe_zero] at h1
      have hmem : (y.toMul : (𝓞 F)ˣ) ∈ T := (hker y).mp h1
      refine LinearMap.mem_range.mpr ⟨Additive.ofMul
        (⟨(y.toMul : (𝓞 F)ˣ), ⟨y.toMul.2, hmem⟩⟩ : ↥(A ⊓ T)), ?_⟩
      rw [hinc'a]
      rfl
    · intro y hy
      obtain ⟨z, rfl⟩ := LinearMap.mem_range.mp hy
      rw [LinearMap.mem_ker]
      apply Subtype.ext
      rw [LinearMap.codRestrict_apply, Submodule.coe_zero]
      exact LinearMap.mem_ker.mp (by
        rw [LinearMap.mem_ker, hinc'a z]
        exact (hker _).mpr (z.toMul).2.2)
  exact Module.Finite.of_exact hexact hsurj

/-- `pRank` of a subgroup of the unit group `(𝓞 F)ˣ` is at most `rank F + δ_p(F)`. -/
theorem pRank_subgroup_units_le (p : ℕ) [Fact p.Prime] (A : Subgroup (𝓞 F)ˣ) :
    pRank p (Additive ↥A) ≤ NumberField.Units.rank F + _root_.CFTLib.delta F p := by
  classical
  set T : Subgroup (𝓞 F)ˣ := NumberField.Units.torsion F with hT
  set incl : Additive ↥A →ₗ[ℤ] Additive (𝓞 F)ˣ :=
    AddMonoidHom.toIntLinearMap (MonoidHom.toAdditive A.subtype) with hincl
  set φ : Additive ↥A →ₗ[ℤ] (Fin (NumberField.Units.rank F) → ℤ) :=
    (unitsCoord F).comp incl with hφ
  have hker : ∀ x : Additive ↥A, φ x = 0 ↔ (x.toMul : (𝓞 F)ˣ) ∈ T := by
    intro x
    have hx : incl x = Additive.ofMul (x.toMul : (𝓞 F)ˣ) := rfl
    show unitsCoord F (incl x) = 0 ↔ _
    rw [hx]
    exact unitsCoord_eq_zero_iff F _
  set inc' : Additive ↥(A ⊓ T) →ₗ[ℤ] Additive ↥A :=
    AddMonoidHom.toIntLinearMap (MonoidHom.toAdditive (Subgroup.inclusion inf_le_left)) with hinc'
  have hinc'a : ∀ y : Additive ↥(A ⊓ T),
      inc' y = Additive.ofMul (Subgroup.inclusion inf_le_left y.toMul) := fun y => rfl
  have hinc'mem : ∀ y, inc' y ∈ φ.ker := by
    intro y
    rw [LinearMap.mem_ker, hinc'a y]
    exact (hker _).mpr (y.toMul).2.2
  haveI hfinAT : Module.Finite ℤ (Additive ↥(A ⊓ T)) := by
    haveI : Finite ↥(A ⊓ T) :=
      Finite.of_injective (fun x : ↥(A ⊓ T) => (⟨(x : (𝓞 F)ˣ), x.2.2⟩ : ↥T))
        (fun a b h => Subtype.ext (congrArg (fun y : ↥T => (y : (𝓞 F)ˣ)) h))
    exact (Module.Finite.iff_addGroup_fg).mpr AddGroup.fg_of_finite
  haveI hfinR : Module.Finite ℤ ↥(φ.range) :=
    Module.Finite.of_fg (IsNoetherian.noetherian (φ.range))
  haveI hfinA : Module.Finite ℤ (Additive ↥A) := finite_subgroup_units F A
  have h1 : pRank p (Additive ↥A) ≤ pRank p ↥(φ.ker) + pRank p ↥(φ.range) :=
    pRank_le_add_ker_range_aux p φ
  have h2 : pRank p ↥(φ.ker) ≤ _root_.CFTLib.delta F p := by
    have hsurj2 : Function.Surjective (inc'.codRestrict φ.ker hinc'mem) := by
      intro y
      have hy : (y.1.toMul : (𝓞 F)ˣ) ∈ T := (hker y.1).mp y.2
      refine ⟨Additive.ofMul (⟨(y.1.toMul : (𝓞 F)ˣ), ⟨y.1.toMul.2, hy⟩⟩ : ↥(A ⊓ T)), ?_⟩
      apply Subtype.ext
      show inc' _ = y.1
      rw [hinc'a]
      rfl
    calc pRank p ↥(φ.ker)
        ≤ pRank p (Additive ↥(A ⊓ T)) := pRank_le_of_surjective _ hsurj2
      _ ≤ _root_.CFTLib.delta F p := pRank_subgroup_torsion_le_aux F p (A ⊓ T) inf_le_right
  have h3 : pRank p ↥(φ.range) ≤ NumberField.Units.rank F :=
    pRank_le_of_free_aux (NumberField.Units.rank F) (φ.range).subtype Subtype.val_injective
  omega


section UnitsInF


/-- The injectivity of `(𝓞 F)ˣ → Fˣ`. -/
lemma unitsInF_injective : Function.Injective (Units.map (algebraMap (𝓞 F) F).toMonoidHom) := by
  intro u v huv
  exact Units.ext (NumberField.RingOfIntegers.coe_injective (by
    have h := congrArg (fun w : Fˣ => (w : F)) huv
    simpa using h))

/-- A subgroup of `unitsInF F` is a finitely generated `ℤ`-module. -/
theorem finite_subgroup_unitsInF (H : Subgroup Fˣ) (hH : H ≤ unitsInF F) :
    Module.Finite ℤ (Additive ↥H) := by
  set f : (𝓞 F)ˣ →* Fˣ := Units.map (algebraMap (𝓞 F) F).toMonoidHom with hf
  set A : Subgroup (𝓞 F)ˣ := H.comap f with hA
  have hmap : A.map f = H := Subgroup.map_comap_eq_self hH
  have e : ↥A ≃* ↥H := by
    rw [← hmap]
    exact Subgroup.equivMapOfInjective A f (unitsInF_injective F)
  haveI : Module.Finite ℤ (Additive ↥A) := finite_subgroup_units F A
  exact Module.Finite.equiv e.toAdditive.toIntLinearEquiv

/-- `pRank` of a subgroup of `unitsInF F` is at most `rank F + δ_p(F)`. -/
theorem pRank_subgroup_unitsInF_le (p : ℕ) [Fact p.Prime] (H : Subgroup Fˣ)
    (hH : H ≤ unitsInF F) :
    pRank p (Additive ↥H) ≤ NumberField.Units.rank F + _root_.CFTLib.delta F p := by
  set f : (𝓞 F)ˣ →* Fˣ := Units.map (algebraMap (𝓞 F) F).toMonoidHom with hf
  set A : Subgroup (𝓞 F)ˣ := H.comap f with hA
  have hmap : A.map f = H := Subgroup.map_comap_eq_self hH
  have e : ↥A ≃* ↥H := by
    rw [← hmap]
    exact Subgroup.equivMapOfInjective A f (unitsInF_injective F)
  have hp : pRank p (Additive ↥H) = pRank p (Additive ↥A) := (pRank_congr e.toAdditive).symm
  rw [hp]
  exact pRank_subgroup_units_le F p A

end UnitsInF


section Main

variable (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K]
  [FiniteDimensional F K]

theorem pRank_normQuotientUnitImage_le (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K]
    [Algebra F K] [FiniteDimensional F K] (p : ℕ) [Fact p.Prime] :
    NK.CFTLib.pRank p ↥(NK.CFTLib.normQuotientUnitImage F K) ≤
      NumberField.Units.rank F + _root_.CFTLib.delta F p := by
  classical
  set P : Subgroup Fˣ := normPrincipalPreimage F K with hP
  set U : Subgroup Fˣ := unitsNormSubgroup F K with hU
  set B : Subgroup Fˣ := unitsInF F ⊓ P with hB
  have hBP : B ≤ P := inf_le_right
  have hUP : U ≤ P := unitsNormSubgroup_le_normPrincipalPreimage F K
  set N : AddSubgroup (Additive ↥P) := (U.subgroupOf P).toAddSubgroup with hN
  set f : Additive ↥B →ₗ[ℤ] normQuotient F K :=
    (AddMonoidHom.toIntLinearMap (QuotientAddGroup.mk' N)).comp
      (AddMonoidHom.toIntLinearMap (MonoidHom.toAdditive (Subgroup.inclusion hBP))) with hf
  have hbot : (U.subgroupOf P).toAddSubgroup.map (QuotientAddGroup.mk' N) = ⊥ :=
    (AddSubgroup.map_eq_bot_iff _).mpr (le_of_eq (QuotientAddGroup.ker_mk' N).symm)
  have hsup : ((U ⊔ B).subgroupOf P).toAddSubgroup
      = (U.subgroupOf P).toAddSubgroup ⊔ (B.subgroupOf P).toAddSubgroup := by
    rw [Subgroup.subgroupOf_sup hUP hBP]
    exact OrderIso.map_sup Subgroup.toAddSubgroup _ _
  have hstar : normQuotientUnitImage F K
      = (B.subgroupOf P).toAddSubgroup.map (QuotientAddGroup.mk' N) := by
    rw [show normQuotientUnitImage F K
        = ((U ⊔ B).subgroupOf P).toAddSubgroup.map (QuotientAddGroup.mk' N) from rfl,
      hsup, AddSubgroup.map_sup, hbot]
    simp
  have hrange : f.range.toAddSubgroup
      = (B.subgroupOf P).toAddSubgroup.map (QuotientAddGroup.mk' N) := by
    ext y
    rw [Submodule.mem_toAddSubgroup]
    constructor
    · intro hy
      obtain ⟨x, hx⟩ := LinearMap.mem_range.mp hy
      refine AddSubgroup.mem_map.mpr ⟨Additive.ofMul (Subgroup.inclusion hBP x.toMul), ?_, ?_⟩
      · rw [Additive.mem_toAddSubgroup, Subgroup.mem_subgroupOf]
        exact x.toMul.2
      · rw [← hx]
        rfl
    · intro hy
      obtain ⟨z, hz, hzy⟩ := AddSubgroup.mem_map.mp hy
      refine LinearMap.mem_range.mpr ⟨Additive.ofMul ⟨(z.toMul : Fˣ), hz⟩, ?_⟩
      rw [← hzy]
      rfl
  haveI hfinB : Module.Finite ℤ (Additive ↥B) := finite_subgroup_unitsInF F B inf_le_left
  have hbound : pRank p (Additive ↥B) ≤
      NumberField.Units.rank F + _root_.CFTLib.delta F p :=
    pRank_subgroup_unitsInF_le F p B inf_le_left
  have hsurj : Function.Surjective (f.codRestrict f.range fun x => LinearMap.mem_range_self f x) := by
    intro y
    obtain ⟨x, hx⟩ := LinearMap.mem_range.mp y.2
    exact ⟨x, Subtype.ext hx⟩
  have hrangele : pRank p ↥(f.range) ≤ pRank p (Additive ↥B) :=
    pRank_le_of_surjective (f.codRestrict f.range fun x => LinearMap.mem_range_self f x) hsurj
  calc pRank p ↥(normQuotientUnitImage F K)
      = pRank p ↥(f.range.toAddSubgroup) := by rw [hstar, hrange]
    _ = pRank p ↥(f.range) := rfl
    _ ≤ pRank p (Additive ↥B) := hrangele
    _ ≤ NumberField.Units.rank F + _root_.CFTLib.delta F p := hbound


end Main
end NK.CFTLib
