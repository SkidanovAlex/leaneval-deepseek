import Mathlib
import Submission.NK.CFTLib.pRank

/-!
# `pRank` of a subgroup of the units of a number field

For a number field `F` and a prime `p`, the `p`-rank of an arbitrary subgroup `A` of the unit group
`(𝓞 F)ˣ` is bounded by the unit rank of `F` plus `δ_p(F) = 1` if `p` divides the number of roots
of unity of `F`, and `0` otherwise.

The proof uses the exact sequence `0 → A ∩ μ_F → A → A/(A ∩ μ_F) → 0`:

* the kernel `A ∩ μ_F` is a finite subgroup of the roots of unity, hence cyclic, and its `p`-rank is
  at most `δ_p(F)`: it is `0` unless `p ∣ #(A ∩ μ_F)`, and in that case `F` contains a primitive
  `p`-th root of unity (Cauchy's theorem) so that `δ_p(F) = 1`;
* the quotient `A/(A ∩ μ_F)` is torsion free and embeds into `(𝓞 F)ˣ / μ_F`, hence is a free abelian
  group of rank at most `NumberField.Units.rank F`, and its `p`-rank is its rank.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace NK.CFTLib

open NumberField

variable {p : ℕ}

/-! ## Elementary generalities on `pRank` -/

/-- The `p`-rank of a finitely generated `ℤ`-module `G` is at most the `p`-rank of the kernel plus
the `p`-rank of the image of a `ℤ`-linear map `G → Q`. -/
theorem pRank_le_add_ker_range (p : ℕ) [Fact p.Prime] {G Q : Type*} [AddCommGroup G]
    [AddCommGroup Q] [Module.Finite ℤ G] [Module.Finite ℤ Q] (f : G →ₗ[ℤ] Q) :
    pRank p G ≤ pRank p ↥(f.ker) + pRank p ↥(f.range) := by
  haveI : Module.Finite ℤ ↥(f.range) := inferInstance
  set f' : G →ₗ[ℤ] ↥(f.range) := f.codRestrict f.range fun c => LinearMap.mem_range_self f c with hf'
  have hsurj : Function.Surjective f' := by
    rintro ⟨y, hy⟩
    obtain ⟨x, rfl⟩ := LinearMap.mem_range.mp hy
    exact ⟨x, Subtype.ext rfl⟩
  have hker : f'.ker = f.ker := by
    ext x
    simp only [LinearMap.mem_ker, hf']
    constructor
    · intro h
      have h2 := congrArg Subtype.val h
      simpa using h2
    · intro h
      exact Subtype.ext (by simpa using h)
  have h := pRank_le_add_ker (p := p) f' hsurj
  rw [hker] at h
  exact h

/-- A `ℤ`-module generated by a single element has `p`-rank at most `1`. -/
theorem pRank_le_one_of_generator (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M] (g : M)
    (hg : ∀ x : M, ∃ n : ℤ, n • g = x) : pRank p M ≤ 1 := by
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton ℤ M g) := by
    intro x
    obtain ⟨n, hn⟩ := hg x
    exact ⟨n, by rw [LinearMap.toSpanSingleton_apply]; exact hn⟩
  have h1 : pRank p ℤ = 1 := by
    rw [pRank, Module.finrank_tensorProduct (R := ZMod p) (S := ℤ) (M := ZMod p) (M' := ℤ),
      Module.finrank_self, one_mul, Module.finrank_self]
  calc pRank p M ≤ pRank p ℤ := pRank_le_of_surjective (p := p) _ hsurj
    _ = 1 := h1

/-- A finite additive group whose order is not divisible by `p` has `p`-rank `0`. -/
theorem pRank_eq_zero_of_not_dvd_natCard (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M]
    [Finite M] (h : ¬ p ∣ Nat.card M) : pRank p M = 0 := by
  haveI : Fintype M := Fintype.ofFinite M
  have hcop : Nat.Coprime p (Nat.card M) := (Nat.Prime.coprime_iff_not_dvd Fact.out).mpr h
  obtain ⟨a, b, hab⟩ : ∃ a b : ℤ, a * (p : ℤ) + b * (Nat.card M : ℤ) = 1 := by
    refine ⟨Nat.gcdA p (Nat.card M), Nat.gcdB p (Nat.card M), ?_⟩
    have hg := Nat.gcd_eq_gcd_ab p (Nat.card M)
    rw [hcop] at hg
    push_cast at hg
    nlinarith [hg]
  have hp0 : ∀ r : ZMod p, (p : ℤ) • r = 0 := fun r => by
    rw [natCast_zsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hkey : ∀ m : M, (p : ℤ) • (a • m) = m := by
    intro m
    have h1 : (Nat.card M : ℤ) • m = 0 := by
      obtain ⟨k, hk⟩ := addOrderOf_dvd_natCard m
      rw [hk, natCast_zsmul, mul_nsmul, addOrderOf_nsmul_eq_zero, nsmul_zero]
    have h2 : (b * (Nat.card M : ℤ)) • m = 0 := by rw [mul_smul, h1, smul_zero]
    calc (p : ℤ) • (a • m) = ((p : ℤ) * a) • m := (mul_smul _ _ _).symm
      _ = (a * (p : ℤ)) • m := by rw [mul_comm]
      _ = ((a * (p : ℤ)) + b * (Nat.card M : ℤ)) • m := by rw [add_smul, h2, add_zero]
      _ = (1 : ℤ) • m := by rw [hab]
      _ = m := one_smul _ _
  have hzero : ∀ z : TensorProduct ℤ (ZMod p) M, z = 0 := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rfl
    | tmul r m =>
        calc (r : ZMod p) ⊗ₜ[ℤ] m
            = (r : ZMod p) ⊗ₜ[ℤ] ((p : ℤ) • (a • m)) := by rw [hkey m]
          _ = ((p : ℤ) • r) ⊗ₜ[ℤ] (a • m) := by rw [TensorProduct.smul_tmul]
          _ = 0 := by rw [hp0 r, TensorProduct.zero_tmul]
    | add x y hx hy => rw [hx, hy, add_zero]
  haveI : Subsingleton (TensorProduct ℤ (ZMod p) M) :=
    ⟨fun x y => by rw [hzero x, hzero y]⟩
  rw [pRank, Module.finrank_eq_zero_of_subsingleton]

/-! ## Units of a number field -/

/-- Membership in the torsion submodule of the units of a number field, in terms of roots of unity. -/
theorem ofMul_mem_torsion_iff (F : Type) [Field F] (u : (𝓞 F)ˣ) :
    Additive.ofMul u ∈ Submodule.torsion ℤ (Additive (𝓞 F)ˣ) ↔
      u ∈ NumberField.Units.torsion F := by
  rw [← Submodule.mem_toAddSubgroup, Submodule.torsion_int, AddCommGroup.mem_torsion,
    NumberField.Units.torsion, CommGroup.mem_torsion, isOfFinAddOrder_iff_nsmul_eq_zero,
    isOfFinOrder_iff_pow_eq_one]
  constructor
  · rintro ⟨n, hn, h⟩
    exact ⟨n, hn, ofMul_eq_zero.mp (by rw [ofMul_pow]; exact h)⟩
  · rintro ⟨n, hn, h⟩
    exact ⟨n, hn, by rw [← ofMul_pow, ofMul_eq_zero]; exact h⟩

/-- The `p`-rank of a finite subgroup of the roots of unity of a number field is at most
`δ_p(F)`. -/
theorem pRank_subgroup_torsion_le (F : Type) [Field F] [NumberField F] (p : ℕ) [Fact p.Prime]
    (K : Subgroup (𝓞 F)ˣ) (hK : K ≤ NumberField.Units.torsion F) :
    pRank p (Additive ↥K) ≤ _root_.CFTLib.delta F p := by
  haveI hfinK : Finite ↥K := by
    refine Finite.of_injective
      (fun x : ↥K => (⟨(x : (𝓞 F)ˣ), hK x.2⟩ : ↥(NumberField.Units.torsion F))) ?_
    intro a b hab
    exact Subtype.ext (congrArg (fun y : ↥(NumberField.Units.torsion F) => (y : (𝓞 F)ˣ)) hab)
  haveI : IsCyclic ↥K := isCyclic_subgroup_units K
  by_cases hp : p ∣ Nat.card ↥K
  · have hδ : _root_.CFTLib.delta F p = 1 := by
      haveI : Fintype ↥K := Fintype.ofFinite ↥K
      obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card p (by simpa [Nat.card_eq_fintype_card] using hp)
      have hord : orderOf ((x : ↥K) : (𝓞 F)ˣ) = p := by
        rw [Subgroup.orderOf_coe, hx]
      have hprU : IsPrimitiveRoot ((x : ↥K) : (𝓞 F)ˣ) p := by
        refine IsPrimitiveRoot.mk ?_ ?_
        · rw [← hord]; exact pow_orderOf_eq_one _
        · intro l hl; rw [← hord]; exact orderOf_dvd_iff_pow_eq_one.mpr hl
      have hex : ∃ ζ : F, IsPrimitiveRoot ζ p :=
        ⟨algebraMap (𝓞 F) F ((x : ↥K) : (𝓞 F)ˣ), IsPrimitiveRoot.coe_coe_iff.mpr hprU⟩
      rw [_root_.CFTLib.delta]
      simp [hex]
    rw [hδ]
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥K)
    refine pRank_le_one_of_generator p (Additive.ofMul g) ?_
    intro y
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg y.toMul)
    exact ⟨n, by rw [← ofMul_zpow, hn]; rfl⟩
  · rw [pRank_eq_zero_of_not_dvd_natCard p (M := Additive ↥K) ?_]
    · exact Nat.zero_le _
    · rwa [Nat.card_congr (Additive.ofMul : ↥K ≃ Additive ↥K)] at hp

/-- The submodule of `Additive U` carried by a subgroup `K` of a group `U` is additively
equivalent to `Additive ↥K`. -/
noncomputable def addEquivOfSubgroup {U : Type*} [CommGroup U] (K : Subgroup U) :
    ↥(K.toAddSubgroup.toIntSubmodule) ≃+ Additive ↥K where
  toFun x := Additive.ofMul ⟨x.1.toMul, x.2⟩
  invFun y := ⟨Additive.ofMul y.1, y.2⟩
  left_inv x := by ext; rfl
  right_inv y := by ext; rfl
  map_add' x y := by ext; simp [toMul_add]

/-- **The `p`-rank of a subgroup of the units is bounded by the unit rank plus `δ_p(F)`.**

For a number field `F` and a prime `p`, every subgroup `A` of `(𝓞 F)ˣ` has `p`-rank at most
`NumberField.Units.rank F + δ_p(F)`. -/
theorem pRank_units_le (F : Type) [Field F] [NumberField F] (p : ℕ) [Fact p.Prime]
    (A : Subgroup (NumberField.RingOfIntegers F)ˣ) :
    NK.CFTLib.pRank p (Additive ↥A) ≤ NumberField.Units.rank F + _root_.CFTLib.delta F p := by
  classical
  haveI hfinA : Module.Finite ℤ (Additive ↥A) := by
    refine Module.Finite.of_injective ((MonoidHom.toAdditive A.subtype).toIntLinearMap) ?_
    intro x y hxy
    have h1 : ((x.toMul : ↥A) : (𝓞 F)ˣ) = ((y.toMul : ↥A) : (𝓞 F)ˣ) :=
      Additive.ofMul.injective hxy
    exact Additive.toMul.injective (Subtype.ext h1)
  set f : Additive ↥A →ₗ[ℤ] (Additive (𝓞 F)ˣ ⧸ Submodule.torsion ℤ (Additive (𝓞 F)ˣ)) :=
    (Submodule.mkQ (Submodule.torsion ℤ (Additive (𝓞 F)ˣ))).comp
      (MonoidHom.toAdditive A.subtype).toIntLinearMap with hf
  have memKer : ∀ x : Additive ↥A, x ∈ f.ker ↔
      ((x.toMul : ↥A) : (𝓞 F)ˣ) ∈ A ⊓ NumberField.Units.torsion F := by
    intro x
    have hx : ((MonoidHom.toAdditive A.subtype).toIntLinearMap x)
        = Additive.ofMul (((x.toMul : ↥A) : (𝓞 F)ˣ)) := rfl
    rw [hf, LinearMap.mem_ker, LinearMap.comp_apply, hx, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero, ofMul_mem_torsion_iff, Subgroup.mem_inf]
    exact ⟨fun h => ⟨(x.toMul).2, h⟩, fun h => h.2⟩
  set K' : Subgroup ↥A := (A ⊓ NumberField.Units.torsion F).subgroupOf A with hK'
  have hker : f.ker = K'.toAddSubgroup.toIntSubmodule := by
    ext x
    rw [memKer x, hK']
    show ((x.toMul : ↥A) : (𝓞 F)ˣ) ∈ A ⊓ NumberField.Units.torsion F ↔
      (x.toMul : ↥A) ∈ (A ⊓ NumberField.Units.torsion F).subgroupOf A
    rw [Subgroup.mem_subgroupOf]
  have step1 : pRank p (Additive ↥A) ≤ pRank p ↥f.ker + pRank p ↥f.range :=
    pRank_le_add_ker_range p f
  have step3 : pRank p ↥f.ker ≤ _root_.CFTLib.delta F p := by
    rw [hker]
    calc pRank p ↥(K'.toAddSubgroup.toIntSubmodule)
        = pRank p (Additive ↥K') := pRank_congr (p := p) (addEquivOfSubgroup K')
      _ = pRank p (Additive ↥(A ⊓ NumberField.Units.torsion F)) :=
          pRank_congr (p := p) (Subgroup.subgroupOfEquivOfLe inf_le_left).toAdditive
      _ ≤ _root_.CFTLib.delta F p := pRank_subgroup_torsion_le F p _ inf_le_right
  have step2 : pRank p ↥f.range ≤ NumberField.Units.rank F := by
    haveI : Module.Finite ℤ ↥f.range := inferInstance
    haveI : Module.IsTorsionFree ℤ
        (Additive (𝓞 F)ˣ ⧸ Submodule.torsion ℤ (Additive (𝓞 F)ˣ)) := inferInstance
    haveI : Module.IsTorsionFree ℤ ↥f.range :=
      Function.Injective.moduleIsTorsionFree (f := (Subtype.val : ↥f.range → _))
        Subtype.val_injective (fun r m => rfl)
    haveI : Module.Free ℤ ↥f.range := Module.free_of_finite_type_torsion_free' (R := ℤ)
    calc pRank p ↥f.range = Module.finrank ℤ ↥f.range := by
          rw [pRank, Module.finrank_tensorProduct (R := ZMod p) (S := ℤ) (M := ZMod p)
            (M' := ↥f.range), Module.finrank_self, one_mul]
      _ ≤ Module.finrank ℤ (Additive (𝓞 F)ˣ ⧸ Submodule.torsion ℤ (Additive (𝓞 F)ˣ)) :=
          Submodule.finrank_le f.range
      _ = NumberField.Units.rank F := by
          rw [finrank_quotient_eq_of_le_torsion (M' := Submodule.torsion ℤ (Additive (𝓞 F)ˣ))
            le_rfl, NumberField.Units.finrank_eq]
  linarith [step1, step2, step3]

end NK.CFTLib
