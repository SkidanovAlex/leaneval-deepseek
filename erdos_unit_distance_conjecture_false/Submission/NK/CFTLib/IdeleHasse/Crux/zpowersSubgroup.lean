import Mathlib

/-!
# Subgroups of a finite cyclic group are generated by a power of a generator

A finite cyclic group `G` generated by `g` has exactly the subgroups `⟨g ^ m⟩`, and for the
subgroup generated by `g ^ m` the arithmetic relation `m * |⟨g ^ m⟩| = |G|` holds.  This normalisation
is exactly the hypothesis needed to compare the cyclic periodicity maps of `G` and of a subgroup
(`NK.CFTLib.PrimeSqArl.ResNatTransPiEven`).
-/

set_option autoImplicit false

namespace NK.CFTLib.IdeleHasse.Crux

/-- **A subgroup of a finite cyclic group is generated by a power of a generator, with the
arithmetic normalisation.**  For a finite cyclic group `G` generated by `g` and any subgroup `H`,
there is `m : ℕ` with `H = ⟨g ^ m⟩` and `m * |H| = |G|` (namely `m = H.index`). -/
theorem exists_zpowers_pow_eq_of_isCyclic {G : Type*} [Group G] [Fintype G] [IsCyclic G]
    (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (H : Subgroup G) :
    ∃ m : ℕ, H = Subgroup.zpowers (g ^ m) ∧ m * Nat.card ↥H = Nat.card G := by
  classical
  refine ⟨H.index, ?_, Subgroup.index_mul_card H⟩
  have hmem : g ^ H.index ∈ H := by
    have h1 : (QuotientGroup.mk' H g) ^ H.index = 1 := by
      rw [Subgroup.index_eq_card]
      exact pow_card_eq_one'
    rw [← map_pow, QuotientGroup.mk'_apply] at h1
    rw [QuotientGroup.eq_one_iff] at h1
    exact h1
  symm
  apply Subgroup.eq_of_le_of_card_ge
  · rw [Subgroup.zpowers_le]; exact hmem
  · rw [Nat.card_zpowers, orderOf_pow, orderOf_eq_card_of_forall_mem_zpowers hg,
      Nat.gcd_eq_right (Subgroup.index_dvd_card H)]
    rw [← Subgroup.index_mul_card H]
    exact Nat.le_of_eq (Nat.mul_div_right (Nat.card ↥H)
      (Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite))).symm

end NK.CFTLib.IdeleHasse.Crux
