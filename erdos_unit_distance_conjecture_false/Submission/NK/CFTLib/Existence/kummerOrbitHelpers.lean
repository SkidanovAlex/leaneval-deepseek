import Mathlib

/-!
# Helper lemmas for the Kummer count of `index_normClassSubgroup_galoisClosure_le`

Elementary Kummer-theoretic facts used to bound the abelianisation of `Gal(N/K)` for
`N = galoisClosure K M` with `M / K'` Galois of prime degree `p` over a field `K'` containing a
primitive `p`-th root of unity.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace NK.CFTLib.Existence

open IntermediateField

/-! ## Elementary Kummer-theoretic helper lemmas -/

/-- Every `p`-th root of unity of a field `K` lies in the image of any subfield `k` containing a
primitive `p`-th root of unity. -/
theorem pow_eq_one_mem_range
    {k K : Type*} [Field k] [Field K] [Algebra k K]
    {p : ℕ} [Fact p.Prime] {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    {x : K} (hx : x ^ p = 1) :
    ∃ c : k, x = algebraMap k K c := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have hζ' : IsPrimitiveRoot (algebraMap k K ζ) p :=
    hζ.map_of_injective (f := (algebraMap k K : k →* K)) (algebraMap k K).injective
  obtain ⟨i, _, hi⟩ := hζ'.eq_pow_of_pow_eq_one hx
  exact ⟨ζ ^ i, by rw [map_pow, hi]⟩

/-- If a field extension `K / k` is generated by `p`-th roots of elements of `k`, and `k` contains a
primitive `p`-th root of unity, then `Gal(K/k)` is commutative.

Indeed an automorphism `g` sends such a generator `s` to `χ_g s` with `χ_g` a `p`-th root of unity,
hence an element of `k`, which every automorphism fixes. -/
theorem isMulCommutative_of_kummer_generators
    {k K : Type*} [Field k] [Field K] [Algebra k K]
    (p : ℕ) [Fact p.Prime] {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (S : Set K) (hpow : ∀ s ∈ S, ∃ a : k, s ^ p = algebraMap k K a)
    (hgen : IntermediateField.adjoin k S = ⊤) :
    IsMulCommutative (K ≃ₐ[k] K) := by
  refine IsMulCommutative.of_comm fun g h => ?_
  refine AlgEquiv.ext fun x => ?_
  have hx : x ∈ IntermediateField.adjoin k S := hgen ▸ IntermediateField.mem_top
  refine IntermediateField.adjoin_induction k (p := fun y _ => g (h y) = h (g y))
    ?_ ?_ ?_ ?_ ?_ hx
  · intro s hs
    rcases eq_or_ne s 0 with rfl | hs0
    · simp
    · have key : ∀ (f : K ≃ₐ[k] K), ∃ c : k, f s = algebraMap k K c * s := by
        intro f
        obtain ⟨a, ha⟩ := hpow s hs
        have hane : algebraMap k K a ≠ 0 := by rw [← ha]; exact pow_ne_zero p hs0
        have h1 : (f s / s) ^ p = 1 := by
          rw [div_pow, ← map_pow, ha, f.commutes a, div_self hane]
        obtain ⟨c, hc⟩ := pow_eq_one_mem_range hζ h1
        exact ⟨c, by rw [← hc, div_mul_cancel₀ _ hs0]⟩
      obtain ⟨c, hc⟩ := key g
      obtain ⟨c', hc'⟩ := key h
      rw [hc', hc, map_mul, map_mul, g.commutes, h.commutes, hc, hc']
      ring
  · intro a
    rw [h.commutes a, g.commutes a, h.commutes a]
  · intro y z _ _ hy hz
    rw [map_add, map_add, map_add, map_add, hy, hz]
  · intro y _ hy
    rw [map_inv₀, map_inv₀, map_inv₀, map_inv₀, hy]
  · intro y z _ _ hy hz
    rw [map_mul, map_mul, map_mul, map_mul, hy, hz]

/-- **Kummer's theorem, generator form.**  A Galois extension `L / k` of prime degree `p` over a
field `k` containing a primitive `p`-th root of unity is generated by a `p`-th root of an element
of `k`. -/
theorem exists_kummer_root_of_finrank_prime
    {k L : Type*} [Field k] [Field L] [Algebra k L] [FiniteDimensional k L]
    (p : ℕ) [Fact p.Prime] {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (hgal : IsGalois k L) (hdeg : Module.finrank k L = p) :
    ∃ (a : kˣ) (β : L), β ^ p = algebraMap k L (a : k) ∧
      IntermediateField.adjoin k ({β} : Set L) = ⊤ := by
  have hp : p.Prime := Fact.out
  haveI := hgal
  haveI : IsCyclic (L ≃ₐ[k] L) :=
    isCyclic_of_prime_card (by rw [IsGalois.card_aut_eq_finrank, hdeg])
  have hprim : (primitiveRoots (Module.finrank k L) k).Nonempty := by
    rw [hdeg]; exact ⟨ζ, (mem_primitiveRoots hp.pos).mpr hζ⟩
  obtain ⟨α, ha, hgen⟩ := exists_root_adjoin_eq_top_of_isCyclic (K := k) (L := L) hprim
  rw [hdeg] at ha
  obtain ⟨a, ha'⟩ := ha
  have hane : a ≠ 0 := by
    intro h0
    have hα0 : α = 0 := by
      have h1 : α ^ p = algebraMap k L a := ha'.symm
      rw [h0, map_zero] at h1
      exact (pow_eq_zero_iff hp.ne_zero).mp h1
    have htop : (⊤ : IntermediateField k L) = ⊥ := by
      rw [← hgen, hα0, IntermediateField.adjoin_zero]
    have h1 : Module.finrank k L = 1 :=
      IntermediateField.bot_eq_top_iff_finrank_eq_one.mp htop.symm
    rw [hdeg] at h1
    exact hp.ne_one h1
  exact ⟨Units.mk0 a hane, α, by simpa using ha'.symm, hgen⟩

/-- A finite cyclic group has a generator whose powers with *natural* exponents exhaust the group. -/
theorem exists_generator_pow_eq_of_isCyclic
    {G : Type*} [Group G] [Finite G] [IsCyclic G] :
    ∃ σ : G, ∀ τ : G, ∃ n : ℕ, τ = σ ^ n := by
  classical
  obtain ⟨σ, hσ⟩ := IsCyclic.exists_generator (α := G)
  refine ⟨σ, fun τ => ?_⟩
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hσ τ)
  have h1 : σ ^ (orderOf σ : ℤ) = 1 := by
    rw [zpow_natCast, pow_orderOf_eq_one]
  have h2 := zpow_eq_zpow_emod (x := σ) m h1
  have hpos : (0 : ℤ) < (orderOf σ : ℤ) := by
    exact_mod_cast orderOf_pos σ
  refine ⟨(m % (orderOf σ : ℤ)).toNat, ?_⟩
  rw [← hm, h2, ← zpow_natCast σ ((m % (orderOf σ : ℤ)).toNat),
    Int.toNat_of_nonneg (Int.emod_nonneg m hpos.ne')]

/-- A `K`-algebra homomorphism from a finite Galois extension `k / K` into any `K`-algebra `Ω`
factors through `Gal(k/K)`. -/
theorem exists_algEquiv_comp_algebraMap_of_normal
    {K k Ω : Type*} [Field K] [Field k] [Field Ω]
    [Algebra K k] [Algebra k Ω] [Algebra K Ω] [IsScalarTower K k Ω] [Normal K k]
    (φ : k →ₐ[K] Ω) :
    ∃ τ : k ≃ₐ[K] k, ∀ x : k, φ x = algebraMap k Ω (τ x) := by
  have hbij : Function.Bijective (AlgHom.restrictNormal φ k) :=
    AlgHom.normal_bijective K k k (AlgHom.restrictNormal φ k)
  refine ⟨AlgEquiv.ofBijective _ hbij, fun x => ?_⟩
  rw [AlgEquiv.coe_ofBijective]
  have h := AlgHom.restrictNormal_commutes φ k x
  rw [Algebra.algebraMap_self_apply] at h
  exact h.symm


/-- For a K-algebra automorphism `σ₀` of a normal extension `Ω ⊇ K'` of `K`, the restriction of `σ₀`
to `K'` is a power of any generator `σ` of `Gal(K'/K)`. -/
theorem exists_pow_restrict_of_algEquiv
    {K k Ω : Type*} [Field K] [Field k] [Field Ω]
    [Algebra K k] [Algebra k Ω] [Algebra K Ω] [IsScalarTower K k Ω] [Normal K k]
    (σ : k ≃ₐ[K] k) (hσ : ∀ τ : k ≃ₐ[K] k, ∃ n : ℕ, τ = σ ^ n)
    (σ₀ : Ω ≃ₐ[K] Ω) :
    ∃ j : ℕ, ∀ c : k, σ₀ (algebraMap k Ω c) = algebraMap k Ω ((σ ^ j) c) := by
  obtain ⟨τ, hτ⟩ := exists_algEquiv_comp_algebraMap_of_normal (K := K) (k := k) (Ω := Ω)
    ((σ₀ : Ω →ₐ[K] Ω).comp (IsScalarTower.toAlgHom K k Ω))
  have hτ' : ∀ x : k, σ₀ (algebraMap k Ω x) = algebraMap k Ω (τ x) := by
    intro x
    have h := hτ x
    simpa using h
  obtain ⟨j, hj⟩ := hσ τ
  refine ⟨j, fun c => ?_⟩
  have h := hτ' c
  rw [hj] at h
  exact h

end NK.CFTLib.Existence
