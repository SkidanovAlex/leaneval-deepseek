import Mathlib
import Submission.NK.LocalReciprocityLubinTate.LubinTate.exists_ltSymbol_ker_eq
import Submission.NK.LocalReciprocityLubinTate.Eval.smulDiv_compat
import Submission.NK.LocalReciprocityLubinTate.LubinTate.ext_of_eqOn_LTdivisionSet
import Submission.NK.LocalReciprocityLubinTate.LubinTate.LTLevel_commutative
import Submission.NK.LocalReciprocityLubinTate.LubinTate.nonempty_lubinTateModule
import Submission.NK.LocalReciprocityLubinTate.LubinTate.exists_ltLevel_action
import Submission.NK.LocalReciprocityLubinTate.LubinTate.comap_unitPartHom_principalUnits

namespace NK.LocalReciprocityLubinTate.LubinTate

universe u

open scoped ValuativeRel

/-! ### The Lubin–Tate symbol as a compatible family over all levels

`NK.LocalReciprocityLubinTate.LubinTate.exists_ltLevel_action` provides, for every `n ≥ 1`, a
surjective homomorphism `Ψ_n : 𝒪[F]ˣ →* Gal(K_n/F)` with kernel `U^n = 1 + 𝔪[F]^n` which acts on
*every* division point `z ∈ Λ_n` by the Lubin–Tate action `[u]` (`Eval.smulDiv`).

Composing with the unit-part splitting `Fˣ →* 𝒪[F]ˣ` of
`NK.LocalReciprocityLubinTate.LubinTate.unitPartHom` (whose kernel is `⟨πu⟩`) gives level
homomorphisms

`Φ n : Fˣ →* Gal(K_n/F)`

with kernel `⟨πu⟩ ⊔ U^n`.  This file proves that the levels are *compatible*:
for `n ≤ n'` the automorphism `Φ n' x` restricts to the subfield `K_n ⊆ K_{n'}` as `Φ n x`.

The compatibility is the point: on the generating set `Λ_n` of `K_n` both automorphisms act by the
same `𝒪[F]`-action `[unitPartHom x]`, and the Lubin–Tate action is independent of the level at
which it is computed (`Eval.smulDiv_compat`).  Since `K_n = F(Λ_n)` is generated by `Λ_n`, the two
`F`-algebra homomorphisms agree everywhere.

The level `n = 0` is exceptional: `K_0 = F` and `Λ_0 = {0}`, so the level-`0` symbol is the trivial
homomorphism; the compatibility at `n = 0` follows from the fact that an `F`-algebra automorphism
fixes `F` pointwise. -/

/-- `K_0 = F`: the `0`-th Lubin–Tate level, generated by the single division point `0`, is `⊥`. -/
lemma ltLevel_zero_le_bot {F : Type u} [Field F] (π : F) (q : ℕ) :
    LTLevel F π q 0 ≤ (⊥ : IntermediateField F (AlgebraicClosure F)) := by
  rw [LTLevel, LTdivisionSet_zero]
  refine IntermediateField.adjoin_le_iff.mpr ?_
  intro z hz
  rw [Set.mem_singleton_iff] at hz
  subst hz
  simp

/-- `Gal(K_0/F) = 1`: an `F`-algebra automorphism of `K_0 = ⊥ = F` is the identity. -/
lemma subsingleton_aut_ltLevel_zero {F : Type u} [Field F] (π : F) (q : ℕ) :
    Subsingleton (↥(LTLevel F π q 0) ≃ₐ[F] ↥(LTLevel F π q 0)) := by
  refine ⟨fun σ τ => AlgEquiv.ext fun x => ?_⟩
  obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp (ltLevel_zero_le_bot π q x.2)
  have hx : x = algebraMap F ↥(LTLevel F π q 0) a := Subtype.ext ha.symm
  rw [hx, AlgEquiv.commutes σ a, AlgEquiv.commutes τ a]

set_option maxHeartbeats 4000000
set_option linter.style.haveILetI false

theorem exists_ltSymbol_family {F : Type u} [Field F] [CharZero F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (P : ↥(ValuativeRel.valuation F).integer) (hP : Irreducible P) (πu : Fˣ)
    (hπu : (πu : F) = (P : F))
    (M : NK.LocalReciprocityLubinTate.LubinTateModule ↥(ValuativeRel.valuation F).integer P
      (NK.LocalReciprocityLubinTate.residueCard F))
    (hpi : M.toLaw.piEndo = NK.LocalReciprocityLubinTate.piXAddXq P
      (NK.LocalReciprocityLubinTate.residueCard F)) :
    ∃ (Φ : ∀ n : ℕ, Fˣ →* (↥(NK.LocalReciprocityLubinTate.LTLevel F (P : F)
            (NK.LocalReciprocityLubinTate.residueCard F) n) ≃ₐ[F]
          ↥(NK.LocalReciprocityLubinTate.LTLevel F (P : F)
            (NK.LocalReciprocityLubinTate.residueCard F) n)))
      (hmono : ∀ {n n' : ℕ}, n ≤ n' → NK.LocalReciprocityLubinTate.LTLevel F (P : F)
          (NK.LocalReciprocityLubinTate.residueCard F) n
        ≤ NK.LocalReciprocityLubinTate.LTLevel F (P : F)
          (NK.LocalReciprocityLubinTate.residueCard F) n'),
      (∀ n : ℕ, Function.Surjective (Φ n)) ∧
      (∀ n : ℕ, MonoidHom.ker (Φ n)
        = Subgroup.zpowers πu ⊔ NK.LocalReciprocityLubinTate.higherUnits F n) ∧
      (∀ (n n' : ℕ) (h : n ≤ n') (x : Fˣ)
        (y : ↥(NK.LocalReciprocityLubinTate.LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n)),
        ((Φ n' x) ⟨y.1, hmono h y.2⟩ : ↥(NK.LocalReciprocityLubinTate.LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n')) =
          ⟨((Φ n x) y).1, hmono h ((Φ n x) y).2⟩) := by
  classical
  have hq : 2 ≤ NK.LocalReciprocityLubinTate.residueCard F :=
    NK.LocalReciprocityLubinTate.two_le_residueCard F
  have hπ : NK.LocalReciprocityLubinTate.IsUniformizer F (πu : F) := by
    rw [hπu]
    exact isUniformizer_of_irreducible (F := F) P hP
  let L : ℕ → IntermediateField F (AlgebraicClosure F) :=
    fun n => NK.LocalReciprocityLubinTate.LTLevel F (P : F)
      (NK.LocalReciprocityLubinTate.residueCard F) n
  -- the level inclusions
  have hmono : ∀ {n n' : ℕ}, n ≤ n' → L n ≤ L n' := by
    intro n n' hn
    refine IntermediateField.adjoin_le_iff.mpr (fun z hz => ?_)
    exact IntermediateField.subset_adjoin F _
      (LTdivisionSet_mono F (P : F)
        (NK.LocalReciprocityLubinTate.residueCard F) hq hn hz)
  -- the level symbols
  have hex : ∀ n : ℕ, 1 ≤ n → ∃ Ψ : (↥(ValuativeRel.valuation F).integer)ˣ →*
        (↥(L n) ≃ₐ[F] ↥(L n)),
      (∀ (u : (↥(ValuativeRel.valuation F).integer)ˣ) (z : AlgebraicClosure F)
          (hz : z ∈ LTdivisionSet F (P : F) (NK.LocalReciprocityLubinTate.residueCard F) n),
          ((Ψ u) ⟨z, LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n hz⟩ : AlgebraicClosure F)
            = NK.LocalReciprocityLubinTate.Eval.smulDiv P hP
              (NK.LocalReciprocityLubinTate.residueCard F) n hq M hz
              (u : ↥(ValuativeRel.valuation F).integer)) ∧
      Function.Surjective Ψ ∧
      MonoidHom.ker Ψ = NK.LocalReciprocityLubinTate.principalUnits F n :=
    fun n hn => exists_ltLevel_action P hP n hn M hpi
  let Ψ : (n : ℕ) → (↥(ValuativeRel.valuation F).integer)ˣ →* (↥(L n) ≃ₐ[F] ↥(L n)) :=
    fun n => if hn : 1 ≤ n then Classical.choose (hex n hn) else 1
  let Φ : ∀ n : ℕ, Fˣ →* (↥(L n) ≃ₐ[F] ↥(L n)) :=
    fun n => (Ψ n).comp (unitPartHom (F := F) πu hπ)
  -- the characterisation of the level symbols on the division points
  have hchar : ∀ (m : ℕ) (hm : 1 ≤ m) (u : (↥(ValuativeRel.valuation F).integer)ˣ)
      (z : AlgebraicClosure F)
      (hz : z ∈ LTdivisionSet F (P : F) (NK.LocalReciprocityLubinTate.residueCard F) m),
      ((Ψ m u) ⟨z, LTdivisionSet_subset_LTLevel F (P : F)
          (NK.LocalReciprocityLubinTate.residueCard F) m hz⟩ : AlgebraicClosure F)
        = NK.LocalReciprocityLubinTate.Eval.smulDiv P hP
          (NK.LocalReciprocityLubinTate.residueCard F) m hq M hz
          (u : ↥(ValuativeRel.valuation F).integer) := by
    intro m hm u z hz
    rw [show Ψ m = Classical.choose (hex m hm) from dif_pos hm]
    exact (Classical.choose_spec (hex m hm)).1 u z hz
  refine ⟨Φ, hmono, ?_, ?_, ?_⟩
  · -- surjectivity
    intro n
    by_cases hn : 1 ≤ n
    · have hΨ : Function.Surjective (Ψ n) := by
        rw [show Ψ n = Classical.choose (hex n hn) from dif_pos hn]
        exact (Classical.choose_spec (hex n hn)).2.1
      exact hΨ.comp (unitPartHom_surjective (F := F) πu hπ)
    · have hn0 : n = 0 := by omega
      subst hn0
      haveI := subsingleton_aut_ltLevel_zero (F := F) (P : F)
        (NK.LocalReciprocityLubinTate.residueCard F)
      intro σ
      exact ⟨1, Subsingleton.elim _ _⟩
  · -- the kernels
    intro n
    by_cases hn : 1 ≤ n
    · have hΨ : (Ψ n).ker = NK.LocalReciprocityLubinTate.principalUnits F n := by
        rw [show Ψ n = Classical.choose (hex n hn) from dif_pos hn]
        exact (Classical.choose_spec (hex n hn)).2.2
      show ((Ψ n).comp (unitPartHom (F := F) πu hπ)).ker = _
      rw [← MonoidHom.comap_ker, hΨ, comap_unitPartHom_principalUnits (F := F) πu hπ n]
    · have hn0 : n = 0 := by omega
      subst hn0
      have h0 := comap_unitPartHom_principalUnits (F := F) πu hπ 0
      rw [NK.LocalReciprocityLubinTate.principalUnits_zero, Subgroup.comap_top] at h0
      show ((Ψ 0).comp (unitPartHom (F := F) πu hπ)).ker = _
      rw [← h0, Subgroup.eq_top_iff']
      intro x
      rw [MonoidHom.mem_ker]
      show Ψ 0 (unitPartHom (F := F) πu hπ x) = 1
      rw [show Ψ 0 = 1 from dif_neg (by omega : ¬ (1 ≤ 0))]
      rfl
  · -- compatibility of the levels
    intro n n' h x y
    have hkey : ∀ (z : AlgebraicClosure F)
        (hz : z ∈ LTdivisionSet F (P : F) (NK.LocalReciprocityLubinTate.residueCard F) n),
        ((Φ n' x) ⟨z, hmono h (LTdivisionSet_subset_LTLevel F (P : F)
            (NK.LocalReciprocityLubinTate.residueCard F) n hz)⟩ : ↥(L n')).1
          = ((Φ n x) ⟨z, LTdivisionSet_subset_LTLevel F (P : F)
            (NK.LocalReciprocityLubinTate.residueCard F) n hz⟩ : ↥(L n)).1 := by
      intro z hz
      by_cases hn : 1 ≤ n
      · have hn' : 1 ≤ n' := le_trans hn h
        have hz' : z ∈ LTdivisionSet F (P : F)
            (NK.LocalReciprocityLubinTate.residueCard F) n' :=
          LTdivisionSet_mono F (P : F)
            (NK.LocalReciprocityLubinTate.residueCard F) hq h hz
        have he1 : ((Ψ n' (unitPartHom (F := F) πu hπ x))
            ⟨z, hmono h (LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n hz)⟩ : ↥(L n')).1
            = NK.LocalReciprocityLubinTate.Eval.smulDiv P hP
              (NK.LocalReciprocityLubinTate.residueCard F) n' hq M hz'
              (unitPartHom (F := F) πu hπ x :
                ↥(ValuativeRel.valuation F).integer) := by
          rw [show (⟨z, hmono h (LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n hz)⟩ : ↥(L n'))
            = ⟨z, LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n' hz'⟩ from Subtype.ext rfl]
          exact hchar n' hn' _ z hz'
        have he2 : ((Ψ n (unitPartHom (F := F) πu hπ x))
            ⟨z, LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n hz⟩ : ↥(L n)).1
            = NK.LocalReciprocityLubinTate.Eval.smulDiv P hP
              (NK.LocalReciprocityLubinTate.residueCard F) n hq M hz
              (unitPartHom (F := F) πu hπ x :
                ↥(ValuativeRel.valuation F).integer) :=
          hchar n hn _ z hz
        show ((Ψ n' (unitPartHom (F := F) πu hπ x))
            ⟨z, hmono h (LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n hz)⟩ : ↥(L n')).1
          = ((Ψ n (unitPartHom (F := F) πu hπ x))
            ⟨z, LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n hz⟩ : ↥(L n)).1
        rw [he1, he2]
        exact NK.LocalReciprocityLubinTate.Eval.smulDiv_compat (N := n') (m := n) (x := z)
          P hP (NK.LocalReciprocityLubinTate.residueCard F) hq M h hz' hz
          (unitPartHom (F := F) πu hπ x :
            ↥(ValuativeRel.valuation F).integer)
      · -- the level `0`: only the division point `0` occurs, and automorphisms fix `0`
        have hn0 : n = 0 := by omega
        have hz0 : z = 0 := by
          rw [hn0] at hz
          rw [LTdivisionSet_zero] at hz
          simpa using hz
        subst hz0
        show ((Ψ n' (unitPartHom (F := F) πu hπ x))
            ⟨(0 : AlgebraicClosure F), hmono h (LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n ‹(0 : AlgebraicClosure F) ∈ _›)⟩ :
              ↥(L n')).1
          = ((Ψ n (unitPartHom (F := F) πu hπ x))
            ⟨(0 : AlgebraicClosure F), LTdivisionSet_subset_LTLevel F (P : F)
              (NK.LocalReciprocityLubinTate.residueCard F) n ‹(0 : AlgebraicClosure F) ∈ _›⟩ :
              ↥(L n)).1
        rw [show (⟨(0 : AlgebraicClosure F), _⟩ : ↥(L n')) = 0 from Subtype.ext rfl,
            show (⟨(0 : AlgebraicClosure F), _⟩ : ↥(L n)) = 0 from Subtype.ext rfl]
        simp
    -- two `F`-algebra homomorphisms `K_n → F̄` agreeing on the generating set `Λ_n` are equal
    have hhom : (IntermediateField.val (L n')).comp
          ((Φ n' x).toAlgHom.comp (IntermediateField.inclusion (hmono h)))
        = (IntermediateField.val (L n)).comp (Φ n x).toAlgHom := by
      refine IntermediateField.adjoin_algHom_ext (F := F)
        (s := LTdivisionSet F (P : F) (NK.LocalReciprocityLubinTate.residueCard F) n)
        (fun z hz => ?_)
      exact hkey z hz
    have hcongr := DFunLike.congr_fun hhom y
    simp only [AlgHom.comp_apply, IntermediateField.coe_val] at hcongr
    rw [show ((IntermediateField.inclusion (hmono h)) y : ↥(L n')) = ⟨y.1, hmono h y.2⟩
      from Subtype.ext rfl] at hcongr
    exact Subtype.ext hcongr

end NK.LocalReciprocityLubinTate.LubinTate
