import Mathlib
import Submission.NK.NeukirchUchida.LocalGaloisCompletion
import Submission.NK.NeukirchUchida.LocalGaloisDecompositionAux
import Submission.NK.NeukirchUchida.exists_mem_subfieldClosure_of_eval_eq_zero
import Submission.NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers
import Submission.Commons.RingTheory.Henselian.adicCompletionIntegers_henselianLocalRing

/-!
# The decomposition group of a place is the automorphism group of the adjoined field

Let `K` be a number field, `p` a finite place of `K`, `K'` a separable closure of `K`, `A` a place
of `K'` above `p` and `C = placeCompletion A` the completion of `K'` at `A`.  Write
`M = K_p · K' ⊆ C` for the subfield generated by the image of the `p`-adic completion `K_p` of `K`
and the image of `K'`.

The decomposition group `D_A ≤ Gal(K'/K)` of the place `A` is isomorphic to the group of
`K_p`-algebra automorphisms of `M`:

`D_A ≃* (M ≃ₐ[K_p] M)`.

## Proof

* An element `σ ∈ D_A` preserves the valuation of `A`, hence extends continuously to a ring
  automorphism `σ̂` of `C` (`Submission.NeukirchUchida.Local.completionRingEquiv`).  This
  automorphism fixes the image of `K_p` and preserves `M`, so it restricts to a `K_p`-algebra
  automorphism `f σ` of `M`; the assignment `σ ↦ f σ` is a group homomorphism.
* Conversely, let `τ` be a `K_p`-algebra automorphism of `M`.  As `K_p` is complete, its valuation
  ring is Henselian, so the valuation ring `O_C ∩ M` of `M` has a *unique* extension to the
  algebraic extension `M/K_p` (`Commons.RingTheory.Valuation.eq_of_comap_eq_of_isAlgebraic`);
  since `τ` fixes `K_p`, it therefore preserves `O_C ∩ M`.
  The image of `K'` inside `M` is exactly the set of elements algebraic over `K`, and `τ` fixes
  `K`, so `τ` maps this image onto itself and induces a `K`-algebra automorphism `σ_τ = g τ` of
  `K'`.  The preservation of `O_C ∩ M` shows that `σ_τ` preserves the valuation ring `A`, i.e.
  `g τ ∈ D_A`.
* The two constructions are mutually inverse: they agree on the image of `K'` (which generates
  `M` together with `K_p`), and this generation is the content of the `adjoin_induction` argument
  in `algEquiv_ext_adjoin`.

## Main results

* `NK.NeukirchUchida.adjoinPlaceCompletion` : the field `M = K_p · K'`;
* `NK.NeukirchUchida.decompositionToAdjoin` : `σ ↦ σ̂|_M`;
* `NK.NeukirchUchida.exists_mem_decompositionGroupOf_of_algEquiv_adjoin` : `τ ↦ σ_τ`;
* `NK.NeukirchUchida.nonempty_mulEquiv_decompositionGroupOf_adjoin` : the group isomorphism.
-/

open scoped Pointwise Valued

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace NK.NeukirchUchida

noncomputable section

variable {K : Type*} [Field K] [NumberField K]
variable {K' : Type*} [Field K'] [Algebra K K'] [IsSepClosure K K']

/-! ## The subfield of the completion generated by the two fields -/

/-- The subfield of the completion of `K'` at `A` generated by the image of the `p`-adic completion
of `K` and the image of `K'`. -/
abbrev adjoinPlaceCompletion (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)] :
    IntermediateField (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (placeCompletion A) :=
  IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
    (Set.range (placeCompletionCoe A))

theorem mem_adjoinPlaceCompletion
    {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)}
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)] (y : K') :
    placeCompletionCoe A y ∈ adjoinPlaceCompletion (K := K) (K' := K') p A :=
  IntermediateField.subset_adjoin _ _ ⟨y, rfl⟩

/-- The image of `y : K'` as an element of the adjoining field `M = K_p · K'`. -/
abbrev coInAdjoin (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)]
    (y : K') : adjoinPlaceCompletion (K := K) (K' := K') p A :=
  ⟨placeCompletionCoe A y, mem_adjoinPlaceCompletion A y⟩

theorem coe_coInAdjoin (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)]
    (y : K') :
    ((coInAdjoin (K := K) (K' := K') p A y : adjoinPlaceCompletion (K := K) (K' := K') p A) :
      placeCompletion A) = placeCompletionCoe A y := rfl

theorem coInAdjoin_add (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)]
    (a b : K') :
    coInAdjoin (K := K) (K' := K') p A (a + b) =
      coInAdjoin (K := K) (K' := K') p A a + coInAdjoin (K := K) (K' := K') p A b := by
  refine Subtype.ext ?_
  simp only [coe_coInAdjoin, IntermediateField.coe_add, map_add]

theorem coInAdjoin_mul (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)]
    (a b : K') :
    coInAdjoin (K := K) (K' := K') p A (a * b) =
      coInAdjoin (K := K) (K' := K') p A a * coInAdjoin (K := K) (K' := K') p A b := by
  refine Subtype.ext ?_
  simp only [coe_coInAdjoin, IntermediateField.coe_mul, map_mul]

theorem coInAdjoin_one (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)] :
    coInAdjoin (K := K) (K' := K') p A 1 = 1 := by
  refine Subtype.ext ?_
  simp only [coe_coInAdjoin, IntermediateField.coe_one, map_one]

theorem coInAdjoin_zero (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)] :
    coInAdjoin (K := K) (K' := K') p A 0 = 0 := by
  refine Subtype.ext ?_
  simp only [coe_coInAdjoin, IntermediateField.coe_zero, map_zero]


section AdjoinAlgebra

variable (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable (A : ValuationSubring K')
variable (hA : A.comap (algebraMap K K') =
  IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
variable [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)]
variable (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
  algebraMap _ _ z = adicCompletionToPlaceCompletion p A hA z)

include hA halg

/-! ## Elementary facts about `y ↦ y` as an element of the adjoined field -/

/-- Every element of `M = K_p · K'` is algebraic over the `p`-adic completion `K_p`. -/
theorem isAlgebraic_of_mem_adjoinPlaceCompletion
    {x : placeCompletion A} (hx : x ∈ adjoinPlaceCompletion (K := K) (K' := K') p A) :
    IsAlgebraic (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) x := by
  have hΦ : (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)) =
      adicCompletionToPlaceCompletion p A hA := RingHom.ext halg
  refine IntermediateField.adjoin_induction (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
    (s := Set.range (placeCompletionCoe A))
    (p := fun z _ => IsAlgebraic (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) z)
    ?_ ?_ ?_ ?_ ?_ hx
  · rintro z ⟨y, rfl⟩
    obtain ⟨q, hq0, hq⟩ := (Algebra.IsSeparable.isAlgebraic K K').isAlgebraic y
    refine ⟨q.map (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)),
      Polynomial.map_ne_zero hq0, ?_⟩
    rw [Polynomial.aeval_def, hΦ, Polynomial.eval₂_map,
      show (adicCompletionToPlaceCompletion p A hA).comp
          (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)) =
          (placeCompletionCoe A).comp (algebraMap K K') from
        RingHom.ext fun c => by
          rw [RingHom.comp_apply, RingHom.comp_apply,
            adicCompletionToPlaceCompletion_algebraMap p A hA c, placeCompletionCoe_apply],
      Polynomial.eval₂_eq_eval_map, ← Polynomial.map_map, Polynomial.eval_map,
      Polynomial.eval₂_hom, Polynomial.eval_map, ← Polynomial.aeval_def, hq, map_zero]
  · intro c; exact isAlgebraic_algebraMap c
  · intro z w _ _ hz hw; exact hz.add hw
  · intro z _ hz; exact hz.inv
  · intro z w _ _ hz hw; exact hz.mul hw

theorem isAlgebraic_coInAdjoin (y : K') :
    IsAlgebraic K ((coInAdjoin (K := K) (K' := K') p A y :
      adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) := by
  have hy : IsAlgebraic K y := (Algebra.IsSeparable.isAlgebraic K K').isAlgebraic y
  exact IsAlgebraic.ringHom_of_comp_eq (f := RingHom.id K) (g := placeCompletionCoe A)
    hy Function.injective_id
    (by ext x; exact algebraMap_placeCompletionCoe A x)

/-! ## The `K`-algebra structure induced on `M = K_p · K'` -/

/-- The `K`-algebra structure on `M = K_p · K'` obtained from `K → K_p → M`. -/
noncomputable abbrev adjoinAlgebraK :
    Algebra K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) :=
  ((algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)).comp
    (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p))).toAlgebra

theorem algebraMap_eq_comp :
    (algebraMap K (placeCompletion A)) =
      (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A)).comp
        ((algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
          ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)).comp
          (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p))) := by
  haveI := IntermediateField.isScalarTower_mid' (adjoinPlaceCompletion (K := K) (K' := K') p A)
  have hΦ : (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)) =
      adicCompletionToPlaceCompletion p A hA := RingHom.ext halg
  refine RingHom.ext fun x => ?_
  rw [RingHom.comp_apply, RingHom.comp_apply,
    show (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A))
        ((algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
          ↥(adjoinPlaceCompletion (K := K) (K' := K') p A))
          (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) x)) =
      algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)
        (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) x) from
      RingHom.congr_fun (IsScalarTower.algebraMap_eq
        (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A)) _,
    RingHom.ext_iff.mp hΦ (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) x),
    adicCompletionToPlaceCompletion_algebraMap, algebraMap_placeCompletionCoe]

theorem isAlgebraic_adjoin_apply
    (τ : adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A)
    {x : adjoinPlaceCompletion (K := K) (K' := K') p A}
    (hx : IsAlgebraic K ((x : adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A)) :
    IsAlgebraic K (((τ x : adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A)) := by
  letI := adjoinAlgebraK (K := K) (K' := K') p A
  have hfalg : (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) : K →+*
      ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) =
      (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)).comp
        (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)) := rfl
  have hinjM : Function.Injective (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)
      (placeCompletion A)) := fun a b hab => Subtype.ext hab
  have hcomp : RingHom.comp (algebraMap K (placeCompletion A)) (RingHom.id K) =
      RingHom.comp (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A))
        (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) := by
    rw [RingHom.comp_id]
    refine RingHom.ext fun c => ?_
    rw [RingHom.comp_apply, RingHom.congr_fun hfalg c]
    exact RingHom.congr_fun (algebraMap_eq_comp (K := K) (K' := K') p A hA halg) c
  have hx' : IsAlgebraic K x :=
    IsAlgebraic.of_ringHom_of_comp_eq (f := RingHom.id K)
      (g := algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A))
      hx Function.surjective_id hinjM hcomp
  have hτpoint : ∀ c : K, τ ((algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) c) =
      (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) c := fun c => by
    rw [RingHom.congr_fun hfalg c]
    exact τ.commutes _
  have hτcomp : RingHom.comp (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A))
      (RingHom.id K) =
      RingHom.comp (τ : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) →+*
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A))
        (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) := by
    rw [RingHom.comp_id]
    refine RingHom.ext fun c => ?_
    rw [RingHom.comp_apply]
    exact (hτpoint c).symm
  have h1 : IsAlgebraic K (τ x) :=
    IsAlgebraic.ringHom_of_comp_eq (f := RingHom.id K)
      (g := (τ : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) →+*
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)))
      hx' Function.injective_id hτcomp
  exact IsAlgebraic.ringHom_of_comp_eq (f := RingHom.id K)
    (g := algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A))
    h1 Function.injective_id hcomp

end AdjoinAlgebra

/-! ## The round trips of the extension to the completion -/

section Completion

variable {R : Type*} [Field R] {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]
variable (v : Valuation R Γ₀)

/-- The extension of `σ⁻¹` is a left inverse of the extension of `σ` on the completion. -/
theorem completionRingEquiv_symm_comp_apply
    (hdense : DenseRange fun x : R => (x : v.Completion)) (σ : R ≃+* R)
    (hσ : ∀ x : R, v (σ x) = v x) (hσ' : ∀ x : R, v (σ.symm x) = v x) (z : v.Completion) :
    Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
      (Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ z) = z := by
  have hcont : Continuous fun z : v.Completion =>
      Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ z) :=
    (Submission.NeukirchUchida.Local.continuous_completionRingEquiv v σ.symm hσ').comp
      (Submission.NeukirchUchida.Local.continuous_completionRingEquiv v σ hσ)
  have hclosed : IsClosed {w : v.Completion |
      Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ w) = w} :=
    isClosed_eq hcont continuous_id
  have hsub : Set.range (fun x : R => (x : v.Completion)) ⊆ {w : v.Completion |
      Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ w) = w} := by
    rintro w ⟨x, rfl⟩
    show Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
          ↑(WithVal.toVal v x)) = ↑(WithVal.toVal v x)
    rw [Submission.NeukirchUchida.Local.completionRingEquiv_coe v σ hσ x,
      Submission.NeukirchUchida.Local.completionRingEquiv_coe v σ.symm hσ' (σ x),
      RingEquiv.symm_apply_apply]
  have huniv : Set.univ ⊆ {w : v.Completion |
      Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ w) = w} := by
    rw [← hdense.closure_eq]
    exact closure_minimal hsub hclosed
  exact huniv (Set.mem_univ z)

/-- The extension of `σ` is a left inverse of the extension of `σ⁻¹` on the completion. -/
theorem completionRingEquiv_comp_symm_apply
    (hdense : DenseRange fun x : R => (x : v.Completion)) (σ : R ≃+* R)
    (hσ : ∀ x : R, v (σ x) = v x) (hσ' : ∀ x : R, v (σ.symm x) = v x) (z : v.Completion) :
    Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
      (Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ' z) = z := by
  have hcont : Continuous fun z : v.Completion =>
      Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ' z) :=
    (Submission.NeukirchUchida.Local.continuous_completionRingEquiv v σ hσ).comp
      (Submission.NeukirchUchida.Local.continuous_completionRingEquiv v σ.symm hσ')
  have hclosed : IsClosed {w : v.Completion |
      Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ' w) = w} :=
    isClosed_eq hcont continuous_id
  have hsub : Set.range (fun x : R => (x : v.Completion)) ⊆ {w : v.Completion |
      Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ' w) = w} := by
    rintro w ⟨x, rfl⟩
    show Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ'
          ↑(WithVal.toVal v x)) = ↑(WithVal.toVal v x)
    rw [Submission.NeukirchUchida.Local.completionRingEquiv_coe v σ.symm hσ' x,
      Submission.NeukirchUchida.Local.completionRingEquiv_coe v σ hσ (σ.symm x),
      RingEquiv.apply_symm_apply]
  have huniv : Set.univ ⊆ {w : v.Completion |
      Submission.NeukirchUchida.Local.completionRingEquiv v σ hσ
        (Submission.NeukirchUchida.Local.completionRingEquiv v σ.symm hσ' w) = w} := by
    rw [← hdense.closure_eq]
    exact closure_minimal hsub hclosed
  exact huniv (Set.mem_univ z)

end Completion

section Automorphisms

variable (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable (A : ValuationSubring K')
variable (hA : A.comap (algebraMap K K') =
  IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
variable [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)]
variable (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
  algebraMap _ _ z = adicCompletionToPlaceCompletion p A hA z)

include hA halg

theorem coe_coInAdjoin_algebraMap (c : K) :
    ((coInAdjoin (K := K) (K' := K') p A (algebraMap K K' c) :
      adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) =
      algebraMap K (placeCompletion A) c := by
  rw [coe_coInAdjoin, algebraMap_placeCompletionCoe]

/-! ## The inverse construction: a `K_p`-automorphism of `M` induces an automorphism of `K'` -/

/-- **Every `K_p`-algebra automorphism of `M = K_p · K'` restricts to a `K`-algebra automorphism of
`K'`.**  The image of `K'` in `M` is the set of elements algebraic over `K`, which is preserved
because the automorphism fixes `K`. -/
theorem exists_algEquiv_of_algEquiv_adjoinPlaceCompletion
    (τ : adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A) :
    ∃ σ : K' ≃ₐ[K] K', ∀ y : K',
      ((τ (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) =
        placeCompletionCoe A (σ y) := by
  letI := adjoinAlgebraK (K := K) (K' := K') p A
  have hinj : Function.Injective (placeCompletionCoe A) := RingHom.injective _
  have hEx : ∀ y : K', ∃ z : K', placeCompletionCoe A z =
      ((τ (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) := fun y =>
    (isAlgebraic_iff_exists_placeCompletionCoe A _).mp
      (isAlgebraic_adjoin_apply (K := K) (K' := K') p A hA halg τ
        (isAlgebraic_coInAdjoin (K := K) (K' := K') p A hA halg y))
  have hEx' : ∀ y : K', ∃ z : K', placeCompletionCoe A z =
      ((τ.symm (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) := fun y =>
    (isAlgebraic_iff_exists_placeCompletionCoe A _).mp
      (isAlgebraic_adjoin_apply (K := K) (K' := K') p A hA halg τ.symm
        (isAlgebraic_coInAdjoin (K := K) (K' := K') p A hA halg y))
  let sf : K' → K' := fun y => Classical.choose (hEx y)
  have sf_spec : ∀ y : K', placeCompletionCoe A (sf y) =
      ((τ (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) := fun y =>
    Classical.choose_spec (hEx y)
  let sg : K' → K' := fun y => Classical.choose (hEx' y)
  have sg_spec : ∀ y : K', placeCompletionCoe A (sg y) =
      ((τ.symm (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) := fun y =>
    Classical.choose_spec (hEx' y)
  have hco_sf : ∀ y : K', coInAdjoin (K := K) (K' := K') p A (sf y) =
      τ (coInAdjoin (K := K) (K' := K') p A y) := fun y =>
    Subtype.ext (by rw [coe_coInAdjoin, sf_spec])
  have hco_sg : ∀ y : K', coInAdjoin (K := K) (K' := K') p A (sg y) =
      τ.symm (coInAdjoin (K := K) (K' := K') p A y) := fun y =>
    Subtype.ext (by rw [coe_coInAdjoin, sg_spec])
  have hleft : ∀ y : K', sg (sf y) = y := fun y => hinj (by
    simp only [sg_spec, hco_sf, AlgEquiv.symm_apply_apply, coe_coInAdjoin])
  have hright : ∀ y : K', sf (sg y) = y := fun y => hinj (by
    simp only [sf_spec, hco_sg, AlgEquiv.apply_symm_apply, coe_coInAdjoin])
  have sf_add : ∀ a b : K', sf (a + b) = sf a + sf b := fun a b => hinj (by
    simp only [sf_spec, coInAdjoin_add p A, map_add, IntermediateField.coe_add])
  have sf_mul : ∀ a b : K', sf (a * b) = sf a * sf b := fun a b => hinj (by
    simp only [sf_spec, coInAdjoin_mul p A, map_mul, IntermediateField.coe_mul])
  have sf_one : sf 1 = 1 := hinj (by
    simp only [sf_spec, coInAdjoin_one p A, map_one, IntermediateField.coe_one])
  have sf_zero : sf 0 = 0 := hinj (by
    simp only [sf_spec, coInAdjoin_zero p A, map_zero, IntermediateField.coe_zero])
  let sfH : K' →+* K' :=
    { toFun := sf, map_one' := sf_one, map_zero' := sf_zero,
      map_add' := sf_add, map_mul' := sf_mul }
  have hbij : Function.Bijective sfH := ⟨fun a b h => by
      have h2 : sg (sfH a) = sg (sfH b) := congrArg sg h
      rwa [hleft a, hleft b] at h2, fun y => ⟨sg y, hright y⟩⟩
  have hfixKpoint : ∀ c : K, sfH (algebraMap K K' c) = algebraMap K K' c := by
    intro c
    apply hinj
    have hco_alg : coInAdjoin (K := K) (K' := K') p A (algebraMap K K' c) =
        algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) c := by
      refine Subtype.ext ?_
      rw [coe_coInAdjoin_algebraMap (K := K) (K' := K') p A hA halg c]
      exact RingHom.congr_fun (algebraMap_eq_comp (K := K) (K' := K') p A hA halg) c
    have hτfix : τ (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) c) =
        algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) c := by
      have hfalg : (algebraMap K ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) : K →+*
          ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) =
          (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
            ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)).comp
            (algebraMap K (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)) := rfl
      rw [RingHom.congr_fun hfalg c]
      exact τ.commutes _
    rw [show sfH (algebraMap K K' c) = sf (algebraMap K K' c) from rfl,
      sf_spec (algebraMap K K' c), hco_alg, hτfix]
    exact (RingHom.congr_fun (algebraMap_eq_comp (K := K) (K' := K') p A hA halg) c).symm.trans
      (algebraMap_placeCompletionCoe A c)
  refine ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective sfH hbij) hfixKpoint, fun y => ?_⟩
  show ((τ (coInAdjoin (K := K) (K' := K') p A y) :
      adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) =
    placeCompletionCoe A (sf y)
  exact (sf_spec y).symm

/-! ## The forward construction: the extension of `σ ∈ D_A` to the completion preserves `M` -/

theorem completionRingEquiv_mem_adjoinPlaceCompletion
    (σ : K' ≃+* K') (hσ : ∀ x : K', A.valuation (σ x) = A.valuation x)
    (hσK : ∀ c : K, σ (algebraMap K K' c) = algebraMap K K' c)
    {x : placeCompletion A} (hx : x ∈ adjoinPlaceCompletion (K := K) (K' := K') p A) :
    Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ hσ x ∈
      adjoinPlaceCompletion (K := K) (K' := K') p A := by
  have hΦ : (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)) =
      adicCompletionToPlaceCompletion p A hA := RingHom.ext halg
  have hfix : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ hσ
        (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A) z) =
      algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A) z := by
    intro z
    rw [RingHom.ext_iff.mp hΦ z,
      completionRingEquiv_adicCompletionToPlaceCompletion p A hA σ hσ hσK z,
      ← RingHom.ext_iff.mp hΦ z]
  refine IntermediateField.adjoin_induction
    (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
    (s := Set.range (placeCompletionCoe A))
    (p := fun x _ => Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ hσ x ∈
      adjoinPlaceCompletion (K := K) (K' := K') p A) ?_ ?_ ?_ ?_ ?_ hx
  · rintro x ⟨y, rfl⟩
    rw [show placeCompletionCoe A y = ((y : K') : placeCompletion A) from rfl,
      Submission.NeukirchUchida.Local.completionRingEquiv_coe]
    exact mem_adjoinPlaceCompletion A (σ y)
  · intro c
    rw [hfix c]
    exact IntermediateField.algebraMap_mem _ c
  · intro x y _ _ hx hy
    rw [map_add]; exact add_mem hx hy
  · intro x _ hx
    rw [map_inv₀]; exact inv_mem hx
  · intro x y _ _ hx hy
    rw [map_mul]; exact mul_mem hx hy

/-! ## The restriction of the extension of `σ ∈ D_A` to `M` -/

/-- **The restriction to `M = K_p · K'` of the continuous extension of `σ ∈ D_A` to the
completion.** -/
noncomputable def decompositionToAdjoin (σ : NK.Mine.decompositionGroupOf K K' A) :
    adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A := by
  have hval : ∀ x : K', A.valuation (σ.1 x) = A.valuation x :=
    val_eq_of_mem_decompositionGroupOf A σ.2
  have hval' : ∀ x : K', A.valuation (σ.1.symm x) = A.valuation x := fun x => by
    rw [← hval (σ.1.symm x), AlgEquiv.apply_symm_apply]
  have hσK : ∀ c : K, σ.1.toRingEquiv (algebraMap K K' c) = algebraMap K K' c :=
    fun c => σ.1.commutes c
  have hσK' : ∀ c : K, (σ.1.symm).toRingEquiv (algebraMap K K' c) = algebraMap K K' c :=
    fun c => σ.1.symm.commutes c
  have hMmem : ∀ x ∈ adjoinPlaceCompletion (K := K) (K' := K') p A,
      Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval x ∈
        adjoinPlaceCompletion (K := K) (K' := K') p A :=
    fun x hx =>
      completionRingEquiv_mem_adjoinPlaceCompletion p A hA halg σ.1.toRingEquiv hval hσK hx
  have hMmem' : ∀ x ∈ adjoinPlaceCompletion (K := K) (K' := K') p A,
      Submission.NeukirchUchida.Local.completionRingEquiv A.valuation (σ.1.symm).toRingEquiv
        hval' x ∈ adjoinPlaceCompletion (K := K) (K' := K') p A :=
    fun x hx =>
      completionRingEquiv_mem_adjoinPlaceCompletion p A hA halg (σ.1.symm).toRingEquiv hval' hσK' hx
  have hfix : ∀ c : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval
        (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A) c) =
      algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A) c := by
    intro c
    have hΦ : (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A)) =
        adicCompletionToPlaceCompletion p A hA := RingHom.ext halg
    rw [RingHom.ext_iff.mp hΦ c,
      completionRingEquiv_adicCompletionToPlaceCompletion p A hA σ.1.toRingEquiv hval hσK c,
      ← RingHom.ext_iff.mp hΦ c]
  refine
    { toFun := fun x =>
        ⟨Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval x,
          hMmem x x.2⟩
      invFun := fun x =>
        ⟨Submission.NeukirchUchida.Local.completionRingEquiv A.valuation (σ.1.symm).toRingEquiv
          hval' x, hMmem' x x.2⟩
      left_inv := fun x => Subtype.ext (completionRingEquiv_symm_comp_apply A.valuation
        (denseRange_placeCompletionCoe A) σ.1.toRingEquiv hval hval' x)
      right_inv := fun x => Subtype.ext (completionRingEquiv_comp_symm_apply A.valuation
        (denseRange_placeCompletionCoe A) σ.1.toRingEquiv hval hval' x)
      map_mul' := fun x y => Subtype.ext (map_mul
        (Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval)
        (x : placeCompletion A) (y : placeCompletion A))
      map_add' := fun x y => Subtype.ext (map_add
        (Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval)
        (x : placeCompletion A) (y : placeCompletion A))
      commutes' := fun c => Subtype.ext (by
        show Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv hval
            (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A) c) =
          algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p) (placeCompletion A) c
        exact hfix c) }

theorem decompositionToAdjoin_coInAdjoin (σ : NK.Mine.decompositionGroupOf K K' A) (y : K') :
    decompositionToAdjoin (K := K) (K' := K') p A hA halg σ
        (coInAdjoin (K := K) (K' := K') p A y) =
      coInAdjoin (K := K) (K' := K') p A (σ.1 y) := by
  refine Subtype.ext ?_
  show Submission.NeukirchUchida.Local.completionRingEquiv A.valuation σ.1.toRingEquiv
      (val_eq_of_mem_decompositionGroupOf A σ.2) (placeCompletionCoe A y) = placeCompletionCoe A (σ.1 y)
  rw [show placeCompletionCoe A y = ((y : K') : placeCompletion A) from rfl,
    Submission.NeukirchUchida.Local.completionRingEquiv_coe]
  rfl

/-- Two `K_p`-algebra automorphisms of `M` which agree on the image of `K'` are equal: the image
of `K'` together with `K_p` generates `M`. -/
theorem algEquiv_ext_adjoin
    (φ ψ : adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A)
    (h : ∀ y : K', φ (coInAdjoin (K := K) (K' := K') p A y) =
      ψ (coInAdjoin (K := K) (K' := K') p A y)) : φ = ψ := by
  refine AlgEquiv.ext fun x => ?_
  refine IntermediateField.adjoin_induction (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
    (s := Set.range (placeCompletionCoe A))
    (p := fun z hz => φ ⟨z, hz⟩ = ψ ⟨z, hz⟩) ?_ ?_ ?_ ?_ ?_ x.2
  · rintro z ⟨y, rfl⟩
    exact h y
  · intro c
    exact (φ.commutes c).trans (ψ.commutes c).symm
  · intro z w hz hw ihz ihw
    have hsum : φ ((⟨z, hz⟩ : adjoinPlaceCompletion (K := K) (K' := K') p A) + ⟨w, hw⟩) =
        ψ ((⟨z, hz⟩ : adjoinPlaceCompletion (K := K) (K' := K') p A) + ⟨w, hw⟩) := by
      rw [map_add, map_add, ihz, ihw]
    exact hsum
  · intro z hz ih
    have hinv : φ (((⟨z, hz⟩ : adjoinPlaceCompletion (K := K) (K' := K') p A))⁻¹) =
        ψ (((⟨z, hz⟩ : adjoinPlaceCompletion (K := K) (K' := K') p A))⁻¹) := by
      rw [map_inv₀, map_inv₀, ih]
    exact hinv
  · intro z w hz hw ihz ihw
    have hprod : φ ((⟨z, hz⟩ : adjoinPlaceCompletion (K := K) (K' := K') p A) * ⟨w, hw⟩) =
        ψ ((⟨z, hz⟩ : adjoinPlaceCompletion (K := K) (K' := K') p A) * ⟨w, hw⟩) := by
      rw [map_mul, map_mul, ihz, ihw]
    exact hprod

/-! ## The Henselian uniqueness step -/

/-- **A `K_p`-algebra automorphism of `M = K_p · K'` preserves the valuation ring `O_C ∩ M`.**

The valuation ring of `K_p` is Henselian (the `p`-adic completion of a number field is complete),
hence the valuation ring of `M` has a *unique* extension to the algebraic extension `M/K_p`
(`Commons.RingTheory.Valuation.eq_of_comap_eq_of_isAlgebraic`).  Since `τ` fixes `K_p`, both `B`
and `τ⁻¹B` restrict to the same valuation subring of `K_p`, so they coincide.  Here `hW`
identifies the two integer rings. -/
theorem comap_algEquiv_placeCompletionIntegers_eq
    (hW : (placeCompletionIntegers A).comap (adicCompletionToPlaceCompletion p A hA) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p)
    (τ : adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A) :
    ((placeCompletionIntegers A).comap
        (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A))).comap
        (τ : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) →+*
          ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) =
      (placeCompletionIntegers A).comap
        (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A)) := by
  haveI := IntermediateField.isScalarTower_mid' (adjoinPlaceCompletion (K := K) (K' := K') p A)
  haveI halgM : Algebra.IsAlgebraic (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) := by
    refine ⟨fun x => ?_⟩
    refine (isAlgebraic_algebraMap_iff
      (R := IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (S := ↥(adjoinPlaceCompletion (K := K) (K' := K') p A))
      (A := placeCompletion A) ?_).mp ?_
    · intro a b hab
      exact Subtype.ext hab
    · exact isAlgebraic_of_mem_adjoinPlaceCompletion p A hA halg x.2
  haveI := Commons.RingTheory.Henselian.adicCompletionIntegers_henselianLocalRing
    (R := NumberField.RingOfIntegers K) (K := K) p
  have hτ : ((τ : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) →+*
      ↥(adjoinPlaceCompletion (K := K) (K' := K') p A))).comp
      (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) =
      algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) :=
    RingHom.ext fun c => τ.commutes c
  have hB : ((placeCompletionIntegers A).comap
        (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A))).comap
        (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
          ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p := by
    rw [ValuationSubring.comap_comap,
      ← IsScalarTower.algebraMap_eq (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A),
      RingHom.ext halg, hW]
  refine Commons.RingTheory.Valuation.eq_of_comap_eq_of_isAlgebraic
    (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p) _ _ ?_ ?_
  · rw [ValuationSubring.comap_comap, hτ]
    exact hB
  · exact hB

/-- **The inverse construction.**  Every `K_p`-algebra automorphism `τ` of `M = K_p · K'` is the
restriction of the extension to the completion of a unique element of `D_A`; here we produce that
element. -/
theorem exists_mem_decompositionGroupOf_of_algEquiv_adjoin
    (hW : (placeCompletionIntegers A).comap (adicCompletionToPlaceCompletion p A hA) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p)
    (τ : adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A) :
    ∃ σ : NK.Mine.decompositionGroupOf K K' A, ∀ y : K',
      ((τ (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) =
        placeCompletionCoe A (σ.1 y) := by
  obtain ⟨σ, hσ⟩ := exists_algEquiv_of_algEquiv_adjoinPlaceCompletion p A hA halg τ
  set B : ValuationSubring ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) :=
    (placeCompletionIntegers A).comap
      (algebraMap ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) (placeCompletion A)) with hBdef
  have hB : B.comap (τ : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) →+*
      ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) = B := by
    rw [hBdef]
    exact comap_algEquiv_placeCompletionIntegers_eq (K := K) (K' := K') p A hA halg hW τ
  have key : ∀ y : K', (y ∈ A ↔ placeCompletionCoe A y ∈ placeCompletionIntegers A) := by
    intro y
    conv_lhs => rw [← comap_placeCompletionIntegers A]
    exact Iff.rfl
  have hco : ∀ z : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A),
      (z ∈ B ↔ ((z : adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) ∈
        placeCompletionIntegers A) := by
    intro z
    rw [hBdef, ValuationSubring.mem_comap]
    exact Iff.rfl
  have hBpoint : ∀ z : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A),
      (z ∈ B ↔ τ z ∈ B) := by
    intro z
    have h1 : z ∈ B.comap (τ : ↥(adjoinPlaceCompletion (K := K) (K' := K') p A) →+*
        ↥(adjoinPlaceCompletion (K := K) (K' := K') p A)) ↔ z ∈ B := by rw [hB]
    rw [ValuationSubring.mem_comap] at h1
    exact h1.symm
  refine ⟨⟨σ, ?_⟩, hσ⟩
  rw [NK.Mine.decompositionGroupOf,
    Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubring_iff]
  intro x
  rw [key x, key (σ x)]
  rw [show placeCompletionCoe A x = ((coInAdjoin (K := K) (K' := K') p A x :
      adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) from rfl]
  rw [← hco (coInAdjoin (K := K) (K' := K') p A x),
    hBpoint (coInAdjoin (K := K) (K' := K') p A x),
    hco (τ (coInAdjoin (K := K) (K' := K') p A x)), hσ x]

end Automorphisms

theorem nonempty_mulEquiv_decompositionGroupOf_adjoin {K K' : Type*} [Field K] [NumberField K]
    [Field K'] [Algebra K K'] [IsSepClosure K K']
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    (hA : A.comap (algebraMap K K') =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      algebraMap _ _ z = NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA z)
    (hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
        (NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p) :
    Nonempty (NK.Mine.decompositionGroupOf K K' A ≃*
      (IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
          (Set.range (NK.NeukirchUchida.placeCompletionCoe A)) ≃ₐ[
            IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
        IntermediateField.adjoin (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
          (Set.range (NK.NeukirchUchida.placeCompletionCoe A)))) := by
  let f : NK.Mine.decompositionGroupOf K K' A →*
      (adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
        IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
        adjoinPlaceCompletion (K := K) (K' := K') p A) :=
    { toFun := fun σ => decompositionToAdjoin (K := K) (K' := K') p A hA halg σ
      map_one' := by
        refine algEquiv_ext_adjoin (K := K) (K' := K') p A hA halg _ _ fun y => ?_
        rw [decompositionToAdjoin_coInAdjoin (K := K) (K' := K') p A hA halg 1 y]
        rfl
      map_mul' := fun σ τ => by
        refine algEquiv_ext_adjoin (K := K) (K' := K') p A hA halg _ _ fun y => ?_
        rw [AlgEquiv.mul_apply,
          decompositionToAdjoin_coInAdjoin (K := K) (K' := K') p A hA halg τ y,
          decompositionToAdjoin_coInAdjoin (K := K) (K' := K') p A hA halg σ (τ.1 y),
          decompositionToAdjoin_coInAdjoin (K := K) (K' := K') p A hA halg (σ * τ) y]
        rfl }
  have hgEx : ∀ τ : adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A,
      ∃ σ : NK.Mine.decompositionGroupOf K K' A, ∀ y : K',
        ((τ (coInAdjoin (K := K) (K' := K') p A y) :
          adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) =
          placeCompletionCoe A (σ.1 y) :=
    fun τ =>
      exists_mem_decompositionGroupOf_of_algEquiv_adjoin (K := K) (K' := K') p A hA halg hW τ
  let g : (adjoinPlaceCompletion (K := K) (K' := K') p A ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K p]
      adjoinPlaceCompletion (K := K) (K' := K') p A) → NK.Mine.decompositionGroupOf K K' A :=
    fun τ => Classical.choose (hgEx τ)
  have hg_spec : ∀ τ y, ((τ (coInAdjoin (K := K) (K' := K') p A y) :
      adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A) =
      placeCompletionCoe A ((g τ).1 y) := fun τ => Classical.choose_spec (hgEx τ)
  have hgf : ∀ σ, g (f σ) = σ := fun σ => by
    refine Subtype.ext (AlgEquiv.ext fun y => ?_)
    apply RingHom.injective (placeCompletionCoe A)
    exact (hg_spec (f σ) y).symm.trans (congrArg
      (fun z : adjoinPlaceCompletion (K := K) (K' := K') p A => (z : placeCompletion A))
      (decompositionToAdjoin_coInAdjoin (K := K) (K' := K') p A hA halg σ y))
  have hfg : ∀ τ, f (g τ) = τ := fun τ => by
    refine algEquiv_ext_adjoin (K := K) (K' := K') p A hA halg _ _ fun y => ?_
    refine Subtype.ext ?_
    change ((decompositionToAdjoin (K := K) (K' := K') p A hA halg (g τ))
        (coInAdjoin (K := K) (K' := K') p A y) : placeCompletion A) =
      ((τ (coInAdjoin (K := K) (K' := K') p A y) :
        adjoinPlaceCompletion (K := K) (K' := K') p A) : placeCompletion A)
    rw [decompositionToAdjoin_coInAdjoin (K := K) (K' := K') p A hA halg (g τ) y]
    exact (hg_spec τ y).symm
  have hfinj : Function.Injective f := fun σ τ h => by
    have h2 := congrArg g h
    rwa [hgf σ, hgf τ] at h2
  exact ⟨MulEquiv.ofBijective f ⟨hfinj, fun τ => ⟨g τ, hfg τ⟩⟩⟩

end

end NK.NeukirchUchida

