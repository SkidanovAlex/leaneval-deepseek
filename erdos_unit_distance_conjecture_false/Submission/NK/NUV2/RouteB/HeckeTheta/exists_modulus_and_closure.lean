import Mathlib
import Submission.NK.HeckeL.Basic
import Submission.NK.HeckeL.Basic.ideal_eq_prod_finsupp
import Submission.NK.HeckeL.Basic.classOfIdeal_mul
import Submission.NK.NUV2.RouteB.HeckeTheta.Defs
import Submission.NK.NUV2.RouteB.RayModulus.Defs
import Submission.NK.NUV2.RouteB.RayModulus.exists_modulus_le
import Submission.NK.NUV2.RouteB.RayModulus.exists_ideal_of_class
import Submission.NK.NUV2.RouteB.RayModulus.classOfIdeal_eq_iff

/-!
# The modulus of an open subgroup and the closure of the prime classes

For a number field `K` and an open subgroup `U ≤ 𝕀 K` with finite ray class group, there is a
nonzero ideal `𝔪` of `𝓞 K` such that

* the class of every principal ideal `(γ)` with `γ ≡ 1 (mod 𝔪)` and `γ` totally positive is
  trivial in `𝕀 K ⧸ (Kˣ · U)`, and
* the class of *every* prime ideal lies in the subgroup generated by the classes of the primes
  coprime to `𝔪`.

The ideal is the modulus ideal `∏_q q^{m q}` of a modulus `m` of `U`
(`NK.NUV2.RouteB.RayModulus.exists_modulus_le`: an open `U` contains a congruence subgroup
`U(m)`).
The first property is the ray-class/lattice dictionary for principal ideals
(`NK.NUV2.RouteB.RayModulus.uUnitHom_mem_congSubgroup`): the unit part `u₀(γ)` of the idèle of
`(γ)` is a congruence idèle modulo `m`, hence lies in `U`, and the class of `(γ)` is the class of
`u₀(γ)`.  The second is the surjectivity of `I ↦ classOfIdeal K U(m) I` on the ideals coprime to
`m` (`NK.NUV2.RouteB.RayModulus.exists_ideal_of_class`) combined with the factorisation of an
ideal into prime powers (`NK.HeckeL.Basic.ideal_eq_prod_finsupp`).
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option maxHeartbeats 1000000

open NumberField IsDedekindDomain
open scoped nonZeroDivisors
open NK.GlobalCFT (Idele IdeleClassGroup Place)

noncomputable section

namespace NK.NUV2.RouteB.HeckeTheta

variable {K : Type} [Field K] [NumberField K]

/-! ## Auxiliary lemmas

They live in their own namespace so that they cannot clash with the lemmas of the other files of
the team. -/

namespace ModulusAux

/-- The class of the zero ideal is trivial. -/
theorem classOfIdeal_bot (U : Subgroup (Idele K)) :
    NK.HeckeL.classOfIdeal K U (⊥ : Ideal (𝓞 K)) = 1 := by
  have h : NK.HeckeL.ideleOfIdeal K (⊥ : Ideal (𝓞 K)) = 1 := by
    apply NK.GlobalCFT.Idele.ext
    intro v
    match v with
    | Sum.inl w => rfl
    | Sum.inr q =>
        show IdeleClassGroup.unifUnit K q ^
          (FractionalIdeal.count K q ((⊥ : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K)) = 1
        rw [FractionalIdeal.coeIdeal_bot, FractionalIdeal.count_zero, zpow_zero]
  unfold NK.HeckeL.classOfIdeal
  rw [h, map_one, map_one]

/-- The class of the unit ideal is trivial. -/
theorem classOfIdeal_one (U : Subgroup (Idele K)) :
    NK.HeckeL.classOfIdeal K U (1 : Ideal (𝓞 K)) = 1 := by
  have h : NK.HeckeL.ideleOfIdeal K (1 : Ideal (𝓞 K)) = 1 := by
    apply NK.GlobalCFT.Idele.ext
    intro v
    match v with
    | Sum.inl w => rfl
    | Sum.inr q =>
        show IdeleClassGroup.unifUnit K q ^
          (FractionalIdeal.count K q ((1 : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K)) = 1
        rw [Ideal.one_eq_top, FractionalIdeal.coeIdeal_top, FractionalIdeal.count_one, zpow_zero]
  unfold NK.HeckeL.classOfIdeal
  rw [h, map_one, map_one]

/-- `classOfIdeal` is multiplicative in powers of a nonzero ideal. -/
theorem classOfIdeal_pow (U : Subgroup (Idele K)) {I : Ideal (𝓞 K)} (hI : I ≠ 0) (k : ℕ) :
    NK.HeckeL.classOfIdeal K U (I ^ k) = (NK.HeckeL.classOfIdeal K U I) ^ k := by
  induction k with
  | zero => rw [pow_zero, pow_zero]; exact classOfIdeal_one U
  | succ k ih =>
      rw [pow_succ, pow_succ,
        NK.HeckeL.Basic.classOfIdeal_mul U _ _ (pow_ne_zero k hI) hI, ih]

/-- A finite product of prime powers is a nonzero ideal. -/
theorem ideal_prod_prime_pow_ne_zero {ι : Type} (s : Finset ι)
    (q : ι → NK.HeckeL.PrimeIdeal K) (e : ι → ℕ) :
    (∏ i ∈ s, (q i).asIdeal ^ e i) ≠ 0 := by
  rw [Finset.prod_ne_zero_iff]
  intro i _
  exact pow_ne_zero _ (IsDedekindDomain.HeightOneSpectrum.ne_bot (q i))

/-- **The class of a finite product of prime powers** is the product of the classes. -/
theorem classOfIdeal_finset_prod_prime_pow {ι : Type} (U : Subgroup (Idele K))
    (s : Finset ι) (q : ι → NK.HeckeL.PrimeIdeal K) (e : ι → ℕ) :
    NK.HeckeL.classOfIdeal K U (∏ i ∈ s, (q i).asIdeal ^ e i)
      = ∏ i ∈ s, (NK.HeckeL.classOfIdeal K U (q i).asIdeal) ^ e i := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      rw [Finset.prod_empty, Finset.prod_empty]
      exact classOfIdeal_one U
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha,
        NK.HeckeL.Basic.classOfIdeal_mul U _ _
          (pow_ne_zero _ (IsDedekindDomain.HeightOneSpectrum.ne_bot (q a)))
          (ideal_prod_prime_pow_ne_zero s q e),
        classOfIdeal_pow U (IsDedekindDomain.HeightOneSpectrum.ne_bot (q a)) (e a), ih]

/-- A prime carrying a nonzero exponent belongs to the support of a modulus. -/
theorem exps_ne_zero_of_mem_supportFinset (𝔪 : NK.NUV2.RouteB.Modulus K)
    {q : HeightOneSpectrum (𝓞 K)} (hq : q ∈ 𝔪.supportFinset) : 𝔪.exps q ≠ 0 := by
  classical
  rw [NK.NUV2.RouteB.Modulus.supportFinset, Set.Finite.mem_toFinset] at hq
  exact hq

/-- The multiplicity in the modulus ideal of a prime at which the modulus vanishes is zero. -/
theorem count_ideal_of_exps_eq_zero (𝔪 : NK.NUV2.RouteB.Modulus K)
    {q : HeightOneSpectrum (𝓞 K)} (hq : 𝔪.exps q = 0) :
    FractionalIdeal.count K q (𝔪.ideal : FractionalIdeal (𝓞 K)⁰ K) = 0 := by
  classical
  rw [NK.NUV2.RouteB.Modulus.ideal, NK.HeckeL.Basic.IdealProdFinsupp.coeIdeal_finset_prod]
  simp only [FractionalIdeal.coeIdeal_pow]
  rw [FractionalIdeal.count_prod K q 𝔪.supportFinset
      (fun q' => (q'.asIdeal : FractionalIdeal (𝓞 K)⁰ K) ^ (𝔪.exps q'))
      (fun q' _ => pow_ne_zero _
        (FractionalIdeal.coeIdeal_ne_zero.mpr (IsDedekindDomain.HeightOneSpectrum.ne_bot q')))]
  refine Finset.sum_eq_zero fun q' hq' => ?_
  rw [FractionalIdeal.count_pow, FractionalIdeal.count_maximal]
  have hne : q' ≠ q := fun h => exps_ne_zero_of_mem_supportFinset 𝔪 hq' (h ▸ hq)
  simp [hne]

/-- If the modulus vanishes at a prime, that prime does not divide the modulus ideal. -/
theorem not_dvd_ideal_of_exps_eq_zero (𝔪 : NK.NUV2.RouteB.Modulus K)
    {q : HeightOneSpectrum (𝓞 K)} (hq : 𝔪.exps q = 0) : ¬ q.asIdeal ∣ 𝔪.ideal := by
  intro hd
  have hne := (NK.HeckeL.Basic.IdealProdFinsupp.count_coe_ne_zero_iff_dvd 𝔪.ideal_ne_zero q).mpr hd
  rw [count_ideal_of_exps_eq_zero 𝔪 hq] at hne
  exact hne rfl

/-- **Monotonicity of `classOfIdeal` in the subgroup**: equal classes modulo a smaller subgroup
remain equal modulo a larger one. -/
theorem classOfIdeal_eq_of_le {V U : Subgroup (Idele K)} (h : V ≤ U) (I J : Ideal (𝓞 K))
    (heq : NK.HeckeL.classOfIdeal K V I = NK.HeckeL.classOfIdeal K V J) :
    NK.HeckeL.classOfIdeal K U I = NK.HeckeL.classOfIdeal K U J := by
  rw [NK.NUV2.RouteB.RayModulus.classOfIdeal_eq_mk V I,
      NK.NUV2.RouteB.RayModulus.classOfIdeal_eq_mk V J] at heq
  rw [NK.NUV2.RouteB.RayModulus.classOfIdeal_eq_mk U I,
      NK.NUV2.RouteB.RayModulus.classOfIdeal_eq_mk U J]
  refine (QuotientGroup.eq (s := Idele.principalSubgroup K ⊔ U)).mpr ?_
  exact sup_le_sup_left h _ ((QuotientGroup.eq (s := Idele.principalSubgroup K ⊔ V)).mp heq)

end ModulusAux

/-! ## The class of a principal ideal whose generator is `1` modulo the modulus -/

/-- **The class of `(γ)` is trivial when `γ ≡ 1 (mod 𝔪)` and `γ` is totally positive.**

The unit part `uUnitHom γ` of the idèle of `(γ)` is a congruence idèle modulo `𝔪`
(`NK.NUV2.RouteB.RayModulus.uUnitHom_mem_congSubgroup`), and the class of `(γ)` is the class of
its unit part. -/
theorem classOfIdeal_span_eq_one_of_mem_ideal (𝔪 : NK.NUV2.RouteB.Modulus K) (γ : 𝓞 K)
    (hγ : γ - 1 ∈ 𝔪.ideal) (hpos : IsTotallyPositive γ) :
    NK.HeckeL.classOfIdeal K (NK.NUV2.RouteB.CongSubgroup K 𝔪) (Ideal.span {γ}) = 1 := by
  classical
  by_cases hγ0 : γ = 0
  · subst hγ0
    rw [show Ideal.span {(0 : 𝓞 K)} = ⊥ from Ideal.span_singleton_eq_bot.mpr rfl]
    exact ModulusAux.classOfIdeal_bot _
  · have hγK : (γ : K) ≠ 0 := fun h =>
      hγ0 (RingOfIntegers.coe_injective (by simpa using h))
    -- `γ ≡ 1` modulo every prime power of the modulus
    have hmemq : ∀ q : HeightOneSpectrum (𝓞 K), 𝔪.exps q ≠ 0 →
        γ - 1 ∈ q.asIdeal ^ (𝔪.exps q) := by
      intro q hq
      have h1 : q.asIdeal ^ (𝔪.exps q) ∣ 𝔪.ideal := by
        rw [NK.NUV2.RouteB.Modulus.ideal]
        exact Finset.dvd_prod_of_mem _ (NK.NUV2.RouteB.Modulus.mem_supportFinset 𝔪 hq)
      exact (Ideal.dvd_iff_le.mp h1) hγ
    have hcongv : ∀ q : HeightOneSpectrum (𝓞 K), 𝔪.exps q ≠ 0 →
        Valued.v (algebraMap K (q.adicCompletion K) ((γ : K) - 1))
          ≤ WithZero.exp (-(𝔪.exps q : ℤ)) := by
      intro q hq
      have h2 := (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem q (γ - 1)
        (𝔪.exps q)).mpr (hmemq q hq)
      have h3 : Valued.v (algebraMap K (q.adicCompletion K) (((γ - 1 : 𝓞 K) : K)))
          = q.intValuation (γ - 1) := by
        rw [Commons.NumberTheory.NumberField.val_algebraMap_adicCompletion_eq,
          IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
      have h4 : ((γ : K) - 1) = (((γ - 1 : 𝓞 K)) : K) := by push_cast; ring
      rw [h4, h3]
      exact h2
    -- hence `γ` is a local unit at the primes of the modulus
    have hunit : ∀ q : HeightOneSpectrum (𝓞 K), 𝔪.exps q ≠ 0 →
        Valued.v (algebraMap K (q.adicCompletion K) (γ : K)) = 1 := by
      intro q hq
      have hmlt : Valued.v (algebraMap K (q.adicCompletion K) ((γ : K) - 1)) < 1 := by
        refine lt_of_le_of_lt (hcongv q hq) ?_
        rw [← WithZero.exp_zero]
        exact WithZero.exp_lt_exp.mpr (by omega)
      have hop : algebraMap K (q.adicCompletion K) (γ : K)
          = (1 : q.adicCompletion K)
            + algebraMap K (q.adicCompletion K) ((γ : K) - 1) := by
        rw [← map_one (algebraMap K (q.adicCompletion K)), ← map_add]
        congr 1
        ring
      rw [hop, Valuation.map_add_eq_of_lt_left (v := Valued.v)
          (x := (1 : q.adicCompletion K))
          (y := algebraMap K (q.adicCompletion K) ((γ : K) - 1))
          (by rw [Valuation.map_one]; exact hmlt), Valuation.map_one]
    have hcongelem : NK.NUV2.RouteB.IsCongElem K 𝔪 (γ : K) :=
      ⟨hcongv, fun w hw _ => hpos w hw⟩
    have hmem : NK.NUV2.RouteB.RayModulus.uUnitHom (Units.mk0 (γ : K) hγK) ∈
        NK.NUV2.RouteB.CongSubgroup K 𝔪 :=
      NK.NUV2.RouteB.RayModulus.uUnitHom_mem_congSubgroup hγK hunit hcongelem
    -- the class of `(γ)` is the class of the unit part
    have hcl : NK.HeckeL.classOfIdeal K (NK.NUV2.RouteB.CongSubgroup K 𝔪) (Ideal.span {γ})
        = QuotientGroup.mk (NK.NUV2.RouteB.RayModulus.uUnitHom (Units.mk0 (γ : K) hγK)) := by
      rw [NK.NUV2.RouteB.RayModulus.classOfIdeal_eq_mk,
        NK.NUV2.RouteB.RayModulus.ideleOfIdeal_eq_ideleOfFracK,
        FractionalIdeal.coeIdeal_span_singleton,
        show ((algebraMap (𝓞 K) K) γ) = ((Units.mk0 (γ : K) hγK : Kˣ) : K) from rfl,
        NK.NUV2.RouteB.RayModulus.ideleOfFracK_spanSingleton_eq (Units.mk0 (γ : K) hγK)]
      rw [QuotientGroup.eq]
      have h : (Idele.principalIdele K (Units.mk0 (γ : K) hγK)
            * NK.NUV2.RouteB.RayModulus.uUnitHom (Units.mk0 (γ : K) hγK))⁻¹
          * NK.NUV2.RouteB.RayModulus.uUnitHom (Units.mk0 (γ : K) hγK)
          = (Idele.principalIdele K (Units.mk0 (γ : K) hγK))⁻¹ := by
        rw [mul_inv_rev,
          mul_comm (NK.NUV2.RouteB.RayModulus.uUnitHom (Units.mk0 (γ : K) hγK))⁻¹
            (Idele.principalIdele K (Units.mk0 (γ : K) hγK))⁻¹,
          mul_assoc, inv_mul_cancel, mul_one]
      rw [h]
      exact Subgroup.mem_sup_left (Subgroup.inv_mem _
        (Idele.mem_principalSubgroup.mpr ⟨_, rfl⟩))
    rw [hcl]
    haveI : (Idele.principalSubgroup K ⊔ NK.NUV2.RouteB.CongSubgroup K 𝔪).Normal :=
      Subgroup.normal_of_isMulCommutative _
    exact (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_sup_right hmem)

/-! ## Every prime class is generated by the coprime prime classes -/

/-- **Every prime class lies in the closure of the classes of the primes coprime to `𝔪.ideal`.** -/
theorem mem_coprimePrimeClosure_classOfIdeal (U : Subgroup (Idele K))
    (𝔪 : NK.NUV2.RouteB.Modulus K) (hle : NK.NUV2.RouteB.CongSubgroup K 𝔪 ≤ U)
    (𝔭 : NK.HeckeL.PrimeIdeal K) :
    NK.HeckeL.classOfIdeal K U 𝔭.asIdeal ∈ coprimePrimeClosure U 𝔪.ideal := by
  classical
  -- an ideal coprime to `𝔪` representing the class of `𝔭` modulo `U(𝔪)`
  obtain ⟨I, hIne, hIcop, hIcls⟩ :=
    NK.NUV2.RouteB.RayModulus.exists_ideal_of_class K 𝔪
      (NK.HeckeL.classOfIdeal K (NK.NUV2.RouteB.CongSubgroup K 𝔪) 𝔭.asIdeal)
  have hScop : ∀ q ∈ 𝔪.supportFinset, ¬ q.asIdeal ∣ I := fun q hq =>
    hIcop q (ModulusAux.exps_ne_zero_of_mem_supportFinset 𝔪 hq)
  obtain ⟨c, hc, -⟩ := NK.HeckeL.Basic.ideal_eq_prod_finsupp 𝔪.supportFinset I hIne hScop
  have hclsU : NK.HeckeL.classOfIdeal K U I = NK.HeckeL.classOfIdeal K U 𝔭.asIdeal :=
    ModulusAux.classOfIdeal_eq_of_le hle I 𝔭.asIdeal hIcls
  rw [← hclsU, ← hc, ModulusAux.classOfIdeal_finset_prod_prime_pow]
  refine Subgroup.prod_mem _ (fun q _ => Subgroup.pow_mem _ ?_ _)
  refine Subgroup.subset_closure ⟨⟨q.1, ?_⟩, rfl⟩
  exact ModulusAux.not_dvd_ideal_of_exps_eq_zero 𝔪
    (NK.NUV2.RouteB.Modulus.exps_eq_zero_of_not_mem 𝔪 q.2)

/-! ## The main theorem -/

theorem exists_modulus_and_closure {K : Type} [Field K] [NumberField K]
    (U : Subgroup (NK.GlobalCFT.Idele K)) (hU : IsOpen (U : Set (NK.GlobalCFT.Idele K)))
    (hfin : Finite (NK.GlobalCFT.IdeleClassGroup.rayClassGroup K U)) :
    ∃ 𝔪 : Ideal (NumberField.RingOfIntegers K), 𝔪 ≠ 0 ∧
      (∀ γ : NumberField.RingOfIntegers K, γ - 1 ∈ 𝔪 →
        NK.NUV2.RouteB.HeckeTheta.IsTotallyPositive γ →
        NK.HeckeL.classOfIdeal K U (Ideal.span {γ}) = 1) ∧
      (∀ 𝔭 : NK.HeckeL.PrimeIdeal K,
        NK.HeckeL.classOfIdeal K U 𝔭.asIdeal ∈
          NK.NUV2.RouteB.HeckeTheta.coprimePrimeClosure U 𝔪) := by
  obtain ⟨𝔪, hle⟩ := NK.NUV2.RouteB.RayModulus.exists_modulus_le K U hU
  refine ⟨𝔪.ideal, 𝔪.ideal_ne_zero, ?_, ?_⟩
  · intro γ hγ hpos
    have h1 : NK.HeckeL.classOfIdeal K (NK.NUV2.RouteB.CongSubgroup K 𝔪) (Ideal.span {γ})
        = 1 := classOfIdeal_span_eq_one_of_mem_ideal 𝔪 γ hγ hpos
    have h2 : NK.HeckeL.classOfIdeal K U (Ideal.span {γ}) = NK.HeckeL.classOfIdeal K U 1 :=
      ModulusAux.classOfIdeal_eq_of_le hle _ _ (h1.trans (ModulusAux.classOfIdeal_one _).symm)
    rwa [ModulusAux.classOfIdeal_one] at h2
  · intro 𝔭
    exact mem_coprimePrimeClosure_classOfIdeal U 𝔪 hle 𝔭

end NK.NUV2.RouteB.HeckeTheta
