import Mathlib
import Submission.NK.NUV2.RouteC.CommonsUnramified

/-!
# `H¹(Gal(L_q/K_Q), 𝒪_qˣ) = 0` for an unramified extension `q | Q`

This is the first rung of the canonical unramified invariant of local class field theory
(Milne, *CFT*, I.1 / III.1; Serre, *Local Fields*, Ch. XII): for a number field `K`, a finite
place `Q`, a finite Galois extension `L/K` and a place `q | Q` with ramification index one, the
units of the ring of integers of the local extension `L_q/K_Q` are a cohomologically trivial
`Gal(L_q/K_Q)`-module in degree `1`.

The file has two layers:

* `subsingleton_groupCohomology_one_of_h90` — the abstract cohomological half: for a finite cyclic
  group generated by `g` and a representation `A`, if the map `ρ(g) - 1` surjects onto the kernel of
  the norm then `H¹(G,A) = 0` (Mathlib identifies `H¹` of a finite cyclic group with the homology of
  the short complex `A --(ρ(g)-1)--> A --N--> A`);
* `subsingleton_groupCohomology_one_adicIntegersUnits_of_h90` — the same, specialised to
  `A = 𝒪_qˣ` with the *integral* Hilbert 90 as an explicit hypothesis.
-/

open IsDedekindDomain
open CategoryTheory

set_option maxHeartbeats 1600000

namespace NK.NUV2.RouteC

/-! ## Layer 1: the abstract cohomological half -/

/-- **`H¹` of a finite cyclic group, from Hilbert 90 for the representation.**

Let `G` be a finite commutative group generated by `g`, and `A : Rep k G`.  Mathlib identifies
`H¹(G,A)` with the homology of the short complex `A --(ρ(g)-1)--> A --N--> A`; if `ρ(g) - 1`
surjects onto `ker N`, that homology vanishes. -/
theorem subsingleton_groupCohomology_one_of_h90 {k G : Type} [CommRing k] [CommGroup G]
    [Fintype G] (A : Rep k G) (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    (h90 : ∀ x : A.V, A.norm.hom x = 0 →
      ∃ y : A.V, (Rep.applyAsHom A g - 𝟙 A).hom y = x) :
    Subsingleton (groupCohomology A 1) := by
  classical
  set S : CategoryTheory.ShortComplex (ModuleCat k) :=
    Rep.FiniteCyclicGroup.subCompNormHom A g with hS
  have hex : S.Exact := by
    rw [CategoryTheory.ShortComplex.moduleCat_exact_iff_ker_sub_range]
    intro x hx
    exact h90 x hx
  have hz : CategoryTheory.Limits.IsZero S.homology := by
    rw [← CategoryTheory.ShortComplex.exact_iff_isZero_homology]
    exact hex
  haveI : Subsingleton S.homology := by
    refine ⟨fun x y => ?_⟩
    have h : (𝟙 S.homology : S.homology ⟶ S.homology) = 0 :=
      (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hz
    have hx : x = 0 := by
      have hc := congrArg (fun f : S.homology ⟶ S.homology => f x) h
      simpa using hc
    have hy : y = 0 := by
      have hc := congrArg (fun f : S.homology ⟶ S.homology => f y) h
      simpa using hc
    rw [hx, hy]
  exact (Rep.FiniteCyclicGroup.groupCohomologyIsoOdd (k := k) A g hg 1
    (by norm_num)).toLinearEquiv.injective.subsingleton

/-! ## Layer 2: the specialisation to the units of the integers of the completion -/

/-- **`H¹(Gal(L_q/K_Q), 𝒪_qˣ) = 0` from the integral Hilbert 90.**

The last hypothesis is Hilbert's theorem 90 for the *integral* units: a unit of norm one is a
`(ρ(g)-1)`-coboundary.  Given it, the cohomological half (Layer 1) gives the vanishing. -/
theorem subsingleton_groupCohomology_one_adicIntegersUnits_of_h90
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hq : q.asIdeal.LiesOver Q.asIdeal)
    (h1 : q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) :
    letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
      RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
    letI : FiniteDimensional (Q.adicCompletion K) (q.adicCompletion L) :=
      Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q hq
    letI : IsGalois (Q.adicCompletion K) (q.adicCompletion L) :=
      Commons.NumberTheory.NumberField.Completion.isGalois_adicCompletion Q q hq
    letI : IsCyclic (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
      Commons.NumberTheory.NumberField.Completion.isCyclic_algEquiv_adicCompletion_of_ramificationIdx_eq_one
        Q q hq h1
    letI : CommGroup (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
      IsCyclic.commGroup
    letI : MulDistribMulAction (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L)
      (q.adicCompletionIntegers L)ˣ :=
      Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsUnitsAction Q q hq
    letI : Fintype (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
      AlgEquiv.fintype (Q.adicCompletion K) (q.adicCompletion L)
    ∀ (g : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L),
      (∀ x, x ∈ Subgroup.zpowers g) →
      (∀ u : (q.adicCompletionIntegers L)ˣ,
        (∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L, γ • u) = 1 →
        ∃ v : (q.adicCompletionIntegers L)ˣ, u = g • v / v) →
      Subsingleton (groupCohomology (Rep.of
        (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)) 1) := by
  letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
  letI hfd : FiniteDimensional (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q hq
  letI hgal : IsGalois (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isGalois_adicCompletion Q q hq
  letI hcyc : IsCyclic (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isCyclic_algEquiv_adicCompletion_of_ramificationIdx_eq_one
      Q q hq h1
  letI hcg : CommGroup (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    IsCyclic.commGroup
  letI hact : MulDistribMulAction (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L)
      (q.adicCompletionIntegers L)ˣ :=
    Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsUnitsAction Q q hq
  letI hfint : Fintype (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    AlgEquiv.fintype (Q.adicCompletion K) (q.adicCompletion L)
  intro g hg h90
  have hnorm : ∀ u : (q.adicCompletionIntegers L)ˣ,
      (Rep.of (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)).norm.hom
          (Additive.ofMul u : Additive (q.adicCompletionIntegers L)ˣ)
        = Additive.ofMul (∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L,
            γ • u) := by
    intro u
    rw [Rep.norm_apply]
    have h := Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep_norm_apply Q q hq u
    exact Additive.ofMul.injective h
  have hsub : ∀ (v : (q.adicCompletionIntegers L)ˣ),
      (Rep.applyAsHom (Rep.of (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep
          Q q hq)) g - 𝟙 (Rep.of (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep
          Q q hq))).hom (Additive.ofMul v : Additive (q.adicCompletionIntegers L)ˣ)
        = Additive.ofMul (g • v / v) := by
    intro v
    rw [Rep.sub_hom]
    show (Rep.Hom.hom (Rep.applyAsHom (Rep.of
            (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)) g))
          (Additive.ofMul v : Additive (q.adicCompletionIntegers L)ˣ) -
        (Rep.Hom.hom (𝟙 (Rep.of
            (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq))))
          (Additive.ofMul v : Additive (q.adicCompletionIntegers L)ˣ)
          = Additive.ofMul (g • v / v)
    rw [Rep.applyAsHom_apply, Rep.hom_id, Representation.IntertwiningMap.id_apply]
    show (Additive.ofMul (g • v) : Additive (q.adicCompletionIntegers L)ˣ) - Additive.ofMul v
      = Additive.ofMul (g • v / v)
    rfl
  refine subsingleton_groupCohomology_one_of_h90 _ g hg ?_
  intro x hx
  set u : (q.adicCompletionIntegers L)ˣ := Additive.toMul x with hu
  have hxu : x = Additive.ofMul u := by rw [hu]; rfl
  have hx' := hx
  rw [hxu] at hx'
  have hprod : (∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L, γ • u) = 1 := by
    rw [hnorm u] at hx'
    exact Additive.ofMul.injective (by simpa using hx')
  obtain ⟨v, hv⟩ := h90 u hprod
  refine ⟨(Additive.ofMul v : Additive (q.adicCompletionIntegers L)ˣ), ?_⟩
  rw [hsub v]
  exact congrArg Additive.ofMul hv.symm

/-! ## Layer 3: the integral Hilbert 90, by descent along the valuation -/

/-- `algebraMap` of a field extension is injective. -/
private theorem algebraMap_injective_of_field {K L : Type*} [Field K] [Field L] [Algebra K L] :
    Function.Injective (algebraMap K L) := by
  intro a b h
  by_contra hne
  have h1 : algebraMap K L (a - b) = 0 := by rw [map_sub, h, sub_self]
  have h2 : a - b ≠ 0 := sub_ne_zero.mpr hne
  have h3 : algebraMap K L (a - b) * algebraMap K L ((a - b)⁻¹) = 1 := by
    rw [← map_mul, mul_inv_cancel₀ h2, map_one]
  rw [h1, zero_mul] at h3
  exact zero_ne_one h3

/-- **The `H¹`-vanishing for the units of the integers of an unramified local extension.**

For `q | Q` with `e(q|Q) = 1`: `H¹(Gal(L_q/K_Q), 𝒪_qˣ) = 0`.

The proof is the field-level Hilbert 90 (`Commons.FieldTheory.Galois.hilbert90_cyclic`) followed by
the descent of the solution `z` to a *unit* of `𝒪_q`: since `e = 1` the value groups of `L_q` and
`K_Q` agree and both valuations are surjective onto `ℤᵐ⁰`, so `z` can be scaled by an element of
`K_Q` (which the Galois action fixes, hence leaves the coboundary relation intact) to make it have
valuation `1`. -/
theorem unramified_units_H1_vanish
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hq : q.asIdeal.LiesOver Q.asIdeal)
    (h1 : q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) :
    letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
      RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
    Subsingleton (groupCohomology (Rep.of
      (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)) 1) := by
  letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
  letI hfd : FiniteDimensional (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q hq
  letI hgal : IsGalois (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isGalois_adicCompletion Q q hq
  letI hcyc : IsCyclic (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isCyclic_algEquiv_adicCompletion_of_ramificationIdx_eq_one
      Q q hq h1
  letI hcg : CommGroup (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    IsCyclic.commGroup
  letI hact : MulDistribMulAction (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L)
      (↥(q.adicCompletionIntegers L))ˣ :=
    Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsUnitsAction Q q hq
  letI hfint : Fintype (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    AlgEquiv.fintype (Q.adicCompletion K) (q.adicCompletion L)
  -- the Galois action on the integral units is the Galois action on the field
  have hcoe : ∀ (γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L)
      (x : (q.adicCompletionIntegers L)ˣ),
      ((γ • x : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)
        = γ ((x : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L) := by
    intro γ x
    have h2 := Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep_apply_coe Q q hq γ x
    rw [show Additive.toMul
        ((Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq) γ
          (Additive.ofMul x)) = γ • x from rfl] at h2
    exact h2
  -- the ramification index in the form used by the valuation lemmas
  have he : Q.asIdeal.ramificationIdx' q.asIdeal = 1 := by
    haveI := hq
    rw [Ideal.ramificationIdx'_eq_ramificationIdx (p := Q.asIdeal) (q := q.asIdeal) Q.ne_bot]
    exact h1
  -- the valuation of `K_Q` and of `L_q` agree on `K_Q` when `e = 1`
  have hval_map : ∀ x : Q.adicCompletion K,
      Valued.v (R := q.adicCompletion L)
          (algebraMap (Q.adicCompletion K) (q.adicCompletion L) x)
        = Valued.v (R := Q.adicCompletion K) x := by
    intro x
    rw [show algebraMap (Q.adicCompletion K) (q.adicCompletion L) x
        = Commons.RingTheory.Henselian.adicCompletionMap Q q hq x from rfl,
      Commons.RingTheory.Henselian.valuation_completion_liesOver Q q hq x, he, pow_one]
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator
    (α := q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L)
  refine (subsingleton_groupCohomology_one_adicIntegersUnits_of_h90 Q q hq h1) g hg ?_
  intro u hu
  -- step 1: the field norm of `u` is one
  have hprod : (∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L,
      γ ((u : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)) = 1 := by
    let ψ : (q.adicCompletionIntegers L)ˣ →* q.adicCompletion L :=
      (algebraMap (q.adicCompletionIntegers L) (q.adicCompletion L)).toMonoidHom.comp
        (Units.coeHom (q.adicCompletionIntegers L))
    have hkey : (∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L,
        γ ((u : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L))
        = ∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L, ψ (γ • u) := by
      refine Finset.prod_congr rfl (fun γ _ => ?_)
      show γ ((u : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)
        = ((γ • u : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)
      exact (hcoe γ u).symm
    rw [hkey, ← map_prod ψ (fun γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K]
        q.adicCompletion L => γ • u) Finset.univ,
      show (∏ γ : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L, γ • u)
        = (1 : (q.adicCompletionIntegers L)ˣ) from hu, map_one]
  have hnorm : Algebra.norm (Q.adicCompletion K)
      ((u : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L) = 1 := by
    apply algebraMap_injective_of_field (K := Q.adicCompletion K) (L := q.adicCompletion L)
    rw [Algebra.norm_eq_prod_automorphisms, hprod, map_one]
  -- step 2: Hilbert 90 over the field
  have htop : Subgroup.zpowers g = ⊤ := (Subgroup.eq_top_iff' (Subgroup.zpowers g)).mpr hg
  obtain ⟨z, hz⟩ := (Commons.FieldTheory.Galois.hilbert90_cyclic
      (K := Q.adicCompletion K) (L := q.adicCompletion L) g htop
      ((u : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)).mp hnorm
  -- step 3: the descent
  obtain ⟨k, hk⟩ := Commons.RingTheory.Henselian.adicCompletion_valued_surjective Q
    (Valued.v (R := q.adicCompletion L)
      (((z : (q.adicCompletion L)ˣ) : q.adicCompletion L)⁻¹))
  set a : q.adicCompletion L := algebraMap (Q.adicCompletion K) (q.adicCompletion L) k with ha
  set w : q.adicCompletion L := ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) * a with hw
  have hz0 : ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) ≠ 0 := Units.ne_zero z
  have hvalz : Valued.v (R := q.adicCompletion L)
      ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) ≠ 0 :=
    (Valuation.ne_zero_iff (Valued.v (R := q.adicCompletion L))).mpr hz0
  have hk' : Valued.v (R := Q.adicCompletion K) k
      = (Valued.v (R := q.adicCompletion L)
          ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L))⁻¹ := by
    rw [hk, map_inv₀]
  have hwval : Valued.v (R := q.adicCompletion L) w = 1 := by
    rw [hw, map_mul, hval_map k, hk', mul_inv_cancel₀ hvalz]
  have hw0 : w ≠ 0 := by
    intro h0
    have h1 : Valued.v (R := q.adicCompletion L) w = 0 := by rw [h0, map_zero]
    rw [hwval] at h1
    exact one_ne_zero h1
  have hwmem : w ∈ q.adicCompletionIntegers L :=
    (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers (NumberField.RingOfIntegers L)
      L q).mpr (le_of_eq hwval)
  have hwmem_inv : w⁻¹ ∈ q.adicCompletionIntegers L :=
    (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers (NumberField.RingOfIntegers L)
      L q).mpr (le_of_eq (by rw [map_inv₀, hwval, inv_one]))
  let v : (q.adicCompletionIntegers L)ˣ :=
    ⟨⟨w, hwmem⟩, ⟨w⁻¹, hwmem_inv⟩,
      Subtype.ext (by
        change w * w⁻¹ = (1 : q.adicCompletion L)
        exact mul_inv_cancel₀ hw0),
      Subtype.ext (by
        change w⁻¹ * w = (1 : q.adicCompletion L)
        exact inv_mul_cancel₀ hw0)⟩
  refine ⟨v, ?_⟩
  have hvcoe : ((v : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L) = w := rfl
  have hgv : ((g • v : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L) = g w := by
    rw [hcoe g v, hvcoe]
  have hga : g a = a := AlgEquiv.commutes g k
  have hgw : g w = g ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) * a := by
    rw [hw, map_mul, hga]
  have ha0 : a ≠ 0 := by
    intro h0
    have h1 : Valued.v (R := q.adicCompletion L) 0 = 1 := by
      rw [← hwval, hw, h0, mul_zero]
    rw [map_zero] at h1
    exact one_ne_zero h1.symm
  have harith : g ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) /
        ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L)
      = g ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) * a *
        (((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) * a)⁻¹ := by
    rw [div_eq_mul_inv, mul_inv_rev,
      mul_assoc (g ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L)) a
        (a⁻¹ * (((z : (q.adicCompletion L)ˣ) : q.adicCompletion L))⁻¹),
      ← mul_assoc a a⁻¹ (((z : (q.adicCompletion L)ˣ) : q.adicCompletion L))⁻¹,
      mul_inv_cancel₀ ha0, one_mul]
  have hvdiv : ((g • v / v : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)
      = (g ((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) * a) *
        (((z : (q.adicCompletion L)ˣ) : q.adicCompletion L) * a)⁻¹ := by
    rw [show ((g • v / v : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L)
        = ((g • v : (q.adicCompletionIntegers L)ˣ) : q.adicCompletion L) *
          (((v : (q.adicCompletionIntegers L)ˣ))⁻¹ : q.adicCompletion L) from rfl,
      hgv, hvcoe, hgw, hw]
  apply Units.ext
  apply Subtype.ext
  rw [hvdiv, hz]
  exact harith

/-! ## The bundled vanishing: `H^i(Gal(L_q/K_Q), 𝒪_qˣ) = 0` for `i = 1, 2, 3`

The three degrees together are the cohomological input of the canonical unramified invariant: the
cohomology of the valuation sequence `1 → 𝒪_qˣ → L_qˣ →^{ord} ℤ → 0`.  Degree `1` is
`unramified_units_H1_vanish` (this file); degree `2` is the commons'
`subsingleton_groupCohomology_two_adicIntegersUnits_of_ramificationIdx_eq_one`; degree `3` follows
from the two by the two-periodicity of the cohomology of a finite cyclic group
(`Commons…groupCohomology_subsingleton_of_isCyclic_of_H1_H2`). -/
theorem unramified_units_vanish
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hq : q.asIdeal.LiesOver Q.asIdeal)
    (h1 : q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) :
    letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
      RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
    Subsingleton (groupCohomology (Rep.of
        (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)) 1) ∧
      Subsingleton (groupCohomology (Rep.of
        (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)) 2) ∧
      Subsingleton (groupCohomology (Rep.of
        (Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsRep Q q hq)) 3) := by
  letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
  haveI hfd : FiniteDimensional (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q hq
  haveI hgal : IsGalois (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isGalois_adicCompletion Q q hq
  haveI hact : MulDistribMulAction (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L)
      (↥(q.adicCompletionIntegers L))ˣ :=
    Commons.NumberTheory.NumberField.Completion.adicIntegersUnitsUnitsAction Q q hq
  haveI hfint : Fintype (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
    AlgEquiv.fintype (Q.adicCompletion K) (q.adicCompletion L)
  haveI hcyc : IsCyclic (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L) :=
