import Mathlib
import Submission.NK.LocalTame.IndexPrime.Basic

/-!
# Index-`ℓ` normal subgroups of a compact group with finite `ℓ`-Frattini index are open

Let `M` be a compact Hausdorff topological group, `ℓ` a prime, and suppose that the subgroup

  `N = ⟨{m ^ ℓ : m ∈ M} ∪ {⁅x, y⁆ : x, y ∈ M}⟩ = [M, M] · M ^ ℓ`

generated by the `ℓ`-th powers and the commutators has *finite* index in `M`.  Then every normal
subgroup `P ≤ M` of index `ℓ` is open.

## The proof

`N` is the subgroup generated by the *compact* set `A` of all `ℓ`-th powers and commutators of
`M`, hence it is the union of the compact sets `A ^ k` (`k`-fold pointwise products).  Since `N`
has finite index, `M` is covered by the countably many sets `g · A ^ k`, where `g` runs through
a finite set of coset representatives of `N` in `M`; each of them is compact.  A Baire category
argument (a compact Hausdorff space is a Baire space) shows that one of them has non-empty
interior, so `A ^ k` has non-empty interior for some `k`; then

  `u • (interior (A ^ k))⁻¹`

is an open neighbourhood of `1` contained in `N`, so `N` is open.  Finally `P`, being a union of
cosets of `N`, is open as well.

Note that no structure theory of compact groups is used: the point of the hypothesis is that `N`
is *geometrically small* (generated by a compact set), and this is exactly what rules out the
classical obstruction to "finite index ⟹ open" (a dense finite-index subgroup of a compact
group is not open if it is not closed).
-/

set_option linter.style.haveILetI false

namespace NK.LocalTame
namespace IndexRedo

open scoped Pointwise commutatorElement

open Subgroup

/-- A subgroup of a group generated by a set `A` with `A⁻¹ = A` is the union of the pointwise
powers of `A`. -/
theorem closure_eq_iUnion_pow {M : Type*} [Group M] {A : Set M} (hinv : A⁻¹ = A) :
    (Subgroup.closure A : Set M) = ⋃ k : ℕ, A ^ k := by
  have h1set : (1 : Set M)⁻¹ = 1 := by ext y; simp [Set.mem_one]
  have hpow_sub : ∀ k : ℕ, (A ^ k : Set M) ⊆ (Subgroup.closure A : Set M) := by
    intro k
    induction k with
    | zero =>
      intro x hx
      rw [pow_zero, Set.mem_one] at hx
      rw [hx]
      exact Subgroup.one_mem _
    | succ k ih =>
      intro x hx
      rw [pow_succ] at hx
      rcases Set.mem_mul.mp hx with ⟨a, ha, b, hb, rfl⟩
      exact (Subgroup.closure A).mul_mem (ih ha) (Subgroup.subset_closure hb)
  have hsym : ∀ k : ℕ, (A ^ k : Set M)⁻¹ ⊆ A ^ k := by
    intro k
    induction k with
    | zero =>
      intro x hx
      simpa [pow_zero, h1set] using hx
    | succ k ih =>
      intro x hx
      rw [Set.mem_inv] at hx
      rw [pow_succ] at hx
      rcases Set.mem_mul.mp hx with ⟨a, ha, b, hb, hab⟩
      rw [pow_succ']
      rw [show x = b⁻¹ * a⁻¹ by rw [← inv_inv x, ← hab, mul_inv_rev]]
      refine Set.mul_mem_mul ?_ ?_
      · show b⁻¹ ∈ A
        rw [← hinv]
        exact Set.inv_mem_inv.mpr hb
      · exact ih (by simpa using ha)
  have hsub : ∀ k : ℕ, (A ^ k : Set M)⁻¹ = A ^ k := fun k =>
    le_antisymm (hsym k)
      ((Set.inv_subset (s := (A ^ k : Set M)) (t := (A ^ k : Set M))).mp (hsym k))
  have hmul : ∀ x ∈ (⋃ k : ℕ, (A ^ k : Set M)), ∀ y ∈ (⋃ k : ℕ, (A ^ k : Set M)),
      x * y ∈ (⋃ k : ℕ, (A ^ k : Set M)) := by
    intro x hx y hy
    rcases Set.mem_iUnion.mp hx with ⟨i, hi⟩
    rcases Set.mem_iUnion.mp hy with ⟨j, hj⟩
    exact Set.mem_iUnion.mpr ⟨i + j, by rw [pow_add]; exact Set.mul_mem_mul hi hj⟩
  have hone : (1 : M) ∈ (⋃ k : ℕ, (A ^ k : Set M)) := by
    refine Set.mem_iUnion.mpr ⟨0, ?_⟩
    rw [pow_zero, Set.mem_one]
  have hinvm : ∀ x ∈ (⋃ k : ℕ, (A ^ k : Set M)), x⁻¹ ∈ (⋃ k : ℕ, (A ^ k : Set M)) := by
    intro x hx
    rcases Set.mem_iUnion.mp hx with ⟨k, hk⟩
    refine Set.mem_iUnion.mpr ⟨k, ?_⟩
    show x⁻¹ ∈ A ^ k
    rw [← hsub k]
    exact Set.inv_mem_inv.mpr hk
  refine le_antisymm ?_ (Set.iUnion_subset hpow_sub)
  intro x hx
  refine Subgroup.closure_induction (p := fun g _ => g ∈ (⋃ k : ℕ, (A ^ k : Set M)))
    (fun a ha => ?_) hone ?_ (fun a _ ha => hinvm a ha) hx
  · exact Set.mem_iUnion.mpr ⟨1, by rw [pow_one]; exact ha⟩
  · intro a b _ _ ha hb
    exact hmul a ha b hb

theorem isOpen_of_index_prime_of_frattini_index {M : Type*} [Group M] [TopologicalSpace M]
    [IsTopologicalGroup M] [CompactSpace M] [T2Space M] {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hfin : (IndexPrime.powSub ℓ M ⊔ commutator M).index ≠ 0)
    (P : Subgroup M) (hP : P.Normal) (hPi : P.index = ℓ) : IsOpen (P : Set M) := by
  haveI : P.Normal := hP
  set N : Subgroup M := IndexPrime.powSub ℓ M ⊔ commutator M with hNdef
  -- `N` is contained in `P`
  have hNP : N ≤ P := by
    rw [hNdef]
    exact sup_le (IndexPrime.powSub_le_of_index_eq_prime hPi)
      (IndexPrime.commutator_le_of_index_eq_prime hℓ hPi)
  -- the compact generating set `A`
  set S : Set M := Set.range fun m : M => m ^ ℓ with hS
  set C : Set M := Set.range fun p : M × M => ⁅p.1, p.2⁆ with hC
  set A : Set M := S ∪ C with hA
  have hScompact : IsCompact S := by
    rw [hS]; exact isCompact_range (continuous_pow ℓ)
  have hcontC : Continuous fun p : M × M => p.1 * p.2 * p.1⁻¹ * p.2⁻¹ := by fun_prop
  have hCcompact : IsCompact C := by
    rw [hC]
    exact isCompact_range (by simpa only [commutatorElement_def] using hcontC)
  have hAcompact : IsCompact A := by
    rw [hA]; exact hScompact.union hCcompact
  have hSinv : S⁻¹ = S := by
    ext x
    simp only [hS, Set.mem_inv, Set.mem_range]
    constructor
    · rintro ⟨m, hm⟩
      exact ⟨m⁻¹, by rw [inv_pow, hm, inv_inv]⟩
    · rintro ⟨m, rfl⟩
      exact ⟨m⁻¹, inv_pow m ℓ⟩
  have hCinv : C⁻¹ = C := by
    ext x
    simp only [hC, Set.mem_inv, Set.mem_range]
    constructor
    · rintro ⟨p, hp⟩
      refine ⟨(p.2, p.1), ?_⟩
      show ⁅p.2, p.1⁆ = x
      rw [← commutatorElement_inv p.1 p.2, hp, inv_inv]
    · rintro ⟨p, rfl⟩
      exact ⟨(p.2, p.1), (commutatorElement_inv p.1 p.2).symm⟩
  have hAinv : A⁻¹ = A := by rw [hA, Set.union_inv, hSinv, hCinv]
  -- the subgroup generated by `A` is `N`
  have hSclosure : Subgroup.closure S = IndexPrime.powSub ℓ M := by
    rw [hS, IndexPrime.powSub]
  have hCclosure : Subgroup.closure C = commutator M := by
    rw [hC, commutator_eq_closure]
    congr 1
    ext x
    simp only [Set.mem_range, commutatorSet_def, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨p, rfl⟩
      exact ⟨p.1, p.2, rfl⟩
    · rintro ⟨g₁, g₂, rfl⟩
      exact ⟨(g₁, g₂), rfl⟩
  have hclosure : Subgroup.closure A = N := by
    rw [hA, Subgroup.closure_union, hSclosure, hCclosure, hNdef]
  have hNunion : (N : Set M) = ⋃ k : ℕ, A ^ k := by
    rw [← hclosure, closure_eq_iUnion_pow hAinv]
  -- `A ^ k ⊆ N` and `A ^ k` compact
  have hS_le : S ⊆ (N : Set M) := by
    rw [hNdef, hS]
    rintro x ⟨m, rfl⟩
    exact Subgroup.mem_sup_left (IndexPrime.mem_powSub m)
  have hC_le : C ⊆ (N : Set M) := by
    rw [hNdef, hC]
    rintro x ⟨p, rfl⟩
    exact Subgroup.mem_sup_right
      (Subgroup.subset_closure ⟨p.1, Subgroup.mem_top _, p.2, Subgroup.mem_top _, rfl⟩)
  have hA_N : A ⊆ (N : Set M) := by
    rw [hA]; exact Set.union_subset hS_le hC_le
  have hA_le_N : ∀ k : ℕ, (A ^ k : Set M) ⊆ (N : Set M) := by
    intro k
    induction k with
    | zero =>
      intro x hx
      rw [pow_zero, Set.mem_one] at hx
      rw [hx]
      exact N.one_mem
    | succ k ih =>
      intro x hx
      rw [pow_succ] at hx
      rcases Set.mem_mul.mp hx with ⟨a, ha, b, hb, rfl⟩
      exact N.mul_mem (ih ha) (hA_N hb)
  have hAcompact_pow : ∀ k : ℕ, IsCompact (A ^ k : Set M) := by
    intro k
    induction k with
    | zero => rw [pow_zero]; exact isCompact_singleton
    | succ k ih => rw [pow_succ]; exact ih.mul hAcompact
  -- `N` has finite index, so `M ⧸ N` is finite
  haveI hFinQ : Finite (M ⧸ N) := by
    rw [Subgroup.index_eq_card] at hfin
    exact (Nat.card_ne_zero.mp hfin).2
  haveI : Countable (M ⧸ N) := inferInstance
  -- coset representatives
  let σ : M ⧸ N → M := fun q => Classical.choose (QuotientGroup.mk_surjective q)
  have hσ : ∀ q : M ⧸ N, QuotientGroup.mk (σ q) = q :=
    fun q => Classical.choose_spec (QuotientGroup.mk_surjective q)
  let f : (M ⧸ N) × ℕ → Set M := fun i => σ i.1 • (A ^ i.2 : Set M)
  have hfclosed : ∀ i, IsClosed (f i) := by
    intro i
    exact ((hAcompact_pow i.2).smul (σ i.1)).isClosed
  have hfcover : (⋃ i, f i : Set M) = Set.univ := by
    ext m
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    let q : M ⧸ N := QuotientGroup.mk m
    have hmN : m ∈ (σ q) • (N : Set M) := by
      have hq : QuotientGroup.mk (σ q) = QuotientGroup.mk m := hσ q
      have hmem : (σ q)⁻¹ * m ∈ N := QuotientGroup.eq.mp hq
      refine Set.mem_smul_set.mpr ⟨(σ q)⁻¹ * m, hmem, ?_⟩
      rw [smul_eq_mul, mul_inv_cancel_left]
    rw [hNunion, Set.smul_set_iUnion] at hmN
    rcases Set.mem_iUnion.mp hmN with ⟨k, hk⟩
    exact ⟨(q, k), hk⟩
  -- Baire
  obtain ⟨i, hi⟩ := nonempty_interior_of_iUnion_of_closed hfclosed hfcover
  obtain ⟨w, hw⟩ := hi
  -- `A ^ k` has an interior point
  have hAi : (interior (A ^ i.2 : Set M)).Nonempty := by
    refine ⟨(σ i.1)⁻¹ * w, ?_⟩
    have hopen : IsOpen ((fun x => (σ i.1)⁻¹ * x) '' interior (f i)) :=
      (Homeomorph.mulLeft (σ i.1)⁻¹).isOpenMap _ isOpen_interior
    have hsub : (fun x => (σ i.1)⁻¹ * x) '' interior (f i) ⊆ (A ^ i.2 : Set M) := by
      rintro y ⟨x, hx, rfl⟩
      have hx' : x ∈ (σ i.1) • (A ^ i.2 : Set M) := interior_subset hx
      obtain ⟨z, hz, rfl⟩ := Set.mem_smul_set.mp hx'
      show (σ i.1)⁻¹ * (σ i.1 * z) ∈ (A ^ i.2 : Set M)
      rw [← mul_assoc, inv_mul_cancel, one_mul]
      exact hz
    exact interior_maximal hsub hopen ⟨w, hw, rfl⟩
  obtain ⟨u, hu⟩ := hAi
  -- `1` is an interior point of `N`
  have h1N : (1 : M) ∈ interior (N : Set M) := by
    have hopen : IsOpen (u • ((interior (A ^ i.2 : Set M))⁻¹)) :=
      isOpen_interior.inv.smul u
    have hsub : u • ((interior (A ^ i.2 : Set M))⁻¹) ⊆ (N : Set M) := by
      rintro y ⟨z, hz, rfl⟩
      have hz' : z⁻¹ ∈ interior (A ^ i.2 : Set M) := Set.mem_inv.mp hz
      show u * z ∈ (N : Set M)
      exact N.mul_mem (hA_le_N i.2 (interior_subset hu))
        (by simpa using N.inv_mem (hA_le_N i.2 (interior_subset hz')))
    refine interior_maximal hsub hopen ?_
    refine Set.mem_smul_set.mpr ⟨u⁻¹, ?_, ?_⟩
    · exact Set.mem_inv.mpr (by simpa using hu)
    · rw [smul_eq_mul, mul_inv_cancel]
  have hNopen : IsOpen (N : Set M) := Subgroup.isOpen_of_one_mem_interior N h1N
  exact Subgroup.isOpen_mono hNP hNopen

end IndexRedo
end NK.LocalTame
