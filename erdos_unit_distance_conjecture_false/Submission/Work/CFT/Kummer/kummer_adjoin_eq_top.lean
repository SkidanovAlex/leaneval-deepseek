import Mathlib
import Submission.Work.CFT.Kummer.Defs

/-!
# Kummer theory: `L = K(ᵖ√Δ)` for abelian `L/K` of exponent `p`

Let `K` be a field containing a primitive `p`-th root of unity `ζ` (`p` prime) and let `L/K` be a
finite Galois extension whose Galois group is abelian of exponent dividing `p` (hypotheses `hexp`
and `hab`).  Writing

* `Δ = Lˣ^p ∩ Kˣ` for the group of *Kummer generators* (`Work.CFT.Kummer.kummerGenerators`),
* `S = {x ∈ L | x ^ p ∈ Kˣ}` for the set of `p`-th roots of elements of `K`,

the Kummer correspondence says that `L` is generated over `K` by `S`:

`Work.CFT.Kummer.kummer_adjoin_eq_top` — `IntermediateField.adjoin K S = ⊤`.

Equivalently, every element of `L` is a `K`-linear combination of `p`-th roots of elements of `K`.

## Proof strategy

Let `E = K(S)` be the subfield generated by `S`.  By the fundamental theorem of Galois theory it
suffices to show `Gal(L/E) = ⊥`: if `σ ∈ Gal(L/K)` fixes `S` pointwise then `σ = 1`.

Suppose `σ ≠ 1`.  Since `G = Gal(L/K)` is a finite abelian group of exponent dividing `p`, it is a
finite-dimensional `𝔽_p`-vector space (`𝔽_p`-module structure on `Additive G`), so there is a
character `χ : G →* μ_p(L)` with `χ σ ≠ 1` (`exists_char_rootsOfUnity_ne_one`, proved with a basis
of `Additive G` over `ZMod p`).  The *Lagrange resolvent* attached to `χ`
(`exists_resolvent`, an instance of Hilbert 90 / Dedekind's linear independence of characters)
produces `α ∈ Lˣ` with `τ α = χ τ · α` for every `τ ∈ G`.  Then `α ^ p` is fixed by all of `G`,
hence lies in `K`, so `α ∈ S ⊆ E`; but `σ α = χ σ · α ≠ α`, since `α ≠ 0` and `χ σ ≠ 1`.
This contradiction shows `σ = 1`, and `E = ⊤` follows.
-/

open scoped Classical

set_option linter.style.haveILetI false

noncomputable section

namespace Work.CFT.Kummer

/-- **Characters separate points.**  Let `G` be a finite abelian group of exponent dividing the
prime `p` (hypotheses `hab`, `hexp`) and let `ζ` be a primitive `p`-th root of unity in a field
`F`.  Then for every `σ ≠ 1` in `G` there is a monoid homomorphism `χ : G →* rootsOfUnity p F`
(the Kummer character) with `χ σ ≠ 1`.

Proof: `Additive G` is a finite-dimensional vector space over the field `ZMod p`; a nonzero
element survives some coordinate functional `φ` of a basis, and `χ τ = ζ ^ (φ τ).val` is a
character because `ζ ^ p = 1`. -/
theorem exists_char_rootsOfUnity_ne_one (p : ℕ) (hp : p.Prime) {G : Type*} [Group G] [Fintype G]
    (hexp : ∀ σ : G, σ ^ p = 1) (hab : ∀ σ τ : G, σ * τ = τ * σ)
    {F : Type*} [Field F] (ζ : Fˣ) (hζ : IsPrimitiveRoot ζ p) {σ : G} (hσ : σ ≠ 1) :
    ∃ χ : G →* rootsOfUnity p F, χ σ ≠ 1 := by
  letI : CommGroup G := { ‹Group G› with mul_comm := hab }
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  -- `Additive G` as an `𝔽_p`-vector space (every element has order dividing `p`).
  haveI : Module (ZMod p) (Additive G) :=
    AddCommGroup.zmodModule (fun x => by
      obtain ⟨σ, rfl⟩ := Additive.ofMul.surjective x
      rw [← ofMul_pow, hexp σ]
      rfl)
  -- Powers of `ζ` only depend on the exponent modulo `p`.
  have key : ∀ m : ℕ, ζ ^ (m % p) = ζ ^ m := by
    intro m
    conv_rhs => rw [← Nat.mod_add_div m p]
    rw [pow_add, pow_mul, hζ.pow_eq_one, one_pow, mul_one]
  have hx : (Additive.ofMul σ : Additive G) ≠ 0 := by
    intro h
    refine hσ (Additive.ofMul.injective ?_)
    simpa using h
  -- A coordinate functional that does not vanish at `σ`.
  let b := Module.Basis.ofVectorSpace (ZMod p) (Additive G)
  obtain ⟨i, hi⟩ : ∃ i, b.coord i (Additive.ofMul σ) ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hx ((Module.Basis.forall_coord_eq_zero_iff b).mp h)
  let φ : Additive G →ₗ[ZMod p] ZMod p := b.coord i
  have hφσ : φ (Additive.ofMul σ) ≠ 0 := hi
  let χfn : G → Fˣ := fun τ => ζ ^ (φ (Additive.ofMul τ)).val
  have hχmul : ∀ τ₁ τ₂ : G, χfn (τ₁ * τ₂) = χfn τ₁ * χfn τ₂ := by
    intro τ₁ τ₂
    show ζ ^ (φ (Additive.ofMul (τ₁ * τ₂))).val
        = ζ ^ (φ (Additive.ofMul τ₁)).val * ζ ^ (φ (Additive.ofMul τ₂)).val
    rw [ofMul_mul, map_add, ZMod.val_add, key, pow_add]
  have hχone : χfn 1 = 1 := by
    show ζ ^ (φ (Additive.ofMul (1 : G))).val = 1
    simp [ZMod.val_zero]
  let χ : G →* rootsOfUnity p F :=
    { toFun := fun τ => ⟨χfn τ, by
        rw [mem_rootsOfUnity]
        show (ζ ^ (φ (Additive.ofMul τ)).val) ^ p = 1
        rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]⟩
      map_one' := Subtype.ext hχone
      map_mul' := fun τ₁ τ₂ => Subtype.ext (hχmul τ₁ τ₂) }
  refine ⟨χ, ?_⟩
  intro h
  have h1 : ((χfn σ : Fˣ) : F) = 1 := by
    have := congrArg (fun u : rootsOfUnity p F => ((u : Fˣ) : F)) h
    simpa [χ, χfn] using this
  have h2 : χfn σ = 1 := Units.val_eq_one.mp h1
  have h3 : ζ ^ (φ (Additive.ofMul σ)).val = 1 := by simpa [χfn] using h2
  rw [hζ.pow_eq_one_iff_dvd] at h3
  exact hφσ ((ZMod.val_eq_zero _).mp (Nat.eq_zero_of_dvd_of_lt h3 (ZMod.val_lt _)))

/-- **Lagrange resolvent (Hilbert 90).**  Let `L/K` be a finite Galois extension and let `K`
contain a primitive `p`-th root of unity `ζ` (`p` prime).  Then every character
`χ : Gal(L/K) →* μ_p(L)` with values in the group of `p`-th roots of unity has a *resolvent*:
there is `α ∈ Lˣ` with `σ α = χ σ · α` for all `σ ∈ Gal(L/K)`.

The key points are that every `p`-th root of unity in `L` lies in (the image of) `K`, hence is
fixed by every `K`-automorphism of `L` — this is where `hζ` is used — and Dedekind's linear
independence of the automorphisms `L →ₐ[K] L`, which shows that the resolvent
`∑_τ χ(τ)⁻¹ · τ(c)` is nonzero for a suitable `c ∈ L`. -/
theorem exists_resolvent (p : ℕ) (hp : p.Prime) {K L : Type*} [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (ζ : Kˣ) (hζ : IsPrimitiveRoot ζ p)
    (χ : (L ≃ₐ[K] L) →* rootsOfUnity p L) :
    ∃ α : Lˣ, ∀ σ : L ≃ₐ[K] L,
      Units.map σ.toRingEquiv.toMonoidHom α = (χ σ : Lˣ) * α := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  -- The image of `ζ` in `L` is again a primitive `p`-th root of unity.
  let ζL : Lˣ := Units.map (algebraMap K L).toMonoidHom ζ
  have hζL : IsPrimitiveRoot ζL p :=
    hζ.map_of_injective (Units.map_injective (RingHom.injective (algebraMap K L)))
  have map_K : ∀ (σ : L ≃ₐ[K] L) (c : Kˣ),
      Units.map σ.toRingEquiv.toMonoidHom (Units.map (algebraMap K L).toMonoidHom c)
        = Units.map (algebraMap K L).toMonoidHom c := by
    intro σ c
    apply Units.ext
    simp only [Units.coe_map]
    exact AlgEquiv.commutes σ (c : K)
  -- Every `p`-th root of unity in `L` is a power of `ζL`, hence fixed by `Gal(L/K)`.
  have fix_ru : ∀ (σ : L ≃ₐ[K] L) {ω : Lˣ}, ω ∈ rootsOfUnity p L →
      σ ((ω : Lˣ) : L) = ((ω : Lˣ) : L) := by
    intro σ ω hω
    obtain ⟨i, -, hi⟩ := hζL.eq_pow_of_mem_rootsOfUnity hω
    rw [← hi, Units.val_pow_eq_pow_val, map_pow]
    congr 1
    simp [ζL, Units.coe_map]
  let χv : (L ≃ₐ[K] L) →* Lˣ := (rootsOfUnity p L).subtype.comp χ
  have hχv_mem : ∀ σ : L ≃ₐ[K] L, χv σ ∈ rootsOfUnity p L := fun σ => (χ σ).2
  -- Dedekind's lemma: the elements of `Gal(L/K)`, as `K`-linear maps, are linearly independent
  -- over `L`.
  have hli : LinearIndependent L (fun σ : L ≃ₐ[K] L => (σ.toAlgHom).toLinearMap) :=
    (linearIndependent_toLinearMap K L L).comp (fun σ : L ≃ₐ[K] L => σ.toAlgHom)
      AlgEquiv.coe_toAlgHom_injective
  -- Hence the resolvent is not identically zero.
  have hex : ∃ c : L, (∑ σ : L ≃ₐ[K] L, ((χv σ : Lˣ) : L)⁻¹ * σ c) ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    have hzero : (∑ σ : L ≃ₐ[K] L, ((χv σ : Lˣ) : L)⁻¹ • (σ.toAlgHom).toLinearMap) = 0 := by
      ext x
      simpa [LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul] using h x
    have hcoef := (Fintype.linearIndependent_iff.mp hli) (fun σ => ((χv σ : Lˣ) : L)⁻¹) hzero
    have h1 := hcoef 1
    have hone : ((χv 1 : Lˣ) : L)⁻¹ = (1 : L) := by rw [map_one χv, Units.val_one, inv_one]
    rw [hone] at h1
    exact one_ne_zero h1
  obtain ⟨c₀, hc₀⟩ := hex
  let α : Lˣ := Units.mk0 (∑ σ : L ≃ₐ[K] L, ((χv σ : Lˣ) : L)⁻¹ * σ c₀) hc₀
  have hα : (α : L) = ∑ σ : L ≃ₐ[K] L, ((χv σ : Lˣ) : L)⁻¹ * σ c₀ := Units.val_mk0 hc₀
  -- The resolvent is an eigenvector of every `σ` with eigenvalue `χ σ`.
  have hσ' : ∀ σ : L ≃ₐ[K] L, Units.map σ.toRingEquiv.toMonoidHom α = χv σ * α := by
    intro σ
    apply Units.ext
    rw [Units.coe_map, Units.val_mul, hα]
    show σ (∑ τ : L ≃ₐ[K] L, ((χv τ : Lˣ) : L)⁻¹ * τ c₀)
      = ((χv σ : Lˣ) : L) * ∑ τ : L ≃ₐ[K] L, ((χv τ : Lˣ) : L)⁻¹ * τ c₀
    have hsum : σ (∑ τ : L ≃ₐ[K] L, ((χv τ : Lˣ) : L)⁻¹ * τ c₀)
        = ∑ τ : L ≃ₐ[K] L, ((χv τ : Lˣ) : L)⁻¹ * (σ * τ) c₀ := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun τ _ => ?_
      have hfix := fix_ru σ (hχv_mem τ)
      rw [map_mul, map_inv₀, hfix, ← AlgEquiv.mul_apply]
    rw [hsum]
    have hreindex : (∑ τ : L ≃ₐ[K] L, ((χv τ : Lˣ) : L)⁻¹ * (σ * τ) c₀)
        = ∑ ρ : L ≃ₐ[K] L, ((χv (σ⁻¹ * ρ) : Lˣ) : L)⁻¹ * ρ c₀ := by
      rw [← Equiv.sum_comp (Equiv.mulLeft σ)
        (fun ρ : L ≃ₐ[K] L => ((χv (σ⁻¹ * ρ) : Lˣ) : L)⁻¹ * ρ c₀)]
      refine Finset.sum_congr rfl fun τ _ => ?_
      show ((χv τ : Lˣ) : L)⁻¹ * (σ * τ) c₀
        = ((χv (σ⁻¹ * (σ * τ)) : Lˣ) : L)⁻¹ * (σ * τ) c₀
      rw [inv_mul_cancel_left]
    rw [hreindex]
    have hcoef : ∀ ρ : L ≃ₐ[K] L,
        ((χv (σ⁻¹ * ρ) : Lˣ) : L)⁻¹
          = ((χv σ : Lˣ) : L) * ((χv ρ : Lˣ) : L)⁻¹ := by
      intro ρ
      have h1 : ((χv (σ⁻¹ * ρ) : Lˣ) : L)
          = ((χv σ : Lˣ) : L)⁻¹ * ((χv ρ : Lˣ) : L) := by
        rw [map_mul, map_inv]
        simp
      rw [h1, mul_inv_rev, inv_inv]
      exact mul_comm _ _
    rw [Finset.sum_congr rfl fun ρ _ => by rw [hcoef ρ]]
    rw [show (∑ ρ : L ≃ₐ[K] L,
            ((χv σ : Lˣ) : L) * ((χv ρ : Lˣ) : L)⁻¹ * ρ c₀)
          = ∑ ρ : L ≃ₐ[K] L,
            ((χv σ : Lˣ) : L) * (((χv ρ : Lˣ) : L)⁻¹ * ρ c₀) from
        Finset.sum_congr rfl fun ρ _ => mul_assoc _ _ _, Finset.mul_sum]
  exact ⟨α, fun σ => by simpa [χv] using hσ' σ⟩

/-- **Kummer theory.**  Let `K` be a field containing a primitive `p`-th root of unity (`p` prime)
and let `L/K` be a finite Galois extension whose Galois group is abelian of exponent dividing `p`.
Then `L` is generated over `K` by the `p`-th roots of the elements of `K` that are `p`-th powers
in `L`:

`IntermediateField.adjoin K {x : L | ∃ b ∈ Lˣ^p ∩ Kˣ, x ^ p = b} = ⊤`.

Equivalently, for every abelian extension `L/K` of exponent `p` there are
`d₁, …, d_r ∈ Kˣ` with `L = K(ᵖ√d₁, …, ᵖ√d_r)`, and the classes of the `dᵢ` in `Kˣ/Kˣ^p` are
`𝔽_p`-linearly independent only when the corresponding roots are (Kummer duality). -/
theorem kummer_adjoin_eq_top (p : ℕ) (hp : p.Prime) {K L : Type*} [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (ζ : Kˣ) (hζ : IsPrimitiveRoot ζ p)
    (hexp : ∀ σ : L ≃ₐ[K] L, σ ^ p = 1) (hab : ∀ σ τ : L ≃ₐ[K] L, σ * τ = τ * σ) :
    IntermediateField.adjoin K {x : L | ∃ b : Work.CFT.Kummer.kummerGenerators K L p,
        x ^ p = algebraMap K L ((b : Kˣ) : K)} = ⊤ := by
  set S : Set L := {x : L | ∃ b : kummerGenerators K L p,
        x ^ p = algebraMap K L ((b : Kˣ) : K)} with hS
  -- It suffices to show that the only automorphism fixing `K(S)` pointwise is `1`.
  have hfix : (IntermediateField.adjoin K S).fixingSubgroup = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro σ hσ
    by_contra hσne
    let ζL : Lˣ := Units.map (algebraMap K L).toMonoidHom ζ
    have hζL : IsPrimitiveRoot ζL p :=
      hζ.map_of_injective (Units.map_injective (RingHom.injective (algebraMap K L)))
    -- A character of `Gal(L/K)` that does not vanish at `σ`, and its resolvent `α`.
    obtain ⟨χ, hχ⟩ := exists_char_rootsOfUnity_ne_one p hp hexp hab ζL hζL hσne
    obtain ⟨α, hα⟩ := exists_resolvent p hp ζ hζ χ
    have hσfix : ∀ x ∈ IntermediateField.adjoin K S, σ x = x :=
      (IntermediateField.mem_fixingSubgroup_iff (IntermediateField.adjoin K S) σ).mp hσ
    -- `α ^ p` is fixed by all of `Gal(L/K)`, hence lies in `K`.
    have hfixp : ∀ τ : L ≃ₐ[K] L, τ ((α : L) ^ p) = (α : L) ^ p := by
      intro τ
      have hval : τ (α : L) = (((χ τ : rootsOfUnity p L) : Lˣ) : L) * (α : L) := by
        have := congrArg (fun u : Lˣ => (u : L)) (hα τ)
        simpa [Units.coe_map, Units.val_mul] using this
      have hpow1 : (((χ τ : rootsOfUnity p L) : Lˣ) : L) ^ p = 1 := by
        have hmem := (χ τ).2
        rw [mem_rootsOfUnity] at hmem
        simpa [Units.val_pow_eq_pow_val] using congrArg (fun u : Lˣ => (u : L)) hmem
      rw [map_pow, hval, mul_pow, hpow1, one_mul]
    obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp ((IsGalois.mem_bot_iff_fixed _).mpr hfixp)
    have ha0 : a ≠ 0 := by
      intro h0
      have hz : (α : L) ^ p = 0 := by rw [← ha, h0, map_zero]
      exact (pow_ne_zero p (Units.ne_zero α)) hz
    -- So `α` is a `p`-th root of the element `a ∈ Kˣ`, i.e. `α ∈ K(S)`.
    have hd : Units.mk0 a ha0 ∈ kummerGenerators K L p := by
      refine mem_pthPowerSubgroup.mpr ⟨α, ?_⟩
      apply Units.ext
      rw [Units.coe_map, Units.val_mk0, Units.val_pow_eq_pow_val]
      exact ha.symm
    have hαS : (α : L) ∈ S := ⟨⟨Units.mk0 a ha0, hd⟩, by simpa using ha.symm⟩
    have hαfix : σ (α : L) = (α : L) := hσfix _ (IntermediateField.subset_adjoin K S hαS)
    -- But `σ α = χ σ · α ≠ α`, a contradiction.
    have hval : σ (α : L) = (((χ σ : rootsOfUnity p L) : Lˣ) : L) * (α : L) := by
      have := congrArg (fun u : Lˣ => (u : L)) (hα σ)
      simpa [Units.coe_map, Units.val_mul] using this
    refine hχ ?_
    have key : (((χ σ : rootsOfUnity p L) : Lˣ) : L) * (α : L) = (α : L) := by
      rw [← hval, hαfix]
    have key2 : (((χ σ : rootsOfUnity p L) : Lˣ) : L) = 1 :=
      mul_right_cancel₀ (Units.ne_zero α) (by rw [key, one_mul])
    exact Subtype.ext (Units.val_eq_one.mp key2)
  calc IntermediateField.adjoin K S
      = IntermediateField.fixedField (IntermediateField.adjoin K S).fixingSubgroup :=
        (IsGalois.fixedField_fixingSubgroup (IntermediateField.adjoin K S)).symm
    _ = IntermediateField.fixedField ⊥ := by rw [hfix]
    _ = ⊤ := IntermediateField.fixedField_bot

end Work.CFT.Kummer
