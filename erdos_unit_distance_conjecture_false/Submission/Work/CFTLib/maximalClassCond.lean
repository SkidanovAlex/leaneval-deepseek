/-!
# `maximalClassCond`: maximality gives the class condition

`CFTLib.PClassFieldExists` says that every nontrivial `p`-character of the class group of a number
field `K` killing the classes of the primes in a finite set `T` has a cyclic degree-`p`
unramified `T`-split class field.  From it we deduce `CFTLib.MaximalClassCond`: if `K/F` is a
finite Galois unramified `T`-split `p`-extension which is *maximal* among such extensions of `F`,
then every `p`-power ideal class of `K` is generated by the classes of the primes above `T`.

The proof (Galois closure / Hilbert class field):

1. `Character.charKilling` produces a nontrivial character `χ : Cl(𝓞 K) →* Z/p` killing the
   subgroup generated by the classes of the primes above `T`.
2. Move `K` into `A := AlgebraicClosure F` by an `F`-embedding `ψ`, `K' := ψ.fieldRange ≅ K`, and
   transport `χ` to `χ'` on `Cl(𝓞 K')` along the ring isomorphism `𝓞 K ≃+* 𝓞 K'`
   (`Setup.charTransport`).
3. Apply `h` to `K'` and to `T''` = the primes of `K'` above `T`: get `L'/K'` Galois of degree `p`,
   unramified and `T''`-split.
4. Push `L'` into `A` (`IsAlgClosed.lift`), giving `L''` over `K'` inside `A`.
5. `M := conjSup p K' L''` (the compositum of the conjugates of `L''` over `K'`) is the normal
   closure of `L''/F`: finite, Galois over `F`, with `p`-group Galois group, unramified and
   `T`-split (`ConjSup.*`).
6. Maximality embeds `M` into `K`, i.e. `M ≤ K'`; but `conjSup ⊇ L''` has degree `p > 1` over
   `K'`, so `M ≤ K'` forces `[L'' : K'] = 1`, a contradiction.
-/

open NumberField
open scoped Classical nonZeroDivisors

namespace Work.CFTLib

theorem maximalClassCond (h : CFTLib.PClassFieldExists) : CFTLib.MaximalClassCond := by
  intro F K _ _ _ _ _ _ _ p _ T hP hUnr hSplit hMax
  rw [classCond_iff]
  intro c hc
  by_contra hcH
  -- 1. a nontrivial character killing the classes of the primes above `T`
  obtain ⟨χ, hχne, hχH⟩ := Character.charKilling p hcH hc
  obtain ⟨T', hT'1, hT'2⟩ := PrimesAbove.finset F K T
  have hχT' : ∀ w : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      (∃ v ∈ T, w.asIdeal.LiesOver v.asIdeal) →
        χ (ClassGroup.mk0 ⟨w.asIdeal, mem_nonZeroDivisors_of_ne_zero w.ne_bot⟩) = 1 :=
    fun w hw => hχH _ (Subgroup.subset_closure ⟨w, hw, rfl⟩)
  -- 2. move `K` into the algebraic closure of `F`
  let ψ : K →ₐ[F] AlgebraicClosure F := IsAlgClosed.lift
  let K' : IntermediateField F (AlgebraicClosure F) := ψ.fieldRange
  have hK'fd : FiniteDimensional F K' := Setup.finiteDimensional_fieldRange ψ
  haveI : FiniteDimensional F K' := hK'fd
  have hK'nf : NumberField ↥K' := NumberField.of_module_finite F ↥K'
  haveI : NumberField ↥K' := hK'nf
  haveI hK'gal : IsGalois F K' := IsGalois.of_algEquiv ψ.equivFieldRange
  have hK'unr : CFTLib.IsUnramified F ↥K' := Transport.isUnramified_algEquiv ψ.equivFieldRange hUnr
  have hK'split : CFTLib.SplitsAt F ↥K' T := Transport.splitsAt_algEquiv T ψ.equivFieldRange hSplit
  have hK'p : IsPGroup p (↥K' ≃ₐ[F] ↥K') := Setup.isPGroup_fieldRange p ψ hP
  have hK'unrAll : Work.Tower.IsUnramifiedExtensionForallPrimes F ↥K' :=
    forallPrimes_of_isUnramified hK'unr
  -- transport the character
  obtain ⟨T'', hT''1, hT''2⟩ := PrimesAbove.finset F ↥K' T
  obtain ⟨χ', hχ'ne, hχ'T''⟩ := Setup.charTransport F K p T ψ χ hχne hχT'
  -- 3. the cyclic degree-`p` class field of `K'`
  obtain ⟨L', _, _, _, _, hL'gal, hL'deg, hL'unr, hL'split⟩ :=
    h ↥K' p T'' χ' hχ'ne (fun v hv => hχ'T'' v (hT''1 v hv))
  -- 4. push it inside the algebraic closure
  let φA : L' →ₐ[↥K'] AlgebraicClosure F := IsAlgClosed.lift
  let L'' : IntermediateField ↥K' (AlgebraicClosure F) := φA.fieldRange
  have hL''fd : FiniteDimensional ↥K' L'' := Setup.finiteDimensional_fieldRange φA
  haveI : FiniteDimensional ↥K' L'' := hL''fd
  have hL''nf : NumberField ↥L'' := NumberField.of_module_finite ↥K' ↥L''
  haveI : NumberField ↥L'' := hL''nf
  haveI hL''gal : IsGalois ↥K' L'' := IsGalois.of_algEquiv φA.equivFieldRange
  have hL''unr : CFTLib.IsUnramified ↥K' ↥L'' :=
    Transport.isUnramified_algEquiv φA.equivFieldRange hL'unr
  have hL''split : CFTLib.SplitsAt ↥K' ↥L'' T'' :=
    Transport.splitsAt_algEquiv T'' φA.equivFieldRange hL'split
  have hL''deg : Module.finrank ↥K' L'' = p :=
    (φA.equivFieldRange).toLinearEquiv.finrank_eq.symm.trans hL'deg
  have hL''unrAll : Work.Tower.IsUnramifiedExtensionForallPrimes ↥K' ↥L'' :=
    forallPrimes_of_isUnramified hL''unr
  have hK'inf : IsUnramifiedAtInfinitePlaces F ↥K' := hK'unr.2
  have hL''inf : IsUnramifiedAtInfinitePlaces ↥K' ↥L'' := hL''unr.2
  -- 5. the Galois closure
  have hMfdgal := ConjSup.finiteDimensional_isGalois F p K' L'' hL''gal
  haveI : FiniteDimensional F (conjSup p K' L'') := hMfdgal.1
  haveI hMgal : IsGalois F (conjSup p K' L'') := hMfdgal.2
  have hMnf : NumberField ↥(conjSup p K' L'') := NumberField.of_module_finite F _
  haveI : NumberField ↥(conjSup p K' L'') := hMnf
  have hMunr : CFTLib.IsUnramified F ↥(conjSup p K' L'') :=
    ConjSup.isUnramifiedConjSup F p K' L'' hK'unrAll hK'inf hL''gal hL''unrAll hL''inf
  have hMsplit : CFTLib.SplitsAt F ↥(conjSup p K' L'') T :=
    ConjSup.splitsAt F p T K' L'' hK'unrAll hK'split hL''gal hL''unrAll T''
      ⟨hT''1, fun u hu v hv => hT''2 v ⟨u, hu, hv⟩⟩ hL''split hMgal
  have hMp : IsPGroup p (↥(conjSup p K' L'') ≃ₐ[F] ↥(conjSup p K' L'')) :=
    ConjSup.isPGroup F p K' hK'p L'' hL''gal hL''deg hMgal
  -- 6. maximality
  have hMle : conjSup p K' L'' ≤ K' :=
    le_of_isMaximalUnramified p T hMax ψ (conjSup p K' L'') hMp hMunr hMsplit
  -- 7. contradiction with the degree of `L''` over `K'`
  exact ConjSup.finrankContradiction F p K' L'' hMle hL''deg

end Work.CFTLib
