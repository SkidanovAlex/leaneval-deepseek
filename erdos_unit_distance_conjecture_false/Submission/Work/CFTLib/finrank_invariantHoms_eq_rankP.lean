import Mathlib
import Submission.Work.CFTLib.InvRepDefs
import Submission.Work.CFT.ClassFormation.Schur.finrank_homology_fp_eq
import Submission.Work.CFT.ClassFormation.Schur.finrank_addHom_eq_finrank_tensor
import Submission.Work.CFT.Ledger.tateCohomology_neg_one_iso_Hm1Quotient

/-!
# Invariant characters versus the `p`-rank of the coinvariant quotient

For a group `G` acting `ℤ`-linearly on an abelian group `V` and a prime `p`, the `𝔽_p`-space
`invariantHoms A p` of `G`-invariant additive characters `V → 𝔽_p` is naturally the dual of the
coinvariant quotient `V ⧸ I_G V`:

* an additive `χ : V → 𝔽_p` is `G`-invariant iff it kills every element `ρ g x - x`, i.e. iff it
  kills the augmentation subgroup `I_G A = augIdeal A`; such a `χ` therefore factors uniquely
  through the quotient `A.V ⧸ I_G A`;
* for an abelian group `N`, `dim_𝔽_p (N →+ 𝔽_p) = dim_𝔽_p (𝔽_p ⊗_ℤ N) = rankP p N`
  (`Work.CFT.ClassFormation.Schur.finrank_addHom_eq_finrank_tensor`), while the dual of a space
  has the same `𝔽_p`-dimension as the space (`Subspace.dual_finrank_eq`).

The main result is `Work.CFTLib.finrank_invariantHoms_eq_rankP`.
-/

open scoped TensorProduct

namespace Work.CFTLib

/-- **An invariant additive character kills the augmentation subgroup.**  If
`χ : A.V →+ 𝔽_p` satisfies `χ (ρ g x) = χ x` for all `g`, `x`, then `χ` vanishes on the
augmentation subgroup `I_G A = augIdeal A`, the subgroup generated by the elements
`ρ g x - x`. -/
lemma augIdeal_le_ker {G : Type} [Group G] (A : Rep ℤ G) (p : ℕ) (χ : A.V →+ ZMod p)
    (hχ : χ ∈ invariantHoms A p) :
    Work.CFT.Ledger.augIdeal A ≤ χ.ker := by
  intro x hx
  rw [AddMonoidHom.mem_ker]
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨⟨g, a⟩, rfl⟩ := hy
    rw [map_sub, (mem_invariantHoms A p χ).mp hχ g a, sub_self]
  | zero => rw [map_zero]
  | add y z hy hz ihy ihz => rw [map_add, ihy, ihz, add_zero]
  | neg y hy ihy => rw [map_neg, ihy, neg_zero]

/-- **Invariant characters are the additive characters of the coinvariants.**  For a
`ℤ`-representation `A` of a group `G`, the `𝔽_p`-space `invariantHoms A p` of `G`-invariant
additive characters `A.V → 𝔽_p` is `𝔽_p`-linearly equivalent to the space of all additive
characters of the coinvariant quotient `A.V ⧸ I_G A`: a character factors through the quotient
map `QuotientAddGroup.mk'` precisely when it is invariant. -/
noncomputable def invariantHomsEquivQuotient {G : Type} [Group G] (A : Rep ℤ G) (p : ℕ) :
    ↥(invariantHoms A p) ≃ₗ[ZMod p] ((A.V ⧸ Work.CFT.Ledger.augIdeal A) →+ ZMod p) where
  toFun χ :=
    QuotientAddGroup.lift (Work.CFT.Ledger.augIdeal A) χ.1 (augIdeal_le_ker A p χ.1 χ.2)
  invFun ψ :=
    ⟨ψ.comp (QuotientAddGroup.mk' (Work.CFT.Ledger.augIdeal A)), by
      rw [mem_invariantHoms]
      intro g x
      exact congrArg ψ (QuotientAddGroup.eq_iff_sub_mem.mpr
        (Work.CFT.Ledger.smul_sub_self_mem_augIdeal A g x))⟩
  map_add' χ ψ := by
    apply AddMonoidHom.ext
    intro z
    induction z using QuotientAddGroup.induction_on with
    | _ x => simp only [QuotientAddGroup.lift_mk, Submodule.coe_add, AddMonoidHom.add_apply]
  map_smul' c χ := by
    apply AddMonoidHom.ext
    intro z
    induction z using QuotientAddGroup.induction_on with
    | _ x => simp only [QuotientAddGroup.lift_mk, Submodule.coe_smul, AddMonoidHom.smul_apply,
        RingHom.id_apply]
  left_inv χ := by
    apply Subtype.ext
    apply AddMonoidHom.ext
    intro x
    exact QuotientAddGroup.lift_mk (Work.CFT.Ledger.augIdeal A)
      (augIdeal_le_ker A p χ.1 χ.2) x
  right_inv ψ := by
    apply AddMonoidHom.ext
    intro z
    induction z using QuotientAddGroup.induction_on with
    | _ x => simp only [QuotientAddGroup.lift_mk, QuotientAddGroup.mk'_apply,
        AddMonoidHom.comp_apply]

/-- **The dimension of the space of `G`-invariant additive characters `V → 𝔽_p` equals the
`p`-rank of the coinvariant quotient `V ⧸ I_G V`.**  This is the identification of the
`G`-invariant characters of a `ℤ[G]`-module `A` with the dual of its coinvariants, together with
`dim_𝔽_p (N →+ 𝔽_p) = rankP p N` for abelian groups `N`. -/
theorem finrank_invariantHoms_eq_rankP {G : Type} [Group G] [Fintype G] (A : Rep ℤ G)
    [Finite A.V] [Module.Finite ℤ A.V] (p : ℕ) [Fact p.Prime] :
    Module.finrank (ZMod p) (Work.CFTLib.invariantHoms A p)
      = Work.CFT.ClassFormation.rankP p (A.V ⧸ Work.CFT.Ledger.augIdeal A) := by
  rw [Work.CFT.ClassFormation.rankP,
    ← Work.CFT.ClassFormation.Schur.finrank_addHom_eq_finrank_tensor p
      (A.V ⧸ Work.CFT.Ledger.augIdeal A)]
  exact LinearEquiv.finrank_eq (invariantHomsEquivQuotient A p)

end Work.CFTLib
