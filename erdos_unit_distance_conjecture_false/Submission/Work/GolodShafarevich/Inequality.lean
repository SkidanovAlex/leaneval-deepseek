import Mathlib
import Submission.Work.GolodShafarevich.Setup
import Submission.Work.GolodShafarevich.Assembly
import Submission.Work.GolodShafarevich.RelationModule.ker_psi_eq_span
import Submission.Work.GolodShafarevich.RelatorAug.Vfun_relator_mem_augIdeal
import Submission.Work.GolodShafarevich.AbstractGS.gs_dimension_bound

/-!
# The Golod–Shafarevich inequality

For a nontrivial finite `p`-group `G` presented with `d` generators and `r` relations,
`4 * r > d ^ 2`.

The proof uses the group algebra `k[G]` over `k = ZMod p`: the augmentation ideal `I` is
generated by `d` elements (`ψ : k[G]^d → I`), the kernel of `ψ` is the relation module generated
by the Fox derivative vectors of the `r` relators, and a Hilbert-series argument on the
`I`-adic filtration gives `4r > d²`.
-/

namespace Work.GolodShafarevich

open scoped MonoidAlgebra

theorem Inequality {p d r : ℕ} (hp : Nat.Prime p) (G : Type*) [Group G] [Fintype G] [Nontrivial G]
    (hG : IsPGroup p G) (φ : FreeGroup (Fin d) →* G) (hφ : Function.Surjective φ)
    (R : Fin r → FreeGroup (Fin d)) (hR : φ.ker = Subgroup.normalClosure (Set.range R))
    (hmin : ∀ (d' : ℕ) (ψ : FreeGroup (Fin d') →* G), Function.Surjective ψ → d ≤ d') :
    4 * r > d ^ 2 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hd0 : d ≠ 0 := by
    rintro rfl
    have hsub : Subsingleton G := hφ.subsingleton
    exact (not_nontrivial_iff_subsingleton.mpr hsub) inferInstance
  have hd : 1 ≤ d := Nat.one_le_iff_ne_zero.mpr hd0
  exact AbstractGS.gs_dimension_bound (k := ZMod p) (B := MonoidAlgebra (ZMod p) G)
    (I := augIdeal (ZMod p) G) (finrank_quotient_augIdeal (R := ZMod p)) hd (psi (ZMod p) φ)
    (range_psi_eq_augIdeal φ hφ) (fun j => Vfun (ZMod p) φ (R j))
    (RelationModule.ker_psi_eq_span φ R hR).symm
    (fun j i => RelatorAug.Vfun_relator_mem_augIdeal hp hG φ hφ R hR hmin j i)

end Work.GolodShafarevich
