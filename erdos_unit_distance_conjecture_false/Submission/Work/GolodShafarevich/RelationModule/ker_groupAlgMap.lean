import Mathlib
import Submission.Work.GolodShafarevich.Setup
import Submission.Work.GolodShafarevich.RelationModule.Defs

/-!
# The kernel of the group-algebra map

For a group homomorphism `φ : F_d →* G`, let `groupAlgMap k φ : k[F_d] →ₐ[k] k[G]` be the
induced map of group algebras.  This file proves the classical description of its kernel:
it is the left ideal (equivalently, the `k[F_d]`-submodule) generated by the elements
`n - 1` with `n ∈ ker φ`.

The proof of the nontrivial inclusion is by linearity: choose a set-theoretic section
`s : G → F_d` of `φ` and let `lift : k[G] →ₗ[k] k[F_d]` be the linear extension of `g ↦ s g`.
For every `x`, the element `x - lift (groupAlgMap k φ x)` is a `k[F_d]`-multiple of elements
`n - 1`, `n ∈ ker φ`; if `x` lies in the kernel then `lift (groupAlgMap k φ x) = 0`, and the
claim follows.
-/

open scoped MonoidAlgebra

namespace Work.GolodShafarevich.RelationModule

open Work.GolodShafarevich

variable {k : Type*} [CommRing k] {d : ℕ} {G : Type*} [Group G]

/-- A set-theoretic section of `φ`, arbitrary off the image of `φ`. -/
noncomputable def secOf (φ : FreeGroup (Fin d) →* G) : G → FreeGroup (Fin d) := by
  classical
  exact fun g => if h : ∃ x, φ x = g then Classical.choose h else 1

/-- `secOf` is a section of `φ` on its image. -/
theorem secOf_spec (φ : FreeGroup (Fin d) →* G) (w : FreeGroup (Fin d)) :
    φ (secOf φ (φ w)) = φ w := by
  have h : ∃ x, φ x = φ w := ⟨w, rfl⟩
  simp only [secOf]
  rw [dite_eq_left h]
  exact Classical.choose_spec h

/-- The `k`-linear "section" map `k[G] →ₗ[k] k[F_d]` sending `g ↦ secOf φ g`. -/
noncomputable def liftAlg (φ : FreeGroup (Fin d) →* G) :
    MonoidAlgebra k G →ₗ[k] MonoidAlgebra k (FreeGroup (Fin d)) :=
  MonoidAlgebra.mapDomainLinearMap k k (secOf φ)

/-- `liftAlg` on the generators of `k[G]`. -/
theorem liftAlg_of (φ : FreeGroup (Fin d) →* G) (g : G) :
    liftAlg (k := k) φ (MonoidAlgebra.of k G g) =
      MonoidAlgebra.of k (FreeGroup (Fin d)) (secOf φ g) := by
  rw [liftAlg, MonoidAlgebra.of_apply, MonoidAlgebra.mapDomainLinearMap_single,
    MonoidAlgebra.of_apply]

/-- The candidate kernel: the `k[F_d]`-span of `{n - 1 : n ∈ ker φ}`. -/
noncomputable def kerSpan (k : Type*) [CommRing k] {d : ℕ} {G : Type*} [Group G]
    (φ : FreeGroup (Fin d) →* G) :
    Submodule (MonoidAlgebra k (FreeGroup (Fin d)))
      (MonoidAlgebra k (FreeGroup (Fin d))) :=
  Submodule.span (MonoidAlgebra k (FreeGroup (Fin d)))
    (Set.range (fun n : φ.ker =>
      MonoidAlgebra.of k (FreeGroup (Fin d)) ((n : FreeGroup (Fin d))) - 1))

/-- For every `x`, the difference `x - lift (groupAlgMap k φ x)` lies in `kerSpan k φ`. -/
theorem sub_lift_mem_span (φ : FreeGroup (Fin d) →* G)
    (x : MonoidAlgebra k (FreeGroup (Fin d))) :
    x - liftAlg (k := k) φ (groupAlgMap k φ x) ∈ kerSpan k φ := by
  induction x using MonoidAlgebra.induction_on with
  | of w =>
    rw [groupAlgMap_of, liftAlg_of]
    set u := secOf φ (φ w) with hu
    have hφu : φ u = φ w := by rw [hu]; exact secOf_spec φ w
    have hn : u⁻¹ * w ∈ φ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hφu, inv_mul_cancel]
    have hg : MonoidAlgebra.of k (FreeGroup (Fin d)) (u⁻¹ * w) - 1 ∈
        Set.range (fun n : φ.ker =>
          MonoidAlgebra.of k (FreeGroup (Fin d)) ((n : FreeGroup (Fin d))) - 1) :=
      ⟨⟨u⁻¹ * w, hn⟩, rfl⟩
    have hmem : MonoidAlgebra.of k (FreeGroup (Fin d)) u *
        (MonoidAlgebra.of k (FreeGroup (Fin d)) (u⁻¹ * w) - 1) ∈ kerSpan k φ := by
      rw [← smul_eq_mul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span hg)
    have key : MonoidAlgebra.of k (FreeGroup (Fin d)) u *
        (MonoidAlgebra.of k (FreeGroup (Fin d)) (u⁻¹ * w) - 1)
        = MonoidAlgebra.of k (FreeGroup (Fin d)) w -
          MonoidAlgebra.of k (FreeGroup (Fin d)) u := by
      rw [mul_sub, ← map_mul, mul_inv_cancel_left, mul_one]
    rw [key] at hmem
    exact hmem
  | add x y hx hy =>
    have h1 : groupAlgMap k φ (x + y) = groupAlgMap k φ x + groupAlgMap k φ y :=
      map_add _ _ _
    have h2 : liftAlg (k := k) φ (groupAlgMap k φ x + groupAlgMap k φ y)
        = liftAlg (k := k) φ (groupAlgMap k φ x) +
          liftAlg (k := k) φ (groupAlgMap k φ y) := map_add _ _ _
    have key : x + y - liftAlg (k := k) φ (groupAlgMap k φ (x + y))
        = (x - liftAlg (k := k) φ (groupAlgMap k φ x)) +
          (y - liftAlg (k := k) φ (groupAlgMap k φ y)) := by
      rw [h1, h2]; abel
    rw [key]
    exact Submodule.add_mem _ hx hy
  | smul r x hx =>
    have h1 : groupAlgMap k φ (r • x) = r • groupAlgMap k φ x := map_smul _ _ _
    have h2 : liftAlg (k := k) φ (r • groupAlgMap k φ x)
        = r • liftAlg (k := k) φ (groupAlgMap k φ x) := map_smul _ _ _
    have key : r • x - liftAlg (k := k) φ (groupAlgMap k φ (r • x))
        = r • (x - liftAlg (k := k) φ (groupAlgMap k φ x)) := by
      rw [h1, h2, smul_sub]
    rw [key]
    rw [Algebra.smul_def]
    rw [← smul_eq_mul]
    exact Submodule.smul_mem _ _ hx

/-- The easy inclusion: `kerSpan k φ` is contained in the kernel of `groupAlgMap k φ`. -/
theorem kerSpan_le_ker (φ : FreeGroup (Fin d) →* G) :
    kerSpan k φ ≤ RingHom.ker (groupAlgMap k φ) := by
  rw [kerSpan, Submodule.span_le]
  rintro _ ⟨n, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, groupAlgMap_of]
  have hn : φ (n : FreeGroup (Fin d)) = 1 := MonoidHom.mem_ker.mp n.2
  rw [hn, map_one, map_one, MonoidAlgebra.one_def, sub_self]

theorem ker_groupAlgMap {k : Type*} [CommRing k] {d : ℕ} {G : Type*} [Group G]
    (φ : FreeGroup (Fin d) →* G) :
    RingHom.ker (Work.GolodShafarevich.groupAlgMap k φ) =
      Submodule.span (MonoidAlgebra k (FreeGroup (Fin d)))
        (Set.range (fun n : φ.ker =>
          MonoidAlgebra.of k (FreeGroup (Fin d)) ((n : FreeGroup (Fin d))) - 1)) := by
  change RingHom.ker (groupAlgMap k φ) = kerSpan k φ
  refine le_antisymm ?_ (kerSpan_le_ker (k := k) φ)
  intro x hx
  rw [RingHom.mem_ker] at hx
  have h := sub_lift_mem_span (k := k) φ x
  simpa [hx] using h

end Work.GolodShafarevich.RelationModule
