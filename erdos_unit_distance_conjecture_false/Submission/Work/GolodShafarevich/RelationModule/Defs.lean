import Mathlib
import Submission.Work.GolodShafarevich.Defs
import Submission.Work.GolodShafarevich.Setup

/-!
# Relation module: basic naturality lemmas

Helper lemmas connecting `psi`, `Vfun`, `groupAlgMap` and the Fox derivative,
used in the proof that the kernel of `ψ` is generated by the relators.
-/

open scoped MonoidAlgebra

namespace Work.GolodShafarevich.RelationModule

open Work.GolodShafarevich

variable {k : Type*} [CommRing k] {d : ℕ}

/-- `groupAlgMap` for the identity group homomorphism is the identity. -/
theorem groupAlgMap_id :
    groupAlgMap k (MonoidHom.id (FreeGroup (Fin d))) =
      AlgHom.id k (MonoidAlgebra k (FreeGroup (Fin d))) := by
  rw [groupAlgMap, MonoidAlgebra.mapDomainAlgHom_id]

/-- `groupAlgMap` is compatible with composition of group homomorphisms. -/
theorem groupAlgMap_comp {G H : Type*} [Group G] [Group H]
    (φ : FreeGroup (Fin d) →* G) (ψ : G →* H) :
    groupAlgMap k (ψ.comp φ) =
      (MonoidAlgebra.mapDomainAlgHom k k ψ).comp (groupAlgMap k φ) := by
  rw [groupAlgMap, groupAlgMap, MonoidAlgebra.mapDomainAlgHom_comp]

/-- `groupAlgMap` is surjective when the group homomorphism is. -/
theorem groupAlgMap_surjective {G : Type*} [Group G] (φ : FreeGroup (Fin d) →* G)
    (hφ : Function.Surjective φ) : Function.Surjective (groupAlgMap k φ) := by
  intro x
  induction x using MonoidAlgebra.induction_on with
  | of g =>
    obtain ⟨w, hw⟩ := hφ g
    exact ⟨MonoidAlgebra.of k (FreeGroup (Fin d)) w, by rw [groupAlgMap_of, hw]⟩
  | add x y hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [map_add, ha, hb]⟩
  | smul r x hx =>
    obtain ⟨a, ha⟩ := hx
    exact ⟨r • a, by rw [map_smul, ha]⟩

/-- The map `groupAlgMap` intertwines `ψ` for `F_d` with `ψ` for `G`. -/
theorem groupAlgMap_psi_id {G : Type*} [Group G] (φ : FreeGroup (Fin d) →* G)
    (x : Fin d → MonoidAlgebra k (FreeGroup (Fin d))) :
    groupAlgMap k φ (psi k (MonoidHom.id (FreeGroup (Fin d))) x) =
      psi k φ (fun i => groupAlgMap k φ (x i)) := by
  simp only [psi_apply, gGenSubOne, map_sum, map_mul, map_sub, map_one, groupAlgMap_of]
  rfl

/-- `Vfun` is natural in the group homomorphism. -/
theorem Vfun_comp {G H : Type*} [Group G] [Group H]
    (ι : G →* H) (f : FreeGroup (Fin d) →* G) (w : FreeGroup (Fin d)) :
    Vfun k (ι.comp f) w =
      fun i => MonoidAlgebra.mapDomainAlgHom k k ι (Vfun k f w i) := by
  funext i
  simp only [Vfun_apply]
  rw [← AlgHom.comp_apply, ← groupAlgMap_comp]

/-- The easy inclusion: the span of the images of the relators lies in the kernel. -/
theorem span_le_ker_psi {G : Type*} [Group G] (φ : FreeGroup (Fin d) →* G)
    {r : ℕ} (R : Fin r → FreeGroup (Fin d)) (hR : ∀ j, φ (R j) = 1) :
    Submodule.span (MonoidAlgebra k G) (Set.range (fun j => Vfun k φ (R j))) ≤
      LinearMap.ker (psi k φ) := by
  rw [Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, psi_Vfun, hR j, map_one, sub_self]

end Work.GolodShafarevich.RelationModule
