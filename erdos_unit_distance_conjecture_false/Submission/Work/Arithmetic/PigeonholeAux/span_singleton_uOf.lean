import Mathlib
import Submission.Work.Arithmetic.CMDefs

namespace Work.Arithmetic.PigeonholeAux

open NumberField
open scoped nonZeroDivisors

variable {K : Type*} [Field K] [NumberField K] [NumberField.IsCMField K]

/-- Conjugation sends the principal ideal `(x)` to the principal ideal `(c x)`. -/
lemma conjI_span_singleton (x : 𝓞 K) :
    Work.Arithmetic.conjI (Ideal.span {x}) = Ideal.span {Work.Arithmetic.conjR K x} := by
  rw [Work.Arithmetic.conjI, Ideal.map_span, Set.image_singleton]

/-- For a CM field `K` and nonzero `x y : 𝓞 K` with `(x) * ASet ε = (y) * ASet η`, the
principal fractional ideal generated by `uOf x y = (y * c x) / (x * c y)` is
`ASet ε * ASet' η * (ASet η * ASet' ε)⁻¹`. -/
theorem span_singleton_uOf {K : Type*} [Field K] [NumberField K] [NumberField.IsCMField K]
    (m : ℕ) (P : Fin m → Ideal (NumberField.RingOfIntegers K)) (η ε : Fin m → Bool)
    (hε : Work.Arithmetic.ASet m P ε ≠ ⊥) (hη : Work.Arithmetic.ASet m P η ≠ ⊥)
    (x y : NumberField.RingOfIntegers K) (hx : x ≠ 0) (hy : y ≠ 0)
    (hxy : Ideal.span {x} * Work.Arithmetic.ASet m P ε = Ideal.span {y} * Work.Arithmetic.ASet m P η) :
    FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K)) (Work.Arithmetic.uOf x y) =
      ((Work.Arithmetic.ASet m P ε : Ideal (NumberField.RingOfIntegers K)) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) *
      (((Work.Arithmetic.ASet' m P η : Ideal (NumberField.RingOfIntegers K)) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) *
      ((((Work.Arithmetic.ASet m P η : Ideal (NumberField.RingOfIntegers K)) :
            FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) *
       (((Work.Arithmetic.ASet' m P ε : Ideal (NumberField.RingOfIntegers K)) :
            FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)))⁻¹ := by
  -- Nonzero fractional ideals over the Dedekind domain `𝓞 K` are invertible.
  have hmulinv : ∀ I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K, I ≠ 0 → I * I⁻¹ = 1 := fun I hI =>
    isDedekindDomain_iff_mul_inv_cancel.mp inferInstance I (by rwa [FractionalIdeal.bot_eq_zero])
  have hxK : (x : K) ≠ 0 := fun h => hx (by simpa using h)
  have hyK : (y : K) ≠ 0 := fun h => hy (by simpa using h)
  have hcxK : IsCMField.complexConj K (x : K) ≠ 0 := fun h =>
    hxK ((IsCMField.complexConj K).injective (by rw [h, map_zero]))
  have hcyK : IsCMField.complexConj K (y : K) ≠ 0 := fun h =>
    hyK ((IsCMField.complexConj K).injective (by rw [h, map_zero]))
  -- Conjugate the ideal identity `(x) * ASet ε = (y) * ASet η`.
  have hxy' : Ideal.span {Work.Arithmetic.conjR K x} * Work.Arithmetic.ASet' m P ε
            = Ideal.span {Work.Arithmetic.conjR K y} * Work.Arithmetic.ASet' m P η := by
    have h := congrArg (fun I : Ideal (𝓞 K) => Work.Arithmetic.conjI I) hxy
    rw [Work.Arithmetic.conjI_mul, Work.Arithmetic.conjI_mul,
        Work.Arithmetic.conjI_ASet, Work.Arithmetic.conjI_ASet] at h
    rwa [conjI_span_singleton, conjI_span_singleton] at h
  -- Abbreviations for the fractional ideals appearing in the computation.
  set su : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (Work.Arithmetic.uOf x y) with hsu_eq
  set sx : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (x : K) with hsx_eq
  set sy : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (y : K) with hsy_eq
  set scx : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (IsCMField.complexConj K (x : K)) with hscx_eq
  set scy : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (IsCMField.complexConj K (y : K)) with hscy_eq
  set A : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    ((Work.Arithmetic.ASet m P ε : Ideal (𝓞 K)) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) with hA_eq
  set B : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    ((Work.Arithmetic.ASet m P η : Ideal (𝓞 K)) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) with hB_eq
  set A' : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    ((Work.Arithmetic.ASet' m P ε : Ideal (𝓞 K)) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) with hA'_eq
  set B' : FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
    ((Work.Arithmetic.ASet' m P η : Ideal (𝓞 K)) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) with hB'_eq
  -- `sx * A = sy * B`  and  `scx * A' = scy * B'`.
  have e1 : sx * A = sy * B := by
    have h := congrArg (fun I : Ideal (𝓞 K) => (I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) hxy
    rw [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_mul,
        FractionalIdeal.coeIdeal_span_singleton, FractionalIdeal.coeIdeal_span_singleton] at h
    simpa [hsx_eq, hsy_eq, hA_eq, hB_eq] using h
  have e2 : scx * A' = scy * B' := by
    have h := congrArg (fun I : Ideal (𝓞 K) => (I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) hxy'
    rw [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_mul,
        FractionalIdeal.coeIdeal_span_singleton, FractionalIdeal.coeIdeal_span_singleton] at h
    simpa [hscx_eq, hscy_eq, hA'_eq, hB'_eq, Work.Arithmetic.conjR,
           IsCMField.coe_ringOfIntegersComplexConj] using h
  -- `su * (sx * scy) = sy * scx`, from the definition of `uOf`.
  have hu : Work.Arithmetic.uOf x y * ((x : K) * IsCMField.complexConj K (y : K))
              = (y : K) * IsCMField.complexConj K (x : K) := by
    rw [Work.Arithmetic.uOf_def]
    exact div_mul_cancel₀ _ (mul_ne_zero hxK hcyK)
  have h1 : su * (sx * scy) = sy * scx := by
    rw [hsu_eq, hsx_eq, hscy_eq, hsy_eq, hscx_eq]
    simp only [FractionalIdeal.spanSingleton_mul_spanSingleton, hu]
  -- Nonzeroness of the factors.
  have hsxscy : sx * scy ≠ 0 := by
    rw [hsx_eq, hscy_eq]
    exact mul_ne_zero (FractionalIdeal.spanSingleton_ne_zero_iff.mpr hxK)
                      (FractionalIdeal.spanSingleton_ne_zero_iff.mpr hcyK)
  have hB_ne : B ≠ 0 := by rw [hB_eq]; exact FractionalIdeal.coeIdeal_ne_zero.mpr hη
  have hA'_ne : A' ≠ 0 := by
    rw [hA'_eq]
    exact FractionalIdeal.coeIdeal_ne_zero.mpr
      (by rw [← Work.Arithmetic.conjI_ASet]; exact Work.Arithmetic.conjI_ne_bot hε)
  have hBA'_ne : B * A' ≠ 0 := mul_ne_zero hB_ne hA'_ne
  -- Solve for `su`.
  have h1' : su = (sy * scx) * (sx * scy)⁻¹ := by
    calc su = su * 1 := (mul_one su).symm
      _ = su * ((sx * scy) * (sx * scy)⁻¹) := by rw [hmulinv (sx * scy) hsxscy]
      _ = (su * (sx * scy)) * (sx * scy)⁻¹ := by ring
      _ = (sy * scx) * (sx * scy)⁻¹ := by rw [h1]
  -- Substitute the two ideal identities `e1`, `e2`.
  have key : su * (B * A') = A * B' := by
    calc su * (B * A')
        = ((sy * scx) * (sx * scy)⁻¹) * (B * A') := by rw [h1']
      _ = ((sy * B) * (scx * A')) * (sx * scy)⁻¹ := by ring
      _ = ((sx * A) * (scy * B')) * (sx * scy)⁻¹ := by rw [← e1, ← e2]
      _ = (A * B') * ((sx * scy) * (sx * scy)⁻¹) := by ring
      _ = A * B' := by rw [hmulinv (sx * scy) hsxscy, mul_one]
  calc su = su * 1 := (mul_one su).symm
    _ = su * ((B * A') * (B * A')⁻¹) := by rw [hmulinv (B * A') hBA'_ne]
    _ = (su * (B * A')) * (B * A')⁻¹ := by ring
    _ = (A * B') * (B * A')⁻¹ := by rw [key]

end Work.Arithmetic.PigeonholeAux
