import Mathlib
import Submission.Work.Tower.FrattiniLayer.Basic

namespace Work.Tower.FrattiniLayer

open Polynomial

/-!
# The field generated by a primitive cube root of unity

If `ζ` is a primitive cube root of unity in an `F`-algebra `Ω`, and `ζ ∉ F`, then `F⟮ζ⟯/F` is
Galois of degree `2` and `F⟮ζ⟯` contains a primitive cube root of unity.

The argument is the classical one.  `ζ` is a root of `X ^ 2 + X + 1` (because `1 + ζ + ζ ^ 2 = 0`
whenever `ζ` is a primitive `3`-rd root of unity), hence integral over `F`.  Since `ζ ∉ F` the
minimal polynomial of `ζ` has degree `≥ 2`, so it is exactly `X ^ 2 + X + 1` and
`[F⟮ζ⟯ : F] = 2`.  For the Galois statement we use the cyclotomic formalism: `F⟮ζ⟯` is the
extension generated over `F` by *all* cube roots of unity in `Ω` (the only ones being `1`, `ζ`
and `ζ ^ 2`), so it is a `{3}`-cyclotomic extension, and cyclotomic extensions are Galois.
-/

theorem adjoin_primitiveRoot_three {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ 3) (h : ζ ∉ (⊥ : IntermediateField F Ω)) :
    IsGalois F (IntermediateField.adjoin F {ζ}) ∧
    Module.finrank F (IntermediateField.adjoin F {ζ}) = 2 ∧
    (primitiveRoots 3 ↥(IntermediateField.adjoin F {ζ})).Nonempty := by
  have hζmem : ζ ∈ (IntermediateField.adjoin F {ζ} : IntermediateField F Ω) :=
    IntermediateField.mem_adjoin_simple_self F ζ
  -- `ζ`, viewed as an element of `F⟮ζ⟯`, is again a primitive cube root of unity.
  have hζK : IsPrimitiveRoot (⟨ζ, hζmem⟩ : (IntermediateField.adjoin F {ζ})) 3 :=
    IsPrimitiveRoot.of_map_of_injective (f := (IntermediateField.adjoin F {ζ}).val.toRingHom)
      (by simpa using hζ) (IntermediateField.adjoin F {ζ}).val.injective
  refine ⟨?_, ?_, ?_⟩
  · -- `F⟮ζ⟯` is generated by the cube roots of unity, hence a cyclotomic extension, hence Galois.
    have hcyc : IsCyclotomicExtension ({3} : Set ℕ) F
        (IntermediateField.adjoin F {b : Ω | ∃ n ∈ ({3} : Set ℕ), n ≠ 0 ∧ b ^ n = 1}) := by
      refine IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot
        ({3} : Set ℕ) F Ω ?_
      intro n hn _
      rw [Set.mem_singleton_iff] at hn
      subst hn
      exact ⟨ζ, hζ⟩
    have hEq : (IntermediateField.adjoin F {b : Ω | ∃ n ∈ ({3} : Set ℕ), n ≠ 0 ∧ b ^ n = 1})
        = (IntermediateField.adjoin F {ζ} : IntermediateField F Ω) := by
      refine le_antisymm ?_ ?_
      · rw [IntermediateField.adjoin_le_iff]
        intro b hb
        simp only [Set.mem_ofPred_eq] at hb
        obtain ⟨n, hn, _, hbn⟩ := hb
        rw [Set.mem_singleton_iff] at hn
        subst hn
        -- every cube root of unity in `Ω` is a power of the primitive root `ζ`
        obtain ⟨i, _, rfl⟩ := hζ.eq_pow_of_pow_eq_one hbn
        exact pow_mem (IntermediateField.mem_adjoin_simple_self F ζ) i
      · rw [IntermediateField.adjoin_le_iff]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact IntermediateField.subset_adjoin F _ ⟨3, by simp, by norm_num, hζ.pow_eq_one⟩
    have hcycK : IsCyclotomicExtension ({3} : Set ℕ) F
        (IntermediateField.adjoin F {ζ}) :=
      IsCyclotomicExtension.equiv ({3} : Set ℕ) F _
        (h := hcyc) (IntermediateField.equivOfEq hEq)
    exact IsCyclotomicExtension.isGalois ({3} : Set ℕ) F (IntermediateField.adjoin F {ζ})
  · -- the degree: `ζ` is a root of `X ^ 2 + X + 1` but not of a linear polynomial over `F`
    have hζint : IsIntegral F ζ := by
      refine IsAlgebraic.isIntegral ⟨X ^ 3 - C (1 : F), ?_, ?_⟩
      · exact (monic_X_pow_sub_C (1 : F) (by norm_num)).ne_zero
      · simp [hζ.pow_eq_one]
    have hroot : aeval ζ (X ^ 2 + X + 1 : F[X]) = 0 := by
      have hgeom := hζ.geom_sum_eq_zero (by norm_num : 1 < 3)
      simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one, zero_add] at hgeom
      simp only [map_add, map_pow, aeval_X, aeval_one]
      linear_combination hgeom
    have hdvd : minpoly F ζ ∣ (X ^ 2 + X + 1 : F[X]) := minpoly.dvd F ζ hroot
    have hdeg_le : (minpoly F ζ).natDegree ≤ 2 := by
      have h2 : (X ^ 2 + X + 1 : F[X]).natDegree = 2 := by compute_degree!
      rw [← h2]
      exact Polynomial.natDegree_le_of_dvd hdvd (by intro h0; rw [h0] at h2; simp at h2)
    have hdeg : (minpoly F ζ).natDegree = 2 := by
      have hpos := minpoly.natDegree_pos hζint
      have hne1 : (minpoly F ζ).natDegree ≠ 1 := by
        intro h1
        have hfin : Module.finrank F (IntermediateField.adjoin F {ζ}) = 1 := by
          rw [IntermediateField.adjoin.finrank hζint, h1]
        rw [IntermediateField.finrank_eq_one_iff] at hfin
        exact h (by rw [← hfin]; exact IntermediateField.mem_adjoin_simple_self F ζ)
      omega
    rw [IntermediateField.adjoin.finrank hζint, hdeg]
  · -- `ζ` itself, viewed in `F⟮ζ⟯`, is the required primitive cube root of unity
    exact ⟨⟨ζ, hζmem⟩, (mem_primitiveRoots (by norm_num)).2 hζK⟩

end Work.Tower.FrattiniLayer
