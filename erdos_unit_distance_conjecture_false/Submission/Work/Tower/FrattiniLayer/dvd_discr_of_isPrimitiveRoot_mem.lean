import Mathlib
import Submission.Work.Tower.FrattiniLayer.Basic

/-!
# `3` divides the discriminant of a number field containing a primitive cube root of unity

If `ζ ∈ F` is a primitive third root of unity in a number field `F`, then `F` contains the
quadratic subfield `K = ℚ⟮ζ⟯`, the third cyclotomic field, whose discriminant is `-3`.
Since the discriminant of a subfield divides the discriminant of the extension
(`NumberField.discr_dvd_discr`), we conclude `3 ∣ discr F`.

This is the input which forces the prime `3` to be ramified in every number field occurring
in the Frattini-layer construction of Section 3 of *Planar Point Sets with Many Unit Distances*.
-/

set_option linter.style.haveILetI false

namespace Work.Tower.FrattiniLayer

open NumberField

theorem dvd_discr_of_isPrimitiveRoot_mem (F : Type*) [Field F] [NumberField F] (ζ : F)
    (hζ : IsPrimitiveRoot ζ 3) : (3 : ℤ) ∣ NumberField.discr F := by
  -- The subfield `K = ℚ⟮ζ⟯ ⊆ F` generated by `ζ` is the third cyclotomic field.
  let K : IntermediateField ℚ F := IntermediateField.adjoin ℚ {ζ}
  haveI hcyc : IsCyclotomicExtension {3} ℚ ↥K :=
    hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  haveI : NumberField ↥K := IsCyclotomicExtension.numberField {3} ℚ ↥K
  -- Its discriminant is `-3`.
  have hdiscr : NumberField.discr ↥K = -3 := by
    rw [IsCyclotomicExtension.Rat.discr_prime 3 ↥K]
    norm_num
  -- `discr K` divides `discr F`, because `discr_dvd_discr` for the extension `F/K`.
  have hdvd : NumberField.discr ↥K ∣ NumberField.discr F :=
    NumberField.discr_dvd_discr ↥K F
  rw [hdiscr] at hdvd
  exact neg_dvd.mp hdvd

end Work.Tower.FrattiniLayer
