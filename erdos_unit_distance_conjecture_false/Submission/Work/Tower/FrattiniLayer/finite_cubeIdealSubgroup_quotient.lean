import Mathlib
import Submission.Work.Tower.FrattiniLayer.Basic

/-!
# Finiteness of the quotient of the cube-ideal subgroup by the cubes

For a number field `L`, let `G ≤ Lˣ` be the subgroup of elements `α` such that the fractional ideal
`(α)` generated by `α` is the cube of a fractional ideal of `𝓞 L` (`cubeIdealSubgroup L`), and let
`N = G ∩ (Lˣ)³` be the subgroup of cubes of `Lˣ` lying in `G`.  This file proves that `G ⧸ N` is
finite, i.e. that `CubeIdealQuotient L` is a finite type.

The argument is the classical one.  Sending `α ∈ G` to the class of a cube root of `(α)` defines a
homomorphism `G →* ClassGroup (𝓞 L)`, whose image is contained in the (finite) class group.  An
element of `G` is killed by this map exactly when it is a unit of `𝓞 L` times a cube of an element
of `Lˣ`, so the kernel of the induced map `G ⧸ N →* ClassGroup (𝓞 L)` is a quotient of
`(𝓞 L)ˣ ⧸ ((𝓞 L)ˣ)³`, which is finite by the Dirichlet unit theorem; and its cokernel is finite
because the class group is finite.  Hence `G ⧸ N` is finite.
-/

set_option linter.style.haveILetI false

namespace Work.Tower.FrattiniLayer

open NumberField
open scoped nonZeroDivisors

variable (L : Type*) [Field L] [NumberField L]

/-! ### Uniqueness of roots -/

/-- **Uniqueness of `n`-th roots among the units of the fractional ideals** of a number field:
the `n`-th power map on `(FractionalIdeal (𝓞 L)⁰ L)ˣ` is injective for `n ≠ 0`. -/
theorem units_pow_right_injective {n : ℕ} (hn : n ≠ 0) :
    Function.Injective fun 𝔞 : (FractionalIdeal (𝓞 L)⁰ L)ˣ => 𝔞 ^ n := by
  intro 𝔞 𝔟 h
  have hcount : ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 L),
      FractionalIdeal.count L v (𝔞 : FractionalIdeal (𝓞 L)⁰ L) =
        FractionalIdeal.count L v (𝔟 : FractionalIdeal (𝓞 L)⁰ L) := by
    intro v
    have key : FractionalIdeal.count L v ((𝔞 : FractionalIdeal (𝓞 L)⁰ L) ^ n) =
        FractionalIdeal.count L v ((𝔟 : FractionalIdeal (𝓞 L)⁰ L) ^ n) := by
      simpa only [Units.val_pow_eq_pow_val] using
        congrArg (fun u : (FractionalIdeal (𝓞 L)⁰ L)ˣ =>
          FractionalIdeal.count L v (u : FractionalIdeal (𝓞 L)⁰ L)) h
    simp only [FractionalIdeal.count_pow] at key
    exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) key
  apply Units.ext
  rw [← FractionalIdeal.finprod_heightOneSpectrum_factorization' (K := L) (Units.ne_zero 𝔞),
    ← FractionalIdeal.finprod_heightOneSpectrum_factorization' (K := L) (Units.ne_zero 𝔟)]
  exact finprod_congr fun v => by rw [hcount v]

/-! ### The cube root of the ideal generated by an element of `cubeIdealSubgroup L` -/

/-- A chosen cube root of the principal fractional ideal generated by `α`, for `α` in
`cubeIdealSubgroup L`. -/
noncomputable def cubeRootIdeal (α : cubeIdealSubgroup L) : (FractionalIdeal (𝓞 L)⁰ L)ˣ :=
  Classical.choose α.2

theorem cubeRootIdeal_spec (α : cubeIdealSubgroup L) :
    (cubeRootIdeal L α : FractionalIdeal (𝓞 L)⁰ L) ^ 3
      = FractionalIdeal.spanSingleton (𝓞 L)⁰ ((α : Lˣ) : L) :=
  Classical.choose_spec α.2

theorem cubeRootIdeal_one : cubeRootIdeal L 1 = 1 := by
  apply units_pow_right_injective L (n := 3) (by norm_num)
  change cubeRootIdeal L 1 ^ 3 = (1 : (FractionalIdeal (𝓞 L)⁰ L)ˣ) ^ 3
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, Units.val_one, one_pow,
    cubeRootIdeal_spec]
  simp [FractionalIdeal.spanSingleton_one]

theorem cubeRootIdeal_mul (α β : cubeIdealSubgroup L) :
    cubeRootIdeal L (α * β) = cubeRootIdeal L α * cubeRootIdeal L β := by
  apply units_pow_right_injective L (n := 3) (by norm_num)
  change cubeRootIdeal L (α * β) ^ 3 = (cubeRootIdeal L α * cubeRootIdeal L β) ^ 3
  apply Units.ext
  simp only [Units.val_pow_eq_pow_val, Units.val_mul, mul_pow, cubeRootIdeal_spec,
    FractionalIdeal.spanSingleton_mul_spanSingleton]
  congr 1

/-! ### The class group of `𝓞 L` -/

/-- The class of the principal fractional ideal generated by a unit of `L` is trivial. -/
theorem mk_toPrincipalIdeal_eq_one (b : Lˣ) :
    ClassGroup.mk L (toPrincipalIdeal (𝓞 L) L b) = 1 := by
  rw [ClassGroup.mk_eq_one_iff, Submodule.isPrincipal_iff]
  refine ⟨(b : L), ?_⟩
  rw [coe_toPrincipalIdeal, FractionalIdeal.coe_spanSingleton]

/-- An invertible fractional ideal of `𝓞 L` has trivial class in the class group if and only if it
is principal. -/
theorem classGroup_mk_eq_one_iff_mem_range (I : (FractionalIdeal (𝓞 L)⁰ L)ˣ) :
    ClassGroup.mk L I = 1 ↔ I ∈ (toPrincipalIdeal (𝓞 L) L).range := by
  rw [mem_principal_ideals_iff, ClassGroup.mk_eq_one_iff, Submodule.isPrincipal_iff]
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨a, ?_⟩
    apply Subtype.coe_injective
    simp only [FractionalIdeal.val_eq_coe, ha, FractionalIdeal.coe_spanSingleton]
  · rintro ⟨x, hx⟩
    exact ⟨x, by rw [← hx, FractionalIdeal.coe_spanSingleton]⟩

/-- An invertible fractional ideal of `𝓞 L` with trivial class in the class group is principal. -/
theorem exists_units_of_mk_eq_one {I : (FractionalIdeal (𝓞 L)⁰ L)ˣ}
    (h : ClassGroup.mk L I = 1) : ∃ b : Lˣ, toPrincipalIdeal (𝓞 L) L b = I := by
  obtain ⟨x, hx⟩ := mem_principal_ideals_iff.mp ((classGroup_mk_eq_one_iff_mem_range L I).mp h)
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact Units.ne_zero I (by rw [← hx, FractionalIdeal.spanSingleton_eq_zero_iff.mpr rfl])
  refine ⟨Units.mk0 x hx0, ?_⟩
  rw [toPrincipalIdeal_eq_iff, Units.val_mk0]
  exact hx

/-- The class of the cube root of the ideal generated by an element of `cubeIdealSubgroup L`. -/
noncomputable def cubeIdealClass : cubeIdealSubgroup L →* ClassGroup (𝓞 L) where
  toFun α := ClassGroup.mk L (cubeRootIdeal L α)
  map_one' := by rw [cubeRootIdeal_one, map_one]
  map_mul' α β := by rw [cubeRootIdeal_mul, map_mul]

/-- The class map kills the cubes of `Lˣ`. -/
theorem cubeIdealClass_eq_one_of_mem_cubePow {α : cubeIdealSubgroup L}
    (hα : (α : Lˣ) ∈ cubePow Lˣ) : cubeIdealClass L α = 1 := by
  obtain ⟨b, hb⟩ := mem_cubePow.mp hα
  have hroot : cubeRootIdeal L α = toPrincipalIdeal (𝓞 L) L b := by
    apply units_pow_right_injective L (n := 3) (by norm_num)
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, cubeRootIdeal_spec,
      coe_toPrincipalIdeal, FractionalIdeal.spanSingleton_pow, ← Units.val_pow_eq_pow_val, hb]
  rw [show cubeIdealClass L α = ClassGroup.mk L (cubeRootIdeal L α) from rfl, hroot,
    mk_toPrincipalIdeal_eq_one L]

/-! ### Units of `𝓞 L` -/

/-- The fractional ideal generated by a unit of `𝓞 L` is trivial. -/
theorem spanSingleton_eq_one_of_unit (u : (𝓞 L)ˣ) :
    FractionalIdeal.spanSingleton (𝓞 L)⁰ (algebraMap (𝓞 L) L (u : 𝓞 L)) = 1 := by
  rw [← FractionalIdeal.coeIdeal_span_singleton, Ideal.span_singleton_eq_top.mpr u.isUnit,
    FractionalIdeal.coeIdeal_top]

/-- The image in `Lˣ` of a unit of `𝓞 L` lies in `cubeIdealSubgroup L`. -/
theorem mem_cubeIdealSubgroup_units (u : (𝓞 L)ˣ) :
    Units.map (algebraMap (𝓞 L) L).toMonoidHom u ∈ cubeIdealSubgroup L := by
  refine ⟨1, ?_⟩
  rw [Units.val_one, one_pow, Units.coe_map]
  exact (spanSingleton_eq_one_of_unit L u).symm

/-- The units of `𝓞 L`, viewed in `Lˣ`, as a subgroup of `cubeIdealSubgroup L`. -/
noncomputable def unitsToCubeIdealSubgroup : (𝓞 L)ˣ →* cubeIdealSubgroup L where
  toFun u := ⟨Units.map (algebraMap (𝓞 L) L).toMonoidHom u, mem_cubeIdealSubgroup_units L u⟩
  map_one' := Subtype.ext (by simp)
  map_mul' u v := Subtype.ext (by simp)

/-- The cubes of `Lˣ` lie in the cube ideal subgroup. -/
theorem cubePow_le_cubeIdealSubgroup : cubePow Lˣ ≤ cubeIdealSubgroup L := by
  intro x hx
  obtain ⟨b, rfl⟩ := mem_cubePow.mp hx
  exact ⟨toPrincipalIdeal (𝓞 L) L b, by
    rw [coe_toPrincipalIdeal, FractionalIdeal.spanSingleton_pow, Units.val_pow_eq_pow_val]⟩

/-! ### A finitely generated commutative group modulo its cubes is finite -/

/-- A finitely generated commutative group has only finitely many classes modulo the subgroup
generated by its cubes. -/
theorem finite_quotient_cubePow (A : Type*) [CommGroup A] [Group.FG A] :
    Finite (A ⧸ cubePow A) := by
  haveI : Group.FG (A ⧸ cubePow A) :=
    Group.fg_of_surjective (QuotientGroup.mk'_surjective (cubePow A))
  refine CommGroup.finite_of_fg_isMulTorsion (A ⧸ cubePow A) fun x => ?_
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (cubePow A) x
  rw [isOfFinOrder_iff_pow_eq_one]
  refine ⟨3, by norm_num, ?_⟩
  rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact ⟨a, rfl⟩

/-- The quotient of the units of `𝓞 L` by its cubes is finite (Dirichlet's unit theorem). -/
instance finite_units_quotient_cubePow : Finite ((𝓞 L)ˣ ⧸ cubePow (𝓞 L)ˣ) := by
  haveI : Group.FG (𝓞 L)ˣ := Group.fg_iff_monoid_fg.mpr inferInstance
  exact finite_quotient_cubePow (𝓞 L)ˣ

/-! ### The two comparison maps -/

/-- The class map `G →* ClassGroup (𝓞 L)`, descended to the quotient of `G` by its cubes. -/
noncomputable def cubeIdealClassQuotient : CubeIdealQuotient L →* ClassGroup (𝓞 L) :=
  QuotientGroup.lift ((cubePow Lˣ).subgroupOf (cubeIdealSubgroup L)) (cubeIdealClass L) (by
    intro x hx
    rw [MonoidHom.mem_ker]
    exact cubeIdealClass_eq_one_of_mem_cubePow L (Subgroup.mem_subgroupOf.mp hx))

@[simp]
theorem cubeIdealClassQuotient_mk (α : cubeIdealSubgroup L) :
    cubeIdealClassQuotient L (QuotientGroup.mk' _ α) = cubeIdealClass L α :=
  QuotientGroup.lift_mk' _ _ α

/-- The units of `𝓞 L`, modulo cubes, mapped to `CubeIdealQuotient L`. -/
noncomputable def unitsQuotientToCubeIdealQuotient :
    ((𝓞 L)ˣ ⧸ cubePow (𝓞 L)ˣ) →* CubeIdealQuotient L :=
  QuotientGroup.lift (cubePow (𝓞 L)ˣ)
    ((QuotientGroup.mk' ((cubePow Lˣ).subgroupOf (cubeIdealSubgroup L))).comp
      (unitsToCubeIdealSubgroup L)) (by
    intro u hu
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    obtain ⟨w, rfl⟩ := mem_cubePow.mp hu
    refine Subgroup.mem_subgroupOf.mpr ?_
    rw [map_pow, Subgroup.coe_pow]
    exact mem_cubePow.mpr ⟨_, rfl⟩)

@[simp]
theorem unitsQuotientToCubeIdealQuotient_mk (u : (𝓞 L)ˣ) :
    unitsQuotientToCubeIdealQuotient L (QuotientGroup.mk' _ u)
      = QuotientGroup.mk' _ (unitsToCubeIdealSubgroup L u) :=
  QuotientGroup.lift_mk' _ _ u

/-- An element of `cubeIdealSubgroup L` whose class in the class group is trivial is the product of
a unit of `𝓞 L` and a cube. -/
theorem exists_units_mul_cube_of_cubeIdealClass_eq_one {α : cubeIdealSubgroup L}
    (hα : cubeIdealClass L α = 1) :
    ∃ (u : (𝓞 L)ˣ) (b : Lˣ),
      (α : Lˣ) = Units.map (algebraMap (𝓞 L) L).toMonoidHom u * b ^ 3 := by
  obtain ⟨b, hb⟩ := exists_units_of_mk_eq_one L
    (show ClassGroup.mk L (cubeRootIdeal L α) = 1 from hα)
  have hc : FractionalIdeal.spanSingleton (𝓞 L)⁰ ((b : L) ^ 3)
      = FractionalIdeal.spanSingleton (𝓞 L)⁰ ((α : Lˣ) : L) := by
    rw [← FractionalIdeal.spanSingleton_pow, ← coe_toPrincipalIdeal, hb, cubeRootIdeal_spec]
  obtain ⟨z, hz⟩ := FractionalIdeal.spanSingleton_eq_spanSingleton.mp hc
  refine ⟨z, b, ?_⟩
  apply Units.ext
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.coe_map]
  have hz' : (algebraMap (𝓞 L) L) (z : 𝓞 L) * (b : L) ^ 3 = ((α : Lˣ) : L) := by
    simpa [Units.smul_def, Algebra.smul_def] using hz
  rw [← hz']
  rfl

/-! ### The main theorem -/

theorem finite_cubeIdealSubgroup_quotient (L : Type*) [Field L] [NumberField L] :
    Finite (Work.Tower.FrattiniLayer.CubeIdealQuotient L) := by
  classical
  -- The kernel of the class map is contained in the image of the units.
  have hker_le : (cubeIdealClassQuotient L).ker ≤ (unitsQuotientToCubeIdealQuotient L).range := by
    intro y hy
    obtain ⟨α, rfl⟩ := QuotientGroup.mk'_surjective _ y
    rw [MonoidHom.mem_ker, cubeIdealClassQuotient_mk] at hy
    obtain ⟨u, b, hu⟩ := exists_units_mul_cube_of_cubeIdealClass_eq_one L hy
    refine ⟨QuotientGroup.mk' _ u, ?_⟩
    rw [unitsQuotientToCubeIdealQuotient_mk]
    -- the element `b ^ 3` of `cubeIdealSubgroup L` lies in the subgroup of cubes
    have hb3mem : (⟨b ^ 3, cubePow_le_cubeIdealSubgroup L (mem_cubePow.mpr ⟨b, rfl⟩)⟩ :
        cubeIdealSubgroup L) ∈ (cubePow Lˣ).subgroupOf (cubeIdealSubgroup L) :=
      Subgroup.mem_subgroupOf.mpr (mem_cubePow.mpr ⟨b, rfl⟩)
    have hαeq : α = unitsToCubeIdealSubgroup L u *
        (⟨b ^ 3, cubePow_le_cubeIdealSubgroup L (mem_cubePow.mpr ⟨b, rfl⟩)⟩ :
          cubeIdealSubgroup L) := by
      apply Subtype.ext
      change (α : Lˣ) = Units.map (algebraMap (𝓞 L) L).toMonoidHom u * b ^ 3
      exact hu
    have hb1 : (QuotientGroup.mk' ((cubePow Lˣ).subgroupOf (cubeIdealSubgroup L)))
        (⟨b ^ 3, cubePow_le_cubeIdealSubgroup L (mem_cubePow.mpr ⟨b, rfl⟩)⟩ :
          cubeIdealSubgroup L) = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact hb3mem
    rw [hαeq, map_mul, hb1, mul_one]
  -- The range of the units map is finite, hence so is the kernel of the class map.
  haveI : Finite ↥(unitsQuotientToCubeIdealQuotient L).range :=
    Finite.of_surjective (MonoidHom.rangeRestrict (unitsQuotientToCubeIdealQuotient L))
      (MonoidHom.rangeRestrict_surjective _)
  haveI : Finite ↥((cubeIdealClassQuotient L).ker) :=
    Finite.of_injective
      (fun x : ↥((cubeIdealClassQuotient L).ker) =>
        (⟨(x : CubeIdealQuotient L), hker_le x.2⟩ :
          ↥(unitsQuotientToCubeIdealQuotient L).range))
      (fun a b h => Subtype.ext (congrArg (fun y : ↥(unitsQuotientToCubeIdealQuotient L).range =>
        (y : CubeIdealQuotient L)) h))
  -- The quotient by the kernel is finite, being the (finite) range of the class map.
  haveI : Finite (CubeIdealQuotient L ⧸ (cubeIdealClassQuotient L).ker) :=
    Finite.of_equiv ↥(cubeIdealClassQuotient L).range
      (QuotientGroup.quotientKerEquivRange (cubeIdealClassQuotient L)).symm
  exact Finite.of_subgroup_quotient (cubeIdealClassQuotient L).ker

end Work.Tower.FrattiniLayer
