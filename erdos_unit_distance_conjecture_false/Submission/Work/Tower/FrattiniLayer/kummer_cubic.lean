import Mathlib
import Submission.Work.Tower.FrattiniLayer.Basic

/-!
# Kummer theory for cubic extensions

If `M/L` is a finite Galois extension of degree `3` and `L` contains a primitive cube root of
unity `ζ`, then `M = L⟮β⟯` for some `β` with `β ^ 3 ∈ L`: Kummer theory in the first non-trivial
case.

The argument is the classical one.  Since `[M : L] = 3`, the Galois group of `M/L` is cyclic of
order `3`, generated by an automorphism `g`.  The Lagrange resolvents `T` and `T'` with respect to
the two nontrivial cube roots of unity produce eigenvectors of `g` with eigenvalue a primitive
cube root of unity: if `T x ≠ 0` then `T x` is such an eigenvector, and if both resolvents
vanished identically then `x + g x + g² x = 3 x` for all `x`, forcing `g = id`.  An eigenvector
`β` with `g β = λ β`, `λ ^ 3 = 1`, `λ ≠ 1` then satisfies `g (β ^ 3) = β ^ 3`, so `β ^ 3` lies in
the fixed field `L`, while `β ∉ L` because `λ ≠ 1`; as `3` is prime, `L⟮β⟯ = M`.
-/

open IntermediateField

namespace Work.Tower.FrattiniLayer

theorem kummer_cubic {L M : Type*} [Field L] [Field M] [Algebra L M] [FiniteDimensional L M]
    [IsGalois L M] (h3 : Module.finrank L M = 3) (hζ : (primitiveRoots 3 L).Nonempty) :
    ∃ (α : Lˣ) (β : M),
      β ^ 3 = algebraMap L M (α : L) ∧ IntermediateField.adjoin L {β} = ⊤ := by
  classical
  -- The Galois group has order `3`, hence is cyclic, with generator `g` of order `3`.
  have hcard : Nat.card (M ≃ₐ[L] M) = 3 := by
    rw [IsGalois.card_aut_eq_finrank L M, h3]
  have hcyc : IsCyclic (M ≃ₐ[L] M) :=
    @isCyclic_of_prime_card (M ≃ₐ[L] M) _ 3 ⟨by norm_num⟩ hcard
  obtain ⟨g, hg⟩ := @IsCyclic.exists_generator (M ≃ₐ[L] M) _ hcyc
  have hord : orderOf g = 3 := by rw [orderOf_eq_card_of_forall_mem_zpowers hg, hcard]
  have hg3 : g ^ 3 = 1 := by rw [← hord]; exact pow_orderOf_eq_one g
  have hgne : g ≠ 1 := by
    intro h; rw [h, orderOf_one] at hord; exact absurd hord (by norm_num)
  have hggg : g * g * g = 1 := by
    have := hg3; rwa [pow_succ, pow_two] at this
  have hg3x : ∀ x : M, g (g (g x)) = x := by
    intro x
    have h : (g * g * g) x = x := by rw [hggg, AlgEquiv.one_apply]
    simpa only [AlgEquiv.mul_apply] using h
  -- A primitive cube root of unity `ζ`, and its image `ζM` in `M`.
  obtain ⟨ζ, hζmem⟩ := hζ
  have hζp : IsPrimitiveRoot ζ 3 := (mem_primitiveRoots (by norm_num)).1 hζmem
  have hζpow : ζ ^ 3 = 1 := hζp.pow_eq_one
  have hζsum : 1 + ζ + ζ ^ 2 = 0 := by
    have h := hζp.geom_sum_eq_zero (by norm_num : 1 < 3)
    simpa [Finset.sum_range_succ] using h
  have hζne : ζ ≠ 1 := hζp.ne_one (by norm_num)
  set ζM : M := algebraMap L M ζ with hζM
  have hζM3 : ζM ^ 3 = 1 := by rw [hζM, ← map_pow, hζpow, map_one]
  have hζMsum : 1 + ζM + ζM ^ 2 = 0 := by
    have h : algebraMap L M (1 + ζ + ζ ^ 2) = 0 := by rw [hζsum, map_zero]
    simpa [hζM] using h
  have hζMneq1 : ζM ≠ 1 := by
    intro h
    exact hζne (FaithfulSMul.algebraMap_injective L M (by rw [← hζM, h, map_one]))
  have h3M : (3 : M) ≠ 0 := by
    intro h3z
    have hsq : (ζM - 1) ^ 2 = 0 := by linear_combination hζMsum - ζM * h3z
    exact hζMneq1 (sub_eq_zero.1 ((pow_eq_zero_iff (by norm_num : (2:ℕ) ≠ 0)).1 hsq))
  have hgζ : g ζM = ζM := by rw [hζM]; exact AlgEquiv.commutes g ζ
  -- Lagrange resolvents produce an eigenvector of `g` with a primitive cube root eigenvalue.
  have hex : ∃ (mu : M) (β : M), mu ^ 3 = 1 ∧ mu ≠ 1 ∧ β ≠ 0 ∧ g β = mu * β := by
    by_cases hT : ∃ x : M, x + ζM ^ 2 * g x + ζM * g (g x) ≠ 0
    · obtain ⟨x, hx⟩ := hT
      refine ⟨ζM, x + ζM ^ 2 * g x + ζM * g (g x), hζM3, hζMneq1, hx, ?_⟩
      have h := hg3x x
      simp only [map_add, map_mul, map_pow, hgζ, h]
      linear_combination -(g x) * hζM3
    · simp only [not_exists, not_not] at hT
      by_cases hT' : ∃ x : M, x + ζM * g x + ζM ^ 2 * g (g x) ≠ 0
      · obtain ⟨x, hx⟩ := hT'
        refine ⟨ζM ^ 2, x + ζM * g x + ζM ^ 2 * g (g x), ?_, ?_, hx, ?_⟩
        · rw [← pow_mul, show 2 * 3 = 3 * 2 by norm_num, pow_mul, hζM3, one_pow]
        · intro h
          have h3' : ζM ^ 3 = ζM := by rw [pow_succ, h, one_mul]
          exact hζMneq1 (h3'.symm.trans hζM3)
        · have hz4 : ζM ^ 4 = ζM := by
            rw [show (4:ℕ) = 3 + 1 by norm_num, pow_succ, hζM3, one_mul]
          have h := hg3x x
          simp only [map_add, map_mul, map_pow, hgζ, h]
          linear_combination -(g x) * hζM3 - (g (g x)) * hz4
      · simp only [not_exists, not_not] at hT'
        exfalso
        -- If both resolvents vanish then `g` would be the identity, contradicting `orderOf g = 3`.
        have hS : ∀ x : M, x + g x + g (g x) = 3 * x := by
          intro x
          have h1 := hT x
          have h2 := hT' x
          linear_combination -h1 - h2 + (g x + g (g x)) * hζMsum
        have hfixall : ∀ x : M, g x = x := by
          intro x
          have hx1 := hS x
          have hx2 := hS (g x)
          rw [hg3x x] at hx2
          have hc : (3 : M) * x = 3 * g x := by rw [← hx1, ← hx2]; ring
          exact (mul_left_cancel₀ h3M hc).symm
        exact hgne (AlgEquiv.ext hfixall)
  obtain ⟨mu, β, hmu3, hmu1, hβne, hgβ⟩ := hex
  -- `β ^ 3` is fixed by `g`, hence lies in `L`.
  have hgβ3 : g (β ^ 3) = β ^ 3 := by
    rw [map_pow, hgβ, mul_pow, hmu3, one_mul]
  have hginv : g⁻¹ (β ^ 3) = β ^ 3 := by
    have h : g⁻¹ (g (β ^ 3)) = β ^ 3 := by simp
    rwa [hgβ3] at h
  have hgk : ∀ k : ℤ, (g ^ k) (β ^ 3) = β ^ 3 := fun k =>
    Int.induction_on k (by simp)
      (fun n ih => by rw [zpow_add_one, AlgEquiv.mul_apply, hgβ3, ih])
      (fun n ih => by rw [zpow_sub_one, AlgEquiv.mul_apply, hginv, ih])
  have hfix : ∀ f : Gal(M/L), f (β ^ 3) = β ^ 3 := by
    intro f
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hg f)
    rw [← hk]
    exact hgk k
  have hβ3mem : β ^ 3 ∈ (⊥ : IntermediateField L M) :=
    (IsGalois.mem_bot_iff_fixed (β ^ 3)).2 hfix
  obtain ⟨a, ha⟩ := Set.mem_range.1 (IntermediateField.mem_bot.1 hβ3mem)
  have ha0 : a ≠ 0 := by
    intro h
    rw [h, map_zero] at ha
    exact pow_ne_zero 3 hβne ha.symm
  -- `β ∉ L` since `g β = mu * β` with `mu ≠ 1`.
  have hβnotbot : β ∉ (⊥ : IntermediateField L M) := by
    intro hmem
    have hfixβ : ∀ f : Gal(M/L), f β = β := (IsGalois.mem_bot_iff_fixed β).1 hmem
    have hgg : mu * β = β := by rw [← hgβ]; exact hfixβ g
    exact hmu1 ((mul_eq_right₀ hβne).1 hgg)
  refine ⟨Units.mk0 a ha0, β, ?_, ?_⟩
  · rw [Units.val_mk0]; exact ha.symm
  · -- Since `3 = [M : L]` is prime and `β ∉ L`, one has `L⟮β⟯ = M`.
    set K : IntermediateField L M := IntermediateField.adjoin L {β} with hK
    have hβK : β ∈ K := by
      rw [hK]; exact IntermediateField.subset_adjoin L {β} (Set.mem_singleton β)
    have hKne : K ≠ ⊥ := fun hKb => hβnotbot (hKb ▸ hβK)
    have hmul : Module.finrank L K * Module.finrank K M = 3 := by
      rw [Module.finrank_mul_finrank L K M, h3]
    have hdvd : Module.finrank L K ∣ 3 := ⟨Module.finrank K M, hmul.symm⟩
    have hLK3 : Module.finrank L K = 3 := by
      rcases (Nat.dvd_prime (by norm_num : Nat.Prime 3)).1 hdvd with h1 | h3'
      · exact absurd (IntermediateField.finrank_eq_one_iff.1 h1) hKne
      · exact h3'
    have hKM1 : Module.finrank K M = 1 := by
      have := hmul; rw [hLK3] at this; omega
    exact IntermediateField.finrank_eq_one_iff_eq_top.1 hKM1

end Work.Tower.FrattiniLayer
