import Mathlib
import Submission.Work.Tower.CyclotomicBase.Defs
import Submission.Work.Tower.CyclotomicBase.Basic
import Submission.Work.Tower.CyclotomicBase.Lfield_cubic
import Submission.Work.Tower.CyclotomicBase.CubicDiscriminantGen

set_option linter.style.haveILetI false

namespace Work.Tower.CyclotomicBase

/-!
# The discriminant of the cubic subfields `Lᵢ`

This file proves that the cubic subfield `Lᵢ ⊆ ℚ(ζ_D)` cut out by the `i`-th cubic character
`χᵢ` (of conductor `rᵢ`) has field discriminant of absolute value `rᵢ ^ 2`.

The argument is short once the geometry is in place: the character `χᵢ` factors through the
reduction `(ℤ/D)ˣ → (ℤ/rᵢ)ˣ`, so `Lᵢ` is cut out by a subgroup containing
`otherSub r i = ker((ℤ/D)ˣ → (ℤ/rᵢ)ˣ)`.  Hence `Lᵢ ⊆ Wᵢ`, where `Wᵢ = ℚ(ζ_{rᵢ})` is the field
fixed by `otherSub r i`.  Viewing `Lᵢ` as a cubic intermediate field of the `{rᵢ}`-cyclotomic
extension `Wᵢ/ℚ` then gives `|disc Lᵢ| = rᵢ ^ 2` by `CubicDiscriminantGen`.
-/

open NumberField

/-- The subfield `Wᵢ ⊆ ℚ(ζ_D)` fixed by the units congruent to `1` modulo `rᵢ` is the `rᵢ`-th
cyclotomic field `ℚ(ζ_{rᵢ})`: it is generated by `ζ_D ^ (D / rᵢ)`, a primitive `rᵢ`-th root of
unity.

The proof is the mirror image of `isCyclotomicExtension_Zfield` with the roles of `rᵢ` and
`D / rᵢ` exchanged:

* `ℚ⟮ζ^(D/rᵢ)⟯ ≤ Wᵢ` because `σ ∈ otherSub r i` satisfies `σ ≡ 1 (mod rᵢ)` and hence fixes every
  `rᵢ`-th root of unity (`galEquivZMod_apply_of_pow_eq`);
* the reverse inclusion follows from `[ℚ⟮ζ^(D/rᵢ)⟯ : ℚ] = φ(rᵢ) = [Wᵢ : ℚ]`, the latter being the
  index of `otherSub r i`, computed as `#((ℤ/rᵢ)ˣ)` via the surjectivity of `ZMod.unitsMap`. -/
theorem wfield_isCyclotomicExtension {ℓ : ℕ} (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    [NeZero (D r)] (i : Fin ℓ) :
    IsCyclotomicExtension {r i} ℚ ↥(Wfield r i) := by
  haveI hcyc : IsCyclotomicExtension {D r} ℚ (Cyc r) := isCyclotomicExtension_cyc r
  haveI hgal : IsGalois ℚ (Cyc r) := IsCyclotomicExtension.isGalois {D r} ℚ (Cyc r)
  haveI hint : Algebra.IsIntegral ℚ (Cyc r) := IsCyclotomicExtension.integral {D r} ℚ (Cyc r)
  -- a primitive `D`-th root of unity; its `(D / rᵢ)`-th power is a primitive `rᵢ`-th root
  let ζ : Cyc r := IsCyclotomicExtension.zeta (D r) ℚ (Cyc r)
  have hζ : IsPrimitiveRoot ζ (D r) := IsCyclotomicExtension.zeta_spec (D r) ℚ (Cyc r)
  have hri0 : r i ≠ 0 := (hr i).ne_zero
  have hD0 : D r ≠ 0 := NeZero.ne (D r)
  have hmi0 : (D r) / (r i) ≠ 0 := by
    intro h
    have h1 := Nat.div_mul_cancel (r_dvd_D r i)
    rw [h, zero_mul] at h1
    exact hD0 h1.symm
  haveI hriz : NeZero (r i) := ⟨hri0⟩
  have hζi : IsPrimitiveRoot (ζ ^ ((D r) / (r i))) (r i) := by
    have h := hζ.pow_of_dvd hmi0 (div_r_dvd_D r i)
    rwa [Nat.div_div_self (r_dvd_D r i) hD0] at h
  -- `ζ^(D/rᵢ)` is fixed by the inertia subgroup
  have hmem : ζ ^ ((D r) / (r i)) ∈ Wfield r i := by
    rw [Wfield, IntermediateField.mem_fixedField_iff]
    intro f hf
    -- the exponent `a` attached to `f` is `1` modulo `rᵢ`
    have hv : (galEquiv r f).val.val ≡ 1 [MOD r i] := by
      have h : (ZMod.unitsMap (r_dvd_D r i)) (galEquiv r f) = 1 := by
        simpa [otherSub, Subgroup.mem_comap] using hf
      have hcast : ((galEquiv r f : ZMod (D r)).cast : ZMod (r i)) = 1 := by
        rw [← ZMod.unitsMap_val (r_dvd_D r i) (galEquiv r f), h, Units.val_one]
      have h3 : ((galEquiv r f).val.val : ZMod (r i)) = 1 := by
        rw [← ZMod.cast_natCast (r_dvd_D r i) (galEquiv r f).val.val, ZMod.natCast_zmod_val]
        exact hcast
      exact (ZMod.natCast_eq_natCast_iff ((galEquiv r f).val.val) 1 (r i)).mp
        (by simpa using h3)
    have hbD : (ζ ^ ((D r) / (r i))) ^ (D r) = 1 := by
      rw [← pow_mul, Nat.mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
    -- `f` acts on any `D`-th root of unity as `x ↦ x ^ a`
    have hact := IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq (D r) (Cyc r) f hbD
    have hof : IsOfFinOrder (ζ ^ ((D r) / (r i))) := hζi.isOfFinOrder hri0
    have hmod : (galEquiv r f).val.val ≡ 1 [MOD orderOf (ζ ^ ((D r) / (r i)))] :=
      Nat.ModEq.of_dvd (orderOf_dvd_of_pow_eq_one hζi.pow_eq_one) hv
    rw [hact]
    rw [show (IsCyclotomicExtension.Rat.galEquivZMod (D r) (Cyc r) f).val.val =
      (galEquiv r f).val.val from rfl]
    simpa using (IsOfFinOrder.pow_eq_pow_iff_modEq hof).mpr hmod
  -- `[Wᵢ : ℚ] = φ(rᵢ)`
  have hfrW : Module.finrank ℚ ↥(Wfield r i) = (r i).totient := by
    rw [IntermediateField.finrank_eq_fixingSubgroup_index (L := Wfield r i), fixingSubgroup_Wfield]
    have hidx : (Subgroup.comap (galEquiv r).toMonoidHom (otherSub r i)).index =
        (otherSub r i).index :=
      Subgroup.index_comap_of_surjective (otherSub r i) (galEquiv r).surjective
    rw [hidx, otherSub, Subgroup.index_ker]
    rw [show (ZMod.unitsMap (r_dvd_D r i)).range = ⊤ from
      MonoidHom.range_eq_top.mpr (ZMod.unitsMap_surjective (r_dvd_D r i)),
      Nat.card_congr (Subgroup.topEquiv (G := (ZMod (r i))ˣ)).toEquiv,
      Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
  -- `[ℚ⟮ζ^(D/rᵢ)⟯ : ℚ] = φ(rᵢ)`
  haveI hcycAd : IsCyclotomicExtension {r i} ℚ
      ↥(IntermediateField.adjoin ℚ ({ζ ^ ((D r) / (r i))} : Set (Cyc r))) :=
    hζi.intermediateField_adjoin_isCyclotomicExtension ℚ
  have hfrA : Module.finrank ℚ ↥(IntermediateField.adjoin ℚ ({ζ ^ ((D r) / (r i))} : Set (Cyc r)))
      = (r i).totient :=
    IsCyclotomicExtension.finrank _
      (Polynomial.cyclotomic.irreducible_rat (Nat.pos_of_ne_zero hri0))
  -- hence the two fields coincide
  have hle : IntermediateField.adjoin ℚ ({ζ ^ ((D r) / (r i))} : Set (Cyc r)) ≤ Wfield r i := by
    rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    exact hmem
  have heq : Wfield r i = IntermediateField.adjoin ℚ ({ζ ^ ((D r) / (r i))} : Set (Cyc r)) :=
    (IntermediateField.eq_of_le_of_finrank_le hle (by rw [hfrW, hfrA])).symm
  exact IsCyclotomicExtension.equiv {r i} ℚ
    ↥(IntermediateField.adjoin ℚ ({ζ ^ ((D r) / (r i))} : Set (Cyc r)))
    (IntermediateField.equivOfEq heq.symm)

/-- The cubic subfield `Lᵢ ⊆ ℚ(ζ_D)` cut out by the `i`-th cubic character `χᵢ` has field
discriminant of absolute value `rᵢ ^ 2`.

`Lᵢ` is contained in `Wᵢ = ℚ(ζ_{rᵢ})`, which is an `{rᵢ}`-cyclotomic extension of `ℚ`; viewed
there, `Lᵢ` is a cubic intermediate field (degree `3`, totally real), so
`CubicDiscriminantGen` applies. -/
theorem disc_Lfield {ℓ : ℕ} (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) :
    |NumberField.discr ↥(Lfield r hr hr3 i)| = ((r i : ℕ) : ℤ) ^ 2 := by
  -- `Wᵢ = ℚ(ζ_{rᵢ})` is a cyclotomic extension of `ℚ` of conductor `rᵢ`
  haveI hcycW : IsCyclotomicExtension {r i} ℚ ↥(Wfield r i) := wfield_isCyclotomicExtension r hr i
  -- `Lᵢ ⊆ Wᵢ`, so `Lᵢ` is an intermediate field of `Wᵢ/ℚ`
  have hle : Lfield r hr hr3 i ≤ Wfield r i := Lfield_le_Wfield r hr hr3 i
  let f : ↥(Lfield r hr hr3 i) →ₐ[ℚ] ↥(Wfield r i) := IntermediateField.inclusion hle
  let F : IntermediateField ℚ ↥(Wfield r i) := f.fieldRange
  -- the image of `Lᵢ` in `Wᵢ` is `ℚ`-isomorphic to `Lᵢ`
  let e : ↥(Lfield r hr hr3 i) ≃ₐ[ℚ] ↥F := f.equivFieldRange
  have hcube := Lfield_cubic r hr hr3 i
  have hfin : Module.finrank ℚ ↥F = 3 := by
    rw [← e.toLinearEquiv.finrank_eq]
    exact hcube.1
  have hreal : NumberField.IsTotallyReal ↥F := by
    haveI : NumberField.IsTotallyReal ↥(Lfield r hr hr3 i) := hcube.2.2
    exact NumberField.IsTotallyReal.ofRingEquiv e.toRingEquiv
  have hdiscF := CubicDiscriminantGen (r i) (hr i) (hr3 i) ↥(Wfield r i) F hfin hreal
  -- `discr` is invariant under the `ℚ`-algebra isomorphism
  have hdisc : NumberField.discr ↥(Lfield r hr hr3 i) = NumberField.discr ↥F :=
    NumberField.discr_eq_discr_of_algEquiv ↥(Lfield r hr hr3 i) e
  rw [hdisc]
  exact hdiscF

end Work.Tower.CyclotomicBase
