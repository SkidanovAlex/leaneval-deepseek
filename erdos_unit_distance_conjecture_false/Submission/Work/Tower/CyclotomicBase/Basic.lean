import Submission.Work.Tower.CyclotomicBase.Defs
import Submission.Work.Tower.CyclotomicBase.fixedField_iInf_eq_iSup
import Submission.Work.Tower.CyclotomicBase.Lfield_cubic
import Submission.Work.Tower.CyclotomicBase.Mfield_eq_iSup_Lfield

/-!
# The cyclotomic base of the tower: basic structure

This file collects the elementary consequences of the setup in
`Submission.Work.Tower.CyclotomicBase.Defs`: the Galois property of the partial composita `Mof s`,
the inclusions between the various subfields of `ℚ(ζ_D)`, and the surjectivity of the characters.
-/

set_option linter.style.haveILetI false
set_option autoImplicit false

open NumberField
open scoped Classical nonZeroDivisors

namespace Work.Tower.CyclotomicBase

variable {ℓ : ℕ}

/-! ## Applying the characters -/

lemma galCoord_apply (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) (σ : Gal(Cyc r/ℚ)) :
    galCoord r hr hr3 i σ = coordChar r hr hr3 i ((galEquiv r) σ) := rfl

theorem galCoord_surjective (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) :
    Function.Surjective (galCoord r hr hr3 i) := by
  have h : Function.Surjective (fun σ : Gal(Cyc r/ℚ) =>
      coordChar r hr hr3 i ((galEquiv r).toMonoidHom σ)) :=
    Function.Surjective.comp (coordChar_surjective r hr hr3 i) (galEquiv r).surjective
  exact h

theorem galMap_ker_eq_iInf (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    (galMap r hr hr3).ker = ⨅ i, (galCoord r hr hr3 i).ker := by
  ext σ
  rw [MonoidHom.mem_ker, Subgroup.mem_iInf]
  constructor
  · intro h i
    show galCoord r hr hr3 i σ = 1
    exact congrFun h i
  · intro h
    funext i
    exact h i

/-! ## Inclusions between the subfields -/

theorem Lfield_le_Mfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) :
    Lfield r hr hr3 i ≤ Mfield r hr hr3 := by
  rw [Lfield, Mfield]
  refine IntermediateField.fixedField_antitone ?_
  intro σ hσ
  rw [MonoidHom.mem_ker] at hσ ⊢
  rw [← galMap_apply r hr hr3 σ i]
  exact congrFun hσ i

theorem Ffield_le_Mfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    Ffield r hr hr3 ≤ Mfield r hr hr3 := by
  rw [Ffield, Mfield]
  refine IntermediateField.fixedField_antitone ?_
  intro σ hσ
  rw [MonoidHom.mem_ker] at hσ ⊢
  rw [MonoidHom.comp_apply, hσ, map_one]

/-! ## The field `Wᵢ = ℚ(ζ_{rᵢ})` and `Lᵢ ⊆ Wᵢ` -/

/-- The subgroup of `(ℤ/D)ˣ` of units congruent to `1` modulo `rᵢ`: the Galois group of
`ℚ(ζ_D)/ℚ(ζ_{rᵢ})`. -/
def otherSub (r : Fin ℓ → ℕ) (i : Fin ℓ) : Subgroup (ZMod (D r))ˣ :=
  (ZMod.unitsMap (r_dvd_D r i)).ker

/-- The subfield of `ℚ(ζ_D)` generated by the primitive `rᵢ`-th root of unity `ζ_D^(D/rᵢ)`:
the field `ℚ(ζ_{rᵢ})`. -/
noncomputable def Wfield (r : Fin ℓ → ℕ) [NeZero (D r)] (i : Fin ℓ) :
    IntermediateField ℚ (Cyc r) :=
  IntermediateField.fixedField ((otherSub r i).comap (galEquiv r).toMonoidHom)

lemma fixingSubgroup_Wfield (r : Fin ℓ → ℕ) [NeZero (D r)] (i : Fin ℓ) :
    (Wfield r i).fixingSubgroup = (otherSub r i).comap (galEquiv r).toMonoidHom :=
  IntermediateField.fixingSubgroup_fixedField _

lemma isGalois_Wfield (r : Fin ℓ → ℕ) [NeZero (D r)] (i : Fin ℓ) : IsGalois ℚ ↥(Wfield r i) := by
  haveI := isCyclotomicExtension_cyc r
  haveI hG : IsGalois ℚ (Cyc r) := IsCyclotomicExtension.isGalois {D r} ℚ (Cyc r)
  haveI := IsCyclotomicExtension.isAbelianGalois {D r} ℚ (Cyc r)
  exact IsGalois.of_fixedField_normal_subgroup _

theorem Lfield_le_Wfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) :
    Lfield r hr hr3 i ≤ Wfield r i := by
  rw [Lfield, Wfield]
  refine IntermediateField.fixedField_antitone ?_
  intro σ hσ
  rw [Subgroup.mem_comap, otherSub, MonoidHom.mem_ker] at hσ
  rw [MonoidHom.mem_ker]
  show coordChar r hr hr3 i ((galEquiv r).toMonoidHom σ) = 1
  simp only [coordChar, MonoidHom.comp_apply]
  rw [hσ, map_one]

/-! ## The partial composita `Mof s` -/

/-- The compositum of the cubic subfields `Lᵢ` for `i ∈ s`. -/
noncomputable def Mof (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i)) (hr3 : ∀ i, r i % 3 = 1)
    [NeZero (D r)] (s : Finset (Fin ℓ)) : IntermediateField ℚ (Cyc r) :=
  IntermediateField.fixedField (⨅ i ∈ s, (galCoord r hr hr3 i).ker)

theorem Mof_eq_iSup (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (s : Finset (Fin ℓ)) :
    Mof r hr hr3 s = ⨆ i ∈ s, Lfield r hr hr3 i := by
  haveI := isCyclotomicExtension_cyc r
  haveI hG : IsGalois ℚ (Cyc r) := IsCyclotomicExtension.isGalois {D r} ℚ (Cyc r)
  rw [Mof, iInf_subtype', fixedField_iInf_eq_iSup, iSup_subtype']
  rfl

@[simp] lemma Mof_empty (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] : Mof r hr hr3 ∅ = ⊥ := by
  rw [Mof_eq_iSup]
  simp

lemma Mof_insert (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) (s : Finset (Fin ℓ)) :
    Mof r hr hr3 (insert i s) = Mof r hr hr3 s ⊔ Lfield r hr hr3 i := by
  rw [Mof_eq_iSup, Mof_eq_iSup, Finset.iSup_insert]
  exact sup_comm _ _

lemma isGalois_Mof (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (s : Finset (Fin ℓ)) :
    IsGalois ℚ ↥(Mof r hr hr3 s) := by
  haveI := isCyclotomicExtension_cyc r
  haveI hG : IsGalois ℚ (Cyc r) := IsCyclotomicExtension.isGalois {D r} ℚ (Cyc r)
  haveI := IsCyclotomicExtension.isAbelianGalois {D r} ℚ (Cyc r)
  rw [Mof]
  exact IsGalois.of_fixedField_normal_subgroup _

lemma Mof_univ (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    Mof r hr hr3 Finset.univ = Mfield r hr hr3 := by
  refine le_antisymm ?_ ?_
  · rw [Mof_eq_iSup, Mfield_eq_iSup_Lfield]
    refine iSup_le fun i => iSup_le fun _ => ?_
    exact le_iSup (fun i => Lfield r hr hr3 i) i
  · rw [Mof_eq_iSup, Mfield_eq_iSup_Lfield]
    refine iSup_le fun i => ?_
    exact le_iSup_of_le i (le_iSup_of_le (Finset.mem_univ i) le_rfl)

lemma Mof_le_Mfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (s : Finset (Fin ℓ)) :
    Mof r hr hr3 s ≤ Mfield r hr hr3 := by
  rw [Mof_eq_iSup, Mfield_eq_iSup_Lfield]
  refine iSup_le fun i => iSup_le fun _ => ?_
  exact le_iSup (fun i => Lfield r hr hr3 i) i

lemma Mof_mono (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] {s t : Finset (Fin ℓ)} (hst : s ⊆ t) :
    Mof r hr hr3 s ≤ Mof r hr hr3 t := by
  rw [Mof_eq_iSup, Mof_eq_iSup]
  refine iSup_le fun i => iSup_le fun hi => ?_
  exact le_iSup_of_le i (le_iSup_of_le (hst hi) le_rfl)

/-! ## `Lᵢ` is unramified at the other primes: `Lⱼ ≤ Zᵢ` for `j ≠ i` -/

lemma r_dvd_div_D (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i)) (hrinj : Function.Injective r)
    {i j : Fin ℓ} (hij : j ≠ i) : r j ∣ D r / r i := by
  have hcop : (r j).Coprime (r i) :=
    (Nat.coprime_primes (hr j) (hr i)).mpr fun h => hij (hrinj h)
  have hdvd : r j ∣ D r := r_dvd_D r j
  rw [← Nat.div_mul_cancel (r_dvd_D r i)] at hdvd
  exact hcop.dvd_of_dvd_mul_right hdvd

theorem Lfield_le_Zfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) (hrinj : Function.Injective r) [NeZero (D r)]
    {i j : Fin ℓ} (hij : j ≠ i) : Lfield r hr hr3 j ≤ Zfield r i := by
  rw [Lfield, Zfield]
  refine IntermediateField.fixedField_antitone ?_
  intro σ hσ
  rw [Subgroup.mem_comap, inertiaSub, MonoidHom.mem_ker] at hσ
  rw [MonoidHom.mem_ker]
  show coordChar r hr hr3 j ((galEquiv r).toMonoidHom σ) = 1
  simp only [coordChar, MonoidHom.comp_apply]
  rw [← ZMod.unitsMap_comp (r_dvd_div_D r hr hrinj hij) (div_r_dvd_D r i),
    MonoidHom.comp_apply, hσ]
  simp

/-! ## The field `F` -/

theorem isGalois_Mfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] : IsGalois ℚ ↥(Mfield r hr hr3) := by
  haveI := isCyclotomicExtension_cyc r
  haveI hG : IsGalois ℚ (Cyc r) := IsCyclotomicExtension.isGalois {D r} ℚ (Cyc r)
  haveI := IsCyclotomicExtension.isAbelianGalois {D r} ℚ (Cyc r)
  rw [Mfield]
  exact IsGalois.of_fixedField_normal_subgroup _

theorem isGalois_Ffield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] : IsGalois ℚ ↥(Ffield r hr hr3) := by
  haveI := isCyclotomicExtension_cyc r
  haveI hG : IsGalois ℚ (Cyc r) := IsCyclotomicExtension.isGalois {D r} ℚ (Cyc r)
  haveI := IsCyclotomicExtension.isAbelianGalois {D r} ℚ (Cyc r)
  rw [Ffield]
  exact IsGalois.of_fixedField_normal_subgroup _

theorem isGalois_restrict_Ffield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    IsGalois ℚ ↥(IntermediateField.restrict (Ffield_le_Mfield r hr hr3)) :=
  haveI := isGalois_Ffield r hr hr3
  IsGalois.of_algEquiv (IntermediateField.restrictAlgEquiv (Ffield_le_Mfield r hr hr3))

theorem isGalois_tower_Ffield_Mfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    IsGalois ↥(IntermediateField.restrict (Ffield_le_Mfield r hr hr3)) ↥(Mfield r hr hr3) :=
  haveI := isGalois_Mfield r hr hr3
  IsGalois.tower_top_of_isGalois ℚ
    ↥(IntermediateField.restrict (Ffield_le_Mfield r hr hr3)) ↥(Mfield r hr hr3)


/-! ## The compositum of all `Lⱼ` for `j ≠ i` -/

@[simp] lemma Mof_singleton (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) :
    Mof r hr hr3 {i} = Lfield r hr hr3 i := by
  rw [Mof_eq_iSup]
  simp

theorem Mof_erase_le_Zfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) (hrinj : Function.Injective r) [NeZero (D r)] (i : Fin ℓ) :
    Mof r hr hr3 (Finset.univ.erase i) ≤ Zfield r i := by
  rw [Mof_eq_iSup]
  refine iSup_le fun j => iSup_le fun hj => ?_
  exact Lfield_le_Zfield r hr hr3 hrinj (Finset.mem_erase.mp hj).1

theorem Mfield_eq_Mof_erase_sup (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] (i : Fin ℓ) :
    Mfield r hr hr3 = Mof r hr hr3 (Finset.univ.erase i) ⊔ Lfield r hr hr3 i := by
  rw [← Mof_univ r hr hr3, ← Mof_insert r hr hr3 i (Finset.univ.erase i),
    Finset.insert_erase (Finset.mem_univ i)]


/-! ## The field `F` as an intermediate field of `M` -/

/-- The field `F` of the construction, viewed as an intermediate field of `M = Mfield` (this is
the shape in which `M/F` is a finite extension of number fields with a canonical algebra
structure). -/
noncomputable def FMfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i)) (hr3 : ∀ i, r i % 3 = 1)
    [NeZero (D r)] : IntermediateField ℚ ↥(Mfield r hr hr3) :=
  IntermediateField.restrict (Ffield_le_Mfield r hr hr3)

lemma finrank_FMfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    Module.finrank ℚ ↥(FMfield r hr hr3) = Module.finrank ℚ ↥(Ffield r hr hr3) :=
  ((IntermediateField.restrictAlgEquiv (Ffield_le_Mfield r hr hr3)).toLinearEquiv.finrank_eq).symm

lemma isGalois_FMfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] : IsGalois ℚ ↥(FMfield r hr hr3) := by
  haveI := isGalois_Ffield r hr hr3
  exact IsGalois.of_algEquiv (IntermediateField.restrictAlgEquiv (Ffield_le_Mfield r hr hr3))

lemma lift_FMfield (r : Fin ℓ → ℕ) (hr : ∀ i, Nat.Prime (r i))
    (hr3 : ∀ i, r i % 3 = 1) [NeZero (D r)] :
    IntermediateField.lift (FMfield r hr hr3) = Ffield r hr hr3 :=
  IntermediateField.lift_restrict _


end Work.Tower.CyclotomicBase
