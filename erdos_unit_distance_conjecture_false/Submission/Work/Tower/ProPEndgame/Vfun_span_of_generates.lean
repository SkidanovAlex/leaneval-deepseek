import Mathlib
import Submission.Work.Tower.ProPEndgame.Defs
import Submission.Work.Tower.ProPEndgame.augIdeal_le_jacobson
import Submission.Work.Tower.ProPEndgame.ker_psi_span_all

namespace Work.Tower.ProPEndgame

open scoped Classical
open scoped MonoidAlgebra
open Work.GolodShafarevich

/-- **Nakayama's lemma for modules over a noncommutative ring.**  If `N'` is a finitely generated
submodule of an `R`-module `M` with `N' ≤ N ⊔ I • N'` for an ideal `I` contained in the Jacobson
radical of `R`, then `N' ≤ N`.

This is the analogue of `Submodule.le_of_le_smul_of_le_jacobson_bot` for noncommutative rings (as
needed for the group algebra `𝔽_p[G]` of a nonabelian `p`-group): the commutative version in Mathlib
requires `CommRing R`.  The proof reduces to the quotient `M ⧸ N` and applies the noncommutative
Nakayama lemma `Submodule.FG.eq_bot_of_le_jacobson_smul`. -/
lemma Submodule.le_of_le_smul_of_le_jacobson_bot_noncomm {R M : Type*} [Ring R] [AddCommGroup M]
    [Module R M] {I : Ideal R} {N N' : Submodule R M} (hN' : N'.FG)
    (hIJ : I ≤ Ideal.jacobson (⊥ : Ideal R)) (hNN : N' ≤ N ⊔ I • N') : N' ≤ N := by
  rw [Ideal.jacobson_bot] at hIJ
  have hfg : (N'.map (Submodule.mkQ N)).FG := hN'.map (Submodule.mkQ N)
  have hle : N'.map (Submodule.mkQ N) ≤ Ring.jacobson R • N'.map (Submodule.mkQ N) := by
    calc N'.map (Submodule.mkQ N)
        ≤ (N ⊔ I • N').map (Submodule.mkQ N) := Submodule.map_mono hNN
      _ = N.map (Submodule.mkQ N) ⊔ (I • N').map (Submodule.mkQ N) := Submodule.map_sup ..
      _ = ⊥ ⊔ I • N'.map (Submodule.mkQ N) := by
            rw [Submodule.map_smul'']
            congr 1
            rw [eq_bot_iff, Submodule.map_le_iff_le_comap, Submodule.comap_bot, Submodule.ker_mkQ]
      _ = I • N'.map (Submodule.mkQ N) := bot_sup_eq _
      _ ≤ Ring.jacobson R • N'.map (Submodule.mkQ N) := Submodule.smul_mono_left hIJ
  have hbot : N'.map (Submodule.mkQ N) = ⊥ := hfg.eq_bot_of_le_jacobson_smul hle
  intro x hx
  have hmem : (Submodule.mkQ N) x ∈ N'.map (Submodule.mkQ N) := Submodule.mem_map_of_mem hx
  rw [hbot, Submodule.mem_bot] at hmem
  have : x ∈ (Submodule.mkQ N).ker := LinearMap.mem_ker.mpr hmem
  rwa [Submodule.ker_mkQ] at this

/-- Let `φ : F_d ↠ G` be a presentation of a finite `p`-group and `f : ι → ker φ` a finite family
whose normal closure together with `relFt p (ker φ) = [ker φ, F]·(ker φ)^p` is all of `ker φ`.
Then the Fox derivative vectors `Vfun φ (f i)` span the relation module
`ker (ψ : 𝔽_p[G]^d → 𝔽_p[G])` as an `𝔽_p[G]`-module; equivalently `ker ψ` is generated by `#ι`
elements as an `𝔽_p[G]`-module.

Proof.  Let `S = ∑ᵢ 𝔽_p[G] · Vfun φ (f i)`.  The inclusion `S ⊆ ker ψ` follows from `psi_Vfun`.
For the reverse inclusion apply Nakayama in the form
`Submodule.le_of_le_smul_of_le_jacobson_bot` (to the finitely generated submodule
`ker ψ ⊆ 𝔽_p[G]^d`, with the augmentation ideal `I`, which satisfies `I ≤ jacobson ⊥`
by `Work.Tower.ProPEndgame.augIdeal_le_jacobson`, using that `G` is a `p`-group): it suffices to
prove `ker ψ ≤ S + I · ker ψ`.

By `Work.Tower.ProPEndgame.ker_psi_span_all`, `ker ψ` is spanned by the `Vfun φ r` for `r ∈ ker φ`,
so it suffices to prove `Vfun φ r ∈ S + I·ker ψ` for all `r ∈ ker φ`.  The map
`ker φ → ker ψ ⧸ (I · ker ψ)`, `r ↦ Vfun φ r`, is additive (`Vfun_mul`, using `φ r = 1` for
`r ∈ ker φ`), kills `[ker φ, ker φ]` exactly and kills `relFt p (ker φ)` modulo `I·ker ψ`
(`Vfun (g r g⁻¹ r⁻¹) = (of (φ g)⁻¹ - 1) · Vfun r ∈ I·ker ψ` using `Vfun_conj`, and
`Vfun (r ^ p) = p · Vfun r = 0`); hence it factors through `relVs p (ker φ) = ker φ / relFt`.
In that quotient the classes of the `f i` generate as an `𝔽_p`-vector space, by the hypothesis
`normalClosure (range f) ⊔ relFt p (ker φ) = ker φ`; consequently the `Vfun φ (f i)` generate
`ker ψ ⧸ (I · ker ψ)`. -/
theorem Vfun_span_of_generates (p : ℕ) [Fact p.Prime] {d : ℕ} {G : Type} [Group G] [Finite G]
    (hG : IsPGroup p G) (φ : FreeGroup (Fin d) →* G) (hφ : Function.Surjective φ)
    {ι : Type*} [Fintype ι] (f : ι → FreeGroup (Fin d)) (hf : ∀ i, f i ∈ φ.ker)
    (hgen : Subgroup.normalClosure (Set.range f) ⊔ Work.Tower.ProPEndgame.relFt p φ.ker =
      φ.ker) :
    Submodule.span (MonoidAlgebra (ZMod p) G)
        (Set.range (fun i => Work.GolodShafarevich.Vfun (ZMod p) φ (f i))) =
      LinearMap.ker (Work.GolodShafarevich.psi (ZMod p) φ) := by
  classical
  haveI : Fintype G := Fintype.ofFinite G
  haveI : Fintype (MonoidAlgebra (ZMod p) G) :=
    Fintype.ofEquiv _ MonoidAlgebra.coeffEquiv.symm
  -- The span of the given derivative vectors, the relation module, and the augmentation ideal.
  set S : Submodule (MonoidAlgebra (ZMod p) G) (Fin d → MonoidAlgebra (ZMod p) G) :=
    Submodule.span (MonoidAlgebra (ZMod p) G)
      (Set.range (fun i => Vfun (ZMod p) φ (f i))) with hS
  set N : Submodule (MonoidAlgebra (ZMod p) G) (Fin d → MonoidAlgebra (ZMod p) G) :=
    LinearMap.ker (psi (ZMod p) φ) with hN
  set I : Ideal (MonoidAlgebra (ZMod p) G) := augIdeal (ZMod p) G with hI
  have hf1 : ∀ i, φ (f i) = 1 := fun i => MonoidHom.mem_ker.mp (hf i)
  -- Derivative vectors of kernel elements lie in the relation module.
  have hVN : ∀ w : FreeGroup (Fin d), φ w = 1 → Vfun (ZMod p) φ w ∈ N := by
    intro w hw
    rw [hN, LinearMap.mem_ker, psi_Vfun]
    rw [hw, map_one (MonoidAlgebra.of (ZMod p) G), sub_self]
  -- `S ⊆ ker ψ`.
  have hSN : S ≤ N := by
    rw [hS, Submodule.span_le]
    rintro x ⟨i, rfl⟩
    exact hVN _ (hf1 i)
  -- The subgroup of `F_d` of kernel elements whose derivative vector lies in `S + I·N`.
  let K : Subgroup (FreeGroup (Fin d)) :=
    { carrier := {w : FreeGroup (Fin d) |
        φ w = 1 ∧ Vfun (ZMod p) φ w ∈ S ⊔ I • N}
      one_mem' := ⟨map_one φ, by
        rw [Vfun_one]
        exact Submodule.zero_mem _⟩
      mul_mem' := by
        intro x y hx hy
        obtain ⟨hx1, hx2⟩ := hx
        obtain ⟨hy1, hy2⟩ := hy
        refine ⟨?_, ?_⟩
        · show φ (x * y) = 1
          rw [map_mul, hx1, hy1, one_mul]
        · show Vfun (ZMod p) φ (x * y) ∈ S ⊔ I • N
          have hV : Vfun (ZMod p) φ (x * y) =
              Vfun (ZMod p) φ x +
                MonoidAlgebra.of (ZMod p) G (φ x) • Vfun (ZMod p) φ y := by
            funext i
            simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
            exact Vfun_mul (ZMod p) φ x y i
          rw [hV, hx1, map_one, one_smul]
          exact Submodule.add_mem _ hx2 hy2
      inv_mem' := by
        intro x hx
        obtain ⟨hx1, hx2⟩ := hx
        refine ⟨?_, ?_⟩
        · show φ x⁻¹ = 1
          rw [map_inv, hx1, inv_one]
        · show Vfun (ZMod p) φ x⁻¹ ∈ S ⊔ I • N
          rw [Vfun_inv, hx1, inv_one, map_one, one_smul]
          exact Submodule.neg_mem _ hx2 }
  -- `K` is normal in `F_d`.
  have hKnormal : K.Normal := ⟨fun x hx g => by
    obtain ⟨hx1, hx2⟩ := hx
    refine ⟨?_, ?_⟩
    · show φ (g * x * g⁻¹) = 1
      rw [map_mul, map_mul, map_inv, hx1, mul_one, mul_inv_cancel]
    · show Vfun (ZMod p) φ (g * x * g⁻¹) ∈ S ⊔ I • N
      rw [Vfun_conj (ZMod p) φ hx1]
      exact Submodule.smul_mem _ _ hx2⟩
  -- `K` contains `range f`.
  have hNC : Subgroup.normalClosure (Set.range f) ≤ K := by
    haveI : K.Normal := hKnormal
    refine Subgroup.normalClosure_le_normal ?_
    rintro x ⟨i, rfl⟩
    exact ⟨hf1 i, Submodule.mem_sup_left (Submodule.subset_span ⟨i, rfl⟩)⟩
  -- `K` contains `relFt p (ker φ)`: the commutator generators and the `p`-th powers.
  have hrelFt : relFt p φ.ker ≤ K := by
    haveI : K.Normal := hKnormal
    refine Subgroup.normalClosure_le_normal ?_
    rintro x (hx | hx)
    · obtain ⟨⟨r, g⟩, rfl⟩ := hx
      have hr1 : φ (r : FreeGroup (Fin d)) = 1 := MonoidHom.mem_ker.mp r.2
      refine ⟨?_, ?_⟩
      · show φ (g * (r : FreeGroup (Fin d)) * g⁻¹ * (r : FreeGroup (Fin d))⁻¹) = 1
        rw [map_mul, map_mul, map_mul, map_inv, map_inv, hr1]
        simp
      · show Vfun (ZMod p) φ (g * (r : FreeGroup (Fin d)) * g⁻¹ * (r : FreeGroup (Fin d))⁻¹)
            ∈ S ⊔ I • N
        have hu : φ (g * (r : FreeGroup (Fin d)) * g⁻¹) = 1 := by
          rw [map_mul, map_mul, map_inv, hr1, mul_one, mul_inv_cancel]
        have hV1 : Vfun (ZMod p) φ (g * (r : FreeGroup (Fin d)) * g⁻¹) =
            MonoidAlgebra.of (ZMod p) G (φ g) • Vfun (ZMod p) φ (r : FreeGroup (Fin d)) :=
          Vfun_conj (ZMod p) φ hr1
        have hV2 : Vfun (ZMod p) φ ((r : FreeGroup (Fin d))⁻¹) =
            - Vfun (ZMod p) φ (r : FreeGroup (Fin d)) := by
          rw [Vfun_inv, hr1, inv_one, map_one, one_smul]
        have hVab : Vfun (ZMod p) φ
              (g * (r : FreeGroup (Fin d)) * g⁻¹ * (r : FreeGroup (Fin d))⁻¹) =
            Vfun (ZMod p) φ (g * (r : FreeGroup (Fin d)) * g⁻¹) +
              Vfun (ZMod p) φ ((r : FreeGroup (Fin d))⁻¹) := by
          funext i
          have h := Vfun_mul (ZMod p) φ
            (g * (r : FreeGroup (Fin d)) * g⁻¹) ((r : FreeGroup (Fin d))⁻¹) i
          rw [hu, map_one, one_mul] at h
          simpa [Pi.add_apply] using h
        rw [hVab, hV1, hV2]
        rw [show MonoidAlgebra.of (ZMod p) G (φ g) •
                Vfun (ZMod p) φ (r : FreeGroup (Fin d)) +
              - Vfun (ZMod p) φ (r : FreeGroup (Fin d)) =
            (MonoidAlgebra.of (ZMod p) G (φ g) - 1) •
              Vfun (ZMod p) φ (r : FreeGroup (Fin d)) by
          rw [sub_smul, one_smul, sub_eq_add_neg]]
        exact Submodule.mem_sup_right
          (Submodule.smul_mem_smul (of_sub_one_mem_augIdeal (ZMod p) G (φ g))
            (hVN (r : FreeGroup (Fin d)) hr1))
    · obtain ⟨r, rfl⟩ := hx
      have hr1 : φ (r : FreeGroup (Fin d)) = 1 := MonoidHom.mem_ker.mp r.2
      refine ⟨?_, ?_⟩
      · show φ ((r : FreeGroup (Fin d)) ^ p) = 1
        rw [map_pow, hr1, one_pow]
      · show Vfun (ZMod p) φ ((r : FreeGroup (Fin d)) ^ p) ∈ S ⊔ I • N
        have hpow : ∀ n : ℕ,
            Vfun (ZMod p) φ ((r : FreeGroup (Fin d)) ^ n) =
              n • Vfun (ZMod p) φ (r : FreeGroup (Fin d)) := by
          intro n
          induction n with
          | zero => rw [pow_zero, Vfun_one, zero_smul]
          | succ n ih =>
            have hrn : φ ((r : FreeGroup (Fin d)) ^ n) = 1 := by rw [map_pow, hr1, one_pow]
            have hV : Vfun (ZMod p) φ
                  ((r : FreeGroup (Fin d)) ^ n * (r : FreeGroup (Fin d))) =
                Vfun (ZMod p) φ ((r : FreeGroup (Fin d)) ^ n) +
                  Vfun (ZMod p) φ (r : FreeGroup (Fin d)) := by
              funext i
              have h := Vfun_mul (ZMod p) φ
                ((r : FreeGroup (Fin d)) ^ n) (r : FreeGroup (Fin d)) i
              rw [hrn, map_one, one_mul] at h
              simpa [Pi.add_apply] using h
            rw [pow_succ, hV, ih, succ_nsmul]
        have h0 : Vfun (ZMod p) φ ((r : FreeGroup (Fin d)) ^ p) = 0 := by
          rw [hpow p, ← Nat.cast_smul_eq_nsmul (ZMod p), ZMod.natCast_self, zero_smul]
        rw [h0]
        exact Submodule.zero_mem _
  -- Every element of `ker φ` has its derivative vector in `S + I·N`.
  have hker_le : φ.ker ≤ K := by
    rw [← hgen]
    exact sup_le hNC hrelFt
  have hker_le_T : LinearMap.ker (psi (ZMod p) φ) ≤ S ⊔ I • N := by
    rw [← ker_psi_span_all p φ hφ, Submodule.span_le]
    rintro x ⟨r, rfl⟩
    exact (hker_le r.2).2
  have hN_le_T : N ≤ S ⊔ I • N := by
    rw [hN]
    exact hker_le_T
  -- `N` is finitely generated (it is a submodule of the finite module `𝔽_p[G]^d`).
  have hFG : N.FG := by
    refine ⟨Finset.univ.image (fun x : N => (x : Fin d → MonoidAlgebra (ZMod p) G)), ?_⟩
    apply le_antisymm
    · rw [Submodule.span_le]
      intro x hx
      simp only [Finset.mem_coe, Finset.mem_image, Finset.mem_univ, true_and] at hx
      obtain ⟨y, rfl⟩ := hx
      exact y.2
    · intro x hx
      exact Submodule.subset_span (Finset.mem_image.mpr ⟨⟨x, hx⟩, Finset.mem_univ _, rfl⟩)
  -- The augmentation ideal lies in the Jacobson radical, as `G` is a `p`-group.
  have hIj : I ≤ Ideal.jacobson (⊥ : Ideal (MonoidAlgebra (ZMod p) G)) := by
    rw [hI]
    exact augIdeal_le_jacobson p hG
  -- Nakayama.
  have hN_le_S : N ≤ S :=
    Submodule.le_of_le_smul_of_le_jacobson_bot_noncomm (I := I) (N := S) (N' := N)
      hFG hIj hN_le_T
  exact le_antisymm hSN hN_le_S

end Work.Tower.ProPEndgame
