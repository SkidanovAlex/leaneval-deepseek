import Submission.Work.Tower.ProPEndgame.Defs
import Submission.Work.Tower.Shafarevich.Rank.generatorRank_le_iff
import Submission.Work.Tower.ProPEndgame.Vfun_span_of_generates
import Submission.Work.Tower.ProPEndgame.exists_generating_family
import Submission.Work.Tower.ProPEndgame.Vfun_ker_mem_augIdeal
import Submission.Work.Tower.ProPEndgame.relRank_le_finrank_H2

/-!
# The pro-`p` Golod–Šafarevič inequality for finite `p`-groups

The endgame of the class-field-tower argument needs: a nontrivial finite `p`-group does not admit a
pro-`p` presentation with `d` generators and `r` relations when `4 r ≤ d²`.  Since for a finite
`p`-group the minimal number of pro-`p` relations is `dim_{𝔽_p} H²(G, 𝔽_p)`, this is exactly
`4 · dim_{𝔽_p} H²(G, 𝔽_p) > d²`, the classical Golod–Šafarevič inequality in the form used by
Golod–Šafarevič's solution of the class field tower problem.

## Main results

* `Work.Tower.ProPEndgame.gs_proP_finite` — the endgame statement requested by the `Tower`
  construction: a nontrivial finite `3`-group with `generatorRank G = d`,
  `dim_{𝔽_3} H²(G, 𝔽_3) ≤ r` and `4 r ≤ d²` cannot exist.
* `Work.Tower.ProPEndgame.gs_proP_finite_general` — the same statement for an arbitrary prime `p`.
* `Work.Tower.ProPEndgame.proP_gs` — the classical form
  `4 · dim_{𝔽_p} H²(G, 𝔽_p) > d(G)²`.
-/

open scoped Classical
open scoped MonoidAlgebra
open Work.GolodShafarevich

namespace Work.Tower.ProPEndgame

/-- A nontrivial finite group is not generated by zero elements. -/
theorem one_le_generatorRank {G : Type} [Group G] [Finite G] [Nontrivial G] :
    1 ≤ Work.Tower.generatorRank G := by
  by_contra h
  have h0 : Work.Tower.generatorRank G = 0 := by omega
  obtain ⟨φ, hφ⟩ :=
    (Work.Tower.Shafarevich.Rank.generatorRank_le_iff (G := G) 0).mp (le_of_eq h0)
  exact not_nontrivial_iff_subsingleton.mpr hφ.subsingleton inferInstance

/-- **The pro-`p` Golod–Šafarevič endgame, general prime.**  A nontrivial finite `p`-group `G`
with minimal number of generators `d` cannot satisfy `4 r ≤ d²` for any `r` with
`dim_{𝔽_p} H²(G, 𝔽_p) ≤ r`. -/
theorem gs_proP_finite_general (p : ℕ) [Fact p.Prime] {G : Type} [Group G] [Fintype G]
    [Nontrivial G] (hG : IsPGroup p G) {d r : ℕ} (hd : Work.Tower.generatorRank G = d)
    (hrel : Module.finrank (ZMod p) (Work.Tower.Shafarevich.H2Fp p G) ≤ r)
    (hnum : 4 * r ≤ d ^ 2) : False := by
  -- a minimal presentation of `G`
  obtain ⟨φ, hφ⟩ :=
    (Work.Tower.Shafarevich.Rank.generatorRank_le_iff (G := G) d).mp (le_of_eq hd)
  have hmin : ∀ (d' : ℕ) (ψ : FreeGroup (Fin d') →* G), Function.Surjective ψ → d ≤ d' := by
    intro d' ψ hψ
    rw [← hd]
    exact Nat.sInf_le ⟨ψ, hψ⟩
  -- a family generating `R` modulo `[R,F]·R^p`, of the optimal size
  obtain ⟨f, hfgen⟩ := exists_generating_family (p := p) (φ := φ) hφ
  -- its Fox vectors span the relation module
  have hspan := Vfun_span_of_generates (p := p) hG φ hφ
    (fun i => ((f i : φ.ker) : FreeGroup (Fin d))) (fun i => (f i).2) hfgen
  -- and lie in `I^d`
  have hvI : ∀ (j : Fin (relRank p φ.ker)) (i : Fin d),
      Vfun (ZMod p) φ ((f j : φ.ker) : FreeGroup (Fin d)) i ∈ augIdeal (ZMod p) G :=
    fun j i => Vfun_ker_mem_augIdeal p Fact.out hG φ hφ hmin _ (f j).2 i
  -- the Golod–Šafarevič dimension bound
  have hgs : 4 * relRank p φ.ker > d ^ 2 := by
    have hd1 : 1 ≤ d := by rw [← hd]; exact one_le_generatorRank
    exact AbstractGS.gs_dimension_bound (k := ZMod p) (B := MonoidAlgebra (ZMod p) G)
      (I := augIdeal (ZMod p) G) (finrank_quotient_augIdeal (R := ZMod p)) hd1
      (psi (ZMod p) φ) (range_psi_eq_augIdeal φ hφ)
      (fun j => Vfun (ZMod p) φ ((f j : φ.ker) : FreeGroup (Fin d))) hspan hvI
  -- the transgression compares `relRank` with `dim H²`
  have htr := relRank_le_finrank_H2 (p := p) hG φ hφ hmin
  omega

/-- **The numeric endgame bridge.**  If a nontrivial finite `p`-group `G` satisfies
`dim_{𝔽_p} H²(G, 𝔽_p) ≤ d(G) + C` and `d(G)² > 4 (d(G) + C)`, we get a contradiction.  This is
the shape in which the class-field-tower assembly uses the Golod–Šafarevič inequality
(`C = C₀ + |T|` there, and `d(G)` is bounded below by the rank `m` of the elementary abelian
layer). -/
theorem gs_endgame_numeric (p : ℕ) [Fact p.Prime] {G : Type} [Group G] [Fintype G] [Nontrivial G]
    (hG : IsPGroup p G) {C : ℕ}
    (h1 : Module.finrank (ZMod p) (Work.Tower.Shafarevich.H2Fp p G) ≤
      Work.Tower.generatorRank G + C)
    (h2 : Work.Tower.generatorRank G ^ 2 > 4 * (Work.Tower.generatorRank G + C)) : False :=
  gs_proP_finite_general p hG rfl h1 (le_of_lt h2)

/-- **The numeric endgame bridge, trivial-group form.**  If a finite `p`-group `G` satisfies
`dim_{𝔽_p} H²(G, 𝔽_p) ≤ d(G) + C` and `d(G)² > 4 (d(G) + C)` then `G` is trivial.  This is the
form used when the tower construction argues "the maximal splitting `3`-extension cannot grow":
a nontrivial such Galois group would contradict Golod–Šafarevič. -/
theorem gs_endgame_subsingleton (p : ℕ) [Fact p.Prime] {G : Type} [Group G] [Fintype G]
    (hG : IsPGroup p G) {C : ℕ}
    (h1 : Module.finrank (ZMod p) (Work.Tower.Shafarevich.H2Fp p G) ≤
      Work.Tower.generatorRank G + C)
    (h2 : Work.Tower.generatorRank G ^ 2 > 4 * (Work.Tower.generatorRank G + C)) :
    Subsingleton G := by
  by_contra h
  haveI : Nontrivial G := not_subsingleton_iff_nontrivial.mp h
  exact gs_endgame_numeric p hG h1 h2

/-- **The pro-`p` Golod–Šafarevič inequality, endgame form.**  A nontrivial finite `3`-group `G`
with minimal number of generators `d` cannot satisfy `4 r ≤ d²` for any `r` with
`dim_{𝔽_3} H²(G, 𝔽_3) ≤ r`. -/
theorem gs_proP_finite {G : Type} [Group G] [Fintype G] [Nontrivial G] (h3 : IsPGroup 3 G)
    {d r : ℕ} (hd : Work.Tower.generatorRank G = d)
    (hrel : Module.finrank (ZMod 3) (Work.Tower.Shafarevich.H2Fp 3 G) ≤ r)
    (hnum : 4 * r ≤ d ^ 2) : False :=
  gs_proP_finite_general 3 h3 hd hrel hnum

/-- **The pro-`p` Golod–Šafarevič inequality in classical form.**  For a nontrivial finite
`p`-group, `4 · dim_{𝔽_p} H²(G, 𝔽_p) > d(G)²`. -/
theorem proP_gs (p : ℕ) [Fact p.Prime] {G : Type} [Group G] [Fintype G] [Nontrivial G]
    (hG : IsPGroup p G) :
    4 * Work.Tower.Shafarevich.proPRelationRank p G > Work.Tower.generatorRank G ^ 2 := by
  by_contra hle
  rw [not_lt] at hle
  exact gs_proP_finite_general p hG rfl le_rfl hle

end Work.Tower.ProPEndgame
