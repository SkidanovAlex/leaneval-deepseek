import Mathlib
import Submission.Work.Tower.ProPEndgame.Defs
import Submission.Work.GolodShafarevich.Defs

namespace Work.Tower.ProPEndgame

open scoped MonoidAlgebra

/-- Scalar multiplication by an element of an `R`-algebra commutes with scalar multiplication
by an element of `R`, for any module over the algebra. -/
theorem smul_algebra_smul {R A V : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
    [AddCommMonoid V] [Module R V] [Module A V] [IsScalarTower R A V] (a : A) (r : R) (v : V) :
    a • (r • v) = r • (a • v) := by
  rw [← IsScalarTower.algebraMap_smul A r v, ← IsScalarTower.algebraMap_smul A r (a • v),
    ← mul_smul, ← mul_smul, Algebra.commutes r a]

/-- An element of an algebra and a base ring scalar commute when acting on a module. -/
theorem algebra_smul_smul {R A V : Type*} [CommSemiring R] [Semiring A] [Algebra R A]
    [AddCommMonoid V] [Module R V] [Module A V] [IsScalarTower R A V] (r : R) (a : A) (v : V) :
    (r • a) • v = r • (a • v) := by
  rw [Algebra.smul_def, mul_smul, IsScalarTower.algebraMap_smul A]

/-- For a finite `p`-group `G`, the augmentation ideal of the group algebra `𝔽_p[G]` is contained
in the Jacobson radical of `𝔽_p[G]` (equivalently, `𝔽_p[G]` is a local ring with maximal left
ideals all equal to the augmentation ideal).

Suggested route: the augmentation ideal is generated by the finitely many elements `gᵢ - 1` for a
finite generating set `{gᵢ}` of `G` (use `Work.GolodShafarevich.augIdeal_eq_span`); each `gᵢ - 1` is
nilpotent, since `(gᵢ - 1) ^ (p ^ a) = gᵢ ^ (p ^ a) - 1 = 0` in characteristic `p` once
`gᵢ ^ (p ^ a) = 1`; an ideal generated by finitely many nilpotent elements is nilpotent, and a
nilpotent ideal is contained in the Jacobson radical.  (Alternatively: every simple
`𝔽_p[G]`-module has a nonzero fixed vector for the `p`-group `G`, hence is trivial, so the
augmentation ideal annihilates every simple module.) -/
theorem augIdeal_le_jacobson (p : ℕ) [Fact p.Prime] {G : Type} [Group G] [Fintype G]
    (hG : IsPGroup p G) :
    Work.GolodShafarevich.augIdeal (ZMod p) G ≤
      Ideal.jacobson (⊥ : Ideal (MonoidAlgebra (ZMod p) G)) := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  rw [Ideal.jacobson_bot, Ring.jacobson_eq_sInf_isMaximal]
  refine le_sInf fun M hM => ?_
  haveI : M.IsMaximal := hM
  set V := MonoidAlgebra (ZMod p) G ⧸ M with hVdef
  haveI hVsimple : IsSimpleModule (MonoidAlgebra (ZMod p) G) V :=
    (isSimpleModule_iff_isCoatom (m := M)).mpr (Ideal.isMaximal_def.mp hM)
  haveI hVnontriv : Nontrivial V := IsSimpleModule.nontrivial (MonoidAlgebra (ZMod p) G) V
  haveI : Fintype (MonoidAlgebra (ZMod p) G) :=
    Fintype.ofEquiv _ MonoidAlgebra.coeffEquiv.symm
  haveI hAfin : Finite (MonoidAlgebra (ZMod p) G) := inferInstance
  haveI hVfin : Finite V :=
    Finite.of_surjective (Submodule.Quotient.mk (p := M)) (Submodule.Quotient.mk_surjective M)
  letI : MulAction G V :=
    { smul := fun g v => MonoidAlgebra.of (ZMod p) G g • v
      one_smul := fun v => by
        show MonoidAlgebra.of (ZMod p) G 1 • v = v
        rw [map_one, one_smul]
      mul_smul := fun g h v => by
        show MonoidAlgebra.of (ZMod p) G (g * h) • v =
          MonoidAlgebra.of (ZMod p) G g • (MonoidAlgebra.of (ZMod p) G h • v)
        rw [map_mul, mul_smul] }
  haveI : Fintype V := Fintype.ofFinite V
  -- `p` divides the cardinality of `V`
  have hcard : Fintype.card V = p ^ Module.finrank (ZMod p) V := by
    rw [Module.card_eq_pow_finrank (K := ZMod p), ZMod.card p]
  have hpV : p ∣ Nat.card V := by
    rw [Nat.card_eq_fintype_card, hcard]
    refine dvd_pow_self p fun h0 => ?_
    rw [h0, pow_zero] at hcard
    have h2 : 1 < Fintype.card V := Fintype.one_lt_card
    omega
  have h0 : (0 : V) ∈ MulAction.fixedPoints G V := by
    rw [MulAction.mem_fixedPoints]
    intro g
    show MonoidAlgebra.of (ZMod p) G g • (0 : V) = 0
    rw [smul_zero]
  obtain ⟨b, hb, hbne⟩ := hG.exists_fixed_point_of_prime_dvd_card_of_fixed_point V hpV h0
  -- conversion between the `G`-action and the module scalar action
  have mem_fix : ∀ v : V, v ∈ MulAction.fixedPoints G V ↔
      ∀ g : G, MonoidAlgebra.of (ZMod p) G g • v = v := by
    intro v
    rw [MulAction.mem_fixedPoints]
    exact ⟨fun h g => h g, fun h g => h g⟩
  have hfix_add : ∀ x y : V, x ∈ MulAction.fixedPoints G V → y ∈ MulAction.fixedPoints G V →
      x + y ∈ MulAction.fixedPoints G V := by
    intro x y hx hy
    rw [mem_fix] at hx hy ⊢
    intro g
    rw [smul_add, hx g, hy g]
  have hfix_smul : ∀ (a : MonoidAlgebra (ZMod p) G) (x : V), x ∈ MulAction.fixedPoints G V →
      a • x ∈ MulAction.fixedPoints G V := by
    intro a x hx
    rw [mem_fix] at hx ⊢
    induction a using MonoidAlgebra.induction_on with
    | of m =>
      intro g
      rw [← mul_smul, ← map_mul, hx (g * m), hx m]
    | add a b ha hb =>
      intro g
      rw [add_smul, smul_add, ha g, hb g]
    | smul r a ha =>
      intro g
      rw [algebra_smul_smul, smul_algebra_smul, ha g]
  let F : Submodule (MonoidAlgebra (ZMod p) G) V :=
    { carrier := MulAction.fixedPoints G V
      zero_mem' := h0
      add_mem' := fun hx hy => hfix_add _ _ hx hy
      smul_mem' := fun a x hx => hfix_smul a x hx }
  have hbF : b ∈ F := hb
  have hFne : F ≠ ⊥ := by
    intro hbot
    have hb0 : b = 0 := (Submodule.eq_bot_iff F).mp hbot b hbF
    exact hbne hb0.symm
  have hFtop : F = ⊤ := (eq_bot_or_eq_top F).resolve_left hFne
  have hall : ∀ v : V, v ∈ MulAction.fixedPoints G V := fun v => by
    have hv : v ∈ F := by rw [hFtop]; exact Submodule.mem_top
    exact hv
  set v₀ : V := Submodule.Quotient.mk (1 : MonoidAlgebra (ZMod p) G) with hv₀
  -- every element of the augmentation ideal annihilates `V`
  have key : ∀ y ∈ Work.GolodShafarevich.augIdeal (ZMod p) G, y • v₀ = 0 := by
    intro y hy
    have hy' : y ∈ Submodule.span (ZMod p)
        (Set.range fun g : G => MonoidAlgebra.of (ZMod p) G g - 1) := by
      rw [← Work.GolodShafarevich.augIdeal_eq_span (ZMod p) G]
      exact hy
    refine Submodule.span_induction (p := fun z _ => z • v₀ = 0) ?_ ?_ ?_ ?_ hy'
    · rintro z ⟨g, rfl⟩
      have hg : MonoidAlgebra.of (ZMod p) G g • v₀ = v₀ := (mem_fix v₀).mp (hall v₀) g
      rw [sub_smul, one_smul, hg, sub_self]
    · rw [zero_smul]
    · intro x z hx hz ihx ihz
      rw [add_smul, ihx, ihz, add_zero]
    · intro r z hz ihz
      rw [algebra_smul_smul, ihz, smul_zero]
  intro x hx
  rw [← Submodule.Quotient.mk_eq_zero (p := M)]
  have h1 : (Submodule.Quotient.mk x : V) = x • v₀ := by
    rw [hv₀, ← Submodule.Quotient.mk_smul (p := M) x (1 : MonoidAlgebra (ZMod p) G)]
    congr 1
    rw [smul_eq_mul, mul_one]
  rw [h1, key x hx]

end Work.Tower.ProPEndgame
