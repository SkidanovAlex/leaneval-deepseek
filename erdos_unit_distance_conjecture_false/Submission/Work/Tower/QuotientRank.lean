import Mathlib

namespace Work.Tower

/-- **Frattini quotients preserve generator count.** If `N` is a normal subgroup of a finite
group `G` contained in the Frattini subgroup `Φ(G)`, then `G` is generated by `d` elements
(i.e. admits a surjection from the free group on `d` generators) if and only if `G ⧸ N` is.

The forward direction is just composition with the quotient map. For the converse, lift the
images of the free generators to `G`; the subgroup `K` they generate satisfies
`K ⊔ N = ⊤`, hence `K ⊔ Φ(G) = ⊤`, and since the Frattini subgroup consists of non-generators
(`frattini_nongenerating`), `K = ⊤`. -/
theorem quotient_genRank_of_le_frattini {G : Type*} [Group G] [Fintype G] (N : Subgroup G)
    [N.Normal] (hN : N ≤ frattini G) (d : ℕ) :
    (∃ φ : FreeGroup (Fin d) →* G, Function.Surjective φ) ↔
      (∃ ψ : FreeGroup (Fin d) →* G ⧸ N, Function.Surjective ψ) := by
  haveI : Finite (Subgroup G) := Finite.of_injective _ SetLike.coe_injective
  haveI : IsCoatomic (Subgroup G) := Finite.to_isCoatomic
  constructor
  · rintro ⟨φ, hφ⟩
    exact ⟨(QuotientGroup.mk' N).comp φ, (QuotientGroup.mk'_surjective N).comp hφ⟩
  · rintro ⟨ψ, hψ⟩
    have hsurj : ∀ i : Fin d, ∃ y : G, (y : G ⧸ N) = ψ (FreeGroup.of i) :=
      fun i => QuotientGroup.mk'_surjective N _
    choose x hx using hsurj
    set χ : FreeGroup (Fin d) →* G := FreeGroup.lift x with hχ
    have hcomp : (QuotientGroup.mk' N).comp χ = ψ := by
      apply FreeGroup.ext_hom
      intro i
      simp [hχ, hx]
    have hmap : χ.range.map (QuotientGroup.mk' N) = ⊤ := by
      rw [← MonoidHom.range_comp, hcomp, MonoidHom.range_eq_top.mpr hψ]
    have hsup : χ.range ⊔ N = ⊤ := by
      have h := congrArg (Subgroup.comap (QuotientGroup.mk' N)) hmap
      rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk', Subgroup.comap_top] at h
      exact h
    have hsupΦ : χ.range ⊔ frattini G = ⊤ := by
      rw [eq_top_iff, ← hsup]
      exact sup_le_sup_left hN _
    have hrange : χ.range = ⊤ := frattini_nongenerating hsupΦ
    exact ⟨χ, MonoidHom.range_eq_top.mp hrange⟩

/-- **Tower cutting for generator rank** (Paper, Prop. 3.3): killing elements of the Frattini
subgroup of a finite `p`-group does not change the minimal number of generators.

This is the special case of `quotient_genRank_of_le_frattini` for `N` the normal closure of a
family of elements of `Φ(G)`: such a normal closure is contained in `Φ(G)` because the
Frattini subgroup is normal (in fact characteristic). The hypotheses on `p` are not needed for
this implication, which holds for every finite group. -/
theorem QuotientRank {p : ℕ} (hp : Nat.Prime p) (G : Type*) [Group G] [Fintype G]
    (hG : IsPGroup p G) (k : ℕ) (g : Fin k → G) (hg : ∀ i, g i ∈ frattini G) (d : ℕ) :
    (∃ φ : FreeGroup (Fin d) →* G, Function.Surjective φ) ↔
      (∃ ψ : FreeGroup (Fin d) →* (G ⧸ Subgroup.normalClosure (Set.range g)),
        Function.Surjective ψ) := by
  apply quotient_genRank_of_le_frattini
  apply Subgroup.normalClosure_le_normal
  rintro x ⟨i, rfl⟩
  exact hg i

end Work.Tower
