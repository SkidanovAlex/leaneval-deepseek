import Submission.Work.Tower.Defs
import Submission.Work.Tower.Glue.card_le_pow_of_surjective_freeGroup

/-!
# Glue lemmas about `Work.Tower.generatorRank`

Elementary facts used in the assembly of the class-field tower.
-/

open scoped IsMulCommutative

namespace Work
namespace Tower
namespace Glue

/-- A finite group is generated by `Fintype.card G` elements, so the set defining
`generatorRank` is nonempty. -/
theorem nonempty_generatorSet (G : Type*) [Group G] [Fintype G] :
    ({d : ℕ | ∃ ψ : FreeGroup (Fin d) →* G, Function.Surjective ψ} : Set ℕ).Nonempty := by
  refine ⟨Fintype.card G, FreeGroup.lift fun i : Fin (Fintype.card G) => (Fintype.equivFin G).symm i,
    ?_⟩
  intro g
  exact ⟨FreeGroup.of (Fintype.equivFin G g), by
    rw [FreeGroup.lift_apply_of, Equiv.symm_apply_apply]⟩

/-- The minimal number of generators is monotone under surjective homomorphisms of finite groups. -/
theorem generatorRank_le_of_surjective {G H : Type*} [Group G] [Fintype G] [Group H] [Fintype H]
    (φ : G →* H) (hφ : Function.Surjective φ) : generatorRank H ≤ generatorRank G := by
  unfold generatorRank
  obtain ⟨ψ, hψ⟩ := Nat.sInf_mem (nonempty_generatorSet G)
  exact Nat.sInf_le ⟨φ.comp ψ, hφ.comp hψ⟩

/-- A finite commutative group of exponent `3` and cardinality `3 ^ m` needs at least `m`
generators. -/
theorem le_generatorRank_of_card {G : Type*} [CommGroup G] [Fintype G]
    (h3 : ∀ g : G, g ^ 3 = 1) {m : ℕ} (hcard : Fintype.card G = 3 ^ m) :
    m ≤ generatorRank G := by
  unfold generatorRank
  obtain ⟨φ, hφ⟩ := Nat.sInf_mem (nonempty_generatorSet G)
  have h := card_le_pow_of_surjective_freeGroup h3 φ hφ
  rw [hcard] at h
  exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 3)).mp h

/-- **Galois form.** For a finite Galois extension `E/F` of degree `3 ^ m` whose Galois group is
commutative of exponent `3`, the minimal number of generators of `Gal(E/F)` is `m`.

The exponent hypothesis is stated without `^` to avoid instance diamonds on the Galois group. -/
theorem le_generatorRank_galois {F E : Type*} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] [IsGalois F E] [IsAbelianGalois F E]
    (hexp : ∀ σ : Gal(E/F), σ ^ 3 = 1) {m : ℕ} (hdim : Module.finrank F E = 3 ^ m) :
    m ≤ generatorRank (Gal(E/F)) := by
  haveI : Fintype (Gal(E/F)) := Fintype.ofFinite _
  have hcard : Fintype.card (Gal(E/F)) = 3 ^ m := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank F E, hdim]
  exact le_generatorRank_of_card hexp hcard

end Glue
end Tower
end Work
