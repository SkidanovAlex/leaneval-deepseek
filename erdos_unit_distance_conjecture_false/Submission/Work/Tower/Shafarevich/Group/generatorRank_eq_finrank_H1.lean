import Mathlib
import Submission.Work.Tower.Defs
import Submission.Work.Tower.Shafarevich.Defs
import Submission.Work.Tower.Shafarevich.Rank.generatorRank_le_iff
import Submission.Work.Tower.Shafarevich.Cohomology.finrank_H1Fp_eq_finrank_hom

/-!
# The number of generators of a finite `p`-group and `dim H¹(G, 𝔽ₚ)`

For a finite `p`-group `G` the minimal number of generators equals the `𝔽ₚ`-dimension of the
first cohomology of `G` with trivial coefficients:

  `d(G) = dim_{𝔽ₚ} H¹(G, 𝔽ₚ)`.

This is the group-theoretic input to Shafarevich's relation-rank estimate (paper
Proposition 3.5 / A.10).  The proof factors as

* `dim H¹(G, 𝔽ₚ) = dim Hom(G, 𝔽ₚ)` — degree one of the standard resolution, proved in
  `Work.Tower.Shafarevich.Cohomology.finrank_H1Fp_eq_finrank_hom`;
* `dim Hom(G, 𝔽ₚ) ≤ d(G)`: restricting a homomorphism to a generating set is injective;
* `d(G) ≤ dim Hom(G, 𝔽ₚ)` — the Burnside basis theorem: every maximal subgroup `M` of a finite
  `p`-group is the kernel of a homomorphism to `𝔽ₚ` (it is normal of index `p`), so the
  intersection `⋂_f ker f` over `f : Hom(G, 𝔽ₚ)` lies in the Frattini subgroup; a basis of the
  image of the evaluation map `G → Hom(G, 𝔽ₚ)⋆` lifts to a generating set, which together with
  the Frattini argument shows `G` is generated by `dim Hom(G, 𝔽ₚ)` elements.
-/

open scoped Classical

/-- The evaluation map `x ↦ (f ↦ f x)` from a group (written additively) to the double dual of
the module `Hom(G, 𝔽ₚ)` of additive homomorphisms into `𝔽ₚ`. -/
private noncomputable def evalHom (p : ℕ) (G : Type) [Group G] :
    Additive G →+ Module.Dual (ZMod p) (Additive G →+ ZMod p) where
  toFun x :=
    { toFun := fun f => f x
      map_add' := fun f g => AddMonoidHom.add_apply f g x
      map_smul' := fun _ _ => rfl }
  map_zero' := by ext f; simp
  map_add' := by intro x y; ext f; simp

private lemma evalHom_apply (p : ℕ) (G : Type) [Group G] (x : Additive G)
    (f : Additive G →+ ZMod p) : evalHom p G x f = f x := rfl

namespace Work.Tower.Shafarevich.Group

/-- Every maximal subgroup `M` of a finite `p`-group `G` is the kernel of a homomorphism
`G →* Multiplicative (ZMod p)`: such an `M` is normal of index `p`. -/
private theorem coatom_ker_eq_aux (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Finite G]
    (hG : IsPGroup p G) (M : Subgroup G) (hM : IsCoatom M) :
    ∃ f : G →* Multiplicative (ZMod p), MonoidHom.ker f = M := by
  classical
  have hMn : M.Normal :=
    (Group.isNilpotent_of_finite_tfae (G := G)).out 1 3 rfl rfl |>.mp hG.isNilpotent M hM
  haveI : M.Normal := hMn
  -- the quotient is nontrivial
  obtain ⟨a, -, haM⟩ := SetLike.exists_of_lt hM.lt_top
  haveI hnt : Nontrivial (G ⧸ M) :=
    ⟨⟨QuotientGroup.mk' M a, 1, fun h => haM ((QuotientGroup.eq_one_iff a).mp h)⟩⟩
  -- every subgroup of the quotient is `⊥` or `⊤`
  have htriv : ∀ K : Subgroup (G ⧸ M), K = ⊥ ∨ K = ⊤ := by
    intro K
    have hMle : M ≤ K.comap (QuotientGroup.mk' M) := by
      intro x hx
      have hx1 : QuotientGroup.mk' M x = 1 :=
        MonoidHom.mem_ker.mp (by rwa [QuotientGroup.ker_mk'])
      show QuotientGroup.mk' M x ∈ K
      rw [hx1]
      exact K.one_mem
    have hmap := Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective M) K
    rcases hM.le_iff.mp hMle with h | h
    · right
      rw [← hmap, h]
      exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective M)
    · left
      rw [← hmap, h]
      rw [Subgroup.map_eq_bot_iff]
      intro x hx
      exact MonoidHom.mem_ker.mp (by rwa [QuotientGroup.ker_mk'])
  haveI : IsSimpleGroup (G ⧸ M) :=
    { toNontrivial := hnt
      eq_bot_or_eq_top_of_normal := fun K _ => htriv K }
  haveI : Group.IsNilpotent (G ⧸ M) := (hG.to_quotient M).isNilpotent
  have hprime : (Nat.card (G ⧸ M)).Prime :=
    (CommGroup.is_simple_iff_prime_card (α := G ⧸ M)).mp inferInstance
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp (hG.to_quotient M)
  have hn0 : n ≠ 0 := by
    rintro rfl
    rw [pow_zero] at hn
    exact (hn ▸ hprime).ne_one rfl
  have hcard : Nat.card (G ⧸ M) = p := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn0
    have hdvd : p ∣ p ^ (m + 1) := dvd_pow_self p (Nat.succ_ne_zero m)
    rcases hprime.eq_one_or_self_of_dvd p (hn ▸ hdvd) with h | h
    · exact absurd h (Fact.out : p.Prime).ne_one
    · have hinj : p ^ 1 = p ^ (m + 1) := by rw [pow_one]; exact h.trans hn
      have h1 : 1 = m + 1 := Nat.pow_right_injective (Fact.out : p.Prime).two_le hinj
      have hfin : Nat.card (G ⧸ M) = p ^ 1 := by rw [hn, h1]
      rw [hfin, pow_one]
  have hcard2 : Nat.card (Multiplicative (ZMod p)) = p := by
    rw [Nat.card_congr (Multiplicative.toAdd (α := ZMod p)), Nat.card_zmod]
  let e : (G ⧸ M) ≃* Multiplicative (ZMod p) := mulEquivOfPrimeCardEq hcard hcard2
  exact ⟨e.toMonoidHom.comp (QuotientGroup.mk' M), by
    rw [MonoidHom.ker_comp_of_injective (QuotientGroup.mk' M) e.toMonoidHom e.injective,
      QuotientGroup.ker_mk']⟩

/-- **Burnside's basis theorem, upper bound.**  A finite `p`-group `G` is generated by
`dim_{𝔽ₚ} Hom(G, 𝔽ₚ)` elements. -/
private theorem generatorRank_le_finrank_dual (p : ℕ) [Fact p.Prime] (G : Type) [Group G]
    [Finite G] (hG : IsPGroup p G) :
    Work.Tower.generatorRank G ≤ Module.finrank (ZMod p) (Additive G →+ ZMod p) := by
  classical
  haveI hHfin : Finite (Additive G →+ ZMod p) :=
    Finite.of_injective (fun f : Additive G →+ ZMod p => (f : Additive G → ZMod p))
      (fun _ _ h => DFunLike.ext _ _ (congrFun h))
  haveI hHmodfin : Module.Finite (ZMod p) (Additive G →+ ZMod p) := Module.Finite.of_finite
  let θ := evalHom p G
  have θ_apply : ∀ (x : Additive G) (f : Additive G →+ ZMod p), θ x f = f x := by
    intro x f
    exact evalHom_apply p G x f
  set E : Submodule (ZMod p) (Module.Dual (ZMod p) (Additive G →+ ZMod p)) :=
    AddSubgroup.toZModSubmodule p θ.range with hE
  have memE : ∀ x : G, θ (Additive.ofMul x) ∈ E := fun x => by
    rw [hE, AddSubgroup.mem_toZModSubmodule]
    exact ⟨Additive.ofMul x, rfl⟩
  haveI hEfin : Finite ↥E :=
    Finite.of_surjective (fun x : G => (⟨θ (Additive.ofMul x), memE x⟩ : ↥E))
      (fun y => by
        have hy : y.1 ∈ AddSubgroup.toZModSubmodule p θ.range := by
          rw [← hE]; exact y.2
        obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp ((AddSubgroup.mem_toZModSubmodule p).mp hy)
        exact ⟨Additive.toMul z, Subtype.ext (by simpa using hz)⟩)
  haveI hEmodfin : Module.Finite (ZMod p) ↥E := Module.Finite.of_finite
  haveI hEfree : Module.Free (ZMod p) ↥E := Module.Free.of_divisionRing (ZMod p) ↥E
  -- a basis of `E`
  let b : Module.Basis (Fin (Module.finrank (ZMod p) E)) (ZMod p) E := Module.finBasis (ZMod p) E
  -- lift each basis vector to `G`
  have hlift : ∀ i : Fin (Module.finrank (ZMod p) E), ∃ z : Additive G,
      θ z = (b i : Module.Dual (ZMod p) (Additive G →+ ZMod p)) := fun i => by
    have h1 : (b i : Module.Dual (ZMod p) (Additive G →+ ZMod p)) ∈
        AddSubgroup.toZModSubmodule p θ.range := by
      rw [← hE]; exact (b i).2
    exact AddMonoidHom.mem_range.mp ((AddSubgroup.mem_toZModSubmodule p).mp h1)
  let g : Fin (Module.finrank (ZMod p) E) → G := fun i => Additive.toMul (Classical.choose (hlift i))
  have hg : ∀ i, θ (Additive.ofMul (g i)) =
      (b i : Module.Dual (ZMod p) (Additive G →+ ZMod p)) := fun i => by
    have hgc : Additive.ofMul (g i) = Classical.choose (hlift i) := rfl
    rw [hgc]
    exact Classical.choose_spec (hlift i)
  -- the subgroup generated by the lifts
  let K : Subgroup G := Subgroup.closure (Set.range g)
  -- the kernel of `θ`
  let kerθ : Subgroup G :=
    { carrier := {x : G | θ (Additive.ofMul x) = 0}
      mul_mem' := by
        intro a b ha hb
        show θ (Additive.ofMul (a * b)) = 0
        rw [ofMul_mul, map_add, ha, hb, add_zero]
      one_mem' := by
        show θ (Additive.ofMul 1) = 0
        rw [ofMul_one, map_zero]
      inv_mem' := by
        intro a ha
        show θ (Additive.ofMul a⁻¹) = 0
        rw [ofMul_inv, map_neg, ha, neg_zero] }
  have mem_kerθ : ∀ x : G, x ∈ kerθ ↔ θ (Additive.ofMul x) = 0 := fun _ => Iff.rfl
  -- `ker θ` is inside every maximal subgroup
  have hker_le : kerθ ≤ frattini G := by
    rw [frattini, Order.radical]
    refine le_iInf fun M => le_iInf fun hM => ?_
    intro x hx
    rw [mem_kerθ] at hx
    obtain ⟨f, hf⟩ := coatom_ker_eq_aux p G hG M hM
    let fadd : Additive G →+ ZMod p := MonoidHom.toAdditive f
    have hfadd : ∀ y : G, fadd (Additive.ofMul y) = Additive.ofMul (f y) := fun _ => rfl
    have h1 : fadd (Additive.ofMul x) = 0 := by
      have h2 : θ (Additive.ofMul x) fadd = 0 := by rw [hx]; rfl
      rwa [θ_apply] at h2
    have hfx : f x = 1 := by
      have h1' : Additive.ofMul (f x) = 0 := by rw [← hfadd x]; exact h1
      simpa using h1'
    rw [← hf]
    exact MonoidHom.mem_ker.mpr hfx
  -- the basis vectors span `θ(G)`, which is covered by `K`
  have hspan_le : Submodule.span (ZMod p)
        (Set.range fun i => (b i : Module.Dual (ZMod p) (Additive G →+ ZMod p)))
      ≤ AddSubgroup.toZModSubmodule p (AddSubgroup.map θ K.toAddSubgroup) := by
    rw [Submodule.span_le]
    rintro y ⟨i, rfl⟩
    refine (AddSubgroup.mem_toZModSubmodule p).mpr ?_
    refine (AddSubgroup.mem_map).mpr ⟨Additive.ofMul (g i), ?_, hg i⟩
    rw [Additive.mem_toAddSubgroup]
    exact Subgroup.subset_closure ⟨i, rfl⟩
  have hE_le : E ≤ Submodule.span (ZMod p)
      (Set.range fun i => (b i : Module.Dual (ZMod p) (Additive G →+ ZMod p))) := by
    intro y hy
    have hsum : (∑ i, b.repr (⟨y, hy⟩ : E) i •
        ((b i : E) : Module.Dual (ZMod p) (Additive G →+ ZMod p))) = y := by
      have h1 := congrArg (Submodule.subtype E) (Module.Basis.sum_repr b (⟨y, hy⟩ : E))
      simpa only [map_sum, map_smul, Submodule.subtype_apply] using h1
    rw [← hsum]
    exact Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self i))
  -- hence `K` together with `ker θ` generates `G`
  have hKsup : K ⊔ kerθ = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hy3 : θ (Additive.ofMul x) ∈
        AddSubgroup.toZModSubmodule p (AddSubgroup.map θ K.toAddSubgroup) :=
      hspan_le (hE_le (memE x))
    obtain ⟨z, hzK, hz⟩ := AddSubgroup.mem_map.mp ((AddSubgroup.mem_toZModSubmodule p).mp hy3)
    have hkK : Additive.toMul z ∈ K := by
      rw [← Additive.mem_toAddSubgroup]
      exact hzK
    have hker : x * (Additive.toMul z)⁻¹ ∈ kerθ := by
      rw [mem_kerθ]
      have hsub : Additive.ofMul (x * (Additive.toMul z)⁻¹) = Additive.ofMul x - z := by
        simp [ofMul_mul, ofMul_inv, sub_eq_add_neg]
      rw [hsub, map_sub, hz, sub_self]
    have hxeq : x = (x * (Additive.toMul z)⁻¹) * Additive.toMul z := by group
    rw [hxeq]
    have hmem := Subgroup.mul_mem_sup hker hkK
    rwa [sup_comm] at hmem
  -- Frattini's theorem
  have hKtop : K = ⊤ := by
    apply frattini_nongenerating
    rw [eq_top_iff]
    calc ⊤ = K ⊔ kerθ := hKsup.symm
      _ ≤ K ⊔ frattini G := sup_le_sup_left hker_le K
  have hsurj : Function.Surjective (FreeGroup.lift g) :=
    FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr hKtop
  calc Work.Tower.generatorRank G
      ≤ Module.finrank (ZMod p) E :=
        (Work.Tower.Shafarevich.Rank.generatorRank_le_iff (G := G)
          (Module.finrank (ZMod p) E)).mpr ⟨FreeGroup.lift g, hsurj⟩
    _ ≤ Module.finrank (ZMod p) (Module.Dual (ZMod p) (Additive G →+ ZMod p)) :=
        Submodule.finrank_le E
    _ = Module.finrank (ZMod p) (Additive G →+ ZMod p) := Subspace.dual_finrank_eq

/-- **Burnside's basis theorem, lower bound.**  The space `Hom(G, 𝔽ₚ)` embeds into `𝔽ₚ^d` by
restriction to any generating set of `d` elements of a finite group `G`. -/
private theorem finrank_dual_le_generatorRank_aux (p : ℕ) [Fact p.Prime] (G : Type) [Group G]
    [Finite G] :
    Module.finrank (ZMod p) (Additive G →+ ZMod p) ≤ Work.Tower.generatorRank G := by
  classical
  obtain ⟨φ, hφ⟩ :=
    (Work.Tower.Shafarevich.Rank.generatorRank_le_iff (G := G)
      (Work.Tower.generatorRank G)).mp le_rfl
  -- an additive hom vanishing on the images of the free generators is zero
  have key : ∀ h : Additive G →+ ZMod p,
      (∀ i, h (Additive.ofMul (φ (FreeGroup.of i))) = 0) → h = 0 := by
    intro h hgen
    have hψ : ∀ x : G, h (Additive.ofMul x) = 0 := by
      let χ : G →* Multiplicative (ZMod p) :=
        { toFun := fun x => Multiplicative.ofAdd (h (Additive.ofMul x))
          map_one' := by simp [ofMul_one]
          map_mul' := by intro x y; simp [ofMul_mul] }
      have hχ : χ.comp φ = 1 := by
        apply FreeGroup.ext_hom
        intro i
        show Multiplicative.ofAdd (h (Additive.ofMul (φ (FreeGroup.of i)))) = 1
        rw [hgen i, ofAdd_zero]
      intro x
      obtain ⟨w, rfl⟩ := hφ x
      have h2 : χ (φ w) = 1 := DFunLike.congr_fun hχ w
      simpa [χ, ofAdd_eq_one] using h2
    ext x
    rw [← ofMul_toMul x]
    exact hψ (Additive.toMul x)
  let L : (Additive G →+ ZMod p) →ₗ[ZMod p] (Fin (Work.Tower.generatorRank G) → ZMod p) :=
    { toFun := fun f i => f (Additive.ofMul (φ (FreeGroup.of i)))
      map_add' := fun _ _ => by ext i; rfl
      map_smul' := fun _ _ => by ext i; rfl }
  have hL : Function.Injective L := by
    intro f g hfg
    have hgen : ∀ i, (f - g) (Additive.ofMul (φ (FreeGroup.of i))) = 0 := by
      intro i
      have h1 : f (Additive.ofMul (φ (FreeGroup.of i))) =
          g (Additive.ofMul (φ (FreeGroup.of i))) := congrFun hfg i
      rw [AddMonoidHom.sub_apply, h1, sub_self]
    exact sub_eq_zero.mp (key (f - g) hgen)
  have h1 : Module.finrank (ZMod p) (Additive G →+ ZMod p) ≤
      Module.finrank (ZMod p) (Fin (Work.Tower.generatorRank G) → ZMod p) :=
    LinearMap.finrank_le_finrank_of_injective hL
  rwa [Module.finrank_fin_fun (ZMod p)] at h1

/-- For a finite `p`-group `G`, the minimal number of generators equals the `𝔽ₚ`-dimension of
`H¹(G, 𝔽ₚ)` with trivial coefficients. -/
theorem generatorRank_eq_finrank_H1 (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Finite G]
    (hG : IsPGroup p G) :
    Work.Tower.generatorRank G = Module.finrank (ZMod p) (Work.Tower.Shafarevich.H1Fp p G) := by
  rw [Work.Tower.Shafarevich.Cohomology.finrank_H1Fp_eq_finrank_hom p G]
  exact le_antisymm (generatorRank_le_finrank_dual p G hG) (finrank_dual_le_generatorRank_aux p G)

end Work.Tower.Shafarevich.Group

namespace Work.Tower.Shafarevich

/-- Compatibility alias for the result `Work.Tower.Shafarevich.Group.generatorRank_eq_finrank_H1`,
under the name used by the assembly file `Work.Tower.Shafarevich.Main`. -/
theorem generatorRank_eq_finrank_H1 (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Finite G]
    (hG : IsPGroup p G) :
    Work.Tower.generatorRank G = Module.finrank (ZMod p) (Work.Tower.Shafarevich.H1Fp p G) :=
  Work.Tower.Shafarevich.Group.generatorRank_eq_finrank_H1 p G hG

end Work.Tower.Shafarevich
