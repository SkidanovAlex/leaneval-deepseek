import Mathlib
import Submission.Work.Tower.Unramified.SplitsCompletelyNF

/-!
# From the counting normal form to the explicit splitting predicate

`Work.Tower.Unramified.SplitsCompletelyNF q K` records that the primes of `𝓞 K` above `(q) ⊆ ℤ`
are exactly `[K : ℚ]` in number, each with ramification index `1` and inertia degree `1`.

Here we show that this normal form implies the *explicit* predicate
`Work.Defs.SplitsCompletely q K`: the existence of a family `𝔮 : Fin [K : ℚ] → Ideal (𝓞 K)` of
pairwise distinct primes, each containing `q` and with residue field `𝔽_q`, whose product is the
ideal generated by `q`.

The family is obtained by transporting the (`Fintype`-enumerated) set of primes above `(q)`
along an equivalence `primesOver ≃ Fin [K : ℚ]`.  The product identity is the fundamental
identity for the extension of a maximal ideal, `Ideal.map_algebraMap_eq_finsetProd_pow`,
together with the observation that all ramification indices are `1`.
-/

open NumberField
open scoped Classical

namespace Work.Tower.Unramified

theorem splitsCompletely_of_NF {K : Type*} [Field K] [NumberField K] (q : ℕ) (hq : Nat.Prime q)
    (h : Work.Tower.Unramified.SplitsCompletelyNF q K) : Work.Defs.SplitsCompletely q K := by
  have hmax : (Ideal.span {(q : ℤ)} : Ideal ℤ).IsMaximal := isMaximal_span_singleton_int hq
  obtain ⟨hcard, hrf⟩ := h
  have hcard' :
      Fintype.card ((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)) = Module.finrank ℚ K := by
    rw [← Nat.card_eq_fintype_card]; exact hcard
  have e := Fintype.equivFinOfCardEq hcard'
  have hp0 : (Ideal.span {(q : ℤ)} : Ideal ℤ) ≠ 0 := by
    intro h0
    exact hq.ne_zero (by exact_mod_cast (Ideal.span_singleton_eq_bot.mp h0 : (q : ℤ) = 0))
  -- The fundamental identity: `q 𝒪_K` is the product of the primes above `(q)`, all with
  -- ramification index one.
  have hprod : (∏ P : ↥((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)), (P : Ideal (𝓞 K)))
      = Ideal.span {(q : 𝓞 K)} := by
    have hmap := Ideal.map_algebraMap_eq_finsetProd_pow (R := 𝓞 K) (S := ℤ)
      (p := Ideal.span {(q : ℤ)}) hp0
    rw [map_span_singleton_int_eq K q] at hmap
    have hA : Ideal.span {(q : 𝓞 K)} = ∏ i : ↥((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)),
        (i : Ideal (𝓞 K)) ^ (i : Ideal (𝓞 K)).ramificationIdx ℤ :=
      hmap.trans (Finset.prod_set_coe (s := (Ideal.span {(q : ℤ)}).primesOver (𝓞 K))
        (f := fun P : Ideal (𝓞 K) => P ^ P.ramificationIdx ℤ)).symm
    have hB : (∏ i : ↥((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)),
          (i : Ideal (𝓞 K)) ^ (i : Ideal (𝓞 K)).ramificationIdx ℤ)
        = ∏ i : ↥((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)), (i : Ideal (𝓞 K)) :=
      Finset.prod_congr rfl (fun i _ => by rw [(hrf i).1, pow_one])
    exact (hA.trans hB).symm
  refine ⟨fun i => (e.symm i).1, ?_, ?_, ?_, ?_, ?_⟩
  · intro i; exact (e.symm i).2.1
  · intro i
    exact ((mem_primesOver_span_nat_iff hq (e.symm i).1).mp (e.symm i).2).2
  · intro i
    exact nonempty_quot_equiv_zmod_of_inertiaDeg_eq_one hq (e.symm i).2 (hrf (e.symm i)).2
  · intro i j hij hle
    have hmi : ((e.symm i).1 : Ideal (𝓞 K)).IsMaximal :=
      isMaximal_of_mem_primesOver_span hq (e.symm i).2
    have htop : (e.symm j).1 ≠ ⊤ := (e.symm j).2.1.ne_top
    have heq : (e.symm i).1 = (e.symm j).1 := hmi.eq_of_le htop hle
    exact hij (e.symm.injective (Subtype.ext heq))
  · exact hprod.symm.trans (Fintype.prod_equiv e.symm (fun i => (e.symm i : Ideal (𝓞 K)))
      (fun P : ↥((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)) => (P : Ideal (𝓞 K)))
      (fun i => rfl)).symm

end Work.Tower.Unramified
