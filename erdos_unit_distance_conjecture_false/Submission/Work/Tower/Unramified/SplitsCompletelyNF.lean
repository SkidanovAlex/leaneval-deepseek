import Mathlib
import Submission.Work.Tower.Defs
import Submission.Work.Defs.Basic

/-!
# Normal forms for "splits completely"

The predicates `Work.Defs.SplitsCompletely` and `Work.Tower.SplitsCompletelyIn` are formulated
as the existence of an *explicit family* of primes with prescribed residue fields and product.
For the arithmetic arguments (towers of number fields, ramification and inertia degrees) it is
convenient to work instead with the equivalent *counting* normal forms recorded here:

* `SplitsCompletelyNF q K`: the primes of `𝓞 K` above `(q) ⊆ ℤ` are exactly `[K : ℚ]` in number and
  each has ramification index `1` and inertia degree `1` over `ℤ`;
* `SplitsCompletelyInNF F L 𝔭`: the primes of `𝓞 L` above `𝔭` are exactly `[L : F]` in number and
  each has ramification index `1` and inertia degree `1` over `𝓞 F`.

We also record here the elementary API for the set `(q).primesOver (𝓞 K)` of primes above a
rational prime, and the fact that a prime with inertia degree one over a maximal ideal of the
base has residue field isomorphic to the residue field of the base.
-/

open NumberField
open scoped Classical nonZeroDivisors

namespace Work
namespace Tower
namespace Unramified

/-- **Normal form of `Work.Defs.SplitsCompletely`.**  A rational prime `q` splits completely in
the number field `K` iff the primes of `𝓞 K` above `(q) ⊆ ℤ` are exactly `[K : ℚ]` in number and
each of them has ramification index `1` and inertia degree `1` over `ℤ`. -/
def SplitsCompletelyNF (q : ℕ) (K : Type*) [Field K] [NumberField K] : Prop :=
  Nat.card ((Ideal.span {(q : ℤ)}).primesOver (𝓞 K)) = Module.finrank ℚ K ∧
    ∀ P : (Ideal.span {(q : ℤ)}).primesOver (𝓞 K),
      P.1.ramificationIdx ℤ = 1 ∧ P.1.inertiaDeg ℤ = 1

/-- **Normal form of `Work.Tower.SplitsCompletelyIn`.**  The prime `𝔭` of `𝓞 F` splits completely
in `L/F` iff the primes of `𝓞 L` above `𝔭` are exactly `[L : F]` in number and each of them has
ramification index `1` and inertia degree `1` over `𝓞 F`. -/
def SplitsCompletelyInNF (F L : Type*) [Field F] [Field L] [Algebra F L]
    (𝔭 : Ideal (𝓞 F)) : Prop :=
  Nat.card (𝔭.primesOver (𝓞 L)) = Module.finrank F L ∧
    ∀ P : 𝔭.primesOver (𝓞 L),
      P.1.ramificationIdx (𝓞 F) = 1 ∧ P.1.inertiaDeg (𝓞 F) = 1

section PrimesOverNat

variable {K : Type*} [Field K] [NumberField K]

/-- `(q) ⊆ ℤ` is a prime ideal for a prime `q`. -/
lemma isPrime_span_singleton_int {q : ℕ} (hq : q.Prime) :
    (Ideal.span {(q : ℤ)} : Ideal ℤ).IsPrime :=
  (Ideal.span_singleton_prime (by exact_mod_cast hq.ne_zero)).mpr
    (Nat.prime_iff_prime_int.mp hq)

/-- `(q) ⊆ ℤ` is a maximal ideal for a prime `q`. -/
lemma isMaximal_span_singleton_int {q : ℕ} (hq : q.Prime) :
    (Ideal.span {(q : ℤ)} : Ideal ℤ).IsMaximal :=
  (isPrime_span_singleton_int hq).isMaximal
    (by simpa [Ideal.span_singleton_eq_bot] using hq.ne_zero)

/-- The extension of `(q) ⊆ ℤ` to `𝓞 K` is generated by `q`. -/
lemma map_span_singleton_int_eq (K : Type*) [Field K] [NumberField K] (q : ℕ) :
    Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {(q : ℤ)}) = Ideal.span {(q : 𝓞 K)} := by
  rw [Ideal.map_span]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_singleton_iff]
  constructor
  · rintro ⟨y, rfl, rfl⟩
    simp
  · intro hx
    exact ⟨(q : ℤ), rfl, by simpa using hx.symm⟩

/-- A prime of `𝓞 K` contains the integer `q` exactly when it lies above `(q) ⊆ ℤ`. -/
lemma mem_primesOver_span_nat_iff {q : ℕ} (hq : q.Prime) (P : Ideal (𝓞 K)) :
    P ∈ (Ideal.span {(q : ℤ)}).primesOver (𝓞 K) ↔ P.IsPrime ∧ (q : 𝓞 K) ∈ P := by
  constructor
  · intro h
    haveI : P.LiesOver (Ideal.span {(q : ℤ)}) := h.2
    refine ⟨h.1, ?_⟩
    have hqP : algebraMap ℤ (𝓞 K) ((q : ℕ) : ℤ) ∈ P :=
      (Ideal.mem_of_liesOver (P := P) (p := (Ideal.span {(q : ℤ)} : Ideal ℤ)) ((q : ℕ) : ℤ)).mp
        (Ideal.subset_span (Set.mem_singleton _))
    simpa using hqP
  · rintro ⟨hp, hqp⟩
    refine ⟨hp, ?_⟩
    rw [Ideal.liesOver_iff]
    refine (isMaximal_span_singleton_int hq).eq_of_le ?_ ?_
    · intro htop
      refine hp.ne_top ?_
      rw [Ideal.under_def] at htop
      exact Ideal.comap_eq_top_iff.mp htop
    · rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact Ideal.mem_comap.mpr (by simpa using hqp)

/-- A prime of `𝓞 K` above a rational prime `q` is maximal. -/
lemma isMaximal_of_mem_primesOver_span {q : ℕ} (hq : q.Prime) {P : Ideal (𝓞 K)}
    (hP : P ∈ (Ideal.span {(q : ℤ)}).primesOver (𝓞 K)) : P.IsMaximal := by
  have h1 : (q : 𝓞 K) ∈ P := ((mem_primesOver_span_nat_iff hq P).mp hP).2
  refine (mem_primesOver_span_nat_iff hq P).mp hP |>.1.isMaximal ?_
  intro hbot
  have hq0 : (q : 𝓞 K) = 0 := by simpa [hbot] using h1
  exact hq.ne_zero (Nat.cast_eq_zero.mp hq0)

end PrimesOverNat

section QuotEquiv

/-- The canonical ring homomorphism `A ⧸ p →+* B ⧸ P` attached to an ideal `P` lying over `p`. -/
def quotientMap {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] (p : Ideal A)
    (P : Ideal B) [P.LiesOver p] : (A ⧸ p) →+* (B ⧸ P) :=
  Ideal.Quotient.lift p ((Ideal.Quotient.mk P).comp (algebraMap A B))
    (fun a ha => by
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact (Ideal.mem_of_liesOver (P := P) (p := p) a).mp ha)

@[simp]
lemma quotientMap_mk {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] (p : Ideal A)
    (P : Ideal B) [P.LiesOver p] (x : A) :
    quotientMap p P (Ideal.Quotient.mk p x) = Ideal.Quotient.mk P (algebraMap A B x) := rfl

/-- The canonical map `A ⧸ p →+* B ⧸ P` of an ideal lying over `p` is injective. -/
lemma quotientMap_injective {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] (p : Ideal A)
    (P : Ideal B) [P.LiesOver p] : Function.Injective (quotientMap p P) := by
  intro a b hab
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [quotientMap_mk, quotientMap_mk] at hab
  have h1 : Ideal.Quotient.mk P (algebraMap A B (x - y)) = 0 := by
    rw [← sub_eq_zero] at hab
    rw [← map_sub] at hab
    rw [← map_sub] at hab
    exact hab
  have h2 : algebraMap A B (x - y) ∈ P := Ideal.Quotient.eq_zero_iff_mem.mp h1
  have h3 : x - y ∈ p := (Ideal.mem_of_liesOver (P := P) (p := p) (x - y)).mpr h2
  have h4 : Ideal.Quotient.mk p (x - y) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h3
  have h5 : Ideal.Quotient.mk p x - Ideal.Quotient.mk p y = 0 := by
    rwa [map_sub] at h4
  exact sub_eq_zero.mp h5

/-- **Residue fields of a prime of inertia degree one.**  If `P` is a prime ideal of `B` lying
over an ideal `p` of `A`, and the residue fields have the same (finite) cardinality, then the
canonical map identifies them. -/
theorem nonempty_quot_equiv_of_card_eq {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {p : Ideal A} {P : Ideal B} [P.LiesOver p] [Fintype (A ⧸ p)] [Fintype (B ⧸ P)]
    (hcard : Nat.card (B ⧸ P) = Nat.card (A ⧸ p)) : Nonempty ((A ⧸ p) ≃+* (B ⧸ P)) := by
  have hinj : Function.Injective (quotientMap p P) := quotientMap_injective p P
  have hbij : Function.Bijective (quotientMap p P) :=
    (Fintype.bijective_iff_injective_and_card _).mpr ⟨hinj, by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]; exact hcard.symm⟩
  exact ⟨RingEquiv.ofBijective (quotientMap p P) hbij⟩

/-- The quotient `ℤ ⧸ (q)` has `q` elements. -/
lemma natCard_quot_span_nat (K : Type*) [Field K] [NumberField K] (q : ℕ) :
    Nat.card (ℤ ⧸ Ideal.span {(q : ℤ)}) = q := by
  rw [Nat.card_congr (Int.quotientSpanNatEquivZMod q).toEquiv, Nat.card_zmod]

/-- `absNorm` of an ideal of a Dedekind domain is the cardinality of the quotient. -/
lemma absNorm_eq_natCard {R : Type*} [CommRing R] [IsDedekindDomain R] [Infinite R]
    (I : Ideal R) : Ideal.absNorm I = Nat.card (R ⧸ I) := by
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]

/-- **A prime of `𝓞 K` above `q` with inertia degree `1` has residue field `𝔽_q`.** -/
theorem nonempty_quot_equiv_zmod_of_inertiaDeg_eq_one {K : Type*} [Field K] [NumberField K]
    {q : ℕ} (hq : q.Prime) {P : Ideal (𝓞 K)}
    (hP : P ∈ (Ideal.span {(q : ℤ)}).primesOver (𝓞 K)) (hf : P.inertiaDeg ℤ = 1) :
    Nonempty (𝓞 K ⧸ P ≃+* ZMod q) := by
  haveI : P.IsPrime := hP.1
  haveI : P.LiesOver (Ideal.span {(q : ℤ)}) := hP.2
  haveI : P.IsMaximal := isMaximal_of_mem_primesOver_span hq hP
  haveI : Finite (𝓞 K ⧸ P) := inferInstance
  haveI : Fintype (𝓞 K ⧸ P) := Fintype.ofFinite _
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI : Fintype (ℤ ⧸ Ideal.span {(q : ℤ)}) :=
    Fintype.ofEquiv (ZMod q) (Int.quotientSpanNatEquivZMod q).toEquiv.symm
  have hcard : Nat.card ((𝓞 K) ⧸ P) = Nat.card (ℤ ⧸ Ideal.span {(q : ℤ)}) := by
    rw [← absNorm_eq_natCard P, ← Ideal.natAbs_pow_inertiaDeg (q : ℤ) P, hf, pow_one,
      Int.natAbs_natCast, natCard_quot_span_nat K q]
  obtain ⟨e⟩ := nonempty_quot_equiv_of_card_eq hcard
  exact ⟨e.symm.trans (Int.quotientSpanNatEquivZMod q)⟩

/-- **A prime of `𝓞 L` above `𝔭` with inertia degree `1` has residue field `𝓞 F ⧸ 𝔭`.** -/
theorem nonempty_quot_equiv_of_inertiaDeg_eq_one {F L : Type*} [Field F] [Field L] [NumberField F]
    [NumberField L] [Algebra F L] [FiniteDimensional F L] {𝔭 : Ideal (𝓞 F)} {P : Ideal (𝓞 L)}
    [P.IsPrime] [P.LiesOver 𝔭] [𝔭.IsMaximal] [P.IsMaximal] (hf : P.inertiaDeg (𝓞 F) = 1) :
    Nonempty ((𝓞 L) ⧸ P ≃+* (𝓞 F) ⧸ 𝔭) := by
  haveI : Finite (𝓞 F ⧸ 𝔭) := inferInstance
  haveI : Finite (𝓞 L ⧸ P) := inferInstance
  haveI : Fintype (𝓞 F ⧸ 𝔭) := Fintype.ofFinite _
  haveI : Fintype (𝓞 L ⧸ P) := Fintype.ofFinite _
  have hcard : Nat.card ((𝓞 L) ⧸ P) = Nat.card ((𝓞 F) ⧸ 𝔭) := by
    rw [← absNorm_eq_natCard P, ← absNorm_eq_natCard 𝔭, ← Ideal.absNorm_pow_inertiaDeg 𝔭 P, hf,
      pow_one]
  obtain ⟨e⟩ := nonempty_quot_equiv_of_card_eq hcard
  exact ⟨e.symm⟩

end QuotEquiv

end Unramified
end Tower
end Work
