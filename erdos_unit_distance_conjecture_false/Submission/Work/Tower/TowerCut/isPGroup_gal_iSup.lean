import Mathlib
import Submission.Work.Tower.Defs

namespace Work.Tower.TowerCut

-- Imports: Mathlib, Submission.Work.Tower.Defs
-- `Gal(L/K)` is Mathlib notation for `L ≃ₐ[K] L`.  Mathlib has the binary version
-- `IntermediateField.restrictNormalHomSupProd` / `restrictNormalHomSupProd_injective`
-- (`Mathlib/FieldTheory/Galois/Basic.lean`), from which `AlgEquiv.restrictNormalHom` gives the
-- restriction map on each factor.  Route: build the injective homomorphism
--   `Gal(⨆ i, M i /F) →* (∀ i, Gal(M i /F))`
-- (an `F`-automorphism of the supremum fixing each `M i` is the identity, since `⨆ i, M i` is
-- generated by the union, via `IntermediateField.iSup_le_iff`, `le_iSup`, `AlgEquiv.ext`), then
-- `IsPGroup.of_injective`.  For the target: a tuple in a finite product of groups of exponent
-- dividing a power of `3` again has order a power of `3` (take the maximum of the finitely many
-- exponents; the elementwise formulation avoids needing the factors to be finite).

open NumberField
open scoped Classical nonZeroDivisors

variable {ι : Type*} [Finite ι] {F A : Type*} [Field F] [Field A] [Algebra F A]

/-- The subgroup of `Gal(E/F)` fixing a supremum `⨆ i, L i` of intermediate fields pointwise is
the infimum of the subgroups fixing each `L i` pointwise. -/
theorem fixingSubgroup_iSup {ι' : Type*} {F' E : Type*} [Field F'] [Field E] [Algebra F' E]
    (L : ι' → IntermediateField F' E) :
    (⨆ i, L i).fixingSubgroup = ⨅ i, (L i).fixingSubgroup := by
  ext φ
  rw [Subgroup.mem_iInf]
  constructor
  · intro h i
    exact IntermediateField.fixingSubgroup_le (le_iSup L i) h
  · intro h
    rw [← Subgroup.zpowers_le, ← IntermediateField.le_iff_le, iSup_le_iff]
    intro i
    rw [IntermediateField.le_iff_le, Subgroup.zpowers_le]
    exact h i

/-- Lifting an intermediate field of an intermediate field commutes with suprema. -/
theorem lift_iSup {K L : Type*} [Field K] [Field L] [Algebra K L]
    (E : IntermediateField K L) {ι' : Type*} (M : ι' → IntermediateField K E) :
    IntermediateField.lift (⨆ i, M i) = ⨆ i, IntermediateField.lift (M i) := by
  simp only [IntermediateField.lift, IntermediateField.map_iSup]

/-- A finite product of `p`-groups is a `p`-group.  (Stated elementwise so that the factors are
not required to be finite.) -/
theorem isPGroup_pi {ι' : Type*} [Finite ι'] {G : ι' → Type*} [∀ i, Group (G i)] {p : ℕ}
    (h : ∀ i, IsPGroup p (G i)) :
    IsPGroup p (∀ i, G i) := by
  classical
  cases nonempty_fintype ι'
  intro g
  choose k hk using fun i => h i (g i)
  refine ⟨Finset.univ.sup k, ?_⟩
  funext i
  rw [Pi.pow_apply, Pi.one_apply]
  obtain ⟨c, hc⟩ := pow_dvd_pow p (Finset.le_sup (f := k) (Finset.mem_univ i))
  rw [hc, pow_mul, hk i, one_pow]

section RestrictISup

variable {ι' : Type*} (M : ι' → IntermediateField F A)

/-- The `F`-algebra structure on `↥(M i)` induced by the inclusion `M i → ⨆ i, M i`. -/
local instance instAlgSupPi (i : ι') : Algebra ↥(M i) ↥(⨆ i, M i) :=
  (IntermediateField.inclusion (le_iSup M i)).toAlgebra

/-- The restriction homomorphism embedding the automorphism group of a supremum `⨆ i, M i` of
normal factors `M i` into the product of the automorphism groups of the factors,
`σ ↦ (σ|_(M i))_i`. -/
noncomputable def restrictNormalHomISupPi [∀ i, Normal F ↥(M i)] :
    Gal(↥(⨆ i, M i)/F) →* (∀ i, Gal(↥(M i)/F)) :=
  MonoidHom.pi fun i => AlgEquiv.restrictNormalHom ↥(M i)

/-- The restriction homomorphism into the product of the factor automorphism groups is injective:
an automorphism of the supremum is determined by its restrictions to the factors, because the
supremum is generated by the union of the factors. -/
theorem restrictNormalHomISupPi_injective [∀ i, Normal F ↥(M i)] :
    Function.Injective (restrictNormalHomISupPi M) := by
  intro σ τ hστ
  have hcomp : ∀ i, AlgEquiv.restrictNormalHom ↥(M i) σ
      = AlgEquiv.restrictNormalHom ↥(M i) τ := fun i => congr_fun hστ i
  have htop : (⨆ i, (IsScalarTower.toAlgHom F ↥(M i) ↥(⨆ i, M i)).fieldRange) = ⊤ := by
    change ⨆ i, IntermediateField.restrict (le_iSup M i) = ⊤
    refine IntermediateField.lift_injective (⨆ i, M i) ?_
    rw [lift_iSup, IntermediateField.lift_top]
    simp
  have hmem : σ * τ⁻¹ ∈ ⨅ i, (AlgEquiv.restrictNormalHom ↥(M i)).ker := by
    rw [Subgroup.mem_iInf]
    intro i
    rw [MonoidHom.mem_ker, map_mul, map_inv, hcomp i, mul_inv_cancel]
  rw [iInf_congr (fun i => AlgEquiv.ker_restrictNormalHom ↥(M i)), ← fixingSubgroup_iSup, htop,
      IntermediateField.fixingSubgroup_top, Subgroup.mem_bot] at hmem
  rwa [mul_inv_eq_one] at hmem

end RestrictISup

theorem isPGroup_gal_iSup
    (M : ι → IntermediateField F A) [∀ i, IsGalois F (M i)]
    (h : ∀ i, IsPGroup 3 (Gal(↥(M i)/F))) :
    IsPGroup 3 (Gal(↥(⨆ i, M i)/F)) := by
  have : ∀ i, Normal F ↥(M i) := fun i => inferInstance
  exact IsPGroup.of_injective (isPGroup_pi h) (restrictNormalHomISupPi M)
    (restrictNormalHomISupPi_injective M)

end Work.Tower.TowerCut
