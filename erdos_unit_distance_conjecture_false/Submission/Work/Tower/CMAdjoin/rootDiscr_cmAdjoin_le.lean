import Mathlib
import Submission.Work.Tower.CMAdjoin.Basic
import Submission.Work.Tower.CMAdjoin.minpoly_iotaInt

/-!
# The root discriminant of `L(i)` is at most twice that of `L`

For a totally real number field `L` with `n = [L : ℚ]`, this file proves

`rootDiscr (L(i)) ≤ 2 * rootDiscr L`,

the estimate used in the final step of the class-field tower of *Planar Point Sets with
Many Unit Distances* (Erdős's unit-distance conjecture is false).

## The mathematics

The different ideal of `L(i)/L` divides the different of the order `𝓞 L[i]`, which is
generated by the derivative `2i` of the minimal polynomial `X ^ 2 + 1` of `i`; since `i` is a
unit and `2i` generates the same ideal as `2`, the different divides `(2)`.  Hence the
relative discriminant, whose absolute norm is the norm of the different, is at most
`2 ^ [L(i) : L] = 4`.  The discriminant tower formula

`|discr L(i)| = N(𝔡_{L(i)/L}) * |discr L| ^ [L(i) : L]`

then gives `|discr L(i)| ≤ 4 ^ n * |discr L| ^ 2`, and taking the `2n`-th root produces the
root-discriminant bound.

## Main results

* `Work.Tower.CMAdjoin.rpow_le_of_le_four_pow_mul_sq`: the elementary real-variable step.
* `Work.Tower.CMAdjoin.rootDiscr_cmAdjoin_le`: the requested estimate.

-/

open Polynomial NumberField
open scoped Classical nonZeroDivisors

namespace Work
namespace Tower
namespace CMAdjoin

/-- Elementary root extraction: if `dK ≤ 4 ^ n * dL ^ 2`, then the `2n`-th root of `dK` is at
most `2` times the `n`-th root of `dL`.  This is the arithmetic core of the bound
`rootDiscr L(i) ≤ 2 * rootDiscr L`. -/
lemma rpow_le_of_le_four_pow_mul_sq {dK dL : ℝ} (hK : 0 ≤ dK) (hL : 0 ≤ dL) {n : ℕ}
    (hn : 0 < n) (h : dK ≤ 4 ^ n * dL ^ 2) :
    dK ^ ((2 * n : ℕ) : ℝ)⁻¹ ≤ 2 * dL ^ (n : ℝ)⁻¹ := by
  have h2n : (2 * n : ℕ) ≠ 0 := by positivity
  have hn' : n ≠ 0 := hn.ne'
  -- Raise the desired inequality to the power `2 * n`.
  have hmain : (dK ^ ((2 * n : ℕ) : ℝ)⁻¹) ^ (2 * n) ≤ (2 * dL ^ (n : ℝ)⁻¹) ^ (2 * n) := by
    rw [Real.rpow_inv_natCast_pow hK h2n, mul_pow,
      show (2 : ℝ) ^ (2 * n) = 4 ^ n by rw [pow_mul]; norm_num,
      show (dL ^ (n : ℝ)⁻¹) ^ (2 * n) = dL ^ 2 by
        rw [show 2 * n = n * 2 by omega, pow_mul, Real.rpow_inv_natCast_pow hL hn']]
    exact h
  exact le_of_pow_le_pow_left₀ h2n (by positivity) hmain

theorem rootDiscr_cmAdjoin_le (L : Type*) [Field L] [NumberField L]
    [NumberField.IsTotallyReal L] :
    NumberField.rootDiscr (Work.Tower.CMAdjoin.cmAdjoin L) ≤ 2 * NumberField.rootDiscr L := by
  -- `i` generates `L(i)` over `L`.
  have hx : Algebra.adjoin L {algebraMap (𝓞 (cmAdjoin L)) (cmAdjoin L) (iotaInt L)} = ⊤ := by
    rw [show algebraMap (𝓞 (cmAdjoin L)) (cmAdjoin L) (iotaInt L) = iota L from rfl]
    exact adjoin_iota_eq_top L
  -- The derivative `f'(i) = 2 i` of the minimal polynomial of `i` lies in the different.
  have hmem : (2 : 𝓞 (cmAdjoin L)) * iotaInt L ∈ differentIdeal (𝓞 L) (𝓞 (cmAdjoin L)) := by
    have h := aeval_derivative_mem_differentIdeal (𝓞 L) L (cmAdjoin L) (iotaInt L) hx
    have hmin : minpoly (𝓞 L) (iotaInt L) = sqAddOne (𝓞 L) := by
      rw [minpoly_iotaInt L, sqAddOne_eq]
    rw [hmin, sqAddOne_derivative] at h
    have h2 : (Polynomial.aeval (iotaInt L)) ((Polynomial.C (2 : 𝓞 L)) * Polynomial.X)
        = (2 : 𝓞 (cmAdjoin L)) * iotaInt L := by
      rw [Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X, map_ofNat]
    rwa [h2] at h
  -- `iota` is a unit, so `(2 * iota) = (2)` as ideals and the different divides `(2)`.
  have hspan : Ideal.span {(2 : 𝓞 (cmAdjoin L)) * iotaInt L}
      = Ideal.span {(2 : 𝓞 (cmAdjoin L))} := by
    rw [← Ideal.span_singleton_mul_span_singleton,
      Ideal.span_singleton_eq_top.mpr (isUnit_iotaInt L), Ideal.mul_top]
  have hle : Ideal.span {(2 : 𝓞 (cmAdjoin L))} ≤ differentIdeal (𝓞 L) (𝓞 (cmAdjoin L)) := by
    rw [← hspan, Ideal.span_le]
    rintro x rfl
    exact hmem
  -- Norm of the different is at most `4 ^ [L : ℚ]`.
  have hle' : Ideal.absNorm (differentIdeal (𝓞 L) (𝓞 (cmAdjoin L))) ≤ 4 ^ Module.finrank ℚ L := by
    have hdvd2 : Ideal.absNorm (differentIdeal (𝓞 L) (𝓞 (cmAdjoin L))) ∣
        2 ^ Module.finrank ℤ (𝓞 (cmAdjoin L)) := by
      have h := Ideal.absNorm_dvd_absNorm_of_le hle
      have h2 : Ideal.absNorm (Ideal.span {(2 : 𝓞 (cmAdjoin L))}) =
          2 ^ Module.finrank ℤ (𝓞 (cmAdjoin L)) := by
        simpa using Ideal.absNorm_span_natCast (S := 𝓞 (cmAdjoin L)) 2
      rwa [h2] at h
    have hfin : Module.finrank ℤ (𝓞 (cmAdjoin L)) = 2 * Module.finrank ℚ L := by
      rw [← IsFractionRing.finrank_eq ℤ ℚ (𝓞 (cmAdjoin L)) (cmAdjoin L)]
      exact finrank_cmAdjoin_rat L
    have hpow : 2 ^ Module.finrank ℤ (𝓞 (cmAdjoin L)) = 4 ^ Module.finrank ℚ L := by
      rw [hfin, Nat.pow_mul, show (2 : ℕ) ^ 2 = 4 by norm_num]
    rw [hpow] at hdvd2
    exact Nat.le_of_dvd (by positivity) hdvd2
  -- The discriminant tower formula.
  have hdiscr : (discr (cmAdjoin L)).natAbs
      ≤ 4 ^ Module.finrank ℚ L * (discr L).natAbs ^ 2 := by
    have ht := NumberField.natAbs_discr_eq_absNorm_differentIdeal_mul_natAbs_discr_pow
      (L) (𝓞 L) (cmAdjoin L) (𝓞 (cmAdjoin L))
    rw [finrank_cmAdjoin L] at ht
    rw [ht]
    exact Nat.mul_le_mul_right _ hle'
  have hreal : (((|discr (cmAdjoin L)| : ℤ)) : ℝ)
      ≤ (4 : ℝ) ^ Module.finrank ℚ L * (((|discr L| : ℤ)) : ℝ) ^ 2 := by
    have hc : ((discr (cmAdjoin L)).natAbs : ℝ)
        ≤ (4 : ℝ) ^ Module.finrank ℚ L * ((discr L).natAbs : ℝ) ^ 2 := by
      exact_mod_cast hdiscr
    rw [Nat.cast_natAbs, Nat.cast_natAbs] at hc
    exact hc
  -- Take `2 * [L : ℚ]`-th roots.
  rw [rootDiscr_def, rootDiscr_def, finrank_cmAdjoin_rat L]
  refine rpow_le_of_le_four_pow_mul_sq ?_ ?_ ?_ hreal
  · exact_mod_cast abs_nonneg (discr (cmAdjoin L))
  · exact_mod_cast abs_nonneg (discr L)
  · exact Module.finrank_pos

end CMAdjoin
end Tower
end Work
