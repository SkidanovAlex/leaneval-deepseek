# Free groups are coherent

A group is *coherent* if each of its finitely generated subgroups is finitely presented
(`Group.Coherent`, see `ChallengeDeps.lean`).  This file proves that free groups are coherent,
which is the base case of the inductive scheme of Jaikin-Zapirain--Linton,
*On the coherence of one-relator groups and their group algebras*, Annals of Math. 201 (2025).

The mathematical content is classical:

* by the Nielsen--Schreier theorem a subgroup `H ≤ FreeGroup α` is free
  (Mathlib's `subgroupIsFreeOfIsFree`), say `H ≃* FreeGroup X`;
* a finitely generated free group is free on *finitely many* generators: this is the only point
  that needs an argument.  If `S` is a finite generating set of `H` then every generator of `H`
  occurs in the reduced word of some element of `S`.  Formally, an element of the subgroup
  generated by a set `A` of elements of a free group only involves generators occurring in the
  elements of `A` (`gens_subset_of_mem_closure`), and `FreeGroup.gens x` is finite
  (`FreeGroup.gens_finite`, from the `ORReductions` chapter);
* a free group on a finite type is finitely presented (Mathlib's
  `Group.IsFinitelyPresented (FreeGroup α)` instance for `[Finite α]`), and finite presentability
  transfers across the isomorphism `H ≃* FreeGroup X`.

## Main result

* `Work.ORAssembly.Coherent.freeGroup_coherent`: `FreeGroup α` is coherent.
-/
import Mathlib
import Submission.Work.ORReductions.API

namespace Work.ORAssembly.Coherent

universe u

set_option linter.style.haveILetI false

/-! ### The support of a subgroup of a free group -/

/-- An element of the subgroup generated by a set `A` of elements of a free group only involves
generators that occur in the elements of `A`.

Indeed, writing `U := ⋃ a ∈ A, gens a`, every `a ∈ A` satisfies `gens a ⊆ U`, hence lies in the
subgroup generated by `FreeGroup.of '' U` (`FreeGroup.mem_closure_iff`); so `closure A` is
contained in `closure (FreeGroup.of '' U)` and another application of `FreeGroup.mem_closure_iff`
identifies the support of `y`. -/
theorem gens_subset_of_mem_closure {α : Type*} {A : Set (FreeGroup α)} {y : FreeGroup α}
    (hy : y ∈ Subgroup.closure A) :
    FreeGroup.gens y ⊆ ⋃ a ∈ A, FreeGroup.gens a := by
  have key : A ⊆ (Subgroup.closure (FreeGroup.of '' (⋃ a ∈ A, FreeGroup.gens a)) : Set _) := by
    intro a ha
    refine (FreeGroup.mem_closure_iff (S := ⋃ a ∈ A, FreeGroup.gens a) a).mpr ?_
    intro z hz
    exact Set.mem_iUnion₂.mpr ⟨a, ha, hz⟩
  have hle : Subgroup.closure A ≤
      Subgroup.closure (FreeGroup.of '' (⋃ a ∈ A, FreeGroup.gens a)) :=
    (Subgroup.closure_le _).mpr key
  exact (FreeGroup.mem_closure_iff (S := ⋃ a ∈ A, FreeGroup.gens a) y).mp (hle hy)

/-- **A finitely generated free group has only finitely many generators.** -/
theorem finite_generators_of_fg (G : Type u) [Group G] [IsFreeGroup G] [Group.FG G] :
    Finite (IsFreeGroup.Generators G) := by
  classical
  obtain ⟨n, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
  -- every generator of `G` occurs in the image under `IsFreeGroup.toFreeGroup` of some `s ∈ S`
  have hfin : (⋃ s ∈ (S : Set G), FreeGroup.gens (IsFreeGroup.toFreeGroup G s)).Finite :=
    S.finite_toSet.biUnion fun s _ => FreeGroup.gens_finite _
  have hsub : (Set.univ : Set (IsFreeGroup.Generators G)) ⊆
      (⋃ s ∈ (S : Set G), FreeGroup.gens (IsFreeGroup.toFreeGroup G s)) := by
    intro x _
    have hxcl : IsFreeGroup.of x ∈ Subgroup.closure (S : Set G) := by
      rw [hS]; exact Subgroup.mem_top _
    -- transport along `IsFreeGroup.toFreeGroup`, which sends `of x` to `FreeGroup.of x`
    have hmem : (IsFreeGroup.toFreeGroup G) (IsFreeGroup.of x) ∈
        Subgroup.closure ((IsFreeGroup.toFreeGroup G) '' (S : Set G)) := by
      have hle : Subgroup.closure (S : Set G) ≤
          (Subgroup.closure ((IsFreeGroup.toFreeGroup G) '' (S : Set G))).comap
            (IsFreeGroup.toFreeGroup G : G →* FreeGroup (IsFreeGroup.Generators G)) := by
        refine (Subgroup.closure_le _).mpr ?_
        intro a ha
        exact Subgroup.subset_closure ⟨a, ha, rfl⟩
      exact hle hxcl
    have hyx : (IsFreeGroup.toFreeGroup G) (IsFreeGroup.of x) = FreeGroup.of x := by
      simp [IsFreeGroup.toFreeGroup, IsFreeGroup.of]
    have hxg : x ∈ FreeGroup.gens ((IsFreeGroup.toFreeGroup G) (IsFreeGroup.of x)) := by
      rw [hyx, FreeGroup.gens_of]
      exact Set.mem_singleton x
    obtain ⟨a, ha, hxa⟩ := Set.mem_iUnion₂.mp (gens_subset_of_mem_closure hmem hxg)
    obtain ⟨s, hs, rfl⟩ := ha
    exact Set.mem_iUnion₂.mpr ⟨s, hs, hxa⟩
  exact Set.finite_univ_iff.mp (hfin.subset hsub)

/-! ### Coherence of free groups -/

/-- **Free groups are coherent**: every finitely generated subgroup of a free group is free, and
a finitely generated free group is free on a finite set of generators, hence finitely
presented. -/
theorem freeGroup_coherent (α : Type u) : Group.Coherent (FreeGroup α) := by
  intro H hH
  haveI : IsFreeGroup H := inferInstance
  haveI : Group.FG H := (Group.fg_iff_subgroup_fg H).mpr hH
  haveI : Finite (IsFreeGroup.Generators H) := finite_generators_of_fg H
  exact Group.IsFinitelyPresented.equiv (IsFreeGroup.toFreeGroup H).symm

end Work.ORAssembly.Coherent
