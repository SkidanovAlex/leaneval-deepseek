import Mathlib
import Submission.Work.ORDunwoody.Bridge
import Submission.Work.ORReductions.API
import Submission.Work.FinitePresentation.of_ringEquiv

universe u v

namespace Work.ORAssembly.FP2

open MonoidAlgebra

/-! ## Two supporting lemmas

The proof of `homologicallyCoherent_of_fg` below reduces an arbitrary one-relator group to its
finitely generated one-relator subgroups (`oneRelator_fg_reduction`) and concludes using the
hypothesis `h` at finite rank.  The two reductions it needs are recorded here:

* `subgroupOf_fg`: a finitely generated subgroup of `G`, viewed as a subgroup of an intermediate
  subgroup `K`, is still finitely generated;
* `isFP2_of_mulEquiv_fg`: `IsFP₂` is invariant under group isomorphism.
-/

/-- If `H` is a finitely generated subgroup of `G` and `H ≤ K`, then `H` viewed as a subgroup
of `K` (`H.subgroupOf K`) is finitely generated. -/
theorem subgroupOf_fg {G : Type*} [Group G] {H K : Subgroup G} (h : H.FG) (hle : H ≤ K) :
    (H.subgroupOf K).FG := by
  classical
  obtain ⟨S, hS, hfin⟩ := (Subgroup.fg_iff H).mp h
  have hSK : S ⊆ (K : Set G) := fun x hx => hle (hS ▸ Subgroup.subset_closure hx)
  refine (Subgroup.fg_iff (H.subgroupOf K)).mpr ⟨K.subtype ⁻¹' S, ?_, hfin.preimage ?_⟩
  · have himg : K.subtype '' (K.subtype ⁻¹' S) = S := by
      rw [Set.image_preimage_eq_inter_range, Subgroup.coe_subtype, Subtype.range_coe,
        Set.inter_eq_left.mpr hSK]
    have h1 : ((Subgroup.closure (K.subtype ⁻¹' S)).map K.subtype) =
        (H.subgroupOf K).map K.subtype := by
      rw [MonoidHom.map_closure, himg, hS, Subgroup.map_subgroupOf_eq_of_le hle]
    exact le_antisymm
      ((Subgroup.map_le_map_iff_of_injective K.subtype_injective).mp h1.le)
      ((Subgroup.map_le_map_iff_of_injective K.subtype_injective).mp h1.ge)
  · exact fun x _ y _ hxy => Subtype.ext hxy

/-- The augmentation ideal is carried to the augmentation ideal by the ring isomorphism of group
algebras induced by a group isomorphism. -/
theorem augmentationIdeal_map_mapDomainRingEquiv {k : Type u} [CommRing k] {G H : Type v}
    [Group G] [Group H] (e : G ≃* H) :
    Ideal.map (MonoidAlgebra.mapDomainRingEquiv k e)
        (Work.ORDunwoody.augmentationIdeal k G)
      = Work.ORDunwoody.augmentationIdeal k H := by
  have h1 : ∀ g : G, MonoidAlgebra.mapDomainRingEquiv k e
      (MonoidAlgebra.of k G g - 1) = MonoidAlgebra.of k H (e g) - 1 := by
    intro g
    rw [map_sub, map_one, MonoidAlgebra.of_apply, MonoidAlgebra.of_apply,
      MonoidAlgebra.mapDomainRingEquiv_single]
  rw [Work.ORDunwoody.augmentationIdeal, Ideal.map_span, Work.ORDunwoody.augmentationIdeal]
  congr 1
  ext y
  constructor
  · rintro ⟨x, ⟨g, rfl⟩, rfl⟩
    exact ⟨e g, (h1 g).symm⟩
  · rintro ⟨h, rfl⟩
    exact ⟨MonoidAlgebra.of k G (e.symm h) - 1, ⟨e.symm h, rfl⟩,
      by rw [h1, e.apply_symm_apply]⟩

/-- `IsFP₂` is invariant under group isomorphism. -/
theorem isFP2_of_mulEquiv_fg {k : Type u} [CommRing k] {G H : Type v} [Group G] [Group H]
    (e : G ≃* H) : Work.ORDunwoody.IsFP2 k G → Work.ORDunwoody.IsFP2 k H := by
  intro hG
  let φ : MonoidAlgebra k G ≃+* MonoidAlgebra k H := MonoidAlgebra.mapDomainRingEquiv k e
  have hmap : Ideal.map φ (Work.ORDunwoody.augmentationIdeal k G)
      = Work.ORDunwoody.augmentationIdeal k H :=
    augmentationIdeal_map_mapDomainRingEquiv e
  let ψ : (Work.ORDunwoody.augmentationIdeal k G) ≃+
      (Work.ORDunwoody.augmentationIdeal k H) :=
    { toFun := fun x => ⟨φ x, by rw [← hmap]; exact Ideal.mem_map_of_mem φ x.2⟩
      invFun := fun y => ⟨φ.symm y, by
        have hy : (y : MonoidAlgebra k H) ∈
            Ideal.map φ (Work.ORDunwoody.augmentationIdeal k G) := by
          rw [hmap]; exact y.2
        obtain ⟨x, hx, hxy⟩ := (Ideal.mem_map_iff_of_surjective φ φ.surjective).mp hy
        rw [← hxy, RingEquiv.symm_apply_apply]
        exact hx⟩
      left_inv := fun x => Subtype.ext (by simp)
      right_inv := fun y => Subtype.ext (by simp)
      map_add' := fun x y => Subtype.ext (by simp) }
  refine Work.FinitePresentation.of_ringEquiv φ ψ ?_ hG
  intro r m
  apply Subtype.ext
  show φ (r * (m : MonoidAlgebra k G)) = φ r * φ (m : MonoidAlgebra k G)
  rw [map_mul]

/-! ## The main reduction -/

theorem homologicallyCoherent_of_fg {k : Type u} [CommRing k] (hiso : ∀ {G H : Type 0} [Group G] [Group H], G ≃* H → Work.ORDunwoody.HomologicallyCoherent k G → Work.ORDunwoody.HomologicallyCoherent k H) (h : ∀ (n : ℕ) (r : FreeGroup (Fin n)), Work.ORDunwoody.HomologicallyCoherent k (PresentedGroup ({r} : Set (FreeGroup (Fin n))))) : ∀ (G : Type 0) [Group G], Group.OneRelator G → Work.ORDunwoody.HomologicallyCoherent k G := by
  intro G instG hG H hHFG
  classical
  -- `H` is generated by a finite set `S`
  obtain ⟨S, hS⟩ := Subgroup.isMulFG_iff.mp hHFG
  -- reduce to a finitely generated one-relator group together with an embedding `H ↪ H'`
  obtain ⟨n, r, H', hSH', ⟨e⟩⟩ := oneRelator_fg_reduction G hG S
  have hle : H ≤ H' := by
    rw [← hS]
    exact (Subgroup.closure_le H').mpr hSH'
  -- `H'` is isomorphic to the finitely generated one-relator group `⟨Fin n | r⟩`
  have hcoh : Work.ORDunwoody.HomologicallyCoherent k H' := hiso e (h n r)
  -- hence the finitely generated subgroup `H` is of type `FP₂`
  have hKfg : (H.subgroupOf H').FG := subgroupOf_fg (Subgroup.isMulFG_iff.mpr ⟨S, hS⟩) hle
  exact isFP2_of_mulEquiv_fg (Subgroup.subgroupOfEquivOfLe hle) (hcoh (H.subgroupOf H') hKfg)

end Work.ORAssembly.FP2
