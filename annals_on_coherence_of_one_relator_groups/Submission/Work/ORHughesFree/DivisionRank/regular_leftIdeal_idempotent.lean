import Mathlib
import Submission.Work.ORHughesFree.StarRegular

namespace Work.ORHughesFree.DivisionRank

variable {U : Type*}

section RingOnly

variable [Ring U]

/-- For an idempotent `e`, the principal left ideal `U ∙ e` is exactly the set of elements
fixed by right multiplication by `e`. -/
lemma mem_span_singleton_idem (e x : U) (he : e * e = e) :
    x ∈ Submodule.span U ({e} : Set U) ↔ x * e = x := by
  rw [Submodule.mem_span_singleton]
  constructor
  · rintro ⟨a, rfl⟩
    rw [smul_eq_mul, mul_assoc, he]
  · intro hx
    exact ⟨x, by rw [smul_eq_mul, hx]⟩

end RingOnly

section Regular

variable [Ring U] [VonNeumannRegularRing U]

/-- Every principal left ideal of a von Neumann regular ring is generated by an
idempotent. -/
lemma exists_idem_span_singleton (a : U) :
    ∃ e : U, e * e = e ∧
      Submodule.span U ({a} : Set U) = Submodule.span U ({e} : Set U) := by
  obtain ⟨y, hy⟩ := (inferInstance : VonNeumannRegularRing U).exists_mul_inverse a
  refine ⟨y * a, ?_, ?_⟩
  · calc (y * a) * (y * a) = y * (a * y * a) := by noncomm_ring
      _ = y * a := by rw [hy]
  · apply le_antisymm
    · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
      exact ⟨a, by rw [smul_eq_mul, ← mul_assoc, hy]⟩
    · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
      exact ⟨y, by rw [smul_eq_mul]⟩

/-- The left ideal generated by an idempotent `e` and an arbitrary element `f` is generated
by an idempotent.  The proof splits off the component of `f` orthogonal to `e` and
symmetrizes the resulting generator. -/
lemma exists_idem_sup (e f : U) (he : e * e = e) :
    ∃ g : U, g * g = g ∧
      Submodule.span U ({e} : Set U) ⊔ Submodule.span U ({f} : Set U)
        = Submodule.span U ({g} : Set U) := by
  have h1e : (1 - e) * (1 - e) = 1 - e := by
    rw [sub_mul, one_mul, mul_sub, mul_one, he, sub_self, sub_zero]
  have he1e : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he, sub_self]
  set h : U := f * (1 - e) with hh
  have hh1e : h * (1 - e) = h := by rw [hh, mul_assoc, h1e]
  have he_h : h * e = 0 := by
    rw [hh, mul_assoc, sub_mul, one_mul, he, sub_self, mul_zero]
  obtain ⟨y, hy⟩ := (inferInstance : VonNeumannRegularRing U).exists_mul_inverse h
  set k : U := y * h with hk
  have hk_idem : k * k = k := by
    rw [hk]
    calc (y * h) * (y * h) = y * (h * y * h) := by noncomm_ring
      _ = y * h := by rw [hy]
  have hke : k * e = 0 := by rw [hk, mul_assoc, he_h, mul_zero]
  have hk1e : k * (1 - e) = k := by rw [mul_sub, mul_one, hke, sub_zero]
  set k' : U := (1 - e) * k with hk'
  have hk'_idem : k' * k' = k' := by
    rw [hk']
    calc ((1 - e) * k) * ((1 - e) * k) = (1 - e) * ((k * (1 - e)) * k) := by
          noncomm_ring
      _ = (1 - e) * (k * k) := by rw [hk1e]
      _ = (1 - e) * k := by rw [hk_idem]
  have hek' : e * k' = 0 := by rw [hk', ← mul_assoc, he1e, zero_mul]
  have hk'e : k' * e = 0 := by rw [hk', mul_assoc, hke, mul_zero]
  have hspan_hk' : Submodule.span U ({h} : Set U) = Submodule.span U ({k'} : Set U) := by
    apply le_antisymm
    · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
      refine ⟨h, ?_⟩
      rw [smul_eq_mul, hk']
      calc h * ((1 - e) * k) = (h * (1 - e)) * k := by noncomm_ring
        _ = h * k := by rw [hh1e]
        _ = h := by rw [hk, ← mul_assoc, hy]
    · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
      refine ⟨(1 - e) * y, ?_⟩
      rw [smul_eq_mul, hk', hk]
      noncomm_ring
  have hsum : Submodule.span U ({e} : Set U) ⊔ Submodule.span U ({f} : Set U)
      = Submodule.span U ({e} : Set U) ⊔ Submodule.span U ({h} : Set U) := by
    apply le_antisymm
    · have hf : f ∈ (Submodule.span U ({e} : Set U)) ⊔ (Submodule.span U ({h} : Set U)) := by
        rw [Submodule.mem_sup]
        refine ⟨f * e, ?_, ?_⟩
        · rw [Submodule.mem_span_singleton]
          exact ⟨f, by rw [smul_eq_mul]⟩
        · refine ⟨h, Submodule.mem_span_singleton_self h, ?_⟩
          rw [hh]
          noncomm_ring
      rw [sup_le_iff]
      refine ⟨le_sup_left, ?_⟩
      rw [Submodule.span_singleton_le_iff_mem]
      exact hf
    · have hh_mem : h ∈ (Submodule.span U ({e} : Set U)) ⊔ (Submodule.span U ({f} : Set U)) := by
        rw [Submodule.mem_sup]
        refine ⟨-(f * e), ?_, ?_⟩
        · rw [Submodule.mem_span_singleton]
          exact ⟨-f, by rw [smul_eq_mul, neg_mul]⟩
        · refine ⟨f, Submodule.mem_span_singleton_self f, ?_⟩
          rw [hh]
          noncomm_ring
      rw [sup_le_iff]
      refine ⟨le_sup_left, ?_⟩
      rw [Submodule.span_singleton_le_iff_mem]
      exact hh_mem
  have hsup : Submodule.span U ({e} : Set U) ⊔ Submodule.span U ({k'} : Set U)
      = Submodule.span U ({e + k'} : Set U) := by
    apply le_antisymm
    · apply sup_le
      · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
        refine ⟨e, ?_⟩
        rw [smul_eq_mul, mul_add, he, hek', add_zero]
      · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
        refine ⟨k', ?_⟩
        rw [smul_eq_mul, mul_add, hk'e, hk'_idem, zero_add]
    · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_sup]
      refine ⟨e, Submodule.mem_span_singleton_self e, ?_⟩
      exact ⟨k', Submodule.mem_span_singleton_self k', rfl⟩
  refine ⟨e + k', ?_, ?_⟩
  · rw [add_mul, mul_add, mul_add, he, hk'_idem, hek', hk'e, add_zero, zero_add]
  · rw [← hsup, ← hspan_hk', ← hsum]

/-- Every left ideal generated by a finite set of elements of a von Neumann regular ring
is generated by a single idempotent. -/
lemma exists_idem_span_finset (s : Finset U) :
    ∃ e : U, e * e = e ∧
      Submodule.span U (↑s : Set U) = Submodule.span U ({e} : Set U) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨0, by rw [mul_zero], ?_⟩
    rw [Finset.coe_empty, Submodule.span_empty, Submodule.span_zero_singleton]
  | insert a t _hat ih =>
    obtain ⟨et, _het, hspant⟩ := ih
    obtain ⟨ea, hea, hspana⟩ := exists_idem_span_singleton a
    obtain ⟨g, hg, hsup⟩ := exists_idem_sup ea et hea
    refine ⟨g, hg, ?_⟩
    rw [Finset.coe_insert, Submodule.span_insert, hspana, hspant, hsup]

end Regular

theorem regular_leftIdeal_idempotent {U : Type*} [Ring U] [VonNeumannRegularRing U]
    (s : Finset U) :
    ∃ e : U, e * e = e ∧ ∀ x : U, x ∈ Submodule.span U (↑s : Set U) ↔ x * e = x := by
  obtain ⟨e, he, hspan⟩ := exists_idem_span_finset s
  refine ⟨e, he, fun x => ?_⟩
  rw [hspan]
  exact mem_span_singleton_idem e x he

end Work.ORHughesFree.DivisionRank
