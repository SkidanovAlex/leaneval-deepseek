namespace Work.ORHughesFree.NaturalExtension

open Work.ORHughesFree

/-- Relative inverses computed in the ambient ring and in a `∗`-subring agree: if `a` and `y` lie
in a `∗`-subring `A` and `y` is a relative inverse of `a` in the ambient ring, then `y` is a
relative inverse of `a` in `A`. -/
private theorem isRelativeInverse_coe {U : Type*} [Ring U] [StarRing U] {A : StarSubring U}
    {a y : U} (ha : a ∈ (A : Set U)) (hy : y ∈ (A : Set U)) (h : IsRelativeInverse a y) :
    IsRelativeInverse (⟨a, ha⟩ : ↥A) (⟨y, hy⟩ : ↥A) :=
  ⟨Subtype.ext h.left, Subtype.ext h.right, Subtype.ext h.star_left, Subtype.ext h.star_right⟩

/-- **Comparison of the approximating chains.**  Let `A` be a `∗`-regular `∗`-subring of `U`, let
`R` be a `∗`-subring of `U` contained in `A`, and let `R'` be a `∗`-subring of `A` whose image in
`U` contains `R`.  Then the `n`-th stage of the chain of `R` (computed in `U`) lies in the image of
the `n`-th stage of the chain of `R'` (computed in `A`).

The induction is the point of the proof: passing from `n` to `n+1` adjoins the relative inverses
of the `n`-th stage, and since `A` is `∗`-regular the relative inverse in `U` of an element of `A`
lies in `A` and is the relative inverse computed in `A`.  Hence the two constructions run in
parallel. -/
theorem starRegularChain_subset_image {U : Type*} [Ring U] [StarRing U] (A : StarSubring U)
    [IsStarRegular ↥A] (R : StarSubring U) (hRA : (R : Set U) ⊆ (A : Set U))
    (R' : StarSubring ↥A) (h0 : (R : Set U) ⊆ Subtype.val '' (R' : Set ↥A)) :
    ∀ n, (starRegularChain R n : Set U) ⊆ Subtype.val '' (starRegularChain R' n : Set ↥A) := by
  -- every stage of the chain of `R` lies in `A`
  have hAc : ∀ n, (starRegularChain R n : Set U) ⊆ (A : Set U) := by
    intro n
    induction n with
    | zero => exact hRA
    | succ n ih =>
      refine starSubringClosure_le ?_
      refine Set.union_subset ih ?_
      exact (Work.ORHughesFree.StarRegular.relativeInverses_mono ih).trans
        (Work.StarRegular.relativeInverses_starSubring A)
  intro n
  induction n with
  | zero => exact h0
  | succ n ih =>
    -- the image of the `(n+1)`-st stage of the chain of `R'` inside `U`
    set M : Subring U := (starRegularChain R' (n + 1)).toSubring.map A.toSubring.subtype with hM
    -- the `n`-th stage of the chain of `R` lies in `M`
    have h1 : (starRegularChain R n : Set U) ⊆ (M : Set U) := by
      intro y hy
      obtain ⟨z, hz, hzval⟩ := ih hy
      exact Subring.mem_map.mpr
        ⟨z, Work.ORHughesFree.StarRegular.starRegularChain_succ R' n hz, hzval⟩
    -- the relative inverses of the `n`-th stage of the chain of `R` lie in `M`
    have h2 : relativeInverses (starRegularChain R n : Set U) ⊆ (M : Set U) := by
      rintro y ⟨a, ha, hay⟩
      obtain ⟨z, hz, hzval⟩ := ih ha
      have haA : a ∈ (A : Set U) := hAc n ha
      have hzA : (⟨a, haA⟩ : ↥A) ∈ (starRegularChain R' n : Set ↥A) := by
        rw [show (⟨a, haA⟩ : ↥A) = z from Subtype.ext hzval.symm]
        exact hz
      have hyA : y ∈ (A : Set U) :=
        Work.StarRegular.relativeInverses_starSubring A ⟨a, haA, hay⟩
      have hrel : IsRelativeInverse (⟨a, haA⟩ : ↥A) (⟨y, hyA⟩ : ↥A) :=
        isRelativeInverse_coe haA hyA hay
      exact Subring.mem_map.mpr
        ⟨⟨y, hyA⟩, subset_starSubringClosure _ (Or.inr ⟨⟨a, haA⟩, hzA, hrel⟩), rfl⟩
    have hstage : (starRegularChain R (n + 1) : Set U) ⊆ (M : Set U) := by
      show (Subring.closure (((starRegularChain R n : Set U) ∪
          relativeInverses (starRegularChain R n : Set U)) ∪
          star '' ((starRegularChain R n : Set U) ∪
            relativeInverses (starRegularChain R n : Set U))) : Set U) ⊆ (M : Set U)
      refine Subring.closure_le.mpr ?_
      rintro y (hy | hy)
      · rcases hy with hy | hy
        · exact h1 hy
        · exact h2 hy
      · obtain ⟨a, ha, rfl⟩ := hy
        rcases ha with ha | ha
        · exact h1 ((starRegularChain R n).star_mem' ha)
        · obtain ⟨b, hb, hba⟩ := ha
          exact h2 ⟨star b, (starRegularChain R n).star_mem' hb,
            isRelativeInverse_star_of hba⟩
    intro y hy
    obtain ⟨z, hz, hzval⟩ := Subring.mem_map.mp (hstage hy)
    exact ⟨z, hz, hzval⟩

theorem starRegularClosure_codRestrict_top {S P : Type} [Ring S] [StarRing S] [Ring P] [StarRing P]
    [IsStarRegular P] (φ : S →+* P) (hφ : ∀ s : S, φ (star s) = star (φ s)) :
    (starRegularClosure (starSubringClosure (Set.range (closureCorestrict φ)))).toSubring = ⊤ := by
  -- `A` is the `∗`-regular closure of the image of `φ`, and it is `∗`-regular
  letI : IsStarRegular ↥(starRegularClosure (starSubringClosure (Set.range φ))) :=
    Work.ORHughesFree.StarRegular.starRegularClosure_isStarRegular
      (starSubringClosure (Set.range φ))
  -- the image of `φ` lies in the image of the co-restricted map
  have h0 : ((starSubringClosure (Set.range φ) : StarSubring P) : Set P) ⊆
      Subtype.val '' ((starSubringClosure (Set.range (closureCorestrict φ)) :
        StarSubring ↥(starRegularClosure (starSubringClosure (Set.range φ)))) :
        Set ↥(starRegularClosure (starSubringClosure (Set.range φ)))) :=
    Work.NaturalExtension.starSubringClosure_range_subset φ hφ (closureCorestrict φ)
      (fun _ => rfl)
  -- the two approximating chains match stage by stage
  have hchain := starRegularChain_subset_image
    (A := starRegularClosure (starSubringClosure (Set.range φ)))
    (starSubringClosure (Set.range φ)) (subset_starRegularClosure _)
    (starSubringClosure (Set.range (closureCorestrict φ))) h0
  -- hence the closure of `R` is already obtained inside `A`
  have hcl := Work.StarRegular.starRegularClosure_subset_image
    (A := starRegularClosure (starSubringClosure (Set.range φ)))
    (R := starSubringClosure (Set.range φ))
    (R' := starSubringClosure (Set.range (closureCorestrict φ))) hchain
  refine le_antisymm le_top ?_
  intro x _
  obtain ⟨z, hz, hzval⟩ := hcl x.2
  have hzx : z = x := Subtype.ext hzval
  rw [hzx] at hz
  exact hz

end Work.ORHughesFree.NaturalExtension
