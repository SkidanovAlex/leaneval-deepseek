import Mathlib
import Submission.Work.ORHughesFree.NaturalExtension.ModuleDim

/-!
# `dimOf` of the rows of a matrix equals its Sylvester rank

For a von Neumann regular ring `R` with a Sylvester matrix rank function `rk`, and a matrix
`A : Matrix (Fin n) (Fin m) R`, the family of its rows `fun i => fun j => A i j` spans the left
`R`-submodule of `R^m` generated by the rows of `A`.  This file proves that the dimension of that
submodule (in the sense of `dimOf`, i.e. the rank of an idempotent endomorphism onto it) equals
`rk A`.

The proof: let `p = Matrix.toLinearMapRight' A : R^n → R^m`, whose range is the row span of `A`,
and let `e` be an idempotent endomorphism of `R^m` with that range, with matrix `M`
(`e = Matrix.toLinearMapRight' M`).

* `e` fixes its range, so `e ∘ p = p`; in matrices `A * M = A`, whence
  `rk A = rk (A * M) ≤ rk M` by `(SMat2)`.
* since `range p` is a direct summand of `R^m` it is projective, so the surjection
  `p : R^n → range p` splits; a splitting `q` together with the projection `e` gives a
  matrix `C` with `C * A = M`, whence `rk M = rk (C * A) ≤ rk A` by `(SMat2)`.
-/

set_option autoImplicit false

universe u

namespace Work.ORHughesFree.NaturalExtension

open Matrix Work.ORHughesFree

theorem dimOf_rows_eq_rk {R : Type u} [Ring R] [VonNeumannRegularRing R] (rk : SylvesterRank R)
    {n m : ℕ} (A : Matrix (Fin n) (Fin m) R) :
    dimOf rk (fun i : Fin n => fun j : Fin m => A i j) = rk.rk n m A := by
  classical
  obtain ⟨e, he, hrange⟩ :=
    Work.ORHughesFree.StarRegular.exists_idempotent_range_span_aux
      (fun i : Fin n => fun j : Fin m => A i j)
  rw [← dimOf_eq rk (fun i : Fin n => fun j : Fin m => A i j) e he hrange]
  rw [dimOfEnd]
  set M : Matrix (Fin m) (Fin m) R := Matrix.toLinearMapRight'.symm e with hM
  set p : (Fin n → R) →ₗ[R] (Fin m → R) := Matrix.toLinearMapRight' A with hp
  -- The rows of `A` are the images under `p` of the standard basis of `R^n`.
  have hrows : ∀ i : Fin n, p (Pi.single i (1 : R)) = (fun j : Fin m => A i j) := by
    intro i
    rw [hp, Matrix.toLinearMapRight'_apply, Matrix.single_vecMul]
    simp only [one_smul]
    rfl
  -- The range of `p` is the span of the rows of `A`.
  have hrange_p : LinearMap.range p =
      Submodule.span R (Set.range (fun i : Fin n => fun j : Fin m => A i j)) := by
    have hspan : Submodule.span R (Set.range (Pi.basisFun R (Fin n))) = ⊤ :=
      (Pi.basisFun R (Fin n)).span_eq
    have hbasis : Set.range (Pi.basisFun R (Fin n)) =
        Set.range (fun i : Fin n => (Pi.single i (1 : R) : Fin n → R)) := by
      congr 1 with i; rw [Pi.basisFun_apply]
    calc LinearMap.range p = Submodule.map p ⊤ := (Submodule.map_top p).symm
      _ = Submodule.map p (Submodule.span R (Set.range (Pi.basisFun R (Fin n)))) := by
            rw [hspan]
      _ = Submodule.span R (p '' Set.range (Pi.basisFun R (Fin n))) :=
            Submodule.map_span p (Set.range (Pi.basisFun R (Fin n)))
      _ = Submodule.span R (p '' Set.range (fun i : Fin n => (Pi.single i (1 : R) : Fin n → R))) :=
            by rw [hbasis]
      _ = Submodule.span R (Set.range (fun i : Fin n => p (Pi.single i (1 : R)))) := by
            rw [← Set.range_comp]
            rfl
      _ = Submodule.span R (Set.range (fun i : Fin n => fun j : Fin m => A i j)) := by
            rw [show (fun i : Fin n => p (Pi.single i (1 : R)))
                  = (fun i : Fin n => fun j : Fin m => A i j) from funext hrows]
  -- `range e` and `range p` are the same submodule.
  have hmeq : LinearMap.range e = LinearMap.range p := by rw [hrange, hrange_p]
  -- An idempotent endomorphism fixes its range.
  have hefix : ∀ y : Fin m → R, y ∈ LinearMap.range e → e y = y := by
    intro y hy
    obtain ⟨z, hz⟩ := hy
    rw [← hz]
    change (e ∘ₗ e) z = e z
    rw [← Module.End.mul_eq_comp, he]
  -- `e` fixes the range of `p`, hence `e ∘ p = p`.
  have hep : e ∘ₗ p = p := by
    apply LinearMap.ext
    intro x
    rw [LinearMap.comp_apply]
    exact hefix (p x) (by rw [hmeq]; exact LinearMap.mem_range_self p x)
  -- In matrix terms, `A * M = A`.
  have hAM : A * M = A := by
    apply Matrix.toLinearMapRight'.injective
    rw [Matrix.toLinearMapRight'_mul]
    rw [show Matrix.toLinearMapRight' M = e from LinearEquiv.apply_symm_apply _ _,
      show Matrix.toLinearMapRight' A = p from hp.symm]
    exact hep
  have h1 : rk.rk n m A ≤ rk.rk m m M := by
    rw [← hAM]
    exact rk.rk_mul_le_right A M
  -- Conversely, `range e` is a direct summand of `R^m`, hence projective; so the surjection
  -- `p : R^n → range e` splits.
  have hmem : ∀ x : Fin m → R, e x ∈ LinearMap.range e := fun x => LinearMap.mem_range_self e x
  let s : (Fin m → R) →ₗ[R] LinearMap.range e := e.codRestrict _ hmem
  have s_coe : ∀ x : Fin m → R, (s x : Fin m → R) = e x := fun _ => rfl
  have hscomp : s.comp (Submodule.subtype (LinearMap.range e)) = LinearMap.id := by
    apply LinearMap.ext
    intro z
    apply Subtype.ext
    change e (z : Fin m → R) = (z : Fin m → R)
    exact hefix _ z.2
  have hproj : Module.Projective R (LinearMap.range e) :=
    Module.Projective.of_split (Submodule.subtype _) s hscomp
  have hcod : ∀ x : Fin n → R, p x ∈ LinearMap.range e := fun x => by
    rw [hmeq]; exact LinearMap.mem_range_self p x
  have hsurj : (p.codRestrict (LinearMap.range e) hcod).range = ⊤ := by
    rw [LinearMap.range_eq_top]
    intro y
    have hy : (y : Fin m → R) ∈ LinearMap.range p := hmeq ▸ y.2
    obtain ⟨x, hx⟩ := hy
    exact ⟨x, Subtype.ext hx⟩
  obtain ⟨q, hq⟩ :=
    (p.codRestrict (LinearMap.range e) hcod).exists_rightInverse_of_surjective hsurj
  -- The composite `q ∘ s : R^m → R^n` is a right inverse of `p` onto `e`.
  have hpr : p ∘ₗ (q.comp s) = e := by
    apply LinearMap.ext
    intro x
    rw [LinearMap.comp_apply, LinearMap.comp_apply]
    have h := LinearMap.congr_fun hq (s x)
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at h
    have h2 : p (q (s x)) = (s x : Fin m → R) := congrArg Subtype.val h
    rw [h2, s_coe]
  let C : Matrix (Fin m) (Fin n) R := Matrix.toLinearMapRight'.symm (q.comp s)
  have hCA : C * A = M := by
    apply Matrix.toLinearMapRight'.injective
    rw [Matrix.toLinearMapRight'_mul]
    rw [show Matrix.toLinearMapRight' C = q.comp s from LinearEquiv.apply_symm_apply _ _,
      show Matrix.toLinearMapRight' A = p from hp.symm,
      show Matrix.toLinearMapRight' M = e from LinearEquiv.apply_symm_apply _ _]
    exact hpr
  have h2 : rk.rk m m M ≤ rk.rk n m A := by
    rw [← hCA]
    exact rk.rk_mul_le_right C A
  exact le_antisymm h2 h1

end Work.ORHughesFree.NaturalExtension
