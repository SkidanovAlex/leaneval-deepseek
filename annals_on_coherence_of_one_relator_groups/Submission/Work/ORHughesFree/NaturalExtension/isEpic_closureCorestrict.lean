import Mathlib
import Submission.Work.ORHughesFree.NaturalExtension.envelopeDefs
import Submission.Work.ORHughesFree.NaturalExtension.starRegularClosure_codRestrict_top
import Submission.Work.ORHughesFree.NaturalExtension.isEpic_of_starRegularClosure
import Submission.Work.ORHughesFree.Epic
import Submission.Work.ORHughesFree.StarRegular

namespace Work.ORHughesFree.NaturalExtension

theorem isEpic_closureCorestrict {S P : Type} [Ring S] [StarRing S] [Ring P] [StarRing P]
    [Work.ORHughesFree.IsStarRegular P] (φ : S →+* P)
    (hφ : ∀ s : S, φ (star s) = star (φ s)) :
    Work.ORHughesFree.IsEpic (Work.ORHughesFree.NaturalExtension.closureCorestrict φ) := by
  -- `A = starRegularClosure (starSubringClosure (Set.range φ))` is `∗`-regular
  have : Work.ORHughesFree.IsStarRegular
      ↥(starRegularClosure (starSubringClosure (Set.range φ))) :=
    Work.ORHughesFree.StarRegular.starRegularClosure_isStarRegular _
  -- it suffices to know that `A` is generated by the image of `closureCorestrict φ`
  refine isEpic_of_starRegularClosure (closureCorestrict φ) ?_ ?_
  · -- `closureCorestrict φ` is a `∗`-homomorphism
    intro s
    apply Subtype.ext
    simp only [closureCorestrict, RingHom.codRestrict_apply]
    exact hφ s
  · -- the image generates `A`: this is `starRegularClosure_codRestrict_top`
    intro v
    change v ∈ ((starRegularClosure
      (starSubringClosure (Set.range (closureCorestrict φ)))).toSubring)
    rw [starRegularClosure_codRestrict_top φ hφ]
    exact Subring.mem_top v

end Work.ORHughesFree.NaturalExtension
