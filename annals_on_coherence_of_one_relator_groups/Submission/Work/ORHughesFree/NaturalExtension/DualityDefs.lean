/-
# Definitions for the duality `σ + τ ≥ 1` (`supConstMain`)

This file sets up the vocabulary for the proof of `supConstMain`.  Throughout, `R` is a ring
with a `MulSemiringAction (Multiplicative ℤ) R` (the twist `τ`), `S = SkewL R = R[t^{±1};τ]`,
`rk` is a Sylvester rank function on `R`, and `p ∈ S`.

The central new notion is

* `rdim rk K` : the dimension of a left `R`-submodule `K ≤ R^n`, defined as the supremum of
  `rk A` over the matrices `A` whose **rows** all lie in `K`.  This is the row-convention
  analogue of `subDim` from `subDimDefs.lean` (which uses columns) and agrees with
  `dimOf rk v` whenever `v` is a finite family spanning `K`.

Together with the degree filtration of a left ideal `I ≤ S` (`degPart R I k` from
`degFiltDefs.lean`), we define

* `constIdeal I k` : the left ideal of `R` of constant terms of the polynomial elements of `I`
  of degree `≤ k` (as a submodule of `R^1`, via the projection `evZero k`);
* `C0sub p` and `C1sub p` : the sets `C0set R p` and `C1set R p` viewed as left ideals of `R`
  (see `supConstDefs.lean` for their definitions).

For the rank-nullity step we also fix the matrix `Bmat p k` (of size `(k+1) × (k+1+upDeg p)`)
whose `i`-th row is the coefficient vector of `t^i * p` in degrees `0,…,k+upDeg p`, its row span
`rowSpanBmat p k` and its row kernel `kerBmat p k`, together with `toPoly k x = ∑_i x_i t^i`.
-/
import Mathlib
import Submission.Work.ORHughesFree.NaturalExtension.degFiltDefs
import Submission.Work.ORHughesFree.NaturalExtension.supConstDefs
import Submission.Work.ORHughesFree.NaturalExtension.Defs
import Submission.Work.ORHughesFree.NaturalExtension.EltDeg
import Submission.Work.ORHughesFree.NaturalExtension.rank_ge_const_coeff
import Submission.Work.ORHughesFree.SylvesterRank
import Submission.Work.ORHughesFree.StarRegular

set_option autoImplicit false

universe u

namespace Work.ORHughesFree.NaturalExtension

open Matrix Work.ORHughesFree

/-- **Row-wise dimension of a submodule.**  For a left `R`-submodule `K ≤ R^n`,
`rdim rk K` is the supremum of `rk A` over the matrices `A` whose rows all lie in `K`. -/
noncomputable def rdim {R : Type u} [Ring R] (rk : SylvesterRank R) {n : ℕ}
    (K : Submodule R (Fin n → R)) : ℝ :=
  sSup {x : ℝ | ∃ (m : ℕ) (A : Matrix (Fin m) (Fin n) R),
    (∀ i, (fun j => A i j) ∈ K) ∧ x = rk.rk m n A}

section Defs

variable {R : Type u} [Ring R] [MulSemiringAction (Multiplicative ℤ) R]

/-- The projection onto the `0`-th (constant) coefficient: `R^{k+1} → R^1`. -/
def evZero (k : ℕ) : (Fin (k + 1) → R) →ₗ[R] (Fin 1 → R) where
  toFun x := fun _ => x 0
  map_add' x y := by funext i; fin_cases i; simp
  map_smul' c x := by funext i; fin_cases i; simp

/-- The left ideal of constant terms of the polynomial elements of degree `≤ k` of `I`,
as a submodule of `R^1`. -/
noncomputable def constIdeal (I : Set (SkewL R)) (k : ℕ) : Submodule R (Fin 1 → R) :=
  (degPart R I k).map (evZero k)

/-- The left ideal generated by `p` in `S = SkewL R`, as a set of elements of `S`. -/
def genIdeal (p : SkewL R) : Set (SkewL R) := {f : SkewL R | ∃ q : SkewL R, q * p = f}

/-- The left annihilator of `p` in `S`, as a set of elements of `S`. -/
def annSet (p : SkewL R) : Set (SkewL R) := {f : SkewL R | f * p = 0}

/-- `I` is a left ideal of `S = SkewL R` (closed under addition and left multiplication by
elements of `S`). -/
def IsLeftIdeal (I : Set (SkewL R)) : Prop :=
  (∀ a ∈ I, ∀ b ∈ I, a + b ∈ I) ∧ (∀ a ∈ I, ∀ s : SkewL R, s * a ∈ I)

theorem isLeftIdeal_genIdeal (p : SkewL R) : IsLeftIdeal (genIdeal p) := by
  constructor
  · rintro a ⟨q₁, rfl⟩ b ⟨q₂, rfl⟩
    exact ⟨q₁ + q₂, by rw [add_mul]⟩
  · rintro a ⟨q, rfl⟩ s
    exact ⟨s * q, by rw [mul_assoc]⟩

theorem isLeftIdeal_annSet (p : SkewL R) : IsLeftIdeal (annSet p) := by
  constructor
  · rintro a ha b hb
    change (a + b) * p = 0
    rw [add_mul, ha, hb, add_zero]
  · rintro a ha s
    change (s * a) * p = 0
    rw [mul_assoc, ha, mul_zero]

/-- The `(k+1) × (k+upDeg p+1)` matrix whose `i`-th row is the coefficient vector, in degrees
`0,…,k+upDeg p`, of `t^i * p`. -/
noncomputable def Bmat (p : SkewL R) (k : ℕ) :
    Matrix (Fin (k + 1)) (Fin (k + upDeg p + 1)) R :=
  fun i j => (Multiplicative.ofAdd (((i : ℕ) : ℤ))) • coeffElt p (((j : ℕ) : ℤ) - ((i : ℕ) : ℤ))

/-- The row span of `Bmat p k` inside `R^(k+upDeg p+1)`. -/
noncomputable def rowSpanBmat (p : SkewL R) (k : ℕ) :
    Submodule R (Fin (k + upDeg p + 1) → R) :=
  Submodule.span R (Set.range (fun i : Fin (k + 1) =>
    (fun j : Fin (k + upDeg p + 1) => Bmat p k i j)))

/-- The `(n+1) × (n+1)` matrix whose `r`-th row is the coefficient vector, in degrees `0,…,n`,
of `t^r * p`.  For every `n ≥ 1` it is the reindexing of `trunc n (oneByOne p)`. -/
noncomputable def Cmat (p : SkewL R) (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  fun r s => (Multiplicative.ofAdd (((r : ℕ) : ℤ))) • coeffElt p (((s : ℕ) : ℤ) - ((r : ℕ) : ℤ))

/-- The row kernel of `Bmat p k` inside `R^(k+1)`. -/
noncomputable def kerBmat (p : SkewL R) (k : ℕ) : Submodule R (Fin (k + 1) → R) :=
  LinearMap.ker (Bmat p k).vecMulLinear

/-- The polynomial `∑_{i ≤ k} x_i t^i` attached to a coefficient vector `x : Fin (k+1) → R`. -/
noncomputable def toPoly (k : ℕ) (x : Fin (k + 1) → R) : SkewL R :=
  ∑ i : Fin (k + 1), SkewMonoidAlgebra.single (Multiplicative.ofAdd ((i : ℕ) : ℤ)) (x i)

/-- `C0set R p` (the constant terms of the polynomial left multiples of `p`) as a left ideal
of `R`, i.e. as a submodule of `R^1`. -/
noncomputable def C0sub (p : SkewL R) : Submodule R (Fin 1 → R) where
  carrier := {v : Fin 1 → R | v 0 ∈ C0set R p}
  zero_mem' := by
    change (0 : R) ∈ C0set R p
    exact ⟨0, 0, by rw [zero_mul], fun k _ => by simp [coeffElt], by simp [coeffElt]⟩
  add_mem' := by
    intro v w hv hw
    change v 0 + w 0 ∈ C0set R p
    obtain ⟨q₁, q₁', hq₁, hp₁, h₁⟩ := hv
    obtain ⟨q₂, q₂', hq₂, hp₂, h₂⟩ := hw
    refine ⟨q₁ + q₂, q₁' + q₂', ?_, ?_, ?_⟩
    · rw [hq₁, hq₂, add_mul]
    · intro k hk
      rw [show coeffElt (q₁ + q₂) k = coeffElt q₁ k + coeffElt q₂ k by simp [coeffElt],
        hp₁ k hk, hp₂ k hk, add_zero]
    · rw [show coeffElt (q₁ + q₂) 0 = coeffElt q₁ 0 + coeffElt q₂ 0 by simp [coeffElt],
        h₁, h₂]
  smul_mem' := by
    intro c v hv
    change c * (v 0) ∈ C0set R p
    obtain ⟨q, q', hq, hp, h⟩ := hv
    refine ⟨SkewMonoidAlgebra.single (1 : Multiplicative ℤ) c * q,
      SkewMonoidAlgebra.single (1 : Multiplicative ℤ) c * q', ?_, ?_, ?_⟩
    · rw [hq, mul_assoc]
    · intro k hk
      rw [coeffElt_const_mul, hp k hk, mul_zero]
    · rw [coeffElt_const_mul, h]

/-- `C1set R p` (the constant terms of the polynomial left annihilators of `p`) as a left ideal
of `R`, i.e. as a submodule of `R^1`. -/
noncomputable def C1sub (p : SkewL R) : Submodule R (Fin 1 → R) where
  carrier := {v : Fin 1 → R | v 0 ∈ C1set R p}
  zero_mem' := by
    change (0 : R) ∈ C1set R p
    exact ⟨0, by rw [zero_mul], fun k _ => by simp [coeffElt], by simp [coeffElt]⟩
  add_mem' := by
    intro v w hv hw
    change v 0 + w 0 ∈ C1set R p
    obtain ⟨q₁, hq₁, hp₁, h₁⟩ := hv
    obtain ⟨q₂, hq₂, hp₂, h₂⟩ := hw
    refine ⟨q₁ + q₂, ?_, ?_, ?_⟩
    · rw [add_mul, hq₁, hq₂, add_zero]
    · intro k hk
      rw [show coeffElt (q₁ + q₂) k = coeffElt q₁ k + coeffElt q₂ k by simp [coeffElt],
        hp₁ k hk, hp₂ k hk, add_zero]
    · rw [show coeffElt (q₁ + q₂) 0 = coeffElt q₁ 0 + coeffElt q₂ 0 by simp [coeffElt],
        h₁, h₂]
  smul_mem' := by
    intro c v hv
    change c * (v 0) ∈ C1set R p
    obtain ⟨q, hq, hp, h⟩ := hv
    refine ⟨SkewMonoidAlgebra.single (1 : Multiplicative ℤ) c * q, ?_, ?_, ?_⟩
    · rw [mul_assoc, hq, mul_zero]
    · intro k hk
      rw [coeffElt_const_mul, hp k hk, mul_zero]
    · rw [coeffElt_const_mul, h]

end Defs

end Work.ORHughesFree.NaturalExtension
