import Mathlib
import Submission.Work.ORHughesFree.NaturalExtension.ModuleDim

universe u

namespace Work.ORHughesFree.NaturalExtension

open Matrix Work.ORHughesFree

/-- The dimension of the submodule of `R^1` spanned by the single vector with coordinate `a`
equals the Sylvester rank of the `1 × 1` matrix `(a)`.

Choosing an idempotent endomorphism `e` of `R^1` with range `span {v}` (`v` the constant vector
`a`), its matrix `M = toLinearMapRight'.symm e` is a `1 × 1` matrix `oneByOne c` with `c`
idempotent.  The range condition says that the coefficient set of `range e` (namely `R c`, the left
ideal generated by `c`) equals the coefficient set of `span {v}` (namely `R a`).  In particular
`a = a * c` and `c = s * a`, whence `rk (oneByOne a) = rk (oneByOne a * oneByOne c) ≤ rk c` and
`rk c = rk (oneByOne s * oneByOne a) ≤ rk (oneByOne a)` by `(SMat2)`. -/
theorem dimOf_principal {R : Type u} [Ring R] [VonNeumannRegularRing R] (rk : SylvesterRank R)
    (a : R) :
    dimOf rk (fun (_ : Fin 1) => (fun (_ : Fin 1) => a)) = rk.rk 1 1 (oneByOne a) := by
  have hex := Work.ORHughesFree.StarRegular.exists_idempotent_range_span_aux
    (fun (_ : Fin 1) => (fun (_ : Fin 1) => a))
  set e : Module.End R (Fin 1 → R) := Classical.choose hex with hedef
  have he : e * e = e := (Classical.choose_spec hex).1
  have hrange : LinearMap.range e =
      Submodule.span R (Set.range (fun (_ : Fin 1) => (fun (_ : Fin 1) => a))) :=
    (Classical.choose_spec hex).2
  rw [← dimOf_eq rk (fun (_ : Fin 1) => (fun (_ : Fin 1) => a)) e he hrange]
  unfold dimOfEnd
  set M : Matrix (Fin 1) (Fin 1) R := Matrix.toLinearMapRight'.symm e with hM
  set c : R := M 0 0 with hc
  have hMe : e = Matrix.toLinearMapRight' M := by
    rw [hM]; exact (LinearEquiv.apply_symm_apply Matrix.toLinearMapRight' e).symm
  have hMM : M * M = M := by
    rw [hM]
    apply Matrix.toLinearMapRight'.injective
    simp only [Matrix.toLinearMapRight'_mul, LinearEquiv.apply_symm_apply]
    rw [← Module.End.mul_eq_comp]; exact he
  have hM_eq : M = oneByOne c := by
    ext i j; fin_cases i; fin_cases j; exact hc.symm
  have hfix : ∀ y : Fin 1 → R, y ∈ LinearMap.range e → e y = y := by
    intro y hy
    obtain ⟨z, rfl⟩ := hy
    have hec : e ∘ₗ e = e := by rwa [Module.End.mul_eq_comp] at he
    exact congrArg (fun g => g z) hec
  have hva : (fun _ : Fin 1 => a) ∈
      Submodule.span R (Set.range (fun _ : Fin 1 => fun _ : Fin 1 => a)) :=
    Submodule.subset_span (Set.mem_range_self (0 : Fin 1))
  have hea : e (fun _ : Fin 1 => a) = (fun _ : Fin 1 => a) :=
    hfix _ (by rw [hrange]; exact hva)
  have h_ac : a * c = a := by
    have h1 := congrFun hea 0
    rw [hMe, Matrix.toLinearMapRight'_apply] at h1
    simp only [Matrix.vecMul_apply, dotProduct, Matrix.col_apply, Fin.sum_univ_one] at h1
    rw [hc]; exact h1
  have h1vec : (fun _ : Fin 1 => (1 : R)) ᵥ* M = (fun _ => c) := by
    funext j
    rw [Fin.eq_zero j]
    simp only [Matrix.vecMul_apply, dotProduct, Matrix.col_apply, Fin.sum_univ_one, one_mul]
    exact hc.symm
  have hc_mem_range : (fun _ : Fin 1 => c) ∈ LinearMap.range e :=
    ⟨fun _ : Fin 1 => (1 : R), by rw [hMe, Matrix.toLinearMapRight'_apply]; exact h1vec⟩
  have hc_mem : (fun _ : Fin 1 => c) ∈
      Submodule.span R (Set.range (fun _ : Fin 1 => fun _ : Fin 1 => a)) := by
    rw [← hrange]; exact hc_mem_range
  have hrange_single : Set.range (fun _ : Fin 1 => fun _ : Fin 1 => a) =
      {(fun _ : Fin 1 => a)} := by
    rw [Set.eq_singleton_iff_unique_mem]
    refine ⟨Set.mem_range_self 0, ?_⟩
    rintro y ⟨i, rfl⟩
    exact congrArg (fun _ : Fin 1 => fun _ : Fin 1 => a) (Fin.eq_zero i)
  rw [hrange_single, Submodule.mem_span_singleton] at hc_mem
  obtain ⟨s, hs⟩ := hc_mem
  have hc_eq : c = s * a := by
    have h := congrFun hs 0
    simp only [Pi.smul_apply, smul_eq_mul] at h
    exact h.symm
  rw [hM_eq]
  have hmul : ∀ x y : R, oneByOne (x * y) = oneByOne x * oneByOne y := by
    intro x y; ext i j; fin_cases i; fin_cases j
    simp only [oneByOne, Matrix.mul_apply, Fin.sum_univ_one]
  apply le_antisymm
  · calc rk.rk 1 1 (oneByOne c) = rk.rk 1 1 (oneByOne (s * a)) := by rw [hc_eq]
      _ = rk.rk 1 1 (oneByOne s * oneByOne a) := by rw [hmul]
      _ ≤ rk.rk 1 1 (oneByOne a) := rk.rk_mul_le_right _ _
  · calc rk.rk 1 1 (oneByOne a) = rk.rk 1 1 (oneByOne (a * c)) := by rw [h_ac]
      _ = rk.rk 1 1 (oneByOne a * oneByOne c) := by rw [hmul]
      _ ≤ rk.rk 1 1 (oneByOne c) := rk.rk_mul_le_right _ _

end Work.ORHughesFree.NaturalExtension
