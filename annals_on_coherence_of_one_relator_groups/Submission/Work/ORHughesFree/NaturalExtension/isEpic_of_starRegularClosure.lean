/-!
# The `∗`-regular closure generates an epic embedding

This is the "if" direction of [JZLA20, Proposition 2.7], citing [Jaikin, *The base change in the
Atiyah and the Lück approximation conjectures*, GAFA 29 (2019), Proposition 6.1].

Fix `g h : V →+* Q` with `g ∘ φ = h ∘ φ` and let `E = {v | g v = h v} ⊆ V` be their equalizer; `E`
is a subring of `V` containing the image of `φ` (hence its `∗`-subring closure).  By the closure
criterion `starRegularClosure_le_of_isRelativeInverse_selfAdjoint` it suffices to show that `E`
contains the relative inverse of each of its *self-adjoint* elements.  That is the content of
`map_relativeInverse_eq_of_selfAdjoint`, which replaces Jaikin's computation in the tensor product
`V ⊗_R V` by the corresponding computation in `Q`.

The point of restricting to self-adjoint elements is [Jaikin, GAFA 2019, Proposition 3.2(7)]: a
self-adjoint `y` commutes with its relative inverse `w`, so that with `e = y w` one has
`y e = y = e y` and `w e = w = e w`; this is what makes the tensor computation collapse.
-/

/-- **Ring homomorphisms which agree on a self-adjoint element agree on its relative inverse.**

Let `V` be a `∗`-ring (in practice `∗`-regular), `y ∈ V` self-adjoint, `w` a relative
(Moore--Penrose) inverse of `y`, and `g h : V →+* Q` two ring homomorphisms with `g y = h y`.
Then `g w = h w`.

This is the key step of [Jaikin, GAFA 2019, Proposition 6.1]: it is the point where the
self-adjointness of `y` is used, through the fact that `y` commutes with `w`
(`mul_comm_of_isRelativeInverse_selfAdjoint`).  With `e = y w` the computation is

`h e = g y · h w = g e · h e`, `g e · h e = g e`,

hence `h e = g e`, and then `h w = h (e w) = h e · h w = g e · h w = g w · h e = g w · g e = g w`
using `w e = w = e w` and `g e · h w = g w · h e`. -/
theorem map_relativeInverse_eq_of_selfAdjoint {V Q : Type*} [Ring V] [StarRing V] [Ring Q]
    (g h : V →+* Q) {y w : V} (hy : star y = y) (hw : IsRelativeInverse y w) (hyE : g y = h y) :
    g w = h w := by
  have hmul : y * w = w * y := (mul_comm_of_isRelativeInverse_selfAdjoint hy hw).symm
  -- the four products involving the idempotent `e = y * w`
  have hye : (y * w) * y = y := hw.left
  have hye' : y * (y * w) = y := by rw [hmul, ← mul_assoc]; exact hw.left
  have hew : (y * w) * w = w := by rw [hmul]; exact hw.right
  have hwe : w * (y * w) = w := by rw [← mul_assoc]; exact hw.right
  -- images in `Q`
  have hA : h (y * w) = g y * h w := by rw [map_mul, ← hyE]
  have hB : g (y * w) = g w * h y := by rw [hmul, map_mul, hyE]
  have hC : g w * h (y * w) = g (y * w) * h w := by
    calc g w * h (y * w) = g w * (g y * h w) := by rw [hA]
      _ = (g w * g y) * h w := (mul_assoc _ _ _).symm
      _ = g (w * y) * h w := by rw [map_mul]
      _ = g (y * w) * h w := by rw [hmul]
  have hD : h (y * w) = g (y * w) * h (y * w) := by
    calc h (y * w) = g y * h w := hA
      _ = g ((y * w) * y) * h w := by rw [hye]
      _ = (g (y * w) * g y) * h w := by rw [map_mul]
      _ = g (y * w) * (g y * h w) := mul_assoc _ _ _
      _ = g (y * w) * h (y * w) := by rw [hA]
  have hF : g (y * w) * h (y * w) = g (y * w) := by
    calc g (y * w) * h (y * w) = (g w * h y) * h (y * w) := by rw [hB]
      _ = g w * (h y * h (y * w)) := mul_assoc _ _ _
      _ = g w * h (y * (y * w)) := by rw [← map_mul h y (y * w)]
      _ = g w * h y := by rw [hye']
      _ = g (y * w) := hB.symm
  have heq : h (y * w) = g (y * w) := hD.trans hF
  have hG : h w = g (y * w) * h w := by
    calc h w = h ((y * w) * w) := by rw [hew]
      _ = h (y * w) * h w := map_mul h _ _
      _ = g (y * w) * h w := by rw [heq]
  have hH : g w = g w * g (y * w) := by
    calc g w = g (w * (y * w)) := by rw [hwe]
      _ = g w * g (y * w) := map_mul g _ _
  have hI : g (y * w) * h w = g w * g (y * w) := by
    rw [← hC, heq]
  calc g w = g w * g (y * w) := hH
    _ = g (y * w) * h w := hI.symm
    _ = h w := hG.symm

/-- Let `S` be a `∗`-ring, `V` a `∗`-regular ring, and `φ : S →+* V` a ring homomorphism
commuting with the involutions (`hφ`, i.e. a `∗`-homomorphism).  If every element of `V` lies in
the `∗`-regular closure of the image of `φ` (equivalently `V = R(φ(S),V)` is generated by `φ(S)`
as a `∗`-regular `∗`-subring of itself), then `φ` is **epic** in the sense of right cancellability:
for every ring `Q` (no star structure!) and every pair of ring homomorphisms `g h : V →+* Q` with
`g ∘ φ = h ∘ φ`, one has `g = h`.

This is the "if" direction of [JZLA20, Proposition 2.7], citing [A. Jaikin-Zapirain, *The base
change in the Atiyah and the Lück approximation conjectures*, GAFA 29 (2019), Proposition 6.1]. -/
theorem isEpic_of_starRegularClosure {S V : Type} [Ring S] [StarRing S] [Ring V] [StarRing V]
    [IsStarRegular V] (φ : S →+* V) (hφ : ∀ s : S, φ (star s) = star (φ s))
    (hgen : ∀ v : V, v ∈ (starRegularClosure (starSubringClosure (Set.range φ)) : Set V)) :
    IsEpic φ := by
  intro Q _ g h hgh
  -- the equalizer of `g` and `h` is a subring of `V` containing the image of `φ`
  let E : Subring V :=
    { carrier := {v : V | g v = h v}
      zero_mem' := by simp
      one_mem' := by simp
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [map_add, map_add, ha, hb]
      neg_mem' := by
        intro a ha
        simp only [Set.mem_ofPred_eq] at ha ⊢
        rw [map_neg, map_neg, ha]
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [map_mul, map_mul, ha, hb] }
  -- the image of `φ` lies in `E`; since `φ` is a `∗`-homomorphism, so does `star '' Set.range φ`
  have hRE : ((starSubringClosure (Set.range φ)) : Set V) ⊆ (E : Set V) := by
    refine Subring.closure_le.mpr ?_
    rintro v (hv | ⟨u, hu, rfl⟩)
    · rcases hv with ⟨s, rfl⟩
      show g (φ s) = h (φ s)
      simpa using congrArg (fun f : S →+* Q => f s) hgh
    · rcases hu with ⟨s, rfl⟩
      show g (star (φ s)) = h (star (φ s))
      rw [← hφ s]
      simpa using congrArg (fun f : S →+* Q => f (star s)) hgh
  -- the relative inverse of a self-adjoint element of `E` again lies in `E`
  have hE : ∀ x : V, x ∈ (E : Set V) → star x = x → ∀ y : V, IsRelativeInverse x y →
      y ∈ (E : Set V) := by
    intro x hx hxs y hy
    exact map_relativeInverse_eq_of_selfAdjoint g h hxs hy hx
  have hsub : (starRegularClosure (starSubringClosure (Set.range φ)) : Set V) ⊆ (E : Set V) :=
    StarRegular.starRegularClosure_le_of_isRelativeInverse_selfAdjoint _ E hRE hE
  refine RingHom.ext fun v => ?_
  exact hsub (hgen v)

end Work.ORHughesFree.NaturalExtension
