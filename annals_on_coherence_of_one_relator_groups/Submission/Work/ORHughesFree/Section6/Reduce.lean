# The reduction to a finitely generated subgroup ([JZLA20, Theorem 6.1])

[JZLA20, Theorem 6.1] is proved by induction on the `G`-complexity of an element
`a ∈ D_{K[G],U}`.  The first step of the induction is the **reduction to a finitely generated
subgroup**: if `α ∈ Rat(Kˣ × G)` realises the `G`-complexity of `a`, then the subgroup `H ≤ G`
generated by the `G`-coordinates of the group elements occurring in a term representing `α` is
finitely generated, `α` already lies in the image of `Rat(Kˣ × H) → Rat(Kˣ × G)`, and — crucially
— the complexity is preserved by this inclusion (`Rat.treeOfRat_ofSubgroup`), so that the
`H`-complexity and the `G`-complexity of `α` agree.

This file contains

* `Phi_comp_ofSubgroup` : the diagram of [JZLA20, §4.3], i.e. the commutativity of
  `Rat(Kˣ × V) → Rat(Kˣ × G) → D_{K[G],U}` with the universal morphism for the restriction of the
  rational structure to a subgroup `V ≤ Kˣ × G`;
* `unitsTimesSubgroup` : the subgroup `Kˣ × H ≤ Kˣ × G` attached to a subgroup `H ≤ G`;
* `exists_fg_reduction` : the finitely generated reduction itself.
-/
import Mathlib
import Submission.Work.ORHughesFree.Rat.Restrict
import Submission.Work.ORHughesFree.Rat.exists_source_fg
import Submission.Work.ORHughesFree.Section6.RatStruct

set_option autoImplicit false

namespace Work.ORHughesFree

variable {G : Type} [Group G]

/-- **The diagram of [JZLA20, §4.3]**: the universal morphism of rational `Kˣ × G`-semirings
`Φ : Rat(Kˣ × G) → D_{K[G],U}` composed with the canonical map `Rat(V) → Rat(Kˣ × G)` for a
subgroup `V ≤ Kˣ × G` is the universal morphism attached to the restriction of the rational
structure to `V`. -/
theorem Phi_comp_ofSubgroup {K : Type} [Field K] {U : Type} [Ring U]
    (φ : MonoidAlgebra K G →+* U) (V : Subgroup (Kˣ × G)) :
    (Phi φ).comp (RatU.ofSubgroup V) =
      RatU.lift _ (RationalUSemiring.restrict V (ratStruct φ)) :=
  RatU.lift_comp_ofSubgroup V _ (ratStruct φ)

/-- The subgroup `Kˣ × H` of `Kˣ × G` attached to a subgroup `H ≤ G`, i.e. the image of
`Kˣ × ↥H` under the map `(λ, h) ↦ (λ, ↑h)`. -/
noncomputable def unitsTimesSubgroup {K : Type} [Monoid K] (H : Subgroup G) :
    Subgroup (Kˣ × G) :=
  ((⊤ : Subgroup Kˣ).prod (⊤ : Subgroup ↥H)).map
    (MonoidHom.prodMap (MonoidHom.id Kˣ) H.subtype)

theorem mem_unitsTimesSubgroup {K : Type} [Monoid K] {H : Subgroup G} {x : Kˣ × G} :
    x ∈ unitsTimesSubgroup (G := G) H ↔ x.2 ∈ H := by
  constructor
  · rintro ⟨y, -, hy⟩
    rw [← hy]
    exact y.2.2
  · intro hx
    exact ⟨(x.1, ⟨x.2, hx⟩),
      Subgroup.mem_prod.mpr ⟨Subgroup.mem_top _, Subgroup.mem_top _⟩, rfl⟩

/-- `V ≤ H₁ × H₂` whenever `V ≤ H₁ × (V.map Prod.snd)`. -/
theorem le_prod_map_snd {N : Type} [Group N] (V : Subgroup (G × N)) :
    V ≤ Subgroup.prod ⊤ (V.map (MonoidHom.snd G N)) := by
  intro v hv
  rw [Subgroup.mem_prod]
  exact ⟨Subgroup.mem_top _, ⟨v, hv, rfl⟩⟩

theorem Subgroup.fg_map {N : Type} [Group N] (V : Subgroup G) (f : G →* N) (hV : V.FG) :
    (V.map f).FG := by
  obtain ⟨S, hS, hSfin⟩ := (Subgroup.fg_iff V).mp hV
  refine (Subgroup.fg_iff _).mpr ⟨f '' S, ?_, hSfin.image f⟩
  rw [← MonoidHom.map_closure, hS]

/-- **[JZLA20, Theorem 6.1], the finitely generated reduction.**  Every element `α ∈ Rat(Kˣ × G)`
lies in the image of `Rat(Kˣ × H) → Rat(Kˣ × G)` for a finitely generated subgroup `H ≤ G`, and
its complexity is unchanged. -/
theorem exists_fg_reduction {K : Type} [Field K] (α : RatU (Kˣ × G)) :
    ∃ (H : Subgroup G) (α' : RatU ↥(unitsTimesSubgroup (K := K) H)),
      H.FG ∧
      RatU.ofSubgroup (unitsTimesSubgroup (K := K) H) α' = α ∧
      Rat.treeOfRat ↥(unitsTimesSubgroup (K := K) H) α' = Rat.treeOfRat (Kˣ × G) α := by
  classical
  refine Quotient.inductionOn α ?_
  intro t
  set S : Subgroup (Kˣ × G) := Subgroup.closure (RTerm.supp t) with hSdef
  set H : Subgroup G := S.map (MonoidHom.snd Kˣ G) with hHdef
  set W : Subgroup (Kˣ × G) := unitsTimesSubgroup (K := K) H with hWdef
  have hsub : RTerm.supp t ⊆ (W : Set (Kˣ × G)) := by
    intro u hu
    have huS : u ∈ S := Subgroup.subset_closure hu
    have huH : u.2 ∈ H := ⟨u, huS, rfl⟩
    rw [hWdef]
    exact mem_unitsTimesSubgroup.mpr huH
  have hSfg : S.FG := (Subgroup.fg_iff S).mpr ⟨RTerm.supp t, rfl, RTerm.supp_finite t⟩
  have hβ : RatU.ofSubgroup W (RatU.mk (RTerm.map (projSub W) t)) = RatU.mk t := by
    dsimp only [RatU.ofSubgroup]
    rw [RatU.lift_apply, RTerm.eval_map]
    · exact RTerm.eval_rational_self t
    · intro u hu
      exact coe_projSub W (hsub hu)
  exact ⟨H, RatU.mk (RTerm.map (projSub W) t), Subgroup.fg_map S (MonoidHom.snd Kˣ G) hSfg,
    hβ, (Rat.treeOfRat_ofSubgroup W _).symm.trans (congrArg (Rat.treeOfRat (Kˣ × G)) hβ)⟩

end Work.ORHughesFree
