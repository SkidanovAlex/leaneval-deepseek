import Mathlib
import Submission.Work.ORHughesFree.DivisionClosure.divisionClosure_le_of_vonNeumannRegular
import Submission.Work.ORHughesFree.Section6.SubgroupComplexity

namespace Work.ORHughesFree.Section6

/-- The division closure of `K[⊥]` in `U` is (the image of) the field `K`, so every non-zero
element of it is a unit.  Indeed `range (φ ∘ K[⊥] → K[G]) = range (fun λ : K => φ (single 1 λ))`
(since `K[⊥]` is generated by `single 1 1` and its elements are `single 1 λ`), and the image of `K`
in the non-trivial ring `U` is a subfield, hence a von Neumann regular subring containing the
generators; `DivisionClosure.divisionClosure_le_of_vonNeumannRegular` gives
`divisionClosure (range (φ ∘ K[⊥] → K[G])) ≤ (that subfield)`, and the converse inclusion is
`subset_divisionClosure`. -/
theorem isUnit_of_mem_divisionClosure_bot {K : Type} [Field K] {G : Type} [Group G] {U : Type}
    [Ring U] [Nontrivial U] (φ : MonoidAlgebra K G →+* U) {a : U}
    (ha : a ∈ (divisionClosure
      (Set.range (φ.comp (inducedMapRing (K := K) (⊥ : Subgroup G)))) : Subring U))
    (ha0 : a ≠ 0) : IsUnit a := by
  -- `ψ : K →+* U` is the image of `K` in `U`, i.e. the map `λ ↦ φ (single 1 λ)`.  Its `range`
  -- is the subfield of `U` promised by the docstring.
  let ψ : K →+* U := φ.comp (MonoidAlgebra.singleOneRingHom (R := K) (M := G))
  -- Every element of `K[⊥]` is `single 1 λ`, and it maps to `single 1 λ` in `K[G]`.
  have hmap : ∀ (x : MonoidAlgebra K ↥(⊥ : Subgroup G)),
      MonoidAlgebra.mapDomain (⊥ : Subgroup G).subtype x
        = MonoidAlgebra.single (1 : G) (x.coeff 1) := by
    intro x
    have hx : x = MonoidAlgebra.single (1 : ↥(⊥ : Subgroup G)) (x.coeff 1) := by
      apply MonoidAlgebra.ext
      rw [MonoidAlgebra.coeff_single]
      apply Finsupp.ext
      intro g
      rw [show g = 1 from Subtype.ext (Subgroup.mem_bot.mp g.2), Finsupp.single_eq_same]
    rw [hx, MonoidAlgebra.mapDomain_single]
    simp
  -- Hence `range (φ ∘ K[⊥] → K[G]) ⊆ range ψ`.
  have hsub : Set.range (φ.comp (inducedMapRing (K := K) (⊥ : Subgroup G)))
      ⊆ (ψ.range : Set U) := by
    rintro y ⟨x, rfl⟩
    refine ⟨x.coeff 1, ?_⟩
    show φ (MonoidAlgebra.singleOneRingHom (x.coeff 1))
      = φ (inducedMapRing (K := K) (⊥ : Subgroup G) x)
    rw [show MonoidAlgebra.singleOneRingHom (x.coeff 1)
        = MonoidAlgebra.single (1 : G) (x.coeff 1) from rfl]
    rw [inducedMapRing, MonoidAlgebra.mapDomainRingHom_apply]
    congr 1
    exact (hmap x).symm
  -- The image of the field `K` in the ring `U` is von Neumann regular.
  have vnr : VonNeumannRegularRing ψ.range := ⟨fun y => by
    obtain ⟨l, hl⟩ := RingHom.mem_range.mp y.2
    by_cases hy : (y : U) = 0
    · refine ⟨0, ?_⟩
      have hy0 : y = 0 := Subtype.ext hy
      rw [hy0]; simp
    · refine ⟨⟨ψ l⁻¹, ⟨l⁻¹, rfl⟩⟩, ?_⟩
      have hl0 : l ≠ 0 := fun h => hy (by rw [← hl]; simp [h])
      apply Subtype.ext
      show (y : U) * ψ l⁻¹ * (y : U) = (y : U)
      rw [← hl, ← map_mul, mul_inv_cancel₀ hl0, map_one, one_mul]⟩
  -- `divisionClosure (range (φ ∘ K[⊥] → K[G])) ⊆ range ψ`, so `a = ψ l` for some `l : K`.
  have ha' : a ∈ (ψ.range : Set U) :=
    Work.ORHughesFree.DivisionClosure.divisionClosure_le_of_vonNeumannRegular hsub ha
  obtain ⟨l, hl⟩ := RingHom.mem_range.mp ha'
  -- As `a ≠ 0`, the coefficient `l` is nonzero, and `ψ l⁻¹` is an inverse for `a`.
  have hl0 : l ≠ 0 := fun h => ha0 (by rw [← hl]; simp [h])
  exact ⟨⟨a, ψ l⁻¹,
    by rw [← hl, ← map_mul, mul_inv_cancel₀ hl0, map_one],
    by rw [← hl, ← map_mul, inv_mul_cancel₀ hl0, map_one]⟩, rfl⟩

end Work.ORHughesFree.Section6
