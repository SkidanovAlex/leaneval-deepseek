import Mathlib
import Submission.Work.ORHughesFree.Rat.SourceFrame
import Submission.Work.ORHughesFree.Rat.FreeProduct.Model
import Submission.Work.ORHughesFree.Rat.Weak.SVPart
import Submission.Work.ORHughesFree.Rat.Psi_mem_A_iff

/-!
# The orbit set of tails (setup for step 3 of the `source` argument)

With the transport `x ∈ Rat.A V ↔ supp (Psi x) ⊆ NUV V` (`Psi_mem_A_iff`) and the tail bridge
`Psi (x * φu) = Psi x * single (Ugen u) 1`, membership of a right translate of `x` in `Rat.A V` is
exactly

  `∀ p ∈ supp (Psi x), p * Ugen u ∈ NUV V`,

i.e. `u ∈ T (supp (Psi x)) V` for the set of tails

`T W V = {u : U | ∀ p ∈ W, p * NU.Ugen u ∈ NUV V}`.

This file defines the `V`-part `NUV V` of the free-product monoid `U ♮ X` and the tail-set `T`, and
records the elementary structure of `T` (monotonicity in `V` and `W`, stability under right
multiplication by `V`, and the resulting containment `T W S · V ⊆ T W V` for `S ≤ V`).  The
remaining, difficult half of step 3 is `T W V ⊆ T W S · V` when `S` is the least element of
`Rat.F x` and `W = supp (Psi x)`; that is what the recursion `Xgen_mem_closure_iff` is for.
-/

namespace Work.ORHughesFree.Rat
namespace Orbit

open Work.ORHughesFree
open Work.ORHughesFree.Rat.WordModel
open Work.ORHughesFree.Rat.FreeProduct

variable {U : Type} [Group U]

/-- **The `V`-part of `U ♮ X`**: the submonoid generated by the elements `Ugen v` (`v ∈ V`) and by
the `V`-letters `Xgen a` (`a ∈ Rat.A V`). -/
noncomputable def NUV (V : Subgroup U) : Submonoid (NU U) :=
  Submonoid.closure {p : NU U | (∃ v : U, v ∈ V ∧ p = NU.Ugen v) ∨
    (∃ a : RatU U, a ∈ Rat.A V ∧ p = NU.Xgen a)}

theorem NUV_mono {V W : Subgroup U} (h : V ≤ W) : NUV V ≤ NUV W := by
  rw [NUV, Submonoid.closure_le]
  rintro p (⟨v, hv, rfl⟩ | ⟨a, ha, rfl⟩)
  · exact Submonoid.subset_closure (Or.inl ⟨v, h hv, rfl⟩)
  · exact Submonoid.subset_closure (Or.inr ⟨a, Rat.A_mono h ha, rfl⟩)

theorem Ugen_mem_NUV {V : Subgroup U} {v : U} (hv : v ∈ V) : NU.Ugen v ∈ NUV V :=
  Submonoid.subset_closure (Or.inl ⟨v, hv, rfl⟩)

theorem Xgen_mem_NUV {V : Subgroup U} {a : RatU U} (ha : a ∈ Rat.A V) : NU.Xgen a ∈ NUV V :=
  Submonoid.subset_closure (Or.inr ⟨a, ha, rfl⟩)

/-- The set of `U`-tails `u` for which the whole translate `W · Ugen u` lies in the `V`-part. -/
def T (W : Finset (NU U)) (V : Subgroup U) : Set U :=
  {u : U | ∀ p ∈ W, p * NU.Ugen u ∈ NUV V}

/-- `T` is monotone in the subgroup. -/
theorem T_mono {W : Finset (NU U)} {V V' : Subgroup U} (h : V ≤ V') : T W V ⊆ T W V' :=
  fun _u hu p hp => NUV_mono h (hu p hp)

/-- `T` is antitone in the set of words. -/
theorem T_anti {W W' : Finset (NU U)} {V : Subgroup U} (h : W ⊆ W') : T W' V ⊆ T W V :=
  fun _u hu p hp => hu p (h hp)

/-- `T W V` is stable under right multiplication by elements of `V`. -/
theorem T_mul_mem {W : Finset (NU U)} {V : Subgroup U} {u : U} (hu : u ∈ T W V)
    {v : U} (hv : v ∈ V) : u * v ∈ T W V := by
  intro p hp
  have h1 : p * NU.Ugen u ∈ NUV V := hu p hp
  have h2 : NU.Ugen v ∈ NUV V := Ugen_mem_NUV hv
  rw [← NU.Ugen_mul, ← mul_assoc]
  exact (NUV V).mul_mem h1 h2

/-- **Step 3, easy half**: a tail at level `S` gives tails at every `V ⊇ S`. -/
theorem T_mul_subset {W : Finset (NU U)} {S V : Subgroup U} (h : S ≤ V) :
    ∀ u ∈ T W S, ∀ v ∈ V, u * v ∈ T W V := by
  intro u hu v hv
  exact T_mul_mem (T_mono h hu) hv

/-- **The word-level criterion**: a word `m` of the word model lies in the `V`-part of `Rat(U)`
exactly when its normal form in `U ♮ X` lies in the `V`-part of `U ♮ X`. -/
theorem Mval_mem_A_iff (V : Subgroup U) (m : WordModel.Mword U) :
    (∃ β : RatU ↥V, RatU.ofSubgroup V β = WordModel.Mval m) ↔ nrm m ∈ NUV V := by
  by_cases hm : WordModel.Mval m = 0
  · constructor
    · intro _
      rw [nrm_of_eq_zero hm]
      exact (NUV V).one_mem
    · intro _
      exact ⟨0, by rw [hm, map_zero]⟩
  · have h := Psi_mem_A_iff V (WordModel.Mval m)
    rw [Psi_Mval hm] at h
    simpa [NUV, Finsupp.mem_support_iff, MonoidAlgebra.coeff_single] using h

end Orbit
end Work.ORHughesFree.Rat
