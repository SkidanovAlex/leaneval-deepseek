import Mathlib
import Submission.Work.ORHughesFree.Rat.FreeProduct.Model
import Submission.Work.ORHughesFree.Rat.Psi_mem_A_iff
import Submission.Work.ORHughesFree.Rat.coeff_support_mul_single_one
import Submission.Work.ORHughesFree.Rat.Orbit

namespace Work.ORHughesFree.Rat

open Work.ORHughesFree

/-- `Rat.A V` is the range of `ofSubgroup V`. -/
theorem mem_A_iff_exists {U : Type} [Group U] (V : Subgroup U) (y : RatU U) :
    y ∈ Rat.A V ↔ ∃ β : RatU ↥V, RatU.ofSubgroup V β = y :=
  Set.mem_range

/-- The two descriptions of the `V`-part of `U ♮ X` agree: `Orbit.NUV V` is the submonoid
generated by the group letters `Ugen v` (`v ∈ V`) and the `V`-letters `Xgen a` (`a ∈ Rat.A V`). -/
theorem NUV_eq_VPart {U : Type} [Group U] (V : Subgroup U) :
    Orbit.NUV V = FreeProduct.VPart V := rfl

/-- The bridge: `Psi` turns right multiplication by a group element into right multiplication by
the monomial `single (Ugen u) 1`. -/
theorem Psi_mul_ofGroup {U : Type} [Group U] (x : RatU U) (u : U) :
    FreeProduct.Psi (x * RatU.ofGroup u)
      = FreeProduct.Psi x * MonoidAlgebra.single (FreeProduct.NU.Ugen u) 1 := by
  rw [map_mul, FreeProduct.Psi_ofGroup]

theorem mem_A_mul_ofGroup_iff {U : Type} [Group U] (V : Subgroup U)
    (x : Work.ORHughesFree.RatU U) (u : U) :
    x * Work.ORHughesFree.RatU.ofGroup u ∈ Work.ORHughesFree.Rat.A V ↔
      ∀ p ∈ (Work.ORHughesFree.Rat.FreeProduct.Psi x).coeff.support,
        p * Work.ORHughesFree.Rat.FreeProduct.NU.Ugen u ∈ Work.ORHughesFree.Rat.Orbit.NUV V := by
  classical
  rw [mem_A_iff_exists, Psi_mem_A_iff V (x * RatU.ofGroup u), NUV_eq_VPart,
    Psi_mul_ofGroup, coeff_support_mul_single_one]
  simp only [Finset.mem_image]
  constructor
  · intro h p hp
    exact h (p * FreeProduct.NU.Ugen u) ⟨p, hp, rfl⟩
  · rintro h q ⟨a, ha, rfl⟩
    exact h a ha

end Work.ORHughesFree.Rat
