import Mathlib
import Submission.Work.ORHughesFree.Rat.SourceFrame
import Submission.Work.ORHughesFree.Rat.FreeProduct.Model
import Submission.Work.ORHughesFree.Rat.Weak.SVPart

namespace Work.ORHughesFree.Rat

open Work.ORHughesFree
open MonoidAlgebra

namespace FreeProduct

variable {U : Type} [Group U]

/-! ## The `V`-part of `U ♮ X`

The letters of `U ♮ X` lying over a subgroup `V ≤ U`: the group letters `Ugen v` with `v ∈ V`
and the `X`-letters `Xgen a` whose name lies in `Rat.A V = Rat(V) ⊆ Rat(U)`.  The `V`-part
`VPart V` is the submonoid they generate, and `WSet V` is the set of elements of `ℕ[U ♮ X]`
whose support lies in it.

The main theorem `Psi_mem_A_iff` says that `x ∈ Rat(A V)` is exactly the condition
`supp (Psi x) ⊆ VPart V`. -/

/-- The set of letters of `U ♮ X` lying over `V`: `Ugen v` for `v ∈ V` and `Xgen a` for
`a ∈ Rat.A V`. -/
abbrev letterSet (V : Subgroup U) : Set (NU U) :=
  {p : NU U |
    (∃ v : U, v ∈ V ∧ p = NU.Ugen v) ∨
    (∃ a : RatU U, a ∈ Rat.A V ∧ p = NU.Xgen a)}

/-- The `V`-part of `U ♮ X`: the submonoid generated by the letters lying over `V`. -/
noncomputable abbrev VPart (V : Subgroup U) : Submonoid (NU U) := Submonoid.closure (letterSet V)

/-- The set of elements of `ℕ[U ♮ X]` whose support lies in the `V`-part. -/
abbrev WSet (V : Subgroup U) : Set (S2 U) := {z | ∀ p ∈ z.coeff.support, p ∈ VPart V}

theorem Ugen_mem_VPart {V : Subgroup U} {v : U} (hv : v ∈ V) : NU.Ugen v ∈ VPart V :=
  Submonoid.subset_closure (Or.inl ⟨v, hv, rfl⟩)

theorem Xgen_mem_VPart {V : Subgroup U} {a : RatU U} (ha : a ∈ Rat.A V) :
    NU.Xgen a ∈ VPart V :=
  Submonoid.subset_closure (Or.inr ⟨a, ha, rfl⟩)

/-- **The evaluation of the `V`-part lies in `A V`**: `evalNU` maps the submonoid generated by
the letters `Ugen v` (`v ∈ V`) and `Xgen a` (`a ∈ Rat.A V`) into `Rat.A V`. -/
theorem evalNU_mem_A (V : Subgroup U) {p : NU U} (hp : p ∈ VPart V) : evalNU p ∈ Rat.A V := by
  induction hp using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with ⟨v, hv, rfl⟩ | ⟨a, ha, rfl⟩
    · rw [evalNU_Ugen]
      exact Weak.A_ofGroup_mem hv
    · rw [evalNU_Xgen]
      exact Weak.A_ratOp_mem ha
  | one =>
    show evalNU (1 : NU U) ∈ Rat.A V
    rw [show evalNU (1 : NU U) = 1 from (evalHom (U := U)).map_one]
    exact (Weak.ASub V).one_mem
  | mul x y hx hy ihx ihy =>
    rw [evalNU_mul]
    exact (Weak.ASub V).mul_mem ihx ihy

/-! ## The support condition is closed under the semiring operations -/

theorem WSet_zero (V : Subgroup U) : (0 : S2 U) ∈ WSet V := by
  intro p hp
  simp at hp

theorem WSet_single {V : Subgroup U} {p : NU U} (hp : p ∈ VPart V) (c : ℕ) :
    (single p c : S2 U) ∈ WSet V := by
  intro p' hp'
  rw [MonoidAlgebra.coeff_single] at hp'
  have h : p' = p := Finset.mem_singleton.mp (Finsupp.support_single_subset hp')
  subst h
  exact hp

theorem WSet_one (V : Subgroup U) : (1 : S2 U) ∈ WSet V := by
  rw [MonoidAlgebra.one_def]
  exact WSet_single (V := V) (VPart V).one_mem 1

theorem WSet_add {V : Subgroup U} {z z' : S2 U} (hz : z ∈ WSet V) (hz' : z' ∈ WSet V) :
    z + z' ∈ WSet V := by
  intro p hp
  rw [Finsupp.mem_support_iff, MonoidAlgebra.coeff_add, Finsupp.add_apply] at hp
  by_cases h : z.coeff p = 0
  · rw [h, zero_add] at hp
    exact hz' p (by rwa [Finsupp.mem_support_iff])
  · exact hz p (by rwa [Finsupp.mem_support_iff])

theorem WSet_finset_sum {V : Subgroup U} {ι : Type} (s : Finset ι) (g : ι → S2 U)
    (h : ∀ i ∈ s, g i ∈ WSet V) : s.sum g ∈ WSet V := by
  classical
  revert h
  refine Finset.induction_on s ?_ ?_
  · intro _
    exact WSet_zero V
  · intro a s has ih h
    rw [Finset.sum_insert has]
    exact WSet_add (h a (Finset.mem_insert_self a s))
      (ih (fun i hi => h i (Finset.mem_insert_of_mem hi)))

theorem WSet_mul {V : Subgroup U} {z z' : S2 U} (hz : z ∈ WSet V) (hz' : z' ∈ WSet V) :
    z * z' ∈ WSet V := by
  classical
  rw [MonoidAlgebra.mul_def]
  simp only [Finsupp.sum]
  refine WSet_finset_sum _ _ (fun p hp => ?_)
  exact WSet_finset_sum _ _ (fun q hq => WSet_single ((VPart V).mul_mem (hz p hp) (hz' q hq)) _)

/-! ## The two directions -/

/-- `sigma2` evaluated on a support sum. -/
theorem sigma2_apply (z : S2 U) :
    sigma2 z = z.coeff.sum (fun p c => c • evalNU p) :=
  MonoidAlgebra.lift_apply _ _

/-- The `⋄`-name of the evaluation of a term over `V` lies in `Rat.A V`. -/
theorem sigma2_eval_map_mem (V : Subgroup U) (τ : RTerm ↥V) :
    sigma2 (RTerm.eval (S2 U) rNU (RTerm.map (Subtype.val : ↥V → U) τ)) ∈ Rat.A V := by
  rw [show RTerm.eval (S2 U) rNU (RTerm.map (Subtype.val : ↥V → U) τ)
      = Psi (RatU.mk (RTerm.map (Subtype.val : ↥V → U) τ)) from rfl]
  rw [← ofSubgroup_mk_map τ, sigma2_Psi]
  exact ⟨RatU.mk τ, rfl⟩

/-- **Forward direction, on terms**: the evaluation of a term over `V` has support in the
`V`-part. -/
theorem eval_map_mem_WSet (V : Subgroup U) (τ : RTerm ↥V) :
    RTerm.eval (S2 U) rNU (RTerm.map (Subtype.val : ↥V → U) τ) ∈ WSet V := by
  induction τ with
  | z =>
    simp only [RTerm.map, RTerm.eval]
    exact WSet_zero V
  | o =>
    simp only [RTerm.map, RTerm.eval]
    exact WSet_one V
  | add a b iha ihb =>
    simp only [RTerm.map, RTerm.eval]
    exact WSet_add iha ihb
  | mul a b iha ihb =>
    simp only [RTerm.map, RTerm.eval]
    exact WSet_mul iha ihb
  | rat a iha =>
    simp only [RTerm.map, RTerm.eval]
    change rNURatOp U (RTerm.eval (S2 U) rNU (RTerm.map (Subtype.val : ↥V → U) a)) ∈ WSet V
    by_cases hz : sigma2 (RTerm.eval (S2 U) rNU (RTerm.map (Subtype.val : ↥V → U) a)) = 0
    · rw [rNURatOp_of_eq_zero hz]; exact WSet_zero V
    · rw [rNURatOp_of_ne hz]
      refine WSet_single (V := V) (Xgen_mem_VPart ?_) 1
      exact sigma2_eval_map_mem V a
  | smulL u a iha =>
    simp only [RTerm.map, RTerm.eval]
    exact WSet_mul (WSet_single (V := V) (Ugen_mem_VPart u.2) 1) iha
  | smulR u a iha =>
    simp only [RTerm.map, RTerm.eval]
    exact WSet_mul iha (WSet_single (V := V) (Ugen_mem_VPart u.2) 1)

/-- **Forward direction**, in the form in which the main theorem uses it. -/
theorem Psi_ofSubgroup_mem (V : Subgroup U) (β : RatU ↥V) :
    ∀ p ∈ (Psi (RatU.ofSubgroup V β)).coeff.support, p ∈ VPart V := by
  refine Quotient.inductionOn β ?_
  intro τ
  show ∀ p ∈ (Psi (RatU.ofSubgroup V (RatU.mk τ))).coeff.support, p ∈ VPart V
  rw [ofSubgroup_mk_map τ]
  exact eval_map_mem_WSet V τ

/-- `Rat.A V` is closed under finite `ℕ`-linear combinations. -/
theorem sum_smul_mem_A {V : Subgroup U} {ι : Type} (s : Finset ι) (c : ι → ℕ) (g : ι → RatU U)
    (h : ∀ i ∈ s, g i ∈ Rat.A V) : (∑ i ∈ s, c i • g i) ∈ Rat.A V := by
  classical
  revert h
  refine Finset.induction_on s ?_ ?_
  · intro _
    exact (Weak.ASub V).zero_mem
  · intro a s has ih h
    rw [Finset.sum_insert has]
    exact (Weak.ASub V).add_mem
      ((Weak.ASub V).nsmul_mem (h a (Finset.mem_insert_self a s)) (c a))
      (ih (fun i hi => h i (Finset.mem_insert_of_mem hi)))

/-- **Backward direction**: if the support of `Psi z` lies in the `V`-part, then `sigma2 z` lies
in `Rat.A V` (so `z = sigma2 (Psi z) ∈ Rat.A V`). -/
theorem sigma2_mem_A (V : Subgroup U) {z : S2 U} (hz : z ∈ WSet V) : sigma2 z ∈ Rat.A V := by
  have hmem : ∀ p ∈ z.coeff.support, evalNU p ∈ Rat.A V := fun p hp => evalNU_mem_A V (hz p hp)
  rw [sigma2_apply]
  rw [Finsupp.sum_of_support_subset z.coeff (subset_refl _) (fun p c => c • evalNU p)
    (fun i _ => by simp)]
  exact sum_smul_mem_A z.coeff.support z.coeff evalNU (fun p hp => hmem p hp)

end FreeProduct

theorem Psi_mem_A_iff {U : Type} [Group U] (V : Subgroup U) (x : Work.ORHughesFree.RatU U) :
    (∃ β : Work.ORHughesFree.RatU ↥V, Work.ORHughesFree.RatU.ofSubgroup V β = x) ↔
      ∀ p ∈ (Work.ORHughesFree.Rat.FreeProduct.Psi x).coeff.support,
        p ∈ Submonoid.closure {p : Work.ORHughesFree.Rat.FreeProduct.NU U |
          (∃ v : U, v ∈ V ∧ p = Work.ORHughesFree.Rat.FreeProduct.NU.Ugen v) ∨
          (∃ a : Work.ORHughesFree.RatU U, a ∈ Work.ORHughesFree.Rat.A V ∧
            p = Work.ORHughesFree.Rat.FreeProduct.NU.Xgen a)} := by
  constructor
  · rintro ⟨β, rfl⟩
    exact FreeProduct.Psi_ofSubgroup_mem V β
  · intro h
    have hx : x ∈ Rat.A V := by
      rw [← FreeProduct.sigma2_Psi x]
      exact FreeProduct.sigma2_mem_A V h
    exact hx

end Work.ORHughesFree.Rat
