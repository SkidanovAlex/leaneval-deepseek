import Mathlib
import Submission.Work.ORHughesFree.Rat.Orbit
import Submission.Work.ORHughesFree.Rat.FreeProduct.NUMonoid

/-!
# The `V`-part of `U ♮ X` meets the group part exactly in `V`

The `V`-part `Orbit.NUV V` of the free product monoid `U ♮ X = NU U` is the submonoid generated by
the group letters `Ugen v` (`v ∈ V`) and the `X`-letters `Xgen a` with `a ∈ Rat.A V`.  The group
`U` sits inside `U ♮ X` through `Ugen`, and this file shows that this embedding meets `NUV V`
exactly in `V`:

  `Ugen u ∈ NUV V ↔ u ∈ V`.

The reverse implication is `Orbit.Ugen_mem_NUV` (a generator).  For the forward implication, note
that in `U ♮ X` a product is a group element only if *every* factor is: the `X`-part `XPart U`
absorbs multiplication on the right (`Sum.inr L * q` is again of the form `Sum.inr L'`, see
`inr_mul_mem`) and on the left inside the group part (`Sum.inl u * Sum.inr L` is again `Sum.inr`,
see `inl_mul_inr_mem`).  Hence the set

  `{p : U ♮ X | p = Ugen u with u ∈ V} ∪ XPart U`

is a submonoid, it contains every generator of `NUV V`, and therefore it contains `NUV V`.  An
element `Ugen u` of this submonoid must fall under the first alternative, i.e. `Ugen u = Ugen v`
for some `v ∈ V`, and `Ugen` is injective.
-/

namespace Work.ORHughesFree.Rat

open Work.ORHughesFree
open Work.ORHughesFree.Rat.FreeProduct

variable {U : Type} [Group U]

/-- The `X`-part of `U ♮ X` absorbs right multiplication: a product whose left factor lies in
`XPart U` lies in `XPart U`. -/
private theorem inr_mul_mem (L : XPart U) (q : NU U) :
    ∃ L' : XPart U, Sum.inr L * q = Sum.inr L' := by
  rcases q with v | L'
  · refine Quotient.inductionOn L ?_
    intro M
    exact ⟨_, NU.mk_mul_inl M v⟩
  · refine Quotient.inductionOn L ?_
    intro M
    refine Quotient.inductionOn L' ?_
    intro N
    exact ⟨_, NU.mk_mul_mk M N⟩

/-- A group letter absorbs an `X`-letter on its right: `Ugen u * Xgen x` again lies in `XPart U`. -/
private theorem inl_mul_inr_mem (u : U) (L : XPart U) :
    ∃ L' : XPart U, Sum.inl u * Sum.inr L = Sum.inr L' := by
  refine Quotient.inductionOn L ?_
  intro M
  exact ⟨_, NU.inl_mul_mk u M⟩

/-- The submonoid of `U ♮ X` consisting of the group letters `Ugen u` with `u ∈ V` together with
*all* of the `X`-part `XPart U`. -/
private noncomputable def UgenSat (V : Subgroup U) : Submonoid (NU U) where
  carrier := {p : NU U | (∃ u : U, u ∈ V ∧ p = NU.Ugen u) ∨ (∃ L : XPart U, p = Sum.inr L)}
  one_mem' := Or.inl ⟨1, V.one_mem, rfl⟩
  mul_mem' := by
    rintro p q (⟨a, ha, rfl⟩ | ⟨L, rfl⟩) (⟨b, hb, rfl⟩ | ⟨L', rfl⟩)
    · exact Or.inl ⟨a * b, V.mul_mem ha hb, by rw [NU.Ugen_mul]⟩
    · obtain ⟨L'', hL''⟩ := inl_mul_inr_mem a L'
      exact Or.inr ⟨L'', hL''⟩
    · obtain ⟨L'', hL''⟩ := inr_mul_mem L (NU.Ugen b)
      exact Or.inr ⟨L'', hL''⟩
    · obtain ⟨L'', hL''⟩ := inr_mul_mem L (Sum.inr L')
      exact Or.inr ⟨L'', hL''⟩

/-- Every generator of `NUV V` lies in `UgenSat V`, hence `NUV V ≤ UgenSat V`. -/
private theorem NUV_le_UgenSat (V : Subgroup U) : Orbit.NUV V ≤ UgenSat V := by
  rw [Orbit.NUV, Submonoid.closure_le]
  rintro p (⟨v, hv, rfl⟩ | ⟨a, ha, rfl⟩)
  · exact Or.inl ⟨v, hv, rfl⟩
  · exact Or.inr ⟨Quotient.mk _ ⟨[a], by simp⟩, rfl⟩

theorem Ugen_mem_NUV_iff {U : Type} [Group U] (V : Subgroup U) (u : U) :
    Work.ORHughesFree.Rat.FreeProduct.NU.Ugen u ∈ Work.ORHughesFree.Rat.Orbit.NUV V ↔ u ∈ V := by
  constructor
  · intro h
    rcases NUV_le_UgenSat V h with ⟨v, hv, hv'⟩ | ⟨L, hL⟩
    · have huv : u = v := Sum.inl.inj hv'
      rw [huv]
      exact hv
    · exact absurd hL Sum.inl_ne_inr
  · intro hu
    exact Orbit.Ugen_mem_NUV hu

end Work.ORHughesFree.Rat
