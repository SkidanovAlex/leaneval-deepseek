import Mathlib
import Submission.Work.ORHughesFree.Rat.FreeProduct.Model
import Submission.Work.ORHughesFree.Rat.FreeProduct.first_letter_NU

/-!
# The first-letter recursion for the `V`-part of `U ♮ X`

For a subgroup `V ≤ U`, the `V`-part `NUV V` of the monoid `U ♮ X` (the combinatorial model of
`Rat(U)`, `FreeProduct/NU.lean`) is the submonoid generated by the `Ugen v` with `v ∈ V` and the
`Xgen b` with `b ∈ Rat.A V`.

The main statement of this file is the *quotient-level first-letter recursion*

`Xgen a * q ∈ NUV V ↔ ∃ v : U, actR v a ∈ A V ∧ Ugen v⁻¹ * q ∈ NUV V`.

The `∃ v` is essential: the `U`-part `q` and the first `X`-letter `a` are only determined up to the
`U`-action of the quotient `XPart U = (U ♮ X ∖ U)`, and the same `v` witnesses both conjuncts.

The forward direction is proved by writing `Xgen a * q` as a product of generators and taking the
*first* `Xgen`-generator in that product: the `Ugen v` generators preceding it multiply to a single
`Ugen w` with `w ∈ V`, so the product is `Xgen (actL w b) * r`, and `first_letter_NU` identifies
the ambiguity `v`.  The backward direction is the monoid law `Xgen (actR v a) * Ugen v⁻¹ = Xgen a`.
-/

namespace Work.ORHughesFree.Rat

open Work.ORHughesFree

variable {U : Type} [Group U]

/-- The set of generators of the `V`-part of `U ♮ X`: the group elements `Ugen v` with `v ∈ V`
and the `X`-letters `Xgen b` with `b ∈ Rat.A V`. -/
def NUVGen (V : Subgroup U) : Set (FreeProduct.NU U) :=
  {p : FreeProduct.NU U |
    (∃ v : U, v ∈ V ∧ p = FreeProduct.NU.Ugen v) ∨
    (∃ b : RatU U, b ∈ A V ∧ p = FreeProduct.NU.Xgen b)}

/-- The `V`-part of `U ♮ X`: the submonoid generated by `Ugen '' V` and `Xgen '' A V`. -/
noncomputable def NUV (V : Subgroup U) : Submonoid (FreeProduct.NU U) :=
  Submonoid.closure (NUVGen V)

/-- `Rat.A V` is closed under multiplication. -/
private theorem A_mul_local {V : Subgroup U} {x y : RatU U} (hx : x ∈ A V) (hy : y ∈ A V) :
    x * y ∈ A V := by
  obtain ⟨β, rfl⟩ := hx
  obtain ⟨γ, rfl⟩ := hy
  exact ⟨β * γ, map_mul (RatU.ofSubgroup V) β γ⟩

/-- `ofGroup u ∈ Rat.A V` for `u ∈ V`. -/
private theorem A_ofGroup_mem_local {V : Subgroup U} {u : U} (hu : u ∈ V) :
    RatU.ofGroup u ∈ A V :=
  ⟨RatU.ofGroup ⟨u, hu⟩, ofSubgroup_ofGroup V ⟨u, hu⟩⟩

/-- `actR` is a left action of `U`: its inverse law. -/
theorem actR_inv_actR (v : U) (x : RatU U) :
    FreeProduct.actR v⁻¹ (FreeProduct.actR v x) = x := by
  simp only [FreeProduct.actR]
  rw [inv_inv, ← mul_assoc, ← RatU.ofGroup_mul, mul_inv_cancel, RatU.ofGroup_one, one_mul]

/-- A product `Xgen a * q` always lies in the `X`-part of `U ♮ X`, hence is never `1`. -/
theorem Xgen_mul_ne_one (a : RatU U) (q : FreeProduct.NU U) :
    FreeProduct.NU.Xgen a * q ≠ 1 := by
  intro h
  rcases q with u | L
  · rw [FreeProduct.NU.Xgen_mul_Ugen] at h
    exact Sum.inr_ne_inl h
  · induction L using Quotient.inductionOn with
    | h M =>
      rw [FreeProduct.NU.Xgen_mul_mk] at h
      exact Sum.inr_ne_inl h

/-- The first-letter recursion, in the form of an induction on a product of generators of `NUV V`:
if `l` is a list of generators whose product is `Xgen a * q`, then some `v` translates the first
letter into `A V` and simultaneously puts the tail into `NUV V`. -/
private theorem NUV_first_letter (V : Subgroup U) :
    ∀ l : List (FreeProduct.NU U), (∀ g ∈ l, g ∈ NUVGen V) →
      ∀ (a : RatU U) (q : FreeProduct.NU U),
        l.prod = FreeProduct.NU.Xgen a * q →
        ∃ v : U, FreeProduct.actR v a ∈ A V ∧
          FreeProduct.NU.Ugen v⁻¹ * q ∈ NUV V := by
  intro l
  induction l with
  | nil =>
    intro _ a q h
    rw [List.prod_nil] at h
    exact absurd h.symm (Xgen_mul_ne_one a q)
  | cons g l' ih =>
    intro hl a q h
    rw [List.prod_cons] at h
    have hl' : ∀ x ∈ l', x ∈ NUVGen V := fun x hx => hl x (List.mem_cons_of_mem g hx)
    rcases hl g List.mem_cons_self with ⟨v, hv, rfl⟩ | ⟨b, hb, rfl⟩
    · -- the first generator is `Ugen v`: strip it and reduce to the tail
      have h' : l'.prod = FreeProduct.NU.Xgen (a * RatU.ofGroup v) * q := by
        calc l'.prod = FreeProduct.NU.Ugen v⁻¹ * (FreeProduct.NU.Ugen v * l'.prod) := by
              rw [← mul_assoc, FreeProduct.NU.Ugen_mul, inv_mul_cancel]; exact (one_mul l'.prod).symm
          _ = FreeProduct.NU.Ugen v⁻¹ * (FreeProduct.NU.Xgen a * q) := by rw [h]
          _ = (FreeProduct.NU.Ugen v⁻¹ * FreeProduct.NU.Xgen a) * q := by rw [mul_assoc]
          _ = FreeProduct.NU.Xgen (a * RatU.ofGroup v) * q := by
                rw [FreeProduct.NU.Ugen_mul_Xgen, FreeProduct.actL, inv_inv]
      obtain ⟨w, hw1, hw2⟩ := ih hl' (a * RatU.ofGroup v) q h'
      refine ⟨w, ?_, hw2⟩
      have hA : FreeProduct.actR w (a * RatU.ofGroup v)
          = FreeProduct.actR w a * RatU.ofGroup v := by
        simp only [FreeProduct.actR]; rw [mul_assoc]
      rw [hA] at hw1
      have hfin := A_mul_local hw1 (A_ofGroup_mem_local (V := V) (inv_mem hv))
      rwa [mul_assoc, ← RatU.ofGroup_mul, mul_inv_cancel, RatU.ofGroup_one, mul_one] at hfin
    · -- the first generator is `Xgen b`: apply the first-letter lemma
      obtain ⟨w, hw, hq⟩ := FreeProduct.first_letter_NU b a l'.prod q h
      refine ⟨w⁻¹, ?_, ?_⟩
      · have ha : a = FreeProduct.actR w b :=
          FreeProduct.NU.Xgen_injective (by rw [hw, FreeProduct.NU.Xgen_mul_Ugen])
        rw [ha, actR_inv_actR]; exact hb
      · have hq' : FreeProduct.NU.Ugen w⁻¹⁻¹ * q = l'.prod := by rw [inv_inv, ← hq]
        rw [hq']
        exact Submonoid.list_prod_mem (NUV V) (fun x hx => Submonoid.subset_closure (hl' x hx))

theorem Xgen_mem_closure_iff {U : Type} [Group U] (V : Subgroup U) (a : Work.ORHughesFree.RatU U)
    (q : Work.ORHughesFree.Rat.FreeProduct.NU U) :
    Work.ORHughesFree.Rat.FreeProduct.NU.Xgen a * q ∈
      Submonoid.closure {p : Work.ORHughesFree.Rat.FreeProduct.NU U |
        (∃ v : U, v ∈ V ∧ p = Work.ORHughesFree.Rat.FreeProduct.NU.Ugen v) ∨
        (∃ b : Work.ORHughesFree.RatU U, b ∈ Work.ORHughesFree.Rat.A V ∧
          p = Work.ORHughesFree.Rat.FreeProduct.NU.Xgen b)} ↔
    ∃ v : U, Work.ORHughesFree.Rat.FreeProduct.actR v a ∈ Work.ORHughesFree.Rat.A V ∧
      Work.ORHughesFree.Rat.FreeProduct.NU.Ugen v⁻¹ * q ∈
        Submonoid.closure {p : Work.ORHughesFree.Rat.FreeProduct.NU U |
          (∃ w : U, w ∈ V ∧ p = Work.ORHughesFree.Rat.FreeProduct.NU.Ugen w) ∨
          (∃ b : Work.ORHughesFree.RatU U, b ∈ Work.ORHughesFree.Rat.A V ∧
            p = Work.ORHughesFree.Rat.FreeProduct.NU.Xgen b)} := by
  change FreeProduct.NU.Xgen a * q ∈ NUV V ↔
    ∃ v : U, FreeProduct.actR v a ∈ A V ∧ FreeProduct.NU.Ugen v⁻¹ * q ∈ NUV V
  constructor
  · intro h
    obtain ⟨l, hl, hprod⟩ := Submonoid.exists_list_of_mem_closure h
    exact NUV_first_letter V l hl a q hprod
  · rintro ⟨v, hv1, hv2⟩
    have hactR : FreeProduct.actR v⁻¹ (FreeProduct.actR v a) = a := actR_inv_actR v a
    have hsplit : FreeProduct.NU.Xgen a
        = FreeProduct.NU.Xgen (FreeProduct.actR v a) * FreeProduct.NU.Ugen v⁻¹ := by
      rw [FreeProduct.NU.Xgen_mul_Ugen, hactR]
    rw [hsplit, mul_assoc]
    exact Submonoid.mul_mem _ (Submonoid.subset_closure (Or.inr ⟨_, hv1, rfl⟩)) hv2

end Work.ORHughesFree.Rat
