import Mathlib
import Submission.Work.ORHughesFree.Rat.FreeProduct.Eval

/-!
# `evalList` is invariant under the orbit relation `relNE`

The orbit relation `relNE` of `Submission.Work.ORHughesFree.Rat.FreeProduct.NU` is generated by the
`U^{n-1}`-action `shiftPad (1 :: (b ++ [1]))` on `X`-words.  This file shows that the evaluation
`evalList` of `Submission.Work.ORHughesFree.Rat.FreeProduct.Eval` is invariant under it, which is
exactly the statement that `evalWord` is well defined on the quotient `XPart`.

The computation is the telescoping identity

`evalList (shiftPad (c :: (b ++ [d])) l) = ofGroup c⁻¹ * evalList l * ofGroup d`,

for a parameter list `c :: (b ++ [d])` of length `l.length + 1`: each letter `x_i` contributes
`ratOp (ofGroup b_{i+1}⁻¹ * x_i * ofGroup b_i) = ofGroup b_i⁻¹ * ratOp x_i * ofGroup b_{i+1}`, and
the interior factors `ofGroup b_{i+1} * ofGroup b_{i+1}⁻¹` cancel pairwise.  With the boundary
parameters `c = d = 1` the value is unchanged.
-/

namespace Work.ORHughesFree.Rat.FreeProduct

open Work.ORHughesFree

variable {U : Type} [Group U]

/-- Moving a group element out of the argument of `⋄`, on the right: `(A * v)⋄ = v⁻¹ · A⋄`.
This is the axiom `(u r v)⋄ = v⁻¹ r⋄ u⁻¹` of `RationalUSemiring`. -/
theorem ratOp_mul_ofGroup_right (A : RatU U) (u : U) :
    RatU.ratOp (A * RatU.ofGroup u) = RatU.ofGroup u⁻¹ * RatU.ratOp A := by
  have h := RatU.ofGroup_mul_ratOp u⁻¹ A
  simp only [inv_inv] at h
  exact h.symm

/-- Moving a group element out of the argument of `⋄`, on the left: `(u⁻¹ * A)⋄ = A⋄ * u`.
This is the axiom `(u r v)⋄ = v⁻¹ r⋄ u⁻¹` of `RationalUSemiring`. -/
theorem ratOp_ofGroup_inv_mul (A : RatU U) (u : U) :
    RatU.ratOp (RatU.ofGroup u⁻¹ * A) = RatU.ratOp A * RatU.ofGroup u :=
  (RatU.ratOp_mul_ofGroup A u).symm

/-- `ofGroup u * (ofGroup u⁻¹ * A) = A`, the cancellation of an adjacent inverse pair. -/
theorem ofGroup_mul_inv_cancel_mul (u : U) (A : RatU U) :
    RatU.ofGroup u * (RatU.ofGroup u⁻¹ * A) = A := by
  rw [← mul_assoc, ← RatU.ofGroup_mul, mul_inv_cancel, RatU.ofGroup_one, one_mul]

/-- **The telescoping identity for `shiftPad`.**  For a parameter list `c :: (b ++ [d])` of length
`l.length + 1`, the evaluation of the shifted word is the conjugate of `evalList l` by the boundary
parameters `c` and `d`. -/
theorem evalList_shiftPad_eq (l : List (RatU U)) (b : List U) (c d : U)
    (h : b.length + 1 = l.length) :
    evalList (shiftPad (c :: (b ++ [d])) l)
      = RatU.ofGroup c⁻¹ * evalList l * RatU.ofGroup d := by
  induction l generalizing b c d with
  | nil =>
    exfalso
    simp only [List.length_nil] at h
    omega
  | cons x xs ih =>
    have hb : b.length = xs.length := by simp only [List.length_cons] at h; omega
    cases b with
    | nil =>
      have hxs : xs = [] := by
        simp only [List.length_nil] at hb
        exact List.length_eq_zero_iff.mp hb.symm
      subst hxs
      simp only [List.nil_append, shiftPad_cons, shiftPad_nil, evalList_cons, evalList_nil,
        mul_one]
      rw [ratOp_mul_ofGroup_right (RatU.ofGroup d⁻¹ * x) c, ratOp_ofGroup_inv_mul x d,
        mul_assoc]
    | cons e es =>
      simp only [List.cons_append, shiftPad_cons, evalList_cons]
      rw [ih es e d (by simp only [List.length_cons] at hb; omega),
        ratOp_mul_ofGroup_right (RatU.ofGroup e⁻¹ * x) c, ratOp_ofGroup_inv_mul x e]
      simp only [mul_assoc]
      rw [ofGroup_mul_inv_cancel_mul]

/-- The evaluation `evalList` is invariant under the orbit relation `relNE`: two `X`-words that
differ by the `U`-action defining `relNE` have the same value in `Rat(U)`. -/
theorem evalList_relNE {U : Type} [Group U] {L L' : Work.ORHughesFree.Rat.FreeProduct.NEL (U := U)}
    (h : Work.ORHughesFree.Rat.FreeProduct.relNE L L') :
    Work.ORHughesFree.Rat.FreeProduct.evalList L.1
      = Work.ORHughesFree.Rat.FreeProduct.evalList L'.1 := by
  obtain ⟨b, hlen, hb⟩ := h
  rw [hb, evalList_shiftPad_eq L.1 b 1 1 hlen]
  simp

end Work.ORHughesFree.Rat.FreeProduct
