import Mathlib
import Submission.Work.ORHughesFree.SylvesterRank
import Submission.Work.ORHughesFree.RankAPI.rk_add_le

/-!
# The ideal of elements of rank zero

For a Sylvester matrix rank function `rk` on a ring `R`, the set of elements `b` whose
`1 × 1` matrix `oneByOne b` has rank `0` is an ideal: it is closed under `0`, addition
(by subadditivity of the rank, `RankAPI.rk_add_le`) and multiplication by scalars (by
`(SMat2)`, since `oneByOne (c * x) = oneByOne c * oneByOne x`). Consequently the ideal
generated by this set consists exactly of the elements of rank zero.
-/

namespace Work.ORHughesFree.Faithful

open Matrix

/-- `oneByOne` is additive. -/
private lemma oneByOne_add {R : Type*} [Add R] (a b : R) :
    oneByOne (a + b) = oneByOne a + oneByOne b := by
  ext i j; simp [oneByOne]

/-- `oneByOne` is multiplicative. -/
private lemma oneByOne_mul {R : Type*} [Semiring R] (a b : R) :
    oneByOne (a * b) = oneByOne a * oneByOne b := by
  ext i j
  simp [oneByOne, Matrix.mul_apply]

/-- `oneByOne` sends `0` to the zero matrix. -/
private lemma oneByOne_zero {R : Type*} [Zero R] :
    oneByOne (0 : R) = (0 : Matrix (Fin 1) (Fin 1) R) := by
  ext i j; simp [oneByOne]

/-- The ideal generated by the elements of rank zero is exactly the set of elements of rank
zero: the latter is an ideal. -/
theorem rankZeroIdeal_mem_iff {R : Type*} [Ring R] (rk : SylvesterRank R) (a : R) :
    a ∈ Ideal.span {b : R | rk.rk 1 1 (oneByOne b) = 0} ↔ rk.rk 1 1 (oneByOne a) = 0 := by
  set S : Set R := {b : R | rk.rk 1 1 (oneByOne b) = 0} with hS
  let K : Ideal R :=
    { carrier := S,
      zero_mem' := by
        rw [hS]
        show rk.rk 1 1 (oneByOne (0 : R)) = 0
        rw [oneByOne_zero, rk.rk_zero],
      add_mem' := by
        intro x y hx hy
        rw [hS] at hx hy ⊢
        change rk.rk 1 1 (oneByOne (x + y)) = 0
        rw [oneByOne_add]
        refine le_antisymm ?_ (rk.rk_nonneg 1 1 _)
        calc rk.rk 1 1 (oneByOne x + oneByOne y)
            ≤ rk.rk 1 1 (oneByOne x) + rk.rk 1 1 (oneByOne y) :=
              Work.ORHughesFree.RankAPI.rk_add_le rk _ _
          _ = 0 := by rw [hx, hy, add_zero],
      smul_mem' := by
        intro c x hx
        rw [hS] at hx ⊢
        change rk.rk 1 1 (oneByOne (c * x)) = 0
        rw [oneByOne_mul]
        refine le_antisymm ?_ (rk.rk_nonneg 1 1 _)
        calc rk.rk 1 1 (oneByOne c * oneByOne x)
            ≤ rk.rk 1 1 (oneByOne x) := rk.rk_mul_le_right _ _
          _ = 0 := hx }
  have hle : Ideal.span S ≤ K := Ideal.span_le.mpr (fun x hx => hx)
  constructor
  · intro ha
    have hmem : a ∈ K := hle ha
    simpa [K, hS] using hmem
  · intro ha
    exact Ideal.subset_span (show a ∈ S from by simpa [hS] using ha)

end Work.ORHughesFree.Faithful
