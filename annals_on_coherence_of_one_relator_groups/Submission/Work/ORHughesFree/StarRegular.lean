# ∗-regular rings and the ∗-regular closure

This file sets up von Neumann regular and ∗-regular rings, ∗-subrings, and the ∗-regular closure
of a ∗-subring, following [JZLA20, §2.1].

Main definitions:

* `IsVonNeumannRegular x` : `x` has a weak inverse;
* `VonNeumannRegularRing R` : every element of `R` has a weak inverse;
* `IsProperStar R` : the involution is proper, i.e. `x∗ * x = 0 → x = 0`;
* `IsStarRegular R` : `R` is von Neumann regular with a proper involution;
* `IsRelativeInverse x y` : `y` is the relative (Moore--Penrose) inverse of `x`;
* `IsProjection p` : `p` is a self-adjoint idempotent;
* `IsPositiveDefiniteStarRegular U` : `Mat n U` is ∗-regular for every `n`;
* `StarSubring U` : a ∗-subring of `U`;
* `starSubringClosure s` : the ∗-subring generated by `s`;
* `starRegularChain R`, `starRegularClosure R` : the ∗-regular closure of [JZLA20, Prop. 2.2].
-/
import Mathlib
import Submission.Work.ORHughesFree.SylvesterRank

set_option autoImplicit false

universe u

namespace Work.ORHughesFree

variable {R : Type u}

/-- An element `x` of a (multiplicative) semigroup is von Neumann regular if it has a weak
inverse. -/
def IsVonNeumannRegular [Mul R] (x : R) : Prop := ∃ y : R, x * y * x = x

/-- A ring in which every element has a weak inverse. -/
class VonNeumannRegularRing (R : Type u) [Mul R] : Prop where
  /-- Every element has a weak inverse. -/
  exists_mul_inverse : ∀ x : R, IsVonNeumannRegular x

/-- The involution `star` on `R` is *proper* if `x∗ * x = 0` implies `x = 0`. -/
def IsProperStar (R : Type u) [Mul R] [Star R] [Zero R] : Prop :=
  ∀ x : R, star x * x = 0 → x = 0

/-- A **∗-regular ring**: a von Neumann regular ring with a proper involution
([JZLA20, §2.1]). -/
class IsStarRegular (R : Type u) [Ring R] [StarRing R] : Prop where
  /-- The ring is von Neumann regular. -/
  vonNeumannRegular : VonNeumannRegularRing R
  /-- The involution is proper. -/
  proper : IsProperStar R

instance instVNR [Ring R] [StarRing R] [IsStarRegular R] : VonNeumannRegularRing R :=
  IsStarRegular.vonNeumannRegular

/-- A **projection** is a self-adjoint idempotent. -/
def IsProjection [Mul R] [Star R] (p : R) : Prop := star p = p ∧ p * p = p

theorem IsProjection.star [Mul R] [Star R] {p : R} (h : IsProjection p) : star p = p := h.1

theorem IsProjection.mul_self [Mul R] [Star R] {p : R} (h : IsProjection p) : p * p = p := h.2

/-- `y` is a **relative inverse** of `x`, i.e. the Moore--Penrose inverse of `x`
([JZLA20, §2.1]). -/
structure IsRelativeInverse [Mul R] [Star R] (x y : R) : Prop where
  /-- `x * y * x = x` -/
  left : x * y * x = x
  /-- `y * x * y = y` -/
  right : y * x * y = y
  /-- `x * y` is self-adjoint -/
  star_left : star (x * y) = x * y
  /-- `y * x` is self-adjoint -/
  star_right : star (y * x) = y * x

theorem IsRelativeInverse.isProjection_left [Semigroup R] [Star R] {x y : R}
    (h : IsRelativeInverse x y) : IsProjection (x * y) :=
  ⟨h.star_left, by
    calc (x * y) * (x * y) = (x * y * x) * y := (mul_assoc _ _ _).symm
      _ = x * y := by rw [h.left]⟩

theorem IsRelativeInverse.isProjection_right [Semigroup R] [Star R] {x y : R}
    (h : IsRelativeInverse x y) : IsProjection (y * x) :=
  ⟨h.star_right, by
    calc (y * x) * (y * x) = (y * x * y) * x := (mul_assoc _ _ _).symm
      _ = y * x := by rw [h.right]⟩

/-- A ring is **positive definite** if `Mat n U` is ∗-regular for every `n` ([JZLA20, §2.1]). -/
def IsPositiveDefiniteStarRegular (U : Type u) [Ring U] [StarRing U] : Prop :=
  ∀ n : ℕ, IsStarRegular (Matrix (Fin n) (Fin n) U)

/-! ### ∗-subrings and the ∗-regular closure -/

section Closure

variable {U : Type u} [Ring U] [StarRing U]

/-- A **∗-subring** of a ∗-ring `U`. -/
structure StarSubring (U : Type u) [Ring U] [StarRing U] where
  /-- The underlying subring. -/
  toSubring : Subring U
  /-- The ∗-subring is closed under `star`. -/
  star_mem' : ∀ {x : U}, x ∈ toSubring → star x ∈ toSubring

attribute [coe] StarSubring.toSubring

instance : SetLike (StarSubring U) U where
  coe s := s.toSubring
  coe_injective := by
    rintro ⟨a, ha⟩ ⟨b, hb⟩ h
    have hab : a = b := SetLike.ext fun x => Set.ext_iff.mp h x
    subst hab
    rfl

instance (s : StarSubring U) : Ring s := inferInstanceAs (Ring s.toSubring)

instance (s : StarSubring U) : StarRing s where
  star x := ⟨star x.1, s.star_mem' x.2⟩
  star_involutive x := by ext; simp
  star_mul x y := by
    ext
    change star ((x : U) * (y : U)) = star (y : U) * star (x : U)
    rw [star_mul]
  star_add x y := by
    ext
    change star ((x : U) + (y : U)) = star (x : U) + star (y : U)
    rw [star_add]

theorem mem_starSubring_iff {s : StarSubring U} {x : U} : x ∈ s ↔ x ∈ s.toSubring :=
  Iff.rfl

/-- The ∗-subring generated by a set is closed under `star`. -/
theorem star_mem_closure {s : Set U} {x : U} (hx : x ∈ Subring.closure (s ∪ star '' s)) :
    star x ∈ Subring.closure (s ∪ star '' s) := by
  let T : Subring U :=
    { carrier := {z : U | star z ∈ Subring.closure (s ∪ star '' s)}
      zero_mem' := by
        simp only [Set.mem_ofPred_eq, star_zero]
        exact Subring.zero_mem _
      one_mem' := by
        simp only [Set.mem_ofPred_eq, star_one]
        exact Subring.one_mem _
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq, star_add]
        exact Subring.add_mem _ ha hb
      neg_mem' := by
        intro a ha
        simp only [Set.mem_ofPred_eq, star_neg]
        exact Subring.neg_mem _ ha
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq, star_mul]
        exact Subring.mul_mem _ hb ha }
  have hT : ((s ∪ star '' s) : Set U) ⊆ (T : Set U) := by
    intro x hx
    rcases hx with hx | ⟨y, hy, rfl⟩
    · exact Subring.subset_closure (Or.inr ⟨x, hx, rfl⟩)
    · change star (star y) ∈ Subring.closure (s ∪ star '' s)
      rw [star_star]
      exact Subring.subset_closure (Or.inl hy)
  exact Subring.closure_le.mpr hT hx

/-- The ∗-subring generated by a set. -/
noncomputable def starSubringClosure (s : Set U) : StarSubring U :=
  ⟨Subring.closure (s ∪ star '' s), fun hx => star_mem_closure hx⟩

theorem subset_starSubringClosure (s : Set U) : s ⊆ (starSubringClosure s : Set U) :=
  fun _ hx => Subring.subset_closure (Or.inl hx)

theorem starSubringClosure_le {s : Set U} {T : StarSubring U} (h : s ⊆ (T : Set U)) :
    (starSubringClosure s : Set U) ⊆ (T : Set U) := by
  refine Subring.closure_le.mpr ?_
  intro x hx
  rcases hx with hx | ⟨y, hy, rfl⟩
  · exact h hx
  · exact T.star_mem' (h hy)

/-- The set of relative inverses of the elements of a set. -/
def relativeInverses (s : Set U) : Set U := {y | ∃ x ∈ s, IsRelativeInverse x y}

/-- The approximating chain `R₀ ⊆ R₁ ⊆ ⋯` of [JZLA20, Proposition 2.2]. -/
noncomputable def starRegularChain (R : StarSubring U) : ℕ → StarSubring U
  | 0 => R
  | n + 1 => starSubringClosure ((starRegularChain R n : Set U) ∪
      relativeInverses ((starRegularChain R n : Set U)))

/-- The **∗-regular closure** of a ∗-subring `R` of `U`: the smallest ∗-regular ∗-subring of `U`
containing `R` ([JZLA20, Proposition 2.2]). -/
noncomputable def starRegularClosure (R : StarSubring U) : StarSubring U :=
  starSubringClosure (⋃ n, (starRegularChain R n : Set U))

theorem subset_starRegularClosure (R : StarSubring U) :
    (R : Set U) ⊆ (starRegularClosure R : Set U) :=
  fun _ hx => subset_starSubringClosure _ (Set.mem_iUnion_of_mem 0 hx)

end Closure

end Work.ORHughesFree
