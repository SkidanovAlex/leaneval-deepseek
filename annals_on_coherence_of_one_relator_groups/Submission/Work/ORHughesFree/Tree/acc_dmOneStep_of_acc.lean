import Mathlib
import Submission.Work.ORHughesFree.Tree.order_defs

/-!
# Accessible multisets for the Dershowitz–Manna one-step relation

The Dershowitz–Manna multiset ordering is generated by the one-step relation `dmOneStep lt`, which
replaces a multiset `Y` of children by a single strictly larger element `a` (`lt y a` for every
`y ∈ Y`).  Following the standard well-foundedness argument for the multiset ordering (see
`Mathlib.Data.Multiset.DershowitzManna`), we prove here that a multiset all of whose elements are
accessible for `lt` is accessible for `dmOneStep lt`.
-/

namespace Work.ORHughesFree.Tree

open Multiset

/-- Analogue of the `DershowitzManna` "singleton insert" decomposition: if `N` takes a one-step
`dmOneStep` to `a ::ₘ M`, then either `N = a ::ₘ M'` with `M'` taking a one-step to `M`, or
`N = M + M'` where every element of `M'` is `lt`-below `a`. -/
private lemma dmOneStep_singleton_insert {a : Tree} {M N : Multiset Tree}
    (h : dmOneStep lt N (a ::ₘ M)) :
    ∃ M', (N = a ::ₘ M' ∧ dmOneStep lt M' M) ∨ (N = M + M' ∧ ∀ x ∈ M', lt x a) := by
  classical
  obtain ⟨X, Y, b, rfl, h0, h2⟩ := h
  obtain rfl | hab := eq_or_ne a b
  · refine ⟨Y, .inr ⟨?_, h2⟩⟩
    simpa [add_comm _ {a}, singleton_add, eq_comm] using h0
  refine ⟨Y + (M - {b}), .inl ⟨?_, M - {b}, Y, b, add_comm .., ?_, h2⟩⟩
  · rw [← singleton_add, add_comm] at h0
    rw [tsub_eq_tsub_of_add_eq_add h0, add_comm Y, ← singleton_add, ← add_assoc,
      add_tsub_cancel_of_le]
    have : a ∈ X + {b} := by simp [← h0]
    simpa [hab] using this
  · rw [tsub_add_cancel_of_le]
    have : b ∈ a ::ₘ M := by simp [h0]
    simpa [hab.symm] using this

/-- Prepending an element `a` that is accessible for `lt` to a multiset that is accessible for
`dmOneStep lt` yields an accessible multiset. -/
private lemma acc_dmOneStep_cons_of_acc_lt {a : Tree} (ha : Acc lt a) :
    ∀ {M}, Acc (dmOneStep lt) M → Acc (dmOneStep lt) (a ::ₘ M) := by
  induction ha with
  | _ a ha ih =>
    rintro M hM
    induction hM with
    | _ M hM ihM =>
      refine .intro _ fun N hNM ↦ ?_
      obtain ⟨N, ⟨rfl, hNM'⟩ | ⟨rfl, hN⟩⟩ := dmOneStep_singleton_insert hNM
      · exact ihM _ hNM'
      clear hNM
      induction N using Multiset.induction with
      | empty =>
        simpa using .intro _ hM
      | @cons b N ihN =>
        simp only [mem_cons, forall_eq_or_imp, add_cons] at hN ⊢
        obtain ⟨hba, hN⟩ := hN
        exact ih _ hba <| ihN hN

/-- If every element of a multiset `M` is accessible for the tree order `lt`, then `M` is
accessible for the Dershowitz–Manna one-step relation `dmOneStep lt`. -/
theorem acc_dmOneStep_of_acc {M : Multiset Tree} (hM : ∀ x ∈ M, Acc lt x) :
    Acc (dmOneStep lt) M := by
  induction M using Multiset.induction_on with
  | empty =>
    constructor
    simp [dmOneStep, eq_comm (b := _ + _)]
  | cons a M ih =>
    exact acc_dmOneStep_cons_of_acc_lt (hM _ <| mem_cons_self ..) <| ih fun x hx =>
      hM _ <| mem_cons_of_mem hx

end Work.ORHughesFree.Tree
