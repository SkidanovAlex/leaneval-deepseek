import Mathlib
import Submission.Work.ORHughesFree.Tree
import Submission.Work.ORHughesFree.Tree.fam_exp
import Submission.Work.ORHughesFree.Tree.mul_comm

/-!
# `PermRel` from equality of the multisets of isomorphism classes

`Iso`/`PermRel` are the mutually defined relations of isomorphism of raw trees `MTree` and of
equality of the multisets of pairwise isomorphic trees on lists.  The forward direction, that
`PermRel l l'` forces the multisets of quotient classes `Quotient.mk'' '' l` and
`Quotient.mk'' '' l'` to coincide, is `PermRel.multiset_map_mk` (in `Tree/fam_exp.lean`).

Here we prove the converse: if the two lists of raw trees have the same multiset of images under
`Quotient.mk'' : MTree → Tree`, then they are `PermRel`-equivalent.  The proof is by induction on
one of the lists: a head `mk x` of the left image occurs in the right image, so it is the image of
some entry `y` of `l'`; removing that entry (which is where `List.mem_iff_append` is used instead
of `List.erase`) turns the hypothesis into the induction hypothesis, and the two lists are glued
back together by `PermRel.cons` (with `Iso x y`) and the `PermRel`-analogue of the elementary
permutation `y :: s ++ t ~ s ++ y :: t` (`List.perm_middle`).
-/

namespace Work.ORHughesFree.Tree

open Work.ORHughesFree

/-- A permutation of a list of raw trees is a `PermRel`-equivalence: `List.Perm` is generated by
adjacent transpositions, and each of those is a `PermRel.swap` (the `cons` case transports a
`List.Perm.cons` to a `PermRel.cons` along `Iso.refl`). -/
theorem PermRel_of_perm {l l' : List MTree} (h : l.Perm l') : PermRel l l' := by
  refine List.Perm.rec (motive := fun a b _ => PermRel a b) ?_ ?_ ?_ ?_ h
  · exact PermRel.nil
  · intro x l₁ l₂ _ ih
    exact PermRel.cons (Iso.refl x) ih
  · intro x y l
    exact PermRel.symm (PermRel.swap x y l)
  · intro l₁ l₂ l₃ hp hp' ih1 ih2
    exact PermRel.trans ih1 ih2

theorem PermRel_of_multiset_map_mk {l l' : List Work.ORHughesFree.MTree}
    (h : Multiset.ofList (l.map (fun a => (Quotient.mk'' a : Work.ORHughesFree.Tree))) =
        Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Work.ORHughesFree.Tree)))) :
    Work.ORHughesFree.PermRel l l' := by
  classical
  induction l generalizing l' with
  | nil =>
    have hnil : (Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Tree)))) = 0 := by
      rw [← h]; simp
    obtain rfl : l' = [] := List.map_eq_nil_iff.mp (Multiset.coe_eq_zero _ |>.mp hnil)
    exact PermRel.nil
  | cons x l ih =>
    -- Peel off the head of the left-hand image multiset.
    have hcons : (Quotient.mk'' x : Tree) ::ₘ
        Multiset.ofList (l.map (fun a => (Quotient.mk'' a : Tree))) =
        Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Tree))) := by
      simpa using h
    -- It occurs on the right, hence is the image of an entry `y` of `l'` with `Iso x y`.
    have hx : (Quotient.mk'' x : Tree) ∈
        Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Tree))) := by
      rw [← hcons]; exact Multiset.mem_cons_self _ _
    rw [← Multiset.map_coe] at hx
    obtain ⟨y, hy, hyx⟩ := Multiset.mem_map.mp hx
    rw [Multiset.mem_coe] at hy
    -- Split `l'` at that entry.
    obtain ⟨s, t, hst⟩ := List.mem_iff_append.mp hy
    have hsplit : Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Tree))) =
        (Quotient.mk'' y : Tree) ::ₘ
          Multiset.ofList ((s ++ t).map (fun a => (Quotient.mk'' a : Tree))) := by
      rw [hst, Multiset.cons_coe, Multiset.coe_eq_coe]
      simpa only [List.map_append, List.map_cons] using
        (List.perm_middle (l₁ := List.map (fun a => (Quotient.mk'' a : Tree)) s)
        (l₂ := List.map (fun a => (Quotient.mk'' a : Tree)) t)
        (a := (Quotient.mk'' y : Tree)))
    -- Cancel the common head `mk x = mk y` and apply the induction hypothesis to the tails.
    have hcancel : Multiset.ofList (l.map (fun a => (Quotient.mk'' a : Tree))) =
        Multiset.ofList ((s ++ t).map (fun a => (Quotient.mk'' a : Tree))) := by
      rw [hsplit, ← hyx] at hcons
      exact (Multiset.cons_inj_right _).mp hcons
    have ih' := ih hcancel
    refine PermRel.trans (PermRel.cons (Quotient.exact hyx.symm) ih') ?_
    rw [hst]
    exact PermRel_of_perm (List.perm_middle (l₁ := s) (l₂ := t) (a := y)).symm

end Work.ORHughesFree.Tree
