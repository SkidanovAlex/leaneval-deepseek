import Mathlib
import Submission.Work.ORHughesFree.Tree

namespace Work.ORHughesFree

/-- If two lists of raw trees are `PermRel`-equivalent, then they give the same multiset of
`Tree`s after passing to the quotient.  This is the observation that `PermRel` is generated by
permuting the list and replacing entries by `Iso`-equivalent ones, and `Quotient.mk''` is
invariant under `Iso`. -/
theorem PermRel.multiset_map_mk (l l' : List MTree) (h : PermRel l l') :
    Multiset.ofList (l.map (fun a => (Quotient.mk'' a : Tree))) =
    Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Tree))) := by
  refine PermRel.rec
    (motive_1 := fun a a' _ => (Quotient.mk'' a : Tree) = Quotient.mk'' a')
    (motive_2 := fun l l' _ => Multiset.ofList (l.map (fun a => (Quotient.mk'' a : Tree))) =
      Multiset.ofList (l'.map (fun a => (Quotient.mk'' a : Tree)))) ?_ ?_ ?_ ?_ ?_ ?_ ?_ h
  · intro l l' a _
    exact Quotient.sound (Iso.node a)
  · rfl
  · intro x y l l' a a1 hxy hih
    simp only [List.map_cons]
    rw [← Multiset.cons_coe, ← Multiset.cons_coe, hxy, hih]
  · intro x y l
    simp only [List.map_cons]
    rw [← Multiset.cons_coe, ← Multiset.cons_coe, ← Multiset.cons_coe, ← Multiset.cons_coe,
      Multiset.cons_swap]
  · intro l; rfl
  · intro l l' a ih; exact ih.symm
  · intro l l' l'' a a1 ih1 ih2; exact ih1.trans ih2

end Work.ORHughesFree

namespace Work.ORHughesFree.Tree

theorem fam_exp (x : Tree) : fam (exp x) = {x} := by
  -- `Quotient.out (exp x)` is a representative of the class of `MTree.node [Quotient.out x]`.
  have hIso : Iso (Quotient.out (exp x)) (MTree.node [Quotient.out x]) :=
    Quotient.exact (show (⟦Quotient.out (exp x)⟧ : Quotient isoSetoid) =
        ⟦MTree.node [Quotient.out x]⟧ from by
      rw [show (⟦Quotient.out (exp x)⟧ : Quotient isoSetoid) = exp x from Quotient.out_eq (exp x)]
      rfl)
  -- Hence its children are `PermRel`-equivalent to the singleton list `[Quotient.out x]`.
  have hperm : PermRel (MTree.children (Quotient.out (exp x))) [Quotient.out x] := by
    simpa [MTree.children] using PermRel.of_iso_children hIso
  have h := PermRel.multiset_map_mk (MTree.children (Quotient.out (exp x))) [Quotient.out x] hperm
  change Multiset.ofList ((MTree.children (Quotient.out (exp x))).map
    (fun a => (Quotient.mk'' a : Tree))) = {x}
  rw [h]
  simp only [List.map_cons, List.map_nil, Multiset.coe_singleton]
  congr 1
  exact Quotient.out_eq' x

end Work.ORHughesFree.Tree
