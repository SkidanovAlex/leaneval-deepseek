namespace Work.ORHughesFree.StarRegular

open Work.ORHughesFree

/-!
## The ring-theoretic core: existence of relative inverses

In a ring that is von Neumann regular with a proper involution, every element has a
Moore--Penrose (relative) inverse `x^{[-1]}` with `x x^{[-1]} x = x`, `x^{[-1]} x x^{[-1]} = x^{[-1]}`
and `x x^{[-1]}`, `x^{[-1]} x` self-adjoint idempotents ([JZLA20, §2.1], quoting
[Ja17base, Proposition 3.2]).

The proof is elementary but not trivial, and we record it in full:
* `aR ⊆ bR` is detected by the *left* annihilator of `b` contained in that of `a`
  (`range_le_iff_leftAnn`);
* consequently `xR = x x^* R` (`mul_range_le_mul_star_range`), using properness of `*`;
* for a self-adjoint `s` this gives `sR = s²R`, whence `R = sR ⊕ r.ann s` and the
  projection onto `sR` generates it (`exists_projection_range_mul_self`);
* so every principal right ideal is generated by a projection, and the two-sided
  construction below produces the relative inverse.
-/

section Core

variable {R : Type*} [Ring R] [StarRing R]

/-- Right-handed form of a proper involution: `x * x^* = 0 → x = 0`. -/
theorem mul_star_self_eq_zero (hp : IsProperStar R) {x : R} (h : x * star x = 0) : x = 0 := by
  have h1 : star (star x) * star x = 0 := by simpa using h
  have h2 : star x = 0 := hp (star x) h1
  simpa using congrArg star h2

/-- For a von Neumann regular ring, the principal right ideal generated by `a` is contained in
that generated by `b` if and only if the left annihilator of `b` is contained in that of `a`. -/
theorem range_le_iff_leftAnn [VonNeumannRegularRing R] (a b : R) :
    (∀ t : R, (∃ r : R, a * r = t) → ∃ s : R, b * s = t) ↔
      (∀ w : R, w * b = 0 → w * a = 0) := by
  constructor
  · intro h w hw
    obtain ⟨s, hs⟩ := h a ⟨1, mul_one a⟩
    rw [← hs, ← mul_assoc, hw, zero_mul]
  · intro h t ht
    obtain ⟨r, rfl⟩ := ht
    obtain ⟨d, hd⟩ := (inferInstance : VonNeumannRegularRing R).exists_mul_inverse b
    have h1 : (1 - b * d) * b = 0 := by rw [sub_mul, one_mul, hd, sub_self]
    have h2 : (1 - b * d) * a = 0 := h (1 - b * d) h1
    have ha : a = b * d * a := by
      rw [sub_mul, one_mul] at h2
      exact sub_eq_zero.mp h2
    refine ⟨d * (a * r), ?_⟩
    calc b * (d * (a * r)) = (b * d * a) * r := by simp only [mul_assoc]
      _ = a * r := by rw [← ha]

/-- In a von Neumann regular ring with proper involution, `xR ⊆ x x^* R`. -/
theorem mul_range_le_mul_star_range [VonNeumannRegularRing R] (hp : IsProperStar R) (x : R) :
    ∀ t : R, (∃ r : R, x * r = t) → ∃ s : R, x * star x * s = t := by
  rw [range_le_iff_leftAnn]
  intro w hw
  apply mul_star_self_eq_zero hp
  have h : (w * x) * star (w * x) = (w * (x * star x)) * star w := by
    rw [star_mul]; simp only [mul_assoc]
  rw [h, hw, zero_mul]

/-- If `s` is self-adjoint, then `sR` is generated by a projection: `p = s r₀` where
`s² r₀ = s`. -/
theorem exists_projection_range_mul_self [VonNeumannRegularRing R] (hp : IsProperStar R)
    {s : R} (hs : star s = s) :
    ∃ p : R, star p = p ∧ p * p = p ∧
      (∀ t : R, (∃ r : R, s * r = t) ↔ (∃ r : R, p * r = t)) := by
  obtain ⟨r0, hr0⟩ := mul_range_le_mul_star_range hp s s ⟨1, mul_one s⟩
  have hs2 : s * s * r0 = s := by simpa [hs] using hr0
  have hstar : star r0 * (s * s) = s := by
    have := congrArg star hs2
    simpa [star_mul, hs] using this
  have hrs : s * r0 * s = s := by
    calc s * r0 * s = (star r0 * (s * s)) * r0 * s := by rw [hstar]
      _ = star r0 * ((s * s) * r0) * s := by simp only [mul_assoc]
      _ = star r0 * s * s := by rw [hs2]
      _ = star r0 * (s * s) := by simp only [mul_assoc]
      _ = s := hstar
  refine ⟨s * r0, ?_, ?_, ?_⟩
  · rw [star_mul, hs]
    calc star r0 * s = star r0 * (s * s * r0) := by rw [hs2]
      _ = (star r0 * (s * s)) * r0 := by simp only [mul_assoc]
      _ = s * r0 := by rw [hstar]
  · rw [show (s * r0) * (s * r0) = (s * r0 * s) * r0 from by simp only [mul_assoc], hrs]
  · intro t
    constructor
    · rintro ⟨r, hr⟩
      refine ⟨s * r, ?_⟩
      rw [← hr, show (s * r0) * (s * r) = (s * r0 * s) * r from by simp only [mul_assoc],
        hrs]
    · rintro ⟨r, hr⟩
      exact ⟨r0 * r, by rw [← hr, mul_assoc]⟩

/-- Every principal right ideal of a von Neumann regular ring with proper involution is generated
by a projection. -/
theorem exists_projection_range [VonNeumannRegularRing R] (hp : IsProperStar R) (x : R) :
    ∃ p : R, star p = p ∧ p * p = p ∧
      (∀ t : R, (∃ r : R, x * r = t) ↔ (∃ r : R, p * r = t)) := by
  have hs : star (x * star x) = x * star x := by rw [star_mul, star_star]
  obtain ⟨p, hp1, hp2, hpR⟩ := exists_projection_range_mul_self hp hs
  refine ⟨p, hp1, hp2, ?_⟩
  intro t
  constructor
  · intro ht
    exact (hpR t).mp (mul_range_le_mul_star_range hp x t ht)
  · intro ht
    obtain ⟨r, hr⟩ := (hpR t).mpr ht
    exact ⟨star x * r, by rw [← hr, mul_assoc]⟩

/-- Starring a `pR = aR` statement turns it into an `Rp = R (star a)` statement. -/
theorem left_range_of_right_range {a b : R} (hb : star b = b)
    (h : ∀ t : R, (∃ r : R, a * r = t) ↔ (∃ r : R, b * r = t)) :
    ∀ t : R, (∃ r : R, r * star a = t) ↔ (∃ r : R, r * b = t) := by
  intro t
  have h1 : (∃ r : R, a * r = star t) ↔ (∃ r : R, b * r = star t) := h (star t)
  constructor
  · rintro ⟨r, hr⟩
    have hr' : a * star r = star t := by rw [← hr, star_mul, star_star]
    obtain ⟨s, hs⟩ := h1.mp ⟨star r, hr'⟩
    refine ⟨star s, ?_⟩
    have := congrArg star hs
    simp only [star_mul, star_star] at this
    rwa [hb] at this
  · rintro ⟨r, hr⟩
    have hr' : b * star r = star t := by rw [← hr, star_mul, hb]
    obtain ⟨s, hs⟩ := h1.mpr ⟨star r, hr'⟩
    refine ⟨star s, ?_⟩
    have := congrArg star hs
    simp only [star_mul, star_star] at this
    exact this

/-- **Existence of relative inverses.** In a von Neumann regular ring with proper involution
every element has a Moore--Penrose inverse ([Ja17base, Proposition 3.2]). -/
theorem exists_relativeInverse [VonNeumannRegularRing R] (hp : IsProperStar R) (x : R) :
    ∃ y : R, IsRelativeInverse x y := by
  obtain ⟨p, hps, hpp, hpR⟩ := exists_projection_range hp x
  obtain ⟨b, hb⟩ := (hpR p).mpr ⟨1, mul_one p⟩
  have hpx : p * x = x := by
    obtain ⟨f, hf⟩ := (hpR x).mp ⟨1, mul_one x⟩
    rw [← hf, ← mul_assoc, hpp]
  obtain ⟨q, hqs, hqq, hqR⟩ := exists_projection_range hp (star x)
  have hleft : ∀ t : R, (∃ r : R, r * x = t) ↔ (∃ r : R, r * q = t) := by
    have := left_range_of_right_range hqs hqR
    simpa using this
  obtain ⟨c, hc⟩ := (hleft q).mpr ⟨1, one_mul q⟩
  have hxq : x * q = x := by
    obtain ⟨f, hf⟩ := (hleft x).mp ⟨1, one_mul x⟩
    rw [← hf, mul_assoc, hqq]
  have h1 : x * (c * x * b) = p := by
    rw [hc, ← mul_assoc x q b, hxq, hb]
  have hx_bx : x * b * x = x := by rw [hb, hpx]
  have h2 : c * x * b * x = q := by
    rw [show c * x * b * x = c * (x * b * x) from by simp only [mul_assoc], hx_bx, hc]
  refine ⟨c * x * b, ?_, ?_, ?_, ?_⟩
  · show x * (c * x * b) * x = x
    rw [h1, hpx]
  · show c * x * b * x * (c * x * b) = c * x * b
    rw [h2, show c * x * b = q * b from by rw [hc],
      show q * (q * b) = q * b from by rw [← mul_assoc, hqq]]
  · show star (x * (c * x * b)) = x * (c * x * b)
    rw [h1, hps]
  · show star (c * x * b * x) = c * x * b * x
    rw [h2, hqs]

end Core

/-!
## The `∗`-regular closure
-/

section Closure

variable {U : Type*} [Ring U] [StarRing U]

/-- The `∗`-regular closure of a `∗`-subring of a `∗`-regular ring is `∗`-regular
([JZLA20, Proposition 2.2]).

The closure is the union of the increasing chain `R₀ ⊆ R₁ ⊆ ⋯`; each `Rₙ₊₁` contains the relative
inverses of the elements of `Rₙ`, so every element of the closure acquires a weak inverse one step
further up the chain. The involution is proper because it restricts from `U`. -/
theorem starRegularClosure_isStarRegular_of (R : StarSubring U) (hU : IsProperStar U)
    (hB : ∀ x : U, ∃ y : U, IsRelativeInverse x y) :
    IsStarRegular (starRegularClosure R) where
  vonNeumannRegular := ⟨fun x => by
    obtain ⟨n, hn⟩ := (mem_starRegularClosure_iff R (x : U)).mp x.2
    obtain ⟨y, hy⟩ := hB (x : U)
    have hymem : y ∈ (starRegularClosure R : Set U) :=
      (mem_starRegularClosure_iff R y).mpr
        ⟨n + 1, subset_starSubringClosure _ (Or.inr ⟨(x : U), hn, hy⟩)⟩
    refine ⟨⟨y, hymem⟩, ?_⟩
    apply Subtype.ext
    show (x : U) * y * (x : U) = (x : U)
    exact hy.left⟩
  proper := isProperStar_starSubring hU (starRegularClosure R)

end Closure

theorem starRegularClosure_isStarRegular {U : Type*} [Ring U] [StarRing U] [IsStarRegular U]
    (R : StarSubring U) : IsStarRegular (starRegularClosure R) :=
  starRegularClosure_isStarRegular_of R (inferInstance : IsStarRegular U).proper
    (fun x => exists_relativeInverse (inferInstance : IsStarRegular U).proper x)

end Work.ORHughesFree.StarRegular
