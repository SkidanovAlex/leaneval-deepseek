import Mathlib
import Submission.Work.ORHughesFree.StarRegular

namespace Work.ORHughesFree.StarRegular

/-- Each stage of the approximating chain embeds in the next:
`starRegularChain R n ⊆ starRegularChain R (n+1)`.

This is immediate from the definition, since `starRegularChain R (n+1)` is the ∗-subring
generated by `starRegularChain R n` together with its relative inverses. -/
theorem starRegularChain_succ {U : Type*} [Ring U] [StarRing U] (R : StarSubring U) (n : ℕ) :
    (starRegularChain R n : Set U) ⊆ (starRegularChain R (n + 1) : Set U) := by
  intro x hx
  rw [starRegularChain]
  exact subset_starSubringClosure _ (Set.mem_union_left _ hx)

end Work.ORHughesFree.StarRegular
