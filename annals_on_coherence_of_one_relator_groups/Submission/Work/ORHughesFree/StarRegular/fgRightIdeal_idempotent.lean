/-
# Finitely generated right ideals of a von Neumann regular ring

We show that in a von Neumann regular ring `S`, every finitely generated right ideal is
generated by an idempotent.  Concretely, for `a : Fin k → S` there is an idempotent `g` with
`∑ i, a i * S = g * S`.

Right ideals of `S` are modelled as left `Sᵐᵒᵖ`-submodules of `S`; the right ideal generated by
`a : Fin k → S` is `Submodule.span Sᵐᵒᵖ (Set.range a)` and the principal right ideal generated by
`g` is `Submodule.span Sᵐᵒᵖ {g}` (equivalently `Sᵐᵒᵖ ∙ g`).
-/
import Mathlib
import Submission.Work.ORHughesFree.StarRegular

set_option autoImplicit false

namespace Work.ORHughesFree.StarRegular

open Work.ORHughesFree

variable {S : Type*}

/-- Membership in the right ideal generated by `a : Fin k → S` is the same as being a right
linear combination of the `a i`. -/
theorem mem_span_range_iff_exists_mul [Ring S] {k : ℕ} (a : Fin k → S) (x : S) :
    x ∈ Submodule.span Sᵐᵒᵖ (Set.range a) ↔ ∃ c : Fin k → S, x = ∑ i, a i * c i := by
  constructor
  · intro hx
    refine Submodule.span_induction (p := fun x _ => ∃ c : Fin k → S, x = ∑ i, a i * c i)
      ?_ ?_ ?_ ?_ hx
    · rintro y ⟨i, rfl⟩
      refine ⟨Pi.single i 1, ?_⟩
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hj; simp [Pi.single_eq_of_ne hj]
      · intro hi; exact absurd (Finset.mem_univ i) hi
    · exact ⟨0, by simp⟩
    · rintro x y _ _ ⟨c1, rfl⟩ ⟨c2, rfl⟩
      exact ⟨c1 + c2, by simp [Finset.sum_add_distrib, mul_add]⟩
    · rintro s x _ ⟨c, rfl⟩
      refine ⟨fun i => c i * MulOpposite.unop s, ?_⟩
      simp only [MulOpposite.smul_eq_mul_unop, Finset.sum_mul, mul_assoc]
  · rintro ⟨c, rfl⟩
    apply Submodule.sum_mem
    intro i _
    have : a i * c i = MulOpposite.op (c i) • a i := by simp [MulOpposite.smul_eq_mul_unop]
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- **Every finitely generated right ideal of a von Neumann regular ring is generated by an
idempotent.** -/
theorem exists_idempotent_span_range [Ring S] [VonNeumannRegularRing S] :
    ∀ (k : ℕ) (a : Fin k → S), ∃ g : S, g * g = g ∧
      Submodule.span Sᵐᵒᵖ (Set.range a) = Submodule.span Sᵐᵒᵖ ({g} : Set S) := by
  intro k
  induction k with
  | zero =>
    intro a
    refine ⟨0, by simp, ?_⟩
    have h : Set.range a = ∅ := by
      ext x; simp only [Set.mem_range, Set.mem_empty_iff_false, iff_false, not_exists]
      exact fun i => Fin.elim0 i
    rw [h, Submodule.span_empty]
    rw [eq_comm, Submodule.span_eq_bot]
    intro z hz; rw [Set.mem_singleton_iff] at hz; exact hz
  | succ k ih =>
    intro a
    obtain ⟨g₀, hg₀, hspan0⟩ := ih (fun i : Fin k => a i.succ)
    have hgw : g₀ * ((1 - g₀) * a 0) = 0 := by
      calc g₀ * ((1 - g₀) * a 0) = g₀ * (1 - g₀) * a 0 := by noncomm_ring
        _ = 0 := by rw [mul_sub, mul_one, hg₀, sub_self, zero_mul]
    obtain ⟨y, hy⟩ :=
      (inferInstance : VonNeumannRegularRing S).exists_mul_inverse ((1 - g₀) * a 0)
    obtain ⟨g₁, hg1eq, hg₁⟩ : ∃ g : S, g = ((1 - g₀) * a 0) * y ∧ g * g = g := by
      refine ⟨_, rfl, ?_⟩
      calc (((1 - g₀) * a 0) * y) * (((1 - g₀) * a 0) * y)
          = (((1 - g₀) * a 0) * y * ((1 - g₀) * a 0)) * y := by noncomm_ring
        _ = ((1 - g₀) * a 0) * y := by rw [hy]
    have hspan1 : Submodule.span Sᵐᵒᵖ ({(1 - g₀) * a 0} : Set S) = Sᵐᵒᵖ ∙ g₁ := by
      refine le_antisymm ?_ ?_
      · rw [Submodule.span_le]
        intro z hz; rw [Set.mem_singleton_iff] at hz; rw [hz]
        refine Submodule.mem_span_singleton.mpr ⟨MulOpposite.op ((1 - g₀) * a 0), ?_⟩
        rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
        calc g₁ * ((1 - g₀) * a 0) = (((1 - g₀) * a 0) * y) * ((1 - g₀) * a 0) := by rw [hg1eq]
          _ = (1 - g₀) * a 0 := hy
      · rw [Submodule.span_le]
        intro z hz; rw [Set.mem_singleton_iff] at hz; rw [hz]
        exact Submodule.mem_span_singleton.mpr ⟨MulOpposite.op y, by
          rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op, hg1eq]⟩
    have hg0g1 : g₀ * g₁ = 0 := by
      rw [hg1eq]
      calc g₀ * (((1 - g₀) * a 0) * y) = g₀ * ((1 - g₀) * a 0) * y := by noncomm_ring
        _ = 0 := by rw [hgw, zero_mul]
    have hu0 : (g₀ + g₁ - g₁ * g₀) * g₀ = g₀ := by
      calc (g₀ + g₁ - g₁ * g₀) * g₀ = g₀ * g₀ + g₁ * g₀ - g₁ * (g₀ * g₀) := by noncomm_ring
        _ = g₀ := by rw [hg₀]; abel
    have hu1 : (g₀ + g₁ - g₁ * g₀) * g₁ = g₁ := by
      calc (g₀ + g₁ - g₁ * g₀) * g₁ = g₀ * g₁ + g₁ * g₁ - g₁ * (g₀ * g₁) := by noncomm_ring
        _ = g₁ := by rw [hg0g1, mul_zero, hg₁]; abel
    have hu2 : (g₀ + g₁ - g₁ * g₀) * (g₀ + g₁ - g₁ * g₀) = g₀ + g₁ - g₁ * g₀ := by
      calc (g₀ + g₁ - g₁ * g₀) * (g₀ + g₁ - g₁ * g₀)
          = (g₀ + g₁ - g₁ * g₀) * g₀ + (g₀ + g₁ - g₁ * g₀) * g₁
              - (g₀ + g₁ - g₁ * g₀) * (g₁ * g₀) := by noncomm_ring
        _ = g₀ + g₁ - g₁ * g₀ := by rw [hu0, hu1, ← mul_assoc, hu1]
    have hsup : Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ g₁ = Sᵐᵒᵖ ∙ (g₀ + g₁ - g₁ * g₀) := by
      refine le_antisymm ?_ ?_
      · rw [sup_le_iff]
        constructor
        · rw [Submodule.span_le]
          intro z hz; rw [Set.mem_singleton_iff] at hz; rw [hz]
          exact Submodule.mem_span_singleton.mpr ⟨MulOpposite.op g₀, by
            rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]; exact hu0⟩
        · rw [Submodule.span_le]
          intro z hz; rw [Set.mem_singleton_iff] at hz; rw [hz]
          exact Submodule.mem_span_singleton.mpr ⟨MulOpposite.op g₁, by
            rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]; exact hu1⟩
      · rw [Submodule.span_le]
        intro z hz; rw [Set.mem_singleton_iff] at hz; rw [hz]
        apply Submodule.mem_sup.mpr
        refine ⟨g₀, Submodule.mem_span_singleton.mpr ⟨1, by simp⟩, g₁ - g₁ * g₀, ?_, ?_⟩
        · apply Submodule.sub_mem
          · exact Submodule.mem_span_singleton.mpr ⟨1, by simp⟩
          · exact Submodule.mem_span_singleton.mpr ⟨MulOpposite.op g₀, by
              rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]⟩
        · abel
    have hb : a 0 = g₀ * (a 0) + (1 - g₀) * a 0 := by
      rw [sub_mul, one_mul]; abel
    have hmerge : Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ (a 0) = Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ ((1 - g₀) * a 0) := by
      refine le_antisymm ?_ ?_
      · apply sup_le
        · exact le_sup_left
        · rw [Submodule.span_le]
          intro z hz
          rw [Set.mem_singleton_iff] at hz
          rw [hz]
          have h1 : g₀ * a 0 ∈ Sᵐᵒᵖ ∙ g₀ :=
            Submodule.mem_span_singleton.mpr ⟨MulOpposite.op (a 0), by
              rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]⟩
          have h2 : (1 - g₀) * a 0 ∈ Sᵐᵒᵖ ∙ ((1 - g₀) * a 0) :=
            Submodule.subset_span (Set.mem_singleton _)
          have hsum : g₀ * a 0 + (1 - g₀) * a 0 ∈ Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ ((1 - g₀) * a 0) :=
            add_mem (Submodule.mem_sup_left h1) (Submodule.mem_sup_right h2)
          rwa [← hb] at hsum
      · apply sup_le
        · exact le_sup_left
        · rw [Submodule.span_le]
          intro z hz
          rw [Set.mem_singleton_iff] at hz
          rw [hz, sub_mul, one_mul]
          have h1 : a 0 ∈ Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ (a 0) :=
            Submodule.mem_sup_right (Submodule.subset_span (Set.mem_singleton (a 0)))
          have h2 : g₀ * a 0 ∈ Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ (a 0) :=
            Submodule.mem_sup_left (Submodule.mem_span_singleton.mpr ⟨MulOpposite.op (a 0), by
              rw [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]⟩)
          exact sub_mem h1 h2
    have hrange : Set.range a = insert (a 0) (Set.range (fun i : Fin k => a i.succ)) := by
      ext x
      simp only [Set.mem_range, Set.mem_insert_iff]
      constructor
      · rintro ⟨i, rfl⟩
        rcases Fin.eq_zero_or_eq_succ i with h | ⟨j, rfl⟩
        · exact Or.inl (congr_arg a h)
        · exact Or.inr ⟨j, rfl⟩
      · rintro (h | ⟨j, rfl⟩)
        · exact ⟨0, h.symm⟩
        · exact ⟨j.succ, rfl⟩
    refine ⟨g₀ + g₁ - g₁ * g₀, hu2, ?_⟩
    calc Submodule.span Sᵐᵒᵖ (Set.range a)
        = Submodule.span Sᵐᵒᵖ (insert (a 0) (Set.range (fun i : Fin k => a i.succ))) := by
            rw [hrange]
      _ = Sᵐᵒᵖ ∙ (a 0) ⊔ Submodule.span Sᵐᵒᵖ (Set.range (fun i : Fin k => a i.succ)) :=
            Submodule.span_insert _ _
      _ = Sᵐᵒᵖ ∙ (a 0) ⊔ Sᵐᵒᵖ ∙ g₀ := by rw [hspan0]
      _ = Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ (a 0) := sup_comm _ _
      _ = Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ ((1 - g₀) * a 0) := hmerge
      _ = Sᵐᵒᵖ ∙ g₀ ⊔ Sᵐᵒᵖ ∙ g₁ := by rw [hspan1]
      _ = Sᵐᵒᵖ ∙ (g₀ + g₁ - g₁ * g₀) := hsup

end Work.ORHughesFree.StarRegular
