import Mathlib
import Submission.Work.ORHughesFree.StarRegular
import Submission.Work.ORHughesFree.StarRegular.mem_starRegularClosure_iff

set_option autoImplicit false

namespace Work.ORHughesFree.StarRegular

open Work.ORHughesFree

/-!
## Monotonicity of the `∗`-regular closure in its argument

`starRegularClosure` is built as `starSubringClosure (⋃ₙ Rₙ)`, where `Rₙ = starRegularChain R n`
is the approximating chain of [JZLA20, Proposition 2.2]: `R₀ = R` and `Rₙ₊₁` is the `∗`-subring
generated by `Rₙ` together with the relative inverses (taken in `U`) of its elements.

Since every ingredient of this construction is monotone in the generating set, the closure is
monotone as well.  We record that here.
-/

/-- The `∗`-subring generated by a set is monotone in the set. -/
theorem starSubringClosure_mono {U : Type*} [Ring U] [StarRing U] {s t : Set U} (h : s ⊆ t) :
    (starSubringClosure s : Set U) ⊆ (starSubringClosure t : Set U) :=
  starSubringClosure_le fun _ hx => subset_starSubringClosure t (h hx)

/-- The relative inverses of a larger set of elements form a larger set. -/
theorem relativeInverses_mono {U : Type*} [Ring U] [StarRing U] {s t : Set U} (h : s ⊆ t) :
    relativeInverses s ⊆ relativeInverses t :=
  fun _ ⟨x, hx, hxy⟩ => ⟨x, h hx, hxy⟩

/-- Every stage of the approximating chain is monotone in the generating `∗`-subring. -/
theorem starRegularChain_mono_sub {U : Type*} [Ring U] [StarRing U] {R S : StarSubring U}
    (h : (R : Set U) ⊆ (S : Set U)) (n : ℕ) :
    (starRegularChain R n : Set U) ⊆ (starRegularChain S n : Set U) := by
  induction n with
  | zero => exact h
  | succ n ih =>
    apply starSubringClosure_le
    rintro x (hx | hx)
    · exact subset_starSubringClosure _ (Or.inl (ih hx))
    · obtain ⟨y, hy, hrel⟩ := hx
      exact subset_starSubringClosure _ (Or.inr ⟨y, ih hy, hrel⟩)

theorem starRegularClosure_mono {U : Type*} [Ring U] [StarRing U] {R S : StarSubring U}
    (h : (R : Set U) ⊆ (S : Set U)) :
    (starRegularClosure R : Set U) ⊆ (starRegularClosure S : Set U) := by
  intro x hx
  obtain ⟨n, hn⟩ := (mem_starRegularClosure_iff R x).mp hx
  exact (mem_starRegularClosure_iff S x).mpr ⟨n, starRegularChain_mono_sub h n hn⟩

end Work.ORHughesFree.StarRegular
