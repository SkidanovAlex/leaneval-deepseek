import Mathlib
import Submission.Work.ORHughesFree.StarRegular
import Submission.Work.ORHughesFree.StarRegular.fgRightIdeal_idempotent

namespace Work.ORHughesFree.StarRegular

/-- In a von Neumann regular ring `S`, the cyclic submodule of `S^n` generated by a single
vector `w` is a direct summand: there is an idempotent `S`-linear endomorphism `q` of `S^n`
whose range is exactly `S ∙ w`.

The construction: by `exists_idempotent_span_range`, the right ideal generated by the
coordinates `w i` is `g * S` for an idempotent `g`.  Then `g` fixes `w` (each `w i ∈ g * S`)
and `g = ∑ i, w i * qc i`, so the functional `ℓ x = ∑ i, x i * qc i` satisfies `ℓ w = g`, and
`q := ℓ · w` (i.e. `x ↦ ℓ x • w`) is the desired projection. -/
theorem exists_idempotent_range_span_singleton {S : Type*} [Ring S] [VonNeumannRegularRing S]
    {n : ℕ} (w : Fin n → S) :
    ∃ q : Module.End S (Fin n → S), q * q = q ∧
      LinearMap.range q = Submodule.span S ({w} : Set (Fin n → S)) := by
  obtain ⟨g, hg, hspan⟩ := exists_idempotent_span_range n w
  have hgmem : g ∈ Submodule.span Sᵐᵒᵖ (Set.range w) := by
    rw [hspan]; exact Submodule.subset_span (Set.mem_singleton g)
  obtain ⟨qc, hqc⟩ := (mem_span_range_iff_exists_mul w g).mp hgmem
  have hgw : ∀ i, g * w i = w i := by
    intro i
    have hmem : w i ∈ Submodule.span Sᵐᵒᵖ (Set.range w) :=
      Submodule.subset_span (Set.mem_range_self i)
    rw [hspan] at hmem
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hmem
    rw [MulOpposite.smul_eq_mul_unop] at ha
    calc g * w i = g * (g * MulOpposite.unop a) := by rw [ha]
      _ = (g * g) * MulOpposite.unop a := by rw [mul_assoc]
      _ = g * MulOpposite.unop a := by rw [hg]
      _ = w i := ha
  let ℓ : (Fin n → S) →ₗ[S] S := ∑ i, (LinearMap.proj i : (Fin n → S) →ₗ[S] S).smulRight (qc i)
  have hℓw : ℓ w = g := by
    simp only [ℓ, LinearMap.sum_apply, LinearMap.smulRight_apply, LinearMap.proj_apply]
    exact hqc.symm
  let q : Module.End S (Fin n → S) := ℓ.smulRight w
  have hqw : q w = w := by
    simp only [q, LinearMap.smulRight_apply, hℓw]
    funext i
    simp only [Pi.smul_apply, smul_eq_mul]
    exact hgw i
  refine ⟨q, ?_, ?_⟩
  · apply LinearMap.ext
    intro x
    have hq : q x = (ℓ x) • w := by simp [q, LinearMap.smulRight_apply]
    have hsmul : q ((ℓ x) • w) = ((ℓ x) * g) • w := by
      simp only [q, LinearMap.smulRight_apply]
      rw [map_smul, hℓw, smul_eq_mul]
    have h2 : ((ℓ x) * g) • w = (ℓ x) • w := by
      funext i
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [mul_assoc, hgw i]
    calc q (q x) = q ((ℓ x) • w) := by rw [hq]
      _ = ((ℓ x) * g) • w := hsmul
      _ = (ℓ x) • w := h2
      _ = q x := hq.symm
  · apply le_antisymm
    · rintro y ⟨x, rfl⟩
      exact Submodule.mem_span_singleton.mpr ⟨ℓ x, by simp [q, LinearMap.smulRight_apply]⟩
    · rw [Submodule.span_le]
      rintro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact ⟨w, hqw⟩

end Work.ORHughesFree.StarRegular
