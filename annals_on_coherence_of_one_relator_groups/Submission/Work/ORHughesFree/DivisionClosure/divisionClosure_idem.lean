import Mathlib
import Submission.Work.ORHughesFree.DivisionClosure

/-!
# The division closure is idempotent

We prove that the division closure of the division closure of a subset `R` of a ring `S`
is again the division closure of `R`:

`divisionClosure (divisionClosure R : Set S) = divisionClosure R`.

The argument is the standard one for closure operators of this shape.

* The chain `divisionClosureChain R n` is increasing in `n`
  (`divisionClosureChain_le_succ`), so the family is directed and membership in the
  supremum `divisionClosure R` is witnessed at a finite stage
  (`mem_divisionClosure_exists`).
* Consequently `divisionClosure R` is closed under inverses that exist in `S`
  (`divisionClosure_inv_mem`).
* Any subring `A` of `S` closed under inverses in this sense contains the chain of any
  subset of `A` (`chain_le_of_invClosed`), hence `divisionClosure A ≤ A`
  (`divisionClosure_le_of_invClosed`); applied to `A = divisionClosure R` this gives one
  inclusion, and `subset_divisionClosure` gives the other.
-/

namespace Work.ORHughesFree.DivisionClosure

variable {S : Type*} [Ring S]

/-- The approximating chain of the division closure is increasing: the `n`-th stage is
generated by the `n`-th stage itself together with the inverses of its elements. -/
theorem divisionClosureChain_le_succ (R : Set S) (n : ℕ) :
    divisionClosureChain R n ≤ divisionClosureChain R (n + 1) := by
  intro x hx
  show x ∈ Subring.closure ((divisionClosureChain R n : Set S) ∪
      {y : S | ∃ x ∈ (divisionClosureChain R n : Set S), x * y = 1 ∧ y * x = 1})
  exact Subring.subset_closure (Set.mem_union_left _ hx)

/-- The approximating chain of the division closure is monotone. -/
theorem divisionClosureChain_monotone (R : Set S) : Monotone (divisionClosureChain R) :=
  monotone_nat_of_le_succ (divisionClosureChain_le_succ R)

/-- An element of the division closure `divisionClosure R` lies in some finite stage of
the approximating chain. -/
theorem mem_divisionClosure_exists (R : Set S) (x : S) :
    x ∈ (divisionClosure R : Set S) ↔ ∃ n, x ∈ (divisionClosureChain R n : Set S) := by
  rw [divisionClosure]
  exact Subring.mem_iSup_of_directed (divisionClosureChain_monotone R).directed_le

/-- The division closure is closed under inverses in `S`: if `x` lies in `divisionClosure R`
and `y` is a two-sided inverse of `x` in `S`, then `y` lies in `divisionClosure R`. -/
theorem divisionClosure_inv_mem (R : Set S) {x y : S} (hx : x ∈ (divisionClosure R : Set S))
    (hxy : x * y = 1) (hyx : y * x = 1) : y ∈ (divisionClosure R : Set S) := by
  obtain ⟨n, hn⟩ := (mem_divisionClosure_exists R x).mp hx
  exact le_iSup (divisionClosureChain R) (n + 1)
    (Subring.subset_closure (Set.mem_union_right _ ⟨x, hn, hxy, hyx⟩))

/-- Every stage of the chain generated by a subring `A` that is closed under inverses in `S`
is contained in `A`. -/
theorem chain_le_of_invClosed (A : Subring S)
    (hA : ∀ x ∈ A, ∀ y, x * y = 1 → y * x = 1 → y ∈ A) :
    ∀ n, divisionClosureChain (A : Set S) n ≤ A := by
  intro n
  induction n with
  | zero =>
      show Subring.closure (A : Set S) ≤ A
      exact Subring.closure_le.mpr le_rfl
  | succ n ih =>
      show Subring.closure ((divisionClosureChain (A : Set S) n : Set S) ∪
        {y : S | ∃ x ∈ (divisionClosureChain (A : Set S) n : Set S), x * y = 1 ∧ y * x = 1}) ≤ A
      rw [Subring.closure_le]
      rintro y (hy | ⟨x, hx, hxy, hyx⟩)
      · exact ih hy
      · exact hA x (ih hx) y hxy hyx

/-- A subring of `S` which is closed under inverses in `S` contains the division closure of
any of its subsets; in particular it is its own division closure. -/
theorem divisionClosure_le_of_invClosed (A : Subring S)
    (hA : ∀ x ∈ A, ∀ y, x * y = 1 → y * x = 1 → y ∈ A) :
    divisionClosure (A : Set S) ≤ A := by
  rw [divisionClosure]
  exact iSup_le (chain_le_of_invClosed A hA)

/-- The division closure is idempotent. -/
theorem divisionClosure_idem {S : Type*} [Ring S] (R : Set S) :
    (divisionClosure (divisionClosure R : Set S) : Set S) = (divisionClosure R : Set S) := by
  have hle : divisionClosure (divisionClosure R : Set S) ≤ divisionClosure R :=
    divisionClosure_le_of_invClosed (divisionClosure R)
      (fun x hx y hxy hyx => divisionClosure_inv_mem R hx hxy hyx)
  have hge : divisionClosure R ≤ divisionClosure (divisionClosure R : Set S) :=
    subset_divisionClosure (divisionClosure R : Set S)
  exact congrArg (fun X : Subring S => (X : Set S)) (le_antisymm hle hge)

end Work.ORHughesFree.DivisionClosure
