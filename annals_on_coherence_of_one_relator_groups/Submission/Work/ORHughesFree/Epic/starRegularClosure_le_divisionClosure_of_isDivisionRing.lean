import Mathlib
import Submission.Work.ORHughesFree.StarRegular
import Submission.Work.ORHughesFree.StarRegular.starRegularClosure_le
import Submission.Work.ORHughesFree.DivisionClosure
import Submission.Work.ORHughesFree.StarRegular.isProperStar_starSubring

namespace Work.ORHughesFree.Epic

open Work.ORHughesFree

/-!
## A division ring is `∗`-regular

Any ring which is a division ring (in the sense of `Work.ORHughesFree.IsDivisionRing`, i.e.
`Nontrivial` and every nonzero element is a unit) is von Neumann regular and has a proper
involution, hence is `∗`-regular.  These elementary facts are what allows us to feed the
division closure `D = divisionClosure (Set.range φ)` of the image of `φ` into the
`∗`-regular closure machinery: once `D` is known to be a division ring, its `∗`-closure
(a `StarSubring` by `hstar`) is `∗`-regular.
-/

/-- A division ring has no zero divisors. -/
lemma eq_zero_or_eq_zero_of_mul_eq_zero_of_isDivisionRing {R : Type*} [Ring R]
    (hD : IsDivisionRing R) {a b : R} (h : a * b = 0) : a = 0 ∨ b = 0 := by
  by_cases hb : b = 0
  · exact Or.inr hb
  · left
    obtain ⟨u, hu⟩ := hD.2 b hb
    have hbu : b * (↑u⁻¹ : R) = 1 := by rw [← hu]; exact Units.mul_inv u
    calc a = a * 1 := (mul_one a).symm
      _ = a * (b * (↑u⁻¹ : R)) := by rw [hbu]
      _ = (a * b) * (↑u⁻¹ : R) := (mul_assoc _ _ _).symm
      _ = 0 := by rw [h, zero_mul]

/-- A division ring is von Neumann regular. -/
lemma vonNeumannRegularRing_of_isDivisionRing {R : Type*} [Ring R] (hD : IsDivisionRing R) :
    VonNeumannRegularRing R :=
  ⟨fun x => by
    by_cases hx : x = 0
    · exact ⟨0, by rw [hx]; simp⟩
    · obtain ⟨u, hu⟩ := hD.2 x hx
      exact ⟨(↑u⁻¹ : R), by
        have : x * (↑u⁻¹ : R) = 1 := by rw [← hu]; exact Units.mul_inv u
        rw [this, one_mul]⟩⟩

/-- The involution of a division ring is proper, since a division ring has no zero divisors. -/
lemma isProperStar_of_isDivisionRing {R : Type*} [Ring R] [StarRing R]
    (hD : IsDivisionRing R) : IsProperStar R := by
  intro x hx
  rcases eq_zero_or_eq_zero_of_mul_eq_zero_of_isDivisionRing hD hx with h | h
  · rw [← star_star x, h, star_zero]
  · exact h

/-- A division ring is `∗`-regular. -/
lemma isStarRegular_of_isDivisionRing {R : Type*} [Ring R] [StarRing R]
    (hD : IsDivisionRing R) : IsStarRegular R where
  vonNeumannRegular := vonNeumannRegularRing_of_isDivisionRing hD
  proper := isProperStar_of_isDivisionRing hD

/-- The division closure of `Set.range φ`, viewed as a `∗`-subring of `U` via a hypothesis that
it is closed under `star`. -/
noncomputable def starSubringOfDivisionClosure {K : Type} [Field K] {G : Type} [Group G]
    {U : Type} [Ring U] [StarRing U] (φ : MonoidAlgebra K G →+* U)
    (hstar : ∀ x : U, x ∈ (divisionClosure (Set.range φ) : Subring U) →
      star x ∈ (divisionClosure (Set.range φ) : Subring U)) : StarSubring U where
  toSubring := divisionClosure (Set.range φ)
  star_mem' := fun hx => hstar _ hx

theorem starRegularClosure_le_divisionClosure_of_isDivisionRing {K : Type} [Field K]
    {G : Type} [Group G] {U : Type} [Ring U] [StarRing U] [IsStarRegular U]
    (φ : MonoidAlgebra K G →+* U)
    (hstar : ∀ x : U, x ∈ (Work.ORHughesFree.divisionClosure (Set.range φ) : Subring U) →
      star x ∈ (Work.ORHughesFree.divisionClosure (Set.range φ) : Subring U))
    (hD : Work.ORHughesFree.IsDivisionRing
      ↥(Work.ORHughesFree.divisionClosure (Set.range φ))) :
    (Work.ORHughesFree.starRegularClosure
        (Work.ORHughesFree.starSubringClosure (Set.range φ)) : Set U) ⊆
      (Work.ORHughesFree.divisionClosure (Set.range φ) : Set U) := by
  -- `D := divisionClosure (Set.range φ)` is a `∗`-subring by `hstar`, hence `∗`-regular.
  let Dstar : StarSubring U := starSubringOfDivisionClosure φ hstar
  haveI : IsStarRegular Dstar := isStarRegular_of_isDivisionRing (R := Dstar) hD
  -- the `∗`-subring generated by `Set.range φ` lies inside `Dstar`
  have hsub : (starSubringClosure (Set.range φ) : Set U) ⊆ (Dstar : Set U) :=
    starSubringClosure_le (fun x hx => subset_divisionClosure (Set.range φ) hx)
  exact StarRegular.starRegularClosure_le hsub

end Work.ORHughesFree.Epic
