# The Isbell--Silver--Mazet criterion for epic ring homomorphisms

For a ring homomorphism `f : R →+* S` which is *epic* (right cancellable for composition of ring
homomorphisms, `Work.ORHughesFree.IsEpic f`) and every `d : S` there are `n`, a row
`X : Matrix (Fin 1) (Fin n) S`, a square matrix `P : Matrix (Fin n) (Fin n) R` and a column
`Y : Matrix (Fin n) (Fin 1) S` with

`d = X · f(P) · Y`,  `X · f(P)` a row over `f(R)`,  `f(P) · Y` a column over `f(R)`.

Equivalently, every element of `S` is of the form `X P Y` with `X, Y` over `S` and `P, XP, PY`
over `R` — the classical description (Isbell, Silver, Mazet; see B.~J.~Gardner, *Epimorphisms of
regular rings*, Comment. Math. Univ. Carolinae 16 (1975), Theorem 1.1) of the dominion of `f(R)`
in `S`.

## Proof outline

The easy direction `IsEpic f → d ⊗ 1 = 1 ⊗ d` in `S ⊗[R] S` (the balanced tensor
`Work.ORHughesFree.Epic.BalancedTensor f`) is `Work.ORHughesFree.Epic.tmul_eq_of_isEpic`.

For the converse we use Bourbaki's lemma on the relations in a tensor product (`E ⊗_R F`): if
`(x_λ)` generates a right `R`-module `E` then `∑_λ x_λ ⊗ z_λ = 0` iff `z_λ = ∑_k a_{kλ} w_k` for
finitely many relations `∑_λ x_λ a_{kλ} = 0` and elements `w_k ∈ F`.  Concretely, with `E = F = S`
and `x_λ = λ` the criterion becomes: `Φ z = 0` (where `Φ z = ∑_s s ⊗ z s`) if and only if there
are `v_k : S →₀ R` and `w_k : S` with `∑_s s * f (v_k s) = 0` and `z s = ∑_k f (v_k s) * w_k`.
This is proved by exhibiting the free presentation of `S ⊗[R] S`: the additive group
`Φ '' (S →₀ S)` is `(S →₀ S) ⧸ Nset f`, where `Nset f` is the subgroup generated by the elements
`s ↦ f (v s) * w` for `v` in the kernel of `π : (S →₀ R) →+ S`, `v ↦ ∑_s s * f (v s)`; the
comparison map out of `S ⊗[R] S` sending `s ⊗ t` to the class of `Finsupp.single s t` shows that
this subgroup is exactly `ker Φ`.

Applying this to `z = Finsupp.single d 1 - Finsupp.single 1 d` (for `d ≠ 1`) produces exactly the
data needed by `exists_matrices_of_data`, and `square_matrices` pads the resulting rectangular
matrix to a square one.
-/
import Mathlib
import Submission.Work.ORHughesFree.Epic
import Submission.Work.ORHughesFree.Epic.BalancedTensor
import Submission.Work.ORHughesFree.Epic.tmul_eq_of_isEpic
import Submission.Work.ORHughesFree.Epic.exists_matrices_of_data
import Submission.Work.ORHughesFree.Epic.square_matrices

set_option autoImplicit false

namespace Work.ORHughesFree.Epic

namespace IsbellAux

open BalancedTensor

set_option autoImplicit false
set_option maxHeartbeats 4000000

variable {R S : Type} [Ring R] [Ring S]

section Basic

variable (f : R →+* S)

theorem tmul_add_right (a b b' : S) : tmul f a (b + b') = tmul f a b + tmul f a b' := by
  show (QuotientAddGroup.mk (a ⊗ₜ[ℤ] (b + b')) : BalancedTensor f)
      = QuotientAddGroup.mk (a ⊗ₜ[ℤ] b) + QuotientAddGroup.mk (a ⊗ₜ[ℤ] b')
  rw [TensorProduct.tmul_add]
  rfl

theorem tmul_add_left (a a' b : S) : tmul f (a + a') b = tmul f a b + tmul f a' b := by
  show (QuotientAddGroup.mk ((a + a') ⊗ₜ[ℤ] b) : BalancedTensor f)
      = QuotientAddGroup.mk (a ⊗ₜ[ℤ] b) + QuotientAddGroup.mk (a' ⊗ₜ[ℤ] b)
  rw [TensorProduct.add_tmul]
  rfl

theorem tmul_zero_right (a : S) : tmul f a 0 = 0 := by
  show (QuotientAddGroup.mk (a ⊗ₜ[ℤ] (0 : S)) : BalancedTensor f) = 0
  rw [TensorProduct.tmul_zero]
  exact QuotientAddGroup.mk_zero _

theorem tmul_zero_left (b : S) : tmul f 0 b = 0 := by
  show (QuotientAddGroup.mk ((0 : S) ⊗ₜ[ℤ] b) : BalancedTensor f) = 0
  rw [TensorProduct.zero_tmul]
  exact QuotientAddGroup.mk_zero _

noncomputable def tmulRight (s : S) : S →+ BalancedTensor f where
  toFun t := tmul f s t
  map_zero' := tmul_zero_right f s
  map_add' a b := tmul_add_right f s a b

noncomputable def tmulEqOne : S →+ BalancedTensor f where
  toFun t := tmul f t 1
  map_zero' := tmul_zero_left f 1
  map_add' a b := tmul_add_left f a b 1

@[simp] theorem tmulRight_apply (s t : S) : tmulRight f s t = tmul f s t := rfl
@[simp] theorem tmulEqOne_apply (t : S) : tmulEqOne f t = tmul f t 1 := rfl

noncomputable def piHom : (S →₀ R) →+ S :=
  Finsupp.liftAddHom (fun s => (AddMonoidHom.mulLeft s).comp f.toAddMonoidHom)

theorem piHom_apply (v : S →₀ R) : piHom f v = v.sum (fun s r => s * f r) :=
  Finsupp.liftAddHom_apply _ _

theorem piHom_single (s : S) (r : R) : piHom f (Finsupp.single s r) = s * f r := by
  rw [piHom_apply, Finsupp.sum_single_index]
  simp

noncomputable def relSet : AddSubgroup (S →₀ R) := (piHom f).ker

theorem mem_relSet_iff (v : S →₀ R) : v ∈ relSet f ↔ piHom f v = 0 :=
  AddMonoidHom.mem_ker

noncomputable def aFun (v : S →₀ R) (w : S) : S →₀ S :=
  Finsupp.mapRange (fun r => f r * w) (by simp) v

theorem aFun_apply (v : S →₀ R) (w s : S) : aFun f v w s = f (v s) * w :=
  Finsupp.mapRange_apply

theorem aFun_add (v v' : S →₀ R) (w : S) : aFun f (v + v') w = aFun f v w + aFun f v' w :=
  Finsupp.mapRange_add (fun x y => by rw [map_add, add_mul]) _ _

theorem aFun_neg (v : S →₀ R) (w : S) : aFun f (-v) w = -aFun f v w :=
  Finsupp.mapRange_neg (fun x => by rw [map_neg, neg_mul]) _

theorem aFun_single (s : S) (r : R) (w : S) :
    aFun f (Finsupp.single s r) w = Finsupp.single s (f r * w) := by
  rw [aFun, Finsupp.mapRange_single]

noncomputable def Nset : AddSubgroup (S →₀ S) :=
  AddSubgroup.closure (Set.range (fun p : (relSet f) × S => aFun f (p.1 : S →₀ R) p.2))

theorem mem_Nset_of (v : S →₀ R) (hv : v ∈ relSet f) (w : S) : aFun f v w ∈ Nset f :=
  AddSubgroup.subset_closure ⟨(⟨v, hv⟩, w), rfl⟩

theorem aFun_addRel (s s' t : S) :
    aFun f (Finsupp.single (s + s') 1 + -Finsupp.single s 1 + -Finsupp.single s' 1) t
      = Finsupp.single (s + s') t + -Finsupp.single s t + -Finsupp.single s' t := by
  rw [aFun_add, aFun_add, aFun_neg, aFun_neg, aFun_single, aFun_single, aFun_single]
  simp

theorem aFun_balRel (s : S) (r : R) (t : S) :
    aFun f (Finsupp.single s r + -Finsupp.single (s * f r) 1) t
      = Finsupp.single s (f r * t) + -Finsupp.single (s * f r) t := by
  rw [aFun_add, aFun_neg, aFun_single, aFun_single]
  simp

theorem relSet_addRel (s s' : S) :
    Finsupp.single (s + s') 1 + -Finsupp.single s 1 + -Finsupp.single s' 1 ∈ relSet f := by
  rw [mem_relSet_iff, map_add, map_add, map_neg, map_neg, piHom_single, piHom_single,
    piHom_single]
  simp

theorem relSet_balRel (s : S) (r : R) :
    Finsupp.single s r + -Finsupp.single (s * f r) 1 ∈ relSet f := by
  rw [mem_relSet_iff, map_add, map_neg, piHom_single, piHom_single]
  simp

theorem relSet_single_zero_one : Finsupp.single (0 : S) 1 ∈ relSet f := by
  rw [mem_relSet_iff, piHom_single]
  simp

end Basic

section Core

variable (f : R →+* S)

noncomputable def PhiHom : (S →₀ S) →+ BalancedTensor f :=
  Finsupp.liftAddHom (fun s => tmulRight f s)

theorem PhiHom_apply (z : S →₀ S) : PhiHom f z = z.sum (fun s t => tmul f s t) :=
  Finsupp.liftAddHom_apply _ _

theorem PhiHom_single (s t : S) : PhiHom f (Finsupp.single s t) = tmul f s t := by
  rw [PhiHom_apply, Finsupp.sum_single_index (tmul_zero_right f s)]

theorem PhiHom_apply' (z : S →₀ S) :
    PhiHom f z = ∑ s ∈ z.support, tmul f s (z s) := by
  rw [PhiHom_apply, Finsupp.sum_of_support_subset z (Finset.Subset.refl _)
    (fun s t => tmul f s t) (fun i _ => tmul_zero_right f i)]

theorem support_aFun_subset (v : S →₀ R) (w : S) :
    (aFun f v w).support ⊆ v.support := by
  intro s hs
  by_contra h
  rw [Finsupp.mem_support_iff] at hs
  rw [Finsupp.mem_support_iff, not_not] at h
  exact hs (by rw [aFun_apply, h, map_zero, zero_mul])

theorem PhiHom_aFun (v : S →₀ R) (w : S) :
    PhiHom f (aFun f v w) = smulRight f w (tmulEqOne f (piHom f v)) := by
  have h1 : (aFun f v w).sum (fun s t => tmul f s t)
      = ∑ x ∈ v.support, tmul f x (f (v x) * w) := by
    rw [Finsupp.sum_of_support_subset (aFun f v w) (support_aFun_subset f v w)
      (fun s t => tmul f s t) (fun i _ => tmul_zero_right f i)]
    exact Finset.sum_congr rfl (fun x _ => by rw [aFun_apply])
  have h2 : ∀ x ∈ v.support, tmul f x (f (v x) * w)
      = smulRight f w (tmulEqOne f (x * f (v x))) := by
    intro x _
    rw [tmulEqOne_apply, smulRight_tmul, one_mul]
    exact (tmul_balance f x w (v x)).symm
  have h3 : piHom f v = ∑ x ∈ v.support, x * f (v x) := by
    rw [piHom_apply, Finsupp.sum_of_support_subset v (Finset.Subset.refl _)
      (fun s r => s * f r) (fun i _ => by rw [map_zero, mul_zero])]
  rw [PhiHom_apply, h1, h3]
  simp only [map_sum]
  exact Finset.sum_congr rfl h2

theorem aFun_mem_ker (v : S →₀ R) (hv : v ∈ relSet f) (w : S) :
    PhiHom f (aFun f v w) = 0 := by
  rw [PhiHom_aFun, (mem_relSet_iff f v).mp hv]
  simp [tmul_zero_left]

theorem Nset_le_ker_PhiHom : Nset f ≤ (PhiHom f).ker := by
  rw [Nset, AddSubgroup.closure_le]
  rintro x ⟨p, rfl⟩
  exact AddMonoidHom.mem_ker.mpr (aFun_mem_ker f (p.1 : S →₀ R) p.1.2 p.2)

end Core

section Beta

variable (f : R →+* S)

noncomputable def betaFun (s : S) : S →+ (S →₀ S) ⧸ Nset f where
  toFun t := QuotientAddGroup.mk (Finsupp.single s t)
  map_zero' := by
    show QuotientAddGroup.mk (Finsupp.single s (0 : S)) = 0
    rw [Finsupp.single_zero]
    exact QuotientAddGroup.mk_zero _
  map_add' a b := by
    show QuotientAddGroup.mk (Finsupp.single s (a + b))
        = QuotientAddGroup.mk (Finsupp.single s a) + QuotientAddGroup.mk (Finsupp.single s b)
    rw [Finsupp.single_add]
    rfl

theorem betaFun_add_apply (s s' t : S) :
    betaFun f (s + s') t = betaFun f s t + betaFun f s' t := by
  show QuotientAddGroup.mk (Finsupp.single (s + s') t)
      = QuotientAddGroup.mk (Finsupp.single s t) + QuotientAddGroup.mk (Finsupp.single s' t)
  rw [← QuotientAddGroup.mk_add (Nset f)]
  refine QuotientAddGroup.eq_iff_sub_mem.mpr ?_
  have h := mem_Nset_of f _ (relSet_addRel f s s') t
  rw [aFun_addRel] at h
  simpa only [sub_eq_add_neg, neg_add, add_assoc] using h

theorem betaFun_zero_apply (t : S) : betaFun f 0 t = 0 := by
  show QuotientAddGroup.mk (Finsupp.single (0 : S) t) = 0
  rw [← QuotientAddGroup.mk_zero (Nset f)]
  refine QuotientAddGroup.eq_iff_sub_mem.mpr ?_
  have h := mem_Nset_of f _ (relSet_single_zero_one f) t
  rw [aFun_single] at h
  simpa using h

noncomputable def betaLin (s : S) : S →ₗ[ℤ] ((S →₀ S) ⧸ Nset f) :=
  AddMonoidHom.toIntLinearMap (betaFun f s)

theorem betaLin_apply (s t : S) :
    betaLin f s t = QuotientAddGroup.mk (Finsupp.single s t) := rfl

noncomputable def betaHom : S →+ (S →ₗ[ℤ] ((S →₀ S) ⧸ Nset f)) where
  toFun s := betaLin f s
  map_zero' := by
    apply LinearMap.ext
    intro t
    show betaFun f 0 t = (0 : S →ₗ[ℤ] ((S →₀ S) ⧸ Nset f)) t
    rw [betaFun_zero_apply]
    rfl
  map_add' s s' := by
    apply LinearMap.ext
    intro t
    show betaFun f (s + s') t = (betaLin f s + betaLin f s') t
    rw [betaFun_add_apply]
    rfl

noncomputable def beta : S →ₗ[ℤ] S →ₗ[ℤ] ((S →₀ S) ⧸ Nset f) :=
  AddMonoidHom.toIntLinearMap (betaHom f)

theorem beta_apply (s t : S) : beta f s t = QuotientAddGroup.mk (Finsupp.single s t) := rfl

theorem beta_balanced : ∀ s t r, beta f (s * f r) t = beta f s (f r * t) := by
  intro s t r
  rw [beta_apply, beta_apply]
  refine QuotientAddGroup.eq_iff_sub_mem.mpr ?_
  have h := mem_Nset_of f _ (relSet_balRel f s r) t
  rw [aFun_balRel] at h
  simpa [sub_eq_add_neg, neg_add, neg_neg, add_comm, add_left_comm, add_assoc] using neg_mem h

noncomputable def betaBar : BalancedTensor f →+ ((S →₀ S) ⧸ Nset f) :=
  BalancedTensor.lift f (beta f) (beta_balanced f)

theorem betaBar_tmul (s t : S) :
    betaBar f (tmul f s t) = QuotientAddGroup.mk (Finsupp.single s t) :=
  BalancedTensor.lift_tmul f (beta f) (beta_balanced f) s t

theorem mk_finset_sum {ι : Type} (s : Finset ι) (g : ι → S →₀ S) :
    (∑ i ∈ s, QuotientAddGroup.mk (g i) : (S →₀ S) ⧸ Nset f)
      = QuotientAddGroup.mk (∑ i ∈ s, g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact (QuotientAddGroup.mk_zero (Nset f)).symm
  | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, ih]
      exact (QuotientAddGroup.mk_add (Nset f) (g a) (∑ i ∈ s, g i)).symm

theorem sum_single_eq (z : S →₀ S) : (∑ x ∈ z.support, Finsupp.single x (z x)) = z := by
  have h := Finsupp.sum_single z
  rwa [Finsupp.sum_of_support_subset z (Finset.Subset.refl _)
    (fun x y => Finsupp.single x y) (fun i _ => Finsupp.single_zero i)] at h

theorem betaBar_PhiHom (z : S →₀ S) : betaBar f (PhiHom f z) = QuotientAddGroup.mk z := by
  rw [PhiHom_apply, Finsupp.sum_of_support_subset z (Finset.Subset.refl _)
    (fun s t => tmul f s t) (fun i _ => tmul_zero_right f i), map_sum]
  rw [Finset.sum_congr rfl (fun x _ => betaBar_tmul f x (z x))]
  rw [mk_finset_sum, sum_single_eq]

theorem ker_PhiHom_le_Nset {z : S →₀ S} (hz : PhiHom f z = 0) : z ∈ Nset f := by
  have h : (QuotientAddGroup.mk z : (S →₀ S) ⧸ Nset f) = 0 := by
    rw [← betaBar_PhiHom f z, hz, map_zero]
  have h2 : (QuotientAddGroup.mk z : (S →₀ S) ⧸ Nset f)
      = (QuotientAddGroup.mk (0 : S →₀ S) : (S →₀ S) ⧸ Nset f) := by
    rw [h]
    exact (QuotientAddGroup.mk_zero (Nset f)).symm
  have h3 : z - 0 ∈ Nset f := (QuotientAddGroup.eq_iff_sub_mem (N := Nset f)).mp h2
  simpa using h3

theorem mem_Nset_iff (z : S →₀ S) : z ∈ Nset f ↔ PhiHom f z = 0 :=
  ⟨fun hz => AddMonoidHom.mem_ker.mp (Nset_le_ker_PhiHom f hz),
   fun hz => ker_PhiHom_le_Nset f hz⟩

end Beta

section Extraction

variable (f : R →+* S)

theorem goodData_of_mem_Nset {z : S →₀ S} (hz : z ∈ Nset f) :
    ∃ (n : ℕ) (v : Fin n → S →₀ R) (w : Fin n → S),
      (∀ k, piHom f (v k) = 0) ∧ (∀ s : S, z s = ∑ k, f (v k s) * w k) := by
  refine AddSubgroup.closure_induction (p := fun z _ => ∃ (n : ℕ) (v : Fin n → S →₀ R)
    (w : Fin n → S), (∀ k, piHom f (v k) = 0) ∧ (∀ s : S, z s = ∑ k, f (v k s) * w k))
    ?_ ?_ ?_ ?_ hz
  · rintro x ⟨p, rfl⟩
    refine ⟨1, fun _ => (p.1 : S →₀ R), fun _ => p.2, ?_, ?_⟩
    · intro k
      exact (mem_relSet_iff f (p.1 : S →₀ R)).mp p.1.2
    · intro s
      show aFun f (p.1 : S →₀ R) p.2 s = ∑ k : Fin 1, f ((p.1 : S →₀ R) s) * p.2
      rw [aFun_apply]
      simp
  · exact ⟨0, Fin.elim0, Fin.elim0, (fun k => k.elim0), (fun s => by simp)⟩
  · intro x y hx hy hpx hpy
    obtain ⟨n, v, w, hv, hw⟩ := hpx
    obtain ⟨n', v', w', hv', hw'⟩ := hpy
    refine ⟨n + n', Fin.append v v', Fin.append w w', ?_, ?_⟩
    · intro k
      exact Fin.addCases (fun i => by rw [Fin.append_left]; exact hv i)
        (fun i => by rw [Fin.append_right]; exact hv' i) k
    · intro s
      rw [Finsupp.add_apply, hw s, hw' s, Fin.sum_univ_add]
      congr 1
      · exact Finset.sum_congr rfl (fun i _ => by rw [Fin.append_left, Fin.append_left])
      · exact Finset.sum_congr rfl (fun i _ => by rw [Fin.append_right, Fin.append_right])
  · intro x hx hpx
    obtain ⟨n, v, w, hv, hw⟩ := hpx
    refine ⟨n, v, fun k => - w k, hv, fun s => ?_⟩
    rw [Finsupp.neg_apply, hw s, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun k _ => by rw [mul_neg])

theorem mem_Nset_of_goodData {z : S →₀ S}
    (hz : ∃ (n : ℕ) (v : Fin n → S →₀ R) (w : Fin n → S),
      (∀ k, piHom f (v k) = 0) ∧ (∀ s : S, z s = ∑ k, f (v k s) * w k)) : z ∈ Nset f := by
  obtain ⟨n, v, w, hv, hw⟩ := hz
  have hsum : z = ∑ k : Fin n, aFun f (v k) (w k) := by
    ext s
    rw [Finsupp.finsetSum_apply, hw s]
    exact Finset.sum_congr rfl (fun k _ => (aFun_apply f (v k) (w k) s).symm)
  rw [hsum]
  exact (Nset f).sum_mem (fun k _ => mem_Nset_of f (v k) (hv k) (w k))

theorem exists_data_of_PhiHom_eq_zero {z : S →₀ S} (hz : PhiHom f z = 0) :
    ∃ (n : ℕ) (v : Fin n → S →₀ R) (w : Fin n → S),
      (∀ k, piHom f (v k) = 0) ∧ (∀ s : S, z s = ∑ k, f (v k s) * w k) :=
  goodData_of_mem_Nset f ((mem_Nset_iff f z).mpr hz)

end Extraction

end IsbellAux

/-- **The Isbell--Silver--Mazet criterion.**  If `f : R →+* S` is epic, then every `d : S` is a
matrix coefficient `X · f(P) · Y` of a square matrix `P` over `R`, where `X f(P)` is a row over
`f(R)` and `f(P) Y` is a column over `f(R)`. -/
theorem isbellSilverMazet {R S : Type} [Ring R] [Ring S] (f : R →+* S)
    (hf : Work.ORHughesFree.IsEpic f) (d : S) :
    ∃ (n : ℕ) (X : Matrix (Fin 1) (Fin n) S) (P : Matrix (Fin n) (Fin n) R)
      (Y : Matrix (Fin n) (Fin 1) S),
      (∃ P' : Matrix (Fin 1) (Fin n) R, X * P.map f = P'.map f) ∧
      (∃ Q' : Matrix (Fin n) (Fin 1) R, P.map f * Y = Q'.map f) ∧
      d = (X * P.map f * Y) 0 0 := by
  classical
  by_cases hd : d = 1
  · subst hd
    refine ⟨1, 1, 1, 1, ?_, ?_, ?_⟩
    · exact ⟨1, by ext i j; fin_cases i; fin_cases j; simp [Matrix.mul_apply]⟩
    · exact ⟨1, by ext i j; fin_cases i; fin_cases j; simp [Matrix.mul_apply]⟩
    · simp [Matrix.mul_apply]
  · have hrel : ∀ s : S, BalancedTensor.tmul f s 1 = BalancedTensor.tmul f 1 s :=
      fun s => tmul_eq_of_isEpic f hf s
    set z : S →₀ S := Finsupp.single d 1 - Finsupp.single 1 d with hzdef
    have hPhi : IsbellAux.PhiHom f z = 0 := by
      rw [hzdef, map_sub, IsbellAux.PhiHom_single, IsbellAux.PhiHom_single, hrel d, sub_self]
    obtain ⟨n, v, w, hv, hw⟩ := IsbellAux.exists_data_of_PhiHom_eq_zero f hPhi
    have hv' : ∀ k, ∑ s ∈ (v k).support, s * f (v k s) = 0 := by
      intro k
      have h := hv k
      rw [IsbellAux.piHom_apply] at h
      rw [Finsupp.sum_of_support_subset (v k) (Finset.Subset.refl _) (fun s r => s * f r)
        (fun i _ => by rw [map_zero, mul_zero])] at h
      exact h
    have hz1 : z 1 = -d := by
      rw [hzdef, Finsupp.sub_apply, Finsupp.single_eq_of_ne (Ne.symm hd),
        Finsupp.single_eq_same, zero_sub]
    have h1 : (∑ k, f (v k 1) * w k) = -d := (hw 1).symm.trans hz1
    have hzd : z d = 1 := by
      rw [hzdef, Finsupp.sub_apply, Finsupp.single_eq_same, Finsupp.single_eq_of_ne hd,
        sub_zero]
    have hd' : (∑ k, f (v k d) * w k) = 1 := (hw d).symm.trans hzd
    have h0 : ∀ s, s ≠ 1 → s ≠ d → (∑ k, f (v k s) * w k) = 0 := by
      intro s hs1 hsd
      have hzs : z s = 0 := by
        rw [hzdef, Finsupp.sub_apply, Finsupp.single_eq_of_ne hsd, Finsupp.single_eq_of_ne hs1,
          sub_zero]
      exact (hw s).symm.trans hzs
    obtain ⟨m, X, P, Y, hX, hY, hXY⟩ := exists_matrices_of_data f d v w hv' h1 hd' h0
    exact square_matrices f X P Y hX hY d hXY

end Work.ORHughesFree.Epic
