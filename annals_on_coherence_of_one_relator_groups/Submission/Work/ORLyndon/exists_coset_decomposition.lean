import Mathlib
import Submission.Work.ORLyndon.cosetFinsetDefs
import Submission.Work.ORLyndon.cosetRepDefs
import Submission.Work.ORLyndon.block_sum_mem_span
import Submission.Work.ORLyndon.sum_fiberwise_fin
import Submission.Work.ORLyndon.coset_fiber_sum

/-!
# Decomposing an element of `K[G]` into its `⟨w⟩`-coset blocks

Let `G` be a group, `w : G`, `l : ℕ` with `1 ≤ l` and `w ^ l = 1`, and `a ∈ K[G]` for a field `K`.
The theorem `Work.ORLyndon.exists_coset_decomposition` produces a decomposition of `a` indexed by
*pairwise distinct* right cosets of the cyclic subgroup `⟨w⟩` that cover the support of `a`:

* `g : Fin n → G` are representatives of `n` pairwise distinct right `⟨w⟩`-cosets,
* every element of `a.coeff.support` lies in one of these cosets,
* `c i` is the sum of the coefficients of `a` over the coset of `g i`, and
* the difference `a - ∑ i, c i • of (g i)` lies in the ideal `⟨of w - 1⟩`.

The representatives are chosen with `Quotient.out` for the setoid "same right `⟨w⟩`-coset"
(`Work.ORLyndon.cosetRep`), and the last statement is proved coset block by coset block: on a
single coset, `of (t * w ^ k) - of t = of t * (of w ^ k - 1)` is a multiple of `of w - 1`, while
the leftover `of t` terms cancel because the block coefficient sum is exactly `c i`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.ORLyndon

open MonoidAlgebra

theorem exists_coset_decomposition {G : Type*} [Group G] [DecidableEq G] {K : Type*} [Field K]
    (w : G) (l : ℕ) (hpos : 1 ≤ l) (hw : w ^ l = 1) (a : MonoidAlgebra K G) :
    ∃ (n : ℕ) (g : Fin n → G) (c : Fin n → K),
      (∀ i j, i ≠ j → ∀ m : ℤ, g i ≠ g j * w ^ m) ∧
      (∀ h ∈ a.coeff.support, ∃ i, ∃ m : ℤ, h = g i * w ^ m) ∧
      (∀ i, c i = ∑ h ∈ cosetFinset w l (g i), a.coeff h) ∧
      a - ∑ i, c i • MonoidAlgebra.of K G (g i) ∈
        Ideal.span ({MonoidAlgebra.of K G w - 1} : Set (MonoidAlgebra K G)) := by
  classical
  have hl : 0 < l := by omega
  let s : Finset G := a.coeff.support
  let reps : Finset G := s.image (cosetRep w)
  let g : Fin reps.card → G := fun i => ((reps.equivFin.symm i : reps) : G)
  let B : Fin reps.card → Finset G := fun i => s.filter (fun h => cosetRep w h = g i)
  let c : Fin reps.card → K := fun i => ∑ h ∈ cosetFinset w l (g i), a.coeff h
  refine ⟨reps.card, g, c, ?_, ?_, ?_, ?_⟩
  · -- the representatives lie in pairwise distinct right cosets
    intro i j hij m heq
    apply hij
    have hi : cosetRep w (g i) = g i :=
      cosetRep_eq_self_of_mem_image (w := w) (s := s) (reps.equivFin.symm i).2
    have hj : cosetRep w (g j) = g j :=
      cosetRep_eq_self_of_mem_image (w := w) (s := s) (reps.equivFin.symm j).2
    have hsame : SameRCoset w (g j) (g i) := ⟨m, heq⟩
    have hrep : cosetRep w (g j) = cosetRep w (g i) := cosetRep_eq_of_sameRCoset hsame
    have hgg : g i = g j := by
      calc g i = cosetRep w (g i) := hi.symm
        _ = cosetRep w (g j) := hrep.symm
        _ = g j := hj
    exact (reps.equivFin.symm).injective (Subtype.ext hgg)
  · -- every element of the support lies in one of the chosen cosets
    intro h hh
    obtain ⟨m, hm⟩ := cosetRep_spec w h
    refine ⟨reps.equivFin ⟨cosetRep w h, Finset.mem_image_of_mem (cosetRep w) hh⟩, m, ?_⟩
    have hgit : g (reps.equivFin ⟨cosetRep w h, Finset.mem_image_of_mem (cosetRep w) hh⟩)
        = cosetRep w h := by
      simp only [g, Equiv.symm_apply_apply]
    rw [hgit]
    exact hm
  · -- the coefficients are the coset sums, by definition
    intro i
    rfl
  · -- the residual lies in the ideal generated by `of w - 1`
    have hg_inj : Function.Injective g := by
      intro i j hij
      exact (reps.equivFin.symm).injective (Subtype.ext hij)
    have hg_cover : ∀ x ∈ s, ∃ i, g i = cosetRep w x := by
      intro x hx
      exact ⟨reps.equivFin ⟨cosetRep w x, Finset.mem_image_of_mem (cosetRep w) hx⟩,
        by simp only [g, Equiv.symm_apply_apply]⟩
    -- `a` as the sum of its coefficient-weighted basis elements
    have ha : a = ∑ h ∈ s, a.coeff h • MonoidAlgebra.of K G h := by
      conv_lhs => rw [← MonoidAlgebra.sum_coeff_single a]
      rw [Finsupp.sum]
      apply Finset.sum_congr rfl
      intro x hx
      rw [MonoidAlgebra.of_apply, MonoidAlgebra.smul_single, smul_eq_mul, mul_one]
    -- group the support into the fibres of `cosetRep w`
    have hgroup : (∑ h ∈ s, a.coeff h • MonoidAlgebra.of K G h)
        = ∑ i : Fin reps.card, ∑ h ∈ B i, a.coeff h • MonoidAlgebra.of K G h :=
      (sum_fiberwise_fin s (cosetRep w) g hg_inj hg_cover
        (fun h => a.coeff h • MonoidAlgebra.of K G h)).symm
    -- each block differs from `c i • of (g i)` by a multiple of `of w - 1`
    have hblock : ∀ i, (∑ h ∈ B i, a.coeff h • MonoidAlgebra.of K G h) -
        (∑ h ∈ B i, a.coeff h) • MonoidAlgebra.of K G (g i) ∈
          Ideal.span ({MonoidAlgebra.of K G w - 1} : Set (MonoidAlgebra K G)) := by
      intro i
      refine block_sum_mem_span w l a (g i) (fun h hh => ?_)
      have hh' := Finset.mem_filter.mp hh
      have hsame : SameRCoset w (g i) h := hh'.2 ▸ cosetRep_spec w h
      exact (sameRCoset_iff_mem_cosetFinset hl hw).mp hsame
    -- the coset sum `c i` is the coefficient sum over the block
    have hc : ∀ i, c i = ∑ h ∈ B i, a.coeff h := by
      intro i
      exact coset_fiber_sum w l hpos hw a.coeff s
        (fun x hx => Finsupp.notMem_support_iff.mp hx) (g i) (reps.equivFin.symm i).2
    rw [ha, hgroup, ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [hc i]
    exact hblock i

end Work.ORLyndon
