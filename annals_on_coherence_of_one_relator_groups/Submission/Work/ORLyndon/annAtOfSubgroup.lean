import Submission.Work.ORLyndon.annAtDefs
import Submission.Work.ORLyndon.base_regularity_transport_of_le
import Submission.Work.ORReductions.SubgroupAlg.subgroupAlgMap_mem_range_iff
import Submission.Work.ORReductions.SubgroupAlg.subgroupAlgMap_injective

/-!
# `annAt` from a subgroup with a domain group algebra

Let `G = ⟨α | r⟩` be a one-relator group, `u` a root of the relator (`r = u ^ l`) and
`β_x = rootVec K r u x ∈ K[G]` the `x`-component of the Fox vector of the root.

This file proves the **subgroup reduction**

> if the support of `β_x` lies in a subgroup `N ≤ G` whose group algebra `K[N]` has no zero
> divisors, and `β_x ≠ 0`, then `β_x` is a right non-zero-divisor of `K[G]`
> (`annAt K r u {x}`).

The point is that `K[G]` is a free left `K[N]`-module (on the coset representatives), so right
multiplication by an element of the subalgebra `K[N]` acts *componentwise*; consequently it is
enough to know that `β_x` is regular in `K[N]` itself.  The two ingredients are
`Work.ORReductions.SubgroupAlg.subgroupAlgMap_mem_range_iff` (so that `β_x` is the image of an
element of `K[N]`) and `Work.ORLyndon.rightRegular_transport_subgroupAlgMap` (the transport from
`K[N]` to `K[G]`).

This is the general form of the "domain route" of `Submission/Work/ORLyndon/domainRoute.lean`
(`annAt_of_noZeroDivisors`), which is the special case `N = ⊤`.  It is what makes it possible to
exploit *free* (or otherwise domain-like) subgroups of `G` generated by the terms of `∂u/∂x`; in
particular it applies whenever all the terms of `∂u/∂x` avoid a letter `y` of `u`, since then they
lie in the Magnus subgroup at `y`, which is free by the Freiheitssatz.

## Main result

* `Work.ORLyndon.annAt_of_support_subgroup_noZeroDivisors`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

variable {α : Type u} [DecidableEq α] {K : Type v} [Field K]

/-- **`annAt` from a subgroup with no zero divisors.**  If the `x`-component `β_x` of the root Fox
vector is supported in a subgroup `N ≤ ⟨α | r⟩` whose group algebra has no zero divisors, and
`β_x ≠ 0`, then no non-zero element of `K[⟨α | r⟩]` annihilates `β_x`. -/
theorem annAt_of_support_subgroup_noZeroDivisors {r u : FreeGroup α} {x : α}
    (N : Subgroup (OneRelatorGroup r))
    (hdom : NoZeroDivisors (MonoidAlgebra K ↥N))
    (hsupp : ↑(rootVec K r u x).coeff.support ⊆ (N : Set (OneRelatorGroup r)))
    (hne : rootVec K r u x ≠ 0) : annAt K r u {x} := by
  classical
  obtain ⟨y₀, hy₀⟩ :=
    (Work.ORReductions.SubgroupAlg.subgroupAlgMap_mem_range_iff N K
      (rootVec K r u x)).mpr hsupp
  have hy₀ne : y₀ ≠ 0 := fun h => hne (by rw [← hy₀, h, map_zero])
  have hbase : ∀ z : MonoidAlgebra K (OneRelatorGroup r),
      (∀ g ∈ z.coeff.support, g ∈ N) → z * rootVec K r u x = 0 → z = 0 := by
    intro z hz hzy
    obtain ⟨z₀, hz₀⟩ :=
      (Work.ORReductions.SubgroupAlg.subgroupAlgMap_mem_range_iff N K z).mpr hz
    have h1 : (Work.ORReductions.subgroupAlgMap N K) (z₀ * y₀) = 0 := by
      rw [map_mul, hz₀, hy₀]
      exact hzy
    have h2 : z₀ * y₀ = 0 :=
      Work.ORReductions.SubgroupAlg.subgroupAlgMap_injective N K (by rw [h1, map_zero])
    rcases eq_zero_or_eq_zero_of_mul_eq_zero h2 with h | h
    · rw [← hz₀, h, map_zero]
    · exact absurd h hy₀ne
  intro b hb
  exact rightRegular_transport_subgroupAlgMap N (rootVec K r u x) hsupp hbase b
    (hb x (Set.mem_singleton x))

end Work.ORLyndon
