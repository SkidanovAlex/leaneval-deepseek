import Mathlib
import Submission.Work.ORLyndon.MagnusTwoTermDefs
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORLyndon.Tor1Vanishes_projective
import Submission.Work.ORLyndon.deltaYY_injective
import Submission.Work.ORLyndon.deltaYY_range
import Submission.Work.OROneRel.Interface

/-!
# The middle term of Claim 5.10 is free

Let `X` be a generating type, `K` a field, `r : F(X)` a relator, `G = ⟨X | r⟩`, `t : X` a
distinguished generator and `Y : Finset X` the remaining generators (`hY`: every generator outside
`Y` is `t`; `ht : t ∉ Y`).  Let `A = ⟨Y⟩ ≤ G` be the Magnus subgroup generated by the images of the
generators in `Y`, and assume the **Freiheitssatz** at `r` and `Y`
(`hinj : Function.Injective (presentedGroupMap r Y)`), so that `A` is free on `Y`.

The middle term of the Lyndon resolution of `⟨X | r⟩` is the free `K[G]`-module `K[G]^X`.  The
two-term form of Lyndon's identity theorem (JL Claim 5.10) rewrites it as `I^G_{K[A]} ⊕ K[G]` via
the `K[G]`-linear map

`magnusMiddleMap : K[G]^X → I^G_{K[A]} ⊕ K[G],  v ↦ (∑_{y ∈ Y} v_y (y - 1), v_t)`,

whose first component is `deltaYBar` (the `Y`-part of the Fox/Magnus map) and whose second
component is evaluation at `t`.

This file proves that `magnusMiddleMap` is a **linear equivalence** (this is the bijectivity
`Ψ` of `Work.ORLyndon.magnusTwoTerm_of_lyndon`, isolated here so that it can be reused), and
deduces the two consequences used by the flatness input of node N9:

* the middle term `I^G_{K[A]} ⊕ K[G]` is a **free** (hence projective) `K[G]`-module;
* therefore `Tor₁^{K[G]}(M, I^G_{K[A]} ⊕ K[G]) = 0` for every right `K[G]`-module `M`
  (JL Claim 5.8, `Work.ORLyndon.tor1Vanishes_magnusMiddle`), which is the hypothesis `hB` of
  `Work.ORFlatness.tor1Vanishes_diagonal_jl_right`.

## Main results

* `Work.ORLyndon.magnusMiddleMap` — the map `v ↦ (deltaYBar v, v t)`.
* `Work.ORLyndon.magnusMiddleMap_injective`, `Work.ORLyndon.magnusMiddleMap_surjective`.
* `Work.ORLyndon.magnusMiddleEquiv` — the linear equivalence `K[G]^X ≃ₗ I^G_{K[A]} ⊕ K[G]`.
* `Work.ORLyndon.magnusMiddle_projective`, `Work.ORLyndon.tor1Vanishes_magnusMiddle`.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace Work.ORLyndon

open MonoidAlgebra

universe u

variable {X : Type u} {K : Type u}

/-- The `K[G]`-linear map `K[G]^X → I^G_{K[A]} ⊕ K[G]` of the two-term form of Lyndon's identity
theorem (JL Claim 5.10): the first component is the Magnus/Fox map `deltaYBar` (whose image lies in
`I^G_{K[A]}`), the second is evaluation at the distinguished generator `t`.

For `A` the Magnus subgroup generated by `Y`, this map is a linear *equivalence*
(`Work.ORLyndon.magnusMiddleEquiv`) as soon as the Freiheitssatz holds at `Y`. -/
noncomputable def magnusMiddleMap [DecidableEq X] [Field K] (Y : Finset X) (t : X)
    (r : FreeGroup X) :
    (X →₀ MonoidAlgebra K (OneRelatorGroup r)) →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      (↥(augIdealIn K (magnusSub Y r)) × MonoidAlgebra K (OneRelatorGroup r)) where
  toFun v := (⟨deltaYBar (K := K) Y r v, by
      rw [deltaYBar_apply_def, ← deltaYY_range (K := K) Y r]
      exact LinearMap.mem_range_self _ _⟩, v t)
  map_add' v w := by
    apply Prod.ext
    · apply Subtype.ext
      simp only [Submodule.coe_add, map_add, Prod.fst_add]
    · simp only [Finsupp.add_apply, Prod.snd_add]
  map_smul' c v := by
    apply Prod.ext
    · apply Subtype.ext
      simp only [Submodule.coe_smul, map_smul, Prod.smul_fst]
      simp
    · simp [Finsupp.smul_apply]

@[simp] theorem magnusMiddleMap_fst [DecidableEq X] [Field K] (Y : Finset X) (t : X)
    (r : FreeGroup X) (v : X →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    ((magnusMiddleMap (K := K) Y t r v).1 : MonoidAlgebra K (OneRelatorGroup r)) =
      deltaYBar (K := K) Y r v := rfl

@[simp] theorem magnusMiddleMap_snd [DecidableEq X] [Field K] (Y : Finset X) (t : X)
    (r : FreeGroup X) (v : X →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    (magnusMiddleMap (K := K) Y t r v).2 = v t := rfl

/-- A vector `v : K[G]^X` whose `Y`-part and whose value at `t` both vanish is zero: every
generator outside `Y` equals `t`. -/
theorem magnusMiddleMap_vanishes [DecidableEq X] [Field K] (Y : Finset X) {t : X}
    (hY : ∀ x : X, x ∉ Y → x = t) (r : FreeGroup X)
    (v : X →₀ MonoidAlgebra K (OneRelatorGroup r))
    (hv : subtypeDomainLM (K := K) Y r v = 0) (hvt : v t = 0) : v = 0 := by
  classical
  apply Finsupp.ext
  intro x
  by_cases hx : x ∈ Y
  · have h := congrArg
      (fun z : (Y : Set X) →₀ MonoidAlgebra K (OneRelatorGroup r) => z ⟨x, hx⟩) hv
    rwa [subtypeDomainLM_apply] at h
  · rw [hY x hx]; exact hvt

/-- The `Y`-part of the vector obtained by embedding a `Y`-indexed family is the family itself. -/
theorem subtypeDomainLM_embDomain [DecidableEq X] [Field K] (Y : Finset X) (r : FreeGroup X)
    (c : (Y : Set X) →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    subtypeDomainLM (K := K) Y r
      (Finsupp.embDomain ⟨Subtype.val, Subtype.val_injective⟩ c) = c := by
  apply Finsupp.ext
  intro y
  rw [subtypeDomainLM_apply]
  exact Finsupp.embDomain_apply_self _ c y

/-- **Injectivity of the middle map** (the Freiheitssatz at `Y` makes the Magnus subgroup free, so
that `deltaYY` is injective): if `(deltaYBar v, v t) = 0` then `v = 0`. -/
theorem magnusMiddleMap_injective [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (hY : ∀ x : X, x ∉ Y → x = t) (r : FreeGroup X)
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r (Y : Set X))) :
    Function.Injective (magnusMiddleMap (K := K) Y t r) := by
  classical
  have hinjYY : Function.Injective (deltaYY (K := K) Y r) := deltaYY_injective Y r hinj
  intro v w hvw
  have h3 : subtypeDomainLM (K := K) Y r v = subtypeDomainLM (K := K) Y r w := by
    apply hinjYY
    have hv : deltaYBar (K := K) Y r v = deltaYBar (K := K) Y r w := by
      have h := congrArg (fun z : ↥(augIdealIn K (magnusSub Y r)) ×
          MonoidAlgebra K (OneRelatorGroup r) =>
        ((z.1 : ↥(augIdealIn K (magnusSub Y r))) : MonoidAlgebra K (OneRelatorGroup r))) hvw
      simpa using h
    show deltaYBar (K := K) Y r v = deltaYBar (K := K) Y r w
    exact hv
  have h2 : v t = w t := by
    rw [← magnusMiddleMap_snd Y t r v, ← magnusMiddleMap_snd Y t r w, hvw]
  exact sub_eq_zero.mp (magnusMiddleMap_vanishes Y hY r _
    (by rw [map_sub, h3, sub_self]) (by rw [Finsupp.sub_apply, h2, sub_self]))

/-- **Surjectivity of the middle map**: `I^G_{K[A]}` is the image of `deltaYY` (this is the
Freiheitssatz again, in the form `deltaYY_range`), so every pair `(α, b)` has a preimage. -/
theorem magnusMiddleMap_surjective [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (r : FreeGroup X) :
    Function.Surjective (magnusMiddleMap (K := K) Y t r) := by
  classical
  intro x
  obtain ⟨α, b⟩ := x
  have hα : (α : MonoidAlgebra K (OneRelatorGroup r)) ∈
      LinearMap.range (deltaYY (K := K) Y r) := by
    rw [deltaYY_range (K := K) Y r]; exact α.2
  obtain ⟨c, hc⟩ := hα
  refine ⟨Finsupp.embDomain ⟨Subtype.val, Subtype.val_injective⟩ c
    + Finsupp.single t (b - (Finsupp.embDomain ⟨Subtype.val, Subtype.val_injective⟩ c) t), ?_⟩
  apply Prod.ext
  · apply Subtype.ext
    rw [magnusMiddleMap_fst, deltaYBar_apply_def, map_add,
      subtypeDomainLM_embDomain, subtypeDomainLM_single_t Y ht r, add_zero, hc]
  · rw [magnusMiddleMap_snd, Finsupp.add_apply, Finsupp.single_eq_same, add_sub_cancel]

/-- **The middle term of Claim 5.10 is `K[G]^X`.**  The map `magnusMiddleMap` of the two-term form
of Lyndon's identity theorem is a linear equivalence
`K[G]^X ≃ₗ[K[G]] I^G_{K[A]} ⊕ K[G]`. -/
noncomputable def magnusMiddleEquiv [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (hY : ∀ x : X, x ∉ Y → x = t) (r : FreeGroup X)
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r (Y : Set X))) :
    (X →₀ MonoidAlgebra K (OneRelatorGroup r)) ≃ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      (↥(augIdealIn K (magnusSub Y r)) × MonoidAlgebra K (OneRelatorGroup r)) :=
  LinearEquiv.ofBijective (magnusMiddleMap (K := K) Y t r)
    ⟨magnusMiddleMap_injective Y ht hY r hinj, magnusMiddleMap_surjective Y ht r⟩

@[simp] theorem magnusMiddleEquiv_apply [DecidableEq X] [Field K] (Y : Finset X) {t : X}
    (ht : t ∉ Y) (hY : ∀ x : X, x ∉ Y → x = t) (r : FreeGroup X)
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r (Y : Set X)))
    (v : X →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    magnusMiddleEquiv Y ht hY r hinj v = magnusMiddleMap (K := K) Y t r v := rfl

/-- **JL Claim 5.8, structural form: the middle term of the transposed Claim 5.10 is projective**
(in fact free: it is isomorphic to `K[G]^X`). -/
theorem magnusMiddle_projective [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (hY : ∀ x : X, x ∉ Y → x = t) (r : FreeGroup X)
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r (Y : Set X))) :
    Module.Projective (MonoidAlgebra K (OneRelatorGroup r))
      (↥(augIdealIn K (magnusSub Y r)) × MonoidAlgebra K (OneRelatorGroup r)) :=
  Module.Projective.of_split (magnusMiddleEquiv Y ht hY r hinj).symm.toLinearMap
    (magnusMiddleEquiv Y ht hY r hinj).toLinearMap (by
      apply LinearMap.ext
      intro v
      simp)

/-- **JL Claim 5.8, the form consumed by node N9**: `Tor₁^{K[G]}` vanishes against the middle term
`I^G_{K[A]} ⊕ K[G]` of the transposed Claim 5.10 — for *every* right `K[G]`-module, since the
middle term is free. -/
theorem tor1Vanishes_magnusMiddle [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (hY : ∀ x : X, x ∉ Y → x = t) (r : FreeGroup X)
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r (Y : Set X)))
    (M : Type u) [AddCommGroup M]
    [Module ((MonoidAlgebra K (OneRelatorGroup r))ᵐᵒᵖ) M] :
    Work.ORFlatness.Tor1Vanishes (MonoidAlgebra K (OneRelatorGroup r)) M
      (↥(augIdealIn K (magnusSub Y r)) × MonoidAlgebra K (OneRelatorGroup r)) := by
  haveI : Module.Projective (MonoidAlgebra K (OneRelatorGroup r))
      (↥(augIdealIn K (magnusSub Y r)) × MonoidAlgebra K (OneRelatorGroup r)) :=
    magnusMiddle_projective Y ht hY r hinj
  exact tor1Vanishes_of_projective (MonoidAlgebra K (OneRelatorGroup r)) M

end Work.ORLyndon
