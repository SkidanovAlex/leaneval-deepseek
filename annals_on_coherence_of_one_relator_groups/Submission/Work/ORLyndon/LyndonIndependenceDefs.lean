import Mathlib
import Submission.Work.ORLyndon.Lyndon

/-!
# The Cohen--Lyndon independence of the conjugates of the relator

Let `X` be a type, `K` a field, `r u : F(X)` with `r = u ^ l`, `u` not a proper power and `r ≠ 1`,
and `G = ⟨X | r⟩` the one-relator group (`Work.ORLyndon.OneRelatorGroup r`).

The **Cohen--Lyndon theorem** (Cohen--Lyndon 1963; see also Karrass--Solitar 1972 and
Antolín--Dicks--Linnell) states that the normal closure of `r` in `F(X)` is freely generated by the
conjugates `t r t⁻¹` of a transversal `t` of the `N·C(r)`-cosets.  Transported to the relation
module it says, equivalently, that the classes `[t r t⁻¹]` are `ℤ`-linearly independent.

This module records the form in which the `N3` node consumes that theorem: the elements
`g • (∂r/∂x)_x` of `K[G]^X` attached to *distinct* `⟨u⟩`-cosets of `G` are `K`-linearly
independent.  (`g • relatorVec K r` is the image of `[g r g⁻¹]` under `θ`, and two group elements
give the same vector precisely when they lie in the same `⟨u⟩`-coset.)

## Main definitions

* `Work.ORLyndon.LyndonIndependence` -- the Cohen--Lyndon independence, in module form.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

variable {X : Type u} {K : Type v}

/-- **Cohen--Lyndon independence (module form).**  For a one-relator group `G = ⟨X | r⟩` with
`r = u ^ l`, `u` not a proper power, the vectors `g • (∂r/∂x)_x ∈ K[G]^X` attached to group elements
`g` in pairwise *distinct* `⟨u⟩`-cosets are `K`-linearly independent.

Equivalently (transporting along the identification of the relation module with `ker δ`): the
classes of the conjugates `g r g⁻¹` of `r`, for `g` ranging over the elements of a transversal of
the `⟨u⟩`-cosets, are `ℤ`-linearly independent in the relation module — the Cohen--Lyndon theorem. -/
def LyndonIndependence (K : Type v) [Field K] {X : Type u} [DecidableEq X]
    (r u : FreeGroup X) : Prop :=
  ∀ (ι : Type) [Fintype ι] (g : ι → OneRelatorGroup r) (c : ι → K),
    (∀ i j, i ≠ j → ∀ k : ℤ, g i ≠ g j * (presentRho r u) ^ k) →
    (∑ i, c i • ((MonoidAlgebra.of K (OneRelatorGroup r) (g i)) • relatorVec K r)) = 0 →
    ∀ i, c i = 0

/-- The **right coset** of the cyclic subgroup generated by `presentRho r u` through a group element
`g`, written as the finite set of the `l` elements `g * u ^ k` (`0 ≤ k < l`).  This is a genuine
coset of `⟨presentRho r u⟩` because `r = u ^ l` and `presentRho r r = 1`. -/
noncomputable def uCoset {X : Type u} [DecidableEq X] (r u : FreeGroup X) (l : ℕ)
    (g : OneRelatorGroup r) : Finset (OneRelatorGroup r) := by
  classical
  exact (Finset.univ : Finset (Fin l)).image (fun k : Fin l => g * (presentRho r u) ^ (k : ℕ))

@[simp] theorem mem_uCoset {X : Type u} [DecidableEq X] (r u : FreeGroup X) (l : ℕ)
    (g h : OneRelatorGroup r) :
    h ∈ uCoset r u l g ↔ ∃ k : ℕ, k < l ∧ h = g * (presentRho r u) ^ k := by
  classical
  simp only [uCoset, Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨k, rfl⟩
    exact ⟨(k : ℕ), k.2, rfl⟩
  · rintro ⟨k, hk, rfl⟩
    exact ⟨⟨k, hk⟩, rfl⟩

end Work.ORLyndon
