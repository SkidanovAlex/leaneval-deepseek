import Mathlib
import Submission.Work.ORLyndon.BalTensorQuotDefs
import Submission.Work.ORFlatness.Tensor
import Submission.Work.ORLyndon.balTensor_fwdMap
import Submission.Work.ORLyndon.balTensor_bwdMap

/-!
# `X ⊗_R (R/I) ≅ X / X·I`

For a ring `R`, an ideal `I ≤ R` and a right `R`-module `X`, the balanced tensor product
`X ⊗_R (R/I)` is the quotient of `X` by the submodule generated by the products `x·i`
(`x ∈ X`, `i ∈ I`):

  `X ⊗_R (R/I) ≅ X ⧸ X·I`.

The isomorphism is induced by the balanced, ℤ-bilinear map `(x, r) ↦ x·r`, whose inverse
sends `x` to `x ⊗ 1`.  This is the "tensoring with a quotient" computation used to identify
the relation module `K[G] ⊗_{K⟨u⟩} K` of a one-relator presentation with
`K[G] ⧸ K[G]·(u - 1)`.
-/

set_option autoImplicit false

open MulOpposite

universe u

namespace Work.ORLyndon

open Work.ORFlatness

/-- The balanced tensor product `X ⊗_R (R/I)` of a right `R`-module `X` with the quotient
`R/I` is the quotient of `X` by the submodule `X·I` generated by the products `x·i`. -/
theorem balTensor_quot_equiv (R : Type u) [Ring R] (I : Ideal R) (X : Type u) [AddCommGroup X]
    [Module Rᵐᵒᵖ X] :
    Nonempty (Work.ORFlatness.BalTensor R X (R ⧸ I) ≃+ (X ⧸ Work.ORLyndon.balImage R I X)) := by
  -- the map `BalTensor R X (R ⧸ I) → X ⧸ X·I` induced by `(x, r) ↦ x·r`
  obtain ⟨f, hf⟩ := balTensor_fwdMap R I X
  -- the map `X ⧸ X·I → BalTensor R X (R ⧸ I)` induced by `x ↦ x ⊗ 1`
  obtain ⟨g, hg⟩ := balTensor_bwdMap R I X
  -- `s • 1 = mk s` in `R ⧸ I`
  have hsmul : ∀ (s : R), (s • (1 : R ⧸ I)) = Submodule.Quotient.mk s := by
    intro s
    change s • (Submodule.Quotient.mk (1 : R) : R ⧸ I) = Submodule.Quotient.mk s
    rw [← Submodule.Quotient.mk_smul (p := (I : Submodule R R)) s (1 : R)]
    change Submodule.Quotient.mk (s * 1) = Submodule.Quotient.mk s
    rw [mul_one]
  -- the bilinear map `f` is balanced
  have hbal : ∀ (x : X) (n : R ⧸ I) (r : R), (f (op r • x)) n = (f x) (r • n) := by
    intro x n r
    refine Submodule.Quotient.induction_on (p := (I : Submodule R R)) n ?_
    intro s
    rw [hf (op r • x) s, ← Submodule.Quotient.mk_smul (p := (I : Submodule R R)) r s,
      hf x (r • s)]
    congr 1
    rw [← mul_smul]
    rfl
  let F : BalTensor R X (R ⧸ I) →+ (X ⧸ balImage R I X) := BalTensor.lift R f hbal
  have hF : ∀ (x : X) (n : R ⧸ I), F (BalTensor.mk R x n) = f x n :=
    fun x n => BalTensor.lift_mk R f hbal x n
  have hGF : g.comp F = AddMonoidHom.id _ := by
    refine BalTensor.ext R ?_
    intro x n
    rw [AddMonoidHom.comp_apply, hF, AddMonoidHom.id_apply]
    refine Submodule.Quotient.induction_on (p := (I : Submodule R R)) n ?_
    intro s
    rw [hf x s, hg (op s • x), BalTensor.mk_smul_right R x (1 : R ⧸ I) s, hsmul s]
  have hFg : F.comp g = AddMonoidHom.id _ := by
    refine AddMonoidHom.ext (fun y => ?_)
    refine Submodule.Quotient.induction_on (p := balImage R I X) y ?_
    intro x
    rw [AddMonoidHom.comp_apply, hg x, hF, AddMonoidHom.id_apply]
    conv_lhs => rw [show (1 : R ⧸ I) = Submodule.Quotient.mk (1 : R) from rfl]
    rw [hf x 1]
    congr 1
    simp
  exact ⟨{ toFun := F, invFun := g,
           left_inv := fun z => congrFun (congrArg DFunLike.coe hGF) z,
           right_inv := fun y => congrFun (congrArg DFunLike.coe hFg) y,
           map_add' := fun a b => map_add F a b }⟩

end Work.ORLyndon
