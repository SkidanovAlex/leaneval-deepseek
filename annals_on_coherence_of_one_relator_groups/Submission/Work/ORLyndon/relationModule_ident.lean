import Mathlib
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORLyndon.augIdealIn_eq_span
import Submission.Work.ORLyndon.deltaYY_range
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.BalTensorQuotDefs

/-!
# Identifications of the relation module of a one-relator presentation

The relation module of the presentation `⟨X | r⟩` with `r = u ^ l` is

`relationModule K r u = K[G] ⧸ Ideal.span {of (ρ u) - 1}`,

the quotient of `K[G]` by the (left) ideal generated by `u - 1`.  This file identifies it with the
other standard descriptions used in the paper:

* as `K[G] ⧸ I^G_{K[⟨u⟩]}`, the quotient by the left ideal generated by the augmentation ideal of
  the cyclic subgroup `⟨u⟩` (`Work.ORLyndon.relationModule_quot_augIdealIn`), i.e. the invariance of
  the relation module under the choice of generator of the annihilator
  (`Work.ORLyndon.augIdealIn_closure_singleton`);
* as the balanced tensor product `K[G] ⊗_{K⟨u⟩} K` (see
  `Submission/Work/ORLyndon/relationModule_balTensor.lean`), which is the first term
  `K[G] ⊗_{K⟨u⟩} K` of the Lyndon sequence
  `0 → K[G] ⊗_{K⟨u⟩} K → K[G]^X → K[G] → K → 0`
  (`Work.ORLyndon.lyndon_exact_relationModuleMap`).
-/

set_option autoImplicit false

open MonoidAlgebra

universe u

namespace Work.ORLyndon

/-- **`I^G_{K[⟨g⟩]}` is generated by `g - 1`.**  For a single generator `g`, the left ideal of
`K[G]` generated by the augmentation ideal of `K[⟨g⟩]` is just the principal left ideal generated by
`of g - 1`.

The set of `y : G` with `of y - 1 ∈ Ideal.span {of g - 1}` is a subgroup containing `g` (it is
closed under multiplication and inversion, using `of y - 1 = of a * (of b - 1) + (of a - 1)` for
`y = a * b` and `of a⁻¹ - 1 = -(of a⁻¹) * (of a - 1)`), hence contains `⟨g⟩`; the reverse
inclusion is the generator itself. -/
theorem augIdealIn_closure_singleton {K : Type u} [CommRing K] {G : Type u} [Group G] (g : G) :
    augIdealIn K (Subgroup.closure ({g} : Set G)) = Ideal.span {((MonoidAlgebra.of K G) g) - 1} := by
  classical
  set I : Ideal (MonoidAlgebra K G) := Ideal.span {((MonoidAlgebra.of K G) g) - 1} with hI
  have hgI : ((MonoidAlgebra.of K G) g) - 1 ∈ I := Ideal.subset_span (Set.mem_singleton _)
  let S : Subgroup G :=
    { carrier := {y : G | ((MonoidAlgebra.of K G) y) - 1 ∈ I}
      mul_mem' := by
        intro a b ha hb
        change ((MonoidAlgebra.of K G) (a * b)) - 1 ∈ I
        have hmul : ((MonoidAlgebra.of K G) (a * b)) - 1 =
            (MonoidAlgebra.of K G) a * (((MonoidAlgebra.of K G) b) - 1) +
              (((MonoidAlgebra.of K G) a) - 1) := by
          rw [map_mul, mul_sub, mul_one]
          abel
        rw [hmul]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hb) ha
      one_mem' := by
        change ((MonoidAlgebra.of K G) (1 : G)) - 1 ∈ I
        rw [map_one, sub_self]
        exact Ideal.zero_mem _
      inv_mem' := by
        intro a ha
        change ((MonoidAlgebra.of K G) a⁻¹) - 1 ∈ I
        have h2 : ((MonoidAlgebra.of K G) a⁻¹) * ((MonoidAlgebra.of K G) a) = 1 := by
          rw [← map_mul, inv_mul_cancel, map_one]
        have hinv : ((MonoidAlgebra.of K G) a⁻¹) - 1 =
            -(((MonoidAlgebra.of K G) a⁻¹) * (((MonoidAlgebra.of K G) a) - 1)) := by
          rw [mul_sub, mul_one, h2, neg_sub]
        rw [hinv]
        exact neg_mem (Ideal.mul_mem_left _ _ ha) }
  have hle : Subgroup.closure ({g} : Set G) ≤ S := by
    refine (Subgroup.closure_le (K := S)).mpr ?_
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact hgI
  rw [augIdealIn_eq_span]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro y ⟨h, rfl⟩
    exact hle h.2
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.subset_span ⟨⟨g, Subgroup.subset_closure (Set.mem_singleton g)⟩, rfl⟩

/-- **The relation module is `K[G] ⧸ I^G_{K[⟨u⟩]}`**: the quotient by the principal ideal generated
by `u - 1` is the quotient by the left ideal generated by the augmentation ideal of the cyclic
subgroup `⟨u⟩` (the two ideals are equal by
`Work.ORLyndon.augIdealIn_closure_singleton`).  This is the identification of the relation module
with `K[G] ⊗_{K⟨u⟩} K` (JL's `K[G]/(u-1)K[G]`). -/
theorem relationModule_eq_quot_augIdealIn {K : Type u} [Field K] {X : Type u} [DecidableEq X]
    (r u : FreeGroup X) :
    Nonempty (relationModule K r u ≃ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      (MonoidAlgebra K (OneRelatorGroup r) ⧸
        augIdealIn K (Subgroup.closure ({presentRho r u} : Set (OneRelatorGroup r))))) :=
  ⟨Submodule.quotEquivOfEq _ _
    (augIdealIn_closure_singleton (K := K) (g := presentRho r u)).symm⟩

end Work.ORLyndon
