import Mathlib
import Submission.Work.ORLyndon.BalTensorQuotDefs
import Submission.Work.ORLyndon.balTensor_quot_equiv
import Submission.Work.ORLyndon.relationModule_ident

/-!
# The relation module as a balanced tensor product

For a one-relator presentation `⟨X | r⟩` with root `u` (i.e. `r` a power of `u`), the relation
module `K[G]/K[G](u - 1)` of the presentation is the balanced tensor product

  `K[G] ⊗_{K⟨u⟩} K`,

the first term of the Lyndon sequence `0 → K[G] ⊗_{K⟨u⟩} K → K[G]^X → K[G] → K → 0`.

The identification is obtained by tensoring the exact sequence `0 → I_{K[⟨u⟩]} → K[⟨u⟩] → K → 0`
with the right `K[⟨u⟩]`-module `K[G]`:  writing `H = ⟨u⟩` and `φ : K[H] → K[G]` for the inclusion,
the image of `X·I` under the natural map `X ⊗_{K[H]} K[H] → X` (`Work.ORLyndon.balTensor_quot_equiv`)
is the ℤ-submodule of `K[G]` generated by the products `x * φ(i)` (`x ∈ K[G]`, `i ∈ I_{K[H]}`),
which is the ideal of `K[G]` generated by the augmentation ideal of `K[H]`.  For the cyclic group
`H = ⟨u⟩` that ideal is the principal ideal generated by `u - 1`
(`Work.ORLyndon.augIdealIn_closure_singleton`), i.e. the kernel of `K[G] → relationModule K r u`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

open MonoidAlgebra MulOpposite

universe u

namespace Work.ORLyndon

/-- For a ring homomorphism `φ : R →+* S` equipped with the right `R`-module structure
`op r • x = x * φ r` on `S`, and an ideal `I ≤ R`, the ℤ-submodule `S·I = ` `balImage R I S` of `S`
generated by the products `x * φ i` (`x ∈ S`, `i ∈ I`) is the ideal of `S` generated by the image
`φ '' I`, viewed as a ℤ-submodule.

Both sides are the ℤ-span of the products `x * φ i`: the ideal generated by `φ '' I` consists of
the (finite) sums of products `x * φ i` with `x ∈ S`, `i ∈ I`. -/
theorem balImage_eq_restrictScalars_span {R S : Type u} [Ring R] [Ring S] (φ : R →+* S)
    [Module Rᵐᵒᵖ S] (hφ : ∀ (r : R) (x : S), op r • x = x * φ r) (I : Ideal R) :
    balImage R I S = (Ideal.span (φ '' (I : Set R))).restrictScalars ℤ := by
  refine le_antisymm ?_ ?_
  · -- every generator `x * φ i` (`x ∈ S`, `i ∈ I`) lies in the ideal generated by `φ '' I`
    rw [balImage_le_iff]
    intro x i
    rw [hφ i x]
    exact Submodule.smul_mem _ x (Ideal.subset_span ⟨i, i.2, rfl⟩)
  · -- conversely, the ideal generated by `φ '' I` is spanned by products `x * φ i`, all of which
    -- lie in `balImage R I S`; the induction hypothesis is that the whole principal `S`-span of `x`
    -- lies in `balImage`
    intro x hx
    suffices h : ∀ c : S, c • x ∈ balImage R I S by simpa using h 1
    refine Submodule.span_induction (R := S) (M := S) (s := φ '' (I : Set R))
      (p := fun x _ => ∀ c : S, c • x ∈ balImage R I S) ?_ ?_ ?_ ?_ hx
    · rintro y ⟨i, hi, rfl⟩ c
      rw [smul_eq_mul, ← hφ i c]
      exact Submodule.subset_span ⟨(c, ⟨i, hi⟩), rfl⟩
    · intro c
      simp
    · intro y z hy hz hy' hz' c
      rw [smul_add]
      exact Submodule.add_mem _ (hy' c) (hz' c)
    · intro a y hy hy' c
      have h1 : c • (a • y) = (c * a) • y := by simp only [smul_eq_mul, mul_assoc]
      rw [h1]
      exact hy' (c * a)

/-- **The relation module of a one-relator presentation is a balanced tensor product.**

For the presentation `⟨X | r⟩` with root `u`, the quotient `K[G] ⊗_{K⟨u⟩} K` of the first term of
the Lyndon sequence is the relation module `K[G]/K[G](u - 1)`.

Indeed, by `Work.ORLyndon.balTensor_quot_equiv` the balanced tensor product
`K[G] ⊗_{K[H]} (K[H] ⧸ I_{K[H]})` (`H = ⟨u⟩`) is the quotient of `K[G]` by the ℤ-submodule
generated by the products `x * h` (`x ∈ K[G]` acting on the right, `h ∈ I_{K[H]}`), and by
`Work.ORLyndon.balImage_eq_restrictScalars_span` this is the ideal of `K[G]` generated by the
augmentation ideal of `K[H]`, i.e. `K[G](u - 1)` (`Work.ORLyndon.augIdealIn_closure_singleton`). -/
theorem relationModule_balTensor {K : Type u} [Field K] {X : Type u} [DecidableEq X]
    (r u : FreeGroup X) :
    Nonempty (Work.ORLyndon.relationModuleTensor K r u ≃+ Work.ORLyndon.relationModule K r u) := by
  classical
  let H := Subgroup.closure ({presentRho r u} : Set (OneRelatorGroup r))
  -- the right `K[H]`-module structure on `K[G]` is `x · h = x * φ h`
  letI := subgroupRightModule K H
  have hφ : ∀ (a : MonoidAlgebra K H) (x : MonoidAlgebra K (OneRelatorGroup r)),
      (op a) • x = x * MonoidAlgebra.mapDomainRingHom K H.subtype a := fun _ _ => rfl
  -- `K[G] · I_{K[H]}` is the ideal of `K[G]` generated by the image of `I_{K[H]}`
  have hgen := @balImage_eq_restrictScalars_span (MonoidAlgebra K H)
    (MonoidAlgebra K (OneRelatorGroup r)) _ _ (MonoidAlgebra.mapDomainRingHom K H.subtype)
    (subgroupRightModule K H) hφ (augIdeal K H)
  -- ... which for the cyclic group `H = ⟨u⟩` is the principal ideal `(u - 1)`
  have hspan : Ideal.span (MonoidAlgebra.mapDomainRingHom K H.subtype ''
        (augIdeal K H : Set (MonoidAlgebra K H)))
      = Ideal.span {((MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u)) - 1} :=
    augIdealIn_closure_singleton (K := K) (g := presentRho r u)
  have h : balImage (MonoidAlgebra K H) (augIdeal K H) (MonoidAlgebra K (OneRelatorGroup r))
      = (Ideal.span {((MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u)) - 1}).restrictScalars
          ℤ := by
    rw [hgen, hspan]
  -- tensoring `0 → I_{K[H]} → K[H] → K → 0` with the right `K[H]`-module `K[G]`
  obtain ⟨e1⟩ := balTensor_quot_equiv (MonoidAlgebra K H) (augIdeal K H)
    (MonoidAlgebra K (OneRelatorGroup r))
  have e2 := Submodule.quotEquivOfEq
    (balImage (MonoidAlgebra K H) (augIdeal K H) (MonoidAlgebra K (OneRelatorGroup r)))
    ((Ideal.span {((MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u)) - 1}).restrictScalars
      ℤ) h
  exact ⟨e1.trans e2.toAddEquiv⟩

end Work.ORLyndon
