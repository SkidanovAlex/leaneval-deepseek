import Mathlib
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORFlatness.Tensor

/-!
# Definitions for the identification `K[G] ⊗_{K[H]} K ≅ K[G]/K[G]·I_{K[H]}`

This file contains the *definitions* (no proofs) used to state the identification of the
relation module of a one-relator presentation with the balanced tensor product
`K[G] ⊗_{K⟨u⟩} K` (JL's `K[G]/(u-1)K[G]`).

* `Work.ORLyndon.balImage R I X`: for a ring `R`, an ideal `I ≤ R` and a right `R`-module `X`,
  the ℤ-submodule `X·I` of `X` generated by the products `x·i` (`x ∈ X`, `i ∈ I`).  The
  quotient `X ⧸ X·I` is `X ⊗_R (R/I)`.
* `Work.ORLyndon.subgroupRightModule K H`: the right `K[H]`-module structure on `K[G]`
  (`H ≤ G`), i.e. restriction of scalars along `K[H] → K[G]` on the right.
* `Work.ORLyndon.trivialLeftModule K H`: the left `K[H]`-module structure on the quotient
  `K[H] ⧸ I_{K[H]}` (the trivial module), which is `K` via the augmentation.

These are the data in which `Submission/Work/ORLyndon/balTensor_quot_equiv.lean` and
`Submission/Work/ORLyndon/relationModule_balTensor.lean` state their results.
-/

set_option autoImplicit false

open MonoidAlgebra MulOpposite

universe u

namespace Work.ORLyndon

/-- For a ring `R`, an ideal `I ≤ R` and a right `R`-module `X`: the ℤ-submodule `X·I` of `X`
generated by the products `x·i` (`x ∈ X`, `i ∈ I`).  The quotient `X ⧸ X·I` is the balanced
tensor product `X ⊗_R (R / I)` (`Work.ORLyndon.balTensor_quot_equiv`). -/
def balImage (R : Type u) [Ring R] (I : Ideal R) (X : Type u) [AddCommGroup X]
    [Module Rᵐᵒᵖ X] : Submodule ℤ X :=
  Submodule.span ℤ (Set.range fun p : X × I => op (p.2 : R) • p.1)

/-- For a ring `R`, an ideal `I ≤ R` and a right `R`-module `X`, every generator of the
submodule `Work.ORLyndon.balImage R I X` is a product `x·i`. -/
theorem balImage_le_iff {R : Type u} [Ring R] (I : Ideal R) (X : Type u) [AddCommGroup X]
    [Module Rᵐᵒᵖ X] (N : Submodule ℤ X) :
    balImage R I X ≤ N ↔ ∀ (x : X) (i : I), op (i : R) • x ∈ N := by
  constructor
  · intro h x i
    exact h (Submodule.subset_span ⟨(x, i), rfl⟩)
  · intro h
    rw [balImage, Submodule.span_le]
    rintro z ⟨⟨x, i⟩, rfl⟩
    exact h x i

/-- `K[G]` as a **right** module over `K[H]` (`H ≤ G`): restriction of scalars along the ring
homomorphism `K[H] → K[G]` induced by the inclusion `H ≤ G`, on the right. -/
noncomputable def subgroupRightModule (K : Type u) [CommRing K] {G : Type u} [Group G]
    (H : Subgroup G) : Module ((MonoidAlgebra K H)ᵐᵒᵖ) (MonoidAlgebra K G) :=
  Module.compHom (MonoidAlgebra K G)
    (RingHom.op (MonoidAlgebra.mapDomainRingHom K H.subtype))

/-- The **trivial** left `K[H]`-module structure on `K`: the augmentation
`ε : K[H] →+* K` acting on the left. -/
noncomputable def trivialLeftModule (K : Type u) [CommRing K] {G : Type u} [Group G]
    (H : Subgroup G) : Module (MonoidAlgebra K H) K :=
  Module.compHom K (augmentation K H).toRingHom

/-- **The relation module as a balanced tensor product**: for the one-relator presentation
`⟨X | r⟩` with root `u`, this is the balanced tensor product

`K[G] ⊗_{K⟨u⟩} K[G]/I_{K[⟨u⟩]}`

of `K[G]` (a right `K[⟨u⟩]`-module, on the right) with the trivial left `K[⟨u⟩]`-module
`K[⟨u⟩]/I_{K[⟨u⟩]}`.  It is the first term `K[G] ⊗_{K⟨u⟩} K` of the Lyndon sequence.
`Work.ORLyndon.relationModule_balTensor` identifies it with `relationModule K r u`. -/
noncomputable abbrev relationModuleTensor (K : Type u) [Field K] {X : Type u} [DecidableEq X]
    (r u : FreeGroup X) : Type u :=
  @Work.ORFlatness.BalTensor
    (MonoidAlgebra K (Subgroup.closure ({presentRho r u} : Set (OneRelatorGroup r))))
    (inferInstance)
    (MonoidAlgebra K (OneRelatorGroup r))
    (inferInstance)
    (subgroupRightModule K (Subgroup.closure ({presentRho r u} : Set (OneRelatorGroup r))))
    ((MonoidAlgebra K (Subgroup.closure ({presentRho r u} : Set (OneRelatorGroup r)))) ⧸
      (augIdeal K (Subgroup.closure ({presentRho r u} : Set (OneRelatorGroup r)))))
    (inferInstance)
    (inferInstance)

end Work.ORLyndon
