import Mathlib
import Submission.Work.ORLyndon.augIdealIn_eq_span
import Submission.Work.ORLyndon.Augmentation

/-!
# A finitely supported sum of `d * (σ x - 1)` lies in `I^G_{K[H]}`

Let `H ≤ G`, `σ : X → G` a map sending every `x ≠ i` into `H`, and `D : X →₀ K[G]`.  Then the
finite sum
`∑_{x ≠ i} D x * (of K G (σ x) - 1)`
lies in `I^G_{K[H]}`, the left ideal of `K[G]` generated by the augmentation ideal of `K[H]`.

Indeed, `I^G_{K[H]}` is spanned by `{of K G h - 1 : h ∈ H}` (`augIdealIn_eq_span`), each
summand has its right factor `of K G (σ x) - 1` in that spanning set (as `σ x ∈ H` for `x ≠ i`)
and the sum is taken over the support of `D.erase i`, which avoids `i`; an ideal is closed under
left multiplication and finite sums.
-/

namespace Work.ORLyndon

open MonoidAlgebra

theorem finsupp_erase_sum_mem_augIdealIn {K : Type*} [CommRing K] {G : Type*} [Group G]
    {X : Type*} [DecidableEq X] (H : Subgroup G) (σ : X → G) (i : X)
    (hσ : ∀ x, x ≠ i → σ x ∈ H) (D : X →₀ MonoidAlgebra K G) :
    (D.erase i).sum (fun x d => d * ((MonoidAlgebra.of K G) (σ x) - 1)) ∈
      Work.ORLyndon.augIdealIn K H := by
  classical
  rw [Work.ORLyndon.augIdealIn_eq_span]
  rw [Finsupp.sum]
  apply Submodule.sum_mem
  intro x hx
  rw [Finsupp.mem_support_iff] at hx
  have hxi : x ≠ i := fun h => hx (by rw [h, Finsupp.erase_same])
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨σ x, hσ x hxi⟩, rfl⟩)

end Work.ORLyndon
