import Mathlib
import Submission.Work.ORLyndon.Fox
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORLyndon.Fox.fundamental_identity_map

/-!
# The Lyndon resolution of a one-relator group

Let `X` be a set, `K` a field and `r : F(X)` a relator, and let `G = ⟨X | r⟩` be the associated
one-relator group (`Work.ORLyndon.OneRelatorGroup`).  This file sets up the *Lyndon complex*

`0 → K[G] ⊗_{K⟨u⟩} K → K[G]^X → K[G] → K → 0`

of the one-relator presentation, where the middle map `θ` (`Work.ORLyndon.lyndonTheta`) is given by
the Fox derivative vector `(∂r/∂x)_x` of the relator and the map `δ`
(`Work.ORLyndon.lyndonDelta`) is given by `(a_x) ↦ Σ_x a_x (x - 1)`.

The formal part of the theory is proved here (`δ ∘ θ = 0`, the surjectivity of `δ` onto the
augmentation ideal, and the identification of the cokernel of `θ` with the relation module).  The
mathematical content of Lyndon's identity theorem -- that the relation module of the presentation
is the cyclic module generated by the Fox derivative vector with annihilator `K[G](u-1)` -- is
packaged in the hypothesis structure `Work.ORLyndon.LyndonIdentity`; everything proved from it is
stated with that structure as an explicit hypothesis, so that this file is independent of the
(separately developed) one-relator combinatorics.

## Main definitions

* `Work.ORLyndon.OneRelatorGroup`: the group `⟨X | r⟩`.
* `Work.ORLyndon.presentRho`, `Work.ORLyndon.presentAlg`: the maps `F(X) →* G`, `K[F(X)] →+* K[G]`.
* `Work.ORLyndon.relatorVec`: the Fox derivative vector `(∂r/∂x)_x ∈ K[G]^X`.
* `Work.ORLyndon.lyndonTheta`, `Work.ORLyndon.lyndonDelta`: the maps `θ` and `δ`.
* `Work.ORLyndon.relationModule`: the relation module `K[G]/K[G](u-1)` of `⟨X | r = u^l⟩`.
* `Work.ORLyndon.LyndonIdentity`: the hypothesis structure for Lyndon's identity theorem.

## Main results

* `Work.ORLyndon.lyndonDelta_comp_lyndonTheta`: `δ ∘ θ = 0`.
* `Work.ORLyndon.lyndonDelta_relatorVec`: `δ (∂r/∂x)_x = 0`.
* `Work.ORLyndon.LyndonIdentity.ker_theta`, `Work.ORLyndon.LyndonIdentity.range_theta`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

variable {X : Type u} {K : Type v}

section Defs

variable [Field K] [DecidableEq X]

/-- The one-relator group `⟨X | r⟩` presented by a set of generators `X` and a single relator `r`. -/
abbrev OneRelatorGroup (r : FreeGroup X) : Type u := PresentedGroup ({r} : Set (FreeGroup X))

/-- The canonical surjection `F(X) →* ⟨X | r⟩`. -/
def presentRho (r : FreeGroup X) : FreeGroup X →* OneRelatorGroup r := PresentedGroup.mk {r}

@[simp] theorem presentRho_apply (r : FreeGroup X) (w : FreeGroup X) :
    presentRho r w = PresentedGroup.mk {r} w := rfl

@[simp] theorem presentRho_of (r : FreeGroup X) (x : X) :
    presentRho r (FreeGroup.of x) = PresentedGroup.of x := rfl

/-- The distinguished relator is trivial in the presented group. -/
@[simp] theorem presentRho_relator (r : FreeGroup X) : presentRho r r = 1 :=
  PresentedGroup.one_of_mem (Set.mem_singleton r)

/-- The algebra map `K[F(X)] →+* K[⟨X | r⟩]` induced by the presentation. -/
noncomputable def presentAlg (K : Type v) [Field K] (r : FreeGroup X) :
    MonoidAlgebra K (FreeGroup X) →+* MonoidAlgebra K (OneRelatorGroup r) :=
  MonoidAlgebra.mapDomainRingHom K (presentRho r)

theorem presentAlg_single (K : Type v) [Field K] (r w : FreeGroup X) (c : K) :
    presentAlg K r (MonoidAlgebra.single w c) = MonoidAlgebra.single (presentRho r w) c := by
  change MonoidAlgebra.mapDomain (presentRho r) (MonoidAlgebra.single w c) = _
  rw [MonoidAlgebra.mapDomain_single]

theorem presentAlg_of (K : Type v) [Field K] (r w : FreeGroup X) :
    presentAlg K r ((MonoidAlgebra.of K (FreeGroup X)) w) =
      (MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r w) := by
  rw [MonoidAlgebra.of_apply, MonoidAlgebra.of_apply, presentAlg_single]

@[simp] theorem presentAlg_relator (K : Type v) [Field K] (r : FreeGroup X) :
    presentAlg K r ((MonoidAlgebra.of K (FreeGroup X)) r) = 1 := by
  rw [presentAlg_of, presentRho_relator, map_one]

/-- The Fox derivative vector `(∂r/∂x)_x` of the relator, as an element of `K[G]^X`. -/
noncomputable def relatorVec (K : Type v) [Field K] (r : FreeGroup X) :
    X →₀ MonoidAlgebra K (OneRelatorGroup r) :=
  (foxFD (K := K) r).mapRange (presentAlg K r) (map_zero _)

@[simp] theorem relatorVec_apply (K : Type v) [Field K] (r : FreeGroup X) (x : X) :
    relatorVec K r x = presentAlg K r (foxD (K := K) x r) := by
  rw [relatorVec, Finsupp.mapRange_apply, foxFD_apply]

/-- The first map `θ : K[G] → K[G]^X` of the Lyndon resolution, `a ↦ a • (∂r/∂x)_x`. -/
noncomputable def lyndonTheta (K : Type v) [Field K] (r : FreeGroup X) :
    MonoidAlgebra K (OneRelatorGroup r) →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      (X →₀ MonoidAlgebra K (OneRelatorGroup r)) :=
  LinearMap.toSpanSingleton (MonoidAlgebra K (OneRelatorGroup r)) _ (relatorVec K r)

@[simp] theorem lyndonTheta_apply (K : Type v) [Field K] (r : FreeGroup X)
    (a : MonoidAlgebra K (OneRelatorGroup r)) :
    lyndonTheta K r a = a • relatorVec K r :=
  LinearMap.toSpanSingleton_apply _ _ _ _

@[simp] theorem lyndonTheta_one (K : Type v) [Field K] (r : FreeGroup X) :
    lyndonTheta K r 1 = relatorVec K r := by
  rw [lyndonTheta_apply, one_smul]

/-- The second map `δ : K[G]^X → K[G]` of the Lyndon resolution, `(a_x) ↦ Σ_x a_x (x - 1)`. -/
noncomputable def lyndonDelta (K : Type v) [Field K] (r : FreeGroup X) :
    (X →₀ MonoidAlgebra K (OneRelatorGroup r)) →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      MonoidAlgebra K (OneRelatorGroup r) :=
  Finsupp.lsum (MonoidAlgebra K (OneRelatorGroup r))ᵐᵒᵖ
    (fun x => LinearMap.mulRight (MonoidAlgebra K (OneRelatorGroup r))
      (presentAlg K r ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of x)) - 1))

theorem lyndonDelta_apply (K : Type v) [Field K] (r : FreeGroup X)
    (a : X →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    lyndonDelta K r a = a.sum (fun x c =>
      c * (presentAlg K r ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of x)) - 1)) := by
  rw [lyndonDelta, Finsupp.lsum_apply]
  exact Finsupp.sum_congr (fun x _ => by rw [LinearMap.mulRight_apply])

/-- The fundamental identity of the Fox calculus says that the composite `δ ∘ θ` vanishes. -/
theorem lyndonDelta_relatorVec (K : Type v) [Field K] (r : FreeGroup X) :
    lyndonDelta K r (relatorVec K r) = 0 := by
  rw [lyndonDelta_apply,
    show relatorVec K r = (foxFD (K := K) r).mapRange (presentAlg K r) (map_zero _) from rfl,
    Work.ORLyndon.Fox.fundamental_identity_map (K := K) (presentAlg K r) r, presentAlg_relator]
  simp

/-- The Lyndon complex is a complex: `δ ∘ θ = 0`. -/
theorem lyndonDelta_comp_lyndonTheta (K : Type v) [Field K] (r : FreeGroup X) :
    (lyndonDelta K r).comp (lyndonTheta K r) = 0 := by
  ext a
  rw [LinearMap.comp_apply, LinearMap.zero_apply, lyndonTheta_apply, map_smul,
    lyndonDelta_relatorVec, smul_zero]

section RelationModule

/-- `u` is not a proper power in the free group `F(X)`. -/
def IsNotProperPower (u : FreeGroup X) : Prop :=
  ∀ (v : FreeGroup X) (k : ℕ), 2 ≤ k → u ≠ v ^ k

end RelationModule

/-- The **Lyndon identity theorem** for the one-relator presentation `⟨X | r⟩` with `r = u ^ l`,
where `u` is not a proper power.  It says that the *relation module* of the presentation is the
cyclic module generated by the Fox derivative vector, with annihilator the left ideal generated by
`u - 1`: `range θ = ker δ` and `ker θ = K[G](u - 1)`.

This is the mathematical input of the one-relator theory (Lyndon 1950); it is stated here as a
hypothesis structure so that the formal theory of the Lyndon resolution can be developed
independently of it. -/
structure LyndonIdentity (K : Type v) [Field K] (X : Type u) [DecidableEq X]
    (r u : FreeGroup X) (l : ℕ) : Prop where
  /-- the exponent `l` is positive -/
  hpos : 0 < l
  /-- `r` is the `l`-th power of the root `u` -/
  hpow : r = u ^ l
  /-- the root `u` is not a proper power -/
  hnotProperPower : IsNotProperPower u
  /-- the relation module is generated by the Fox derivative vector -/
  range_theta : LinearMap.range (lyndonTheta K r) = LinearMap.ker (lyndonDelta K r)
  /-- the annihilator of the Fox derivative vector is the ideal generated by `u - 1` -/
  ker_theta : LinearMap.ker (lyndonTheta K r) =
    Ideal.span {((MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u)) - 1}

/-- The **relation module** `K[G] ⊗_{K⟨u⟩} K ≅ K[G]/K[G](u - 1)` of the one-relator presentation
`⟨X | r⟩`. -/
abbrev relationModule (K : Type v) [Field K] (r u : FreeGroup X) :=
  MonoidAlgebra K (OneRelatorGroup r) ⧸
    Ideal.span {((MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u)) - 1}

/-- The map `K[G]/K[G](u-1) → K[G]^X` induced by `θ`, using `ker θ = K[G](u-1)`. -/
noncomputable def relationModuleMap (K : Type v) [Field K] (r u : FreeGroup X) (l : ℕ)
    (h : LyndonIdentity K X r u l) :
    relationModule K r u →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      (X →₀ MonoidAlgebra K (OneRelatorGroup r)) :=
  Submodule.liftQ _ (lyndonTheta K r) (le_of_eq h.ker_theta.symm)

end Defs

end Work.ORLyndon
