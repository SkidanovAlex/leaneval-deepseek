import Mathlib
import Submission.Work.ORLyndon.Augmentation

/-!
# The augmentation ideal is generated by `g - 1`

The augmentation ideal `I_{K[G]} = ker ε` of the group algebra of a group `G` over a commutative
ring `K` is generated, as a two-sided ideal, by the elements `g - 1` (`g ∈ G`).

The inclusion `⟨g - 1⟩ ⊆ ker ε` is immediate since `ε g = 1` for every `g`.  Conversely, if
`ε a = 0` then `a = a - ε a = a - ε a • 1`, and since `K[G]` is spanned by the elements
`single g r` and

`single g r - r • 1 = r • (of g - 1)`,

every element `a` satisfies `a - ε a • 1 ∈ span {g - 1}`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

theorem augIdeal_eq_span {K : Type*} [CommRing K] {G : Type*} [Group G] :
    Work.ORLyndon.augIdeal K G =
      Ideal.span (Set.range (fun g : G => (MonoidAlgebra.of K G) g - 1)) := by
  set J : Ideal (MonoidAlgebra K G) :=
    Ideal.span (Set.range (fun g : G => (MonoidAlgebra.of K G) g - 1))
  -- the generators lie in `J`
  have hmem : ∀ g : G, (MonoidAlgebra.of K G) g - 1 ∈ J :=
    fun g => Ideal.subset_span ⟨g, rfl⟩
  -- `single m r - r • 1 = r • (of m - 1)`
  have hsingle : ∀ (m : G) (r : K),
      MonoidAlgebra.single m r - r • (1 : MonoidAlgebra K G)
        = r • ((MonoidAlgebra.of K G) m - 1) := by
    intro m r
    rw [smul_sub, MonoidAlgebra.smul_of]
  -- the key identity: `a` agrees with its augmentation modulo `J`
  have key : ∀ a : MonoidAlgebra K G,
      a - (Work.ORLyndon.augmentation K G a) • (1 : MonoidAlgebra K G) ∈ J := by
    intro a
    induction a using MonoidAlgebra.induction_linear with
    | zero => simp
    | add x y hx hy =>
        rw [Work.ORLyndon.augmentation_add, add_smul]
        rw [show x + y
              - (Work.ORLyndon.augmentation K G x • 1 + Work.ORLyndon.augmentation K G y • 1)
            = (x - Work.ORLyndon.augmentation K G x • 1)
              + (y - Work.ORLyndon.augmentation K G y • 1) from by abel]
        exact Ideal.add_mem _ hx hy
    | single m r =>
        rw [Work.ORLyndon.augmentation_single, hsingle m r, Algebra.smul_def]
        exact Ideal.mul_mem_left J _ (hmem m)
  refine le_antisymm ?_ ?_
  · -- `ker ε ≤ J`
    intro a ha
    have h := key a
    rw [Work.ORLyndon.mem_augIdeal.mp ha, zero_smul, sub_zero] at h
    exact h
  · -- `J ≤ ker ε`
    rw [Ideal.span_le]
    rintro x ⟨g, rfl⟩
    simp [Work.ORLyndon.mem_augIdeal]

end Work.ORLyndon
