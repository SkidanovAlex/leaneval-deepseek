import Mathlib
import Submission.Work.ORLyndon.LyndonIndependenceDefs
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.LyndonIndependenceDefs
import Submission.Work.OROneRel.Interface

/-!
# The Cohen--Lyndon independence of the conjugates, in module form

Let `X` be a type, `K` a field, `r u : F(X)` with `r = u ^ l`, `u` not a proper power, `r ≠ 1`,
and `G = ⟨X | r⟩` the one-relator group.  The Cohen--Lyndon theorem says that the classes of the
conjugates `g r g⁻¹` of `r`, for `g` ranging over group elements in pairwise distinct `⟨u⟩`-cosets,
are linearly independent in the relation module.  In the form recorded in
`Work.ORLyndon.LyndonIndependence` this says that the vectors

`g • (∂r/∂x)_x = g • relatorVec K r   (g ∈ G)`

attached to pairwise distinct `⟨u⟩`-cosets are `K`-linearly independent in `K[G]^X`.

## The argument

Write `w = presentRho r u` and let `θ : K[G] → K[G]^X` be the Fox derivative map
`a ↦ a • relatorVec K r`.  Let `N = 1 + w + ⋯ + w ^ (orderOf w - 1) ∈ K[G]` be the norm element of
the cyclic subgroup `⟨w⟩`.  Then:

* `(of w - 1) * N = 0`: this is the geometric sum `(x - 1)(1 + x + ⋯ + x ^ (d - 1)) = x ^ d - 1`
  together with `w ^ orderOf w = 1`.  Consequently every element of the left ideal `K[G](w - 1)` is
  killed on the right by `N`;
* hence, for `a ∈ ker θ ⊆ K[G](w - 1)` (the hard half of Lyndon's identity theorem, imported from
  `Work.ORLyndon.lyndon_ker_theta_ge`), we get `a * N = 0`;
* on the other hand, if `a = ∑_i c_i · of (g_i)` with the `g_i` in pairwise distinct right
  `⟨w⟩`-cosets, then the coefficient of `g_i` in `a * N` is `c_i * N 1 = c_i`: for `j ≠ i` the
  elements `g_j * w ^ k` (`k < orderOf w`) never hit `g_i` (that would put `g_i` in the same right
  coset as `g_j`), and for `j = i` only `k = 0` contributes, while `0 < orderOf w` because `w`
  has finite order (`w ^ l = 1`).

Comparing the two computations gives `c_i = 0`.

## Main results

* `Work.ORLyndon.lyndon_independence_of_ker_theta` -- the reduction of the Cohen--Lyndon
  independence to the annihilator statement `ker θ ≤ K[G](u - 1)`.
* `Work.ORLyndon.lyndon_independence` -- the Cohen--Lyndon independence in module form.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

section NormElem

variable {G : Type*} [Group G] [DecidableEq G] {K : Type*} [Field K]

/-- The coefficients of the norm element `1 + w + ⋯ + w ^ (orderOf w - 1)` of `w` at `y` are the
indicators of the powers `w ^ k` (`k < orderOf w`). -/
private lemma normElem_apply (w y : G) :
    (∑ k ∈ Finset.range (orderOf w), (MonoidAlgebra.of K G w) ^ k).coeff y =
      ∑ k ∈ Finset.range (orderOf w), (if w ^ k = y then (1 : K) else 0) := by
  rw [MonoidAlgebra.coeff_sum, Finsupp.finsetSum_apply]
  exact Finset.sum_congr rfl fun k _ => by
    rw [← map_pow, MonoidAlgebra.of_apply, MonoidAlgebra.coeff_single, Finsupp.single_apply]

/-- The coefficient of the identity in the norm element of `w` is `1`, provided `w` has finite
order. -/
private lemma normElem_apply_one (w : G) (hw : 0 < orderOf w) :
    (∑ k ∈ Finset.range (orderOf w), (MonoidAlgebra.of K G w) ^ k).coeff (1 : G) = 1 := by
  rw [normElem_apply, Finset.sum_eq_single 0]
  · simp
  · intro k hk hk0
    rw [if_neg (pow_ne_one_of_lt_orderOf hk0 (Finset.mem_range.mp hk))]
  · intro h0
    exact absurd (Finset.mem_range.mpr hw) h0

/-- The coefficient of `y` in the norm element of `w` vanishes when `y` is not a power
`w ^ k` (`k < orderOf w`). -/
private lemma normElem_apply_eq_zero (w y : G) (h : ∀ k, k < orderOf w → w ^ k ≠ y) :
    (∑ k ∈ Finset.range (orderOf w), (MonoidAlgebra.of K G w) ^ k).coeff y = 0 := by
  rw [normElem_apply, Finset.sum_eq_zero]
  intro k hk
  rw [if_neg (h k (Finset.mem_range.mp hk))]

/-- The norm element of `w` is killed on the left by `of w - 1`. -/
private lemma sub_one_mul_normElem (w : G) :
    ((MonoidAlgebra.of K G w - 1) *
      ∑ k ∈ Finset.range (orderOf w), (MonoidAlgebra.of K G w) ^ k) = 0 := by
  rw [mul_geom_sum, ← map_pow, pow_orderOf_eq_one, map_one, sub_self]

end NormElem

section Main

variable {X : Type u} [DecidableEq X] {K : Type v} [Field K]

/-- **Reduction of the Cohen--Lyndon independence to the annihilator of the Fox derivative
vector.**  If the kernel of `θ : K[G] → K[G]^X` (the map `a ↦ a • (∂r/∂x)_x`) is contained in the
left ideal generated by `presentRho r u - 1` -- the hard half of Lyndon's identity theorem -- then
the vectors `g • relatorVec K r` attached to pairwise distinct `⟨u⟩`-cosets are `K`-linearly
independent. -/
theorem lyndon_independence_of_ker_theta (r u : FreeGroup X) (l : ℕ) (hpos : 1 ≤ l)
    (hpow : r = u ^ l)
    (hker : LinearMap.ker (lyndonTheta K r) ≤
      Ideal.span {((MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u)) - 1}) :
    LyndonIndependence K r u := by
  intro ι _ g c hcos hsum i
  classical
  set w : OneRelatorGroup r := presentRho r u with hw
  set a : MonoidAlgebra K (OneRelatorGroup r) :=
    ∑ j, c j • (MonoidAlgebra.of K (OneRelatorGroup r)) (g j) with ha
  set N : MonoidAlgebra K (OneRelatorGroup r) :=
    ∑ k ∈ Finset.range (orderOf w), (MonoidAlgebra.of K (OneRelatorGroup r) w) ^ k with hN
  -- `w` has finite order, so the norm element is nonempty
  have hwpow : w ^ l = 1 := by
    rw [hw, ← map_pow, hpow, presentRho_relator]
  have hwpos : 0 < orderOf w :=
    orderOf_pos_iff.mpr (isOfFinOrder_iff_pow_eq_one.mpr ⟨l, by omega, hwpow⟩)
  -- `w ^ k` with `k : ℕ` is the `k`-th power of `presentRho r u`
  have hwzpow (k : ℕ) : (presentRho r u) ^ (k : ℤ) = w ^ k := by
    rw [hw, zpow_natCast]
  -- Step 1: `a` annihilates the Fox derivative vector
  have ha_ker : a ∈ LinearMap.ker (lyndonTheta K r) := by
    rw [LinearMap.mem_ker, lyndonTheta_apply, ha, Finset.sum_smul]
    rw [show (∑ j, (c j • (MonoidAlgebra.of K (OneRelatorGroup r)) (g j)) • relatorVec K r) =
        ∑ j, c j • ((MonoidAlgebra.of K (OneRelatorGroup r)) (g j) • relatorVec K r) from
      Finset.sum_congr rfl fun j _ => smul_assoc _ _ _]
    exact hsum
  -- Step 2: `a` lies in the left ideal generated by `u - 1`
  have ha_span : a ∈ Submodule.span (MonoidAlgebra K (OneRelatorGroup r))
      {((MonoidAlgebra.of K (OneRelatorGroup r)) w - 1)} :=
    hker ha_ker
  -- Step 3: everything in that left ideal is killed on the right by the norm element
  have hNmul : ((MonoidAlgebra.of K (OneRelatorGroup r)) w - 1) * N = 0 := by
    rw [hN]
    exact sub_one_mul_normElem w
  have hspan : Submodule.span (MonoidAlgebra K (OneRelatorGroup r))
      {((MonoidAlgebra.of K (OneRelatorGroup r)) w - 1)} ≤
      LinearMap.ker (LinearMap.mulRight (MonoidAlgebra K (OneRelatorGroup r)) N) := by
    rw [Submodule.span_le, Set.singleton_subset_iff]
    change ((MonoidAlgebra.of K (OneRelatorGroup r)) w - 1) * N = 0
    rw [hN]
    exact sub_one_mul_normElem w
  have haN : a * N = 0 := by
    have h := hspan ha_span
    change a * N = 0 at h
    exact h
  -- Step 4: the coefficient of `g i` in `a * N` is `c i`
  have hterm : ∀ j, (((c j • (MonoidAlgebra.of K (OneRelatorGroup r)) (g j)) * N).coeff (g i))
      = if j = i then c j else 0 := by
    intro j
    rw [smul_mul_assoc, MonoidAlgebra.coeff_smul_apply, smul_eq_mul]
    have hcoeff : ((MonoidAlgebra.of K (OneRelatorGroup r)) (g j) * N).coeff (g i)
        = N.coeff ((g j)⁻¹ * g i) := by
      rw [MonoidAlgebra.of_apply, MonoidAlgebra.coeff_single_mul_apply, one_mul]
    rw [hcoeff]
    by_cases hji : j = i
    · subst hji
      rw [if_pos rfl, inv_mul_cancel, hN, normElem_apply_one w hwpos, mul_one]
    · have hN0 : N.coeff ((g j)⁻¹ * g i) = 0 := by
        rw [hN]
        refine normElem_apply_eq_zero w _ (fun k _ hk => ?_)
        exact hcos i j (Ne.symm hji) (k : ℤ)
          (by rw [hwzpow k, hk, mul_inv_cancel_left])
      rw [if_neg hji, hN0, mul_zero]
  have hcoeff_i : (a * N).coeff (g i) = c i := by
    rw [ha, Finset.sum_mul, MonoidAlgebra.coeff_sum, Finsupp.finsetSum_apply]
    rw [Finset.sum_congr rfl fun j _ => hterm j, Finset.sum_eq_single i]
    · simp
    · intro b _ hb
      rw [if_neg hb]
    · intro h
      exact absurd (Finset.mem_univ i) h
  rw [← hcoeff_i, haN, MonoidAlgebra.coeff_zero]
  rfl

end Main

/-! The converse direction (`LyndonIndependence → ker θ ≤ K[G](u-1)`) is proved in
`Submission/Work/ORLyndon/lyndon_ker_theta_of_independence.lean`; `LyndonIndependence` itself is the
Cohen--Lyndon input and is not derivable from `Work.OROneRel.OneRelatorCombinatorics`. -/

