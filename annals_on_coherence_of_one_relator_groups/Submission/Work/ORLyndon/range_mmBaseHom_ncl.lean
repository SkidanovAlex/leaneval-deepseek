import Mathlib
import Submission.Work.ORLyndon.lyndonIndependence_eps_zero
import Submission.Work.OROneRel.mmStepData_of_expsum_zero

/-!
# The Magnus base as the normal closure of the range of `mmBaseHom`

For a cyclically reduced nontrivial relator `r = u ^ l` whose root `u` has vanishing `t`-exponent sum
(`σ_t u = 1`, equivalently `eps t r = 0`), the Magnus--Moldavanskii step writes `r` as a word `w` in
the decorated letters `t ^ i x t ^ (-i)` of the finite alphabet `mmBeta t r`; the canonical map

`mmBaseHom : ⟨mmBeta t r | w⟩ →* ⟨α | r⟩`,  `(x, i) ↦ t ^ i * x * t ^ (-i)`

sends the Magnus base presentation into `⟨α | r⟩`.  Its range is contained in the Magnus base
`ker (levelOf)` of the `σ_t`-decomposition, and the *normal closure* of its range is the whole of
`ker (levelOf)`: this is the statement proved here.

The two halves are:

* `range (mmBaseHom) ⊆ ker (levelOf)`: `σ_t` vanishes on `t ^ i x t ^ (-i)` because `x ≠ t`
  (`mmBaseHom_gen`);
* `ker (levelOf) ⊆ normalClosure (range mmBaseHom)`: the range contains `t ^ i x t ^ (-i)` for every
  `x ≠ t` and some `i` (`mmLo_mem_decSet`), and the normal closure is closed under conjugation, so
  it contains *every* conjugate of `x`; since `ker (levelOf)` is generated by the classes of the
  generators other than `t` (`magnusMap` has range exactly `ker (σ_t)`, `magRange_eq_ker`), the
  conclusion follows.
-/

namespace Work.ORLyndon

/-- **The range of the Magnus base map sits in the kernel of the level map.**  The level of the
image of a decorated letter `(x, i)` is the `t`-exponent sum of `t ^ i * x * t ^ (-i)`, which is `1`
because `x ≠ t`. -/
theorem mmBaseHom_range_le_ker {α : Type*} [DecidableEq α] (t : α) (r u : FreeGroup α) (l : ℕ)
    (hpow : r = u ^ l) (hσ : Work.OROneRel.sigma t u = 1) (he : Work.OROneRel.eps t r = 0) :
    (Work.OROneRel.mmBaseHom (t := t) (r := r) he).range ≤
      (levelOf t r u l hpow hσ).ker := by
  rw [MonoidHom.range_le_ker_iff]
  apply PresentedGroup.ext
  intro p
  show levelOf t r u l hpow hσ
    (Work.OROneRel.mmBaseHom (t := t) (r := r) he (PresentedGroup.of p)) = 1
  rw [Work.OROneRel.mmBaseHom_gen he p]
  rw [map_mul, map_mul, map_zpow, map_zpow]
  rw [levelOf_of, levelOf_of]
  have h1 : (Work.OROneRel.sigma t) (FreeGroup.of t) = Multiplicative.ofAdd (1 : ℤ) :=
    Work.OROneRel.magExpSum_of_a t
  have h2 : (Work.OROneRel.sigma t) (FreeGroup.of (p.1.1 : α)) = 1 :=
    Work.OROneRel.magExpSum_of_ne t p.1.1
  rw [h1, h2, mul_one, ← zpow_add, add_neg_cancel, zpow_zero]

/-- **The general form of `range_mmBaseHom_ncl`**, with the relator `r`, the root `u` and the
equation `r = u ^ l` kept as separate data. -/
theorem range_mmBaseHom_ncl_of_pow {α : Type*} [DecidableEq α] (t : α) (r u : FreeGroup α) (l : ℕ)
    (hpow : r = u ^ l) (hσ : Work.OROneRel.sigma t u = 1) (he : Work.OROneRel.eps t r = 0) :
    ∀ g : OneRelatorGroup r,
      g ∈ Subgroup.normalClosure
            (Set.range (Work.OROneRel.mmBaseHom (t := t) (r := r) he)) ↔
        levelOf t r u l hpow hσ g = 1 := by
  classical
  set b : PresentedGroup ({Work.OROneRel.mmW t r} :
      Set (FreeGroup (Work.OROneRel.mmBeta t r))) →* OneRelatorGroup r :=
    Work.OROneRel.mmBaseHom (t := t) (r := r) he with hb
  set L : OneRelatorGroup r →* Multiplicative ℤ := levelOf t r u l hpow hσ with hL
  set M : Subgroup (OneRelatorGroup r) := Subgroup.normalClosure (Set.range b) with hM
  have hMnormal : M.Normal := by
    rw [hM]
    infer_instance
  -- ### The range of `b` lies in the kernel of the level map
  have hbker : b.range ≤ L.ker := by
    rw [hb, hL]
    exact mmBaseHom_range_le_ker t r u l hpow hσ he
  have hM_le : M ≤ L.ker := by
    rw [hM]
    refine Subgroup.normalClosure_le_normal ?_
    rintro y ⟨z, rfl⟩
    exact hbker (MonoidHom.mem_range.mpr ⟨z, rfl⟩)
  -- ### Every generator other than `t` lies in `M`
  have hgen_mem : ∀ x : {a : α // a ≠ t},
      (PresentedGroup.of (x : α) : OneRelatorGroup r) ∈ M := by
    intro x
    have hp : ((x, Work.OROneRel.mmLo t r x) : Work.OROneRel.MMAlpha t) ∈
        Work.OROneRel.mmDecSet t r := Work.OROneRel.mmLo_mem_decSet t r x
    let p : Work.OROneRel.mmBeta t r := ⟨(x, Work.OROneRel.mmLo t r x), hp⟩
    have hbp : b (PresentedGroup.of p) ∈ M :=
      Subgroup.subset_normalClosure ⟨PresentedGroup.of p, rfl⟩
    have hbp_eq : b (PresentedGroup.of p) =
        (PresentedGroup.of t : OneRelatorGroup r) ^ (Work.OROneRel.mmLo t r x) *
          (PresentedGroup.of (x : α) : OneRelatorGroup r) *
          (PresentedGroup.of t : OneRelatorGroup r) ^ (-(Work.OROneRel.mmLo t r x)) := by
      rw [hb, Work.OROneRel.mmBaseHom_gen he p]
    have hconj : (PresentedGroup.of t : OneRelatorGroup r) ^ (-(Work.OROneRel.mmLo t r x)) *
        b (PresentedGroup.of p) *
        ((PresentedGroup.of t : OneRelatorGroup r) ^ (-(Work.OROneRel.mmLo t r x)))⁻¹ ∈ M :=
      hMnormal.conj_mem (b (PresentedGroup.of p)) hbp _
    have heq : (PresentedGroup.of (x : α) : OneRelatorGroup r) =
        (PresentedGroup.of t : OneRelatorGroup r) ^ (-(Work.OROneRel.mmLo t r x)) *
          b (PresentedGroup.of p) *
          ((PresentedGroup.of t : OneRelatorGroup r) ^ (-(Work.OROneRel.mmLo t r x)))⁻¹ := by
      rw [hbp_eq]
      group
    rwa [heq]
  have hconj_mem : ∀ (x : {a : α // a ≠ t}) (i : ℤ),
      (PresentedGroup.of t : OneRelatorGroup r) ^ i *
        (PresentedGroup.of (x : α) : OneRelatorGroup r) *
        ((PresentedGroup.of t : OneRelatorGroup r) ^ i)⁻¹ ∈ M :=
    fun x i => hMnormal.conj_mem (PresentedGroup.of (x : α)) (hgen_mem x)
      (PresentedGroup.of t ^ i)
  -- ### The range of `mk ∘ ζ_t` lies in `M`
  have hPsi_le : ((PresentedGroup.mk ({r} : Set (FreeGroup α))).comp
      (Work.OROneRel.magnusMap t)).range ≤ M := by
    set Ψ : FreeGroup ({a : α // a ≠ t} × ℤ) →* OneRelatorGroup r :=
      (PresentedGroup.mk ({r} : Set (FreeGroup α))).comp (Work.OROneRel.magnusMap t) with hΨ
    have hrange : Ψ.range =
        Subgroup.closure (Set.range fun q : {a : α // a ≠ t} × ℤ => Ψ (FreeGroup.of q)) := by
      rw [MonoidHom.range_eq_map, ← FreeGroup.closure_range_of ({a : α // a ≠ t} × ℤ),
        MonoidHom.map_closure, ← Set.range_comp]
      rfl
    rw [hrange, Subgroup.closure_le]
    rintro y ⟨q, rfl⟩
    obtain ⟨x, i⟩ := q
    have hq : Ψ (FreeGroup.of (x, i)) =
        (PresentedGroup.of t : OneRelatorGroup r) ^ i *
          (PresentedGroup.of (x : α) : OneRelatorGroup r) *
          ((PresentedGroup.of t : OneRelatorGroup r) ^ i)⁻¹ := by
      show (PresentedGroup.mk ({r} : Set (FreeGroup α)))
          ((Work.OROneRel.magnusMap t) (FreeGroup.of (x, i))) = _
      rw [Work.OROneRel.magnusMap_apply, map_mul, map_mul, map_zpow, map_zpow, zpow_neg]
      rfl
    change Ψ (FreeGroup.of (x, i)) ∈ M
    rw [hq]
    exact hconj_mem x i
  -- ### The statement
  intro g
  constructor
  · intro hg
    exact MonoidHom.mem_ker.mp (hM_le hg)
  · intro hg
    obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective ({r} : Set (FreeGroup α)) g
    have hsw : (Work.OROneRel.sigma t) w = 1 := by
      have h1 : levelOf t r u l hpow hσ (presentRho r w) = 1 := by
        simpa [hL] using hg
      rwa [levelOf_presentRho t r u l hpow hσ w] at h1
    obtain ⟨k, m, hm, hw⟩ := Work.OROneRel.magExists_zpow_mul_mem_range t w
    have hmker : (Work.OROneRel.sigma t) m = 1 := by
      have hm' : m ∈ (Work.OROneRel.expSum t).ker := by
        rw [← Work.OROneRel.magRange_eq_ker t]
        exact hm
      exact hm'
    have hk : k = 0 := by
      have hcw : (Work.OROneRel.sigma t) w = Multiplicative.ofAdd k := by
        rw [hw, map_mul, map_zpow]
        have h1 : (Work.OROneRel.sigma t) (FreeGroup.of t) = Multiplicative.ofAdd (1 : ℤ) :=
          Work.OROneRel.magExpSum_of_a t
        rw [h1, hmker, mul_one, ← ofAdd_zsmul]
        simp
      have h1 : Multiplicative.ofAdd k = 1 := by rw [← hcw, hsw]
      exact ofAdd_eq_one.mp h1
    have hwrange : w ∈ (Work.OROneRel.magnusMap t).range := by
      rw [hw, hk, zpow_zero, one_mul]
      exact hm
    obtain ⟨w', hw'⟩ := hwrange
    have hmem : ((PresentedGroup.mk ({r} : Set (FreeGroup α))).comp
        (Work.OROneRel.magnusMap t)) w' ∈ M :=
      hPsi_le (MonoidHom.mem_range.mpr ⟨w', rfl⟩)
    simpa only [MonoidHom.comp_apply, hw'] using hmem

theorem range_mmBaseHom_ncl {α : Type*} [DecidableEq α] (t : α) (u : FreeGroup α) (l : ℕ)
    (hσ : Work.OROneRel.sigma t u = 1) (he : Work.OROneRel.eps t (u ^ l) = 0) :
    ∀ g : Work.ORLyndon.OneRelatorGroup (u ^ l),
      g ∈ Subgroup.normalClosure
            (Set.range (Work.OROneRel.mmBaseHom (t := t) (r := u ^ l) he)) ↔
        Work.ORLyndon.levelOf t (u ^ l) u l rfl hσ g = 1 :=
  range_mmBaseHom_ncl_of_pow t (u ^ l) u l rfl hσ he

end Work.ORLyndon
