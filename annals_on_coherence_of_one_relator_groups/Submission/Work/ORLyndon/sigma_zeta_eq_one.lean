import Mathlib
import Submission.Work.OROneRel.FreiheitssatzDefs

namespace Work.ORLyndon

/-- The exponent sum `sigma t` annihilates the image of the Magnus embedding `zeta t`:
`sigma t (zeta t w) = 1` for every `w` in the free group on `(α \ {t}) × ℤ`.

Indeed `zeta t` sends the generator `(s, i)` to `t ^ i * s * t ^ (-i)`, whose `t`-exponent
sum is `i + 0 - i = 0`; since `sigma t` is a homomorphism and `zeta t` is generated by those
images, the composite `sigma t ∘ zeta t` is trivial. -/
theorem sigma_zeta_eq_one {α : Type*} [DecidableEq α] (t : α)
    (w : FreeGroup ({a : α // a ≠ t} × ℤ)) :
    Work.OROneRel.sigma t (Work.OROneRel.zeta t w) = 1 := by
  have hcomp : (Work.OROneRel.sigma t).comp (Work.OROneRel.zeta t) = 1 := by
    apply FreeGroup.ext_hom
    intro p
    simp only [MonoidHom.comp_apply, MonoidHom.one_apply]
    rw [Work.OROneRel.zeta, FreeGroup.lift_apply_of]
    rw [map_mul, map_mul, map_zpow, map_zpow]
    rw [Work.OROneRel.sigma, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
    simp only [if_true, if_neg p.1.2, mul_one]
    group
  simpa only [MonoidHom.comp_apply, MonoidHom.one_apply] using DFunLike.congr_fun hcomp w

end Work.ORLyndon
