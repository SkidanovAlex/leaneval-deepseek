import Mathlib
import Submission.Work.ORLyndon.Augmentation

/-!
# The left ideal `(u - 1)` of a group algebra is generated by an idempotent

Let `G` be a group, `K` a field, `u : G` an element with `u ^ l = 1`, and suppose that
`(l : K) ≠ 0`.  This file proves that the *left* ideal `I = K[G]·(u - 1)` of the group
algebra `K[G]` is generated by an idempotent, hence that `K[G] / I` is a direct summand of
`K[G]` and therefore a projective left `K[G]`-module.

Note that in this version of Mathlib `Ideal R = Submodule R R` denotes the type of **left**
ideals, so `Ideal.span {of u - 1}` is the left ideal generated by `of u - 1`, i.e.
`K[G]·(of u - 1)`.

The idempotent is
`e = 1 - (l : K)⁻¹ • (1 + x + ⋯ + x ^ (l-1))` with `x = of u`.
The two identities that make the argument work are

* `h · (x - 1) = 0` (i.e. `x * h = h`), where `h = ∑ i < l, x^i`; this is `mul_geom_sum`
  together with `x ^ l = 1`, using that `h` commutes with `x` so that the two products agree;
* `e ∈ K[G]·(x - 1)`, obtained from `geom_sum_mul`, which gives
  `x ^ i - 1 = (∑ j < i, x^j) * (x - 1)`, hence
  `h - l = ∑ i < l, (x^i - 1) ∈ K[G]·(x - 1)`.

The section `A/I → A`, `a + I ↦ a * (1 - e)`, is then well defined because
`(x - 1) * (1 - e) = 0`, and it is a section of the quotient map because `a * e ∈ I`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

/-- If `u ^ l = 1` and `(l : K) ≠ 0`, then the quotient of the group algebra `K[G]` by the
left ideal generated by `of u - 1` is a projective left `K[G]`-module. -/
theorem projective_quotient_span_of_pow_eq_one {G : Type*} [Group G] {K : Type*} [Field K]
    (u : G) (l : ℕ) (hl : u ^ l = 1) (hchar : (l : K) ≠ 0) :
    Module.Projective (MonoidAlgebra K G)
      (MonoidAlgebra K G ⧸
        Ideal.span {((MonoidAlgebra.of K G) u) - 1}) := by
  classical
  set x : MonoidAlgebra K G := MonoidAlgebra.of K G u with hx
  set h : MonoidAlgebra K G := ∑ i ∈ Finset.range l, x ^ i with hh
  set c : K := (l : K)⁻¹ with hc
  set e : MonoidAlgebra K G := 1 - c • h with he
  -- `x ^ l = 1`
  have hxl : x ^ l = 1 := by
    rw [hx, ← MonoidHom.map_pow, hl, MonoidHom.map_one]
  -- `c • (l : K[G]) = 1`
  have hcl : c • (l : MonoidAlgebra K G) = 1 := by
    rw [hc, Algebra.smul_def]
    rw [show (l : MonoidAlgebra K G) = algebraMap K (MonoidAlgebra K G) (l : K) from by simp]
    rw [← map_mul, inv_mul_cancel₀ hchar, map_one]
  -- `x ^ i - 1 ∈ K[G]·(x - 1)`
  have hmem_i : ∀ i, x ^ i - 1 ∈ Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) := by
    intro i
    rw [← geom_sum_mul x i]
    exact (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mul_mem_left
      (∑ j ∈ Finset.range i, x ^ j) (Ideal.subset_span (Set.mem_singleton (x - 1)))
  have hsum_mem : (∑ i ∈ Finset.range l, (x ^ i - 1)) ∈
      Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) :=
    Submodule.sum_mem _ (fun i _ => hmem_i i)
  -- `∑ i < l, (x ^ i - 1) = h - l`
  have hdecomp : (∑ i ∈ Finset.range l, (x ^ i - 1)) = h - (l : MonoidAlgebra K G) := by
    rw [hh, Finset.sum_sub_distrib]
    congr 1
    simp [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  -- `(x - 1) * h = 0`
  have hmh : (x - 1) * h = 0 := by
    have hg := mul_geom_sum x l
    rw [← hh, hxl, sub_self] at hg
    exact hg
  -- `1 - e = c • h`
  have h1e : 1 - e = c • h := by rw [he, sub_sub_cancel]
  -- `(x - 1) * (1 - e) = 0`
  have hx1 : (x - 1) * (1 - e) = 0 := by
    rw [h1e, Algebra.mul_smul_comm, hmh, smul_zero]
  -- `e ∈ K[G]·(x - 1)`
  have he_mem : e ∈ Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) := by
    have hhmem : h - (l : MonoidAlgebra K G) ∈ Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) := by
      rw [← hdecomp]; exact hsum_mem
    have he_eq : e = c • ((l : MonoidAlgebra K G) - h) := by
      rw [he, ← hcl, ← smul_sub]
    have hhmem2 : (l : MonoidAlgebra K G) - h ∈ Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) := by
      rw [show (l : MonoidAlgebra K G) - h = -(h - (l : MonoidAlgebra K G)) from
        (neg_sub h _).symm]
      exact Submodule.neg_mem _ hhmem
    rw [he_eq, Algebra.smul_def]
    exact (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mul_mem_left
      (algebraMap K (MonoidAlgebra K G) c) hhmem2
  -- The section `a + I ↦ a * (1 - e)` and the quotient map `s`.
  let f : MonoidAlgebra K G →ₗ[MonoidAlgebra K G] MonoidAlgebra K G := LinearMap.mulRight _ (1 - e)
  have hf : Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) ≤ f.ker := by
    rw [Ideal.span_le]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact LinearMap.mem_ker.mpr hx1
  let i : (MonoidAlgebra K G ⧸ Ideal.span ({x - 1} : Set (MonoidAlgebra K G))) →ₗ[MonoidAlgebra K G]
      MonoidAlgebra K G := (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).liftQ f hf
  let s : MonoidAlgebra K G →ₗ[MonoidAlgebra K G]
      (MonoidAlgebra K G ⧸ Ideal.span ({x - 1} : Set (MonoidAlgebra K G))) :=
    (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mkQ
  have H : s.comp i = LinearMap.id := by
    apply Submodule.linearMap_qext
    rw [LinearMap.comp_assoc, Submodule.liftQ_mkQ, LinearMap.id_comp]
    apply LinearMap.ext
    intro a
    have hae : (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mkQ (a * e) = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mul_mem_left a he_mem
    show (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mkQ (f a)
        = (Ideal.span ({x - 1} : Set (MonoidAlgebra K G))).mkQ a
    rw [show f a = a * (1 - e) from rfl, mul_sub, mul_one, map_sub, hae, sub_zero]
  exact Module.Projective.of_split i s H

end Work.ORLyndon
