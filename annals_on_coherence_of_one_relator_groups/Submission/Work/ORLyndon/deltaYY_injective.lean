import Mathlib
import Submission.Work.ORLyndon.MagnusTwoTermDefs
import Submission.Work.OROneRel.Interface
import Submission.Work.ORFP2.linearCombination_freeBasis_injective
import Submission.Work.ORReductions.SubgroupAlg
import Submission.Work.ORReductions.SubgroupAlg.linearCombination_injective_subgroup

/-!
# Injectivity of the Magnus map `deltaYY` for an embedded Magnus subgroup

Let `X` be a generating set, `K` a field, `r : F(X)` a relator, `G = ⟨X | r⟩` the associated
one-relator group, `Y ⊆ X` a finite set of generators and `A = ⟨Y⟩ ≤ G` the subgroup generated by
the images of `Y`.  Write `δ_YY : K[G]^Y → K[G]` for the `K[G]`-linear *Magnus map*

`δ_YY(c) = ∑_{y ∈ Y} c_y (y - 1)`.

The main theorem of this file is that `δ_YY` is *injective* as soon as the canonical map
`F(Y) →* G` is injective, i.e. as soon as `A` is free on the images of the generators in `Y`
(Freiheitssatz situation).  Equivalently: in that case the elements `y - 1`, `y ∈ Y`, are
right-`K[G]`-linearly independent; this is the statement that the left ideal `I^G_{K[A]}` is a
free left `K[G]`-module with basis `(y - 1)_{y ∈ Y}`.

The proof follows the classical flatness argument:

* `K[G]` is a free (hence flat) left `K[H]`-module for every subgroup `H ≤ G`: it decomposes as the
  direct sum of its components on the left cosets of `H`;
* injectivity of a `K[H]`-linear combination therefore survives base change along `K[H] → K[G]`
  (`Work.ORReductions.SubgroupAlg.linearCombination_injective_subgroup`);
* over the free group `F(Y)` the augmentation ideal is free on the elements `x - 1`
  (Fox calculus, `Work.ORFP2.augIdeal_freeGroup_injective`), and this is transported along the
  group isomorphism `F(Y) ≃* A` supplied by the hypothesis
  (`Work.ORFP2.linearCombination_freeBasis_injective`).

## Main result

* `Work.ORLyndon.deltaYY_injective`
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

theorem deltaYY_injective {X : Type*} [DecidableEq X] {K : Type*} [Field K]
    (Y : Finset X) (r : FreeGroup X)
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r (Y : Set X))) :
    Function.Injective (Work.ORLyndon.deltaYY (K := K) Y r) := by
  classical
  -- the Magnus subgroup `A = ⟨Y⟩ ≤ G` generated by the images of the generators in `Y`
  let H : Subgroup (OneRelatorGroup r) :=
    Subgroup.closure (PresentedGroup.of '' (Y : Set X))
  have hmem : ∀ y : (Y : Set X), PresentedGroup.of (y : X) ∈ H :=
    fun y => Subgroup.subset_closure ⟨y, y.2, rfl⟩
  -- the canonical surjection `F(Y) →* A`, which is injective by hypothesis
  let φ := Work.OROneRel.presentedGroupMap r (Y : Set X)
  have hφ : ∀ y : (Y : Set X), φ (FreeGroup.of y) = PresentedGroup.of (y : X) := fun _ => rfl
  have hφH : ∀ a : FreeGroup (Y : Set X), φ a ∈ H := by
    intro a
    refine FreeGroup.induction_on a ?_ ?_ ?_ ?_
    · exact H.one_mem
    · intro x; rw [hφ x]; exact hmem x
    · intro x hx; rw [map_inv]; exact H.inv_mem hx
    · intro x y hx hy; rw [map_mul]; exact H.mul_mem hx hy
  let φH : FreeGroup (Y : Set X) →* H := φ.codRestrict H hφH
  have hφH_of : ∀ y : (Y : Set X),
      φH (FreeGroup.of y) = ⟨PresentedGroup.of (y : X), hmem y⟩ :=
    fun y => Subtype.ext (hφ y)
  have hinjφH : Function.Injective φH := fun a b hab => hinj (Subtype.ext_iff.mp hab)
  have hsurjφH : Function.Surjective φH := by
    intro h
    have key : ∃ a : FreeGroup (Y : Set X), φH a = (⟨(h : OneRelatorGroup r), h.2⟩ : H) := by
      refine Subgroup.closure_induction
        (p := fun g hg => ∃ a : FreeGroup (Y : Set X), φH a = (⟨g, hg⟩ : H)) ?_ ?_ ?_ ?_ h.2
      · rintro g ⟨y, hy, hgy⟩
        refine ⟨FreeGroup.of ⟨y, hy⟩, Subtype.ext ?_⟩
        show φ (FreeGroup.of ⟨y, hy⟩) = g
        rw [hφ ⟨y, hy⟩]
        exact hgy
      · exact ⟨1, Subtype.ext (map_one φ)⟩
      · intro a b _ _ ⟨xa, hxa⟩ ⟨xb, hxb⟩
        exact ⟨xa * xb, by rw [map_mul, hxa, hxb]; exact Subtype.ext rfl⟩
      · intro a _ ⟨xa, hxa⟩
        exact ⟨xa⁻¹, by rw [map_inv, hxa]; exact Subtype.ext rfl⟩
    obtain ⟨a, ha⟩ := key
    exact ⟨a, ha⟩
  -- the group isomorphism `F(Y) ≃* A` and its effect on the generators
  let e : FreeGroup (Y : Set X) ≃* H := MulEquiv.ofBijective φH ⟨hinjφH, hsurjφH⟩
  have he_of : ∀ y : (Y : Set X), e (FreeGroup.of y) = ⟨PresentedGroup.of (y : X), hmem y⟩ := by
    intro y
    show φH (FreeGroup.of y) = _
    exact hφH_of y
  have he_val : ∀ y : (Y : Set X),
      ((e (FreeGroup.of y) : H) : OneRelatorGroup r) = PresentedGroup.of (y : X) :=
    fun y => by rw [he_of y]
  -- the family of elements of `K[A]` attached to the free generators
  have hfam : ∀ j : (Y : Set X), Work.ORReductions.subgroupAlgMap H K
      (MonoidAlgebra.single (e (FreeGroup.of j)) (1 : K) - 1)
      = (MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of (j : X)) - 1 := by
    intro j
    rw [map_sub, map_one, Work.ORReductions.SubgroupAlg.subgroupAlgMap_single, he_val j,
      MonoidAlgebra.of_apply]
  -- over `K[F(Y)]` the map is injective (Fox calculus), so over `K[A]` it is too
  have hy : Function.Injective (Finsupp.linearCombination (MonoidAlgebra K H)
      (fun i : (Y : Set X) => MonoidAlgebra.single (e (FreeGroup.of i)) (1 : K) - 1)) :=
    Work.ORFP2.linearCombination_freeBasis_injective K e
  -- `K[G]` is free over `K[A]`, so injectivity survives the base change `K[A] → K[G]`
  have htrans : Function.Injective (Finsupp.linearCombination (MonoidAlgebra K (OneRelatorGroup r))
      (fun j : (Y : Set X) => Work.ORReductions.subgroupAlgMap H K
        (MonoidAlgebra.single (e (FreeGroup.of j)) (1 : K) - 1))) :=
    Work.ORReductions.SubgroupAlg.linearCombination_injective_subgroup H K
      (fun i : (Y : Set X) => MonoidAlgebra.single (e (FreeGroup.of i)) (1 : K) - 1) hy
  -- the resulting family is exactly the one defining `deltaYY`
  have hlin : (fun j : (Y : Set X) => Work.ORReductions.subgroupAlgMap H K
        (MonoidAlgebra.single (e (FreeGroup.of j)) (1 : K) - 1))
      = (fun j : (Y : Set X) =>
          (MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of (j : X)) - 1) :=
    funext hfam
  rw [hlin] at htrans
  exact htrans

end Work.ORLyndon
