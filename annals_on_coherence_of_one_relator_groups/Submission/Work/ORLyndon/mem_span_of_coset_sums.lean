import Mathlib
import Submission.Work.ORLyndon.LyndonIndependenceDefs
import Submission.Work.ORLyndon.Lyndon

/-!
# Coset sums and the ideal generated by `u - 1`

Let `G = ⟨X | r⟩` be a one-relator group with `r = u ^ l` (`l ≥ 1`), let `K` be a field and let
`a ∈ K[G]`.  Write `ζ = presentRho r u ∈ G`, so that `ζ ^ l = 1`, and let `H = ⟨ζ⟩` be the cyclic
subgroup it generates.  The main result of this file, `Work.ORLyndon.mem_span_of_coset_sums`, says
that if the sum of the coefficients of `a` over every right coset `gH` vanishes, then `a` lies in
the left ideal `K[G]·(ζ - 1) = Ideal.span {of ζ - 1}`.

This is the "annihilator" direction of Lyndon's identity theorem: it says that the kernel of
`K[G] → K[G]/K[G](ζ-1)` consists of the elements whose coefficient sums on every coset of `⟨ζ⟩`
vanish.

## Proof outline

Decompose `a = ∑_{g ∈ supp a} a g • of g`.  Each element of `supp a` lies in a right coset `tH`; fix
a representative `t` of every such coset (`cosetRep`, built from the quotient by the equivalence
relation "same right `⟨ζ⟩`-coset").  Grouping the sum over cosets and writing `g = t·ζ^{k}` with
`k ∈ ℕ` (possible because `ζ^l = 1`), one has

`a g • of g = a g • (of t · (ζ^k - 1)) + a g • of t`,

and `ζ^k - 1 = (1 + ζ + ⋯ + ζ^{k-1})(ζ - 1)` is a left multiple of `ζ - 1`, while the second terms
sum to `(∑_{g ∈ tH} a g) • of t = 0` because the coset sum vanishes by hypothesis.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

section CosetAux

variable {G : Type*} [Group G] [DecidableEq G] {K : Type*} [Field K]

/-- `SameCoset ζ t g` means that `g` and `t` lie in the same right coset of the cyclic subgroup
generated by `ζ`, i.e. `g = t * ζ ^ m` for some `m : ℤ`. -/
private def SameCoset (ζ : G) (t g : G) : Prop := ∃ m : ℤ, g = t * ζ ^ m

private theorem sameCoset_refl (ζ : G) (g : G) : SameCoset ζ g g := ⟨0, by simp⟩

private theorem sameCoset_symm {ζ : G} {a b : G} (h : SameCoset ζ a b) :
    SameCoset ζ b a := by
  obtain ⟨m, rfl⟩ := h
  exact ⟨-m, by rw [zpow_neg, mul_assoc, mul_inv_cancel, mul_one]⟩

private theorem sameCoset_trans {ζ : G} {a b c : G} (h1 : SameCoset ζ a b)
    (h2 : SameCoset ζ b c) : SameCoset ζ a c := by
  obtain ⟨m1, rfl⟩ := h1
  obtain ⟨m2, rfl⟩ := h2
  exact ⟨m1 + m2, by rw [zpow_add, mul_assoc]⟩

private noncomputable def SameCoset.setoid (ζ : G) : Setoid G where
  r := SameCoset ζ
  iseqv := ⟨sameCoset_refl ζ, fun h => sameCoset_symm h, fun h1 h2 => sameCoset_trans h1 h2⟩

/-- A chosen representative of the right `⟨ζ⟩`-coset of `g`. -/
private noncomputable def cosetRep (ζ : G) (g : G) : G :=
  Quotient.out (Quotient.mk (SameCoset.setoid ζ) g)

private theorem cosetRep_spec (ζ : G) (g : G) : SameCoset ζ (cosetRep ζ g) g :=
  Quotient.mk_out (s := SameCoset.setoid ζ) g

private theorem cosetRep_eq_of_sameCoset {ζ : G} {a b : G} (h : SameCoset ζ a b) :
    cosetRep ζ a = cosetRep ζ b :=
  congrArg Quotient.out (Quotient.sound h)

/-- If `ζ ^ l = 1` with `l > 0`, then `ζ ^ m` for `m : ℤ` is `ζ ^ k` for some natural number
`k < l`. -/
private theorem zpow_eq_pow_emod_toNat {ζ : G} {l : ℕ} (hl : 0 < l) (hζ : ζ ^ l = 1) (m : ℤ) :
    ζ ^ m = ζ ^ ((m % (l : ℤ)).toNat) ∧ (m % (l : ℤ)).toNat < l := by
  have hpos : (0 : ℤ) < l := by exact_mod_cast hl
  have hr0 : 0 ≤ m % (l : ℤ) := Int.emod_nonneg m (by omega)
  have hrl : m % (l : ℤ) < l := Int.emod_lt_of_pos m hpos
  refine ⟨?_, ?_⟩
  · rw [zpow_eq_zpow_emod' m hζ, ← Int.toNat_of_nonneg hr0]
    exact zpow_natCast ζ _
  · omega

/-- Membership in the right `⟨ζ⟩`-coset of `t`, described by nonnegative powers of `ζ`. -/
private theorem sameCoset_iff_exists_pow {ζ : G} {l : ℕ} (hl : 0 < l) (hζ : ζ ^ l = 1)
    (t g : G) : SameCoset ζ t g ↔ ∃ k : ℕ, k < l ∧ g = t * ζ ^ k := by
  constructor
  · rintro ⟨m, rfl⟩
    obtain ⟨h1, h2⟩ := zpow_eq_pow_emod_toNat hl hζ m
    exact ⟨_, h2, by rw [h1]⟩
  · rintro ⟨k, _, rfl⟩
    exact ⟨k, by rw [zpow_natCast]⟩

/-- The exponent of `g = t * ζ ^ k` written with a natural number, chosen classically. -/
private noncomputable def powExp (ζ : G) (t g : G) : ℕ := by
  classical
  exact if h : ∃ k : ℕ, g = t * ζ ^ k then Classical.choose h else 0

private theorem powExp_spec {ζ t g : G} (h : ∃ k : ℕ, g = t * ζ ^ k) :
    g = t * ζ ^ (powExp ζ t g) := by
  rw [powExp, dif_pos h]
  exact Classical.choose_spec h

/-- **Key algebraic lemma.**  Let `ζ ∈ G` with `ζ ^ l = 1`, `l > 0`, let `s : Finset G` and
`f : G → K`, and suppose that the sum of `f` over the part of every `⟨ζ⟩`-coset that meets `s`
vanishes.  Then `∑_{g ∈ s} f g • of g ∈ K[G]·(ζ - 1)`. -/
private theorem sum_smul_of_coset_sums {ζ : G} {l : ℕ} (hl : 0 < l) (hζ : ζ ^ l = 1)
    (s : Finset G) (f : G → K)
    (hcoset : ∀ t ∈ s.image (cosetRep ζ),
      (s.filter (fun g => cosetRep ζ g = t)).sum f = 0) :
    (∑ g ∈ s, f g • MonoidAlgebra.of K G g) ∈
      Ideal.span ({((MonoidAlgebra.of K G) ζ) - 1} : Set (MonoidAlgebra K G)) := by
  classical
  set x : MonoidAlgebra K G := MonoidAlgebra.of K G ζ with hx
  set I : Ideal (MonoidAlgebra K G) := Ideal.span ({x - 1} : Set (MonoidAlgebra K G)) with hI
  have hx1 : x - 1 ∈ I := Ideal.subset_span (Set.mem_singleton _)
  -- group the sum over the cosets that meet `s`
  have hsplit : (∑ g ∈ s, f g • MonoidAlgebra.of K G g)
      = ∑ t ∈ s.image (cosetRep ζ),
          ∑ g ∈ s.filter (fun g => cosetRep ζ g = t), f g • MonoidAlgebra.of K G g :=
    (Finset.sum_image' (s := s) (g := cosetRep ζ)
      (f := fun t => ∑ g ∈ s.filter (fun g => cosetRep ζ g = t),
        f g • MonoidAlgebra.of K G g)
      (h := fun g => f g • MonoidAlgebra.of K G g) (fun i _ => rfl)).symm
  rw [hsplit]
  apply I.sum_mem
  intro t ht
  set B := s.filter (fun g => cosetRep ζ g = t) with hB
  have hBS : ∀ g ∈ B, SameCoset ζ t g := by
    intro g hg
    rw [hB, Finset.mem_filter] at hg
    have h := cosetRep_spec ζ g
    rw [hg.2] at h
    exact h
  -- each `g ∈ B` is `t · ζ^k`
  have hkey : ∀ g ∈ B, MonoidAlgebra.of K G g
      = MonoidAlgebra.of K G t * x ^ (powExp ζ t g) := by
    intro g hg
    obtain ⟨k, _, hgk⟩ := (sameCoset_iff_exists_pow hl hζ t g).mp (hBS g hg)
    have hspec := powExp_spec (ζ := ζ) (t := t) (g := g) ⟨k, hgk⟩
    conv_lhs => rw [hspec]
    rw [map_mul, map_pow, ← hx]
  have hcongr : ∀ g ∈ B, f g • MonoidAlgebra.of K G g
      = f g • (MonoidAlgebra.of K G t * x ^ (powExp ζ t g)) := by
    intro g hg
    rw [hkey g hg]
  rw [Finset.sum_congr rfl hcongr]
  -- split off the `of t` part
  have hsplit2 : ∀ g ∈ B, f g • (MonoidAlgebra.of K G t * x ^ (powExp ζ t g))
      = f g • (MonoidAlgebra.of K G t * (x ^ (powExp ζ t g) - 1))
        + f g • MonoidAlgebra.of K G t := by
    intro g _
    rw [mul_sub, mul_one, smul_sub, sub_add_cancel]
  rw [Finset.sum_congr rfl hsplit2, Finset.sum_add_distrib]
  have hzero : (∑ g ∈ B, f g • MonoidAlgebra.of K G t) = 0 := by
    rw [← Finset.sum_smul, hB, hcoset t ht, zero_smul]
  rw [hzero, add_zero]
  -- the remaining terms are left multiples of `x - 1`
  apply I.sum_mem
  intro g _
  have heq : f g • (MonoidAlgebra.of K G t * (x ^ powExp ζ t g - 1))
      = (algebraMap K (MonoidAlgebra K G) (f g) * MonoidAlgebra.of K G t *
          (∑ i ∈ Finset.range (powExp ζ t g), x ^ i)) * (x - 1) := by
    rw [Algebra.smul_def, ← geom_sum_mul]
    simp only [mul_assoc]
  rw [heq]
  exact I.mul_mem_left _ hx1

end CosetAux

theorem mem_span_of_coset_sums {X : Type*} [DecidableEq X] {K : Type*} [Field K]
    (r u : FreeGroup X) (l : ℕ) (hpos : 1 ≤ l) (hpow : r = u ^ l)
    (a : MonoidAlgebra K (Work.ORLyndon.OneRelatorGroup r))
    (h : ∀ g : Work.ORLyndon.OneRelatorGroup r,
          (Work.ORLyndon.uCoset r u l g).sum (fun hh => a.coeff hh) = 0) :
    a ∈ Ideal.span {((MonoidAlgebra.of K (Work.ORLyndon.OneRelatorGroup r))
        (Work.ORLyndon.presentRho r u)) - 1} := by
  classical
  -- `ζ = presentRho r u` has `ζ ^ l = 1`
  have hζ : (presentRho r u) ^ l = 1 := by
    rw [← map_pow, ← hpow, presentRho_relator]
  -- write `a` as the sum of its coefficients over its support
  have ha : a = ∑ g ∈ a.coeff.support, a.coeff g • MonoidAlgebra.of K (OneRelatorGroup r) g :=
    (MonoidAlgebra.sum_coeff_single a).symm.trans
      (Finsupp.sum_congr (f := a.coeff) (g1 := MonoidAlgebra.single)
        (g2 := fun g c => c • MonoidAlgebra.of K (OneRelatorGroup r) g) (fun g _ => by
          rw [MonoidAlgebra.of_apply, MonoidAlgebra.smul_single, smul_eq_mul, mul_one]))
  rw [ha]
  refine sum_smul_of_coset_sums hpos hζ (a.coeff.support) (fun g => a.coeff g) ?_
  intro t ht
  -- `t` is a coset representative
  have hrep : cosetRep (presentRho r u) t = t := by
    obtain ⟨g₀, _, hg₀⟩ := Finset.mem_image.mp ht
    rw [← hg₀]
    exact cosetRep_eq_of_sameCoset (cosetRep_spec (presentRho r u) g₀)
  -- the block of `t` sits inside the coset `tH`
  have hsub : a.coeff.support.filter (fun g => cosetRep (presentRho r u) g = t) ⊆
      uCoset r u l t := by
    intro g hg
    rw [Finset.mem_filter] at hg
    have hs : SameCoset (presentRho r u) t g := by
      have h' := cosetRep_spec (presentRho r u) g
      rw [hg.2] at h'
      exact h'
    obtain ⟨k, hk, hgk⟩ := (sameCoset_iff_exists_pow hpos hζ t g).mp hs
    exact (mem_uCoset r u l t g).mpr ⟨k, hk, hgk⟩
  -- elements of the coset outside `a`'s support contribute nothing
  have hz : ∀ x ∈ uCoset r u l t,
      x ∉ a.coeff.support.filter (fun g => cosetRep (presentRho r u) g = t) →
      (fun g => a.coeff g) x = 0 := by
    intro x hx hxB
    by_contra hne
    apply hxB
    rw [Finset.mem_filter]
    refine ⟨Finsupp.mem_support_iff.mpr hne, ?_⟩
    have hs : SameCoset (presentRho r u) t x := by
      obtain ⟨k, _, hgk⟩ := (mem_uCoset r u l t x).mp hx
      exact ⟨k, by rw [zpow_natCast]; exact hgk⟩
    rw [← cosetRep_eq_of_sameCoset hs, hrep]
  rw [Finset.sum_subset hsub hz, h t]

end Work.ORLyndon
