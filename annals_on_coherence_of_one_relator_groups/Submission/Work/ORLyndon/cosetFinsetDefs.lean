import Mathlib

/-!
# Right cosets of a cyclic subgroup, as finsets

Let `G` be a group, `w : G` and `l : ℕ` with `w ^ l = 1`.  For `t : G` the *right coset* of `t`
with respect to the cyclic subgroup `⟨w⟩` is `{t * w ^ m : m : ℤ} = t⟨w⟩`; since `w ^ l = 1`
(with `0 < l`) it is also `{t * w ^ k : k < l}`.  This file provides the finset

`cosetFinset w l t = {t * w ^ k : k < l}`

together with its basic properties.  It is the abstract version of
`Work.ORLyndon.uCoset r u l g` (which is the special case `w = presentRho r u`), used in the proof
of the annihilator statement `ker θ = K[G](u - 1)` of Lyndon's identity theorem.

## Main definitions

* `Work.ORLyndon.cosetFinset`

## Main results

* `Work.ORLyndon.mem_cosetFinset`
* `Work.ORLyndon.mem_cosetFinset_iff`: for `0 < l` and `w ^ l = 1`, membership is
  `∃ m : ℤ, h = t * w ^ m`.
* `Work.ORLyndon.cosetFinset_eq_of_sameCoset`: elements of the same right coset give the same
  finset.
-/

set_option autoImplicit false

namespace Work.ORLyndon

variable {G : Type*} [Group G] [DecidableEq G]

/-- The right coset of `t` with respect to the cyclic subgroup generated by `w`, realised as the
finset `{t * w ^ k : k < l}`.  When `0 < l` and `w ^ l = 1` this is exactly the coset `t⟨w⟩`. -/
noncomputable def cosetFinset (w : G) (l : ℕ) (t : G) : Finset G :=
  (Finset.univ : Finset (Fin l)).image (fun k : Fin l => t * w ^ (k : ℕ))

theorem mem_cosetFinset {w t h : G} {l : ℕ} :
    h ∈ cosetFinset w l t ↔ ∃ k : ℕ, k < l ∧ h = t * w ^ k := by
  classical
  simp only [cosetFinset, Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨k, rfl⟩
    exact ⟨(k : ℕ), k.2, rfl⟩
  · rintro ⟨k, hk, rfl⟩
    exact ⟨⟨k, hk⟩, rfl⟩

omit [DecidableEq G] in
/-- A nonnegative power `w ^ k` with `k < l` can be written as an integral power. -/
theorem exists_zpow_of_exists_pow {w t z : G} {l : ℕ}
    (hz : ∃ k : ℕ, k < l ∧ z = t * w ^ k) : ∃ m : ℤ, z = t * w ^ m := by
  obtain ⟨k, _, hk⟩ := hz
  exact ⟨(k : ℤ), by rw [zpow_natCast]; exact hk⟩

omit [DecidableEq G] in
/-- If `w ^ l = 1` with `0 < l`, every integral power of `w` is one of the powers `w ^ k`, `k < l`. -/
theorem zpow_eq_pow_emod {w : G} {l : ℕ} (hl : 0 < l) (hw : w ^ l = 1) (m : ℤ) :
    w ^ m = w ^ ((m % (l : ℤ)).toNat : ℕ) := by
  have hpos : (0 : ℤ) < (l : ℤ) := by exact_mod_cast hl
  have hr0 : 0 ≤ m % (l : ℤ) := Int.emod_nonneg m (by omega)
  rw [zpow_eq_zpow_emod' m hw, ← Int.toNat_of_nonneg hr0]
  exact zpow_natCast w _

omit [DecidableEq G] in
/-- Conversely, if `w ^ l = 1` with `0 < l` then every integral power can be reduced to a power
`w ^ k` with `k < l`. -/
theorem exists_pow_of_exists_zpow {w : G} {l : ℕ} (hl : 0 < l) (hw : w ^ l = 1) {t z : G}
    (hz : ∃ m : ℤ, z = t * w ^ m) : ∃ k : ℕ, k < l ∧ z = t * w ^ k := by
  obtain ⟨m, rfl⟩ := hz
  have hpos : (0 : ℤ) < (l : ℤ) := by exact_mod_cast hl
  have hrl : m % (l : ℤ) < (l : ℤ) := Int.emod_lt_of_pos m hpos
  exact ⟨(m % (l : ℤ)).toNat, by omega, by rw [zpow_eq_pow_emod hl hw m]⟩

/-- Membership in `cosetFinset w l t` for `w ^ l = 1` (`0 < l`): `h` is in the right coset of `t`
with respect to `⟨w⟩` iff `h = t * w ^ m` for some `m : ℤ`. -/
theorem mem_cosetFinset_iff {w t h : G} {l : ℕ} (hl : 0 < l) (hw : w ^ l = 1) :
    h ∈ cosetFinset w l t ↔ ∃ m : ℤ, h = t * w ^ m :=
  ⟨fun hh => exists_zpow_of_exists_pow (mem_cosetFinset.mp hh),
    fun hh => mem_cosetFinset.mpr (exists_pow_of_exists_zpow hl hw hh)⟩

/-- Two elements of the same right `⟨w⟩`-coset have the same coset finset. -/
theorem cosetFinset_eq_of_sameCoset {w g t : G} {l : ℕ} (hl : 0 < l) (hw : w ^ l = 1)
    (h : ∃ m : ℤ, t = g * w ^ m) : cosetFinset w l t = cosetFinset w l g := by
  obtain ⟨m₀, hm₀⟩ := h
  ext h
  rw [mem_cosetFinset_iff hl hw, mem_cosetFinset_iff hl hw]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m₀ + m, ?_⟩
    calc h = t * w ^ m := hm
      _ = (g * w ^ m₀) * w ^ m := by rw [hm₀]
      _ = g * (w ^ m₀ * w ^ m) := by rw [mul_assoc]
      _ = g * w ^ (m₀ + m) := by rw [zpow_add]
  · rintro ⟨m, hm⟩
    refine ⟨m - m₀, ?_⟩
    calc h = g * w ^ m := hm
      _ = g * w ^ (m₀ + (m - m₀)) := by
            have : m₀ + (m - m₀) = m := by omega
            rw [this]
      _ = g * (w ^ m₀ * w ^ (m - m₀)) := by rw [zpow_add]
      _ = (g * w ^ m₀) * w ^ (m - m₀) := by rw [mul_assoc]
      _ = t * w ^ (m - m₀) := by rw [hm₀]

end Work.ORLyndon
