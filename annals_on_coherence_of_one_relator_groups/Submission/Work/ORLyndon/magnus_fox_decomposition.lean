import Mathlib
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.Fox
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORLyndon.augIdealIn_eq_span
import Submission.Work.ORLyndon.finsupp_sum_erase_add
import Submission.Work.ORLyndon.finsupp_erase_sum_mem_augIdealIn
import Submission.Work.ORLyndon.Fox.fundamental_identity_map

/-!
# The Magnus–Fox decomposition of `u - 1`

Let `X` be a generating set, `K` a field, `r : F(X)` a relator and `G = ⟨X | r⟩` the associated
one-relator group (`Work.ORLyndon.OneRelatorGroup`).  Let `t : X` be a distinguished generator and
`Y : Finset X` the set of the remaining generators, so that `X = Y ∪ {t}` (`hY` says exactly that
every generator outside `Y` is `t`, and `ht` that `t ∉ Y`).

The *Magnus–Fox decomposition* of an element `u : F(X)` in the group algebra `K[G]` is the identity

`ρ(u) - 1 = α + β * (t - 1)`,

where `β = ∂u/∂t` is the Fox derivative of `u` with respect to `t` (pushed into `K[G]` by the
presentation map `presentAlg`), and the *remainder* `α` lies in the left ideal `I^G_{K[H]}`
generated by the augmentation ideal of the subgroup `H` generated by (the images of) the generators
in `Y`.

Concretely, the Fox fundamental identity `u - 1 = Σ_x (∂u/∂x)(x - 1)` gives the decomposition by
isolating the term belonging to `t`; the remaining terms involve only the generators `Y` and hence
lie in `I^G_{K[H]}`.

## Main result

* `Work.ORLyndon.magnus_fox_decomposition`
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

theorem magnus_fox_decomposition {X : Type*} [DecidableEq X] {K : Type*} [Field K]
    (Y : Finset X) (t : X) (ht : t ∉ Y) (hY : ∀ x : X, x ∉ Y → x = t) (r u : FreeGroup X) :
    ∃ (α β : MonoidAlgebra K (Work.ORLyndon.OneRelatorGroup r)),
      α ∈ Work.ORLyndon.augIdealIn K (Subgroup.closure (PresentedGroup.of '' (Y : Set X))) ∧
      β = (Work.ORLyndon.presentAlg K r) (Work.ORLyndon.foxD (K := K) t u) ∧
      ((MonoidAlgebra.of K (Work.ORLyndon.OneRelatorGroup r)) (Work.ORLyndon.presentRho r u) - 1
        = α + β * (((MonoidAlgebra.of K (Work.ORLyndon.OneRelatorGroup r))
            (PresentedGroup.of t)) - 1)) := by
  -- the subgroup generated by the images of the generators in `Y`
  let H : Subgroup (OneRelatorGroup r) :=
    Subgroup.closure (PresentedGroup.of '' (Y : Set X))
  -- the Fox derivative vector of `u`, pushed into `K[G]`
  let D : X →₀ MonoidAlgebra K (OneRelatorGroup r) :=
    (foxFD (K := K) u).mapRange (presentAlg K r) (map_zero _)
  -- the `x`-th summand of the Fox fundamental identity
  let g : X → MonoidAlgebra K (OneRelatorGroup r) → MonoidAlgebra K (OneRelatorGroup r) :=
    fun x d => d * ((MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of x) - 1)
  -- the remainder `α` (the terms other than `t`) and the `t`-component `β`
  let α : MonoidAlgebra K (OneRelatorGroup r) := (D.erase t).sum g
  let β : MonoidAlgebra K (OneRelatorGroup r) := (presentAlg K r) (foxD (K := K) t u)
  refine ⟨α, β, ?_, rfl, ?_⟩
  · -- `α` lies in the left ideal generated by the augmentation ideal of `H`
    have hσ : ∀ x : X, x ≠ t → PresentedGroup.of x ∈ H := by
      intro x hx
      have hxY : x ∈ Y := by
        by_contra hc
        exact hx (hY x hc)
      exact Subgroup.subset_closure ⟨x, hxY, rfl⟩
    exact finsupp_erase_sum_mem_augIdealIn H (fun x => PresentedGroup.of x) t hσ D
  · -- the Fox fundamental identity, split at `t`
    have hg0 : ∀ x : X, g x 0 = 0 := fun x => by simp only [g, zero_mul]
    have hgadd : ∀ (x : X) (a b : MonoidAlgebra K (OneRelatorGroup r)),
        g x (a + b) = g x a + g x b := fun x a b => by simp only [g, add_mul]
    -- rewrite the fundamental identity into the group-algebra vocabulary of `G`
    have hcongr : D.sum (fun x d =>
          d * ((presentAlg K r) ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of x)) - 1))
        = D.sum g := by
      apply Finsupp.sum_congr
      intro x _
      show D x * ((presentAlg K r) ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of x)) - 1)
          = D x * ((MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of x) - 1)
      rw [presentAlg_of, presentRho_of]
    have hfund : D.sum g = (MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u) - 1 := by
      rw [← hcongr]
      have h := Work.ORLyndon.Fox.fundamental_identity_map (K := K) (presentAlg K r) u
      rw [h, presentAlg_of]
    -- split off the `t`-term of the sum
    have hsplit : D.sum g = (D.erase t).sum g + g t (D t) :=
      finsupp_sum_erase_add D t g hg0 hgadd
    have hDt : D t = β := by
      dsimp only [D, β]
      rw [Finsupp.mapRange_apply, foxFD_apply]
    have hgt : g t (D t) = β * ((MonoidAlgebra.of K (OneRelatorGroup r))
        (PresentedGroup.of t) - 1) := by
      rw [hDt]
    have hgoal : D.sum g = α + β * ((MonoidAlgebra.of K (OneRelatorGroup r))
        (PresentedGroup.of t) - 1) := by
      rw [hsplit, hgt]
    calc (MonoidAlgebra.of K (OneRelatorGroup r)) (presentRho r u) - 1
        = D.sum g := hfund.symm
      _ = α + β * ((MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of t) - 1) := hgoal

end Work.ORLyndon
