import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.LyndonIndependenceDefs
import Submission.Work.ORLyndon.lyndon_ker_theta_le
import Submission.Work.ORLyndon.lyndon_ker_theta_of_independence
import Submission.Work.ORLyndon.lyndon_range_theta
import Submission.Work.ORLyndon.GlobalDimRes

/-!
# Lyndon's identity theorem from the Cohen--Lyndon theorem

This file discharges the hypothesis structure `Work.ORLyndon.LyndonIdentity` — the exactness of the
Lyndon complex of a one-relator presentation — using

* `Work.ORLyndon.lyndon_range_theta` (proved): `range θ = ker δ`, i.e. the relation module is
  generated by the Fox derivative vector (this holds for every relator `r ≠ 1`, and uses the
  freeness of the augmentation ideal of the free group algebra,
  `Work.ORFP2.augIdeal_freeGroup_injective`);
* `Work.ORLyndon.lyndon_ker_theta_le` (proved) and
  `Work.ORLyndon.lyndon_ker_theta_of_independence`: the annihilator of the Fox derivative vector is
  exactly `K[G](u - 1)`;
* `Work.ORLyndon.LyndonIndependence` (`LyndonIndependenceDefs.lean`): the **Cohen--Lyndon**
  independence of the conjugates of the relator over a transversal of the `⟨u⟩`-cosets, in module
  form.  This is the one classical input that is *not* a consequence of the four theorems bundled in
  `Work.OROneRel.OneRelatorCombinatorics` (Freiheitssatz, Magnus--Moldavanskii hierarchy, Weinbaum,
  Karrass--Magnus--Solitar); it is equivalent to Lyndon's asphericity theorem for one-relator
  presentation complexes, and is recorded here as an explicit hypothesis.

For the trivial relator `r = 1` the situation is degenerate (`u ^ l = 1` forces `u = 1` and then
`ker θ = ⊤` rather than `K[G](u - 1) = 0`); that base case is `Work.ORLyndon.lyndon_free_exact`
(`LyndonFree.lean`).
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

/-- **Lyndon's identity theorem**, from the Cohen--Lyndon independence.  For `r = u ^ l ≠ 1` with
`u` not a proper power, the relation module of `⟨X | r⟩` is the cyclic `K[G]`-module generated by
the Fox derivative vector of `r`, with annihilator the left ideal generated by `u - 1`. -/
theorem lyndonIdentity_of_independence {X : Type u} [DecidableEq X] {K : Type v} [Field K]
    {r u : FreeGroup X} {l : ℕ} (hpos : 0 < l) (hpow : r = u ^ l)
    (hpp : IsNotProperPower u) (hr : r ≠ 1) (hind : LyndonIndependence K r u) :
    LyndonIdentity K X r u l where
  hpos := hpos
  hpow := hpow
  hnotProperPower := hpp
  range_theta := lyndon_range_theta (K := K) r hr
  ker_theta := le_antisymm
    (lyndon_ker_theta_of_independence r u l
      (Nat.one_le_iff_ne_zero.mpr (Nat.pos_iff_ne_zero.mp hpos)) hpow hind)
    (lyndon_ker_theta_le r u l hpow)

/-- **`Work.ORCoherence.globalDim (K[G]) ≤ 2` for one-relator groups**, from the Cohen--Lyndon
independence only. -/
theorem globalDim_le_two_of_independence {X : Type u} [DecidableEq X] {K : Type v} [Field K]
    [CharZero K] {r u : FreeGroup X} {l : ℕ} (hpos : 0 < l) (hpow : r = u ^ l)
    (hpp : IsNotProperPower u) (hr : r ≠ 1) (hind : LyndonIndependence K r u) :
    Work.ORCoherence.globalDim (MonoidAlgebra K (OneRelatorGroup r)) ≤ (2 : WithBot ℕ∞) :=
  globalDim_le_two_of_lyndon (lyndonIdentity_of_independence hpos hpow hpp hr hind)

end Work.ORLyndon
