/-
# The two-occurrence vocabulary, and the Freiheitssatz order certificate

Leaf module for the two-occurrence analysis of the root Fox vector, shared by
`Submission/Work/ORLyndon/epsNeZeroDescent.lean` and by the two component lemmas

* `Work.ORLyndon.orderOf_presentRho_twoOcc` (`Submission/Work/ORLyndon/orderOf_presentRho_twoOcc.lean`),
* `Work.ORLyndon.rootVec_eq_of_twoOcc` (`Submission/Work/ORLyndon/rootVec_eq_of_twoOcc.lean`).

It contains

* the vocabulary `magIncl` (the inclusion `F(α ∖ {x}) →* F(α)` of the Magnus subgroup), `xbOf`
  (`x` or `x⁻¹`), and the "prefix" / "ratio" elements `twoOccPref`, `twoOccRatio` attached to a
  decomposition `u = P · xb · A · xb · B`;
* the order certificates used to prove that the ratio has infinite order: infinite order is
  inherited by an injective homomorphism, is automatic for nontrivial elements of a free group, and
  is provided by the Freiheitssatz for nontrivial elements of the free Magnus subgroup
  `F(α ∖ {y}) ≤ ⟨α | u⟩`.

Keeping these in a leaf module is what makes the two component lemmas importable by
`epsNeZeroDescent.lean` itself (they must not import it, or the dependency would be cyclic).
-/
import Mathlib
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.powDefs
import Submission.Work.ORLyndon.Fox
import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.OROneRel.letters_closure_iff

set_option autoImplicit false
set_option linter.unusedVariables false

universe u v

namespace Work.ORLyndon

variable {α : Type u} [DecidableEq α]

section TwoOccDefs

/-- The inclusion `F(α ∖ {x}) →* F(α)` of the Magnus subgroup generated by the letters other than
`x`. -/
noncomputable def magIncl (x : α) : FreeGroup {z : α // z ≠ x} →* FreeGroup α :=
  FreeGroup.lift fun z => FreeGroup.of (z : α)

/-- The generator `x` (`b = true`) or its inverse (`b = false`), as an element of `F(α)`. -/
noncomputable def xbOf (x : α) (b : Bool) : FreeGroup α :=
  if b then FreeGroup.of x else (FreeGroup.of x)⁻¹

/-- The element of `F(α)` whose image is the first occurrence term of `∂u/∂x` when
`u = P · xb · A · xb · B` with `xb = x^{±1}`: the prefix ending just before (resp. just after) the
first occurrence of `x^{±1}`. -/
noncomputable def twoOccPref (x : α) (b : Bool) (P : FreeGroup {z : α // z ≠ x}) : FreeGroup α :=
  if b then magIncl x P else magIncl x P * (FreeGroup.of x)⁻¹

/-- The ratio of the two occurrence terms of `∂u/∂x` when `u = P · xb · A · xb · B`: the second
term is `twoOccPref x b P * twoOccRatio x b A`. -/
noncomputable def twoOccRatio (x : α) (b : Bool) (A : FreeGroup {z : α // z ≠ x}) : FreeGroup α :=
  if b then FreeGroup.of x * magIncl x A else magIncl x A * (FreeGroup.of x)⁻¹

end TwoOccDefs

/-! ## Order certificates -/

section OrderCertificates

/-- **Infinite order is inherited by an injective homomorphism.**  If `ψ : G →* H` is injective and
`w` has infinite order, then so does `ψ w`.  This is the form in which the infinite order of the
occurrence ratios is certified by exhibiting a torsion-free quotient into which the ratio maps
non-trivially (`orderOf_eq_zero_of_maps_ne_one`), resp. by mapping a non-trivial element of a *free*
Magnus subgroup injectively into the one-relator group (the Freiheitssatz). -/
theorem orderOf_eq_zero_of_injective {G H : Type*} [Group G] [Group H] (ψ : G →* H)
    (hψ : Function.Injective ψ) {w : G} (hw : orderOf w = 0) : orderOf (ψ w) = 0 := by
  rw [orderOf_eq_zero_iff'] at hw ⊢
  intro n hn h1
  exact hw n hn (hψ (by rw [map_pow, h1, map_one]))

/-- Every nontrivial element of a free group has infinite order. (Free groups are `IsMulTorsionFree`
in Mathlib.) -/
theorem orderOf_eq_zero_of_ne_one_freeGroup {α : Type u} {w : FreeGroup α} (hw : w ≠ 1) :
    orderOf w = 0 := by
  rw [orderOf_eq_zero_iff']
  intro n hn h1
  exact hw (IsMulTorsionFree.pow_left_injective (M := FreeGroup α) (show n ≠ 0 by omega)
    (by show w ^ n = 1 ^ n; rw [h1, one_pow]))

/-- **The order certificate through an injective Magnus map.**  If `F(T) →* ⟨α | r⟩` is injective (as
the Freiheitssatz asserts whenever `r ∉ ⟨T⟩`) then the class of a nontrivial element of `F(T)` has
infinite order in `⟨α | r⟩`. -/
theorem orderOf_presentedGroupMap_eq_zero {α : Type u} [DecidableEq α] {r : FreeGroup α} {T : Set α}
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap r T)) {w : FreeGroup T}
    (hw : w ≠ 1) : orderOf (Work.OROneRel.presentedGroupMap r T w) = 0 :=
  orderOf_eq_zero_of_injective _ hinj (orderOf_eq_zero_of_ne_one_freeGroup hw)

/-- **The Freiheitssatz certificate.**  If `w` is a nontrivial element of the free group on the
generators other than a letter `y` of the cyclically reduced relator `u`, then the class of `w` in
`⟨α | u⟩` has infinite order: `w` lies in a Magnus subgroup, which is free. -/
theorem orderOf_presentedGroupMap_misses_eq_zero {u : FreeGroup α}
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u) {y : α}
    (hy : y ∈ Work.OROneRel.relatorLetters u) {w : FreeGroup {z : α // z ≠ y}} (hw : w ≠ 1) :
    orderOf (Work.OROneRel.presentedGroupMap u {z : α | z ≠ y} w) = 0 := by
  refine orderOf_presentedGroupMap_eq_zero ?_ hw
  refine Work.OROneRel.freiheitssatz_at u hcyc {z : α | z ≠ y} ?_
  rw [Work.OROneRel.letters_closure_iff]
  exact fun hsub => hsub hy rfl

end OrderCertificates

end Work.ORLyndon
