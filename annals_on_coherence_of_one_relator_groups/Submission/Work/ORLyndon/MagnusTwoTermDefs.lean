import Mathlib
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.Magnus
import Submission.Work.ORLyndon.Augmentation

/-!
# The middle term of the two-term form of Lyndon's identity theorem

Let `X` be a generating type, `K` a field, `r : F(X)` a relator, `G = ⟨X | r⟩` the one-relator
group, `t : X` a distinguished generator and `Y : Finset X` the set of remaining generators
(`hY` says that every generator outside `Y` is `t`, and `ht` that `t ∉ Y`).  Put
`A = ⟨Y⟩ ≤ G`, the *Magnus subgroup* generated by the images of the generators in `Y`.

The Lyndon resolution of the one-relator presentation has middle term `K[G]^X`, and the two-term
form of Lyndon's identity theorem (JL Claim 5.10) rewrites `K[G]^X = K[G]^Y ⊕ K[G]` as
`I^G_{K[A]} ⊕ K[G]`, using that the `K[G]`-linear map

`K[G]^Y → I^G_{K[A]},  c ↦ ∑_y c_y (y - 1)`

is an isomorphism (the Magnus subgroup `A` is free on `Y` by the Freiheitssatz).

This file collects the elementary vocabulary for that statement:

* `deltaYY` — the `Y`-indexed map `K[G]^Y → K[G]`, `c ↦ ∑_y c_y (y - 1)`;
* `subtypeDomainLM` — restriction of an `X`-indexed family to `Y`;
* `deltaYBar` — their composite, the `X`-indexed version of `deltaYY`;
* the elementary identity `deltaYBar (single t c) = 0`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

variable {X : Type u} {K : Type v}

/-- The `Y`-indexed *Magnus map*: `K[G]^Y → K[G]`, `c ↦ ∑_y c_y (y - 1)`, where `y` is the image
of the generator `y ∈ Y` in the one-relator group `G = ⟨X | r⟩`. -/
noncomputable def deltaYY [Field K] (Y : Finset X) (r : FreeGroup X) :
    ((Y : Set X) →₀ MonoidAlgebra K (OneRelatorGroup r)) →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      MonoidAlgebra K (OneRelatorGroup r) :=
  Finsupp.linearCombination (MonoidAlgebra K (OneRelatorGroup r))
    (fun y : (Y : Set X) =>
      (MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of (y : X)) - 1)

@[simp] theorem deltaYY_apply [Field K] (Y : Finset X) (r : FreeGroup X)
    (c : (Y : Set X) →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    deltaYY (K := K) Y r c =
      c.sum (fun y a => a * ((MonoidAlgebra.of K (OneRelatorGroup r)) (PresentedGroup.of (y : X))
        - 1)) := by
  rw [deltaYY, Finsupp.linearCombination_apply]
  exact Finsupp.sum_congr (fun y _ => by rw [smul_eq_mul])

/-- The restriction `K[G]^X → K[G]^Y` of an `X`-indexed family to the subset `Y`. -/
noncomputable def subtypeDomainLM [DecidableEq X] [Field K] (Y : Finset X) (r : FreeGroup X) :
    (X →₀ MonoidAlgebra K (OneRelatorGroup r)) →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      ((Y : Set X) →₀ MonoidAlgebra K (OneRelatorGroup r)) where
  toFun v := Finsupp.subtypeDomain (· ∈ Y) v
  map_add' v w := by
    ext y
    simp only [Finsupp.subtypeDomain_apply, Finsupp.add_apply]
  map_smul' c v := by
    ext y
    simp only [Finsupp.subtypeDomain_apply, Finsupp.smul_apply]
    rfl

@[simp] theorem subtypeDomainLM_apply [DecidableEq X] [Field K] (Y : Finset X) (r : FreeGroup X)
    (v : X →₀ MonoidAlgebra K (OneRelatorGroup r)) (y : (Y : Set X)) :
    subtypeDomainLM (K := K) Y r v y = v (y : X) :=
  Finsupp.subtypeDomain_apply

/-- The `X`-indexed *Magnus map*: `K[G]^X → K[G]`, `v ↦ ∑_{x ∈ Y} v_x (x - 1)`, i.e. `deltaYY`
applied to the `Y`-part of `v`. -/
noncomputable def deltaYBar [DecidableEq X] [Field K] (Y : Finset X) (r : FreeGroup X) :
    (X →₀ MonoidAlgebra K (OneRelatorGroup r)) →ₗ[MonoidAlgebra K (OneRelatorGroup r)]
      MonoidAlgebra K (OneRelatorGroup r) :=
  (deltaYY (K := K) Y r).comp (subtypeDomainLM (K := K) Y r)

theorem deltaYBar_apply_def [DecidableEq X] [Field K] (Y : Finset X) (r : FreeGroup X)
    (v : X →₀ MonoidAlgebra K (OneRelatorGroup r)) :
    deltaYBar (K := K) Y r v = deltaYY (K := K) Y r (subtypeDomainLM (K := K) Y r v) := rfl

/-- The restriction to `Y` of the vector `single t c` (with `t ∉ Y`) is zero. -/
theorem subtypeDomainLM_single_t [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (r : FreeGroup X) (c : MonoidAlgebra K (OneRelatorGroup r)) :
    subtypeDomainLM (K := K) Y r (Finsupp.single t c) = 0 := by
  apply Finsupp.ext
  intro y
  rw [subtypeDomainLM_apply, Finsupp.single_apply]
  exact if_neg (fun (h : t = (y : X)) => ht (by rw [h]; exact y.2))

/-- `deltaYBar` kills the vector `single t c` supported at the distinguished generator `t`. -/
theorem deltaYBar_single_t [DecidableEq X] [Field K] (Y : Finset X) {t : X} (ht : t ∉ Y)
    (r : FreeGroup X) (c : MonoidAlgebra K (OneRelatorGroup r)) :
    deltaYBar (K := K) Y r (Finsupp.single t c) = 0 := by
  rw [deltaYBar_apply_def, subtypeDomainLM_single_t Y ht r c, map_zero]

/-- The Magnus subgroup `A = ⟨Y⟩ ≤ G` generated by the images of the generators in `Y`. -/
abbrev magnusSub (Y : Finset X) (r : FreeGroup X) : Subgroup (OneRelatorGroup r) :=
  Subgroup.closure (PresentedGroup.of '' (Y : Set X))

end Work.ORLyndon
