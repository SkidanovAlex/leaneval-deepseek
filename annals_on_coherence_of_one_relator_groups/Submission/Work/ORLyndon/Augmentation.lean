import Mathlib

/-!
# Augmentation ideals of group algebras

For a monoid `G` and a commutative semiring `K`, the *augmentation* `ε : K[G] →+* K` is the
algebra map sending every group element to `1`.  Its kernel `I_{K[G]}` is the **augmentation
ideal**; it is the left ideal generated by the elements `g - 1` (`Work.ORLyndon.augIdeal_eq_span`).

Given a subgroup `H ≤ G`, `I^G_{K[H]}` denotes the left ideal of `K[G]` generated by the image of
`I_{K[H]}`; it is used throughout the Lyndon resolution of a one-relator group, see
`Work.ORLyndon.Lyndon`.

## Main definitions

* `Work.ORLyndon.augmentation`: the augmentation `ε : K[G] →ₐ[K] K`.
* `Work.ORLyndon.augIdeal`: the augmentation ideal `I_{K[G]} = ker ε`.
* `Work.ORLyndon.augIdealIn`: `I^G_{K[H]}`, the left ideal of `K[G]` generated by `I_{K[H]}`.

## Main results

* `Work.ORLyndon.mem_augIdeal`: `a ∈ I_{K[G]} ↔ ε a = 0`.
* `Work.ORLyndon.augIdeal_eq_span`: `I_{K[G]}` is generated by `{g - 1 : g ∈ G}`.
* `Work.ORLyndon.augIdealIn_eq_span`: `I^G_{K[H]}` is generated by `{h - 1 : h ∈ H}`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v w

variable {K : Type u} {G : Type v}

section Augmentation

variable [CommSemiring K] [Monoid G]

/-- The augmentation `ε : K[G] →ₐ[K] K`, the `K`-algebra map sending every group element to `1`. -/
noncomputable def augmentation (K : Type u) [CommSemiring K] (G : Type v) [Monoid G] :
    MonoidAlgebra K G →ₐ[K] K :=
  MonoidAlgebra.lift K K G (1 : G →* K)

theorem augmentation_apply (a : MonoidAlgebra K G) :
    augmentation K G a = a.coeff.sum (fun _ c => c) := by
  change (MonoidAlgebra.lift K K G (1 : G →* K)) a = a.coeff.sum (fun _ c => c)
  rw [MonoidAlgebra.lift_apply]
  simp

@[simp] theorem augmentation_of (g : G) :
    augmentation K G (MonoidAlgebra.of K G g) = 1 := by
  change (MonoidAlgebra.lift K K G (1 : G →* K)) (MonoidAlgebra.of K G g) = 1
  rw [MonoidAlgebra.lift_of]
  exact OneHom.one_apply g

@[simp] theorem augmentation_single (g : G) (c : K) :
    augmentation K G (MonoidAlgebra.single g c) = c := by
  change (MonoidAlgebra.lift K K G (1 : G →* K)) (MonoidAlgebra.single g c) = c
  rw [MonoidAlgebra.lift_single]
  simp

@[simp] theorem augmentation_one : augmentation K G (1 : MonoidAlgebra K G) = 1 :=
  map_one _

@[simp] theorem augmentation_zero : augmentation K G (0 : MonoidAlgebra K G) = 0 :=
  map_zero _

theorem augmentation_add (a b : MonoidAlgebra K G) :
    augmentation K G (a + b) = augmentation K G a + augmentation K G b :=
  map_add _ _ _

theorem augmentation_mul (a b : MonoidAlgebra K G) :
    augmentation K G (a * b) = augmentation K G a * augmentation K G b :=
  map_mul _ _ _

end Augmentation

section AugIdeal

variable [CommSemiring K] [Monoid G]

/-- The augmentation ideal `I_{K[G]}`, the kernel of the augmentation `ε : K[G] → K`. -/
noncomputable def augIdeal (K : Type u) [CommSemiring K] (G : Type v) [Monoid G] :
    Ideal (MonoidAlgebra K G) :=
  RingHom.ker (augmentation K G : MonoidAlgebra K G →+* K)

@[simp] theorem mem_augIdeal {a : MonoidAlgebra K G} :
    a ∈ augIdeal K G ↔ augmentation K G a = 0 := Iff.rfl

theorem augIdeal_def : augIdeal K G = RingHom.ker (augmentation K G : MonoidAlgebra K G →+* K) :=
  rfl

end AugIdeal

section AugIdealIn

variable [CommSemiring K] [Group G]

/-- `I^G_{K[H]}`, the left ideal of `K[G]` generated by the image of the augmentation ideal
`I_{K[H]}` of the subgroup algebra `K[H]`. -/
noncomputable def augIdealIn (K : Type u) [CommSemiring K] {G : Type v} [Group G]
    (H : Subgroup G) : Ideal (MonoidAlgebra K G) :=
  Ideal.span ((MonoidAlgebra.mapDomainRingHom K H.subtype) '' (augIdeal K H : Set _))

end AugIdealIn

end Work.ORLyndon
