import Mathlib
import Submission.Work.ORLyndon.MagnusTwoTermDefs
import Submission.Work.ORLyndon.augIdealIn_eq_span

/-!
# The range of the Magnus map `deltaYY`

Let `X` be a generating type, `K` a field, `r : F(X)` a relator and `Y : Finset X`.  With
`G = ⟨X | r⟩` the one-relator group and

`deltaYY Y r : K[G]^Y → K[G],  c ↦ Σ_{y ∈ Y} c_y (y - 1)`,

the `Y`-indexed Magnus map of `Work.ORLyndon.MagnusTwoTermDefs`, this file proves that its range is
exactly the left ideal `I^G_{K[A]}` of `K[G]` generated by the augmentation ideal of the Magnus
subgroup `A = ⟨Y⟩ = Subgroup.closure (PresentedGroup.of '' Y)`.

The two inclusions are:

* `range ⊆ I^G_{K[A]}`: `deltaYY c` is a finite `K[G]`-linear combination of the elements
  `y - 1`, each of which lies in `I^G_{K[A]}` because `y ∈ A` (`augIdealIn_eq_span`).
* `I^G_{K[A]} ⊆ range`: `I^G_{K[A]}` is spanned by `{h - 1 : h ∈ A}` (`augIdealIn_eq_span`), and
  since `A` is generated by the images of the elements of `Y`, each `h - 1` lies in the span of the
  generators `y - 1`, which all lie in `range deltaYY`.

## Main results

* `Work.ORLyndon.augIdealIn_eq_span_of_closure`: `I^G_{K[H]}`, for `H` generated by the range of
  `f : X → H`, is spanned by `{f x - 1}`.
* `Work.ORLyndon.deltaYY_range`: `range (deltaYY Y r) = I^G_{K[A]}`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

/-- If `f : X → H` is a family whose range generates a subgroup `H ≤ G`, then the `K[G]`-submodule
of `K[G]` spanned by the elements `f x - 1` is `I^G_{K[H]}`, the left ideal generated by the
augmentation ideal of `K[H]`.

Indeed `I^G_{K[H]}` is spanned by all `h - 1` (`h : H`) by `augIdealIn_eq_span`, and every `h - 1`
lies in the span of the `f x - 1`: this follows by closure induction in `H`, using the identities
`hk - 1 = h(k - 1) + (h - 1)` and `h⁻¹ - 1 = -(h⁻¹ (h - 1))`. -/
theorem augIdealIn_eq_span_of_closure {K : Type*} [CommRing K] {G : Type*} [Group G]
    {X : Type*} {H : Subgroup G} (f : X → H) (hf : Subgroup.closure (Set.range f) = ⊤) :
    Submodule.span (MonoidAlgebra K G)
      (Set.range (fun x => MonoidAlgebra.of K G ((f x : H) : G) - 1)) =
      (augIdealIn K H : Submodule (MonoidAlgebra K G) (MonoidAlgebra K G)) := by
  rw [augIdealIn_eq_span]
  let S : Submodule (MonoidAlgebra K G) (MonoidAlgebra K G) :=
    Submodule.span (MonoidAlgebra K G)
      (Set.range (fun x => MonoidAlgebra.of K G ((f x : H) : G) - 1))
  -- the set of `h : H` with `of h - 1 ∈ S` is a subgroup of `H`
  let H' : Subgroup H :=
    { carrier := {h : H | MonoidAlgebra.of K G ((h : H) : G) - 1 ∈ S}
      mul_mem' := by
        intro a b ha hb
        change MonoidAlgebra.of K G (((a * b : H) : H) : G) - 1 ∈ S
        have h1 : MonoidAlgebra.of K G (((a * b : H) : H) : G) - 1 =
            MonoidAlgebra.of K G ((a : H) : G) * (MonoidAlgebra.of K G ((b : H) : G) - 1) +
              (MonoidAlgebra.of K G ((a : H) : G) - 1) := by
          rw [Subgroup.coe_mul, map_mul, mul_sub, mul_one]; abel
        rw [h1]
        exact Submodule.add_mem _
          (by simpa only [smul_eq_mul] using
            Submodule.smul_mem S (MonoidAlgebra.of K G ((a : H) : G)) hb) ha
      one_mem' := by
        change MonoidAlgebra.of K G ((1 : H) : G) - 1 ∈ S
        rw [Subgroup.coe_one, map_one, sub_self]
        exact Submodule.zero_mem _
      inv_mem' := by
        intro a ha
        change MonoidAlgebra.of K G (((a⁻¹ : H) : H) : G) - 1 ∈ S
        have h1 : MonoidAlgebra.of K G (((a⁻¹ : H) : H) : G) - 1 =
            -(MonoidAlgebra.of K G ((a⁻¹ : H) : G) *
              (MonoidAlgebra.of K G ((a : H) : G) - 1)) := by
          rw [Subgroup.coe_inv, mul_sub, mul_one, ← map_mul, inv_mul_cancel, map_one]; abel
        rw [h1]
        exact Submodule.neg_mem _
          (by simpa only [smul_eq_mul] using
            Submodule.smul_mem S (MonoidAlgebra.of K G ((a⁻¹ : H) : G)) ha) }
  have key : ∀ h : H, MonoidAlgebra.of K G ((h : H) : G) - 1 ∈ S := by
    intro h
    have hle : Subgroup.closure (Set.range f) ≤ H' := by
      rw [Subgroup.closure_le]
      rintro g ⟨x, rfl⟩
      exact Submodule.subset_span ⟨x, rfl⟩
    exact hle (by rw [hf]; exact Subgroup.mem_top h)
  refine le_antisymm ?_ ?_
  · -- `span {f x - 1} ≤ span {h - 1}`
    rw [Submodule.span_le]
    rintro y ⟨x, rfl⟩
    exact Submodule.subset_span ⟨f x, rfl⟩
  · -- `span {h - 1} ≤ span {f x - 1}`
    rw [Submodule.span_le]
    rintro y ⟨h, rfl⟩
    exact key h

theorem deltaYY_range {X : Type*} [DecidableEq X] {K : Type*} [Field K]
    (Y : Finset X) (r : FreeGroup X) :
    LinearMap.range (Work.ORLyndon.deltaYY (K := K) Y r) =
      (Work.ORLyndon.augIdealIn K (Subgroup.closure (PresentedGroup.of '' (Y : Set X))) :
        Submodule (MonoidAlgebra K (Work.ORLyndon.OneRelatorGroup r))
          (MonoidAlgebra K (Work.ORLyndon.OneRelatorGroup r))) := by
  classical
  let Hc : Subgroup (Work.ORLyndon.OneRelatorGroup r) :=
    Subgroup.closure (PresentedGroup.of '' (Y : Set X))
  let f : ↥(Y : Set X) → Hc := fun y =>
    ⟨PresentedGroup.of (y : X), Subgroup.subset_closure ⟨y, y.2, rfl⟩⟩
  -- the images of the elements of `Y` generate the Magnus subgroup `Hc`
  have hf : Subgroup.closure (Set.range f) = ⊤ := by
    rw [Subgroup.eq_top_iff']
    intro h
    refine Subgroup.closure_induction
      (p := fun (x : Work.ORLyndon.OneRelatorGroup r)
        (hx : x ∈ Subgroup.closure (PresentedGroup.of '' (Y : Set X))) =>
        (⟨x, hx⟩ : Hc) ∈ Subgroup.closure (Set.range f)) ?_ ?_ ?_ ?_ h.2
    · rintro x ⟨a, ha, rfl⟩
      refine Subgroup.subset_closure ?_
      exact Set.mem_range_self (⟨a, ha⟩ : ↥(Y : Set X))
    · exact Subgroup.one_mem _
    · intro x y hx hy ihx ihy
      exact Subgroup.mul_mem _ ihx ihy
    · intro x hx ihx
      exact Subgroup.inv_mem _ ihx
  -- `deltaYY` is the linear combination of the generators `y - 1` over `y : Y`
  show LinearMap.range (Finsupp.linearCombination
      (MonoidAlgebra K (Work.ORLyndon.OneRelatorGroup r))
      (fun y : ↥(Y : Set X) => MonoidAlgebra.of K (Work.ORLyndon.OneRelatorGroup r)
        (PresentedGroup.of (y : X)) - 1)) = _
  rw [Finsupp.range_linearCombination]
  exact augIdealIn_eq_span_of_closure (K := K) (H := Hc) f hf

end Work.ORLyndon
