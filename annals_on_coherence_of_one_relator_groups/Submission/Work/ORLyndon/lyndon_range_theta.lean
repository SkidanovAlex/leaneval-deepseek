import Mathlib
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORLyndon.foxD_multiple_of_mem_normalClosure
import Submission.Work.ORFP2.augIdeal_freeGroup_injective
import Submission.Work.ORFP2.mapDomainAlgHom_eq_zero_iff_mem_span

/-!
# The middle exactness of the Lyndon complex: `range θ = ker δ`

For a set `X`, a field `K` and a relator `r : F(X)`, the Lyndon complex of the one-relator
presentation `G = ⟨X | r⟩` has middle maps

`θ : K[G] → K[G]^X,   a ↦ a • (∂r/∂x)_x`   and   `δ : K[G]^X → K[G],   (a_x) ↦ Σ_x a_x (x - 1)`.

This file proves `range θ = ker δ` for **every** relator `r ≠ 1`, with no hypothesis on `r` being
a non-proper power: this is the "easy" half of the Lyndon identity theorem (the *exactness* of the
equivariant cellular chain complex of a presentation 2-complex at its middle term, which holds for
any presentation, cf. `H₁` of a simply connected cover).  The non-trivial half is the vanishing of
`ker θ`, which is Lyndon's asphericity theorem.

The argument is entirely algebraic and elementary.  Write `K[F]` for the group algebra of the free
group and `p = presentAlg K r : K[F] →+* K[G]` for the presentation.  The kernel of `p` is the left
ideal generated by `{m - 1 : m ∈ N}`, `N = normalClosure {r}`
(`Work.ORFP2.mapDomainAlgHom_eq_zero_iff_mem_span`).  Given `(a_x) ∈ ker δ`, lift it to
`(b_x) ∈ K[F]^X` and put `D = Σ_x b_x (x - 1)`.  Then `p D = δ (a_x) = 0`, so `D` lies in that
kernel, i.e. `D = Σ_j c_j (m_j - 1)`; the Fox derivative of such an element is
`Σ_j c_j ∂m_j/∂x`, and since `m_j ∈ N`, `p(∂m_j/∂x)` is a multiple of the relator vector
(`Work.ORLyndon.foxD_multiple_of_mem_normalClosure`, the only delegated input).  Finally the Fox
derivative `D_x` of `D` recovers the lift: `b_x = D_x D`, so `a_x = p(b_x) = p(D_x D)` is a
multiple of `(∂r/∂x)` with a single coefficient, i.e. `(a_x) ∈ range θ`.

## Main results

* `Work.ORLyndon.lyndon_range_theta` — `range θ = ker δ` for every `r ≠ 1`.
-/

set_option autoImplicit false

namespace Work.ORLyndon

open MonoidAlgebra

section Lemmas

variable {X : Type*} [DecidableEq X] {K : Type*} [Field K]

section FoxLinear

/-- The `K`-linear extension of the Fox derivative `∂/∂x` to the whole group algebra `K[F(X)]`. -/
noncomputable def dFox (x : X) :
    MonoidAlgebra K (FreeGroup X) →ₗ[K] MonoidAlgebra K (FreeGroup X) :=
  (Finsupp.linearCombination K (fun g : FreeGroup X => foxD (K := K) x g)) ∘ₗ
    (MonoidAlgebra.coeffLinearEquiv K).toLinearMap

theorem dFox_of (x : X) (g : FreeGroup X) :
    dFox (K := K) x (MonoidAlgebra.of K (FreeGroup X) g) = foxD (K := K) x g := by
  simp only [dFox, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap,
    MonoidAlgebra.coeffLinearEquiv_apply, MonoidAlgebra.of_apply,
    MonoidAlgebra.coeff_single, Finsupp.linearCombination_single, one_smul]

@[simp] theorem dFox_one (x : X) :
    dFox (K := K) x (1 : MonoidAlgebra K (FreeGroup X)) = 0 := by
  rw [← map_one (MonoidAlgebra.of K (FreeGroup X)), dFox_of, foxD_one]

/-- The product rule for the linearised Fox derivative: `D_x` is a derivation for the bimodule
structure in which the right action of `K[F(X)]` on itself is twisted by the augmentation. -/
theorem dFox_mul (x : X) (c e : MonoidAlgebra K (FreeGroup X)) :
    dFox (K := K) x (c * e) =
      (augmentation K (FreeGroup X) e) • dFox (K := K) x c + c * dFox (K := K) x e := by
  have key : ∀ c e : MonoidAlgebra K (FreeGroup X),
      dFox (K := K) x (c * e) =
        (augmentation K (FreeGroup X) e) • dFox (K := K) x c + c * dFox (K := K) x e := by
    intro c
    induction c using MonoidAlgebra.induction_on with
    | of g =>
        intro e
        induction e using MonoidAlgebra.induction_on with
        | of h =>
            rw [← map_mul, dFox_of, dFox_of, dFox_of, augmentation_of, one_smul]
            exact foxD_mul (K := K) x g h
        | add e1 e2 h1 h2 =>
            rw [mul_add, map_add, h1, h2, augmentation_add, add_smul]
            rw [map_add, mul_add]
            abel
        | smul r e he =>
            rw [mul_smul_comm, map_smul, he]
            simp only [map_smul, smul_add]
            rw [smul_smul, ← mul_smul_comm, smul_eq_mul]
    | add c1 c2 h1 h2 =>
        intro e
        rw [add_mul, map_add, h1 e, h2 e, map_add, add_mul, smul_add]
        abel
    | smul r c hc =>
        intro e
        rw [smul_mul_assoc, map_smul, hc e]
        simp only [map_smul, smul_add]
        rw [smul_smul, mul_comm r (augmentation K (FreeGroup X) e), ← smul_smul,
          ← smul_mul_assoc]
  exact key c e

/-- The Fox derivative of `x_y - 1` is `δ_{xy}`. -/
theorem dFox_augGen (x y : X) :
    dFox (K := K) x ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of y) - 1) =
      if y = x then 1 else 0 := by
  rw [map_sub, dFox_of, dFox_one, sub_zero, foxD_of]

/-- The `x`-th Fox derivative of `c * (x_y - 1)` is `c` if `y = x` and `0` otherwise. -/
theorem dFox_mul_augGen (x y : X) (c : MonoidAlgebra K (FreeGroup X)) :
    dFox (K := K) x (c * ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of y) - 1)) =
      c * (if y = x then 1 else 0) := by
  rw [dFox_mul, dFox_augGen, map_sub, augmentation_of, augmentation_one, sub_self, zero_smul,
    zero_add]

/-- The relation between a finitely supported family `b` in `K[F(X)]` and its "boundary"
`D = Σ_x b_x (x - 1)`: the Fox derivative of `D` recovers `b`. -/
theorem dFox_sum_eq (b : X →₀ MonoidAlgebra K (FreeGroup X)) (x : X) :
    dFox (K := K) x (b.sum (fun y c => c * ((MonoidAlgebra.of K (FreeGroup X))
      (FreeGroup.of y) - 1))) = b x := by
  rw [map_finsuppSum]
  have h : (fun y c => dFox (K := K) x (c * ((MonoidAlgebra.of K (FreeGroup X))
        (FreeGroup.of y) - 1))) = (fun y c => c * (if y = x then 1 else 0)) := by
    funext y c
    exact dFox_mul_augGen x y c
  rw [h, Finsupp.sum_eq_single x (fun y _ hy => by rw [if_neg hy, mul_zero]) (fun _ => by simp)]
  simp

/-- The augmentation is trivial on the generators `x - 1`. -/
theorem augmentation_augGen (x : X) :
    augmentation K (FreeGroup X)
      ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of x) - 1) = 0 := by
  rw [map_sub, augmentation_of, augmentation_one, sub_self]

end FoxLinear

section PresentAlg

/-- The presentation `K[F(X)] →+* K[G]` as an algebra homomorphism. -/
noncomputable def presentAlgAlg (r : FreeGroup X) :
    MonoidAlgebra K (FreeGroup X) →ₐ[K] MonoidAlgebra K (OneRelatorGroup r) :=
  MonoidAlgebra.mapDomainAlgHom K K (presentRho r)

theorem presentAlgAlg_surjective (r : FreeGroup X) :
    Function.Surjective (presentAlgAlg (K := K) r) := by
  intro y
  induction y using MonoidAlgebra.induction_on with
  | of g =>
      obtain ⟨w, hw⟩ := PresentedGroup.mk_surjective ({r} : Set (FreeGroup X)) g
      refine ⟨MonoidAlgebra.of K (FreeGroup X) w, ?_⟩
      rw [presentAlgAlg, MonoidAlgebra.mapDomainAlgHom_apply, MonoidAlgebra.of_apply,
        MonoidAlgebra.mapDomain_single, ← MonoidAlgebra.of_apply, presentRho_apply]
      exact congrArg _ hw
  | add y1 y2 h1 h2 =>
      obtain ⟨w1, hw1⟩ := h1
      obtain ⟨w2, hw2⟩ := h2
      exact ⟨w1 + w2, by rw [map_add, hw1, hw2]⟩
  | smul c y1 h1 =>
      obtain ⟨w1, hw1⟩ := h1
      exact ⟨c • w1, by rw [map_smul, hw1]⟩

theorem presentAlg_surjective (r : FreeGroup X) :
    Function.Surjective (presentAlg K r) :=
  presentAlgAlg_surjective (K := K) r

/-- The "boundary" `D = Σ_x b_x (x - 1)` of a family `b`, whose `δ`-image is the image under the
presentation of `b`. -/
theorem lyndonDelta_mapRange_presentAlg (r : FreeGroup X)
    (b : X →₀ MonoidAlgebra K (FreeGroup X)) :
    lyndonDelta K r (b.mapRange (⇑(presentAlg K r)) (map_zero _)) =
      presentAlg K r (b.sum (fun x c => c * ((MonoidAlgebra.of K (FreeGroup X))
        (FreeGroup.of x) - 1))) := by
  rw [lyndonDelta_apply, map_finsuppSum, Finsupp.sum_mapRange_index (fun _ => by simp)]
  apply Finsupp.sum_congr
  intro x _
  rw [map_mul, map_sub, map_one]

/-- The element `m` of the kernel of `presentRho r` lies in the normal closure of `r`. -/
theorem mem_normalClosure_of_mem_ker (r : FreeGroup X)
    (m : MonoidHom.ker (presentRho r)) :
    (m : FreeGroup X) ∈ Subgroup.normalClosure ({r} : Set (FreeGroup X)) := by
  rw [← PresentedGroup.mk_eq_one_iff]
  exact m.2

/-- The left ideal `L = K[F(X)] · {m - 1 : m ∈ ker (presentRho r)}` is the kernel of the
presentation `K[F(X)] →+* K[G]`. -/
theorem mapDomain_eq_zero_iff_mem_ker_span (r : FreeGroup X)
    (D : MonoidAlgebra K (FreeGroup X)) :
    presentAlg K r D = 0 ↔
      D ∈ Submodule.span (MonoidAlgebra K (FreeGroup X))
        (Set.range fun m : MonoidHom.ker (presentRho r) =>
          MonoidAlgebra.single (m : FreeGroup X) 1 - 1) := by
  have h' : MonoidAlgebra.mapDomainAlgHom K K (presentRho r) D = 0 ↔ _ :=
    Work.ORFP2.mapDomainAlgHom_eq_zero_iff_mem_span K (presentRho r)
      (PresentedGroup.mk_surjective _) D
  exact h'

end PresentAlg

section Kernel

/-- The augmentation vanishes on `L`. -/
theorem augmentation_eq_zero_of_mem_span_ker (r : FreeGroup X)
    {z : MonoidAlgebra K (FreeGroup X)}
    (hz : z ∈ Submodule.span (MonoidAlgebra K (FreeGroup X))
        (Set.range fun m : MonoidHom.ker (presentRho r) =>
          MonoidAlgebra.single (m : FreeGroup X) 1 - 1)) :
    augmentation K (FreeGroup X) z = 0 := by
  induction hz using Submodule.span_induction with
  | mem w hw =>
      rcases hw with ⟨m, rfl⟩
      rw [map_sub, augmentation_single, augmentation_one, sub_self]
  | zero => exact augmentation_zero
  | add z1 z2 _ _ ih1 ih2 => rw [map_add, ih1, ih2, add_zero]
  | smul c z _ ih => rw [smul_eq_mul, map_mul, ih, mul_zero]

/-- **The key step.**  For every `D` in the kernel of the presentation, the family of Fox
derivatives `x ↦ p(∂D/∂x)` is a multiple of the relator vector with a *single* coefficient. -/
theorem exists_mul_relatorVec_of_mem_span_ker (r : FreeGroup X)
    {D : MonoidAlgebra K (FreeGroup X)}
    (hD : D ∈ Submodule.span (MonoidAlgebra K (FreeGroup X))
        (Set.range fun m : MonoidHom.ker (presentRho r) =>
          MonoidAlgebra.single (m : FreeGroup X) 1 - 1)) :
    ∃ α : MonoidAlgebra K (OneRelatorGroup r),
      ∀ x : X, presentAlg K r (dFox (K := K) x D) = α * relatorVec K r x := by
  induction hD using Submodule.span_induction with
  | mem w hw =>
      rcases hw with ⟨m, rfl⟩
      obtain ⟨β, hβ⟩ := foxD_multiple_of_mem_normalClosure (K := K) r (mem_normalClosure_of_mem_ker r m)
      refine ⟨β, fun x => ?_⟩
      show presentAlg K r (dFox (K := K) x
        (MonoidAlgebra.single (m : FreeGroup X) 1 - 1)) = β * relatorVec K r x
      rw [← MonoidAlgebra.of_apply, map_sub, dFox_of, dFox_one, sub_zero]
      exact hβ x
  | zero => exact ⟨0, fun x => by simp⟩
  | add z1 z2 _ _ ih1 ih2 =>
      obtain ⟨α1, h1⟩ := ih1
      obtain ⟨α2, h2⟩ := ih2
      exact ⟨α1 + α2, fun x => by rw [map_add, map_add, h1 x, h2 x, add_mul]⟩
  | smul c z hz ih =>
      obtain ⟨α, h⟩ := ih
      have hz0 : augmentation K (FreeGroup X) z = 0 := augmentation_eq_zero_of_mem_span_ker r hz
      refine ⟨presentAlg K r c * α, fun x => ?_⟩
      rw [smul_eq_mul, dFox_mul, hz0, zero_smul, zero_add, map_mul, h x, mul_assoc]

end Kernel

end Lemmas

theorem lyndon_range_theta {X : Type*} [DecidableEq X] {K : Type*} [Field K]
    (r : FreeGroup X) (hr : r ≠ 1) :
    LinearMap.range (Work.ORLyndon.lyndonTheta K r) =
      LinearMap.ker (Work.ORLyndon.lyndonDelta K r) := by
  apply le_antisymm
  · -- `range θ ≤ ker δ`: `δ ∘ θ = 0`.
    intro a ha
    obtain ⟨b, rfl⟩ := LinearMap.mem_range.mp ha
    rw [LinearMap.mem_ker]
    have h := LinearMap.congr_fun (lyndonDelta_comp_lyndonTheta (K := K) r) b
    rw [LinearMap.comp_apply, LinearMap.zero_apply] at h
    exact h
  · -- `ker δ ≤ range θ`.
    intro a ha
    rw [LinearMap.mem_ker] at ha
    rw [LinearMap.mem_range]
    -- lift `a` to `b : X →₀ K[F(X)]`
    obtain ⟨b, hb⟩ := Finsupp.mapRange_surjective (⇑(presentAlg K r)) (map_zero _)
      (presentAlg_surjective (K := K) r) a
    -- `D` is the "boundary" of `b`; it lies in the kernel of the presentation
    set D : MonoidAlgebra K (FreeGroup X) :=
      b.sum (fun x c => c * ((MonoidAlgebra.of K (FreeGroup X)) (FreeGroup.of x) - 1)) with hD
    have hDker : presentAlg K r D = 0 := by
      rw [hD, ← lyndonDelta_mapRange_presentAlg, hb]
      exact ha
    obtain ⟨α, hα⟩ := exists_mul_relatorVec_of_mem_span_ker r
      ((mapDomain_eq_zero_iff_mem_ker_span r D).mp hDker)
    refine ⟨α, ?_⟩
    ext x
    have hbx : b x = dFox (K := K) x D := by
      rw [hD, ← dFox_sum_eq (K := K) b x]
    rw [lyndonTheta_apply, Finsupp.smul_apply, smul_eq_mul, ← hb, Finsupp.mapRange_apply,
      hbx, hα x]

end Work.ORLyndon
