import Mathlib
import Submission.Work.ORLyndon.annAtOfSubgroup
import Submission.Work.ORLyndon.fgdMain
import Submission.Work.OROneRel.FreiheitssatzUnconditional

/-!
# `annAt` for a component of the root Fox vector supported in a Magnus subgroup

Let `G = ⟨α | r⟩` be a one-relator group with `r` cyclically reduced, `u` a root of the relator and
`β_x = rootVec K r u x ∈ K[G]` the `x`-component of the Fox vector of the root.

The general subgroup reduction (`Work.ORLyndon.annAt_of_support_subgroup_noZeroDivisors`) turns the
regularity of `β_x` into the statement that the group algebra of a subgroup `N` supporting `β_x`
has no zero divisors.  This file supplies the case in which that subgroup is a **Magnus subgroup**:
if the support of `β_x` lies in the subgroup of `G` generated by all the generators other than a
letter `y` of the relator, then `β_x` is a right non-zero-divisor of `K[G]`.

Indeed, `y` occurring in `r` means that `r` is not in the subgroup of `F(α)` generated by the
remaining generators, so by the Freiheitssatz
(`Work.OROneRel.magnusSubgroupOf_equiv_freeGroup_of_isCyclicallyReduced`) the Magnus subgroup at `y`
is **free**, isomorphic to `F(α \ {y})`.  The group algebra of a free group over a field has no zero
divisors (`Work.ORLyndon.uniqueProds_freeGroup`: free groups have the unique product property, so
`MonoidAlgebra.instNoZeroDivisors` applies), and that property transports back across the group
isomorphism.  The result then follows from the subgroup reduction.

## Main result

* `Work.ORLyndon.annAt_of_support_le_magnusSubgroup`
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ORLyndon

open MonoidAlgebra

universe u v

/-- **`annAt` from a Magnus subgroup.**  Let `r` be a cyclically reduced relator, `y` a letter
occurring in `r`, and let the `x`-component `β_x` of the root Fox vector be non-zero and supported
in the Magnus subgroup `⟨α \ {y}⟩ ≤ ⟨α | r⟩`.  Then `β_x` is a right non-zero-divisor of
`K[⟨α | r⟩]`: the annihilator of `β_x` is trivial. -/
theorem annAt_of_support_le_magnusSubgroup {α : Type u} [DecidableEq α] {K : Type v} [Field K]
    {r u : FreeGroup α} {x y : α} (hcyc : Work.OROneRel.IsCyclicallyReducedRelator r)
    (hy : y ∈ Work.OROneRel.relatorLetters r)
    (hsupp : ↑(rootVec K r u x).coeff.support ⊆
      (Work.OROneRel.magnusSubgroup r y : Set (OneRelatorGroup r)))
    (hne : rootVec K r u x ≠ 0) : annAt K r u {x} := by
  classical
  -- The relator involves the letter `y`, so it does not lie in the subgroup generated by the
  -- remaining letters.
  have hT : r ∉ Subgroup.closure (FreeGroup.of '' {a : α | a ≠ y}) := by
    intro hmem
    exact ((Work.OROneRel.letters_closure_iff r {a : α | a ≠ y}).mp hmem hy) rfl
  -- Hence, by the Freiheitssatz, the Magnus subgroup at `y` is free on the remaining generators.
  obtain ⟨e⟩ :=
    Work.OROneRel.magnusSubgroupOf_equiv_freeGroup_of_isCyclicallyReduced r hcyc hT
  -- A free group has the unique product property, so its group algebra over a field has no zero
  -- divisors; this property transports back along the induced isomorphism of group algebras.
  have hdom : NoZeroDivisors
      (MonoidAlgebra K ↥(Work.OROneRel.magnusSubgroupOf r {a : α | a ≠ y})) := by
    have h : NoZeroDivisors (MonoidAlgebra K (FreeGroup {a : α // a ≠ y})) := inferInstance
    refine ⟨fun {a b} hab => ?_⟩
    have h0 : MonoidAlgebra.mapDomainRingEquiv K e a *
        MonoidAlgebra.mapDomainRingEquiv K e b = 0 := by
      rw [← map_mul, hab, map_zero]
    rcases mul_eq_zero.mp h0 with h1 | h1
    · exact Or.inl ((MonoidAlgebra.mapDomainRingEquiv K e).injective (by rw [h1, map_zero]))
    · exact Or.inr ((MonoidAlgebra.mapDomainRingEquiv K e).injective (by rw [h1, map_zero]))
  -- The Magnus subgroup at `y` is by definition the Magnus subgroup on the other generators.
  exact annAt_of_support_subgroup_noZeroDivisors
    (Work.OROneRel.magnusSubgroupOf r {a : α | a ≠ y}) hdom
    (by simpa only [Work.OROneRel.magnusSubgroup] using hsupp) hne

end Work.ORLyndon
