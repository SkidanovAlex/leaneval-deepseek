/-
# The two-occurrence decomposition of a word

Let `u : F(α)` be a word whose reduced form contains the letter `x` exactly twice, and suppose that
the exponent sum `eps x u` of `x` in `u` is non-zero.  Then the two occurrences of `x` carry the
*same* sign, and `u` splits as

  `u = P · xᵇ · A · xᵇ · B`,  `P, A, B ∈ F(α ∖ {x})`,

i.e. `u = magIncl x P * xbOf x b * magIncl x A * xbOf x b * magIncl x B`: the decomposition shape
consumed by the two-occurrence analysis of the root Fox vector
(`Work.ORLyndon.rootVec_eq_of_twoOcc`, `Work.ORLyndon.orderOf_presentRho_twoOcc`,
`Work.ORLyndon.annAt_of_twoOcc`).

The two counting hypotheses alone give a decomposition with the two occurrences `x^{b₁}`, `x^{b₂}`
possibly of *different* signs (`Work.ORLyndon.exists_split_two_count`).  It is the exponent-sum
hypothesis that pins the signs down: if the two occurrences had opposite signs, the exponent sum of
`x`, which is the sum of the contributions of the two occurrences
(`Work.ORLyndon.wordEps_split_two`, the intermediate blocks contributing `0`), would vanish.

## Proof

Write `W = wordOf u` for the reduced word of `u` (so that `mk W = u`).  The first two hypotheses
split `W` around its two `x`-letters, giving `b₁`, `b₂` and blocks `L₁`, `L₂`, `L₃` free of `x`.
The exponent sum of `x` in `W` is the sum `(if b₁ then 1 else -1) + (if b₂ then 1 else -1)` of the
contributions of the two occurrences, so `eps x u ≠ 0` forces `b₁ = b₂ =: b`.  A word whose letters
are all different from `x` is in the image of the Magnus inclusion
`magIncl x : F(α ∖ {x}) →* F(α)` (`Work.ORLyndon.magIncl_exists_eq_mk`), which produces `P`, `A`,
`B`; converting `mk` of the concatenated word into a product (`FreeGroup.mul_mk`) and the single
letters into `xbOf x b` (`Work.ORLyndon.xbOf_eq_mk`) gives the stated factorisation.
-/
import Mathlib
import Submission.Work.ORLyndon.twoOccBase
import Submission.Work.OROneRel.MagnusRewrite
import Submission.Work.OROneRel.wordOfDefs
import Submission.Work.ORLyndon.exists_split_two_count
import Submission.Work.ORLyndon.wordEps_split_two

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ORLyndon

variable {α : Type*}

/-! ## Lifting a word in the other generators to the Magnus subgroup -/

/-- Every word in the generators different from `x` is the image under the Magnus inclusion
`magIncl x : F(α ∖ {x}) →* F(α)` of a word in the other generators.  (The subgroup of `F(α)`
generated by `{of z // z ≠ x}` is the range of `magIncl x`.) -/
lemma magIncl_exists_eq_mk [DecidableEq α] (x : α) (L : List (α × Bool))
    (hL : ∀ p ∈ L, p.1 ≠ x) :
    ∃ P : FreeGroup {z : α // z ≠ x}, magIncl x P = FreeGroup.mk L := by
  induction L with
  | nil => exact ⟨1, by rw [map_one, FreeGroup.one_eq_mk]⟩
  | cons p L ih =>
    obtain ⟨a, b⟩ := p
    have hp : a ≠ x := hL (a, b) (List.mem_cons_self ..)
    obtain ⟨Q, hQ⟩ := ih (fun q hq => hL q (List.mem_cons_of_mem _ hq))
    refine ⟨FreeGroup.mk [(⟨a, hp⟩, b)] * Q, ?_⟩
    rw [map_mul, hQ]
    have hsingle : magIncl x (FreeGroup.mk [(⟨a, hp⟩, b)]) = FreeGroup.mk [(a, b)] := by
      cases b
      · change magIncl x ((FreeGroup.of ⟨a, hp⟩)⁻¹) = FreeGroup.mk [(a, false)]
        rw [map_inv, magIncl, FreeGroup.lift_apply_of]
        rw [show FreeGroup.of a = FreeGroup.mk [(a, true)] from rfl, FreeGroup.inv_mk]
        rfl
      · change magIncl x (FreeGroup.of ⟨a, hp⟩) = FreeGroup.mk [(a, true)]
        rw [magIncl, FreeGroup.lift_apply_of]
        rfl
    rw [hsingle, FreeGroup.mul_mk, List.singleton_append]

/-! ## The single letters -/

/-- The letter `xᵇ` (`b = true`, resp. `b = false`) is the class of the one-letter word
`[(x, b)]`. -/
lemma xbOf_eq_mk (x : α) (b : Bool) : xbOf x b = FreeGroup.mk [(x, b)] := by
  cases b
  · show (FreeGroup.mk [(x, true)])⁻¹ = FreeGroup.mk [(x, false)]
    rw [FreeGroup.inv_mk]
    rfl
  · rfl

/-- A cons is a product: `mk (p :: L) = mk [p] * mk L`. -/
lemma mk_cons_singleton (p : α × Bool) (L : List (α × Bool)) :
    FreeGroup.mk (p :: L) = FreeGroup.mk [p] * FreeGroup.mk L := by
  rw [FreeGroup.mul_mk, List.singleton_append]

/-! ## The decomposition -/

/-- **The two-occurrence decomposition.**  If the letter `x` occurs exactly twice (with either
sign) in the reduced word of `u`, and if the exponent sum of `x` in `u` is non-zero — so that the two
occurrences have the same sign — then `u = P · xᵇ · A · xᵇ · B` with `P, A, B` words in the other
generators. -/
theorem exists_twoOcc_decomp {α : Type*} [DecidableEq α] {u : FreeGroup α} {x : α}
    (hx : x ∈ Work.OROneRel.relatorLetters u)
    (h2 : (Work.OROneRel.wordOf u).count (x, true) + (Work.OROneRel.wordOf u).count (x, false) = 2)
    (heps : Work.OROneRel.eps x u ≠ 0) :
    ∃ (b : Bool) (P A B : FreeGroup {z : α // z ≠ x}),
      u = Work.ORLyndon.magIncl x P * Work.ORLyndon.xbOf x b * Work.ORLyndon.magIncl x A *
        Work.ORLyndon.xbOf x b * Work.ORLyndon.magIncl x B := by
  -- split the reduced word of `u` around its two occurrences of `x`
  obtain ⟨b₁, b₂, L₁, L₂, L₃, hsplit, hL₁, hL₂, hL₃⟩ :=
    Work.ORLyndon.exists_split_two_count (x := x) (L := Work.OROneRel.wordOf u) h2
  -- the exponent sum of `x` is the sum of the contributions of the two occurrences
  have hepsW : Work.OROneRel.wordEps x (Work.OROneRel.wordOf u) ≠ 0 := by
    simpa [Work.OROneRel.eps, Work.OROneRel.wordOf] using heps
  -- hence the two occurrences have the same sign
  have hb : b₁ = b₂ := by
    by_contra hne
    apply hepsW
    rw [hsplit, Work.ORLyndon.wordEps_split_two hL₁ hL₂ hL₃]
    cases b₁ <;> cases b₂ <;> simp_all
  subst hb
  -- lift the three blocks to the Magnus subgroup
  obtain ⟨P, hP⟩ := Work.ORLyndon.magIncl_exists_eq_mk x L₁ hL₁
  obtain ⟨A, hA⟩ := Work.ORLyndon.magIncl_exists_eq_mk x L₂ hL₂
  obtain ⟨B, hB⟩ := Work.ORLyndon.magIncl_exists_eq_mk x L₃ hL₃
  refine ⟨b₁, P, A, B, ?_⟩
  rw [← Work.OROneRel.mk_wordOf u, hsplit]
  rw [← FreeGroup.mul_mk, mk_cons_singleton, ← FreeGroup.mul_mk, mk_cons_singleton]
  rw [hP, hA, hB, xbOf_eq_mk]
  group

end Work.ORLyndon
