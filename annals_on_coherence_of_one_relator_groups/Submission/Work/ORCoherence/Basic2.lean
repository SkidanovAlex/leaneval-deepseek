import Submission.Work.ORCoherence.Imports
import Submission.Work.ORCoherence.Tensor.balanced_span_tmul_one_eq_top
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

set_option autoImplicit false
set_option maxHeartbeats 800000

open CategoryTheory Limits
open scoped TensorProduct

namespace Work.ORCoherence

universe u

/-- If `S ⊗[R] M` is finitely generated as an `S`-module then it is generated by
finitely many elements of the form `1 ⊗ m`. -/
theorem exists_finset_span_tmul_one {R S : Type u} [Ring R] [Ring S] (f : R →+* S)
    (M : Type u) [AddCommGroup M] [Module R M] (h : Module.Finite S (Balanced f M)) :
    ∃ T : Finset M, Submodule.span S (Balanced.tmul f 1 '' (T : Set M)) = ⊤ := by
  classical
  obtain ⟨G, hGfin, hG⟩ := Submodule.fg_def.mp (Module.Finite.fg_top (R := S) (M := Balanced f M))
  have key : ∀ g ∈ G, ∃ t : Finset M, g ∈ Submodule.span S (Balanced.tmul f 1 '' (t : Set M)) := by
    intro g _
    have hg' : g ∈ Submodule.span S (Set.range fun m : M => Balanced.tmul f 1 m) := by
      rw [Tensor.balanced_span_tmul_one_eq_top]; exact Submodule.mem_top
    obtain ⟨c, hc, hcsum⟩ := Submodule.mem_span_set.mp hg'
    have hpick : ∀ i ∈ c.support, ∃ m : M, Balanced.tmul f 1 m = i := fun i hi => hc hi
    let p : Balanced f M → M := fun i => if hi : i ∈ c.support then (hpick i hi).choose else 0
    have hp : ∀ i ∈ c.support, Balanced.tmul f 1 (p i) = i := by
      intro i hi
      simp only [p, dif_pos hi]
      exact (hpick i hi).choose_spec
    refine ⟨c.support.image p, ?_⟩
    rw [← hcsum, Finsupp.sum]
    refine Submodule.sum_mem _ ?_
    intro i hi
    have hmem : p i ∈ c.support.image p := Finset.mem_image.mpr ⟨i, hi, rfl⟩
    have hti : i = Balanced.tmul f 1 (p i) := (hp i hi).symm
    rw [hti]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_image_of_mem _ hmem))
  have key2 : ∀ g : Balanced f M, ∃ t : Finset M,
      g ∈ G → g ∈ Submodule.span S (Balanced.tmul f 1 '' (t : Set M)) := by
    intro g
    by_cases hg : g ∈ G
    · obtain ⟨t, ht⟩ := key g hg
      exact ⟨t, fun _ => ht⟩
    · exact ⟨∅, fun h => absurd h hg⟩
  choose t ht using key2
  refine ⟨hGfin.toFinset.biUnion t, ?_⟩
  rw [eq_top_iff, ← hG]
  refine Submodule.span_le.mpr ?_
  intro g hg
  refine Submodule.span_mono ?_ (ht g hg)
  rintro m ⟨a, ha, rfl⟩
  exact Set.mem_image_of_mem _ (Finset.mem_biUnion.mpr ⟨g, (hGfin.mem_toFinset).mpr hg, ha⟩)

end Work.ORCoherence
