import Mathlib
import Submission.Work.ORBassSerre.Action.Structure.BSPresentation

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.ORBassSerre.Action.Structure

open Quiver

/-!
# Surjectivity of the canonical map `Φ : Γ →* G`

Given a cocompact action of a group `G` on a tree `V` without inversions, the Bass--Serre
structure theorem says that `G` is generated by the vertex stabilisers of the chosen
representatives of the vertex orbits together with the "stable letters" of the edge orbits.
This is precisely the statement that the canonical map `Φ` from the presentation `Gamma` of
the fundamental domain to `G` -- which is the identity on each vertex group and sends the
stable letter of an edge orbit to its stable letter in `G` -- is surjective.

The generation statement is proved in `closure_lifts_top_aux` below in the general form
"for any choice of a lift `rep` of the vertex orbits, any family of lifts `L` of the edge
orbits with sources at the lifted vertices, and any compatible stable letters `elt`, the
vertex stabilisers of the lifts together with the `elt` generate `G`".  This is the usual
path argument on the tree: the set of vertices reachable from the lift of their own orbit
by an element of the subgroup generated by these elements is closed under passing along an
arrow (because the lift of the orbit of that arrow differs from it by an element fixing the
source vertex of the lift), hence is all of `V` by connectivity.
-/

/-- **The Bass--Serre generation statement.**  Let `G` act on a tree `V`.  Choose a lift `rep A`
of every vertex orbit `A`, and for every edge orbit `E` a lift `L E` of `E` whose source is the
lifted vertex of the source orbit of `E`, together with an element `elt E` carrying the lifted
vertex of the target orbit of `E` to the target of `L E`.  Then `G` is generated by the
stabilisers of the lifted vertices and the family `elt`. -/
theorem closure_lifts_top_aux {G : Type*} {V : Type*} [Group G] [Quiver V]
    [Quiver.HasInvolutiveReverse V] [MulAction G V] [Work.ORBassSerre.GraphAction G V]
    [Nonempty V] (hT : Work.ORBassSerre.IsTree V)
    (rep : Work.ORBassSerre.orbitV G V → V)
    (hrep : ∀ A, Quotient.mk'' (rep A) = A)
    (elt : Work.ORBassSerre.orbitE G V → G)
    (L : Work.ORBassSerre.orbitE G V → Quiver.Total V)
    (hLorbit : ∀ E, Quotient.mk'' (L E) = E)
    (hLleft : ∀ E, (L E).left = rep (Work.ORBassSerre.Action.srcE (G := G) (V := V) E))
    (hLright : ∀ E, (L E).right = elt E • rep (Work.ORBassSerre.Action.tgtE (G := G) (V := V) E)) :
    Subgroup.closure ((⋃ A, (MulAction.stabilizer G (rep A) : Set G)) ∪ Set.range elt) = ⊤ := by
  classical
  set H : Subgroup G :=
    Subgroup.closure ((⋃ A, (MulAction.stabilizer G (rep A) : Set G)) ∪ Set.range elt) with hH
  -- the stabiliser of every lifted vertex is in `H`
  have hstab_le : ∀ A : Work.ORBassSerre.orbitV G V, MulAction.stabilizer G (rep A) ≤ H := by
    intro A
    rw [hH]
    intro g hg
    exact Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_iUnion.mpr ⟨A, hg⟩))
  -- every stable letter is in `H`
  have helt_mem : ∀ E : Work.ORBassSerre.orbitE G V, elt E ∈ H := by
    intro E
    rw [hH]
    exact Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self E))
  -- every vertex is the translate of the lift of its own orbit by an element of `H`
  have hmain : ∀ v : V, ∃ h : G, h ∈ H ∧ h • rep (Quotient.mk'' v) = v := by
    set W : Set V := {v : V | ∃ h : G, h ∈ H ∧ h • rep (Quotient.mk'' v) = v} with hW
    have hWclosed : ∀ ⦃a b : V⦄, a ∈ W → (a ⟶ b) → b ∈ W := by
      intro a b ha f
      obtain ⟨h, hhH, hha⟩ := ha
      let u : Quiver.Total V := Quiver.Total.mk a b f
      let E : Work.ORBassSerre.orbitE G V := Quotient.mk'' u
      let F : Quiver.Total V := h⁻¹ • u
      have hFmk : (Quotient.mk'' F : Work.ORBassSerre.orbitE G V) = E := by
        show (Quotient.mk'' (h⁻¹ • u) : Work.ORBassSerre.orbitE G V) = Quotient.mk'' u
        exact Quotient.sound ⟨h⁻¹, rfl⟩
      have hFleft : F.left = rep (Quotient.mk'' a) := by
        show (h⁻¹ • u).left = rep (Quotient.mk'' a)
        rw [Work.ORBassSerre.Action.smul_left_total]
        rw [show u.left = a from rfl]
        conv_lhs => rw [← hha]
        exact inv_smul_smul h (rep (Quotient.mk'' a))
      have hsrcE : Work.ORBassSerre.Action.srcE (G := G) (V := V) E = Quotient.mk'' a := by
        have h1 : Work.ORBassSerre.Action.srcE (G := G) (V := V) E =
            (Quotient.mk'' (L E).left : Work.ORBassSerre.orbitV G V) := by
          rw [hLleft E, hrep]
        rw [h1, Work.ORBassSerre.Action.mk_left_eq_of_mk_eq (G := G) (V := V)
          (u := L E) (w := u) (hLorbit E)]
      have htgtE : Work.ORBassSerre.Action.tgtE (G := G) (V := V) E = Quotient.mk'' b := by
        have h1 : Work.ORBassSerre.Action.tgtE (G := G) (V := V) E =
            (Quotient.mk'' (L E).right : Work.ORBassSerre.orbitV G V) := by
          have hEq : (Quotient.mk''
              (elt E • rep (Work.ORBassSerre.Action.tgtE (G := G) (V := V) E)) :
              Work.ORBassSerre.orbitV G V) =
              Quotient.mk'' (rep (Work.ORBassSerre.Action.tgtE (G := G) (V := V) E)) :=
            Quotient.sound ⟨elt E, rfl⟩
          rw [hLright E, hEq, hrep (Work.ORBassSerre.Action.tgtE (G := G) (V := V) E)]
        rw [h1, Work.ORBassSerre.Action.mk_right_eq_of_mk_eq (G := G) (V := V)
          (u := L E) (w := u) (hLorbit E)]
      obtain ⟨g, hg⟩ := Work.ORBassSerre.Action.exists_smulTotal_of_mk_eq (G := G) (V := V)
        (u := L E) (w := F) ((hLorbit E).trans hFmk.symm)
      have hfix : g ∈ MulAction.stabilizer G
          (rep (Work.ORBassSerre.Action.srcE (G := G) (V := V) E)) := by
        rw [MulAction.mem_stabilizer_iff]
        calc g • rep (Work.ORBassSerre.Action.srcE (G := G) (V := V) E)
            = g • (L E).left := by rw [hLleft E]
          _ = (g • (L E)).left := (Work.ORBassSerre.Action.smul_left_total g (L E)).symm
          _ = F.left := by rw [hg]
          _ = rep (Quotient.mk'' a) := hFleft
          _ = rep (Work.ORBassSerre.Action.srcE (G := G) (V := V) E) := by rw [hsrcE]
      have hgH : g ∈ H := hstab_le _ hfix
      refine ⟨h * g * elt E, H.mul_mem (H.mul_mem hhH hgH) (helt_mem E), ?_⟩
      have hu_eq : u = (h * g) • (L E) := by
        calc u = h • (h⁻¹ • u) := (smul_inv_smul h u).symm
          _ = h • (g • (L E)) := by rw [show h⁻¹ • u = F from rfl, hg]
          _ = (h * g) • (L E) := by rw [mul_smul]
      refine (calc b = u.right := rfl
        _ = ((h * g) • (L E)).right := by rw [hu_eq]
        _ = (h * g) • (L E).right :=
            Work.ORBassSerre.Action.smul_right_total (h * g) (L E)
        _ = (h * g) • (elt E • rep (Work.ORBassSerre.Action.tgtE (G := G) (V := V) E)) := by
            rw [hLright E]
        _ = (h * g * elt E) • rep (Work.ORBassSerre.Action.tgtE (G := G) (V := V) E) := by
            rw [← mul_smul]
        _ = (h * g * elt E) • rep (Quotient.mk'' b) := by rw [htgtE]).symm
    have hWpath : ∀ {a b : V}, a ∈ W → Quiver.Path a b → b ∈ W := by
      intro a b ha p
      induction p with
      | nil => exact ha
      | cons p e ih => exact hWclosed ih e
    intro v
    have hbase : rep (Quotient.mk'' v) ∈ W := by
      refine ⟨1, H.one_mem, ?_⟩
      show (1 : G) • rep (Quotient.mk'' (rep (Quotient.mk'' v))) = rep (Quotient.mk'' v)
      rw [one_smul, hrep (Quotient.mk'' v)]
    obtain ⟨p⟩ := hT.1 (rep (Quotient.mk'' v)) v
    exact hWpath hbase p
  have hHtop : H = ⊤ := by
    refine le_antisymm le_top ?_
    intro g _
    let v₀ : V := Classical.arbitrary V
    let A₀ : Work.ORBassSerre.orbitV G V := Quotient.mk'' v₀
    obtain ⟨h, hhH, hh⟩ := hmain (g • rep A₀)
    have hs1 : (Quotient.mk'' (g • rep A₀) : Work.ORBassSerre.orbitV G V) =
        (Quotient.mk'' (rep A₀) : Work.ORBassSerre.orbitV G V) := Quotient.sound ⟨g, rfl⟩
    have hs : (Quotient.mk'' (g • rep A₀) : Work.ORBassSerre.orbitV G V) = A₀ :=
      hs1.trans (hrep A₀)
    rw [hs] at hh
    have hgmem : h⁻¹ * g ∈ H := hstab_le A₀ (by
      rw [MulAction.mem_stabilizer_iff, mul_smul, ← hh, inv_smul_smul])
    have hmul : h * (h⁻¹ * g) ∈ H := H.mul_mem hhH hgmem
    rwa [mul_inv_cancel_left] at hmul
  exact hHtop

/-- The generating family of the presentation `Gamma` -- the vertex group generators and the
stable letters -- already lies in the range of the canonical map `Φ`. -/
theorem generatingSet_subset_range {G : Type*} {V : Type*} [Group G] [Quiver V]
    [Quiver.HasInvolutiveReverse V] [MulAction G V] [Work.ORBassSerre.GraphAction G V]
    (d : Work.ORBassSerre.Action.Structure.TreeDatum G V)
    (D : d.PresData) [Fintype (Work.ORBassSerre.orbitV G V)]
    [Fintype (Work.ORBassSerre.orbitE G V)] :
    ((⋃ A : Work.ORBassSerre.orbitV G V, (MulAction.stabilizer G (d.vert A) : Set G)) ∪
        Set.range d.sElt) ⊆ (d.Φ D).range := by
  classical
  intro g hg
  rcases hg with hg | ⟨E, hE⟩
  · rw [Set.mem_iUnion] at hg
    obtain ⟨A, hgA⟩ := hg
    exact ⟨d.gEltHom D A ⟨g, hgA⟩, d.Φ_gEltHom D A ⟨g, hgA⟩⟩
  · rw [← hE]
    by_cases h : d.IsTreeEdge E
    · rw [d.sElt_eq_one h]
      exact ⟨1, map_one _⟩
    · exact ⟨PresentedGroup.of (Sum.inr ⟨E, h⟩), d.Φ_of_inr D E h⟩

theorem Phi_surjective {G : Type*} {V : Type*} [Group G] [Quiver V]
    [Quiver.HasInvolutiveReverse V] [MulAction G V] [Work.ORBassSerre.GraphAction G V]
    (hT : Work.ORBassSerre.IsTree V)
    (d : Work.ORBassSerre.Action.Structure.TreeDatum G V)
    (D : d.PresData) [Fintype (Work.ORBassSerre.orbitV G V)]
    [Fintype (Work.ORBassSerre.orbitE G V)] :
    Function.Surjective (d.Φ D) := by
  classical
  haveI : Nonempty V := ⟨d.vert d.root⟩
  have htop : Subgroup.closure ((⋃ A : Work.ORBassSerre.orbitV G V,
      (MulAction.stabilizer G (d.vert A) : Set G)) ∪ Set.range d.sElt) = ⊤ :=
    closure_lifts_top_aux hT d.vert d.vert_mk d.sElt d.elift d.elift_orbit d.elift_left d.elift_right
  have hle : Subgroup.closure ((⋃ A : Work.ORBassSerre.orbitV G V,
      (MulAction.stabilizer G (d.vert A) : Set G)) ∪ Set.range d.sElt) ≤ (d.Φ D).range :=
    (Subgroup.closure_le _).mpr (generatingSet_subset_range d D)
  rw [htop] at hle
  exact MonoidHom.range_eq_top.mp (le_antisymm le_top hle)

end Work.ORBassSerre.Action.Structure
