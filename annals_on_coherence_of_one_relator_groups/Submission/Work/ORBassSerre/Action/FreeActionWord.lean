# The oriented half-edge word of a path in a `G`-graph

For a group `G` acting on a graph `V` (a quiver with involutive reversal), form the set
`HalfEdge` of *half-edges* of the quotient graph `V/G`: the quotient of `Quiver.Total V` by the
equivalence relation generated by the `G`-action and by reversal.  Every arrow of `V` determines
a half-edge together with an "orientation" bit, and hence every path determines a word in the
free group on the half-edges (`pathWord`, `pathWordFree`).

If the action of `G` on `V` is free and without inversions, then the word of a *reduced* path is
a reduced word, so the word of the geodesic from a base vertex to its translate by `g` is a
non-trivial word unless `g = 1`.  This is the mechanism behind
`isFreeGroup_of_actsFreely_on_tree`.
-/
import Mathlib
import Submission.Work.ORBassSerre.Action.Basic
import Submission.Work.ORBassSerre.Action.Cocompact
import Submission.Work.ORBassSerre.Action.Quotient
import Submission.Work.ORBassSerre.Action.Quotient.qpath_exists_lift
import Submission.Work.ORBassSerre.Tree.IsTreeAPI

set_option autoImplicit false
set_option linter.unusedSectionVars false

universe u v

namespace Work.ORBassSerre.Action

open Quiver

variable {G : Type u} {V : Type v} [Group G] [Quiver V] [Quiver.HasInvolutiveReverse V]
  [MulAction G V] [GraphAction G V]

/-- Two oriented edges of a `G`-graph are equivalent if they differ by the group action or by
reversal.  The classes are the *half-edges* of the quotient graph `V/G`. -/
def edgeSetoid : Setoid (Quiver.Total V) where
  r u w := (∃ g : G, w = g • u) ∨ (∃ g : G, w = g • u.reverse)
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro u
      exact Or.inl ⟨1, (one_smul G u).symm⟩
    · intro u w h
      rcases h with ⟨g, hg⟩ | ⟨g, hg⟩
      · refine Or.inl ⟨g⁻¹, ?_⟩
        rw [hg]
        simp
      · refine Or.inr ⟨g⁻¹, ?_⟩
        rw [hg, ← GraphAction.smul_reverse_apply, Quiver.Total.reverse_reverse]
        simp
    · intro a b c hab hbc
      rcases hab with ⟨g, hg⟩ | ⟨g, hg⟩ <;> rcases hbc with ⟨h, hh⟩ | ⟨h, hh⟩
      · exact Or.inl ⟨h * g, by rw [hh, hg, smul_smul]⟩
      · refine Or.inr ⟨h * g, ?_⟩
        rw [hh, hg, ← GraphAction.smul_reverse_apply, smul_smul]
      · refine Or.inr ⟨h * g, ?_⟩
        rw [hh, hg, smul_smul]
      · refine Or.inl ⟨h * g, ?_⟩
        rw [hh, hg, ← GraphAction.smul_reverse_apply, Quiver.Total.reverse_reverse, smul_smul]

/-- The type of half-edges of the quotient graph `V/G`. -/
abbrev HalfEdge : Type _ := Quotient (edgeSetoid (G := G) (V := V))

/-- The half-edge of an oriented edge. -/
def halfEdge (u : Quiver.Total V) : HalfEdge (G := G) (V := V) := Quotient.mk'' u

@[simp] theorem halfEdge_smul (g : G) (u : Quiver.Total V) :
    halfEdge (G := G) (V := V) (g • u) = halfEdge u :=
  Quotient.sound (Or.inl ⟨g⁻¹, by simp⟩)

@[simp] theorem halfEdge_reverse (u : Quiver.Total V) :
    halfEdge (G := G) (V := V) u.reverse = halfEdge u := by
  refine Quotient.sound (Or.inr ⟨1, ?_⟩)
  simp

theorem halfEdge_eq_iff {u w : Quiver.Total V} :
    halfEdge (G := G) (V := V) u = halfEdge w ↔
      (∃ g : G, w = g • u) ∨ (∃ g : G, w = g • u.reverse) :=
  Quotient.eq''

/-- No group element carries an oriented edge to the reverse of another translate of it, because
the action is without inversions. -/
theorem not_smul_eq_smul_reverse (hninv : ActsWithoutInversions G V) (u : Quiver.Total V) :
    ¬ ∃ g h : G, g • u = h • u.reverse := by
  rintro ⟨g, h, hgh⟩
  refine hninv (h⁻¹ * g) u ?_
  change (h⁻¹ * g) • u = u.reverse
  rw [← smul_smul, hgh, inv_smul_smul]

/-- A chosen representative oriented edge for each half-edge. -/
noncomputable def heRep (h : HalfEdge (G := G) (V := V)) : Quiver.Total V := Quotient.out h

theorem heRep_halfEdge (h : HalfEdge (G := G) (V := V)) :
    halfEdge (heRep h) = h := Quotient.out_eq h

/-- The orientation of an oriented edge, relative to the chosen representative of its half-edge:
`true` when the edge is a translate of the representative (i.e. points the "same way"). -/
noncomputable def orientation (u : Quiver.Total V) : Bool := by
  classical
  exact if ∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u then true else false

theorem orientation_eq_true_iff (u : Quiver.Total V) :
    orientation (G := G) (V := V) u = true ↔
      ∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u := by
  rw [orientation]
  by_cases h : ∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u <;> simp [h]

theorem orientation_eq_false_iff (u : Quiver.Total V) :
    orientation (G := G) (V := V) u = false ↔
      ¬ ∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u := by
  rw [orientation]
  by_cases h : ∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u <;> simp [h]

theorem orientation_ne_true_iff (u : Quiver.Total V) :
    orientation (G := G) (V := V) u ≠ true ↔
      ¬ ∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u := by
  by_cases h : orientation (G := G) (V := V) u = true
  · have hx := (orientation_eq_true_iff u).1 h
    simp [h, hx]
  · have h' : orientation (G := G) (V := V) u = false := by
      cases e : orientation (G := G) (V := V) u <;> simp_all
    have hx := (orientation_eq_false_iff u).1 h'
    simp [h, hx]

@[simp] theorem orientation_smul (g : G) (u : Quiver.Total V) :
    orientation (G := G) (V := V) (g • u) = orientation (G := G) (V := V) u := by
  rw [orientation, orientation, halfEdge_smul]
  by_cases h : ∃ k : G, heRep (halfEdge (G := G) (V := V) u) = k • u
  · have h' : ∃ k : G, heRep (halfEdge (G := G) (V := V) u) = k • (g • u) := by
      obtain ⟨k, hk⟩ := h
      exact ⟨k * g⁻¹, by rw [smul_smul]; simp [hk]⟩
    simp [h, h']
  · have h' : ¬ ∃ k : G, heRep (halfEdge (G := G) (V := V) u) = k • (g • u) := by
      rintro ⟨k, hk⟩
      exact h ⟨k * g, by rw [← smul_smul]; simp [hk]⟩
    simp [h, h']

/-- The representative of a half-edge points the same way as itself. -/
theorem orientation_heRep (h : HalfEdge (G := G) (V := V)) :
    orientation (G := G) (V := V) (heRep h) = true := by
  rw [orientation_eq_true_iff]
  exact ⟨1, by rw [heRep_halfEdge, one_smul]⟩

/-- The representative of a half-edge depends only on the half-edge. -/
theorem heRep_congr {u w : Quiver.Total V} (h : halfEdge (G := G) (V := V) u = halfEdge w) :
    heRep (halfEdge (G := G) (V := V) w) = heRep (halfEdge (G := G) (V := V) u) :=
  congrArg heRep h.symm

theorem orientation_reverse (hninv : ActsWithoutInversions G V) (u : Quiver.Total V) :
    orientation (G := G) (V := V) u.reverse = !orientation (G := G) (V := V) u := by
  have hnot : ¬ ∃ g h : G, g • u = h • u.reverse := not_smul_eq_smul_reverse hninv u
  have hor : (∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u) ∨
      (∃ g : G, heRep (halfEdge (G := G) (V := V) u) = g • u.reverse) :=
    (halfEdge_eq_iff (u := u) (w := heRep (halfEdge (G := G) (V := V) u))).1
      (heRep_halfEdge (halfEdge (G := G) (V := V) u)).symm
  by_cases hP : ∃ k : G, heRep (halfEdge (G := G) (V := V) u) = k • u
  · have hu : orientation (G := G) (V := V) u = true := (orientation_eq_true_iff u).2 hP
    have hw : orientation (G := G) (V := V) u.reverse = false := by
      rw [orientation_eq_false_iff]
      intro hcon
      obtain ⟨k, hk⟩ := hcon
      rw [halfEdge_reverse] at hk
      obtain ⟨k', hk'⟩ := hP
      exact hnot ⟨k', k, hk'.symm.trans hk⟩
    rw [hu, hw]
    rfl
  · have hu : orientation (G := G) (V := V) u = false := (orientation_eq_false_iff u).2 hP
    have hw : orientation (G := G) (V := V) u.reverse = true := by
      rw [orientation_eq_true_iff, halfEdge_reverse]
      exact hor.resolve_left hP
    rw [hu, hw]
    rfl

/-- If `u` points the same way as the representative of its half-edge, it is a translate of
that representative. -/
theorem exists_smul_heRep_of_orientation_eq_true {u : Quiver.Total V}
    (h : orientation (G := G) (V := V) u = true) :
    ∃ g : G, u = g • heRep (halfEdge (G := G) (V := V) u) := by
  obtain ⟨g, hg⟩ := (orientation_eq_true_iff u).1 h
  exact ⟨g⁻¹, by rw [hg]; simp⟩

/-- If `u` points the opposite way to the representative of its half-edge, it is a translate of
the reverse of that representative. -/
theorem exists_smul_heRep_reverse_of_orientation_ne_true {u : Quiver.Total V}
    (h : orientation (G := G) (V := V) u ≠ true) :
    ∃ g : G, u = g • (heRep (halfEdge (G := G) (V := V) u)).reverse := by
  have hor : (∃ g : G, u = g • heRep (halfEdge (G := G) (V := V) u)) ∨
      (∃ g : G, u = g • (heRep (halfEdge (G := G) (V := V) u)).reverse) :=
    (halfEdge_eq_iff (u := heRep (halfEdge (G := G) (V := V) u)) (w := u)).1
      (heRep_halfEdge (halfEdge (G := G) (V := V) u))
  rcases hor with ⟨g, hg⟩ | h'
  · exact absurd (by rw [hg, orientation_smul]; exact orientation_heRep _) h
  · exact h'

/-- Two oriented edges with the same half-edge and the same orientation are translates. -/
theorem exists_smul_of_halfEdge_eq_of_orientation_eq {u w : Quiver.Total V}
    (h : halfEdge (G := G) (V := V) u = halfEdge w)
    (ho : orientation (G := G) (V := V) u = orientation (G := G) (V := V) w) :
    ∃ g : G, w = g • u := by
  have hrep : heRep (halfEdge (G := G) (V := V) w) = heRep (halfEdge (G := G) (V := V) u) :=
    heRep_congr h
  by_cases hu : orientation (G := G) (V := V) u = true
  · obtain ⟨g, hg⟩ := exists_smul_heRep_of_orientation_eq_true hu
    have hw : orientation (G := G) (V := V) w = true := by rw [← ho, hu]
    obtain ⟨k, hk⟩ := exists_smul_heRep_of_orientation_eq_true hw
    refine ⟨k * g⁻¹, ?_⟩
    rw [hk, hrep]
    conv_rhs => rw [hg]
    rw [smul_smul]
    congr 1
    group
  · have hnu : orientation (G := G) (V := V) u = false := by
      cases h' : orientation (G := G) (V := V) u <;> simp_all
    have hnw : orientation (G := G) (V := V) w = false := by rw [← ho, hnu]
    obtain ⟨g₁, hg₁⟩ :=
      exists_smul_heRep_reverse_of_orientation_ne_true (u := u) (by rw [hnu]; simp)
    obtain ⟨g₂, hg₂⟩ :=
      exists_smul_heRep_reverse_of_orientation_ne_true (u := w) (by rw [hnw]; simp)
    refine ⟨g₂ * g₁⁻¹, ?_⟩
    rw [hg₂, hrep]
    conv_rhs => rw [hg₁]
    rw [smul_smul]
    congr 1
    group

/-- Two oriented edges with the same half-edge and opposite orientations are translates of
each other's reverse. -/
theorem exists_smul_reverse_of_halfEdge_eq_of_orientation_ne {u w : Quiver.Total V}
    (h : halfEdge (G := G) (V := V) u = halfEdge w)
    (ho : orientation (G := G) (V := V) u ≠ orientation (G := G) (V := V) w) :
    ∃ g : G, w = g • u.reverse := by
  have hrev : (∃ k : G, w = k • heRep (halfEdge (G := G) (V := V) u)) ∨
      (∃ k : G, w = k • (heRep (halfEdge (G := G) (V := V) u)).reverse) :=
    (halfEdge_eq_iff (u := heRep (halfEdge (G := G) (V := V) u)) (w := w)).1
      ((heRep_halfEdge (halfEdge (G := G) (V := V) u)).trans h)
  by_cases hu : orientation (G := G) (V := V) u = true
  · obtain ⟨g, hg⟩ := exists_smul_heRep_of_orientation_eq_true hu
    have ho' : heRep (halfEdge (G := G) (V := V) u) = g⁻¹ • u := by
      conv_rhs => rw [hg]
      simp
    rcases hrev with ⟨k, hk⟩ | ⟨k, hk⟩
    · exfalso
      refine ho ?_
      have hw : w = (k * g⁻¹) • u := by rw [hk, ho', smul_smul]
      rw [hw, orientation_smul]
    · refine ⟨k * g⁻¹, ?_⟩
      rw [hk, ho', ← GraphAction.smul_reverse_apply, smul_smul]
  · obtain ⟨g, hg⟩ := exists_smul_heRep_reverse_of_orientation_ne_true hu
    have ho' : heRep (halfEdge (G := G) (V := V) u) = g⁻¹ • u.reverse := by
      conv_rhs => rw [hg]
      rw [← GraphAction.smul_reverse_apply, Quiver.Total.reverse_reverse]
      simp
    rcases hrev with ⟨k, hk⟩ | ⟨k, hk⟩
    · refine ⟨k * g⁻¹, ?_⟩
      rw [hk, ho', smul_smul]
    · exfalso
      refine ho ?_
      have hw : w = (k * g⁻¹) • u := by
        rw [hk, ho', ← GraphAction.smul_reverse_apply, Quiver.Total.reverse_reverse, smul_smul]
      rw [hw, orientation_smul]

/-- The letter of an oriented edge: its half-edge together with its orientation. -/
noncomputable def edgeLetter (u : Quiver.Total V) : HalfEdge (G := G) (V := V) × Bool :=
  (halfEdge u, orientation (G := G) (V := V) u)

/-- The word in the free group on the half-edges determined by a path: the list of the half-edges
of its arrows, in order, each with its orientation bit. -/
noncomputable def pathWord {a : V} : ∀ {b : V}, Quiver.Path a b →
    List (HalfEdge (G := G) (V := V) × Bool)
  | _, Quiver.Path.nil => []
  | _, Quiver.Path.cons p e =>
      pathWord p ++ [edgeLetter (G := G) (V := V) (Quiver.Total.mk _ _ e)]

@[simp] theorem pathWord_nil {a : V} : pathWord (G := G) (V := V) (Quiver.Path.nil : Quiver.Path a a) = [] :=
  rfl

@[simp] theorem pathWord_cons {a b c : V} (p : Quiver.Path a b) (e : b ⟶ c) :
    pathWord (G := G) (V := V) (p.cons e) =
      pathWord p ++ [edgeLetter (G := G) (V := V) (Quiver.Total.mk b c e)] := rfl

theorem pathWord_comp {a b c : V} (p : Quiver.Path a b) (q : Quiver.Path b c) :
    pathWord (G := G) (V := V) (p.comp q) = pathWord p ++ pathWord q := by
  induction q with
  | nil => simp
  | cons q e ih => rw [Quiver.Path.comp_cons, pathWord_cons, ih, pathWord_cons, List.append_assoc]

/-- The element of the free group on the half-edges determined by a path. -/
noncomputable def pathWordFree {a b : V} (p : Quiver.Path a b) :
    FreeGroup (HalfEdge (G := G) (V := V)) :=
  FreeGroup.mk (pathWord p)

theorem pathWordFree_nil {a : V} :
    pathWordFree (G := G) (V := V) (Quiver.Path.nil : Quiver.Path a a) = 1 :=
  rfl

theorem pathWordFree_comp {a b c : V} (p : Quiver.Path a b) (q : Quiver.Path b c) :
    pathWordFree (G := G) (V := V) (p.comp q) = pathWordFree p * pathWordFree q := by
  rw [pathWordFree, pathWordFree, pathWordFree, pathWord_comp, FreeGroup.mul_mk]

section PathWordBasic

theorem pathWordFree_toPath {a b : V} (e : a ⟶ b) :
    pathWordFree (G := G) (V := V) e.toPath =
      FreeGroup.mk [edgeLetter (G := G) (V := V) (Quiver.Total.mk a b e)] := by
  rw [pathWordFree, show e.toPath = (Quiver.Path.nil : Quiver.Path a a).cons e from rfl,
    pathWord_cons, pathWord_nil, List.nil_append]

/-- The half-edge word of a path is invariant under the group action. -/
theorem pathWord_smul (g : G) {a b : V} (p : Quiver.Path a b) :
    pathWord (G := G) (V := V) (smulPath g p) = pathWord (G := G) (V := V) p := by
  induction p using Quiver.Path.rec with
  | nil => simp
  | cons p e ih =>
    rw [smulPath_cons, pathWord_cons, pathWord_cons, ih]
    congr 1
    simp only [edgeLetter]
    rw [Quotient.total_mk_smulArrow g (Quiver.Total.mk _ _ e), halfEdge_smul, orientation_smul]

theorem pathWordFree_smul (g : G) {a b : V} (p : Quiver.Path a b) :
    pathWordFree (G := G) (V := V) (smulPath g p) = pathWordFree (G := G) (V := V) p := by
  rw [pathWordFree, pathWordFree, pathWord_smul g p]

theorem length_eq_zero_of_pathWord_eq_nil {a b : V} {p : Quiver.Path a b}
    (h : pathWord (G := G) (V := V) p = []) : p.length = 0 := by
  induction p using Quiver.Path.rec with
  | nil => rfl
  | cons p e ih =>
    rw [pathWord_cons] at h
    exact absurd h (by simp)

end PathWordBasic

section PathWordReverse

theorem pathWordFree_reverse_toPath (hninv : ActsWithoutInversions G V) {a b : V} (e : a ⟶ b) :
    pathWordFree (G := G) (V := V) (Quiver.reverse e).toPath =
      (pathWordFree (G := G) (V := V) e.toPath)⁻¹ := by
  have hrev : Quiver.Total.mk b a (Quiver.reverse e) = (Quiver.Total.mk a b e).reverse := rfl
  rw [pathWordFree_toPath, pathWordFree_toPath, FreeGroup.inv_mk]
  congr 1
  simp only [edgeLetter, hrev, halfEdge_reverse, orientation_reverse hninv]
  rfl

theorem pathWordFree_deleteBacktrack (hninv : ActsWithoutInversions G V) {a b : V}
    {p q : Quiver.Path a b} (h : Quiver.Path.DeleteBacktrack p q) :
    pathWordFree (G := G) (V := V) p = pathWordFree (G := G) (V := V) q := by
  cases h with
  | intro p₁ e p₂ =>
    simp only [pathWordFree_comp, pathWordFree_reverse_toPath hninv]
    group

theorem pathWordFree_reducesTo (hninv : ActsWithoutInversions G V) {a b : V}
    {p q : Quiver.Path a b} (h : p.ReducesTo q) :
    pathWordFree (G := G) (V := V) p = pathWordFree (G := G) (V := V) q := by
  induction h with
  | refl => rfl
  | tail _ hstep ih => rw [ih, pathWordFree_deleteBacktrack hninv hstep]

/-- The element of the free group on the half-edges determined by a path only depends on the
endpoints of the path. -/
theorem pathWordFree_eq_of_same_endpoints (hT : IsTree V) (hninv : ActsWithoutInversions G V)
    {a b : V} (p q : Quiver.Path a b) :
    pathWordFree (G := G) (V := V) p = pathWordFree (G := G) (V := V) q := by
  obtain ⟨r, hr, hrr⟩ := Tree.Reduction.qpath_exists_reducesTo_isReduced p
  obtain ⟨s, hs, hss⟩ := Tree.Reduction.qpath_exists_reducesTo_isReduced q
  rw [pathWordFree_reducesTo hninv hr, pathWordFree_reducesTo hninv hs,
    Tree.Geodesic.qpath_eq_of_isTree hT hrr hss]

end PathWordReverse

section PathWordReduced

theorem exists_cons_of_pathWord_getLast?_eq_some {a b : V} {p : Quiver.Path a b}
    {x : HalfEdge (G := G) (V := V) × Bool}
    (h : (pathWord (G := G) (V := V) p).getLast? = some x) :
    ∃ (y : V) (p' : Quiver.Path a y) (f : y ⟶ b), p = p'.cons f ∧
      x = edgeLetter (G := G) (V := V) (Quiver.Total.mk y b f) := by
  induction p using Quiver.Path.rec with
  | nil => simp at h
  | cons p e ih =>
    rw [pathWord_cons, List.getLast?_append_of_ne_nil _ (by simp), List.getLast?_singleton] at h
    exact ⟨_, p, e, rfl, (Option.some.inj h).symm⟩

/-- Two consecutive arrows with the same half-edge but opposite orientations form a backtrack,
so a reduced path cannot contain such a pair. -/
theorem not_isReduced_cons_cons {a x z w : V} (p : Quiver.Path a x) (f : x ⟶ z) (e : z ⟶ w)
    (hfree : ActsFreely G V)
    (h : halfEdge (G := G) (V := V) (Quiver.Total.mk x z f) =
      halfEdge (Quiver.Total.mk z w e))
    (ho : orientation (G := G) (V := V) (Quiver.Total.mk x z f) ≠
      orientation (G := G) (V := V) (Quiver.Total.mk z w e)) :
    ¬ ((p.cons f).cons e).IsReduced := by
  intro hred
  obtain ⟨g, hg⟩ := exists_smul_reverse_of_halfEdge_eq_of_orientation_ne
    (u := Quiver.Total.mk x z f) (w := Quiver.Total.mk z w e) h ho
  have hgz : g = 1 := by
    refine hfree g z ?_
    have h1 : (Quiver.Total.mk z w e).left = (g • (Quiver.Total.mk x z f).reverse).left :=
      congrArg Quiver.Total.left hg
    have h2 : (g • (Quiver.Total.mk x z f).reverse).left = g • z := by
      show (GraphAction.smulTotal g (Quiver.Total.mk x z f).reverse).left = g • z
      rw [GraphAction.smul_left]
      simp
    exact (h1.trans h2).symm
  subst hgz
  rw [one_smul] at hg
  have hw : w = x := by
    have := congrArg Quiver.Total.right hg
    simpa using this
  subst hw
  have he : e = Quiver.reverse f := by
    injection hg with _ _ _
  subst he
  exact hred p (Quiver.Path.DeleteBacktrack.intro p f Quiver.Path.nil)

/-- The half-edge word of a reduced path is a reduced word. -/
theorem isReduced_pathWord (hninv : ActsWithoutInversions G V) (hfree : ActsFreely G V)
    {a b : V} (p : Quiver.Path a b) (hp : p.IsReduced) :
    FreeGroup.IsReduced (pathWord (G := G) (V := V) p) := by
  induction p using Quiver.Path.rec with
  | nil => exact FreeGroup.IsReduced.nil
  | cons p e ih =>
    rw [pathWord_cons, FreeGroup.IsReduced, List.isChain_append]
    have hp' : p.IsReduced :=
      Quiver.Path.IsReduced.of_comp (q := e.toPath) (by simpa using hp)
    refine ⟨ih hp', FreeGroup.IsReduced.singleton, ?_⟩
    intro x hx y hy
    simp only [List.head?_singleton, Option.mem_some_iff] at hy
    subst hy
    intro hxe
    by_contra hoe
    obtain ⟨y', p', f, hpf, hx'⟩ := exists_cons_of_pathWord_getLast?_eq_some hx
    subst hpf
    have hfe : halfEdge (G := G) (V := V) (Quiver.Total.mk _ _ f) =
        halfEdge (Quiver.Total.mk _ _ e) := by
      have h1 : (edgeLetter (G := G) (V := V) (Quiver.Total.mk _ _ f)).1 =
          (edgeLetter (G := G) (V := V) (Quiver.Total.mk _ _ e)).1 := by
        rw [← hx']
        exact hxe
      simpa [edgeLetter] using h1
    have hoe' : orientation (G := G) (V := V) (Quiver.Total.mk _ _ f) ≠
        orientation (G := G) (V := V) (Quiver.Total.mk _ _ e) := by
      intro hc
      refine hoe ?_
      rw [hx']
      simpa [edgeLetter] using hc
    exact not_isReduced_cons_cons p' f e hfree hfe hoe' (by simpa using hp)

end PathWordReduced

end Work.ORBassSerre.Action
