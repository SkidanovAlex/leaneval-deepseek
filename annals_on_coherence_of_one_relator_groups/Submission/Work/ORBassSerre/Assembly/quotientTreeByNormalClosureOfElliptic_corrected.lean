set_option linter.style.haveILetI false

/-- A finitely generated subgroup has finitely generated image under any homomorphism. -/
theorem fg_map {G H : Type u} [Group G] [Group H] (e : G →* H) {P : Subgroup G}
    (h : P.FG) : (P.map e).FG := by
  classical
  obtain ⟨S, hS⟩ := Subgroup.isMulFG_iff.mp h
  refine Subgroup.isMulFG_iff.mpr ⟨S.image e, ?_⟩
  rw [← hS, MonoidHom.map_closure, Finset.coe_image]

/-- `Quotient.mk''` is surjective onto the orbit set. -/
theorem mk_surjective {H : Type u} [Group H] {W : Type u} [MulAction H W] (K : Subgroup H) :
    Function.Surjective (Quotient.mk'' : W → MulAction.orbitRel.Quotient K W) :=
  fun A => Quotient.inductionOn A (fun w => ⟨w, rfl⟩)

/-- `Work.ORDunwoody.QuotientTreeByNormalClosureOfElliptic` with the domination map pointing the
other way (from the big tree to the quotient) and required to be surjective: the equivariance
clause `f (mk' K h • x) = h • f x` of the original forces every element of `K` to fix `f x`, which
is false in general (infinite dihedral acting on the line, `K = ⟨s, t²⟩`), and without
surjectivity the stabilizer clause would only cover image vertices.

**Statement as requested by the requester (this is the text as handed to this file).**  It read

```
    ∃ (X : Type u) (_ : MulAction (H ⧸ K) X) (S : Work.ORDunwoody.GTree (H ⧸ K) X) (g : W → X),
      S.IsCocompact ∧ S.HasFGStab ∧ Function.Surjective g ∧
      (∀ (h : H) (w : W), g (h • w) = QuotientGroup.mk' K h • g w) ∧
      (∀ ⦃u v : W⦄, S'.Adj u v → S.Adj (g u) (g v) ∨ g u = g v) ∧
      (∀ x : X, S.vertexStab x = (S'.vertexStab (Function.surjInv ‹Function.Surjective g› x)).map
        (QuotientGroup.mk' K))
```

That text does not elaborate: `‹Function.Surjective g›` is `(by assumption)`, and
`Function.Surjective g` is a *conjunct of the existential body*, not a binder in scope, so
elaboration fails with ``Tactic `assumption` failed / ⊢ Function.Surjective g``.  The surjectivity
witness must be bound.  Below the ∃ therefore binds the surjectivity proof
(`(hg : Function.Surjective g)`) and the last clause uses `Function.surjInv hg`; nothing else is
changed.  The construction is Serre, *Trees*, §5: `X` is the set of `K`-orbits of `W`, `S` is the
quotient graph (a tree by JL Lemma 4.1, `isTree_orbitV_of_normalClosure_elliptic`) and `g` the
orbit map. -/
theorem quotientTreeByNormalClosureOfElliptic_corrected (Y : Type u) :
    ∀ (H : Type u) [Group H] {W : Type u} [MulAction H W] (S' : Work.ORDunwoody.GTree H W)
      (A : Finset W) (N : (w : W) → w ∈ A → Subgroup H)
      (hN : ∀ (w : W) (hw : w ∈ A), N w hw ≤ S'.vertexStab w)
      (hA : ∀ w : W, ∃ h : H, h • w ∈ A)
      (K : Subgroup H) [K.Normal]
      (hK : K = Subgroup.normalClosure (⋃ (w : W) (hw : w ∈ A), (N w hw : Set H)))
      (hc : S'.IsCocompact) (hfg : S'.HasFGStab),
      ∃ (X : Type u) (_ : MulAction (H ⧸ K) X) (S : Work.ORDunwoody.GTree (H ⧸ K) X) (g : W → X)
        (hg : Function.Surjective g),
        S.IsCocompact ∧ S.HasFGStab ∧
        (∀ (h : H) (w : W), g (h • w) = QuotientGroup.mk' K h • g w) ∧
        (∀ ⦃u v : W⦄, S'.Adj u v → S.Adj (g u) (g v) ∨ g u = g v) ∧
        (∀ x : X, S.vertexStab x = (S'.vertexStab (Function.surjInv hg x)).map
          (QuotientGroup.mk' K)) := by
  intro H _instH W _instW S' A N hN hA K _instK hK hc hfg
  classical
  -- the edge quiver of `S'`
  letI : Quiver W := Work.ORDunwoody.Lemmas.graphQuiver S'.graph
  letI : Quiver.HasInvolutiveReverse W :=
    Work.ORDunwoody.Lemmas.graphQuiverHasInvolutiveReverse S'.graph
  letI : Work.ORBassSerre.GraphAction H W := Work.ORDunwoody.Lemmas.graphQuiverAction S'
  have hT : Work.ORBassSerre.IsTree W := Work.ORDunwoody.Lemmas.graphQuiver_isTree S'
  haveI : Nonempty W := S'.isTree.connected.nonempty
  -- the normal closure of vertex-fixing subgroups is generated by elliptic elements
  have hEll : ∀ g ∈ (⋃ (w : W) (hw : w ∈ A), (N w hw : Set H)), ∃ v : W, g • v = v := by
    intro g hg
    simp only [Set.mem_iUnion] at hg
    obtain ⟨w, hw, hgw⟩ := hg
    exact ⟨w, hN w hw hgw⟩
  -- the quotient graph of `K` is a tree
  have htree : Work.ORBassSerre.IsTree (Work.ORBassSerre.orbitV K W) :=
    Work.ORBassSerre.Action.isTree_orbitV_of_normalClosure_elliptic hT K
      (⋃ (w : W) (hw : w ∈ A), (N w hw : Set H)) hEll hK.symm
  haveI : Nonempty (Work.ORBassSerre.orbitV K W) := (inferInstance : Nonempty W).map Quotient.mk''
  have hnl : ∀ A : Work.ORBassSerre.orbitV K W, ¬ Nonempty (A ⟶ A) :=
    Work.ORDunwoody.Lemmas.noLoop_of_isTree htree
  -- the tree for the quotient group
  let S : Work.ORDunwoody.GTree (H ⧸ K) (Work.ORBassSerre.orbitV K W) :=
    { graph := Work.ORDunwoody.Lemmas.quiverGraph (Work.ORBassSerre.orbitV K W) hnl
      isTree := Work.ORDunwoody.Lemmas.isTree_quiverGraph htree
      smul_adj := fun q _ _ h => Work.ORBassSerre.QuotientTree.nonempty_hom_smul K h q }
  have hstab : ∀ w : W, S.vertexStab (Quotient.mk'' w) =
      (S'.vertexStab w).map (QuotientGroup.mk' K) := by
    intro w
    rw [Work.ORDunwoody.GTree.vertexStab, Work.ORDunwoody.GTree.vertexStab,
      Work.ORBassSerre.QuotientTree.stabilizer_quotient_mk K w]
  have hstabAll : ∀ x : Work.ORBassSerre.orbitV K W, S.vertexStab x =
      (S'.vertexStab (Function.surjInv (mk_surjective K) x)).map (QuotientGroup.mk' K) := by
    intro x
    conv_lhs => rw [← Function.surjInv_eq (mk_surjective K) x]
    exact hstab (Function.surjInv (mk_surjective K) x)
  refine ⟨Work.ORBassSerre.orbitV K W, inferInstance, S, Quotient.mk'', mk_surjective K,
    ?_, ?_, ?_, ?_, ?_⟩
  · -- cocompactness
    refine ⟨Work.ORBassSerre.QuotientTree.finite_orbitQuotient_quotient K hc.1, ?_⟩
    -- finitely many orbits of edges of the quotient
    haveI : Finite (MulAction.orbitRel.Quotient H S'.AdjPair) := hc.2
    obtain ⟨s, hs⟩ := Work.ORDunwoody.Lemmas.exists_finset_of_finite_orbitQuotient
      (G := H) (V := S'.AdjPair)
    -- the map on oriented edges
    let φ : S'.AdjPair → S.AdjPair := fun p =>
      ⟨(Quotient.mk'' p.1.1, Quotient.mk'' p.1.2),
        ⟨Work.ORBassSerre.orbitArrow (Classical.choice
          ((Work.ORDunwoody.Lemmas.nonempty_hom_iff_adj S'.graph p.1.1 p.1.2).mpr p.2))⟩⟩
    refine Work.ORDunwoody.Lemmas.finite_orbitQuotient_of_exists_finset (G := H ⧸ K)
      (s.image φ) ?_
    intro p
    obtain ⟨⟨A, B⟩, hAB⟩ := p
    obtain ⟨a, b, ha, hb, hab⟩ :=
      (Work.ORBassSerre.QuotientTree.orbitQuiver_nonempty_hom_iff K A B).mp hAB
    obtain ⟨h, hh⟩ := hs ⟨(a, b),
      (Work.ORDunwoody.Lemmas.nonempty_hom_iff_adj S'.graph a b).mp hab⟩
    refine ⟨QuotientGroup.mk' K h, Finset.mem_image.mpr ⟨h • ⟨(a, b), _⟩, hh, ?_⟩⟩
    refine Subtype.ext (Prod.ext ?_ ?_)
    · show (Quotient.mk'' (h • a) : Work.ORBassSerre.orbitV K W) = QuotientGroup.mk' K h • A
      rw [← ha, Work.ORBassSerre.quotient_smul_mk]
    · show (Quotient.mk'' (h • b) : Work.ORBassSerre.orbitV K W) = QuotientGroup.mk' K h • B
      rw [← hb, Work.ORBassSerre.quotient_smul_mk]
  · -- finite generation of the stabilizers
    refine ⟨?_, ?_⟩
    · intro x
      rw [hstabAll x]
      exact fg_map (QuotientGroup.mk' K) (hfg.1 (Function.surjInv (mk_surjective K) x))
    · intro A B hAB
      rw [Work.ORDunwoody.GTree.edgeStab_eq]
      obtain ⟨a, b, ha, hb, hab⟩ :=
        (Work.ORBassSerre.QuotientTree.orbitQuiver_nonempty_hom_iff K A B).mp hAB
      rw [Work.ORDunwoody.GTree.vertexStab, Work.ORDunwoody.GTree.vertexStab,
        Work.ORBassSerre.QuotientTree.inf_stabilizer_eq_map K htree ha hb hab]
      exact fg_map (QuotientGroup.mk' K) (by
        have h1 := hfg.2 a b
          ((Work.ORDunwoody.Lemmas.nonempty_hom_iff_adj S'.graph a b).mp hab)
        rwa [Work.ORDunwoody.GTree.edgeStab_eq, Work.ORDunwoody.GTree.vertexStab,
          Work.ORDunwoody.GTree.vertexStab] at h1)
  · -- equivariance
    intro h w
    exact Work.ORBassSerre.quotient_smul_mk K h w |>.symm
  · -- edges go to edges
    intro u v huv
    exact Or.inl ⟨Work.ORBassSerre.orbitArrow (Classical.choice
      ((Work.ORDunwoody.Lemmas.nonempty_hom_iff_adj S'.graph u v).mpr huv))⟩
  · -- stabilizers are the images of the stabilizers of `S'`
    exact hstabAll

end Work.ORBassSerre.Assembly
