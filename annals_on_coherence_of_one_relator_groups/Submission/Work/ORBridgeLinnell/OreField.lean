# The Ore field of fractions statement (I4′a)

`Work.ORLinnell.LinnellDatum.ore_field_unit` asserts that for `N ≤ Γ` with `Γ` torsion free and
`Γ/N ≅ ℤ`, every nonzero element of the subring `⟨D N ∪ Γ⟩` generated by `D N` and (the image of)
`Γ` is a unit of `D Γ` with inverse in `D Γ`.

This file shows that this is a *formal consequence* of **(I4)** (`division_of_torsionFree`):
`Γ` is torsion free, so `D Γ` is a division ring, and a nonzero element of a subring of a division
ring is a unit with inverse in the division ring.

The companion statement **(I4′b)** (`ore_field_frac`, Linnell's Ore lemma) is *not* a formal
consequence and is isolated as a field of `Work.ORBridgeLinnell.HughesFreeInput`.
-/
import Mathlib
import Submission.Work.ORBridgeLinnell.Basic

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ORBridgeLinnell

open Work.ORVonNeumann

variable {G : Type*} [Group G] {K : Type*} [Field K]

/-- The subring `⟨D N ∪ Γ⟩` generated by `D N` and the image of a subgroup `Γ ≤ G`. -/
noncomputable def genSubring (E : StarRegularEnvelope G) (φK : K →+* ℂ) [Algebra K E.U]
    (N Γ : Subgroup G) : Subring E.U :=
  Subring.closure (((D E φK N : Subring E.U) : Set E.U) ∪
    Set.range (fun γ : Γ => (gen E (γ : G) : E.U)))

theorem genSubring_le_D (E : StarRegularEnvelope G) (φK : K →+* ℂ) [Algebra K E.U]
    {N Γ : Subgroup G} (hN : N ≤ Γ) : genSubring E φK N Γ ≤ D E φK Γ :=
  Subring.closure_le.mpr (by
    rintro x (hx | hx)
    · exact D_mono E φK hN hx
    · obtain ⟨γ, rfl⟩ := hx
      exact gen_mem_D' E φK γ.2)

/-- **(I4′a)** from **(I4)**: every nonzero element of `⟨D N ∪ Γ⟩` is a unit of `U` with inverse
in `D Γ`. -/
theorem ore_field_unit_of_division (E : StarRegularEnvelope G) (φK : K →+* ℂ) [Algebra K E.U]
    (hdiv : ∀ H : Subgroup G, IsMulTorsionFree H →
      ∀ x : ↥(D E φK H), x ≠ 0 → IsUnit x)
    (N Γ : Subgroup G) (hN : N ≤ Γ) (htf : IsMulTorsionFree Γ)
    (hφ : Work.ORLinnell.IsExtensionByZ N Γ) {t : E.U} (ht : t ∈ genSubring E φK N Γ)
    (htne : t ≠ 0) :
    ∃ u ∈ (D E φK Γ : Set E.U), u * t = 1 ∧ t * u = 1 := by
  have htD : t ∈ D E φK Γ := genSubring_le_D E φK hN ht
  obtain ⟨w, hw⟩ := hdiv Γ htf ⟨t, htD⟩ (fun h => htne (congrArg Subtype.val h))
  have hwv : ((w : ↥(D E φK Γ)) : E.U) = t := congrArg Subtype.val hw
  refine ⟨((w⁻¹ : (↥(D E φK Γ))ˣ) : E.U),
    ((w⁻¹ : (↥(D E φK Γ))ˣ) : ↥(D E φK Γ)).2, ?_, ?_⟩
  · have h1 : ((w⁻¹ : (↥(D E φK Γ))ˣ) : E.U) * ((w : (↥(D E φK Γ))ˣ) : E.U) = 1 := by
      rw [← Subring.coe_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, Subring.coe_one]
    rwa [hwv] at h1
  · have h1 : ((w : (↥(D E φK Γ))ˣ) : E.U) * ((w⁻¹ : (↥(D E φK Γ))ˣ) : E.U) = 1 := by
      rw [← Subring.coe_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Subring.coe_one]
    rwa [hwv] at h1

end Work.ORBridgeLinnell
