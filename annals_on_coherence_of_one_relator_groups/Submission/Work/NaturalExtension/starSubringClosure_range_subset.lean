import Mathlib
import Submission.Work.ORHughesFree.StarRegular
import Submission.Work.ORHughesFree.StarRegular.starSubringClosure_mono
import Submission.Work.ORHughesFree.StarRegular.starSubringClosure_le_iff
import Submission.Work.ORHughesFree.StarRegular.starRegularClosure_mono

set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option linter.unusedVariables false

namespace Work.NaturalExtension

open Work.ORHughesFree

/-- (This file was lost by accident and recovered — statement `#print`ed from the surviving
`.olean`, proof re-done.)  The `∗`-subring generated by the range of `φ` is contained in the image
of the `∗`-subring generated by the range of any lift `ψ` of `φ` to a `∗`-subring `A` of `P`. -/
theorem starSubringClosure_range_subset {S : Type*} {P : Type*} [Ring S] [StarRing S]
    [Ring P] [StarRing P] {A : StarSubring P} (φ : S →+* P)
    (hφ : ∀ s : S, φ (star s) = star (φ s)) (ψ : S →+* ↥A) (hψ : ∀ s : S, (ψ s : P) = φ s) :
    ((starSubringClosure (Set.range φ) : StarSubring P) : Set P) ⊆
      Subtype.val '' ((starSubringClosure (Set.range ψ) : StarSubring ↥A) : Set ↥A) := by
  let B : StarSubring ↥A := starSubringClosure (Set.range ψ)
  let T : StarSubring P :=
    { toSubring :=
        { carrier := Subtype.val '' (B : Set ↥A)
          mul_mem' := by
            rintro x y ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
            exact ⟨a * b, B.toSubring.mul_mem' ha hb, rfl⟩
          one_mem' := ⟨1, B.toSubring.one_mem', rfl⟩
          add_mem' := by
            rintro x y ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
            exact ⟨a + b, B.toSubring.add_mem' ha hb, rfl⟩
          zero_mem' := ⟨0, B.toSubring.zero_mem', rfl⟩
          neg_mem' := by
            rintro x ⟨a, ha, rfl⟩
            exact ⟨-a, B.toSubring.neg_mem' ha, rfl⟩ }
      star_mem' := by
        rintro x ⟨a, ha, rfl⟩
        exact ⟨star a, B.star_mem' ha, rfl⟩ }
  exact starSubringClosure_le (T := T) (by
    rintro x ⟨s, rfl⟩
    exact ⟨ψ s, subset_starSubringClosure (Set.range ψ) ⟨s, rfl⟩, hψ s⟩)

end Work.NaturalExtension
