/-
Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# The colour is constant on a piece of a face

`Dunwoody/Piece.lean` defines the *pieces* of a face: the equivalence relation `pieceRel` on the arc
indices of a face generated by its chords, where a chord joining the visits `p < q` glues the arc
*ending* at `p` (index `p`) to the arc *starting* at `q` (index `q + 1`) and, symmetrically, the arc
ending at `q` (index `q`) to the arc starting at `p` (index `p + 1`).

This file proves that the map `φ` of the construction, `colour : BaseV D → V` (`Dunwoody/Pattern.lean`),
is constant on every piece:

> if `pieceRel (faceVisits D c w) i j` and the old vertices `u`, `v` sit at the arc indices `i`, `j`
> of the boundary walk, then `colour u = colour v`.

The two ingredients are the two lemmas of `DESIGN_N13.md` §2c:

* **an arc has a constant colour** — `Work.ORDunwoody.colour_arcIndex`;
* **the two arcs glued by a chord have the same colour** — for the *first* gluing this is the fact
  that the two visits of a chord label the same edge of `T` and traverse it in opposite directions,
  i.e. `Work.ORDunwoody.colour_of_chord`; for the *second* gluing it is the complementary equality
  (`colour_of_chord_both` below).

Note on the proof of the second point: the existing `Work.ORDunwoody.colour_of_chord` is proved via
`Work.ORDunwoody.ChordWalk.cwc_chords_positions`, whose proof depends on the `sorry` in
`Submission/Work/ORDunwoody/ChordWalk/cwc_pairUp_mem.lean`; using it would make this file depend on
`sorryAx`.  We therefore re-derive both halves of the "opposite directions" statement here from the
`sorry`-free ingredients (`Work.ORDunwoody.label_of_chord`,
`ChordWalk.cwc_pairUp_spec`, `ChordWalk.cwc_mem_positionsOfLabel_iff`,
`ChordWalk.cwc_positionsOfLabel_pairwise`, `ChordWalk.cwc_chain_avoids_edge`,
`ChordWalk.cwc_faceTriples_colshare`, `faceTriples_arcIndex`, `colour_arcIndex`).

The assembly is then an induction on the equivalence closure `EqvGen (chordRel …)`: reflexivity is
`colour_arcIndex`, transitivity needs the fact — proved in the same induction — that every index
occurring in a `pieceRel`-chain is *realised* by an old vertex of the walk (`arcIndex_realized_of_le`).
-/
import Mathlib
import Submission.Work.ORDunwoody.colour_of_chord
import Submission.Work.ORDunwoody.colour_arcIndex
import Submission.Work.ORDunwoody.colour_collapsed
import Submission.Work.ORDunwoody.faceTriples_arcIndex
import Submission.Work.ORDunwoody.label_of_chord
import Submission.Work.ORDunwoody.ChordWalk.cwc_chain_avoids_edge
import Submission.Work.ORDunwoody.ChordWalk.cwc_faceTriples_colshare
import Submission.Work.ORDunwoody.ChordWalk.cwc_pairUp_spec
import Submission.Work.ORDunwoody.ChordWalk.cwc_mem_positionsOfLabel_iff
import Submission.Work.ORDunwoody.ChordWalk.cwc_positionsOfLabel_pairwise

set_option autoImplicit false
set_option linter.unusedVariables false
set_option maxHeartbeats 2000000

universe u

namespace Work.ORDunwoody

open Work.ORDunwoody.Dunwoody
open Work.ORDunwoody.Cayley
open scoped Sym2

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

/-! ## The positions of the visits of a chord -/

/-- The two entries of a pair produced by `pairUp` are entries of the original list. -/
private theorem chord_pairUp_mem : ∀ (L : List ℕ) (p q : ℕ), (p, q) ∈ pairUp L → p ∈ L ∧ q ∈ L
  | [], _, _, h => by simp at h
  | [x], _, _, h => by simp at h
  | x :: y :: rest, p, q, h => by
      rw [pairUp_cons_cons] at h
      rcases List.mem_cons.mp h with h | h
      · rw [Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨by simp, by simp⟩
      · obtain ⟨hp, hq⟩ := chord_pairUp_mem rest p q h
        exact ⟨by simp [hp], by simp [hq]⟩

/-- The positions of a fibre are positions of the list of visits. -/
private theorem positionsOfLabel_lt {l : List (MidV D)} {e : Sym2 V} {j : ℕ}
    (h : j ∈ positionsOfLabel l e) : j < l.length :=
  (ChordWalk.cwc_mem_positionsOfLabel_iff (D := D)).mp h |>.1

/-- Both visits of a chord sit at positions of the list of visits. -/
private theorem chords_mem_lt {l : List (MidV D)} {p q : ℕ}
    (h : (p, q) ∈ chords l) : p < l.length ∧ q < l.length := by
  rw [chords] at h
  rcases List.mem_flatMap.mp h with ⟨e, -, hpq⟩
  obtain ⟨hp, hq⟩ := chord_pairUp_mem _ p q hpq
  exact ⟨positionsOfLabel_lt hp, positionsOfLabel_lt hq⟩

/-- No visit strictly between the two visits of a chord has the label of the chord: the visits of a
fibre are paired in the order in which the walk meets them. -/
private theorem chords_avoid {l : List (MidV D)} {p q : ℕ}
    (h : (p, q) ∈ chords l) {r : ℕ} (hpr : p < r) (hrq : r < q)
    {mr mp : MidV D} (hr : l[r]? = some mr) (hp : l[p]? = some mp) : mr.label ≠ mp.label := by
  intro hlab
  rw [chords] at h
  rcases List.mem_flatMap.mp h with ⟨e, -, hpq⟩
  obtain ⟨hpm, _⟩ := chord_pairUp_mem _ p q hpq
  have hp_lab : mp.label = e := by
    have h2 := ((ChordWalk.cwc_mem_positionsOfLabel_iff (D := D)).mp hpm).2
    rw [hp] at h2
    simpa using h2
  have hr_lt : r < l.length := (List.getElem?_eq_some_iff.mp hr).1
  have hrm : r ∈ positionsOfLabel l e := by
    refine (ChordWalk.cwc_mem_positionsOfLabel_iff (D := D)).mpr ⟨hr_lt, ?_⟩
    rw [hr]
    exact congrArg some (hlab.trans hp_lab)
  have hspec := ChordWalk.cwc_pairUp_spec
    (ChordWalk.cwc_positionsOfLabel_pairwise (D := D) (l := l) (e := e)) hpq
  exact hspec.2 r hrm hpr hrq

/-- The two visits of a chord occur in the order of the walk. -/
private theorem chords_lt_snd {l : List (MidV D)} {p q : ℕ}
    (h : (p, q) ∈ chords l) : p < q := by
  rw [chords] at h
  rcases List.mem_flatMap.mp h with ⟨e, -, hpq⟩
  exact (ChordWalk.cwc_pairUp_spec
    (ChordWalk.cwc_positionsOfLabel_pairwise (D := D) (l := l) (e := e)) hpq).1

/-! ## Every arc index up to the number of visits is realised -/

/-- **Every arc index up to the number of visits is realised.**  For a face `(c, w)` and
`m ≤ (faceVisits D c w).length` there is an old vertex of the boundary walk whose arc index is
`m`: the starting vertex for `m = 0`, and the far end of the `m`-th visit otherwise. -/
theorem arcIndex_realized_of_le (c : G) (w : List (Fin P.n × Bool)) {m : ℕ}
    (hm : m ≤ (faceVisits D c w).length) :
    ∃ u : BaseV D, (u, m) ∈ arcIndex (faceWalk D c w) := by
  rcases Nat.eq_zero_or_pos m with hm0 | hmpos
  · subst hm0
    refine ⟨(c, Sum.inl ()), ?_⟩
    rw [arcIndex, faceWalk_eq]
    exact List.mem_cons_self
  · have hlen : (faceVisits D c w).length = (faceTriples D c w).length := by
      simp [faceVisits]
    have hlt : m - 1 < (faceTriples D c w).length := by omega
    have hstep := (faceTriples_arcIndex (D := D) c w (p := m - 1)
      (List.getElem?_eq_getElem hlt)).2.1
    refine ⟨((faceTriples D c w).get ⟨m - 1, hlt⟩).2.2, ?_⟩
    rw [show m - 1 + 1 = m from by omega] at hstep
    exact hstep

/-! ## The two visits of a chord traverse their edge in opposite directions -/

/-- The colours of the *targets* of the visits of a face, in order: the vertex sequence of the walk
in `T` induced by the face. -/
private def visitTgts (c : G) (w : List (Fin P.n × Bool)) : List V :=
  (faceTriples D c w).map (fun t => colour D t.2.2)

/-- The `k`-th entry of the walk `visitTgts`. -/
private theorem visitTgts_getElem (c : G) (w : List (Fin P.n × Bool)) {k : ℕ}
    (hk : k < (faceTriples D c w).length) :
    (visitTgts (D := D) c w)[k]? = some (colour D (faceTriples D c w)[k].2.2) := by
  unfold visitTgts
  rw [List.getElem?_map, List.getElem?_eq_getElem hk]
  rfl

/-- Each entry of `faceTriples` records a genuine edge of `T`: the two old vertices on either side
of the visit have adjacent colours, and the `Sym2`-pair of those colours is the visit's label. -/
private theorem faceTriples_good' (c : G) (w : List (Fin P.n × Bool)) :
    ∀ (k : ℕ) (a : BaseV D) (m : MidV D) (b : BaseV D),
      (faceTriples D c w)[k]? = some (a, m, b) →
        T.graph.Adj (colour D a) (colour D b) ∧ s(colour D a, colour D b) = m.label := by
  intro k a m b h
  obtain ⟨-, -, hsym⟩ := faceTriples_arcIndex c w h
  have h1 : s(colour D a, colour D b) = m.label := by
    rcases Sym2.eq_iff.mp hsym with hc | hc
    · rw [hc.1, hc.2]; exact (MidV.label_eq_colour m).symm
    · rw [hc.1, hc.2, Sym2.eq_swap]; exact (MidV.label_eq_colour m).symm
  refine ⟨?_, h1⟩
  have hmem : m.label ∈ T.graph.edgeSet := by
    have h2 := Cell.label_mem_edgeSet (D := D) (MidV.cell m)
    rwa [Cell.label_eq_MidV_label, MidV.cell_mid] at h2
  rw [← h1] at hmem
  exact (SimpleGraph.mem_edgeSet T.graph).mp hmem

/-- **The crux: the two visits of a chord traverse their edge in opposite directions.**  If the
visits at positions `p < q` label the same edge of `T`, and no visit strictly between them does,
then the walk in `T` from the target of the `p`-th visit to the source of the `q`-th visit avoids
that edge; since an edge of a forest is a bridge, it cannot cross from one side of the edge to the
other, so the walk is still at the endpoint at which the `p`-th visit arrived.  Hence

* `colour bp = colour uq` (the target of the `p`-th visit is the source of the `q`-th visit), and,
  since the two visits traverse the *same* edge, also
* `colour a = colour vq` (the source of the `p`-th visit is the target of the `q`-th visit). -/
private theorem triples_crux_pair (c : G) (w : List (Fin P.n × Bool))
    (hcolshare : ∀ (k : ℕ) (a : BaseV D) (m : MidV D) (b : BaseV D)
      (a' : BaseV D) (m' : MidV D) (b' : BaseV D),
      (faceTriples D c w)[k]? = some (a, m, b) →
        (faceTriples D c w)[k + 1]? = some (a', m', b') → colour D b = colour D a')
    {p q : ℕ} {a bp uq vq : BaseV D} {mp mq : MidV D}
    (hp : (faceTriples D c w)[p]? = some (a, mp, bp))
    (hq : (faceTriples D c w)[q]? = some (uq, mq, vq))
    (hlabel : mp.label = mq.label) (hpq : p < q)
    (havoid : ∀ (r : ℕ) (a'' : BaseV D) (m'' : MidV D) (b'' : BaseV D),
      p < r → r < q → (faceTriples D c w)[r]? = some (a'', m'', b'') → m''.label ≠ mp.label) :
    colour D a = colour D vq ∧ colour D bp = colour D uq := by
  classical
  obtain ⟨hg1, hl1⟩ := faceTriples_good' c w p a mp bp hp
  obtain ⟨hg2, hl2⟩ := faceTriples_good' c w q uq mq vq hq
  obtain ⟨hqlt, -⟩ := List.getElem?_eq_some_iff.mp hq
  -- The walk in `T` from the target of the `p`-th visit to the source of the `q`-th visit.
  have hbc : colour D bp = colour D uq := by
    have hwalk : (visitTgts (D := D) c w).IsChain (fun x y => x = y ∨ T.graph.Adj x y) := by
      unfold visitTgts
      rw [List.isChain_map, List.isChain_iff_getElem]
      intro i hi
      have hi1 : i < (faceTriples D c w).length := by omega
      have hcs : colour D (faceTriples D c w)[i].2.2 = colour D (faceTriples D c w)[i+1].1 :=
        hcolshare i (faceTriples D c w)[i].1 (faceTriples D c w)[i].2.1
          (faceTriples D c w)[i].2.2 (faceTriples D c w)[i+1].1 (faceTriples D c w)[i+1].2.1
          (faceTriples D c w)[i+1].2.2
          (by rw [List.getElem?_eq_getElem hi1])
          (by rw [List.getElem?_eq_getElem hi])
      have hg : T.graph.Adj (colour D (faceTriples D c w)[i+1].1)
          (colour D (faceTriples D c w)[i+1].2.2) :=
        (faceTriples_good' c w (i+1) (faceTriples D c w)[i+1].1
          (faceTriples D c w)[i+1].2.1 (faceTriples D c w)[i+1].2.2
          (by rw [List.getElem?_eq_getElem hi])).1
      rw [hcs]
      exact Or.inr hg
    have hchain : ((visitTgts (D := D) c w).drop p |>.take (q - p)).IsChain
        (fun x y => x = y ∨ T.graph.Adj x y) := (hwalk.drop p).take (q - p)
    have heq : s(colour D a, colour D bp) = s(colour D uq, colour D vq) := by
      calc s(colour D a, colour D bp) = mp.label := hl1
        _ = mq.label := hlabel
        _ = s(colour D uq, colour D vq) := hl2.symm
    have hhead : ((visitTgts (D := D) c w).drop p |>.take (q - p)).head? =
        some (colour D bp) := by
      rw [List.head?_take, if_neg (by omega : ¬ (q - p = 0)), List.head?_drop]
      unfold visitTgts
      rw [List.getElem?_map, hp]
      rfl
    have hlast : ((visitTgts (D := D) c w).drop p |>.take (q - p)).getLast? =
        some (colour D uq) := by
      have hmid : (visitTgts (D := D) c w)[q - 1]? = some (colour D uq) := by
        rw [visitTgts_getElem c w (by omega : q - 1 < (faceTriples D c w).length)]
        congr 1
        have hcs : colour D (faceTriples D c w)[q - 1].2.2 = colour D uq :=
          hcolshare (q - 1) (faceTriples D c w)[q - 1].1 (faceTriples D c w)[q - 1].2.1
            (faceTriples D c w)[q - 1].2.2 uq mq vq
            (by rw [List.getElem?_eq_getElem (by omega : q - 1 < (faceTriples D c w).length)])
            (by rw [show q - 1 + 1 = q from by omega]; exact hq)
        exact hcs
      rw [List.getLast?_take, if_neg (by omega : ¬ (q - p = 0)), List.getElem?_drop]
      rw [show p + (q - p - 1) = q - 1 from by omega]
      rw [hmid, Option.some_or]
    have havoid' : ∀ (i : ℕ) (x y : V),
        ((visitTgts (D := D) c w).drop p |>.take (q - p))[i]? = some x →
        ((visitTgts (D := D) c w).drop p |>.take (q - p))[i + 1]? = some y → x ≠ y →
        s(x, y) ≠ s(colour D a, colour D bp) := by
      intro i x y hx hy _
      have hi : i < q - p := by
        by_contra hcon
        rw [List.getElem?_take, if_neg hcon] at hx
        exact absurd hx (by simp)
      have hi1 : i + 1 < q - p := by
        by_contra hcon
        rw [List.getElem?_take, if_neg hcon] at hy
        exact absurd hy (by simp)
      have hb1 : p + i < (faceTriples D c w).length := by omega
      have hb2 : p + i + 1 < (faceTriples D c w).length := by omega
      rw [List.getElem?_take, if_pos hi, List.getElem?_drop] at hx
      rw [List.getElem?_take, if_pos hi1, List.getElem?_drop] at hy
      rw [show p + (i + 1) = p + i + 1 from by omega] at hy
      rw [visitTgts_getElem c w (k := p + i) hb1] at hx
      rw [visitTgts_getElem c w (k := p + i + 1) hb2] at hy
      have hx' : colour D (faceTriples D c w)[p + i].2.2 = x := Option.some.inj hx
      have hy' : colour D (faceTriples D c w)[p + i + 1].2.2 = y := Option.some.inj hy
      rw [← hx', ← hy']
      have hcs : colour D (faceTriples D c w)[p + i].2.2 =
          colour D (faceTriples D c w)[p + i + 1].1 :=
        hcolshare (p + i) (faceTriples D c w)[p + i].1 (faceTriples D c w)[p + i].2.1
          (faceTriples D c w)[p + i].2.2 (faceTriples D c w)[p + i + 1].1
          (faceTriples D c w)[p + i + 1].2.1 (faceTriples D c w)[p + i + 1].2.2
          (by rw [List.getElem?_eq_getElem hb1])
          (by rw [List.getElem?_eq_getElem hb2])
      rw [hcs]
      intro hcontra
      have hgl : s(colour D (faceTriples D c w)[p + i + 1].1,
            colour D (faceTriples D c w)[p + i + 1].2.2) =
          (faceTriples D c w)[p + i + 1].2.1.label :=
        (faceTriples_good' c w (p + i + 1) (faceTriples D c w)[p + i + 1].1
          (faceTriples D c w)[p + i + 1].2.1 (faceTriples D c w)[p + i + 1].2.2
          (by rw [List.getElem?_eq_getElem hb2])).2
      rw [hgl, hl1] at hcontra
      exact havoid (p + i + 1) (faceTriples D c w)[p + i + 1].1 (faceTriples D c w)[p + i + 1].2.1
        (faceTriples D c w)[p + i + 1].2.2 (by omega) (by omega)
        (by rw [List.getElem?_eq_getElem hb2]) hcontra
    exact ChordWalk.cwc_chain_avoids_edge T.graph T.isTree.isAcyclic hg1 hg2 heq
      ((visitTgts (D := D) c w).drop p |>.take (q - p)) hchain hhead hlast havoid'
  -- The `p`-th visit leaves `colour bp = colour uq` and arrives at `colour a`; the `q`-th visit
  -- leaves `colour uq` and arrives at `colour vq`; since the two labels agree, the other two
  -- endpoints agree as well.
  refine ⟨?_, hbc⟩
  have hs : s(colour D a, colour D bp) = s(colour D bp, colour D vq) := by
    calc s(colour D a, colour D bp) = mp.label := hl1
      _ = mq.label := hlabel
      _ = s(colour D uq, colour D vq) := hl2.symm
      _ = s(colour D bp, colour D vq) := by rw [← hbc]
  rcases Sym2.eq_iff.mp hs with hcase | hcase
  · exact absurd (hcase.1 ▸ hg1) (T.adj_self (colour D bp))
  · exact hcase.1

/-- **The two arcs glued by a chord have the same colour.**  For a chord joining the visits at
positions `p < q` of the boundary walk of a face:

* the arc *ending* at the `p`-th visit and the arc *starting* at the `q`-th visit have the same
  colour (the first disjunct of `chordRel`);
* the arc *ending* at the `q`-th visit and the arc *starting* at the `p`-th visit have the same
  colour (the second disjunct of `chordRel`).

Both are stated with the two arc indices as hypotheses, so that any old vertices at those indices
qualify (`colour_arcIndex`). -/
theorem colour_of_chord_both (c : G) (w : List (Fin P.n × Bool)) {p q : ℕ}
    (h : (p, q) ∈ chords (faceVisits D c w)) :
    (∀ u v : BaseV D, (u, p) ∈ arcIndex (faceWalk D c w) →
        (v, q + 1) ∈ arcIndex (faceWalk D c w) → colour D u = colour D v) ∧
      (∀ u v : BaseV D, (u, q) ∈ arcIndex (faceWalk D c w) →
        (v, p + 1) ∈ arcIndex (faceWalk D c w) → colour D u = colour D v) := by
  obtain ⟨hp_lt, hq_lt⟩ := chords_mem_lt (D := D) h
  have hlen : (faceVisits D c w).length = (faceTriples D c w).length := by
    simp [faceVisits]
  rw [hlen] at hp_lt hq_lt
  have hp : (faceTriples D c w)[p]? = some ((faceTriples D c w)[p].1,
      (faceTriples D c w)[p].2.1, (faceTriples D c w)[p].2.2) :=
    List.getElem?_eq_getElem hp_lt
  have hq : (faceTriples D c w)[q]? = some ((faceTriples D c w)[q].1,
      (faceTriples D c w)[q].2.1, (faceTriples D c w)[q].2.2) :=
    List.getElem?_eq_getElem hq_lt
  have hpv : (faceVisits D c w)[p]? = some ((faceTriples D c w)[p]).2.1 := by
    rw [faceVisits, List.getElem?_map, hp]
    rfl
  have hqv : (faceVisits D c w)[q]? = some ((faceTriples D c w)[q]).2.1 := by
    rw [faceVisits, List.getElem?_map, hq]
    rfl
  have hlabel : ((faceTriples D c w)[p]).2.1.label = ((faceTriples D c w)[q]).2.1.label :=
    label_of_chord (D := D) h hpv hqv
  have havoid : ∀ (r : ℕ) (a'' : BaseV D) (m'' : MidV D) (b'' : BaseV D),
      p < r → r < q → (faceTriples D c w)[r]? = some (a'', m'', b'') →
        m''.label ≠ ((faceTriples D c w)[p]).2.1.label := by
    intro r a'' m'' b'' hpr hrq hr
    have hrv : (faceVisits D c w)[r]? = some m'' := by
      rw [faceVisits, List.getElem?_map, hr]
      rfl
    exact chords_avoid (D := D) h hpr hrq hrv hpv
  have hcrux := triples_crux_pair c w
    (fun k a m b a' m' b' h1 h2 => ChordWalk.cwc_faceTriples_colshare (D := D) c w h1 h2)
    hp hq hlabel (chords_lt_snd (D := D) h) havoid
  refine ⟨?_, ?_⟩
  · intro u v hu hv
    rw [colour_arcIndex c w hu (faceTriples_arcIndex c w hp).1,
      colour_arcIndex c w hv (faceTriples_arcIndex c w hq).2.1]
    exact hcrux.1
  · intro u v hu hv
    rw [colour_arcIndex c w hu (faceTriples_arcIndex c w hq).1,
      colour_arcIndex c w hv (faceTriples_arcIndex c w hp).2.1]
    exact hcrux.2.symm

/-! ## The colour is constant on the pieces of a face -/

/-- An arc index is *realised* by the boundary walk of the face when some old vertex of the walk
sits in the arc with that index. -/
def Realized (D : GeoData T t₀ P) (c : G) (w : List (Fin P.n × Bool)) (i : ℕ) : Prop :=
  ∃ u : BaseV D, (u, i) ∈ arcIndex (faceWalk D c w)

/-- **The colour is constant on the pieces of a face.**  This is the induction on the equivalence
closure generating `pieceRel`; the extra conjunct records, at every index occurring in the chain,
that some old vertex of the walk sits there, which is what transitivity needs. -/
private theorem colour_pieceRel_aux (c : G) (w : List (Fin P.n × Bool)) {i j : ℕ}
    (h : pieceRel (faceVisits D c w) i j) :
    (∀ u v : BaseV D, (u, i) ∈ arcIndex (faceWalk D c w) →
        (v, j) ∈ arcIndex (faceWalk D c w) → colour D u = colour D v) ∧
      (i = j ∨ (Realized D c w i ∧ Realized D c w j)) := by
  unfold pieceRel at h
  induction h with
  | rel i j hr =>
      refine ⟨?_, ?_⟩
      · intro u v hu hv
        obtain ⟨p, q, hpq, hij | hij⟩ := hr
        · rw [hij.1] at hu
          rw [hij.2] at hv
          exact (colour_of_chord_both (D := D) c w hpq).1 u v hu hv
        · rw [hij.1] at hu
          rw [hij.2] at hv
          exact (colour_of_chord_both (D := D) c w hpq).2 u v hu hv
      · obtain ⟨p, q, hpq, hij | hij⟩ := hr
        · obtain ⟨hp_lt, hq_lt⟩ := chords_mem_lt (D := D) hpq
          rw [hij.1, hij.2]
          exact Or.inr ⟨arcIndex_realized_of_le (D := D) c w (by omega),
            arcIndex_realized_of_le (D := D) c w (by omega)⟩
        · obtain ⟨hp_lt, hq_lt⟩ := chords_mem_lt (D := D) hpq
          rw [hij.1, hij.2]
          exact Or.inr ⟨arcIndex_realized_of_le (D := D) c w (by omega),
            arcIndex_realized_of_le (D := D) c w (by omega)⟩
  | refl i =>
      exact ⟨fun u v hu hv => colour_arcIndex c w hu hv, Or.inl rfl⟩
  | symm i j hij ih =>
      refine ⟨fun u v hu hv => (ih.1 v u hv hu).symm, ?_⟩
      rcases ih.2 with h' | ⟨hi, hj⟩
      · exact Or.inl h'.symm
      · exact Or.inr ⟨hj, hi⟩
  | trans i j k hij hjk ih1 ih2 =>
      obtain ⟨hc1, hr1⟩ := ih1
      obtain ⟨hc2, hr2⟩ := ih2
      refine ⟨?_, ?_⟩
      · intro u v hu hv
        rcases hr1 with hEq | ⟨rvi, rvj⟩
        · rw [hEq] at hu
          exact hc2 u v hu hv
        · rcases hr2 with hEq2 | ⟨rvj, rvk⟩
          · exact hc1 u v hu (by simpa [hEq2] using hv)
          · obtain ⟨mid, hmid⟩ := rvj
            exact (hc1 u mid hu hmid).trans (hc2 mid v hmid hv)
      · rcases hr1 with hEq | ⟨rvi, rvj⟩
        · rw [hEq]
          exact hr2
        · rcases hr2 with hEq2 | ⟨rvj, rvk⟩
          · exact Or.inr ⟨rvi, by simpa [hEq2] using rvj⟩
          · exact Or.inr ⟨rvi, rvk⟩

theorem colour_pieceRel {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
    {T : Work.ORDunwoody.GTree G V} {t₀ : V} {P : Work.ORDunwoody.FinPresentation G}
    {D : Work.ORDunwoody.Cayley.GeoData T t₀ P} (c : G) (w : List (Fin P.n × Bool))
    {i j : ℕ} (h : Work.ORDunwoody.Dunwoody.pieceRel
      (Work.ORDunwoody.Dunwoody.faceVisits D c w) i j)
    {u v : Work.ORDunwoody.Dunwoody.BaseV D}
    (hu : (u, i) ∈ Work.ORDunwoody.Dunwoody.arcIndex (Work.ORDunwoody.Dunwoody.faceWalk D c w))
    (hv : (v, j) ∈ Work.ORDunwoody.Dunwoody.arcIndex (Work.ORDunwoody.Dunwoody.faceWalk D c w)) :
    Work.ORDunwoody.Dunwoody.colour D u = Work.ORDunwoody.Dunwoody.colour D v := by
  exact (colour_pieceRel_aux (D := D) c w h).1 u v hu hv

end Work.ORDunwoody
