import Mathlib
import Submission.Work.ORDunwoody.Dunwoody.TrackWall
import Submission.Work.ORDunwoody.finite_orbits_vertex

/-!
# Finiteness of the region orbits of `Λ''` (node N13 of the ORDunwoody subproject)

The regions of the Dunwoody pattern (`Dunwoody/Region.lean`) are the classes of the old vertices
`BaseV D = G × BaseV₀ D` under the equivalence relation generated by `RegionRel`.  The action of
`G` on `Region D` (`TrackWall.instMulActionRegion`) is induced by left multiplication on the first
factor of `BaseV D`; consequently the orbit of a region `Region.mk D (g, x)` is the image of the
orbit of `(1, x)`, and the orbit quotient of `Region D` is a quotient of the *finite* type
`BaseV₀ D`.  Hence the action of `G` on the regions is cocompact, exactly as for the vertices
(`finite_orbits_vertex`).
-/

set_option autoImplicit false

universe u

namespace Work.ORDunwoody

open Work.ORDunwoody.Dunwoody

/-- Every orbit of regions contains the region of an old vertex of the form `(1, x)`, `x : BaseV₀ D`.
Hence the orbit quotient of the regions is a quotient of the finite type `BaseV₀ D`, so the action
of `G` on the regions of `Λ''` is cocompact. -/
theorem finite_orbits_region {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
    {T : Work.ORDunwoody.GTree G V} {t₀ : V} {P : Work.ORDunwoody.FinPresentation G}
    {D : Work.ORDunwoody.Cayley.GeoData T t₀ P} :
    Finite (MulAction.orbitRel.Quotient G (Work.ORDunwoody.Dunwoody.Region D)) := by
  -- The finite type that classifies the region orbits: the base point together with the interior
  -- points of the generator edges.
  refine Finite.of_surjective
    (fun x : BaseV₀ D =>
      (Quotient.mk (MulAction.orbitRel G (Region D)) (Region.mk D ((1 : G), x)) :
        MulAction.orbitRel.Quotient G (Region D))) ?_
  intro q
  refine Quotient.inductionOn q (fun R => ?_)
  refine Quotient.inductionOn R (fun u => ?_)
  -- The region of `(g, x)` is the translate by `g` of the region of `(1, x)`.
  refine ⟨u.2, ?_⟩
  apply Quotient.sound
  show (MulAction.orbitRel G (Region D))
    (Region.mk D ((1 : G), u.2)) (Region.mk D u)
  rw [MulAction.orbitRel_apply]
  refine MulAction.mem_orbit_iff.mpr ⟨u.1⁻¹, ?_⟩
  rw [Region.mk_smul]
  exact congrArg (Region.mk D) (by simp)

end Work.ORDunwoody
