/-!
# Finite generation of the stabilisers of the regions of the Dunwoody pattern

Node N13 of the `annals_on_coherence_of_one_relator_groups` project.  The regions of the
Dunwoody pattern `D` (`Dunwoody/Region.lean`) are the classes of the old vertices
`BaseV D = G × BaseV₀ D` of the subdivided Cayley complex `Λ''` under the equivalence relation
generated by `RegionRel D`.  The group `G = π₁(Λ'')` acts on `Region D`
(`Dunwoody/TrackWall.lean`); this file proves that the stabiliser in `G` of a region is finitely
generated, which is one of the two inputs of `S.HasFGStab` for Dunwoody's resolution
(`DESIGN_N13.md` §4d).

The argument is the one of `DESIGN_N13.md` §4d.  Let `R` be a region and `K ≤ G` its stabiliser.
Let `X` be the set of old vertices of `R`, i.e. the fibre of `Region.mk D` over `R`, and let the
region graph on `X` be the restriction of `regionGraph D` (the symmetrisation of `RegionRel D`)
to `X`.  Then

* `K` acts on `X` — by the action of `G` on the old vertices, which preserves the region `R`;
* this action preserves adjacency (`regionGraph_smul_adj`);
* the graph on `X` is connected: the classes of `Region` are exactly the connected components of
  the region graph (`regionGraph_reachable_of_mk_eq`), and a walk between two old vertices of `R`
  stays inside `R`;
* the action is free — the action of `G` on `Λ''` is free (`vertex_smul_eq_self`);
* the orbit quotient `X/K` is finite: it embeds into `BaseV/G`, and the latter is finite because
  `BaseV D = G × BaseV₀ D` with `BaseV₀ D` finite (`finite_orbits_baseV`);
* every old vertex has finitely many neighbours in the region graph
  (`regionGraph_neighbours_finite`, proved below from the collapsed generator edges, the finitely
  many relators and `faceWalk_smul`).

`Work.WallSystem.fg_of_free_cocompact_graph` — a group acting freely on a connected, locally
finite graph with finitely many orbits of vertices is finitely generated — then gives
`Group.FG K`, and `Group.fg_iff_subgroup_fg` turns this into `(MulAction.stabilizer G R).FG`.

**Note on the universe.**  The statement is used verbatim as it was requested; the only addition
is the line `universe u`.  With `autoImplicit = false` the level name `u` occurring in `Type u`
is otherwise unknown to the elaborator, so the statement as it stands does not even elaborate.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace Work.ORDunwoody

open Work.ORDunwoody.Cayley Work.ORDunwoody.Dunwoody

universe u

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

namespace FgRegionAux

/-! ## Two elementary finiteness lemmas about the walks of the pattern -/

/-- The set of elements of a list is finite. -/
theorem list_mem_finite {α : Type*} (l : List α) : {a : α | a ∈ l}.Finite := by
  induction l with
  | nil => simp
  | cons a t ih =>
      have h : ({b : α | b ∈ a :: t} : Set α) = insert a {b : α | b ∈ t} := by
        ext b
        simp [Set.mem_insert_iff]
      rw [h]
      exact ih.insert a

/-- The first component of an entry of `arcIndexAux` is one of the old vertices of the walk. -/
theorem arcIndexAux_mem_fst : ∀ (l : List (Vertex D)) (k : ℕ) (p : BaseV D × ℕ),
    p ∈ arcIndexAux l k → (Sum.inl p.1 : Vertex D) ∈ l := by
  intro l
  induction l with
  | nil => intro k p hp; exact (List.not_mem_nil hp).elim
  | cons v rest ih =>
      intro k p hp
      cases v with
      | inl u =>
          simp only [arcIndexAux_inl, List.mem_cons] at hp
          rcases hp with hp | hp
          · rw [hp]; simp
          · exact List.mem_cons_of_mem _ (ih k p hp)
      | inr m =>
          simp only [arcIndexAux_inr] at hp
          exact List.mem_cons_of_mem _ (ih (k + 1) p hp)

/-- The same for `arcIndex`. -/
theorem arcIndex_mem_fst {l : List (Vertex D)} {p : BaseV D × ℕ}
    (hp : p ∈ arcIndex l) : (Sum.inl p.1 : Vertex D) ∈ l :=
  arcIndexAux_mem_fst l 0 p hp

/-- For a fixed old vertex `u` and word `W`, only finitely many base points `c` have `u` on the
boundary walk of the face read from `c` with word `W`: by `faceWalk_smul`,
`faceWalk D c W = (faceWalk D 1 W).map (c • ·)`, so `u` occurs in the walk at `c` exactly when
`c⁻¹ • u` occurs in the fixed finite walk `faceWalk D 1 W`, and `c ↦ c⁻¹ • u` is injective. -/
theorem faceWalk_base_finite (u : BaseV D) (W : List (Fin P.n × Bool)) :
    {c : G | (Sum.inl u : Vertex D) ∈ faceWalk D c W}.Finite := by
  have hY : ({y : Vertex D | y ∈ faceWalk D 1 W} : Set (Vertex D)).Finite :=
    list_mem_finite _
  have hset : {c : G | (Sum.inl u : Vertex D) ∈ faceWalk D c W}
      = (fun c : G => c⁻¹ • (Sum.inl u : Vertex D))
        ⁻¹' {y : Vertex D | y ∈ faceWalk D 1 W} := by
    ext c
    simp only [Set.mem_ofPred_eq, Set.mem_preimage]
    have hsm : faceWalk D c W = (faceWalk D 1 W).map (fun v => c • v) := by
      simpa using Work.ORDunwoody.faceWalk_smul (D := D) c 1 W
    rw [hsm]
    constructor
    · intro h
      obtain ⟨y, hy, hyc⟩ := List.mem_map.mp h
      rw [← hyc, inv_smul_smul]
      exact hy
    · intro h
      exact List.mem_map.mpr ⟨c⁻¹ • (Sum.inl u : Vertex D), h, by rw [smul_inv_smul]⟩
  rw [hset]
  refine hY.preimage ?_
  intro a _ b _ hab
  change a⁻¹ • (Sum.inl u : Vertex D) = b⁻¹ • (Sum.inl u : Vertex D) at hab
  have h1 : (b * a⁻¹) • (Sum.inl u : Vertex D) = Sum.inl u := by
    rw [mul_smul, hab, smul_inv_smul]
  have h2 : b * a⁻¹ = 1 := vertex_smul_eq_self h1
  have h3 : b = a := by
    calc b = b * a⁻¹ * a := by group
      _ = 1 * a := by rw [h2]
      _ = a := by group
  exact h3.symm

/-! ## Local finiteness of the region graph -/

/-- **The region graph is locally finite.**  A fixed old vertex `u` has finitely many neighbours:
the collapsed generator edges contribute two images of the finite index set `Fin P.n`, and in the
face case the base point `c` of the face is one of the finitely many points of
`faceWalk_base_finite`, after which the other vertex of the pair is one of the finitely many
vertices of the boundary walk at `c`. -/
theorem regionGraph_neighbours_finite (u : BaseV D) :
    {w : BaseV D | (regionGraph D).Adj u w}.Finite := by
  classical
  -- the collapsed generator edges contribute two images of the finite index set `Fin P.n`
  have hcoll : {w : BaseV D | ∃ (a : G) (j : Fin P.n), D.L (j, true) = 0 ∧
      ((u = (a, Sum.inl ()) ∧ w = (a * CayV.genE P (j, true), Sum.inl ())) ∨
       (u = (a * CayV.genE P (j, true), Sum.inl ()) ∧ w = (a, Sum.inl ())))}.Finite := by
    have hb1 : ((fun j : Fin P.n =>
        (((u.1 * CayV.genE P (j, true)), Sum.inl ()) : BaseV D)) ''
        (Set.univ : Set (Fin P.n))).Finite :=
      Set.Finite.image _ (Set.finite_univ : (Set.univ : Set (Fin P.n)).Finite)
    have hb2 : ((fun j : Fin P.n =>
        (((u.1 * (CayV.genE P (j, true))⁻¹), Sum.inl ()) : BaseV D)) ''
        (Set.univ : Set (Fin P.n))).Finite :=
      Set.Finite.image _ (Set.finite_univ : (Set.univ : Set (Fin P.n)).Finite)
    refine (hb1.union hb2).subset ?_
    intro w hw
    obtain ⟨a, j, _hL, h1 | h1⟩ := hw
    · exact Or.inl ⟨j, Set.mem_univ _, by rw [h1.1, h1.2]⟩
    · refine Or.inr ⟨j, Set.mem_univ _, ?_⟩
      have hae : u.1 = a * CayV.genE P (j, true) := congrArg Prod.fst h1.1
      rw [h1.2]
      show (((u.1 * (CayV.genE P (j, true))⁻¹), Sum.inl ()) : BaseV D) = (a, Sum.inl ())
      rw [hae]
      simp [mul_assoc]
  -- the faces: finitely many relators, finitely many admissible base points per relator, and each
  -- boundary walk has finitely many vertices
  have hface : {w : BaseV D |
      ∃ (r : {r : FreeGroup (Fin P.n) // r ∈ P.rel}) (c : G) (i j : ℕ),
        (u, i) ∈ arcIndex (faceWalk D c (FreeGroup.toWord r.1)) ∧
        (w, j) ∈ arcIndex (faceWalk D c (FreeGroup.toWord r.1)) ∧
        pieceRel (faceVisits D c (FreeGroup.toWord r.1)) i j}.Finite := by
    have hbound : (⋃ r ∈ (↑P.rel : Set (FreeGroup (Fin P.n))),
        ⋃ c ∈ {c : G | (Sum.inl u : Vertex D) ∈ faceWalk D c (FreeGroup.toWord r)},
          {w : BaseV D | ∃ j : ℕ,
            (w, j) ∈ arcIndex (faceWalk D c (FreeGroup.toWord r))}).Finite :=
      (P.rel.finite_toSet).biUnion (fun r _ =>
        (faceWalk_base_finite (D := D) u (FreeGroup.toWord r)).biUnion (fun c _ =>
          (list_mem_finite ((arcIndex (faceWalk D c (FreeGroup.toWord r))).map Prod.fst)).subset
            (by
              intro w hw
              obtain ⟨j, hj⟩ := hw
              exact List.mem_map.mpr ⟨(w, j), hj, rfl⟩)))
    refine hbound.subset ?_
    intro w hw
    obtain ⟨r, c, i, j, hu, hwj, _hp⟩ := hw
    exact Set.mem_biUnion r.2 (Set.mem_biUnion (arcIndex_mem_fst hu) ⟨j, hwj⟩)
  -- a neighbour on either side is a neighbour in the relation
  refine (hcoll.union hface).subset ?_
  intro w hw
  rcases ((regionGraph_adj_iff (D := D)).mp hw).2 with h | h
  · exact h
  · exact RegionRel.symm h

/-- The region graph is equivariant under the action of `G`. -/
theorem regionGraph_smul_adj (g : G) {u w : BaseV D} (h : (regionGraph D).Adj u w) :
    (regionGraph D).Adj (g • u) (g • w) := by
  obtain ⟨hne, hrel⟩ := (regionGraph_adj_iff (D := D)).mp h
  refine (regionGraph_adj_iff (D := D)).mpr ⟨?_, ?_⟩
  · intro hc
    exact hne (by
      have := congrArg (fun z : BaseV D => g⁻¹ • z) hc
      simpa using this)
  · rcases hrel with hrel | hrel
    · exact Or.inl (Work.ORDunwoody.regionRel_smul g hrel)
    · exact Or.inr (Work.ORDunwoody.regionRel_smul g hrel)

end FgRegionAux

open FgRegionAux

/-! ## The stabiliser of a region -/

/-- **The stabiliser in `G` of a region of the Dunwoody pattern is finitely generated.** -/
theorem fg_stabilizer_region {G : Type u} [Group G] {V : Type u} [MulAction G V]
    [DecidableEq V]
    {T : Work.ORDunwoody.GTree G V} {t₀ : V} {P : Work.ORDunwoody.FinPresentation G}
    {D : Work.ORDunwoody.Cayley.GeoData T t₀ P}
    (R : Work.ORDunwoody.Dunwoody.Region D) :
    (MulAction.stabilizer G R).FG := by
  classical
  obtain ⟨u₀, hu₀⟩ := Quotient.exists_rep R
  -- the set of old vertices of the region `R`, and the stabiliser `K` of `R`
  let X : Type u := {u : BaseV D // Region.mk D u = R}
  let K : Subgroup G := MulAction.stabilizer G R
  haveI : Nonempty X := ⟨⟨u₀, hu₀⟩⟩
  -- the action of `K` on `X`
  have hKmem : ∀ (k : K) (u : X), Region.mk D ((k : G) • u.1) = R := by
    intro k u
    rw [← Region.mk_smul, u.2]
    exact MulAction.mem_stabilizer_iff.mp k.2
  letI : MulAction K X :=
    { smul := fun k u => ⟨(k : G) • u.1, hKmem k u⟩
      one_smul := fun u => Subtype.ext (one_smul G u.1)
      mul_smul := fun k l u => Subtype.ext (mul_smul (k : G) (l : G) u.1) }
  -- the region graph, restricted to the old vertices of `R`
  let Gr : SimpleGraph X := (regionGraph D).induce {u | Region.mk D u = R}
  -- the action preserves adjacency
  have hsmul : ∀ (k : K) ⦃x y : X⦄, Gr.Adj x y → Gr.Adj (k • x) (k • y) := by
    intro k x y h
    exact regionGraph_smul_adj (D := D) (k : G) h
  -- the region graph on the old vertices of `R` is connected
  have hconn : Gr.Connected := by
    have hpre : Gr.Preconnected := by
      intro x y
      have hxy : Region.mk D x.1 = Region.mk D y.1 := by rw [x.2, y.2]
      obtain ⟨w⟩ := Work.ORDunwoody.regionGraph_reachable_of_mk_eq (D := D) hxy
      have hget : ∀ i ≤ w.length, Region.mk D (w.getVert i) = R := by
        intro i
        induction i with
        | zero =>
            intro _
            rw [SimpleGraph.Walk.getVert_zero]
            exact x.2
        | succ n ih =>
            intro hn
            have hadj : (regionGraph D).Adj (w.getVert n) (w.getVert (n + 1)) :=
              w.adj_getVert_succ (by omega)
            rcases ((regionGraph_adj_iff (D := D)).mp hadj).2 with hrel | hrel
            · rw [← Region.mk_eq_mk hrel]
              exact ih (by omega)
            · rw [Region.mk_eq_mk hrel]
              exact ih (by omega)
      have hsupp : ∀ v ∈ w.support, v ∈ {u : BaseV D | Region.mk D u = R} := by
        intro v hv
        obtain ⟨i, hi, hle⟩ := SimpleGraph.Walk.mem_support_iff_exists_getVert.mp hv
        rw [← hi]
        exact hget i hle
      let w' : Gr.Walk ⟨x.1, hsupp x.1 w.start_mem_support⟩
          ⟨y.1, hsupp y.1 w.end_mem_support⟩ :=
        w.induce {u : BaseV D | Region.mk D u = R} hsupp
      exact ⟨w'.copy (Subtype.ext rfl) (Subtype.ext rfl)⟩
    exact { preconnected := hpre, nonempty := ⟨⟨u₀, hu₀⟩⟩ }
  -- `K` acts freely on `X`
  have hfree : ∀ (k : K) (x : X), k • x = x → k = 1 := by
    intro k x hk
    have h1 : (k : G) • x.1 = x.1 := congrArg (fun z : X => z.1) hk
    have h2 : (k : G) * x.1.1 = x.1.1 := congrArg Prod.fst h1
    refine Subtype.ext ?_
    calc (k : G) = (k : G) * x.1.1 * x.1.1⁻¹ := by group
      _ = x.1.1 * x.1.1⁻¹ := by rw [h2]
      _ = 1 := by group
  -- the orbit quotient `X / K` is finite: it injects into `BaseV / G`
  have hV : Finite (MulAction.orbitRel.Quotient K X) := by
    haveI : Finite (MulAction.orbitRel.Quotient G (BaseV D)) :=
      Work.ORDunwoody.finite_orbits_baseV (D := D)
    refine Finite.of_injective
      (Quotient.map (fun x : X => x.1) (by
        intro a b hab
        obtain ⟨k, hk⟩ := MulAction.mem_orbit_iff.mp (MulAction.orbitRel_apply.mp hab)
        show (MulAction.orbitRel G (BaseV D)) a.1 b.1
        exact MulAction.orbitRel_apply.mpr
          (MulAction.mem_orbit_iff.mpr ⟨(k : G), by rw [← hk]; rfl⟩))) ?_
    intro a b
    refine Quotient.inductionOn₂ a b ?_
    intro x y hxy
    simp only [Quotient.map_mk] at hxy
    have h1 : (MulAction.orbitRel G (BaseV D)) x.1 y.1 := Quotient.exact hxy
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp (MulAction.orbitRel_apply.mp h1)
    have hgR : g • R = R := by
      calc g • R = g • Region.mk D y.1 := (congrArg (fun z => g • z) y.2).symm
        _ = Region.mk D (g • y.1) := Region.mk_smul g y.1
        _ = Region.mk D x.1 := by rw [hg]
        _ = R := x.2
    apply Quotient.sound
    show (MulAction.orbitRel K X) x y
    exact MulAction.orbitRel_apply.mpr
      (MulAction.mem_orbit_iff.mpr ⟨(⟨g, hgR⟩ : K), Subtype.ext hg⟩)
  -- the region graph is locally finite
  have hloc : ∀ x : X, {y : X | Gr.Adj x y}.Finite := by
    intro x
    have hfin : {v : BaseV D | (regionGraph D).Adj x.1 v}.Finite :=
      regionGraph_neighbours_finite x.1
    have hinj : Set.InjOn (Subtype.val : X → BaseV D)
        (Subtype.val ⁻¹' {v : BaseV D | (regionGraph D).Adj x.1 v}) :=
      fun a _ b _ hab => Subtype.ext hab
    refine Set.Finite.subset (hfin.preimage hinj) ?_
    intro y hy
    exact hy
  -- assemble
  haveI hfg : Group.FG K :=
    Work.WallSystem.fg_of_free_cocompact_graph (X := X) Gr hsmul hconn hfree hV hloc
  exact (Group.fg_iff_subgroup_fg (MulAction.stabilizer G R)).mp hfg

end Work.ORDunwoody
