Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# The regions of the Dunwoody pattern

The pattern of the construction is

    τ = (mid-vertices of Λ'') ∪ (the chords of the faces);

the **regions** are the connected components of `Λ'' ∖ τ`.  `Dunwoody/Piece.lean` provides the
pieces of each face; this file assembles them into the region structure:

* `RegionRel`: two old vertices are directly related when they are joined by a collapsed
  generator edge (an edge of `Λ''` that avoids the pattern), or when they occur in a common face
  and their arc indices lie in a common piece of that face;
* `regionGraph` (its symmetrisation, as a `SimpleGraph`) and `Region`, the quotient of the old
  vertices by the equivalence relation generated by `RegionRel`.

That the classes of `Region` are exactly the connected components of `Λ'' ∖ τ` is a theorem to be
proved later (it uses that every face-piece is connected and that `RegionRel` records exactly the
gluing of the pieces along the 1-skeleton).  What the construction uses is only:

* the `G`-action on `Region` (for which `RegionRel` must be `G`-invariant:
  `Work.ORDunwoody.faceWalk_smul` and the equivariance of `arcIndex`/`pieceRel`);
* the **colour** `Region → V(T)` (for which the two colour lemmas of `DESIGN_N13.md` §2c are
  needed: `colour` is constant on an arc and on a piece).
-/
import Mathlib
import Submission.Work.ORDunwoody.Dunwoody.Piece

set_option autoImplicit false
set_option linter.unusedVariables false

universe u

namespace Work.ORDunwoody.Dunwoody

open Work.ORDunwoody.Cayley

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

/-- Two old vertices of `Λ''` are **directly related** when they are the two ends of a collapsed
generator edge, or when they occur in a common face of `Λ''` and their arc indices lie in a
common piece of that face. -/
def RegionRel (D : GeoData T t₀ P) (u w : BaseV D) : Prop :=
  (∃ (a : G) (j : Fin P.n), D.L (j, true) = 0 ∧
      ((u = (a, Sum.inl ()) ∧ w = (a * CayV.genE P (j, true), Sum.inl ())) ∨
       (u = (a * CayV.genE P (j, true), Sum.inl ()) ∧ w = (a, Sum.inl ()))))
  ∨ (∃ (r : {r : FreeGroup (Fin P.n) // r ∈ P.rel}) (c : G) (i j : ℕ),
      (u, i) ∈ arcIndex (faceWalk D c (FreeGroup.toWord r.1)) ∧
      (w, j) ∈ arcIndex (faceWalk D c (FreeGroup.toWord r.1)) ∧
      pieceRel (faceVisits D c (FreeGroup.toWord r.1)) i j)

theorem RegionRel.symm {u w : BaseV D} (h : RegionRel D u w) : RegionRel D w u := by
  rcases h with ⟨a, j, hL, h1 | h1⟩ | ⟨r, c, i, j, hu, hw, hp⟩
  · exact Or.inl ⟨a, j, hL, Or.inr ⟨h1.2, h1.1⟩⟩
  · exact Or.inl ⟨a, j, hL, Or.inl ⟨h1.2, h1.1⟩⟩
  · exact Or.inr ⟨r, c, j, i, hw, hu, pieceRel.symm hp⟩

/-- The **region graph** of the pattern: the symmetrised relation `RegionRel`. -/
def regionGraph (D : GeoData T t₀ P) : SimpleGraph (BaseV D) :=
  SimpleGraph.fromRel (RegionRel D)

theorem regionGraph_adj_iff {u w : BaseV D} :
    (regionGraph D).Adj u w ↔ u ≠ w ∧ (RegionRel D u w ∨ RegionRel D w u) :=
  SimpleGraph.fromRel_adj (RegionRel D) u w

/-- **The regions of the pattern**: the equivalence classes of the old vertices of `Λ''` under the
relation generated by the gluing of the pieces. -/
def Region (D : GeoData T t₀ P) : Type u :=
  Quotient (Relation.EqvGen.setoid (RegionRel D))

/-- The region of an old vertex. -/
def Region.mk (D : GeoData T t₀ P) (u : BaseV D) : Region D := Quotient.mk _ u

theorem Region.mk_eq_mk {u w : BaseV D} (h : RegionRel D u w) : Region.mk D u = Region.mk D w :=
  Quotient.sound (Relation.EqvGen.rel _ _ h)

theorem Region.mk_eq_iff {u w : BaseV D} :
    Region.mk D u = Region.mk D w ↔ Relation.EqvGen (RegionRel D) u w :=
  Quotient.eq''

end Work.ORDunwoody.Dunwoody
