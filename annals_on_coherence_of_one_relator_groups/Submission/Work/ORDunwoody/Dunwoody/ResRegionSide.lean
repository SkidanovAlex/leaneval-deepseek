import Submission.Work.ORDunwoody.Chords.Basic
import Submission.Work.ORDunwoody.ChordWalk.cwc_pairUp_spec
import Submission.Work.ORDunwoody.ChordWalk.cwc_chords_positions
import Submission.Work.ORDunwoody.ChordWalk.cwc_positionsOfLabel_pairwise

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORDunwoody.Dunwoody

open Work.ORDunwoody.Cayley
open scoped Sym2

attribute [local instance] Classical.propDecidable

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

/-! ## The recurrence and the interval formula for `midSum` -/

/-- Appending one visit to the visited prefix adds its indicator. -/
theorem resMidSum_succ (τ : Track D) (m : MidV D) (ms : List (MidV D)) (n : ℕ) :
    midSum τ (m :: ms) (n + 1) = midInd τ m + midSum τ ms n := by
  simp only [midSum, List.take_succ_cons, List.map_cons, List.sum_cons, midInd_eq_ite]

@[simp] theorem resMidIndTop_nil (τ : Track D) (i : ℕ) :
    Work.ORDunwoody.midInd τ ([] : List (MidV D)) i = 0 := by
  simp [Work.ORDunwoody.midInd]

@[simp] theorem resMidIndTop_cons_zero (τ : Track D) (m : MidV D) (ms : List (MidV D)) :
    Work.ORDunwoody.midInd τ (m :: ms) 0 = (if trackOf m = τ then 1 else 0) := by
  simp [Work.ORDunwoody.midInd]

@[simp] theorem resMidIndTop_cons_succ (τ : Track D) (m : MidV D) (ms : List (MidV D)) (n : ℕ) :
    Work.ORDunwoody.midInd τ (m :: ms) (n + 1) = Work.ORDunwoody.midInd τ ms n := by
  simp [Work.ORDunwoody.midInd]

/-- The recurrence of `midSum` in terms of the position indicator. -/
theorem resMidSum_succ_midInd (τ : Track D) (vs : List (MidV D)) (n : ℕ) :
    midSum τ vs (n + 1) = midSum τ vs n + Work.ORDunwoody.midInd τ vs n := by
  induction vs generalizing n with
  | nil => simp [midSum]
  | cons m ms ih =>
      cases n with
      | zero => simp [midSum, resMidSum_succ, resMidIndTop_cons_zero]
      | succ k =>
          rw [resMidSum_succ, ih k, resMidSum_succ, resMidIndTop_cons_succ]
          abel

/-- `midSum` is the sum of the position indicators. -/
theorem resMidSum_eq_sum_range (τ : Track D) (vs : List (MidV D)) (k : ℕ) :
    midSum τ vs k = ∑ i ∈ Finset.range k, Work.ORDunwoody.midInd τ vs i := by
  induction k with
  | zero => simp
  | succ n ih => rw [resMidSum_succ_midInd τ vs n, ih, Finset.sum_range_succ]

/-- **`midSum` as a sum over an interval of positions.** -/
theorem resMidSum_Ico (τ : Track D) (vs : List (MidV D)) {a b : ℕ} (hab : a ≤ b) :
    midSum τ vs b = midSum τ vs a +
      ∑ i ∈ Finset.Ico a b, Work.ORDunwoody.midInd τ vs i := by
  have h : Finset.range b = Finset.range a ∪ Finset.Ico a b := by
    ext x
    simp only [Finset.mem_range, Finset.mem_union, Finset.mem_Ico]
    omega
  have hd : Disjoint (Finset.range a) (Finset.Ico a b) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    rw [Finset.mem_range] at hx
    rw [Finset.mem_Ico] at hx'
    exact not_le_of_gt hx hx'.1
  rw [resMidSum_eq_sum_range τ vs b, resMidSum_eq_sum_range τ vs a, h, Finset.sum_union hd]

/-! ## The indicator of a position -/

/-- No position is chorded with itself. -/
theorem resIsChord_irrefl (l : List (MidV D)) (t : ℕ) : ¬ IsChord l t t := by
  intro h
  rcases h with h | h
  · exact absurd (ChordWalk.cwc_chords_positions (D := D) h).1 (lt_irrefl t)
  · exact absurd (ChordWalk.cwc_chords_positions (D := D) h).1 (lt_irrefl t)

/-- The indicator of a position, unwound at a known visit. -/
theorem resMidIndTop_eq_ite (τ : Track D) {l : List (MidV D)} {t : ℕ} {m : MidV D}
    (h : l[t]? = some m) :
    Work.ORDunwoody.midInd τ l t = if trackOf m = τ then 1 else 0 := by
  simp only [Work.ORDunwoody.midInd, h]

/-- The indicator of a position depends only on the track of the visit at that position. -/
theorem resMidIndTop_congr (τ : Track D) {l : List (MidV D)} {t u : ℕ}
    (ht : t < l.length) (hu : u < l.length)
    (h : trackOf (l[t]'ht) = trackOf (l[u]'hu)) :
    Work.ORDunwoody.midInd τ l t = Work.ORDunwoody.midInd τ l u := by
  rw [resMidIndTop_eq_ite τ (List.getElem?_eq_getElem ht),
    resMidIndTop_eq_ite τ (List.getElem?_eq_getElem hu), h]

/-- The two visits of a chord of a face lie in one track. -/
theorem resChord_midInd (τ : Track D) (r : {r : FreeGroup (Fin P.n) // r ∈ P.rel}) (c : G)
    {t u : ℕ} (h : IsChord (faceVisits D c (FreeGroup.toWord r.1)) t u) :
    Work.ORDunwoody.midInd τ (faceVisits D c (FreeGroup.toWord r.1)) t =
      Work.ORDunwoody.midInd τ (faceVisits D c (FreeGroup.toWord r.1)) u := by
  rcases h with h | h
  · obtain ⟨-, ht, hu, -, -, -, -⟩ := ChordWalk.cwc_chords_positions (D := D) h
    exact resMidIndTop_congr τ ht hu
      (trackOf_eq_of_chord r c h (List.getElem?_eq_getElem ht) (List.getElem?_eq_getElem hu))
  · obtain ⟨-, hu, ht, -, -, -, -⟩ := ChordWalk.cwc_chords_positions (D := D) h
    exact resMidIndTop_congr τ ht hu
      (trackOf_eq_of_chord r c h (List.getElem?_eq_getElem hu)
        (List.getElem?_eq_getElem ht)).symm

/-! ## The sum over the interval between the ends of a chord vanishes -/

/-- **The core computation**: for a chord `(p, q)` whose matching is nested with unique partners
and no self-chords, and whose ends lie in one track, the track indicators sum to `0` over both the
closed interval `[p, q]` and the open interval `(p, q)`. -/
theorem resMidSum_chord_aux (τ : Track D) {l : List (MidV D)} {p q : ℕ} (hpq : p < q)
    (hnested : ∀ t, p < t → t < q → ∃ t', p < t' ∧ t' < q ∧ IsChord l t t')
    (hunique : ∀ t u v, IsChord l t u → IsChord l t v → u = v)
    (hirrefl : ∀ t, ¬ IsChord l t t)
    (hinv : ∀ t u, IsChord l t u →
      Work.ORDunwoody.midInd τ l t = Work.ORDunwoody.midInd τ l u)
    (hchord : IsChord l p q) :
    midSum τ l p = midSum τ l (q + 1) ∧ midSum τ l q = midSum τ l (p + 1) := by
  have hz1 : ∑ t ∈ Finset.Ico p (q + 1), Work.ORDunwoody.midInd τ l t = 0 := by
    refine sum_eq_zero_of_partner (fun a b h => h.symm) hirrefl hunique hinv _ ?_
    intro t ht
    rw [Finset.mem_Ico] at ht
    obtain ⟨hpt, htq⟩ := ht
    rcases lt_or_eq_of_le hpt with hplt | rfl
    · rcases lt_or_eq_of_le (show t ≤ q by omega) with htlt | rfl
      · obtain ⟨t', h1, h2, hch⟩ := hnested t hplt htlt
        exact ⟨t', by rw [Finset.mem_Ico]; omega, hch⟩
      · exact ⟨p, by rw [Finset.mem_Ico]; omega, hchord.symm⟩
    · exact ⟨q, by rw [Finset.mem_Ico]; omega, hchord⟩
  have hz2 : ∑ t ∈ Finset.Ico (p + 1) q, Work.ORDunwoody.midInd τ l t = 0 := by
    refine sum_eq_zero_of_partner (fun a b h => h.symm) hirrefl hunique hinv _ ?_
    intro t ht
    rw [Finset.mem_Ico] at ht
    obtain ⟨hpt, htq⟩ := ht
    obtain ⟨t', h1, h2, hch⟩ := hnested t (by omega) htq
    exact ⟨t', by rw [Finset.mem_Ico]; omega, hch⟩
  constructor
  · have h1 := resMidSum_Ico (D := D) τ l (show p ≤ q + 1 by omega)
    rw [hz1, add_zero] at h1
    exact h1.symm
  · have h1 := resMidSum_Ico (D := D) τ l (show p + 1 ≤ q by omega)
    rw [hz2, add_zero] at h1
    exact h1

/-! ## `midSum` is invariant on the pieces of a face -/

/-- The two ends of a chord are increasing. -/
theorem resChords_lt {l : List (MidV D)} {p q : ℕ} (h : (p, q) ∈ chords l) : p < q := by
  rw [chords, List.mem_flatMap] at h
  obtain ⟨e, -, hpq⟩ := h
  exact (ChordWalk.cwc_pairUp_spec
    (ChordWalk.cwc_positionsOfLabel_pairwise (D := D) (l := l) (e := e)) hpq).1

/-- `midSum` is unchanged across the chord of a face. -/
theorem resMidSum_eq_of_chordRel (τ : Track D) (r : {r // r ∈ P.rel}) (c : G) {p q : ℕ}
    (hpq : (p, q) ∈ chords (faceVisits D c (FreeGroup.toWord r.1))) :
    midSum τ (faceVisits D c (FreeGroup.toWord r.1)) p =
      midSum τ (faceVisits D c (FreeGroup.toWord r.1)) (q + 1) :=
  (resMidSum_chord_aux τ (resChords_lt hpq)
    (fun t h1 h2 => chords_nested_face (D := D) r c hpq (resChords_lt hpq) h1 h2)
    (fun t u v h1 h2 => isChord_unique h1 h2)
    (fun t => resIsChord_irrefl _ t)
    (fun t u h => resChord_midInd τ r c h)
    (Or.inl hpq)).1

/-- `midSum` is unchanged across the reversed chord of a face. -/
theorem resMidSum_eq_of_chordRel' (τ : Track D) (r : {r // r ∈ P.rel}) (c : G) {p q : ℕ}
    (hpq : (p, q) ∈ chords (faceVisits D c (FreeGroup.toWord r.1))) :
    midSum τ (faceVisits D c (FreeGroup.toWord r.1)) q =
      midSum τ (faceVisits D c (FreeGroup.toWord r.1)) (p + 1) :=
  (resMidSum_chord_aux τ (resChords_lt hpq)
    (fun t h1 h2 => chords_nested_face (D := D) r c hpq (resChords_lt hpq) h1 h2)
    (fun t u v h1 h2 => isChord_unique h1 h2)
    (fun t => resIsChord_irrefl _ t)
    (fun t u h => resChord_midInd τ r c h)
    (Or.inl hpq)).2

/-- `midSum` is invariant on the generators of `pieceRel`. -/
theorem resMidSum_eq_of_chordRel_gen (τ : Track D) (r : {r // r ∈ P.rel}) (c : G) {i j : ℕ}
    (h : chordRel (faceVisits D c (FreeGroup.toWord r.1)) i j) :
    midSum τ (faceVisits D c (FreeGroup.toWord r.1)) i =
      midSum τ (faceVisits D c (FreeGroup.toWord r.1)) j := by
  obtain ⟨p, q, hpq, h' | h'⟩ := h
  · obtain ⟨rfl, rfl⟩ := h'
    exact resMidSum_eq_of_chordRel τ r c hpq
  · obtain ⟨rfl, rfl⟩ := h'
    exact resMidSum_eq_of_chordRel' τ r c hpq

/-- **`midSum` is invariant on the pieces of a face.** -/
theorem resMidSum_eq_of_pieceRel (τ : Track D) (r : {r // r ∈ P.rel}) (c : G) {i j : ℕ}
    (h : pieceRel (faceVisits D c (FreeGroup.toWord r.1)) i j) :
    midSum τ (faceVisits D c (FreeGroup.toWord r.1)) i =
      midSum τ (faceVisits D c (FreeGroup.toWord r.1)) j := by
  induction h with
  | rel a b hab => exact resMidSum_eq_of_chordRel_gen τ r c hab
  | refl => rfl
  | symm a b hab ih => exact ih.symm
  | trans a b c hab hbc ih1 ih2 => exact ih1.trans ih2

/-! ## The side function is constant on the regions -/

/-- **The side function is constant on the generators of `RegionRel`.** -/
theorem resSideV_eq_of_regionRel (τ : Track D) {u w : BaseV D} (h : RegionRel D u w) :
    sideV τ u = sideV τ w := by
  rcases h with ⟨a, j, hL, h1 | h1⟩ | ⟨r, c, i, j, hu, hw, hp⟩
  · rw [h1.1, h1.2]
    exact sideV_plain τ a j hL
  · rw [h1.1, h1.2]
    exact (sideV_plain τ a j hL).symm
  · rw [arcIndex_sideV τ c (FreeGroup.toWord r.1) hu,
      arcIndex_sideV τ c (FreeGroup.toWord r.1) hw, resMidSum_eq_of_pieceRel τ r c hp]

/-- **The side function is constant on the classes of `RegionRel`.** -/
theorem resSideV_eq_of_eqvGen (τ : Track D) {u w : BaseV D}
    (h : Relation.EqvGen (RegionRel D) u w) : sideV τ u = sideV τ w := by
  induction h with
  | rel a b hab => exact resSideV_eq_of_regionRel τ hab
  | refl => rfl
  | symm a b hab ih => exact ih.symm
  | trans a b c hab hbc ih1 ih2 => exact ih1.trans ih2

/-- **The counting side function on the regions of the pattern.** -/
noncomputable def resSideOfRegion (τ : Track D) : Region D → ZMod 2 :=
  Quotient.lift (sideV τ) fun _ _ h => resSideV_eq_of_eqvGen τ h

@[simp] theorem resSideOfRegion_mk (τ : Track D) (u : BaseV D) :
    resSideOfRegion τ (Region.mk D u) = sideV τ u := rfl

/-- A pattern point of a track has the track as its track. -/
theorem resExists_track_point (τ : Track D) : ∃ m : MidV D, trackOf m = τ := by
  obtain ⟨m, hm⟩ := Quot.exists_rep τ
  exact ⟨m, hm⟩

/-- On the two ends of the cell of a pattern point, the side function differs exactly by the
indicator of the point lying in the track. -/
theorem resSideOfRegion_cell (τ : Track D) (m : MidV D) :
    resSideOfRegion τ (Region.mk D (MidV.src m)) +
      resSideOfRegion τ (Region.mk D (MidV.tgt m)) = midInd τ m :=
  sideV_cell τ m

/-- **The two regions on the two sides of a track have opposite sides.** -/
theorem resSideOfRegion_ne_of_inc {τ : Track D} {R R' : Region D} (h : τ.Inc R R') :
    resSideOfRegion τ R ≠ resSideOfRegion τ R' := by
  obtain ⟨m, hm⟩ := resExists_track_point τ
  have hreg : s(R, R') = s(Region.mk D m.src, Region.mk D m.tgt) := by
    rw [show s(R, R') = τ.regPair from h.symm, ← hm]
    exact Track.regPair_trackOf m
  have hsum : resSideOfRegion τ R + resSideOfRegion τ R' = 1 := by
    rcases Sym2.eq_iff.mp hreg with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [h1, h2, resSideOfRegion_cell τ m, ← hm, midInd_eq_ite, if_pos rfl]
    · rw [h1, h2, add_comm, resSideOfRegion_cell τ m, ← hm, midInd_eq_ite, if_pos rfl]
  intro hc
  rw [hc, CharTwo.add_self_eq_zero] at hsum
  exact one_ne_zero hsum.symm

/-- **A track different from a given one does not separate the two regions adjacent to it.** -/
theorem resSideOfRegion_eq_of_inc_of_ne {τ τ' : Track D} {R R' : Region D}
    (h : τ.Inc R R') (hne : τ ≠ τ') : resSideOfRegion τ' R = resSideOfRegion τ' R' := by
  obtain ⟨m, hm⟩ := resExists_track_point τ
  have hreg : s(R, R') = s(Region.mk D m.src, Region.mk D m.tgt) := by
    rw [show s(R, R') = τ.regPair from h.symm, ← hm]
    exact Track.regPair_trackOf m
  have hsum : resSideOfRegion τ' R + resSideOfRegion τ' R' = 0 := by
    rcases Sym2.eq_iff.mp hreg with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [h1, h2, resSideOfRegion_cell τ' m, midInd_eq_ite,
        if_neg (fun hc => hne (hm.symm.trans hc))]
    · rw [h1, h2, add_comm, resSideOfRegion_cell τ' m, midInd_eq_ite,
        if_neg (fun hc => hne (hm.symm.trans hc))]
  have := eq_neg_of_add_eq_zero_left hsum
  rwa [CharTwo.neg_eq] at this

end Work.ORDunwoody.Dunwoody
