Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# The arcs and the pieces of the Dunwoody pattern

`Dunwoody/Chord.lean` defines the chords of a face.  This file adds the two ingredients that
turn the chords into the region structure:

* `arcIndex`: for every old vertex of a face's boundary walk, the *arc* it lies in, i.e. the
  number of pattern points of the walk that occur strictly before it.  The walk is closed, so the
  arc indices live in `Fin m` (`m` = the number of visits) — the last old vertex has index `m`,
  which is the same arc as index `0`.
* `pieceRel`: the equivalence relation on the arc indices generated by the chords.  For a chord
  joining the visits with indices `p` and `q`, the arc ending at `p` (index `p`) is glued to the
  arc starting at `q` (index `q+1`), and symmetrically.  These are the *pieces* of
  `face ∖ (chords)` (see `DESIGN_N13.md` §2b), expressed as a relation instead of a function.

The two facts needed from this data are (`DESIGN_N13.md` §2c):

* the old vertices of one arc have the same colour (`colour`, `Pattern.lean`; along an arc the
  steps are collapsed generator edges — `Work.ORDunwoody.colour_collapsed` is proved);
* two arcs related by `pieceRel` have the same colour — for a chord this is the statement that
  the two visits traverse the corresponding edge of `T` in opposite directions, which follows
  from `Work.ORDunwoody.eq_of_walk_avoids_edge`.
-/
import Mathlib
import Submission.Work.ORDunwoody.Dunwoody.Chord

set_option autoImplicit false
set_option linter.unusedVariables false

universe u

namespace Work.ORDunwoody.Dunwoody

open Work.ORDunwoody.Cayley

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

/-! ## The arcs -/

/-- The old vertices of a walk, each with the number of pattern points strictly before it: its
*arc index*. -/
def arcIndexAux : List (Vertex D) → ℕ → List (BaseV D × ℕ)
  | [], _ => []
  | Sum.inl u :: rest, k => (u, k) :: arcIndexAux rest k
  | Sum.inr _ :: rest, k => arcIndexAux rest (k + 1)

/-- The old vertices of a walk, each with its arc index. -/
def arcIndex (l : List (Vertex D)) : List (BaseV D × ℕ) := arcIndexAux l 0

@[simp] theorem arcIndexAux_nil (k : ℕ) : arcIndexAux (D := D) [] k = [] := rfl

@[simp] theorem arcIndexAux_inl (u : BaseV D) (rest : List (Vertex D)) (k : ℕ) :
    arcIndexAux ((Sum.inl u : Vertex D) :: rest) k = (u, k) :: arcIndexAux rest k := rfl

@[simp] theorem arcIndexAux_inr (m : MidV D) (rest : List (Vertex D)) (k : ℕ) :
    arcIndexAux ((Sum.inr m : Vertex D) :: rest) k = arcIndexAux rest (k + 1) := rfl

/-- The arc index is always at most the number of visits. -/
theorem arcIndexAux_snd_le : ∀ (l : List (Vertex D)) (k : ℕ), ∀ p ∈ arcIndexAux l k, p.2 ≤ k + l.length
  | [], k, p, hp => by simp at hp
  | Sum.inl u :: rest, k, p, hp => by
      rw [arcIndexAux_inl, List.mem_cons] at hp
      rcases hp with hp | hp
      · rw [hp]; simp
      · have := arcIndexAux_snd_le rest k p hp
        simp only [List.length_cons] at this ⊢
        omega
  | Sum.inr m :: rest, k, p, hp => by
      rw [arcIndexAux_inr] at hp
      have := arcIndexAux_snd_le rest (k + 1) p hp
      simp only [List.length_cons] at this ⊢
      omega

/-! ## The pieces -/

/-- The relation on the arc indices generated by one chord: the arc ending at one visit of the
chord is glued to the arc starting at the other. -/
def chordRel (l : List (MidV D)) (i j : ℕ) : Prop :=
  ∃ p q : ℕ, (p, q) ∈ chords l ∧ ((i = p ∧ j = q + 1) ∨ (i = q ∧ j = p + 1))

/-- **The pieces of a face**: the equivalence relation on the arc indices generated by the
chords. -/
def pieceRel (l : List (MidV D)) : ℕ → ℕ → Prop := Relation.EqvGen (chordRel l)

/-- The pieces of the boundary walk of a face. -/
def facePieceRel (D : GeoData T t₀ P) (c : G) (w : List (Fin P.n × Bool)) : ℕ → ℕ → Prop :=
  pieceRel (faceVisits D c w)

theorem pieceRel.refl {l : List (MidV D)} (i : ℕ) : pieceRel l i i := Relation.EqvGen.refl i

theorem pieceRel.symm {l : List (MidV D)} {i j : ℕ} (h : pieceRel l i j) : pieceRel l j i :=
  Relation.EqvGen.symm _ _ h

theorem pieceRel.trans {l : List (MidV D)} {i j k : ℕ} (h₁ : pieceRel l i j)
    (h₂ : pieceRel l j k) : pieceRel l i k := Relation.EqvGen.trans _ _ _ h₁ h₂

/-- A chord relates the two arcs it separates. -/
theorem pieceRel_of_chord {l : List (MidV D)} {p q : ℕ} (h : (p, q) ∈ chords l) :
    pieceRel l p (q + 1) ∧ pieceRel l q (p + 1) :=
  ⟨Relation.EqvGen.rel _ _ ⟨p, q, h, Or.inl ⟨rfl, rfl⟩⟩,
    Relation.EqvGen.rel _ _ ⟨p, q, h, Or.inr ⟨rfl, rfl⟩⟩⟩

end Work.ORDunwoody.Dunwoody
