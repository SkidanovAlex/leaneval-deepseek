Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# The colour of a region: the map `φ` on the regions of the pattern

The regions of the Dunwoody pattern (`Dunwoody/Region.lean`) are the classes of the old vertices
of `Λ''` under the relation generated by

* the collapsed generator edges (`L (j,true) = 0`), along which the map `φ` is constant
  (`Work.ORDunwoody.colour_collapsed`);
* the pieces of the faces: two arcs of a common piece have the same colour
  (`Work.ORDunwoody.colour_pieceRel`, which rests on `colour_arcIndex` for a single arc and on
  `colour_of_chord` for a chord).

Hence `colour : BaseV D → V` descends to the regions:

    colourRegion : Region D → V,

it is `G`-equivariant (`colourRegion_smul`), and for every pattern point `m` the two regions on
either side of the cell of `m` have the two colours of the label of `m`
(`colourRegion_pair`): they are in particular *distinct* (`Region.mk_src_ne_tgt`), which is the
statement that the incidence pair of a pattern point is a genuine pair of regions.

This is the map that will be the domination map `S → T` of the construction; it needs no
acyclicity of the dual graph.
-/
import Mathlib
import Submission.Work.ORDunwoody.Dunwoody.TrackWall
import Submission.Work.ORDunwoody.colour_pieceRel
import Submission.Work.ORDunwoody.colour_arcIndex
import Submission.Work.ORDunwoody.colour_collapsed

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORDunwoody.Dunwoody

open Work.ORDunwoody.Cayley
open scoped Sym2

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

/-! ## The colour is constant on the region relation -/

/-- **The map `φ` is constant on the generators of the region relation**: on a collapsed
generator edge (`colour_collapsed`) and on the pieces of a face (`colour_pieceRel`). -/
theorem colour_eq_of_regionRel {u v : BaseV D} (h : RegionRel D u v) :
    colour D u = colour D v := by
  rcases h with ⟨a, j, hL, h1 | h1⟩ | ⟨r, c, i, j, hu, hv, hp⟩
  · obtain ⟨rfl, rfl⟩ := h1
    exact colour_collapsed a j hL
  · obtain ⟨rfl, rfl⟩ := h1
    exact (colour_collapsed a j hL).symm
  · exact colour_pieceRel c (FreeGroup.toWord r.1) hp hu hv

/-- **The map `φ` is constant on the region relation.** -/
theorem colour_eq_of_eqvGen {u v : BaseV D} (h : Relation.EqvGen (RegionRel D) u v) :
    colour D u = colour D v := by
  induction h with
  | rel a b hab => exact colour_eq_of_regionRel hab
  | refl => rfl
  | symm a b hab ih => exact ih.symm
  | trans a b c hab hbc ih1 ih2 => exact ih1.trans ih2

/-! ## The colour of a region -/

/-- **The colour of a region**: the image in `T` of any of its old vertices. -/
noncomputable def colourRegion (D : GeoData T t₀ P) : Region D → V :=
  Quotient.lift (colour D) (fun _ _ h => colour_eq_of_eqvGen h)

@[simp] theorem colourRegion_mk (u : BaseV D) :
    colourRegion D (Region.mk D u) = colour D u := rfl

/-- The colour of a region is `G`-equivariant. -/
theorem colourRegion_smul (g : G) (R : Region D) :
    colourRegion D (g • R) = g • colourRegion D R := by
  refine Quotient.inductionOn R (fun u => ?_)
  exact colour_smul D g u

/-! ## The two sides of a cell have distinct colours -/

/-- The label of a pattern point is a genuine edge of `T`, so the colours of the two ends of its
cell differ. -/
theorem colour_src_ne_tgt (m : MidV D) : colour D (MidV.src m) ≠ colour D (MidV.tgt m) := by
  intro hc
  have hmem : ¬ (m.label).IsDiag := by
    have h2 := Cell.label_mem_edgeSet (D := D) (MidV.cell m)
    rw [Cell.label_eq_MidV_label, MidV.cell_mid] at h2
    exact SimpleGraph.not_isDiag_of_mem_edgeSet (G := T.graph) h2
  rw [MidV.label_eq_colour, hc] at hmem
  exact hmem (Sym2.mk_isDiag_iff.mpr rfl)

/-- **The two regions on either side of a pattern point are distinct.** -/
theorem Region.mk_src_ne_tgt (m : MidV D) :
    Region.mk D (MidV.src m) ≠ Region.mk D (MidV.tgt m) := by
  intro h
  refine colour_src_ne_tgt m ?_
  rw [← colourRegion_mk (D := D) (MidV.src m), ← colourRegion_mk (D := D) (MidV.tgt m), h]

/-- **The colours of the two regions of a pattern point are the two ends of its label.** -/
theorem colourRegion_pair (m : MidV D) :
    s(colourRegion D (Region.mk D (MidV.src m)), colourRegion D (Region.mk D (MidV.tgt m))) =
      m.label := by
  rw [colourRegion_mk, colourRegion_mk]
  exact (MidV.label_eq_colour m).symm

end Work.ORDunwoody.Dunwoody
