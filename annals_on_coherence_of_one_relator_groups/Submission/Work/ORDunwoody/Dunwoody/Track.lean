/-
Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# The tracks of the Dunwoody pattern

`Dunwoody/Region.lean` defines the regions (the equivalence classes of the old vertices of `Λ''`
under the gluing of the pieces along the pattern).  This file adds the **tracks**: the connected
components of the *chord graph* on the pattern points, two pattern points being adjacent when they
are the two endpoints of a chord of a common face (`Dunwoody/Chord.lean`).

The two facts that make the tracks the right notion of "wall" are

* `Track.label` — all pattern points of one track have the same label `Sym2 V`, i.e. all the cells
  they are the midpoints of map onto the *same* edge of `T`;
* `Track.regPair` — all pattern points of one track have the same **pair of adjacent regions**
  `s(Region.mk (src m), Region.mk (tgt m))`.  This is the statement that the two sides of a track
  are well defined, i.e. that a track is incident with exactly two regions.

Both are proved by the same two inputs (see `Chord.lean` and `Piece.lean`):

* `label_of_chord` / `midPair_of_chord` — two pattern points joined by a chord of a face have the
  same label and the same pair of adjacent regions.  The pair statement uses that the two arcs of a
  face related by a chord lie in the same *piece* (`pieceRel_of_chord`), hence in the same region
  (`RegionRel`).
* the components of the chord graph are generated by single chords (`Reachable`), so the two facts
  propagate along the track.
-/
import Mathlib
import Submission.Work.ORDunwoody.Dunwoody.Region
import Submission.Work.ORDunwoody.cell_label_eq_colour
import Submission.Work.ORDunwoody.label_of_chord

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORDunwoody.Dunwoody

open Work.ORDunwoody.Cayley
open scoped Sym2

variable {G : Type u} [Group G] {V : Type u} [MulAction G V] [DecidableEq V]
variable {T : GTree G V} {t₀ : V} {P : FinPresentation G}
variable {D : GeoData T t₀ P}

/-! ## Cells, sources, targets and the pair of regions of a pattern point -/

/-- The cell of `Λ'` whose midpoint is a pattern point. -/
def MidV.cell (m : MidV D) : Cell D := ⟨m.1, m.2.j, m.2.k⟩

/-- The old vertex at the source end of the cell of a pattern point. -/
def MidV.src (m : MidV D) : BaseV D := m.cell.src

/-- The old vertex at the target end of the cell of a pattern point. -/
def MidV.tgt (m : MidV D) : BaseV D := m.cell.tgt

@[simp] theorem MidV.cell_mid (m : MidV D) : m.cell.mid = m := rfl

@[simp] theorem MidV.cell_src (m : MidV D) : m.cell.src = m.src := rfl

@[simp] theorem MidV.cell_tgt (m : MidV D) : m.cell.tgt = m.tgt := rfl

/-- The label of a pattern point is the unordered pair of the colours of the two old vertices at
its ends (`Work.ORDunwoody.cell_label_eq_colour`). -/
theorem MidV.label_eq_colour (m : MidV D) :
    m.label = s(colour D m.src, colour D m.tgt) :=
  cell_label_eq_colour (D := D) m.cell

/-- **The two regions adjacent to a pattern point**, as an unordered pair of regions. -/
def midPair (m : MidV D) : Sym2 (Region D) := s(Region.mk D m.src, Region.mk D m.tgt)

/-! ## The chord graph and its components -/

/-- Two pattern points are **directly adjacent in the chord graph** when they are the two endpoints
of a chord of a common face of `Λ''`. -/
def ChordAdj (m m' : MidV D) : Prop :=
  ∃ (r : {r : FreeGroup (Fin P.n) // r ∈ P.rel}) (c : G) (p q : ℕ),
    ((p, q) ∈ chords (faceVisits D c (FreeGroup.toWord r.1)) ∨
      (q, p) ∈ chords (faceVisits D c (FreeGroup.toWord r.1))) ∧
    (faceVisits D c (FreeGroup.toWord r.1))[p]? = some m ∧
    (faceVisits D c (FreeGroup.toWord r.1))[q]? = some m'

/-- The chord relation is symmetric. -/
theorem ChordAdj.symm {m m' : MidV D} (h : ChordAdj m m') : ChordAdj m' m := by
  obtain ⟨r, c, p, q, hpq, hm, hm'⟩ := h
  refine ⟨r, c, q, p, ?_, hm', hm⟩
  rcases hpq with h | h
  · exact Or.inr h
  · exact Or.inl h

/-- **The chord graph** on the pattern points. -/
def chordGraph (D : GeoData T t₀ P) : SimpleGraph (MidV D) where
  Adj m m' := ChordAdj m m' ∧ m ≠ m'
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨fun _ h => h.2 rfl⟩

/-- **A track**: a connected component of the chord graph. -/
def Track (D : GeoData T t₀ P) : Type u := (chordGraph D).ConnectedComponent

/-- The track of a pattern point. -/
def trackOf (m : MidV D) : Track D := (chordGraph D).connectedComponentMk m

theorem trackOf_eq_iff {m m' : MidV D} :
    trackOf m = trackOf m' ↔ (chordGraph D).Reachable m m' :=
  SimpleGraph.ConnectedComponent.eq

theorem trackOf_eq_of_adj {m m' : MidV D} (h : (chordGraph D).Adj m m') :
    trackOf m = trackOf m' :=
  SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj h

/-! ## The label of a track -/

/-- **The label of a track**: the edge of `T` that every cell of the track maps onto.  All the
pattern points of one track have the same label because the chords of a face join pattern points of
one fibre (`label_of_chord`) and the tracks are generated by the chords. -/
theorem label_eq_of_reachable {m m' : MidV D} (h : (chordGraph D).Reachable m m') :
    m.label = m'.label := by
  rw [SimpleGraph.reachable_iff_reflTransGen] at h
  induction h with
  | refl => rfl
  | tail _ hbc ih =>
      refine ih.trans ?_
      obtain ⟨r, c, p, q, hpq, hb, hc⟩ := hbc.1
      rcases hpq with hpq | hpq
      · exact label_of_chord hpq hb hc
      · exact (label_of_chord hpq hc hb).symm

/-- **The label of a track.** -/
noncomputable def Track.label (τ : Track D) : Sym2 V :=
  Quot.lift (fun m : MidV D => m.label) (fun _ _ h => label_eq_of_reachable h) τ

@[simp] theorem Track.label_trackOf (m : MidV D) : (trackOf m).label = m.label := rfl

end Work.ORDunwoody.Dunwoody
