import Mathlib
import Submission.Work.ORDunwoody.Dunwoody.Region

universe u

namespace Work.ORDunwoody

open Work.ORDunwoody.Dunwoody

/-- A single `RegionRel` step gives a walk in the region graph: the two vertices are adjacent
unless they coincide, in which case the walk is trivial. -/
theorem regionGraph_reachable_of_regionRel {G : Type u} [Group G] {V : Type u} [MulAction G V]
    [DecidableEq V] {T : Work.ORDunwoody.GTree G V} {t₀ : V}
    {P : Work.ORDunwoody.FinPresentation G}
    {D : Work.ORDunwoody.Cayley.GeoData T t₀ P}
    {u w : Work.ORDunwoody.Dunwoody.BaseV D}
    (h : Work.ORDunwoody.Dunwoody.RegionRel D u w) :
    (Work.ORDunwoody.Dunwoody.regionGraph D).Reachable u w := by
  obtain rfl | hne := eq_or_ne u w
  · exact SimpleGraph.Reachable.refl _
  · exact SimpleGraph.Adj.reachable
      ((Work.ORDunwoody.Dunwoody.regionGraph_adj_iff (D := D)).2 ⟨hne, Or.inl h⟩)

/-- Induction on the derivation of the equivalence relation generated by `RegionRel`: a single
step is a walk (`regionGraph_reachable_of_regionRel`), reflexivity is the trivial walk,
symmetry reverses a walk and transitivity concatenates two walks. -/
theorem regionGraph_reachable_of_eqvGen {G : Type u} [Group G] {V : Type u} [MulAction G V]
    [DecidableEq V] {T : Work.ORDunwoody.GTree G V} {t₀ : V}
    {P : Work.ORDunwoody.FinPresentation G}
    {D : Work.ORDunwoody.Cayley.GeoData T t₀ P}
    {u w : Work.ORDunwoody.Dunwoody.BaseV D}
    (h : Relation.EqvGen (Work.ORDunwoody.Dunwoody.RegionRel D) u w) :
    (Work.ORDunwoody.Dunwoody.regionGraph D).Reachable u w := by
  induction h with
  | rel a b hab => exact regionGraph_reachable_of_regionRel hab
  | refl => exact SimpleGraph.Reachable.refl _
  | symm a b hab ih => exact ih.symm
  | trans a b c hab hbc ih1 ih2 => exact ih1.trans ih2

/-- **The classes of `Region` are the connected components of the region graph.**  `Region D` is
the quotient of the old vertices by `Relation.EqvGen (RegionRel D)` and `regionGraph D` is the
symmetrisation of `RegionRel D`, so two old vertices with the same region are joined by a walk:
induction on the derivation of `EqvGen` (a `RegionRel` step is an edge when the two vertices
differ and a loop otherwise, `symm` reverses the walk, `trans` concatenates). -/
theorem regionGraph_reachable_of_mk_eq {G : Type u} [Group G] {V : Type u} [MulAction G V]
    [DecidableEq V] {T : Work.ORDunwoody.GTree G V} {t₀ : V}
    {P : Work.ORDunwoody.FinPresentation G}
    {D : Work.ORDunwoody.Cayley.GeoData T t₀ P}
    {u w : Work.ORDunwoody.Dunwoody.BaseV D}
    (h : Work.ORDunwoody.Dunwoody.Region.mk D u = Work.ORDunwoody.Dunwoody.Region.mk D w) :
    (Work.ORDunwoody.Dunwoody.regionGraph D).Reachable u w :=
  regionGraph_reachable_of_eqvGen
    ((Work.ORDunwoody.Dunwoody.Region.mk_eq_iff (D := D)).mp h)

end Work.ORDunwoody
