# Orbit closures of subgraphs and the seed subtree

The material needed for the standard fact "a finitely generated group acting on a tree has
a cocompact invariant subtree".

Given a group `G` acting on a `GTree T` (a simplicial tree with an action by graph
automorphisms, see `Submission.Work.ORDunwoody.Basic`), a subgroup `H ≤ G`, a base vertex
`v₀`, a finite set `S₀` of group elements generating `H`, and a choice of walks
`p s : v₀ → s • v₀` in the tree, we build

* `seedSubgraph T S₀ v₀ p` : the finite "seed" subtree generated by the walks from `v₀` to
  `s • v₀` for `s ∈ S₀`, together with the vertex `v₀`;
* `orbitVertSet H A` : the `H`-orbit closure of a vertex set `A`, with its `H`-action;
* `orbitSubgraph T H A` : the `H`-orbit closure of a subgraph `A`, i.e. the subgraph whose
  edges are the `H`-translates of the edges of `A`;
* `walkPairFinset w` : the finite set of ordered pairs of consecutive vertices of a walk;
* `seedVertsFinset` / `seedEdgesFinset` : explicit finite candidate transversals for the
  vertices and edges of `orbitSubgraph T H (seedSubgraph T S₀ v₀ p)`.
-/
import Mathlib
import Submission.Work.ORDunwoody.Basic

set_option autoImplicit false

universe u v w x

namespace Work.ORDunwoody

open SimpleGraph

variable {G : Type u} [Group G] {V : Type v} [MulAction G V]

/-- The `H`-orbit closure of a set of vertices. -/
def orbitVertSet (H : Subgroup G) (A : Set V) : Set V := {v | ∃ h : H, ∃ a ∈ A, h • a = v}

theorem mem_orbitVertSet_iff {H : Subgroup G} {A : Set V} {v : V} :
    v ∈ orbitVertSet H A ↔ ∃ h : H, ∃ a ∈ A, h • a = v := Iff.rfl

theorem orbitVertSet.smul_mem {H : Subgroup G} {A : Set V} (h : H) {v : V}
    (hv : v ∈ orbitVertSet H A) : h • v ∈ orbitVertSet H A := by
  obtain ⟨k, a, ha, rfl⟩ := hv
  exact ⟨h * k, a, ha, mul_smul h k a⟩

theorem subset_orbitVertSet {H : Subgroup G} (A : Set V) : A ⊆ orbitVertSet H A :=
  fun a ha => ⟨1, a, ha, one_smul G a⟩

theorem orbitVertSet_mono {H : Subgroup G} {A B : Set V} (h : A ⊆ B) :
    orbitVertSet H A ⊆ orbitVertSet H B :=
  fun v ⟨g, a, ha, hga⟩ => ⟨g, a, h ha, hga⟩

/-- The `H`-action on the orbit closure of a set of vertices. -/
instance orbitVertSet.instMulAction (H : Subgroup G) (A : Set V) :
    MulAction H (orbitVertSet H A) where
  smul h x := ⟨h • x.1, orbitVertSet.smul_mem h x.2⟩
  one_smul x := Subtype.ext (one_smul H x.1)
  mul_smul h k x := Subtype.ext (mul_smul h k x.1)

@[simp] theorem orbitVertSet.coe_smul {H : Subgroup G} {A : Set V} (h : H)
    (x : orbitVertSet H A) : (h • x).1 = h • x.1 := rfl

/-- The `H`-orbit closure of a subgraph: vertices are the orbit closure of the vertices of
`A`, edges are the `H`-translates of the edges of `A`. -/
def orbitSubgraph (T : GTree G V) (H : Subgroup G) (A : T.graph.Subgraph) :
    T.graph.Subgraph where
  verts := orbitVertSet H A.verts
  Adj u v := ∃ h : H, ∃ a : V, ∃ b : V, A.Adj a b ∧ h • a = u ∧ h • b = v
  adj_sub := by
    rintro u v ⟨h, a, b, hab, rfl, rfl⟩
    exact T.smul_adj h (A.adj_sub hab)
  edge_vert := by
    rintro u v ⟨h, a, b, hab, rfl, rfl⟩
    exact ⟨h, a, A.edge_vert hab, rfl⟩
  symm.symm := by
    rintro u v ⟨h, a, b, hab, rfl, rfl⟩
    exact ⟨h, b, a, hab.symm, rfl, rfl⟩

@[simp] theorem orbitSubgraph.verts_eq (T : GTree G V) (H : Subgroup G)
    (A : T.graph.Subgraph) : (orbitSubgraph T H A).verts = orbitVertSet H A.verts := rfl

theorem orbitSubgraph.adj_iff {T : GTree G V} {H : Subgroup G} {A : T.graph.Subgraph}
    {u v : V} : (orbitSubgraph T H A).Adj u v ↔
      ∃ h : H, ∃ a : V, ∃ b : V, A.Adj a b ∧ h • a = u ∧ h • b = v := Iff.rfl

/-- `A` is a subgraph of its orbit closure. -/
theorem le_orbitSubgraph (T : GTree G V) (H : Subgroup G) (A : T.graph.Subgraph) :
    A ≤ orbitSubgraph T H A := by
  constructor
  · intro v hv
    exact ⟨1, v, hv, one_smul G v⟩
  · intro u v huv
    exact ⟨1, u, v, huv, one_smul G u, one_smul G v⟩

/-- The adjacency of the orbit closure is invariant under the `H`-action. -/
theorem orbitSubgraph.adj_smul {T : GTree G V} {H : Subgroup G} {A : T.graph.Subgraph}
    (g : H) {u v : V} (h : (orbitSubgraph T H A).Adj u v) :
    (orbitSubgraph T H A).Adj (g • u) (g • v) := by
  obtain ⟨h, a, b, hab, rfl, rfl⟩ := h
  exact ⟨g * h, a, b, hab, mul_smul g h a, mul_smul g h b⟩

/-- The vertex set of the orbit closure is invariant under the `H`-action. -/
theorem orbitSubgraph.smul_mem_verts {T : GTree G V} {H : Subgroup G} {A : T.graph.Subgraph}
    (g : H) {u : V} (h : u ∈ (orbitSubgraph T H A).verts) :
    g • u ∈ (orbitSubgraph T H A).verts :=
  orbitVertSet.smul_mem g h

/-- The finite seed subtree: the union of the walks `v₀ → s • v₀` for `s ∈ S₀`, together
with the vertex `v₀`. -/
def seedSubgraph (T : GTree G V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, T.graph.Walk v0 (s • v0)) : T.graph.Subgraph :=
  (⨆ s : {s // s ∈ S0}, (p s.1).toSubgraph) ⊔ T.graph.singletonSubgraph v0

theorem v0_mem_seedSubgraph_verts (T : GTree G V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, T.graph.Walk v0 (s • v0)) :
    v0 ∈ (seedSubgraph T S0 v0 p).verts := by
  rw [seedSubgraph, Subgraph.verts_sup]
  exact Or.inr (by simp [SimpleGraph.singletonSubgraph])

theorem walkSubgraph_le_seedSubgraph (T : GTree G V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, T.graph.Walk v0 (s • v0)) {s : G} (hs : s ∈ S0) :
    (p s).toSubgraph ≤ seedSubgraph T S0 v0 p :=
  le_trans (le_iSup (fun t : {t // t ∈ S0} => (p t.1).toSubgraph) ⟨s, hs⟩) le_sup_left

@[simp] theorem seedSubgraph_adj_iff {T : GTree G V} {S0 : Finset G} {v0 : V}
    {p : ∀ s : G, T.graph.Walk v0 (s • v0)} {u v : V} :
    (seedSubgraph T S0 v0 p).Adj u v ↔
      (∃ s : {s // s ∈ S0}, (p s.1).toSubgraph.Adj u v) := by
  rw [seedSubgraph, Subgraph.sup_adj, Subgraph.iSup_adj]
  simp [Subgraph.not_bot_adj]

@[simp] theorem seedSubgraph_verts_eq {T : GTree G V} {S0 : Finset G} {v0 : V}
    {p : ∀ s : G, T.graph.Walk v0 (s • v0)} :
    (seedSubgraph T S0 v0 p).verts =
      (⋃ s : {s // s ∈ S0}, (p s.1).toSubgraph.verts) ∪ {v0} := by
  rw [seedSubgraph, Subgraph.verts_sup, Subgraph.verts_iSup]
  rfl

/-- The ordered pairs of consecutive vertices of a walk, in both orientations. -/
noncomputable def walkPairFinset {G' : SimpleGraph V} {u v : V} (w : G'.Walk u v) :
    Finset (V × V) := by
  classical
  exact ((Finset.range w.length).image fun i => (w.getVert i, w.getVert (i + 1))) ∪
    ((Finset.range w.length).image fun i => (w.getVert (i + 1), w.getVert i))

/-- A finite set of vertices containing the vertices of the seed subtree. -/
noncomputable def seedVertsFinset (G' : SimpleGraph V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, G'.Walk v0 (s • v0)) : Finset V := by
  classical
  exact insert v0 ((Finset.univ : Finset {s // s ∈ S0}).biUnion fun s => (p s.1).support.toFinset)

/-- A finite set of ordered pairs containing the oriented edges of the seed subtree. -/
noncomputable def seedEdgesFinset (G' : SimpleGraph V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, G'.Walk v0 (s • v0)) : Finset (V × V) := by
  classical
  exact (Finset.univ : Finset {s // s ∈ S0}).biUnion fun s => walkPairFinset (p s.1)

theorem v0_mem_seedVertsFinset (G' : SimpleGraph V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, G'.Walk v0 (s • v0)) : v0 ∈ seedVertsFinset G' S0 v0 p := by
  classical
  rw [seedVertsFinset]
  exact Finset.mem_insert_self _ _

/-- Every vertex of the walk subgraph of `p s` (for `s ∈ S0`) lies in `seedVertsFinset`. -/
theorem mem_seedVertsFinset_of_mem_support (G' : SimpleGraph V) (S0 : Finset G) (v0 : V)
    (p : ∀ s : G, G'.Walk v0 (s • v0)) {s : G} (hs : s ∈ S0) {x : V}
    (hx : x ∈ (p s).support) : x ∈ seedVertsFinset G' S0 v0 p := by
  classical
  rw [seedVertsFinset]
  refine Finset.mem_insert_of_mem (Finset.mem_biUnion.mpr ⟨⟨s, hs⟩, Finset.mem_univ _, ?_⟩)
  simpa using hx

end Work.ORDunwoody
