/-
Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# Corollaries of JL Theorems 4.4/4.5, and the bundled inputs

* `groupCoherent_of_tree` is the second sentence of JL Theorem 4.5: a group `G` acting on a
  tree with coherent vertex stabilizers and all of whose finitely generated subgroups are of
  type `FP₂(k)` is coherent.
* `JLInputs` bundles the four remaining named inputs so that a caller can state the theorems
  in terms of a single hypothesis.
* `fp_of_FP2_of_tree_of_inputs` is `fp_of_FP2_of_tree` with the bundle.
-/
import Submission.Work.ORDunwoody.Theorem45

set_option autoImplicit false

set_option linter.unusedVariables false

universe u

namespace Work.ORDunwoody

/-- The five remaining named inputs of JL §4, as a single hypothesis.  (The sixth input, the
cocompact invariant subtree, is a theorem: `cocompactSubtree`.) -/
structure JLInputs (k : Type u) [CommRing k] (G : Type u) [Group G] : Prop where
  /-- Bieri–Strebel (JL Lemma 4.3, node N11). -/
  bieriStrebel : BieriStrebel k
  /-- The Dunwoody resolution theorem (GL17 Prop. 2.17, constant case). -/
  dunwoody : DunwoodyResolutionAll G
  /-- Serre, *Trees*, §5 / JL Lemma 4.1: quotients of trees by normal closures of
  subgroups generated by elliptic elements are trees. -/
  quotientTree : QuotientTreeByNormalClosureOfElliptic k
  /-- A group acting freely on a tree is free. -/
  freeOnTree : FreeOnTreeIsFree k
  /-- The structure theorem for groups acting on trees. -/
  bassSerre : BassSerreFinitelyPresentedAll G

/-- JL Theorem 4.5, with the inputs bundled. -/
theorem fp_of_FP2_of_tree_of_inputs {k : Type u} [CommRing k] [Nontrivial k] {G : Type u}
    [Group G] {V : Type u} [MulAction G V] (I : JLInputs k G) (T : GTree G V)
    (hT : ∀ v : V, Group.Coherent (T.vertexStab v)) (H : Subgroup G) (hH : IsFP2 k H) :
    Group.IsFinitelyPresented H :=
  fp_of_FP2_of_tree T hT I.bieriStrebel I.dunwoody I.quotientTree I.freeOnTree I.bassSerre H hH

/-- The second assertion of JL Theorem 4.5: if `G` acts on a tree with coherent vertex
stabilizers and every finitely generated subgroup of `G` is of type `FP₂(k)`, then `G` is
coherent. -/
theorem groupCoherent_of_tree {k : Type u} [CommRing k] [Nontrivial k] {G : Type u}
    [Group G] {V : Type u} [MulAction G V] (T : GTree G V)
    (hT : ∀ v : V, Group.Coherent (T.vertexStab v))
    (hBS : BieriStrebel k) (hDR : DunwoodyResolutionAll G)
    (hQ : QuotientTreeByNormalClosureOfElliptic k) (hFree : FreeOnTreeIsFree k)
    (hSS : BassSerreFinitelyPresentedAll G)
    (hall : HomologicallyCoherent k G) : Group.Coherent G :=
  fun H hH => fp_of_FP2_of_tree T hT hBS hDR hQ hFree hSS H (hall H hH)

/-- `groupCoherent_of_tree` with the inputs bundled. -/
theorem groupCoherent_of_tree_of_inputs {k : Type u} [CommRing k] [Nontrivial k]
    {G : Type u} [Group G] {V : Type u} [MulAction G V] (I : JLInputs k G) (T : GTree G V)
    (hT : ∀ v : V, Group.Coherent (T.vertexStab v)) (hall : HomologicallyCoherent k G) :
    Group.Coherent G :=
  fun H hH => fp_of_FP2_of_tree_of_inputs I T hT H (hall H hH)

end Work.ORDunwoody
