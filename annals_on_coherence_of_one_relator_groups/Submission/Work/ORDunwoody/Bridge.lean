/-
Copyright: work of the ORDunwoody subproject (node N13 of the
`annals_on_coherence_of_one_relator_groups` project).

# Bridge to the vocabulary of the sibling node N11 (`Submission.Work.ORFP2`)

Node N11 (`ORFP2`) uses `Work.ORFP2.IsFP2` (augmentation ideal generated by `single g 1 - 1`)
and `Work.ORFP2.H1Vanishes` for the same notions as `Work.ORDunwoody.IsFP2` (augmentation
ideal generated by `of g - 1`) and `Work.ORDunwoody.AbelianizationTensorVanishes`.  The two
are definitionally the same up to the identification `MonoidAlgebra.of k G g = single g 1`;
this file records the bridges, so that a theorem proved in one vocabulary can be used in the
other.
-/
import Submission.Work.ORDunwoody.FP2
import Submission.Work.ORFP2.Basic

set_option autoImplicit false

set_option linter.unusedVariables false

namespace Work.ORDunwoody

/-- The two augmentation ideals agree (they are definitionally equal, since
`MonoidAlgebra.of k G g = single g 1`). -/
theorem augmentationIdeal_eq_augIdeal (k : Type*) [CommRing k] (G : Type*) [Group G] :
    augmentationIdeal k G = Work.ORFP2.augIdeal k G := rfl

/-- `FP₂` in the vocabulary of this area is `FP₂` in the vocabulary of node N11. -/
theorem isFP2_iff_ORFP2 (k : Type*) [CommRing k] (G : Type*) [Group G] :
    IsFP2 k G ↔ Work.ORFP2.IsFP2 k G := by
  rw [IsFP2, Work.ORFP2.IsFP2, augmentationIdeal_eq_augIdeal]

/-- `N^{ab} ⊗_ℤ k = 0` is the same predicate in both vocabularies. -/
theorem abelianizationTensorVanishes_iff_H1Vanishes (k : Type*) [CommRing k] (N : Type*)
    [Group N] :
    AbelianizationTensorVanishes k N ↔ Work.ORFP2.H1Vanishes k N := Iff.rfl

end Work.ORDunwoody
