# `FP₂` for groups, and the vocabulary of the Bass–Serre / homological inputs

We record here the two group-theoretic notions used by the statement of JL Theorems 4.4
and 4.5:

* `IsFP2 k G`: `G` is of type `FP₂` over `k`, i.e. the augmentation ideal `I_G ⊆ k[G]` is
  a finitely presented `k[G]`-module.  (For a group, `G` is of type `FP₂` over `k` exactly
  when `I_G` is finitely presented as a left `k[G]`-module.)
* `AbelianizationTensorVanishes k N`: `H₁(N;k) = N^{ab} ⊗_ℤ k = 0`, the hypothesis that
  appears in the Bieri–Strebel Lemma 4.3.
-/
import ChallengeDeps
import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.GroupTheory.Abelianization.Defs
import Mathlib.LinearAlgebra.TensorProduct.Basic

set_option autoImplicit false

set_option linter.unusedVariables false

universe u v w

namespace Work.ORDunwoody

/-- The augmentation ideal of the group algebra `k[G]`: the (two-sided) ideal generated by
the elements `g - 1`, `g ∈ G`.  This is the kernel of the augmentation `k[G] → k`,
`∑ c_g g ↦ ∑ c_g`. -/
noncomputable def augmentationIdeal (k : Type u) (G : Type v) [CommRing k] [Group G] :
    Ideal (MonoidAlgebra k G) :=
  Ideal.span (Set.range fun g : G => MonoidAlgebra.of k G g - (1 : MonoidAlgebra k G))

/-- `G` is of type `FP₂` over `k`: its augmentation ideal is a finitely presented
`k[G]`-module. -/
def IsFP2 (k : Type u) [CommRing k] (G : Type v) [Group G] : Prop :=
  Module.FinitePresentation (MonoidAlgebra k G) (augmentationIdeal k G)

/-- `G` is homologically coherent over `k`: every finitely generated subgroup of `G` is of
type `FP₂` over `k` (JL, §1.1). -/
def HomologicallyCoherent (k : Type u) [CommRing k] (G : Type v) [Group G] : Prop :=
  ∀ H : Subgroup G, H.FG → IsFP2 k H

/-- `N^{ab} ⊗_ℤ k = 0`: the first homology of `N` with coefficients in `k` vanishes. -/
def AbelianizationTensorVanishes (k : Type u) [CommRing k] (N : Type v) [Group N] : Prop :=
  Subsingleton (TensorProduct ℤ (Additive (Abelianization N)) k)

end Work.ORDunwoody
