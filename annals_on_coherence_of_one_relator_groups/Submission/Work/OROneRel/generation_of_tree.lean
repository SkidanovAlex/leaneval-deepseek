import Mathlib
import Submission.Work.OROneRel.hnnConjMap_injective_of_tree
import Submission.Work.ORBassSerre.Interface

/-!
# A group acting on a tree with one vertex orbit and one edge orbit is generated by a vertex
stabiliser and one "stable letter"

Let `G` act on a tree `V` (a quiver with an involutive reversal of arrows) compatibly with the
graph structure.  Suppose that `v : V` and `t : G` and an edge `e : v ⟶ z` with `t • z = v` are
such that the edge `e` (together with its reverse) covers every edge of `V` up to `G`-translation
(`hedges`) — i.e. the quotient graph `V/G` is a single loop.  Then `G` is generated by the
stabiliser of `v` and by `t`.

The proof does not use the vertex-transitivity hypothesis `hcover`: the argument is the classical
Bass--Serre one.  Let `H := Stab(v) ⊔ ⟨t⟩` and let `S` be the `H`-orbit of `v`.  Given `x ∈ S` and
an edge `f : x ⟶ y`, write `x = h • v` with `h ∈ H` and use `hedges` to move `f` back onto `e` (or
onto `e.reverse`) by some `g`.  Then `g` differs from `h` (or from `h t`) by an element of
`Stab(v)`, so `g ∈ H`, and `y = g • z = g t⁻¹ • v ∈ S`.  Hence `S` is a connected subgraph of the
connected graph `V`, so `S = V`; in particular `g • v ∈ S` for every `g`, which forces
`g ∈ Stab(v) · H = H`.
-/

namespace Work.OROneRel

universe u

open Quiver

theorem generation_of_tree {G : Type u} [Group G] {V : Type u} [Quiver V]
    [Quiver.HasInvolutiveReverse V] [MulAction G V] [Work.ORBassSerre.GraphAction G V]
    (hT : Work.ORBassSerre.IsTree V) (v : V) (t : G) {z : V} (e : v ⟶ z) (ht : t • z = v)
    (hcover : ∀ x : V, ∃ g : G, g • v = x)
    (hedges : ∀ (x y : V) (f : x ⟶ y), ∃ g : G,
      g • Quiver.Total.mk v z e = Quiver.Total.mk x y f ∨
      g • (Quiver.Total.mk v z e).reverse = Quiver.Total.mk x y f) :
    MulAction.stabilizer G v ⊔ Subgroup.zpowers t = ⊤ := by
  -- `hcover` is not needed for the argument (the underlying graph of a tree is connected), but we
  -- record it to keep it in scope.
  have hcover' := hcover
  classical
  let H : Subgroup G := MulAction.stabilizer G v ⊔ Subgroup.zpowers t
  have hstab_le : MulAction.stabilizer G v ≤ H := le_sup_left
  have hzpow_le : Subgroup.zpowers t ≤ H := le_sup_right
  -- `z` is `t⁻¹ • v`
  have ht_inv : t⁻¹ • v = z := by
    rw [← ht, smul_smul, inv_mul_cancel, one_smul]
  have ht_mem : t ∈ H := hzpow_le (Subgroup.mem_zpowers t)
  have ht_inv_mem : t⁻¹ ∈ H := hzpow_le (Subgroup.inv_mem _ (Subgroup.mem_zpowers t))
  -- The fundamental step: the `H`-orbit `S` of `v` is closed under edges.
  have hstep : ∀ (x y : V) (f : x ⟶ y), (∃ h ∈ H, h • v = x) → (∃ h ∈ H, h • v = y) := by
    intro x y f hx
    obtain ⟨h, hh, hhv⟩ := hx
    rcases hedges x y f with ⟨g, hg | hg⟩
    · -- `g` maps `e` onto `f`, so `g • v = x` and `g • z = y`
      have hgv : g • v = x := by
        have h := congrArg (fun E : Quiver.Total V => E.left) hg
        simpa using h
      have hgz : g • z = y := by
        have h := congrArg (fun E : Quiver.Total V => E.right) hg
        simpa using h
      -- `h⁻¹ * g` fixes `v`, hence `g ∈ H`
      have hs : h⁻¹ * g ∈ MulAction.stabilizer G v := by
        rw [MulAction.mem_stabilizer_iff, mul_smul, hgv, ← hhv, smul_smul, inv_mul_cancel,
          one_smul]
      have hgH : g ∈ H := by
        have h1 : h * (h⁻¹ * g) ∈ H := mul_mem hh (hstab_le hs)
        simpa [mul_assoc] using h1
      -- and `y = g • z = (g * t⁻¹) • v` with `g * t⁻¹ ∈ H`
      exact ⟨g * t⁻¹, mul_mem hgH ht_inv_mem, by rw [mul_smul, ht_inv, hgz]⟩
    · -- `g` maps `e.reverse` onto `f`, so `g • z = x` and `g • v = y`
      have hgz : g • z = x := by
        have h := congrArg (fun E : Quiver.Total V => E.left) hg
        simpa using h
      have hgv : g • v = y := by
        have h := congrArg (fun E : Quiver.Total V => E.right) hg
        simpa using h
      -- `h⁻¹ * (g * t⁻¹)` fixes `v`, hence `g * t⁻¹ ∈ H` and so `g ∈ H`
      have hs : h⁻¹ * (g * t⁻¹) ∈ MulAction.stabilizer G v := by
        rw [MulAction.mem_stabilizer_iff, mul_smul, mul_smul, ht_inv, hgz, ← hhv, smul_smul,
          inv_mul_cancel, one_smul]
      have hgH : g * t⁻¹ ∈ H := by
        have h1 : h * (h⁻¹ * (g * t⁻¹)) ∈ H := mul_mem hh (hstab_le hs)
        simpa [mul_assoc] using h1
      have hgH' : g ∈ H := by
        have h2 : (g * t⁻¹) * t ∈ H := mul_mem hgH ht_mem
        simpa [mul_assoc] using h2
      exact ⟨g, hgH', hgv⟩
  -- Consequently the `H`-orbit of `v` contains every vertex:
  -- along the tree path from `v` to `x`, membership propagates edge by edge.
  have hreach : ∀ x : V, ∃ h ∈ H, h • v = x := by
    intro x
    obtain ⟨p⟩ := hT.1 v x
    induction p with
    | nil => exact ⟨1, H.one_mem, one_smul G v⟩
    | cons p f ih => exact hstep _ _ f ih
  -- Hence every `g` lies in `H`: `g • v = h • v` for some `h ∈ H`, so `g⁻¹ h` fixes `v`.
  rw [Subgroup.eq_top_iff']
  intro g
  obtain ⟨h, hh, hhv⟩ := hreach (g • v)
  have hmem : g⁻¹ * h ∈ H := hstab_le (show g⁻¹ * h ∈ MulAction.stabilizer G v from by
    rw [MulAction.mem_stabilizer_iff, mul_smul, hhv, inv_smul_smul])
  have h1 : h * (g⁻¹ * h)⁻¹ ∈ H := mul_mem hh (inv_mem hmem)
  simpa [mul_assoc] using h1

end Work.OROneRel
