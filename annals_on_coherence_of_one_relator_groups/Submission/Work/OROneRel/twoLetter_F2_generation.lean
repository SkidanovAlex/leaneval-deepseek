import Mathlib
import Submission.Work.OROneRel.winAssembly
import Submission.Work.OROneRel.twoLetter_generation
import Submission.Work.OROneRel.winRho_winRoot
import Submission.Work.OROneRel.presentedGroup_union_amalgam

namespace Work.OROneRel

/-! ## Auxiliary computations for the two-letter band

The generation statement is proved by exhibiting two *closed* band loops, namely
`τ ^ q * a⁻¹` (`a` traversing the `a`-edge at level `0` and `τ ^ q` a band path from level `0` to
level `q`) and `τ ^ p * b` (`τ ^ p` a band path from level `0` to level `p` and `b` the `b`-edge at
level `p`).  Both are genuine loops of the band `winE (tlW p q) 0 (p*q)`, hence lie in the band
vertex `H₀ = (winRho Wt (tlW p q) 0 (p*q)).range` — this is the telescoping identity
`winRho_winRoot` read as the closed-walk criterion `mk_mem_winRho_range_of_decor` below — and they
exhibit `a` and `b` in `H₀ ⊔ ⟨τ⟩`. -/

section Aux

variable {α : Type*}

theorem lsig_cons_true_gen (c : α → ℤ) (a : α) (L : List (α × Bool)) :
    lsig c ((a, true) :: L) = c a + lsig c L := rfl

theorem lsig_cons_false_gen (c : α → ℤ) (a : α) (L : List (α × Bool)) :
    lsig c ((a, false) :: L) = -c a + lsig c L := rfl

theorem lsig_append_gen (c : α → ℤ) (L₁ L₂ : List (α × Bool)) :
    lsig c (L₁ ++ L₂) = lsig c L₁ + lsig c L₂ := by
  simp [lsig, List.map_append, List.sum_append]

theorem lsig_wordOf_gen (c : α → ℤ) (v : FreeGroup α) :
    lsig c (wordOf v) = (cohom c v).toAdd := by
  have h0 := cohom_mk c (wordOf v)
  rw [mk_wordOf] at h0
  rw [h0]
  rfl

theorem decor_singleton_true_gen (c : α → ℤ) (i : ℤ) (a : α) :
    decor c i [(a, true)] = [((a, i), true)] := rfl

theorem decor_singleton_false_gen (c : α → ℤ) (i : ℤ) (a : α) :
    decor c i [(a, false)] = [((a, i - c a), false)] := rfl

theorem mk_singleton_true_gen (a : α) :
    FreeGroup.mk ([(a, true)] : List (α × Bool)) = FreeGroup.of a := rfl

theorem mk_singleton_false_gen (a : α) :
    FreeGroup.mk ([(a, false)] : List (α × Bool)) = (FreeGroup.of a)⁻¹ := by
  have h : ([(a, false)] : List (α × Bool)) = FreeGroup.invRev [(a, true)] := by
    simp [FreeGroup.invRev]
  rw [h, ← FreeGroup.inv_mk]
  rfl

theorem lsig_singleton_true_gen (c : α → ℤ) (a : α) : lsig c [(a, true)] = c a := by
  simp [lsig]

theorem lsig_singleton_false_gen (c : α → ℤ) (a : α) : lsig c [(a, false)] = -c a := by
  simp [lsig]

end Aux

/-- **The closed-walk criterion of the band vertex.**  If the decorated walk of a list `L` of signed
letters (started at level `0`) stays in the window `[lo,hi]` and has total weight `0`, then the
element `FreeGroup.mk L` it spells lies in the range of the class map `winRho`: the telescoping
identity `winRho_winRoot` applied to the reduction `wordOf (mk L)` of `L`, transported back to `L`
by `decor_winE_of_red`. -/
theorem mk_mem_winRho_range_of_decor {α : Type*} (Wt : ℤ → FreeGroup α) (c : α → ℤ) (lo hi : ℤ)
    (hW0 : Wt 0 = 1) (L : List (α × Bool)) (hlsig : lsig c L = 0)
    (hwalk : ∀ e ∈ decor c 0 L, coverEdge e ∈ winE c lo hi) :
    FreeGroup.mk L ∈ (winRho Wt c lo hi).range := by
  classical
  have hcoh : cohom c (FreeGroup.mk L) = 1 := by
    rw [cohom_mk, hlsig]
    simp
  have hred : FreeGroup.Red L (wordOf (FreeGroup.mk L)) := by
    show FreeGroup.Red L ((FreeGroup.mk L).toWord)
    rw [FreeGroup.toWord_mk]
    exact FreeGroup.reduce.red
  exact ⟨winRoot Wt c lo hi (FreeGroup.mk L),
    winRho_winRoot Wt hW0 hcoh lo hi (decor_winE_of_red c lo hi hred hwalk)⟩

theorem range_of_fin2 : (Set.range (FreeGroup.of : Fin 2 → FreeGroup (Fin 2))) =
    {FreeGroup.of 0, FreeGroup.of 1} := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp
  · rintro (h | h) <;> simp_all

theorem closure_fin2_eq_top :
    Subgroup.closure ({FreeGroup.of (0:Fin 2), FreeGroup.of (1:Fin 2)} :
      Set (FreeGroup (Fin 2))) = ⊤ := by
  rw [← range_of_fin2, FreeGroup.closure_range_of (Fin 2)]

/-- A subgroup of `F₂ = FreeGroup (Fin 2)` containing the two standard generators is everything. -/
theorem freeGroup_fin2_eq_top_of_mem {H : Subgroup (FreeGroup (Fin 2))}
    (ha : FreeGroup.of (0:Fin 2) ∈ H) (hb : FreeGroup.of (1:Fin 2) ∈ H) : H = ⊤ := by
  rw [eq_top_iff, ← closure_fin2_eq_top, Subgroup.closure_le]
  intro x hx
  rcases hx with hx | hx
  · rw [hx]; exact ha
  · rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hb

/-- **Generation of `F₂` by the band vertex and the low deck element.**

For the two-letter band data (`u = tlU p q`, weight `c = tlW p q`, window `[0, p*q]`, gauge `Wt`,
`τ = tlLowTau p q`, as in `Work.OROneRel.winRhoRange_tree`), the free group
`F₂ = FreeGroup (Fin 2)` is generated by the band vertex `H₀ = (winRho Wt c 0 (p*q)).range`
together with the low deck element `τ`:

`(winRho Wt (tlW p q) 0 (p*q)).range ⊔ Subgroup.closure {tlLowTau p q hp hq hcop} = ⊤`.

This is the connectivity half of Linton's one-dimensional splitting statement for the band graph
(the coset graph `GradedHNN.Coset H₀ τ` has vertex set `F₂ ⧸ H₀` and is connected exactly when this
generation holds).

Two remarks for the prover, to avoid a false refutation.

* The *equivalent* form is `⟪⋃_{k∈ℤ} τᵏH₀τ⁻ᵏ, τ⟫ = ⊤`: the two joins coincide, because
  `τᵏH₀τ⁻ᵏ ⊆ ⟨H₀,τ⟩` for all `k` and conversely `H₀` is the `k = 0` term of the union.  Proving it
  in that form is recommended.
* A tempting but **wrong** argument: "`H₀ ≤ ker (cohom)`, `cohom τ = ofAdd 1`, so every element of
  the join is `h·τⁿ`, whence `⟨H₀,τ⟩ ⊓ ker = H₀`; as `ker` is free of infinite rank (Nielsen–Schreier
  for the surjection `cohom : F₂ ↠ ℤ`) while `H₀` is finitely generated, the join is proper."  The
  first step is false: elements of `⟨H₀,τ⟩` are *words*, so `τ h τ⁻¹ ∈ ⟨H₀,τ⟩ ⊓ ker` although
  `τ h τ⁻¹ ∉ H₀` whenever `τH₀τ⁻¹ ≠ H₀`, which is the case here (`H₀` is *not* normal in `F₂`, and
  its `τ`-conjugates generate the infinitely generated kernel).

Geometrically: with `Y` the `ℤ`-cover of the two-petal rose, `D = winE c 0 (p*q) ⊂ Y` the band
(`ℤ·D = Y`), `H₀ = π₁(D)` and `τ = tlLowTau p q` lifting to a path of `D` from level `0` to level
`1` (`Work.OROneRel.tlLowTau_walk`), every loop of `X = ℤ∖Y` lifts to a path in `Y = ⋃_k tᵏ·D`,
which subdivides into loops inside the pieces `tᵏ·D` (classes conjugate to `H₀`) together with the
displacement `τ ^ (cohom)`. -/
theorem twoLetter_F2_generation (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (hW0 : Wt 0 = 1)
    (hcoh : ∀ i : ℤ, Work.OROneRel.cohom (Work.OROneRel.tlW p q) (Wt i) = Multiplicative.ofAdd i)
    (hwin : ∀ e ∈ Work.OROneRel.decor (Work.OROneRel.tlW p q) 0
        (Work.OROneRel.wordOf (Work.OROneRel.tlU p q)),
      Work.OROneRel.coverEdge e ∈ Work.OROneRel.winE (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ)))
    (htree : ∀ i : ℤ, 0 ≤ i → i ≤ (p : ℤ) * (q : ℤ) →
      ∀ e ∈ Work.OROneRel.decor (Work.OROneRel.tlW p q) 0 (Work.OROneRel.wordOf (Wt i)),
        Work.OROneRel.coverEdge e ∈
          Work.OROneRel.winTree Wt (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ))) :
    (Work.OROneRel.winRho Wt (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ))).range ⊔
        Subgroup.closure {Work.OROneRel.tlLowTau p q hp hq hcop} = ⊤ := by
  classical
  -- abbreviations: the deck element `τ` and the target subgroup `E`
  set τ : FreeGroup (Fin 2) := tlLowTau p q hp hq hcop with hτdef
  let E : Subgroup (FreeGroup (Fin 2)) :=
    (winRho Wt (tlW p q) 0 ((p:ℤ)*(q:ℤ))).range ⊔ Subgroup.closure {τ}
  change E = ⊤
  -- arithmetic of the window `[0, p*q]`
  have hq0 : (0:ℤ) ≤ (q:ℤ) := by positivity
  have hp0 : (0:ℤ) ≤ (p:ℤ) := by positivity
  have hpq0 : (0:ℤ) ≤ (p:ℤ)*(q:ℤ) := mul_nonneg hp0 hq0
  have hq_le : (q:ℤ) ≤ (p:ℤ)*(q:ℤ) := by
    have h1 : (1:ℤ) ≤ (p:ℤ) := by exact_mod_cast hp
    calc (q:ℤ) = 1 * (q:ℤ) := (one_mul _).symm
      _ ≤ (p:ℤ) * (q:ℤ) := mul_le_mul_of_nonneg_right h1 hq0
  have hp_le : (p:ℤ) ≤ (p:ℤ)*(q:ℤ) := by
    have h1 : (1:ℤ) ≤ (q:ℤ) := by exact_mod_cast hq
    calc (p:ℤ) = (p:ℤ) * 1 := (mul_one _).symm
      _ ≤ (p:ℤ) * (q:ℤ) := mul_le_mul_of_nonneg_left h1 hp0
  -- the weights of the two generators
  have hc0 : tlW p q (0:Fin 2) = (q:ℤ) := by simp [tlW]
  have hc1 : tlW p q (1:Fin 2) = -(p:ℤ) := by
    simp [tlW, show (1:Fin 2) ≠ 0 from by decide]
  -- `τ` has weight one
  have hτcoh : cohom (tlW p q) τ = Multiplicative.ofAdd 1 := by
    rw [hτdef]; exact tlLowTau_cohom p q hp hq hcop
  -- the band walks of `τ ^ q` and `τ ^ p`
  have hτq_walk : ∀ e ∈ decor (tlW p q) 0 (wordOf (τ^q)),
      coverEdge e ∈ winE (tlW p q) 0 ((p:ℤ)*(q:ℤ)) := by
    rw [hτdef]; exact tlLowTau_pow_walk p q q hp hq hcop (le_max_right p q)
  have hτp_walk : ∀ e ∈ decor (tlW p q) 0 (wordOf (τ^p)),
      coverEdge e ∈ winE (tlW p q) 0 ((p:ℤ)*(q:ℤ)) := by
    rw [hτdef]; exact tlLowTau_pow_walk p q p hp hq hcop (le_max_left p q)
  -- the weights of `τ ^ q` and `τ ^ p`
  have hlsigτq : lsig (tlW p q) (wordOf (τ^q)) = (q:ℤ) := by
    rw [lsig_wordOf_gen, map_pow, hτcoh]; simp
  have hlsigτp : lsig (tlW p q) (wordOf (τ^p)) = (p:ℤ) := by
    rw [lsig_wordOf_gen, map_pow, hτcoh]; simp
  -- `τ` and its powers lie in `E`
  have hτ_mem : τ ∈ E := Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_singleton τ))
  have hτq_mem : τ^q ∈ E := Subgroup.pow_mem E hτ_mem q
  have hτp_mem : τ^p ∈ E := Subgroup.pow_mem E hτ_mem p
  -- the closed band loop `τ ^ q * a⁻¹`
  have hloop_a : τ^q * (FreeGroup.of (0:Fin 2))⁻¹ ∈
      (winRho Wt (tlW p q) 0 ((p:ℤ)*(q:ℤ))).range := by
    have hLsig : lsig (tlW p q) (wordOf (τ^q) ++ [((0:Fin 2), false)]) = 0 := by
      rw [lsig_append_gen, hlsigτq, lsig_singleton_false_gen, hc0]
      ring
    have hLwalk : ∀ e ∈ decor (tlW p q) 0 (wordOf (τ^q) ++ [((0:Fin 2), false)]),
        coverEdge e ∈ winE (tlW p q) 0 ((p:ℤ)*(q:ℤ)) := by
      intro e he
      rw [decor_append, hlsigτq, zero_add] at he
      rcases List.mem_append.mp he with he | he
      · exact hτq_walk e he
      · rw [decor_singleton_false_gen] at he
        simp only [List.mem_singleton] at he
        rw [he]
        show (((0:Fin 2), (q:ℤ) - tlW p q (0:Fin 2)) : Fin 2 × ℤ) ∈
          winE (tlW p q) 0 ((p:ℤ)*(q:ℤ))
        rw [mem_winE]
        have hsub : (q:ℤ) - tlW p q (0:Fin 2) = 0 := by rw [hc0]; ring
        rw [hsub, zero_add, hc0]
        exact ⟨le_rfl, hpq0, hq0, hq_le⟩
    have h := mk_mem_winRho_range_of_decor Wt (tlW p q) 0 ((p:ℤ)*(q:ℤ)) hW0
      (wordOf (τ^q) ++ [((0:Fin 2), false)]) hLsig hLwalk
    rwa [← FreeGroup.mul_mk, mk_wordOf, mk_singleton_false_gen] at h
  -- the closed band loop `τ ^ p * b`
  have hloop_b : τ^p * FreeGroup.of (1:Fin 2) ∈
      (winRho Wt (tlW p q) 0 ((p:ℤ)*(q:ℤ))).range := by
    have hLsig : lsig (tlW p q) (wordOf (τ^p) ++ [((1:Fin 2), true)]) = 0 := by
      rw [lsig_append_gen, hlsigτp, lsig_singleton_true_gen, hc1]
      ring
    have hLwalk : ∀ e ∈ decor (tlW p q) 0 (wordOf (τ^p) ++ [((1:Fin 2), true)]),
        coverEdge e ∈ winE (tlW p q) 0 ((p:ℤ)*(q:ℤ)) := by
      intro e he
      rw [decor_append, hlsigτp, zero_add] at he
      rcases List.mem_append.mp he with he | he
      · exact hτp_walk e he
      · rw [decor_singleton_true_gen] at he
        simp only [List.mem_singleton] at he
        rw [he]
        show (((1:Fin 2), (p:ℤ)) : Fin 2 × ℤ) ∈ winE (tlW p q) 0 ((p:ℤ)*(q:ℤ))
        rw [mem_winE]
        have hsub : (p:ℤ) + tlW p q (1:Fin 2) = 0 := by rw [hc1]; ring
        rw [hsub]
        exact ⟨hp0, hp_le, le_rfl, hpq0⟩
    have h := mk_mem_winRho_range_of_decor Wt (tlW p q) 0 ((p:ℤ)*(q:ℤ)) hW0
      (wordOf (τ^p) ++ [((1:Fin 2), true)]) hLsig hLwalk
    rwa [← FreeGroup.mul_mk, mk_wordOf, mk_singleton_true_gen] at h
  -- the two standard generators lie in `E`
  have ha : FreeGroup.of (0:Fin 2) ∈ E := by
    have h1 : τ^q * (FreeGroup.of (0:Fin 2))⁻¹ ∈ E := Subgroup.mem_sup_left hloop_a
    have h2 : (τ^q)⁻¹ * (τ^q * (FreeGroup.of (0:Fin 2))⁻¹) ∈ E :=
      Subgroup.mul_mem E (Subgroup.inv_mem E hτq_mem) h1
    have heq : (τ^q)⁻¹ * (τ^q * (FreeGroup.of (0:Fin 2))⁻¹) =
        (FreeGroup.of (0:Fin 2))⁻¹ := by
      rw [← mul_assoc, inv_mul_cancel, one_mul]
    rw [heq] at h2
    simpa using Subgroup.inv_mem E h2
  have hb : FreeGroup.of (1:Fin 2) ∈ E := by
    have h1 : τ^p * FreeGroup.of (1:Fin 2) ∈ E := Subgroup.mem_sup_left hloop_b
    have h2 : (τ^p)⁻¹ * (τ^p * FreeGroup.of (1:Fin 2)) ∈ E :=
      Subgroup.mul_mem E (Subgroup.inv_mem E hτp_mem) h1
    have heq : (τ^p)⁻¹ * (τ^p * FreeGroup.of (1:Fin 2)) = FreeGroup.of (1:Fin 2) := by
      rw [← mul_assoc, inv_mul_cancel, one_mul]
    rw [heq] at h2
    exact h2
  exact freeGroup_fin2_eq_top_of_mem ha hb

end Work.OROneRel
