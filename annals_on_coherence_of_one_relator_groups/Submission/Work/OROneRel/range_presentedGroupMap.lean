import Mathlib
import Submission.Work.OROneRel.Basic

namespace Work.OROneRel

universe u

/-- The canonical map `F(T) →* ⟨α | r⟩` has range exactly the subgroup of `⟨α | r⟩` generated by
the images of the generators in `T`. -/
theorem range_presentedGroupMap {α : Type u} (r : FreeGroup α) (T : Set α) :
    (Work.OROneRel.presentedGroupMap r T).range = Work.OROneRel.magnusSubgroupOf r T := by
  unfold presentedGroupMap magnusSubgroupOf
  rw [MonoidHom.range_eq_map, ← FreeGroup.closure_range_of T, MonoidHom.map_closure,
    ← Set.range_comp]
  congr 1

end Work.OROneRel
