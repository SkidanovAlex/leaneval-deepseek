import Mathlib
import Submission.Work.OROneRel.winChainDefs
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.pinAux.loopsInE_eq_closure_stbLoop
import Submission.Work.pinAux.stbLoop_mem_loopsInE

/-!
# The vertex of the window is the loop group of the window

This file proves the identification announced in `Submission/Work/OROneRel/winChainDefs.lean`:

  `(winRho Wt c lo hi).range = W c (winE c lo hi) 0`,

i.e. the range of the class map of the window `[lo,hi]` -- the subgroup of `F α` generated by the
loop classes `Wt i · x · (Wt (i + c x))⁻¹` of the *non-tree* edges of the window -- is exactly the
subgroup `W` of `F α` generated by the closed walks at base level `0` whose decorated edges all lie
in the window.

## The argument

Both sides are identified with the subgroup generated by the loop classes of *all* the edges of the
window,

  `Subgroup.closure (stbLoop Wt c '' winE c lo hi)`,

using `stbLoop_eq_gaugeMap_of` (`stbLoop Wt c e = coverClassAt Wt c e`, so the Schreier loop class of
an edge is its class in the `ℤ`-cover):

* `(winRho Wt c lo hi).range ≤ Subgroup.closure (stbLoop Wt c '' winE c lo hi)`: the class map sends
  the symbol of a non-tree edge `e ∈ β ⊆ winE` to `stbLoop Wt c e`; conversely a symbol `e` with
  trivial class contributes `1`.  Both are immediate by induction on the word in `F β`.
* `Subgroup.closure (stbLoop Wt c '' winE c lo hi) ≤ (winRho Wt c lo hi).range`: for `e ∈ winE`, if
  the class of `e` is trivial then `stbLoop Wt c e = 1`; otherwise `e ∈ β` and `stbLoop Wt c e` is
  the image of the generator `of e`.
* `W c (winE c lo hi) 0 ≤ Subgroup.closure (stbLoop Wt c '' winE c lo hi)`: the telescoping identity
  `Work.pinAux.mul_mem_closure_stbLoop_decor` reads a closed walk at level `0` with edges in the
  window as the product `Wt 0 · mk L · (Wt (0 + 0))⁻¹ = mk L` of the loop classes of its decorated
  edges.
* `Subgroup.closure (stbLoop Wt c '' winE c lo hi) ≤ W c (winE c lo hi) 0`: for `e = (x,i) ∈ winE`
  the loop class `stbLoop Wt c e` is the loop
  `toWord (Wt i) ++ [(x,true)] ++ (toWord (Wt (i + c x)))⁻¹` based at level `0`
  (`Work.pinAux.stbLoop_mem_loopsInE`): the two tree paths stay in the window by the hypothesis
  `htree` at the levels `i` and `i + c x`, both of which lie in `[lo,hi]` because `e ∈ winE`, and
  `loopsInE_le_W` puts the loop group of the window inside `W`.

Note that only the *lower* bound `htree` enters (through the tree-path gauge), and that the first
three steps use no hypothesis at all beyond `Wt 0 = 1`.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- **The loop group of an edge set is contained in the subgroup `W` of closed walks in that edge
set**: both are generated by the words of the closed walks based at level `0` with edges in `E`,
`loopsInE` via its canonical (reduced-word) description `mem_loopsInE_iff`. -/
theorem loopsInE_le_W (c : α → ℤ) (E : Set (α × ℤ)) : loopsInE c E ≤ W c E 0 := by
  intro x hx
  rw [mem_loopsInE_iff] at hx
  obtain ⟨L, hmk, hlsig, hwalk⟩ := hx
  unfold W
  exact Subgroup.subset_closure ⟨L, ⟨hwalk, hlsig⟩, hmk⟩

theorem range_winRho_eq_W {α : Type u} [Fintype α] [DecidableEq α] (Wt : ℤ → FreeGroup α)
    (c : α → ℤ) {lo hi : ℤ} (hW0 : Wt 0 = 1)
    (hcoh : ∀ i : ℤ, Work.OROneRel.cohom c (Wt i) = Multiplicative.ofAdd i)
    (htree : ∀ i : ℤ, lo ≤ i → i ≤ hi →
      ∀ q ∈ Work.OROneRel.decor c 0 (FreeGroup.toWord (Wt i)),
        Work.OROneRel.coverEdge q ∈ Work.OROneRel.winTree Wt c lo hi) :
    (Work.OROneRel.winRho Wt c lo hi).range = Work.OROneRel.W c (Work.OROneRel.winE c lo hi) 0 := by
  classical
  -- the loop class of an edge of the level graph is its Schreier loop class
  have hcl : ∀ e : α × ℤ, coverClassAt Wt c e = stbLoop Wt c e := by
    intro e
    rw [coverClassAt, stbLoop, gaugeMap_of]
  -- the tree paths to the endpoints of an edge of the window stay in the window
  have htreeE : ∀ i : ℤ, lo ≤ i → i ≤ hi →
      ∀ q ∈ decor c 0 (FreeGroup.toWord (Wt i)), coverEdge q ∈ winE c lo hi :=
    fun i h1 h2 q hq => (mem_winTree.mp (htree i h1 h2 q hq)).1
  -- the loop class of an edge of the window lies in the range of the class map
  have hgen : ∀ e : α × ℤ, e ∈ winE c lo hi → stbLoop Wt c e ∈ (winRho Wt c lo hi).range := by
    intro e he
    rw [← hcl e]
    by_cases hne : coverClassAt Wt c e = 1
    · rw [hne]
      exact Subgroup.one_mem _
    · refine ⟨FreeGroup.of (⟨e, he, hne⟩ : winBeta Wt c lo hi), ?_⟩
      exact winRho_of Wt c lo hi (⟨e, he, hne⟩ : winBeta Wt c lo hi)
  -- the range of the class map is generated by the loop classes of the edges of the window
  have hstb_le : Subgroup.closure (stbLoop Wt c '' winE c lo hi) ≤
      (winRho Wt c lo hi).range := by
    rw [Subgroup.closure_le]
    rintro y ⟨e, he, rfl⟩
    exact hgen e he
  have hrange_le : (winRho Wt c lo hi).range ≤
      Subgroup.closure (stbLoop Wt c '' winE c lo hi) := by
    rintro x ⟨y, rfl⟩
    induction y using FreeGroup.induction_on with
    | one => exact Subgroup.one_mem _
    | of e =>
        rw [winRho_of]
        exact Subgroup.subset_closure ⟨e.1, e.2.1, (hcl e.1).symm⟩
    | inv_of e ih => simpa using Subgroup.inv_mem _ ih
    | mul a b ha hb => simpa using Subgroup.mul_mem _ ha hb
  -- the subgroup of closed walks in the window is the same subgroup
  have hW_le : W c (winE c lo hi) 0 ≤ Subgroup.closure (stbLoop Wt c '' winE c lo hi) := by
    unfold W
    rw [Subgroup.closure_le]
    rintro x ⟨L, ⟨hwalk, hlsig⟩, rfl⟩
    have h := Work.pinAux.mul_mem_closure_stbLoop_decor Wt c (winE c lo hi) 0 L hwalk
    rw [hlsig, add_zero] at h
    rw [hW0] at h
    simpa using h
  have hle_W : Subgroup.closure (stbLoop Wt c '' winE c lo hi) ≤ W c (winE c lo hi) 0 := by
    rw [Subgroup.closure_le]
    rintro y ⟨e, he, rfl⟩
    have hmem := mem_winE.mp he
    have h1 : stbLoop Wt c e ∈ loopsInE c (winE c lo hi) :=
      Work.pinAux.stbLoop_mem_loopsInE Wt c hcoh he
        (fun p hp => htreeE e.2 hmem.1 hmem.2.1 p hp)
        (fun p hp => htreeE (e.2 + c e.1) hmem.2.2.1 hmem.2.2.2 p hp)
    exact loopsInE_le_W c (winE c lo hi) h1
  exact le_antisymm (hrange_le.trans hle_W) (hW_le.trans hstb_le)

end Work.OROneRel
