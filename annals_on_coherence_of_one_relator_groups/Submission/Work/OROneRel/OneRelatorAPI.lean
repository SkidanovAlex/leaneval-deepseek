/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).
-/
import Submission.Work.OROneRel.Interface
import ChallengeDeps

/-!
# The interface of node `N2` against `Group.OneRelator`

`Group.OneRelator G` (from `ChallengeDeps.lean`) says `G ≅ ⟨α | r⟩` for some generating type `α` and
some `r : FreeGroup α`.  Here we record the elementary API connecting the vocabulary of this
subproject with it, and the canonical Magnus subgroups.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- Every one-relator presentation presents a one-relator group. -/
theorem group_oneRelator_presentedGroup (r : FreeGroup α) :
    Group.OneRelator (PresentedGroup ({r} : Set (FreeGroup α))) :=
  ⟨α, r, ⟨MulEquiv.refl _⟩⟩

/-- The class of one-relator groups is closed under isomorphism. -/
theorem Group.OneRelator.of_mulEquiv {G H : Type u} [Group G] [Group H] (h : Group.OneRelator G)
    (e : G ≃* H) : Group.OneRelator H := by
  obtain ⟨α, r, ⟨e'⟩⟩ := h
  exact ⟨α, r, ⟨e'.trans e⟩⟩

/-- The subgroup generated by a set of generators not generating the relator is a Magnus subgroup. -/
theorem isMagnusSubgroup_magnusSubgroupOf (r : FreeGroup α) {T : Set α}
    (h : r ∉ Subgroup.closure (FreeGroup.of '' T)) :
    IsMagnusSubgroup (magnusSubgroupOf r T) :=
  ⟨T, h, rfl⟩

/-- The canonical Magnus subgroup of `⟨α | r⟩` (all generators but `x`) is a Magnus subgroup as
soon as the relator `r` is not generated by `α \ {x}`. -/
theorem isMagnusSubgroup_magnusSubgroup (r : FreeGroup α) (x : α)
    (h : r ∉ Subgroup.closure (FreeGroup.of '' {a | a ≠ x})) :
    IsMagnusSubgroup (magnusSubgroup r x) :=
  isMagnusSubgroup_magnusSubgroupOf r h

/-- `1` is a terminal relator: the corresponding one-relator group is free. -/
theorem isTerminalRelator_one : IsTerminalRelator (1 : FreeGroup α) :=
  Or.inl rfl

/-- A relator is terminal iff it is trivial or a nonzero power of a single generator. -/
theorem isTerminalRelator_iff (r : FreeGroup α) :
    IsTerminalRelator r ↔ r = 1 ∨ ∃ (x : α) (m : ℤ), m ≠ 0 ∧ r = FreeGroup.of x ^ m :=
  Iff.rfl

/-- `IsMagnusSubgroup` is a property of the canonical Magnus subgroups. -/
theorem isMagnusSubgroup_iff {r : FreeGroup α}
    {A : Subgroup (PresentedGroup ({r} : Set (FreeGroup α)))} :
    IsMagnusSubgroup A ↔
      ∃ T : Set α, r ∉ Subgroup.closure (FreeGroup.of '' T) ∧ A = magnusSubgroupOf r T :=
  Iff.rfl

/-- Larger generating sets give larger subgroups of `⟨α | r⟩`. -/
theorem magnusSubgroupOf_mono (r : FreeGroup α) {T T' : Set α} (h : T ⊆ T') :
    magnusSubgroupOf r T ≤ magnusSubgroupOf r T' :=
  Subgroup.closure_mono (by rintro y ⟨a, rfl⟩; exact ⟨⟨a.1, h a.2⟩, rfl⟩)

end Work.OROneRel
