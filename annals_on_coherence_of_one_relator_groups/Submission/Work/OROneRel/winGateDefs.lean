import Mathlib
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.OROneRel.hnnConjSplit

/-!
# The gate subgroups of the window decomposition

For the window decomposition of `Submission/Work/OROneRel/winBasisDefs.lean` with vertex
`H = winVertex Wt c lo hi u l ≤ ⟨α | u ^ l⟩` and stable letter `t = mk τ`
(`Submission/Work/OROneRel/winAssembly.lean`, `Submission/Work/OROneRel/hnnConjSplit.lean`), the
associated subgroups of the HNN decomposition are generated by the loop classes of the edges of the
*gates* -- the intersections of the window with its translates.  This file fixes that vocabulary.

* `winBetaSub Wt c S` -- the non-tree edges of the window that lie in an edge set `S`; for
  `S = winE c lo hi ∩ winE c (lo+1) (hi+1)` this is the alphabet of `π₁ (D ∩ tD)`, for
  `S = winE c lo hi ∩ winE c (lo-1) (hi-1)` that of `π₁ (D ∩ t⁻¹D)`.  These intersections carry no
  `2`-cell when the window is the band of the walk (hypothesis `hone` of
  `Work.OROneRel.winVertexSplits_band`), so their fundamental groups are free: this is why the gate
  group is `F` of the corresponding `winBetaSub`, and the two inputs needed from the geometry are

  * the *injectivity* of `F (winBetaSub ...) → F (winBeta ...) → F (winBeta ...) / ⟪v ^ l⟫`
    (the `hgateInj` hypotheses of `winVertexSplits_band`), and
  * that the image of the gate in `G` generates the maximal associated subgroup `H ⊓ t H t⁻¹`.

* `winBetaSubVal`/`winBetaSubIncl` -- the inclusion of the gate alphabet into `β` and of the free
  groups;
* `winGateSub` -- the subgroup of `⟨α | u ^ l⟩` generated by the loop classes of the gate edges (the
  image of `π₁ (D ∩ tD)` under the class map).
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- **The gate alphabet**: the edges of a set `S` of edges of the window whose loop class is
non-trivial (the "non-tree edges of `S`"). -/
def winBetaSub (Wt : ℤ → FreeGroup α) (c : α → ℤ) (S : Set (α × ℤ)) : Type u :=
  {e : α × ℤ // e ∈ S ∧ Work.OROneRel.coverClassAt Wt c e ≠ 1}

theorem winBetaSub_val_mem {Wt : ℤ → FreeGroup α} {c : α → ℤ} {S : Set (α × ℤ)}
    (e : winBetaSub Wt c S) : e.1 ∈ S := e.2.1

theorem winBetaSub_val_class {Wt : ℤ → FreeGroup α} {c : α → ℤ} {S : Set (α × ℤ)}
    (e : winBetaSub Wt c S) : Work.OROneRel.coverClassAt Wt c e.1 ≠ 1 := e.2.2

/-- **The gate alphabet sits inside the vertex alphabet.** -/
def winBetaSubVal (Wt : ℤ → FreeGroup α) (c : α → ℤ) {lo hi : ℤ} {S : Set (α × ℤ)}
    (hS : S ⊆ Work.OROneRel.winE c lo hi) (e : winBetaSub Wt c S) :
    Work.OROneRel.winBeta Wt c lo hi :=
  ⟨e.1, hS e.2.1, e.2.2⟩

@[simp] theorem winBetaSubVal_coe (Wt : ℤ → FreeGroup α) (c : α → ℤ) {lo hi : ℤ} {S : Set (α × ℤ)}
    (hS : S ⊆ Work.OROneRel.winE c lo hi) (e : winBetaSub Wt c S) :
    (winBetaSubVal Wt c hS e).1 = e.1 := rfl

/-- **The inclusion of the gate free group into the vertex free group.** -/
noncomputable def winBetaSubIncl (Wt : ℤ → FreeGroup α) (c : α → ℤ) {lo hi : ℤ}
    {S : Set (α × ℤ)} (hS : S ⊆ Work.OROneRel.winE c lo hi) :
    FreeGroup (winBetaSub Wt c S) →* FreeGroup (Work.OROneRel.winBeta Wt c lo hi) :=
  FreeGroup.map (winBetaSubVal Wt c hS)

@[simp] theorem winBetaSubIncl_of (Wt : ℤ → FreeGroup α) (c : α → ℤ) {lo hi : ℤ}
    {S : Set (α × ℤ)} (hS : S ⊆ Work.OROneRel.winE c lo hi) (e : winBetaSub Wt c S) :
    winBetaSubIncl Wt c hS (FreeGroup.of e) =
      FreeGroup.of (winBetaSubVal Wt c hS e) := by
  classical
  rw [winBetaSubIncl, FreeGroup.map.of]

/-- **The class map of a gate**: the composite of the gate inclusion with the vertex class map is the
free-group map sending a gate edge to its loop class. -/
theorem winRho_winBetaSubIncl (Wt : ℤ → FreeGroup α) (c : α → ℤ) {lo hi : ℤ}
    {S : Set (α × ℤ)} (hS : S ⊆ Work.OROneRel.winE c lo hi)
    (x : FreeGroup (winBetaSub Wt c S)) :
    Work.OROneRel.winRho Wt c lo hi (winBetaSubIncl Wt c hS x) =
      FreeGroup.lift (fun e : winBetaSub Wt c S =>
        Work.OROneRel.coverClassAt Wt c e.1) x := by
  classical
  have key : (Work.OROneRel.winRho Wt c lo hi).comp (winBetaSubIncl Wt c hS) =
      FreeGroup.lift (fun e : winBetaSub Wt c S =>
        Work.OROneRel.coverClassAt Wt c e.1) :=
    FreeGroup.ext_hom _ _ (fun e => by
      rw [MonoidHom.comp_apply, winBetaSubIncl_of, Work.OROneRel.winRho_of,
        FreeGroup.lift_apply_of]
      rfl)
  exact congrArg (fun f : FreeGroup (winBetaSub Wt c S) →* FreeGroup α => f x) key

/-- **The gate subgroup of `⟨α | u ^ l⟩`**: the image of `π₁` of the gate subgraph under the class
map, i.e. the subgroup generated by the classes of the gate edges. -/
noncomputable def winGateSub (Wt : ℤ → FreeGroup α) (c : α → ℤ) (lo hi : ℤ) (u : FreeGroup α)
    (l : ℕ) (S : Set (α × ℤ)) (hS : S ⊆ Work.OROneRel.winE c lo hi) :
    Subgroup (PresentedGroup ({u ^ l} : Set (FreeGroup α))) :=
  Subgroup.closure {g : PresentedGroup ({u ^ l} : Set (FreeGroup α)) |
    ∃ e : winBetaSub Wt c S,
      g = PresentedGroup.mk ({u ^ l} : Set (FreeGroup α))
        (Work.OROneRel.winRho Wt c lo hi (FreeGroup.of (winBetaSubVal Wt c hS e)))}

theorem mem_winGateSub (Wt : ℤ → FreeGroup α) (c : α → ℤ) {lo hi : ℤ} {u : FreeGroup α} {l : ℕ}
    {S : Set (α × ℤ)} (hS : S ⊆ Work.OROneRel.winE c lo hi) (e : winBetaSub Wt c S) :
    PresentedGroup.mk ({u ^ l} : Set (FreeGroup α))
        (Work.OROneRel.winRho Wt c lo hi (FreeGroup.of (winBetaSubVal Wt c hS e))) ∈
      winGateSub Wt c lo hi u l S hS :=
  Subgroup.subset_closure ⟨e, rfl⟩

end Work.OROneRel
