import Mathlib

namespace Work.OROneRel

/-- The normal closure of a set of free generators is the union of the normal closures of its
finite subsets: an element of a normal closure is a finite product of conjugates of finitely many
generators. -/
theorem normalClosure_finite_subset {S : Type*} {T : Set S} {y : FreeGroup S}
    (hy : y ∈ Subgroup.normalClosure (FreeGroup.of '' T)) :
    ∃ T' : Set S, T' ⊆ T ∧ T'.Finite ∧ y ∈ Subgroup.normalClosure (FreeGroup.of '' T') := by
  classical
  -- Index the family of normal closures by the finite subsets of `T`.
  let ι := { A : Set S // A ⊆ T ∧ A.Finite }
  haveI : Nonempty ι := ⟨⟨∅, Set.empty_subset T, Set.finite_empty⟩⟩
  let K : ι → Subgroup (FreeGroup S) :=
    fun i => Subgroup.normalClosure (FreeGroup.of '' (i : Set S))
  -- The family is directed: finite subsets are closed under union.
  have hdir : Directed (· ≤ ·) K := by
    intro i j
    refine ⟨⟨(i : Set S) ∪ (j : Set S), Set.union_subset i.2.1 j.2.1, i.2.2.union j.2.2⟩,
      ?_, ?_⟩
    · exact Subgroup.normalClosure_mono (Set.image_mono Set.subset_union_left)
    · exact Subgroup.normalClosure_mono (Set.image_mono Set.subset_union_right)
  -- The whole normal closure is generated by the directed family.
  have hle : Subgroup.normalClosure (FreeGroup.of '' T) ≤ ⨆ i, K i := by
    apply Subgroup.normalClosure_le_normal
    rintro x ⟨t, ht, rfl⟩
    refine (Subgroup.mem_iSup_of_directed (K := K) hdir).mpr
      ⟨⟨{t}, fun s hs => by simpa using (Set.mem_singleton_iff.mp hs ▸ ht),
        Set.finite_singleton t⟩, ?_⟩
    exact Subgroup.subset_normalClosure ⟨t, rfl, rfl⟩
  -- Hence `y` lies in a single member of the family.
  obtain ⟨i, hi⟩ := (Subgroup.mem_iSup_of_directed (K := K) hdir).mp (hle hy)
  exact ⟨(i : Set S), i.2.1, i.2.2, hi⟩

end Work.OROneRel
