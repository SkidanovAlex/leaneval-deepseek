import Mathlib
import Submission.Work.OROneRel.winAssembly
import Submission.Work.OROneRel.twoLetter_generation
import Submission.Work.ORBassSerre.Action.isTree_orbitV_of_normalClosure_elliptic
import Submission.Work.ORDunwoody.freeOnTreeIsFree_quotient
import Submission.Work.ORBassSerre.QuotientTree.stabilizer_quotient_mk

namespace Work.OROneRel

/-- **The band `G`-tree from the band `F₂`-tree.**

Let `F₂ = FreeGroup (Fin 2)`, `u = Work.OROneRel.tlU p q`, `N = ⟪⟪u ^ l⟫⟫ ≤ F₂`, and let
`G = PresentedGroup {u ^ l} = F₂ ⧸ N`.  Suppose `F₂` acts (via a `GraphAction`) on a tree `V`
without inversions, with a vertex `v` whose stabiliser is exactly
`H₀ = (winRho Wt (tlW p q) 0 (p*q)).range`, and with an edge `v ⟶ z` such that
`tlLowTau p q • z = v` (this is the explicit form of the conclusion of
`Work.OROneRel.winRhoRange_tree`).

Then the quotient graph `V ⧸ N = Work.ORBassSerre.orbitV N V` is
* a tree (`isTree_orbitV_of_normalClosure_elliptic`; note `u = winRho (winRoot) ∈ H₀` by
  `winRho_winRoot`, so `u ^ l` is elliptic);
* acted on by `G` without inversions (`Work.ORDunwoody.quotient_actsWithoutInversions`, whose
  instance `Work.ORDunwoody.instGraphActionQuotientOrbit` is the canonical
  `GraphAction (F₂ ⧸ N) (orbitV N V)`, cf. `QuotientGroupOrbitV.lean`);
* and the stabiliser of the class of `v` is
  `(Stab_{F₂} v).map (QuotientGroup.mk' N) = winVertex …`
  (`Work.ORBassSerre.QuotientTree.stabilizer_quotient_mk` together with
  `winVertex = (winRho.range).map (PresentedGroup.mk _)`), while the class of the edge is closed up
  by the class of the stable letter (`quotient_smul_mk`).

This is the bookkeeping that makes the free-group statement of `winRhoRange_tree` sufficient for the
`G`-tree data consumed by `Work.OROneRel.hnnConjMap_injective_of_treeData` (hence for the target). -/
theorem twoLetter_treeData_of_F2treeData (p q l : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hcop : Nat.Coprime p q) (Wt : ℤ → FreeGroup (Fin 2)) (hW0 : Wt 0 = 1)
    (hwin : ∀ e ∈ Work.OROneRel.decor (Work.OROneRel.tlW p q) 0
        (Work.OROneRel.wordOf (Work.OROneRel.tlU p q)),
      Work.OROneRel.coverEdge e ∈ Work.OROneRel.winE (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ)))
    {V : Type} [Quiver V] [Quiver.HasInvolutiveReverse V]
    [MulAction (FreeGroup (Fin 2)) V]
    [Work.ORBassSerre.GraphAction (FreeGroup (Fin 2)) V]
    (hT : Work.ORBassSerre.IsTree V)
    (hninv : Work.ORBassSerre.ActsWithoutInversions (FreeGroup (Fin 2)) V)
    (v : V) {z : V} (e : v ⟶ z)
    (hstab : MulAction.stabilizer (FreeGroup (Fin 2)) v
      = (Work.OROneRel.winRho Wt (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ))).range)
    (hclose : (Work.OROneRel.tlLowTau p q hp hq hcop) • z = v) :
    Work.ORBassSerre.IsTree (Work.ORBassSerre.orbitV
        (Subgroup.normalClosure ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2)))) V) ∧
      Work.ORBassSerre.ActsWithoutInversions
        (FreeGroup (Fin 2) ⧸ Subgroup.normalClosure
          ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2))))
        (Work.ORBassSerre.orbitV
          (Subgroup.normalClosure ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2)))) V) ∧
      MulAction.stabilizer
          (FreeGroup (Fin 2) ⧸ Subgroup.normalClosure
            ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2))))
          (Quotient.mk'' v : Work.ORBassSerre.orbitV
            (Subgroup.normalClosure ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2)))) V)
        = Work.OROneRel.winVertex Wt (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ))
            (Work.OROneRel.tlU p q) l ∧
      (QuotientGroup.mk'
          (Subgroup.normalClosure ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2))))
          (Work.OROneRel.tlLowTau p q hp hq hcop)) •
          (Quotient.mk'' z : Work.ORBassSerre.orbitV
            (Subgroup.normalClosure ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2)))) V)
        = Quotient.mk'' v := by
  -- `u = tlU p q` is elliptic: it is the value of `winRho` at the deleted walk word `winRoot`,
  -- hence lies in `H₀ = winRho.range = Stab_{F₂} v`.
  have hu_mem : Work.OROneRel.tlU p q ∈
      (Work.OROneRel.winRho Wt (Work.OROneRel.tlW p q) 0 ((p : ℤ) * (q : ℤ))).range :=
    ⟨_, Work.OROneRel.winRho_winRoot Wt hW0 (Work.OROneRel.cohom_tlW_tlU_local p q) 0
      ((p : ℤ) * (q : ℤ)) hwin⟩
  have hfix : (Work.OROneRel.tlU p q ^ l) • v = v := by
    rw [← MulAction.mem_stabilizer_iff, hstab]
    exact Subgroup.pow_mem _ hu_mem l
  have hE : ∀ g ∈ ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2))),
      ∃ w : V, g • w = w := by
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    exact ⟨v, hfix⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- `V ⧸ N` is a tree: `N = ⟪⟪u ^ l⟫⟫` is generated by the elliptic element `u ^ l`.
    exact Work.ORBassSerre.Action.isTree_orbitV_of_normalClosure_elliptic (G := FreeGroup (Fin 2))
      (V := V) hT (Subgroup.normalClosure ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2))))
      ({Work.OROneRel.tlU p q ^ l} : Set (FreeGroup (Fin 2))) hE rfl
  · -- no inversions are inherited by the quotient.
    exact Work.ORDunwoody.quotient_actsWithoutInversions hninv _
  · -- the stabiliser of the class of `v` is `(Stab v).map (mk' N) = winVertex …`.
    rw [Work.ORBassSerre.QuotientTree.stabilizer_quotient_mk, hstab]
    rfl
  · -- the class of the edge is closed up by the class of the stable letter.
    rw [Work.ORBassSerre.quotient_smul_mk, hclose]

end Work.OROneRel
