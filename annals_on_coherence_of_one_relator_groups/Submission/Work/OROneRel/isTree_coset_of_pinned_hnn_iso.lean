import Mathlib
import Submission.Work.OROneRel.graded_hnn_coset
import Submission.Work.ORBassSerre.Tree.Basic
import Submission.Work.ORBassSerre.HNN.Tree
import Submission.Work.ORBassSerre.HNN.Graph
import Submission.Work.ORDunwoody.Lemmas.GraphQuiverTree
import Submission.Work.OROneRel.isTree_lineGraph_iff

/-!
# The coset graph of a group which *is* an HNN extension is a tree

Let `H ≤ G`, `τ ∈ G`, and suppose that `K := HNN(↥H, A, B, φ)` is isomorphic to `G` by an
isomorphism `e` which is *pinned*: `e (of h) = h` for `h ∈ ↥H` and `e t = τ` (where `t` is the
stable letter and `of` the canonical map `↥H →* K`).  Then `G` is generated by `H` and `τ`
subject to the HNN relation `τ a τ⁻¹ = φ a`, so `(G, H, τ)` is an HNN extension in the
Bass--Serre sense, and hence the coset graph with vertices the left cosets `gH` and edges
`{gH, gτH}` is a tree.

The proof does not use any normal form of the HNN extension.  Instead we compare the coset graph
of `(H, τ)` in `G` with the Bass--Serre graph of the *abstract* HNN extension `K`:

* `e` induces a bijection `ψ : G ⧸ H ≃ K ⧸ of.range` (a `Quotient.congr`), and
  `ψ (gH) = (e.symm g) · of.range`;
* under `ψ`, the adjacency `{gH, gτH}` of the coset graph corresponds exactly to the adjacency
  `{k, kt}` of `Work.ORBassSerre.HNN.hnnGraph` (`pinned_adjC_iff`);
* the latter graph is a tree (`Work.ORBassSerre.HNN.hnnGraph_isTree`), made into a quiver by
  `Work.ORDunwoody.Lemmas.graphQuiver` and a tree in the Bass--Serre sense by
  `Work.ORDunwoody.Lemmas.graphQuiver_isTree` applied to the natural action of `K`;
* tree-ness transports along the resulting isomorphism of quivers
  (`Work.OROneRel.isTree_iff_of_prefunctors`).

## Main results

* `Work.OROneRel.pinnedCosetEquiv` : the bijection `G ⧸ H ≃ K ⧸ of.range` induced by `e`.
* `Work.OROneRel.pinned_adjC_iff` : the adjacency correspondence.
* `Work.OROneRel.isTree_coset_of_pinned_hnn_iso` : the coset graph is a tree.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.OROneRel

open Quiver

universe u

variable {G : Type u} [Group G] {H : Subgroup G} {τ : G} {A B : Subgroup ↥H} {φ : A ≃* B}

/-- The isomorphism `e : HNN(↥H, A, B, φ) ≃* G` carries the range of the canonical map `of` into
`H` (in fact onto it), because it is pinned on the base. -/
theorem pinned_ofE_mem (e : HNNExtension ↥H A B φ ≃* G)
    (he_of : ∀ h : ↥H, e (HNNExtension.of h) = (h : G)) :
    ∀ k ∈ (HNNExtension.of : ↥H →* HNNExtension ↥H A B φ).range, e k ∈ H := by
  rintro k ⟨h, rfl⟩
  rw [he_of h]
  exact h.2

/-- Conversely, the inverse of a pinned isomorphism carries `H` into the range of `of`. -/
theorem pinned_symm_mem (e : HNNExtension ↥H A B φ ≃* G)
    (he_of : ∀ h : ↥H, e (HNNExtension.of h) = (h : G)) :
    ∀ g ∈ H, e.symm g ∈ (HNNExtension.of : ↥H →* HNNExtension ↥H A B φ).range := by
  intro g hg
  refine ⟨⟨g, hg⟩, ?_⟩
  exact ((MulEquiv.symm_apply_eq e).mpr (by rw [he_of])).symm

/-- The inverse of a pinned isomorphism sends the stable letter to the stable letter. -/
theorem pinned_symm_t (e : HNNExtension ↥H A B φ ≃* G) (he_t : e HNNExtension.t = τ) :
    e.symm τ = HNNExtension.t := by
  rw [← he_t, MulEquiv.symm_apply_apply]

/-- **The vertex bijection of the Bass--Serre trees.**  A pinned isomorphism
`e : HNN(↥H, A, B, φ) ≃* G` induces a bijection between the cosets `G ⧸ H` (the vertices of the
coset graph of `(H, τ)` in `G`) and the cosets `K ⧸ of.range` (the vertices of the Bass--Serre
graph of the abstract HNN extension `K`). -/
noncomputable def pinnedCosetEquiv (e : HNNExtension ↥H A B φ ≃* G)
    (he_of : ∀ h : ↥H, e (HNNExtension.of h) = (h : G)) :
    GradedHNN.Coset H τ ≃
      Work.ORBassSerre.HNN.VSet (G := ↥H) (A := A) (B := B) (φ := φ) :=
  Quotient.congr e.symm.toEquiv (fun a b => by
    have h1 : (e.symm a)⁻¹ * e.symm b = e.symm (a⁻¹ * b) := by rw [map_mul, map_inv]
    rw [QuotientGroup.leftRel_apply, QuotientGroup.leftRel_apply]
    change a⁻¹ * b ∈ H ↔
      (e.symm a)⁻¹ * e.symm b ∈ (HNNExtension.of : ↥H →* HNNExtension ↥H A B φ).range
    rw [h1]
    exact ⟨pinned_symm_mem e he_of _, fun hab => by
      have h2 : a⁻¹ * b = e (e.symm (a⁻¹ * b)) := (MulEquiv.apply_symm_apply e _).symm
      rw [h2]
      exact pinned_ofE_mem e he_of _ hab⟩)

/-- The value of the vertex bijection on a coset. -/
@[simp] theorem pinnedCosetEquiv_mk (e : HNNExtension ↥H A B φ ≃* G)
    (he_of : ∀ h : ↥H, e (HNNExtension.of h) = (h : G)) (g : G) :
    pinnedCosetEquiv (τ := τ) e he_of (GradedHNN.cmk H τ g) =
      Work.ORBassSerre.HNN.qmk (e.symm g) :=
  rfl

/-- **The adjacency correspondence.**  The coset graph of `(H, τ)` in `G` and the Bass--Serre graph
of the abstract HNN extension `K = HNN(↥H, A, B, φ)` are isomorphic under the vertex bijection
`pinnedCosetEquiv`. -/
theorem pinned_adjC_iff (e : HNNExtension ↥H A B φ ≃* G)
    (he_of : ∀ h : ↥H, e (HNNExtension.of h) = (h : G))
    (he_t : e HNNExtension.t = τ) (x y : GradedHNN.Coset H τ) :
    GradedHNN.adjC H τ x y ↔
      (Work.ORBassSerre.HNN.hnnGraph (G := ↥H) (A := A) (B := B) (φ := φ)).Adj
        (pinnedCosetEquiv (τ := τ) e he_of x) (pinnedCosetEquiv (τ := τ) e he_of y) := by
  have hψt : e.symm τ = HNNExtension.t := pinned_symm_t (τ := τ) e he_t
  constructor
  · rintro ⟨g, h | h⟩
    · exact ⟨e.symm g, Or.inl ⟨by rw [h.1, pinnedCosetEquiv_mk],
        by rw [h.2, pinnedCosetEquiv_mk, map_mul, hψt]⟩⟩
    · exact ⟨e.symm g, Or.inr ⟨by rw [h.1, pinnedCosetEquiv_mk],
        by rw [h.2, pinnedCosetEquiv_mk, map_mul, hψt]⟩⟩
  · rintro ⟨k, h | h⟩
    · obtain ⟨g, rfl⟩ := e.symm.surjective k
      refine ⟨g, Or.inl ⟨?_, ?_⟩⟩
      · exact (pinnedCosetEquiv (τ := τ) e he_of).injective
          (by rw [pinnedCosetEquiv_mk, h.1])
      · exact (pinnedCosetEquiv (τ := τ) e he_of).injective
          (by rw [pinnedCosetEquiv_mk, map_mul, hψt, h.2])
    · obtain ⟨g, rfl⟩ := e.symm.surjective k
      refine ⟨g, Or.inr ⟨?_, ?_⟩⟩
      · exact (pinnedCosetEquiv (τ := τ) e he_of).injective
          (by rw [pinnedCosetEquiv_mk, h.1])
      · exact (pinnedCosetEquiv (τ := τ) e he_of).injective
          (by rw [pinnedCosetEquiv_mk, map_mul, hψt, h.2])

/-- **The coset graph of `(H, τ)` is a tree** whenever `G` is (pinned to) an HNN extension of `H`
with stable letter `τ`.

This is the "Bass--Serre tree of an HNN extension", phrased for the coset graph of the pair
`(H, τ)`: `e` identifies it with the Bass--Serre graph of the abstract extension
`HNN(↥H, A, B, φ)`, which is a tree by `Work.ORBassSerre.HNN.hnnGraph_isTree`. -/
theorem isTree_coset_of_pinned_hnn_iso {G : Type u} [Group G] (H : Subgroup G) (τ : G)
    (A B : Subgroup ↥H) (φ : A ≃* B)
    (e : HNNExtension ↥H A B φ ≃* G)
    (he_of : ∀ h : ↥H, e (HNNExtension.of h) = (h : G))
    (he_t : e HNNExtension.t = τ) :
    Work.ORBassSerre.IsTree (Work.OROneRel.GradedHNN.Coset H τ) := by
  let Vtx := Work.ORBassSerre.HNN.VSet (G := ↥H) (A := A) (B := B) (φ := φ)
  let gph := Work.ORBassSerre.HNN.hnnGraph (G := ↥H) (A := A) (B := B) (φ := φ)
  let ψ := pinnedCosetEquiv (τ := τ) e he_of
  -- the Bass--Serre graph of the abstract HNN extension, as a quiver with proof-irrelevant arrows
  letI : Quiver.{u, u} Vtx := @Work.ORDunwoody.Lemmas.graphQuiver.{u, u} Vtx gph
  letI : HasInvolutiveReverse.{u, u} Vtx :=
    @Work.ORDunwoody.Lemmas.graphQuiverHasInvolutiveReverse.{u, u} Vtx gph
  -- `K` acts on the coset space by left multiplication, so the Bass--Serre graph is a
  -- `Work.ORDunwoody.GTree`, and hence its edge quiver is a Bass--Serre tree
  have hTreeV : @Work.ORBassSerre.IsTree.{u, u} Vtx
      (@Work.ORDunwoody.Lemmas.graphQuiver.{u, u} Vtx gph)
      (@Work.ORDunwoody.Lemmas.graphQuiverHasInvolutiveReverse.{u, u} Vtx gph) :=
    Work.ORDunwoody.Lemmas.graphQuiver_isTree
      ({ graph := gph
         isTree := Work.ORBassSerre.HNN.hnnGraph_isTree (G := ↥H) (A := A) (B := B) (φ := φ)
         smul_adj := fun g _ _ h => Work.ORBassSerre.HNN.smul_adj (G := ↥H) (A := A) (B := B)
           (φ := φ) g h } : Work.ORDunwoody.GTree (HNNExtension ↥H A B φ) Vtx)
  -- the two quivers are isomorphic by the vertex bijection, compatibly with the adjacency
  let F : GradedHNN.Coset H τ ⥤q Vtx :=
    ⟨ψ, fun {x y} f => ULift.up ⟨(),
      (pinned_adjC_iff (τ := τ) e he_of he_t x y).1 f.down⟩⟩
  let F' : Vtx ⥤q GradedHNN.Coset H τ :=
    ⟨ψ.symm, fun {X Y} f => ⟨(pinned_adjC_iff (τ := τ) e he_of he_t (ψ.symm X) (ψ.symm Y)).2
      (by rw [ψ.apply_symm_apply, ψ.apply_symm_apply]; exact f.down.2)⟩⟩
  haveI : F.MapReverse := ⟨fun {_ _} _ => Subsingleton.elim _ _⟩
  haveI : F'.MapReverse := ⟨fun {_ _} _ => Subsingleton.elim _ _⟩
  have hFG : ∀ y : Vtx, F.obj (F'.obj y) = y := fun y => ψ.apply_symm_apply y
  have hGF : ∀ x : GradedHNN.Coset H τ, F'.obj (F.obj x) = x := fun x => ψ.symm_apply_apply x
  exact (Work.OROneRel.isTree_iff_of_prefunctors F F' ψ.injective
    (fun {_ _} a b _ => Subsingleton.elim a b) ψ.symm.injective
    (fun {_ _} a b _ => Subsingleton.elim a b) hFG hGF).2 hTreeV

end Work.OROneRel
