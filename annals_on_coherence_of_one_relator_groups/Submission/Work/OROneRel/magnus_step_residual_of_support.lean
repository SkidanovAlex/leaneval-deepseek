import Mathlib
import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.MagnusGenDefs
import Submission.Work.OROneRel.hasMagnusStepAt_map_of_injective
import Submission.Work.OROneRel.eps_map_of_injective
import Submission.Work.OROneRel.cohom_comp_map
import Submission.Work.OROneRel.count_toWord_map_of_injective
import Submission.Work.OROneRel.mem_relatorLetters_map_iff

namespace Work.OROneRel

universe u

/-- A proper power maps to a proper power: if `v = w ^ k` with `k ≥ 2` then
`FreeGroup.map f v = (FreeGroup.map f w) ^ k`.  Hence an element whose image is not a proper power
is not a proper power itself. -/
theorem not_isProperPower_of_map {β γ : Type*} (f : β → γ) {v : FreeGroup β}
    (h : ¬ IsProperPower (FreeGroup.map f v)) : ¬ IsProperPower v := by
  rintro ⟨w, k, hk, hwk⟩
  exact h ⟨FreeGroup.map f w, k, hk, by rw [hwk, map_pow]⟩

theorem magnus_step_residual_of_support
    (H : ∀ {σ : Type u} [DecidableEq σ] (u : FreeGroup σ) (l : ℕ), 1 ≤ l →
      ¬ Work.OROneRel.IsProperPower u → Work.OROneRel.IsCyclicallyReducedRelator u →
      2 ≤ Work.OROneRel.relatorNorm u →
      (∀ x : σ, x ∈ Work.OROneRel.relatorLetters u) →
      (∀ x : σ, x ∈ Work.OROneRel.relatorLetters u → Work.OROneRel.eps x u ≠ 0) →
      (∀ (t : σ) (c : σ → ℤ), t ∈ Work.OROneRel.relatorLetters u → c t = 1 →
        ¬ Work.OROneRel.cohom c u = 1) →
      (∀ (x : σ) (b : Bool), (FreeGroup.toWord u).count (x, b) = 1 →
        (FreeGroup.toWord u).count (x, Bool.not b) ≠ 0) →
      ∃ (β : Type u) (v : FreeGroup β), ¬ Work.OROneRel.IsProperPower v ∧
        Work.OROneRel.relatorNorm v < Work.OROneRel.relatorNorm u ∧
        ∃ (A B : Subgroup (PresentedGroup ({v ^ l} : Set (FreeGroup β)))) (φ : A ≃* B)
          (e : PresentedGroup ({u ^ l} : Set (FreeGroup σ)) ≃*
            HNNExtension (PresentedGroup ({v ^ l} : Set (FreeGroup β))) A B φ),
          ∃ c : HNNExtension (PresentedGroup ({v ^ l} : Set (FreeGroup β))) A B φ,
            e (PresentedGroup.mk ({u ^ l} : Set (FreeGroup σ)) u) =
              c * HNNExtension.of (PresentedGroup.mk ({v ^ l} : Set (FreeGroup β)) v) * c⁻¹) :
    ∀ {α : Type u} [DecidableEq α] (u : FreeGroup α) (l : ℕ), 1 ≤ l →
      ¬ Work.OROneRel.IsProperPower u → Work.OROneRel.IsCyclicallyReducedRelator u →
      2 ≤ Work.OROneRel.relatorNorm u →
      (∀ x : α, x ∈ Work.OROneRel.relatorLetters u → Work.OROneRel.eps x u ≠ 0) →
      (∀ (t : α) (c : α → ℤ), t ∈ Work.OROneRel.relatorLetters u → c t = 1 →
        ¬ Work.OROneRel.cohom c u = 1) →
      (∀ (x : α) (b : Bool), (FreeGroup.toWord u).count (x, b) = 1 →
        (FreeGroup.toWord u).count (x, Bool.not b) ≠ 0) →
      ∃ (β : Type u) (v : FreeGroup β), ¬ Work.OROneRel.IsProperPower v ∧
        Work.OROneRel.relatorNorm v < Work.OROneRel.relatorNorm u ∧
        ∃ (A B : Subgroup (PresentedGroup ({v ^ l} : Set (FreeGroup β)))) (φ : A ≃* B)
          (e : PresentedGroup ({u ^ l} : Set (FreeGroup α)) ≃*
            HNNExtension (PresentedGroup ({v ^ l} : Set (FreeGroup β))) A B φ),
          ∃ c : HNNExtension (PresentedGroup ({v ^ l} : Set (FreeGroup β))) A B φ,
            e (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) =
              c * HNNExtension.of (PresentedGroup.mk ({v ^ l} : Set (FreeGroup β)) v) * c⁻¹ := by
  intro α instα u l hl hu hcyc hn hbad hnd hcount
  classical
  -- The support of `u`: the relator lives in the free factor generated by the letters it uses.
  let Z : Set α := relatorLetters u
  have hZ : SupportedOn u Z := fun a ha => ha
  obtain ⟨u', hu'⟩ := exists_map_subtype_val_eq_of_supportedOn u Z hZ
  have hmap : FreeGroup.map (fun a : Z => (a : α)) u' = u := hu'
  -- All hypotheses of `H` transport from `u` to its `Z`-shadow `u'`.
  have hpp : ¬ IsProperPower u' :=
    not_isProperPower_of_map (fun a : Z => (a : α)) (by rw [hmap]; exact hu)
  have hcyc' : IsCyclicallyReducedRelator u' :=
    isCyclicallyReducedRelator_of_map_subtype_val hmap hcyc
  have hn' : 2 ≤ relatorNorm u' := by
    rw [← relatorNorm_map_of_injective (f := fun a : Z => (a : α)) Subtype.val_injective u',
      hmap]
    exact hn
  have hfull : ∀ x : Z, x ∈ relatorLetters u' := by
    intro x
    have hx : (x : α) ∈ relatorLetters (FreeGroup.map (fun a : Z => (a : α)) u') := by
      rw [hmap]; exact x.2
    exact (mem_relatorLetters_map_iff (fun a : Z => (a : α)) Subtype.val_injective u' x).mpr hx
  have hbad' : ∀ x : Z, x ∈ relatorLetters u' → eps x u' ≠ 0 := by
    intro x hx
    have hfx : (x : α) ∈ relatorLetters u := by
      rw [← hmap]
      exact (mem_relatorLetters_map_iff (fun a : Z => (a : α)) Subtype.val_injective u' x).mp hx
    have h1 : eps (x : α) u = eps x u' := by
      rw [← hmap]
      exact eps_map_of_injective (fun a : Z => (a : α)) Subtype.val_injective x u'
    rw [← h1]
    exact hbad (x : α) hfx
  have hnd' : ∀ (t : Z) (c : Z → ℤ), t ∈ relatorLetters u' → c t = 1 →
      ¬ cohom c u' = 1 := by
    intro t c ht hct hcon
    -- extend the weight `c` on the support to a weight `c'` on all generators
    let c' : α → ℤ := fun a => if h : ∃ y : Z, (y : α) = a then c (Classical.choose h) else 0
    have hc'f : ∀ y : Z, c' (y : α) = c y := by
      intro y
      have hex : ∃ y' : Z, (y' : α) = (y : α) := ⟨y, rfl⟩
      dsimp only [c']
      rw [dif_pos hex]
      congr 1
      exact Subtype.ext (Classical.choose_spec hex)
    have hft : (t : α) ∈ relatorLetters u := by
      rw [← hmap]
      exact (mem_relatorLetters_map_iff (fun a : Z => (a : α)) Subtype.val_injective u' t).mp ht
    have hct' : c' (t : α) = 1 := by rw [hc'f t]; exact hct
    have hfun : (c' ∘ fun a : Z => (a : α)) = c := funext fun y => hc'f y
    exact hnd (t : α) c' hft hct'
      (by
        calc cohom c' u = cohom c' (FreeGroup.map (fun a : Z => (a : α)) u') := by rw [hmap]
          _ = cohom (c' ∘ fun a : Z => (a : α)) u' :=
                cohom_comp_map c' (fun a : Z => (a : α)) u'
          _ = cohom c u' := by rw [hfun]
          _ = 1 := hcon)
  -- The Magnus step for the `Z`-shadow transports back along the inclusion `F(Z) ↪ F(α)`.
  -- Rewrite the goal so that the relator is `FreeGroup.map f u'` (`= u`), apply the transport
  -- lemma, then the hypothesis `H` at the shadow; the count condition of `H` is discharged by
  -- transporting the letter counts from `u` to `u'`.  Passing `?_` to `H` makes `intro` produce
  -- `h1` with `H`'s *own* elaborated statement, so all the `DecidableEq`/`BEq` instances used in
  -- the count condition are exactly the ones `H` fixes.
  rw [← hmap]
  refine hasMagnusStepAt_map_of_injective (fun a : Z => (a : α)) Subtype.val_injective u' l hl ?_
  refine H u' l hl hpp hcyc' hn' hfull hbad' hnd' ?_
  intro x b h1
  have hb := count_toWord_map_of_injective (f := fun a : Z => (a : α))
    Subtype.val_injective u' x b
  rw [hmap] at hb
  have hb' := count_toWord_map_of_injective (f := fun a : Z => (a : α))
    Subtype.val_injective u' x (Bool.not b)
  rw [hmap] at hb'
  have hnz : (FreeGroup.toWord u).count ((x : α), Bool.not b) ≠ 0 :=
    hcount (x : α) b (by rw [hb]; exact h1)
  rw [← hb']
  exact hnz

end Work.OROneRel
