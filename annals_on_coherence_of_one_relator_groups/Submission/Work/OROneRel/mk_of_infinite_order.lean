import Mathlib
import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.letters_closure_iff
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.OROneRel.magnusSubgroupOf_equiv_freeGroup

/-!
# The image of a generator in `⟨α | r⟩` has infinite order

Let `r : FreeGroup α` be a cyclically reduced relator and `x ∈ relatorLetters r` a letter occurring
in it.  Then for every generator `t ≠ x`, the image of `t` in the one-relator group `⟨α | r⟩` has
infinite order:

`Work.OROneRel.mk_of_infinite_order`.

The proof is the Freiheitssatz (`Work.OROneRel.freiheitssatz_at`) applied to the Magnus subgroup
generated by all generators except `x`, i.e. to `T = {a : α | a ≠ x}`.  Since `x` occurs in `r`,
`r ∉ ⟨T⟩` (`letters_closure_iff`), so `presentedGroupMap r T : F(T) →* ⟨α | r⟩` is injective.  As
`t ∈ T`, a relation `(of t) ^ n = 1` in `⟨α | r⟩` pulls back to `of ⟨t, _⟩ ^ n = 1` in the free
group `F(T)`, which forces `n = 0` because `FreeGroup.of` is nontrivial and free groups are
torsion-free.
-/

namespace Work.OROneRel

universe u

theorem mk_of_infinite_order {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t)
    (hcyc : IsCyclicallyReducedRelator r) (hx : x ∈ relatorLetters r) :
    ∀ n : ℤ, (PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of t)) ^ n = 1 → n = 0 := by
  classical
  intro n hn
  -- the Magnus subgroup generated by all generators but `x`
  set T : Set α := {a | a ≠ x} with hT
  have hxT : x ∉ T := by rw [hT]; exact fun h => h rfl
  have htT : t ∈ T := by rw [hT]; exact fun h => hxt h.symm
  -- `x` occurs in `r`, so `r` is not a word in the generators other than `x`
  have hnotmem : r ∉ Subgroup.closure (FreeGroup.of '' T) := fun hr =>
    hxT (((letters_closure_iff r T).mp hr) hx)
  -- the Freiheitssatz
  have hinj := (freiheitssatz_at r) hcyc T hnotmem
  -- pull the relation back to the free group `F(T)`
  have hmap : presentedGroupMap r T (FreeGroup.of ⟨t, htT⟩ ^ n) = 1 := by
    rw [map_zpow, presentedGroupMap_of_apply]
    exact hn
  have hpow : (FreeGroup.of ⟨t, htT⟩ : FreeGroup T) ^ n = 1 := hinj hmap
  -- `FreeGroup.of ⟨t, _⟩` has infinite order in the free group `F(T)`
  have hg : (FreeGroup.of ⟨t, htT⟩ : FreeGroup T) ≠ 1 := FreeGroup.of_ne_one _
  have hinjz : Function.Injective (fun m : ℤ => (FreeGroup.of ⟨t, htT⟩ : FreeGroup T) ^ m) :=
    injective_zpow_iff_not_isOfFinOrder.mpr (not_isOfFinOrder_of_isMulTorsionFree hg)
  exact hinjz (by simpa using hpow)

end Work.OROneRel
