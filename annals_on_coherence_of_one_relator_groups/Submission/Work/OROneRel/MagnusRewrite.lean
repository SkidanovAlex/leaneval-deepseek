/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# The Magnus rewriting (definitions)

For a fixed generator `t : α`, the *Magnus rewriting* of a reduced word `L : List (α × Bool)` deletes
every letter equal to `t` and decorates every remaining letter `x` with the exponent sum of `t` in the
prefix of `L` that precedes it (`magRew`).  The decorated letters are indexed by the type
`{x : α // x ≠ t} × ℤ`, whose generator `(x, i)` stands for the conjugate `t ^ i * x * t ^ (-i)`
-- this is the homomorphism `rho`.

If the exponent sum of `t` in `L` is zero, the *telescoping identity* (proved in
`Submission.Work.OROneRel.rho_magRew`)

  `rho (mk (magRew t 0 L)) = mk L`

holds: the `t`-letters of `L` reappear as the frame corrections of the decorated letters, so that the
subgroup `ker (σ_t) ≤ F(α)` is freely generated by the conjugates `t ^ i * x * t ^ (-i)`
(`rho_injective`).  This is the combinatorial heart of the exponent-sum-zero case of the
Magnus--Moldavanskii decomposition: if `σ_t r = 0` then `r` lies in the image of `rho`, i.e. `r` is a
word in the conjugates, and rewriting it produces the relator of the next level of the hierarchy.

This file contains definitions only (no `sorry`), so that lemma requests may import it without
depending on the unproved hierarchy statement.
-/

import Mathlib
import Submission.Work.OROneRel.Interface

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- The exponent sum of the generator `t` in a word. -/
noncomputable def wordEps (t : α) (L : List (α × Bool)) : ℤ := by
  classical
  exact (L.map (fun p => if p.1 = t then (if p.2 then (1 : ℤ) else -1) else 0)).sum

/-- The Magnus rewriting of a word with respect to a generator `t`, starting with the current
exponent sum `acc` of `t`: the letters equal to `t` are deleted and each other letter `x` is replaced
by the symbol `(x, acc)` decorated by its sign. -/
noncomputable def magRew (t : α) : ℤ → List (α × Bool) → List (({x : α // x ≠ t} × ℤ) × Bool) :=
  fun acc L => by
    classical
    induction L generalizing acc with
    | nil => exact []
    | cons hd tl ih =>
      exact if h : hd.1 = t then ih (acc + (if hd.2 then (1 : ℤ) else -1))
        else ((⟨hd.1, h⟩, acc), hd.2) :: ih acc

/-- The symbols in which the Magnus rewriting of a word (`magRew`) takes its values stand for the
conjugates `t ^ i * x * t ^ (-i)`; `rho` is the corresponding homomorphism, whose target is the free
group generated by the original generators. -/
def rho (t : α) : FreeGroup ({x : α // x ≠ t} × ℤ) →* FreeGroup α :=
  FreeGroup.lift fun p => FreeGroup.of t ^ p.2 * FreeGroup.of (p.1 : α) * FreeGroup.of t ^ (-p.2)

/-- The exponent sum of `t` in an element of the free group. -/
noncomputable def eps (t : α) (r : FreeGroup α) : ℤ := by
  classical
  exact wordEps t r.toWord

/-- The Magnus rewriting of a relator: the letters equal to `t` are deleted, and the remaining
letters are decorated by the exponent sum of `t` in the prefix before them. -/
noncomputable def magnet (r : FreeGroup α) (t : α) :
    FreeGroup ({x : α // x ≠ t} × ℤ) := by
  classical
  exact FreeGroup.mk (magRew t 0 r.toWord)

end Work.OROneRel
