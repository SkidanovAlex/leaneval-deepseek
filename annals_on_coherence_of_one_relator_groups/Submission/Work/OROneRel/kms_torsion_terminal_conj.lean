import Mathlib
import Submission.Work.OROneRel.CoprodCorollaries
import Submission.Work.OROneRel.coprod_isOfFinOrder_conj
import Submission.Work.OROneRel.presentedGroup_of_zpow_iso_coprod_zmod
import Submission.Work.OROneRel.presentedGroup_of_zpow_iso_coprod_zmod_of_gen

/-!
# The Karrass--Magnus--Solitar torsion statement at a terminal relator

The one-relator group `⟨α | x ^ m⟩` (`m ≠ 0`) is the free product `ℤ/|m| ∗ F(α \ {x})`, so by
Kurosh's torsion theorem every element of finite order in it is conjugate into one of the two
factors.  The free factor is torsion-free, and the cyclic factor is generated by the image of `x`.
Hence every torsion element of `⟨α | x ^ m⟩` is conjugate to a power of `of x`, with a *natural*
exponent: the cyclic factor `Multiplicative (ZMod |m|)` is generated by `ofAdd 1`, and every element
of `ZMod n` is the reduction of a natural number.

The main proof therefore needs

* the terminal isomorphism `⟨α | x ^ m⟩ ≃* ℤ/|m| ∗ F(α \ {x})` *together with* the fact that it
  sends the generator `of x` to `ofAdd 1` in the cyclic factor
  (`presentedGroup_of_zpow_iso_coprod_zmod_of_gen`);
* Kurosh's torsion theorem for a free product of two groups living in *different* universes
  (`coprod_isOfFinOrder_conj_univ`, obtained from the same-universe version by transporting along
  `MulEquiv.coprodCongr` of the `ULift` isomorphisms);
* the two small facts `natPow_ofAdd_one_of_zmod` (every element of `Multiplicative (ZMod n)`,
  `n ≠ 0`, is a natural power of `ofAdd 1`) and
  `eq_one_of_isOfFinOrder_of_isMulTorsionFree` (a torsion element of a torsion-free group is `1`).
-/

namespace Work.OROneRel

universe u v

/-- Every element of the cyclic group `Multiplicative (ZMod n)` (`n ≠ 0`) is a *natural* power of
the canonical generator `ofAdd 1`. -/
lemma natPow_ofAdd_one_of_zmod (n : ℕ) (hn : n ≠ 0) (a : Multiplicative (ZMod n)) :
    ∃ k : ℕ, a = (Multiplicative.ofAdd (1 : ZMod n)) ^ k := by
  have hne : NeZero n := ⟨hn⟩
  refine ⟨a.toAdd.val, ?_⟩
  calc a = Multiplicative.ofAdd a.toAdd := (ofAdd_toAdd a).symm
    _ = Multiplicative.ofAdd (a.toAdd.val • (1 : ZMod n)) := by
          rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
    _ = (Multiplicative.ofAdd (1 : ZMod n)) ^ a.toAdd.val := ofAdd_nsmul _ _

/-- A torsion element of a torsion-free group is trivial. -/
lemma eq_one_of_isOfFinOrder_of_isMulTorsionFree {F : Type*} [Group F] [IsMulTorsionFree F]
    {a : F} (ha : IsOfFinOrder a) : a = 1 := by
  obtain ⟨n, hn, hn1⟩ := isOfFinOrder_iff_pow_eq_one.mp ha
  exact (pow_eq_one_iff_left hn.ne').mp hn1

/-- Conjugation reflects finite order. -/
lemma isOfFinOrder_of_isOfFinOrder_conj {G : Type*} [Group G] {c x : G}
    (h : IsOfFinOrder (c * x * c⁻¹)) : IsOfFinOrder x := by
  have h2 := Work.OROneRel.isOfFinOrder_conj c⁻¹ (c * x * c⁻¹) h
  simpa [mul_assoc] using h2

/-- A free-product factor embedding preserves and reflects finite order.  (Version of
`Work.OROneRel.isOfFinOrder_inr_iff` for factors in different universes.) -/
lemma isOfFinOrder_inr_iff' {M : Type v} {N : Type u} [Group M] [Group N] (b : N) :
    IsOfFinOrder (Monoid.Coprod.inr b : Monoid.Coprod M N) ↔ IsOfFinOrder b := by
  rw [isOfFinOrder_iff_pow_eq_one, isOfFinOrder_iff_pow_eq_one]
  constructor
  · rintro ⟨n, hn, hpow⟩
    exact ⟨n, hn, Monoid.Coprod.inr_injective (by simpa [map_pow] using hpow)⟩
  · rintro ⟨n, hn, hpow⟩
    exact ⟨n, hn, by rw [← map_pow, hpow, map_one]⟩

/-- **Kurosh's torsion theorem** for a free product of two groups in possibly different universes:
an element of finite order is conjugate into one of the two factors.

The same-universe statement is `Work.OROneRel.coprod_isOfFinOrder_conj`; here we transport it
along `MulEquiv.coprodCongr` of the two `ULift` isomorphisms, which puts both factors in the same
universe `max u v`. -/
theorem coprod_isOfFinOrder_conj_univ {M : Type v} {N : Type u} [Group M] [Group N]
    {g : Monoid.Coprod M N} (hg : IsOfFinOrder g) :
    (∃ h a, g = h * Monoid.Coprod.inl a * h⁻¹) ∨ ∃ h b, g = h * Monoid.Coprod.inr b * h⁻¹ := by
  let σ : Monoid.Coprod (ULift.{max u v} M) (ULift.{max u v} N) ≃* Monoid.Coprod M N :=
    MulEquiv.coprodCongr MulEquiv.ulift MulEquiv.ulift
  have hinl : ∀ a : ULift M, σ (Monoid.Coprod.inl a) = Monoid.Coprod.inl a.down := fun _ => rfl
  have hinr : ∀ b : ULift N, σ (Monoid.Coprod.inr b) = Monoid.Coprod.inr b.down := fun _ => rfl
  have hfin : IsOfFinOrder (σ.symm g) := MonoidHom.isOfFinOrder σ.symm.toMonoidHom hg
  rcases coprod_isOfFinOrder_conj hfin with ⟨h, a, ha⟩ | ⟨h, b, hb⟩
  · left
    refine ⟨σ h, a.down, ?_⟩
    rw [← MulEquiv.apply_symm_apply σ g, ha, map_mul, map_mul, map_inv, hinl]
  · right
    refine ⟨σ h, b.down, ?_⟩
    rw [← MulEquiv.apply_symm_apply σ g, hb, map_mul, map_mul, map_inv, hinr]

/-- **Karrass--Magnus--Solitar at a terminal relator.**  If `m ≠ 0`, then every element of finite
order of the one-relator group `⟨α | x ^ m⟩` is conjugate to a natural power of the image of the
generator `x`. -/
theorem kms_torsion_terminal_conj {α : Type u} (x : α) (m : ℤ) (hm : m ≠ 0)
    {g : PresentedGroup ({FreeGroup.of x ^ m} : Set (FreeGroup α))} (hg : IsOfFinOrder g) :
    ∃ (c : PresentedGroup ({FreeGroup.of x ^ m} : Set (FreeGroup α))) (k : ℕ),
      g = c * (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) ^ k *
        c⁻¹ := by
  classical
  obtain ⟨e, he⟩ := presentedGroup_of_zpow_iso_coprod_zmod_of_gen x m hm
  have hfin : IsOfFinOrder (e g) := MonoidHom.isOfFinOrder e.toMonoidHom hg
  rcases coprod_isOfFinOrder_conj_univ hfin with ⟨h, a, ha⟩ | ⟨h, b, hb⟩
  · -- the cyclic factor: rewrite `a` as a natural power of the generator
    obtain ⟨k, hk⟩ := natPow_ofAdd_one_of_zmod m.natAbs (Int.natAbs_ne_zero.mpr hm) a
    refine ⟨e.symm h, k, ?_⟩
    apply e.injective
    simp only [map_mul, map_inv, map_pow, MulEquiv.apply_symm_apply]
    rw [he, ha, hk, map_pow]
  · -- the free factor is torsion-free, so `g = 1` is conjugate to `(of x) ^ 0`
    have h2 : IsOfFinOrder (Monoid.Coprod.inr b :
        Monoid.Coprod (Multiplicative (ZMod m.natAbs)) (FreeGroup {a : α // a ≠ x})) :=
      isOfFinOrder_of_isOfFinOrder_conj (c := h) (by rw [← hb]; exact hfin)
    have hb1 : b = 1 :=
      eq_one_of_isOfFinOrder_of_isMulTorsionFree ((isOfFinOrder_inr_iff' b).mp h2)
    have hg1 : e g = 1 := by rw [hb, hb1, map_one, mul_one, mul_inv_cancel]
    refine ⟨1, 0, ?_⟩
    rw [pow_zero, mul_one, inv_one, mul_one]
    exact e.injective (by rw [hg1, map_one])

end Work.OROneRel
