/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# Vocabulary for the "cherry" lemma `tlWin_succ_le_cherry`

The window subgroup `tlWin p q m` of the two-letter band (`Work.OROneRel.tlWin`,
`band_hnnConjMap_injective.lean`) is the gauge-free `π₁` of the window `[0,m]` of the level graph of
the weight `tlW p q` (`a ↦ q`, `b ↦ -p`).

Passing from the window `[0,m]` to the window `[0,m+1]` adds exactly **two** edges, namely
`e_a = (0, m+1-q)` (running from level `m+1-q` up to level `m+1`) and `e_b = (1, m+1)` (running from
level `m+1` down to level `m+1-p`): the "cherry" hanging at the new vertex `m+1`.  Both its
attachment levels `m+1-q` and `m+1-p` lie in `[0,m]` as soon as `m ≥ p+q-1`.

If `pα`, `pβ ∈ F₂` are elements represented by words of weights `m+1-q`, `m+1-p` whose walks lie in
the window `[0,m]` (i.e. *connection paths* from the base level `0` to the two attachment levels),
then the loop spelled by the cherry is
`pα · a · b · pβ⁻¹` (`a = FreeGroup.of 0`, `b = FreeGroup.of 1`), and the content of the cherry
lemma is that the new window subgroup is generated by the old one together with this single loop.

This file contains the vocabulary of that argument:

* `decorAt c i x` -- the decoration of a single letter `x` read at running level `i`;
* `cherryNewE p q m` -- the two new edges;
* `cherryOuter p q m v` -- the three "outer" levels `0`, `m+1-q`, `m+1-p`, the levels at which a
  connection element is available;
* `cherryConn` / `cherryConnList` -- the connection elements and their spelling words.

The definitions are followed by the elementary glue lemmas (`decorAt` is the head of `decor`,
`cherryConn` is the value of `cherryConnList`); the mathematical lemmas about them are delegated
separately.
-/
import Mathlib
import Submission.Work.OROneRel.band_hnnConjMap_injective
import Submission.Work.OROneRel.bandWinDefs
import Submission.Work.OROneRel.decorGetElemCover
import Submission.Work.OROneRel.winBandDefs
import Submission.Work.OROneRel.decor_invRev

namespace Work.OROneRel

/-- **The decoration of a single letter read at running level `i`**: the head of
`decor c i (x :: L)` (`decor_cons_l`). -/
def decorAt (c : Fin 2 → ℤ) (i : ℤ) (x : Fin 2 × Bool) : (Fin 2 × ℤ) × Bool :=
  ((x.1, if x.2 then i else i - c x.1), x.2)

/-- The head of the decoration of a cons is `decorAt` of its head. -/
theorem decor_cons_decorAt (c : Fin 2 → ℤ) (i : ℤ) (x : Fin 2 × Bool) (L : List (Fin 2 × Bool)) :
    decor c i (x :: L) = decorAt c i x :: decor c (i + linc c x) L :=
  decor_cons_l c i x L

/-- **The two new edges of the window `[0,m+1]`**: `e_a = (0, m+1-q)` and `e_b = (1, m+1)`. -/
def cherryNewE (p q : ℕ) (m : ℤ) : Set (Fin 2 × ℤ) :=
  {e | e = ((0 : Fin 2), m + 1 - (q : ℤ)) ∨ e = ((1 : Fin 2), m + 1)}

@[simp] theorem mem_cherryNewE {p q : ℕ} {m : ℤ} {e : Fin 2 × ℤ} :
    e ∈ cherryNewE p q m ↔ e = ((0 : Fin 2), m + 1 - (q : ℤ)) ∨ e = ((1 : Fin 2), m + 1) :=
  Iff.rfl

/-- **The outer levels**: `0` (the base level), and the two attachment levels `m+1-q`, `m+1-p` of
the cherry. -/
def cherryOuter (p q : ℕ) (m : ℤ) (v : ℤ) : Prop :=
  v = 0 ∨ v = m + 1 - (q : ℤ) ∨ v = m + 1 - (p : ℤ)

/-- **The connection word** attached to an outer level: the witness word of `pα` at level `m+1-q`,
of `pβ` at level `m+1-p`, and the empty word at level `0`.  (When `m+1-q = m+1-p` the first branch
wins for both; this is the case `p = q`, handled separately.) -/
noncomputable def cherryConnList (p q : ℕ) (m : ℤ) (Lα Lβ : List (Fin 2 × Bool)) (v : ℤ) :
    List (Fin 2 × Bool) :=
  if v = m + 1 - (q : ℤ) then Lα else if v = m + 1 - (p : ℤ) then Lβ else []

/-- **The connection element** attached to an outer level, the class of `cherryConnList`. -/
noncomputable def cherryConn (p q : ℕ) (m : ℤ) (pα pβ : FreeGroup (Fin 2)) (v : ℤ) :
    FreeGroup (Fin 2) :=
  if v = m + 1 - (q : ℤ) then pα else if v = m + 1 - (p : ℤ) then pβ else 1

@[simp] theorem cherryConn_self_q (p q : ℕ) (m : ℤ) (pα pβ : FreeGroup (Fin 2)) :
    cherryConn p q m pα pβ (m + 1 - (q : ℤ)) = pα :=
  if_pos rfl

@[simp] theorem cherryConnList_self_q (p q : ℕ) (m : ℤ) (Lα Lβ : List (Fin 2 × Bool)) :
    cherryConnList p q m Lα Lβ (m + 1 - (q : ℤ)) = Lα :=
  if_pos rfl

theorem cherryConn_of_ne (p q : ℕ) (m : ℤ) (pα pβ : FreeGroup (Fin 2)) {v : ℤ}
    (h : v ≠ m + 1 - (q : ℤ)) :
    cherryConn p q m pα pβ v =
      if v = m + 1 - (p : ℤ) then pβ else 1 := by
  rw [cherryConn, if_neg h]

theorem cherryConnList_of_ne (p q : ℕ) (m : ℤ) (Lα Lβ : List (Fin 2 × Bool)) {v : ℤ}
    (h : v ≠ m + 1 - (q : ℤ)) :
    cherryConnList p q m Lα Lβ v =
      if v = m + 1 - (p : ℤ) then Lβ else [] := by
  rw [cherryConnList, if_neg h]

/-- The class of the connection word is the connection element. -/
theorem cherryConn_mk (p q : ℕ) (m : ℤ) {Lα Lβ : List (Fin 2 × Bool)}
    {pα pβ : FreeGroup (Fin 2)} (hmkα : FreeGroup.mk Lα = pα) (hmkβ : FreeGroup.mk Lβ = pβ)
    (v : ℤ) :
    FreeGroup.mk (cherryConnList p q m Lα Lβ v) = cherryConn p q m pα pβ v := by
  unfold cherryConnList cherryConn
  by_cases h1 : v = m + 1 - (q : ℤ)
  · simp only [if_pos h1, hmkα]
  · by_cases h2 : v = m + 1 - (p : ℤ)
    · simp only [if_neg h1, if_pos h2, hmkβ]
    · simp only [if_neg h1, if_neg h2, FreeGroup.one_eq_mk]

/-- The reverse of the connection word spells the inverse of the connection element. -/
theorem cherryConn_invRev_mk (p q : ℕ) (m : ℤ) {Lα Lβ : List (Fin 2 × Bool)}
    {pα pβ : FreeGroup (Fin 2)} (hmkα : FreeGroup.mk Lα = pα) (hmkβ : FreeGroup.mk Lβ = pβ)
    (v : ℤ) :
    FreeGroup.mk (FreeGroup.invRev (cherryConnList p q m Lα Lβ v)) =
      (cherryConn p q m pα pβ v)⁻¹ := by
  rw [← FreeGroup.inv_mk, cherryConn_mk p q m hmkα hmkβ v]

/-- The level zero is never one of the attachment levels. -/
theorem cherry_zero_ne (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) {m : ℤ}
    (hm1 : ((p : ℤ) + (q : ℤ) - 1) ≤ m) :
    (0 : ℤ) ≠ m + 1 - (q : ℤ) ∧ (0 : ℤ) ≠ m + 1 - (p : ℤ) := by
  constructor <;> (intro h; omega)

@[simp] theorem cherryConn_zero (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) {m : ℤ}
    (hm1 : ((p : ℤ) + (q : ℤ) - 1) ≤ m) (pα pβ : FreeGroup (Fin 2)) :
    cherryConn p q m pα pβ 0 = 1 := by
  obtain ⟨h1, h2⟩ := cherry_zero_ne p q hp hq hm1
  rw [cherryConn_of_ne p q m pα pβ h1, if_neg h2]

@[simp] theorem cherryConnList_zero (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) {m : ℤ}
    (hm1 : ((p : ℤ) + (q : ℤ) - 1) ≤ m) (Lα Lβ : List (Fin 2 × Bool)) :
    cherryConnList p q m Lα Lβ 0 = [] := by
  obtain ⟨h1, h2⟩ := cherry_zero_ne p q hp hq hm1
  rw [cherryConnList_of_ne p q m Lα Lβ h1, if_neg h2]

/-- The outer levels lie in the old window `[0,m]`. -/
theorem cherryOuter_mem_window (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) {m : ℤ}
    (hm1 : ((p : ℤ) + (q : ℤ) - 1) ≤ m) {v : ℤ} (hv : cherryOuter p q m v) :
    0 ≤ v ∧ v ≤ m := by
  rcases hv with rfl | rfl | rfl
  · exact ⟨le_rfl, by omega⟩
  · exact ⟨by omega, by omega⟩
  · exact ⟨by omega, by omega⟩

end Work.OROneRel
