import Mathlib
import Submission.Work.OROneRel.ntDefs
import Submission.Work.OROneRel.HNNStep

/-!
# The substitution `t ↦ t^p`, `x ↦ x * t^{-q}` does not increase `nt t`

`Work.OROneRel.subst t x p q` is the endomorphism of the free group `F α` sending
`t ↦ t ^ p`, `x ↦ x * t ^ (-q)` and fixing every other generator.  This file proves that
applying it to `r : FreeGroup α` never increases the number `nt t r.toWord` of letters of the
reduced word of `r` that are different from `t`:

`nt t (subst t x p q r).toWord ≤ nt t r.toWord`.

The point is that a single letter of `r.toWord` is sent to a block whose `nt t`-count is at most
`1` (and `0` if the letter is `t`), and neither free reduction nor multiplication can create new
letters different from `t` (`nt` is subadditive and does not increase under reduction).

The definitions `nt` (`Submission.Work.OROneRel.ntDefs`) and `subst` / `substFun`
(`Submission.Work.OROneRel.HNNStep`) are those of the ambient `OROneRel` development.

Because `FreeGroup.toWord` depends on a `DecidableEq α` instance, and the lemmas of `ntDefs`
were elaborated with `Classical.decEq` (that file carries a `local instance` attribute), the few
`nt`-lemmas about `toWord` are re-derived here for the `DecidableEq α` instance that appears in
the statement of the target theorem.
-/

namespace Work.OROneRel

open List

universe u

variable {α : Type u}

section InstHelpers

variable [DecidableEq α]

/-- Subadditivity of `nt` under multiplication, for the `DecidableEq α` instance in scope (cf.
`ntDefs.nt_mul_le`, stated with `Classical.decEq`). -/
private lemma nt_mul_le_inst (t : α) (x y : FreeGroup α) :
    nt t (x * y).toWord ≤ nt t x.toWord + nt t y.toWord := by
  calc nt t (x * y).toWord
      = nt t (FreeGroup.reduce (x.toWord ++ y.toWord)) := by rw [FreeGroup.toWord_mul]
    _ ≤ nt t (x.toWord ++ y.toWord) := nt_red_le FreeGroup.reduce.red
    _ = nt t x.toWord + nt t y.toWord := nt_append t _ _

/-- Subadditivity of `nt` under products, for the `DecidableEq α` instance in scope (cf.
`ntDefs.nt_prod_le`). -/
private lemma nt_prod_le_inst (t : α) (l : List (FreeGroup α)) :
    nt t (l.prod).toWord ≤ (l.map (fun x => nt t x.toWord)).sum := by
  induction l with
  | nil => simp [nt]
  | cons x l ih =>
    rw [List.prod_cons, List.map_cons, List.sum_cons]
    calc nt t (x * l.prod).toWord ≤ nt t x.toWord + nt t l.prod.toWord := nt_mul_le_inst t x _
      _ ≤ nt t x.toWord + (l.map (fun x => nt t x.toWord)).sum := Nat.add_le_add_left ih _

/-- Invariance of `nt` under inversion, for the `DecidableEq α` instance in scope (cf.
`ntDefs.nt_inv`). -/
private lemma nt_inv_inst (t : α) (x : FreeGroup α) :
    nt t x⁻¹.toWord = nt t x.toWord := by
  rw [FreeGroup.toWord_inv, nt_invRev]

/-- `nt` of a single generator, for the `DecidableEq α` instance in scope. -/
private lemma nt_toWord_of_inst (t a : α) :
    nt t (FreeGroup.of a).toWord = if a = t then 0 else 1 := by
  simp [FreeGroup.toWord_of, nt_singleton]

/-- An element of the cyclic subgroup generated by `of t` has no letter different from `t`, for
the `DecidableEq α` instance in scope (cf. `ntDefs.nt_of_zpow`). -/
private lemma nt_of_zpow_inst (t : α) (n : ℤ) :
    nt t ((FreeGroup.of t : FreeGroup α) ^ n).toWord = 0 := by
  have hrep : ∀ (k : ℕ) (p : α × Bool), p ∈ List.replicate k (t, true) → p.1 = t :=
    fun k p hp => by simpa using congrArg Prod.fst (List.eq_of_mem_replicate hp)
  rcases le_or_gt 0 n with h | h
  · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le h
    rw [zpow_natCast, FreeGroup.toWord_of_pow]
    exact (nt_eq_zero_iff t _).mpr (hrep k)
  · obtain ⟨k, rfl⟩ := Int.eq_negSucc_of_lt_zero h
    rw [zpow_negSucc, FreeGroup.toWord_inv, FreeGroup.toWord_of_pow, nt_invRev]
    exact (nt_eq_zero_iff t _).mpr (hrep (k + 1))

/-- The `nt t`-count of the image of a single generator under `substFun` is at most `1`, and `0`
for the letter `t` itself. -/
private lemma nt_substFun_le (t x : α) (p q : ℤ) (a : α) :
    nt t (substFun t x p q a).toWord ≤ if a = t then 0 else 1 := by
  classical
  rw [substFun]
  split_ifs with hat hax
  · simp only [nt_of_zpow_inst, Nat.zero_le]
  · have hxt : ¬ (x = t) := by rw [← hax]; exact hat
    calc nt t (FreeGroup.of x * FreeGroup.of t ^ (-q)).toWord
        ≤ nt t (FreeGroup.of x).toWord + nt t (FreeGroup.of t ^ (-q)).toWord :=
          nt_mul_le_inst t _ _
      _ = 1 := by
          simp only [nt_toWord_of_inst, nt_of_zpow_inst, if_neg hxt, Nat.add_zero]
  · exact le_trans (le_of_eq (nt_toWord_of_inst t a)) (le_of_eq (if_neg hat))

/-- The `nt t`-count of the image of a single letter `c : α × Bool` of a word under `substFun`
is at most `1`, and `0` when `c.1 = t`. -/
private lemma nt_subst_block_le (t x : α) (p q : ℤ) (c : α × Bool) :
    nt t (bif c.2 then substFun t x p q c.1 else (substFun t x p q c.1)⁻¹).toWord
      ≤ if c.1 = t then 0 else 1 := by
  obtain ⟨a, b⟩ := c
  cases b
  · change nt t ((substFun t x p q a)⁻¹).toWord ≤ if a = t then 0 else 1
    rw [nt_inv_inst]
    exact nt_substFun_le t x p q a
  · change nt t (substFun t x p q a).toWord ≤ if a = t then 0 else 1
    exact nt_substFun_le t x p q a

/-- Summing the bound of `nt_subst_block_le` over a word. -/
private lemma sum_map_subst_block_le (t x : α) (p q : ℤ) (L : List (α × Bool)) :
    (L.map (fun c =>
        nt t (bif c.2 then substFun t x p q c.1 else (substFun t x p q c.1)⁻¹).toWord)).sum
      ≤ (L.map (fun c => if c.1 = t then 0 else 1)).sum := by
  induction L with
  | nil => simp
  | cons c L ih =>
    simp only [List.map_cons, List.sum_cons]
    exact Nat.add_le_add (nt_subst_block_le t x p q c) ih

/-- Summing `if c.1 = t then 0 else 1` over a word gives back `nt t` of the word. -/
private lemma sum_map_ite_eq_nt (t : α) (L : List (α × Bool)) :
    (L.map (fun c => if c.1 = t then 0 else 1)).sum = nt t L := by
  induction L with
  | nil => simp [nt]
  | cons c L ih =>
    rw [List.map_cons, List.sum_cons, nt_cons, ih]
    by_cases h : c.1 = t <;> simp [h]

/-- Composing the two `List.map`s in the subadditivity bound for products. -/
private lemma map_map_sum_eq {β : Type*} (t : α) (L : List β) (g : β → FreeGroup α) :
    ((L.map g).map (fun x => nt t x.toWord)).sum = (L.map (fun c => nt t (g c).toWord)).sum := by
  induction L with
  | nil => rfl
  | cons c L ih => simp only [List.map_cons, List.sum_cons, ih]

/-- The substitution does not increase `nt t`, for a group element presented as `FreeGroup.mk L`
with `L : List (α × Bool)`. -/
private lemma nt_subst_mk_le (t x : α) (p q : ℤ) (L : List (α × Bool)) :
    nt t (subst t x p q (FreeGroup.mk L)).toWord ≤ nt t L := by
  rw [subst, FreeGroup.lift_mk]
  calc nt t (List.map (fun a =>
          bif a.2 then substFun t x p q a.1 else (substFun t x p q a.1)⁻¹) L).prod.toWord
      ≤ (List.map (fun x => nt t x.toWord) (List.map (fun a =>
          bif a.2 then substFun t x p q a.1 else (substFun t x p q a.1)⁻¹) L)).sum :=
        nt_prod_le_inst t _
    _ = (List.map (fun a =>
          nt t (bif a.2 then substFun t x p q a.1 else (substFun t x p q a.1)⁻¹).toWord) L).sum :=
        map_map_sum_eq t L _
    _ ≤ (List.map (fun a => if a.1 = t then 0 else 1) L).sum := sum_map_subst_block_le t x p q L
    _ = nt t L := sum_map_ite_eq_nt t L

end InstHelpers

/-- **The substitution of Case 2 of the Freiheitssatz does not increase the `t`-avoiding letter
count.**  For every `r : FreeGroup α`, `nt t (subst t x p q r).toWord ≤ nt t r.toWord`. -/
theorem nt_subst_toWord_le {α : Type u} [DecidableEq α] (t x : α) (p q : ℤ) (r : FreeGroup α) :
    nt t (subst t x p q r).toWord ≤ nt t r.toWord := by
  have h := nt_subst_mk_le (α := α) t x p q r.toWord
  rwa [FreeGroup.mk_toWord] at h

end Work.OROneRel
