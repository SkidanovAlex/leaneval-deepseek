/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# The Tietze/pushout identification `⟨α | ψ r⟩ ≅ ⟨α | r⟩ ∗_{t^n = s^{pn}} ⟨s⟩`

Let `ψ = subst t x p q` be the Magnus/Putman substitution of `Submission.Work.OROneRel.HNNStep`
(`t ↦ t^p`, `x ↦ x * t^(-q)`, all other letters fixed; `hxt : x ≠ t`).  Writing
`AmFactor r : Bool → Type` for the family `⟨α | r⟩`, `⟨s⟩ = ULift (Multiplicative ℤ)` and
`amPhi r t p` for the two maps `n ↦ (mk t)^n`, `n ↦ s^{pn}` out of the common edge group, this file
proves

  `⟨α | ψ r⟩ ≅ ⟨α | r⟩ ∗_{t^n = s^{pn}} ⟨s⟩`,

i.e. that the group obtained by the substitution is the amalgam of `⟨α | r⟩` with the infinite
cyclic group generated by a `p`-th root `s` of `t` (with `t = s^p`).  The isomorphism carries the
class of `ψ w` to the class of `w` in the first factor; concretely

* `spE : ⟨α | ψ r⟩ →* PushoutI (amPhi r t p)` is `t ↦ s`, `x ↦ x·s^q`, `a ↦ a`, and
* `spE' : PushoutI (amPhi r t p) →* ⟨α | ψ r⟩` is the map out of the pushout which is
  `substHom` on the first factor and `s ↦ mk t` on the second one.

They are mutually inverse (`spE'_comp_spE`, `spE_comp_spE'`): on generators both composites are the
identity because `spE' s = mk t` and `spE (mk t) = s`, and `ψ` is exactly the re-substitution
inverse to `t ↦ s`.  Everything here is `sorry`-free and depends only on `propext`,
`Classical.choice`, `Quot.sound`.
-/
import Mathlib
import Submission.Work.OROneRel.NoZeroDefs

set_option autoImplicit false

namespace Work.OROneRel

universe u v

/-! ## A word-level form of the universal property of `PresentedGroup` -/

/-- The universal property of `PresentedGroup` evaluated on an arbitrary word: the homomorphism
`PresentedGroup.toGroup h` sends the class of a word `z : FreeGroup α` to the image of `z` under
the lift `FreeGroup.lift f`. -/
theorem subst_pushout_toGroup_mk_apply {α : Type u} {G : Type v} [Group G] {rels : Set (FreeGroup α)}
    {f : α → G} (h : ∀ r ∈ rels, FreeGroup.lift f r = 1) (z : FreeGroup α) :
    PresentedGroup.toGroup (f := f) h (PresentedGroup.mk rels z) = FreeGroup.lift f z := by
  rw [show PresentedGroup.toGroup (f := f) h
      = QuotientGroup.lift (Subgroup.normalClosure rels) (FreeGroup.lift f)
          (PresentedGroup.to_group_eq_one_of_mem_closure h) from rfl]
  exact QuotientGroup.lift_mk _ _ z

/-! ## The element `s` of the pushout -/

/-- The generator `s` of the infinite cyclic factor, inside the amalgamating group
`ULift (Multiplicative ℤ)`. -/
noncomputable def spGen : ULift.{u} (Multiplicative ℤ) := ULift.up (Multiplicative.ofAdd (1 : ℤ))

@[simp] theorem spGen_down : spGen.down = Multiplicative.ofAdd (1 : ℤ) := rfl

@[simp] theorem spGen_toAdd : Multiplicative.toAdd spGen.down = 1 := rfl

theorem spGen_zpow (n : ULift.{u} (Multiplicative ℤ)) :
    spGen ^ (Multiplicative.toAdd n.down) = n := by
  apply (MulEquiv.ulift (α := Multiplicative ℤ)).injective
  rw [map_zpow]
  show (Multiplicative.ofAdd (1 : ℤ)) ^ (Multiplicative.toAdd n.down) = n.down
  rw [← Int.ofAdd_mul, one_mul, ofAdd_toAdd]

/-- `s`, as an element of the pushout. -/
noncomputable def spS {α : Type u} (r : FreeGroup α) (t : α) (p : ℤ) :
    Monoid.PushoutI (amPhi r t p) :=
  Monoid.PushoutI.of (φ := amPhi r t p) false spGen

/-- **The defining relation of the amalgam**: `s ^ p = t` in the pushout. -/
theorem spS_pow {α : Type u} (r : FreeGroup α) (t : α) (p : ℤ) :
    spS r t p ^ p = Monoid.PushoutI.of (φ := amPhi r t p) true
      (PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of t)) := by
  have hgen : spGen ^ p = (amPhi r t p false) spGen :=
    (map_zpow (MulEquiv.ulift (α := Multiplicative ℤ)).symm (Multiplicative.ofAdd (1 : ℤ)) p).symm
  have htru : (amPhi r t p true) spGen =
      PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of t) := by
    rw [amPhi_true_apply]
    simp
  calc spS r t p ^ p
      = Monoid.PushoutI.of (φ := amPhi r t p) false (spGen ^ p) :=
        (map_zpow (Monoid.PushoutI.of (φ := amPhi r t p) false) spGen p).symm
    _ = Monoid.PushoutI.of (φ := amPhi r t p) false ((amPhi r t p false) spGen) := by rw [hgen]
    _ = Monoid.PushoutI.base (amPhi r t p) spGen := Monoid.PushoutI.of_apply_eq_base _ _ _
    _ = Monoid.PushoutI.of (φ := amPhi r t p) true ((amPhi r t p true) spGen) :=
        (Monoid.PushoutI.of_apply_eq_base _ _ _).symm
    _ = Monoid.PushoutI.of (φ := amPhi r t p) true
          (PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of t)) := by rw [htru]

theorem spS_zpow {α : Type u} (r : FreeGroup α) (t : α) (p : ℤ)
    (n : ULift.{u} (Multiplicative ℤ)) :
    spS r t p ^ (Multiplicative.toAdd n.down) = Monoid.PushoutI.of (φ := amPhi r t p) false n := by
  show (Monoid.PushoutI.of (φ := amPhi r t p) false spGen) ^
      (Multiplicative.toAdd n.down) = _
  rw [← map_zpow, spGen_zpow]

/-! ## The point map `t ↦ s`, `x ↦ x·s^q` -/

/-- The map on generators `t ↦ s`, `x ↦ x·s^q` and `a ↦ a` for the other letters, as a function
`α → PushoutI (amPhi r t p)` (to be used through `FreeGroup.lift`). -/
noncomputable def spPt {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    α → Monoid.PushoutI (amPhi r t p) := by
  classical
  exact fun a =>
    if a = t then spS r t p
    else if a = x then
      Monoid.PushoutI.of (φ := amPhi r t p) true (PresentedGroup.of a) * spS r t p ^ q
    else Monoid.PushoutI.of (φ := amPhi r t p) true (PresentedGroup.of a)

theorem spPt_t {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    spPt r t x p q t = spS r t p := by
  classical
  simp [spPt]

theorem spPt_x {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    spPt r t x p q x =
      Monoid.PushoutI.of (φ := amPhi r t p) true (PresentedGroup.of x) * spS r t p ^ q := by
  classical
  simp [spPt, hxt]

theorem spPt_of_ne {α : Type u} (r : FreeGroup α) {t x a : α} (hat : a ≠ t) (hax : a ≠ x)
    (p q : ℤ) :
    spPt r t x p q a = Monoid.PushoutI.of (φ := amPhi r t p) true (PresentedGroup.of a) := by
  classical
  simp [spPt, hat, hax]

/-! ## The substitution on generators -/

theorem sp_subst_genT {α : Type u} (t x : α) (p q : ℤ) :
    subst t x p q (FreeGroup.of t) = (FreeGroup.of t) ^ p := by
  rw [show subst t x p q = FreeGroup.lift (substFun t x p q) from rfl, FreeGroup.lift_apply_of]
  simp [substFun]

theorem sp_subst_genX {α : Type u} {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    subst t x p q (FreeGroup.of x) = FreeGroup.of x * (FreeGroup.of t) ^ (-q) := by
  rw [show subst t x p q = FreeGroup.lift (substFun t x p q) from rfl, FreeGroup.lift_apply_of]
  simp [substFun, hxt]

theorem sp_subst_gen_of_ne {α : Type u} {t x a : α} (hat : a ≠ t) (hax : a ≠ x) (p q : ℤ) :
    subst t x p q (FreeGroup.of a) = FreeGroup.of a := by
  rw [show subst t x p q = FreeGroup.lift (substFun t x p q) from rfl, FreeGroup.lift_apply_of]
  simp [substFun, hat, hax]

theorem sp_substHom_genT_pow {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) (m : ℤ) :
    substHom r t x p q ((PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of t)) ^ m) =
      (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^ (p * m) := by
  rw [map_zpow, substHom_mk, sp_subst_genT, map_zpow, ← zpow_mul]

theorem sp_substHom_of_x {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    substHom r t x p q (PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) x) =
      (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of x)) *
        (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^ (-q) := by
  rw [show PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) x
        = PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of x) from rfl,
    substHom_mk, sp_subst_genX hxt, map_mul, map_zpow]

/-! ## The key computation: `spPt` intertwines `ψ` with the inclusion of the first factor -/

/-- On the level of the free group, the point map `spPt` converts the substitution `ψ` into the
identity: `(spPt) ∘ ψ = (inclusion of ⟨α | r⟩) ∘ mk`. -/
theorem sp_lift_key {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    (FreeGroup.lift (spPt r t x p q)).comp (subst t x p q) =
      (Monoid.PushoutI.of (φ := amPhi r t p) true).comp
        (PresentedGroup.mk ({r} : Set (FreeGroup α))) := by
  apply FreeGroup.ext_hom
  intro a
  simp only [MonoidHom.comp_apply]
  by_cases hat : a = t
  · rw [hat, sp_subst_genT, map_zpow, FreeGroup.lift_apply_of, spPt_t, spS_pow]
  · by_cases hax : a = x
    · rw [hax, sp_subst_genX hxt p q]
      simp only [map_mul, map_zpow, FreeGroup.lift_apply_of]
      rw [spPt_x r hxt p q, spPt_t]
      rw [mul_assoc, ← zpow_add, add_neg_cancel, zpow_zero, mul_one]
      rfl
    · rw [sp_subst_gen_of_ne hat hax p q, FreeGroup.lift_apply_of, spPt_of_ne r hat hax p q]
      rfl

/-! ## The homomorphism `spE : ⟨α | ψ r⟩ →* PushoutI (amPhi r t p)` -/

/-- The two vertex maps, out of `⟨α | r⟩` and out of `⟨s⟩`, that induce the inverse
`spE' : PushoutI (amPhi r t p) →* ⟨α | ψ r⟩`. -/
noncomputable def spF {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    ∀ i : Bool, AmFactor r i →* PresentedGroup ({subst t x p q r} : Set (FreeGroup α))
  | true => substHom r t x p q
  | false => MonoidHom.mk'
      (fun n : ULift.{u} (Multiplicative ℤ) =>
        (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^
          (Multiplicative.toAdd n.down))
      (fun a b => by
        rw [show Multiplicative.toAdd (a * b).down =
              Multiplicative.toAdd a.down + Multiplicative.toAdd b.down from rfl,
          zpow_add])

/-- The map on the amalgamating group `ULift (Multiplicative ℤ)` induced by `s ↦ mk t`, i.e.
`n ↦ (mk t)^{p·n}` (so that it agrees with `spF true ∘ amPhi true`). -/
noncomputable def spK {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    ULift.{u} (Multiplicative ℤ) →* PresentedGroup ({subst t x p q r} : Set (FreeGroup α)) :=
  MonoidHom.mk'
    (fun n => (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^
        (p * Multiplicative.toAdd n.down))
    (fun a b => by
      rw [show Multiplicative.toAdd (a * b).down =
            Multiplicative.toAdd a.down + Multiplicative.toAdd b.down from rfl, mul_add, zpow_add])

@[simp] theorem spF_true {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    spF r t x p q true = substHom r t x p q := rfl

@[simp] theorem spF_false_apply {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ)
    (n : ULift.{u} (Multiplicative ℤ)) :
    spF r t x p q false n =
      (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^
        (Multiplicative.toAdd n.down) := rfl

@[simp] theorem spK_apply {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ)
    (n : ULift.{u} (Multiplicative ℤ)) :
    spK r t x p q n =
      (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^
        (p * Multiplicative.toAdd n.down) := rfl

/-- The compatibility needed to apply the universal property of the pushout to `spF`. -/
theorem sp_hf {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    ∀ i : Bool, (spF r t x p q i).comp (amPhi r t p i) = spK r t x p q := by
  intro i
  cases i with
  | false =>
    ext n
    rw [MonoidHom.comp_apply, spF_false_apply, spK_apply, amPhi_false_apply]
    rw [Int.toAdd_zpow, mul_comm]
  | true =>
    ext n
    rw [MonoidHom.comp_apply, spF_true, spK_apply, amPhi_true_apply]
    exact sp_substHom_genT_pow r t x p q (Multiplicative.toAdd n.down)

/-- The relator `ψ r` is killed by the point map `spPt`. -/
theorem sp_hF {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    ∀ z ∈ ({subst t x p q r} : Set (FreeGroup α)), FreeGroup.lift (spPt r t x p q) z = 1 := by
  intro z hz
  rw [Set.mem_singleton_iff] at hz
  rw [hz]
  have h := congrArg (fun f : FreeGroup α →* Monoid.PushoutI (amPhi r t p) => f r)
    (sp_lift_key r hxt p q)
  simp only [MonoidHom.comp_apply] at h
  rw [h]
  have h1 : PresentedGroup.mk ({r} : Set (FreeGroup α)) r = 1 :=
    PresentedGroup.one_of_mem (Set.mem_singleton r)
  rw [h1, map_one]

/-- **The forward map**: `⟨α | ψ r⟩ →* ⟨α | r⟩ ∗_{t^n = s^{pn}} ⟨s⟩`, sending `t ↦ s`,
`x ↦ x·s^q` and all other generators to themselves. -/
noncomputable def spE {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    PresentedGroup ({subst t x p q r} : Set (FreeGroup α)) →* Monoid.PushoutI (amPhi r t p) :=
  PresentedGroup.toGroup (rels := ({subst t x p q r} : Set (FreeGroup α)))
    (f := spPt r t x p q) (sp_hF r hxt p q)

theorem spE_apply {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ)
    (z : FreeGroup α) :
    spE r hxt p q (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) z) =
      FreeGroup.lift (spPt r t x p q) z := by
  show (PresentedGroup.toGroup (f := spPt r t x p q) (sp_hF r hxt p q))
      (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) z) =
    FreeGroup.lift (spPt r t x p q) z
  exact subst_pushout_toGroup_mk_apply (sp_hF r hxt p q) z

theorem spE_of {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) (a : α) :
    spE r hxt p q (PresentedGroup.of (rels := ({subst t x p q r} : Set (FreeGroup α))) a) =
      spPt r t x p q a := by
  show (PresentedGroup.toGroup (f := spPt r t x p q) (sp_hF r hxt p q))
      (PresentedGroup.of a) = spPt r t x p q a
  exact PresentedGroup.toGroup.of (sp_hF r hxt p q)

/-- `spE` carries the class of `ψ w` to the class of `w` in the first factor. -/
theorem spE_substHom {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ)
    (g : PresentedGroup ({r} : Set (FreeGroup α))) :
    spE r hxt p q (substHom r t x p q g) =
      Monoid.PushoutI.of (φ := amPhi r t p) true g := by
  refine PresentedGroup.induction_on
    (C := fun y : PresentedGroup ({r} : Set (FreeGroup α)) =>
      spE r hxt p q (substHom r t x p q y) =
        Monoid.PushoutI.of (φ := amPhi r t p) true y) g (fun w => ?_)
  rw [substHom_mk, spE_apply]
  exact congrArg (fun f : FreeGroup α →* Monoid.PushoutI (amPhi r t p) => f w)
    (sp_lift_key r hxt p q)

/-! ## The homomorphism `spE' : PushoutI (amPhi r t p) →* ⟨α | ψ r⟩` -/

/-- **The backward map**, out of the pushout: `substHom` on the first factor, `s ↦ mk t` on the
second one. -/
noncomputable def spE' {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    Monoid.PushoutI (amPhi r t p) →* PresentedGroup ({subst t x p q r} : Set (FreeGroup α)) :=
  Monoid.PushoutI.lift (spF r t x p q) (spK r t x p q) (sp_hf r t x p q)

@[simp] theorem spE'_of_true {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ)
    (g : PresentedGroup ({r} : Set (FreeGroup α))) :
    spE' r t x p q (Monoid.PushoutI.of (φ := amPhi r t p) true g) = substHom r t x p q g := by
  show (Monoid.PushoutI.lift (spF r t x p q) (spK r t x p q) (sp_hf r t x p q))
      (Monoid.PushoutI.of (φ := amPhi r t p) true g) = substHom r t x p q g
  rw [Monoid.PushoutI.lift_of, spF_true]

@[simp] theorem spE'_of_false {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ)
    (n : ULift.{u} (Multiplicative ℤ)) :
    spE' r t x p q (Monoid.PushoutI.of (φ := amPhi r t p) false n) =
      (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^
        (Multiplicative.toAdd n.down) := by
  show (Monoid.PushoutI.lift (spF r t x p q) (spK r t x p q) (sp_hf r t x p q))
      (Monoid.PushoutI.of (φ := amPhi r t p) false n) =
    (PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^
      (Multiplicative.toAdd n.down)
  rw [Monoid.PushoutI.lift_of, spF_false_apply]

theorem spE'_spS {α : Type u} (r : FreeGroup α) (t x : α) (p q : ℤ) :
    spE' r t x p q (spS r t p) =
      PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t) := by
  show spE' r t x p q (Monoid.PushoutI.of (φ := amPhi r t p) false spGen) = _
  rw [spE'_of_false]
  simp only [spGen_toAdd, zpow_one]

/-- `spE` sends the class of `t ^ z` to `s ^ z`. -/
theorem spE_genT_zpow {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) (z : ℤ) :
    spE r hxt p q
        ((PresentedGroup.mk ({subst t x p q r} : Set (FreeGroup α)) (FreeGroup.of t)) ^ z) =
      spS r t p ^ z := by
  rw [map_zpow, spE_apply, FreeGroup.lift_apply_of, spPt_t]

/-! ## The two composites are the identity -/

theorem spE'_comp_spE {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    (spE' r t x p q).comp (spE r hxt p q) =
      MonoidHom.id (PresentedGroup ({subst t x p q r} : Set (FreeGroup α))) := by
  apply PresentedGroup.ext
  intro a
  rw [MonoidHom.comp_apply, MonoidHom.id_apply, spE_of r hxt p q a]
  by_cases hat : a = t
  · rw [hat, spPt_t, spE'_spS]
    rfl
  · by_cases hax : a = x
    · rw [hax, spPt_x r hxt p q]
      rw [map_mul, map_zpow, spE'_of_true, spE'_spS, sp_substHom_of_x r hxt p q]
      rw [mul_assoc, ← zpow_add, neg_add_cancel, zpow_zero, mul_one]
      rfl
    · rw [spPt_of_ne r hat hax p q, spE'_of_true,
        show PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) a
          = PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of a) from rfl,
        substHom_mk, sp_subst_gen_of_ne hat hax p q]
      rfl

theorem spE_comp_spE' {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    (spE r hxt p q).comp (spE' r t x p q) =
      MonoidHom.id (Monoid.PushoutI (amPhi r t p)) := by
  apply Monoid.PushoutI.hom_ext_nonempty
  intro i
  cases i with
  | true =>
    apply PresentedGroup.ext
    intro a
    show spE r hxt p q
        (spE' r t x p q (Monoid.PushoutI.of (φ := amPhi r t p) true (PresentedGroup.of a))) =
      Monoid.PushoutI.of (φ := amPhi r t p) true (PresentedGroup.of a)
    rw [spE'_of_true, spE_substHom]
  | false =>
    ext n
    show spE r hxt p q (spE' r t x p q (Monoid.PushoutI.of (φ := amPhi r t p) false n)) =
      Monoid.PushoutI.of (φ := amPhi r t p) false n
    rw [spE'_of_false, spE_genT_zpow, spS_zpow]

/-! ## The main statement -/

/-- **The Tietze/pushout identification.**  The substitution `ψ = subst t x p q` identifies
`⟨α | ψ r⟩` with the amalgam `⟨α | r⟩ ∗_{t^n = s^{pn}} ⟨s⟩`, carrying `substHom` to the inclusion
of the first factor. -/
theorem subst_pushout_equiv {α : Type u} (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    ∃ E : PresentedGroup ({Work.OROneRel.subst t x p q r} : Set (FreeGroup α)) ≃*
        Monoid.PushoutI (Work.OROneRel.amPhi r t p),
      ∀ g, E (Work.OROneRel.substHom r t x p q g) =
        Monoid.PushoutI.of (φ := Work.OROneRel.amPhi r t p) true g :=
  ⟨MonoidHom.toMulEquiv (spE r hxt p q) (spE' r t x p q)
    (spE'_comp_spE r hxt p q) (spE_comp_spE' r hxt p q), spE_substHom r hxt p q⟩

end Work.OROneRel
