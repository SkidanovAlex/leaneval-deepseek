import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.letters_closure_iff
import Submission.Work.OROneRel.relatorLetters_eq_empty_iff

/-!
# Provable cases of the Freiheitssatz

The general Freiheitssatz is an input (see `Interface.lean`).  Here we record two cases that are
provable outright from Mathlib's free group API:

* if the relator avoids the generators `T`, the canonical map `F(T) → ⟨α | r⟩` is injective (this is
  in `injective_presentedGroupMap_of_disjoint`), and a Magnus subgroup is free
  (`magnusSubgroupOf_equiv_freeGroup`);
* if the relator is `of x * w` with `w` avoiding `x`, then `x` is redundant and
  `⟨α | of x * w⟩ ≃ F(α \ {x})` -- a case in which the Freiheitssatz conclusion is sharp.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- An element supported on `Z` is the image of an element of `FreeGroup Z` under the canonical
inclusion. -/
theorem exists_lift_of_supportedOn {Z : Set α} {w : FreeGroup α} (hw : SupportedOn w Z) :
    ∃ w' : FreeGroup Z, FreeGroup.lift (fun a : Z => FreeGroup.of (a : α)) w' = w := by
  have hmem : w ∈ Subgroup.closure (FreeGroup.of '' Z) := (letters_closure_iff w Z).mpr hw
  rw [show Subgroup.closure (FreeGroup.of '' Z) =
      (FreeGroup.lift (fun a : Z => FreeGroup.of (a : α))).range from by
    rw [FreeGroup.range_lift_eq_closure, Set.image_eq_range]] at hmem
  exact MonoidHom.mem_range.mp hmem

/-- If the relator involves none of the generators in `T` (and is nontrivial) then the subgroup of
`⟨α | r⟩` generated by `T` is a Magnus subgroup. -/
theorem isMagnusSubgroup_magnusSubgroupOf_of_disjoint (r : FreeGroup α) {T : Set α} (hr : r ≠ 1)
    (h : ∀ a ∈ relatorLetters r, a ∉ T) : IsMagnusSubgroup (magnusSubgroupOf r T) := by
  refine ⟨T, fun hmem => ?_, rfl⟩
  have hsub : SupportedOn r T := (letters_closure_iff r T).mp hmem
  have hempty : relatorLetters r = ∅ := by
    by_contra hne
    obtain ⟨a, ha⟩ : (relatorLetters r).Nonempty := Set.nonempty_iff_ne_empty.mpr hne
    exact h a ha (hsub ha)
  exact hr ((relatorLetters_eq_empty_iff r).mp hempty)

/-- Shrinking the set of generators: a Magnus subgroup stays Magnus. -/
theorem isMagnusSubgroup_of_le {r : FreeGroup α} {T T' : Set α} (h : T ⊆ T')
    (hT' : r ∉ Subgroup.closure (FreeGroup.of '' T')) :
    IsMagnusSubgroup (magnusSubgroupOf r T) :=
  ⟨T, fun hmem => hT' (Subgroup.closure_mono (Set.image_mono h) hmem), rfl⟩

/-- If the relator is `of x * w` with `w` not involving `x`, then `x` is redundant: the one-relator
group is free on the remaining generators, the isomorphism being a retraction of the canonical map
`F(α \ {x}) →* ⟨α | of x * w⟩`. -/
theorem exists_mulEquiv_of_mul_with_retraction (x : α) (w : FreeGroup α)
    (hw : ∀ a ∈ relatorLetters w, a ≠ x) :
    ∃ e : PresentedGroup ({FreeGroup.of x * w} : Set (FreeGroup α)) ≃*
        FreeGroup {a : α // a ≠ x},
      ∀ y : FreeGroup {a : α // a ≠ x},
        e (presentedGroupMap (FreeGroup.of x * w) {a | a ≠ x} y) = y := by
  classical
  obtain ⟨w', hw'⟩ := exists_lift_of_supportedOn (Z := {a | a ≠ x}) hw
  let ι : FreeGroup {a : α // a ≠ x} →* FreeGroup α := FreeGroup.lift fun a => FreeGroup.of (a : α)
  have hιw : ι w' = w := hw'
  let f : α → FreeGroup {a : α // a ≠ x} :=
    fun a => if h : a = x then w'⁻¹ else FreeGroup.of ⟨a, h⟩
  have hf_ne : ∀ a : {a : α // a ≠ x}, f (a : α) = FreeGroup.of a := by
    intro a
    dsimp only [f]
    rw [dif_neg a.2]
  have hf_x : f x = w'⁻¹ := by
    dsimp only [f]
    rw [dif_pos rfl]
  have hcomp : (FreeGroup.lift f).comp ι = MonoidHom.id (FreeGroup {a : α // a ≠ x}) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    simp only [MonoidHom.comp_apply, MonoidHom.id_apply, ι, FreeGroup.lift_apply_of, hf_ne]
  have hker : FreeGroup.lift f (FreeGroup.of x * w) = 1 := by
    rw [map_mul, FreeGroup.lift_apply_of, hf_x, ← hιw, ← MonoidHom.comp_apply, hcomp,
      MonoidHom.id_apply]
    simp
  let φ : PresentedGroup ({FreeGroup.of x * w} : Set (FreeGroup α)) →*
      FreeGroup {a : α // a ≠ x} :=
    PresentedGroup.toGroup (f := f) (by
      intro r hr
      rw [Set.mem_singleton_iff.mp hr]
      exact hker)
  let ψ : FreeGroup {a : α // a ≠ x} →*
      PresentedGroup ({FreeGroup.of x * w} : Set (FreeGroup α)) :=
    presentedGroupMap (FreeGroup.of x * w) {a | a ≠ x}
  have hψeq : ψ = (PresentedGroup.mk _).comp ι := rfl
  have hφψ : φ.comp ψ = MonoidHom.id (FreeGroup {a : α // a ≠ x}) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    show φ (ψ (FreeGroup.of a)) = FreeGroup.of a
    have h1 : ψ (FreeGroup.of a) = PresentedGroup.of (a : α) := by
      rw [hψeq]
      simp only [MonoidHom.comp_apply, ι, FreeGroup.lift_apply_of]
      rfl
    rw [h1]
    have h2 : φ (PresentedGroup.of (a : α)) = f (a : α) := by
      simp only [φ, PresentedGroup.toGroup.of]
    rw [h2]
    exact hf_ne a
  have hψφ : ψ.comp φ = MonoidHom.id (PresentedGroup ({FreeGroup.of x * w} : Set (FreeGroup α))) := by
    refine PresentedGroup.ext fun a => ?_
    show ψ (φ (PresentedGroup.of a)) = PresentedGroup.of a
    by_cases ha : a = x
    · subst ha
      have hrel : (PresentedGroup.mk ({FreeGroup.of a * w} : Set (FreeGroup α)))
          (FreeGroup.of a * w) = 1 := PresentedGroup.one_of_mem (Set.mem_singleton _)
      have hone : (PresentedGroup.mk ({FreeGroup.of a * w} : Set (FreeGroup α))) (FreeGroup.of a) =
          ((PresentedGroup.mk ({FreeGroup.of a * w} : Set (FreeGroup α))) w)⁻¹ :=
        eq_inv_of_mul_eq_one_left hrel
      have hφa : φ (PresentedGroup.of a) = w'⁻¹ := by
        simp only [φ, PresentedGroup.toGroup.of, hf_x]
      have hψw : ψ w' = (PresentedGroup.mk ({FreeGroup.of a * w} : Set (FreeGroup α))) w := by
        rw [hψeq]
        simp only [MonoidHom.comp_apply, ι, hιw]
      rw [hφa, map_inv, hψw]
      exact hone.symm
    · have hfx : f a = FreeGroup.of ⟨a, ha⟩ := by
        dsimp only [f]
        rw [dif_neg ha]
      have hφa : φ (PresentedGroup.of a) = FreeGroup.of ⟨a, ha⟩ := by
        simp only [φ, PresentedGroup.toGroup.of, hfx]
      rw [hφa]
      show ψ (FreeGroup.of ⟨a, ha⟩) = PresentedGroup.of a
      rw [hψeq]
      simp only [MonoidHom.comp_apply, ι, FreeGroup.lift_apply_of]
      rfl
  exact ⟨MonoidHom.toMulEquiv φ ψ hψφ hφψ, fun y => DFunLike.congr_fun hφψ y⟩

/-- If the relator is `of x * w` with `w` not involving `x`, then the one-relator group is free on
the remaining generators. -/
theorem presentedGroup_of_mul_of_iso_freeGroup (x : α) (w : FreeGroup α)
    (hw : ∀ a ∈ relatorLetters w, a ≠ x) :
    Nonempty (PresentedGroup ({FreeGroup.of x * w} : Set (FreeGroup α)) ≃*
      FreeGroup {a : α // a ≠ x}) :=
  let ⟨e, _⟩ := exists_mulEquiv_of_mul_with_retraction x w hw
  ⟨e⟩

/-- **Freiheitssatz in the case `r = of x * w`**:  the canonical map `F(α \ {x}) →* ⟨α | of x * w⟩`
is injective. -/
theorem injective_presentedGroupMap_of_mul_of (x : α) (w : FreeGroup α)
    (hw : ∀ a ∈ relatorLetters w, a ≠ x) :
    Function.Injective (presentedGroupMap (FreeGroup.of x * w) {a | a ≠ x}) := by
  obtain ⟨e, he⟩ := exists_mulEquiv_of_mul_with_retraction x w hw
  exact Function.LeftInverse.injective (g := ⇑e) fun y => he y

end Work.OROneRel
