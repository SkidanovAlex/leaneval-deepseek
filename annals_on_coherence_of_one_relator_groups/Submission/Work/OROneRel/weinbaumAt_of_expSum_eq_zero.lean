import Mathlib
import Submission.Work.OROneRel.weinbaumDefs
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.OROneRel.letters_closure_iff
import Submission.Work.OROneRel.presentedGroup_iso_coprod_of_supported
import Submission.Work.OROneRel.weinbaum_covering_noZeroExpSum
import Submission.Work.OROneRel.weinbaum_sigma_zero_of_half

/-!
# Weinbaum's theorem in the exponent-sum-zero case

We record two reductions of Weinbaum's theorem `Work.OROneRel.WeinbaumAt r` which will be used to
prove the exponent-sum-zero case `Work.OROneRel.weinbaumAt_of_expSum_eq_zero`.

## The Freiheitssatz reduction

If `v` is a counterexample (a nontrivial subword of a power of `r` which is trivial in `⟨α | r⟩`) and
`v` does not involve every letter of `r`, then the Freiheitssatz at `r` already contradicts this:
with `T = relatorLetters v` one has `r ∉ ⟨T⟩`, and a lift of `v` to `F(T)` would lie in the kernel of
the (injective) map `F(T) →* ⟨α | r⟩`, so would be trivial, forcing `v = 1`.

Consequently, a counterexample must *cover* all the letters of `r`.  This is
`not_covering_of_counterexample` and `weinbaumAt_of_covering` below.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- **A counterexample to Weinbaum's theorem covers all the letters of the relator.**  If `v` is a
nontrivial subword of a power of a cyclically reduced relator `r` which is trivial in `⟨α | r⟩`, and
`v` misses some letter of `r`, the Freiheitssatz at `r` gives a contradiction. -/
theorem not_covering_of_counterexample {r v : FreeGroup α}
    (hcyc : IsCyclicallyReducedRelator r)
    (hnotcov : ¬ relatorLetters r ⊆ relatorLetters v)
    (hv1 : v ≠ 1)
    (hmk : PresentedGroup.mk ({r} : Set (FreeGroup α)) v = 1) : False := by
  classical
  -- the relator is not generated by the letters of `v`
  have hT : r ∉ Subgroup.closure (FreeGroup.of '' relatorLetters v) := fun hmem =>
    hnotcov ((letters_closure_iff r (relatorLetters v)).mp hmem)
  -- lift `v` to the free group on its own letters
  obtain ⟨v', hv'⟩ :=
    exists_lift_of_supportedOn (Z := relatorLetters v) (w := v) (fun a ha => ha)
  -- the Freiheitssatz at `r` makes the map `F (relatorLetters v) →* ⟨α | r⟩` injective
  have hinj : Function.Injective (presentedGroupMap r (relatorLetters v)) :=
    freiheitssatz_at r hcyc (relatorLetters v) hT
  have hmap : presentedGroupMap r (relatorLetters v) v' =
      PresentedGroup.mk ({r} : Set (FreeGroup α)) v := by
    rw [presentedGroupMap, MonoidHom.comp_apply, hv']
  have hone : presentedGroupMap r (relatorLetters v) v' =
      presentedGroupMap r (relatorLetters v) 1 := by
    rw [hmap, hmk, map_one]
  have hv'1 : v' = 1 := hinj hone
  refine hv1 ?_
  rw [← hv', hv'1, map_one]

/-- **Weinbaum's theorem follows from its covering case.**  It suffices to check the conclusion for
those nonzero subwords `v` which involve every letter of `r`; any counterexample missing a letter is
excluded by the Freiheitssatz (`not_covering_of_counterexample`). -/
theorem weinbaumAt_of_covering {r : FreeGroup α}
    (hcov : ∀ (k : ℕ) (v : FreeGroup α), IsSubwordOf v (r ^ k) → relatorNorm v < relatorNorm r →
      v ≠ 1 → relatorLetters r ⊆ relatorLetters v →
      PresentedGroup.mk ({r} : Set (FreeGroup α)) v ≠ 1) :
    WeinbaumAt r := by
  intro hcyc _hpp k v hsub hlen hv1 hmk
  by_cases hc : relatorLetters r ⊆ relatorLetters v
  · exact hcov k v hsub hlen hv1 hc hmk
  · exact not_covering_of_counterexample hcyc hc hv1 hmk

theorem weinbaumAt_of_expSum_eq_zero {α : Type u} (r : FreeGroup α) {a : α}
    (ha : a ∈ Work.OROneRel.relatorLetters r) (h : Work.OROneRel.expSum a r = 1) :
    Work.OROneRel.WeinbaumAt r := by
  intro hr hp k v hsub hlen hv1
  exact weinbaum_sigma_zero_of_half r hr ha h
    (wcp_weinbaum_sigma_zero_half r hr hp ha h) k v hsub hlen hv1

end Work.OROneRel
