import Mathlib
import Submission.Work.OROneRel.Basic

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- The normal closure of a singleton is invariant under conjugation: the normal closure of
`{c * a * c⁻¹}` is the normal closure of `{a}`.  (Both are generated by the conjugacy class of
`a`, since `a` and `c * a * c⁻¹` are conjugate.) -/
theorem normalClosure_conj_singleton (a c : FreeGroup α) :
    Subgroup.normalClosure ({c * a * c⁻¹} : Set (FreeGroup α)) =
    Subgroup.normalClosure ({a} : Set (FreeGroup α)) := by
  apply le_antisymm
  · rw [← Subgroup.normalClosure_subset_iff, Set.singleton_subset_iff]
    exact (Subgroup.normalClosure_normal (s := ({a} : Set (FreeGroup α)))).conj_mem a
      (Subgroup.subset_normalClosure (Set.mem_singleton a)) c
  · rw [← Subgroup.normalClosure_subset_iff, Set.singleton_subset_iff]
    have hmem : c⁻¹ * (c * a * c⁻¹) * c ∈
        Subgroup.normalClosure ({c * a * c⁻¹} : Set (FreeGroup α)) := by
      simpa only [inv_inv] using
        (Subgroup.normalClosure_normal (s := ({c * a * c⁻¹} : Set (FreeGroup α)))).conj_mem
          (c * a * c⁻¹) (Subgroup.subset_normalClosure (Set.mem_singleton _)) c⁻¹
    have heq : c⁻¹ * (c * a * c⁻¹) * c = a := by group
    rwa [heq] at hmem

/-- Conjugate relators define isomorphic one-relator presentations, via the identity on the
underlying free group.  If `u = c * w * c⁻¹` then `u ^ l = c * w ^ l * c⁻¹`, so the normal
closures of `{u ^ l}` and `{w ^ l}` coincide and the identity of `FreeGroup α` descends to an
isomorphism carrying `mk u` to `mk u`. -/
theorem presentedGroup_pow_conj_iso {α : Type u} (u w c : FreeGroup α) (l : ℕ)
    (h : c * w * c⁻¹ = u) :
    ∃ e : PresentedGroup ({u ^ l} : Set (FreeGroup α)) ≃*
        PresentedGroup ({w ^ l} : Set (FreeGroup α)),
      e (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) =
        PresentedGroup.mk ({w ^ l} : Set (FreeGroup α)) u := by
  -- `u` is conjugate to `w`, hence `u ^ l = c * w ^ l * c⁻¹`.
  have hu : u ^ l = c * w ^ l * c⁻¹ := by
    rw [← h]
    induction l with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, pow_succ]
      group
  -- The two relations therefore generate the same normal closure.
  have hN : Subgroup.normalClosure ({u ^ l} : Set (FreeGroup α)) =
      Subgroup.normalClosure ({w ^ l} : Set (FreeGroup α)) := by
    rw [hu]
    exact normalClosure_conj_singleton (w ^ l) c
  -- The identity of `FreeGroup α` maps the first normal closure onto the second.
  have hmap : Subgroup.map (↑(MulEquiv.refl (FreeGroup α)))
      (Subgroup.normalClosure ({u ^ l} : Set (FreeGroup α))) =
      Subgroup.normalClosure ({w ^ l} : Set (FreeGroup α)) := by
    show Subgroup.map (MonoidHom.id (FreeGroup α)) _ = _
    rw [Subgroup.map_id, hN]
  refine ⟨QuotientGroup.congr (Subgroup.normalClosure ({u ^ l} : Set (FreeGroup α)))
      (Subgroup.normalClosure ({w ^ l} : Set (FreeGroup α))) (MulEquiv.refl (FreeGroup α)) hmap, ?_⟩
  change (QuotientGroup.congr (Subgroup.normalClosure ({u ^ l} : Set (FreeGroup α)))
      (Subgroup.normalClosure ({w ^ l} : Set (FreeGroup α))) (MulEquiv.refl (FreeGroup α)) hmap)
      (QuotientGroup.mk u) = QuotientGroup.mk u
  rw [QuotientGroup.congr_mk]
  rfl

end Work.OROneRel
