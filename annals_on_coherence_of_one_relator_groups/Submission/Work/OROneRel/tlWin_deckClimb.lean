import Mathlib
import Submission.Work.OROneRel.twoLetterTlDefs
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.OROneRel.winAssembly
import Submission.Work.OROneRel.hnnConjSplit
import Submission.Work.OROneRel.hnnConjMap_deckChange
import Submission.Work.OROneRel.band_hnnConjMap_injective
import Submission.Work.OROneRel.tlWin_pq_eq_tlH

/-!
# The window climb with the deck change: the two-letter crux from three explicit inputs

The F₂-level crux `Work.OROneRel.band_hnnConjMap_injective` -- injectivity of
`hnnConjMap (tlH p q Wt) (tlLowTau p q)` -- is reduced here to **three** statements with no
occurrence of the *value* of the opaque element `tlLowTau p q = (twoLetterLowTauBound …).choose`:

1. `hnnConjMap_injective_tlWin_climb` (this file): the **window climb**, i.e. that the recursion
   `tlWin p q (m+1) = tlWin p q m ⊔ (tlWin p q m).map (MulAut.conj σ)` propagates the injectivity
   of `hnnConjMap · σ` from the bottom window `p+q-1` to the top window `p*q`.  The recursion is
   the statement `Work.OROneRel.tlWin_succ_of_walk_le` (delegated), whose hypothesis is only that
   the walk of `σ` lies in `[0,m]`.

2. the **bottom case** `Injective (hnnConjMap (tlWin p q (p+q-1)) σ)`: the window graph `Y[0,p+q-1]`
   is a cycle, so `tlWin p q (p+q-1)` is cyclic; the HNN of a cyclic vertex group is generated by
   `of u` and `t`, so `hnnConjMap_injective_of_two_generated` applies as soon as
   `tlWin p q (p+q-1) ⊔ Subgroup.zpowers σ = ⊤`.

3. the **deck identification** `tlLowTau p q * σ⁻¹ ∈ tlWin p q (p*q)`, which by the deck change
   `Work.OROneRel.hnnConjMap_injective_iff_mul_left` converts the `σ`-injectivity into the
   `tlLowTau`-injectivity.  This is a *walk* statement (the walk of `tlLowTau` lies in `[0,p*q]`,
   and `σ` may be chosen with its walk in `[0,p+q-1]`), so it does not see the value of the
   `Classical.choose` either.

The point of the reduction is that the *only* remaining mathematical input is (1) (plus the
elementary (2),(3)): for the *opaque* `tlLowTau`, (1) is false in general --- a verified
counterexample is `(p,q) = (3,4)`, `m = 8`, `τ₀ = a² b a b³ a b` --- but with `σ` ranging over
`tlLowTau · (tlWin p q (p*q))` one may pick `σ` with its walk in `[0,p+q-1]`, for which (1) holds;
and `tlLowTau * σ⁻¹ ∈ tlWin p q (p*q)` because at the level of the *window* `[0,p*q]` both elements
are walked inside it.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.OROneRel

universe u

/-- **The window climb.**  If the window recursion
`tlWin p q (m+1) = tlWin p q m ⊔ (tlWin p q m).map (MulAut.conj σ)` holds for all `m` from `p+q-1`
to `p*q - 1`, then injectivity of `hnnConjMap · σ` ascends the chain
`tlWin p q (p+q-1) ≤ ⋯ ≤ tlWin p q (p*q)`. -/
theorem hnnConjMap_injective_tlWin_climb (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hcop : Nat.Coprime p q) (σ : FreeGroup (Fin 2))
    (hrec : ∀ m : ℤ, ((p : ℤ) + (q : ℤ) - 1) ≤ m → m + 1 ≤ (p : ℤ) * (q : ℤ) →
      tlWin p q (m + 1) = tlWin p q m ⊔ (tlWin p q m).map (MulAut.conj σ))
    (hbot : Function.Injective (hnnConjMap (tlWin p q ((p : ℤ) + (q : ℤ) - 1)) σ)) :
    Function.Injective (hnnConjMap (tlWin p q ((p : ℤ) * (q : ℤ))) σ) := by
  have hnonneg : 0 ≤ (p : ℤ) * (q : ℤ) - ((p : ℤ) + (q : ℤ) - 1) := by
    have hp1 : (1 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp
    have hq1 : (1 : ℤ) ≤ (q : ℤ) := by exact_mod_cast hq
    nlinarith [mul_nonneg (by linarith : (0:ℤ) ≤ (p:ℤ) - 1) (by linarith : (0:ℤ) ≤ (q:ℤ) - 1)]
  set n : ℕ := Int.toNat ((p : ℤ) * (q : ℤ) - ((p : ℤ) + (q : ℤ) - 1)) with hn
  have hmn : ((p : ℤ) + (q : ℤ) - 1) + (n : ℤ) = (p : ℤ) * (q : ℤ) := by
    rw [hn, Int.toNat_of_nonneg hnonneg]; ring
  have hkey : ∀ j : ℕ, ∀ a : ℤ, ((p : ℤ) + (q : ℤ) - 1) ≤ a → a + (j : ℤ) ≤ (p : ℤ) * (q : ℤ) →
      conjChain σ j (tlWin p q a) = tlWin p q (a + (j : ℤ)) := by
    intro j
    induction j with
    | zero => intro a _ _; simp [conjChain]
    | succ j ih =>
        intro a ha hle
        rw [conjChain, ← hrec a ha (by push_cast at hle ⊢; linarith),
          ih (a + 1) (by linarith) (by push_cast at hle ⊢; linarith)]
        push_cast
        congr 1
        ring
  have htop : conjChain σ n (tlWin p q ((p : ℤ) + (q : ℤ) - 1)) =
      tlWin p q ((p : ℤ) * (q : ℤ)) := by
    rw [hkey n (((p : ℤ) + (q : ℤ) - 1)) le_rfl (le_of_eq hmn), hmn]
  rw [← htop]
  exact hnnConjMap_injective_of_conjChain hbot n

/-- **The two-letter crux from the three inputs.**  If `σ` has weight one, its walk lies in the
short window `[0,p+q-1]` (so that the climb of `hnnConjMap_injective_tlWin_climb` applies), the
bottom case holds and `tlLowTau p q * σ⁻¹` lies in the band vertex, then the F₂-level crux
`Work.OROneRel.band_hnnConjMap_injective` holds. -/
theorem band_hnnConjMap_injective_of_shortDeck (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q)
    {hcop : Nat.Coprime p q} {Wt : ℤ → FreeGroup (Fin 2)} {σ : FreeGroup (Fin 2)}
    (hrec : ∀ m : ℤ, ((p : ℤ) + (q : ℤ) - 1) ≤ m → m + 1 ≤ (p : ℤ) * (q : ℤ) →
      tlWin p q (m + 1) = tlWin p q m ⊔ (tlWin p q m).map (MulAut.conj σ))
    (hbot : Function.Injective (hnnConjMap (tlWin p q ((p : ℤ) + (q : ℤ) - 1)) σ))
    (hdeck : tlLowTau p q hp hq hcop * σ⁻¹ ∈ tlWin p q ((p : ℤ) * (q : ℤ)))
    (htop : tlWin p q ((p : ℤ) * (q : ℤ)) = tlH p q Wt) :
    Function.Injective (hnnConjMap (tlH p q Wt) (tlLowTau p q hp hq hcop)) := by
  have hσ : Function.Injective (hnnConjMap (tlWin p q ((p : ℤ) * (q : ℤ))) σ) :=
    hnnConjMap_injective_tlWin_climb p q hp hq hcop σ hrec hbot
  -- transport to `tlH` along the identification of the top window with the band vertex
  have hτ' : tlLowTau p q hp hq hcop * σ⁻¹ ∈ tlH p q Wt := htop ▸ hdeck
  have hiff := hnnConjMap_injective_iff_mul_left (H := tlH p q Wt)
    (hγ := hτ') (h := by rw [mul_assoc, inv_mul_cancel, mul_one])
  rw [htop] at hσ
  exact hiff.mpr hσ

end Work.OROneRel
