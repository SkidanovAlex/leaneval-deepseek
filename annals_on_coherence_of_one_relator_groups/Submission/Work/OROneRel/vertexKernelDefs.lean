/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# The weight map on `⟨α | u ^ l⟩` and the vertex of the Magnus step

Let `c : α → ℤ` be a weight with `cohom c u = 1` (the total weight of `u` is zero).  Then the weight
homomorphism `cohom c : F α →* Multiplicative ℤ` kills `u ^ l` for every `l`, hence descends to the
one-relator group `G = ⟨α | u ^ l⟩`:

  `presentedCohom c u l hc : PresentedGroup ({u ^ l}) →* Multiplicative ℤ`.

Its kernel `ker (presentedCohom c u l hc)` is the *vertex group* of the Magnus--Moldavanskii step in
the `ℤ`-cover picture: it is the subgroup of `G` generated by the loop classes of the edges of the
`ℤ`-cover cut out by a fundamental domain, and the step is `G ≅ HNN (ker φ) A B ψ` with the vertex
replaced by the one-relator group `⟨β | v ^ l⟩` produced by the `ℤ`-cover decomposition
(`Work.OROneRel.ker_eq_vertex_one_relator`).

This file is `sorry`-free and contains only definitions and the two basic evaluation lemmas, so that
lemma requests may import it.

## Notation

* `presentedCohom_mk_pow` : the relation `u ^ l` is killed by the weight map;
* `presentedCohom_mk_u` : the class of the root `u` lies in the kernel (for `1 ≤ l`): indeed `mk u`
  has order dividing `l` and `Multiplicative ℤ` is torsion-free.
-/
import Mathlib
import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.MagnusGenDefs

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- The well-definedness input of `presentedCohom`: the weight map kills the relation `u ^ l`. -/
private theorem presentedCohomAux (c : α → ℤ) (u : FreeGroup α) (l : ℕ)
    (hc : Work.OROneRel.cohom c u = 1) :
    ∀ r ∈ ({u ^ l} : Set (FreeGroup α)),
      FreeGroup.lift (fun x : α => Work.OROneRel.cohom c (FreeGroup.of x)) r = 1 := by
  intro r hr
  rw [Set.mem_singleton_iff] at hr
  subst hr
  have h1 : FreeGroup.lift (fun x : α => Work.OROneRel.cohom c (FreeGroup.of x)) =
      Work.OROneRel.cohom c := by
    refine FreeGroup.ext_hom _ _ fun x => ?_
    rw [FreeGroup.lift_apply_of]
  rw [h1, map_pow, hc, one_pow]

/-- **The weight map on the one-relator group `⟨α | u ^ l⟩`.**  A weight `c` with `cohom c u = 1`
kills every power of `u`, so the weight homomorphism descends to the quotient. -/
noncomputable def presentedCohom (c : α → ℤ) (u : FreeGroup α) (l : ℕ)
    (hc : Work.OROneRel.cohom c u = 1) :
    PresentedGroup ({u ^ l} : Set (FreeGroup α)) →* Multiplicative ℤ :=
  PresentedGroup.toGroup (f := fun x : α => Work.OROneRel.cohom c (FreeGroup.of x))
    (presentedCohomAux c u l hc)

/-- The weight map on generators of the presented group. -/
theorem presentedCohom_of (c : α → ℤ) (u : FreeGroup α) (l : ℕ)
    (hc : Work.OROneRel.cohom c u = 1) (x : α) :
    presentedCohom c u l hc (PresentedGroup.of x) =
      Work.OROneRel.cohom c (FreeGroup.of x) :=
  PresentedGroup.toGroup.of (f := fun x : α => Work.OROneRel.cohom c (FreeGroup.of x))
    (presentedCohomAux c u l hc)

/-- The relation `u ^ l` is killed by the weight map. -/
theorem presentedCohom_mk_pow (c : α → ℤ) (u : FreeGroup α) (l : ℕ)
    (hc : Work.OROneRel.cohom c u = 1) :
    presentedCohom c u l hc (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) (u ^ l)) = 1 := by
  rw [PresentedGroup.one_of_mem (Set.mem_singleton _), map_one]

/-- **The class of the root `u` lies in the kernel of the weight map.**  Its `l`-th power is the
class of the relation, hence `1`, while `Multiplicative ℤ` is torsion-free. -/
theorem presentedCohom_mk_u (c : α → ℤ) (u : FreeGroup α) (l : ℕ)
    (hc : Work.OROneRel.cohom c u = 1) (hl : 1 ≤ l) :
    presentedCohom c u l hc (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) = 1 := by
  have hpow : (presentedCohom c u l hc (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u)) ^ l = 1 := by
    rw [← map_pow]
    rw [show (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) ^ l =
        PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) (u ^ l) from
      (map_pow (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α))) u l).symm]
    rw [PresentedGroup.one_of_mem (Set.mem_singleton _), map_one]
  rcases (pow_eq_one_iff.mp hpow) with h | h
  · exact h
  · omega

end Work.OROneRel
