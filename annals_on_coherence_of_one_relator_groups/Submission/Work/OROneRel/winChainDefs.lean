import Mathlib
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.OROneRel.GaugeDefs
import Submission.Work.OROneRel.decor_winE_shift

/-!
# The graph-theoretic vocabulary of the window decomposition of the `Z`-cover

This file sets up the vocabulary used to prove that the window vertex `H = (winRho Wt c lo hi).range`
*normally generates* the weight kernel `ker (cohom c)` of the free group `F α`:

  `ker (cohom c) = Subgroup.normalClosure (H : Set (FreeGroup α))`,

which is equivalent to the generation `H ⊔ ⟨τ⟩ = ⊤` for any weight-one `τ` with window walk.

The level graph `Y` of the `Z`-cover of the rose on `α` has vertices `ℤ` and edges `α × ℤ`, the edge
`(x,i)` running from level `i` to level `i + c x`.  A *word* `L : List (α × Bool)` read at base level
`b` is a walk in an edge set `S` if all of its decorated edges lie in `S`; it is closed if in addition
`lsig c L = 0`.

The subgroup of `F α` generated by the closed walks at base level `b` with edges in `S` is
`W c S b`.  The window `D = winE c lo hi` satisfies `W c (winE c lo hi) 0 = (winRho Wt c lo hi).range`
(given the tree condition `htree`), and the translates `t ^ k D` cover the whole level graph `Y`
(`hcov`), so that `ker (cohom c) = ⨆ k, W c D k` once the pieces have connected "gates".

The structural inputs are isolated in separate modules:

* `Work.OROneRel.winChain_gate` — the gates `D ∩ t D = winE c (lo+1) hi` and
  `D ∩ t⁻¹D = winE c lo (hi-1)` of the window are connected;
* `Work.OROneRel.winChain_union` — the van Kampen generation for two subgraphs with connected
  intersection.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- A word read at base level `b` is a walk in the edge set `S` if all of its decorated edges lie in
`S`. -/
def EWalkIn (c : α → ℤ) (S : Set (α × ℤ)) (b : ℤ) (L : List (α × Bool)) : Prop :=
  ∀ e ∈ decor c b L, coverEdge e ∈ S

/-- The closed walks at base level `b` with edges in `S`. -/
def EWalkClosed (c : α → ℤ) (S : Set (α × ℤ)) (b : ℤ) (L : List (α × Bool)) : Prop :=
  EWalkIn c S b L ∧ lsig c L = 0

/-- **The subgroup of `F α` generated by the closed walks at base level `b` with edges in `S`.** -/
noncomputable def W (c : α → ℤ) (S : Set (α × ℤ)) (b : ℤ) : Subgroup (FreeGroup α) :=
  Subgroup.closure {x | ∃ L : List (α × Bool), EWalkClosed c S b L ∧ FreeGroup.mk L = x}

theorem mem_W_iff {c : α → ℤ} {S : Set (α × ℤ)} {b : ℤ} {x : FreeGroup α} :
    x ∈ W c S b ↔ x ∈ Subgroup.closure {y | ∃ L : List (α × Bool),
      EWalkClosed c S b L ∧ FreeGroup.mk L = y} := Iff.rfl

/-- The vertices (levels) of the edge set `S`. -/
def EVertex (c : α → ℤ) (S : Set (α × ℤ)) (i : ℤ) : Prop :=
  ∃ e ∈ S, e.2 = i ∨ e.2 + c e.1 = i

/-- **Connectivity of an edge set**: any two of its vertices are joined by a walk with edges in
`S`. -/
def EConnected (c : α → ℤ) (S : Set (α × ℤ)) : Prop :=
  ∀ i : ℤ, EVertex c S i → ∀ j : ℤ, EVertex c S j →
    ∃ L : List (α × Bool), EWalkIn c S i L ∧ lsig c L = j - i

/-- The shift `t ^ k` of an edge set: `(x,i) ↦ (x, i+k)`. -/
def EShift (k : ℤ) (S : Set (α × ℤ)) : Set (α × ℤ) := {e | (e.1, e.2 - k) ∈ S}

@[simp] theorem mem_EShift {k : ℤ} {S : Set (α × ℤ)} {e : α × ℤ} :
    e ∈ EShift k S ↔ (e.1, e.2 - k) ∈ S := Iff.rfl

/-- The window translated by `k` is the shift of the window. -/
theorem EShift_winE (c : α → ℤ) (lo hi k : ℤ) :
    EShift k (winE c lo hi) = winE c (lo + k) (hi + k) := by
  ext e
  simp only [mem_EShift, mem_winE]
  constructor <;> intro h <;> refine ⟨?_, ?_, ?_, ?_⟩ <;> omega

/-- Read at a different base level: `L` at base `b` with edges in the shift `tᵏ S` is the same as
`L` at base `b - k` with edges in `S`. -/
theorem EWalkIn_EShift {c : α → ℤ} {S : Set (α × ℤ)} {k b : ℤ} {L : List (α × Bool)} :
    EWalkIn c (EShift k S) b L ↔ EWalkIn c S (b - k) L := by
  have hdec : decor c b L = List.map (coverShift k) (decor c (b - k) L) := by
    simpa only [show (b - k) + k = b from by ring] using decor_shift_add c k (b - k) L
  unfold EWalkIn
  rw [hdec]
  constructor
  · intro h e he
    have h' := h (coverShift k e) (List.mem_map.mpr ⟨e, he, rfl⟩)
    rw [coverEdge_coverShift, mem_EShift] at h'
    simpa using h'
  · intro h e he
    rw [List.mem_map] at he
    obtain ⟨e', he', rfl⟩ := he
    rw [coverEdge_coverShift, mem_EShift]
    simpa using h e' he'

end Work.OROneRel
