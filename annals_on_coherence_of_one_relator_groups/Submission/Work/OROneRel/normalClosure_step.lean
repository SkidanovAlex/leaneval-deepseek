import Mathlib

/-!
# The one-step normal-closure lemma

Let `F = F(S)` be the free group on `S`, let `e₁ ≠ e₂` be two generators, and let

`K = Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂})`

be the subgroup generated by all the other generators.  For `R ⊆ K`, `A B C ∈ K` and `w` the word

`w = A * of e₁ * C * of e₂ * B`

(so the only `e₁`, `e₂`-letters of `w` are the *explicit* ones, in positions `2` and `4`), the lemma
says:

`y ∈ K` and `y ∈ normalClosure (R ∪ {of e₁} ∪ {w ^ l})`  ⟹  `y ∈ normalClosure R`.

The mathematical content is that the quotient `F ⧸ normalClosure R` splits as the free product
`K' * F(e₁,e₂)` with `K' = K ⧸ (K ⊓ normalClosure R)`, and that in this free product the
normal closure of `{e₁, w^l}` meets `K'` trivially: the retraction `ψ` fixing `K'`, sending
`e₁ ↦ 1` and `e₂ ↦ B(ACB)⁻¹B⁻¹` satisfies `ψ w = A C B (ACB)⁻¹ = 1` and `ψ(e₁) = 1`, so it kills
`normalClosure {e₁, w^l}` while being the identity on `K'`.

Formally, rather than building the free product decomposition, we build the retraction directly as a
homomorphism `χ : F →* K ⧸ (K ⊓ normalClosure R)` out of the free group, sending each generator
`e ∉ {e₁,e₂}` to its class modulo `K ⊓ normalClosure R`, `e₁ ↦ 1` and `e₂ ↦ B(ACB)⁻¹B⁻¹`.  Then
`χ` is the quotient map on `K` (`hχK'`, by closure induction), it kills `R` (because `R ⊆ K` and
`R ⊆ normalClosure R`), `e₁`, and `w` (whence `w^l`); hence it kills
`normalClosure (R ∪ {of e₁} ∪ {w^l})`, and on `K` its kernel is exactly `K ⊓ normalClosure R`, which
gives the conclusion.
-/

namespace Work.OROneRel

theorem normalClosure_step {S : Type*} {e₁ e₂ : S} (h12 : e₁ ≠ e₂) {A B C : FreeGroup S}
    (hA : A ∈ Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂}))
    (hB : B ∈ Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂}))
    (hC : C ∈ Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂}))
    {R : Set (FreeGroup S)}
    (hR : R ⊆ Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂}))
    (l : ℕ) {y : FreeGroup S}
    (hy : y ∈ Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂}))
    (hy' : y ∈ Subgroup.normalClosure (R ∪ {FreeGroup.of e₁} ∪ {(A * FreeGroup.of e₁ * C * FreeGroup.of e₂ * B) ^ l})) :
    y ∈ Subgroup.normalClosure R := by
  classical
  -- `K`: the subgroup generated by the generators other than `e₁`, `e₂`.
  let K : Subgroup (FreeGroup S) := Subgroup.closure (FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂})
  -- `M`: the normal closure of `R`.
  let M : Subgroup (FreeGroup S) := Subgroup.normalClosure R
  have hA_K : A ∈ K := hA
  have hB_K : B ∈ K := hB
  have hC_K : C ∈ K := hC
  have hy_K : y ∈ K := hy
  have hKof : ∀ e : S, e ≠ e₁ → e ≠ e₂ → FreeGroup.of e ∈ K := fun e h1 h2 =>
    Subgroup.subset_closure ⟨e, ⟨h1, h2⟩, rfl⟩
  -- The preimage of `M` inside `K`, and the quotient `K ⧸ (K ⊓ M)`.
  let N₀ : Subgroup K := M.comap K.subtype
  have hN₀ : N₀.Normal := Subgroup.Normal.comap (Subgroup.normalClosure_normal (s := R)) K.subtype
  let q : K →* K ⧸ N₀ := QuotientGroup.mk' N₀
  have hq_mem : ∀ z : K, q z = 1 ↔ (z : FreeGroup S) ∈ M := by
    intro z
    rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']
    exact Iff.rfl
  -- The element `B * (A * C * B)⁻¹ * B⁻¹` of `K` that will be the image of `e₂`.
  let B0 : K := ⟨B * (A * C * B)⁻¹ * B⁻¹,
    K.mul_mem (K.mul_mem hB_K (K.inv_mem (K.mul_mem (K.mul_mem hA_K hC_K) hB_K)))
      (K.inv_mem hB_K)⟩
  -- The retraction, defined on the generators of the free group.
  let f : S → K ⧸ N₀ := fun e =>
    if h : e = e₁ then 1 else if h2 : e = e₂ then q B0 else q ⟨FreeGroup.of e, hKof e h h2⟩
  let χ : FreeGroup S →* K ⧸ N₀ := FreeGroup.lift f
  have hχ_of : ∀ e : S, χ (FreeGroup.of e) = f e := fun e =>
    FreeGroup.lift_apply_of (f := f) (x := e)
  have hfe₁ : f e₁ = 1 := by
    dsimp only [f]
    rw [dif_pos rfl]
  have hfe₂ : f e₂ = q B0 := by
    dsimp only [f]
    rw [dif_neg (Ne.symm h12), dif_pos rfl]
  -- `χ` restricts to the quotient map on `K`.
  have hχK' : ∀ z : K, χ (z : FreeGroup S) = q z := by
    intro z
    have key : ∀ g (hg : g ∈ K), χ g = q ⟨g, hg⟩ := by
      intro g hg
      refine Subgroup.closure_induction
        (k := FreeGroup.of '' {e : S | e ≠ e₁ ∧ e ≠ e₂})
        (p := fun g hg => χ g = q ⟨g, hg⟩) ?_ ?_ ?_ ?_ hg
      · rintro x hx
        obtain ⟨e, he, rfl⟩ := hx
        rw [hχ_of e]
        dsimp only [f]
        rw [dif_neg he.1, dif_neg he.2]
      · exact (map_one χ).trans (map_one q).symm
      · intro x y hx hy ihx ihy
        rw [map_mul, ihx, ihy, ← map_mul]
        exact congrArg q (Subtype.ext rfl)
      · intro x hx ihx
        rw [map_inv, ihx, ← map_inv]
        exact congrArg q (Subtype.ext rfl)
    exact key z z.2
  -- The word `w`.
  let w : FreeGroup S := A * FreeGroup.of e₁ * C * FreeGroup.of e₂ * B
  have hχ_w : χ w = 1 := by
    have he1 : χ (FreeGroup.of e₁) = 1 := by rw [hχ_of e₁, hfe₁]
    have he2 : χ (FreeGroup.of e₂) = q B0 := by rw [hχ_of e₂, hfe₂]
    change χ (A * FreeGroup.of e₁ * C * FreeGroup.of e₂ * B) = 1
    rw [map_mul, map_mul, map_mul, map_mul, hχK' ⟨A, hA_K⟩, he1, hχK' ⟨C, hC_K⟩, he2,
      hχK' ⟨B, hB_K⟩]
    simp only [mul_one]
    rw [← map_mul, ← map_mul, ← map_mul]
    rw [show (⟨A, hA_K⟩ * ⟨C, hC_K⟩ * B0 * ⟨B, hB_K⟩ : K) = 1 from by
      apply Subtype.ext
      dsimp only [B0]
      simp only [Subgroup.coe_mul, Subgroup.coe_one]
      group]
    exact map_one q
  -- `χ` kills every generator of `normalClosure (R ∪ {of e₁} ∪ {w ^ l})`.
  have hgen_sub : (R ∪ {FreeGroup.of e₁} ∪ {w ^ l}) ⊆ (χ.ker : Set (FreeGroup S)) := by
    intro z hz
    simp only [Set.mem_union, Set.mem_singleton_iff] at hz
    change χ z = 1
    rcases hz with (hz | hz) | hz
    · have hzK : z ∈ K := hR hz
      rw [hχK' ⟨z, hzK⟩]
      exact (hq_mem ⟨z, hzK⟩).mpr (Subgroup.subset_normalClosure hz)
    · rw [hz, hχ_of e₁, hfe₁]
    · rw [hz, map_pow, hχ_w, one_pow]
  have hN_le : Subgroup.normalClosure (R ∪ {FreeGroup.of e₁} ∪ {w ^ l}) ≤ χ.ker :=
    Subgroup.normalClosure_le_normal hgen_sub
  have hχy : χ y = 1 := hN_le hy'
  -- On `K` the kernel of `χ` is `K ⊓ M`, so `χ y = 1` and `y ∈ K` give `y ∈ M`.
  have hyM : y ∈ M := (hq_mem ⟨y, hy_K⟩).mp (by
    rw [← hχK' ⟨y, hy_K⟩]
    exact hχy)
  exact hyM

end Work.OROneRel
