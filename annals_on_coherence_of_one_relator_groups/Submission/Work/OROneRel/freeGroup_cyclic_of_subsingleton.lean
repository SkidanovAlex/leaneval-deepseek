import Mathlib

universe u

namespace Work.OROneRel

/-- If `ι` is a subsingleton (empty or a single point), the free group on `ι` is
generated by a single element, i.e. it is cyclic. -/
theorem freeGroup_cyclic_of_subsingleton {ι : Type u} (h : ∀ a b : ι, a = b) :
    ∃ ξ : FreeGroup ι, (⊤ : Subgroup (FreeGroup ι)) = Subgroup.zpowers ξ := by
  classical
  -- The set of generators `of '' ι` has at most one element.
  have hS : ∀ x ∈ Set.range (FreeGroup.of : ι → FreeGroup ι),
      ∀ y ∈ Set.range (FreeGroup.of : ι → FreeGroup ι), x = y := by
    rintro x ⟨a, rfl⟩ y ⟨b, rfl⟩
    rw [h a b]
  by_cases hne : (Set.range (FreeGroup.of : ι → FreeGroup ι)).Nonempty
  · -- Nonempty case: the whole group is generated by any generator.
    obtain ⟨x, hx⟩ := hne
    refine ⟨x, ?_⟩
    rw [← FreeGroup.closure_range_of ι]
    exact le_antisymm
      ((Subgroup.closure_le (Subgroup.zpowers x)).mpr fun y hy => by
        rw [hS y hy x hx]
        exact Subgroup.mem_zpowers x)
      (Subgroup.zpowers_le_of_mem (Subgroup.subset_closure hx))
  · -- Empty case: the group is trivial, generated by `1`.
    have hempty : Set.range (FreeGroup.of : ι → FreeGroup ι) = ∅ :=
      Set.not_nonempty_iff_eq_empty.mp hne
    refine ⟨1, ?_⟩
    rw [← FreeGroup.closure_range_of ι, hempty, Subgroup.closure_empty,
      Subgroup.zpowers_one_eq_bot]

end Work.OROneRel
