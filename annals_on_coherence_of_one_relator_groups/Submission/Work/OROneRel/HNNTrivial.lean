import Submission.Work.OROneRel.Basic
import Mathlib.GroupTheory.HNNExtension
import Mathlib.GroupTheory.Coprod.Basic
import Mathlib.GroupTheory.FreeGroup.Basic

/-!
# HNN extensions with trivial associated subgroups

An `HNNExtension G ⊥ ⊥ φ` is the free product `G ∗ ℤ`: the stable letter `t` is subject to no
relation.  This is the `A = B = ⊥` instance of the description of an HNN extension by its base and
stable letter, and it is the step that turns "free product with a free group" into a
Magnus--Moldavanskii splitting.
-/

namespace Work.OROneRel

universe u

/-- The universal property of `HNNExtension G ⊥ ⊥ φ`: it is the free product of `G` with the free
group generated by the stable letter `t`. -/
theorem hnnExtension_bot_iso_coprod_freeGroup {G : Type u} [Group G]
    (φ : (⊥ : Subgroup G) ≃* (⊥ : Subgroup G)) :
    Nonempty (HNNExtension G ⊥ ⊥ φ ≃* Monoid.Coprod G (FreeGroup PUnit)) := by
  let toC : HNNExtension G ⊥ ⊥ φ →* Monoid.Coprod G (FreeGroup PUnit) :=
    HNNExtension.lift Monoid.Coprod.inl (Monoid.Coprod.inr (FreeGroup.of PUnit.unit)) (by
      intro a
      have ha : ((a : G)) = 1 := Subgroup.mem_bot.mp a.2
      have hb : (((φ a : (⊥ : Subgroup G)) : G)) = 1 := Subgroup.mem_bot.mp (φ a).2
      rw [ha, hb, map_one, mul_one, one_mul])
  let fromC : Monoid.Coprod G (FreeGroup PUnit) →* HNNExtension G ⊥ ⊥ φ :=
    Monoid.Coprod.lift HNNExtension.of (FreeGroup.lift fun _ => HNNExtension.t)
  have h1 : toC.comp fromC = MonoidHom.id (Monoid.Coprod G (FreeGroup PUnit)) := by
    refine Monoid.Coprod.hom_ext ?_ ?_
    · ext g
      simp [toC, fromC]
    · refine FreeGroup.ext_hom _ _ fun a => ?_
      simp [toC, fromC]
  have h2 : fromC.comp toC = MonoidHom.id (HNNExtension G ⊥ ⊥ φ) := by
    refine HNNExtension.hom_ext ?_ ?_
    · ext g
      simp [toC, fromC]
    · simp [toC, fromC]
  exact ⟨MonoidHom.toMulEquiv toC fromC h2 h1⟩

/-- The trivial subgroup is a Magnus subgroup of the terminal one-relator group `⟨x | x⟩` (the
relator is `of x`, which is not generated by the empty set of generators), so the splitting
`G ∗ ℤ ≅ HNN(G, ⊥, ⊥)` is a Magnus--Moldavanskii step. -/
theorem isMagnusSubgroup_bot_presentedGroup_single {β : Type u} (x : β) :
    IsMagnusSubgroup (⊥ : Subgroup (PresentedGroup ({FreeGroup.of x} : Set (FreeGroup β)))) := by
  refine ⟨∅, ?_, ?_⟩
  · rw [Set.image_empty, Subgroup.closure_empty]
    exact fun h => FreeGroup.of_ne_one x (Subgroup.mem_bot.mp h)
  · have hrange : (Set.range fun a : (∅ : Set β) =>
        PresentedGroup.of (rels := ({FreeGroup.of x} : Set (FreeGroup β))) ((a : β))) = ∅ := by
      ext y
      simp
    show (⊥ : Subgroup (PresentedGroup ({FreeGroup.of x} : Set (FreeGroup β)))) =
      Subgroup.closure (Set.range fun a : (∅ : Set β) =>
        PresentedGroup.of (rels := ({FreeGroup.of x} : Set (FreeGroup β))) ((a : β)))
    rw [hrange, Subgroup.closure_empty]

end Work.OROneRel