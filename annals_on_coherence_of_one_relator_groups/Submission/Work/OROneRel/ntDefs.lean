/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# Counting the letters of a word that are different from a fixed letter `t`

For a fixed letter `t : α` and a word `L : List (α × Bool)` we let `nt t L` be the number of
letters of `L` whose generator is **not** `t`.  This is the length of the Magnus rewriting of `L`
with respect to `t` (`Work.OROneRel.rewriteAux_length`), hence the length of the relator
`magRewRel t (mk L)`.

The file collects the elementary API: additivity on concatenation, invariance under `invRev`, under
inversion and under cyclic rotation, monotonicity under sublists and under free reduction,
subadditivity under multiplication and products, and the fact that an element of the cyclic
subgroup generated by `of t` has no letter different from `t`.

This file contains definitions and proven lemmas only (no `sorry`).
-/
import Mathlib
import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.FreiheitssatzDefs

namespace Work.OROneRel

open List -- for the `<+` notation on lists

universe u

variable {α : Type u}

attribute [local instance] Classical.propDecidable

/-- The number of letters of a word which are different from the letter `t`. -/
noncomputable def nt (t : α) (L : List (α × Bool)) : ℕ := by
  classical exact (L.filter (fun p => decide (p.1 ≠ t))).length

/-- `nt` is a letter count: it is `countP` of the letters different from `t`. -/
theorem nt_eq_countP (t : α) (L : List (α × Bool)) :
    nt t L = L.countP (fun p => decide (p.1 ≠ t)) := by
  simp only [nt, List.countP_eq_length_filter]

/-- `nt` vanishes exactly on words all of whose letters are `t`. -/
theorem nt_eq_zero_iff (t : α) (L : List (α × Bool)) :
    nt t L = 0 ↔ ∀ p ∈ L, p.1 = t := by
  rw [nt_eq_countP, List.countP_eq_zero]
  constructor
  · intro h p hp
    by_contra hne
    exact h p hp (by simp [hne])
  · intro h p hp h1
    simp [h p hp] at h1

/-- `nt` is additive over concatenation. -/
theorem nt_append (t : α) (L₁ L₂ : List (α × Bool)) :
    nt t (L₁ ++ L₂) = nt t L₁ + nt t L₂ := by
  simp only [nt, List.filter_append, List.length_append]

/-- `nt` of a singleton word. -/
theorem nt_singleton (t : α) (a : α × Bool) :
    nt t [a] = if a.1 = t then 0 else 1 := by
  simp only [nt, List.filter_cons, List.filter_nil]
  split <;> simp_all

/-- The effect of a single letter on `nt`. -/
theorem nt_cons (t : α) (a : α × Bool) (L : List (α × Bool)) :
    nt t (a :: L) = (if a.1 = t then 0 else 1) + nt t L := by
  rw [show (a :: L) = ([a] ++ L) from rfl, nt_append, nt_singleton]

/-- `nt` is bounded by the length of the word. -/
theorem nt_le_length (t : α) (L : List (α × Bool)) : nt t L ≤ L.length := by
  simp only [nt]
  exact List.length_filter_le _ _

/-- `nt` is monotone under sublists. -/
theorem nt_sublist_le {t : α} {L₁ L₂ : List (α × Bool)} (h : L₂ <+ L₁) :
    nt t L₂ ≤ nt t L₁ := by
  simp only [nt]
  exact (List.Sublist.filter _ h).length_le

/-- `nt` does not increase under free reduction. -/
theorem nt_red_le {t : α} {L₁ L₂ : List (α × Bool)} (h : FreeGroup.Red L₁ L₂) :
    nt t L₂ ≤ nt t L₁ :=
  nt_sublist_le (FreeGroup.Red.sublist h)

/-- `nt` is invariant under `invRev` (reversal with all signs flipped). -/
theorem nt_invRev (t : α) (L : List (α × Bool)) : nt t (FreeGroup.invRev L) = nt t L := by
  induction L with
  | nil => simp [nt, FreeGroup.invRev_empty]
  | cons a L ih =>
    rw [FreeGroup.invRev_cons, nt_append, ih,
      show nt t (FreeGroup.invRev [a]) = (if a.1 = t then 0 else 1) by
        simp [FreeGroup.invRev, nt_singleton],
      nt_cons]
    omega

/-- `nt` is invariant under inversion of a free group element. -/
theorem nt_inv (t : α) (x : FreeGroup α) : nt t x⁻¹.toWord = nt t x.toWord := by
  classical
  rw [FreeGroup.toWord_inv, nt_invRev]

/-- `nt` is invariant under cyclic rotation of a word. -/
theorem nt_rotate (t : α) (L : List (α × Bool)) (k : ℕ) : nt t (L.rotate k) = nt t L := by
  rw [List.rotate_eq_drop_append_take_mod, nt_append]
  conv_rhs => rw [← List.take_append_drop (k % L.length) L]
  rw [nt_append]
  omega

/-- `nt` is subadditive under multiplication in the free group. -/
theorem nt_mul_le (t : α) (x y : FreeGroup α) :
    nt t (x * y).toWord ≤ nt t x.toWord + nt t y.toWord := by
  classical
  calc nt t (x * y).toWord
      = nt t (FreeGroup.reduce (x.toWord ++ y.toWord)) := by rw [FreeGroup.toWord_mul]
    _ ≤ nt t (x.toWord ++ y.toWord) := nt_red_le FreeGroup.reduce.red
    _ = nt t x.toWord + nt t y.toWord := nt_append t _ _

/-- `nt` is subadditive under products in the free group. -/
theorem nt_prod_le (t : α) (l : List (FreeGroup α)) :
    nt t (l.prod).toWord ≤ (l.map (fun x => nt t x.toWord)).sum := by
  induction l with
  | nil => simp [nt]
  | cons x l ih =>
    rw [List.prod_cons, List.map_cons, List.sum_cons]
    calc nt t (x * l.prod).toWord ≤ nt t x.toWord + nt t l.prod.toWord := nt_mul_le t x _
      _ ≤ nt t x.toWord + (l.map (fun x => nt t x.toWord)).sum :=
            Nat.add_le_add_left ih _

/-- An element of the cyclic subgroup generated by `of t` has no letter different from `t`: the
`nt`-count of its reduced word vanishes. -/
theorem nt_of_zpow (t : α) (n : ℤ) :
    nt t ((FreeGroup.of t : FreeGroup α) ^ n).toWord = 0 := by
  classical
  have hrep : ∀ (k : ℕ) (p : α × Bool), p ∈ List.replicate k (t, true) → p.1 = t :=
    fun k p hp => by simpa using congrArg Prod.fst (List.eq_of_mem_replicate hp)
  rcases le_or_gt 0 n with h | h
  · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le h
    rw [zpow_natCast, FreeGroup.toWord_of_pow]
    exact (nt_eq_zero_iff t _).mpr (hrep k)
  · obtain ⟨k, rfl⟩ := Int.eq_negSucc_of_lt_zero h
    rw [zpow_negSucc, FreeGroup.toWord_inv, FreeGroup.toWord_of_pow, nt_invRev]
    exact (nt_eq_zero_iff t _).mpr (hrep (k + 1))

end Work.OROneRel
