import Mathlib
import Submission.Work.OROneRel.Basic

/-!
# The Magnus subgroup generated by generators not occurring in the relator

For a relator `r : FreeGroup α` and a set `T ⊆ α` of generators *none of which occurs in* `r`, the
subgroup `magnusSubgroupOf r T` of `⟨α | r⟩` generated by the images of `T` is free on `T`:

`magnusSubgroupOf r T ≃* FreeGroup T`.

The proof does not need the Freiheitssatz.  Since `r` is a word in the generators outside `T`, the
homomorphism

`ρ : F(α) →* F(T),  of a ↦ (if a ∈ T then of a else 1)`

kills `r`, hence descends to `PresentedGroup {r}`; the composite

`F(T) --presentedGroupMap--> ⟨α | r⟩ --ρ--> F(T)`

is the identity, so `presentedGroupMap r T` is injective.  Its range is exactly
`magnusSubgroupOf r T`, which yields the required isomorphism.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- The function on generators underlying the projection `F(α) →* F(T)`: a generator `a` is sent to
`of a` when `a ∈ T` and to `1` otherwise. -/
noncomputable def freeGroupRestrictFun (T : Set α) (a : α) : FreeGroup T := by
  classical
  exact if ha : a ∈ T then FreeGroup.of ⟨a, ha⟩ else 1

theorem freeGroupRestrictFun_of_mem {T : Set α} {a : α} (ha : a ∈ T) :
    freeGroupRestrictFun T a = FreeGroup.of ⟨a, ha⟩ := by
  classical
  rw [freeGroupRestrictFun]
  exact dif_pos ha

theorem freeGroupRestrictFun_of_not_mem {T : Set α} {a : α} (ha : a ∉ T) :
    freeGroupRestrictFun T a = 1 := by
  classical
  rw [freeGroupRestrictFun]
  exact dif_neg ha

/-- `F(α) →* F(T)` kills every relator `r` all of whose letters avoid `T`. -/
theorem lift_freeGroupRestrictFun_eq_one {T : Set α} (r : FreeGroup α)
    (h : ∀ a ∈ relatorLetters r, a ∉ T) :
    FreeGroup.lift (freeGroupRestrictFun T) r = 1 := by
  classical
  have hr : r = FreeGroup.mk (FreeGroup.toWord r) := (FreeGroup.mk_toWord (x := r)).symm
  rw [hr, FreeGroup.lift_mk]
  apply List.prod_eq_one
  intro y hy
  rw [List.mem_map] at hy
  obtain ⟨x, hx, rfl⟩ := hy
  have hxT : x.1 ∉ T := h x.1 ⟨x.2, hx⟩
  rw [freeGroupRestrictFun_of_not_mem hxT]
  cases x.2 <;> simp

/-- `presentedGroupMap r T` sends the generator `a : T` to the corresponding generator of
`⟨α | r⟩`. -/
theorem presentedGroupMap_of_apply {T : Set α} {r : FreeGroup α} (a : T) :
    presentedGroupMap r T (FreeGroup.of a) = PresentedGroup.of ((a : α)) := by
  simp [presentedGroupMap, PresentedGroup.of]

/-- The range of `presentedGroupMap r T` is the Magnus subgroup generated by `T`. -/
theorem range_presentedGroupMap (r : FreeGroup α) (T : Set α) :
    (presentedGroupMap r T).range = magnusSubgroupOf r T := by
  unfold presentedGroupMap magnusSubgroupOf
  rw [MonoidHom.range_comp, FreeGroup.range_lift_eq_closure, MonoidHom.map_closure,
      ← Set.range_comp]
  apply congrArg Subgroup.closure
  apply congrArg Set.range
  funext a
  rfl

/-- The canonical map `F(T) →* ⟨α | r⟩` is injective whenever `r` avoids the generators in `T`. -/
theorem presentedGroupMap_injective {T : Set α} (r : FreeGroup α)
    (h : ∀ a ∈ relatorLetters r, a ∉ T) :
    Function.Injective (presentedGroupMap r T) := by
  classical
  set ρ : PresentedGroup ({r} : Set (FreeGroup α)) →* FreeGroup T :=
    PresentedGroup.toGroup (f := freeGroupRestrictFun T) (rels := {r}) (fun rel hrel => by
      rw [Set.mem_singleton_iff] at hrel
      rw [hrel]
      exact lift_freeGroupRestrictFun_eq_one r h)
  have hcomp : ρ.comp (presentedGroupMap r T) = MonoidHom.id (FreeGroup T) := by
    apply FreeGroup.ext_hom
    intro a
    rw [MonoidHom.comp_apply, presentedGroupMap_of_apply, PresentedGroup.toGroup.of]
    rw [freeGroupRestrictFun_of_mem a.property]
    exact congrArg FreeGroup.of (Subtype.ext rfl)
  intro x y hxy
  have hx : ρ (presentedGroupMap r T x) = x := by
    rw [← MonoidHom.comp_apply, hcomp, MonoidHom.id_apply]
  have hy : ρ (presentedGroupMap r T y) = y := by
    rw [← MonoidHom.comp_apply, hcomp, MonoidHom.id_apply]
  rw [← hx, ← hy, hxy]

/-- **The Magnus subgroup generated by the generators not occurring in the relator is free.**
If `r` involves none of the generators in `T`, then the subgroup of `⟨α | r⟩` generated by the
images of `T` is free on `T`. -/
theorem magnusSubgroupOf_equiv_freeGroup {α : Type u} (r : FreeGroup α) (T : Set α)
    (h : ∀ a ∈ Work.OROneRel.relatorLetters r, a ∉ T) :
    Nonempty (Work.OROneRel.magnusSubgroupOf r T ≃* FreeGroup T) := by
  have hinj := presentedGroupMap_injective r h
  have hrange := range_presentedGroupMap r T
  exact ⟨(MulEquiv.subgroupCongr hrange).symm.trans (MonoidHom.ofInjective hinj).symm⟩

end Work.OROneRel
