/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2) of the
formalisation of Jaikin-Zapirain--Linton, "On the coherence of one-relator groups
and their group algebras".

Vocabulary: relator length/letters, cyclically reduced relators, proper powers,
terminal relators (powers of a single generator), Magnus subgroups, the canonical
map `F(T) →* ⟨α | r⟩`, and the Magnus--Moldavanskii hierarchy.
-/
import Mathlib.GroupTheory.FreeGroup.CyclicallyReduced
import Mathlib.GroupTheory.PresentedGroup
import Mathlib.GroupTheory.HNNExtension
import Mathlib.GroupTheory.Coprod.Basic
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# One-relator combinatorics: vocabulary

This file fixes the basic vocabulary used throughout the `OROneRel` subproject.

For a relator `r : FreeGroup α` (a word in the generators `α`) we define

* `relatorNorm r` -- the length of `r` as a reduced word;
* `relatorLetters r` -- the set of generators occurring in `r`;
* `SupportedOn r Z` -- `r` only involves generators from `Z`;
* `IsCyclicallyReducedRelator r` -- the reduced word of `r` is cyclically reduced;
* `IsSubwordOf v r` -- the reduced word of `v` is a contiguous block of the reduced word of `r`;
* `IsProperPower r` -- `r` is a proper power `u ^ k`, `k ≥ 2`;
* `IsTerminalRelator r` -- `r = 1` or `r = of x ^ l` with `l ≥ 1`; then `⟨α | r⟩` is
  `F(α \ {x}) ∗ ℤ/l`, the end point of a Magnus--Moldavanskii hierarchy;
* `presentedGroupMap r T` -- the canonical map `F(T) →* PresentedGroup {r}`;
* `magnusSubgroupOf r T` -- the subgroup of `PresentedGroup {r}` generated by `T ⊆ α`;
* `IsMagnusSubgroup r A` -- `A` is generated by a set `T` of generators with `r ∉ ⟨T⟩`;
* `HasMMHierarchy α r` -- `⟨α | r⟩` admits a Magnus--Moldavanskii hierarchy.

Everything is phrased for an *arbitrary* generating type `α`; the auxiliary
notions are made noncomputable via `Classical.decEq` so that no `DecidableEq`
hypothesis leaks into any statement.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- The length of the reduced word representing `r`. -/
noncomputable def relatorNorm (r : FreeGroup α) : ℕ := by
  classical exact FreeGroup.norm r

/-- The set of generators occurring in the reduced word representing `r`. -/
noncomputable def relatorLetters (r : FreeGroup α) : Set α := by
  classical exact {a | ∃ b : Bool, (a, b) ∈ FreeGroup.toWord r}

/-- `r` involves only the generators from `Z`. -/
def SupportedOn (r : FreeGroup α) (Z : Set α) : Prop := relatorLetters r ⊆ Z

/-- The reduced word of `r` is cyclically reduced. -/
noncomputable def IsCyclicallyReducedRelator (r : FreeGroup α) : Prop := by
  classical exact FreeGroup.IsCyclicallyReduced (FreeGroup.toWord r)

/-- `v` is a subword of `r`: the reduced word of `v` occurs as a contiguous block of the reduced
word of `r`.  This is the notion of subword used in Weinbaum's theorem. -/
noncomputable def IsSubwordOf (v r : FreeGroup α) : Prop := by
  classical exact ∃ L₁ L₂ : List (α × Bool), FreeGroup.toWord r = L₁ ++ FreeGroup.toWord v ++ L₂

/-- `r` is a proper power, i.e. `r = u ^ k` for some `u` and some `k ≥ 2`.

Note the convention: the root `u` is *not* required to be nontrivial, so `1 = 1 ^ 2` **is** a proper
power.  Consequently `¬ IsProperPower r` implies `r ≠ 1` (see `ne_one_of_not_isProperPower`), which
is exactly what is needed for the statements "`r = u ^ l`, `l ≥ 1`, `u` not a proper power" to pin
down the root `u` of `r` (see `exists_root`, `root_unique`). -/
def IsProperPower (r : FreeGroup α) : Prop := ∃ u : FreeGroup α, ∃ k : ℕ, 2 ≤ k ∧ r = u ^ k

/-- The trivial element is a proper power (`1 = 1 ^ 2`). -/
theorem isProperPower_one : IsProperPower (1 : FreeGroup α) :=
  ⟨1, 2, le_refl 2, by simp⟩

/-- A *terminal* relator: `r = 1` (so `⟨α | r⟩` is free) or `r = of x ^ m` with `m ≠ 0`, in which
case `⟨α | r⟩ ≃ F(α \ {x}) ∗ ℤ/m`.  These are the groups a Magnus--Moldavanskii hierarchy ends at. -/
def IsTerminalRelator (r : FreeGroup α) : Prop :=
  r = 1 ∨ ∃ (x : α) (m : ℤ), m ≠ 0 ∧ r = FreeGroup.of x ^ m

theorem isTerminalRelator_of_pow {x : α} {l : ℕ} (hl : 1 ≤ l) : IsTerminalRelator (FreeGroup.of x ^ l) :=
  Or.inr ⟨x, (l : ℤ), by omega, by rw [zpow_natCast]⟩

/-- The canonical map `F(T) →* ⟨α | r⟩` induced by the inclusion `T ⊆ α`. -/
def presentedGroupMap (r : FreeGroup α) (T : Set α) :
    FreeGroup T →* PresentedGroup ({r} : Set (FreeGroup α)) :=
  (PresentedGroup.mk {r}).comp (FreeGroup.lift fun a : T => FreeGroup.of (a : α))

/-- The subgroup of `⟨α | r⟩` generated by the subset `T` of the generators. -/
def magnusSubgroupOf (r : FreeGroup α) (T : Set α) : Subgroup (PresentedGroup ({r} : Set (FreeGroup α))) :=
  Subgroup.closure (Set.range fun a : T => PresentedGroup.of (a : α))

/-- A Magnus subgroup of `⟨α | r⟩`: the subgroup generated by a set `T` of generators such that
`r ∉ ⟨T⟩` (so that, by the Freiheitssatz, it is free on `T`). -/
def IsMagnusSubgroup {r : FreeGroup α}
    (A : Subgroup (PresentedGroup ({r} : Set (FreeGroup α)))) : Prop :=
  ∃ T : Set α, r ∉ Subgroup.closure (FreeGroup.of '' T) ∧ A = magnusSubgroupOf r T

/-- The *canonical Magnus subgroup* of `⟨α | r⟩`: the subgroup generated by all generators but `x`.
For any relator `r` not involving `x` this is free of rank `|α \ {x}|`. -/
def magnusSubgroup (r : FreeGroup α) (x : α) : Subgroup (PresentedGroup ({r} : Set (FreeGroup α))) :=
  magnusSubgroupOf r {a | a ≠ x}

/-- `HasMMHierarchy α r` says that the one-relator group `⟨α | r⟩` admits a
Magnus--Moldavanskii hierarchy: either `r` is terminal (`⟨α | r⟩` is a free product of a free group
and a finite cyclic group), or `⟨α | r⟩` is an HNN extension of a one-relator group `⟨β | r'⟩` with a
strictly shorter relator over free Magnus subgroups, and `⟨β | r'⟩` itself admits such a hierarchy.

The generating type is allowed to change at each step (from `α` to `β`).  This is what makes the
statement follow from the classical hierarchy, whose levels are one-relator groups on subgroups of
the free group: each level uses only the generators of a finitely generated free factor of the
previous one, and the remaining generators split off as free factors by
`presentedGroup_iso_coprod_of_supported`.  Note also that `IsMagnusSubgroup` requires the relator of
the level to be nontrivial, so `⊥` is available as an associated subgroup exactly at the levels whose
relator is `of x ^ m ≠ 1`. -/
inductive HasMMHierarchy : (α : Type u) → FreeGroup α → Prop
  | base {α : Type u} (r : FreeGroup α) (h : IsTerminalRelator r) : HasMMHierarchy α r
  | step {α : Type u} (r : FreeGroup α) {β : Type u} (r' : FreeGroup β)
      (hlt : relatorNorm r' < relatorNorm r)
      (h : HasMMHierarchy β r')
      (A B : Subgroup (PresentedGroup ({r'} : Set (FreeGroup β))))
      (hA : IsMagnusSubgroup A) (hB : IsMagnusSubgroup B) (φ : A ≃* B)
      (e : PresentedGroup ({r} : Set (FreeGroup α)) ≃*
        HNNExtension (PresentedGroup ({r'} : Set (FreeGroup β))) A B φ) :
      HasMMHierarchy α r
  /-- An **embedding step**: `⟨α | r⟩` embeds into a one-relator group `⟨β | s⟩` which itself admits
  a hierarchy.  This is the form in which the classical Magnus--Moldavanskii *diagram* (with
  horizontal monomorphisms, as in Linton, *One-relator hierarchies*, §1.2) is available from
  Magnus's embedding trick in the case where no letter of `r` has exponent sum zero; every property
  the hierarchy is used for (coherence, virtual torsion-freeness) is subgroup-closed, so it transfers
  back along `ι`.  See `Work.OROneRel.hasMMHierarchy_of_subst` and
  `Work.OROneRel.HasMMHierarchy.closed`. -/
  | embed {α : Type u} (r : FreeGroup α) {β : Type u} (s : FreeGroup β)
      (h : HasMMHierarchy β s)
      (ι : PresentedGroup ({r} : Set (FreeGroup α)) →*
        PresentedGroup ({s} : Set (FreeGroup β)))
      (hι : Function.Injective ι) :
      HasMMHierarchy α r

end Work.OROneRel
