/-
Copyright: subproject `OROneRel` -- one-relator combinatorics.

# The kernel of the gauge map is the normal closure of the tree

Let `c : α → ℤ` be a weight, `W : ℤ → FreeGroup α` a gauge (`cohom c (W i) = ofAdd i`) whose every
gauge word `W j` is written in edges of *trivial* loop class, and let

  `gaugeMap W c : F (α × ℤ) →* F α,   (x,i) ↦ W i * x * (W (i + c x))⁻¹`

be the loop-class map of the `ℤ`-cover.  With `T = {e : α × ℤ | coverClassAt W c e = 1}` the tree of
the cover, the theorem `Work.OROneRel.covCollapse_eq_covDevFun_gaugeMap` of
`Submission/Work/OROneRel/covCollapseDefs.lean` computes the *collapse* `covCollapse W c` (the
retraction of `F (α × ℤ)` killing the tree and keeping the other edges) as the development of the
gauge image:

  `covCollapse W c y = covDevFun W c 0 (gaugeMap W c y)`.

Consequently `y ∈ ker (gaugeMap W c)` implies `covCollapse W c y = 1`, and since `covCollapse`
agrees with the collapse `covTau` of `F (α × ℤ)` inside itself (`covIota_covCollapse`), the lemma
`Work.OROneRel.mul_tau_inv_mem` gives `y ∈ ⟪T⟫ = normalClosure (of '' T)`.  This is the statement
`ker_gaugeMap_le_winTree`: the kernel of the loop-class map of the `ℤ`-cover is generated by the
edges of trivial loop class, i.e. `F (α × ℤ)` modulo the tree is free on the remaining edges with
the loop classes as a free basis -- the standard "the fundamental group of a graph is free on the
edges outside a spanning tree" fact, in the form used by
`Submission/Work/OROneRel/NOTES_twoLetter_freiheitssatz_chain.md` (§ "The link", equation (**)).

The proof of the identity is the combinatorial core: a generator `(x,i)` is sent by the gauge to
`W i * x * (W (i + c x))⁻¹`, and reading that word by the development cancels the two gauge words
(their developments are trivial by hypothesis, `covDevAux_eq_one_of_all_trivial`) and contributes
exactly the symbol of the edge `(x,i)`; multiplicativity with the level tracked is
`Work.OROneRel.covDevFun_mul`.
-/
import Mathlib
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.OROneRel.GaugeDefs
import Submission.Work.OROneRel.wordOfDefs
import Submission.Work.OROneRel.MagnusGenDefs
import Submission.Work.OROneRel.twoLetterTlDefs
import Submission.Work.OROneRel.covCollapseDefs
import Submission.Work.OROneRel.covDevFun_mul
import Submission.Work.OROneRel.covDevAux_invRev
import Submission.Work.OROneRel.covDevAux_eq_one_of_all_trivial
import Submission.Work.OROneRel.mul_tau_inv_mem

namespace Work.OROneRel

universe u

variable {α : Type u}

/-! ## The gauge image has weight zero -/

/-- **The loop classes have weight zero.**  If the gauge has the right weights, then every element of
the image of the gauge map has weight zero (it is a closed loop of the cover). -/
theorem cohom_gaugeMap_of_cohom_one {W : ℤ → FreeGroup α} {c : α → ℤ}
    (hcoh : ∀ i : ℤ, cohom c (W i) = Multiplicative.ofAdd i) (y : FreeGroup (α × ℤ)) :
    cohom c (gaugeMap W c y) = 1 := by
  induction y using FreeGroup.induction_on with
  | one => simp
  | of e =>
    obtain ⟨a, i⟩ := e
    rw [gaugeMap_of, map_mul, map_mul, map_inv, hcoh i, hcoh (i + c a), cohom_of]
    show Multiplicative.ofAdd i * Multiplicative.ofAdd (c a) *
      (Multiplicative.ofAdd (i + c a))⁻¹ = 1
    simp
  | inv_of e ih => rw [map_inv, map_inv, ih, inv_one]
  | mul x y hx hy => rw [map_mul, map_mul, hx, hy, mul_one]

/-- **The weight of a gauge word.**  The gauge word at a level has that level as its weight. -/
theorem lsig_wordOf_Wt {W : ℤ → FreeGroup α} {c : α → ℤ}
    (hcoh : ∀ i : ℤ, cohom c (W i) = Multiplicative.ofAdd i) (i : ℤ) :
    lsig c (wordOf (W i)) = i := by
  rw [lsig_wordOf, hcoh i]
  rfl

/-! ## Elementary specialisations of the development -/

/-- The development of a single letter is the symbol of its edge. -/
theorem covDevFun_of (W : ℤ → FreeGroup α) (c : α → ℤ) (i : ℤ) (a : α) :
    covDevFun W c i (FreeGroup.of a) = covDevSym W c (a, i) true := by
  rw [← covDevAux_wordOf,
    show wordOf (FreeGroup.of a) = [(a, true)] by simp [wordOf], covDevAux_singleton_true]

/-- The development of the identity is trivial. -/
theorem covDevFun_one (W : ℤ → FreeGroup α) (c : α → ℤ) (k : ℤ) :
    covDevFun W c k (1 : FreeGroup α) = 1 := by
  rw [← covDevAux_wordOf]
  rw [covDevAux_eq_of_mk_eq W c k (L₁ := wordOf (1 : FreeGroup α)) (L₂ := [])
    (by rw [mk_wordOf, mk_nil]), covDevAux_nil]

/-- **The gauge words have trivial development.**  This is the hypothesis `hwalk` on the gauge: every
edge traversed by a gauge word has trivial loop class, so every symbol contributed by the development
of a gauge word is `1`. -/
theorem covDevFun_zero_Wt {W : ℤ → FreeGroup α} {c : α → ℤ}
    (hwalk : ∀ j : ℤ, ∀ e ∈ decor c 0 (wordOf (W j)), coverClassAt W c (coverEdge e) = 1)
    (j : ℤ) : covDevFun W c 0 (W j) = 1 := by
  rw [← covDevAux_wordOf]
  exact covDevAux_eq_one_of_all_trivial W c (wordOf (W j)) 0 (hwalk j)

/-- **The inverse of a gauge word also has trivial development**, read from the level reached by the
gauge word. -/
theorem covDevFun_inv_Wt {W : ℤ → FreeGroup α} {c : α → ℤ}
    (hlev : ∀ j : ℤ, lsig c (wordOf (W j)) = j)
    (hdev : ∀ j : ℤ, covDevFun W c 0 (W j) = 1) (j : ℤ) :
    covDevFun W c (0 + j) ((W j)⁻¹) = 1 := by
  rw [show (0 : ℤ) + j = 0 + lsig c (wordOf (W j)) from by rw [hlev j]]
  rw [← covDevAux_wordOf, wordOf_inv, covDevAux_invRev, covDevAux_wordOf, hdev j, inv_one]

/-! ## The development of the loop class of an edge -/

/-- **The development of the loop class of an edge is the symbol of that edge.**  This is the
computation in which the gauge hypotheses are consumed: the loop class
`coverClassAt W c (a,i) = W i * a * (W (i + c a))⁻¹` is read by the development as
`1 * (symbol of (a,i)) * 1`. -/
theorem covDevFun_zero_coverClassAt {W : ℤ → FreeGroup α} {c : α → ℤ}
    (hcoh : ∀ i : ℤ, cohom c (W i) = Multiplicative.ofAdd i)
    (hwalk : ∀ j : ℤ, ∀ e ∈ decor c 0 (wordOf (W j)), coverClassAt W c (coverEdge e) = 1)
    (e : α × ℤ) :
    covDevFun W c 0 (coverClassAt W c e) = covDevSym W c e true := by
  obtain ⟨a, i⟩ := e
  have hlev : ∀ j : ℤ, lsig c (wordOf (W j)) = j := lsig_wordOf_Wt hcoh
  have hdev : ∀ j : ℤ, covDevFun W c 0 (W j) = 1 := covDevFun_zero_Wt hwalk
  have hi : (cohom c (W i)).toAdd = i := by rw [hcoh i]; rfl
  have hia : (cohom c (W i * FreeGroup.of a)).toAdd = i + c a := by
    rw [map_mul, hcoh i, cohom_of]; rfl
  change covDevFun W c 0 (gaugeMap W c (FreeGroup.of (a, i))) = covDevSym W c (a, i) true
  rw [gaugeMap_of, covDevFun_mul, covDevFun_mul, hi, hia, zero_add, hdev i, one_mul,
    covDevFun_of, covDevFun_inv_Wt hlev hdev (i + c a), mul_one]

/-! ## The collapse is the development of the gauge image -/

/-- **The collapse of the cover is the development of the gauge image.**  The map
`covCollapse W c`, which kills the edges of trivial loop class and keeps the others, is the
composite of the gauge map with the development at level `0`.  Both sides are homomorphisms of
`F (α × ℤ)` (the development of the gauge image is multiplicative because gauge images have weight
zero, `cohom_gaugeMap_of_cohom_one`), and they agree on the generators by
`covDevFun_zero_coverClassAt`. -/
theorem covCollapse_eq_covDevFun_gaugeMap {W : ℤ → FreeGroup α} {c : α → ℤ}
    (hcoh : ∀ i : ℤ, cohom c (W i) = Multiplicative.ofAdd i)
    (hwalk : ∀ j : ℤ, ∀ e ∈ decor c 0 (wordOf (W j)), coverClassAt W c (coverEdge e) = 1)
    (y : FreeGroup (α × ℤ)) :
    covCollapse W c y = covDevFun W c 0 (gaugeMap W c y) := by
  have hmul : ∀ y z : FreeGroup (α × ℤ),
      covDevFun W c 0 (gaugeMap W c (y * z)) =
        covDevFun W c 0 (gaugeMap W c y) * covDevFun W c 0 (gaugeMap W c z) := by
    intro y z
    rw [map_mul, covDevFun_mul, cohom_gaugeMap_of_cohom_one hcoh y]
    simp
  have hhom : covCollapse W c =
      MonoidHom.mk' (fun y : FreeGroup (α × ℤ) => covDevFun W c 0 (gaugeMap W c y)) hmul := by
    apply FreeGroup.ext_hom
    intro e
    rw [covCollapse_of, MonoidHom.mk'_apply]
    exact (covDevFun_zero_coverClassAt hcoh hwalk e).symm
  rw [hhom]
  rfl

/-! ## The kernel of the gauge map -/

theorem ker_gaugeMap_le_winTree {p q : ℕ} {Wt : ℤ → FreeGroup (Fin 2)}
    (hW0 : Wt 0 = 1)
    (hcoh : ∀ i : ℤ, Work.OROneRel.cohom (Work.OROneRel.tlW p q) (Wt i) = Multiplicative.ofAdd i)
    (hwalk : ∀ j : ℤ, ∀ e ∈ Work.OROneRel.decor (Work.OROneRel.tlW p q) 0 (Work.OROneRel.wordOf (Wt j)),
      Work.OROneRel.coverClassAt Wt (Work.OROneRel.tlW p q) (Work.OROneRel.coverEdge e) = 1)
    {y : FreeGroup (Fin 2 × ℤ)}
    (hy : Work.OROneRel.gaugeMap Wt (Work.OROneRel.tlW p q) y = 1) :
    y ∈ Subgroup.normalClosure
      (FreeGroup.of '' {e : Fin 2 × ℤ | Work.OROneRel.coverClassAt Wt (Work.OROneRel.tlW p q) e = 1}) := by
  classical
  -- the collapse of `y` is the development of its gauge image, which vanishes
  have hkey := covCollapse_eq_covDevFun_gaugeMap (W := Wt) (c := tlW p q) hcoh hwalk y
  rw [hy, covDevFun_one] at hkey
  -- hence the collapse of `y` inside `F (Fin 2 × ℤ)` vanishes
  have htau : covTau Wt (tlW p q) y = 1 := by
    rw [← covIota_covCollapse Wt (tlW p q) y, hkey, map_one]
  -- the collapse kills exactly the tree generators, so a vanishing collapse is normal closure
  have hshape : ∀ b : Fin 2 × ℤ, covTau Wt (tlW p q) (FreeGroup.of b) = 1 ∨
      covTau Wt (tlW p q) (FreeGroup.of b) = FreeGroup.of b := by
    intro b
    by_cases hb : coverClassAt Wt (tlW p q) b = 1
    · exact Or.inl (covTau_of_eq Wt (tlW p q) b hb)
    · exact Or.inr (covTau_of_ne Wt (tlW p q) b hb)
  have hmem := mul_tau_inv_mem (covTau Wt (tlW p q)) hshape y
  rw [htau, inv_one, mul_one] at hmem
  have hset : {b : Fin 2 × ℤ | covTau Wt (tlW p q) (FreeGroup.of b) = 1}
      = {e : Fin 2 × ℤ | coverClassAt Wt (tlW p q) e = 1} := by
    ext b
    constructor
    · intro hb
      simp only [Set.mem_ofPred_eq] at hb
      by_contra hne
      rw [covTau_of_ne Wt (tlW p q) b hne] at hb
      exact FreeGroup.of_ne_one b hb
    · intro hb
      exact covTau_of_eq Wt (tlW p q) b hb
  rwa [hset] at hmem

end Work.OROneRel
