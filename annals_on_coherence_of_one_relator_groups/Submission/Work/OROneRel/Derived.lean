/-!
# Consequences of the four classical inputs

This file derives from `OneRelatorCombinatorics` (the node `N2` interface) the statements that the
rest of the project consumes, and records the terminal (base) case of a Magnus--Moldavanskii
hierarchy in the form actually used.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-! ### The Freiheitssatz -/

/-- The Freiheitssatz in the form of the route design: `r` is cyclically reduced and mentions `x`,
and `Y` is a set of generators avoiding `x`; then `F(Y) →* ⟨α | r⟩` is injective. -/
theorem freiheitssatz_mentions (C : OneRelatorCombinatorics.{u}) {r : FreeGroup α}
    (hr : IsCyclicallyReducedRelator r) {x : α} (hx : x ∈ relatorLetters r) {Y : Set α}
    (hY : ∀ y ∈ Y, y ≠ x) : Function.Injective (presentedGroupMap r Y) := by
  refine C.freiheitssatz r hr Y fun hmem => ?_
  exact (hY x ((letters_closure_iff r Y).mp hmem hx)) rfl

/-- The Freiheitssatz in the Magnus-subgroup form: if the relator is not generated by the generators
other than `x`, then the subgroup of `⟨α | r⟩` generated by those other generators is free. -/
theorem freiheitssatz_magnusSubgroup (C : OneRelatorCombinatorics.{u}) {r : FreeGroup α}
    (hr : IsCyclicallyReducedRelator r) (x : α)
    (hx : r ∉ Subgroup.closure (FreeGroup.of '' {a | a ≠ x})) :
    Function.Injective (presentedGroupMap r {a | a ≠ x}) :=
  C.freiheitssatz r hr _ hx

/-- **Magnus subgroups are free.**  From the Freiheitssatz: if `r ∉ ⟨T⟩` then the subgroup of
`⟨α | r⟩` generated by `T` is free on `T`. -/
theorem magnusSubgroupOf_equiv_freeGroup_of_freiheitssatz (C : OneRelatorCombinatorics.{u})
    {r : FreeGroup α} (hr : IsCyclicallyReducedRelator r) {T : Set α}
    (hT : r ∉ Subgroup.closure (FreeGroup.of '' T)) :
    Nonempty (magnusSubgroupOf r T ≃* FreeGroup T) := by
  have hinj : Function.Injective (presentedGroupMap r T) := C.freiheitssatz r hr T hT
  exact ⟨((MonoidHom.ofInjective hinj).trans (MulEquiv.subgroupCongr (range_presentedGroupMap r T))).symm⟩

/-- **Magnus subgroups are free.** -/
theorem isMagnusSubgroup_isFreeGroup (C : OneRelatorCombinatorics.{u}) {r : FreeGroup α}
    (hr : IsCyclicallyReducedRelator r)
    {A : Subgroup (PresentedGroup ({r} : Set (FreeGroup α)))} (hA : IsMagnusSubgroup A) :
    IsFreeGroup A := by
  obtain ⟨T, hT, rfl⟩ := hA
  obtain ⟨e⟩ := magnusSubgroupOf_equiv_freeGroup_of_freiheitssatz C hr hT
  exact IsFreeGroup.ofMulEquiv e.symm

/-- A subword of `r` of the same length is `r` itself. -/
theorem eq_of_isSubwordOf_of_relatorNorm_eq {v r : FreeGroup α} (h : IsSubwordOf v r)
    (hlen : relatorNorm v = relatorNorm r) : v = r := by
  classical
  obtain ⟨L₁, L₂, hL⟩ := h
  have hlen' : L₁.length + L₂.length = 0 := by
    have hh := hlen
    simp only [relatorNorm, FreeGroup.norm, hL, List.length_append] at hh
    omega
  have hL₁ : L₁ = [] := List.length_eq_zero_iff.mp (by omega)
  have hL₂ : L₂ = [] := List.length_eq_zero_iff.mp (by omega)
  have hw : FreeGroup.toWord v = FreeGroup.toWord r := by rw [hL, hL₁, hL₂]; simp
  exact FreeGroup.toWord_inj.mp hw

/-- **Weinbaum's theorem** in the form used in the paper: every proper (i.e. `≠ r`) nontrivial
subword of a cyclically reduced relator which is not a proper power is nontrivial in `⟨α | r⟩`. -/
theorem weinbaum_subword (C : OneRelatorCombinatorics.{u}) {r : FreeGroup α}
    (hr : IsCyclicallyReducedRelator r) (hp : ¬ IsProperPower r) {v : FreeGroup α}
    (h : IsSubwordOf v r) (hv : v ≠ r) (hv1 : v ≠ 1) :
    PresentedGroup.mk ({r} : Set (FreeGroup α)) v ≠ 1 := by
  refine C.weinbaum r hr hp 1 v (by rwa [pow_one]) ?_ hv1
  rcases lt_or_eq_of_le (relatorNorm_le_of_isSubwordOf h) with hlt | heq
  · exact hlt
  · exact absurd (eq_of_isSubwordOf_of_relatorNorm_eq h heq) hv

/-! ### The Magnus--Moldavanskii hierarchy -/

/-- A terminal relator gives a (trivial) Magnus--Moldavanskii hierarchy. -/
theorem hasMMHierarchy_of_terminal (r : FreeGroup α) (h : IsTerminalRelator r) :
    HasMMHierarchy α r :=
  HasMMHierarchy.base r h

/-- The one-relator group of a terminal relator is hierarchically built: it is a free product of a
free group and a finite cyclic group. -/
theorem hasHierarchy_of_terminal (r : FreeGroup α) (h : IsTerminalRelator r) :
    HasHierarchy (PresentedGroup ({r} : Set (FreeGroup α))) :=
  ⟨α, r, hasMMHierarchy_of_terminal r h, ⟨MulEquiv.refl _⟩⟩

/-- The Magnus--Moldavanskii hierarchy holds at terminal relators: this is an unconditional instance
of the node's hierarchy predicate. -/
theorem magnusMoldavanskiiAt_of_terminal {r : FreeGroup α} (h : IsTerminalRelator r) :
    MagnusMoldavanskiiAt r :=
  fun _ _ => hasMMHierarchy_of_terminal r h

/-- Free groups have a Magnus--Moldavanskii hierarchy (they are the terminal case `r = 1`). -/
theorem hasHierarchy_freeGroup (α : Type u) : HasHierarchy (FreeGroup α) := by
  obtain ⟨e⟩ := presentedGroup_one_iso_freeGroup (α := α)
  exact ⟨α, 1, hasMMHierarchy_of_terminal 1 isTerminalRelator_one, ⟨e⟩⟩

/-- Every one-relator group admits a Magnus--Moldavanskii hierarchy.

Proof: choose a presentation with a single relator and replace the relator by a cyclically reduced
conjugate (this does not change the group), then apply the hierarchy theorem. -/
theorem hasHierarchy_of_oneRelator (C : OneRelatorCombinatorics.{u}) {G : Type u} [Group G]
    (hG : Group.OneRelator G) : HasHierarchy G := by
  obtain ⟨α, r, ⟨e⟩⟩ := hG
  by_cases hr : r = 1
  · subst hr
    exact ⟨α, 1, hasMMHierarchy_of_terminal 1 isTerminalRelator_one, ⟨e⟩⟩
  · obtain ⟨s, hs, hsne, ⟨e'⟩⟩ := exists_cyclicallyReduced_conjugate r hr
    exact ⟨α, s, C.magnus_moldavanskii s hs hsne, ⟨e'.symm.trans e⟩⟩

/-! ### Torsion -/

/-- **The root of a nontrivial element of a free group is unique.**  Every `r ≠ 1` is `u ^ l` for a
unique pair `(u, l)` with `l ≥ 1` and `u` not a proper power -- the root of `r` and its exponent. -/
theorem existsUnique_root {r : FreeGroup α} (hr : r ≠ 1) :
    ∃! p : FreeGroup α × ℕ, 1 ≤ p.2 ∧ r = p.1 ^ p.2 ∧ ¬ IsProperPower p.1 := by
  obtain ⟨u, l, hl, hru, hu⟩ := exists_root r hr
  refine ⟨(u, l), ⟨hl, hru, hu⟩, ?_⟩
  rintro ⟨v, m⟩ ⟨hm, hrv, hv⟩
  obtain ⟨huv, hlm⟩ := root_unique hl hm hru hrv hu hv
  simp [huv, hlm]

/-- **Karrass--Magnus--Solitar for an arbitrary nontrivial relator.**  Every nontrivial `r` is a
power `u ^ l` of a root `u` which is not a proper power; the class of `u` has order exactly `l` in
`⟨α | r⟩`, and every element of finite order in `⟨α | r⟩` is conjugate to a power of `u`. -/
theorem exists_root_and_torsion (C : OneRelatorCombinatorics.{u}) (r : FreeGroup α) (hr : r ≠ 1) :
    ∃ (u : FreeGroup α) (l : ℕ), 1 ≤ l ∧ r = u ^ l ∧ ¬ IsProperPower u ∧
      orderOf (PresentedGroup.mk ({r} : Set (FreeGroup α)) u) = l ∧
      ∀ g : PresentedGroup ({r} : Set (FreeGroup α)), IsOfFinOrder g →
        ∃ k : ℕ, ∃ c : PresentedGroup ({r} : Set (FreeGroup α)),
          g = c * (PresentedGroup.mk ({r} : Set (FreeGroup α)) u) ^ k * c⁻¹ := by
  obtain ⟨u, l, hl, rfl, hu⟩ := exists_root r hr
  exact ⟨u, l, hl, rfl, hu, (C.kms_torsion (u ^ l) u l hl rfl hu).1,
    (C.kms_torsion (u ^ l) u l hl rfl hu).2⟩

/-- **A one-relator group whose relator is not a proper power is torsion-free**: every element of
finite order is trivial. -/
theorem eq_one_of_isOfFinOrder (C : OneRelatorCombinatorics.{u}) {r : FreeGroup α} (hr : r ≠ 1)
    (hu : ¬ IsProperPower r) {g : PresentedGroup ({r} : Set (FreeGroup α))} (hg : IsOfFinOrder g) :
    g = 1 := by
  obtain ⟨k, c, hgc⟩ := (C.kms_torsion r r 1 le_rfl (by rw [pow_one]) hu).2 g hg
  have hr1 : PresentedGroup.mk ({r} : Set (FreeGroup α)) r = 1 :=
    orderOf_eq_one_iff.mp (C.kms_torsion r r 1 le_rfl (by rw [pow_one]) hu).1
  rw [hgc, hr1, one_pow, mul_one]
  simp

/-- If `r = u ^ l` with `l ≥ 1` then `u` has finite order in `⟨α | r⟩`. -/
theorem isOfFinOrder_of_relator {r u : FreeGroup α} {l : ℕ} (hl : 1 ≤ l) (hr : r = u ^ l) :
    IsOfFinOrder (PresentedGroup.mk ({r} : Set (FreeGroup α)) u) :=
  isOfFinOrder_iff_pow_eq_one.mpr ⟨l, hl, pow_eq_one_of_relator r u l hr⟩

/-! ### The terminal group is `F ∗ ℤ/m` -/

/-- The group of a terminal relator `of x ^ m` is the free product of the free group on the other
generators with the cyclic group of order `|m|`. -/
theorem terminal_iso_coprod_zmod (x : α) (m : ℤ) (hm : m ≠ 0) :
    Nonempty (PresentedGroup ({FreeGroup.of x ^ m} : Set (FreeGroup α)) ≃*
      Monoid.Coprod (Multiplicative (ZMod m.natAbs)) (FreeGroup {a : α // a ≠ x})) :=
  presentedGroup_of_zpow_iso_coprod_zmod x m hm

/-- The order of the class of `x` in the one-relator group `⟨α | x ^ m⟩` is exactly `|m|`. -/
theorem orderOf_of_terminal (x : α) (m : ℤ) (hm : m ≠ 0) :
    orderOf (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) = m.natAbs :=
  orderOf_of_terminal_zpow x m hm

/-- Weinbaum's theorem at a terminal relator: no nontrivial subword of a power of `of x ^ l` of
length `< l` is trivial in `⟨α | of x ^ l⟩`. -/
theorem weinbaum_at_terminal (x : α) (l : ℕ) (hl : 1 ≤ l) (k : ℕ) (v : FreeGroup α)
    (h : IsSubwordOf v ((FreeGroup.of x ^ l) ^ k)) (hv : relatorNorm v < l) (hv1 : v ≠ 1) :
    PresentedGroup.mk ({FreeGroup.of x ^ l} : Set (FreeGroup α)) v ≠ 1 :=
  mk_ne_one_of_subword_terminal x l hl k v h hv hv1

end Work.OROneRel
