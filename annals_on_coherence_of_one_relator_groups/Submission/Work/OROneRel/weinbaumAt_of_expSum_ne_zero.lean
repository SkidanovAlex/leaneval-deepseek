/-!
# Weinbaum's theorem: the case in which every letter has nonzero exponent sum

We prove `Work.OROneRel.weinbaumAt_of_expSum_ne_zero`: if every letter occurring in the relator `r`
has nonzero exponent sum in `r` (`expSum a r ≠ 1` for every `a ∈ relatorLetters r`, since
`expSum a r : Multiplicative ℤ` and `1` is the exponent sum `0`), then Weinbaum's theorem holds
for `r`.

The argument has two parts.

* If the short trivial subword `v` misses some letter `a₀` of `r`, then `v` lies in the free group
  generated by the remaining letters while `r` does not generate that free subgroup, so the
  Freiheitssatz (`Work.OROneRel.freiheitssatz_at`, unconditional in this workspace) forces `v` to
  be nontrivial in `⟨α | r⟩`.

* Otherwise we *pad* the relator.  For two distinct letters `x ≠ t` of `r` and the fresh letter
  `z` (`none : Option α`) we put `c x = σ_t r`, `c t = -σ_x r` and `c a = 0` otherwise, and replace
  every letter `a` of a word by the block `a * z ^ (c a) * a` (`Work.OROneRel.padHom`).  Because
  every block begins and ends with its own letter, the padding never cancels, so it

  * sends a short subword of a power of `r` to a short subword of a power of the padded relator
    `R = padRel c r`, whose norm is strictly larger;
  * is injective, so a nontrivial word stays nontrivial;
  * sends the normal closure of `r` into the normal closure of `R`, so a trivial word stays
    trivial.

  The fresh letter `z` occurs in `R` and has zero exponent sum there, because
  `Σ_a σ_a r * c a = σ_x r * σ_t r - σ_t r * σ_x r = 0`.  The exponent-sum-zero case of Weinbaum's
  theorem (`Work.OROneRel.weinbaum_sigma_zero`) applied to `R` then gives the contradiction.
-/

namespace Work.OROneRel

universe u

variable {α : Type u}

/-! ### Elementary facts about the padding -/

/-- Every generator block of the padding is nontrivial. -/
theorem padGen_ne_one (c : α → ℤ) (a : α) : padGen c a ≠ 1 := by
  intro h1
  have h2 : padProj (padGen c a) = 1 := by rw [h1, map_one]
  have h3 : padProj (padGen c a) = (FreeGroup.of a) ^ (2 : ℕ) := by
    rw [show padGen c a = padHom c (FreeGroup.of a) from (padHom_of c a).symm]
    have := DFunLike.congr_fun (padProj_padHom c) (FreeGroup.of a)
    simpa using this
  rw [h3] at h2
  rcases (pow_eq_one_iff).mp h2 with h4 | h4
  · exact FreeGroup.of_ne_one a h4
  · omega

/-- Every block of the padding is nonempty. -/
theorem padBlock_ne_nil (c : α → ℤ) (p : α × Bool) : padBlock c p ≠ [] := by
  classical
  have hne : (if p.2 = true then padGen c p.1 else (padGen c p.1)⁻¹) ≠ 1 := by
    by_cases h : p.2 = true
    · rw [if_pos h]; exact padGen_ne_one c p.1
    · rw [if_neg h]; exact inv_ne_one.mpr (padGen_ne_one c p.1)
  have hmk : FreeGroup.mk (padBlock c p) =
      (if p.2 = true then padGen c p.1 else (padGen c p.1)⁻¹) := by
    unfold padBlock
    split <;> exact FreeGroup.mk_toWord
  intro h
  refine hne ?_
  rw [← hmk, h, FreeGroup.one_eq_mk]

/-- Every block of the padding is nonempty, so the padding of a nonempty word is nonempty. -/
theorem padList_ne_nil (c : α → ℤ) {L : List (α × Bool)} (hL : L ≠ []) :
    padList c L ≠ [] := by
  cases L with
  | nil => exact absurd rfl hL
  | cons p L' =>
    rw [padList, List.map_cons, List.flatten_cons]
    intro h
    exact padBlock_ne_nil c p (List.eq_nil_of_append_eq_nil h).1

/-! ### The pieces of the padding argument

The statements below are proved in the sibling modules of this directory (each a self-contained
piece of word-combinatorics or of the Freiheitssatz); here the main argument is assembled against
them. -/

/-- The word-combinatorics of the padding: the block concatenation does not cancel. -/
theorem toWord_padHom_aux [DecidableEq α] (c : α → ℤ) (u : FreeGroup α) :
    (padHom c u).toWord = padList c u.toWord :=
  toWord_padHom c u

/-- The length of a padded word, as a sum over the letters of the original word. -/
theorem relatorNorm_padHom_aux (c : α → ℤ) (u : FreeGroup α) :
    relatorNorm (padHom c u) =
      ((wordOf u).map (fun p : α × Bool => 2 + (c p.1).natAbs)).sum :=
  relatorNorm_padHom c u

/-- Occurrence counts of a short subword of a power of a cyclically reduced relator. -/
theorem occ_le_aux [DecidableEq α] (r v : FreeGroup α) (k : ℕ) (a : α)
    (hcyc : IsCyclicallyReducedRelator r) (hsub : IsSubwordOf v (r ^ k))
    (hlen : (v.toWord).length ≤ (r.toWord).length) :
    (v.toWord.countP (fun p : α × Bool => p.1 = a)) ≤
      (r.toWord.countP (fun p : α × Bool => p.1 = a)) :=
  occ_le_of_isSubwordOf_pow r v k a hcyc hsub hlen

/-- The transport of subwords along the padding. -/
theorem pad_subword_aux (c : α → ℤ) {r v : FreeGroup α} {k : ℕ}
    (hcyc : IsCyclicallyReducedRelator r) (h : IsSubwordOf v (r ^ k)) :
    IsSubwordOf (padHom c v) (padRel c r ^ k) :=
  pad_subword_of_isSubwordOf_pow c hcyc h

/-- The padded relator is cyclically reduced. -/
theorem pad_isCyclicallyReduced_aux (c : α → ℤ) {r : FreeGroup α}
    (h : IsCyclicallyReducedRelator r) : IsCyclicallyReducedRelator (padRel c r) :=
  pad_isCyclicallyReduced c h

/-- A letter that does not occur in a word has trivial exponent sum in that word. -/
theorem expSum_eq_one_of_not_mem_relatorLetters {a : α} {w : FreeGroup α}
    (h : a ∉ relatorLetters w) : expSum a w = 1 := by
  classical
  have hle : Subgroup.closure (FreeGroup.of '' {b : α | b ≠ a}) ≤ (expSum a).ker := by
    apply (Subgroup.closure_le (expSum a).ker).mpr
    rintro y ⟨b, hb, rfl⟩
    have hb' : b ≠ a := hb
    show expSum a (FreeGroup.of b) = 1
    rw [expSum, FreeGroup.lift_apply_of]
    simp [hb']
  refine hle ((letters_closure_iff w {b : α | b ≠ a}).mpr ?_)
  intro b hb hba
  exact h (hba ▸ hb)

/-- If `c x ≠ 0`, the fresh letter occurs in the padded generator `x`. -/
theorem none_mem_relatorLetters_padGen {x : α} {c : α → ℤ} (hcx : c x ≠ 0) :
    (none : Option α) ∈ relatorLetters (padGen c x) := by
  classical
  by_contra h
  have h1 : expSum (none : Option α) (padGen c x) = 1 :=
    expSum_eq_one_of_not_mem_relatorLetters h
  have h2 : expSum (none : Option α) (padGen c x) = Multiplicative.ofAdd (c x) := by
    have h3 := expSum_none_padHom_apply c (FreeGroup.of x)
    rw [FreeGroup.lift_apply_of] at h3
    rw [← padHom_of c x]
    exact h3
  rw [h2] at h1
  exact hcx (Multiplicative.ofAdd.injective (by simpa using h1))

/-- `FreeGroup.toWord` does not depend on the `DecidableEq` instance. -/
theorem toWord_decEq_congr {γ : Type*} (i j : DecidableEq γ) (x : FreeGroup γ) :
    @FreeGroup.toWord γ i x = @FreeGroup.toWord γ j x := by
  rw [show i = j from funext fun a => funext fun b => Subsingleton.elim _ _]

/-- The length comparison along the padding. -/
theorem pad_length_lt_aux (r v : FreeGroup α) (c : α → ℤ) (k : ℕ)
    (hcyc : IsCyclicallyReducedRelator r) (hsub : IsSubwordOf v (r ^ k))
    (hlen : relatorNorm v < relatorNorm r) :
    relatorNorm (padHom c v) < relatorNorm (padRel c r) :=
  pad_length_lt r v c k hcyc hsub hlen

/-- The Freiheitssatz in the form used for a short subword missing a letter of the relator. -/
theorem mk_ne_one_of_misses_letter_aux {r v : FreeGroup α} {a₀ : α}
    (hr : IsCyclicallyReducedRelator r) (ha₀ : a₀ ∈ relatorLetters r)
    (hv : a₀ ∉ relatorLetters v) (hv1 : v ≠ 1) :
    PresentedGroup.mk ({r} : Set (FreeGroup α)) v ≠ 1 :=
  mk_ne_one_of_misses_letter hr ha₀ hv hv1

/-- The padding letter has zero exponent sum in the padded relator. -/
theorem expSum_none_padRel_aux (r : FreeGroup α) {x t : α} (hxt : x ≠ t) :
    expSum (none : Option α) (padRel (padC r x t) r) = 1 :=
  expSum_none_padRel_padC r hxt

/-- The fresh padding letter occurs in the padded relator. -/
theorem none_mem_padRel_aux {r : FreeGroup α} {x t : α} (hx : x ∈ relatorLetters r)
    (hcx : padC r x t x ≠ 0) :
    (none : Option α) ∈ relatorLetters (padRel (padC r x t) r) := by
  classical
  -- an occurrence of the letter `x` in `r`
  obtain ⟨b, hb⟩ : ∃ b : Bool, (x, b) ∈ FreeGroup.toWord r := by
    simpa only [relatorLetters, Set.mem_ofPred_eq] using hx
  -- the block of that occurrence contains the fresh letter
  obtain ⟨s, hs⟩ := mem_none_padBlock (padC r x t) (x, b) hcx
  have hmem : (none, s) ∈ padList (padC r x t) (FreeGroup.toWord r) := by
    rw [padList, List.mem_flatten]
    exact ⟨padBlock (padC r x t) (x, b), List.mem_map.mpr ⟨(x, b), hb, rfl⟩, hs⟩
  -- and the padded relator is the product of the blocks
  rw [padRel, relatorLetters, Set.mem_ofPred_eq]
  refine ⟨s, ?_⟩
  have htw : FreeGroup.toWord (padHom (padC r x t) r) =
      padList (padC r x t) (FreeGroup.toWord r) := toWord_padHom (padC r x t) r
  rw [toWord_decEq_congr _ _ (padHom (padC r x t) r), htw]
  exact hmem

/-- The half-length exponent-sum-zero case of Weinbaum's theorem, for a relator which is not a
proper power.

**How this is proved.**  It is the statement `Work.OROneRel.weinbaum_sigma_zero_half` of the sibling
module `Submission.Work.OROneRel.weinbaum_sigma_zero_half`, and it is obtained from the assembly
`Work.OROneRel.weinbaum_sigma_zero_half_of` there, whose two inputs are the induction steps:

* the *exponent-sum-zero* step of the induction, which is `Work.OROneRel.sigma_step` (the Magnus
  decomposition turns `⟨β | R⟩` into an HNN extension of `⟨mmBeta z R | mmW z R⟩` and localises the
  rewriting of a subword -- `magRew_block_subword_mmBeta`);
* the *no-zero-exponent-sum* step of the induction, which is `Work.OROneRel.weinbaum_half_noZero`
  (`Submission.Work.OROneRel.weinbaum_half_noZero`): Magnus' substitution `subst t x (σ_x T) (σ_t T)`
  of a counterexample at `T` is decorated (`wneSubstLocalisationB`), descends to the Magnus base
  `mmW t v` of a cyclically reduced conjugate `v` of the substituted relator, and gives a
  half-length counterexample at `mmW t v`, of norm `letterCountNot t v = letterCountNot t T <
  relatorNorm T`, where the induction hypothesis applies.

The *undecorated* analogue of that transport (`Work.OROneRel.subst_transport`) is genuinely false;
the Magnus decorations, not the subword structure, are what transports. -/
theorem weinbaum_sigma_zero_half_aux {β : Type u} (R : FreeGroup β) {z : β}
    (hcyc : IsCyclicallyReducedRelator R) (hpp : ¬ IsProperPower R)
    (hz : z ∈ relatorLetters R) (h : expSum z R = 1) :
    ∀ (k : ℕ) (w : FreeGroup β), IsSubwordOf w (R ^ k) →
      2 * relatorNorm w ≤ relatorNorm R → w ≠ 1 →
      PresentedGroup.mk ({R} : Set (FreeGroup β)) w ≠ 1 :=
  weinbaum_sigma_zero_half_of R
    (fun {γ : Type u} (T : FreeGroup γ) (hc : IsCyclicallyReducedRelator T)
      (hp : ¬ IsProperPower T) (hσT : ∀ y ∈ relatorLetters T, expSum y T ≠ 1)
      (IH : ∀ {δ : Type u} (U : FreeGroup δ), relatorNorm U < relatorNorm T →
        IsCyclicallyReducedRelator U → ¬ IsProperPower U → HalfAt U) =>
      weinbaum_half_noZero T IH hc hp hσT)
    hcyc hpp hz h

/-- Two nonempty commuting words are powers of a common word. -/
theorem wne_comm_words_common_root {σ : Type u} : ∀ (n : ℕ) {A B : List σ},
    A.length + B.length ≤ n → A ≠ [] → B ≠ [] → A ++ B = B ++ A →
    ∃ (W : List σ) (p q : ℕ), W ≠ [] ∧ 1 ≤ p ∧ 1 ≤ q ∧
      A = (List.replicate p W).flatten ∧ B = (List.replicate q W).flatten := by
  intro n
  induction n with
  | zero =>
    intro A B hlen hA _
    refine absurd ?_ hA
    exact List.length_eq_zero_iff.mp (Nat.eq_zero_of_add_eq_zero_right (Nat.le_zero.mp hlen))
  | succ n ih =>
    intro A B hlen hA hB h
    have hApos : 1 ≤ A.length := List.length_pos_iff.mpr hA
    have hBpos : 1 ≤ B.length := List.length_pos_iff.mpr hB
    rcases lt_trichotomy A.length B.length with hlt | heq | hgt
    · -- `A` is a prefix of `B`
      have hpre : B.take A.length = A := by
        have h1 := congrArg (fun L => L.take A.length) h
        rw [List.take_append_of_le_length hlt.le, List.take_left] at h1
        exact h1.symm
      have hBdecomp : B = A ++ B.drop A.length := by
        have h2 : B = B.take A.length ++ B.drop A.length :=
          (List.take_append_drop A.length B).symm
        rw [hpre] at h2
        exact h2
      have hB'ne : B.drop A.length ≠ [] := by
        intro h0
        have h1 : B.length = A.length := by
          rw [hBdecomp, List.length_append, List.length_eq_zero_iff.mpr h0, add_zero]
        omega
      have hcomm : B.drop A.length ++ A = A ++ B.drop A.length := by
        have h' := h
        rw [hBdecomp] at h'
        rw [List.append_assoc] at h'
        exact (List.append_cancel_left h').symm
      have hlen' : (B.drop A.length).length + A.length ≤ n := by
        have hb : (B.drop A.length).length = B.length - A.length := List.length_drop ..
        have hba : (B.length - A.length) + A.length = B.length := Nat.sub_add_cancel hlt.le
        omega
      obtain ⟨W, p, q, hWne, hp, hq, hB'eq, hAeq⟩ := ih hlen' hB'ne hA hcomm
      refine ⟨W, q, p + q, hWne, hq, by omega, hAeq, ?_⟩
      rw [hBdecomp]
      nth_rw 1 [hAeq]
      rw [hB'eq, ← List.flatten_append, ← List.replicate_add, Nat.add_comm]
    · -- equal lengths: `A = B`
      have hAB : A = B := by
        have h1 : (A ++ B).take A.length = (B ++ A).take A.length :=
          congrArg (fun L => L.take A.length) h
        have h2 : (A ++ B).take A.length = A := by
          rw [List.take_append_of_le_length le_rfl, List.take_length]
        have h3 : (B ++ A).take A.length = B := by
          rw [List.take_append_of_le_length heq.le, List.take_of_length_le heq.symm.le]
        rw [h2, h3] at h1
        exact h1
      exact ⟨A, 1, 1, hA, le_rfl, le_rfl, by simp, by rw [← hAB]; simp⟩
    · -- `B` is a prefix of `A`
      have hpre : A.take B.length = B := by
        have h1 := congrArg (fun L => L.take B.length) h
        rw [List.take_append_of_le_length hgt.le, List.take_left] at h1
        exact h1
      have hAdecomp : A = B ++ A.drop B.length := by
        have h2 : A = A.take B.length ++ A.drop B.length :=
          (List.take_append_drop B.length A).symm
        rw [hpre] at h2
        exact h2
      have hA'ne : A.drop B.length ≠ [] := by
        intro h0
        have h1 : A.length = B.length := by
          rw [hAdecomp, List.length_append, List.length_eq_zero_iff.mpr h0, add_zero]
        omega
      have hcomm : A.drop B.length ++ B = B ++ A.drop B.length := by
        have h' := h
        rw [hAdecomp] at h'
        rw [List.append_assoc] at h'
        exact List.append_cancel_left h'
      have hlen' : (A.drop B.length).length + B.length ≤ n := by
        have ha : (A.drop B.length).length = A.length - B.length := List.length_drop ..
        have hab : (A.length - B.length) + B.length = A.length := Nat.sub_add_cancel hgt.le
        omega
      obtain ⟨W, p, q, hWne, hp, hq, hA'eq, hBeq⟩ := ih hlen' hA'ne hB hcomm
      refine ⟨W, q + p, q, hWne, by omega, hq, ?_, hBeq⟩
      rw [hAdecomp]
      nth_rw 1 [hBeq]
      rw [hA'eq, ← List.flatten_append, ← List.replicate_add]

/-- A nonempty word fixed by a nontrivial rotation is a proper power: split `L = A ++ B` at the
rotation point; since `L.rotate s = L` the two blocks `A`, `B` commute, hence are powers of a
common word, and so `mk L` is a genuine power. -/
theorem wne_isProperPower_mk_of_rotate_eq {L : List (α × Bool)} {s : ℕ}
    (hs : 0 < s) (hsn : s < L.length) (h : L.rotate s = L) :
    Work.OROneRel.IsProperPower (FreeGroup.mk L) := by
  have hsle : s ≤ L.length := hsn.le
  have hrot : L.drop s ++ L.take s = L := by
    have h1 : L.rotate s = L.drop s ++ L.take s := List.rotate_eq_drop_append_take hsle
    rw [h] at h1
    exact h1.symm
  have hcomm : L.take s ++ L.drop s = L.drop s ++ L.take s := by
    rw [hrot, List.take_append_drop]
  have hAne : L.take s ≠ [] := by
    intro hnil
    have hlen : (L.take s).length = 0 := List.length_eq_zero_iff.mpr hnil
    rw [List.length_take, Nat.min_eq_left hsle] at hlen
    omega
  have hBne : L.drop s ≠ [] := by
    intro hnil
    have hlen : (L.drop s).length = 0 := List.length_eq_zero_iff.mpr hnil
    rw [List.length_drop] at hlen
    omega
  obtain ⟨W, p, q, hWne, hp, hq, hAeq, hBeq⟩ :=
    wne_comm_words_common_root ((L.take s).length + (L.drop s).length)
      (A := L.take s) (B := L.drop s) le_rfl hAne hBne hcomm
  refine ⟨FreeGroup.mk W, p + q, by omega, ?_⟩
  rw [← List.take_append_drop s L, ← FreeGroup.mul_mk, hAeq, hBeq, mk_flatten_replicate,
    mk_flatten_replicate, ← pow_add]

/-- **The padded relator is not a proper power.**  The projection `padProj` killing the fresh letter
sends the padded relator to the word of `r` with every letter doubled; since `mk` of that word is a
`k`-th power (`k ≥ 2`), the doubling is a `k`-fold repetition of a block, which either exhibits a
nontrivial cyclic period of the word of `r` (`wne_isProperPower_mk_of_rotate_eq`) or makes it
constant of length `≥ 2`; in both cases `r` would be a proper power. -/
theorem not_isProperPower_padRel_aux (c : α → ℤ) {r : FreeGroup α}
    (hcyc : IsCyclicallyReducedRelator r) (hr : ¬ IsProperPower r)
    (hnorm : 2 ≤ relatorNorm r) :
    ¬ IsProperPower (padRel c r) := by
  classical
  intro hpow
  obtain ⟨U, k, hk, hW⟩ := hpow
  have hW' : padHom c r = U ^ k := hW
  have hlen2 : 2 ≤ (FreeGroup.toWord r).length := by
    simpa only [relatorNorm, FreeGroup.norm] using hnorm
  -- the doubled word of `r` is cyclically reduced
  have hDcyc : FreeGroup.IsCyclicallyReduced
      ((FreeGroup.toWord r).map (fun p : α × Bool => [p, p])).flatten :=
    isCyclicallyReduced_doubledWord_of_relator hcyc
  have hDred : FreeGroup.IsReduced
      ((FreeGroup.toWord r).map (fun p : α × Bool => [p, p])).flatten := hDcyc.1
  -- killing the padding letter turns `padRel c r = U ^ k` into `mk D = (padProj U) ^ k`
  have hmkD : FreeGroup.mk ((FreeGroup.toWord r).map (fun p : α × Bool => [p, p])).flatten
      = (padProj U) ^ k := by
    rw [doubledWord_mk_eq_lift_sq]
    have h1 : FreeGroup.lift (fun a : α => FreeGroup.of a ^ (2 : ℕ)) r
        = padProj (padHom c r) := (DFunLike.congr_fun (padProj_padHom c) r).symm
    rw [h1, hW', map_pow]
  obtain ⟨B, hB⟩ :=
    eq_flatten_replicate_of_cyclicallyReduced_of_pow hDred hDcyc hk hmkD
  rcases doubledWord_rotate_or_replicate (FreeGroup.toWord r) hlen2 hk hB with
    ⟨s, hs0, hsn, hrot⟩ | ⟨p, hp⟩
  · -- a nontrivial cyclic period makes `r` a proper power
    exact hr (by
      have h := wne_isProperPower_mk_of_rotate_eq hs0 hsn hrot
      rwa [FreeGroup.mk_toWord] at h)
  · -- a constant word of length `≥ 2` is a power of a single generator
    refine hr ⟨FreeGroup.mk [p], (FreeGroup.toWord r).length, hlen2, ?_⟩
    have hgen : ∀ (q : α × Bool) (n : ℕ),
        FreeGroup.mk (List.replicate n q) = (FreeGroup.mk [q]) ^ n := by
      intro q n
      induction n with
      | zero => rw [List.replicate_zero, pow_zero, FreeGroup.one_eq_mk]
      | succ m ih =>
          rw [List.replicate_succ,
            show q :: List.replicate m q = [q] ++ List.replicate m q from rfl,
            ← FreeGroup.mul_mk, ih, pow_succ']
    calc r = FreeGroup.mk (FreeGroup.toWord r) := (FreeGroup.mk_toWord).symm
      _ = FreeGroup.mk (List.replicate (FreeGroup.toWord r).length p) := by
            conv_lhs => rw [hp]
      _ = (FreeGroup.mk [p]) ^ (FreeGroup.toWord r).length := hgen p _

/-- **The halving reduction for the exponent-sum-zero case.**  If Weinbaum's theorem is known for
subwords `w` with `2 * relatorNorm w ≤ relatorNorm R`, then it holds for all subwords: a
counterexample produces, by cutting out the complementary arc of the cyclic word of `R`, a
counterexample of complementary length, and the shorter of the two has length at most half of
`relatorNorm R`.  The relator is unchanged, so `¬ IsProperPower R` is preserved. -/
theorem weinbaum_sigma_zero_pp_of_half {β : Type u} (R : FreeGroup β) {z : β}
    (hcyc : IsCyclicallyReducedRelator R) (hpp : ¬ IsProperPower R)
    (hz : z ∈ relatorLetters R) (h : expSum z R = 1)
    (hhalf : ∀ (k : ℕ) (w : FreeGroup β), IsSubwordOf w (R ^ k) →
      2 * relatorNorm w ≤ relatorNorm R → w ≠ 1 →
      PresentedGroup.mk ({R} : Set (FreeGroup β)) w ≠ 1) :
    ∀ (k : ℕ) (w : FreeGroup β), IsSubwordOf w (R ^ k) → relatorNorm w < relatorNorm R →
      w ≠ 1 → PresentedGroup.mk ({R} : Set (FreeGroup β)) w ≠ 1 := by
  intro k w hsub hlen hw1 hcontra
  obtain ⟨s, m, hsubs, hs1, hsnorm, hscontra⟩ :=
    exists_complement_counterexample hcyc hsub hlen hw1 hcontra
  have hsum : relatorNorm w + relatorNorm s = relatorNorm R := by omega
  rcases le_total (relatorNorm w) (relatorNorm s) with hle | hle
  · exact hhalf k w hsub (by omega) hw1 hcontra
  · exact hhalf m s hsubs (by omega) hs1 hscontra

/-- The exponent-sum-zero case of Weinbaum's theorem for a relator which is not a proper power. -/
theorem weinbaum_sigma_zero_aux {β : Type u} (R : FreeGroup β) {z : β}
    (hcyc : IsCyclicallyReducedRelator R) (hpp : ¬ IsProperPower R)
    (hz : z ∈ relatorLetters R) (h : expSum z R = 1) :
    ∀ (k : ℕ) (w : FreeGroup β), IsSubwordOf w (R ^ k) → relatorNorm w < relatorNorm R →
      w ≠ 1 → PresentedGroup.mk ({R} : Set (FreeGroup β)) w ≠ 1 :=
  weinbaum_sigma_zero_pp_of_half R hcyc hpp hz h
    (weinbaum_sigma_zero_half_aux R hcyc hpp hz h)

/-! ### Consequences of the padding, proved here -/

/-- **Injectivity of the padding**: the padded word of a nontrivial element is nontrivial. -/
theorem padHom_injective_aux (c : α → ℤ) : Function.Injective (padHom c) := by
  classical
  have htw : ∀ u : FreeGroup α, (padHom c u).toWord = padList c u.toWord := fun u =>
    toWord_padHom_aux c u
  intro u v huv
  by_contra hne
  have h1 : padHom c (u * v⁻¹) = 1 := by rw [map_mul, map_inv, huv, mul_inv_cancel]
  have h2 : (padHom c (u * v⁻¹)).toWord = [] := by rw [h1, FreeGroup.toWord_one]
  rw [htw (u * v⁻¹)] at h2
  have h3 : (u * v⁻¹).toWord = [] := by
    by_contra hnil
    exact padList_ne_nil c hnil h2
  have h4 : u * v⁻¹ = 1 := FreeGroup.toWord_eq_nil_iff.mp h3
  have h5 : u = v := by
    have := (mul_eq_one_iff_eq_inv.mp h4)
    rw [this, inv_inv]
  exact hne h5

/-- The transfer of triviality along the padding. -/
theorem mk_padHom_eq_one_aux {c : α → ℤ} {r v : FreeGroup α}
    (h : PresentedGroup.mk ({r} : Set (FreeGroup α)) v = 1) :
    PresentedGroup.mk ({padRel c r} : Set (FreeGroup (Option α))) (padHom c v) = 1 := by
  classical
  have hv : v ∈ Subgroup.normalClosure ({r} : Set (FreeGroup α)) :=
    (PresentedGroup.mk_eq_one_iff).mp h
  have hle := c2s_map_normalClosure_le' (padHom c) r
  have hmem : padHom c v ∈
      Subgroup.normalClosure ({padHom c r} : Set (FreeGroup (Option α))) := hle hv
  have hmem' : padHom c v ∈
      Subgroup.normalClosure ({padRel c r} : Set (FreeGroup (Option α))) := hmem
  exact (PresentedGroup.mk_eq_one_iff).mpr hmem'

/-! ### The main theorem -/

theorem weinbaumAt_of_expSum_ne_zero {α : Type u} (r : FreeGroup α)
    (h : ∀ a ∈ Work.OROneRel.relatorLetters r, Work.OROneRel.expSum a r ≠ 1) :
    Work.OROneRel.WeinbaumAt r := by
  classical
  intro hcyc hpp k v hsub hlen hv1 hmk
  -- the counterexample is nontrivial, so `2 ≤ relatorNorm r`
  have hvpos : 1 ≤ relatorNorm v := by
    refine Nat.one_le_iff_ne_zero.mpr fun h0 => hv1 ?_
    simp only [relatorNorm] at h0
    exact FreeGroup.norm_eq_zero.mp h0
  have hrpos : 2 ≤ relatorNorm r := by omega
  by_cases hmiss : ∃ a₀ ∈ relatorLetters r, a₀ ∉ relatorLetters v
  · -- `v` misses a letter of `r`: the Freiheitssatz settles it
    obtain ⟨a₀, ha₀, hvmiss⟩ := hmiss
    exact mk_ne_one_of_misses_letter_aux hcyc ha₀ hvmiss hv1 hmk
  · push Not at hmiss
    -- two distinct letters of `r`
    obtain ⟨x, hx, t, ht, hxt⟩ := exists_two_mem_relatorLetters_ne r hrpos hpp
    have htnz : (expSum t r).toAdd ≠ 0 := by
      have ht' := h t ht
      simpa using ht'
    have hcx : padC r x t x ≠ 0 := by
      rw [show padC r x t x = (expSum t r).toAdd from by rw [padC]; simp]
      exact htnz
    set R : FreeGroup (Option α) := padRel (padC r x t) r with hR
    have hRcyc : IsCyclicallyReducedRelator R := pad_isCyclicallyReduced_aux _ hcyc
    have hRpp : ¬ IsProperPower R :=
      not_isProperPower_padRel_aux _ hcyc hpp hrpos
    have hz : (none : Option α) ∈ relatorLetters R := none_mem_padRel_aux hx hcx
    have hzexp : expSum (none : Option α) R = 1 := expSum_none_padRel_aux r hxt
    have hsub' : IsSubwordOf (padHom (padC r x t) v) (R ^ k) :=
      pad_subword_aux _ hcyc hsub
    have hlen' : relatorNorm (padHom (padC r x t) v) < relatorNorm R :=
      pad_length_lt_aux r v _ k hcyc hsub hlen
    have hvne : padHom (padC r x t) v ≠ 1 := fun h1 =>
      hv1 (padHom_injective_aux _ (by rw [h1, map_one]))
    have hmk' : PresentedGroup.mk ({R} : Set (FreeGroup (Option α)))
        (padHom (padC r x t) v) = 1 := mk_padHom_eq_one_aux hmk
    exact weinbaum_sigma_zero_aux R hRcyc hRpp hz hzexp k (padHom (padC r x t) v) hsub' hlen'
      hvne hmk'

end Work.OROneRel
