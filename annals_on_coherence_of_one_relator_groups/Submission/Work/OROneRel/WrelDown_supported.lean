import Mathlib
import Submission.Work.OROneRel.levelChain
import Submission.Work.OROneRel.decor_tlU_tlW_at
import Submission.Work.OROneRel.decor_flatten_replicate_gen

namespace Work.OROneRel

/-!
# The relators of a level window are supported in its edges

`WrelDown p q l a` is the set of the `2`-cell relators
`mk (decor (tlW p q) m (wordOf (tlU p q ^ l)))` of the level windows `[a, pq]`, `a ≤ m ≤ 0`, i.e.
the relators attached to the `l`-fold staircase of `u = a^p b^q` at the starting levels
`m ∈ [a, 0]`.

The main theorem `WrelDown_supported` shows that each of them lies in the subgroup of the edge group
`F (Fin 2 × ℤ)` generated by the edges `Wedge p q a (p*q)` of the window `[a, pq]`.  The proof is
purely combinatorial:

* the decoration of `u ^ l` at level `m` is the `l`-fold concatenation of the decoration of `u` at
  level `m` (the running level returns to `m` after each copy, because the weight `tlW p q` kills
  `u`);
* the decoration of `u = a^p b^q` at level `m` is the explicit walk
  `(a, m), (a, m+q), …, (a, m+(p-1)q), (b, m+pq), …, (b, m+p)`;
* for `a ≤ m ≤ 0` every one of these edges lies in the window `[a, pq]`.
-/

/-! ## Free-group bookkeeping -/

/-- If every letter of a word `L` over an alphabet `α` spells a generator lying in the set `S`,
then the element of the free group `F α` spelled by `L` lies in the subgroup generated by `S`. -/
private theorem mk_mem_closure_of_letters {α : Type*} (L : List (α × Bool)) (S : Set α)
    (h : ∀ p ∈ L, p.1 ∈ S) :
    FreeGroup.mk L ∈ Subgroup.closure (FreeGroup.of '' S) := by
  induction L with
  | nil => exact Subgroup.one_mem _
  | cons p L ih =>
    obtain ⟨a, b⟩ := p
    have ha : a ∈ S := h (a, b) (List.mem_cons_self ..)
    have ih' : FreeGroup.mk L ∈ Subgroup.closure (FreeGroup.of '' S) :=
      ih (fun q hq => h q (List.mem_cons_of_mem _ hq))
    have hofa : FreeGroup.of a ∈ Subgroup.closure (FreeGroup.of '' S) :=
      Subgroup.subset_closure ⟨a, ha, rfl⟩
    cases b
    · rw [show FreeGroup.mk ((a, false) :: L) = (FreeGroup.of a)⁻¹ * FreeGroup.mk L from by
        rw [show ((a, false) :: L) = [(a, false)] ++ L from rfl, ← FreeGroup.mul_mk]; rfl]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hofa) ih'
    · rw [show FreeGroup.mk ((a, true) :: L) = FreeGroup.of a * FreeGroup.mk L from by
        rw [show ((a, true) :: L) = [(a, true)] ++ L from rfl, ← FreeGroup.mul_mk]; rfl]
      exact Subgroup.mul_mem _ hofa ih'

/-! ## The two-letter relator is cyclically reduced, for all exponents -/

/-- A concatenation of two constant blocks is cyclically reduced as soon as the two letters have the
same second component: all letters of the word have that second component, so neither a cancellation
inside a block nor one at the junction is possible. -/
private theorem isCycRed_replicate_append_replicate {α : Type*} {x y : α × Bool} (hxy : x.2 = y.2)
    (p q : ℕ) : FreeGroup.IsCyclicallyReduced (List.replicate p x ++ List.replicate q y) := by
  rw [FreeGroup.isCyclicallyReduced_iff]
  refine ⟨isReduced_replicate_append_replicate hxy p q, ?_⟩
  intro a ha b hb _
  have ha' : a ∈ List.replicate p x ++ List.replicate q y := List.mem_of_mem_getLast? ha
  have hb' : b ∈ List.replicate p x ++ List.replicate q y := List.mem_of_mem_head? hb
  have hmem : ∀ z ∈ List.replicate p x ++ List.replicate q y, z.2 = x.2 := by
    intro z hz
    simp only [List.mem_append, List.mem_replicate] at hz
    rcases hz with ⟨-, rfl⟩ | ⟨-, rfl⟩
    · rfl
    · exact hxy.symm
  rw [hmem a ha', hmem b hb']

/-- The two-letter relator `tlU p q = a^p b^q` is cyclically reduced, for *all* natural `p, q`
(in particular with no positivity hypothesis on `q`). -/
private theorem isCyclicallyReducedRelator_tlU (p q : ℕ) :
    IsCyclicallyReducedRelator (tlU p q) := by
  change FreeGroup.IsCyclicallyReduced (wordOf (tlU p q))
  rw [wordOf_tlU]
  exact isCycRed_replicate_append_replicate (x := ((0 : Fin 2), true))
    (y := ((1 : Fin 2), true)) rfl p q

/-- The weight `tlW p q` kills the relator `tlU p q = a^p b^q`. -/
private theorem lsig_tlW_wordOf_tlU (p q : ℕ) : lsig (tlW p q) (wordOf (tlU p q)) = 0 := by
  rw [wordOf_tlU, decor_lsig_append, lsig_replicate_true, lsig_replicate_true, tlW_zero, tlW_one]
  ring

/-- The decoration of the `l`-th power of `tlU p q`, started at level `m`, is the `l`-fold
concatenation of the decoration of `tlU p q` started at level `m`. -/
private theorem decor_tlU_pow_eq (p q l : ℕ) (m : ℤ) :
    decor (tlW p q) m (wordOf (tlU p q ^ l))
      = List.flatten (List.replicate l (decor (tlW p q) m (wordOf (tlU p q)))) := by
  rw [wordOf_pow_flatten (tlU p q) l (isCyclicallyReducedRelator_tlU p q)]
  exact decor_flatten_replicate_at (tlW p q) (wordOf (tlU p q)) (lsig_tlW_wordOf_tlU p q) m l

/-! ## The decorated walk of `tlU p q` is supported in the window `[m, m+pq]` -/

/-- Every decorated letter of the walk of `tlU p q = a^p b^q` started at level `m` lies in the
window `Wedge p q a (p*q)`, provided `a ≤ m ≤ 0` and `1 ≤ p`. -/
private theorem Wedge_decor_tlU_mem (p q : ℕ) (hp : 1 ≤ p) {a m : ℤ} (ham : a ≤ m) (hm0 : m ≤ 0) :
    ∀ y ∈ decor (tlW p q) m (wordOf (tlU p q)),
      y.1 ∈ Wedge p q a ((p : ℤ) * (q : ℤ)) := by
  rw [decor_tlU_tlW_at]
  intro y hy
  rcases List.mem_append.mp hy with hy | hy
  · obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hy
    rw [mem_Wedge_zero]
    have hj : (j : ℤ) + 1 ≤ (p : ℤ) := by
      have : (j : ℤ) < (p : ℤ) := by exact_mod_cast j.isLt
      linarith
    have hqnn : (0 : ℤ) ≤ (q : ℤ) := by positivity
    constructor
    · have : (0 : ℤ) ≤ (j : ℤ) * (q : ℤ) := mul_nonneg (by positivity) hqnn
      linarith
    · have h1 : ((j : ℤ) + 1) * (q : ℤ) ≤ (p : ℤ) * (q : ℤ) :=
        mul_le_mul_of_nonneg_right hj hqnn
      nlinarith [hm0, h1]
  · obtain ⟨k, rfl⟩ := List.mem_ofFn.mp hy
    rw [mem_Wedge_one]
    have hk : (k : ℤ) ≤ (q : ℤ) - 1 := by
      have : (k : ℤ) < (q : ℤ) := by exact_mod_cast k.isLt
      omega
    have hpnn : (0 : ℤ) ≤ (p : ℤ) := by positivity
    constructor
    · have h1 : (k : ℤ) * (p : ℤ) ≤ ((q : ℤ) - 1) * (p : ℤ) :=
        mul_le_mul_of_nonneg_right hk hpnn
      nlinarith [ham, h1]
    · have : (0 : ℤ) ≤ (k : ℤ) * (p : ℤ) := mul_nonneg (by positivity) hpnn
      linarith

/-! ## The statement -/

theorem WrelDown_supported (p q l : ℕ) (hp : 1 ≤ p) {a : ℤ} (ha : a ≤ 0) :
    Work.OROneRel.WrelDown p q l a ⊆
      Subgroup.closure (FreeGroup.of '' Work.OROneRel.Wedge p q a ((p : ℤ) * (q : ℤ))) := by
  intro w hw
  obtain ⟨m, ham, hm0, rfl⟩ := hw
  refine mk_mem_closure_of_letters (decor (tlW p q) m (wordOf (tlU p q ^ l)))
    (Wedge p q a ((p : ℤ) * (q : ℤ))) (fun y hy => ?_)
  rw [decor_tlU_pow_eq p q l m] at hy
  obtain ⟨Y, hY, hyY⟩ := List.mem_flatten.mp hy
  rw [List.mem_replicate] at hY
  exact Wedge_decor_tlU_mem p q hp ham hm0 y (hY.2 ▸ hyY)

end Work.OROneRel
