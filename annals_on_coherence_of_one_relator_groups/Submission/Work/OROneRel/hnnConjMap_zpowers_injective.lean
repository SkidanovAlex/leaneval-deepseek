import Mathlib
import Submission.Work.OROneRel.band_hnnConjMap_injective

/-!
# Injectivity of `hnnConjMap ⟨w⟩ τ` when `w` and `τ` generate `F₂`

Let `H = Subgroup.zpowers w ≤ F₂` be a cyclic subgroup and `τ ∈ F₂` such that
`⟨w, τ⟩ = F₂`.  We show that the comparison map

  `hnnConjMap H τ : HNN(↥H, H ⊓ τ⁻¹Hτ, H ⊓ τHτ⁻¹, conj_τ) →* F₂`

is injective, so that `F₂` is *the* HNN extension of the cyclic pair `(⟨w⟩, τ)`.

## The argument

`hnnConjMap H τ` is surjective because its values on the image of `of` and on the stable letter `t`
are `H` and `τ`, which generate `F₂` by hypothesis (`hnnConjMap_bijective`).  Hence it has a right
inverse `ρ : F₂ →* HNN(↥H, …)` given on generators by `a ↦ of w`, `b ↦ t` (the HNN extension is
generated by `of w` and `t`, since `↥H` is generated by `w` — this is the helper lemma
`hnnExtension_zpowers_closure_eq_top` below, an application of `HNNExtension.induction_on`).  The
composite `hnnConjMap H τ ∘ ρ` is the endomorphism `a ↦ w`, `b ↦ τ` of `F₂`, which is surjective
because `⟨w, τ⟩ = F₂`; by Hopficity of `F₂` (`Work.OROneRel.freeGroup_fin_two_hopfian`) it is
injective, and a surjection followed by an injective composite is injective.  This is exactly the
criterion `Work.OROneRel.hnnConjMap_injective_of_two_generated`, which we apply.
-/

namespace Work.OROneRel

/-- **The HNN extension of a cyclic pair is two-generated.**  For `H = Subgroup.zpowers w`, the HNN
extension `HNN(↥H, H ⊓ τ⁻¹Hτ, H ⊓ τHτ⁻¹, conj_τ)` is generated by `of ⟨w, _⟩` (the image of the
cyclic generator of `↥H`) together with the stable letter `t`.  Indeed `HNNExtension.induction_on`
reduces the claim to the two obvious cases, and every element of `↥H` is a `ℤ`-power of `⟨w, _⟩`. -/
theorem hnnExtension_zpowers_closure_eq_top (w tau : FreeGroup (Fin 2))
    (hw : w ∈ Subgroup.zpowers w) :
    Subgroup.closure
      ({HNNExtension.of (A := (hnnEdgeA (Subgroup.zpowers w) tau).subgroupOf (Subgroup.zpowers w))
          (B := (hnnEdgeB (Subgroup.zpowers w) tau).subgroupOf (Subgroup.zpowers w))
          (φ := hnnConjEquiv (Subgroup.zpowers w) tau) ⟨w, hw⟩,
        HNNExtension.t} : Set (HNNExtension ↥(Subgroup.zpowers w)
          ((hnnEdgeA (Subgroup.zpowers w) tau).subgroupOf (Subgroup.zpowers w))
          ((hnnEdgeB (Subgroup.zpowers w) tau).subgroupOf (Subgroup.zpowers w))
          (hnnConjEquiv (Subgroup.zpowers w) tau))) = ⊤ := by
  refine le_antisymm le_top ?_
  intro x _
  refine HNNExtension.induction_on x ?_ ?_ ?_ ?_
  · intro g
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
      (g.2 : ((g : ↥(Subgroup.zpowers w)) : FreeGroup (Fin 2)) ∈ Subgroup.zpowers w)
    have hgk : (⟨w, hw⟩ : ↥(Subgroup.zpowers w)) ^ k = g := Subtype.ext (by simpa using hk)
    rw [← hgk, map_zpow]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) k
  · exact Subgroup.subset_closure (by simp)
  · intro a b ha hb; exact Subgroup.mul_mem _ ha hb
  · intro a ha; exact Subgroup.inv_mem _ ha

/-- **Injectivity of the comparison map for a cyclic vertex.**  If `w` and `τ` generate `F₂`, then
the comparison map of the HNN extension of the cyclic subgroup `⟨w⟩` along `τ` is injective. -/
theorem hnnConjMap_zpowers_injective {w tau : FreeGroup (Fin 2)}
    (hgen : Subgroup.zpowers w ⊔ Subgroup.zpowers tau = ⊤) :
    Function.Injective (hnnConjMap (Subgroup.zpowers w) tau) :=
  hnnConjMap_injective_of_two_generated hgen _ _
    (hnnExtension_zpowers_closure_eq_top w tau (Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩))

end Work.OROneRel
