/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# Transfer of the Karrass--Magnus--Solitar root statement along the Case-2 substitution

This module proves `Work.OROneRel.kmsRoot_of_subst`, the transfer of the KMS statement for the
one-relator presentation `⟨α | u ^ l⟩` from the one for `⟨α | (ψ u) ^ l⟩`, where
`ψ = subst t x (σ_x u) (σ_t u)` is the Case-2 substitution of the Freiheitssatz
(`t ↦ t ^ (σ_x u)`, `x ↦ x * t ^ (-(σ_t u))`, all other generators fixed).

The route is the one designed in `MM_NOZERO_LEAD.md`: the substitution induces
`ι = substHom r t x p q : ⟨α | r⟩ →* ⟨α | ψ r⟩` with `ι (mk w) = mk (ψ w)`, and there is an
amalgam `⟨α | ψ r⟩ ≅ ⟨α | r⟩ ∗_{t^n = s^{p n}} ⟨s⟩` in which `mk (ψ w)` goes to the class of `w`
in the first factor.  The conjugacy transfer across the amalgam is the Bass--Serre tree argument
(`Work.OROneRel.pushoutI_conj_transfer`).

Since `Work.ORLocInd.FKSKernel`'s pushout/tree machinery requires the index type of the family to
live in the same universe as the groups, the amalgam is built here over the index type
`ULift Bool` (`kmsTrue`, `kmsFalse`) rather than `Bool`; `kmsAmFam`/`kmsAmPhi` are the `ULift`
reindexings of `AmFactor`/`amPhi`.

Only *one* direction of the amalgam is used: the homomorphism

  `kmsSigma : ⟨α | ψ r⟩ →* Monoid.PushoutI (kmsAmPhi r t p)`

sending a generator `a ≠ t, x` to its class in the first factor, the generator `t` to `s` and the
generator `x` to `x * s ^ q`, together with its defining property
`kmsSigma (substHom r t x p q g) = of kmsTrue g` (`kmsSigma_substHom`).  The order half of the KMS
statement uses none of this: there `orderOf_map_dvd` and `(mk u) ^ l = 1` suffice.
-/
import Mathlib
import Submission.Work.OROneRel.NoZeroDefs
import Submission.Work.OROneRel.KMSDefs
import Submission.Work.OROneRel.isCyclicallyReducedRelator_pow
import Submission.Work.OROneRel.freiheitssatz_magnusSubgroup_of_not_supported
import Submission.Work.OROneRel.pushoutI_conj_transfer

namespace Work.OROneRel

universe u

variable {α : Type u}

/-! ## The amalgam reindexed over `ULift Bool` -/

/-- The first factor of the amalgam (`⟨α | r⟩`), as an index. -/
abbrev kmsTrue : ULift.{u} Bool := ULift.up true

/-- The second factor of the amalgam (`⟨s⟩`), as an index. -/
abbrev kmsFalse : ULift.{u} Bool := ULift.up false

/-- The family of vertex groups of the amalgam, indexed by `ULift Bool`. -/
noncomputable abbrev kmsAmFam (r : FreeGroup α) : ULift.{u} Bool → Type u :=
  fun i => Work.OROneRel.AmFactor r i.down

noncomputable instance kmsAmFamGroup (r : FreeGroup α) : ∀ i : ULift.{u} Bool, Group (kmsAmFam r i) :=
  fun i => inferInstanceAs (Group (Work.OROneRel.AmFactor r i.down))

/-- The family of amalgamating homomorphisms, indexed by `ULift Bool`. -/
noncomputable def kmsAmPhi (r : FreeGroup α) (t : α) (p : ℤ) :
    ∀ i : ULift.{u} Bool, ULift.{u} (Multiplicative ℤ) →* kmsAmFam r i :=
  fun i => Work.OROneRel.amPhi r t p i.down

@[simp]
theorem kmsAmPhi_true (r : FreeGroup α) (t : α) (p : ℤ) :
    kmsAmPhi r t p kmsTrue = Work.OROneRel.amPhi r t p true := rfl

@[simp]
theorem kmsAmPhi_false (r : FreeGroup α) (t : α) (p : ℤ) :
    kmsAmPhi r t p kmsFalse = Work.OROneRel.amPhi r t p false := rfl

/-- The generator `1` of the amalgamating group `ULift (Multiplicative ℤ)` (the cyclic group
generated by the stable letter `s`). -/
noncomputable def kmsS : ULift.{u} (Multiplicative ℤ) := ULift.up (Multiplicative.ofAdd (1 : ℤ))

/-! ## The one-way map `⟨α | ψ r⟩ →* ⟨α | r⟩ ∗_{t = s ^ p} ⟨s⟩` -/

/-- The map on generators underlying `kmsSigma`: the generators different from `t` and `x` are sent
to their class in the first factor, `t` to the stable letter `s`, and `x` to `x * s ^ q`. -/
noncomputable def kmsSigmaFun (r : FreeGroup α) (t x : α) (p q : ℤ) :
    α → Monoid.PushoutI (kmsAmPhi r t p) := by
  classical
  exact fun a =>
    if a = t then Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsFalse kmsS
    else if a = x then
      Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
          (PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) a) *
        (Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsFalse kmsS) ^ q
    else Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
      (PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) a)

theorem kmsSigmaFun_t (r : FreeGroup α) (t x : α) (p q : ℤ) :
    kmsSigmaFun r t x p q t = Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsFalse kmsS := by
  simp only [kmsSigmaFun]
  rw [if_pos trivial]

theorem kmsSigmaFun_x (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    kmsSigmaFun r t x p q x =
      Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
          (PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) x) *
        (Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsFalse kmsS) ^ q := by
  simp only [kmsSigmaFun]
  rw [if_neg hxt, if_pos trivial]

theorem kmsSigmaFun_other (r : FreeGroup α) {t x a : α} (hat : a ≠ t) (hax : a ≠ x) (p q : ℤ) :
    kmsSigmaFun r t x p q a =
      Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
        (PresentedGroup.of (rels := ({r} : Set (FreeGroup α))) a) := by
  simp only [kmsSigmaFun]
  rw [if_neg hat, if_neg hax]

/-- `s ^ p` is the image of `s` under the amalgamation map of the second factor. -/
theorem kmsS_zpow (r : FreeGroup α) (t : α) (p : ℤ) :
    kmsS ^ p = kmsAmPhi r t p kmsFalse kmsS := by
  rw [kmsAmPhi_false, Work.OROneRel.amPhi_false_apply]
  apply ULift.ext
  rw [ULift.pow_down]

/-- **The key computation.**  `kmsSigmaFun` carries the substituted word `ψ w` to the class of `w`
in the first factor. -/
theorem kmsSigma_subst (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) (w : FreeGroup α) :
    FreeGroup.lift (kmsSigmaFun r t x p q) (Work.OROneRel.subst t x p q w) =
      Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
        (PresentedGroup.mk ({r} : Set (FreeGroup α)) w) := by
  have hcomp : (FreeGroup.lift (kmsSigmaFun r t x p q)).comp (Work.OROneRel.subst t x p q) =
      (Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue).comp
        (PresentedGroup.mk ({r} : Set (FreeGroup α))) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply]
    by_cases hat : a = t
    · rw [hat, Work.OROneRel.subst, FreeGroup.lift_apply_of, Work.OROneRel.substFun]
      simp only [if_pos trivial, map_zpow, FreeGroup.lift_apply_of, kmsSigmaFun_t]
      rw [← map_zpow, kmsS_zpow r t p,
        Monoid.PushoutI.of_apply_eq_base (kmsAmPhi r t p) kmsFalse kmsS,
        ← Monoid.PushoutI.of_apply_eq_base (kmsAmPhi r t p) kmsTrue kmsS,
        kmsAmPhi_true, Work.OROneRel.amPhi_true_apply]
      simp only [kmsS]
      rfl
    · by_cases hax : a = x
      · rw [hax, Work.OROneRel.subst, FreeGroup.lift_apply_of, Work.OROneRel.substFun]
        simp only [if_neg hxt, if_pos trivial, map_mul, map_zpow, FreeGroup.lift_apply_of,
          kmsSigmaFun_t, kmsSigmaFun_x r hxt]
        rw [mul_assoc, zpow_neg, mul_inv_cancel, mul_one]
        rfl
      · rw [Work.OROneRel.subst, FreeGroup.lift_apply_of, Work.OROneRel.substFun]
        simp only [if_neg hat, if_neg hax, FreeGroup.lift_apply_of,
          kmsSigmaFun_other r hat hax]
        rfl
  exact DFunLike.congr_fun hcomp w

/-- The homomorphism `⟨α | ψ r⟩ →* Monoid.PushoutI (kmsAmPhi r t p)` induced by `kmsSigmaFun`. -/
noncomputable def kmsSigma (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) :
    PresentedGroup ({Work.OROneRel.subst t x p q r} : Set (FreeGroup α)) →*
      Monoid.PushoutI (kmsAmPhi r t p) :=
  PresentedGroup.toGroup (f := kmsSigmaFun r t x p q)
    (fun y hy => by
      rw [Set.mem_singleton_iff] at hy
      subst hy
      refine MonoidHom.mem_ker.mpr ?_
      rw [kmsSigma_subst r hxt p q r,
        PresentedGroup.one_of_mem (Set.mem_singleton r), map_one])

theorem kmsSigma_mk (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) (w : FreeGroup α) :
    kmsSigma r hxt p q
        (PresentedGroup.mk ({Work.OROneRel.subst t x p q r} : Set (FreeGroup α)) w)
      = FreeGroup.lift (kmsSigmaFun r t x p q) w := rfl

/-- **The defining property of `kmsSigma`.**  It is a left inverse of `substHom` into the first
factor of the amalgam. -/
theorem kmsSigma_substHom (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) (w : FreeGroup α) :
    kmsSigma r hxt p q
        (Work.OROneRel.substHom r t x p q (PresentedGroup.mk ({r} : Set (FreeGroup α)) w))
      = Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
          (PresentedGroup.mk ({r} : Set (FreeGroup α)) w) := by
  rw [Work.OROneRel.substHom_mk, kmsSigma_mk, kmsSigma_subst r hxt p q w]

/-- `kmsSigma` carries the class of a substituted word to the class of the word in the first
factor. -/
theorem kmsSigma_psi_mk (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ) (w : FreeGroup α) :
    kmsSigma r hxt p q
        (PresentedGroup.mk ({Work.OROneRel.subst t x p q r} : Set (FreeGroup α))
          (Work.OROneRel.subst t x p q w))
      = Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
          (PresentedGroup.mk ({r} : Set (FreeGroup α)) w) := by
  rw [kmsSigma_mk, kmsSigma_subst r hxt p q w]

/-- `kmsSigma` commutes with powers of the `substHom`-image of a word. -/
theorem kmsSigma_substHom_pow (r : FreeGroup α) {t x : α} (hxt : x ≠ t) (p q : ℤ)
    (w : FreeGroup α) (k : ℕ) :
    kmsSigma r hxt p q
        ((Work.OROneRel.substHom r t x p q (PresentedGroup.mk ({r} : Set (FreeGroup α)) w)) ^ k)
      = (Monoid.PushoutI.of (φ := kmsAmPhi r t p) kmsTrue
          (PresentedGroup.mk ({r} : Set (FreeGroup α)) w)) ^ k := by
  rw [show kmsSigma r hxt p q
        ((Work.OROneRel.substHom r t x p q (PresentedGroup.mk ({r} : Set (FreeGroup α)) w)) ^ k)
      = (kmsSigma r hxt p q
          (Work.OROneRel.substHom r t x p q
            (PresentedGroup.mk ({r} : Set (FreeGroup α)) w))) ^ k from map_pow _ _ _,
    kmsSigma_substHom r hxt p q w]

/-! ## Injectivity of the amalgamation maps -/

/-- The second amalgamation map `n ↦ s ^ (p n)` is injective for `p ≠ 0`. -/
theorem amPhi_false_injective (r : FreeGroup α) (t : α) {p : ℤ} (hp : p ≠ 0) :
    Function.Injective (Work.OROneRel.amPhi r t p false) := by
  intro n m h
  rw [Work.OROneRel.amPhi_false_apply, Work.OROneRel.amPhi_false_apply] at h
  have h2 : n.down ^ p = m.down ^ p := congrArg ULift.down h
  exact ULift.ext (x := n) (y := m) (zpow_left_injective hp h2)

/-- In `⟨α | u ^ l⟩`, with `u` cyclically reduced involving a generator `x ≠ t`, the class of `t`
has infinite order.  This is the Freiheitssatz for the Magnus subgroup `⟨t⟩`. -/
theorem presentedGroup_of_t_not_isOfFinOrder (u : FreeGroup α) (l : ℕ) (hl : 1 ≤ l) {t x : α}
    (hxt : x ≠ t) (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u)
    (hx : x ∈ Work.OROneRel.relatorLetters u) :
    ¬ IsOfFinOrder (PresentedGroup.of (rels := ({u ^ l} : Set (FreeGroup α))) t) := by
  classical
  have hnot : ¬ Work.OROneRel.SupportedOn u ({t} : Set α) :=
    fun hsub => hxt (by simpa using hsub hx)
  have hf : Function.Injective (Work.OROneRel.presentedGroupMap (u ^ l) ({t} : Set α)) :=
    Work.OROneRel.freiheitssatz_magnusSubgroup_of_not_supported u l hl hcyc hnot
  have hy1 : (FreeGroup.of (⟨t, Set.mem_singleton t⟩ : {a : α // a ∈ ({t} : Set α)})) ≠ 1 :=
    FreeGroup.of_ne_one _
  have hyinf : ¬ IsOfFinOrder
      (FreeGroup.of (⟨t, Set.mem_singleton t⟩ : {a : α // a ∈ ({t} : Set α)})) := by
    rw [isOfFinOrder_iff_pow_eq_one]
    rintro ⟨n, hn, h⟩
    exact absurd ((pow_eq_one_iff_right hy1).mp h) (by omega)
  have hfy : (Work.OROneRel.presentedGroupMap (u ^ l) ({t} : Set α))
      (FreeGroup.of (⟨t, Set.mem_singleton t⟩ : {a : α // a ∈ ({t} : Set α)}))
      = PresentedGroup.of (rels := ({u ^ l} : Set (FreeGroup α))) t := by
    rw [Work.OROneRel.presentedGroupMap, MonoidHom.comp_apply, FreeGroup.lift_apply_of]
    rfl
  rw [← hfy]
  exact fun h => hyinf ((hf.isOfFinOrder_iff).mp h)

/-- The first amalgamation map `n ↦ (mk t) ^ n` is injective. -/
theorem amPhi_true_injective_kms (u : FreeGroup α) (l : ℕ) (hl : 1 ≤ l) {t x : α} (hxt : x ≠ t)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u)
    (hx : x ∈ Work.OROneRel.relatorLetters u) (p : ℤ) :
    Function.Injective (Work.OROneRel.amPhi (u ^ l) t p true) := by
  have hxinf := presentedGroup_of_t_not_isOfFinOrder u l hl hxt hcyc hx
  have hz : Function.Injective
      (fun m : ℤ => (PresentedGroup.of (rels := ({u ^ l} : Set (FreeGroup α))) t) ^ m) :=
    (injective_zpow_iff_not_isOfFinOrder).mpr hxinf
  intro n m h
  rw [Work.OROneRel.amPhi_true_apply, Work.OROneRel.amPhi_true_apply] at h
  exact ULift.ext (x := n) (y := m) (Multiplicative.toAdd.injective (hz h))

/-- Injectivity of the two amalgamation maps of the `ULift`-indexed amalgam. -/
theorem kmsAmPhi_injective (u : FreeGroup α) (l : ℕ) (hl : 1 ≤ l) {t x : α} (hxt : x ≠ t)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u)
    (hx : x ∈ Work.OROneRel.relatorLetters u) (p : ℤ) (hp : p ≠ 0) :
    ∀ i : ULift.{u} Bool, Function.Injective (kmsAmPhi (u ^ l) t p i) := by
  intro i
  obtain ⟨b⟩ := i
  cases b with
  | false => exact amPhi_false_injective (u ^ l) t hp
  | true => exact amPhi_true_injective_kms u l hl hxt hcyc hx p

/-! ## The amalgamated subgroup is torsion-free -/

/-- A non-zero integer power of an element of infinite order has infinite order. -/
theorem zpow_isOfFinOrder_eq_zero {G : Type*} [Group G] {x : G} (hx : ¬ IsOfFinOrder x) {m : ℤ}
    (h : IsOfFinOrder (x ^ m)) : m = 0 := by
  by_contra hm
  obtain ⟨k, hk, hk1⟩ := isOfFinOrder_iff_zpow_eq_one.mp h
  exact hx (isOfFinOrder_iff_zpow_eq_one.mpr
    ⟨m * k, mul_ne_zero hm hk, by rw [zpow_mul]; exact hk1⟩)

/-- The amalgamated subgroup `baseSub` (the image of `⟨t⟩`) is torsion-free: every element of
finite order in it is trivial. -/
theorem kms_baseSub_torsion (u : FreeGroup α) (l : ℕ) (hl : 1 ≤ l) {t x : α} (hxt : x ≠ t)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u)
    (hx : x ∈ Work.OROneRel.relatorLetters u) (p : ℤ) (hp : p ≠ 0)
    {b : Monoid.PushoutI (kmsAmPhi (u ^ l) t p)}
    (hb : b ∈ Work.ORLocInd.FKSKernel.baseSub (kmsAmPhi (u ^ l) t p))
    (hbfin : IsOfFinOrder b) : b = 1 := by
  classical
  have hofinj : Function.Injective
      (Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t p) kmsTrue) :=
    Monoid.PushoutI.of_injective (kmsAmPhi_injective u l hl hxt hcyc hx p hp) kmsTrue
  obtain ⟨n, rfl⟩ := hb
  have hbase_eq : Monoid.PushoutI.base (kmsAmPhi (u ^ l) t p) n
      = Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t p) kmsTrue
          (Work.OROneRel.amPhi (u ^ l) t p true n) := by
    rw [← Monoid.PushoutI.of_apply_eq_base (kmsAmPhi (u ^ l) t p) kmsTrue n, kmsAmPhi_true]
  rw [hbase_eq] at hbfin
  have h1 : IsOfFinOrder (Work.OROneRel.amPhi (u ^ l) t p true n) :=
    (hofinj.isOfFinOrder_iff).mp hbfin
  rw [Work.OROneRel.amPhi_true_apply] at h1
  have h2 : Multiplicative.toAdd n.down = 0 :=
    zpow_isOfFinOrder_eq_zero (presentedGroup_of_t_not_isOfFinOrder u l hl hxt hcyc hx) h1
  rw [hbase_eq, Work.OROneRel.amPhi_true_apply, h2, zpow_zero, map_one]

/-- A finite-order element of the first factor of the amalgam is not conjugate into the
amalgamated subgroup, unless it is trivial. -/
theorem kms_notMem_conj_baseSub (u : FreeGroup α) (l : ℕ) (hl : 1 ≤ l) {t x : α} (hxt : x ≠ t)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u)
    (hx : x ∈ Work.OROneRel.relatorLetters u) (hpx : Work.OROneRel.eps x u ≠ 0)
    {g : PresentedGroup ({u ^ l} : Set (FreeGroup α))} (hg : IsOfFinOrder g) (hg1 : g ≠ 1)
    (d : Monoid.PushoutI (kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u))) :
    Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) kmsTrue g ∉
      (Work.ORLocInd.FKSKernel.baseSub (kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u))).map
        (MulAut.conj d).toMonoidHom := by
  classical
  have hofinj : Function.Injective
      (Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) kmsTrue) :=
    Monoid.PushoutI.of_injective
      (kmsAmPhi_injective u l hl hxt hcyc hx (Work.OROneRel.eps x u) hpx) kmsTrue
  intro hmem
  rw [Subgroup.mem_map] at hmem
  obtain ⟨b, hb, hbd⟩ := hmem
  have hb_eq : b = d⁻¹ *
      Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) kmsTrue g * d := by
    have h := congrArg (fun z => d⁻¹ * z * d) hbd
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h
    have h2 : d⁻¹ * (d * b * d⁻¹) * d = b := by group
    rwa [h2] at h
  have hofg : IsOfFinOrder
      (Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) kmsTrue g) :=
    (hofinj.isOfFinOrder_iff).mpr hg
  have hbfin : IsOfFinOrder b := by
    rw [hb_eq]
    simpa [inv_inv] using
      (isOfFinOrder_conj_iff d⁻¹
        (Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) kmsTrue g)).mpr
        hofg
  have hb1 : b = 1 :=
    kms_baseSub_torsion u l hl hxt hcyc hx (Work.OROneRel.eps x u) hpx hb hbfin
  rw [hb1, map_one] at hbd
  exact hg1 (hofinj (hbd.symm.trans (map_one
    (Monoid.PushoutI.of (φ := kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) kmsTrue)).symm))

/-! ## The main theorem -/

/-- **Transfer of the Karrass--Magnus--Solitar root statement along the Case-2 substitution.**

Let `ψ = subst t x (σ_x u) (σ_t u)`.  The substitution induces
`ι : ⟨α | u ^ l⟩ →* ⟨α | (ψ u) ^ l⟩` with `ι (mk u) = mk (ψ u)`, and `kmsSigma` is a left inverse of
`ι` into the first factor `⟨α | u ^ l⟩` of the amalgam
`⟨α | (ψ u) ^ l⟩ ≅ ⟨α | u ^ l⟩ ∗_{t^n = s^{p n}} ⟨s⟩`.  Hence `KMSRoot (ψ u) l` transfers to
`KMSRoot u l`: the order part because `orderOf (mk u)` is divisible by
`orderOf (ι (mk u)) = l` and divides it by `(mk u) ^ l = 1`, and the torsion part because the
conjugacy `ι g = c (mk (ψ u))^k c⁻¹` pushes forward along `kmsSigma` to a conjugacy of `mk u` and
`(mk u)^k` in the amalgam, where `pushoutI_conj_transfer` (Bass--Serre tree of the star graph,
using that `g ≠ 1` of finite order is not conjugate into the torsion-free amalgamated subgroup)
produces a conjugator in the first factor. -/
theorem kmsRoot_of_subst {α : Type u} (u : FreeGroup α) (l : ℕ) (hl : 1 ≤ l) {t x : α}
    (hxt : x ≠ t) (hcyc : Work.OROneRel.IsCyclicallyReducedRelator u)
    (hx : x ∈ Work.OROneRel.relatorLetters u) (hpx : Work.OROneRel.eps x u ≠ 0)
    (hw : Work.OROneRel.KMSRoot
      (Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u) l) :
    Work.OROneRel.KMSRoot u l := by
  classical
  have hpw : Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)
      = (Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u) ^ l :=
    map_pow _ _ _
  have hset : ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
        : Set (FreeGroup α))
      = {(Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u) ^ l} := by
    rw [hpw]
  refine ⟨?_, ?_⟩
  · -- **the order part**
    have hord₁ : orderOf (PresentedGroup.mk
        ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
          : Set (FreeGroup α))
        (Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u)) = l := by
      rw [hset]
      exact hw.1
    have hdiv : orderOf (PresentedGroup.mk
        ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
          : Set (FreeGroup α))
        (Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u))
        ∣ orderOf (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) := by
      rw [← Work.OROneRel.substHom_mk (u ^ l) t x (Work.OROneRel.eps x u)
        (Work.OROneRel.eps t u) u]
      exact orderOf_map_dvd _ _
    have hdvd1 : orderOf (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) ∣ l := by
      refine orderOf_dvd_of_pow_eq_one ?_
      rw [← map_pow (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α))) u l]
      exact PresentedGroup.one_of_mem (Set.mem_singleton (u ^ l))
    have hl2 : l ∣ orderOf (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u) := by
      conv_lhs => rw [← hord₁]
      exact hdiv
    exact Nat.dvd_antisymm hdvd1 hl2
  · -- **the torsion part**
    intro g hg
    by_cases hg1 : g = 1
    · exact ⟨0, 1, by rw [hg1]; simp⟩
    · have hφ := kmsAmPhi_injective u l hl hxt hcyc hx (Work.OROneRel.eps x u) hpx
      -- restate `hw.2` at the relator `ψ (u ^ l)` actually used by `substHom` and `kmsSigma`
      have htors₁ : ∀ g' : PresentedGroup
            ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
              : Set (FreeGroup α)),
          IsOfFinOrder g' → ∃ k : ℕ, ∃ c : PresentedGroup
            ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
              : Set (FreeGroup α)),
            g' = c * (PresentedGroup.mk
              ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
                : Set (FreeGroup α))
              (Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u)) ^ k
              * c⁻¹ := by
        rw [hset]
        exact hw.2
      obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective ({u ^ l} : Set (FreeGroup α)) g
      have hfin : IsOfFinOrder (Work.OROneRel.substHom (u ^ l) t x (Work.OROneRel.eps x u)
          (Work.OROneRel.eps t u) (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) w)) := by
        obtain ⟨n, hn, hgn⟩ := isOfFinOrder_iff_pow_eq_one.mp hg
        refine isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, ?_⟩
        rw [← map_pow, hgn, map_one]
      obtain ⟨k, c₁, hc₁⟩ := htors₁ _ hfin
      -- rewrite the `k`-th power of `mk (ψ u)` as the `k`-th power of the `substHom`-image
      have hpk : (PresentedGroup.mk
            ({Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) (u ^ l)}
              : Set (FreeGroup α))
            (Work.OROneRel.subst t x (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u)) ^ k
          = (Work.OROneRel.substHom (u ^ l) t x (Work.OROneRel.eps x u)
              (Work.OROneRel.eps t u)
              (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u)) ^ k :=
        congrArg (fun y => y ^ k)
          (Work.OROneRel.substHom_mk (u ^ l) t x (Work.OROneRel.eps x u)
            (Work.OROneRel.eps t u) u).symm
      have hc₁' : Work.OROneRel.substHom (u ^ l) t x (Work.OROneRel.eps x u)
            (Work.OROneRel.eps t u) (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) w)
          = c₁ * (Work.OROneRel.substHom (u ^ l) t x (Work.OROneRel.eps x u)
              (Work.OROneRel.eps t u)
              (PresentedGroup.mk ({u ^ l} : Set (FreeGroup α)) u)) ^ k * c₁⁻¹ := by
        rw [hc₁, hpk]
      -- push the conjugacy forward along `kmsSigma`
      have hconj := congrArg (kmsSigma (u ^ l) hxt (Work.OROneRel.eps x u)
        (Work.OROneRel.eps t u)) hc₁'
      rw [map_mul, map_mul, map_inv] at hconj
      rw [kmsSigma_substHom_pow (u ^ l) hxt (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) u
        k] at hconj
      rw [← map_pow] at hconj
      rw [kmsSigma_substHom (u ^ l) hxt (Work.OROneRel.eps x u) (Work.OROneRel.eps t u) w]
        at hconj
      obtain ⟨d, hd⟩ := Work.OROneRel.pushoutI_conj_transfer
        (kmsAmPhi (u ^ l) t (Work.OROneRel.eps x u)) hφ kmsTrue hconj
        (fun d => kms_notMem_conj_baseSub u l hl hxt hcyc hx hpx hg hg1 d)
      exact ⟨k, d, hd⟩

end Work.OROneRel
