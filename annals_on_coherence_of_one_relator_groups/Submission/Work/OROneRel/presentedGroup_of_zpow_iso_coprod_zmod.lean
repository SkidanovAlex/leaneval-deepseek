import Mathlib
import Submission.Work.OROneRel.Basic

/-!
# `⟨α | x^m⟩ ≅ ℤ/|m| ∗ F(α \ {x})`

For a single generator `x : α` and an integer `m`, the one-relator group `⟨α | x^m⟩` splits as the
free product of the cyclic group `ℤ/|m|` (generated by `x`) with the free group on the remaining
generators.  The proof is a direct generators-and-relations computation: the two maps are built from
the universal properties of `PresentedGroup` and of the free product, and they are inverse on
generators.

The auxiliary facts collected first are

* `Work.OROneRel.zmod_addHom_ext_one` / `zmod_hom_ext_one`: a homomorphism out of the cyclic group
  `Multiplicative (ZMod k)` is determined by its value at the canonical generator
  `Multiplicative.ofAdd 1`;
* `Work.OROneRel.zmodHomOfPowEqOne`: the homomorphism `Multiplicative (ZMod k) →* M` sending the
  canonical generator to an element `g` with `g ^ k = 1`.
-/

universe u

namespace Work.OROneRel

open Multiplicative Additive

/-- Two additive homomorphisms `ZMod k →+ A` that agree at `1` are equal, since `1` generates
`ZMod k` as an additive group. -/
lemma zmod_addHom_ext_one {k : ℕ} {A : Type*} [AddGroup A] {f g : ZMod k →+ A}
    (h : f 1 = g 1) : f = g := by
  ext y
  obtain ⟨z, rfl⟩ := ZMod.intCast_surjective (n := k) y
  rw [show (((z : ℤ) : ZMod k)) = z • (1 : ZMod k) from (zsmul_one z).symm, map_zsmul, map_zsmul, h]

/-- Two group homomorphisms out of the cyclic group `Multiplicative (ZMod k)` that agree on the
canonical generator `Multiplicative.ofAdd 1` are equal. -/
lemma zmod_hom_ext_one {k : ℕ} {M : Type*} [Group M] {f g : Multiplicative (ZMod k) →* M}
    (h : f (Multiplicative.ofAdd 1) = g (Multiplicative.ofAdd 1)) : f = g := by
  apply MonoidHom.toAdditiveRight.injective
  apply zmod_addHom_ext_one
  rw [MonoidHom.coe_toAdditiveRight, MonoidHom.coe_toAdditiveRight]
  simp only [Function.comp_apply]
  rw [h]

/-- The value at `Multiplicative.ofAdd 1` of a homomorphism `Multiplicative (ZMod k) →* M`
obtained from an additive homomorphism `ZMod k →+ Additive M`. -/
lemma toMultiplicativeLeft_zmod_ofAdd_one {M : Type*} [Group M] (k : ℕ)
    (f : ZMod k →+ Additive M) :
    AddMonoidHom.toMultiplicativeLeft f (Multiplicative.ofAdd (1 : ZMod k)) = (f 1).toMul := by
  rw [AddMonoidHom.coe_toMultiplicativeLeft]
  simp only [Function.comp_apply, toAdd_ofAdd]

/-- The homomorphism `Multiplicative (ZMod k) →* M` sending the canonical generator
`Multiplicative.ofAdd 1` to `g`, where `g ^ k = 1`. -/
noncomputable def zmodHomOfPowEqOne {M : Type*} [Group M] (k : ℕ) (g : M) (hk : g ^ k = 1) :
    Multiplicative (ZMod k) →* M :=
  AddMonoidHom.toMultiplicativeLeft (ZMod.lift k ⟨
    { toFun := fun z => z • Additive.ofMul g,
      map_zero' := zero_zsmul _,
      map_add' := fun a b => add_zsmul (Additive.ofMul g) a b }, by
      show (k : ℤ) • (Additive.ofMul g) = 0
      rw [natCast_zsmul, ← ofMul_pow, hk, ofMul_one]⟩)

/-- `zmodHomOfPowEqOne` sends the canonical generator to `g`. -/
lemma zmodHomOfPowEqOne_ofAdd_one {M : Type*} [Group M] (k : ℕ) (g : M) (hk : g ^ k = 1) :
    zmodHomOfPowEqOne k g hk (Multiplicative.ofAdd 1) = g := by
  rw [zmodHomOfPowEqOne, toMultiplicativeLeft_zmod_ofAdd_one]
  rw [show (1 : ZMod k) = ((1 : ℤ) : ZMod k) from Int.cast_one.symm]
  rw [ZMod.lift_coe]
  simp

/-- If `g ^ m = 1` for an integer `m` then also `g ^ m.natAbs = 1`. -/
lemma zpow_natAbs_eq_one {M : Type*} [Group M] (g : M) (m : ℤ) (h : g ^ m = 1) :
    g ^ m.natAbs = 1 := by
  have h' : g ^ (m.natAbs : ℤ) = 1 := by
    by_cases hm : 0 ≤ m
    · rw [Int.natAbs_of_nonneg hm]; exact h
    · have hm' : m < 0 := not_le.mp hm
      rw [show m.natAbs = (-m).natAbs from (Int.natAbs_neg m).symm,
          Int.natAbs_of_nonneg (by omega : (0:ℤ) ≤ -m), zpow_neg, h, inv_one]
  rw [zpow_natCast] at h'
  exact h'

/-- `⟨α | x ^ m⟩ ≅ Multiplicative (ZMod |m|) ∗ F(α \ {x})` for `m ≠ 0`: the one-relator group
`⟨α | x^m⟩` is the free product of the cyclic group generated by `x` with the free group on the
remaining generators. -/
theorem presentedGroup_of_zpow_iso_coprod_zmod {α : Type u} (x : α) (m : ℤ) (hm : m ≠ 0) :
    Nonempty (PresentedGroup ({FreeGroup.of x ^ m} : Set (FreeGroup α)) ≃*
      Monoid.Coprod (Multiplicative (ZMod m.natAbs)) (FreeGroup {a : α // a ≠ x})) := by
  classical
  let G := PresentedGroup ({FreeGroup.of x ^ m} : Set (FreeGroup α))
  let C := Monoid.Coprod (Multiplicative (ZMod m.natAbs)) (FreeGroup {a : α // a ≠ x})
  have hpow : (PresentedGroup.of x : G) ^ m = 1 := by
    rw [show (PresentedGroup.of x : G) = PresentedGroup.mk _ (FreeGroup.of x) from rfl,
      ← map_zpow]
    exact PresentedGroup.one_of_mem (by simp)
  have hkpow : (PresentedGroup.of x : G) ^ m.natAbs = 1 := zpow_natAbs_eq_one _ m hpow
  -- The forward map: on generators, `x ↦ inl (ofAdd 1)` and `a ↦ inr (of a)`.
  let f : α → C := fun a => if h : a = x then Monoid.Coprod.inl (Multiplicative.ofAdd 1)
                            else Monoid.Coprod.inr (FreeGroup.of ⟨a, h⟩)
  have hrel : ∀ r ∈ ({FreeGroup.of x ^ m} : Set (FreeGroup α)), FreeGroup.lift f r = 1 := by
    intro r hr
    rw [Set.mem_singleton_iff] at hr
    subst hr
    rw [map_zpow, FreeGroup.lift_apply_of]
    have hfx : f x = Monoid.Coprod.inl (Multiplicative.ofAdd 1) := by simp [f]
    rw [hfx, ← map_zpow]
    have hcyc : (Multiplicative.ofAdd (1 : ZMod m.natAbs)) ^ m = 1 := by
      rw [← ofAdd_zsmul, zsmul_one]
      have h0 : (m : ZMod m.natAbs) = 0 := by
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        exact Int.natAbs_dvd.mpr (dvd_refl m)
      rw [h0, ofAdd_zero]
    rw [hcyc, map_one]
  let Φ : G →* C := PresentedGroup.toGroup (f := f) hrel
  have hΦ_of (a : α) : Φ (PresentedGroup.of a) = f a :=
    PresentedGroup.toGroup.of (f := f) hrel
  -- The backward map: `inl`-part sends `ofAdd 1 ↦ of x`, `inr`-part is the free-group lift.
  let φ₂ : FreeGroup {a : α // a ≠ x} →* G := FreeGroup.lift (fun b => PresentedGroup.of (b : α))
  let φ₁ : Multiplicative (ZMod m.natAbs) →* G :=
    zmodHomOfPowEqOne (m.natAbs) (PresentedGroup.of x) hkpow
  have hφ₁ : φ₁ (Multiplicative.ofAdd 1) = PresentedGroup.of x :=
    zmodHomOfPowEqOne_ofAdd_one (m.natAbs) (PresentedGroup.of x) hkpow
  let Ψ : C →* G := Monoid.Coprod.lift φ₁ φ₂
  have hΨΦ : Ψ.comp Φ = MonoidHom.id G := by
    apply PresentedGroup.ext
    intro a
    rw [MonoidHom.comp_apply, hΦ_of, MonoidHom.id_apply]
    by_cases ha : a = x
    · rw [ha, show f x = Monoid.Coprod.inl (Multiplicative.ofAdd (1 : ZMod m.natAbs))
          from by simp [f], Monoid.Coprod.lift_apply_inl, hφ₁]
    · rw [show f a = Monoid.Coprod.inr (FreeGroup.of ⟨a, ha⟩) from by simp [f, ha],
        Monoid.Coprod.lift_apply_inr]
      simp [φ₂]
  have hΦΨ : Φ.comp Ψ = MonoidHom.id C := by
    apply Monoid.Coprod.hom_ext
    · rw [MonoidHom.comp_assoc, Monoid.Coprod.lift_comp_inl, MonoidHom.id_comp]
      apply zmod_hom_ext_one
      rw [MonoidHom.comp_apply, hφ₁, hΦ_of]
      simp [f]
    · rw [MonoidHom.comp_assoc, Monoid.Coprod.lift_comp_inr, MonoidHom.id_comp]
      apply FreeGroup.ext_hom
      intro b
      rw [MonoidHom.comp_apply]
      simp only [φ₂, FreeGroup.lift_apply_of]
      rw [hΦ_of]
      simp only [f]
      rw [dif_neg b.2]
  exact ⟨MonoidHom.toMulEquiv Φ Ψ hΨΦ hΦΨ⟩

end Work.OROneRel
