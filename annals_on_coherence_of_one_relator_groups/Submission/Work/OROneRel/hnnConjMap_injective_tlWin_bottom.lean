/-!
# The bottom case of the window climb: the window `[0, p+q-1]` is cyclic

This file proves `Work.OROneRel.hnnConjMap_injective_tlWin_bottom`.  The bottom window
`tlWin p q (p+q-1) = π₁(Y[0,p+q-1])` of the two-letter band is the cyclic group generated by the
cycle word (`Work.OROneRel.tlWin_low_zpowers_lemma`), say `tlWin p q (p+q-1) = ⟨w⟩`.

The head of the argument is the observation that `F₂` is generated by two elements `w` and `σ` of
which `w` spans a cyclic group of weight zero and `σ` has weight one: such a pair can never generate
a cyclic subgroup, hence `K = ⟨w,σ⟩` is a non-cyclic finitely generated subgroup of the free group
`F₂`, i.e. a free group of rank `2` (a free group on `≥ 3` generators is not generated by two
elements, and a free group on `≤ 1` generator is cyclic).  The endomorphism `ψ : a ↦ w`, `b ↦ σ` of
`F₂` therefore corestricts to a surjection `F₂ ↠ K ≅ F₂`, which is injective by Hopficity of `F₂`
(`Work.OROneRel.freeGroup_fin_two_hopfian`).

The comparison map `hnnConjMap ⟨w⟩ σ` is then obtained from `ψ`: the HNN extension of the pair
`(⟨w⟩, σ)` is generated by `of w` and the stable letter `t`
(`Work.OROneRel.hnnExtension_zpowers_closure_eq_top`), so the canonical homomorphism
`Φ : F₂ →* Z` with `a ↦ of w`, `b ↦ t` is *surjective*, and `hnnConjMap ⟨w⟩ σ ∘ Φ = ψ` is
injective.  An injective composite with a surjective first factor forces the middle map to be
injective.

Note.  The docstring of the target suggests instead that `⟨w,σ⟩ = F₂` follows from the
abelianisations generating `ℤ²`; that implication is *false* in general (e.g. `⟨a, b·[a,b]⟩ ≤ F₂`
has abelianisation `ℤ²` but is a proper subgroup), and the statement `⟨w,σ⟩ = F₂` is in fact
**false** for the pair at hand: for `(p,q) = (2,3)` the cycle word is `w = a b a b b` and `σ = b a`
has weight one, while `a ∉ ⟨w,σ⟩` (machine-checked: the Stallings core of `⟨w,σ⟩` has `6` vertices
and rank `2`).  The proof below therefore does *not* use `⟨w,σ⟩ = ⊤`; it uses only that `⟨w,σ⟩` is
free of rank two.
-/

namespace Work.OROneRel

universe u

/-! ## A tool for the weight argument -/

/-- `toAdd` of an integral power in `Multiplicative ℤ` is the product of the exponents. -/
theorem toAdd_zpow_mul (m : Multiplicative ℤ) (i : ℤ) :
    (m ^ i).toAdd = m.toAdd * i := by
  rw [show m = Multiplicative.ofAdd m.toAdd from by simp]
  generalize m.toAdd = a
  simp only [toAdd_zpow, toAdd_ofAdd, Int.zsmul_eq_mul]
  ring

/-! ## The main theorem -/

/-- **The bottom case of the window climb.**  At the bottom window `m₀ = p+q-1` the window graph
`Y[0,p+q-1]` is a single cycle, so `tlWin p q (p+q-1)` is a free group of rank one, i.e. cyclic;
and for any `σ` of weight one the two generate `F₂` (their images generate `ℤ²`, so `⟨u,σ⟩` has rank
two and finite index, and Schreier's formula with rank `2` forces index `1`).  Since the HNN
extension of a *cyclic* vertex group is generated by `of u` and `t`, the criterion
`Work.OROneRel.hnnConjMap_injective_of_two_generated` gives the injectivity.  Beware: the generator
`u` of the cyclic bottom window is *not* `tlU p q = a^p * b^q` (e.g. for `(p,q) = (2,3)` the cycle
word is `a b a b b`, while `a²b³` has walk `0,3,6,4,2,0` leaving `[0,4]`), but it has the same
abelianisation `(p,q)`. -/
theorem hnnConjMap_injective_tlWin_bottom (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hcop : Nat.Coprime p q) {σ : FreeGroup (Fin 2)}
    (hσ : Work.OROneRel.cohom (Work.OROneRel.tlW p q) σ = Multiplicative.ofAdd 1) :
    Function.Injective (Work.OROneRel.hnnConjMap
      (Work.OROneRel.tlWin p q ((p : ℤ) + (q : ℤ) - 1)) σ) := by
  classical
  -- **(B1)** the bottom window is cyclic, generated by `w`
  obtain ⟨w, hw⟩ := Work.OROneRel.tlWin_low_zpowers_lemma p q hp hq hcop
  -- every element of the bottom window has weight `0`
  have hwin : ∀ x ∈ tlWin p q ((p : ℤ) + (q : ℤ) - 1), cohom (tlW p q) x = 1 := by
    intro x hx
    rw [tlWin_eq_loopsInE] at hx
    exact hx.1
  -- **(B2)** `w` has weight zero
  have hχw : cohom (tlW p q) w = 1 := by
    refine hwin w ?_
    rw [hw]
    exact Subgroup.mem_zpowers w
  -- **(B3)** `w ≠ 1`
  have hwne : w ≠ 1 := by
    intro h1
    have hmem : cycWord p q ∈ tlWin p q ((p : ℤ) + (q : ℤ) - 1) :=
      tlLowCyc_cycWord_mem p q hp hq
    rw [hw, h1] at hmem
    have hcyc : cycWord p q = 1 := by simpa using hmem
    have h := cohom_one_cycWord p q
    rw [hcyc, map_one] at h
    have hzero : (0 : ℤ) = ((p + q : ℕ) : ℤ) := by
      simpa using congrArg Multiplicative.toAdd h
    omega
  -- ## Step 1: `K = ⟨w,σ⟩` is not cyclic
  set K : Subgroup (FreeGroup (Fin 2)) :=
    Subgroup.closure ({w, σ} : Set (FreeGroup (Fin 2))) with hKdef
  have hwK : w ∈ K := hKdef ▸ Subgroup.subset_closure (by simp)
  have hsK : σ ∈ K := hKdef ▸ Subgroup.subset_closure (by simp)
  have hKnot : ∀ ξ : FreeGroup (Fin 2), K ≠ Subgroup.zpowers ξ := by
    intro ξ hξ
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp (hξ ▸ hwK)
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (hξ ▸ hsK)
    -- apply the weight `χ = cohom (tlW p q)`
    set m : ℤ := (cohom (tlW p q) ξ).toAdd with hm
    have hξm : cohom (tlW p q) ξ = Multiplicative.ofAdd m := by
      rw [hm]
      simp
    have hmi : m * i = 0 := by
      have h1 : (cohom (tlW p q) ξ) ^ i = 1 := by rw [← map_zpow, hi, hχw]
      have h3 := congrArg Multiplicative.toAdd h1
      rw [hξm] at h3
      rw [toAdd_zpow_mul] at h3
      rw [show (1 : Multiplicative ℤ) = Multiplicative.ofAdd 0 from by simp] at h3
      simpa using h3
    have hmj : m * j = 1 := by
      have h1 : (cohom (tlW p q) ξ) ^ j = Multiplicative.ofAdd 1 := by
        rw [← map_zpow, hj, hσ]
      have h3 := congrArg Multiplicative.toAdd h1
      rw [hξm] at h3
      rw [toAdd_zpow_mul] at h3
      simpa using h3
    have hm0 : m ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hmj
      exact zero_ne_one hmj
    have hi0 : i = 0 := by
      rcases mul_eq_zero.mp hmi with h | h
      · exact absurd h hm0
      · exact h
    rw [hi0, zpow_zero] at hi
    exact hwne hi.symm
  -- ## Step 2: the free basis of `K` has exactly two elements
  -- `K` is generated by two elements
  have h2genK : (⊤ : Subgroup ↥K) =
      Subgroup.closure ({⟨w, hwK⟩, ⟨σ, hsK⟩} : Set ↥K) := by
    rw [← Subgroup.closure_closure_coe_preimage (k := ({w, σ} : Set (FreeGroup (Fin 2))))]
    congr 1
    ext x
    simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro (h | h)
      · exact Or.inl (Subtype.ext h)
      · exact Or.inr (Subtype.ext h)
    · rintro (h | h)
      · exact Or.inl (congrArg Subtype.val h)
      · exact Or.inr (congrArg Subtype.val h)
  -- so `FreeGroup (Generators ↥K)` is generated by two elements
  have h2genFree : ∃ g₁ g₂ : FreeGroup (IsFreeGroup.Generators ↥K),
      (⊤ : Subgroup (FreeGroup (IsFreeGroup.Generators ↥K))) =
        Subgroup.closure ({g₁, g₂} : Set (FreeGroup (IsFreeGroup.Generators ↥K))) := by
    refine ⟨(IsFreeGroup.mulEquiv ↥K).symm.toMonoidHom ⟨w, hwK⟩,
      (IsFreeGroup.mulEquiv ↥K).symm.toMonoidHom ⟨σ, hsK⟩, ?_⟩
    have hmap : (Subgroup.closure ({⟨w, hwK⟩, ⟨σ, hsK⟩} : Set ↥K)).map
        (IsFreeGroup.mulEquiv ↥K).symm.toMonoidHom = ⊤ := by
      rw [← h2genK,
        Subgroup.map_top_of_surjective _ (IsFreeGroup.mulEquiv ↥K).symm.surjective]
    rw [← hmap, MonoidHom.map_closure, Set.image_pair]
  -- the basis has at most two elements, and at least two
  have hιle2 : ∀ x y z : IsFreeGroup.Generators ↥K, x = y ∨ x = z ∨ y = z := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨x, y, z, hxy, hxz, hyz⟩ := hcon
    exact not_two_generated_freeGroup_of_three_gens x y z hxy hxz hyz h2genFree
  have hιge2 : ∃ a b : IsFreeGroup.Generators ↥K, a ≠ b := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨ξ, hξ⟩ := freeGroup_cyclic_of_subsingleton hcon
    -- every element of `K` is a power of `(IsFreeGroup.mulEquiv ↥K) ξ`
    have hcyc : ∀ x ∈ K, ∃ n : ℤ,
        (((IsFreeGroup.mulEquiv ↥K) ξ : ↥K) : FreeGroup (Fin 2)) ^ n = x := by
      intro x hx
      have hmem : (IsFreeGroup.mulEquiv ↥K).symm (⟨x, hx⟩ : ↥K) ∈ Subgroup.zpowers ξ := by
        rw [← hξ]
        trivial
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hmem
      refine ⟨n, ?_⟩
      have h2 := congrArg (fun y : FreeGroup (IsFreeGroup.Generators ↥K) =>
        (IsFreeGroup.mulEquiv ↥K) y) hn
      rw [map_zpow, MulEquiv.apply_symm_apply] at h2
      have h3 := congrArg (fun y : ↥K => (y : FreeGroup (Fin 2))) h2
      simpa using h3
    refine hKnot (((IsFreeGroup.mulEquiv ↥K) ξ : ↥K) : FreeGroup (Fin 2)) ?_
    refine le_antisymm ?_ (Subgroup.zpowers_le.mpr ((IsFreeGroup.mulEquiv ↥K) ξ).2)
    intro x hx
    obtain ⟨n, hn⟩ := hcyc x hx
    exact Subgroup.mem_zpowers_iff.mpr ⟨n, hn⟩
  obtain ⟨a, b, hab⟩ := hιge2
  obtain ⟨eι⟩ := nonempty_equiv_fin_two_of_forall_eq_or hιle2 a b hab
  -- ## Step 3: `K ≅ F₂`, so `ψ` is injective
  let ee : FreeGroup (IsFreeGroup.Generators ↥K) ≃* ↥K := IsFreeGroup.mulEquiv ↥K
  let e2 : ↥K ≃* FreeGroup (Fin 2) := ee.symm.trans (FreeGroup.freeGroupCongr eι)
  let ψ : FreeGroup (Fin 2) →* FreeGroup (Fin 2) :=
    FreeGroup.lift (fun i : Fin 2 => if i = 0 then w else σ)
  let ψK : FreeGroup (Fin 2) →* ↥K :=
    FreeGroup.lift (fun i : Fin 2 => if i = 0 then ⟨w, hwK⟩ else ⟨σ, hsK⟩)
  have hψK_range : ψK.range = Subgroup.closure ({⟨w, hwK⟩, ⟨σ, hsK⟩} : Set ↥K) := by
    rw [FreeGroup.range_lift_eq_closure]
    congr 1
    ext x
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (h | h)
      · exact ⟨0, by rw [← h]; simp⟩
      · exact ⟨1, by rw [← h]; simp⟩
  have hψK_surj : Function.Surjective ψK := by
    rw [← MonoidHom.range_eq_top, hψK_range, ← h2genK]
  have hsub : K.subtype.comp ψK = ψ := by
    refine FreeGroup.ext_hom _ _ (fun i => ?_)
    fin_cases i <;> simp [ψ, ψK]
  have hψK_coe : ∀ z : FreeGroup (Fin 2), (ψK z : FreeGroup (Fin 2)) = ψ z :=
    fun z => congrArg (fun f : FreeGroup (Fin 2) →* FreeGroup (Fin 2) => f z) hsub
  have hψ_inj : Function.Injective ψ := by
    have hsurj : Function.Surjective (e2.toMonoidHom.comp ψK) := e2.surjective.comp hψK_surj
    have hinj : Function.Injective (e2.toMonoidHom.comp ψK) :=
      freeGroup_fin_two_hopfian _ hsurj
    intro x y hxy
    have h1 : ψK x = ψK y := Subtype.ext (by rw [hψK_coe, hψK_coe]; exact hxy)
    exact hinj (by rw [MonoidHom.comp_apply, MonoidHom.comp_apply, h1])
  -- ## Step 4: `hnnConjMap` is injective because `ψ` is
  rw [hw]
  let Φ : FreeGroup (Fin 2) →* HNNExtension ↥(Subgroup.zpowers w)
      ((hnnEdgeA (Subgroup.zpowers w) σ).subgroupOf (Subgroup.zpowers w))
      ((hnnEdgeB (Subgroup.zpowers w) σ).subgroupOf (Subgroup.zpowers w))
      (hnnConjEquiv (Subgroup.zpowers w) σ) :=
    FreeGroup.lift (fun i : Fin 2 =>
      if i = 0 then HNNExtension.of (⟨w, Subgroup.mem_zpowers w⟩ : ↥(Subgroup.zpowers w))
      else HNNExtension.t)
  have hΦ_surj : Function.Surjective Φ := by
    rw [← MonoidHom.range_eq_top]
    have htop := hnnExtension_zpowers_closure_eq_top w σ (Subgroup.mem_zpowers w)
    refine le_antisymm le_top ?_
    rw [← htop, Subgroup.closure_le]
    rintro x (hx | hx)
    · rw [hx]
      exact ⟨FreeGroup.of 0, by simp [Φ]⟩
    · rw [hx]
      exact ⟨FreeGroup.of 1, by simp [Φ]⟩
  have hcomp : (hnnConjMap (Subgroup.zpowers w) σ).comp Φ = ψ := by
    refine FreeGroup.ext_hom _ _ (fun i => ?_)
    fin_cases i <;> simp [ψ, Φ]
  have hcomp_apply : ∀ z : FreeGroup (Fin 2), hnnConjMap (Subgroup.zpowers w) σ (Φ z) = ψ z :=
    fun z => congrArg (fun f : FreeGroup (Fin 2) →* FreeGroup (Fin 2) => f z) hcomp
  intro x y hxy
  obtain ⟨x', rfl⟩ := hΦ_surj x
  obtain ⟨y', rfl⟩ := hΦ_surj y
  have h : ψ x' = ψ y' := by
    rw [← hcomp_apply x', ← hcomp_apply y']
    exact hxy
  rw [hψ_inj h]

end Work.OROneRel
