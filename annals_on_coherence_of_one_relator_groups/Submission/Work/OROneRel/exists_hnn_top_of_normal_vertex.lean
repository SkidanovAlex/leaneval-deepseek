import Mathlib

namespace Work.OROneRel

/-- **The trivial-associated-subgroup vertex of a one-relator group is an HNN extension.**

Let `K ◁ G` and `t ∈ G` with `G = ⟨K, t⟩` and `tᵐ ∉ K` for every `m ≠ 0`.  Then conjugation by
`t` restricts to an automorphism of `K`, alias `φ` on the top subgroup of `↥K`, and the canonical
map `HNNExtension ↥K ⊤ ⊤ φ →* G` (the base embedded identically, the stable letter sent to `t`) is
a bijection: the HNN extension with both associated subgroups equal to the whole base group is the
"maximal" group generated by `K` and a letter `t'` with `t' a t'⁻¹ = t a t⁻¹` for `a ∈ K`, and the
hypothesis `t ^ m ∉ K` for `m ≠ 0` is exactly what forces `G` to realise it faithfully.

Injectivity needs no Britton's lemma: because both associated subgroups are the whole base group,
every element of the HNN extension is of the form `of k * t ^ n`, so an element mapping to `1` in
`G` forces `k = t ^ (-n) ∈ K`, hence `n = 0` and `k = 1`. -/
theorem exists_hnn_top_of_normal_vertex {G : Type*} [Group G] (K : Subgroup G) (hK : K.Normal) (t : G)
    (hgen : Subgroup.closure ((K : Set G) ∪ {t}) = ⊤)
    (ht : ∀ m : ℤ, m ≠ 0 → t ^ m ∉ K) :
    ∃ (φ : (⊤ : Subgroup ↥K) ≃* (⊤ : Subgroup ↥K)),
      (∀ a : ↥K,
        (((φ ⟨a, Subgroup.mem_top a⟩ : ↥(⊤ : Subgroup ↥K)) : ↥K) : G) = t * (a : G) * t⁻¹) ∧
      Nonempty (HNNExtension ↥K ⊤ ⊤ φ ≃* G) := by
  -- ### the automorphism of `K` given by conjugation by `t`
  let φ : (⊤ : Subgroup ↥K) ≃* (⊤ : Subgroup ↥K) :=
  { toFun := fun a => ⟨⟨t * ((a : ↥K) : G) * t⁻¹, hK.conj_mem _ (a : ↥K).property t⟩, Subgroup.mem_top _⟩
    invFun := fun a => ⟨⟨t⁻¹ * ((a : ↥K) : G) * t,
      by simpa using hK.conj_mem _ (a : ↥K).property t⁻¹⟩, Subgroup.mem_top _⟩
    left_inv := by intro a; ext; group
    right_inv := by intro a; ext; group
    map_mul' := by intro a b; ext; simp [mul_assoc] }
  have hφ : ∀ a : ↥K,
      (((φ ⟨a, Subgroup.mem_top a⟩ : ↥(⊤ : Subgroup ↥K)) : ↥K) : G) = t * (a : G) * t⁻¹ :=
    fun a => rfl
  refine ⟨φ, hφ, ?_⟩
  -- ### the canonical comparison map `HNNExtension ↥K ⊤ ⊤ φ →* G`
  have hcompat : ∀ a : ↥(⊤ : Subgroup ↥K),
      t * (Subgroup.subtype K) ↑a = (Subgroup.subtype K) ↑(φ a) * t := by
    intro a
    change t * ((a : ↥K) : G) = (t * ((a : ↥K) : G) * t⁻¹) * t
    group
  let π : HNNExtension ↥K ⊤ ⊤ φ →* G := HNNExtension.lift (Subgroup.subtype K) t hcompat
  have hπ_of : ∀ k : ↥K, π (HNNExtension.of k) = (k : G) :=
    fun k => HNNExtension.lift_of (Subgroup.subtype K) t hcompat k
  have hπ_t : π HNNExtension.t = t := HNNExtension.lift_t (Subgroup.subtype K) t hcompat
  -- ### surjectivity, from `G = ⟨K, t⟩`
  have hsurj : Function.Surjective π := by
    rw [← MonoidHom.range_eq_top]
    have hle : Subgroup.closure ((K : Set G) ∪ {t}) ≤ π.range := by
      refine (Subgroup.closure_le π.range).mpr ?_
      rintro x (hx | hx)
      · exact MonoidHom.mem_range.mpr ⟨HNNExtension.of ⟨x, hx⟩, hπ_of ⟨x, hx⟩⟩
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact MonoidHom.mem_range.mpr ⟨HNNExtension.t, hπ_t⟩
    rw [hgen] at hle
    exact le_antisymm le_top hle
  -- ### normal form: every element is `of k * t ^ n`
  have key : ∀ x : HNNExtension ↥K ⊤ ⊤ φ,
      ∃ (k : ↥K) (n : ℤ), x = HNNExtension.of k * HNNExtension.t ^ n := by
    -- conjugation by an arbitrary power of the stable letter stays inside the base
    have keyConj : ∀ (n : ℤ) (k : ↥K), ∃ k' : ↥K,
        HNNExtension.t ^ n * (HNNExtension.of k : HNNExtension ↥K ⊤ ⊤ φ) * HNNExtension.t ^ (-n)
          = HNNExtension.of k' := by
      intro n
      induction n using Int.induction_on with
      | zero => intro k; exact ⟨k, by simp⟩
      | succ i ih =>
          intro k
          obtain ⟨k', hk'⟩ := ih k
          refine ⟨((φ ⟨k', Subgroup.mem_top k'⟩) : ↥K), ?_⟩
          calc HNNExtension.t ^ ((i : ℤ) + 1) *
                  (HNNExtension.of k : HNNExtension ↥K ⊤ ⊤ φ) * HNNExtension.t ^ (-((i : ℤ) + 1))
              = HNNExtension.t * (HNNExtension.t ^ (i : ℤ) * HNNExtension.of k *
                  HNNExtension.t ^ (-(i : ℤ))) * HNNExtension.t⁻¹ := by group
            _ = HNNExtension.t * HNNExtension.of k' * HNNExtension.t⁻¹ := by rw [hk']
            _ = HNNExtension.of ((φ ⟨k', Subgroup.mem_top k'⟩) : ↥K) :=
                  (HNNExtension.equiv_eq_conj (φ := φ) ⟨k', Subgroup.mem_top k'⟩).symm
      | pred i ih =>
          intro k
          obtain ⟨k', hk'⟩ := ih k
          have hk'' : HNNExtension.t ^ (-(i : ℤ)) *
              (HNNExtension.of k : HNNExtension ↥K ⊤ ⊤ φ) * HNNExtension.t ^ (i : ℤ)
                = HNNExtension.of k' := by
            rw [neg_neg] at hk'; exact hk'
          refine ⟨((φ.symm ⟨k', Subgroup.mem_top k'⟩) : ↥K), ?_⟩
          calc HNNExtension.t ^ (-(i : ℤ) - 1) * HNNExtension.of k *
                  HNNExtension.t ^ (-(-(i : ℤ) - 1))
              = HNNExtension.t⁻¹ * (HNNExtension.t ^ (-(i : ℤ)) * HNNExtension.of k *
                  HNNExtension.t ^ (i : ℤ)) * HNNExtension.t := by group
            _ = HNNExtension.t⁻¹ * HNNExtension.of k' * HNNExtension.t := by rw [hk'']
            _ = HNNExtension.of ((φ.symm ⟨k', Subgroup.mem_top k'⟩) : ↥K) :=
                  (HNNExtension.equiv_symm_eq_conj (φ := φ) ⟨k', Subgroup.mem_top k'⟩).symm
    intro x
    refine HNNExtension.induction_on x ?_ ?_ ?_ ?_
    · intro g
      exact ⟨g, 0, by simp⟩
    · exact ⟨1, 1, by simp⟩
    · intro x y hx hy
      obtain ⟨k, n, rfl⟩ := hx
      obtain ⟨k', m, rfl⟩ := hy
      obtain ⟨k'', hk''⟩ := keyConj n k'
      refine ⟨k * k'', n + m, ?_⟩
      rw [map_mul, ← hk'']
      group
    · intro x hx
      obtain ⟨k, n, rfl⟩ := hx
      obtain ⟨k'', hk''⟩ := keyConj (-n) k⁻¹
      refine ⟨k'', -n, ?_⟩
      have h1 : ((HNNExtension.of k * HNNExtension.t ^ n : HNNExtension ↥K ⊤ ⊤ φ))⁻¹
          = HNNExtension.t ^ (-n) * HNNExtension.of k⁻¹ := by
        rw [mul_inv_rev, map_inv]; group
      rw [h1, ← hk'']
      group
  -- ### injectivity, from the (HNN) normal form and `t ^ m ∉ K` for `m ≠ 0`
  have hinj : Function.Injective π := by
    intro x y hxy
    obtain ⟨k, n, rfl⟩ := key x
    obtain ⟨k', m, rfl⟩ := key y
    have hπk : ∀ (k : ↥K) (n : ℤ),
        π (HNNExtension.of k * HNNExtension.t ^ n) = (k : G) * t ^ n := by
      intro k n; rw [map_mul, map_zpow, hπ_of, hπ_t]
    have hxy' : (k : G) * t ^ n = (k' : G) * t ^ m := by
      rw [hπk k n, hπk k' m] at hxy; exact hxy
    have hnm : n = m := by
      by_contra hne
      have hmem : t ^ (n - m) ∈ K := by
        have h4 : t ^ (n - m) = ((k⁻¹ * k' : ↥K) : G) := by
          have h5 : (k : G)⁻¹ * (k' : G) = t ^ (n - m) := by
            calc (k : G)⁻¹ * (k' : G)
                = (k : G)⁻¹ * ((k' : G) * t ^ m) * t ^ (-m) := by group
              _ = (k : G)⁻¹ * ((k : G) * t ^ n) * t ^ (-m) := by rw [hxy']
              _ = t ^ (n - m) := by group
          rw [← h5]; simp
        rw [h4]; exact (k⁻¹ * k').property
      exact ht (n - m) (sub_ne_zero.mpr hne) hmem
    subst hnm
    have hkk : k = k' := by
      exact Subtype.ext (mul_right_cancel hxy')
    subst hkk
    rfl
  exact ⟨MulEquiv.ofBijective π ⟨hinj, hsurj⟩⟩

end Work.OROneRel
