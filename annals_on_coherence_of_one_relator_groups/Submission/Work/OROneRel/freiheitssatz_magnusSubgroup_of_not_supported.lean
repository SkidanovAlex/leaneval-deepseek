import Mathlib
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.OROneRel.letters_closure_iff
import Submission.Work.OROneRel.isCyclicallyReducedRelator_pow

namespace Work.OROneRel

universe u

/-- A positive power of a nontrivial cyclically reduced relator uses at least the generators of the
relator: for `k ≥ 1` the reduced word of `v ^ k` is the concatenation of `k` copies of the reduced
word of `v`, so no letter of `v` can disappear.

(For general `n` the inclusion `relatorLetters (v ^ n) ⊆ relatorLetters v` is the one that holds;
the point here is that `k ≥ 1` gives the reverse inclusion, which is what the Freiheitssatz needs to
see that `v ^ k` still involves a generator outside the Magnus generating set `S`.) -/
theorem relatorLetters_subset_pow {β : Type u} {v : FreeGroup β}
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator v) {k : ℕ} (hk : 1 ≤ k) :
    Work.OROneRel.relatorLetters v ⊆ Work.OROneRel.relatorLetters (v ^ k) := by
  classical
  intro a ha
  simp only [relatorLetters] at ha ⊢
  obtain ⟨b, hb⟩ := ha
  exact ⟨b, by
    rw [FreeGroup.toWord_pow, (hcyc.flatten_replicate k).isReduced.reduce_eq]
    exact List.mem_flatten.mpr ⟨v.toWord, List.mem_replicate.mpr ⟨by omega, rfl⟩, hb⟩⟩

/-- **The Freiheitssatz for Magnus subgroups of `⟨β | v ^ k⟩`.**

If `v` is cyclically reduced and involves a generator outside `S`, then the canonical map
`F(S) →* ⟨β | v ^ k⟩` is injective for every `k ≥ 1`: the relator `v ^ k` of the one-relator
presentation still involves that generator, hence is not generated by `S`, and the Freiheitssatz
(`freiheitssatz_at`) applies. -/
theorem freiheitssatz_magnusSubgroup_of_not_supported {β : Type u} (v : FreeGroup β) (k : ℕ)
    (hk : 1 ≤ k) (hcyc : Work.OROneRel.IsCyclicallyReducedRelator v) {S : Set β}
    (h : ¬ Work.OROneRel.SupportedOn v S) :
    Function.Injective (Work.OROneRel.presentedGroupMap (v ^ k) S) := by
  classical
  have hnot : ¬ SupportedOn (v ^ k) S := by
    intro hsub
    exact h fun a ha => hsub (relatorLetters_subset_pow hcyc hk ha)
  have hmem : v ^ k ∉ Subgroup.closure (FreeGroup.of '' S) :=
    fun hc => hnot ((letters_closure_iff (v ^ k) S).mp hc)
  exact (freiheitssatz_at (v ^ k)) (isCyclicallyReducedRelator_pow hcyc k) S hmem

end Work.OROneRel
