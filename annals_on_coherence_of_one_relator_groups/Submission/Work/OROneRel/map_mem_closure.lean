import Mathlib

/-!
# A subgroup of a free group generated by the letters of a set

If `f : α → β` is a map of alphabets whose image lies in a set `S ⊆ β`, then the induced map
`FreeGroup.map f : F α →* F β` sends `F α` into the subgroup of `F β` generated by the letters of
`S`.  This is the formalisation of "a map of graphs that lands in a subgraph induces a map of
fundamental groups", and is the tool that converts a vertex (window) statement into a statement
about the edge group of the level graph.
-/

namespace Work.OROneRel

/-- **A homomorphism of free groups lands in the subgroup generated by the letters of a
subgraph.** -/
theorem map_mem_closure_of {α β : Type*} (f : α → β) (S : Set β) (h : ∀ a, f a ∈ S)
    (x : FreeGroup α) :
    FreeGroup.map f x ∈ Subgroup.closure (FreeGroup.of '' S) := by
  induction x using FreeGroup.induction_on with
  | one => exact Subgroup.one_mem _
  | of a =>
    rw [FreeGroup.map.of]
    exact Subgroup.subset_closure ⟨f a, h a, rfl⟩
  | inv_of a iha => simpa only [map_inv] using Subgroup.inv_mem _ iha
  | mul a b iha ihb => simpa only [map_mul] using Subgroup.mul_mem _ iha ihb

end Work.OROneRel
