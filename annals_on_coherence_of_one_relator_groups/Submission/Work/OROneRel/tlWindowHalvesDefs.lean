Copyright: subproject `OROneRel` -- one-relator combinatorics.

# The two halves of the band vertex of the two-letter relator `a ^ p * b ^ q`

This file sets up the vocabulary of the *descent argument* for the two-letter band splitting
(see `Submission/Work/OROneRel/NOTES_twoLetter_hnnConjMap_routes.md`, §10): the band vertex

  `tlH = (winRho Wt (tlW p q) 0 (p*q)).range ≤ F₂`

(`= π₁` of the band `D = winE (tlW p q) 0 (p*q)`), its deck translates

  `tlHk k = τ^k · tlH · τ^{-k}`   (`= π₁` of the translated band `τ^k · D`, transported to the
  basepoint `0`),

the two halves

  `tlPle c = ⟨tlHk k : k ≤ c⟩`,   `tlPge c = ⟨tlHk k : c ≤ k⟩`,

and the gates

  `tlAk c = tlHk c ⊓ tlHk (c+1)`   (`= π₁ (D ∩ τ · D)`, transported).

The single mathematical input of the descent argument is the **intersection formula**

  **(INT)**   `tlPle c ⊓ tlPge (c+1) = tlAk c`   for all `c : ℤ`,

i.e. *a loop of the `ℤ`-cover of the two-petal rose that lies both in the lower half `(-∞, c+pq]`
and in the upper half `[c+1, ∞)` lies in the intersection `[c+1, c+pq]`* — Mayer--Vietoris for the
two halves.  It is a statement about `π₁` of the cover and is *not* equivalent to the splitting
target; it is delegated as `Work.OROneRel.tlHalves_inter`.
-/
import Mathlib
import Submission.Work.OROneRel.twoLetterTlDefs
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.OROneRel.twoLetter_generation
import Submission.Work.OROneRel.winAssembly
import Submission.Work.OROneRel.twoLetter_F2_generation

namespace Work.OROneRel

/-- **The band vertex**: `π₁` of the band window `[0, p*q]` of the two-letter weight `tlW p q`,
i.e. the range of the class map of the window. -/
noncomputable abbrev tlH (p q : ℕ) (Wt : ℤ → FreeGroup (Fin 2)) : Subgroup (FreeGroup (Fin 2)) :=
  (winRho Wt (tlW p q) 0 ((p : ℤ) * (q : ℤ))).range

/-- **The translated band vertices** `tlHk k = τ ^ k · tlH · τ⁻ᵏ`, where `τ = tlLowTau p q` is the
low deck element of the band.  These are the vertex groups of the line of band domains. -/
noncomputable def tlHk (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (k : ℤ) : Subgroup (FreeGroup (Fin 2)) :=
  (tlH p q Wt).map (MulAut.conj ((tlLowTau p q hp hq hcop) ^ k))

/-- The underlying set of `tlHk k`. -/
noncomputable def tlHkSet (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (k : ℤ) : Set (FreeGroup (Fin 2)) :=
  tlHk p q hp hq hcop Wt k

/-- **The lower half** `tlPle c = ⟨tlHk k : k ≤ c⟩`: the subgroup generated by the band vertices of
levels at most `c`. -/
noncomputable def tlPle (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) : Subgroup (FreeGroup (Fin 2)) :=
  Subgroup.closure {x : FreeGroup (Fin 2) | ∃ k : ℤ, k ≤ c ∧ x ∈ tlHk p q hp hq hcop Wt k}

/-- **The upper half** `tlPge c = ⟨tlHk k : c ≤ k⟩`. -/
noncomputable def tlPge (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) : Subgroup (FreeGroup (Fin 2)) :=
  Subgroup.closure {x : FreeGroup (Fin 2) | ∃ k : ℤ, c ≤ k ∧ x ∈ tlHk p q hp hq hcop Wt k}

/-- **The gate** `tlAk c = tlHk c ⊓ tlHk (c+1)`, the intersection of two consecutive translated band
vertices (`= π₁` of the intersection of the two corresponding band domains). -/
noncomputable def tlAk (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) : Subgroup (FreeGroup (Fin 2)) :=
  tlHk p q hp hq hcop Wt c ⊓ tlHk p q hp hq hcop Wt (c + 1)

/-! ## Elementary monotonicities -/

theorem tlHk_le_tlPle (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) {k c : ℤ} (h : k ≤ c) :
    tlHk p q hp hq hcop Wt k ≤ tlPle p q hp hq hcop Wt c :=
  fun x hx => Subgroup.subset_closure ⟨k, h, hx⟩

theorem tlHk_le_tlPge (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) {c k : ℤ} (h : c ≤ k) :
    tlHk p q hp hq hcop Wt k ≤ tlPge p q hp hq hcop Wt c :=
  fun x hx => Subgroup.subset_closure ⟨k, h, hx⟩

theorem tlPle_mono (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) {c c' : ℤ} (h : c ≤ c') :
    tlPle p q hp hq hcop Wt c ≤ tlPle p q hp hq hcop Wt c' := by
  refine (Subgroup.closure_le (K := tlPle p q hp hq hcop Wt c')).mpr ?_
  rintro x ⟨k, hk, hx⟩
  exact Subgroup.subset_closure ⟨k, le_trans hk h, hx⟩

theorem tlPge_anti (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) {c c' : ℤ} (h : c ≤ c') :
    tlPge p q hp hq hcop Wt c' ≤ tlPge p q hp hq hcop Wt c := by
  refine (Subgroup.closure_le (K := tlPge p q hp hq hcop Wt c)).mpr ?_
  rintro x ⟨k, hk, hx⟩
  exact Subgroup.subset_closure ⟨k, le_trans h hk, hx⟩

theorem tlAk_le_tlHk_left (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) :
    tlAk p q hp hq hcop Wt c ≤ tlHk p q hp hq hcop Wt c :=
  inf_le_left

theorem tlAk_le_tlHk_right (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) :
    tlAk p q hp hq hcop Wt c ≤ tlHk p q hp hq hcop Wt (c + 1) :=
  inf_le_right

/-- The gate at level `c` lies in the lower half at level `c`. -/
theorem tlAk_le_tlPle (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) :
    tlAk p q hp hq hcop Wt c ≤ tlPle p q hp hq hcop Wt c :=
  le_trans (tlAk_le_tlHk_left p q hp hq hcop Wt c)
    (tlHk_le_tlPle p q hp hq hcop Wt le_rfl)

/-- The gate at level `c` lies in the upper half at level `c + 1`. -/
theorem tlAk_le_tlPge (p q : ℕ) (hp : 1 ≤ p) (hq : 1 ≤ q) (hcop : Nat.Coprime p q)
    (Wt : ℤ → FreeGroup (Fin 2)) (c : ℤ) :
    tlAk p q hp hq hcop Wt c ≤ tlPge p q hp hq hcop Wt (c + 1) :=
  le_trans (tlAk_le_tlHk_right p q hp hq hcop Wt c)
    (tlHk_le_tlPge p q hp hq hcop Wt le_rfl)

end Work.OROneRel
