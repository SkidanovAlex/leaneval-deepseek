import Mathlib
import Submission.Work.OROneRel.MMAssembly
import Submission.Work.OROneRel.hnnKernelForm
import Submission.Work.OROneRel.hnnExtension_iso_of_baseMulEquiv
import Submission.Work.OROneRel.FreiheitssatzUnconditional

/-!
# The Magnus--Moldavanskii step from a free kernel, with the free structure given abstractly

`Work.OROneRel.hnnKernelForm` writes a one-relator group `G = ⟨α | r⟩` with a surjection
`φ : G →* Multiplicative ℤ` (with `φ t = ofAdd 1`, `G = ⟨ker φ, t⟩`) as the HNN extension
`HNNExtension ↥H ⊤ ⊤ (conj t)` of the subgroup `H = ker φ`.  When `H` is *free*, that vertex can be
re-presented by the terminal one-relator group `⟨β | of y⟩` and `HasMMStepData r` follows.  The
existing assembly `Work.OROneRel.hasMMStepData_of_freeKernel` takes the freedom of `H` in the form
of an isomorphism `PresentedGroup {of y} ≃* ↥H`; here we accept the more natural hypothesis
`FreeGroup γ ≃* ↥H` and manufacture the one-relator presentation of the vertex ourselves:

* `presentedGroup_optionNone_equiv_freeGroup`: the group presented by the single relation
  `of none = 1` on the generators `Option γ` is the free group `F(γ)`.  (Both maps are exhibited on
  generators: the one killing `none` and fixing the rest, and the one sending `some b ↦ of b`.)
* `isMagnusSubgroup_top_presentedGroup_single`: `⊤` is a Magnus subgroup of the terminal one-relator
  group `⟨β | of y⟩` (the relator is not generated by the other generators, while the other
  generators already generate the whole group since `of y = 1` in it).
* `hasMMStepData_of_freeVertex_free`: the free-vertex assembly
  `HNNExtension ↥H ⊤ ⊤ ψ ≅ ⟨α | r⟩` with `FreeGroup γ ≃* ↥H` gives `HasMMStepData r`.
* `mmStepData_of_freeKernel_free`: the same, with the HNN structure supplied by `hnnKernelForm`
  from `H = ker φ`.  This is the interface consumed by the "free-kernel certificate" route of
  `Submission.Work.OROneRel.mmStepData_of_pos_expsums`.

Every declaration in this file is proved outright and depends only on already proved modules.
-/

namespace Work.OROneRel

universe u

/-- **The free group as the one-relator group `⟨Option γ | of none⟩`.**  Killing one generator of a
free group leaves the free group on the remaining generators, so `PresentedGroup {of none} ≅* F(γ)`
for the generating type `Option γ`.

The forward map kills `none` and fixes every `of (some b)`; the inverse sends `of b` to the class of
`of (some b)`. -/
theorem presentedGroup_optionNone_equiv_freeGroup (γ : Type u) :
    Nonempty (PresentedGroup ({FreeGroup.of (Option.none : Option γ)} :
        Set (FreeGroup (Option γ))) ≃* FreeGroup γ) := by
  classical
  let rels : Set (FreeGroup (Option γ)) := {FreeGroup.of (Option.none : Option γ)}
  let f : Option γ → FreeGroup γ := fun a => match a with | some b => FreeGroup.of b | none => 1
  have hf_none : f Option.none = 1 := rfl
  have hf_some : ∀ b : γ, f (some b) = FreeGroup.of b := fun b => rfl
  have hf : ∀ r ∈ rels, FreeGroup.lift f r = 1 := by
    intro r hr
    rw [Set.mem_singleton_iff] at hr
    subst hr
    simpa [hf_none] using FreeGroup.lift_apply_of (f := f) (x := (Option.none : Option γ))
  let fwd : PresentedGroup rels →* FreeGroup γ := PresentedGroup.toGroup (f := f) hf
  have hfwd : ∀ a : Option γ, fwd (PresentedGroup.of a) = f a :=
    fun a => PresentedGroup.toGroup.of (f := f) hf (x := a)
  let bwd : FreeGroup γ →* PresentedGroup rels :=
    FreeGroup.lift (fun b : γ => PresentedGroup.of (some b))
  have hbwd : ∀ b : γ, bwd (FreeGroup.of b) = PresentedGroup.of (some b) :=
    fun b => FreeGroup.lift_apply_of
  have h1 : bwd.comp fwd = MonoidHom.id (PresentedGroup rels) := by
    refine PresentedGroup.ext fun a => ?_
    simp only [MonoidHom.comp_apply, MonoidHom.id_apply]
    cases a with
    | none =>
      rw [hfwd (Option.none : Option γ), hf_none, map_one]
      exact (PresentedGroup.one_of_mem (x := FreeGroup.of (Option.none : Option γ))
        (Set.mem_singleton _)).symm
    | some b =>
      rw [hfwd (some b), hf_some b, hbwd b]
  have h2 : fwd.comp bwd = MonoidHom.id (FreeGroup γ) := by
    refine FreeGroup.ext_hom _ _ fun b => ?_
    rw [MonoidHom.comp_apply, MonoidHom.id_apply, hbwd b, hfwd (some b), hf_some b]
  exact ⟨MonoidHom.toMulEquiv fwd bwd h1 h2⟩

/-- **The top subgroup is a Magnus subgroup of the terminal one-relator group `⟨β | of y⟩`.**  The
relator `of y` is not generated by the other generators (its exponent sum in the `y`-coordinate is
`1`, and the exponent sum in that coordinate vanishes on every other generator), while the other
generators already generate `⟨β | of y⟩`: the class of `of y` is trivial there.  Hence
`⊤ = magnusSubgroupOf (of y) {x | x ≠ y}` is a Magnus subgroup. -/
theorem isMagnusSubgroup_top_presentedGroup_single {β : Type u} (y : β) :
    IsMagnusSubgroup (⊤ : Subgroup (PresentedGroup ({FreeGroup.of y} : Set (FreeGroup β)))) := by
  classical
  let χ : FreeGroup β →* Multiplicative ℤ :=
    FreeGroup.lift (fun x : β => if x = y then Multiplicative.ofAdd (1 : ℤ) else 1)
  have hχ_of (x : β) : χ (FreeGroup.of x) =
      (if x = y then Multiplicative.ofAdd (1 : ℤ) else 1) := FreeGroup.lift_apply_of
  have hle : Subgroup.closure (FreeGroup.of '' {x | x ≠ y}) ≤ χ.ker := by
    rw [Subgroup.closure_le]
    rintro z ⟨x, hx, rfl⟩
    have hx' : x ≠ y := hx
    show χ (FreeGroup.of x) = 1
    rw [hχ_of, if_neg hx']
  have hy : χ (FreeGroup.of y) ≠ 1 := by
    rw [hχ_of, if_pos rfl]
    intro h
    exact one_ne_zero (by simpa using congrArg Multiplicative.toAdd h : (1 : ℤ) = 0)
  refine ⟨{x | x ≠ y}, fun hcon => hy (hle hcon), ?_⟩
  refine le_antisymm ?_ le_top
  intro z hz
  refine PresentedGroup.generated_by ({FreeGroup.of y} : Set (FreeGroup β))
    (magnusSubgroupOf (FreeGroup.of y) {x | x ≠ y}) (fun j => ?_) z
  by_cases hj : j = y
  · have h1 : PresentedGroup.of (rels := ({FreeGroup.of y} : Set (FreeGroup β))) j = 1 := by
      rw [hj]
      exact PresentedGroup.one_of_mem (x := FreeGroup.of y) (Set.mem_singleton _)
    rw [h1]
    exact Subgroup.one_mem _
  · exact Subgroup.subset_closure ⟨⟨j, hj⟩, rfl⟩

/-- **A free vertex gives the one-step datum, from the abstract form of freeness.**  If `⟨α | r⟩` is
an HNN extension of the subgroup `H` over the top subgroup and `H ≅* FreeGroup γ`, then `r` has the
one-step Magnus--Moldavanskii datum: `H` is re-presented by the terminal one-relator group
`⟨Option γ | of none⟩ ≅ F(γ)` (`presentedGroup_optionNone_equiv_freeGroup`), the HNN structure
transports along that isomorphism (`hnnExtension_iso_of_baseMulEquiv`), the vertex relator
`of none` is terminal of norm `1 < relatorNorm r`, and `⊤` is a Magnus subgroup of the vertex
(`isMagnusSubgroup_top_presentedGroup_single`). -/
theorem hasMMStepData_of_freeVertex_free {α : Type u} (r : FreeGroup α) {γ : Type u}
    (H : Subgroup (PresentedGroup ({r} : Set (FreeGroup α))))
    (eH : FreeGroup γ ≃* ↥H)
    (ψ : (⊤ : Subgroup ↥H) ≃* (⊤ : Subgroup ↥H))
    (eG : PresentedGroup ({r} : Set (FreeGroup α)) ≃* HNNExtension ↥H ⊤ ⊤ ψ)
    (hnorm : 2 ≤ relatorNorm r) : HasMMStepData r := by
  classical
  obtain ⟨eP⟩ := presentedGroup_optionNone_equiv_freeGroup γ
  have he : PresentedGroup ({FreeGroup.of (Option.none : Option γ)} :
      Set (FreeGroup (Option γ))) ≃* ↥H := eP.trans eH
  obtain ⟨A, B, φ, E, hA, hB, -, -⟩ :=
    hnnExtension_iso_of_baseMulEquiv he.symm (⊤ : Subgroup ↥H) (⊤ : Subgroup ↥H) ψ
  have hAtop : A = ⊤ := by
    rw [hA, Subgroup.map_top_of_surjective _ he.symm.surjective]
  have hBtop : B = ⊤ := by
    rw [hB, Subgroup.map_top_of_surjective _ he.symm.surjective]
  refine ⟨Option γ, FreeGroup.of (Option.none : Option γ), ?_, ?_, A, B, ?_, ?_, φ,
    ⟨eG.trans E⟩⟩
  · have h1 : relatorNorm (FreeGroup.of (Option.none : Option γ)) = 1 := by
      simp [relatorNorm, FreeGroup.norm]
    omega
  · exact Or.inl (Or.inr ⟨Option.none, 1, one_ne_zero, by rw [zpow_one]⟩)
  · rw [hAtop]; exact isMagnusSubgroup_top_presentedGroup_single (Option.none : Option γ)
  · rw [hBtop]; exact isMagnusSubgroup_top_presentedGroup_single (Option.none : Option γ)

/-- **The one-step datum from a free kernel, free structure given abstractly.**  If `φ : ⟨α | r⟩ →*
Multiplicative ℤ` has kernel `H`, `φ t = ofAdd 1`, `⟨α | r⟩ = ⟨H, t⟩` and `H ≅* FreeGroup γ`, then
`⟨α | r⟩` is an HNN extension of the free group `H` over the top subgroup (`hnnKernelForm`) and the
one-step Magnus--Moldavanskii datum follows (`hasMMStepData_of_freeVertex_free`). -/
theorem mmStepData_of_freeKernel_free {α : Type u} (r : FreeGroup α)
    (t : PresentedGroup ({r} : Set (FreeGroup α)))
    (φ : PresentedGroup ({r} : Set (FreeGroup α)) →* Multiplicative ℤ)
    (H : Subgroup (PresentedGroup ({r} : Set (FreeGroup α))))
    (hH : ∀ g : PresentedGroup ({r} : Set (FreeGroup α)), g ∈ H ↔ φ g = 1)
    (hφt : φ t = Multiplicative.ofAdd 1)
    (hgen : Subgroup.closure ((H : Set (PresentedGroup ({r} : Set (FreeGroup α)))) ∪ {t}) = ⊤)
    {γ : Type u} (eH : FreeGroup γ ≃* ↥H) (hnorm : 2 ≤ Work.OROneRel.relatorNorm r) :
    Work.OROneRel.HasMMStepData r := by
  obtain ⟨ψ, ⟨E⟩, -⟩ := hnnKernelForm H t φ hφt hH hgen
  exact hasMMStepData_of_freeVertex_free r H eH ψ E.symm hnorm

end Work.OROneRel
