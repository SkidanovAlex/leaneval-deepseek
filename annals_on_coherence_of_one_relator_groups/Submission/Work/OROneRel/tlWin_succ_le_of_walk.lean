import Mathlib
import Submission.Work.OROneRel.tlWin_map_conj_le_tlH
import Submission.Work.OROneRel.decor_winE_shift
import Submission.Work.OROneRel.decor_invRev
import Submission.Work.OROneRel.winE_mono

/-!
# The easy direction of the window recursion for the two-letter band, with an arbitrary deck
element

`tlWin p q m` is the gauge-free window subgroup `π₁(Y[0,m])` of the level graph of the weight
`tlW p q` (`a ↦ q`, `b ↦ -p`): the subgroup of `F₂` generated by the classes of the words of weight
`0` whose decorated walk (read from level `0`) stays in the window `[0,m]`
(`tlWin_eq_closure_tlWinGen`).

This file proves that for **any** element `σ` of weight `1` whose walk lies in the window `[0,m]`
one has

  `tlWin p q m ⊔ (tlWin p q m).map (MulAut.conj σ) ≤ tlWin p q (m+1)`.

The statement is *walk bookkeeping* and needs no hypothesis relating `m` to `p` and `q`:

* `tlWin p q m ≤ tlWin p q (m+1)` is monotonicity of the window (`winE_mono`);
* for a generator `x` of `tlWin p q m`, spelled by a word `L` of weight `0` with walk in `[0,m]`,
  the concatenation

    `wordOf σ ++ L ++ invRev (wordOf σ)`

  spells `σ x σ⁻¹`, has weight `1 + 0 - 1 = 0`, and its decorated walk is

  * the walk of `σ` (levels in `[0,m]` by hypothesis),
  * the walk of `L` shifted up by one (levels in `[1, m+1]`, `decor_winE_shift`),
  * the reversed walk of `σ` read back from level `1` (`decor_invRev`), which retraces the walk of
    `σ` and hence again has levels in `[0,m]`.

  All three parts lie in `[0, m+1]`, so `σ x σ⁻¹ ∈ tlWin p q (m+1)`.

The companion statement (the reverse inclusion, Seifert--van Kampen) is *not* claimed here; it needs
different geometric input (see `Work.OROneRel.tlWin_succ_lemma`).
-/

namespace Work.OROneRel

/-- **Membership from a word.**  An element spelled by a word `L` of weight `0` whose decorated walk
(read from level `0`) stays in the window `[0,M]` belongs to the window subgroup `tlWin p q M`. -/
theorem tlWin_mem_of_word {p q : ℕ} {M : ℤ} {L : List (Fin 2 × Bool)}
    (hlsig : lsig (tlW p q) L = 0)
    (hwalk : ∀ e ∈ decor (tlW p q) 0 L, coverEdge e ∈ winE (tlW p q) 0 M) :
    FreeGroup.mk L ∈ tlWin p q M := by
  rw [tlWin_eq_closure_tlWinGen]
  exact Subgroup.subset_closure ⟨L, rfl, hlsig, hwalk⟩

/-- **Monotonicity of the window subgroups** in the upper bound of the window. -/
theorem tlWin_mono_of_le (p q : ℕ) {m M : ℤ} (h : m ≤ M) : tlWin p q m ≤ tlWin p q M := by
  rw [tlWin_eq_closure_tlWinGen]
  refine (Subgroup.closure_le _).mpr ?_
  rintro x ⟨L, rfl, hlsig, hwalk⟩
  exact tlWin_mem_of_word hlsig fun e he => winE_mono (tlW p q) le_rfl h (hwalk e he)

/-- **Generator level statement.**  Conjugating an element of `tlWinGen p q m` by an element `σ` of
weight `1` whose walk lies in the window `[0,m]` lands in the window `[0,m+1]`: the word
`wordOf σ ++ L ++ invRev (wordOf σ)` spells `σ x σ⁻¹`, has weight `0`, and its decorated walk stays
in `[0, m+1]`. -/
theorem tlWinGen_conj_mem_succ_of_walk (p q : ℕ) {σ : FreeGroup (Fin 2)} {m : ℤ}
    (hσ : cohom (tlW p q) σ = Multiplicative.ofAdd 1)
    (hwalk : ∀ e ∈ decor (tlW p q) 0 (wordOf σ), coverEdge e ∈ winE (tlW p q) 0 m)
    {x : FreeGroup (Fin 2)} (hx : x ∈ tlWinGen p q m) :
    σ * x * σ⁻¹ ∈ tlWin p q (m + 1) := by
  obtain ⟨L, hmk, hlsig, hwalkL⟩ := hx
  have hlsigσ : lsig (tlW p q) (wordOf σ) = 1 := by
    rw [CoedgeBase.lsig_wordOf, hσ]
    rfl
  have hmkW : FreeGroup.mk (wordOf σ ++ L ++ FreeGroup.invRev (wordOf σ)) = σ * x * σ⁻¹ := by
    simp only [← FreeGroup.mul_mk, ← FreeGroup.inv_mk, mk_wordOf, hmk]
  rw [← hmkW]
  refine tlWin_mem_of_word ?_ ?_
  · -- the weight of the concatenation is `1 + 0 - 1 = 0`
    rw [decor_lsig_append, decor_lsig_append, CoedgeBase.lsig_invRev, hlsigσ, hlsig]
    ring
  · intro e he
    rw [decor_append] at he
    rcases List.mem_append.mp he with he₁ | he₃
    · rw [decor_append] at he₁
      rcases List.mem_append.mp he₁ with he₂ | he₂
      · -- the prefix `wordOf σ`, in `[0,m]`
        exact winE_mono (tlW p q) le_rfl (by omega) (hwalk e he₂)
      · -- the middle `L`, shifted up by one: `[1, m+1]`
        rw [hlsigσ] at he₂
        exact winE_mono (tlW p q) (by omega) (by omega)
          (decor_winE_shift (tlW p q) 0 1 0 m L hwalkL e he₂)
    · -- the suffix `invRev (wordOf σ)`, read back from level `1`: it retraces the walk of `σ`
      rw [decor_lsig_append, hlsig, add_zero] at he₃
      rw [decor_invRev (tlW p q) 0 (wordOf σ)] at he₃
      obtain ⟨e', he'', hfe⟩ := List.mem_map.mp he₃
      have he' : e' ∈ decor (tlW p q) 0 (wordOf σ) := List.mem_reverse.mp he''
      rw [← hfe]
      exact winE_mono (tlW p q) le_rfl (by omega) (hwalk e' he')

theorem tlWin_succ_le_of_walk (p q : ℕ) {σ : FreeGroup (Fin 2)} {m : ℤ}
    (hσ : Work.OROneRel.cohom (Work.OROneRel.tlW p q) σ = Multiplicative.ofAdd 1)
    (hwalk : ∀ e ∈ Work.OROneRel.decor (Work.OROneRel.tlW p q) 0 (Work.OROneRel.wordOf σ),
      Work.OROneRel.coverEdge e ∈ Work.OROneRel.winE (Work.OROneRel.tlW p q) 0 m) :
    Work.OROneRel.tlWin p q m ⊔ (Work.OROneRel.tlWin p q m).map (MulAut.conj σ) ≤
      Work.OROneRel.tlWin p q (m + 1) := by
  classical
  refine sup_le (tlWin_mono_of_le p q (by omega)) ?_
  rw [Subgroup.map_le_iff_le_comap]
  refine (Subgroup.closure_le _).mpr ?_
  rintro x hx
  show σ * x * σ⁻¹ ∈ tlWin p q (m + 1)
  exact tlWinGen_conj_mem_succ_of_walk p q hσ hwalk hx

end Work.OROneRel
