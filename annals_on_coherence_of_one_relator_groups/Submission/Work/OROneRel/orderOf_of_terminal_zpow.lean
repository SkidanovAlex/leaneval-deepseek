import Mathlib
import Submission.Work.OROneRel.Basic

/-!
# The order of a generator in a terminal one-relator group `⟨α | x ^ m⟩`

For `x : α` and `m : ℤ`, the one-relator group `⟨α | x ^ m⟩` is the free product of the cyclic
group of order `|m|` generated by `x` with the free group on the remaining generators.  In
particular `x` has order exactly `|m|` in `⟨α | x ^ m⟩`; this is the statement proved here.

The proof is elementary and uses only the universal property of presented groups:

* the relation `x ^ m = 1` shows that `orderOf (of x)` divides `m.natAbs`
  (through `zpow_eq_one_natAbs` and `orderOf_dvd_of_pow_eq_one`);
* the homomorphism `⟨α | x ^ m⟩ →* Multiplicative (ZMod m.natAbs)` sending `x ↦ 1`
  (all other generators `↦ 0`) is well defined, and `orderOf (of x) → orderOf 1 = m.natAbs`
  divides `orderOf (of x)` (through `orderOf_map_dvd`).

Note that the hypothesis `hm : m ≠ 0` is not actually needed: for `m = 0` the relation is
trivial, `⟨α | 1⟩` is free on `α`, `of x` has infinite order (`orderOf = 0 = m.natAbs`), and the
argument below goes through unchanged.
-/

namespace Work.OROneRel

universe u

/-- If `g ^ m = 1` for an integer `m`, then the corresponding positive power vanishes:
`g ^ m.natAbs = 1`. -/
theorem zpow_eq_one_natAbs {G : Type*} [Group G] {g : G} {m : ℤ} (h : g ^ m = 1) :
    g ^ m.natAbs = 1 := by
  rcases le_or_gt (0 : ℤ) m with hm | hm
  · rw [← zpow_natCast, Int.natAbs_of_nonneg hm]
    exact h
  · have hle : (0 : ℤ) ≤ -m := by linarith
    rw [← zpow_natCast, ← Int.natAbs_neg m, Int.natAbs_of_nonneg hle, zpow_neg, h, inv_one]

theorem orderOf_of_terminal_zpow {α : Type u} (x : α) (m : ℤ) (hm : m ≠ 0) :
    orderOf (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) = m.natAbs := by
  classical
  -- keep track of the unused hypothesis so that the binder is referenced
  have _hm : m ≠ 0 := hm
  -- The relation `x ^ m = 1` holds in `⟨α | x ^ m⟩`.
  have hpow :
      (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) ^ m = 1 := by
    change (PresentedGroup.mk ({FreeGroup.of x ^ m} : Set (FreeGroup α)) (FreeGroup.of x)) ^ m = 1
    rw [← map_zpow]
    exact PresentedGroup.one_of_mem (Set.mem_singleton _)
  have hnat :
      (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) ^ m.natAbs = 1 :=
    zpow_eq_one_natAbs hpow
  -- Upper bound: `orderOf (of x) ∣ m.natAbs`.
  have hdvd1 :
      orderOf (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) ∣ m.natAbs :=
    orderOf_dvd_of_pow_eq_one hnat
  -- Lower bound: a homomorphism to the cyclic group `ZMod m.natAbs` sending `x ↦ 1`.
  let f : α → Multiplicative (ZMod m.natAbs) :=
    fun a => if a = x then Multiplicative.ofAdd 1 else 1
  have hfx : f x = Multiplicative.ofAdd (1 : ZMod m.natAbs) := by
    simp only [f, if_pos rfl]
  have hf : ∀ r ∈ ({FreeGroup.of x ^ m} : Set (FreeGroup α)), FreeGroup.lift f r = 1 := by
    intro r hr
    rw [Set.mem_singleton_iff] at hr
    rw [hr, map_zpow, FreeGroup.lift_apply_of, hfx]
    rw [← ofAdd_zsmul, Int.smul_one_eq_cast, ofAdd_eq_one]
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd m m.natAbs).mpr (Int.natCast_dvd.mpr dvd_rfl)
  have hφ :
      (PresentedGroup.toGroup hf)
          (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x)
        = Multiplicative.ofAdd (1 : ZMod m.natAbs) := by
    rw [PresentedGroup.toGroup.of, hfx]
  have hord :
      orderOf ((PresentedGroup.toGroup hf)
          (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x)) = m.natAbs := by
    rw [hφ, orderOf_ofAdd_eq_addOrderOf, ZMod.addOrderOf_one]
  have hdvd2 :
      m.natAbs ∣ orderOf (PresentedGroup.of (rels := ({FreeGroup.of x ^ m} : Set (FreeGroup α))) x) := by
    rw [← hord]
    exact orderOf_map_dvd (PresentedGroup.toGroup hf) _
  exact Nat.dvd_antisymm hdvd1 hdvd2

end Work.OROneRel
