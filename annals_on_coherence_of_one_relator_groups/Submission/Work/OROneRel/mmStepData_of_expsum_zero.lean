universe u v

variable {α : Type u}

abbrev MMAlpha (t : α) : Type u := {x : α // x ≠ t} × ℤ

theorem magRew_eq_rewriteAux (t : α) (i : ℤ) (L : List (α × Bool)) :
    magRew t i L = rewriteAux t i L := by
  classical
  induction L generalizing i with
  | nil => rw [magRew.eq_def, rewriteAux.eq_def]
  | cons p L ih =>
    rw [magRew.eq_def, rewriteAux.eq_def]
    by_cases h : p.1 = t
    · simp only [h, dif_pos]
      exact ih _
    · simp only [h, dif_neg, not_false_eq_true]
      exact congrArg (fun l => ((⟨p.1, h⟩, i), p.2) :: l) (ih i)

theorem magRew_zero_eq_rewrite (t : α) (L : List (α × Bool)) :
    magRew t 0 L = rewrite t L := magRew_eq_rewriteAux t 0 L

theorem rho_eq_magnusMap (t : α) : rho t = magnusMap t := rfl

noncomputable def mmList (t : α) (r : FreeGroup α) : List (MMAlpha t × Bool) := by
  classical exact magRew t 0 r.toWord

theorem magnusMap_mmList (t : α) (r : FreeGroup α) (h : eps t r = 0) :
    magnusMap t (FreeGroup.mk (mmList t r)) = r := by
  classical
  have h0 : wordEps t r.toWord = 0 := h
  have h1 := rho_magRew t 0 r.toWord
  rw [rho_eq_magnusMap] at h1
  rw [mmList, h1, h0]
  simp only [zpow_zero, one_mul, add_zero, neg_zero, mul_one]
  exact FreeGroup.mk_toWord

noncomputable def mmDecs (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) : Finset ℤ := by
  classical
  exact ((mmList t r).filterMap (fun p => if p.1.1 = x then some p.1.2 else none)).toFinset

theorem mem_mmDecs_iff (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) (k : ℤ) :
    k ∈ mmDecs t r x ↔ ∃ b : Bool, ((x, k), b) ∈ mmList t r := by
  classical
  rw [mmDecs, List.mem_toFinset, List.mem_filterMap]
  constructor
  · rintro ⟨p, hp, hpx⟩
    by_cases hq : p.1.1 = x
    · rw [if_pos hq] at hpx
      have hk : p.1.2 = k := Option.some.inj hpx
      have hp' : p.1 = (x, k) := Prod.ext hq hk
      refine ⟨p.2, ?_⟩
      rw [← hp']
      exact hp
    · rw [if_neg hq] at hpx
      exact absurd hpx (by simp)
  · rintro ⟨b, hb⟩
    exact ⟨((x, k), b), hb, by simp⟩

noncomputable def mmLo (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) : ℤ := by
  classical
  exact if h : (mmDecs t r x).Nonempty then (mmDecs t r x).min' h else 0

noncomputable def mmHi (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) : ℤ := by
  classical
  exact if h : (mmDecs t r x).Nonempty then (mmDecs t r x).max' h else 0

noncomputable def mmDecSet (t : α) (r : FreeGroup α) : Set (MMAlpha t) :=
  {p | mmLo t r p.1 ≤ p.2 ∧ p.2 ≤ mmHi t r p.1}

theorem mmLo_le_hi (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) :
    mmLo t r x ≤ mmHi t r x := by
  classical
  rw [mmLo, mmHi]
  by_cases h : (mmDecs t r x).Nonempty
  · simp only [dif_pos h]
    exact Finset.min'_le _ _ (Finset.max'_mem _ h)
  · simp only [dif_neg h]
    exact le_refl 0

theorem mmLo_mem_decSet (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) :
    (x, mmLo t r x) ∈ mmDecSet t r :=
  ⟨le_refl _, mmLo_le_hi t r x⟩

theorem mmHi_mem_decSet (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) :
    (x, mmHi t r x) ∈ mmDecSet t r :=
  ⟨mmLo_le_hi t r x, le_refl _⟩

theorem mmList_mem_decSet (t : α) (r : FreeGroup α) {p : MMAlpha t} {b : Bool}
    (h : (p, b) ∈ mmList t r) : p ∈ mmDecSet t r := by
  classical
  have hk : p.2 ∈ mmDecs t r p.1 := (mem_mmDecs_iff t r p.1 p.2).mpr ⟨b, h⟩
  have hne : (mmDecs t r p.1).Nonempty := ⟨p.2, hk⟩
  constructor
  · rw [mmLo, dif_pos hne]
    exact Finset.min'_le _ _ hk
  · rw [mmHi, dif_pos hne]
    exact Finset.le_max' _ _ hk

theorem exists_mmList_of_mem_mmDecs (t : α) (r : FreeGroup α) {x : {x : α // x ≠ t}} {k : ℤ}
    (h : k ∈ mmDecs t r x) : ∃ b : Bool, ((x, k), b) ∈ mmList t r :=
  (mem_mmDecs_iff t r x k).mp h

theorem exists_mmLo (t : α) (r : FreeGroup α) {x : {x : α // x ≠ t}}
    (h : (mmDecs t r x).Nonempty) : ∃ b : Bool, ((x, mmLo t r x), b) ∈ mmList t r := by
  classical
  rw [mmLo, dif_pos h]
  exact exists_mmList_of_mem_mmDecs t r (Finset.min'_mem _ h)

theorem exists_mmHi (t : α) (r : FreeGroup α) {x : {x : α // x ≠ t}}
    (h : (mmDecs t r x).Nonempty) : ∃ b : Bool, ((x, mmHi t r x), b) ∈ mmList t r := by
  classical
  rw [mmHi, dif_pos h]
  exact exists_mmList_of_mem_mmDecs t r (Finset.max'_mem _ h)

abbrev mmBeta (t : α) (r : FreeGroup α) : Type u := {p : MMAlpha t // p ∈ mmDecSet t r}

/-- The decorated alphabet carries a classical decidable equality (it is a subtype of a product of
a subtype and `ℤ`), which is needed to speak about the reduced word of an element of its free group
without assuming `DecidableEq α`. -/
noncomputable instance mmBetaDecidableEq (t : α) (r : FreeGroup α) : DecidableEq (mmBeta t r) :=
  Classical.decEq _

noncomputable def mmBetaOf (t : α) (r : FreeGroup α) (p : MMAlpha t) : mmBeta t r := by
  classical
  exact if h : p ∈ mmDecSet t r then ⟨p, h⟩ else ⟨(p.1, mmLo t r p.1), mmLo_mem_decSet t r p.1⟩

theorem mmBetaOf_val (t : α) (r : FreeGroup α) {p : MMAlpha t} (hp : p ∈ mmDecSet t r) :
    (mmBetaOf t r p).1 = p := by
  classical
  rw [mmBetaOf]
  simp only [dif_pos hp]

noncomputable def mmWL (t : α) (r : FreeGroup α) : List (mmBeta t r × Bool) := by
  classical exact (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2))

noncomputable def mmW (t : α) (r : FreeGroup α) : FreeGroup (mmBeta t r) :=
  FreeGroup.mk (mmWL t r)

theorem mmWL_map_val (t : α) (r : FreeGroup α) :
    (mmWL t r).map (fun q => ((q.1.1 : MMAlpha t), q.2)) = mmList t r := by
  classical
  rw [mmWL, List.map_map]
  trans (mmList t r).map id
  · apply List.map_congr_left
    intro p hp
    exact Prod.ext (mmBetaOf_val t r (mmList_mem_decSet t r hp)) rfl
  · exact List.map_id _

theorem mmW_map_val (t : α) (r : FreeGroup α) :
    FreeGroup.map (fun p : mmBeta t r => (p.1 : MMAlpha t)) (mmW t r) =
      FreeGroup.mk (mmList t r) := by
  classical
  rw [mmW, FreeGroup.map.mk]
  congr 1
  exact mmWL_map_val t r

abbrev mmTA (t : α) (r : FreeGroup α) : Set (mmBeta t r) :=
  {e | ((e.1.1, e.1.2 + 1) : MMAlpha t) ∈ mmDecSet t r}

abbrev mmTB (t : α) (r : FreeGroup α) : Set (mmBeta t r) :=
  {e | ((e.1.1, e.1.2 - 1) : MMAlpha t) ∈ mmDecSet t r}

noncomputable def mmA (t : α) (r : FreeGroup α) :
    Subgroup (PresentedGroup ({mmW t r} : Set (FreeGroup (mmBeta t r)))) :=
  magnusSubgroupOf (mmW t r) (mmTA t r)

noncomputable def mmB (t : α) (r : FreeGroup α) :
    Subgroup (PresentedGroup ({mmW t r} : Set (FreeGroup (mmBeta t r)))) :=
  magnusSubgroupOf (mmW t r) (mmTB t r)

/-! ### The shift of the decorations -/

noncomputable def mmTshift (t : α) (r : FreeGroup α) : mmTA t r ≃ mmTB t r where
  toFun e :=
    ⟨⟨(e.1.1.1, e.1.1.2 + 1), by
        simpa only [mmTA, mmDecSet, Set.mem_ofPred_eq] using e.2⟩, by
      show ((e.1.1.1, e.1.1.2 + 1 - 1) : MMAlpha t) ∈ mmDecSet t r
      rw [show ((e.1.1.1, e.1.1.2 + 1 - 1) : MMAlpha t) = (e.1.1.1, e.1.1.2) from by simp]
      simpa only [mmDecSet, Set.mem_ofPred_eq] using e.1.2⟩
  invFun e :=
    ⟨⟨(e.1.1.1, e.1.1.2 - 1), by
        simpa only [mmTB, mmDecSet, Set.mem_ofPred_eq] using e.2⟩, by
      show ((e.1.1.1, e.1.1.2 - 1 + 1) : MMAlpha t) ∈ mmDecSet t r
      rw [show ((e.1.1.1, e.1.1.2 - 1 + 1) : MMAlpha t) = (e.1.1.1, e.1.1.2) from by simp]
      simpa only [mmDecSet, Set.mem_ofPred_eq] using e.1.2⟩
  left_inv e := by ext <;> simp
  right_inv e := by ext <;> simp

/-! ### Basic arithmetic facts about the rewriting -/

theorem sigma_eq_expSum (t : α) : sigma t = expSum t := by
  refine FreeGroup.ext_hom _ _ fun a => ?_
  simp [sigma, expSum]

theorem eps_eq_zero_iff_sigma_eq_one (t : α) (r : FreeGroup α) :
    eps t r = 0 ↔ sigma t r = 1 := by
  classical
  have h1 : eps t r = sigmaList t r.toWord := by
    rw [eps]
    exact (sigmaList_eq_wordEps t r.toWord).symm
  have h2 : sigma t r = Multiplicative.ofAdd (sigmaList t r.toWord) := by
    conv_lhs => rw [← FreeGroup.mk_toWord (x := r)]
    exact sigma_mk t r.toWord
  rw [h1, h2, ofAdd_eq_one]

theorem exists_relatorLetters_ne_of_eps_zero {t : α} {r : FreeGroup α}
    (h1 : r ≠ 1) (ht : t ∈ relatorLetters r) (h : eps t r = 0) :
    ∃ x ∈ relatorLetters r, x ≠ t := by
  classical
  by_contra hc
  push_neg at hc
  have hsub : relatorLetters r ⊆ ({t} : Set α) := fun x hx => by simpa using hc x hx
  have hmem : r ∈ Subgroup.closure (FreeGroup.of '' ({t} : Set α)) :=
    (letters_closure_iff r {t}).mpr hsub
  have himg : FreeGroup.of '' ({t} : Set α) = {FreeGroup.of t} := by
    ext y
    simp
  obtain ⟨k, hk⟩ : ∃ k : ℤ, FreeGroup.of t ^ k = r := by
    rw [himg, ← Subgroup.zpowers_eq_closure] at hmem
    exact Subgroup.mem_zpowers_iff.mp hmem
  have hsig : sigma t r = Multiplicative.ofAdd k := by
    rw [← hk, sigma, map_zpow, FreeGroup.lift_apply_of, if_pos rfl, ← Int.ofAdd_mul, one_mul]
  have hk0 : k = 0 := ofAdd_eq_one.mp (by rw [← hsig]; exact (eps_eq_zero_iff_sigma_eq_one t r).mp h)
  rw [← hk, hk0, zpow_zero] at h1
  exact h1 rfl

/-! ### The Magnus rewriting is reduced, cyclically reduced and nontrivial -/

theorem mmList_isReduced (t : α) (r : FreeGroup α) (hr : IsCyclicallyReducedRelator r)
    (h : eps t r = 0) : FreeGroup.IsReduced (mmList t r) := by
  classical
  have hc : FreeGroup.IsCyclicallyReduced (rewrite t r.toWord) :=
    isCyclicallyReducedRelator_rewrite_toWord t hr h
  rw [mmList, magRew_zero_eq_rewrite]
  exact hc.isReduced

theorem isReduced_map_subtype {γ : Type*} {δ : Type*} {f : γ → δ} {g : δ → γ}
    {L : List (γ × Bool)} (hf : ∀ p ∈ L, g (f p.1) = p.1) :
    FreeGroup.IsReduced (L.map (fun p => (f p.1, p.2))) ↔ FreeGroup.IsReduced L := by
  induction L with
  | nil => simp [FreeGroup.IsReduced]
  | cons a t ih =>
    cases t with
    | nil => simp
    | cons b t' =>
      have ha : g (f a.1) = a.1 := hf a (by simp)
      have hb : g (f b.1) = b.1 := hf b (by simp)
      have ht : ∀ p ∈ (b :: t'), g (f p.1) = p.1 := fun p hp => hf p (by simp [hp])
      have ih' : FreeGroup.IsReduced
          ((f b.1, b.2) :: t'.map (fun p => (f p.1, p.2))) ↔ FreeGroup.IsReduced (b :: t') := by
        simpa only [List.map_cons] using ih ht
      simp only [List.map_cons]
      rw [FreeGroup.isReduced_cons_cons, FreeGroup.isReduced_cons_cons, ih']
      constructor
      · rintro ⟨h1, h2⟩
        refine ⟨?_, h2⟩
        intro hab
        exact h1 (by rw [hab])
      · rintro ⟨h1, h2⟩
        refine ⟨?_, h2⟩
        intro hfst
        have hfst' : f a.1 = f b.1 := hfst
        exact h1 (by rw [← ha, ← hb, hfst'])

theorem mmWL_isReduced (t : α) (r : FreeGroup α) (hr : IsCyclicallyReducedRelator r)
    (h : eps t r = 0) : FreeGroup.IsReduced (mmWL t r) := by
  classical
  have hL : FreeGroup.IsReduced (mmList t r) := mmList_isReduced t r hr h
  rw [show mmWL t r = (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2)) from by rw [mmWL]]
  refine (isReduced_map_subtype (f := fun p : MMAlpha t => mmBetaOf t r p)
    (g := fun p : mmBeta t r => (p.1 : MMAlpha t)) ?_).mpr hL
  intro p hp
  exact mmBetaOf_val t r (mmList_mem_decSet t r hp)

theorem mmWL_ne_nil {t : α} {r : FreeGroup α}
    (h1 : r ≠ 1) (ht : t ∈ relatorLetters r) (h : eps t r = 0) : mmWL t r ≠ [] := by
  classical
  obtain ⟨x, hxmem, hxt⟩ := exists_relatorLetters_ne_of_eps_zero h1 ht h
  rw [relatorLetters] at hxmem
  obtain ⟨bx, hbx⟩ := hxmem
  obtain ⟨p, hp1, hp2⟩ := rewrite_mem_letter t x hxt bx hbx
  have hp : p ∈ mmList t r := by rw [mmList, magRew_zero_eq_rewrite]; exact hp2
  set q : mmBeta t r := ⟨p.1, mmList_mem_decSet t r hp⟩ with hq
  have hmem : (q, p.2) ∈ mmWL t r := by
    rw [show mmWL t r = (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2)) from by rw [mmWL]]
    refine List.mem_map.mpr ⟨p, hp, ?_⟩
    refine Prod.ext ?_ rfl
    exact Subtype.ext (mmBetaOf_val t r (mmList_mem_decSet t r hp))
  intro hnil
  rw [hnil] at hmem
  exact absurd hmem (by simp)

theorem mem_mmWL_of_mem_toWord {t : α} {r : FreeGroup α} (hred : FreeGroup.IsReduced (mmWL t r))
    {q : mmBeta t r} {b : Bool} (hb : (q, b) ∈ FreeGroup.toWord (mmW t r)) :
    (q, b) ∈ mmWL t r := by
  classical
  have hthis : FreeGroup.toWord (mmW t r) = mmWL t r := by
    rw [mmW, FreeGroup.toWord_mk]
    exact hred.reduce_eq
  rwa [hthis] at hb

theorem mem_toWord_of_mem_mmWL {t : α} {r : FreeGroup α} (hred : FreeGroup.IsReduced (mmWL t r))
    {q : mmBeta t r} {b : Bool} (hb : (q, b) ∈ mmWL t r) :
    (q, b) ∈ FreeGroup.toWord (mmW t r) := by
  classical
  have hthis : FreeGroup.toWord (mmW t r) = mmWL t r := by
    rw [mmW, FreeGroup.toWord_mk]
    exact hred.reduce_eq
  rwa [hthis]

theorem mmW_ne_one {t : α} {r : FreeGroup α} (hred : FreeGroup.IsReduced (mmWL t r))
    (hne : mmWL t r ≠ []) : mmW t r ≠ 1 := by
  classical
  intro hc
  have hthis : FreeGroup.toWord (mmW t r) = [] := by rw [hc, FreeGroup.toWord_one]
  have h2 : FreeGroup.toWord (mmW t r) = mmWL t r := by
    rw [mmW, FreeGroup.toWord_mk]
    exact hred.reduce_eq
  exact hne (by rw [← h2]; exact hthis)

theorem mem_relatorLetters_mmW {t : α} {r : FreeGroup α} (hred : FreeGroup.IsReduced (mmWL t r))
    (q : mmBeta t r) : q ∈ relatorLetters (mmW t r) ↔ ∃ b : Bool, (q, b) ∈ mmWL t r := by
  classical
  constructor
  · intro hq
    rw [relatorLetters] at hq
    obtain ⟨b, hb⟩ := hq
    exact ⟨b, mem_mmWL_of_mem_toWord hred hb⟩
  · rintro ⟨b, hb⟩
    rw [relatorLetters]
    exact ⟨b, mem_toWord_of_mem_mmWL hred hb⟩

/-! ### The associated subgroups are Magnus subgroups -/

theorem mmW_notMem_closure_TA {t : α} {r : FreeGroup α}
    (h1 : r ≠ 1) (ht : t ∈ relatorLetters r) (h : eps t r = 0)
    (hred : FreeGroup.IsReduced (mmWL t r)) :
    mmW t r ∉ Subgroup.closure (FreeGroup.of '' mmTA t r) := by
  classical
  intro hmem
  have hsub : SupportedOn (mmW t r) (mmTA t r) := (letters_closure_iff (mmW t r) (mmTA t r)).mp hmem
  obtain ⟨x, hxmem, hxt⟩ := exists_relatorLetters_ne_of_eps_zero h1 ht h
  rw [relatorLetters] at hxmem
  obtain ⟨bx, hbx⟩ := hxmem
  obtain ⟨p, hp1, hp2⟩ := rewrite_mem_letter t x hxt bx hbx
  have hp : p ∈ mmList t r := by rw [mmList, magRew_zero_eq_rewrite]; exact hp2
  have hpe : p = (((⟨x, hxt⟩ : {x : α // x ≠ t}), p.1.2), p.2) := by
    refine Prod.ext ?_ rfl
    exact Prod.ext hp1 rfl
  have hp' : (((⟨x, hxt⟩ : {x : α // x ≠ t}), p.1.2), p.2) ∈ mmList t r := by rwa [← hpe]
  have hne : (mmDecs t r ⟨x, hxt⟩).Nonempty :=
    ⟨p.1.2, (mem_mmDecs_iff t r ⟨x, hxt⟩ p.1.2).mpr ⟨p.2, hp'⟩⟩
  obtain ⟨b, hb⟩ := exists_mmHi t r hne
  set q : mmBeta t r := ⟨(⟨x, hxt⟩, mmHi t r ⟨x, hxt⟩), mmHi_mem_decSet t r ⟨x, hxt⟩⟩ with hq
  have hqmem : q ∈ relatorLetters (mmW t r) := by
    refine (mem_relatorLetters_mmW hred q).mpr ⟨b, ?_⟩
    rw [show mmWL t r = (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2)) from by rw [mmWL]]
    refine List.mem_map.mpr ⟨((⟨x, hxt⟩, mmHi t r ⟨x, hxt⟩), b), hb, ?_⟩
    refine Prod.ext ?_ rfl
    exact Subtype.ext (mmBetaOf_val t r (mmHi_mem_decSet t r ⟨x, hxt⟩))
  have hqnot : q ∉ mmTA t r := by
    intro hq'
    have h2 : mmHi t r ⟨x, hxt⟩ + 1 ≤ mmHi t r ⟨x, hxt⟩ :=
      (show ((⟨x, hxt⟩, mmHi t r ⟨x, hxt⟩ + 1) : MMAlpha t) ∈ mmDecSet t r from hq').2
    omega
  exact hqnot (hsub hqmem)

theorem mmW_notMem_closure_TB {t : α} {r : FreeGroup α}
    (h1 : r ≠ 1) (ht : t ∈ relatorLetters r) (h : eps t r = 0)
    (hred : FreeGroup.IsReduced (mmWL t r)) :
    mmW t r ∉ Subgroup.closure (FreeGroup.of '' mmTB t r) := by
  classical
  intro hmem
  have hsub : SupportedOn (mmW t r) (mmTB t r) := (letters_closure_iff (mmW t r) (mmTB t r)).mp hmem
  obtain ⟨x, hxmem, hxt⟩ := exists_relatorLetters_ne_of_eps_zero h1 ht h
  rw [relatorLetters] at hxmem
  obtain ⟨bx, hbx⟩ := hxmem
  obtain ⟨p, hp1, hp2⟩ := rewrite_mem_letter t x hxt bx hbx
  have hp : p ∈ mmList t r := by rw [mmList, magRew_zero_eq_rewrite]; exact hp2
  have hpe : p = (((⟨x, hxt⟩ : {x : α // x ≠ t}), p.1.2), p.2) := by
    refine Prod.ext ?_ rfl
    exact Prod.ext hp1 rfl
  have hp' : (((⟨x, hxt⟩ : {x : α // x ≠ t}), p.1.2), p.2) ∈ mmList t r := by rwa [← hpe]
  have hne : (mmDecs t r ⟨x, hxt⟩).Nonempty :=
    ⟨p.1.2, (mem_mmDecs_iff t r ⟨x, hxt⟩ p.1.2).mpr ⟨p.2, hp'⟩⟩
  obtain ⟨b, hb⟩ := exists_mmLo t r hne
  set q : mmBeta t r := ⟨(⟨x, hxt⟩, mmLo t r ⟨x, hxt⟩), mmLo_mem_decSet t r ⟨x, hxt⟩⟩ with hq
  have hqmem : q ∈ relatorLetters (mmW t r) := by
    refine (mem_relatorLetters_mmW hred q).mpr ⟨b, ?_⟩
    rw [show mmWL t r = (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2)) from by rw [mmWL]]
    refine List.mem_map.mpr ⟨((⟨x, hxt⟩, mmLo t r ⟨x, hxt⟩), b), hb, ?_⟩
    refine Prod.ext ?_ rfl
    exact Subtype.ext (mmBetaOf_val t r (mmLo_mem_decSet t r ⟨x, hxt⟩))
  have hqnot : q ∉ mmTB t r := by
    intro hq'
    have h2 : mmLo t r ⟨x, hxt⟩ ≤ mmLo t r ⟨x, hxt⟩ - 1 :=
      (show ((⟨x, hxt⟩, mmLo t r ⟨x, hxt⟩ - 1) : MMAlpha t) ∈ mmDecSet t r from hq').1
    omega
  exact hqnot (hsub hqmem)

/-! ### The norm drop and cyclic reducedness -/

theorem mmW_relatorNorm_lt {t : α} {r : FreeGroup α} (ht : t ∈ relatorLetters r) :
    relatorNorm (mmW t r) < relatorNorm r := by
  classical
  have h1 : relatorNorm (mmW t r) ≤ (mmWL t r).length := by
    rw [relatorNorm, mmW]
    exact FreeGroup.norm_mk_le
  have h2 : (mmWL t r).length = (mmList t r).length := by rw [mmWL, List.length_map]
  have h3 : (mmList t r).length = (rewrite t r.toWord).length := by
    rw [mmList, magRew_zero_eq_rewrite]
  have h4 : (rewrite t r.toWord).length < r.toWord.length := by
    rw [relatorLetters] at ht
    obtain ⟨b, hb⟩ := ht
    refine rewrite_length_lt t ?_
    cases b
    · exact Or.inr (by simpa using hb)
    · exact Or.inl (by simpa using hb)
  have h5 : relatorNorm r = r.toWord.length := by rw [relatorNorm, FreeGroup.norm]
  omega

theorem mmWL_isCyclicallyReduced (t : α) (r : FreeGroup α) (hr : IsCyclicallyReducedRelator r)
    (h : eps t r = 0) : FreeGroup.IsCyclicallyReduced (mmWL t r) := by
  classical
  have hc : FreeGroup.IsCyclicallyReduced (rewrite t r.toWord) :=
    isCyclicallyReducedRelator_rewrite_toWord t hr h
  have hL : FreeGroup.IsCyclicallyReduced (mmList t r) := by
    rw [mmList, magRew_zero_eq_rewrite]; exact hc
  rw [isCyclicallyReduced_iff_isReduced_append_self] at hL ⊢
  rw [show (mmWL t r) ++ (mmWL t r) =
      ((mmList t r) ++ (mmList t r)).map (fun p => (mmBetaOf t r p.1, p.2)) from by
    rw [show mmWL t r = (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2)) from by rw [mmWL],
      ← List.map_append]]
  refine (isReduced_map_subtype (f := fun p : MMAlpha t => mmBetaOf t r p)
    (g := fun p : mmBeta t r => (p.1 : MMAlpha t)) ?_).mpr hL
  intro p hp
  have hp' : p ∈ mmList t r := (List.mem_append.mp hp).elim id id
  exact mmBetaOf_val t r (mmList_mem_decSet t r hp')

theorem mmW_isCyclicallyReduced {t : α} {r : FreeGroup α}
    (hr : IsCyclicallyReducedRelator r) (h : eps t r = 0) :
    IsCyclicallyReducedRelator (mmW t r) := by
  classical
  have hwl : FreeGroup.IsCyclicallyReduced (mmWL t r) := mmWL_isCyclicallyReduced t r hr h
  rw [IsCyclicallyReducedRelator, mmW, FreeGroup.toWord_mk, hwl.isReduced.reduce_eq]
  exact hwl

/-! ### The isomorphism between the two Magnus subgroups -/

section Phi

variable {t : α} {r : FreeGroup α}

/-- The isomorphism from the free group on the decorations of `mmTA` onto the Magnus subgroup
`mmA`, induced by the canonical map `F(T) →* ⟨β | w⟩` (injective by the Freiheitssatz). -/
noncomputable def mmIsoA
    (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r)) :
    FreeGroup (mmTA t r) ≃* mmA t r :=
  (MonoidHom.ofInjective (f := presentedGroupMap (mmW t r) (mmTA t r))
      (hFw hc (mmTA t r) hA)).trans
    (MulEquiv.subgroupCongr (range_presentedGroupMap (mmW t r) (mmTA t r)))

/-- The analogous isomorphism for the second associated subgroup. -/
noncomputable def mmIsoB
    (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) :
    FreeGroup (mmTB t r) ≃* mmB t r :=
  (MonoidHom.ofInjective (f := presentedGroupMap (mmW t r) (mmTB t r))
      (hFw hc (mmTB t r) hB)).trans
    (MulEquiv.subgroupCongr (range_presentedGroupMap (mmW t r) (mmTB t r)))

/-- The element of the first Magnus subgroup given by a decoration of `mmTA`. -/
noncomputable def mmGA (e : mmTA t r) : mmA t r :=
  ⟨PresentedGroup.of (e : mmBeta t r), Subgroup.subset_closure ⟨e, rfl⟩⟩

/-- The element of the second Magnus subgroup given by a decoration of `mmTB`. -/
noncomputable def mmGB (e : mmTB t r) : mmB t r :=
  ⟨PresentedGroup.of (e : mmBeta t r), Subgroup.subset_closure ⟨e, rfl⟩⟩

theorem mmIsoA_of
    (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r)) (e : mmTA t r) :
    ((mmIsoA (r := r) hFw hc hA) (FreeGroup.of e) : mmA t r) = mmGA e := by
  refine Subtype.ext ?_
  simp only [mmIsoA, MulEquiv.trans_apply, MonoidHom.ofInjective_apply,
    MulEquiv.subgroupCongr_apply, mmGA]
  exact presentedGroupMap_of_apply e

theorem mmIsoB_of
    (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) (e : mmTB t r) :
    ((mmIsoB (r := r) hFw hc hB) (FreeGroup.of e) : mmB t r) = mmGB e := by
  refine Subtype.ext ?_
  simp only [mmIsoB, MulEquiv.trans_apply, MonoidHom.ofInjective_apply,
    MulEquiv.subgroupCongr_apply, mmGB]
  exact presentedGroupMap_of_apply e

/-- The isomorphism between the two associated Magnus subgroups induced by the shift of the
decorations. -/
noncomputable def mmPhi
    (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) :
    mmA t r ≃* mmB t r :=
  (mmIsoA (r := r) hFw hc hA).symm.trans
    ((FreeGroup.freeGroupCongr (mmTshift t r)).trans (mmIsoB (r := r) hFw hc hB))

theorem mmPhi_gen
    (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (e : mmTA t r) :
    mmPhi (r := r) hFw hc hA hB (mmGA e) = mmGB (mmTshift t r e) := by
  have h1 : (mmIsoA (r := r) hFw hc hA).symm (mmGA e) = FreeGroup.of e := by
    rw [← mmIsoA_of (r := r) hFw hc hA e]
    exact MulEquiv.symm_apply_apply _ _
  rw [mmPhi, MulEquiv.trans_apply, h1]
  change mmIsoB (r := r) hFw hc hB (FreeGroup.map (mmTshift t r) (FreeGroup.of e)) =
    mmGB (mmTshift t r e)
  rw [FreeGroup.map.of]
  exact mmIsoB_of (r := r) hFw hc hB (mmTshift t r e)

end Phi

/-! ### The canonical map `⟨β | w⟩ →* ⟨α | r⟩` -/

section BaseHom

variable {t : α} {r : FreeGroup α}

/-- The canonical map `⟨β | w⟩ →* ⟨α | r⟩` sending the decoration `(x,k)` to the conjugate
`t ^ k * x * t ^ (-k)`: it is well defined because `r = magnusMap t w` by the telescoping
identity. -/
noncomputable def mmBaseHom (h : eps t r = 0) :
    PresentedGroup ({mmW t r} : Set (FreeGroup (mmBeta t r))) →*
      PresentedGroup ({r} : Set (FreeGroup α)) :=
  PresentedGroup.toGroup (f := fun p : mmBeta t r =>
    PresentedGroup.mk ({r} : Set (FreeGroup α))
      (magnusMap t (FreeGroup.of (p.1 : MMAlpha t)))) (by
      intro rel hrel
      rw [Set.mem_singleton_iff] at hrel
      subst hrel
      have hcomp : FreeGroup.lift (fun p : mmBeta t r =>
          PresentedGroup.mk ({r} : Set (FreeGroup α))
            (magnusMap t (FreeGroup.of (p.1 : MMAlpha t)))) =
          (PresentedGroup.mk ({r} : Set (FreeGroup α))).comp
            ((magnusMap t).comp (FreeGroup.map (fun p : mmBeta t r => (p.1 : MMAlpha t)))) := by
        refine FreeGroup.ext_hom _ _ fun p => ?_
        rw [MonoidHom.comp_apply, MonoidHom.comp_apply, FreeGroup.map.of,
          FreeGroup.lift_apply_of]
      rw [hcomp, MonoidHom.comp_apply, MonoidHom.comp_apply, mmW_map_val, magnusMap_mmList t r h]
      exact PresentedGroup.one_of_mem (Set.mem_singleton r))

theorem mmBaseHom_gen (h : eps t r = 0) (p : mmBeta t r) :
    mmBaseHom (r := r) h (PresentedGroup.of p) =
      (PresentedGroup.of t : PresentedGroup ({r} : Set (FreeGroup α))) ^ (p.1.2) *
        (PresentedGroup.of (p.1.1 : α)) *
        (PresentedGroup.of t : PresentedGroup ({r} : Set (FreeGroup α))) ^ (-(p.1.2)) := by
  rw [mmBaseHom, PresentedGroup.toGroup.of, magnusMap_apply t p.1.1 p.1.2]
  simp only [PresentedGroup.of, map_mul, map_zpow]

end BaseHom


/-- The base group `⟨β | w⟩` of the Magnus rewriting. -/
abbrev mmH (t : α) (r : FreeGroup α) : Type u :=
  PresentedGroup ({mmW t r} : Set (FreeGroup (mmBeta t r)))

/-- The one-relator group `⟨α | r⟩`. -/
abbrev mmG (r : FreeGroup α) : Type u := PresentedGroup ({r} : Set (FreeGroup α))

/-- The HNN extension in which `⟨α | r⟩` embeds. -/
noncomputable abbrev mmK (t : α) (r : FreeGroup α) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) : Type u :=
  HNNExtension (mmH t r) (mmA t r) (mmB t r) (mmPhi (t := t) (r := r) hFw hc hA hB)

variable {t : α} {r : FreeGroup α}

theorem mmPhi_of (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (p : mmBeta t r) (hy : PresentedGroup.of p ∈ mmA t r) (hp : p ∈ mmTA t r) :
    ((mmPhi (r := r) hFw hc hA hB ⟨PresentedGroup.of p, hy⟩ : mmB t r) : mmH t r)
      = PresentedGroup.of (mmBetaOf t r ((p.1.1, p.1.2 + 1) : MMAlpha t)) := by
  have hE : (⟨PresentedGroup.of p, hy⟩ : mmA t r) = mmGA (⟨p, hp⟩ : mmTA t r) := Subtype.ext rfl
  rw [hE, mmPhi_gen (r := r) hFw hc hA hB (⟨p, hp⟩ : mmTA t r)]
  refine congrArg PresentedGroup.of ?_
  refine Subtype.ext ?_
  rw [mmBetaOf_val t r (show ((p.1.1, p.1.2 + 1) : MMAlpha t) ∈ mmDecSet t r from hp)]
  rfl

theorem mmConjStep (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (p : mmBeta t r) (hp : p ∈ mmTA t r) :
    HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((p.1.1, p.1.2 + 1) : MMAlpha t)))
      = (HNNExtension.t : mmK t r hFw hc hA hB) *
          HNNExtension.of (PresentedGroup.of p) *
          (HNNExtension.t : mmK t r hFw hc hA hB)⁻¹ := by
  have h1 := HNNExtension.equiv_eq_conj (φ := mmPhi (t := t) (r := r) hFw hc hA hB)
    (⟨PresentedGroup.of p, Subgroup.subset_closure ⟨⟨p, hp⟩, rfl⟩⟩ : mmA t r)
  have h2 : ((mmPhi (r := r) hFw hc hA hB
      ⟨PresentedGroup.of p, Subgroup.subset_closure ⟨⟨p, hp⟩, rfl⟩⟩ : mmB t r) : mmH t r)
      = PresentedGroup.of (mmBetaOf t r ((p.1.1, p.1.2 + 1) : MMAlpha t)) := by
    rw [mmPhi_of (r := r) hFw hc hA hB p (Subgroup.subset_closure ⟨⟨p, hp⟩, rfl⟩) hp]
  rw [h2] at h1
  exact h1

theorem mmChain (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (x : {x : α // x ≠ t}) (i : ℤ) (hi : ((x, i) : MMAlpha t) ∈ mmDecSet t r) :
    ∀ (m : ℕ), (∀ s : ℕ, s < m → ((x, i + s + 1) : MMAlpha t) ∈ mmDecSet t r) →
      (HNNExtension.t : mmK t r hFw hc hA hB) ^ (m : ℤ) *
        HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i) : MMAlpha t))) *
        (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(m : ℤ))
      = HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i + m) : MMAlpha t))) := by
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
    intro hval
    have hval' : ∀ s : ℕ, s < m → ((x, i + s + 1) : MMAlpha t) ∈ mmDecSet t r :=
      fun s hs => hval s (Nat.lt_succ_of_lt hs)
    have hm : ((x, i + m) : MMAlpha t) ∈ mmDecSet t r := by
      rcases Nat.eq_zero_or_pos m with h0 | hpos
      · subst h0; simpa using hi
      · have h1 := hval (m - 1) (by omega)
        rwa [show ((x, i + ((m - 1 : ℕ) : ℤ) + 1) : MMAlpha t) = ((x, i + (m : ℤ)) : MMAlpha t)
          from by congr 1; omega] at h1
    have hmem : mmBetaOf t r ((x, i + m) : MMAlpha t) ∈ mmTA t r := by
      simp only [mmTA, Set.mem_ofPred_eq]
      rw [mmBetaOf_val t r hm]
      exact hval m (Nat.lt_succ_self m)
    have hst := mmConjStep (r := r) hFw hc hA hB (mmBetaOf t r ((x, i + m) : MMAlpha t)) hmem
    have hstep' : (HNNExtension.t : mmK t r hFw hc hA hB) *
          HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i + m) : MMAlpha t))) *
          (HNNExtension.t : mmK t r hFw hc hA hB)⁻¹
        = HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i + (m + 1)) : MMAlpha t))) := by
      rw [← hst, mmBetaOf_val t r hm]
      congr 1
      congr 1
      congr 1
      push_cast
      ring
    calc (HNNExtension.t : mmK t r hFw hc hA hB) ^ ((m + 1 : ℕ) : ℤ) *
            HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i) : MMAlpha t))) *
            (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-((m + 1 : ℕ) : ℤ))
        = (HNNExtension.t : mmK t r hFw hc hA hB) *
            ((HNNExtension.t : mmK t r hFw hc hA hB) ^ (m : ℤ) *
              HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i) : MMAlpha t))) *
              (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(m : ℤ))) *
            (HNNExtension.t : mmK t r hFw hc hA hB)⁻¹ := by group
      _ = (HNNExtension.t : mmK t r hFw hc hA hB) *
            HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i + m) : MMAlpha t))) *
            (HNNExtension.t : mmK t r hFw hc hA hB)⁻¹ := by rw [ih hval']
      _ = HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((x, i + (m + 1)) : MMAlpha t))) := hstep'

/-! ### The two maps -/

/-- The images of the generators under the map `⟨α | r⟩ →* HNN`. -/
noncomputable def mmThetaFun (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) : α → mmK t r hFw hc hA hB := by
  classical
  exact fun y => if hy : y = t then HNNExtension.t
    else (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(mmLo t r ⟨y, hy⟩)) *
      HNNExtension.of (PresentedGroup.of
        (mmBetaOf t r ((⟨y, hy⟩, mmLo t r ⟨y, hy⟩) : MMAlpha t))) *
      (HNNExtension.t : mmK t r hFw hc hA hB) ^ (mmLo t r ⟨y, hy⟩)

theorem mmA_eq_closure (t : α) (r : FreeGroup α) :
    mmA t r = Subgroup.closure (Set.range fun e : mmTA t r => PresentedGroup.of (e : mmBeta t r)) := rfl

theorem mmB_eq_closure (t : α) (r : FreeGroup α) :
    mmB t r = Subgroup.closure (Set.range fun e : mmTB t r => PresentedGroup.of (e : mmBeta t r)) := rfl

theorem mmBaseHom_mmPhiGA (h : eps t r = 0) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) (e : mmTA t r) :
    mmBaseHom (r := r) h ((mmPhi (r := r) hFw hc hA hB (mmGA e) : mmB t r) : mmH t r)
      = (PresentedGroup.of t : mmG r) ^ ((e : mmBeta t r).1.2 + 1) *
        PresentedGroup.of ((e : mmBeta t r).1.1 : α) *
        (PresentedGroup.of t : mmG r) ^ (-((e : mmBeta t r).1.2 + 1)) := by
  rw [show ((mmPhi (r := r) hFw hc hA hB (mmGA e) : mmB t r) : mmH t r)
      = PresentedGroup.of (mmBetaOf t r
          (((e : mmBeta t r).1.1, (e : mmBeta t r).1.2 + 1) : MMAlpha t)) from
    mmPhi_of (r := r) hFw hc hA hB (e : mmBeta t r) (Subgroup.subset_closure ⟨e, rfl⟩) e.2,
    mmBaseHom_gen]
  rw [mmBetaOf_val t r (show (((e : mmBeta t r).1.1, (e : mmBeta t r).1.2 + 1) : MMAlpha t)
      ∈ mmDecSet t r from e.2)]

theorem mmBaseHom_compat (h : eps t r = 0) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) :
    ∀ a : mmA t r, (PresentedGroup.of t : mmG r) * mmBaseHom (r := r) h (a : mmH t r)
      = mmBaseHom (r := r) h ((mmPhi (r := r) hFw hc hA hB a : mmB t r) : mmH t r) *
          (PresentedGroup.of t : mmG r) := by
  intro a
  refine Subgroup.closure_induction
    (p := fun y hy => (PresentedGroup.of t : mmG r) * mmBaseHom (r := r) h y
      = mmBaseHom (r := r) h
          ((mmPhi (r := r) hFw hc hA hB
              (⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r) : mmB t r) : mmH t r) *
          (PresentedGroup.of t : mmG r)) ?_ ?_ ?_ ?_ a.2
  · rintro y ⟨e, rfl⟩
    dsimp only
    rw [show (⟨PresentedGroup.of (e : mmBeta t r), _⟩ : mmA t r) = mmGA e from Subtype.ext rfl,
      mmBaseHom_mmPhiGA (r := r) h hFw hc hA hB e, mmBaseHom_gen]
    group
  · rw [show (⟨1, by rw [mmA_eq_closure]; exact Subgroup.one_mem _⟩ : mmA t r) = 1 from
        Subtype.ext rfl, MulEquiv.map_one (mmPhi (r := r) hFw hc hA hB),
      show (((1 : mmB t r)) : mmH t r) = 1 from rfl, map_one, mul_one, one_mul]
  · rintro y z hy hz ihy ihz
    have hE : (⟨y * z, by rw [mmA_eq_closure]; exact Subgroup.mul_mem _ hy hz⟩ : mmA t r)
        = (⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r) *
          (⟨z, by rw [mmA_eq_closure]; exact hz⟩ : mmA t r) := Subtype.ext rfl
    have hφ : ((mmPhi (r := r) hFw hc hA hB
          ((⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r) *
            (⟨z, by rw [mmA_eq_closure]; exact hz⟩ : mmA t r)) : mmB t r) : mmH t r)
        = ((mmPhi (r := r) hFw hc hA hB
              (⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r) : mmB t r) : mmH t r) *
          ((mmPhi (r := r) hFw hc hA hB
              (⟨z, by rw [mmA_eq_closure]; exact hz⟩ : mmA t r) : mmB t r) : mmH t r) := by
      rw [map_mul]; rfl
    rw [hE, hφ, map_mul, ← mul_assoc, ihy, mul_assoc, ihz, map_mul]
    group
  · rintro y hy ihy
    have hE : (⟨y⁻¹, by rw [mmA_eq_closure]; exact Subgroup.inv_mem _ hy⟩ : mmA t r)
        = (⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r)⁻¹ := Subtype.ext rfl
    have hφ : ((mmPhi (r := r) hFw hc hA hB
          ((⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r)⁻¹) : mmB t r) : mmH t r)
        = (((mmPhi (r := r) hFw hc hA hB
              (⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r) : mmB t r) : mmH t r))⁻¹ := by
      rw [map_inv]; rfl
    rw [hE, hφ, map_inv (mmBaseHom (r := r) h) y]
    have hY : mmBaseHom (r := r) h y
        = (PresentedGroup.of t : mmG r)⁻¹ *
            ((mmBaseHom (r := r) h ((mmPhi (r := r) hFw hc hA hB
                (⟨y, by rw [mmA_eq_closure]; exact hy⟩ : mmA t r) : mmB t r) : mmH t r)) *
              (PresentedGroup.of t : mmG r)) := by
      rw [← ihy]; group
    rw [hY, map_inv]
    group

/-- The canonical map `HNN →* ⟨α | r⟩`. -/
noncomputable def mmPsi (h : eps t r = 0) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) :
    mmK t r hFw hc hA hB →* mmG r :=
  HNNExtension.lift (mmBaseHom (r := r) h) (PresentedGroup.of t)
    (mmBaseHom_compat (r := r) h hFw hc hA hB)

theorem mmPsi_of (h : eps t r = 0) (hFw hc hA hB) (g : mmH t r) :
    mmPsi (r := r) h hFw hc hA hB (HNNExtension.of g) = mmBaseHom (r := r) h g :=
  HNNExtension.lift_of _ _ _ g

theorem mmPsi_t (h : eps t r = 0) (hFw hc hA hB) :
    mmPsi (r := r) h hFw hc hA hB (HNNExtension.t : mmK t r hFw hc hA hB)
      = (PresentedGroup.of t : mmG r) :=
  HNNExtension.lift_t _ _ _

theorem mmThetaFun_t (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) :
    mmThetaFun hFw hc hA hB t = (HNNExtension.t : mmK t r hFw hc hA hB) := by
  rw [mmThetaFun]
  rw [dif_pos rfl]

theorem mmThetaFun_ne (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    {y : α} (hy : y ≠ t) :
    mmThetaFun hFw hc hA hB y = (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(mmLo t r ⟨y, hy⟩)) *
      HNNExtension.of (PresentedGroup.of
        (mmBetaOf t r ((⟨y, hy⟩, mmLo t r ⟨y, hy⟩) : MMAlpha t))) *
      (HNNExtension.t : mmK t r hFw hc hA hB) ^ (mmLo t r ⟨y, hy⟩) := by
  rw [mmThetaFun]
  rw [dif_neg hy]

theorem mmTheta_rel (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (hrel : FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1) :
    ∀ rel ∈ ({r} : Set (FreeGroup α)), FreeGroup.lift (mmThetaFun hFw hc hA hB) rel = 1 := by
  intro rel hr
  rw [Set.mem_singleton_iff] at hr
  subst hr
  exact hrel

/-- The map `⟨α | r⟩ →* HNN` on generators. -/
noncomputable def mmTheta (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (hrel : FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1) :
    mmG r →* mmK t r hFw hc hA hB :=
  PresentedGroup.toGroup (f := mmThetaFun hFw hc hA hB) (mmTheta_rel hFw hc hA hB hrel)

theorem mmTheta_of (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (hrel : FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1) (y : α) :
    mmTheta hFw hc hA hB hrel (PresentedGroup.of y) = mmThetaFun hFw hc hA hB y :=
  PresentedGroup.toGroup.of (mmTheta_rel hFw hc hA hB hrel)


theorem mmPsi_comp_mmTheta (h : eps t r = 0) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (hrel : FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1) :
    (mmPsi h hFw hc hA hB).comp (mmTheta hFw hc hA hB hrel) = MonoidHom.id (mmG r) := by
  refine PresentedGroup.ext fun y => ?_
  show mmPsi h hFw hc hA hB (mmTheta hFw hc hA hB hrel (PresentedGroup.of y)) = PresentedGroup.of y
  rw [mmTheta_of]
  by_cases hy : y = t
  · subst hy
    rw [mmThetaFun_t, mmPsi_t]
  · rw [mmThetaFun_ne hFw hc hA hB hy, map_mul, map_mul, map_zpow, map_zpow, mmPsi_of, mmPsi_t,
      mmBaseHom_gen]
    rw [mmBetaOf_val t r (mmLo_mem_decSet t r ⟨y, hy⟩)]
    group

theorem mmTheta_comp_mmPsi (h : eps t r = 0) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r))
    (hrel : FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1) :
    (mmTheta hFw hc hA hB hrel).comp (mmPsi h hFw hc hA hB) = MonoidHom.id (mmK t r hFw hc hA hB) := by
  refine HNNExtension.hom_ext ?_ ?_
  · refine PresentedGroup.ext fun p => ?_
    show mmTheta hFw hc hA hB hrel (mmPsi h hFw hc hA hB (HNNExtension.of (PresentedGroup.of p)))
      = HNNExtension.of (PresentedGroup.of p)
    rw [mmPsi_of, mmBaseHom_gen, map_mul, map_mul, map_zpow, map_zpow, mmTheta_of, mmTheta_of]
    rw [mmThetaFun_ne hFw hc hA hB p.1.1.2, mmThetaFun_t]
    rw [show (⟨(p.1.1 : α), p.1.1.2⟩ : {x : α // x ≠ t}) = p.1.1 from Subtype.ext rfl]
    set lo := mmLo t r p.1.1 with hlo
    have hlo_le : lo ≤ p.1.2 := by rw [hlo]; exact p.2.1
    have hle_hi : p.1.2 ≤ mmHi t r p.1.1 := p.2.2
    have hm : 0 ≤ p.1.2 - lo := by omega
    have hm' : (((p.1.2 - lo).toNat : ℕ) : ℤ) = p.1.2 - lo := Int.toNat_of_nonneg hm
    have hchain := mmChain (r := r) hFw hc hA hB p.1.1 lo (by rw [hlo]; exact mmLo_mem_decSet t r p.1.1)
      ((p.1.2 - lo).toNat) (fun s hs => by
        have hs' : (s : ℤ) < p.1.2 - lo := by
          have h2 : (s : ℤ) < ((((p.1.2 - lo).toNat : ℕ)) : ℤ) := by
            rw [Nat.cast_lt]; exact hs
          rwa [hm'] at h2
        refine ⟨?_, ?_⟩
        · show mmLo t r p.1.1 ≤ lo + (s : ℤ) + 1
          omega
        · show lo + (s : ℤ) + 1 ≤ mmHi t r p.1.1
          omega)
    have hL : (HNNExtension.t : mmK t r hFw hc hA hB) ^ (p.1.2) *
        ((HNNExtension.t : mmK t r hFw hc hA hB) ^ (-lo) *
          HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((p.1.1, lo) : MMAlpha t))) *
          (HNNExtension.t : mmK t r hFw hc hA hB) ^ lo) *
        (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(p.1.2)) =
        (HNNExtension.t : mmK t r hFw hc hA hB) ^ (((p.1.2 - lo).toNat : ℕ) : ℤ) *
          HNNExtension.of (PresentedGroup.of (mmBetaOf t r ((p.1.1, lo) : MMAlpha t))) *
          (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(((p.1.2 - lo).toNat : ℕ) : ℤ)) := by
      rw [hm']
      group
    rw [hL, hchain]
    refine congrArg HNNExtension.of (congrArg PresentedGroup.of ?_)
    have : ((p.1.1, lo + ((p.1.2 - lo).toNat : ℕ)) : MMAlpha t) = p.1 := by
      refine Prod.ext rfl ?_
      rw [hm']
      ring
    rw [this]
    exact Subtype.ext (mmBetaOf_val t r p.2)
  · rw [MonoidHom.comp_apply, MonoidHom.id_apply, mmPsi_t, mmTheta_of, mmThetaFun_t]


theorem mmThetaFun_relator (h : eps t r = 0) (hFw : FreiheitssatzAt (mmW t r))
    (hc : IsCyclicallyReducedRelator (mmW t r))
    (hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r))
    (hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r)) :
    FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1 := by
  classical
  set Θ : FreeGroup (MMAlpha t) →* mmK t r hFw hc hA hB :=
    (FreeGroup.lift (mmThetaFun hFw hc hA hB)).comp (magnusMap t) with hΘ
  have hΘlift : Θ = FreeGroup.lift (fun p : MMAlpha t => Θ (FreeGroup.of p)) := by
    refine FreeGroup.ext_hom _ _ fun p => ?_
    rw [FreeGroup.lift_apply_of]
  have hval : ∀ p : MMAlpha t × Bool, p ∈ mmList t r →
      Θ (FreeGroup.of p.1) = HNNExtension.of (PresentedGroup.of (mmBetaOf t r p.1)) := by
    intro p hp
    have hp2 : p.1 ∈ mmDecSet t r := mmList_mem_decSet t r hp
    have hlo : mmLo t r p.1.1 ≤ p.1.2 := hp2.1
    have hhi : p.1.2 ≤ mmHi t r p.1.1 := hp2.2
    have hm : 0 ≤ p.1.2 - mmLo t r p.1.1 := by omega
    have hm' : (((p.1.2 - mmLo t r p.1.1).toNat : ℕ) : ℤ) = p.1.2 - mmLo t r p.1.1 :=
      Int.toNat_of_nonneg hm
    rw [hΘ, MonoidHom.comp_apply, magnusMap_apply t p.1.1 p.1.2]
    simp only [FreeGroup.lift_apply_of, map_mul, map_zpow]
    rw [mmThetaFun_t, mmThetaFun_ne hFw hc hA hB p.1.1.2]
    rw [show (⟨(p.1.1.1 : α), p.1.1.2⟩ : {x : α // x ≠ t}) = p.1.1 from Subtype.ext rfl]
    have hchain := mmChain (r := r) hFw hc hA hB p.1.1 (mmLo t r p.1.1)
      (mmLo_mem_decSet t r p.1.1) ((p.1.2 - mmLo t r p.1.1).toNat) (fun s hs => by
        have hs' : (s : ℤ) < p.1.2 - mmLo t r p.1.1 := by
          have h2 : (s : ℤ) < ((((p.1.2 - mmLo t r p.1.1).toNat : ℕ)) : ℤ) := by
            rw [Nat.cast_lt]; exact hs
          rwa [hm'] at h2
        refine ⟨?_, ?_⟩
        · show mmLo t r p.1.1 ≤ mmLo t r p.1.1 + (s : ℤ) + 1
          omega
        · show mmLo t r p.1.1 + (s : ℤ) + 1 ≤ mmHi t r p.1.1
          omega)
    have hL : (HNNExtension.t : mmK t r hFw hc hA hB) ^ (p.1.2) *
        ((HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(mmLo t r p.1.1)) *
          HNNExtension.of (PresentedGroup.of (mmBetaOf t r (p.1.1, mmLo t r p.1.1))) *
          (HNNExtension.t : mmK t r hFw hc hA hB) ^ (mmLo t r p.1.1)) *
        (HNNExtension.t : mmK t r hFw hc hA hB) ^ (-(p.1.2)) =
        (HNNExtension.t : mmK t r hFw hc hA hB) ^ (((p.1.2 - mmLo t r p.1.1).toNat : ℕ) : ℤ) *
          HNNExtension.of (PresentedGroup.of (mmBetaOf t r (p.1.1, mmLo t r p.1.1))) *
          (HNNExtension.t : mmK t r hFw hc hA hB) ^
            (-(((p.1.2 - mmLo t r p.1.1).toNat : ℕ) : ℤ)) := by
      rw [hm']
      group
    rw [hL, hchain]
    refine congrArg HNNExtension.of (congrArg PresentedGroup.of ?_)
    have hpair : ((p.1.1, mmLo t r p.1.1 + ((p.1.2 - mmLo t r p.1.1).toNat : ℕ)) : MMAlpha t)
        = p.1 := by
      refine Prod.ext rfl ?_
      rw [hm']
      ring
    rw [hpair]
  have hL : Θ (FreeGroup.mk (mmList t r))
      = FreeGroup.lift (fun p : MMAlpha t => HNNExtension.of (PresentedGroup.of (mmBetaOf t r p)))
          (FreeGroup.mk (mmList t r)) := by
    rw [hΘlift, FreeGroup.lift_mk, FreeGroup.lift_mk]
    refine congrArg List.prod (List.map_congr_left ?_)
    intro x hx
    rw [hval x hx]
  have hG0 : FreeGroup.lift (fun p : MMAlpha t =>
        HNNExtension.of (PresentedGroup.of (mmBetaOf t r p)))
      = (HNNExtension.of : mmH t r →* mmK t r hFw hc hA hB).comp
          ((PresentedGroup.mk ({mmW t r} : Set (FreeGroup (mmBeta t r)))).comp
            (FreeGroup.map (mmBetaOf t r))) := by
    refine FreeGroup.ext_hom _ _ fun p => ?_
    simp only [MonoidHom.comp_apply, FreeGroup.lift_apply_of, FreeGroup.map.of]
    rfl
  have hmain : Θ (FreeGroup.mk (mmList t r)) = 1 := by
    rw [hL, hG0, MonoidHom.comp_apply, MonoidHom.comp_apply, FreeGroup.map.mk]
    rw [show (mmList t r).map (fun p => (mmBetaOf t r p.1, p.2)) = mmWL t r from rfl]
    rw [show FreeGroup.mk (mmWL t r) = mmW t r from rfl]
    rw [PresentedGroup.one_of_mem (Set.mem_singleton _), map_one]
  calc (FreeGroup.lift (mmThetaFun hFw hc hA hB)) r
      = (FreeGroup.lift (mmThetaFun hFw hc hA hB)) (magnusMap t (FreeGroup.mk (mmList t r))) := by
        rw [magnusMap_mmList t r h]
    _ = Θ (FreeGroup.mk (mmList t r)) := rfl
    _ = 1 := hmain


section FSExtract

variable {γ : Type u} {δ : Type v}

/-!
## The Freiheitssatz over a finite alphabet and its transport

The Freiheitssatz hypothesis of the main theorem is stated for relators over *every* type in a
fixed universe, while the relator of the Magnus rewriting lives in the universe of `α`.  The
transport is through a finite generating set of the relator: the Freiheitssatz at a relator whose
letter set is finite is obtained from the hypothesis by an equivalence of finite alphabets, and
extended to arbitrary `T` by compactness, using that a subgroup generated by a subset is the
directed union of the subgroups generated by its finite subsets.
-/

/-- The relator condition for the presentation isomorphism induced by an equivalence. -/
theorem presRel (e : γ ≃ δ) (s : FreeGroup γ) :
    ∀ rel ∈ ({s} : Set (FreeGroup γ)),
      FreeGroup.lift (fun a : γ => PresentedGroup.of (rels := {FreeGroup.map (e : γ → δ) s}) (e a))
        rel = 1 := by
  intro rel hrel
  rw [Set.mem_singleton_iff] at hrel
  rw [hrel]
  have hcomp : FreeGroup.lift
      (fun a : γ => PresentedGroup.of (rels := {FreeGroup.map (e : γ → δ) s}) (e a)) =
      (PresentedGroup.mk ({FreeGroup.map (e : γ → δ) s} : Set (FreeGroup δ))).comp
        (FreeGroup.map (e : γ → δ)) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    rw [MonoidHom.comp_apply, FreeGroup.map.of, FreeGroup.lift_apply_of]
    rfl
  rw [hcomp, MonoidHom.comp_apply, PresentedGroup.one_of_mem (Set.mem_singleton _)]

/-- The inverse relator condition. -/
theorem presRelSymm (e : γ ≃ δ) (s : FreeGroup γ) :
    ∀ rel ∈ ({FreeGroup.map (e : γ → δ) s} : Set (FreeGroup δ)),
      FreeGroup.lift (fun b : δ => PresentedGroup.of (rels := {s}) (e.symm b)) rel = 1 := by
  intro rel hrel
  rw [Set.mem_singleton_iff] at hrel
  rw [hrel]
  have hcomp : FreeGroup.lift (fun b : δ => PresentedGroup.of (rels := {s}) (e.symm b)) =
      (PresentedGroup.mk ({s} : Set (FreeGroup γ))).comp (FreeGroup.map (e.symm : δ → γ)) := by
    refine FreeGroup.ext_hom _ _ fun b => ?_
    rw [MonoidHom.comp_apply, FreeGroup.map.of, FreeGroup.lift_apply_of]
    rfl
  rw [hcomp, MonoidHom.comp_apply,
    show FreeGroup.map (e.symm : δ → γ) (FreeGroup.map (e : γ → δ) s) = s from by
      have h1 : FreeGroup.map (e.symm : δ → γ) (FreeGroup.map (e : γ → δ) s) = s :=
        MulEquiv.symm_apply_apply (FreeGroup.freeGroupCongr e) s
      rw [h1],
    PresentedGroup.one_of_mem (Set.mem_singleton _)]

/-- The presentation map induced by an equivalence of alphabets. -/
noncomputable def presHom (e : γ ≃ δ) (s : FreeGroup γ) :
    PresentedGroup ({s} : Set (FreeGroup γ)) →*
      PresentedGroup ({FreeGroup.map (e : γ → δ) s} : Set (FreeGroup δ)) :=
  PresentedGroup.toGroup (f := fun a : γ => PresentedGroup.of (e a)) (presRel e s)

/-- Its inverse. -/
noncomputable def presHomSymm (e : γ ≃ δ) (s : FreeGroup γ) :
    PresentedGroup ({FreeGroup.map (e : γ → δ) s} : Set (FreeGroup δ)) →*
      PresentedGroup ({s} : Set (FreeGroup γ)) :=
  PresentedGroup.toGroup (f := fun b : δ => PresentedGroup.of (e.symm b)) (presRelSymm e s)

theorem presHom_of (e : γ ≃ δ) (s : FreeGroup γ) (a : γ) :
    presHom e s (PresentedGroup.of a) = PresentedGroup.of (e a) :=
  PresentedGroup.toGroup.of (presRel e s)

theorem presHomSymm_of (e : γ ≃ δ) (s : FreeGroup γ) (b : δ) :
    presHomSymm e s (PresentedGroup.of b) = PresentedGroup.of (e.symm b) :=
  PresentedGroup.toGroup.of (presRelSymm e s)

/-- The presentation isomorphism induced by an equivalence of alphabets. -/
noncomputable def presEquiv (e : γ ≃ δ) (s : FreeGroup γ) :
    PresentedGroup ({s} : Set (FreeGroup γ)) ≃*
      PresentedGroup ({FreeGroup.map (e : γ → δ) s} : Set (FreeGroup δ)) :=
  MonoidHom.toMulEquiv (presHom e s) (presHomSymm e s)
    (by
      refine PresentedGroup.ext fun a => ?_
      show presHomSymm e s (presHom e s (PresentedGroup.of a)) = PresentedGroup.of a
      rw [presHom_of, presHomSymm_of]
      simp)
    (by
      refine PresentedGroup.ext fun b => ?_
      show presHom e s (presHomSymm e s (PresentedGroup.of b)) = PresentedGroup.of b
      rw [presHomSymm_of, presHom_of]
      simp)

theorem presEquiv_of (e : γ ≃ δ) (s : FreeGroup γ) (a : γ) :
    presEquiv e s (PresentedGroup.of a) = PresentedGroup.of (e a) :=
  presHom_of e s a

/-- Injectivity of `presentedGroupMap` transfers across an equivalence of alphabets. -/
theorem injective_presentedGroupMap_of_map_equiv (e : γ ≃ δ) (s : FreeGroup γ) (T : Set γ)
    (h : Function.Injective
      (presentedGroupMap (FreeGroup.map (e : γ → δ) s) (e '' T))) :
    Function.Injective (presentedGroupMap s T) := by
  have key : (presEquiv e s).toMonoidHom.comp (presentedGroupMap s T) =
      (presentedGroupMap (FreeGroup.map (e : γ → δ) s) (e '' T)).comp
        (FreeGroup.map (fun a : T => (⟨e (a : γ), ⟨(a : γ), a.2, rfl⟩⟩ : e '' T))) := by
    refine FreeGroup.ext_hom _ _ fun t => ?_
    show (presEquiv e s) (presentedGroupMap s T (FreeGroup.of t)) =
      presentedGroupMap (FreeGroup.map (e : γ → δ) s) (e '' T)
        (FreeGroup.of (⟨e (t : γ), ⟨(t : γ), t.2, rfl⟩⟩ : e '' T))
    rw [presentedGroupMap_of_apply, presEquiv_of, presentedGroupMap_of_apply]
  have hinj : Function.Injective
      ((presentedGroupMap (FreeGroup.map (e : γ → δ) s) (e '' T)).comp
        (FreeGroup.map (fun a : T => (⟨e (a : γ), ⟨(a : γ), a.2, rfl⟩⟩ : e '' T)))) :=
    h.comp (FreeGroup.map_injective (fun a b hab =>
      Subtype.ext (e.injective (by
        simpa using congrArg (fun z : e '' T => (z : δ)) hab))))
  rw [← key] at hinj
  intro x y hxy
  exact hinj (by rw [MonoidHom.comp_apply, MonoidHom.comp_apply, hxy])

/-- Cyclic reducedness transfers across an injective relabelling. -/
theorem isCyclicallyReducedRelator_map_equiv (e : γ ≃ δ) (s : FreeGroup γ)
    (h : IsCyclicallyReducedRelator s) :
    IsCyclicallyReducedRelator (FreeGroup.map (e : γ → δ) s) := by
  classical
  rw [IsCyclicallyReducedRelator] at h ⊢
  rw [isCyclicallyReduced_iff_isReduced_append_self] at h ⊢
  rw [ORReductions.FreeGroupGens.toWord_map_of_injective e.injective s]
  rw [ORReductions.FreeGroupGens.mapWord_eq, ← List.map_append]
  exact ORReductions.FreeGroupGens.isReduced_mapWord e.injective h

/-- The Freiheitssatz transports backwards along an equivalence of alphabets. -/
theorem freiheitssatzAt_of_map_equiv (e : γ ≃ δ) (s : FreeGroup γ)
    (h : FreiheitssatzAt (FreeGroup.map (e : γ → δ) s)) : FreiheitssatzAt s := by
  intro hcyc T hT
  refine injective_presentedGroupMap_of_map_equiv e s T
    (h (isCyclicallyReducedRelator_map_equiv e s hcyc) (e '' T) ?_)
  intro hmem
  apply hT
  have hle : Subgroup.closure (FreeGroup.map (e : γ → δ) '' (FreeGroup.of '' T)) ≤
      Subgroup.comap (FreeGroup.map (e.symm : δ → γ)) (Subgroup.closure (FreeGroup.of '' T)) := by
    rw [Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    obtain ⟨a, ha, rfl⟩ := hx
    show FreeGroup.map (e.symm : δ → γ) (FreeGroup.map (e : γ → δ) (FreeGroup.of a))
      ∈ Subgroup.closure (FreeGroup.of '' T)
    rw [show FreeGroup.map (e.symm : δ → γ) (FreeGroup.map (e : γ → δ) (FreeGroup.of a))
        = FreeGroup.of a from
      MulEquiv.symm_apply_apply (FreeGroup.freeGroupCongr e) (FreeGroup.of a)]
    exact Subgroup.subset_closure ⟨a, ha, rfl⟩
  have himg : FreeGroup.map (e : γ → δ) '' (FreeGroup.of '' T) = FreeGroup.of '' (e '' T) := by
    ext x
    constructor
    · rintro ⟨y, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨e a, ⟨a, ha, rfl⟩, by simp [FreeGroup.map.of]⟩
    · rintro ⟨b, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨FreeGroup.of a, ⟨a, ha, rfl⟩, by simp [FreeGroup.map.of]⟩
  rw [himg] at hle
  have h1 : FreeGroup.map (e.symm : δ → γ) (FreeGroup.map (e : γ → δ) s) ∈
      Subgroup.closure (FreeGroup.of '' T) := hle hmem
  have h2 : FreeGroup.map (e.symm : δ → γ) (FreeGroup.map (e : γ → δ) s) = s :=
    MulEquiv.symm_apply_apply (FreeGroup.freeGroupCongr e) s
  rwa [h2] at h1


/-- Splitting off the unused generators, with the relator of the sub-presentation *specified*. -/
theorem coprodIso_of_supported {γ : Type u} (s : FreeGroup γ) (Z : Set γ)
    (sz : FreeGroup Z) (hsz : FreeGroup.map (Subtype.val : Z → γ) sz = s) :
    ∃ Ψ : PresentedGroup ({s} : Set (FreeGroup γ)) ≃*
        Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup Z))) (FreeGroup {a : γ // a ∉ Z}),
      (∀ a : Z, Ψ.symm (Monoid.Coprod.inl (PresentedGroup.of a)) = PresentedGroup.of (a : γ)) ∧
      (∀ a : {a : γ // a ∉ Z}, Ψ.symm (Monoid.Coprod.inr (FreeGroup.of a))
        = PresentedGroup.of (a : γ)) := by
  classical
  let β : Type u := {a : γ // a ∉ Z}
  let σ : FreeGroup ↥Z →* FreeGroup γ := FreeGroup.map (fun a : ↥Z => (a : γ))
  let τ : FreeGroup β →* FreeGroup γ := FreeGroup.map (fun b : β => (b : γ))
  have hst : Set.MapsTo (⇑σ) ({sz} : Set (FreeGroup ↥Z)) ({s} : Set (FreeGroup γ)) := by
    intro x hx
    simp only [Set.mem_singleton_iff] at hx ⊢
    rw [hx]; exact hsz
  let φ₁ : PresentedGroup ({sz} : Set (FreeGroup ↥Z)) →* PresentedGroup ({s} : Set (FreeGroup γ)) :=
    PresentedGroup.map σ hst
  let φ₂ : FreeGroup β →* PresentedGroup ({s} : Set (FreeGroup γ)) :=
    (PresentedGroup.mk ({s} : Set (FreeGroup γ))).comp τ
  let φ : Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup ↥Z))) (FreeGroup β) →*
      PresentedGroup ({s} : Set (FreeGroup γ)) := Monoid.Coprod.lift φ₁ φ₂
  let θ' : γ → Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup ↥Z))) (FreeGroup β) :=
    fun a => if ha : a ∈ Z then Monoid.Coprod.inl (PresentedGroup.of (⟨a, ha⟩ : ↥Z))
              else Monoid.Coprod.inr (FreeGroup.of (⟨a, ha⟩ : β))
  let θ : FreeGroup γ →* Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup ↥Z))) (FreeGroup β) :=
    FreeGroup.lift θ'
  have hφ_inl : ∀ x, φ (Monoid.Coprod.inl x) = φ₁ x := fun x => Monoid.Coprod.lift_apply_inl φ₁ φ₂ x
  have hφ_inr : ∀ y, φ (Monoid.Coprod.inr y) = φ₂ y := fun y => Monoid.Coprod.lift_apply_inr φ₁ φ₂ y
  have hφ₁_of : ∀ x : ↥Z, φ₁ (PresentedGroup.of x) = PresentedGroup.of (x : γ) := by
    intro x
    change PresentedGroup.map σ hst (PresentedGroup.of x) = PresentedGroup.of (x : γ)
    rw [show PresentedGroup.map σ hst (PresentedGroup.of x) =
        PresentedGroup.mk ({s} : Set (FreeGroup γ)) (σ (FreeGroup.of x)) from rfl]
    rw [show σ (FreeGroup.of x) = FreeGroup.of (x : γ) from FreeGroup.map.of]
    rfl
  have hφ₂_of : ∀ y : β, φ₂ (FreeGroup.of y) = PresentedGroup.of (y : γ) := by
    intro y
    change (PresentedGroup.mk ({s} : Set (FreeGroup γ))).comp τ (FreeGroup.of y) =
      PresentedGroup.of (y : γ)
    rw [MonoidHom.comp_apply, show τ (FreeGroup.of y) = FreeGroup.of (y : γ) from FreeGroup.map.of]
    rfl
  have hθ_of : ∀ x : γ, θ (FreeGroup.of x) = θ' x := fun x => FreeGroup.lift_apply_of
  have hθσ : θ.comp σ = (Monoid.Coprod.inl : PresentedGroup ({sz} : Set (FreeGroup ↥Z)) →*
      Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup ↥Z))) (FreeGroup β)).comp
      (PresentedGroup.mk ({sz} : Set (FreeGroup ↥Z))) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    show θ (σ (FreeGroup.of a)) =
      Monoid.Coprod.inl (PresentedGroup.mk ({sz} : Set (FreeGroup ↥Z)) (FreeGroup.of a))
    rw [show σ (FreeGroup.of a) = FreeGroup.of (a : γ) from FreeGroup.map.of, hθ_of]
    rw [show θ' (a : γ) = Monoid.Coprod.inl (PresentedGroup.of (⟨(a : γ), a.2⟩ : ↥Z)) from
      dif_pos a.2]
    rfl
  have hθr : θ s = 1 := by
    rw [← hsz, ← MonoidHom.comp_apply, hθσ]
    rw [MonoidHom.comp_apply, PresentedGroup.one_of_mem (Set.mem_singleton sz), map_one]
  let ψ : PresentedGroup ({s} : Set (FreeGroup γ)) →*
      Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup ↥Z))) (FreeGroup β) :=
    PresentedGroup.toGroup (f := θ') (by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      change θ s = 1
      exact hθr)
  have hψ_of : ∀ x : γ, ψ (PresentedGroup.of x) = θ' x := fun x => PresentedGroup.toGroup.of _
  have hφψ : φ.comp ψ = MonoidHom.id (PresentedGroup ({s} : Set (FreeGroup γ))) := by
    refine PresentedGroup.ext fun a => ?_
    show φ (ψ (PresentedGroup.of a)) = PresentedGroup.of a
    rw [hψ_of]
    by_cases ha : a ∈ Z
    · rw [show θ' a = Monoid.Coprod.inl (PresentedGroup.of (⟨a, ha⟩ : ↥Z)) from dif_pos ha,
        hφ_inl, hφ₁_of]
    · rw [show θ' a = Monoid.Coprod.inr (FreeGroup.of (⟨a, ha⟩ : β)) from dif_neg ha,
        hφ_inr, hφ₂_of]
  have hψφ : ψ.comp φ =
      MonoidHom.id (Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup ↥Z))) (FreeGroup β)) := by
    refine Monoid.Coprod.hom_ext ?_ ?_
    · rw [MonoidHom.comp_assoc,
        show φ.comp Monoid.Coprod.inl = φ₁ from Monoid.Coprod.lift_comp_inl φ₁ φ₂,
        MonoidHom.id_comp]
      refine PresentedGroup.ext fun x => ?_
      show ψ (φ₁ (PresentedGroup.of x)) = Monoid.Coprod.inl (PresentedGroup.of x)
      rw [hφ₁_of, hψ_of]
      rw [show θ' (x : γ) = Monoid.Coprod.inl (PresentedGroup.of (⟨(x : γ), x.2⟩ : ↥Z)) from
        dif_pos x.2]
    · rw [MonoidHom.comp_assoc,
        show φ.comp Monoid.Coprod.inr = φ₂ from Monoid.Coprod.lift_comp_inr φ₁ φ₂,
        MonoidHom.id_comp]
      refine FreeGroup.ext_hom _ _ fun y => ?_
      show ψ (φ₂ (FreeGroup.of y)) = Monoid.Coprod.inr (FreeGroup.of y)
      rw [hφ₂_of, hψ_of]
      rw [show θ' (y : γ) = Monoid.Coprod.inr (FreeGroup.of (⟨(y : γ), y.2⟩ : β)) from dif_neg y.2]
  let Ψ : PresentedGroup ({s} : Set (FreeGroup γ)) ≃*
      Monoid.Coprod (PresentedGroup ({sz} : Set (FreeGroup Z))) (FreeGroup {a : γ // a ∉ Z}) :=
    MonoidHom.toMulEquiv ψ φ hφψ hψφ
  refine ⟨Ψ, ?_, ?_⟩
  · intro a
    have h1 : Ψ (PresentedGroup.of (a : γ)) = Monoid.Coprod.inl (PresentedGroup.of a) := by
      change ψ (PresentedGroup.of (a : γ)) = _
      rw [hψ_of]
      exact dif_pos a.2
    rw [← h1, MulEquiv.symm_apply_apply]
  · intro a
    have h1 : Ψ (PresentedGroup.of (a : γ)) = Monoid.Coprod.inr (FreeGroup.of a) := by
      change ψ (PresentedGroup.of (a : γ)) = _
      rw [hψ_of]
      exact dif_neg a.2
    rw [← h1, MulEquiv.symm_apply_apply]

/-- Injectivity of `presentedGroupMap` transfers from a sub-alphabet. -/
theorem injective_presentedGroupMap_of_supported {γ : Type u} (s : FreeGroup γ) (Z : Set γ)
    (sz : FreeGroup Z) (hsz : FreeGroup.map (Subtype.val : Z → γ) sz = s)
    (T : Set γ) (hT : T ⊆ Z)
    (h : Function.Injective (presentedGroupMap sz (Subtype.val ⁻¹' T))) :
    Function.Injective (presentedGroupMap s T) := by
  classical
  obtain ⟨Ψ, hΨZ, hΨout⟩ := coprodIso_of_supported s Z sz hsz
  have key : presentedGroupMap s T = Ψ.symm.toMonoidHom.comp
      ((Monoid.Coprod.inl).comp ((presentedGroupMap sz (Subtype.val ⁻¹' T)).comp
        (FreeGroup.map (fun t : T => (⟨⟨(t : γ), hT t.2⟩, t.2⟩ : Subtype.val ⁻¹' T))))) := by
    refine FreeGroup.ext_hom _ _ fun t => ?_
    exact (hΨZ ⟨(t : γ), hT t.2⟩).symm
  rw [key]
  exact Ψ.symm.injective.comp (Monoid.Coprod.inl_injective.comp (h.comp (FreeGroup.map_injective
      (fun a b hab => Subtype.ext (by
        simpa using congrArg (fun z : Subtype.val ⁻¹' T => (((z : Z)) : γ)) hab)))))


theorem notMem_closure_of_map_subtype {γ : Type u} (s : FreeGroup γ) (Z : Set γ) (sz : FreeGroup Z)
    (hsz : FreeGroup.map (Subtype.val : Z → γ) sz = s) (T : Set γ) (hT : T ⊆ Z)
    (h : s ∉ Subgroup.closure (FreeGroup.of '' T)) :
    sz ∉ Subgroup.closure (FreeGroup.of '' (Subtype.val ⁻¹' T)) := by
  intro hmem
  apply h
  have hle : Subgroup.closure (FreeGroup.of '' (Subtype.val ⁻¹' T)) ≤
      Subgroup.comap (FreeGroup.map (Subtype.val : Z → γ)) (Subgroup.closure (FreeGroup.of '' T)) := by
    rw [Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    show FreeGroup.map (Subtype.val : Z → γ) (FreeGroup.of x) ∈ Subgroup.closure (FreeGroup.of '' T)
    rw [FreeGroup.map.of]
    exact Subgroup.subset_closure ⟨(x : γ), hx, rfl⟩
  have h1 : FreeGroup.map (Subtype.val : Z → γ) sz ∈ Subgroup.closure (FreeGroup.of '' T) := hle hmem
  rwa [hsz] at h1

theorem isReduced_of_map_word {γ δ : Type*} (f : γ → δ) (hf : Function.Injective f) :
    ∀ {L : List (γ × Bool)},
      FreeGroup.IsReduced (L.map (fun p => (f p.1, p.2))) → FreeGroup.IsReduced L
  | [], _ => FreeGroup.IsReduced.nil
  | [_], _ => FreeGroup.IsReduced.singleton
  | a :: b :: t, h => by
      rw [List.map_cons, List.map_cons, FreeGroup.isReduced_cons_cons] at h
      rw [FreeGroup.isReduced_cons_cons]
      exact ⟨fun hab => h.1 (by rw [hab]), isReduced_of_map_word f hf h.2⟩

theorem isCyclicallyReducedRelator_of_map_subtype {γ : Type u} (Z : Set γ) (sz : FreeGroup Z)
    (h : IsCyclicallyReducedRelator (FreeGroup.map (Subtype.val : Z → γ) sz)) :
    IsCyclicallyReducedRelator sz := by
  letI : DecidableEq γ := Classical.decEq γ
  letI : DecidableEq Z := Classical.decEq Z
  rw [IsCyclicallyReducedRelator] at h ⊢
  rw [isCyclicallyReduced_iff_isReduced_append_self] at h ⊢
  rw [ORReductions.FreeGroupGens.toWord_map_of_injective Subtype.val_injective sz] at h
  rw [ORReductions.FreeGroupGens.mapWord_eq, ← List.map_append] at h
  exact isReduced_of_map_word (Subtype.val : Z → γ) Subtype.val_injective h

theorem injective_presentedGroupMap_of_finite {γ : Type u} (s : FreeGroup γ) (T : Set γ)
    (h : ∀ T₀ : Set γ, T₀ ⊆ T → T₀.Finite →
      Function.Injective (presentedGroupMap s T₀)) :
    Function.Injective (presentedGroupMap s T) := by
  classical
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro x hx
  rw [MonoidHom.mem_ker] at hx
  set T₀ : Set γ := Subtype.val '' FreeGroup.gens x with hT₀
  have hsub : T₀ ⊆ T := by
    rintro a ⟨t, -, rfl⟩
    exact t.2
  have hfin : T₀.Finite := (ORReductions.FreeGroupGens.freeGens_finite x).image Subtype.val
  have hfac : (presentedGroupMap s T).comp
      (FreeGroup.map (fun a : T₀ => (⟨(a : γ), hsub a.2⟩ : T))) = presentedGroupMap s T₀ := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    rw [MonoidHom.comp_apply, FreeGroup.map.of, presentedGroupMap_of_apply,
      presentedGroupMap_of_apply]
  have hxrange : x ∈ (FreeGroup.map (fun a : T₀ => (⟨(a : γ), hsub a.2⟩ : T))).range := by
    have hcl : Subgroup.closure (FreeGroup.of '' FreeGroup.gens x) ≤
        (FreeGroup.map (fun a : T₀ => (⟨(a : γ), hsub a.2⟩ : T))).range := by
      rw [Subgroup.closure_le]
      rintro _ ⟨g, hg, rfl⟩
      exact ⟨FreeGroup.of (⟨g, ⟨g, hg, rfl⟩⟩), by rw [FreeGroup.map.of]⟩
    exact hcl (ORReductions.FreeGroupGens.freeGens_mem_closure x)
  obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hxrange
  have hy1 : y = 1 := by
    refine h T₀ hsub hfin ?_
    have h3 : presentedGroupMap s T₀ y = 1 := by
      rw [← hfac, MonoidHom.comp_apply, hy]
      exact hx
    exact h3
  rw [← hy, hy1, map_one]


/-- The Freiheitssatz for a relator over a finite alphabet, from the universe-polymorphic
hypothesis. -/
theorem freiheitssatzAt_of_fintype {Z : Type u} [Fintype Z] (sz : FreeGroup Z)
    (hF : ∀ {δ : Type v} (w : FreeGroup δ), FreiheitssatzAt w) : FreiheitssatzAt sz := by
  classical
  let e : Z ≃ ULift.{v} (Fin (Fintype.card Z)) := (Fintype.equivFin Z).trans Equiv.ulift.symm
  have h1 : FreiheitssatzAt (FreeGroup.map (e : Z → ULift.{v} (Fin (Fintype.card Z))) sz) := hF _
  exact freiheitssatzAt_of_map_equiv e sz h1

/-- The Freiheitssatz at `s`, from the Freiheitssatz at every relator over a type in the same
universe.  The transport is through a finite generating set of the relator. -/
theorem freiheitssatzAt_of_forall {γ : Type u} (s : FreeGroup γ)
    (hF : ∀ {δ : Type v} (w : FreeGroup δ), FreiheitssatzAt w) : FreiheitssatzAt s := by
  classical
  intro hcyc T hT
  refine injective_presentedGroupMap_of_finite s T ?_
  intro T₀ hT₀ hT₀fin
  set Z : Set γ := relatorLetters s ∪ T₀ with hZdef
  have hZfin : Z.Finite := (finite_relatorLetters s).union hT₀fin
  have hsub : SupportedOn s Z := Set.subset_union_left
  obtain ⟨sz, hsz0⟩ := exists_lift_of_supportedOn (Z := Z) hsub
  have hsz : FreeGroup.map (Subtype.val : Z → γ) sz = s := by
    rw [FreeGroup.map_eq_lift]
    exact hsz0
  haveI : Fintype Z := hZfin.fintype
  have hT₀' : T₀ ⊆ Z := Set.subset_union_right
  have hcycZ : IsCyclicallyReducedRelator sz := by
    refine isCyclicallyReducedRelator_of_map_subtype Z sz ?_
    rw [hsz]
    exact hcyc
  have hmem : sz ∉ Subgroup.closure (FreeGroup.of '' (Subtype.val ⁻¹' T₀)) := by
    refine notMem_closure_of_map_subtype s Z sz hsz T₀ hT₀' ?_
    exact fun h => hT (Subgroup.closure_mono (Set.image_mono hT₀) h)
  have hFZ : FreiheitssatzAt sz := freiheitssatzAt_of_fintype sz hF
  have hinj : Function.Injective (presentedGroupMap sz (Subtype.val ⁻¹' T₀)) := hFZ hcycZ _ hmem
  exact injective_presentedGroupMap_of_supported s Z sz hsz T₀ hT₀' hinj


end FSExtract

theorem mmStepData_of_expsum_zero {α : Type*} (r : FreeGroup α) (t : α)
    (hF : ∀ {γ : Type*} (s : FreeGroup γ), Work.OROneRel.FreiheitssatzAt s)
    (hr : Work.OROneRel.IsCyclicallyReducedRelator r) (h1 : r ≠ 1)
    (ht : t ∈ Work.OROneRel.relatorLetters r) (h : Work.OROneRel.eps t r = 0) :
    Work.OROneRel.HasMMStepData r := by
  classical
  have hFw : FreiheitssatzAt (mmW t r) := freiheitssatzAt_of_forall (mmW t r) hF
  have hred : FreeGroup.IsReduced (mmWL t r) := mmWL_isReduced t r hr h
  have hc : IsCyclicallyReducedRelator (mmW t r) := mmW_isCyclicallyReduced hr h
  have hA : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTA t r) :=
    mmW_notMem_closure_TA h1 ht h hred
  have hB : (mmW t r) ∉ Subgroup.closure (FreeGroup.of '' mmTB t r) :=
    mmW_notMem_closure_TB h1 ht h hred
  have hrel : FreeGroup.lift (mmThetaFun hFw hc hA hB) r = 1 :=
    mmThetaFun_relator h hFw hc hA hB
  have hC2 : (mmPsi h hFw hc hA hB).comp (mmTheta hFw hc hA hB hrel) = MonoidHom.id (mmG r) :=
    mmPsi_comp_mmTheta h hFw hc hA hB hrel
  have hC3 : (mmTheta hFw hc hA hB hrel).comp (mmPsi h hFw hc hA hB) =
      MonoidHom.id (mmK t r hFw hc hA hB) :=
    mmTheta_comp_mmPsi h hFw hc hA hB hrel
  refine ⟨mmBeta t r, mmW t r, mmW_relatorNorm_lt ht, Or.inr ⟨hc, ?_⟩,
    mmA t r, mmB t r, ⟨mmTA t r, hA, rfl⟩, ⟨mmTB t r, hB, rfl⟩, mmPhi hFw hc hA hB, ?_⟩
  · exact mmW_ne_one hred (mmWL_ne_nil h1 ht h)
  · exact ⟨(MonoidHom.toMulEquiv (mmPsi h hFw hc hA hB) (mmTheta hFw hc hA hB hrel)
      hC3 hC2).symm⟩


end Work.OROneRel
