/-
Copyright: subproject `OROneRel` -- one-relator combinatorics (node N2).

# The Freiheitssatz, unconditionally

`Work.OROneRel.freiheitssatz_at` proves the Freiheitssatz (Magnus 1930) for every relator `r`, with no
hypotheses beyond the classical ones.  Here we record the consequences that the rest of the project
consumes, now *unconditionally*: Magnus subgroups of a one-relator group are free, and the
Freiheitssatz in the form of the route design.
-/
import Mathlib
import Submission.Work.OROneRel.Interface
import Submission.Work.OROneRel.Derived
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.OROneRel.letters_closure_iff

namespace Work.OROneRel

universe u

variable {α : Type u}

/-- **Magnus subgroups are free.**  For a cyclically reduced relator `r` and a set `T` of generators
with `r ∉ ⟨T⟩`, the subgroup of `⟨α | r⟩` generated by `T` is free on `T`. -/
theorem magnusSubgroupOf_equiv_freeGroup_of_isCyclicallyReduced (r : FreeGroup α)
    (hr : IsCyclicallyReducedRelator r) {T : Set α}
    (hT : r ∉ Subgroup.closure (FreeGroup.of '' T)) :
    Nonempty (magnusSubgroupOf r T ≃* FreeGroup T) := by
  have hinj : Function.Injective (presentedGroupMap r T) := freiheitssatz_at r hr T hT
  exact ⟨((MonoidHom.ofInjective hinj).trans
    (MulEquiv.subgroupCongr (range_presentedGroupMap r T))).symm⟩

/-- **Magnus subgroups are free** (subgroup form). -/
theorem isFreeGroup_of_isMagnusSubgroup {r : FreeGroup α} (hr : IsCyclicallyReducedRelator r)
    {A : Subgroup (PresentedGroup ({r} : Set (FreeGroup α)))} (hA : IsMagnusSubgroup A) :
    IsFreeGroup A := by
  obtain ⟨T, hT, rfl⟩ := hA
  obtain ⟨e⟩ := magnusSubgroupOf_equiv_freeGroup_of_isCyclicallyReduced r hr hT
  exact IsFreeGroup.ofMulEquiv e.symm

/-- The Freiheitssatz in the form of the route design: a cyclically reduced relator `r` that mentions
the letter `x`, and a set `Y` of generators avoiding `x`. -/
theorem freiheitssatz_mentions_unconditional {r : FreeGroup α} (hr : IsCyclicallyReducedRelator r)
    {x : α} (hx : x ∈ relatorLetters r) {Y : Set α} (hY : ∀ y ∈ Y, y ≠ x) :
    Function.Injective (presentedGroupMap r Y) := by
  refine freiheitssatz_at r hr Y fun hmem => ?_
  exact (hY x ((letters_closure_iff r Y).mp hmem hx)) rfl

/-- The three remaining classical inputs (Magnus--Moldavanskii, Weinbaum, Karrass--Magnus--Solitar),
now that the Freiheitssatz is available unconditionally. -/
structure OneRelatorCombinatorics' : Prop where
  magnus_moldavanskii : ∀ {α : Type u} (r : FreeGroup α), MagnusMoldavanskiiAt r
  weinbaum : ∀ {α : Type u} (r : FreeGroup α), WeinbaumAt r
  kms_torsion : ∀ {α : Type u} (r : FreeGroup α), KMSTorsionAt r

/-- The Freiheitssatz is no longer an input: the three remaining classical theorems suffice to
inhabit the full interface of the node. -/
def OneRelatorCombinatorics'.toOneRelatorCombinatorics (C : OneRelatorCombinatorics'.{u}) :
    OneRelatorCombinatorics.{u} where
  freiheitssatz := fun r => freiheitssatz_at r
  magnus_moldavanskii := C.magnus_moldavanskii
  weinbaum := C.weinbaum
  kms_torsion := C.kms_torsion

end Work.OROneRel
