# The range projection of an element of the group von Neumann algebra

Let `a ∈ N(G)` be an element of the group von Neumann algebra
`Work.ORVonNeumann.groupVonNeumann G`, the commutant in `B(ℓ²(G))` of the right regular
representation.  This module proves that the set of `x ∈ N(G)` with `a * x = 0` is the
principal right ideal generated by a star projection:

* `Work.Rep.exists_rangeProjection` — there is a star projection `p ∈ N(G)` with
  `a * x = 0 ↔ ∃ y, x = p * y`.

The projection is the orthogonal projection `q` onto the kernel `K = ker a ⊆ ℓ²(G)`, viewed
as an element of `N(G)`.  Concretely:

* `a * x = 0` says that every value of `x` lies in `K`, which is exactly the statement
  `q * x = x` (the projection onto `K` fixes `K` pointwise);
* conversely `a * q = 0` because the range of `q` is `K = ker a`.

The membership `q ∈ N(G)` is the content of `Work.Rep.starProjection_mul_comm_of_invt`
applied to the right regular representation `ρ g`: since `a` commutes with `ρ g`, the kernel
of `a` is invariant under `ρ g` and under its adjoint `ρ g⁻¹ = (ρ g)⋆`, hence `ρ g`
commutes with the projection onto `K`.

This is the "Baer `*`-ring"/Rickart property of `N(G)` on the right; the companion statement
for left annihilators is `Work.Rep.exists_leftAnnihilatorProjection`.
-/
import Mathlib
import Submission.Work.ORVonNeumann.Rep.GroupVonNeumann
import Submission.Work.ORVonNeumann.Rep.exists_rightRegular
import Submission.Work.Rep.starProjection_mul_comm_of_invt

open Work.ORVonNeumann

namespace Work.Rep

/-- Packaging: an element of a star subalgebra is a star projection as soon as its image in
the ambient ring is one. -/
private theorem isStarProjection_subtype_mk {A : Type*} [Ring A] [Algebra ℂ A] [StarRing A]
    [StarModule ℂ A] {S : StarSubalgebra ℂ A} {x : A} (hx : x ∈ S) (h : IsStarProjection x) :
    IsStarProjection (⟨x, hx⟩ : ↥S) := by
  refine ⟨?_, ?_⟩
  · show (⟨x, hx⟩ : ↥S) * ⟨x, hx⟩ = ⟨x, hx⟩
    exact Subtype.ext (by simpa [Subalgebra.coe_mul] using h.isIdempotentElem.eq)
  · show star (⟨x, hx⟩ : ↥S) = ⟨x, hx⟩
    exact Subtype.ext (by simpa using h.isSelfAdjoint.star_eq)

theorem exists_rangeProjection {G : Type*} [Group G] [Countable G] [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableMul G] (a : ↥(Work.ORVonNeumann.groupVonNeumann G)) : ∃ p : ↥(Work.ORVonNeumann.groupVonNeumann G), IsStarProjection p ∧ ∀ x : ↥(Work.ORVonNeumann.groupVonNeumann G), a * x = 0 ↔ ∃ y : ↥(Work.ORVonNeumann.groupVonNeumann G), x = p * y := by
  classical
  -- `a` commutes with every right translation
  have hmem_a : ∀ g : G, (a : boundedEnd G) * Rep.rightRegOp g
      = Rep.rightRegOp g * (a : boundedEnd G) :=
    (mem_groupVonNeumann_iff (a : boundedEnd G)).mp a.2
  -- hence the kernel of `a` and its orthogonal complement are invariant under `ρ g`
  have hcomm : ∀ g : G, Rep.rightRegOp g * (a : boundedEnd G).ker.starProjection
      = (a : boundedEnd G).ker.starProjection * Rep.rightRegOp g := by
    intro g
    refine starProjection_mul_comm_of_invt (K := (a : boundedEnd G).ker) ?_ ?_
    · intro x hx
      have hx' : (a : boundedEnd G) x = 0 := LinearMap.mem_ker.mp hx
      have h := congrArg (fun S : boundedEnd G => S x) (hmem_a g)
      simp only [mul_apply_eq_comp] at h
      rw [LinearMap.mem_ker]
      show (a : boundedEnd G) (Rep.rightRegOp g x) = 0
      rw [h, hx', map_zero]
    · intro x hx
      have hx' : (a : boundedEnd G) x = 0 := LinearMap.mem_ker.mp hx
      rw [show ContinuousLinearMap.adjoint (Rep.rightRegOp g) = Rep.rightRegOp g⁻¹ by
        rw [← ContinuousLinearMap.star_eq_adjoint, Rep.rightRegOp_star], LinearMap.mem_ker]
      show (a : boundedEnd G) (Rep.rightRegOp g⁻¹ x) = 0
      have h := congrArg (fun S : boundedEnd G => S x) (hmem_a g⁻¹)
      simp only [mul_apply_eq_comp] at h
      rw [h, hx', map_zero]
  -- so the projection onto the kernel of `a` lies in `N(G)`
  have hqmem : (a : boundedEnd G).ker.starProjection ∈ groupVonNeumann G := by
    rw [mem_groupVonNeumann_iff]
    intro g
    exact (hcomm g).symm
  have hqstar : IsStarProjection ((a : boundedEnd G).ker.starProjection : boundedEnd G) :=
    isStarProjection_starProjection
  -- the range of the projection is the kernel of `a`, so `a * q = 0`
  have haq : (a : boundedEnd G) * (a : boundedEnd G).ker.starProjection = 0 := by
    refine ContinuousLinearMap.ext fun ξ => ?_
    show (a : boundedEnd G) ((a : boundedEnd G).ker.starProjection ξ) = 0
    exact LinearMap.mem_ker.mp (Submodule.starProjection_apply_mem ((a : boundedEnd G).ker) ξ)
  refine ⟨⟨(a : boundedEnd G).ker.starProjection, hqmem⟩,
    isStarProjection_subtype_mk hqmem hqstar, ?_⟩
  intro x
  constructor
  · -- if `a * x = 0` then `x` is fixed by the projection onto `ker a`
    intro h
    refine ⟨x, ?_⟩
    refine Subtype.ext ?_
    show (x : boundedEnd G) = (a : boundedEnd G).ker.starProjection * (x : boundedEnd G)
    refine ContinuousLinearMap.ext fun ξ => ?_
    rw [mul_apply_eq_comp]
    refine (Submodule.starProjection_eq_self_iff.mpr ?_).symm
    refine LinearMap.mem_ker.mpr ?_
    have hc := DFunLike.congr_fun (congrArg Subtype.val h) ξ
    simpa using hc
  · -- conversely everything in the right ideal generated by the projection is killed by `a`
    rintro ⟨y, rfl⟩
    refine Subtype.ext ?_
    show (a : boundedEnd G) * ((a : boundedEnd G).ker.starProjection * (y : boundedEnd G)) = 0
    rw [← mul_assoc, haq, zero_mul]

end Work.Rep
