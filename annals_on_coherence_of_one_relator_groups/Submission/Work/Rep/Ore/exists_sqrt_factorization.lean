namespace Work.Rep.Ore

open Work.ORVonNeumann

/-- The real continuous functional calculus on `B(ℓ²(G))`.  Instance search does not find it on its
own, so we record it explicitly. -/
noncomputable instance instNonUnitalCFCRealBdd {G : Type*} [Group G] [Countable G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableMul G] :
    NonUnitalContinuousFunctionalCalculus ℝ (boundedEnd G) IsSelfAdjoint :=
  IsSelfAdjoint.instNonUnitalContinuousFunctionalCalculus (A := boundedEnd G)

section

variable {G : Type*} [Group G] [Countable G] [MeasurableSpace G] [MeasurableSingletonClass G]
  [MeasurableMul G]

/-- `N(G)` is closed in `B(ℓ²(G))`, being the centralizer of the range of the right regular
representation. -/
theorem isClosed_groupVonNeumann :
    IsClosed ((groupVonNeumann G : StarSubalgebra ℂ (boundedEnd G)) : Set (boundedEnd G)) := by
  rw [groupVonNeumann, commutant]
  exact Set.isClosed_centralizer _

/-- The square root (real CFC) of a nonnegative element of `N(G)` again lies in `N(G)`: `N(G)` is a
closed `*`-subalgebra of `B(ℓ²(G))` and the non-unital continuous functional calculus takes values
in the closed `*`-subalgebra generated by its argument. -/
theorem sqrt_mem_groupVonNeumann (a : boundedEnd G) (ha : a ∈ groupVonNeumann G) (ha0 : 0 ≤ a) :
    CFC.sqrt a ∈ groupVonNeumann G := by
  haveI : StarModule ℝ (boundedEnd G) := StarModule.complexToReal (E := boundedEnd G)
  haveI := isClosed_groupVonNeumann (G := G)
  unfold CFC.sqrt
  rw [cfcₙ_nnreal_eq_real NNReal.sqrt a ha0]
  exact cfcₙ_mem (𝕜' := ℂ) (S := StarSubalgebra ℂ (boundedEnd G)) (s := groupVonNeumann G)
    (fun x : ℝ => ↑(NNReal.sqrt x.toNNReal)) ha

/-- `star r * r + star s * s` is a nonnegative element of `B(ℓ²(G))` for the Loewner order. -/
theorem nonneg_star_mul_add (r s : ↥(groupVonNeumann G)) :
    (0 : boundedEnd G) ≤ ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G) := by
  have h1 : ((star r * r : ↥(groupVonNeumann G)) : boundedEnd G)
      = star (r : boundedEnd G) * (r : boundedEnd G) := by
    rw [Subalgebra.coe_mul, StarMemClass.coe_star]
  have h2 : ((star s * s : ↥(groupVonNeumann G)) : boundedEnd G)
      = star (s : boundedEnd G) * (s : boundedEnd G) := by
    rw [Subalgebra.coe_mul, StarMemClass.coe_star]
  rw [Subalgebra.coe_add, h1, h2]
  exact add_nonneg (star_mul_self_nonneg _) (star_mul_self_nonneg _)

/-- The square root of `R = star r * r + star s * s`, as an element of `N(G)`. -/
noncomputable def sqrtR (r s : ↥(groupVonNeumann G)) : ↥(groupVonNeumann G) :=
  ⟨CFC.sqrt ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G),
    sqrt_mem_groupVonNeumann _ (star r * r + star s * s).2 (nonneg_star_mul_add r s)⟩

@[simp]
theorem sqrtR_coe (r s : ↥(groupVonNeumann G)) :
    ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G)
      = CFC.sqrt ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G) := rfl

/-- `sqrtR r s` is self-adjoint. -/
theorem star_sqrtR (r s : ↥(groupVonNeumann G)) : star (sqrtR r s) = sqrtR r s := by
  refine Subtype.ext ?_
  show star (CFC.sqrt ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G))
      = CFC.sqrt ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G)
  exact (CFC.sqrt_nonneg ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G)).star_eq

/-- `sqrtR r s * sqrtR r s = star r * r + star s * s`. -/
theorem sqrtR_mul_self (r s : ↥(groupVonNeumann G)) :
    sqrtR r s * sqrtR r s = star r * r + star s * s := by
  refine Subtype.ext ?_
  show CFC.sqrt ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G)
        * CFC.sqrt ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G)
      = ((star r * r + star s * s : ↥(groupVonNeumann G)) : boundedEnd G)
  exact CFC.sqrt_mul_sqrt_self _ (nonneg_star_mul_add r s)

/-- The coercion of `sqrtR r s` is self-adjoint as an operator on `ℓ²(G)`. -/
theorem star_sqrtR_coe (r s : ↥(groupVonNeumann G)) :
    star ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G)
      = ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) := by
  have h := congrArg (fun x : ↥(groupVonNeumann G) => (x : boundedEnd G)) (star_sqrtR r s)
  simpa [StarMemClass.coe_star] using h

/-- The operator identity `(sqrtR r s)² = r⋆r + s⋆s` on `ℓ²(G)`. -/
theorem sqrtR_mul_self_coe (r s : ↥(groupVonNeumann G)) :
    ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G)
        * ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G)
      = star (r : boundedEnd G) * (r : boundedEnd G)
        + star (s : boundedEnd G) * (s : boundedEnd G) := by
  have h := congrArg (fun x : ↥(groupVonNeumann G) => (x : boundedEnd G)) (sqrtR_mul_self r s)
  simpa [Subalgebra.coe_mul, Subalgebra.coe_add, StarMemClass.coe_star] using h

/-- The norm identity `‖sqrtR r s x‖² = ‖r x‖² + ‖s x‖²`. -/
theorem norm_sq_sqrtR (r s : ↥(groupVonNeumann G)) (x : l2 G) :
    ‖((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) x‖ ^ 2
      = ‖(r : boundedEnd G) x‖ ^ 2 + ‖(s : boundedEnd G) x‖ ^ 2 :=
  norm_sq_eq_add_of_sq _ _ _ (star_sqrtR_coe r s) (sqrtR_mul_self_coe r s) x

/-- `sqrtR r s` is injective as soon as `s` is. -/
theorem injective_sqrtR (r s : ↥(groupVonNeumann G)) (hs : Function.Injective (s : boundedEnd G)) :
    Function.Injective ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) := by
  intro x y hxy
  have h0 : ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) (x - y) = 0 := by
    rw [map_sub, hxy, sub_self]
  have hn := norm_sq_sqrtR r s (x - y)
  rw [h0, norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hn
  have hs0 : (s : boundedEnd G) (x - y) = 0 := by
    have h2 : ‖(s : boundedEnd G) (x - y)‖ ^ 2 = 0 := by
      linarith [sq_nonneg ‖(r : boundedEnd G) (x - y)‖, sq_nonneg ‖(s : boundedEnd G) (x - y)‖]
    exact norm_eq_zero.mp (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2)
  exact sub_eq_zero.mp (hs (by rw [hs0, map_zero]))

/-- `sqrtR r s` has dense range as soon as `s` is injective. -/
theorem denseRange_sqrtR (r s : ↥(groupVonNeumann G)) (hs : Function.Injective (s : boundedEnd G)) :
    DenseRange ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) :=
  denseRange_of_injective (sqrtR r s) (injective_sqrtR r s hs)

/-- The norm bound `‖r x‖ ≤ ‖sqrtR r s x‖`. -/
theorem norm_apply_le_sqrtR_left (r s : ↥(groupVonNeumann G)) (x : l2 G) :
    ‖(r : boundedEnd G) x‖
      ≤ ‖((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) x‖ := by
  have h := norm_sq_sqrtR r s x
  nlinarith [sq_nonneg ‖(r : boundedEnd G) x‖, sq_nonneg ‖(s : boundedEnd G) x‖,
    norm_nonneg (((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) x)]

/-- The norm bound `‖s x‖ ≤ ‖sqrtR r s x‖`. -/
theorem norm_apply_le_sqrtR_right (r s : ↥(groupVonNeumann G)) (x : l2 G) :
    ‖(s : boundedEnd G) x‖
      ≤ ‖((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) x‖ := by
  have h := norm_sq_sqrtR r s x
  nlinarith [sq_nonneg ‖(r : boundedEnd G) x‖, sq_nonneg ‖(s : boundedEnd G) x‖,
    norm_nonneg (((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) x)]

end

theorem exists_sqrt_factorization {G : Type*} [Group G] [Countable G] [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableMul G] (r s : ↥(Work.ORVonNeumann.groupVonNeumann G)) (hs_inj : Function.Injective (s : Work.ORVonNeumann.boundedEnd G)) : ∃ h v₁ v₂ : ↥(Work.ORVonNeumann.groupVonNeumann G), Function.Injective (h : Work.ORVonNeumann.boundedEnd G) ∧ DenseRange (h : Work.ORVonNeumann.boundedEnd G) ∧ v₁ * h = r ∧ v₂ * h = s ∧ star v₁ * v₁ + star v₂ * v₂ = 1 ∧ Function.Injective (v₂ : Work.ORVonNeumann.boundedEnd G) := by
  classical
  have hinj : Function.Injective ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) :=
    injective_sqrtR r s hs_inj
  have hdense : DenseRange ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) :=
    denseRange_sqrtR r s hs_inj
  obtain ⟨v₁₀, hv₁⟩ := exists_continuousLinearMap_of_denseRange
    ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) (r : boundedEnd G) hdense
    (norm_apply_le_sqrtR_left r s)
  obtain ⟨v₂₀, hv₂⟩ := exists_continuousLinearMap_of_denseRange
    ((sqrtR r s : ↥(groupVonNeumann G)) : boundedEnd G) (s : boundedEnd G) hdense
    (norm_apply_le_sqrtR_right r s)
  have hm₁ : v₁₀ ∈ groupVonNeumann G :=
    mem_groupVonNeumann_of_mul_eq v₁₀ _ _ (sqrtR r s).2 r.2 hdense hv₁
  have hm₂ : v₂₀ ∈ groupVonNeumann G :=
    mem_groupVonNeumann_of_mul_eq v₂₀ _ _ (sqrtR r s).2 s.2 hdense hv₂
  have hprod₁ : (⟨v₁₀, hm₁⟩ : ↥(groupVonNeumann G)) * sqrtR r s = r := Subtype.ext hv₁
  have hprod₂ : (⟨v₂₀, hm₂⟩ : ↥(groupVonNeumann G)) * sqrtR r s = s := Subtype.ext hv₂
  refine ⟨sqrtR r s, ⟨v₁₀, hm₁⟩, ⟨v₂₀, hm₂⟩, hinj, hdense, hprod₁, hprod₂, ?_, ?_⟩
  · exact star_mul_self_add_eq_one (sqrtR r s) ⟨v₁₀, hm₁⟩ ⟨v₂₀, hm₂⟩ r s
      (star_sqrtR r s) hdense (sqrtR_mul_self r s) hprod₁ hprod₂
  · exact injective_of_mul_injective ⟨v₂₀, hm₂⟩ (sqrtR r s)
      (by rw [hprod₂]; exact hs_inj)

end Work.Rep.Ore
