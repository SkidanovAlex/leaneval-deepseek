import Mathlib
import Submission.Work.ORTorsion.Defs

namespace Work.ORTorsion.GroupOps

open Work.ORTorsion

/-- The subgroup generated by the elements of a finite set is finitely generated:
`Subgroup.closure s` is generated by the finite set `(s : Set G)` itself. -/
theorem fg_closure_finset {G : Type*} [Group G] (s : Finset G) :
    (Subgroup.closure ((s : Finset G) : Set G)).FG :=
  (Subgroup.fg_iff _).mpr ⟨(s : Set G), rfl, s.finite_toSet⟩

end Work.ORTorsion.GroupOps
