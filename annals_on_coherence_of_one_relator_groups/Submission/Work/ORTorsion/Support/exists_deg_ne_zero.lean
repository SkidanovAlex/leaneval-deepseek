import Mathlib
import Submission.Work.ORTorsion.Defs

namespace Work.ORTorsion.Support

-- If every element of the support of `x` had degree `0`, then the support would be contained in
-- `φ.ker`, hence (as the support generates `H`) `φ` would be trivial, contradicting surjectivity.
open Work.ORTorsion

theorem exists_deg_ne_zero {K : Type*} [Field K] {G : Type*} [Group G] {H : Subgroup G}
    (φ : H →* Multiplicative ℤ) (hφ : Function.Surjective φ) (x : MonoidAlgebra K H)
    (_h1 : (1 : H) ∈ x.coeff.support)
    (hgen : Subgroup.closure ((x.coeff.support : Finset H) : Set H) = ⊤) :
    ∃ h ∈ x.coeff.support, deg φ h ≠ 0 := by
  by_contra hcon
  push_neg at hcon
  -- Every element of the support lies in the kernel of `φ`.
  have hker : ∀ y ∈ x.coeff.support, y ∈ φ.ker := by
    intro y hy
    rw [MonoidHom.mem_ker]
    have hy0 : deg φ y = 0 := hcon y hy
    rw [deg] at hy0
    rw [← ofAdd_toAdd (φ y), hy0, ofAdd_zero]
  -- Hence the subgroup generated by the support is contained in `φ.ker`, and it is everything.
  have hle : Subgroup.closure ((x.coeff.support : Finset H) : Set H) ≤ φ.ker :=
    (Subgroup.closure_le φ.ker).mpr hker
  have htop : φ.ker = ⊤ := le_antisymm le_top (hgen ▸ hle)
  -- So `φ` is the trivial homomorphism, contradicting surjectivity onto `ℤ`.
  have htriv : φ = 1 := by
    apply MonoidHom.ext
    intro y
    show φ y = 1
    exact MonoidHom.mem_ker.mp (by rw [htop]; exact Subgroup.mem_top y)
  obtain ⟨y, hy⟩ := hφ (Multiplicative.ofAdd 1)
  have hof : Multiplicative.ofAdd (1 : ℤ) = (1 : Multiplicative ℤ) := by
    rw [← hy]
    simpa using congrArg (fun f : H →* Multiplicative ℤ => f y) htriv
  have h1z : (1 : ℤ) = 0 := by
    have hc := congrArg Multiplicative.toAdd hof
    rwa [toAdd_ofAdd, toAdd_one] at hc
  exact one_ne_zero h1z

end Work.ORTorsion.Support
