# The group von Neumann algebra as the commutant of the right regular representation

For a countable group `G`, the group von Neumann algebra `N(G)` is the commutant of the
right regular representation acting on `ℓ²(G)`:

`N(G) := {T : B(ℓ²(G)) | ∀ g, T * ρ g = ρ g * T}`.

It is the algebra generated by the *left* regular representation, and it is the ambient ring
of the trace `τ a = ⟪a δ₁, δ₁⟫` and of the algebra `U(G)` of affiliated operators.

This module assembles the definition from `Work.ORVonNeumann.Rep.exists_rightRegular` and
gives the membership criterion.
-/
import Mathlib
import Submission.Work.ORVonNeumann.Rep
import Submission.Work.ORVonNeumann.Rep.exists_rightRegular

set_option autoImplicit false

universe u

namespace Work.ORVonNeumann

variable {G : Type u} [Group G] [Countable G] [MeasurableSpace G] [MeasurableSingletonClass G]
  [MeasurableMul G]

/-- **The group von Neumann algebra** `N(G)`: the commutant in `B(ℓ²(G))` of the right
regular representation of `G`. -/
noncomputable def groupVonNeumann (G : Type u) [Group G] [Countable G] [MeasurableSpace G]
    [MeasurableSingletonClass G] [MeasurableMul G] : StarSubalgebra ℂ (boundedEnd G) :=
  commutant (Set.range (Rep.rightRegHom (G := G)))

/-- Membership in `N(G)` is commuting with every right translation `ρ g`. -/
theorem mem_groupVonNeumann_iff (T : boundedEnd G) :
    T ∈ groupVonNeumann G ↔ ∀ g : G, T * Rep.rightRegHom (G := G) g
      = Rep.rightRegHom (G := G) g * T := by
  rw [groupVonNeumann, commutant, StarSubalgebra.mem_centralizer_iff]
  constructor
  · intro h g
    exact ((h _ ⟨g, rfl⟩).1).symm
  · intro h x hx
    obtain ⟨g, rfl⟩ := hx
    refine ⟨(h g).symm, ?_⟩
    have hstar : star (Rep.rightRegHom (G := G) g) = Rep.rightRegHom (G := G) g⁻¹ :=
      Rep.rightRegOp_star g
    rw [hstar]
    exact (h g⁻¹).symm

/-- The identity operator belongs to `N(G)`. -/
theorem one_mem_groupVonNeumann : (1 : boundedEnd G) ∈ groupVonNeumann G := by
  rw [mem_groupVonNeumann_iff]
  intro g; rw [one_mul, mul_one]

end Work.ORVonNeumann
