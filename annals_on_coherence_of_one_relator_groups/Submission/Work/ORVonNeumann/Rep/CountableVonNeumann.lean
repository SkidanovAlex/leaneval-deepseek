# The group von Neumann algebra of a countable group, concretely

This module assembles the model `N(G) = ρ(G)' ⊆ B(ℓ²(G))` of the previous modules into the
abstract interface `Work.ORVonNeumann.GroupVonNeumannAlgebra`:

* `Work.ORVonNeumann.Rep.leftRegularHom` — the left regular representation as a unitary,
  injective monoid homomorphism `G →* ↥(groupVonNeumann G)`;
* `Work.ORVonNeumann.Rep.tau_tracial` — traciality of the vector state (item (1) of the
  analytic core);
* `Work.ORVonNeumann.Rep.exists_rightAnnihilatorProjection` — the right annihilator of any
  element is generated by a projection, i.e. `N(G)` is a Baer `*`-ring (item (2));
* `Work.ORVonNeumann.Rep.directly_finite` — `N(G)` is directly finite (item (3));
* `Work.ORVonNeumann.Rep.countableGroupVonNeumannOfOre (hor) : GroupVonNeumannAlgebra G` —
  the assembled instance, its only hypothesis being the Ore condition at non-zero-divisors.
  Since that condition is a theorem (`Work.Rep.oreSet_nonZeroDivisors`), the *unconditional*
  instance is `Work.ORVonNeumann.Rep.countableGroupVonNeumann` in
  `Submission.Work.ORVonNeumann.Rep.CountableVonNeumannOre` (a separate module, because the
  Ore proof consumes `directly_finite` from this file).

In particular `N(G)` is a finite Baer `*`-ring with a faithful trace and the Ore condition at
non-zero-divisors (`Work.Rep.oreSet_nonZeroDivisors`), so the algebra
`U(G) = N(G)[(N(G) ∖ {0})⁻¹]` of affiliated operators exists
(`Work.ORVonNeumann.GroupVonNeumannAlgebra.affiliated`) and is a `*`-ring containing `ℂ[G]`
(`Work.ORVonNeumann.VonNeumannAlgebra.U`, `...UStar`).
-/
import Mathlib
import Submission.Work.ORVonNeumann.VonNeumannAlgebra
import Submission.Work.ORVonNeumann.Rep.Trace
import Submission.Work.ORVonNeumann.Rep.Dimension
import Submission.Work.ORVonNeumann.Rep.GroupVonNeumann
import Submission.Work.ORVonNeumann.Rep.exists_leftRegular
import Submission.Work.Rep.tau_tracial
import Submission.Work.Rep.exists_rangeProjection
import Submission.Work.Rep.directly_finite_of_tau_tracial

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.ORVonNeumann.Rep

open MeasureTheory

variable {G : Type*} [Group G] [Countable G] [MeasurableSpace G] [MeasurableSingletonClass G]
  [MeasurableMul G]

/-- **The left regular representation of `G` inside `N(G)`**, as a monoid homomorphism: it is
the left regular representation `λ`, corestricted to the commutant of `ρ`. -/
noncomputable def leftRegularHom : G →* ↥(groupVonNeumann G) :=
  (leftRegHom (G := G)).codRestrict ((groupVonNeumann G).toSubalgebra)
    (fun g => leftRegOp_mem_groupVonNeumann g)

@[simp]
theorem leftRegularHom_coe (g : G) :
    ((leftRegularHom (G := G) g : ↥(groupVonNeumann G)) : boundedEnd G) = leftRegOp g := rfl

/-- The left regular representation into `N(G)` is unitary. -/
theorem leftRegularHom_star (g : G) : star (leftRegularHom (G := G) g) = leftRegularHom g⁻¹ := by
  refine Subtype.ext ?_
  rw [StarMemClass.coe_star, leftRegularHom_coe, leftRegularHom_coe, leftRegOp_star]

/-- The trace of `λ g` in `N(G)`. -/
theorem tau_leftRegularHom_of_ne (g : G) (hg : g ≠ 1) :
    tau (leftRegularHom (G := G) g) = 0 := by
  rw [tau, leftRegularHom_coe, leftRegOp_delta1]
  exact inner_deltaG_of_ne (G := G) (Ne.symm hg)

/-- The trace of `λ 1` in `N(G)` is one. -/
theorem tau_leftRegularHom_one : tau (leftRegularHom (G := G) (1 : G)) = 1 := by
  have ht : tau (1 : ↥(groupVonNeumann G)) = 1 := tau_one
  have h1 : leftRegularHom (G := G) (1 : G) = (1 : ↥(groupVonNeumann G)) := map_one _
  rw [h1]
  exact ht

/-- An element of `N(G)` with trace one at `λ g` forces `g = 1`. -/
theorem eq_one_of_tau_leftRegularHom_eq_one (g : G)
    (h : tau (leftRegularHom (G := G) g) = 1) : g = 1 := by
  by_contra hg
  rw [tau_leftRegularHom_of_ne g hg] at h
  exact one_ne_zero h.symm

/-- The left regular representation into `N(G)` is injective. -/
theorem leftRegularHom_injective : Function.Injective (leftRegularHom (G := G)) := by
  intro g h hgh
  have hmul : leftRegularHom (G := G) g * leftRegularHom (G := G) h⁻¹
      = leftRegularHom (G := G) (g * h⁻¹) := (map_mul _ g h⁻¹).symm
  have ht : tau (1 : ↥(groupVonNeumann G)) = 1 := tau_one
  have h1 : tau (leftRegularHom (G := G) (g * h⁻¹)) = 1 := by
    rw [← hmul, hgh, ← map_mul (leftRegularHom (G := G)) h h⁻¹, mul_inv_cancel h,
      map_one (leftRegularHom (G := G))]
    exact ht
  exact mul_inv_eq_one.mp (eq_one_of_tau_leftRegularHom_eq_one (g * h⁻¹) h1)

/-- **Traciality of the trace of `N(G)`** (analytic core, item (1)). -/
theorem tau_tracial (a b : ↥(groupVonNeumann G)) : tau (a * b) = tau (b * a) := by
  rw [tau, tau]
  exact Work.Rep.tau_tracial a b

/-- **The Baer property of `N(G)`**: the right annihilator of every element is generated by a
projection (analytic core, item (2)). -/
theorem exists_rightAnnihilatorProjection (a : ↥(groupVonNeumann G)) :
    ∃ p : ↥(groupVonNeumann G), IsStarProjection p ∧
      ∀ x : ↥(groupVonNeumann G), a * x = 0 ↔ ∃ y : ↥(groupVonNeumann G), x = p * y :=
  Work.Rep.exists_rangeProjection a

/-- **Direct finiteness of `N(G)`** (analytic core, item (3)). -/
theorem directly_finite (a b : ↥(groupVonNeumann G)) (h : a * b = 1) : b * a = 1 :=
  Work.Rep.directly_finite_of_tau_tracial (fun a b => tau_tracial a b) a b h

/-- **The group von Neumann algebra of a countable group**, as an abstract model.

Every analytic field of `GroupVonNeumannAlgebra` is proved for the concrete model
`↥(groupVonNeumann G) = ρ(G)' ⊆ B(ℓ²(G))`, with `ρ = λ` the left regular representation and
`τ a = ⟪δ₁, a δ₁⟫`; the only input taken as a hypothesis is the Ore condition at
non-zero-divisors (Berberian's theorem). -/
noncomputable def countableGroupVonNeumannOfOre
    (hor : Nonempty (OreLocalization.OreSet (nonZeroDivisors ↥(groupVonNeumann G)))) :
    GroupVonNeumannAlgebra G where
  N := ↥(groupVonNeumann G)
  ringN := inferInstance
  starN := inferInstance
  algebraN := inferInstance
  ρ := leftRegularHom
  ρ_star := leftRegularHom_star
  ρ_injective := leftRegularHom_injective
  τ := tauLin
  τ_one := tau_one
  τ_tracial := fun a b => tau_tracial a b
  τ_star := fun a => tau_star a
  star_smul := fun c x => by
    refine Subtype.ext ?_
    show star (c • (x : boundedEnd G)) = star c • star (x : boundedEnd G)
    rw [StarModule.star_smul]
  τ_ρ_one := tau_leftRegularHom_one
  τ_ρ_ne_one := fun g hg => tau_leftRegularHom_of_ne g hg
  τ_re_nonneg := fun a => tau_re_nonneg a
  τ_faithful := fun a h => (tau_star_mul_self_eq_zero_iff a).mp h
  directly_finite := fun a b h => directly_finite a b h
  baer := fun a => exists_rightAnnihilatorProjection a
  oreSet := Classical.choice hor

end Work.ORVonNeumann.Rep
