# Baer `*`-rings: range projections and their calculus

This module isolates the ring-theoretic input of the theorem that the Ore localisation of a
Baer `*`-ring at its non-zero-divisors is `*`-regular.

For a ring `R` with an involution we call `R` *element-Baer* (`HasBaerAnnihilators`) if the
right annihilator of every element is generated by a star projection.  From this data we
build the *right projection* `rightProj h a` of `a`, characterised by
`a * x = 0 ↔ ∃ y, x = (1 - rightProj h a) * y`, and prove

* `rightProj_mul_self` : `a * rightProj h a = a`;
* `isProperStar_of_hasBaerAnnihilators` : the involution is proper;
* `rightProj_mul_star_self` : `rightProj h (a * star a) = rightProj h a`;
* `add_one_sub_rightProj_mem_nonZeroDivisors` : for self-adjoint `a`, the element
  `a + (1 - rightProj h a)` is a non-zero-divisor, and it commutes with `a` and takes
  `rightProj h a` to `a`.

These are the algebraic facts used in `...VonNeumannAlgebra.starRegularAffiliated`.
-/
import Mathlib
import Submission.Work.ORVonNeumann.Basic

set_option autoImplicit false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORVonNeumann.BaerRing

/-- The *element-Baer* condition on a multiplicative structure with zero and an involution:
the right annihilator of every element is generated by a star projection. -/
def HasBaerAnnihilators (R : Type*) [Mul R] [Zero R] [Star R] : Prop :=
  ∀ a : R, ∃ p : R, IsStarProjection p ∧ ∀ x : R, a * x = 0 ↔ ∃ y : R, x = p * y

variable {R : Type u} [Ring R] [StarRing R]

/-- The star projection generating the right annihilator of `a`. -/
noncomputable def annihProj (h : HasBaerAnnihilators R) (a : R) : R := (h a).choose

theorem annihProj_spec (h : HasBaerAnnihilators R) (a : R) :
    IsStarProjection (annihProj h a) ∧
      ∀ x : R, a * x = 0 ↔ ∃ y : R, x = annihProj h a * y :=
  (h a).choose_spec

theorem annihProj_isStarProjection (h : HasBaerAnnihilators R) (a : R) :
    IsStarProjection (annihProj h a) :=
  (annihProj_spec h a).1

theorem annihProj_spec' (h : HasBaerAnnihilators R) (a : R) :
    ∀ x : R, a * x = 0 ↔ ∃ y : R, x = annihProj h a * y :=
  (annihProj_spec h a).2

/-- The right projection of `a`: the star projection onto the orthogonal complement of the
kernel of left multiplication by `a`. -/
noncomputable def rightProj (h : HasBaerAnnihilators R) (a : R) : R :=
  1 - annihProj h a

theorem rightProj_eq (h : HasBaerAnnihilators R) (a : R) :
    rightProj h a = 1 - annihProj h a := rfl

theorem rightProj_isStarProjection (h : HasBaerAnnihilators R) (a : R) :
    IsStarProjection (rightProj h a) := by
  rw [rightProj_eq]
  exact (annihProj_isStarProjection h a).one_sub

theorem rightProj_spec (h : HasBaerAnnihilators R) (a : R) :
    ∀ x : R, a * x = 0 ↔ ∃ y : R, x = (1 - rightProj h a) * y := by
  intro x
  rw [rightProj_eq, sub_sub_cancel]
  exact annihProj_spec' h a x

theorem rightProj_mul_self (h : HasBaerAnnihilators R) (a : R) :
    a * rightProj h a = a := by
  have h1 : a * (1 - rightProj h a) = 0 :=
    (rightProj_spec h a (1 - rightProj h a)).mpr ⟨1, by rw [mul_one]⟩
  have h2 : a * (1 - rightProj h a) = a - a * rightProj h a := by rw [mul_sub, mul_one]
  rw [h2, sub_eq_zero] at h1
  exact h1.symm

theorem mul_one_sub_rightProj_eq_zero (h : HasBaerAnnihilators R) (a : R) :
    a * (1 - rightProj h a) = 0 :=
  (rightProj_spec h a (1 - rightProj h a)).mpr ⟨1, by rw [mul_one]⟩

theorem rightProj_eq_of_annih_eq (h : HasBaerAnnihilators R) {a b : R}
    (hab : ∀ x : R, a * x = 0 ↔ b * x = 0) : rightProj h a = rightProj h b := by
  set e : R := 1 - rightProj h a
  set f : R := 1 - rightProj h b
  have hef : e * e = e := (rightProj_isStarProjection h a).one_sub.isIdempotentElem.eq
  have hff : f * f = f := (rightProj_isStarProjection h b).one_sub.isIdempotentElem.eq
  have hse : star e = e := (rightProj_isStarProjection h a).one_sub.isSelfAdjoint.star_eq
  have hsf : star f = f := (rightProj_isStarProjection h b).one_sub.isSelfAdjoint.star_eq
  have ha0 : a * e = 0 := mul_one_sub_rightProj_eq_zero h a
  have hb0 : b * f = 0 := mul_one_sub_rightProj_eq_zero h b
  have heR : e = f * e := by
    obtain ⟨y, hy⟩ : ∃ y, e = f * y := (rightProj_spec h b e).mp ((hab e).mp ha0)
    rw [hy, ← mul_assoc, hff]
  have hfR : f = e * f := by
    obtain ⟨y, hy⟩ : ∃ y, f = e * y := (rightProj_spec h a f).mp ((hab f).mpr hb0)
    rw [hy, ← mul_assoc, hef]
  have hef' : e = e * f := by
    have h1 : star e = star (f * e) := congrArg star heR
    rw [star_mul, hse, hsf] at h1
    exact h1
  have hee : e = f := hef'.trans hfR.symm
  have h2 : (1 : R) - rightProj h a = 1 - rightProj h b := hee
  have h3 : (1 : R) - (1 - rightProj h a) = 1 - (1 - rightProj h b) := by rw [h2]
  simpa using h3

end Work.ORVonNeumann.BaerRing
