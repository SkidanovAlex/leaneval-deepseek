# A Baer ring with projections has a proper involution

If the right annihilator of every element of a `*`-ring is generated by a star projection
(`Work.ORVonNeumann.BaerRing.HasBaerAnnihilators`), then the involution is proper:
`x * x⋆ = 0` forces `x = 0`.

The argument is the classical one.  Let `p = annihProj h x`, so that the right annihilator of `x`
is the principal right ideal `pR`.  If `x * x⋆ = 0`, then `x⋆ ∈ pR`, say `x⋆ = p * y`; applying
`⋆` gives `x = y⋆ * p`, whence `x * p = x`.  Hence `x * (1 - p) = 0`, i.e. `1 - p ∈ pR`, say
`1 - p = p * z`; but `p * (1 - p) = 0` and `p * (p * z) = p * z`, so `1 - p = 0`, that is `p = 1`.
Thus `1` lies in the right annihilator of `x`, i.e. `x = 0`.
-/
import Mathlib
import Submission.Work.ORVonNeumann.BaerLocalization.BaerRing

set_option autoImplicit false

namespace Work.ORVonNeumann.BaerLocalization

/-- A `*`-ring in which the right annihilator of every element is generated by a star projection
has a proper involution. -/
theorem isProperStar_of_hasBaerAnnihilators {R : Type*} [Ring R] [StarRing R] (h : Work.ORVonNeumann.BaerRing.HasBaerAnnihilators R) : Work.ORVonNeumann.IsProperStar R := by
  intro x hx
  set p : R := Work.ORVonNeumann.BaerRing.annihProj h x with hp_def
  have hspec : ∀ z : R, x * z = 0 ↔ ∃ w : R, z = p * w := by
    intro z
    rw [hp_def]
    exact Work.ORVonNeumann.BaerRing.annihProj_spec' h x z
  have hp_proj : IsStarProjection p := by
    rw [hp_def]
    exact Work.ORVonNeumann.BaerRing.annihProj_isStarProjection h x
  -- `x⋆` lies in the right annihilator of `x`, hence `x⋆ = p * y`, hence `x = y⋆ * p`
  obtain ⟨y, hy⟩ := (hspec (star x)).mp hx
  have hxp : x * p = x := by
    have hxy : x = star y * p := by
      calc x = star (star x) := (star_star x).symm
        _ = star (p * y) := by rw [hy]
        _ = star y * star p := star_mul _ _
        _ = star y * p := by rw [hp_proj.isSelfAdjoint.star_eq]
    rw [hxy, mul_assoc, hp_proj.isIdempotentElem.eq]
  -- thus `1 - p` annihilates `x` on the right, so `1 - p ∈ pR`
  have h1mp : x * (1 - p) = 0 := by rw [mul_sub, mul_one, hxp, sub_self]
  obtain ⟨z, hz⟩ := (hspec (1 - p)).mp h1mp
  -- but `p * (1 - p) = 0` while `p * (1 - p) = p * (p * z) = p * z = 1 - p`
  have hz0 : 1 - p = 0 := by
    have h0 : p * (1 - p) = 0 := hp_proj.mul_one_sub_self
    rw [hz, ← mul_assoc, hp_proj.isIdempotentElem.eq] at h0
    rw [hz, h0]
  have hpe : p = 1 := (sub_eq_zero.mp hz0).symm
  -- hence `1` annihilates `x`, i.e. `x = 0`
  have h1 : x * 1 = 0 := (hspec 1).mpr ⟨1, by rw [mul_one, hpe]⟩
  simpa using h1

end Work.ORVonNeumann.BaerLocalization
