# `U(G) = N(G)[(nzd)⁻¹]` is a `*`-regular ring

Berberian's theorem: the Ore localisation of a finite Baer `*`-ring at its set of
non-zero-divisors is `*`-regular.  Here it is proved for the abstract model
`D : GroupVonNeumannAlgebra G` of the group von Neumann algebra, using only

* the Baer property `D.baer` (right annihilators of elements are generated by star projections),
  and
* the Ore condition `D.oreSet` at the non-zero-divisors.

The ring-theoretic core (range projections, properness of the involution, and the
non-zero-divisor `h + (1 - h RP)` attached to a self-adjoint `h`) lives in
`Submission/Work/ORVonNeumann/BaerLocalization/`.

## Main results

* `Work.ORVonNeumann.VonNeumannAlgebra.isStarRegularRing_affiliated` — for every model
  `D : GroupVonNeumannAlgebra G`, `D.affiliated` is `*`-regular;
* `Work.ORVonNeumann.VonNeumannAlgebra.starRegularAffiliated` — the unconditional statement for
  `Work.ORVonNeumann.Rep.countableGroupVonNeumann`.
-/
import Mathlib
import Submission.Work.ORVonNeumann.Rep.CountableVonNeumannOre
import Submission.Work.ORVonNeumann.VonNeumannAlgebra.UStar
import Submission.Work.ORVonNeumann.BaerLocalization.BaerRing
import Submission.Work.ORVonNeumann.BaerLocalization.isProperStar_of_hasBaerAnnihilators
import Submission.Work.ORVonNeumann.BaerLocalization.rightProj_star_mul_self
import Submission.Work.ORVonNeumann.BaerLocalization.selfAdjoint_add_one_sub_rightProj

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.ORVonNeumann.VonNeumannAlgebra

open OreLocalization

variable {G : Type*} [Group G]

/-- The structure map `N(G) →+* U(G)`, spelled out so that the Ore localisation arguments are
elaborated once and for all. -/
noncomputable abbrev numU (D : GroupVonNeumannAlgebra G) : D.N →+* D.affiliated :=
  OreLocalization.numeratorRingHom (S := nonZeroDivisors D.N)

/-- The inverse in `U(G)` of the image of a non-zero-divisor `s` of `N(G)`. -/
noncomputable def invU (D : GroupVonNeumannAlgebra G) (s : nonZeroDivisors D.N) : D.affiliated :=
  (((OreLocalization.numeratorUnit (S := nonZeroDivisors D.N) s)⁻¹ :
      (OreLocalization (nonZeroDivisors D.N) D.N)ˣ) :
    OreLocalization (nonZeroDivisors D.N) D.N)

theorem invU_mul (D : GroupVonNeumannAlgebra G) (s : nonZeroDivisors D.N) :
    invU D s * numU D (s : D.N) = 1 := by
  show (↑((OreLocalization.numeratorUnit (S := nonZeroDivisors D.N) s)⁻¹) : D.affiliated)
      * (↑(OreLocalization.numeratorUnit (S := nonZeroDivisors D.N) s) : D.affiliated) = 1
  exact Units.inv_mul _

theorem mul_invU (D : GroupVonNeumannAlgebra G) (s : nonZeroDivisors D.N) :
    numU D (s : D.N) * invU D s = 1 := by
  show (↑(OreLocalization.numeratorUnit (S := nonZeroDivisors D.N) s) : D.affiliated)
      * (↑((OreLocalization.numeratorUnit (S := nonZeroDivisors D.N) s)⁻¹) : D.affiliated) = 1
  exact Units.mul_inv _

/-- Every element of `U(G)` is a left fraction `s⁻¹ a`. -/
theorem oreDiv_eq_invU_mul (D : GroupVonNeumannAlgebra G) (a : D.N) (s : nonZeroDivisors D.N) :
    (a /ₒ s : D.affiliated) = invU D s * numU D a := by
  show (a /ₒ s : D.affiliated) = (1 /ₒ s) * (a /ₒ 1)
  rw [OreLocalization.one_div_mul, one_mul]

theorem isStarRegularRing_affiliated (D : GroupVonNeumannAlgebra G) :
    IsStarRegularRing D.affiliated := by
  have hbaer : BaerRing.HasBaerAnnihilators D.N := D.baer
  have hproper : IsProperStar D.N := BaerLocalization.isProperStar_of_hasBaerAnnihilators hbaer
  constructor
  · -- von Neumann regularity
    intro x
    refine OreLocalization.ind (X := D.N) (β := fun x => ∃ y : D.affiliated, x * y * x = x) ?_ x
    intro a s
    set h : D.N := star a * a with hdef
    have hh : star h = h := by rw [hdef, star_mul, star_star]
    set p : D.N := BaerRing.rightProj hbaer h with pdef
    have hp_idem : p * p = p :=
      (BaerRing.rightProj_isStarProjection hbaer h).isIdempotentElem.eq
    have hB : BaerRing.rightProj hbaer (star a * a) = BaerRing.rightProj hbaer a :=
      BaerLocalization.rightProj_star_mul_self hbaer a
    have hp_eq : p = BaerRing.rightProj hbaer a := by rw [pdef, hdef]; exact hB
    have hp_mul : a * p = a := by
      rw [hp_eq]; exact BaerRing.rightProj_mul_self hbaer a
    have hC : (h + (1 - BaerRing.rightProj hbaer h)) * h = h * h ∧
        h * (h + (1 - BaerRing.rightProj hbaer h)) = h * h ∧
        (h + (1 - BaerRing.rightProj hbaer h)) * BaerRing.rightProj hbaer h = h ∧
        BaerRing.rightProj hbaer h * (h + (1 - BaerRing.rightProj hbaer h)) = h ∧
        h + (1 - BaerRing.rightProj hbaer h) ∈ nonZeroDivisors D.N :=
      BaerLocalization.selfAdjoint_add_one_sub_rightProj hbaer hh
    have hC3 : (h + (1 - p)) * p = h := by have := hC.2.2.1; rwa [← pdef] at this
    have hC4 : p * (h + (1 - p)) = h := by have := hC.2.2.2.1; rwa [← pdef] at this
    have hCnzd : h + (1 - p) ∈ nonZeroDivisors D.N := by
      have := hC.2.2.2.2; rwa [← pdef] at this
    obtain ⟨s2, hs2⟩ : ∃ t : nonZeroDivisors D.N, (t : D.N) = h + (1 - p) :=
      ⟨⟨h + (1 - p), hCnzd⟩, rfl⟩
    set σ : D.affiliated := invU D s2 with σdef
    have hσ_left : σ * numU D (h + (1 - p)) = 1 := by
      rw [σdef, show numU D (h + (1 - p)) = numU D (s2 : D.N) from by rw [hs2]]
      exact invU_mul D s2
    have hσ_right : numU D (h + (1 - p)) * σ = 1 := by
      rw [σdef, show numU D (h + (1 - p)) = numU D (s2 : D.N) from by rw [hs2]]
      exact mul_invU D s2
    have hσ_h : σ * numU D h = numU D p := by
      have h2 : numU D h = numU D (h + (1 - p)) * numU D p := by
        rw [← map_mul]; congr 1; exact hC3.symm
      rw [h2, ← mul_assoc, hσ_left, one_mul]
    have hh_σ : numU D h * σ = numU D p := by
      have h2 : numU D h = numU D p * numU D (h + (1 - p)) := by
        rw [← map_mul]; congr 1; exact hC4.symm
      rw [h2, mul_assoc, hσ_right, mul_one]
    set yself : D.affiliated := σ * numU D h * σ with yselfdef
    have hpnum : numU D p * numU D p = numU D p := by rw [← map_mul, hp_idem]
    have hyself : yself * numU D h = numU D p := by
      rw [yselfdef]
      calc σ * numU D h * σ * numU D h
          = (σ * numU D h) * (σ * numU D h) := by noncomm_ring
        _ = numU D p * numU D p := by rw [hσ_h]
        _ = numU D p := hpnum
    have h1 : numU D (star a) * numU D a = numU D h := by rw [← map_mul, hdef]
    have h2 : numU D a * numU D p = numU D a := by rw [← map_mul, hp_mul]
    have haua : numU D a * (yself * numU D (star a)) * numU D a = numU D a := by
      calc numU D a * (yself * numU D (star a)) * numU D a
          = numU D a * yself * (numU D (star a) * numU D a) := by noncomm_ring
        _ = numU D a * yself * numU D h := by rw [h1]
        _ = numU D a * (yself * numU D h) := by noncomm_ring
        _ = numU D a * numU D p := by rw [hyself]
        _ = numU D a := h2
    refine ⟨(yself * numU D (star a)) * numU D (s : D.N), ?_⟩
    rw [oreDiv_eq_invU_mul D a s]
    have hs_right : numU D (s : D.N) * invU D s = 1 := mul_invU D s
    calc invU D s * numU D a * ((yself * numU D (star a)) * numU D (s : D.N))
          * (invU D s * numU D a)
        = invU D s * (numU D a * yself * numU D (star a)) * (numU D (s : D.N) * invU D s)
            * numU D a := by noncomm_ring
      _ = invU D s * (numU D a * yself * numU D (star a)) * 1 * numU D a := by rw [hs_right]
      _ = invU D s * (numU D a * (yself * numU D (star a)) * numU D a) := by
          rw [mul_one]; noncomm_ring
      _ = invU D s * numU D a := by rw [haua]
  · -- proper involution
    intro x
    refine OreLocalization.ind (X := D.N) (β := fun x => x * star x = 0 → x = 0) ?_ x
    intro a s hx
    have h1 : numU D (s : D.N) * (a /ₒ s : D.affiliated) = numU D a := by
      show (↑(OreLocalization.numeratorUnit (S := nonZeroDivisors D.N) s) : D.affiliated)
          * (a /ₒ s) = a /ₒ 1
      exact OreLocalization.mul_cancel
    have h2 : numU D (star a) = star (numU D a) := (affiliated_star_numerator D a).symm
    have hxa : numU D a * star (numU D a) = 0 := by
      calc numU D a * star (numU D a)
          = (numU D (s : D.N) * (a /ₒ s)) * star (numU D (s : D.N) * (a /ₒ s)) := by rw [h1]
        _ = numU D (s : D.N) * ((a /ₒ s) * star (a /ₒ s)) * star (numU D (s : D.N)) := by
            rw [star_mul]; noncomm_ring
        _ = 0 := by rw [hx, mul_zero, zero_mul]
    have hzero : numU D (a * star a) = 0 := by rw [map_mul, h2]; exact hxa
    have hinj : Function.Injective (numU D) :=
      OreLocalization.numeratorHom_inj (fun t ht => (mem_nonZeroDivisors_iff'.mp ht).1)
    have haz : a * star a = 0 := hinj (by rw [hzero, map_zero])
    have ha : a = 0 := hproper a haz
    rw [oreDiv_eq_invU_mul D a s, ha, map_zero, mul_zero]

theorem starRegularAffiliated {G : Type*} [Group G] [Countable G] [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableMul G] : IsStarRegularRing (Work.ORVonNeumann.Rep.countableGroupVonNeumann (G := G)).affiliated :=
  isStarRegularRing_affiliated _

end Work.ORVonNeumann.VonNeumannAlgebra
