# `Matₙ(R)` is von Neumann regular when `R` is

If `R` is a von Neumann regular ring (every element has a weak inverse) then so is the full
matrix ring `Matₙ(R)` for every `n`.  Equivalently, for every matrix `A` there is `B` with
`A * B * A = A`.

The proof is an explicit induction.  Regard `Fin n → R` as the module of row vectors and let
`v ↦ v ᵥ* A` be the `R`-linear map "right multiplication by `A`".  Writing `Im(A)` for its
range (the row space of `A`), we first show

* `fgRightIdeal_exists_idempotent`: in a von Neumann regular ring every finitely generated
  right ideal (here generated by the coordinates of a row `w : Fin n → R`) is generated by an
  idempotent `e`, i.e. `∑ i, w i * R = e * R`;

* `exists_idempotent_of_vectors`: consequently the span of finitely many row vectors
  `v : Fin k → (Fin n → R)` is the range of an idempotent matrix `P`.  The induction step adds
  one generator `w`: if `P` projects onto `M` then `Q = P + (1 - P) * vecMulVec z w` projects
  onto `M ⊕ Rw`, where `z` is read off from the idempotent generator `f` of the right ideal
  generated by the entries of the component of the new generator in `ker P`.

Applying this to the rows of `A` gives an idempotent `P` with `Im(P) = Im(A)`; then
`A * P = A` and each row of `P` lies in `Im(A)`, so `P = X * A` for some `X`, whence
`A * X * A = A * P = A`.

The first ingredient is a standard fact about von Neumann regular rings; we prove it here
from scratch, following the classical argument that `eR + bR` is again a principal right
ideal generated by an idempotent (via the corner `(1 - e)R(1 - e)`).
-/
import Mathlib
import Submission.Work.ORVonNeumann.Basic

set_option autoImplicit false

namespace Work.ORVonNeumann.Regular

open scoped BigOperators Pointwise
open Matrix

variable {R : Type*} [Ring R]

/-! ### The right ideal generated by a finite family -/

/-- The right ideal generated by `a : Fin k → R`, as a set. -/
def gen {k : ℕ} (a : Fin k → R) : Set R := {x | ∃ r : Fin k → R, x = ∑ i, a i * r i}

/-- The principal right ideal generated by `b`, as a set. -/
def genS (b : R) : Set R := {x | ∃ y : R, x = b * y}

/-- An idempotent `e` generates its own principal right ideal idempotently: `eR + eR = eR`. -/
lemma genS_add_self {e : R} (he : e * e = e) : genS e + genS e = genS e := by
  apply le_antisymm
  · rintro x ⟨u, ⟨y, rfl⟩, v, ⟨w, rfl⟩, rfl⟩
    refine ⟨e * y + e * w, ?_⟩
    rw [mul_add, ← mul_assoc, ← mul_assoc, he]
  · rintro x ⟨y, rfl⟩
    exact ⟨e*y, ⟨y, rfl⟩, 0, ⟨0, by rw [mul_zero]⟩, by abel⟩

/-- Orthogonal idempotents `e`, `g` act trivially on `e*x + g*y`. -/
lemma idem_add_mul {e g : R} (he : e*e=e) (hg : g*g=g) (heg : e*g=0) (hge : g*e=0)
    (x y : R) : (e+g) * (e*x + g*y) = e*x + g*y := by
  have h : (e+g) * (e*x + g*y) = e*e*x + e*g*y + g*e*x + g*g*y := by noncomm_ring
  rw [h, he, heg, hge, hg]; simp

/-- **The key step.**  If `e` is an idempotent, then `eR + bR` is again generated by an
idempotent.  Writing `d = (1 - e) * b` and using the weak inverse `z` of `d`, the idempotent is
`e + d * (z * (1 - e))`, and `eR + bR = eR + dR = eR ⊕ gR`. -/
lemma genS_add_genS_idem (hreg : VonNeumannRegular R) {e b : R} (hee : e * e = e) :
    ∃ e' : R, e' * e' = e' ∧ genS e + genS b = genS e' := by
  have hef : e * (1 - e) = 0 := by rw [mul_sub, mul_one, hee, sub_self]
  have hfe : (1 - e) * e = 0 := by rw [sub_mul, one_mul, hee, sub_self]
  have hff : (1 - e) * (1 - e) = 1 - e := by
    have he : IsIdempotentElem e := hee
    exact he.one_sub.eq
  obtain ⟨z, hz⟩ : ∃ z : R, ((1-e)*b) * z * ((1-e)*b) = (1-e)*b := hreg ((1-e)*b)
  set g : R := ((1-e)*b) * (z*(1-e)) with hgdef
  have hdgd : g * ((1-e)*b) = (1-e)*b := by
    rw [hgdef]
    have h1 : ((1-e)*b) * (z*(1-e)) * ((1-e)*b) = (1-e)*b*z*((1-e)*(1-e))*b := by noncomm_ring
    have h3 : (1-e)*b*z*(1-e)*b = ((1-e)*b) * z * ((1-e)*b) := by noncomm_ring
    rw [h1, hff, h3]; exact hz
  have hgg : g * g = g := by
    rw [hgdef]
    rw [← mul_assoc (((1-e)*b)*(z*(1-e))) ((1-e)*b) (z*(1-e)), hdgd]
  have heg : e * g = 0 := by
    rw [hgdef, mul_assoc (1-e) b (z*(1-e)), ← mul_assoc e (1-e) (b*(z*(1-e))), hef, zero_mul]
  have hge : g * e = 0 := by
    rw [hgdef, mul_assoc ((1-e)*b) (z*(1-e)) e, mul_assoc z (1-e) e, hfe, mul_zero, mul_zero]
  have hgpd : (e + g) * (e + g) = e + g := by
    have hh : (e + g) * (e + g) = e*e + e*g + g*e + g*g := by noncomm_ring
    rw [hh, hee, heg, hge, hgg]; simp
  refine ⟨e + g, hgpd, ?_⟩
  have hgd : genS ((1-e)*b) = genS g := by
    apply le_antisymm
    · rintro x ⟨y, rfl⟩
      exact ⟨((1-e)*b)*y, by rw [hgdef, ← mul_assoc (((1-e)*b)*(z*(1-e))) ((1-e)*b) y, hdgd]⟩
    · rintro x ⟨y, rfl⟩
      exact ⟨(z*(1-e))*y, by rw [hgdef, mul_assoc]⟩
  apply le_antisymm
  · rintro x ⟨u, ⟨y, rfl⟩, v, ⟨w, rfl⟩, rfl⟩
    have hbw : b*w = e*(b*w) + g*(((1-e)*b)*w) := by
      have hb : b = e*b + (1-e)*b := by rw [← add_mul, show e + (1-e) = 1 by abel, one_mul]
      have hgw : g*(((1-e)*b)*w) = ((1-e)*b)*w := by
        rw [hgdef, ← mul_assoc (((1-e)*b)*(z*(1-e))) ((1-e)*b) w, hdgd]
      conv_lhs => rw [hb]
      rw [add_mul, mul_assoc, hgw]
    refine ⟨e*(y + b*w) + g*(((1-e)*b)*w), ?_⟩
    rw [idem_add_mul hee hgg heg hge (y+b*w) (((1-e)*b)*w)]
    conv_lhs => rw [hbw]
    rw [mul_add]
    abel
  · rintro x ⟨w, rfl⟩
    have hgw : g*w ∈ genS g := ⟨w, rfl⟩
    rw [← hgd] at hgw
    obtain ⟨t, ht⟩ := hgw
    refine ⟨e*w + e*(-(b*t)), ⟨w + -(b*t), ?_⟩, b*t, ⟨t, rfl⟩, ?_⟩
    · rw [mul_add]
    · rw [add_mul, ht]
      have hdt : ((1-e)*b)*t = b*t + e*(-(b*t)) := by noncomm_ring
      rw [hdt]; abel

/-- Splitting off the last generator: the right ideal generated by `a : Fin (k+1) → R` is the
sum of the ideal generated by the first `k` coordinates and the principal ideal generated by
the last one. -/
lemma gen_succ {k : ℕ} (a : Fin (k+1) → R) :
    gen a = gen (fun i : Fin k => a i.castSucc) + genS (a (Fin.last k)) := by
  ext x
  constructor
  · rintro ⟨r, hr⟩
    refine ⟨∑ i : Fin k, a i.castSucc * r i.castSucc, ⟨fun i => r i.castSucc, rfl⟩,
      a (Fin.last k) * r (Fin.last k), ⟨r (Fin.last k), rfl⟩, ?_⟩
    rw [hr, Fin.sum_univ_castSucc]
  · rintro ⟨u, ⟨s, hs⟩, v, ⟨t, ht⟩, rfl⟩
    refine ⟨Fin.snoc s t, ?_⟩
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    rw [← hs, ← ht]

/-- **Every finitely generated right ideal of a von Neumann regular ring is generated by an
idempotent**, in the form `∑ i, a i * R = e * R` (set version). -/
theorem fgRightIdeal_genS (hreg : VonNeumannRegular R) :
    ∀ (k : ℕ) (a : Fin k → R), ∃ e : R, e * e = e ∧ gen a = genS e := by
  intro k
  induction k with
  | zero =>
    intro a
    refine ⟨0, by rw [mul_zero], ?_⟩
    ext x; constructor
    · rintro ⟨r, hr⟩
      rw [Fin.sum_univ_zero] at hr
      exact ⟨0, by rw [hr, mul_zero]⟩
    · rintro ⟨y, hy⟩
      exact ⟨Fin.elim0, by rw [Fin.sum_univ_zero, hy, zero_mul]⟩
  | succ k ih =>
    intro a
    obtain ⟨e, hee, hgen⟩ := ih (fun i : Fin k => a i.castSucc)
    obtain ⟨e', he', hsum⟩ := genS_add_genS_idem hreg (b := a (Fin.last k)) hee
    refine ⟨e', he', ?_⟩
    rw [gen_succ, hgen]
    exact hsum

/-- **Every finitely generated right ideal of a von Neumann regular ring is generated by an
idempotent**, in the `∃`-form used below. -/
theorem fgRightIdeal_exists_idempotent (hreg : VonNeumannRegular R) (k : ℕ) (a : Fin k → R) :
    ∃ e : R, e * e = e ∧
      ∀ x : R, (∃ r : Fin k → R, x = ∑ i, a i * r i) ↔ ∃ y : R, x = e * y := by
  obtain ⟨e, he, hg⟩ := fgRightIdeal_genS hreg k a
  exact ⟨e, he, fun x => Set.ext_iff.mp hg x⟩

/-! ### Idempotent matrices with prescribed row space -/

/-- A row vector is the sum of its coordinates against the standard basis. -/
lemma sum_mul_single {n : ℕ} (w : Fin n → R) (i : Fin n) :
    (∑ j, w j * (Pi.single i (1 : R) : Fin n → R) j) = w i := by
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    rw [Pi.single_eq_of_ne hj, mul_zero]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- The `i`-th row of `A` is the image of the `i`-th standard basis vector under `v ↦ v ᵥ* A`. -/
lemma row_eq_single_vecMul {n : ℕ} (A : Matrix (Fin n) (Fin n) R) (i : Fin n) :
    vecMul (Pi.single i (1 : R) : Fin n → R) A = A i := by
  rw [Matrix.single_one_vecMul]
  rfl

/-- The rows of `A` lie in the range of the `R`-linear map `v ↦ v ᵥ* A`. -/
lemma row_mem_range {n : ℕ} (A : Matrix (Fin n) (Fin n) R) (i : Fin n) :
    A i ∈ (A.toLinearMapRight').range :=
  ⟨Pi.single i (1 : R), by rw [Matrix.toLinearMapRight'_apply, row_eq_single_vecMul]⟩

/-- **Key induction.**  Given finitely many vectors `v : Fin k → (Fin n → R)` over a von
Neumann regular ring, there is an idempotent matrix `P` whose range (for the action
`v ↦ v ᵥ* P`) contains all the `v i` and is contained in their span.  In particular the span
of the `v i` is the range of an idempotent matrix. -/
theorem exists_idempotent_of_vectors (hreg : VonNeumannRegular R) (n : ℕ) :
    ∀ k : ℕ, ∀ v : Fin k → (Fin n → R), ∃ P : Matrix (Fin n) (Fin n) R,
      P * P = P ∧
      (∀ u : Fin n → R, vecMul u P ∈ Submodule.span R (Set.range v)) ∧
      (∀ i : Fin k, vecMul (v i) P = v i) := by
  intro k
  induction k with
  | zero =>
      intro v
      refine ⟨0, by simp, ?_, ?_⟩
      · intro u
        rw [Matrix.vecMul_zero]
        exact Submodule.zero_mem _
      · intro i
        exact i.elim0
  | succ k ih =>
      intro v
      obtain ⟨P, hP, him, hfix⟩ := ih (fun i : Fin k => v i.castSucc)
      set w : Fin n → R := v (Fin.last k) - vecMul (v (Fin.last k)) P with hwdef
      obtain ⟨f, hf, hfid⟩ := fgRightIdeal_exists_idempotent hreg n w
      obtain ⟨z, hz⟩ : ∃ z : Fin n → R, (∑ i, w i * z i) = f := by
        obtain ⟨r, hr⟩ := (hfid f).mpr ⟨1, (mul_one f).symm⟩
        exact ⟨r, hr.symm⟩
      have hdot : dotProduct w z = f := hz
      have hfw : ∀ i : Fin n, f * w i = w i := by
        intro i
        obtain ⟨y, hy⟩ := (hfid (w i)).mp ⟨Pi.single i 1, (sum_mul_single w i).symm⟩
        calc f * w i = f * (f * y) := by rw [hy]
          _ = (f * f) * y := by rw [mul_assoc]
          _ = f * y := by rw [hf]
          _ = w i := hy.symm
      have hfw' : f • w = w := by
        funext i
        simpa using hfw i
      have hwP : vecMul w P = 0 := by
        rw [hwdef, Matrix.sub_vecMul, Matrix.vecMul_vecMul, hP, sub_self]
      have hw1 : vecMul w (1 - P) = w := by
        rw [Matrix.vecMul_sub, Matrix.vecMul_one, hwP, sub_zero]
      set Q : Matrix (Fin n) (Fin n) R := P + (1 - P) * vecMulVec z w with hQdef
      have hQ : ∀ u : Fin n → R,
          vecMul u Q = vecMul u P + (dotProduct (vecMul u (1 - P)) z) • w := by
        intro u
        rw [hQdef, Matrix.vecMul_add, ← Matrix.vecMul_vecMul, Matrix.vecMul_vecMulVec]
      have hwQ : vecMul w Q = w := by
        rw [hQ w, hwP, zero_add, hw1, hdot, hfw']
      have hPfix : ∀ u : Fin n → R, vecMul (vecMul u P) Q = vecMul u P := by
        intro u
        have h1 : vecMul (vecMul u P) P = vecMul u P := by
          rw [Matrix.vecMul_vecMul, hP]
        have h2 : vecMul (vecMul u P) (1 - P) = 0 := by
          rw [Matrix.vecMul_sub, Matrix.vecMul_one, h1, sub_self]
        rw [hQ (vecMul u P), h1, h2, zero_dotProduct, zero_smul, add_zero]
      have hwfix : ∀ c : R, vecMul (c • w) Q = c • w := by
        intro c
        have h1 : vecMul (c • w) P = 0 := by rw [Matrix.smul_vecMul, hwP, smul_zero]
        have h2 : vecMul (c • w) (1 - P) = c • w := by rw [Matrix.smul_vecMul, hw1]
        rw [hQ (c • w), h1, h2, zero_add, smul_dotProduct, hdot]
        show (c * f) • w = c • w
        rw [← smul_smul, hfw']
      refine ⟨Q, ?_, ?_, ?_⟩
      · rw [Matrix.ext_iff_vecMul]
        intro u
        rw [← Matrix.vecMul_vecMul, hQ u, Matrix.add_vecMul,
          hPfix u, hwfix (dotProduct (vecMul u (1 - P)) z)]
      · intro u
        have hrange : Submodule.span R (Set.range (fun i : Fin k => v i.castSucc))
            ≤ Submodule.span R (Set.range v) :=
          Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨i.castSucc, rfl⟩)
        have h1 : vecMul u P ∈ Submodule.span R (Set.range v) := hrange (him u)
        have h2 : v (Fin.last k) ∈ Submodule.span R (Set.range v) :=
          Submodule.subset_span ⟨Fin.last k, rfl⟩
        have h3 : w ∈ Submodule.span R (Set.range v) := by
          rw [hwdef]
          exact Submodule.sub_mem _ h2 (hrange (him (v (Fin.last k))))
        have h4 : (dotProduct (vecMul u (1 - P)) z) • w
            ∈ Submodule.span R (Set.range v) := Submodule.smul_mem _ _ h3
        rw [hQ u]
        exact Submodule.add_mem _ h1 h4
      · rw [Fin.forall_fin_succ']
        constructor
        · intro i
          have h1 : vecMul (v i.castSucc) (1 - P) = 0 := by
            rw [Matrix.vecMul_sub, Matrix.vecMul_one, hfix i, sub_self]
          rw [hQ (v i.castSucc), hfix i, h1, zero_dotProduct, zero_smul, add_zero]
        · have hlast : v (Fin.last k) = vecMul (v (Fin.last k)) P + w := by
            rw [hwdef]
            abel
          rw [hlast, Matrix.add_vecMul, hPfix (v (Fin.last k)), hwQ]

/-- **Matrices over a von Neumann regular ring are von Neumann regular.** -/
theorem matrix_vonNeumannRegular {R : Type*} [Ring R] (h : Work.ORVonNeumann.VonNeumannRegular R) (n : ℕ) : Work.ORVonNeumann.VonNeumannRegular (Matrix (Fin n) (Fin n) R) := by
  intro A
  obtain ⟨P, hP, him, hfix⟩ := exists_idempotent_of_vectors h n n A
  have hAfix : ∀ u : Fin n → R, vecMul (vecMul u A) P = vecMul u A := by
    intro u
    calc vecMul (vecMul u A) P = vecMul (∑ i, u i • A i) P := by rw [Matrix.vecMul_eq_sum u A]
      _ = ∑ i, u i • vecMul (A i) P := by
            rw [Matrix.sum_vecMul]
            exact Finset.sum_congr rfl fun i _ => by rw [Matrix.smul_vecMul]
      _ = ∑ i, u i • A i := Finset.sum_congr rfl fun i _ => by rw [hfix i]
      _ = vecMul u A := by rw [Matrix.vecMul_eq_sum u A]
  have hAP : A * P = A := by
    rw [Matrix.ext_iff_vecMul]
    intro u
    rw [← Matrix.vecMul_vecMul]
    exact hAfix u
  have hspan_le : Submodule.span R (Set.range A) ≤ (A.toLinearMapRight').range := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact row_mem_range A i
  have hrowmem : ∀ i : Fin n, P i ∈ Submodule.span R (Set.range A) := by
    intro i
    rw [← row_eq_single_vecMul P i]
    exact him (Pi.single i (1 : R))
  have hrow : ∀ i : Fin n, ∃ x : Fin n → R, A.toLinearMapRight' x = P i :=
    fun i => LinearMap.mem_range.mp (hspan_le (hrowmem i))
  choose x hx using hrow
  let X : Matrix (Fin n) (Fin n) R := fun i => x i
  have hrows : ∀ i : Fin n, (X * A) i = P i := by
    intro i
    have h3 : vecMul (x i) A = P i := by
      have h4 := hx i
      rwa [Matrix.toLinearMapRight'_apply] at h4
    rw [← row_eq_single_vecMul (X * A) i, ← Matrix.vecMul_vecMul, row_eq_single_vecMul]
    exact h3
  have hXA : X * A = P := funext hrows
  refine ⟨X, ?_⟩
  rw [Matrix.mul_assoc, hXA, hAP]

end Work.ORVonNeumann.Regular
