import Mathlib
import Submission.Work.ORVonNeumann.Basic
import Submission.Work.ORVonNeumann.Regular.matrix_isProperStar
import Submission.Work.ORVonNeumann.Regular.fg_rightIdeal_exists_idempotent

/-!
# `Matₙ(R)` is `*`-regular when `R` is von Neumann regular with no non-trivial squares

This file proves that for a ring `R` which is von Neumann regular and in which a sum of
norms `∑ xᵢ xᵢ⋆ = 0` forces all `xᵢ = 0`, the matrix ring `Matₙ(R)` is `*`-regular for the
conjugate-transpose involution.

The `*`-regularity splits into two halves:

* `matrix_isProperStar` (proved separately): the conjugate-transpose involution on `Matₙ(R)`
  is proper, because the `(i,i)` entry of `A * A⋆` is the norm `∑ k, A i k * star (A i k)`;
* the present file: `Matₙ(R)` is von Neumann regular whenever `R` is, i.e. for every
  `A : Matₙ(R)` there is `B` with `A * B * A = A`.

The second half is proved here by an explicit induction.  Regard `Fin n → R` as a left
`R`-module (pointwise multiplication) and let `v ↦ v ᵥ* A` be the `R`-linear endomorphism
given by right multiplication by `A`.  Writing `Im(A)` for its range, we prove by induction
on the number of generators that the span of finitely many vectors `v : Fin k → (Fin n → R)`
is the range of an idempotent matrix `P`.  The induction step is the classical "add one
generator" step: if `P` is a projection with image `M` and `w` is the component of the new
generator in `ker P`, then `Q = P + (1 - P) * vecMulVec z w` is a projection onto `M ⊕ Rw`,
where `z` is read off from the idempotent generator `f` of the right ideal generated by the
entries of `w` (so that `f * w i = w i` and `∑ i, w i * z i = f`).

Applying this to the rows of `A` gives an idempotent `P` with `Im(P) = Im(A)`; then
`A * P = A` and each row of `P` lies in `Im(A)`, so `P = X * A` for some `X`, whence
`A * X * A = A * P = A`.
-/

namespace Work.ORVonNeumann.Regular

open Matrix

variable {R : Type*} [Ring R]

/-- A row vector is the sum of its coordinates against the standard basis. -/
lemma sum_mul_single {n : ℕ} (w : Fin n → R) (i : Fin n) :
    (∑ j, w j * (Pi.single i (1 : R) : Fin n → R) j) = w i := by
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    rw [Pi.single_eq_of_ne hj, mul_zero]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- The `i`-th row of `A` is the image of the `i`-th standard basis vector under `v ↦ v ᵥ* A`. -/
lemma row_eq_single_vecMul {n : ℕ} (A : Matrix (Fin n) (Fin n) R) (i : Fin n) :
    vecMul (Pi.single i (1 : R) : Fin n → R) A = A i := by
  rw [Matrix.single_one_vecMul]
  rfl

/-- The rows of `A` lie in the range of the `R`-linear map `v ↦ v ᵥ* A`. -/
lemma row_mem_range {n : ℕ} (A : Matrix (Fin n) (Fin n) R) (i : Fin n) :
    A i ∈ (A.toLinearMapRight').range :=
  ⟨Pi.single i (1 : R), by rw [Matrix.toLinearMapRight'_apply, row_eq_single_vecMul]⟩

/-- **Key induction.**  Given finitely many vectors `v : Fin k → (Fin n → R)` over a von
Neumann regular ring, there is an idempotent matrix `P` whose range (for the action
`v ↦ v ᵥ* P`) contains all the `v i` and is contained in their span.  In particular the span
of the `v i` is the range of an idempotent matrix. -/
theorem exists_idempotent_of_vectors (hreg : VonNeumannRegular R) (n : ℕ) :
    ∀ k : ℕ, ∀ v : Fin k → (Fin n → R), ∃ P : Matrix (Fin n) (Fin n) R,
      P * P = P ∧
      (∀ u : Fin n → R, vecMul u P ∈ Submodule.span R (Set.range v)) ∧
      (∀ i : Fin k, vecMul (v i) P = v i) := by
  intro k
  induction k with
  | zero =>
      intro v
      refine ⟨0, by simp, ?_, ?_⟩
      · intro u
        rw [Matrix.vecMul_zero]
        exact Submodule.zero_mem _
      · intro i
        exact i.elim0
  | succ k ih =>
      intro v
      obtain ⟨P, hP, him, hfix⟩ := ih (fun i : Fin k => v i.castSucc)
      set w : Fin n → R := v (Fin.last k) - vecMul (v (Fin.last k)) P with hwdef
      obtain ⟨f, hf, hfid⟩ := fg_rightIdeal_exists_idempotent hreg n w
      obtain ⟨z, hz⟩ : ∃ z : Fin n → R, (∑ i, w i * z i) = f := by
        obtain ⟨r, hr⟩ := (hfid f).mpr ⟨1, (mul_one f).symm⟩
        exact ⟨r, hr.symm⟩
      have hdot : dotProduct w z = f := hz
      have hfw : ∀ i : Fin n, f * w i = w i := by
        intro i
        obtain ⟨y, hy⟩ := (hfid (w i)).mp ⟨Pi.single i 1, (sum_mul_single w i).symm⟩
        calc f * w i = f * (f * y) := by rw [hy]
          _ = (f * f) * y := by rw [mul_assoc]
          _ = f * y := by rw [hf]
          _ = w i := hy.symm
      have hfw' : f • w = w := by
        funext i
        simpa using hfw i
      have hwP : vecMul w P = 0 := by
        rw [hwdef, Matrix.sub_vecMul, Matrix.vecMul_vecMul, hP, sub_self]
      have hw1 : vecMul w (1 - P) = w := by
        rw [Matrix.vecMul_sub, Matrix.vecMul_one, hwP, sub_zero]
      set Q : Matrix (Fin n) (Fin n) R := P + (1 - P) * vecMulVec z w with hQdef
      have hQ : ∀ u : Fin n → R,
          vecMul u Q = vecMul u P + (dotProduct (vecMul u (1 - P)) z) • w := by
        intro u
        rw [hQdef, Matrix.vecMul_add, ← Matrix.vecMul_vecMul, Matrix.vecMul_vecMulVec]
      have hwQ : vecMul w Q = w := by
        rw [hQ w, hwP, zero_add, hw1, hdot, hfw']
      have hPfix : ∀ u : Fin n → R, vecMul (vecMul u P) Q = vecMul u P := by
        intro u
        have h1 : vecMul (vecMul u P) P = vecMul u P := by
          rw [Matrix.vecMul_vecMul, hP]
        have h2 : vecMul (vecMul u P) (1 - P) = 0 := by
          rw [Matrix.vecMul_sub, Matrix.vecMul_one, h1, sub_self]
        rw [hQ (vecMul u P), h1, h2, zero_dotProduct, zero_smul, add_zero]
      have hwfix : ∀ c : R, vecMul (c • w) Q = c • w := by
        intro c
        have h1 : vecMul (c • w) P = 0 := by rw [Matrix.smul_vecMul, hwP, smul_zero]
        have h2 : vecMul (c • w) (1 - P) = c • w := by rw [Matrix.smul_vecMul, hw1]
        rw [hQ (c • w), h1, h2, zero_add, smul_dotProduct, hdot]
        show (c * f) • w = c • w
        rw [← smul_smul, hfw']
      refine ⟨Q, ?_, ?_, ?_⟩
      · rw [Matrix.ext_iff_vecMul]
        intro u
        rw [← Matrix.vecMul_vecMul, hQ u, Matrix.add_vecMul,
          hPfix u, hwfix (dotProduct (vecMul u (1 - P)) z)]
      · intro u
        have hrange : Submodule.span R (Set.range (fun i : Fin k => v i.castSucc))
            ≤ Submodule.span R (Set.range v) :=
          Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨i.castSucc, rfl⟩)
        have h1 : vecMul u P ∈ Submodule.span R (Set.range v) := hrange (him u)
        have h2 : v (Fin.last k) ∈ Submodule.span R (Set.range v) :=
          Submodule.subset_span ⟨Fin.last k, rfl⟩
        have h3 : w ∈ Submodule.span R (Set.range v) := by
          rw [hwdef]
          exact Submodule.sub_mem _ h2 (hrange (him (v (Fin.last k))))
        have h4 : (dotProduct (vecMul u (1 - P)) z) • w
            ∈ Submodule.span R (Set.range v) := Submodule.smul_mem _ _ h3
        rw [hQ u]
        exact Submodule.add_mem _ h1 h4
      · rw [Fin.forall_fin_succ']
        constructor
        · intro i
          have h1 : vecMul (v i.castSucc) (1 - P) = 0 := by
            rw [Matrix.vecMul_sub, Matrix.vecMul_one, hfix i, sub_self]
          rw [hQ (v i.castSucc), hfix i, h1, zero_dotProduct, zero_smul, add_zero]
        · have hlast : v (Fin.last k) = vecMul (v (Fin.last k)) P + w := by
            rw [hwdef]
            abel
          rw [hlast, Matrix.add_vecMul, hPfix (v (Fin.last k)), hwQ]

/-- **Matrices over a von Neumann regular ring are von Neumann regular.** -/
theorem matrix_vonNeumannRegular_aux (hreg : VonNeumannRegular R) (n : ℕ) :
    VonNeumannRegular (Matrix (Fin n) (Fin n) R) := by
  intro A
  obtain ⟨P, hP, him, hfix⟩ := exists_idempotent_of_vectors hreg n n A
  have hAfix : ∀ u : Fin n → R, vecMul (vecMul u A) P = vecMul u A := by
    intro u
    calc vecMul (vecMul u A) P = vecMul (∑ i, u i • A i) P := by rw [Matrix.vecMul_eq_sum u A]
      _ = ∑ i, u i • vecMul (A i) P := by
            rw [Matrix.sum_vecMul]
            exact Finset.sum_congr rfl fun i _ => by rw [Matrix.smul_vecMul]
      _ = ∑ i, u i • A i := Finset.sum_congr rfl fun i _ => by rw [hfix i]
      _ = vecMul u A := by rw [Matrix.vecMul_eq_sum u A]
  have hAP : A * P = A := by
    rw [Matrix.ext_iff_vecMul]
    intro u
    rw [← Matrix.vecMul_vecMul]
    exact hAfix u
  have hspan_le : Submodule.span R (Set.range A) ≤ (A.toLinearMapRight').range := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact row_mem_range A i
  have hrowmem : ∀ i : Fin n, P i ∈ Submodule.span R (Set.range A) := by
    intro i
    rw [← row_eq_single_vecMul P i]
    exact him (Pi.single i (1 : R))
  have hrow : ∀ i : Fin n, ∃ x : Fin n → R, A.toLinearMapRight' x = P i :=
    fun i => LinearMap.mem_range.mp (hspan_le (hrowmem i))
  choose x hx using hrow
  let X : Matrix (Fin n) (Fin n) R := fun i => x i
  have hrows : ∀ i : Fin n, (X * A) i = P i := by
    intro i
    have h3 : vecMul (x i) A = P i := by
      have h4 := hx i
      rwa [Matrix.toLinearMapRight'_apply] at h4
    rw [← row_eq_single_vecMul (X * A) i, ← Matrix.vecMul_vecMul, row_eq_single_vecMul]
    exact h3
  have hXA : X * A = P := funext hrows
  refine ⟨X, ?_⟩
  rw [Matrix.mul_assoc, hXA, hAP]

theorem matrix_isStarRegularRing {R : Type*} [Ring R] [StarRing R] (hreg : Work.ORVonNeumann.VonNeumannRegular R) (hsq : Work.ORVonNeumann.HasNoNontrivialSquares R) (n : ℕ) : Work.ORVonNeumann.IsStarRegularRing (Matrix (Fin n) (Fin n) R) :=
  ⟨matrix_vonNeumannRegular_aux hreg n, matrix_isProperStar hsq n⟩

end Work.ORVonNeumann.Regular
