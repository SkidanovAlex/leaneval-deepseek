import Mathlib
import Submission.Work.ORVonNeumann.Basic

set_option autoImplicit false

namespace Work.ORVonNeumann.Regular

variable {R : Type*} [Ring R]

/-- In a ring, if `e` and `h` are idempotents with `e * h = 0`, then the right ideal
`eR + hR` is generated by the idempotent `e + h - h * e`. -/
lemma idem_add_orthogonal {e h : R} (he : e * e = e) (hh : h * h = h) (heh : e * h = 0) :
    (e + h - h * e) * (e + h - h * e) = e + h - h * e ∧
      ∀ x : R, (∃ u v : R, x = e * u + h * v) ↔ ∃ y : R, x = (e + h - h * e) * y := by
  have e1 : h * (h * e) = h * e := by rw [← mul_assoc, hh]
  have e2 : (h * e) * h = 0 := by rw [mul_assoc, heh, mul_zero]
  have e3 : (h * e) * (h * e) = 0 := by
    rw [mul_assoc, ← mul_assoc e h e, heh, zero_mul, mul_zero]
  have h1 : (h - h * e) * (h - h * e) = h - h * e := by
    rw [sub_mul, mul_sub, mul_sub, hh, e1, e2, e3]
    abel
  have h2 : e * (h - h * e) = 0 := by
    rw [mul_sub, heh, ← mul_assoc e h e, heh, zero_mul, sub_zero]
  have h3 : (h - h * e) * e = 0 := by
    rw [sub_mul, mul_assoc, he, sub_self]
  have hidem : (e + (h - h * e)) * (e + (h - h * e)) = e + (h - h * e) :=
    IsIdempotentElem.add he h1 (by rw [h2, h3, add_zero])
  have hidem' : (e + h - h * e) * (e + h - h * e) = e + h - h * e := by
    simpa [sub_eq_add_neg, add_assoc] using hidem
  refine ⟨hidem', fun x => ?_⟩
  have hge : (e + h - h * e) * e = e := by
    have hk : (h * e) * e = h * e := by rw [mul_assoc, he]
    rw [sub_mul, add_mul, he, hk]
    abel
  have hgh : (e + h - h * e) * h = h := by
    have hk : (h * e) * h = 0 := by rw [mul_assoc, heh, mul_zero]
    rw [sub_mul, add_mul, heh, hh, hk]
    abel
  constructor
  · rintro ⟨u, v, rfl⟩
    have hg1 : (e + h - h * e) * (e * u) = e * u := by rw [← mul_assoc, hge]
    have hg2 : (e + h - h * e) * (h * v) = h * v := by rw [← mul_assoc, hgh]
    exact ⟨e * u + h * v, by rw [mul_add, hg1, hg2]⟩
  · rintro ⟨y, rfl⟩
    exact ⟨y, y - e * y, by noncomm_ring⟩

/-- Adding one more generator to an idempotent-generated right ideal, over a von Neumann
regular ring, again produces an idempotent-generated right ideal. -/
lemma exists_idem_add_elem (hreg : VonNeumannRegular R) {e : R} (he : e * e = e) (c : R) :
    ∃ g : R, g * g = g ∧
      ∀ x : R, (∃ u v : R, x = e * u + c * v) ↔ ∃ y : R, x = g * y := by
  set x0 : R := (1 - e) * c with hx0
  obtain ⟨d, hd⟩ := hreg x0
  have hex0 : e * x0 = 0 := by
    rw [hx0, ← mul_assoc, mul_sub, mul_one, he, sub_self, zero_mul]
  have hh : (x0 * d) * (x0 * d) = x0 * d := by rw [← mul_assoc (x0 * d) x0 d, hd]
  have heh : e * (x0 * d) = 0 := by rw [← mul_assoc, hex0, zero_mul]
  have hx0h : (x0 * d) * x0 = x0 := hd
  obtain ⟨hg, hiff⟩ := idem_add_orthogonal he hh heh
  refine ⟨e + (x0 * d) - (x0 * d) * e, hg, fun x => ?_⟩
  have hkey : ∀ x : R, (∃ u v : R, x = e * u + c * v) ↔
      ∃ u v : R, x = e * u + (x0 * d) * v := by
    intro y
    constructor
    · rintro ⟨u, v, rfl⟩
      refine ⟨u + c * v, x0 * v, ?_⟩
      rw [mul_add, ← mul_assoc (x0 * d) x0 v, hx0h, hx0]
      noncomm_ring
    · rintro ⟨u, v, rfl⟩
      refine ⟨u - c * d * v, d * v, ?_⟩
      rw [hx0]
      noncomm_ring
  exact (hkey x).trans (hiff x)

theorem fg_rightIdeal_exists_idempotent {R : Type*} [Ring R] (hreg : Work.ORVonNeumann.VonNeumannRegular R) (k : ℕ) (a : Fin k → R) : ∃ e : R, e * e = e ∧ ∀ x : R, (∃ r : Fin k → R, x = ∑ i, a i * r i) ↔ ∃ y : R, x = e * y := by
  induction k with
  | zero =>
      exact ⟨0, by simp, fun x => by simp⟩
  | succ k ih =>
      obtain ⟨e, he, hiff⟩ := ih (fun i : Fin k => a i.castSucc)
      obtain ⟨g, hg, hgiff⟩ := exists_idem_add_elem hreg he (a (Fin.last k))
      refine ⟨g, hg, fun x => ?_⟩
      have hmain : (∃ r : Fin (k + 1) → R, x = ∑ i, a i * r i) ↔
          (∃ u v : R, x = e * u + a (Fin.last k) * v) := by
        constructor
        · rintro ⟨r, hr⟩
          rw [Fin.sum_univ_castSucc] at hr
          obtain ⟨u, hu⟩ := (hiff (∑ i : Fin k, a i.castSucc * r i.castSucc)).mp
            ⟨fun i => r i.castSucc, rfl⟩
          exact ⟨u, r (Fin.last k), by rw [hr, hu]⟩
        · rintro ⟨u, v, huv⟩
          obtain ⟨r', hr'⟩ := (hiff (e * u)).mpr ⟨u, rfl⟩
          refine ⟨Fin.snoc r' v, ?_⟩
          rw [huv, Fin.sum_univ_castSucc]
          simp only [Fin.snoc_castSucc, Fin.snoc_last]
          rw [hr']
      exact hmain.trans (hgiff x)

end Work.ORVonNeumann.Regular
