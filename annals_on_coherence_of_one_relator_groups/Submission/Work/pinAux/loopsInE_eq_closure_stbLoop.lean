import Mathlib
import Submission.Work.OROneRel.winBasisDefs
import Submission.Work.OROneRel.bandLoopsDefs
import Submission.Work.OROneRel.stbAssembly

/-!
# The loop group of an edge set is spanned by the loop classes of its edges

For a weight `c : α → ℤ`, an edge set `E ⊆ α × ℤ` of the level graph and a family
`Wt : ℤ → FreeGroup α` with `Wt 0 = 1`, the subgroup `loopsInE c E` of `FreeGroup α` (the loops
whose reduced walk uses only edges of `E`) is generated by the *loop classes*
`stbLoop Wt c e = Wt e.2 * x * (Wt (e.2 + c x))⁻¹` of the edges `e = (x, e.2) ∈ E`, provided those
loop classes are themselves loops of `E` (the hypothesis `hE`):

  `loopsInE c E = Subgroup.closure (stbLoop Wt c '' E)`.

The inclusion `⊇` is immediate from `hE`.  For the inclusion `⊆` we use the *telescoping identity*
of the decoration: reading a word `L` from level `i`, each letter `(x, b)` read at level `i'`
satisfies `of x^{±1} = Wt i'⁻¹ * stbLoop Wt c e * Wt (i' ± c x)`, where `e` is the underlying edge
`coverEdge` of the decorated letter; the gauge factors of consecutive letters cancel, so that

  `Wt i * mk L * (Wt (i + lsig c L))⁻¹ = ∏ (loop classes of the decorated edges of L)`.

For a loop `L` (`lsig c L = 0`, read at `i = 0` and with `Wt 0 = 1`) this is exactly `mk L`.
-/

namespace Work.pinAux

/-- **Telescoping of the gauge over the decorated letters.**  If every decorated edge of `L` read
from level `i` lies in `E`, then `Wt i * mk L * (Wt (i + lsig c L))⁻¹` is a product of loop classes
of edges of `E`, hence lies in `Subgroup.closure (stbLoop Wt c '' E)`. -/
theorem mul_mem_closure_stbLoop_decor {α : Type*} (Wt : ℤ → FreeGroup α) (c : α → ℤ)
    (E : Set (α × ℤ)) (i : ℤ) (L : List (α × Bool))
    (hL : ∀ p ∈ Work.OROneRel.decor c i L, Work.OROneRel.coverEdge p ∈ E) :
    Wt i * FreeGroup.mk L * (Wt (i + Work.OROneRel.lsig c L))⁻¹ ∈
      Subgroup.closure (Work.OROneRel.stbLoop Wt c '' E) := by
  induction L generalizing i with
  | nil =>
    rw [show Work.OROneRel.lsig c ([] : List (α × Bool)) = 0 from rfl]
    simp [Work.OROneRel.stb_mk_nil]
  | cons p L ih =>
    obtain ⟨a, b⟩ := p
    cases b
    · -- the letter `(a, false)`, i.e. `a⁻¹`, read from level `i`
      have hdecor : Work.OROneRel.decor c i ((a, false) :: L) =
          ((a, i - c a), false) :: Work.OROneRel.decor c (i - c a) L := rfl
      have htail : ∀ q ∈ Work.OROneRel.decor c (i - c a) L, Work.OROneRel.coverEdge q ∈ E :=
        fun q hq => hL q (by rw [hdecor]; exact List.mem_cons_of_mem _ hq)
      have hedge : (a, i - c a) ∈ E := by
        have := hL ((a, i - c a), false) (by rw [hdecor]; exact List.mem_cons_self ..)
        simpa [Work.OROneRel.coverEdge] using this
      have h1 : Wt i * (FreeGroup.of a)⁻¹ * (Wt (i - c a))⁻¹ ∈
          Subgroup.closure (Work.OROneRel.stbLoop Wt c '' E) := by
        have hmem : Work.OROneRel.stbLoop Wt c (a, i - c a) ∈
            Work.OROneRel.stbLoop Wt c '' E := ⟨(a, i - c a), hedge, rfl⟩
        have hsub := Subgroup.subset_closure hmem
        have heq : Work.OROneRel.stbLoop Wt c (a, i - c a) =
            Wt (i - c a) * FreeGroup.of a * (Wt i)⁻¹ := by
          rw [Work.OROneRel.stbLoop, show i - c a + c a = i from by ring]
        rw [heq] at hsub
        have hinv := Subgroup.inv_mem _ hsub
        convert hinv using 1
        group
      have h2 := ih (i - c a) htail
      have hgoal : Wt i * FreeGroup.mk ((a, false) :: L) *
            (Wt (i + Work.OROneRel.lsig c ((a, false) :: L)))⁻¹ =
          (Wt i * (FreeGroup.of a)⁻¹ * (Wt (i - c a))⁻¹) *
          (Wt (i - c a) * FreeGroup.mk L * (Wt ((i - c a) + Work.OROneRel.lsig c L))⁻¹) := by
        rw [show Work.OROneRel.lsig c ((a, false) :: L) = -c a + Work.OROneRel.lsig c L from rfl,
          Work.OROneRel.stb_mk_cons_false]
        rw [show i + (-c a + Work.OROneRel.lsig c L) =
            (i - c a) + Work.OROneRel.lsig c L from by ring]
        group
      rw [hgoal]
      exact mul_mem h1 h2
    · -- the letter `(a, true)`, i.e. `a`, read from level `i`
      have hdecor : Work.OROneRel.decor c i ((a, true) :: L) =
          ((a, i), true) :: Work.OROneRel.decor c (i + c a) L := rfl
      have htail : ∀ q ∈ Work.OROneRel.decor c (i + c a) L, Work.OROneRel.coverEdge q ∈ E :=
        fun q hq => hL q (by rw [hdecor]; exact List.mem_cons_of_mem _ hq)
      have hedge : (a, i) ∈ E := by
        have := hL ((a, i), true) (by rw [hdecor]; exact List.mem_cons_self ..)
        simpa [Work.OROneRel.coverEdge] using this
      have h1 : Wt i * FreeGroup.of a * (Wt (i + c a))⁻¹ ∈
          Subgroup.closure (Work.OROneRel.stbLoop Wt c '' E) := by
        have hmem : Work.OROneRel.stbLoop Wt c (a, i) ∈ Work.OROneRel.stbLoop Wt c '' E :=
          ⟨(a, i), hedge, rfl⟩
        simpa [Work.OROneRel.stbLoop] using Subgroup.subset_closure hmem
      have h2 := ih (i + c a) htail
      have hgoal : Wt i * FreeGroup.mk ((a, true) :: L) *
            (Wt (i + Work.OROneRel.lsig c ((a, true) :: L)))⁻¹ =
          (Wt i * FreeGroup.of a * (Wt (i + c a))⁻¹) *
          (Wt (i + c a) * FreeGroup.mk L * (Wt ((i + c a) + Work.OROneRel.lsig c L))⁻¹) := by
        rw [show Work.OROneRel.lsig c ((a, true) :: L) = c a + Work.OROneRel.lsig c L from rfl,
          Work.OROneRel.stb_mk_cons_true]
        rw [show i + (c a + Work.OROneRel.lsig c L) =
            (i + c a) + Work.OROneRel.lsig c L from by ring]
        group
      rw [hgoal]
      exact mul_mem h1 h2

theorem loopsInE_eq_closure_stbLoop {α : Type*} [DecidableEq α] (Wt : ℤ → FreeGroup α) (c : α → ℤ)
    (E : Set (α × ℤ)) (hW0 : Wt 0 = 1)
    (hE : ∀ e ∈ E, Work.OROneRel.stbLoop Wt c e ∈ Work.OROneRel.loopsInE c E) :
    Work.OROneRel.loopsInE c E = Subgroup.closure (Work.OROneRel.stbLoop Wt c '' E) := by
  refine le_antisymm ?_ ?_
  · -- every loop is a product of loop classes of its decorated edges
    intro x hx
    rw [Work.OROneRel.mem_loopsInE_iff] at hx
    obtain ⟨L, hLx, hlsig, hL⟩ := hx
    have hkey := mul_mem_closure_stbLoop_decor Wt c E 0 L hL
    have h0 : Wt 0 * FreeGroup.mk L * (Wt (0 + Work.OROneRel.lsig c L))⁻¹ = x := by
      rw [hlsig, show (0 : ℤ) + 0 = 0 from by ring, hW0, hLx]
      group
    rwa [h0] at hkey
  · -- each loop class of an edge of `E` is itself a loop of `E`
    rw [Subgroup.closure_le]
    rintro y ⟨e, he, rfl⟩
    exact hE e he

end Work.pinAux
