import Mathlib
import Submission.Work.ORHughesFree.StarRegular
import Submission.Work.ORHughesFree.StarRegular.mem_starRegularClosure_iff
import Submission.Work.ORHughesFree.StarRegular.starRegularClosure_le
import Submission.Work.ORHughesFree.StarRegular.relativeInverse_mem_starRegularClosure

universe u v

namespace Work.ORDivLoc.Closure

open Work.ORHughesFree

/-- A ring homomorphism commuting with `star` sends relative (Moore--Penrose) inverses to
relative inverses. -/
private theorem map_isRelativeInverse {R S : Type*} [Ring R] [StarRing R] [Ring S] [StarRing S]
    (f : R →+* S) (hf : ∀ x : R, f (star x) = star (f x)) {x y : R}
    (h : IsRelativeInverse x y) : IsRelativeInverse (f x) (f y) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · show f x * f y * f x = f x
    rw [← map_mul, ← map_mul, h.left]
  · show f y * f x * f y = f y
    rw [← map_mul, ← map_mul, h.right]
  · show star (f x * f y) = f x * f y
    rw [← map_mul, ← hf, h.star_left, map_mul]
  · show star (f y * f x) = f y * f x
    rw [← map_mul, ← hf, h.star_right, map_mul]

/-- The image under a `star`-commuting ring homomorphism of the `∗`-subring generated by a set
is contained in the `∗`-subring generated by the image of the set. -/
private theorem image_starSubringClosure_subset {R S : Type*} [Ring R] [StarRing R]
    [Ring S] [StarRing S] (f : R →+* S) (hf : ∀ x : R, f (star x) = star (f x)) (X : Set R) :
    f '' (starSubringClosure X : Set R) ⊆ (starSubringClosure (f '' X) : Set S) := by
  intro y hy
  obtain ⟨x, hx, rfl⟩ := hy
  have hmem : f x ∈ (Subring.closure (X ∪ star '' X)).map f :=
    Subring.mem_map.mpr ⟨x, hx, rfl⟩
  rw [f.map_closure] at hmem
  have hset : f '' (X ∪ star '' X) = f '' X ∪ star '' (f '' X) := by
    rw [Set.image_union, Set.image_image, Set.image_image]
    congr 1
    exact Set.image_congr fun a _ => hf a
  rwa [hset] at hmem

/-- The image under a `star`-commuting ring homomorphism of the relative inverses of a set is
contained in the relative inverses of the image of the set. -/
private theorem image_relativeInverses_subset {R S : Type*} [Ring R] [StarRing R]
    [Ring S] [StarRing S] (ρ : R →+* S) (hρ : ∀ x : R, ρ (star x) = star (ρ x)) (X : Set R) :
    ρ '' relativeInverses X ⊆ relativeInverses (ρ '' X) := by
  rintro s ⟨y, ⟨x, hx, hxy⟩, rfl⟩
  exact ⟨ρ x, ⟨x, hx, rfl⟩, map_isRelativeInverse ρ hρ hxy⟩

/-- The `∗`-regular closure of a `∗`-subring is transported by a `star`-commuting ring
homomorphism: the image of the closure of the `∗`-subring generated by `A` is contained in the
`∗`-regular closure of the `∗`-subring generated by the image of `A`. -/
theorem starRegularClosure_image_le {R : Type u} [Ring R] [StarRing R]
    {S : Type v} [Ring S] [StarRing S]
    (ρ : R →+* S) (hρ : ∀ x : R, ρ (star x) = star (ρ x))
    (A : Set R) (B : Work.ORHughesFree.StarSubring S)
    (hAB : ρ '' A ⊆ (B : Set S)) :
    ρ '' ((Work.ORHughesFree.starRegularClosure (Work.ORHughesFree.starSubringClosure A) : Set R))
      ⊆ (Work.ORHughesFree.starRegularClosure B : Set S) := by
  have hbase : ρ '' (starSubringClosure A : Set R) ⊆ (starRegularClosure B : Set S) :=
    (image_starSubringClosure_subset ρ hρ A).trans
      (starSubringClosure_le (hAB.trans (subset_starRegularClosure B)))
  have hchain : ∀ n : ℕ,
      ρ '' (starRegularChain (starSubringClosure A) n : Set R)
        ⊆ (starRegularClosure B : Set S) := by
    intro n
    induction n with
    | zero =>
      show ρ '' (starSubringClosure A : Set R) ⊆ (starRegularClosure B : Set S)
      exact hbase
    | succ n ih =>
      have hstep : ρ '' ((starRegularChain (starSubringClosure A) n : Set R) ∪
            relativeInverses (starRegularChain (starSubringClosure A) n : Set R))
            ⊆ (starRegularClosure B : Set S) := by
        rintro s ⟨y, hy, rfl⟩
        rcases hy with hy | hy
        · exact ih ⟨y, hy, rfl⟩
        · obtain ⟨x, hx, hxy⟩ := hy
          exact Work.ORHughesFree.StarRegular.relativeInverse_mem_starRegularClosure
            (R := B) (ih ⟨x, hx, rfl⟩) (map_isRelativeInverse ρ hρ hxy)
      show ρ '' (starSubringClosure ((starRegularChain (starSubringClosure A) n : Set R) ∪
            relativeInverses (starRegularChain (starSubringClosure A) n : Set R)) : Set R)
            ⊆ (starRegularClosure B : Set S)
      exact (image_starSubringClosure_subset ρ hρ _).trans (starSubringClosure_le hstep)
  rintro s ⟨x, hx, rfl⟩
  obtain ⟨n, hn⟩ := (Work.ORHughesFree.StarRegular.mem_starRegularClosure_iff
    (starSubringClosure A) x).mp hx
  exact hchain n ⟨x, hn, rfl⟩

end Work.ORDivLoc.Closure
