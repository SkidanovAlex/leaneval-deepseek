# Coherence over an arbitrary characteristic-zero field, from the small-field hypothesis

This is the `P2` step of the coefficient-field reduction.  The hypothesis `h` supplies
`Ring.Coherent (MonoidAlgebra K₀ X)` for every *small* (i.e. `Type 0`) field `K₀` of
characteristic zero that admits a ring homomorphism `K₀ →+* ℂ`; the conclusion is coherence of
`K[X]` for an arbitrary characteristic-zero field `K`, with the group pushed into `K`'s universe
by `ULift`.

The mathematics is the reduction `Ring.Coherent.of_subfield`: it suffices to know coherence
after base change to every finitely generated subfield `F ≤ K`.  Such an `F` is generated by a
finite set, and `fg_charZero_field_embeds_complex` embeds it into `ℂ`; in particular `F` is
`Small.{0}` (an injective map into `ℂ` witnesses this), so the universe-0 hypothesis applies to
the `Shrink` of `F`, and the conclusion is transported back along the ring equivalence
`Shrink F ≃+* F`.
-/
import Mathlib
import Submission.Work.ORReductions.API

set_option linter.style.haveILetI false

universe v

namespace Work.ORDivLoc.P2

/-- A field of characteristic zero has characteristic zero after `Shrink`.  (`CharZero` is not a
typeclass with an instance for `Shrink`, so we build the transport by hand.) -/
private theorem charZero_shrink {F : Type*} [Field F] [CharZero F] [Small.{0} F] :
    CharZero (Shrink.{0} F) := by
  refine charZero_of_inj_zero fun n hn => ?_
  have h1 : (n : F) = 0 := by
    rw [← map_natCast (Shrink.ringEquiv F) n, hn, map_zero]
  exact Nat.cast_eq_zero.mp h1

theorem ringCoherent_ulift_of_typeZero (K : Type v) [Field K] [CharZero K] {X : Type} [Group X]
    (h : ∀ (K₀ : Type) [Field K₀] [CharZero K₀] (φ : K₀ →+* ℂ),
      Ring.Coherent (MonoidAlgebra K₀ X)) :
    Ring.Coherent (MonoidAlgebra K (ULift.{v} X)) := by
  have hK : Ring.Coherent (MonoidAlgebra K X) := by
    refine Ring.Coherent.of_subfield X K ?_
    intro S
    obtain ⟨φ⟩ := fg_charZero_field_embeds_complex K S
    -- `φ : ↥(Subfield.closure ↑S) →+* ℂ` is injective, so its source is small:
    haveI : Small.{0} (↥(Subfield.closure (S : Set K))) := small_of_injective φ.injective
    -- hence the universe-0 hypothesis applies to its `Shrink` ...
    haveI : CharZero (Shrink.{0} (↥(Subfield.closure (S : Set K)))) := charZero_shrink
    have hc := h (Shrink.{0} (↥(Subfield.closure (S : Set K))))
      (φ.comp (Shrink.ringEquiv ↥(Subfield.closure (S : Set K))).toRingHom)
    -- ... and the conclusion is transported back along `Shrink F ≃+* F`.
    exact Ring.Coherent.of_ringEquiv
      (MonoidAlgebra.mapRingEquiv X (Shrink.ringEquiv ↥(Subfield.closure (S : Set K)))) hc
  exact Ring.Coherent.of_ringEquiv
    (MonoidAlgebra.mapDomainRingEquiv K (MulEquiv.ulift (α := X)).symm) hK

end Work.ORDivLoc.P2
