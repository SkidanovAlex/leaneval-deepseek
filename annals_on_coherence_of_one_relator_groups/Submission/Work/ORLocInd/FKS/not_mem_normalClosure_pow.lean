import Mathlib
import Submission.Work.ORLocInd.Basic

set_option linter.style.haveILetI false

namespace Work.ORLocInd.FKS

/-- A subgroup contained in the centre of a group is normal. -/
lemma normalClosure_pow_subgroup_normal_of_le_center {G : Type*} [Group G] {H : Subgroup G}
    (h : H ≤ Subgroup.center G) : H.Normal :=
  ⟨fun n hn g => by
    have hc : g * n = n * g := (Subgroup.mem_center_iff.mp (h hn)) g
    rw [hc, mul_assoc, mul_inv_cancel, mul_one]
    exact hn⟩

/-- The hypothesis descends to a quotient: if `y ∈ normalClosure {y ^ p}` then the same holds
for the image of `y` in `Q ⧸ N`. -/
lemma normalClosure_pow_mem_map {Q : Type*} [Group Q] {p : ℕ} (N : Subgroup Q) [N.Normal]
    (y : Q) (hy : y ∈ Subgroup.normalClosure ({y ^ p} : Set Q)) :
    QuotientGroup.mk' N y ∈
      Subgroup.normalClosure ({QuotientGroup.mk' N y ^ p} : Set (Q ⧸ N)) := by
  have h := Subgroup.mem_map_of_mem (QuotientGroup.mk' N) hy
  rw [Subgroup.map_normalClosure _ _ (QuotientGroup.mk'_surjective N)] at h
  simpa using h

/-- Strong induction on the cardinality: in a finite `p`-group `Q` of order `n`, an element `y`
lying in the normal closure of its own `p`-th power is trivial. -/
private theorem not_mem_normalClosure_pow_aux (p : ℕ) (hp : p.Prime) (n : ℕ) :
    ∀ (Q : Type*) [Group Q] [Finite Q], Nat.card Q = n → IsPGroup p Q → ∀ y : Q,
      y ∈ Subgroup.normalClosure ({y ^ p} : Set Q) → y = 1 := by
  haveI : Fact p.Prime := ⟨hp⟩
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro Q _ _ hcard hQ y hy
    by_contra hne
    haveI : Nontrivial Q := ⟨⟨y, 1, hne⟩⟩
    -- a central element of order `p` exists
    have hdvd : p ∣ Nat.card (Subgroup.center Q) := by
      rcases (hQ.to_subgroup (Subgroup.center Q)).card_eq_or_dvd with h1 | h1
      · exfalso
        have hlt : 1 < Nat.card (Subgroup.center Q) :=
          Finite.one_lt_card_iff_nontrivial.mpr hQ.center_nontrivial
        omega
      · exact h1
    obtain ⟨zZ, hzZ⟩ := exists_prime_orderOf_dvd_card' p hdvd
    let z : Q := zZ
    have hzcenter : z ∈ Subgroup.center Q := zZ.2
    have hzord : orderOf z = p := (Subgroup.orderOf_coe zZ).trans hzZ
    -- the normal subgroup of order `p` generated by `z`
    set N₀ : Subgroup Q := Subgroup.zpowers z with hN₀def
    have hN₀le : N₀ ≤ Subgroup.center Q := by
      rw [hN₀def]; exact Subgroup.zpowers_le.mpr hzcenter
    have hN₀normal : N₀.Normal := normalClosure_pow_subgroup_normal_of_le_center hN₀le
    haveI : N₀.Normal := hN₀normal
    have hNcard : Nat.card N₀ = p := by
      rw [hN₀def, Nat.card_zpowers, hzord]
    -- the hypothesis descends to `Q ⧸ N₀`
    have hhyp := normalClosure_pow_mem_map N₀ y hy
    have hcardQ : Nat.card Q = p * Nat.card (Q ⧸ N₀) := by
      rw [← Subgroup.card_mul_index N₀, Subgroup.index_eq_card N₀, hNcard]
    have hlt : Nat.card (Q ⧸ N₀) < n := by
      rw [← hcard, hcardQ]
      have hpos : 0 < Nat.card (Q ⧸ N₀) := Nat.card_pos
      calc Nat.card (Q ⧸ N₀) = Nat.card (Q ⧸ N₀) * 1 := (Nat.mul_one _).symm
        _ < Nat.card (Q ⧸ N₀) * p := Nat.mul_lt_mul_of_pos_left hp.one_lt hpos
        _ = p * Nat.card (Q ⧸ N₀) := Nat.mul_comm _ _
    -- minimality forces `y` into `N₀`
    have hres := ih (Nat.card (Q ⧸ N₀)) hlt (Q ⧸ N₀) rfl (hQ.to_quotient N₀)
      (QuotientGroup.mk' N₀ y) hhyp
    have hyN : y ∈ N₀ := (QuotientGroup.eq_one_iff y).mp hres
    -- hence `y ^ p = 1`, and then `y ∈ normalClosure {1} = ⊥`
    have hypow : y ^ p = 1 := by
      have : orderOf y ∣ p := by
        rw [← hNcard]; exact Subgroup.orderOf_dvd_natCard N₀ hyN
      rwa [orderOf_dvd_iff_pow_eq_one] at this
    have hbot : Subgroup.normalClosure ({y ^ p} : Set Q) = ⊥ := by
      rw [hypow]
      exact Subgroup.normalClosure_eq_bot_iff.mpr (by simp)
    rw [hbot] at hy
    exact hne (Subgroup.mem_bot.mp hy)

/-- In a finite `p`-group, an element `y` that lies in the normal closure of its own `p`-th power
`y ^ p` must be trivial.  (In particular `y ∉ Subgroup.normalClosure {y ^ p}` for `y ≠ 1`.)

Proof sketch: suppose `y ∈ normalClosure {y ^ p}` and `y ≠ 1`; choose a counterexample in a
finite `p`-group `Q` of minimal cardinality.  Modulo a minimal nontrivial normal subgroup `N` of
`Q` (which has order `p` and is central), the same hypothesis holds (`Subgroup.map_normalClosure`
with the surjective quotient map), so `y ∈ N` by minimality, hence `y ^ p = 1`, hence
`normalClosure {y ^ p} = ⊥` and `y = 1`, a contradiction.  (Equivalently, one may induct on the
lower central series: `y ∈ γ_c / γ_{c+1}` is central, and `ȳ ∈ ⟨ȳ ^ p⟩` forces `ȳ = 1` since
`orderOf ȳ ∣ p ^ k` and `orderOf ȳ ∣ p * k - 1` are coprime.) -/
theorem not_mem_normalClosure_pow {Q : Type*} [Group Q] [Finite Q] {p : ℕ} (hp : p.Prime)
    (hQ : IsPGroup p Q) (y : Q) : y ∈ Subgroup.normalClosure ({y ^ p} : Set Q) → y = 1 :=
  not_mem_normalClosure_pow_aux p hp (Nat.card Q) Q rfl hQ y

end Work.ORLocInd.FKS
