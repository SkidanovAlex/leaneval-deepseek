import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.rootAmaDefs

namespace Work.ORLocInd.CohenLyndon

/-- `↥(rootZ t)` is cyclic, generated by the extra letter `z = rootLetter t`: every element of the
subgroup is a power of that generator. -/
theorem rootZ_exists_zpow {α : Type*} [DecidableEq α] (t : α) (y : ↥(rootZ t)) :
    ∃ m : ℤ, (⟨rootLetter t, rootLetter_mem_rootZ t⟩ : ↥(rootZ t)) ^ m = y := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp y.2
  exact ⟨m, by
    refine Subtype.ext ?_
    rw [Subgroup.coe_zpow]
    simpa using hm⟩

theorem rootAmaSubZ {α : Type*} [DecidableEq α] (t : α) (p : ℤ) :
    (rootIsoAmaFwd t p).comp (Subgroup.subtype (rootZ t)) = Ama.ofZ t p := by
  ext y
  obtain ⟨m, hy⟩ := rootZ_exists_zpow t y
  have hcoe : (Subgroup.subtype (rootZ t))
      ((⟨rootLetter t, rootLetter_mem_rootZ t⟩ : ↥(rootZ t)) ^ m) = rootLetter t ^ m := by
    rw [map_zpow]
    congr 1
  rw [MonoidHom.comp_apply, ← hy, hcoe, map_zpow, rootIsoAmaFwd_ofInr, map_zpow]

end Work.ORLocInd.CohenLyndon
