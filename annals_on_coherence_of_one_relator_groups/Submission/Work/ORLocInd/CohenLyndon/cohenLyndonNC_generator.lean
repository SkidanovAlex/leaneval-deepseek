import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.NCForm
import Submission.Work.ORLocInd.CohenLyndon.centralizer_eq_zpowers
import Submission.Work.ORLocInd.FreeGroup.of_not_isProperPower
import Submission.Work.ORLocInd.FKSKernel.cohenLyndonBasisFreeGenerator

set_option autoImplicit false
set_option linter.dupNamespace false

universe u

namespace Work.ORLocInd.CohenLyndon

open Work.CohenLyndon

/-- **The `⟪r⟫`-coset form implies the `N C_G(r)`-coset form.**  If the centralizer of `r` is
contained in its normal closure, the two index sets of the classical and the `N C_G(r)` formulation
of the Cohen--Lyndon theorem coincide, so a transversal of the `⟪r⟫`-cosets is a transversal of the
`⟪r⟫ · C_G(r)`-cosets and the two basis conditions are the same.  (This is the converse of
`Work.CohenLyndon.CohenLyndon.ofNC`.) -/
theorem cohenLyndonNC_of_cohenLyndon {G : Type u} [Group G] {r : G}
    (hC : Subgroup.centralizer ({r} : Set G) ≤ Subgroup.normalClosure ({r} : Set G))
    (h : Work.CohenLyndon.CohenLyndon r) : Work.CohenLyndon.CohenLyndonNC r := by
  classical
  obtain ⟨T, hT, e, he⟩ := h
  have hsup : Subgroup.normalClosure ({r} : Set G) ⊔ Subgroup.centralizer ({r} : Set G)
      = Subgroup.normalClosure ({r} : Set G) := sup_eq_left.mpr hC
  refine ⟨T, ?_, e, he⟩
  intro g
  obtain ⟨t, ht, huniq⟩ := hT g
  refine ⟨t, ⟨ht.1, ?_⟩, ?_⟩
  · rw [hsup]
    have hmem : t⁻¹ * g ∈ Subgroup.normalClosure ({r} : Set G) := QuotientGroup.eq.mp ht.2
    have h2 : g⁻¹ * t ∈ Subgroup.normalClosure ({r} : Set G) := by
      have := inv_mem hmem
      rwa [mul_inv_rev, inv_inv] at this
    exact h2
  · intro y hy
    refine huniq y ⟨hy.1, ?_⟩
    have hmem : g⁻¹ * y ∈ Subgroup.normalClosure ({r} : Set G) := by
      rw [hsup] at hy; exact hy.2
    have h2 : y⁻¹ * g ∈ Subgroup.normalClosure ({r} : Set G) := by
      have := inv_mem hmem
      rwa [mul_inv_rev, inv_inv] at this
    exact QuotientGroup.eq.mpr h2

/-- The centralizer of a free generator `of a` in `FreeGroup X` is contained in its normal
closure: it is the cyclic subgroup it generates. -/
theorem centralizer_le_normalClosure_of {X : Type u} (a : X) :
    Subgroup.centralizer ({FreeGroup.of a} : Set (FreeGroup X)) ≤
      Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)) := by
  rw [centralizer_eq_zpowers (u := FreeGroup.of a) (FreeGroup.of_ne_one a)
    (Work.ORLocInd.FreeGroup.of_not_isProperPower a)]
  exact Subgroup.zpowers_le.mpr (Subgroup.subset_normalClosure (Set.mem_singleton _))

/-- **The base case of the Cohen--Lyndon theorem: a free generator.**
For any type `X` and `a : X`, the element `FreeGroup.of a` of the free group on `X` is
Cohen--Lyndon aspherical: the normal closure of `of a` is freely generated by the conjugates
`w (of a) w⁻¹` as `w` runs through a transversal of the cosets of the kernel of the projection
`FreeGroup X →* FreeGroup {x // x ≠ a}`. -/
theorem cohenLyndonNC_generator {X : Type u} (a : X) :
    Work.CohenLyndon.CohenLyndonNC (FreeGroup.of a : FreeGroup X) := by
  refine cohenLyndonNC_of_cohenLyndon (centralizer_le_normalClosure_of a) ?_
  exact Work.CohenLyndon.cohenLyndon_of_iso
    (Work.ORLocInd.FKSKernel.cohenLyndonBasisFreeGenerator a)

end Work.ORLocInd.CohenLyndon
