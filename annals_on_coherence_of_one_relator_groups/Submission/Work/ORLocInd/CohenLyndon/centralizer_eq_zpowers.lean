import Mathlib
import Submission.Work.ORLocInd.Basic
import Submission.Work.ORLocInd.CohenLyndon.NCForm

/-!
# The centralizer of a non-proper-power element of a free group

The main result here is that the centralizer in a free group `F` of an element `u ≠ 1` which is not
a proper power is exactly the cyclic subgroup `⟨u⟩` it generates.

The mathematical argument is:

* `u` and `v` commute, so the subgroup `H = ⟨u, v⟩ ≤ F` is abelian;
* a subgroup of a free group is free (Nielsen--Schreier), and an abelian free group is free of rank
  `≤ 1`, hence cyclic: there is `g ∈ H` with `⟨g⟩ = H`;
* writing `u = g ^ m` with `m ≠ 0` and using that `u` is not a proper power forces `m = ±1`, so
  `⟨g⟩ = ⟨u⟩` and `v ∈ ⟨u⟩`.
-/

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.style.haveILetI false

universe u

namespace Work.ORLocInd.CohenLyndon

/-! ### Free groups that are abelian -/

/-- In a free group two generators `of a` and `of b` commute only if `a = b`. -/
theorem of_mul_of_eq_of_mul_of {α : Type u} {a b : α}
    (h : FreeGroup.of a * FreeGroup.of b = FreeGroup.of b * FreeGroup.of a) : a = b := by
  classical
  have h2 : ([(a, true), (b, true)] : List (α × Bool)) = [(b, true), (a, true)] := by
    have := congrArg FreeGroup.toWord h
    simpa [FreeGroup.toWord_mul, FreeGroup.toWord_of, FreeGroup.reduce] using this
  have h3 : (a, true) = (b, true) := (List.cons.inj h2).1
  exact (Prod.mk.inj h3).1

/-- A free group whose underlying group is abelian is generated by at most one element, i.e. its
indexing type is a subsingleton. -/
theorem subsingleton_of_freeGroup_comm {α : Type u}
    (h : ∀ x y : FreeGroup α, x * y = y * x) : Subsingleton α :=
  ⟨fun a b => of_mul_of_eq_of_mul_of (a := a) (b := b) (h (FreeGroup.of a) (FreeGroup.of b))⟩

/-- A free group on a subsingleton indexing type is cyclic. -/
theorem exists_zpowers_eq_top_of_subsingleton_freeGroup (ι : Type u) [Subsingleton ι] :
    ∃ g : FreeGroup ι, Subgroup.zpowers g = ⊤ := by
  by_cases hne : Nonempty ι
  · obtain ⟨a⟩ := hne
    refine ⟨FreeGroup.of a, ?_⟩
    rw [Subgroup.zpowers_eq_closure]
    apply top_le_iff.mp
    rw [← FreeGroup.closure_range_of ι]
    apply Subgroup.closure_mono
    intro x hx
    obtain ⟨b, rfl⟩ := hx
    rw [Subsingleton.elim b a]
    exact Set.mem_singleton _
  · classical
    haveI : IsEmpty ι := not_nonempty_iff.mp hne
    haveI hsub : Subsingleton (FreeGroup ι) := by
      refine ⟨fun x y => ?_⟩
      have hx : x = 1 := by
        rw [← FreeGroup.toWord_inj, FreeGroup.toWord_one]
        exact List.eq_nil_iff_forall_not_mem.mpr (fun a _ => IsEmpty.false a.1)
      have hy : y = 1 := by
        rw [← FreeGroup.toWord_inj, FreeGroup.toWord_one]
        exact List.eq_nil_iff_forall_not_mem.mpr (fun a _ => IsEmpty.false a.1)
      rw [hx, hy]
    refine ⟨1, ?_⟩
    rw [Subgroup.eq_top_iff']
    intro x
    exact Subgroup.mem_zpowers_iff.mpr ⟨0, by rw [zpow_zero]; exact Subsingleton.elim 1 x⟩

/-- **An abelian free group is cyclic.**  If an arbitrary group `G` is free (in the sense of
`IsFreeGroup`) and abelian, then it is generated by a single element. -/
theorem exists_zpowers_eq_top_of_isFreeGroup_abelian {G : Type u} [Group G] [IsFreeGroup G]
    (hab : ∀ x y : G, x * y = y * x) : ∃ g : G, Subgroup.zpowers g = ⊤ := by
  classical
  let e : G ≃* FreeGroup (IsFreeGroup.Generators G) := IsFreeGroup.toFreeGroup G
  haveI hsub : Subsingleton (IsFreeGroup.Generators G) :=
    subsingleton_of_freeGroup_comm (fun x y => by
      obtain ⟨a, rfl⟩ := e.surjective x
      obtain ⟨b, rfl⟩ := e.surjective y
      rw [← map_mul, ← map_mul, hab a b])
  obtain ⟨g', hg'⟩ := exists_zpowers_eq_top_of_subsingleton_freeGroup (IsFreeGroup.Generators G)
  refine ⟨e.symm g', ?_⟩
  rw [Subgroup.eq_top_iff']
  intro x
  have hx : e x ∈ Subgroup.zpowers g' := hg' ▸ Subgroup.mem_top (e x)
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hx
  exact Subgroup.mem_zpowers_iff.mpr ⟨k, by
    rw [← map_zpow, hk]
    simp⟩

/-! ### The centralizer of a non-proper-power element -/

/-- The centralizer in a free group of a non-proper-power element `u ≠ 1` is the cyclic subgroup
`⟨u⟩` it generates. -/
theorem centralizer_eq_zpowers {X : Type u} {u : FreeGroup X} (hu : u ≠ 1)
    (hpp : ¬ Work.ORLocInd.IsProperPower u) :
    Subgroup.centralizer ({u} : Set (FreeGroup X)) = Subgroup.zpowers u := by
  classical
  apply le_antisymm
  · intro v hv
    rw [Subgroup.mem_centralizer_iff] at hv
    have huv : u * v = v * u := hv u (Set.mem_singleton u)
    set H : Subgroup (FreeGroup X) := Subgroup.closure ({u, v} : Set (FreeGroup X)) with hH
    have huH : u ∈ H := Subgroup.subset_closure (by simp)
    have hvH : v ∈ H := Subgroup.subset_closure (by simp)
    -- `H` is abelian
    have huc : ∀ y ∈ (H : Set (FreeGroup X)), Commute u y := by
      intro y hy
      induction hy using Subgroup.closure_induction with
      | mem z hz =>
        rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with hz | hz
        · rw [hz]
        · rw [hz]; exact huv
      | one => exact Commute.one_right u
      | mul a b _ _ iha ihb => exact iha.mul_right ihb
      | inv a _ iha => exact iha.inv_right
    have hvc : ∀ y ∈ (H : Set (FreeGroup X)), Commute v y := by
      intro y hy
      induction hy using Subgroup.closure_induction with
      | mem z hz =>
        rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with hz | hz
        · rw [hz]; exact huv.symm
        · rw [hz]
      | one => exact Commute.one_right v
      | mul a b _ _ iha ihb => exact iha.mul_right ihb
      | inv a _ iha => exact iha.inv_right
    have key : ∀ a ∈ (H : Set (FreeGroup X)), ∀ b ∈ (H : Set (FreeGroup X)), Commute a b := by
      intro a ha
      induction ha using Subgroup.closure_induction with
      | mem z hz =>
        rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with hz | hz
        · rw [hz]; exact fun b hb => huc b hb
        · rw [hz]; exact fun b hb => hvc b hb
      | one => intro b _; exact Commute.one_left b
      | mul a b _ _ iha ihb => exact fun c hc => (iha c hc).mul_left (ihb c hc)
      | inv a _ iha => exact fun c hc => (iha c hc).inv_left
    have hcommH : ∀ x y : H, x * y = y * x := fun x y =>
      Subtype.ext (by
        show (x : FreeGroup X) * (y : FreeGroup X) = (y : FreeGroup X) * (x : FreeGroup X)
        exact key x x.2 y y.2)
    -- `H` is cyclic
    obtain ⟨g, hg⟩ := exists_zpowers_eq_top_of_isFreeGroup_abelian (G := H) hcommH
    -- write `u` as a power of the generator `g`
    have hmem : (⟨u, huH⟩ : H) ∈ Subgroup.zpowers g := by
      rw [hg]; exact Subgroup.mem_top _
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hmem
    have hg_ne : (g : FreeGroup X) ≠ 1 := by
      intro h
      have hg1 : g = 1 := Subtype.ext (by simpa using h)
      have h1 : (⟨u, huH⟩ : H) = 1 := by rw [← hm, hg1, one_zpow]
      exact hu (by simpa using congrArg Subtype.val h1)
    have hm_ne : m ≠ 0 := by
      intro h0
      have h1 : (⟨u, huH⟩ : H) = 1 := by rw [← hm, h0, zpow_zero]
      exact hu (by simpa using congrArg Subtype.val h1)
    -- `g` is a power of `u`
    have hg_mem : g ∈ Subgroup.zpowers (⟨u, huH⟩ : H) := by
      rcases Int.eq_nat_or_neg m with ⟨n, hn | hn⟩
      · -- `m = n`
        have hm' : g ^ n = (⟨u, huH⟩ : H) := by
          rw [hn, zpow_natCast] at hm; exact hm
        have hn0 : n ≠ 0 := fun h => hm_ne (hn.trans (by rw [h]; simp))
        rcases Nat.lt_or_ge n 2 with hlt | hge
        · have hn1 : n = 1 := by omega
          have hgEq : g = (⟨u, huH⟩ : H) := by simpa [hn1] using hm'
          exact Subgroup.mem_zpowers_iff.mpr ⟨1, by rw [zpow_one]; exact hgEq.symm⟩
        · have hpow : (g : FreeGroup X) ^ n = u := by
            simpa [Subgroup.coe_pow] using congrArg Subtype.val hm'
          exact absurd ⟨(g : FreeGroup X), hg_ne, n, hge, hpow.symm⟩ hpp
      · -- `m = -n`
        have hm2 : (g ^ (n : ℤ))⁻¹ = (⟨u, huH⟩ : H) := by
          rw [hn, zpow_neg] at hm; exact hm
        have hm' : g ^ n = (⟨u, huH⟩ : H)⁻¹ := by
          simpa [zpow_natCast] using congrArg Inv.inv hm2
        have hn0 : n ≠ 0 := fun h => hm_ne (hn.trans (by rw [h]; simp))
        rcases Nat.lt_or_ge n 2 with hlt | hge
        · have hn1 : n = 1 := by omega
          have hgEq : g = (⟨u, huH⟩ : H)⁻¹ := by simpa [hn1] using hm'
          exact Subgroup.mem_zpowers_iff.mpr ⟨-1, by rw [zpow_neg_one]; exact hgEq.symm⟩
        · have hpow : (g : FreeGroup X) ^ n = u⁻¹ := by
            simpa [Subgroup.coe_pow, Subgroup.coe_inv] using congrArg Subtype.val hm'
          have hroot : u = ((g : FreeGroup X))⁻¹ ^ n := by rw [inv_pow, hpow]; simp
          have hroot_ne : ((g : FreeGroup X))⁻¹ ≠ 1 := fun h => hg_ne (inv_eq_one.mp h)
          exact absurd ⟨((g : FreeGroup X))⁻¹, hroot_ne, n, hge, hroot⟩ hpp
    -- hence `H = ⟨u⟩`, and `v ∈ H`
    have htop : (⊤ : Subgroup H) ≤ Subgroup.zpowers (⟨u, huH⟩ : H) := by
      rw [← hg]; exact Subgroup.zpowers_le.mpr hg_mem
    have hv_mem : (⟨v, hvH⟩ : H) ∈ Subgroup.zpowers (⟨u, huH⟩ : H) :=
      htop (Subgroup.mem_top _)
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hv_mem
    exact Subgroup.mem_zpowers_iff.mpr ⟨k, by
      have := congrArg Subtype.val hk
      simpa [Subgroup.coe_zpow] using this⟩
  · refine Subgroup.zpowers_le.mpr ?_
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    subst hh
    rfl

end Work.ORLocInd.CohenLyndon
