/-
# The amalgam `K ∗_{⟨z ^ p⟩} ⟨z⟩` is the free group `F(RootIdx α t)`

This file contains the maps underlying the isomorphism
`rootAmaEquiv : F(RootIdx α t) ≃* Ama t p` of
`Submission/Work/ORLocInd/CohenLyndon/rootAmaEquiv.lean`.

Let `P = F(RootIdx α t)` be the free group obtained from `F(α)` by adjoining the extra letter
`z = rootLetter t`, so that `P` is (freely) generated by `z` together with the letters `a ≠ t`.
In `rootAmaSetup` we defined

* `rootK t p = (rootHom t p).range = ⟨z ^ p, a (a ≠ t)⟩ ≤ P` (the image of `F(α)`, `t ↦ z ^ p`),
* `rootZ t = ⟨z⟩ ≤ P`,
* `rootC t p = ⟨z ^ p⟩ ≤ P` (with `rootC ≤ rootK` and `rootC ≤ rootZ`),

and the amalgam `Ama t p = K ∗_{rootC} Z` as the pushout `Monoid.PushoutI (amaPhi t p)` of the two
inclusions `rootC ↪ rootK` and `rootC ↪ rootZ`.

The pushout is generated by the images of the two vertex groups, and since `K ∪ Z` generates `P`,
there is a canonical map `rootIsoAmaBwd : Ama t p →* P` (the pushout universal property, both
edge maps being the inclusion `rootC ↪ P`).  In the other direction the map
`rootIsoAmaFwd : P →* Ama t p` sends `z` to the `⟨z⟩`-vertex and each letter `a ≠ t` to the
`K`-vertex.  The substance of `rootAmaEquiv` is that these two maps are mutually inverse; the
nontrivial part is that `rootIsoAmaFwd` agrees with the embedding `rootK ↪ Ama t p` of the
`K`-vertex (where the element `z ^ p` is not a free generator of `P` but the image of `t ∈ F(α)`).
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.rootAmaSetup

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORLocInd.CohenLyndon

variable {α : Type u} [DecidableEq α]

/-! ## The forward map `F(RootIdx α t) →* Ama t p` -/

/-- The forward map of the isomorphism `rootAmaEquiv`: the extra letter `z = rootLetter t` is sent
to the `⟨z⟩`-vertex of the amalgam and each letter `a ≠ t` to the `K`-vertex. -/
noncomputable def rootIsoAmaFwd (t : α) (p : ℤ) : FreeGroup (RootIdx α t) →* Ama t p :=
  FreeGroup.lift (Sum.elim
    (fun a : {a : α // a ≠ t} =>
      Ama.ofK t p ⟨FreeGroup.of (Sum.inl a),
        ⟨FreeGroup.of (a : α), by rw [rootHom_of_ne a.2 p]⟩⟩)
    (fun _ : Unit => Ama.ofZ t p ⟨rootLetter t, rootLetter_mem_rootZ t⟩))

@[simp] theorem rootIsoAmaFwd_ofInl (t : α) (p : ℤ) (a : {a : α // a ≠ t}) :
    rootIsoAmaFwd t p (FreeGroup.of (Sum.inl a)) =
      Ama.ofK t p ⟨FreeGroup.of (Sum.inl a),
        ⟨FreeGroup.of (a : α), by rw [rootHom_of_ne a.2 p]⟩⟩ := by
  rw [rootIsoAmaFwd, FreeGroup.lift_apply_of]
  rfl

@[simp] theorem rootIsoAmaFwd_ofInr (t : α) (p : ℤ) :
    rootIsoAmaFwd t p (rootLetter t) =
      Ama.ofZ t p ⟨rootLetter t, rootLetter_mem_rootZ t⟩ := by
  show FreeGroup.lift _ (FreeGroup.of (Sum.inr ())) = _
  rw [FreeGroup.lift_apply_of]
  rfl

/-- The image of the element `z ^ p` of `P` (which is the image of the letter `t` under `rootHom`)
under the forward map: it is the image of the edge subgroup, hence lies in both vertices. -/
theorem rootIsoAmaFwd_pow (t : α) (p : ℤ) :
    rootIsoAmaFwd t p (rootLetter t ^ p) =
      Ama.ofK t p ⟨rootLetter t ^ p, rootLetter_pow_mem_rootK t p⟩ := by
  have hw : (⟨rootLetter t, rootLetter_mem_rootZ t⟩ : ↥(rootZ t)) ^ p =
      ⟨rootLetter t ^ p, rootC_le_rootZ t p (rootLetter_pow_mem_rootC t p)⟩ := by
    refine Subtype.ext ?_
    rw [Subgroup.coe_zpow]
  have h1 : (⟨rootLetter t ^ p, rootC_le_rootZ t p (rootLetter_pow_mem_rootC t p)⟩ :
        ↥(rootZ t)) =
      Subgroup.inclusion (rootC_le_rootZ t p) ⟨rootLetter t ^ p, rootLetter_pow_mem_rootC t p⟩ :=
    Subtype.ext rfl
  have h2 : (⟨rootLetter t ^ p, rootLetter_pow_mem_rootK t p⟩ : ↥(rootK t p)) =
      Subgroup.inclusion (rootC_le_rootK t p) ⟨rootLetter t ^ p, rootLetter_pow_mem_rootC t p⟩ :=
    Subtype.ext rfl
  calc rootIsoAmaFwd t p (rootLetter t ^ p)
      = Ama.ofZ t p ((⟨rootLetter t, rootLetter_mem_rootZ t⟩ : ↥(rootZ t)) ^ p) := by
        rw [map_zpow (rootIsoAmaFwd t p) (rootLetter t) p, rootIsoAmaFwd_ofInr,
          ← map_zpow (Ama.ofZ t p) (⟨rootLetter t, rootLetter_mem_rootZ t⟩ : ↥(rootZ t)) p]
    _ = Ama.ofZ t p ⟨rootLetter t ^ p, rootC_le_rootZ t p (rootLetter_pow_mem_rootC t p)⟩ := by
        rw [hw]
    _ = Ama.base t p ⟨rootLetter t ^ p, rootLetter_pow_mem_rootC t p⟩ :=
        (congrArg (Ama.ofZ t p) h1).trans (Ama.ofZ_inclusion_base t p _)
    _ = Ama.ofK t p ⟨rootLetter t ^ p, rootLetter_pow_mem_rootK t p⟩ :=
        (Ama.ofK_inclusion_base t p _).symm.trans (congrArg (Ama.ofK t p) h2.symm)

/-- **The forward map on the `K`-vertex**: composed with the embedding `rootHom : F(α) →* P` it
agrees with the vertex map of the amalgam. -/
theorem rootIsoAmaFwd_comp_rootHom (t : α) (p : ℤ) :
    (rootIsoAmaFwd t p).comp (rootHom t p) =
      (Ama.ofK t p).comp ((rootHom t p).rangeRestrict) := by
  apply FreeGroup.ext_hom
  intro a
  by_cases ha : a = t
  · rw [ha]
    have hrr : (rootHom t p).rangeRestrict (FreeGroup.of t) =
        ⟨rootLetter t ^ p, rootLetter_pow_mem_rootK t p⟩ := by
      refine Subtype.ext ?_
      rw [MonoidHom.coe_rangeRestrict, rootHom_of_eq]
    show rootIsoAmaFwd t p (rootHom t p (FreeGroup.of t)) =
      (Ama.ofK t p) ((rootHom t p).rangeRestrict (FreeGroup.of t))
    rw [rootHom_of_eq, hrr, rootIsoAmaFwd_pow]
  · have hrr : (rootHom t p).rangeRestrict (FreeGroup.of a) =
        ⟨FreeGroup.of (Sum.inl ⟨a, ha⟩), ⟨FreeGroup.of a, rootHom_of_ne ha p⟩⟩ := by
      refine Subtype.ext ?_
      rw [MonoidHom.coe_rangeRestrict]
      exact rootHom_of_ne ha p
    show rootIsoAmaFwd t p (rootHom t p (FreeGroup.of a)) =
      (Ama.ofK t p) ((rootHom t p).rangeRestrict (FreeGroup.of a))
    rw [hrr]
    conv_lhs => rw [rootHom_of_ne ha p]
    rw [rootIsoAmaFwd_ofInl]

/-- The forward map on the `K`-vertex, elementwise form. -/
theorem rootIsoAmaFwd_rootHom_apply (t : α) (p : ℤ) (x : FreeGroup α) :
    rootIsoAmaFwd t p (rootHom t p x) = Ama.ofK t p ⟨rootHom t p x, ⟨x, rfl⟩⟩ := by
  have h := DFunLike.congr_fun (rootIsoAmaFwd_comp_rootHom t p) x
  rw [MonoidHom.comp_apply, MonoidHom.comp_apply] at h
  rw [h]
  congr 1

/-- **The forward map agrees with the `K`-vertex of the amalgam** (condition 1 of
`rootAmaEquiv`, as an equality of homomorphisms). -/
theorem rootIsoAmaFwd_subK (t : α) (p : ℤ) :
    (rootIsoAmaFwd t p).comp (Subgroup.subtype (rootK t p)) = Ama.ofK t p := by
  ext y
  obtain ⟨x, hx⟩ := y.2
  have hy : (⟨rootHom t p x, ⟨x, rfl⟩⟩ : ↥(rootK t p)) = y := Subtype.ext hx
  calc (rootIsoAmaFwd t p).comp (Subgroup.subtype (rootK t p)) y
      = rootIsoAmaFwd t p ((Subgroup.subtype (rootK t p)) y) := rfl
    _ = rootIsoAmaFwd t p (rootHom t p x) := by
        rw [show (Subgroup.subtype (rootK t p)) y = rootHom t p x from hx.symm]
    _ = Ama.ofK t p ⟨rootHom t p x, ⟨x, rfl⟩⟩ := rootIsoAmaFwd_rootHom_apply t p x
    _ = Ama.ofK t p y := congrArg (Ama.ofK t p) hy

/-! ## The backward map `Ama t p →* F(RootIdx α t)` -/

/-- The `K`-vertex and the `⟨z⟩`-vertex of the amalgam, as subgroups of `P = F(RootIdx α t)`. -/
noncomputable def rootAmaVertex (t : α) (p : ℤ) :
    ∀ i, RootAmaG t p i →* FreeGroup (RootIdx α t) :=
  RootAmaIdx.rec (Subgroup.subtype (rootK t p)) (Subgroup.subtype (rootZ t))

@[simp] theorem rootAmaVertex_vK (t : α) (p : ℤ) :
    rootAmaVertex t p RootAmaIdx.vK = Subgroup.subtype (rootK t p) := rfl

@[simp] theorem rootAmaVertex_vZ (t : α) (p : ℤ) :
    rootAmaVertex t p RootAmaIdx.vZ = Subgroup.subtype (rootZ t) := rfl

/-- The compatibility needed to descend the inclusion of the vertices to the amalgam: on the edge
subgroup `rootC` the two vertex maps agree (both are the inclusion of `rootC` into `P`). -/
theorem rootAmaCompat (t : α) (p : ℤ) :
    ∀ i, (rootAmaVertex t p i).comp (amaPhi t p i) = Subgroup.subtype (rootC t p) := by
  intro i
  cases i
  · rw [amaPhi_vK]
    ext c
    rfl
  · rw [amaPhi_vZ]
    ext c
    rfl

/-- The backward map of `rootAmaEquiv`: the pushout universal property applied to the inclusions
of the two vertices `rootK`, `rootZ` into `P = F(RootIdx α t)`. -/
noncomputable def rootIsoAmaBwd (t : α) (p : ℤ) : Ama t p →* FreeGroup (RootIdx α t) :=
  Monoid.PushoutI.lift (rootAmaVertex t p) (Subgroup.subtype (rootC t p)) (rootAmaCompat t p)

@[simp] theorem rootIsoAmaBwd_ofK (t : α) (p : ℤ) (y : ↥(rootK t p)) :
    rootIsoAmaBwd t p (Ama.ofK t p y) = y :=
  Monoid.PushoutI.lift_of (rootAmaVertex t p) (Subgroup.subtype (rootC t p))
    (rootAmaCompat t p) (i := RootAmaIdx.vK) y

@[simp] theorem rootIsoAmaBwd_ofZ (t : α) (p : ℤ) (y : ↥(rootZ t)) :
    rootIsoAmaBwd t p (Ama.ofZ t p y) = y :=
  Monoid.PushoutI.lift_of (rootAmaVertex t p) (Subgroup.subtype (rootC t p))
    (rootAmaCompat t p) (i := RootAmaIdx.vZ) y

@[simp] theorem rootIsoAmaBwd_base (t : α) (p : ℤ) (y : ↥(rootC t p)) :
    rootIsoAmaBwd t p (Ama.base t p y) = y :=
  Monoid.PushoutI.lift_base (rootAmaVertex t p) (Subgroup.subtype (rootC t p))
    (rootAmaCompat t p) y

theorem rootIsoAmaBwd_comp_ofK (t : α) (p : ℤ) :
    (rootIsoAmaBwd t p).comp (Ama.ofK t p) = Subgroup.subtype (rootK t p) := by
  ext y
  exact rootIsoAmaBwd_ofK t p y

theorem rootIsoAmaBwd_comp_ofZ (t : α) (p : ℤ) :
    (rootIsoAmaBwd t p).comp (Ama.ofZ t p) = Subgroup.subtype (rootZ t) := by
  ext y
  exact rootIsoAmaBwd_ofZ t p y

theorem rootIsoAmaBwd_comp_base (t : α) (p : ℤ) :
    (rootIsoAmaBwd t p).comp (Ama.base t p) = Subgroup.subtype (rootC t p) := by
  ext y
  exact rootIsoAmaBwd_base t p y

/-! ## The forward map on the edge subgroup -/

/-- **The forward map agrees with the edge subgroup of the amalgam** (condition 2 of
`rootAmaEquiv`, as an equality of homomorphisms). -/
theorem rootIsoAmaFwd_subC (t : α) (p : ℤ) :
    (rootIsoAmaFwd t p).comp (Subgroup.subtype (rootC t p)) = Ama.base t p := by
  have h : Subgroup.subtype (rootC t p) =
      (Subgroup.subtype (rootK t p)).comp (Subgroup.inclusion (rootC_le_rootK t p)) := by
    ext c
    exact Subgroup.coe_inclusion (rootC_le_rootK t p) c
  rw [h, ← MonoidHom.comp_assoc, rootIsoAmaFwd_subK]
  ext c
  exact Ama.ofK_inclusion_base t p c

end Work.ORLocInd.CohenLyndon
