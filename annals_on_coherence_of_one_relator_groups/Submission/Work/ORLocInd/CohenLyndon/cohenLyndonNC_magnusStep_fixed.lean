import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.magnusStepDefs
import Submission.Work.ORLocInd.CohenLyndon.cohenLyndonNC_hnn
import Submission.Work.ORLocInd.CohenLyndon.magnusStep.magW_disjoint_magA
import Submission.Work.ORLocInd.CohenLyndon.magnusStep.magW_disjoint_magB
import Submission.Work.ORLocInd.CohenLyndon.magnusStep.cohenLyndonNC_of_mulEquiv

namespace Work.ORLocInd.CohenLyndon

universe u

open Work.OROneRel

/-- **The Magnus (HNN) step of the Cohen--Lyndon induction, in the form taking the Cohen--Lyndon
property of the Magnus rewriting as a hypothesis.**

Let `r ∈ F(α)` be cyclically reduced, `r ≠ 1`, and let `t` be a letter occurring in `r` with
exponent sum zero.  If the Magnus rewriting `r' = magW t r` of `r` is Cohen--Lyndon in the free
group on the decorated alphabet `magS t r`, then `r` itself is Cohen--Lyndon in `F(α)`.

This is the induction step of `cohenLyndonNC_magnusStep`, with the strong induction hypothesis and
the non-proper-power assumption on `r` replaced by the single hypothesis `hCL`.  All the
Freiheitssatz input used by the HNN transfer is available unconditionally here: the rewriting `r'`
is cyclically reduced and not generated by the decorations of `magTA t r` resp. `magTB t r`, so
`⟪r'⟫ ∩ magA t r = ⊥` and `⟪r'⟫ ∩ magB t r = ⊥`. -/
theorem cohenLyndonNC_magnusStep_fixed {α : Type u} [DecidableEq α] (r : FreeGroup α) (t : α)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator r) (hr1 : r ≠ 1)
    (ht : t ∈ Work.OROneRel.relatorLetters r) (hσ : Work.OROneRel.sigma t r = 1)
    (hCL : Work.CohenLyndon.CohenLyndonNC (Work.ORLocInd.CohenLyndon.magW t r)) :
    Work.CohenLyndon.CohenLyndonNC r := by
  classical
  -- the exponent sum of `t` in `r` vanishes
  have heps : eps t r = 0 := (eps_eq_zero_iff_sigma_eq_one t r).mpr hσ
  -- the Magnus rewriting of `r` is nontrivial
  have hne : magW t r ≠ 1 := magW_ne_one t r hcyc hr1 ht heps
  -- the Freiheitssatz input for the HNN transfer
  have hdisA : Subgroup.normalClosure ({magW t r} : Set (FreeGroup (magS t r))) ⊓ magA t r = ⊥ :=
    magnusStep.magW_disjoint_magA r t hcyc hr1 ht heps
  have hdisB : Subgroup.normalClosure ({magW t r} : Set (FreeGroup (magS t r))) ⊓ magB t r = ⊥ :=
    magnusStep.magW_disjoint_magB r t hcyc hr1 ht heps
  -- the HNN transfer gives Cohen--Lyndonness of `of r'`
  have hCLof : Work.CohenLyndon.CohenLyndonNC
      (HNNExtension.of (magW t r) : magHNN t r) :=
    cohenLyndonNC_hnn (magA t r) (magB t r) (magPhi t r) hne hCL hdisA hdisB
  -- transport back along the Magnus decomposition `F α ≃* magHNN`
  refine (magnusStep.cohenLyndonNC_of_mulEquiv (magIso t r) r) ?_
  rw [magIso_self t r heps]
  exact hCLof

end Work.ORLocInd.CohenLyndon
