import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.magnusStepDefs
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.OROneRel.injective_presentedGroupMap_of_isConj

set_option autoImplicit false

universe u

namespace Work.ORLocInd.CohenLyndon.magnusStep

open Work.OROneRel

/-- If the canonical map `F(T) →* ⟨β | s⟩` is injective, then the normal closure of `s` in `F(β)`
meets the subgroup generated by the generators in `T` trivially.

This is the "Lie" form of the Freiheitssatz: the kernel of `F(T) →* ⟨β | s⟩` is exactly the
preimage of `⟪s⟫` under the inclusion `F(T) →* F(β)`, so injectivity says precisely that `⟪s⟫`
meets the image `⟨T⟩` trivially. -/
theorem normalClosure_inf_closure_of_injective {β : Type u} {s : FreeGroup β} {T : Set β}
    (hinj : Function.Injective (Work.OROneRel.presentedGroupMap s T)) :
    Subgroup.normalClosure ({s} : Set (FreeGroup β)) ⊓
        Subgroup.closure (FreeGroup.of '' T) = ⊥ := by
  set L : FreeGroup T →* FreeGroup β := FreeGroup.lift fun t : T => FreeGroup.of (t : β) with hL
  -- the preimage of `⟪s⟫` under `L` is trivial
  have hker : (Subgroup.normalClosure ({s} : Set (FreeGroup β))).comap L = ⊥ := by
    rw [hL, ← Work.OROneRel.ker_presentedGroupMap (T := T) s]
    exact MonoidHom.ker_eq_bot _ hinj
  -- the range of `L` is the subgroup generated by `T`
  have hrange : L.range = Subgroup.closure (FreeGroup.of '' T) := by
    rw [hL, FreeGroup.range_lift_eq_closure, ← Set.image_eq_range]
  have hmain : L.range ⊓ Subgroup.normalClosure ({s} : Set (FreeGroup β)) = ⊥ := by
    have h := Subgroup.map_comap_eq L (Subgroup.normalClosure ({s} : Set (FreeGroup β)))
    rw [hker, Subgroup.map_bot] at h
    exact h.symm
  rw [← hrange, inf_comm]
  exact hmain

theorem magW_disjoint_magB {α : Type u} [DecidableEq α] (r : FreeGroup α) (t : α)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator r) (h1 : r ≠ 1)
    (ht : t ∈ Work.OROneRel.relatorLetters r) (hσ : Work.OROneRel.eps t r = 0) :
    Subgroup.normalClosure ({magW t r} : Set (FreeGroup (magS t r))) ⊓ magB t r = ⊥ := by
  have hred : FreeGroup.IsReduced (mmWL t r) :=
    Work.OROneRel.mmWL_isReduced t r hcyc hσ
  have hcyc' : Work.OROneRel.IsCyclicallyReducedRelator (mmW t r) :=
    Work.OROneRel.mmW_isCyclicallyReduced (t := t) (r := r) hcyc hσ
  have hB : mmW t r ∉ Subgroup.closure (FreeGroup.of '' mmTB t r) :=
    Work.OROneRel.mmW_notMem_closure_TB (t := t) (r := r) h1 ht hσ hred
  have hinj : Function.Injective
      (Work.OROneRel.presentedGroupMap (mmW t r) (mmTB t r)) :=
    Work.OROneRel.freiheitssatz_at (mmW t r) hcyc' (mmTB t r) hB
  simpa only [magB, magTB, magW, magS] using
    normalClosure_inf_closure_of_injective (β := magS t r) (s := mmW t r) (T := mmTB t r) hinj

end Work.ORLocInd.CohenLyndon.magnusStep
