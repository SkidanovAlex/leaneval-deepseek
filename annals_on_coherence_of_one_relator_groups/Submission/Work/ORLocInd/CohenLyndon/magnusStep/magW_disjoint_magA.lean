import Mathlib
import Submission.Work.OROneRel.freiheitssatz_at
import Submission.Work.ORLocInd.CohenLyndon.magnusStepDefs

/-!
# The Magnus step: `⟪r'⟫ ∩ A = ⊥`

Let `r` be a cyclically reduced relator over the alphabet `α`, `t` a letter of `r` of exponent sum
zero, and `r' = magW t r` the Magnus rewriting of `r` with respect to `t`, an element of the free
group `F(magS t r)` on the decorated alphabet.  The Magnus decomposition of `F α` is the HNN
extension of `F(magS t r)` with stable letter `t` along the two *index-shift* subgroups
`magA t r = ⟨of '' magTA t r⟩` and `magB t r = ⟨of '' magTB t r⟩`.

This file proves the first Freiheitssatz input of that decomposition, in its `magA` form:
`⟪r'⟫ ∩ magA t r = ⊥`, i.e. the normal closure of the rewritten relator meets the first associated
subgroup trivially (the `magB` form is the sibling file `magW_disjoint_magB`).

The content is entirely the classical Freiheitssatz (Magnus 1930), available unconditionally in the
workspace as `Work.OROneRel.freiheitssatz_at`:

* the rewriting `r'` of a cyclically reduced relator is cyclically reduced
  (`mmW_isCyclicallyReduced`);
* `r' ∉ magA t r`, because `r'` involves a decoration of *maximal* index in some letter, which can
  never be shifted up (`mmW_notMem_closure_TA`), so the Freiheitssatz applies to the relator `r'`
  and the generating set `magTA t r`;
* injectivity of `F(magTA t r) →* ⟨magS t r | r'⟩` says that an element of `magA t r` which is a
  product of conjugates of `r'` must be the identity, which is exactly the stated triviality of the
  intersection `⟪r'⟫ ∩ magA t r`.
-/

namespace Work.ORLocInd.CohenLyndon.magnusStep

universe u

open Work.OROneRel

/-- **The Freiheitssatz in normal-closure form.**  If `w : FreeGroup β` is cyclically reduced and is
not generated by the letters `T ⊆ β`, then the normal closure of `w` meets the subgroup generated by
`T` trivially.

Indeed, `w ∉ ⟨of '' T⟩` makes the canonical map `F(T) →* ⟨β | w⟩` injective
(`Work.OROneRel.freiheitssatz_at`); an element of `⟪w⟫` lying in `⟨of '' T⟩ = range (FreeGroup.lift)`
is the image of some `x : F(T)`, and injectivity forces `x = 1`. -/
theorem normalClosure_inf_closure_eq_bot {β : Type u} (w : FreeGroup β) (T : Set β)
    (hc : IsCyclicallyReducedRelator w)
    (hT : w ∉ Subgroup.closure (FreeGroup.of '' T)) :
    Subgroup.normalClosure ({w} : Set (FreeGroup β)) ⊓
      Subgroup.closure (FreeGroup.of '' T) = ⊥ := by
  classical
  have hinj : Function.Injective (presentedGroupMap w T) := freiheitssatz_at w hc T hT
  rw [Subgroup.eq_bot_iff_forall]
  intro g hg
  rw [Subgroup.mem_inf] at hg
  obtain ⟨hgN, hgT⟩ := hg
  -- `⟨of '' T⟩` is the range of the canonical lift `F(T) →* F(β)`
  have hrange : (FreeGroup.lift fun a : T => FreeGroup.of (a : β)).range =
      Subgroup.closure (FreeGroup.of '' T) := by
    rw [FreeGroup.range_lift_eq_closure]
    congr 1
    ext y
    exact ⟨fun ⟨a, ha⟩ => ⟨(a : β), a.2, ha⟩, fun ⟨a, ha, hay⟩ => ⟨⟨a, ha⟩, hay⟩⟩
  have hg' : g ∈ (FreeGroup.lift fun a : T => FreeGroup.of (a : β)).range := by
    rw [hrange]
    exact hgT
  obtain ⟨x, rfl⟩ := hg'
  -- `x` is killed by `F(T) →* ⟨β | w⟩`, so it is trivial by injectivity
  have h1 : presentedGroupMap w T x = 1 := PresentedGroup.mk_eq_one_iff.mpr hgN
  have hx : x = 1 := hinj (by rw [h1, map_one])
  rw [hx, map_one]

/-- The normal closure of the Magnus rewriting `magW t r` meets the first associated subgroup
`magA t r` of the Magnus decomposition of `F α` at the letter `t` trivially. -/
theorem magW_disjoint_magA {α : Type u} [DecidableEq α] (r : FreeGroup α) (t : α)
    (hcyc : Work.OROneRel.IsCyclicallyReducedRelator r) (h1 : r ≠ 1)
    (ht : t ∈ Work.OROneRel.relatorLetters r) (hσ : Work.OROneRel.eps t r = 0) :
    Subgroup.normalClosure ({magW t r} : Set (FreeGroup (magS t r))) ⊓ magA t r = ⊥ := by
  classical
  have hred : FreeGroup.IsReduced (mmWL t r) := mmWL_isReduced t r hcyc hσ
  have hc : Work.OROneRel.IsCyclicallyReducedRelator (magW t r) :=
    mmW_isCyclicallyReduced hcyc hσ
  have hT : magW t r ∉ Subgroup.closure (FreeGroup.of '' magTA t r) :=
    mmW_notMem_closure_TA h1 ht hσ hred
  exact normalClosure_inf_closure_eq_bot (magW t r) (magTA t r) hc hT

end Work.ORLocInd.CohenLyndon.magnusStep
