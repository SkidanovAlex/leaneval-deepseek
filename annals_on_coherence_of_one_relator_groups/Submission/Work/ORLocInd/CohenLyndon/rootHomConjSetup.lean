/-
# Setup for `rootHom_conj_mem_range`: the `z`-run structure of `F(α₁)`

This file fixes the notation for the lemma
`Work.ORLocInd.CohenLyndon.rootHom_conj_mem_range` and introduces the combinatorial
"`z`-run" predicate on words in the free group `P = F(RootIdx α t)`.

`RootIdx α t = {a : α // a ≠ t} ⊕ Unit`, so `P` is free on the letters `a ≠ t`
(together with a new letter `z = Sum.inr ()`).  The subgroup
`K = (rootHom t p).range ≤ P` is generated by `z ^ p` and the letters `a ≠ t`.

The predicate `Good p L` on a word `L : List (RootIdx α t × Bool)` says that every maximal
run of `z`-letters of `L` has exponent divisible by `p`.  It is designed so that

* `Good` is closed under concatenation, inversion and free reduction, and
* `x ∈ K ↔ Good p (FreeGroup.toWord x)`

(the "criterion", proved in `rootHomConjGoodCriterion.lean`).
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.substDefs

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORLocInd.CohenLyndon

variable {α : Type u} [DecidableEq α]

/-- The extra generator `z` of `P = F(RootIdx α t)`. -/
abbrev zLetter (t : α) : RootIdx α t := Sum.inr ()

/-- The subgroup `K = (rootHom t p).range`, described by its generators. -/
theorem range_rootHom_eq_closure (t : α) (p : ℤ) :
    (rootHom t p).range = Subgroup.closure
      ({rootLetter t ^ p} ∪ Set.range (fun a : {a : α // a ≠ t} => FreeGroup.of (Sum.inl a))) := by
  rw [rootHom, FreeGroup.range_lift_eq_closure]
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_union, Set.mem_singleton_iff]
  constructor
  · rintro ⟨a, ha⟩
    by_cases h : a = t
    · subst h
      rw [dif_pos rfl] at ha
      exact Or.inl ha.symm
    · refine Or.inr ⟨⟨a, h⟩, ?_⟩
      rw [dif_neg h] at ha
      exact ha
  · rintro (h | ⟨a, ha⟩)
    · exact ⟨t, by rw [dif_pos rfl]; exact h.symm⟩
    · exact ⟨(a : α), by rw [dif_neg a.2]; simpa using ha⟩

/-- The exponent contribution of the signed letter `(l, b)` to the surrounding run of
`z`-letters: `±1` for the letter `z`, `0` for the other letters. -/
def zEps (t : α) (l : RootIdx α t) (b : Bool) : ℤ :=
  if l = zLetter t then (if b then 1 else -1) else 0

variable (t : α) (p : ℤ)

/-- `goodAux n L` says: the word `L`, preceded by a ("virtual") run of `z`-letters of exponent
`n`, has all its maximal runs of `z`-letters of exponent divisible by `p`. -/
def goodAux : ℤ → List (RootIdx α t × Bool) → Prop
  | n, [] => p ∣ n
  | n, (l, b) :: tl =>
      if l = zLetter t then goodAux (n + (if b then 1 else -1)) tl
      else (p ∣ n) ∧ goodAux 0 tl

/-- `Good p L`: every maximal run of `z`-letters of the word `L` has exponent divisible by `p`. -/
def Good (L : List (RootIdx α t × Bool)) : Prop := goodAux t p 0 L

@[simp] theorem goodAux_nil (n : ℤ) : goodAux t p n ([] : List (RootIdx α t × Bool)) ↔ p ∣ n :=
  Iff.rfl

theorem goodAux_cons_z {n : ℤ} {b : Bool} {tl : List (RootIdx α t × Bool)} :
    goodAux t p n ((zLetter t, b) :: tl) ↔
      goodAux t p (n + (if b then 1 else -1)) tl := by
  rw [goodAux]
  simp

theorem goodAux_cons_other {n : ℤ} {l : RootIdx α t} {b : Bool}
    {tl : List (RootIdx α t × Bool)} (h : l ≠ zLetter t) :
    goodAux t p n ((l, b) :: tl) ↔ p ∣ n ∧ goodAux t p 0 tl := by
  rw [goodAux]
  simp [h]

@[simp] theorem good_nil : Good t p ([] : List (RootIdx α t × Bool)) := dvd_zero p

theorem good_cons_other {l : RootIdx α t} {b : Bool} {tl : List (RootIdx α t × Bool)}
    (h : l ≠ zLetter t) : Good t p ((l, b) :: tl) ↔ Good t p tl := by
  rw [Good, goodAux_cons_other t p h, Good]
  exact ⟨fun hh => hh.2, fun hh => ⟨dvd_zero p, hh⟩⟩

@[simp] theorem zEps_zLetter (b : Bool) : zEps t (zLetter t) b = if b then 1 else -1 := by
  simp [zEps]

theorem zEps_other {l : RootIdx α t} (h : l ≠ zLetter t) (b : Bool) : zEps t l b = 0 := by
  simp [zEps, h]

end Work.ORLocInd.CohenLyndon
