/-
# The amalgam `K ∗_{⟨z ^ p⟩} ⟨z⟩` for the Karrass--Solitar descent

This file collects the definitions used by
`Submission/Work/ORLocInd/CohenLyndon/rootHom_descent.lean`.

Let `P = F(RootIdx α t)` be the free group obtained from `F(α)` by adjoining the letter `z`
(`rootLetter t`), let

* `rootK t p = (rootHom t p).range = ⟨z ^ p, a (a ≠ t)⟩ ≤ P`,
* `rootZ t = ⟨z⟩ ≤ P`,
* `rootC t p = ⟨z ^ p⟩ ≤ P`,

so that `rootC ≤ rootK`, `rootC ≤ rootZ`: the group `P` is the amalgam `rootK ∗_{rootC} rootZ`.

We present that amalgam as the pushout `Ama t p = Monoid.PushoutI (amaPhi t p)` of the two edge
maps `rootC → rootK` and `rootC → rootZ` (indexed by `RootAmaIdx`, `vK` for the vertex `rootK`
and `vZ` for the vertex `rootZ`).
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.substDefs

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORLocInd.CohenLyndon

variable {α : Type u} [DecidableEq α]

/-- The cyclic subgroup `⟨z⟩ ≤ P` generated by the extra letter `z = rootLetter t`. -/
noncomputable abbrev rootZ (t : α) : Subgroup (FreeGroup (RootIdx α t)) := Subgroup.zpowers (rootLetter t)

/-- The edge subgroup `⟨z ^ p⟩ ≤ P` of the amalgam `K ∗_{⟨z ^ p⟩} ⟨z⟩`. -/
noncomputable abbrev rootC (t : α) (p : ℤ) : Subgroup (FreeGroup (RootIdx α t)) :=
  Subgroup.zpowers (rootLetter t ^ p)

/-- The vertex subgroup `K = (rootHom t p).range ≤ P` of the amalgam. -/
noncomputable abbrev rootK (t : α) (p : ℤ) : Subgroup (FreeGroup (RootIdx α t)) := (rootHom t p).range

theorem rootLetter_mem_rootZ (t : α) : rootLetter t ∈ rootZ t :=
  Subgroup.mem_zpowers _

theorem rootLetter_pow_mem_rootC (t : α) (p : ℤ) : rootLetter t ^ p ∈ rootC t p :=
  Subgroup.mem_zpowers _

theorem rootLetter_pow_mem_rootK (t : α) (p : ℤ) : rootLetter t ^ p ∈ rootK t p := by
  rw [rootK, ← rootHom_of_eq]
  exact ⟨FreeGroup.of t, rfl⟩

theorem rootC_le_rootZ (t : α) (p : ℤ) : rootC t p ≤ rootZ t := by
  intro x hx
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  exact Subgroup.zpow_mem _ (Subgroup.zpow_mem (rootZ t) (rootLetter_mem_rootZ t) p) m

theorem rootC_le_rootK (t : α) (p : ℤ) : rootC t p ≤ rootK t p := by
  intro x hx
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  exact Subgroup.zpow_mem _ (rootLetter_pow_mem_rootK t p) m

/-- The two vertices of the amalgam `K ∗_{⟨z ^ p⟩} ⟨z⟩`. -/
inductive RootAmaIdx : Type u where
  /-- the vertex `K = rootK t p` -/
  | vK
  /-- the vertex `⟨z⟩ = rootZ t` -/
  | vZ
  deriving DecidableEq

instance : Nonempty RootAmaIdx := ⟨RootAmaIdx.vK⟩

/-- The vertex groups of the amalgam. -/
noncomputable abbrev RootAmaG (t : α) (p : ℤ) : RootAmaIdx → Type u :=
  RootAmaIdx.rec (↥(rootK t p)) (↥(rootZ t))

noncomputable instance rootAmaGGroup (t : α) (p : ℤ) :
    ∀ i : RootAmaIdx, Group (RootAmaG t p i) :=
  RootAmaIdx.rec (rootK t p).toGroup (rootZ t).toGroup

/-- The edge maps of the amalgam. -/
noncomputable abbrev amaPhi (t : α) (p : ℤ) :
    ∀ i : RootAmaIdx, ↥(rootC t p) →* RootAmaG t p i :=
  RootAmaIdx.rec (Subgroup.inclusion (rootC_le_rootK t p))
    (Subgroup.inclusion (rootC_le_rootZ t p))

theorem amaPhi_vK (t : α) (p : ℤ) :
    amaPhi t p RootAmaIdx.vK = Subgroup.inclusion (rootC_le_rootK t p) := rfl

theorem amaPhi_vZ (t : α) (p : ℤ) :
    amaPhi t p RootAmaIdx.vZ = Subgroup.inclusion (rootC_le_rootZ t p) := rfl

/-- The amalgam `K ∗_{⟨z ^ p⟩} ⟨z⟩`, presented as the pushout of the two edge maps. -/
abbrev Ama (t : α) (p : ℤ) : Type u := Monoid.PushoutI (amaPhi t p)

/-- The `K`-vertex of the amalgam. -/
noncomputable abbrev Ama.ofK (t : α) (p : ℤ) : ↥(rootK t p) →* Ama t p :=
  Monoid.PushoutI.of (φ := amaPhi t p) RootAmaIdx.vK

/-- The `⟨z⟩`-vertex of the amalgam. -/
noncomputable abbrev Ama.ofZ (t : α) (p : ℤ) : ↥(rootZ t) →* Ama t p :=
  Monoid.PushoutI.of (φ := amaPhi t p) RootAmaIdx.vZ

/-- The edge subgroup of the amalgam. -/
noncomputable abbrev Ama.base (t : α) (p : ℤ) : ↥(rootC t p) →* Ama t p :=
  Monoid.PushoutI.base (amaPhi t p)

/-- The image of the edge subgroup in the `K`-vertex. -/
theorem Ama.ofK_inclusion_base (t : α) (p : ℤ) (c : ↥(rootC t p)) :
    Ama.ofK t p (Subgroup.inclusion (rootC_le_rootK t p) c) = Ama.base t p c :=
  Monoid.PushoutI.of_apply_eq_base (amaPhi t p) RootAmaIdx.vK c

/-- The image of the edge subgroup in the `⟨z⟩`-vertex. -/
theorem Ama.ofZ_inclusion_base (t : α) (p : ℤ) (c : ↥(rootC t p)) :
    Ama.ofZ t p (Subgroup.inclusion (rootC_le_rootZ t p) c) = Ama.base t p c :=
  Monoid.PushoutI.of_apply_eq_base (amaPhi t p) RootAmaIdx.vZ c

/-- The subgroup of the amalgam generated by the `K`-vertex. -/
noncomputable abbrev Ama.subK (t : α) (p : ℤ) : Subgroup (Ama t p) := (Ama.ofK t p).range

/-- The subgroup of the amalgam generated by the `⟨z⟩`-vertex. -/
noncomputable abbrev Ama.subZ (t : α) (p : ℤ) : Subgroup (Ama t p) := (Ama.ofZ t p).range

/-- The edge subgroup of the amalgam. -/
noncomputable abbrev Ama.subC (t : α) (p : ℤ) : Subgroup (Ama t p) := (Ama.base t p).range

end Work.ORLocInd.CohenLyndon
