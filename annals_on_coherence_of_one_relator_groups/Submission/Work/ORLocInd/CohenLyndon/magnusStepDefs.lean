/-
# The Magnus (HNN) decomposition of a free group at an exponent-sum-zero letter

This file sets up the vocabulary of the Magnus step of the Cohen--Lyndon induction.

Fix a generating type `α`, a relator `r : F(α)` and a letter `t : α` with exponent sum
`σ_t r = 0`.  Then `r` lies in the kernel of `σ_t`, and by Magnus' rewriting `r = ζ(r')` where
`r' = mmW t r` is the Magnus rewriting of `r`, an element of the free group on the decorated
alphabet `magS t r := mmBeta t r` (the interval closure, per letter, of the decorations occurring in
the rewriting), and `ζ : F(magS t r) →* F α` is the map sending the decoration `(x,k)` to the
conjugate `t^k x t^{-k}` (`magBetaMap`, an injective map).

The free group `F(α)` is the HNN extension of `F(magS t r)` along the two index-shift subgroups
`magA`, `magB` (generated by the decorations that can be shifted up, resp. down), with stable letter
`t`:

* `magTheta : F α →* magHNN` is `t ↦ stable letter` and `y ↦ u^{-lo_y} * of (y, lo_y) * u^{lo_y}`
  for `y ≠ t` (`lo_y` the least index of `y` in the rewriting), and
* `magLambda : magHNN →* F α` is the base map `(x,k) ↦ t^k x t^{-k}` together with `u ↦ t`.

The two are mutually inverse, so that `F α ≃* magHNN`, and `magTheta r = of r'`.
-/
import Submission.Work.OROneRel.mmStepData_of_expsum_zero

set_option autoImplicit false
set_option linter.dupNamespace false

universe u

namespace Work.ORLocInd.CohenLyndon

open Work.OROneRel

variable {α : Type u}

/-- The decorated alphabet of the Magnus decomposition of `r` at the letter `t`: the interval
closure (per decorated letter) of the decorations occurring in the Magnus rewriting. -/
abbrev magS (t : α) (r : FreeGroup α) : Type u := mmBeta t r

/-- The decorations that can be shifted up by one: the generating set of the first associated
subgroup of the HNN decomposition. -/
abbrev magTA (t : α) (r : FreeGroup α) : Set (magS t r) := mmTA t r

/-- The decorations that can be shifted down by one: the generating set of the second associated
subgroup of the HNN decomposition. -/
abbrev magTB (t : α) (r : FreeGroup α) : Set (magS t r) := mmTB t r

/-- The Magnus rewriting of `r` with respect to `t`. -/
noncomputable abbrev magW (t : α) (r : FreeGroup α) : FreeGroup (magS t r) := mmW t r

/-- The first associated (index-shift) subgroup of the HNN decomposition of `F α` at `t`. -/
noncomputable abbrev magA (t : α) (r : FreeGroup α) : Subgroup (FreeGroup (magS t r)) :=
  Subgroup.closure (FreeGroup.of '' magTA t r)

/-- The second associated (index-shift) subgroup of the HNN decomposition of `F α` at `t`. -/
noncomputable abbrev magB (t : α) (r : FreeGroup α) : Subgroup (FreeGroup (magS t r)) :=
  Subgroup.closure (FreeGroup.of '' magTB t r)

theorem magA_eq_range (t : α) (r : FreeGroup α) :
    magA t r = (FreeGroup.map (fun e : magTA t r => (e : magS t r))).range := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro x ⟨e, he, rfl⟩
    exact ⟨FreeGroup.of ⟨e, he⟩, FreeGroup.map.of⟩
  · rw [MonoidHom.range_eq_map, Subgroup.map_le_iff_le_comap]
    intro x _
    have h : Subgroup.closure (Set.range (FreeGroup.of : magTA t r → FreeGroup (magTA t r))) ≤
        Subgroup.comap (FreeGroup.map (fun e : magTA t r => (e : magS t r))) (magA t r) := by
      rw [Subgroup.closure_le]
      rintro y ⟨e, rfl⟩
      exact Subgroup.subset_closure ⟨(e : magS t r), e.2, FreeGroup.map.of⟩
    refine h ?_
    rw [FreeGroup.closure_range_of]
    exact Subgroup.mem_top x

theorem magB_eq_range (t : α) (r : FreeGroup α) :
    magB t r = (FreeGroup.map (fun e : magTB t r => (e : magS t r))).range := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro x ⟨e, he, rfl⟩
    exact ⟨FreeGroup.of ⟨e, he⟩, FreeGroup.map.of⟩
  · rw [MonoidHom.range_eq_map, Subgroup.map_le_iff_le_comap]
    intro x _
    have h : Subgroup.closure (Set.range (FreeGroup.of : magTB t r → FreeGroup (magTB t r))) ≤
        Subgroup.comap (FreeGroup.map (fun e : magTB t r => (e : magS t r))) (magB t r) := by
      rw [Subgroup.closure_le]
      rintro y ⟨e, rfl⟩
      exact Subgroup.subset_closure ⟨(e : magS t r), e.2, FreeGroup.map.of⟩
    refine h ?_
    rw [FreeGroup.closure_range_of]
    exact Subgroup.mem_top x

/-- The free group on the first associated generating set, identified with `magA`. -/
noncomputable def magAEquiv (t : α) (r : FreeGroup α) : FreeGroup (magTA t r) ≃* magA t r :=
  (MonoidHom.ofInjective (f := FreeGroup.map (fun e : magTA t r => (e : magS t r)))
      (FreeGroup.map_injective Subtype.val_injective)).trans
    (MulEquiv.subgroupCongr (magA_eq_range t r).symm)

/-- The free group on the second associated generating set, identified with `magB`. -/
noncomputable def magBEquiv (t : α) (r : FreeGroup α) : FreeGroup (magTB t r) ≃* magB t r :=
  (MonoidHom.ofInjective (f := FreeGroup.map (fun e : magTB t r => (e : magS t r)))
      (FreeGroup.map_injective Subtype.val_injective)).trans
    (MulEquiv.subgroupCongr (magB_eq_range t r).symm)

theorem magAEquiv_of (t : α) (r : FreeGroup α) (e : magTA t r) :
    ((magAEquiv t r (FreeGroup.of e) : magA t r) : FreeGroup (magS t r)) =
      FreeGroup.of (e : magS t r) := by
  simp only [magAEquiv, MulEquiv.trans_apply, MonoidHom.ofInjective_apply,
    MulEquiv.subgroupCongr_apply, FreeGroup.map.of]

theorem magBEquiv_of (t : α) (r : FreeGroup α) (e : magTB t r) :
    ((magBEquiv t r (FreeGroup.of e) : magB t r) : FreeGroup (magS t r)) =
      FreeGroup.of (e : magS t r) := by
  simp only [magBEquiv, MulEquiv.trans_apply, MonoidHom.ofInjective_apply,
    MulEquiv.subgroupCongr_apply, FreeGroup.map.of]

/-- The isomorphism between the two associated subgroups of the Magnus decomposition, induced by
the shift `(x,k) ↦ (x,k+1)` of the decorations. -/
noncomputable def magPhi (t : α) (r : FreeGroup α) : magA t r ≃* magB t r :=
  (magAEquiv t r).symm.trans
    ((FreeGroup.freeGroupCongr (mmTshift t r)).trans (magBEquiv t r))

theorem magPhiBeta (t : α) (r : FreeGroup α) (p : magS t r) (hp : p ∈ magTA t r) :
    ((magPhi t r ⟨FreeGroup.of p,
        Subgroup.subset_closure ⟨p, hp, rfl⟩⟩ : magB t r) : FreeGroup (magS t r)) =
      FreeGroup.of (mmBetaOf t r ((p.1.1, p.1.2 + 1) : MMAlpha t)) := by
  have hmem : FreeGroup.of p ∈ magA t r := Subgroup.subset_closure ⟨p, hp, rfl⟩
  have h0 : (magAEquiv t r) (FreeGroup.of (⟨p, hp⟩ : magTA t r)) =
      (⟨FreeGroup.of p, hmem⟩ : magA t r) := by
    refine Subtype.ext ?_
    rw [magAEquiv_of t r ⟨p, hp⟩]
  have h1 : (magAEquiv t r).symm (⟨FreeGroup.of p, hmem⟩ : magA t r) =
      FreeGroup.of (⟨p, hp⟩ : magTA t r) := by
    rw [← h0]
    exact MulEquiv.symm_apply_apply _ _
  rw [magPhi, MulEquiv.trans_apply, h1, MulEquiv.trans_apply, FreeGroup.freeGroupCongr_apply,
    FreeGroup.map.of]
  rw [magBEquiv_of]
  refine congrArg FreeGroup.of ?_
  refine Subtype.ext ?_
  rw [mmBetaOf_val t r (show ((p.1.1, p.1.2 + 1) : MMAlpha t) ∈ mmDecSet t r from hp)]
  rfl

/-- The base map of the Magnus decomposition: the decoration `(x,k)` is sent to the conjugate
`t^k * x * t^{-k}` of the original generators. -/
noncomputable def magBetaMap (t : α) (r : FreeGroup α) : FreeGroup (magS t r) →* FreeGroup α :=
  (rho t).comp (FreeGroup.map (fun p : magS t r => (p.1 : MMAlpha t)))

theorem magBetaMap_of (t : α) (r : FreeGroup α) (p : magS t r) :
    magBetaMap t r (FreeGroup.of p) =
      (FreeGroup.of t) ^ (p.1.2) * FreeGroup.of (p.1.1 : α) * (FreeGroup.of t) ^ (-(p.1.2)) := by
  rw [magBetaMap, MonoidHom.comp_apply, FreeGroup.map.of]
  exact FreeGroup.lift_apply_of

/-- The Magnus rewriting of `r` expands back to `r`: `ζ(r') = r`. -/
theorem magBetaMap_magW (t : α) (r : FreeGroup α) (h : eps t r = 0) :
    magBetaMap t r (magW t r) = r := by
  rw [magBetaMap, MonoidHom.comp_apply, mmW_map_val, rho_eq_magnusMap]
  exact magnusMap_mmList t r h

/-- The HNN extension of the Magnus decomposition of `F α` at the letter `t`. -/
noncomputable abbrev magHNN (t : α) (r : FreeGroup α) : Type u :=
  HNNExtension (FreeGroup (magS t r)) (magA t r) (magB t r) (magPhi t r)

/-- The compatibility of the base map with the HNN relation: `magLambda` is well defined. -/
theorem magLambda_compat (t : α) (r : FreeGroup α) :
    ∀ a : magA t r, (FreeGroup.of t) * magBetaMap t r (a : FreeGroup (magS t r)) =
      magBetaMap t r ((magPhi t r a : magB t r) : FreeGroup (magS t r)) * (FreeGroup.of t) := by
  intro a
  refine Subgroup.closure_induction
    (p := fun y hy => (FreeGroup.of t) * magBetaMap t r y =
      magBetaMap t r ((magPhi t r (⟨y, hy⟩ : magA t r) : magB t r) : FreeGroup (magS t r)) *
        (FreeGroup.of t)) ?_ ?_ ?_ ?_ a.2
  · rintro y ⟨e, he, rfl⟩
    have hmem : FreeGroup.of (e : magS t r) ∈ magA t r :=
      Subgroup.subset_closure ⟨(e : magS t r), he, rfl⟩
    show (FreeGroup.of t) * magBetaMap t r (FreeGroup.of (e : magS t r)) =
      magBetaMap t r ((magPhi t r (⟨FreeGroup.of (e : magS t r), hmem⟩ : magA t r) : magB t r) :
        FreeGroup (magS t r)) * (FreeGroup.of t)
    rw [magPhiBeta t r (e : magS t r) he, magBetaMap_of, magBetaMap_of]
    have hshift : (mmBetaOf t r (((e : magS t r).1.1, (e : magS t r).1.2 + 1) : MMAlpha t) :
        magS t r).1 = ((e : magS t r).1.1, (e : magS t r).1.2 + 1) :=
      mmBetaOf_val t r (show (((e : magS t r).1.1, (e : magS t r).1.2 + 1) : MMAlpha t) ∈
        mmDecSet t r from he)
    rw [hshift]
    group
  · show (FreeGroup.of t) * magBetaMap t r 1 =
      magBetaMap t r ((magPhi t r (1 : magA t r) : magB t r) : FreeGroup (magS t r)) *
        (FreeGroup.of t)
    rw [map_one (magPhi t r), Subgroup.coe_one, map_one (magBetaMap t r), mul_one, one_mul]
  · rintro y z hy hz ihy ihz
    have hE : (⟨y * z, Subgroup.mul_mem _ hy hz⟩ : magA t r) =
        (⟨y, hy⟩ : magA t r) * (⟨z, hz⟩ : magA t r) := Subtype.ext rfl
    have hφ : ((magPhi t r ((⟨y, hy⟩ : magA t r) * (⟨z, hz⟩ : magA t r)) : magB t r) :
          FreeGroup (magS t r)) =
        ((magPhi t r (⟨y, hy⟩ : magA t r) : magB t r) : FreeGroup (magS t r)) *
        ((magPhi t r (⟨z, hz⟩ : magA t r) : magB t r) : FreeGroup (magS t r)) := by
      rw [map_mul]; rfl
    rw [hE, hφ, map_mul, map_mul, ← mul_assoc, ihy, mul_assoc, ihz, mul_assoc]
  · rintro y hy ihy
    have hE : (⟨y⁻¹, Subgroup.inv_mem _ hy⟩ : magA t r) = (⟨y, hy⟩ : magA t r)⁻¹ :=
      Subtype.ext rfl
    have hφ : ((magPhi t r (⟨y, hy⟩ : magA t r)⁻¹ : magB t r) : FreeGroup (magS t r)) =
        (((magPhi t r (⟨y, hy⟩ : magA t r) : magB t r) : FreeGroup (magS t r)))⁻¹ := by
      rw [map_inv]; rfl
    rw [hE, hφ, map_inv (magBetaMap t r) y]
    have key : magBetaMap t r y = (FreeGroup.of t)⁻¹ *
        (magBetaMap t r ((magPhi t r (⟨y, hy⟩ : magA t r) : magB t r) : FreeGroup (magS t r)) *
          (FreeGroup.of t)) := by
      rw [← ihy]; group
    rw [key, map_inv]
    group

/-- The map `magLambda : magHNN →* F α` sending the decoration `(x,k)` to `t^k * x * t^{-k}` and
the stable letter to `t`.  It is the inverse of `magTheta`. -/
noncomputable def magLambda (t : α) (r : FreeGroup α) : magHNN t r →* FreeGroup α :=
  HNNExtension.lift (magBetaMap t r) (FreeGroup.of t) (magLambda_compat t r)

theorem magLambda_of (t : α) (r : FreeGroup α) (g : FreeGroup (magS t r)) :
    magLambda t r (HNNExtension.of g) = magBetaMap t r g :=
  HNNExtension.lift_of _ _ _ g

theorem magLambda_t (t : α) (r : FreeGroup α) :
    magLambda t r (HNNExtension.t : magHNN t r) = FreeGroup.of t :=
  HNNExtension.lift_t _ _ _

/-- The images of the generators of `F α` under `magTheta`. -/
noncomputable def magThetaFun (t : α) (r : FreeGroup α) : α → magHNN t r := by
  classical
  exact fun y => if h : y = t then HNNExtension.t
  else (HNNExtension.t : magHNN t r) ^ (-(mmLo t r ⟨y, h⟩)) *
    HNNExtension.of (FreeGroup.of
      (mmBetaOf t r ((⟨y, h⟩, mmLo t r ⟨y, h⟩) : MMAlpha t))) *
    (HNNExtension.t : magHNN t r) ^ (mmLo t r ⟨y, h⟩)

/-- The map `magTheta : F α →* magHNN` of the Magnus decomposition: it sends a generator `y ≠ t` to
`u^{-lo_y} * (y, lo_y) * u^{lo_y}` and `t` to the stable letter. -/
noncomputable def magTheta (t : α) (r : FreeGroup α) : FreeGroup α →* magHNN t r :=
  FreeGroup.lift (magThetaFun t r)

theorem magTheta_t (t : α) (r : FreeGroup α) :
    magTheta t r (FreeGroup.of t) = (HNNExtension.t : magHNN t r) := by
  rw [magTheta, FreeGroup.lift_apply_of, magThetaFun]
  rw [dif_pos rfl]

theorem magTheta_ne (t : α) (r : FreeGroup α) {y : α} (hy : y ≠ t) :
    magTheta t r (FreeGroup.of y) = (HNNExtension.t : magHNN t r) ^ (-(mmLo t r ⟨y, hy⟩)) *
      HNNExtension.of (FreeGroup.of
        (mmBetaOf t r ((⟨y, hy⟩, mmLo t r ⟨y, hy⟩) : MMAlpha t))) *
      (HNNExtension.t : magHNN t r) ^ (mmLo t r ⟨y, hy⟩) := by
  rw [magTheta, FreeGroup.lift_apply_of, magThetaFun]
  rw [dif_neg hy]

/-- The conjugation step of the Magnus decomposition: conjugation by the stable letter raises the
index of a decoration. -/
theorem magConjStep (t : α) (r : FreeGroup α) (p : magS t r) (hp : p ∈ magTA t r) :
    HNNExtension.of (FreeGroup.of (mmBetaOf t r ((p.1.1, p.1.2 + 1) : MMAlpha t))) =
      (HNNExtension.t : magHNN t r) * HNNExtension.of (FreeGroup.of p) *
        (HNNExtension.t : magHNN t r)⁻¹ := by
  have h := HNNExtension.equiv_eq_conj (φ := magPhi t r)
    (a := (⟨FreeGroup.of p, Subgroup.subset_closure ⟨p, hp, rfl⟩⟩ : magA t r))
  rw [magPhiBeta t r p hp] at h
  simpa using h

/-- Iterating `magConjStep`: conjugation by the stable letter shifts a decoration up by `m`, as long
as the intermediate decorations belong to the interval closure. -/
theorem magConjChain (t : α) (r : FreeGroup α) (x : {x : α // x ≠ t}) (i : ℤ)
    (hi : ((x, i) : MMAlpha t) ∈ mmDecSet t r) :
    ∀ (m : ℕ), (∀ s : ℕ, s < m → ((x, i + s + 1) : MMAlpha t) ∈ mmDecSet t r) →
      (HNNExtension.t : magHNN t r) ^ (m : ℤ) *
        HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i) : MMAlpha t))) *
        (HNNExtension.t : magHNN t r) ^ (-(m : ℤ))
      = HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i + m) : MMAlpha t))) := by
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
    intro hval
    have hval' : ∀ s : ℕ, s < m → ((x, i + s + 1) : MMAlpha t) ∈ mmDecSet t r :=
      fun s hs => hval s (Nat.lt_succ_of_lt hs)
    have hm : ((x, i + m) : MMAlpha t) ∈ mmDecSet t r := by
      rcases Nat.eq_zero_or_pos m with h0 | hpos
      · subst h0; simpa using hi
      · have h1 := hval (m - 1) (by omega)
        rwa [show ((x, i + ((m - 1 : ℕ) : ℤ) + 1) : MMAlpha t) = ((x, i + (m : ℤ)) : MMAlpha t)
          from by congr 1; omega] at h1
    have hmem : mmBetaOf t r ((x, i + m) : MMAlpha t) ∈ magTA t r := by
      simp only [magTA, mmTA, Set.mem_ofPred_eq]
      rw [mmBetaOf_val t r hm]
      exact hval m (Nat.lt_succ_self m)
    have hst := magConjStep t r (mmBetaOf t r ((x, i + m) : MMAlpha t)) hmem
    have hstep' : (HNNExtension.t : magHNN t r) *
          HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i + m) : MMAlpha t))) *
          (HNNExtension.t : magHNN t r)⁻¹
        = HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i + (m + 1)) : MMAlpha t))) := by
      rw [← hst, mmBetaOf_val t r hm]
      congr 1
      congr 1
      congr 1
      push_cast
      ring_nf
    calc (HNNExtension.t : magHNN t r) ^ ((m + 1 : ℕ) : ℤ) *
            HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i) : MMAlpha t))) *
            (HNNExtension.t : magHNN t r) ^ (-((m + 1 : ℕ) : ℤ))
        = (HNNExtension.t : magHNN t r) *
            ((HNNExtension.t : magHNN t r) ^ (m : ℤ) *
              HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i) : MMAlpha t))) *
              (HNNExtension.t : magHNN t r) ^ (-(m : ℤ))) *
            (HNNExtension.t : magHNN t r)⁻¹ := by group
      _ = (HNNExtension.t : magHNN t r) *
            HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i + m) : MMAlpha t))) *
            (HNNExtension.t : magHNN t r)⁻¹ := by rw [ih hval']
      _ = HNNExtension.of (FreeGroup.of (mmBetaOf t r ((x, i + (m + 1)) : MMAlpha t))) := hstep'

/-- `magTheta` inverts `magLambda` on the generators of `F α`. -/
theorem magLambda_comp_magTheta (t : α) (r : FreeGroup α) :
    (magLambda t r).comp (magTheta t r) = MonoidHom.id (FreeGroup α) := by
  refine FreeGroup.ext_hom _ _ fun y => ?_
  by_cases hy : y = t
  · subst hy
    rw [MonoidHom.comp_apply, MonoidHom.id_apply, magTheta_t, magLambda_t]
  · rw [MonoidHom.comp_apply, MonoidHom.id_apply, magTheta_ne t r hy, map_mul, map_mul, map_zpow,
      map_zpow, magLambda_of, magLambda_t, magBetaMap_of]
    have hlo : ((⟨y, hy⟩, mmLo t r ⟨y, hy⟩) : MMAlpha t) ∈ mmDecSet t r :=
      mmLo_mem_decSet t r ⟨y, hy⟩
    have hval : (mmBetaOf t r ((⟨y, hy⟩, mmLo t r ⟨y, hy⟩) : MMAlpha t) : magS t r).1 =
        ((⟨y, hy⟩, mmLo t r ⟨y, hy⟩) : MMAlpha t) := mmBetaOf_val t r hlo
    rw [hval]
    group

/-- **The core computation of the Magnus decomposition.**  Expanding a decoration `p` back into the
original free group (`magBetaMap`) and then mapping into the HNN extension (`magTheta`) returns the
decoration itself: `θ (t^k x t^{-k}) = of p`. -/
theorem magTheta_betaMap_of (t : α) (r : FreeGroup α) (p : magS t r) :
    magTheta t r (magBetaMap t r (FreeGroup.of p)) = HNNExtension.of (FreeGroup.of p) := by
  classical
  rw [magBetaMap_of, map_mul, map_mul, map_zpow, map_zpow, magTheta_t,
    magTheta_ne t r p.1.1.2]
  have hlo_mem : ((p.1.1, mmLo t r p.1.1) : MMAlpha t) ∈ mmDecSet t r :=
    mmLo_mem_decSet t r p.1.1
  have hnonneg : 0 ≤ p.1.2 - mmLo t r p.1.1 := by have h := p.2.1; omega
  have hcast : (((p.1.2 - mmLo t r p.1.1).toNat : ℕ) : ℤ) = p.1.2 - mmLo t r p.1.1 :=
    Int.toNat_of_nonneg hnonneg
  have hchain := magConjChain t r p.1.1 (mmLo t r p.1.1) hlo_mem
    ((p.1.2 - mmLo t r p.1.1).toNat) (fun s hs => by
      have hs' : (s : ℤ) < p.1.2 - mmLo t r p.1.1 := by
        have h2 : (s : ℤ) < ((((p.1.2 - mmLo t r p.1.1).toNat : ℕ)) : ℤ) := by
          rw [Nat.cast_lt]; exact hs
        rwa [hcast] at h2
      show mmLo t r p.1.1 ≤ mmLo t r p.1.1 + (s : ℤ) + 1 ∧
        mmLo t r p.1.1 + (s : ℤ) + 1 ≤ mmHi t r p.1.1
      have hhi := p.2.2
      constructor <;> omega)
  have hL : (HNNExtension.t : magHNN t r) ^ (p.1.2) *
      ((HNNExtension.t : magHNN t r) ^ (-(mmLo t r p.1.1)) *
        HNNExtension.of (FreeGroup.of (mmBetaOf t r ((p.1.1, mmLo t r p.1.1) : MMAlpha t))) *
        (HNNExtension.t : magHNN t r) ^ (mmLo t r p.1.1)) *
      (HNNExtension.t : magHNN t r) ^ (-(p.1.2)) =
      (HNNExtension.t : magHNN t r) ^ (((p.1.2 - mmLo t r p.1.1).toNat : ℕ) : ℤ) *
        HNNExtension.of (FreeGroup.of (mmBetaOf t r ((p.1.1, mmLo t r p.1.1) : MMAlpha t))) *
        (HNNExtension.t : magHNN t r) ^ (-(((p.1.2 - mmLo t r p.1.1).toNat : ℕ) : ℤ)) := by
    rw [hcast]
    group
  rw [hL, hchain]
  have hmem2 : ((p.1.1, mmLo t r p.1.1 + ((p.1.2 - mmLo t r p.1.1).toNat : ℕ)) :
      MMAlpha t) ∈ mmDecSet t r := by
    show mmLo t r p.1.1 ≤ mmLo t r p.1.1 + ((p.1.2 - mmLo t r p.1.1).toNat : ℕ) ∧
      mmLo t r p.1.1 + ((p.1.2 - mmLo t r p.1.1).toNat : ℕ) ≤ mmHi t r p.1.1
    have hhi := p.2.2
    constructor <;> omega
  refine congrArg HNNExtension.of (congrArg FreeGroup.of (Subtype.ext ?_))
  rw [mmBetaOf_val t r hmem2]
  refine Prod.ext rfl ?_
  show mmLo t r p.1.1 + ((p.1.2 - mmLo t r p.1.1).toNat : ℕ) = p.1.2
  rw [hcast]
  ring

/-- `magTheta` is a section of `magBetaMap`: pulling a decoration back into `F α` and then mapping
into the HNN extension is the canonical embedding. -/
theorem magTheta_comp_magBetaMap (t : α) (r : FreeGroup α) :
    (magTheta t r).comp (magBetaMap t r) = (HNNExtension.of : FreeGroup (magS t r) →* magHNN t r) := by
  refine FreeGroup.ext_hom _ _ fun p => ?_
  rw [MonoidHom.comp_apply]
  exact magTheta_betaMap_of t r p

/-- `magLambda` is a section of `magTheta`. -/
theorem magTheta_comp_magLambda (t : α) (r : FreeGroup α) :
    (magTheta t r).comp (magLambda t r) = MonoidHom.id (magHNN t r) := by
  have h1 : (magLambda t r).comp HNNExtension.of = magBetaMap t r :=
    MonoidHom.ext fun g => magLambda_of t r g
  refine HNNExtension.hom_ext ?_ ?_
  · rw [MonoidHom.comp_assoc, h1, magTheta_comp_magBetaMap, MonoidHom.id_comp]
  · rw [MonoidHom.comp_apply, MonoidHom.id_apply, magLambda_t, magTheta_t]

/-- `magTheta` inverts `magBetaMap` on the whole free group: pulling back a word in the decorated
letters and then mapping into the HNN extension is the canonical embedding. -/
theorem magTheta_apply_magBetaMap (t : α) (r : FreeGroup α) (g : FreeGroup (magS t r)) :
    magTheta t r (magBetaMap t r g) = HNNExtension.of g := by
  rw [← MonoidHom.comp_apply, magTheta_comp_magBetaMap]

/-- The Magnus decomposition carries the relator `r` to the image of its Magnus rewriting. -/
theorem magTheta_apply_self (t : α) (r : FreeGroup α) (h : eps t r = 0) :
    magTheta t r r = HNNExtension.of (magW t r) :=
  calc magTheta t r r = magTheta t r (magBetaMap t r (magW t r)) := by rw [magBetaMap_magW t r h]
    _ = HNNExtension.of (magW t r) := magTheta_apply_magBetaMap t r (magW t r)

/-- **The Magnus decomposition of `F α` as an HNN extension.**  `magTheta` and `magLambda` are
mutually inverse. -/
noncomputable def magIso (t : α) (r : FreeGroup α) : FreeGroup α ≃* magHNN t r :=
  MonoidHom.toMulEquiv (magTheta t r) (magLambda t r) (magLambda_comp_magTheta t r)
    (magTheta_comp_magLambda t r)

theorem magIso_apply (t : α) (r : FreeGroup α) (g : FreeGroup α) :
    magIso t r g = magTheta t r g := rfl

theorem magIso_self (t : α) (r : FreeGroup α) (h : eps t r = 0) :
    magIso t r r = HNNExtension.of (magW t r) := by
  rw [magIso_apply]
  exact magTheta_apply_self t r h

/-- The Magnus rewriting of a nontrivial relator is nontrivial. -/
theorem magW_ne_one (t : α) (r : FreeGroup α) (hcyc : IsCyclicallyReducedRelator r)
    (h1 : r ≠ 1) (ht : t ∈ relatorLetters r) (h : eps t r = 0) : magW t r ≠ 1 :=
  mmW_ne_one (mmWL_isReduced t r hcyc h) (mmWL_ne_nil h1 ht h)

/-- The Magnus rewriting of `r` is strictly shorter than `r` whenever the letter `t` occurs. -/
theorem magW_relatorNorm_lt (t : α) (r : FreeGroup α) (ht : t ∈ relatorLetters r) :
    relatorNorm (magW t r) < relatorNorm r :=
  mmW_relatorNorm_lt ht

