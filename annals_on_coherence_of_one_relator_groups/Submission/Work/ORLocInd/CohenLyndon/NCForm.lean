/-
# The Cohen--Lyndon basis theorem: the classical ("`N C_G(r)`") formulation

The classical statement of the Cohen--Lyndon theorem (Cohen--Lyndon 1963, Theorem 4.1; Karrass--
Solitar 1972, Theorem 2; see also Antolín--Dicks--Linnell, *On the local-indicability Cohen--Lyndon
theorem*, arXiv:1002.1934, §2) is:

> if `r ≠ 1` is not a proper power in a free group `F`, then some transversal `T` for the
> `(⟪r⟫·C_F(r))`-action on `F` by right multiplication is such that `{t r t⁻¹ ∣ t ∈ T}` is a
> free basis of `⟪r⟫`.  (Cohen--Lyndon asphericity.)

The *index set* of that transversal is the set of cosets of the subgroup generated by `⟪r⟫` and
`C_G(r)`, i.e. the set `⟪r⟫ · C_G(r)`; this is in general coarser than the set of cosets of `⟪r⟫`,
and the two agree precisely when `C_G(r) ≤ ⟪r⟫`, which is the case for a free group and a
non-proper-power `r` (there `C_F(r) = ⟨r⟩`).  Because the transfer theorems for free products and
HNN extensions are naturally stated for the coarser index set, we record it here as
`CohenLyndonNC`, together with the bridge to the `⟪r⟫`-coset form `Work.CohenLyndon.CohenLyndon`
used in the final assembly.
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.Basic

set_option autoImplicit false
set_option linter.dupNamespace false

universe u

namespace Work.CohenLyndon

variable {G : Type u} [Group G]

/-- **The Cohen--Lyndon basis theorem, classical (`N C_G(r)`-coset) form.**  There is a transversal
`T` of the cosets of the subgroup generated by `⟪r⟫` and `C_G(r)` such that the conjugates
`t r t⁻¹` (`t ∈ T`) form a free basis of the normal closure `⟪r⟫`. -/
def CohenLyndonNC (r : G) : Prop :=
  ∃ T : Set G,
    (∀ g : G,
      ∃! t : G, t ∈ T ∧
        g⁻¹ * t ∈ (Subgroup.normalClosure ({r} : Set G) ⊔ Subgroup.centralizer ({r} : Set G))) ∧
    ∃ e : FreeGroup T ≃* ↥(Subgroup.normalClosure ({r} : Set G)),
      ∀ t : T,
        ((e (FreeGroup.of t) : ↥(Subgroup.normalClosure ({r} : Set G))) : G) = (t : G) * r * (t : G)⁻¹

/-- If the centralizer of `r` is contained in its normal closure, then the classical
(`N C_G(r)`-coset) form of the Cohen--Lyndon theorem is the same as the `⟪r⟫`-coset form. -/
theorem CohenLyndon.ofNC {r : G}
    (hC : Subgroup.centralizer ({r} : Set G) ≤ Subgroup.normalClosure ({r} : Set G))
    (h : CohenLyndonNC r) : CohenLyndon r := by
  obtain ⟨T, hT, e, he⟩ := h
  have hsup : Subgroup.normalClosure ({r} : Set G) ⊔ Subgroup.centralizer ({r} : Set G) =
      Subgroup.normalClosure ({r} : Set G) := sup_eq_left.mpr hC
  refine ⟨T, ?_, e, he⟩
  intro g
  obtain ⟨t, ht, huniq⟩ := hT g
  refine ⟨t, ⟨ht.1, ?_⟩, ?_⟩
  · have hmem : g⁻¹ * t ∈ Subgroup.normalClosure ({r} : Set G) := by
      have h2 := ht.2
      rwa [hsup] at h2
    exact QuotientGroup.eq.mpr (by simpa [mul_inv_rev] using inv_mem hmem)
  · intro y hy
    refine huniq y ⟨hy.1, ?_⟩
    rw [hsup]
    simpa [mul_inv_rev] using inv_mem (QuotientGroup.eq.mp hy.2)

end Work.CohenLyndon
