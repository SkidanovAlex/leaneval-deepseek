/-
# `CohenLyndonNC` is invariant under group isomorphism

`Work.CohenLyndon.CohenLyndonNC r` is the classical (`⟪r⟫·C_G(r)`-coset, i.e. "`N C_G(r)`") form of
the Cohen--Lyndon basis theorem: there is a transversal `T` of the left cosets of
`⟪r⟫ · C_G(r)` such that the conjugates `t * r * t⁻¹` (`t ∈ T`) form a free basis of `⟪r⟫`.

All the data entering this statement is functorial in the pair `(G, r)`: normal closures,
centralizers, cosets, transversals and free bases are all carried by a group isomorphism.  Hence the
property depends only on the isomorphism class of `(G, r)`: for `φ : G ≃* H`,

`CohenLyndonNC r ↔ CohenLyndonNC (φ r)`.

This is what allows the theorem to be proved in the free-group setting and then transported along a
presentation (e.g. an isomorphism `G ≃* F(α)/⟪r⟫`) to an abstract one-relator group.

## The ingredients

* `map_normalClosure_mulEquiv`, `map_centralizer_mulEquiv`, `map_sup_centralizer_mulEquiv`: the normal
  closure and the centralizer of a singleton are carried to those of the image; hence so is
  `⟪r⟫ ⊔ C_G(r)`.
* `transversal_map_mulEquiv`: the image `φ '' T` of a transversal of the cosets of `K` is a
  transversal of the cosets of `K.map φ`.
* `exists_freeBasis_map_mulEquiv`: a free basis `e : FreeGroup T ≃* N` of `N` consisting of the
  conjugates `t r t⁻¹` is carried to a free basis `FreeGroup (φ '' T) ≃* N.map φ` consisting of the
  conjugates `φ t * φ r * (φ t)⁻¹`.
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.NCForm

set_option autoImplicit false
set_option linter.dupNamespace false

universe u

namespace Work.ORLocInd.CohenLyndon

/-! ## Subgroups transported along an isomorphism -/

/-- A group isomorphism carries the normal closure of `r` to the normal closure of `φ r`. -/
lemma map_normalClosure_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H) (r : G) :
    (Subgroup.normalClosure ({r} : Set G)).map φ.toMonoidHom =
      Subgroup.normalClosure ({φ r} : Set H) := by
  rw [Subgroup.map_normalClosure _ _ φ.surjective]
  congr 1
  simp

/-- A group isomorphism carries the centralizer of `r` to the centralizer of `φ r`. -/
lemma map_centralizer_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H) (r : G) :
    (Subgroup.centralizer ({r} : Set G)).map φ.toMonoidHom =
      Subgroup.centralizer ({φ r} : Set H) := by
  ext x
  rw [Subgroup.mem_map]
  simp only [Subgroup.mem_centralizer_iff, Set.mem_singleton_iff, forall_eq]
  constructor
  · rintro ⟨y, hy, rfl⟩
    have h : φ (r * y) = φ (y * r) := by rw [hy]
    simpa using h
  · intro hx
    refine ⟨φ.symm x, ?_, by simp⟩
    have := congrArg φ.symm hx
    simpa using this

/-- A group isomorphism carries the subgroup `⟪r⟫ ⊔ C_G(r)` generated by the normal closure and the
centralizer of `r` to the corresponding subgroup for `φ r`. -/
lemma map_sup_centralizer_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H) (r : G) :
    (Subgroup.normalClosure ({r} : Set G) ⊔
        Subgroup.centralizer ({r} : Set G)).map φ.toMonoidHom =
      Subgroup.normalClosure ({φ r} : Set H) ⊔
        Subgroup.centralizer ({φ r} : Set H) := by
  rw [Subgroup.map_sup, map_normalClosure_mulEquiv, map_centralizer_mulEquiv]

/-! ## The two transport steps -/

/-- **Transversals transported along a group isomorphism.**
If `T` meets every left coset of `K ≤ G` exactly once -- written in the form
`∀ g, ∃! t ∈ T, g⁻¹ * t ∈ K` (so that `t ∈ gK`) -- then `φ '' T` meets every left coset of
`K.map φ` exactly once. -/
lemma transversal_map_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H)
    {K : Subgroup G} {T : Set G} (hT : ∀ g : G, ∃! t : G, t ∈ T ∧ g⁻¹ * t ∈ K) :
    ∀ h : H, ∃! s : H, s ∈ φ '' T ∧ h⁻¹ * s ∈ K.map φ.toMonoidHom := by
  intro h
  obtain ⟨t, ht, huniq⟩ := hT (φ.symm h)
  refine ⟨φ t, ⟨Set.mem_image_of_mem _ ht.1, ?_⟩, ?_⟩
  · rw [Subgroup.mem_map]
    exact ⟨(φ.symm h)⁻¹ * t, ht.2, by simp⟩
  · rintro s ⟨hs, hsK⟩
    obtain ⟨t', ht'T, rfl⟩ := hs
    have hmem : (φ.symm h)⁻¹ * t' ∈ K := by
      rw [Subgroup.mem_map] at hsK
      obtain ⟨y, hy, hyeq⟩ := hsK
      have : y = (φ.symm h)⁻¹ * t' := by
        have := congrArg φ.symm hyeq
        simpa using this
      rwa [this] at hy
    have : t' = t := huniq t' ⟨ht'T, hmem⟩
    rw [this]

/-- **Free bases of conjugates transported along a group isomorphism.**
Let `T ⊆ G`, let `N ≤ G` and let `e : FreeGroup T ≃* N` send the generator `t` to the conjugate
`t r t⁻¹`.  Then the image `φ '' T` freely generates `N.map φ` with generators
`φ t * φ r * (φ t)⁻¹`. -/
lemma exists_freeBasis_map_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H)
    (T : Set G) (r : G) (N : Subgroup G) (e : FreeGroup T ≃* ↥N)
    (he : ∀ t : T, ((e (FreeGroup.of t) : ↥N) : G) = (t : G) * r * (t : G)⁻¹) :
    ∃ e' : FreeGroup (φ '' T) ≃* ↥(N.map φ.toMonoidHom),
      ∀ s : ↥(φ '' T),
        ((e' (FreeGroup.of s) : ↥(N.map φ.toMonoidHom)) : H) = (s : H) * (φ r) * (s : H)⁻¹ := by
  have hφinj : Function.Injective ⇑(φ.toMonoidHom : G →* H) := φ.injective
  let Ψ : T ≃ ↥(φ '' T) := Equiv.Set.image (⇑φ) T φ.injective
  refine ⟨(FreeGroup.freeGroupCongr Ψ.symm).trans
    (e.trans (Subgroup.equivMapOfInjective N (φ.toMonoidHom) hφinj)), ?_⟩
  intro s
  have hval : ((FreeGroup.freeGroupCongr Ψ.symm).trans
      (e.trans (Subgroup.equivMapOfInjective N (φ.toMonoidHom) hφinj)))
      (FreeGroup.of s)
      = (Subgroup.equivMapOfInjective N (φ.toMonoidHom) hφinj)
          (e (FreeGroup.of (Ψ.symm s))) := by
    rw [MulEquiv.trans_apply, FreeGroup.freeGroupCongr_apply, FreeGroup.map.of,
      MulEquiv.trans_apply]
  rw [hval, Subgroup.coe_equivMapOfInjective_apply, he (Ψ.symm s)]
  have hΨ : φ ((Ψ.symm s : T) : G) = (s : H) :=
    congrArg Subtype.val (Ψ.right_inv s)
  simp only [MulEquiv.coe_toMonoidHom, map_mul, map_inv, hΨ]

/-! ## The invariance of `CohenLyndonNC` -/

/-- **`CohenLyndonNC` is carried forward along a group isomorphism.** -/
lemma cohenLyndonNC_map_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H) (r : G) :
    Work.CohenLyndon.CohenLyndonNC r → Work.CohenLyndon.CohenLyndonNC (φ r) := by
  intro h
  obtain ⟨T, hT, e, he⟩ := h
  have hN : (Subgroup.normalClosure ({r} : Set G)).map φ.toMonoidHom =
      Subgroup.normalClosure ({φ r} : Set H) := map_normalClosure_mulEquiv φ r
  have hK := map_sup_centralizer_mulEquiv φ r
  refine ⟨φ '' T, ?_, ?_⟩
  · intro y
    have htrans := transversal_map_mulEquiv (φ := φ)
      (K := Subgroup.normalClosure ({r} : Set G) ⊔ Subgroup.centralizer ({r} : Set G))
      (T := T) hT y
    rwa [hK] at htrans
  · obtain ⟨e', he'⟩ := exists_freeBasis_map_mulEquiv (φ := φ) T r
      (Subgroup.normalClosure ({r} : Set G)) e he
    rw [← hN]
    exact ⟨e', he'⟩

/-- **Transport of a relator along a group isomorphism.**  `CohenLyndonNC` depends only on the
isomorphism class of the pair `(G, r)`: for any group isomorphism `φ : G ≃* H`, the relator `r` has
the Cohen--Lyndon property in `G` iff its image `φ r` has it in `H`. -/
theorem cohenLyndonNC_mulEquiv {G H : Type u} [Group G] [Group H] (φ : G ≃* H) (r : G) :
    Work.CohenLyndon.CohenLyndonNC r ↔ Work.CohenLyndon.CohenLyndonNC (φ r) := by
  constructor
  · exact cohenLyndonNC_map_mulEquiv φ r
  · intro h
    have h' := cohenLyndonNC_map_mulEquiv φ.symm (φ r) h
    rwa [MulEquiv.symm_apply_apply] at h'

end Work.ORLocInd.CohenLyndon
