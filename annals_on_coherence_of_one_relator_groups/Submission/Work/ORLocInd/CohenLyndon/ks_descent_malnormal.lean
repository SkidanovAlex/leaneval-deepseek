/-
# Karrass--Solitar: Cohen--Lyndon passes down to a malnormal subgroup

This file proves `Work.ORLocInd.CohenLyndon.ks_descent_malnormal`: the downward transfer of the
Cohen--Lyndon property along a subgroup `K ≤ G` with `⟨r⟩` malnormal relative to `K`
(Karrass--Solitar 1972, Corollary of Theorem 1; Putnam, *One-relator groups*, Case 2).

## Outline

Write `N := ⟪r⟫_G ⊆ G`, `C := C_G(r)`, `H := N ⊔ C`, and let `(T, e)` be the Cohen--Lyndon datum
for `r` in `G`: `T` is a transversal of the cosets of `H` and `e : FreeGroup T ≃* N` sends the
generator `t` to `t r t⁻¹`.

1. *Structure of the conjugates of `r`.*  For every `g : G` there is `u ∈ N` with
   `g r g⁻¹ = u (τ g) r (τ g)⁻¹ u⁻¹`, where `τ g ∈ T` indexes the coset `gH`.
2. *Transport to the free product.*  `F := FreeGroup T` is the free product of the cyclic groups
   generated by its generators, so `N ≅ P := CoprodI (fun _ : T => FreeGroup (ULift PUnit))`, and
   `P` acts on its Bass--Serre "star" tree (`Work.ORLocInd.CoprodTree`) with trivial edge
   stabilisers and vertex stabilisers the conjugates of the factors.  The image
   `Γ := ψ(⟪r⟫_K) ≤ P` is generated by its vertex stabilisers.
3. *The malnormality input.*  If a vertex on the leaf of a factor has non-trivial `Γ`-stabiliser,
   then the generator of that cyclic conjugate factor already lies in `Γ`; malnormality of `⟨r⟩`
   relative to `K` identifies it with the image of a `K`-conjugate `k r k⁻¹`, and the vertices
   arising this way are exactly the vertices fixed by the conjugates `t r t⁻¹` for `t` in a
   transversal `T'` of `K/(⟪r⟫_K ⊔ C_K(r))`, pairwise in distinct `Γ`-orbits.
4. The Bass--Serre/Kurosh theorem `fpVertexStab` then exhibits `Γ` as the free product of the
   groups `⟨t r t⁻¹⟩` (`t ∈ T'`), which is precisely the Cohen--Lyndon datum for `r` in `K`.
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.NCForm
import Submission.Work.ORLocInd.CohenLyndon.cohenLyndonNC_conj
import Submission.Work.ORLocInd.CoprodTree.StarTreeIsTree
import Submission.Work.ORLocInd.CohenLyndon.coprod_malnormal
import Submission.Work.ORLocInd.CoprodTree.StarTreeDefs
import Submission.Work.ORBassSerre.Interface
import Submission.Work.ORLocInd.CohenLyndon.freeGroup_equiv_coprodI
import Submission.Work.ORBassSerre.Action.CoprodI.coprodI_congr
import Submission.Work.ORLocInd.CohenLyndon.kurosh_subgroup_coprodI

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

universe u

namespace Work.ORLocInd.CohenLyndon

variable {G : Type u} [Group G]

/-! ## The transversal defining the Cohen--Lyndon datum -/

section Transversal

variable {N C : Subgroup G} {T : Set G}

/-- The representative in `T` of the coset of `g`: the unique `t ∈ T` with `g⁻¹ * t ∈ N ⊔ C`. -/
noncomputable def tIdx (hT : ∀ g : G, ∃! t : G, t ∈ T ∧ g⁻¹ * t ∈ N ⊔ C) (g : G) : G :=
  (hT g).choose

theorem tIdx_mem (hT : ∀ g : G, ∃! t : G, t ∈ T ∧ g⁻¹ * t ∈ N ⊔ C) (g : G) :
    tIdx hT g ∈ T :=
  ((hT g).choose_spec).1.1

theorem tIdx_spec (hT : ∀ g : G, ∃! t : G, t ∈ T ∧ g⁻¹ * t ∈ N ⊔ C) (g : G) :
    g⁻¹ * tIdx hT g ∈ N ⊔ C :=
  ((hT g).choose_spec).1.2

theorem tIdx_eq (hT : ∀ g : G, ∃! t : G, t ∈ T ∧ g⁻¹ * t ∈ N ⊔ C) {g t : G}
    (ht : t ∈ T) (h : g⁻¹ * t ∈ N ⊔ C) : t = tIdx hT g :=
  ((hT g).choose_spec).2 t ⟨ht, h⟩

/-- **Structure of the conjugates of `r`.**  Every `G`-conjugate of `r` is `N`-conjugate to the
"transversal conjugate" `τ g · r · (τ g)⁻¹` of the coset of `g`. -/
theorem exists_conj_eq_tIdx {N C : Subgroup G} (r : G) (hN : N.Normal)
    (hC : C ≤ Subgroup.centralizer ({r} : Set G)) {T : Set G}
    (hT : ∀ g : G, ∃! t : G, t ∈ T ∧ g⁻¹ * t ∈ N ⊔ C) (g : G) :
    ∃ u ∈ N, g * r * g⁻¹ = u * (tIdx hT g * r * (tIdx hT g)⁻¹) * u⁻¹ := by
  obtain ⟨n, hn, c, hc, hnc⟩ := Subgroup.mem_sup_of_normal_left.mp (tIdx_spec hT g)
  have hcomm : c * r = r * c :=
    ((Subgroup.mem_centralizer_iff.mp (hC hc)) r (Set.mem_singleton r)).symm
  have hg : g = tIdx hT g * c⁻¹ * n⁻¹ := by
    have h2 : g * (n * c) = tIdx hT g := by rw [hnc]; group
    calc g = g * (n * c) * (n * c)⁻¹ := by group
      _ = tIdx hT g * (n * c)⁻¹ := by rw [h2]
      _ = tIdx hT g * c⁻¹ * n⁻¹ := by group
  refine ⟨tIdx hT g * c⁻¹ * n⁻¹ * c * (tIdx hT g)⁻¹,
    by
      simpa [mul_assoc] using hN.conj_mem (c⁻¹ * n⁻¹ * c)
        (by simpa using hN.conj_mem (n⁻¹) (N.inv_mem hn) c⁻¹) (tIdx hT g), ?_⟩
  have hcr' : c * r * c⁻¹ = r := by
    calc c * r * c⁻¹ = (r * c) * c⁻¹ := by rw [hcomm]
      _ = r := by group
  have hmid : c⁻¹ * n⁻¹ * r * n * c = c⁻¹ * n⁻¹ * c * r * c⁻¹ * n * c := by
    conv_lhs => rw [← hcr']
    group
  conv_lhs => rw [hg]
  rw [show (tIdx hT g * c⁻¹ * n⁻¹) * r * (tIdx hT g * c⁻¹ * n⁻¹)⁻¹
      = tIdx hT g * (c⁻¹ * n⁻¹ * r * n * c) * (tIdx hT g)⁻¹ from by group]
  rw [hmid]
  group

end Transversal

/-! ## Two elementary facts about normal closures and images of closures -/

/-- The normal closure of a singleton is the closure of the set of its conjugates. -/
theorem normalClosure_singleton_eq_closure_conj {H : Type u} [Group H] (x : H) :
    Subgroup.normalClosure ({x} : Set H) =
      Subgroup.closure (Set.range (fun k : H => k * x * k⁻¹)) := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.normalClosure, Subgroup.closure_le]
    intro y hy
    rcases Group.mem_conjugatesOfSet_iff.mp hy with ⟨a, ha, hconj⟩
    rw [Set.mem_singleton_iff] at ha
    subst ha
    obtain ⟨c, hc⟩ := isConj_iff.mp hconj
    exact Subgroup.subset_closure ⟨c, hc⟩
  · rw [Subgroup.closure_le]
    rintro y ⟨k, rfl⟩
    exact Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) x
      (Subgroup.subset_normalClosure (Set.mem_singleton x)) k

/-- The image of a closure is the closure of the image. -/
theorem map_closure_eq {H H' : Type u} [Group H] [Group H'] (f : H →* H') (S : Set H) :
    (Subgroup.closure S).map f = Subgroup.closure (f '' S) := by
  refine le_antisymm ?_ ?_
  · refine Subgroup.map_le_iff_le_comap.mpr ?_
    rw [Subgroup.closure_le]
    rintro y hy
    exact Subgroup.subset_closure ⟨y, hy, rfl⟩
  · rw [Subgroup.closure_le]
    rintro y ⟨x, hx, rfl⟩
    exact Subgroup.mem_map_of_mem f (Subgroup.subset_closure hx)

/-! ## The free-product model of `⟪r⟫_G` -/

/-- The family of factors of the free-product model of `FreeGroup T`: one infinite cyclic group
for each generator. -/
abbrev FFac (T : Set G) : T → Type u := fun _ => FreeGroup (ULift.{u, 0} PUnit)

/-- The canonical equivalence `T ≃ Σ _ : T, ULift PUnit`. -/
def sigmaEquiv (T : Set G) : T ≃ Sigma (fun _ : T => ULift.{u, 0} PUnit) where
  toFun t := ⟨t, ULift.up PUnit.unit⟩
  invFun x := x.1
  left_inv _ := rfl
  right_inv x := by obtain ⟨t, u⟩ := x; cases u; rfl

/-- **`FreeGroup T` is the free product of the cyclic groups generated by its generators.** -/
noncomputable def kappa (T : Set G) : FreeGroup T ≃* Monoid.CoprodI (FFac T) :=
  Classical.choose (freeGroup_equiv_coprodI (X := fun _ : T => ULift.{u, 0} PUnit)
    (e := sigmaEquiv T))

theorem kappa_of (T : Set G) (t : T) :
    kappa T (FreeGroup.of t) =
      Monoid.CoprodI.of (i := t) (FreeGroup.of (ULift.up PUnit.unit)) :=
  (Classical.choose_spec (freeGroup_equiv_coprodI (X := fun _ : T => ULift.{u, 0} PUnit)
    (e := sigmaEquiv T))) t

/-- The generator of the `t`-th factor of the free-product model. -/
def Xgen (T : Set G) (t : T) : Monoid.CoprodI (FFac T) :=
  Monoid.CoprodI.of (i := t) (FreeGroup.of (ULift.up PUnit.unit))

theorem Xgen_eq_kappa (T : Set G) (t : T) : Xgen T t = kappa T (FreeGroup.of t) :=
  (kappa_of T t).symm

/-! ## The Cohen--Lyndon datum and the transport of the conjugates -/

section Datum

variable {K : Subgroup G} {r : K} {T : Set G}

/-- The Cohen--Lyndon datum for `r` in `G`. -/
structure CLData (r : G) (T : Set G) where
  /-- the transversal condition -/
  trans : ∀ g : G, ∃! t : G,
    t ∈ T ∧ g⁻¹ * t ∈ Subgroup.normalClosure ({r} : Set G) ⊔ Subgroup.centralizer ({r} : Set G)
  /-- the free-basis isomorphism -/
  e : FreeGroup T ≃* ↥(Subgroup.normalClosure ({r} : Set G))
  /-- it sends the generator `t` to the conjugate `t r t⁻¹` -/
  he : ∀ t : T, ((e (FreeGroup.of t) : ↥(Subgroup.normalClosure ({r} : Set G))) : G) =
    (t : G) * r * (t : G)⁻¹

/-- The transport of `⟪r⟫_G` to the free-product model. -/
noncomputable def cPsi {r : G} {T : Set G} (D : CLData (r : G) T) :
    ↥(Subgroup.normalClosure ({(r : G)} : Set G)) ≃* Monoid.CoprodI (FFac T) :=
  D.e.symm.trans (kappa T)

/-- `g r g⁻¹` lies in the normal closure of `r`. -/
theorem cmemConj (g : G) : g * (r : G) * g⁻¹ ∈ Subgroup.normalClosure ({(r : G)} : Set G) :=
  Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) (r : G)
    (Subgroup.subset_normalClosure (Set.mem_singleton (r : G))) g

/-- The transversal representative of the coset of `g`, as an element of the subtype `T`. -/
noncomputable def ctRep (D : CLData (r : G) T) (g : G) : T :=
  ⟨tIdx D.trans g, tIdx_mem D.trans g⟩

theorem ctRep_coe (D : CLData (r : G) T) (g : G) :
    ((ctRep D g : T) : G) = tIdx D.trans g := rfl

/-- The element of the free-product model corresponding to the conjugate `g r g⁻¹`. -/
noncomputable def cZel (D : CLData (r : G) T) (g : G) : Monoid.CoprodI (FFac T) :=
  cPsi D ⟨g * (r : G) * g⁻¹, cmemConj (r := r) g⟩

theorem cmem_tIdx_conj (D : CLData (r : G) T) (g : G) :
    tIdx D.trans g * (r : G) * (tIdx D.trans g)⁻¹ ∈
      Subgroup.normalClosure ({(r : G)} : Set G) :=
  Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) (r : G)
    (Subgroup.subset_normalClosure (Set.mem_singleton (r : G))) (tIdx D.trans g)

theorem cexists_conj_eq (D : CLData (r : G) T) (g : G) :
    ∃ v ∈ Subgroup.normalClosure ({(r : G)} : Set G),
      g * (r : G) * g⁻¹ = v * (tIdx D.trans g * (r : G) * (tIdx D.trans g)⁻¹) * v⁻¹ :=
  exists_conj_eq_tIdx (r : G) (Subgroup.normalClosure_normal) (le_refl _) D.trans g

/-- The element `u ∈ ⟪r⟫_G` with `g r g⁻¹ = u (τ g) r (τ g)⁻¹ u⁻¹`. -/
noncomputable def cUel (D : CLData (r : G) T) (g : G) :
    ↥(Subgroup.normalClosure ({(r : G)} : Set G)) :=
  ⟨(cexists_conj_eq D g).choose, (cexists_conj_eq D g).choose_spec.1⟩

theorem cUel_spec (D : CLData (r : G) T) (g : G) : g * (r : G) * g⁻¹ =
    (cUel D g : G) * (tIdx D.trans g * (r : G) * (tIdx D.trans g)⁻¹) * (cUel D g : G)⁻¹ :=
  (cexists_conj_eq D g).choose_spec.2

theorem cPsi_e_of (D : CLData (r : G) T) (t : T) : cPsi D (D.e (FreeGroup.of t)) = Xgen T t := by
  rw [cPsi, MulEquiv.trans_apply, MulEquiv.symm_apply_apply, Xgen_eq_kappa]

/-- **The conjugates of `r`, as conjugates of the generators of the free-product model.** -/
theorem cZel_eq (D : CLData (r : G) T) (g : G) :
    cZel D g = cPsi D (cUel D g) * Xgen T (ctRep D g) * (cPsi D (cUel D g))⁻¹ := by
  have hkey : (⟨g * (r : G) * g⁻¹, cmemConj (r := r) g⟩ :
      ↥(Subgroup.normalClosure ({(r : G)} : Set G))) =
      cUel D g * ⟨tIdx D.trans g * (r : G) * (tIdx D.trans g)⁻¹, cmem_tIdx_conj D g⟩ *
        (cUel D g)⁻¹ :=
    Subtype.ext (cUel_spec D g)
  have hgen : (⟨tIdx D.trans g * (r : G) * (tIdx D.trans g)⁻¹, cmem_tIdx_conj D g⟩ :
      ↥(Subgroup.normalClosure ({(r : G)} : Set G))) = D.e (FreeGroup.of (ctRep D g)) :=
    Subtype.ext (by
      show tIdx D.trans g * (r : G) * (tIdx D.trans g)⁻¹ = ((D.e (FreeGroup.of (ctRep D g))) : G)
      rw [← ctRep_coe]
      exact (D.he (ctRep D g)).symm)
  show cPsi D ⟨g * (r : G) * g⁻¹, cmemConj (r := r) g⟩ = _
  rw [hkey, map_mul, map_mul, map_inv, hgen, cPsi_e_of]

/-! ## The image of `⟪r⟫_K` in the free-product model -/

/-- The image of `⟪r⟫_K` in `G`. -/
noncomputable def cNKmap : Subgroup G :=
  Subgroup.map (K.subtype) (Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))

theorem chNK : cNKmap (r := r) ≤ Subgroup.normalClosure ({(r : G)} : Set G) := by
  rw [cNKmap, Subgroup.map_le_iff_le_comap]
  haveI : ((Subgroup.normalClosure ({(r : G)} : Set G)).comap K.subtype).Normal :=
    Subgroup.Normal.comap Subgroup.normalClosure_normal K.subtype
  refine Subgroup.normalClosure_le_normal ?_
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  rw [hx]
  exact Subgroup.subset_normalClosure (Set.mem_singleton (r : G))

/-- The generator of `⟪r⟫_K` corresponding to the conjugate by `k`. -/
noncomputable def cGk (k : ↥K) : ↥(cNKmap (r := r)) :=
  ⟨(k : G) * (r : G) * (k : G)⁻¹, Subgroup.mem_map_of_mem K.subtype
    (Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) r
      (Subgroup.subset_normalClosure (Set.mem_singleton r)) k)⟩

/-- The image of `⟪r⟫_K` in the free-product model. -/
noncomputable def cGamImg (D : CLData (r : G) T) : Subgroup (Monoid.CoprodI (FFac T)) :=
  Subgroup.map ((cPsi D).toMonoidHom.comp (Subgroup.inclusion (chNK (r := r)))) ⊤

theorem cPhi_cGk (D : CLData (r : G) T) (k : ↥K) :
    (cPsi D) (Subgroup.inclusion (chNK (r := r)) (cGk (r := r) k)) = cZel D (k : G) :=
  congrArg (cPsi D) (Subtype.ext rfl)

/-- **The image of `⟪r⟫_K` is generated by the images of the conjugates of `r` by `K`.** -/
theorem cGamImg_eq_closure (D : CLData (r : G) T) :
    cGamImg D = Subgroup.closure (Set.range (fun k : ↥K => cZel D (k : G))) := by
  have hN : Subgroup.normalClosure ({(r : ↥K)} : Set ↥K) =
      Subgroup.closure (Set.range (fun k : ↥K => k * r * k⁻¹)) :=
    normalClosure_singleton_eq_closure_conj r
  have himg : cNKmap (r := r) =
      Subgroup.closure (Set.range (fun k : ↥K => (k : G) * (r : G) * (k : G)⁻¹)) := by
    rw [cNKmap, hN, map_closure_eq]
    congr 1
    ext y
    constructor
    · rintro ⟨z, ⟨k, rfl⟩, rfl⟩
      exact ⟨k, rfl⟩
    · rintro ⟨k, rfl⟩
      exact ⟨(k * r * k⁻¹ : ↥K), ⟨k, rfl⟩, rfl⟩
  -- every element of `↥cNKmap` is a product of the `cGk`
  have hgen : ∀ q : ↥(cNKmap (r := r)), q ∈ Subgroup.closure (Set.range (cGk (r := r))) := by
    intro q
    have h1 : (q : G) ∈ Subgroup.map (Subgroup.subtype (cNKmap (r := r)))
        (Subgroup.closure (Set.range (cGk (r := r)))) := by
      rw [map_closure_eq]
      have hset : (Subgroup.subtype (cNKmap (r := r))) '' Set.range (cGk (r := r)) =
          Set.range (fun k : ↥K => (k : G) * (r : G) * (k : G)⁻¹) := by
        ext y
        constructor
        · rintro ⟨z, ⟨k, rfl⟩, rfl⟩
          exact ⟨k, rfl⟩
        · rintro ⟨k, rfl⟩
          exact ⟨cGk (r := r) k, ⟨k, rfl⟩, rfl⟩
      rw [hset, ← himg]
      exact q.2
    obtain ⟨m, hm, hmq⟩ := Subgroup.mem_map.mp h1
    have hmq' : m = q := Subtype.ext hmq
    rwa [hmq'] at hm
  refine le_antisymm ?_ ?_
  · rw [cGamImg, Subgroup.map_le_iff_le_comap]
    intro q _
    have hq : q ∈ Subgroup.closure (Set.range (cGk (r := r))) := hgen q
    have h1 : Subgroup.inclusion (chNK (r := r)) q ∈
        Subgroup.closure (Subgroup.inclusion (chNK (r := r)) '' Set.range (cGk (r := r))) := by
      have hmem := Subgroup.mem_map_of_mem (Subgroup.inclusion (chNK (r := r))) hq
      rwa [map_closure_eq] at hmem
    have h2 : (cPsi D) (Subgroup.inclusion (chNK (r := r)) q) ∈
        Subgroup.closure ((cPsi D) '' (Subgroup.inclusion (chNK (r := r)) ''
          Set.range (cGk (r := r)))) := by
      have hmem := Subgroup.mem_map_of_mem (cPsi D).toMonoidHom h1
      rwa [map_closure_eq] at hmem
    refine Subgroup.closure_mono ?_ h2
    rintro y ⟨z, hz, rfl⟩
    obtain ⟨w, hw, rfl⟩ := hz
    obtain ⟨k, rfl⟩ := hw
    exact ⟨k, (cPhi_cGk D k).symm⟩
  · rw [Subgroup.closure_le]
    rintro y ⟨k, rfl⟩
    exact ⟨cGk (r := r) k, Subgroup.mem_top _, cPhi_cGk D k⟩

/-- The subgroup used for the Bass--Serre/Kurosh theorem. -/
noncomputable def cGam (D : CLData (r : G) T) : Subgroup (Monoid.CoprodI (FFac T)) :=
  Subgroup.closure (Set.range (fun k : ↥K => cZel D (k : G)))

theorem cGam_eq_cGamImg (D : CLData (r : G) T) : cGam D = cGamImg D :=
  (cGamImg_eq_closure D).symm

/-! ## The star tree of the free product -/

/-- The vertex fixed by the conjugate `g r g⁻¹`. -/
noncomputable def cVg (D : CLData (r : G) T) (g : G) :
    Work.ORLocInd.CoprodTree.Vertex (FFac T) :=
  Work.ORLocInd.CoprodTree.vtx (some (ctRep D g)) (cPsi D (cUel D g))

theorem Xgen_mem_factor (t : T) :
    Xgen T t ∈ Work.ORLocInd.CoprodTree.factor (FFac T) t :=
  ⟨FreeGroup.of (ULift.up PUnit.unit), rfl⟩

theorem factor_eq_zpowers (t : T) :
    Work.ORLocInd.CoprodTree.factor (FFac T) t = Subgroup.zpowers (Xgen T t) := by
  have h1 : Subgroup.closure ({FreeGroup.of (ULift.up PUnit.unit)} : Set (FFac T t)) = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← FreeGroup.closure_range_of (ULift PUnit), Subgroup.closure_le]
    intro x hx
    obtain ⟨u, rfl⟩ := hx
    cases u
    exact Subgroup.subset_closure (Set.mem_singleton _)
  rw [Work.ORLocInd.CoprodTree.factor, MonoidHom.range_eq_map, ← h1, map_closure_eq,
    Subgroup.zpowers_eq_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact Set.mem_singleton _
  · intro hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact ⟨_, Set.mem_singleton _, rfl⟩

theorem cZel_mem_stab (D : CLData (r : G) T) (g : G) :
    cZel D g ∈ MulAction.stabilizer (Monoid.CoprodI (FFac T)) (cVg D g) := by
  rw [cVg, Work.ORLocInd.CoprodTree.stabilizer_coset]
  have hmem : (MulAut.conj (cPsi D (cUel D g))) (Xgen T (ctRep D g)) = cZel D g := by
    rw [MulAut.conj_apply]
    exact (cZel_eq D g).symm
  exact Subgroup.mem_map.mpr ⟨Xgen T (ctRep D g), Xgen_mem_factor (ctRep D g), hmem⟩

theorem cZel_fixes_cVg (D : CLData (r : G) T) (g : G) : cZel D g • cVg D g = cVg D g :=
  MulAction.mem_stabilizer_iff.mp (cZel_mem_stab D g)

theorem cZel_mem_cGam (D : CLData (r : G) T) (k : ↥K) : cZel D (k : G) ∈ cGam D :=
  Subgroup.subset_closure (Set.mem_range_self k)

noncomputable instance instMulActionCGam (D : CLData (r : G) T) :
    MulAction (cGam D) (Work.ORLocInd.CoprodTree.Vertex (FFac T)) :=
  MulAction.compHom _ (cGam D).subtype

noncomputable instance instGraphActionCGam (D : CLData (r : G) T) :
    Work.ORBassSerre.GraphAction (cGam D) (Work.ORLocInd.CoprodTree.Vertex (FFac T)) :=
  Work.ORBassSerre.graphActionSubgroup (cGam D)

theorem cZel_mem_stabGam (D : CLData (r : G) T) (k : ↥K) :
    (⟨cZel D (k : G), cZel_mem_cGam D k⟩ : ↥(cGam D)) ∈
      MulAction.stabilizer ↥(cGam D) (cVg D (k : G)) :=
  cZel_fixes_cVg D (k : G)

/-! ## The tree facts for the `Γ`-action -/

theorem cIsTree : Work.ORBassSerre.IsTree (Work.ORLocInd.CoprodTree.Vertex (FFac T)) :=
  Work.ORLocInd.CoprodTree.starTree_isTree

theorem cActsWithoutInversions (D : CLData (r : G) T) :
    Work.ORBassSerre.ActsWithoutInversions (cGam D)
      (Work.ORLocInd.CoprodTree.Vertex (FFac T)) :=
  fun _ e he => Work.ORLocInd.CoprodTree.actsWithoutInversions _ _ he

theorem cEdgeStab (D : CLData (r : G) T)
    (e : Quiver.Total (Work.ORLocInd.CoprodTree.Vertex (FFac T))) :
    MulAction.stabilizer (cGam D) e = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  haveI : Subsingleton (MulAction.stabilizer (Monoid.CoprodI (FFac T)) e) :=
    Work.ORLocInd.CoprodTree.subsingleton_stabilizer_edge e
  have h2 : ((x : ↥(cGam D)) : Monoid.CoprodI (FFac T)) = 1 := by
    have h1 : ((x : ↥(cGam D)) : Monoid.CoprodI (FFac T)) ∈
        MulAction.stabilizer (Monoid.CoprodI (FFac T)) e := hx
    have h3 : (1 : Monoid.CoprodI (FFac T)) ∈ MulAction.stabilizer (Monoid.CoprodI (FFac T)) e :=
      Subgroup.one_mem _
    exact congrArg Subtype.val (Subsingleton.elim
      (⟨((x : ↥(cGam D)) : Monoid.CoprodI (FFac T)), h1⟩ :
        ↥(MulAction.stabilizer (Monoid.CoprodI (FFac T)) e)) ⟨1, h3⟩)
  exact Subtype.ext h2

/-- The conjugate of the cyclic factor, as a cyclic subgroup. -/
theorem cConj_zpowers (D : CLData (r : G) T) (k : ↥K) :
    Subgroup.map (MulEquiv.toMonoidHom (MulAut.conj (cPsi D (cUel D (k : G)))))
        (Subgroup.zpowers (Xgen T (ctRep D (k : G)))) =
      Subgroup.zpowers (cZel D (k : G)) := by
  rw [Subgroup.zpowers_eq_closure, map_closure_eq, Subgroup.zpowers_eq_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact (cZel_eq D (k : G)).symm
  · intro hy
    rw [Set.mem_singleton_iff] at hy
    refine ⟨Xgen T (ctRep D (k : G)), Set.mem_singleton _, ?_⟩
    rw [hy]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact (cZel_eq D (k : G)).symm

/-- The `Γ`-stabiliser of the vertex fixed by `t r t⁻¹` is generated by `t r t⁻¹`. -/
theorem cStab_cVg (D : CLData (r : G) T) (k : ↥K) :
    MulAction.stabilizer (cGam D) (cVg D (k : G)) =
      Subgroup.zpowers ⟨cZel D (k : G), cZel_mem_cGam D k⟩ := by
  ext x
  rw [MulAction.mem_stabilizer_iff]
  constructor
  · intro hx
    have hx' : ((x : ↥(cGam D)) : Monoid.CoprodI (FFac T)) ∈
        Subgroup.zpowers (cZel D (k : G)) := by
      have h1 : ((x : ↥(cGam D)) : Monoid.CoprodI (FFac T)) ∈
          MulAction.stabilizer (Monoid.CoprodI (FFac T)) (cVg D (k : G)) := hx
      rw [cVg, Work.ORLocInd.CoprodTree.stabilizer_coset, factor_eq_zpowers,
        cConj_zpowers] at h1
      exact h1
    rw [Subgroup.mem_zpowers_iff] at hx' ⊢
    obtain ⟨n, hn⟩ := hx'
    exact ⟨n, Subtype.ext hn⟩
  · intro hx
    rw [Subgroup.mem_zpowers_iff] at hx
    obtain ⟨n, rfl⟩ := hx
    have hle : Subgroup.zpowers (⟨cZel D (k : G), cZel_mem_cGam D k⟩ : ↥(cGam D)) ≤
        MulAction.stabilizer ↥(cGam D) (cVg D (k : G)) :=
      Subgroup.zpowers_le.mpr (cZel_mem_stabGam D k)
    exact MulAction.mem_stabilizer_iff.mp (hle (Subgroup.zpow_mem_zpowers _ n))


/-! ## Non-triviality of the conjugates and uniqueness of their fixed vertex -/

theorem Xgen_ne_one (T : Set G) (t : T) : Xgen T t ≠ 1 := by
  intro h
  have h1 : FreeGroup.of (ULift.up PUnit.unit) = (1 : FreeGroup (ULift.{u, 0} PUnit)) :=
    Monoid.CoprodI.of_injective (M := FFac T) t (by rw [map_one]; exact h)
  have h2 : Multiplicative.ofAdd (1 : ℤ) = 1 := by
    have := congrArg (⇑(FreeGroup.lift (fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ)))) h1
    simpa using this
  have h3 : Multiplicative.ofAdd (1 : ℤ) = Multiplicative.ofAdd 0 := by simpa using h2
  exact one_ne_zero (Multiplicative.ofAdd.injective h3)

theorem cZel_ne_one (D : CLData (r : G) T) (g : G) : cZel D g ≠ 1 := by
  intro h
  have h3 := cZel_eq D g
  rw [h] at h3
  have h4 := congrArg (fun z => (cPsi D (cUel D g))⁻¹ * z * cPsi D (cUel D g)) h3
  have h5 : Xgen T (ctRep D g) = 1 := by simpa [mul_assoc] using h4.symm
  exact Xgen_ne_one T (ctRep D g) h5

theorem cP_edgeStab (e : Quiver.Total (Work.ORLocInd.CoprodTree.Vertex (FFac T))) :
    MulAction.stabilizer (Monoid.CoprodI (FFac T)) e = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  haveI := Work.ORLocInd.CoprodTree.subsingleton_stabilizer_edge (M := FFac T) e
  exact congrArg Subtype.val (Subsingleton.elim
    (⟨x, hx⟩ : ↥(MulAction.stabilizer (Monoid.CoprodI (FFac T)) e)) ⟨1, Subgroup.one_mem _⟩)

/-- The action on `Quiver.Total V`, spelled out on `Total.mk`. -/
theorem total_mk_smulArrow' {Γ : Type u} {V : Type u} [Group Γ] [Quiver V]
    [Quiver.HasInvolutiveReverse V] [MulAction Γ V] [Work.ORBassSerre.GraphAction Γ V]
    (g : Γ) {a b : V} (e : a ⟶ b) :
    g • Quiver.Total.mk a b e =
      Quiver.Total.mk (g • a) (g • b) (Work.ORBassSerre.GraphAction.smulArrow g e) := by
  refine Quiver.Total.ext ?_ ?_ ?_
  · simpa using Work.ORBassSerre.GraphAction.smul_left g (Quiver.Total.mk a b e)
  · simpa using Work.ORBassSerre.GraphAction.smul_right g (Quiver.Total.mk a b e)
  · exact (Work.ORBassSerre.GraphAction.smulArrow_heq g e).symm

/-- **An element `≠ 1` fixes at most one vertex of the star tree.** -/
theorem cZel_fixed_unique (D : CLData (r : G) T) (g : G)
    {v : Work.ORLocInd.CoprodTree.Vertex (FFac T)} (hv : cZel D g • v = v) : v = cVg D g := by
  by_contra hne
  have hlen : 0 < (cIsTree.geodesic v (cVg D g)).length := by
    rcases Nat.eq_zero_or_pos (cIsTree.geodesic v (cVg D g)).length with h0 | hpos
    · exact absurd (Quiver.Path.eq_of_length_zero _ h0) hne
    · exact hpos
  obtain ⟨p, e, hp, he⟩ := exists_fixed_arrow_of_fixes_two (G := Monoid.CoprodI (FFac T))
    (V := Work.ORLocInd.CoprodTree.Vertex (FFac T)) cIsTree hv (cZel_fixes_cVg D g)
    (cIsTree.geodesic_isReduced v (cVg D g)) hlen
  have htot : cZel D g • Quiver.Total.mk p (cVg D g) e = Quiver.Total.mk p (cVg D g) e := by
    rw [total_mk_smulArrow' (Γ := Monoid.CoprodI (FFac T))
      (V := Work.ORLocInd.CoprodTree.Vertex (FFac T)) (cZel D g) e]
    exact Quiver.Total.ext hp (cZel_fixes_cVg D g)
      ((Quiver.Hom.cast_heq hp (cZel_fixes_cVg D g)
        (Work.ORBassSerre.GraphAction.smulArrow (cZel D g) e)).symm.trans (heq_of_eq he))
  refine cZel_ne_one D g ?_
  have hmem : cZel D g ∈ MulAction.stabilizer (Monoid.CoprodI (FFac T))
      (Quiver.Total.mk p (cVg D g) e) := htot
  rw [cP_edgeStab] at hmem
  simpa using hmem

/-! ## The exponent-sum character: a conjugate of `r` which is a power of `r` -/

/-- `r` as an element of its normal closure. -/
def cR : ↥(Subgroup.normalClosure ({(r : G)} : Set G)) :=
  ⟨(r : G), Subgroup.subset_normalClosure (Set.mem_singleton (r : G))⟩

private theorem zpow_ofAdd_one (j : ℤ) :
    (Multiplicative.ofAdd (1 : ℤ)) ^ j = Multiplicative.ofAdd j := by
  rw [← ofAdd_zsmul j (1 : ℤ)]
  simp

/-- **A conjugate of `r` which is a power of `r` is `r` itself.** -/
theorem cZpow_eq_one (D : CLData (r : G) T) {g : G} {j : ℤ} (hj : j ≠ 0)
    (h : g * (r : G) * g⁻¹ = (r : G) ^ j) :
    j = 1 ∧ g ∈ Subgroup.centralizer ({(r : G)} : Set G) := by
  have h1 : (⟨g * (r : G) * g⁻¹, cmemConj (r := r) g⟩ :
        ↥(Subgroup.normalClosure ({(r : G)} : Set G))) = cR (r := r) ^ j :=
    Subtype.ext h
  classical
  set t₀ : T := ⟨tIdx D.trans (1 : G), tIdx_mem D.trans (1 : G)⟩ with ht₀
  let χF : FreeGroup T →* Multiplicative ℤ :=
    FreeGroup.lift (fun t : T => if t = t₀ then Multiplicative.ofAdd (1 : ℤ) else 1)
  let χ : ↥(Subgroup.normalClosure ({(r : G)} : Set G)) →* Multiplicative ℤ :=
    χF.comp D.e.symm.toMonoidHom
  have hχe : ∀ t : T, χ (D.e (FreeGroup.of t)) =
      (if t = t₀ then Multiplicative.ofAdd (1 : ℤ) else 1) := by
    intro t
    show χF (D.e.symm (D.e (FreeGroup.of t))) = _
    rw [MulEquiv.symm_apply_apply]
    exact FreeGroup.lift_apply_of
  have hχr : χ (cR (r := r)) = Multiplicative.ofAdd (1 : ℤ) := by
    obtain ⟨n, hn, c, hc, hnc⟩ :=
      Subgroup.mem_sup_of_normal_left.mp (tIdx_spec D.trans (1 : G))
    have hcomm : c * (r : G) = (r : G) * c :=
      ((Subgroup.mem_centralizer_iff.mp hc) (r : G) (Set.mem_singleton (r : G))).symm
    have htc : (t₀ : G) = n * c := by rw [ht₀]; simpa using hnc.symm
    have hcr : c * (r : G) * c⁻¹ = (r : G) := by
      calc c * (r : G) * c⁻¹ = ((r : G) * c) * c⁻¹ := by rw [hcomm]
        _ = (r : G) := by group
    have hconj : D.e (FreeGroup.of t₀) =
        (⟨n, hn⟩ : ↥(Subgroup.normalClosure ({(r : G)} : Set G))) * cR (r := r) *
          (⟨n, hn⟩ : ↥(Subgroup.normalClosure ({(r : G)} : Set G)))⁻¹ := by
      apply Subtype.ext
      show ((D.e (FreeGroup.of t₀)) : G) = n * (r : G) * n⁻¹
      rw [D.he t₀, htc,
        show (n * c) * (r : G) * (n * c)⁻¹ = n * (c * (r : G) * c⁻¹) * n⁻¹ from by group, hcr]
    have hA : χ (D.e (FreeGroup.of t₀)) = χ (cR (r := r)) := by
      rw [hconj, map_mul, map_mul, map_inv,
        mul_comm (χ (⟨n, hn⟩ : ↥(Subgroup.normalClosure ({(r : G)} : Set G)))) (χ (cR (r := r))),
        mul_assoc, mul_inv_cancel, mul_one]
    rw [← hA, hχe t₀, if_pos rfl]
  have hχg : χ (⟨g * (r : G) * g⁻¹, cmemConj (r := r) g⟩ :
        ↥(Subgroup.normalClosure ({(r : G)} : Set G))) =
      (if ctRep D g = t₀ then Multiplicative.ofAdd (1 : ℤ) else 1) := by
    have hkey : (⟨g * (r : G) * g⁻¹, cmemConj (r := r) g⟩ :
        ↥(Subgroup.normalClosure ({(r : G)} : Set G))) =
        (cUel D g) * D.e (FreeGroup.of (ctRep D g)) * (cUel D g)⁻¹ := by
      apply Subtype.ext
      show g * (r : G) * g⁻¹ = (cUel D g : G) *
        ((D.e (FreeGroup.of (ctRep D g))) : G) * (cUel D g : G)⁻¹
      rw [show ((D.e (FreeGroup.of (ctRep D g))) : G) =
        (tIdx D.trans g) * (r : G) * (tIdx D.trans g)⁻¹ from by
          rw [← ctRep_coe]; exact D.he (ctRep D g)]
      exact cUel_spec D g
    rw [hkey, map_mul, map_mul, map_inv, hχe (ctRep D g),
      mul_comm (χ (cUel D g)) (if ctRep D g = t₀ then Multiplicative.ofAdd (1 : ℤ) else 1),
      mul_assoc, mul_inv_cancel, mul_one]
  have hχz : χ (cR (r := r) ^ j) = (Multiplicative.ofAdd (1 : ℤ)) ^ j := by
    rw [map_zpow, hχr]
  have h2 : Multiplicative.ofAdd j =
      (if ctRep D g = t₀ then Multiplicative.ofAdd (1 : ℤ) else 1) := by
    rw [← zpow_ofAdd_one j, ← hχz, ← h1, hχg]
  by_cases hcase : ctRep D g = t₀
  · rw [if_pos hcase] at h2
    have hj1 : j = 1 := Multiplicative.ofAdd.injective h2
    refine ⟨hj1, ?_⟩
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    have h' : g * (r : G) = (r : G) * g := by
      have := congrArg (fun z => z * g) (hj1 ▸ h)
      simpa [zpow_one, mul_assoc] using this
    exact h'.symm
  · rw [if_neg hcase] at h2
    have h3 : j = 0 := Multiplicative.ofAdd.injective (by simpa using h2)
    exact absurd h3 hj


/-! ## The malnormality input -/

/-- Every element of `↥γ` is the `ψ`-image of an element of `⟪r⟫_K`. -/
theorem cGam_symm_spec (D : CLData (r : G) T) (m : ↥(cGam D)) :
    ∃ z : ↥K, z ∈ Subgroup.normalClosure ({(r : ↥K)} : Set ↥K) ∧
      (z : G) = (((cPsi D).symm (m : Monoid.CoprodI (FFac T))) : G) := by
  have hm : (m : Monoid.CoprodI (FFac T)) ∈ cGamImg D := by
    rw [← cGam_eq_cGamImg]; exact m.2
  obtain ⟨q, -, hq⟩ := Subgroup.mem_map.mp hm
  obtain ⟨z, hz, hzq⟩ := Subgroup.mem_map.mp q.2
  refine ⟨z, hz, ?_⟩
  have h1 : (cPsi D).symm (m : Monoid.CoprodI (FFac T)) =
      Subgroup.inclusion (chNK (r := r)) q := by
    rw [← hq]
    exact (cPsi D).symm_apply_apply _
  rw [h1]
  exact hzq

/-! ## Generation and the transversal of `K/(⟪r⟫_K ⊔ C_K(r))` -/

theorem closure_range_Zel_subtype (D : CLData (r : G) T) :
    Subgroup.closure (Set.range (fun k : ↥K =>
        (⟨cZel D (k : G), cZel_mem_cGam D k⟩ : ↥(cGam D)))) = ⊤ := by
  refine le_antisymm le_top ?_
  intro y _
  have h1 : (y : Monoid.CoprodI (FFac T)) ∈ Subgroup.map (Subgroup.subtype (cGam D))
      (Subgroup.closure (Set.range (fun k : ↥K =>
        (⟨cZel D (k : G), cZel_mem_cGam D k⟩ : ↥(cGam D))))) := by
    rw [map_closure_eq]
    have hset : (Subgroup.subtype (cGam D)) '' (Set.range (fun k : ↥K =>
        (⟨cZel D (k : G), cZel_mem_cGam D k⟩ : ↥(cGam D)))) =
        Set.range (fun k : ↥K => cZel D (k : G)) := by
      ext z
      constructor
      · rintro ⟨w, ⟨k, rfl⟩, rfl⟩
        exact ⟨k, rfl⟩
      · rintro ⟨k, rfl⟩
        exact ⟨_, ⟨k, rfl⟩, rfl⟩
    rw [hset, ← cGam]
    exact y.2
  obtain ⟨m, hm, hmy⟩ := Subgroup.mem_map.mp h1
  have hmy' : m = y := Subtype.ext hmy
  rwa [hmy'] at hm

theorem cHgen (D : CLData (r : G) T) :
    Subgroup.closure (⋃ v : Work.ORLocInd.CoprodTree.Vertex (FFac T),
        (MulAction.stabilizer (cGam D) v : Set ↥(cGam D))) = ⊤ := by
  rw [eq_top_iff, ← closure_range_Zel_subtype D]
  refine Subgroup.closure_mono ?_
  rintro y ⟨k, rfl⟩
  exact Set.mem_iUnion.mpr ⟨cVg D (k : G), cZel_mem_stabGam D k⟩

/-- The subgroup `⟪r⟫_K ⊔ C_K(r)`. -/
abbrev KH (r : ↥K) : Subgroup ↥K :=
  Subgroup.normalClosure ({(r : ↥K)} : Set ↥K) ⊔ Subgroup.centralizer ({r} : Set ↥K)

/-- A transversal of the cosets of `⟪r⟫_K ⊔ C_K(r)`. -/
structure KTransversal (r : ↥K) where
  Tset : Set ↥K
  spec : ∀ k : ↥K, ∃! t : ↥K, t ∈ Tset ∧ k⁻¹ * t ∈ KH r

theorem nonempty_KTransversal (r : ↥K) : Nonempty (KTransversal r) := by
  classical
  refine ⟨{ Tset := Set.range (fun q : Quotient (QuotientGroup.leftRel (KH r)) => Quot.out q),
            spec := ?_ }⟩
  intro k
  refine ⟨Quot.out (Quotient.mk (QuotientGroup.leftRel (KH r)) k),
    ⟨⟨Quotient.mk _ k, rfl⟩, ?_⟩, ?_⟩
  · have h : Quotient.mk (QuotientGroup.leftRel (KH r))
        (Quot.out (Quotient.mk (QuotientGroup.leftRel (KH r)) k)) =
        Quotient.mk (QuotientGroup.leftRel (KH r)) k := Quot.out_eq _
    have h2 := QuotientGroup.leftRel_apply.mp (Quotient.exact h)
    simpa [mul_inv_rev] using (KH r).inv_mem h2
  · rintro t ⟨⟨q, rfl⟩, ht⟩
    have h1 : (Quotient.mk (QuotientGroup.leftRel (KH r)) (Quot.out q)) =
        Quotient.mk (QuotientGroup.leftRel (KH r)) k :=
      Quotient.sound (QuotientGroup.leftRel_apply.mpr
        (by simpa [mul_inv_rev] using (KH r).inv_mem ht))
    have h2 : q = Quotient.mk (QuotientGroup.leftRel (KH r)) k := by
      rw [← Quot.out_eq q]
      exact h1
    rw [h2]

noncomputable def kRep (E : KTransversal r) (k : ↥K) : ↥K := (E.spec k).choose

theorem kRep_mem (E : KTransversal r) (k : ↥K) : kRep E k ∈ E.Tset :=
  ((E.spec k).choose_spec).1.1

theorem kRep_spec (E : KTransversal r) (k : ↥K) : k⁻¹ * kRep E k ∈ KH r :=
  ((E.spec k).choose_spec).1.2

theorem kRep_eq (E : KTransversal r) {k t : ↥K} (ht : t ∈ E.Tset) (h : k⁻¹ * t ∈ KH r) :
    t = kRep E k :=
  ((E.spec k).choose_spec).2 t ⟨ht, h⟩

/-! ## The orbit of a vertex

Karrass--Solitar: the vertex attached to `k r k⁻¹` is a `γ`-translate of the vertex attached to
`t r t⁻¹`, where `t = kRep E k` is the transversal representative of the coset of `k`. -/

/-- The image in `G` of the conjugating element of `⟪r⟫_K`. -/
theorem cVg_orbit (D : CLData (r : G) T) (E : KTransversal r) (k : ↥K) :
    ∃ m : ↥(cGam D), cVg D (k : G) = m • cVg D ((kRep E k : ↥K) : G) := by
  classical
  obtain ⟨n, hn, c, hc, hnc⟩ := Subgroup.mem_sup_of_normal_left.mp (kRep_spec E k)
  -- `n * c = k⁻¹ * kRep E k`, hence `k = kRep E k * c⁻¹ * n⁻¹`
  have hk : (k : ↥K) = kRep E k * c⁻¹ * n⁻¹ := by
    have h2 : (k : ↥K) * (n * c) = kRep E k := by rw [hnc]; group
    calc (k : ↥K) = (k : ↥K) * (n * c) * (n * c)⁻¹ := by group
      _ = kRep E k * (n * c)⁻¹ := by rw [h2]
      _ = kRep E k * c⁻¹ * n⁻¹ := by group
  -- `c` commutes with `r`
  have hcomm : ((c : ↥K) : G) * ((r : ↥K) : G) = ((r : ↥K) : G) * ((c : ↥K) : G) := by
    have h2 : (r : ↥K) * c = c * r :=
      (Subgroup.mem_centralizer_iff.mp hc) r (Set.mem_singleton r)
    have h3 := congrArg (fun z : ↥K => (z : G)) h2
    simp only [Subgroup.coe_mul] at h3
    exact h3.symm
  have hcr : ((c : ↥K) : G) * ((r : ↥K) : G) * (((c : ↥K) : G))⁻¹ = ((r : ↥K) : G) := by
    calc ((c : ↥K) : G) * ((r : ↥K) : G) * (((c : ↥K) : G))⁻¹
        = (((r : ↥K) : G) * ((c : ↥K) : G)) * (((c : ↥K) : G))⁻¹ := by rw [hcomm]
      _ = ((r : ↥K) : G) := by group
  set cG : G := ((c : ↥K) : G) with hcG
  set nG : G := ((n : ↥K) : G) with hnG
  have hcrG : cG * (r : G) * cG⁻¹ = (r : G) := by rw [hcG]; exact hcr
  set xK : ↥K := kRep E k * (c⁻¹ * n⁻¹ * c) * (kRep E k)⁻¹ with hxK
  have hxmem : xK ∈ Subgroup.normalClosure ({(r : ↥K)} : Set ↥K) := by
    rw [hxK]
    refine Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) (c⁻¹ * n⁻¹ * c) ?_ _
    have h := Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) n⁻¹
      ((Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)).inv_mem hn) c⁻¹
    simpa using h
  -- the key identity of `G`-elements
  have hkG : (k : G) = ((kRep E k : ↥K) : G) * cG⁻¹ * nG⁻¹ := by
    rw [show (k : G) = ((kRep E k * c⁻¹ * n⁻¹ : ↥K) : G) from by rw [← hk]]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, hcG, hnG]
  have hxK' : (xK : G) = ((kRep E k : ↥K) : G) * (cG⁻¹ * nG⁻¹ * cG) * (((kRep E k : ↥K) : G))⁻¹ := by
    rw [hxK]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, hcG, hnG]
  have hA : cG⁻¹ * nG⁻¹ * cG * (r : G) * (cG⁻¹ * nG⁻¹ * cG)⁻¹
      = cG⁻¹ * nG⁻¹ * (r : G) * nG * cG := by
    rw [show cG⁻¹ * nG⁻¹ * cG * (r : G) * (cG⁻¹ * nG⁻¹ * cG)⁻¹
        = cG⁻¹ * nG⁻¹ * (cG * (r : G) * cG⁻¹) * nG * cG from by group, hcrG]
  have hval : (xK : G) * (((kRep E k : ↥K) : G) * (r : G) * (((kRep E k : ↥K) : G))⁻¹) * (xK : G)⁻¹
      = (k : G) * (r : G) * (k : G)⁻¹ := by
    rw [hxK', hkG,
      show ((kRep E k : ↥K) : G) * (cG⁻¹ * nG⁻¹ * cG) * (((kRep E k : ↥K) : G))⁻¹
          * (((kRep E k : ↥K) : G) * (r : G) * (((kRep E k : ↥K) : G))⁻¹)
          * (((kRep E k : ↥K) : G) * (cG⁻¹ * nG⁻¹ * cG) * (((kRep E k : ↥K) : G))⁻¹)⁻¹
        = ((kRep E k : ↥K) : G) * (cG⁻¹ * nG⁻¹ * cG * (r : G) * (cG⁻¹ * nG⁻¹ * cG)⁻¹)
          * (((kRep E k : ↥K) : G))⁻¹ from by group]
    rw [hA]
    group
  -- the conjugating element of `γ`
  have hm : cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩ ∈ cGam D := by
    rw [cGam_eq_cGamImg, cGamImg]
    exact Subgroup.mem_map.mpr ⟨⟨(xK : G), Subgroup.mem_map_of_mem K.subtype hxmem⟩,
      Subgroup.mem_top _, rfl⟩
  refine ⟨⟨cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩, hm⟩, ?_⟩
  have hconj : cZel D (k : G)
      = cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩
        * cZel D (((kRep E k : ↥K) : G))
        * (cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩)⁻¹ := by
    have hkey : (⟨(k : G) * (r : G) * (k : G)⁻¹,
          cmemConj (r := r) (k : G)⟩ : ↥(Subgroup.normalClosure ({(r : G)} : Set G)))
        = ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩
          * ⟨(((kRep E k : ↥K) : G)) * (r : G) * (((kRep E k : ↥K) : G))⁻¹,
              cmemConj (r := r) (((kRep E k : ↥K) : G))⟩
          * ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩⁻¹ := by
      apply Subtype.ext
      exact hval.symm
    show cPsi D _ = _
    rw [hkey, map_mul, map_mul, map_inv]
    rfl
  have hfix : cZel D (k : G)
        • ((⟨cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩, hm⟩
            : ↥(cGam D))
          • cVg D (((kRep E k : ↥K) : G)))
      = (⟨cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩, hm⟩
          : ↥(cGam D))
        • cVg D (((kRep E k : ↥K) : G)) := by
    show cZel D (k : G)
        • ((cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩)
          • cVg D (((kRep E k : ↥K) : G))) = _
    rw [← mul_smul]
    rw [show cZel D (k : G)
        * cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩
        = cPsi D ⟨(xK : G), chNK (r := r) (Subgroup.mem_map_of_mem K.subtype hxmem)⟩
          * cZel D (((kRep E k : ↥K) : G)) from by rw [hconj]; group]
    rw [mul_smul, cZel_fixes_cVg]
    rfl
  exact (cZel_fixed_unique D (k : G) hfix).symm

/-- The inverse of `cPsi` restricted to `γ`: `γ` is isomorphic to `⟪r⟫_K`. -/
noncomputable def cNKEquivGam (D : CLData (r : G) T) : ↥(cNKmap (r := r)) ≃* ↥(cGam D) := by
  refine MulEquiv.ofBijective
    (f := ({ toFun := fun q => ?_, map_one' := ?_, map_mul' := ?_ }
      : ↥(cNKmap (r := r)) →* ↥(cGam D))) ⟨?_, ?_⟩
  · exact ⟨(cPsi D) (Subgroup.inclusion (chNK (r := r)) q), by
      rw [cGam_eq_cGamImg, cGamImg]
      exact Subgroup.mem_map.mpr ⟨q, Subgroup.mem_top _, rfl⟩⟩
  · ext; simp
  · intro a b; ext; simp
  · intro a b hab
    have h : (cPsi D) (Subgroup.inclusion (chNK (r := r)) a)
        = (cPsi D) (Subgroup.inclusion (chNK (r := r)) b) :=
      congrArg (fun z : ↥(cGam D) => (z : Monoid.CoprodI (FFac T))) hab
    have h' : Subgroup.inclusion (chNK (r := r)) a = Subgroup.inclusion (chNK (r := r)) b :=
      (cPsi D).injective h
    exact Subtype.ext (congrArg (fun z : ↥(Subgroup.normalClosure ({(r : G)} : Set G)) => (z : G)) h')
  · intro y
    have hy : (y : Monoid.CoprodI (FFac T)) ∈ cGamImg D := by
      rw [← cGam_eq_cGamImg]; exact y.2
    obtain ⟨q, -, hq⟩ := Subgroup.mem_map.mp hy
    exact ⟨q, Subtype.ext hq⟩

/-- `cNKmap` is the image of `⟪r⟫_K`. -/
noncomputable def cNKEquiv (D : CLData (r : G) T) :
    ↥(cNKmap (r := r)) ≃* ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)) :=
  (Subgroup.equivMapOfInjective (Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))
    K.subtype (fun a b h => Subtype.ext h)).symm

/-! ## The characters of the free-product model -/

/-- The character of `P` detecting the generator of the factor `τ`. -/
noncomputable def cChar (τ : T) : Monoid.CoprodI (FFac T) →* Multiplicative ℤ := by
  classical
  exact (FreeGroup.lift (fun t : T => if t = τ then Multiplicative.ofAdd (1 : ℤ) else 1)).comp
    (kappa T).symm.toMonoidHom

theorem cChar_conj (τ : T) (a x : Monoid.CoprodI (FFac T)) :
    cChar (T := T) τ (a * x * a⁻¹) = cChar (T := T) τ x := by
  rw [map_mul, map_mul, map_inv,
    mul_comm (cChar (T := T) τ a) (cChar (T := T) τ x),
    mul_assoc, mul_inv_cancel, mul_one]

/-- The transported generator is detected by the character of its own factor. -/
theorem cChar_cZel (D : CLData (r : G) T) (g : G) :
    cChar (T := T) (ctRep D g) (cZel D g) = Multiplicative.ofAdd (1 : ℤ) := by
  classical
  rw [cZel_eq, cChar_conj]
  rw [Xgen_eq_kappa]
  show FreeGroup.lift (fun t : T => if t = ctRep D g then Multiplicative.ofAdd (1 : ℤ) else 1)
    ((kappa T).symm (kappa T (FreeGroup.of (ctRep D g)))) = _
  rw [MulEquiv.symm_apply_apply, FreeGroup.lift_apply_of, if_pos rfl]

/-- **Every `cZel D g` has infinite order.** -/
theorem cZel_zpow_eq_one (D : CLData (r : G) T) {g : G} {m : ℤ} (h : (cZel D g) ^ m = 1) :
    m = 0 := by
  have h1 : (Multiplicative.ofAdd (1 : ℤ)) ^ m = 1 := by
    rw [← cChar_cZel D g, ← map_zpow, h, map_one]
  rw [zpow_ofAdd_one] at h1
  exact Multiplicative.ofAdd.injective (by simpa using h1)

/-- The free group on one generator, with its generator detected by the character `ofAdd 1`. -/
theorem freeGroupOne_lift_injective :
    Function.Injective (FreeGroup.lift (fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ))) := by
  have h1 : (FreeGroup.lift (fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ)))
      = (FreeGroup.mulEquivIntOfUnique (α := ULift.{u, 0} PUnit)).toMonoidHom := by
    apply FreeGroup.ext_hom
    intro a
    rw [FreeGroup.lift_apply_of]
    simp only [FreeGroup.mulEquivIntOfUnique, Function.comp_apply]
    congr 1
  rw [h1]
  exact (FreeGroup.mulEquivIntOfUnique (α := ULift.{u, 0} PUnit)).injective

/-- **The stabiliser of a vertex of the transversal is infinite cyclic**, generated by the
corresponding conjugate of the transported generator. -/
noncomputable def cycIso (D : CLData (r : G) T) (E : KTransversal r) (t : ↥(E.Tset)) :
    FreeGroup (ULift.{u, 0} PUnit) ≃*
      ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G))) := by
  classical
  have hgen : (⟨cZel D (((t : E.Tset) : ↥K) : G),
        cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩ : ↥(cGam D))
      ∈ (MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G))) := by
    rw [cStab_cVg D ((t : E.Tset) : ↥K)]
    exact Subgroup.mem_zpowers _
  let gen : ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G))) :=
    ⟨⟨cZel D (((t : E.Tset) : ↥K) : G),
        cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩, hgen⟩
  let f : FreeGroup (ULift.{u, 0} PUnit) →*
      ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G))) :=
    FreeGroup.lift (fun _ => gen)
  have hff : ∀ x, f x = FreeGroup.lift (fun _ => gen) x := fun _ => rfl
  have hhom : (cChar (T := T) (ctRep D (((t : E.Tset) : ↥K) : G))).comp
        ((Subgroup.subtype (cGam D)).comp ((Subgroup.subtype (MulAction.stabilizer ↥(cGam D)
          (cVg D (((t : E.Tset) : ↥K) : G)))).comp f))
      = FreeGroup.lift (fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ)) := by
    apply FreeGroup.ext_hom
    intro u
    simp only [MonoidHom.comp_apply, f, FreeGroup.lift_apply_of]
    exact cChar_cZel D (((t : E.Tset) : ↥K) : G)
  refine MulEquiv.ofBijective (f := f) ⟨?_, ?_⟩
  · intro a b hab
    have h4 : cChar (T := T) (ctRep D (((t : E.Tset) : ↥K) : G))
        ((↑(f a) : ↥(cGam D)) : Monoid.CoprodI (FFac T))
        = (FreeGroup.lift (fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ))) a := by
      have h := congrArg (fun (φ : FreeGroup (ULift.{u, 0} PUnit) →* Multiplicative ℤ) => φ a) hhom
      rw [MonoidHom.comp_apply, MonoidHom.comp_apply, MonoidHom.comp_apply] at h
      exact h
    have h5 : cChar (T := T) (ctRep D (((t : E.Tset) : ↥K) : G))
        ((↑(f b) : ↥(cGam D)) : Monoid.CoprodI (FFac T))
        = (FreeGroup.lift (fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ))) b := by
      have h := congrArg (fun (φ : FreeGroup (ULift.{u, 0} PUnit) →* Multiplicative ℤ) => φ b) hhom
      rw [MonoidHom.comp_apply, MonoidHom.comp_apply, MonoidHom.comp_apply] at h
      exact h
    have h3 := congrArg (fun z : ↥(MulAction.stabilizer ↥(cGam D)
        (cVg D (((t : E.Tset) : ↥K) : G))) =>
        cChar (T := T) (ctRep D (((t : E.Tset) : ↥K) : G))
          ((z : ↥(cGam D)) : Monoid.CoprodI (FFac T))) hab
    rw [h4, h5] at h3
    exact freeGroupOne_lift_injective h3
  · intro y
    have hy : (y : ↥(cGam D)) ∈ Subgroup.zpowers
        (⟨cZel D (((t : E.Tset) : ↥K) : G), cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩ :
          ↥(cGam D)) := by
      rw [← cStab_cVg D ((t : E.Tset) : ↥K)]
      exact y.2
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hy
    refine ⟨FreeGroup.of (ULift.up PUnit.unit) ^ k, ?_⟩
    apply Subtype.ext
    show ((f (FreeGroup.of (ULift.up PUnit.unit) ^ k) : ↥(cGam D)) :
        ↥(cGam D)) = (y : ↥(cGam D))
    rw [show f (FreeGroup.of (ULift.up PUnit.unit) ^ k) = gen ^ k from by
      rw [map_zpow, show f (FreeGroup.of (ULift.up PUnit.unit)) = gen from FreeGroup.lift_apply_of]]
    exact hk

/-- `γ` is isomorphic to the normal closure of `r` in `K`. -/
noncomputable def cGamEquivN (D : CLData (r : G) T) :
    ↥(cGam D) ≃* ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)) :=
  (cNKEquivGam D).symm.trans (cNKEquiv D)

/-- The generation statement of the structure theorem, from the generation by the conjugates. -/
theorem cGam_hgen_of (D : CLData (r : G) T) (E : KTransversal r)
    (hgen : Subgroup.closure (Set.range (fun t : ↥(E.Tset) =>
      (⟨cZel D (((t : E.Tset) : ↥K) : G), cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩ :
        ↥(cGam D)))) = ⊤) :
    Subgroup.closure (⋃ t : ↥(E.Tset), (MulAction.stabilizer ↥(cGam D)
      (cVg D (((t : E.Tset) : ↥K) : G)) : Set ↥(cGam D))) = ⊤ := by
  rw [eq_top_iff, ← hgen]
  refine Subgroup.closure_mono ?_
  rintro z ⟨t, rfl⟩
  exact Set.mem_iUnion.mpr ⟨t, by
    rw [cStab_cVg D ((t : E.Tset) : ↥K)]
    exact Subgroup.mem_zpowers _⟩

/-! ## The free product decomposition of `γ` over the transversal -/

/-- A type is equivalent to the sigma type with a one-point fibre. -/
def sigmaPUnitEquiv (α : Type u) : α ≃ Sigma (fun _ : α => ULift.{u, 0} PUnit) where
  toFun t := ⟨t, ULift.up PUnit.unit⟩
  invFun x := x.1
  left_inv _ := rfl
  right_inv x := Sigma.ext rfl (heq_of_eq (Subsingleton.elim _ x.2))

/-- The free group on a type as the free product of free groups on one generator. -/
noncomputable def freeGroupCoprodIHom (Ω : Type u) :
    FreeGroup Ω ≃* Monoid.CoprodI (fun _ : Ω => FreeGroup (ULift.{u, 0} PUnit)) :=
  Classical.choose (freeGroup_equiv_coprodI (X := fun _ : Ω => ULift.{u, 0} PUnit)
    (e := sigmaPUnitEquiv Ω))

/-- The free product of the cyclic stabilisers, transported from the free product of free groups
on one generator. -/
noncomputable def coprodICycEquiv (D : CLData (r : G) T) (E : KTransversal r) :
    Monoid.CoprodI (fun _ : ↥(E.Tset) => FreeGroup (ULift.{u, 0} PUnit)) ≃*
      Monoid.CoprodI (fun t : ↥(E.Tset) =>
        ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G)))) :=
  Classical.choose (Work.ORBassSerre.Action.CoprodI.coprodI_congr
    (fun t : ↥(E.Tset) => cycIso D E t))

/-- The free group on the transversal is the free product of the stabilisers of the corresponding
vertices. -/
noncomputable def cStabEquiv (D : CLData (r : G) T) (E : KTransversal r) :
    FreeGroup ↥(E.Tset) ≃*
      Monoid.CoprodI (fun t : ↥(E.Tset) =>
        ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G)))) :=
  (freeGroupCoprodIHom ↥(E.Tset)).trans (coprodICycEquiv D E)

/-- The value of `cStabEquiv` on a generator. -/
theorem cStabEquiv_of (D : CLData (r : G) T) (E : KTransversal r) (t : ↥(E.Tset)) :
    cStabEquiv D E (FreeGroup.of t)
      = Monoid.CoprodI.of (M := fun t : ↥(E.Tset) => ↥(MulAction.stabilizer ↥(cGam D)
          (cVg D (((t : E.Tset) : ↥K) : G))))
        (⟨⟨cZel D (((t : E.Tset) : ↥K) : G), cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩,
          cZel_mem_stabGam D ((t : E.Tset) : ↥K)⟩ :
            ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G)))) := by
  classical
  have hκ := Classical.choose_spec (freeGroup_equiv_coprodI
    (X := fun _ : ↥(E.Tset) => ULift.{u, 0} PUnit) (e := sigmaPUnitEquiv ↥(E.Tset)))
  have hΦ := Classical.choose_spec (Work.ORBassSerre.Action.CoprodI.coprodI_congr
    (fun t : ↥(E.Tset) => cycIso D E t))
  have hκt : freeGroupCoprodIHom ↥(E.Tset) (FreeGroup.of t)
      = Monoid.CoprodI.of (M := fun _ : ↥(E.Tset) => FreeGroup (ULift.{u, 0} PUnit)) (i := t)
          (FreeGroup.of (ULift.up PUnit.unit)) := hκ t
  have hΦt : coprodICycEquiv D E (Monoid.CoprodI.of (M := fun _ : ↥(E.Tset) =>
        FreeGroup (ULift.{u, 0} PUnit)) (i := t) (FreeGroup.of (ULift.up PUnit.unit)))
      = Monoid.CoprodI.of (M := fun t : ↥(E.Tset) => ↥(MulAction.stabilizer ↥(cGam D)
          (cVg D (((t : E.Tset) : ↥K) : G)))) (i := t)
          (cycIso D E t (FreeGroup.of (ULift.up PUnit.unit))) := hΦ t _
  rw [cStabEquiv, MulEquiv.trans_apply, hκt, hΦt]
  congr 1
  apply Subtype.ext
  show ((FreeGroup.lift (fun _ : ULift.{u, 0} PUnit =>
      (⟨⟨cZel D (((t : E.Tset) : ↥K) : G), cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩,
        cZel_mem_stabGam D ((t : E.Tset) : ↥K)⟩ :
          ↥(MulAction.stabilizer ↥(cGam D) (cVg D (((t : E.Tset) : ↥K) : G))))))
    (FreeGroup.of (ULift.up PUnit.unit)) : ↥(cGam D))
    = ⟨cZel D (((t : E.Tset) : ↥K) : G), cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩
  rw [FreeGroup.lift_apply_of]

/-! ## Distinct representatives have distinct orbits (the malnormality input) -/

/-- **Malnormality: distinct transversal representatives have distinct `γ`-orbits.**

If `cVg t` and `cVg t'` are in the same `γ`-orbit then `t = t'`.  The proof transports the
conjugating element to `K` (`cGam_symm_spec`), forms the conjugate `y = t⁻¹ z t'` of `r`, and
observes that `y r y⁻¹ = r^j` with `j ≠ 0`, so that `cZpow_eq_one` forces `y` to centralise `r`;
hence `t⁻¹ t' ∈ ⟪r⟫_K ⊔ C_K(r)` and the transversal property gives `t = t'`. -/
theorem cInj (D : CLData (r : G) T) (E : KTransversal r) (t t' : ↥(E.Tset))
    (h : ∃ m : ↥(cGam D),
      cVg D (((t : E.Tset) : ↥K) : G) = m • cVg D (((t' : E.Tset) : ↥K) : G)) :
    t = t' := by
  classical
  obtain ⟨m, hm⟩ := h
  set tG : G := (((t : E.Tset) : ↥K) : G) with htG
  set tG' : G := (((t' : E.Tset) : ↥K) : G) with htG'
  -- the conjugate of the second generator fixes the first vertex
  have hfixv : (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D))
      • cVg D tG' = cVg D tG' :=
    cZel_fixes_cVg D tG'
  have hw : m * (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D)) * m⁻¹
      ∈ MulAction.stabilizer ↥(cGam D) (cVg D tG) := by
    rw [hm]
    refine MulAction.mem_stabilizer_iff.mpr ?_
    calc (m * (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D)) * m⁻¹)
          • (m • cVg D tG')
        = m • ((⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D))
            • (m⁻¹ • (m • cVg D tG'))) := by rw [mul_smul, mul_smul]
      _ = m • ((⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D))
            • cVg D tG') := by rw [inv_smul_smul]
      _ = m • cVg D tG' := by rw [hfixv]
  have hmem : m * (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D)) * m⁻¹
      ∈ Subgroup.zpowers (⟨cZel D tG, cZel_mem_cGam D ((t : E.Tset) : ↥K)⟩ : ↥(cGam D)) := by
    rw [← cStab_cVg D ((t : E.Tset) : ↥K)]
    exact hw
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp hmem
  have hj0 : j ≠ 0 := by
    rintro rfl
    rw [zpow_zero] at hj
    have h1 : (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D)) = 1 := by
      calc (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D))
          = m⁻¹ * (m * (⟨cZel D tG', cZel_mem_cGam D ((t' : E.Tset) : ↥K)⟩ : ↥(cGam D))
              * m⁻¹) * m := by group
        _ = 1 := by rw [← hj]; group
    have h3 := congrArg (fun z : ↥(cGam D) => (z : Monoid.CoprodI (FFac T))) h1
    simp only [Subgroup.coe_one] at h3
    exact cZel_ne_one D tG' h3
  -- the equation transported to the free-product model
  have hjP : (cZel D tG) ^ j
      = (m : Monoid.CoprodI (FFac T)) * cZel D tG' * (m : Monoid.CoprodI (FFac T))⁻¹ := by
    have h2 := congrArg (fun z : ↥(cGam D) => (z : Monoid.CoprodI (FFac T))) hj
    simpa using h2
  -- and then to `G`
  obtain ⟨z, hzmem, hzval⟩ := cGam_symm_spec D m
  have hjN : (⟨tG * (r : G) * tG⁻¹, cmemConj (r := r) tG⟩ :
        ↥(Subgroup.normalClosure ({(r : G)} : Set G))) ^ j
      = (cPsi D).symm (m : Monoid.CoprodI (FFac T))
        * ⟨tG' * (r : G) * tG'⁻¹, cmemConj (r := r) tG'⟩
        * ((cPsi D).symm (m : Monoid.CoprodI (FFac T)))⁻¹ := by
    apply (cPsi D).injective
    rw [map_zpow, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply]
    rw [show cPsi D ⟨tG * (r : G) * tG⁻¹, cmemConj (r := r) tG⟩ = cZel D tG from rfl,
      show cPsi D ⟨tG' * (r : G) * tG'⁻¹, cmemConj (r := r) tG'⟩ = cZel D tG' from rfl]
    exact hjP
  have hG : (tG * (r : G) * tG⁻¹) ^ j = (z : G) * (tG' * (r : G) * tG'⁻¹) * (z : G)⁻¹ := by
    have h2 := congrArg (fun y : ↥(Subgroup.normalClosure ({(r : G)} : Set G)) => (y : G)) hjN
    simp only [Subgroup.coe_zpow, Subgroup.coe_mul, Subgroup.coe_inv] at h2
    rw [← hzval] at h2
    exact h2
  -- the conjugate of `r` which is a power of `r`
  set y : G := tG⁻¹ * (z : G) * tG' with hy
  have hyr : y * (r : G) * y⁻¹ = (r : G) ^ j := by
    have hconj : (tG * (r : G) * tG⁻¹) ^ j = tG * (r : G) ^ j * tG⁻¹ := by
      simpa [MulAut.conj_apply] using (map_zpow (MulAut.conj tG) (r : G) j).symm
    rw [hy]
    calc tG⁻¹ * (z : G) * tG' * (r : G) * (tG⁻¹ * (z : G) * tG')⁻¹
        = tG⁻¹ * ((z : G) * (tG' * (r : G) * tG'⁻¹) * (z : G)⁻¹) * tG := by group
      _ = tG⁻¹ * (tG * (r : G) * tG⁻¹) ^ j * tG := by rw [← hG]
      _ = (r : G) ^ j := by rw [hconj]; group
  obtain ⟨-, hyC⟩ := cZpow_eq_one D hj0 hyr
  have hyK : y ∈ K := by
    rw [hy, htG, htG']
    exact K.mul_mem (K.mul_mem (K.inv_mem (((t : E.Tset) : ↥K)).2) z.2) (((t' : E.Tset) : ↥K)).2
  have hyeq : (⟨y, hyK⟩ : ↥K) = ((t : E.Tset) : ↥K)⁻¹ * z * ((t' : E.Tset) : ↥K) := by
    apply Subtype.ext
    show y = ↑(((t : E.Tset) : ↥K)⁻¹ * z * ((t' : E.Tset) : ↥K))
    rw [hy, htG, htG']
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  have htz : ((t' : E.Tset) : ↥K) = z⁻¹ * ((t : E.Tset) : ↥K) * (⟨y, hyK⟩ : ↥K) := by
    rw [hyeq]; group
  have hycent : (⟨y, hyK⟩ : ↥K) ∈ Subgroup.centralizer ({r} : Set ↥K) := by
    rw [Subgroup.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    rw [hg]
    apply Subtype.ext
    have h4 := (Subgroup.mem_centralizer_iff.mp hyC) (r : G) (Set.mem_singleton (r : G))
    simpa using h4
  have hmem' : ((t : E.Tset) : ↥K)⁻¹ * ((t' : E.Tset) : ↥K) ∈ KH r := by
    have hprod : ((t : E.Tset) : ↥K)⁻¹ * ((t' : E.Tset) : ↥K)
        = ((t : E.Tset) : ↥K)⁻¹ * z⁻¹ * ((t : E.Tset) : ↥K) * (⟨y, hyK⟩ : ↥K) := by
      rw [htz]; group
    rw [hprod]
    refine (KH r).mul_mem ?_ (Subgroup.mem_sup_right hycent)
    refine Subgroup.mem_sup_left ?_
    have h5 := Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) z⁻¹
      ((Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)).inv_mem hzmem) (((t : E.Tset) : ↥K))⁻¹
    simpa using h5
  have ht : ((t : E.Tset) : ↥K) = kRep E ((t : E.Tset) : ↥K) :=
    kRep_eq E (t : E.Tset).2 (by rw [inv_mul_cancel]; exact (KH r).one_mem)
  have ht' : ((t' : E.Tset) : ↥K) = kRep E ((t : E.Tset) : ↥K) :=
    kRep_eq E (t' : E.Tset).2 hmem'
  exact Subtype.ext (Subtype.ext (by rw [ht, ← ht']))

end Datum

/-! ## The Karrass--Solitar descent through the Kurosh subgroup theorem

Kurosh's subgroup theorem for the free product `P = CoprodI (FFac T)` says that a subgroup
`Γ ≤ P` generated by its intersections with the conjugates of the factors is the free product
of the intersections with a *set of representatives of the leaf orbits* of its action on the
star tree.  Applied to `Γ = cGam D ≅ ⟪r⟫_K` this exhibits `⟪r⟫_K` as the free product of the
cyclic groups generated by the conjugates `t r t⁻¹` over a transversal of `K/(⟪r⟫_K ⊔ C_K(r))`.

The restriction to the *correct* transversal is automatic here: the representatives are the
orbit representatives supplied by the spanning-tree lift of the quotient graph, and the label in
`K` attached to a leaf orbit with non-trivial stabiliser is recovered by malnormality. -/

section KuroshDescent

variable {K : Subgroup G} {r : K} {T : Set G}

/-- The factor of the Kurosh decomposition attached to the leaf orbit `k`. -/
noncomputable def cF (D : CLData (r : G) T) (Ω : Type u) (ii : Ω → T)
    (xx : Ω → Monoid.CoprodI (FFac T)) (k : Ω) : Subgroup (Monoid.CoprodI (FFac T)) :=
  cGam D ⊓ Subgroup.map (MulAut.conj (xx k)).toMonoidHom
    (Subgroup.map (Monoid.CoprodI.of (M := FFac T) (i := ii k)) ⊤)

/-- Conjugation carries cyclic subgroups to cyclic subgroups of conjugates. -/
theorem cMap_zpowers_conj (g x : Monoid.CoprodI (FFac T)) :
    Subgroup.map (MulEquiv.toMonoidHom (MulAut.conj g)) (Subgroup.zpowers x) =
      Subgroup.zpowers (g * x * g⁻¹) := by
  rw [Subgroup.zpowers_eq_closure, map_closure_eq, Subgroup.zpowers_eq_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact Set.mem_singleton _
  · intro hy
    rw [Set.mem_singleton_iff] at hy
    refine ⟨x, Set.mem_singleton _, ?_⟩
    rw [hy]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]

/-- **The generation hypothesis of the Kurosh theorem.**  `Γ = cGam D` is generated by its
intersections with the conjugates of the factors of `P`: each `cZel D k` lies in the factor of
the vertex it fixes. -/
theorem cGam_hgen_kurosh (D : CLData (r : G) T) :
    cGam D ≤ Subgroup.closure (⋃ (i : T) (g : Monoid.CoprodI (FFac T)),
      (↑(cGam D ⊓ Subgroup.map (MulAut.conj g).toMonoidHom
        (Subgroup.map (Monoid.CoprodI.of (M := FFac T) (i := i)) ⊤)) :
          Set (Monoid.CoprodI (FFac T)))) := by
  rw [cGam, Subgroup.closure_le]
  rintro y ⟨k, rfl⟩
  have hconj : cZel D (k : G) ∈ Subgroup.map (MulAut.conj (cPsi D (cUel D (k : G)))).toMonoidHom
      (Subgroup.map (Monoid.CoprodI.of (M := FFac T) (i := ctRep D (k : G))) ⊤) := by
    rw [Subgroup.mem_map]
    refine ⟨Xgen T (ctRep D (k : G)), ?_, ?_⟩
    · rw [kurosh_factor_eq (D := FFac T) (i := ctRep D (k : G))]
      exact Xgen_mem_factor (ctRep D (k : G))
    · simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      exact (cZel_eq D (k : G)).symm
  refine Subgroup.subset_closure ?_
  simp only [Set.mem_iUnion]
  exact ⟨ctRep D (k : G), cPsi D (cUel D (k : G)), cZel_mem_cGam D k, hconj⟩

/-- The data produced by Kurosh's subgroup theorem for `Γ = cGam D`. -/
structure CKurosh (D : CLData (r : G) T) where
  Ω : Type u
  ii : Ω → T
  xx : Ω → Monoid.CoprodI (FFac T)
  hcov : ∀ (j : T) (g : Monoid.CoprodI (FFac T)), ∃ k : Ω, ii k = j ∧ ∃ c : ↥(cGam D),
    ∃ d : FFac T j, g = (c : Monoid.CoprodI (FFac T)) * xx k * Monoid.CoprodI.of d
  hinj : ∀ k l : Ω, ii k = ii l → (∃ c : ↥(cGam D), ∃ d : FFac T (ii k),
    xx k = (c : Monoid.CoprodI (FFac T)) * xx l * Monoid.CoprodI.of d) → k = l
  e : Monoid.CoprodI (fun k : Ω => ↥(cF D Ω ii xx k)) ≃* ↥(cGam D)
  he : ∀ (k : Ω) (z : ↥(cF D Ω ii xx k)),
    e (Monoid.CoprodI.of z) = ⟨(z : Monoid.CoprodI (FFac T)), z.2.1⟩

theorem nonempty_CKurosh (D : CLData (r : G) T) : Nonempty (CKurosh D) := by
  obtain ⟨Ω, ii, xx, hcov, hinj, e, he⟩ :=
    kurosh_subgroup_coprodI (D := FFac T) (cGam D) (cGam_hgen_kurosh D)
  exact ⟨⟨Ω, ii, xx, hcov, hinj, e, he⟩⟩

/-- The label in `G` of a leaf orbit: the product of the `G`-element corresponding to `x k` with
the transversal element `i k`. -/
noncomputable def ctLbl (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) : G :=
  (((cPsi D).symm (Ks.xx k) : ↥(Subgroup.normalClosure ({(r : G)} : Set G))) : G) *
    ((Ks.ii k : T) : G)

theorem ctLbl_def (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    ctLbl D Ks k = (((cPsi D).symm (Ks.xx k) :
      ↥(Subgroup.normalClosure ({(r : G)} : Set G))) : G) * ((Ks.ii k : T) : G) := rfl

/-- A power of `cZel D g` is the image of the corresponding power of the conjugate of `r`. -/
theorem cZel_zpow_eq (D : CLData (r : G) T) (g : G) (j : ℤ) :
    (cZel D g) ^ j = cPsi D ⟨(g * (r : G) * g⁻¹) ^ j,
      (Subgroup.normalClosure ({(r : G)} : Set G)).zpow_mem (cmemConj (r := r) g) j⟩ := by
  rw [cZel, ← map_zpow]
  congr 1

/-- **The generator of the stabiliser of the leaf orbit `k`.** -/
theorem cZel_ctLbl (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    cZel D (ctLbl D Ks k) = Ks.xx k * Xgen T (Ks.ii k) * (Ks.xx k)⁻¹ := by
  have hxx : Ks.xx k = cPsi D ((cPsi D).symm (Ks.xx k)) :=
    (MulEquiv.apply_symm_apply (cPsi D) (Ks.xx k)).symm
  have hgen : Ks.xx k * Xgen T (Ks.ii k) * (Ks.xx k)⁻¹ = cPsi D
      ((cPsi D).symm (Ks.xx k) * D.e (FreeGroup.of (Ks.ii k)) *
        ((cPsi D).symm (Ks.xx k))⁻¹) := by
    conv_lhs => rw [hxx]
    rw [← cPsi_e_of D (Ks.ii k), map_mul, map_mul, map_inv]
  rw [hgen, cZel]
  congr 1
  apply Subtype.ext
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, ctLbl]
  rw [D.he (Ks.ii k)]
  group

/-- **Malnormality recovers the label.**  If the leaf orbit `k` has non-trivial stabiliser, its
label lies in `K`. -/
theorem ctLbl_mem (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (k : Ks.Ω) (hk : cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥) : ctLbl D Ks k ∈ K := by
  obtain ⟨x, hx, hx1⟩ : ∃ x ∈ cF D Ks.Ω Ks.ii Ks.xx k, x ≠ 1 := by
    by_contra h
    exact hk ((Subgroup.eq_bot_iff_forall _).mpr fun y hy => by
      by_contra hy1
      exact h ⟨y, hy, hy1⟩)
  obtain ⟨w, hw, hwx⟩ := Subgroup.mem_map.mp hx.2
  obtain ⟨m, -, hmw⟩ := Subgroup.mem_map.mp hw
  have hwzp : w ∈ Subgroup.zpowers (Xgen T (Ks.ii k)) := by
    rw [← factor_eq_zpowers]
    exact ⟨m, hmw⟩
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp hwzp
  have hxval : x = (cZel D (ctLbl D Ks k)) ^ j := by
    rw [← hwx, ← hj]
    simp only [MulEquiv.coe_toMonoidHom]
    rw [map_zpow, MulAut.conj_apply, cZel_ctLbl D Ks k]
  have hj0 : j ≠ 0 := by
    rintro rfl
    rw [zpow_zero] at hxval
    exact hx1 hxval
  obtain ⟨z, hzmem, hzval⟩ := cGam_symm_spec D ⟨x, hx.1⟩
  have hzval' : (z : G) = (((cPsi D).symm x :
      ↥(Subgroup.normalClosure ({(r : G)} : Set G))) : G) := hzval
  have hzpow : (z : G) = (ctLbl D Ks k * (r : G) * (ctLbl D Ks k)⁻¹) ^ j := by
    rw [hzval', hxval, cZel_zpow_eq D (ctLbl D Ks k) j, MulEquiv.symm_apply_apply]
  refine hmal (ctLbl D Ks k) ⟨j, hj0, ?_⟩
  rw [← hzpow]
  exact z.2

/-- **The label is the fixed vertex.**  The leaf orbit representing vertex of `k` is the vertex
fixed by `cZel D` of the label. -/
theorem cVert_eq_cVg (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k) = cVg D (ctLbl D Ks k) := by
  refine cZel_fixed_unique D (ctLbl D Ks k) ?_
  rw [cZel_ctLbl D Ks k]
  rw [Work.ORLocInd.CoprodTree.smul_vtx_some]
  refine Work.ORLocInd.CoprodTree.vtx_some_eq_vtx_some.mpr ?_
  have h1 : (Ks.xx k * Xgen T (Ks.ii k) * (Ks.xx k)⁻¹ * Ks.xx k)⁻¹ * Ks.xx k =
      (Xgen T (Ks.ii k))⁻¹ := by group
  rw [h1]
  exact (Work.ORLocInd.CoprodTree.factor (FFac T) (Ks.ii k)).inv_mem
    (Xgen_mem_factor (Ks.ii k))

/-- **The stabiliser of a leaf orbit representative is generated by the label.** -/
theorem cStab_vtx_eq_zpowers (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    MulAction.stabilizer (Monoid.CoprodI (FFac T))
        (Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k)) =
      Subgroup.zpowers (cZel D (ctLbl D Ks k)) := by
  rw [Work.ORLocInd.CoprodTree.stabilizer_coset, factor_eq_zpowers (Ks.ii k),
    cMap_zpowers_conj, ← cZel_ctLbl D Ks k]

/-- The factor of `k` is the intersection of `Γ` with the stabiliser of the leaf. -/
theorem cF_eq_stab (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    cF D Ks.Ω Ks.ii Ks.xx k = cGam D ⊓ MulAction.stabilizer (Monoid.CoprodI (FFac T))
      (Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k)) := by
  unfold cF
  rw [Work.ORLocInd.CoprodTree.stabilizer_coset, ← kurosh_factor_eq]

/-- The stabiliser for the restricted `Γ`-action. -/
theorem cStab_subgroupOf (D : CLData (r : G) T)
    (v : Work.ORLocInd.CoprodTree.Vertex (FFac T)) :
    MulAction.stabilizer ↥(cGam D) v =
      (MulAction.stabilizer (Monoid.CoprodI (FFac T)) v).subgroupOf (cGam D) := by
  ext h
  exact Iff.rfl

/-- An element of `Γ = cGam D` given by an element of `⟪r⟫_K` (viewed in `⟪r⟫_G`). -/
noncomputable def cGamOf (D : CLData (r : G) T) (q : ↥(cNKmap (r := r))) : ↥(cGam D) :=
  ⟨cPsi D (Subgroup.inclusion (chNK (r := r)) q), by
    rw [cGam_eq_cGamImg]
    exact Subgroup.mem_map.mpr ⟨q, Subgroup.mem_top _, rfl⟩⟩

theorem cGamOf_coe (D : CLData (r : G) T) (q : ↥(cNKmap (r := r))) :
    ((cGamOf D q : ↥(cGam D)) : Monoid.CoprodI (FFac T)) =
      cPsi D (Subgroup.inclusion (chNK (r := r)) q) := rfl

/-- The factor of a leaf orbit with non-trivial stabiliser is the stabiliser itself. -/
theorem cF_eq_stab_zpowers (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    cF D Ks.Ω Ks.ii Ks.xx k =
      cGam D ⊓ Subgroup.zpowers (cZel D (ctLbl D Ks k)) := by
  rw [cF_eq_stab, cStab_vtx_eq_zpowers]

/-- **Membership in a factor implies membership in the stabiliser of the label's vertex.** -/
theorem cF_le_stabK (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    cF D Ks.Ω Ks.ii Ks.xx k ≤
      MulAction.stabilizer (Monoid.CoprodI (FFac T)) (cVg D (ctLbl D Ks k)) := by
  intro x hx
  have h : x ∈ Subgroup.zpowers (cZel D (ctLbl D Ks k)) := by
    have h2 : x ∈ cGam D ⊓ Subgroup.zpowers (cZel D (ctLbl D Ks k)) := by
      rw [← cF_eq_stab_zpowers]
      exact hx
    exact h2.2
  exact Subgroup.zpowers_le.mpr (cZel_mem_stab D (ctLbl D Ks k)) h

/-- **The stabiliser of the label's vertex lies in the factor.** -/
theorem cStabK_le_cF (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω)
    {x : Monoid.CoprodI (FFac T)} (hxΓ : x ∈ cGam D)
    (hx : x ∈ MulAction.stabilizer (Monoid.CoprodI (FFac T)) (cVg D (ctLbl D Ks k))) :
    x ∈ cF D Ks.Ω Ks.ii Ks.xx k := by
  have hx' : x ∈ MulAction.stabilizer (Monoid.CoprodI (FFac T))
      (Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k)) := by
    rw [cVert_eq_cVg]
    exact hx
  have h : x ∈ cGam D ⊓ MulAction.stabilizer (Monoid.CoprodI (FFac T))
      (Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k)) := ⟨hxΓ, hx'⟩
  rwa [← cF_eq_stab] at h

/-- **The factor at `k` is the stabiliser of the vertex of the label.** -/
noncomputable def cFEquiv (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω) :
    ↥(cF D Ks.Ω Ks.ii Ks.xx k) ≃*
      ↥(MulAction.stabilizer ↥(cGam D) (cVg D (ctLbl D Ks k))) where
  toFun z := ⟨⟨(z : Monoid.CoprodI (FFac T)), z.2.1⟩, by
    rw [cStab_subgroupOf, Subgroup.mem_subgroupOf]
    exact cF_le_stabK D Ks k z.2⟩
  invFun w := ⟨((w : ↥(cGam D)) : Monoid.CoprodI (FFac T)),
    cStabK_le_cF D Ks k (w : ↥(cGam D)).2 (Subgroup.mem_subgroupOf.mp w.2)⟩
  left_inv z := Subtype.ext rfl
  right_inv w := Subtype.ext (Subtype.ext rfl)
  map_mul' a b := Subtype.ext (Subtype.ext rfl)

theorem cFEquiv_apply (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω)
    (z : ↥(cF D Ks.Ω Ks.ii Ks.xx k)) :
    (((cFEquiv D Ks k) z : ↥(cGam D)) : Monoid.CoprodI (FFac T)) =
      (z : Monoid.CoprodI (FFac T)) := rfl

theorem cFEquiv_symm_apply (D : CLData (r : G) T) (Ks : CKurosh D) (k : Ks.Ω)
    (w : ↥(MulAction.stabilizer ↥(cGam D) (cVg D (ctLbl D Ks k)))) :
    ((((cFEquiv D Ks k).symm w : ↥(cF D Ks.Ω Ks.ii Ks.xx k)) :
      Monoid.CoprodI (FFac T))) = ((w : ↥(cGam D)) : Monoid.CoprodI (FFac T)) := rfl

/-- **Every leaf vertex is a `Γ`-translate of a leaf orbit representative.** -/
theorem cLeaf_cover (D : CLData (r : G) T) (Ks : CKurosh D) (j : T)
    (g : Monoid.CoprodI (FFac T)) :
    ∃ k : Ks.Ω, ∃ m : ↥(cGam D),
      Work.ORLocInd.CoprodTree.vtx (some j) g =
        m • Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k) := by
  obtain ⟨k, hk, c, d, hcd⟩ := Ks.hcov j g
  refine ⟨k, c, ?_⟩
  have hmem : (((c : Monoid.CoprodI (FFac T)) * Ks.xx k * Monoid.CoprodI.of d)⁻¹ *
      ((c : Monoid.CoprodI (FFac T)) * Ks.xx k)) ∈ Work.ORLocInd.CoprodTree.factor (FFac T) j := by
    rw [show ((c : Monoid.CoprodI (FFac T)) * Ks.xx k * Monoid.CoprodI.of d)⁻¹ *
        ((c : Monoid.CoprodI (FFac T)) * Ks.xx k) = (Monoid.CoprodI.of d)⁻¹ from by group]
    exact (Work.ORLocInd.CoprodTree.factor (FFac T) j).inv_mem ⟨d, rfl⟩
  have h1 : Work.ORLocInd.CoprodTree.vtx (some j)
      ((c : Monoid.CoprodI (FFac T)) * Ks.xx k * Monoid.CoprodI.of d) =
      Work.ORLocInd.CoprodTree.vtx (some j) ((c : Monoid.CoprodI (FFac T)) * Ks.xx k) :=
    Work.ORLocInd.CoprodTree.vtx_some_eq_vtx_some.mpr hmem
  rw [hcd, h1, ← hk]
  exact (Work.ORLocInd.CoprodTree.smul_vtx_some (M := FFac T) (c : Monoid.CoprodI (FFac T))
    (Ks.xx k) (Ks.ii k)).symm

/-- **A `Γ`-orbit relation between leaf orbit representatives determines the index.** -/
theorem cLeaf_orbit_imp (D : CLData (r : G) T) (Ks : CKurosh D) {k l : Ks.Ω}
    (h : ∃ m : ↥(cGam D), Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k) =
      m • Work.ORLocInd.CoprodTree.vtx (some (Ks.ii l)) (Ks.xx l)) :
    Ks.ii k = Ks.ii l ∧ ∃ c : ↥(cGam D), ∃ d : FFac T (Ks.ii k),
      Ks.xx k = (c : Monoid.CoprodI (FFac T)) * Ks.xx l * Monoid.CoprodI.of d := by
  obtain ⟨m, hm⟩ := h
  have hm' : Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k) =
      ((m : ↥(cGam D)) : Monoid.CoprodI (FFac T)) •
        Work.ORLocInd.CoprodTree.vtx (some (Ks.ii l)) (Ks.xx l) := hm
  rw [Work.ORLocInd.CoprodTree.smul_vtx_some] at hm'
  have hidx : Ks.ii k = Ks.ii l := Work.ORLocInd.CoprodTree.idx_eq_of_vtx_some_eq hm'
  rw [← hidx] at hm'
  obtain ⟨e, he⟩ := Work.ORLocInd.CoprodTree.mem_factor.mp
    (Work.ORLocInd.CoprodTree.vtx_some_eq_vtx_some.mp hm')
  have h3 : (m : Monoid.CoprodI (FFac T)) * Ks.xx l = Ks.xx k * Monoid.CoprodI.of e := by
    calc (m : Monoid.CoprodI (FFac T)) * Ks.xx l
        = Ks.xx k * ((Ks.xx k)⁻¹ * ((m : Monoid.CoprodI (FFac T)) * Ks.xx l)) := by group
      _ = Ks.xx k * Monoid.CoprodI.of e := by rw [he]
  exact ⟨hidx, m, e⁻¹, by rw [h3, map_inv]; group⟩

/-- **The centralizer case of the orbit--coset dictionary.** -/
theorem cVg_eq_of_mem_centralizer (D : CLData (r : G) T) {a b : ↥K}
    (h : a⁻¹ * b ∈ Subgroup.centralizer ({r} : Set ↥K)) : cVg D (a : G) = cVg D (b : G) := by
  have hcomm : (r : ↥K) * (a⁻¹ * b) = (a⁻¹ * b) * r :=
    (Subgroup.mem_centralizer_iff.mp h) r (Set.mem_singleton r)
  have hcr : (r : G) * ((a : G)⁻¹ * (b : G)) = ((a : G)⁻¹ * (b : G)) * (r : G) := by
    have := congrArg (fun z : ↥K => (z : G)) hcomm
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using this
  have hrr : (b : G) * (r : G) * (b : G)⁻¹ = (a : G) * (r : G) * (a : G)⁻¹ := by
    calc (b : G) * (r : G) * (b : G)⁻¹
        = (a : G) * ((a : G)⁻¹ * (b : G) * (r : G)) * (b : G)⁻¹ := by group
      _ = (a : G) * ((r : G) * ((a : G)⁻¹ * (b : G))) * (b : G)⁻¹ := by rw [hcr]
      _ = (a : G) * (r : G) * (a : G)⁻¹ := by group
  have hz : cZel D (a : G) = cZel D (b : G) := by
    show cPsi D _ = cPsi D _
    congr 1
    exact Subtype.ext hrr.symm
  refine (cZel_fixed_unique D (a : G) ?_).symm
  rw [hz]
  exact cZel_fixes_cVg D (b : G)

/-- **The normal-closure case of the orbit--coset dictionary.** -/
theorem cVg_orbit_of_mem_normalClosure (D : CLData (r : G) T) {a b : ↥K}
    (h : a⁻¹ * b ∈ Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)) :
    ∃ m : ↥(cGam D), cVg D (a : G) = m • cVg D (b : G) := by
  have hzNK : b * a⁻¹ ∈ Subgroup.normalClosure ({(r : ↥K)} : Set ↥K) := by
    have h1 := Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) (a⁻¹ * b) h a
    rwa [show a * (a⁻¹ * b) * a⁻¹ = b * a⁻¹ from by group] at h1
  have hq : ((b * a⁻¹ : ↥K) : G) ∈ cNKmap (r := r) :=
    Subgroup.mem_map_of_mem K.subtype hzNK
  set M : ↥(cGam D) := cGamOf D ⟨((b * a⁻¹ : ↥K) : G), hq⟩ with hM
  have hconj : (M : Monoid.CoprodI (FFac T)) * cZel D (a : G) *
      ((M : ↥(cGam D)) : Monoid.CoprodI (FFac T))⁻¹ = cZel D (b : G) := by
    rw [hM, cGamOf_coe, cZel, cZel, ← map_inv, ← map_mul, ← map_mul]
    congr 1
    apply Subtype.ext
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_inclusion]
    group
  have hcomm : cZel D (a : G) * (((M⁻¹ : ↥(cGam D)) : Monoid.CoprodI (FFac T))) =
      (((M⁻¹ : ↥(cGam D)) : Monoid.CoprodI (FFac T))) * cZel D (b : G) := by
    have hconj' : cZel D (a : G) = ((M : Monoid.CoprodI (FFac T)))⁻¹ * cZel D (b : G) *
        (M : Monoid.CoprodI (FFac T)) := by
      rw [← hconj]
      group
    have hM1 : (((M⁻¹ : ↥(cGam D)) : Monoid.CoprodI (FFac T))) =
        ((M : Monoid.CoprodI (FFac T)))⁻¹ := map_inv (Subgroup.subtype (cGam D)) M
    rw [hM1, hconj']
    group
  refine ⟨M⁻¹, ?_⟩
  have hfix : cZel D (a : G) • ((M⁻¹ : ↥(cGam D)) • cVg D (b : G)) =
      (M⁻¹ : ↥(cGam D)) • cVg D (b : G) := by
    show cZel D (a : G) • ((((M⁻¹ : ↥(cGam D)) : Monoid.CoprodI (FFac T))) • cVg D (b : G)) = _
    rw [← mul_smul, hcomm, mul_smul, cZel_fixes_cVg]
    rfl
  exact (cZel_fixed_unique D (a : G) hfix).symm

/-- **A conjugate of `r` that is a power of `r` (the form used for the orbit dictionary).** -/
theorem cInj_aux (D : CLData (r : G) T) (E : KTransversal r) {t t' : ↥K}
    (h : ∃ m : ↥(cGam D), cVg D (t : G) = m • cVg D (t' : G)) : t⁻¹ * t' ∈ KH r := by
  obtain ⟨m, hm⟩ := h
  obtain ⟨m₁, hm₁⟩ := cVg_orbit D E t
  obtain ⟨m₂, hm₂⟩ := cVg_orbit D E t'
  have hq : kRep E t = kRep E t' := by
    refine congrArg Subtype.val (cInj D E ⟨kRep E t, kRep_mem E t⟩
      ⟨kRep E t', kRep_mem E t'⟩ ?_)
    refine ⟨m₁⁻¹ * m * m₂, ?_⟩
    calc cVg D ((kRep E t : ↥K) : G)
        = m₁⁻¹ • cVg D (t : G) := by
          rw [hm₁]
          exact (inv_smul_smul m₁ (cVg D ((kRep E t : ↥K) : G))).symm
      _ = m₁⁻¹ • (m • cVg D (t' : G)) := by rw [hm]
      _ = m₁⁻¹ • (m • (m₂ • cVg D ((kRep E t' : ↥K) : G))) := by rw [← hm₂]
      _ = (m₁⁻¹ * m * m₂) • cVg D ((kRep E t' : ↥K) : G) := by rw [mul_smul, mul_smul]
  have hspec : t⁻¹ * kRep E t ∈ KH r := kRep_spec E t
  have hspec' : t'⁻¹ * kRep E t' ∈ KH r := kRep_spec E t'
  have hsplit : t⁻¹ * t' = (t⁻¹ * kRep E t) * ((kRep E t)⁻¹ * t') := by group
  rw [hsplit]
  refine (KH r).mul_mem hspec ?_
  rw [hq]
  have hinv : (kRep E t')⁻¹ * t' = (t'⁻¹ * kRep E t')⁻¹ := by group
  rw [hinv]
  exact (KH r).inv_mem hspec'

/-- **A nontrivial `Γ`-isolated vertex whose label lives in `K`.** -/
noncomputable def ttK (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (k : {k : Ks.Ω // cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥}) : ↥K :=
  ⟨ctLbl D Ks k.1, ctLbl_mem D Ks hmal k.1 k.2⟩

/-- A fixed choice of transversal of `K/(⟪r⟫_K ⊔ C_K(r))`. -/
noncomputable def cETransv (r : ↥K) : KTransversal r := Classical.choice (nonempty_KTransversal r)

/-- **The orbit--coset dictionary, easy direction.**  A `Γ`-orbit relation between the vertices of
two elements of `K` forces the elements to differ by an element of `KH r`. -/
theorem cOrbit_mem_KH (D : CLData (r : G) T) {t t' : ↥K}
    (h : ∃ m : ↥(cGam D), cVg D (t : G) = m • cVg D (t' : G)) : t⁻¹ * t' ∈ KH r :=
  cInj_aux D (cETransv r) h

/-- **The orbit--coset dictionary, hard direction.**  Elements of `K` that differ by an element of
`KH r` have vertices in the same `Γ`-orbit. -/
theorem cOrbit_of_mem_KH (D : CLData (r : G) T) {t t' : ↥K} (h : t⁻¹ * t' ∈ KH r) :
    ∃ m : ↥(cGam D), cVg D (t : G) = m • cVg D (t' : G) := by
  obtain ⟨n, hn, c, hc, hnc⟩ := Subgroup.mem_sup_of_normal_left.mp h
  have h1 : (t * n)⁻¹ * t' ∈ Subgroup.centralizer ({r} : Set ↥K) := by
    have hc' : (t * n)⁻¹ * t' = c := by
      calc (t * n)⁻¹ * t' = n⁻¹ * (t⁻¹ * t') := by group
        _ = n⁻¹ * (n * c) := by rw [← hnc]
        _ = c := by group
    rw [hc']
    exact hc
  have h2 : t⁻¹ * (t * n) ∈ Subgroup.normalClosure ({(r : ↥K)} : Set ↥K) := by
    rw [show t⁻¹ * (t * n) = n from by group]
    exact hn
  obtain ⟨m, hm⟩ := cVg_orbit_of_mem_normalClosure D h2
  exact ⟨m, by rw [hm, cVg_eq_of_mem_centralizer D h1]⟩

/-- **Every `K`-element is covered by the labels.** -/
theorem cExists_lbl (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (t : ↥K) : ∃ k : {k : Ks.Ω // cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥},
      t⁻¹ * ttK D Ks hmal k ∈ KH r := by
  obtain ⟨k, m, hm⟩ := cLeaf_cover D Ks (ctRep D (t : G)) (cPsi D (cUel D (t : G)))
  have hV : Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k) =
      m⁻¹ • cVg D (t : G) := by
    rw [cVg, hm, inv_smul_smul]
  have hk : cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥ := by
    intro hbot
    have hmem : m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m ∈
        MulAction.stabilizer ↥(cGam D)
          (Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k)) := by
      rw [hV, MulAction.stabilizer_smul_eq_stabilizer_map_conj, Subgroup.mem_map]
      refine ⟨⟨cZel D (t : G), cZel_mem_cGam D t⟩, cZel_mem_stabGam D t, ?_⟩
      apply Subtype.ext
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv]
      group
    have hne : m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m ≠ 1 := by
      intro h1
      have h2 : (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) = 1 := by
        calc (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D))
            = m * (m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m) * m⁻¹ := by
              group
          _ = 1 := by rw [h1]; group
      have h3 := congrArg (fun z : ↥(cGam D) => (z : Monoid.CoprodI (FFac T))) h2
      simp only [Subgroup.coe_one] at h3
      exact cZel_ne_one D (t : G) h3
    have hmem' : (((m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m :
        ↥(cGam D))) : Monoid.CoprodI (FFac T)) ∈ cF D Ks.Ω Ks.ii Ks.xx k := by
      rw [cF_eq_stab, Subgroup.mem_inf]
      exact ⟨(m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m :
          ↥(cGam D)).2, Subgroup.mem_subgroupOf.mp hmem⟩
    have h2 : (((m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m :
        ↥(cGam D))) : Monoid.CoprodI (FFac T)) = 1 :=
      (Subgroup.eq_bot_iff_forall (cF D Ks.Ω Ks.ii Ks.xx k)).mp hbot
        (((m⁻¹ * (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) * m :
          ↥(cGam D))) : Monoid.CoprodI (FFac T)) hmem'
    exact hne (Subtype.ext h2)
  refine ⟨⟨k, hk⟩, ?_⟩
  have hmC : cVg D (t : G) = m • Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k)) (Ks.xx k) := hm
  refine cOrbit_mem_KH D ⟨m, ?_⟩
  rw [hmC, cVert_eq_cVg]
  rfl

/-- **The labels are pairwise distinct modulo `KH r`.** -/
theorem cUniq_lbl (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (t : ↥K) {k l : {k : Ks.Ω // cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥}}
    (hk : t⁻¹ * ttK D Ks hmal k ∈ KH r) (hl : t⁻¹ * ttK D Ks hmal l ∈ KH r) : k = l := by
  have h1 : (ttK D Ks hmal k)⁻¹ * (ttK D Ks hmal l) ∈ KH r := by
    have hk' : (ttK D Ks hmal k)⁻¹ * t ∈ KH r := by
      have h := (KH r).inv_mem hk
      rwa [mul_inv_rev, inv_inv] at h
    have hsplit : (ttK D Ks hmal k)⁻¹ * (ttK D Ks hmal l)
        = ((ttK D Ks hmal k)⁻¹ * t) * (t⁻¹ * ttK D Ks hmal l) := by group
    rw [hsplit]
    exact (KH r).mul_mem hk' hl
  obtain ⟨m, hm⟩ := cOrbit_of_mem_KH D h1
  have h2 : ∃ m : ↥(cGam D),
      Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k.1)) (Ks.xx k.1) =
        m • Work.ORLocInd.CoprodTree.vtx (some (Ks.ii l.1)) (Ks.xx l.1) :=
    ⟨m, by rw [cVert_eq_cVg, cVert_eq_cVg]; exact hm⟩
  obtain ⟨hidx, c, d, hcd⟩ := cLeaf_orbit_imp D Ks h2
  exact Subtype.ext (Ks.hinj k.1 l.1 hidx ⟨c, d, hcd⟩)

/-- **The labels are injective.** -/
theorem ttK_injective (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    Function.Injective (ttK D Ks hmal) := by
  intro k l hkl
  have h2 : ∃ m : ↥(cGam D),
      Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k.1)) (Ks.xx k.1) =
        m • Work.ORLocInd.CoprodTree.vtx (some (Ks.ii l.1)) (Ks.xx l.1) := by
    refine ⟨1, ?_⟩
    rw [one_smul]
    calc Work.ORLocInd.CoprodTree.vtx (some (Ks.ii k.1)) (Ks.xx k.1)
        = cVg D (ctLbl D Ks k.1) := cVert_eq_cVg D Ks k.1
      _ = cVg D ((ttK D Ks hmal k : ↥K) : G) := rfl
      _ = cVg D ((ttK D Ks hmal l : ↥K) : G) := by rw [hkl]
      _ = cVg D (ctLbl D Ks l.1) := rfl
      _ = Work.ORLocInd.CoprodTree.vtx (some (Ks.ii l.1)) (Ks.xx l.1) :=
        (cVert_eq_cVg D Ks l.1).symm
  obtain ⟨hidx, c, d, hcd⟩ := cLeaf_orbit_imp D Ks h2
  exact Subtype.ext (Ks.hinj k.1 l.1 hidx ⟨c, d, hcd⟩)

/-- **The labels form a transversal of `K/(⟪r⟫_K ⊔ C_K(r))`.** -/
theorem cTransversal (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    ∀ t : ↥K, ∃! s : ↥K, s ∈ Set.range (ttK D Ks hmal) ∧ t⁻¹ * s ∈ KH r := by
  intro t
  obtain ⟨k, hk⟩ := cExists_lbl D Ks hmal t
  refine ⟨ttK D Ks hmal k, ⟨⟨k, rfl⟩, hk⟩, ?_⟩
  rintro s ⟨⟨l, rfl⟩, hsl⟩
  rw [cUniq_lbl D Ks hmal t hsl hk]

end KuroshDescent

/-! ## The assembly: the Cohen--Lyndon datum for `r` in `K` -/

section Assembly

variable {K : Subgroup G} {r : K} {T : Set G}

/-- The leaf orbits with non-trivial `Γ`-stabiliser. -/
abbrev Ωnt (D : CLData (r : G) T) (Ks : CKurosh D) : Type u :=
  {k : Ks.Ω // cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥}

/-- The generator of the free product on one generator, as an element of the factor. -/
theorem freeGroupCoprodIHom_of (Ω : Type u) (k : Ω) :
    freeGroupCoprodIHom Ω (FreeGroup.of k) =
      Monoid.CoprodI.of (M := fun _ : Ω => FreeGroup (ULift.{u, 0} PUnit)) (i := k)
        (FreeGroup.of (ULift.up PUnit.unit)) :=
  Classical.choose_spec (freeGroup_equiv_coprodI (X := fun _ : Ω => ULift.{u, 0} PUnit)
    (e := sigmaPUnitEquiv Ω)) k

/-- **The stabiliser of the vertex of an element of `K` is infinite cyclic.** -/
noncomputable def cCycEquivK (D : CLData (r : G) T) (t : ↥K) :
    FreeGroup (ULift.{u, 0} PUnit) ≃*
      ↥(MulAction.stabilizer ↥(cGam D) (cVg D (t : G))) := by
  classical
  have hgen : (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D))
      ∈ (MulAction.stabilizer ↥(cGam D) (cVg D (t : G))) := by
    rw [cStab_cVg D t]
    exact Subgroup.mem_zpowers _
  let gen : ↥(MulAction.stabilizer ↥(cGam D) (cVg D (t : G))) :=
    ⟨⟨cZel D (t : G), cZel_mem_cGam D t⟩, hgen⟩
  let f : FreeGroup (ULift.{u, 0} PUnit) →*
      ↥(MulAction.stabilizer ↥(cGam D) (cVg D (t : G))) := FreeGroup.lift fun _ => gen
  have hhom : (cChar (T := T) (ctRep D (t : G))).comp
        ((Subgroup.subtype (cGam D)).comp ((Subgroup.subtype
          (MulAction.stabilizer ↥(cGam D) (cVg D (t : G)))).comp f))
      = FreeGroup.lift fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ) := by
    apply FreeGroup.ext_hom
    intro u
    simp only [MonoidHom.comp_apply, f, FreeGroup.lift_apply_of]
    exact cChar_cZel D (t : G)
  have hval : ∀ x : FreeGroup (ULift.{u, 0} PUnit),
      cChar (T := T) (ctRep D (t : G)) ((↑(f x) : ↥(cGam D)) : Monoid.CoprodI (FFac T))
        = (FreeGroup.lift fun _ : ULift.{u, 0} PUnit => Multiplicative.ofAdd (1 : ℤ)) x := by
    intro x
    have h := congrArg
      (fun (φ : FreeGroup (ULift.{u, 0} PUnit) →* Multiplicative ℤ) => φ x) hhom
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply, MonoidHom.comp_apply] at h
    exact h
  refine MulEquiv.ofBijective (f := f) ⟨?_, ?_⟩
  · intro a b hab
    have h3 := congrArg (fun z : ↥(MulAction.stabilizer ↥(cGam D) (cVg D (t : G))) =>
      cChar (T := T) (ctRep D (t : G)) ((z : ↥(cGam D)) : Monoid.CoprodI (FFac T))) hab
    rw [hval a, hval b] at h3
    exact freeGroupOne_lift_injective h3
  · intro y
    have hy : (y : ↥(cGam D)) ∈ Subgroup.zpowers
        (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) := by
      rw [← cStab_cVg D t]
      exact y.2
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hy
    refine ⟨FreeGroup.of (ULift.up PUnit.unit) ^ k, ?_⟩
    apply Subtype.ext
    show ((f (FreeGroup.of (ULift.up PUnit.unit) ^ k) : ↥(cGam D)) :
        ↥(cGam D)) = (y : ↥(cGam D))
    rw [show f (FreeGroup.of (ULift.up PUnit.unit) ^ k) = gen ^ k from by
      rw [map_zpow, show f (FreeGroup.of (ULift.up PUnit.unit)) = gen from
        FreeGroup.lift_apply_of]]
    exact hk

theorem cCycEquivK_of (D : CLData (r : G) T) (t : ↥K) (u : ULift.{u, 0} PUnit) :
    cCycEquivK D t (FreeGroup.of u) =
      ⟨⟨cZel D (t : G), cZel_mem_cGam D t⟩, cZel_mem_stabGam D t⟩ := by
  rw [show cCycEquivK D t (FreeGroup.of u) = FreeGroup.lift (fun _ : ULift.{u, 0} PUnit =>
      (⟨⟨cZel D (t : G), cZel_mem_cGam D t⟩, cZel_mem_stabGam D t⟩ :
        ↥(MulAction.stabilizer ↥(cGam D) (cVg D (t : G))))) (FreeGroup.of u) from rfl]
  rw [FreeGroup.lift_apply_of]

/-- The family of factors of the Kurosh decomposition of `Γ`. -/
abbrev cFFam (D : CLData (r : G) T) (Ks : CKurosh D) : Ks.Ω → Type u :=
  fun k => ↥(cF D Ks.Ω Ks.ii Ks.xx k)

/-- The same family, restricted to the leaf orbits with non-trivial stabiliser. -/
abbrev cFFamNt (D : CLData (r : G) T) (Ks : CKurosh D) : Ωnt D Ks → Type u :=
  fun k => ↥(cF D Ks.Ω Ks.ii Ks.xx k.val)

/-- The family of stabilisers of the labels. -/
abbrev cStabFam (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    Ωnt D Ks → Type u :=
  fun k => ↥(MulAction.stabilizer ↥(cGam D) (cVg D ((ttK D Ks hmal k : ↥K) : G)))

/-- The family of cyclic factors. -/
abbrev cCycFam (ι : Type u) : ι → Type u := fun _ => FreeGroup (ULift.{u, 0} PUnit)

/-- The coproduct congruence replacing the cyclic factors by the stabilisers. -/
noncomputable def cCoOne (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    Monoid.CoprodI (cCycFam (Ωnt D Ks)) ≃* Monoid.CoprodI (cStabFam D Ks hmal) :=
  Classical.choose (Work.ORBassSerre.Action.CoprodI.coprodI_congr
    (M := cCycFam (Ωnt D Ks)) (N := cStabFam D Ks hmal)
    (fun k : Ωnt D Ks => cCycEquivK D (ttK D Ks hmal k)))

theorem cCoOne_of (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (k : Ωnt D Ks) (x : cCycFam (Ωnt D Ks) k) :
    cCoOne D Ks hmal (Monoid.CoprodI.of (M := cCycFam (Ωnt D Ks)) (i := k) x) =
      Monoid.CoprodI.of (M := cStabFam D Ks hmal) (i := k)
        (cCycEquivK D (ttK D Ks hmal k) x) :=
  Classical.choose_spec (Work.ORBassSerre.Action.CoprodI.coprodI_congr
    (M := cCycFam (Ωnt D Ks)) (N := cStabFam D Ks hmal)
    (fun k : Ωnt D Ks => cCycEquivK D (ttK D Ks hmal k))) k x

/-- The coproduct congruence passing to the factors of the Kurosh decomposition. -/
noncomputable def cCoTwo (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    Monoid.CoprodI (cStabFam D Ks hmal) ≃* Monoid.CoprodI (cFFamNt D Ks) :=
  Classical.choose (Work.ORBassSerre.Action.CoprodI.coprodI_congr
    (M := cStabFam D Ks hmal) (N := cFFamNt D Ks)
    (fun k : Ωnt D Ks => (cFEquiv D Ks k.val).symm))

theorem cCoTwo_of (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (k : Ωnt D Ks) (x : cStabFam D Ks hmal k) :
    cCoTwo D Ks hmal (Monoid.CoprodI.of (M := cStabFam D Ks hmal) (i := k) x) =
      Monoid.CoprodI.of (M := cFFamNt D Ks) (i := k) ((cFEquiv D Ks k.val).symm x) :=
  Classical.choose_spec (Work.ORBassSerre.Action.CoprodI.coprodI_congr
    (M := cStabFam D Ks hmal) (N := cFFamNt D Ks)
    (fun k : Ωnt D Ks => (cFEquiv D Ks k.val).symm)) k x

/-- **Dropping the trivial factors of the Kurosh decomposition.** -/
noncomputable def cDropTrivOne (D : CLData (r : G) T) (Ks : CKurosh D) :
    Monoid.CoprodI (cFFamNt D Ks) ≃* Monoid.CoprodI (cFFam D Ks) := by
  classical
  refine MonoidHom.toMulEquiv
    (Monoid.CoprodI.lift (fun k : Ωnt D Ks => Monoid.CoprodI.of
      (M := cFFam D Ks) (i := (k : Ks.Ω))))
    (Monoid.CoprodI.lift (fun k : Ks.Ω => if h : cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥ then
      Monoid.CoprodI.of (M := cFFamNt D Ks) (i := (⟨k, h⟩ : Ωnt D Ks)) else 1)) ?_ ?_
  · apply Monoid.CoprodI.ext_hom
    intro k
    rw [MonoidHom.comp_assoc, Monoid.CoprodI.lift_comp_of, Monoid.CoprodI.lift_comp_of]
    apply MonoidHom.ext
    intro x
    rw [dif_pos k.2]
    rfl
  · apply Monoid.CoprodI.ext_hom
    intro k
    rw [MonoidHom.comp_assoc, Monoid.CoprodI.lift_comp_of]
    by_cases h : cF D Ks.Ω Ks.ii Ks.xx k ≠ ⊥
    · rw [dif_pos h, Monoid.CoprodI.lift_comp_of]
      apply MonoidHom.ext
      intro x
      rfl
    · rw [dif_neg h]
      apply MonoidHom.ext
      intro x
      simp only [MonoidHom.comp_apply, MonoidHom.id_apply]
      have hx : x = 1 := by
        have h1 := (Subgroup.eq_bot_iff_forall (cF D Ks.Ω Ks.ii Ks.xx k)).mp (not_not.mp h)
        exact Subtype.ext (h1 (x : Monoid.CoprodI (FFac T)) x.2)
      rw [hx]
      simp

theorem cDropTrivOne_of (D : CLData (r : G) T) (Ks : CKurosh D)
    (k : Ωnt D Ks) (x : cFFamNt D Ks k) :
    cDropTrivOne D Ks (Monoid.CoprodI.of (M := cFFamNt D Ks) (i := k) x) =
      Monoid.CoprodI.of (M := cFFam D Ks) (i := (k : Ks.Ω)) x := by
  rw [show cDropTrivOne D Ks (Monoid.CoprodI.of (M := cFFamNt D Ks) (i := k) x) =
      Monoid.CoprodI.lift (fun k : Ωnt D Ks => Monoid.CoprodI.of
        (M := cFFam D Ks) (i := (k : Ks.Ω)))
      (Monoid.CoprodI.of (M := cFFamNt D Ks) (i := k) x) from rfl]
  rw [Monoid.CoprodI.lift_of]

/-- The `K`-conjugate of `r`, as an element of `cNKmap = ⟪r⟫_K` viewed in `G`. -/
noncomputable def cNKel (t : ↥K) : ↥(cNKmap (r := r)) :=
  ⟨(t : G) * (r : G) * (t : G)⁻¹, Subgroup.mem_map_of_mem K.subtype
    (Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal) r
      (Subgroup.subset_normalClosure (Set.mem_singleton r)) t)⟩

theorem cNKEquivGam_cNKel (D : CLData (r : G) T) (t : ↥K) :
    cNKEquivGam D (cNKel (r := r) t) = (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) := by
  apply Subtype.ext
  show cPsi D (Subgroup.inclusion (chNK (r := r)) (cNKel (r := r) t)) = cZel D (t : G)
  rw [show Subgroup.inclusion (chNK (r := r)) (cNKel (r := r) t) =
      (⟨(t : G) * (r : G) * (t : G)⁻¹, cmemConj (r := r) (t : G)⟩ :
        ↥(Subgroup.normalClosure ({(r : G)} : Set G))) from Subtype.ext rfl]
  rfl

/-- The value of `cNKEquiv` on the group element. -/
theorem cNKEquiv_coe (D : CLData (r : G) T) (q : ↥(cNKmap (r := r))) :
    ((((cNKEquiv D q : ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))) : ↥K)) : G) = (q : G) := by
  have h := (Subgroup.equivMapOfInjective (Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))
    K.subtype (fun a b h => Subtype.ext h)).apply_symm_apply q
  exact congrArg Subtype.val h

/-- **The value of `cGamEquivN` on the generator attached to an element of `K`.** -/
theorem cGamEquivN_sub (D : CLData (r : G) T) (t : ↥K) :
    cGamEquivN D (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) = cNKEquiv D (cNKel (r := r) t) := by
  rw [cGamEquivN, MulEquiv.trans_apply, ← cNKEquivGam_cNKel D t, MulEquiv.symm_apply_apply]

/-- **The `K`-value of the generator of the free product attached to `t`.** -/
theorem cGamEquivN_sub_coe (D : CLData (r : G) T) (t : ↥K) :
    ((cGamEquivN D (⟨cZel D (t : G), cZel_mem_cGam D t⟩ : ↥(cGam D)) :
        ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))) : ↥K) = t * r * t⁻¹ := by
  apply Subtype.ext
  rw [cGamEquivN_sub, cNKEquiv_coe]
  rfl

/-- **The free product description of `⟪r⟫_K` over the leaf orbits.** -/
noncomputable def cFullEquiv (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    FreeGroup (Ωnt D Ks) ≃* ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)) :=
  (freeGroupCoprodIHom (Ωnt D Ks)).trans
    ((cCoOne D Ks hmal).trans ((cCoTwo D Ks hmal).trans
      ((cDropTrivOne D Ks).trans ((Ks.e).trans (cGamEquivN D)))))

theorem cFullEquiv_of (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (k : Ωnt D Ks) :
    ((cFullEquiv D Ks hmal (FreeGroup.of k) :
        ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))) : ↥K) =
      (ttK D Ks hmal k : ↥K) * r * ((ttK D Ks hmal k : ↥K))⁻¹ := by
  have h1 : cFullEquiv D Ks hmal (FreeGroup.of k) =
      cGamEquivN D (Ks.e (cDropTrivOne D Ks (cCoTwo D Ks hmal (cCoOne D Ks hmal
        (freeGroupCoprodIHom (Ωnt D Ks) (FreeGroup.of k)))))) := by
    rw [cFullEquiv, MulEquiv.trans_apply, MulEquiv.trans_apply, MulEquiv.trans_apply,
      MulEquiv.trans_apply, MulEquiv.trans_apply]
  rw [h1, freeGroupCoprodIHom_of, cCoOne_of, cCycEquivK_of, cCoTwo_of]
  have hsym : (cFEquiv D Ks k.val).symm
      (⟨⟨cZel D ((ttK D Ks hmal k : ↥K) : G), cZel_mem_cGam D (ttK D Ks hmal k)⟩,
        cZel_mem_stabGam D (ttK D Ks hmal k)⟩ : cStabFam D Ks hmal k) =
      (⟨cZel D ((ttK D Ks hmal k : ↥K) : G), by
        rw [cF_eq_stab_zpowers, Subgroup.mem_inf]
        exact ⟨cZel_mem_cGam D _, Subgroup.mem_zpowers _⟩⟩ :
          ↥(cF D Ks.Ω Ks.ii Ks.xx k.val)) := by
    apply Subtype.ext
    exact cFEquiv_symm_apply D Ks k.val _
  rw [hsym, cDropTrivOne_of]
  rw [Ks.he, cGamEquivN_sub_coe]

/-- **The Cohen--Lyndon datum for `r` in `K`.** -/
noncomputable def cTprimeEquiv (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    FreeGroup ↥(Set.range (ttK D Ks hmal)) ≃*
      ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K)) :=
  (FreeGroup.freeGroupCongr (Equiv.ofInjective (ttK D Ks hmal)
    (ttK_injective D Ks hmal))).symm.trans (cFullEquiv D Ks hmal)

theorem cTprimeEquiv_of (D : CLData (r : G) T) (Ks : CKurosh D)
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K)
    (k : Ωnt D Ks) :
    ((cTprimeEquiv D Ks hmal (FreeGroup.of ⟨ttK D Ks hmal k, ⟨k, rfl⟩⟩) :
        ↥(Subgroup.normalClosure ({(r : ↥K)} : Set ↥K))) : ↥K) =
      (ttK D Ks hmal k : ↥K) * r * ((ttK D Ks hmal k : ↥K))⁻¹ := by
  have h1 : cTprimeEquiv D Ks hmal (FreeGroup.of ⟨ttK D Ks hmal k, ⟨k, rfl⟩⟩) =
      cFullEquiv D Ks hmal (FreeGroup.of k) := by
    rw [cTprimeEquiv, MulEquiv.trans_apply]
    congr 1
    have hfree : (FreeGroup.freeGroupCongr (Equiv.ofInjective (ttK D Ks hmal)
        (ttK_injective D Ks hmal))).symm (FreeGroup.of ⟨ttK D Ks hmal k, ⟨k, rfl⟩⟩) =
        FreeGroup.of ((Equiv.ofInjective (ttK D Ks hmal)
          (ttK_injective D Ks hmal)).symm ⟨ttK D Ks hmal k, ⟨k, rfl⟩⟩) := by
      rw [FreeGroup.freeGroupCongr_symm]
      show FreeGroup.map (Equiv.ofInjective (ttK D Ks hmal) (ttK_injective D Ks hmal)).symm
        (FreeGroup.of ⟨ttK D Ks hmal k, ⟨k, rfl⟩⟩) = _
      rw [FreeGroup.map.of]
    rw [hfree]
    congr 1
    apply (Equiv.ofInjective (ttK D Ks hmal) (ttK_injective D Ks hmal)).injective
    rw [Equiv.apply_symm_apply]
    rfl
  rw [h1, cFullEquiv_of]

end Assembly

theorem ks_descent_malnormal {G : Type u} [Group G] {K : Subgroup G} {r : K} (hr : r ≠ 1)
    (h : Work.CohenLyndon.CohenLyndonNC ((r : K) : G))
    (hmal : ∀ x : G, (∃ j : ℤ, j ≠ 0 ∧ (x * (r : G) * x⁻¹) ^ j ∈ K) → x ∈ K) :
    Work.CohenLyndon.CohenLyndonNC r := by
  obtain ⟨T, hT, e, he⟩ := h
  let D : CLData (r : G) T := ⟨hT, e, he⟩
  obtain ⟨Ks⟩ := nonempty_CKurosh (D := D)
  refine ⟨Set.range (ttK D Ks hmal), cTransversal D Ks hmal, cTprimeEquiv D Ks hmal, ?_⟩
  intro t
  obtain ⟨k, hk⟩ := t.2
  have ht : t = ⟨ttK D Ks hmal k, ⟨k, rfl⟩⟩ := Subtype.ext hk.symm
  rw [ht]
  exact cTprimeEquiv_of D Ks hmal k

end Work.ORLocInd.CohenLyndon
