/-
# Setup for the Karrass--Solitar transfer to an HNN extension

This module sets up the Bass--Serre tree of an HNN extension `K ∗_φ` as a `GTree` in the
`Quiver` language of `Work.ORBassSerre`, together with the action of the normal closure `Ncl` of
`of r`, the vertex `vtxOf g = g • base` and the identification

* `stabilizerNcl_vtx`: the `Ncl`-stabilizer of a vertex is a conjugate of `of (⟪r⟫_K)`,
* `closure_stabilizerNcl`: `Ncl` is generated by its vertex stabilizers.
-/
import Mathlib
import Submission.Work.ORLocInd.CohenLyndon.NCForm
import Submission.Work.ORBassSerre.Interface
import Submission.Work.ORBassSerre.HNN.Tree
import Submission.Work.ORBassSerre.Action.Structure.Phi_surjective
-- TEMPORARY: the delegated structure theorem is being proved by a colleague;
-- re-enable this import when it lands.
-- import Submission.Work.ORBassSerre.Action.freeProduct_of_vertexStabilizers
import Submission.Work.ORLocInd.CohenLyndon.hnn_inf_range_eq
import Submission.Work.ORLocInd.CohenLyndon.hnn_conj_mem_range
import Submission.Work.ORDunwoody.Basic
import Submission.Work.ORDunwoody.Lemmas.GraphQuiver
import Submission.Work.ORDunwoody.Lemmas.GraphQuiverTree

set_option autoImplicit false

universe u

namespace Work.ORLocInd.CohenLyndon

open Quiver

section Setup

variable {K : Type u} [Group K] {A B : Subgroup K} {φ : A ≃* B} {r : K}

/-- The HNN extension of the base group. -/
abbrev Ext : Type u := HNNExtension K A B φ

/-- The vertex set of the Bass--Serre tree: the left cosets of the image of `K`. -/
abbrev Vtx : Type u := @Work.ORBassSerre.HNN.VSet K _ A B φ

/-- The Bass--Serre graph of the HNN extension. -/
abbrev bsGraph : SimpleGraph (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  @Work.ORBassSerre.HNN.hnnGraph K _ A B φ

/-- The base vertex. -/
abbrev baseV : (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  @Work.ORBassSerre.HNN.base K _ A B φ

/-- The normal closure of `r` in the base group. -/
abbrev Mcl : Subgroup K := Subgroup.normalClosure ({r} : Set K)

/-- The normal closure of `of r` in the HNN extension. -/
abbrev Ncl : Subgroup (HNNExtension K A B φ) :=
  Subgroup.normalClosure ({HNNExtension.of r} : Set (HNNExtension K A B φ))

/-- The group `Ext` acting on its Bass--Serre tree. -/
def bsgGTree : Work.ORDunwoody.GTree (HNNExtension K A B φ)
    (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) where
  graph := bsGraph
  isTree := @Work.ORBassSerre.HNN.hnnGraph_isTree K _ A B φ
  smul_adj := fun g _ _ h => @Work.ORBassSerre.HNN.smul_adj K _ A B φ g _ _ h

instance : Quiver (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  Work.ORDunwoody.Lemmas.graphQuiver bsGraph

instance : Quiver.HasInvolutiveReverse
    (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  Work.ORDunwoody.Lemmas.graphQuiverHasInvolutiveReverse bsGraph

instance : Work.ORBassSerre.GraphAction (HNNExtension K A B φ)
    (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  Work.ORDunwoody.Lemmas.graphQuiverAction bsgGTree

/-- The `Ncl`-action on the Bass--Serre tree, restricted from the `Ext`-action. -/
instance instMulActionNcl : MulAction ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))
    (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) where
  smul n v := (n : HNNExtension K A B φ) • v
  one_smul v := by
    show ((1 : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))) : HNNExtension K A B φ) • v = v
    rw [Subgroup.coe_one, one_smul]
  mul_smul m n v := by
    change (((m * n : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)))) :
        HNNExtension K A B φ) • v =
      ((m : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))) : HNNExtension K A B φ) •
        (((n : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)))) : HNNExtension K A B φ) • v
    rw [Subgroup.coe_mul, mul_smul]

instance instGraphActionNcl : Work.ORBassSerre.GraphAction
    ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))
    (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  Work.ORBassSerre.graphActionSubgroup _

theorem bsGraph_isTree :
    @Work.ORBassSerre.IsTree (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ))
      (Work.ORDunwoody.Lemmas.graphQuiver bsGraph)
      (Work.ORDunwoody.Lemmas.graphQuiverHasInvolutiveReverse bsGraph) :=
  Work.ORDunwoody.Lemmas.graphQuiver_isTree bsgGTree

end Setup

section Main

variable {K : Type u} [Group K] {A B : Subgroup K} {φ : A ≃* B} {r : K}

/-- The vertex of the Bass--Serre tree associated with an element. -/
noncomputable def vtxOf (g : HNNExtension K A B φ) :
    (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)) :=
  g • baseV (A := A) (B := B) (φ := φ)

theorem vtxOf_eq_qmk (g : HNNExtension K A B φ) :
    vtxOf (A := A) (B := B) (φ := φ) g =
      Work.ORBassSerre.HNN.qmk (A := A) (B := B) (φ := φ) g := by
  rw [vtxOf, show baseV (A := A) (B := B) (φ := φ) =
    Work.ORBassSerre.HNN.qmk (A := A) (B := B) (φ := φ) (1 : HNNExtension K A B φ) from rfl,
    Work.ORBassSerre.HNN.smul_qmk, mul_one]

/-- `of r` fixes the base vertex. -/
theorem rho_fixes_base :
    (HNNExtension.of r : HNNExtension K A B φ) • baseV (A := A) (B := B) (φ := φ) =
      baseV (A := A) (B := B) (φ := φ) := by
  show (HNNExtension.of r : HNNExtension K A B φ) •
      Work.ORBassSerre.HNN.qmk (A := A) (B := B) (φ := φ) 1 = _
  rw [Work.ORBassSerre.HNN.smul_qmk, mul_one]
  simpa using Work.ORBassSerre.HNN.qmk_mul_of
    (A := A) (B := B) (φ := φ) (1 : HNNExtension K A B φ) r

/-- **The stabilizer in `Ncl` of a vertex is a conjugate of `of Mcl`.** -/
theorem stabilizerNcl_vtx (hA : Subgroup.normalClosure ({r} : Set K) ⊓ A = ⊥)
    (hB : Subgroup.normalClosure ({r} : Set K) ⊓ B = ⊥) (g : HNNExtension K A B φ) :
    MulAction.stabilizer ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))
        (vtxOf (A := A) (B := B) (φ := φ) g) =
      (Subgroup.map (MulAut.conj g).toMonoidHom
        (Subgroup.map (HNNExtension.of (A := A) (B := B) (φ := φ))
          (Subgroup.normalClosure ({r} : Set K)))).comap
          (Ncl (A := A) (B := B) (φ := φ) (r := r)).subtype := by
  have hI := hnn_inf_range_eq (A := A) (B := B) (φ := φ) (r := r) hA hB
  ext n
  rw [Subgroup.mem_comap]
  constructor
  · intro hn
    have h1 : ((n : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))) :
        HNNExtension K A B φ) • vtxOf (A := A) (B := B) (φ := φ) g =
        vtxOf (A := A) (B := B) (φ := φ) g :=
      MulAction.mem_stabilizer_iff.mp hn
    have hstab : ((n : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))) :
        HNNExtension K A B φ) ∈ MulAction.stabilizer (HNNExtension K A B φ)
          (vtxOf (A := A) (B := B) (φ := φ) g) :=
      MulAction.mem_stabilizer_iff.mpr h1
    rw [vtxOf_eq_qmk, Work.ORBassSerre.HNN.stabilizer_qmk] at hstab
    obtain ⟨y, hy, hye⟩ := Subgroup.mem_map.mp hstab
    obtain ⟨m, hme⟩ := MonoidHom.mem_range.mp hy
    have hmN : (HNNExtension.of m : HNNExtension K A B φ) ∈
        Ncl (A := A) (B := B) (φ := φ) (r := r) := by
      have hy' : y = g⁻¹ * (n : HNNExtension K A B φ) * g := by
        rw [← hye]
        show y = g⁻¹ * ((MulAut.conj g) y) * g
        rw [MulAut.conj_apply]
        group
      rw [hme, hy']
      simpa [Ncl, inv_inv] using (Subgroup.Normal.conj_mem (Subgroup.normalClosure_normal
        (s := ({HNNExtension.of r} : Set (HNNExtension K A B φ))))
          (n : HNNExtension K A B φ) n.2 g⁻¹)
    have hmM : m ∈ Subgroup.normalClosure ({r} : Set K) := by
      have hy2 : (HNNExtension.of m : HNNExtension K A B φ) ∈
          (Subgroup.normalClosure ({r} : Set K)).map
            (HNNExtension.of (A := A) (B := B) (φ := φ)) := by
        rw [← hI]; exact ⟨hmN, ⟨m, rfl⟩⟩
      obtain ⟨m', hm', hm'e⟩ := Subgroup.mem_map.mp hy2
      simpa [HNNExtension.of_injective (A := A) (B := B) φ hm'e] using hm'
    have hye' : (MulEquiv.toMonoidHom (MulAut.conj g)) (HNNExtension.of m) =
        (Ncl (A := A) (B := B) (φ := φ) (r := r)).subtype n := by
      rw [hme]; exact hye
    refine Subgroup.mem_map.mpr ⟨HNNExtension.of m, ?_, hye'⟩
    exact Subgroup.mem_map.mpr ⟨m, hmM, rfl⟩
  · rintro ⟨y, hy, hye⟩
    obtain ⟨m, hm, hme⟩ := Subgroup.mem_map.mp hy
    have hye' : (MulEquiv.toMonoidHom (MulAut.conj g)) (HNNExtension.of m) =
        (Ncl (A := A) (B := B) (φ := φ) (r := r)).subtype n := by
      rw [hme]; exact hye
    have hne : (n : HNNExtension K A B φ) =
        (MulAut.conj g (HNNExtension.of m) : HNNExtension K A B φ) := hye'.symm
    refine MulAction.mem_stabilizer_iff.mpr ?_
    show ((n : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r))) : HNNExtension K A B φ) •
        vtxOf (A := A) (B := B) (φ := φ) g = vtxOf (A := A) (B := B) (φ := φ) g
    rw [hne, MulAut.conj_apply]
    have hmv : (HNNExtension.of m : HNNExtension K A B φ) • baseV (A := A) (B := B) (φ := φ) =
        baseV (A := A) (B := B) (φ := φ) := by
      show (HNNExtension.of m : HNNExtension K A B φ) •
          Work.ORBassSerre.HNN.qmk (A := A) (B := B) (φ := φ) 1 = _
      rw [Work.ORBassSerre.HNN.smul_qmk, mul_one]
      simpa using Work.ORBassSerre.HNN.qmk_mul_of
        (A := A) (B := B) (φ := φ) (1 : HNNExtension K A B φ) m
    calc (g * HNNExtension.of m * g⁻¹ : HNNExtension K A B φ) •
          ((g : HNNExtension K A B φ) • baseV (A := A) (B := B) (φ := φ))
        = (g * HNNExtension.of m * g⁻¹ * g) • baseV (A := A) (B := B) (φ := φ) := by
          rw [← mul_smul]
      _ = (g * HNNExtension.of m) • baseV (A := A) (B := B) (φ := φ) := by
          rw [mul_assoc, inv_mul_cancel, mul_one]
      _ = g • baseV (A := A) (B := B) (φ := φ) := by
          rw [mul_smul, hmv]

/-- **`Ncl` is generated by its vertex stabilizers.** -/
theorem closure_stabilizerNcl :
    Subgroup.closure (⋃ v : (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)),
      (MulAction.stabilizer ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) v :
        Set ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)))) = ⊤ := by
  rw [show (⋃ v : (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)),
      (MulAction.stabilizer ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) v :
        Set ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)))) =
      {g : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) | ∃ v :
        (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)),
        g ∈ MulAction.stabilizer ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) v} from
    Set.ext fun g => by simp [Set.mem_iUnion]]
  let K₀ : Subgroup ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) :=
    Subgroup.closure {g : ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) | ∃ v :
      (Work.ORBassSerre.HNN.VSet (G := K) (A := A) (B := B) (φ := φ)),
      g ∈ MulAction.stabilizer ↥(Ncl (A := A) (B := B) (φ := φ) (r := r)) v}
  have hle : Subgroup.normalClosure ({HNNExtension.of r} : Set (HNNExtension K A B φ)) ≤
      K₀.map (Ncl (A := A) (B := B) (φ := φ) (r := r)).subtype := by
    rw [Subgroup.normalClosure]
    refine (Subgroup.closure_le _).mpr ?_
    intro y hy
    rw [Group.mem_conjugatesOfSet_iff] at hy
    obtain ⟨a, ha, hconj⟩ := hy
    rw [Set.mem_singleton_iff] at ha
    subst ha
    obtain ⟨c, rfl⟩ := isConj_iff.mp hconj
    refine Subgroup.mem_map.mpr ⟨⟨c * HNNExtension.of r * c⁻¹, ?_⟩, ?_, rfl⟩
    · exact (Subgroup.normalClosure_normal (s := ({HNNExtension.of r} :
        Set (HNNExtension K A B φ)))).conj_mem _ (Subgroup.subset_normalClosure
          (Set.mem_singleton (HNNExtension.of r))) c
    · refine Subgroup.subset_closure ⟨vtxOf (A := A) (B := B) (φ := φ) c, ?_⟩
      refine MulAction.mem_stabilizer_iff.mpr ?_
      calc (c * HNNExtension.of r * c⁻¹ : HNNExtension K A B φ) •
            ((c : HNNExtension K A B φ) • baseV (A := A) (B := B) (φ := φ))
          = (c * HNNExtension.of r * c⁻¹ * c) • baseV (A := A) (B := B) (φ := φ) := by
            rw [← mul_smul]
        _ = (c * HNNExtension.of r) • baseV (A := A) (B := B) (φ := φ) := by
            rw [mul_assoc, inv_mul_cancel, mul_one]
        _ = c • baseV (A := A) (B := B) (φ := φ) := by
            rw [mul_smul, rho_fixes_base (A := A) (B := B) (φ := φ) (r := r)]
  rw [eq_top_iff]
  intro n _
  have hn : (n : HNNExtension K A B φ) ∈ K₀.map
      (Ncl (A := A) (B := B) (φ := φ) (r := r)).subtype :=
    hle (by simpa [Ncl] using n.2)
  obtain ⟨k, hk, hke⟩ := Subgroup.mem_map.mp hn
  rwa [show k = n from Subtype.ext hke] at hk

end Main

