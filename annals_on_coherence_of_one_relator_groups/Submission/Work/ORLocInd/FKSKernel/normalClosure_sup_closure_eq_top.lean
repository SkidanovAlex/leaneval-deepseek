import Mathlib

namespace Work.ORLocInd.FKSKernel

universe u

/-- The normal closure of a single generator `of a` together with the subgroup
generated by all the other generators is the whole free group: the generators
`of b` for `b ≠ a` lie in the second factor, and `of a` lies in the first, so
together they contain the generating set `Set.range FreeGroup.of`. -/
theorem normalClosure_sup_closure_eq_top {X : Type u} (a : X) :
    Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)) ⊔
      Subgroup.closure (FreeGroup.of '' {b : X | b ≠ a}) = ⊤ := by
  rw [eq_top_iff, ← FreeGroup.closure_range_of X, Subgroup.closure_le]
  rintro _ ⟨b, rfl⟩
  by_cases hb : b = a
  · subst hb
    exact Subgroup.mem_sup_left (Subgroup.subset_normalClosure (by simp))
  · exact Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_image_of_mem _ hb))

end Work.ORLocInd.FKSKernel
