import Mathlib

namespace Work.ORLocInd.FKSKernel

universe u

/-- In the free group `F(X)`, the normal closure of a single generator `FreeGroup.of a` meets the
subgroup generated by all the *other* generators trivially.

Proof: the homomorphism `proj : F(X) →* F(X)` collapsing the generator `a` to `1` and fixing every
other generator has kernel containing `⟪FreeGroup.of a⟫` (that normal closure is generated by an
element of the kernel) and acts as the identity on `closure (FreeGroup.of '' {b | b ≠ a})`.  Hence
any element in the intersection equals its own image under `proj`, which is `1`. -/
theorem normalClosure_inf_closure_eq_bot {X : Type u} (a : X) :
    Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)) ⊓
      Subgroup.closure (FreeGroup.of '' {b : X | b ≠ a}) = ⊥ := by
  classical
  -- the retraction of `F(X)` killing the generator `a`
  let f : X → FreeGroup X := fun b => if b = a then 1 else FreeGroup.of b
  let proj : FreeGroup X →* FreeGroup X := FreeGroup.lift f
  have hproj_of : ∀ b : X, proj (FreeGroup.of b) = f b := fun b => FreeGroup.lift_apply_of
  -- `proj` vanishes on the normal closure of `FreeGroup.of a`
  have hN : Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)) ≤ proj.ker := by
    apply Subgroup.normalClosure_le_normal
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact MonoidHom.mem_ker.mpr (by rw [hproj_of a]; exact if_pos rfl)
  -- the subgroup of points fixed by `proj`
  let fix : Subgroup (FreeGroup X) :=
    { carrier := {x | proj x = x}
      one_mem' := map_one proj
      mul_mem' := fun {x y} hx hy => by
        simp only [Set.mem_ofPred_eq] at hx hy ⊢
        rw [map_mul, hx, hy]
      inv_mem' := fun {x} hx => by
        simp only [Set.mem_ofPred_eq] at hx ⊢
        rw [map_inv, hx] }
  -- `proj` fixes every generator different from `a`, hence the subgroup they generate
  have hC : Subgroup.closure (FreeGroup.of '' {b : X | b ≠ a}) ≤ fix := by
    rw [Subgroup.closure_le]
    rintro y ⟨b, hb, rfl⟩
    show proj (FreeGroup.of b) = FreeGroup.of b
    rw [hproj_of b]
    exact if_neg hb
  -- an element of the intersection is both fixed and killed by `proj`, hence trivial
  apply le_antisymm _ bot_le
  intro x hx
  rw [Subgroup.mem_inf] at hx
  obtain ⟨hxN, hxC⟩ := hx
  have h1 : proj x = 1 := MonoidHom.mem_ker.mp (hN hxN)
  have h2 : proj x = x := hC hxC
  rw [← h2, h1]
  exact Subgroup.mem_bot.mpr rfl

end Work.ORLocInd.FKSKernel
