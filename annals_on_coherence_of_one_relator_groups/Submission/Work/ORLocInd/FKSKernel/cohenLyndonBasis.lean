import Mathlib
import Submission.Work.ORLocInd.Basic
import Submission.Work.ORLocInd.CohenLyndon.freeGroupCohenLyndon

universe u

namespace Work.ORLocInd.FKSKernel

/-- The Cohen--Lyndon basis theorem: for `u ≠ 1` not a proper power in a free group `F(X)`, the
normal closure `⟪u⟫` is freely generated by the conjugates `s u s⁻¹`, one for each coset of `⟪u⟫`.

This is `Work.ORLocInd.CohenLyndon.cohenLyndonIso_freeGroup`, whose conclusion
`Work.CohenLyndon.CohenLyndonIso u` unfolds to exactly the statement below. -/
theorem cohenLyndonBasis {X : Type u} (u : FreeGroup X) (hu : u ≠ 1)
    (hpp : ¬ Work.ORLocInd.IsProperPower u) :
    ∃ (e : FreeGroup (FreeGroup X ⧸ Subgroup.normalClosure ({u} : Set (FreeGroup X))) ≃*
        ↥(Subgroup.normalClosure ({u} : Set (FreeGroup X)))),
      ∀ q : FreeGroup X ⧸ Subgroup.normalClosure ({u} : Set (FreeGroup X)),
        ∃ s : FreeGroup X, QuotientGroup.mk s = q ∧
          ((e (FreeGroup.of q) : ↥(Subgroup.normalClosure ({u} : Set (FreeGroup X)))) : FreeGroup X)
            = s * u * s⁻¹ :=
  Work.ORLocInd.CohenLyndon.cohenLyndonIso_freeGroup u hu hpp

end Work.ORLocInd.FKSKernel
