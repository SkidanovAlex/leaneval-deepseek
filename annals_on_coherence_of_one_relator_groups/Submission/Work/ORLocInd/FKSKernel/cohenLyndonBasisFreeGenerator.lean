/-
# The Cohen--Lyndon basis for the normal closure of a free generator

Let `F = FreeGroup X` be the free group on `X` and let `a : X`.  Write `x = of a`,
`N = normalClosure {x} ≤ F` (the normal closure of the generator `x`) and
`K = closure (of '' {b | b ≠ a}) ≤ F` (the subgroup generated by all the *other* free generators).

This file proves that `N` is *freely* generated by the conjugates `k x k⁻¹`, one for each `k ∈ K`:

`cohenLyndonBasisFreeGenerator` produces an isomorphism
`e : FreeGroup (F ⧸ N) ≃* ↥N` such that, for every coset `q` of `N`, the image `e (of q)` of the
corresponding free generator is conjugate to `x` by an arbitrary lift of `q`.

This is the special case `u = of a` (a *primitive* element) of the Cohen--Lyndon basis theorem for
the normal closure of a non-proper-power element of a free group; it is the case needed for the
Fischer--Karrass--Solitar structure theorem for `ker (⟨X | u ^ l⟩ →* ⟨X | u⟩)`.

## Strategy

Everything rests on the free-product decomposition `F = ⟨x⟩ * K`, re-expressed through the reduced
word theory of `FreeGroup`:

* `clK` and `clN`: the subgroups `K` and `N`;
* `supportedOn_of_mem_clK`, `toWord_avoid_of_mem_clK`: the canonical reduced word of an element of
  `K` never involves the letter `a` (this is `Work.OROneRel.letters_closure_iff`);
* `clHom`: the homomorphism `FreeGroup ↥K →* F`, `of k ↦ k x k⁻¹`, and `clHom_eq_one_iff`: it has
  trivial kernel.  Injectivity is the Cohen--Lyndon content: if a reduced word
  `k₁^{ε₁} ⋯ k_m^{ε_m}` of `FreeGroup ↥K` were killed, then the reduced element
  `k₁ x^{ε₁} k₁⁻¹ ⋯ k_m x^{ε_m} k_m⁻¹` of `F` would be trivial, contradicting
  `exists_blocks_of_isReduced` + `prod_conj_pow_ne_one` (the syllable/normal-form argument for the
  free product `⟨x⟩ * K`).
* `clHom_range`: the image of `clHom` is exactly `N`;
* `clEquiv`: the resulting isomorphism `FreeGroup ↥K ≃* ↥N`;
* `clKEquivQuotient`: the canonical isomorphism `↥K ≃* F ⧸ N` (from `N ⊓ K = ⊥` and
  `N ⊔ K = ⊤`);
* `cohenLyndonEquiv`: the composition, giving the Cohen--Lyndon basis.

The three structural lemmas `normalClosure_inf_closure_eq_bot`, `normalClosure_sup_closure_eq_top`
and `normalClosure_eq_closure_conj`, together with the combinatorial lemmas
`exists_blocks_of_isReduced` and `prod_conj_pow_ne_one`, live in dedicated modules.
-/
import Mathlib
import Submission.Work.OROneRel.letters_closure_iff
import Submission.Work.ORLocInd.FKSKernel.exists_blocks_of_isReduced
import Submission.Work.ORLocInd.FKSKernel.prod_conj_pow_ne_one
import Submission.Work.ORLocInd.FKSKernel.normalClosure_inf_closure_eq_bot
import Submission.Work.ORLocInd.FKSKernel.normalClosure_sup_closure_eq_top
import Submission.Work.ORLocInd.FKSKernel.normalClosure_eq_closure_conj

set_option autoImplicit false

-- `MulEquiv.ofBijective` with a proof of `Function.Bijective` (a `def` unfolding to a conjunction)
-- is not recognised as well-typed at `implicit` transparency; this is the standard workaround.
set_option backward.isDefEq.respectTransparency.types false

namespace Work.ORLocInd.FKSKernel

universe u

open scoped Pointwise

noncomputable section

/-! ## The two subgroups -/

/-- `K`: the subgroup of `FreeGroup X` generated by all the free generators except `a`. -/
abbrev clK {X : Type u} (a : X) : Subgroup (FreeGroup X) :=
  Subgroup.closure (FreeGroup.of '' {b : X | b ≠ a})

/-- `N`: the normal closure of the free generator `of a`. -/
abbrev clN {X : Type u} (a : X) : Subgroup (FreeGroup X) :=
  Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X))

lemma clK_def {X : Type u} (a : X) :
    clK a = Subgroup.closure (FreeGroup.of '' {b : X | b ≠ a}) := rfl

lemma clN_def {X : Type u} (a : X) :
    clN a = Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)) := rfl

/-! ## Elements of `K` have `a`-free reduced words -/

/-- Every element of `K` is supported on the generators different from `a`. -/
lemma supportedOn_of_mem_clK {X : Type u} {a : X} {g : FreeGroup X} (hg : g ∈ clK a) :
    Work.OROneRel.SupportedOn g {b : X | b ≠ a} := by
  rw [clK_def] at hg
  exact (Work.OROneRel.letters_closure_iff g _).mp hg

/-! ## The homomorphism `FreeGroup ↥K →* F`, `of k ↦ k x k⁻¹` -/

/-- The conjugating homomorphism `FreeGroup ↥K →* F(X)`, `of k ↦ k · of a · k⁻¹`. -/
def clHom {X : Type u} (a : X) : FreeGroup ↥(clK a) →* FreeGroup X :=
  FreeGroup.lift (fun k : ↥(clK a) => (k : FreeGroup X) * FreeGroup.of a * (k : FreeGroup X)⁻¹)

lemma clHom_apply_of {X : Type u} (a : X) (k : ↥(clK a)) :
    clHom a (FreeGroup.of k) = (k : FreeGroup X) * FreeGroup.of a * (k : FreeGroup X)⁻¹ :=
  FreeGroup.lift_apply_of

lemma clHom_of_zpow {X : Type u} (a : X) (k : ↥(clK a)) (n : ℤ) :
    clHom a (FreeGroup.of k ^ n)
      = (k : FreeGroup X) * FreeGroup.of a ^ n * (k : FreeGroup X)⁻¹ := by
  rw [map_zpow, clHom_apply_of]
  have h1 : (k : FreeGroup X) * FreeGroup.of a * (k : FreeGroup X)⁻¹
      = (MulAut.conj (k : FreeGroup X)) (FreeGroup.of a) := by
    rw [MulAut.conj_apply]
  rw [h1, ← map_zpow, MulAut.conj_apply]

/-! ## Injectivity of `clHom` (the Cohen--Lyndon content) -/

/-- `clHom` kills only the identity: a nontrivial reduced word `k₁^{ε₁} ⋯ k_m^{ε_m}` in the free
group on `K` is sent to the nontrivial element `k₁ x^{ε₁} k₁⁻¹ ⋯ k_m x^{ε_m} k_m⁻¹` of `F`,
because the `K`-syllables and the powers of `x` alternate in the free product `⟨x⟩ * K`. -/
lemma clHom_eq_one_iff {X : Type u} (a : X) (w : FreeGroup ↥(clK a)) :
    clHom a w = 1 ↔ w = 1 := by
  classical
  constructor
  · intro hw
    have hK : ∀ k : ↥(clK a), ∀ p ∈ (k : FreeGroup X).toWord, p.1 ≠ a := by
      intro k p hp
      exact supportedOn_of_mem_clK (a := a) (g := (k : FreeGroup X)) k.2 ⟨p.2, hp⟩
    set L : List (↥(clK a) × Bool) := w.toWord with hL
    have hred : FreeGroup.IsReduced L := by rw [hL]; exact FreeGroup.isReduced_toWord
    have hmk : FreeGroup.mk L = w := by rw [hL]; exact FreeGroup.mk_toWord
    obtain ⟨M, hMnz, hMch, hMprod, hMnil⟩ := exists_blocks_of_isReduced L hred
    by_cases hM : M = []
    · have hL0 : L = [] := hMnil.mp hM
      rw [← hmk, hL0, FreeGroup.one_eq_mk]
    · exfalso
      have hprod1 :
          (M.map (fun c : ↥(clK a) × ℤ =>
            (c.1 : FreeGroup X) * FreeGroup.of a ^ c.2 * (c.1 : FreeGroup X)⁻¹)).prod = 1 := by
        have h' : clHom a (FreeGroup.mk L) = 1 := by rw [hmk]; exact hw
        rw [hMprod, map_list_prod, List.map_map] at h'
        have hmap : (M.map (clHom a ∘ fun c : ↥(clK a) × ℤ => FreeGroup.of c.1 ^ c.2))
            = (M.map (fun c : ↥(clK a) × ℤ =>
                (c.1 : FreeGroup X) * FreeGroup.of a ^ c.2 * (c.1 : FreeGroup X)⁻¹)) := by
          apply List.map_congr_left
          intro c _
          exact clHom_of_zpow a c.1 c.2
        rw [hmap] at h'
        exact h'
      exact prod_conj_pow_ne_one a (clK a) hK M hM hMnz hMch hprod1
  · intro hw
    rw [hw, map_one]

/-- `clHom` is injective. -/
lemma clHom_injective {X : Type u} (a : X) : Function.Injective (clHom a) := by
  intro w₁ w₂ h
  have h1 : w₁ * w₂⁻¹ = 1 :=
    (clHom_eq_one_iff a (w₁ * w₂⁻¹)).mp (by rw [map_mul, map_inv, h, mul_inv_cancel])
  exact mul_inv_eq_one.mp h1

/-! ## The image of `clHom` is `N` -/

lemma clHom_range {X : Type u} (a : X) : (clHom a).range = clN a := by
  rw [clHom, FreeGroup.range_lift_eq_closure, clN_def, normalClosure_eq_closure_conj a]
  congr 1
  ext g
  constructor
  · rintro ⟨k, rfl⟩
    exact ⟨(k : FreeGroup X), k.2, rfl⟩
  · rintro ⟨k, hk, rfl⟩
    exact ⟨⟨k, hk⟩, rfl⟩

/-! ## The isomorphism `FreeGroup ↥K ≃* ↥N` -/

/-- **The Cohen--Lyndon basis, in the form `FreeGroup ↥K ≃* ↥N`**: the free group on the elements of
`K` is isomorphic to `N = normalClosure {of a}`, the generator `k` of the former corresponding to
the conjugate `k · of a · k⁻¹`. -/
def clEquiv {X : Type u} (a : X) : FreeGroup ↥(clK a) ≃* ↥(clN a) := by
  classical
  have hle : (clHom a).range ≤ clN a := le_of_eq (clHom_range a)
  have hmem : ∀ x : FreeGroup ↥(clK a), clHom a x ∈ clN a :=
    fun x => hle (MonoidHom.mem_range.mpr ⟨x, rfl⟩)
  refine MulEquiv.ofBijective ((clHom a).codRestrict (clN a) hmem) ⟨?_, ?_⟩
  · intro x y hxy
    exact clHom_injective a (by simpa [MonoidHom.codRestrict_apply] using congrArg Subtype.val hxy)
  · intro y
    have hy : (y : FreeGroup X) ∈ (clHom a).range := by
      rw [clHom_range]; exact y.2
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hy
    exact ⟨x, Subtype.ext (by simpa [MonoidHom.codRestrict_apply] using hx)⟩

lemma clEquiv_apply {X : Type u} (a : X) (w : FreeGroup ↥(clK a)) :
    ((clEquiv a w : ↥(clN a)) : FreeGroup X) = clHom a w := by
  show ((MulEquiv.ofBijective _ _ w : ↥(clN a)) : FreeGroup X) = clHom a w
  simp only [MulEquiv.ofBijective_apply, MonoidHom.codRestrict_apply]

/-! ## The transversal `K` of `N`: `↥K ≃* F ⧸ N` -/

lemma clN_inf_clK {X : Type u} (a : X) : clN a ⊓ clK a = ⊥ :=
  normalClosure_inf_closure_eq_bot a

lemma clN_sup_clK {X : Type u} (a : X) : clN a ⊔ clK a = ⊤ :=
  normalClosure_sup_closure_eq_top a

/-- An element of `K` lying in `N` is trivial, because `N ∩ K = 1`. -/
lemma eq_one_of_mem_clN {X : Type u} (a : X) (k : ↥(clK a))
    (hk : (k : FreeGroup X) ∈ clN a) : k = 1 := by
  have h4 : (k : FreeGroup X) ∈ clN a ⊓ clK a := ⟨hk, k.2⟩
  have h5 : (k : FreeGroup X) = 1 := by
    have h6 : (k : FreeGroup X) ∈ (⊥ : Subgroup (FreeGroup X)) := by
      rw [← clN_inf_clK a]
      exact h4
    exact Subgroup.mem_bot.mp h6
  exact Subtype.ext h5

/-- The canonical map from `K` to the quotient `F ⧸ N`, which is a group isomorphism because
`F = N · K` and `N ∩ K = 1`. -/
def clKEquivQuotient {X : Type u} (a : X) : ↥(clK a) ≃* (FreeGroup X ⧸ clN a) := by
  refine MulEquiv.ofBijective ((QuotientGroup.mk' (clN a)).comp (clK a).subtype) ⟨?_, ?_⟩
  · rintro k₁ k₂ h
    have h2 : ((k₁⁻¹ * k₂ : ↥(clK a)) : FreeGroup X) ∈ clN a := by
      have h3 : ((QuotientGroup.mk' (clN a)).comp (clK a).subtype) (k₁⁻¹ * k₂) = 1 := by
        rw [map_mul, map_inv, h, inv_mul_cancel]
      rw [MonoidHom.comp_apply, QuotientGroup.mk'_apply, Subgroup.subtype_apply,
        QuotientGroup.eq_one_iff] at h3
      exact h3
    exact inv_mul_eq_one.mp (eq_one_of_mem_clN a (k₁⁻¹ * k₂) h2)
  · intro q
    obtain ⟨u, hu⟩ := QuotientGroup.mk'_surjective (clN a) q
    have hu' : u ∈ (clN a ⊔ clK a : Subgroup (FreeGroup X)) := by
      rw [clN_sup_clK a]
      exact Subgroup.mem_top u
    have hu2 : u ∈ (((↑(clN a) : Set (FreeGroup X)) *
        (↑(clK a) : Set (FreeGroup X))) : Set (FreeGroup X)) := by
      rw [← Subgroup.normal_mul (clN a) (clK a)]
      exact hu'
    obtain ⟨n, hn, k, hk, hnk⟩ := Set.mem_mul.mp hu2
    refine ⟨⟨k, hk⟩, ?_⟩
    have hn1 : (QuotientGroup.mk' (clN a)) n = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact hn
    show (QuotientGroup.mk' (clN a)) k = q
    rw [← hu, ← hnk, map_mul, hn1, one_mul]

lemma clKEquivQuotient_apply {X : Type u} (a : X) (k : ↥(clK a)) :
    clKEquivQuotient a k = QuotientGroup.mk (k : FreeGroup X) := by
  show ((QuotientGroup.mk' (clN a)).comp (clK a).subtype) k = QuotientGroup.mk (k : FreeGroup X)
  rw [MonoidHom.comp_apply, Subgroup.subtype_apply, QuotientGroup.mk'_apply]

/-! ## The Cohen--Lyndon basis -/

/-- **The Cohen--Lyndon basis for the normal closure of a free generator.**  The free group on the
cosets `F ⧸ N` is isomorphic to `N = normalClosure {of a}`, the free generator corresponding to a
coset `q` being the conjugate `s · of a · s⁻¹` for any lift `s` of `q`. -/
def cohenLyndonEquiv {X : Type u} (a : X) :
    FreeGroup (FreeGroup X ⧸ clN a) ≃* ↥(clN a) :=
  (FreeGroup.freeGroupCongr (clKEquivQuotient a).symm.toEquiv).trans (clEquiv a)

lemma symm_toEquiv_apply {X : Type u} (a : X) (q : FreeGroup X ⧸ clN a) :
    ((clKEquivQuotient a).symm.toEquiv q : ↥(clK a)) = (clKEquivQuotient a).symm q := rfl

lemma cohenLyndonEquiv_apply {X : Type u} (a : X) (q : FreeGroup X ⧸ clN a) :
    ((cohenLyndonEquiv a (FreeGroup.of q) : ↥(clN a)) : FreeGroup X)
      = (((clKEquivQuotient a).symm q : ↥(clK a)) : FreeGroup X) * FreeGroup.of a
        * (((clKEquivQuotient a).symm q : ↥(clK a)) : FreeGroup X)⁻¹ := by
  rw [cohenLyndonEquiv, MulEquiv.trans_apply, FreeGroup.freeGroupCongr_apply, FreeGroup.map.of,
    clEquiv_apply, clHom_apply_of, symm_toEquiv_apply]

theorem cohenLyndonBasisFreeGenerator {X : Type u} (a : X) :
    ∃ (e : FreeGroup (FreeGroup X ⧸ Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X))) ≃*
        ↥(Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)))),
      ∀ q : FreeGroup X ⧸ Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)),
        ∃ s : FreeGroup X, QuotientGroup.mk s = q ∧
          ((e (FreeGroup.of q) : ↥(Subgroup.normalClosure ({FreeGroup.of a} : Set (FreeGroup X)))) :
            FreeGroup X) = s * FreeGroup.of a * s⁻¹ := by
  classical
  refine ⟨cohenLyndonEquiv a,
    fun q => ⟨(((clKEquivQuotient a).symm q : ↥(clK a)) : FreeGroup X), ?_, ?_⟩⟩
  · rw [← clKEquivQuotient_apply a ((clKEquivQuotient a).symm q)]
    exact MulEquiv.apply_symm_apply (clKEquivQuotient a) q
  · exact cohenLyndonEquiv_apply a q

end

end Work.ORLocInd.FKSKernel
