import Mathlib

set_option linter.style.haveILetI false

namespace Work.ORLocInd.FKSKernel

universe u

/-- Monoid homomorphisms out of `Multiplicative (ZMod l)` (with `1 ≤ l`) are determined by the
image of the canonical generator `Multiplicative.ofAdd 1`. -/
lemma zmod_hom_ext {l : ℕ} (hl : 1 ≤ l) {G : Type*} [Group G]
    (f g : Multiplicative (ZMod l) →* G)
    (h : f (Multiplicative.ofAdd 1) = g (Multiplicative.ofAdd 1)) : f = g := by
  haveI : NeZero l := ⟨by omega⟩
  apply MonoidHom.ext
  intro x
  -- every element of `Multiplicative (ZMod l)` is a power of the canonical generator
  have hx : x = Multiplicative.ofAdd (((Multiplicative.toAdd x).val : ℕ) : ZMod l) :=
    (ofAdd_toAdd x).symm.trans
      (congrArg Multiplicative.ofAdd (ZMod.natCast_zmod_val (Multiplicative.toAdd x)).symm)
  rw [hx]
  have hsm : (((Multiplicative.toAdd x).val : ℕ) : ZMod l) =
      (Multiplicative.toAdd x).val • (1 : ZMod l) := by
    rw [nsmul_eq_mul, mul_one]
  rw [hsm, ofAdd_nsmul, map_pow, map_pow, h]

/-- `(Multiplicative.ofAdd 1 : Multiplicative (ZMod l)) ^ l = 1`. -/
lemma ofAdd_one_pow (l : ℕ) : (Multiplicative.ofAdd (1 : ZMod l)) ^ l = 1 := by
  rw [← ofAdd_nsmul, nsmul_eq_mul, mul_one, ZMod.natCast_self]
  rfl

/-- The quotient of the free group on `Q` by the normal closure of the `l`-th powers of the
generators is the free product of `Q` copies of `ℤ/l`. -/
theorem freeGroupQuotientPowCoprodI {Q : Type u} (l : ℕ) (hl : 1 ≤ l) :
    Nonempty ((FreeGroup Q ⧸ Subgroup.normalClosure {x : FreeGroup Q | ∃ q : Q, x = FreeGroup.of q ^ l}) ≃*
      Monoid.CoprodI (fun _ : Q => Multiplicative (ZMod l))) := by
  classical
  have hgen : (Multiplicative.ofAdd (1 : ZMod l)) ^ l = 1 := ofAdd_one_pow l
  -- the normal subgroup generated by the `l`-th powers
  let N : Subgroup (FreeGroup Q) :=
    Subgroup.normalClosure {x : FreeGroup Q | ∃ q : Q, x = FreeGroup.of q ^ l}
  haveI hNnorm : N.Normal := Subgroup.normalClosure_normal
  -- the collapse `F(Q) → ∗_Q ℤ/l`
  let α : FreeGroup Q →* Monoid.CoprodI (fun _ : Q => Multiplicative (ZMod l)) :=
    FreeGroup.lift (fun q : Q => Monoid.CoprodI.of (i := q) (Multiplicative.ofAdd (1 : ZMod l)))
  have hα_of : ∀ q : Q, α (FreeGroup.of q) =
      Monoid.CoprodI.of (i := q) (Multiplicative.ofAdd (1 : ZMod l)) :=
    fun q => FreeGroup.lift_apply_of
  have hSker : {x : FreeGroup Q | ∃ q : Q, x = FreeGroup.of q ^ l} ⊆ α.ker := by
    rintro x ⟨q, rfl⟩
    show α (FreeGroup.of q ^ l) = 1
    rw [map_pow]
    simp only [hα_of]
    rw [← map_pow, hgen, map_one]
  have hNker : N ≤ α.ker := Subgroup.normalClosure_le_normal hSker
  -- the induced map on the quotient
  let ᾱ : (FreeGroup Q ⧸ N) →* Monoid.CoprodI (fun _ : Q => Multiplicative (ZMod l)) :=
    QuotientGroup.lift N α hNker
  have hmem : ∀ q : Q, FreeGroup.of q ^ l ∈ N := fun q => Subgroup.subset_normalClosure ⟨q, rfl⟩
  have hw : ∀ q : Q, (QuotientGroup.mk' N (FreeGroup.of q)) ^ l = 1 := by
    intro q
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hmem q
  -- the maps `ℤ/l → F(Q)/N` sending the generator to the image of `q`
  let f : ∀ q : Q, Multiplicative (ZMod l) →* (FreeGroup Q ⧸ N) := fun q =>
    AddMonoidHom.toMultiplicativeLeft
      (ZMod.lift l ⟨zmultiplesHom (Additive (FreeGroup Q ⧸ N))
        (Additive.ofMul (QuotientGroup.mk' N (FreeGroup.of q))), by
          rw [zmultiplesHom_apply, ← ofMul_zpow, zpow_natCast, hw q]
          simp⟩)
  have hf : ∀ q : Q, f q (Multiplicative.ofAdd (1 : ZMod l)) =
      QuotientGroup.mk' N (FreeGroup.of q) := by
    intro q
    rw [AddMonoidHom.coe_toMultiplicativeLeft]
    simp only [Function.comp_apply]
    rw [toAdd_ofAdd, show (1 : ZMod l) = ((1 : ℤ) : ZMod l) by simp,
      ZMod.lift_coe, zmultiplesHom_apply]
    simp
  -- the map `∗_Q ℤ/l → F(Q)/N`
  let β : Monoid.CoprodI (fun _ : Q => Multiplicative (ZMod l)) →* (FreeGroup Q ⧸ N) :=
    Monoid.CoprodI.lift f
  have hβ_of : ∀ (q : Q) (m : Multiplicative (ZMod l)),
      β (Monoid.CoprodI.of (i := q) m) = f q m :=
    fun q m => Monoid.CoprodI.lift_of (fi := f) (i := q) m
  have hβα_mk : β.comp α = QuotientGroup.mk' N := by
    apply FreeGroup.ext_hom
    intro q
    show β (α (FreeGroup.of q)) = QuotientGroup.mk' N (FreeGroup.of q)
    rw [hα_of, hβ_of]
    exact hf q
  have hβα : β.comp ᾱ = MonoidHom.id (FreeGroup Q ⧸ N) := by
    apply MonoidHom.ext
    intro x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
    have h1 : ᾱ (QuotientGroup.mk' N y) = α y := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.lift_mk']
    show β (ᾱ (QuotientGroup.mk' N y)) = QuotientGroup.mk' N y
    rw [h1]
    exact DFunLike.congr_fun hβα_mk y
  have hαβ : ᾱ.comp β = MonoidHom.id
      (Monoid.CoprodI (fun _ : Q => Multiplicative (ZMod l))) := by
    apply Monoid.CoprodI.ext_hom
    intro q
    apply zmod_hom_ext hl
    simp only [MonoidHom.comp_apply, MonoidHom.id_apply]
    rw [hβ_of, hf q]
    have h1 : ᾱ (QuotientGroup.mk' N (FreeGroup.of q)) = α (FreeGroup.of q) := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.lift_mk']
    rw [h1, hα_of]
  exact ⟨MonoidHom.toMulEquiv ᾱ β hβα hαβ⟩

end Work.ORLocInd.FKSKernel
