/-
# The Bass--Serre tree of a free product of groups: definitions

Let `P = Monoid.CoprodI M` be the free product of a family of groups.  In this file we construct
the *Bass--Serre tree* of the free product: the tree on which `P` acts with vertex stabilisers the
conjugates of the factors `M i` and with trivial edge stabilisers.

The model is the "star" model.  Its vertices are the cosets of the factors `M i` together with the
cosets of the trivial subgroup, which we identify with the elements of `P` itself:

* `vtx none g` is the "central" vertex corresponding to the trivial subgroup's coset `g`;
* `vtx (some i) g` is the coset vertex of `g` modulo the `i`-th factor.

This is the Bass--Serre tree of the free product regarded as the fundamental group of the star
graph of groups with trivial vertex group at the centre and group `M i` at the `i`-th leaf.  It is
the natural tree for our purpose because *all* of its vertex stabilisers are finite (they are
either trivial or conjugates of the finite groups `M i`).

The main consequences used downstream:

* `starTree_connected` and `starTree_isTree` (in `StarTree.lean`): the graph is a tree;
* `stabilizer_central` and `stabilizer_coset`: the vertex stabilisers;
* `actsWithoutInversions` : `P` acts without inversions;
* `subsingleton_arrow` : there is at most one arrow between two vertices.

The key input from Mathlib is the uniqueness of the reduced word representing an element of the
free product (`Monoid.CoprodI.Word.equiv`), used in the form `letters_prod_ne_one`.
-/
import Mathlib
import Submission.Work.ORBassSerre.Tree.Basic
import Submission.Work.ORBassSerre.Action.Basic
import Submission.Work.ORBassSerre.Action.Cocompact

set_option autoImplicit false
set_option linter.unusedVariables false

universe u

namespace Work.ORLocInd.CoprodTree

open Quiver
open Work.ORBassSerre
open Classical

variable {ι : Type u}

/-! ## The factors of the free product and their cosets -/

/-- The subgroup of `Monoid.CoprodI M` generated by the `i`-th factor. -/
def factor (M : ι → Type u) [∀ i, Group (M i)] (i : ι) :
    Subgroup (Monoid.CoprodI M) :=
  (Monoid.CoprodI.of : M i →* _).range

theorem mem_factor {M : ι → Type u} [∀ i, Group (M i)] {i : ι}
    {g : Monoid.CoprodI M} :
    g ∈ factor M i ↔ ∃ m : M i, Monoid.CoprodI.of m = g := Iff.rfl

/-- Left cosets of a subgroup, as a setoid. -/
def cosetSetoid {G : Type*} [Group G] (S : Subgroup G) : Setoid G where
  r x y := x⁻¹ * y ∈ S
  iseqv :=
    ⟨fun x => by simp,
     fun {x y} h => by
       have h' := S.inv_mem h
       simpa [mul_inv_rev, inv_inv] using h',
     fun {x y z} h₁ h₂ => by
       have h' := S.mul_mem h₁ h₂
       simpa [mul_assoc] using h'⟩

/-- The coset space of the `i`-th factor inside the free product. -/
abbrev Coset (M : ι → Type u) [∀ i, Group (M i)] (i : ι) : Type u :=
  Quotient (cosetSetoid (factor M i))

theorem coset_eq_iff {M : ι → Type u} [∀ i, Group (M i)] {i : ι}
    {g h : Monoid.CoprodI M} :
    (Quotient.mk _ g : Coset M i) = Quotient.mk _ h ↔ g⁻¹ * h ∈ factor M i :=
  Quotient.eq

theorem coset_eq_self_iff {M : ι → Type u} [∀ i, Group (M i)] {i : ι}
    {g h : Monoid.CoprodI M} (hh : h ∈ factor M i) :
    (Quotient.mk _ (g * h) : Coset M i) = Quotient.mk _ g := by
  rw [coset_eq_iff, show (g * h)⁻¹ * g = h⁻¹ from by simp [mul_assoc]]
  exact (factor M i).inv_mem hh

/-! ## The vertex set -/

/-- The vertex set of the Bass--Serre tree: the elements of the free product ("central" vertices,
i.e. cosets of the trivial subgroup) together with the cosets of the factors. -/
abbrev Vertex (M : ι → Type u) [∀ i, Group (M i)] : Type u :=
  Monoid.CoprodI M ⊕ (Σ i : ι, Coset M i)

/-- The vertex with "state" `g` on the side `k`: for `k = none` this is the central vertex `g`,
and for `k = some i` the coset of `g` modulo the `i`-th factor. -/
def vtx {M : ι → Type u} [∀ i, Group (M i)] (k : Option ι)
    (g : Monoid.CoprodI M) : Vertex M :=
  match k with
  | none => Sum.inl g
  | some i => Sum.inr ⟨i, Quotient.mk _ g⟩

@[simp]
theorem vtx_none {M : ι → Type u} [∀ i, Group (M i)] (g : Monoid.CoprodI M) :
    vtx none g = Sum.inl g := rfl

@[simp]
theorem vtx_some {M : ι → Type u} [∀ i, Group (M i)] (i : ι)
    (g : Monoid.CoprodI M) : vtx (some i) g = Sum.inr ⟨i, Quotient.mk _ g⟩ := rfl

@[simp]
theorem vtx_none_eq_vtx_none {M : ι → Type u} [∀ i, Group (M i)]
    {g h : Monoid.CoprodI M} : vtx none g = vtx none h ↔ g = h := by
  simp

theorem vtx_some_eq_vtx_some {M : ι → Type u} [∀ i, Group (M i)] {i : ι}
    {g h : Monoid.CoprodI M} : vtx (some i) g = vtx (some i) h ↔ g⁻¹ * h ∈ factor M i := by
  simp only [vtx_some, Sum.inr.injEq, Sigma.mk.injEq, heq_eq_eq, true_and]
  exact coset_eq_iff

@[simp]
theorem vtx_none_ne_vtx_some {M : ι → Type u} [∀ i, Group (M i)]
    {g : Monoid.CoprodI M} {i : ι} {h : Monoid.CoprodI M} : vtx none g ≠ vtx (some i) h := by
  simp

@[simp]
theorem vtx_some_ne_vtx_none {M : ι → Type u} [∀ i, Group (M i)]
    {g : Monoid.CoprodI M} {i : ι} {h : Monoid.CoprodI M} : vtx (some i) g ≠ vtx none h := by
  simp

/-- Every vertex is of the form `vtx k g`. -/
theorem exists_vtx {M : ι → Type u} [∀ i, Group (M i)] (x : Vertex M) :
    ∃ (k : Option ι) (g : Monoid.CoprodI M), x = vtx k g := by
  rcases x with g | ⟨i, c⟩
  · exact ⟨none, g, rfl⟩
  · obtain ⟨g, rfl⟩ := Quotient.exists_rep c
    exact ⟨some i, g, rfl⟩

/-! ## The quiver structure -/

/-- An arrow of the Bass--Serre tree: an index `i` and a group element `g`, joining the central
vertex `g` and the coset vertex `g · M i`. -/
abbrev Arrow {M : ι → Type u} [∀ i, Group (M i)] (x y : Vertex M) : Type u :=
  { e : ι × Monoid.CoprodI M //
      (x = vtx none e.2 ∧ y = vtx (some e.1) e.2) ∨
      (x = vtx (some e.1) e.2 ∧ y = vtx none e.2) }

instance instQuiverVertex {M : ι → Type u} [∀ i, Group (M i)] :
    Quiver (Vertex M) := ⟨Arrow⟩

/-- The index of an arrow. -/
def Arrow.idx {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : ι := e.1.1

/-- The label of an arrow. -/
def Arrow.lbl {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : Monoid.CoprodI M := e.1.2

@[simp]
theorem Arrow.eta {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M} (e : x ⟶ y) :
    (e.idx, e.lbl) = e.1 := rfl

theorem Arrow.endpoints {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) :
    (x = vtx none e.lbl ∧ y = vtx (some e.idx) e.lbl) ∨
      (x = vtx (some e.idx) e.lbl ∧ y = vtx none e.lbl) := e.2

/-- The reversed arrow. -/
def arrowReverse {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : y ⟶ x :=
  ⟨e.1, e.2.elim (fun h => Or.inr ⟨h.2, h.1⟩) (fun h => Or.inl ⟨h.2, h.1⟩)⟩

@[simp]
theorem arrowReverse_val {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : (arrowReverse e).1 = e.1 := rfl

theorem arrowReverse_arrowReverse {M : ι → Type u} [∀ i, Group (M i)]
    {x y : Vertex M} (e : x ⟶ y) : arrowReverse (arrowReverse e) = e := Subtype.ext rfl

instance instHasReverseVertex {M : ι → Type u} [∀ i, Group (M i)] :
    Quiver.HasReverse (Vertex M) where
  reverse' := arrowReverse

instance instHasInvolutiveReverseVertex {M : ι → Type u} [∀ i, Group (M i)] :
    Quiver.HasInvolutiveReverse (Vertex M) :=
  { instHasReverseVertex with inv' := fun e => arrowReverse_arrowReverse e }

@[simp]
theorem reverse_val {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : (Quiver.reverse e).1 = e.1 := rfl

@[simp]
theorem reverse_idx {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : (Quiver.reverse e).idx = e.idx := rfl

@[simp]
theorem reverse_lbl {M : ι → Type u} [∀ i, Group (M i)] {x y : Vertex M}
    (e : x ⟶ y) : (Quiver.reverse e).lbl = e.lbl := rfl

/-- The index of a vertex of the shape `vtx (some i) g` is `i`. -/
theorem idx_eq_of_vtx_some_eq {M : ι → Type u} [∀ i, Group (M i)] {i i' : ι}
    {l l' : Monoid.CoprodI M} (h : vtx (some i) l = vtx (some i') l') : i = i' := by
  have h' := h
  simp only [vtx_some, Sum.inr.injEq, Sigma.mk.injEq] at h'
  exact h'.1

/-- There is at most one arrow between two vertices of the tree. -/
theorem subsingleton_arrow {M : ι → Type u} [∀ i, Group (M i)] (x y : Vertex M) :
    Subsingleton (x ⟶ y) := by
  refine ⟨fun e e' => Subtype.ext ?_⟩
  rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
    rcases Arrow.endpoints e' with ⟨h1', h2'⟩ | ⟨h1', h2'⟩
  · have hl : e.lbl = e'.lbl := (vtx_none_eq_vtx_none).mp (h1.symm.trans h1')
    have hi : e.idx = e'.idx := idx_eq_of_vtx_some_eq (h2.symm.trans h2')
    exact Prod.ext hi hl
  · exact absurd (h1.symm.trans h1') (vtx_none_ne_vtx_some)
  · exact absurd (h1.symm.trans h1') (vtx_some_ne_vtx_none)
  · have hl : e.lbl = e'.lbl := (vtx_none_eq_vtx_none).mp (h2.symm.trans h2')
    have hi : e.idx = e'.idx := idx_eq_of_vtx_some_eq (h1.symm.trans h1')
    exact Prod.ext hi hl

/-- **The endpoint of a "backtrack".**  If `e` and `e'` are consecutive arrows with equal data
then the target `z` of `e'` is the source `x` of `e`, i.e. `e'` is the reverse of `e`. -/
theorem data_eq_of_deleteBacktrack {M : ι → Type u} [∀ i, Group (M i)]
    {a x y z : Vertex M} (p : Quiver.Path a x) (e : x ⟶ y) (e' : y ⟶ z) (h : e'.1 = e.1) :
    z = x := by
  have hl : e'.lbl = e.lbl := congrArg Prod.snd h
  have hidx : e'.idx = e.idx := congrArg Prod.fst h
  rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
    rcases Arrow.endpoints e' with ⟨h1', h2'⟩ | ⟨h1', h2'⟩
  · exact absurd (h2.symm.trans h1') (by simp)
  · rw [h2', hl, ← h1]
  · rw [h2', hidx, hl, ← h1]
  · exact absurd (h2.symm.trans h1') (by simp)

/-- A path whose last two arrows have equal data is not reduced. -/
theorem not_isReduced_of_data_eq {M : ι → Type u} [∀ i, Group (M i)]
    {a x y z : Vertex M} (p : Quiver.Path a x) (e : x ⟶ y) (e' : y ⟶ z) (h : e'.1 = e.1) :
    ¬ ((p.cons e).cons e').IsReduced := by
  have hz := data_eq_of_deleteBacktrack p e e' h
  subst hz
  have he' : e' = Quiver.reverse e := Subtype.ext (by rw [h, reverse_val])
  subst he'
  intro hp
  have hbt : Quiver.Path.DeleteBacktrack ((p.cons e).cons (Quiver.reverse e)) p :=
    Quiver.Path.DeleteBacktrack.intro p e Quiver.Path.nil
  exact hp p hbt

/-- A reduced path has no two consecutive arrows with equal data. -/
theorem data_ne_of_isReduced {M : ι → Type u} [∀ i, Group (M i)]
    {a x y z : Vertex M} (p : Quiver.Path a x) (e : x ⟶ y) (e' : y ⟶ z)
    (hp : ((p.cons e).cons e').IsReduced) : e'.1 ≠ e.1 :=
  fun h => not_isReduced_of_data_eq p e e' h hp

/-! ## The types of the endpoints of an arrow -/

theorem arrow_none_left {M : ι → Type u} [∀ i, Group (M i)] {x : Vertex M}
    {g : Monoid.CoprodI M} (e : vtx none g ⟶ x) :
    e.lbl = g ∧ x = vtx (some e.idx) e.lbl := by
  rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact ⟨(vtx_none_eq_vtx_none).mp h1.symm, h2⟩
  · exact absurd h1 vtx_none_ne_vtx_some

theorem arrow_to_none {M : ι → Type u} [∀ i, Group (M i)] {x : Vertex M}
    {g : Monoid.CoprodI M} (e : x ⟶ vtx none g) :
    e.lbl = g ∧ x = vtx (some e.idx) e.lbl := by
  rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact absurd h2 vtx_none_ne_vtx_some
  · exact ⟨(vtx_none_eq_vtx_none).mp h2.symm, h1⟩

theorem arrow_some_left {M : ι → Type u} [∀ i, Group (M i)] {x : Vertex M}
    {i : ι} {g : Monoid.CoprodI M} (e : vtx (some i) g ⟶ x) :
    e.idx = i ∧ (∃ m : M i, e.lbl = g * Monoid.CoprodI.of m) ∧ x = vtx none e.lbl := by
  rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact absurd h1 vtx_some_ne_vtx_none
  · have hi : e.idx = i := (idx_eq_of_vtx_some_eq h1).symm
    rw [hi] at h1
    have hmem : g⁻¹ * e.lbl ∈ factor M i := (vtx_some_eq_vtx_some).mp h1
    obtain ⟨m, hm⟩ := hmem
    exact ⟨hi, ⟨m, by calc e.lbl = g * (g⁻¹ * e.lbl) := by simp [mul_assoc]
        _ = g * Monoid.CoprodI.of m := by rw [← hm]⟩, h2⟩

theorem arrow_to_some {M : ι → Type u} [∀ i, Group (M i)] {x : Vertex M}
    {i : ι} {g : Monoid.CoprodI M} (e : x ⟶ vtx (some i) g) :
    e.idx = i ∧ (∃ m : M i, e.lbl = g * Monoid.CoprodI.of m) ∧ x = vtx none e.lbl := by
  rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · have hi : e.idx = i := (idx_eq_of_vtx_some_eq h2).symm
    rw [hi] at h2
    have hmem : g⁻¹ * e.lbl ∈ factor M i := (vtx_some_eq_vtx_some).mp h2
    obtain ⟨m, hm⟩ := hmem
    exact ⟨hi, ⟨m, by calc e.lbl = g * (g⁻¹ * e.lbl) := by simp [mul_assoc]
        _ = g * Monoid.CoprodI.of m := by rw [← hm]⟩, h1⟩
  · exact absurd h2 vtx_some_ne_vtx_none

/-! ## The action of the free product on the tree -/

/-- Left multiplication on the cosets of the `i`-th factor. -/
def smulCoset {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) (i : ι) : Coset M i → Coset M i :=
  Quotient.map (fun h => g * h) (by
    intro a b hab
    have hab' : a⁻¹ * b ∈ factor M i := hab
    show (g * a)⁻¹ * (g * b) ∈ factor M i
    simpa [mul_inv_rev, mul_assoc] using hab')

@[simp]
theorem smulCoset_mk {M : ι → Type u} [∀ i, Group (M i)]
    (g h : Monoid.CoprodI M) (i : ι) :
    smulCoset g i (Quotient.mk _ h) = Quotient.mk _ (g * h) := rfl

theorem smulCoset_one {M : ι → Type u} [∀ i, Group (M i)] (i : ι)
    (c : Coset M i) : smulCoset 1 i c = c := by
  induction c using Quotient.inductionOn with
  | h a => rw [smulCoset_mk]; exact Quotient.sound (by simp)

theorem smulCoset_mul {M : ι → Type u} [∀ i, Group (M i)]
    (g h : Monoid.CoprodI M) (i : ι) (c : Coset M i) :
    smulCoset (g * h) i c = smulCoset g i (smulCoset h i c) := by
  induction c using Quotient.inductionOn with
  | h a => rw [smulCoset_mk, smulCoset_mk, smulCoset_mk]; exact Quotient.sound (by simp [mul_assoc])

/-- The action of the free product on the vertices. -/
def smulVertex {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) : Vertex M → Vertex M :=
  Sum.map (fun h => g * h) (fun c => ⟨c.1, smulCoset g c.1 c.2⟩)

@[simp]
theorem smulVertex_inl {M : ι → Type u} [∀ i, Group (M i)]
    (g h : Monoid.CoprodI M) : smulVertex g (Sum.inl h) = Sum.inl (g * h) := rfl

@[simp]
theorem smulVertex_inr {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) (i : ι) (c : Coset M i) :
    smulVertex g (Sum.inr ⟨i, c⟩) = Sum.inr ⟨i, smulCoset g i c⟩ := rfl

@[simp]
theorem smul_vtx {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) (k : Option ι) (h : Monoid.CoprodI M) :
    smulVertex g (vtx k h) = vtx k (g * h) := by
  cases k
  · rfl
  · simp [vtx, smulVertex]

instance instMulActionVertex {M : ι → Type u} [∀ i, Group (M i)] :
    MulAction (Monoid.CoprodI M) (Vertex M) where
  smul := smulVertex
  one_smul x := by
    rcases x with g | ⟨i, c⟩
    · show smulVertex 1 (Sum.inl g) = Sum.inl g
      rw [smulVertex_inl, one_mul]
    · show smulVertex 1 (Sum.inr ⟨i, c⟩) = Sum.inr ⟨i, c⟩
      rw [smulVertex_inr, smulCoset_one]
  mul_smul g h x := by
    rcases x with g' | ⟨i, c⟩
    · show smulVertex (g * h) (Sum.inl g') = smulVertex g (smulVertex h (Sum.inl g'))
      rw [smulVertex_inl, smulVertex_inl, smulVertex_inl, mul_assoc]
    · show smulVertex (g * h) (Sum.inr ⟨i, c⟩) = smulVertex g (smulVertex h (Sum.inr ⟨i, c⟩))
      rw [smulVertex_inr, smulVertex_inr, smulVertex_inr, smulCoset_mul]

@[simp]
theorem smul_vtx_none {M : ι → Type u} [∀ i, Group (M i)]
    (g h : Monoid.CoprodI M) : g • vtx none h = vtx none (g * h) := rfl

@[simp]
theorem smul_vtx_some {M : ι → Type u} [∀ i, Group (M i)]
    (g h : Monoid.CoprodI M) (i : ι) : g • vtx (some i) h = vtx (some i) (g * h) := rfl

@[simp]
theorem smul_inl {M : ι → Type u} [∀ i, Group (M i)]
    (g h : Monoid.CoprodI M) : (g • (Sum.inl h : Vertex M)) = Sum.inl (g * h) := rfl

@[simp]
theorem smul_inr {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) (i : ι) (c : Coset M i) :
    (g • (Sum.inr ⟨i, c⟩ : Vertex M)) = Sum.inr ⟨i, smulCoset g i c⟩ := rfl

/-- The translate of an arrow. -/
def smulArrow {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) {x y : Vertex M} (e : x ⟶ y) : (g • x) ⟶ (g • y) :=
  ⟨(e.idx, g * e.lbl), by
    rcases Arrow.endpoints e with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl
        ⟨(congrArg (fun z => g • z) h1).trans (smul_inl g e.lbl),
         (congrArg (fun z => g • z) h2).trans (by simp)⟩
    · exact Or.inr
        ⟨(congrArg (fun z => g • z) h1).trans (by simp),
         (congrArg (fun z => g • z) h2).trans (smul_inl g e.lbl)⟩⟩

@[simp]
theorem smulArrow_val {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) {x y : Vertex M} (e : x ⟶ y) :
    (smulArrow g e).1 = (e.idx, g * e.lbl) := rfl

@[simp]
theorem smulArrow_idx {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) {x y : Vertex M} (e : x ⟶ y) : (smulArrow g e).idx = e.idx := rfl

@[simp]
theorem smulArrow_lbl {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) {x y : Vertex M} (e : x ⟶ y) :
    (smulArrow g e).lbl = g * e.lbl := rfl

theorem smulArrow_reverse {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) {x y : Vertex M} (e : x ⟶ y) :
    smulArrow g (Quiver.reverse e) = Quiver.reverse (smulArrow g e) := by
  haveI := subsingleton_arrow (g • y) (g • x)
  exact Subsingleton.elim _ _

/-- Two `Quiver.Total`s with propositionally equal endpoints and equal arrow data are equal. -/
theorem Total.ext' {M : ι → Type u} [∀ i, Group (M i)] {a a' b b' : Vertex M}
    (ha : a = a') (hb : b = b') (f : a ⟶ b) (f' : a' ⟶ b') (hl : f.1 = f'.1) :
    Quiver.Total.mk a b f = Quiver.Total.mk a' b' f' := by
  subst ha; subst hb
  exact congrArg (Quiver.Total.mk a b) (Subtype.ext hl)

instance instGraphActionVertex {M : ι → Type u} [∀ i, Group (M i)] :
    GraphAction (Monoid.CoprodI M) (Vertex M) where
  smulTotal g e := Quiver.Total.mk (g • e.left) (g • e.right) (smulArrow g e.hom)
  smulTotal_one e := by
    cases e with
    | mk l r f =>
      refine Total.ext' (one_smul (Monoid.CoprodI M) l) (one_smul (Monoid.CoprodI M) r) _ _
        (by simp)
  smulTotal_mul g h e := by
    cases e with
    | mk l r f =>
      refine Total.ext' (mul_smul g h l) (mul_smul g h r) _ _ (by simp [mul_assoc])
  smul_left g e := rfl
  smul_right g e := rfl
  smul_reverse g e := by
    cases e with
    | mk l r f =>
      refine Total.ext' rfl rfl _ _ (congrArg Subtype.val (smulArrow_reverse g f))

/-! ## No inversions -/

/-- The free product acts on its Bass--Serre tree without inversions. -/
theorem actsWithoutInversions {M : ι → Type u} [∀ i, Group (M i)] :
    ActsWithoutInversions (Monoid.CoprodI M) (Vertex M) := by
  intro g e he
  have h : g • e.left = e.right := by
    have h0 := congrArg Quiver.Total.left he
    rw [GraphAction.smul_left, Quiver.Total.reverse_left] at h0
    exact h0
  rcases Arrow.endpoints e.hom with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · have e1 : g • e.left = vtx none (g * e.hom.lbl) :=
      (congrArg (fun z => g • z) h1).trans (smul_vtx_none g e.hom.lbl)
    have e2 : g • e.left = vtx (some e.hom.idx) e.hom.lbl := h.trans h2
    exact absurd (e1.symm.trans e2) (by simp)
  · have e1 : g • e.left = vtx (some e.hom.idx) (g * e.hom.lbl) :=
      (congrArg (fun z => g • z) h1).trans (smul_vtx_some g e.hom.lbl e.hom.idx)
    have e2 : g • e.left = vtx none e.hom.lbl := h.trans h2
    exact absurd (e1.symm.trans e2) (by simp)

/-! ## Stabilisers -/

theorem stabilizer_central {M : ι → Type u} [∀ i, Group (M i)]
    (g : Monoid.CoprodI M) :
    MulAction.stabilizer (Monoid.CoprodI M) (vtx none g) = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  rw [MulAction.mem_stabilizer_iff, smul_vtx_none, vtx_none_eq_vtx_none] at hx
  simpa using hx

theorem stabilizer_coset {M : ι → Type u} [∀ i, Group (M i)] (i : ι)
    (g : Monoid.CoprodI M) :
    MulAction.stabilizer (Monoid.CoprodI M) (vtx (some i) g)
      = (factor M i).map (MulEquiv.toMonoidHom (MulAut.conj g)) := by
  ext x
  rw [MulAction.mem_stabilizer_iff, smul_vtx_some, vtx_some_eq_vtx_some, Subgroup.mem_map]
  constructor
  · intro h
    refine ⟨g⁻¹ * x * g, ?_, ?_⟩
    · have h' : g⁻¹ * x⁻¹ * g ∈ factor M i := by
        simpa [mul_inv_rev, mul_assoc] using h
      simpa [mul_inv_rev, inv_inv, mul_assoc] using (factor M i).inv_mem h'
    · simp [MulAut.conj_apply, mul_assoc]
  · rintro ⟨a, ha, hx⟩
    rw [← hx]
    have h1 : (MulEquiv.toMonoidHom (MulAut.conj g)) a = g * a * g⁻¹ := by
      simp [MulAut.conj_apply]
    rw [h1]
    have : (g * a * g⁻¹ * g)⁻¹ * g = a⁻¹ := by simp [mul_assoc]
    rw [this]
    exact (factor M i).inv_mem ha

/-- The stabiliser of an edge of the tree is trivial. -/
theorem subsingleton_stabilizer_edge {M : ι → Type u} [∀ i, Group (M i)]
    (e : Quiver.Total (Vertex M)) :
    Subsingleton (MulAction.stabilizer (Monoid.CoprodI M) e) := by
  have key : ∀ c : MulAction.stabilizer (Monoid.CoprodI M) e,
      (c : Monoid.CoprodI M) = 1 := by
    intro c
    have hmem : GraphAction.smulTotal (c : Monoid.CoprodI M) e = e := c.2
    rcases Arrow.endpoints e.hom with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · have hL : (c : Monoid.CoprodI M) • e.left = e.left := by
        rw [← GraphAction.smul_left, hmem]
      have hc : (c : Monoid.CoprodI M) * e.hom.lbl = e.hom.lbl := by
        rw [h1] at hL
        rw [smul_vtx_none, vtx_none_eq_vtx_none] at hL
        exact hL
      calc (c : Monoid.CoprodI M) = (c : Monoid.CoprodI M) * e.hom.lbl * e.hom.lbl⁻¹ := by
            simp [mul_assoc]
        _ = e.hom.lbl * e.hom.lbl⁻¹ := by rw [hc]
        _ = 1 := mul_inv_cancel _
    · have hR : (c : Monoid.CoprodI M) • e.right = e.right := by
        rw [← GraphAction.smul_right, hmem]
      have hc : (c : Monoid.CoprodI M) * e.hom.lbl = e.hom.lbl := by
        rw [h2] at hR
        rw [smul_vtx_none, vtx_none_eq_vtx_none] at hR
        exact hR
      calc (c : Monoid.CoprodI M) = (c : Monoid.CoprodI M) * e.hom.lbl * e.hom.lbl⁻¹ := by
            simp [mul_assoc]
        _ = e.hom.lbl * e.hom.lbl⁻¹ := by rw [hc]
        _ = 1 := mul_inv_cancel _
  exact ⟨fun a b => Subtype.ext (by rw [key a, key b])⟩

/-! ## Normal forms in the free product -/

/-- **A non-empty reduced word is not the identity** in the free product. -/
theorem word_prod_ne_one {M : ι → Type u} [∀ i, Group (M i)]
    {w : Monoid.CoprodI.Word M} (hw : w ≠ Monoid.CoprodI.Word.empty) :
    Monoid.CoprodI.Word.prod w ≠ 1 := by
  classical
  intro h
  apply hw
  have h2 : Monoid.CoprodI.Word.equiv (M := M) (Monoid.CoprodI.Word.prod w) = w :=
    (Monoid.CoprodI.Word.equiv (M := M)).right_inv w
  have h4 : Monoid.CoprodI.Word.equiv (M := M) (1 : Monoid.CoprodI M)
      = Monoid.CoprodI.Word.empty :=
    one_smul (Monoid.CoprodI M) (Monoid.CoprodI.Word.empty : Monoid.CoprodI.Word M)
  rw [h] at h2
  rw [h4] at h2
  exact h2.symm

/-- A non-empty list of letters from the various factors, with no letter equal to `1` and no two
consecutive letters from the same factor, represents a non-identity element of the free product. -/
theorem letters_prod_ne_one {M : ι → Type u} [∀ i, Group (M i)]
    {l : List (Σ i : ι, M i)} (hne : ∀ x ∈ l, x.2 ≠ 1)
    (hchain : l.IsChain fun a b => a.1 ≠ b.1) (hl : l ≠ []) :
    (l.map fun x => Monoid.CoprodI.of x.2).prod ≠ 1 := by
  classical
  have h := word_prod_ne_one (w := ⟨l, fun x hx => hne x hx, hchain⟩) (by
    intro h'
    exact hl (congrArg Monoid.CoprodI.Word.toList h'))
  simpa [Monoid.CoprodI.Word.prod] using h

/-- A (noncomputable) preimage of an element of a factor of the free product. -/
noncomputable def preimage (M : ι → Type u) [∀ i, Group (M i)] (i : ι)
    (x : Monoid.CoprodI M) : M i :=
  if h : ∃ m : M i, Monoid.CoprodI.of m = x then Classical.choose h else 1

theorem of_preimage {M : ι → Type u} [∀ i, Group (M i)] {i : ι} {x : Monoid.CoprodI M}
    (hx : x ∈ factor M i) : Monoid.CoprodI.of (preimage M i x) = x := by
  classical
  have hex : ∃ m : M i, Monoid.CoprodI.of m = x := mem_factor.mp hx
  have h : preimage M i x = Classical.choose hex := by
    unfold preimage
    rw [dif_pos hex]
  rw [h]
  exact Classical.choose_spec hex

/-- The same statement with the letters given as elements of the free product, together with the
information that each lies in the corresponding factor. -/
theorem letters_prod_ne_one' {M : ι → Type u} [∀ i, Group (M i)]
    {l : List (ι × Monoid.CoprodI M)} (hmem : ∀ x ∈ l, x.2 ∈ factor M x.1)
    (hne : ∀ x ∈ l, x.2 ≠ 1) (hchain : l.IsChain fun a b => a.1 ≠ b.1) (hl : l ≠ []) :
    (l.map fun x => x.2).prod ≠ 1 := by
  classical
  let l' : List (Σ i : ι, M i) := l.map (fun x => ⟨x.1, preimage M x.1 x.2⟩)
  have hfst : l'.map (fun x : Σ i : ι, M i => x.1)
      = l.map (fun y : ι × Monoid.CoprodI M => y.1) := by
    show (l.map (fun x => (⟨x.1, preimage M x.1 x.2⟩ : Σ i : ι, M i))).map
      (fun x => x.1) = _
    rw [List.map_map]
    rfl
  have hprod : (l'.map fun x => Monoid.CoprodI.of x.2) = l.map (fun x => x.2) := by
    show (l.map (fun x => (⟨x.1, preimage M x.1 x.2⟩ : Σ i : ι, M i))).map
      (fun x => Monoid.CoprodI.of x.2) = _
    rw [List.map_map]
    exact List.map_congr_left (fun x hx => of_preimage (hmem x hx))
  have hne' : ∀ x ∈ l', x.2 ≠ 1 := by
    intro x hx
    have hx' : x ∈ l.map (fun x => (⟨x.1, preimage M x.1 x.2⟩ : Σ i : ι, M i)) := hx
    obtain ⟨y, hy, hyx⟩ := List.mem_map.mp hx'
    subst hyx
    intro hcon
    have hcon' : preimage M y.1 y.2 = 1 := hcon
    exact hne y hy (by rw [← of_preimage (hmem y hy), hcon', map_one])
  have hchain' : l'.IsChain (fun a b : Σ i : ι, M i => a.1 ≠ b.1) :=
    List.isChain_of_isChain_map (f := fun x : Σ i : ι, M i => x.1) (fun a b h => h)
      (by rw [hfst]
          exact List.isChain_map_of_isChain (f := fun y : ι × Monoid.CoprodI M => y.1)
            (fun a b (h : a.1 ≠ b.1) => h) hchain)
  have hl' : l' ≠ [] := by
    intro hnil
    apply hl
    have h0 : l'.length = 0 := by
      have := congrArg List.length hnil
      simpa using this
    exact List.eq_nil_of_length_eq_zero (by
      show l.length = 0
      rw [← List.length_map (f := fun x => (⟨x.1, preimage M x.1 x.2⟩ : Σ i : ι, M i))]
      exact h0)
  rw [← hprod]
  exact letters_prod_ne_one hne' hchain' hl'

/-- Two distinct factors of the free product intersect trivially. -/
theorem factor_inf_factor_eq_bot {M : ι → Type u} [∀ i, Group (M i)] {i j : ι}
    (hij : i ≠ j) : factor M i ⊓ factor M j = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  rintro x ⟨⟨m, rfl⟩, ⟨m', hm'⟩⟩
  by_cases hm1 : m = 1
  · rw [hm1, map_one]
  by_cases hm'1 : m' = 1
  · rw [← hm', hm'1, map_one]
  have heq : Monoid.CoprodI.of m = Monoid.CoprodI.of m' := hm'.symm
  have hl : ([(⟨i, m⟩ : Σ k, M k), ⟨j, m'⁻¹⟩] : List (Σ k, M k)) ≠ [] := by simp
  have hne : ∀ y ∈ ([(⟨i, m⟩ : Σ k, M k), ⟨j, m'⁻¹⟩] : List (Σ k, M k)), y.2 ≠ 1 := by
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · simpa using hm1
    · rw [List.mem_singleton] at hy
      subst hy
      simpa using hm'1
  have hchain : ([(⟨i, m⟩ : Σ k, M k), ⟨j, m'⁻¹⟩] : List (Σ k, M k)).IsChain
      (fun a b => a.1 ≠ b.1) := by
    rw [List.isChain_pair]
    exact hij
  have hmap : ([(⟨i, m⟩ : Σ k, M k), ⟨j, m'⁻¹⟩] : List (Σ k, M k)).map
      (fun x => Monoid.CoprodI.of x.2) = [Monoid.CoprodI.of m, (Monoid.CoprodI.of m')⁻¹] := by
    simp [map_inv]
  have hval : ((([(⟨i, m⟩ : Σ k, M k), ⟨j, m'⁻¹⟩] : List (Σ k, M k)).map
      (fun x => Monoid.CoprodI.of x.2))).prod = 1 := by
    rw [hmap]
    simp [List.prod_cons, map_inv, heq]
  exact absurd hval (letters_prod_ne_one hne hchain hl)

