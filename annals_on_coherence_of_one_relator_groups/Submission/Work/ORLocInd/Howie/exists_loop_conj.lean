/-
# Conjugating the loop of a relator term (Howie 2000, Theorem 3.1)

For a term `t = ⟨i, sign, δ, hδ⟩` of a datum, the *loop*

`RelatorTerm.loop t = δ · r_i^{±1} · δ⁻¹  ∈  F(Γ)_v`

is an element of the vertex group of the free groupoid at `v`.  This file records the elementary
fact that the conjugates of a loop are again loops: for every `c ∈ F(Γ)_v` there is a term `t'`
whose loop is `c * loop t * c⁻¹`.

The witness is the term with the same relator and sign but with the path `δ` replaced by
`pmul c δ` (the reduced product of the closed path `c` with `δ`).  The verification is purely
associative: writing `σ = t.signedPath` for the signed relator path, the assertion unwinds to

`(c δ) · σ · (c δ)⁻¹  =  c · (δ · σ · δ⁻¹) · c⁻¹`,

for which `pmul_reverse_comp` (`(p · q)⁻¹ = q⁻¹ · p⁻¹`) and the associativity of `pmul`
(`pmul_assoc`) suffice; both are combined in the auxiliary identity `pmul_conj_eq` below.

This is the path-algebra input to `Work.ORLocInd.Howie.exists_datum_of_lift_eq_one`: it shows that
the normal closure of the relators of `P` is generated by the loops of the relator terms.
-/
import Mathlib
import Submission.Work.ORLocInd.Howie.LoopAux

universe u

namespace Work.ORLocInd.Howie

open Quiver

variable {V : Type u} [Quiver V] [Quiver.HasInvolutiveReverse V]

/-- **The conjugation identity for the free-groupoid product.**  For paths `c : v → v`,
`δ : v → w` and `σ : w → w`,

`(c · δ) · (σ · (c · δ)⁻¹) = (c · (δ · (σ · δ⁻¹))) · c⁻¹`,

i.e. conjugation by `c · δ` factors as conjugation by `c` after conjugation by `δ`.  Both sides are
reassociated into the same right-nested word `c · (δ · (σ · (δ⁻¹ · c⁻¹)))`. -/
theorem pmul_conj_eq {v w : V} (c : Quiver.Path v v) (δ : Quiver.Path v w)
    (σ : Quiver.Path w w) :
    pmul (pmul c δ) (pmul σ (pmul c δ).reverse)
      = pmul (pmul c (pmul δ (pmul σ δ.reverse))) c.reverse := by
  simp only [pmul_assoc, pmul_reverse_comp]

/-- **Every conjugate of the loop of a term is again the loop of a term.**  The witness is the term
with the same relator and sign whose path is `c · δ`. -/
theorem exists_loop_conj {V : Type u} [Quiver V] [Quiver.HasInvolutiveReverse V]
    {P : Work.ORLocInd.Howie.Presentation V} {v : V} (t : Work.ORLocInd.Howie.RelatorTerm P v)
    (c : Work.ORLocInd.Howie.VertexGroup v) :
    ∃ t' : Work.ORLocInd.Howie.RelatorTerm P v,
      Work.ORLocInd.Howie.RelatorTerm.loop t' =
        c * Work.ORLocInd.Howie.RelatorTerm.loop t * c⁻¹ := by
  obtain ⟨i, sign, δ, hδ⟩ := t
  refine ⟨⟨i, sign, pmul c.1 δ, pmul_isReduced _ _⟩, ?_⟩
  apply Subtype.ext
  simp only [VertexGroup.coe_mul, VertexGroup.coe_inv, RelatorTerm.loop, RelatorTerm.signedPath]
  cases sign <;> exact pmul_conj_eq c.1 δ _

end Work.ORLocInd.Howie
