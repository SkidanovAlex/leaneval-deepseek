/-
# Relation words with finite abelianisation

Let `H` be a group generated by `γ : Fin n → H` whose abelianisation is finite.  This file produces
`n` words `W j ∈ FreeGroup (Fin n)` which are *relations* of `H` (i.e. `FreeGroup.lift γ (W j) = 1`)
such that the group `⟨x_1, …, x_n | W_1, …, W_n⟩` presented by them has finite abelianisation.

This is exactly the input needed to start Howie's proof of his Theorem 3.1 in the form used for the
local-indicability half of Brodskii's theorem (see `Howie/Datum.lean`): a *datum* consists of a
finite tuple `γ` of elements of a vertex group (generating a subgroup `H` with finite
abelianisation) together with `n` words `W_j` in `n` free generators such that `W_j(γ) = 1` and the
group presented by `(W_j)` has finite abelianisation; the induction of `Howie/staggered_vanishes`
is on the length of the datum, so the words have to be indexed by the same `Fin n` as the
generators of `H`.

## Proof

Let `m` be the exponent of the finite group `Abelianization H` and let `φ : FreeGroup (Fin n) →* H`
be `FreeGroup.lift γ`, which is surjective.  Since `γ_j ^ m` dies in `Abelianization H`, it lies in
`commutator H = φ '' commutator (FreeGroup (Fin n))`, so we may choose `c_j` in the commutator
subgroup of the free group with `φ c_j = (γ_j ^ m)⁻¹`.  Put `W_j = x_j ^ m · c_j`.  Then
`φ (W_j) = 1`, and in the presentation `G' = ⟨x_1, …, x_n | W_1, …, W_n⟩` the class of `x_j ^ m` is
`(image of c_j)⁻¹`, hence a commutator of `G'`.  So each generator of `Abelianization G'` (which is
finitely generated) has order dividing `m`, whence `Abelianization G'` is torsion; a finitely
generated abelian torsion group is finite.
-/
import Mathlib
import Submission.Work.ORLocInd.Howie.isMulTorsion_abelianization_of_pow_mul_commutator
import Submission.Work.ORLocInd.Howie.exists_commutator_preimage

namespace Work.ORLocInd.Howie

universe u

/-- The canonical projection of a group onto its abelianisation is surjective. -/
theorem abelianization_of_surjective (G : Type*) [Group G] :
    Function.Surjective (Abelianization.of : G →* Abelianization G) :=
  QuotientGroup.mk_surjective

/-- The abelianisation of a group presented by finitely many generators and relations is finitely
generated. -/
theorem groupFG_abelianization_of_presentedGroup {n : ℕ} (W : Fin n → FreeGroup (Fin n)) :
    Group.FG (Abelianization (PresentedGroup (Set.range W))) := by
  have hFG : Group.FG (PresentedGroup (Set.range W)) :=
    Group.fg_of_surjective (PresentedGroup.mk_surjective (Set.range W))
  exact Group.fg_of_surjective (abelianization_of_surjective _)

theorem exists_relation_words {H : Type u} [Group H] {n : ℕ} (γ : Fin n → H)
    (hgen : Subgroup.closure (Set.range γ) = ⊤)
    (hfin : Finite (Abelianization H)) :
    ∃ W : Fin n → FreeGroup (Fin n),
      (∀ j, FreeGroup.lift γ (W j) = 1) ∧
      Finite (Abelianization (PresentedGroup (Set.range W))) := by
  classical
  have hfin' : Finite (Abelianization H) := hfin
  -- `φ : FreeGroup (Fin n) →* H`, `x_j ↦ γ_j`, is surjective.
  have hφsurj : Function.Surjective (FreeGroup.lift γ) :=
    FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr hgen
  -- `m`: the exponent of the (finite) abelianisation of `H`.
  let m : ℕ := Monoid.exponent (Abelianization H)
  have hm : 0 < m := Monoid.exponent_pos.mpr Monoid.ExponentExists.of_finite
  have hpow : ∀ x : Abelianization H, x ^ m = 1 := fun x => Monoid.pow_exponent_eq_one x
  -- for every `j` a commutator word `c j` with `φ (c j) = (γ_j ^ m)⁻¹`.
  have hex : ∀ j : Fin n, ∃ c : FreeGroup (Fin n),
      c ∈ commutator (FreeGroup (Fin n)) ∧ FreeGroup.lift γ c = (γ j ^ m)⁻¹ := by
    intro j
    refine exists_commutator_preimage (FreeGroup.lift γ) hφsurj (Subgroup.inv_mem _ ?_)
    -- `γ_j ^ m` dies in `Abelianization H`, hence is a commutator of `H`.
    rw [← Abelianization.ker_of H, MonoidHom.mem_ker, map_pow]
    exact hpow (Abelianization.of (γ j))
  choose c hc hcval using hex
  let W : Fin n → FreeGroup (Fin n) := fun j => (FreeGroup.of j) ^ m * c j
  -- the words `W j = x_j ^ m * c_j` are relations of `H`.
  have hWφ : ∀ j, FreeGroup.lift γ (W j) = 1 := by
    intro j
    show FreeGroup.lift γ ((FreeGroup.of j) ^ m * c j) = 1
    rw [map_mul, map_pow, FreeGroup.lift_apply_of, hcval j, mul_inv_cancel]
  have hFG : Group.FG (Abelianization (PresentedGroup (Set.range W))) :=
    groupFG_abelianization_of_presentedGroup W
  -- each generator of the abelianisation has order dividing `m`, so it is torsion.
  have htor : IsMulTorsion (Abelianization (PresentedGroup (Set.range W))) :=
    isMulTorsion_abelianization_of_pow_mul_commutator hm W c hc (fun j => rfl)
  exact ⟨W, hWφ, CommGroup.finite_of_fg_isMulTorsion _ htor⟩

end Work.ORLocInd.Howie
