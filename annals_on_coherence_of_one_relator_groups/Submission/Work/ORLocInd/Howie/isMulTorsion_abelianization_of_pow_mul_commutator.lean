import Mathlib

namespace Work.ORLocInd.Howie

/-- In a commutative group, an element of the subgroup generated by a set all of whose elements
satisfy `s ^ m = 1` itself satisfies `x ^ m = 1`. -/
lemma pow_eq_one_of_mem_closure {G : Type*} [CommGroup G] {m : ℕ} {S : Set G}
    (hS : ∀ s ∈ S, s ^ m = 1) {x : G} (hx : x ∈ Subgroup.closure S) : x ^ m = 1 := by
  have hle : Subgroup.closure S ≤ (powMonoidHom m : G →* G).ker :=
    (Subgroup.closure_le _).2 fun s hs => by
      simpa [powMonoidHom_apply] using hS s hs
  exact MonoidHom.mem_ker.1 (hle hx)

theorem isMulTorsion_abelianization_of_pow_mul_commutator {n m : ℕ} (hm : 0 < m)
    (W c : Fin n → FreeGroup (Fin n))
    (hc : ∀ j, c j ∈ commutator (FreeGroup (Fin n)))
    (hW : ∀ j, W j = (FreeGroup.of j) ^ m * c j) :
    IsMulTorsion (Abelianization (PresentedGroup (Set.range W))) := by
  -- Let `φ` be the composite `F → PresentedGroup (range W) → Abelianization …`.
  -- Each relator `W j` is trivial in the presented group, hence in its abelianization,
  -- and the commutator part dies in the abelianization, so `φ (of j) ^ m = 1`.
  have key : ∀ j : Fin n,
      (Abelianization.of.comp (PresentedGroup.mk (Set.range W))) (FreeGroup.of j) ^ m = 1 := by
    intro j
    have hcomm : (Abelianization.of.comp (PresentedGroup.mk (Set.range W))) (c j) = 1 :=
      MonoidHom.mem_ker.1 (Abelianization.commutator_subset_ker _ (hc j))
    have hWj : (Abelianization.of.comp (PresentedGroup.mk (Set.range W))) (W j) = 1 := by
      have h1 := PresentedGroup.one_of_mem (rels := Set.range W) (Set.mem_range_self j)
      simp only [MonoidHom.comp_apply]
      rw [h1]
      rfl
    rw [hW j, map_mul, map_pow, hcomm, mul_one] at hWj
    exact hWj
  -- The abelianization is generated by the images of the generators `of j`.
  have hgen : Subgroup.closure
      (Set.range fun j : Fin n =>
        (Abelianization.of.comp (PresentedGroup.mk (Set.range W))) (FreeGroup.of j)) = ⊤ := by
    have hsurj : Function.Surjective
        (Abelianization.of :
          PresentedGroup (Set.range W) →* Abelianization (PresentedGroup (Set.range W))) :=
      QuotientGroup.mk_surjective
    rw [← Subgroup.map_top_of_surjective _ hsurj,
        ← PresentedGroup.closure_range_of (Set.range W), MonoidHom.map_closure]
    congr 1
    rw [← Set.range_comp]
    congr 1
  intro x
  rw [isOfFinOrder_iff_pow_eq_one]
  refine ⟨m, hm, ?_⟩
  have hx : x ∈ Subgroup.closure
      (Set.range fun j : Fin n =>
        (Abelianization.of.comp (PresentedGroup.mk (Set.range W))) (FreeGroup.of j)) := by
    rw [hgen]
    exact Subgroup.mem_top x
  exact pow_eq_one_of_mem_closure (fun s hs => by obtain ⟨j, rfl⟩ := hs; exact key j) hx

end Work.ORLocInd.Howie
