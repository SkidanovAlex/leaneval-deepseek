# Set-up for the Bieri–Strebel extension theorem (node N11, ORFP2)

Vocabulary used to prove `Work.ORFP2.exists_extension_of_isFP2`.  Given a surjection
`φ : FreeGroup (Fin n) →* G` we write `F = FreeGroup (Fin n)`, `N = ker φ`, `A = k[F]`,
`B = k[G]`, `φ* : A →ₐ[k] B`, `I = augIdeal k F` and `J = ker φ*`.

The file provides a transversal of `N`, the module `N_ab ⊗_ℤ k`, the map `theta0 : A → N_ab ⊗ k`,
and the description of `J` as the ideal generated by the elements `r - 1`, `r ∈ N`.
-/
import Mathlib
import Submission.Work.ORFP2.Basic
import Submission.Work.ORFP2.group_fg_of_augIdeal_fg

set_option autoImplicit false

namespace Work.ORFP2.Ext

open MonoidAlgebra

/-! ## Scalar extension of `ℤ`-modules -/

/-- `d ↦ c * d` as a `ℤ`-linear self-map of a ring. -/
noncomputable def mulLeftInt (k : Type*) [CommRing k] (c : k) : k →ₗ[ℤ] k where
  toFun d := c * d
  map_add' d d' := mul_add c d d'
  map_smul' m d := by
    show c * (m • d) = m • (c * d)
    rw [zsmul_eq_mul, zsmul_eq_mul]
    ring

/-- Scalar extension: the action of `k` on `A ⊗_ℤ k` given by `c • (a ⊗ d) = a ⊗ (c * d)`,
as a `ℤ`-linear map. -/
noncomputable def tsmul (k : Type*) [CommRing k] (A : Type*) [AddCommGroup A] [Module ℤ A]
    (c : k) : TensorProduct ℤ A k →ₗ[ℤ] TensorProduct ℤ A k :=
  TensorProduct.map (LinearMap.id : A →ₗ[ℤ] A) (mulLeftInt k c)

lemma tsmul_tmul (k : Type*) [CommRing k] (A : Type*) [AddCommGroup A] [Module ℤ A]
    (c : k) (a : A) (d : k) : tsmul k A c (a ⊗ₜ[ℤ] d) = a ⊗ₜ[ℤ] (c * d) := by
  rw [tsmul]
  apply TensorProduct.map_tmul

/-- Scalar extension: `A ⊗_ℤ k` is a `k`-module.  (Not a global Mathlib instance, because
`TensorProduct` only provides module structures coming from the first factor.) -/
noncomputable instance instModuleTensorIntRight (k : Type*) [CommRing k]
    (A : Type*) [AddCommGroup A] [Module ℤ A] : Module k (TensorProduct ℤ A k) where
  smul c := tsmul k A c
  one_smul x := by
    show tsmul k A 1 x = x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero]
    | tmul a d => rw [tsmul_tmul, one_mul]
    | add x y hx hy => rw [map_add, hx, hy]
  mul_smul c c' x := by
    show tsmul k A (c * c') x = tsmul k A c (tsmul k A c' x)
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a d => rw [tsmul_tmul, tsmul_tmul, tsmul_tmul, mul_assoc]
    | add x y hx hy => simp only [map_add, hx, hy]
  smul_add c x y := by
    show tsmul k A c (x + y) = tsmul k A c x + tsmul k A c y
    rw [map_add]
  smul_zero c := by
    show tsmul k A c 0 = 0
    rw [map_zero]
  add_smul c c' x := by
    show tsmul k A (c + c') x = tsmul k A c x + tsmul k A c' x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero, add_zero]
    | tmul a d =>
        rw [tsmul_tmul, tsmul_tmul, tsmul_tmul, add_mul, TensorProduct.tmul_add]
    | add x y hx hy =>
        rw [map_add, map_add, map_add, hx, hy]
        abel
  zero_smul x := by
    show tsmul k A 0 x = 0
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero]
    | tmul a d => rw [tsmul_tmul, zero_mul, TensorProduct.tmul_zero]
    | add x y hx hy => rw [map_add, hx, hy, add_zero]

@[simp] lemma smul_tmul_int (k : Type*) [CommRing k] {A : Type*} [AddCommGroup A] [Module ℤ A]
    (c : k) (a : A) (d : k) : c • (a ⊗ₜ[ℤ] d) = a ⊗ₜ[ℤ] (c * d) := by
  change tsmul k A c (a ⊗ₜ[ℤ] d) = _
  rw [tsmul_tmul]

@[simp] lemma smul_tmul_int_one (k : Type*) [CommRing k] {A : Type*} [AddCommGroup A] [Module ℤ A]
    (c : k) (a : A) : c • (a ⊗ₜ[ℤ] (1 : k)) = a ⊗ₜ[ℤ] c := by
  rw [smul_tmul_int, mul_one]

variable (k : Type*) [CommRing k] {n : ℕ} {G : Type*} [Group G]

/-! ## A transversal of the kernel -/

section Transversal

variable (φ : FreeGroup (Fin n) →* G) (hφ : Function.Surjective φ)

/-- A set-theoretic splitting of `φ`, normalised at `1`. -/
noncomputable def sec : G → FreeGroup (Fin n) := by
  classical
  exact fun g => if g = 1 then 1 else Function.surjInv hφ g

lemma phi_sec (g : G) : φ (sec φ hφ g) = g := by
  classical
  unfold sec
  split_ifs with h
  · rw [h, map_one]
  · exact Function.surjInv_eq hφ g

@[simp] lemma sec_one : sec φ hφ 1 = 1 := by
  classical
  simp only [sec, if_true]

/-- `nw w = sec (φ w)⁻¹ * w` lies in `ker φ`. -/
noncomputable def nw (w : FreeGroup (Fin n)) : FreeGroup (Fin n) := (sec φ hφ (φ w))⁻¹ * w

lemma sec_mul_nw (w : FreeGroup (Fin n)) : sec φ hφ (φ w) * nw φ hφ w = w := by
  rw [nw]; group

lemma phi_nw (w : FreeGroup (Fin n)) : φ (nw φ hφ w) = 1 := by
  have h := congrArg φ (sec_mul_nw φ hφ w)
  simp only [map_mul] at h
  rw [phi_sec] at h
  exact mul_left_cancel (h.trans (mul_one _).symm)

lemma nw_mem (w : FreeGroup (Fin n)) : nw φ hφ w ∈ φ.ker := by
  rw [MonoidHom.mem_ker]; exact phi_nw φ hφ w

lemma nw_mul {w r : FreeGroup (Fin n)} (hr : r ∈ φ.ker) : nw φ hφ (w * r) = nw φ hφ w * r := by
  have h : φ (w * r) = φ w := by rw [map_mul, MonoidHom.mem_ker.mp hr, mul_one]
  rw [nw, nw, h, mul_assoc]

@[simp] lemma nw_one : nw φ hφ 1 = 1 := by
  rw [nw, map_one, sec_one, inv_one, one_mul]

end Transversal

/-! ## `N_ab ⊗_ℤ k` -/

section Module

variable (φ : FreeGroup (Fin n) →* G)

/-- `N_ab ⊗_ℤ k` for `N = ker φ`. -/
abbrev KerMod : Type _ := TensorProduct ℤ (Additive (Abelianization ↥(φ.ker))) k

/-- The class of `x ∈ N` in `N_ab ⊗_ℤ k`. -/
noncomputable def cls (x : ↥(φ.ker)) : KerMod k φ :=
  (Additive.ofMul (Abelianization.of x)) ⊗ₜ[ℤ] (1 : k)

lemma cls_mul (x y : ↥(φ.ker)) : cls k φ (x * y) = cls k φ x + cls k φ y := by
  rw [cls, cls, cls, map_mul]
  simp only [ofMul_mul, TensorProduct.add_tmul]

@[simp] lemma cls_one : cls k φ 1 = 0 := by
  rw [cls, map_one]
  simp

lemma cls_inv (x : ↥(φ.ker)) : cls k φ x⁻¹ = -cls k φ x := by
  have h : cls k φ x⁻¹ + cls k φ x = 0 := by
    rw [← cls_mul, inv_mul_cancel, cls_one]
  exact eq_neg_of_add_eq_zero_left h

lemma smul_cls (c : k) (x : ↥(φ.ker)) :
    c • cls k φ x = (Additive.ofMul (Abelianization.of x)) ⊗ₜ[ℤ] c := by
  rw [cls, smul_tmul_int, mul_one]

/-- The `k`-linear map `A → N_ab ⊗ k`, `w ↦ class of nw w`. -/
noncomputable def theta0 (hφ : Function.Surjective φ) :
    MonoidAlgebra k (FreeGroup (Fin n)) →ₗ[k] KerMod k φ where
  toFun a := (Finsupp.linearCombination k (fun w => cls k φ ⟨nw φ hφ w, nw_mem φ hφ w⟩)) a.coeff
  map_add' a b := by rw [MonoidAlgebra.coeff_add, map_add]
  map_smul' c a := by rw [MonoidAlgebra.coeff_smul]; exact map_smul _ c _

lemma theta0_single (hφ : Function.Surjective φ) (w : FreeGroup (Fin n)) (c : k) :
    theta0 k φ hφ (single w c) = c • cls k φ ⟨nw φ hφ w, nw_mem φ hφ w⟩ := by
  change (Finsupp.linearCombination k
    (fun w => cls k φ ⟨nw φ hφ w, nw_mem φ hφ w⟩)) (MonoidAlgebra.coeff (single w c)) = _
  rw [MonoidAlgebra.coeff_single, Finsupp.linearCombination_single]

end Module

/-! ## The algebra map `k[F] → k[G]` and its kernel -/

section AlgebraMap

variable (φ : FreeGroup (Fin n) →* G)

/-- The algebra map `k[F] → k[G]` induced by `φ`. -/
noncomputable def phiAlg : MonoidAlgebra k (FreeGroup (Fin n)) →ₐ[k] MonoidAlgebra k G :=
  MonoidAlgebra.mapDomainAlgHom k k φ

/-- The kernel of the algebra map `k[F] → k[G]`, i.e. the ideal of relations. -/
noncomputable def JJ : Ideal (MonoidAlgebra k (FreeGroup (Fin n))) :=
  RingHom.ker (phiAlg k φ).toRingHom

/-- The ideal generated by the elements `r - 1`, `r ∈ ker φ`. -/
noncomputable def Jspan (φ : FreeGroup (Fin n) →* G) :
    Ideal (MonoidAlgebra k (FreeGroup (Fin n))) :=
  Ideal.span (Set.range fun r : ↥(φ.ker) =>
    MonoidAlgebra.single (r : FreeGroup (Fin n)) (1 : k) - 1)

/-- The `A`-linear map `(↥(ker φ) →₀ A) →ₗ A`, `c ↦ ∑ r, c r • (r - 1)`. -/
noncomputable def comb (φ : FreeGroup (Fin n) →* G) :
    (↥(φ.ker) →₀ MonoidAlgebra k (FreeGroup (Fin n))) →ₗ[MonoidAlgebra k (FreeGroup (Fin n))]
      MonoidAlgebra k (FreeGroup (Fin n)) :=
  Finsupp.linearCombination _
    (fun r : ↥(φ.ker) => MonoidAlgebra.single (r : FreeGroup (Fin n)) (1 : k) - 1)

lemma range_comb : LinearMap.range (comb k φ) = Jspan k φ := by
  rw [comb, Finsupp.range_linearCombination, Jspan]

lemma comb_apply (c : ↥(φ.ker) →₀ MonoidAlgebra k (FreeGroup (Fin n))) :
    comb k φ c = c.sum (fun r a => a • (MonoidAlgebra.single (r : FreeGroup (Fin n)) (1 : k) - 1)) := by
  rw [comb, Finsupp.linearCombination_apply]

lemma phiAlg_single (w : FreeGroup (Fin n)) (c : k) :
    phiAlg k φ (single w c) = single (φ w) c := by
  rw [phiAlg, MonoidAlgebra.mapDomainAlgHom_apply, MonoidAlgebra.mapDomain_single]

lemma phiAlg_single_sub_one (r : ↥(φ.ker)) :
    phiAlg k φ (single (r : FreeGroup (Fin n)) (1 : k) - 1) = 0 := by
  rw [map_sub, phiAlg_single, MonoidHom.mem_ker.mp r.2, map_one, MonoidAlgebra.one_def.symm,
    sub_self]

lemma Jspan_le_JJ : Jspan k φ ≤ JJ k φ := by
  rw [Jspan, Ideal.span_le]
  rintro _ ⟨r, rfl⟩
  show phiAlg k φ (MonoidAlgebra.single (r : FreeGroup (Fin n)) (1 : k) - 1) = 0
  exact phiAlg_single_sub_one k φ r

variable (hφ : Function.Surjective φ)

/-- The `k`-linear retraction of `k[G] → k[F]` given by a transversal of `ker φ`. -/
noncomputable def tau : MonoidAlgebra k G →ₗ[k] MonoidAlgebra k (FreeGroup (Fin n)) where
  toFun b := (Finsupp.linearCombination k
    (fun g : G => MonoidAlgebra.single (sec φ hφ g) (1 : k))) b.coeff
  map_add' a b := by rw [MonoidAlgebra.coeff_add, map_add]
  map_smul' c a := by rw [MonoidAlgebra.coeff_smul]; exact map_smul _ c _

lemma tau_single (g : G) (c : k) :
    tau k φ hφ (single g c) = c • MonoidAlgebra.single (sec φ hφ g) (1 : k) := by
  change (Finsupp.linearCombination k
    (fun g : G => MonoidAlgebra.single (sec φ hφ g) (1 : k)))
      (MonoidAlgebra.coeff (single g c)) = _
  rw [MonoidAlgebra.coeff_single, Finsupp.linearCombination_single]

lemma phiAlg_tau (b : MonoidAlgebra k G) : phiAlg k φ (tau k φ hφ b) = b := by
  have hb : b = ∑ g ∈ b.coeff.support, b.coeff g • (single g (1:k) : MonoidAlgebra k G) :=
    eq_sum_smul_single k G b
  have ht : tau k φ hφ b = ∑ g ∈ b.coeff.support,
      b.coeff g • (single (sec φ hφ g) (1:k) : MonoidAlgebra k (FreeGroup (Fin n))) := by
    change (Finsupp.linearCombination k
      (fun g : G => MonoidAlgebra.single (sec φ hφ g) (1 : k))) b.coeff = _
    rw [Finsupp.linearCombination_apply, Finsupp.sum]
  rw [ht]
  conv_rhs => rw [hb]
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro g _
  rw [map_smul, phiAlg_single, phi_sec]

lemma sub_tau_mem (x : MonoidAlgebra k (FreeGroup (Fin n))) :
    x - tau k φ hφ (phiAlg k φ x) ∈ Jspan k φ := by
  have h1 : x = ∑ w ∈ x.coeff.support,
      x.coeff w • (single w (1:k) : MonoidAlgebra k (FreeGroup (Fin n))) :=
    eq_sum_smul_single k (FreeGroup (Fin n)) x
  have hphi : phiAlg k φ x = ∑ w ∈ x.coeff.support,
      x.coeff w • (single (φ w) (1:k) : MonoidAlgebra k G) := by
    conv_lhs => rw [h1]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro w _
    rw [map_smul, phiAlg_single]
  have ht : tau k φ hφ (phiAlg k φ x) = ∑ w ∈ x.coeff.support,
      x.coeff w • (single (sec φ hφ (φ w)) (1:k) : MonoidAlgebra k (FreeGroup (Fin n))) := by
    rw [hphi, map_sum]
    apply Finset.sum_congr rfl
    intro w _
    rw [smul_single, smul_eq_mul, mul_one, tau_single]
  have hgoal : x - tau k φ hφ (phiAlg k φ x)
      = ∑ w ∈ x.coeff.support, x.coeff w •
          ((single w (1:k) : MonoidAlgebra k (FreeGroup (Fin n)))
            - single (sec φ hφ (φ w)) (1:k)) := by
    nth_rewrite 1 [h1]
    rw [ht, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro w _
    rw [smul_sub]
  rw [hgoal]
  apply Submodule.sum_mem
  intro w _
  rw [Algebra.smul_def]
  have hgen : MonoidAlgebra.single (nw φ hφ w) (1:k) - 1 ∈ Jspan k φ :=
    Ideal.subset_span ⟨⟨nw φ hφ w, nw_mem φ hφ w⟩, rfl⟩
  have hw : (single w (1:k) : MonoidAlgebra k (FreeGroup (Fin n)))
      - single (sec φ hφ (φ w)) (1:k)
      = single (sec φ hφ (φ w)) (1:k) * (MonoidAlgebra.single (nw φ hφ w) (1:k) - 1) := by
    rw [mul_sub, mul_one, single_mul_single, mul_one, sec_mul_nw]
  rw [hw, ← mul_assoc]
  exact Ideal.mul_mem_left _ _ hgen

/-- The kernel of `k[F] → k[G]` is the ideal generated by the elements `r - 1`, `r ∈ ker φ`. -/
theorem mem_JJ_iff (hφ : Function.Surjective φ) (x : MonoidAlgebra k (FreeGroup (Fin n))) :
    x ∈ JJ k φ ↔ x ∈ Jspan k φ := by
  constructor
  · intro hx
    have hx' : phiAlg k φ x = 0 := hx
    have h := sub_tau_mem k φ hφ x
    rw [hx', map_zero, sub_zero] at h
    exact h
  · intro hx
    exact Jspan_le_JJ k φ hx

end AlgebraMap

end Work.ORFP2.Ext
