# The `⟸` direction of the Bieri–Strebel lemma (JL Lemma 4.3)

If `G` is the quotient of a finitely presented group `E` by a normal subgroup `N` with
`N_ab ⊗_ℤ k = 0`, then `G` is of type `FP₂` over `k`: the augmentation ideal of `k[G]` is a
finitely presented `k[G]`-module.

Choose a finite presentation `1 → R → F(Fin n) → E → 1` of `E` and let `M = ker (F → G) ⊇ R`,
so that `M/R ≅ N`.  By `isFP2_iff_relationModule_fg` it suffices to show that the relation
module `V = relationModule k G (F → G)` is finitely generated.  The Fox calculus of
`Submission.Work.ORFP2.Fox` produces, for every `m ∈ M`, an element `foxGamma m ∈ V`, and

* `V` is the `k[G]`-span of `foxGamma '' M` (the Fox derivative computes the relation module);
* `foxGamma '' M ⊆ span (foxGamma '' R)` — this is where `N_ab ⊗_ℤ k = 0` enters: the map
  `m ↦ foxGamma m` descends to `M/R ≅ N` and the resulting homomorphism into the abelian group
  `k[G]ⁿ / span (foxGamma '' R)` must be trivial;
* `R` is the normal closure of a finite set `S`, so `span (foxGamma '' R) = span (foxGamma '' S)`
  by the cocycle rule and the equivariance of `foxGamma`.

Hence `V` is generated by the finite set `foxGamma '' S`.
-/
import Mathlib
import Submission.Work.ORFP2.Basic
import Submission.Work.ORFP2.Fox
import Submission.Work.ORFP2.isFP2_iff_relationModule_fg
import Submission.Work.ORFP2.mapDomainAlgHom_eq_zero_iff_mem_span
import Submission.Work.ORFP2.eq_one_of_subsingleton_abelianizationTensor

set_option autoImplicit false
set_option linter.unusedVariables false

open MonoidAlgebra

namespace Work.ORFP2

theorem IsFP2_of_extension (k : Type*) [CommRing k] [Nontrivial k]
    (hbasis : FreeGroupAugIdealBasis k) (G : Type*) [Group G]
    (E : Type*) [Group E] (f : E →* G) (hf : Function.Surjective f)
    (hE : Group.IsFinitelyPresented E) (hN : H1Vanishes k (MonoidHom.ker f)) :
    IsFP2 k G := by
  classical
  obtain ⟨n, ψ, hψ, S, hSfin, hS⟩ := hE.out
  let φ : FreeGroup (Fin n) →* G := f.comp ψ
  have hφ : Function.Surjective φ := hf.comp hψ
  have hRle : MonoidHom.ker ψ ≤ MonoidHom.ker φ := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx ⊢
    rw [show φ x = f (ψ x) from rfl, hx, map_one]
  have hSle : ∀ s ∈ S, s ∈ MonoidHom.ker φ := fun s hs =>
    hRle (show s ∈ MonoidHom.ker ψ from hS ▸ Subgroup.subset_normalClosure hs)
  -- The submodule generated by `foxGamma` on `ker ψ`
  let W : Submodule (MonoidAlgebra k G) (Fin n →₀ MonoidAlgebra k G) :=
    Submodule.span (MonoidAlgebra k G)
      (foxGamma k n φ '' (MonoidHom.ker ψ : Set (FreeGroup (Fin n))))
  -- (I): `foxGamma` on all of `ker φ` generates the relation module
  have hI : relationModule k G φ ≤
      Submodule.span (MonoidAlgebra k G)
        (Set.range fun m : MonoidHom.ker φ => foxGamma k n φ (m : FreeGroup (Fin n))) := by
    intro v hv
    rw [relationModule, LinearMap.mem_ker] at hv
    obtain ⟨w, hw⟩ := Finsupp.mapRange_surjective (MonoidAlgebra.mapDomainAlgHom k k φ)
      (map_zero _) (mapDomainAlgHom_surjective k φ hφ) v
    have hwk : foxPush k n φ w = v := hw
    have h1 : MonoidAlgebra.mapDomainAlgHom k k φ (foxLambda k n w) = 0 := by
      rw [← relMap_foxPush, hwk]; exact hv
    have h2 := (mapDomainAlgHom_eq_zero_iff_mem_span k φ hφ (foxLambda k n w)).mp h1
    have hK : Submodule.span (MonoidAlgebra k (FreeGroup (Fin n)))
          (Set.range fun m : MonoidHom.ker φ =>
            MonoidAlgebra.single (m : FreeGroup (Fin n)) (1 : k) - 1) ≤
        Submodule.map (foxLambda k n)
          (Submodule.span (MonoidAlgebra k (FreeGroup (Fin n)))
            (Set.range fun m : MonoidHom.ker φ => foxDelta k n (m : FreeGroup (Fin n)))) := by
      rw [Submodule.span_le]
      rintro y ⟨m, rfl⟩
      exact Submodule.mem_map.mpr ⟨foxDelta k n (m : FreeGroup (Fin n)),
        Submodule.subset_span ⟨m, rfl⟩, foxLambda_foxDelta k n (m : FreeGroup (Fin n))⟩
    obtain ⟨p, hp, hpx⟩ := Submodule.mem_map.mp (hK h2)
    have h3 : w ∈ Submodule.span (MonoidAlgebra k (FreeGroup (Fin n)))
        (Set.range fun m : MonoidHom.ker φ => foxDelta k n (m : FreeGroup (Fin n))) := by
      rw [foxLambda_injective k n hpx] at hp; exact hp
    have key : ∀ x ∈ Submodule.span (MonoidAlgebra k (FreeGroup (Fin n)))
          (Set.range fun m : MonoidHom.ker φ => foxDelta k n (m : FreeGroup (Fin n))),
        foxPush k n φ x ∈ Submodule.span (MonoidAlgebra k G)
          (Set.range fun m : MonoidHom.ker φ => foxGamma k n φ (m : FreeGroup (Fin n))) := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem y hy => obtain ⟨m, rfl⟩ := hy; exact Submodule.subset_span ⟨m, rfl⟩
      | zero =>
          rw [show foxPush k n φ 0 = 0 from Finsupp.mapRange_zero]
          exact Submodule.zero_mem _
      | add y z hy hz ihy ihz => rw [foxPush_add]; exact Submodule.add_mem _ ihy ihz
      | smul a y hy ihy => rw [foxPush_smul]; exact Submodule.smul_mem _ _ ihy
    have h4 := key w h3
    rw [hwk] at h4
    exact h4
  -- (II): the vanishing of `N_ab ⊗ k` upgrades generation on `ker φ` to generation on `ker ψ`
  have hII : Submodule.span (MonoidAlgebra k G)
        (Set.range fun m : MonoidHom.ker φ => foxGamma k n φ (m : FreeGroup (Fin n))) ≤ W := by
    let ψM : MonoidHom.ker φ →* MonoidHom.ker f :=
      { toFun := fun m => ⟨ψ (m : FreeGroup (Fin n)), m.2⟩
        map_one' := by ext; simp
        map_mul' := by intro a b; ext; simp }
    have hψM : Function.Surjective ψM := by
      intro y
      obtain ⟨m, hm⟩ := hψ (y : E)
      refine ⟨⟨m, ?_⟩, Subtype.ext hm⟩
      rw [MonoidHom.mem_ker, show φ m = f (ψ m) from rfl, hm]
      exact y.2
    let γ' : MonoidHom.ker φ →* Multiplicative ((Fin n →₀ MonoidAlgebra k G) ⧸ W) :=
      { toFun := fun m =>
          Multiplicative.ofAdd (Submodule.Quotient.mk (foxGamma k n φ (m : FreeGroup (Fin n))))
        map_one' := by
          change Multiplicative.ofAdd (Submodule.Quotient.mk
            (foxGamma k n φ (1 : FreeGroup (Fin n)))) = 1
          rw [show foxGamma k n φ (1 : FreeGroup (Fin n)) = 0 from foxGamma_one k n φ]
          show Multiplicative.ofAdd (Submodule.Quotient.mk (0 : Fin n →₀ MonoidAlgebra k G)) = 1
          show Submodule.Quotient.mk (0 : Fin n →₀ MonoidAlgebra k G)
            = (0 : (Fin n →₀ MonoidAlgebra k G) ⧸ W)
          rw [Submodule.Quotient.mk_eq_zero]
          exact Submodule.zero_mem W
        map_mul' := by
          intro a b
          show Multiplicative.ofAdd (Submodule.Quotient.mk
              (foxGamma k n φ ((a : FreeGroup (Fin n)) * (b : FreeGroup (Fin n)))))
            = Multiplicative.ofAdd (Submodule.Quotient.mk (foxGamma k n φ (a : FreeGroup (Fin n))))
              * Multiplicative.ofAdd (Submodule.Quotient.mk (foxGamma k n φ (b : FreeGroup (Fin n))))
          rw [foxGamma_add k n φ (a : FreeGroup (Fin n)) (b : FreeGroup (Fin n)) a.2 b.2,
            Submodule.Quotient.mk_add]
          rfl }
    have hγ'ker : MonoidHom.ker ψM ≤ MonoidHom.ker γ' := by
      intro m hm
      rw [MonoidHom.mem_ker] at hm ⊢
      have hm' : ψ (m : FreeGroup (Fin n)) = 1 := by
        have h := congrArg (fun z : MonoidHom.ker f => (z : E)) hm
        simpa [ψM] using h
      show Submodule.Quotient.mk (foxGamma k n φ (m : FreeGroup (Fin n)))
          = (0 : (Fin n →₀ MonoidAlgebra k G) ⧸ W)
      rw [Submodule.Quotient.mk_eq_zero]
      exact Submodule.subset_span ⟨(m : FreeGroup (Fin n)), hm', rfl⟩
    let β : MonoidHom.ker f →* Multiplicative ((Fin n →₀ MonoidAlgebra k G) ⧸ W) :=
      ψM.liftOfRightInverse (Function.surjInv hψM) (Function.rightInverse_surjInv hψM)
        ⟨γ', hγ'ker⟩
    have hβ : ∀ a, β a = 1 := eq_one_of_subsingleton_abelianizationTensor k β hN
    rw [Submodule.span_le]
    rintro y ⟨m, rfl⟩
    have hm1 : γ' m = 1 := by
      have h2 : β (ψM m) = γ' m :=
        MonoidHom.liftOfRightInverseAux_comp_apply ψM (Function.surjInv hψM)
          (Function.rightInverse_surjInv hψM) γ' hγ'ker m
      rw [← h2]; exact hβ (ψM m)
    have hmk : Submodule.Quotient.mk (foxGamma k n φ (m : FreeGroup (Fin n)))
        = (0 : (Fin n →₀ MonoidAlgebra k G) ⧸ W) := hm1
    rw [Submodule.Quotient.mk_eq_zero] at hmk
    exact hmk
  -- (III): `ker ψ` is the normal closure of the finite set `S`
  have hIII : W ≤ Submodule.span (MonoidAlgebra k G) (foxGamma k n φ '' S) := by
    have hSle' : ∀ x : FreeGroup (Fin n),
        x ∈ Subgroup.closure (Group.conjugatesOfSet S) → x ∈ MonoidHom.ker φ :=
      fun x hx => hRle (show x ∈ MonoidHom.ker ψ from hS ▸ hx)
    rw [Submodule.span_le]
    rintro y ⟨r, hr, rfl⟩
    have key : ∀ x : FreeGroup (Fin n), x ∈ Subgroup.normalClosure S →
        foxGamma k n φ x ∈ Submodule.span (MonoidAlgebra k G) (foxGamma k n φ '' S) := by
      intro x hx
      rw [Subgroup.normalClosure] at hx
      refine Subgroup.closure_induction ?_ ?_ ?_ ?_ hx
      · intro y hy
        rw [Group.mem_conjugatesOfSet_iff] at hy
        obtain ⟨s, hs, hc⟩ := hy
        obtain ⟨g, hg⟩ := isConj_iff.1 hc
        subst hg
        rw [foxGamma_conj k n φ g s (hSle s hs)]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨s, hs, rfl⟩)
      · rw [foxGamma_one]; exact Submodule.zero_mem _
      · intro a b ha hb iha ihb
        rw [foxGamma_add k n φ a b (hSle' a ha) (hSle' b hb)]
        exact Submodule.add_mem _ iha ihb
      · intro a ha iha
        rw [foxGamma_inv k n φ a (hSle' a ha)]
        exact Submodule.neg_mem _ iha
    exact key r (show r ∈ Subgroup.normalClosure S from hS.symm ▸ hr)
  have hspan : relationModule k G φ =
      Submodule.span (MonoidAlgebra k G) (foxGamma k n φ '' S) := by
    refine le_antisymm ?_ ?_
    · calc relationModule k G φ
          ≤ Submodule.span (MonoidAlgebra k G)
              (Set.range fun m : MonoidHom.ker φ => foxGamma k n φ (m : FreeGroup (Fin n))) := hI
        _ ≤ W := hII
        _ ≤ Submodule.span (MonoidAlgebra k G) (foxGamma k n φ '' S) := hIII
    · rw [Submodule.span_le]
      rintro y ⟨s, hs, rfl⟩
      exact foxGamma_mem k n φ s (hSle s hs)
  refine (isFP2_iff_relationModule_fg k G φ hφ).mpr ?_
  rw [hspan]
  have hfin : (foxGamma k n φ '' S).Finite := hSfin.image _
  exact ⟨hfin.toFinset, by rw [Set.Finite.coe_toFinset]⟩

end Work.ORFP2
