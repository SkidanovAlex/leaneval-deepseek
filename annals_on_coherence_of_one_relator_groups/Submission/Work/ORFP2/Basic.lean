# FP₂ groups and the Bieri–Strebel criterion (node N11 of the ORFP2 area)

This file sets up the vocabulary for node N11 of the route design for
`annals_on_coherence_of_one_relator_groups`:

* `Work.ORFP2.augIdeal k G` : the augmentation ideal of the group algebra `k[G]`;
* `Work.ORFP2.IsFP2 k G` : `G` is of type `FP₂` over `k`, i.e. the left ideal `augIdeal k G`
  is finitely presented as a `k[G]`-module;
* `Work.ORFP2.H1Vanishes k N` : `N_ab ⊗_ℤ k = 0`;
* `Work.ORFP2.HasFP2Extension k G` : the right hand side of Bieri–Strebel's Lemma 2.1.
-/
import ChallengeDeps
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.GroupTheory.Abelianization.Defs

set_option autoImplicit false

namespace Work.ORFP2

open MonoidAlgebra

section Augmentation

variable (k : Type*) [CommSemiring k] (G : Type*) [Group G]

/-- The augmentation map `k[G] →+* k`, `∑ c_g g ↦ ∑ c_g`. -/
noncomputable def augmentation : MonoidAlgebra k G →+* k :=
  ((MonoidAlgebra.lift k k G (1 : G →* k) : MonoidAlgebra k G →ₐ[k] k) : MonoidAlgebra k G →+* k)

@[simp]
lemma augmentation_single (g : G) (c : k) :
    augmentation k G (MonoidAlgebra.single g c) = c := by
  simp [augmentation]

@[simp]
lemma augmentation_one : augmentation k G (1 : MonoidAlgebra k G) = 1 :=
  map_one _

@[simp]
lemma augmentation_zero : augmentation k G (0 : MonoidAlgebra k G) = 0 :=
  map_zero _

@[simp]
lemma augmentation_of (g : G) : augmentation k G (MonoidAlgebra.of k G g) = 1 := by
  simp [augmentation]

end Augmentation

section AugIdeal

variable (k : Type*) [CommRing k] (G : Type*) [Group G]

/-- The augmentation ideal of the group algebra `k[G]`: the ideal generated by the elements
`single g 1 - 1`, `g : G` (equivalently, the kernel of the augmentation map `k[G] → k`). -/
noncomputable def augIdeal : Ideal (MonoidAlgebra k G) :=
  Ideal.span (Set.range fun g : G => MonoidAlgebra.single g (1 : k) - 1)

lemma single_sub_one_mem_augIdeal (g : G) :
    MonoidAlgebra.single g (1 : k) - 1 ∈ augIdeal k G :=
  Ideal.subset_span ⟨g, rfl⟩

theorem augIdeal_eq_span :
    augIdeal k G = Ideal.span (Set.range fun g : G => MonoidAlgebra.single g (1 : k) - 1) :=
  rfl

end AugIdeal


section Transfer

variable (k : Type*) [CommSemiring k] {G : Type*} [Group G]

/-- The natural algebra map `k[H] →ₐ[k] k[G]` induced by the inclusion `H ≤ G`. -/
noncomputable def transferHom (H : Subgroup G) : MonoidAlgebra k H →ₐ[k] MonoidAlgebra k G :=
  MonoidAlgebra.mapDomainAlgHom k k H.subtype

lemma transferHom_single (H : Subgroup G) (h : H) (c : k) :
    transferHom k H (MonoidAlgebra.single h c) = MonoidAlgebra.single (h : G) c := by
  simp [transferHom]

lemma transferHom_injective (H : Subgroup G) : Function.Injective (transferHom k H) :=
  MonoidAlgebra.mapDomain_injective (fun a b h => Subtype.ext h)

end Transfer

section FP2

variable (k : Type*) [CommRing k] (G : Type*) [Group G]

/-- `G` is of type `FP₂` over `k` when the augmentation ideal of `k[G]` is a finitely
presented left `k[H]`-module. -/
def IsFP2 : Prop := Module.FinitePresentation (MonoidAlgebra k G) (augIdeal k G)

end FP2

section BS78

variable (k : Type*) [Ring k] (G : Type*) [Group G]

/-- `N_ab ⊗_ℤ k = 0`, i.e. the first homology of `N` with coefficients in the trivial module `k`
vanishes. -/
def H1Vanishes (N : Type*) [Group N] : Prop :=
  Subsingleton (TensorProduct ℤ (Additive (Abelianization N)) k)

/-- The Bieri–Strebel condition: `G` is a quotient of a finitely presented group `E` by a normal
subgroup `N` with `N_ab ⊗_ℤ k = 0`. -/
def HasFP2Extension : Prop :=
  ∃ (E : Type*) (_ : Group E) (f : E →* G),
    Function.Surjective f ∧ Group.IsFinitelyPresented E ∧ H1Vanishes k (MonoidHom.ker f)

end BS78

section Relation

variable (k : Type*) [CommRing k] (G : Type*) [Group G]

/-- For a surjection `φ : F(Fin n) →* G`, the `k[G]`-linear map `k[G]^n → k[G]`
sending the `i`-th free generator to `φ(x_i) - 1`. Its kernel is the relation module of the
presentation. -/
noncomputable def relMap {n : ℕ} (φ : FreeGroup (Fin n) →* G) :
    (Fin n →₀ MonoidAlgebra k G) →ₗ[MonoidAlgebra k G] MonoidAlgebra k G :=
  Finsupp.linearCombination (MonoidAlgebra k G)
    (fun i => MonoidAlgebra.single (φ (FreeGroup.of i)) (1 : k) - 1)

/-- The relation module of the presentation `φ : F(Fin n) →* G` over `k`. -/
noncomputable def relationModule {n : ℕ} (φ : FreeGroup (Fin n) →* G) :
    Submodule (MonoidAlgebra k G) (Fin n →₀ MonoidAlgebra k G) :=
  LinearMap.ker (relMap k G φ)

lemma range_relMap {n : ℕ} (φ : FreeGroup (Fin n) →* G) :
    LinearMap.range (relMap k G φ)
      = Ideal.span (Set.range fun i : Fin n => MonoidAlgebra.single (φ (FreeGroup.of i)) (1 : k) - 1) := by
  rw [relMap, Finsupp.range_linearCombination]

end Relation

section FreeGroupBasis

variable (k : Type*) [CommRing k]

/-- **The augmentation ideal of a free group algebra is free on the elements `x - 1`.**

For every set of generators `α` of a free group `F = FreeGroup α`, the `k[F]`-linear map
`c ↦ ∑ a, c a * (x_a - 1)` from `α →₀ k[F]` onto the augmentation ideal `augIdeal k F` is a
bijection.  This is the classical fact underlying the Fox derivative; it is proved in
`Work.ORFP2.exists_augIdealFreeBasis`. -/
def FreeGroupAugIdealBasis : Prop :=
  ∀ (α : Type*) [DecidableEq α],
    ∃ e : (α →₀ MonoidAlgebra k (FreeGroup α)) ≃ₗ[MonoidAlgebra k (FreeGroup α)]
        augIdeal k (FreeGroup α),
      ∀ c, (e c : MonoidAlgebra k (FreeGroup α))
        = c.sum (fun a x => x * (MonoidAlgebra.single (FreeGroup.of a) (1 : k) - 1))

end FreeGroupBasis

section HomCoherent

variable (k : Type*) [CommRing k] (G : Type*) [Group G]

/-- A group is **homologically coherent over `k`** (JL §1) if every finitely generated subgroup is
of type `FP₂` over `k`. -/
def HomologicallyCoherent : Prop := ∀ H : Subgroup G, H.FG → IsFP2 k H

end HomCoherent

end Work.ORFP2
