import Mathlib
import Submission.Work.ORFP2.Basic

set_option autoImplicit false

namespace Work.ORFP2

open MonoidAlgebra

/-!
# Finitely generated augmentation ideal implies finitely generated group

We prove that if the augmentation ideal `I_{k[G]}` of the group algebra `k[G]` is finitely
generated as a (left) `k[G]`-module, then the group `G` is finitely generated.

The strategy is the classical one.  Let `f_1,...,f_n` generate `I_{k[G]}` and let `H <= G` be the
subgroup generated by the supports of the `f_i`.  Suppose `H < G`.  Then the `k`-linear functional
`l_H : k[G] -> k` which sums the coefficients indexed by `H` is *not* `k[G]`-linear, but it is
invariant under right multiplication by elements of `H` (`coeffSum_mul_single_mem`).  Since each
`f_i` in `I_{k[G]}` is supported in `H`, it is a `k`-linear combination of elements `h - 1` with
`h` in `H`, whence `l_H (a * f_i) = 0` for every `a` in `k[G]`.  As `I_{k[G]}` is generated by the
`f_i`, we get `l_H (g - 1) = 0` for every `g` in `G`.  But `l_H (g - 1) = [g in H] - 1`, and
`1 != 0` in `k`, so `g` in `H` -- a contradiction.
-/

section Aux

variable (k : Type*) [CommRing k] (G : Type*) [Group G]

/-- The `k`-linear functional on `k[G]` which sums the coefficients indexed by the subgroup `H`. -/
noncomputable def coeffSum (H : Subgroup G) : MonoidAlgebra k G →ₗ[k] k where
  toFun b := (Finsupp.linearCombination k (Set.indicator (H : Set G) (fun _ => (1 : k)))) b.coeff
  map_add' x y := by rw [MonoidAlgebra.coeff_add, map_add]
  map_smul' c x := by rw [MonoidAlgebra.coeff_smul, map_smul, RingHom.id_apply]

lemma coeffSum_single_of_mem (H : Subgroup G) {g : G} (hg : g ∈ H) (c : k) :
    coeffSum k G H (MonoidAlgebra.single g c) = c := by
  change (Finsupp.linearCombination k (Set.indicator (H : Set G) (fun _ => (1 : k))))
      (MonoidAlgebra.single g c).coeff = c
  rw [MonoidAlgebra.coeff_single, Finsupp.linearCombination_single,
    Set.indicator_of_mem hg, smul_eq_mul, mul_one]

lemma coeffSum_single_of_notMem (H : Subgroup G) {g : G} (hg : g ∉ H) (c : k) :
    coeffSum k G H (MonoidAlgebra.single g c) = 0 := by
  change (Finsupp.linearCombination k (Set.indicator (H : Set G) (fun _ => (1 : k))))
      (MonoidAlgebra.single g c).coeff = 0
  rw [MonoidAlgebra.coeff_single, Finsupp.linearCombination_single,
    Set.indicator_of_notMem hg, smul_zero]

lemma coeffSum_one (H : Subgroup G) : coeffSum k G H (1 : MonoidAlgebra k G) = 1 := by
  rw [MonoidAlgebra.one_def]
  exact coeffSum_single_of_mem k G H H.one_mem 1

/-- `l_H` is invariant under right multiplication by an element of `H`. -/
lemma coeffSum_mul_single_mem {H : Subgroup G} {h : G} (hh : h ∈ H) (a : MonoidAlgebra k G) :
    coeffSum k G H (a * MonoidAlgebra.single h 1) = coeffSum k G H a := by
  have key : ∀ v : G →₀ k,
      coeffSum k G H (MonoidAlgebra.ofCoeff v * MonoidAlgebra.single h 1)
        = coeffSum k G H (MonoidAlgebra.ofCoeff v) := by
    intro v
    induction v using Finsupp.induction_linear with
    | zero => simp
    | add f g hf hg =>
        rw [MonoidAlgebra.ofCoeff_add, add_mul, map_add, map_add, hf, hg]
    | single t c =>
        rw [MonoidAlgebra.ofCoeff_single, MonoidAlgebra.single_mul_single, mul_one]
        by_cases ht : t ∈ H
        · rw [coeffSum_single_of_mem k G H (H.mul_mem ht hh) c,
              coeffSum_single_of_mem k G H ht c]
        · rw [coeffSum_single_of_notMem k G H
                (fun hc => ht ((Subgroup.mul_mem_cancel_right H hh).mp hc)) c,
              coeffSum_single_of_notMem k G H ht c]
  have := key a.coeff
  rwa [MonoidAlgebra.ofCoeff_coeff] at this

/-- `l_H` vanishes on `a * (h - 1)` for `h` in `H`. -/
lemma coeffSum_mul_single_sub_one {H : Subgroup G} {h : G} (hh : h ∈ H)
    (a : MonoidAlgebra k G) :
    coeffSum k G H (a * (MonoidAlgebra.single h 1 - 1)) = 0 := by
  rw [mul_sub, mul_one, map_sub, coeffSum_mul_single_mem k G hh, sub_self]

lemma augmentation_eq_sum_coeff (f : MonoidAlgebra k G) :
    augmentation k G f = f.coeff.sum (fun _ c => c) := by
  simp [augmentation, MonoidAlgebra.lift_apply]

/-- The augmentation ideal is contained in the kernel of the augmentation. -/
lemma augIdeal_le_ker_augmentation : augIdeal k G ≤ RingHom.ker (augmentation k G) := by
  rw [augIdeal_eq_span]
  apply Ideal.span_le.mpr
  rintro x ⟨g, rfl⟩
  change augmentation k G (MonoidAlgebra.single g 1 - 1) = 0
  rw [map_sub, augmentation_single, augmentation_one, sub_self]

/-- The sum of the coefficients of an element of the augmentation ideal is `0`. -/
lemma coeff_sum_eq_zero_of_mem_augIdeal {f : MonoidAlgebra k G} (hf : f ∈ augIdeal k G) :
    ∑ t ∈ f.coeff.support, f.coeff t = 0 := by
  have h1 := augIdeal_le_ker_augmentation k G hf
  rw [RingHom.mem_ker] at h1
  rw [augmentation_eq_sum_coeff] at h1
  exact h1

/-- Every element of `k[G]` is the sum of its monomials. -/
lemma eq_sum_smul_single (f : MonoidAlgebra k G) :
    f = ∑ t ∈ f.coeff.support, f.coeff t • MonoidAlgebra.single t 1 := by
  have h1 : f = Finsupp.sum f.coeff (fun t c => MonoidAlgebra.single t c) := by
    conv_lhs => rw [← MonoidAlgebra.ofCoeff_coeff f, ← Finsupp.sum_single (f.coeff)]
    rw [MonoidAlgebra.ofCoeff_finsuppSum]
    simp only [MonoidAlgebra.ofCoeff_single]
  conv_lhs => rw [h1]
  apply Finset.sum_congr rfl
  intro t _
  rw [smul_single, smul_eq_mul, mul_one]

/-- An element of the augmentation ideal is the sum of the elements `f t • (t - 1)`, `t` ranging
over the support of `f`. -/
lemma eq_sum_smul_single_sub_one_of_mem_augIdeal {f : MonoidAlgebra k G}
    (hf : f ∈ augIdeal k G) :
    f = ∑ t ∈ f.coeff.support, f.coeff t • (MonoidAlgebra.single t 1 - 1) := by
  conv_lhs => rw [eq_sum_smul_single k G f]
  have hsub : (∑ t ∈ f.coeff.support, f.coeff t • (MonoidAlgebra.single t 1 - 1))
      = (∑ t ∈ f.coeff.support, f.coeff t • MonoidAlgebra.single t 1)
        - (∑ t ∈ f.coeff.support, f.coeff t • (1 : MonoidAlgebra k G)) := by
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun t _ => smul_sub _ _ _
  have heps := coeff_sum_eq_zero_of_mem_augIdeal k G hf
  rw [hsub, ← Finset.sum_smul, heps, zero_smul, sub_zero]

/-- The `k[G]`-submodule of those `x` such that every left multiple of `x` is killed by `l_H`. -/
noncomputable def annSubmodule (H : Subgroup G) :
    Submodule (MonoidAlgebra k G) (MonoidAlgebra k G) where
  carrier := {x | ∀ a : MonoidAlgebra k G, coeffSum k G H (a * x) = 0}
  zero_mem' := by intro a; rw [mul_zero, map_zero]
  add_mem' := by intro x y hx hy a; rw [mul_add, map_add, hx a, hy a, add_zero]
  smul_mem' := by intro c x hx a; rw [smul_eq_mul, ← mul_assoc]; exact hx (a * c)

end Aux

theorem group_fg_of_augIdeal_fg (k : Type*) [CommRing k] [Nontrivial k] (G : Type*) [Group G]
    (h : (augIdeal k G).FG) : Group.FG G := by
  classical
  obtain ⟨S, hSfin, hSspan⟩ := Submodule.fg_def.mp h
  set T : Set G := ⋃ f ∈ S, (f.coeff.support : Set G) with hT
  have hTfin : T.Finite := by
    rw [hT]
    exact hSfin.biUnion fun f _ => f.coeff.support.finite_toSet
  set H : Subgroup G := Subgroup.closure T with hH
  have hmem : ∀ f ∈ S, ∀ t ∈ f.coeff.support, t ∈ H := by
    intro f hf t ht
    rw [hH]
    exact Subgroup.subset_closure (by rw [hT]; exact Set.mem_biUnion hf ht)
  have hS_sub : (S : Set (MonoidAlgebra k G)) ⊆ annSubmodule k G H := by
    intro f hf a
    have hfaug : f ∈ augIdeal k G := hSspan ▸ Submodule.subset_span hf
    have hdecomp := eq_sum_smul_single_sub_one_of_mem_augIdeal k G hfaug
    rw [hdecomp, Finset.mul_sum, map_sum]
    apply Finset.sum_eq_zero
    intro t ht
    rw [mul_smul_comm, map_smul]
    have hz : coeffSum k G H (a * (MonoidAlgebra.single t 1 - 1)) = 0 :=
      coeffSum_mul_single_sub_one k G (hmem f hf t ht) a
    rw [hz, smul_zero]
  have hmain : ∀ g : G, g ∈ H := by
    intro g
    have hspan_le : Submodule.span (MonoidAlgebra k G) (S : Set _) ≤ annSubmodule k G H :=
      Submodule.span_le.mpr hS_sub
    have hmem2 : MonoidAlgebra.single g 1 - 1 ∈ annSubmodule k G H := by
      apply hspan_le
      rw [hSspan]
      exact single_sub_one_mem_augIdeal k G g
    by_contra hg
    have hz := hmem2 1
    rw [one_mul, map_sub, coeffSum_single_of_notMem k G H hg 1, coeffSum_one, zero_sub] at hz
    exact one_ne_zero (neg_eq_zero.mp hz)
  refine Group.fg_iff.mpr ⟨T, ?_, hTfin⟩
  rw [← hH]
  exact eq_top_iff.mpr fun g _ => hmain g

end Work.ORFP2
