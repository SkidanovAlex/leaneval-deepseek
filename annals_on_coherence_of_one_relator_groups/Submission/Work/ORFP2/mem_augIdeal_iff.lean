/-
# The augmentation ideal is the kernel of the augmentation

`Work.ORFP2.augIdeal` is *defined* as the ideal generated by the elements `single g 1 - 1`; this
file identifies it with the kernel of the augmentation map `k[G] →+* k`, the definition used in the
paper (JL §1).
-/
import Submission.Work.ORFP2.Basic

set_option autoImplicit false

namespace Work.ORFP2

open MonoidAlgebra

variable {k : Type*} [CommRing k] {G : Type*} [Group G]

/-- The augmentation ideal is the kernel of the augmentation. -/
theorem mem_augIdeal_iff (x : MonoidAlgebra k G) : x ∈ augIdeal k G ↔ augmentation k G x = 0 := by
  constructor
  · intro hx
    have hle : augIdeal k G ≤ RingHom.ker (augmentation k G) := by
      rw [augIdeal_eq_span, Ideal.span_le]
      rintro y ⟨g, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, augmentation_single, augmentation_one,
        sub_self]
    exact hle hx
  · intro hx
    have key : ∀ y : MonoidAlgebra k G,
        y - MonoidAlgebra.single (1 : G) (augmentation k G y) ∈ augIdeal k G := by
      intro y
      induction y using MonoidAlgebra.induction_linear with
      | zero => simp
      | add p q hp hq =>
          have hs : MonoidAlgebra.single (1 : G)
                ((augmentation k G) p + (augmentation k G) q)
              = MonoidAlgebra.single (1 : G) (augmentation k G p)
                + MonoidAlgebra.single (1 : G) (augmentation k G q) := by
            simp
          rw [map_add, hs]
          rw [show p + q - (MonoidAlgebra.single (1 : G) (augmentation k G p)
                + MonoidAlgebra.single (1 : G) (augmentation k G q))
              = (p - MonoidAlgebra.single (1 : G) (augmentation k G p))
                + (q - MonoidAlgebra.single (1 : G) (augmentation k G q)) from by abel]
          exact Ideal.add_mem _ hp hq
      | single g c =>
          have h1 : MonoidAlgebra.single g c - MonoidAlgebra.single (1 : G) c
              = MonoidAlgebra.single (1 : G) c * (MonoidAlgebra.single g (1 : k) - 1) := by
            rw [mul_sub, mul_one, MonoidAlgebra.single_mul_single, one_mul, mul_one]
          rw [augmentation_single, h1]
          exact Ideal.mul_mem_left _ _ (single_sub_one_mem_augIdeal k G g)
    simpa [hx] using key x

end Work.ORFP2
