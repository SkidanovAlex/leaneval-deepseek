import Mathlib
import Submission.Work.ORFP2.Basic

namespace Work.ORFP2

open MonoidAlgebra

/-- For a surjective group homomorphism `φ : F →* G`, the kernel of the induced algebra map
`k[F] → k[G]` (summing coefficients along the fibres of `φ`) is the left ideal of `k[F]`
generated by the elements `m - 1` with `m ∈ ker φ`.

The proof picks a set-theoretic section `s` of `φ`.  Every `g : F` can then be written as
`g = s (φ g) · a` with `a = (s (φ g))⁻¹ * g ∈ ker φ`, so `g - s (φ g) ∈ I` where `I` is the left
ideal generated by the kernel elements; multiplying by the coefficients of `x` and summing gives
`x - σ x ∈ I` for `σ x = ∑_g c_g s (φ g)`.  If moreover `mapDomain φ x = 0` then the
coefficients of `mapDomain φ x.coeff` group the `c_g` by fibres of `φ`, whence `σ x = 0` and
`x ∈ I`. -/
theorem mapDomainAlgHom_eq_zero_iff_mem_span (k : Type*) [CommRing k] {F : Type*} [Group F]
    {G : Type*} [Group G] (φ : F →* G) (hφ : Function.Surjective φ) (x : MonoidAlgebra k F) :
    MonoidAlgebra.mapDomainAlgHom k k φ x = 0 ↔
      x ∈ Submodule.span (MonoidAlgebra k F)
        (Set.range fun m : MonoidHom.ker φ => MonoidAlgebra.single (m : F) (1 : k) - 1) := by
  let I : Submodule (MonoidAlgebra k F) (MonoidAlgebra k F) :=
    Submodule.span (MonoidAlgebra k F)
      (Set.range fun m : MonoidHom.ker φ => MonoidAlgebra.single (m : F) (1 : k) - 1)
  -- Every element of `I` is killed by `mapDomain φ`, since the generators are.
  have hI_le : ∀ y ∈ I, MonoidAlgebra.mapDomainAlgHom k k φ y = 0 := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
        rcases hz with ⟨m, rfl⟩
        have hm : φ (m : F) = 1 := MonoidHom.mem_ker.mp m.2
        rw [map_sub, map_one, MonoidAlgebra.mapDomainAlgHom_apply, MonoidAlgebra.mapDomain_single,
          hm, ← MonoidAlgebra.one_def, sub_self]
    | zero => exact map_zero _
    | add a b ha hb iha ihb => rw [map_add, iha, ihb, add_zero]
    | smul a z hz ih => rw [smul_eq_mul, map_mul, ih, mul_zero]
  -- `I` is in particular stable under the scalars `k ⊆ k[F]`.
  have hmem : ∀ (c : k) (y : MonoidAlgebra k F), y ∈ I → c • y ∈ I := by
    intro c y hy
    have := Submodule.smul_mem (I.restrictScalars k) c (show y ∈ I.restrictScalars k from hy)
    simpa using this
  refine ⟨fun hx => ?_, fun hx => hI_le x hx⟩
  -- Extract the vanishing of the coefficients grouped along the fibres of `φ`.
  have hcoeff : Finsupp.mapDomain (⇑φ) x.coeff = 0 := by
    have h := congrArg MonoidAlgebra.coeff hx
    simp only [MonoidAlgebra.mapDomainAlgHom_apply, MonoidAlgebra.mapDomain,
      MonoidAlgebra.coeff_ofCoeff, MonoidAlgebra.coeff_zero] at h
    exact h
  -- The section `s` of `φ` and the key relation `single g 1 ≡ single (s (φ g)) 1` modulo `I`.
  have hkey : ∀ g : F, MonoidAlgebra.single g (1 : k)
      - MonoidAlgebra.single (Function.surjInv hφ (φ g)) (1 : k) ∈ I := by
    intro g
    have ha : (Function.surjInv hφ (φ g))⁻¹ * g ∈ MonoidHom.ker φ := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, Function.surjInv_eq hφ (φ g), inv_mul_cancel]
    have hgen : MonoidAlgebra.single ((Function.surjInv hφ (φ g))⁻¹ * g) (1 : k) - 1 ∈ I :=
      Submodule.subset_span ⟨⟨_, ha⟩, rfl⟩
    have hmul :=
      Submodule.smul_mem I (MonoidAlgebra.single (Function.surjInv hφ (φ g)) (1 : k)) hgen
    rw [smul_eq_mul, mul_sub, MonoidAlgebra.single_mul_single] at hmul
    simpa [mul_inv_cancel_left] using hmul
  have hsum : x.coeff.sum (fun g c => c • (MonoidAlgebra.single g (1 : k)
      - MonoidAlgebra.single (Function.surjInv hφ (φ g)) (1 : k))) ∈ I := by
    rw [Finsupp.sum]
    exact Submodule.sum_mem I (fun g _ => hmem (x.coeff g) _ (hkey g))
  have h1 : x.coeff.sum (fun g c => c • MonoidAlgebra.single g (1 : k)) = x := by
    rw [Finsupp.sum_congr (f := x.coeff) (g1 := fun g c => c • MonoidAlgebra.single g (1 : k))
      (g2 := fun g c => MonoidAlgebra.single g c)
      (fun a _ => by rw [MonoidAlgebra.smul_single]; simp)]
    exact MonoidAlgebra.sum_coeff_single x
  have h2 : x.coeff.sum (fun g c => c • MonoidAlgebra.single (Function.surjInv hφ (φ g)) (1 : k))
      = (Finsupp.mapDomain (⇑φ) x.coeff).sum
          (fun h d => d • MonoidAlgebra.single (Function.surjInv hφ h) (1 : k)) :=
    (Finsupp.sum_mapDomain_index (f := ⇑φ) (s := x.coeff)
      (h := fun h d => d • MonoidAlgebra.single (Function.surjInv hφ h) (1 : k))
      (fun b => by simp) (fun _ m1 m2 => by rw [add_smul])).symm
  have h3 : x.coeff.sum (fun g c => c • (MonoidAlgebra.single g (1 : k)
        - MonoidAlgebra.single (Function.surjInv hφ (φ g)) (1 : k)))
      = x.coeff.sum (fun g c => c • MonoidAlgebra.single g (1 : k))
        - x.coeff.sum (fun g c =>
            c • MonoidAlgebra.single (Function.surjInv hφ (φ g)) (1 : k)) := by
    rw [Finsupp.sum, Finsupp.sum, Finsupp.sum]
    rw [Finset.sum_congr rfl (fun g _ => by rw [smul_sub])]
    rw [Finset.sum_sub_distrib]
  have hxI : x - (Finsupp.mapDomain (⇑φ) x.coeff).sum
      (fun h d => d • MonoidAlgebra.single (Function.surjInv hφ h) (1 : k)) ∈ I := by
    rw [h3, h1, h2] at hsum
    exact hsum
  rw [hcoeff, Finsupp.sum_zero_index, sub_zero] at hxI
  exact hxI

end Work.ORFP2
