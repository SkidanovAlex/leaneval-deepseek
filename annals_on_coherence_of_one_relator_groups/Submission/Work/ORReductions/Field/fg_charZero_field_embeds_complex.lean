import Mathlib
import Submission.Work.ORReductions.Basic

namespace Work.ORReductions.Field

open scoped IntermediateField.algebraAdjoinAdjoin

/-- Every subfield of a field of characteristic zero contains the image of `ℚ`. -/
theorem ratCast_mem_closure {K : Type*} [Field K] [CharZero K] (S : Set K) (q : ℚ) :
    algebraMap ℚ K q ∈ Subfield.closure S := by
  rw [Subfield.mem_closure]
  intro T _
  have h : algebraMap ℚ K = T.subtype.comp (algebraMap ℚ ↥T) := Subsingleton.elim _ _
  rw [h]
  exact (algebraMap ℚ ↥T q).2

/-- `ℂ` contains `n` algebraically independent elements over `ℚ`. -/
theorem complex_exists_algebraicIndependent (n : ℕ) :
    ∃ y : Fin n → ℂ, AlgebraicIndependent ℚ y := by
  induction n with
  | zero => exact ⟨Fin.elim0, algebraicIndependent_empty_type⟩
  | succ n ih =>
    obtain ⟨y, hy⟩ := ih
    haveI : Countable (MvPolynomial (Fin n) ℚ) := by
      rw [← Cardinal.mk_le_aleph0_iff]
      refine (MvPolynomial.cardinalMk_le_max_lift (σ := Fin n) (R := ℚ)).trans ?_
      simp
    haveI hFc : Countable ↥(Algebra.adjoin ℚ (Set.range y)) := by
      rw [Algebra.adjoin_range_eq_range_aeval]
      exact (Set.countable_range (MvPolynomial.aeval y)).to_subtype
    obtain ⟨z, hz⟩ : ∃ z : ℂ, ¬ IsAlgebraic ↥(Algebra.adjoin ℚ (Set.range y)) z := by
      by_contra h
      simp only [not_exists, not_not] at h
      exact not_countable_complex
        ((Algebraic.countable ↥(Algebra.adjoin ℚ (Set.range y)) ℂ).mono (fun z _ => h z))
    let f : Fin (n + 1) → Option (Fin n) :=
      fun i => if h : (i : ℕ) < n then some ⟨i, h⟩ else none
    let g : Option (Fin n) → Fin (n + 1) := fun o => o.elim (Fin.last n) Fin.castSucc
    have hgf : Function.LeftInverse g f := by
      intro i
      simp only [f, g]
      split_ifs with hi
      · exact Fin.ext (by simp)
      · have hlast : i = Fin.last n := by
          apply Fin.ext
          simp only [Fin.val_last]
          have := i.isLt
          omega
        rw [hlast]
        rfl
    have hf : Function.Injective f := hgf.injective
    exact ⟨(fun o : Option (Fin n) => o.elim z y) ∘ f,
      ((AlgebraicIndependent.option_iff (R := ℚ) (x := y) (a := z)).mpr ⟨hy, hz⟩).comp f hf⟩

/-- The subfield generated over `ℚ` by an algebraically independent family embeds into `ℂ`. -/
theorem adjoin_embeds_complex {ι : Type*} {L : Type*} [Field L] [Algebra ℚ L]
    (x : ι → L) (hx : AlgebraicIndependent ℚ x)
    (y : ι → ℂ) (hy : AlgebraicIndependent ℚ y) :
    Nonempty (↥(IntermediateField.adjoin ℚ (Set.range x)) →+* ℂ) := by
  have hys : Function.Injective (MvPolynomial.aeval y : MvPolynomial ι ℚ →ₐ[ℚ] ℂ) :=
    algebraicIndependent_iff_injective_aeval.mp hy
  let g : ↥(Algebra.adjoin ℚ (Set.range x)) →ₐ[ℚ] ℂ :=
    (MvPolynomial.aeval y).comp hx.aevalEquiv.symm.toAlgHom
  have hg : Function.Injective g := hys.comp hx.aevalEquiv.symm.injective
  exact ⟨IsFractionRing.lift (g := g.toRingHom) hg⟩

/-- An algebraic extension of a subfield `F ≤ L` embeds into `ℂ` whenever `F` does. -/
theorem subfield_algebraic_embeds_complex {L : Type*} [Field L] (F : Subfield L)
    (h : Algebra.IsAlgebraic ↥F L) (f : ↥F →+* ℂ) : Nonempty (L →+* ℂ) := by
  haveI : Algebra.IsAlgebraic ↥F L := h
  letI : Algebra ↥F ℂ := f.toAlgebra
  haveI : Module.IsTorsionFree ↥F ℂ := inferInstance
  exact ⟨(IsAlgClosed.lift (R := ↥F) (S := L) (M := ℂ) : L →ₐ[↥F] ℂ).toRingHom⟩

/-- A field extension of `ℚ` that is finitely generated as a field embeds into `ℂ`. -/
theorem fg_field_extension_embeds_complex (L : Type*) [Field L] [Algebra ℚ L]
    [Algebra.EssFiniteType ℚ L] : Nonempty (L →+* ℂ) := by
  haveI : FinTrdeg ℚ L := inferInstance
  obtain ⟨s, hs⟩ := exists_finset_isTranscendenceBasis ℚ L
  have halg :
      Algebra.IsAlgebraic
        ↥(IntermediateField.adjoin ℚ (Set.range (Subtype.val : s → L))) L :=
    hs.isAlgebraic_field
  obtain ⟨y', hy'⟩ := complex_exists_algebraicIndependent s.card
  let e : s ≃ Fin s.card := Finset.equivFin s
  let y : s → ℂ := y' ∘ e
  have hy : AlgebraicIndependent ℚ y := hy'.comp e e.injective
  obtain ⟨f⟩ := adjoin_embeds_complex (Subtype.val : s → L) hs.1 y hy
  exact subfield_algebraic_embeds_complex
    (IntermediateField.adjoin ℚ (Set.range (Subtype.val : s → L))).toSubfield halg f

/-- The subfield generated by a finite set in a field of characteristic zero is finitely
generated as a field extension of `ℚ`. -/
theorem essFiniteType_closure (K : Type*) [Field K] [CharZero K] (S : Finset K) :
    Algebra.EssFiniteType ℚ ↥(Subfield.closure (S : Set K)) := by
  have hEq : Subfield.closure (S : Set K) =
      (IntermediateField.adjoin ℚ (S : Set K)).toSubfield := by
    apply le_antisymm
    · rw [Subfield.closure_le]
      exact IntermediateField.subset_adjoin ℚ (S : Set K)
    · refine IntermediateField.adjoin_le_subfield (F := ℚ) (S := (S : Set K)) ?_
        Subfield.subset_closure
      intro x hx
      obtain ⟨q, rfl⟩ := hx
      exact ratCast_mem_closure (S : Set K) q
  rw [hEq]
  exact IntermediateField.essFiniteType_iff.mpr
    (IntermediateField.fg_adjoin_of_finite S.finite_toSet)

theorem fg_charZero_field_embeds_complex (K : Type*) [Field K] [CharZero K] (S : Finset K) :
    Nonempty ((Subfield.closure (S : Set K)) →+* ℂ) := by
  haveI : Algebra.EssFiniteType ℚ ↥(Subfield.closure (S : Set K)) := essFiniteType_closure K S
  exact fg_field_extension_embeds_complex ↥(Subfield.closure (S : Set K))

end Work.ORReductions.Field
