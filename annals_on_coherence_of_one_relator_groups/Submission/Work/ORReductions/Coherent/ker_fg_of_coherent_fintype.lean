import Mathlib
import Submission.Work.ORReductions.Coherent.submodule_fg_ker_of_coherent
import Submission.Work.ORReductions.Basic

/-!
# Kernels of maps into a finite power of a coherent ring

Over a coherent ring `R` (in the sense of `Ring.Coherent`), the kernel of an `R`-linear map
`φ : M ⟶ R^ι` out of a finitely generated module `M` into a *finite* power of `R` is finitely
generated.

The proof is a direct reduction to the finite free case
(`Work.ORReductions.Coherent.submodule_fg_ker_of_coherent`):

* pick a finite free cover `π : R^n ↠ M` of the finitely generated module `M`;
* transport the finite power `R^ι` along the linear equivalence `R^ι ≃ R^{card ι}` and form
  `g = e ∘ (φ ∘ π) : R^n ⟶ R^{card ι}`, whose kernel is finitely generated by coherence;
* `ker g = comap π (ker φ)`, so `map π (ker g) = range π ⊓ ker φ = ker φ`, and images of
  finitely generated submodules are finitely generated.
-/

namespace Work.ORReductions.Coherent

open OnCoherenceOfOneRelatorGroups

theorem ker_fg_of_coherent_fintype (R : Type*) [Ring R] (hR : Ring.Coherent R)
    {ι : Type*} [Fintype ι] {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (φ : M →ₗ[R] (ι → R)) : (LinearMap.ker φ).FG := by
  -- a finite free cover `π : R^n ↠ M` of the finitely generated module `M`
  obtain ⟨n, π, hπ⟩ :=
    (Submodule.fg_iff_exists_fin_linearMap R M).mp (Module.Finite.fg_top (R := R) (M := M))
  -- identify the finite power `R^ι` with the standard finite free module `R^{card ι}`
  let e : (ι → R) ≃ₗ[R] (Fin (Fintype.card ι) → R) :=
    LinearEquiv.piCongrLeft R (fun _ : Fin (Fintype.card ι) => R) (Fintype.equivFin ι)
  let g : (Fin n → R) →ₗ[R] (Fin (Fintype.card ι) → R) := e.toLinearMap ∘ₗ (φ ∘ₗ π)
  -- kernels of maps between finite free modules are finitely generated
  have hg : (LinearMap.ker g).FG := submodule_fg_ker_of_coherent hR g
  -- `ker g` is the preimage of `ker φ` under `π`
  have hker : LinearMap.ker g = Submodule.comap π (LinearMap.ker φ) := by
    ext x
    simp only [LinearMap.mem_ker, Submodule.mem_comap, g, LinearMap.comp_apply,
      LinearEquiv.coe_coe, LinearEquiv.map_eq_zero_iff]
  -- pushing forward along the surjection `π` recovers `ker φ`
  have hmap : Submodule.map π (LinearMap.ker g) = LinearMap.ker φ := by
    rw [hker, Submodule.map_comap_eq, hπ, top_inf_eq]
  rw [← hmap]
  exact Submodule.FG.map π hg

end Work.ORReductions.Coherent
