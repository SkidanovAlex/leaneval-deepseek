
import Mathlib
import Submission.Work.ORReductions.Basic
import Submission.Work.ORReductions.Coherent.SubfieldDefs
import Submission.Work.ORReductions.Coherent.ker_baseChange_le

/-!
# Coherence of `K[G]` from coherence of `L[G]` for all finitely generated subfields `L ≤ K`

If `K` is a field, `G` a group, and `K[G]` is coherent as soon as we replace `K` by the
subfield generated by any finite set of elements of `K`, then `K[G]` itself is coherent.

The proof is the "Lefschetz principle" argument of Jaikin-Zapirain--Linton: if `I ⊆ K[G]` is a
finitely generated ideal, the coefficients of a finite generating set generate a subfield
`L ≤ K` with `L` the closure of a finite set, and the chosen generators lift to `L[G]`.  Since
`K[G]` is free (hence flat) as a module over `L[G]` (with basis `single 1 (b j)` for `b` a
basis of `K` over `L`), finite presentability of the corresponding ideal of `L[G]` transfers to
`I` over `K[G]`: a presentation of the kernel over `L[G]` base changes to a presentation of the
kernel over `K[G]`.

## Main results

* `Work.ORReductions.Coherent.coherent_of_subfield` : the reduction.
* `Work.ORReductions.Coherent.exists_basis_single` : `K[G]` is free over `L[G]`, with the
  elements `single 1 (b j)` as a basis (these elements are central).
* `Work.ORReductions.Coherent.ker_baseChange_eq_span` : the kernel of a "base changed"
  presentation is the base change of the kernel.

-/

namespace Work.ORReductions.Coherent

/-- Applying a ring hom to a `Finsupp.linearCombination` of a `Finsupp.mapRange`. -/
theorem linearCombination_mapRange {A B : Type*} [Semiring A] [Semiring B] (φ : A →+* B)
    {ι : Type*} (y : ι → A) (c : ι →₀ A) :
    Finsupp.linearCombination B (fun i => φ (y i))
        (Finsupp.mapRange (φ : A → B) (map_zero φ) c) =
      φ (Finsupp.linearCombination A y c) := by
  induction c using Finsupp.induction with
  | zero => simp
  | single_add a b c _ _ ih =>
    rw [Finsupp.mapRange_add (map_add φ), Finsupp.mapRange_single,
      map_add (Finsupp.linearCombination B (fun i => φ (y i))),
      map_add (Finsupp.linearCombination A y),
      Finsupp.linearCombination_single, Finsupp.linearCombination_single, ih, map_add φ]
    exact congrArg (fun z => z + φ ((Finsupp.linearCombination A y) c))
      (map_mul φ b (y a)).symm

/-- The easy half of `ker_baseChange_eq_span`: the "base changed" relation module is contained
in the kernel of the "base changed" presentation. -/
theorem ker_baseChange_ge {R S : Type*} [Ring R] [Ring S] (f : R →+* S)
    {n m : ℕ} (v : Fin n → R) (w : Fin m → (Fin n →₀ R))
    (hw : Submodule.span R (Set.range w) = LinearMap.ker (Finsupp.linearCombination R v)) :
    Submodule.span S (Set.range (fun k => Finsupp.mapRange f (map_zero f) (w k))) ≤
      LinearMap.ker (Finsupp.linearCombination S (fun i => f (v i))) := by
  rw [Submodule.span_le]
  rintro _ ⟨k, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, linearCombination_mapRange f v (w k)]
  have h : Finsupp.linearCombination R v (w k) = 0 := by
    have h2 : w k ∈ Submodule.span R (Set.range w) := Submodule.subset_span (Set.mem_range_self k)
    rwa [hw] at h2
  rw [h, map_zero]

/-- `subfieldAlgHom` on a monomial. -/
lemma subfieldAlgHom_single (K : Type*) [Field K] (L : Subfield K) (G : Type*) [Group G]
    (g : G) (c : ↥L) : subfieldAlgHom K L G (MonoidAlgebra.single g c) =
      MonoidAlgebra.single g (algebraMap ↥L K c) :=
  MonoidAlgebra.mapRingHom_single _ _ _

/-- `K[G]` is free as a module over `L[G]`, with a basis indexed by a basis `b` of `K` over
`L`; the basis elements `single 1 (b j)` are central in `K[G]`. -/
theorem exists_basis_single (K : Type*) [Field K] (L : Subfield K) (G : Type*) [Group G]
    {ι : Type*} (b : Module.Basis ι ↥L K) :
    ∃ bS : Module.Basis ι (MonoidAlgebra (↥L) G) (MonoidAlgebra K G),
      (∀ j, bS j = basisElem K L G b j) ∧
      (∀ (j : ι) (r : MonoidAlgebra (↥L) G),
        bS j * subfieldAlgHom K L G r = subfieldAlgHom K L G r * bS j) := by
  classical
  have hspan1 : ∀ k : K, MonoidAlgebra.single (1 : G) k ∈
      Submodule.span (MonoidAlgebra (↥L) G) (Set.range (basisElem K L G b)) := by
    intro k
    have hk : k ∈ Submodule.span ↥L (Set.range b) := by
      rw [Module.Basis.span_eq]; exact Submodule.mem_top
    refine Submodule.span_induction (p := fun x _ => MonoidAlgebra.single (1 : G) x ∈
        Submodule.span (MonoidAlgebra (↥L) G) (Set.range (basisElem K L G b))) ?_ ?_ ?_ ?_ hk
    · rintro x ⟨j, rfl⟩
      exact Submodule.subset_span ⟨j, rfl⟩
    · rw [MonoidAlgebra.single_zero]
      exact Submodule.zero_mem _
    · intro x y _ _ hx hy
      rw [MonoidAlgebra.single_add]
      exact Submodule.add_mem _ hx hy
    · intro c x _ hx
      have hsm : MonoidAlgebra.single (1 : G) (c • x) =
          (MonoidAlgebra.single (1 : G) c) •
            (MonoidAlgebra.single (1 : G) x) := by
        rw [subfieldAlgHom_smul, subfieldAlgHom_single, Algebra.smul_def,
          MonoidAlgebra.single_mul_single]
        simp
      rw [hsm]
      exact Submodule.smul_mem _ _ hx
  have hsp : ⊤ ≤ Submodule.span (MonoidAlgebra (↥L) G) (Set.range (basisElem K L G b)) := by
    intro x _
    rw [← MonoidAlgebra.sum_coeff_single x]
    show (∑ g ∈ x.coeff.support, MonoidAlgebra.single g (x.coeff g)) ∈
      Submodule.span (MonoidAlgebra (↥L) G) (Set.range (basisElem K L G b))
    refine Submodule.sum_mem _ ?_
    intro g _
    have hsingle : MonoidAlgebra.single g (x.coeff g) =
        (MonoidAlgebra.single g (1 : ↥L)) • (MonoidAlgebra.single (1 : G) (x.coeff g)) := by
      rw [subfieldAlgHom_smul, subfieldAlgHom_single, MonoidAlgebra.single_mul_single]
      simp
    rw [hsingle]
    exact Submodule.smul_mem _ _ (hspan1 (x.coeff g))
  have hli : LinearIndependent (MonoidAlgebra (↥L) G) (basisElem K L G b) := by
    have key2 : ∀ (y : ι →₀ MonoidAlgebra (↥L) G),
        Finsupp.linearCombination (MonoidAlgebra (↥L) G) (basisElem K L G b) y = 0 →
        ∀ (l : ι) (g : G), ((y l).coeff) g = 0 := by
      intro y hy0 l g
      have hB : ∀ j : ι, basisElem K L G b j = MonoidAlgebra.single (1 : G) (b j) := fun j => rfl
      have hA : ∀ r : MonoidAlgebra (↥L) G,
          subfieldAlgHom K L G r = MonoidAlgebra.mapRingHom G (algebraMap ↥L K) r := fun r => rfl
      have hmap0 : (fun r : MonoidAlgebra (↥L) G => r.coeff g) 0 = 0 := by
        show ((0 : MonoidAlgebra (↥L) G).coeff) g = 0
        rw [MonoidAlgebra.coeff_zero, Finsupp.zero_apply]
      have h1 : (Finsupp.linearCombination (MonoidAlgebra (↥L) G) (basisElem K L G b) y).coeff g =
          y.sum (fun j r => (r • basisElem K L G b j).coeff g) := by
        rw [Finsupp.linearCombination_apply, MonoidAlgebra.coeff_finsuppSum, Finsupp.sum_apply]
      have h2 : ∀ (j : ι) (r : MonoidAlgebra (↥L) G),
          (r • basisElem K L G b j).coeff g = (r.coeff g) • b j := by
        intro j r
        rw [subfieldAlgHom_smul, hA r, hB j, MonoidAlgebra.coeff_mul_single_one,
          MonoidAlgebra.coeff_mapRingHom, Algebra.smul_def]
      have h3 : y.sum (fun j r => (r.coeff g) • b j) =
          (Finsupp.linearCombination (MonoidAlgebra (↥L) G) (basisElem K L G b) y).coeff g := by
        rw [h1]
        show (y.support.sum fun j => ((y j).coeff g) • b j) =
          y.support.sum fun j => ((y j) • basisElem K L G b j).coeff g
        exact Finset.sum_congr rfl (fun j _ => (h2 j (y j)).symm)
      have h5 : Finsupp.linearCombination ↥L b
          (y.mapRange (fun r => r.coeff g) hmap0) =
          y.sum (fun j r => (r.coeff g) • b j) := by
        rw [Finsupp.linearCombination_apply]
        exact Finsupp.sum_mapRange_index (f := fun r : MonoidAlgebra (↥L) G => r.coeff g)
          (hf := hmap0) (g := y) (h := fun j d => d • b j) (fun a => by simp)
      have hc : Finsupp.linearCombination ↥L b (y.mapRange (fun r => r.coeff g) hmap0) = 0 := by
        rw [h5, h3, hy0, MonoidAlgebra.coeff_zero, Finsupp.zero_apply]
      have hc0 : y.mapRange (fun r => r.coeff g) hmap0 = 0 :=
        b.linearIndependent (hc.trans (map_zero _).symm)
      have h4 : (y.mapRange (fun r => r.coeff g) hmap0) l = (y l).coeff g :=
        Finsupp.mapRange_apply
      rw [← h4, hc0, Finsupp.zero_apply]
    have key : ∀ y : ι →₀ MonoidAlgebra (↥L) G,
        Finsupp.linearCombination (MonoidAlgebra (↥L) G) (basisElem K L G b) y = 0 → y = 0 := by
      intro y hy0
      refine Finsupp.ext (fun l => ?_)
      refine MonoidAlgebra.coeff_injective (Finsupp.ext (fun g => ?_))
      simpa using key2 y hy0 l g
    intro y₁ y₂ hy
    have h : y₁ - y₂ = 0 := key _ (by exact (map_sub (Finsupp.linearCombination _ (basisElem K L G b)) y₁ y₂).trans (by rw [hy, sub_self]))
    exact sub_eq_zero.mp h
  refine ⟨Module.Basis.mk hli hsp, ?_, ?_⟩
  · intro j
    rw [Module.Basis.mk_apply]
  · intro j r
    rw [Module.Basis.mk_apply]
    exact (MonoidAlgebra.single_commute (fun m' => Commute.one_left m')
      (fun r' => Commute.all (b j) r') (subfieldAlgHom K L G r)).eq

/-- The kernel of a "base changed" presentation is the base change of the kernel: if `R →+* S`
is a ring hom making `S` a free `R`-module with a central basis, and `v : Fin n → R` is a
family whose relation module is spanned by `w : Fin m → (Fin n →₀ R)`, then the same is true
after applying `f` to everything. -/
theorem ker_baseChange_eq_span {R S : Type*} [Ring R] [Ring S] (f : R →+* S) [Module R S]
    (hsmul : ∀ (r : R) (s : S), r • s = f r * s)
    {ι : Type*} (bS : Module.Basis ι R S)
    (hc : ∀ (j : ι) (r : R), bS j * f r = f r * bS j)
    {n m : ℕ} (v : Fin n → R) (w : Fin m → (Fin n →₀ R))
    (hw : Submodule.span R (Set.range w) = LinearMap.ker (Finsupp.linearCombination R v)) :
    LinearMap.ker (Finsupp.linearCombination S (fun i => f (v i))) =
      Submodule.span S (Set.range (fun k => Finsupp.mapRange f (map_zero f) (w k))) :=
  le_antisymm (ker_baseChange_le f hsmul bS hc v w hw) (ker_baseChange_ge f v w hw)

theorem coherent_of_subfield (G : Type*) [Group G] (K : Type*) [Field K]
    (h : ∀ (S : Finset K), Ring.Coherent (MonoidAlgebra (Subfield.closure (S : Set K)) G)) :
    Ring.Coherent (MonoidAlgebra K G) := by
  intro I hI
  classical
  obtain ⟨n, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  set S₀ : Finset K := Finset.univ.biUnion
    (fun i : Fin n => (s i).coeff.support.image (fun g => (s i).coeff g)) with hS₀
  let L : Subfield K := Subfield.closure (S₀ : Set K)
  have hmem : ∀ i : Fin n, s i ∈ Set.range (subfieldAlgHom K L G) := by
    intro i
    refine ⟨MonoidAlgebra.ofCoeff ((s i).coeff.mapRange (fun k : K =>
      if hk : k ∈ (S₀ : Set K) then (⟨k, Subfield.subset_closure hk⟩ : ↥L) else 0) ?_), ?_⟩
    · by_cases h0 : (0 : K) ∈ (S₀ : Set K)
      · rw [dif_pos h0]
        rfl
      · rw [dif_neg h0]
    · refine MonoidAlgebra.coeff_injective ?_
      ext g
      rw [subfieldAlgHom_apply, MonoidAlgebra.coeff_mapRingHom, Finsupp.mapRange_apply]
      by_cases hg : (s i).coeff g ∈ (S₀ : Set K)
      · rw [dif_pos hg]; rfl
      · have hgz : (s i).coeff g = 0 := by
          by_contra hne
          exact hg (by
            rw [hS₀]
            exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i,
              Finset.mem_image.mpr ⟨g, Finsupp.mem_support_iff.mpr hne, rfl⟩⟩)
        rw [dif_neg hg, hgz, map_zero]
  let v : Fin n → MonoidAlgebra (↥L) G := fun i => Classical.choose (hmem i)
  have hv : ∀ i, subfieldAlgHom K L G (v i) = s i := fun i => Classical.choose_spec (hmem i)
  let J : Ideal (MonoidAlgebra (↥L) G) := Ideal.span (Set.range v)
  have hJfg : J.FG := by
    apply Submodule.fg_span
    exact Set.finite_range v
  have hfpJ : Module.FinitePresentation (MonoidAlgebra (↥L) G) J := h S₀ J hJfg
  let fA : (Fin n →₀ MonoidAlgebra (↥L) G) →ₗ[MonoidAlgebra (↥L) G] MonoidAlgebra (↥L) G :=
    Finsupp.linearCombination (MonoidAlgebra (↥L) G) v
  have hrangeA : fA.range = (J : Submodule (MonoidAlgebra (↥L) G) (MonoidAlgebra (↥L) G)) := by
    rw [Finsupp.range_linearCombination]
  let lA : (Fin n →₀ MonoidAlgebra (↥L) G) →ₗ[MonoidAlgebra (↥L) G] J :=
    LinearMap.codRestrict J fA (fun c => by
      have : fA c ∈ fA.range := LinearMap.mem_range_self fA c
      rwa [hrangeA] at this)
  have hlA : Function.Surjective lA := by
    rw [← LinearMap.range_eq_top, LinearMap.range_codRestrict, hrangeA,
      Submodule.comap_subtype_self]
  have hkerA : (LinearMap.ker lA).FG := by
    haveI := hfpJ
    exact Module.FinitePresentation.fg_ker (M := Fin n →₀ MonoidAlgebra (↥L) G) (N := J) lA hlA
  obtain ⟨m, w, hw⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hkerA
  have hw' : Submodule.span (MonoidAlgebra (↥L) G) (Set.range w) =
      LinearMap.ker (Finsupp.linearCombination (MonoidAlgebra (↥L) G) v) := by
    rw [hw, LinearMap.ker_codRestrict]
  letI : Module.Free ↥L K := Module.Free.of_divisionRing ↥L K
  obtain ⟨bS, hbS, hcent⟩ := exists_basis_single K L G (Module.Free.chooseBasis ↥L K)
  have hcrux := ker_baseChange_eq_span (subfieldAlgHom K L G) (subfieldAlgHom_smul K L G)
    bS hcent v w hw'
  have hkerB : (LinearMap.ker (Finsupp.linearCombination (MonoidAlgebra K G)
      (fun i => subfieldAlgHom K L G (v i)))).FG := by
    rw [hcrux]
    exact Submodule.fg_span (Set.finite_range _)
  let lB : (Fin n →₀ MonoidAlgebra K G) →ₗ[MonoidAlgebra K G] I :=
    LinearMap.codRestrict I (Finsupp.linearCombination (MonoidAlgebra K G)
      (fun i => subfieldAlgHom K L G (v i))) (fun c => by
        have h1 : Finsupp.linearCombination (MonoidAlgebra K G)
            (fun i => subfieldAlgHom K L G (v i)) c ∈
            Submodule.span (MonoidAlgebra K G)
              (Set.range (fun i => subfieldAlgHom K L G (v i))) := by
          rw [← Finsupp.range_linearCombination]
          exact LinearMap.mem_range_self _ c
        rw [show (fun i => subfieldAlgHom K L G (v i)) = s from funext hv] at h1 ⊢
        rwa [hs] at h1)
  have hlB : Function.Surjective lB := by
    rw [← LinearMap.range_eq_top, LinearMap.range_codRestrict, Finsupp.range_linearCombination,
      show (fun i => subfieldAlgHom K L G (v i)) = s from funext hv, hs,
      Submodule.comap_subtype_self]
  have hkerB2 : (LinearMap.ker lB).FG := by
    rw [LinearMap.ker_codRestrict]
    exact hkerB
  exact Module.finitePresentation_of_surjective lB hlB hkerB2

end Work.ORReductions.Coherent
