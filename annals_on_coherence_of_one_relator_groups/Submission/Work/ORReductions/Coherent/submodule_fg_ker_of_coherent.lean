import Mathlib
import Submission.Work.ORReductions.Basic

/-!
# Kernels of maps between finite free modules over a coherent ring

For a ring `R` which is coherent in the sense of `Ring.Coherent` (every finitely generated
left ideal is finitely presented), the kernel of an `R`-linear map `R^p ⟶ R^q` between
finite free modules is finitely generated.

The argument is the classical one:

* if `M` is finitely generated and `ψ : M ⟶ R`, then `im ψ` is a finitely generated ideal,
  hence finitely presented by coherence, so `ker ψ` is finitely generated
  (`Module.FinitePresentation.fg_ker`);
* consequently, for a finitely generated `K ≤ M` and `ψ : M ⟶ R`, also `ker ψ ⊓ K` is
  finitely generated (restrict `ψ` to `K` and push forward along `K ↪ M`);
* finally, writing `R^{q+1} ≃ R × R^q`, the kernel of `φ : M ⟶ R^{q+1}` is
  `ker ψ ⊓ ker θ` for the two components `ψ` and `θ` of `φ`, and `ker θ` is finitely
  generated by induction, so the second step applies.
-/

namespace Work.ORReductions.Coherent

open OnCoherenceOfOneRelatorGroups

/-- If `R` is coherent, `M` is a finitely generated `R`-module and `ψ : M →ₗ[R] R`, then
`ker ψ` is finitely generated: its image is a finitely generated ideal of `R`, hence finitely
presented. -/
lemma ker_fg_of_coherent_rank_one {R : Type*} [Ring R] (hR : Ring.Coherent R)
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (ψ : M →ₗ[R] R) : (LinearMap.ker ψ).FG := by
  have hrange : (LinearMap.range ψ).FG := Submodule.fg_range ψ
  have hfp : Module.FinitePresentation R (LinearMap.range ψ) := hR (LinearMap.range ψ) hrange
  have h := Module.FinitePresentation.fg_ker ψ.rangeRestrict (LinearMap.surjective_rangeRestrict ψ)
  rwa [LinearMap.ker_rangeRestrict] at h

/-- If `R` is coherent, `K ≤ M` is a finitely generated submodule and `ψ : M →ₗ[R] R`, then
`ker ψ ⊓ K` is finitely generated. -/
lemma fg_inf_ker_of_coherent {R : Type*} [Ring R] (hR : Ring.Coherent R)
    {M : Type*} [AddCommGroup M] [Module R M]
    (K : Submodule R M) (hK : K.FG) (ψ : M →ₗ[R] R) : (LinearMap.ker ψ ⊓ K).FG := by
  have hfin : Module.Finite R ↥K := Module.Finite.of_fg hK
  have h := ker_fg_of_coherent_rank_one hR (ψ.domRestrict K)
  have h' : (Submodule.map K.subtype (LinearMap.ker (ψ.domRestrict K))).FG :=
    Submodule.FG.map K.subtype h
  rwa [LinearMap.ker_domRestrict, Submodule.map_comap_subtype, inf_comm] at h'

/-- Over a coherent ring, the kernel of a linear map from a finitely generated module into a
finite free module is finitely generated. -/
lemma ker_fg_pi_of_coherent {R : Type*} [Ring R] (hR : Ring.Coherent R) :
    ∀ (q : ℕ) {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
      (φ : M →ₗ[R] (Fin q → R)), (LinearMap.ker φ).FG := by
  intro q
  induction q with
  | zero =>
    intro M _ _ _ φ
    have hsub : Subsingleton (Fin 0 → R) := ⟨fun f g => funext fun i => i.elim0⟩
    have h : LinearMap.ker φ = ⊤ := Submodule.eq_top_iff'.2 fun x => Subsingleton.elim _ _
    rw [h]
    exact Module.Finite.fg_top
  | succ q ih =>
    intro M _ _ _ φ
    -- decompose `R^{q+1} ≃ R × R^q`
    let e : (Fin (q + 1) → R) ≃ₗ[R] R × (Fin q → R) :=
      (LinearEquiv.piCongrLeft R (fun _ : Option (Fin q) => R) (finSuccEquiv q)) ≪≫ₗ
        (LinearEquiv.piOptionEquivProd R)
    let ψ : M →ₗ[R] R := LinearMap.fst R R (Fin q → R) ∘ₗ e.toLinearMap ∘ₗ φ
    let θ : M →ₗ[R] (Fin q → R) := LinearMap.snd R R (Fin q → R) ∘ₗ e.toLinearMap ∘ₗ φ
    have hker : LinearMap.ker φ = LinearMap.ker ψ ⊓ LinearMap.ker θ := by
      rw [show LinearMap.ker φ = LinearMap.ker (e.toLinearMap ∘ₗ φ) by
            rw [LinearMap.ker_comp, LinearEquiv.ker, Submodule.comap_bot]]
      rw [show e.toLinearMap ∘ₗ φ = ψ.prod θ by
            apply LinearMap.ext
            intro x
            simp only [LinearMap.comp_apply, LinearMap.prod_apply, ψ, θ, LinearMap.fst_apply,
              LinearMap.snd_apply, Function.prod]]
      rw [LinearMap.ker_prod]
    have hθ : (LinearMap.ker θ).FG := ih θ
    rw [hker]
    exact fg_inf_ker_of_coherent hR (LinearMap.ker θ) hθ ψ

theorem submodule_fg_ker_of_coherent {R : Type*} [Ring R] (hR : Ring.Coherent R)
    {p q : ℕ} (f : (Fin p → R) →ₗ[R] (Fin q → R)) : (LinearMap.ker f).FG :=
  ker_fg_pi_of_coherent hR q f

end Work.ORReductions.Coherent
