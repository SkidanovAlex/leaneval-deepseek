import Mathlib
import Submission.Work.ORReductions.FreeGroupGens.freeGens_mem_range_map_iff
import Submission.Work.ORReductions.FreeGroupGens.freeGens_mem_closure_iff
import Submission.Work.ORReductions.FreeGroupGens.freeGens_exists_injective_lift
import Submission.Work.ORReductions.PresentedGroup.presentedGroup_single_equiv
import Submission.Work.ORReductions.Coherent.groupCoherent_of_mulEquiv
import Submission.Work.ORReductions.Coherent.groupCoherent_subgroup

namespace Work.ORReductions.OneRelator

open Work.ORReductions.FreeGroupGens

/-- **A finitely generated subgroup of a coherent group is finitely presented.**

If `S ≤ H` are subgroups of `G`, `S` is finitely generated and `H` is coherent, then `S` is
finitely presented.  Indeed `S` is (isomorphic to) the subgroup `S.subgroupOf H` of `H`, which is
the image of the finitely generated group `S` under the inclusion `S → H`, hence finitely
generated, hence finitely presented by coherence of `H`. -/
theorem groupIsFinitelyPresented_of_le_of_coherent {G : Type*} [Group G] (S H : Subgroup G)
    (hSH : S ≤ H) (hH : Group.Coherent H) (hS : S.FG) : Group.IsFinitelyPresented S := by
  let e : S.subgroupOf H ≃* S := Subgroup.subgroupOfEquivOfLe hSH
  have hfg : Group.FG S := (Group.fg_iff_subgroup_fg S).mpr hS
  have hKfg : Group.FG (S.subgroupOf H) :=
    @Group.fg_of_surjective S _ (S.subgroupOf H) _ hfg e.symm.toMonoidHom e.symm.surjective
  have hK : (S.subgroupOf H).FG := (Group.fg_iff_subgroup_fg (S.subgroupOf H)).mp hKfg
  exact Group.IsFinitelyPresented.equiv e (h := hH (S.subgroupOf H) hK)

/-- The free generators occurring in `FreeGroup.map φ y` all lie in the image of `φ`. -/
private lemma gens_map_subset {ι α : Type*} (φ : ι → α) (y : FreeGroup ι) :
    FreeGroup.gens (FreeGroup.map φ y) ⊆ Set.range φ := by
  classical
  have hy : y ∈ Subgroup.closure (FreeGroup.of '' (Set.univ : Set ι)) :=
    (freeGens_mem_closure_iff y).mpr (Set.subset_univ _)
  have h1 : FreeGroup.map φ y ∈
      Subgroup.map (FreeGroup.map φ)
        (Subgroup.closure (FreeGroup.of '' (Set.univ : Set ι))) :=
    Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
  rw [MonoidHom.map_closure] at h1
  have hsub : (FreeGroup.map φ '' (FreeGroup.of '' (Set.univ : Set ι))) ⊆
      (FreeGroup.of '' Set.range φ) := by
    rintro z ⟨w, ⟨i, -, rfl⟩, rfl⟩
    rw [FreeGroup.map.of]
    exact ⟨φ i, ⟨i, rfl⟩, rfl⟩
  exact (freeGens_mem_closure_iff _).mp (Subgroup.closure_mono hsub h1)

/-- If a word `x` involves only generators from `Z`, then its image in `⟨α | r⟩` lies in any
subgroup `H` containing the images of all generators from `Z`. -/
private lemma mk_mem_of_gens_subset {α : Type*} (r : FreeGroup α) (Z : Set α)
    (H : Subgroup (PresentedGroup ({r} : Set (FreeGroup α))))
    (hH : ∀ a : Z, PresentedGroup.of (a : α) ∈ H) (x : FreeGroup α)
    (hx : FreeGroup.gens x ⊆ Z) :
    PresentedGroup.mk ({r} : Set (FreeGroup α)) x ∈ H := by
  classical
  have hxcl : x ∈ Subgroup.closure (FreeGroup.of '' Z) :=
    (freeGens_mem_closure_iff x).mpr hx
  have h1 : PresentedGroup.mk ({r} : Set (FreeGroup α)) x ∈
      Subgroup.map (PresentedGroup.mk ({r} : Set (FreeGroup α)))
        (Subgroup.closure (FreeGroup.of '' Z)) :=
    Subgroup.mem_map.mpr ⟨x, hxcl, rfl⟩
  rw [MonoidHom.map_closure] at h1
  have hsub : Subgroup.closure
      (PresentedGroup.mk ({r} : Set (FreeGroup α)) '' (FreeGroup.of '' Z)) ≤ H := by
    rw [Subgroup.closure_le H]
    rintro y ⟨w, ⟨a, ha, rfl⟩, rfl⟩
    exact hH ⟨a, ha⟩
  exact hsub h1

/-- **A relator supported on `Z` splits into the part on `Z`.**

If every generator occurring in `r` lies in `Z`, then the subgroup `H` of `⟨α | r⟩` generated by
the images of `Z` (equivalently, the range of the canonical map `⟨Z | r'⟩ →* ⟨α | r⟩`) is
isomorphic to the one-relator group `⟨Z | r'⟩` for the relator `r'` obtained by restricting `r`
to `Z`.  The isomorphism is injectivity of `PresentedGroup.map`, whose inverse kills the
generators outside `Z`. -/
private theorem supportedOneRelatorFactor {α : Type*} (r : FreeGroup α) (Z : Set α)
    (h : FreeGroup.gens r ⊆ Z) :
    ∃ (r' : FreeGroup ↥Z) (H : Subgroup (PresentedGroup ({r} : Set (FreeGroup α)))),
      (∀ a : ↥Z, PresentedGroup.of (a : α) ∈ H) ∧
      Nonempty (PresentedGroup ({r'} : Set (FreeGroup ↥Z)) ≃* H) := by
  classical
  obtain ⟨r', hr'⟩ := (freeGens_mem_range_map_iff r).mpr h
  let σ : FreeGroup ↥Z →* FreeGroup α := FreeGroup.map (Subtype.val : ↥Z → α)
  have hst : Set.MapsTo (⇑σ) ({r'} : Set (FreeGroup ↥Z)) ({r} : Set (FreeGroup α)) := by
    intro x hx
    simp only [Set.mem_singleton_iff] at hx ⊢
    rw [hx]; exact hr'
  let φ₁ : PresentedGroup ({r'} : Set (FreeGroup ↥Z)) →* PresentedGroup ({r} : Set (FreeGroup α)) :=
    PresentedGroup.map σ hst
  -- The retraction killing all generators outside `Z`.
  let θ' : α → PresentedGroup ({r'} : Set (FreeGroup ↥Z)) :=
    fun a => if ha : a ∈ Z then PresentedGroup.of (⟨a, ha⟩ : ↥Z) else 1
  have hθσ : (FreeGroup.lift θ').comp σ = PresentedGroup.mk ({r'} : Set (FreeGroup ↥Z)) := by
    refine FreeGroup.ext_hom _ _ fun a => ?_
    show FreeGroup.lift θ' (σ (FreeGroup.of a)) = PresentedGroup.mk _ (FreeGroup.of a)
    rw [show σ (FreeGroup.of a) = FreeGroup.of (a : α) from FreeGroup.map.of,
      FreeGroup.lift_apply_of]
    show (if ha : (a : α) ∈ Z then PresentedGroup.of (⟨(a : α), ha⟩ : ↥Z) else 1) =
      PresentedGroup.of a
    rw [dif_pos a.2]
  have hθr : FreeGroup.lift θ' r = 1 := by
    rw [← hr', ← MonoidHom.comp_apply, hθσ]
    exact PresentedGroup.one_of_mem (Set.mem_singleton r')
  let θbar : PresentedGroup ({r} : Set (FreeGroup α)) →* PresentedGroup ({r'} : Set (FreeGroup ↥Z)) :=
    PresentedGroup.toGroup (f := θ') (by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hθr)
  have hleft : θbar.comp φ₁ = MonoidHom.id (PresentedGroup ({r'} : Set (FreeGroup ↥Z))) := by
    refine PresentedGroup.ext fun a => ?_
    show θbar (φ₁ (PresentedGroup.of a)) = PresentedGroup.of a
    rw [show φ₁ (PresentedGroup.of a) = PresentedGroup.mk _ (σ (FreeGroup.of a)) from rfl,
      show σ (FreeGroup.of a) = FreeGroup.of (a : α) from FreeGroup.map.of]
    show θbar (PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of (a : α))) = _
    rw [show θbar (PresentedGroup.mk ({r} : Set (FreeGroup α)) (FreeGroup.of (a : α))) =
      FreeGroup.lift θ' (FreeGroup.of (a : α)) from rfl, FreeGroup.lift_apply_of]
    show (if ha : (a : α) ∈ Z then PresentedGroup.of (⟨(a : α), ha⟩ : ↥Z) else 1) =
      PresentedGroup.of a
    rw [dif_pos a.2]
  refine ⟨r', φ₁.range, ?_, ?_⟩
  · intro a
    exact ⟨PresentedGroup.of a, by
      rw [show φ₁ (PresentedGroup.of a) = PresentedGroup.mk _ (σ (FreeGroup.of a)) from rfl,
        show σ (FreeGroup.of a) = FreeGroup.of (a : α) from FreeGroup.map.of]
      rfl⟩
  · have hinj : Function.Injective φ₁ := by
      intro x y hxy
      have hx := DFunLike.congr_fun hleft x
      have hy := DFunLike.congr_fun hleft y
      simp only [MonoidHom.comp_apply, MonoidHom.id_apply] at hx hy
      rw [← hx, hxy, hy]
    refine ⟨MulEquiv.ofBijective φ₁.rangeRestrict
      ⟨fun x y hxy => hinj (by simpa using congrArg Subtype.val hxy),
        MonoidHom.rangeRestrict_surjective φ₁⟩⟩

/-- **The group half of Theorem 1.1 reduces to finitely generated one-relator groups.**

If every finitely generated one-relator group is coherent, then so is every one-relator group
(with an arbitrary, possibly infinite, generating set).  Given a finitely generated subgroup
`S ≤ G`, choose a finite generating set `s` of `S`.  The relator of a presentation of `G`
together with words representing the elements of `s` involves only finitely many generators, and
those generators generate a finitely generated one-relator subgroup `H ≤ G` containing `s`; then
`S ≤ H`, and `S` is a finitely generated subgroup of the coherent group `H`, so it is finitely
presented. -/
theorem groupCoherent_of_oneRelator_of_fg (G : Type*) [Group G] (hG : Group.OneRelator G)
    (h : ∀ (n : ℕ) (r : FreeGroup (Fin n)), Group.Coherent (PresentedGroup {r})) :
    Group.Coherent G := by
  classical
  intro S hS
  have hSfg : S.FG := hS
  obtain ⟨s, hs⟩ := Subgroup.isMulFG_iff.mp hS
  obtain ⟨α, rel, ⟨e⟩⟩ := hG
  -- preimages of the generators of `S` in the free group
  have hsurj : ∀ g : G, ∃ w : FreeGroup α,
      PresentedGroup.mk ({rel} : Set (FreeGroup α)) w = e.symm g :=
    fun g => PresentedGroup.mk_surjective _ (e.symm g)
  let wfun : G → FreeGroup α := fun g => Classical.choose (hsurj g)
  have hwfun : ∀ g : G, PresentedGroup.mk ({rel} : Set (FreeGroup α)) (wfun g) = e.symm g :=
    fun g => Classical.choose_spec (hsurj g)
  let X : Finset (FreeGroup α) := insert rel (s.image wfun)
  obtain ⟨n, φ, hφinj, hφgen⟩ := freeGens_exists_injective_lift X
  -- the relator involves only the generators in `range φ`
  have hgens_rel : FreeGroup.gens rel ⊆ Set.range φ := by
    obtain ⟨y, hy⟩ := hφgen rel (Finset.mem_insert_self rel (s.image wfun))
    rw [← hy]
    exact gens_map_subset φ y
  obtain ⟨r', H, hHgen, ⟨isoH⟩⟩ := supportedOneRelatorFactor rel (Set.range φ) hgens_rel
  -- the relator on `Fin n` obtained by relabelling along `Fin n ≃ range φ`
  let η : Fin n ≃ ↥(Set.range φ) := Equiv.ofInjective φ hφinj
  let r₀ : FreeGroup (Fin n) := FreeGroup.map (η.symm : ↥(Set.range φ) → Fin n) r'
  have hiso₀ : Nonempty (PresentedGroup ({r₀} : Set (FreeGroup (Fin n))) ≃* H) := by
    obtain ⟨h'⟩ := Work.ORReductions.PresentedGroup.presentedGroup_single_equiv r' η.symm
    exact ⟨h'.symm.trans isoH⟩
  -- every element of `s` lies in the image of `H` under `e`
  have hmem : (s : Set G) ⊆ (H.map e.toMonoidHom : Set G) := by
    intro g hg
    refine Subgroup.mem_map.mpr ⟨e.symm g, ?_, e.apply_symm_apply g⟩
    rw [← hwfun g]
    refine mk_mem_of_gens_subset rel (Set.range φ) H hHgen (wfun g) ?_
    obtain ⟨y, hy⟩ :=
      hφgen (wfun g) (Finset.mem_insert_of_mem (Finset.mem_image.mpr ⟨g, hg, rfl⟩))
    rw [← hy]
    exact gens_map_subset φ y
  refine groupIsFinitelyPresented_of_le_of_coherent S (H.map e.toMonoidHom) ?_ ?_ hSfg
  · rw [← hs]
    exact (Subgroup.closure_le _).mpr hmem
  · obtain ⟨iso⟩ := hiso₀
    exact Work.ORReductions.Coherent.groupCoherent_of_mulEquiv
      (iso.trans (Subgroup.equivMapOfInjective H e.toMonoidHom e.injective)) (h n r₀)

end Work.ORReductions.OneRelator
