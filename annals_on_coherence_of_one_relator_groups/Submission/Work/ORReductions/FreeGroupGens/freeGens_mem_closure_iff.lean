import Mathlib
import Submission.Work.ORReductions.Basic

/-!
# `FreeGroup.gens` and subgroup closures

For a free group `FreeGroup α` and a set `S ⊆ α`, an element `x` lies in the subgroup
generated by `FreeGroup.of '' S` exactly when every free generator occurring in `x`
lies in `S`.

The proof reduces the two inclusions to the two elementary facts about words:
* the generators occurring in `x * y` occur in `x` or in `y`
  (because `(x * y).toWord` is a sublist of `x.toWord ++ y.toWord`), and
* `x` is the product of the letters of its reduced word (via `FreeGroup.lift_mk`).
-/

namespace Work.ORReductions.FreeGroupGens

open FreeGroup

variable {α : Type*}

/-- The reduced word of `x`, using the canonical classical `DecidableEq` instance
(which is the instance appearing in the definition of `FreeGroup.gens`). -/
private noncomputable abbrev tw (x : FreeGroup α) : List (α × Bool) :=
  @FreeGroup.toWord α (Classical.decEq α) x

/-- Membership in `FreeGroup.gens` is membership of one of the two oriented letters
in the reduced word. -/
private lemma gens_eq (x : FreeGroup α) :
    FreeGroup.gens x = {a : α | (a, true) ∈ tw x ∨ (a, false) ∈ tw x} := by
  ext a
  simp [FreeGroup.gens, List.singleton_sublist]

private lemma gens_one : FreeGroup.gens (1 : FreeGroup α) = ∅ := by
  rw [gens_eq]
  ext a
  simp [tw, FreeGroup.toWord_one]

private lemma gens_of (a : α) : FreeGroup.gens (FreeGroup.of a) = {a} := by
  rw [gens_eq]
  ext b
  simp [tw, FreeGroup.toWord_of, Prod.ext_iff]

private lemma gens_mul_subset (x y : FreeGroup α) :
    FreeGroup.gens (x * y) ⊆ FreeGroup.gens x ∪ FreeGroup.gens y := by
  classical
  intro a ha
  rw [gens_eq] at ha
  rw [gens_eq, gens_eq]
  simp only [Set.mem_ofPred_eq, Set.mem_union] at ha ⊢
  have key : ∀ b : Bool, (a, b) ∈ tw (x * y) → (a, b) ∈ tw x ∨ (a, b) ∈ tw y := by
    intro b hb
    have h1 : List.Sublist (tw (x * y)) (tw x ++ tw y) := FreeGroup.toWord_mul_sublist x y
    exact List.mem_append.mp (List.Sublist.mem hb h1)
  rcases ha with h | h
  · rcases key true h with h' | h' <;> simp [h']
  · rcases key false h with h' | h' <;> simp [h']

private lemma mem_invRev {a : α} {b : Bool} {w : List (α × Bool)} :
    (a, b) ∈ FreeGroup.invRev w ↔ (a, !b) ∈ w := by
  induction w with
  | nil => simp [FreeGroup.invRev]
  | cons p t ih =>
    obtain ⟨p1, p2⟩ := p
    rw [FreeGroup.invRev_cons, List.mem_append, ih]
    cases b <;> cases p2 <;> simp [FreeGroup.invRev, Prod.ext_iff] <;> tauto

private lemma gens_inv (x : FreeGroup α) : FreeGroup.gens x⁻¹ = FreeGroup.gens x := by
  classical
  rw [gens_eq, gens_eq]
  ext a
  simp only [Set.mem_ofPred_eq]
  rw [show tw x⁻¹ = FreeGroup.invRev (tw x) from FreeGroup.toWord_inv x]
  rw [mem_invRev, mem_invRev]
  simp only [Bool.not_true, Bool.not_false]
  tauto

/-- `x` is the product of the letters of any word representing it; hence if all those
letters lie in `S`, then `x` lies in the subgroup generated by `FreeGroup.of '' S`. -/
private lemma mk_mem_closure {S : Set α} {w : List (α × Bool)}
    (hw : ∀ p ∈ w, p.1 ∈ S) : FreeGroup.mk w ∈ Subgroup.closure (FreeGroup.of '' S) := by
  classical
  rw [← FreeGroup.lift_of_apply (FreeGroup.mk w), FreeGroup.lift_mk]
  refine Subgroup.list_prod_mem _ (fun z hz => ?_)
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hz
  obtain ⟨a, b⟩ := p
  have ha : a ∈ S := hw (a, b) hp
  have hmem : FreeGroup.of a ∈ Subgroup.closure (FreeGroup.of '' S) :=
    Subgroup.subset_closure ⟨a, ha, rfl⟩
  cases b
  · exact Subgroup.inv_mem _ hmem
  · exact hmem

/-- Elements of the subgroup generated by `FreeGroup.of '' S` only involve generators
from `S`. -/
private lemma gens_subset_of_mem_closure {S : Set α} {x : FreeGroup α}
    (hx : x ∈ Subgroup.closure (FreeGroup.of '' S)) : FreeGroup.gens x ⊆ S := by
  classical
  let T : Subgroup (FreeGroup α) :=
    { carrier := {x | FreeGroup.gens x ⊆ S}
      one_mem' := by
        show FreeGroup.gens (1 : FreeGroup α) ⊆ S
        rw [gens_one]
        exact Set.empty_subset S
      mul_mem' := by
        intro x y hx hy
        show FreeGroup.gens (x * y) ⊆ S
        exact (gens_mul_subset x y).trans (Set.union_subset hx hy)
      inv_mem' := by
        intro x hx
        show FreeGroup.gens x⁻¹ ⊆ S
        rw [gens_inv]
        exact hx }
  have hle : Subgroup.closure (FreeGroup.of '' S) ≤ T := by
    rw [Subgroup.closure_le]
    rintro y ⟨a, ha, rfl⟩
    show FreeGroup.gens (FreeGroup.of a) ⊆ S
    rw [gens_of]
    exact Set.singleton_subset_iff.mpr ha
  exact hle hx

theorem freeGens_mem_closure_iff {α : Type*} {S : Set α} (x : FreeGroup α) :
    x ∈ Subgroup.closure (FreeGroup.of '' S) ↔ FreeGroup.gens x ⊆ S := by
  classical
  constructor
  · exact gens_subset_of_mem_closure
  · intro h
    have hw : ∀ p ∈ tw x, p.1 ∈ S := by
      rintro ⟨a, b⟩ hp
      show a ∈ S
      apply h
      rw [gens_eq]
      cases b
      · exact Or.inr hp
      · exact Or.inl hp
    have hx : FreeGroup.mk (tw x) = x := FreeGroup.mk_toWord
    rw [← hx]
    exact mk_mem_closure hw

end Work.ORReductions.FreeGroupGens
