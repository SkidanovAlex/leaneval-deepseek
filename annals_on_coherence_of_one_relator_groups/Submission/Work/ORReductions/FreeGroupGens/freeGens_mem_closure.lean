import Mathlib
import Submission.Work.ORReductions.Basic

set_option autoImplicit false

namespace Work.ORReductions.FreeGroupGens

/-! ### The generators occurring in a word

`FreeGroup.gens x` is defined in terms of the reduced word `x.toWord`. To prove
`freeGens_mem_closure` we introduce the analogous predicate on an arbitrary list of signed
letters and prove the result by induction on the list, which avoids any reduction machinery. -/

/-- The set of generators occurring in a word, i.e. in a list of signed letters. -/
def wordLetters {α : Type*} (L : List (α × Bool)) : Set α :=
  {a | (a, true) ∈ L ∨ (a, false) ∈ L}

lemma wordLetters_subset_cons {α : Type*} (hd : α × Bool) (tl : List (α × Bool)) :
    wordLetters tl ⊆ wordLetters (hd :: tl) := by
  intro a ha
  rcases ha with h | h
  · exact Or.inl (List.mem_cons_of_mem _ h)
  · exact Or.inr (List.mem_cons_of_mem _ h)

/-- Every element of the free group, presented as `mk L` for a list `L` of signed letters, lies in
the subgroup generated by the generators occurring in `L`. -/
lemma mk_mem_closure_wordLetters {α : Type*} (L : List (α × Bool)) :
    FreeGroup.mk L ∈ Subgroup.closure (FreeGroup.of '' wordLetters L) := by
  induction L with
  | nil =>
    rw [show wordLetters ([] : List (α × Bool)) = ∅ from by
        ext a; simp [wordLetters]]
    rw [Set.image_empty, Subgroup.closure_empty, Subgroup.mem_bot, FreeGroup.one_eq_mk]
  | cons hd tl ih =>
    obtain ⟨a, b⟩ := hd
    have hmul : FreeGroup.mk ((a, b) :: tl) = FreeGroup.mk [(a, b)] * FreeGroup.mk tl := by
      rw [FreeGroup.mul_mk, List.cons_append, List.nil_append]
    rw [hmul]
    apply Subgroup.mul_mem
    · have ha : a ∈ wordLetters ((a, b) :: tl) := by
        cases b
        · exact Or.inr List.mem_cons_self
        · exact Or.inl List.mem_cons_self
      have hmem : FreeGroup.of a ∈
          Subgroup.closure (FreeGroup.of '' wordLetters ((a, b) :: tl)) :=
        Subgroup.subset_closure ⟨a, ha, rfl⟩
      cases b
      · rw [show FreeGroup.mk [(a, false)] = (FreeGroup.of a)⁻¹ from by
            rw [FreeGroup.of, FreeGroup.inv_mk]; rfl]
        exact Subgroup.inv_mem _ hmem
      · rw [show FreeGroup.mk [(a, true)] = FreeGroup.of a from rfl]
        exact hmem
    · exact Subgroup.closure_mono (Set.image_mono (wordLetters_subset_cons _ tl)) ih

/-- `wordLetters` of the reduced word of `x` is exactly `FreeGroup.gens x`. -/
lemma wordLetters_toWord_eq_gens {α : Type*} (x : FreeGroup α) :
    wordLetters (@FreeGroup.toWord α (Classical.decEq α) x) = FreeGroup.gens x := by
  ext a
  simp only [wordLetters, FreeGroup.gens, Set.mem_ofPred_eq, List.singleton_sublist]

theorem freeGens_mem_closure {α : Type*} (x : FreeGroup α) :
    x ∈ Subgroup.closure (FreeGroup.of '' FreeGroup.gens x) := by
  classical
  have h := mk_mem_closure_wordLetters (α := α) x.toWord
  rw [FreeGroup.mk_toWord] at h
  rwa [wordLetters_toWord_eq_gens x] at h

end Work.ORReductions.FreeGroupGens
