import Mathlib
import Submission.Work.ORReductions.Basic

/-!
# Finitely many free generators cover a finite set

Given a finite set `F` of elements of a free group `FreeGroup α`, there are finitely many
generators `φ : Fin n → α` (injective) such that every element of `F` lies in the image of the
induced map `FreeGroup (Fin n) →* FreeGroup α`.

The proof proceeds by collecting, for every `x ∈ F`, the letters occurring in the reduced word
`x.toWord`; the union over the finite set `F` is finite, and every `x` is a product of the
corresponding generators and their inverses.
-/

namespace Work.ORReductions.FreeGroupGens

set_option linter.style.haveILetI false

variable {α : Type*}

/-- The set of generators occurring in a `List (α × Bool)` (an unreduced word). -/
private def lettersOf (L : List (α × Bool)) : Set α :=
  {a | (a, true) ∈ L ∨ (a, false) ∈ L}

/-- The element of `FreeGroup α` corresponding to a single letter `p`, namely `of p.1` if `p.2`
is `true` and `(of p.1)⁻¹` if `p.2` is `false`. -/
private def stepWord (p : α × Bool) : FreeGroup α :=
  bif p.2 then FreeGroup.of p.1 else (FreeGroup.of p.1)⁻¹

private lemma lettersOf_cons_subset (p : α × Bool) (L : List (α × Bool)) :
    lettersOf L ⊆ lettersOf (p :: L) := by
  intro a ha
  simp only [lettersOf, Set.mem_ofPred_eq] at ha ⊢
  exact Or.imp (List.mem_cons_of_mem p) (List.mem_cons_of_mem p) ha

private lemma prod_map_stepWord_mem (L : List (α × Bool)) :
    (L.map stepWord).prod ∈ Subgroup.closure (FreeGroup.of '' lettersOf L) := by
  induction L with
  | nil => simp
  | cons p L ih =>
    rw [List.map_cons, List.prod_cons]
    apply Subgroup.mul_mem
    · obtain ⟨a, b⟩ := p
      cases b
      · have ha : a ∈ lettersOf ((a, false) :: L) := by simp [lettersOf]
        have hmem : (FreeGroup.of a)⁻¹ ∈
            Subgroup.closure (FreeGroup.of '' lettersOf ((a, false) :: L)) :=
          Subgroup.inv_mem _ (Subgroup.subset_closure ⟨a, ha, rfl⟩)
        simpa [stepWord] using hmem
      · have ha : a ∈ lettersOf ((a, true) :: L) := by simp [lettersOf]
        have hmem : FreeGroup.of a ∈
            Subgroup.closure (FreeGroup.of '' lettersOf ((a, true) :: L)) :=
          Subgroup.subset_closure ⟨a, ha, rfl⟩
        simpa [stepWord] using hmem
    · exact Subgroup.closure_mono (Set.image_mono (lettersOf_cons_subset p L)) ih

/-- The product of the letters of a word `L` lies in the subgroup generated by the generators
occurring in `L`. -/
private lemma mk_mem_closure_lettersOf [DecidableEq α] (L : List (α × Bool)) :
    FreeGroup.mk L ∈ Subgroup.closure (FreeGroup.of '' lettersOf L) := by
  have h : FreeGroup.mk L = (L.map stepWord).prod := by
    rw [← FreeGroup.lift_of_apply (FreeGroup.mk L), FreeGroup.lift_mk]
    rfl
  rw [h]
  exact prod_map_stepWord_mem L

theorem freeGens_exists_injective_lift {α : Type*} (F : Finset (FreeGroup α)) :
    ∃ (n : ℕ) (φ : Fin n → α), Function.Injective φ ∧ ∀ x ∈ F, x ∈ Set.range (FreeGroup.map φ) := by
  classical
  set T : Finset α := F.biUnion (fun x => (x.toWord.map Prod.fst).toFinset) with hT
  have hmemT : ∀ x ∈ F, lettersOf x.toWord ⊆ (↑T : Set α) := by
    intro x hx a ha
    rw [hT, Finset.mem_coe, Finset.mem_biUnion]
    refine ⟨x, hx, ?_⟩
    rw [List.mem_toFinset, List.mem_map]
    rcases ha with h | h
    · exact ⟨(a, true), h, rfl⟩
    · exact ⟨(a, false), h, rfl⟩
  have hS : (↑T : Set α).Finite := T.finite_toSet
  letI : Fintype ↥(↑T : Set α) := hS.fintype
  let e := Fintype.equivFin ↥(↑T : Set α)
  refine ⟨Fintype.card ↥(↑T : Set α), fun i => ((e.symm i : ↥(↑T : Set α)) : α), ?_, ?_⟩
  · intro i j hij
    exact e.symm.injective (Subtype.ext hij)
  · intro x hx
    have hx1 : x ∈ Subgroup.closure (FreeGroup.of '' lettersOf x.toWord) := by
      simpa only [FreeGroup.mk_toWord] using mk_mem_closure_lettersOf x.toWord
    have hx2 : x ∈ Subgroup.closure (FreeGroup.of '' (↑T : Set α)) :=
      Subgroup.closure_mono (Set.image_mono (hmemT x hx)) hx1
    have hrange : Set.range (fun i => ((e.symm i : ↥(↑T : Set α)) : α)) = (↑T : Set α) := by
      ext a
      constructor
      · rintro ⟨i, rfl⟩
        exact (e.symm i).2
      · intro ha
        exact ⟨e ⟨a, ha⟩, by simp⟩
    rw [← MonoidHom.coe_range, FreeGroup.range_map, hrange]
    exact hx2

end Work.ORReductions.FreeGroupGens
