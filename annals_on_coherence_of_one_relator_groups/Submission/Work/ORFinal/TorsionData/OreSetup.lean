/-
# Setup for the Ore condition on the twisted Laurent ring `R = ⟨D N ∪ H⟩`

Let `L : LinnellDatum K G U`, `N ≤ H ≤ G` with `N` normal in `H` and `H/N ≅ ℤ` generated by
`s : H`.  In this file we set up the twisted Laurent presentation of the subring

`TorsionR L N H = Subring.closure (D N ∪ gen H)`

as a twisted Laurent polynomial ring over the division ring `↥(L.D N)`, following
`Work.ORFinal.OreField` (which does the same for the concrete envelope `U(G)`).

Contents:

* `sUnitPow L s` — the monoid homomorphism `Multiplicative ℤ →* Uˣ`, `j ↦ (gen s)^j`;
* `conjActionU L s` — the corresponding conjugation action of `ℤ` on `U`;
* `conjActionU_smul_apply` — its value, `genZPow L s j * x * genZPow L s (-j)`;
* `conj_mem_DN` — conjugation by a power of `s` preserves `D N` (normality of `N` in `H`);
* `laurentSumM L s c = Σ_i c_i (gen s)^i` — the twisted Laurent sum over the multiplicative
  indexing `Multiplicative ℤ`, i.e. the finsupp-side presentation of elements of the skew
  monoid algebra `SkewMonoidAlgebra ↥(L.D N) (Multiplicative ℤ)`.
-/
import Mathlib
import Submission.Work.ORLinnell.Main
import Submission.Work.ORFinal.TorsionData.Defs
import Submission.Work.ORFinal.OreField.skewMonoidAlgebra_ore

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ORFinal.TorsionData

open Work.ORLinnell

variable {K : Type*} [Field K] {G : Type*} [Group G] {U : Type*} [Ring U] [Nontrivial U]
  [Algebra K U]

noncomputable section

/-! ## The conjugation action of the powers of `s` -/

/-- The monoid homomorphism `Multiplicative ℤ →* Uˣ`, `j ↦ (gen s)^j`. -/
def sUnitPow (L : LinnellDatum K G U) (s : G) : Multiplicative ℤ →* Uˣ where
  toFun j := (L.gen s) ^ (Multiplicative.toAdd j)
  map_one' := by simp
  map_mul' j k := by
    rw [show Multiplicative.toAdd (j * k)
        = Multiplicative.toAdd j + Multiplicative.toAdd k from rfl, zpow_add]

/-- The conjugation action of the powers of `s` on `U`. -/
@[instance_reducible]
def conjActionU (L : LinnellDatum K G U) (s : G) : MulSemiringAction (Multiplicative ℤ) U :=
  MulSemiringAction.compHom U
    ((ConjAct.toConjAct : Uˣ ≃* ConjAct Uˣ).toMonoidHom.comp (sUnitPow L s))

/-- The value of the conjugation action on `U`. -/
theorem conjActionU_smul_apply (L : LinnellDatum K G U) (s : G) (j : ℤ) (x : U) :
    (letI := conjActionU L s; (Multiplicative.ofAdd j) • x)
      = genZPow L s j * x * genZPow L s (-j) := by
  show ConjAct.toConjAct ((L.gen s) ^ j) • x = _
  rw [ConjAct.units_smul_def, ConjAct.ofConjAct_toConjAct]
  simp only [genZPow]
  rw [zpow_neg]

/-- `genZPow L s (-j)` is the inverse (in `U`) of `genZPow L s j`, expressed through the group
element `s ^ j` of `H`. -/
theorem genZPow_neg_eq_gen_inv (L : LinnellDatum K G U) {H : Subgroup G} (s : H) (j : ℤ) :
    genZPow L (s : G) (-j) = ↑((L.gen (((s ^ j : H) : G)))⁻¹) := by
  rw [genZPow_eq_gen L H s (-j)]
  have h : (((s ^ (-j) : H) : G)) = (((s ^ j : H) : G))⁻¹ := by rw [zpow_neg]; rfl
  rw [h, map_inv]

/-- Conjugation by a power of `s` preserves the division closure `D N`, because `N` is normal
in `H` and `s ∈ H`. -/
theorem conj_mem_DN (L : LinnellDatum K G U) {N H : Subgroup G} (hNH : N ≤ H)
    (hNn : (N.subgroupOf H).Normal) (s : H) (j : ℤ) {x : U} (hx : x ∈ L.D N) :
    genZPow L (s : G) j * x * genZPow L (s : G) (-j) ∈ L.D N := by
  rw [genZPow_eq_gen L H s j, genZPow_neg_eq_gen_inv L s j]
  exact L.conj_mem hNH hNn (s ^ j) x hx

/-- `genZPow L s (-j)` is a right inverse of `genZPow L s j`. -/
theorem genZPow_neg_mul (L : LinnellDatum K G U) (s : G) (j : ℤ) :
    genZPow L s (-j) * genZPow L s j = 1 := by
  rw [← genZPow_add, neg_add_cancel, genZPow_zero]

/-- `genZPow L s (-j)` is a left inverse of `genZPow L s j`. -/
theorem genZPow_mul_neg (L : LinnellDatum K G U) (s : G) (j : ℤ) :
    genZPow L s j * genZPow L s (-j) = 1 := by
  rw [← genZPow_add, add_neg_cancel, genZPow_zero]

/-! ## The twisted Laurent sum over the multiplicative indexing -/

/-- The twisted Laurent sum `Σ_i c_i * (gen s)^i`, for `c` a finitely supported family of
elements of `D N` indexed by `Multiplicative ℤ`.  This is the `U`-valued reading of the
canonical bijection `SkewMonoidAlgebra ↥(L.D N) (Multiplicative ℤ) ≃ (Multiplicative ℤ →₀ D N)`. -/
def laurentSumM (L : LinnellDatum K G U) {N : Subgroup G} (s : G)
    (c : Multiplicative ℤ →₀ ↥(L.D N)) : U :=
  c.sum (fun i d => (d : U) * genZPow L s (Multiplicative.toAdd i))

end

end Work.ORFinal.TorsionData
