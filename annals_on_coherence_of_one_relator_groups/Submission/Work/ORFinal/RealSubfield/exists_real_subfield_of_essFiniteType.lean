import Mathlib
import Submission.Work.ORFinal.RealSubfield.real_exists_algebraicIndependent
import Submission.Work.ORFinal.RealSubfield.adjoin_embeds_real

set_option linter.style.haveILetI false

namespace Work.ORFinal.RealSubfield

/-- Every field `F` of characteristic zero that is essentially of finite type over `ℚ` admits a
subfield `L ⊆ F` which embeds into `ℝ` and over which `F` is finite.

The subfield `L` is the (purely transcendental) subfield generated by a transcendence basis of `F`
over `ℚ`: since `F` is essentially of finite type over `ℚ` its transcendence degree is finite, so
`F` is a finite (algebraic) extension of `L`, and a purely transcendental extension of finite degree
embeds into `ℝ` because `ℝ` contains arbitrarily many algebraically independent elements. -/
theorem exists_real_subfield_of_essFiniteType (F : Type*) [Field F] [CharZero F] [Algebra ℚ F]
    [Algebra.EssFiniteType ℚ F] :
    ∃ (L : Subfield F) (φ : ↥L →+* ℝ), Function.Injective φ ∧ Module.Finite ↥L F := by
  -- `F` has finite transcendence degree over `ℚ`.
  haveI : FinTrdeg ℚ F := inferInstance
  obtain ⟨s, hs⟩ := exists_finset_isTranscendenceBasis ℚ F
  -- The subfield generated by a transcendence basis is purely transcendental over `ℚ`, and `F`
  -- is algebraic over it.
  let K : IntermediateField ℚ F := IntermediateField.adjoin ℚ (Set.range (Subtype.val : s → F))
  haveI hAlg : Algebra.IsAlgebraic ↥K F := hs.isAlgebraic_field
  -- `F` is still essentially of finite type over `K`, hence finite over `K`.
  haveI : Algebra.EssFiniteType ↥K F := Algebra.EssFiniteType.of_comp ℚ ↥K F
  have hfin : Module.Finite ↥K F := Algebra.finite_of_essFiniteType_of_isAlgebraic
  -- `K` is a purely transcendental extension of `ℚ` of finite degree, so it embeds into `ℝ`.
  obtain ⟨y', hy'⟩ := real_exists_algebraicIndependent s.card
  let e : s ≃ Fin s.card := Finset.equivFin s
  let y : s → ℝ := y' ∘ e
  have hy : AlgebraicIndependent ℚ y := hy'.comp e e.injective
  obtain ⟨f⟩ := adjoin_embeds_real (Subtype.val : s → F) hs.1 y hy
  exact ⟨K.toSubfield, f, RingHom.injective f, hfin⟩

end Work.ORFinal.RealSubfield
