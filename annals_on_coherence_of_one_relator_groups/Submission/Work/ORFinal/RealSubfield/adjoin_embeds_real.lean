import Mathlib
import Submission.Work.ORReductions.Field.fg_charZero_field_embeds_complex

namespace Work.ORFinal.RealSubfield

open scoped IntermediateField.algebraAdjoinAdjoin

/-- The `ℚ`-subfield of `L` generated by an algebraically independent family `x` embeds into `ℝ`
whenever `ℝ` contains an algebraically independent family of the same cardinality.

Indeed `↥(IntermediateField.adjoin ℚ (Set.range x))` is the fraction field of the polynomial
algebra `Algebra.adjoin ℚ (Set.range x) ≅ MvPolynomial ι ℚ`, and the evaluation homomorphism
sending the variables to `y` is injective (as `y` is algebraically independent), hence extends to
the fraction field. The codomain `ℝ` plays no special role beyond being a field. -/
theorem adjoin_embeds_real {ι : Type*} {L : Type*} [Field L] [Algebra ℚ L]
    (x : ι → L) (hx : AlgebraicIndependent ℚ x)
    (y : ι → ℝ) (hy : AlgebraicIndependent ℚ y) :
    Nonempty (↥(IntermediateField.adjoin ℚ (Set.range x)) →+* ℝ) := by
  have hys : Function.Injective (MvPolynomial.aeval y : MvPolynomial ι ℚ →ₐ[ℚ] ℝ) :=
    algebraicIndependent_iff_injective_aeval.mp hy
  let g : ↥(Algebra.adjoin ℚ (Set.range x)) →ₐ[ℚ] ℝ :=
    (MvPolynomial.aeval y).comp hx.aevalEquiv.symm.toAlgHom
  have hg : Function.Injective g := hys.comp hx.aevalEquiv.symm.injective
  exact ⟨IsFractionRing.lift (g := g.toRingHom) hg⟩

end Work.ORFinal.RealSubfield
