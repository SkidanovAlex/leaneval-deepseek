/-
# Transferring the dimension-shifting chain of JL Lemma 5.2 across the two augmentation ideals

`Work.ORFinal.ChainHypFP2` and `Work.ORFinal.ChainHyp` (both in
`Submission.Work.ORFinal.ChainDefs`) are the two forms of the dimension-shifting hypothesis of
Jaikin-Zapirain--Linton Lemma 5.2: they state, for a `K`-algebra `S` with structure map
`φ : K[G] →ₐ[K] S` and every left `K[G]`-module `M`,

`IsZero (Tor₂^{K[G]}(S, M)) ↔ Tor₁^{K[G]}(S ⊗_K I_{K[G]}, M)`,

where `S ⊗_K I_{K[G]}` carries the diagonal right `K[G]`-action
`Work.ORFlatness.diagRightModule`, and where the two forms differ in the *definition* of the
augmentation ideal:

* `ChainHypFP2` uses `Work.ORFP2.augIdeal K G` (generated by the `single g 1 - 1`), the form
  produced by `Work.ORFinal.Chain.chainOfJL52`;
* `ChainHyp` uses `Work.ORLyndon.augIdeal K G` (`= ker ε`), the form consumed by
  `Work.ORLyndon.magnus_torTwoVanishes`.

The two ideals are equal (`augIdeal_ORFP2_eq_ORLyndon`), and this file transfers the hypothesis
across that equality, i.e. proves `chainHyp_of_augIdeal : ChainHypFP2 K G S φ → ChainHyp K G S φ`.

The transfer is not a rewrite, because the two ideals are only *propositionally* equal: the two
tensor products `S ⊗_K ↥I₁` and `S ⊗_K ↥I₂` are genuinely different types, and so are their
`Work.ORFlatness.diagRightModule` structures.  The route is therefore:

* `diagRightModuleLinearEquiv` — a `K[G]`-linear equivalence `X₁ ≃ₗ[K[G]] X₂` induces a
  `(K[G])ᵐᵒᵖ`-linear equivalence `S ⊗_K X₁ ≃ₗ[(K[G])ᵐᵒᵖ] S ⊗_K X₂` for the `diagRightModule`
  structures, given by `TensorProduct.map id e`; the point is that this map intertwines
  `Work.ORFlatness.diagRingHomR X₁ b` with `Work.ORFlatness.diagRingHomR X₂ b`
  (`Work.ORFinal.Chain.diagRingHomR_congr`);
* `tor1Vanishes_diagRightModule_congr` — `Work.ORFlatness.Tor1Vanishes` is invariant under a
  `(K[G])ᵐᵒᵖ`-linear equivalence of the right module
  (`Work.ORFinal.Chain.tor1Vanishes_of_linearEquiv`);
* instantiate with `↥I₁ ≃ₗ[K[G]] ↥I₂` the canonical equivalence of two equal ideals.
-/
import Mathlib
import Submission.Work.ORFinal.ChainDefs
import Submission.Work.ORFP2.mem_augIdeal_iff
import Submission.Work.ORFlatness.exists_augIdeal_rightModule
import Submission.Work.ORLyndon.Augmentation
import Submission.Work.ORFlatness.DiagonalRight
import Submission.Work.ORFlatness.Flat
import Submission.Work.ORFinal.Chain.tor1Vanishes_of_linearEquiv
import Submission.Work.ORFinal.Chain.diagRingHomR_congr

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open TensorProduct MulOpposite

namespace Work.ORFinal.Chain

universe u

/-- The two definitions of the augmentation ideal of `K[G]` occurring in the workspace agree:
`Work.ORFP2.augIdeal K G` (the ideal generated by the `single g 1 - 1`) is
`Work.ORLyndon.augIdeal K G` (the kernel of the augmentation `ε : K[G] →ₐ[K] K`). -/
theorem augIdeal_ORFP2_eq_ORLyndon (K : Type) [Field K] (G : Type) [Group G] :
    Work.ORFP2.augIdeal K G = Work.ORLyndon.augIdeal K G := by
  have haug : ∀ y : MonoidAlgebra K G,
      Work.ORFP2.augmentation K G y = Work.ORLyndon.augmentation K G y := by
    intro y
    rfl
  ext x
  rw [Work.ORFP2.mem_augIdeal_iff, Work.ORLyndon.mem_augIdeal, haug]

/-- **A `K[G]`-linear equivalence of the second factors induces a `(K[G])ᵐᵒᵖ`-linear equivalence of
the diagonal tensor products** `S ⊗[K] X₁ ≅ S ⊗[K] X₂`, the module structures being
`Work.ORFlatness.diagRightModule`.

The underlying `K`-linear map is `TensorProduct.map LinearMap.id e`; it commutes with the
generators `Work.ORFlatness.diagLinR X g` of the diagonal action because `e` is `K[G]`-linear, and
then with all of `Work.ORFlatness.diagRingHomR X b` by
`Work.ORFinal.Chain.diagRingHomR_congr`. -/
theorem diagRightModuleLinearEquiv
    (K : Type u) [CommRing K] (G : Type u) [Group G]
    (S : Type u) [Ring S] [Algebra K S] (φ : MonoidAlgebra K G →ₐ[K] S)
    (X₁ : Type u) [AddCommGroup X₁] [Module K X₁] [Module (MonoidAlgebra K G) X₁]
    [IsScalarTower K (MonoidAlgebra K G) X₁] [SMulCommClass K (MonoidAlgebra K G) X₁]
    (X₂ : Type u) [AddCommGroup X₂] [Module K X₂] [Module (MonoidAlgebra K G) X₂]
    [IsScalarTower K (MonoidAlgebra K G) X₂] [SMulCommClass K (MonoidAlgebra K G) X₂]
    (e : X₁ ≃ₗ[MonoidAlgebra K G] X₂) :
    letI := Work.ORFlatness.diagRightModule K G S φ X₁
    letI := Work.ORFlatness.diagRightModule K G S φ X₂
    Nonempty ((TensorProduct K S X₁) ≃ₗ[(MonoidAlgebra K G)ᵐᵒᵖ] (TensorProduct K S X₂)) := by
  letI h₁ := Work.ORFlatness.diagRightModule K G S φ X₁
  letI h₂ := Work.ORFlatness.diagRightModule K G S φ X₂
  let eK : X₁ ≃ₗ[K] X₂ :=
    { toFun := fun x => e x
      invFun := fun y => e.symm y
      map_add' := fun a b => map_add (e : X₁ →ₗ[MonoidAlgebra K G] X₂) a b
      map_smul' := fun c x => by
        show e (c • x) = c • e x
        rw [← IsScalarTower.algebraMap_smul (MonoidAlgebra K G) c x,
          map_smul, IsScalarTower.algebraMap_smul (MonoidAlgebra K G) c (e x)]
      left_inv := fun x => e.symm_apply_apply x
      right_inv := fun y => e.apply_symm_apply y }
  let F : (TensorProduct K S X₁) →ₗ[K] (TensorProduct K S X₂) :=
    TensorProduct.map (LinearMap.id : S →ₗ[K] S) (eK : X₁ →ₗ[K] X₂)
  let Fb : (TensorProduct K S X₂) →ₗ[K] (TensorProduct K S X₁) :=
    TensorProduct.map (LinearMap.id : S →ₗ[K] S) (eK.symm : X₂ →ₗ[K] X₁)
  have hli : ∀ g : G,
      (eK : X₁ →ₗ[K] X₂).comp (Work.ORFlatness.actLinL K G X₁ g) =
        (Work.ORFlatness.actLinL K G X₂ g).comp (eK : X₁ →ₗ[K] X₂) := by
    intro g
    ext x
    show eK (Work.ORFlatness.actLinL K G X₁ g x) = Work.ORFlatness.actLinL K G X₂ g (eK x)
    rw [Work.ORFlatness.actLinL_apply, Work.ORFlatness.actLinL_apply]
    exact map_smul e (MonoidAlgebra.single g⁻¹ (1 : K)) x
  have hli' : ∀ g : G,
      (eK.symm : X₂ →ₗ[K] X₁).comp (Work.ORFlatness.actLinL K G X₂ g) =
        (Work.ORFlatness.actLinL K G X₁ g).comp (eK.symm : X₂ →ₗ[K] X₁) := by
    intro g
    ext x
    show eK.symm (Work.ORFlatness.actLinL K G X₂ g x) =
      Work.ORFlatness.actLinL K G X₁ g (eK.symm x)
    rw [Work.ORFlatness.actLinL_apply, Work.ORFlatness.actLinL_apply]
    exact map_smul e.symm (MonoidAlgebra.single g⁻¹ (1 : K)) x
  have hf : ∀ g : G, F.comp (Work.ORFlatness.diagLinR K G S φ X₁ g) =
      (Work.ORFlatness.diagLinR K G S φ X₂ g).comp F := by
    intro g
    rw [Work.ORFlatness.diagLinR, Work.ORFlatness.diagLinR]
    show TensorProduct.map (LinearMap.id : S →ₗ[K] S) (eK : X₁ →ₗ[K] X₂) ∘ₗ
        TensorProduct.map (Work.ORFlatness.mulLinR K G S φ g) (Work.ORFlatness.actLinL K G X₁ g)
      = TensorProduct.map (Work.ORFlatness.mulLinR K G S φ g) (Work.ORFlatness.actLinL K G X₂ g) ∘ₗ
        TensorProduct.map (LinearMap.id : S →ₗ[K] S) (eK : X₁ →ₗ[K] X₂)
    rw [← TensorProduct.map_comp (f₂ := (LinearMap.id : S →ₗ[K] S)) (g₂ := (eK : X₁ →ₗ[K] X₂))
          (f₁ := Work.ORFlatness.mulLinR K G S φ g) (g₁ := Work.ORFlatness.actLinL K G X₁ g),
        ← TensorProduct.map_comp (f₂ := Work.ORFlatness.mulLinR K G S φ g)
          (g₂ := Work.ORFlatness.actLinL K G X₂ g) (f₁ := (LinearMap.id : S →ₗ[K] S))
          (g₁ := (eK : X₁ →ₗ[K] X₂))]
    rw [LinearMap.id_comp, LinearMap.comp_id, hli g]
  have hf' : ∀ g : G, Fb.comp (Work.ORFlatness.diagLinR K G S φ X₂ g) =
      (Work.ORFlatness.diagLinR K G S φ X₁ g).comp Fb := by
    intro g
    rw [Work.ORFlatness.diagLinR, Work.ORFlatness.diagLinR]
    show TensorProduct.map (LinearMap.id : S →ₗ[K] S) (eK.symm : X₂ →ₗ[K] X₁) ∘ₗ
        TensorProduct.map (Work.ORFlatness.mulLinR K G S φ g) (Work.ORFlatness.actLinL K G X₂ g)
      = TensorProduct.map (Work.ORFlatness.mulLinR K G S φ g) (Work.ORFlatness.actLinL K G X₁ g) ∘ₗ
        TensorProduct.map (LinearMap.id : S →ₗ[K] S) (eK.symm : X₂ →ₗ[K] X₁)
    rw [← TensorProduct.map_comp (f₂ := (LinearMap.id : S →ₗ[K] S))
          (g₂ := (eK.symm : X₂ →ₗ[K] X₁))
          (f₁ := Work.ORFlatness.mulLinR K G S φ g) (g₁ := Work.ORFlatness.actLinL K G X₂ g),
        ← TensorProduct.map_comp (f₂ := Work.ORFlatness.mulLinR K G S φ g)
          (g₂ := Work.ORFlatness.actLinL K G X₁ g) (f₁ := (LinearMap.id : S →ₗ[K] S))
          (g₁ := (eK.symm : X₂ →ₗ[K] X₁))]
    rw [LinearMap.id_comp, LinearMap.comp_id, hli' g]
  have hdiag : ∀ (b : MonoidAlgebra K Gᵐᵒᵖ) (z : TensorProduct K S X₁),
      F (Work.ORFlatness.diagRingHomR K G S φ X₁ b z) =
        Work.ORFlatness.diagRingHomR K G S φ X₂ b (F z) :=
    diagRingHomR_congr K G S φ X₁ X₂ F hf
  have hdiag' : ∀ (b : MonoidAlgebra K Gᵐᵒᵖ) (z : TensorProduct K S X₂),
      Fb (Work.ORFlatness.diagRingHomR K G S φ X₂ b z) =
        Work.ORFlatness.diagRingHomR K G S φ X₁ b (Fb z) :=
    diagRingHomR_congr K G S φ X₂ X₁ Fb hf'
  refine ⟨{ toLinearMap := ?_
            invFun := fun z => Fb z
            left_inv := ?_
            right_inv := ?_ }⟩
  · refine { toFun := fun z => F z
             map_add' := fun a b => map_add F a b
             map_smul' := ?_ }
    intro a z
    show F (a • z) = a • F z
    have hz : a • z =
        Work.ORFlatness.diagRingHomR K G S φ X₁ (Work.ORFlatness.opRingHom K G a) z := rfl
    have hw : a • F z =
        Work.ORFlatness.diagRingHomR K G S φ X₂ (Work.ORFlatness.opRingHom K G a) (F z) := rfl
    rw [hz, hw, hdiag]
  · intro z
    show Fb (F z) = z
    induction z using TensorProduct.induction_on with
    | zero => simp [F, Fb]
    | tmul s x => simp [F, Fb]
    | add a b ha hb => simp only [map_add, ha, hb]
  · intro z
    show F (Fb z) = z
    induction z using TensorProduct.induction_on with
    | zero => simp [F, Fb]
    | tmul s x => simp [F, Fb]
    | add a b ha hb => simp only [map_add, ha, hb]

/-- **`Tor₁`-vanishing for the diagonal tensor product is insensitive to which of two equal
augmentation ideals is used.**  For `I₁ = I₂` an equality of ideals of `K[G]`, and any left
`K[G]`-module `N`, the `Work.ORFlatness.Tor1Vanishes` statement for
`S ⊗[K] ↥I₁` (with `Work.ORFlatness.diagRightModule`) is equivalent to the one for
`S ⊗[K] ↥I₂`. -/
theorem tor1Vanishes_diagRightModule_congr
    (K : Type u) [Field K] (G : Type u) [Group G]
    (S : Type u) [Ring S] [Algebra K S] (φ : MonoidAlgebra K G →ₐ[K] S)
    {I₁ I₂ : Ideal (MonoidAlgebra K G)} (hI : I₁ = I₂)
    (N : Type u) [AddCommGroup N] [Module (MonoidAlgebra K G) N] :
    (letI := Work.ORFlatness.diagRightModule K G S φ ↥I₁
     Work.ORFlatness.Tor1Vanishes (MonoidAlgebra K G) (TensorProduct K S ↥I₁) N) ↔
    (letI := Work.ORFlatness.diagRightModule K G S φ ↥I₂
     Work.ORFlatness.Tor1Vanishes (MonoidAlgebra K G) (TensorProduct K S ↥I₂) N) := by
  letI h₁ := Work.ORFlatness.diagRightModule K G S φ ↥I₁
  letI h₂ := Work.ORFlatness.diagRightModule K G S φ ↥I₂
  have he : ↥I₁ ≃ₗ[MonoidAlgebra K G] ↥I₂ := LinearEquiv.ofEq I₁ I₂ hI
  obtain ⟨E⟩ := diagRightModuleLinearEquiv K G S φ ↥I₁ ↥I₂ he
  constructor
  · intro h
    exact tor1Vanishes_of_linearEquiv (MonoidAlgebra K G)
      (TensorProduct K S ↥I₂) (TensorProduct K S ↥I₁) E.symm N h
  · intro h
    exact tor1Vanishes_of_linearEquiv (MonoidAlgebra K G)
      (TensorProduct K S ↥I₁) (TensorProduct K S ↥I₂) E N h

/-- **The dimension-shifting chain of JL Lemma 5.2 transfers across the two augmentation ideals**:
the `Work.ORFP2.augIdeal` form (`Work.ORFinal.ChainHypFP2`) implies the `Work.ORLyndon.augIdeal`
form (`Work.ORFinal.ChainHyp`). -/
theorem chainHyp_of_augIdeal (K : Type) [Field K] (G : Type) [Group G] (S : Type) [Ring S]
    [Algebra K S] (φ : MonoidAlgebra K G →ₐ[K] S) (h : Work.ORFinal.ChainHypFP2 K G S φ) :
    Work.ORFinal.ChainHyp K G S φ := by
  unfold Work.ORFinal.ChainHyp
  intro M
  exact (h M).trans (tor1Vanishes_diagRightModule_congr K G S φ
    (augIdeal_ORFP2_eq_ORLyndon K G) (↥M))

end Work.ORFinal.Chain
