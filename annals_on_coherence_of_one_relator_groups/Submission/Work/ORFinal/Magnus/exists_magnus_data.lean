import Mathlib
import Submission.Work.OROneRel.Basic
import Submission.Work.OROneRel.exists_root
import Submission.Work.OROneRel.exists_cyclicallyReduced_conjugate
import Submission.Work.OROneRel.letters_closure_iff
import Submission.Work.OROneRel.relatorLetters_eq_empty_iff
import Submission.Work.ORLyndon.Lyndon
import Submission.Work.ORLyndon.lyndonIdentity_of_pow

/-!
# The Magnus set-up: cyclically reduced conjugate, primitive root, and the free generator

Given a nontrivial relator `r` in the free group `F(Fin n)`, this provides the data used to run
Magnus' arguments on the one-relator group `⟨Fin n | r⟩`:

* `r'` is a *cyclically reduced* conjugate of `r`, so `⟨Fin n | r'⟩ ≃* ⟨Fin n | r⟩`;
* `r' = u ^ l` with `l ≥ 1` and `u` not a proper power (the primitive root of `r'`).
  Consequently, by Lyndon's identity theorem (`Work.ORLyndon.lyndonIdentity_of_pow`), the relation
  module of the presentation `⟨Fin n | r'⟩` has the standard form;
* a generator `t` occurring in `r'`, and the complementary set `Y = univ \ {t}` of generators:
  then `t ∉ Y`, every generator outside `Y` is `t`, and `r' ∉ ⟨Y⟩` because `r'` involves `t`.

## Main declaration

* `Work.ORFinal.Magnus.exists_magnus_data`.
-/

namespace Work.ORFinal.Magnus

theorem exists_magnus_data (K : Type) [Field K] (n : ℕ) (r : FreeGroup (Fin n)) (hr : r ≠ 1) :
    ∃ (r' : FreeGroup (Fin n))
      (e : PresentedGroup ({r'} : Set (FreeGroup (Fin n))) ≃*
        PresentedGroup ({r} : Set (FreeGroup (Fin n))))
      (l : ℕ) (u : FreeGroup (Fin n)) (t : Fin n) (Y : Finset (Fin n)),
      r' ≠ 1 ∧ 1 ≤ l ∧ r' = u ^ l ∧ ¬ Work.OROneRel.IsProperPower u ∧ t ∉ Y ∧
      (∀ x : Fin n, x ∉ Y → x = t) ∧ Work.OROneRel.IsCyclicallyReducedRelator r' ∧
      r' ∉ Subgroup.closure (FreeGroup.of '' (Y : Set (Fin n))) ∧
      Work.ORLyndon.LyndonIdentity K (Fin n) r' u l := by
  classical
  -- A cyclically reduced conjugate `s` of `r`, and the resulting isomorphism of presentations.
  obtain ⟨s, hcyc, hsne, ⟨e0⟩⟩ := Work.OROneRel.exists_cyclicallyReduced_conjugate r hr
  -- The primitive root of `s`: `s = u ^ l` with `u` not a proper power.
  obtain ⟨u, l, hl, hpow, hpp⟩ := Work.OROneRel.exists_root s hsne
  -- `s ≠ 1`, so some generator occurs in `s`; take it to be `t`, and `Y` the others.
  have hne : (Work.OROneRel.relatorLetters s).Nonempty := by
    by_contra h
    rw [Set.not_nonempty_iff_eq_empty] at h
    exact hsne ((Work.OROneRel.relatorLetters_eq_empty_iff s).mp h)
  obtain ⟨t, ht⟩ := hne
  refine ⟨s, e0.symm, l, u, t, Finset.univ.erase t, hsne, hl, hpow, hpp, ?_, ?_, hcyc, ?_, ?_⟩
  · exact Finset.notMem_erase t Finset.univ
  · intro x hx
    exact Finset.eq_of_mem_of_notMem_erase (Finset.mem_univ x) hx
  · -- `s` involves `t`, so it is not in the subgroup generated by the other generators.
    intro hmem
    have hsub : Work.OROneRel.SupportedOn s (↑(Finset.univ.erase t) : Set (Fin n)) :=
      (Work.OROneRel.letters_closure_iff s _).mp hmem
    exact Finset.notMem_erase t Finset.univ (hsub ht)
  · exact Work.ORLyndon.lyndonIdentity_of_pow s u l hl hpow hpp hsne

end Work.ORFinal.Magnus
