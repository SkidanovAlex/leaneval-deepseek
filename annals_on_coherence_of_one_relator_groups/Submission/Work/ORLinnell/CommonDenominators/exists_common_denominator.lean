import Mathlib
import Submission.Work.ORLinnell.Linnell
import Submission.Work.ORLinnell.FiniteIndex.span_D_right
import Submission.Work.ORLinnell.CommonDenominators.exists_common_denominator_finite

namespace Work.ORLinnell.CommonDenominators

open Work.ORLinnell

/-!
# Common right denominators for the Laurent decomposition of `D H`

This file proves the "common denominator" step (L3 of the torsion-case design,
`N8_TORSION_LEAD.md`).  Let `G' ⊴ G` be torsion free of finite index, `G' ≤ H`,
`N ≤ H` with `H/N ≅ ℤ`.  Writing `H₀ := H ⊓ G'` and `N₀ := N ⊓ G'`, the extension
`H₀/N₀ ≅ ℤ` is again infinite cyclic and `H₀` is torsion free, so `D H₀` is the Ore
field of fractions of `R₀ = D(N₀)[H₀]`; hence finitely many elements of `D H₀` admit a
common right denominator in `R₀`.

The proof assembles two independent ingredients:

* `Work.ORLinnell.FiniteIndex.span_D_of_torsionFree_right`: `D H` is spanned over `D H₀`
  by (right) coefficients indexed by the coset space `H ⧸ H₀`;
* `Work.ORLinnell.CommonDenominators.exists_common_denominator_finite`: a finite family
  in `D Γ` has a common right denominator in the subring generated by `D N₀` and `Γ`,
  whenever `Γ` is torsion free and `Γ/N₀ ≅ ℤ`.
-/

/-- If `N ≤ H` has `H/N ≅ ℤ` and `H₀ ≤ H` has finite index in `H`, then
`H₀/(N ⊓ H₀) ≅ ℤ`.  This is the restriction of the extension by `ℤ` to a finite index
subgroup. -/
theorem isExtensionByZ_of_finiteIndex_le {G : Type*} [Group G] {N H₀ H : Subgroup G}
    (hH₀ : H₀ ≤ H) (hφ : IsExtensionByZ N H) (hfin : (H₀.subgroupOf H).FiniteIndex) :
    IsExtensionByZ (N ⊓ H₀) H₀ := by
  obtain ⟨φ, hsurj, hker⟩ := hφ
  let φ₀ : H₀ →* Multiplicative ℤ := φ.comp (Subgroup.inclusion hH₀)
  have hφ₀ker : φ₀.ker = (N ⊓ H₀).subgroupOf H₀ := by
    ext x
    rw [MonoidHom.mem_ker]
    constructor
    · intro h
      rw [Subgroup.mem_subgroupOf]
      have h1 : Subgroup.inclusion hH₀ x ∈ φ.ker := by rw [MonoidHom.mem_ker]; exact h
      rw [hker, Subgroup.mem_subgroupOf] at h1
      exact ⟨by simpa using h1, x.2⟩
    · intro h
      rw [Subgroup.mem_subgroupOf] at h
      have h1 : Subgroup.inclusion hH₀ x ∈ φ.ker := by
        rw [hker, Subgroup.mem_subgroupOf]; simpa using h.1
      rw [MonoidHom.mem_ker] at h1
      exact h1
  obtain ⟨s, hs⟩ := hsurj (Multiplicative.ofAdd (1 : ℤ))
  obtain ⟨n, hnpos, -, hnmem⟩ := Subgroup.exists_pow_mem_of_index_ne_zero hfin.index_ne_zero s
  have hAn : Multiplicative.ofAdd (n : ℤ) ∈ φ₀.range := by
    refine ⟨⟨s ^ n, hnmem⟩, ?_⟩
    show φ (Subgroup.inclusion hH₀ ⟨s ^ n, hnmem⟩) = Multiplicative.ofAdd (n : ℤ)
    rw [show (Subgroup.inclusion hH₀ ⟨s ^ n, hnmem⟩ : H) = s ^ n from rfl, map_pow, hs]
    rw [← zpow_natCast, ← ofAdd_zsmul]; simp
  let B : AddSubgroup ℤ := Subgroup.toAddSubgroup' φ₀.range
  have hBmem : ∀ z : ℤ, z ∈ B ↔ Multiplicative.ofAdd z ∈ φ₀.range :=
    fun z => Subgroup.mem_toAddSubgroup' φ₀.range z
  obtain ⟨a, ha⟩ := Int.subgroup_cyclic B
  have ha' : B = AddSubgroup.zmultiples a := by rw [ha, ← AddSubgroup.zmultiples_eq_closure]
  have han : a ∣ (n : ℤ) := by
    rw [← Int.mem_zmultiples_iff, ← ha']; exact (hBmem n).mpr hAn
  have ha0 : a ≠ 0 := by
    intro h0
    rw [h0] at han
    exact absurd (Int.zero_dvd.mp han) (by exact_mod_cast hnpos.ne')
  have hA : φ₀.range = Subgroup.zpowers (Multiplicative.ofAdd a) := by
    ext x
    rw [Subgroup.mem_zpowers_iff]
    constructor
    · intro hx
      have hxB : Multiplicative.toAdd x ∈ B := (hBmem _).mpr (by simpa using hx)
      have hxzm : Multiplicative.toAdd x ∈ AddSubgroup.zmultiples a := by rw [← ha']; exact hxB
      obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp hxzm
      exact ⟨c, by rw [← ofAdd_zsmul, hc]; rfl⟩
    · rintro ⟨k, rfl⟩
      exact Subgroup.zpow_mem φ₀.range
        ((hBmem a).mp (by rw [ha']; exact Int.mem_zmultiples_iff.mpr dvd_rfl)) k
  let f : Multiplicative ℤ →* Multiplicative ℤ :=
    zpowersHom (Multiplicative ℤ) (Multiplicative.ofAdd a)
  have hfapply : ∀ k : Multiplicative ℤ,
      f k = (Multiplicative.ofAdd a) ^ (Multiplicative.toAdd k) := fun k => rfl
  have hfrange : f.range = Subgroup.zpowers (Multiplicative.ofAdd a) := by
    ext x
    rw [MonoidHom.mem_range, Subgroup.mem_zpowers_iff]
    constructor
    · rintro ⟨k, rfl⟩; exact ⟨Multiplicative.toAdd k, (hfapply k).symm⟩
    · rintro ⟨k, rfl⟩; exact ⟨Multiplicative.ofAdd k, by rw [hfapply]; simp⟩
  have hf_inj : Function.Injective f := by
    intro m n hmn
    rw [hfapply m, hfapply n] at hmn
    have hthis : Multiplicative.ofAdd ((Multiplicative.toAdd m) • a)
        = Multiplicative.ofAdd ((Multiplicative.toAdd n) • a) := by
      rw [ofAdd_zsmul, ofAdd_zsmul]; exact hmn
    have h2 : (Multiplicative.toAdd m) • a = (Multiplicative.toAdd n) • a :=
      Multiplicative.ofAdd.injective hthis
    rw [zsmul_eq_mul, zsmul_eq_mul] at h2
    exact Multiplicative.toAdd.injective (mul_right_cancel₀ ha0 h2)
  have hfeq : f.range = φ₀.range := by rw [hfrange, hA]
  let e : ↥φ₀.range ≃* Multiplicative ℤ :=
    (MulEquiv.subgroupCongr hfeq.symm).trans (MonoidHom.ofInjective hf_inj).symm
  refine ⟨e.toMonoidHom.comp φ₀.rangeRestrict, ?_, ?_⟩
  · intro y
    obtain ⟨z, hz⟩ := e.surjective y
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp z.2
    refine ⟨x, ?_⟩
    have hzx : φ₀.rangeRestrict x = z := Subtype.ext (by simpa using hx)
    show e (φ₀.rangeRestrict x) = y
    rw [hzx]; exact hz
  · rw [← hφ₀ker]
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
    constructor
    · intro h
      simpa using congrArg Subtype.val (e.map_eq_one_iff.mp h)
    · intro h
      show e (φ₀.rangeRestrict x) = 1
      rw [show φ₀.rangeRestrict x = 1 from Subtype.ext (by simpa using h)]
      exact map_one e

theorem exists_common_denominator {K : Type*} [Field K] [CharZero K] {G : Type*} [Group G]
    {U : Type*} [Ring U] [Nontrivial U] [Algebra K U] (L : Work.ORLinnell.LinnellDatum K G U)
    (G' : Subgroup G) (hG'n : G'.Normal) (htf : IsMulTorsionFree G') (hfin : G'.FiniteIndex)
    {N H : Subgroup G} (hNH : N ≤ H) (hN : (N.subgroupOf H).Normal) (hG'H : G' ≤ H)
    (hφ : Work.ORLinnell.IsExtensionByZ N H) (k : ℕ) (e : Fin k → U) (he : ∀ i, e i ∈ L.D H) :
    ∃ t, t ∈ Subring.closure ((L.D (N ⊓ G') : Set U) ∪
          Set.range (fun h : ↥(H ⊓ G') => (L.gen ((h : G)) : U))) ∧ t ≠ 0 ∧
      ∀ i, e i * t ∈ Subring.closure ((L.D N : Set U) ∪
          Set.range (fun h : H => (L.gen ((h : G)) : U))) := by
  have hH₀norm : ((H ⊓ G').subgroupOf H).Normal := by
    rw [Subgroup.inf_subgroupOf_left G' H]
    exact hG'n.subgroupOf H
  have hH₀fin : ((H ⊓ G').subgroupOf H).FiniteIndex := by
    rw [Subgroup.inf_subgroupOf_left G' H]
    exact Subgroup.instFiniteIndex_subgroupOf G' H
  have htfH₀ : IsMulTorsionFree ↥(H ⊓ G') := isMulTorsionFree_inf htf H
  have hN₀H₀ : N ⊓ G' ≤ H ⊓ G' := inf_le_inf hNH le_rfl
  have hφ₀ : IsExtensionByZ (N ⊓ G') (H ⊓ G') := by
    have h := isExtensionByZ_of_finiteIndex_le (N := N) (H₀ := H ⊓ G') (H := H)
      inf_le_left hφ hH₀fin
    rwa [show N ⊓ (H ⊓ G') = N ⊓ G' from by rw [← inf_assoc, inf_eq_left.mpr hNH]] at h
  let R : Subring U :=
    Subring.closure ((L.D N : Set U) ∪ Set.range (fun h : H => (L.gen ((h : G)) : U)))
  let R₀ : Subring U :=
    Subring.closure ((L.D (N ⊓ G') : Set U) ∪
      Set.range (fun h : ↥(H ⊓ G') => (L.gen ((h : G)) : U)))
  have hR₀R : R₀ ≤ R := by
    rw [Subring.closure_le]
    rintro x (hx | hx)
    · exact Subring.subset_closure (Set.mem_union_left _ (L.D_mono inf_le_left hx))
    · obtain ⟨h, rfl⟩ := hx
      refine Subring.subset_closure (Set.mem_union_right _ ?_)
      exact ⟨⟨(h : G), h.2.1⟩, rfl⟩
  choose c hc using fun i =>
    Work.ORLinnell.FiniteIndex.span_D_of_torsionFree_right L inf_le_left hH₀norm hH₀fin htfH₀
      (e i) (he i)
  let Q := H ⧸ (H ⊓ G').subgroupOf H
  letI : Fintype Q := Fintype.ofFinite Q
  let δ : Fin k × Q → U := fun p => (c p.1 p.2 : U)
  have hδmem : ∀ p : Fin k × Q, δ p ∈ L.D (H ⊓ G') := fun p => (c p.1 p.2).2
  let iota := Fin k × Q
  let ei : iota ≃ Fin (Fintype.card iota) := Fintype.equivFin iota
  let δ' : Fin (Fintype.card iota) → U := fun j => δ (ei.symm j)
  have hδ'mem : ∀ j, δ' j ∈ L.D (H ⊓ G') := fun j => hδmem _
  obtain ⟨t, htR₀, htne, hδt⟩ :=
    exists_common_denominator_finite L hN₀H₀ htfH₀ hφ₀ (Fintype.card iota) δ' hδ'mem
  refine ⟨t, htR₀, htne, fun i => ?_⟩
  have hci : e i = (c i).sum (fun q d => (L.gen ((Quotient.out q : H) : G) : U) * (d : U)) :=
    hc i
  rw [hci, Finsupp.sum_mul, Finsupp.sum]
  apply Subring.sum_mem
  intro q _
  rw [mul_assoc]
  refine R.mul_mem (Subring.subset_closure (Set.mem_union_right _ ⟨Quotient.out q, rfl⟩)) ?_
  have hmem : δ' (ei (i, q)) * t ∈ R₀ := hδt _
  have hval : δ' (ei (i, q)) = (c i q : U) := by
    simp only [δ', δ, Equiv.symm_apply_apply]
  rw [hval] at hmem
  exact hR₀R hmem

end Work.ORLinnell.CommonDenominators
