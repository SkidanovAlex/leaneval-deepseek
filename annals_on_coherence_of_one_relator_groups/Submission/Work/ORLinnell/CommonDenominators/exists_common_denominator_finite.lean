import Mathlib
import Submission.Work.ORLinnell.Linnell

/-!
# A common right denominator for finitely many elements of `D Γ`

Let `L : LinnellDatum K G U`, let `N₀ ≤ Γ` be subgroups of `G` with `Γ` torsion free and
`Γ/N₀ ≅ ℤ`, and let `C` be the subring of `U` generated by `D N₀` and the image of `Γ`.  By the
Ore field of fractions statement **(I4′b)** (`LinnellDatum.ore_field_frac`) every element of
`D Γ` is a right quotient `a * t⁻¹` with `a, t ∈ C` and `t ≠ 0`.

This file shows that *finitely many* elements of `D Γ` have a *common* right denominator in `C`:
there is `t ∈ C`, `t ≠ 0`, with `δ j * t ∈ C` for all `j`.  The proof is an induction on the
number of elements: given a common denominator `t₀` for `δ₁, …, δₙ`, apply **(I4′b)** to the
single element `δ₀ * t₀ ∈ D Γ`, say `δ₀ * t₀ = a * t₁⁻¹`; then `t₀ * t₁` is a common denominator
for `δ₀, …, δₙ`.  Non-vanishing of the product uses **(I4′a)**: a nonzero element of `C` is a
unit of `U`.
-/

namespace Work.ORLinnell.CommonDenominators

theorem exists_common_denominator_finite {K : Type*} [Field K] {G : Type*} [Group G]
    {U : Type*} [Ring U] [Nontrivial U] [Algebra K U] (L : Work.ORLinnell.LinnellDatum K G U)
    {N₀ Γ : Subgroup G} (hN₀ : N₀ ≤ Γ) (htf : IsMulTorsionFree Γ)
    (hφ : Work.ORLinnell.IsExtensionByZ N₀ Γ) (m : ℕ) (δ : Fin m → U)
    (hδ : ∀ j, δ j ∈ L.D Γ) :
    ∃ t, t ∈ Subring.closure ((L.D N₀ : Set U) ∪
        Set.range (fun γ : Γ => (L.gen ((γ : G)) : U))) ∧ t ≠ 0 ∧
      ∀ j, δ j * t ∈ Subring.closure ((L.D N₀ : Set U) ∪
        Set.range (fun γ : Γ => (L.gen ((γ : G)) : U))) := by
  classical
  -- `C` is the subring generated by `D N₀` and the image of `Γ`
  let C : Subring U := Subring.closure ((L.D N₀ : Set U) ∪
      Set.range (fun γ : Γ => (L.gen ((γ : G)) : U)))
  -- `C` is contained in `D Γ`
  have hC_le : C ≤ L.D Γ :=
    Subring.closure_le.mpr (by
      rintro x (hx | hx)
      · exact L.D_mono hN₀ hx
      · obtain ⟨γ, rfl⟩ := hx
        exact L.gen_mem Γ γ)
  -- a nonzero element of `C` is a unit of `U` (**(I4′a)**)
  have hunit : ∀ x ∈ C, x ≠ 0 → IsUnit x := by
    intro x hx hxne
    obtain ⟨u, -, hu1, hu2⟩ := L.ore_field_unit N₀ Γ hN₀ htf hφ x hx hxne
    exact ⟨⟨x, u, hu2, hu1⟩, rfl⟩
  -- the inductive statement, with `C` for the closure
  have key : ∀ (m : ℕ) (δ : Fin m → U), (∀ j, δ j ∈ L.D Γ) →
      ∃ t ∈ C, t ≠ 0 ∧ ∀ j, δ j * t ∈ C := by
    intro m
    induction m with
    | zero =>
      intro δ _
      exact ⟨1, C.one_mem, one_ne_zero, fun j => j.elim0⟩
    | succ n ih =>
      intro δ hδ
      -- a common denominator for the tail `δ (Fin.succ ·)`
      obtain ⟨t₀, ht₀, ht₀ne, htail⟩ := ih (fun i => δ (Fin.succ i)) (fun i => hδ _)
      -- a denominator for the head, applied to `δ 0 * t₀ ∈ D Γ`
      obtain ⟨a, ha, t₁, ht₁, ht₁ne, hhead⟩ :=
        L.ore_field_frac N₀ Γ hN₀ htf hφ (δ 0 * t₀) ((L.D Γ).mul_mem (hδ 0) (hC_le ht₀))
      refine ⟨t₀ * t₁, C.mul_mem ht₀ ht₁, ?_, ?_⟩
      · exact ((hunit t₀ ht₀ ht₀ne).mul (hunit t₁ ht₁ ht₁ne)).ne_zero
      · intro j
        refine Fin.cases ?_ ?_ j
        · show δ 0 * (t₀ * t₁) ∈ C
          rw [← mul_assoc, hhead]
          exact ha
        · intro i
          show δ (Fin.succ i) * (t₀ * t₁) ∈ C
          rw [← mul_assoc]
          exact C.mul_mem (htail i) ht₁
  obtain ⟨t, ht, htne, h⟩ := key m δ hδ
  exact ⟨t, ht, htne, h⟩

end Work.ORLinnell.CommonDenominators
