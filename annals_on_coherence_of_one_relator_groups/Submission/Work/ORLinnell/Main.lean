import Submission.Work.ORLinnell.Linnell
import Submission.Work.ORLinnell.FiniteIndex.span_D_of_finiteIndex
import Submission.Work.ORLinnell.FiniteIndex.eq_zero_of_sum_transversal
import Submission.Work.ORLinnell.Cosets.isSemisimpleRing_D
import Submission.Work.ORLinnell.Cosets.existsUnique_coset_rep
import Submission.Work.ORLinnell.Laurent.existsUnique_laurent_rep
import Submission.Work.ORLinnell.CommonDenominators.exists_common_denominator

/-!
# Node N7: the Linnell ring `S = D(K[G])` for a one-relator group

This file collects the results of the area `Submission.Work.ORLinnell` in the form in which the
torsion case of the Jaikin-Zapirain--Linton theorem consumes them (`N8_TORSION_LEAD.md`,
sublemmas L1--L3).

Main statements (all for `L : LinnellDatum K G U`, with `S = L.S = L.D ⊤`):

* `Work.ORLinnell.span_D_of_torsionFree` — **L1(1)**: if `H₀ ≤ H` is normal of finite index and
  torsion free, then every element of `D H` is a finite `D H₀`-linear combination of a
  transversal of `H₀` in `H`;
* `Work.ORLinnell.D_eq_closure_of_torsionFree` — the same, in the form
  `D H = ⟨D H₀ ∪ transversal⟩`;
* `Work.ORLinnell.isSemisimpleRing_D_of_torsionFree` — **L1(2)**: `D H` is semisimple
  (Maschke averaging in characteristic zero);
* `Work.ORLinnell.Cosets.isSemisimpleRing_D` — **L1 corollary**: for a normal torsion free
  finite index `G' ⊴ G`, *every* `D H` (`H ≤ G`) is semisimple;
* `Work.ORLinnell.isSemisimpleRing_S` — `S = D(G)` is semisimple;
* `Work.ORLinnell.Cosets.existsUnique_coset_rep` — `D H = ⊕_{q} D(H ∩ G')·q` with unique
  coordinates;
* `Work.ORLinnell.Laurent.existsUnique_laurent_rep` — **L2**: if `H/N ≅ ℤ` then the subring
  generated by `D N` and `H` is `⊕_{j ∈ ℤ} D N · s^j`;
* `Work.ORLinnell.CommonDenominators.exists_common_denominator` — **L3**: common right
  denominators from the torsion free piece `H ∩ G'`.
-/

noncomputable section

namespace Work.ORLinnell

open Work.ORLinnell

variable {K : Type*} [Field K] {G : Type*} [Group G] {U : Type*} [Ring U] [Nontrivial U]
  [Algebra K U]

/-- **L1(1)**, torsion free form: the transversal expansion of `D H` over `D H₀`. -/
theorem span_D_of_torsionFree (L : LinnellDatum K G U) {H₀ H : Subgroup G} (hH₀ : H₀ ≤ H)
    (hN : (H₀.subgroupOf H).Normal) (hfin : (H₀.subgroupOf H).FiniteIndex)
    (htf : IsMulTorsionFree H₀) (y : U) (hy : y ∈ L.D H) :
    ∃ c : (H ⧸ H₀.subgroupOf H) →₀ ↥(L.D H₀),
      y = c.sum (fun q d => (d : U) * (L.gen ((Quotient.out q : H) : G) : U)) :=
  FiniteIndex.span_D_of_finiteIndex L hH₀ hN hfin
    (fun x hx => L.division_of_torsionFree H₀ htf x hx) y hy

/-- **L1(1)**, closure form: `D H` is generated as a ring by `D H₀` and a transversal of `H₀`
in `H`, when `H₀ ≤ H` is normal of finite index and torsion free. -/
theorem D_eq_closure_of_torsionFree (L : LinnellDatum K G U) {H₀ H : Subgroup G}
    (hH₀ : H₀ ≤ H) (hN : (H₀.subgroupOf H).Normal) (hfin : (H₀.subgroupOf H).FiniteIndex)
    (htf : IsMulTorsionFree H₀) :
    L.D H = Subring.closure (((L.D H₀ : Subring U) : Set U) ∪
      Set.range (fun q : H ⧸ H₀.subgroupOf H => (L.gen ((Quotient.out q : H) : G) : U))) := by
  refine le_antisymm ?_ ?_
  · intro y hy
    obtain ⟨c, hc⟩ := span_D_of_torsionFree L hH₀ hN hfin htf y hy
    rw [hc, Finsupp.sum]
    refine Subring.sum_mem _ fun q _ => ?_
    exact Subring.mul_mem _ (Subring.subset_closure (Set.mem_union_left _ (c q).2))
      (Subring.subset_closure (Set.mem_union_right _ ⟨q, rfl⟩))
  · rw [Subring.closure_le]
    rintro x (hx | hx)
    · exact L.D_mono hH₀ hx
    · obtain ⟨q, rfl⟩ := hx
      exact L.gen_mem H (Quotient.out q)

/-- **L1(2)**, torsion free form: `D H` is a semisimple ring, for `H₀ ≤ H` normal of finite
index and torsion free (characteristic zero). -/
theorem isSemisimpleRing_D_of_torsionFree [CharZero K] (L : LinnellDatum K G U)
    {H₀ H : Subgroup G} (hH₀ : H₀ ≤ H) (hN : (H₀.subgroupOf H).Normal)
    (hfin : (H₀.subgroupOf H).FiniteIndex) (htf : IsMulTorsionFree H₀) :
    IsSemisimpleRing ↥(L.D H) :=
  Cosets.isSemisimpleRing_D_of_finiteIndex L hH₀ hN hfin htf
    (fun y hy => span_D_of_torsionFree L hH₀ hN hfin htf y hy)

/-- **`S = D(G)` is semisimple**, for a normal torsion free finite index subgroup `G' ⊴ G`. -/
theorem isSemisimpleRing_S [CharZero K] (L : LinnellDatum K G U) (G' : Subgroup G)
    (hG'n : G'.Normal) (htf : IsMulTorsionFree G') (hfin : G'.FiniteIndex) :
    IsSemisimpleRing ↥(L.S) :=
  Cosets.isSemisimpleRing_D L G' hG'n htf hfin ⊤

end Work.ORLinnell
