import Mathlib
import Submission.Work.ORLinnell.Linnell
import Submission.Work.ORLinnell.Laurent.Defs

/-!
# The Laurent decomposition of the subring generated by `D N` and `H`

Let `N ≤ H ≤ G` with `N` normal in `H`, let `L : LinnellDatum K G U`, and let `s : H` be an
element whose powers `s ^ j` (up to `N`) exhaust `H/N`.  In this file we prove that every element
`t` of the subring of `U` generated by `D N` and the image of `H` has a *unique* expansion

`t = Σ_j d_j s ^ j`,  `d_j ∈ D N`,  finitely many `d_j ≠ 0`,

i.e. that `laurentSum L s : (ℤ →₀ D N) → U` is a bijection onto that subring.

* Uniqueness is Linnell independence (axiom I1) applied to the powers of `s`, which are pairwise
  distinct modulo `N` (`sPow_mem_subgroupOf`).
* Existence is the statement that the image of `laurentSum` is a subring, the key step being
  multiplicativity (`laurentSum_mul`), which uses the normality of `N` in `H` to conjugate
  coefficients back into `D N`.
-/

namespace Work.ORLinnell.Laurent

set_option linter.unnecessarySimpa false

open Work.ORLinnell

variable {K : Type*} [Field K] {G : Type*} [Group G] {U : Type*} [Ring U] [Nontrivial U]
  [Algebra K U]

section Basic

variable {N H : Subgroup G} {s : H} {L : LinnellDatum K G U}

/-- `s` has infinite order modulo `N`: no nontrivial power of `s` lies in `N`. -/
theorem sPow_mem_subgroupOf (hφ : IsExtensionByZ N H) (s : H)
    (hs : ∀ h : H, ∃ j : ℤ, h * s ^ (-j) ∈ N.subgroupOf H) :
    ∀ k : ℤ, s ^ k ∈ N.subgroupOf H → k = 0 := by
  obtain ⟨φ, hsurj, hker⟩ := hφ
  have hmem : ∀ x : H, x ∈ N.subgroupOf H ↔ φ x = 1 := by
    intro x
    rw [← hker]
    exact MonoidHom.mem_ker
  have hgen : Multiplicative.toAdd (φ s) ≠ 0 := by
    obtain ⟨h₀, hh₀⟩ := hsurj (Multiplicative.ofAdd (1 : ℤ))
    obtain ⟨j, hj⟩ := hs h₀
    have hj1 : φ (h₀ * s ^ (-j)) = 1 := (hmem _).mp hj
    rw [map_mul, map_zpow, hh₀] at hj1
    have h2 : (1 : ℤ) + (-j) * Multiplicative.toAdd (φ s) = 0 := by
      have hh := congrArg Multiplicative.toAdd hj1
      simpa using hh
    intro hzero
    simpa [hzero] using h2
  intro k hk
  have hk1 : φ (s ^ k) = 1 := (hmem _).mp hk
  have h2 : k * Multiplicative.toAdd (φ s) = 0 := by
    have hh := congrArg Multiplicative.toAdd hk1
    rw [map_zpow] at hh
    simpa using hh
  exact (mul_eq_zero.mp h2).resolve_right hgen

/-- Uniqueness of the Laurent expansion: `laurentSum L s` is injective on coefficients, provided
the powers of `s` are pairwise distinct modulo `N`. -/
theorem laurentSum_unique (L : LinnellDatum K G U) {N H : Subgroup G} (s : H)
    (hs0 : ∀ k : ℤ, s ^ k ∈ N.subgroupOf H → k = 0)
    (c c' : ℤ →₀ ↥(L.D N))
    (h : laurentSum L s c = laurentSum L s c') : c = c' := by
  classical
  set d : ℤ →₀ ↥(L.D N) := c - c' with hd
  have hd0 : laurentSum L s d = 0 := by
    rw [hd, laurentSum_sub, h, sub_self]
  have hsum : ∑ j ∈ d.support, (d j : U) * (L.gen ((s ^ j : H) : G) : U) = 0 := by
    have h1 := hd0
    rw [laurentSum, Finsupp.sum_of_support_subset d (Finset.Subset.refl _)
        (fun j d => (d : U) * laurentBasis L s j) (by intro i _; simp)] at h1
    simpa only [laurentBasis] using h1
  set e : ↥d.support ≃ Fin d.support.card := Finset.equivFin d.support
  have hfin : ∑ x : ↥d.support, (d (x : ℤ) : U) * (L.gen ((s ^ (x : ℤ) : H) : G) : U)
      = ∑ i : Fin d.support.card,
          (d ((e.symm i).1) : U) * (L.gen ((s ^ ((e.symm i).1) : H) : G) : U) :=
    Fintype.sum_equiv e _ _ (by intro x; simp)
  have hsub : ∑ j ∈ d.support, (d j : U) * (L.gen ((s ^ j : H) : G) : U)
      = ∑ x : ↥d.support, (d (x : ℤ) : U) * (L.gen ((s ^ (x : ℤ) : H) : G) : U) :=
    Finset.sum_subtype d.support (fun x => Iff.rfl)
      (fun j : ℤ => (d j : U) * (L.gen ((s ^ j : H) : G) : U))
  have hsum' : ∑ i : Fin d.support.card,
      (d ((e.symm i).1) : U) * (L.gen ((s ^ ((e.symm i).1) : H) : G) : U) = 0 := by
    rw [← hfin, ← hsub]
    exact hsum
  have hcoset : ∀ i j : Fin d.support.card,
      (((s ^ ((e.symm i).1) : H) : G) * (((s ^ ((e.symm j).1) : H) : G))⁻¹ ∈ N → i = j) := by
    intro i j hij
    have key : ((s ^ ((e.symm i).1) : H) : G) * (((s ^ ((e.symm j).1) : H) : G))⁻¹
        = ((s ^ ((e.symm i).1 - (e.symm j).1) : H) : G) := by
      rw [zpow_sub]
      simp
    have h1 : s ^ ((e.symm i).1 - (e.symm j).1) ∈ N.subgroupOf H := by
      rw [Subgroup.mem_subgroupOf, ← key]
      exact hij
    have h2 := hs0 _ h1
    exact e.symm.injective (Subtype.ext (sub_eq_zero.mp h2))
  have hind := L.independence N d.support.card
    (fun i : Fin d.support.card => ((s ^ ((e.symm i).1) : H) : G)) hcoset
    (fun i : Fin d.support.card => (d ((e.symm i).1) : U))
    (fun i => (d ((e.symm i).1)).2) hsum'
  have hdz : d = 0 := by
    refine Finsupp.ext (fun j => ?_)
    by_cases hj : j ∈ d.support
    · have h3 : d ((e.symm (e ⟨j, hj⟩)).1) = 0 := Subtype.ext (hind (e ⟨j, hj⟩))
      rwa [show (e.symm (e ⟨j, hj⟩)).1 = j from by simp] at h3
    · by_contra hne
      exact hj ((Finsupp.mem_support_iff).mpr hne)
  rw [hd] at hdz
  exact sub_eq_zero.mp hdz

/-- Multiplicativity of the Laurent expansion: the product of two Laurent sums is again a Laurent
sum.  The coefficient of `s ^ (j + i)` in the product is `c_j τ_j(c'_i)`, where `τ_j` is the
conjugation by `s ^ j`, which preserves `D N` by normality of `N` in `H`. -/
theorem laurentSum_mul (L : LinnellDatum K G U) {N H : Subgroup G} (hH : N ≤ H)
    (hN : (N.subgroupOf H).Normal) (s : H) (c c' : ℤ →₀ ↥(L.D N)) :
    ∃ c₃ : ℤ →₀ ↥(L.D N), laurentSum L s c₃ = laurentSum L s c * laurentSum L s c' := by
  classical
  have hex : ∀ j i : ℤ, ∃ e : ↥(L.D N),
      (e : U) = laurentBasis L s j * (c' i : U) * laurentBasis L s (-j) :=
    fun j i => ⟨⟨_, laurentBasis_conj_mem (L := L) (H := H) (s := s) hH hN j (c' i)⟩, rfl⟩
  choose Kf hKf using hex
  refine ⟨∑ j ∈ c.support, ∑ i ∈ c'.support, Finsupp.single (j + i) (c j * Kf j i), ?_⟩
  have hleft : (∑ j ∈ c.support, ∑ i ∈ c'.support, Finsupp.single (j + i) (c j * Kf j i)).sum
        (fun j d => (d : U) * laurentBasis L s j)
      = ∑ j ∈ c.support, ∑ i ∈ c'.support,
          ((c j * Kf j i : ↥(L.D N)) : U) * laurentBasis L s (j + i) := by
    rw [← Finsupp.sum_finsetSum_index (by intro a; simp) (by intro a b₁ b₂; simp [add_mul])]
    apply Finset.sum_congr rfl
    intro j hj
    rw [← Finsupp.sum_finsetSum_index (by intro a; simp) (by intro a b₁ b₂; simp [add_mul])]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finsupp.sum_single_index (by simp)]
  have hright : laurentSum L s c * laurentSum L s c'
      = ∑ j ∈ c.support, ∑ i ∈ c'.support,
          ((c j : U) * laurentBasis L s j) * ((c' i : U) * laurentBasis L s i) := by
    rw [laurentSum, laurentSum]
    rw [Finsupp.sum_of_support_subset c (Finset.Subset.refl _)
          (fun j d => (d : U) * laurentBasis L s j) (by intro i _; simp),
        Finsupp.sum_of_support_subset c' (Finset.Subset.refl _)
          (fun j d => (d : U) * laurentBasis L s j) (by intro i _; simp)]
    rw [Finset.sum_mul_sum]
  have hkey : ∀ j i : ℤ, ((c j * Kf j i : ↥(L.D N)) : U) * laurentBasis L s (j + i)
      = ((c j : U) * laurentBasis L s j) * ((c' i : U) * laurentBasis L s i) := by
    intro j i
    have hcoe : ((c j * Kf j i : ↥(L.D N)) : U)
        = (c j : U) * (laurentBasis L s j * (c' i : U) * laurentBasis L s (-j)) := by
      rw [Subring.coe_mul, hKf j i]
    rw [hcoe, laurentBasis_add]
    rw [show (c j : U) * (laurentBasis L s j * (c' i : U) * laurentBasis L s (-j))
          * (laurentBasis L s j * laurentBasis L s i)
        = (c j : U) * ((laurentBasis L s j * (c' i : U))
            * ((laurentBasis L s (-j) * laurentBasis L s j) * laurentBasis L s i)) by
      noncomm_ring]
    rw [laurentBasis_neg_mul, one_mul]
    noncomm_ring
  rw [hright, laurentSum, hleft]
  exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => hkey j i))

/-- Existence of the Laurent expansion for all elements of the subring generated by `D N` and
the image of `H`. -/
theorem laurentSum_exists (L : LinnellDatum K G U) {N H : Subgroup G} (hH : N ≤ H)
    (hN : (N.subgroupOf H).Normal) (s : H)
    (hs : ∀ h : H, ∃ j : ℤ, h * s ^ (-j) ∈ N.subgroupOf H) :
    ∀ t ∈ Subring.closure ((L.D N : Set U) ∪ Set.range (fun h : H => (L.gen (h : G) : U))),
      ∃ c : ℤ →₀ ↥(L.D N), laurentSum L s c = t := by
  intro t ht
  refine Subring.closure_induction (p := fun x _ => ∃ c : ℤ →₀ ↥(L.D N), laurentSum L s c = x)
    ?_ ?_ ?_ ?_ ?_ ?_ ht
  · rintro x hx
    rw [Set.mem_union] at hx
    rcases hx with hx | hx
    · exact laurentSum_of_mem hx
    · rw [Set.mem_range] at hx
      obtain ⟨g, rfl⟩ := hx
      exact laurentSum_gen hs g
  · exact ⟨0, laurentSum_zero⟩
  · exact ⟨Finsupp.single 0 1,
      by rw [laurentSum_single, laurentBasis_zero, mul_one, Subring.coe_one]⟩
  · rintro x y hx hy ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨a + b, by rw [laurentSum_add, ha, hb]⟩
  · rintro x hx ⟨a, ha⟩
    exact ⟨-a, by rw [laurentSum_neg, ha]⟩
  · rintro x y hx hy ⟨a, ha⟩ ⟨b, hb⟩
    obtain ⟨c₃, hc₃⟩ := laurentSum_mul L hH hN s a b
    exact ⟨c₃, by rw [hc₃, ha, hb]⟩

end Basic

theorem existsUnique_laurent_rep {K : Type*} [Field K] {G : Type*} [Group G] {U : Type*} [Ring U]
    [Nontrivial U] [Algebra K U] (L : Work.ORLinnell.LinnellDatum K G U) {N H : Subgroup G}
    (hH : N ≤ H) (hN : (N.subgroupOf H).Normal) (hφ : Work.ORLinnell.IsExtensionByZ N H) (s : H)
    (hs : ∀ h : H, ∃ j : ℤ, h * s ^ (-j) ∈ N.subgroupOf H) :
    ∀ t ∈ Subring.closure ((L.D N : Set U) ∪ Set.range (fun h : H => (L.gen (h : G) : U))),
      ∃! c : ℤ →₀ ↥(L.D N), t = c.sum (fun j d => (d : U) * (L.gen ((s ^ j : H) : G) : U)) := by
  classical
  have hs0 : ∀ k : ℤ, s ^ k ∈ N.subgroupOf H → k = 0 := sPow_mem_subgroupOf hφ s hs
  have hex := laurentSum_exists L hH hN s hs
  intro t ht
  obtain ⟨c, hc⟩ := hex t ht
  refine ⟨c, ?_, ?_⟩
  · rw [← hc, laurentSum_eq]
  · intro c' hc'
    refine laurentSum_unique L s hs0 c' c ?_
    have h1 : c'.sum (fun j d => (d : U) * (L.gen ((s ^ j : H) : G) : U)) = t := hc'.symm
    have h2 : c.sum (fun j d => (d : U) * (L.gen ((s ^ j : H) : G) : U)) = t := by
      simpa only [laurentSum_eq] using hc
    rw [laurentSum_eq, laurentSum_eq, h1, h2]

end Work.ORLinnell.Laurent
