/-!
# The Linnell datum attached to a group and a field

Following Jaikin-Zapirain--Linton, *On the coherence of one-relator groups and their group
algebras* (Annals 2025), §2.3, and the node design of the torsion case (`N8_TORSION_LEAD.md`),
we package the data provided by the analytic construction of `U(G)` (node N5) and the
Hughes-free division rings (node N6) into a single structure.

For a group `G`, a field `K` and an ambient ring `U` (the ring of affiliated operators
`U(G)`, a `K`-algebra), a `LinnellDatum K G U` consists of

* a monoid homomorphism `gen : G →* Uˣ` (the image of `K[G] ⊆ U`), injective;
* for each subgroup `H ≤ G`, the *division closure* `D H` of `K[H]` in `U` (the smallest
  subring containing the image of `H` and of `K`, closed under inverses in `U`);

subject to the following inputs, which are established in other nodes of the project:

* **(I1) Linnell independence** (`independence`): elements of `U` whose group parts lie in
  distinct right `H`-cosets are linearly independent over `D H`;
* **(I2) conjugation** (`conjugation`): conjugation by a group element maps `D H` to
  `D (gHg⁻¹)`;
* **(I4) Hughes-free division rings** (`division_of_torsionFree`): for torsion free `H`, `D H`
  is a division ring;
* **(I4') the Ore field of fractions** (`ore_field`): if `N ≤ Γ` with `Γ` torsion free and
  `Γ/N ≅ ℤ`, then every nonzero element of the subring generated by `D N` and `Γ` is a unit of
  `D Γ`.

The main results of this area (the finite index crossed product `D H = ⊕ D H₀ xᵢ` and its
semisimplicity, and the Laurent decomposition of `Σ_{h ∈ H} D N · h`) are proved in
`Submission.Work.ORLinnell.FiniteIndex` and `Submission.Work.ORLinnell.Laurent`.
-/

namespace Work.ORLinnell

variable {G : Type*} [Group G]

/-- `H` is an extension of `N` by `ℤ`: the quotient `H/N` is infinite cyclic. -/
def IsExtensionByZ (N H : Subgroup G) : Prop :=
  ∃ φ : H →* Multiplicative ℤ, Function.Surjective φ ∧ φ.ker = N.subgroupOf H

/-- The Linnell datum for a group `G`, a field `K` of characteristic zero, and the ring of
affiliated operators `U = U(G)`: the ambient `K`-algebra together with all division closures
`D H` of `K[H]`.  This is the input to all the purely ring theoretic arguments of the torsion
case of the coherence theorem. -/
structure LinnellDatum (K : Type*) [Field K] (G : Type*) [Group G] (U : Type*) [Ring U]
    [Nontrivial U] [Algebra K U] where
  /-- the canonical map `G → Uˣ` (the image of `K[G] ⊆ U`). -/
  gen : G →* Uˣ
  gen_injective : Function.Injective gen
  /-- the division closure of `K[H]` in `U`. -/
  D : Subgroup G → Subring U
  /-- `D H` contains the image of `H`. -/
  gen_mem : ∀ (H : Subgroup G) (h : H), (gen (h : G) : U) ∈ D H
  /-- `D H` contains the scalars. -/
  algebraMap_mem : ∀ (H : Subgroup G) (k : K), algebraMap K U k ∈ D H
  /-- `D H` is division closed in `U`. -/
  isDivisionClosed : ∀ H : Subgroup G, IsDivisionClosed (D H)
  /-- `D H` is the *smallest* division closed subring containing `K[H]`. -/
  minimal : ∀ (H : Subgroup G) (A : Subring U),
    (∀ h : H, (gen (h : G) : U) ∈ A) → (∀ k : K, algebraMap K U k ∈ A) →
      IsDivisionClosed A → D H ≤ A
  /-- **(I1) Linnell independence**: elements of `U` whose group parts lie in distinct right
  cosets of `H` are linearly independent over `D H`, coefficients on the left. -/
  independence : ∀ (H : Subgroup G) (n : ℕ) (g : Fin n → G),
    (∀ i j, (g i) * (g j)⁻¹ ∈ H → i = j) →
      ∀ a : Fin n → U, (∀ i, a i ∈ D H) →
        (∑ i, a i * (gen (g i) : U)) = 0 → ∀ i, a i = 0
  /-- **(I1') the mirror of (I1)**: elements of `U` whose group parts lie in distinct left
  cosets of `H` are linearly independent over `D H`, coefficients on the right. -/
  independence' : ∀ (H : Subgroup G) (n : ℕ) (g : Fin n → G),
    (∀ i j, (g i)⁻¹ * (g j) ∈ H → i = j) →
      ∀ a : Fin n → U, (∀ i, a i ∈ D H) →
        (∑ i, (gen (g i) : U) * a i) = 0 → ∀ i, a i = 0
  /-- **(I2) conjugation**. -/
  conjugation : ∀ (g : G) (H : Subgroup G) (x : U), x ∈ D H →
    (gen g : U) * x * ↑((gen g)⁻¹) ∈ D (H.map (MulAut.conj g))
  /-- **(I4)**: `D H` is a division ring when `H` is torsion free. -/
  division_of_torsionFree : ∀ (H : Subgroup G), IsMulTorsionFree H →
    ∀ x : ↥(D H), x ≠ 0 → IsUnit x
  /-- **(I4'a)**: for `N ≤ Γ` with `Γ` torsion free and `Γ/N ≅ ℤ`, every nonzero element of
  the subring generated by `D N` and `Γ` is a unit of `D Γ` (this is the torsion free part of
  the Ore field of fractions statement). -/
  ore_field_unit : ∀ (N Γ : Subgroup G), N ≤ Γ → IsMulTorsionFree Γ → IsExtensionByZ N Γ →
    ∀ t ∈ Subring.closure (((D N : Subring U) : Set U) ∪
        Set.range (fun γ : Γ => (gen (γ : G) : U))),
      t ≠ 0 → ∃ u ∈ (D Γ : Set U), u * t = 1 ∧ t * u = 1
  /-- **(I4'b)**: every element of `D Γ` is a quotient `a * t⁻¹` of elements of the subring
  generated by `D N` and `Γ` (the Ore field of fractions statement). -/
  ore_field_frac : ∀ (N Γ : Subgroup G), N ≤ Γ → IsMulTorsionFree Γ → IsExtensionByZ N Γ →
    ∀ e ∈ (D Γ : Set U), ∃ a ∈ Subring.closure (((D N : Subring U) : Set U) ∪
        Set.range (fun γ : Γ => (gen (γ : G) : U))),
      ∃ t ∈ Subring.closure (((D N : Subring U) : Set U) ∪
        Set.range (fun γ : Γ => (gen (γ : G) : U))), t ≠ 0 ∧ e * t = a

namespace LinnellDatum

variable {K : Type*} [Field K] {G : Type*} [Group G] {U : Type*} [Ring U] [Nontrivial U]
  [Algebra K U] (L : LinnellDatum K G U)

/-- `S = D(G)`: the division closure of `K[G]` in `U(G)`. -/
abbrev S : Subring U := L.D ⊤

/-- `D` is monotone in the subgroup. -/
theorem D_mono {H₁ H₂ : Subgroup G} (h : H₁ ≤ H₂) : L.D H₁ ≤ L.D H₂ :=
  L.minimal H₁ (L.D H₂) (fun x => L.gen_mem H₂ ⟨(x : G), h x.2⟩)
    (fun k => L.algebraMap_mem H₂ k) (L.isDivisionClosed H₂)

theorem D_le_S (H : Subgroup G) : L.D H ≤ L.S :=
  L.D_mono (le_top)

/-- The universal property of the division closure `D H`. -/
theorem D_le_iff {H : Subgroup G} {A : Subring U} (hA : IsDivisionClosed A) :
    L.D H ≤ A ↔ ((∀ h : H, (L.gen (h : G) : U) ∈ A) ∧ (∀ k : K, algebraMap K U k ∈ A)) :=
  ⟨fun h => ⟨fun x => h (L.gen_mem H x), fun k => h (L.algebraMap_mem H k)⟩,
    fun h => L.minimal H A h.1 h.2 hA⟩

/-- `S` is the division closure of `K[G]`. -/
theorem S_le_iff {A : Subring U} (hA : IsDivisionClosed A) :
    L.S ≤ A ↔ ((∀ g : G, (L.gen g : U) ∈ A) ∧ (∀ k : K, algebraMap K U k ∈ A)) := by
  rw [S, L.D_le_iff hA]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨fun g => h1 ⟨g, trivial⟩, h2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨fun g => h1 g.1, h2⟩

/-- A positive natural number is a unit of `U`, with inverse in every division closure. -/
theorem exists_inv_natCast_mem [CharZero K] (H : Subgroup G) (n : ℕ) (hn : n ≠ 0) :
    ∃ u ∈ L.D H, u * algebraMap K U (n : K) = 1 ∧ algebraMap K U (n : K) * u = 1 := by
  have hne : (n : K) ≠ 0 := Nat.cast_ne_zero.mpr hn
  refine ⟨algebraMap K U ((n : K)⁻¹), L.algebraMap_mem H _, ?_, ?_⟩
  · rw [← map_mul, inv_mul_cancel₀ hne, map_one]
  · rw [← map_mul, mul_inv_cancel₀ hne, map_one]

/-- For a torsion free subgroup, `D H` is a division ring, as an explicit instance.  Use
`letI := L.divisionRingOfTorsionFree hH` inside a proof. -/
noncomputable def divisionRingOfTorsionFree {H : Subgroup G} (hH : IsMulTorsionFree H) :
    DivisionRing ↥(L.D H) :=
  DivisionRing.ofIsUnitOrEqZero fun x => by
    rcases eq_or_ne x 0 with h | h
    · exact Or.inr h
    · exact Or.inl (L.division_of_torsionFree H hH x h)

/-- For a torsion free subgroup, `D H` is a division ring. -/
theorem isUnit_of_torsionFree {H : Subgroup G} (hH : IsMulTorsionFree H) {x : ↥(L.D H)}
    (hx : x ≠ 0) : IsUnit x :=
  L.division_of_torsionFree H hH x hx

/-- If `H₀ ≤ H` is normal in `H` and `g ∈ H`, then `g H₀ g⁻¹ = H₀`. -/
theorem map_conj_eq_of_normal {H₀ H : Subgroup G} (hH₀ : H₀ ≤ H)
    (hN : (H₀.subgroupOf H).Normal) (g : H) : H₀.map (MulAut.conj (g : G)) = H₀ := by
  have hcomp : (MulAut.conj (g : G) : G →* G).comp H.subtype
      = H.subtype.comp (MulAut.conj g : H →* H) := by
    ext z
    simp [MulAut.conj_apply]
  have hmapp : (H₀.subgroupOf H).map (MulAut.conj g) = H₀.subgroupOf H :=
    (Subgroup.normal_iff_map_conj_eq (H := H₀.subgroupOf H)).mp hN g
  calc H₀.map (MulAut.conj (g : G))
      = ((H₀.subgroupOf H).map H.subtype).map (MulAut.conj (g : G)) := by
        rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hH₀]
    _ = (H₀.subgroupOf H).map ((MulAut.conj (g : G) : G →* G).comp H.subtype) := by
        rw [Subgroup.map_map]
    _ = (H₀.subgroupOf H).map (H.subtype.comp (MulAut.conj g : H →* H)) := by rw [hcomp]
    _ = ((H₀.subgroupOf H).map (MulAut.conj g)).map H.subtype := by rw [Subgroup.map_map]
    _ = (H₀.subgroupOf H).map H.subtype := by rw [hmapp]
    _ = H₀ := by rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hH₀]

/-- Conjugation by an element of `H` preserves `D H₀` when `H₀ ≤ H` is normal in `H`. -/
theorem conj_mem {H₀ H : Subgroup G} (hH₀ : H₀ ≤ H) (hN : (H₀.subgroupOf H).Normal) (g : H)
    (x : U) (hx : x ∈ L.D H₀) :
    (L.gen (g : G) : U) * x * ↑((L.gen (g : G))⁻¹) ∈ L.D H₀ := by
  rw [← map_conj_eq_of_normal hH₀ hN g]
  exact L.conjugation (g : G) H₀ x hx

end LinnellDatum

/-- A subgroup of a torsion free group is torsion free. -/
theorem isMulTorsionFree_subtype {G : Type*} [Group G] [IsMulTorsionFree G] (H : Subgroup G) :
    IsMulTorsionFree H :=
  ⟨fun n hn a b hab =>
    Subtype.ext (IsMulTorsionFree.pow_left_injective (M := G) hn (by
      have h := congrArg (fun x : H => (x : G)) hab
      simpa [Subgroup.coe_pow] using h))⟩

/-- An intersection with a torsion free subgroup is torsion free. -/
theorem isMulTorsionFree_inf {G : Type*} [Group G] {G' : Subgroup G} (htf : IsMulTorsionFree G')
    (H : Subgroup G) : IsMulTorsionFree ↥(H ⊓ G') :=
  ⟨fun n hn a b hab => by
    have h : (⟨(a : G), a.2.2⟩ : G') ^ n = (⟨(b : G), b.2.2⟩ : G') ^ n := by
      have h' := congrArg (fun x : ↥(H ⊓ G') => (⟨(x : G), x.2.2⟩ : G')) hab
      simpa using h'
    exact Subtype.ext (congrArg (fun x : G' => (x : G)) (htf.pow_left_injective hn h))⟩

/-- An extension by `ℤ` has a generator `s` whose powers meet every coset: this is the element
used in the Laurent decomposition of `Σ_{h ∈ H} D N · h`. -/
theorem IsExtensionByZ.exists_generator {N H : Subgroup G} (hφ : IsExtensionByZ N H) :
    ∃ s : H, ∀ h : H, ∃ j : ℤ, h * s ^ (-j) ∈ N.subgroupOf H := by
  obtain ⟨φ, hsurj, hker⟩ := hφ
  obtain ⟨s, hs⟩ := hsurj (Multiplicative.ofAdd (1 : ℤ))
  refine ⟨s, fun h => ?_⟩
  set k : ℤ := Multiplicative.toAdd (φ h) with hk
  refine ⟨k, ?_⟩
  have hk' : φ h = Multiplicative.ofAdd k := by rw [hk, ofAdd_toAdd]
  have hpow : (Multiplicative.ofAdd (1 : ℤ) : Multiplicative ℤ) ^ (-k) = Multiplicative.ofAdd (-k) := by
    rw [← ofAdd_zsmul (-k) (1 : ℤ)]
    simp
  rw [← hker, MonoidHom.mem_ker, map_mul, hk',
    show φ (s ^ (-k)) = (Multiplicative.ofAdd (1 : ℤ) : Multiplicative ℤ) ^ (-k) by
      rw [map_zpow, hs],
    hpow, ← ofAdd_add, add_neg_cancel, ofAdd_zero]

/-- The canonical `Module` structure on `↥B` over a subring `A ≤ B` of a ring `U`, given by
left multiplication.  Kept as an explicit definition (not an instance) so as to avoid instance
diamonds; use `letI := moduleOfLe h` inside a proof. -/
@[instance_reducible]
noncomputable def moduleOfLe {U : Type*} [Ring U] {A B : Subring U} (h : A ≤ B) :
    Module ↥A ↥B :=
  Module.compHom ↥B (Subring.inclusion h)

end Work.ORLinnell
