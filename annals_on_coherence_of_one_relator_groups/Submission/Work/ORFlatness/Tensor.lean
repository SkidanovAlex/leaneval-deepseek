/-
# The balanced tensor product of a right module and a left module over a ring

Mathlib has the tensor product `M ⊗[R] N` of two modules over a *commutative* ring.
The formalisation of Jaikin-Zapirain--Linton needs the tensor product `X ⊗[R] N` of a
*right* `R`-module `X` and a *left* `R`-module `N` over an arbitrary ring `R`, together
with its functoriality and right exactness; this is the substrate on which the
noncommutative Tor functors and the notion of flatness for group algebras rest.

We build it as the quotient of the abelian-group tensor product `X ⊗[ℤ] N` by the
subgroup generated by the balancing relations `(x·r) ⊗ n - x ⊗ (r·n)`.
-/
import Mathlib

set_option autoImplicit false
set_option maxHeartbeats 1000000

open TensorProduct MulOpposite

universe u

namespace Work.ORFlatness

variable (R : Type u) [Ring R]

/-- The ℤ-submodule of `X ⊗[ℤ] N` generated by the balancing relations
`(x·r) ⊗ n - x ⊗ (r·n)`, for `X` a right `R`-module and `N` a left `R`-module. -/
def balRel (X : Type u) [AddCommGroup X] [Module Rᵐᵒᵖ X]
    (N : Type u) [AddCommGroup N] [Module R N] : Submodule ℤ (X ⊗[ℤ] N) :=
  Submodule.span ℤ (Set.range fun p : X × N × R =>
    (op p.2.2 • p.1) ⊗ₜ[ℤ] p.2.1 - p.1 ⊗ₜ[ℤ] (p.2.2 • p.2.1))

theorem balRel_le_iff (X : Type u) [AddCommGroup X] [Module Rᵐᵒᵖ X]
    (N : Type u) [AddCommGroup N] [Module R N] (p : Submodule ℤ (X ⊗[ℤ] N)) :
    balRel R X N ≤ p ↔ ∀ (x : X) (n : N) (r : R),
      (op r • x) ⊗ₜ[ℤ] n - x ⊗ₜ[ℤ] (r • n) ∈ p := by
  constructor
  · intro h x n r
    exact h (Submodule.subset_span ⟨(x, n, r), rfl⟩)
  · intro h
    rw [balRel, Submodule.span_le]
    rintro z ⟨⟨x, n, r⟩, rfl⟩
    exact h x n r

/-- The balanced tensor product `X ⊗[R] N` of a right `R`-module `X` and a left
`R`-module `N`, as the quotient of `X ⊗[ℤ] N` by the balancing relations. -/
abbrev BalTensor (X : Type u) [AddCommGroup X] [Module Rᵐᵒᵖ X]
    (N : Type u) [AddCommGroup N] [Module R N] : Type u :=
  (X ⊗[ℤ] N) ⧸ (balRel R X N).toAddSubgroup

namespace BalTensor

variable {X : Type u} [AddCommGroup X] [Module Rᵐᵒᵖ X]
variable {N : Type u} [AddCommGroup N] [Module R N]

/-- The class of `x ⊗ n` in `X ⊗[R] N`. -/
def mk (x : X) (n : N) : BalTensor R X N := QuotientAddGroup.mk (x ⊗ₜ[ℤ] n)

theorem mk_eq (x : X) (n : N) : mk R x n = QuotientAddGroup.mk (x ⊗ₜ[ℤ] n) := rfl

@[simp] theorem mk_zero_left (n : N) : mk R (0 : X) n = 0 := by
  rw [mk, zero_tmul, QuotientAddGroup.mk_zero]

@[simp] theorem mk_zero_right (x : X) : mk R x (0 : N) = 0 := by
  rw [mk, tmul_zero, QuotientAddGroup.mk_zero]

theorem mk_add_left (x x' : X) (n : N) : mk R (x + x') n = mk R x n + mk R x' n := by
  rw [mk, mk, mk, add_tmul, QuotientAddGroup.mk_add]

theorem mk_add_right (x : X) (n n' : N) : mk R x (n + n') = mk R x n + mk R x n' := by
  rw [mk, mk, mk, tmul_add, QuotientAddGroup.mk_add]

/-- The defining relation of the balanced tensor product. -/
@[simp] theorem mk_smul_right (x : X) (n : N) (r : R) :
    mk R (op r • x) n = mk R x (r • n) := by
  rw [mk, mk, QuotientAddGroup.eq_iff_sub_mem]
  exact (Submodule.mem_toAddSubgroup (balRel R X N)).mpr
    (Submodule.subset_span ⟨(x, n, r), rfl⟩)

/-- `mk` is additive in its first variable. -/
def mkLeft (n : N) : X →+ BalTensor R X N :=
  AddMonoidHom.mk' (fun x => mk R x n) (fun a b => mk_add_left R a b n)

/-- `mk` is additive in its second variable. -/
def mkRight (x : X) : N →+ BalTensor R X N :=
  AddMonoidHom.mk' (fun n => mk R x n) (fun a b => mk_add_right R x a b)

theorem mk_zsmul_left (z : ℤ) (x : X) (n : N) : mk R (z • x) n = z • mk R x n :=
  (mkLeft R n).map_zsmul z x

theorem mk_zsmul_right (z : ℤ) (x : X) (n : N) : mk R x (z • n) = z • mk R x n :=
  (mkRight R x).map_zsmul z n

/-- Every element of the balanced tensor product lies in the additive subgroup
generated by the pure tensors. -/
theorem mem_closure_mk (z : BalTensor R X N) :
    z ∈ AddSubgroup.closure (Set.range fun p : X × N => mk R p.1 p.2) := by
  refine QuotientAddGroup.induction_on z ?_
  intro m
  induction m using TensorProduct.induction_on with
  | zero => rw [QuotientAddGroup.mk_zero]; exact AddSubgroup.zero_mem _
  | tmul x n => exact AddSubgroup.subset_closure ⟨(x, n), rfl⟩
  | add a b ha hb => rw [QuotientAddGroup.mk_add]; exact AddSubgroup.add_mem _ ha hb

/-- The pure tensors additively generate the balanced tensor product. -/
theorem closure_range_mk_eq_top :
    AddSubgroup.closure (Set.range fun p : X × N => mk R p.1 p.2) = ⊤ := by
  rw [eq_top_iff]
  exact fun z _ => mem_closure_mk R z

/-- Two additive maps out of `X ⊗[R] N` agreeing on all `mk x n` are equal. -/
theorem ext {T : Type u} [AddCommGroup T] {f g : BalTensor R X N →+ T}
    (h : ∀ x n, f (mk R x n) = g (mk R x n)) : f = g := by
  have hker : (f - g).ker = ⊤ := by
    apply le_antisymm le_top
    rw [← closure_range_mk_eq_top R, AddSubgroup.closure_le]
    rintro y ⟨⟨x, n⟩, rfl⟩
    show f (mk R x n) - g (mk R x n) = 0
    rw [h x n, sub_self]
  refine AddMonoidHom.ext (fun z => ?_)
  have hz : z ∈ (f - g).ker := by rw [hker]; trivial
  simpa [sub_eq_zero] using hz

section Lift

variable {T : Type u} [AddCommGroup T]

/-- The ℤ-bilinear map `X × N → T` regarded as a map on the ℤ-tensor product. -/
def liftAdd (f : X →ₗ[ℤ] N →ₗ[ℤ] T) : (X ⊗[ℤ] N) →+ T :=
  (TensorProduct.lift f).toAddMonoidHom

@[simp] theorem liftAdd_tmul (f : X →ₗ[ℤ] N →ₗ[ℤ] T) (x : X) (n : N) :
    liftAdd f (x ⊗ₜ[ℤ] n) = f x n := by
  show (TensorProduct.lift f).toAddMonoidHom (x ⊗ₜ[ℤ] n) = f x n
  rw [LinearMap.toAddMonoidHom_coe, TensorProduct.lift.tmul]

/-- The balancing relations lie in the kernel of the induced map on the ℤ-tensor product. -/
theorem liftAux (f : X →ₗ[ℤ] N →ₗ[ℤ] T)
    (hbal : ∀ (x : X) (n : N) (r : R), f (op r • x) n = f x (r • n)) :
    (balRel R X N).toAddSubgroup ≤ (liftAdd f).ker :=
  fun y hy => by
    have hgen : ∀ z ∈ Set.range (fun p : X × N × R =>
        (op p.2.2 • p.1) ⊗ₜ[ℤ] p.2.1 - p.1 ⊗ₜ[ℤ] (p.2.2 • p.2.1)),
        liftAdd f z = 0 := by
      rintro z ⟨⟨x, n, r⟩, rfl⟩
      rw [map_sub, liftAdd_tmul, liftAdd_tmul, hbal x n r, sub_self]
    rw [Submodule.mem_toAddSubgroup] at hy
    rw [balRel] at hy
    exact Submodule.span_induction (p := fun z _ => liftAdd f z = 0) hgen
      (map_zero _) (fun a b _ _ ha hb => by rw [map_add, ha, hb, add_zero])
      (fun c a _ ha => by rw [map_zsmul, ha, smul_zero]) hy

/-- The universal property of the balanced tensor product. -/
def lift (f : X →ₗ[ℤ] N →ₗ[ℤ] T)
    (hbal : ∀ (x : X) (n : N) (r : R), f (op r • x) n = f x (r • n)) :
    BalTensor R X N →+ T :=
  QuotientAddGroup.lift (balRel R X N).toAddSubgroup (liftAdd f) (liftAux R f hbal)

@[simp] theorem lift_mk (f : X →ₗ[ℤ] N →ₗ[ℤ] T)
    (hbal : ∀ (x : X) (n : N) (r : R), f (op r • x) n = f x (r • n))
    (x : X) (n : N) : lift R f hbal (mk R x n) = f x n := by
  rw [mk, lift, QuotientAddGroup.lift_mk]
  exact liftAdd_tmul f x n

end Lift

section Map

variable {X' : Type u} [AddCommGroup X'] [Module Rᵐᵒᵖ X']
variable {N' : Type u} [AddCommGroup N'] [Module R N']

/-- The ℤ-bilinear map `(x, n) ↦ mk (f x) (g n)`. -/
def mapBilin (f : X →ₗ[Rᵐᵒᵖ] X') (g : N →ₗ[R] N') : X →ₗ[ℤ] N →ₗ[ℤ] BalTensor R X' N' :=
  { toFun := fun x =>
      { toFun := fun n => mk R (f x) (g n)
        map_add' := fun n n' => by rw [map_add, mk_add_right]
        map_smul' := fun z n => by
          show mk R (f x) (g (z • n)) = z • mk R (f x) (g n)
          rw [map_zsmul]
          exact mk_zsmul_right R z (f x) (g n) }
    map_add' := fun x x' => by
      ext n
      show mk R (f (x + x')) (g n) = mk R (f x) (g n) + mk R (f x') (g n)
      rw [map_add, mk_add_left]
    map_smul' := fun z x => by
      ext n
      show mk R (f (z • x)) (g n) = z • mk R (f x) (g n)
      rw [map_zsmul]
      exact mk_zsmul_left R z (f x) (g n) }

/-- A pair of linear maps induces a map of balanced tensor products. -/
def map (f : X →ₗ[Rᵐᵒᵖ] X') (g : N →ₗ[R] N') : BalTensor R X N →+ BalTensor R X' N' :=
  lift R (mapBilin R f g) (by
    intro x n r
    show mk R (f (op r • x)) (g n) = mk R (f x) (g (r • n))
    rw [map_smul, mk_smul_right, map_smul])

@[simp] theorem map_mk (f : X →ₗ[Rᵐᵒᵖ] X') (g : N →ₗ[R] N') (x : X) (n : N) :
    map R f g (mk R x n) = mk R (f x) (g n) := by
  rw [map, lift_mk]
  rfl

@[simp] theorem map_id :
    map R (LinearMap.id : X →ₗ[Rᵐᵒᵖ] X) (LinearMap.id : N →ₗ[R] N) = AddMonoidHom.id _ := by
  apply ext R
  intro x n
  simp only [map_mk, LinearMap.id_apply, AddMonoidHom.id_apply]

theorem map_comp {X'' : Type u} [AddCommGroup X''] [Module Rᵐᵒᵖ X'']
    {N'' : Type u} [AddCommGroup N''] [Module R N'']
    (f' : X' →ₗ[Rᵐᵒᵖ] X'') (g' : N' →ₗ[R] N'')
    (f : X →ₗ[Rᵐᵒᵖ] X') (g : N →ₗ[R] N') :
    map R (f'.comp f) (g'.comp g) = (map R f' g').comp (map R f g) := by
  apply ext R
  intro x n
  simp

theorem map_surjective (f : X →ₗ[Rᵐᵒᵖ] X') (g : N →ₗ[R] N')
    (hf : Function.Surjective f) (hg : Function.Surjective g) :
    Function.Surjective (map R f g) := by
  have h0 : ∀ y ∈ AddSubgroup.closure (Set.range fun p : X' × N' => mk R p.1 p.2),
      ∃ a, map R f g a = y := by
    intro y hy
    refine AddSubgroup.closure_induction (p := fun y _ => ∃ a, map R f g a = y) ?_ ?_ ?_ ?_ hy
    · rintro _ ⟨⟨x, n⟩, rfl⟩
      obtain ⟨x', rfl⟩ := hf x
      obtain ⟨n', rfl⟩ := hg n
      exact ⟨mk R x' n', by rw [map_mk]⟩
    · exact ⟨0, map_zero _⟩
    · intro a b _ _ ha hb
      obtain ⟨a', rfl⟩ := ha
      obtain ⟨b', rfl⟩ := hb
      exact ⟨a' + b', map_add _ a' b'⟩
    · intro a _ ha
      obtain ⟨a', rfl⟩ := ha
      exact ⟨-a', by simp⟩
  intro z
  exact h0 z (mem_closure_mk R z)

#check @QuotientAddGroup.eq_iff_sub_mem

end Map

end BalTensor

end Work.ORFlatness
