import Mathlib
import Submission.Work.StarRegular.starRegularClosure_conj
import Submission.Work.Section6.image_mapDomainRingHom_conj
import Submission.Work.ORHughesFree.StarRegular
import Submission.Work.ORHughesFree.Instances

namespace Work.Section6

theorem starRegularClosure_range_conj {K : Type} [Field K] {G : Type} [Group G]
    {U : Type} [Ring U] [StarRing U] [Work.ORHughesFree.IsStarRegular U]
    (φ : MonoidAlgebra K G →+* U) (H : Subgroup G) (N : Subgroup H) (hN : N.Normal) (t : H)
    (hstar : star (φ (MonoidAlgebra.mapDomainRingHom K H.subtype (MonoidAlgebra.single t 1)))
      = φ (MonoidAlgebra.mapDomainRingHom K H.subtype (MonoidAlgebra.single t⁻¹ 1))) :
    (∀ x ∈ (Work.ORHughesFree.starRegularClosure (Work.ORHughesFree.starSubringClosure
        (Set.range ((φ.comp (MonoidAlgebra.mapDomainRingHom K H.subtype)).comp
          (MonoidAlgebra.mapDomainRingHom K N.subtype)))) : Set U),
      φ (MonoidAlgebra.mapDomainRingHom K H.subtype (MonoidAlgebra.single t 1)) * x *
        φ (MonoidAlgebra.mapDomainRingHom K H.subtype (MonoidAlgebra.single t⁻¹ 1))
        ∈ (Work.ORHughesFree.starRegularClosure (Work.ORHughesFree.starSubringClosure
        (Set.range ((φ.comp (MonoidAlgebra.mapDomainRingHom K H.subtype)).comp
          (MonoidAlgebra.mapDomainRingHom K N.subtype)))) : Set U)) ∧
    (∀ x ∈ (Work.ORHughesFree.starRegularClosure (Work.ORHughesFree.starSubringClosure
        (Set.range ((φ.comp (MonoidAlgebra.mapDomainRingHom K H.subtype)).comp
          (MonoidAlgebra.mapDomainRingHom K N.subtype)))) : Set U),
      φ (MonoidAlgebra.mapDomainRingHom K H.subtype (MonoidAlgebra.single t⁻¹ 1)) * x *
        φ (MonoidAlgebra.mapDomainRingHom K H.subtype (MonoidAlgebra.single t 1))
        ∈ (Work.ORHughesFree.starRegularClosure (Work.ORHughesFree.starSubringClosure
        (Set.range ((φ.comp (MonoidAlgebra.mapDomainRingHom K H.subtype)).comp
          (MonoidAlgebra.mapDomainRingHom K N.subtype)))) : Set U)) := by
  -- Write `L = φ ∘ (K[↥H] ↪ K[G])` and `g = L ∘ (K[↥N] ↪ K[↥H])`, so that the relevant
  -- ∗-subring is `starSubringClosure (range g)`, generated by the image of `K[↥N]`.
  let L : MonoidAlgebra K ↥H →+* U := φ.comp (MonoidAlgebra.mapDomainRingHom K H.subtype)
  let g : MonoidAlgebra K ↥N →+* U := L.comp (MonoidAlgebra.mapDomainRingHom K N.subtype)
  let s : Set U := Set.range g
  -- `single t 1` and `single t⁻¹ 1` are mutually inverse in `K[↥H]`, hence their images under `L`
  -- are mutually inverse in `U`.
  have huw : L (MonoidAlgebra.single t 1) * L (MonoidAlgebra.single t⁻¹ 1) = 1 := by
    rw [← map_mul, MonoidAlgebra.single_mul_single, mul_inv_cancel, one_mul,
        MonoidAlgebra.one_def.symm, map_one]
  have hwu : L (MonoidAlgebra.single t⁻¹ 1) * L (MonoidAlgebra.single t 1) = 1 := by
    rw [← map_mul, MonoidAlgebra.single_mul_single, inv_mul_cancel, one_mul,
        MonoidAlgebra.one_def.symm, map_one]
  -- Conjugation by the unit `u = L (single t 1)`.
  let u : Uˣ := ⟨L (MonoidAlgebra.single t 1), L (MonoidAlgebra.single t⁻¹ 1), huw, hwu⟩
  -- The hypothesis `hstar` says `u` is unitary, i.e. `star u = u⁻¹`.
  have hstaru : star (↑u : U) = ((u⁻¹ : Uˣ) : U) := by
    show star (L (MonoidAlgebra.single t 1)) = L (MonoidAlgebra.single t⁻¹ 1)
    exact hstar
  -- Conjugation by `u` preserves the generating set `s`: this is exactly the "commute up to an
  -- element of `s`" statement of `image_mapDomainRingHom_conj`, together with `u * u⁻¹ = 1`.
  have step : ∀ x ∈ s, L (MonoidAlgebra.single t 1) * x * L (MonoidAlgebra.single t⁻¹ 1) ∈ s := by
    intro x hx
    obtain ⟨y, hy, hyx⟩ := Work.Section6.image_mapDomainRingHom_conj L N hN t hx
    obtain ⟨a, ha⟩ := hy
    refine ⟨a, ?_⟩
    rw [ha, ← mul_one y, ← huw, ← mul_assoc, ← hyx]
  have step' : ∀ x ∈ s, L (MonoidAlgebra.single t⁻¹ 1) * x * L (MonoidAlgebra.single t 1) ∈ s := by
    intro x hx
    obtain ⟨y, hy, hyx⟩ := Work.Section6.image_mapDomainRingHom_conj L N hN t⁻¹ hx
    obtain ⟨a, ha⟩ := hy
    refine ⟨a, ?_⟩
    rw [ha, ← mul_one y, ← hwu, ← mul_assoc, ← hyx]
  -- Since conjugation by the unitary `u` is a ∗-ring hom, it preserves the ∗-subring generated by
  -- `s`, i.e. `starSubringClosure s`.
  have hmem : ∀ x ∈ (Work.ORHughesFree.starSubringClosure s : Set U),
      (↑u : U) * x * (↑u⁻¹ : U) ∈ (Work.ORHughesFree.starSubringClosure s : Set U) := by
    have hgen : ∀ x ∈ s, Work.StarRegular.conjHom u x ∈
        (Work.ORHughesFree.starSubringClosure s : Set U) := by
      intro x hx
      rw [Work.StarRegular.conjHom_apply]
      exact Work.ORHughesFree.subset_starSubringClosure s (step x hx)
    intro x hx
    have h := Work.StarRegular.map_starSubringClosure_subset (Work.StarRegular.conjHom u)
      (Work.StarRegular.conjHom_star u hstaru) hgen x hx
    rwa [Work.StarRegular.conjHom_apply] at h
  have hmem' : ∀ x ∈ (Work.ORHughesFree.starSubringClosure s : Set U),
      (↑u⁻¹ : U) * x * (↑u : U) ∈ (Work.ORHughesFree.starSubringClosure s : Set U) := by
    have hstaru' : star ((↑(u⁻¹) : Uˣ) : U) = (((u⁻¹)⁻¹ : Uˣ) : U) := by
      rw [inv_inv, ← hstaru, star_star]
    have hgen : ∀ x ∈ s, Work.StarRegular.conjHom (u⁻¹) x ∈
        (Work.ORHughesFree.starSubringClosure s : Set U) := by
      intro x hx
      rw [Work.StarRegular.conjHom_apply, inv_inv]
      exact Work.ORHughesFree.subset_starSubringClosure s (step' x hx)
    intro x hx
    have h := Work.StarRegular.map_starSubringClosure_subset (Work.StarRegular.conjHom (u⁻¹))
      (Work.StarRegular.conjHom_star (u⁻¹) hstaru') hgen x hx
    rwa [Work.StarRegular.conjHom_apply, inv_inv] at h
  -- Finally, conjugation by a unitary that preserves a ∗-subring preserves its ∗-regular closure.
  exact Work.StarRegular.starRegularClosure_conj (Work.ORHughesFree.starSubringClosure s) u
    hstaru hmem hmem'

end Work.Section6
