# Balanced tensor products over noncommutative rings

Mathlib's `TensorProduct R M N` requires `R` to be commutative.  In this file we build the
*balanced* tensor product of a right `R`-module `M` (i.e. a left `Rᵐᵒᵖ`-module) and a
left `R`-module `N`, with `R` an arbitrary (associative, unital) ring.  It is constructed as the
quotient of the `ℤ`-module `M ⊗[ℤ] N` by the subgroup generated by `m·r ⊗ n - m ⊗ r·n`.

## Main definitions

* `Work.ORHomAlg.BalancedTensor R M N` : the balanced tensor product.
* `Work.ORHomAlg.BalancedTensor.tmul R m n` : the class of `m ⊗ n`.
* `Work.ORHomAlg.BalancedTensor.lift` : the universal property.

## Conventions

A *right* `R`-module is a left `Rᵐᵒᵖ`-module, following Mathlib; the right action of `r : R` on
`m : M` is written `MulOpposite.op r • m`.
-/
module

public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.Algebra.Module.Bimodule

@[expose] public section

namespace Work.ORHomAlg

open scoped TensorProduct

universe u v w v' w' u₁ u₂


section Defs

variable (R : Type u) [Ring R]
variable (M : Type v) [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable (N : Type w) [AddCommGroup N] [Module R N]

/-- The subgroup of `M ⊗[ℤ] N` generated by the elements `m·r ⊗ n - m ⊗ r·n`, whose vanishing
defines the balanced tensor product. -/
def balancedRel : Submodule ℤ (M ⊗[ℤ] N) :=
  Submodule.span ℤ {x | ∃ (m : M) (r : R) (n : N),
    x = (MulOpposite.op r • m) ⊗ₜ[ℤ] n - m ⊗ₜ[ℤ] (r • n)}

/-- The balanced tensor product of a right `R`-module `M` and a left `R`-module `N`. -/
abbrev BalancedTensor : Type (max v w) := (M ⊗[ℤ] N) ⧸ balancedRel R M N

end Defs

namespace BalancedTensor

variable (R : Type u) [Ring R]
variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable {N : Type w} [AddCommGroup N] [Module R N]

/-- The class of `m ⊗ n` in the balanced tensor product. -/
def tmul (m : M) (n : N) : BalancedTensor R M N :=
  Submodule.Quotient.mk (p := balancedRel R M N) (m ⊗ₜ[ℤ] n)

scoped[Work.ORHomAlg] notation:100 M:100 " ⊠[" R "] " N:101 => BalancedTensor R M N

scoped[Work.ORHomAlg] notation:100 x:100 " ⊠ₜ[" R "] " y:101 => BalancedTensor.tmul R x y

/-- The additive map `n ↦ m ⊗ n` for fixed `m`. -/
def tmulAddHom (m : M) : N →+ BalancedTensor R M N where
  toFun := fun n => tmul R m n
  map_zero' := by simp [tmul]
  map_add' := by intro n₁ n₂; simp [tmul, TensorProduct.tmul_add]

end BalancedTensor

namespace BalancedTensor

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable {N : Type w} [AddCommGroup N] [Module R N]

theorem tmul_def (m : M) (n : N) :
    tmul R m n = Submodule.Quotient.mk (p := balancedRel R M N) (m ⊗ₜ[ℤ] n) := rfl

section Lemmas

@[simp]
theorem tmul_add (m₁ m₂ : M) (n : N) :
    tmul R (m₁ + m₂) n = tmul R m₁ n + tmul R m₂ n := by
  simp [tmul, TensorProduct.add_tmul]

@[simp]
theorem tmul_zero (n : N) : tmul R (0 : M) n = 0 := by
  simp [tmul]

@[simp]
theorem zero_tmul (m : M) : tmul R m (0 : N) = 0 := by
  simp [tmul]

@[simp]
theorem tmul_add' (m : M) (n₁ n₂ : N) :
    tmul R m (n₁ + n₂) = tmul R m n₁ + tmul R m n₂ := by
  simp [tmul, TensorProduct.tmul_add]

@[simp]
theorem tmul_neg (m : M) (n : N) : tmul R (-m) n = -tmul R m n := by
  simp [tmul, TensorProduct.neg_tmul]

@[simp]
theorem tmul_neg' (m : M) (n : N) : tmul R m (-n) = -tmul R m n := by
  simp [tmul, TensorProduct.tmul_neg]

@[simp]
theorem tmul_sub (m₁ m₂ : M) (n : N) :
    tmul R (m₁ - m₂) n = tmul R m₁ n - tmul R m₂ n := by
  simp [tmul, TensorProduct.sub_tmul]

@[simp]
theorem tmul_sub' (m : M) (n₁ n₂ : N) :
    tmul R m (n₁ - n₂) = tmul R m n₁ - tmul R m n₂ := by
  simp [tmul, TensorProduct.tmul_sub]

/-- The defining relation of the balanced tensor product. -/
theorem tmul_smul (m : M) (r : R) (n : N) :
    tmul R (MulOpposite.op r • m) n = tmul R m (r • n) := by
  rw [tmul_def, tmul_def, Submodule.Quotient.eq]
  exact Submodule.subset_span ⟨m, r, n, rfl⟩

/-- Integer multiples in the quotient. -/
theorem mk_zsmul (z : ℤ) (x : M ⊗[ℤ] N) :
    Submodule.Quotient.mk (p := balancedRel R M N) (z • x) =
      z • Submodule.Quotient.mk (p := balancedRel R M N) x := by
  rw [← Submodule.mkQ_apply, ← Submodule.mkQ_apply]
  exact map_smul _ z x

end Lemmas

section Universal

variable {P : Type*} [AddCommGroup P]

/-- Auxiliary: the `ℤ`-bilinear map `M × N → P` induced by an additive map in each variable. -/
def tensorLift (f : M →+ N →+ P) : (M ⊗[ℤ] N) →ₗ[ℤ] P :=
  (TensorProduct.liftAddHom (R := ℤ) f (fun z m n => by
      have h1 : f (z • m) = z • f m := map_zsmul f z m
      have h2 : f m (z • n) = z • (f m n) := map_zsmul (f m) z n
      rw [h1, h2]
      rfl)).toIntLinearMap

theorem tensorLift_tmul (f : M →+ N →+ P) (m : M) (n : N) :
    tensorLift f (m ⊗ₜ[ℤ] n) = f m n := by
  simp only [tensorLift, AddMonoidHom.coe_toIntLinearMap, TensorProduct.liftAddHom_tmul]

/-- The universal property of the balanced tensor product: a `ℤ`-bilinear map which is
`R`-balanced factors through `M ⊗[R] N`. -/
def lift (f : M →+ N →+ P)
    (hf : ∀ (m : M) (r : R) (n : N), f (MulOpposite.op r • m) n = f m (r • n)) :
    BalancedTensor R M N →ₗ[ℤ] P :=
  Submodule.liftQ (balancedRel R M N) (tensorLift f) (by
    unfold balancedRel
    rw [Submodule.span_le]
    rintro x ⟨m, r, n, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, tensorLift_tmul, tensorLift_tmul, hf,
      sub_self])

@[simp]
theorem lift_tmul (f : M →+ N →+ P) (hf) (m : M) (n : N) :
    lift f hf (tmul R m n) = f m n := by
  simp only [lift, tmul_def, Submodule.liftQ_apply, tensorLift_tmul]

/-- Induction principle for the balanced tensor product: it suffices to check a property of
`0`, of sums, and of the classes of pure tensors. -/
@[elab_as_elim]
theorem induction_on {C : BalancedTensor R M N → Prop} (x : BalancedTensor R M N)
    (H0 : C 0) (Hadd : ∀ x y, C x → C y → C (x + y))
    (Htmul : ∀ (m : M) (n : N), C (tmul R m n)) : C x := by
  have key : ∀ y : M ⊗[ℤ] N,
      C (Submodule.Quotient.mk (p := balancedRel R M N) y) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simpa using H0
    | tmul m n => exact Htmul m n
    | add a b ha hb => rw [Submodule.Quotient.mk_add]; exact Hadd _ _ ha hb
  exact Submodule.Quotient.induction_on (p := balancedRel R M N) x key

/-- Induction principle checking `0`, sums, negatives and pure tensors. -/
@[elab_as_elim]
theorem induction_on_neg {C : BalancedTensor R M N → Prop} (x : BalancedTensor R M N)
    (H0 : C 0) (Hadd : ∀ x y, C x → C y → C (x + y)) (Hneg : ∀ x, C x → C (-x))
    (Htmul : ∀ (m : M) (n : N), C (tmul R m n)) : C x := by
  have h : ∀ z, C (-z) := fun z =>
    induction_on (C := fun w => C (-w)) z (by simpa using H0)
      (fun a b ha hb => by rw [neg_add]; exact Hadd _ _ ha hb)
      (fun m n => by simpa using Hneg _ (Htmul m n))
  simpa using h (-x)

/-- Two additive maps out of a balanced tensor product agreeing on the classes of pure tensors
are equal. -/
@[ext]
theorem hom_ext {f g : BalancedTensor R M N →+ P}
    (h : ∀ m n, f (tmul R m n) = g (tmul R m n)) : f = g := by
  apply AddMonoidHom.ext
  intro x
  refine induction_on x ?_ ?_ ?_
  · simp
  · intro y z hy hz
    rw [map_add, map_add, hy, hz]
  · intro m n
    exact h m n

end Universal

end BalancedTensor

end Work.ORHomAlg
