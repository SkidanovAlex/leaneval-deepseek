# Augmentation ideals of group algebras

This file sets up the group-algebra vocabulary used for the flatness calculations of
Jaikin-Zapirain--Linton, *On the coherence of one-relator groups and their group algebras*
(Annals of Math. 201 (2025)), Section 5: the augmentation `k[G] → k`, the augmentation ideal
`I_k[G]`, the canonical map `k[H] → k[G]` for a subgroup `H ≤ G`, and the ideal
`I^G_{k[H]}` generated by `I_k[H]`.

## Main definitions

* `Work.ORHomAlg.augmentation`, `Work.ORHomAlg.augIdeal`;
* `Work.ORHomAlg.subgroupAlgMap`, `Work.ORHomAlg.augIdealOfSubgroup`.
-/
module

public import Mathlib.Algebra.MonoidAlgebra.MapDomain
public import Mathlib.RingTheory.Ideal.Operations
public import Submission.Work.ORHomAlg.Map

@[expose] public section

namespace Work.ORHomAlg

universe u v

/-- The augmentation `k[G] →+* k` of a monoid algebra, sending every `g : G` to `1`. -/
noncomputable def augmentation (k : Type u) [CommSemiring k] (G : Type v) [Monoid G] :
    MonoidAlgebra k G →+* k :=
  (MonoidAlgebra.lift k k G 1).toRingHom

/-- The augmentation ideal `I_k[G]`, the kernel of the augmentation `k[G] → k`, `g ↦ 1`. -/
noncomputable def augIdeal (k : Type u) [CommSemiring k] (G : Type v) [Monoid G] :
    Ideal (MonoidAlgebra k G) :=
  RingHom.ker (augmentation k G)

/-- The canonical `k`-algebra (ring) map `k[H] →+* k[G]` induced by a subgroup `H ≤ G`. -/
noncomputable def subgroupAlgMap (k : Type u) [CommSemiring k] {G : Type v} [Group G]
    (H : Subgroup G) : MonoidAlgebra k H →+* MonoidAlgebra k G :=
  MonoidAlgebra.mapDomainRingHom k H.subtype

/-- The ideal `I^G_{k[H]}` of `k[G]` generated by the augmentation ideal `I_k[H]` of `k[H]`
(Jaikin-Zapirain--Linton, Section 5). -/
noncomputable def augIdealOfSubgroup (k : Type u) [CommSemiring k] {G : Type v} [Group G]
    (H : Subgroup G) : Ideal (MonoidAlgebra k G) :=
  Ideal.map (subgroupAlgMap k H) (augIdeal k H)

/-- The right `R`-module structure on a two-sided ideal of `R`. -/
instance instModuleOppositeIdeal (R : Type u) [Ring R] (I : Ideal R) [I.IsTwoSided] :
    Module Rᵐᵒᵖ I where
  smul r x := ⟨x.1 * MulOpposite.unop r, I.mul_mem_right _ x.2⟩
  one_smul x := by
    ext
    show x.1 * (1 : R) = x.1
    simp
  mul_smul a b x := by
    ext
    show x.1 * (MulOpposite.unop b * MulOpposite.unop a) =
      x.1 * MulOpposite.unop b * MulOpposite.unop a
    rw [mul_assoc]
  smul_zero a := by
    ext
    show (0 : R) * MulOpposite.unop a = 0
    simp
  smul_add a x y := by
    ext
    show (x.1 + y.1) * MulOpposite.unop a = x.1 * MulOpposite.unop a + y.1 * MulOpposite.unop a
    rw [add_mul]
  add_smul a b x := by
    ext
    show x.1 * (MulOpposite.unop a + MulOpposite.unop b) =
      x.1 * MulOpposite.unop a + x.1 * MulOpposite.unop b
    rw [mul_add]
  zero_smul x := by
    ext
    show x.1 * (0 : R) = 0
    simp

/-- The `k[H]`-module structure on `k[G]` induced by the canonical map `k[H] →+* k[G]`. -/
noncomputable instance instModuleSubgroupAlg (k : Type u) [CommSemiring k] {G : Type v} [Group G]
    (H : Subgroup G) : Module (MonoidAlgebra k H) (MonoidAlgebra k G) :=
  (subgroupAlgMap k H).toModule

instance instSMulCommClassSubgroupAlg (k : Type u) [CommSemiring k] {G : Type v} [Group G]
    (H : Subgroup G) : SMulCommClass (MonoidAlgebra k H) (MonoidAlgebra k G)ᵐᵒᵖ
      (MonoidAlgebra k G) where
  smul_comm a b x := by
    show subgroupAlgMap k H a * (x * MulOpposite.unop b) =
      subgroupAlgMap k H a * x * MulOpposite.unop b
    rw [mul_assoc]

/-- The augmentation ideal is two-sided (it is a kernel). -/
instance instIsTwoSidedAugIdeal (k : Type u) [CommSemiring k] (G : Type v) [Monoid G] :
    (augIdeal k G).IsTwoSided :=
  inferInstanceAs (RingHom.ker (augmentation k G)).IsTwoSided

/-- The right ideal `I_k[H]^G` of `k[G]` generated by the image of the augmentation ideal of
`k[H]` (notation of Jaikin-Zapirain--Linton, Section 2.1). -/
noncomputable def rightIdealOfSubgroup (k : Type u) [CommSemiring k] {G : Type v} [Group G]
    (H : Subgroup G) : Submodule (MonoidAlgebra k G)ᵐᵒᵖ (MonoidAlgebra k G) :=
  Submodule.span (MonoidAlgebra k G)ᵐᵒᵖ
    (Set.range fun x : augIdeal k H => subgroupAlgMap k H x.1)

end Work.ORHomAlg
