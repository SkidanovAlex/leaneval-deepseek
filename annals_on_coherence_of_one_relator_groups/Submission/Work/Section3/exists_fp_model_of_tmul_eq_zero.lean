/-
# Finite (`R`-)presentation models of `z ⊗[R] s = 0`

Let `f : R →+* S` be a ring homomorphism and let `S ⊗[R] S` be the `R`-balanced tensor square of
`S` along `f` (`Submission/Work/ORHughesFree/Epic/BalancedTensor.lean`).  For `z s : S` with
`z ⊗[R] s = 0` this file produces a *finitely presented* `R`-module `L` together with an additive
map `φ : L →+ S` satisfying `φ (a • l) = f a * φ l`, and an element `r ∈ L` with `φ r = s` and
`z ⊗[R] r = 0` in the balanced tensor `S ⊗[R] L` (`Work.Section3.RkFinModel.BalancedTensorMod`).

This is the finite-descent step used, for instance, in
`Work.Section3.rank_diff_of_fp_model`: the vanishing of an elementary balanced tensor can be
witnessed by a single finitely presented module.

## Proof outline

* `Work.Section3.RkFinModel.exists_bal_combo` writes the membership of `z ⊗[ℤ] s` in the subgroup
  generated by the balance relations as a finite `ℤ`-linear combination
  `z ⊗[ℤ] s = ∑ i, c i • ((a i * f (p i)) ⊗[ℤ] b i - a i ⊗[ℤ] (f (p i) * b i))`.
* Let `L₀` be the (finitely generated) `ℤ`-submodule of `S` generated by the elements `s`, `b i`
  and `f (p i) * b i`, and let `δ ∈ S ⊗[ℤ] L₀` be the same combination with the second factors
  taken in `L₀`, minus `z ⊗[ℤ] (s : L₀)`.  By construction `δ` maps to `0` in `S ⊗[ℤ] S`.
* `Work.Section3.RkFinModel.exists_fg_sup_of_lTensor_subtype_eq_zero` (the finite witness property
  for tensor products, a direct consequence of `TensorProduct.eq_zero_of_fg_of_subtype_eq_zero`)
  enlarges `L₀` to a finitely generated `ℤ`-submodule `Q ≤ S` on which `δ` already vanishes.  Hence
  the combination holds in `S ⊗[ℤ] Q`.
* Passing to the `R`-submodule `L := R • Q` generated by `Q` (with the `R`-module structure
  `r • x = f r * x`) the summands become balance relations, so `z ⊗[R] (s : L) = 0` in the balanced
  tensor; `L` is finitely generated over `R`.
* `Work.Section3.RkFinModel.exists_fp_model_of_finite_model` replaces the finitely generated module
  `L` by a finitely presented quotient, using that `S ⊗[ℤ] -` is right exact.
-/
import Mathlib
import Submission.Work.Section3.RkFinModel.Defs
import Submission.Work.Section3.RkFinModel.BalCombos
import Submission.Work.Section3.RkFinModel.exists_fp_model_of_finite_model

set_option autoImplicit false

universe u

open scoped TensorProduct

namespace Work.Section3

open Work.ORHughesFree.Epic (BalancedTensor balRel)
open Work.Section3.RkFinModel (BalancedTensorMod)

/-- The `ℤ`-span of a set is contained in its `R`-span, for any ring `R` acting on `M`. -/
lemma span_int_subset_span {R M : Type u} [Ring R] [AddCommGroup M] [Module R M] (s : Set M) :
    (Submodule.span ℤ s : Set M) ⊆ (Submodule.span R s : Set M) := by
  have h1 : (Submodule.span ℤ s : Set M) = ↑(AddSubgroup.closure s) := by
    rw [← AddSubgroup.toIntSubmodule_closure s, AddSubgroup.coe_toIntSubmodule]
  rw [h1]
  intro x hx
  exact AddSubgroup.closure_le (Submodule.span R s).toAddSubgroup |>.mpr
    (by simpa using Submodule.subset_span) hx

/-- `TensorProduct.comm` intertwines `lTensor` and `rTensor`. -/
lemma comm_lTensor_eq_rTensor_comm {N P Q : Type u} [AddCommGroup N] [AddCommGroup P]
    [AddCommGroup Q] (g : P →ₗ[ℤ] Q) (x : N ⊗[ℤ] P) :
    (TensorProduct.comm ℤ N Q) (LinearMap.lTensor N g x)
      = LinearMap.rTensor N g ((TensorProduct.comm ℤ N P) x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul n p => simp [TensorProduct.comm_tmul]
  | add x y hx hy => simp [map_add, hx, hy]

/-- **Finite witness property for tensor products.**  If an element of `N ⊗[ℤ] P` is killed by
`lTensor N P.subtype`, then it is already killed by the inclusion of some finitely generated
`ℤ`-submodule `Q ≥ P` into `M`.

This is the form of `TensorProduct.eq_zero_of_fg_of_subtype_eq_zero` (the direct limit
`M = colim_Q Q` and the exactness of `N ⊗[ℤ] -`) with the tensor product taken on the left. -/
theorem exists_fg_sup_of_tensor_subtype_eq_zero {M N : Type u} [AddCommGroup M] [AddCommGroup N]
    {P : Submodule ℤ M} (hP : P.FG) {δ : TensorProduct ℤ N P}
    (hδ : LinearMap.lTensor N P.subtype δ = 0) :
    ∃ (Q : Submodule ℤ M) (hPQ : P ≤ Q),
      Q.FG ∧ LinearMap.lTensor N (Submodule.inclusion hPQ) δ = 0 := by
  classical
  have hrt : LinearMap.rTensor N P.subtype ((TensorProduct.comm ℤ N P) δ) = 0 := by
    rw [← comm_lTensor_eq_rTensor_comm P.subtype δ, hδ, map_zero]
  obtain ⟨Q, hPQ, hQFG, hQr⟩ :=
    TensorProduct.eq_zero_of_fg_of_subtype_eq_zero (R := ℤ) (M := M) (N := N) hP hrt
  refine ⟨Q, hPQ, hQFG, ?_⟩
  apply (TensorProduct.comm ℤ N Q).injective
  rw [comm_lTensor_eq_rTensor_comm (Submodule.inclusion hPQ) δ, hQr, map_zero]

theorem exists_fp_model_of_tmul_eq_zero {R S : Type u} [Ring R] [Ring S]
    (f : R →+* S) {z s : S}
    (h : Work.ORHughesFree.Epic.BalancedTensor.tmul f z s = 0) :
    ∃ (L : Type u) (_ : AddCommGroup L) (_ : Module R L) (_ : Module.FinitePresentation R L)
      (φ : L →+ S) (_ : ∀ (a : R) (l : L), φ (a • l) = f a * φ l) (r : L),
      φ r = s ∧ Work.Section3.RkFinModel.BalancedTensorMod.tmulM f z r = 0 := by
  classical
  -- The vanishing in the balanced tensor is a membership in the subgroup generated by the
  -- balance relations.
  have hmem : z ⊗ₜ[ℤ] s ∈ AddSubgroup.closure (balRel f) := by
    have h1 : (QuotientAddGroup.mk' (AddSubgroup.closure (balRel f)) (z ⊗ₜ[ℤ] s) :
        BalancedTensor f) = 0 := h
    have h2 := AddMonoidHom.mem_ker.mpr h1
    rwa [QuotientAddGroup.ker_mk'] at h2
  -- A finite combination of balance relations.
  obtain ⟨ι, hι, c, a, b, p, hsum⟩ := Work.Section3.RkFinModel.exists_bal_combo f hmem
  -- The finitely generated `ℤ`-submodule generated by all second factors occurring.
  let L₀ : Submodule ℤ S :=
    Submodule.span ℤ ({s} ∪ Set.range b ∪ Set.range (fun i => f (p i) * b i))
  have hL₀FG : L₀.FG := by
    show (Submodule.span ℤ ({s} ∪ Set.range b ∪ Set.range (fun i => f (p i) * b i) : Set S)).FG
    exact Submodule.fg_span (((Set.finite_singleton s).union (Set.finite_range b)).union
      (Set.finite_range fun i => f (p i) * b i))
  have hsL₀ : s ∈ L₀ := Submodule.subset_span (by simp)
  have hbL₀ : ∀ i, b i ∈ L₀ := fun i => Submodule.subset_span (by simp)
  have hfbL₀ : ∀ i, f (p i) * b i ∈ L₀ := fun i => Submodule.subset_span (by simp)
  let δ : TensorProduct ℤ S L₀ :=
    z ⊗ₜ[ℤ] (⟨s, hsL₀⟩ : L₀) -
      ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
        (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀))
  have h2 : LinearMap.lTensor S L₀.subtype (z ⊗ₜ[ℤ] (⟨s, hsL₀⟩ : L₀)) = z ⊗ₜ[ℤ] s := by
    rw [LinearMap.lTensor_tmul]
    rfl
  have h3 : ∀ i, LinearMap.lTensor S L₀.subtype
      ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
        (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀))
      = (a i * f (p i)) ⊗ₜ[ℤ] (b i) - (a i) ⊗ₜ[ℤ] (f (p i) * b i) := by
    intro i
    rw [map_sub, LinearMap.lTensor_tmul, LinearMap.lTensor_tmul]
    rfl
  have h4 : LinearMap.lTensor S L₀.subtype
      (∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
        (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀)))
      = ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (b i) - (a i) ⊗ₜ[ℤ] (f (p i) * b i)) := by
    rw [map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [map_smul, h3 i]
  have hδ : LinearMap.lTensor S L₀.subtype δ = 0 := by
    show LinearMap.lTensor S L₀.subtype
      (z ⊗ₜ[ℤ] (⟨s, hsL₀⟩ : L₀) -
        ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀))) = 0
    rw [map_sub, h2, h4, hsum, sub_self]
  -- Enlarge `L₀` so that `δ` already vanishes there.
  obtain ⟨Q, hL₀Q, hQFG, hQ⟩ :=
    exists_fg_sup_of_tensor_subtype_eq_zero (M := S) (N := S) hL₀FG hδ
  have hsQ : s ∈ Q := hL₀Q hsL₀
  have hbQ : ∀ i, b i ∈ Q := fun i => hL₀Q (hbL₀ i)
  have hfbQ : ∀ i, f (p i) * b i ∈ Q := fun i => hL₀Q (hfbL₀ i)
  have hidQ : z ⊗ₜ[ℤ] (⟨s, hsQ⟩ : Q) =
      ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbQ i⟩ : Q) -
        (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbQ i⟩ : Q)) := by
    have h2Q : LinearMap.lTensor S (Submodule.inclusion hL₀Q) (z ⊗ₜ[ℤ] (⟨s, hsL₀⟩ : L₀))
        = z ⊗ₜ[ℤ] (⟨s, hsQ⟩ : Q) := by
      rw [LinearMap.lTensor_tmul]
      rfl
    have h3Q : ∀ i, LinearMap.lTensor S (Submodule.inclusion hL₀Q)
        ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀))
        = (a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbQ i⟩ : Q) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbQ i⟩ : Q) := by
      intro i
      rw [map_sub, LinearMap.lTensor_tmul, LinearMap.lTensor_tmul]
      rfl
    have h4Q : LinearMap.lTensor S (Submodule.inclusion hL₀Q)
        (∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀)))
        = ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbQ i⟩ : Q) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbQ i⟩ : Q)) := by
      rw [map_sum]
      exact Finset.sum_congr rfl fun i _ => by rw [map_smul, h3Q i]
    have hexp : LinearMap.lTensor S (Submodule.inclusion hL₀Q) δ =
        z ⊗ₜ[ℤ] (⟨s, hsQ⟩ : Q) -
          ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbQ i⟩ : Q) -
            (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbQ i⟩ : Q)) := by
      show LinearMap.lTensor S (Submodule.inclusion hL₀Q)
        (z ⊗ₜ[ℤ] (⟨s, hsL₀⟩ : L₀) -
          ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL₀ i⟩ : L₀) -
            (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL₀ i⟩ : L₀))) = _
      rw [map_sub, h2Q, h4Q]
    rw [hexp] at hQ
    exact sub_eq_zero.mp hQ
  -- Pass to the `R`-submodule generated by `Q`; there the summands are balance relations.
  letI : Module R S := f.toModule
  let L : Submodule R S := Submodule.span R (Q : Set S)
  have hQL : (Q : Set S) ⊆ (L : Set S) := Submodule.subset_span
  have hsL : s ∈ L := hQL hsQ
  have hbL : ∀ i, b i ∈ L := fun i => hQL (hbQ i)
  have hfbL : ∀ i, f (p i) * b i ∈ L := fun i => hQL (hfbQ i)
  let incl : Q →ₗ[ℤ] L :=
    { toFun := fun x => ⟨(x : S), hQL x.2⟩
      map_add' := fun x y => by ext; rfl
      map_smul' := fun n x => by ext; rfl }
  have hidL : z ⊗ₜ[ℤ] (⟨s, hsL⟩ : L) =
      ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL i⟩ : L) -
        (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL i⟩ : L)) := by
    have h2L : LinearMap.lTensor S incl (z ⊗ₜ[ℤ] (⟨s, hsQ⟩ : Q)) = z ⊗ₜ[ℤ] (⟨s, hsL⟩ : L) := by
      rw [LinearMap.lTensor_tmul]
      rfl
    have h3L : ∀ i, LinearMap.lTensor S incl
        ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbQ i⟩ : Q) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbQ i⟩ : Q))
        = (a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL i⟩ : L) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL i⟩ : L) := by
      intro i
      rw [map_sub, LinearMap.lTensor_tmul, LinearMap.lTensor_tmul]
      rfl
    have h4L : LinearMap.lTensor S incl
        (∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbQ i⟩ : Q) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbQ i⟩ : Q)))
        = ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL i⟩ : L) -
          (a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL i⟩ : L)) := by
      rw [map_sum]
      exact Finset.sum_congr rfl fun i _ => by rw [map_smul, h3L i]
    have hcongr := congrArg (LinearMap.lTensor S incl) hidQ
    rw [h2L, h4L] at hcongr
    exact hcongr
  have hvan : BalancedTensorMod.tmulM f z (⟨s, hsL⟩ : L) = 0 := by
    show BalancedTensorMod.mk f L (z ⊗ₜ[ℤ] (⟨s, hsL⟩ : L)) = 0
    rw [hidL, map_sum]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [AddMonoidHom.map_zsmul, map_sub]
    have hbal : BalancedTensorMod.mk f L ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL i⟩ : L))
        = BalancedTensorMod.mk f L ((a i) ⊗ₜ[ℤ] (⟨f (p i) * b i, hfbL i⟩ : L)) := by
      rw [show BalancedTensorMod.mk f L ((a i * f (p i)) ⊗ₜ[ℤ] (⟨b i, hbL i⟩ : L))
            = BalancedTensorMod.tmulM f (a i * f (p i)) (⟨b i, hbL i⟩ : L) from rfl,
        BalancedTensorMod.tmulM_balance]
      congr 1
    rw [hbal, sub_self, smul_zero]
  -- `L` is finitely generated over `R`.
  have hLfg : L.FG := by
    obtain ⟨t, ht⟩ := hQFG
    have hLt : L = Submodule.span R (t : Set S) := by
      show Submodule.span R (Q : Set S) = Submodule.span R (t : Set S)
      refine le_antisymm ?_ ?_
      · rw [Submodule.span_le]
        intro x hx
        rw [← ht] at hx
        exact span_int_subset_span (t : Set S) hx
      · rw [Submodule.span_le]
        intro x hx
        refine Submodule.subset_span ?_
        rw [← ht]
        exact Submodule.subset_span hx
    rw [hLt]
    exact Submodule.fg_span (Finset.finite_toSet t)
  haveI hfin : Module.Finite R L := Module.Finite.iff_fg.mpr hLfg
  have hsub : ∀ (a' : R) (l : L), (Submodule.subtype L).toAddMonoidHom (a' • l)
      = f a' * (Submodule.subtype L).toAddMonoidHom l := by
    intro a' l
    exact RingHom.toModule_smul f a' (l : S)
  obtain ⟨L', i1, i2, hfp, φ', hφ', r', hr', hv⟩ :=
    Work.Section3.RkFinModel.exists_fp_model_of_finite_model f
      (Submodule.subtype L).toAddMonoidHom hsub z ⟨s, hsL⟩ hvan
  exact ⟨L', i1, i2, hfp, φ', hφ', r', by rw [hr']; rfl, hv⟩

end Work.Section3
