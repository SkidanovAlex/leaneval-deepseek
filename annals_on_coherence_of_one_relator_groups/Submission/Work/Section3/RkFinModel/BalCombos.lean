/-
# Finite balance combinations

`Submission/Work/ORHughesFree/Epic/BalancedTensor.lean` defines the `R`-balanced tensor product
`S ⊗[R] S` of a ring `S` along a ring homomorphism `f : R →+* S` as the quotient of the
`ℤ`-tensor product `S ⊗[ℤ] S` by the subgroup generated by the "balance" relations
`s·f r ⊗ t = s ⊗ f r·t`; `Submission/Work/Section3/RkFinModel/Defs.lean` defines the analogous
`S ⊗[R] L` for an `R`-module `L`, with relations `s·f r ⊗ l = s ⊗ r·l`.

Both quotients forget the (infinite) generating set of the balance subgroup.  This file records the
elementary fact that an element of that subgroup is a **finite** `ℤ`-linear combination of balance
relations: the members of the generating set are exhibited with their witnesses.  This is the first
step of the finite-descent argument
(`Work.Section3.RkFinModel.exists_fp_model_of_tmul_eq_zero`).
-/
import Mathlib
import Submission.Work.ORHughesFree.Epic.BalancedTensor
import Submission.Work.Section3.RkFinModel.Defs

set_option autoImplicit false

universe u

open scoped TensorProduct

namespace Work.Section3.RkFinModel

variable {R S : Type u} [Ring R] [Ring S]

/-- An element of the subgroup of `S ⊗[ℤ] S` generated by the balance relations
`s·f r ⊗ t = s ⊗ f r·t` is a finite `ℤ`-linear combination of such relations. -/
theorem exists_bal_combo (f : R →+* S) {x : TensorProduct ℤ S S}
    (hx : x ∈ AddSubgroup.closure (Work.ORHughesFree.Epic.balRel f)) :
    ∃ (ι : Type u) (_ : Fintype ι) (c : ι → ℤ) (a b : ι → S) (p : ι → R),
      x = ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (b i) - (a i) ⊗ₜ[ℤ] (f (p i) * b i)) := by
  classical
  refine AddSubgroup.closure_induction (p := fun x _ => ∃ (ι : Type u) (_ : Fintype ι) (c : ι → ℤ)
    (a b : ι → S) (q : ι → R),
      x = ∑ i, c i • ((a i * f (q i)) ⊗ₜ[ℤ] (b i) - (a i) ⊗ₜ[ℤ] (f (q i) * b i))) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨a, b, r, rfl⟩
    exact ⟨PUnit, inferInstance, fun _ => 1, fun _ => a, fun _ => b, fun _ => r, by simp⟩
  · exact ⟨PEmpty, inferInstance, PEmpty.elim, PEmpty.elim, PEmpty.elim, PEmpty.elim, by simp⟩
  · rintro x y hx hy ⟨ι₁, hι₁, c₁, a₁, b₁, p₁, rfl⟩ ⟨ι₂, hι₂, c₂, a₂, b₂, p₂, rfl⟩
    refine ⟨ι₁ ⊕ ι₂, inferInstance, Sum.elim c₁ c₂, Sum.elim a₁ a₂, Sum.elim b₁ b₂,
      Sum.elim p₁ p₂, ?_⟩
    rw [Fintype.sum_sum_type]
    simp only [Sum.elim_inl, Sum.elim_inr]
  · rintro x hx ⟨ι, hι, c, a, b, p, rfl⟩
    refine ⟨ι, hι, fun i => -c i, a, b, p, ?_⟩
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun i _ => by rw [neg_smul]

/-- An element of the subgroup of `S ⊗[ℤ] L` generated by the balance relations
`s·f r ⊗ l = s ⊗ r·l` is a finite `ℤ`-linear combination of such relations. -/
theorem exists_balRelMod_combo (f : R →+* S) {L : Type u} [AddCommGroup L] [Module R L]
    {x : TensorProduct ℤ S L}
    (hx : x ∈ AddSubgroup.closure (balRelMod f L)) :
    ∃ (ι : Type u) (_ : Fintype ι) (c : ι → ℤ) (a : ι → S) (l : ι → L) (p : ι → R),
      x = ∑ i, c i • ((a i * f (p i)) ⊗ₜ[ℤ] (l i) - (a i) ⊗ₜ[ℤ] (p i • l i)) := by
  classical
  refine AddSubgroup.closure_induction (p := fun x _ => ∃ (ι : Type u) (_ : Fintype ι) (c : ι → ℤ)
    (a : ι → S) (l : ι → L) (q : ι → R),
      x = ∑ i, c i • ((a i * f (q i)) ⊗ₜ[ℤ] (l i) - (a i) ⊗ₜ[ℤ] (q i • l i))) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨a, l, r, rfl⟩
    exact ⟨PUnit, inferInstance, fun _ => 1, fun _ => a, fun _ => l, fun _ => r, by simp⟩
  · exact ⟨PEmpty, inferInstance, PEmpty.elim, PEmpty.elim, PEmpty.elim, PEmpty.elim, by simp⟩
  · rintro x y hx hy ⟨ι₁, hι₁, c₁, a₁, l₁, p₁, rfl⟩ ⟨ι₂, hι₂, c₂, a₂, l₂, p₂, rfl⟩
    refine ⟨ι₁ ⊕ ι₂, inferInstance, Sum.elim c₁ c₂, Sum.elim a₁ a₂, Sum.elim l₁ l₂,
      Sum.elim p₁ p₂, ?_⟩
    rw [Fintype.sum_sum_type]
    simp only [Sum.elim_inl, Sum.elim_inr]
  · rintro x hx ⟨ι, hι, c, a, l, p, rfl⟩
    refine ⟨ι, hι, fun i => -c i, a, l, p, ?_⟩
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun i _ => by rw [neg_smul]

end Work.Section3.RkFinModel
