/-!
# The inclusion of the diagonal `∗`-subring in its `∗`-regular closure is epic

Fix a `∗`-ring `R`, two `∗`-regular rings `U₁`, `U₂` and `∗`-homomorphisms `φᵢ : R →+* Uᵢ`; let
`Δ = {(φ₁ r, φ₂ r)} ⊆ U₁ × U₂` be the diagonal `∗`-subring and `T = starRegularClosure Δ` its
`∗`-regular closure.  We prove that the inclusion `Δ ↪ T` is **epic** (right cancellable).

This is the "diagonal" form of the uniqueness statement for `∗`-regular envelopes
([JZLA20, Proposition 2.7], after [Jaikin, GAFA 2019, Proposition 6.1]): an epic `∗`-regular
envelope is generated by its image, so the two projections `T ⇉ Uᵢ` are determined by `φᵢ`.

The proof is the standard equalizer argument.  Given `g k : T →+* Q` agreeing on `Δ`, their
equalizer `E ⊆ T` is a subring containing `Δ` and closed under relative inverses of its
*self-adjoint* elements (`map_relativeInverse_eq_of_selfAdjoint`), so by the closure criterion
`starRegularClosure_le_of_isRelativeInverse_selfAdjoint` it contains the `∗`-regular closure of
`Δ` *computed inside `T`*.  Since `T` is itself `∗`-regular, that intrinsic closure is all of
`T`: this is the comparison of the two approximating chains `starRegularChain`
(`starRegularChain_subset_image`), which is why no epicness hypothesis on `φ₁`, `φ₂` is needed.
-/

/-- The epic criterion of [Jaikin, GAFA 2019, Proposition 6.1] in the universe-polymorphic form
needed here: a `∗`-homomorphism `φ : S →+* V` into a `∗`-regular ring `V` is epic as soon as
`V` is generated by the image of `φ` as a `∗`-regular `∗`-subring of itself.

This is `Work.ORHughesFree.NaturalExtension.isEpic_of_starRegularClosure` with the universe
of `S` and `V` generalised (the original is stated for `S V : Type`). -/
theorem isEpic_of_starRegularClosure' {S V : Type u} [Ring S] [StarRing S] [Ring V] [StarRing V]
    [IsStarRegular V] (φ : S →+* V) (hφ : ∀ s : S, φ (star s) = star (φ s))
    (hgen : ∀ v : V, v ∈ (starRegularClosure (starSubringClosure (Set.range φ)) : Set V)) :
    IsEpic φ := by
  intro Q _ g h hgh
  -- the equalizer of `g` and `h` is a subring of `V` containing the image of `φ`
  let E : Subring V :=
    { carrier := {v : V | g v = h v}
      zero_mem' := by simp
      one_mem' := by simp
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [map_add, map_add, ha, hb]
      neg_mem' := by
        intro a ha
        simp only [Set.mem_ofPred_eq] at ha ⊢
        rw [map_neg, map_neg, ha]
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [map_mul, map_mul, ha, hb] }
  -- the image of `φ` lies in `E`; since `φ` is a `∗`-homomorphism, so does `star '' Set.range φ`
  have hRE : ((starSubringClosure (Set.range φ)) : Set V) ⊆ (E : Set V) := by
    refine Subring.closure_le.mpr ?_
    rintro v (hv | ⟨u, hu, rfl⟩)
    · rcases hv with ⟨s, rfl⟩
      show g (φ s) = h (φ s)
      simpa using congrArg (fun f : S →+* Q => f s) hgh
    · rcases hu with ⟨s, rfl⟩
      show g (star (φ s)) = h (star (φ s))
      rw [← hφ s]
      simpa using congrArg (fun f : S →+* Q => f (star s)) hgh
  -- the relative inverse of a self-adjoint element of `E` again lies in `E`
  have hE : ∀ x : V, x ∈ (E : Set V) → star x = x → ∀ y : V, IsRelativeInverse x y →
      y ∈ (E : Set V) := by
    intro x hx hxs y hy
    exact NaturalExtension.map_relativeInverse_eq_of_selfAdjoint g h hxs hy hx
  have hsub : (starRegularClosure (starSubringClosure (Set.range φ)) : Set V) ⊆ (E : Set V) :=
    StarRegular.starRegularClosure_le_of_isRelativeInverse_selfAdjoint _ E hRE hE
  refine RingHom.ext fun v => ?_
  exact hsub (hgen v)

/-- **The `∗`-regular closure of `Δ` inside its own closure is everything.**  If `T` is a
`∗`-regular ring, `Δ ⊆ T` a `∗`-subring and `ΔT` a `∗`-subring of `T` whose image in `T`
contains `Δ`, then the `∗`-regular closure of `ΔT` inside `T` is all of `T`.

The point is that the approximating chain of `Δ` in `U` and that of `ΔT` in `T` run in parallel
(`starRegularChain_subset_image`), because `T`, being `∗`-regular, is closed under relative
inverses of its own elements and those coincide with the relative inverses computed in `U`. -/
theorem starRegularClosure_restrict_eq_top {U : Type*} [Ring U] [StarRing U] [IsStarRegular U]
    (Δ : StarSubring U) (ΔT : StarSubring ↥(starRegularClosure Δ))
    (h0 : (Δ : Set U) ⊆ Subtype.val '' (ΔT : Set ↥(starRegularClosure Δ))) :
    (starRegularClosure ΔT : Set ↥(starRegularClosure Δ)) = Set.univ := by
  haveI : IsStarRegular ↥(starRegularClosure Δ) :=
    StarRegular.starRegularClosure_isStarRegular Δ
  have hcl := Work.StarRegular.starRegularClosure_subset_image
    (A := starRegularClosure Δ) (R := Δ) (R' := ΔT)
    (NaturalExtension.starRegularChain_subset_image
      (A := starRegularClosure Δ) (R := Δ) (subset_starRegularClosure Δ) ΔT h0)
  refine Set.eq_univ_iff_forall.mpr fun v => ?_
  obtain ⟨w, hw, hwv⟩ := hcl (v.2 : (v : U) ∈ (starRegularClosure Δ : Set U))
  have : w = v := Subtype.ext hwv
  rwa [this] at hw

/-- **The inclusion of a `∗`-subring into its `∗`-regular closure is epic.**  This is the general
form of [JZLA20, Proposition 2.7]: no hypothesis is needed on `Δ` beyond the `∗`-regularity of
the ambient ring `U`. -/
theorem isEpic_inclusion_starRegularClosure {U : Type*} [Ring U] [StarRing U] [IsStarRegular U]
    (Δ : StarSubring U) :
    IsEpic (Subring.inclusion (show Δ.toSubring ≤ (starRegularClosure Δ).toSubring from
      subset_starRegularClosure Δ)) := by
  haveI : IsStarRegular ↥(starRegularClosure Δ) :=
    StarRegular.starRegularClosure_isStarRegular Δ
  let hle : Δ.toSubring ≤ (starRegularClosure Δ).toSubring := subset_starRegularClosure Δ
  let ΔT : StarSubring ↥(starRegularClosure Δ) :=
    starSubringClosure (Set.range (Subring.inclusion hle))
  -- the diagonal `∗`-subring maps onto `ΔT`
  have h0 : (Δ : Set U) ⊆ Subtype.val '' (ΔT : Set ↥(starRegularClosure Δ)) := by
    intro x hx
    exact ⟨⟨x, subset_starRegularClosure Δ hx⟩,
      subset_starSubringClosure _ ⟨⟨x, hx⟩, Subtype.ext rfl⟩, rfl⟩
  -- hence the intrinsic closure of `ΔT` is everything
  have htop : (starRegularClosure ΔT : Set ↥(starRegularClosure Δ)) = Set.univ :=
    starRegularClosure_restrict_eq_top Δ ΔT h0
  have hgen : ∀ v : ↥(starRegularClosure Δ),
      v ∈ (starRegularClosure (starSubringClosure (Set.range (Subring.inclusion hle))) :
        Set ↥(starRegularClosure Δ)) := by
    intro v
    rw [show starSubringClosure (Set.range (Subring.inclusion hle)) = ΔT from rfl, htop]
    exact Set.mem_univ v
  have hφ : ∀ s : ↥Δ.toSubring,
      Subring.inclusion hle (star s) = star (Subring.inclusion hle s) := fun _ => Subtype.ext rfl
  exact isEpic_of_starRegularClosure' (S := ↥Δ.toSubring) (V := ↥(starRegularClosure Δ))
    (Subring.inclusion hle) hφ hgen

theorem isEpic_inclusion_diagStarSubring_diagClosure {R U₁ U₂ : Type u} [Ring R] [StarRing R]
    [Ring U₁] [StarRing U₁] [Work.ORHughesFree.IsStarRegular U₁]
    [Ring U₂] [StarRing U₂] [Work.ORHughesFree.IsStarRegular U₂]
    (φ₁ : R →+* U₁) (φ₂ : R →+* U₂) (h₁ : ∀ x : R, φ₁ (star x) = star (φ₁ x))
    (h₂ : ∀ x : R, φ₂ (star x) = star (φ₂ x)) :
    Work.ORHughesFree.IsEpic (Subring.inclusion
      (show (Work.ORHughesFree.Section3.diagStarSubring φ₁ φ₂ h₁ h₂).toSubring ≤
        (Work.ORHughesFree.Section3.diagClosure φ₁ φ₂ h₁ h₂).toSubring from
        Work.ORHughesFree.subset_starRegularClosure _)) := by
  -- a product of `∗`-regular rings is `∗`-regular, so the closure ring and the ambient
  -- product are `∗`-regular
  haveI : IsStarRegular (U₁ × U₂) := isStarRegular_prod
  exact isEpic_inclusion_starRegularClosure (Work.ORHughesFree.Section3.diagStarSubring
    φ₁ φ₂ h₁ h₂)

end Work.Section3
