/-
The `L²`-vocabulary for the perturbed a priori estimate
(`Work.NN.PertApriori.pertAprioriEstimate`).

This module mirrors, for the *perturbed* `∂̄`-operator `dbarJ A` and its weight adjoint
`pertAdj A φ`, the vocabulary of the unperturbed chapter
(`Submission/Work/Hormander/Weights/aprioriDefs.lean`): the Hilbert space `C1` of coefficient
classes of `(0,1)`-forms, the class map `cls1`, the closed subspace `K` generated by the classes of
the closed test forms, and the weak `∂̄*`-relation used by the maximal-domain argument.
-/
import Mathlib
import Submission.Work.NN.Assemble.L2Forms
import Submission.Work.NN.Assemble.PertSetup
import Submission.Work.NN.Assemble.pertDefs
import Submission.Work.NN.Assemble.DbarJSolver
import Submission.Work.NN.Assemble.pertAdjRegular
import Submission.Work.NN.Final.Defs
import Submission.Work.NN.Core.PertL2Defs
import Submission.Work.NN.Core.wMeas_finiteOnCompacts
import Submission.Work.NN.Core.norm_sq_toLp_wMeas
import Submission.Work.NN.Core.inner_toLp_wPair0
import Submission.Work.NN.Core.memLp_pertAdj

noncomputable section

open MeasureTheory Set Filter
open scoped Topology ContDiff ENNReal NNReal

namespace Work.NN.PertApriori

/-- The flat model `ℂⁿ`. -/
abbrev Cn (n : ℕ) : Type := Fin n → ℂ

/-- The space of `(0,1)`-form-valued maps. -/
abbrev Frm (n : ℕ) : Type := Cn n → Cn n →L[ℝ] ℂ

/-- The space of almost complex structures. -/
abbrev AOp (n : ℕ) : Type := Cn n → Cn n →L[ℝ] Cn n

/-- The weighted measure `e^{-φ} dz`. -/
abbrev wMeas (n : ℕ) (φ : Cn n → ℝ) : Measure (Cn n) := Work.NN.Core.wMeas n φ

/-- The `L²_φ` space of functions (the target space of `pertAdj`). -/
abbrev V (n : ℕ) (φ : Cn n → ℝ) : Type := MeasureTheory.Lp ℂ 2 (wMeas n φ)

/-- The Hilbert space of `(0,1)`-coefficient classes.  Its norm is `√(wN1)`. -/
abbrev C1 (n : ℕ) (φ : Cn n → ℝ) : Type := PiLp 2 fun _ : Fin n => V n φ

/-- Admissible test forms: smooth, compactly supported, `J`-antilinear, supported in `pd n ρ 4`. -/
structure Adm (n : ℕ) (ρ : Fin n → ℝ) (A : AOp n) (f : Frm n) : Prop where
  sm : ∀ m : ℕ, ContDiff ℝ m f
  cs : HasCompactSupport f
  supp : ∀ z : Cn n, z ∉ Work.NN.Final.pd n ρ 4 → f z = 0
  anti : Work.NN.Assemble.IsJAntilinear A f

/-- **The class of a `(0,1)`-coefficient family** in the coefficient Hilbert space `C1`. -/
noncomputable def clsC {n : ℕ} {φ : Cn n → ℝ} (hφ : ∀ m : ℕ, ContDiff ℝ m φ)
    (F : Fin n → Cn n → ℂ) (hF : ∀ j : Fin n, ∀ m : ℕ, ContDiff ℝ m (F j))
    (hFs : ∀ j, HasCompactSupport (F j)) : C1 n φ :=
  haveI : MeasureTheory.IsFiniteMeasureOnCompacts (wMeas n φ) :=
    Work.NN.Core.wMeas_isFiniteMeasureOnCompacts (hφ 0).continuous
  WithLp.toLp 2 fun j => MemLp.toLp (F j)
    (((hF j 0).continuous).memLp_of_hasCompactSupport (hFs j))

/-- **The class of a `(0,1)`-form** in the coefficient Hilbert space `C1`. -/
noncomputable def cls1 {n : ℕ} {φ : Cn n → ℝ} (hφ : ∀ m : ℕ, ContDiff ℝ m φ)
    (f : Frm n) (hf : ∀ m : ℕ, ContDiff ℝ m f) (hfs : HasCompactSupport f) : C1 n φ :=
  clsC hφ (Work.NN.Assemble.pertCoef f) (fun j m => Work.NN.Assemble.contDiff_pertCoef hf j m)
    (fun j => Work.NN.Assemble.hasCompactSupport_pertCoef hfs j)

/-- **The class of a function** in `V`. -/
noncomputable def clsfun {n : ℕ} {φ : Cn n → ℝ} (hφ : ∀ m : ℕ, ContDiff ℝ m φ)
    (h : Cn n → ℂ) (hh : ∀ m : ℕ, ContDiff ℝ m h) (hhs : HasCompactSupport h) : V n φ :=
  haveI : MeasureTheory.IsFiniteMeasureOnCompacts (wMeas n φ) :=
    Work.NN.Core.wMeas_isFiniteMeasureOnCompacts (hφ 0).continuous
  MemLp.toLp h ((hh 0).continuous.memLp_of_hasCompactSupport hhs)

/-- The `j`-th coefficient of `∂̄_J ψ` for `J = JstdCn n + A`. -/
noncomputable def exactCoef {n : ℕ} (A : AOp n) (ψ : Cn n → ℂ) (j : Fin n) : Cn n → ℂ :=
  fun z => Work.NN.Core.dbarCn (Work.NN.Core.JstdCn n + A) ψ z (Work.NN.Assemble.eb n j)

/-- The explicit form of the coefficients of `∂̄_J ψ`. -/
lemma exactCoef_eq {n : ℕ} (A : AOp n) (ψ : Cn n → ℂ) (j : Fin n) :
    exactCoef A ψ j = fun z => (1/2 : ℂ) * (fderiv ℝ ψ z (Work.NN.Assemble.eb n j)
      + Complex.I * fderiv ℝ ψ z ((Work.NN.Core.JstdCn n + A) z (Work.NN.Assemble.eb n j))) := by
  funext z
  exact Work.NN.Core.dbarCn_apply (Work.NN.Core.JstdCn n + A) ψ z (Work.NN.Assemble.eb n j)

/-- Smoothness of the coefficients of `∂̄_J ψ`. -/
lemma contDiff_exactCoef {n : ℕ} {A : AOp n} (hA : ∀ m : ℕ, ContDiff ℝ m A)
    {ψ : Cn n → ℂ} (hψ : ∀ m : ℕ, ContDiff ℝ m ψ) (j : Fin n) (m : ℕ) :
    ContDiff ℝ m (exactCoef A ψ j) := by
  have h1 : ContDiff ℝ m (fun z : Cn n => fderiv ℝ ψ z (Work.NN.Assemble.eb n j)) :=
    Work.NN.Assemble.contDiff_fderiv_apply_varying (n := n) (E := ℂ) hψ
      (fun _ => contDiff_const) m
  have hJv : ∀ m : ℕ, ContDiff ℝ m
      (fun z : Cn n => (Work.NN.Core.JstdCn n + A) z (Work.NN.Assemble.eb n j)) :=
    fun m => ((contDiff_const.add (hA m)).clm_apply
      (contDiff_const (c := (Work.NN.Assemble.eb n j))))
  have h2 : ContDiff ℝ m
      (fun z : Cn n => fderiv ℝ ψ z ((Work.NN.Core.JstdCn n + A) z (Work.NN.Assemble.eb n j))) :=
    Work.NN.Assemble.contDiff_fderiv_apply_varying (n := n) (E := ℂ) hψ hJv m
  rw [exactCoef_eq]
  exact contDiff_const.mul (h1.add (contDiff_const.mul h2))

/-- Compact support of the coefficients of `∂̄_J ψ`. -/
lemma hasCompactSupport_exactCoef {n : ℕ} {A : AOp n} (hA : ∀ m : ℕ, ContDiff ℝ m A)
    {ψ : Cn n → ℂ} (hψ : ∀ m : ℕ, ContDiff ℝ m ψ) (hψs : HasCompactSupport ψ) (j : Fin n) :
    HasCompactSupport (exactCoef A ψ j) := by
  have h1 : HasCompactSupport (fun z : Cn n => fderiv ℝ ψ z (Work.NN.Assemble.eb n j)) :=
    Work.NN.Assemble.hasCompactSupport_fderiv_apply_varying hψs _
  have h2 : HasCompactSupport
      (fun z : Cn n => fderiv ℝ ψ z ((Work.NN.Core.JstdCn n + A) z (Work.NN.Assemble.eb n j))) :=
    Work.NN.Assemble.hasCompactSupport_fderiv_apply_varying hψs _
  rw [exactCoef_eq]
  have h3 : HasCompactSupport (fun z : Cn n =>
      Complex.I * fderiv ℝ ψ z ((Work.NN.Core.JstdCn n + A) z (Work.NN.Assemble.eb n j))) :=
    h2.mul_left
  have h4 : HasCompactSupport (fun z : Cn n => fderiv ℝ ψ z (Work.NN.Assemble.eb n j)
      + Complex.I * fderiv ℝ ψ z ((Work.NN.Core.JstdCn n + A) z (Work.NN.Assemble.eb n j))) :=
    h1.add h3
  exact h4.mul_left


/-- The class of the exact form `∂̄_J ψ` in `C1`. -/
noncomputable def clsExact {n : ℕ} {φ : Cn n → ℝ} (hφ : ∀ m : ℕ, ContDiff ℝ m φ)
    {A : AOp n} (hA : ∀ m : ℕ, ContDiff ℝ m A) (ψ : Cn n → ℂ)
    (hψ : ∀ m : ℕ, ContDiff ℝ m ψ) (hψs : HasCompactSupport ψ) : C1 n φ :=
  clsC hφ (exactCoef A ψ) (fun j m => contDiff_exactCoef hA hψ j m)
    (fun j => hasCompactSupport_exactCoef hA hψ hψs j)

/-- The submodule of `C1` generated by the classes of the **closed** admissible `(0,1)`-forms. -/
noncomputable def closedRange {n : ℕ} {ρ : Fin n → ℝ} {A : AOp n} {φ : Cn n → ℝ}
    (hφ : ∀ m : ℕ, ContDiff ℝ m φ) : Submodule ℂ (C1 n φ) :=
  Submodule.span ℂ {x : C1 n φ | ∃ (f : Frm n) (hfam : Adm n ρ A f),
    (∀ z V W, Work.NN.Assemble.dbarJ A f z V W = 0) ∧ x = cls1 hφ f hfam.sm hfam.cs}

/-- **The closed subspace `K`**: the closure in `C1` of the classes of the closed admissible test
forms. -/
noncomputable def K {n : ℕ} {ρ : Fin n → ℝ} {A : AOp n} {φ : Cn n → ℝ}
    (hφ : ∀ m : ℕ, ContDiff ℝ m φ) : Submodule ℂ (C1 n φ) :=
  (closedRange (ρ := ρ) (A := A) (φ := φ) hφ).topologicalClosure

theorem K_hasOrthogonalProjection {n : ℕ} {ρ : Fin n → ℝ} {A : AOp n} {φ : Cn n → ℝ}
    (hφ : ∀ m : ℕ, ContDiff ℝ m φ) :
    (K (ρ := ρ) (A := A) (φ := φ) hφ).HasOrthogonalProjection :=
  haveI : CompleteSpace (K (ρ := ρ) (A := A) (φ := φ) hφ) :=
    Submodule.topologicalClosure.completeSpace (closedRange (ρ := ρ) (A := A) (φ := φ) hφ)
  inferInstance

/-- The class of a closed admissible form lies in `K`. -/
theorem cls1_mem_K {n : ℕ} {ρ : Fin n → ℝ} {A : AOp n} {φ : Cn n → ℝ}
    (hφ : ∀ m : ℕ, ContDiff ℝ m φ)
    {f : Frm n} (hfam : Adm n ρ A f) (hfcl : ∀ z V W, Work.NN.Assemble.dbarJ A f z V W = 0) :
    cls1 hφ f hfam.sm hfam.cs ∈ K (ρ := ρ) (A := A) (φ := φ) hφ :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨f, hfam, hfcl, rfl⟩)

/-- **The weak `∂̄*`-relation**: `x ∈ C1` has weak `∂̄*` equal to `w` when
`⟪w, ψ⟫ = ⟪x, cls1 (∂̄_J ψ)⟫` for every smooth compactly supported function `ψ`. -/
def IsWeakStar {n : ℕ} {ρ : Fin n → ℝ} {A : AOp n} {φ : Cn n → ℝ}
    (hφ : ∀ m : ℕ, ContDiff ℝ m φ) (hA : ∀ m : ℕ, ContDiff ℝ m A) (x : C1 n φ) (w : V n φ) : Prop :=
  ∀ (ψ : Cn n → ℂ) (hψ : ∀ m : ℕ, ContDiff ℝ m ψ) (hψs : HasCompactSupport ψ),
    inner ℂ w (clsfun hφ ψ hψ hψs) = inner ℂ x (clsExact hφ hA ψ hψ hψs)

end Work.NN.PertApriori
