import Mathlib
import Submission.Work.EKLComp.Hcond
import Submission.Work.EKLComp.Hpart.sum_negMulLog_chain
import Submission.Work.EKLComp.HcondJoin.partIdx_indicator_sum
import Submission.Work.EKLComp.HcondJoin.integral_partIndicator_sum
import Submission.Work.EKLComp.condExp_partSigmaFam

/-!
# Chain rule for `Hfam`: `H(A ∨ B) = H(A) + H(B | σ(A))`

For two finite measurable partitions `A : ι → Set X`, `B : κ → Set X` of a probability space
`(X, μ)`, the entropy of the join `A ∨ B` (whose atoms are `A i ∩ B j`) is the entropy of `A`
plus the conditional entropy of `B` given the σ-algebra generated by `A`:

`H_μ(A ∨ B) = H_μ(A) + H_μ(B | σ(A))`.

Both sides are computed atom by atom.  Writing `pᵢⱼ = μ (A i ∩ B j)` and `pᵢ = μ (A i)`
(note `∑_j pᵢⱼ = pᵢ`), the elementary chain rule for `x ↦ -x log x`
(`Work.EKLComp.Hpart.sum_negMulLog_chain`, applied with `c = pᵢⱼ` and total mass `pᵢ`) gives

`∑_j negMulLog pᵢⱼ = negMulLog pᵢ + pᵢ * ∑_j negMulLog (pᵢⱼ / pᵢ)`.

Summing over `i` produces `H_μ(A)` plus the mass-weighted entropy of the normalized row, and the
latter is exactly `H_μ(B | σ(A))`: the conditional expectation of `1_{B j}` on the σ-algebra of
`A` is the function that is constant on the atom `A i` with value `pᵢⱼ / pᵢ`
(`Work.EKLComp.condExp_partSigmaFam`), so integrating `∑_j negMulLog (·)` over the atom `A i`
contributes exactly `pᵢ * ∑_j negMulLog (pᵢⱼ / pᵢ)`
(`Work.EKLComp.HcondJoin.integral_partIndicator_sum`).
-/

open MeasureTheory
open scoped BigOperators

namespace Work.EKLComp

theorem HcondFam_join {X : Type} [mX : MeasurableSpace X] (μ : MeasureTheory.Measure X) [MeasureTheory.IsProbabilityMeasure μ]
    {ι κ : Type} [Fintype ι] [Fintype κ] (A : ι → Set X) (B : κ → Set X)
    (hA : Work.EKLComp.Core.IsMPart A) (hB : Work.EKLComp.Core.IsMPart B) :
    Work.EKLContract.Hfam μ (fun p : ι × κ => A p.1 ∩ B p.2) =
      Work.EKLContract.Hfam μ A + Work.EKLComp.Core.HcondFam X μ B (Work.EKLComp.Core.partSigmaFam A) := by
  classical
  -- Atom masses: `pij i j = μ (A i ∩ B j)`, `pi i = μ (A i)`, a row-sum of the former.
  set pij : ι → κ → ℝ := fun i j => (μ (A i ∩ B j)).toReal with hpij
  set pi : ι → ℝ := fun i => (μ (A i)).toReal with hpi
  have hrow : ∀ i, ∑ j, pij i j = pi i := by
    intro i
    have h1 : ∑ j, μ (A i ∩ B j) = μ (A i) :=
      Work.EKLComp.Core.IsMPart.sum_measure_inter μ hB (hA.measurable i)
    have h2 : (∑ j, μ (A i ∩ B j)).toReal = ∑ j, (μ (A i ∩ B j)).toReal :=
      ENNReal.toReal_sum (fun j _ => measure_ne_top μ _)
    simp only [hpij, hpi]
    rw [← h2, h1]
  -- The elementary chain rule, row by row.
  have hchain : ∀ i, ∑ j, Real.negMulLog (pij i j) =
      Real.negMulLog (pi i) + pi i * ∑ j, Real.negMulLog (pij i j / pi i) := by
    intro i
    have hc := Work.EKLComp.Hpart.sum_negMulLog_chain (pij i) (fun j => ENNReal.toReal_nonneg)
    rw [hrow i] at hc
    rw [hc, Finset.mul_sum]
  -- The conditional entropy is the mass-weighted entropy of the normalized rows.
  have hcond : Work.EKLComp.Core.HcondFam X μ B (Work.EKLComp.Core.partSigmaFam A) =
      ∑ i, pi i * ∑ j, Real.negMulLog (pij i j / pi i) := by
    set c : ι → κ → ℝ := fun i j => ((μ (A i)).toReal)⁻¹ * (μ (B j ∩ A i)).toReal with hc
    have hc_eq : ∀ i j, c i j = pij i j / pi i := by
      intro i j
      simp only [hc, hpij, hpi, div_eq_mul_inv]
      rw [Set.inter_comm (B j) (A i), mul_comm]
    -- The conditional expectation of `1_{B j}` is the atom-wise constant `c · j`.
    have hae : (fun x => ∑ j, Real.negMulLog (MeasureTheory.condExp (Work.EKLComp.Core.partSigmaFam A) μ ((B j).indicator (fun _ => (1:ℝ))) x))
        =ᵐ[μ] fun x => ∑ i, (A i).indicator (fun _ => ∑ j, Real.negMulLog (c i j)) x := by
      have h1 : ∀ᵐ x ∂μ, ∀ j ∈ (Finset.univ : Finset κ),
          Real.negMulLog (MeasureTheory.condExp (Work.EKLComp.Core.partSigmaFam A) μ ((B j).indicator (fun _ => (1:ℝ))) x)
            = Real.negMulLog (∑ i, (A i).indicator (fun _ => c i j) x) := by
        rw [Finset.eventually_all]
        intro j _
        filter_upwards [condExp_partSigmaFam μ hA (B j) (hB.measurable j)] with x hx
        simp only [hx, hc]
      filter_upwards [h1] with x hx
      calc ∑ j, Real.negMulLog (MeasureTheory.condExp (Work.EKLComp.Core.partSigmaFam A) μ ((B j).indicator (fun _ => (1:ℝ))) x)
          = ∑ j, Real.negMulLog (∑ i, (A i).indicator (fun _ => c i j) x) :=
            Finset.sum_congr rfl (fun j hj => hx j hj)
        _ = ∑ j, Real.negMulLog (c (Work.EKLComp.Core.partIdx A hA x) j) := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [HcondJoin.partIdx_indicator_sum hA (fun i => c i j) x]
        _ = ∑ i, (A i).indicator (fun _ => ∑ j, Real.negMulLog (c i j)) x :=
            (HcondJoin.partIdx_indicator_sum hA (fun i => ∑ j, Real.negMulLog (c i j)) x).symm
    have hB' : ∫ x, (∑ i, (A i).indicator (fun _ => ∑ j, Real.negMulLog (c i j)) x) ∂μ
        = ∑ i, pi i * ∑ j, Real.negMulLog (c i j) :=
      HcondJoin.integral_partIndicator_sum μ hA (fun i => ∑ j, Real.negMulLog (c i j))
    unfold Work.EKLComp.Core.HcondFam
    rw [MeasureTheory.integral_congr_ae hae, hB']
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [hc_eq]
  -- Reassemble: `H(A ∨ B) = ∑ i ∑ j negMulLog pij`, and `H(A) = ∑ i negMulLog pi`.
  have hL : Work.EKLContract.Hfam μ (fun p : ι × κ => A p.1 ∩ B p.2) =
      ∑ i, ∑ j, Real.negMulLog (pij i j) := by
    simp only [Work.EKLContract.Hfam, hpij]
    rw [Work.EKLComp.Core.sum_prod_univ]
  have hR : Work.EKLContract.Hfam μ A = ∑ i, Real.negMulLog (pi i) := by
    simp only [Work.EKLContract.Hfam, hpi]
  rw [hL, hR, hcond, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun i _ => hchain i)

end Work.EKLComp
