/-! ## 1. The arithmetic of balls in `U` -/

/-- A crude bound for the inverse. -/
def ivent (a : ℝ) : ℝ := 6 * a * (1 + a) ^ 2 + 1

theorem Uball_mul {U : Subgroup SL3} {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    ∀ u ∈ Uball U a, ∀ v ∈ Uball U b, u * v ∈ Uball U (a + b + 3 * a * b) := by
  intro u hu v hv
  refine ⟨U.mul_mem hu.1 hv.1, fun i j => ?_⟩
  set A : Matrix (Fin 3) (Fin 3) ℝ := (u : Matrix (Fin 3) (Fin 3) ℝ) - 1 with hAdef
  set B : Matrix (Fin 3) (Fin 3) ℝ := (v : Matrix (Fin 3) (Fin 3) ℝ) - 1 with hBdef
  have hAb : ∀ k l, |A k l| < a := by
    intro k l; rw [hAdef, Matrix.sub_apply]; exact hu.2 k l
  have hBb : ∀ k l, |B k l| < b := by
    intro k l; rw [hBdef, Matrix.sub_apply]; exact hv.2 k l
  have hcoe : ((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) = (1 + A) * (1 + B) := by
    rw [Matrix.SpecialLinearGroup.coe_mul, hAdef, hBdef]
    ext k l; simp
  rw [hcoe]
  have hexp : ((1 + A) * (1 + B)) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j
      = A i j + B i j + (A * B) i j := by
    rw [Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
      Matrix.one_mul, Matrix.add_apply, Matrix.add_apply, Matrix.add_apply]
    ring
  rw [hexp, Matrix.mul_apply]
  have hsum : |∑ k : Fin 3, A i k * B k j| ≤ 3 * (a * b) := by
    calc |∑ k : Fin 3, A i k * B k j|
        ≤ ∑ k : Fin 3, |A i k * B k j| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ k : Fin 3, |A i k| * |B k j| := by simp [abs_mul]
      _ ≤ ∑ _k : Fin 3, a * b := by
          refine Finset.sum_le_sum (fun k _ => ?_)
          exact mul_le_mul (le_of_lt (hAb i k)) (le_of_lt (hBb k j)) (abs_nonneg _) ha
      _ = 3 * (a * b) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
  have h1 : |A i j + B i j| < a + b :=
    lt_of_le_of_lt (abs_add_le _ _) (add_lt_add (hAb i j) (hBb i j))
  calc |A i j + B i j + ∑ k : Fin 3, A i k * B k j|
      ≤ |A i j + B i j| + |∑ k : Fin 3, A i k * B k j| := abs_add_le _ _
    _ < (a + b) + 3 * (a * b) := add_lt_add_of_lt_of_le h1 hsum
    _ = a + b + 3 * a * b := by ring

theorem Uball_inv {U : Subgroup SL3} {a : ℝ} (ha : 0 ≤ a) :
    ∀ u ∈ Uball U a, u⁻¹ ∈ Uball U (ivent a) := by
  intro u hu
  have hent : ∀ k l, |((u : Matrix (Fin 3) (Fin 3) ℝ) k l)| ≤ 1 + a := by
    intro k l
    have h1 : |((u : Matrix (Fin 3) (Fin 3) ℝ) k l - (1 : Matrix (Fin 3) (Fin 3) ℝ) k l)| < a :=
      hu.2 k l
    have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ 1 := by
      rw [Matrix.one_apply]; split_ifs <;> simp
    calc |((u : Matrix (Fin 3) (Fin 3) ℝ) k l)|
        = |((u : Matrix (Fin 3) (Fin 3) ℝ) k l - (1 : Matrix (Fin 3) (Fin 3) ℝ) k l)
            + (1 : Matrix (Fin 3) (Fin 3) ℝ) k l| := by rw [sub_add_cancel]
      _ ≤ |((u : Matrix (Fin 3) (Fin 3) ℝ) k l - (1 : Matrix (Fin 3) (Fin 3) ℝ) k l)|
            + |(1 : Matrix (Fin 3) (Fin 3) ℝ) k l| := abs_add_le _ _
      _ ≤ a + 1 := add_le_add (le_of_lt h1) h2
      _ = 1 + a := by ring
  have hinv : ∀ k l, |((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ 2 * (1 + a) ^ 2 := by
    intro k l
    rw [Matrix.SpecialLinearGroup.coe_inv]
    exact Work.EKLProd.abs_adjugate_entry_le (by linarith) hent k l
  refine ⟨U.inv_mem hu.1, fun i j => ?_⟩
  have hcoe : (((u⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) - 1
      = ((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) * (1 - (u : Matrix (Fin 3) (Fin 3) ℝ)) := by
    rw [Matrix.mul_sub, Matrix.mul_one]
    have hmul : (((u⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ)
        * ((u : SL3) : Matrix (Fin 3) (Fin 3) ℝ) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
        Matrix.SpecialLinearGroup.coe_one]
    rw [hmul]
  have h : |(((u⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
      = |((((u⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) * (1 - (u : Matrix (Fin 3) (Fin 3) ℝ))) i j| := by
    rw [← hcoe, Matrix.sub_apply]
  rw [h, Matrix.mul_apply]
  have hterm : ∀ k : Fin 3,
      |((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k
        * (1 - (u : Matrix (Fin 3) (Fin 3) ℝ)) k j| ≤ 2 * (1 + a) ^ 2 * a := by
    intro k
    rw [abs_mul]
    have h1 : |((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k| ≤ 2 * (1 + a) ^ 2 := hinv i k
    have h2 : |(1 - (u : Matrix (Fin 3) (Fin 3) ℝ)) k j| ≤ a := by
      rw [Matrix.sub_apply, abs_sub_comm]
      exact le_of_lt (hu.2 k j)
    have h3 : (0:ℝ) ≤ 2 * (1 + a) ^ 2 := by positivity
    calc |((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k|
          * |(1 - (u : Matrix (Fin 3) (Fin 3) ℝ)) k j|
        ≤ (2 * (1 + a) ^ 2) * a := mul_le_mul h1 h2 (abs_nonneg _) h3
      _ = 2 * (1 + a) ^ 2 * a := by ring
  calc |∑ k : Fin 3, ((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k
        * (1 - (u : Matrix (Fin 3) (Fin 3) ℝ)) k j|
      ≤ ∑ k : Fin 3, |((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k
        * (1 - (u : Matrix (Fin 3) (Fin 3) ℝ)) k j| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _k : Fin 3, 2 * (1 + a) ^ 2 * a := Finset.sum_le_sum (fun k _ => hterm k)
    _ = 3 * (2 * (1 + a) ^ 2 * a) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        norm_num
    _ < ivent a := by
        rw [ivent]; nlinarith [sq_nonneg (1 + a)]


/-- `Ucl U a ⊆ Uball U (a+1)`. -/
theorem Ucl_subset_Uball_succ {U : Subgroup SL3} {a : ℝ} (ha : 0 ≤ a) :
    Ucl U a ⊆ Uball U (a + 1) := by
  intro g hg
  refine ⟨hg.1, fun i j => lt_of_le_of_lt (hg.2 i j) ?_⟩
  linarith

/-! ## 2. Transversals, collars, flowers -/

/-- All points of `C` have trivial `U`-stabiliser. -/
def FreeOn (U : Subgroup SL3) (C : Set X3) : Prop :=
  ∀ x ∈ C, ∀ u ∈ U, u • x = x → u = 1

/-- **`e`-separation**: no two points of `C` are related by an element of `Uball U e`. -/
def SepOn (U : Subgroup SL3) (e : ℝ) (C : Set X3) : Prop :=
  ∀ x ∈ C, ∀ y ∈ C, ∀ v ∈ Uball U e, y = v • x → y = x

/-- The `R`-collar of a set `C ⊆ X₃`: the union of the `R`-plaques of its points. -/
def collar (U : Subgroup SL3) (R : ℝ) (C : Set X3) : Set X3 :=
  (fun p : SL3 × X3 => p.1 • p.2) '' ((Uball U R) ×ˢ C)

theorem collar_eq_iUnion (U : Subgroup SL3) (R : ℝ) (C : Set X3) :
    collar U R C = ⋃ c ∈ C, Upla U R c := by
  ext y
  simp only [collar, Upla, Set.mem_image, Set.mem_prod, Set.mem_iUnion, Set.mem_setOf_eq,
    exists_prop, Subtype.exists]
  constructor
  · rintro ⟨⟨g, c⟩, ⟨hg, hc⟩, rfl⟩
    exact ⟨c, hc, g, hg, rfl⟩
  · rintro ⟨c, hc, g, hg, rfl⟩
    exact ⟨(g, c), ⟨hg, hc⟩, rfl⟩

/-- The σ-algebra of a flower with transversal `C`, collar radius `R` and countable family
`W` of "slices". -/
def flowerSigma (U : Subgroup SL3) (R : ℝ) (C : Set X3) (W : ℕ → Set X3) :
    MeasurableSpace X3 :=
  MeasurableSpace.generateFrom (Set.range (fun i => collar U R (C ∩ W i)))


