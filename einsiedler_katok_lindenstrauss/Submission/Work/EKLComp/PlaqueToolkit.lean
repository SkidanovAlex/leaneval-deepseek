import Mathlib
import Submission.Work.EKLContract.Interfaces
import Submission.Work.EKLProd.borelOrbitImage
import Submission.Work.EKLProd.atom_generateFrom_singleton
import Submission.Work.EKLProd.shape_orbitImage
import Submission.Work.EKLProd.inv_entries_bound
import Submission.Work.EKLProd.condExp_generateFrom_singleton
import Submission.Work.EKLProd.plaque_shape_mass

/-!
# C5b plaque tooling

The condexp axiom of `IsLeafwise` quantifies over *all* plaque algebras; to use it one must
produce one.  This module builds the simplest ones and derives their first consequences — the
"step 1" tooling of `Submission/Work/EKLComp/ProductPlan.md`:

* `orbitPlaque`, `plaqueSigma`, `isPlaqueAlgebra_orbitPlaque` — for a closed subgroup `U`, a point
  `x₀` with free `U`-orbit, and `ε > 0`, the σ-algebra generated by the single orbit plaque
  `(u ↦ u • x₀) '' (V ε ∩ U)` is a plaque algebra with `Z` the plaque itself (its atom at
  `x ∈ Z` is `Z`, a `U`-plaque), and the shape at `u₀ • x₀` is `{u ∈ U | u * u₀ ∈ V ε}`;
* `plaque_average_eq` — the `condexp` field in conditional-average form;
* `plaque_shape_mass_ae` — the plaque shape has finite positive `ν x`-mass a.e. (from
  `EKLProd/plaque_shape_mass`);
* `leafwise_null_local` — the local form of Pisa §8.9: a `μ`-null set is `ν x`-null along the
  plaque.

The module is `sorry`-free; `prove_Product.lean` imports it and contains the component itself.
-/

open MeasureTheory Topology Filter
open scoped ENNReal

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLComp
open Work.EKLContract

/-! ## Orbit plaques -/

/-- The `V ε`-orbit plaque of `U` at `x₀`: the image of `V ε ∩ U` under `u ↦ u • x₀`. -/
def orbitPlaque (U : Subgroup SL3) (x₀ : X3) (ε : ℝ) : Set X3 :=
  (fun u : SL3 => u • x₀) '' (V ε ∩ (U : Set SL3))

/-- The σ-algebra generated by a single orbit plaque.  Kept as a `def` (rather than a local
`set`) so that it is not picked up by instance search when a statement mentions `MeasurableSet`
for the ambient Borel structure of `X₃` (the instance-capture hazard of `NOTES.md`). -/
abbrev plaqueSigma (U : Subgroup SL3) (x₀ : X3) (ε : ℝ) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom {orbitPlaque U x₀ ε}

theorem isOpen_V (ε : ℝ) : IsOpen (V ε) := by
  have h : V ε = ⋂ i : Fin 3, ⋂ j : Fin 3,
      {g : SL3 | |g i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < ε} := by
    ext g; simp [V]
  rw [h]
  refine isOpen_iInter_of_finite (fun i => isOpen_iInter_of_finite (fun j => ?_))
  apply isOpen_lt _ continuous_const
  fun_prop

theorem isOpen_V_mul (ε : ℝ) (u₀ : SL3) : IsOpen {g : SL3 | g * u₀ ∈ V ε} := by
  rw [show {g : SL3 | g * u₀ ∈ V ε} = ⋂ i : Fin 3, ⋂ j : Fin 3,
      {g : SL3 | |(g * u₀) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < ε} from by
    ext g; simp [V]]
  refine isOpen_iInter_of_finite (fun i => isOpen_iInter_of_finite (fun j => ?_))
  apply isOpen_lt _ continuous_const
  fun_prop

theorem mul_entries_le (A B : SL3) (i j : Fin 3) {sA sB : ℝ} (hA : ∀ k l, |A k l| ≤ sA)
    (hB : ∀ k l, |B k l| ≤ sB) (hsA : 0 ≤ sA) (hsB : 0 ≤ sB) : |(A * B) i j| ≤ 3 * sA * sB := by
  have hmul : (A * B) i j = ∑ k : Fin 3, A i k * B k j := Matrix.mul_apply
  rw [hmul]
  calc |∑ k : Fin 3, A i k * B k j| ≤ ∑ k : Fin 3, |A i k * B k j| := Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin 3, |A i k| * |B k j| := by simp [abs_mul]
    _ ≤ ∑ _k : Fin 3, sA * sB :=
        Finset.sum_le_sum (fun k _ => mul_le_mul (hA i k) (hB k j) (abs_nonneg _) hsA)
    _ = 3 * (sA * sB) := by simp [Finset.sum_const, Fintype.card_fin]
    _ = 3 * sA * sB := by ring

theorem mem_V_entries_le (ε : ℝ) {u : SL3} (hu : u ∈ V ε) (i j : Fin 3) : |u i j| ≤ 1 + ε := by
  have h : |u i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < ε := hu i j
  have h1 : |u i j| ≤ |u i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
      + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by
    have := abs_add_le (u i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
      ((1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
    simpa using this
  have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
    rw [Matrix.one_apply]; split <;> simp
  linarith

/-- **The plaque algebra of an orbit plaque.**  For a closed subgroup `U`, a point `x₀` whose
`U`-orbit is free, and `ε > 0`, the σ-algebra generated by the single set
`P = (u ↦ u • x₀) '' (V ε ∩ U)` is a plaque algebra for `U` with `Z = P`: its atom at `x ∈ P` is
`P`, which is a `U`-plaque, and the shape at `x = u₀ • x₀` is the right translate
`{u ∈ U | u * u₀ ∈ V ε}` of `V ε ∩ U`. -/
theorem isPlaqueAlgebra_orbitPlaque {U : Subgroup SL3} (hU : IsClosed (U : Set SL3))
    {x₀ : X3} {ε : ℝ} (hε : 0 < ε)
    (hinj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂) :
    IsPlaqueAlgebra U (orbitPlaque U x₀ ε) (plaqueSigma U x₀ ε) := by
  haveI : Nonempty (Subtype (fun _ : ℝ => True)) := ⟨⟨0, trivial⟩⟩
  refine ⟨?_, ⟨{orbitPlaque U x₀ ε}, Set.countable_singleton _, rfl⟩, ?_, ?_⟩
  · refine MeasurableSpace.generateFrom_le (fun t ht => ?_)
    rw [Set.mem_singleton_iff] at ht
    rw [ht]
    exact Work.EKLProd.borelOrbitImage U hU x₀ ε
  · exact MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton _)
  · intro x hx
    rcases hx with ⟨u₀, hu₀, rfl⟩
    have hu₀U : u₀ ∈ U := hu₀.2
    have hu₀V : u₀ ∈ V ε := hu₀.1
    have hatom : atom (MeasurableSpace.generateFrom {orbitPlaque U x₀ ε})
        (u₀ • x₀) = orbitPlaque U x₀ ε :=
      Work.EKLProd.atom_generateFrom_singleton _ _ ⟨u₀, hu₀, rfl⟩
    -- the inverse-entry bound
    obtain ⟨C, hC⟩ := Work.EKLProd.inv_entries_bound ε hε
    have hC0 : 0 ≤ C := by
      have h1 : (1 : SL3) ∈ V ε := by
        intro i j
        have : (1 : SL3) i j = (1 : Matrix (Fin 3) (Fin 3) ℝ) i j := rfl
        rw [this, sub_self, abs_zero]; exact hε
      have := hC 1 h1 0 0
      have h2 : ((1 : SL3)⁻¹) 0 0 = 1 := by simp
      rw [h2] at this
      have : (1 : ℝ) ≤ C := by simpa using this
      linarith
    have hshape : shape (plaqueSigma U x₀ ε) U (u₀ • x₀)
        = {u : SL3 | u ∈ U ∧ u * u₀ ∈ V ε} := by
      unfold plaqueSigma orbitPlaque
      rw [Work.EKLProd.shape_orbitImage U x₀ (V ε ∩ (U : Set SL3)) Set.inter_subset_right hinj u₀ hu₀]
      ext u
      constructor
      · rintro ⟨huU, huB⟩
        exact ⟨huU, huB.1⟩
      · rintro ⟨huU, huV⟩
        exact ⟨huU, huV, mul_mem huU hu₀U⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hatom]
    · rw [hatom]
      rintro y ⟨u, hu, rfl⟩
      refine ⟨u * u₀⁻¹, U.mul_mem hu.2 (U.inv_mem hu₀U), ?_⟩
      show (u * u₀⁻¹) • (u₀ • x₀) = u • x₀
      rw [mul_smul, inv_smul_smul]
    · refine ⟨{g : SL3 | g * u₀ ∈ V ε}, isOpen_V_mul ε u₀, ?_⟩
      rw [hshape]
      ext u
      constructor
      · rintro ⟨huU, huV⟩
        exact ⟨huV, huU⟩
      · rintro ⟨huV, huU⟩
        exact ⟨huU, huV⟩
    · refine ⟨3 * (1 + ε) * C, ?_⟩
      intro u hu i j
      rw [hshape] at hu
      obtain ⟨huU, huV⟩ := hu
      have h1 : |u i j| = |((u * u₀) * u₀⁻¹) i j| := by rw [mul_inv_cancel_right]
      rw [h1]
      have hA : ∀ k l, |(u * u₀) k l| ≤ 1 + ε := fun k l => mem_V_entries_le ε huV k l
      have hB : ∀ k l, |u₀⁻¹ k l| ≤ C := fun k l => hC u₀ hu₀V k l
      have h := mul_entries_le (u * u₀) u₀⁻¹ i j hA hB (by linarith) hC0
      linarith [h]

/-- **The condexp field in conditional-average form.**  For the plaque algebra of an orbit
plaque, the condexp axiom of `IsLeafwise` says that the conditional average of `f` over the
plaque is the `ν x`-average of `f (· • x)` over the shape, normalised. -/
theorem plaque_average_eq {μ : Measure X3} [IsProbabilityMeasure μ] {U : Subgroup SL3}
    {ν : X3 → Measure SL3} {X' : Set X3} (hν : IsLeafwise μ U ν X') {x₀ : X3} {ε : ℝ} (hε : 0 < ε)
    (hU : IsClosed (U : Set SL3))
    (hinj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂)
    (hP : μ (orbitPlaque U x₀ ε) ≠ 0)
    (f : X3 → ℝ) (hf : Measurable[instMeasurableSpaceX3] f) (hfb : ∃ C, ∀ y, |f y| ≤ C) :
    ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)),
      (μ (orbitPlaque U x₀ ε)).toReal⁻¹ * ∫ y in orbitPlaque U x₀ ε, f y ∂μ
        = (∫ u in shape (plaqueSigma U x₀ ε) U x, f (u • x) ∂(ν x))
            / (ν x (shape (plaqueSigma U x₀ ε) U x)).toReal := by
  have hpla : IsPlaqueAlgebra U (orbitPlaque U x₀ ε)
      (MeasurableSpace.generateFrom {orbitPlaque U x₀ ε}) :=
    isPlaqueAlgebra_orbitPlaque hU hε hinj
  have hZ : MeasurableSet (orbitPlaque U x₀ ε) := hpla.1 _ hpla.2.2.1
  have hfint : Integrable f μ := by
    obtain ⟨C, hC⟩ := hfb
    refine Integrable.of_bound (hf.aestronglyMeasurable) C ?_
    filter_upwards with y
    rw [Real.norm_eq_abs]; exact hC y
  have hfld := hν.condexp (orbitPlaque U x₀ ε) (plaqueSigma U x₀ ε) hpla f hf hfb
  have hce := Work.EKLProd.condExp_generateFrom_singleton μ (orbitPlaque U x₀ ε) hZ hP f hfint
  filter_upwards [hfld, hce] with x hx1 hx2
  rw [← hx2, hx1]


/-- The plaque shape has finite positive mass a.e. (from `EKLProd/plaque_shape_mass`, which uses
the `pos`/`carried`/`radon` fields of `IsLeafwise` and the closed entry boxes of
`EKLProd/sl3EntryBox_compact`). -/
theorem plaque_shape_mass_ae {μ : Measure X3} [IsProbabilityMeasure μ] {U : Subgroup SL3}
    {ν : X3 → Measure SL3} {X' : Set X3} (hν : IsLeafwise μ U ν X') {x₀ : X3} {ε : ℝ} (hε : 0 < ε)
    (hU : IsClosed (U : Set SL3))
    (hinj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂) :
    ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)),
      0 < ν x (shape (plaqueSigma U x₀ ε) U x) ∧ ν x (shape (plaqueSigma U x₀ ε) U x) < ⊤ := by
  have hpla : IsPlaqueAlgebra U (orbitPlaque U x₀ ε) (plaqueSigma U x₀ ε) :=
    isPlaqueAlgebra_orbitPlaque hU hε hinj
  have hZ : MeasurableSet (orbitPlaque U x₀ ε) := hpla.1 _ hpla.2.2.1
  have hmem : ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)), x ∈ orbitPlaque U x₀ ε :=
    (MeasureTheory.ae_restrict_iff' hZ).mpr (Filter.Eventually.of_forall (fun _ hx => hx))
  have hX : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hν.conull
  filter_upwards [hmem, MeasureTheory.ae_restrict_of_ae hX] with x hxP hxX
  obtain ⟨u₀, hu₀, rfl⟩ := hxP
  exact Work.EKLProd.plaque_shape_mass hν hε u₀ hu₀ hxX hinj

/-! ## 3. Local null transfer -/

/-- **A `μ`-null set is `ν x`-null along an orbit plaque** (local form of Pisa §8.9's remark
"`μ(X \ X⁰) = 0` implies that for `μ`-a.e. `x` and `ν_x`-a.e. `u` we have `u • x ∈ X⁰`"). -/
theorem leafwise_null_local {μ : Measure X3} [IsProbabilityMeasure μ] {U : Subgroup SL3}
    {ν : X3 → Measure SL3} {X' : Set X3} (hν : IsLeafwise μ U ν X') {x₀ : X3} {ε : ℝ} (hε : 0 < ε)
    (hU : IsClosed (U : Set SL3))
    (hinj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂)
    (hP : μ (orbitPlaque U x₀ ε) ≠ 0)
    {N : Set X3} (hN : MeasurableSet N) (hNnull : μ N = 0) :
    ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)),
      ν x {u : SL3 | u • x ∈ N ∩ orbitPlaque U x₀ ε} = 0 := by
  set P := orbitPlaque U x₀ ε with hPdef
  have hpla : IsPlaqueAlgebra U P (plaqueSigma U x₀ ε) := by
    rw [show P = orbitPlaque U x₀ ε from rfl]; exact isPlaqueAlgebra_orbitPlaque hU hε hinj
  have hZ : MeasurableSet P := hpla.1 _ hpla.2.2.1
  have hNZ : MeasurableSet (N ∩ P) := hN.inter hZ
  set F : X3 → ℝ := (N ∩ P).indicator (fun _ : X3 => (1 : ℝ)) with hFdef
  have hFmeas : Measurable[instMeasurableSpaceX3] F := Measurable.indicator measurable_const hNZ
  have hFb : ∃ C, ∀ y, |F y| ≤ C := ⟨1, fun y => by
    by_cases hy : y ∈ N ∩ P
    · simp only [F, Set.indicator_of_mem hy]; norm_num
    · simp only [F, Set.indicator_of_notMem hy]; norm_num⟩
  have hFint : ∫ y in P, F y ∂μ = 0 := by
    rw [show F = (N ∩ P).indicator (fun _ : X3 => (1 : ℝ)) from rfl]
    rw [MeasureTheory.setIntegral_indicator hNZ, MeasureTheory.setIntegral_const]
    have hsub : P ∩ (N ∩ P) ⊆ N := fun y hy => hy.2.1
    have h0 : μ (P ∩ (N ∩ P)) = 0 := MeasureTheory.measure_mono_null hsub hNnull
    rw [MeasureTheory.measureReal_def, h0]; simp
  have hav := plaque_average_eq hν hε hU hinj hP F hFmeas hFb
  have hmem : ∀ᵐ x ∂(μ.restrict P), x ∈ P :=
    (MeasureTheory.ae_restrict_iff' hZ).mpr (Filter.Eventually.of_forall (fun _ hx => hx))
  have hX : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hν.conull
  have hmass := plaque_shape_mass_ae hν hε hU hinj
  filter_upwards [hav, hmem, MeasureTheory.ae_restrict_of_ae hX, hmass] with x havx hxP hxX hmassx
  obtain ⟨u₀, hu₀, rfl⟩ := hxP
  have hden : (ν (u₀ • x₀) (shape (plaqueSigma U x₀ ε) U (u₀ • x₀))).toReal ≠ 0 :=
    ENNReal.toReal_ne_zero.mpr ⟨ne_of_gt hmassx.1, ne_of_lt hmassx.2⟩
  have hnum : ∫ u in shape (plaqueSigma U x₀ ε) U (u₀ • x₀), F (u • (u₀ • x₀)) ∂(ν (u₀ • x₀)) = 0 := by
    have h := havx
    rw [hFint, mul_zero] at h
    exact (div_eq_zero_iff.mp h.symm).resolve_right hden
  have hcont : Continuous (fun u : SL3 => u • (u₀ • x₀)) := continuous_id.smul continuous_const
  have hmeaspre : MeasurableSet {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} :=
    hNZ.preimage hcont.measurable
  have hind : ∫ u in shape (plaqueSigma U x₀ ε) U (u₀ • x₀), F (u • (u₀ • x₀)) ∂(ν (u₀ • x₀))
      = (ν (u₀ • x₀) (shape (plaqueSigma U x₀ ε) U (u₀ • x₀) ∩ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P})).toReal := by
    have h1 : ∀ u : SL3, F (u • (u₀ • x₀))
        = ({u : SL3 | u • (u₀ • x₀) ∈ N ∩ P}).indicator (fun _ : SL3 => (1 : ℝ)) u := by
      intro u
      by_cases hu : u • (u₀ • x₀) ∈ N ∩ P
      · rw [Set.indicator_of_mem (show u ∈ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} from hu)]
        simp only [F, Set.indicator_of_mem hu]
      · rw [Set.indicator_of_notMem (show u ∉ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} from hu)]
        simp only [F, Set.indicator_of_notMem hu]
    simp only [h1]
    rw [MeasureTheory.setIntegral_indicator hmeaspre, MeasureTheory.setIntegral_const, smul_eq_mul,
      mul_one, MeasureTheory.measureReal_def]
  have h0 : ν (u₀ • x₀) (shape (plaqueSigma U x₀ ε) U (u₀ • x₀) ∩ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P}) = 0 := by
    have h := hnum
    rw [hind] at h
    have hlt : ν (u₀ • x₀)
        (shape (plaqueSigma U x₀ ε) U (u₀ • x₀) ∩ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P}) < ⊤ :=
      lt_of_le_of_lt (measure_mono Set.inter_subset_left) hmassx.2
    rw [ENNReal.toReal_eq_zero_iff] at h
    rcases h with h | h
    · exact h
    · exact absurd h (ne_of_lt hlt)
  have hsub : {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} ∩ (U : Set SL3)
      ⊆ shape (plaqueSigma U x₀ ε) U (u₀ • x₀) ∩ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} := by
    rintro u ⟨hu, huU⟩
    refine ⟨?_, hu⟩
    have hatom : atom (plaqueSigma U x₀ ε) (u₀ • x₀) = P :=
      show atom (MeasurableSpace.generateFrom {orbitPlaque U x₀ ε}) (u₀ • x₀) = orbitPlaque U x₀ ε from
      Work.EKLProd.atom_generateFrom_singleton _ _ ⟨u₀, hu₀, rfl⟩
    show u ∈ U ∧ u • (u₀ • x₀) ∈ atom (plaqueSigma U x₀ ε) (u₀ • x₀)
    exact ⟨huU, hatom ▸ hu.2⟩
  have hfinal : ν (u₀ • x₀) {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} ≤ 0 := by
    calc ν (u₀ • x₀) {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P}
        = ν (u₀ • x₀) ({u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} ∩ (U : Set SL3)) := by
          refine le_antisymm ?_ (measure_mono Set.inter_subset_left)
          have hdiff : ν (u₀ • x₀) ({u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} \ (U : Set SL3)) = 0 :=
            le_antisymm (le_trans (measure_mono (fun y hy => hy.2))
              (le_of_eq (hν.carried (u₀ • x₀) hxX))) bot_le
          have hadd := MeasureTheory.measure_inter_add_sdiff
            ({u : SL3 | u • (u₀ • x₀) ∈ N ∩ P} : Set SL3) hU.measurableSet (μ := ν (u₀ • x₀))
          rw [hdiff, add_zero] at hadd
          exact le_of_eq hadd.symm
      _ ≤ ν (u₀ • x₀) (shape (plaqueSigma U x₀ ε) U (u₀ • x₀)
            ∩ {u : SL3 | u • (u₀ • x₀) ∈ N ∩ P}) := measure_mono hsub
      _ = 0 := h0
  exact le_antisymm hfinal bot_le


