import Mathlib
import Submission.Work.EKLComp.USCBasic

/-!
# The joined σ-algebra of the atom argument is countably generated

The main result `atomSigma_countable` shows that the σ-algebra

`negOrbitSigma t Pstar ⊔ negOrbitSigma t Q ⊔ partSigma Pstar ⊔ σ(K, frontiers of Q)`

is generated by a countable family of sets.  This is the "countable generation" hypothesis
consumed by `Work.EKLComp.Hcond_eq_zero_of_atom_subset` in the proof of EKL Prop 9.2
(vanishing of the relative entropy).

The proof is structural: each of the four summands is generated by a countable family
(`partSigma P` by the finite range `P.parts`, `negOrbitSigma t P` by the countable union of the
preimage families along `aᐩⁿ`, `σ(K, frontier (Q.parts i))` by `{K} ∪ range (frontier ∘ Q.parts)`)
and countable generation is preserved by `comap`, `⊔` and countable `⨆`.
-/

namespace Work.EKLComp

open MeasureTheory

/-- A σ-algebra is *countably generated* if it is generated by a countable family of sets.
This is a self-contained (non-class) version of `MeasurableSpace.CountablyGenerated`, stated
with the σ-algebra as an explicit argument. -/
def IsCG {α : Type*} (m : MeasurableSpace α) : Prop :=
  ∃ b : Set (Set α), b.Countable ∧ m = MeasurableSpace.generateFrom b

theorem isCG_generateFrom {X : Type*} {b : Set (Set X)} (hb : b.Countable) :
    IsCG (MeasurableSpace.generateFrom b) := ⟨b, hb, rfl⟩

/-- `comap` of a countably generated σ-algebra is countably generated. -/
theorem isCG_comap {α β : Type*} {f : α → β} {m : MeasurableSpace β} (hm : IsCG m) :
    IsCG (MeasurableSpace.comap f m) := by
  obtain ⟨b, hbc, rfl⟩ := hm
  exact ⟨Set.preimage f '' b, hbc.image _, MeasurableSpace.comap_generateFrom⟩

/-- The supremum of two countably generated σ-algebras is countably generated. -/
theorem isCG_sup {α : Type*} {m₁ m₂ : MeasurableSpace α} (h₁ : IsCG m₁) (h₂ : IsCG m₂) :
    IsCG (m₁ ⊔ m₂) := by
  obtain ⟨b₁, hb₁, rfl⟩ := h₁
  obtain ⟨b₂, hb₂, rfl⟩ := h₂
  exact ⟨b₁ ∪ b₂, hb₁.union hb₂, MeasurableSpace.generateFrom_sup_generateFrom⟩

/-- A countable supremum of countably generated σ-algebras is countably generated. -/
theorem isCG_iSup {α ι : Type*} [Countable ι] {m : ι → MeasurableSpace α}
    (hm : ∀ i, IsCG (m i)) : IsCG (⨆ i, m i) := by
  classical
  choose b hbc hb using hm
  refine ⟨⋃ i, b i, Set.countable_iUnion hbc, ?_⟩
  refine le_antisymm ?_ ?_
  · refine iSup_le fun i => ?_
    rw [hb i]
    exact MeasurableSpace.generateFrom_mono (Set.subset_iUnion b i)
  · refine MeasurableSpace.generateFrom_le (m := ⨆ i, m i) (fun t ht => ?_)
    rcases Set.mem_iUnion.mp ht with ⟨i, hi⟩
    exact ((MeasurableSpace.le_def.mp (le_iSup m i)) t)
      (by rw [hb i]; exact MeasurableSpace.measurableSet_generateFrom hi)

/-- The σ-algebra of a finite partition is countably generated. -/
theorem isCG_partSigma {X : Type*} [MeasurableSpace X] (P : Work.EKLContract.FinPart X) :
    IsCG (Work.EKLContract.partSigma P) := ⟨Set.range P.parts, Set.countable_range _, rfl⟩

/-- The "backward orbit" σ-algebra of a finite partition is countably generated. -/
theorem isCG_negOrbitSigma (t : Fin 3 → ℝ) (Q : Work.EKLContract.FinPart Work.EKLContract.X3) :
    IsCG (negOrbitSigma t Q) := by
  rw [negOrbitSigma]
  refine isCG_iSup (fun n => ?_)
  exact isCG_comap (f := fun x : Work.EKLContract.X3 => aZ t ((n : ℤ) + 1) • x) (isCG_partSigma Q)

theorem atomSigma_countable (t : Fin 3 → ℝ) (Pstar Q : Work.EKLContract.FinPart Work.EKLContract.X3) (K : Set Work.EKLContract.X3) : ∃ b : Set (Set Work.EKLContract.X3), b.Countable ∧ (Work.EKLComp.negOrbitSigma t Pstar ⊔ Work.EKLComp.negOrbitSigma t Q ⊔ Work.EKLContract.partSigma Pstar ⊔ MeasurableSpace.generateFrom ({K} ∪ Set.range (fun i : Fin Q.n => frontier (Q.parts i)))) = MeasurableSpace.generateFrom b := by
  classical
  have h3 : IsCG (Work.EKLContract.partSigma Pstar) := isCG_partSigma Pstar
  have h4 : IsCG (MeasurableSpace.generateFrom
      ({K} ∪ Set.range (fun i : Fin Q.n => frontier (Q.parts i)))) :=
    isCG_generateFrom (Set.countable_singleton K |>.union
      (Set.countable_range (fun i : Fin Q.n => frontier (Q.parts i))))
  have hcg : IsCG (Work.EKLComp.negOrbitSigma t Pstar ⊔ Work.EKLComp.negOrbitSigma t Q ⊔
      Work.EKLContract.partSigma Pstar ⊔
      MeasurableSpace.generateFrom ({K} ∪ Set.range (fun i : Fin Q.n => frontier (Q.parts i)))) :=
    isCG_sup (isCG_sup (isCG_sup (isCG_negOrbitSigma t Pstar) (isCG_negOrbitSigma t Q)) h3) h4
  obtain ⟨b, hbc, hb⟩ := hcg
  exact ⟨b, hbc, hb⟩

end Work.EKLComp
