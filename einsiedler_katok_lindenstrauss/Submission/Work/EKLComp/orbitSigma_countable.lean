import Mathlib
import Submission.Work.EKLComp.USCBasic
import Submission.Work.EKLComp.atomSigma_countable

/-!
# The joined σ-algebra of the orbit σ-algebras is countably generated

The main result `orbitSigma_countable` shows that the σ-algebra

`negOrbitSigma t Q ⊔ orbitSigma t Pstar ⊔ σ(K, frontiers of Q)`

is generated by a countable family of sets.  It is the exact analogue of
`atomSigma_countable` with `partSigma Pstar` replaced by `orbitSigma Pstar`
(`orbitSigma t P = ⨆_{n : ℤ} comap (aᵗⁿ ·) (partSigma P)`), which is again a *countable*
supremum of `comap`s of a countably generated σ-algebra.

The pieces:
* `negOrbitSigma t Q` is countably generated (`isCG_negOrbitSigma`);
* `orbitSigma t Pstar` is countably generated (`isCG_orbitSigma`);
* `σ(K, frontier (Q.parts i))` is generated by the countable family
  `{K} ∪ range (frontier ∘ Q.parts)`;
and countable generation is preserved by `⊔`.
-/

namespace Work.EKLComp

open MeasureTheory

/-- The `aDiag t`-orbit σ-algebra of a finite partition is countably generated: it is a countable
supremum (over `ℤ`) of `comap`s of the countably generated σ-algebra `partSigma P`. -/
theorem isCG_orbitSigma (t : Fin 3 → ℝ) (P : Work.EKLContract.FinPart Work.EKLContract.X3) :
    IsCG (orbitSigma t P) := by
  rw [orbitSigma]
  refine isCG_iSup (fun n : ℤ => ?_)
  exact isCG_comap (f := fun x : Work.EKLContract.X3 => aZ t n • x) (isCG_partSigma P)

theorem orbitSigma_countable (t : Fin 3 → ℝ) (Pstar Q : Work.EKLContract.FinPart Work.EKLContract.X3) (K : Set Work.EKLContract.X3) : ∃ b : Set (Set Work.EKLContract.X3), b.Countable ∧ (Work.EKLComp.negOrbitSigma t Q ⊔ Work.EKLComp.orbitSigma t Pstar ⊔ MeasurableSpace.generateFrom ({K} ∪ Set.range (fun i : Fin Q.n => frontier (Q.parts i)))) = MeasurableSpace.generateFrom b := by
  classical
  have h1 : IsCG (Work.EKLComp.negOrbitSigma t Q) := isCG_negOrbitSigma t Q
  have h2 : IsCG (Work.EKLComp.orbitSigma t Pstar) := isCG_orbitSigma t Pstar
  have h3 : IsCG (MeasurableSpace.generateFrom
      ({K} ∪ Set.range (fun i : Fin Q.n => frontier (Q.parts i)))) :=
    isCG_generateFrom (Set.countable_singleton K |>.union
      (Set.countable_range (fun i : Fin Q.n => frontier (Q.parts i))))
  have hcg : IsCG (Work.EKLComp.negOrbitSigma t Q ⊔ Work.EKLComp.orbitSigma t Pstar ⊔
      MeasurableSpace.generateFrom ({K} ∪ Set.range (fun i : Fin Q.n => frontier (Q.parts i)))) :=
    isCG_sup (isCG_sup h1 h2) h3
  obtain ⟨b, hbc, hb⟩ := hcg
  exact ⟨b, hbc, hb⟩

end Work.EKLComp
