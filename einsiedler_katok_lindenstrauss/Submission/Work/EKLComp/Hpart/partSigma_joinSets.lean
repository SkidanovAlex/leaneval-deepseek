import Mathlib
import Submission.Work.EKLComp.Entropy

namespace Work.EKLComp.Hpart

open Work.EKLContract

/-!
# The σ-algebra generated by the join `⋁_{k<N} T^{-k} P`

`Work.EKLContract.joinSets T P N w = ⋂_{k : Fin N} T^[k] ⁻¹' P.parts (w k)` is the
`N`-fold join of the finite partition `P` along `T`.  This file proves that the
σ-algebra it generates is the join of the pullbacks of `partSigma P`:

  `generateFrom (range (joinSets T P N)) = ⨆ k : Fin N, comap (T^[k]) (partSigma P)`.

Both inclusions follow from explicit set identities, so no measurability of `T` is
needed: `comap` of an arbitrary function is a σ-algebra, and the set identities
below are about preimages only.

* `LHS ≤ RHS`: every atom `joinSets T P N w` is a finite intersection of the
  generators `T^[k] ⁻¹' P.parts (w k)` of the right hand side.
* `RHS ≤ LHS`: for each `k` and each `i`, the generator `T^[k] ⁻¹' P.parts i`
  is the union of the atoms of the join whose `k`-th letter is `i`.
-/

variable {X : Type} [MeasurableSpace X]

/-- The `k`-th coordinate piece of the join is the union of the atoms of the join
whose `k`-th letter is `i`.  The key point is that the atoms of `joinSets T P N`
partition `X`, so a point with `T^[k] x ∈ P.parts i` determines an atom whose `k`-th
letter must be `i` (by disjointness of the atoms of `P`). -/
lemma preimage_parts_eq_iUnion_joinSets (T : X → X) (P : FinPart X) (N : ℕ)
    (k : Fin N) (i : Fin P.n) :
    T^[(k : ℕ)] ⁻¹' P.parts i =
      Set.iUnion (fun w : {w : Fin N → Fin P.n // w k = i} => joinSets T P N w.1) := by
  ext x
  constructor
  · intro hx
    have hex : ∀ j : Fin N, ∃ c : Fin P.n, T^[(j : ℕ)] x ∈ P.parts c := by
      intro j
      have hmem : T^[(j : ℕ)] x ∈ ⋃ c, P.parts c := by rw [P.cover]; trivial
      simpa only [Set.mem_iUnion] using hmem
    choose w hw using hex
    have hwk : w k = i := by
      by_contra hne
      exact Set.disjoint_left.mp (P.disjoint hne) (hw k) hx
    refine Set.mem_iUnion.mpr ⟨⟨w, hwk⟩, ?_⟩
    simp only [joinSets, Set.mem_iInter, Set.mem_preimage]
    exact hw
  · intro hx
    obtain ⟨w, hw⟩ := Set.mem_iUnion.mp hx
    simp only [joinSets, Set.mem_iInter, Set.mem_preimage] at hw
    have hk := hw k
    rwa [w.2] at hk

/-- Each coordinate generator `T^[k] ⁻¹' P.parts i` belongs to the σ-algebra
generated by the atoms of the join. -/
lemma preimage_parts_mem_generateFrom_joinSets (T : X → X) (P : FinPart X) (N : ℕ)
    (k : Fin N) (i : Fin P.n) :
    @MeasurableSet X (MeasurableSpace.generateFrom (Set.range (joinSets T P N)))
      (T^[(k : ℕ)] ⁻¹' P.parts i) := by
  rw [preimage_parts_eq_iUnion_joinSets T P N k i]
  refine MeasurableSet.iUnion (fun w => ?_)
  exact MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self w.1)

/-- `comap (T^[k]) (partSigma P)` is contained in the σ-algebra generated by the
atoms of the join. -/
lemma comap_le_generateFrom_joinSets (T : X → X) (P : FinPart X) (N : ℕ) (k : Fin N) :
    MeasurableSpace.comap (T^[(k : ℕ)]) (partSigma P) ≤
      MeasurableSpace.generateFrom (Set.range (joinSets T P N)) := by
  rw [partSigma, MeasurableSpace.comap_generateFrom]
  refine MeasurableSpace.generateFrom_le (fun t ht => ?_)
  rcases ht with ⟨s, ⟨i, rfl⟩, rfl⟩
  exact preimage_parts_mem_generateFrom_joinSets T P N k i

theorem partSigma_joinSets {X : Type} [mX : MeasurableSpace X] (T : X → X)
    (P : Work.EKLContract.FinPart X) (N : ℕ) :
    MeasurableSpace.generateFrom (Set.range (Work.EKLContract.joinSets T P N)) =
      ⨆ k : Fin N, MeasurableSpace.comap (T^[(k : ℕ)]) (Work.EKLContract.partSigma P) := by
  apply le_antisymm
  · refine MeasurableSpace.generateFrom_le (fun t ht => ?_)
    rcases ht with ⟨w, rfl⟩
    rw [Work.EKLContract.joinSets]
    refine MeasurableSet.iInter (fun k => ?_)
    have hk : MeasurableSpace.comap (T^[(k : ℕ)]) (Work.EKLContract.partSigma P) ≤
        ⨆ k : Fin N,
          MeasurableSpace.comap (T^[(k : ℕ)]) (Work.EKLContract.partSigma P) :=
      le_iSup (fun k : Fin N =>
        MeasurableSpace.comap (T^[(k : ℕ)]) (Work.EKLContract.partSigma P)) k
    exact (MeasurableSpace.le_def.mp hk) (T^[(k : ℕ)] ⁻¹' P.parts (w k))
      (MeasurableSpace.measurableSet_comap.mpr
        ⟨P.parts (w k),
          MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self (w k)), rfl⟩)
  · rw [iSup_le_iff]
    intro k
    exact comap_le_generateFrom_joinSets T P N k

end Work.EKLComp.Hpart
