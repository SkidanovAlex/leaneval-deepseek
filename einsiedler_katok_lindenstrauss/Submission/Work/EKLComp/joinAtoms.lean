import Mathlib
import Submission.Work.EKLComp.LeafDefs

/-!
# Atoms of a join of two countably generated σ-algebras

Let `m`, `m'` be two σ-algebras on `α` generated by countable families (`hgen`, `hgen'`).
Writing `atomG m x = ⋂₀ {s | MeasurableSet[m] s ∧ x ∈ s}` for the atom of `m` at `x`
(`Work.EKLComp.atomG`, the smallest `m`-measurable set containing `x`), we show

`atomG (m ⊔ m') x = atomG m x ∩ atomG m' x`.

The point is that for a σ-algebra generated by a family `c`, membership in the atom of `x` is the
same thing as `y` belonging to exactly the same members of `c` as `x` does
(`atomG_generateFrom`): the class of `x` under this relation is `m`-measurable and every
`m`-measurable set is a union of such classes (this is Mathlib's
`MeasurableSpace.forall_generateFrom_mem_iff_mem_iff`).  The σ-algebra `m ⊔ m'` is generated by
`b ∪ b'` (`MeasurableSpace.generateFrom_sup_generateFrom`), so its atoms are the intersections of
the atoms of `m` and of `m'`.
-/

set_option linter.unusedVariables false

namespace Work.EKLComp

open MeasureTheory

/-- The atom of a σ-algebra at `x` consists exactly of the points `y` that belong to the same
measurable sets as `x`. -/
lemma atomG_eq_iff {α : Type*} (m : MeasurableSpace α) (x y : α) :
    y ∈ atomG m x ↔ ∀ s, MeasurableSet[m] s → (y ∈ s ↔ x ∈ s) := by
  rw [atomG, Set.mem_sInter]
  simp only [Set.mem_ofPred_eq]
  constructor
  · intro H s hs
    refine ⟨fun hy => ?_, fun hx => H s ⟨hs, hx⟩⟩
    by_contra hx
    exact H sᶜ ⟨hs.compl, by simpa using hx⟩ (by simpa using hy)
  · intro H t ht
    obtain ⟨hmeas, hxt⟩ := ht
    exact (H t hmeas).mpr hxt

/-- For the σ-algebra generated by a family `c`, the atom at `x` is the class of `x` under the
relation "belongs to exactly the same members of `c`". -/
lemma atomG_generateFrom {α : Type*} {c : Set (Set α)} (x : α) :
    atomG (MeasurableSpace.generateFrom c) x = {y | ∀ s ∈ c, y ∈ s ↔ x ∈ s} := by
  ext y
  rw [atomG_eq_iff, MeasurableSpace.forall_generateFrom_mem_iff_mem_iff, Set.mem_ofPred_eq]

theorem joinAtoms {α : Type*} [mα : MeasurableSpace α] (m m' : MeasurableSpace α)
    (hm : m ≤ mα) (hm' : m' ≤ mα)
    (hgen : ∃ b : Set (Set α), b.Countable ∧ m = MeasurableSpace.generateFrom b)
    (hgen' : ∃ b : Set (Set α), b.Countable ∧ m' = MeasurableSpace.generateFrom b)
    (hequiv : Work.EKLComp.CountablyEquivOn m m' Set.univ) (x : α) :
    Work.EKLComp.atomG (m ⊔ m') x = Work.EKLComp.atomG m x ∩ Work.EKLComp.atomG m' x := by
  obtain ⟨b, _, hmb⟩ := hgen
  obtain ⟨b', _, hm'b⟩ := hgen'
  rw [hmb, hm'b, MeasurableSpace.generateFrom_sup_generateFrom]
  rw [atomG_generateFrom, atomG_generateFrom, atomG_generateFrom]
  ext y
  simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, Set.mem_union]
  constructor
  · intro H; exact ⟨fun s hs => H s (Or.inl hs), fun s hs => H s (Or.inr hs)⟩
  · rintro ⟨H1, H2⟩ s (hs | hs)
    · exact H1 s hs
    · exact H2 s hs

end Work.EKLComp
