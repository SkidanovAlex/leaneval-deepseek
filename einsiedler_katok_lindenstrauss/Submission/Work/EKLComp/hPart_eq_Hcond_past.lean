import Mathlib
import Submission.Work.EKLComp.Hcond
import Submission.Work.EKLComp.hPart_Hcond
import Submission.Work.EKLC6Core.PastJoin
import Submission.Work.EKLC6Core.Hcond_le_hPart
import Submission.Work.EKLC6Core.Hcond_mono
import Submission.Work.EKLGen.tendsto_Hcond_iSup_univ

/-!
# `hPart_eq_Hcond_past` — the Kolmogorov–Sinai identity for a finite partition

For a (probability) measure preserving map `T` on `X` and a finite measurable partition `P`,
the entropy rate `hPart μ T P = inf_N (1/N) H_μ(⋁_{k<N} T^{-k}P)` equals the conditional entropy
of `P` given the **past** σ-algebra `⋁_{n≥1} T^{-n}(partSigma P)`:

  `hPart μ T P = Hcond μ P (⨆ n, comap (T^[n+1]) (partSigma P))`.

The `≤` half is `Work.EKLC6Core.Hcond_le_hPart`.  This file supplies the `≥` half, following the
standard chain-rule/Cesàro argument:

* `Hcond_shiftSigma` (already proved in `EKLC6Core.Hcond_le_hPart`) gives the chain step
  `Hfam μ (⋁_{k≤N}T^{-k}P) = Hfam μ (⋁_{k<N}T^{-k}P) + Hcond μ P (shiftSigma T P N)`,
  so that `Hfam μ (⋁_{k<N}T^{-k}P) = ∑_{L<N} Hcond μ P (shiftSigma T P L)` (telescoping);
* the σ-algebras `shiftSigma T P L = T^{-1}(σ(⋁_{k<L}T^{-k}P))` increase to the past σ-algebra,
  so by Lévy's upward theorem the conditional entropies converge to `Hcond μ P (pastSigmaShift T P)`;
* the Cesàro averages of a sequence tending to `L` from above have infimum `L`.

The whole development is stated for an arbitrary universe `X : Type*`; the lemmas in
`Submission/Work/EKLComp/Hpart/` are universe-0, so the few σ-algebra computations needed here
(`partSigma_joinSets`, `iSup_comap_joinSets`) are reproduced in the namespace `HPartSigma` below.
-/

open MeasureTheory Filter Topology
open scoped ENNReal BigOperators

noncomputable section

namespace Work.EKLComp.HPartSigma

variable {X : Type*} [MeasurableSpace X]

open Work.EKLContract

/-! ## The σ-algebra generated by the join `⋁_{k<N}T^{-k}P` (universe-polymorphic)

These are the universe-general forms of `Work.EKLComp.Hpart.partSigma_joinSets` and
`Work.EKLComp.Hpart.iSup_comap_joinSets`. -/

/-- Every point of `X` lies in some part of a finite partition. -/
lemma exists_mem_parts (P : FinPart X) (y : X) : ∃ i : Fin P.n, y ∈ P.parts i := by
  have h : y ∈ ⋃ i, P.parts i := by rw [P.cover]; exact trivial
  simpa using h

/-- Membership in `joinSets`, pointwise. -/
lemma mem_joinSets_iff {T : X → X} {P : FinPart X} {N : ℕ}
    {w : Fin N → Fin P.n} {x : X} :
    x ∈ joinSets T P N w ↔ ∀ k : Fin N, T^[(k : ℕ)] x ∈ P.parts (w k) := by
  simp [joinSets]

/-- The atoms of the `(n+1)`-fold join whose last symbol is `i` cover exactly `(T^n)^{-1}P_i`. -/
lemma iUnion_joinSets_last (T : X → X) (P : FinPart X) (n : ℕ) (i : Fin P.n) :
    (⋃ w : {w : Fin (n + 1) → Fin P.n // w (Fin.last n) = i},
        joinSets T P (n + 1) w.1) = (T^[n]) ⁻¹' P.parts i := by
  classical
  ext x
  rw [Set.mem_iUnion, Set.mem_preimage]
  constructor
  · rintro ⟨w, hw⟩
    have h := (mem_joinSets_iff.mp hw) (Fin.last n)
    rwa [w.2, Fin.val_last] at h
  · intro hx
    refine ⟨⟨fun k => if hk : k = Fin.last n then i
        else Classical.choose (exists_mem_parts P (T^[(k : ℕ)] x)), ?_⟩, ?_⟩
    · simp
    · rw [mem_joinSets_iff]
      intro k
      by_cases hk : k = Fin.last n
      · subst hk
        simp only [Fin.val_last]
        exact hx
      · dsimp only
        rw [dif_neg hk]
        exact Classical.choose_spec (exists_mem_parts P (T^[(k : ℕ)] x))

/-- Each atom of the `N`-fold join lies in `⨆ n, (T^n)^{-1}(σ(P))`. -/
lemma partSigma_joinSets_le (T : X → X) (P : FinPart X) (N : ℕ) :
    MeasurableSpace.generateFrom (Set.range (joinSets T P N))
      ≤ ⨆ n : ℕ, MeasurableSpace.comap (T^[n]) (partSigma P) := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro s ⟨w, rfl⟩
  rw [joinSets]
  refine MeasurableSet.iInter fun k : Fin N => ?_
  exact (le_iSup (fun n : ℕ => MeasurableSpace.comap (T^[n]) (partSigma P)) (k : ℕ))
    _ ⟨P.parts (w k), MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self (w k)),
        rfl⟩

/-- Each generator `(T^n)^{-1}P_i` lies in `⨆ N, σ(⋁_{k<N}T^{-k}P)`. -/
lemma le_partSigma_joinSets (T : X → X) (P : FinPart X) (n : ℕ) :
    MeasurableSpace.comap (T^[n]) (partSigma P)
      ≤ ⨆ N : ℕ, MeasurableSpace.generateFrom (Set.range (joinSets T P N)) := by
  rw [partSigma, MeasurableSpace.comap_generateFrom]
  refine MeasurableSpace.generateFrom_le ?_
  rintro s ⟨t, ht, rfl⟩
  obtain ⟨i, rfl⟩ := ht
  rw [← iUnion_joinSets_last T P n i]
  refine MeasurableSet.iUnion fun w => ?_
  exact (le_iSup (fun N : ℕ => MeasurableSpace.generateFrom (Set.range (joinSets T P N)))
      (n + 1)) _ (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self w.1))

/-- The `k`-th coordinate piece of the join is the union of the atoms whose `k`-th letter is `i`. -/
lemma preimage_parts_eq_iUnion_joinSets (T : X → X) (P : FinPart X) (N : ℕ)
    (k : Fin N) (i : Fin P.n) :
    T^[(k : ℕ)] ⁻¹' P.parts i =
      Set.iUnion (fun w : {w : Fin N → Fin P.n // w k = i} => joinSets T P N w.1) := by
  ext x
  constructor
  · intro hx
    have hex : ∀ j : Fin N, ∃ c : Fin P.n, T^[(j : ℕ)] x ∈ P.parts c := by
      intro j
      have hmem : T^[(j : ℕ)] x ∈ ⋃ c, P.parts c := by rw [P.cover]; trivial
      simpa only [Set.mem_iUnion] using hmem
    choose w hw using hex
    have hwk : w k = i := by
      by_contra hne
      exact Set.disjoint_left.mp (P.disjoint hne) (hw k) hx
    refine Set.mem_iUnion.mpr ⟨⟨w, hwk⟩, ?_⟩
    simp only [joinSets, Set.mem_iInter, Set.mem_preimage]
    exact hw
  · intro hx
    obtain ⟨w, hw⟩ := Set.mem_iUnion.mp hx
    simp only [joinSets, Set.mem_iInter, Set.mem_preimage] at hw
    have hk := hw k
    rwa [w.2] at hk

/-- Each coordinate generator belongs to the σ-algebra generated by the atoms of the join. -/
lemma preimage_parts_mem_generateFrom_joinSets (T : X → X) (P : FinPart X) (N : ℕ)
    (k : Fin N) (i : Fin P.n) :
    @MeasurableSet X (MeasurableSpace.generateFrom (Set.range (joinSets T P N)))
      (T^[(k : ℕ)] ⁻¹' P.parts i) := by
  rw [preimage_parts_eq_iUnion_joinSets T P N k i]
  refine MeasurableSet.iUnion (fun w => ?_)
  exact MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self w.1)

/-- `comap (T^k)(partSigma P)` is contained in the σ-algebra generated by the atoms of the join. -/
lemma comap_le_generateFrom_joinSets (T : X → X) (P : FinPart X) (N : ℕ) (k : Fin N) :
    MeasurableSpace.comap (T^[(k : ℕ)]) (partSigma P) ≤
      MeasurableSpace.generateFrom (Set.range (joinSets T P N)) := by
  rw [partSigma, MeasurableSpace.comap_generateFrom]
  refine MeasurableSpace.generateFrom_le (fun t ht => ?_)
  rcases ht with ⟨s, ⟨i, rfl⟩, rfl⟩
  exact preimage_parts_mem_generateFrom_joinSets T P N k i

/-- The σ-algebra of the `N`-fold join is the join of the pullbacks of `partSigma P`. -/
theorem partSigma_joinSets (T : X → X) (P : FinPart X) (N : ℕ) :
    MeasurableSpace.generateFrom (Set.range (joinSets T P N)) =
      ⨆ k : Fin N, MeasurableSpace.comap (T^[(k : ℕ)]) (partSigma P) := by
  apply le_antisymm
  · refine MeasurableSpace.generateFrom_le (fun t ht => ?_)
    rcases ht with ⟨w, rfl⟩
    rw [joinSets]
    refine MeasurableSet.iInter (fun k => ?_)
    have hk : MeasurableSpace.comap (T^[(k : ℕ)]) (partSigma P) ≤
        ⨆ k : Fin N, MeasurableSpace.comap (T^[(k : ℕ)]) (partSigma P) :=
      le_iSup (fun k : Fin N => MeasurableSpace.comap (T^[(k : ℕ)]) (partSigma P)) k
    exact (MeasurableSpace.le_def.mp hk) (T^[(k : ℕ)] ⁻¹' P.parts (w k))
      (MeasurableSpace.measurableSet_comap.mpr
        ⟨P.parts (w k),
          MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self (w k)), rfl⟩)
  · rw [iSup_le_iff]
    intro k
    exact comap_le_generateFrom_joinSets T P N k

/-- `⨆ N, T⁻¹(σ(⋁_{k<N}T^{-k}P)) = ⨆ n, (T^{n+1})⁻¹(σ(P))`. -/
theorem iSup_comap_joinSets (T : X → X) (hT : Measurable T) (P : FinPart X) :
    (⨆ N : ℕ, MeasurableSpace.comap T
        (MeasurableSpace.generateFrom (Set.range (joinSets T P N))))
      = ⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma P) := by
  have hM : (⨆ N : ℕ, MeasurableSpace.generateFrom (Set.range (joinSets T P N)))
      = ⨆ n : ℕ, MeasurableSpace.comap (T^[n]) (partSigma P) :=
    le_antisymm (iSup_le fun N => partSigma_joinSets_le T P N)
      (iSup_le fun n => le_partSigma_joinSets T P n)
  have hpt : ∀ n : ℕ, MeasurableSpace.comap T (MeasurableSpace.comap (T^[n]) (partSigma P))
      = MeasurableSpace.comap (T^[n+1]) (partSigma P) := by
    intro n
    rw [MeasurableSpace.comap_comp, ← Function.iterate_succ]
  calc (⨆ N : ℕ, MeasurableSpace.comap T
          (MeasurableSpace.generateFrom (Set.range (joinSets T P N))))
      = MeasurableSpace.comap T
          (⨆ N : ℕ, MeasurableSpace.generateFrom (Set.range (joinSets T P N))) :=
        MeasurableSpace.comap_iSup.symm
    _ = MeasurableSpace.comap T (⨆ n : ℕ, MeasurableSpace.comap (T^[n]) (partSigma P)) := by
        rw [hM]
    _ = (⨆ n : ℕ, MeasurableSpace.comap T (MeasurableSpace.comap (T^[n]) (partSigma P))) :=
        MeasurableSpace.comap_iSup
    _ = (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma P)) := iSup_congr hpt

end Work.EKLComp.HPartSigma

namespace Work.EKLComp

open Work.EKLContract
open Work.EKLC6Core

variable {X : Type*} [mX : MeasurableSpace X]

/-! ## The punctured-join σ-algebras `shiftSigma T P L` -/

/-- `shiftSigma T P N = T⁻¹(σ(⋁_{k<N}T^{-k}P))`. -/
theorem shiftSigma_eq_comap (T : X → X) (P : FinPart X) (N : ℕ) :
    shiftSigma T P N = MeasurableSpace.comap T
      (MeasurableSpace.generateFrom (Set.range (joinSets T P N))) := by
  have hrange : Set.range (shJoin T P N) =
      (fun t : Set X => T ⁻¹' t) '' Set.range (joinSets T P N) := by
    rw [show shJoin T P N = Set.preimage T ∘ joinSets T P N from rfl]
    exact Set.range_comp (Set.preimage T) (joinSets T P N)
  unfold shiftSigma Work.EKLComp.Core.partSigmaFam
  rw [hrange, MeasurableSpace.comap_generateFrom]

/-- The sequence of punctured-join σ-algebras is increasing. -/
theorem monotone_shiftSigma (T : X → X) (P : FinPart X) :
    Monotone (fun L : ℕ => shiftSigma T P L) := by
  intro L L' hLL'
  dsimp only
  rw [shiftSigma_eq_comap T P L, shiftSigma_eq_comap T P L']
  refine MeasurableSpace.comap_mono ?_
  rw [HPartSigma.partSigma_joinSets T P L, HPartSigma.partSigma_joinSets T P L']
  exact iSup_le fun k => le_iSup_of_le (Fin.castLE hLL' k) le_rfl

/-- Each `shiftSigma T P L` is a sub-σ-algebra of the ambient one. -/
theorem shiftSigma_le_mX {T : X → X} (hT : Measurable T) (P : FinPart X) (L : ℕ) :
    shiftSigma T P L ≤ mX := by
  unfold shiftSigma Work.EKLComp.Core.partSigmaFam shJoin
  refine MeasurableSpace.generateFrom_le fun s hs => ?_
  obtain ⟨w, rfl⟩ := hs
  exact (Work.EKLComp.Core.joinSets_measurable hT P L w).preimage hT

/-- The punctured-join σ-algebras increase to the past σ-algebra. -/
theorem iSup_shiftSigma_eq_pastSigma {T : X → X} (hT : Measurable T) (P : FinPart X) :
    (⨆ L : ℕ, shiftSigma T P L) = pastSigmaShift T P := by
  have h : (⨆ L : ℕ, shiftSigma T P L) = ⨆ L : ℕ, MeasurableSpace.comap T
      (MeasurableSpace.generateFrom (Set.range (joinSets T P L))) :=
    iSup_congr fun L => shiftSigma_eq_comap T P L
  rw [h]
  exact HPartSigma.iSup_comap_joinSets T hT P

/-! ## The telescoping identity and `hPart` as a Cesàro infimum -/

/-- Telescoping the chain rule: `Hfam μ (⋁_{k<N}T^{-k}P) = ∑_{L<N} Hcond μ P (shiftSigma T P L)`. -/
theorem Hfam_joinSets_eq_sum_shiftSigma (μ : Measure X) [IsProbabilityMeasure μ]
    {T : X → X} (hmp : MeasurePreserving T μ μ) (P : FinPart X) (N : ℕ) :
    Hfam μ (joinSets T P N) =
      ∑ L ∈ Finset.range N, Hcond μ P (shiftSigma T P L) := by
  induction N with
  | zero =>
      rw [Finset.range_zero, Finset.sum_empty]
      exact Work.EKLC6Core.Hfam_joinSets_zero μ T P
  | succ N ih =>
      have h := Work.EKLC6Core.Hcond_shiftSigma (T := T) μ hmp P N
      rw [Finset.sum_range_succ, ← ih]
      linarith [h]

/-- `hPart` written as the infimum of the Cesàro averages of `Hcond μ P (shiftSigma T P ·)`. -/
theorem hPart_eq_iInf_Hcond (μ : Measure X) [IsProbabilityMeasure μ]
    {T : X → X} (hmp : MeasurePreserving T μ μ) (P : FinPart X) :
    hPart μ T P = ⨅ N : ℕ,
      (∑ L ∈ Finset.range (N + 1), Hcond μ P (shiftSigma T P L)) / ((N : ℝ) + 1) := by
  simp only [hPart]
  refine iInf_congr fun N => ?_
  rw [Hfam_joinSets_eq_sum_shiftSigma μ hmp P (N + 1)]

/-! ## The main theorem -/

theorem hPart_eq_Hcond_past {X : Type*} [mX : MeasurableSpace X] (μ : MeasureTheory.Measure X)
    [MeasureTheory.IsProbabilityMeasure μ] {T : X → X} (hmp : MeasureTheory.MeasurePreserving T μ μ)
    (P : @Work.EKLContract.FinPart X mX) :
    @Work.EKLContract.hPart X mX μ T P
      = @Work.EKLContract.Hcond X mX μ P
          (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (@Work.EKLContract.partSigma X mX P)) := by
  have hT : Measurable T := hmp.measurable
  have hmono : Monotone (fun L : ℕ => shiftSigma T P L) := monotone_shiftSigma T P
  have hle : ∀ L : ℕ, shiftSigma T P L ≤ mX := fun L => shiftSigma_le_mX hT P L
  have hsup : (⨆ L : ℕ, shiftSigma T P L) = pastSigmaShift T P := iSup_shiftSigma_eq_pastSigma hT P
  have htend : Tendsto (fun L : ℕ => Hcond μ P (shiftSigma T P L)) atTop
      (nhds (Hcond μ P (pastSigmaShift T P))) := by
    have h := Work.EKLGen.tendsto_Hcond_iSup_univ μ P (fun L : ℕ => shiftSigma T P L) hmono hle
    rwa [hsup] at h
  have hge : ∀ L : ℕ, Hcond μ P (pastSigmaShift T P) ≤ Hcond μ P (shiftSigma T P L) :=
    fun L => Hcond_mono μ P (shiftSigma T P L) (pastSigmaShift T P) (shiftSigma_le_pastSigma hT P L)
  have hces : (⨅ N : ℕ,
        (∑ L ∈ Finset.range (N + 1), Hcond μ P (shiftSigma T P L)) / ((N : ℝ) + 1))
      = Hcond μ P (pastSigmaShift T P) :=
    HpcAux.cesaro_ciInf_eq hge htend
  rw [hPart_eq_iInf_Hcond (T := T) μ hmp P]
  exact hces

end Work.EKLComp
