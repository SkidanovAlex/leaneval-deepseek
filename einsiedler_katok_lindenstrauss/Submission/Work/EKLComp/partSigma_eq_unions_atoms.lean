import Mathlib
import Submission.Work.EKLContract.Interfaces

/-!
# Atoms of a finite partition: `partSigma P` is the σ-algebra of unions of parts

`Work.EKLContract.partSigma P` is the σ-algebra generated by the parts of a finite partition `P`
of `X` (`MeasurableSpace.generateFrom (Set.range P.parts)`).  Because the parts of a `FinPart`
are pairwise disjoint and cover `X`, this σ-algebra has a completely explicit description: its
measurable sets are exactly the unions of subfamilies of the parts,

`MeasurableSet[partSigma P] S ↔ ∃ J : Set (Fin P.n), S = ⋃ j ∈ J, P.parts j`.

The proof is the standard one.  The family

`U(P) = { ⋃ j ∈ J, P.parts j | J : Set (Fin P.n) }`

of unions of parts is a σ-algebra: it contains `∅` (take `J = ∅`), it is closed under complements
(the complement of `⋃_{j∈J} P_j` is `⋃_{j∉J} P_j`, which is where disjointness and covering are
used) and under countable unions (reindex by `⋃_k J_k`).  It contains every part (`J = {j}`), so
`partSigma P ≤ U(P)` by minimality of `generateFrom`; conversely every union of parts is
measurable for `partSigma P`, since it is a countable union of parts.  Hence the two σ-algebras
agree and a set is `partSigma P`-measurable exactly when it is a union of parts.
-/

set_option warn.classDefReducibility false

noncomputable section

namespace Work.EKLComp

open Work.EKLContract

variable {X : Type} [mX : MeasurableSpace X]

/-! ## The two closure identities for unions of parts -/

/-- The complement of a union of parts of a finite partition is the union of the complementary
parts.  Disjointness of the parts is used to see that the complement of `⋃_{j∈J} P_j` misses each
`P_j`, `j ∈ J`; the covering property is used to see that a point outside `⋃_{j∈J} P_j` still lies
in some part `P_i`, and then necessarily `i ∉ J`. -/
theorem partUnion_compl (P : FinPart X) (J : Set (Fin P.n)) :
    (⋃ j ∈ J, P.parts j)ᶜ = ⋃ j ∈ Jᶜ, P.parts j := by
  ext x
  simp only [Set.mem_compl_iff, Set.mem_iUnion]
  constructor
  · intro hx
    have hxuniv : x ∈ ⋃ i, P.parts i := by rw [P.cover]; exact Set.mem_univ x
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hxuniv
    exact ⟨i, fun hiJ => hx ⟨i, hiJ, hi⟩, hi⟩
  · rintro ⟨i, hiJ, hi⟩ ⟨j, hjJ, hj⟩
    have hne : j ≠ i := fun h => hiJ (h ▸ hjJ)
    exact (Set.disjoint_left.mp (P.disjoint hne) hj) hi

/-- A countable union of unions of parts of a finite partition is again a union of parts: the
index set of the result is the union of the index sets. -/
theorem partUnion_iUnion (P : FinPart X) (J : ℕ → Set (Fin P.n)) :
    (⋃ k : ℕ, ⋃ j ∈ J k, P.parts j) = ⋃ j ∈ (⋃ k : ℕ, J k), P.parts j := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨k, j, hj, hx⟩
    exact ⟨j, ⟨k, hj⟩, hx⟩
  · rintro ⟨j, ⟨k, hj⟩, hx⟩
    exact ⟨k, j, hj, hx⟩

/-! ## The σ-algebra of unions of parts -/

/-- The σ-algebra whose measurable sets are the unions of parts of the finite partition `P`. -/
def partUnionSigma (P : FinPart X) : MeasurableSpace X where
  MeasurableSet' S := ∃ J : Set (Fin P.n), S = ⋃ j ∈ J, P.parts j
  measurableSet_empty := ⟨∅, by simp⟩
  measurableSet_compl := by
    rintro S ⟨J, rfl⟩
    exact ⟨Jᶜ, partUnion_compl P J⟩
  measurableSet_iUnion := by
    intro f hf
    choose J hJ using hf
    refine ⟨⋃ k, J k, ?_⟩
    simp only [hJ]
    exact partUnion_iUnion P J

/-! ## The main statement -/

theorem partSigma_eq_unions_atoms {X : Type} [mX : MeasurableSpace X]
    (P : Work.EKLContract.FinPart X) (S : Set X) :
    (Work.EKLContract.partSigma P).MeasurableSet' S ↔
      ∃ J : Set (Fin P.n), S = ⋃ j ∈ J, P.parts j := by
  -- the σ-algebra of unions of parts contains every part, hence contains `partSigma P`
  have hle : partSigma P ≤ partUnionSigma P := by
    rw [partSigma]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨i, rfl⟩
    exact ⟨{i}, by ext x; simp⟩
  constructor
  · intro hS
    exact hle S hS
  · -- a union of parts is a countable (indeed finite) union of parts, hence measurable
    rintro ⟨J, rfl⟩
    exact Set.Finite.measurableSet_biUnion (Set.toFinite J)
      fun j _ => MeasurableSpace.measurableSet_generateFrom ⟨j, rfl⟩

end Work.EKLComp
