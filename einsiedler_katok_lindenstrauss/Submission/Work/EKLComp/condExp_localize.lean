import Mathlib
import Submission.Work.EKLComp.Hcond

/-!
# Localisation of the conditional expectation to a partition atom

Let `A` be a finite measurable partition of a probability space `(X, μ)`, let `m ≤ mX` be a
sub-σ-algebra and let `S` be a measurable set.  Writing `P = partSigmaFam A` for the σ-algebra
generated by the atoms of `A`, `P ≤ m ⊔ P`, and on the atom `A i` the conditional expectation
with respect to the join `m ⊔ P` localises:

`E[1_{A i} | m] · E[1_{A i ∩ S} | m ⊔ P] =ᵐ[μ] 1_{A i} · E[1_{A i ∩ S} | m]`.

The mathematical content is that in the join `m ⊔ P` the atom `A i` of the partition is
`m`-atomic as well: the trace of an `(m ⊔ P)`-measurable set on `A i` is the trace of an
`m`-measurable set (`exists_inter_eq_of_measurable_sup`).  Consequently both sides have the same
integral over every `(m ⊔ P)`-measurable set, which reduces to the elementary identities
`∫_C E[1_{A i}|m] · E[1_{A i∩S}|m] = ∫_C E[1_{A i∩S}|m] = ∫_C 1_{A i} · E[1_{A i∩S}|m]` for
`m`-measurable `C`, proved with the pull-out property of the conditional expectation.
-/

set_option warn.classDefReducibility false

namespace Work.EKLComp

open MeasureTheory
open scoped BigOperators

/-- The σ-algebra of sets whose trace on `B` is the trace of an `m`-measurable set. -/
private def sliceAlgebra {X : Type} (m : MeasurableSpace X) (B : Set X) : MeasurableSpace X where
  MeasurableSet' := fun s => ∃ C : Set X, MeasurableSet[m] C ∧ s ∩ B = C ∩ B
  measurableSet_empty := ⟨∅, m.measurableSet_empty, by simp⟩
  measurableSet_compl := by
    rintro s ⟨C, hC, hsC⟩
    refine ⟨Cᶜ, hC.compl, ?_⟩
    ext x
    have hiff : (x ∈ s ∩ B ↔ x ∈ C ∩ B) := Set.ext_iff.mp hsC x
    simp only [Set.mem_inter_iff] at hiff
    simp only [Set.mem_inter_iff, Set.mem_compl_iff]
    exact ⟨fun ⟨hxs, hxB⟩ => ⟨fun hxC => hxs (hiff.mpr ⟨hxC, hxB⟩).1, hxB⟩,
      fun ⟨hxC, hxB⟩ => ⟨fun hxs => hxC (hiff.mp ⟨hxs, hxB⟩).1, hxB⟩⟩
  measurableSet_iUnion := by
    intro f hf
    choose C hC hCf using hf
    refine ⟨⋃ n, C n, MeasurableSet.iUnion hC, ?_⟩
    ext x
    simp only [Set.mem_inter_iff, Set.mem_iUnion]
    constructor
    · rintro ⟨⟨n, hn⟩, hxB⟩
      have h := Set.ext_iff.mp (hCf n) x
      simp only [Set.mem_inter_iff] at h
      exact ⟨⟨n, (h.mp ⟨hn, hxB⟩).1⟩, hxB⟩
    · rintro ⟨⟨n, hn⟩, hxB⟩
      have h := Set.ext_iff.mp (hCf n) x
      simp only [Set.mem_inter_iff] at h
      exact ⟨⟨n, (h.mpr ⟨hn, hxB⟩).1⟩, hxB⟩

private theorem le_sliceAlgebra {X : Type} (m : MeasurableSpace X) (B : Set X) :
    m ≤ sliceAlgebra m B :=
  fun _ hs => ⟨_, hs, rfl⟩

private theorem partSigmaFam_le_sliceAlgebra {X : Type} {ι : Type} [Fintype ι] {A : ι → Set X}
    (hdisj : Pairwise (fun i j => Disjoint (A i) (A j))) (m : MeasurableSpace X) (i : ι) :
    Core.partSigmaFam A ≤ sliceAlgebra m (A i) := by
  change MeasurableSpace.generateFrom (Set.range A) ≤ sliceAlgebra m (A i)
  refine MeasurableSpace.generateFrom_le ?_
  rintro S ⟨j, rfl⟩
  by_cases hji : j = i
  · subst hji
    exact ⟨Set.univ, MeasurableSet.univ (m := m), by rw [Set.inter_self, Set.univ_inter]⟩
  · refine ⟨∅, m.measurableSet_empty, ?_⟩
    rw [Set.empty_inter]
    exact Set.disjoint_iff_inter_eq_empty.mp (hdisj hji)

/-- The trace of an `(m ⊔ partSigmaFam A)`-measurable set on an atom `A i` is the trace of an
`m`-measurable set. -/
private theorem exists_inter_eq_of_measurable_sup {X : Type} {ι : Type} [Fintype ι] {A : ι → Set X}
    (hdisj : Pairwise (fun i j => Disjoint (A i) (A j))) {m : MeasurableSpace X} {s : Set X}
    (hs : MeasurableSet[m ⊔ Core.partSigmaFam A] s) (i : ι) :
    ∃ C : Set X, MeasurableSet[m] C ∧ s ∩ A i = C ∩ A i := by
  have hle : m ⊔ Core.partSigmaFam A ≤ sliceAlgebra m (A i) :=
    sup_le (le_sliceAlgebra m (A i)) (partSigmaFam_le_sliceAlgebra hdisj m i)
  exact hle s hs

theorem condExp_localize {X : Type} {m : MeasurableSpace X} [mX : MeasurableSpace X]
    {ι : Type} [Fintype ι] (A : ι → Set X) (hA : Work.EKLComp.Core.IsMPart A) (hm : m ≤ mX)
    (μ : MeasureTheory.Measure X) [MeasureTheory.IsProbabilityMeasure μ]
    (i : ι) (S : Set X) (hS : MeasurableSet S) :
    MeasureTheory.condExp m μ ((A i).indicator (fun _ => (1:ℝ)))
      * MeasureTheory.condExp (m ⊔ Work.EKLComp.Core.partSigmaFam A) μ ((A i ∩ S).indicator (fun _ => (1:ℝ)))
      =ᵐ[μ]
    (A i).indicator (fun _ => (1:ℝ))
      * MeasureTheory.condExp m μ ((A i ∩ S).indicator (fun _ => (1:ℝ))) := by
  classical
  set oneB : X → ℝ := (A i).indicator (fun _ => (1:ℝ)) with honeB
  set oneT : X → ℝ := (A i ∩ S).indicator (fun _ => (1:ℝ)) with honeT
  set e : X → ℝ := MeasureTheory.condExp m μ oneB with he
  set Z : X → ℝ := MeasureTheory.condExp (m ⊔ Core.partSigmaFam A) μ oneT with hZ
  set hh : X → ℝ := MeasureTheory.condExp m μ oneT with hhh
  have hsup : (m ⊔ Core.partSigmaFam A) ≤ mX := sup_le hm (Core.partSigmaFam_le hA)
  have hBmeas : MeasurableSet (A i) := hA.1 i
  have hTmeas : MeasurableSet (A i ∩ S) := hBmeas.inter hS
  have hpart_le : Core.partSigmaFam A ≤ (m ⊔ Core.partSigmaFam A) := le_sup_right
  have hm_le : m ≤ (m ⊔ Core.partSigmaFam A) := le_sup_left
  have hBmm : MeasurableSet[m ⊔ Core.partSigmaFam A] (A i) :=
    hpart_le (A i) (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self i))
  have h1B_int : Integrable oneB μ := by
    rw [honeB]; exact (integrable_const (1:ℝ)).indicator hBmeas
  have h1T_int : Integrable oneT μ := by
    rw [honeT]; exact (integrable_const (1:ℝ)).indicator hTmeas
  have hint_e : Integrable e μ := by rw [he]; exact MeasureTheory.integrable_condExp
  have hint_hh : Integrable hh μ := by rw [hhh]; exact MeasureTheory.integrable_condExp
  have hSM_e_m : StronglyMeasurable[m] e := by
    rw [he]; exact MeasureTheory.stronglyMeasurable_condExp
  have hSM_e_mm : StronglyMeasurable[m ⊔ Core.partSigmaFam A] e := hSM_e_m.mono le_sup_left
  have hSM_Z : StronglyMeasurable[m ⊔ Core.partSigmaFam A] Z := by
    rw [hZ]; exact MeasureTheory.stronglyMeasurable_condExp
  have hSM_hh_m : StronglyMeasurable[m] hh := by
    rw [hhh]; exact MeasureTheory.stronglyMeasurable_condExp
  have hSM_hh_mm : StronglyMeasurable[m ⊔ Core.partSigmaFam A] hh := hSM_hh_m.mono le_sup_left
  have hSM_oneB : StronglyMeasurable[m ⊔ Core.partSigmaFam A] oneB := by
    rw [honeB]
    exact ((stronglyMeasurable_const : StronglyMeasurable[m ⊔ Core.partSigmaFam A]
      (fun _ : X => (1:ℝ)))).indicator hBmm
  have hAie : ∀ x : X, ((A i ∩ S).indicator e) x = e x * oneT x := by
    intro x
    by_cases hx : x ∈ A i ∩ S
    · rw [Set.indicator_of_mem hx, honeT, Set.indicator_of_mem hx]; ring
    · rw [Set.indicator_of_notMem hx, honeT, Set.indicator_of_notMem hx]; ring
  have hBihh : ∀ x : X, ((A i).indicator hh) x = oneB x * hh x := by
    intro x
    by_cases hx : x ∈ A i
    · rw [Set.indicator_of_mem hx, honeB, Set.indicator_of_mem hx]; ring
    · rw [Set.indicator_of_notMem hx, honeB, Set.indicator_of_notMem hx]; ring
  have hMT_int : Integrable (e * oneT) μ :=
    (hint_e.indicator hTmeas).congr (Filter.Eventually.of_forall hAie)
  have hBh_int : Integrable (oneB * hh) μ :=
    (hint_hh.indicator hBmeas).congr (Filter.Eventually.of_forall hBihh)
  have hpull_mm : MeasureTheory.condExp (m ⊔ Core.partSigmaFam A) μ (e * oneT) =ᵐ[μ] e * Z := by
    have h := MeasureTheory.condExp_mul_of_stronglyMeasurable_left
      (m := m ⊔ Core.partSigmaFam A) (μ := μ) (f := e) (g := oneT) hSM_e_mm hMT_int h1T_int
    simpa only [hZ] using h
  have hpull_m : MeasureTheory.condExp m μ (e * oneT) =ᵐ[μ] e * hh := by
    have h := MeasureTheory.condExp_mul_of_stronglyMeasurable_left
      (m := m) (μ := μ) (f := e) (g := oneT) hSM_e_m hMT_int h1T_int
    simpa only [hhh] using h
  have hpull_m' : MeasureTheory.condExp m μ (oneB * hh) =ᵐ[μ] e * hh := by
    have h := MeasureTheory.condExp_mul_of_stronglyMeasurable_right
      (m := m) (μ := μ) (f := oneB) (g := hh) hSM_hh_m hBh_int h1B_int
    simpa only [he] using h
  have hF_int : Integrable (fun x => e x * Z x) μ :=
    (MeasureTheory.integrable_condExp (μ := μ) (m := m ⊔ Core.partSigmaFam A)
      (f := e * oneT)).congr hpull_mm
  have hG_int : Integrable (fun x => oneB x * hh x) μ := hBh_int
  have hF_aesm : AEStronglyMeasurable[m ⊔ Core.partSigmaFam A] (fun x => e x * Z x) μ :=
    (hSM_e_mm.aestronglyMeasurable).mul (hSM_Z.aestronglyMeasurable)
  have hG_aesm : AEStronglyMeasurable[m ⊔ Core.partSigmaFam A] (fun x => oneB x * hh x) μ :=
    (hSM_oneB.aestronglyMeasurable).mul (hSM_hh_mm.aestronglyMeasurable)
  have key : e * Z =ᵐ[μ] oneB * hh := by
    have key' : (fun x : X => e x * Z x) =ᵐ[μ] (fun x : X => oneB x * hh x) := by
      refine MeasureTheory.ae_eq_of_forall_setIntegral_eq_of_sigmaFinite' (μ := μ)
        (m := m ⊔ Core.partSigmaFam A) (m0 := mX) hsup ?_ ?_ ?_ ?_ ?_
      · intro s _ _
        exact hF_int.integrableOn
      · intro s _ _
        exact hG_int.integrableOn
      · intro s hs _
        obtain ⟨C, hCmeas, hCsB⟩ := exists_inter_eq_of_measurable_sup hA.2.1 hs i
        have hCmeasX : MeasurableSet C := hm C hCmeas
        have hsX : MeasurableSet s := hsup s hs
        have hCsT : s ∩ (A i ∩ S) = C ∩ (A i ∩ S) := by
          rw [← Set.inter_assoc, ← Set.inter_assoc, hCsB]
        have h1 : ∫ x in C, ((A i ∩ S).indicator e) x ∂μ = ∫ x in C, e x * hh x ∂μ := by
          calc ∫ x in C, ((A i ∩ S).indicator e) x ∂μ
              = ∫ x in C, e x * oneT x ∂μ :=
                MeasureTheory.setIntegral_congr_fun hCmeasX (fun x _ => hAie x)
            _ = ∫ x in C, MeasureTheory.condExp m μ (e * oneT) x ∂μ :=
                (MeasureTheory.setIntegral_condExp hm hMT_int hCmeas).symm
            _ = ∫ x in C, e x * hh x ∂μ :=
                MeasureTheory.setIntegral_congr_ae hCmeasX (hpull_m.mono (fun x hx _ => hx))
        have h2 : ∫ x in C, ((A i).indicator hh) x ∂μ = ∫ x in C, e x * hh x ∂μ := by
          calc ∫ x in C, ((A i).indicator hh) x ∂μ
              = ∫ x in C, oneB x * hh x ∂μ :=
                MeasureTheory.setIntegral_congr_fun hCmeasX (fun x _ => hBihh x)
            _ = ∫ x in C, MeasureTheory.condExp m μ (oneB * hh) x ∂μ :=
                (MeasureTheory.setIntegral_condExp hm hBh_int hCmeas).symm
            _ = ∫ x in C, e x * hh x ∂μ :=
                MeasureTheory.setIntegral_congr_ae hCmeasX (hpull_m'.mono (fun x hx _ => hx))
        calc ∫ x in s, e x * Z x ∂μ
            = ∫ x in s, MeasureTheory.condExp (m ⊔ Core.partSigmaFam A) μ (e * oneT) x ∂μ :=
              MeasureTheory.setIntegral_congr_ae hsX (hpull_mm.symm.mono (fun x hx _ => hx))
          _ = ∫ x in s, e x * oneT x ∂μ :=
              MeasureTheory.setIntegral_condExp hsup hMT_int hs
          _ = ∫ x in s, ((A i ∩ S).indicator e) x ∂μ :=
              MeasureTheory.setIntegral_congr_fun hsX (fun x _ => (hAie x).symm)
          _ = ∫ x in s ∩ (A i ∩ S), e x ∂μ :=
              MeasureTheory.setIntegral_indicator hTmeas
          _ = ∫ x in C ∩ (A i ∩ S), e x ∂μ := by rw [hCsT]
          _ = ∫ x in C, ((A i ∩ S).indicator e) x ∂μ :=
              (MeasureTheory.setIntegral_indicator hTmeas).symm
          _ = ∫ x in C, e x * hh x ∂μ := h1
          _ = ∫ x in C, ((A i).indicator hh) x ∂μ := h2.symm
          _ = ∫ x in C ∩ (A i), hh x ∂μ :=
              MeasureTheory.setIntegral_indicator hBmeas
          _ = ∫ x in s ∩ (A i), hh x ∂μ := by rw [hCsB]
          _ = ∫ x in s, ((A i).indicator hh) x ∂μ :=
              (MeasureTheory.setIntegral_indicator hBmeas).symm
          _ = ∫ x in s, oneB x * hh x ∂μ :=
              MeasureTheory.setIntegral_congr_fun hsX (fun x _ => hBihh x)
      · exact hF_aesm
      · exact hG_aesm
    exact key'
  exact key

end Work.EKLComp
