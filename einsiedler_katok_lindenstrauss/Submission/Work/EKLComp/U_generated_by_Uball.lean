import Mathlib
import Submission.Work.EKLC7.LeafwiseGeom
import Submission.Work.EKLProd.aDiag_nsmul
import Submission.Work.EKLComp.Endgame_dense_rat
import Submission.Work.EKLComp.mem_of_continuous_path_Uball

/-!
# `U` is generated by its small elements

For a horospherical subgroup `U ≤ SL₃(ℝ)` (frozen notion `Work.EKLContract.IsHoro U`: closed,
normalised by the diagonal flow, and contracted to the identity by some `aDiag t`) and any radius
`R > 0`, the entry ball `Uball U R = {u ∈ U | ‖u - 1‖_sup < R}` generates `U`:
`Subgroup.closure (Uball U R) = U`.

## The argument

`⊆` is immediate (`Uball U R ⊆ U`).

For `⊇` fix `u ∈ U` and let `H = closure (Uball U R)`.  The contraction hypothesis of `IsHoro`
gives an exponent vector `t` with `aDiag t ^ n * u * (aDiag t ^ n)⁻¹ → 1`, so for some `N`
the conjugate `σ_N = aDiag (N • t) * u * (aDiag (N • t))⁻¹` lies in `Uball U R ⊆ H`.  The whole
path `σ(lam) = aDiag (lam • t) * u * (aDiag (lam • t))⁻¹` (continuous, and with values in `U`
because `U` is normalised by the flow) starts at `σ(0) = u` and ends at `σ(N) ∈ H`; since
`H` is a subgroup whose intersection with every `U`-translate is open, the preimage `σ⁻¹(H)` is
a nonempty clopen subset of `ℝ`, so it is all of `ℝ` and `u = σ 0 ∈ H`.

The topological input `σ⁻¹(H)` clopen is the general lemma
`Work.EKLComp.mem_of_continuous_path_Uball`.
-/

open MeasureTheory Filter Topology
open scoped ENNReal

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLComp

open Work.EKLContract

/-! ## The open entry ball -/

/-- The open sup-norm ball of radius `R` around the identity in `SL₃(ℝ)` (without the
requirement of lying in a subgroup). -/
def UballOpen (R : ℝ) : Set SL3 :=
  {g | ∀ i j : Fin 3, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < R}

/-- `Uball U R` is the trace on `U` of the open entry ball. -/
theorem Uball_eq_inter (U : Subgroup SL3) (R : ℝ) :
    Uball U R = (U : Set SL3) ∩ UballOpen R := rfl

/-- The open entry ball is open in `SL₃(ℝ)`. -/
theorem isOpen_UballOpen (R : ℝ) : IsOpen (UballOpen R) := by
  have h : UballOpen R = ⋂ (i : Fin 3), ⋂ (j : Fin 3),
      {g : SL3 | (g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j
        ∈ Set.Ioo (-R) R} := by
    ext g
    simp only [UballOpen, Set.mem_ofPred_eq, Set.mem_iInter, Set.mem_Ioo, abs_lt]
  rw [h]
  exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
    isOpen_Ioo.preimage (by fun_prop)

/-- The identity lies in the open entry ball. -/
theorem one_mem_UballOpen {R : ℝ} (hR : 0 < R) : (1 : SL3) ∈ UballOpen R := by
  intro i j
  by_cases h : i = j
  · subst h; simpa using hR
  · simpa [h] using hR

/-! ## The main theorem -/

/-- Membership in `Uball` is membership in the subgroup plus the entry condition. -/
theorem mem_U_of_mem_Uball {U : Subgroup SL3} {R : ℝ} {g : SL3} (hg : g ∈ Uball U R) : g ∈ U :=
  hg.1

/-- **`U` is generated by its small elements.**  For a horospherical subgroup `U` and any radius
`R > 0`, the entry ball `Uball U R` generates `U`. -/
theorem U_generated_by_Uball (U : Subgroup Work.EKLContract.SL3)
    (hU : Work.EKLContract.IsHoro U) (R : ℝ) (hR : 0 < R) :
    Subgroup.closure (Work.EKLComp.Uball U R) = U := by
  refine le_antisymm ?_ ?_
  · -- `closure (Uball U R) ≤ U`: every element of the ball lies in `U`.
    exact (Subgroup.closure_le U).mpr fun g hg => mem_U_of_mem_Uball hg
  · -- `U ≤ closure (Uball U R)`: follow the contracting flow from `u` to a ball element.
    intro u hu
    have hHle : Subgroup.closure (Uball U R) ≤ U :=
      (Subgroup.closure_le U).mpr fun g hg => mem_U_of_mem_Uball hg
    obtain ⟨t, ht⟩ := hU.2.2
    -- the entry ball is a neighbourhood of `1`, so the contracting sequence eventually lands in it
    have hB : UballOpen R ∈ 𝓝 (1 : SL3) :=
      (isOpen_UballOpen R).mem_nhds (one_mem_UballOpen hR)
    obtain ⟨N, hN⟩ := eventually_atTop.1 ((ht u hu).eventually hB)
    have hNs : ((N : ℝ) • t) = N • t := by
      funext i
      simp [nsmul_eq_mul]
    -- the endpoint of the path lies in the ball
    have hN' : aDiag ((N : ℝ) • t) * u * (aDiag ((N : ℝ) • t))⁻¹
        ∈ Subgroup.closure (Uball U R) := by
      apply Subgroup.subset_closure
      refine ⟨hU.2.1 ((N : ℝ) • t) u hu, ?_⟩
      rw [hNs, Work.EKLProd.aDiag_nsmul t N]
      exact hN N le_rfl
    -- the path is continuous and stays in `U`
    have hσc : Continuous (fun lam : ℝ => aDiag (lam • t) * u * (aDiag (lam • t))⁻¹) := by
      have h1 : Continuous fun lam : ℝ => aDiag (lam • t) :=
        continuous_aDiag.comp (by fun_prop)
      exact (h1.mul continuous_const).mul h1.inv
    have hσU : ∀ lam : ℝ, aDiag (lam • t) * u * (aDiag (lam • t))⁻¹ ∈ U :=
      fun lam => hU.2.1 (lam • t) u hu
    -- the `H`-preimage of the path is clopen, hence all of `[0,N]`
    have h0 := mem_of_continuous_path_Uball U (Subgroup.closure (Uball U R)) hHle R hR
      Subgroup.subset_closure (fun lam : ℝ => aDiag (lam • t) * u * (aDiag (lam • t))⁻¹) hσc hσU
      (Nat.cast_nonneg N) hN'
    simpa [Work.EKLContract.aDiag_zero] using h0

end Work.EKLComp
