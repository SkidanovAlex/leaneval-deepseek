import Mathlib
import Submission.Work.EKLComp.LeafDefs
import Submission.Work.EKLComp.joinAtoms
import Submission.Work.EKLContract.Interfaces

/-!
# `u • x ∈ [x]_m` is measurable for a countably generated `m`

Let `𝔪` be a σ-algebra on `X₃ = SL₃(ℝ)/SL₃(ℤ)` with `𝔪.m ≤ borel X₃` that is generated by a
countable family `b` of sets, and let `u ∈ SL₃(ℝ)`.  Then

`{x : X₃ | u • x ∈ atom 𝔪.m x}`

is Borel measurable.

The point is entirely set-theoretic, and works for any countably generated σ-algebra `m` on a
space `α`: membership in the atom is the relation "belongs to exactly the same generators", i.e.

`y ∈ atom m x  ↔  ∀ s ∈ b, (y ∈ s ↔ x ∈ s)`

(`Work.EKLComp.atomG_generateFrom`).  Hence, enumerating the generators by the countable index
type `b` itself,

`{x | u • x ∈ atom m x} = ⋂ (s : b), {x | u • x ∈ s ↔ x ∈ s}`,

a countable intersection of sets each of which is measurable when `m` is generated by `b`
(so `s ∈ b` is `m`-measurable) and `m ≤ borel X₃` (so `s` is Borel) together with continuity of
`x ↦ u • x`.  Writing `{x | u • x ∈ s ↔ x ∈ s}` as `(s ∩ u⁻¹s) ∪ (sᶜ ∩ (u⁻¹s)ᶜ)` exhibits it as a
Boolean combination of such sets.

Note that no countability hypothesis on `u`, and no invariance of `𝔪` under `u`, is needed: the
statement is not about the measurable structure of the map `x ↦ u • x` alone but about the atom
*at the point where we read it off*, and the generators do the bookkeeping.
-/

open MeasureTheory

set_option linter.style.haveILetI false

namespace Work.EKLComp

open Work.EKLContract

theorem measurableSet_smul_mem_atom (𝔪 : Work.EKLComp.SigAlg)
    (hm : 𝔪.m ≤ Work.EKLComp.borelX3)
    (hgen : ∃ b : Set (Set Work.EKLContract.X3), b.Countable ∧
      𝔪.m = MeasurableSpace.generateFrom b)
    (u : Work.EKLContract.SL3) :
    MeasurableSet {x : Work.EKLContract.X3 | u • x ∈ Work.EKLContract.atom 𝔪.m x} := by
  obtain ⟨b, hbc, hbm⟩ := hgen
  -- `b` is countable, so its subtype is a countable index type.
  haveI : Countable b := hbc
  -- The atom at `x` is cut out by the generators: `y ∈ [x] ↔ ∀ s ∈ b, y ∈ s ↔ x ∈ s`.
  have hatom : ∀ x : X3,
      Work.EKLContract.atom 𝔪.m x = {y : X3 | ∀ s ∈ b, y ∈ s ↔ x ∈ s} := by
    intro x
    have h1 : Work.EKLContract.atom 𝔪.m x = atomG 𝔪.m x := (atomG_eq_atom 𝔪.m x).symm
    rw [h1, hbm]
    exact atomG_generateFrom x
  have hS : ∀ x : X3, (u • x ∈ Work.EKLContract.atom 𝔪.m x) ↔
      ∀ s : b, u • x ∈ (s : Set X3) ↔ x ∈ (s : Set X3) := by
    intro x
    rw [hatom x]
    simp only [Set.mem_ofPred_eq]
    exact ⟨fun h s => h (s : Set X3) s.2, fun h s hs => h ⟨s, hs⟩⟩
  -- Hence it is the countable intersection of the "agreement" sets of the generators.
  have hset : {x : X3 | u • x ∈ Work.EKLContract.atom 𝔪.m x} =
      ⋂ (s : b), {x : X3 | u • x ∈ (s : Set X3) ↔ x ∈ (s : Set X3)} := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iInter, hS x]
  rw [hset]
  refine MeasurableSet.iInter (fun s => ?_)
  have hmem : (s : Set X3) ∈ b := s.2
  have hmA : MeasurableSet[𝔪.m] (s : Set X3) := by
    rw [hbm]; exact MeasurableSpace.measurableSet_generateFrom hmem
  -- `m ≤ borel X₃` makes every generator Borel.
  have hbA : MeasurableSet (s : Set X3) := hm _ hmA
  -- and x ↦ u • x is continuous, hence measurable.
  have hpre : MeasurableSet {x : X3 | u • x ∈ (s : Set X3)} :=
    (continuous_const_smul u).measurable hbA
  have heq : {x : X3 | u • x ∈ (s : Set X3) ↔ x ∈ (s : Set X3)} =
      ((s : Set X3) ∩ {x | u • x ∈ (s : Set X3)}) ∪
        ((s : Set X3)ᶜ ∩ {x | u • x ∈ (s : Set X3)}ᶜ) := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_union, Set.mem_inter_iff, Set.mem_compl_iff]
    tauto
  rw [heq]
  exact (hbA.inter hpre).union (hbA.compl.inter hpre.compl)

end Work.EKLComp
