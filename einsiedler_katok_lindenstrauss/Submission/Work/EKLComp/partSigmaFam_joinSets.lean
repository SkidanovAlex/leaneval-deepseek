import Mathlib
import Submission.Work.EKLComp.Hcond

namespace Work.EKLComp

/-- The σ-algebra generated by the atoms of the `N`-fold join `⋁_{k<N} T^{-k} P` is the
supremum of the pullbacks `T^{-k}(partSigma P)`, `k < N`.

Both inclusions are elementary: an atom `⋂_{k<N} T^{-k}(P.parts (w k))` is a finite
intersection of generators of the right-hand side; conversely the generator `T^{-k}(P.parts i)`
of the right-hand side is the union of the atoms of the join whose `k`-th letter is `i`
(here the atoms of the join cover `X` and are pairwise disjoint, so the `k`-th letter of a
point is well defined). -/
theorem partSigmaFam_joinSets {X : Type} [mX : MeasurableSpace X] (T : X → X) (P : Work.EKLContract.FinPart X)
    (N : ℕ) :
    Work.EKLComp.Core.partSigmaFam (Work.EKLContract.joinSets T P N) =
      ⨆ k : Fin N, MeasurableSpace.comap (T^[(k:ℕ)]) (Work.EKLContract.partSigma P) := by
  apply le_antisymm
  · -- Each atom of the join is a finite intersection of generators of the right-hand side.
    rw [Work.EKLComp.Core.partSigmaFam]
    refine MeasurableSpace.generateFrom_le ?_
    rintro S ⟨w, rfl⟩
    rw [Work.EKLContract.joinSets]
    refine MeasurableSet.iInter fun k => ?_
    exact le_iSup (fun k : Fin N =>
        MeasurableSpace.comap (T^[(k:ℕ)]) (Work.EKLContract.partSigma P)) k _
      ⟨P.parts (w k), MeasurableSpace.measurableSet_generateFrom ⟨w k, rfl⟩, rfl⟩
  · -- Each generator `T^{-k}(P.parts i)` of the right-hand side is a union of atoms of the join.
    refine iSup_le fun k => ?_
    rw [Work.EKLContract.partSigma, MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro S ⟨A, ⟨i, rfl⟩, rfl⟩
    have hkey : (T^[(k:ℕ)]) ⁻¹' P.parts i =
        ⋃ w : {w : Fin N → Fin P.n // w k = i}, Work.EKLContract.joinSets T P N w.1 := by
      ext x
      simp only [Set.mem_preimage, Set.mem_iUnion, Subtype.exists, exists_prop]
      constructor
      · intro hx
        have hcov : x ∈ ⋃ w : Fin N → Fin P.n, Work.EKLContract.joinSets T P N w := by
          rw [Work.EKLComp.Core.joinSets_iUnion]; trivial
        obtain ⟨w, hw⟩ := Set.mem_iUnion.mp hcov
        have hwk : w k = i := by
          by_contra hne
          have h1 : T^[(k:ℕ)] x ∈ P.parts (w k) := Set.mem_iInter.mp hw k
          exact Set.disjoint_left.mp (P.disjoint hne) h1 hx
        exact ⟨w, hwk, hw⟩
      · rintro ⟨w, hwk, hw⟩
        rw [← hwk]
        exact Set.mem_iInter.mp hw k
    rw [hkey]
    exact MeasurableSet.iUnion fun w =>
      MeasurableSpace.measurableSet_generateFrom ⟨w.1, rfl⟩

end Work.EKLComp
