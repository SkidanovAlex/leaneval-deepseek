/-!
# Leafwise measures: definitions for component C5

Component C5 of the frozen EKL contract is

`Work.EKLContract.P_Leafwise : Prop`

which asks for the existence, for every probability measure `μ` on `X₃ = SL₃(ℝ)/SL₃(ℤ)` and
every horospherical subgroup `U ≤ SL₃(ℝ)` (contracted by a measure preserving `α^{t₀}`), of a
system of leafwise measures together with the nine derived properties (U1)–(U9).

This module collects the vocabulary in which the construction and its intermediate lemmas are
stated (the interface `IsLeafwise` itself is frozen in `EKLContract/Defs.lean`):

* `Uball U r`/`Ucl U r` — the sup-metric ball of radius `r` around `1` *inside* `U`
  (`Box1 U = Ucl U 1`), the normalising set of the contract;
* `Upla U r x` — the corresponding plaque `{u • x : u ∈ U, ‖u - 1‖ < r}` of the `U`-orbit of `x`;
* `BigPlaque U R Z m` — a plaque algebra `(Z, m)` (in the sense of the frozen
  `IsPlaqueAlgebra`) whose atoms contain the plaque of radius `R`;
* `Propor`, `ProporOn` — proportionality of measures, the relation in which the leafwise
  measures are determined (Pisa Theorem 6.3 is stated up to proportionality).
-/

open MeasureTheory Filter Topology
open scoped ENNReal
open LeanEval.Dynamics.EinsiedlerKatokLindenstrauss

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLComp

open Work.EKLContract

/-! ## Balls and plaques in a subgroup `U ≤ SL₃(ℝ)` -/

/-- The open sup-metric ball of radius `r` around the identity, inside the subgroup `U`. -/
def Uball (U : Subgroup SL3) (r : ℝ) : Set SL3 :=
  {g | g ∈ U ∧ ∀ i j : Fin 3,
    |(g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < r}

/-- The closed sup-metric ball of radius `r` around the identity, inside the subgroup `U`.
For `r = 1` this is the contract's normalising set `Box1 U`. -/
def Ucl (U : Subgroup SL3) (r : ℝ) : Set SL3 :=
  {g | g ∈ U ∧ ∀ i j : Fin 3,
    |(g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ r}

/-- The plaque of `U`-radius `r` through `x`: `{u • x : u ∈ U, ‖u - 1‖ < r}`. -/
def Upla (U : Subgroup SL3) (r : ℝ) (x : X3) : Set X3 := (fun g : SL3 => g • x) '' (Uball U r)

/-- The closed plaque of `U`-radius `r` through `x`. -/
def Uclpla (U : Subgroup SL3) (r : ℝ) (x : X3) : Set X3 := (fun g : SL3 => g • x) '' (Ucl U r)

/-- **UNSATISFIABLE for nonempty `Z` when `U` is generated by small displacements** (e.g. a root
group); kept only for reference.  Reason: `Upla U R x ⊆ atom m x` propagates, as follows.  For
`u ∈ Uball U R` we get `u • x ∈ atom m x ⊆ Z`; applying the same clause at `u • x` (whose atom is
`atom m x`) shows `Uball U R * Uball U R ⊆ shape m U x`, and inductively the whole subgroup
generated by `Uball U R`, i.e. `U`, is contained in `shape m U x`, contradicting the boundedness
of `shape` in `IsPlaqueAlgebra`.  Use `BigPlaqueOn` instead. -/
def BigPlaque (U : Subgroup SL3) (R : ℝ) (Z : Set X3) (m : MeasurableSpace X3) : Prop :=
  IsPlaqueAlgebra U Z m ∧ ∀ x ∈ Z, Upla U R x ⊆ atom m x

/-- A plaque algebra (frozen notion `IsPlaqueAlgebra`) which is *large on a base* `E ⊆ Z`: for
`x ∈ E` the atom of `m` at `x` contains the `U`-plaque of radius `R` through `x`.  This is the
correct "flower" notion (Pisa Definition 6.14 / Corollary 6.15): the atoms are big at the base
points, and the bases of countably many such flowers cover a.e.; the atoms are automatically
bounded everywhere, because `shape m U x` is bounded for *every* `x ∈ Z` by `IsPlaqueAlgebra`. -/
def BigPlaqueOn (U : Subgroup SL3) (R : ℝ) (E Z : Set X3) (m : MeasurableSpace X3) : Prop :=
  IsPlaqueAlgebra U Z m ∧ E ⊆ Z ∧ ∀ x ∈ E, Upla U R x ⊆ atom m x

/-! ## Proportionality of measures -/

/-- `ν'` is a nonzero multiple of `ν`. -/
def Propor {α : Type*} [MeasurableSpace α] (ν ν' : Measure α) : Prop :=
  ∃ c : ℝ≥0∞, c ≠ 0 ∧ c ≠ ⊤ ∧ ν' = c • ν

/-- `ν` and `ν'` are proportional when restricted to `s`. -/
def ProporOn {α : Type*} [MeasurableSpace α] (ν ν' : Measure α) (s : Set α) : Prop :=
  Propor (ν.restrict s) (ν'.restrict s)

/-! ## Elementary API -/

@[simp] theorem Box1_eq_Ucl (U : Subgroup SL3) : Box1 U = Ucl U 1 := rfl

theorem Uball_subset_Ucl (U : Subgroup SL3) (r : ℝ) : Uball U r ⊆ Ucl U r :=
  fun g hg => ⟨hg.1, fun i j => le_of_lt (hg.2 i j)⟩

theorem Ucl_subset_Uball {U : Subgroup SL3} {r r' : ℝ} (h : r < r') : Ucl U r ⊆ Uball U r' :=
  fun g hg => ⟨hg.1, fun i j => lt_of_le_of_lt (hg.2 i j) h⟩

theorem Uball_mono {U : Subgroup SL3} {r r' : ℝ} (h : r ≤ r') : Uball U r ⊆ Uball U r' :=
  fun g hg => ⟨hg.1, fun i j => lt_of_lt_of_le (hg.2 i j) h⟩

theorem one_mem_Uball (U : Subgroup SL3) {r : ℝ} (hr : 0 < r) : (1 : SL3) ∈ Uball U r := by
  refine ⟨U.one_mem, fun i j => ?_⟩
  rw [Matrix.SpecialLinearGroup.coe_one, sub_self, abs_zero]
  exact hr

theorem one_mem_Ucl (U : Subgroup SL3) {r : ℝ} (hr : 0 ≤ r) : (1 : SL3) ∈ Ucl U r := by
  refine ⟨U.one_mem, fun i j => ?_⟩
  rw [Matrix.SpecialLinearGroup.coe_one, sub_self, abs_zero]
  exact hr

theorem Upla_mono {U : Subgroup SL3} {r r' : ℝ} (h : r ≤ r') (x : X3) :
    Upla U r x ⊆ Upla U r' x :=
  Set.image_mono (Uball_mono h)

/-- Membership in a plaque. -/
theorem mem_Upla_iff {U : Subgroup SL3} {r : ℝ} {x y : X3} :
    y ∈ Upla U r x ↔ ∃ g ∈ Uball U r, g • x = y := Iff.rfl

/-- The plaque through `x` is a subset of the `U`-orbit of `x`. -/
theorem Upla_subset_orbit (U : Subgroup SL3) (r : ℝ) (x : X3) :
    Upla U r x ⊆ (fun g : SL3 => g • x) '' (U : Set SL3) := by
  rintro y ⟨g, hg, rfl⟩
  exact ⟨g, hg.1, rfl⟩

theorem Propor.refl {α : Type*} [MeasurableSpace α] (ν : Measure α) (h : ν ≠ 0) :
    Propor ν ν := ⟨1, one_ne_zero, ENNReal.one_ne_top, by simp⟩

theorem Propor.symm {α : Type*} [MeasurableSpace α] {ν ν' : Measure α} (h : Propor ν ν') :
    Propor ν' ν := by
  obtain ⟨c, hc0, hct, hceq⟩ := h
  refine ⟨c⁻¹, ENNReal.inv_ne_zero.mpr hct, ENNReal.inv_ne_top.mpr hc0, ?_⟩
  rw [hceq, smul_smul, ENNReal.inv_mul_cancel hc0 hct, one_smul]


/-! ## Local freeness of the `U`-action on `X₃`

Pisa §6.1: the action of `T = U` on `X` is *locally free uniformly on compacta* if displacements
by group elements close to the identity have no fixed points on compact sets.  For `X₃ = G/Γ`
with `Γ = SL₃(ℤ)` discrete this holds for **every** closed subgroup `U ≤ SL₃(ℝ)`; it is the only
topological input of the construction of leafwise measures. -/

/-- The `U`-action on `X₃` is locally free: on every compact set, displacements by elements of
`U` that are sufficiently close to the identity are fixed-point free. -/
def LocallyFree (U : Subgroup SL3) : Prop :=
  ∀ K : Set X3, IsCompact K → ∃ δ : ℝ, 0 < δ ∧
    ∀ x ∈ K, ∀ u ∈ U, u ∈ V δ → u • x = x → u = 1

/-! ## Atoms of two `σ`-algebras -/

section Atoms

variable {α : Type*} [MeasurableSpace α]

/-- The atom of the `σ`-algebra `m` at `x`: the smallest `m`-measurable set containing `x`
(this is `Work.EKLContract.atom` made available for an arbitrary measurable space). -/
def atomG (m : MeasurableSpace α) (x : α) : Set α := ⋂₀ {s | MeasurableSet[m] s ∧ x ∈ s}

/-- Every `m`-atom restricted to `Y` is covered by countably many `m'`-atoms. -/
def AtomsRefineOn (m m' : MeasurableSpace α) (Y : Set α) : Prop :=
  ∀ x ∈ Y, ∃ s : Set (Set α), s.Countable ∧ (∀ t ∈ s, ∃ y : α, t = atomG m' y) ∧
    atomG m x ∩ Y ⊆ ⋃₀ s

/-- The `σ`-algebras `m`, `m'` have countably equivalent atoms on `Y` (Pisa Def. 5.15). -/
def CountablyEquivOn (m m' : MeasurableSpace α) (Y : Set α) : Prop :=
  AtomsRefineOn m m' Y ∧ AtomsRefineOn m' m Y

theorem atomG_eq_atom (m : MeasurableSpace X3) (x : X3) : atomG m x = atom m x := rfl

end Atoms


/-- The contraction hypothesis on `U` along `α^{t₀}`: conjugation by `aDiag t₀` shrinks every
element of `U` to the identity (`IsHoro` provides such a `t₀`). -/
def ContractU (U : Subgroup SL3) (t0 : Fin 3 → ℝ) : Prop :=
  ∀ u ∈ U, Filter.Tendsto (fun n : ℕ => aDiag t0 ^ n * u * (aDiag t0 ^ n)⁻¹) Filter.atTop
    (𝓝 1)


/-- A `σ`-algebra on `X₃`, wrapped in a structure so that it is *not* picked up by instance
search when it occurs as a local hypothesis of a statement (Mathlib's `Measure`/`Kernel` API
binds the ambient `MeasurableSpace` as an instance, and a bare local hypothesis
`m : MeasurableSpace X₃` captures that instance argument). -/
structure SigAlg where
  m : MeasurableSpace X3

/-- The Borel `σ`-algebra of `X₃`, under a name (so that statements can refer to it without
relying on instance search). -/
abbrev borelX3 : MeasurableSpace X3 := borel X3

/-! ## Global instances for `X₃`

`Work.EKLComp.X3Background` (proved) supplies the topological background of the space of
lattices; we register it as instances so that every module of this component can use
`condExpKernel`, compactness arguments, and the Polish-space API on `X₃` directly. -/

instance instT2SpaceX3 : T2Space X3 := X3Background.1
instance instLocallyCompactSpaceX3 : LocallyCompactSpace X3 := X3Background.2.1
instance instSecondCountableTopologyX3 : SecondCountableTopology X3 := X3Background.2.2.1
instance instPolishSpaceX3 : PolishSpace X3 := X3Background.2.2.2.1
instance instStandardBorelSpaceX3 : StandardBorelSpace X3 := X3Background.2.2.2.2


/-- **Flower with a measurable leaf coordinate** (Pisa Cor. 6.15 + §6.13): a plaque algebra
`(Z, m)` with base `E` (radius `R`), together with a measurable map `u : X₃ → SL₃` which inverts
the orbit map inside every atom: for `x ∈ Z` and `y ∈ atom m x` one has `y = (u y * (u x)⁻¹) • x`,
with both coordinates in `U`.  The coordinate is what makes the pushed conditional measures
measurable functions of `x` (EKL (1)); it is supplied by the Borel isomorphism
`B_{r+1}^U × C ≅ Y` of the flower construction. -/
structure FlowerCoord (U : Subgroup SL3) (R : ℝ) where
  E : Set X3
  Z : Set X3
  m : MeasurableSpace X3
  u : X3 → SL3
  big : BigPlaqueOn U R E Z m
  meas_u : Measurable u
  u_mem : ∀ y ∈ Z, u y ∈ U
  coord : ∀ x ∈ Z, ∀ y ∈ atom m x, y = (u y * (u x)⁻¹) • x

end Work.EKLComp
